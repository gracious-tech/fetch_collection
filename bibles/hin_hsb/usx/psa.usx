<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">HINDI STANDARD BIBLE©, Copyright © 2024 by Global Bible Initiative [Export Date: April 10, 2024]</book>
  <para style="h">Psalms</para>
  <para style="mt1">Psalms</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="s1">पहला भाग</para>
  <para style="b" />
  <para style="s1">(भजन 1-41)</para>
  <para style="b" />
  <para style="s1">दो मार्ग</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />क्या ही धन्य है वह मनुष्य,</para>
  <para style="q2" vid="PSA 1:1">जो दुष्‍टों की सम्मति पर नहीं चलता,</para>
  <para style="q1" vid="PSA 1:1">और न पापियों के मार्ग पर खड़ा होता,</para>
  <para style="q2" vid="PSA 1:1">और न ठट्ठा करनेवालों की बैठक में बैठता है।<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />परंतु वह तो यहोवा की</para>
  <para style="q2" vid="PSA 1:2">व्यवस्था से प्रसन्‍न रहता,</para>
  <para style="q1" vid="PSA 1:2">और उसकी व्यवस्था पर दिन</para>
  <para style="q2" vid="PSA 1:2">और रात मनन करता है।<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />वह जल-धाराओं के किनारे लगाए गए</para>
  <para style="q2" vid="PSA 1:3">उस वृक्ष के समान है,</para>
  <para style="q1" vid="PSA 1:3">जो अपनी ऋतु में फलता है,</para>
  <para style="q2" vid="PSA 1:3">और जिसके पत्ते कभी मुरझाते नहीं।</para>
  <para style="q1" vid="PSA 1:3">इसलिए जो कुछ वह करता है,</para>
  <para style="q2" vid="PSA 1:3">उसमें वह सफल होता है।<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />दुष्‍ट लोग ऐसे नहीं होते;</para>
  <para style="q2" vid="PSA 1:4">बल्कि वे तो उस भूसी के समान होते हैं,</para>
  <para style="q3" vid="PSA 1:4">जिसे पवन उड़ा ले जाता है।<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />इस कारण दुष्‍ट लोग</para>
  <para style="q2" vid="PSA 1:5">न्याय का सामना न कर सकेंगे,</para>
  <para style="q1" vid="PSA 1:5">और न पापी धर्मियों की</para>
  <para style="q2" vid="PSA 1:5">मंडली में ठहर सकेंगे;<verse eid="PSA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />क्योंकि यहोवा धर्मियों का मार्ग जानता है,</para>
  <para style="q2" vid="PSA 1:6">परंतु दुष्‍टों का मार्ग नष्‍ट हो जाएगा।<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s1">पुत्र का राज्याभिषेक</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />जाति-जाति के लोग क्यों हुल्लड़ मचाते हैं,</para>
  <para style="q2" vid="PSA 2:1">और देश-देश के लोग व्यर्थ बातें</para>
  <para style="q3" vid="PSA 2:1">क्यों सोचते हैं?<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />यहोवा और उसके अभिषिक्‍त<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">या मसीहा</char></note> के विरुद्ध</para>
  <para style="q2" vid="PSA 2:2">पृथ्वी के राजा मिलकर,</para>
  <para style="q1" vid="PSA 2:2">और शासक आपस में</para>
  <para style="q2" vid="PSA 2:2">सम्मति करके कहते हैं,<verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />“आओ, हम उनके बंधनों को तोड़ डालें,</para>
  <para style="q2" vid="PSA 2:3">और उनकी रस्सियों को</para>
  <para style="q3" vid="PSA 2:3">अपने ऊपर से उतार फेंकें।”<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />वह जो स्वर्ग में विराजमान है,</para>
  <para style="q2" vid="PSA 2:4">हँसेगा; मेरा प्रभु उन्हें ठट्ठों में उड़ाएगा।<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />तब वह क्रोध में उनसे बातें करेगा;</para>
  <para style="q2" vid="PSA 2:5">वह उन्हें अपने प्रकोप से</para>
  <para style="q3" vid="PSA 2:5">भयभीत कर देगा और कहेगा :<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />“मैं तो अपने पवित्र पर्वत</para>
  <para style="q2" vid="PSA 2:6">सिय्योन के सिंहासन पर अपने राजा को</para>
  <para style="q3" vid="PSA 2:6">बैठा चुका हूँ।”<verse eid="PSA 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7" />मैं यहोवा के वचन का प्रचार करूँगा :</para>
  <para style="q2" vid="PSA 2:7">उसने मुझसे कहा, “तू मेरा पुत्र है,</para>
  <para style="q3" vid="PSA 2:7">आज तू मुझसे उत्पन्‍न‍ हुआ है।<verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />मुझसे माँग, और मैं जाति-जाति के</para>
  <para style="q2" vid="PSA 2:8">लोगों को तेरे अधिकार में,</para>
  <para style="q1" vid="PSA 2:8">और सारी पृथ्वी को</para>
  <para style="q2" vid="PSA 2:8">तेरी निज भूमि होने के लिए दे दूँगा।<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />तू उन्हें लोहे के डंडे से</para>
  <para style="q2" vid="PSA 2:9">टुकड़े-टुकड़े करेगा,</para>
  <para style="q1" vid="PSA 2:9">तू कुम्हार के बरतन के समान</para>
  <para style="q2" vid="PSA 2:9">उन्हें चकनाचूर कर डालेगा।”<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />इसलिए अब, हे राजाओ, बुद्धिमान बनो;</para>
  <para style="q2" vid="PSA 2:10">हे पृथ्वी के न्यायियो,</para>
  <para style="q3" vid="PSA 2:10">सावधान हो जाओ।<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />भय के साथ यहोवा की आराधना करो,</para>
  <para style="q2" vid="PSA 2:11">और काँपते हुए मगन होओ।<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />पुत्र का सम्मान करो<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">अक्षरशः पुत्र को चूमो</char></note>,</para>
  <para style="q2" vid="PSA 2:12">ऐसा न हो कि वह क्रोध करे,</para>
  <para style="q1" vid="PSA 2:12">और तुम मार्ग ही में नष्‍ट हो जाओ,</para>
  <para style="q2" vid="PSA 2:12">क्योंकि क्षण भर में</para>
  <para style="q1" vid="PSA 2:12">उसका क्रोध भड़कने पर है।</para>
  <para style="q2" vid="PSA 2:12">क्या ही धन्य हैं वे सब</para>
  <para style="q3" vid="PSA 2:12">जो उसकी शरण में आते हैं।<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="s1">संकट के समय में भरोसा</para>
  <para style="b" />
  <para style="d">दाऊद का भजन। जब वह अपने पुत्र अबशालोम से भाग रहा था।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1" />हे यहोवा, मेरे शत्रु कितने बढ़ गए हैं!</para>
  <para style="q2" vid="PSA 3:1">बहुत से हैं जो मेरे विरुद्ध उठ रहे हैं।<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />बहुत से हैं जो मेरे प्राण के विषय में कहते हैं</para>
  <para style="q2" vid="PSA 3:2">कि परमेश्‍वर की ओर से उसका छुटकारा नहीं। सेला।<verse eid="PSA 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />परंतु हे यहोवा, तू तो मेरे चारों ओर मेरी ढाल है,</para>
  <para style="q2" vid="PSA 3:3">तू मेरी महिमा है, और मेरे सिर को ऊँचा उठानेवाला है।<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />मैंने ऊँची आवाज़ से यहोवा को पुकारा,</para>
  <para style="q2" vid="PSA 3:4">और उसने अपने पवित्र पर्वत से मुझे उत्तर दिया। सेला।<verse eid="PSA 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />मैं लेटकर सो गया।</para>
  <para style="q2" vid="PSA 3:5">मैं फिर जाग उठा,</para>
  <para style="q1" vid="PSA 3:5">क्योंकि यहोवा मुझे संभालता है।<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />मैं उन हज़ारों मनुष्यों से नहीं डरता,</para>
  <para style="q2" vid="PSA 3:6">जो मेरे विरुद्ध घेरा डाले हुए हैं।<verse eid="PSA 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />उठ, हे यहोवा! हे मेरे परमेश्‍वर मुझे बचा!</para>
  <para style="q2" vid="PSA 3:7">क्योंकि तूने मेरे सब शत्रुओं के जबड़ों पर मारा है,</para>
  <para style="q1" vid="PSA 3:7">और दुष्‍टों के दाँत तोड़ डाले हैं।<verse eid="PSA 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />उद्धार यहोवा ही से होता है;</para>
  <para style="q2" vid="PSA 3:8">हे यहोवा तेरी आशिष तेरी प्रजा पर हो। सेला।<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="s1">संध्याकालीन प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। तारवाले वाद्य-यंत्रों के साथ दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1" />हे मेरे धर्ममय परमेश्‍वर,</para>
  <para style="q2" vid="PSA 4:1">जब मैं पुकारूँ तब तू मुझे उत्तर दे।</para>
  <para style="q1" vid="PSA 4:1">जब मैं संकट में था तब तूने मुझे छुड़ाया।</para>
  <para style="q2" vid="PSA 4:1">मुझ पर अनुग्रह कर और मेरी प्रार्थना सुन।<verse eid="PSA 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />हे मनुष्य के पुत्रो,</para>
  <para style="q2" vid="PSA 4:2">कब तक मेरी महिमा का निरादर होता रहेगा?</para>
  <para style="q1" vid="PSA 4:2">तुम कब तक व्यर्थ बातों से प्रीति रखोगे</para>
  <para style="q2" vid="PSA 4:2">और असत्य की खोज में रहोगे? सेला।<verse eid="PSA 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />यह जान लो कि यहोवा ने भक्‍त को</para>
  <para style="q2" vid="PSA 4:3">अपने लिए अलग कर रखा है;</para>
  <para style="q1" vid="PSA 4:3">जब मैं यहोवा को पुकारूँगा तब वह सुन लेगा।<verse eid="PSA 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />क्रोध तो करो, पर पाप मत करो।</para>
  <para style="q2" vid="PSA 4:4">अपने बिछौनों पर मन ही मन</para>
  <para style="q1" vid="PSA 4:4">सोचो और चुपचाप रहो। सेला।<verse eid="PSA 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />धार्मिकता के बलिदान चढा़ओ,</para>
  <para style="q2" vid="PSA 4:5">और यहोवा पर भरोसा रखो।<verse eid="PSA 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />बहुत से हैं जो कहते हैं,</para>
  <para style="q2" vid="PSA 4:6">“कौन हमें भलाई दिखाएगा?”</para>
  <para style="q1" vid="PSA 4:6">हे यहोवा, तू अपने मुख का प्रकाश हम पर चमका!<verse eid="PSA 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />तूने मेरे मन में उससे कहीं अधिक आनंद भर दिया है,</para>
  <para style="q2" vid="PSA 4:7">जो उन्हें अन्‍न‍ और दाखमधु की बहुतायत से होता था।<verse eid="PSA 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />मैं शांति से लेट जाऊँगा और सो जाऊँगा;</para>
  <para style="q2" vid="PSA 4:8">क्योंकि, हे यहोवा, केवल तू ही मुझे सुरक्षित रखता है।<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="s1">धर्मी की सुरक्षा के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए : बाँसुरियों के साथ। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1" />हे यहोवा, मेरे वचनों पर कान लगा;</para>
  <para style="q2" vid="PSA 5:1">मेरे कराहने की ओर ध्यान दे।<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />हे मेरे राजा, हे मेरे परमेश्‍वर,</para>
  <para style="q2" vid="PSA 5:2">मेरी दुहाई पर ध्यान दे,</para>
  <para style="q1" vid="PSA 5:2">क्योंकि मैं तुझी से प्रार्थना करता हूँ।<verse eid="PSA 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3" />हे यहोवा, भोर को मेरी वाणी तुझे सुनाई देगी,</para>
  <para style="q2" vid="PSA 5:3">मैं भोर को प्रार्थना करके तेरी प्रतीक्षा करूँगा।<verse eid="PSA 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />तू ऐसा ईश्‍वर नहीं जो दुष्‍टता से प्रसन्‍न हो;</para>
  <para style="q2" vid="PSA 5:4">और न ही बुराई तेरे साथ रह सकती है।<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />घमंडी तेरे सामने खड़े नहीं रह पाएँगे;</para>
  <para style="q2" vid="PSA 5:5">तू सब कुकर्मियों से घृणा करता है।<verse eid="PSA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6" />तू झूठ बोलनेवालों को नष्‍ट करता है।</para>
  <para style="q2" vid="PSA 5:6">यहोवा हत्यारे और छली मनुष्य से घृणा करता है।<verse eid="PSA 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />परंतु मैं तो तेरी अपार करुणा के कारण तेरे भवन में आऊँगा।</para>
  <para style="q2" vid="PSA 5:7">मैं तेरा भय मानकर तेरे पवित्र मंदिर की ओर दंडवत् करूँगा।<verse eid="PSA 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />हे यहोवा, मेरे शत्रुओं के कारण</para>
  <para style="q2" vid="PSA 5:8">धार्मिकता के मार्ग में मेरी अगुवाई कर;</para>
  <para style="q1" vid="PSA 5:8">मेरे आगे-आगे अपना सीधा मार्ग दिखा।<verse eid="PSA 5:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />उनके मुँह में कोई सच्‍चाई नहीं है;</para>
  <para style="q2" vid="PSA 5:9">उनके मन में दुष्‍टता भरी है।</para>
  <para style="q1" vid="PSA 5:9">उनका गला खुली हुई कब्र है,</para>
  <para style="q2" vid="PSA 5:9">और वे अपनी जीभ से चिकनी-चुपड़ी बातें करते हैं।<verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />हे परमेश्‍वर, तू उन्हें दोषी ठहरा।</para>
  <para style="q2" vid="PSA 5:10">वे अपनी ही युक्‍तियों से गिर जाएँ;</para>
  <para style="q1" vid="PSA 5:10">उन्हें उनके अपराधों की अधिकाई के कारण निकाल बाहर कर,</para>
  <para style="q2" vid="PSA 5:10">क्योंकि उन्होंने तेरे विरुद्ध विद्रोह किया है।<verse eid="PSA 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />परंतु जो तेरी शरण लेते हैं वे सब मगन हों।</para>
  <para style="q2" vid="PSA 5:11">वे सदैव आनंद के गीत गाते रहें,</para>
  <para style="q1" vid="PSA 5:11">क्योंकि तू उनकी रक्षा करता है;</para>
  <para style="q2" vid="PSA 5:11">और जो तेरे नाम के प्रेमी हैं वे तुझमें प्रफुल्लित हों।<verse eid="PSA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />हे यहोवा, तू धर्मी मनुष्य को आशिष देता है;</para>
  <para style="q2" vid="PSA 5:12">तू उसे अपनी अनुग्रहरूपी ढाल से घेरे रहता है।<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s1">दया के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। आठ तारवाले वाद्य-यंत्रों के साथ दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1" />हे यहोवा, तू मुझे अपने क्रोध में न डाँट,</para>
  <para style="q2" vid="PSA 6:1">और न अपने प्रकोप में मुझे ताड़ना दे।<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />हे यहोवा, मुझ पर अनुग्रह कर,</para>
  <para style="q2" vid="PSA 6:2">क्योंकि मैं मुरझा गया हूँ।</para>
  <para style="q1" vid="PSA 6:2">हे यहोवा, मुझे चंगा कर,</para>
  <para style="q2" vid="PSA 6:2">क्योंकि मेरी हड्डियाँ व्याकुल हो गई हैं।<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />मेरा प्राण भी बहुत बेचैन है।</para>
  <para style="q2" vid="PSA 6:3">पर तू, हे यहोवा, कब तक?<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />हे यहोवा लौट आ, और मेरा प्राण बचा ले;</para>
  <para style="q2" vid="PSA 6:4">अपनी करुणा के निमित्त मेरा उद्धार कर।<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />क्योंकि मृत्यु के बाद कोई तुझे स्मरण नहीं करता;</para>
  <para style="q2" vid="PSA 6:5">अधोलोक<note caller="+" style="f"><char style="fr" closed="false">6:5 </char><char style="ft" closed="false">इब्रानी में “शिओल”</char></note> में कौन तेरा धन्यवाद करेगा?<verse eid="PSA 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />मैं कराहते-कराहते थक गया हूँ;</para>
  <para style="q2" vid="PSA 6:6">हर रात मैं आँसुओं से अपना बिछौना तर कर देता हूँ;</para>
  <para style="q1" vid="PSA 6:6">आँसुओं से मेरी खाट भीगती है।<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />शोक से मेरी आँखें सूज गई हैं,</para>
  <para style="q2" vid="PSA 6:7">और मेरे सब सतानेवालों के कारण वे धुँधला गई हैं।<verse eid="PSA 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />हे सब कुकर्मियो, मुझसे दूर हो जाओ;</para>
  <para style="q2" vid="PSA 6:8">क्योंकि यहोवा ने मेरे रोने की आवाज़ सुन ली है।<verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />यहोवा ने मेरा गिड़गिड़ाना सुना है;</para>
  <para style="q2" vid="PSA 6:9">यहोवा मेरी प्रार्थना को ग्रहण भी करेगा।<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />मेरे सब शत्रु लज्‍जित होंगे</para>
  <para style="q2" vid="PSA 6:10">और बहुत घबरा जाएँगे।</para>
  <para style="q1" vid="PSA 6:10">वे लौट जाएँगे और क्षण भर में लज्‍जित होंगे।<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="s1">न्याय के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">दाऊद का शिग्गायोन भजन, जो उसने बिन्यामीनी कूश की बातों के कारण यहोवा के सामने गाया था।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1" />हे मेरे परमेश्‍वर यहोवा, मैंने तेरी शरण ली है।</para>
  <para style="q2" vid="PSA 7:1">उन सब से जो मेरा पीछा करते हैं,</para>
  <para style="q1" vid="PSA 7:1">मुझे बचा और छुटकारा दे।<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />ऐसा न हो कि वे सिंह के समान</para>
  <para style="q2" vid="PSA 7:2">मुझे फाड़कर टुकड़े-टुकड़े कर डालें;</para>
  <para style="q1" vid="PSA 7:2">और मेरा कोई छुड़ानेवाला न हो।<verse eid="PSA 7:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3" />हे मेरे परमेश्‍वर यहोवा, यदि मैंने यह किया हो,</para>
  <para style="q2" vid="PSA 7:3">यदि मेरे हाथों से अधर्म हुआ हो,<verse eid="PSA 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4" />यदि मैंने उनके साथ बुराई की हो</para>
  <para style="q2" vid="PSA 7:4">जो मेरे साथ मेल रखते हैं,</para>
  <para style="q1" vid="PSA 7:4">या मैंने उसे लूटा हो जो अकारण मेरा विरोधी था,<verse eid="PSA 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5" />तो शत्रु मेरे प्राण का पीछा करके मुझे आ पकड़े,</para>
  <para style="q2" vid="PSA 7:5">और मुझे भूमि पर रौंदे,</para>
  <para style="q1" vid="PSA 7:5">और मेरे सम्मान को मिट्टी में मिला दे। सेला।<verse eid="PSA 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />हे यहोवा, अपने क्रोध में उठ!</para>
  <para style="q2" vid="PSA 7:6">क्रोध से भरे मेरे विरोधियों के विरुद्ध</para>
  <para style="q1" vid="PSA 7:6">तू खड़ा हो जा! मेरे लिए जाग!</para>
  <para style="q2" vid="PSA 7:6">तूने तो न्याय का आदेश दिया है।<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />देश-देश के लोगों की मंडली तेरे चारों ओर इकट्ठी हो;</para>
  <para style="q2" vid="PSA 7:7">और तू उस पर ऊपर से राज्य करे।<verse eid="PSA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8" />यहोवा जाति-जाति का न्याय करता है।</para>
  <para style="q2" vid="PSA 7:8">हे यहोवा, मेरी धार्मिकता और खराई के अनुसार मेरा न्याय कर।<verse eid="PSA 7:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />भला हो कि दुष्‍टों की बुराई का अंत हो जाए,</para>
  <para style="q2" vid="PSA 7:9">परंतु तू धर्मी को स्थिर कर;</para>
  <para style="q1" vid="PSA 7:9">क्योंकि धर्मी परमेश्‍वर तो मन और हृदय का जाँचनेवाला है।<verse eid="PSA 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />मेरी ढाल परमेश्‍वर के हाथ में है,</para>
  <para style="q2" vid="PSA 7:10">जो सीधे मनवालों को बचाता है।<verse eid="PSA 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />परमेश्‍वर धर्मी और न्यायी है;</para>
  <para style="q2" vid="PSA 7:11">वह तो ऐसा ईश्‍वर है जो प्रतिदिन दुष्‍टों पर क्रोध करता है।<verse eid="PSA 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />यदि मनुष्य मन न फिराए,</para>
  <para style="q2" vid="PSA 7:12">तो परमेश्‍वर अपनी तलवार की धार पैनी करेगा।</para>
  <para style="q1" vid="PSA 7:12">उसने अपना धनुष चढा़कर तीर साध लिया है;<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />उसने उसके लिए घातक हथियार तैयार कर लिए हैं;</para>
  <para style="q2" vid="PSA 7:13">वह अपने तीरों को अग्‍निबाण बनाता है।<verse eid="PSA 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />देख, दुष्‍ट को अनर्थ कार्य की प्रसव-पीड़ा हो रही है,</para>
  <para style="q2" vid="PSA 7:14">उसके गर्भ में उत्पात है, और उससे झूठ का जन्म हुआ।<verse eid="PSA 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15" />उसने गड्‌ढा खोदकर उसे गहरा किया,</para>
  <para style="q2" vid="PSA 7:15">और जो खाई उसने बनाई थी</para>
  <para style="q1" vid="PSA 7:15">उसमें वह आप ही गिर पड़ा।<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />उसका उत्पात वापस उसी के सिर पर आ पड़ेगा;</para>
  <para style="q2" vid="PSA 7:16">और उसका उपद्रव उसी के माथे पर गिरेगा।<verse eid="PSA 7:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />मैं यहोवा की धार्मिकता के अनुसार उसका धन्यवाद करूँगा,</para>
  <para style="q2" vid="PSA 7:17">और परमप्रधान यहोवा के नाम का भजन गाऊँगा।<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="s1">परमेश्‍वर की महिमा और मनुष्य का गौरव</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। गित्तीथ की राग पर दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1" />हे यहोवा, हे हमारे प्रभु,</para>
  <para style="q2" vid="PSA 8:1">तेरा नाम सारी पृथ्वी पर क्या ही प्रतापमय है!</para>
  <para style="b" vid="PSA 8:1" />
  <para style="q1" vid="PSA 8:1">तूने अपना वैभव स्वर्ग पर दिखाया है।<verse eid="PSA 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2" />तूने अपने बैरियों के कारण</para>
  <para style="q2" vid="PSA 8:2">बच्‍चों और शिशुओं के मुँह से अपना सामर्थ्य स्थापित किया है,</para>
  <para style="q1" vid="PSA 8:2">ताकि तू शत्रु और बदला लेनेवाले को रोक रखे।<verse eid="PSA 8:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />जब मैं आकाश को, जो तेरे हाथों का कार्य है,</para>
  <para style="q2" vid="PSA 8:3">और चंद्रमा और तारागण को जो तूने नियुक्‍त किए हैं, देखता हूँ;<verse eid="PSA 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4" />तो फिर मनुष्य क्या है कि तू उसका स्मरण रखे,</para>
  <para style="q2" vid="PSA 8:4">और मनुष्य का पुत्र क्या है कि तू उसकी सुधि ले?<verse eid="PSA 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />तूने तो उसे परमेश्‍वर से<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">या स्वर्गदूतों से</char></note> थोड़ा ही कम बनाया है,</para>
  <para style="q2" vid="PSA 8:5">और उस पर महिमा और आदर का मुकुट रखा है।<verse eid="PSA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />तूने उसे अपने हाथों के कार्यों पर अधिकार दिया है;</para>
  <para style="q2" vid="PSA 8:6">तूने सब कुछ उसके पैरों तले कर दिया है :<verse eid="PSA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7" />सब भेड़-बकरी और गाय-बैल</para>
  <para style="q2" vid="PSA 8:7">और जितने वनपशु हैं,<verse eid="PSA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8" />आकाश के पक्षी और समुद्र की मछलियाँ, और जितने</para>
  <para style="q2" vid="PSA 8:8">जीव-जंतु समुद्रों में चलते फिरते हैं।<verse eid="PSA 8:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />हे यहोवा, हे हमारे प्रभु,</para>
  <para style="q2" vid="PSA 8:9">तेरा नाम सारी पृथ्वी पर क्या ही प्रतापमय है!<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="s1">परमेश्‍वर के न्याय के लिए धन्यवाद का भजन</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। मूथ-लाब्बेन की राग पर दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1" />हे यहोवा, मैं अपने संपूर्ण मन से तेरा धन्यवाद करूँगा;</para>
  <para style="q2" vid="PSA 9:1">मैं तेरे सब आश्‍चर्यकर्मों का वर्णन करूँगा।<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />मैं तेरे कारण मगन और आनंदित होऊँगा,</para>
  <para style="q2" vid="PSA 9:2">हे परमप्रधान, मैं तेरे नाम का भजन गाऊँगा।<verse eid="PSA 9:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />जब मेरे शत्रु पीछे हटते हैं,</para>
  <para style="q2" vid="PSA 9:3">तो वे तेरे सामने लड़खड़ाकर नष्‍ट हो जाते हैं।<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />तूने मेरे पक्ष में निर्णय दिया है;</para>
  <para style="q2" vid="PSA 9:4">तूने सिंहासन पर विराजमान होकर धार्मिकता से न्याय किया है।<verse eid="PSA 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />तूने जाति-जाति को झिड़का और दुष्‍ट को नष्‍ट किया है;</para>
  <para style="q2" vid="PSA 9:5">तूने उनका नाम सदा-सर्वदा के लिए मिटा दिया है।<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />शत्रु अनंतकाल के लिए उजड़ गए हैं;</para>
  <para style="q2" vid="PSA 9:6">तूने उनके नगरों को ढा दिया है,</para>
  <para style="q1" vid="PSA 9:6">और उनका स्मरण भी न रहा।<verse eid="PSA 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />परंतु यहोवा सदैव अपने सिंहासन पर विराजमान है,</para>
  <para style="q2" vid="PSA 9:7">उसने अपना सिंहासन न्याय के लिए स्थापित किया है।<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />वह जगत का न्याय धार्मिकता से करेगा,</para>
  <para style="q2" vid="PSA 9:8">और देश-देश के लोगों का न्याय खराई से करेगा।<verse eid="PSA 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />यहोवा पिसे हुओं के लिए दृढ़ गढ़ है;</para>
  <para style="q2" vid="PSA 9:9">वह संकट के समय दृढ़ गढ़ है।<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />जो तेरे नाम को जानते हैं,</para>
  <para style="q2" vid="PSA 9:10">वे तुझ पर भरोसा रखेंगे,</para>
  <para style="q1" vid="PSA 9:10">क्योंकि हे यहोवा, तूने अपने खोजियों को त्याग नहीं दिया है।<verse eid="PSA 9:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />यहोवा जो सिय्योन में विराजमान है,</para>
  <para style="q2" vid="PSA 9:11">उसका भजन गाओ! जाति-जाति के लोगों के बीच</para>
  <para style="q1" vid="PSA 9:11">उसके कार्यों का प्रचार करो!<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />क्योंकि लहू का बदला लेनेवाला उनको स्मरण रखता है;</para>
  <para style="q2" vid="PSA 9:12">वह पीड़ितों की दुहाई को नहीं भूलता।<verse eid="PSA 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13" />हे यहोवा, मुझ पर अनुग्रह कर!</para>
  <para style="q2" vid="PSA 9:13">मेरी पीड़ा को देख जो मेरे बैरी मुझे दे रहे हैं;</para>
  <para style="q1" vid="PSA 9:13">तू मुझे मृत्यु के फाटकों के पास से उठाता है,<verse eid="PSA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14" />कि मैं तेरे सब गुणों का वर्णन करूँ,</para>
  <para style="q2" vid="PSA 9:14">और सिय्योन के फाटकों के भीतर</para>
  <para style="q1" vid="PSA 9:14">तेरे उद्धार का आनंद मनाऊँ।<verse eid="PSA 9:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />अन्य जातिवालों ने जो गड्‌ढा खोदा था,</para>
  <para style="q2" vid="PSA 9:15">वे उसी में गिर पड़े;</para>
  <para style="q1" vid="PSA 9:15">जो जाल उन्होंने बिछाया था,</para>
  <para style="q2" vid="PSA 9:15">उनका पैर उसी में फँस गया।<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />यहोवा ने स्वयं को प्रकट किया है,</para>
  <para style="q2" vid="PSA 9:16">उसने न्याय किया है;</para>
  <para style="q1" vid="PSA 9:16">दुष्‍ट अपने ही हाथों के कार्य से</para>
  <para style="q2" vid="PSA 9:16">फँस जाता है। हिग्गायोन। सेला।<verse eid="PSA 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />दुष्‍ट अधोलोक में लौट जाएँगे,</para>
  <para style="q2" vid="PSA 9:17">और वे सब जातियाँ भी जो परमेश्‍वर को भूल जाती हैं।<verse eid="PSA 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />क्योंकि दरिद्र सदा के लिए भुलाए नहीं जाएँगे,</para>
  <para style="q2" vid="PSA 9:18">और न पीड़ितों की आशा सर्वदा के लिए नष्‍ट होगी।<verse eid="PSA 9:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />उठ, हे यहोवा, मनुष्य को प्रबल न होने दे!</para>
  <para style="q2" vid="PSA 9:19">जाति-जाति का न्याय तेरे सामने किया जाए।<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />हे यहोवा, उन्हें भयभीत कर।</para>
  <para style="q2" vid="PSA 9:20">जातियाँ यह जान लें कि</para>
  <para style="q1" vid="PSA 9:20">वे मात्र मनुष्य ही हैं। सेला।<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s1">न्याय के लिए प्रार्थना</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1" />हे यहोवा, तू क्यों दूर खड़ा रहता है?</para>
  <para style="q2" vid="PSA 10:1">संकट के समय तू क्यों छिपा रहता है?<verse eid="PSA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />दुष्‍ट अपने अहंकार में दीनों के पीछे पड़ जाते हैं।</para>
  <para style="q2" vid="PSA 10:2">वे अपनी ही बनाई युक्‍तियों में फँस जाएँ।<verse eid="PSA 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />दुष्‍ट अपने मन की अभिलाषा पर घमंड करता है,</para>
  <para style="q2" vid="PSA 10:3">और लोभी मनुष्य यहोवा को शाप देता</para>
  <para style="q1" vid="PSA 10:3">और उसका तिरस्कार करता है।<verse eid="PSA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />दुष्‍ट अपने अभिमान के कारण परमेश्‍वर को नहीं खोजता;</para>
  <para style="q2" vid="PSA 10:4">वह सोचता है कि कोई परमेश्‍वर है ही नहीं।<verse eid="PSA 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />वह अपनी चालों में हर समय सफल होता है;</para>
  <para style="q2" vid="PSA 10:5">तेरे न्याय के विचार इतने ऊँचे हैं</para>
  <para style="q1" vid="PSA 10:5">कि उसकी दृष्‍टि वहाँ तक नहीं पहुँचती।</para>
  <para style="q2" vid="PSA 10:5">वह अपने सब विरोधियों पर फुँकारता है।<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />वह अपने मन में कहता है,</para>
  <para style="q2" vid="PSA 10:6">“मैं कभी न टलूँगा :</para>
  <para style="q1" vid="PSA 10:6">पीढ़ी से पीढ़ी तक मुझ पर कोई विपत्ति न पड़ेगी।”<verse eid="PSA 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />उसका मुँह तो शाप और छल और दुष्‍टता से भरा है,</para>
  <para style="q2" vid="PSA 10:7">उसकी जीभ पर उत्पात और बुराई हैं।<verse eid="PSA 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8" />वह गाँवों में घात लगाए बैठा रहता है,</para>
  <para style="q2" vid="PSA 10:8">और गुप्‍त स्थानों में निर्दोष की हत्या करता है।</para>
  <para style="q1" vid="PSA 10:8">उसकी आँखें असहाय मनुष्य की घात में लगी रहती हैं।<verse eid="PSA 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9" />जैसे सिंह झाड़ी में घात लगाए रहता है,</para>
  <para style="q2" vid="PSA 10:9">वैसे ही वह छिपकर असहाय को पकड़ने के लिए घात लगाए रहता है;</para>
  <para style="q1" vid="PSA 10:9">और जब असहाय मनुष्य उसके जाल में फँस जाता है,</para>
  <para style="q2" vid="PSA 10:9">तो वह उसे पकड़ लेता है।<verse eid="PSA 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10" />तब वह असहाय मनुष्य दबकर झुक जाता है,</para>
  <para style="q2" vid="PSA 10:10">और उसके बलवंत हाथों द्वारा कुचला जाता है।<verse eid="PSA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11" />दुष्‍ट अपने मन में कहता है,</para>
  <para style="q2" vid="PSA 10:11">“परमेश्‍वर भूल गया है,</para>
  <para style="q1" vid="PSA 10:11">उसने अपना मुँह छिपा रखा है;</para>
  <para style="q2" vid="PSA 10:11">वह कभी नहीं देखेगा।”<verse eid="PSA 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12" />उठ, हे यहोवा! हे परमेश्‍वर, अपना हाथ बढ़ा,</para>
  <para style="q2" vid="PSA 10:12">और असहाय मनुष्यों को न भूल।<verse eid="PSA 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13" />दुष्‍ट व्यक्‍ति परमेश्‍वर को क्यों तुच्छ जानता है?</para>
  <para style="q2" vid="PSA 10:13">वह अपने मन में कहता है,</para>
  <para style="q1" vid="PSA 10:13">“तू लेखा नहीं लेगा।”<verse eid="PSA 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14" />तूने देख लिया है,</para>
  <para style="q2" vid="PSA 10:14">और तू उनकी बुराई और अत्याचार को देखता है</para>
  <para style="q1" vid="PSA 10:14">ताकि उसका पलटा अपने हाथों से ले।</para>
  <para style="q2" vid="PSA 10:14">असहाय मनुष्य स्वयं को</para>
  <para style="q1" vid="PSA 10:14">तेरे हाथों में सौंपता है।</para>
  <para style="q2" vid="PSA 10:14">तू अनाथों का सहायक है।<verse eid="PSA 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15" />दुष्‍ट और बुराई करनेवालों की भुजा को तोड़ डाल।</para>
  <para style="q2" vid="PSA 10:15">उसकी दुष्‍टता को ढूँढ़कर निकाल कि कुछ भी रह न जाए।<verse eid="PSA 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16" />यहोवा युगानुयुग के लिए राजा है।</para>
  <para style="q2" vid="PSA 10:16">उसके देश में से जाति-जाति के लोग नष्‍ट हो गए हैं।<verse eid="PSA 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17" />हे यहोवा, तूने नम्र लोगों की इच्छा सुनी है;</para>
  <para style="q2" vid="PSA 10:17">तू उनके मन को दृढ़ करेगा और अपने कान उनकी ओर लगाएगा,<verse eid="PSA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18" />कि अनाथ और कुचले हुओं का न्याय करे,</para>
  <para style="q2" vid="PSA 10:18">ताकि मिट्टी से रचा गया मनुष्य</para>
  <para style="q1" vid="PSA 10:18">फिर कभी भय का कारण न बने।<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="s1">यहोवा की शरण लेना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1" />मैंने यहोवा की शरण ली है।</para>
  <para style="q2" vid="PSA 11:1">तुम मेरे प्राण से कैसे कह सकते हो,</para>
  <para style="q1" vid="PSA 11:1">“पक्षी के समान अपने पहाड़ पर उड़ जा”?<verse eid="PSA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2" />क्योंकि देखो, दुष्‍ट अपने धनुष चढ़ाते</para>
  <para style="q2" vid="PSA 11:2">और अपने तीर उसकी डोरी पर रखते हैं</para>
  <para style="q1" vid="PSA 11:2">कि सीधे मनवालों पर अंधकार में तीर चलाएँ।<verse eid="PSA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3" />यदि नीवें नष्‍ट कर दी जाएँ</para>
  <para style="q2" vid="PSA 11:3">तो धर्मी क्या कर सकता है?<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />यहोवा अपने पवित्र मंदिर में है;</para>
  <para style="q2" vid="PSA 11:4">यहोवा का सिंहासन स्वर्ग में है।</para>
  <para style="q1" vid="PSA 11:4">उसकी आँखें मनुष्य की संतान को देखती रहती हैं,</para>
  <para style="q2" vid="PSA 11:4">और उसकी पलकें उन्हें जाँचती हैं।<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />यहोवा धर्मी को परखता है,</para>
  <para style="q2" vid="PSA 11:5">परंतु उसका मन दुष्‍ट और उपद्रव से</para>
  <para style="q1" vid="PSA 11:5">प्रीति रखनेवालों से घृणा करता है।<verse eid="PSA 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />वह दुष्‍टों पर अंगारे<note caller="+" style="f"><char style="fr" closed="false">11:6 </char><char style="ft" closed="false">कुछ अनुवादों में “अंगारे” के स्थान पर “फंदे” लिखा है।</char></note> बरसाएगा;</para>
  <para style="q2" vid="PSA 11:6">आग और गंधक और प्रचंड लू उनके कटोरे का भाग होगी।<verse eid="PSA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />यहोवा तो धर्मी है,</para>
  <para style="q2" vid="PSA 11:7">वह धार्मिकता से प्रीति रखता है;</para>
  <para style="q1" vid="PSA 11:7">धर्मी जन उसका दर्शन पाएँगे।<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="s1">दुष्‍‍ट के द्वारा अत्याचार</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। आठ तारवाली वीणा<note caller="+" style="f"><char style="fr" closed="false">12:0 </char><char style="ft" closed="false">इब्रानी में “शमीनीथ”</char></note> पर दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1" />हे यहोवा, सहायता कर,</para>
  <para style="q2" vid="PSA 12:1">क्योंकि एक भी भक्‍त न रहा,</para>
  <para style="q1" vid="PSA 12:1">मनुष्यों में विश्‍वासयोग्य लोग नहीं रहे।<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />वे एक दूसरे से झूठ बोलते हैं;</para>
  <para style="q2" vid="PSA 12:2">वे चापलूसी भरे होंठों से और धोखा देनेवाले मन से बात करते हैं।<verse eid="PSA 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />यहोवा सब चापलूसी भरे होंठों को</para>
  <para style="q2" vid="PSA 12:3">और बड़ी-बड़ी बातें कहनेवाली जीभ को काट डाले।<verse eid="PSA 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4" />वे तो कहते हैं, “हम अपनी जीभ ही से जीतेंगे,</para>
  <para style="q2" vid="PSA 12:4">हमारे होंठ हमारे ही वश में हैं;</para>
  <para style="q1" vid="PSA 12:4">हमारा स्वामी कौन है?”<verse eid="PSA 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5" />यहोवा कहता है, “निर्बलों के दमन के कारण</para>
  <para style="q2" vid="PSA 12:5">और दरिद्रों के कराहने के कारण अब मैं उठूँगा।</para>
  <para style="q1" vid="PSA 12:5">मैं उसे वह सुरक्षा दूँगा जिसकी वह इच्छा रखता है।”<verse eid="PSA 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />यहोवा के वचन पवित्र हैं; वे ऐसी चाँदी के समान हैं</para>
  <para style="q2" vid="PSA 12:6">जो भट्ठी में सात बार ताई जाकर शुद्ध की गई है।<verse eid="PSA 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7" />हे यहोवा, तू ही उनकी रक्षा करेगा।</para>
  <para style="q2" vid="PSA 12:7">तू उन्हें इस पीढ़ी से सदैव बचाए रखेगा।<verse eid="PSA 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8" />जब मनुष्यों में नीचता का सम्मान होता है,</para>
  <para style="q2" vid="PSA 12:8">तो दुष्‍ट लोग चारों ओर अकड़ते फिरते हैं।<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="s1">छुटकारे के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1" />हे यहोवा, कब तक?</para>
  <para style="q2" vid="PSA 13:1">क्या तू सदा तक मुझे भूला रहेगा?</para>
  <para style="q1" vid="PSA 13:1">तू कब तक अपना मुँह मुझसे छिपाए रहेगा?<verse eid="PSA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2" />कब तक मैं अपने मन में व्याकुल रहूँ?</para>
  <para style="q2" vid="PSA 13:2">मैं कब तक अपने हृदय में शोकित रहूँ?</para>
  <para style="q1" vid="PSA 13:2">कब तक मेरा शत्रु मुझ पर प्रबल होता रहेगा?<verse eid="PSA 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />हे मेरे परमेश्‍वर यहोवा,</para>
  <para style="q2" vid="PSA 13:3">मुझ पर ध्यान दे और मुझे उत्तर दे;</para>
  <para style="q1" vid="PSA 13:3">मेरी आँखों में ज्योति चमका,</para>
  <para style="q2" vid="PSA 13:3">कहीं ऐसा न हो कि</para>
  <para style="q1" vid="PSA 13:3">मैं मृत्यु की नींद में सो जाऊँ।<verse eid="PSA 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4" />कहीं मेरा शत्रु कहे,</para>
  <para style="q2" vid="PSA 13:4">“मैं उस पर प्रबल हुआ हूँ।”</para>
  <para style="q1" vid="PSA 13:4">और जब मैं डगमगाने लगूँ</para>
  <para style="q2" vid="PSA 13:4">तो मेरे शत्रु मगन हों।<verse eid="PSA 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />परंतु मैंने तो तेरी करुणा पर भरोसा रखा है,</para>
  <para style="q2" vid="PSA 13:5">मेरा हृदय तेरे उद्धार के कारण मगन होगा।<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />मैं यहोवा का भजन गाऊँगा,</para>
  <para style="q2" vid="PSA 13:6">क्योंकि उसने मेरी भलाई की है।<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="s1">मनुष्य की मूर्खता और भ्रष्‍टता</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1" />मूर्ख अपने मन में कहता है,</para>
  <para style="q2" vid="PSA 14:1">“परमेश्‍वर है ही नहीं।”</para>
  <para style="q1" vid="PSA 14:1">वे भ्रष्‍ट हैं और घृणित कार्य करते हैं।</para>
  <para style="q2" vid="PSA 14:1">ऐसा कोई नहीं जो भलाई करता हो।<verse eid="PSA 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />यहोवा स्वर्ग से मनुष्यों पर दृष्‍टि करता है</para>
  <para style="q2" vid="PSA 14:2">कि देखे कि कोई बुद्धिमान,</para>
  <para style="q1" vid="PSA 14:2">कोई परमेश्‍वर का खोजी है या नहीं।<verse eid="PSA 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />वे सब भटक गए हैं,</para>
  <para style="q2" vid="PSA 14:3">सब के सब भ्रष्‍ट हो गए हैं;</para>
  <para style="q1" vid="PSA 14:3">कोई भलाई करनेवाला नहीं, एक भी नहीं।<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />क्या बुराई करनेवाले कुछ भी नहीं समझते,</para>
  <para style="q2" vid="PSA 14:4">जो मेरे लोगों को ऐसे खा जाते हैं</para>
  <para style="q1" vid="PSA 14:4">जैसे रोटी खाते हों,</para>
  <para style="q2" vid="PSA 14:4">और यहोवा का नाम भी नहीं लेते?<verse eid="PSA 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />उन पर भय छा गया है,</para>
  <para style="q2" vid="PSA 14:5">क्योंकि परमेश्‍वर तो धर्मियों<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="ft" closed="false">अक्षरशः धर्मी पीढ़ी</char></note> के साथ है।<verse eid="PSA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6" />तुम तो दीन की युक्‍ति को ठट्ठों में उड़ाते हो,</para>
  <para style="q2" vid="PSA 14:6">परंतु यहोवा उसका शरणस्थान है।<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7" />भला हो कि इस्राएल का उद्धार सिय्योन से प्रकट हो!</para>
  <para style="q2" vid="PSA 14:7">जब यहोवा अपनी प्रजा को बंधुआई से लौटा लाएगा,</para>
  <para style="q1" vid="PSA 14:7">तब याकूब मगन और इस्राएल आनंदित होगा।<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="s1">धर्मी जन की विशेषताएँ</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1" />हे यहोवा, तेरे तंबू में कौन रहेगा?</para>
  <para style="q2" vid="PSA 15:1">तेरे पवित्र पर्वत पर कौन वास करेगा?<verse eid="PSA 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />वह जो खराई से चलता और धार्मिकता के कार्य करता,</para>
  <para style="q2" vid="PSA 15:2">और हृदय से सच बोलता है।<verse eid="PSA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3" />वह अपनी जीभ से निंदा नहीं करता</para>
  <para style="q2" vid="PSA 15:3">और न अपने पड़ोसी की बुराई करता है,</para>
  <para style="q1" vid="PSA 15:3">और न ही अपने मित्र को बदनाम करता है।<verse eid="PSA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4" />उसकी दृष्‍टि में निकम्मा मनुष्य तुच्छ जाना जाता है,</para>
  <para style="q2" vid="PSA 15:4">परंतु वह यहोवा का भय माननेवालों का आदर करता है,</para>
  <para style="q1" vid="PSA 15:4">और शपथ खाकर बदलता नहीं चाहे हानि उठानी पड़े;<verse eid="PSA 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5" />वह अपना रुपया ब्याज पर नहीं देता</para>
  <para style="q2" vid="PSA 15:5">और न निर्दोष को हानि पहुँचाने के लिए घूस लेता है।</para>
  <para style="q1" vid="PSA 15:5">जो कोई ऐसी चाल चलता है वह कभी नहीं डगमगाएगा।<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="s1">यहोवा पर भरोसा</para>
  <para style="b" />
  <para style="d">दाऊद का मिक्‍ताम।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />हे परमेश्‍वर, मुझे सुरक्षित रख;</para>
  <para style="q2" vid="PSA 16:1">क्योंकि मैं तेरी शरण में आता हूँ।<verse eid="PSA 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />मैंने यहोवा से कहा, “तू ही मेरा प्रभु है;</para>
  <para style="q2" vid="PSA 16:2">तुझे छोड़ मेरी भलाई कहीं नहीं।”<verse eid="PSA 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />पृथ्वी पर जो पवित्र लोग हैं,</para>
  <para style="q2" vid="PSA 16:3">वे ही आदर के योग्य हैं;</para>
  <para style="q1" vid="PSA 16:3">उनसे मैं अति प्रसन्‍न हूँ।<verse eid="PSA 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />जो अन्य देवताओं के पीछे भागते हैं,</para>
  <para style="q2" vid="PSA 16:4">उनका दुःख बढ़ जाएगा;</para>
  <para style="q1" vid="PSA 16:4">मैं उनके लहूवाले अर्घ नहीं चढ़ाऊँगा</para>
  <para style="q2" vid="PSA 16:4">और न उनका नाम अपने होंठों से लूँगा।<verse eid="PSA 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />यहोवा मेरा भाग और मेरा कटोरा है;</para>
  <para style="q2" vid="PSA 16:5">तू मेरे भाग को संभालता है।<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />मेरे लिए माप की डोरी मनभावने स्थानों पर पड़ी,</para>
  <para style="q2" vid="PSA 16:6">निश्‍चय ही मेरा भाग बड़ा सुंदर है।<verse eid="PSA 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />मैं यहोवा को धन्य कहूँगा जो मुझे सम्मति देता है;</para>
  <para style="q2" vid="PSA 16:7">रात को भी मेरा मन मुझे शिक्षा देता है।<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />मैं यहोवा को निरंतर अपने सामने रखता हूँ;</para>
  <para style="q2" vid="PSA 16:8">वह मेरे दाहिने हाथ रहता है,</para>
  <para style="q1" vid="PSA 16:8">इसलिए मैं कभी न डगमगाऊँगा।<verse eid="PSA 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />इस कारण मेरा हृदय आनंदित</para>
  <para style="q2" vid="PSA 16:9">और मेरी आत्मा मगन हुई;</para>
  <para style="q1" vid="PSA 16:9">मेरा शरीर भी सुरक्षित रहेगा,<verse eid="PSA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10" />क्योंकि तू मेरे प्राण को अधोलोक में न छोड़ेगा,</para>
  <para style="q2" vid="PSA 16:10">और न अपने पवित्र भक्‍त को कब्र में सड़ने देगा।<verse eid="PSA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />तू मुझे जीवन का मार्ग दिखाएगा;</para>
  <para style="q2" vid="PSA 16:11">तेरी उपस्थिति में आनंद की भरपूरी है,</para>
  <para style="q1" vid="PSA 16:11">तेरे दाहिने हाथ में सुख सर्वदा बना रहता है।<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="s1">सुरक्षा के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">दाऊद की प्रार्थना।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1" />हे यहोवा, उचित पक्ष को सुन,</para>
  <para style="q2" vid="PSA 17:1">मेरी पुकार पर ध्यान दे;</para>
  <para style="q1" vid="PSA 17:1">मेरी प्रार्थना पर कान लगा,</para>
  <para style="q2" vid="PSA 17:1">जो कपटी होंठों से नहीं निकलती।<verse eid="PSA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />तेरे सामने मेरा न्याय हो;</para>
  <para style="q2" vid="PSA 17:2">तेरी आँखें सच्‍चाई को देखें।<verse eid="PSA 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />तूने मेरे मन को जाँचा है।</para>
  <para style="q2" vid="PSA 17:3">तूने रात को मेरी सुधि ली;</para>
  <para style="q1" vid="PSA 17:3">तूने मुझे परखा, परंतु कुछ बुरा न पाया।</para>
  <para style="q2" vid="PSA 17:3">मैंने ठान लिया है कि मेरे मुँह से</para>
  <para style="q1" vid="PSA 17:3">पाप की कोई बात नहीं निकलेगी।<verse eid="PSA 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4" />मनुष्य के कार्यों के संबंध में : तेरे होंठों के शब्द के द्वारा</para>
  <para style="q2" vid="PSA 17:4">मैंने हिंसक लोगों के मार्गों से स्वयं को बचाए रखा।<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />मेरे कदम तेरे मार्गों में स्थिर रहे;</para>
  <para style="q2" vid="PSA 17:5">मेरे पैर लड़खड़ाए नहीं।<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />हे परमेश्‍वर, मैंने तुझी को पुकारा है;</para>
  <para style="q2" vid="PSA 17:6">क्योंकि तू मुझे उत्तर देता है।</para>
  <para style="q1" vid="PSA 17:6">अपना कान मेरी ओर लगा और मेरी विनती को सुन।<verse eid="PSA 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />तू जो अपने दाहिने हाथ से अपने शरणागतों को</para>
  <para style="q2" vid="PSA 17:7">उनके विरोधियों से बचाता है,</para>
  <para style="q1" vid="PSA 17:7">अपनी अद्भुत करुणा दिखा।<verse eid="PSA 17:7" /></para>
  <para style="q1">
    <verse number="8-9" style="v" sid="PSA 17:8-9" />अपनी आँख की पुतली के समान मुझे सुरक्षित रख;</para>
  <para style="q2" vid="PSA 17:8-9">अपने पंखों के तले मुझे उन दुष्‍टों से छिपा ले,</para>
  <para style="q1" vid="PSA 17:8-9">जो मुझ पर अत्याचार करते हैं,</para>
  <para style="q2" vid="PSA 17:8-9">अर्थात् मेरे प्राणघातक शत्रुओं से जो मुझे घेरे हुए हैं।<verse eid="PSA 17:8-9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />उन्होंने अपने हृदयों को कठोर कर लिया है;</para>
  <para style="q2" vid="PSA 17:10">उनके मुँह से घमंड की बातें निकलती हैं।<verse eid="PSA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />उन्होंने अब हमें कदम-कदम पर घेर लिया है;</para>
  <para style="q2" vid="PSA 17:11">वे हमें मिट्टी में मिला देने के लिए घात लगाए हुए हैं।<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />वे उस सिंह के समान हैं</para>
  <para style="q2" vid="PSA 17:12">जो फाड़ खाने को उत्सुक रहता है,</para>
  <para style="q1" vid="PSA 17:12">और उस जवान सिंह के समान हैं</para>
  <para style="q2" vid="PSA 17:12">जो घात लगाने के स्थानों में बैठा रहता है।<verse eid="PSA 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />उठ, हे यहोवा! उसका सामना कर,</para>
  <para style="q2" vid="PSA 17:13">और उसे पटक दे! अपनी तलवार के बल से</para>
  <para style="q1" vid="PSA 17:13">मेरे प्राण को दुष्‍ट से बचा ले।<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />हे यहोवा, अपना हाथ बढ़ाकर मुझे मनुष्यों से,</para>
  <para style="q2" vid="PSA 17:14">अर्थात् संसार के उन मनुष्यों से बचा ले,</para>
  <para style="q1" vid="PSA 17:14">जिनका भाग इसी जीवन में है,</para>
  <para style="q2" vid="PSA 17:14">और जिनका पेट तू अपने भंडार से भरता है।</para>
  <para style="q1" vid="PSA 17:14">वे बाल-बच्‍चों से संतुष्‍ट रहते हैं,</para>
  <para style="q2" vid="PSA 17:14">और शेष संपत्ति अपने बच्‍चों के लिए छोड़ जाते हैं।<verse eid="PSA 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />परंतु मैं धार्मिकता में तेरे मुख का दर्शन करूँगा;</para>
  <para style="q2" vid="PSA 17:15">जब मैं जागूँगा तब तेरे स्वरूप को देखकर संतुष्‍ट होऊँगा।<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="s1">छुटकारे के लिए स्तुतिगान</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए : यहोवा के दास दाऊद का गीत। इस गीत के शब्दों को दाऊद ने यहोवा के लिए उस समय गाया जब यहोवा ने दाऊद को उसके सारे शत्रुओं और शाऊल के हाथ से बचाया। उसने कहा :</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1" />हे यहोवा, हे मेरे बल,</para>
  <para style="q2" vid="PSA 18:1">मैं तुझसे प्रेम करता हूँ।<verse eid="PSA 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2" />यहोवा मेरी चट्टान,</para>
  <para style="q2" vid="PSA 18:2">और मेरा गढ़ और मेरा छुड़ानेवाला है।</para>
  <para style="q1" vid="PSA 18:2">मेरा परमेश्‍वर, मेरी चट्टान है,</para>
  <para style="q2" vid="PSA 18:2">जिसमें मैं शरण लेता हूँ।</para>
  <para style="q1" vid="PSA 18:2">वही मेरी ढाल और मेरे उद्धार का सींग,</para>
  <para style="q2" vid="PSA 18:2">और मेरा दृढ़ गढ़ है।<verse eid="PSA 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />मैं यहोवा को, जो स्तुति के योग्य है, पुकारूँगा;</para>
  <para style="q2" vid="PSA 18:3">और मैं अपने शत्रुओं से बचाया जाऊँगा।<verse eid="PSA 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4" />मृत्यु की रस्सियों ने मुझे चारों ओर से जकड़ लिया है,</para>
  <para style="q2" vid="PSA 18:4">और विनाश की बाढ़ ने मुझे भयभीत कर दिया है।<verse eid="PSA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5" />अधोलोक की रस्सियाँ मेरे चारों ओर थीं,</para>
  <para style="q2" vid="PSA 18:5">और मृत्यु के फंदे मुझ पर आ पड़े।<verse eid="PSA 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />मैंने संकट के समय यहोवा को पुकारा;</para>
  <para style="q2" vid="PSA 18:6">मैंने अपने परमेश्‍वर की दुहाई दी;</para>
  <para style="q1" vid="PSA 18:6">और उसने अपने मंदिर में से मेरी पुकार सुनी,</para>
  <para style="q2" vid="PSA 18:6">और मेरी दुहाई उसके कानों में पड़ी।<verse eid="PSA 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />तब पृथ्वी हिल गई और काँप उठी,</para>
  <para style="q2" vid="PSA 18:7">और पहाड़ों की नींव कंपित होकर हिल गई</para>
  <para style="q1" vid="PSA 18:7">क्योंकि वह अति क्रोधित हुआ था।<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />उसके नथनों से धुआँ निकला,</para>
  <para style="q2" vid="PSA 18:8">और उसके मुँह से आग निकलकर भस्म करने लगी,</para>
  <para style="q1" vid="PSA 18:8">जिससे कोयले दहक उठे।<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />वह आकाश को नीचे झुकाकर उतर आया।</para>
  <para style="q2" vid="PSA 18:9">उसके पैरों तले घोर अंधकार था।<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />वह करूब पर सवार होकर उड़ा;</para>
  <para style="q2" vid="PSA 18:10">और वह पवन के पंखों पर सवारी करके वेग से उड़ा।<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />उसने अंधकार को अपने छिपने का स्थान,</para>
  <para style="q2" vid="PSA 18:11">और अपने चारों ओर मेघों के अंधकार</para>
  <para style="q1" vid="PSA 18:11">और आकाश की काली घटाओं को मंडप बनाया।<verse eid="PSA 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />उसकी उपस्थिति के तेज से ओलों और अंगारों के साथ</para>
  <para style="q2" vid="PSA 18:12">उसकी काली घटाएँ निकल पड़ीं।<verse eid="PSA 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />तब यहोवा आकाश में गरजा,</para>
  <para style="q2" vid="PSA 18:13">और परमप्रधान ने अपनी वाणी सुनाई<note caller="+" style="f"><char style="fr" closed="false">18:13 </char><char style="ft" closed="false">कुछ हस्तलेखों में “परमप्रधान ने अपनी वाणी सुनाई” के स्थान पर “परमप्रधान ने ओलों और धधकते अंगारों के बीच अपनी वाणी सुनाई”</char></note>।<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />उसने अपने तीर चला चलाकर उन्हें तितर-बितर कर दिया,</para>
  <para style="q2" vid="PSA 18:14">और बिजलियाँ गिरा गिराकर उन्हें खदेड़ दिया।<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />हे यहोवा, तेरी डाँट से</para>
  <para style="q2" vid="PSA 18:15">और तेरे नथनों की साँस के झोंके से जल के सोते दिखाई दिए,</para>
  <para style="q1" vid="PSA 18:15">और पृथ्वी की नींव प्रकट हुई।<verse eid="PSA 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16" />उसने ऊपर से अपना हाथ बढ़ाकर मुझे थाम लिया,</para>
  <para style="q2" vid="PSA 18:16">और मुझे गहरे जल में से खींच लिया।<verse eid="PSA 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17" />उसने मेरे बलवंत शत्रु से,</para>
  <para style="q2" vid="PSA 18:17">और उनसे जो मुझसे घृणा करते थे, मुझे छुड़ाया;</para>
  <para style="q1" vid="PSA 18:17">क्योंकि वे मुझसे अधिक बलवान थे।<verse eid="PSA 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18" />मेरी विपत्ति के दिन वे मुझ पर टूट पड़े;</para>
  <para style="q2" vid="PSA 18:18">परंतु यहोवा मेरा आश्रय था।<verse eid="PSA 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19" />उसने मुझे निकालकर चौड़े स्थान में पहुँचाया;</para>
  <para style="q2" vid="PSA 18:19">उसने मुझे छुड़ाया क्योंकि वह मुझसे प्रसन्‍न था।<verse eid="PSA 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20" />यहोवा ने मेरी धार्मिकता के अनुसार मुझे प्रतिफल दिया;</para>
  <para style="q2" vid="PSA 18:20">और मेरे हाथों की शुद्धता के अनुसार उसने मुझे बदला दिया।<verse eid="PSA 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21" />क्योंकि मैं यहोवा के मार्गों पर चलता रहा,</para>
  <para style="q2" vid="PSA 18:21">और दुष्‍टता के कारण अपने परमेश्‍वर से दूर न हुआ।<verse eid="PSA 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22" />निश्‍चय ही मैंने उसके सारे नियमों का पालन किया है,</para>
  <para style="q2" vid="PSA 18:22">और उसकी विधियों को नहीं त्यागा।<verse eid="PSA 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23" />मैं उसकी दृष्‍टि में निर्दोष था,</para>
  <para style="q2" vid="PSA 18:23">और मैंने अधर्म से अपने को बचाए रखा।<verse eid="PSA 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24" />इसलिए यहोवा ने मेरी धार्मिकता के अनुसार,</para>
  <para style="q2" vid="PSA 18:24">और मेरे हाथों की उस शुद्धता के अनुसार</para>
  <para style="q1" vid="PSA 18:24">जिसे वह देखता था,</para>
  <para style="q2" vid="PSA 18:24">मुझे बदला दिया।<verse eid="PSA 18:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25" />विश्‍वासयोग्य लोगों पर तू अपनी विश्‍वासयोग्यता प्रकट करता है;</para>
  <para style="q2" vid="PSA 18:25">और खरे लोगों पर तू अपनी खराई प्रकट करता है।<verse eid="PSA 18:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26" />निर्मल लोगों पर तू अपनी निर्मलता प्रकट करता है,</para>
  <para style="q2" vid="PSA 18:26">और कुटिल लोगों के लिए तू चतुर बनता है।<verse eid="PSA 18:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27" />तू दीन लोगों को तो बचाता है;</para>
  <para style="q2" vid="PSA 18:27">परंतु घमंड से भरी आँखों को नीची करता है।<verse eid="PSA 18:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28" />तू ही तो मेरे दीपक को जलाता है;</para>
  <para style="q2" vid="PSA 18:28">मेरा परमेश्‍वर यहोवा मेरे अंधियारे को उजियाला कर देता है।<verse eid="PSA 18:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29" />तेरी सहायता से मैं सेना पर आक्रमण कर सकता हूँ;</para>
  <para style="q2" vid="PSA 18:29">और अपने परमेश्‍वर की सहायता से मैं शहरपनाह को लाँघ सकता हूँ।<verse eid="PSA 18:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30" />परमेश्‍वर का मार्ग सिद्ध है।</para>
  <para style="q2" vid="PSA 18:30">यहोवा का वचन शुद्ध है;</para>
  <para style="q1" vid="PSA 18:30">वह उन सब की ढाल है</para>
  <para style="q2" vid="PSA 18:30">जो उसकी शरण लेते हैं।<verse eid="PSA 18:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31" />यहोवा को छोड़ और कौन ईश्‍वर है?</para>
  <para style="q2" vid="PSA 18:31">हमारे परमेश्‍वर को छोड़ और कौन चट्टान है?<verse eid="PSA 18:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32" />यही परमेश्‍वर सामर्थ्य से मेरी कमर कसता है,</para>
  <para style="q2" vid="PSA 18:32">और मेरे मार्ग को सिद्ध करता है।<verse eid="PSA 18:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33" />वही मेरे पैरों को हरिणियों के पैरों के समान बनाता है,</para>
  <para style="q2" vid="PSA 18:33">और मुझे ऊँचे स्थानों पर खड़ा करता है।<verse eid="PSA 18:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34" />वह मेरे हाथों को युद्ध करना सिखाता है,</para>
  <para style="q2" vid="PSA 18:34">इसलिए मेरी बाँहें पीतल के धनुष को मोड़ सकती हैं।<verse eid="PSA 18:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35" />तूने मुझे अपने उद्धार की ढाल दी है;</para>
  <para style="q2" vid="PSA 18:35">तेरा दाहिना हाथ मुझे संभाले रहता है,</para>
  <para style="q1" vid="PSA 18:35">और तेरी नम्रता मुझे बड़ा बनाती है।<verse eid="PSA 18:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36" />तू मेरे पैर रखने के स्थान को चौड़ा करता है,</para>
  <para style="q2" vid="PSA 18:36">और मेरे पैर फिसलते नहीं।<verse eid="PSA 18:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37" />मैं अपने शत्रुओं का पीछा करके उन्हें पकड़ लूँगा;</para>
  <para style="q2" vid="PSA 18:37">और जब तक उनका अंत न कर दूँ,</para>
  <para style="q1" vid="PSA 18:37">तब तक न लौटूँगा।<verse eid="PSA 18:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38" />मैं उन्हें ऐसा मारूँगा कि वे उठ न सकेंगे;</para>
  <para style="q2" vid="PSA 18:38">वे मेरे पैरों के नीचे गिर जाएँगे।<verse eid="PSA 18:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39" />क्योंकि तूने युद्ध के लिए सामर्थ्य से मेरी कमर कसी है;</para>
  <para style="q2" vid="PSA 18:39">तूने मेरे विरोधियों को मेरे सामने झुका दिया।<verse eid="PSA 18:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40" />तूने मेरे शत्रुओं की पीठ मेरी ओर फेर दी है;</para>
  <para style="q2" vid="PSA 18:40">जो मुझसे घृणा करते थे, मैंने उन्हें नष्‍‍ट कर दिया।<verse eid="PSA 18:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41" />उन्होंने दुहाई तो दी परंतु उन्हें कोई बचानेवाला न मिला;</para>
  <para style="q2" vid="PSA 18:41">उन्होंने यहोवा की भी दुहाई दी,</para>
  <para style="q1" vid="PSA 18:41">परंतु उसने भी उन्हें उत्तर न दिया।<verse eid="PSA 18:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42" />तब मैंने उन्हें कूट कूटकर पवन से उड़नेवाली धूल के समान कर दिया;</para>
  <para style="q2" vid="PSA 18:42">मैंने उन्हें गली-कूचों की कीचड़ के समान निकाल फेंका।<verse eid="PSA 18:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43" />तूने मुझे प्रजा के विद्रोह से बचाया है;</para>
  <para style="q2" vid="PSA 18:43">तूने मुझे अन्यजातियों का प्रधान बनाया है।</para>
  <para style="q1" vid="PSA 18:43">जिन लोगों को मैं जानता भी न था</para>
  <para style="q2" vid="PSA 18:43">वे मेरे अधीन हो गए।<verse eid="PSA 18:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44" />मेरा नाम सुनते ही वे मेरी आज्ञा का पालन करेंगे;</para>
  <para style="q2" vid="PSA 18:44">परदेशी मेरे अधीन हो जाएँगे।<verse eid="PSA 18:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45" />परदेशियों का साहस जाता रहेगा,</para>
  <para style="q2" vid="PSA 18:45">और वे अपने किलों में से थरथराते हुए निकलेंगे।<verse eid="PSA 18:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46" />यहोवा जीवित है, और मेरी चट्टान धन्य है!</para>
  <para style="q2" vid="PSA 18:46">मेरे उद्धारकर्ता परमेश्‍वर की प्रशंसा हो;<verse eid="PSA 18:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47" />हाँ, उस परमेश्‍वर की जो मेरा पलटा लेता है</para>
  <para style="q2" vid="PSA 18:47">और उसने देश-देश के लोगों को मेरे वश में कर दिया है!<verse eid="PSA 18:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48" />वह मुझे मेरे शत्रुओं से छुड़ाता है।</para>
  <para style="q2" vid="PSA 18:48">तू मुझे मेरे विरोधियों से ऊँचा करता,</para>
  <para style="q1" vid="PSA 18:48">और उपद्रवी मनुष्यों से मुझे बचाता है।<verse eid="PSA 18:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49" />इस कारण हे यहोवा,</para>
  <para style="q2" vid="PSA 18:49">मैं जाति-जाति के सामने तेरा धन्यवाद करूँगा,</para>
  <para style="q1" vid="PSA 18:49">और तेरे नाम का भजन गाऊँगा।<verse eid="PSA 18:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50" />वह अपने ठहराए हुए राजा को बड़ी-बड़ी विजय दिलाता है;</para>
  <para style="q2" vid="PSA 18:50">वह अपने अभिषिक्‍त दाऊद</para>
  <para style="q1" vid="PSA 18:50">और उसके वंश पर युगानुयुग करुणा करता रहेगा।<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="s1">सृष्‍टि और पवित्रशास्‍त्र की साक्षी</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1" />आकाश परमेश्‍वर की महिमा का वर्णन करता है;</para>
  <para style="q2" vid="PSA 19:1">और आकाशमंडल उसकी हस्तकला को प्रकट करता है।<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />वे दिन प्रतिदिन बात करते हैं,</para>
  <para style="q2" vid="PSA 19:2">और रात प्रतिरात ज्ञान सिखाते हैं।<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />न कोई बोली है और न कोई भाषा,</para>
  <para style="q2" vid="PSA 19:3">जहाँ उनकी आवाज़ सुनाई नहीं देती।<verse eid="PSA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4" />उनका स्वर सारी पृथ्वी पर फैल गया है,</para>
  <para style="q2" vid="PSA 19:4">और उनके वचन जगत की छोर तक पहुँच गए हैं।</para>
  <para style="b" vid="PSA 19:4" />
  <para style="q1" vid="PSA 19:4">परमेश्‍वर ने आकाश में सूर्य के लिए एक मंडप खड़ा किया है;<verse eid="PSA 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5" />वह उस दूल्हे के समान है जो अपने कक्ष से निकलता है;</para>
  <para style="q2" vid="PSA 19:5">वह शूरवीर के समान अपनी दौड़ दौड़ने में हर्षित होता है।<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />वह आकाशमंडल के एक सिरे से निकलता है,</para>
  <para style="q2" vid="PSA 19:6">और उसके दूसरे सिरे तक चक्‍‍कर लगाता है;</para>
  <para style="q1" vid="PSA 19:6">और उसकी गर्मी सब को पहुँचती है।<verse eid="PSA 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />यहोवा की व्यवस्था सिद्ध है,</para>
  <para style="q2" vid="PSA 19:7">जो प्राण को बहाल कर देती है।</para>
  <para style="q1" vid="PSA 19:7">यहोवा के नियम विश्‍वासयोग्य हैं,</para>
  <para style="q2" vid="PSA 19:7">जो साधारण लोगों को बुद्धिमान बना देते हैं।<verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />यहोवा के उपदेश सच्‍चे हैं,</para>
  <para style="q2" vid="PSA 19:8">जो हृदय को आनंदित कर देते हैं।</para>
  <para style="q1" vid="PSA 19:8">यहोवा की आज्ञा शुद्ध है,</para>
  <para style="q2" vid="PSA 19:8">वह आँखों में ज्योति ले आती है।<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />यहोवा का भय पवित्र है,</para>
  <para style="q2" vid="PSA 19:9">जो अनंतकाल तक बना रहता है।</para>
  <para style="q1" vid="PSA 19:9">यहोवा के नियम सत्य और पूरी रीति से धर्ममय हैं।<verse eid="PSA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />वे तो सोने से और बहुत से कुंदन से भी बढ़कर मनोहर हैं;</para>
  <para style="q2" vid="PSA 19:10">वे मधु से, यहाँ तक कि छत्ते के टपकनेवाले मधु से भी बढ़कर मीठे हैं।<verse eid="PSA 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11" />उन्हीं से तेरा दास चिताया जाता है;</para>
  <para style="q2" vid="PSA 19:11">उनका पालन करने से बड़ा प्रतिफल प्राप्‍त होता है।<verse eid="PSA 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12" />अपनी भूल को कौन समझ सकता है?</para>
  <para style="q2" vid="PSA 19:12">मेरे गुप्‍त पापों से मुझे शुद्ध कर।<verse eid="PSA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13" />तू अपने दास को ढिठाई के पापों से भी बचाए रख;</para>
  <para style="q2" vid="PSA 19:13">वे मुझ पर प्रभुता न कर पाएँ!</para>
  <para style="q1" vid="PSA 19:13">तब मैं निर्दोष बना रहूँगा,</para>
  <para style="q2" vid="PSA 19:13">और बड़े अपराधों से बचा रहूँगा।<verse eid="PSA 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14" />मेरे मुँह के वचन और मेरे हृदय का ध्यान तुझे ग्रहणयोग्य हों,</para>
  <para style="q2" vid="PSA 19:14">हे यहोवा, मेरी चट्टान और मेरे उद्धारकर्ता!<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="s1">युद्ध में विजय के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1" />संकट के दिन यहोवा तेरी सुन ले!</para>
  <para style="q2" vid="PSA 20:1">याकूब के परमेश्‍वर का नाम तेरी रक्षा करे!<verse eid="PSA 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2" />वह पवित्रस्थान से तेरी सहायता करे,</para>
  <para style="q2" vid="PSA 20:2">और सिय्योन से तुझे सहारा दे।<verse eid="PSA 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3" />वह तेरी सब अन्‍न‍बलियों को स्मरण करे,</para>
  <para style="q2" vid="PSA 20:3">और तेरी होमबलि को ग्रहण करे। सेला।<verse eid="PSA 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />वह तेरे मन की इच्छा को पूरी करे,</para>
  <para style="q2" vid="PSA 20:4">और तेरी सब योजनाओं को सफल करे।<verse eid="PSA 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />तेरी विजय के कारण हम ऊँचे स्वर से</para>
  <para style="q2" vid="PSA 20:5">हर्षित होकर गाएँगे,</para>
  <para style="q1" vid="PSA 20:5">और अपने परमेश्‍वर के नाम का झंडा फहराएँगे।</para>
  <para style="q2" vid="PSA 20:5">यहोवा तेरी सब विनतियाँ पूरी करे!<verse eid="PSA 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />अब मैं जान गया हूँ कि यहोवा अपने अभिषिक्‍त का उद्धार करता है।</para>
  <para style="q2" vid="PSA 20:6">वह अपने दाहिने हाथ के उद्धार करनेवाले पराक्रम के द्वारा</para>
  <para style="q1" vid="PSA 20:6">अपने पवित्र स्वर्ग से उसे उत्तर देगा।<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />किसी को रथों पर,</para>
  <para style="q2" vid="PSA 20:7">तो किसी को घोड़ों पर भरोसा है,</para>
  <para style="q1" vid="PSA 20:7">परंतु हमारा भरोसा तो अपने परमेश्‍वर यहोवा के नाम पर ही है।<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />वे झुके और गिर पड़े;</para>
  <para style="q2" vid="PSA 20:8">परंतु हम उठे और सीधे खड़े हो गए हैं।<verse eid="PSA 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />हे यहोवा, राजा को बचा ले!</para>
  <para style="q2" vid="PSA 20:9">जब हम पुकारें, तो वह हमें उत्तर दे।<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="s1">राजा की विजय</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1" />हे यहोवा, तेरे सामर्थ्य से राजा आनंदित होगा,</para>
  <para style="q2" vid="PSA 21:1">और तेरे किए हुए उद्धार से वह अति मगन होगा।<verse eid="PSA 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />तूने उसके मनोरथ को पूरा किया है,</para>
  <para style="q2" vid="PSA 21:2">और उसके होठों की विनती को</para>
  <para style="q1" vid="PSA 21:2">तूने अस्वीकार नहीं किया।</para>
  <para style="q2" vid="PSA 21:2">सेला।<verse eid="PSA 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />तू उत्तम आशिषों के साथ उससे मिलता है,</para>
  <para style="q2" vid="PSA 21:3">और उसके सिर पर कुंदन का मुकुट पहनाता है।<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />उसने तुझसे जीवन माँगा,</para>
  <para style="q2" vid="PSA 21:4">और तूने उसे वह दे दिया;</para>
  <para style="q1" vid="PSA 21:4">तूने उसे युगानुयुग का जीवन दे दिया।<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />तेरे उद्धार के कारण उसकी महिमा बढ़ गई है;</para>
  <para style="q2" vid="PSA 21:5">तू उसे वैभव और ऐश्‍वर्य से विभूषित करता है।<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />तूने उसे सर्वदा के लिए आशिषें दी हैं;</para>
  <para style="q2" vid="PSA 21:6">और तू उसे अपनी उपस्थिति के हर्ष</para>
  <para style="q1" vid="PSA 21:6">और आनंद से भर देता है।<verse eid="PSA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />इस कारण राजा का भरोसा यहोवा पर है,</para>
  <para style="q2" vid="PSA 21:7">और वह परमप्रधान की करुणा के कारण डगमगाएगा नहीं।<verse eid="PSA 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />तेरा हाथ तेरे सब शत्रुओं को ढूँढ़ निकालेगा;</para>
  <para style="q2" vid="PSA 21:8">तेरा दाहिना हाथ तेरे बैरियों को पकड़ लेगा।<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />जब तू प्रकट होगा,</para>
  <para style="q2" vid="PSA 21:9">तो तू उन्हें जलती हुई भट्ठी के समान जलाएगा।</para>
  <para style="q1" vid="PSA 21:9">यहोवा उन्हें अपने क्रोध में निगल जाएगा,</para>
  <para style="q2" vid="PSA 21:9">और आग उन्हें भस्म कर डालेगी।<verse eid="PSA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />तू उनकी संतान को पृथ्वी पर से,</para>
  <para style="q2" vid="PSA 21:10">और उनके वंश को मनुष्यों में से मिटा देगा।<verse eid="PSA 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />यद्यपि उन्होंने तेरी हानि करने की ठानी है और षड्यंत्र रचा है,</para>
  <para style="q2" vid="PSA 21:11">पर वे सफल न होंगे।<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />क्योंकि जब तू अपना धनुष उन पर तानेगा,</para>
  <para style="q2" vid="PSA 21:12">तो वे पीठ दिखाकर भाग जाएँगे।<verse eid="PSA 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />हे यहोवा, अपने सामर्थ्य में तू अति महान हो!</para>
  <para style="q2" vid="PSA 21:13">हम गा गाकर तेरे पराक्रम की स्तुति करेंगे।<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="s1">दुःख से स्तुतिगान की ओर</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। आइलेतशखार<note caller="+" style="f"><char style="fr" closed="false">22:0 </char><char style="ft" closed="false">अक्षरशः भोर की हरिणी</char></note> की राग पर दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1" />हे मेरे परमेश्‍वर, हे मेरे परमेश्‍वर,</para>
  <para style="q2" vid="PSA 22:1">तूने मुझे क्यों छोड़ दिया?</para>
  <para style="q1" vid="PSA 22:1">तू मेरी सहायता करने से,</para>
  <para style="q2" vid="PSA 22:1">और मेरे कराहने के शब्दों से दूर क्यों है?<verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />हे मेरे परमेश्‍वर, मैं दिन को पुकारता हूँ</para>
  <para style="q2" vid="PSA 22:2">परंतु तू उत्तर नहीं देता;</para>
  <para style="q1" vid="PSA 22:2">और रात को भी पुकारता हूँ,</para>
  <para style="q2" vid="PSA 22:2">परंतु मुझे चैन नहीं मिलता।<verse eid="PSA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />पर तू तो पवित्र है;</para>
  <para style="q2" vid="PSA 22:3">तू इस्राएल की स्तुति के सिंहासन पर विराजमान है।<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />हमारे पूर्वज तुझ पर भरोसा रखते थे;</para>
  <para style="q2" vid="PSA 22:4">उन्होंने भरोसा रखा और तूने उन्हें छुड़ा लिया।<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />उन्होंने तेरी दुहाई दी और तूने उन्हें छुड़ाया;</para>
  <para style="q2" vid="PSA 22:5">उन्होंने तुझ पर भरोसा रखा और वे लज्‍जित नहीं हुए।<verse eid="PSA 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />परंतु मैं तो कीड़ा हूँ, मनुष्य नहीं;</para>
  <para style="q2" vid="PSA 22:6">मैं तो मनुष्यों में निंदित और लोगों द्वारा तिरस्कृत हूँ।<verse eid="PSA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7" />वे सब जो मुझे देखते हैं मेरा ठट्ठा करते हैं</para>
  <para style="q2" vid="PSA 22:7">तथा होंठ बिचकाते और सिर हिलाते हुए यह कहते हैं :<verse eid="PSA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8" />“अपने को यहोवा के अधीन कर दे,</para>
  <para style="q2" vid="PSA 22:8">वही इसे छुड़ाए; वही इसे बचाए</para>
  <para style="q1" vid="PSA 22:8">क्योंकि वह इससे प्रसन्‍न है।”<verse eid="PSA 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9" />परंतु तूने ही मुझे गर्भ से निकाला;</para>
  <para style="q2" vid="PSA 22:9">जब मैं दूध-पीता बच्‍चा ही था,</para>
  <para style="q1" vid="PSA 22:9">तब से तूने मुझे भरोसा रखना सिखाया।<verse eid="PSA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10" />मैं तो जन्म से ही तुझे सौंपा गया था;</para>
  <para style="q2" vid="PSA 22:10">माता के गर्भ से ही तू मेरा परमेश्‍वर रहा है।<verse eid="PSA 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11" />मुझसे दूर न रह,</para>
  <para style="q2" vid="PSA 22:11">क्योंकि संकट निकट है;</para>
  <para style="q1" vid="PSA 22:11">और मेरा कोई सहायक नहीं है।<verse eid="PSA 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12" />बहुत से साँड़ों ने मुझे घेर लिया है,</para>
  <para style="q2" vid="PSA 22:12">बाशान के बलवंत साँड़ों ने मुझे चारों ओर से घेर रखा है।<verse eid="PSA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13" />वे फाड़ने और गरजनेवाले सिंह के समान</para>
  <para style="q2" vid="PSA 22:13">मुझ पर अपना मुँह पसारे हुए हैं।<verse eid="PSA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14" />मैं पानी के समान उंडेला गया हूँ,</para>
  <para style="q2" vid="PSA 22:14">और मेरी सब हड्डियों के जोड़ उखड़ गए हैं।</para>
  <para style="q1" vid="PSA 22:14">मेरा हृदय मोम सा हो गया है;</para>
  <para style="q2" vid="PSA 22:14">वह मेरे भीतर पिघल गया है।<verse eid="PSA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15" />मेरा बल ठीकरे के समान सूख गया,</para>
  <para style="q2" vid="PSA 22:15">और मेरी जीभ मेरे तालू से चिपक गई है;</para>
  <para style="q1" vid="PSA 22:15">और तू मुझे मृत्यु की धूल में मिला देता है।<verse eid="PSA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16" />कुत्तों ने मुझे घेर लिया है,</para>
  <para style="q2" vid="PSA 22:16">कुकर्मियों की भीड़ ने मुझे चारों ओर से घेर लिया है;</para>
  <para style="q1" vid="PSA 22:16">उन्होंने मेरे हाथों और मेरे पैरों को छेदा है।<verse eid="PSA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17" />मैं अपनी सब हड्डियाँ गिन सकता हूँ;</para>
  <para style="q2" vid="PSA 22:17">वे मुझे देखते और घूरते हैं।<verse eid="PSA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18" />वे मेरे वस्‍त्रों को आपस में बाँटते हैं,</para>
  <para style="q2" vid="PSA 22:18">और मेरे कपड़े के लिए पर्ची डालते हैं।<verse eid="PSA 22:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19" />परंतु हे यहोवा, तू दूर न रह!</para>
  <para style="q2" vid="PSA 22:19">हे मेरे बल, मेरी सहायता के लिए शीघ्र आ!<verse eid="PSA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20" />मेरे प्राण को तलवार से बचा;</para>
  <para style="q2" vid="PSA 22:20">मेरे जीवन को कुत्ते के पंजे से बचा ले।<verse eid="PSA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21" />मुझे सिंह के मुँह से बचा ले!</para>
  <para style="q2" vid="PSA 22:21">तूने मुझे जंगली साँड़ों के सींगों से बचाया है<note caller="+" style="f"><char style="fr" closed="false">22:21 </char><char style="ft" closed="false">अक्षरशः उत्तर दिया है</char></note>।<verse eid="PSA 22:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22" />मैं अपने भाइयों के सामने तेरे नाम का प्रचार करूँगा;</para>
  <para style="q2" vid="PSA 22:22">सभा के बीच मैं तेरी स्तुति करूँगा।<verse eid="PSA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23" />हे यहोवा का भय माननेवालो,</para>
  <para style="q2" vid="PSA 22:23">उसकी स्तुति करो!</para>
  <para style="q1" vid="PSA 22:23">हे याकूब के सब वंशजो,</para>
  <para style="q2" vid="PSA 22:23">उसकी महिमा करो!</para>
  <para style="q1" vid="PSA 22:23">हे इस्राएल के सब वंशजो,</para>
  <para style="q2" vid="PSA 22:23">उसका भय मानो!<verse eid="PSA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24" />क्योंकि उसने दुःखी के दुःख को न तो तुच्छ जाना</para>
  <para style="q2" vid="PSA 22:24">और न उससे घृणा की,</para>
  <para style="q1" vid="PSA 22:24">और न ही उससे अपना मुख छिपाया है;</para>
  <para style="q2" vid="PSA 22:24">पर जब भी उसने उसे सहायता के लिए पुकारा,</para>
  <para style="q1" vid="PSA 22:24">तब उसकी सुन ली।<verse eid="PSA 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25" />तेरे ही कारण मैं बड़ी सभा में स्तुति करूँगा।</para>
  <para style="q2" vid="PSA 22:25">मैं अपनी मन्‍नतों को उनके सामने पूरा करूँगा,</para>
  <para style="q1" vid="PSA 22:25">जो उसका भय मानते हैं।<verse eid="PSA 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26" />दीन लोग भोजन करके तृप्‍त होंगे;</para>
  <para style="q2" vid="PSA 22:26">जो यहोवा के खोजी हैं,</para>
  <para style="q1" vid="PSA 22:26">वे उसकी स्तुति करेंगे।</para>
  <para style="q2" vid="PSA 22:26">तुम्हारे हृदय सदा प्रफुल्लित रहें।<note caller="+" style="f"><char style="fr" closed="false">22:26 </char><char style="ft" closed="false">अक्षरशः जीवित रहें</char></note><verse eid="PSA 22:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27" />पृथ्वी के कोने-कोने के सब लोग यहोवा को स्मरण करेंगे</para>
  <para style="q2" vid="PSA 22:27">और उसकी ओर फिरेंगे;</para>
  <para style="q1" vid="PSA 22:27">और जाति-जाति के सब कुल तेरे सामने दंडवत् करेंगे।<verse eid="PSA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28" />क्योंकि राज्य यहोवा का है,</para>
  <para style="q2" vid="PSA 22:28">और वही जाति-जाति पर प्रभुता करता है।<verse eid="PSA 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29" />पृथ्वी के सब हृष्‍‍ट-पुष्‍‍ट लोग खाएँगे और दंडवत् करेंगे;</para>
  <para style="q2" vid="PSA 22:29">वे सब जो मिट्टी में मिल जाते हैं,</para>
  <para style="q1" vid="PSA 22:29">उसके सामने घुटने टेकेंगे,</para>
  <para style="q2" vid="PSA 22:29">और वह भी जो अपना प्राण नहीं बचा सकता।<verse eid="PSA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30" />एक वंश उसकी सेवा करेगा;</para>
  <para style="q2" vid="PSA 22:30">और दूसरी पीढ़ी से प्रभु का वर्णन किया जाएगा।<verse eid="PSA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31" />वे आएँगे और परमेश्‍वर की धार्मिकता को</para>
  <para style="q2" vid="PSA 22:31">उस वंश पर जो उत्पन्‍न‍ होगा</para>
  <para style="q1" vid="PSA 22:31">यह कहकर प्रकट करेंगे कि उसने कैसे-कैसे अद्भुत कार्य किए हैं।<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s1">अच्छा चरवाहा</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />यहोवा मेरा चरवाहा है,</para>
  <para style="q2" vid="PSA 23:1">मुझे कोई घटी नहीं होगी।<verse eid="PSA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2" />वह मुझे हरी-हरी चराइयों में बैठाता है;</para>
  <para style="q2" vid="PSA 23:2">वह मुझे सुखदाई जल के सोतों के पास ले चलता है।<verse eid="PSA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3" />वह मेरे जी में जी ले आता है।</para>
  <para style="q2" vid="PSA 23:3">धार्मिकता के मार्गों में वह अपने नाम के निमित्त मेरी अगुवाई करता है।<verse eid="PSA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />चाहे मैं मृत्यु की अंधकार से भरी तराई में होकर चलूँ,</para>
  <para style="q2" vid="PSA 23:4">फिर भी हानि से न डरूँगा,</para>
  <para style="q1" vid="PSA 23:4">क्योंकि तू मेरे साथ रहता है;</para>
  <para style="q2" vid="PSA 23:4">तेरी छड़ी और तेरी लाठी से मुझे शांति मिलती है।<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />तू मेरे शत्रुओं की उपस्थिति में मेरे लिए मेज़ लगाता है;</para>
  <para style="q2" vid="PSA 23:5">तूने मेरे सिर पर तेल उंडेला है,</para>
  <para style="q1" vid="PSA 23:5">मेरा कटोरा उमड़ रहा है।<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />निश्‍चय भलाई और करुणा जीवन भर</para>
  <para style="q2" vid="PSA 23:6">मेरे साथ-साथ बनी रहेंगी;</para>
  <para style="q1" vid="PSA 23:6">और मैं यहोवा के घर में सर्वदा वास करूँगा।<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="s1">महिमामय राजा</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />पृथ्वी और जो कुछ उसमें है,</para>
  <para style="q2" vid="PSA 24:1">अर्थात् जगत और उसमें रहनेवाले सब यहोवा के हैं।<verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />उसी ने समुद्रों पर उसकी नींव रखी,</para>
  <para style="q2" vid="PSA 24:2">और जल-धाराओं पर उसे स्थापित किया है।<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />यहोवा के पर्वत पर कौन चढ़ सकता है?</para>
  <para style="q2" vid="PSA 24:3">और उसके पवित्र स्थान में कौन खड़ा हो सकता है?<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4" />वह जिसके हाथ निर्दोष हैं और हृदय शुद्ध है,</para>
  <para style="q2" vid="PSA 24:4">जिसने अपने मन को व्यर्थ बात की ओर नहीं लगाया,</para>
  <para style="q1" vid="PSA 24:4">और न कपट से शपथ खाई है।<verse eid="PSA 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5" />वह यहोवा से आशिष,</para>
  <para style="q2" vid="PSA 24:5">और अपने उद्धारकर्ता परमेश्‍वर से धार्मिकता प्राप्‍त करेगा।<verse eid="PSA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6" />ऐसे ही लोग उसके खोजी हैं,</para>
  <para style="q2" vid="PSA 24:6">जो याकूब के परमेश्‍वर के दर्शन के अभिलाषी हैं। सेला।<verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />हे फाटको, अपने सिर ऊँचे करो!</para>
  <para style="q2" vid="PSA 24:7">हे सनातन द्वारो, खुल जाओ<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="ft" closed="false">या ऊँचे हो जाओ</char></note>!</para>
  <para style="q1" vid="PSA 24:7">क्योंकि प्रतापी राजा प्रवेश करेगा।<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />वह प्रतापी राजा कौन है?</para>
  <para style="q2" vid="PSA 24:8">यहोवा जो सामर्थी और पराक्रमी है,</para>
  <para style="q1" vid="PSA 24:8">यहोवा जो युद्ध में पराक्रमी है।<verse eid="PSA 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />हे फाटको, अपने सिर ऊँचे करो!</para>
  <para style="q2" vid="PSA 24:9">हे सनातन द्वारो, खुल जाओ<note caller="+" style="f"><char style="fr" closed="false">24:9 </char><char style="ft" closed="false">या ऊँचे हो जाओ</char></note>!</para>
  <para style="q1" vid="PSA 24:9">क्योंकि प्रतापी राजा प्रवेश करेगा।<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />वह प्रतापी राजा कौन है?</para>
  <para style="q2" vid="PSA 24:10">सेनाओं का यहोवा, वही प्रतापी राजा है। सेला।<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="s1">यहोवा पर निर्भरता</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1" />हे यहोवा, मैं अपना मन तेरी ओर लगाता हूँ।<verse eid="PSA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2" />हे मेरे परमेश्‍वर, मैंने तुझ पर भरोसा रखा है,</para>
  <para style="q2" vid="PSA 25:2">मुझे लज्‍जित होने न दे।</para>
  <para style="q1" vid="PSA 25:2">मेरे शत्रुओं को मुझ पर विजयी न होने दे।<verse eid="PSA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />जितने तेरी प्रतीक्षा करते हैं,</para>
  <para style="q2" vid="PSA 25:3">उनमें से कोई भी लज्‍जित न होगा;</para>
  <para style="q1" vid="PSA 25:3">परंतु जो अकारण विश्‍वासघात करते हैं वे लज्‍जित होंगे।<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />हे यहोवा, अपने मार्ग मुझे दिखा;</para>
  <para style="q2" vid="PSA 25:4">अपने पथ मुझे बता।<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />मुझे अपने सत्य पर चला और मुझे सिखा,</para>
  <para style="q2" vid="PSA 25:5">क्योंकि तू मेरा उद्धार करनेवाला परमेश्‍वर है;</para>
  <para style="q1" vid="PSA 25:5">मैं दिन भर तेरी प्रतीक्षा करता रहता हूँ।<verse eid="PSA 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />हे यहोवा, अपनी दया और करुणा को स्मरण कर;</para>
  <para style="q2" vid="PSA 25:6">क्योंकि वे तो प्राचीनकाल से होती रही हैं।<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />हे यहोवा, मेरी जवानी के पापों</para>
  <para style="q2" vid="PSA 25:7">और मेरे अपराधों को स्मरण न कर; तू अपनी करुणा के अनुसार</para>
  <para style="q1" vid="PSA 25:7">और अपनी भलाई के कारण मुझे स्मरण कर।<verse eid="PSA 25:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />यहोवा भला और खरा है,</para>
  <para style="q2" vid="PSA 25:8">इसलिए वह पापियों को अपना मार्ग दिखाएगा।<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />वह नम्र लोगों को न्याय की शिक्षा देगा,</para>
  <para style="q2" vid="PSA 25:9">हाँ, वह नम्र लोगों को अपना मार्ग दिखाएगा।<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />यहोवा के सब मार्ग उनके लिए करुणा और सच्‍चाई हैं</para>
  <para style="q2" vid="PSA 25:10">जो उसकी वाचा और उसकी नीतियों को मानते हैं।<verse eid="PSA 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />हे यहोवा, अपने नाम के निमित्त मेरे अधर्म को,</para>
  <para style="q2" vid="PSA 25:11">जो बहुत बड़ा है, क्षमा कर।<verse eid="PSA 25:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />वह कौन है जो यहोवा का भय मानता है?</para>
  <para style="q2" vid="PSA 25:12">यहोवा उसे सिखाएगा कि किस मार्ग को चुनना है।<verse eid="PSA 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13" />वह खुशहाल जीवन जीएगा,</para>
  <para style="q2" vid="PSA 25:13">और उसका वंश पृथ्वी का अधिकारी होगा।<verse eid="PSA 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14" />यहोवा के भेद को वही जानते हैं जो उससे डरते हैं,</para>
  <para style="q2" vid="PSA 25:14">और वह उन पर अपनी वाचा प्रकट करेगा।<verse eid="PSA 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15" />मेरी आँखें निरंतर यहोवा पर लगी हैं,</para>
  <para style="q2" vid="PSA 25:15">क्योंकि वही मेरे पैरों को जाल से छुड़ाएगा।<verse eid="PSA 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16" />हे यहोवा, मेरी ओर फिर और मुझ पर अनुग्रह कर,</para>
  <para style="q2" vid="PSA 25:16">क्योंकि मैं अकेला और पीड़ित हूँ।<verse eid="PSA 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17" />मेरे हृदय की वेदनाएँ बढ़ गई हैं;</para>
  <para style="q2" vid="PSA 25:17">तू मुझे मेरे दुःखों से छुड़ा ले।<verse eid="PSA 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18" />तू मेरे दुःख और कष्‍‍ट पर दृष्‍टि कर,</para>
  <para style="q2" vid="PSA 25:18">और मेरे सब पापों को क्षमा कर।<verse eid="PSA 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19" />मेरे शत्रुओं को देख;</para>
  <para style="q2" vid="PSA 25:19">वे कितने बढ़ गए हैं,</para>
  <para style="q1" vid="PSA 25:19">और वे मुझसे बहुत घृणा करते हैं।<verse eid="PSA 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20" />मेरी रक्षा कर, और मुझे छुड़ा ले;</para>
  <para style="q2" vid="PSA 25:20">मुझे लज्‍जित न होने दे,</para>
  <para style="q1" vid="PSA 25:20">क्योंकि मैं तेरी शरण लेता हूँ।<verse eid="PSA 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21" />खराई और सीधाई मुझे सुरक्षित रखे,</para>
  <para style="q2" vid="PSA 25:21">क्योंकि मेरी आशा तुझ पर है।<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22" />हे परमेश्‍वर, इस्राएल को उसके सारे संकटों से छुड़ा ले।<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="s1">न्याय के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1" />हे यहोवा, मेरा न्याय कर,</para>
  <para style="q2" vid="PSA 26:1">क्योंकि मैं खराई से चलता रहा हूँ,</para>
  <para style="q1" vid="PSA 26:1">और मेरा भरोसा यहोवा पर अटल है।<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />हे यहोवा, मुझे जाँच और परख;</para>
  <para style="q2" vid="PSA 26:2">मेरे मन और हृदय को खोज।<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />तेरी करुणा तो मेरी आँखों के सामने है,</para>
  <para style="q2" vid="PSA 26:3">और मैं तेरे सत्य पर चलता हूँ।<verse eid="PSA 26:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />मैं झूठे मनुष्यों के साथ नहीं बैठता,</para>
  <para style="q2" vid="PSA 26:4">न पाखंडियों के साथ कहीं जाता हूँ;<verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />मैं कुकर्मियों की मंडली से</para>
  <para style="q2" vid="PSA 26:5">घृणा करता हूँ,</para>
  <para style="q1" vid="PSA 26:5">और दुष्‍टों के साथ नहीं बैठता।<verse eid="PSA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />मैं अपने हाथ निर्दोषता से धोऊँगा,</para>
  <para style="q2" vid="PSA 26:6">तब हे यहोवा,</para>
  <para style="q1" vid="PSA 26:6">मैं तेरी वेदी की परिक्रमा करूँगा,<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />कि ऊँचे स्वर से तेरा धन्यवाद करूँ,</para>
  <para style="q2" vid="PSA 26:7">और तेरे सब आश्‍चर्यकर्मों का वर्णन करूँ।<verse eid="PSA 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />हे यहोवा, मैं तेरे निवासस्थान से,</para>
  <para style="q2" vid="PSA 26:8">जहाँ तेरी महिमा का वास है,</para>
  <para style="q1" vid="PSA 26:8">प्रीति रखता हूँ।<verse eid="PSA 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />मेरे प्राण को पापियों के साथ,</para>
  <para style="q2" vid="PSA 26:9">और मेरे जीवन को हत्यारों के साथ नष्‍ट न कर।<note caller="+" style="f"><char style="fr" closed="false">26:9 </char><char style="ft" closed="false">नष्‍ट न कर — अक्षरशः न मिला</char></note><verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />उनके हाथ दुष्‍टता से,</para>
  <para style="q2" vid="PSA 26:10">और उनके दाहिने हाथ घूस से भरे रहते हैं।<verse eid="PSA 26:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />परंतु मैं तो खराई से ही चलता रहूँगा।</para>
  <para style="q2" vid="PSA 26:11">मुझे छुड़ा ले,</para>
  <para style="q1" vid="PSA 26:11">और मुझ पर अनुग्रह कर।<verse eid="PSA 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />मेरे पैर समतल भूमि पर हैं;</para>
  <para style="q2" vid="PSA 26:12">मैं सभाओं में यहोवा को धन्य कहूँगा।<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="s1">यहोवा मेरा दृढ़ गढ़</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1" />यहोवा मेरी ज्योति और मेरा उद्धार है;</para>
  <para style="q2" vid="PSA 27:1">मैं किससे डरूँ?</para>
  <para style="q1" vid="PSA 27:1">यहोवा मेरे जीवन का दृढ़ गढ़ है;</para>
  <para style="q2" vid="PSA 27:1">मैं किससे भयभीत होऊँ?<verse eid="PSA 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />जब कुकर्मियों ने जो मेरे विरोधी और मेरे शत्रु थे,</para>
  <para style="q2" vid="PSA 27:2">मुझे खा डालने के लिए मुझ पर चढ़ाई की,</para>
  <para style="q1" vid="PSA 27:2">तो वे ठोकर खाकर गिर पड़े।<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />चाहे सेना मेरे विरुद्ध छावनी डाले,</para>
  <para style="q2" vid="PSA 27:3">फिर भी मेरा हृदय भयभीत न होगा।</para>
  <para style="q1" vid="PSA 27:3">चाहे मेरे विरुद्ध युद्ध भी छिड़ जाए,</para>
  <para style="q2" vid="PSA 27:3">फिर भी मैं आश्‍वस्त रहूँगा।<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />मैंने यहोवा से एक वर माँगा है,</para>
  <para style="q2" vid="PSA 27:4">मैं उसी के यत्‍न में लगा रहूँगा :</para>
  <para style="q1" vid="PSA 27:4">कि मैं जीवन भर यहोवा के भवन में ही वास करूँ,</para>
  <para style="q2" vid="PSA 27:4">जिससे यहोवा की मनोहरता को निहारता रहूँ</para>
  <para style="q1" vid="PSA 27:4">और उसके मंदिर में उसका ध्यान करता रहूँ।<verse eid="PSA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />विपत्ति के दिन वह मुझे अपने मंडप में छिपा लेगा;</para>
  <para style="q2" vid="PSA 27:5">वह मुझे अपने तंबू के गुप्‍त स्थान में छिपा लेगा;</para>
  <para style="q1" vid="PSA 27:5">वह मुझे चट्टान पर चढ़ा देगा।<verse eid="PSA 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />तब मेरा सिर मेरे चारों ओर के शत्रुओं से ऊँचा होगा,</para>
  <para style="q2" vid="PSA 27:6">और मैं यहोवा के तंबू में जय जयकार के साथ बलिदान चढ़ाऊँगा।</para>
  <para style="q1" vid="PSA 27:6">मैं यहोवा का गीत गाऊँगा और उसका स्तुतिगान करूँगा।<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />हे यहोवा, जब मैं पुकारूँ तो मेरी पुकार को सुन;</para>
  <para style="q2" vid="PSA 27:7">मुझ पर अनुग्रह कर और मुझे उत्तर दे।<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />तूने कहा है,</para>
  <para style="q2" vid="PSA 27:8">“मेरे दर्शन के खोजी हो।”</para>
  <para style="q1" vid="PSA 27:8">तब मेरे मन ने तुझसे कहा,</para>
  <para style="q2" vid="PSA 27:8">“हे यहोवा, मैं तेरे दर्शन का खोजी रहूँगा।”<verse eid="PSA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />अपना मुख मुझसे न छिपा।</para>
  <para style="q2" vid="PSA 27:9">क्रोध में आकर अपने सेवक को दूर न हटा;</para>
  <para style="q1" vid="PSA 27:9">तू तो मेरा सहायक रहा है।</para>
  <para style="q2" vid="PSA 27:9">हे मेरे उद्धारकर्ता परमेश्‍वर,</para>
  <para style="q1" vid="PSA 27:9">मुझे न त्याग और न मुझे छोड़।<verse eid="PSA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10" />मेरे माता-पिता ने तो मुझे छोड़ दिया है,</para>
  <para style="q2" vid="PSA 27:10">परंतु यहोवा मुझे संभाल लेगा।<verse eid="PSA 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11" />हे यहोवा, मुझे अपना मार्ग दिखा,</para>
  <para style="q2" vid="PSA 27:11">और मेरे शत्रुओं के कारण समतल पथ पर मेरी अगुवाई कर।<verse eid="PSA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12" />मुझे मेरे शत्रुओं की इच्छा पर न छोड़,</para>
  <para style="q2" vid="PSA 27:12">क्योंकि मेरे विरुद्ध झूठे गवाह उठ खड़े हुए हैं,</para>
  <para style="q1" vid="PSA 27:12">और वे हिंसा से भरे हुए हैं।<verse eid="PSA 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13" />मुझे विश्‍वास है कि मैं जीवितों की भूमि पर</para>
  <para style="q2" vid="PSA 27:13">यहोवा की भलाई को देखूँगा।<verse eid="PSA 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14" />यहोवा की प्रतीक्षा करता रह;</para>
  <para style="q2" vid="PSA 27:14">साहस रख और तेरा हृदय दृढ़ बना रहे।</para>
  <para style="q1" vid="PSA 27:14">हाँ, यहोवा ही की प्रतीक्षा करता रह।<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="s1">यहोवा मेरा बल</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1" />हे यहोवा, मैं तुझे पुकारता हूँ।</para>
  <para style="q2" vid="PSA 28:1">हे मेरी चट्टान, मेरी अनसुनी न कर।</para>
  <para style="q1" vid="PSA 28:1">यदि तू चुप रहेगा,</para>
  <para style="q2" vid="PSA 28:1">तो मैं कब्र में चले जानेवालों के समान हो जाऊँगा।<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />जब मैं तेरी दुहाई दूँ,</para>
  <para style="q2" vid="PSA 28:2">जब मैं तेरे पवित्रस्थान के भीतरी कक्ष की ओर अपने हाथ फैलाऊँ,</para>
  <para style="q1" vid="PSA 28:2">तब मेरे गिड़गिड़ाने को सुन ले।<verse eid="PSA 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />मुझे दुष्‍टों के साथ न घसीट,</para>
  <para style="q2" vid="PSA 28:3">न उनके साथ जो अधर्मी हैं।</para>
  <para style="q1" vid="PSA 28:3">वे अपने पड़ोसियों के साथ मित्रता की बातें तो करते हैं,</para>
  <para style="q2" vid="PSA 28:3">परंतु उनके हृदय में बुराई रहती है।<verse eid="PSA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />उनके कार्यों और दुष्कर्मों के अनुसार उनका बदला चुका;</para>
  <para style="q2" vid="PSA 28:4">उनके हाथों के कार्यों के अनुसार उन्हें बदला दे;</para>
  <para style="q1" vid="PSA 28:4">उन्हें उनकी करनी का फल दे।<verse eid="PSA 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />वे न तो यहोवा के कार्यों पर,</para>
  <para style="q2" vid="PSA 28:5">और न ही उसके हाथ के कामों पर ध्यान देते हैं।</para>
  <para style="q1" vid="PSA 28:5">अतः वह उन्हें गिरा देगा और फिर कभी न उठाएगा।<verse eid="PSA 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />धन्य है यहोवा,</para>
  <para style="q2" vid="PSA 28:6">क्योंकि उसने मेरी गिड़गिड़ाहट सुनी है।<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />यहोवा मेरा बल और मेरी ढाल है;</para>
  <para style="q2" vid="PSA 28:7">मेरे हृदय ने उस पर भरोसा रखा,</para>
  <para style="q1" vid="PSA 28:7">और मुझे सहायता मिली है।</para>
  <para style="q2" vid="PSA 28:7">इसलिए मेरा हृदय हर्षित है;</para>
  <para style="q1" vid="PSA 28:7">मैं गीत गाकर उसकी स्तुति करूँगा।<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />यहोवा अपनी प्रजा का बल है,</para>
  <para style="q2" vid="PSA 28:8">वह अपने अभिषिक्‍त के लिए उद्धार का दृढ़ गढ़ है।<verse eid="PSA 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />तू अपनी प्रजा का उद्धार कर,</para>
  <para style="q2" vid="PSA 28:9">और अपने निज भाग को आशिष दे।</para>
  <para style="q1" vid="PSA 28:9">उनकी चरवाही कर और उन्हें सदैव संभाले रह।<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="s1">यहोवा की वाणी</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1" />हे स्वर्गदूतो<note caller="+" style="f"><char style="fr" closed="false">29:1 </char><char style="ft" closed="false">या ईश्‍वर के पुत्रो</char></note>, यहोवा को सराहो; हाँ,</para>
  <para style="q2" vid="PSA 29:1">यहोवा की महिमा और उसके सामर्थ्य को मानो।<verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />यहोवा के नाम के योग्य उसकी महिमा करो;</para>
  <para style="q2" vid="PSA 29:2">पवित्रता से शोभायमान होकर यहोवा को दंडवत् करो।<verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />यहोवा की वाणी मेघों के ऊपर सुनाई देती है।</para>
  <para style="q2" vid="PSA 29:3">महिमामय परमेश्‍वर गरजता है;</para>
  <para style="q1" vid="PSA 29:3">यहोवा घने मेघों के ऊपर है।<verse eid="PSA 29:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />यहोवा की वाणी शक्‍तिशाली है,</para>
  <para style="q2" vid="PSA 29:4">यहोवा की वाणी प्रतापमय है।<verse eid="PSA 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />यहोवा की वाणी देवदारों को तोड़ डालती है;</para>
  <para style="q2" vid="PSA 29:5">यहोवा लबानोन के देवदारों को भी टुकड़े-टुकड़े कर देता है।<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />वह उन्हें बछड़े के समान,</para>
  <para style="q2" vid="PSA 29:6">तथा लबानोन और शिर्योन<note caller="+" style="f"><char style="fr" closed="false">29:6 </char><char style="ft" closed="false">देखें व्यवस्था 3:9</char></note> को जंगली बछड़े के समान उछालता है।<verse eid="PSA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />यहोवा की वाणी से आग की लपटें निकलती हैं।<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />यहोवा की वाणी वन को हिला देती है,</para>
  <para style="q2" vid="PSA 29:8">यहोवा कादेश के वन को भी कँपाता है।<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />यहोवा की वाणी से हरिणियों का गर्भपात हो जाता है,</para>
  <para style="q2" vid="PSA 29:9">और वन उजड़ जाते हैं;</para>
  <para style="q1" vid="PSA 29:9">उसके मंदिर में सब “महिमा, महिमा” पुकार उठते हैं!<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />जलप्रलय के समय यहोवा विराजमान था,</para>
  <para style="q2" vid="PSA 29:10">हाँ, यहोवा युगानुयुग के लिए राजा होकर विराजमान है।<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />यहोवा अपनी प्रजा को बल देगा;</para>
  <para style="q2" vid="PSA 29:11">यहोवा अपनी प्रजा को शांति की आशिष देगा।<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s1">भोर का आनंद</para>
  <para style="b" />
  <para style="d">मंदिर के अर्पण के लिए दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1" />हे यहोवा, मैं तेरा गुणगान करूँगा</para>
  <para style="q2" vid="PSA 30:1">क्योंकि तूने मुझे खींचकर निकाला है,</para>
  <para style="q1" vid="PSA 30:1">और मेरे शत्रुओं को मुझ पर आनंदित नहीं होने दिया।<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />हे मेरे परमेश्‍वर यहोवा,</para>
  <para style="q2" vid="PSA 30:2">मैंने तेरी दुहाई दी,</para>
  <para style="q1" vid="PSA 30:2">और तूने मुझे भला-चंगा किया।<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />हे यहोवा, तूने मेरा प्राण अधोलोक से निकाला है;</para>
  <para style="q2" vid="PSA 30:3">तूने मुझे जीवित रखा है और कब्र में पड़ने से बचाया है।<verse eid="PSA 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />हे यहोवा के भक्‍तो, उसका भजन गाओ;</para>
  <para style="q2" vid="PSA 30:4">और उसकी पवित्रता का स्मरण करते हुए उसका धन्यवाद करो।<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />क्योंकि उसका क्रोध तो क्षण भर का होता है,</para>
  <para style="q2" vid="PSA 30:5">पर उसकी कृपा जीवन भर की होती है।</para>
  <para style="q1" vid="PSA 30:5">यद्यपि रात को रोना पड़े,</para>
  <para style="q2" vid="PSA 30:5">परंतु भोर को आनंद होता है।<verse eid="PSA 30:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />मैंने अपनी सुख-समृद्धि के समय कहा था,</para>
  <para style="q2" vid="PSA 30:6">“मैं कभी नहीं डगमगाऊँगा।”<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />हे यहोवा, तूने अपनी कृपा से मेरे पर्वत को दृढ़ किया था।</para>
  <para style="q2" vid="PSA 30:7">जब तूने अपना मुँह फेर लिया तो मैं घबरा गया।<verse eid="PSA 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />हे यहोवा, मैं तुझी को पुकारता हूँ;</para>
  <para style="q2" vid="PSA 30:8">हे प्रभु, मैं तुझी से याचना करता हूँ।<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />मेरी मृत्यु से या मेरे कब्र में चले जाने से क्या लाभ होगा?</para>
  <para style="q2" vid="PSA 30:9">क्या मिट्टी तेरी प्रशंसा करेगी?</para>
  <para style="q1" vid="PSA 30:9">क्या वह तेरी सच्‍चाई का वर्णन करेगी?<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />हे यहोवा सुन, मुझ पर अनुग्रह कर!</para>
  <para style="q2" vid="PSA 30:10">हे यहोवा, तू मेरा सहायक हो!<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />तूने मेरे विलाप को नृत्य में बदल दिया है;</para>
  <para style="q2" vid="PSA 30:11">तूने मेरा टाट उतारकर आनंद का कमरबंध बाँधा है,<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />ताकि मेरी आत्मा तेरा भजन गाती रहे और कभी चुप न हो।</para>
  <para style="q2" vid="PSA 30:12">हे मेरे परमेश्‍वर यहोवा,</para>
  <para style="q1" vid="PSA 30:12">मैं सदा-सर्वदा तेरा धन्यवाद करता रहूँगा।<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="s1">सुरक्षा के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1" />हे यहोवा, मैं तेरी शरण में आया हूँ;</para>
  <para style="q2" vid="PSA 31:1">मुझे कभी लज्‍जित न होने दे।</para>
  <para style="q1" vid="PSA 31:1">अपनी धार्मिकता के द्वारा मुझे छुड़ा ले!<verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />अपना कान मेरी ओर लगा;</para>
  <para style="q2" vid="PSA 31:2">मुझे तुरंत छुड़ा ले!</para>
  <para style="q1" vid="PSA 31:2">तू मेरे लिए शरण की चट्टान</para>
  <para style="q2" vid="PSA 31:2">और मुझे बचाने के लिए दृढ़ गढ़ बन!<verse eid="PSA 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />तू ही मेरी चट्टान और मेरा दृढ़ गढ़ है;</para>
  <para style="q2" vid="PSA 31:3">अपने नाम के निमित्त मेरी अगुवाई कर,</para>
  <para style="q1" vid="PSA 31:3">और मेरा मार्गदर्शन कर।<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />तू मुझे उस जाल में से निकाल</para>
  <para style="q2" vid="PSA 31:4">जिसे उन्होंने मेरे लिए बिछाया है,</para>
  <para style="q1" vid="PSA 31:4">क्योंकि तू मेरा दृढ़ गढ़ है।<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />मैं अपनी आत्मा तेरे हाथ में सौंपता हूँ;</para>
  <para style="q2" vid="PSA 31:5">हे यहोवा, सत्य के परमेश्‍वर,</para>
  <para style="q1" vid="PSA 31:5">तूने मुझे दाम देकर छुड़ा लिया है।<verse eid="PSA 31:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />मैं उनसे घृणा करता हूँ</para>
  <para style="q2" vid="PSA 31:6">जो व्यर्थ वस्तुओं पर मन लगाते हैं,</para>
  <para style="q1" vid="PSA 31:6">परंतु मेरा भरोसा यहोवा ही पर है।<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />मैं तेरी करुणा से मगन और आनंदित हूँ,</para>
  <para style="q2" vid="PSA 31:7">क्योंकि तूने मेरे दुःख पर दृष्‍टि की है।</para>
  <para style="q1" vid="PSA 31:7">तूने मेरे प्राण के कष्‍टों को जाना है;<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />और तूने मुझे शत्रु के हाथ में पड़ने नहीं दिया,</para>
  <para style="q2" vid="PSA 31:8">बल्कि मेरे पैरों को चौड़े स्थान में रखा है।<verse eid="PSA 31:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />हे यहोवा, मुझ पर अनुग्रह कर,</para>
  <para style="q2" vid="PSA 31:9">क्योंकि मैं संकट में हूँ;</para>
  <para style="q1" vid="PSA 31:9">मेरी आँखें शोक से कमज़ोर हो गई हैं—</para>
  <para style="q2" vid="PSA 31:9">मेरा प्राण और मेरा शरीर भी।<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />मेरा जीवन शोक के मारे</para>
  <para style="q2" vid="PSA 31:10">और मेरी आयु कराहते-कराहते घट चली है;</para>
  <para style="q1" vid="PSA 31:10">मेरा बल मेरे अधर्म के कारण जाता रहा,</para>
  <para style="q2" vid="PSA 31:10">और मेरी हड्डियाँ घुल गईं।<verse eid="PSA 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />अपने सब विरोधियों के कारण</para>
  <para style="q2" vid="PSA 31:11">मैं विशेषकर अपने पड़ोसियों में निंदित हुआ हूँ।</para>
  <para style="q1" vid="PSA 31:11">मैं अपने परिचितों में भय का कारण बन गया हूँ।</para>
  <para style="q2" vid="PSA 31:11">जो मुझे सड़क पर देखते हैं,</para>
  <para style="q1" vid="PSA 31:11">मुझसे दूर भाग जाते हैं।<verse eid="PSA 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12" />मैं मृतक के समान लोगों के मन से भुला दिया गया हूँ;</para>
  <para style="q2" vid="PSA 31:12">मैं टूटे बरतन के समान हो गया हूँ।<verse eid="PSA 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13" />मैंने बहुतों से अपनी निंदा सुनी है;</para>
  <para style="q2" vid="PSA 31:13">चारों ओर भय ही भय है।</para>
  <para style="q1" vid="PSA 31:13">उन्होंने मिलकर मेरे विरुद्ध सम्मति की</para>
  <para style="q2" vid="PSA 31:13">और मेरे प्राण लेने का षड्यंत्र रचा।<verse eid="PSA 31:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14" />पर हे यहोवा,</para>
  <para style="q2" vid="PSA 31:14">मैं तुझी पर भरोसा रखता हूँ;</para>
  <para style="q1" vid="PSA 31:14">मैं कहता हूँ,</para>
  <para style="q2" vid="PSA 31:14">“तू मेरा परमेश्‍वर है।”<verse eid="PSA 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15" />मेरी आयु तेरे हाथ में है,</para>
  <para style="q2" vid="PSA 31:15">तू मुझे मेरे शत्रुओं और मेरे सतानेवालों के हाथ से छुड़ा ले।<verse eid="PSA 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16" />अपने दास पर अपने मुख का प्रकाश चमका,</para>
  <para style="q2" vid="PSA 31:16">अपनी करुणा के द्वारा मुझे बचा ले।<verse eid="PSA 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17" />हे यहोवा, मुझे लज्‍जित न होने दे</para>
  <para style="q2" vid="PSA 31:17">क्योंकि मैं तुझे पुकारता हूँ;</para>
  <para style="q1" vid="PSA 31:17">दुष्‍ट लज्‍जित हों और वे अधोलोक में चुपचाप पड़े रहें।<verse eid="PSA 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18" />झूठ बोलनेवाले मुँह जो अहंकार और अपमान से</para>
  <para style="q2" vid="PSA 31:18">धर्मी के विरुद्ध निंदा की बातें बोलते हैं, बंद हो जाएँ।<verse eid="PSA 31:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19" />तेरी भलाई कितनी महान है जो तूने अपने भय</para>
  <para style="q2" vid="PSA 31:19">माननेवालों के लिए रख छोड़ी है,</para>
  <para style="q1" vid="PSA 31:19">और अपने शरणागतों के लिए मनुष्यों के सामने प्रकट की है।<verse eid="PSA 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20" />तू उन्हें मनुष्य के षड्यंत्रों से बचाकर</para>
  <para style="q2" vid="PSA 31:20">अपनी उपस्थिति की सुरक्षा में छिपाता है;</para>
  <para style="q1" vid="PSA 31:20">तू उन्हें अपने शरणस्थान में रखकर झगड़ालू जीभ से बचाता है।<verse eid="PSA 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21" />यहोवा धन्य है, क्योंकि उसने घिरे हुए</para>
  <para style="q2" vid="PSA 31:21">नगर में भी मुझ पर अपनी करुणा अद्भुत रीति से प्रकट की है।<verse eid="PSA 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22" />मैंने तो घबराकर कहा था,</para>
  <para style="q2" vid="PSA 31:22">“मैं तेरी दृष्‍टि से दूर हो गया हूँ।”</para>
  <para style="q1" vid="PSA 31:22">फिर भी जब मैंने तुझे पुकारा तो तूने मेरी दुहाई सुनी।<verse eid="PSA 31:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23" />हे यहोवा के सब भक्‍तो, उससे प्रेम रखो।</para>
  <para style="q2" vid="PSA 31:23">यहोवा सच्‍चे मनुष्यों की रक्षा करता है,</para>
  <para style="q1" vid="PSA 31:23">परंतु अहंकारी से पूरा-पूरा बदला लेता है।<verse eid="PSA 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24" />हे यहोवा पर आशा रखनेवालो,</para>
  <para style="q2" vid="PSA 31:24">साहसी बनो और तुम्हारे हृदय दृढ़ रहें।<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="s1">क्षमाप्राप्‍ति का आनंद</para>
  <para style="b" />
  <para style="d">दाऊद का मश्कील।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1" />क्या ही धन्य है वह जिसका अपराध क्षमा किया गया,</para>
  <para style="q2" vid="PSA 32:1">और जिसका पाप ढाँपा गया हो!<verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />क्या ही धन्य है वह मनुष्य जिसके अधर्म का</para>
  <para style="q2" vid="PSA 32:2">लेखा यहोवा न ले,</para>
  <para style="q1" vid="PSA 32:2">और जिसकी आत्मा में कोई कपट न हो।<verse eid="PSA 32:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3" />जब मैं चुप रहा तो दिन भर कराहते-कराहते</para>
  <para style="q2" vid="PSA 32:3">मेरी हड्डियाँ पिघल गईं।<verse eid="PSA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4" />मैं दिन और रात तेरे भारी हाथ के नीचे दबा रहा।</para>
  <para style="q2" vid="PSA 32:4">मेरा बल मानो ग्रीष्मकाल के ताप से क्षीण हो गया। सेला।<verse eid="PSA 32:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5" />मैंने तेरे सामने अपना पाप स्वीकार किया</para>
  <para style="q2" vid="PSA 32:5">और अपना अधर्म न छिपाया।</para>
  <para style="q1" vid="PSA 32:5">मैंने कहा, “मैं अपने अपराध यहोवा के सामने मान लूँगा,”</para>
  <para style="q2" vid="PSA 32:5">और तूने मेरे पाप के दोष को क्षमा कर दिया। सेला।<verse eid="PSA 32:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />इसलिए तेरा प्रत्येक भक्‍त ऐसे समय में</para>
  <para style="q2" vid="PSA 32:6">तुझसे प्रार्थना करे जब तू मिल सकता है;</para>
  <para style="q1" vid="PSA 32:6">निश्‍चय ही जल की बड़ी बाढ़ भी उस तक न पहुँचेगी।<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />तू मेरे छिपने का स्थान है;</para>
  <para style="q2" vid="PSA 32:7">तू संकट में मेरी रक्षा करता है।</para>
  <para style="q1" vid="PSA 32:7">तू मुझे छुटकारे के गीतों से घेरे रहता है। सेला।<verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />मैं तुझे बुद्धि दूँगा और जिस मार्ग पर तुझे चलना है</para>
  <para style="q2" vid="PSA 32:8">उस पर तेरी अगुवाई करूँगा;</para>
  <para style="q1" vid="PSA 32:8">मैं तुझ पर अपनी कृपादृष्‍टि रखते हुए तुझे सम्मति दूँगा।<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />घोड़े और खच्‍‍चर के समान न बनो जिनमें समझ नहीं होती;</para>
  <para style="q2" vid="PSA 32:9">उन्हें लगाम और बाग से वश में किया जाता है,</para>
  <para style="q1" vid="PSA 32:9">नहीं तो वे तेरे वश में नहीं आएँगे।<verse eid="PSA 32:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />दुष्‍ट पर तो बहुत दुःख आते हैं,</para>
  <para style="q2" vid="PSA 32:10">परंतु यहोवा पर भरोसा रखनेवाले को उसकी करुणा घेरे रहेगी।<verse eid="PSA 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />हे धर्मियो, यहोवा में आनंदित और मगन रहो!</para>
  <para style="q2" vid="PSA 32:11">हे सब सीधे मनवालो, आनंद से जय जयकार करो!<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s1">सृष्‍टिकर्ता के लिए स्तुतिगान</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1" />हे धर्मियो, आनंद से यहोवा का जय जयकार करो,</para>
  <para style="q2" vid="PSA 33:1">खरे लोगों को स्तुति करना शोभा देता है।<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />वीणा बजा बजाकर यहोवा का धन्यवाद करो,</para>
  <para style="q2" vid="PSA 33:2">दस तारवाली सारंगी बजाकर उसका स्तुतिगान करो।<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />उसके लिए एक नया गीत गाओ,</para>
  <para style="q2" vid="PSA 33:3">जय जयकार करते हुए निपुणता से बजाओ।<verse eid="PSA 33:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />यहोवा का वचन खरा है,</para>
  <para style="q2" vid="PSA 33:4">और उसका सब कार्य सच्‍चाई से होता है।<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />यहोवा धार्मिकता और न्याय से प्रीति रखता है;</para>
  <para style="q2" vid="PSA 33:5">उसकी करुणा से पृथ्वी भरपूर है।<verse eid="PSA 33:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />आकाशमंडल की रचना यहोवा के वचन से,</para>
  <para style="q2" vid="PSA 33:6">और उसके सारे गणों की रचना उसी के मुँह की श्‍वास से हुई है।<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />वह समुद्र के जल को ढेर के समान इकट्ठा करता है,</para>
  <para style="q2" vid="PSA 33:7">और गहरे सागरों को भंडार में रखता है।<verse eid="PSA 33:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />सारी पृथ्वी यहोवा से डरे,</para>
  <para style="q2" vid="PSA 33:8">जगत के सब निवासी उसका भय मानें।<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />क्योंकि उसने जो कहा, वह हो गया;</para>
  <para style="q2" vid="PSA 33:9">उसने आज्ञा दी, और ठीक वैसा ही हो गया।<verse eid="PSA 33:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />यहोवा जाति-जाति की युक्‍ति को विफल कर देता है;</para>
  <para style="q2" vid="PSA 33:10">वह देश-देश के लोगों की योजनाओं को व्यर्थ कर देता है।<verse eid="PSA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />यहोवा की युक्‍ति सर्वदा स्थिर रहती है,</para>
  <para style="q2" vid="PSA 33:11">उसके हृदय की योजनाएँ पीढ़ी से पीढ़ी तक बनी रहती हैं।<verse eid="PSA 33:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />क्या ही धन्य है वह जाति जिसका परमेश्‍वर यहोवा है—</para>
  <para style="q2" vid="PSA 33:12">वह प्रजा जिसे उसने अपना निज भाग होने के लिए चुना है।<verse eid="PSA 33:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />यहोवा स्वर्ग से देखता है,</para>
  <para style="q2" vid="PSA 33:13">वह सब मनुष्यों पर दृष्‍टि करता है।<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />वह अपने निवासस्थान से पृथ्वी के सब</para>
  <para style="q2" vid="PSA 33:14">निवासियों को निहारता है,<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />और उन सब के हृदयों को गढ़ता,</para>
  <para style="q2" vid="PSA 33:15">तथा उनके समस्त कार्यों को समझता है।<verse eid="PSA 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />राजा अपनी विशाल सेना के कारण नहीं बचता;</para>
  <para style="q2" vid="PSA 33:16">न शूरवीर अपने बड़े सामर्थ्य के कारण छूटता है।<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />बचाव के लिए घोड़ों पर आशा रखना व्यर्थ है,</para>
  <para style="q2" vid="PSA 33:17">जो अपनी बड़ी शक्‍ति से भी किसी को नहीं बचा सकते।<verse eid="PSA 33:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />यहोवा की दृष्‍टि तो उन पर बनी रहती है</para>
  <para style="q2" vid="PSA 33:18">जो उसका भय मानते</para>
  <para style="q1" vid="PSA 33:18">और उसकी करुणा पर यह आशा रखते हैं,<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />कि वही उनके प्राण को मृत्यु से बचाए</para>
  <para style="q2" vid="PSA 33:19">और अकाल के समय उन्हें जीवित रखे।<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />हमारा प्राण यहोवा की आस रखता है;</para>
  <para style="q2" vid="PSA 33:20">वह हमारा सहायक और हमारी ढाल है।<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />हमारा मन उसमें आनंदित है,</para>
  <para style="q2" vid="PSA 33:21">क्योंकि हमने उसके पवित्र नाम पर भरोसा रखा है।<verse eid="PSA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />हे यहोवा, जैसी हमारी आशा तुझ पर है,</para>
  <para style="q2" vid="PSA 33:22">वैसी ही तेरी करुणा हम पर हो।<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="s1">यहोवा धर्मियों को छुड़ाता है</para>
  <para style="b" />
  <para style="d">दाऊद का भजन। जब वह अबीमेलेक के सामने पागल सा बना, और अबीमेलेक ने उसे निकाल दिया, और वह चला गया।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1" />मैं हर समय यहोवा को धन्य कहूँगा;</para>
  <para style="q2" vid="PSA 34:1">उसकी स्तुति निरंतर मेरे मुख से होती रहेगी।<verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />मेरा प्राण यहोवा पर गर्व करेगा;</para>
  <para style="q2" vid="PSA 34:2">नम्र लोग यह सुनकर आनंदित होंगे।<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />मेरे साथ यहोवा की प्रशंसा करो।</para>
  <para style="q2" vid="PSA 34:3">आओ, हम सब मिलकर उसके नाम की स्तुति करें।<verse eid="PSA 34:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />मैंने यहोवा से विनती की,</para>
  <para style="q2" vid="PSA 34:4">और उसने मुझे उत्तर दिया</para>
  <para style="q1" vid="PSA 34:4">तथा मेरे सारे भय से मुझे मुक्‍त किया।<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />जिन्होंने उसकी ओर देखा उन्होंने ज्योति पाई;</para>
  <para style="q2" vid="PSA 34:5">वे कभी लज्‍जित न होंगे।<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />इस दुःखी जन ने पुकारा,</para>
  <para style="q2" vid="PSA 34:6">तब यहोवा ने उसकी सुन ली</para>
  <para style="q1" vid="PSA 34:6">और उसके सारे कष्‍टों से उसे छुड़ा लिया।<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />यहोवा का भय माननेवालों के चारों ओर</para>
  <para style="q2" vid="PSA 34:7">उसका दूत छावनी डालकर उन्हें बचाता है।<verse eid="PSA 34:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />परखकर<note caller="+" style="f"><char style="fr" closed="false">34:8 </char><char style="ft" closed="false">या चखकर</char></note> देखो कि यहोवा कैसा भला है!</para>
  <para style="q2" vid="PSA 34:8">क्या ही धन्य है वह मनुष्य जो उसकी शरण लेता है।<verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />हे यहोवा के पवित्र लोगो,</para>
  <para style="q2" vid="PSA 34:9">उसका भय मानो,</para>
  <para style="q1" vid="PSA 34:9">क्योंकि उसका भय माननेवालों को कोई घटी नहीं होती।<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />जवान सिंहों को तो घटी होती है,</para>
  <para style="q2" vid="PSA 34:10">और वे भूखे भी रह जाते हैं,</para>
  <para style="q1" vid="PSA 34:10">परंतु यहोवा के खोजियों को</para>
  <para style="q2" vid="PSA 34:10">किसी भली वस्तु की घटी न होगी।<verse eid="PSA 34:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />हे बालको, आओ, मेरी सुनो,</para>
  <para style="q2" vid="PSA 34:11">मैं तुम्हें यहोवा का भय मानना सिखाऊँगा।<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />वह कौन है जो जीवन की अभिलाषा रखता है</para>
  <para style="q2" vid="PSA 34:12">और दीर्घायु चाहता है कि भलाई देखे?<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />अपनी जीभ को बुराई से,</para>
  <para style="q2" vid="PSA 34:13">और अपने होंठों को छल की बातें बोलने से रोक रख।<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />बुराई से दूर रह, और भलाई कर।</para>
  <para style="q2" vid="PSA 34:14">शांति को खोज और उसका पीछा कर।<verse eid="PSA 34:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />यहोवा की आँखें धर्मियों पर लगी रहती हैं</para>
  <para style="q2" vid="PSA 34:15">और उसके कान उनकी पुकार की ओर लगे रहते हैं।<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />यहोवा बुराई करनेवालों के विरुद्ध रहता है</para>
  <para style="q2" vid="PSA 34:16">कि उनका स्मरण भी पृथ्वी पर से मिटा डाले।<verse eid="PSA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />धर्मी पुकारते हैं और यहोवा सुनता है,</para>
  <para style="q2" vid="PSA 34:17">और उन्हें उनकी सारी विपत्तियों से छुड़ाता है।<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />यहोवा टूटे मनवालों के निकट रहता है,</para>
  <para style="q2" vid="PSA 34:18">और पिसे हुओं का उद्धार करता है।<verse eid="PSA 34:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />धर्मी पर बहुत सी विपत्तियाँ आती तो हैं,</para>
  <para style="q2" vid="PSA 34:19">परंतु यहोवा उसे उन सब से छुड़ाता है।<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />वह उसकी हड्डी-हड्डी की रक्षा करता है,</para>
  <para style="q2" vid="PSA 34:20">और उनमें से एक भी नहीं टूटती।<verse eid="PSA 34:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />दुष्‍ट को उसी की दुष्‍टता मार डालेगी,</para>
  <para style="q2" vid="PSA 34:21">और धर्मी के बैरी दोषी ठहरेंगे।<verse eid="PSA 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />यहोवा अपने दासों का प्राण मोल लेकर छुड़ाता है,</para>
  <para style="q2" vid="PSA 34:22">और उसके शरणागतों में से कोई भी दोषी न ठहरेगा।<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="s1">शत्रुओं पर विजय के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1" />हे यहोवा, जो मुझसे लड़ते हैं,</para>
  <para style="q2" vid="PSA 35:1">उनसे तू ही लड़;</para>
  <para style="q1" vid="PSA 35:1">जो मुझसे युद्ध करते हैं,</para>
  <para style="q2" vid="PSA 35:1">उनसे तू ही युद्ध कर।<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />ढाल और कवच लेकर</para>
  <para style="q2" vid="PSA 35:2">मेरी सहायता के लिए उठ खड़ा हो।<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />भाले को तान और मेरा पीछा करनेवालों को रोक।</para>
  <para style="q2" vid="PSA 35:3">मेरे प्राण से कह, “मैं तेरा उद्धार हूँ।”<verse eid="PSA 35:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />जो मेरे प्राण के खोजी हैं</para>
  <para style="q2" vid="PSA 35:4">वे लज्‍जित और अपमानित हों!</para>
  <para style="q1" vid="PSA 35:4">जो मेरी हानि की योजना बनाते हैं</para>
  <para style="q2" vid="PSA 35:4">वे पीछे खदेड़े जाएँ और लज्‍जित हों!<verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />वे हवा से उड़ जानेवाली भूसी के समान हों,</para>
  <para style="q2" vid="PSA 35:5">और यहोवा का दूत उन्हें हाँकता जाए।<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />उनका मार्ग अंधकारमय और फिसलन भरा हो,</para>
  <para style="q2" vid="PSA 35:6">और यहोवा का दूत उन्हें खदेड़ता जाए।<verse eid="PSA 35:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />क्योंकि उन्होंने अकारण मेरे लिए जाल बिछाया;</para>
  <para style="q2" vid="PSA 35:7">बिना कारण उन्होंने मेरे लिए गड्‌ढा खोदा है।<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />उन पर अचानक विनाश आ जाए;</para>
  <para style="q2" vid="PSA 35:8">वे अपने बिछाए जाल में स्वयं फँसे—</para>
  <para style="q1" vid="PSA 35:8">वे उसी विनाश में जा पड़ें।<verse eid="PSA 35:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />मेरा मन यहोवा में आनंदित होगा,</para>
  <para style="q2" vid="PSA 35:9">और उसके उद्धार के कारण मगन होगा।<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />मेरी हड्डी-हड्डी कहेगी,</para>
  <para style="q2" vid="PSA 35:10">“हे यहोवा, तेरे तुल्य कौन है?</para>
  <para style="q1" vid="PSA 35:10">तू दीन को उससे अधिक बलवंत मनुष्य से बचाता है</para>
  <para style="q2" vid="PSA 35:10">और दीन-दरिद्र की लुटेरे से रक्षा करता है।”<verse eid="PSA 35:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />झूठे गवाह उठ खड़े होते हैं</para>
  <para style="q2" vid="PSA 35:11">और वे उन बातों को पूछते हैं जिन्हें मैं नहीं जानता।<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />वे मेरी भलाई का बदला बुराई से देते हैं,</para>
  <para style="q2" vid="PSA 35:12">यहाँ तक कि मेरे प्राण को शोकित करते हैं।<verse eid="PSA 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />जब वे रोगी थे, तो मैंने शोक-वस्‍त्र पहने,</para>
  <para style="q2" vid="PSA 35:13">और उपवास रखकर मैंने अपने को दीन किया,</para>
  <para style="q1" vid="PSA 35:13">पर मेरी प्रार्थना सुनी नहीं गई।<verse eid="PSA 35:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14" />मैं ऐसा शोकित हुआ मानो</para>
  <para style="q2" vid="PSA 35:14">वह मेरा भाई या मित्र हो।</para>
  <para style="q1" vid="PSA 35:14">मैं शोक में ऐसे डूब गया</para>
  <para style="q2" vid="PSA 35:14">जैसे कोई अपनी माता के लिए दु:खी हो।<verse eid="PSA 35:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15" />परंतु जब मैं लड़खड़ाने लगा</para>
  <para style="q2" vid="PSA 35:15">तो वे प्रसन्‍न होकर इकट्ठे होने लगे;</para>
  <para style="q1" vid="PSA 35:15">हमला करनेवाले जिन्हें मैं जानता भी न था,</para>
  <para style="q2" vid="PSA 35:15">मेरे विरुद्ध इकट्ठे हुए</para>
  <para style="q1" vid="PSA 35:15">और निरंतर मेरी निंदा करते रहे।<verse eid="PSA 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16" />उत्सवों में दुष्‍टतापूर्वक ठट्ठा करनेवालों के समान वे</para>
  <para style="q2" vid="PSA 35:16">मुझ पर दाँत पीसते रहे।<verse eid="PSA 35:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17" />हे प्रभु, तू कब तक देखता रहेगा?</para>
  <para style="q2" vid="PSA 35:17">मुझे उनके उत्पातों से छुड़ा ले;</para>
  <para style="q1" vid="PSA 35:17">मेरे बहुमूल्य प्राण को इन सिंहों से बचा ले।<verse eid="PSA 35:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18" />मैं बड़ी सभा में तेरा धन्यवाद करूँगा,</para>
  <para style="q2" vid="PSA 35:18">बहुत से लोगों के बीच मैं तेरी स्तुति करूँगा।<verse eid="PSA 35:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19" />जो व्यर्थ ही मेरे शत्रु हैं</para>
  <para style="q2" vid="PSA 35:19">उन्हें मुझ पर आनंद करने न दे,</para>
  <para style="q1" vid="PSA 35:19">और जो अकारण मुझसे घृणा करते हैं</para>
  <para style="q2" vid="PSA 35:19">उन्हें द्वेष से घूरने न दे।<verse eid="PSA 35:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20" />क्योंकि वे मेल की बातें नहीं करते,</para>
  <para style="q2" vid="PSA 35:20">बल्कि जो देश में शांति से रहते हैं</para>
  <para style="q1" vid="PSA 35:20">उनके विरुद्ध वे छल की योजनाएँ बनाते हैं।<verse eid="PSA 35:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21" />उन्होंने मेरे विरुद्ध अपना मुँह खोला और कहा,</para>
  <para style="q2" vid="PSA 35:21">“आहा, आहा, हमने अपनी आँखों से देखा है!”<verse eid="PSA 35:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22" />हे यहोवा, तूने तो देखा है; चुप न रह।</para>
  <para style="q2" vid="PSA 35:22">हे मेरे प्रभु, मुझसे दूर न रह।<verse eid="PSA 35:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23" />जाग, मेरे न्याय के लिए उठ!</para>
  <para style="q2" vid="PSA 35:23">हे मेरे परमेश्‍वर, हे मेरे प्रभु, मेरी ओर से मुकदमा लड़।<verse eid="PSA 35:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24" />हे मेरे परमेश्‍वर यहोवा,</para>
  <para style="q2" vid="PSA 35:24">अपनी धार्मिकता के अनुसार मुझे दोषमुक्‍त कर,</para>
  <para style="q1" vid="PSA 35:24">और उन्हें मुझ पर आनंद करने न दे।<verse eid="PSA 35:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25" />वे अपने मन में यह न कह पाएँ,</para>
  <para style="q2" vid="PSA 35:25">“आहा, हमारी इच्छा पूरी हुई।”</para>
  <para style="q1" vid="PSA 35:25">और न वे यह कह पाएँ,</para>
  <para style="q2" vid="PSA 35:25">“हमने तो उसे निगल लिया है।”<verse eid="PSA 35:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26" />जो मेरे संकट पर हँसते हैं</para>
  <para style="q2" vid="PSA 35:26">वे सब लज्‍जित और अपमानित हों;</para>
  <para style="q1" vid="PSA 35:26">जो मुझे नीचा दिखाते हैं</para>
  <para style="q2" vid="PSA 35:26">वे लज्‍जा और निंदा से ढक जाएँ।<verse eid="PSA 35:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27" />जो मेरी दोषमुक्‍ति की कामना करते हैं</para>
  <para style="q2" vid="PSA 35:27">वे आनंदित हों और जय जयकार करें,</para>
  <para style="q1" vid="PSA 35:27">और निरंतर कहते रहें, “यहोवा की प्रशंसा हो,</para>
  <para style="q2" vid="PSA 35:27">जो अपने सेवक के कल्याण से प्रसन्‍न होता है।”<verse eid="PSA 35:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28" />तब मेरी जीभ से तेरी धार्मिकता की चर्चा होगी,</para>
  <para style="q2" vid="PSA 35:28">और दिन भर तेरी स्तुति होती रहेगी।<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s1">मनुष्य की दुष्‍‍टता और परमेश्‍वर का प्रेम</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। यहोवा के दास दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1" />दुष्‍ट जन का अपराध मेरे मन के भीतर यह कहता है :</para>
  <para style="q2" vid="PSA 36:1">उसकी दृष्‍टि में परमेश्‍वर का कोई भय नहीं है।<verse eid="PSA 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />क्योंकि वह अपनी इतनी प्रशंसा करता है</para>
  <para style="q2" vid="PSA 36:2">कि उसे अपने अधर्म को देखने</para>
  <para style="q1" vid="PSA 36:2">और उससे घृणा करने का बोध नहीं होता।<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />उसके मुँह के वचन दुष्‍टता और छल से भरे हैं;</para>
  <para style="q2" vid="PSA 36:3">उसने बुद्धि और भलाई के कार्य करना छोड़ दिया है।<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />वह अपने बिछौने पर पड़े हुए</para>
  <para style="q2" vid="PSA 36:4">दुष्‍टता की योजना बनाता है।</para>
  <para style="q1" vid="PSA 36:4">वह ऐसे मार्ग पर चलता रहता है जो भला नहीं।</para>
  <para style="q2" vid="PSA 36:4">वह बुराई से घृणा नहीं करता।<verse eid="PSA 36:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />हे यहोवा, तेरी करुणा स्वर्ग तक</para>
  <para style="q2" vid="PSA 36:5">और तेरी सच्‍चाई आकाशमंडल तक फैली है।<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />तेरी धार्मिकता ऊँचे पर्वतों के समान है,</para>
  <para style="q2" vid="PSA 36:6">तेरे न्याय गहरे सागर के समान हैं।</para>
  <para style="q1" vid="PSA 36:6">हे यहोवा, तू मनुष्य और पशु दोनों की रक्षा करता है।<verse eid="PSA 36:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />हे परमेश्‍वर, तेरी करुणा कितनी अनमोल है!</para>
  <para style="q2" vid="PSA 36:7">मनुष्य की संतान तेरे पंखों की छाया में शरण लेती है।<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />वे तेरे भवन की भरपूरी से तृप्‍त होते हैं,</para>
  <para style="q2" vid="PSA 36:8">और तू उन्हें अपनी सुख की नदी में से पिलाता है।<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />क्योंकि जीवन का सोता तो तेरे ही पास है;</para>
  <para style="q2" vid="PSA 36:9">तेरे ही प्रकाश से हमें प्रकाश मिलता है।<verse eid="PSA 36:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />हे यहोवा, जो तुझे जानते हैं</para>
  <para style="q2" vid="PSA 36:10">उन पर करुणा करता रह,</para>
  <para style="q1" vid="PSA 36:10">और जो सीधे मनवाले हैं</para>
  <para style="q2" vid="PSA 36:10">उन पर अपनी धार्मिकता बनाए रख।<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />अहंकारी मुझ पर लात न उठा सके,</para>
  <para style="q2" vid="PSA 36:11">और न दुष्‍ट का हाथ मुझे भगा सके।<verse eid="PSA 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />देख, अनर्थकारी कैसे गिर पड़े हैं;</para>
  <para style="q2" vid="PSA 36:12">वे ऐसे पछाड़ दिए गए हैं</para>
  <para style="q1" vid="PSA 36:12">कि उठ नहीं सकते।<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="s1">बुद्धि की बातें</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />कुकर्मियों के कारण मत कुढ़,</para>
  <para style="q2" vid="PSA 37:1">और न कुटिल काम करनेवालों से ईर्ष्या कर,<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />क्योंकि वे घास के समान शीघ्र ही सूख जाएँगे,</para>
  <para style="q2" vid="PSA 37:2">और हरे पौधों के समान मुरझा जाएँगे।<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />यहोवा पर भरोसा रख, और भला कर।</para>
  <para style="q2" vid="PSA 37:3">देश में बसा रह और विश्‍वासयोग्य रह।<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />यहोवा में मगन रह,</para>
  <para style="q2" vid="PSA 37:4">और वह तेरे मनोरथों को पूरा करेगा।<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />अपने मार्ग की चिंता यहोवा पर छोड़ दे;</para>
  <para style="q2" vid="PSA 37:5">उस पर भरोसा रख,</para>
  <para style="q1" vid="PSA 37:5">और वह सब कुछ पूरा करेगा।<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />वह तेरी धार्मिकता को भोर के प्रकाश के समान</para>
  <para style="q2" vid="PSA 37:6">और तेरे न्याय को दोपहर के प्रकाश के समान प्रकट करेगा।<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />यहोवा के सामने चुपचाप रह,</para>
  <para style="q2" vid="PSA 37:7">और धीरज से उसकी प्रतीक्षा कर।</para>
  <para style="q1" vid="PSA 37:7">उस मनुष्य के कारण न कुढ़ जिसके कार्य सफल होते हैं,</para>
  <para style="q2" vid="PSA 37:7">और जो दुष्‍टता की युक्‍तियों को पूरा करता है।<verse eid="PSA 37:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />क्रोध से दूर रह,</para>
  <para style="q2" vid="PSA 37:8">और कोप को त्याग दे।</para>
  <para style="q1" vid="PSA 37:8">मत कुढ़, क्योंकि उससे बुराई ही निकलती है।<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />कुकर्मियों का तो नाश होगा,</para>
  <para style="q2" vid="PSA 37:9">परंतु जो यहोवा की प्रतीक्षा करते हैं</para>
  <para style="q1" vid="PSA 37:9">वे पृथ्वी के अधिकारी होंगे।<verse eid="PSA 37:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />थोड़े ही समय के बाद दुष्‍ट रहेगा ही नहीं;</para>
  <para style="q2" vid="PSA 37:10">तू उसके स्थान को यत्‍न से खोजेगा,</para>
  <para style="q1" vid="PSA 37:10">पर वह वहाँ नहीं मिलेगा।<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />परंतु नम्र लोग पृथ्वी के अधिकारी होंगे,</para>
  <para style="q2" vid="PSA 37:11">और बड़ी शांति के कारण आनंदित होंगे।<verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />दुष्‍ट धर्मी के विरुद्ध षड्यंत्र रचता है,</para>
  <para style="q2" vid="PSA 37:12">और उस पर दाँत पीसता है।<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />परंतु प्रभु उस दुष्‍ट पर हँसता है,</para>
  <para style="q2" vid="PSA 37:13">क्योंकि वह देखता है कि उसका दिन आने वाला है।<verse eid="PSA 37:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />दुष्‍टों ने तलवारें खींच लीं</para>
  <para style="q2" vid="PSA 37:14">और अपने धनुष चढ़ा लिए हैं</para>
  <para style="q1" vid="PSA 37:14">कि दीन-दरिद्रों को गिरा दें,</para>
  <para style="q2" vid="PSA 37:14">और धर्मियों का वध करें।<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />उनकी तलवारें उन्हीं के हृदयों को छेदेंगी,</para>
  <para style="q2" vid="PSA 37:15">और उनके धनुष तोड़ डाले जाएँगे।<verse eid="PSA 37:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />धर्मी का थोड़ा सा धन दुष्‍टों के</para>
  <para style="q2" vid="PSA 37:16">बहुत धन से उत्तम है।<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />क्योंकि दुष्‍टों की भुजाएँ तो तोड़ी जाएँगी,</para>
  <para style="q2" vid="PSA 37:17">परंतु यहोवा धर्मियों को संभालता है।<verse eid="PSA 37:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />यहोवा खरे लोगों की आयु को जानता है,</para>
  <para style="q2" vid="PSA 37:18">और उनका भाग सदा बना रहेगा।<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />विपत्ति के समय में वे लज्‍जित न होंगे,</para>
  <para style="q2" vid="PSA 37:19">और अकाल के दिन में वे तृप्‍त रहेंगे।<verse eid="PSA 37:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />परंतु दुष्‍ट लोग नाश होंगे;</para>
  <para style="q2" vid="PSA 37:20">यहोवा के शत्रु चरागाह की हरियाली के समान लुप्‍त हो जाएँगे—</para>
  <para style="q1" vid="PSA 37:20">वे धुएँ के समान लुप्‍त हो जाएँगे।<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />दुष्‍ट ऋण लेता है, और चुकाता नहीं,</para>
  <para style="q2" vid="PSA 37:21">परंतु धर्मी उदारता से दान देता है;<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />वे जो यहोवा से आशिष पाते हैं,</para>
  <para style="q2" vid="PSA 37:22">पृथ्वी के अधिकारी होंगे;</para>
  <para style="q1" vid="PSA 37:22">परंतु जो उससे शापित होते हैं,</para>
  <para style="q2" vid="PSA 37:22">वे नाश हो जाएँगे।<verse eid="PSA 37:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />धर्मी मनुष्य के कदम यहोवा दृढ़ करता है,</para>
  <para style="q2" vid="PSA 37:23">और वह उसके चलन से प्रसन्‍न होता है।<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />चाहे वह गिर भी पड़े फिर भी पड़ा न रहेगा,</para>
  <para style="q2" vid="PSA 37:24">क्योंकि यहोवा उसका हाथ थामे रहता है।<verse eid="PSA 37:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />मैं पहले जवान था</para>
  <para style="q2" vid="PSA 37:25">और अब बूढ़ा हो गया हूँ,</para>
  <para style="q1" vid="PSA 37:25">परंतु मैंने न तो कभी धर्मी को</para>
  <para style="q2" vid="PSA 37:25">त्यागा हुआ और न उसके वंश को कभी</para>
  <para style="q1" vid="PSA 37:25">भीख माँगते देखा है।<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />वह सदा दयालु रहता है,</para>
  <para style="q2" vid="PSA 37:26">और उधार देता है;</para>
  <para style="q1" vid="PSA 37:26">और उसके वंश को आशिष मिलती है।<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />बुराई को छोड़ और भलाई कर;</para>
  <para style="q2" vid="PSA 37:27">इस प्रकार तू सर्वदा बना रहेगा।<verse eid="PSA 37:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28" />क्योंकि यहोवा न्यायप्रिय है</para>
  <para style="q2" vid="PSA 37:28">और अपने भक्‍तों को नहीं त्यागता;</para>
  <para style="q1" vid="PSA 37:28">उनकी तो रक्षा सदा की जाती है,</para>
  <para style="q2" vid="PSA 37:28">परंतु दुष्‍टों का वंश नाश किया जाएगा।<verse eid="PSA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />धर्मी लोग पृथ्वी के अधिकारी होंगे</para>
  <para style="q2" vid="PSA 37:29">और उसमें सर्वदा वास करेंगे।<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />धर्मी अपने मुँह से बुद्धि की,</para>
  <para style="q2" vid="PSA 37:30">और जीभ से न्याय की बातें कहता है।<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />उसके परमेश्‍वर की व्यवस्था</para>
  <para style="q2" vid="PSA 37:31">उसके मन में बसी रहती है,</para>
  <para style="q1" vid="PSA 37:31">उसके कदम फिसलते नहीं।<verse eid="PSA 37:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />दुष्‍ट जन धर्मी की घात में रहता है,</para>
  <para style="q2" vid="PSA 37:32">और उसे मार डालने का यत्‍न करता है।<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />यहोवा उसके हाथ में धर्मी को न छोड़ेगा;</para>
  <para style="q2" vid="PSA 37:33">और जब उसका न्याय होगा</para>
  <para style="q1" vid="PSA 37:33">तो वह उसे दोषी नहीं ठहराएगा।<verse eid="PSA 37:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />यहोवा की प्रतीक्षा कर और उसके मार्ग पर बना रह;</para>
  <para style="q2" vid="PSA 37:34">वह तुझे ऊँचा उठाएगा कि तू पृथ्वी का अधिकारी हो।</para>
  <para style="q1" vid="PSA 37:34">तू देखेगा कि दुष्‍ट काट दिए जाएँगे।<verse eid="PSA 37:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />मैंने देखा कि अत्याचारी दुष्‍ट ऐसे फलता-फूलता है,</para>
  <para style="q2" vid="PSA 37:35">जैसे उपजाऊ भूमि पर हरा-भरा पेड़।<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />परंतु देखो वह मिट गया<note caller="+" style="f"><char style="fr" closed="false">37:36 </char><char style="ft" closed="false">कुछ हस्तलेखों में “परंतु देखो वह मिट गया” के स्थान पर “फिर मैं वहाँ से निकला तो देखो” लिखा है।</char></note>,</para>
  <para style="q2" vid="PSA 37:36">मानो वह था ही नहीं;</para>
  <para style="q1" vid="PSA 37:36">मैंने उसे ढूँढ़ा पर वह नहीं मिला।<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />निर्दोष मनुष्य पर दृष्‍टि कर और खरे मनुष्य को देख,</para>
  <para style="q2" vid="PSA 37:37">क्योंकि मेल से रहनेवाले मनुष्य का वंश बढ़ेगा।<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />परंतु अपराधी एक साथ नष्‍ट किए जाएँगे;</para>
  <para style="q2" vid="PSA 37:38">दुष्‍टों का वंश नाश किया जाएगा।<verse eid="PSA 37:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />धर्मियों का उद्धार तो यहोवा से होता है;</para>
  <para style="q2" vid="PSA 37:39">संकट के समय वह उनका दृढ़ गढ़ है।<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />यहोवा उनकी सहायता करता और उन्हें बचाता है।</para>
  <para style="q2" vid="PSA 37:40">वह उन्हें दुष्‍टों से छुड़ाकर उनका उद्धार करता है,</para>
  <para style="q1" vid="PSA 37:40">क्योंकि वे उसमें शरण लेते हैं।<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="s1">पीड़ित पापी की प्रार्थना</para>
  <para style="b" />
  <para style="d">स्मारक के रूप में दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1" />हे यहोवा, क्रोध में आकर मुझे न झिड़क,</para>
  <para style="q2" vid="PSA 38:1">और न अपने प्रकोप में मुझे ताड़ना दे।<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />क्योंकि तेरे तीर मुझे गहरे लगे हैं,</para>
  <para style="q2" vid="PSA 38:2">और मैं तेरे हाथ के नीचे दबा हूँ।<verse eid="PSA 38:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />तेरे क्रोध के कारण मेरे शरीर में कुछ भी आरोग्यता नहीं,</para>
  <para style="q2" vid="PSA 38:3">मेरे पाप के कारण मेरी हड्डियों में भी चैन नहीं है।<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />क्योंकि मैं अपने अधर्म के कामों में सिर तक डूब चुका हूँ,</para>
  <para style="q2" vid="PSA 38:4">और वे भारी बोझ के समान मेरे सहने से बाहर हो गए हैं।<verse eid="PSA 38:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />मेरी मूर्खता के कारण मेरे घावों से दुर्गंध आने लगी है,</para>
  <para style="q2" vid="PSA 38:5">और वे सड़ गए हैं।<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />मैं झुक गया और नीचे दब गया हूँ।</para>
  <para style="q2" vid="PSA 38:6">मैं दिन भर विलाप करता फिरता हूँ;<verse eid="PSA 38:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />क्योंकि मेरी कमर में जलन ही जलन है,</para>
  <para style="q2" vid="PSA 38:7">और मेरे शरीर में कुछ भी आरोग्यता नहीं है।<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />मैं निर्बल हूँ और पूरी तरह से टूट गया हूँ;</para>
  <para style="q2" vid="PSA 38:8">मैं अपने मन की पीड़ा के कारण कराहता हूँ।<verse eid="PSA 38:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />हे प्रभु, मेरी हर अभिलाषा तेरे सामने है,</para>
  <para style="q2" vid="PSA 38:9">और मेरा आहें भरना तुझसे छिपा नहीं।<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />मेरा हृदय तेज़ी से धड़कता है,</para>
  <para style="q2" vid="PSA 38:10">मेरी शक्‍ति क्षीण होती जाती है,</para>
  <para style="q1" vid="PSA 38:10">और यहाँ तक कि मेरी आँखों की ज्योति भी जाती रही।<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />मेरे मित्र और मेरे साथी घावों के कारण</para>
  <para style="q2" vid="PSA 38:11">मुझसे किनारा करते हैं,</para>
  <para style="q1" vid="PSA 38:11">और मेरे परिजन भी दूर खड़े रहते हैं।<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />मेरे प्राण के खोजी मेरे लिए जाल बिछाते हैं,</para>
  <para style="q2" vid="PSA 38:12">और मेरी हानि चाहनेवालों ने</para>
  <para style="q1" vid="PSA 38:12">मुझे नष्‍ट करने की धमकी दी है।</para>
  <para style="q2" vid="PSA 38:12">वे दिन भर दुष्‍टता की युक्‍तियाँ रचते हैं।<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />परंतु मैं तो बहरे के समान हूँ जो सुनता नहीं,</para>
  <para style="q2" vid="PSA 38:13">और गूँगे के समान जो बोलता नहीं।<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />हाँ, मैं उस मनुष्य के समान हूँ जो कुछ नहीं सुनता,</para>
  <para style="q2" vid="PSA 38:14">और जिसके मुँह से कोई उत्तर नहीं निकलता।<verse eid="PSA 38:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />क्योंकि हे यहोवा, मैंने तुझ पर अपनी आशा लगाई है,</para>
  <para style="q2" vid="PSA 38:15">हे प्रभु, हे मेरे परमेश्‍वर,</para>
  <para style="q1" vid="PSA 38:15">तू ही उत्तर देगा।<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />क्योंकि मैंने कहा,</para>
  <para style="q2" vid="PSA 38:16">“जो लोग मेरे पैर फिसलने के कारण</para>
  <para style="q1" vid="PSA 38:16">मुझे नीचा दिखाकर अपने पर घमंड करते हैं,</para>
  <para style="q2" vid="PSA 38:16">वे मुझ पर आनंदित न हो पाएँ।”<verse eid="PSA 38:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />क्योंकि मैं तो अब गिरने ही पर हूँ,</para>
  <para style="q2" vid="PSA 38:17">और मेरी पीड़ा निरंतर मेरे सामने है।<verse eid="PSA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />मैं अपना अधर्म मानता हूँ,</para>
  <para style="q2" vid="PSA 38:18">और अपने पाप के कारण मैं दुःखी हूँ।<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />परंतु मेरे शत्रु फुर्तीले और बलवंत हैं;</para>
  <para style="q2" vid="PSA 38:19">मुझसे अकारण घृणा करनेवाले तो बहुत हैं।<verse eid="PSA 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20" />जो भलाई के बदले बुराई करते हैं,</para>
  <para style="q2" vid="PSA 38:20">वे भी मेरा विरोध करते हैं</para>
  <para style="q1" vid="PSA 38:20">क्योंकि मैं भलाई का अनुसरण करता हूँ।<verse eid="PSA 38:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />हे यहोवा, मुझे छोड़ न दे!</para>
  <para style="q2" vid="PSA 38:21">हे मेरे परमेश्‍वर, मुझसे दूर न रह!<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />हे प्रभु, हे मेरे उद्धार,</para>
  <para style="q2" vid="PSA 38:22">मेरी सहायता के लिए शीघ्र आ!<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="s1">जीवन की अस्थाई प्रकृति</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक यदूतून के लिए। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1" />मैंने कहा, “मैं अपने चाल-चलन की चौकसी करूँगा</para>
  <para style="q2" vid="PSA 39:1">ताकि मेरी जीभ से पाप न हो।</para>
  <para style="q1" vid="PSA 39:1">जब तक दुष्‍ट मेरे सामने है,</para>
  <para style="q2" vid="PSA 39:1">मैं अपने मुँह पर लगाम लगाए रहूँगा।”<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />मैं चुपचाप और शांत रहा,</para>
  <para style="q2" vid="PSA 39:2">मैं भलाई की ओर भी चुप्पी साधे रहा;</para>
  <para style="q1" vid="PSA 39:2">और मेरा दुःख बढ़ गया।<verse eid="PSA 39:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3" />मेरा हृदय भीतर ही भीतर जल उठा;</para>
  <para style="q2" vid="PSA 39:3">सोचते-सोचते आग भड़क उठी।</para>
  <para style="q1" vid="PSA 39:3">तब मैं अपनी जीभ से बोल उठा :<verse eid="PSA 39:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />हे यहोवा, ऐसा कर कि मैं अपना अंत जान लूँ,</para>
  <para style="q2" vid="PSA 39:4">और यह भी कि मेरी आयु के दिन कितने हैं।</para>
  <para style="q1" vid="PSA 39:4">मैं जानूँ कि मैं कैसा क्षणभंगुर हूँ।<verse eid="PSA 39:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />देख, तूने मेरी आयु कितनी छोटी<note caller="+" style="f"><char style="fr" closed="false">39:5 </char><char style="ft" closed="false">अक्षरशः हाथ भर की</char></note> रखी है,</para>
  <para style="q2" vid="PSA 39:5">और मेरा जीवनकाल मानो तेरी दृष्‍टि में कुछ भी नहीं।</para>
  <para style="q1" vid="PSA 39:5">निश्‍चय हर एक मनुष्य,</para>
  <para style="q2" vid="PSA 39:5">कितना ही स्थिर क्यों न हो,</para>
  <para style="q1" vid="PSA 39:5">फिर भी भाप के समान ही है। सेला।<verse eid="PSA 39:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />निश्‍चय हर मनुष्य छाया के समान चलता-फिरता है;</para>
  <para style="q2" vid="PSA 39:6">सचमुच लोग व्यर्थ ही घबराते हैं।</para>
  <para style="q1" vid="PSA 39:6">मनुष्य धन का संचय तो करता है</para>
  <para style="q2" vid="PSA 39:6">पर नहीं जानता कि उसे कौन लेगा।<verse eid="PSA 39:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />अब हे प्रभु, मैं किस बात की प्रतीक्षा करूँ?</para>
  <para style="q2" vid="PSA 39:7">मेरी आशा तो तुझ पर लगी है।<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />मेरे सब अपराधों से मुझे छुड़ा ले।</para>
  <para style="q2" vid="PSA 39:8">मूर्ख मेरी निंदा न कर सके।<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />मैं चुपचाप रहा; मैंने अपना मुँह नहीं खोला</para>
  <para style="q2" vid="PSA 39:9">क्योंकि तूने ही यह किया है।<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />जो विपत्ति तूने मुझ पर डाली है उसे दूर कर,</para>
  <para style="q2" vid="PSA 39:10">क्योंकि तेरे हाथ की मार से मैं नाश हुआ जाता हूँ।<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />तू मनुष्य को अधर्म के लिए डाँट-फटकार कर ताड़ना देता है,</para>
  <para style="q2" vid="PSA 39:11">और जो कुछ उसे प्रिय लगता है</para>
  <para style="q1" vid="PSA 39:11">उसे तू ऐसे नष्‍ट कर देता है</para>
  <para style="q2" vid="PSA 39:11">जैसे कोई कीड़ा वस्तुओं को खा जाता है।</para>
  <para style="q1" vid="PSA 39:11">सचमुच हर मनुष्य भाप के समान ही है। सेला।<verse eid="PSA 39:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />“हे यहोवा, मेरी प्रार्थना सुन,</para>
  <para style="q2" vid="PSA 39:12">और मेरी दुहाई पर कान लगा।</para>
  <para style="q1" vid="PSA 39:12">मेरे आँसुओं को देखकर चुप न रह,</para>
  <para style="q2" vid="PSA 39:12">क्योंकि मैं तेरे साथ रहनेवाला एक परदेशी हूँ,</para>
  <para style="q1" vid="PSA 39:12">और अपने सब पूर्वजों के समान यात्री हूँ।<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />इससे पहले कि मैं चला जाऊँ और न रहूँ,</para>
  <para style="q2" vid="PSA 39:13">अपनी क्रोध भरी दृष्‍टि मुझ पर से हटा ले</para>
  <para style="q1" vid="PSA 39:13">कि मैं फिर से आनंदित हो जाऊँ।”<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="s1">धन्यवाद बलि और सहायता के लिए पुकार</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />मैं धीरज से यहोवा की प्रतीक्षा करता रहा,</para>
  <para style="q2" vid="PSA 40:1">और उसने मेरी ओर झुककर मेरी दुहाई सुनी।<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />उसने मुझे विनाश के गड्‌ढे और दलदल में से निकाला,</para>
  <para style="q2" vid="PSA 40:2">और मुझे चट्टान पर खड़ा करके मेरे कदमों को दृढ़ किया है।<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />उसने मेरे मुँह में एक नया गीत डाला है,</para>
  <para style="q2" vid="PSA 40:3">जो हमारे परमेश्‍वर की स्तुति का गीत है।</para>
  <para style="q1" vid="PSA 40:3">बहुत से लोग यह देखकर भयभीत होंगे,</para>
  <para style="q2" vid="PSA 40:3">और यहोवा पर भरोसा रखेंगे।<verse eid="PSA 40:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />क्या ही धन्य है वह मनुष्य</para>
  <para style="q2" vid="PSA 40:4">जो यहोवा पर भरोसा रखता है,</para>
  <para style="q1" vid="PSA 40:4">और अभिमानियों तथा झूठ में लीन रहनेवालों की ओर नहीं जाता।<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />हे यहोवा मेरे परमेश्‍वर, जो आश्‍चर्यकर्म और</para>
  <para style="q2" vid="PSA 40:5">जो विचार तूने हमारे लिए किए हैं,</para>
  <para style="q1" vid="PSA 40:5">वे तो बहुत हैं;</para>
  <para style="q2" vid="PSA 40:5">तेरे तुल्य कोई नहीं।</para>
  <para style="q1" vid="PSA 40:5">यदि मैं उनके विषय में बताऊँ</para>
  <para style="q2" vid="PSA 40:5">और उनकी चर्चा करूँ तो वे इतने हैं</para>
  <para style="q1" vid="PSA 40:5">कि उनकी गिनती नहीं हो सकती।<verse eid="PSA 40:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />मेलबलि और अन्‍नबलि तूने न चाही;</para>
  <para style="q2" vid="PSA 40:6">तूने मेरे कान खोदकर खोले हैं।</para>
  <para style="q1" vid="PSA 40:6">होमबलि और पापबलि की माँग तूने नहीं की।<verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7" />तब मैंने कहा, “देख, मैं आया हूँ!</para>
  <para style="q2" vid="PSA 40:7">पुस्तक में मेरे विषय यही लिखा है।<verse eid="PSA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8" />हे मेरे परमेश्‍वर,</para>
  <para style="q2" vid="PSA 40:8">मैं तेरी इच्छा पूरी करने से प्रसन्‍न होता हूँ।</para>
  <para style="q1" vid="PSA 40:8">तेरी व्यवस्था मेरे हृदय में बसी है।”<verse eid="PSA 40:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />मैंने बड़ी सभा में धार्मिकता का</para>
  <para style="q2" vid="PSA 40:9">शुभ-संदेश सुनाया है,</para>
  <para style="q1" vid="PSA 40:9">हे यहोवा, तू तो जानता है</para>
  <para style="q2" vid="PSA 40:9">कि मैंने अपने मुँह को बंद नहीं रखा।<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />मैंने तेरी धार्मिकता को</para>
  <para style="q2" vid="PSA 40:10">अपने मन में छिपाए नहीं रखा;</para>
  <para style="q1" vid="PSA 40:10">मैंने तेरी सच्‍चाई और तेरे उद्धार की चर्चा की है।</para>
  <para style="q2" vid="PSA 40:10">मैंने तेरी करुणा और तेरी सच्‍चाई को</para>
  <para style="q1" vid="PSA 40:10">बड़ी सभा से छिपाए नहीं रखा।<verse eid="PSA 40:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />हे यहोवा, तू मुझे अपनी दया से वंचित न कर;</para>
  <para style="q2" vid="PSA 40:11">तेरी करुणा और तेरी सच्‍चाई से निरंतर मेरी रक्षा होती रहे।<verse eid="PSA 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />क्योंकि अनगिनित बुराइयों ने मुझे घेर लिया है;</para>
  <para style="q2" vid="PSA 40:12">मेरे अधर्मों ने मुझे ऐसा पकड़ लिया है</para>
  <para style="q1" vid="PSA 40:12">कि मैं देख नहीं सकता।</para>
  <para style="q2" vid="PSA 40:12">वे गिनती में मेरे सिर के बालों से कहीं बढ़कर हैं,</para>
  <para style="q1" vid="PSA 40:12">इसलिए मेरा हृदय टूट गया है।<verse eid="PSA 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />हे यहोवा, कृपा करके मुझे छुड़ा ले!</para>
  <para style="q2" vid="PSA 40:13">हे यहोवा, मेरी सहायता के लिए शीघ्र आ!<verse eid="PSA 40:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />जो मेरे जीवन को नाश करने की खोज में हैं,</para>
  <para style="q2" vid="PSA 40:14">वे सब लज्‍जित और निराश हों;</para>
  <para style="q1" vid="PSA 40:14">और जो मेरी हानि से प्रसन्‍न होते हैं,</para>
  <para style="q2" vid="PSA 40:14">वे पीछे हटाए और अपमानित किए जाएँ।<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />जो मुझसे “आहा, आहा,” कहते हैं,</para>
  <para style="q2" vid="PSA 40:15">वे अपनी लज्‍जा के कारण विस्मित हों।<verse eid="PSA 40:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />जितने तुझे खोजते हैं</para>
  <para style="q2" vid="PSA 40:16">वे सब तुझमें आनंदित और मगन हों;</para>
  <para style="q1" vid="PSA 40:16">जितने तेरे उद्धार को प्रिय जानते हैं,</para>
  <para style="q2" vid="PSA 40:16">वे सब निरंतर कहें, “यहोवा की बड़ाई हो!”<verse eid="PSA 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />मैं तो दीन और दरिद्र हूँ,</para>
  <para style="q2" vid="PSA 40:17">फिर भी प्रभु का ध्यान मुझ पर लगा रहता है।</para>
  <para style="q1" vid="PSA 40:17">तू मेरा सहायक और मेरा छुड़ानेवाला है;</para>
  <para style="q2" vid="PSA 40:17">हे मेरे परमेश्‍वर, विलंब न कर।<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="s1">विश्‍वासघात के बावजूद विजय</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1" />क्या ही धन्य है वह</para>
  <para style="q2" vid="PSA 41:1">जो कंगाल की सुधि लेता है!</para>
  <para style="q1" vid="PSA 41:1">संकट के दिन यहोवा उसे छुड़ाएगा।<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />यहोवा उसकी रक्षा करके उसे जीवित रखेगा,</para>
  <para style="q2" vid="PSA 41:2">और वह पृथ्वी पर धन्य कहलाएगा।</para>
  <para style="q1" vid="PSA 41:2">तू उसे उसके शत्रुओं की इच्छा पर न छोड़ेगा।<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />रोग-शय्या पर यहोवा उसे संभाल लेगा;</para>
  <para style="q2" vid="PSA 41:3">उसके रोग के समय तू उसे बिछौने पर से उठाकर खड़ा करेगा।<verse eid="PSA 41:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />मैंने कहा, “हे यहोवा,</para>
  <para style="q2" vid="PSA 41:4">मुझ पर अनुग्रह कर!</para>
  <para style="q1" vid="PSA 41:4">मुझे स्वस्थ कर, क्योंकि मैंने तेरे विरुद्ध पाप किया है।”<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />मेरे शत्रु यह कहकर मेरी बुराई करते हैं :</para>
  <para style="q2" vid="PSA 41:5">“वह कब मरेगा, और कब उसका नाम मिटेगा?”<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />जब उनमें से कोई मुझे देखने आता है,</para>
  <para style="q2" vid="PSA 41:6">तो वह झूठी बातें बोलता है;</para>
  <para style="q1" vid="PSA 41:6">वह अपने मन में दुष्‍टता की बातें रखता है,</para>
  <para style="q2" vid="PSA 41:6">और बाहर जाकर उन्हीं की चर्चा करता है।<verse eid="PSA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />मेरे सब बैरी मिलकर मेरे विरुद्ध कानाफूसी करते हैं;</para>
  <para style="q2" vid="PSA 41:7">वे तो मेरी हानि की योजना बनाते हैं।<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />वे कहते हैं,</para>
  <para style="q2" vid="PSA 41:8">“इसे तो कोई बुरा रोग लग गया है।</para>
  <para style="q1" vid="PSA 41:8">अब जो यह पड़ा है,</para>
  <para style="q2" vid="PSA 41:8">तो फिर कभी नहीं उठेगा।”<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />मेरा प्रिय मित्र,</para>
  <para style="q2" vid="PSA 41:9">जिस पर मैं भरोसा करता था</para>
  <para style="q1" vid="PSA 41:9">और जो मेरी रोटी खाता था,</para>
  <para style="q2" vid="PSA 41:9">उसने भी मेरे विरुद्ध लात उठाई है।<verse eid="PSA 41:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />परंतु हे यहोवा, तू मुझ पर अनुग्रह कर</para>
  <para style="q2" vid="PSA 41:10">और मुझे उठा कि मैं उनसे बदला लूँ।<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />जब मेरा शत्रु मुझ पर विजयी होकर हर्षनाद नहीं कर पाता,</para>
  <para style="q2" vid="PSA 41:11">तो मैं जान जाता हूँ कि तू मुझसे प्रसन्‍न है।<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />मेरी खराई के कारण तूने मुझे संभाला हुआ है,</para>
  <para style="q2" vid="PSA 41:12">और तू अपने सम्मुख मुझे सर्वदा के लिए स्थिर करता है।<verse eid="PSA 41:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />इस्राएल का परमेश्‍वर यहोवा आदि से अनंतकाल तक धन्य है!</para>
  <para style="q2" vid="PSA 41:13">आमीन, फिर आमीन।<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="s1">दूसरा भाग</para>
  <para style="b" />
  <para style="s1">(भजन 42—72)</para>
  <para style="b" />
  <para style="s1">परमेश्‍वर के लिए चाहत</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए कोरहवंशियों का मश्कील।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />जैसे हरिणी नदी के जल के लिए हाँफती है,</para>
  <para style="q2" vid="PSA 42:1">वैसे ही, हे परमेश्‍वर,</para>
  <para style="q1" vid="PSA 42:1">मैं तेरे लिए हाँफता हूँ।<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />मैं परमेश्‍वर के लिए, हाँ,</para>
  <para style="q2" vid="PSA 42:2">जीवित परमेश्‍वर के लिए प्यासा हूँ।</para>
  <para style="q1" vid="PSA 42:2">मैं कब जाऊँगा और परमेश्‍वर के</para>
  <para style="q2" vid="PSA 42:2">मुख का दर्शन करूँगा?<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />मेरे आँसू दिन और रात मेरा आहार रहे हैं,</para>
  <para style="q2" vid="PSA 42:3">और लोग दिन भर मुझसे कहते रहते हैं,</para>
  <para style="q1" vid="PSA 42:3">“तेरा परमेश्‍वर कहाँ है?”<verse eid="PSA 42:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />इन बातों को स्मरण करके</para>
  <para style="q2" vid="PSA 42:4">मेरा मन भर जाता है</para>
  <para style="q1" vid="PSA 42:4">कि मैं कैसे धन्यवाद</para>
  <para style="q2" vid="PSA 42:4">और जय जयकार के साथ,</para>
  <para style="q1" vid="PSA 42:4">उत्सव मनाती हुई भीड़ के संग</para>
  <para style="q2" vid="PSA 42:4">यहोवा के भवन में जाया करता था।<verse eid="PSA 42:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />हे मेरे मन, तू निराश क्यों है?</para>
  <para style="q2" vid="PSA 42:5">तू भीतर ही भीतर व्याकुल क्यों है?</para>
  <para style="q1" vid="PSA 42:5">परमेश्‍वर पर आशा लगाए रह;</para>
  <para style="q2" vid="PSA 42:5">मैं तो उसकी स्तुति करूँगा</para>
  <para style="q1" vid="PSA 42:5">जो मेरा उद्धारकर्ता</para>
  <para style="q2" vid="PSA 42:5">और मेरा परमेश्‍वर है।<verse eid="PSA 42:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6" />मेरा प्राण भीतर ही भीतर व्याकुल है;</para>
  <para style="q2" vid="PSA 42:6">इसलिए मैं यरदन के प्रदेश से,</para>
  <para style="q1" vid="PSA 42:6">हर्मोन की चोटियों और मिसगार की</para>
  <para style="q2" vid="PSA 42:6">पहाड़ी पर से तुझे स्मरण करता हूँ।<verse eid="PSA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7" />तेरी जल-धाराओं की गूँज से सागर,</para>
  <para style="q2" vid="PSA 42:7">सागर को पुकारता है।</para>
  <para style="q1" vid="PSA 42:7">तेरी सारी तरंगों और लहरों ने</para>
  <para style="q2" vid="PSA 42:7">मुझे ढाँप लिया है।<verse eid="PSA 42:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />दिन को तो यहोवा अपनी करुणा दिखाएगा,</para>
  <para style="q2" vid="PSA 42:8">और रात को मैं उसका गीत गाऊँगा;</para>
  <para style="q1" vid="PSA 42:8">मैं उससे प्रार्थना करूँगा जो मेरे जीवन का परमेश्‍वर है।<verse eid="PSA 42:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />मैं परमेश्‍वर से जो मेरी चट्टान है कहूँगा :</para>
  <para style="q2" vid="PSA 42:9">“तू मुझे क्यों भूल गया?</para>
  <para style="q1" vid="PSA 42:9">मैं शत्रु के अंधेर के कारण</para>
  <para style="q2" vid="PSA 42:9">क्यों विलाप करता फिरूँ?”<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />मेरे शत्रु मेरी निंदा करते हैं,</para>
  <para style="q2" vid="PSA 42:10">जिससे मेरी हड्डियाँ मानो</para>
  <para style="q1" vid="PSA 42:10">चूर-चूर हो जाती हैं।</para>
  <para style="q2" vid="PSA 42:10">वे दिन भर मुझसे कहते रहते हैं,</para>
  <para style="q1" vid="PSA 42:10">“कहाँ है तेरा परमेश्‍वर?”<verse eid="PSA 42:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11" />हे मेरे मन, तू निराश क्यों है?</para>
  <para style="q2" vid="PSA 42:11">तू भीतर ही भीतर व्याकुल क्यों है?</para>
  <para style="q1" vid="PSA 42:11">परमेश्‍वर पर आशा लगाए रह;</para>
  <para style="q2" vid="PSA 42:11">मैं तो उसकी स्तुति करूँगा</para>
  <para style="q1" vid="PSA 42:11">जो मेरा उद्धारकर्ता और मेरा परमेश्‍वर है।<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s1">संकट के समय परमेश्‍वर से प्रार्थना</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />हे परमेश्‍वर, मुझे निर्दोष सिद्ध कर</para>
  <para style="q2" vid="PSA 43:1">और विधर्मी जाति के विरुद्ध मेरा मुकदमा लड़।</para>
  <para style="q1" vid="PSA 43:1">मुझे कपटी और कुटिल व्यक्‍ति के हाथों से छुड़ा।<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />हे परमेश्‍वर, तू मेरा दृढ़ गढ़ है।</para>
  <para style="q2" vid="PSA 43:2">तूने मुझे क्यों त्याग दिया है?</para>
  <para style="q1" vid="PSA 43:2">मैं शत्रु के अंधेर के कारण</para>
  <para style="q2" vid="PSA 43:2">क्यों विलाप करता फिरूँ?<verse eid="PSA 43:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />अपनी ज्योति और अपनी सच्‍चाई को भेज।</para>
  <para style="q2" vid="PSA 43:3">वे ही मेरी अगुवाई करें</para>
  <para style="q1" vid="PSA 43:3">और मुझे तेरे पवित्र पर्वत</para>
  <para style="q2" vid="PSA 43:3">अर्थात् तेरे निवासस्थान पर पहुँचाएँ।<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />तब मैं परमेश्‍वर की वेदी के पास जाऊँगा,</para>
  <para style="q2" vid="PSA 43:4">उस परमेश्‍वर के पास</para>
  <para style="q1" vid="PSA 43:4">जो मेरा असीम आनंद है।</para>
  <para style="q2" vid="PSA 43:4">हे परमेश्‍वर, हे मेरे परमेश्‍वर,</para>
  <para style="q1" vid="PSA 43:4">मैं वीणा बजाते हुए</para>
  <para style="q2" vid="PSA 43:4">तेरी स्तुति करूँगा।<verse eid="PSA 43:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />हे मेरे मन, तू निराश क्यों है?</para>
  <para style="q2" vid="PSA 43:5">तू भीतर ही भीतर व्याकुल क्यों है?</para>
  <para style="q1" vid="PSA 43:5">परमेश्‍वर पर आशा लगाए रह;</para>
  <para style="q2" vid="PSA 43:5">मैं तो उसकी स्तुति करूँगा</para>
  <para style="q1" vid="PSA 43:5">जो मेरा उद्धारकर्ता और मेरा परमेश्‍वर है।<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s1">इस्राएल की शिकायत</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए कोरहवंशियों का मश्कील।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1" />हे परमेश्‍वर, हमने अपने कानों से सुना है,</para>
  <para style="q2" vid="PSA 44:1">हमारे बापदादों ने हमें यह बताया है</para>
  <para style="q1" vid="PSA 44:1">कि तूने उनके दिनों में</para>
  <para style="q2" vid="PSA 44:1">अर्थात् प्राचीनकाल में</para>
  <para style="q1" vid="PSA 44:1">कैसे बड़े-बड़े कार्य किए हैं।<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />तूने अपने ही हाथ से विभिन्‍न</para>
  <para style="q2" vid="PSA 44:2">जातियों को खदेड़कर उन्हें बसाया;</para>
  <para style="q1" vid="PSA 44:2">तूने देश-देश के लोगों को</para>
  <para style="q2" vid="PSA 44:2">कुचलकर उन्हें फैलाया।<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />उन्होंने न तो अपनी तलवार से</para>
  <para style="q2" vid="PSA 44:3">इस देश पर अधिकार किया,</para>
  <para style="q1" vid="PSA 44:3">और न ही वे</para>
  <para style="q2" vid="PSA 44:3">अपने भुजबल से विजयी हुए;</para>
  <para style="q1" vid="PSA 44:3">परंतु यह तो तेरे दाहिने हाथ,</para>
  <para style="q2" vid="PSA 44:3">और तेरी भुजा,</para>
  <para style="q1" vid="PSA 44:3">और तेरे मुख के प्रकाश से हुआ,</para>
  <para style="q2" vid="PSA 44:3">क्योंकि तू उनको चाहता था।<verse eid="PSA 44:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />हे परमेश्‍वर, तू ही मेरा राजा है;</para>
  <para style="q2" vid="PSA 44:4">याकूब की विजय की आज्ञा दे।<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />तेरी सहायता से हम</para>
  <para style="q2" vid="PSA 44:5">अपने शत्रुओं को पीछे खदेड़ देंगे।</para>
  <para style="q1" vid="PSA 44:5">तेरे नाम से हम</para>
  <para style="q2" vid="PSA 44:5">अपने विरोध में उठनेवालों को कुचल डालेंगे।<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />क्योंकि मैं अपने धनुष पर भरोसा नहीं रखता,</para>
  <para style="q2" vid="PSA 44:6">और न मेरी तलवार</para>
  <para style="q1" vid="PSA 44:6">मुझे विजय दिलाती है।<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />बल्कि तूने ही हमें</para>
  <para style="q2" vid="PSA 44:7">हमारे शत्रुओं से बचाया है,</para>
  <para style="q1" vid="PSA 44:7">और जो हमसे घृणा रखते हैं</para>
  <para style="q2" vid="PSA 44:7">उन्हें लज्‍जित किया है।<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />हम निरंतर अपने परमेश्‍वर की</para>
  <para style="q2" vid="PSA 44:8">बड़ाई करते रहते हैं;</para>
  <para style="q1" vid="PSA 44:8">हम तेरे नाम का</para>
  <para style="q2" vid="PSA 44:8">धन्यवाद सदा-सर्वदा करते रहेंगे।</para>
  <para style="q1" vid="PSA 44:8">सेला।<verse eid="PSA 44:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />परंतु अब तूने हमें त्याग दिया</para>
  <para style="q2" vid="PSA 44:9">और अपमानित किया है;</para>
  <para style="q1" vid="PSA 44:9">तू हमारी सेनाओं के साथ आगे नहीं जाता।<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />तूने हमें शत्रुओं को पीठ</para>
  <para style="q2" vid="PSA 44:10">दिखाने को विवश कर दिया,</para>
  <para style="q1" vid="PSA 44:10">और हमारे बैरियों ने</para>
  <para style="q2" vid="PSA 44:10">हमसे लूट-मार की है।<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />तूने हमें भोजन के लिए कटनेवाली</para>
  <para style="q2" vid="PSA 44:11">भेड़ों के समान कर दिया है,</para>
  <para style="q1" vid="PSA 44:11">और हमें जाति-जाति में</para>
  <para style="q2" vid="PSA 44:11">तितर-बितर किया है।<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />तूने अपनी प्रजा को मुफ़्त में</para>
  <para style="q2" vid="PSA 44:12">बेच दिया है,</para>
  <para style="q1" vid="PSA 44:12">और उनके बिकने से</para>
  <para style="q2" vid="PSA 44:12">तुझे कोई लाभ नहीं हुआ।<verse eid="PSA 44:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />तू हमारे पड़ोसियों में</para>
  <para style="q2" vid="PSA 44:13">हमें निंदा का पात्र बनाता है,</para>
  <para style="q1" vid="PSA 44:13">और हमारे चारों ओर रहनेवालों के लिए</para>
  <para style="q2" vid="PSA 44:13">हमें हँसी और ठट्ठे का</para>
  <para style="q1" vid="PSA 44:13">कारण बनाता है।<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />तू सब जातियों के मध्य</para>
  <para style="q2" vid="PSA 44:14">हमें घृणा का पात्र बनाता है,</para>
  <para style="q1" vid="PSA 44:14">और देश-देश के लोग</para>
  <para style="q2" vid="PSA 44:14">सिर हिला हिलाकर हम पर हँसते हैं।<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />दिन भर मेरा अपमान होता है।<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />बुरा-भला कहनेवालों</para>
  <para style="q2" vid="PSA 44:16">और निंदा करनेवालों के कारण</para>
  <para style="q1" vid="PSA 44:16">तथा शत्रु और बदला लेनेवालों</para>
  <para style="q2" vid="PSA 44:16">के कारण लज्‍जा ने</para>
  <para style="q1" vid="PSA 44:16">मेरे मुख को ढाँप लिया है।<verse eid="PSA 44:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />हम पर यह सब बीता,</para>
  <para style="q2" vid="PSA 44:17">फिर भी हम तुझे नहीं भूले</para>
  <para style="q1" vid="PSA 44:17">और न तेरी वाचा के प्रति</para>
  <para style="q2" vid="PSA 44:17">हमने विश्‍वासघात किया।<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />हमारे मन न बहके,</para>
  <para style="q2" vid="PSA 44:18">और न हमारे कदम</para>
  <para style="q1" vid="PSA 44:18">तेरे मार्ग से भटके,<verse eid="PSA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19" />फिर भी तूने हमें गीदड़ों</para>
  <para style="q2" vid="PSA 44:19">के स्थान में कुचल दिया है,</para>
  <para style="q1" vid="PSA 44:19">और घोर अंधकार से</para>
  <para style="q2" vid="PSA 44:19">हमें ढाँप दिया है।<verse eid="PSA 44:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />यदि हम अपने परमेश्‍वर का नाम भूल जाते,</para>
  <para style="q2" vid="PSA 44:20">या किसी पराए देवता</para>
  <para style="q1" vid="PSA 44:20">की ओर अपने हाथ फैलाते,<verse eid="PSA 44:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21" />तो क्या परमेश्‍वर इसे नहीं जानता,</para>
  <para style="q2" vid="PSA 44:21">क्योंकि वह तो मन की</para>
  <para style="q1" vid="PSA 44:21">गुप्‍त बातों को जानता है।<verse eid="PSA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22" />परंतु हम दिन भर</para>
  <para style="q2" vid="PSA 44:22">तेरे निमित्त मार डाले जाते हैं,</para>
  <para style="q1" vid="PSA 44:22">और वध होनेवाली भेड़ों</para>
  <para style="q2" vid="PSA 44:22">के समान समझे जाते हैं।<verse eid="PSA 44:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />हे प्रभु, जाग!</para>
  <para style="q2" vid="PSA 44:23">तू क्यों सोता है? उठ!</para>
  <para style="q1" vid="PSA 44:23">हमें सदा के लिए न त्याग।<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />तू अपना मुँह क्यों छिपा लेता है?</para>
  <para style="q2" vid="PSA 44:24">और हमारे दुःख और सताए जाने को</para>
  <para style="q1" vid="PSA 44:24">क्यों भूल जाता है?<verse eid="PSA 44:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />हमारा प्राण धूल में पड़ा है;</para>
  <para style="q2" vid="PSA 44:25">हमारी देह भूमि पर औंधे मुँह पड़ी है।<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />हे परमेश्‍वर उठ!</para>
  <para style="q2" vid="PSA 44:26">हमारी सहायता कर,</para>
  <para style="q1" vid="PSA 44:26">और अपनी करुणा के कारण</para>
  <para style="q2" vid="PSA 44:26">हमें छुड़ा ले।<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s1">राजकीय विवाह गान</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। शोशन्‍नीम की राग पर कोरहवंशियों का मश्कील। एक प्रेम गीत।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />मेरे हृदय में एक मधुर भाव उमड़ रहा है,</para>
  <para style="q2" vid="PSA 45:1">मैं राजा को अपना गीत सुनाता हूँ।</para>
  <para style="q1" vid="PSA 45:1">मेरी जीभ निपुण लेखक की लेखनी बनी है।<verse eid="PSA 45:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />मनुष्यों की संतानों में तू अति सुंदर है,</para>
  <para style="q2" vid="PSA 45:2">तेरे होंठ अनुग्रह से परिपूर्ण हैं;</para>
  <para style="q1" vid="PSA 45:2">इसलिए परमेश्‍वर ने तुझे सदा-सर्वदा</para>
  <para style="q2" vid="PSA 45:2">के लिए आशिष दी है।<verse eid="PSA 45:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />हे शूरवीर, तू अपनी तलवार को</para>
  <para style="q2" vid="PSA 45:3">कमर पर बाँध ले,</para>
  <para style="q1" vid="PSA 45:3">जो तेरा वैभव और प्रताप है!<verse eid="PSA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />तू सत्य, नम्रता, और धार्मिकता के लिए</para>
  <para style="q2" vid="PSA 45:4">अपने प्रताप पर सवार होकर</para>
  <para style="q1" vid="PSA 45:4">विजयपूर्वक आगे बढ़।</para>
  <para style="q2" vid="PSA 45:4">तेरा दाहिना हाथ तुझे भयानक कार्य सिखाए।<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />तेरे तीर तेज़ हैं,</para>
  <para style="q2" vid="PSA 45:5">वे राजा के शत्रुओं के हृदयों को बेधते हैं।</para>
  <para style="q1" vid="PSA 45:5">देश-देश के लोग तेरे सामने गिरते हैं।<verse eid="PSA 45:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />हे परमेश्‍वर, तेरा सिंहासन सदा-सर्वदा</para>
  <para style="q2" vid="PSA 45:6">के लिए स्थिर है।</para>
  <para style="q1" vid="PSA 45:6">तेरे राज्य का राजदंड</para>
  <para style="q2" vid="PSA 45:6">तो न्याय का राजदंड है।<verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />तूने धार्मिकता से प्रेम</para>
  <para style="q2" vid="PSA 45:7">और दुष्‍टता से बैर किया है,</para>
  <para style="q1" vid="PSA 45:7">इसलिए परमेश्‍वर, तेरे परमेश्‍वर ने</para>
  <para style="q2" vid="PSA 45:7">तेरे साथियों से बढ़कर हर्ष के</para>
  <para style="q1" vid="PSA 45:7">तेल से तेरा अभिषेक किया है।<verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />तेरे सब वस्‍त्र गंधरस, अगर,</para>
  <para style="q2" vid="PSA 45:8">और तेजपात से सुगंधित हैं :</para>
  <para style="q1" vid="PSA 45:8">हाथी दाँत के महलों के तारवाले वाद्यों ने</para>
  <para style="q2" vid="PSA 45:8">तुझे आनंदित किया है।<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />तेरी प्रतिष्‍ठित महिलाओं में राजकुमारियाँ भी हैं;</para>
  <para style="q2" vid="PSA 45:9">महारानी तेरे दाहिनी ओर ओपीर के</para>
  <para style="q1" vid="PSA 45:9">सोने से आभूषित होकर खड़ी है।<verse eid="PSA 45:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />हे बेटी, सुन,</para>
  <para style="q2" vid="PSA 45:10">कान लगाकर ध्यान दे :</para>
  <para style="q1" vid="PSA 45:10">अपने लोगों और अपने पिता के</para>
  <para style="q2" vid="PSA 45:10">घर को भूल जा;<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />तब राजा तेरी सुंदरता की चाह करेगा।</para>
  <para style="q2" vid="PSA 45:11">वह तो तेरा प्रभु है,</para>
  <para style="q1" vid="PSA 45:11">उसे दंडवत् कर।<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />सोर की बेटी भेंट लेकर आएगी,</para>
  <para style="q2" vid="PSA 45:12">और प्रजा के धनी लोग</para>
  <para style="q1" vid="PSA 45:12">तेरी कृपा प्राप्‍त करने का प्रयास करेंगे।<verse eid="PSA 45:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13" />महल में राजकुमारी अति शोभायमान है;</para>
  <para style="q2" vid="PSA 45:13">उसके वस्‍त्रों में सोने के बेल-बूटे कढ़े हैं।<verse eid="PSA 45:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14" />बेल-बूटेदार वस्‍त्रों से सुसज्‍जित</para>
  <para style="q2" vid="PSA 45:14">वह राजा के पास पहुँचाई जाएगी;</para>
  <para style="q1" vid="PSA 45:14">उसके पीछे-पीछे उसकी कुँवारी सहेलियाँ</para>
  <para style="q2" vid="PSA 45:14">तेरे पास पहुँचाई जाएँगी।<verse eid="PSA 45:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15" />आनंद और हर्ष के साथ उन्हें पहुँचाया जाएगा;</para>
  <para style="q2" vid="PSA 45:15">और वे राजा के महल में प्रवेश करेंगी।<verse eid="PSA 45:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16" />तेरे पूर्वजों के स्थान पर तेरे पुत्र होंगे;</para>
  <para style="q2" vid="PSA 45:16">तू उन्हें समस्त पृथ्वी पर शासक ठहराएगा।<verse eid="PSA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17" />मैं तेरे नाम को पीढ़ी से पीढ़ी तक स्मरणीय बनाऊँगा;</para>
  <para style="q2" vid="PSA 45:17">इस कारण देश-देश के लोग</para>
  <para style="q1" vid="PSA 45:17">सदा-सर्वदा तेरा धन्यवाद करते रहेंगे।<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s1">परमेश्‍वर हमारा शरणस्थान</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। अलामोत की राग पर कोरहवंशियों का एक गीत।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1" />परमेश्‍वर हमारा शरणस्थान और बल है,</para>
  <para style="q2" vid="PSA 46:1">संकट में अति सहज से मिलनेवाला सहायक।<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />इसलिए हम नहीं डरेंगे,</para>
  <para style="q2" vid="PSA 46:2">चाहे पृथ्वी उलट जाए,</para>
  <para style="q1" vid="PSA 46:2">और पर्वत समुद्र के बीच जा गिरें;<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />चाहे समुद्र गरजे और फेन उठाए,</para>
  <para style="q2" vid="PSA 46:3">और उसके उमड़ने से पर्वत काँप उठें।</para>
  <para style="q1" vid="PSA 46:3">सेला।<verse eid="PSA 46:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />एक नदी है</para>
  <para style="q2" vid="PSA 46:4">जिसकी धाराएँ परमेश्‍वर के नगर को,</para>
  <para style="q1" vid="PSA 46:4">अर्थात् परमप्रधान के पवित्र निवासस्थान को</para>
  <para style="q2" vid="PSA 46:4">आनंदित करती हैं।<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />परमेश्‍वर उस नगर में है,</para>
  <para style="q2" vid="PSA 46:5">वह नगर कभी नहीं टलेगा;</para>
  <para style="q1" vid="PSA 46:5">भोर होते ही परमेश्‍वर उसकी सहायता करेगा।<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />जातियों ने हुल्लड़ मचाया,</para>
  <para style="q2" vid="PSA 46:6">राज्य लड़खड़ाए;</para>
  <para style="q1" vid="PSA 46:6">वह बोल उठा,</para>
  <para style="q2" vid="PSA 46:6">और पृथ्वी पिघल गई।<verse eid="PSA 46:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />सेनाओं का यहोवा हमारे साथ है,</para>
  <para style="q2" vid="PSA 46:7">याकूब का परमेश्‍वर हमारा ऊँचा गढ़ है।</para>
  <para style="q1" vid="PSA 46:7">सेला।<verse eid="PSA 46:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />आओ, यहोवा के कार्यों को देखो</para>
  <para style="q2" vid="PSA 46:8">कि उसने पृथ्वी पर</para>
  <para style="q1" vid="PSA 46:8">कैसे-कैसे अद्भुत कार्य किए<note caller="+" style="f"><char style="fr" closed="false">46:8 </char><char style="ft" closed="false">अद्भुत कार्य — अक्षरशः विनाश</char></note> हैं।<verse eid="PSA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />वह पृथ्वी की छोर तक लड़ाइयों का</para>
  <para style="q2" vid="PSA 46:9">अंत कर देता है,</para>
  <para style="q1" vid="PSA 46:9">वह धनुष को तोड़ता</para>
  <para style="q2" vid="PSA 46:9">और भाले को दो टुकड़े कर डालता है,</para>
  <para style="q1" vid="PSA 46:9">वह रथों को आग में झोंक देता है।<verse eid="PSA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />“शांत हो जाओ, और जान लो</para>
  <para style="q2" vid="PSA 46:10">कि मैं ही परमेश्‍वर हूँ।</para>
  <para style="q1" vid="PSA 46:10">जातियों के मध्य मैं महान ठहरूँगा;</para>
  <para style="q2" vid="PSA 46:10">समस्त पृथ्वी पर भी मैं महान ठहरूँगा।”<verse eid="PSA 46:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11" />सेनाओं का यहोवा हमारे साथ है,</para>
  <para style="q2" vid="PSA 46:11">याकूब का परमेश्‍वर हमारा ऊँचा गढ़ है।</para>
  <para style="q1" vid="PSA 46:11">सेला।<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s1">परमेश्‍वर हमारा राजा है</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। कोरहवंशियों का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1" />हे देश-देश के सब लोगो,</para>
  <para style="q2" vid="PSA 47:1">तालियाँ बजाओ! आनंद से भरकर</para>
  <para style="q1" vid="PSA 47:1">परमेश्‍वर का जय जयकार करो!<verse eid="PSA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />क्योंकि परमप्रधान यहोवा भययोग्य है,</para>
  <para style="q2" vid="PSA 47:2">वह समस्त पृथ्वी का महाराजा है।<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />वह देश-देश को हमारे अधीन,</para>
  <para style="q2" vid="PSA 47:3">और जाति-जाति को</para>
  <para style="q1" vid="PSA 47:3">हमारे पैरों के नीचे कर देता है।<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />वह हमारे लिए हमारी मीरास चुन लेता है,</para>
  <para style="q2" vid="PSA 47:4">जो उसके प्रिय याकूब का गौरव है।</para>
  <para style="q1" vid="PSA 47:4">सेला।<verse eid="PSA 47:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />परमेश्‍वर जय जयकार के साथ, हाँ,</para>
  <para style="q2" vid="PSA 47:5">यहोवा तुरही की आवाज़ के साथ ऊपर गया है।<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />भजन गाओ, परमेश्‍वर का भजन गाओ।</para>
  <para style="q2" vid="PSA 47:6">भजन गाओ, हमारे राजा का भजन गाओ।<verse eid="PSA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />परमेश्‍वर समस्त पृथ्वी का महाराजा है;</para>
  <para style="q2" vid="PSA 47:7">समझ-बूझ के साथ भजन गाओ।<verse eid="PSA 47:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8" />परमेश्‍वर जाति-जाति पर राज्य करता है;</para>
  <para style="q2" vid="PSA 47:8">वह अपने पवित्र सिंहासन पर विराजमान है।<verse eid="PSA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9" />राज्य-राज्य के कुलीन अब्राहम के परमेश्‍वर की</para>
  <para style="q2" vid="PSA 47:9">प्रजा होने के लिए इकट्ठे हुए हैं।</para>
  <para style="q1" vid="PSA 47:9">क्योंकि पृथ्वी की ढालें परमेश्‍वर के वश में हैं,</para>
  <para style="q2" vid="PSA 47:9">वह महान है।<verse eid="PSA 47:9" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s1">सिय्योन का ऊँचा उठाया जाना</para>
  <para style="b" />
  <para style="d">एक गीत। कोरहवंशियों का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1" />हमारे परमेश्‍वर के नगर में यहोवा महान</para>
  <para style="q2" vid="PSA 48:1">और अति स्तुति के योग्य है।<verse eid="PSA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />उसका पवित्र पर्वत ऊँचाई में सुंदर है,</para>
  <para style="q2" vid="PSA 48:2">और सारी पृथ्वी के हर्ष का कारण है।</para>
  <para style="q1" vid="PSA 48:2">राजाधिराज का नगर सिय्योन पर्वत पर स्थित है</para>
  <para style="q2" vid="PSA 48:2">जो उत्तर में है।<verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />परमेश्‍वर को वहाँ के राजमहलों में</para>
  <para style="q2" vid="PSA 48:3">दृढ़ गढ़ माना जाता है।<verse eid="PSA 48:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />देखो, राजा इकट्ठे हुए,</para>
  <para style="q2" vid="PSA 48:4">वे एक साथ आगे बढ़े।<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />उन्होंने देखा, और वे विस्मित हुए;</para>
  <para style="q2" vid="PSA 48:5">वे घबराकर भाग खड़े हुए।<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />वहाँ अत्यंत भय ने उन्हें जा पकड़ा,</para>
  <para style="q2" vid="PSA 48:6">और उन्हें जच्‍चा की सी पीड़ा होने लगी।<verse eid="PSA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7" />तू पूर्वी वायु से तर्शीश के</para>
  <para style="q2" vid="PSA 48:7">जहाज़ों को तोड़ डालता है।<verse eid="PSA 48:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />जैसा सुना था, वैसा ही</para>
  <para style="q2" vid="PSA 48:8">हमने अपने परमेश्‍वर</para>
  <para style="q1" vid="PSA 48:8">अर्थात् सेनाओं के यहोवा के</para>
  <para style="q2" vid="PSA 48:8">नगर में होते देखा है;</para>
  <para style="q1" vid="PSA 48:8">परमेश्‍वर उस नगर को</para>
  <para style="q2" vid="PSA 48:8">सदा दृढ़ बनाए रखेगा।</para>
  <para style="q1" vid="PSA 48:8">सेला।<verse eid="PSA 48:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />हे परमेश्‍वर, हमने तेरे मंदिर के भीतर</para>
  <para style="q2" vid="PSA 48:9">तेरी करुणा पर ध्यान किया है।<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />हे परमेश्‍वर, जैसा तेरा नाम है,</para>
  <para style="q2" vid="PSA 48:10">वैसी ही तेरी स्तुति भी पृथ्वी के</para>
  <para style="q1" vid="PSA 48:10">कोने-कोने तक होती है।</para>
  <para style="q2" vid="PSA 48:10">तेरा दाहिना हाथ धार्मिकता से परिपूर्ण है।<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />तेरे न्याय के कारण सिय्योन पर्वत आनंदित हो,</para>
  <para style="q2" vid="PSA 48:11">और यहूदा की बेटियाँ मगन हों।<verse eid="PSA 48:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />सिय्योन के चारों ओर चलो,</para>
  <para style="q2" vid="PSA 48:12">और उसकी परिक्रमा करो,</para>
  <para style="q1" vid="PSA 48:12">उसके गुम्मटों को गिनो,<verse eid="PSA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13" />उसकी शहरपनाह पर दृष्‍टि लगाओ,</para>
  <para style="q2" vid="PSA 48:13">उसके महलों को ध्यान से देखो</para>
  <para style="q1" vid="PSA 48:13">ताकि तुम आने वाली पीढ़ी से</para>
  <para style="q2" vid="PSA 48:13">इसका वर्णन कर सको।<verse eid="PSA 48:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14" />क्योंकि यह परमेश्‍वर सदा-सर्वदा</para>
  <para style="q2" vid="PSA 48:14">हमारा परमेश्‍वर है।</para>
  <para style="q1" vid="PSA 48:14">वह सदा<note caller="+" style="f"><char style="fr" closed="false">48:14 </char><char style="ft" closed="false">अक्षरशः मृत्यु तक</char></note> हमारी अगुवाई करेगा।<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s1">धन पर भरोसा रखने की मूर्खता</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। कोरहवंशियों का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1" />हे देश-देश के सब लोगो, यह सुनो!</para>
  <para style="q2" vid="PSA 49:1">हे संसार के सब निवासियो,</para>
  <para style="q1" vid="PSA 49:1">कान लगाओ।<verse eid="PSA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2" />क्या बड़े, क्या छोटे, क्या धनी,</para>
  <para style="q2" vid="PSA 49:2">क्या दरिद्र, सब कान लगाओ!<verse eid="PSA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />मेरे मुँह से ज्ञान की बातें निकलेंगी,</para>
  <para style="q2" vid="PSA 49:3">और मेरे हृदय का मनन</para>
  <para style="q1" vid="PSA 49:3">समझ से भरा होगा।<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />मैं नीतिवचन पर अपना कान लगाऊँगा,</para>
  <para style="q2" vid="PSA 49:4">मैं वीणा बजाते हुए</para>
  <para style="q1" vid="PSA 49:4">अपनी भेद भरी बातों को प्रकट करूँगा।<verse eid="PSA 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5" />विपत्ति के दिनों में</para>
  <para style="q2" vid="PSA 49:5">जब मैं अपने विरोधियों के अधर्म से घिरूँ</para>
  <para style="q1" vid="PSA 49:5">तो क्यों डरूँ?<verse eid="PSA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6" />वे तो अपनी संपत्ति पर भरोसा रखते,</para>
  <para style="q2" vid="PSA 49:6">और अपने धन की बहुतायत पर घमंड करते हैं।<verse eid="PSA 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7" />कोई भी मनुष्य मूल्य देकर</para>
  <para style="q2" vid="PSA 49:7">न तो किसी व्यक्‍ति<note caller="+" style="f"><char style="fr" closed="false">49:7 </char><char style="ft" closed="false">अक्षरशः भाई</char></note> को छुड़ा सकता है</para>
  <para style="q1" vid="PSA 49:7">और न उसकी छुड़ौती के लिए</para>
  <para style="q2" vid="PSA 49:7">परमेश्‍वर को कुछ दे सकता है<verse eid="PSA 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8" />(क्योंकि मनुष्य के प्राण की</para>
  <para style="q2" vid="PSA 49:8">छुड़ौती का मूल्य भारी है,</para>
  <para style="q1" vid="PSA 49:8">उसे कभी चुकाया नहीं जा सकता)<verse eid="PSA 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9" />कि वह सदा जीवित रहे,</para>
  <para style="q2" vid="PSA 49:9">और कब्र को न देखे।<verse eid="PSA 49:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />क्योंकि देखने में आता है</para>
  <para style="q2" vid="PSA 49:10">कि बुद्धिमान मनुष्य मरते हैं;</para>
  <para style="q1" vid="PSA 49:10">मूर्ख और पशु समान मनुष्य भी मिट जाते हैं,</para>
  <para style="q2" vid="PSA 49:10">और अपनी संपत्ति दूसरों के लिए छोड़ जाते हैं।<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />वे मन ही मन सोचते हैं</para>
  <para style="q2" vid="PSA 49:11">कि उनके घर सदा बने रहेंगे,</para>
  <para style="q1" vid="PSA 49:11">और उनका निवास पीढ़ी से पीढ़ी</para>
  <para style="q2" vid="PSA 49:11">तक बना रहेगा।</para>
  <para style="q1" vid="PSA 49:11">इसलिए सब अपने नाम पर</para>
  <para style="q2" vid="PSA 49:11">अपनी-अपनी भूमि का नाम रखते हैं।<verse eid="PSA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />परंतु मनुष्य धन-संपत्ति</para>
  <para style="q2" vid="PSA 49:12">पाकर भी बना नहीं रहेगा,</para>
  <para style="q1" vid="PSA 49:12">वह तो पशुओं के समान है,</para>
  <para style="q2" vid="PSA 49:12">जो मर मिटते हैं।<verse eid="PSA 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />मूर्खो का मार्ग ऐसा ही होता है,</para>
  <para style="q2" vid="PSA 49:13">और उनका भी जो उनकी बातों से</para>
  <para style="q1" vid="PSA 49:13">प्रसन्‍न होते हैं।</para>
  <para style="q2" vid="PSA 49:13">सेला।<verse eid="PSA 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />वे उन भेड़ों के समान ठहराए गए हैं</para>
  <para style="q2" vid="PSA 49:14">जिन्हें उनका चरवाहा</para>
  <para style="q1" vid="PSA 49:14">अर्थात् मृत्यु अधोलोक की ओर ले जाता है।</para>
  <para style="q2" vid="PSA 49:14">भोर को सीधे लोग उन पर प्रभुता करेंगे,</para>
  <para style="q1" vid="PSA 49:14">और उनका सुंदर रूप उनके भव्य निवास स्थान से दूर</para>
  <para style="q2" vid="PSA 49:14">अधोलोक में सड़ जाएगा।<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />परंतु परमेश्‍वर मेरे प्राण को</para>
  <para style="q2" vid="PSA 49:15">अधोलोक के वश से छुड़ा लेगा,</para>
  <para style="q1" vid="PSA 49:15">क्योंकि वह मुझे ग्रहण कर लेगा।</para>
  <para style="q2" vid="PSA 49:15">सेला।<verse eid="PSA 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />जब कोई धनी हो जाए</para>
  <para style="q2" vid="PSA 49:16">और उसके घर का वैभव बढ़ जाए,</para>
  <para style="q1" vid="PSA 49:16">तो तू भयभीत न होना।<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />क्योंकि मरने पर वह</para>
  <para style="q2" vid="PSA 49:17">कुछ भी साथ नहीं ले जाएगा,</para>
  <para style="q1" vid="PSA 49:17">और न ही उसका वैभव उसके साथ जाएगा।<verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />चाहे वह अपने जीते जी</para>
  <para style="q2" vid="PSA 49:18">अपनी प्रशंसा करता रहे</para>
  <para style="q1" vid="PSA 49:18">(क्योंकि जब तू संपन्‍न होता है</para>
  <para style="q2" vid="PSA 49:18">तब लोग तेरी प्रशंसा करते हैं),<verse eid="PSA 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19" />फिर भी वह अपने उन पूर्वजों के</para>
  <para style="q2" vid="PSA 49:19">समाज में जा मिलेगा,</para>
  <para style="q1" vid="PSA 49:19">जो कभी उजियाला न देखेंगे।<verse eid="PSA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />समझ के बिना धनी व्यक्‍ति</para>
  <para style="q2" vid="PSA 49:20">उन पशुओं के समान है,</para>
  <para style="q1" vid="PSA 49:20">जो मर मिटते हैं।<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s1">न्यायी परमेश्‍वर</para>
  <para style="b" />
  <para style="d">आसाफ का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1" />सर्वशक्‍तिमान परमेश्‍वर यहोवा की वाणी है;</para>
  <para style="q2" vid="PSA 50:1">उसने उदयाचल से लेकर अस्ताचल तक</para>
  <para style="q1" vid="PSA 50:1">पृथ्वी के लोगों को बुलाया है।<verse eid="PSA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2" />सिय्योन से, जो परम सुंदर है,</para>
  <para style="q2" vid="PSA 50:2">परमेश्‍वर अपने तेज के साथ प्रकट हुआ है।<verse eid="PSA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />हमारा परमेश्‍वर आएगा</para>
  <para style="q2" vid="PSA 50:3">और चुप न रहेगा,</para>
  <para style="q1" vid="PSA 50:3">आग उसके आगे-आगे भस्म करती जाएगी,</para>
  <para style="q2" vid="PSA 50:3">और उसके चारों ओर प्रचंड आँधी चलेगी।<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />वह अपनी प्रजा का न्याय करने के लिए</para>
  <para style="q2" vid="PSA 50:4">ऊपर के आकाश को</para>
  <para style="q1" vid="PSA 50:4">और पृथ्वी को बुलाता है :<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />“मेरे भक्‍तों को मेरे पास इकट्ठा करो,</para>
  <para style="q2" vid="PSA 50:5">जिन्होंने बलिदान चढ़ाकर मेरे साथ वाचा बाँधी है।”<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />आकाश उसकी धार्मिकता की घोषणा करता है,</para>
  <para style="q2" vid="PSA 50:6">क्योंकि परमेश्‍वर स्वयं ही न्यायी है।</para>
  <para style="q1" vid="PSA 50:6">सेला।<verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />“हे मेरी प्रजा, सुन,</para>
  <para style="q2" vid="PSA 50:7">मैं बोलता हूँ; हे इस्राएल,</para>
  <para style="q1" vid="PSA 50:7">मैं तेरे विरुद्ध साक्षी देता हूँ।</para>
  <para style="q2" vid="PSA 50:7">परमेश्‍वर, तेरा परमेश्‍वर,</para>
  <para style="q1" vid="PSA 50:7">मैं ही हूँ।<verse eid="PSA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8" />मैं तेरी बलियों के लिए तुझे नहीं फटकारता,</para>
  <para style="q2" vid="PSA 50:8">तेरी होमबलियाँ तो निरंतर मेरे सम्मुख रहती हैं।<verse eid="PSA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9" />मैं न तो तेरे घर से बछड़ा,</para>
  <para style="q2" vid="PSA 50:9">और न तेरी पशुशालाओं से बकरे लूँगा।<verse eid="PSA 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10" />क्योंकि वन के सारे जीव-जंतु</para>
  <para style="q2" vid="PSA 50:10">और हज़ारों पहाड़ों के पशु तो</para>
  <para style="q1" vid="PSA 50:10">मेरे ही हैं।<verse eid="PSA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11" />मैं पहाड़ों के सब पक्षियों को जानता हूँ,</para>
  <para style="q2" vid="PSA 50:11">और मैदान में चलने-फिरने वाले</para>
  <para style="q1" vid="PSA 50:11">प्राणी मेरे ही हैं।<verse eid="PSA 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12" />यदि मैं भूखा होता</para>
  <para style="q2" vid="PSA 50:12">तो तुझसे न कहता,</para>
  <para style="q1" vid="PSA 50:12">क्योंकि जगत और जो कुछ उसमें है</para>
  <para style="q2" vid="PSA 50:12">वह मेरा ही है।<verse eid="PSA 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13" />क्या मैं बैल का मांस खाऊँ,</para>
  <para style="q2" vid="PSA 50:13">या बकरों का लहू पीऊँ?<verse eid="PSA 50:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14" />परमेश्‍वर को धन्यवाद का बलिदान चढ़ा,</para>
  <para style="q2" vid="PSA 50:14">और परमप्रधान के लिए अपनी मन्‍नतें पूरी कर।<verse eid="PSA 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15" />संकट के दिन मुझे पुकार;</para>
  <para style="q2" vid="PSA 50:15">मैं तुझे छुड़ाऊँगा</para>
  <para style="q1" vid="PSA 50:15">और तू मेरी महिमा करेगा।”<verse eid="PSA 50:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16" />परंतु परमेश्‍वर दुष्‍ट से कहता है :</para>
  <para style="q2" vid="PSA 50:16">मेरी विधियों का वर्णन करने</para>
  <para style="q1" vid="PSA 50:16">और अपने मुँह से</para>
  <para style="q2" vid="PSA 50:16">मेरी वाचा की चर्चा करने का</para>
  <para style="q1" vid="PSA 50:16">तुझे क्या अधिकार है?<verse eid="PSA 50:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17" />तू तो शिक्षा से घृणा करता,</para>
  <para style="q2" vid="PSA 50:17">और मेरे वचनों को तुच्छ जानता है।<verse eid="PSA 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18" />जब तू चोर को देखता है</para>
  <para style="q2" vid="PSA 50:18">तो उसके साथ मिल जाता है,</para>
  <para style="q1" vid="PSA 50:18">और परस्‍त्रीगामियों के साथ सहभागी होता है।<verse eid="PSA 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19" />तूने बुराई के लिए अपना मुँह खोला है,</para>
  <para style="q2" vid="PSA 50:19">और तेरी जीभ छल की बातें गढ़ती है।<verse eid="PSA 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20" />तू बैठा-बैठा अपने भाई</para>
  <para style="q2" vid="PSA 50:20">के विरुद्ध बोलता है;</para>
  <para style="q1" vid="PSA 50:20">तू अपने सगे भाई की निंदा करता है।<verse eid="PSA 50:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21" />तूने ये काम किए,</para>
  <para style="q2" vid="PSA 50:21">पर मैं चुप रहा;</para>
  <para style="q1" vid="PSA 50:21">इसलिए तूने समझ लिया</para>
  <para style="q2" vid="PSA 50:21">कि मैं तेरे ही समान हूँ।</para>
  <para style="q1" vid="PSA 50:21">मैं तुझे फटकारूँगा</para>
  <para style="q2" vid="PSA 50:21">और तेरी आँखों के सामने</para>
  <para style="q1" vid="PSA 50:21">एक-एक करके</para>
  <para style="q2" vid="PSA 50:21">सब कुछ दिखाऊँगा।<verse eid="PSA 50:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22" />“परमेश्‍वर को भूलनेवालो,</para>
  <para style="q2" vid="PSA 50:22">यह बात समझ लो,</para>
  <para style="q1" vid="PSA 50:22">कहीं ऐसा न हो</para>
  <para style="q2" vid="PSA 50:22">कि मैं तुम्हें फाड़ डालूँ,</para>
  <para style="q1" vid="PSA 50:22">और कोई छुड़ानेवाला न हो।<verse eid="PSA 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23" />जो धन्यवाद का बलिदान चढ़ाता है</para>
  <para style="q2" vid="PSA 50:23">वह मेरी महिमा करता है,</para>
  <para style="q1" vid="PSA 50:23">और जो अपना मार्ग सीधा बनाए रखता है,</para>
  <para style="q2" vid="PSA 50:23">उसे मैं परमेश्‍वर का किया हुआ उद्धार दिखाऊँगा।”<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s1">पाप-क्षमा के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन, जब नातान भविष्यवक्‍ता दाऊद के पास आया क्योंकि वह बतशेबा के पास गया था।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />हे परमेश्‍वर, अपनी करुणा के अनुसार</para>
  <para style="q2" vid="PSA 51:1">मुझ पर अनुग्रह कर;</para>
  <para style="q1" vid="PSA 51:1">अपनी बड़ी दया के अनुसार मेरे अपराधों को मिटा दे।<verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />मुझे मेरे अधर्म से पूरी रीति से साफ़ कर,</para>
  <para style="q2" vid="PSA 51:2">और मेरे पाप से मुझे शुद्ध कर।<verse eid="PSA 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />मैं तो अपने अपराधों को जानता हूँ,</para>
  <para style="q2" vid="PSA 51:3">और मेरा पाप निरंतर मेरे सामने रहता है।<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />मैंने तेरे ही विरुद्ध पाप किया है,</para>
  <para style="q2" vid="PSA 51:4">और वह किया है जो तेरी दृष्‍टि में बुरा है;</para>
  <para style="q1" vid="PSA 51:4">इसलिए जब तू निर्णय सुनाए तो धर्मी,</para>
  <para style="q2" vid="PSA 51:4">और न्याय करे तो सच्‍चा ठहरे।<verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />देख, मैं अधर्म के साथ उत्पन्‍न‍ हुआ,</para>
  <para style="q2" vid="PSA 51:5">और पाप के साथ अपनी माता के गर्भ में पड़ा।<verse eid="PSA 51:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />देख, तू हृदय की सच्‍चाई से प्रसन्‍न होता है,</para>
  <para style="q2" vid="PSA 51:6">और मेरे मन में मुझे बुद्धि की बातें सिखाता है।<verse eid="PSA 51:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />जूफे से मुझे शुद्ध कर,</para>
  <para style="q2" vid="PSA 51:7">और मैं पवित्र हो जाऊँगा;</para>
  <para style="q1" vid="PSA 51:7">मुझे धो, और मैं हिम से भी अधिक श्‍वेत हो जाऊँगा।<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />मुझे हर्ष और आनंद की बातें सुना,</para>
  <para style="q2" vid="PSA 51:8">ताकि जो हड्डियाँ तूने तोड़ डाली हैं वे मगन हो जाएँ।<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />अपना मुख मेरे पापों की ओर से फेर ले,</para>
  <para style="q2" vid="PSA 51:9">और मेरे सारे अधर्मों को मिटा डाल।<verse eid="PSA 51:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />हे परमेश्‍वर, मुझमें शुद्ध मन उत्पन्‍न‍ कर,</para>
  <para style="q2" vid="PSA 51:10">और मेरे भीतर स्थिर आत्मा नए सिरे से उत्पन्‍न‍ कर।<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />मुझे अपनी उपस्थिति से दूर न कर,</para>
  <para style="q2" vid="PSA 51:11">और न अपने पवित्र आत्मा को मुझसे अलग कर।<verse eid="PSA 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />अपने उद्धार का आनंद मुझे लौटा दे,</para>
  <para style="q2" vid="PSA 51:12">और सचेत आत्मा देकर मुझे संभाल।<verse eid="PSA 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />तब मैं अपराधियों को तेरे मार्गों की शिक्षा दूँगा,</para>
  <para style="q2" vid="PSA 51:13">और पापी तेरी ओर फिरेंगे।<verse eid="PSA 51:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />हे परमेश्‍वर, हे मेरे उद्धारकर्ता परमेश्‍वर,</para>
  <para style="q2" vid="PSA 51:14">मुझे हत्या के दोष से मुक्‍त कर,</para>
  <para style="q1" vid="PSA 51:14">तब मैं अपने मुँह<note caller="+" style="f"><char style="fr" closed="false">51:14 </char><char style="ft" closed="false">अपने मुँह — अक्षरशः अपनी जीभ</char></note> से तेरी धार्मिकता का जय जयकार करूँगा।<verse eid="PSA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />हे प्रभु, मेरे होंठों को खोल दे</para>
  <para style="q2" vid="PSA 51:15">कि मेरा मुँह तेरी स्तुति करे।<verse eid="PSA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />तू बलि से प्रसन्‍न‍ नहीं होता,</para>
  <para style="q2" vid="PSA 51:16">नहीं तो मैं चढ़ाता;</para>
  <para style="q1" vid="PSA 51:16">तू होमबलि से भी प्रसन्‍न‍ नहीं होता।<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />टूटा मन परमेश्‍वर के योग्य बलिदान है;</para>
  <para style="q2" vid="PSA 51:17">हे परमेश्‍वर, तू टूटे और पिसे हुए</para>
  <para style="q1" vid="PSA 51:17">हृदय को तुच्छ नहीं जानता।<verse eid="PSA 51:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />अपनी कृपा में सिय्योन की भलाई कर,</para>
  <para style="q2" vid="PSA 51:18">और यरूशलेम की शहरपनाह को बना।<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />तब तू धार्मिकता के बलिदानों,</para>
  <para style="q2" vid="PSA 51:19">अर्थात् होमबलि तथा पूर्ण होमबलि से आनंदित होगा;</para>
  <para style="q1" vid="PSA 51:19">और तेरी वेदी पर बैल चढ़ाए जाएँगे।<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s1">परमेश्‍वर घमंडी को दंड देता है</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए दाऊद का मश्कील। जब एदोमी दोएग ने शाऊल के पास जाकर बताया कि दाऊद तो अहीमेलेक के घर गया है।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1" />हे वीर, तू बुराई करने पर क्यों घमंड करता है?</para>
  <para style="q2" vid="PSA 52:1">परमेश्‍वर की करुणा सदा बनी रहती है।<verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />हे छल करनेवाले,</para>
  <para style="q2" vid="PSA 52:2">तेरी जीभ तो विनाश गढ़ती है।</para>
  <para style="q1" vid="PSA 52:2">वह तो पैने उस्तरे के समान है।<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />तू भलाई से अधिक बुराई से,</para>
  <para style="q2" vid="PSA 52:3">और धर्म की बातों से</para>
  <para style="q1" vid="PSA 52:3">अधिक झूठ बोलने से प्रीति रखता है।</para>
  <para style="q2" vid="PSA 52:3">सेला।<verse eid="PSA 52:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />हे छली जीभ,</para>
  <para style="q2" vid="PSA 52:4">तू विनाश करनेवाली सब बातों से प्रीति रखती है।<verse eid="PSA 52:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />परंतु परमेश्‍वर तुझे सदा के लिए नष्‍ट कर देगा।</para>
  <para style="q2" vid="PSA 52:5">वह तुझे पकड़ेगा और तेरे डेरे से तुझे निकाल देगा,</para>
  <para style="q1" vid="PSA 52:5">और जीवितों के लोक से तुझे उखाड़ फेंकेगा। सेला।<verse eid="PSA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />धर्मी लोग यह देखकर डर जाएँगे,</para>
  <para style="q2" vid="PSA 52:6">और यह कहकर उस पर हँसेंगे :<verse eid="PSA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7" />“देखो, यह वही पुरुष है</para>
  <para style="q2" vid="PSA 52:7">जिसने परमेश्‍वर को अपना शरणस्थान नहीं माना,</para>
  <para style="q1" vid="PSA 52:7">बल्कि अपने धन की बहुतायत पर भरोसा रखा,</para>
  <para style="q2" vid="PSA 52:7">और अपनी दुष्‍टता में बढ़ता चला गया।”<verse eid="PSA 52:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8" />परंतु मैं तो परमेश्‍वर के भवन में</para>
  <para style="q2" vid="PSA 52:8">जैतून के हरे-भरे वृक्ष के समान हूँ।</para>
  <para style="q1" vid="PSA 52:8">मैं सदा परमेश्‍वर की करुणा पर भरोसा रखता हूँ।<verse eid="PSA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9" />मैं सदा तेरा धन्यवाद करता रहूँगा,</para>
  <para style="q2" vid="PSA 52:9">क्योंकि तूने ही यह कार्य किया है।</para>
  <para style="q1" vid="PSA 52:9">तेरे पवित्र भक्‍तों के सामने मुझे</para>
  <para style="q2" vid="PSA 52:9">तेरे ही नाम की आस होगी,</para>
  <para style="q1" vid="PSA 52:9">क्योंकि वह अच्छा है।<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s1">पापियों का चित्रण</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। महलत की राग पर दाऊद का मश्कील।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1" />मूर्ख अपने मन में कहता है,</para>
  <para style="q2" vid="PSA 53:1">“परमेश्‍वर है ही नहीं।”</para>
  <para style="q1" vid="PSA 53:1">वे भ्रष्‍ट हैं,</para>
  <para style="q2" vid="PSA 53:1">और अधर्म के घृणित कार्य करते हैं।</para>
  <para style="q1" vid="PSA 53:1">ऐसा कोई नहीं जो भलाई करता हो।<verse eid="PSA 53:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2" />परमेश्‍वर स्वर्ग से मनुष्यों पर दृष्‍टि करता है</para>
  <para style="q2" vid="PSA 53:2">कि देखे कि कोई बुद्धिमान,</para>
  <para style="q1" vid="PSA 53:2">कोई परमेश्‍वर का खोजी है या नहीं।<verse eid="PSA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />वे सब भटक गए,</para>
  <para style="q2" vid="PSA 53:3">सब के सब भ्रष्‍ट हो गए हैं;</para>
  <para style="q1" vid="PSA 53:3">कोई भलाई करनेवाला नहीं,</para>
  <para style="q2" vid="PSA 53:3">एक भी नहीं।<verse eid="PSA 53:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />क्या बुराई करनेवाले नासमझ हैं?</para>
  <para style="q2" vid="PSA 53:4">वे मेरे लोगों को ऐसे खा जाते हैं</para>
  <para style="q1" vid="PSA 53:4">जैसे रोटी खाते हों,</para>
  <para style="q2" vid="PSA 53:4">और परमेश्‍वर का नाम भी नहीं लेते।<verse eid="PSA 53:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />जहाँ भय का कोई कारण न था,</para>
  <para style="q2" vid="PSA 53:5">वहाँ उन पर भय छा गया,</para>
  <para style="q1" vid="PSA 53:5">क्योंकि परमेश्‍वर ने उन लोगों की हड्डियों को</para>
  <para style="q2" vid="PSA 53:5">तितर-बितर कर दिया जो</para>
  <para style="q1" vid="PSA 53:5">तेरे विरुद्ध छावनी डाले थे।</para>
  <para style="q2" vid="PSA 53:5">तूने उन्हें लज्‍जित कर दिया,</para>
  <para style="q1" vid="PSA 53:5">क्योंकि परमेश्‍वर ने उन्हें त्याग दिया था।<verse eid="PSA 53:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />कितना अच्छा हो कि इस्राएल का</para>
  <para style="q2" vid="PSA 53:6">उद्धार सिय्योन से प्रकट हो!</para>
  <para style="q1" vid="PSA 53:6">जब परमेश्‍वर अपनी प्रजा को बंधुआई से लौटा लाएगा,</para>
  <para style="q2" vid="PSA 53:6">तब याकूब मगन और इस्राएल आनंदित होगा।<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s1">छुटकारे के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। तारवाले वाद्य-यंत्रों के साथ दाऊद का मश्कील। जब जीपियों ने आकर शाऊल से कहा, “क्या दाऊद हमारे बीच में छिपा नहीं रहता?”</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1" />हे परमेश्‍वर, अपने नाम के द्वारा मुझे बचा,</para>
  <para style="q2" vid="PSA 54:1">और अपने पराक्रम से मेरा न्याय कर।<verse eid="PSA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2" />हे परमेश्‍वर, मेरी प्रार्थना सुन,</para>
  <para style="q2" vid="PSA 54:2">मेरे मुँह के वचनों पर कान लगा।<verse eid="PSA 54:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3" />क्योंकि परदेशी मेरे विरुद्ध उठ खड़े हुए हैं,</para>
  <para style="q2" vid="PSA 54:3">और निर्दयी मनुष्य मेरे प्राण के पीछे पड़े हैं।</para>
  <para style="q1" vid="PSA 54:3">वे परमेश्‍वर को अपने सम्मुख नहीं रखते। सेला।<verse eid="PSA 54:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4" />देखो, परमेश्‍वर मेरा सहायक है;</para>
  <para style="q2" vid="PSA 54:4">प्रभु मेरे प्राण का संभालनेवाला है।<verse eid="PSA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />वह मेरे शत्रुओं की बुराइयों को उन्हीं पर लौटा देगा।</para>
  <para style="q2" vid="PSA 54:5">हे परमेश्‍वर, अपनी सच्‍चाई के कारण उनका नाश कर।<verse eid="PSA 54:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />मैं तुझे स्वेच्छाबलि चढ़ाऊँगा।</para>
  <para style="q2" vid="PSA 54:6">हे यहोवा, मैं तेरे नाम का धन्यवाद करूँगा,</para>
  <para style="q1" vid="PSA 54:6">क्योंकि यह भला है।<verse eid="PSA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />उसने मुझे सब संकटों से छुड़ाया है,</para>
  <para style="q2" vid="PSA 54:7">और मेरी आँखों ने मेरे शत्रुओं की पराजय को देखा है।<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s1">मित्र के द्वारा विश्‍वासघात</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। तारवाले वाद्य-यंत्रों के साथ दाऊद का मश्कील।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1" />हे परमेश्‍वर, मेरी प्रार्थना पर कान लगा,</para>
  <para style="q2" vid="PSA 55:1">और मेरी विनती को अनसुना न कर।<verse eid="PSA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2" />मेरी ओर ध्यान दे और मुझे उत्तर दे।</para>
  <para style="q2" vid="PSA 55:2">चिंता के कारण मैं बेचैन और व्याकुल हूँ।<verse eid="PSA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3" />क्योंकि शत्रु कोलाहल मचाते हैं,</para>
  <para style="q2" vid="PSA 55:3">और दुष्‍ट अत्याचार करते हैं;</para>
  <para style="q1" vid="PSA 55:3">वे मुझे विपत्ति में डालते हैं</para>
  <para style="q2" vid="PSA 55:3">और क्रोध में आकर मुझे सताते हैं।<verse eid="PSA 55:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />मेरा मन भीतर ही भीतर तड़पता है,</para>
  <para style="q2" vid="PSA 55:4">और मृत्यु का भय मुझमें समा गया है।<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />भय और कँपकँपी ने मुझे जकड़ लिया है,</para>
  <para style="q2" vid="PSA 55:5">और डर ने मुझे धर दबोचा है।<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />तब मैंने कहा, “भला होता कि कबूतर के समान</para>
  <para style="q2" vid="PSA 55:6">मेरे भी पंख होते,</para>
  <para style="q1" vid="PSA 55:6">और मैं उड़ जाता,</para>
  <para style="q2" vid="PSA 55:6">और विश्राम पाता।<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />देखो, फिर तो मैं उड़ते-उड़ते दूर निकल जाता,</para>
  <para style="q2" vid="PSA 55:7">और जंगल में बसेरा करता। सेला।<verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />मैं प्रचंड वायु और आँधी से</para>
  <para style="q2" vid="PSA 55:8">बचकर अपने शरणस्थान में भाग जाता।”<verse eid="PSA 55:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />हे प्रभु, उन्हें नष्‍ट कर दे,</para>
  <para style="q2" vid="PSA 55:9">और उनकी भाषा में गड़बड़ी डाल,</para>
  <para style="q1" vid="PSA 55:9">क्योंकि मैंने नगर में हिंसा और उपद्रव देखा है।<verse eid="PSA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />दिन और रात वे उसकी शहरपनाह पर चढ़कर</para>
  <para style="q2" vid="PSA 55:10">चारों ओर घूमते रहते हैं;</para>
  <para style="q1" vid="PSA 55:10">उसके भीतर दुष्‍टता और उत्पात हैं।<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />उसके भीतर विनाश है;</para>
  <para style="q2" vid="PSA 55:11">और अत्याचार तथा छल उसके चौक से</para>
  <para style="q1" vid="PSA 55:11">कभी दूर नहीं होते।<verse eid="PSA 55:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />मेरी बदनामी करनेवाला मेरा शत्रु नहीं है,</para>
  <para style="q2" vid="PSA 55:12">नहीं तो मैं सह लेता;</para>
  <para style="q1" vid="PSA 55:12">और न ही वह मेरा बैरी है</para>
  <para style="q2" vid="PSA 55:12">जो मेरे विरुद्ध डींग मारता है,</para>
  <para style="q1" vid="PSA 55:12">नहीं तो मैं उससे छिप जाता।<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />परंतु वह तो तू ही है,</para>
  <para style="q2" vid="PSA 55:13">जो मेरी बराबरी का मनुष्य,</para>
  <para style="q1" vid="PSA 55:13">और मेरा साथी तथा परममित्र है।<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />हम आपस में मधुर संगति रखते थे;</para>
  <para style="q2" vid="PSA 55:14">हम भीड़ के साथ परमेश्‍वर के भवन जाते थे।<verse eid="PSA 55:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15" />उन्हें मृत्यु अचानक आ दबाए;</para>
  <para style="q2" vid="PSA 55:15">वे जीवित ही अधोलोक में उतर जाएँ,</para>
  <para style="q1" vid="PSA 55:15">क्योंकि उनके घर और मन में दुष्‍टता भरी है।<verse eid="PSA 55:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16" />परंतु मैं तो परमेश्‍वर को पुकारूँगा;</para>
  <para style="q2" vid="PSA 55:16">और यहोवा मुझे बचा लेगा।<verse eid="PSA 55:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17" />मैं साँझ, भोर, और दोपहर को दुहाई दूँगा</para>
  <para style="q2" vid="PSA 55:17">और गिड़गिड़ाता रहूँगा, और वह मेरी आवाज़ सुन लेगा।<verse eid="PSA 55:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18" />भले ही मुझसे लड़नेवाले बहुत हैं,</para>
  <para style="q2" vid="PSA 55:18">फिर भी वह मेरे विरुद्ध छिड़े हुए</para>
  <para style="q1" vid="PSA 55:18">युद्ध से मेरे प्राण को सकुशल छुड़ा लेगा।<verse eid="PSA 55:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19" />परमेश्‍वर, जो सनातन से सिंहासन पर विराजमान है,</para>
  <para style="q2" vid="PSA 55:19">सुनेगा और उन्हें उत्तर देगा।</para>
  <para style="q1" vid="PSA 55:19">सेला।</para>
  <para style="q2" vid="PSA 55:19">उनमें कोई परिवर्तन नहीं,</para>
  <para style="q1" vid="PSA 55:19">और न उनमें परमेश्‍वर का कोई भय है।<verse eid="PSA 55:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20" />उसने उन्हीं के विरुद्ध हाथ उठाया है</para>
  <para style="q2" vid="PSA 55:20">जिनका उसके साथ मेल-मिलाप था;</para>
  <para style="q1" vid="PSA 55:20">उसने अपनी वाचा को तोड़ दिया है।<verse eid="PSA 55:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21" />उसकी बातें तो मक्खन सी चिकनी थीं</para>
  <para style="q2" vid="PSA 55:21">परंतु उसके मन में लड़ाई थी;</para>
  <para style="q1" vid="PSA 55:21">उसकी बातें तेल से अधिक नरम थीं</para>
  <para style="q2" vid="PSA 55:21">पर वास्तव में वे नंगी तलवारें थीं।<verse eid="PSA 55:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22" />अपना बोझ यहोवा पर डाल दे</para>
  <para style="q2" vid="PSA 55:22">और वही तुझे संभालेगा;</para>
  <para style="q1" vid="PSA 55:22">वह धर्मी को कभी टलने नहीं देगा।<verse eid="PSA 55:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23" />परंतु हे परमेश्‍वर, तू उन्हें विनाश के गड्‌ढे में डाल देगा;</para>
  <para style="q2" vid="PSA 55:23">हत्यारे और कपटी मनुष्य अपनी आधी आयु तक भी जीवित न रहेंगे,</para>
  <para style="q1" vid="PSA 55:23">परंतु मैं तो तुझ पर भरोसा रखे रहूँगा।<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s1">सुरक्षा के लिए परमेश्‍वर से प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। योनात<note caller="+" style="f"><char style="fr" closed="false">56:0 </char><char style="ft" closed="false">अर्थात् दूर देश की मूक कबूतरी</char></note>-एलम-रखोकीम राग पर दाऊद का मिक्‍ताम। जब पलिश्तियों ने उसे गत नगर में पकड़ा था।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1" />हे परमेश्‍वर, मुझ पर अनुग्रह कर,</para>
  <para style="q2" vid="PSA 56:1">क्योंकि मनुष्य मुझे कुचलता है,</para>
  <para style="q1" vid="PSA 56:1">और वह दिन भर लड़कर मुझे सताता है।<verse eid="PSA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2" />मेरे शत्रु दिन भर मुझे कुचलते रहते हैं,</para>
  <para style="q2" vid="PSA 56:2">सचमुच जो अहंकार से भरकर मुझसे लड़ते हैं वे बहुत हैं।<verse eid="PSA 56:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />जब मुझे डर लगेगा,</para>
  <para style="q2" vid="PSA 56:3">तो मैं अपना भरोसा तुझ पर रखूँगा।<verse eid="PSA 56:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4" />मैंने उसी परमेश्‍वर पर भरोसा रखा है,</para>
  <para style="q2" vid="PSA 56:4">जिसके वचन की मैं प्रशंसा करता हूँ;</para>
  <para style="q1" vid="PSA 56:4">मैं न डरूँगा। मनुष्य मेरा क्या बिगाड़ सकता है?<verse eid="PSA 56:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />वे दिन भर मेरे वचन को तोड़ते-मरोड़ते रहते हैं।</para>
  <para style="q2" vid="PSA 56:5">उनके सारे विचार मेरी हानि के लिए ही होते हैं।<verse eid="PSA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />वे सब इकट्ठा होते हैं</para>
  <para style="q2" vid="PSA 56:6">और छिपकर बैठते हैं;</para>
  <para style="q1" vid="PSA 56:6">जब वे मेरे प्राणों की ताक में बैठते हैं</para>
  <para style="q2" vid="PSA 56:6">तो मेरे कदमों की टोह लेते हैं।<verse eid="PSA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />क्या वे बुराई करके भी बच जाएँगे?</para>
  <para style="q2" vid="PSA 56:7">हे परमेश्‍वर, अपने क्रोध से देश-देश के लोगों को गिरा दे!<verse eid="PSA 56:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />तूने मेरे भटकते फिरने का हिसाब रखा है।</para>
  <para style="q2" vid="PSA 56:8">मेरे आँसुओं को अपनी कुप्पी में रख ले;</para>
  <para style="q1" vid="PSA 56:8">क्या उनकी चर्चा तेरी पुस्तक में नहीं है?<verse eid="PSA 56:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9" />जिस दिन मैं पुकारूँगा,</para>
  <para style="q2" vid="PSA 56:9">उसी दिन मेरे शत्रु पीठ दिखाकर भाग जाएँगे;</para>
  <para style="q1" vid="PSA 56:9">मैं यह जानता हूँ कि परमेश्‍वर मेरी ओर है।<verse eid="PSA 56:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10" />वह परमेश्‍वर है जिसके वचन की मैं प्रशंसा करता हूँ;</para>
  <para style="q2" vid="PSA 56:10">वह यहोवा है जिसके वचन की मैं प्रशंसा करता हूँ।<verse eid="PSA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />परमेश्‍वर पर ही मैंने भरोसा रखा है;</para>
  <para style="q2" vid="PSA 56:11">मैं न डरूँगा। मनुष्य मेरा क्या बिगाड़ सकता है?<verse eid="PSA 56:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />हे परमेश्‍वर, जो मन्‍नतें मैंने तेरे सामने मानी हैं</para>
  <para style="q2" vid="PSA 56:12">उनसे मैं बंधा हुआ हूँ।</para>
  <para style="q1" vid="PSA 56:12">मैं तुझे धन्यवाद का बलिदान चढ़ाऊँगा,<verse eid="PSA 56:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13" />क्योंकि तूने मेरे प्राण को मृत्यु से छुड़ाया है,</para>
  <para style="q2" vid="PSA 56:13">और मेरे पैरों को ठोकर खाने से बचाया है</para>
  <para style="q1" vid="PSA 56:13">कि मैं परमेश्‍वर के सम्मुख जीवितों के प्रकाश में चलूँ।<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s1">सुरक्षा पाने के लिए परमेश्‍वर से प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। अल तशहेत की राग पर दाऊद का मिक्‍ताम। जब दाऊद शाऊल से भागकर गुफा में छिप गया था।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1" />हे परमेश्‍वर, मुझ पर अनुग्रह कर!</para>
  <para style="q2" vid="PSA 57:1">मुझ पर अनुग्रह कर</para>
  <para style="q1" vid="PSA 57:1">क्योंकि मैं तेरा शरणागत हूँ;</para>
  <para style="q2" vid="PSA 57:1">और जब तक ये विपत्तियाँ दूर न हो जाएँ,</para>
  <para style="q1" vid="PSA 57:1">मैं तेरे पंखों की छाया में शरण लिए रहूँगा।<verse eid="PSA 57:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />मैं परमप्रधान परमेश्‍वर को पुकारूँगा;</para>
  <para style="q2" vid="PSA 57:2">मैं परमेश्‍वर को पुकारूँगा,</para>
  <para style="q1" vid="PSA 57:2">जो मेरे लिए सब कुछ पूर्ण करता है।<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />वह स्वर्ग से सहायता भेजकर मुझे बचा लेगा;</para>
  <para style="q2" vid="PSA 57:3">वह उसे अपमानित करता है</para>
  <para style="q1" vid="PSA 57:3">जो मुझे कुचलता है।</para>
  <para style="q2" vid="PSA 57:3">सेला।</para>
  <para style="q1" vid="PSA 57:3">परमेश्‍वर अपनी करुणा और सच्‍चाई को भेजेगा।<verse eid="PSA 57:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />मेरा प्राण सिंहों के बीच में है।</para>
  <para style="q2" vid="PSA 57:4">मुझे उन लोगों के बीच लेटना पड़ता है</para>
  <para style="q1" vid="PSA 57:4">जो मनुष्यों को निगल जाते हैं,</para>
  <para style="q2" vid="PSA 57:4">अर्थात् ऐसे मनुष्यों के बीच</para>
  <para style="q1" vid="PSA 57:4">जिनके दाँत भाले और तीर के समान हैं</para>
  <para style="q2" vid="PSA 57:4">और जिनकी जीभ तेज़ तलवार है।<verse eid="PSA 57:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />हे परमेश्‍वर, स्वर्ग के ऊपर तू अति महान हो;</para>
  <para style="q2" vid="PSA 57:5">तेरी महिमा सारी पृथ्वी पर फैल जाए!<verse eid="PSA 57:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />उन्होंने मेरे पैरों के लिए जाल बिछाया है,</para>
  <para style="q2" vid="PSA 57:6">मेरा प्राण ढला जाता है।</para>
  <para style="q1" vid="PSA 57:6">उन्होंने मेरे आगे गड्‌ढा खोदा,</para>
  <para style="q2" vid="PSA 57:6">पर वे स्वयं उसमें गिर पड़े। सेला।<verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />मेरा मन स्थिर है,</para>
  <para style="q2" vid="PSA 57:7">हे परमेश्‍वर, मेरा मन स्थिर है।</para>
  <para style="q1" vid="PSA 57:7">मैं गाऊँगा, हाँ, मैं स्तुति के भजन गाऊँगा।<verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />हे मेरी आत्मा जाग जा!</para>
  <para style="q2" vid="PSA 57:8">हे सारंगी और वीणा जाग जाओ!</para>
  <para style="q1" vid="PSA 57:8">मैं भी भोर होते ही जाग उठूँगा।<verse eid="PSA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />हे प्रभु, मैं जाति-जाति के लोगों के बीच</para>
  <para style="q2" vid="PSA 57:9">तेरा धन्यवाद करूँगा;</para>
  <para style="q1" vid="PSA 57:9">मैं देश-देश के लोगों के बीच</para>
  <para style="q2" vid="PSA 57:9">तेरा भजन गाऊँगा।<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />क्योंकि तेरी करुणा स्वर्ग तक बड़ी है,</para>
  <para style="q2" vid="PSA 57:10">और तेरी सच्‍चाई आकाशमंडल तक पहुँचती है।<verse eid="PSA 57:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />हे परमेश्‍वर, स्वर्ग के ऊपर तू अति महान हो;</para>
  <para style="q2" vid="PSA 57:11">तेरी महिमा सारी पृथ्वी पर फैल जाए!<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s1">अन्याय के विरुद्ध पुकार</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। अल तशहेत की राग पर दाऊद का मिक्‍ताम।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1" />हे शासको, क्या तुम सचमुच</para>
  <para style="q2" vid="PSA 58:1">धर्म की बात बोलते हो?</para>
  <para style="q1" vid="PSA 58:1">हे मनुष्यो, क्या तुम खराई से न्याय करते हो?<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />नहीं, तुम अपने मन में कुटिल कार्य करते हो;</para>
  <para style="q2" vid="PSA 58:2">तुम देश भर में हिंसा करते रहते हो।<verse eid="PSA 58:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />दुष्‍ट लोग गर्भ से ही पराए हो जाते हैं,</para>
  <para style="q2" vid="PSA 58:3">और जन्म से ही</para>
  <para style="q1" vid="PSA 58:3">वे झूठ बोलते हुए भटक जाते हैं।<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />उनमें सर्प का सा विष है,</para>
  <para style="q2" vid="PSA 58:4">वे बहरे नाग के समान हैं,</para>
  <para style="q1" vid="PSA 58:4">जो अपने कान बंद कर लेता है;<verse eid="PSA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5" />और सपेरे की नहीं सुनता,</para>
  <para style="q2" vid="PSA 58:5">चाहे सपेरा मंत्र पढ़ने में कितना ही</para>
  <para style="q1" vid="PSA 58:5">कुशल क्यों न हो।<verse eid="PSA 58:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />हे परमेश्‍वर, उनके मुँह के दाँतों को तोड़ डाल।</para>
  <para style="q2" vid="PSA 58:6">हे यहोवा, उन जवान सिंहों की</para>
  <para style="q1" vid="PSA 58:6">दाढ़ों को उखाड़ दे!<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />वे बहते हुए पानी के समान विलीन हो जाएँ;</para>
  <para style="q2" vid="PSA 58:7">जब वे अपने तीर चढ़ाएँ,</para>
  <para style="q1" vid="PSA 58:7">तो उनके तीर नोक-रहित हो जाएँ।<verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />वे घोंघे के समान हो जाएँ</para>
  <para style="q2" vid="PSA 58:8">जो चलते-चलते गल जाता है,</para>
  <para style="q1" vid="PSA 58:8">और स्‍त्री के गिरे हुए गर्भ के समान</para>
  <para style="q2" vid="PSA 58:8">वे सूर्य को न देख सकें।<verse eid="PSA 58:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />इससे पहले कि तुम्हारी हाँड़ियों पर</para>
  <para style="q2" vid="PSA 58:9">हरी या सूखी झाड़ियों की आँच लगे,</para>
  <para style="q1" vid="PSA 58:9">वह उन्हें बवंडर से उड़ा ले जाएगा।<verse eid="PSA 58:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />धर्मी ऐसा पलटा देखकर आनंदित होगा।</para>
  <para style="q2" vid="PSA 58:10">वह अपने पैरों को दुष्‍ट के लहू से धोएगा।<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />तब मनुष्य कहेंगे,</para>
  <para style="q2" vid="PSA 58:11">“निश्‍चय धर्मी को फल मिलता है;</para>
  <para style="q1" vid="PSA 58:11">निश्‍चय परमेश्‍वर है,</para>
  <para style="q2" vid="PSA 58:11">जो पृथ्वी पर न्याय करता है।”<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s1">परमेश्‍वर हमारा दृढ़ गढ़ है</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। अल तशहेत की राग पर दाऊद का मिक्‍ताम। जब शाऊल के भेजे हुए लोगों ने दाऊद को मार डालने के लिए उसके घर को घेर लिया था।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1" />हे मेरे परमेश्‍वर, मुझे मेरे शत्रुओं से छुड़ा;</para>
  <para style="q2" vid="PSA 59:1">मुझे ऊँचे स्थान पर रखकर</para>
  <para style="q1" vid="PSA 59:1">विरोधियों से मेरी रक्षा कर।<verse eid="PSA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2" />मुझे बुराई करनेवालों से छुड़ा;</para>
  <para style="q2" vid="PSA 59:2">और हत्यारे मनुष्यों से मुझे बचा ले।<verse eid="PSA 59:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3" />क्योंकि देख, वे मेरी घात में हैं।</para>
  <para style="q2" vid="PSA 59:3">हे यहोवा, मेरा कोई अपराध या दोष नहीं है</para>
  <para style="q1" vid="PSA 59:3">फिर भी ये हिंसक लोग मेरे विरुद्ध इकट्ठे होते हैं।<verse eid="PSA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4" />मैं निर्दोष हूँ,</para>
  <para style="q2" vid="PSA 59:4">पर वे तुरंत मुझसे लड़ने को तैयार हो जाते हैं।</para>
  <para style="q1" vid="PSA 59:4">मेरी सहायता के लिए जाग और यह देख!<verse eid="PSA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />हे सेनाओं के परमेश्‍वर यहोवा,</para>
  <para style="q2" vid="PSA 59:5">हे इस्राएल के परमेश्‍वर!</para>
  <para style="q1" vid="PSA 59:5">सब अन्यजातियों को दंड देने के लिए जाग!</para>
  <para style="q2" vid="PSA 59:5">किसी विश्‍वासघात करनेवाले कुकर्मी पर अनुग्रह न कर। सेला।<verse eid="PSA 59:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />वे साँझ को लौटकर कुत्ते के समान गुर्राते हैं,</para>
  <para style="q2" vid="PSA 59:6">और नगर के चारों ओर घूमते हैं।<verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />देख, वे अपने मुँह से जहर उगलते हैं,</para>
  <para style="q2" vid="PSA 59:7">उनके मुँह के भीतर तलवारें हैं।</para>
  <para style="q1" vid="PSA 59:7">वे कहते हैं, “कौन सुनता है?”<verse eid="PSA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />परंतु हे यहोवा, तू उन पर हँसेगा;</para>
  <para style="q2" vid="PSA 59:8">तू सब अन्यजातियों को ठट्ठों में उड़ाएगा।<verse eid="PSA 59:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />हे मेरे बल, मुझे तेरी ही आस होगी;</para>
  <para style="q2" vid="PSA 59:9">क्योंकि परमेश्‍वर मेरा ऊँचा गढ़ है।<verse eid="PSA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10" />मेरा परमेश्‍वर अपनी करुणा में मुझसे मिलेगा;</para>
  <para style="q2" vid="PSA 59:10">परमेश्‍वर ऐसा करेगा कि मैं अपने शत्रुओं की पराजय देखूँ।<verse eid="PSA 59:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />उन्हें घात न कर,</para>
  <para style="q2" vid="PSA 59:11">ऐसा न हो कि मेरी प्रजा भूल जाए।</para>
  <para style="q1" vid="PSA 59:11">हे प्रभु, हे हमारी ढाल,</para>
  <para style="q2" vid="PSA 59:11">अपने सामर्थ्य से उन्हें तितर-बितर कर,</para>
  <para style="q1" vid="PSA 59:11">और उन्हें गिरा दे।<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12" />वे अपने मुँह के पाप</para>
  <para style="q2" vid="PSA 59:12">और होठों के शब्दों के कारण,</para>
  <para style="q1" vid="PSA 59:12">तथा अपने शाप देने</para>
  <para style="q2" vid="PSA 59:12">और झूठ बोलने के कारण अपने अभिमान में पकड़े जाएँ।<verse eid="PSA 59:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13" />अपने प्रकोप से उनका विनाश कर,</para>
  <para style="q2" vid="PSA 59:13">हाँ, उनका विनाश कर जिससे उनका अंत हो जाए,</para>
  <para style="q1" vid="PSA 59:13">और समस्त पृथ्वी के लोग यह जानें</para>
  <para style="q2" vid="PSA 59:13">कि परमेश्‍वर याकूब पर राज्य करता है। सेला।<verse eid="PSA 59:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />वे साँझ को लौटकर कुत्ते के समान गुर्राते हैं,</para>
  <para style="q2" vid="PSA 59:14">और नगर के चारों ओर घूमते हैं।<verse eid="PSA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15" />वे रोटी के लिए मारे-मारे फिरते हैं,</para>
  <para style="q2" vid="PSA 59:15">और तृप्‍त न होने पर रात भर गुर्राते हैं।<verse eid="PSA 59:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16" />परंतु मैं तेरे सामर्थ्य का गीत गाऊँगा,</para>
  <para style="q2" vid="PSA 59:16">और भोर को तेरी करुणा का जय जयकार करूँगा,</para>
  <para style="q1" vid="PSA 59:16">क्योंकि तू मेरा ऊँचा गढ़ है,</para>
  <para style="q2" vid="PSA 59:16">और संकट के समय मेरा शरणस्थान है।<verse eid="PSA 59:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17" />हे मेरे बल, मैं तेरा भजन गाऊँगा,</para>
  <para style="q2" vid="PSA 59:17">क्योंकि हे परमेश्‍वर, तू मेरा ऊँचा गढ़</para>
  <para style="q1" vid="PSA 59:17">और मेरा करुणामय परमेश्‍वर है।<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s1">कठिन समयों में प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। शूशनेदूत की राग पर दाऊद का शिक्षादायक मिक्‍ताम। जब वह अरम-नहरैम और अरम-सोबाह से लड़ रहा था, और योआब ने लौटकर लोन की तराई में एदोमियों के बारह हज़ार पुरुषों को मार डाला था।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1" />हे परमेश्‍वर, तूने हमें त्याग दिया है,</para>
  <para style="q2" vid="PSA 60:1">और हमें तोड़ डाला है;</para>
  <para style="q1" vid="PSA 60:1">तू हम पर क्रोधित हुआ है।</para>
  <para style="q2" vid="PSA 60:1">अब हमें फिर से स्थापित कर।<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />तूने भूमि को कँपा दिया</para>
  <para style="q2" vid="PSA 60:2">और उसे फाड़ डाला है।</para>
  <para style="q1" vid="PSA 60:2">उसकी दरारों को भर दे,</para>
  <para style="q2" vid="PSA 60:2">क्योंकि वह डगमगा रही है।<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />तूने अपनी प्रजा का कठिनाइयों से सामना कराया है;</para>
  <para style="q2" vid="PSA 60:3">तूने हमें लड़खड़ा देनेवाली मदिरा पिलाई है।<verse eid="PSA 60:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />तूने अपने भय माननेवालों को संकेत स्वरूप एक झंडा दिया है</para>
  <para style="q2" vid="PSA 60:4">ताकि वे विनाश से पहले बच निकलें। सेला।<verse eid="PSA 60:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />तू अपने दाहिने हाथ के द्वारा हमें बचा,</para>
  <para style="q2" vid="PSA 60:5">और हमारी सुन ले कि तेरे प्रिय छुड़ाए जाएँ।<verse eid="PSA 60:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />परमेश्‍वर ने अपनी पवित्रता में कहा,</para>
  <para style="q2" vid="PSA 60:6">“मैं हर्षित होऊँगा;</para>
  <para style="q1" vid="PSA 60:6">मैं शकेम को बाँट दूँगा,</para>
  <para style="q2" vid="PSA 60:6">और सुक्‍कोत की तराई को नापूँगा।<verse eid="PSA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7" />गिलाद मेरा है,</para>
  <para style="q2" vid="PSA 60:7">मनश्शे भी मेरा है;</para>
  <para style="q1" vid="PSA 60:7">और एप्रैम मेरे सिर का टोप है,</para>
  <para style="q2" vid="PSA 60:7">यहूदा मेरा राजदंड है।<verse eid="PSA 60:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8" />मोआब मेरे पैर धोने का बरतन है;</para>
  <para style="q2" vid="PSA 60:8">मैं एदोम पर अपना जूता फेंकूँगा;</para>
  <para style="q1" vid="PSA 60:8">मैं पलिश्त पर जय की घोषणा करूँगा।”<verse eid="PSA 60:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />मुझे गढ़ वाले नगर में कौन पहुँचाएगा?</para>
  <para style="q2" vid="PSA 60:9">एदोम तक मेरी अगुवाई कौन करेगा?<verse eid="PSA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10" />हे परमेश्‍वर, क्या तूने हमें त्याग नहीं दिया?</para>
  <para style="q2" vid="PSA 60:10">हे परमेश्‍वर, तू तो हमारी सेनाओं के साथ नहीं जाता।<verse eid="PSA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11" />शत्रु के विरुद्ध हमारी सहायता कर,</para>
  <para style="q2" vid="PSA 60:11">क्योंकि मनुष्य का किया हुआ छुटकारा व्यर्थ होता है।<verse eid="PSA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12" />परमेश्‍वर के साथ होकर हम वीरता दिखाएँगे;</para>
  <para style="q2" vid="PSA 60:12">और वही हमारे शत्रुओं को रौंदेगा।<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s1">परमेश्‍वर में सुरक्षा</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। तारवाले वाद्य-यंत्रों के साथ दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1" />हे परमेश्‍वर, मेरी पुकार सुन,</para>
  <para style="q2" vid="PSA 61:1">मेरी प्रार्थना पर ध्यान दे।<verse eid="PSA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />मूर्च्छित होते समय मैं पृथ्वी की छोर से तुझे पुकारूँगा;</para>
  <para style="q2" vid="PSA 61:2">मुझे उस चट्टान पर ले चल जो मेरे लिए ऊँची है।<verse eid="PSA 61:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3" />तू ही मेरा शरणस्थान रहा है,</para>
  <para style="q2" vid="PSA 61:3">और शत्रु के विरुद्ध एक दृढ़ गढ़ ठहरा है।<verse eid="PSA 61:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />मैं सर्वदा तेरे तंबू में वास करूँगा</para>
  <para style="q2" vid="PSA 61:4">और तेरे पंखों की ओट में शरण लिए रहूँगा। सेला।<verse eid="PSA 61:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />हे परमेश्‍वर तूने मेरी मन्‍नतें सुनी हैं;</para>
  <para style="q2" vid="PSA 61:5">तूने मुझे वैसा ही भाग दिया है</para>
  <para style="q1" vid="PSA 61:5">जैसा तू अपने नाम का भय माननेवालों को देता है।<verse eid="PSA 61:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />तू राजा की आयु को बहुत बढ़ा;</para>
  <para style="q2" vid="PSA 61:6">उसके वर्ष कई पीढ़ियों के तुल्य हों।<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />वह परमेश्‍वर के सम्मुख सर्वदा बना रहे।</para>
  <para style="q2" vid="PSA 61:7">तू उसकी रक्षा करने के लिए करुणा और सच्‍चाई को ठहरा।<verse eid="PSA 61:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8" />तब मैं प्रतिदिन अपनी मन्‍नतें पूरी करते हुए</para>
  <para style="q2" vid="PSA 61:8">सर्वदा तेरे नाम का भजन गाऊँगा।<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s1">केवल परमेश्‍वर पर भरोसा</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। यदूतून की राग पर दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1" />मैं चुपचाप परमेश्‍वर पर ही मन लगाए रहता हूँ,</para>
  <para style="q2" vid="PSA 62:1">मेरा उद्धार उसी से होता है।<verse eid="PSA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />वही मेरी चट्टान और मेरा उद्धार है;</para>
  <para style="q2" vid="PSA 62:2">वह मेरा ऊँचा गढ़ है,</para>
  <para style="q1" vid="PSA 62:2">मैं न डगमगाऊँगा।<verse eid="PSA 62:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />तुम सब घात करने के लिए</para>
  <para style="q2" vid="PSA 62:3">कब तक एक पुरुष पर आक्रमण करते रहोगे?</para>
  <para style="q1" vid="PSA 62:3">वह तो एक झुकी हुई दीवार</para>
  <para style="q2" vid="PSA 62:3">या गिरते हुए बाड़े के समान है।<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />वे उसे ऊँचे पद से गिराने की सम्मति करते हैं;</para>
  <para style="q2" vid="PSA 62:4">वे झूठ से प्रसन्‍न रहते हैं।</para>
  <para style="q1" vid="PSA 62:4">मुँह से तो वे आशीर्वाद देते हैं</para>
  <para style="q2" vid="PSA 62:4">पर मन में कोसते हैं। सेला।<verse eid="PSA 62:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />हे मेरे मन, शांति से परमेश्‍वर की प्रतीक्षा कर,</para>
  <para style="q2" vid="PSA 62:5">क्योंकि मेरी आशा उसी से है।<verse eid="PSA 62:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6" />वही मेरी चट्टान और मेरा उद्धार है;</para>
  <para style="q2" vid="PSA 62:6">वह मेरा ऊँचा गढ़ है,</para>
  <para style="q1" vid="PSA 62:6">मैं न डगमगाऊँगा।<verse eid="PSA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7" />मेरे उद्धार और मेरी महिमा का आधार परमेश्‍वर है;</para>
  <para style="q2" vid="PSA 62:7">परमेश्‍वर मेरी दृढ़ चट्टान और मेरा शरणस्थान है।<verse eid="PSA 62:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />हे लोगो, हर समय परमेश्‍वर पर भरोसा रखो;</para>
  <para style="q2" vid="PSA 62:8">उसके सामने अपने हृदय को उंडेल दो;</para>
  <para style="q1" vid="PSA 62:8">परमेश्‍वर हमारा शरणस्थान है। सेला।<verse eid="PSA 62:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />सचमुच छोटे लोग तो श्‍वास मात्र हैं,</para>
  <para style="q2" vid="PSA 62:9">और बड़े लोग मिथ्या हैं;</para>
  <para style="q1" vid="PSA 62:9">और तराजू पर उनका पलड़ा ऊपर उठ जाता है,</para>
  <para style="q2" vid="PSA 62:9">वे सब के सब श्‍वास से भी हल्के हैं।<verse eid="PSA 62:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />अंधेर करने पर भरोसा मत रखो,</para>
  <para style="q2" vid="PSA 62:10">न लूट-मार करने पर व्यर्थ आशा रखो।</para>
  <para style="q1" vid="PSA 62:10">चाहे धन-संपत्ति बढ़े,</para>
  <para style="q2" vid="PSA 62:10">फिर भी उस पर मन न लगाना।<verse eid="PSA 62:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11" />परमेश्‍वर ने एक बार कहा है,</para>
  <para style="q2" vid="PSA 62:11">और दो बार मैंने सुना है</para>
  <para style="q1" vid="PSA 62:11">कि सामर्थ्य परमेश्‍वर का है;<verse eid="PSA 62:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12" />और हे प्रभु, करुणा भी तेरी है।</para>
  <para style="q2" vid="PSA 62:12">तू तो हर एक को उसके काम के अनुसार प्रतिफल देता है।<verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s1">परमेश्‍वर में तृप्‍ति</para>
  <para style="b" />
  <para style="d">दाऊद का भजन। जब वह यहूदा के जंगल में था।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1" />हे परमेश्‍वर, तू मेरा परमेश्‍वर है,</para>
  <para style="q2" vid="PSA 63:1">मैं तुझे यत्‍न से ढूँढ़ूँगा;</para>
  <para style="q1" vid="PSA 63:1">सूखी, उजाड़ और निर्जल भूमि पर मेरा प्राण तेरा प्यासा है,</para>
  <para style="q2" vid="PSA 63:1">मेरा शरीर तेरा अति अभिलाषी है।<verse eid="PSA 63:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />इसलिए मैंने पवित्रस्थान में तुझ पर दृष्‍टि की</para>
  <para style="q2" vid="PSA 63:2">कि तेरे सामर्थ्य और तेरी महिमा को देखूँ।<verse eid="PSA 63:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />तेरी करुणा जीवन से भी उत्तम है;</para>
  <para style="q2" vid="PSA 63:3">मेरे होंठ तेरी प्रशंसा करेंगे।<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />इसी प्रकार मैं जीवन भर</para>
  <para style="q2" vid="PSA 63:4">तुझे धन्य कहता रहूँगा;</para>
  <para style="q1" vid="PSA 63:4">और तेरा नाम लेकर अपने हाथ उठाऊँगा।<verse eid="PSA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />मेरा प्राण मानो चरबी और चिकने भोजन से तृप्‍त होगा,</para>
  <para style="q2" vid="PSA 63:5">और मेरा मुँह जय जयकार करते हुए तेरी स्तुति करेगा।<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6" />जब मैं बिछौने पर पड़ा तेरा स्मरण करता हूँ,</para>
  <para style="q2" vid="PSA 63:6">तो रात के हर एक पहर में तुझ पर ध्यान करता हूँ।<verse eid="PSA 63:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7" />क्योंकि तू मेरा सहायक है,</para>
  <para style="q2" vid="PSA 63:7">इसलिए मैं तेरे पंखों की छाया में जय जयकार करूँगा।<verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />मेरा प्राण तुझसे लिपटा रहता है;</para>
  <para style="q2" vid="PSA 63:8">तेरा दाहिना हाथ मुझे थामे रहता है।<verse eid="PSA 63:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />परंतु जो मेरे प्राण को नष्‍ट करने की खोज में हैं,</para>
  <para style="q2" vid="PSA 63:9">वे पृथ्वी के गहरे स्थानों में जा पड़ेंगे।<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />वे तलवार से मार डाले जाएँगे,</para>
  <para style="q2" vid="PSA 63:10">और गीदड़ों का आहार हो जाएँगे।<verse eid="PSA 63:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />परंतु राजा परमेश्‍वर में आनंदित होगा;</para>
  <para style="q2" vid="PSA 63:11">जो परमेश्‍वर की शपथ खाता है,</para>
  <para style="q1" vid="PSA 63:11">वह उल्लसित होगा क्योंकि झूठ बोलनेवालों का</para>
  <para style="q2" vid="PSA 63:11">मुँह बंद किया जाएगा।<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s1">दुष्‍ट लोगों से सुरक्षा</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1" />हे परमेश्‍वर, जब मैं तेरी दुहाई दूँ</para>
  <para style="q2" vid="PSA 64:1">तो मेरी पुकार सुन;</para>
  <para style="q1" vid="PSA 64:1">शत्रु के आतंक से मेरी रक्षा कर।<verse eid="PSA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />कुकर्मियों के षड्यंत्र से, और अनर्थकारियों के</para>
  <para style="q2" vid="PSA 64:2">उपद्रव से मुझे छिपा ले।<verse eid="PSA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />उन्होंने अपनी जीभ को तलवार के समान तेज़ किया है।</para>
  <para style="q2" vid="PSA 64:3">उन्होंने अपने कड़वे वचन का तीर चढ़ाया है,<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />कि छिपकर उसे निर्दोष पर चलाएँ;</para>
  <para style="q2" vid="PSA 64:4">वे अचानक उस पर तीर चला देते हैं,</para>
  <para style="q1" vid="PSA 64:4">और डरते भी नहीं।<verse eid="PSA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />वे बुरी योजना बनाकर स्वयं को प्रोत्साहित करते हैं,</para>
  <para style="q2" vid="PSA 64:5">वे छिपकर जाल बिछाने की बात करते हैं;</para>
  <para style="q1" vid="PSA 64:5">वे कहते हैं, “हमें कौन देखेगा?”<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />वे कुटिलता की युक्‍ति रचते हैं, और कहते हैं,</para>
  <para style="q2" vid="PSA 64:6">“हमने बहुत सोच समझकर षड्यंत्र रचा है।”</para>
  <para style="q1" vid="PSA 64:6">मनुष्य का मन और हृदय तो अथाह है।<verse eid="PSA 64:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />परंतु परमेश्‍वर उन पर तीर चलाएगा;</para>
  <para style="q2" vid="PSA 64:7">वे अचानक घायल हो जाएँगे।<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />वे अपनी ही जीभ के कारण ठोकर खाएँगे;</para>
  <para style="q2" vid="PSA 64:8">जितने उन्हें देखेंगे, वे भाग जाएँगे<note caller="+" style="f"><char style="fr" closed="false">64:8 </char><char style="ft" closed="false">अक्षरशः सिर हिलाएँगे</char></note>।<verse eid="PSA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />तब सब लोग डर जाएँगे और परमेश्‍वर के कार्य का वर्णन करेंगे,</para>
  <para style="q2" vid="PSA 64:9">और जो कुछ उसने किया है उस पर ध्यान देंगे।<verse eid="PSA 64:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />धर्मी जन यहोवा के कारण आनंदित होकर उसकी शरण लेगा,</para>
  <para style="q2" vid="PSA 64:10">और सब सीधे मनवाले उसकी स्तुति करेंगे।<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s1">परमेश्‍वर की स्तुति और प्रशंसा</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन। एक गीत।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1" />हे परमेश्‍वर, सिय्योन में स्तुति तेरी प्रतीक्षा करती है;</para>
  <para style="q2" vid="PSA 65:1">और तेरे लिए मन्‍नतें पूरी की जाएँगी।<verse eid="PSA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2" />हे प्रार्थना के सुननेवाले,</para>
  <para style="q2" vid="PSA 65:2">सब प्राणी तेरे पास आएँगे।<verse eid="PSA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3" />अधर्म के काम मुझ पर प्रबल हुए हैं;</para>
  <para style="q2" vid="PSA 65:3">तू हमारे अपराधों को ढाँप देता है।<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />क्या ही धन्य है वह जिसे</para>
  <para style="q2" vid="PSA 65:4">तू चुनकर अपने निकट लाता है</para>
  <para style="q1" vid="PSA 65:4">कि तेरे आँगनों में वास करे!</para>
  <para style="q2" vid="PSA 65:4">हम तेरे भवन के,</para>
  <para style="q1" vid="PSA 65:4">अर्थात् तेरे पवित्र मंदिर के उत्तम पदार्थों से तृप्‍त होंगे।<verse eid="PSA 65:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />हे हमारे उद्धारकर्ता परमेश्‍वर,</para>
  <para style="q2" vid="PSA 65:5">तू जो पृथ्वी के सब दूर-दूर के देशों की</para>
  <para style="q1" vid="PSA 65:5">और सुदूर समुद्र-वासियों की आशा है,</para>
  <para style="q2" vid="PSA 65:5">तू धार्मिकता के साथ अद्भुत कार्यों के द्वारा हमें उत्तर देता है।<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />तू तो पराक्रम का कमरबंद कसकर</para>
  <para style="q2" vid="PSA 65:6">अपने सामर्थ्य से पर्वतों को स्थिर करता है;<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />तू ही समुद्रों के कोलाहल, उनकी लहरों के गर्जन,</para>
  <para style="q2" vid="PSA 65:7">तथा जाति-जाति के हुल्लड़ को शांत करता है;<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />इसलिए दूर-दूर देशों के रहनेवाले</para>
  <para style="q2" vid="PSA 65:8">तेरे चिह्‍न देखकर डर गए हैं।</para>
  <para style="q1" vid="PSA 65:8">तू उदयाचल और अस्ताचल दोनों से जय जयकार कराता है।<verse eid="PSA 65:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />तू भूमि की सुधि लेकर उसे सींचता है,</para>
  <para style="q2" vid="PSA 65:9">तू उसे बहुत उपजाऊ बनाता है।</para>
  <para style="q1" vid="PSA 65:9">परमेश्‍वर की नदी जल से भरी रहती है।</para>
  <para style="q2" vid="PSA 65:9">तू पृथ्वी को तैयार करके मनुष्यों के लिए अन्‍न‍ उपजाता है।<verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />तू इसके जुते हुए खेतों को भली-भाँति सींचता है,</para>
  <para style="q2" vid="PSA 65:10">और उसकी मिट्टी को समतल करता है।</para>
  <para style="q1" vid="PSA 65:10">तू भूमि को वर्षा की बौछारों से नरम करता है,</para>
  <para style="q2" vid="PSA 65:10">और उसकी उपज पर आशिष देता है।<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />तूने वर्ष को मानो अपनी भलाई का मुकुट पहनाया है,</para>
  <para style="q2" vid="PSA 65:11">तेरे मार्गों में भरपूरी पाई जाती है।<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />जंगल की चराइयों में हरियाली फूट पड़ती है;</para>
  <para style="q2" vid="PSA 65:12">और पहाड़ियाँ हर्ष का कटिबंध बाँधे हुए हैं।<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />चरागाह भेड़-बकरियों से भरे हैं,</para>
  <para style="q2" vid="PSA 65:13">और तराइयाँ अन्‍न‍ से ढँपी हैं,</para>
  <para style="q1" vid="PSA 65:13">वे जय जयकार करती और गाती भी हैं।<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s1">परमेश्‍वर के सामर्थी कामों के लिए स्तुतिगान</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। एक गीत। एक भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1" />हे सारी पृथ्वी के लोगो,</para>
  <para style="q2" vid="PSA 66:1">परमेश्‍वर का जय जयकार करो।<verse eid="PSA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2" />उसके नाम की महिमा का भजन गाओ,</para>
  <para style="q2" vid="PSA 66:2">स्तुति करते हुए उसकी महिमा करो।<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />परमेश्‍वर से कहो,</para>
  <para style="q2" vid="PSA 66:3">“तेरे कार्य क्या ही भययोग्य हैं!</para>
  <para style="q1" vid="PSA 66:3">तेरे बड़े सामर्थ्य के कारण तेरे शत्रु</para>
  <para style="q2" vid="PSA 66:3">तुझे झुककर प्रणाम करेंगे।<verse eid="PSA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4" />सारी पृथ्वी के लोग तुझे दंडवत् करेंगे,</para>
  <para style="q2" vid="PSA 66:4">और तेरा भजन गाएँगे;</para>
  <para style="q1" vid="PSA 66:4">वे तेरे नाम का भजन गाएँगे।” सेला।<verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />आओ और परमेश्‍वर के कार्यों को देखो!</para>
  <para style="q2" vid="PSA 66:5">मनुष्यों के प्रति उसके कार्य कैसे अद्भुत हैं!<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />उसने समुद्र को सूखी भूमि में बदल दिया;</para>
  <para style="q2" vid="PSA 66:6">उन्होंने महानद को पैदल ही पार किया।</para>
  <para style="q1" vid="PSA 66:6">वहाँ हम उसके कारण आनंदित हुए,<verse eid="PSA 66:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7" />जो अपने पराक्रम से सदा प्रभुता करता है,</para>
  <para style="q2" vid="PSA 66:7">और जिसकी आँखें जाति-जाति पर लगी रहती हैं।</para>
  <para style="q1" vid="PSA 66:7">विद्रोही अपने सिर न उठाएँ। सेला।<verse eid="PSA 66:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />हे देश-देश के लोगो, हमारे परमेश्‍वर को धन्य कहो,</para>
  <para style="q2" vid="PSA 66:8">और उसकी स्तुति के गीत सुनाओ,<verse eid="PSA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9" />जो हमें जीवित रखता है</para>
  <para style="q2" vid="PSA 66:9">और हमारे पैरों को फिसलने नहीं देता।<verse eid="PSA 66:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10" />क्योंकि हे परमेश्‍वर, तूने हमें जाँचा है;</para>
  <para style="q2" vid="PSA 66:10">तूने हमें चाँदी के समान ताया है।<verse eid="PSA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11" />तूने हमें जाल में फँसाया,</para>
  <para style="q2" vid="PSA 66:11">और हमारी कमर पर भारी बोझ बाँधा है;<verse eid="PSA 66:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12" />तूने हमारे सिरों को घुड़सवारों से कुचलवाया।</para>
  <para style="q2" vid="PSA 66:12">हम आग और जल से होकर गए;</para>
  <para style="q1" vid="PSA 66:12">परंतु तू हमें निकालकर भरपूरी के स्थान पर ले आया।<verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13" />मैं होमबलि लेकर तेरे भवन में आऊँगा।</para>
  <para style="q2" vid="PSA 66:13">मैं तेरे सामने उन मन्‍नतों को पूरी करूँगा,<verse eid="PSA 66:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14" />जो संकट के समय मैंने मुँह खोलकर</para>
  <para style="q2" vid="PSA 66:14">कही और मानी थीं।<verse eid="PSA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15" />मैं तुझे मेढ़ों के बलिदान की सुगंध के साथ</para>
  <para style="q2" vid="PSA 66:15">मोटे पशुओं की होमबलि चढ़ाऊँगा;</para>
  <para style="q1" vid="PSA 66:15">मैं तेरे लिए बकरों समेत बैल चढ़ाऊँगा। सेला।<verse eid="PSA 66:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16" />हे परमेश्‍वर का भय माननेवाले सब लोगो,</para>
  <para style="q2" vid="PSA 66:16">आओ और सुनो, मैं बताऊँगा</para>
  <para style="q1" vid="PSA 66:16">कि उसने मेरे लिए क्या-क्या किया है।<verse eid="PSA 66:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17" />मैंने उसे पुकारा,</para>
  <para style="q2" vid="PSA 66:17">और मेरी जीभ ने उसी का गुणगान किया।<verse eid="PSA 66:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18" />यदि मैं मन में अनर्थ बात सोचता,</para>
  <para style="q2" vid="PSA 66:18">तो प्रभु मेरी न सुनता।<verse eid="PSA 66:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19" />परंतु परमेश्‍वर ने तो सुना है;</para>
  <para style="q2" vid="PSA 66:19">उसने मेरी प्रार्थना पर ध्यान दिया है।<verse eid="PSA 66:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20" />धन्य है परमेश्‍वर, जिसने मेरी प्रार्थना को अनसुना नहीं किया,</para>
  <para style="q2" vid="PSA 66:20">और न अपनी करुणा को मुझसे दूर किया है!<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s1">सब लोग परमेश्‍वर की स्तुति करें</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए : तारवाले वाद्य-यंत्रों के साथ। एक भजन। एक गीत।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1" />परमेश्‍वर हम पर अनुग्रह करे,</para>
  <para style="q2" vid="PSA 67:1">और हमें आशिष दे; वह हम पर</para>
  <para style="q1" vid="PSA 67:1">अपने मुख का प्रकाश चमकाए, सेला<verse eid="PSA 67:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2" />जिससे तेरा मार्ग पृथ्वी पर,</para>
  <para style="q2" vid="PSA 67:2">और तेरा उद्धार सब जातियों में जाना जाए।<verse eid="PSA 67:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />हे परमेश्‍वर, देश-देश के लोग तेरी स्तुति करें;</para>
  <para style="q2" vid="PSA 67:3">देश-देश के सब लोग तेरी स्तुति करें।<verse eid="PSA 67:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />राज्य-राज्य के लोग आनंदित हों, और जय जयकार करें,</para>
  <para style="q2" vid="PSA 67:4">क्योंकि तू देश-देश के लोगों का न्याय धार्मिकता से करेगा;</para>
  <para style="q1" vid="PSA 67:4">और तू पृथ्वी के राज्य-राज्य के लोगों की अगुवाई करेगा। सेला।<verse eid="PSA 67:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />हे परमेश्‍वर, देश-देश के लोग तेरी स्तुति करें;</para>
  <para style="q2" vid="PSA 67:5">देश-देश के सब लोग तेरी स्तुति करें।<verse eid="PSA 67:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />भूमि ने अपनी उपज दी है;</para>
  <para style="q2" vid="PSA 67:6">परमेश्‍वर, हाँ हमारा परमेश्‍वर हमें आशिष देगा।<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />परमेश्‍वर हमें आशिष देगा, और पृथ्वी के दूर-दूर देशों के</para>
  <para style="q2" vid="PSA 67:7">सब लोग उसका भय मानेंगे।<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s1">परमेश्‍वर का वैभवशाली सामर्थ्य</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन। एक गीत।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1" />परमेश्‍वर उठे, उसके शत्रु तितर-बितर हों;</para>
  <para style="q2" vid="PSA 68:1">और उसके बैरी उसके सामने से भाग जाएँ!<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />जैसे धुआँ उड़ता है, वैसे ही तू उन्हें उड़ा दे;</para>
  <para style="q2" vid="PSA 68:2">जैसे मोम आग से पिघल जाता है,</para>
  <para style="q1" vid="PSA 68:2">वैसे ही परमेश्‍वर की उपस्थिति से दुष्‍ट लोग नष्‍ट हो जाएँ।<verse eid="PSA 68:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />परंतु धर्मी आनंदित हों,</para>
  <para style="q2" vid="PSA 68:3">वे परमेश्‍वर के सामने प्रफुल्लित हों;</para>
  <para style="q1" vid="PSA 68:3">वे आनंदित और मगन हों!<verse eid="PSA 68:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />परमेश्‍वर के लिए गीत गाओ!</para>
  <para style="q2" vid="PSA 68:4">उसके नाम का भजन गाओ,</para>
  <para style="q1" vid="PSA 68:4">जो बादलों पर सवार होकर निकलता है;</para>
  <para style="q2" vid="PSA 68:4">उसकी बड़ाई करो; उसका नाम याह है,</para>
  <para style="q1" vid="PSA 68:4">उसके सामने हर्षित होओ!<verse eid="PSA 68:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5" />परमेश्‍वर अपने पवित्र निवासस्थान में है,</para>
  <para style="q2" vid="PSA 68:5">वह अनाथों का पिता और विधवाओं का न्यायी है।<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />परमेश्‍वर अनाथों का घर बसाता है,</para>
  <para style="q2" vid="PSA 68:6">और बंदियों को छुड़ाकर संपन्‍न करता है;</para>
  <para style="q1" vid="PSA 68:6">परंतु हठीलों को सूखी भूमि पर रहना पड़ता है।<verse eid="PSA 68:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />हे परमेश्‍वर, जब तू अपनी प्रजा के आगे-आगे चला,</para>
  <para style="q2" vid="PSA 68:7">जब तू मरुभूमि में से होकर चला, सेला<verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />तब पृथ्वी काँप उठी,</para>
  <para style="q2" vid="PSA 68:8">और आकाश भी परमेश्‍वर के सामने टपकने लगा।</para>
  <para style="q1" vid="PSA 68:8">परमेश्‍वर, हाँ इस्राएल के परमेश्‍वर के सामने</para>
  <para style="q2" vid="PSA 68:8">सीनै पर्वत भी काँप उठा।<verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />हे परमेश्‍वर, तूने बहुतायत से वर्षा भेजी;</para>
  <para style="q2" vid="PSA 68:9">तेरा निज भाग बहुत सूखा था,</para>
  <para style="q1" vid="PSA 68:9">परंतु तूने उसे हरा-भरा कर दिया।<verse eid="PSA 68:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10" />तेरे लोग उसमें बस गए;</para>
  <para style="q2" vid="PSA 68:10">हे परमेश्‍वर, तूने अपनी भलाई के कारण दरिद्रों को दान दिया है।<verse eid="PSA 68:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />प्रभु आज्ञा देता है,</para>
  <para style="q2" vid="PSA 68:11">और स्‍त्रियों का बड़ा दल शुभ समाचार सुनाता है।<verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />राजा अपनी-अपनी सेना समेत भाग जाते हैं,</para>
  <para style="q2" vid="PSA 68:12">और घर में रहनेवाली स्‍त्री लूट को बाँट लेती है।<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />भले ही तुम भेड़शालाओं के बीच लेट जाते हो,</para>
  <para style="q2" vid="PSA 68:13">फिर भी तुम ऐसे कबूतर के समान हो जिसके पंख चाँदी से</para>
  <para style="q1" vid="PSA 68:13">और जिसके पर चमकते सोने से मढ़े हैं।<verse eid="PSA 68:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />जब सर्वशक्‍तिमान ने वहाँ राजाओं को तितर-बितर किया,</para>
  <para style="q2" vid="PSA 68:14">तो मानो सल्मोन पर्वत पर हिमपात हुआ।<verse eid="PSA 68:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />बाशान का पर्वत परमेश्‍वर का पर्वत है;</para>
  <para style="q2" vid="PSA 68:15">बाशान के पर्वत की अनेक चोटियाँ हैं।<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />हे अनेक चोटियोंवाले पर्वतो,</para>
  <para style="q2" vid="PSA 68:16">तुम ईर्ष्या से उस पर्वत को क्यों घूरते हो</para>
  <para style="q1" vid="PSA 68:16">जिसे परमेश्‍वर ने अपने निवास के लिए चाहा है?</para>
  <para style="q2" vid="PSA 68:16">निश्‍चय यहोवा वहाँ सर्वदा वास करेगा।<verse eid="PSA 68:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />परमेश्‍वर के रथ हज़ारों लाखों हैं।</para>
  <para style="q2" vid="PSA 68:17">प्रभु जैसे अपनी पवित्रता में सीनै पर्वत पर था,</para>
  <para style="q1" vid="PSA 68:17">वैसे ही उनके मध्य है।<verse eid="PSA 68:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />तू ऊँचे पर चढ़ गया;</para>
  <para style="q2" vid="PSA 68:18">तू लोगों को बँधुआई में ले गया;</para>
  <para style="q1" vid="PSA 68:18">तूने मनुष्यों से, बल्कि विद्रोही मनुष्यों से भी भेंटें लीं,</para>
  <para style="q2" vid="PSA 68:18">ताकि यहोवा परमेश्‍वर वहाँ वास करे।<verse eid="PSA 68:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />धन्य है प्रभु, जो प्रतिदिन हमारा बोझ उठाता है;</para>
  <para style="q2" vid="PSA 68:19">परमेश्‍वर ही हमारा उद्धार है। सेला।<verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />हमारा परमेश्‍वर छुटकारा देनेवाला परमेश्‍वर है;</para>
  <para style="q2" vid="PSA 68:20">प्रभु यहोवा मृत्यु से भी बचाता है।<verse eid="PSA 68:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />निश्‍चय परमेश्‍वर अपने शत्रुओं के सिर को,</para>
  <para style="q2" vid="PSA 68:21">अर्थात् जो अधर्म के मार्ग पर चलता रहता है,</para>
  <para style="q1" vid="PSA 68:21">उसके बालों भरे सिर को कुचल देगा।<verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />प्रभु ने कहा, “मैं उन्हें बाशान से निकाल लाऊँगा;</para>
  <para style="q2" vid="PSA 68:22">मैं उन्हें समुद्र की गहराइयों से भी निकाल लाऊँगा,<verse eid="PSA 68:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23" />कि तू अपने पैरों को शत्रुओं के लहू में डुबोए,</para>
  <para style="q2" vid="PSA 68:23">और वे तेरे कुत्तों का भाग ठहरें।”<verse eid="PSA 68:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />हे परमेश्‍वर, लोगों ने तेरी विजय यात्रा देखी है,</para>
  <para style="q2" vid="PSA 68:24">मेरे परमेश्‍वर, मेरे राजा की विजय यात्रा पवित्रस्थान में आई है;<verse eid="PSA 68:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25" />गानेवाले आगे-आगे और तारवाले वाद्य-यंत्रों को</para>
  <para style="q2" vid="PSA 68:25">बजानेवाले पीछे-पीछे चले,</para>
  <para style="q1" vid="PSA 68:25">उनके मध्य कन्याएँ डफ़ बजा रही थीं।<verse eid="PSA 68:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26" />हे इस्राएल के सोते से निकले हुए लोगो,</para>
  <para style="q2" vid="PSA 68:26">सभाओं में यहोवा का,</para>
  <para style="q1" vid="PSA 68:26">हाँ परमेश्‍वर का धन्यवाद करो।<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />वहाँ उनकी अगुवाई छोटा बिन्यामीन कर रहा है,</para>
  <para style="q2" vid="PSA 68:27">वहाँ यहूदा के शासक अपने सलाहकारों समेत हैं,</para>
  <para style="q1" vid="PSA 68:27">और जबूलून और नप्‍ताली के शासक भी हैं।<verse eid="PSA 68:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />तेरे परमेश्‍वर ने आज्ञा दी है</para>
  <para style="q2" vid="PSA 68:28">कि तुझे सामर्थ्य मिले;</para>
  <para style="q1" vid="PSA 68:28">हे परमेश्‍वर, जो कुछ तूने हमारे लिए किया है,</para>
  <para style="q2" vid="PSA 68:28">उसे दृढ़ कर।<verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />यरूशलेम में तेरे मंदिर के कारण राजा</para>
  <para style="q2" vid="PSA 68:29">तेरे लिए भेंट लाएँगे।<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />नरकटों में रहनेवाले पशु को,</para>
  <para style="q2" vid="PSA 68:30">और साँड़ों के उस झुंड को</para>
  <para style="q1" vid="PSA 68:30">जो देश-देश के बछड़ों के बीच है, झिड़क दे।</para>
  <para style="q2" vid="PSA 68:30">वे चाँदी के टुकड़े लिए हुए प्रणाम करेंगे;</para>
  <para style="q1" vid="PSA 68:30">जो लोग युद्ध से प्रसन्‍न रहते हैं,</para>
  <para style="q2" vid="PSA 68:30">उन्हें उसने तितर-बितर किया है।<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />मिस्र से अधिकारी आएँगे;</para>
  <para style="q2" vid="PSA 68:31">कूशी अपने हाथों को परमेश्‍वर की ओर फैलाएँगे।<verse eid="PSA 68:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />हे पृथ्वी के राज्य-राज्य के लोगो,</para>
  <para style="q2" vid="PSA 68:32">परमेश्‍वर का गीत गाओ;</para>
  <para style="q1" vid="PSA 68:32">प्रभु का भजन गाओ, सेला<verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />जो सब से ऊँचे सनातन स्वर्ग में सवार होकर चलता है।</para>
  <para style="q2" vid="PSA 68:33">देखो, वह अपनी वाणी सुनाता है,</para>
  <para style="q1" vid="PSA 68:33">जो सामर्थी वाणी है।<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />परमेश्‍वर के सामर्थ्य की स्तुति करो,</para>
  <para style="q2" vid="PSA 68:34">उसका प्रताप इस्राएल पर छाया हुआ है,</para>
  <para style="q1" vid="PSA 68:34">और उसका सामर्थ्य आकाशमंडल में है।<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />हे परमेश्‍वर, तू अपने पवित्र स्थानों में भययोग्य है,</para>
  <para style="q2" vid="PSA 68:35">इस्राएल का परमेश्‍वर ही अपनी प्रजा को सामर्थ्य और बल देता है।</para>
  <para style="q1" vid="PSA 68:35">परमेश्‍वर धन्य है।<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s1">संकट में सहायता के लिए विनती</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। शोशन्‍नीम की राग पर दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1" />हे परमेश्‍वर, मुझे बचा ले,</para>
  <para style="q2" vid="PSA 69:1">पानी मेरे गले तक आ पहुँचा है।<verse eid="PSA 69:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2" />मैं गहरे दलदल में धँसा जाता हूँ,</para>
  <para style="q2" vid="PSA 69:2">और पैर टिकाने का कोई स्थान नहीं है;</para>
  <para style="q1" vid="PSA 69:2">मैं गहरे जल में आ पहुँचा हूँ,</para>
  <para style="q2" vid="PSA 69:2">और धारा में डूबा जाता हूँ।<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />मैं पुकारते-पुकारते थक गया हूँ,</para>
  <para style="q2" vid="PSA 69:3">मेरा गला सूख गया है;</para>
  <para style="q1" vid="PSA 69:3">अपने परमेश्‍वर की प्रतीक्षा करते-करते</para>
  <para style="q2" vid="PSA 69:3">मेरी आँखें धुँधला गई हैं।<verse eid="PSA 69:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />मुझसे अकारण बैर रखनेवालों की</para>
  <para style="q2" vid="PSA 69:4">गिनती मेरे सिर के बालों से अधिक है;</para>
  <para style="q1" vid="PSA 69:4">मेरा विनाश करनेवाले व्यर्थ ही मेरे शत्रु हैं,</para>
  <para style="q2" vid="PSA 69:4">वे बलशाली हैं, और जो मैंने नहीं लूटा</para>
  <para style="q1" vid="PSA 69:4">वह भी मुझे देना पड़ता है।<verse eid="PSA 69:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />हे परमेश्‍वर, तू तो मेरी मूर्खता को जानता है,</para>
  <para style="q2" vid="PSA 69:5">और मेरे दोष तुझसे छिपे नहीं हैं।<verse eid="PSA 69:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />हे प्रभु, हे सेनाओं के यहोवा,</para>
  <para style="q2" vid="PSA 69:6">जो तेरी प्रतीक्षा करते हैं,</para>
  <para style="q1" vid="PSA 69:6">मेरे कारण वे लज्‍जित न हों;</para>
  <para style="q2" vid="PSA 69:6">हे इस्राएल के परमेश्‍वर,</para>
  <para style="q1" vid="PSA 69:6">जो तुझे ढूँढ़ते हैं,</para>
  <para style="q2" vid="PSA 69:6">वे मेरे कारण अपमानित न हों।<verse eid="PSA 69:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7" />तेरे ही कारण मेरी निंदा हुई है,</para>
  <para style="q2" vid="PSA 69:7">और मेरा मुँह लज्‍जा से ढँपा है।<verse eid="PSA 69:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8" />मैं अपने भाइयों के लिए अजनबी हो गया हूँ,</para>
  <para style="q2" vid="PSA 69:8">और अपने सगे भाइयों की दृष्‍टि में परदेशी ठहरा हूँ।<verse eid="PSA 69:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9" />क्योंकि तेरे भवन की धुन ने मुझे भस्म कर दिया है।</para>
  <para style="q2" vid="PSA 69:9">जो निंदा वे तेरी करते हैं,</para>
  <para style="q1" vid="PSA 69:9">वही मुझे सहनी पड़ी है।<verse eid="PSA 69:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10" />जब मैंने उपवास के साथ रोते हुए</para>
  <para style="q2" vid="PSA 69:10">अपने को दीन किया,</para>
  <para style="q1" vid="PSA 69:10">तो उससे भी मेरी निंदा हुई।<verse eid="PSA 69:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11" />जब मैंने टाट का वस्‍त्र पहना,</para>
  <para style="q2" vid="PSA 69:11">तो मैं उनके उपहास का विषय बन गया।<verse eid="PSA 69:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12" />फाटक के पास बैठनेवाले मेरे विषय में बातचीत करते हैं,</para>
  <para style="q2" vid="PSA 69:12">और मदिरा पीनेवाले मुझ पर गीत रचते हैं।<verse eid="PSA 69:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13" />परंतु हे यहोवा, मेरी प्रार्थना तो तुझसे है।</para>
  <para style="q2" vid="PSA 69:13">हे परमेश्‍वर, अपनी कृपा के समय,</para>
  <para style="q1" vid="PSA 69:13">अपनी अपार करुणा से</para>
  <para style="q2" vid="PSA 69:13">और अपने उद्धार की सच्‍चाई के अनुसार मुझे उत्तर दे।<verse eid="PSA 69:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14" />मुझे दलदल में से निकाल</para>
  <para style="q2" vid="PSA 69:14">कि मैं धँस न जाऊँ;</para>
  <para style="q1" vid="PSA 69:14">मैं अपने बैरियों से,</para>
  <para style="q2" vid="PSA 69:14">और गहरे जल में से बच जाऊँ।<verse eid="PSA 69:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15" />मैं धारा में बह न जाऊँ,</para>
  <para style="q2" vid="PSA 69:15">और न गहरे जल में डूब मरूँ,</para>
  <para style="q1" vid="PSA 69:15">और न पाताल का मुँह मेरे ऊपर बंद हो।<verse eid="PSA 69:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16" />हे यहोवा, मुझे उत्तर दे,</para>
  <para style="q2" vid="PSA 69:16">क्योंकि तेरी करुणा उत्तम है;</para>
  <para style="q1" vid="PSA 69:16">अपनी दया की बहुतायत के अनुसार</para>
  <para style="q2" vid="PSA 69:16">मेरी ओर ध्यान दे।<verse eid="PSA 69:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17" />अपने दास से अपना मुँह न मोड़;</para>
  <para style="q2" vid="PSA 69:17">क्योंकि मैं संकट में हूँ,</para>
  <para style="q1" vid="PSA 69:17">फुर्ती से मुझे उत्तर दे।<verse eid="PSA 69:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18" />मेरे निकट आकर मुझे छुड़ा ले;</para>
  <para style="q2" vid="PSA 69:18">मुझे मेरे शत्रुओं से छुटकारा दे।<verse eid="PSA 69:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19" />मेरी निंदा और लज्‍जा</para>
  <para style="q2" vid="PSA 69:19">और अनादर को तू जानता है;</para>
  <para style="q1" vid="PSA 69:19">मेरे सब विरोधी तेरे सामने हैं।<verse eid="PSA 69:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20" />निंदा के कारण मेरा हृदय टूट गया,</para>
  <para style="q2" vid="PSA 69:20">और मैं बहुत उदास हूँ।</para>
  <para style="q1" vid="PSA 69:20">मैंने सहानुभूति तो चाही पर न मिली,</para>
  <para style="q2" vid="PSA 69:20">मैंने शांति देनेवालों को भी ढूँढ़ा,</para>
  <para style="q1" vid="PSA 69:20">पर कोई न मिला।<verse eid="PSA 69:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21" />लोगों ने मुझे खाने में पित्त मिलाकर दिया,</para>
  <para style="q2" vid="PSA 69:21">और मेरी प्यास बुझाने के लिए मुझे सिरका पिलाया।<verse eid="PSA 69:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22" />उनका भोजन उनके लिए फंदा हो जाए;</para>
  <para style="q2" vid="PSA 69:22">और उनके सुख का समय उनके लिए जाल बन जाए।<verse eid="PSA 69:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23" />उनकी आँखों पर अंधेरा छा जाए,</para>
  <para style="q2" vid="PSA 69:23">ताकि वे देख न सकें;</para>
  <para style="q1" vid="PSA 69:23">और उनकी कमर निरंतर झुकी रहे।<verse eid="PSA 69:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24" />अपना प्रकोप उनके ऊपर भड़का,</para>
  <para style="q2" vid="PSA 69:24">और तेरे क्रोध की ज्वाला उन्हें भस्म कर दे।<verse eid="PSA 69:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25" />उनकी छावनी उजड़ जाए,</para>
  <para style="q2" vid="PSA 69:25">उनके डेरों में कोई न रहे।<verse eid="PSA 69:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26" />क्योंकि वे उसके पीछे पड़े हैं</para>
  <para style="q2" vid="PSA 69:26">जिसे तूने मारा था,</para>
  <para style="q1" vid="PSA 69:26">और वे उनकी पीड़ा की चर्चा करते हैं</para>
  <para style="q2" vid="PSA 69:26">जिन्हें तूने घायल किया था।<verse eid="PSA 69:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27" />उनके अधर्म पर अधर्म बढ़ा;</para>
  <para style="q2" vid="PSA 69:27">और वे तेरी धार्मिकता को प्राप्‍त न करें।<verse eid="PSA 69:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28" />उनका नाम जीवन की पुस्तक में से काट दिया जाए,</para>
  <para style="q2" vid="PSA 69:28">और धर्मियों के साथ न लिखा जाए।<verse eid="PSA 69:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29" />परंतु मैं तो दुःख और पीड़ा में हूँ,</para>
  <para style="q2" vid="PSA 69:29">इसलिए हे परमेश्‍वर,</para>
  <para style="q1" vid="PSA 69:29">तेरा उद्धार मुझे ऊँचे स्थान पर बैठाए।<verse eid="PSA 69:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30" />मैं गीत गाकर परमेश्‍वर के नाम की स्तुति करूँगा,</para>
  <para style="q2" vid="PSA 69:30">और धन्यवाद करता हुआ उसकी प्रशंसा करूँगा;<verse eid="PSA 69:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31" />और यह यहोवा को बैल से,</para>
  <para style="q2" vid="PSA 69:31">बल्कि सींग और खुरवाले बैल से भी अधिक भाएगा।<verse eid="PSA 69:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32" />नम्र लोग यह देखकर आनंदित होंगे;</para>
  <para style="q2" vid="PSA 69:32">हे परमेश्‍वर के खोजियो,</para>
  <para style="q1" vid="PSA 69:32">तुम्हारा मन हरा-भरा हो जाए।<verse eid="PSA 69:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33" />क्योंकि यहोवा दरिद्रों की सुनता है,</para>
  <para style="q2" vid="PSA 69:33">और अपने लोगों को जो बंधुए हैं,</para>
  <para style="q1" vid="PSA 69:33">तुच्छ नहीं जानता।<verse eid="PSA 69:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34" />स्वर्ग और पृथ्वी उसकी स्तुति करें,</para>
  <para style="q2" vid="PSA 69:34">तथा समुद्र और उसके सब प्राणी उसकी स्तुति करें।<verse eid="PSA 69:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35" />क्योंकि परमेश्‍वर सिय्योन का उद्धार करेगा,</para>
  <para style="q2" vid="PSA 69:35">और यहूदा के नगरों को फिर से बनाएगा।</para>
  <para style="q1" vid="PSA 69:35">तब लोग वहाँ फिर से बसकर उसके अधिकारी हो जाएँगे।<verse eid="PSA 69:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36" />उसके दासों का वंश उसका उत्तराधिकारी हो जाएगा,</para>
  <para style="q2" vid="PSA 69:36">और उसके नाम के प्रेमी उसमें वास करेंगे।<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s1">छुटकारे के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन। स्मरण कराने के लिए।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1" />हे परमेश्‍वर, मुझे छुड़ाने के लिए,</para>
  <para style="q2" vid="PSA 70:1">हे यहोवा, मेरी सहायता करने के लिए शीघ्र आ!<verse eid="PSA 70:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />जो मेरे प्राण के खोजी हैं,</para>
  <para style="q2" vid="PSA 70:2">वे निराश और लज्‍जित हो जाएँ!</para>
  <para style="q1" vid="PSA 70:2">जो मेरी हानि से प्रसन्‍न होते हैं,</para>
  <para style="q2" vid="PSA 70:2">वे खदेड़े और अपमानित किए जाएँ।<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />जो कहते हैं, “आहा, आहा!”</para>
  <para style="q2" vid="PSA 70:3">वे अपनी लज्‍जा के मारे वापस लौट जाएँ।<verse eid="PSA 70:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />तेरे सब खोजी तेरे कारण हर्षित और आनंदित हों;</para>
  <para style="q2" vid="PSA 70:4">और तेरे उद्धार से प्रेम रखनेवाले निरंतर कहते रहें,</para>
  <para style="q1" vid="PSA 70:4">“परमेश्‍वर की बड़ाई हो!”<verse eid="PSA 70:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />मैं तो दीन और दरिद्र हूँ;</para>
  <para style="q2" vid="PSA 70:5">हे परमेश्‍वर, मेरे लिए फुर्ती कर!</para>
  <para style="q1" vid="PSA 70:5">तू मेरा सहायक और छुड़ानेवाला है;</para>
  <para style="q2" vid="PSA 70:5">हे यहोवा, विलंब न कर!<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s1">वृद्धावस्था में परमेश्‍वर से सहायता</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1" />हे यहोवा, मैं तेरी शरण में आया हूँ;</para>
  <para style="q2" vid="PSA 71:1">मुझे कभी लज्‍जित न होने दे।<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />अपनी धार्मिकता के कारण मुझे छुड़ा</para>
  <para style="q2" vid="PSA 71:2">और मेरा उद्धार कर;</para>
  <para style="q1" vid="PSA 71:2">अपने कान मेरी ओर लगा</para>
  <para style="q2" vid="PSA 71:2">और मुझे बचा ले।<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />तू मेरे लिए शरण की चट्टान बन,</para>
  <para style="q2" vid="PSA 71:3">जहाँ मैं नित्य शरण ले सकूँ;</para>
  <para style="q1" vid="PSA 71:3">तूने मेरे उद्धार की आज्ञा दी है,</para>
  <para style="q2" vid="PSA 71:3">क्योंकि तू मेरी चट्टान और मेरा दृढ़ गढ़ है।<verse eid="PSA 71:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />हे मेरे परमेश्‍वर, मुझे दुष्‍ट के हाथ से</para>
  <para style="q2" vid="PSA 71:4">और कुटिल तथा क्रूर मनुष्य के पंजे से छुड़ा;<verse eid="PSA 71:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />क्योंकि हे प्रभु यहोवा,</para>
  <para style="q2" vid="PSA 71:5">तू ही मेरी आशा है,</para>
  <para style="q1" vid="PSA 71:5">बचपन से मेरा भरोसा तुझी पर है।<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />जन्म से ही तूने मुझे संभाला;</para>
  <para style="q2" vid="PSA 71:6">मुझे माता के गर्भ से तूने ही निकाला।</para>
  <para style="q1" vid="PSA 71:6">इसलिए मैं निरंतर तेरी स्तुति करता रहूँगा।<verse eid="PSA 71:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />बहुतों के लिए मैं एक अचंभा हूँ;</para>
  <para style="q2" vid="PSA 71:7">परंतु तू मेरा दृढ़ गढ़ है।<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />मेरे मुँह से तेरी स्तुति,</para>
  <para style="q2" vid="PSA 71:8">और दिन भर तेरी महिमा की बातें निकलती हैं।<verse eid="PSA 71:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />बुढ़ापे के समय मुझे दूर न कर,</para>
  <para style="q2" vid="PSA 71:9">और जब मेरा बल घट जाए तो मुझे छोड़ न दे।<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />क्योंकि मेरे शत्रु मेरे विरुद्ध बातें करते हैं</para>
  <para style="q2" vid="PSA 71:10">और वे मेरे प्राण की ताक में हैं।</para>
  <para style="q1" vid="PSA 71:10">उन्होंने यह कहकर आपस में सम्मति की है :<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />“परमेश्‍वर ने उसे त्याग दिया है;</para>
  <para style="q2" vid="PSA 71:11">उसका पीछा करके उसे पकड़ लो,</para>
  <para style="q1" vid="PSA 71:11">क्योंकि उसे छुड़ानेवाला कोई नहीं है।”<verse eid="PSA 71:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />परंतु हे परमेश्‍वर, मुझसे दूर न रह!</para>
  <para style="q2" vid="PSA 71:12">हे मेरे परमेश्‍वर, मेरी सहायता के लिए शीघ्र आ!<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />जो मेरे प्राण के शत्रु हैं वे लज्‍जित हों</para>
  <para style="q2" vid="PSA 71:13">और उनका अंत हो जाए;</para>
  <para style="q1" vid="PSA 71:13">जो मेरी हानि चाहते हैं</para>
  <para style="q2" vid="PSA 71:13">वे निंदा और अपमान में डूब जाएँ।<verse eid="PSA 71:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />परंतु मैं तो निरंतर आशा लगाए रहूँगा,</para>
  <para style="q2" vid="PSA 71:14">और तेरी स्तुति अधिकाधिक करता रहूँगा।<verse eid="PSA 71:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />मैं दिन भर अपने मुँह से तेरी धार्मिकता</para>
  <para style="q2" vid="PSA 71:15">और तेरे उद्धार के कार्यों का वर्णन करता रहूँगा,</para>
  <para style="q1" vid="PSA 71:15">क्योंकि वे अनगिनित हैं।<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />मैं प्रभु यहोवा के पराक्रम का वर्णन करता हुआ आऊँगा;</para>
  <para style="q2" vid="PSA 71:16">मैं केवल तेरी ही धार्मिकता की चर्चा करूँगा।<verse eid="PSA 71:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />हे परमेश्‍वर, तू मुझे बचपन से सिखाता आया है,</para>
  <para style="q2" vid="PSA 71:17">और मैं अब भी तेरे आश्‍चर्यकर्मों का प्रचार करता हूँ।<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />यद्यपि मैं अब बूढ़ा हो गया हूँ</para>
  <para style="q2" vid="PSA 71:18">और मेरे बाल पक गए हैं,</para>
  <para style="q1" vid="PSA 71:18">फिर भी हे परमेश्‍वर, मुझे न छोड़,</para>
  <para style="q2" vid="PSA 71:18">जब तक कि मैं इस पीढ़ी से तेरे भुजबल का,</para>
  <para style="q1" vid="PSA 71:18">और सब उत्पन्‍न‍ होने वालों से</para>
  <para style="q2" vid="PSA 71:18">तेरे पराक्रम का वर्णन न कर दूँ।<verse eid="PSA 71:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />हे परमेश्‍वर, तेरी धार्मिकता तो स्वर्ग तक पहुँचती है।</para>
  <para style="q2" vid="PSA 71:19">तूने बड़े-बड़े कार्य किए हैं;</para>
  <para style="q1" vid="PSA 71:19">हे परमेश्‍वर, तेरे तुल्य कौन है?<verse eid="PSA 71:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20" />तूने तो मुझे बहुत सी कठिनाइयाँ</para>
  <para style="q2" vid="PSA 71:20">और संकट दिखाए हैं,</para>
  <para style="q1" vid="PSA 71:20">परंतु अब तू मुझे फिर से जिलाएगा,</para>
  <para style="q2" vid="PSA 71:20">और पृथ्वी की गहराइयों में से उबार लेगा।<verse eid="PSA 71:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21" />तू मेरा सम्मान बढ़ाएगा,</para>
  <para style="q2" vid="PSA 71:21">और मुझे फिर से शांति देगा।<verse eid="PSA 71:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22" />हे मेरे परमेश्‍वर, मैं तेरी सच्‍चाई के लिए</para>
  <para style="q2" vid="PSA 71:22">तेरा धन्यवाद सारंगी बजाकर करूँगा।</para>
  <para style="q1" vid="PSA 71:22">हे इस्राएल के पवित्र,</para>
  <para style="q2" vid="PSA 71:22">मैं वीणा बजाकर तेरा भजन गाऊँगा।<verse eid="PSA 71:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23" />जब मैं तेरा भजन गाऊँगा,</para>
  <para style="q2" vid="PSA 71:23">तो अपने होंठों से</para>
  <para style="q1" vid="PSA 71:23">और अपने प्राण से जिसे तूने बचाया है,</para>
  <para style="q2" vid="PSA 71:23">तेरा जय जयकार करूँगा।<verse eid="PSA 71:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24" />तब मैं अपनी जीभ से दिन भर</para>
  <para style="q2" vid="PSA 71:24">तेरी धार्मिकता की चर्चा करता रहूँगा,</para>
  <para style="q1" vid="PSA 71:24">क्योंकि जो मेरी हानि चाहते हैं</para>
  <para style="q2" vid="PSA 71:24">वे लज्‍जित और निराश हो गए हैं।<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s1">राजा के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">सुलैमान का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1" />हे परमेश्‍वर, राजा को अपना न्याय,</para>
  <para style="q2" vid="PSA 72:1">राजपुत्र को अपनी धार्मिकता प्रदान कर!<verse eid="PSA 72:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2" />वह तेरी प्रजा का न्याय धार्मिकता से,</para>
  <para style="q2" vid="PSA 72:2">और पीड़ितों का न्याय निष्पक्षता से करे।<verse eid="PSA 72:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />प्रजा के लिए पहाड़ शांति</para>
  <para style="q2" vid="PSA 72:3">और पहाड़ियाँ धार्मिकता लेकर आएँ।<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />वह प्रजा के पीड़ितों का न्याय करे,</para>
  <para style="q2" vid="PSA 72:4">और दरिद्रों को बचाए,</para>
  <para style="q1" vid="PSA 72:4">और अत्याचारी को कुचल डाले।<verse eid="PSA 72:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />जब तक सूर्य और चंद्रमा बने रहेंगे,</para>
  <para style="q2" vid="PSA 72:5">तब तक लोग पीढ़ी से पीढ़ी</para>
  <para style="q1" vid="PSA 72:5">तेरा भय मानते रहेंगे।<verse eid="PSA 72:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />वह कटी हुई घास पर वर्षा के समान,</para>
  <para style="q2" vid="PSA 72:6">और भूमि को सींचने वाली</para>
  <para style="q1" vid="PSA 72:6">बौछार के समान हो।<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />उसके दिनों में धर्मी फूले-फलें,</para>
  <para style="q2" vid="PSA 72:7">और जब तक चंद्रमा टल न जाए</para>
  <para style="q1" vid="PSA 72:7">तब तक बड़ी शांति बनी रहे।<verse eid="PSA 72:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />वह समुद्र से समुद्र तक</para>
  <para style="q2" vid="PSA 72:8">और महानद से पृथ्वी की छोर तक प्रभुता करे।<verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />मरुभूमि के निवासी उसके सामने घुटने टेकें</para>
  <para style="q2" vid="PSA 72:9">और उसके शत्रु मिट्टी चाटें।<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />तर्शीश और द्वीप-द्वीप के राजा उपहार लाएँ;</para>
  <para style="q2" vid="PSA 72:10">शेबा और सबा के राजा भेंट अर्पित करें।<verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />सब राजा उसे दंडवत् करें,</para>
  <para style="q2" vid="PSA 72:11">जाति-जाति के लोग उसके अधीन हो जाएँ।<verse eid="PSA 72:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />क्योंकि वह तो दुहाई देनेवाले दरिद्र का,</para>
  <para style="q2" vid="PSA 72:12">और पीड़ित तथा असहाय का उद्धार करेगा।<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />वह निर्बल और दरिद्र पर तरस खाएगा,</para>
  <para style="q2" vid="PSA 72:13">और दरिद्रों के प्राण बचाएगा।<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />वह अत्याचार और हिंसा से उनके प्राण की रक्षा करेगा,</para>
  <para style="q2" vid="PSA 72:14">और उसकी दृष्‍टि में उनका लहू अनमोल ठहरेगा।<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />वह जीवित रहे,</para>
  <para style="q2" vid="PSA 72:15">और शेबा के सोने में से उसे दिया जाए।</para>
  <para style="q1" vid="PSA 72:15">उसके लिए नित्य प्रार्थना की जाए;</para>
  <para style="q2" vid="PSA 72:15">और दिन भर उसे धन्य कहा जाए।<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />देश में बहुत सा अन्‍न हो,</para>
  <para style="q2" vid="PSA 72:16">यहाँ तक कि पहाड़ों की चोटियाँ भी अन्‍न से भरपूर हो जाएँ;</para>
  <para style="q1" vid="PSA 72:16">उसकी बालें लबानोन के देवदारों के समान झूम उठें,</para>
  <para style="q2" vid="PSA 72:16">और नगर के लोग मैदान की घास के समान लहलहाएँ।<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />उसका नाम सदा-सर्वदा बना रहे।</para>
  <para style="q2" vid="PSA 72:17">जब तक सूर्य का अस्तित्व है,</para>
  <para style="q1" vid="PSA 72:17">उसका नाम निरंतर बढ़ता रहे।</para>
  <para style="q2" vid="PSA 72:17">उसके कारण सारी जातियाँ आशिष पाएँ,</para>
  <para style="q1" vid="PSA 72:17">और उसे धन्य कहें।<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />धन्य है यहोवा परमेश्‍वर,</para>
  <para style="q2" vid="PSA 72:18">जो इस्राएल का परमेश्‍वर है;</para>
  <para style="q1" vid="PSA 72:18">आश्‍चर्यकर्म केवल वही करता है।<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />उसका महिमामय नाम सर्वदा धन्य रहे;</para>
  <para style="q2" vid="PSA 72:19">और सारी पृथ्वी उसकी महिमा से परिपूर्ण हो।</para>
  <para style="q1" vid="PSA 72:19">आमीन, फिर आमीन।<verse eid="PSA 72:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20" />यिशै के पुत्र दाऊद की प्रार्थनाएँ समाप्‍त हुईं।<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="s1">तीसरा भाग</para>
  <para style="b" />
  <para style="s1">परमेश्‍वर के मार्ग खरे हैं</para>
  <para style="b" />
  <para style="d">आसाफ का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1" />परमेश्‍वर सचमुच इस्राएल के लिए</para>
  <para style="q2" vid="PSA 73:1">अर्थात् शुद्ध मनवालों के लिए भला है।<verse eid="PSA 73:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />परंतु मेरे पैर तो लड़खड़ाने पर थे;</para>
  <para style="q2" vid="PSA 73:2">मेरे कदम फिसलने पर थे।<verse eid="PSA 73:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3" />क्योंकि जब मैंने दुष्‍टों को फलते-फूलते देखा,</para>
  <para style="q2" vid="PSA 73:3">तो उन घमंडियों के प्रति</para>
  <para style="q1" vid="PSA 73:3">ईर्ष्या से भर उठा।<verse eid="PSA 73:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />उनकी मृत्यु में तो वेदनाएँ नहीं होतीं,</para>
  <para style="q2" vid="PSA 73:4">और उनकी देह हृष्‍‍ट-पुष्‍‍ट होती है।<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />उन्हें दूसरे मनुष्यों के समान कष्‍ट नहीं होता,</para>
  <para style="q2" vid="PSA 73:5">और न अन्य मनुष्यों के समान</para>
  <para style="q1" vid="PSA 73:5">उन पर विपत्ति पड़ती है।<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />इस कारण अहंकार उनके</para>
  <para style="q2" vid="PSA 73:6">गले का हार बना है;</para>
  <para style="q1" vid="PSA 73:6">और हिंसा उन्हें</para>
  <para style="q2" vid="PSA 73:6">वस्‍त्र के समान ढाँपती है।<verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />उनकी आँखों पर चरबी छाई है;</para>
  <para style="q2" vid="PSA 73:7">उनके मन की व्यर्थ कल्पनाएँ उमड़ती हैं।<verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />वे ठट्ठा करते हैं</para>
  <para style="q2" vid="PSA 73:8">और दुष्‍टता से अन्याय की</para>
  <para style="q1" vid="PSA 73:8">बात बोलते हैं;</para>
  <para style="q2" vid="PSA 73:8">वे अहंकार के साथ बोलते हैं।<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />उन्होंने अपना मुँह स्वर्ग के विरुद्ध खोला है,</para>
  <para style="q2" vid="PSA 73:9">और उनकी जीभ पृथ्वी पर अकड़कर चलती है।<verse eid="PSA 73:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />इसलिए उसकी<note caller="+" style="f"><char style="fr" closed="false">73:10 </char><char style="ft" closed="false">या परमेश्‍वर की</char></note> प्रजा उनकी ओर फिरेगी,</para>
  <para style="q2" vid="PSA 73:10">और वे भरपूरी के साथ जल पीएँगे।<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />वे कहते हैं,</para>
  <para style="q2" vid="PSA 73:11">“परमेश्‍वर कैसे जानता है?</para>
  <para style="q1" vid="PSA 73:11">क्या परमप्रधान कुछ जानता है?”<verse eid="PSA 73:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />देखो! ये दुष्‍ट लोग हैं,</para>
  <para style="q2" vid="PSA 73:12">फिर भी ये सदा आराम से रहकर</para>
  <para style="q1" vid="PSA 73:12">धन-संपत्ति बटोरते रहते हैं।<verse eid="PSA 73:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13" />निश्‍चय मैंने अपने हृदय को</para>
  <para style="q2" vid="PSA 73:13">व्यर्थ ही शुद्ध रखा,</para>
  <para style="q1" vid="PSA 73:13">और व्यर्थ अपने हाथों को निर्दोषता में धोया है;<verse eid="PSA 73:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14" />क्योंकि मैं दिन भर मार खाता आया हूँ,</para>
  <para style="q2" vid="PSA 73:14">और प्रति भोर</para>
  <para style="q1" vid="PSA 73:14">मेरी ताड़ना होती आई है।<verse eid="PSA 73:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15" />यदि मैं कहता कि</para>
  <para style="q2" vid="PSA 73:15">मैं ऐसा ही कहूँगा,</para>
  <para style="q1" vid="PSA 73:15">तो देख, मैंने तेरे लोगों के साथ</para>
  <para style="q2" vid="PSA 73:15">विश्‍वासघात किया होता।<verse eid="PSA 73:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />जब मैंने सोचा कि इसे कैसे समझूँ,</para>
  <para style="q2" vid="PSA 73:16">तो यह मेरी दृष्‍टि में</para>
  <para style="q1" vid="PSA 73:16">तब तक कठिन समस्या बनी रही,<verse eid="PSA 73:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17" />जब तक कि मैंने परमेश्‍वर के</para>
  <para style="q2" vid="PSA 73:17">पवित्रस्थान में जाकर</para>
  <para style="q1" vid="PSA 73:17">उन लोगों के परिणाम को न समझ लिया।<verse eid="PSA 73:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />निश्‍चय तू उन्हें फिसलनेवाले स्थानों में रखता है,</para>
  <para style="q2" vid="PSA 73:18">और गिराकर उनका नाश कर देता है।<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />क्षण भर में ही वे</para>
  <para style="q2" vid="PSA 73:19">कैसे उजड़ गए हैं!</para>
  <para style="q1" vid="PSA 73:19">उनका अंत हो गया है;</para>
  <para style="q2" vid="PSA 73:19">वे भयभीत होकर मर मिटे हैं।<verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />जैसे कोई जाग उठने पर</para>
  <para style="q2" vid="PSA 73:20">स्वप्‍न को तुच्छ जानता है,</para>
  <para style="q1" vid="PSA 73:20">वैसे ही हे प्रभु,</para>
  <para style="q2" vid="PSA 73:20">जब तू जाग उठेगा,</para>
  <para style="q1" vid="PSA 73:20">तो उन्हें छाया के समान तुच्छ जानेगा।<verse eid="PSA 73:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />जब मेरा मन कड़वा था,</para>
  <para style="q2" vid="PSA 73:21">और मेरा अंतःकरण छिद गया था,<verse eid="PSA 73:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22" />तब मैं निर्बुद्धि और नासमझ था,</para>
  <para style="q2" vid="PSA 73:22">और तेरे सम्मुख पशु के समान था।<verse eid="PSA 73:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />फिर भी मैं निरंतर तेरे साथ रहा;</para>
  <para style="q2" vid="PSA 73:23">तूने मेरा दाहिना हाथ थामे रखा।<verse eid="PSA 73:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24" />तू अपनी सम्मति से मेरी अगुवाई करेगा,</para>
  <para style="q2" vid="PSA 73:24">और फिर महिमा में मुझे ग्रहण कर लेगा।<verse eid="PSA 73:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25" />स्वर्ग में मेरा और कौन है?</para>
  <para style="q2" vid="PSA 73:25">तुझे छोड़ मैं पृथ्वी पर कुछ</para>
  <para style="q1" vid="PSA 73:25">और नहीं चाहता।<verse eid="PSA 73:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26" />चाहे मेरा शरीर और मन दोनों हार जाएँ,</para>
  <para style="q2" vid="PSA 73:26">फिर भी परमेश्‍वर सदा के लिए मेरे हृदय का बल</para>
  <para style="q1" vid="PSA 73:26">और मेरा भाग है।<verse eid="PSA 73:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27" />देख, जो तुझसे दूर हैं,</para>
  <para style="q2" vid="PSA 73:27">वे नाश होंगे;</para>
  <para style="q1" vid="PSA 73:27">जो तेरे प्रति विश्‍वासयोग्य नहीं हैं,</para>
  <para style="q2" vid="PSA 73:27">उन सब को तूने नष्‍ट कर दिया है।<verse eid="PSA 73:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28" />परंतु मेरे लिए परमेश्‍वर के निकट रहना भला है।</para>
  <para style="q2" vid="PSA 73:28">मैंने प्रभु यहोवा को अपना शरणस्थान माना है,</para>
  <para style="q1" vid="PSA 73:28">ताकि मैं उसके सब कार्यों का वर्णन करूँ।<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s1">इस्राएल के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">आसाफ का मश्कील।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1" />हे परमेश्‍वर, तूने हमें सदा के लिए</para>
  <para style="q2" vid="PSA 74:1">क्यों त्याग दिया है?</para>
  <para style="q1" vid="PSA 74:1">तेरी क्रोधाग्‍नि का धुआँ तेरे चरागाह की भेड़ों</para>
  <para style="q2" vid="PSA 74:1">के विरुद्ध क्यों उठ रहा है?<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />अपनी मंडली को स्मरण कर,</para>
  <para style="q2" vid="PSA 74:2">जिसे तूने प्राचीनकाल में मोल लेकर</para>
  <para style="q1" vid="PSA 74:2">अपनी मीरास का गोत्र होने के लिए छुड़ाया था;</para>
  <para style="q2" vid="PSA 74:2">और इस सिय्योन पर्वत को भी स्मरण कर,</para>
  <para style="q1" vid="PSA 74:2">जिस पर तूने वास किया था!<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />अपने कदम अनंत खंडहरों</para>
  <para style="q2" vid="PSA 74:3">अर्थात् उस संपूर्ण विनाश की ओर बढ़ा,</para>
  <para style="q1" vid="PSA 74:3">जो शत्रु ने पवित्रस्थान में किया है।<verse eid="PSA 74:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />तेरे बैरी तेरे सभा-स्थल के मध्य गरजे हैं,</para>
  <para style="q2" vid="PSA 74:4">उन्होंने चिह्‍नों के रूप में</para>
  <para style="q1" vid="PSA 74:4">अपनी ध्वजाओं को गाड़ दिया है।<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />वे उन मनुष्यों के समान हैं</para>
  <para style="q2" vid="PSA 74:5">जो घने वन के वृक्षों पर कुल्हाड़े चलाते हैं;<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />और अब वे कुल्हाड़ी और हथौड़ों से</para>
  <para style="q2" vid="PSA 74:6">उसकी सब नक्‍‍काशी को तहस-नहस करते हैं।<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />उन्होंने तेरे पवित्रस्थान को आग में झोंक दिया है,</para>
  <para style="q2" vid="PSA 74:7">और तेरे नाम के निवासस्थान को</para>
  <para style="q1" vid="PSA 74:7">गिराकर अशुद्ध कर डाला है।<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />उन्होंने मन में कहा है,</para>
  <para style="q2" vid="PSA 74:8">“हम उन्हें पूरी तरह से कुचल डालें।”</para>
  <para style="q1" vid="PSA 74:8">उन्होंने इस देश में परमेश्‍वर के</para>
  <para style="q2" vid="PSA 74:8">सब सभा-स्थलों को जला डाला है।<verse eid="PSA 74:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />हमें अपने चिह्‍न दिखाई नहीं देते;</para>
  <para style="q2" vid="PSA 74:9">अब कोई भविष्यवक्‍ता नहीं रहा,</para>
  <para style="q1" vid="PSA 74:9">और न हमारे बीच कोई जानता है</para>
  <para style="q2" vid="PSA 74:9">कि यह दशा कब तक रहेगी।<verse eid="PSA 74:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />हे परमेश्‍वर, बैरी कब तक</para>
  <para style="q2" vid="PSA 74:10">निंदा करता रहेगा?</para>
  <para style="q1" vid="PSA 74:10">क्या शत्रु तेरे नाम का</para>
  <para style="q2" vid="PSA 74:10">तिरस्कार सदा करता रहेगा?<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />तू अपना हाथ,</para>
  <para style="q2" vid="PSA 74:11">हाँ अपना दाहिना हाथ क्यों रोक लेता है?</para>
  <para style="q1" vid="PSA 74:11">उसे अपने सीने से हटा</para>
  <para style="q2" vid="PSA 74:11">और उनका नाश कर दे।<verse eid="PSA 74:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12" />परमेश्‍वर तो प्राचीनकाल से मेरा राजा है,</para>
  <para style="q2" vid="PSA 74:12">वह पृथ्वी पर छुटकारे के कार्य करता आया है।<verse eid="PSA 74:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13" />तूने तो अपने सामर्थ्य से समुद्र को</para>
  <para style="q2" vid="PSA 74:13">दो भाग कर दिया;</para>
  <para style="q1" vid="PSA 74:13">तूने जल में मगरमच्छों के सिर फोड़ डाले।<verse eid="PSA 74:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14" />तूने लिव्यातान<note caller="+" style="f"><char style="fr" closed="false">74:14 </char><char style="ft" closed="false">या जल दैत्य</char></note> के सिर कुचले,</para>
  <para style="q2" vid="PSA 74:14">और उसे वन-पशुओं का</para>
  <para style="q1" vid="PSA 74:14">आहार बनने के लिए दे दिया।<verse eid="PSA 74:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15" />तूने सोतों और जल-धाराओं को खोला;</para>
  <para style="q2" vid="PSA 74:15">तूने बारहमासी नदियों को सुखा डाला।<verse eid="PSA 74:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16" />दिन तेरा है,</para>
  <para style="q2" vid="PSA 74:16">रात भी तेरी है;</para>
  <para style="q1" vid="PSA 74:16">तूने ही सूर्य और चंद्रमा को स्थिर किया है।<verse eid="PSA 74:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17" />तूने तो पृथ्वी की सब सीमाओं को ठहराया;</para>
  <para style="q2" vid="PSA 74:17">ग्रीष्मकाल और शीतकाल तूने ही ठहराए हैं।<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18" />हे यहोवा, स्मरण कर</para>
  <para style="q2" vid="PSA 74:18">कि शत्रु ने तेरी निंदा की है,</para>
  <para style="q1" vid="PSA 74:18">और मूर्ख लोगों ने</para>
  <para style="q2" vid="PSA 74:18">तेरे नाम का तिरस्कार किया है।<verse eid="PSA 74:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19" />अपनी पंडुकी का प्राण जंगली पशु को न सौंप;</para>
  <para style="q2" vid="PSA 74:19">अपने दीन जनों को</para>
  <para style="q1" vid="PSA 74:19">सदा के लिए न भूल।<verse eid="PSA 74:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20" />अपनी वाचा की सुधि ले,</para>
  <para style="q2" vid="PSA 74:20">क्योंकि देश के अंधेरे स्थान अत्याचार के</para>
  <para style="q1" vid="PSA 74:20">अड्डे बन गए हैं।<verse eid="PSA 74:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21" />पिसे हुए व्यक्‍ति को अपमानित होकर लौटना न पड़े;</para>
  <para style="q2" vid="PSA 74:21">दीन और दरिद्र लोग</para>
  <para style="q1" vid="PSA 74:21">तेरे नाम की स्तुति करें।<verse eid="PSA 74:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22" />हे परमेश्‍वर, उठ,</para>
  <para style="q2" vid="PSA 74:22">अपना पक्ष प्रस्तुत कर;</para>
  <para style="q1" vid="PSA 74:22">तेरी निंदा जो मूर्ख दिन भर करता रहता है,</para>
  <para style="q2" vid="PSA 74:22">उसे स्मरण कर।<verse eid="PSA 74:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23" />अपने बैरियों की ऊँची आवाज़ को,</para>
  <para style="q2" vid="PSA 74:23">और अपने विरोधियों के निरंतर बढ़ते कोलाहल को न भूल।<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s1">परमेश्‍वर दुष्‍‍टों को दंड देता है</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। अल तशहेत की राग पर आसाफ का भजन। एक गीत।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1" />हे परमेश्‍वर, हम तेरा धन्यवाद करते हैं,</para>
  <para style="q2" vid="PSA 75:1">हम तेरे नाम का धन्यवाद करते हैं;</para>
  <para style="q1" vid="PSA 75:1">क्योंकि तेरा नाम हमारे निकट है।</para>
  <para style="q2" vid="PSA 75:1">लोग तेरे आश्‍चर्यकर्मों का वर्णन करते हैं।<verse eid="PSA 75:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />“जब निर्धारित समय आएगा,</para>
  <para style="q2" vid="PSA 75:2">तो मैं खराई से न्याय करूँगा।<verse eid="PSA 75:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3" />जब पृथ्वी अपने सब रहनेवालों समेत डगमगाने लगती है,</para>
  <para style="q2" vid="PSA 75:3">तब मैं ही उसके स्तंभों को स्थिर करता हूँ। सेला।<verse eid="PSA 75:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4" />मैंने घमंडियों से कहा,</para>
  <para style="q2" vid="PSA 75:4">‘घमंड मत करो,’</para>
  <para style="q1" vid="PSA 75:4">और दुष्‍टों से,</para>
  <para style="q2" vid="PSA 75:4">‘अपना सींग ऊँचा मत करो;<verse eid="PSA 75:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5" />हाँ, अपना सींग ऊँचा मत करो,</para>
  <para style="q2" vid="PSA 75:5">और न अकड़कर ढिठाई की बात बोलो।’ ”<verse eid="PSA 75:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />उन्‍नति न तो पूर्व से</para>
  <para style="q2" vid="PSA 75:6">न पश्‍चिम से, और न जंगल से आती है;<verse eid="PSA 75:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7" />परंतु परमेश्‍वर ही न्यायी है;</para>
  <para style="q2" vid="PSA 75:7">वही एक को नीचा करता है,</para>
  <para style="q1" vid="PSA 75:7">और दूसरे को उठाता है।<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />यहोवा के हाथ में एक कटोरा है,</para>
  <para style="q2" vid="PSA 75:8">जिसमें झागवाला दाखमधु है;</para>
  <para style="q1" vid="PSA 75:8">उसमें मसाला मिला है,</para>
  <para style="q2" vid="PSA 75:8">और वह उसमें से उँडेलता है।</para>
  <para style="q1" vid="PSA 75:8">निश्‍चय पृथ्वी के सब दुष्‍ट लोग</para>
  <para style="q2" vid="PSA 75:8">उसकी अंतिम बूँद तक पी जाएँगे।<verse eid="PSA 75:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9" />परंतु मैं तो सदा उसका प्रचार करता रहूँगा,</para>
  <para style="q2" vid="PSA 75:9">मैं याकूब के परमेश्‍वर का भजन गाऊँगा।<verse eid="PSA 75:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />“मैं दुष्‍टों के सब सींगों को काट डालूँगा,</para>
  <para style="q2" vid="PSA 75:10">परंतु धर्मी के सींग ऊँचे किए जाएँगे।”<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s1">पराक्रमी परमेश्‍वर</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। तारवाले वाद्य-यंत्रों के साथ आसाफ का भजन। एक गीत।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1" />परमेश्‍वर यहूदा में जाना गया है,</para>
  <para style="q2" vid="PSA 76:1">उसका नाम इस्राएल में महान है।<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />उसका तंबू शालेम में,</para>
  <para style="q2" vid="PSA 76:2">और उसका निवासस्थान सिय्योन में है।<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />वहाँ उसने जलते तीरों को,</para>
  <para style="q2" vid="PSA 76:3">और ढाल तथा तलवार को,</para>
  <para style="q1" vid="PSA 76:3">और युद्ध के हथियारों को तोड़ डाला है।</para>
  <para style="q2" vid="PSA 76:3">सेला।<verse eid="PSA 76:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />हे परमेश्‍वर, तू तो ज्योतिर्मय है,</para>
  <para style="q2" vid="PSA 76:4">तू अहेर से भरे पहाड़ों से अधिक ऐश्‍वर्यवान है।<verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />निडर मनवाले लुट गए,</para>
  <para style="q2" vid="PSA 76:5">और गहरी नींद में पड़े हैं;</para>
  <para style="q1" vid="PSA 76:5">शूरवीरों में से कोई भी</para>
  <para style="q2" vid="PSA 76:5">अपना हाथ न चला सका।<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />हे याकूब के परमेश्‍वर,</para>
  <para style="q2" vid="PSA 76:6">तेरी घुड़की से रथ के सवार</para>
  <para style="q1" vid="PSA 76:6">और घोड़े गहरी नींद में पड़े हैं।<verse eid="PSA 76:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />केवल तू ही भययोग्य है;</para>
  <para style="q2" vid="PSA 76:7">और जब तेरा क्रोध भड़क उठता है</para>
  <para style="q1" vid="PSA 76:7">तो तेरे सामने कौन खड़ा रह सकता है?<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8" />तूने स्वर्ग से निर्णय सुनाया,</para>
  <para style="q2" vid="PSA 76:8">और पृथ्वी डर गई और चुप रही; <verse eid="PSA 76:8" /><verse number="9" style="v" sid="PSA 76:9" />यह तब हुआ जब परमेश्‍वर न्याय करने और पृथ्वी के सब नम्र लोगों को बचाने के लिए उठा। सेला।<verse eid="PSA 76:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />मनुष्य का क्रोध भी तेरी स्तुति करेगा;</para>
  <para style="q2" vid="PSA 76:10">और जो क्रोध रह जाए</para>
  <para style="q1" vid="PSA 76:10">उससे तू अपनी कमर कसेगा।<verse eid="PSA 76:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />अपने परमेश्‍वर यहोवा के सामने मन्‍नतें मानो</para>
  <para style="q2" vid="PSA 76:11">और उन्हें पूरी भी करो;</para>
  <para style="q1" vid="PSA 76:11">वह जो भय के योग्य है,</para>
  <para style="q2" vid="PSA 76:11">उसके आस-पास के सब लोग</para>
  <para style="q1" vid="PSA 76:11">उसके लिए भेंट लाएँ।<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />वह तो शासकों का अभिमान मिटा देगा;</para>
  <para style="q2" vid="PSA 76:12">वह पृथ्वी के राजाओं के लिए भययोग्य है।<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s1">संकट के समय में भरोसा</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। यदूतून की राग पर आसाफ का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1" />मैं ऊँची आवाज़ से परमेश्‍वर की दुहाई दूँगा;</para>
  <para style="q2" vid="PSA 77:1">हाँ, मैं परमेश्‍वर की दुहाई दूँगा,</para>
  <para style="q1" vid="PSA 77:1">और वह मेरी सुन लेगा।<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />संकट के दिन मैं प्रभु की</para>
  <para style="q2" vid="PSA 77:2">खोज में लगा रहा,</para>
  <para style="q1" vid="PSA 77:2">रात भर मेरे हाथ फैले रहे</para>
  <para style="q2" vid="PSA 77:2">और ढीले न पड़े;</para>
  <para style="q1" vid="PSA 77:2">मेरा प्राण बेचैन रहा।<verse eid="PSA 77:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />परमेश्‍वर का स्मरण करके मैं कराहता हूँ;</para>
  <para style="q2" vid="PSA 77:3">चिंता करते-करते</para>
  <para style="q1" vid="PSA 77:3">मैं मूर्च्छित होने लगता हूँ।</para>
  <para style="q2" vid="PSA 77:3">सेला।<verse eid="PSA 77:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4" />तू मुझे पलकें झपकाने नहीं देता।</para>
  <para style="q2" vid="PSA 77:4">मैं इतना घबरा गया हूँ</para>
  <para style="q1" vid="PSA 77:4">कि कुछ बोल नहीं पाता।<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />मैंने पुराने दिनों पर,</para>
  <para style="q2" vid="PSA 77:5">और प्राचीनकाल के वर्षों पर विचार किया है।<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />मैं रात के समय अपना गीत स्मरण करता हूँ;</para>
  <para style="q2" vid="PSA 77:6">मैं मन ही मन ध्यान करता हूँ,</para>
  <para style="q1" vid="PSA 77:6">और मेरी आत्मा मनन करती है :<verse eid="PSA 77:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7" />“क्या प्रभु सदा के लिए त्याग देगा,</para>
  <para style="q2" vid="PSA 77:7">और फिर कभी प्रसन्‍न न होगा?<verse eid="PSA 77:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8" />क्या उसकी करुणा सदा के लिए मिट गई है?</para>
  <para style="q2" vid="PSA 77:8">क्या उसकी प्रतिज्ञा पीढ़ी-पीढ़ी के लिए</para>
  <para style="q1" vid="PSA 77:8">निष्फल हो गई है?<verse eid="PSA 77:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9" />क्या परमेश्‍वर अनुग्रह करना भूल गया है?</para>
  <para style="q2" vid="PSA 77:9">क्या उसने क्रोध में आकर</para>
  <para style="q1" vid="PSA 77:9">अपनी दया को रोक रखा है?”</para>
  <para style="q2" vid="PSA 77:9">सेला।<verse eid="PSA 77:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />तब मैंने कहा,</para>
  <para style="q2" vid="PSA 77:10">“मेरा दुःख तो यह है</para>
  <para style="q1" vid="PSA 77:10">कि परमप्रधान का दाहिना हाथ बदल गया है।”<verse eid="PSA 77:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />मैं याह के कार्यों का स्मरण करूँगा;</para>
  <para style="q2" vid="PSA 77:11">हाँ, मैं तेरे प्राचीनकाल के</para>
  <para style="q1" vid="PSA 77:11">अद्भुत कार्यों का स्मरण करूँगा।<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />मैं तेरे सब कार्यों पर ध्यान लगाऊँगा,</para>
  <para style="q2" vid="PSA 77:12">और तेरे कार्यों पर मनन करूँगा।<verse eid="PSA 77:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />हे परमेश्‍वर तेरा मार्ग पवित्र है।</para>
  <para style="q2" vid="PSA 77:13">कौन सा देवता परमेश्‍वर के तुल्य महान है?<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />तू ही अद्भुत कार्य करनेवाला परमेश्‍वर है;</para>
  <para style="q2" vid="PSA 77:14">तूने देश-देश के लोगों पर</para>
  <para style="q1" vid="PSA 77:14">अपना सामर्थ्य प्रकट किया है।<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />तूने अपने भुजबल से अपनी प्रजा को</para>
  <para style="q2" vid="PSA 77:15">अर्थात् याकूब और यूसुफ की संतान को छुड़ा लिया है।</para>
  <para style="q1" vid="PSA 77:15">सेला।<verse eid="PSA 77:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />हे परमेश्‍वर, समुद्र ने तुझे देखा,</para>
  <para style="q2" vid="PSA 77:16">हाँ, समुद्र ने तुझे देखा</para>
  <para style="q1" vid="PSA 77:16">और वह डर गया;</para>
  <para style="q2" vid="PSA 77:16">गहरा सागर भी काँप उठा।<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />मेघों ने जल बरसाया,</para>
  <para style="q2" vid="PSA 77:17">आकाश गरज उठा,</para>
  <para style="q1" vid="PSA 77:17">और तेरे तीर चारों ओर चलने लगे।<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />बवंडर में से तेरे गरजने की आवाज़ सुनाई दी;</para>
  <para style="q2" vid="PSA 77:18">जगत बिजली से प्रकाशित हो उठा;</para>
  <para style="q1" vid="PSA 77:18">पृथ्वी काँप उठी और हिल गई।<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />तेरा मार्ग समुद्र में,</para>
  <para style="q2" vid="PSA 77:19">और तेरा पथ गहरे जल में था;</para>
  <para style="q1" vid="PSA 77:19">और तेरे पद-चिह्‍नों का</para>
  <para style="q2" vid="PSA 77:19">कुछ पता न चला।<verse eid="PSA 77:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />तूने मूसा और हारून के द्वारा</para>
  <para style="q2" vid="PSA 77:20">अपनी प्रजा की अगुवाई भेड़ों के झुंड के समान की है।<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s1">परमेश्‍वर और उसके लोग</para>
  <para style="b" />
  <para style="d">आसाफ का मश्कील।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1" />हे मेरे लोगो,</para>
  <para style="q2" vid="PSA 78:1">मेरी शिक्षा को सुनो;</para>
  <para style="q1" vid="PSA 78:1">मेरे मुँह के वचनों पर कान लगाओ।<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />मैं दृष्‍टांत कहने के लिए अपना मुँह खोलूँगा;</para>
  <para style="q2" vid="PSA 78:2">मैं प्राचीनकाल की गुप्‍त बातें बताऊँगा,<verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />जिन्हें हमने सुना और जाना है,</para>
  <para style="q2" vid="PSA 78:3">और जिनका वर्णन हमारे बापदादों ने</para>
  <para style="q1" vid="PSA 78:3">हमसे किया था।<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />उन्हें हम उनकी संतानों से गुप्‍त नहीं रखेंगे,</para>
  <para style="q2" vid="PSA 78:4">बल्कि आने वाली पीढ़ी से यहोवा की स्तुति,</para>
  <para style="q1" vid="PSA 78:4">उसके सामर्थ्य और उसके आश्‍चर्यकर्मों का वर्णन करेंगे।<verse eid="PSA 78:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />उसने याकूब में एक साक्षी स्थापित की है</para>
  <para style="q2" vid="PSA 78:5">और इस्राएल में एक व्यवस्था नियुक्‍त की है,</para>
  <para style="q1" vid="PSA 78:5">जिनके विषय उसने हमारे पूर्वजों को आज्ञा दी</para>
  <para style="q2" vid="PSA 78:5">कि वे उनकी शिक्षा अपनी संतानों को दें;<verse eid="PSA 78:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6" />ताकि आने वाली पीढ़ी,</para>
  <para style="q2" vid="PSA 78:6">अर्थात् भविष्य में उत्पन्‍न‍ होने वाली संतान भी</para>
  <para style="q1" vid="PSA 78:6">इन्हें जानें और आगे अपनी-अपनी</para>
  <para style="q2" vid="PSA 78:6">संतानों से भी इनका वर्णन करें;<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />जिससे वे परमेश्‍वर पर भरोसा रखें,</para>
  <para style="q2" vid="PSA 78:7">और परमेश्‍वर के कार्यों को भूल न जाएँ,</para>
  <para style="q1" vid="PSA 78:7">बल्कि उसकी आज्ञाओं का पालन करते रहें;<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />और अपने पूर्वजों के समान न बनें,</para>
  <para style="q2" vid="PSA 78:8">क्योंकि उस पीढ़ी के लोग तो</para>
  <para style="q1" vid="PSA 78:8">हठीले और विद्रोही थे,</para>
  <para style="q2" vid="PSA 78:8">और उन्होंने न तो अपना मन स्थिर किया था,</para>
  <para style="q1" vid="PSA 78:8">और न ही उनकी आत्मा</para>
  <para style="q2" vid="PSA 78:8">परमेश्‍वर के प्रति सच्‍ची थी।<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />एप्रैमियों ने शस्‍त्रधारी और धनुर्धारी होकर भी</para>
  <para style="q2" vid="PSA 78:9">युद्ध के समय पीठ दिखा दी।<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />उन्होंने परमेश्‍वर की वाचा का पालन नहीं किया,</para>
  <para style="q2" vid="PSA 78:10">और उसकी व्यवस्था पर</para>
  <para style="q1" vid="PSA 78:10">चलने से इनकार कर दिया।<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />उन्होंने उसके पराक्रम के कार्यों को</para>
  <para style="q2" vid="PSA 78:11">और उन आश्‍चर्यकर्मों को भुला दिया,</para>
  <para style="q1" vid="PSA 78:11">जो उसने उनके सामने किए थे।<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />उसने तो उनके पूर्वजों के सामने मिस्र देश के</para>
  <para style="q2" vid="PSA 78:12">सोअन के प्रदेश में अद्भुत कार्य किए थे।<verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />उसने समुद्र को दो भाग करके</para>
  <para style="q2" vid="PSA 78:13">उन्हें पार करा दिया,</para>
  <para style="q1" vid="PSA 78:13">और जल को ढेर के समान खड़ा कर दिया।<verse eid="PSA 78:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14" />उसने दिन में बादल के द्वारा</para>
  <para style="q2" vid="PSA 78:14">और रात भर अग्‍नि के प्रकाश के द्वारा</para>
  <para style="q1" vid="PSA 78:14">उनकी अगुवाई की।<verse eid="PSA 78:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15" />उसने जंगल में चट्टानें फाड़कर उन्हें</para>
  <para style="q2" vid="PSA 78:15">मानो गहरे जलाशयों से भरपूरी के साथ जल पिलाया।<verse eid="PSA 78:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16" />उसने चट्टान में से जल की धाराएँ निकालीं</para>
  <para style="q2" vid="PSA 78:16">और नदियों का सा जल बहाया।<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17" />फिर भी वे उसके विरुद्ध पाप करते रहे,</para>
  <para style="q2" vid="PSA 78:17">और मरुभूमि में परमप्रधान परमेश्‍वर के विरुद्ध विद्रोह करते रहे।<verse eid="PSA 78:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18" />उन्होंने अपनी इच्छा के अनुसार</para>
  <para style="q2" vid="PSA 78:18">भोजन माँगकर मन ही मन परमेश्‍वर की परीक्षा की।<verse eid="PSA 78:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19" />तब उन्होंने परमेश्‍वर के विरुद्ध कहा,</para>
  <para style="q2" vid="PSA 78:19">“क्या परमेश्‍वर जंगल में भोजन का</para>
  <para style="q1" vid="PSA 78:19">प्रबंध कर सकता है?<verse eid="PSA 78:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20" />उसने चट्टान पर मारकर जल तो बहा दिया,</para>
  <para style="q2" vid="PSA 78:20">और जल-धाराएँ भी उमड़ पड़ीं,</para>
  <para style="q1" vid="PSA 78:20">परंतु क्या वह रोटी दे सकता है?</para>
  <para style="q2" vid="PSA 78:20">क्या वह अपनी प्रजा के लिए</para>
  <para style="q1" vid="PSA 78:20">मांस का प्रबंध कर सकता है?”<verse eid="PSA 78:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21" />यह सुनकर यहोवा क्रोधित हुआ,</para>
  <para style="q2" vid="PSA 78:21">और याकूब के विरुद्ध आग भड़क उठी,</para>
  <para style="q1" vid="PSA 78:21">और वह इस्राएल के विरुद्ध क्रोध से भर गया;<verse eid="PSA 78:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22" />क्योंकि उन्होंने न तो परमेश्‍वर पर विश्‍वास किया था,</para>
  <para style="q2" vid="PSA 78:22">और न ही उसके उद्धार पर भरोसा रखा था।<verse eid="PSA 78:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23" />फिर भी उसने आकाश के बादलों को आज्ञा दी,</para>
  <para style="q2" vid="PSA 78:23">और स्वर्ग के द्वार खोल दिए।<verse eid="PSA 78:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24" />उसने उनके खाने के लिए मन्‍ना बरसाया,</para>
  <para style="q2" vid="PSA 78:24">और स्वर्ग से अन्‍न दिया।<verse eid="PSA 78:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25" />मनुष्यों ने स्वर्गदूतों की रोटी खाई।</para>
  <para style="q2" vid="PSA 78:25">उसने उन्हें भोजन से तृप्‍त किया।<verse eid="PSA 78:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26" />उसने आकाश में पूर्वी हवा चलाई,</para>
  <para style="q2" vid="PSA 78:26">और अपने सामर्थ्य से दक्षिणी हवा बहाई।<verse eid="PSA 78:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27" />तब उसने उन पर धूल के कणों के समान मांस की,</para>
  <para style="q2" vid="PSA 78:27">हाँ, समुद्र के बालू के समान</para>
  <para style="q1" vid="PSA 78:27">पंखवाले पक्षियों की वर्षा की;<verse eid="PSA 78:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28" />और उसने उन्हें उनकी छावनी के बीच,</para>
  <para style="q2" vid="PSA 78:28">उनके तंबुओं के चारों ओर गिराया।<verse eid="PSA 78:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29" />उन्होंने खाया और वे पूरी तरह से तृप्‍त हुए;</para>
  <para style="q2" vid="PSA 78:29">उसने उन्हें उनकी इच्छा के अनुसार दिया।<verse eid="PSA 78:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30" />उनकी इच्छा पूरी होने से पहले,</para>
  <para style="q2" vid="PSA 78:30">जब उनका भोजन उनके मुँह में ही था,<verse eid="PSA 78:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31" />तभी परमेश्‍वर का क्रोध उन पर भड़क उठा।</para>
  <para style="q2" vid="PSA 78:31">उसने उनके कई बलवानों को मार डाला,</para>
  <para style="q1" vid="PSA 78:31">और इस्राएल के जवानों को धराशायी कर दिया।<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32" />इतना होने पर भी</para>
  <para style="q2" vid="PSA 78:32">वे पाप करते गए,</para>
  <para style="q1" vid="PSA 78:32">और उन्होंने परमेश्‍वर के आश्‍चर्यकर्मों पर</para>
  <para style="q2" vid="PSA 78:32">विश्‍वास नहीं किया।<verse eid="PSA 78:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33" />तब उसने उनके दिनों को व्यर्थ बातों में,</para>
  <para style="q2" vid="PSA 78:33">और उनके वर्षों को</para>
  <para style="q1" vid="PSA 78:33">आतंक में कटवाया।<verse eid="PSA 78:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34" />जब वह उन्हें घात करने लगता</para>
  <para style="q2" vid="PSA 78:34">तो वे उसे खोजते</para>
  <para style="q1" vid="PSA 78:34">और फिरकर परमेश्‍वर को</para>
  <para style="q2" vid="PSA 78:34">यत्‍न से ढूँढ़ने लगते।<verse eid="PSA 78:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35" />उन्हें स्मरण आता था</para>
  <para style="q2" vid="PSA 78:35">कि परमेश्‍वर हमारी चट्टान है,</para>
  <para style="q1" vid="PSA 78:35">और परमप्रधान परमेश्‍वर हमारा छुड़ानेवाला है।<verse eid="PSA 78:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36" />फिर भी उन्होंने अपने मुँह से उसकी चापलूसी की,</para>
  <para style="q2" vid="PSA 78:36">और अपनी जीभ से उससे झूठ बोला।<verse eid="PSA 78:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37" />क्योंकि न तो उनका हृदय उसके प्रति स्थिर था,</para>
  <para style="q2" vid="PSA 78:37">और न वे उसकी वाचा के प्रति सच्‍चे थे।<verse eid="PSA 78:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38" />परंतु दयालु होने के कारण उसने</para>
  <para style="q2" vid="PSA 78:38">उनके अधर्म को क्षमा किया,</para>
  <para style="q1" vid="PSA 78:38">और उनका नाश नहीं किया;</para>
  <para style="q2" vid="PSA 78:38">उसने कई बार अपने क्रोध को रोका,</para>
  <para style="q1" vid="PSA 78:38">और अपने प्रकोप को पूरी रीति से</para>
  <para style="q2" vid="PSA 78:38">भड़कने नहीं दिया।<verse eid="PSA 78:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39" />उसे स्मरण रहा</para>
  <para style="q2" vid="PSA 78:39">कि वे तो नश्‍वर हैं,</para>
  <para style="q1" vid="PSA 78:39">अर्थात् उस वायु के समान हैं,</para>
  <para style="q2" vid="PSA 78:39">जो चली जाती है और लौटकर नहीं आती।<verse eid="PSA 78:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40" />उन्होंने जंगल में कितनी बार</para>
  <para style="q2" vid="PSA 78:40">उसके विरुद्ध विद्रोह किया,</para>
  <para style="q1" vid="PSA 78:40">और मरुभूमि में उसे दुःख पहुँचाया।<verse eid="PSA 78:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41" />उन्होंने बार-बार परमेश्‍वर की परीक्षा की,</para>
  <para style="q2" vid="PSA 78:41">और इस्राएल के पवित्र को शोकित किया।<verse eid="PSA 78:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42" />उन्होंने उसके सामर्थ्य को स्मरण नहीं रखा,</para>
  <para style="q2" vid="PSA 78:42">न उस दिन को</para>
  <para style="q1" vid="PSA 78:42">जब उसने उन्हें शत्रु के हाथ से छुड़ाया था;<verse eid="PSA 78:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43" />और न ही यह कि</para>
  <para style="q2" vid="PSA 78:43">कैसे उसने मिस्र में अपने चिह्‍न</para>
  <para style="q1" vid="PSA 78:43">और सोअन के प्रदेश में</para>
  <para style="q2" vid="PSA 78:43">अपने आश्‍चर्यकर्म दिखाए थे।<verse eid="PSA 78:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44" />उसने तो मिस्रियों की नदियों को लहू बना डाला,</para>
  <para style="q2" vid="PSA 78:44">और वे अपनी नदियों का जल पी न सके।<verse eid="PSA 78:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45" />उसने उनके बीच डाँसों के झुंड भेजे</para>
  <para style="q2" vid="PSA 78:45">जिन्होंने उन्हें काटा,</para>
  <para style="q1" vid="PSA 78:45">और मेंढक भेजे</para>
  <para style="q2" vid="PSA 78:45">जिन्होंने उन्हें उजाड़ दिया।<verse eid="PSA 78:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46" />उसने उनकी भूमि की उपज कीड़ों को,</para>
  <para style="q2" vid="PSA 78:46">और उनके परिश्रम का फल<note caller="+" style="f"><char style="fr" closed="false">78:46 </char><char style="ft" closed="false">या उनकी फसलों को</char></note></para>
  <para style="q1" vid="PSA 78:46">टिड्डियों को खिला दिया।<verse eid="PSA 78:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47" />उसने उनकी दाखलताओं को ओलों से,</para>
  <para style="q2" vid="PSA 78:47">और उनके गूलर के वृक्षों को</para>
  <para style="q1" vid="PSA 78:47">पाले से नष्‍ट कर दिया।<verse eid="PSA 78:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48" />उसने उनके पशुओं को ओलों से,</para>
  <para style="q2" vid="PSA 78:48">और उनकी भेड़-बकरियों को</para>
  <para style="q1" vid="PSA 78:48">बिजलियों से मार डाला।<verse eid="PSA 78:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49" />उसने विनाशकारी दूतों का दल भेजकर</para>
  <para style="q2" vid="PSA 78:49">उन पर अपना प्रचंड क्रोध, रोष</para>
  <para style="q1" vid="PSA 78:49">और कोप प्रकट किया,</para>
  <para style="q2" vid="PSA 78:49">और उन्हें संकट में डाला।<verse eid="PSA 78:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50" />उसने अपने क्रोध का मार्ग खोला</para>
  <para style="q2" vid="PSA 78:50">और उनके प्राणों को मृत्यु से नहीं बचाया,</para>
  <para style="q1" vid="PSA 78:50">बल्कि उन्हें महामारी को सौंप दिया,<verse eid="PSA 78:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51" />और मिस्र के सब पहलौठों को मार डाला,</para>
  <para style="q2" vid="PSA 78:51">जो हाम के तंबुओं में</para>
  <para style="q1" vid="PSA 78:51">उनके पौरुष के प्रथम फल थे।<verse eid="PSA 78:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52" />परंतु वह अपनी प्रजा को भेड़ों के समान ले चला</para>
  <para style="q2" vid="PSA 78:52">और उसने जंगल में</para>
  <para style="q1" vid="PSA 78:52">उनकी अगुवाई झुंड के समान की।<verse eid="PSA 78:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53" />वह उन्हें सुरक्षित ले चला,</para>
  <para style="q2" vid="PSA 78:53">और वे भयभीत न हुए;</para>
  <para style="q1" vid="PSA 78:53">जबकि उनके शत्रु समुद्र में समा गए।<verse eid="PSA 78:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54" />वह उन्हें अपने पवित्र देश</para>
  <para style="q2" vid="PSA 78:54">अर्थात् इस पहाड़ी देश में ले आया,</para>
  <para style="q1" vid="PSA 78:54">जिसे उसने अपने दाहिने हाथ से प्राप्‍त किया था।<verse eid="PSA 78:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55" />उसने उनके सामने से उन अन्यजातियों को खदेड़ दिया,</para>
  <para style="q2" vid="PSA 78:55">और उनकी भूमि को नाप नापकर</para>
  <para style="q1" vid="PSA 78:55">उनका भाग होने के लिए दे दिया,</para>
  <para style="q2" vid="PSA 78:55">तथा उनके डेरों में इस्राएल के गोत्रों को बसा दिया।<verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56" />फिर भी उन्होंने परमप्रधान परमेश्‍वर की परीक्षा की</para>
  <para style="q2" vid="PSA 78:56">और उसके विरुद्ध विद्रोह किया</para>
  <para style="q1" vid="PSA 78:56">तथा उसकी नीतियों का पालन नहीं किया।<verse eid="PSA 78:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57" />अपने पूर्वजों के समान उन्होंने परमेश्‍वर से</para>
  <para style="q2" vid="PSA 78:57">विमुख होकर उसके साथ विश्‍वासघात किया;</para>
  <para style="q1" vid="PSA 78:57">वे धोखा देनेवाले धनुष के समान पलट गए।<verse eid="PSA 78:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58" />उन्होंने ऊँचे स्थान बनाकर</para>
  <para style="q2" vid="PSA 78:58">उसका क्रोध भड़काया, और गढ़ी हुई मूर्तियों</para>
  <para style="q1" vid="PSA 78:58">के कारण उसमें जलन उत्पन्‍न‍ की।<verse eid="PSA 78:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59" />यह देखकर परमेश्‍वर बहुत क्रोधित हुआ,</para>
  <para style="q2" vid="PSA 78:59">और उसने इस्राएल को पूरी तरह से त्याग दिया।<verse eid="PSA 78:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60" />उसने शीलो के निवासस्थान को,</para>
  <para style="q2" vid="PSA 78:60">अर्थात् उस तंबू को त्याग दिया,</para>
  <para style="q1" vid="PSA 78:60">जो उसने मनुष्यों के बीच खड़ा किया था;<verse eid="PSA 78:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61" />और अपने सामर्थ्य को बँधुआई के,</para>
  <para style="q2" vid="PSA 78:61">तथा अपने गौरव को शत्रु के</para>
  <para style="q1" vid="PSA 78:61">वश में कर दिया।<verse eid="PSA 78:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62" />उसने अपनी प्रजा को तलवार से मरवा दिया,</para>
  <para style="q2" vid="PSA 78:62">और उसका क्रोध अपने निज भाग पर भड़क उठा।<verse eid="PSA 78:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63" />आग ने उसके जवानों को भस्म कर दिया,</para>
  <para style="q2" vid="PSA 78:63">और उसकी कुमारियों के लिए विवाह-गीत न गाए गए।<verse eid="PSA 78:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64" />उसके याजक तलवार से मारे गए,</para>
  <para style="q2" vid="PSA 78:64">और उसकी विधवाएँ रो न सकीं।<verse eid="PSA 78:64" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65" />तब प्रभु मानो नींद से जाग उठा,</para>
  <para style="q2" vid="PSA 78:65">और ऐसे वीर के समान उठा</para>
  <para style="q1" vid="PSA 78:65">जो दाखमधु पीकर ललकारता हो।<verse eid="PSA 78:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66" />उसने अपने शत्रुओं को मारकर खदेड़ दिया;</para>
  <para style="q2" vid="PSA 78:66">और उन्हें सदा के लिए अपमानित कर दिया।<verse eid="PSA 78:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67" />उसने यूसुफ के तंबू को त्याग दिया,</para>
  <para style="q2" vid="PSA 78:67">और एप्रैम के गोत्र को भी न चुना,<verse eid="PSA 78:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68" />परंतु उसने यहूदा के गोत्र</para>
  <para style="q2" vid="PSA 78:68">अर्थात् सिय्योन पर्वत को चुन लिया,</para>
  <para style="q1" vid="PSA 78:68">जिससे वह प्रेम करता था।<verse eid="PSA 78:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69" />उसने अपने पवित्रस्थान को बहुत ऊँचा बनाया,</para>
  <para style="q2" vid="PSA 78:69">और पृथ्वी के समान उसे</para>
  <para style="q1" vid="PSA 78:69">सदा के लिए दृढ़ किया।<verse eid="PSA 78:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70" />फिर उसने अपने दास दाऊद को चुना,</para>
  <para style="q2" vid="PSA 78:70">और उसे भेड़शालाओं में से ले आया;<verse eid="PSA 78:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71" />वह उसे दूध पिलानेवाली भेड़ों के पीछे-पीछे</para>
  <para style="q2" vid="PSA 78:71">फिरने से निकाल लाया</para>
  <para style="q1" vid="PSA 78:71">कि वह उसकी प्रजा याकूब की</para>
  <para style="q2" vid="PSA 78:71">अर्थात् उसके निज भाग</para>
  <para style="q1" vid="PSA 78:71">इस्राएल की चरवाही करे।<verse eid="PSA 78:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72" />दाऊद ने खरे मन से उनकी चरवाही की,</para>
  <para style="q2" vid="PSA 78:72">और अपने कुशल हाथों से उनकी अगुवाई की।<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s1">यरूशलेम का विनाश, और सहायता की प्रार्थना</para>
  <para style="b" />
  <para style="d">आसाफ का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1" />हे परमेश्‍वर, जाति-जाति के लोग</para>
  <para style="q2" vid="PSA 79:1">तेरे निज भाग में घुस आए हैं;</para>
  <para style="q1" vid="PSA 79:1">उन्होंने तेरे पवित्र मंदिर को अशुद्ध किया,</para>
  <para style="q2" vid="PSA 79:1">और यरूशलेम को खंडहर बना दिया है।<verse eid="PSA 79:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2" />उन्होंने तेरे सेवकों के शवों को</para>
  <para style="q2" vid="PSA 79:2">आकाश के पक्षियों का आहार कर दिया,</para>
  <para style="q1" vid="PSA 79:2">और तेरे भक्‍तों का मांस पृथ्वी के</para>
  <para style="q2" vid="PSA 79:2">वनपशुओं को खिला दिया है।<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />उन्होंने उनका लहू यरूशलेम के चारों ओर</para>
  <para style="q2" vid="PSA 79:3">जल के समान बहाया,</para>
  <para style="q1" vid="PSA 79:3">और उन्हें मिट्टी देनेवाला कोई न था।<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />हम अपने पड़ोसियों के लिए</para>
  <para style="q2" vid="PSA 79:4">निंदा के पात्र बन गए हैं;</para>
  <para style="q1" vid="PSA 79:4">हमारे आस-पास के लोग</para>
  <para style="q2" vid="PSA 79:4">हम पर हँसते,</para>
  <para style="q1" vid="PSA 79:4">और हमारा ठट्ठा करते हैं।<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />हे यहोवा, कब तक?</para>
  <para style="q2" vid="PSA 79:5">क्या तू सदा के लिए</para>
  <para style="q1" vid="PSA 79:5">हम पर क्रोधित रहेगा?</para>
  <para style="q2" vid="PSA 79:5">क्या तेरी जलन आग</para>
  <para style="q1" vid="PSA 79:5">के समान भड़कती रहेगी?<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />अपना प्रकोप उन जातियों पर उंडेल</para>
  <para style="q2" vid="PSA 79:6">जो तुझे नहीं जानतीं,</para>
  <para style="q1" vid="PSA 79:6">और उन राज्यों के लोगों पर</para>
  <para style="q2" vid="PSA 79:6">जो तुझसे प्रार्थना नहीं करते।<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />क्योंकि उन्होंने याकूब को निगल लिया,</para>
  <para style="q2" vid="PSA 79:7">और उसके वासस्थान को उजाड़ डाला है।<verse eid="PSA 79:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8" />हमारे पूर्वजों के द्वारा किए अधर्म के</para>
  <para style="q2" vid="PSA 79:8">कामों को हमारे विरुद्ध स्मरण न कर।</para>
  <para style="q1" vid="PSA 79:8">तेरी दया हम पर शीघ्र हो,</para>
  <para style="q2" vid="PSA 79:8">क्योंकि हम बड़ी दुर्दशा में पड़े हैं।<verse eid="PSA 79:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9" />हे हमारे उद्धारकर्ता परमेश्‍वर,</para>
  <para style="q2" vid="PSA 79:9">अपने नाम की महिमा के लिए हमारी सहायता कर;</para>
  <para style="q1" vid="PSA 79:9">और अपने नाम के कारण</para>
  <para style="q2" vid="PSA 79:9">हमें छुड़ाकर हमारे पापों को ढाँप दे।<verse eid="PSA 79:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />जाति-जाति के लोग क्यों कहें,</para>
  <para style="q2" vid="PSA 79:10">“उनका परमेश्‍वर कहाँ है?”</para>
  <para style="q1" vid="PSA 79:10">तेरे सेवकों के बहाए गए</para>
  <para style="q2" vid="PSA 79:10">लहू का बदला लिया जाना</para>
  <para style="q1" vid="PSA 79:10">हमारी आँखों के सामने जाति-जाति के लोगों</para>
  <para style="q2" vid="PSA 79:10">के मध्य प्रकट हो जाए।<verse eid="PSA 79:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />बंदियों का कराहना तेरे सम्मुख पहुँचे;</para>
  <para style="q2" vid="PSA 79:11">अपने भुजबल से घात होनेवालों को बचा ले।<verse eid="PSA 79:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />हे प्रभु, हमारे पड़ोसियों ने जो तेरी निंदा की है,</para>
  <para style="q2" vid="PSA 79:12">उसका सातगुणा बदला उन्हें दे!<verse eid="PSA 79:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />तब हम जो तेरी प्रजा</para>
  <para style="q2" vid="PSA 79:13">और तेरी चरागाह की भेड़ें हैं,</para>
  <para style="q1" vid="PSA 79:13">तेरा धन्यवाद सदा करते रहेंगे,</para>
  <para style="q2" vid="PSA 79:13">और पीढ़ी से पीढ़ी तक</para>
  <para style="q1" vid="PSA 79:13">तेरी स्तुति करते रहेंगे।<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s1">पाप-क्षमा के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। शोशन्‍नीमेदूत की राग पर आसाफ का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1" />हे इस्राएल के चरवाहे,</para>
  <para style="q2" vid="PSA 80:1">तू जो यूसुफ की अगुवाई</para>
  <para style="q1" vid="PSA 80:1">भेड़ों के झुंड के समान करता है,</para>
  <para style="q2" vid="PSA 80:1">कान लगा! तू जो करूबों पर विराजमान है,</para>
  <para style="q1" vid="PSA 80:1">अपना तेज दिखा!<verse eid="PSA 80:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2" />एप्रैम, बिन्यामीन, और मनश्शे के सामने अपना पराक्रम दिखा,</para>
  <para style="q2" vid="PSA 80:2">और हमारा उद्धार करने को आ!<verse eid="PSA 80:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />हे परमेश्‍वर, हमें फिर से स्थापित कर,</para>
  <para style="q2" vid="PSA 80:3">और हम पर अपने मुख का प्रकाश चमका;</para>
  <para style="q1" vid="PSA 80:3">तब हमारा उद्धार हो जाएगा।<verse eid="PSA 80:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />हे सेनाओं के परमेश्‍वर यहोवा,</para>
  <para style="q2" vid="PSA 80:4">तू कब तक अपनी प्रजा की प्रार्थना से क्रोधित रहेगा?<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />तूने आँसुओं को उनका आहार बना दिया,</para>
  <para style="q2" vid="PSA 80:5">और मटके भर भरके</para>
  <para style="q1" vid="PSA 80:5">उन्हें आँसू पिलाए हैं।<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />तू हमें हमारे पड़ोसियों के</para>
  <para style="q2" vid="PSA 80:6">झगड़ने का कारण बना देता है,</para>
  <para style="q1" vid="PSA 80:6">और हमारे शत्रु हम पर हँसते हैं।<verse eid="PSA 80:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />हे सेनाओं के परमेश्‍वर, हमें फिर से स्थापित कर,</para>
  <para style="q2" vid="PSA 80:7">और हम पर अपने मुख का प्रकाश चमका;</para>
  <para style="q1" vid="PSA 80:7">तब हमारा उद्धार हो जाएगा।<verse eid="PSA 80:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />तू मिस्र से एक दाखलता उखाड़ लाया;</para>
  <para style="q2" vid="PSA 80:8">और तूने अन्यजातियों को निकालकर उसे लगा दिया।<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />तूने उसके लिए भूमि तैयार की।</para>
  <para style="q2" vid="PSA 80:9">उसने गहरी जड़ पकड़ी</para>
  <para style="q1" vid="PSA 80:9">और देश भर में फैल गई।<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />पर्वत उसकी छाया से,</para>
  <para style="q2" vid="PSA 80:10">और विशाल देवदार उसकी डालियों से ढक गए।<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />उसकी शाखाएँ समुद्र तक,</para>
  <para style="q2" vid="PSA 80:11">और उसकी टहनियाँ महानद तक फैल गईं।<verse eid="PSA 80:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />फिर तूने उसके बाड़ों को क्यों गिरा दिया</para>
  <para style="q2" vid="PSA 80:12">कि सब आने जानेवाले उसके फलों को तोड़ते हैं?<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />जंगली सूअर उसे उजाड़ देता है,</para>
  <para style="q2" vid="PSA 80:13">और मैदान के पशु</para>
  <para style="q1" vid="PSA 80:13">उसे खा जाते हैं।<verse eid="PSA 80:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />हे सेनाओं के परमेश्‍वर, लौट आ!</para>
  <para style="q2" vid="PSA 80:14">स्वर्ग से दृष्‍टि कर,</para>
  <para style="q1" vid="PSA 80:14">और इस दाखलता की सुधि ले।<verse eid="PSA 80:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15" />तूने इस लता को अपने दाहिने हाथ से लगाया था,</para>
  <para style="q2" vid="PSA 80:15">और इसकी कोमल शाखा को</para>
  <para style="q1" vid="PSA 80:15">तूने अपने लिए दृढ़ किया था।<verse eid="PSA 80:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />उन्होंने उसे आग से जला दिया,</para>
  <para style="q2" vid="PSA 80:16">और काट डाला।</para>
  <para style="q1" vid="PSA 80:16">तेरी घुड़की से वे नष्‍ट हो जाएँ।<verse eid="PSA 80:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />तेरा हाथ तेरे दाहिनी ओर के पुरुष,</para>
  <para style="q2" vid="PSA 80:17">अर्थात् मनुष्य के पुत्र पर रखा रहे,</para>
  <para style="q1" vid="PSA 80:17">जिसे तूने अपने लिए दृढ़ किया है।<verse eid="PSA 80:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18" />तब हम तुझसे न फिरेंगे।</para>
  <para style="q2" vid="PSA 80:18">हमें जिला, और हम तुझसे प्रार्थना करेंगे।<verse eid="PSA 80:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19" />हे सेनाओं के परमेश्‍वर यहोवा,</para>
  <para style="q2" vid="PSA 80:19">हमें फिर से स्थापित कर,</para>
  <para style="q1" vid="PSA 80:19">और हम पर अपने मुख का प्रकाश चमका;</para>
  <para style="q2" vid="PSA 80:19">तब हमारा उद्धार हो जाएगा।<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s1">आज्ञाकारिता के लिए बुलाहट</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। गित्तीथ की राग पर आसाफ का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1" />परमेश्‍वर के लिए जो हमारा बल है</para>
  <para style="q2" vid="PSA 81:1">आनंद से गाओ;</para>
  <para style="q1" vid="PSA 81:1">याकूब के परमेश्‍वर का जय जयकार करो।<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />भजन गाओ; डफ और मधुर स्वरवाली वीणा</para>
  <para style="q2" vid="PSA 81:2">और सारंगी बजाओ।<verse eid="PSA 81:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />नए चाँद के दिन और पूर्णिमा को,</para>
  <para style="q2" vid="PSA 81:3">हमारे पर्व के दिन तुरही फूँको।<verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />क्योंकि यह इस्राएल के लिए एक विधि,</para>
  <para style="q2" vid="PSA 81:4">और याकूब के परमेश्‍वर का ठहराया हुआ नियम है।<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />इसे उसने यूसुफ के लिए</para>
  <para style="q2" vid="PSA 81:5">उस समय साक्षी ठहराया,</para>
  <para style="q1" vid="PSA 81:5">जब वह मिस्र देश में से</para>
  <para style="q2" vid="PSA 81:5">निकल आया था।</para>
  <para style="b" vid="PSA 81:5" />
  <para style="q1" vid="PSA 81:5">वहाँ मैंने एक अनजानी भाषा सुनी :<verse eid="PSA 81:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6" />“मैंने उसके कंधे से बोझ को उतार दिया;</para>
  <para style="q2" vid="PSA 81:6">उसके हाथों से टोकरी ढोना छूट गया।<verse eid="PSA 81:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7" />तूने संकट में पड़कर पुकारा,</para>
  <para style="q2" vid="PSA 81:7">और मैंने तुझे छुड़ाया;</para>
  <para style="q1" vid="PSA 81:7">मैंने बादल गरजने के गुप्‍त स्थान से</para>
  <para style="q2" vid="PSA 81:7">तुझे उत्तर दिया,</para>
  <para style="q1" vid="PSA 81:7">और मरीबा नामक सोते के पास तुझे परखा।</para>
  <para style="q2" vid="PSA 81:7">सेला।<verse eid="PSA 81:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8" />हे मेरी प्रजा, सुन,</para>
  <para style="q2" vid="PSA 81:8">मैं तुझे सचेत करता हूँ!</para>
  <para style="q1" vid="PSA 81:8">हे इस्राएल, भला हो कि तू मेरी सुने!<verse eid="PSA 81:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9" />तेरे बीच में पराया देवता न हो;</para>
  <para style="q2" vid="PSA 81:9">और न तू किसी पराए देवता को दंडवत् करना।<verse eid="PSA 81:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10" />मैं ही तेरा परमेश्‍वर यहोवा हूँ,</para>
  <para style="q2" vid="PSA 81:10">जो तुझे मिस्र देश से निकाल लाया था।</para>
  <para style="q1" vid="PSA 81:10">तू अपना मुँह पूरा खोल,</para>
  <para style="q2" vid="PSA 81:10">और मैं उसे भर दूँगा।”<verse eid="PSA 81:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11" />“परंतु मेरी प्रजा ने मेरी न सुनी;</para>
  <para style="q2" vid="PSA 81:11">इस्राएल ने मुझे न चाहा,<verse eid="PSA 81:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12" />इसलिए मैंने उसे उसके हठ पर छोड़ दिया,</para>
  <para style="q2" vid="PSA 81:12">कि वह अपनी ही युक्‍तियों के अनुसार चले।<verse eid="PSA 81:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13" />यदि मेरी प्रजा मेरी सुने,</para>
  <para style="q2" vid="PSA 81:13">और इस्राएल मेरे मार्गों पर चले,<verse eid="PSA 81:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14" />तो मैं क्षण भर में उनके शत्रुओं को दबा दूँगा,</para>
  <para style="q2" vid="PSA 81:14">और अपना हाथ उनके बैरियों के विरुद्ध चलाऊँगा।”<verse eid="PSA 81:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15" />यहोवा के बैरी तो उसकी अधीनता में होंगे;</para>
  <para style="q2" vid="PSA 81:15">और उनका दंड सदा बना रहेगा।<verse eid="PSA 81:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16" />परंतु वह इस्राएल को उत्तम से उत्तम गेहूँ खिलाएगा।</para>
  <para style="q2" vid="PSA 81:16">“मैं चट्टान के मधु से तुझे तृप्‍त करूँगा।”<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s1">न्याय के लिए विनती</para>
  <para style="b" />
  <para style="d">आसाफ का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1" />परमेश्‍वर अपनी सभा में विराजमान है;</para>
  <para style="q2" vid="PSA 82:1">वह ईश्‍वरों<note caller="+" style="f"><char style="fr" closed="false">82:1 </char><char style="ft" closed="false">या शासकों</char></note> के बीच न्याय करता है :<verse eid="PSA 82:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />“तुम कब तक अनुचित रीति से न्याय करते</para>
  <para style="q2" vid="PSA 82:2">और दुष्‍टों का पक्ष लेते रहोगे?</para>
  <para style="q1" vid="PSA 82:2">सेला।<verse eid="PSA 82:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3" />कंगालों और अनाथों के साथ न्याय करो,</para>
  <para style="q2" vid="PSA 82:3">पीड़ितों और दरिद्रों के साथ न्यायपूर्ण व्यवहार करो।<verse eid="PSA 82:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4" />कंगालों और निर्धनों को बचाओ;</para>
  <para style="q2" vid="PSA 82:4">उन्हें दुष्‍टों के हाथों से छुड़ाओ।”<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />वे न तो कुछ जानते हैं,</para>
  <para style="q2" vid="PSA 82:5">न कुछ समझते हैं;</para>
  <para style="q1" vid="PSA 82:5">वे अंधेरे में भटकते रहते हैं।</para>
  <para style="q2" vid="PSA 82:5">पृथ्वी की पूरी नींव हिल जाती है।<verse eid="PSA 82:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6" />मैंने कहा है,</para>
  <para style="q2" vid="PSA 82:6">“तुम ईश्‍वर<note caller="+" style="f"><char style="fr" closed="false">82:6 </char><char style="ft" closed="false">या शासक</char></note> हो,</para>
  <para style="q1" vid="PSA 82:6">और तुम सब परमप्रधान के पुत्र हो।<verse eid="PSA 82:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7" />फिर भी तुम मनुष्यों के समान मरोगे,</para>
  <para style="q2" vid="PSA 82:7">और किसी अन्य शासक के समान</para>
  <para style="q1" vid="PSA 82:7">तुम्हारा भी पतन होगा।”<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />हे परमेश्‍वर उठ, पृथ्वी का न्याय कर;</para>
  <para style="q2" vid="PSA 82:8">क्योंकि सब जातियाँ तेरी ही हैं।<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s1">शत्रुओं के विरुद्ध प्रार्थना</para>
  <para style="b" />
  <para style="d">एक गीत। आसाफ का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1" />हे परमेश्‍वर, मौन न रह!</para>
  <para style="q2" vid="PSA 83:1">हे परमेश्‍वर, चुप न रह,</para>
  <para style="q1" vid="PSA 83:1">और शांत न बैठ!<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />क्योंकि देख,</para>
  <para style="q2" vid="PSA 83:2">तेरे शत्रु हुल्लड़ मचा रहे हैं;</para>
  <para style="q1" vid="PSA 83:2">और तेरे बैरियों ने सिर उठाया है।<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />वे तेरी प्रजा के विरुद्ध चतुराई से योजनाएँ बनाते हैं,</para>
  <para style="q2" vid="PSA 83:3">और तेरे शरणागतों के विरुद्ध षड्यंत्र रचते हैं।<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />उन्होंने कहा है,</para>
  <para style="q2" vid="PSA 83:4">“आओ, हम उनकी पूरी जाति को ही मिटा डालें,</para>
  <para style="q1" vid="PSA 83:4">ताकि इस्राएल का नाम</para>
  <para style="q2" vid="PSA 83:4">फिर कभी स्मरण न किया जाए।”<verse eid="PSA 83:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />उन्होंने एक मन होकर षड्यंत्र रचा है;</para>
  <para style="q2" vid="PSA 83:5">और तेरे ही विरुद्ध उन्होंने संधि की<note caller="+" style="f"><char style="fr" closed="false">83:5 </char><char style="ft" closed="false">अक्षरशः वाचा बाँधी</char></note> है।<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />ये छावनियाँ तो एदोमियों, इश्माएलियों,</para>
  <para style="q2" vid="PSA 83:6">मोआबियों और हग्रियों,<verse eid="PSA 83:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7" />गबालियों, अम्मोनियों, अमालेकियों,</para>
  <para style="q2" vid="PSA 83:7">और सोर निवासियों समेत पलिश्‍त की हैं;<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />इनके साथ अश्शूरी भी मिल गए हैं;</para>
  <para style="q2" vid="PSA 83:8">वे लूतवंशियों के सहायक बन गए हैं।</para>
  <para style="q1" vid="PSA 83:8">सेला।<verse eid="PSA 83:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />इनके साथ वैसा ही व्यवहार कर</para>
  <para style="q2" vid="PSA 83:9">जैसा तूने मिद्यानियों के साथ,</para>
  <para style="q1" vid="PSA 83:9">तथा कीशोन नदी पर सीसरा</para>
  <para style="q2" vid="PSA 83:9">और याबीन के साथ किया था,<verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />जो एंदोर में नष्‍ट हुए,</para>
  <para style="q2" vid="PSA 83:10">और भूमि के लिए खाद बन गए थे।<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />उनके धनवानों को ओरेब और जाएब के समान,</para>
  <para style="q2" vid="PSA 83:11">और उनके सब प्रधानों को जेबह</para>
  <para style="q1" vid="PSA 83:11">और सल्मुन्‍ना के समान कर दे,<verse eid="PSA 83:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12" />जिन्होंने कहा था,</para>
  <para style="q2" vid="PSA 83:12">“आओ हम परमेश्‍वर की चराइयों पर</para>
  <para style="q1" vid="PSA 83:12">अपना अधिकार कर लें।”<verse eid="PSA 83:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />हे मेरे परमेश्‍वर, उन्हें बवंडर की धूल,</para>
  <para style="q2" vid="PSA 83:13">या पवन से उड़ाए हुए</para>
  <para style="q1" vid="PSA 83:13">भूसे के समान कर दे।<verse eid="PSA 83:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14" />जैसे आग वन को भस्म करती है,</para>
  <para style="q2" vid="PSA 83:14">और उसकी लपटें पहाड़ों को जला देती हैं,<verse eid="PSA 83:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15" />वैसे ही तू अपनी आँधी से</para>
  <para style="q2" vid="PSA 83:15">उनका पीछा कर,</para>
  <para style="q1" vid="PSA 83:15">और अपने तूफ़ान से उन्हें भयभीत कर।<verse eid="PSA 83:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16" />हे यहोवा, उनके मुख को लज्‍जा से भर दे</para>
  <para style="q2" vid="PSA 83:16">कि वे तेरे नाम को खोजें।<verse eid="PSA 83:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17" />वे सदा के लिए लज्‍जित</para>
  <para style="q2" vid="PSA 83:17">और भयभीत रहें,</para>
  <para style="q1" vid="PSA 83:17">और अपमानित होकर नष्‍ट हो जाएँ,<verse eid="PSA 83:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18" />जिससे वे यह जान लें</para>
  <para style="q2" vid="PSA 83:18">कि केवल तू जिसका नाम यहोवा है,</para>
  <para style="q1" vid="PSA 83:18">सारी पृथ्वी के ऊपर परमप्रधान है।<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s1">परमेश्‍वर के भवन की चाहत</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। गित्तीथ की राग पर कोरहवंशियों का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1" />हे सेनाओं के यहोवा,</para>
  <para style="q2" vid="PSA 84:1">तेरे निवासस्थान कितने मनोहर हैं!<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />मेरा प्राण यहोवा के आँगनों की अभिलाषा करते-करते</para>
  <para style="q2" vid="PSA 84:2">मूर्च्छित हो चला है;</para>
  <para style="q1" vid="PSA 84:2">मेरा तन और मन</para>
  <para style="q2" vid="PSA 84:2">जीवित परमेश्‍वर को पुकार रहे हैं।<verse eid="PSA 84:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />हे सेनाओं के यहोवा,</para>
  <para style="q2" vid="PSA 84:3">हे मेरे राजा और मेरे परमेश्‍वर,</para>
  <para style="q1" vid="PSA 84:3">तेरी वेदियों में गौरैया ने अपना बसेरा</para>
  <para style="q2" vid="PSA 84:3">और अबाबील ने अपने बच्‍चों के लिए</para>
  <para style="q1" vid="PSA 84:3">घोंसला बना लिया है।<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />क्या ही धन्य हैं</para>
  <para style="q2" vid="PSA 84:4">वे जो तेरे भवन में वास करते हैं!</para>
  <para style="q1" vid="PSA 84:4">वे निरंतर तेरी स्तुति करते रहते हैं।</para>
  <para style="q2" vid="PSA 84:4">सेला।<verse eid="PSA 84:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />क्या ही धन्य है</para>
  <para style="q2" vid="PSA 84:5">वह मनुष्य जो तुझसे सामर्थ्य पाता है,</para>
  <para style="q1" vid="PSA 84:5">और जिसके हृदय में सिय्योन के पथ हैं!<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />जब वे रोने की घाटी<note caller="+" style="f"><char style="fr" closed="false">84:6 </char><char style="ft" closed="false">अक्षरशः बाका की घाटी</char></note> से होकर जाते हैं</para>
  <para style="q2" vid="PSA 84:6">तो उसे सोतों का स्थान बना देते हैं,</para>
  <para style="q1" vid="PSA 84:6">और वर्षा भी उसे आशिषों से</para>
  <para style="q2" vid="PSA 84:6">भरपूर कर देती है।<verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />वे बल पर बल पाते जाते हैं;</para>
  <para style="q2" vid="PSA 84:7">उनमें से प्रत्येक जन</para>
  <para style="q1" vid="PSA 84:7">सिय्योन में परमेश्‍वर के सम्मुख उपस्थित होगा।<verse eid="PSA 84:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />हे सेनाओं के परमेश्‍वर यहोवा,</para>
  <para style="q2" vid="PSA 84:8">मेरी प्रार्थना सुन!</para>
  <para style="q1" vid="PSA 84:8">हे याकूब के परमेश्‍वर, कान लगा!</para>
  <para style="q2" vid="PSA 84:8">सेला।<verse eid="PSA 84:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />हे परमेश्‍वर, हे हमारी ढाल, देख,</para>
  <para style="q2" vid="PSA 84:9">और अपने अभिषिक्‍त के मुख पर दृष्‍टि कर।<verse eid="PSA 84:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />तेरे आँगनों में एक दिन बिताना</para>
  <para style="q2" vid="PSA 84:10">कहीं और के हज़ार दिनों से उत्तम है।</para>
  <para style="q1" vid="PSA 84:10">दुष्‍टों के डेरों में वास करने की अपेक्षा</para>
  <para style="q2" vid="PSA 84:10">अपने परमेश्‍वर के भवन के द्वार पर</para>
  <para style="q1" vid="PSA 84:10">खड़ा रहना मुझे अधिक प्रिय है।<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />क्योंकि यहोवा परमेश्‍वर सूर्य और ढाल है।</para>
  <para style="q2" vid="PSA 84:11">यहोवा कृपा करता और सम्मान देता है;</para>
  <para style="q1" vid="PSA 84:11">और जो खरी चाल चलते हैं,</para>
  <para style="q2" vid="PSA 84:11">उनसे वह कोई अच्छी वस्तु नहीं रख छोड़ता।<verse eid="PSA 84:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />हे सेनाओं के यहोवा!</para>
  <para style="q2" vid="PSA 84:12">क्या ही धन्य है वह मनुष्य</para>
  <para style="q1" vid="PSA 84:12">जो तुझ पर भरोसा रखता है!<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s1">परमेश्‍वर की दया के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। कोरहवंशियों का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1" />हे यहोवा, तू अपने देश पर प्रसन्‍न हुआ है;</para>
  <para style="q2" vid="PSA 85:1">तू याकूब को बँधुआई से</para>
  <para style="q1" vid="PSA 85:1">लौटा ले आया है।<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />तूने अपनी प्रजा के अधर्म को क्षमा किया है;</para>
  <para style="q2" vid="PSA 85:2">और उसके सब पापों को ढाँप दिया है।</para>
  <para style="q1" vid="PSA 85:2">सेला।<verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />तूने अपने प्रकोप को शांत किया है;</para>
  <para style="q2" vid="PSA 85:3">और अपने भड़के हुए क्रोध को दूर किया है।<verse eid="PSA 85:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />हे हमारे उद्धारकर्ता परमेश्‍वर,</para>
  <para style="q2" vid="PSA 85:4">हमें फिर से स्थापित कर</para>
  <para style="q1" vid="PSA 85:4">और अपना कोप हम पर से हटा ले।<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />क्या तू हमसे सदा क्रोधित रहेगा?</para>
  <para style="q2" vid="PSA 85:5">क्या तू पीढ़ी से पीढ़ी तक</para>
  <para style="q1" vid="PSA 85:5">अपना क्रोध बनाए रखेगा?<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />क्या तू हमें फिर न जिलाएगा</para>
  <para style="q2" vid="PSA 85:6">कि तेरी प्रजा तुझमें आनंदित हो?<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />हे यहोवा, अपनी करुणा हमें दिखा,</para>
  <para style="q2" vid="PSA 85:7">और अपना उद्धार हमें प्रदान कर।<verse eid="PSA 85:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />मैं सुनूँगा कि परमेश्‍वर यहोवा क्या कहता है;</para>
  <para style="q2" vid="PSA 85:8">वह तो अपनी प्रजा से</para>
  <para style="q1" vid="PSA 85:8">जो उसके भक्‍त हैं,</para>
  <para style="q2" vid="PSA 85:8">शांति की बातें कहेगा</para>
  <para style="q1" vid="PSA 85:8">और उन्हें मूर्खता की ओर लौटने न देगा।<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />निश्‍चय उसका भय माननेवालों के उद्धार का समय निकट है</para>
  <para style="q2" vid="PSA 85:9">कि हमारे देश में महिमा का निवास हो।<verse eid="PSA 85:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />करुणा और सच्‍चाई का मिलन हुआ है;</para>
  <para style="q2" vid="PSA 85:10">धार्मिकता और मेल ने आपस में चुंबन किया है।<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />पृथ्वी में से सच्‍चाई अंकुरित होती है,</para>
  <para style="q2" vid="PSA 85:11">और स्वर्ग से धार्मिकता झाँकती है।<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />निश्‍चय यहोवा वह देगा जो उत्तम है,</para>
  <para style="q2" vid="PSA 85:12">और हमारी भूमि अपनी उपज देगी।<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />धार्मिकता उसके आगे-आगे चलेगी,</para>
  <para style="q2" vid="PSA 85:13">और उसके कदमों के लिए मार्ग बनाएगी।<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s1">विनती और भरोसा</para>
  <para style="b" />
  <para style="d">दाऊद की प्रार्थना।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1" />हे यहोवा, कान लगाकर मेरी सुन ले,</para>
  <para style="q2" vid="PSA 86:1">क्योंकि मैं असहाय और दरिद्र हूँ।<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />मेरे प्राण की रक्षा कर,</para>
  <para style="q2" vid="PSA 86:2">क्योंकि मैं तेरा भक्‍त हूँ।</para>
  <para style="q1" vid="PSA 86:2">तू मेरा परमेश्‍वर है,</para>
  <para style="q2" vid="PSA 86:2">इसलिए अपने दास का,</para>
  <para style="q1" vid="PSA 86:2">जो तुझ पर भरोसा रखता है,</para>
  <para style="q2" vid="PSA 86:2">उद्धार कर।<verse eid="PSA 86:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3" />हे प्रभु, मुझ पर अनुग्रह कर,</para>
  <para style="q2" vid="PSA 86:3">क्योंकि मैं दिन भर</para>
  <para style="q1" vid="PSA 86:3">तुझे पुकारता रहता हूँ।<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />अपने दास के मन को आनंदित कर,</para>
  <para style="q2" vid="PSA 86:4">क्योंकि हे प्रभु,</para>
  <para style="q1" vid="PSA 86:4">मैं अपना मन तेरी ओर लगाता हूँ।<verse eid="PSA 86:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />हे प्रभु, तू भला और क्षमा करनेवाला है,</para>
  <para style="q2" vid="PSA 86:5">और जितने तुझे पुकारते हैं</para>
  <para style="q1" vid="PSA 86:5">उन सब के लिए तू अति करुणामय है।<verse eid="PSA 86:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />हे यहोवा, मेरी प्रार्थना पर कान लगा,</para>
  <para style="q2" vid="PSA 86:6">और मेरे गिड़गिड़ाने को ध्यान से सुन।<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />संकट के दिन मैं तुझे पुकारूँगा,</para>
  <para style="q2" vid="PSA 86:7">क्योंकि तू मुझे उत्तर देता है।<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8" />हे प्रभु, देवताओं में तेरे तुल्य</para>
  <para style="q2" vid="PSA 86:8">कोई भी नहीं,</para>
  <para style="q1" vid="PSA 86:8">और न ही किसी के</para>
  <para style="q2" vid="PSA 86:8">कार्य तेरे जैसे हैं।<verse eid="PSA 86:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9" />हे प्रभु, तूने जितनी जातियों को बनाया है,</para>
  <para style="q2" vid="PSA 86:9">वे सब आकर तेरे सामने दंडवत् करेंगी,</para>
  <para style="q1" vid="PSA 86:9">और तेरे नाम की महिमा करेंगी।<verse eid="PSA 86:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10" />क्योंकि तू महान और आश्‍चर्यकर्म करनेवाला है,</para>
  <para style="q2" vid="PSA 86:10">केवल तू ही परमेश्‍वर है।<verse eid="PSA 86:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11" />हे यहोवा, अपना मार्ग मुझे दिखा</para>
  <para style="q2" vid="PSA 86:11">कि मैं तेरे सत्य मार्ग पर चलूँ;</para>
  <para style="q1" vid="PSA 86:11">मुझे स्थिर मन दे</para>
  <para style="q2" vid="PSA 86:11">कि मैं तेरे नाम का भय मानूँ।<verse eid="PSA 86:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12" />हे प्रभु, हे मेरे परमेश्‍वर,</para>
  <para style="q2" vid="PSA 86:12">मैं अपने संपूर्ण मन से तेरा धन्यवाद करूँगा,</para>
  <para style="q1" vid="PSA 86:12">और तेरे नाम की महिमा सदा करता रहूँगा।<verse eid="PSA 86:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13" />क्योंकि मुझ पर तेरी बड़ी करुणा हुई है;</para>
  <para style="q2" vid="PSA 86:13">तूने मेरे प्राण को अधोलोक के गड्‌ढे में</para>
  <para style="q1" vid="PSA 86:13">जाने से बचा लिया है।<verse eid="PSA 86:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14" />हे परमेश्‍वर, अभिमानी लोग तो मेरे विरुद्ध उठ खड़े हुए हैं,</para>
  <para style="q2" vid="PSA 86:14">और निर्दयी मनुष्यों का झुंड मेरे प्राण के पीछे पड़ा है।</para>
  <para style="q1" vid="PSA 86:14">वे तुझ पर ध्यान नहीं देते।<verse eid="PSA 86:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15" />परंतु हे प्रभु, तू दयालु और अनुग्रहकारी परमेश्‍वर है।</para>
  <para style="q2" vid="PSA 86:15">तू क्रोध करने में धीमा</para>
  <para style="q1" vid="PSA 86:15">तथा करुणा और सच्‍चाई से परिपूर्ण है।<verse eid="PSA 86:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16" />मेरी ओर फिरकर मुझ पर अनुग्रह कर।</para>
  <para style="q2" vid="PSA 86:16">अपने दास को अपना बल दे,</para>
  <para style="q1" vid="PSA 86:16">और अपनी दासी के पुत्र का उद्धार कर।<verse eid="PSA 86:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17" />मुझे अपनी भलाई का कोई चिह्‍न दिखा,</para>
  <para style="q2" vid="PSA 86:17">जिसे देखकर मेरे बैरी लज्‍जित हों;</para>
  <para style="q1" vid="PSA 86:17">क्योंकि हे यहोवा, तूने स्वयं मेरी सहायता की</para>
  <para style="q2" vid="PSA 86:17">और मुझे शांति दी है।<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s1">परमेश्‍वर का नगर सिय्योन</para>
  <para style="b" />
  <para style="d">कोरहवंशियों का भजन। एक गीत।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1" />सिय्योन की नींव पवित्र पर्वतों में है।<verse eid="PSA 87:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2" />यहोवा याकूब के सारे निवासस्थानों से बढ़कर</para>
  <para style="q2" vid="PSA 87:2">सिय्योन के फाटकों से प्रीति रखता है।<verse eid="PSA 87:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />हे परमेश्‍वर के नगर,</para>
  <para style="q2" vid="PSA 87:3">तेरे विषय में महिमा की बातें कही जाती हैं।</para>
  <para style="q1" vid="PSA 87:3">सेला।<verse eid="PSA 87:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />“जो मुझे जानते हैं मैं उनसे</para>
  <para style="q2" vid="PSA 87:4">रहब<note caller="+" style="f"><char style="fr" closed="false">87:4 </char><char style="ft" closed="false">अर्थात् मिस्र</char></note> और बेबीलोन की चर्चा करूँगा;</para>
  <para style="q1" vid="PSA 87:4">देखो, पलिश्त, सूर और कूश :</para>
  <para style="q2" vid="PSA 87:4">‘यह वहाँ उत्पन्‍न‍ हुआ था’।”<verse eid="PSA 87:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />परंतु सिय्योन के विषय में यह कहा जाएगा,</para>
  <para style="q2" vid="PSA 87:5">“अमुक-अमुक व्यक्‍ति उसमें उत्पन्‍न‍ हुआ था।”</para>
  <para style="q1" vid="PSA 87:5">और परमप्रधान स्वयं उसे स्थिर रखेगा।<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />यहोवा देश-देश के लोगों की गणना करते हुए लिखेगा :</para>
  <para style="q2" vid="PSA 87:6">“यह वहाँ उत्पन्‍न‍ हुआ था।” सेला।<verse eid="PSA 87:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />तब गायक और नर्तक दोनों कहेंगे,</para>
  <para style="q2" vid="PSA 87:7">“हमारे सब सोते तुझी में हैं।”<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s1">मृत्यु से बचाने की प्रार्थना</para>
  <para style="b" />
  <para style="d">एक गीत। कोरहवंशियों का भजन। संगीत निर्देशक के लिए। महलतलन्‍नोत की राग पर एज्रावंशी हेमान का मश्कील।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1" />हे मेरे उद्धारकर्ता परमेश्‍वर यहोवा,</para>
  <para style="q2" vid="PSA 88:1">मैं दिन और रात तेरी दुहाई देता हूँ।<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />मेरी प्रार्थना तुझ तक पहुँचे,</para>
  <para style="q2" vid="PSA 88:2">मेरी पुकार की ओर कान लगा!<verse eid="PSA 88:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />क्योंकि मेरा प्राण कष्‍‍टों से भरा है,</para>
  <para style="q2" vid="PSA 88:3">और मेरा जीवन अधोलोक के निकट पहुँचा है।<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />मेरी गिनती कब्र में जानेवालों में हो रही है;</para>
  <para style="q2" vid="PSA 88:4">मैं बलहीन पुरुष के समान हो गया हूँ।<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />मुझे मृतकों के बीच छोड़ा गया है।</para>
  <para style="q2" vid="PSA 88:5">मैं उनके समान हो गया हूँ</para>
  <para style="q1" vid="PSA 88:5">जो घात होकर कब्र में पड़े हैं,</para>
  <para style="q2" vid="PSA 88:5">जिन्हें अब तू स्मरण नहीं करता</para>
  <para style="q1" vid="PSA 88:5">और जिन पर से तेरा हाथ उठ गया है।<verse eid="PSA 88:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />तूने मुझे अथाह गड्‌ढे में,</para>
  <para style="q2" vid="PSA 88:6">अर्थात् अंधेरे और गहरे स्थान में डाल दिया है।<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />तेरे प्रकोप ने मुझे दबा रखा है;</para>
  <para style="q2" vid="PSA 88:7">अपनी लहरों से तूने मुझे पीड़ित किया है। सेला।<verse eid="PSA 88:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />तूने मेरे परिचितों को मुझसे दूर कर दिया है;</para>
  <para style="q2" vid="PSA 88:8">तूने मुझे उनकी दृष्‍टि में घृणित बना दिया है।</para>
  <para style="q1" vid="PSA 88:8">मैं बंदी हूँ और बचकर भाग नहीं सकता।<verse eid="PSA 88:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9" />दुःख भोगते-भोगते मेरी आँखें धुँधला गई हैं।</para>
  <para style="q2" vid="PSA 88:9">हे यहोवा, मैंने तुझे प्रतिदिन पुकारा है;</para>
  <para style="q1" vid="PSA 88:9">मैंने अपने हाथ तेरी ओर फैलाए हैं।<verse eid="PSA 88:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />क्या तू मृतकों के लिए अद्भुत कार्य करेगा?</para>
  <para style="q2" vid="PSA 88:10">क्या मरे हुए लोग उठकर तेरी स्तुति करेंगे?</para>
  <para style="q1" vid="PSA 88:10">सेला।<verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />क्या कब्र में तेरी करुणा का,</para>
  <para style="q2" vid="PSA 88:11">और विनाश की दशा में तेरी सच्‍चाई का वर्णन किया जाएगा?<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />क्या तेरे अद्भुत कार्यों को अंधकार में,</para>
  <para style="q2" vid="PSA 88:12">और तेरी धार्मिकता को भुलाए जाने के देश में जाना जा सकता है?<verse eid="PSA 88:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />परंतु हे यहोवा, मैंने तेरी दुहाई दी है;</para>
  <para style="q2" vid="PSA 88:13">और भोर को मेरी प्रार्थना तुझ तक पहुँचती है।<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />हे यहोवा, तू मुझे क्यों त्यागे रहता है?</para>
  <para style="q2" vid="PSA 88:14">तू अपना मुँह मुझसे क्यों छिपाए रहता है?<verse eid="PSA 88:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />मैं बचपन से ही दुःखी और मृत्यु के निकट रहा हूँ।</para>
  <para style="q2" vid="PSA 88:15">मैं तुझसे अत्यंत भयभीत हूँ,</para>
  <para style="q1" vid="PSA 88:15">और व्याकुल हो गया हूँ।<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />तेरा प्रकोप मुझ पर पड़ा है।</para>
  <para style="q2" vid="PSA 88:16">तेरे आतंक ने मुझे नष्‍ट कर दिया है,<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />और वह दिन भर जल के समान मुझे घेरे रहता है;</para>
  <para style="q2" vid="PSA 88:17">मैं उससे पूरी तरह से घिर गया हूँ।<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />तूने मेरे प्रिय और मेरे साथी को</para>
  <para style="q2" vid="PSA 88:18">मुझसे दूर कर दिया है;</para>
  <para style="q1" vid="PSA 88:18">और मेरे परिचितों को अंधकार में डाल दिया है।<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s1">दाऊद के साथ परमेश्‍वर की वाचा</para>
  <para style="b" />
  <para style="d">एतान एज्रावंशी का मश्कील।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1" />मैं यहोवा की करुणा के गीत सदा गाता रहूँगा;</para>
  <para style="q2" vid="PSA 89:1">मैं अपने मुख से तेरी सच्‍चाई का वर्णन पीढ़ी से पीढ़ी तक करता रहूँगा।<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />क्योंकि मैंने कहा,</para>
  <para style="q2" vid="PSA 89:2">“तेरी करुणा सदा स्थिर रहेगी;</para>
  <para style="q1" vid="PSA 89:2">स्वर्ग में तू अपनी सच्‍चाई को स्थापित करेगा।”<verse eid="PSA 89:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />तूने कहा है,</para>
  <para style="q2" vid="PSA 89:3">“मैंने अपने चुने हुए के साथ वाचा बाँधी है;</para>
  <para style="q1" vid="PSA 89:3">मैंने अपने दास दाऊद से शपथ खाई है,<verse eid="PSA 89:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4" />कि मैं तेरे वंश को सदा स्थिर रखूँगा</para>
  <para style="q2" vid="PSA 89:4">और तेरे सिंहासन को पीढ़ी से पीढ़ी तक बनाए रखूँगा।” सेला।<verse eid="PSA 89:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />हे यहोवा, स्वर्ग में तेरे अद्भुत कार्य की,</para>
  <para style="q2" vid="PSA 89:5">और पवित्र लोगों की सभा में तेरी सच्‍चाई की प्रशंसा होगी।<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />क्योंकि आकाश में यहोवा के तुल्य कौन है?</para>
  <para style="q2" vid="PSA 89:6">स्वर्गीय प्राणियों में से कौन है जो यहोवा के समान है?<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />परमेश्‍वर पवित्र लोगों की सभा में अत्यंत भययोग्य है;</para>
  <para style="q2" vid="PSA 89:7">और जो उसके चारों ओर हैं</para>
  <para style="q1" vid="PSA 89:7">उनमें वही सब से अधिक आदर के योग्य है।<verse eid="PSA 89:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />हे सेनाओं के परमेश्‍वर यहोवा,</para>
  <para style="q2" vid="PSA 89:8">हे याह, तेरे समान सामर्थी कौन है?</para>
  <para style="q1" vid="PSA 89:8">तेरी सच्‍चाई तो तेरे चारों ओर है।<verse eid="PSA 89:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />समुद्र की प्रचंड लहरों पर तेरा ही अधिकार है;</para>
  <para style="q2" vid="PSA 89:9">जब उसकी तरंगें उठती हैं</para>
  <para style="q1" vid="PSA 89:9">तो तू उन्हें शांत करता है।<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />तूने रहब<note caller="+" style="f"><char style="fr" closed="false">89:10 </char><char style="ft" closed="false">अर्थात् मिस्र</char></note> को घात किए हुए</para>
  <para style="q2" vid="PSA 89:10">मनुष्य के समान कुचल डाला है;</para>
  <para style="q1" vid="PSA 89:10">तूने अपने शत्रुओं को अपने भुजबल से</para>
  <para style="q2" vid="PSA 89:10">तितर-बितर कर दिया है।<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />आकाश तेरा है, पृथ्वी भी तेरी है।</para>
  <para style="q2" vid="PSA 89:11">जगत और जो कुछ उसमें है,</para>
  <para style="q1" vid="PSA 89:11">उन्हें तूने ही स्थिर किया है।<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />तूने ही उत्तर और दक्षिण बनाए हैं;</para>
  <para style="q2" vid="PSA 89:12">ताबोर और हेर्मोन तेरे नाम का जय जयकार करते हैं।<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />तेरी भुजा बलवंत है;</para>
  <para style="q2" vid="PSA 89:13">तेरा हाथ शक्‍तिशाली और तेरा दाहिना हाथ प्रबल है।<verse eid="PSA 89:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />तेरे सिंहासन का मूल, धार्मिकता और न्याय है;</para>
  <para style="q2" vid="PSA 89:14">करुणा और सच्‍चाई तेरे आगे-आगे चलती हैं।<verse eid="PSA 89:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />क्या ही धन्य है वह प्रजा</para>
  <para style="q2" vid="PSA 89:15">जो आनंद की आवाज़ को पहचानती है!</para>
  <para style="q1" vid="PSA 89:15">हे यहोवा, वे लोग तेरे मुख के प्रकाश में चलते हैं।<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />वे दिन भर तेरे नाम में मगन रहते हैं;</para>
  <para style="q2" vid="PSA 89:16">और तेरी धार्मिकता के कारण ऊँचे उठाए जाते हैं।<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />क्योंकि तू ही उनके सामर्थ्य का तेज है,</para>
  <para style="q2" vid="PSA 89:17">और तेरी कृपा से हमारे सींग ऊँचे किए जाते हैं।<verse eid="PSA 89:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18" />क्योंकि यहोवा हमारी ढाल है,</para>
  <para style="q2" vid="PSA 89:18">और इस्राएल का पवित्र हमारा राजा है।<verse eid="PSA 89:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19" />एक बार तूने अपने भक्‍तों से दर्शन में बात की,</para>
  <para style="q2" vid="PSA 89:19">और कहा, “मैंने एक वीर को सहायता प्रदान की है;</para>
  <para style="q1" vid="PSA 89:19">मैंने प्रजा में से एक युवक को चुनकर ऊँचा उठाया है।<verse eid="PSA 89:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20" />मैंने अपने दास दाऊद को पा लिया है;</para>
  <para style="q2" vid="PSA 89:20">मैंने अपने पवित्र तेल से उसका अभिषेक किया है।<verse eid="PSA 89:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21" />मेरा हाथ उसके साथ बना रहेगा;</para>
  <para style="q2" vid="PSA 89:21">मेरी भुजा भी उसे दृढ़ रखेगी।<verse eid="PSA 89:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22" />शत्रु उसे छल नहीं पाएगा,</para>
  <para style="q2" vid="PSA 89:22">और न कुटिल जन उसे कष्‍‍ट दे पाएगा।<verse eid="PSA 89:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23" />मैं उसके सामने उसके शत्रुओं को कुचल डालूँगा,</para>
  <para style="q2" vid="PSA 89:23">और उसके बैरियों को नष्‍ट कर दूँगा।<verse eid="PSA 89:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24" />परंतु उस पर मेरी सच्‍चाई और करुणा बनी रहेंगी,</para>
  <para style="q2" vid="PSA 89:24">और मेरे नाम के द्वारा उसका सींग ऊँचा किया जाएगा।<verse eid="PSA 89:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25" />मैं समुद्र को उसके हाथ के नीचे</para>
  <para style="q2" vid="PSA 89:25">और नदियों को उसके दाहिने हाथ के नीचे कर दूँगा।<verse eid="PSA 89:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26" />वह मुझे पुकारकर कहेगा,</para>
  <para style="q2" vid="PSA 89:26">‘तू मेरा पिता, मेरा परमेश्‍वर</para>
  <para style="q1" vid="PSA 89:26">और मेरे उद्धार की चट्टान है।’<verse eid="PSA 89:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27" />फिर मैं उसे अपना पहलौठा ठहराऊँगा,</para>
  <para style="q2" vid="PSA 89:27">जो पृथ्वी के राजाओं पर प्रधान होगा।<verse eid="PSA 89:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28" />मैं उस पर अपनी करुणा सदा बनाए रहूँगा,</para>
  <para style="q2" vid="PSA 89:28">और उसके साथ मेरी वाचा अटल रहेगी।<verse eid="PSA 89:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29" />मैं उसके वंश को सदा बनाए रखूँगा</para>
  <para style="q2" vid="PSA 89:29">और उसका सिंहासन स्वर्ग के समान सर्वदा बना रहेगा।<verse eid="PSA 89:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30" />यदि उसके वंशज मेरी व्यवस्था को त्याग दें,</para>
  <para style="q2" vid="PSA 89:30">और मेरे नियमों के अनुसार न चलें,<verse eid="PSA 89:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31" />यदि वे मेरी विधियों का उल्लंघन करें,</para>
  <para style="q2" vid="PSA 89:31">और मेरी आज्ञाओं का पालन न करें,<verse eid="PSA 89:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32" />तो मैं उनके अपराध का दंड छड़ी से,</para>
  <para style="q2" vid="PSA 89:32">और उनके अधर्म का दंड कोड़ों से दूँगा।<verse eid="PSA 89:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33" />परंतु मैं अपनी करुणा उस पर से न हटाऊँगा,</para>
  <para style="q2" vid="PSA 89:33">और न अपनी सच्‍चाई त्यागकर झूठा ठहरूँगा।<verse eid="PSA 89:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34" />मैं अपनी वाचा को नहीं तोड़ूँगा,</para>
  <para style="q2" vid="PSA 89:34">और न अपने मुँह से निकले शब्दों को बदलूँगा।<verse eid="PSA 89:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35" />एक बार मैं अपनी पवित्रता की शपथ खा चुका हूँ;</para>
  <para style="q2" vid="PSA 89:35">मैं दाऊद को कभी धोखा न दूँगा।<verse eid="PSA 89:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36" />उसका वंश सदा बना रहेगा,</para>
  <para style="q2" vid="PSA 89:36">और उसका सिंहासन सूर्य के समान मेरे सम्मुख ठहरा रहेगा।<verse eid="PSA 89:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37" />वह चंद्रमा के समान,</para>
  <para style="q2" vid="PSA 89:37">और आकाशमंडल के विश्‍वसनीय साक्षी के समान सदा बना रहेगा।” सेला।<verse eid="PSA 89:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38" />फिर भी तूने अपने अभिषिक्‍त को त्याग दिया</para>
  <para style="q2" vid="PSA 89:38">और उसे तुच्छ जाना है;</para>
  <para style="q1" vid="PSA 89:38">तू उस पर अत्यंत क्रोधित हुआ है।<verse eid="PSA 89:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39" />तूने अपने दास के साथ</para>
  <para style="q2" vid="PSA 89:39">बाँधी वाचा को त्याग दिया,</para>
  <para style="q1" vid="PSA 89:39">और उसके मुकुट को भूमि पर</para>
  <para style="q2" vid="PSA 89:39">गिराकर अशुद्ध किया है।<verse eid="PSA 89:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40" />तूने उसके नगर की सब दीवारों को तोड़ डाला है,</para>
  <para style="q2" vid="PSA 89:40">और उसके गढ़ों को खंडहर बना दिया है।<verse eid="PSA 89:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41" />वहाँ से होकर जानेवाले</para>
  <para style="q2" vid="PSA 89:41">सब लोग उसे लूट लेते हैं,</para>
  <para style="q1" vid="PSA 89:41">और वह अपने पड़ोसियों में निंदा का पात्र बन गया है।<verse eid="PSA 89:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42" />तूने उसके विरोधियों के दाहिने हाथ को प्रबल किया,</para>
  <para style="q2" vid="PSA 89:42">और उसके सब शत्रुओं को आनंदित किया है।<verse eid="PSA 89:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43" />तू उसकी तलवार की धार को भी मोड़ देता है,</para>
  <para style="q2" vid="PSA 89:43">और युद्ध में उसके पैर जमने नहीं देता।<verse eid="PSA 89:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44" />तूने उसके वैभव को मिटा डाला है,</para>
  <para style="q2" vid="PSA 89:44">और उसके सिंहासन को भूमि पर पटक दिया है।<verse eid="PSA 89:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45" />तूने उसकी जवानी के दिनों को घटा दिया है,</para>
  <para style="q2" vid="PSA 89:45">और उसे लज्‍जा से ढाँप दिया है।</para>
  <para style="q1" vid="PSA 89:45">सेला।<verse eid="PSA 89:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46" />हे यहोवा, कब तक?</para>
  <para style="q2" vid="PSA 89:46">क्या तू सदा के लिए मुँह मोड़े रहेगा?</para>
  <para style="q1" vid="PSA 89:46">क्या तेरा क्रोध आग के समान भड़कता रहेगा?<verse eid="PSA 89:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47" />स्मरण कर कि मैं कैसा क्षणिक हूँ;</para>
  <para style="q2" vid="PSA 89:47">तूने सब मनुष्यों को क्यों व्यर्थ सृजा है?<verse eid="PSA 89:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48" />ऐसा कौन मनुष्य है जो सदा जीवित रहे,</para>
  <para style="q2" vid="PSA 89:48">और मृत्यु को न देखे?</para>
  <para style="q1" vid="PSA 89:48">क्या कोई अपने प्राण को अधोलोक से बचा सकता है?</para>
  <para style="q2" vid="PSA 89:48">सेला।<verse eid="PSA 89:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49" />हे प्रभु, तेरी प्राचीनकाल की करुणा कहाँ रही,</para>
  <para style="q2" vid="PSA 89:49">जिसके विषय में तूने सच्‍चाई के साथ</para>
  <para style="q1" vid="PSA 89:49">दाऊद से शपथ खाई थी?<verse eid="PSA 89:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50" />हे प्रभु, स्मरण कर कि कैसे</para>
  <para style="q2" vid="PSA 89:50">तेरे सेवकों की निंदा हुई थी;</para>
  <para style="q1" vid="PSA 89:50">मैं सब जातियों द्वारा किए गए</para>
  <para style="q2" vid="PSA 89:50">अपमान को अपने हृदय में सहता हूँ।<verse eid="PSA 89:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51" />हाँ, तेरे उन शत्रुओं ने तो हे यहोवा,</para>
  <para style="q2" vid="PSA 89:51">हर कदम पर तेरे अभिषिक्‍त की निंदा की है।<verse eid="PSA 89:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52" />यहोवा सदा-सर्वदा धन्य है!</para>
  <para style="q2" vid="PSA 89:52">आमीन फिर आमीन।<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="s1">चौथा भाग</para>
  <para style="b" />
  <para style="s1">भजन 90—106</para>
  <para style="b" />
  <para style="s1">अनंत परमेश्‍वर और नश्‍वर मनुष्य</para>
  <para style="b" />
  <para style="d">परमेश्‍वर के जन मूसा की प्रार्थना।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1" />हे प्रभु, तू पीढ़ी से पीढ़ी तक हमारा निवासस्थान रहा है।<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />पर्वतों को उत्पन्‍न‍ करने से पहले,</para>
  <para style="q2" vid="PSA 90:2">या इससे पहले कि तू पृथ्वी</para>
  <para style="q1" vid="PSA 90:2">और जगत की सृष्‍टि करता,</para>
  <para style="q2" vid="PSA 90:2">अनादिकाल से अनंतकाल तक तू ही परमेश्‍वर है।<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />तू मनुष्य को मिट्टी में लौटा देता है,</para>
  <para style="q2" vid="PSA 90:3">और कहता है,</para>
  <para style="q1" vid="PSA 90:3">“हे आदम की संतानो, लौट जाओ!”<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />क्योंकि हज़ार वर्ष तेरी दृष्‍टि में ऐसे हैं</para>
  <para style="q2" vid="PSA 90:4">जैसे कल का दिन जो बीत गया,</para>
  <para style="q1" vid="PSA 90:4">या जैसे रात का एक पहर।<verse eid="PSA 90:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />तू मनुष्यों को जल-धारा के समान बहा देता है;</para>
  <para style="q2" vid="PSA 90:5">वे स्वप्‍न के समान ठहरते हैं।</para>
  <para style="q1" vid="PSA 90:5">वे भोर को उगनेवाली घास के समान होते हैं,<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />जो भोर को फूलती और बढ़ती है,</para>
  <para style="q2" vid="PSA 90:6">और साँझ तक मुरझाकर सूख जाती है।<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />हम तो तेरे क्रोध से भस्म हुए हैं;</para>
  <para style="q2" vid="PSA 90:7">और तेरे प्रकोप से भयभीत हो गए हैं।<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />तूने हमारे अधर्मों को अपने सम्मुख,</para>
  <para style="q2" vid="PSA 90:8">और हमारे गुप्‍त पापों को</para>
  <para style="q1" vid="PSA 90:8">अपने मुख की ज्योति में रखा है।<verse eid="PSA 90:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />हमारे सब दिन तेरे क्रोध में कट जाते हैं;</para>
  <para style="q2" vid="PSA 90:9">और हम अपने वर्षों को</para>
  <para style="q1" vid="PSA 90:9">आहें भरते हुए बिताते हैं।<verse eid="PSA 90:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />हमारी आयु के वर्ष तो सत्तर होते हैं,</para>
  <para style="q2" vid="PSA 90:10">और चाहे बल के कारण अस्सी भी हो जाएँ,</para>
  <para style="q1" vid="PSA 90:10">फिर भी उनमें से अधिकतर कष्‍‍ट</para>
  <para style="q2" vid="PSA 90:10">और शोक में व्यतीत होते हैं।</para>
  <para style="q1" vid="PSA 90:10">हमारे वर्ष शीघ्र बीत जाते हैं,</para>
  <para style="q2" vid="PSA 90:10">और हम चले जाते हैं।<verse eid="PSA 90:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />तेरे क्रोध की शक्‍ति को कौन समझता है?</para>
  <para style="q2" vid="PSA 90:11">तेरा प्रकोप तेरे भय के योग्य है।<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />अतः हमें अपने दिन गिनना सिखा</para>
  <para style="q2" vid="PSA 90:12">कि हम बुद्धि से भरा मन पाएँ।<verse eid="PSA 90:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />हे यहोवा, कब तक?</para>
  <para style="q2" vid="PSA 90:13">लौट आ और अपने दासों पर तरस खा!<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />भोर को अपनी करुणा से हमें तृप्‍त कर</para>
  <para style="q2" vid="PSA 90:14">कि हम जीवन भर जय जयकार</para>
  <para style="q1" vid="PSA 90:14">और आनंद करते रहें।<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />जितने दिन तूने हमें दुःख दिए</para>
  <para style="q2" vid="PSA 90:15">और जितने वर्ष हमने क्लेश सहे हैं,</para>
  <para style="q1" vid="PSA 90:15">उतने ही वर्ष हमें आनंद के दे।<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />तेरा कार्य तेरे दासों पर,</para>
  <para style="q2" vid="PSA 90:16">और तेरा प्रताप उनकी संतान पर प्रकट हो।<verse eid="PSA 90:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17" />हमारे परमेश्‍वर यहोवा की मनोहरता हम पर प्रकट हो।</para>
  <para style="q2" vid="PSA 90:17">तू हमारे हाथों के कार्यों को</para>
  <para style="q1" vid="PSA 90:17">हमारे लिए दृढ़ कर;</para>
  <para style="q2" vid="PSA 90:17">हाँ, तू हमारे हाथों के कार्यों को दृढ़ कर।<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s1">परमेश्‍वर हमारा रक्षक</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1" />जो परमप्रधान की शरण में वास करता है,</para>
  <para style="q2" vid="PSA 91:1">वह सर्वशक्‍तिमान की छाया में ठिकाना पाएगा।<verse eid="PSA 91:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2" />मैं यहोवा के विषय में कहूँगा,</para>
  <para style="q2" vid="PSA 91:2">“वह मेरा शरणस्थान और दृढ़ गढ़ है;</para>
  <para style="q1" vid="PSA 91:2">वह मेरा परमेश्‍वर है,</para>
  <para style="q2" vid="PSA 91:2">मैं उस पर भरोसा रखता हूँ।”<verse eid="PSA 91:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />वह तुझे बहेलिए के जाल से</para>
  <para style="q2" vid="PSA 91:3">और महामारी से बचाएगा।<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />वह तुझे अपने परों से ढाँप लेगा,</para>
  <para style="q2" vid="PSA 91:4">और तू उसके पंखों तले शरण पाएगा;</para>
  <para style="q1" vid="PSA 91:4">उसकी सच्‍चाई ढाल और झिलम ठहरेगी।<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />तू न तो रात के आतंक से,</para>
  <para style="q2" vid="PSA 91:5">और न दिन के उड़ते तीर से डरेगा;<verse eid="PSA 91:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6" />तू उस महामारी से भी न डरेगा</para>
  <para style="q2" vid="PSA 91:6">जो अंधकार में फैलती है,</para>
  <para style="q1" vid="PSA 91:6">और न उस विनाश से</para>
  <para style="q2" vid="PSA 91:6">जो दोपहर में उजाड़ता है।<verse eid="PSA 91:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />तेरे निकट हज़ार,</para>
  <para style="q2" vid="PSA 91:7">और तेरे दाहिनी ओर दस हज़ार गिरेंगे;</para>
  <para style="q1" vid="PSA 91:7">परंतु वह तेरे निकट न आएगा।<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />परंतु तू अपनी आँखों से देखेगा</para>
  <para style="q2" vid="PSA 91:8">और दुष्‍टों का अंत तुझे दिखाई पड़ेगा।<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />क्योंकि तूने यहोवा को जो मेरा शरणस्थान है,</para>
  <para style="q2" vid="PSA 91:9">अर्थात् परमप्रधान को अपना निवासस्थान बनाया है,<verse eid="PSA 91:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10" />इसलिए न तो कोई विपत्ति तुझ पर आएगी,</para>
  <para style="q2" vid="PSA 91:10">और न कोई दुःख तेरे डेरे के निकट आएगा।<verse eid="PSA 91:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />वह अपने दूतों को तेरे विषय में आज्ञा देगा,</para>
  <para style="q2" vid="PSA 91:11">कि वे तेरे सब मार्गों में तेरी रक्षा करें।<verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />वे तुझे हाथों पर उठा लेंगे,</para>
  <para style="q2" vid="PSA 91:12">ताकि तेरे पैरों में पत्थर से चोट न लगे।<verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />तू सिंह और नाग को कुचलेगा;</para>
  <para style="q2" vid="PSA 91:13">तू जवान सिंह और अजगर को रौंदेगा।<verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />क्योंकि उसने मुझसे प्रेम किया है,</para>
  <para style="q2" vid="PSA 91:14">इसलिए मैं उसे छुड़ाऊँगा;</para>
  <para style="q1" vid="PSA 91:14">मैं उसकी रक्षा करूँगा,</para>
  <para style="q2" vid="PSA 91:14">क्योंकि उसने मेरे नाम को जान लिया है।<verse eid="PSA 91:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15" />जब वह मुझे पुकारेगा,</para>
  <para style="q2" vid="PSA 91:15">तब मैं उसकी सुनूँगा;</para>
  <para style="q1" vid="PSA 91:15">संकट में मैं उसके साथ रहूँगा;</para>
  <para style="q2" vid="PSA 91:15">मैं उसे बचाकर उसका सम्मान बढ़ाऊँगा।<verse eid="PSA 91:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16" />मैं उसे दीर्घायु से तृप्‍त करूँगा,</para>
  <para style="q2" vid="PSA 91:16">और अपने किए हुए</para>
  <para style="q1" vid="PSA 91:16">उद्धार का दर्शन कराऊँगा।<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s1">परमेश्‍वर का प्रेम और उसकी विश्‍वासयोग्यता</para>
  <para style="b" />
  <para style="d">भजन। विश्राम के दिन का गीत।</para>
  <para style="q1">
    <verse number="1-2" style="v" sid="PSA 92:1-2" />यहोवा का धन्यवाद करना भला है;</para>
  <para style="q2" vid="PSA 92:1-2">हे परमप्रधान, तेरे नाम का भजन गाना भला है।<verse eid="PSA 92:1-2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3" />भोर को तेरी करुणा</para>
  <para style="q2" vid="PSA 92:3">और रात को तेरी सच्‍चाई का</para>
  <para style="q1" vid="PSA 92:3">प्रचार दस तारवाले वाद्यों,</para>
  <para style="q2" vid="PSA 92:3">सारंगी और वीणा पर</para>
  <para style="q1" vid="PSA 92:3">संगीत बजाते हुए करना भला है।<verse eid="PSA 92:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />क्योंकि हे यहोवा,</para>
  <para style="q2" vid="PSA 92:4">तूने मुझे अपने कार्यों से आनंदित किया है;</para>
  <para style="q1" vid="PSA 92:4">मैं तेरे हाथों के कार्यों</para>
  <para style="q2" vid="PSA 92:4">के कारण जय जयकार करूँगा।<verse eid="PSA 92:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />हे यहोवा, तेरे कार्य कितने महान हैं!</para>
  <para style="q2" vid="PSA 92:5">तेरे विचार बहुत गहरे हैं!<verse eid="PSA 92:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6" />पशु समान मनुष्य इसे नहीं जानता,</para>
  <para style="q2" vid="PSA 92:6">और मूर्ख इसे नहीं समझता :<verse eid="PSA 92:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7" />चाहे दुष्‍ट घास के समान फूले-फलें,</para>
  <para style="q2" vid="PSA 92:7">और सब अनर्थकारी समृद्ध हो जाएँ,</para>
  <para style="q1" vid="PSA 92:7">फिर भी वे सर्वदा के लिए</para>
  <para style="q2" vid="PSA 92:7">नष्‍ट हो जाएँगे;<verse eid="PSA 92:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8" />परंतु हे यहोवा, तू सदा ऊँचे पर विराजमान रहेगा।<verse eid="PSA 92:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9" />क्योंकि हे यहोवा, तेरे शत्रु,</para>
  <para style="q2" vid="PSA 92:9">हाँ तेरे शत्रु नष्‍ट होंगे;</para>
  <para style="q1" vid="PSA 92:9">सब अनर्थकारी तितर-बितर हो जाएँगे।<verse eid="PSA 92:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10" />परंतु तूने मेरा सींग जंगली साँड़ के सींग के समान ऊँचा किया है;</para>
  <para style="q2" vid="PSA 92:10">तूने मुझ पर ताज़ा तेल उँडेला है।<verse eid="PSA 92:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11" />मेरी आँखों ने मेरे शत्रुओं को पराजित होते देखा,</para>
  <para style="q2" vid="PSA 92:11">और मेरे कानों ने</para>
  <para style="q1" vid="PSA 92:11">उन कुकर्मियों के विनाश को सुना</para>
  <para style="q2" vid="PSA 92:11">जो मेरे विरुद्ध उठ खड़े हुए थे।<verse eid="PSA 92:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12" />धर्मी लोग खजूर के वृक्ष के समान फूले-फलेंगे,</para>
  <para style="q2" vid="PSA 92:12">और लबानोन के देवदार के समान बढ़ते रहेंगे।<verse eid="PSA 92:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13" />वे यहोवा के भवन में रोपे गए हैं;</para>
  <para style="q2" vid="PSA 92:13">वे हमारे परमेश्‍वर के आँगनों में फूले-फलेंगे।<verse eid="PSA 92:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14" />बूढ़े हो जाने पर भी वे फलते रहेंगे;</para>
  <para style="q2" vid="PSA 92:14">वे स्वस्थ और लहलहाते रहेंगे,<verse eid="PSA 92:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15" />ताकि यह प्रकट हो कि यहोवा सच्‍चा है;</para>
  <para style="q2" vid="PSA 92:15">वह मेरी चट्टान है,</para>
  <para style="q1" vid="PSA 92:15">और उसमें कुछ भी कुटिलता नहीं है।<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s1">परमेश्‍वर का अनंत राज्य</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1" />यहोवा राज्य करता है,</para>
  <para style="q2" vid="PSA 93:1">वह प्रताप से सुशोभित है;</para>
  <para style="q1" vid="PSA 93:1">यहोवा सामर्थ्य का वस्‍त्र पहने</para>
  <para style="q2" vid="PSA 93:1">और उससे कमर कसे हुए है।</para>
  <para style="q1" vid="PSA 93:1">इस कारण जगत स्थिर है,</para>
  <para style="q2" vid="PSA 93:1">और न टलेगा।<verse eid="PSA 93:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />हे यहोवा, तेरा सिंहासन अनादिकाल से स्थिर है;</para>
  <para style="q2" vid="PSA 93:2">तू सदा से है।<verse eid="PSA 93:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3" />समुद्र की लहरें उठी हैं,</para>
  <para style="q2" vid="PSA 93:3">हे यहोवा, समुद्र की लहरें गर्जन के साथ उठी हैं;</para>
  <para style="q1" vid="PSA 93:3">प्रचंड लहरें उठकर आपस में टकरा रही हैं।<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />यहोवा महानदों के गर्जन से</para>
  <para style="q2" vid="PSA 93:4">और महासागर की बड़ी तरंगों</para>
  <para style="q1" vid="PSA 93:4">से भी अधिक महान है।<verse eid="PSA 93:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />तेरे नियम अति विश्‍वासयोग्य हैं।</para>
  <para style="q2" vid="PSA 93:5">हे यहोवा, तेरे भवन को पवित्रता सदा-सर्वदा शोभा देती है।<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s1">न्यायी परमेश्‍वर</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1" />हे यहोवा, बदला लेनेवाले परमेश्‍वर!</para>
  <para style="q2" vid="PSA 94:1">हे बदला लेनेवाले परमेश्‍वर,</para>
  <para style="q1" vid="PSA 94:1">अपना तेज दिखा!<verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />हे पृथ्वी के न्यायी, उठ;</para>
  <para style="q2" vid="PSA 94:2">घमंडियों को दंड<note caller="+" style="f"><char style="fr" closed="false">94:2 </char><char style="ft" closed="false">अक्षरशः बदला</char></note> दे</para>
  <para style="q1" vid="PSA 94:2">जिसके वे योग्य हैं!<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />हे यहोवा, दुष्‍ट लोग कब तक?</para>
  <para style="q2" vid="PSA 94:3">दुष्‍ट लोग कब तक आनंद मनाते रहेंगे?<verse eid="PSA 94:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />वे बकबक करते और ढिठाई की बातें बोलते हैं;</para>
  <para style="q2" vid="PSA 94:4">सब अनर्थकारी डींग मारते हैं।<verse eid="PSA 94:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />हे यहोवा, वे तेरे लोगों को कुचल डालते हैं,</para>
  <para style="q2" vid="PSA 94:5">और तेरे निज भाग को कष्‍‍ट पहुँचाते हैं।<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />वे विधवा और परदेशी को घात करते,</para>
  <para style="q2" vid="PSA 94:6">और अनाथों की हत्या करते हैं;<verse eid="PSA 94:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7" />वे कहते हैं :</para>
  <para style="q2" vid="PSA 94:7">“याह नहीं देखता;</para>
  <para style="q1" vid="PSA 94:7">याकूब का परमेश्‍वर ध्यान नहीं देता।”<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />तुम जो प्रजा में पशु-समान हो,</para>
  <para style="q2" vid="PSA 94:8">ध्यान दो; हे मूर्खो,</para>
  <para style="q1" vid="PSA 94:8">तुम कब बुद्धिमान बनोगे?<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />क्या जिसने कान दिया, वह स्वयं नहीं सुनता?</para>
  <para style="q2" vid="PSA 94:9">क्या जिसने आँख रची,</para>
  <para style="q1" vid="PSA 94:9">वह स्वयं नहीं देखता?<verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />जो जाति-जाति को ताड़ना देता</para>
  <para style="q2" vid="PSA 94:10">और मनुष्य को ज्ञान सिखाता है,</para>
  <para style="q1" vid="PSA 94:10">क्या वह झिड़केगा नहीं?<verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />यहोवा मनुष्य के विचारों को जानता है</para>
  <para style="q2" vid="PSA 94:11">कि वे तो व्यर्थ हैं।<verse eid="PSA 94:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12" />हे यहोवा, क्या ही धन्य है</para>
  <para style="q2" vid="PSA 94:12">वह मनुष्य जिसे तू ताड़ना देता है,</para>
  <para style="q1" vid="PSA 94:12">और अपनी व्यवस्था से सिखाता है,<verse eid="PSA 94:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13" />ताकि तू उसे विपत्ति के दिनों में उस समय तक राहत दे,</para>
  <para style="q2" vid="PSA 94:13">जब तक कि दुष्‍टों के लिए गड्‌ढा न खोदा जाए।<verse eid="PSA 94:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14" />क्योंकि यहोवा न तो अपनी प्रजा को त्यागेगा,</para>
  <para style="q2" vid="PSA 94:14">और न अपने निज भाग को छोड़ेगा।<verse eid="PSA 94:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15" />परंतु वह फिर धार्मिकता के अनुसार न्याय करेगा,</para>
  <para style="q2" vid="PSA 94:15">और सब सीधे मनवाले उसके पीछे हो लेंगे।<verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16" />मेरे लिए कुकर्मियों के विरुद्ध कौन खड़ा होगा?</para>
  <para style="q2" vid="PSA 94:16">अनर्थकारियों के विरुद्ध मेरा पक्ष कौन लेगा?<verse eid="PSA 94:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17" />यदि यहोवा मेरा सहायक न होता</para>
  <para style="q2" vid="PSA 94:17">तो मेरा प्राण शीघ्र ही</para>
  <para style="q1" vid="PSA 94:17">चिर-निद्रा में सो जाता।<verse eid="PSA 94:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18" />जब मैंने कहा, “मेरा पैर फिसलने पर है,</para>
  <para style="q2" vid="PSA 94:18">” तब हे यहोवा, तेरी करुणा ने मुझे थाम लिया।<verse eid="PSA 94:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19" />जब मेरे मन में बहुत सी चिंताएँ आती हैं,</para>
  <para style="q2" vid="PSA 94:19">तब तेरी दी हुई शांति से</para>
  <para style="q1" vid="PSA 94:19">मैं हर्षित हो जाता हूँ।<verse eid="PSA 94:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20" />क्या तेरे और उन दुष्‍ट न्यायियों<note caller="+" style="f"><char style="fr" closed="false">94:20 </char><char style="ft" closed="false">अक्षरशः दुष्‍‍टता के सिंहासन</char></note> के बीच</para>
  <para style="q2" vid="PSA 94:20">साँठ-गाँठ हो सकती है,</para>
  <para style="q1" vid="PSA 94:20">जो कानून की आड़ में उत्पात मचाते हैं?<verse eid="PSA 94:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21" />वे धर्मी का प्राण लेने के लिए दलबंदी करते हैं,</para>
  <para style="q2" vid="PSA 94:21">और निर्दोष को मृत्युदंड देते हैं।<verse eid="PSA 94:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22" />परंतु यहोवा मेरा दृढ़ गढ़ है;</para>
  <para style="q2" vid="PSA 94:22">मेरा परमेश्‍वर मेरी शरण की चट्टान है।<verse eid="PSA 94:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23" />उसने उनकी दुष्‍टता उन्हीं पर लौटा दी है;</para>
  <para style="q2" vid="PSA 94:23">वह उन्हीं की बुराई में उनका नाश करेगा।</para>
  <para style="q1" vid="PSA 94:23">हाँ, हमारा परमेश्‍वर यहोवा</para>
  <para style="q2" vid="PSA 94:23">उनका नाश कर डालेगा।<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s1">आराधना और चेतावनी</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1" />आओ हम यहोवा के लिए आनंदपूर्वक गाएँ;</para>
  <para style="q2" vid="PSA 95:1">अपने उद्धार की चट्टान का जय जयकार करें।<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />हम धन्यवाद करते हुए उसकी उपस्थिति में आएँ,</para>
  <para style="q2" vid="PSA 95:2">और भजन गाते हुए</para>
  <para style="q1" vid="PSA 95:2">उसका जय जयकार करें।<verse eid="PSA 95:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />क्योंकि यहोवा महान परमेश्‍वर है,</para>
  <para style="q2" vid="PSA 95:3">और सब देवताओं के ऊपर महान राजा है।<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />पृथ्वी के गहरे स्थान उसके हाथ में हैं;</para>
  <para style="q2" vid="PSA 95:4">और पहाड़ों की चोटियाँ भी उसी की हैं।<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />समुद्र उसका है, और उसे उसी ने बनाया है,</para>
  <para style="q2" vid="PSA 95:5">और सूखी भूमि को भी उसी के हाथों ने रचा है।<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />आओ हम झुककर दंडवत् करें,</para>
  <para style="q2" vid="PSA 95:6">और अपने सृष्‍टिकर्ता यहोवा के सामने घुटने टेकें।<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />क्योंकि वह हमारा परमेश्‍वर है,</para>
  <para style="q2" vid="PSA 95:7">और हम उसके चरागाह की प्रजा,</para>
  <para style="q1" vid="PSA 95:7">और उसके हाथ की भेड़ें हैं।<verse eid="PSA 95:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8" />यदि आज तुम उसकी बात सुनो</para>
  <para style="q2" vid="PSA 95:8">तो अपना हृदय ऐसा कठोर न करना,</para>
  <para style="q1" vid="PSA 95:8">जैसा उस दिन जंगल में मरीबा</para>
  <para style="q2" vid="PSA 95:8">और मस्सा में किया था,<verse eid="PSA 95:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9" />जब तुम्हारे पूर्वजों ने मेरी परीक्षा की थी।</para>
  <para style="q2" vid="PSA 95:9">यद्यपि उन्होंने मेरे कार्यों को देखा था,</para>
  <para style="q1" vid="PSA 95:9">फिर भी उन्होंने मुझे जाँचा।<verse eid="PSA 95:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10" />मैं चालीस वर्ष तक उस पीढ़ी के लोगों से क्रोधित रहा,</para>
  <para style="q2" vid="PSA 95:10">और मैंने कहा,</para>
  <para style="q1" vid="PSA 95:10">“ये तो ऐसे लोग हैं</para>
  <para style="q2" vid="PSA 95:10">जिनके मन भटक जाते हैं;</para>
  <para style="q1" vid="PSA 95:10">और ये मेरे मार्गों को नहीं जानते।”<verse eid="PSA 95:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11" />इस कारण मैंने क्रोध में</para>
  <para style="q2" vid="PSA 95:11">आकर यह शपथ खाई</para>
  <para style="q1" vid="PSA 95:11">कि ये मेरे विश्राम में प्रवेश नहीं करेंगे।<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="s1">पृथ्वी का राजा</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1" />यहोवा के लिए एक नया गीत गाओ!</para>
  <para style="q2" vid="PSA 96:1">हे सारी पृथ्वी के लोगो,</para>
  <para style="q1" vid="PSA 96:1">यहोवा के लिए गाओ!<verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />यहोवा के लिए गाओ,</para>
  <para style="q2" vid="PSA 96:2">उसके नाम को धन्य कहो;</para>
  <para style="q1" vid="PSA 96:2">दिन प्रतिदिन उसके किए हुए</para>
  <para style="q2" vid="PSA 96:2">उद्धार का सुसमाचार सुनाते रहो।<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />अन्यजातियों में उसकी महिमा का,</para>
  <para style="q2" vid="PSA 96:3">और देश-देश के लोगों में</para>
  <para style="q1" vid="PSA 96:3">उसके आश्‍चर्यकर्मों का वर्णन करो।<verse eid="PSA 96:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />क्योंकि यहोवा महान और अति स्तुति के योग्य है;</para>
  <para style="q2" vid="PSA 96:4">वह सब देवताओं से अधिक भययोग्य है।<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />क्योंकि देश-देश के सब देवता तो मूर्तियाँ ही हैं;</para>
  <para style="q2" vid="PSA 96:5">परंतु यहोवा ने आकाशमंडल को बनाया है।<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />उसके सम्मुख वैभव और ऐश्‍वर्य हैं;</para>
  <para style="q2" vid="PSA 96:6">उसके पवित्रस्थान में सामर्थ्य और शोभा हैं।<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />हे देश-देश के कुल के लोगो,</para>
  <para style="q2" vid="PSA 96:7">यहोवा को सराहो;</para>
  <para style="q1" vid="PSA 96:7">यहोवा की महिमा और सामर्थ्य को मानो!<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />यहोवा के नाम के योग्य उसकी महिमा करो;</para>
  <para style="q2" vid="PSA 96:8">भेंट लेकर उसके आँगनों में आओ।<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />पवित्रता से शोभायमान होकर यहोवा को दंडवत् करो।</para>
  <para style="q2" vid="PSA 96:9">हे सारी पृथ्वी के लोगो,</para>
  <para style="q1" vid="PSA 96:9">उसके सामने काँपते रहो।<verse eid="PSA 96:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />जाति-जाति के लोगों में कहो,</para>
  <para style="q2" vid="PSA 96:10">“यहोवा राज्य करता है।</para>
  <para style="q1" vid="PSA 96:10">जगत स्थिर है,</para>
  <para style="q2" vid="PSA 96:10">वह टलेगा नहीं।</para>
  <para style="q1" vid="PSA 96:10">यहोवा देश-देश के</para>
  <para style="q2" vid="PSA 96:10">लोगों का न्याय खराई से करेगा।”<verse eid="PSA 96:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />आकाश आनंदित हो,</para>
  <para style="q2" vid="PSA 96:11">और पृथ्वी मगन हो!</para>
  <para style="q1" vid="PSA 96:11">समुद्र और जो कुछ उसमें है,</para>
  <para style="q2" vid="PSA 96:11">गरज उठें!<verse eid="PSA 96:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12" />मैदान और जो कुछ उसमें है,</para>
  <para style="q2" vid="PSA 96:12">प्रफुल्लित हों! तब वन के सारे वृक्ष जय जयकार करेंगे।<verse eid="PSA 96:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13" />यह यहोवा के सामने हो,</para>
  <para style="q2" vid="PSA 96:13">क्योंकि वह आने वाला है।</para>
  <para style="q1" vid="PSA 96:13">वह पृथ्वी का न्याय</para>
  <para style="q2" vid="PSA 96:13">करने के लिए आने वाला है;</para>
  <para style="q1" vid="PSA 96:13">वह जगत का न्याय धार्मिकता से,</para>
  <para style="q2" vid="PSA 96:13">और देश-देश के लोगों का</para>
  <para style="q1" vid="PSA 96:13">न्याय सच्‍चाई से करेगा।<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s1">प्रतापी राजा</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1" />यहोवा राज्य करता है।</para>
  <para style="q2" vid="PSA 97:1">पृथ्वी मगन हो;</para>
  <para style="q1" vid="PSA 97:1">समुद्र तट के देश भी आनंदित हों।<verse eid="PSA 97:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />बादल और अंधकार उसे घेरे हुए हैं;</para>
  <para style="q2" vid="PSA 97:2">उसके सिंहासन का मूल धार्मिकता और न्याय है।<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />आग उसके आगे-आगे चलती है,</para>
  <para style="q2" vid="PSA 97:3">और उसके चारों ओर शत्रुओं को भस्म करती है।<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />उसकी बिजली से जगत प्रकाशित हो उठा;</para>
  <para style="q2" vid="PSA 97:4">पृथ्वी यह देखकर काँप उठी।<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />यहोवा अर्थात् सारी पृथ्वी के परमेश्‍वर के सामने</para>
  <para style="q2" vid="PSA 97:5">पहाड़ मोम के समान पिघल गए।<verse eid="PSA 97:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />आकाश ने उसकी धार्मिकता की घोषणा की है;</para>
  <para style="q2" vid="PSA 97:6">देश-देश के सब लोगों ने</para>
  <para style="q1" vid="PSA 97:6">उसकी महिमा देखी है।<verse eid="PSA 97:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />जो मूर्तियों की उपासना करते</para>
  <para style="q2" vid="PSA 97:7">और उन पर घमंड करते हैं,</para>
  <para style="q1" vid="PSA 97:7">वे लज्‍जित हों।</para>
  <para style="q2" vid="PSA 97:7">हे सब देवताओ,</para>
  <para style="q1" vid="PSA 97:7">तुम उसी को दंडवत् करो।<verse eid="PSA 97:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />सिय्योन सुनकर आनंदित हुआ,</para>
  <para style="q2" vid="PSA 97:8">और यहूदा की बेटियाँ मगन हुईं।</para>
  <para style="q1" vid="PSA 97:8">हे यहोवा, यह तेरे न्याय के कारण हुआ।<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />क्योंकि हे यहोवा,</para>
  <para style="q2" vid="PSA 97:9">तू सारी पृथ्वी के ऊपर परमप्रधान है;</para>
  <para style="q1" vid="PSA 97:9">तू सारे देवताओं से महान ठहरा है।<verse eid="PSA 97:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10" />हे यहोवा के प्रेमियो,</para>
  <para style="q2" vid="PSA 97:10">बुराई से घृणा करो।</para>
  <para style="q1" vid="PSA 97:10">वह अपने भक्‍तों के प्राणों की रक्षा करता,</para>
  <para style="q2" vid="PSA 97:10">और उन्हें दुष्‍टों के हाथ से छुड़ाता है।<verse eid="PSA 97:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11" />धर्मी लोगों के लिए ज्योति,</para>
  <para style="q2" vid="PSA 97:11">और सीधे मनवालों के लिए आनंद बोया गया है।<verse eid="PSA 97:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12" />हे धर्मियो, यहोवा में आनंदित रहो;</para>
  <para style="q2" vid="PSA 97:12">और उसकी पवित्रता का स्मरण करते हुए</para>
  <para style="q1" vid="PSA 97:12">उसका धन्यवाद करो!<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s1">राजा के लिए स्तुतिगान</para>
  <para style="b" />
  <para style="d">एक भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1" />यहोवा के लिए एक नया गीत गाओ,</para>
  <para style="q2" vid="PSA 98:1">क्योंकि उसने आश्‍चर्यकर्म किए हैं।</para>
  <para style="q1" vid="PSA 98:1">उसके दाहिने हाथ और पवित्र भुजा ने</para>
  <para style="q2" vid="PSA 98:1">उसके लिए विजय प्राप्‍त की है।<verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />यहोवा ने अपने किए हुए छुटकारे की घोषणा की है;</para>
  <para style="q2" vid="PSA 98:2">उसने अन्यजातियों की दृष्‍टि में अपनी धार्मिकता प्रकट की है।<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />उसने इस्राएल के घराने के प्रति अपनी करुणा</para>
  <para style="q2" vid="PSA 98:3">और सच्‍चाई को स्मरण किया है;</para>
  <para style="q1" vid="PSA 98:3">और पृथ्वी के सब दूर-दूर के</para>
  <para style="q2" vid="PSA 98:3">देशों ने हमारे परमेश्‍वर की विजय को देखा है।<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4" />हे सारी पृथ्वी के लोगो,</para>
  <para style="q2" vid="PSA 98:4">यहोवा का जय जयकार करो!</para>
  <para style="q1" vid="PSA 98:4">आनंद से भरकर जय जयकार करो,</para>
  <para style="q2" vid="PSA 98:4">और भजन गाओ!<verse eid="PSA 98:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5" />वीणा बजाकर, हाँ,</para>
  <para style="q2" vid="PSA 98:5">मधुर स्वर में वीणा बजाकर यहोवा का भजन गाओ।<verse eid="PSA 98:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6" />हमारे राजा यहोवा के सामने तुरहियाँ</para>
  <para style="q2" vid="PSA 98:6">और नरसिंगे फूँक फूँककर जय जयकार करो।<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />समुद्र और जो कुछ उसमें है,</para>
  <para style="q2" vid="PSA 98:7">गरज उठें! जगत और उसके निवासी हर्षनाद करें।<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8" />नदियाँ तालियाँ बजाएँ;</para>
  <para style="q2" vid="PSA 98:8">पहाड़ एक साथ मिलकर आनंद के गीत गाएँ।<verse eid="PSA 98:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9" />यह यहोवा के सामने हो,</para>
  <para style="q2" vid="PSA 98:9">क्योंकि वह पृथ्वी का न्याय करने के लिए आने वाला है।</para>
  <para style="q1" vid="PSA 98:9">वह जगत का न्याय धार्मिकता से,</para>
  <para style="q2" vid="PSA 98:9">और देश-देश के लोगों का न्याय खराई से करेगा।<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s1">पवित्र राजा</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />यहोवा राज्य करता है;</para>
  <para style="q2" vid="PSA 99:1">देश-देश के लोग काँप उठें!</para>
  <para style="q1" vid="PSA 99:1">वह करूबों पर विराजमान है;</para>
  <para style="q2" vid="PSA 99:1">पृथ्वी डोल उठे!<verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />यहोवा सिय्योन में महान है;</para>
  <para style="q2" vid="PSA 99:2">और वह सब लोगों के ऊपर प्रधान है।<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />वे तेरे महान और भययोग्य नाम का धन्यवाद करें।</para>
  <para style="q2" vid="PSA 99:3">यहोवा पवित्र है!<verse eid="PSA 99:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />सामर्थी राजा न्याय से प्रीति रखता है।</para>
  <para style="q2" vid="PSA 99:4">तूने खराई को स्थापित किया है;</para>
  <para style="q1" vid="PSA 99:4">तूने ही याकूब में न्याय</para>
  <para style="q2" vid="PSA 99:4">और धार्मिकता का कार्य किया है।<verse eid="PSA 99:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />हमारे परमेश्‍वर यहोवा का गुणगान करो;</para>
  <para style="q2" vid="PSA 99:5">और उसके चरणों की चौकी के सामने दंडवत् करो।</para>
  <para style="q1" vid="PSA 99:5">वह पवित्र है।<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6" />मूसा और हारून उसके याजकों में से थे,</para>
  <para style="q2" vid="PSA 99:6">और शमूएल उससे प्रार्थना करनेवालों में से था।</para>
  <para style="q1" vid="PSA 99:6">वे यहोवा से प्रार्थना करते</para>
  <para style="q2" vid="PSA 99:6">और वह उन्हें उत्तर देता था।<verse eid="PSA 99:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7" />वह उनसे बादल के खंभे में से बातें करता था;</para>
  <para style="q2" vid="PSA 99:7">और वे उसके नियमों और उसकी दी हुई</para>
  <para style="q1" vid="PSA 99:7">विधियों पर चलते थे।<verse eid="PSA 99:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8" />हे हमारे परमेश्‍वर यहोवा,</para>
  <para style="q2" vid="PSA 99:8">तू उन्हें उत्तर देता था;</para>
  <para style="q1" vid="PSA 99:8">तू उनके बुरे कार्यों का बदला तो लेता था,</para>
  <para style="q2" vid="PSA 99:8">फिर भी उनके लिए क्षमा करनेवाला परमेश्‍वर था।<verse eid="PSA 99:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9" />हमारे परमेश्‍वर यहोवा का गुणगान करो,</para>
  <para style="q2" vid="PSA 99:9">और उसके पवित्र पर्वत पर दंडवत् करो;</para>
  <para style="q1" vid="PSA 99:9">क्योंकि हमारा परमेश्‍वर यहोवा पवित्र है।<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s1">परमेश्‍वर का धन्यवाद करो</para>
  <para style="b" />
  <para style="d">धन्यवाद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />हे सारी पृथ्वी के लोगो,</para>
  <para style="q2" vid="PSA 100:1">यहोवा का जय जयकार करो!<verse eid="PSA 100:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2" />आनंद के साथ यहोवा की आराधना करो।</para>
  <para style="q2" vid="PSA 100:2">जय जयकार करते हुए उसके सम्मुख आओ।<verse eid="PSA 100:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />जान लो कि यहोवा ही परमेश्‍वर है।</para>
  <para style="q2" vid="PSA 100:3">उसी ने हमें बनाया है</para>
  <para style="q1" vid="PSA 100:3">और हम उसी के हैं;</para>
  <para style="q2" vid="PSA 100:3">हम उसकी प्रजा</para>
  <para style="q1" vid="PSA 100:3">और उसके चरागाह की भेड़ें हैं।<verse eid="PSA 100:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />उसके फाटकों में धन्यवाद,</para>
  <para style="q2" vid="PSA 100:4">और उसके आँगनों में स्तुति करते हुए प्रवेश करो;</para>
  <para style="q1" vid="PSA 100:4">उसका धन्यवाद करो,</para>
  <para style="q2" vid="PSA 100:4">और उसके नाम को धन्य कहो।<verse eid="PSA 100:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />क्योंकि यहोवा भला है,</para>
  <para style="q2" vid="PSA 100:5">और उसकी करुणा सदा की है;</para>
  <para style="q1" vid="PSA 100:5">उसकी सच्‍चाई पीढ़ी से पीढ़ी तक बनी रहती है।<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s1">खराई के साथ जीवन बिताने का संकल्प</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1" />मैं करुणा और न्याय के गीत गाऊँगा;</para>
  <para style="q2" vid="PSA 101:1">हे यहोवा, मैं तेरा ही भजन गाऊँगा।<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />मैं बुद्धिमानी से सिद्ध मार्ग पर चलूँगा।</para>
  <para style="q2" vid="PSA 101:2">तू कब मेरे पास आएगा?</para>
  <para style="q1" vid="PSA 101:2">मैं अपने घर में मन की खराई के साथ आचरण करूँगा।<verse eid="PSA 101:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3" />मैं अपना मन<note caller="+" style="f"><char style="fr" closed="false">101:3 </char><char style="ft" closed="false">अक्षरशः अपनी आँखें</char></note> दुष्‍टता के कार्य पर नहीं लगाऊँगा।</para>
  <para style="q2" vid="PSA 101:3">मैं अधर्म पर चलनेवालों के कार्यों से घृणा करता हूँ,</para>
  <para style="q1" vid="PSA 101:3">मैं उनमें न फँसूँगा।<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />हृदय की कुटिलता मुझसे दूर रहेगी,</para>
  <para style="q2" vid="PSA 101:4">मैं बुराई से अनजान रहूँगा।<verse eid="PSA 101:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />जो छिपकर अपने पड़ोसी की चुगली करे,</para>
  <para style="q2" vid="PSA 101:5">उसे मैं नाश करूँगा;</para>
  <para style="q1" vid="PSA 101:5">जिसकी आँखें चढ़ी हों</para>
  <para style="q2" vid="PSA 101:5">और जिसका मन घमंडी हो,</para>
  <para style="q1" vid="PSA 101:5">उसे मैं न सहूँगा।<verse eid="PSA 101:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />मेरी आँखें देश के विश्‍वासयोग्य लोगों पर लगी रहेंगी</para>
  <para style="q2" vid="PSA 101:6">कि वे मेरे साथ रहें;</para>
  <para style="q1" vid="PSA 101:6">जो सिद्ध मार्ग पर चलता है</para>
  <para style="q2" vid="PSA 101:6">वही मेरा सेवक होगा।<verse eid="PSA 101:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />छल करनेवाला मेरे घर के भीतर न रह सकेगा;</para>
  <para style="q2" vid="PSA 101:7">झूठ बोलनेवाला मेरे सामने बना न रहेगा।<verse eid="PSA 101:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />प्रति भोर मैं देश के सब दुष्‍टों को नाश किया करूँगा,</para>
  <para style="q2" vid="PSA 101:8">ताकि यहोवा के नगर के सब अनर्थकारियों को मिटा डालूँ।<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s1">दया की प्रार्थना</para>
  <para style="b" />
  <para style="d">पीड़ित जन की प्रार्थना। जब वह व्यथित होकर अपनी बातें यहोवा के सामने उंडेलता है।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />हे यहोवा, मेरी प्रार्थना सुन;</para>
  <para style="q2" vid="PSA 102:1">मेरी दुहाई तुझ तक पहुँचे।<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />मेरे संकट के दिन अपना मुख मुझसे न छिपा।</para>
  <para style="q2" vid="PSA 102:2">अपना कान मेरी ओर लगा;</para>
  <para style="q1" vid="PSA 102:2">जब मैं पुकारूँ,</para>
  <para style="q2" vid="PSA 102:2">तो मुझे शीघ्र उत्तर दे।<verse eid="PSA 102:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />क्योंकि मेरे दिन धुएँ के समान उड़े जाते हैं,</para>
  <para style="q2" vid="PSA 102:3">और मेरी हड्डियाँ भट्ठी के समान धधक रही हैं।<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />मेरा मन घास के समान झुलसकर सूख गया है,</para>
  <para style="q2" vid="PSA 102:4">यहाँ तक कि मैं अपनी रोटी खाना</para>
  <para style="q1" vid="PSA 102:4">भी भूल जाता हूँ।<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />ज़ोर-ज़ोर से कराहते-कराहते</para>
  <para style="q2" vid="PSA 102:5">मेरी चमड़ी मेरी हड्डियों से चिपक गई है।<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />मैं जंगल के धनेश के समान हो गया हूँ;</para>
  <para style="q2" vid="PSA 102:6">मैं खंडहरों के उल्लू के समान बन गया हूँ।<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />मैं लेटा हुआ जागता रहता हूँ;</para>
  <para style="q2" vid="PSA 102:7">मैं छत की अकेली गौरैया के समान हो गया हूँ।<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />मेरे शत्रु दिन भर मेरी निंदा करते हैं;</para>
  <para style="q2" vid="PSA 102:8">वे मेरा उपहास करते हैं</para>
  <para style="q1" vid="PSA 102:8">और मुझे शाप देते हैं।<verse eid="PSA 102:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9" />क्योंकि मैं रोटी के समान राख खाता हूँ,</para>
  <para style="q2" vid="PSA 102:9">और आँसू मिलाकर पानी पीता हूँ।<verse eid="PSA 102:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10" />यह तेरे क्रोध और तेरे प्रकोप के कारण हुआ है,</para>
  <para style="q2" vid="PSA 102:10">क्योंकि तूने मुझे उठाया</para>
  <para style="q1" vid="PSA 102:10">और फेंक दिया।<verse eid="PSA 102:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />मेरी आयु ढलती हुई छाया के समान है;</para>
  <para style="q2" vid="PSA 102:11">और मैं घास के समान सूख जाता हूँ।<verse eid="PSA 102:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />परंतु हे यहोवा, तू सदैव विराजमान है;</para>
  <para style="q2" vid="PSA 102:12">और तेरा स्मरण पीढ़ी से पीढ़ी तक होता रहेगा।<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />तू उठकर सिय्योन पर दया करेगा;</para>
  <para style="q2" vid="PSA 102:13">क्योंकि उस पर अनुग्रह करने का</para>
  <para style="q1" vid="PSA 102:13">निर्धारित समय आ पहुँचा है।<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />तेरे सेवक तो उसके पत्थरों को चाहते हैं,</para>
  <para style="q2" vid="PSA 102:14">और उसकी धूल पर तरस खाते हैं।<verse eid="PSA 102:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />इसलिए जाति-जाति के लोग यहोवा के नाम का,</para>
  <para style="q2" vid="PSA 102:15">और पृथ्वी के सब राजा तेरे प्रताप का भय मानेंगे।<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />क्योंकि यहोवा ने सिय्योन को फिर बसाया है,</para>
  <para style="q2" vid="PSA 102:16">और वह अपनी महिमा में प्रकट हुआ है।<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />वह लाचार की प्रार्थना पर ध्यान देता है,</para>
  <para style="q2" vid="PSA 102:17">और उनकी प्रार्थना को तुच्छ नहीं जानता।<verse eid="PSA 102:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18" />आने वाली पीढ़ी के लिए यह लिखा जाएगा</para>
  <para style="q2" vid="PSA 102:18">कि एक जाति जो सृजी जाने पर है,</para>
  <para style="q1" vid="PSA 102:18">वही याह की स्तुति करेगी।<verse eid="PSA 102:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19" />क्योंकि यहोवा ने अपने ऊँचे</para>
  <para style="q2" vid="PSA 102:19">और पवित्रस्थान से दृष्‍टि की;</para>
  <para style="q1" vid="PSA 102:19">हाँ, उसने स्वर्ग से पृथ्वी की ओर देखा है,<verse eid="PSA 102:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20" />कि बंदियों का कराहना सुने</para>
  <para style="q2" vid="PSA 102:20">और घात होनेवालों के बंधन खोले,<verse eid="PSA 102:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21" />ताकि सिय्योन में यहोवा के नाम का वर्णन,</para>
  <para style="q2" vid="PSA 102:21">और यरूशलेम में उसकी स्तुति हो।<verse eid="PSA 102:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22" />उस समय जाति-जाति और राज्य-राज्य के लोग</para>
  <para style="q2" vid="PSA 102:22">यहोवा की आराधना करने के लिए इकट्ठा होंगे।<verse eid="PSA 102:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23" />उसने जीवन यात्रा में मेरा बल क्षीण कर दिया,</para>
  <para style="q2" vid="PSA 102:23">और मेरी आयु को घटा दिया।<verse eid="PSA 102:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24" />मैंने कहा, “हे मेरे परमेश्‍वर,</para>
  <para style="q2" vid="PSA 102:24">मुझे आधी आयु में न उठा ले;</para>
  <para style="q1" vid="PSA 102:24">तेरे वर्ष तो पीढ़ी से पीढ़ी तक बने रहते हैं।<verse eid="PSA 102:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25" />आदि में तूने पृथ्वी की नींव डाली,</para>
  <para style="q2" vid="PSA 102:25">और आकाश तेरे हाथों का कार्य है।<verse eid="PSA 102:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26" />वे तो नष्‍ट हो जाएँगे,</para>
  <para style="q2" vid="PSA 102:26">परंतु तू बना रहेगा;</para>
  <para style="q1" vid="PSA 102:26">और वे सब कपड़े के समान पुराने हो जाएँगे।</para>
  <para style="q2" vid="PSA 102:26">तू उन्हें वस्‍त्र के समान बदलेगा,</para>
  <para style="q1" vid="PSA 102:26">और वे बदल जाएँगे।<verse eid="PSA 102:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27" />परंतु तू वही है,</para>
  <para style="q2" vid="PSA 102:27">और तेरे वर्षों का अंत न होगा।<verse eid="PSA 102:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28" />तेरे सेवकों की संतान बनी रहेगी,</para>
  <para style="q2" vid="PSA 102:28">और उनका वंश तेरे सम्मुख स्थिर रहेगा।”<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s1">यहोवा को धन्य कहो</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />हे मेरे मन, यहोवा को धन्य कह;</para>
  <para style="q2" vid="PSA 103:1">और जो कुछ मुझमें है,</para>
  <para style="q1" vid="PSA 103:1">वह उसके पवित्र नाम को धन्य कहे!<verse eid="PSA 103:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />हे मेरे मन, यहोवा को धन्य कह,</para>
  <para style="q2" vid="PSA 103:2">और उसके किसी उपकार को न भूल।<verse eid="PSA 103:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />वही तेरे सब अधर्म को क्षमा करता,</para>
  <para style="q2" vid="PSA 103:3">और तेरे सब रोगों को दूर करता है।<verse eid="PSA 103:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4" />वह तेरे प्राण को नष्‍ट होने से बचाता है,</para>
  <para style="q2" vid="PSA 103:4">और तेरे सिर पर करुणा</para>
  <para style="q1" vid="PSA 103:4">और दया का मुकुट रखता है।<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />वह तुझे<note caller="+" style="f"><char style="fr" closed="false">103:5 </char><char style="ft" closed="false">अक्षरशः तेरे आभूषण को</char></note> उत्तम वस्तुओं से तृप्‍त करता है,</para>
  <para style="q2" vid="PSA 103:5">जिससे तेरी जवानी उकाब के समान नई हो जाती है।<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />यहोवा सब पिसे हुओं के लिए धार्मिकता</para>
  <para style="q2" vid="PSA 103:6">और न्याय के कार्य करता है।<verse eid="PSA 103:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />उसने मूसा पर अपने मार्ग,</para>
  <para style="q2" vid="PSA 103:7">और इस्राएलियों पर अपने कार्य प्रकट किए।<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />यहोवा दयालु और अनुग्रहकारी,</para>
  <para style="q2" vid="PSA 103:8">क्रोध करने में धीमा और अति करुणामय है।<verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />वह सदैव डाँटता न रहेगा,</para>
  <para style="q2" vid="PSA 103:9">और न सदा क्रोध करता रहेगा।<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />उसने हमारे पापों के अनुसार हमसे व्यवहार नहीं किया,</para>
  <para style="q2" vid="PSA 103:10">और न ही हमारे अधर्म के कामों के</para>
  <para style="q1" vid="PSA 103:10">अनुसार हमें बदला दिया है।<verse eid="PSA 103:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />आकाश पृथ्वी से जितना ऊँचा है,</para>
  <para style="q2" vid="PSA 103:11">उसका भय माननेवालों पर उसकी करुणा उतनी ही महान है।<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />पूर्व पश्‍चिम से जितना दूर है,</para>
  <para style="q2" vid="PSA 103:12">उसने हमारे अपराधों को हमसे</para>
  <para style="q1" vid="PSA 103:12">उतना ही दूर कर दिया है।<verse eid="PSA 103:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />जैसे पिता अपने बच्‍चों पर दया करता है,</para>
  <para style="q2" vid="PSA 103:13">वैसे ही यहोवा उन पर दया करता है</para>
  <para style="q1" vid="PSA 103:13">जो उसका भय मानते हैं।<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />क्योंकि वह जानता है</para>
  <para style="q2" vid="PSA 103:14">कि हम कैसे बने हैं;</para>
  <para style="q1" vid="PSA 103:14">उसे स्मरण रहता है</para>
  <para style="q2" vid="PSA 103:14">कि मनुष्य मिट्टी ही है।<verse eid="PSA 103:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />मनुष्य की आयु घास के समान होती है;</para>
  <para style="q2" vid="PSA 103:15">वह मैदान के फूल के समान फूलता है,<verse eid="PSA 103:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16" />जो हवा का झोंका लगते ही ठहर नहीं पाता,</para>
  <para style="q2" vid="PSA 103:16">और अपने स्थान पर फिर दिखाई नहीं देता।<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17" />परंतु यहोवा की करुणा उसका भय माननेवालों पर सदा-सर्वदा</para>
  <para style="q2" vid="PSA 103:17">और उसकी धार्मिकता उनके नाती-पोतों पर बनी रहती है,<verse eid="PSA 103:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18" />अर्थात् उन पर जो उसकी वाचा का पालन करते</para>
  <para style="q2" vid="PSA 103:18">और उसके उपदेशों को स्मरण करके उन पर चलते हैं।<verse eid="PSA 103:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />यहोवा ने अपना सिंहासन स्वर्ग में स्थापित किया है;</para>
  <para style="q2" vid="PSA 103:19">और उसके राज्य की प्रभुता पूरी सृष्‍टि पर है।<verse eid="PSA 103:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />हे यहोवा के दूतो,</para>
  <para style="q2" vid="PSA 103:20">तुम जो बड़े पराक्रमी हो, और उसके वचन को</para>
  <para style="q1" vid="PSA 103:20">मानकर उसे पूरा करते हो,</para>
  <para style="q2" vid="PSA 103:20">उसे धन्य कहो!<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />हे यहोवा की सारी सेनाओ, हे उसके सेवको,</para>
  <para style="q2" vid="PSA 103:21">तुम जो उसकी इच्छा पूरी करते हो,</para>
  <para style="q1" vid="PSA 103:21">उसे धन्य कहो!<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />हे यहोवा की सारी सृष्‍टि,</para>
  <para style="q2" vid="PSA 103:22">उसके राज्य के सब स्थानों में उसे धन्य कह।</para>
  <para style="q1" vid="PSA 103:22">हे मेरे मन, यहोवा को धन्य कह!<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s1">सृष्‍टिकर्ता परमेश्‍वर</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />हे मेरे मन, यहोवा को धन्य कह!</para>
  <para style="q2" vid="PSA 104:1">हे मेरे परमेश्‍वर यहोवा, तू अति महान है;</para>
  <para style="q1" vid="PSA 104:1">तू वैभव और ऐश्‍वर्य का वस्‍त्र पहने है।<verse eid="PSA 104:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2" />तू उजियाले को चादर के समान ओढ़े रहता है,</para>
  <para style="q2" vid="PSA 104:2">और आकाश को तंबू के समान ताने रहता है।<verse eid="PSA 104:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3" />तू ऊपरी जल पर अपना निवासस्थान बनाता है,</para>
  <para style="q2" vid="PSA 104:3">और मेघों को अपना रथ बनाता है,</para>
  <para style="q1" vid="PSA 104:3">तथा पवन के पंखों पर सवारी करता है।<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />तू हवाओं को अपने दूत,</para>
  <para style="q2" vid="PSA 104:4">और आग की लपटों को अपने सेवक बनाता है।<verse eid="PSA 104:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5" />तूने पृथ्वी को उसकी नींव पर स्थिर किया है,</para>
  <para style="q2" vid="PSA 104:5">ताकि वह कभी न डगमगाए।<verse eid="PSA 104:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6" />तूने उसे वस्‍त्र के समान गहरे जल से ढाँप दिया है;</para>
  <para style="q2" vid="PSA 104:6">और पहाड़ों के ऊपर जल ठहर गया।<verse eid="PSA 104:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />तेरी घुड़की से जल भाग गया;</para>
  <para style="q2" vid="PSA 104:7">तेरे गरजने की आवाज़ से वह घबराकर भाग गया।<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />वह पहाड़ों पर से बहता हुआ घाटियों में उतरा</para>
  <para style="q2" vid="PSA 104:8">और तेरे ठहराए हुए स्थान पर आ गया।<verse eid="PSA 104:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9" />तूने सीमा निर्धारित की है</para>
  <para style="q2" vid="PSA 104:9">कि जल उसे लाँघ न सके,</para>
  <para style="q1" vid="PSA 104:9">और न लौटकर पृथ्वी को डुबा सके।<verse eid="PSA 104:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />तू सोतों को घाटियों में बहाता है;</para>
  <para style="q2" vid="PSA 104:10">वे पहाड़ों के बीच से बहते हैं,<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />उनसे मैदान के सब जीव-जंतु पानी पीते हैं,</para>
  <para style="q2" vid="PSA 104:11">जंगली गधे भी अपनी प्यास बुझाते हैं।<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />आकाश के पक्षी उनके किनारे बसेरा करते हैं;</para>
  <para style="q2" vid="PSA 104:12">वे डालियों पर चहचहाते हैं।<verse eid="PSA 104:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />तू अपने निवासस्थान से पहाड़ों को सींचता है;</para>
  <para style="q2" vid="PSA 104:13">तेरे कार्यों के फल से पृथ्वी तृप्‍त रहती है।<verse eid="PSA 104:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />तू पशुओं के लिए घास,</para>
  <para style="q2" vid="PSA 104:14">और मनुष्यों के उपयोग के लिए पेड़-पौधे उपजाता है,</para>
  <para style="q1" vid="PSA 104:14">ताकि वे भूमि से भोजन-वस्तुएँ प्राप्‍त कर सकें;<verse eid="PSA 104:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15" />अर्थात् दाखमधु जो मनुष्य के हृदय को आनंदित करता है,</para>
  <para style="q2" vid="PSA 104:15">तेल जो उसके मुख को चमकाता है,</para>
  <para style="q1" vid="PSA 104:15">और रोटी जो मनुष्य के हृदय को बल देती है।<verse eid="PSA 104:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />यहोवा के वृक्ष हरे-भरे रहते हैं,</para>
  <para style="q2" vid="PSA 104:16">अर्थात् लबानोन के देवदार जो उसने लगाए हैं।<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />उसमें पक्षी अपने घोंसले बनाते हैं;</para>
  <para style="q2" vid="PSA 104:17">हाँ, चीड़ के वृक्षों पर सारस का बसेरा होता है।<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />ऊँचे पहाड़ जंगली बकरों के लिए हैं;</para>
  <para style="q2" vid="PSA 104:18">और चट्टानें बिज्‍जुओं के लिए शरणस्थान हैं।<verse eid="PSA 104:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />उसने नियत समयों के लिए चंद्रमा को बनाया है;</para>
  <para style="q2" vid="PSA 104:19">सूर्य भी अपने अस्त होने का समय जानता है।<verse eid="PSA 104:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />तू अंधेरा करता है,</para>
  <para style="q2" vid="PSA 104:20">और रात हो जाती है,</para>
  <para style="q1" vid="PSA 104:20">जिसमें वन के सब जीव-जंतु चलते-फिरते हैं।<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />जवान सिंह शिकार के लिए दहाड़ते हैं,</para>
  <para style="q2" vid="PSA 104:21">और परमेश्‍वर से अपना आहार माँगते हैं।<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />जब सूर्य उदय होता है</para>
  <para style="q2" vid="PSA 104:22">तो वे वापस अपनी माँदों में जा बैठते हैं।<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />तब मनुष्य अपने कार्य के लिए,</para>
  <para style="q2" vid="PSA 104:23">और संध्या तक परिश्रम करने के लिए निकलता है।<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />हे यहोवा, तेरे कार्य तो अनगिनित हैं।</para>
  <para style="q2" vid="PSA 104:24">तूने इन सब को बुद्धि से बनाया है;</para>
  <para style="q1" vid="PSA 104:24">पृथ्वी तेरी संपदा से भरपूर है।<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />समुद्र भी कितना बड़ा और विशाल है,</para>
  <para style="q2" vid="PSA 104:25">जिसमें अनगिनित जलचर, अर्थात् छोटे-बडे़ जीव-जंतु भरे पड़े हैं।<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />उसमें जहाज़ आते-जाते हैं;</para>
  <para style="q2" vid="PSA 104:26">और उसमें लिव्यातान भी है</para>
  <para style="q1" vid="PSA 104:26">जिसे तूने उसमें खेलने के लिए बनाया है।<verse eid="PSA 104:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />इन सब को तेरा ही आसरा है</para>
  <para style="q2" vid="PSA 104:27">कि तू उनका आहार समय पर दिया करे।<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />तू उन्हें देता है और वे ले लेते हैं;</para>
  <para style="q2" vid="PSA 104:28">तू अपनी मुट्ठी खोलता है</para>
  <para style="q1" vid="PSA 104:28">और वे उत्तम पदार्थों से तृप्‍त होते हैं।<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />तू मुख फेर लेता है</para>
  <para style="q2" vid="PSA 104:29">और वे घबरा जाते हैं;</para>
  <para style="q1" vid="PSA 104:29">तू उनकी साँस ले लेता है</para>
  <para style="q2" vid="PSA 104:29">और उनके प्राण निकल जाते हैं,</para>
  <para style="q1" vid="PSA 104:29">और वे मिट्टी में मिल जाते हैं।<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />तू अपनी ओर से साँस भेजता है,</para>
  <para style="q2" vid="PSA 104:30">और वे उत्पन्‍न‍ होते हैं;</para>
  <para style="q1" vid="PSA 104:30">और तू पृथ्वी को नया कर देता है।<verse eid="PSA 104:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />यहोवा की महिमा सदा-सर्वदा होती रहे;</para>
  <para style="q2" vid="PSA 104:31">यहोवा अपने कार्यों से आनंदित हो।<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />वह पृथ्वी पर दृष्‍टि डालता है</para>
  <para style="q2" vid="PSA 104:32">और वह काँप उठती है।</para>
  <para style="q1" vid="PSA 104:32">वह पहाड़ों को छूता है</para>
  <para style="q2" vid="PSA 104:32">और वे धुआँ उगलते हैं।<verse eid="PSA 104:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />मैं जीवन भर यहोवा का गीत गाता रहूँगा;</para>
  <para style="q2" vid="PSA 104:33">जब तक मैं जीवित हूँ</para>
  <para style="q1" vid="PSA 104:33">तब तक अपने परमेश्‍वर का भजन गाता रहूँगा।<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />मेरा ध्यान करना उसे प्रिय लगे;</para>
  <para style="q2" vid="PSA 104:34">मैं तो यहोवा के कारण आनंदित रहूँगा।<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />पापी लोग पृथ्वी पर से मिट जाएँ,</para>
  <para style="q2" vid="PSA 104:35">और दुष्‍ट लोग भविष्य में न रहें।</para>
  <para style="q1" vid="PSA 104:35">हे मेरे मन, यहोवा को धन्य कह!</para>
  <para style="q2" vid="PSA 104:35">याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">104:35 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s1">अपने लोगों के प्रति परमेश्‍वर की विश्‍वासयोग्यता</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />यहोवा का धन्यवाद करो,</para>
  <para style="q2" vid="PSA 105:1">उससे प्रार्थना करो; देश-देश के लोगों में</para>
  <para style="q1" vid="PSA 105:1">उसके कार्य प्रकट करो।<verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />उसके लिए गीत गाओ, उसके लिए भजन गाओ;</para>
  <para style="q2" vid="PSA 105:2">उसके सब आश्‍चर्यकर्मों का वर्णन करो!<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />उसके पवित्र नाम की प्रशंसा करो;</para>
  <para style="q2" vid="PSA 105:3">यहोवा के खोजियों का हृदय आनंदित हो।<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />यहोवा और उसके सामर्थ्य को खोजो;</para>
  <para style="q2" vid="PSA 105:4">उसके दर्शन के निरंतर खोजी बने रहो।<verse eid="PSA 105:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5" />उसके किए हुए अद्भुत कार्यों को स्मरण करो;</para>
  <para style="q2" vid="PSA 105:5">उसके आश्‍चर्यकर्मों और उसके मुख से निकले निर्णयों को स्मरण करो।<verse eid="PSA 105:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6" />हे उसके दास अब्राहम के वंश,</para>
  <para style="q2" vid="PSA 105:6">हे याकूब की संतान, उसके चुने हुए लोग!<verse eid="PSA 105:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />वही हमारा परमेश्‍वर यहोवा है;</para>
  <para style="q2" vid="PSA 105:7">पूरी पृथ्वी पर उसी के निर्णय होते हैं।<verse eid="PSA 105:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />वह अपनी वाचा को सदा स्मरण रखता है,</para>
  <para style="q2" vid="PSA 105:8">यह वह वचन है</para>
  <para style="q1" vid="PSA 105:8">जो उसने हज़ार पीढ़ियों के लिए ठहराया है।<verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />उसने यही वाचा अब्राहम के साथ बाँधी,</para>
  <para style="q2" vid="PSA 105:9">और उसके विषय में</para>
  <para style="q1" vid="PSA 105:9">उसने इसहाक से शपथ खाई थी।<verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />उसने इसी वाचा को याकूब के लिए विधि,</para>
  <para style="q2" vid="PSA 105:10">और इस्राएल के लिए सदा की</para>
  <para style="q1" vid="PSA 105:10">वाचा के रूप में दृढ़ किया,<verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />और कहा, “मैं उत्तराधिकार के रूप में कनान देश तुझी को दूँगा,</para>
  <para style="q2" vid="PSA 105:11">जो तेरे वंशजों का भाग होगा।”<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />उस समय तो वे गिनती में कम थे,</para>
  <para style="q2" vid="PSA 105:12">बल्कि बहुत ही कम,</para>
  <para style="q1" vid="PSA 105:12">और उस देश में परदेशी थे।<verse eid="PSA 105:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13" />वे एक जाति से दूसरी जाति,</para>
  <para style="q2" vid="PSA 105:13">और एक राज्य से दूसरे राज्य में फिरते रहे;<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />परंतु उसने किसी मनुष्य को उन पर अंधेर करने न दिया;</para>
  <para style="q2" vid="PSA 105:14">और वह उनके विषय में राजाओं को यह चेतावनी देता था :<verse eid="PSA 105:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15" />“मेरे अभिषिक्‍तों को मत छूओ,</para>
  <para style="q2" vid="PSA 105:15">और न मेरे भविष्यवक्‍ताओं को हानि पहुँचाओ!”<verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />उसने उस देश में अकाल भेजा,</para>
  <para style="q2" vid="PSA 105:16">और अन्‍न के सब स्रोत बंद कर दिए।<verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />फिर उसने यूसुफ नाम के एक पुरुष को</para>
  <para style="q2" vid="PSA 105:17">उनसे पहले भेजा,</para>
  <para style="q1" vid="PSA 105:17">जो दास होने के लिए बेचा गया था।<verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />लोगों ने उसके पैरों में बेड़ियाँ डालकर उसे दुःख दिया;</para>
  <para style="q2" vid="PSA 105:18">उसे लोहे की ज़जीरों से जकड़कर रखा गया।<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />और जब तक उसकी बात पूरी न हुई</para>
  <para style="q2" vid="PSA 105:19">तब तक यहोवा का वचन</para>
  <para style="q1" vid="PSA 105:19">उसे कसौटी पर कसता रहा।<verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />तब राजा ने सैनिक भेजकर उसे निकलवा लिया,</para>
  <para style="q2" vid="PSA 105:20">हाँ, जातियों के शासक ने उसे मुक्‍त किया।<verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />उसने उसे अपने राजभवन का प्रधान,</para>
  <para style="q2" vid="PSA 105:21">और अपनी संपूर्ण संपदा पर अधिकारी ठहराया,<verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />कि वह उसके अधिपतियों को अपने नियंत्रण में रखे,</para>
  <para style="q2" vid="PSA 105:22">और उसके मंत्रियों<note caller="+" style="f"><char style="fr" closed="false">105:22 </char><char style="ft" closed="false">अक्षरशः वृद्धों</char></note> को बुद्धि की बातें सिखाए।<verse eid="PSA 105:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />फिर इस्राएल मिस्र में आया;</para>
  <para style="q2" vid="PSA 105:23">और याकूब हाम के देश में परदेशी होकर रहा।<verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />तब यहोवा ने अपनी प्रजा को संख्या में बहुत बढ़ाया,</para>
  <para style="q2" vid="PSA 105:24">और उसे उसके शत्रुओं से अधिक बलवंत किया।<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />उसने मिस्रियों के मन को ऐसा फेर दिया</para>
  <para style="q2" vid="PSA 105:25">कि वे उसकी प्रजा से बैर रखने,</para>
  <para style="q1" vid="PSA 105:25">और उसके सेवकों से छल-कपट करने लगे।<verse eid="PSA 105:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />उसने अपने दास मूसा को,</para>
  <para style="q2" vid="PSA 105:26">और अपने चुने हुए हारून को भेजा।<verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />उन्होंने उनके बीच उसके अद्भुत कार्य,</para>
  <para style="q2" vid="PSA 105:27">और हाम के देश में चमत्कार दिखाए।<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />उसने अंधकार भेजा,</para>
  <para style="q2" vid="PSA 105:28">और अंधियारा हो गया;</para>
  <para style="q1" vid="PSA 105:28">और वे उसके वचन के विरुद्ध नहीं गए।<verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />उसने मिस्रियों के जल को लहू में बदल दिया,</para>
  <para style="q2" vid="PSA 105:29">और मछलियों को मार डाला।<verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />मेंढक उनके देश में,</para>
  <para style="q2" vid="PSA 105:30">यहाँ तक कि उनके शासकों के</para>
  <para style="q1" vid="PSA 105:30">कक्षों में भी भर गए।<verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />उसने आज्ञा दी,</para>
  <para style="q2" vid="PSA 105:31">और डाँसों के झुंड आ गए,</para>
  <para style="q1" vid="PSA 105:31">और उनके सारे देश में कुटकियाँ छा गईं।<verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />उसने वर्षा के बदले ओले बरसाए,</para>
  <para style="q2" vid="PSA 105:32">और उनके देश में बिजलियाँ गिराईं<note caller="+" style="f"><char style="fr" closed="false">105:32 </char><char style="ft" closed="false">अक्षरशः धधकती आग</char></note>।<verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />उसने उनकी दाखलताओं और अंजीर के पेड़ों को काट डाला,</para>
  <para style="q2" vid="PSA 105:33">और उनके देश के सब पेड़ों को नष्‍ट कर दिया।<verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />उसने आज्ञा दी,</para>
  <para style="q2" vid="PSA 105:34">तब अनगिनित टिड्डियाँ और कीट आए,<verse eid="PSA 105:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35" />और उनके देश की सब वनस्पति को खा गए,</para>
  <para style="q2" vid="PSA 105:35">और भूमि की उपज को चट कर गए।<verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />उसने उनके देश के सब पहलौठों को,</para>
  <para style="q2" vid="PSA 105:36">अर्थात् उनके पौरुष के पहले फल को नष्‍ट किया।<verse eid="PSA 105:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />तब वह इस्राएलियों को सोने और चाँदी के साथ निकाल लाया,</para>
  <para style="q2" vid="PSA 105:37">और उनमें से कोई निर्बल न था।<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />उनके चले जाने से मिस्री आनंदित हुए,</para>
  <para style="q2" vid="PSA 105:38">क्योंकि उनमें उनका डर समा गया था।<verse eid="PSA 105:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />उसने छाया के लिए बादल फैलाया,</para>
  <para style="q2" vid="PSA 105:39">और रात को प्रकाश देने के लिए आग प्रकट की।<verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />उन्होंने माँगा तब उसने बटेरें भेजीं,</para>
  <para style="q2" vid="PSA 105:40">और उन्हें स्वर्गीय भोजन से तृप्‍त किया।<verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />उसने चट्टान फाड़ी तो जल फूट निकला,</para>
  <para style="q2" vid="PSA 105:41">और निर्जल भूमि पर नदी बहने लगी।<verse eid="PSA 105:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />क्योंकि उसे अपने दास अब्राहम के प्रति अपनी</para>
  <para style="q2" vid="PSA 105:42">पवित्र प्रतिज्ञा का स्मरण था।<verse eid="PSA 105:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />वह अपनी प्रजा को आनंद के साथ,</para>
  <para style="q2" vid="PSA 105:43">और अपने चुने हुओं को</para>
  <para style="q1" vid="PSA 105:43">जय जयकार के साथ निकाल लाया।<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />उसने उन्हें अन्यजातियों के देश दिए,</para>
  <para style="q2" vid="PSA 105:44">और उन्होंने अन्य लोगों के परिश्रम के फल पर</para>
  <para style="q1" vid="PSA 105:44">अधिकार कर लिया,<verse eid="PSA 105:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45" />कि वे उसकी विधियों को मानें,</para>
  <para style="q2" vid="PSA 105:45">और उसकी व्यवस्था का पालन करते रहें।</para>
  <para style="q1" vid="PSA 105:45">याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">105:45 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s1">परमेश्‍वर के प्रति लोगों की अविश्‍वासयोग्यता</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">106:1 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!</para>
  <para style="q2" vid="PSA 106:1">यहोवा का धन्यवाद करो</para>
  <para style="q1" vid="PSA 106:1">क्योंकि वह भला है,</para>
  <para style="q2" vid="PSA 106:1">और उसकी करुणा सदा की है!<verse eid="PSA 106:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />यहोवा के पराक्रम के कार्यों का वर्णन</para>
  <para style="q2" vid="PSA 106:2">कौन कर सकता है?</para>
  <para style="q1" vid="PSA 106:2">या उसका पूरा गुणानुवाद कौन कर सकता है?<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />क्या ही धन्य हैं</para>
  <para style="q2" vid="PSA 106:3">वे जो न्याय पर चलते हैं,</para>
  <para style="q1" vid="PSA 106:3">और हर समय धार्मिकता के कार्य करते हैं!<verse eid="PSA 106:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />हे यहोवा, जो कृपा तू अपनी प्रजा पर करता है</para>
  <para style="q2" vid="PSA 106:4">उसके अनुसार मुझे स्मरण कर।</para>
  <para style="q1" vid="PSA 106:4">उद्धार के लिए मेरी सुधि ले,<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />कि मैं तेरे चुने हुओं की भलाई देखूँ,</para>
  <para style="q2" vid="PSA 106:5">और तेरी प्रजा के आनंद में आनंदित हो जाऊँ,</para>
  <para style="q1" vid="PSA 106:5">और तेरे निज भाग के साथ स्तुति करूँ।<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />हमने अपने पूर्वजों के समान पाप किया है;</para>
  <para style="q2" vid="PSA 106:6">हमने कुटिलता की है,</para>
  <para style="q1" vid="PSA 106:6">हमने दुष्‍टता की है।<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />हमारे पूर्वजों ने मिस्र में तेरे आश्‍चर्यकर्मों को नहीं समझा;</para>
  <para style="q2" vid="PSA 106:7">उन्होंने तेरी अपार करुणा को स्मरण नहीं रखा;</para>
  <para style="q1" vid="PSA 106:7">उन्होंने समुद्र के किनारे</para>
  <para style="q2" vid="PSA 106:7">अर्थात् लाल समुद्र के किनारे विद्रोह किया।<verse eid="PSA 106:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />फिर भी उसने अपने नाम के कारण उन्हें बचाया</para>
  <para style="q2" vid="PSA 106:8">ताकि वह अपना पराक्रम प्रकट करे।<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />तब उसने लाल समुद्र को झिड़का और वह सूख गया;</para>
  <para style="q2" vid="PSA 106:9">और वह उन्हें गहरे जल में से</para>
  <para style="q1" vid="PSA 106:9">ऐसे निकाल ले गया जैसे</para>
  <para style="q2" vid="PSA 106:9">कि सूखी भूमि से।<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />इस प्रकार उसने उन्हें बैरी के हाथ से बचाया</para>
  <para style="q2" vid="PSA 106:10">और शत्रु के हाथ से छुड़ा लिया।<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />जल ने उनके शत्रुओं को ढाँप लिया;</para>
  <para style="q2" vid="PSA 106:11">उनमें से एक भी न बचा।<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />तब उन्होंने उसके वचनों पर विश्‍वास किया,</para>
  <para style="q2" vid="PSA 106:12">और वे उसकी स्तुति गाने लगे।<verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />परंतु वे शीघ्र उसके कार्यों को भूल गए;</para>
  <para style="q2" vid="PSA 106:13">और उसकी सम्मति के लिए न ठहरे।<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />वे जंगल में लालसा से भर गए,</para>
  <para style="q2" vid="PSA 106:14">और उन्होंने निर्जन स्थान में परमेश्‍वर की परीक्षा की।<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />उन्होंने जो माँगा, परमेश्‍वर ने उन्हें दिया,</para>
  <para style="q2" vid="PSA 106:15">परंतु उनके बीच महामारी भेज दी।<verse eid="PSA 106:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />उन्होंने छावनी में मूसा,</para>
  <para style="q2" vid="PSA 106:16">और यहोवा के पवित्र जन हारून से ईर्ष्या की;<verse eid="PSA 106:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17" />तब भूमि फट कर दातान को निगल गई;</para>
  <para style="q2" vid="PSA 106:17">और अबीराम का दल उसमें समा गया।<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />और उनके दल के बीच आग भड़क गई,</para>
  <para style="q2" vid="PSA 106:18">और उसकी लपटों ने दुष्‍ट लोगों को भस्म कर दिया।<verse eid="PSA 106:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />उन्होंने होरेब में एक बछड़े की मूर्ति गढ़ी,</para>
  <para style="q2" vid="PSA 106:19">और उसे दंडवत् किया।<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />इस प्रकार उन्होंने परमेश्‍वर की<note caller="+" style="f"><char style="fr" closed="false">106:20 </char><char style="ft" closed="false">अक्षरशः अपनी</char></note> महिमा को</para>
  <para style="q2" vid="PSA 106:20">घास खानेवाले बैल की प्रतिमा से बदल डाला।<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />वे अपने उद्धारकर्ता परमेश्‍वर को भूल गए,</para>
  <para style="q2" vid="PSA 106:21">जिसने मिस्र में बड़े-बडे़ कार्य किए थे।<verse eid="PSA 106:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22" />उसने तो हाम के देश में आश्‍चर्यकर्म</para>
  <para style="q2" vid="PSA 106:22">और लाल समुद्र के तट पर अद्भुत कार्य किए थे।<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />इसलिए उसने कहा कि वह उनका सत्यानाश कर डालता,</para>
  <para style="q2" vid="PSA 106:23">यदि उसका चुना हुआ जन मूसा</para>
  <para style="q1" vid="PSA 106:23">उसके उस कोप को ठंडा करने के लिए</para>
  <para style="q2" vid="PSA 106:23">उसके सामने आकर बीच में खड़ा न होता,</para>
  <para style="q1" vid="PSA 106:23">जो उन्हें नष्‍ट कर देता।<verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />फिर उन्होंने मनभावने देश को तुच्छ जाना,</para>
  <para style="q2" vid="PSA 106:24">और उसकी प्रतिज्ञा पर विश्‍वास नहीं किया।<verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />वे अपने तंबुओं में कुड़कुड़ाए,</para>
  <para style="q2" vid="PSA 106:25">और उन्होंने यहोवा की बात नहीं मानी।<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />इसलिए उसने उनके विषय में शपथ खाई</para>
  <para style="q2" vid="PSA 106:26">कि वह उन्हें जंगल में नाश कर देगा;<verse eid="PSA 106:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27" />और उनके वंश को अन्यजातियों के सामने गिरा देगा,</para>
  <para style="q2" vid="PSA 106:27">तथा उन्हें देश-देश में तितर-बितर करेगा।<verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />वे पोरवाले बाल देवता को पूजने लगे,</para>
  <para style="q2" vid="PSA 106:28">और मृतकों को चढ़ाए हुए बलि-पशुओं को खाने लगे।<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />इस प्रकार उन्होंने अपने कार्यों से उसका क्रोध भड़काया;</para>
  <para style="q2" vid="PSA 106:29">और उनमें महामारी फैल गई।<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />तब पीनहास ने उठकर न्यायदंड दिया,</para>
  <para style="q2" vid="PSA 106:30">जिससे महामारी थम गई;<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />और यह उसके लिए पीढ़ी से पीढ़ी तक</para>
  <para style="q2" vid="PSA 106:31">सर्वदा के लिए धार्मिकता गिना गया।<verse eid="PSA 106:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />उन्होंने मरीबा नामक सोते के पास यहोवा को क्रोध दिलाया।</para>
  <para style="q2" vid="PSA 106:32">उनके कारण मूसा की हानि हुई,<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />क्योंकि उन्होंने यहोवा के आत्मा से विद्रोह किया था;</para>
  <para style="q2" vid="PSA 106:33">और मूसा बिना सोचे-समझे बोल उठा।<verse eid="PSA 106:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />उन्होंने उन लोगों को नष्‍ट न किया,</para>
  <para style="q2" vid="PSA 106:34">जिन्हें नष्‍ट करने की आज्ञा यहोवा ने उन्हें दी थी,<verse eid="PSA 106:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35" />बल्कि वे उन्हीं जातियों से घुल-मिल गए,</para>
  <para style="q2" vid="PSA 106:35">और उन्होंने उनकी रीतियों को सीख लिया;<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />और उनकी मूर्तियों की उपासना करने लगे,</para>
  <para style="q2" vid="PSA 106:36">जो उनके लिए फंदा बन गईं।<verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />यहाँ तक कि उन्होंने अपने बेटे-बेटियों को</para>
  <para style="q2" vid="PSA 106:37">दुष्‍टात्माओं के लिए बलिदान किया।<verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />उन्होंने अपने निर्दोष बेटे-बेटियों का लहू बहाया,</para>
  <para style="q2" vid="PSA 106:38">जिसे उन्होंने कनान की मूर्तियों पर चढ़ाया;</para>
  <para style="q1" vid="PSA 106:38">इसलिए देश लहू से अपवित्र हो गया।<verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />इस प्रकार वे अपने कार्यों से अशुद्ध हो गए,</para>
  <para style="q2" vid="PSA 106:39">और अपने कर्मों के द्वारा व्यभिचारी बन गए।<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />तब यहोवा का क्रोध अपनी प्रजा पर भड़का,</para>
  <para style="q2" vid="PSA 106:40">और उसे अपने निज भाग से घृणा हुई;<verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />फिर उसने उन्हें अन्यजातियों के वश में कर दिया,</para>
  <para style="q2" vid="PSA 106:41">और उनके बैरियों ने उन पर प्रभुता की।<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />उनके शत्रुओं ने भी उन पर अंधेर किया,</para>
  <para style="q2" vid="PSA 106:42">और वे उनके अधीन हो गए।<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />उसने उन्हें बार-बार छुड़ाया,</para>
  <para style="q2" vid="PSA 106:43">परंतु वे उसके विरुद्ध विद्रोह करते रहे,</para>
  <para style="q1" vid="PSA 106:43">और अपने अधर्म में डूबते गए।<verse eid="PSA 106:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44" />फिर भी जब-जब उसने उनकी पुकार सुनी,</para>
  <para style="q2" vid="PSA 106:44">तब-तब उसने उनके संकट पर दृष्‍टि की।<verse eid="PSA 106:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45" />उसने उनके लिए अपनी वाचा को स्मरण करके</para>
  <para style="q2" vid="PSA 106:45">अपनी अपार करुणा के अनुसार तरस खाया,<verse eid="PSA 106:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46" />और उन सब से उन पर दया करवाई,</para>
  <para style="q2" vid="PSA 106:46">जो उन्हें बंधुआई में ले गए थे।<verse eid="PSA 106:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47" />हे हमारे परमेश्‍वर यहोवा, हमें बचा ले;</para>
  <para style="q2" vid="PSA 106:47">और देश-देश में से हमें फिर से इकट्ठा कर,</para>
  <para style="q1" vid="PSA 106:47">कि हम तेरे पवित्र नाम का धन्यवाद करें,</para>
  <para style="q2" vid="PSA 106:47">और तेरी स्तुति करने में अपने को धन्य समझें।<verse eid="PSA 106:47" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48" />इस्राएल का परमेश्‍वर यहोवा आदि से अनंतकाल तक धन्य है!</para>
  <para style="q2" vid="PSA 106:48">सब लोग कहें,</para>
  <para style="q1" vid="PSA 106:48">“आमीन।” याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">106:48 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="s1">पाँचवाँ भाग</para>
  <para style="b" />
  <para style="s1">भजन 107—150</para>
  <para style="b" />
  <para style="s1">छुटकारे के लिए परमेश्‍वर का धन्यवाद</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1" />यहोवा का धन्यवाद करो क्योंकि वह भला है,</para>
  <para style="q2" vid="PSA 107:1">और उसकी करुणा सदा की है!<verse eid="PSA 107:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />यहोवा के छुड़ाए हुए ऐसा ही कहें,</para>
  <para style="q2" vid="PSA 107:2">जिन्हें उसने शत्रु के हाथ से दाम</para>
  <para style="q1" vid="PSA 107:2">देकर छुड़ा लिया है,<verse eid="PSA 107:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3" />और उन्हें देश-देश से,</para>
  <para style="q2" vid="PSA 107:3">पूर्व और पश्‍चिम,</para>
  <para style="q1" vid="PSA 107:3">उत्तर और दक्षिण से इकट्ठा किया है।<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />वे उजाड़ जंगल में भटकते रहे,</para>
  <para style="q2" vid="PSA 107:4">और उन्हें बसने के लिए</para>
  <para style="q1" vid="PSA 107:4">किसी नगर का मार्ग न मिला।<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />जब वे भूख और प्यास के मारे मूर्च्छित होने लगे,<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />तब उन्होंने संकट के समय यहोवा की दुहाई दी,</para>
  <para style="q2" vid="PSA 107:6">और उसने उन्हें विपत्ति से छुड़ाया।<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />वह उन्हें सीधे मार्ग पर ले गया</para>
  <para style="q2" vid="PSA 107:7">कि वे बसने के लिए</para>
  <para style="q1" vid="PSA 107:7">किसी नगर को चले जाएँ।<verse eid="PSA 107:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />लोग यहोवा की करुणा के कारण,</para>
  <para style="q2" vid="PSA 107:8">और उन आश्‍चर्यकर्मों के कारण</para>
  <para style="q1" vid="PSA 107:8">जो वह मनुष्यों के लिए करता है,</para>
  <para style="q2" vid="PSA 107:8">उसका धन्यवाद करें!<verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />वह तो प्यासे को संतुष्‍ट करता है,</para>
  <para style="q2" vid="PSA 107:9">और भूखे को उत्तम पदार्थों से तृप्‍त करता है।<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10" />वे अंधकार, और मृत्यु की छाया में बैठे,</para>
  <para style="q2" vid="PSA 107:10">और दुःख में पड़े</para>
  <para style="q1" vid="PSA 107:10">और ज़ंजीरों से जकड़े हुए थे,<verse eid="PSA 107:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11" />क्योंकि उन्होंने परमेश्‍वर के वचनों के विरुद्ध विद्रोह किया,</para>
  <para style="q2" vid="PSA 107:11">और परमप्रधान की सम्मति को तुच्छ जाना।<verse eid="PSA 107:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />इसलिए उसने कष्‍‍ट देकर उन्हें दबाया;</para>
  <para style="q2" vid="PSA 107:12">वे ठोकर खाकर गिरे,</para>
  <para style="q1" vid="PSA 107:12">परंतु कोई सहायता करनेवाला न था।<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />तब उन्होंने संकट के समय यहोवा की दुहाई दी,</para>
  <para style="q2" vid="PSA 107:13">और उसने विपत्ति से उन्हें बचा लिया।<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />उसने उन्हें अंधकार, और मृत्यु की छाया में से निकाला,</para>
  <para style="q2" vid="PSA 107:14">और उनके बंधन तोड़ डाले।<verse eid="PSA 107:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15" />लोग यहोवा की करुणा के कारण,</para>
  <para style="q2" vid="PSA 107:15">और उन आश्‍चर्यकर्मों के कारण</para>
  <para style="q1" vid="PSA 107:15">जो वह मनुष्यों के लिए करता है,</para>
  <para style="q2" vid="PSA 107:15">उसका धन्यवाद करें!<verse eid="PSA 107:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16" />उसने पीतल के फाटकों को तोड़ा,</para>
  <para style="q2" vid="PSA 107:16">और उनकी लोहे की छड़ों को दो टुकड़े कर दिया।<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17" />मूर्ख अपने अपराधों,</para>
  <para style="q2" vid="PSA 107:17">और अधर्म के कामों के कारण दुःख उठाते हैं।<verse eid="PSA 107:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18" />उन्हें सब प्रकार के भोजन से अरुचि हो गई,</para>
  <para style="q2" vid="PSA 107:18">और वे मृत्यु के फाटक तक आ पहुँचे थे।<verse eid="PSA 107:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19" />तब उन्होंने संकट के समय यहोवा की दुहाई दी,</para>
  <para style="q2" vid="PSA 107:19">और उसने विपत्ति से उन्हें बचा लिया।<verse eid="PSA 107:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20" />उसने अपना वचन भेजकर उन्हें स्वस्थ किया,</para>
  <para style="q2" vid="PSA 107:20">और उन्हें विनाश से छुड़ा लिया।<verse eid="PSA 107:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21" />लोग यहोवा की करुणा के कारण,</para>
  <para style="q2" vid="PSA 107:21">और उन आश्‍चर्यकर्मों के कारण</para>
  <para style="q1" vid="PSA 107:21">जो वह मनुष्यों के लिए करता है,</para>
  <para style="q2" vid="PSA 107:21">उसका धन्यवाद करें!<verse eid="PSA 107:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22" />वे धन्यवाद का बलिदान चढ़ाएँ,</para>
  <para style="q2" vid="PSA 107:22">और जय जयकार करते हुए</para>
  <para style="q1" vid="PSA 107:22">उसके कार्यों का वर्णन करें।<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23" />कुछ लोग जहाज़ों में समुद्र की यात्रा करते</para>
  <para style="q2" vid="PSA 107:23">और महासागर के पार व्यापार करते थे;<verse eid="PSA 107:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24" />उन्होंने यहोवा के कार्यों को,</para>
  <para style="q2" vid="PSA 107:24">और गहरे समुद्र में उसके आश्‍चर्यकर्मों को देखा।<verse eid="PSA 107:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25" />उसने आज्ञा देकर प्रचंड आँधी चलाई,</para>
  <para style="q2" vid="PSA 107:25">जिससे समुद्र में लहरें उठीं।<verse eid="PSA 107:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26" />जहाज़ आकाश तक उठ गए,</para>
  <para style="q2" vid="PSA 107:26">और फिर गहराई में उतर आए;</para>
  <para style="q1" vid="PSA 107:26">और संकट के कारण लोगों के</para>
  <para style="q2" vid="PSA 107:26">जी में जी न रहा।<verse eid="PSA 107:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27" />वे चक्‍‍कर खाकर पियक्‍‍कड़ के समान लड़खड़ाए;</para>
  <para style="q2" vid="PSA 107:27">और उनकी बुद्धि भ्रष्‍‍ट हो गई।<verse eid="PSA 107:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28" />तब उन्होंने संकट के समय यहोवा की दुहाई दी,</para>
  <para style="q2" vid="PSA 107:28">और उसने उन्हें विपत्ति में से निकाला।<verse eid="PSA 107:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29" />उसने आँधी को शांत किया</para>
  <para style="q2" vid="PSA 107:29">और समुद्र की लहरें थम गईं।<verse eid="PSA 107:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30" />उनके थम जाने से वे आनंदित हुए;</para>
  <para style="q2" vid="PSA 107:30">इस प्रकार उसने उन्हें उनके</para>
  <para style="q1" vid="PSA 107:30">मनचाहे बंदरगाह तक पहुँचा दिया।<verse eid="PSA 107:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31" />लोग यहोवा की करुणा के कारण,</para>
  <para style="q2" vid="PSA 107:31">और उन आश्‍चर्यकर्मों के कारण</para>
  <para style="q1" vid="PSA 107:31">जो वह मनुष्यों के लिए करता है,</para>
  <para style="q2" vid="PSA 107:31">उसका धन्यवाद करें!<verse eid="PSA 107:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32" />लोगों की सभा में वे उसका गुणगान करें,</para>
  <para style="q2" vid="PSA 107:32">और वृद्धों की बैठक में उसकी स्तुति करें।<verse eid="PSA 107:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33" />वह नदियों को मरुभूमि,</para>
  <para style="q2" vid="PSA 107:33">और जल के सोतों को सूखी भूमि कर देता है।<verse eid="PSA 107:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34" />वह फलवंत भूमि को वहाँ रहनेवालों की</para>
  <para style="q2" vid="PSA 107:34">दुष्‍टता के कारण बंजर बना देता है।<verse eid="PSA 107:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35" />वह मरुभूमि को जलाशय,</para>
  <para style="q2" vid="PSA 107:35">और निर्जल भूमि को जल के सोतों में बदल देता है।<verse eid="PSA 107:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36" />वह वहाँ भूखों को बसाता है,</para>
  <para style="q2" vid="PSA 107:36">और वे रहने के लिए नगर तैयार करते हैं।<verse eid="PSA 107:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37" />वे वहाँ खेती करते,</para>
  <para style="q2" vid="PSA 107:37">दाख की बारियाँ लगाते और फल उपजाते हैं।<verse eid="PSA 107:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38" />वह उन्हें आशिष देता है और वे बहुत बढ़ जाते हैं,</para>
  <para style="q2" vid="PSA 107:38">और वह उनके पशुओं को भी घटने नहीं देता।<verse eid="PSA 107:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39" />जब वे अत्याचार,</para>
  <para style="q2" vid="PSA 107:39">विपत्ति और दुःख के कारण घटते और दब जाते हैं,<verse eid="PSA 107:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40" />तब वह शासकों पर अपमान उंडेलता</para>
  <para style="q2" vid="PSA 107:40">और उन्हें मार्ग-रहित जंगल में भटकाता है।<verse eid="PSA 107:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41" />परंतु वह दरिद्रों को दुःख से</para>
  <para style="q2" vid="PSA 107:41">छुड़ाकर ऊँचे पर रखता है,</para>
  <para style="q1" vid="PSA 107:41">और उनके परिवारों को भेड़ों के झुंड के समान बढ़ाता है।<verse eid="PSA 107:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42" />यह देखकर सीधे लोग आनंदित होते हैं,</para>
  <para style="q2" vid="PSA 107:42">परंतु सब कुटिल लोग अपने मुँह बंद रखते हैं।<verse eid="PSA 107:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43" />जो बुद्धिमान है,</para>
  <para style="q2" vid="PSA 107:43">वह इन बातों पर ध्यान देगा</para>
  <para style="q1" vid="PSA 107:43">और यहोवा की करुणा पर विचार करेगा।<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s1">विजय के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">एक गीत। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />हे परमेश्‍वर, मेरा मन स्थिर है;</para>
  <para style="q2" vid="PSA 108:1">मैं गाऊँगा, हाँ, मैं अपनी आत्मा से भजन गाऊँगा।<verse eid="PSA 108:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2" />हे सारंगी और वीणा जाग जाओ!</para>
  <para style="q2" vid="PSA 108:2">मैं भी भोर होते ही जाग उठूँगा।<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />हे यहोवा, मैं जाति-जाति के लोगों के बीच तेरा धन्यवाद करूँगा;</para>
  <para style="q2" vid="PSA 108:3">मैं देश-देश के लोगों के बीच तेरा भजन गाऊँगा।<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />क्योंकि तेरी करुणा आकाश से भी ऊँची है,</para>
  <para style="q2" vid="PSA 108:4">और तेरी सच्‍चाई आकाशमंडल तक पहुँचती है।<verse eid="PSA 108:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />हे परमेश्‍वर, स्वर्ग के ऊपर तू अति महान हो,</para>
  <para style="q2" vid="PSA 108:5">और तेरी महिमा सारी पृथ्वी पर फैल जाए!<verse eid="PSA 108:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />अपने दाहिने हाथ के द्वारा मुझे बचा,</para>
  <para style="q2" vid="PSA 108:6">और मेरी सुन ले कि तेरे प्रिय छुड़ाए जाएँ।<verse eid="PSA 108:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />परमेश्‍वर ने अपनी पवित्रता में कहा,</para>
  <para style="q2" vid="PSA 108:7">“मैं हर्षित होऊँगा;</para>
  <para style="q1" vid="PSA 108:7">मैं शकेम को बाँट दूँगा,</para>
  <para style="q2" vid="PSA 108:7">और सुक्‍कोत की तराई को नापूँगा।<verse eid="PSA 108:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8" />गिलाद मेरा है, मनश्शे भी मेरा है;</para>
  <para style="q2" vid="PSA 108:8">एप्रैम मेरे सिर का टोप है,</para>
  <para style="q1" vid="PSA 108:8">यहूदा मेरा राजदंड है।<verse eid="PSA 108:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9" />मोआब मेरे पैर धोने का बरतन है;</para>
  <para style="q2" vid="PSA 108:9">मैं एदोम पर अपना जूता फेंकूँगा;</para>
  <para style="q1" vid="PSA 108:9">मैं पलिश्त पर जय की घोषणा करूँगा।”<verse eid="PSA 108:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />मुझे गढ़ वाले नगर में कौन पहुँचाएगा?</para>
  <para style="q2" vid="PSA 108:10">एदोम तक मेरी अगुवाई कौन करेगा?<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />हे परमेश्‍वर, क्या तूने हमें त्याग नहीं दिया?</para>
  <para style="q2" vid="PSA 108:11">हे परमेश्‍वर, तू तो हमारी सेनाओं के साथ नहीं जाता।<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />शत्रु के विरुद्ध हमारी सहायता कर,</para>
  <para style="q2" vid="PSA 108:12">क्योंकि मनुष्य का किया हुआ छुटकारा व्यर्थ होता है।<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />परमेश्‍वर के साथ होकर हम वीरता दिखाएँगे;</para>
  <para style="q2" vid="PSA 108:13">और वही हमारे शत्रुओं को रौंदेगा।<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s1">शत्रु के विरुद्ध प्रतिशोध की प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />हे परमेश्‍वर, मैं तेरी स्तुति करता हूँ!</para>
  <para style="q2" vid="PSA 109:1">तू चुप न रह;<verse eid="PSA 109:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />क्योंकि दुष्‍ट और कपटी मनुष्यों ने मेरे विरुद्ध मुँह खोला है,</para>
  <para style="q2" vid="PSA 109:2">उन्होंने मेरे विषय में झूठ बोला है।<verse eid="PSA 109:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3" />उन्होंने घृणा के शब्दों से मुझे घेर लिया है,</para>
  <para style="q2" vid="PSA 109:3">और अकारण मुझ पर आक्रमण किया है।<verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />मेरे प्रेम के बदले में वे मेरा विरोध करते हैं,</para>
  <para style="q2" vid="PSA 109:4">परंतु मैं तो प्रार्थना में लीन रहता हूँ।<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />उन्होंने भलाई के बदले में मुझसे बुराई की</para>
  <para style="q2" vid="PSA 109:5">और मेरे प्रेम के बदले में मुझसे घृणा की है।<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />तू उस पर किसी दुष्‍ट मनुष्य को नियुक्‍त कर,</para>
  <para style="q2" vid="PSA 109:6">और दोष लगानेवाला उसके दाहिनी ओर खड़ा रहे।<verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />जब उसका न्याय हो तो वह दोषी ठहरे,</para>
  <para style="q2" vid="PSA 109:7">और उसकी प्रार्थना पाप समझी जाए।<verse eid="PSA 109:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8" />उसके दिन थोड़े हों;</para>
  <para style="q2" vid="PSA 109:8">उसका पद कोई और ले ले।<verse eid="PSA 109:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9" />उसके बच्‍चे अनाथ हो जाएँ,</para>
  <para style="q2" vid="PSA 109:9">और उसकी स्‍त्री विधवा हो जाए।<verse eid="PSA 109:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10" />उसके बच्‍चे मारे-मारे फिरें,</para>
  <para style="q2" vid="PSA 109:10">और भीख माँगें; उन्हें अपने उजड़े हुए स्थानों से</para>
  <para style="q1" vid="PSA 109:10">दूर जाकर टुकड़े माँगने पड़ें।<verse eid="PSA 109:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11" />सूदख़ोर छल से उसका सब कुछ छीन ले;</para>
  <para style="q2" vid="PSA 109:11">और परदेशी उसकी कमाई को लूट लें।<verse eid="PSA 109:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12" />उस पर करुणा करनेवाला कोई न रहे,</para>
  <para style="q2" vid="PSA 109:12">और न उसके अनाथ बच्‍चों पर कोई तरस खाए।<verse eid="PSA 109:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13" />उसके वंश का नाश हो जाए,</para>
  <para style="q2" vid="PSA 109:13">दूसरी पीढ़ी में उसका नाम मिट जाए।<verse eid="PSA 109:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14" />उसके पूर्वजों का अधर्म यहोवा को स्मरण रहे,</para>
  <para style="q2" vid="PSA 109:14">और उसकी माता का पाप मिटाया न जाए।<verse eid="PSA 109:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15" />वे निरंतर यहोवा के सामने रहें</para>
  <para style="q2" vid="PSA 109:15">कि वह उनकी स्मृति तक को</para>
  <para style="q1" vid="PSA 109:15">पृथ्वी पर से मिटा डाले।<verse eid="PSA 109:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16" />क्योंकि उसे दया करना स्मरण न रहा,</para>
  <para style="q2" vid="PSA 109:16">बल्कि वह दीन, दरिद्र और निराश व्यक्‍ति को</para>
  <para style="q1" vid="PSA 109:16">मार डालने के लिए उनके पीछे पड़ा रहता था।<verse eid="PSA 109:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17" />उसे शाप देना पसंद था,</para>
  <para style="q2" vid="PSA 109:17">पर शाप उसी पर आ पड़ा;</para>
  <para style="q1" vid="PSA 109:17">वह आशिष देने से प्रसन्‍न न होता था,</para>
  <para style="q2" vid="PSA 109:17">इसलिए आशिष उससे दूर रही।<verse eid="PSA 109:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18" />उसने शाप को अपने वस्‍त्र के समान पहन लिया;</para>
  <para style="q2" vid="PSA 109:18">शाप उसके पेट में पानी के समान</para>
  <para style="q1" vid="PSA 109:18">और उसकी हड्डियों में तेल के समान समा जाए।<verse eid="PSA 109:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19" />वह उसके लिए ओढ़ने का वस्‍त्र ठहरे,</para>
  <para style="q2" vid="PSA 109:19">और कटिबंध की तरह उसकी कमर में सदा बंधा रहे।<verse eid="PSA 109:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20" />यहोवा की ओर से मेरे विरोधियों को,</para>
  <para style="q2" vid="PSA 109:20">और मेरे विरुद्ध बुरा कहनेवालों को यही बदला मिले।<verse eid="PSA 109:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21" />परंतु हे यहोवा मेरे प्रभु,</para>
  <para style="q2" vid="PSA 109:21">तू अपने नाम के अनुरूप मुझसे व्यवहार कर;</para>
  <para style="q1" vid="PSA 109:21">तेरी करुणा तो उत्तम है,</para>
  <para style="q2" vid="PSA 109:21">इसलिए मुझे छुड़ा ले।<verse eid="PSA 109:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22" />मैं तो दीन और दरिद्र हूँ,</para>
  <para style="q2" vid="PSA 109:22">और मेरा हृदय घायल है।<verse eid="PSA 109:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23" />मैं ढलती हुई छाया के समान मिटता जा रहा हूँ;</para>
  <para style="q2" vid="PSA 109:23">मैं टिड्डी के समान झाड़ दिया गया हूँ।<verse eid="PSA 109:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24" />उपवास करते-करते मेरे घुटने निर्बल हो गए,</para>
  <para style="q2" vid="PSA 109:24">और चरबी न रहने से मेरा शरीर सूख गया है।<verse eid="PSA 109:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25" />मैं उनके लिए निंदा का पात्र बन गया हूँ;</para>
  <para style="q2" vid="PSA 109:25">वे मुझे देखकर सिर हिलाते हैं।<verse eid="PSA 109:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26" />हे मेरे परमेश्‍वर यहोवा,</para>
  <para style="q2" vid="PSA 109:26">मेरी सहायता कर!</para>
  <para style="q1" vid="PSA 109:26">अपनी करुणा के अनुसार मुझे बचा,<verse eid="PSA 109:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27" />ताकि वे जान लें कि यह तेरा ही कार्य है।</para>
  <para style="q2" vid="PSA 109:27">हे यहोवा, तूने ही यह किया है।<verse eid="PSA 109:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28" />चाहे वे कोसते रहें,</para>
  <para style="q2" vid="PSA 109:28">पर तू आशिष दे।</para>
  <para style="q1" vid="PSA 109:28">जब वे उठें तो लज्‍जित हों,</para>
  <para style="q2" vid="PSA 109:28">परंतु तेरा दास आनंदित हो।<verse eid="PSA 109:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29" />मेरे विरोधियों को अनादर का वस्‍त्र पहनाया जाए</para>
  <para style="q2" vid="PSA 109:29">और उन्हें अपनी लज्‍जा को चादर के समान ओढ़ना पड़े।<verse eid="PSA 109:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30" />मैं यहोवा का बहुत धन्यवाद करूँगा;</para>
  <para style="q2" vid="PSA 109:30">और बहुत से लोगों के बीच मैं उसकी स्तुति करूँगा।<verse eid="PSA 109:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31" />क्योंकि वह दरिद्र के दाहिनी ओर खड़ा रहेगा</para>
  <para style="q2" vid="PSA 109:31">कि उसे मृत्युदंड देनेवालों से बचाए।<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s1">परमेश्‍वर का चुना हुआ राजा</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />यहोवा ने मेरे प्रभु से कहा,</para>
  <para style="q2" vid="PSA 110:1">“मेरे दाहिनी ओर बैठ,</para>
  <para style="q1" vid="PSA 110:1">जब तक कि मैं तेरे शत्रुओं को</para>
  <para style="q2" vid="PSA 110:1">तेरे पैरों की चौकी न बना दूँ।”<verse eid="PSA 110:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />यहोवा तेरे सामर्थ्य के राजदंड को सिय्योन से बढ़ाएगा।</para>
  <para style="q2" vid="PSA 110:2">तू अपने शत्रुओं के बीच शासन कर।<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />तेरे युद्ध के दिन तेरी प्रजा के लोग</para>
  <para style="q2" vid="PSA 110:3">स्वेच्छा से सामने आएँगे;</para>
  <para style="q1" vid="PSA 110:3">पवित्रता से शोभायमान तेरे जवान तेरे लिए</para>
  <para style="q2" vid="PSA 110:3">भोर के गर्भ से जन्मी ओस के समान हैं।<verse eid="PSA 110:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />यहोवा ने शपथ खाई है और उसे न बदलेगा :</para>
  <para style="q2" vid="PSA 110:4">“तू मलिकिसिदक की रीति के अनुसार सदा के लिए याजक है।”<verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />प्रभु तेरे दाहिनी ओर है;</para>
  <para style="q2" vid="PSA 110:5">अपने क्रोध के दिन वह राजाओं को कुचल डालेगा।<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />वह जाति-जाति के लोगों को दंड देगा,</para>
  <para style="q2" vid="PSA 110:6">और लाशों का ढेर लगा देगा;</para>
  <para style="q1" vid="PSA 110:6">वह समस्त पृथ्वी के प्रधानों को कुचल देगा।<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />वह मार्ग के किनारे के सोते से जल पीएगा;</para>
  <para style="q2" vid="PSA 110:7">इसलिए वह अपना सिर ऊँचा करेगा।<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s1">भलाई के लिए परमेश्‍वर की स्तुति</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">111:1 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!</para>
  <para style="q2" vid="PSA 111:1">मैं सीधे लोगों की गोष्‍ठी में,</para>
  <para style="q1" vid="PSA 111:1">और मंडली में भी संपूर्ण मन से यहोवा का धन्यवाद करूँगा।<verse eid="PSA 111:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />यहोवा के कार्य महान हैं,</para>
  <para style="q2" vid="PSA 111:2">जो उनसे प्रसन्‍न रहते हैं,</para>
  <para style="q1" vid="PSA 111:2">वे सब उन पर ध्यान लगाते हैं।<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />उसके कार्य वैभवशाली और प्रतापमय हैं,</para>
  <para style="q2" vid="PSA 111:3">और उसकी धार्मिकता सदैव बनी रहती है।<verse eid="PSA 111:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />उसने अपने आश्‍चर्यकर्मों का स्मरण कराया है;</para>
  <para style="q2" vid="PSA 111:4">यहोवा अनुग्रहकारी और दयालु है।<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />उसने अपने भय माननेवालों को भोजन प्रदान किया है;</para>
  <para style="q2" vid="PSA 111:5">वह अपनी वाचा को सदा स्मरण रखता है।<verse eid="PSA 111:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />उसने जाति-जाति की भूमि अपनी प्रजा को देकर</para>
  <para style="q2" vid="PSA 111:6">अपने कार्यों का सामर्थ्य उन पर प्रकट किया है।<verse eid="PSA 111:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />सत्य और न्याय उसके हाथों के कार्य हैं।</para>
  <para style="q2" vid="PSA 111:7">उसकी सब आज्ञाएँ विश्‍वासयोग्य हैं;<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />वे सदा-सर्वदा अटल हैं।</para>
  <para style="q2" vid="PSA 111:8">उनका पालन सच्‍चाई और सीधाई से किया जाता है।<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />उसने अपनी प्रजा को छुड़ाया है;</para>
  <para style="q2" vid="PSA 111:9">उसने अपनी वाचा को सदा के लिए ठहराया है।</para>
  <para style="q1" vid="PSA 111:9">उसका नाम पवित्र और भययोग्य है।<verse eid="PSA 111:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />यहोवा का भय मानना बुद्धि का मूल है।</para>
  <para style="q2" vid="PSA 111:10">जो उसकी आज्ञाओं को मानते हैं,</para>
  <para style="q1" vid="PSA 111:10">उन सब की समझ उत्तम होती है।</para>
  <para style="q2" vid="PSA 111:10">उसकी स्तुति सदा होती रहेगी।<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s1">धर्मी व्यक्‍ति के गुण</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">112:1 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!</para>
  <para style="q2" vid="PSA 112:1">क्या ही धन्य है वह मनुष्य</para>
  <para style="q1" vid="PSA 112:1">जो यहोवा का भय मानता है,</para>
  <para style="q2" vid="PSA 112:1">और उसकी आज्ञाओं से अति प्रसन्‍न रहता है।<verse eid="PSA 112:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />उसका वंश पृथ्वी पर पराक्रमी होगा;</para>
  <para style="q2" vid="PSA 112:2">सीधे लोगों की संतान आशिष पाएगी।<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />उसके घर में धन-संपत्ति रहती है,</para>
  <para style="q2" vid="PSA 112:3">और उसकी धार्मिकता सदा बनी रहती है।<verse eid="PSA 112:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />वह सीधे लोगों के लिए अंधकार में ज्योति है;</para>
  <para style="q2" vid="PSA 112:4">वह कृपालु, दयालु और धर्मी है।<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />उस मनुष्य का भला होता है</para>
  <para style="q2" vid="PSA 112:5">क्योंकि वह कृपा करके उधार देता है,</para>
  <para style="q1" vid="PSA 112:5">और न्यायपूर्वक अपने कार्य करता है।<verse eid="PSA 112:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />वह तो सदा तक अटल रहेगा;</para>
  <para style="q2" vid="PSA 112:6">धर्मी का स्मरण सदा बना रहेगा।<verse eid="PSA 112:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />वह बुरे समाचार से नहीं डरता;</para>
  <para style="q2" vid="PSA 112:7">यहोवा पर भरोसा रखने के कारण उसका हृदय स्थिर रहता है।<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />उसका हृदय स्थिर है,</para>
  <para style="q2" vid="PSA 112:8">वह न डरेगा, बल्कि अपने शत्रुओं को विजय-दृष्‍टि से देखेगा।<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />उसने उदारता से दरिद्रों को दान दिया;</para>
  <para style="q2" vid="PSA 112:9">उसकी धार्मिकता सदा बनी रहती है।</para>
  <para style="q1" vid="PSA 112:9">उसका सिर<note caller="+" style="f"><char style="fr" closed="false">112:9 </char><char style="ft" closed="false">अक्षरशः सींग</char></note> सम्मान से ऊँचा किया जाएगा।<verse eid="PSA 112:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10" />दुष्‍ट यह देखकर क्रोधित होगा।</para>
  <para style="q2" vid="PSA 112:10">वह अपने दाँत पीसेगा और गल गलकर मर जाएगा।</para>
  <para style="q1" vid="PSA 112:10">दुष्‍टों की लालसा पूरी न होगी।<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s1">दयालु परमेश्‍वर की स्तुति</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">113:1 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!</para>
  <para style="q2" vid="PSA 113:1">हे यहोवा के दासो, स्तुति करो;</para>
  <para style="q1" vid="PSA 113:1">यहोवा के नाम की स्तुति करो!<verse eid="PSA 113:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />यहोवा का नाम अब से</para>
  <para style="q2" vid="PSA 113:2">लेकर सर्वदा तक धन्य हो।<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />उदयाचल से लेकर अस्ताचल तक</para>
  <para style="q2" vid="PSA 113:3">यहोवा के नाम की स्तुति हो।<verse eid="PSA 113:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />यहोवा सब जातियों के ऊपर महान है,</para>
  <para style="q2" vid="PSA 113:4">और उसकी महिमा आकाश से भी ऊँची है।<verse eid="PSA 113:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />हमारे परमेश्‍वर यहोवा के तुल्य कौन है?</para>
  <para style="q2" vid="PSA 113:5">वह तो ऊँचे पर विराजमान है,<verse eid="PSA 113:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6" />और आकाश और पृथ्वी पर दृष्‍टि करने के लिए झुकता है।<verse eid="PSA 113:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />वह कंगाल को मिट्टी पर से,</para>
  <para style="q2" vid="PSA 113:7">और दरिद्र को कूड़े के ढेर से</para>
  <para style="q1" vid="PSA 113:7">उठाकर ऊँचा करता है,<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />कि उन्हें प्रधानों के संग,</para>
  <para style="q2" vid="PSA 113:8">अर्थात् अपनी प्रजा के प्रधानों के संग बैठाए।<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />वह बाँझ स्‍त्री को घर में</para>
  <para style="q2" vid="PSA 113:9">बच्‍चों की आनंदित माता बनाता है।</para>
  <para style="q1" vid="PSA 113:9">याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">113:9 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s1">परमेश्‍वर द्वारा इस्राएल का छुटकारा</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1" />जब इस्राएल मिस्र से,</para>
  <para style="q2" vid="PSA 114:1">अर्थात् याकूब का घराना अन्य भाषियों के बीच से निकला,<verse eid="PSA 114:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2" />तब यहूदा यहोवा का पवित्रस्थान</para>
  <para style="q2" vid="PSA 114:2">और इस्राएल उसका राज्य हो गया।<verse eid="PSA 114:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />समुद्र देखकर भागा, यरदन नदी उलटी बही।<verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />पहाड़ मेढ़ों के समान उछलने लगे,</para>
  <para style="q2" vid="PSA 114:4">और पहाड़ियाँ भेड़-बकरियों के बच्‍चों के समान उछलने लगीं।<verse eid="PSA 114:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />हे समुद्र, तू क्यों भागा?</para>
  <para style="q2" vid="PSA 114:5">हे यरदन, तू उलटी क्यों बही?<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />हे पहाड़ो, तुम मेढ़ों के समान क्यों उछले?</para>
  <para style="q2" vid="PSA 114:6">हे पहाड़ियो,</para>
  <para style="q1" vid="PSA 114:6">तुम भेड़-बकरियों के बच्‍चों के समान क्यों उछलीं?<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7" />हे पृथ्वी, प्रभु के सामने,</para>
  <para style="q2" vid="PSA 114:7">हाँ, याकूब के परमेश्‍वर के सामने काँप;<verse eid="PSA 114:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8" />जिसने चट्टान को जलाशय,</para>
  <para style="q2" vid="PSA 114:8">और चकमक के पत्थर को जल का सोता बना डाला।<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s1">एकमात्र सच्‍‍चे परमेश्‍वर की महिमा</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />हे यहोवा, हमारी नहीं, हमारी नहीं,</para>
  <para style="q2" vid="PSA 115:1">बल्कि अपनी करुणा और सच्‍चाई के कारण</para>
  <para style="q1" vid="PSA 115:1">अपने ही नाम की महिमा कर।<verse eid="PSA 115:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />जाति-जाति के लोग यह क्यों कहें</para>
  <para style="q2" vid="PSA 115:2">कि उनका परमेश्‍वर कहाँ है?<verse eid="PSA 115:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />हमारा परमेश्‍वर तो स्वर्ग में है;</para>
  <para style="q2" vid="PSA 115:3">उसने जो चाहा वही किया है।<verse eid="PSA 115:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />उन लोगों की मूर्तियाँ तो सोने-चाँदी की हैं,</para>
  <para style="q2" vid="PSA 115:4">वे मनुष्यों के हाथों की कारीगरी हैं।<verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />उनके मुँह तो हैं,</para>
  <para style="q2" vid="PSA 115:5">परंतु वे बोल नहीं सकतीं;</para>
  <para style="q1" vid="PSA 115:5">उनकी आँखें तो हैं,</para>
  <para style="q2" vid="PSA 115:5">परंतु वे देख नहीं सकतीं।<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />उनके कान तो हैं,</para>
  <para style="q2" vid="PSA 115:6">परंतु वे सुन नहीं सकतीं;</para>
  <para style="q1" vid="PSA 115:6">उनकी नाक तो हैं,</para>
  <para style="q2" vid="PSA 115:6">परंतु वे सूँघ नहीं सकतीं।<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />उनके हाथ तो हैं,</para>
  <para style="q2" vid="PSA 115:7">परंतु वे स्पर्श नहीं कर सकतीं;</para>
  <para style="q1" vid="PSA 115:7">उनके पैर तो हैं,</para>
  <para style="q2" vid="PSA 115:7">परंतु वे चल नहीं सकतीं।</para>
  <para style="q1" vid="PSA 115:7">वे अपने कंठ से कोई आवाज़ भी नहीं निकाल सकतीं।<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />जैसी वे हैं वैसे ही उनके बनानेवाले भी हैं;</para>
  <para style="q2" vid="PSA 115:8">और वे सब भी जो उन पर भरोसा रखते हैं।<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />हे इस्राएल, यहोवा पर भरोसा रख—</para>
  <para style="q2" vid="PSA 115:9">वह उनका सहायक और उनकी ढाल है।<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />हे हारून के घराने,</para>
  <para style="q2" vid="PSA 115:10">यहोवा पर भरोसा रख—</para>
  <para style="q1" vid="PSA 115:10">वह उनका सहायक और उनकी ढाल है।<verse eid="PSA 115:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11" />हे यहोवा का भय माननेवालो,</para>
  <para style="q2" vid="PSA 115:11">यहोवा पर भरोसा रखो—</para>
  <para style="q1" vid="PSA 115:11">वह उनका सहायक और उनकी ढाल है।<verse eid="PSA 115:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12" />यहोवा ने हमें स्मरण किया है;</para>
  <para style="q2" vid="PSA 115:12">वह हमें आशिष देगा।</para>
  <para style="q1" vid="PSA 115:12">वह इस्राएल के घराने को आशिष देगा;</para>
  <para style="q2" vid="PSA 115:12">वह हारून के घराने को आशिष देगा।<verse eid="PSA 115:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13" />क्या छोटे क्या बड़े जितने यहोवा का भय मानते हैं,</para>
  <para style="q2" vid="PSA 115:13">वह उन्हें आशिष देगा।<verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14" />यहोवा तुम्हें और तुम्हारी संतानों को भी बढ़ाता जाए!<verse eid="PSA 115:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15" />यहोवा जो आकाश और पृथ्वी का कर्ता है,</para>
  <para style="q2" vid="PSA 115:15">उसकी ओर से तुम्हें आशिष मिले।<verse eid="PSA 115:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16" />स्वर्ग तो यहोवा का है,</para>
  <para style="q2" vid="PSA 115:16">परंतु पृथ्वी उसने मनुष्यों को दी है।<verse eid="PSA 115:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17" />मृतक याह की स्तुति नहीं करते,</para>
  <para style="q2" vid="PSA 115:17">और न ही वे जो चिर-निद्रा में</para>
  <para style="q1" vid="PSA 115:17">चले जाते हैं।<verse eid="PSA 115:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18" />परंतु हम याह को अब से लेकर</para>
  <para style="q2" vid="PSA 115:18">सर्वदा तक धन्य कहते रहेंगे।</para>
  <para style="q1" vid="PSA 115:18">याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">115:18 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s1">छुटकारे के लिए परमेश्‍वर का धन्यवाद</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />मैं यहोवा से प्रेम रखता हूँ,</para>
  <para style="q2" vid="PSA 116:1">क्योंकि वह मेरे गिड़गिड़ाने को सुनता है।<verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />क्योंकि उसने मेरी ओर कान लगाया है,</para>
  <para style="q2" vid="PSA 116:2">इसलिए मैं जीवन भर उसे पुकारूँगा।<verse eid="PSA 116:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3" />मृत्यु की रस्सियों ने मुझे चारों ओर से जकड़ लिया था,</para>
  <para style="q2" vid="PSA 116:3">और अधोलोक की पीड़ा मुझ पर आ पड़ी थी;</para>
  <para style="q1" vid="PSA 116:3">मुझे संकट और शोक भोगना पड़ा।<verse eid="PSA 116:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4" />तब मैंने यहोवा के नाम से प्रार्थना की,</para>
  <para style="q2" vid="PSA 116:4">“हे यहोवा, मेरा प्राण बचा ले।”<verse eid="PSA 116:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5" />यहोवा अनुग्रहकारी और धर्मी है;</para>
  <para style="q2" vid="PSA 116:5">हाँ, हमारा परमेश्‍वर दया करनेवाला है।<verse eid="PSA 116:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6" />यहोवा भोलों की रक्षा करता है;</para>
  <para style="q2" vid="PSA 116:6">जब मैं निर्बल हो गया था,</para>
  <para style="q1" vid="PSA 116:6">तो उसने मेरा उद्धार किया।<verse eid="PSA 116:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7" />हे मेरे प्राण,</para>
  <para style="q2" vid="PSA 116:7">तू अपने विश्राम में लौट आ;</para>
  <para style="q1" vid="PSA 116:7">क्योंकि यहोवा ने तेरे साथ भलाई की है।<verse eid="PSA 116:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8" />तूने तो मेरे प्राण को मृत्यु से,</para>
  <para style="q2" vid="PSA 116:8">मेरी आँख को आँसू बहाने से,</para>
  <para style="q1" vid="PSA 116:8">और मेरे पैरों को ठोकर खाने से बचाया है।<verse eid="PSA 116:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9" />इसलिए मैं यहोवा के सामने</para>
  <para style="q2" vid="PSA 116:9">जीवितों के देश में चलता रहूँगा।<verse eid="PSA 116:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10" />जब मैंने कहा कि मैं तो बहुत पीड़ित हूँ,</para>
  <para style="q2" vid="PSA 116:10">तब भी मैंने विश्‍वास रखा।<note caller="+" style="f"><char style="fr" closed="false">116:10 </char><char style="ft" closed="false">कुछ हस्तलेखों के अनुसार इस पद का अनुवाद इस प्रकार है : “मैंने विश्‍वास किया इसलिए मैंने कहा, ‘मैं तो बहुत पीड़ित हूँ।’ ”</char></note><verse eid="PSA 116:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11" />मैंने उतावली से कहा था,</para>
  <para style="q2" vid="PSA 116:11">“सब मनुष्य झूठे हैं।”<verse eid="PSA 116:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12" />यहोवा ने मुझ पर जितने उपकार किए हैं,</para>
  <para style="q2" vid="PSA 116:12">उनके बदले मैं उसे क्या दूँ?<verse eid="PSA 116:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13" />मैं उद्धार का कटोरा उठाकर यहोवा से प्रार्थना करूँगा;<verse eid="PSA 116:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14" />मैं यहोवा के लिए अपनी मन्‍नतों को</para>
  <para style="q2" vid="PSA 116:14">उसकी सारी प्रजा के सामने अवश्य पूरी करूँगा।<verse eid="PSA 116:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15" />यहोवा की दृष्‍टि में उसके भक्‍तों की मृत्यु अनमोल है।<verse eid="PSA 116:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16" />हे यहोवा, सुन, मैं तेरा दास हूँ;</para>
  <para style="q2" vid="PSA 116:16">मैं तो तेरा दास हूँ,</para>
  <para style="q1" vid="PSA 116:16">और तेरी दासी का पुत्र हूँ।</para>
  <para style="q2" vid="PSA 116:16">तूने मेरे बंधन खोल दिए हैं।<verse eid="PSA 116:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17" />मैं तुझे धन्यवाद का बलिदान चढ़ाऊँगा,</para>
  <para style="q2" vid="PSA 116:17">और यहोवा से प्रार्थना करूँगा।<verse eid="PSA 116:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18" />मैं यहोवा के लिए अपनी मन्‍नतों को</para>
  <para style="q2" vid="PSA 116:18">उसकी सारी प्रजा के सामने अवश्य पूरी करूँगा।<verse eid="PSA 116:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19" />मैं उन्हें यहोवा के भवन के आँगनों में,</para>
  <para style="q2" vid="PSA 116:19">हे यरूशलेम, तेरे भीतर पूरी करूँगा।</para>
  <para style="q1" vid="PSA 116:19">याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">116:19 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s1">परमेश्‍वर की स्तुति के लिए बुलाहट</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />हे जाति-जाति के सब लोगो,</para>
  <para style="q2" vid="PSA 117:1">यहोवा की स्तुति करो!</para>
  <para style="q1" vid="PSA 117:1">हे राज्य-राज्य के सब लोगो,</para>
  <para style="q2" vid="PSA 117:1">उसकी प्रशंसा करो!<verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />क्योंकि हम पर उसकी अपार करुणा हुई है;</para>
  <para style="q2" vid="PSA 117:2">और यहोवा की सच्‍चाई सदा की है।</para>
  <para style="q1" vid="PSA 117:2">याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">117:2 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s1">विजय के लिए धन्यवाद</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />यहोवा का धन्यवाद करो</para>
  <para style="q2" vid="PSA 118:1">क्योंकि वह भला है,</para>
  <para style="q1" vid="PSA 118:1">और उसकी करुणा सदा की है!<verse eid="PSA 118:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />इस्राएल कहे,</para>
  <para style="q2" vid="PSA 118:2">“उसकी करुणा सदा की है।”<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />हारून का घराना कहे,</para>
  <para style="q2" vid="PSA 118:3">“उसकी करुणा सदा की है।”<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />यहोवा का भय माननेवाले कहें,</para>
  <para style="q2" vid="PSA 118:4">“उसकी करुणा सदा की है।”<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />संकट में मैंने याह को पुकारा;</para>
  <para style="q2" vid="PSA 118:5">याह ने मुझे उत्तर दिया,</para>
  <para style="q1" vid="PSA 118:5">और मुझे चौड़े स्थान में पहुँचाया।<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />यहोवा मेरी ओर है,</para>
  <para style="q2" vid="PSA 118:6">मैं न डरूँगा।</para>
  <para style="q1" vid="PSA 118:6">मनुष्य मेरा क्या कर सकता है?<verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />मेरे सहायक के रूप में यहोवा मेरी ओर है;</para>
  <para style="q2" vid="PSA 118:7">इसलिए मैं अपने बैरियों को पराजित होते देखूँगा।<verse eid="PSA 118:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />यहोवा की शरण लेना,</para>
  <para style="q2" vid="PSA 118:8">मनुष्य पर भरोसा रखने से उत्तम है।<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />यहोवा की शरण लेना,</para>
  <para style="q2" vid="PSA 118:9">प्रधानों पर भरोसा रखने से भी उत्तम है।<verse eid="PSA 118:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />सब जातियों ने मुझे घेर लिया है;</para>
  <para style="q2" vid="PSA 118:10">परंतु मैं उन्हें यहोवा के नाम से निश्‍चय नष्‍ट कर डालूँगा।<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />उन्होंने मुझे घेर लिया है,</para>
  <para style="q2" vid="PSA 118:11">हाँ, उन्होंने मुझे घेर लिया है;</para>
  <para style="q1" vid="PSA 118:11">मैं उन्हें यहोवा के नाम से निश्‍चय नष्‍ट कर डालूँगा।<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />उन्होंने मुझे मधुमक्खियों के समान घेर लिया था,</para>
  <para style="q2" vid="PSA 118:12">परंतु काँटों में लगी आग के समान वे बुझ गए;</para>
  <para style="q1" vid="PSA 118:12">मैं उन्हें यहोवा के नाम से निश्‍चय नष्‍ट कर डालूँगा।<verse eid="PSA 118:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />तूने तो मुझे गिराने के लिए बड़ा धक्‍‍का दिया था,</para>
  <para style="q2" vid="PSA 118:13">परंतु यहोवा ने मेरी सहायता की।<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />याह मेरा बल और मेरा गीत है,</para>
  <para style="q2" vid="PSA 118:14">वह मेरा उद्धार भी ठहरा है।<verse eid="PSA 118:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />धर्मियों के तंबुओं में जय जयकार</para>
  <para style="q2" vid="PSA 118:15">और विजय<note caller="+" style="f"><char style="fr" closed="false">118:15 </char><char style="ft" closed="false">या उद्धार</char></note> की ध्वनि हो रही है;</para>
  <para style="q1" vid="PSA 118:15">यहोवा का दाहिना हाथ सामर्थ्य का कार्य करता है।<verse eid="PSA 118:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16" />यहोवा का दाहिना हाथ महान ठहरा है;</para>
  <para style="q2" vid="PSA 118:16">यहोवा का दाहिना हाथ सामर्थ्य का कार्य करता है।<verse eid="PSA 118:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />मैं नहीं मरूँगा बल्कि जीवित रहूँगा,</para>
  <para style="q2" vid="PSA 118:17">और याह के कार्यों का वर्णन करता रहूँगा।<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />याह ने मेरी कड़ी ताड़ना तो की,</para>
  <para style="q2" vid="PSA 118:18">परंतु मुझे मृत्यु के वश में नहीं किया।<verse eid="PSA 118:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />मेरे लिए धार्मिकता के द्वार खोलो;</para>
  <para style="q2" vid="PSA 118:19">मैं उनसे प्रवेश करके याह का धन्यवाद करूँगा।<verse eid="PSA 118:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />यहोवा का द्वार यही है;</para>
  <para style="q2" vid="PSA 118:20">धर्मी इससे प्रवेश करेंगे।<verse eid="PSA 118:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />हे यहोवा, मैं तेरा धन्यवाद करूँगा,</para>
  <para style="q2" vid="PSA 118:21">क्योंकि तूने मुझे उत्तर दिया है,</para>
  <para style="q1" vid="PSA 118:21">और तू मेरा उद्धार ठहरा है।<verse eid="PSA 118:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />जिस पत्थर को राजमिस्‍त्रियों ने ठुकरा दिया था,</para>
  <para style="q2" vid="PSA 118:22">वही कोने का प्रमुख पत्थर बन गया।<verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />यह तो यहोवा की ओर से हुआ है,</para>
  <para style="q2" vid="PSA 118:23">और यह हमारी दृष्‍टि में अद्भुत है।<verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />आज का दिन यहोवा ने बनाया है;</para>
  <para style="q2" vid="PSA 118:24">हम इसमें मगन और आनंदित हों।<verse eid="PSA 118:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />हे यहोवा, विनती सुन, बचा ले!</para>
  <para style="q2" vid="PSA 118:25">हे यहोवा, विनती सुन, सफलता दे!<verse eid="PSA 118:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />धन्य है वह जो यहोवा के नाम से आता है।</para>
  <para style="q2" vid="PSA 118:26">हम तुम्हें यहोवा के घर से आशिष देते हैं।<verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />यहोवा तो परमेश्‍वर है,</para>
  <para style="q2" vid="PSA 118:27">उसने हमें प्रकाश दिया है।</para>
  <para style="q1" vid="PSA 118:27">बलि-पशु को वेदी के सींगों से रस्सियों से बाँधो।<verse eid="PSA 118:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />हे यहोवा, तू मेरा परमेश्‍वर है,</para>
  <para style="q2" vid="PSA 118:28">मैं तेरा धन्यवाद करूँगा;</para>
  <para style="q1" vid="PSA 118:28">हे मेरे परमेश्‍वर, मैं तेरा गुणगान करूँगा।<verse eid="PSA 118:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />यहोवा का धन्यवाद करो</para>
  <para style="q2" vid="PSA 118:29">क्योंकि वह भला है,</para>
  <para style="q1" vid="PSA 118:29">और उसकी करुणा सदा की है!<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s1">परमेश्‍वर की व्यवस्था में आनंद</para>
  <para style="b" />
  <para style="s1">आलेफ</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />क्या ही धन्य हैं वे</para>
  <para style="q2" vid="PSA 119:1">जो चाल के खरे हैं,</para>
  <para style="q1" vid="PSA 119:1">और यहोवा की व्यवस्था पर चलते हैं।<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />क्या ही धन्य हैं वे</para>
  <para style="q2" vid="PSA 119:2">जो उसकी नीतियों को मानते हैं,</para>
  <para style="q1" vid="PSA 119:2">और संपूर्ण मन से उसे खोजते हैं।<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />वे कुटिल कार्य नहीं करते,</para>
  <para style="q2" vid="PSA 119:3">बल्कि उसके मार्गों पर चलते हैं।<verse eid="PSA 119:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />तूने अपने उपदेश इसलिए दिए हैं</para>
  <para style="q2" vid="PSA 119:4">कि उनका पालन यत्‍न से किया जाए।<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />भला हो कि तेरी विधियों को मानने</para>
  <para style="q2" vid="PSA 119:5">के लिए मेरा चाल-चलन दृढ़ हो जाए।<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />यदि मैं तेरी सब आज्ञाओं पर ध्यान करूँगा</para>
  <para style="q2" vid="PSA 119:6">तो मैं लज्‍जित न होऊँगा।<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />जब मैं तेरे धर्ममय नियमों को सीखूँगा,</para>
  <para style="q2" vid="PSA 119:7">तब निष्कपट मन से तेरा धन्यवाद करूँगा।<verse eid="PSA 119:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8" />मैं तेरी विधियों को मानूँगा;</para>
  <para style="q2" vid="PSA 119:8">मुझे पूरी तरह से त्याग न दे।<verse eid="PSA 119:8" /></para>
  <para style="s1">बेथ</para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9" />जवान अपनी चाल को कैसे शुद्ध रखे?</para>
  <para style="q2" vid="PSA 119:9">तेरे वचन का पालन करके।<verse eid="PSA 119:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10" />मैंने तुझे संपूर्ण मन से खोजा है;</para>
  <para style="q2" vid="PSA 119:10">अपनी आज्ञाओं से तू मुझे भटकने न दे।<verse eid="PSA 119:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11" />मैंने तेरे वचन को अपने हृदय में संजोए रखा है</para>
  <para style="q2" vid="PSA 119:11">कि तेरे विरुद्ध पाप न करूँ।<verse eid="PSA 119:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12" />हे यहोवा, तू धन्य है;</para>
  <para style="q2" vid="PSA 119:12">मुझे अपनी विधियाँ सिखा।<verse eid="PSA 119:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13" />तेरे कहे हुए सब नियमों का वर्णन</para>
  <para style="q2" vid="PSA 119:13">मैंने अपने होंठों से किया है।<verse eid="PSA 119:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14" />मैं तेरी नीतियों के मार्ग से ऐसा हर्षित हुआ हूँ</para>
  <para style="q2" vid="PSA 119:14">जैसा सब प्रकार के धन से।<verse eid="PSA 119:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15" />मैं तेरे उपदेशों पर ध्यान करूँगा,</para>
  <para style="q2" vid="PSA 119:15">और तेरे मार्गों की ओर दृष्‍टि लगाए रहूँगा।<verse eid="PSA 119:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16" />मैं तेरी विधियों से आनंदित होऊँगा;</para>
  <para style="q2" vid="PSA 119:16">और तेरे वचन को न भूलूँगा।<verse eid="PSA 119:16" /></para>
  <para style="s1">गिमेल</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17" />अपने दास पर उपकार कर</para>
  <para style="q2" vid="PSA 119:17">कि मैं जीवित रहूँ</para>
  <para style="q1" vid="PSA 119:17">और तेरे वचन पर चलूँ।<verse eid="PSA 119:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18" />मेरी आँखें खोल दे</para>
  <para style="q2" vid="PSA 119:18">कि मैं तेरी व्यवस्था की अद्भुत बातों को देख सकूँ।<verse eid="PSA 119:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19" />मैं पृथ्वी पर परदेशी हूँ;</para>
  <para style="q2" vid="PSA 119:19">अपनी आज्ञाओं को मुझसे न छिपा।<verse eid="PSA 119:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20" />मेरा मन तेरे नियमों के लिए</para>
  <para style="q2" vid="PSA 119:20">हर समय तरसता रहता है।<verse eid="PSA 119:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21" />तू शापित अभिमानियों को झिड़कता है,</para>
  <para style="q2" vid="PSA 119:21">वे तेरी आज्ञाओं से भटके हुए हैं।<verse eid="PSA 119:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22" />निंदा और अपमान को मुझसे दूर कर,</para>
  <para style="q2" vid="PSA 119:22">क्योंकि मैंने तेरी नीतियों को माना है।<verse eid="PSA 119:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23" />यद्यपि अधिपति बैठकर मेरे विरुद्ध बातें करते हैं,</para>
  <para style="q2" vid="PSA 119:23">फिर भी तेरा दास</para>
  <para style="q1" vid="PSA 119:23">तेरी विधियों पर ध्यान करता है।<verse eid="PSA 119:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24" />तेरी नीतियाँ तो मेरा आनंद हैं;</para>
  <para style="q2" vid="PSA 119:24">वे मुझे उचित सलाह देती हैं।<verse eid="PSA 119:24" /></para>
  <para style="s1">दालेत</para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25" />मैं धूल में पड़ा हूँ;</para>
  <para style="q2" vid="PSA 119:25">तू अपने वचन के अनुसार मुझे जिला।<verse eid="PSA 119:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26" />मैंने अपने चाल-चलन का वर्णन तुझसे किया है,</para>
  <para style="q2" vid="PSA 119:26">और तूने मुझे उत्तर दिया है;</para>
  <para style="q1" vid="PSA 119:26">तू मुझे अपनी विधियाँ सिखा।<verse eid="PSA 119:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27" />मुझे अपने उपदेशों का मार्ग बता</para>
  <para style="q2" vid="PSA 119:27">कि मैं तेरे आश्‍चर्यकर्मों पर ध्यान करूँ।<verse eid="PSA 119:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28" />दुःख के कारण मेरा प्राण व्याकुल है,</para>
  <para style="q2" vid="PSA 119:28">अपने वचन के अनुसार मुझे संभाल।<verse eid="PSA 119:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29" />मुझे झूठ के मार्ग से दूर कर,</para>
  <para style="q2" vid="PSA 119:29">और कृपा करके अपनी व्यवस्था मुझे दे।<verse eid="PSA 119:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30" />मैंने सच्‍चाई का मार्ग चुन लिया है;</para>
  <para style="q2" vid="PSA 119:30">मैंने तेरे नियमों को अपने सामने रखा है।<verse eid="PSA 119:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31" />मैं तेरी नीतियों को थामे रहता हूँ;</para>
  <para style="q2" vid="PSA 119:31">हे यहोवा, मुझे लज्‍जित न होने दे।<verse eid="PSA 119:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32" />मैं तेरी आज्ञाओं के मार्ग में दौड़ता हूँ,</para>
  <para style="q2" vid="PSA 119:32">क्योंकि तू मेरा साहस बढ़ाता है।<verse eid="PSA 119:32" /></para>
  <para style="s1">हे</para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33" />हे यहोवा, मुझे अपनी विधियों का मार्ग बता,</para>
  <para style="q2" vid="PSA 119:33">और मैं अंत तक उस पर चलूँगा।<verse eid="PSA 119:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34" />मुझे समझ दे</para>
  <para style="q2" vid="PSA 119:34">कि मैं तेरी व्यवस्था का पालन करूँ</para>
  <para style="q1" vid="PSA 119:34">और संपूर्ण मन से उस पर चलूँ।<verse eid="PSA 119:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35" />अपनी आज्ञाओं के पथ में मुझे ले चल,</para>
  <para style="q2" vid="PSA 119:35">क्योंकि मैं उसी से प्रसन्‍न होता हूँ।<verse eid="PSA 119:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36" />मेरे मन को अनुचित लाभ की ओर नहीं,</para>
  <para style="q2" vid="PSA 119:36">बल्कि अपनी नीतियों की ओर फेर दे।<verse eid="PSA 119:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37" />मेरी आँखों को व्यर्थ वस्तुओं की ओर से फेर दे;</para>
  <para style="q2" vid="PSA 119:37">अपने मार्गों में मुझे जिला।<verse eid="PSA 119:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38" />अपने वचन को अपने दास के लिए पूरा कर</para>
  <para style="q2" vid="PSA 119:38">जिससे तेरा भय माना जाए।<verse eid="PSA 119:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39" />मेरी निंदा को जिससे मैं डरता हूँ,</para>
  <para style="q2" vid="PSA 119:39">दूर कर; क्योंकि तेरे नियम उत्तम हैं।<verse eid="PSA 119:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40" />देख, मैं तेरे उपदेशों का अभिलाषी हूँ;</para>
  <para style="q2" vid="PSA 119:40">अपनी धार्मिकता के द्वारा मुझे जिला।<verse eid="PSA 119:40" /></para>
  <para style="s1">वाव</para>
  <para style="b" />
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41" />हे यहोवा, तेरी करुणा,</para>
  <para style="q2" vid="PSA 119:41">और तेरे वचन<note caller="+" style="f"><char style="fr" closed="false">119:41 </char><char style="ft" closed="false">या तेरी प्रतिज्ञा</char></note> के अनुसार तेरा उद्धार मुझे मिले।<verse eid="PSA 119:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42" />तब मैं अपने निंदा करनेवाले को उत्तर दे सकूँगा,</para>
  <para style="q2" vid="PSA 119:42">क्योंकि मैं तेरे वचन पर भरोसा रखता हूँ।<verse eid="PSA 119:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43" />सत्य के वचन कहने से मुझे वंचित न कर,</para>
  <para style="q2" vid="PSA 119:43">क्योंकि मैं तेरे नियमों पर आशा रखता हूँ।<verse eid="PSA 119:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44" />तब मैं तेरी व्यवस्था पर निरंतर</para>
  <para style="q2" vid="PSA 119:44">और सदा-सर्वदा चलता रहूँगा।<verse eid="PSA 119:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45" />मैं चौड़े स्थान में चलूँगा,</para>
  <para style="q2" vid="PSA 119:45">क्योंकि मैं तेरे उपदेशों का खोजी हूँ।<verse eid="PSA 119:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46" />मैं तेरी नीतियों की चर्चा राजाओं के सामने करूँगा,</para>
  <para style="q2" vid="PSA 119:46">और लज्‍जित न होऊँगा।<verse eid="PSA 119:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47" />मैं तेरी आज्ञाओं में मगन रहूँगा,</para>
  <para style="q2" vid="PSA 119:47">क्योंकि मैं उनसे प्रीति रखता हूँ।<verse eid="PSA 119:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48" />मैं तेरी आज्ञाओं की ओर जिनसे मैं प्रीति रखता हूँ,</para>
  <para style="q2" vid="PSA 119:48">हाथ फैलाऊँगा, और तेरी विधियों पर ध्यान करूँगा।<verse eid="PSA 119:48" /></para>
  <para style="s1">ज़ाइन</para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49" />अपने दास को दिया वह वचन स्मरण कर,</para>
  <para style="q2" vid="PSA 119:49">जिसके द्वारा तूने मुझे आशा दी है।<verse eid="PSA 119:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50" />मेरे दुःख में मुझे शांति इसी से है</para>
  <para style="q2" vid="PSA 119:50">कि तेरे वचन ने मुझे जीवन दिया है।<verse eid="PSA 119:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51" />अभिमानियों ने मेरा बहुत ठट्ठा किया,</para>
  <para style="q2" vid="PSA 119:51">फिर भी मैं तेरी व्यवस्था से नहीं हटा।<verse eid="PSA 119:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52" />हे यहोवा, मैंने तेरे प्राचीन नियमों को</para>
  <para style="q2" vid="PSA 119:52">स्मरण करके शांति पाई है।<verse eid="PSA 119:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53" />जिन दुष्‍टों ने तेरी व्यवस्था को छोड़ दिया है,</para>
  <para style="q2" vid="PSA 119:53">उनके कारण मैं क्रोधाग्‍नि से जलता हूँ।<verse eid="PSA 119:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54" />मेरी जीवन-यात्रा के डेरे में</para>
  <para style="q2" vid="PSA 119:54">तेरी विधियाँ मेरे गीतों का विषय बनी हैं।<verse eid="PSA 119:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55" />हे यहोवा, मैं रात को तेरा नाम स्मरण करता हूँ,</para>
  <para style="q2" vid="PSA 119:55">और तेरी व्यवस्था पर चलता हूँ।<verse eid="PSA 119:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56" />मेरे साथ इसलिए ऐसा हुआ है</para>
  <para style="q2" vid="PSA 119:56">क्योंकि मैं तेरे उपदेशों को मानता हूँ।<verse eid="PSA 119:56" /></para>
  <para style="s1">ख़ेथ</para>
  <para style="b" />
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57" />यहोवा मेरा भाग है;</para>
  <para style="q2" vid="PSA 119:57">मैंने तेरे वचनों के अनुसार</para>
  <para style="q1" vid="PSA 119:57">चलने की प्रतिज्ञा की है।<verse eid="PSA 119:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58" />मैंने संपूर्ण मन से तुझसे विनती की है,</para>
  <para style="q2" vid="PSA 119:58">अपने वचन के अनुसार मुझ पर अनुग्रह कर।<verse eid="PSA 119:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59" />मैंने अपने चाल-चलन पर विचार किया,</para>
  <para style="q2" vid="PSA 119:59">और अपने कदम तेरी नीतियों की ओर मोड़े।<verse eid="PSA 119:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60" />मैंने तेरी आज्ञाओं को मानने में देर नहीं,</para>
  <para style="q2" vid="PSA 119:60">शीघ्रता की है।<verse eid="PSA 119:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61" />दुष्‍टों के बंधनों ने मुझे जकड़ लिया है,</para>
  <para style="q2" vid="PSA 119:61">फिर भी मैं तेरी व्यवस्था को नहीं भूला हूँ।<verse eid="PSA 119:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62" />तेरे धर्ममय नियमों के कारण मैं आधी रात को</para>
  <para style="q2" vid="PSA 119:62">तेरा धन्यवाद करने के लिए उठूँगा।<verse eid="PSA 119:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63" />मैं उन सब का साथी हूँ</para>
  <para style="q2" vid="PSA 119:63">जो तेरा भय मानते</para>
  <para style="q1" vid="PSA 119:63">और तेरे उपदेशों पर चलते हैं।<verse eid="PSA 119:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64" />हे यहोवा, पृथ्वी तेरी करुणा से भरी हुई है;</para>
  <para style="q2" vid="PSA 119:64">तू मुझे अपनी विधियाँ सिखा।<verse eid="PSA 119:64" /></para>
  <para style="s1">टेथ</para>
  <para style="b" />
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65" />हे यहोवा, तूने अपने वचन के अनुसार</para>
  <para style="q2" vid="PSA 119:65">अपने दास के साथ भलाई की है।<verse eid="PSA 119:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66" />मुझे अच्छी समझ और ज्ञान दे,</para>
  <para style="q2" vid="PSA 119:66">क्योंकि मैं तेरी आज्ञाओं पर विश्‍वास करता हूँ।<verse eid="PSA 119:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67" />दुःखित होने से पहले मैं भटकता था;</para>
  <para style="q2" vid="PSA 119:67">परंतु अब मैं तेरे वचन को मानता हूँ।<verse eid="PSA 119:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68" />तू भला है, और भला करता है;</para>
  <para style="q2" vid="PSA 119:68">मुझे अपनी विधियाँ सिखा।<verse eid="PSA 119:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69" />अभिमानियों ने तो मेरे विरुद्ध झूठी बात गढ़ी है,</para>
  <para style="q2" vid="PSA 119:69">परंतु मैं तेरे उपदेशों को संपूर्ण मन से मानूँगा।<verse eid="PSA 119:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70" />उनका मन मोटा हो गया है,</para>
  <para style="q2" vid="PSA 119:70">परंतु मैं तेरी व्यवस्था में मगन रहूँगा।<verse eid="PSA 119:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71" />मेरे लिए अच्छा ही था</para>
  <para style="q2" vid="PSA 119:71">कि मैंने दुःख सहा</para>
  <para style="q1" vid="PSA 119:71">ताकि तेरी विधियों को सीख सकूँ।<verse eid="PSA 119:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72" />तेरी दी हुई व्यवस्था<note caller="+" style="f"><char style="fr" closed="false">119:72 </char><char style="ft" closed="false">अक्षरशः तेरे मुँह की व्यवस्था</char></note> मेरे लिए सोने</para>
  <para style="q2" vid="PSA 119:72">और चाँदी के हज़ारों सिक्‍‍कों से भी उत्तम है।<verse eid="PSA 119:72" /></para>
  <para style="s1">योध</para>
  <para style="b" />
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73" />तेरे हाथों ने मुझे रचा है,</para>
  <para style="q2" vid="PSA 119:73">और वे मुझे थामे रखते हैं;</para>
  <para style="q1" vid="PSA 119:73">मुझे समझ दे कि मैं तेरी आज्ञाओं को सीखूँ।<verse eid="PSA 119:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74" />तेरा भय माननेवाले मुझे देखकर आनंदित होंगे,</para>
  <para style="q2" vid="PSA 119:74">क्योंकि मैंने तेरे वचन पर आशा लगाई है।<verse eid="PSA 119:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75" />हे यहोवा, मैं जानता हूँ</para>
  <para style="q2" vid="PSA 119:75">कि तेरे नियम धर्ममय हैं,</para>
  <para style="q1" vid="PSA 119:75">और तूने अपनी सच्‍चाई के अनुसार मुझे दुःख दिया है।<verse eid="PSA 119:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76" />मुझे अपनी करुणा से शांति दे,</para>
  <para style="q2" vid="PSA 119:76">क्योंकि तूने अपने दास को ऐसा ही वचन दिया है।<verse eid="PSA 119:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77" />तेरी दया मुझ पर हो</para>
  <para style="q2" vid="PSA 119:77">कि मैं जीवित रहूँ,</para>
  <para style="q1" vid="PSA 119:77">क्योंकि मैं तेरी व्यवस्था से आनंदित हूँ।<verse eid="PSA 119:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78" />अभिमानी लज्‍जित हों,</para>
  <para style="q2" vid="PSA 119:78">क्योंकि वे झूठ के द्वारा मुझे हानि पहुँचाते हैं;</para>
  <para style="q1" vid="PSA 119:78">परंतु मैं तेरे उपदेशों पर ध्यान करूँगा।<verse eid="PSA 119:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79" />जो तेरा भय मानते हैं</para>
  <para style="q2" vid="PSA 119:79">अर्थात् जो तेरी नीतियों को जानते हैं,</para>
  <para style="q1" vid="PSA 119:79">वे मेरे पास आएँ।<verse eid="PSA 119:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80" />मेरा मन तेरी विधियों को मानने में निर्दोष ठहरे,</para>
  <para style="q2" vid="PSA 119:80">ऐसा न हो कि मुझे लज्‍जित होना पड़े।<verse eid="PSA 119:80" /></para>
  <para style="s1">काफ़</para>
  <para style="b" />
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81" />मेरा प्राण तेरे उद्धार के लिए व्याकुल है;</para>
  <para style="q2" vid="PSA 119:81">मैंने तेरे वचन पर आशा लगाई है।<verse eid="PSA 119:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82" />मेरी आँखें तेरे वचन के</para>
  <para style="q2" vid="PSA 119:82">पूरे होने की प्रतीक्षा करते-करते धुँधला गई हैं;</para>
  <para style="q1" vid="PSA 119:82">मैं कहता हूँ,</para>
  <para style="q2" vid="PSA 119:82">“तू मुझे कब शांति देगा?”<verse eid="PSA 119:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83" />यद्यपि मैं धुएँ में रखी मशक के समान हो गया हूँ,</para>
  <para style="q2" vid="PSA 119:83">फिर भी तेरी विधियों को नहीं भूला हूँ।<verse eid="PSA 119:83" /></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84" />तेरे दास के कितने दिन रह गए हैं?</para>
  <para style="q2" vid="PSA 119:84">तू मेरे सतानेवालों को कब दंड देगा?<verse eid="PSA 119:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85" />अभिमानी जो तेरी व्यवस्था के अनुसार नहीं चलते,</para>
  <para style="q2" vid="PSA 119:85">उन्होंने मेरे लिए गड्‌ढे खोदे हैं।<verse eid="PSA 119:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86" />तेरी सब आज्ञाएँ विश्‍वासयोग्य हैं;</para>
  <para style="q2" vid="PSA 119:86">लोगों ने झूठ बोल बोलकर मुझे सताया है,</para>
  <para style="q1" vid="PSA 119:86">मेरी सहायता कर।<verse eid="PSA 119:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87" />वे तो मुझे पृथ्वी पर से</para>
  <para style="q2" vid="PSA 119:87">मिटा डालने पर ही थे,</para>
  <para style="q1" vid="PSA 119:87">परंतु मैंने तेरे उपदेशों को नहीं त्यागा।<verse eid="PSA 119:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88" />मुझे अपनी करुणा के अनुसार फिर से जिला</para>
  <para style="q2" vid="PSA 119:88">कि मैं तेरे दिए हुए नियम को मानूँ।<verse eid="PSA 119:88" /></para>
  <para style="s1">लामेध</para>
  <para style="b" />
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89" />हे यहोवा, तेरा वचन आकाश में सदा तक स्थिर है।<verse eid="PSA 119:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90" />तेरी सच्‍चाई पीढ़ी से पीढ़ी तक बनी रहती है;</para>
  <para style="q2" vid="PSA 119:90">तूने पृथ्वी को स्थापित किया,</para>
  <para style="q1" vid="PSA 119:90">और वह बनी हुई है।<verse eid="PSA 119:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91" />सब कुछ तेरे नियमों के अनुसार आज तक बना हुआ है;</para>
  <para style="q2" vid="PSA 119:91">क्योंकि वे तेरे अधीन हैं।<verse eid="PSA 119:91" /></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92" />यदि तेरी व्यवस्था से मैं आनंदित न होता,</para>
  <para style="q2" vid="PSA 119:92">तो अपने दुःख में नष्‍ट हो जाता।<verse eid="PSA 119:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93" />मैं तेरे उपदेशों को कभी न भूलूँगा;</para>
  <para style="q2" vid="PSA 119:93">क्योंकि तूने उन्हीं के द्वारा मुझे जीवन दिया है।<verse eid="PSA 119:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94" />मैं तेरा हूँ, मुझे बचा,</para>
  <para style="q2" vid="PSA 119:94">क्योंकि मैं तेरे उपदेशों का खोजी हूँ।<verse eid="PSA 119:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95" />दुष्‍ट मेरा नाश करने की ताक में हैं;</para>
  <para style="q2" vid="PSA 119:95">परंतु मैं तेरी नीतियों पर ध्यान करता हूँ।<verse eid="PSA 119:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96" />मैंने तो हर सिद्ध वस्तु की एक सीमा देखी है,</para>
  <para style="q2" vid="PSA 119:96">परंतु तेरी आज्ञा तो असीम है।<verse eid="PSA 119:96" /></para>
  <para style="s1">मेम</para>
  <para style="b" />
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97" />आहा, मैं तेरी व्यवस्था से कैसी प्रीति रखता हूँ!</para>
  <para style="q2" vid="PSA 119:97">मेरा ध्यान दिन भर उसी पर लगा रहता है।<verse eid="PSA 119:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98" />तेरी आज्ञाएँ मुझे अपने शत्रुओं से अधिक बुद्धिमान बनाती हैं,</para>
  <para style="q2" vid="PSA 119:98">क्योंकि वे सदा मेरे साथ रहती हैं।<verse eid="PSA 119:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99" />मैं अपने सब शिक्षकों से भी अधिक समझ रखता हूँ,</para>
  <para style="q2" vid="PSA 119:99">क्योंकि मेरा ध्यान तेरी नीतियों पर लगा रहता है।<verse eid="PSA 119:99" /></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100" />मैं वृद्धों से भी अधिक समझदार हूँ,</para>
  <para style="q2" vid="PSA 119:100">क्योंकि मैं तेरे उपदेशों को मानता हूँ।<verse eid="PSA 119:100" /></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101" />मैंने अपने पैरों को प्रत्येक बुरे मार्ग से रोक रखा है,</para>
  <para style="q2" vid="PSA 119:101">जिससे मैं तेरे वचन पर चलूँ।<verse eid="PSA 119:101" /></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102" />मैं तेरे नियमों से नहीं हटा,</para>
  <para style="q2" vid="PSA 119:102">क्योंकि तूने मुझे शिक्षा दी है।<verse eid="PSA 119:102" /></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103" />तेरे वचन मुझे बहुत मीठे लगते हैं;</para>
  <para style="q2" vid="PSA 119:103">वे मेरे मुँह में मधु से भी मीठे हैं।<verse eid="PSA 119:103" /></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104" />तेरे उपदेशों से मुझे समझ प्राप्‍त होती है;</para>
  <para style="q2" vid="PSA 119:104">इसलिए मैं प्रत्येक झूठे मार्ग से घृणा करता हूँ।<verse eid="PSA 119:104" /></para>
  <para style="s1">नून</para>
  <para style="b" />
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105" />तेरा वचन मेरे पैरों के लिए दीपक,</para>
  <para style="q2" vid="PSA 119:105">और मेरे पथ के लिए उजियाला है।<verse eid="PSA 119:105" /></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106" />मैंने शपथ खाई है,</para>
  <para style="q2" vid="PSA 119:106">और ठान लिया है</para>
  <para style="q1" vid="PSA 119:106">कि मैं तेरे धर्ममय नियमों के अनुसार चलूँगा।<verse eid="PSA 119:106" /></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107" />मैं बहुत पीड़ित हूँ; हे यहोवा,</para>
  <para style="q2" vid="PSA 119:107">अपने वचन के अनुसार मुझे जिला।<verse eid="PSA 119:107" /></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108" />हे यहोवा, मेरे मुँह के स्तुति रूपी बलिदानों को ग्रहण कर,</para>
  <para style="q2" vid="PSA 119:108">और मुझे अपने नियम सिखा।<verse eid="PSA 119:108" /></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109" />मेरा प्राण निरंतर मेरी हथेली पर रहता है,</para>
  <para style="q2" vid="PSA 119:109">फिर भी मैं तेरी व्यवस्था को नहीं भूलता।<verse eid="PSA 119:109" /></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110" />दुष्‍टों ने तो मेरे लिए जाल बिछाया है,</para>
  <para style="q2" vid="PSA 119:110">फिर भी मैं तेरे उपदेशों से नहीं भटका।<verse eid="PSA 119:110" /></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111" />मैंने तेरी नीतियों को सदा के लिए</para>
  <para style="q2" vid="PSA 119:111">अपना निज भाग बना लिया है,</para>
  <para style="q1" vid="PSA 119:111">क्योंकि वे मेरे हृदय के हर्ष का कारण हैं।<verse eid="PSA 119:111" /></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112" />मैंने अपने मन को इस बात पर लगाया है</para>
  <para style="q2" vid="PSA 119:112">कि अंत तक तेरी विधियों पर चलता रहूँ।<verse eid="PSA 119:112" /></para>
  <para style="s1">सामेख़</para>
  <para style="b" />
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113" />मैं दुचित्तों से तो बैर रखता हूँ,</para>
  <para style="q2" vid="PSA 119:113">परंतु तेरी व्यवस्था से प्रीति रखता हूँ।<verse eid="PSA 119:113" /></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114" />तू मेरा शरणस्थान और मेरी ढाल है;</para>
  <para style="q2" vid="PSA 119:114">मैंने तेरे वचन पर आशा लगाई है।<verse eid="PSA 119:114" /></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115" />हे कुकर्मियो, मुझसे दूर हो जाओ</para>
  <para style="q2" vid="PSA 119:115">कि मैं अपने परमेश्‍वर की आज्ञाओं को थामे रहूँ।<verse eid="PSA 119:115" /></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116" />हे यहोवा, अपने वचन के अनुसार मुझे संभाल</para>
  <para style="q2" vid="PSA 119:116">कि मैं जीवित रहूँ;</para>
  <para style="q1" vid="PSA 119:116">और मेरी आशा के कारण मुझे लज्‍जित न होने दे।<verse eid="PSA 119:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117" />मुझे संभाल कि मैं सुरक्षित रहूँ</para>
  <para style="q2" vid="PSA 119:117">और निरंतर तेरी विधियों पर चित्त लगाए रहूँ।<verse eid="PSA 119:117" /></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118" />जितने तेरी विधियों के मार्ग से भटक जाते हैं,</para>
  <para style="q2" vid="PSA 119:118">उन सब को तू तुच्छ जानता है,</para>
  <para style="q1" vid="PSA 119:118">क्योंकि उनका छल व्यर्थ है।<verse eid="PSA 119:118" /></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119" />तूने पृथ्वी के सब</para>
  <para style="q2" vid="PSA 119:119">दुष्‍टों को मैल के समान निकाल दिया है;</para>
  <para style="q1" vid="PSA 119:119">इस कारण मैं तेरी नीतियों से प्रीति रखता हूँ।<verse eid="PSA 119:119" /></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120" />तेरे भय से मेरा शरीर काँप उठता है,</para>
  <para style="q2" vid="PSA 119:120">और मैं तेरे नियमों से डरता हूँ।<verse eid="PSA 119:120" /></para>
  <para style="s1">आइन</para>
  <para style="b" />
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121" />मैंने तो न्याय और धार्मिकता से कार्य किया है;</para>
  <para style="q2" vid="PSA 119:121">तू मुझे अंधेर करनेवालों के हाथ में न छोड़।<verse eid="PSA 119:121" /></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122" />अपने दास की भलाई को सुनिश्‍चित कर;</para>
  <para style="q2" vid="PSA 119:122">अभिमानी मुझ पर अंधेर न कर पाएँ।<verse eid="PSA 119:122" /></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123" />मेरी आँखें तेरे उद्धार</para>
  <para style="q2" vid="PSA 119:123">और तेरे धर्ममय वचन की</para>
  <para style="q1" vid="PSA 119:123">प्रतीक्षा करते-करते धुँधला गई हैं।<verse eid="PSA 119:123" /></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124" />अपने दास के साथ अपनी करुणा के अनुसार व्यवहार कर,</para>
  <para style="q2" vid="PSA 119:124">और अपनी विधियाँ मुझे सिखा।<verse eid="PSA 119:124" /></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125" />मैं तेरा दास हूँ,</para>
  <para style="q2" vid="PSA 119:125">तू मुझे समझ दे</para>
  <para style="q1" vid="PSA 119:125">कि मैं तेरी नीतियों को समझूँ।<verse eid="PSA 119:125" /></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126" />यह समय है कि यहोवा कार्य करे,</para>
  <para style="q2" vid="PSA 119:126">क्योंकि लोगों ने तेरी व्यवस्था का उल्‍लंघन किया है।<verse eid="PSA 119:126" /></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127" />मेरे लिए तो तेरी आज्ञाएँ सोने से,</para>
  <para style="q2" vid="PSA 119:127">बल्कि कुंदन से भी अधिक प्रिय हैं।<verse eid="PSA 119:127" /></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128" />इसलिए मैं तेरे सब उपदेशों को हर विषय में ठीक मानता हूँ,</para>
  <para style="q2" vid="PSA 119:128">और प्रत्येक झूठे मार्ग से घृणा करता हूँ।<verse eid="PSA 119:128" /></para>
  <para style="s1">पे</para>
  <para style="b" />
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129" />तेरी नीतियाँ अद्भुत हैं;</para>
  <para style="q2" vid="PSA 119:129">इसलिए मैं उन्हें मानता हूँ।<verse eid="PSA 119:129" /></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130" />तेरे वचनों के खुलने से प्रकाश मिलता है,</para>
  <para style="q2" vid="PSA 119:130">जिससे भोले लोग समझ प्राप्‍त करते हैं।<verse eid="PSA 119:130" /></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131" />मैं मुँह खोलकर हाँफता हूँ,</para>
  <para style="q2" vid="PSA 119:131">क्योंकि मैं तेरी आज्ञाओं का अभिलाषी हूँ।<verse eid="PSA 119:131" /></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132" />मेरी ओर फिरकर मुझ पर अनुग्रह कर,</para>
  <para style="q2" vid="PSA 119:132">जैसा कि तू अपने नाम से प्रेम रखनेवालों के साथ करता है।<verse eid="PSA 119:132" /></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133" />मेरे कदमों को अपने वचन पर दृढ़ कर,</para>
  <para style="q2" vid="PSA 119:133">और किसी अधर्म को मुझ पर प्रबल होने न दे।<verse eid="PSA 119:133" /></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134" />मुझे मनुष्य के अंधेर से छुड़ा ले</para>
  <para style="q2" vid="PSA 119:134">कि मैं तेरे उपदेशों को मानूँ।<verse eid="PSA 119:134" /></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135" />अपने दास पर अपने मुख का प्रकाश चमका,</para>
  <para style="q2" vid="PSA 119:135">और अपनी विधियाँ मुझे सिखा।<verse eid="PSA 119:135" /></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136" />मेरी आँखों से जल की धाराएँ बहती रहती हैं,</para>
  <para style="q2" vid="PSA 119:136">क्योंकि लोग तेरी व्यवस्था को नहीं मानते।<verse eid="PSA 119:136" /></para>
  <para style="s1">सादे</para>
  <para style="b" />
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137" />हे यहोवा, तू धर्मी है,</para>
  <para style="q2" vid="PSA 119:137">और तेरे नियम खरे हैं।<verse eid="PSA 119:137" /></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138" />तूने अपनी नीतियों को धार्मिकता</para>
  <para style="q2" vid="PSA 119:138">और पूरी विश्‍वासयोग्यता से स्थापित किया है।<verse eid="PSA 119:138" /></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139" />मेरी धुन मुझे खाए जा रही है,</para>
  <para style="q2" vid="PSA 119:139">क्योंकि मेरे शत्रु तेरे वचनों को भूल गए हैं।<verse eid="PSA 119:139" /></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140" />तेरा वचन पूरी तरह से ताया हुआ है,</para>
  <para style="q2" vid="PSA 119:140">इसलिए तेरा दास उससे प्रीति रखता है।<verse eid="PSA 119:140" /></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141" />मैं छोटा और तुच्छ हूँ,</para>
  <para style="q2" vid="PSA 119:141">फिर भी मैं तेरे उपदेशों को नहीं भूलता।<verse eid="PSA 119:141" /></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142" />तेरी धार्मिकता तो सदा की है,</para>
  <para style="q2" vid="PSA 119:142">और तेरी व्यवस्था सच्‍ची है।<verse eid="PSA 119:142" /></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143" />संकट और क्लेश मुझ पर आ पड़े हैं,</para>
  <para style="q2" vid="PSA 119:143">फिर भी मैं तेरी आज्ञाओं से आनंदित हूँ।<verse eid="PSA 119:143" /></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144" />तेरी नीतियाँ सदा के लिए धर्ममय हैं;</para>
  <para style="q2" vid="PSA 119:144">तू मुझे समझ दे कि मैं जीवित रहूँ।<verse eid="PSA 119:144" /></para>
  <para style="s1">कोफ़</para>
  <para style="b" />
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145" />मैंने संपूर्ण मन से तुझे पुकारा है;</para>
  <para style="q2" vid="PSA 119:145">हे यहोवा, मुझे उत्तर दे।</para>
  <para style="q1" vid="PSA 119:145">मैं तेरी विधियों को थामे रहूँगा।<verse eid="PSA 119:145" /></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146" />मैंने तुझे पुकारा है;</para>
  <para style="q2" vid="PSA 119:146">तू मुझे बचा ले,</para>
  <para style="q1" vid="PSA 119:146">और मैं तेरी नीतियों को मानूँगा।<verse eid="PSA 119:146" /></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147" />मैं भोर होने से पहले ही उठ जाता हूँ</para>
  <para style="q2" vid="PSA 119:147">और सहायता के लिए तुझे पुकारता हूँ;</para>
  <para style="q1" vid="PSA 119:147">मैं तेरे वचन पर आशा रखता हूँ।<verse eid="PSA 119:147" /></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148" />मेरी आँखें रात के हर एक पहर खुली रहती हैं</para>
  <para style="q2" vid="PSA 119:148">कि मैं तेरे वचन पर ध्यान करूँ।<verse eid="PSA 119:148" /></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149" />अपनी करुणा के अनुसार मेरी पुकार सुन;</para>
  <para style="q2" vid="PSA 119:149">हे यहोवा, अपने नियमों के अनुसार मुझे जिला।<verse eid="PSA 119:149" /></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150" />दुष्‍टता में लिप्‍त रहनेवाले मेरे निकट आ गए हैं;</para>
  <para style="q2" vid="PSA 119:150">वे तो तेरी व्यवस्था से दूर हैं।<verse eid="PSA 119:150" /></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151" />हे यहोवा, तू निकट है,</para>
  <para style="q2" vid="PSA 119:151">और तेरी सब आज्ञाएँ सच्‍ची हैं।<verse eid="PSA 119:151" /></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152" />मैं तेरी नीतियों के द्वारा बहुत पहले से जान गया हूँ</para>
  <para style="q2" vid="PSA 119:152">कि तूने उन्हें सदा के लिए स्थापित किया है।<verse eid="PSA 119:152" /></para>
  <para style="s1">रेश</para>
  <para style="b" />
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153" />मेरे दुःख को देख और मुझे छुड़ा ले,</para>
  <para style="q2" vid="PSA 119:153">क्योंकि मैं तेरी व्यवस्था को भूला नहीं हूँ।<verse eid="PSA 119:153" /></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154" />मेरा मुकदमा लड़ और मुझे छुड़ा ले;</para>
  <para style="q2" vid="PSA 119:154">अपने वचन के अनुसार मुझे जिला।<verse eid="PSA 119:154" /></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155" />उद्धार तो दुष्‍टों की पहुँच से दूर है,</para>
  <para style="q2" vid="PSA 119:155">क्योंकि वे तेरी विधियों को नहीं खोजते।<verse eid="PSA 119:155" /></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156" />हे यहोवा, तेरी दया तो अपार है;</para>
  <para style="q2" vid="PSA 119:156">अपने नियमों के अनुसार मुझे जिला।<verse eid="PSA 119:156" /></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157" />मेरे सतानेवाले और मेरे विरोधी तो बहुत हैं,</para>
  <para style="q2" vid="PSA 119:157">फिर भी मैं तेरी नीतियों से विमुख नहीं होता।<verse eid="PSA 119:157" /></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158" />विश्‍वासघातियों को देखकर मैं दुःखी हुआ,</para>
  <para style="q2" vid="PSA 119:158">क्योंकि वे तेरे वचन को नहीं मानते।<verse eid="PSA 119:158" /></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159" />देख, मैं तेरे उपदेशों से कैसी प्रीति रखता हूँ!</para>
  <para style="q2" vid="PSA 119:159">हे यहोवा, अपनी करुणा के अनुसार मुझे जिला।<verse eid="PSA 119:159" /></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160" />तेरा संपूर्ण वचन सत्य है,</para>
  <para style="q2" vid="PSA 119:160">और तेरा हर एक धर्ममय नियम सदाकाल तक अटल है।<verse eid="PSA 119:160" /></para>
  <para style="s1">शिन</para>
  <para style="b" />
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161" />प्रधान अकारण ही मुझे सताते हैं,</para>
  <para style="q2" vid="PSA 119:161">परंतु मेरा हृदय तेरे वचनों का भय मानता है।<verse eid="PSA 119:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162" />जैसे कोई बड़ी धन-संपत्ति पाकर हर्षित होता है,</para>
  <para style="q2" vid="PSA 119:162">वैसे ही मैं तेरे वचन के कारण हर्षित हूँ।<verse eid="PSA 119:162" /></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163" />झूठ से तो मैं बैर और घृणा करता हूँ,</para>
  <para style="q2" vid="PSA 119:163">परंतु तेरी व्यवस्था से प्रीति रखता हूँ।<verse eid="PSA 119:163" /></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164" />तेरे धर्ममय नियमों के कारण,</para>
  <para style="q2" vid="PSA 119:164">मैं दिन में सात बार तेरी स्तुति करता हूँ।<verse eid="PSA 119:164" /></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165" />तेरी व्यवस्था से प्रीति रखनेवालों को बड़ी शांति मिलती है,</para>
  <para style="q2" vid="PSA 119:165">और उन्हें किसी बात से ठोकर नहीं लगती।<verse eid="PSA 119:165" /></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166" />हे यहोवा, मैं तुझसे उद्धार पाने की आस लगाए हूँ,</para>
  <para style="q2" vid="PSA 119:166">और मैं तेरी आज्ञाओं को मानता आया हूँ।<verse eid="PSA 119:166" /></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167" />मैं तेरी नीतियों को मानता हूँ,</para>
  <para style="q2" vid="PSA 119:167">और उनसे बहुत प्रीति रखता हूँ।<verse eid="PSA 119:167" /></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168" />मैं तेरे उपदेशों और नीतियों को मानता हूँ;</para>
  <para style="q2" vid="PSA 119:168">मेरा सारा चाल-चलन तो तेरे सामने प्रकट है।<verse eid="PSA 119:168" /></para>
  <para style="s1">ताव</para>
  <para style="b" />
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169" />हे यहोवा, मेरी पुकार तुझ तक पहुँचे;</para>
  <para style="q2" vid="PSA 119:169">तू अपने वचन के अनुसार मुझे समझ दे।<verse eid="PSA 119:169" /></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170" />मेरी विनती तेरे सम्मुख पहुँचे;</para>
  <para style="q2" vid="PSA 119:170">अपने वचन के अनुसार मुझे छुड़ा।<verse eid="PSA 119:170" /></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171" />मेरे होंठ तेरी स्तुति करें,</para>
  <para style="q2" vid="PSA 119:171">क्योंकि तू मुझे अपनी विधियाँ सिखाता है।<verse eid="PSA 119:171" /></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172" />मेरी जीभ तेरे वचन का गीत गाए,</para>
  <para style="q2" vid="PSA 119:172">क्योंकि तेरी सब आज्ञाएँ धर्ममय हैं।<verse eid="PSA 119:172" /></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173" />तेरा हाथ मेरी सहायता करे,</para>
  <para style="q2" vid="PSA 119:173">क्योंकि मैंने तेरे उपदेशों पर चलने का निर्णय लिया है।<verse eid="PSA 119:173" /></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174" />हे यहोवा, मैं तेरे उद्धार का अभिलाषी हूँ,</para>
  <para style="q2" vid="PSA 119:174">और तेरी व्यवस्था मेरा आनंद है।<verse eid="PSA 119:174" /></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175" />मुझे जीवन दे कि मैं तेरी स्तुति करता रहूँ;</para>
  <para style="q2" vid="PSA 119:175">तेरे नियम मेरी सहायता करें।<verse eid="PSA 119:175" /></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176" />मैं खोई हुई भेड़ के समान भटक गया हूँ;</para>
  <para style="q2" vid="PSA 119:176">अपने दास को ढूँढ़,</para>
  <para style="q1" vid="PSA 119:176">क्योंकि मैं तेरी आज्ञाओं को भूला नहीं हूँ।<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s1">सत्य और शांति के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">यात्रा का गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />मैंने संकट के समय यहोवा को पुकारा,</para>
  <para style="q2" vid="PSA 120:1">और उसने मुझे उत्तर दिया।<verse eid="PSA 120:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />हे यहोवा, झूठ बोलनेवाले मुँह से</para>
  <para style="q2" vid="PSA 120:2">और छली जीभ से मेरी रक्षा कर।<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />हे छली जीभ, तुझे क्या दिया जाए,</para>
  <para style="q2" vid="PSA 120:3">तथा तेरे साथ</para>
  <para style="q1" vid="PSA 120:3">और अधिक क्या किया जाए?<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />वह वीर के नुकीले तीरों</para>
  <para style="q2" vid="PSA 120:4">और झाऊ वृक्ष के अंगारों से तुझे दंड देगा।<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />मुझ पर हाय!</para>
  <para style="q2" vid="PSA 120:5">क्योंकि मैं मेशेक में परदेशी होकर रहा</para>
  <para style="q1" vid="PSA 120:5">और केदार के तंबुओं में बसा।<verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />मुझे बहुत समय से उनके साथ बसना पड़ा है</para>
  <para style="q2" vid="PSA 120:6">जो मेल से घृणा रखते हैं।<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />मैं तो मेल चाहता हूँ;</para>
  <para style="q2" vid="PSA 120:7">परंतु जब भी मैं बोलता हूँ,</para>
  <para style="q1" vid="PSA 120:7">वे लड़ने को तैयार रहते हैं।<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s1">यहोवा हमारा रक्षक</para>
  <para style="b" />
  <para style="d">यात्रा का गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />मैं अपनी आँखें पर्वतों की ओर उठाऊँगा;</para>
  <para style="q2" vid="PSA 121:1">मुझे सहायता कहाँ से मिलेगी?<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />मुझे सहायता यहोवा की ओर से मिलेगी,</para>
  <para style="q2" vid="PSA 121:2">जो आकाश और पृथ्वी का कर्ता है।<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />वह तेरे पैर को फिसलने न देगा;</para>
  <para style="q2" vid="PSA 121:3">तेरा रक्षक कभी न ऊँघेगा।<verse eid="PSA 121:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />देख, इस्राएल का रक्षक न तो ऊँघेगा,</para>
  <para style="q2" vid="PSA 121:4">और न सोएगा।<verse eid="PSA 121:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />यहोवा तेरा रक्षक है;</para>
  <para style="q2" vid="PSA 121:5">यहोवा तेरे दाहिनी ओर तेरी आड़ है।<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />न तो दिन को धूप से,</para>
  <para style="q2" vid="PSA 121:6">और न रात को चाँदनी से</para>
  <para style="q1" vid="PSA 121:6">तेरी कुछ हानि होगी।<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />यहोवा सारी विपत्ति से तेरी रक्षा करेगा;</para>
  <para style="q2" vid="PSA 121:7">वह तेरे प्राण की रक्षा करेगा।<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />यहोवा तेरे आने-जाने में</para>
  <para style="q2" vid="PSA 121:8">अब से लेकर सदा तक</para>
  <para style="q1" vid="PSA 121:8">तेरी रक्षा करता रहेगा।<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s1">यरूशलेम की शांति के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">यात्रा का गीत : दाऊद का भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1" />जब लोगों ने मुझसे कहा,</para>
  <para style="q2" vid="PSA 122:1">“आओ, हम यहोवा के भवन को चलें,”</para>
  <para style="q1" vid="PSA 122:1">तब मैं आनंदित हुआ।<verse eid="PSA 122:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2" />हे यरूशलेम, हम तेरे फाटकों के भीतर</para>
  <para style="q2" vid="PSA 122:2">खड़े हुए हैं।<verse eid="PSA 122:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />यरूशलेम ऐसे नगर के समान बना है,</para>
  <para style="q2" vid="PSA 122:3">जिसके घर एक दूसरे से मिले हुए हैं;<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />जहाँ गोत्र-गोत्र के लोग,</para>
  <para style="q2" vid="PSA 122:4">अर्थात् याह के गोत्रों के लोग,</para>
  <para style="q1" vid="PSA 122:4">इस्राएल की साक्षी बनने और</para>
  <para style="q2" vid="PSA 122:4">यहोवा के नाम का धन्यवाद करने जाते हैं।<verse eid="PSA 122:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5" />वहाँ न्याय के सिंहासन स्थापित हैं</para>
  <para style="q2" vid="PSA 122:5">जो दाऊद के घराने के हैं।<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6" />यरूशलेम की शांति के लिए प्रार्थना करो :</para>
  <para style="q2" vid="PSA 122:6">“तुझसे प्रीति रखनेवाले कुशल से रहें।<verse eid="PSA 122:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7" />तेरी शहरपनाह के भीतर शांति,</para>
  <para style="q2" vid="PSA 122:7">और तेरे महलों में सुख-समृद्धि बनी रहे।”<verse eid="PSA 122:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8" />मैं अपने भाइयों और मित्रों के कारण कहूँगा,</para>
  <para style="q2" vid="PSA 122:8">“तुझमें शांति बनी रहे!”<verse eid="PSA 122:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9" />अपने परमेश्‍वर यहोवा के भवन के कारण,</para>
  <para style="q2" vid="PSA 122:9">मैं तेरी भलाई चाहूँगा।<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s1">परमेश्‍वर की दया के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">यात्रा का गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1" />हे स्वर्ग में विराजमान,</para>
  <para style="q2" vid="PSA 123:1">मैं अपनी आँखें तेरी ओर उठाता हूँ!<verse eid="PSA 123:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2" />देख, जैसे दासों की आँखें अपने स्वामी के हाथ की ओर,</para>
  <para style="q2" vid="PSA 123:2">और दासियों की आँखें अपनी स्वामिनी के</para>
  <para style="q1" vid="PSA 123:2">हाथ की ओर लगी रहती हैं,</para>
  <para style="q2" vid="PSA 123:2">वैसे ही हमारी आँखें हमारे परमेश्‍वर यहोवा की ओर</para>
  <para style="q1" vid="PSA 123:2">उस समय तक लगी रहेंगी,</para>
  <para style="q2" vid="PSA 123:2">जब तक वह हम पर अनुग्रह न करे।<verse eid="PSA 123:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />हम पर अनुग्रह कर,</para>
  <para style="q2" vid="PSA 123:3">हे यहोवा, हम पर अनुग्रह कर,</para>
  <para style="q1" vid="PSA 123:3">क्योंकि हमने बहुत अपमान सह लिया है।<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />हमारा मन अभिमानी लोगों के ठट्ठों से,</para>
  <para style="q2" vid="PSA 123:4">और अहंकारियों के अपमान से भर चुका है।<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s1">परमेश्‍वर हमारी ओर</para>
  <para style="b" />
  <para style="d">यात्रा का गीत : दाऊद का भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />इस्राएल यह कहे कि</para>
  <para style="q2" vid="PSA 124:1">यदि यहोवा हमारी ओर न होता,<verse eid="PSA 124:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2" />हाँ, यदि यहोवा उस समय हमारी ओर न होता,</para>
  <para style="q2" vid="PSA 124:2">जब शत्रुओं ने हम पर चढ़ाई की,<verse eid="PSA 124:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3" />तो वे हमें उसी समय जीवित निगल जाते,</para>
  <para style="q2" vid="PSA 124:3">जब उनका क्रोध हम पर भड़का था।<verse eid="PSA 124:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />तब जल हमें डुबा देता,</para>
  <para style="q2" vid="PSA 124:4">और जल-धारा हमें बहा ले जाती;<verse eid="PSA 124:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5" />हाँ, हम उसी समय उमड़ती</para>
  <para style="q2" vid="PSA 124:5">जल-धाराओं में बह जाते।<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6" />यहोवा धन्य है,</para>
  <para style="q2" vid="PSA 124:6">जिसने हमें शत्रुओं का शिकार होने नहीं दिया।<verse eid="PSA 124:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7" />पक्षी के समान हमारा प्राण बहेलिए के जाल से छूट गया;</para>
  <para style="q2" vid="PSA 124:7">उसका जाल फट गया,</para>
  <para style="q1" vid="PSA 124:7">और हम बच निकले।<verse eid="PSA 124:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8" />हमारी सहायता यहोवा के नाम में है,</para>
  <para style="q2" vid="PSA 124:8">जो आकाश और पृथ्वी का कर्ता है।<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s1">इस्राएल की स्थिरता</para>
  <para style="b" />
  <para style="d">यात्रा का गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />जो यहोवा पर भरोसा रखते हैं,</para>
  <para style="q2" vid="PSA 125:1">वे सिय्योन पर्वत के समान हैं,</para>
  <para style="q1" vid="PSA 125:1">जो टलता नहीं,</para>
  <para style="q2" vid="PSA 125:1">बल्कि सदा स्थिर रहता है।<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />जैसे यरूशलेम के चारों ओर पहाड़ हैं,</para>
  <para style="q2" vid="PSA 125:2">वैसे ही यहोवा अपनी प्रजा के चारों ओर अब से</para>
  <para style="q1" vid="PSA 125:2">लेकर सर्वदा तक बना रहेगा।<verse eid="PSA 125:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />दुष्‍टों का राजदंड धर्मियों के भाग पर बना न रहेगा,</para>
  <para style="q2" vid="PSA 125:3">ताकि धर्मी अपने हाथ अधर्म के कार्यों की ओर न बढ़ाएँ।<verse eid="PSA 125:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />हे यहोवा, भले लोगों के साथ भलाई कर,</para>
  <para style="q2" vid="PSA 125:4">और उनके साथ भी जो मन के खरे हैं।<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />परंतु जो अपने टेढ़े मार्गों की ओर मुड़ते हैं,</para>
  <para style="q2" vid="PSA 125:5">उन्हें यहोवा अनर्थकारियों के साथ निकाल देगा।</para>
  <para style="q1" vid="PSA 125:5">इस्राएल को शांति मिले!<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s1">सिय्योन की पुनर्स्थापना</para>
  <para style="b" />
  <para style="d">यात्रा का गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />जब यहोवा सिय्योन के बंधकों को लौटा ले आया</para>
  <para style="q2" vid="PSA 126:1">तो हम स्वप्‍न देखनेवालों के समान हो गए।<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />तब हमारे चेहरे खिल उठे,</para>
  <para style="q2" vid="PSA 126:2">और हम जय जयकार करने लगे।</para>
  <para style="q1" vid="PSA 126:2">तब जाति-जाति में यह चर्चा होने लगी :</para>
  <para style="q2" vid="PSA 126:2">“यहोवा ने इनके लिए बड़े-बड़े कार्य किए हैं।”<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />यहोवा ने हमारे लिए बड़े-बड़े कार्य किए हैं,</para>
  <para style="q2" vid="PSA 126:3">और हम आनंदित हैं।<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />हे यहोवा, मरुस्थल में धाराओं के समान</para>
  <para style="q2" vid="PSA 126:4">हमारे बंधकों को लौटा ले आ।<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />जो आँसू बहाते हुए बोते हैं,</para>
  <para style="q2" vid="PSA 126:5">वे जय जयकार करते हुए काटेंगे।<verse eid="PSA 126:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6" />बोनेवाला चाहे बीज लेकर रोता हुआ जाए,</para>
  <para style="q2" vid="PSA 126:6">फिर भी वह निश्‍चय पूलियाँ लिए</para>
  <para style="q1" vid="PSA 126:6">जय जयकार करता हुआ लौट आएगा।<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s1">परमेश्‍वर की आशिष</para>
  <para style="b" />
  <para style="d">यात्रा का गीत : सुलैमान का भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1" />यदि घर को यहोवा न बनाए,</para>
  <para style="q2" vid="PSA 127:1">तो उसके बनानेवालों का परिश्रम व्यर्थ होगा।</para>
  <para style="q1" vid="PSA 127:1">यदि नगर की रक्षा यहोवा न करे,</para>
  <para style="q2" vid="PSA 127:1">तो पहरेदार का जागना व्यर्थ ही होगा।<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />तुम्हारा सवेरे-सवेरे उठना,</para>
  <para style="q2" vid="PSA 127:2">देर तक जागते रहना</para>
  <para style="q1" vid="PSA 127:2">और परिश्रम की रोटी खाना, तुम्हारे लिए व्यर्थ है;</para>
  <para style="q2" vid="PSA 127:2">क्योंकि वह तो अपने प्रियों को नींद प्रदान करता है।<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />देखो, बच्‍चे यहोवा के दिए हुए भाग हैं,</para>
  <para style="q2" vid="PSA 127:3">गर्भ का फल उसकी ओर से प्रतिफल है।<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />जैसे योद्धा के हाथ में तीर,</para>
  <para style="q2" vid="PSA 127:4">वैसे ही जवानी की संतान होती है।<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />क्या ही धन्य है</para>
  <para style="q2" vid="PSA 127:5">वह पुरुष जिसका तरकश उनसे भरा हो!</para>
  <para style="q1" vid="PSA 127:5">ऐसे पुरुष फाटक पर अपने शत्रुओं से</para>
  <para style="q2" vid="PSA 127:5">बातें करते हुए लज्‍जित न होंगे।<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s1">परमेश्‍वर का भय मानने की आशिष</para>
  <para style="b" />
  <para style="d">यात्रा का गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1" />क्या ही धन्य है</para>
  <para style="q2" vid="PSA 128:1">वह जो यहोवा का भय मानता है,</para>
  <para style="q1" vid="PSA 128:1">और उसके मार्गों पर चलता है!<verse eid="PSA 128:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />तू अपने हाथों के परिश्रम का फल खाएगा;</para>
  <para style="q2" vid="PSA 128:2">तू प्रसन्‍न रहेगा और तेरा भला होगा।<verse eid="PSA 128:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />तेरे घर के भीतर तेरी पत्‍नी फलवंत दाखलता के समान,</para>
  <para style="q2" vid="PSA 128:3">और तेरे बच्‍चे तेरी मेज़ के चारों ओर</para>
  <para style="q1" vid="PSA 128:3">जैतून के पौधों के समान होंगे।<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />देख, जो पुरुष यहोवा का भय मानता है,</para>
  <para style="q2" vid="PSA 128:4">वह ऐसी ही आशिष पाएगा।<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />यहोवा तुझे सिय्योन से आशिष दे,</para>
  <para style="q2" vid="PSA 128:5">और तू अपने जीवन भर यरूशलेम की सुख-समृद्धि देखता रहे।<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />तू अपने नाती-पोतों को भी देखे!</para>
  <para style="q2" vid="PSA 128:6">इस्राएल को शांति मिले!<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s1">शत्रुओं के विरुद्ध प्रार्थना</para>
  <para style="b" />
  <para style="d">यात्रा का गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1" />इस्राएल अब यह कहे :</para>
  <para style="q2" vid="PSA 129:1">“मेरे बचपन से ही वे मुझे बार-बार</para>
  <para style="q1" vid="PSA 129:1">क्लेश देते आए हैं,<verse eid="PSA 129:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />हाँ, बचपन से ही वे मुझे बार-बार क्लेश देते आए हैं,</para>
  <para style="q2" vid="PSA 129:2">परंतु मुझ पर प्रबल नहीं हुए।<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />हल जोतनेवालों ने मेरी पीठ पर हल चलाया,</para>
  <para style="q2" vid="PSA 129:3">और लंबी-लंबी रेघारियाँ बनाईं।”<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />यहोवा धर्मी है;</para>
  <para style="q2" vid="PSA 129:4">उसने दुष्‍टों के फंदों को काट डाला है।<verse eid="PSA 129:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />सिय्योन से बैर रखनेवाले सब लज्‍जित हों,</para>
  <para style="q2" vid="PSA 129:5">और पीछे हटा दिए जाएँ!<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />वे छत पर की घास के समान हों,</para>
  <para style="q2" vid="PSA 129:6">जो बढ़ने से पहले सूख जाती है;<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />जिसे न तो लवनेवाला अपनी मुट्ठी में,</para>
  <para style="q2" vid="PSA 129:7">और न पूलियों को बाँधनेवाला अपने हाथों में भरता है;<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />और न आने जानेवाले कहते हैं :</para>
  <para style="q2" vid="PSA 129:8">यहोवा की आशिष तुम पर हो;</para>
  <para style="q1" vid="PSA 129:8">हम यहोवा के नाम से तुम्हें आशिष देते हैं।<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s1">छुटकारे की प्रतीक्षा</para>
  <para style="b" />
  <para style="d">यात्रा का गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1" />हे यहोवा, मैंने तुझे गहराइयों में से पुकारा है।<verse eid="PSA 130:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2" />हे प्रभु, मेरी पुकार सुन!</para>
  <para style="q2" vid="PSA 130:2">तेरे कान मेरे गिड़गिड़ाने की ओर लगे रहें।<verse eid="PSA 130:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3" />हे याह, यदि तू अधर्मों का लेखा लेने लगे,</para>
  <para style="q2" vid="PSA 130:3">तो हे प्रभु, तेरे सामने कौन खड़ा रह पाएगा?<verse eid="PSA 130:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4" />परंतु तू क्षमा करता है</para>
  <para style="q2" vid="PSA 130:4">कि तेरा भय माना जाए।<verse eid="PSA 130:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5" />मैं यहोवा की प्रतीक्षा करता हूँ।</para>
  <para style="q2" vid="PSA 130:5">हाँ, मैं उसकी प्रतीक्षा करता हूँ,</para>
  <para style="q1" vid="PSA 130:5">और मेरी आशा उसके वचन पर लगी है।<verse eid="PSA 130:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6" />पहरेदार जितना भोर को चाहते हैं,</para>
  <para style="q2" vid="PSA 130:6">हाँ, पहरेदार जितना भोर को चाहते हैं,</para>
  <para style="q1" vid="PSA 130:6">उससे भी अधिक मेरा प्राण प्रभु को चाहता है।<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7" />हे इस्राएल, यहोवा पर आशा रख;</para>
  <para style="q2" vid="PSA 130:7">क्योंकि यहोवा करुणा करनेवाला</para>
  <para style="q1" vid="PSA 130:7">और पूरा छुटकारा देनेवाला है।<verse eid="PSA 130:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8" />वही इस्राएल को उसके सारे अधर्म के कामों से छुड़ाएगा।<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s1">परमेश्‍वर पर पूर्ण भरोसा</para>
  <para style="b" />
  <para style="d">यात्रा का गीत : दाऊद का भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />हे यहोवा, न तो मेरा मन गर्व से</para>
  <para style="q2" vid="PSA 131:1">और न मेरी दृष्‍टि घमंड से भरी है;</para>
  <para style="q1" vid="PSA 131:1">और जो बातें मेरे लिए बड़ी और कठिन हैं,</para>
  <para style="q2" vid="PSA 131:1">उनमें मैं स्वयं को नहीं उलझाता।<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />निश्‍चय ही मैंने अपने मन को</para>
  <para style="q2" vid="PSA 131:2">दूध छुड़ाए हुए उस बच्‍चे के समान</para>
  <para style="q1" vid="PSA 131:2">शांत और स्थिर किया है</para>
  <para style="q2" vid="PSA 131:2">जो अपनी माँ की गोद में रहता है।</para>
  <para style="q1" vid="PSA 131:2">हाँ, मेरा मन मेरे भीतर</para>
  <para style="q2" vid="PSA 131:2">दूध छुड़ाए बच्‍चे के समान रहता है।<verse eid="PSA 131:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3" />हे इस्राएल, अब से लेकर सदा-सर्वदा</para>
  <para style="q2" vid="PSA 131:3">यहोवा पर ही आशा लगाए रख।<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s1">सिय्योन का चुना जाना</para>
  <para style="b" />
  <para style="d">यात्रा का गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />हे यहोवा, दाऊद और उसकी सारी विपत्ति को स्मरण कर।<verse eid="PSA 132:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />उसने यहोवा से प्रतिज्ञा की है,</para>
  <para style="q2" vid="PSA 132:2">और याकूब के सर्वशक्‍तिमान की मन्‍न‍त मानी है :<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3" />“निश्‍चय मैं तब तक अपने भवन में प्रवेश न करूँगा</para>
  <para style="q2" vid="PSA 132:3">और न अपने पलंग पर लेटूँगा,<verse eid="PSA 132:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4" />और न मैं अपनी आँखों में नींद</para>
  <para style="q2" vid="PSA 132:4">और अपनी पलकों पर झपकी आने दूँगा,<verse eid="PSA 132:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5" />जब तक कि मैं यहोवा के लिए एक स्थान</para>
  <para style="q2" vid="PSA 132:5">अर्थात् याकूब के सर्वशक्‍तिमान के लिए</para>
  <para style="q1" vid="PSA 132:5">एक निवासस्थान तैयार न कर लूँ।”<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6" />देखो, हमने एप्राता में इसकी चर्चा सुनी है;</para>
  <para style="q2" vid="PSA 132:6">यह हमें याआर<note caller="+" style="f"><char style="fr" closed="false">132:6 </char><char style="ft" closed="false">अक्षरशः जंगल</char></note> के मैदान में मिला है।<verse eid="PSA 132:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7" />आओ, हम उसके निवासस्थान में प्रवेश करें;</para>
  <para style="q2" vid="PSA 132:7">आओ, हम उसके चरणों की चौकी के सामने दंडवत् करें।<verse eid="PSA 132:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8" />हे यहोवा, उठ!</para>
  <para style="q2" vid="PSA 132:8">तू अपने विश्राम स्थान में</para>
  <para style="q1" vid="PSA 132:8">अपने सामर्थ्य के संदूक सहित आ।<verse eid="PSA 132:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9" />तेरे याजक धार्मिकता के वस्‍त्र पहने रहें,</para>
  <para style="q2" vid="PSA 132:9">और तेरे भक्‍त जय जयकार करते रहें।<verse eid="PSA 132:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10" />अपने दास दाऊद की ख़ातिर</para>
  <para style="q2" vid="PSA 132:10">अपने अभिषिक्‍त से मुँह न मोड़।<verse eid="PSA 132:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11" />यहोवा ने दाऊद से शपथ खाई है</para>
  <para style="q2" vid="PSA 132:11">और वह उससे पीछे न हटेगा :</para>
  <para style="q1" vid="PSA 132:11">“मैं तेरे सिंहासन पर तेरे निज पुत्र को बैठाऊँगा।<verse eid="PSA 132:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12" />यदि तेरे वंशज मेरी वाचा का,</para>
  <para style="q2" vid="PSA 132:12">और उन नीतियों का पालन करें</para>
  <para style="q1" vid="PSA 132:12">जो मैं उन्हें सिखाऊँगा,</para>
  <para style="q2" vid="PSA 132:12">तो उनके वंशज भी तेरे सिंहासन पर सदैव बैठते रहेंगे।”<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13" />यहोवा ने सिय्योन को चुना है;</para>
  <para style="q2" vid="PSA 132:13">उसने अपने निवास के लिए उसे चाहा है।<verse eid="PSA 132:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14" />“यह सदा के लिए मेरा विश्राम स्थान है;</para>
  <para style="q2" vid="PSA 132:14">मैं यहीं रहूँगा,</para>
  <para style="q1" vid="PSA 132:14">क्योंकि मैंने इसे चाहा है।<verse eid="PSA 132:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15" />मैं इसकी भोजन वस्तुओं पर बहुत आशिष दूँगा;</para>
  <para style="q2" vid="PSA 132:15">मैं इसके दरिद्रों को रोटी से तृप्‍त करूँगा।<verse eid="PSA 132:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16" />मैं इसके याजकों को उद्धार का वस्‍त्र पहनाऊँगा;</para>
  <para style="q2" vid="PSA 132:16">और यहाँ के भक्‍त आनंद से जय जयकार करेंगे।<verse eid="PSA 132:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17" />यहाँ मैं दाऊद का एक सींग उगाऊँगा;</para>
  <para style="q2" vid="PSA 132:17">मैंने अपने अभिषिक्‍त के लिए एक दीपक तैयार कर रखा है।<verse eid="PSA 132:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18" />मैं उसके शत्रुओं को तो लज्‍जा का वस्‍त्र पहनाऊँगा,</para>
  <para style="q2" vid="PSA 132:18">परंतु उसका मुकुट उसके सिर पर सुशोभित होगा।”<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s1">एकता में रहना</para>
  <para style="b" />
  <para style="d">यात्रा का गीत : दाऊद का भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />देखो, यह कितनी उत्तम और मनोहर बात है</para>
  <para style="q2" vid="PSA 133:1">कि भाई आपस में मिले रहें!<verse eid="PSA 133:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />यह तो उस उत्तम तेल के समान है,</para>
  <para style="q2" vid="PSA 133:2">जो हारून के सिर पर उंडेला गया,</para>
  <para style="q1" vid="PSA 133:2">और उसकी दाढ़ी पर से बहता हुआ</para>
  <para style="q2" vid="PSA 133:2">उसके वस्‍त्र की छोर तक पहुँच गया।<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />यह हेर्मोन की उस ओस के समान है</para>
  <para style="q2" vid="PSA 133:3">जो सिय्योन के पहाड़ों पर गिरती है;</para>
  <para style="q1" vid="PSA 133:3">क्योंकि वहीं यहोवा ने सदा के</para>
  <para style="q2" vid="PSA 133:3">जीवन की आशिष ठहराई है।<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s1">संध्या की आराधना का आह्वान</para>
  <para style="b" />
  <para style="d">यात्रा का गीत।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />हे यहोवा के सब सेवको, सुनो,</para>
  <para style="q2" vid="PSA 134:1">तुम जो रात को यहोवा के भवन में सेवा करते हो,</para>
  <para style="q1" vid="PSA 134:1">यहोवा को धन्य कहो।<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />अपने हाथ पवित्रस्थान की ओर</para>
  <para style="q2" vid="PSA 134:2">उठाकर यहोवा को धन्य कहो।<verse eid="PSA 134:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />यहोवा जो आकाश और पृथ्वी का कर्ता है,</para>
  <para style="q2" vid="PSA 134:3">वह सिय्योन से तुझे आशिष दे।<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s1">परमेश्‍वर की महानता</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1" />याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">135:1 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!</para>
  <para style="q2" vid="PSA 135:1">यहोवा के नाम की स्तुति करो;</para>
  <para style="q1" vid="PSA 135:1">हे यहोवा के सेवको,<verse eid="PSA 135:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2" />तुम जो यहोवा के भवन में,</para>
  <para style="q2" vid="PSA 135:2">अर्थात् हमारे परमेश्‍वर के भवन के आँगनों में खड़े रहते हो,</para>
  <para style="q1" vid="PSA 135:2">उसकी स्तुति करो!<verse eid="PSA 135:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />याह की स्तुति करो,</para>
  <para style="q2" vid="PSA 135:3">क्योंकि यहोवा भला है;</para>
  <para style="q1" vid="PSA 135:3">उसके नाम का भजन गाओ,</para>
  <para style="q2" vid="PSA 135:3">क्योंकि यह मनोहर है।<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />याह ने तो याकूब को अपने लिए,</para>
  <para style="q2" vid="PSA 135:4">अर्थात् इस्राएल को अपना निज धन होने के लिए चुन लिया है।<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />मैं तो जानता हूँ</para>
  <para style="q2" vid="PSA 135:5">कि यहोवा महान है,</para>
  <para style="q1" vid="PSA 135:5">और हमारा प्रभु सब देवताओं से बढ़कर है।<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />यहोवा जो चाहता है,</para>
  <para style="q2" vid="PSA 135:6">वह उसे आकाश और पृथ्वी और समुद्र</para>
  <para style="q1" vid="PSA 135:6">और सब गहरे स्थानों में करता है।<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />वह पृथ्वी की छोर से बादल उठाता है,</para>
  <para style="q2" vid="PSA 135:7">और वर्षा भेजने के साथ-साथ बिजली चमकाता है,</para>
  <para style="q1" vid="PSA 135:7">और पवन को अपने भंडार में से निकालता है।<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />उसने मिस्र में क्या मनुष्य, क्या पशु,</para>
  <para style="q2" vid="PSA 135:8">सब के पहलौठों को मार डाला।<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />हे मिस्र, उसने तेरे बीच में,</para>
  <para style="q2" vid="PSA 135:9">फ़िरौन और उसके सब कर्मचारियों के बीच</para>
  <para style="q1" vid="PSA 135:9">चिह्‍न और चमत्कार किए।<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />उसने बहुत सी जातियाँ नष्‍ट कीं,</para>
  <para style="q2" vid="PSA 135:10">और सामर्थी राजाओं को,<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />अर्थात् एमोरियों के राजा सीहोन को,</para>
  <para style="q2" vid="PSA 135:11">और बाशान के राजा ओग को,</para>
  <para style="q1" vid="PSA 135:11">तथा कनान के सब राजाओं को घात किया;<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />और उनके देश को अपनी प्रजा</para>
  <para style="q2" vid="PSA 135:12">इस्राएल का भाग होने के लिए</para>
  <para style="q1" vid="PSA 135:12">उत्तराधिकार के रूप में दे दिया।<verse eid="PSA 135:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />हे यहोवा, तेरा नाम सदा के लिए है।</para>
  <para style="q2" vid="PSA 135:13">हे यहोवा, तेरा स्मरण पीढ़ी से पीढ़ी तक होता रहेगा।<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />यहोवा अपनी प्रजा का न्याय करेगा,</para>
  <para style="q2" vid="PSA 135:14">और अपने सेवकों पर तरस खाएगा।<verse eid="PSA 135:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />अन्यजातियों की मूर्तियाँ तो सोने-चाँदी की हैं,</para>
  <para style="q2" vid="PSA 135:15">वे मनुष्यों के हाथों की कारीगरी हैं।<verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />उनके मुँह तो हैं,</para>
  <para style="q2" vid="PSA 135:16">परंतु वे बोल नहीं सकतीं;</para>
  <para style="q1" vid="PSA 135:16">उनकी आँखें तो हैं,</para>
  <para style="q2" vid="PSA 135:16">परंतु वे देख नहीं सकतीं।<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />उनके कान तो हैं,</para>
  <para style="q2" vid="PSA 135:17">परंतु वे सुन नहीं सकतीं,</para>
  <para style="q1" vid="PSA 135:17">न उनमें<note caller="+" style="f"><char style="fr" closed="false">135:17 </char><char style="ft" closed="false">अक्षरशः उनके मुँह में</char></note> जीवन की साँस है।<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />जैसी वे हैं वैसे ही उनके बनानेवाले भी हैं;</para>
  <para style="q2" vid="PSA 135:18">और वे सब भी जो</para>
  <para style="q1" vid="PSA 135:18">उन पर भरोसा रखते हैं।<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />हे इस्राएल के घराने,</para>
  <para style="q2" vid="PSA 135:19">यहोवा को धन्य कह!</para>
  <para style="q1" vid="PSA 135:19">हे हारून के घराने, यहोवा को धन्य कह!<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />हे लेवी के घराने,</para>
  <para style="q2" vid="PSA 135:20">यहोवा को धन्य कह!</para>
  <para style="q1" vid="PSA 135:20">हे यहोवा का भय माननेवालो, यहोवा को धन्य कहो!<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />यहोवा जो यरूशलेम में वास करता है,</para>
  <para style="q2" vid="PSA 135:21">उसे सिय्योन में धन्य कहा जाए!</para>
  <para style="q1" vid="PSA 135:21">याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">135:21 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="s1">परमेश्‍वर का अनंत प्रेम</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1" />यहोवा का धन्यवाद करो</para>
  <para style="q2" vid="PSA 136:1">क्योंकि वह भला है,</para>
  <para style="q1" vid="PSA 136:1">और उसकी करुणा सदा की है!<verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />ईश्‍वरों के परमेश्‍वर का धन्यवाद करो,</para>
  <para style="q2" vid="PSA 136:2">क्योंकि उसकी करुणा सदा की है।<verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />प्रभुओं के प्रभु का धन्यवाद करो,</para>
  <para style="q2" vid="PSA 136:3">क्योंकि उसकी करुणा सदा की है :<verse eid="PSA 136:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />उसी का जो स्वयं बड़े-बड़े आश्‍चर्यकर्म करता है,</para>
  <para style="q2" vid="PSA 136:4">उसकी करुणा सदा की है।<verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />उसी का जिसने अपनी बुद्धि से आकाश बनाया,</para>
  <para style="q2" vid="PSA 136:5">उसकी करुणा सदा की है।<verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />उसी का जिसने जल के ऊपर पृथ्वी को फैलाया,</para>
  <para style="q2" vid="PSA 136:6">उसकी करुणा सदा की है।<verse eid="PSA 136:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />उसी का जिसने बड़ी-बड़ी ज्योतियाँ बनाईं,</para>
  <para style="q2" vid="PSA 136:7">उसकी करुणा सदा की है।<verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />उसने दिन पर प्रभुता करने के लिए सूर्य को बनाया,</para>
  <para style="q2" vid="PSA 136:8">उसकी करुणा सदा की है।<verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />उसने रात पर प्रभुता करने के लिए चंद्रमा और तारों को बनाया,</para>
  <para style="q2" vid="PSA 136:9">उसकी करुणा सदा की है।<verse eid="PSA 136:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10" />उसी का जिसने मिस्रियों के पहलौठों को मारा,</para>
  <para style="q2" vid="PSA 136:10">उसकी करुणा सदा की है।<verse eid="PSA 136:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11" />और इस्राएलियों को उनके बीच से निकाल लाया,</para>
  <para style="q2" vid="PSA 136:11">उसकी करुणा सदा की है।<verse eid="PSA 136:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12" />बलवंत हाथ और बढ़ाई हुई भुजा से निकाल लाया,</para>
  <para style="q2" vid="PSA 136:12">उसकी करुणा सदा की है।<verse eid="PSA 136:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13" />उसी का जिसने लाल समुद्र को दो भाग कर दिया,</para>
  <para style="q2" vid="PSA 136:13">उसकी करुणा सदा की है।<verse eid="PSA 136:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14" />और इस्राएल को उसके बीच में से पार निकाल लाया,</para>
  <para style="q2" vid="PSA 136:14">उसकी करुणा सदा की है।<verse eid="PSA 136:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15" />उसने फ़िरौन और उसकी सेना को लाल समुद्र में बहा दिया,</para>
  <para style="q2" vid="PSA 136:15">उसकी करुणा सदा की है।<verse eid="PSA 136:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16" />उसी का जो जंगल में अपनी प्रजा को लिए चला,</para>
  <para style="q2" vid="PSA 136:16">उसकी करुणा सदा की है।<verse eid="PSA 136:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17" />उसी का जिसने बड़े-बड़े राजाओं को मारा,</para>
  <para style="q2" vid="PSA 136:17">उसकी करुणा सदा की है।<verse eid="PSA 136:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18" />उसने प्रतापी राजाओं को भी मार गिराया,</para>
  <para style="q2" vid="PSA 136:18">उसकी करुणा सदा की है।<verse eid="PSA 136:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19" />एमोरियों के राजा सीहोन को मार गिराया,</para>
  <para style="q2" vid="PSA 136:19">उसकी करुणा सदा की है।<verse eid="PSA 136:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20" />और बाशान के राजा ओग को भी मार गिराया,</para>
  <para style="q2" vid="PSA 136:20">उसकी करुणा सदा की है।<verse eid="PSA 136:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21" />और उनके देश को निज भाग होने के लिए दे दिया,</para>
  <para style="q2" vid="PSA 136:21">उसकी करुणा सदा की है।<verse eid="PSA 136:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22" />हाँ, अपने सेवक इस्राएल का निज भाग होने के लिए दे दिया,</para>
  <para style="q2" vid="PSA 136:22">उसकी करुणा सदा की है।<verse eid="PSA 136:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23" />उसने हमारी दीन-हीन दशा में हमारी सुधि ली,</para>
  <para style="q2" vid="PSA 136:23">उसकी करुणा सदा की है।<verse eid="PSA 136:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24" />और हमें हमारे शत्रुओं से छुड़ाया,</para>
  <para style="q2" vid="PSA 136:24">उसकी करुणा सदा की है।<verse eid="PSA 136:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25" />वह सब प्राणियों को आहार देता है,</para>
  <para style="q2" vid="PSA 136:25">उसकी करुणा सदा की है।<verse eid="PSA 136:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26" />स्वर्ग के परमेश्‍वर का धन्यवाद करो,</para>
  <para style="q2" vid="PSA 136:26">क्योंकि उसकी करुणा सदा की है।<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s1">बँधुआई में इस्राएल का विलापगीत</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1" />बेबीलोन की नदियों के किनारे हम बैठ गए,</para>
  <para style="q2" vid="PSA 137:1">और सिय्योन को स्मरण करके रो पड़े।<verse eid="PSA 137:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2" />चिनार के पेड़ों पर हमने अपनी वीणाएँ टाँग दीं;<verse eid="PSA 137:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />क्योंकि जो हमें बंदी बनाकर ले गए थे,</para>
  <para style="q2" vid="PSA 137:3">उन्होंने वहाँ हमसे गीत गाने को कहा,</para>
  <para style="q1" vid="PSA 137:3">और हमारे अत्याचारियों ने हमसे मनोरंजन चाहा :</para>
  <para style="q2" vid="PSA 137:3">“हमारे लिए सिय्योन का कोई गीत गाओ।”<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />हम पराए देश में यहोवा का गीत कैसे गाएँ?<verse eid="PSA 137:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />हे यरूशलेम, यदि मैं तुझे भूल जाऊँ,</para>
  <para style="q2" vid="PSA 137:5">तो मेरा दाहिना हाथ भी वीणा बजाना भूल जाए।<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />यदि मैं तुझे स्मरण न रखूँ,</para>
  <para style="q2" vid="PSA 137:6">यदि मैं यरूशलेम को अपना सब से बड़ा आनंद न जानूँ,</para>
  <para style="q1" vid="PSA 137:6">तो मेरी जीभ तालू से चिपक जाए।<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />हे यहोवा, यरूशलेम के दिन को एदोमियों के विरुद्ध</para>
  <para style="q2" vid="PSA 137:7">स्मरण कर जो कहते थे,</para>
  <para style="q1" vid="PSA 137:7">“ढा दो! उसे नींव सहित ढा दो!”<verse eid="PSA 137:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />हे बेबीलोन, तू नष्‍ट होने वाली है;</para>
  <para style="q2" vid="PSA 137:8">वह क्या ही धन्य होगा,</para>
  <para style="q1" vid="PSA 137:8">जो तेरे साथ वैसा ही करेगा</para>
  <para style="q2" vid="PSA 137:8">जैसा तूने हमारे साथ किया था!<verse eid="PSA 137:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9" />वह क्या ही धन्य होगा,</para>
  <para style="q2" vid="PSA 137:9">जो तेरे बच्‍चों को पकड़कर</para>
  <para style="q1" vid="PSA 137:9">चट्टान पर पटक देगा!<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s1">आभारी हृदय</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />मैं संपूर्ण मन से तेरा धन्यवाद करूँगा;</para>
  <para style="q2" vid="PSA 138:1">देवताओं के सामने भी मैं तेरा भजन गाऊँगा।<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />मैं तेरे पवित्र मंदिर की ओर दंडवत् करूँगा,</para>
  <para style="q2" vid="PSA 138:2">और तेरी करुणा और सच्‍चाई के कारण</para>
  <para style="q1" vid="PSA 138:2">तेरे नाम का धन्यवाद करूँगा;</para>
  <para style="q2" vid="PSA 138:2">क्योंकि तूने सब बातों से बढ़कर अपने नाम</para>
  <para style="q1" vid="PSA 138:2">और अपने वचन को महत्त्व दिया है<note caller="+" style="f"><char style="fr" closed="false">138:2 </char><char style="ft" closed="false">या, क्योंकि तूने अपने वचन को अपने सब नाम से अधिक महत्त्व दिया है।</char></note>।<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />जिस दिन मैंने पुकारा,</para>
  <para style="q2" vid="PSA 138:3">तूने मेरी सुन ली;</para>
  <para style="q1" vid="PSA 138:3">तूने मुझे बल देकर मेरा साहस बढ़ाया।<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />हे यहोवा, पृथ्वी के सब राजा तेरा धन्यवाद करेंगे,</para>
  <para style="q2" vid="PSA 138:4">क्योंकि उन्होंने तेरे मुँह से निकले वचनों को सुना है।<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />वे यहोवा के कार्यों के विषय में गाएँगे,</para>
  <para style="q2" vid="PSA 138:5">क्योंकि यहोवा की महिमा बड़ी है।<verse eid="PSA 138:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />यद्यपि यहोवा महान है,</para>
  <para style="q2" vid="PSA 138:6">फिर भी वह नम्र मनुष्य की ओर दृष्‍टि करता है;</para>
  <para style="q1" vid="PSA 138:6">परंतु अहंकारी मनुष्य को दूर से ही पहचानता है।<verse eid="PSA 138:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />चाहे मैं संकट से होकर जाऊँ,</para>
  <para style="q2" vid="PSA 138:7">फिर भी तू मुझे सुरक्षित रखेगा;</para>
  <para style="q1" vid="PSA 138:7">तू मेरे शत्रुओं के क्रोध के विरुद्ध अपना हाथ बढ़ाएगा,</para>
  <para style="q2" vid="PSA 138:7">और तेरा दाहिना हाथ मुझे बचाएगा।<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />यहोवा मेरे लिए सब कुछ पूरा करेगा।</para>
  <para style="q2" vid="PSA 138:8">हे यहोवा, तेरी करुणा सदा की है;</para>
  <para style="q1" vid="PSA 138:8">तू अपने हाथों के कार्यों को न त्याग।<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s1">सर्वज्ञानी, सर्वव्यापी परमेश्‍वर</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1" />हे यहोवा, तूने मुझे जाँचा,</para>
  <para style="q2" vid="PSA 139:1">और जान लिया है।<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />तू मेरा उठना और बैठना जानता है;</para>
  <para style="q2" vid="PSA 139:2">तू मेरे विचारों को दूर से ही समझ लेता है।<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />तू मेरे चलने और लेटने को भली-भाँति जाँचता है,</para>
  <para style="q2" vid="PSA 139:3">और मेरे सारे चाल-चलन से परिचित है।<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />इससे पहले कि मेरे मुँह से कोई बात निकले,</para>
  <para style="q2" vid="PSA 139:4">हे यहोवा, तू उसे पूरी तरह से जानता है।<verse eid="PSA 139:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />तूने मुझे आगे-पीछे घेर रखा है,</para>
  <para style="q2" vid="PSA 139:5">और अपना हाथ मुझ पर रखा हुआ है।<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />यह ज्ञान मेरे लिए बहुत ही अद्भुत है;</para>
  <para style="q2" vid="PSA 139:6">यह गहरा और मेरी समझ से परे है।<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />मैं तेरे आत्मा से भागकर कहाँ जाऊँ?</para>
  <para style="q2" vid="PSA 139:7">या तेरी उपस्थिति से कहाँ भागूँ?<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />यदि मैं आकाश पर चढ़ूँ,</para>
  <para style="q2" vid="PSA 139:8">तो तू वहाँ है।</para>
  <para style="q1" vid="PSA 139:8">यदि मैं अपना बिछौना अधोलोक में बिछाऊँ,</para>
  <para style="q2" vid="PSA 139:8">तो तू वहाँ भी है।<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />यदि मैं भोर की किरणों पर</para>
  <para style="q2" vid="PSA 139:9">सवार होकर समुद्र के पार जा बसूँ,<verse eid="PSA 139:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10" />तो वहाँ भी तू अपने हाथ से मेरी अगुवाई करेगा,</para>
  <para style="q2" vid="PSA 139:10">और अपने दाहिने हाथ से मुझे थामे रहेगा।<verse eid="PSA 139:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />यदि मैं कहूँ कि मैं अंधकार में छिप जाऊँ,</para>
  <para style="q2" vid="PSA 139:11">और मेरे चारों ओर का</para>
  <para style="q1" vid="PSA 139:11">प्रकाश रात का अंधेरा हो जाए,<verse eid="PSA 139:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12" />फिर भी अंधकार तेरे लिए अंधकार नहीं,</para>
  <para style="q2" vid="PSA 139:12">और रात भी तेरे लिए दिन के समान प्रकाश देती है;</para>
  <para style="q1" vid="PSA 139:12">तेरे लिए तो अंधकार और प्रकाश दोनों एक समान हैं।<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />तूने मेरे भीतरी अंगों को बनाया है,</para>
  <para style="q2" vid="PSA 139:13">तूने मुझे माता के गर्भ में रचा है।<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />मैं तेरा धन्यवाद करता हूँ,</para>
  <para style="q2" vid="PSA 139:14">क्योंकि मैं आश्‍चर्यजनक<note caller="+" style="f"><char style="fr" closed="false">139:14 </char><char style="ft" closed="false">या भयानक</char></note> और अद्भुत रीति से रचा गया हूँ।</para>
  <para style="q1" vid="PSA 139:14">तेरे कार्य अद्भुत हैं</para>
  <para style="q2" vid="PSA 139:14">और मैं यह भली-भाँति जानता हूँ।<verse eid="PSA 139:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15" />जब मैं गुप्‍त में बनाया जाता,</para>
  <para style="q2" vid="PSA 139:15">और पृथ्वी<note caller="+" style="f"><char style="fr" closed="false">139:15 </char><char style="ft" closed="false">या माता</char></note> के गर्भ में रचा जाता था,</para>
  <para style="q1" vid="PSA 139:15">तब मेरी हड्डियाँ तुझसे छिपी न थीं,<verse eid="PSA 139:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16" />तेरी आँखों ने मेरे बेडौल तत्व को देखा।</para>
  <para style="q2" vid="PSA 139:16">मेरे सब दिन तेरी पुस्तक में लिखे और निर्धारित किए गए थे,</para>
  <para style="q1" vid="PSA 139:16">जबकि उनमें से एक भी अस्तित्व में न था।<verse eid="PSA 139:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17" />हे परमेश्‍वर, तेरे विचार मेरे लिए कितने बहुमूल्य हैं!</para>
  <para style="q2" vid="PSA 139:17">उनकी संख्या का योग कैसा बड़ा है!<verse eid="PSA 139:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18" />यदि मैं उन्हें गिनूँ तो वे बालू के कणों से भी अधिक होंगे।</para>
  <para style="q2" vid="PSA 139:18">जब मैं जाग उठता हूँ,</para>
  <para style="q1" vid="PSA 139:18">तब भी तेरे साथ रहता हूँ।<verse eid="PSA 139:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19" />हे परमेश्‍वर, तू निश्‍चय ही दुष्‍ट का घात करेगा।</para>
  <para style="q2" vid="PSA 139:19">हे हत्यारो, मुझसे दूर हो जाओ।<verse eid="PSA 139:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20" />वे तो तेरे विरोध में दुष्‍टता की बात बोलते हैं;</para>
  <para style="q2" vid="PSA 139:20">तेरे शत्रु तेरा नाम व्यर्थ लेते हैं।<verse eid="PSA 139:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21" />हे यहोवा, क्या मैं तेरे बैरियों से बैर नहीं रखता,</para>
  <para style="q2" vid="PSA 139:21">और तेरे विरोधियों से घृणा नहीं करता?<verse eid="PSA 139:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22" />हाँ, मैं उनसे बहुत घृणा करता हूँ;</para>
  <para style="q2" vid="PSA 139:22">मैं उन्हें अपना शत्रु समझता हूँ।<verse eid="PSA 139:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23" />हे परमेश्‍वर, मुझे जाँच और मेरे मन को जान ले!</para>
  <para style="q2" vid="PSA 139:23">मुझे परख और मेरी चिंताओं को जान ले!<verse eid="PSA 139:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24" />और देख कि मुझमें कोई</para>
  <para style="q2" vid="PSA 139:24">बुरी चाल है या नहीं,</para>
  <para style="q1" vid="PSA 139:24">और अनंत मार्ग पर मेरी अगुवाई कर!<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s1">रक्षा के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">संगीत निर्देशक के लिए। दाऊद का भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />हे यहोवा, मुझे बुरे मनुष्यों से बचा ले;</para>
  <para style="q2" vid="PSA 140:1">हिंसक लोगों से मेरी रक्षा कर।<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />उन्होंने मन में बुराई की योजनाएँ बनाई हैं;</para>
  <para style="q2" vid="PSA 140:2">वे लगातार युद्ध भड़काते हैं।<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />उनका बोलना सर्प के काटने जैसा है;</para>
  <para style="q2" vid="PSA 140:3">उनके होंठों के नीचे</para>
  <para style="q1" vid="PSA 140:3">साँप का सा विष रहता है।</para>
  <para style="q2" vid="PSA 140:3">सेला।<verse eid="PSA 140:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />हे यहोवा, मुझे दुष्‍ट के हाथों से बचा ले,</para>
  <para style="q2" vid="PSA 140:4">हिंसक लोगों से मेरी रक्षा कर;</para>
  <para style="q1" vid="PSA 140:4">उन्होंने ऐसी युक्‍ति बनाई है</para>
  <para style="q2" vid="PSA 140:4">कि मेरे पैर लड़खड़ा जाएँ।<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />घमंडियों ने मेरे लिए फंदा और रस्से लगाए हैं,</para>
  <para style="q2" vid="PSA 140:5">और मार्ग के किनारे जाल बिछाया है;</para>
  <para style="q1" vid="PSA 140:5">उन्होंने मेरे लिए फंदे लगा रखे हैं।</para>
  <para style="q2" vid="PSA 140:5">सेला।<verse eid="PSA 140:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6" />मैंने यहोवा से कहा है</para>
  <para style="q2" vid="PSA 140:6">कि तू मेरा परमेश्‍वर है।</para>
  <para style="q1" vid="PSA 140:6">हे यहोवा, मेरे गिड़गिड़ाने की ओर कान लगा!<verse eid="PSA 140:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7" />हे यहोवा मेरे प्रभु,</para>
  <para style="q2" vid="PSA 140:7">तू जो मेरे उद्धार का सामर्थ्य है,</para>
  <para style="q1" vid="PSA 140:7">तूने युद्ध के दिन मेरे सिर की रक्षा की है।<verse eid="PSA 140:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8" />हे यहोवा, दुष्‍टों की इच्छाओं को पूरी न होने दे,</para>
  <para style="q2" vid="PSA 140:8">और न उनकी बुरी युक्‍ति को सफल होने दे;</para>
  <para style="q1" vid="PSA 140:8">ऐसा न हो कि वे घमंड करें।</para>
  <para style="q2" vid="PSA 140:8">सेला।<verse eid="PSA 140:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />जो लोग मुझे घेरते हैं</para>
  <para style="q2" vid="PSA 140:9">उनके सिर पर उन्हीं के मुँह से निकली हुई दुष्‍टता आ पड़े।<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />उन पर अंगारे गिराए जाएँ।</para>
  <para style="q2" vid="PSA 140:10">उन्हें आग में और ऐसे गड्‌ढों में डाल दिया जाए</para>
  <para style="q1" vid="PSA 140:10">कि वे फिर उठ न सकें।<verse eid="PSA 140:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11" />निंदा करनेवाला मनुष्य पृथ्वी पर स्थिर न रह पाए;</para>
  <para style="q2" vid="PSA 140:11">उपद्रवी मनुष्य को गिराने के लिए बुराई उसका पीछा करे।<verse eid="PSA 140:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12" />मैं जानता हूँ कि यहोवा दीन जन का</para>
  <para style="q2" vid="PSA 140:12">और कंगालों का न्याय चुकाएगा।<verse eid="PSA 140:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13" />निश्‍चय ही धर्मी तेरे नाम का धन्यवाद करेंगे;</para>
  <para style="q2" vid="PSA 140:13">सीधे लोग तेरी उपस्थिति में वास करेंगे।<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s1">पाप और पापियों से सुरक्षा</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />हे यहोवा, मैं तुझे पुकारता हूँ;</para>
  <para style="q2" vid="PSA 141:1">मेरे लिए फुर्ती कर!</para>
  <para style="q1" vid="PSA 141:1">जब मैं तुझे पुकारूँ,</para>
  <para style="q2" vid="PSA 141:1">तो मेरी ओर कान लगा।<verse eid="PSA 141:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2" />मेरी प्रार्थना तेरे सामने सुगंधित धूप,</para>
  <para style="q2" vid="PSA 141:2">और मेरा हाथ फैलाना तेरे लिए संध्या-बलि ठहरे।<verse eid="PSA 141:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />हे यहोवा, मेरे मुख पर पहरा बैठा;</para>
  <para style="q2" vid="PSA 141:3">मेरे होठों के द्वार की रखवाली कर।<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />मेरे मन को किसी बुरी बात की ओर फिरने न दे;</para>
  <para style="q2" vid="PSA 141:4">मैं अनर्थकारियों के साथ दुष्‍टता के कार्यों में न लगूँ,</para>
  <para style="q1" vid="PSA 141:4">और न मैं उनके स्वादिष्‍ट व्यंजनों में से कुछ खाऊँ।<verse eid="PSA 141:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />धर्मी जन मुझे मारे तो यह करुणा होगी,</para>
  <para style="q2" vid="PSA 141:5">और वह मुझे ताड़ना दे</para>
  <para style="q1" vid="PSA 141:5">तो यह मेरे सिर पर का तेल ठहरेगा;</para>
  <para style="q2" vid="PSA 141:5">मेरा सिर उससे इनकार न करेगा।</para>
  <para style="q1" vid="PSA 141:5">परंतु अनर्थकारियों के बुरे कामों के विरुद्ध मैं प्रार्थना में लगा रहूँगा।<verse eid="PSA 141:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />जब उनके न्यायी चट्टान के पास गिराए जाएँगे,</para>
  <para style="q2" vid="PSA 141:6">तो वे लोग मेरे वचन सुनेंगे,</para>
  <para style="q1" vid="PSA 141:6">क्योंकि वे मधुर हैं।<verse eid="PSA 141:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />अधोलोक के मुँह पर हमारी हड्डियाँ ऐसे बिखरी हुई हैं,</para>
  <para style="q2" vid="PSA 141:7">जैसे भूमि पर हल चलाते समय</para>
  <para style="q1" vid="PSA 141:7">ढेले टूटकर बिखर जाते हैं।<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8" />परंतु हे यहोवा मेरे प्रभु,</para>
  <para style="q2" vid="PSA 141:8">मेरी आँखें तेरी ही ओर लगी हैं;</para>
  <para style="q1" vid="PSA 141:8">मैं तेरा शरणागत हूँ;</para>
  <para style="q2" vid="PSA 141:8">तू मेरे प्राण की रक्षा कर।<verse eid="PSA 141:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9" />मुझे उस फंदे से,</para>
  <para style="q2" vid="PSA 141:9">जो उन्होंने मेरे लिए लगाया है,</para>
  <para style="q1" vid="PSA 141:9">और अनर्थकारियों के जाल से बचा।<verse eid="PSA 141:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10" />दुष्‍ट लोग अपने ही जालों में फँस जाएँ,</para>
  <para style="q2" vid="PSA 141:10">पर मैं बचकर निकल आऊँ।<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s1">संकट के समय प्रार्थना</para>
  <para style="b" />
  <para style="d">दाऊद का मश्कील। उस समय की प्रार्थना जब वह गुफा में था।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />मैं यहोवा की दुहाई देता हूँ;</para>
  <para style="q2" vid="PSA 142:1">मैं यहोवा के सामने ज़ोर-ज़ोर से गिड़गिड़ाता हूँ।<verse eid="PSA 142:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2" />मैं उसके सामने अपना दुखड़ा रोता हूँ;</para>
  <para style="q2" vid="PSA 142:2">मैं अपनी कठिनाई को उसके सामने प्रकट करता हूँ।<verse eid="PSA 142:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3" />मेरी आत्मा मेरे भीतर व्याकुल होती थी,</para>
  <para style="q2" vid="PSA 142:3">पर तू मेरे पथ को जानता था।</para>
  <para style="b" vid="PSA 142:3" />
  <para style="q1" vid="PSA 142:3">मैं जिस रास्ते से जाता हूँ,</para>
  <para style="q2" vid="PSA 142:3">वे उसी में मेरे लिए फंदा लगाते हैं।<verse eid="PSA 142:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4" />दाहिनी ओर आँख उठाकर देख,</para>
  <para style="q2" vid="PSA 142:4">कोई मेरी ओर ध्यान नहीं देता,</para>
  <para style="q1" vid="PSA 142:4">मेरे लिए कहीं शरण नहीं रही;</para>
  <para style="q2" vid="PSA 142:4">कोई मेरी चिंता नहीं करता।<verse eid="PSA 142:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />हे यहोवा, मैंने तेरी दुहाई दी है;</para>
  <para style="q2" vid="PSA 142:5">मैंने कहा, तू मेरा शरणस्थान है,</para>
  <para style="q1" vid="PSA 142:5">जीवितों की भूमि पर तू मेरा भाग है।<verse eid="PSA 142:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />मेरी पुकार को सुन,</para>
  <para style="q2" vid="PSA 142:6">क्योंकि मैं बड़ी दुर्दशा में पड़ा हुआ हूँ;</para>
  <para style="q1" vid="PSA 142:6">जो मेरे पीछे पड़े हैं उनसे मुझे बचा,</para>
  <para style="q2" vid="PSA 142:6">क्योंकि वे मुझसे अधिक बलवान हैं।<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />मुझे बंदीगृह से निकाल</para>
  <para style="q2" vid="PSA 142:7">कि मैं तेरे नाम का धन्यवाद करूँ।</para>
  <para style="q1" vid="PSA 142:7">धर्मी लोग मेरे चारों ओर होंगे,</para>
  <para style="q2" vid="PSA 142:7">क्योंकि तू मुझ पर उपकार करेगा।<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s1">सहायता के लिए प्रार्थना</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />हे यहोवा, मेरी प्रार्थना सुन;</para>
  <para style="q2" vid="PSA 143:1">मेरे गिड़गिड़ाने की ओर कान लगा।</para>
  <para style="q1" vid="PSA 143:1">अपनी सच्‍चाई में, और अपनी धार्मिकता में मुझे उत्तर दे।<verse eid="PSA 143:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />अपने दास को दोषी न ठहरा,</para>
  <para style="q2" vid="PSA 143:2">क्योंकि तेरी दृष्‍टि में कोई भी मनुष्य धर्मी नहीं है।<verse eid="PSA 143:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />शत्रु ने तो मुझे सताया है;</para>
  <para style="q2" vid="PSA 143:3">उसने मेरा जीवन चकनाचूर करके मिट्टी में मिला दिया है।</para>
  <para style="q1" vid="PSA 143:3">उसने मुझे बहुत दिन के मरे हुओं</para>
  <para style="q2" vid="PSA 143:3">के समान अंधेरे स्थानों में डाल दिया है।<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />मेरी आत्मा भीतर ही भीतर व्याकुल है;</para>
  <para style="q2" vid="PSA 143:4">मेरा मन उजाड़ पड़ा है।<verse eid="PSA 143:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />मैं बीते हुए दिनों को स्मरण करता हूँ;</para>
  <para style="q2" vid="PSA 143:5">मैं तेरे सब कार्यों पर ध्यान लगाता हूँ;</para>
  <para style="q1" vid="PSA 143:5">मैं तेरे हाथों के कार्यों पर विचार करता हूँ।<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />मैं तेरी ओर अपने हाथ फैलाए हुए हूँ;</para>
  <para style="q2" vid="PSA 143:6">सूखी भूमि के समान मैं तेरा प्यासा हूँ।</para>
  <para style="q1" vid="PSA 143:6">सेला।<verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />हे यहोवा, मुझे शीघ्र उत्तर दे,</para>
  <para style="q2" vid="PSA 143:7">क्योंकि मेरा प्राण निकलने ही पर है।</para>
  <para style="q1" vid="PSA 143:7">मुझसे अपना मुँह न छिपा,</para>
  <para style="q2" vid="PSA 143:7">ऐसा न हो कि मैं कब्र में पड़े हुओं के समान हो जाऊँ।<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />भोर को अपनी करुणा की बात मुझे सुना,</para>
  <para style="q2" vid="PSA 143:8">क्योंकि मैंने तुझ पर भरोसा रखा है।</para>
  <para style="q1" vid="PSA 143:8">जिस मार्ग से मुझे जाना है,</para>
  <para style="q2" vid="PSA 143:8">वह मुझे बता,</para>
  <para style="q1" vid="PSA 143:8">क्योंकि मैं अपना मन तेरी ही ओर लगाता हूँ।<verse eid="PSA 143:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />हे यहोवा, मुझे शत्रुओं से बचा ले;</para>
  <para style="q2" vid="PSA 143:9">मैं तेरी शरण में आया हूँ।<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />मुझे सिखा कि मैं तेरी इच्छा कैसे पूरी करूँ,</para>
  <para style="q2" vid="PSA 143:10">क्योंकि तू मेरा परमेश्‍वर है।</para>
  <para style="q1" vid="PSA 143:10">तेरा भला आत्मा मुझे सीधे मार्ग पर ले चले।<verse eid="PSA 143:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />हे यहोवा, अपने नाम के कारण मुझे जीवित रख;</para>
  <para style="q2" vid="PSA 143:11">तू जो धर्मी है, मुझे संकट से छुड़ा।<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />अपनी करुणा के अनुसार मेरे शत्रुओं का सत्यानाश कर,</para>
  <para style="q2" vid="PSA 143:12">और मेरे सब सतानेवालों का नाश कर डाल,</para>
  <para style="q1" vid="PSA 143:12">क्योंकि मैं तेरा दास हूँ।<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s1">राजा की प्रार्थना</para>
  <para style="b" />
  <para style="d">दाऊद का भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />यहोवा जो मेरी चट्टान है, धन्य है।</para>
  <para style="q2" vid="PSA 144:1">वह मेरे हाथों को लड़ना</para>
  <para style="q1" vid="PSA 144:1">और युद्ध करना सिखाता है।<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />वह मेरे लिए करुणामय</para>
  <para style="q2" vid="PSA 144:2">और मेरा दृढ़ गढ़ है,</para>
  <para style="q1" vid="PSA 144:2">वह मेरी चट्टान और मेरा छुड़ानेवाला है;</para>
  <para style="q2" vid="PSA 144:2">वह मेरी ढाल और मेरा शरणस्थान है,</para>
  <para style="q1" vid="PSA 144:2">जो मेरी प्रजा को मेरे अधीन कर देता है।<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />हे यहोवा, मनुष्य क्या है</para>
  <para style="q2" vid="PSA 144:3">कि तू उसकी सुधि लेता है?</para>
  <para style="q1" vid="PSA 144:3">या मनुष्य की संतान क्या है</para>
  <para style="q2" vid="PSA 144:3">कि तू उसकी कुछ चिंता करता है?<verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />मनुष्य तो श्‍वास के समान है,</para>
  <para style="q2" vid="PSA 144:4">उसके दिन ढलती हुई छाया के समान हैं।<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />हे यहोवा, अपने स्वर्ग को झुकाकर उतर आ;</para>
  <para style="q2" vid="PSA 144:5">पहाड़ों को छू</para>
  <para style="q1" vid="PSA 144:5">कि उनसे धुआँ निकले!<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />बिजली चमकाकर शत्रुओं को तितर-बितर कर दे,</para>
  <para style="q2" vid="PSA 144:6">और अपने तीर चलाकर उन्हें नाश कर दे।<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />ऊँचे स्थान से अपना हाथ बढ़ा;</para>
  <para style="q2" vid="PSA 144:7">मुझे महासागर में से उबार,</para>
  <para style="q1" vid="PSA 144:7">और परदेशियों के हाथ से छुड़ा ले।<verse eid="PSA 144:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8" />उनके मुँह से छल की बातें निकलती हैं,</para>
  <para style="q2" vid="PSA 144:8">और उनके दाहिने हाथ से धोखे के काम होते हैं।<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />हे परमेश्‍वर, मैं तेरे लिए एक नया गीत गाऊँगा;</para>
  <para style="q2" vid="PSA 144:9">मैं दस तारवाली सारंगी बजाकर तेरा भजन गाऊँगा।<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />तू राजाओं को विजय दिलाता है,</para>
  <para style="q2" vid="PSA 144:10">और अपने दास दाऊद को विनाशकारी तलवार से बचाता है।<verse eid="PSA 144:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11" />मुझे बचा, और उन परदेशियों के हाथ से छुड़ा</para>
  <para style="q2" vid="PSA 144:11">जिनके मुँह से छल की बातें निकलती हैं,</para>
  <para style="q1" vid="PSA 144:11">और उनके दाहिने हाथ से धोखे के काम होते हैं।<verse eid="PSA 144:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />हमारे पुत्र अपनी जवानी में विकसित पौधों के समान हों,</para>
  <para style="q2" vid="PSA 144:12">और हमारी पुत्रियाँ महल के तराशे गए खंभों के समान हों।<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />हमारे खत्ते हर प्रकार की उपज से भरे रहें,</para>
  <para style="q2" vid="PSA 144:13">और हमारी भेड़-बकरियाँ हमारे मैदानों में हज़ारों-हज़ार बच्‍चे जनें।<verse eid="PSA 144:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14" />हमारे बैल हट्टे-कट्टे हों;</para>
  <para style="q2" vid="PSA 144:14">हमारी शहरपनाह न टूटे,</para>
  <para style="q1" vid="PSA 144:14">हमें बंधुआई में जाना न पड़े,</para>
  <para style="q2" vid="PSA 144:14">और न हमारे चौकों पर रोना-पीटना हो।<verse eid="PSA 144:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />क्या ही धन्य है</para>
  <para style="q2" vid="PSA 144:15">वह प्रजा जो ऐसी सुख-समृद्धि की दशा में हो!</para>
  <para style="q1" vid="PSA 144:15">क्या ही धन्य है</para>
  <para style="q2" vid="PSA 144:15">वह प्रजा जिसका परमेश्‍वर यहोवा है!<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s1">परमेश्‍वर की महानता का स्तुतिगान</para>
  <para style="b" />
  <para style="d">स्तुति का गीत। दाऊद का भजन।</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />हे मेरे परमेश्‍वर, हे राजा,</para>
  <para style="q2" vid="PSA 145:1">मैं तेरा गुणगान करूँगा</para>
  <para style="q1" vid="PSA 145:1">और तेरे नाम को सदा-सर्वदा धन्य कहता रहूँगा।<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />मैं तुझे प्रतिदिन धन्य कहूँगा,</para>
  <para style="q2" vid="PSA 145:2">और तेरे नाम की स्तुति सदा-सर्वदा करता रहूँगा।<verse eid="PSA 145:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />यहोवा महान और अति स्तुति के योग्य है,</para>
  <para style="q2" vid="PSA 145:3">और उसकी महानता अगम्य है।<verse eid="PSA 145:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />एक पीढ़ी दूसरी पीढ़ी से तेरे कार्यों की प्रशंसा,</para>
  <para style="q2" vid="PSA 145:4">और तेरे पराक्रम का वर्णन करेगी।<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />मैं तेरे महिमामय ऐश्‍वर्य के प्रताप पर,</para>
  <para style="q2" vid="PSA 145:5">और तेरे अद्भुत कार्यों पर ध्यान करूँगा।<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />लोग तेरे अद्भुत कार्यों के सामर्थ्य की चर्चा करेंगे,</para>
  <para style="q2" vid="PSA 145:6">और मैं तेरी महानता का वर्णन करूँगा।<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />वे तेरी बड़ी भलाई को स्मरण करके उसकी चर्चा करेंगे,</para>
  <para style="q2" vid="PSA 145:7">और तेरी धार्मिकता का गुणगान करेंगे।<verse eid="PSA 145:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />यहोवा दयालु और अनुग्रहकारी,</para>
  <para style="q2" vid="PSA 145:8">क्रोध करने में धीमा और अति करुणामय है।<verse eid="PSA 145:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />यहोवा सब के लिए भला है,</para>
  <para style="q2" vid="PSA 145:9">और अपनी सारी सृष्‍टि पर दया करता है।<verse eid="PSA 145:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />हे यहोवा, तेरी सारी सृष्‍टि तेरा धन्यवाद करेगी,</para>
  <para style="q2" vid="PSA 145:10">और तेरे भक्‍त तुझे धन्य कहेंगे।<verse eid="PSA 145:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11" />वे तेरे राज्य की महिमा का वर्णन</para>
  <para style="q2" vid="PSA 145:11">और तेरे पराक्रम की चर्चा करेंगे,<verse eid="PSA 145:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12" />कि वे मनुष्यों पर तेरे पराक्रम,</para>
  <para style="q2" vid="PSA 145:12">और तेरे राज्य के महिमामय ऐश्‍वर्य को प्रकट करें।<verse eid="PSA 145:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13" />तेरा राज्य सदा-सर्वदा का राज्य है,</para>
  <para style="q2" vid="PSA 145:13">और तेरी प्रभुता पीढ़ी से पीढ़ी तक बनी रहती है।<note caller="+" style="f"><char style="fr" closed="false">145:13 </char><char style="ft" closed="false">कुछ हस्तलेखों में यहाँ “यहोवा अपने सब वचनों में विश्‍वासयोग्य, और अपने सब कार्यों में कृपालु है।” लिखा है।</char></note><verse eid="PSA 145:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14" />यहोवा सब गिरते हुओं को संभालता है,</para>
  <para style="q2" vid="PSA 145:14">और सब झुके हुओं को सीधा खड़ा करता है।<verse eid="PSA 145:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15" />सब प्राणियों की आँखें तेरी ओर लगी रहती हैं,</para>
  <para style="q2" vid="PSA 145:15">और तू उन्हें समय पर भोजन देता है।<verse eid="PSA 145:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16" />तू अपनी मुट्ठी खोलता,</para>
  <para style="q2" vid="PSA 145:16">और प्रत्येक प्राणी की इच्छा को पूरा करता है।<verse eid="PSA 145:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17" />यहोवा अपने सब मार्गों में धर्मी</para>
  <para style="q2" vid="PSA 145:17">और अपने सब कार्यों में दयालु है।<verse eid="PSA 145:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18" />यहोवा उन सब के निकट रहता है</para>
  <para style="q2" vid="PSA 145:18">जो उसे पुकारते हैं,</para>
  <para style="q1" vid="PSA 145:18">अर्थात् जो उसे सच्‍चाई से पुकारते हैं।<verse eid="PSA 145:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19" />वह अपने भय माननेवालों की इच्छा पूरी करता है,</para>
  <para style="q2" vid="PSA 145:19">और उनकी दुहाई सुनकर उन्हें बचाता है।<verse eid="PSA 145:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20" />यहोवा अपने सब प्रेमियों की तो रक्षा करता है,</para>
  <para style="q2" vid="PSA 145:20">परंतु सब दुष्‍टों का नाश करता है।<verse eid="PSA 145:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21" />मैं यहोवा की स्तुति करूँगा।</para>
  <para style="q2" vid="PSA 145:21">सब प्राणी भी उसके पवित्र नाम को सदा-सर्वदा धन्य कहते रहें।<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s1">करुणा से भरा परमेश्‍वर</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">146:1 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!</para>
  <para style="q2" vid="PSA 146:1">हे मेरे मन, यहोवा की स्तुति कर!<verse eid="PSA 146:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2" />मैं जीवन भर यहोवा की स्तुति करता रहूँगा;</para>
  <para style="q2" vid="PSA 146:2">जब तक मैं जीवित हूँ तब तक</para>
  <para style="q1" vid="PSA 146:2">अपने परमेश्‍वर का भजन गाता रहूँगा।<verse eid="PSA 146:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />तुम प्रधानों पर भरोसा न रखना।</para>
  <para style="q2" vid="PSA 146:3">तुम किसी मनुष्य पर भी भरोसा न रखना</para>
  <para style="q1" vid="PSA 146:3">क्योंकि उसमें उद्धार करने की शक्‍ति नहीं।<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />जब उसका प्राण निकलेगा तो वह मिट्टी में मिल जाएगा,</para>
  <para style="q2" vid="PSA 146:4">और उस दिन उसकी योजनाएँ भी नष्‍ट हो जाएँगी।<verse eid="PSA 146:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5" />क्या ही धन्य है वह,</para>
  <para style="q2" vid="PSA 146:5">जिसका सहायक याकूब का परमेश्‍वर है,</para>
  <para style="q1" vid="PSA 146:5">और जिसकी आशा अपने परमेश्‍वर यहोवा पर है।<verse eid="PSA 146:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6" />वह आकाश और पृथ्वी और समुद्र</para>
  <para style="q2" vid="PSA 146:6">और जो कुछ उनमें है,</para>
  <para style="q1" vid="PSA 146:6">सब का कर्ता है;</para>
  <para style="q2" vid="PSA 146:6">वह सदा विश्‍वासयोग्य रहता है।<verse eid="PSA 146:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />वह पिसे हुओं का न्याय करता है,</para>
  <para style="q2" vid="PSA 146:7">और भूखों को रोटी देता है।</para>
  <para style="q1" vid="PSA 146:7">यहोवा बंदियों को छुड़ाता है।<verse eid="PSA 146:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8" />यहोवा अंधों की आँखें खोलता है;</para>
  <para style="q2" vid="PSA 146:8">यहोवा झुके हुओं को सीधा खड़ा करता है;</para>
  <para style="q1" vid="PSA 146:8">यहोवा धर्मियों से प्रेम रखता है।<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />यहोवा परदेशियों की रक्षा करता है,</para>
  <para style="q2" vid="PSA 146:9">और अनाथों और विधवाओं को संभालता है;</para>
  <para style="q1" vid="PSA 146:9">परंतु दुष्‍टों के मार्ग को टेढ़ा-मेढ़ा करता है।<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />यहोवा, सदा के लिए राज्य करता रहेगा;</para>
  <para style="q2" vid="PSA 146:10">हे सिय्योन, तेरा परमेश्‍वर पीढ़ी से पीढ़ी तक राज्य करता रहेगा।</para>
  <para style="q1" vid="PSA 146:10">याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">146:10 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s1">परमेश्‍वर द्वारा इस्राएल की पुनर्स्थापना</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">147:1 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!</para>
  <para style="q2" vid="PSA 147:1">अपने परमेश्‍वर का भजन गाना अच्छा है;</para>
  <para style="q1" vid="PSA 147:1">उसकी स्तुति करना मनभावना और उचित है।<verse eid="PSA 147:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />यहोवा यरूशलेम को बना रहा है;</para>
  <para style="q2" vid="PSA 147:2">वह इस्राएल के निकाले हुओं को इकट्ठा कर रहा है।<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />वह टूटे मनवालों को चंगा करता</para>
  <para style="q2" vid="PSA 147:3">और उनके घावों पर मरहम-पट्टी करता है।<verse eid="PSA 147:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4" />वह तारों की संख्या निर्धारित करता,</para>
  <para style="q2" vid="PSA 147:4">और उनमें से एक-एक का नाम रखता है।<verse eid="PSA 147:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5" />हमारा प्रभु महान और अति सामर्थी है;</para>
  <para style="q2" vid="PSA 147:5">उसकी बुद्धि अपरंपार है।<verse eid="PSA 147:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6" />यहोवा नम्र लोगों को संभालता है,</para>
  <para style="q2" vid="PSA 147:6">परंतु दुष्‍टों को भूमि पर गिरा देता है।<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />धन्यवाद करते हुए यहोवा का गीत गाओ;</para>
  <para style="q2" vid="PSA 147:7">वीणा बजाते हुए हमारे परमेश्‍वर का भजन गाओ।<verse eid="PSA 147:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />वह आकाश को मेघों से भर देता है,</para>
  <para style="q2" vid="PSA 147:8">और पृथ्वी के लिए वर्षा की तैयारी करता है,</para>
  <para style="q1" vid="PSA 147:8">और पहाड़ों पर घास उगाता है।<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />वह पशुओं को और कौओं के बच्‍चों को जो पुकारते हैं,</para>
  <para style="q2" vid="PSA 147:9">आहार देता है।<verse eid="PSA 147:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10" />वह घोड़े के बल से प्रसन्‍न‍ नहीं होता,</para>
  <para style="q2" vid="PSA 147:10">और न ही मनुष्य के पैरों से आनंदित होता है।<verse eid="PSA 147:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11" />यहोवा अपने भय माननेवालों से प्रसन्‍न होता है,</para>
  <para style="q2" vid="PSA 147:11">अर्थात् उनसे जो उसकी करुणा की आशा लगाए रहते हैं।<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12" />हे यरूशलेम, यहोवा की प्रशंसा कर!</para>
  <para style="q2" vid="PSA 147:12">हे सिय्योन, अपने परमेश्‍वर की स्तुति कर!<verse eid="PSA 147:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13" />क्योंकि उसने तेरे फाटकों को छड़ों से दृढ़ किया है,</para>
  <para style="q2" vid="PSA 147:13">और तेरे भीतर तेरे बच्‍चों को आशिष दी है।<verse eid="PSA 147:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14" />वह तेरे प्रदेश में शांति बनाए रखता है;</para>
  <para style="q2" vid="PSA 147:14">वह तुझे उत्तम से उत्तम गेहूँ से तृप्‍त करता है।<verse eid="PSA 147:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15" />वह पृथ्वी पर अपनी आज्ञा भेजता है;</para>
  <para style="q2" vid="PSA 147:15">उसका वचन बहुत तेज़ी से दौड़ता है।<verse eid="PSA 147:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16" />वह ऊन के समान हिम गिराता,</para>
  <para style="q2" vid="PSA 147:16">और राख के समान पाला बिखेरता है।<verse eid="PSA 147:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17" />वह बर्फ के टुकड़े गिराता है;</para>
  <para style="q2" vid="PSA 147:17">उसकी ठंड को कौन सह सकता है?<verse eid="PSA 147:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18" />वह अपना वचन भेजकर उन्हें गलाता है;</para>
  <para style="q2" vid="PSA 147:18">वह हवा चलाता है,</para>
  <para style="q1" vid="PSA 147:18">और जल बहने लगता है।<verse eid="PSA 147:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19" />वह याकूब को अपने वचन,</para>
  <para style="q2" vid="PSA 147:19">और इस्राएल को अपनी विधियाँ और नियम बताता है।<verse eid="PSA 147:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20" />उसने किसी और जाति के साथ ऐसा विशेष व्यवहार नहीं किया;</para>
  <para style="q2" vid="PSA 147:20">और अन्य जातियों ने उसके नियमों को नहीं जाना।</para>
  <para style="q1" vid="PSA 147:20">याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">147:20 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s1">सृष्‍टि द्वारा परमेश्‍वर का स्तुतिगान</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">148:1 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!</para>
  <para style="q2" vid="PSA 148:1">आकाश से यहोवा की स्तुति करो!</para>
  <para style="q1" vid="PSA 148:1">ऊँचे स्थानों में उसकी स्तुति करो!<verse eid="PSA 148:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />उसके सब दूतो, उसकी स्तुति करो!</para>
  <para style="q2" vid="PSA 148:2">उसकी सब सेनाओ, उसकी स्तुति करो!<verse eid="PSA 148:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />हे सूर्य और चंद्रमा, उसकी स्तुति करो!</para>
  <para style="q2" vid="PSA 148:3">हे सब चमकते तारो, उसकी स्तुति करो!<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />हे सब से ऊँचे आकाश,</para>
  <para style="q2" vid="PSA 148:4">और हे आकाश से ऊपर के जल,</para>
  <para style="q1" vid="PSA 148:4">उसकी स्तुति करो!<verse eid="PSA 148:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />वे सब यहोवा के नाम की स्तुति करें,</para>
  <para style="q2" vid="PSA 148:5">क्योंकि उसी ने आज्ञा दी और वे सृजे गए।<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />उसने उन्हें सदा-सर्वदा के लिए स्थिर किया है;</para>
  <para style="q2" vid="PSA 148:6">उसने ऐसी विधि ठहराई है जो कभी न टलेगी।<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />पृथ्वी पर से यहोवा की स्तुति करो!</para>
  <para style="q2" vid="PSA 148:7">हे जल-जंतुओ और सब गहरे सागरो,<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />हे अग्‍नि और ओलो, हे हिम और मेघो,</para>
  <para style="q2" vid="PSA 148:8">हे उसका वचन माननेवाली प्रचंड आँधियो,<verse eid="PSA 148:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />हे पर्वतो और पहाड़ियो,</para>
  <para style="q2" vid="PSA 148:9">हे फलवंत वृक्षो और देवदार के सब वृक्षो,<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />हे वनपशुओ और सब घरेलू पशुओ,</para>
  <para style="q2" vid="PSA 148:10">हे रेंगनेवाले जंतुओ और हे उड़नेवाले पक्षियो,<verse eid="PSA 148:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />हे पृथ्वी के राजाओ और राज्य-राज्य के सब लोगो,</para>
  <para style="q2" vid="PSA 148:11">हे अधिपतियो और पृथ्वी के सब न्यायियो,<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />हे जवानो और कुमारियो,</para>
  <para style="q2" vid="PSA 148:12">हे वृद्धो और बच्‍चो, प्रभु की स्तुति करो!<verse eid="PSA 148:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />ये सब यहोवा के नाम की स्तुति करें,</para>
  <para style="q2" vid="PSA 148:13">क्योंकि केवल उसी का नाम महान है;</para>
  <para style="q1" vid="PSA 148:13">उसका वैभव पृथ्वी और आकाश से ऊँचा है।<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />उसने अपनी प्रजा के लिए एक सींग ऊँचा किया है;</para>
  <para style="q2" vid="PSA 148:14">यह उसके सब भक्‍तों अर्थात् इस्राएलियों के लिए,</para>
  <para style="q1" vid="PSA 148:14">और उसके निकट रहनेवाली प्रजा के लिए स्तुति करने का विषय है।</para>
  <para style="q2" vid="PSA 148:14">याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">148:14 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s1">परमेश्‍वर की विजय का स्तुतिगान</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">149:1 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!</para>
  <para style="q2" vid="PSA 149:1">यहोवा के लिए एक नया गीत गाओ,</para>
  <para style="q1" vid="PSA 149:1">और भक्‍तों की सभा में उसका स्तुतिगान करो।<verse eid="PSA 149:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />इस्राएल अपने कर्ता के कारण आनंदित हो;</para>
  <para style="q2" vid="PSA 149:2">सिय्योन के निवासी अपने राजा के कारण मगन हों।<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />वे नाचते हुए उसके नाम की स्तुति करें,</para>
  <para style="q2" vid="PSA 149:3">और डफ और वीणा बजाते हुए उसका भजन गाएँ।<verse eid="PSA 149:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />क्योंकि यहोवा अपनी प्रजा से प्रसन्‍न‍ रहता है;</para>
  <para style="q2" vid="PSA 149:4">वह नम्र लोगों को उद्धार से सुशोभित करेगा।<verse eid="PSA 149:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />भक्‍त लोग महिमा में प्रफुल्लित हों,</para>
  <para style="q2" vid="PSA 149:5">और अपने बिछौनों पर भी आनंद के गीत गाएँ।<verse eid="PSA 149:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />उनके कंठ परमेश्‍वर का गुणगान करें,</para>
  <para style="q2" vid="PSA 149:6">और उनके हाथों में दोधारी तलवारें रहें,<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />कि वे जाति-जाति के लोगों से बदला लें,</para>
  <para style="q2" vid="PSA 149:7">और राज्य-राज्य के लोगों को दंड दें,<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />और उनके राजाओं को ज़ंजीरों से</para>
  <para style="q2" vid="PSA 149:8">और उनके प्रतिष्‍ठित पुरुषों को लोहे की बेड़ियों से जकड़कर रखें,<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />और उन्हें ठहराया हुआ दंड दें;</para>
  <para style="q2" vid="PSA 149:9">यही उसके सब भक्‍तों के लिए सम्मान की बात है।</para>
  <para style="q1" vid="PSA 149:9">याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">149:9 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s1">परमेश्‍वर की स्तुति</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">150:1 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!</para>
  <para style="q2" vid="PSA 150:1">परमेश्‍वर के पवित्रस्थान में उसकी स्तुति करो!</para>
  <para style="q1" vid="PSA 150:1">उसके वैभवशाली आकाशमंडल में उसकी स्तुति करो!<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />उसके पराक्रम के कार्यों के कारण उसकी स्तुति करो!</para>
  <para style="q2" vid="PSA 150:2">उसकी अत्यंत महानता के अनुसार उसकी स्तुति करो!<verse eid="PSA 150:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />तुरही फूँकते हुए उसकी स्तुति करो!</para>
  <para style="q2" vid="PSA 150:3">सारंगी और वीणा बजाते हुए उसकी स्तुति करो!<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />डफ बजाते और नाचते हुए उसकी स्तुति करो!</para>
  <para style="q2" vid="PSA 150:4">तारवाले वाद्य और बाँसुरी बजाते हुए उसकी स्तुति करो!<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />झाँझ बजाते हुए उसकी स्तुति करो!</para>
  <para style="q2" vid="PSA 150:5">झाँझ की ऊँची आवाज़ के साथ उसकी स्तुति करो!<verse eid="PSA 150:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />सब प्राणी याह की स्तुति करें।</para>
  <para style="q2" vid="PSA 150:6">याह की स्तुति करो<note caller="+" style="f"><char style="fr" closed="false">150:6 </char><char style="ft" closed="false">इब्रानी में “हल्लिलूयाह”</char></note>!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>