<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">HINDI STANDARD BIBLE©, Copyright © 2024 by Global Bible Initiative [Export Date: April 10, 2024]</book>
  <para style="h">Proverbs</para>
  <para style="mt1">Proverbs</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s1">नीतिवचन का उद्देश्य</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />दाऊद के पुत्र, इस्राएल के राजा सुलैमान के नीतिवचन :<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />इनके द्वारा मनुष्य बुद्धि और शिक्षा को प्राप्‍‍त करे,</para>
  <para style="q2" vid="PRO 1:2">और समझ की बातों को पहचाने;<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />और व्यवहार-कुशलता,</para>
  <para style="q2" vid="PRO 1:3">धार्मिकता, न्याय, और निष्पक्षता की शिक्षा प्राप्‍त करे।<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />इनके द्वारा नासमझ लोगों को समझ,</para>
  <para style="q2" vid="PRO 1:4">और जवान को ज्ञान और समझदारी मिले;<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />बुद्धिमान इन्हें सुनकर अपना ज्ञान बढ़ाए,</para>
  <para style="q2" vid="PRO 1:5">और समझदार व्यक्‍ति मार्गदर्शन प्राप्‍त करे,<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />ताकि वे नीतिवचन और दृष्‍टांत को,</para>
  <para style="q2" vid="PRO 1:6">तथा बुद्धिमानों के वचन और उनकी पहेलियों के अर्थ को समझें।<verse eid="PRO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />यहोवा का भय मानना बुद्धि का मूल है;</para>
  <para style="q2" vid="PRO 1:7">मूर्ख लोग ही बुद्धि और शिक्षा को तुच्छ समझते हैं।<verse eid="PRO 1:7" /></para>
  <para style="s1">युवकों को हिंसा से दूर रहने की सलाह</para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />हे मेरे पुत्र, अपने पिता की शिक्षा को ध्यान से सुन,</para>
  <para style="q2" vid="PRO 1:8">और अपनी माता की सीख को न त्याग,<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />क्योंकि वे तेरे सिर के लिए शोभायमान मुकुट,</para>
  <para style="q2" vid="PRO 1:9">और तेरे गले का हार हैं।<verse eid="PRO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />हे मेरे पुत्र, यदि पापी तुझे फुसलाएँ,</para>
  <para style="q2" vid="PRO 1:10">तो उनकी न मानना।<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />यदि वे कहें, “हमारे साथ चल कि</para>
  <para style="q2" vid="PRO 1:11">हम हत्या करने के लिए घात लगाएँ;</para>
  <para style="q3" vid="PRO 1:11">चल हम निर्दोषों पर वार करने की घात में रहें,<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />चल, हम अधोलोक के समान उन्हें जीवित ही,</para>
  <para style="q2" vid="PRO 1:12">अर्थात् कब्र में जानेवालों के समान,</para>
  <para style="q3" vid="PRO 1:12">पूरा का पूरा निगल जाएँ।<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />हमें सब प्रकार की अनमोल वस्तुएँ प्राप्‍त होंगी,</para>
  <para style="q2" vid="PRO 1:13">और हम अपने घरों को लूट से भर लेंगे;<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />तू हमारे साथ मिल जा,</para>
  <para style="q2" vid="PRO 1:14">हम सब का एक ही बटुआ होगा।”<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />तो, हे मेरे पुत्र, तू न तो मार्ग में उनके साथ चलना,</para>
  <para style="q2" vid="PRO 1:15">और न ही उनकी राह में अपने पैर रखना,<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />क्योंकि उनके पैर बुराई करने को दौड़ते हैं,</para>
  <para style="q2" vid="PRO 1:16">और वे हत्या करने को तत्पर रहते हैं।<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />जब पक्षी देख रहा हो,</para>
  <para style="q2" vid="PRO 1:17">तब जाल फैलाना व्यर्थ होता है।<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />ये तो अपनी ही हत्या के लिए घात लगाते हैं,</para>
  <para style="q2" vid="PRO 1:18">और अपने ही प्राणों की घात में रहते हैं।<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />अनुचित रीति से कमाई करनेवाले सब लोभियों की चाल ऐसी ही होती है,</para>
  <para style="q2" vid="PRO 1:19">और यही उनके प्राण के नष्‍ट होने का कारण होता है।<verse eid="PRO 1:19" /></para>
  <para style="s1">बुद्धि की पुकार</para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />बुद्धि सड़क पर ज़ोर-ज़ोर से बुलाती है,</para>
  <para style="q2" vid="PRO 1:20">चौकों पर अपनी आवाज़ ऊँची करती है;<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />वह भीड़ भरे मार्गों पर ज़ोर से पुकारती है,</para>
  <para style="q2" vid="PRO 1:21">नगर के फाटकों पर वह अपनी बातें कहती है :<verse eid="PRO 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />“हे नासमझ लोगो, तुम कब तक नासमझी से प्रीति रखोगे?</para>
  <para style="q2" vid="PRO 1:22">ठट्ठा करनेवाले कब तक ठट्ठा करने से प्रसन्‍न‍ रहेंगे,</para>
  <para style="q1" vid="PRO 1:22">और मूर्ख कब तक ज्ञान से बैर रखेंगे?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />यदि तुम मेरी ताड़ना पर ध्यान दो,</para>
  <para style="q2" vid="PRO 1:23">तो मैं अपनी आत्मा तुम पर उंडेल दूँगी</para>
  <para style="q3" vid="PRO 1:23">और तुम्हें अपने वचन बताऊँगी।<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />मैंने तो पुकारा परंतु तुमने सुनने से इनकार किया,</para>
  <para style="q2" vid="PRO 1:24">मैंने हाथ भी बढ़ाया परंतु किसी ने ध्यान न दिया,<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />बल्कि तुमने मेरी हर सम्मति को अनसुना किया,</para>
  <para style="q2" vid="PRO 1:25">और मेरी ताड़ना को न चाहा;<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />इसलिए जब तुम पर विपत्ति आएगी तो मैं हँसूँगी;</para>
  <para style="q2" vid="PRO 1:26">और जब तुम पर भय छाएगा,<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />बल्कि जब आँधी के समान तुम पर भय आ पड़ेगा,</para>
  <para style="q2" vid="PRO 1:27">और विपत्ति बवंडर के समान आ पड़ेगी,</para>
  <para style="q1" vid="PRO 1:27">और तुम संकट और क्लेश में आ पड़ोगे,</para>
  <para style="q2" vid="PRO 1:27">तब मैं तुम्हारा ठट्ठा करूँगी।<verse eid="PRO 1:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />उस समय वे मुझे पुकारेंगे, पर मैं न सुनूँगी;</para>
  <para style="q2" vid="PRO 1:28">वे मुझे यत्‍न से ढूँढ़ेंगे, पर मुझे न पाएँगे।<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />क्योंकि उन्होंने ज्ञान से बैर रखा,</para>
  <para style="q2" vid="PRO 1:29">और यहोवा का भय मानना न चाहा।<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />उन्होंने मेरी सम्मति न चाही,</para>
  <para style="q2" vid="PRO 1:30">बल्कि मेरी हर ताड़ना को तुच्छ समझा।<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />इसलिए वे अपनी ही करनी का फल भोगेंगे,</para>
  <para style="q2" vid="PRO 1:31">और अपनी ही युक्‍तियों के फल से अघा जाएँगे।<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />क्योंकि नासमझ लोगों का भटक जाना</para>
  <para style="q2" vid="PRO 1:32">उनकी मृत्यु का कारण होगा,</para>
  <para style="q1" vid="PRO 1:32">और मूर्खों का निश्‍चिंत रहना</para>
  <para style="q2" vid="PRO 1:32">उनके नाश का कारण होगा।<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />परंतु जो मेरी सुनता है, वह सुरक्षित वास करेगा,</para>
  <para style="q2" vid="PRO 1:33">और विपत्ति से बिना डरे सुख-चैन से रहेगा।”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">बुद्धि का नैतिक लाभ</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />हे मेरे पुत्र, यदि तू मेरे वचनों को ग्रहण करे,</para>
  <para style="q2" vid="PRO 2:1">और मेरी आज्ञाओं को अपने हृदय में रखे,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />और अपना कान बुद्धि की बातों पर,</para>
  <para style="q2" vid="PRO 2:2">तथा अपना मन समझ की बातों पर लगाए,<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />और यदि तू समझ के लिए पुकारे,</para>
  <para style="q2" vid="PRO 2:3">और बुद्धि के लिए चिल्लाए,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />और उसे चाँदी के समान ढूँढ़े,</para>
  <para style="q2" vid="PRO 2:4">और छिपे हुए धन के समान उसकी खोज में लगा रहे,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />तो तू यहोवा के भय को समझेगा,</para>
  <para style="q2" vid="PRO 2:5">और तुझे परमेश्‍वर का ज्ञान प्राप्‍त होगा।<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />क्योंकि बुद्धि यहोवा ही देता है;</para>
  <para style="q2" vid="PRO 2:6">उसी के मुँह से ज्ञान और समझ की बातें निकलती हैं।<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />वह सीधे लोगों के लिए खरी बुद्धि का भंडार रखता है;</para>
  <para style="q2" vid="PRO 2:7">जो खराई से चलते हैं, उनके लिए वह ढाल है।<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />वह न्याय के पथों की रक्षा करता है,</para>
  <para style="q2" vid="PRO 2:8">और अपने भक्‍तों के मार्ग की चौकसी करता है।<verse eid="PRO 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />तब तू धार्मिकता और न्याय और निष्पक्षता को,</para>
  <para style="q2" vid="PRO 2:9">अर्थात् हर भली चाल को समझ सकेगा।<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />क्योंकि बुद्धि तेरे हृदय में प्रवेश करेगी,</para>
  <para style="q2" vid="PRO 2:10">और ज्ञान तेरे प्राण को सुख प्रदान करेगा;<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />विवेक तेरी चौकसी करेगा,</para>
  <para style="q2" vid="PRO 2:11">और समझ तेरी रक्षा करेगी;<verse eid="PRO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />ताकि तुझे दुष्‍ट के मार्ग से,</para>
  <para style="q2" vid="PRO 2:12">अर्थात् कुटिल बातें कहनेवाले उन मनुष्यों से बचाए,<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />जो खराई के मार्ग को छोड़कर</para>
  <para style="q2" vid="PRO 2:13">अंधकार के मार्ग पर चलते हैं;<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />जो बुराई करने से आनंदित होते हैं,</para>
  <para style="q2" vid="PRO 2:14">और दुष्‍टता के कुटिल कार्यों में मगन रहते हैं,<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />जिनका चाल-चलन टेढ़ा-मेढ़ा</para>
  <para style="q2" vid="PRO 2:15">और जिनके मार्ग बिगड़े हुए हैं।<verse eid="PRO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />तब तू पराई स्‍त्री से भी बचा रहेगा,</para>
  <para style="q2" vid="PRO 2:16">अर्थात् उस चरित्रहीन स्‍त्री से जो चिकनी-चुपड़ी बातें बोलती है,<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />और अपनी जवानी के साथी को छोड़ देती है,</para>
  <para style="q2" vid="PRO 2:17">तथा अपने परमेश्‍वर की वाचा को भूल जाती है।<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />उसका घर नीचे मृत्यु की ओर,</para>
  <para style="q2" vid="PRO 2:18">और उसके मार्ग मरे हुओं के बीच ले जाते हैं;<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />जो उसके पास जाते हैं, वे लौटकर नहीं आते</para>
  <para style="q2" vid="PRO 2:19">और न ही जीवन का मार्ग पाते हैं।<verse eid="PRO 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />इसलिए तू भले लोगों के मार्ग में चल,</para>
  <para style="q2" vid="PRO 2:20">और धर्मियों के पथ पर बना रह।<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />सीधे लोग तो देश में बसे रहेंगे,</para>
  <para style="q2" vid="PRO 2:21">और जो खरे हैं उसमें बने रहेंगे।<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />परंतु दुष्‍ट उस देश से नष्‍ट कर दिए जाएँगे,</para>
  <para style="q2" vid="PRO 2:22">और विश्‍वासघाती उसमें से उखाड़ फेंके जाएँगे।<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">युवकों को यहोवा पर भरोसा रखने की सलाह</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />हे मेरे पुत्र, मेरी शिक्षा को न भूलना,</para>
  <para style="q2" vid="PRO 3:1">पर मेरी आज्ञाओं को अपने हृदय में बसाए रखना,<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />क्योंकि उनसे तेरी आयु बढ़ेगी,</para>
  <para style="q2" vid="PRO 3:2">और तेरा अधिक से अधिक कल्याण होगा।<verse eid="PRO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />करुणा और सच्‍चाई तुझसे अलग न हों;</para>
  <para style="q2" vid="PRO 3:3">बल्कि तू उन्हें अपने गले का हार बना,</para>
  <para style="q3" vid="PRO 3:3">और उन्हें अपनी हृदयरूपी पटिया पर लिख ले।<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />तब तू परमेश्‍वर और मनुष्य दोनों की दृष्‍टि में</para>
  <para style="q2" vid="PRO 3:4">कृपा और प्रतिष्‍ठा प्राप्‍त करेगा।<verse eid="PRO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />तू संपूर्ण मन से यहोवा पर भरोसा रखना,</para>
  <para style="q2" vid="PRO 3:5">और अपनी समझ का सहारा न लेना।<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />अपने सब कार्यों में तू यहोवा को स्मरण करना,</para>
  <para style="q2" vid="PRO 3:6">तब वह तेरे लिए सीधा मार्ग निकालेगा।<verse eid="PRO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />तू अपनी दृष्‍टि में बुद्धिमान न बन;</para>
  <para style="q2" vid="PRO 3:7">यहोवा का भय मान,</para>
  <para style="q3" vid="PRO 3:7">और बुराई से दूर रह।<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />ऐसा करने से तेरा शरीर स्वस्थ रहेगा,</para>
  <para style="q2" vid="PRO 3:8">और तेरी हड्डियाँ पुष्‍ट रहेंगी।<verse eid="PRO 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />अपनी संपत्ति के द्वारा,</para>
  <para style="q2" vid="PRO 3:9">और अपनी सारी उपज का पहला भाग देकर</para>
  <para style="q3" vid="PRO 3:9">यहोवा का आदर करना।<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />तब तेरे खत्ते भरे-पूरे रहेंगे,</para>
  <para style="q2" vid="PRO 3:10">और तेरे रसकुंड नए दाखरस से उमड़ते रहेंगे।<verse eid="PRO 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />हे मेरे पुत्र, यहोवा की शिक्षा को तुच्छ न जानना,</para>
  <para style="q2" vid="PRO 3:11">और न उसकी डाँट का बुरा मानना।<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />क्योंकि यहोवा जिससे प्रेम रखता है उसे डाँटता है,</para>
  <para style="q2" vid="PRO 3:12">जैसे पिता उस बेटे को जिसे वह अधिक चाहता है।<verse eid="PRO 3:12" /></para>
  <para style="s1">बुद्धि आनंद प्रदान करती है</para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />क्या ही धन्य है वह मनुष्य जो बुद्धि पाता है,</para>
  <para style="q2" vid="PRO 3:13">और वह मनुष्य जो समझ प्राप्‍त करता है;<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />क्योंकि बुद्धि को प्राप्‍त करना चाँदी को प्राप्‍त करने से उत्तम है,</para>
  <para style="q2" vid="PRO 3:14">और उसका लाभ शुद्ध सोने के लाभ से भी बढ़कर है।<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />वह रत्‍नों से अधिक मूल्यवान है,</para>
  <para style="q2" vid="PRO 3:15">और इसकी तुलना किसी भी उस वस्तु से नहीं की जा सकती</para>
  <para style="q3" vid="PRO 3:15">जिसकी तू लालसा करता है।<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />उसके दाहिने हाथ में दीर्घायु,</para>
  <para style="q2" vid="PRO 3:16">और उसके बाएँ हाथ में धन और सम्मान हैं।<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />उसके मार्ग मनोहर हैं,</para>
  <para style="q2" vid="PRO 3:17">और उसके सारे पथ शांति के हैं।<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />जो उसे ग्रहण करते हैं,</para>
  <para style="q2" vid="PRO 3:18">उनके लिए वह जीवन का वृक्ष है;</para>
  <para style="q1" vid="PRO 3:18">और जो उसे थामे रहते हैं,</para>
  <para style="q2" vid="PRO 3:18">वे धन्य हैं।<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />यहोवा ने बुद्धि से पृथ्वी की नींव डाली,</para>
  <para style="q2" vid="PRO 3:19">और समझ के द्वारा आकाश को स्थिर किया।<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />उसी के ज्ञान से गहरे सागर फूट निकले,</para>
  <para style="q2" vid="PRO 3:20">और आकाश से ओस टपकती है।<verse eid="PRO 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />हे मेरे पुत्र, खरी बुद्धि और विवेक की रक्षा कर;</para>
  <para style="q2" vid="PRO 3:21">ये बातें तेरी दृष्‍टि से ओझल न हों,<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />तब इनसे तुझे जीवन मिलेगा,</para>
  <para style="q2" vid="PRO 3:22">और ये तेरे गले का हार बनेंगे।<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />तब तू अपने मार्ग पर निडर होकर चलेगा,</para>
  <para style="q2" vid="PRO 3:23">और तेरे पैर में ठोकर न लगेगी।<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />जब तू लेटेगा, तो भयभीत न होगा;</para>
  <para style="q2" vid="PRO 3:24">जब तू लेटेगा, तो तुझे मीठी नींद आएगी।<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />अचानक आनेवाले खतरे से न डरना,</para>
  <para style="q2" vid="PRO 3:25">और न उस विनाश से</para>
  <para style="q3" vid="PRO 3:25">जो दुष्‍टों पर आ पड़ता है;<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />क्योंकि यहोवा तेरा सहारा बनेगा,</para>
  <para style="q2" vid="PRO 3:26">और तेरे पैर को फंदे में फँसने न देगा।<verse eid="PRO 3:26" /></para>
  <para style="s1">दूसरों के साथ अच्छा व्यवहार करो</para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />यदि तुझमें शक्‍ति हो तो जिनका भला करना चाहिए,</para>
  <para style="q2" vid="PRO 3:27">उनका भला करने से न रुकना।<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />यदि तेरे पास देने को कुछ हो,</para>
  <para style="q2" vid="PRO 3:28">तो अपने पड़ोसी से यह न कहना,</para>
  <para style="q1" vid="PRO 3:28">“जा, कल आना,</para>
  <para style="q2" vid="PRO 3:28">तब मैं तुझे दूँगा।”<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />जब तेरा पड़ोसी बड़े भरोसे के साथ तेरे पड़ोस में रहता है,</para>
  <para style="q2" vid="PRO 3:29">तब उसके विरुद्ध बुरी योजना न बनाना।<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />जिस मनुष्य ने तुझे हानि न पहुँचाई हो,</para>
  <para style="q2" vid="PRO 3:30">उससे अकारण झगड़ा न करना।<verse eid="PRO 3:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />उपद्रवी मनुष्य से ईर्ष्या न करना,</para>
  <para style="q2" vid="PRO 3:31">और न ही उसकी सी चाल चलना।<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />क्योंकि यहोवा कुटिल मनुष्य से घृणा करता है,</para>
  <para style="q2" vid="PRO 3:32">परंतु सीधे लोगों पर वह अपने भेद प्रकट करता है।<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />दुष्‍ट के घर पर यहोवा का शाप रहता है,</para>
  <para style="q2" vid="PRO 3:33">परंतु धर्मियों के निवास स्थान पर उसकी आशिष रहती है।<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />ठट्ठा करनेवालों को तो वह ठट्ठों में उड़ाता है,</para>
  <para style="q2" vid="PRO 3:34">परंतु दीनों पर अनुग्रह करता है।<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />बुद्धिमान सम्मान प्राप्‍त करेंगे,</para>
  <para style="q2" vid="PRO 3:35">परंतु मूर्खों का अपमान होता रहेगा।<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">बुद्धि के लाभ</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />हे मेरे पुत्रो, पिता की शिक्षा सुनो,</para>
  <para style="q2" vid="PRO 4:1">और समझ प्राप्‍त करने में मन लगाओ।<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />क्योंकि मैं तुम्हें उत्तम शिक्षा देता हूँ;</para>
  <para style="q2" vid="PRO 4:2">मेरी शिक्षा को त्याग न देना।<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />जब मैं अपने पिता के सामने छोटा,</para>
  <para style="q2" vid="PRO 4:3">और अपनी माता का अकेला दुलारा था,<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />तब मेरे पिता ने मुझे यह कहकर सिखाया,</para>
  <para style="q2" vid="PRO 4:4">“तेरा मन मेरे वचनों पर लगा रहे।</para>
  <para style="q1" vid="PRO 4:4">मेरी आज्ञाओं का पालन कर,</para>
  <para style="q2" vid="PRO 4:4">तो तू जीवित रहेगा।<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />बुद्धि को प्राप्‍त कर,</para>
  <para style="q2" vid="PRO 4:5">समझ को भी प्राप्‍त कर;</para>
  <para style="q1" vid="PRO 4:5">मेरे मुँह के वचनों को भूल न जाना</para>
  <para style="q2" vid="PRO 4:5">और न उनसे विमुख होना।<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />बुद्धि को न त्याग,</para>
  <para style="q2" vid="PRO 4:6">वह तेरी रक्षा करेगी;</para>
  <para style="q1" vid="PRO 4:6">उससे प्रीति रख,</para>
  <para style="q2" vid="PRO 4:6">वह तेरी चौकसी करेगी।<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />बुद्धि श्रेष्‍ठ है,</para>
  <para style="q2" vid="PRO 4:7">इसलिए उसे प्राप्‍त कर;</para>
  <para style="q1" vid="PRO 4:7">तू जो कुछ भी प्राप्‍त करे,</para>
  <para style="q2" vid="PRO 4:7">उसके साथ-साथ समझ को भी प्राप्‍त कर।<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />उसे श्रेष्‍ठ जान,</para>
  <para style="q2" vid="PRO 4:8">और वह तुझे बढ़ाएगी;</para>
  <para style="q1" vid="PRO 4:8">यदि तू उसे गले लगाए,</para>
  <para style="q2" vid="PRO 4:8">तो वह तेरा सम्मान करेगी।<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />वह तेरे सिर को मनोहर आभूषण से सजाएगी;</para>
  <para style="q2" vid="PRO 4:9">और तुझे शोभायमान मुकुट प्रदान करेगी।”<verse eid="PRO 4:9" /></para>
  <para style="s1">जीवन के दो मार्ग</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />हे मेरे पुत्र, सुन और मेरी बातें ग्रहण कर,</para>
  <para style="q2" vid="PRO 4:10">तब तू बहुत वर्षों तक जीवित रहेगा।<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />मैंने तुझे बुद्धि का मार्ग बताया है;</para>
  <para style="q2" vid="PRO 4:11">और सीधाई के पथों पर तुझे चलाया है।<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />जब तू चलेगा तो तेरे कदमों के सामने बाधा न आएगी,</para>
  <para style="q2" vid="PRO 4:12">और जब तू दौड़ेगा, तो ठोकर न खाएगा।<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />शिक्षा को थामे रह,</para>
  <para style="q2" vid="PRO 4:13">उसे छोड़ न दे;</para>
  <para style="q1" vid="PRO 4:13">उसकी रक्षा कर,</para>
  <para style="q2" vid="PRO 4:13">क्योंकि वही तेरा जीवन है।<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />दुष्‍टों की राह में पैर न रखना,</para>
  <para style="q2" vid="PRO 4:14">और न बुरे लोगों के मार्ग पर चलना।<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />उससे दूर रह,</para>
  <para style="q2" vid="PRO 4:15">उसके पास से भी न जाना,</para>
  <para style="q3" vid="PRO 4:15">उससे कतराकर आगे बढ़ जा।<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />क्योंकि जब तक दुष्‍ट लोग बुराई न करें,</para>
  <para style="q2" vid="PRO 4:16">वे सो नहीं सकते;</para>
  <para style="q1" vid="PRO 4:16">और जब तक वे किसी को ठोकर न खिलाएँ,</para>
  <para style="q2" vid="PRO 4:16">उन्हें नींद नहीं आती।<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />वे तो दुष्‍टता की रोटी खाते,</para>
  <para style="q2" vid="PRO 4:17">और हिंसा का दाखमधु पीते हैं।<verse eid="PRO 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />धर्मियों का मार्ग उस भोर के प्रकाश के समान होता है,</para>
  <para style="q2" vid="PRO 4:18">जो दोपहर तक अधिकाधिक बढ़ता जाता है।<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />परंतु दुष्‍टों का मार्ग घोर अंधकार के समान होता है;</para>
  <para style="q2" vid="PRO 4:19">वे नहीं जानते कि वे किससे ठोकर खाते हैं।<verse eid="PRO 4:19" /></para>
  <para style="s1">सीधा मार्ग</para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />हे मेरे पुत्र, मेरे वचनों पर ध्यान दे,</para>
  <para style="q2" vid="PRO 4:20">और मेरे कथनों पर अपना कान लगा।<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />उन्हें अपनी दृष्‍टि से ओझल न होने दे।</para>
  <para style="q2" vid="PRO 4:21">अपने हृदय में उन्हें सँजोए रख।<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />क्योंकि जिन्हें वे प्राप्‍त होते हैं,</para>
  <para style="q2" vid="PRO 4:22">उनके लिए वे जीवन हैं,</para>
  <para style="q1" vid="PRO 4:22">और उनकी संपूर्ण देह के</para>
  <para style="q2" vid="PRO 4:22">स्वस्थ रहने का कारण होते हैं।<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />सब से अधिक अपने मन की चौकसी कर,</para>
  <para style="q2" vid="PRO 4:23">क्योंकि जीवन का सोता उसी में है।<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />अपने मुँह से कुटिल बात न बोल,</para>
  <para style="q2" vid="PRO 4:24">और अपने होठों से छल की बातों को दूर रख।<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />तेरी आँखें सामने की ओर लगी रहें,</para>
  <para style="q2" vid="PRO 4:25">और तेरी दृष्‍टि आगे की ओर गड़ी रहे।<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />अपने पैर रखने के लिए राह को समतल बना,</para>
  <para style="q2" vid="PRO 4:26">तब तेरे सब मार्ग दृढ़ रहेंगे।<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />तू न दाहिने मुड़,</para>
  <para style="q2" vid="PRO 4:27">और न बाएँ;</para>
  <para style="q3" vid="PRO 4:27">अपने पैर को बुराई से दूर रख।<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">व्यभिचार के विरुद्ध चेतावनी</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />हे मेरे पुत्र, मेरी बुद्धि की बातों पर ध्यान दे;</para>
  <para style="q2" vid="PRO 5:1">मेरी समझ की बातों पर कान लगा,<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />जिससे तेरा विवेक सुरक्षित बना रहे,</para>
  <para style="q2" vid="PRO 5:2">और तेरे होंठ ज्ञान की रक्षा करें।<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />क्योंकि व्यभिचारिणी के होंठों से मधु टपकता है,</para>
  <para style="q2" vid="PRO 5:3">और उसकी बातें तेल से भी अधिक चिकनी होती हैं;<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />परंतु अंत में वह स्‍त्री नागदौना सी कड़वी</para>
  <para style="q2" vid="PRO 5:4">और दोधारी तलवार सी पैनी सिद्ध होती है।<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />उसके पैर मृत्यु की ओर बढ़ते हैं,</para>
  <para style="q2" vid="PRO 5:5">और उसके कदम अधोलोक तक पहुँचते हैं।<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />वह जीवन के मार्ग पर ध्यान नहीं देती;</para>
  <para style="q2" vid="PRO 5:6">उसकी चाल टेढ़ी-मेढ़ी है, पर वह यह नहीं जानती।<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />इसलिए अब हे मेरे पुत्र<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">अक्षरशः पुत्रो</char></note>, मेरी सुन,</para>
  <para style="q2" vid="PRO 5:7">और मेरी बातों से मुँह न मोड़।<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />ऐसी स्‍त्री से दूर ही रह,</para>
  <para style="q2" vid="PRO 5:8">और उसके घर के द्वार के पास भी न जा।<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />कहीं ऐसा न हो कि तू अपना मान-सम्मान औरों को,</para>
  <para style="q2" vid="PRO 5:9">और अपना जीवन किसी निर्दयी को सौंप दे;<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />या पराए तेरी कमाई से अपना पेट भरें,</para>
  <para style="q2" vid="PRO 5:10">और तेरे परिश्रम का फल किसी परदेशी के घर पहुँचे;<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />और अपने अंतिम समय में</para>
  <para style="q2" vid="PRO 5:11">जब तेरा शरीर क्षीण हो जाए</para>
  <para style="q3" vid="PRO 5:11">तो तू कराहते हुए कहे,<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />“हाय! मैंने शिक्षा से कैसा बैर किया,</para>
  <para style="q2" vid="PRO 5:12">और मेरे मन ने चेतावनियों का कैसा तिरस्कार किया!<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />मैंने अपने गुरुओं की बात न मानी</para>
  <para style="q2" vid="PRO 5:13">और अपने सिखानेवालों की ओर कान न लगाया।<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />मैं सभा और मंडली के सामने</para>
  <para style="q2" vid="PRO 5:14">पूरी तरह से नष्‍ट होने पर था।”<verse eid="PRO 5:14" /></para>
  <para style="s1">वैवाहिक जीवन का आनंद लेना</para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 5:15" />तू अपने ही कुंड से पानी,</para>
  <para style="q2" vid="PRO 5:15">और अपने ही कुएँ के उमड़ते हुए जल में से</para>
  <para style="q3" vid="PRO 5:15">पिया कर।<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />क्या तेरे सोते बाहर यहाँ-वहाँ,</para>
  <para style="q2" vid="PRO 5:16">और तेरे जल की धाराएँ सड़कों पर फैल जाएँ?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />वे केवल तेरे ही लिए हों,</para>
  <para style="q2" vid="PRO 5:17">न कि तेरे साथ औरों के लिए भी।<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />तेरा सोता धन्य रहे;</para>
  <para style="q2" vid="PRO 5:18">और तू अपनी जवानी की पत्‍नी के साथ आनंदित रह।<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />एक प्रेमी हरिणी और मनोहर मृगी के समान</para>
  <para style="q2" vid="PRO 5:19">उसके स्तन तुझे सदा तृप्‍त रखें;</para>
  <para style="q3" vid="PRO 5:19">उसका प्रेम तुझे सदा आकर्षित करता रहे।<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />हे मेरे पुत्र, तू व्यभिचारिणी स्‍त्री पर क्यों मोहित हो,</para>
  <para style="q2" vid="PRO 5:20">और किसी पराई स्‍त्री को सीने से क्यों लगाए?<verse eid="PRO 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />क्योंकि मनुष्य के मार्ग यहोवा की दृष्‍टि में बने रहते हैं,</para>
  <para style="q2" vid="PRO 5:21">और वह उसके सारे चाल-चलन को देखता है।<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />दुष्‍ट अपने ही अधर्म के कामों में फँसेगा,</para>
  <para style="q2" vid="PRO 5:22">और अपने ही पाप के बंधनों में जकड़ा रहेगा।<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />वह शिक्षा के अभाव में मर जाएगा,</para>
  <para style="q2" vid="PRO 5:23">और अपनी बड़ी मूर्खता के कारण भटकता रहेगा।<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">अन्य चेतावनियाँ</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />हे मेरे पुत्र, यदि तूने अपने पड़ोसी की जमानत दी हो</para>
  <para style="q2" vid="PRO 6:1">अथवा किसी परदेशी की जिम्मेदारी ली हो,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />और तू अपनी ही बातों के जाल में फँस गया हो,</para>
  <para style="q2" vid="PRO 6:2">तथा अपने ही वचनों से पकड़ा गया हो,<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />तो हे मेरे पुत्र, तू ऐसा कर कि अपने आपको बचा ले;</para>
  <para style="q2" vid="PRO 6:3">क्योंकि तू अपने पड़ोसी के हाथ में पड़ गया है,</para>
  <para style="q3" vid="PRO 6:3">इसलिए जा और नम्र होकर अपने पड़ोसी को मना ले।<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />तू न तो अपनी आँखों में नींद,</para>
  <para style="q2" vid="PRO 6:4">और न अपनी पलकों में झपकी आने दे।<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />तू स्वयं को हरिण के समान शिकारी के हाथ से,</para>
  <para style="q2" vid="PRO 6:5">और पक्षी के समान बहेलिए के हाथ से बचा ले।<verse eid="PRO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />हे आलसी, चींटी के पास जा;</para>
  <para style="q2" vid="PRO 6:6">उसके काम पर ध्यान दे, और बुद्धिमान बन।<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />उसका न तो कोई न्यायी, न अधिकारी,</para>
  <para style="q2" vid="PRO 6:7">और न कोई शासक होता है।<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />पर वह ग्रीष्मकाल में अपने भोजन का प्रबंध करती है,</para>
  <para style="q2" vid="PRO 6:8">और कटनी के समय भोजन-सामग्री एकत्रित करती है।<verse eid="PRO 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />हे आलसी, तू कब तक पड़ा रहेगा?</para>
  <para style="q2" vid="PRO 6:9">तू अपनी नींद से कब जागेगा?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />और थोड़ी सी नींद,</para>
  <para style="q2" vid="PRO 6:10">एक और झपकी,</para>
  <para style="q3" vid="PRO 6:10">हाथ पर हाथ रखकर थोड़ी देर और लेटे रहना,<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />तब तेरी निर्धनता डाकू के समान</para>
  <para style="q2" vid="PRO 6:11">और तेरी घटी शस्‍त्रधारी की भाँति तुझ पर आ पड़ेगी।<verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />निकम्मा और दुष्‍ट व्यक्‍ति वह है</para>
  <para style="q2" vid="PRO 6:12">जो कुटिल बातें बोलता फिरता है,<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />वह नैन से सैन करता है,</para>
  <para style="q2" vid="PRO 6:13">वह अपने पैरों से संकेत और उँगलियों से इशारे करता है।<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />अपने कुटिल हृदय में वह निरंतर बुरी युक्‍तियाँ गढ़ता है,</para>
  <para style="q2" vid="PRO 6:14">और लड़ाई-झगड़े उत्पन्‍न‍ करता है।<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />इसलिए उस पर अचानक विपत्ति आ पड़ेगी।</para>
  <para style="q2" vid="PRO 6:15">वह पल भर में नष्‍ट हो जाएगा,</para>
  <para style="q3" vid="PRO 6:15">और उसके बचने की कोई आशा नहीं रहेगी।<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />छः बातें हैं जिनसे यहोवा बैर रखता है,</para>
  <para style="q2" vid="PRO 6:16">बल्कि सात हैं जिनसे उसे घृणा है :<verse eid="PRO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17" />घमंड से चढ़ी हुई आँखें,</para>
  <para style="q2" vid="PRO 6:17">झूठ बोलनेवाली जीभ,</para>
  <para style="q3" vid="PRO 6:17">निर्दोष का लहू बहानेवाले हाथ,<verse eid="PRO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 6:18" />दुष्‍ट युक्‍तियाँ गढ़नेवाला मन,</para>
  <para style="q2" vid="PRO 6:18">बुराई की ओर तेज़ी से दौड़नेवाले पैर,<verse eid="PRO 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19" />झूठ बोलनेवाला साक्षी</para>
  <para style="q2" vid="PRO 6:19">और भाइयों के बीच में</para>
  <para style="q3" vid="PRO 6:19">झगड़ा उत्पन्‍न‍ करनेवाला व्यक्‍ति।<verse eid="PRO 6:19" /></para>
  <para style="s1">व्यभिचार के विरुद्ध चेतावनी</para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />हे मेरे पुत्र, अपने पिता की आज्ञा का पालन कर,</para>
  <para style="q2" vid="PRO 6:20">और अपनी माता की शिक्षा को न त्याग।<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />उन्हें अपने हृदय में निरंतर बसाए रख;</para>
  <para style="q2" vid="PRO 6:21">उन्हें अपने गले का हार बना ले।<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />जब तू चलेगा तो वे तेरा मार्गदर्शन करेंगी,</para>
  <para style="q2" vid="PRO 6:22">जब तू सोएगा तो वे तेरी रक्षा करेंगी,</para>
  <para style="q3" vid="PRO 6:22">और जब तू जागेगा तो वे तुझसे बातें करेंगी।<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />क्योंकि आज्ञा तो दीपक, और शिक्षा ज्योति है,</para>
  <para style="q2" vid="PRO 6:23">तथा अनुशासन के लिए ताड़ना जीवन का मार्ग है।<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />ये तुझे बुरी स्‍त्री</para>
  <para style="q2" vid="PRO 6:24">अर्थात् व्यभिचारिणी की चिकनी-चुपड़ी बातों से बचाए रखेंगी।<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />अपने हृदय में उसकी सुंदरता की अभिलाषा न कर,</para>
  <para style="q2" vid="PRO 6:25">और वह अपनी पलकों से तुझे फँसा न ले।<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />क्योंकि वेश्या तो रोटी के एक टुकड़े से खरीदी जा सकती है,</para>
  <para style="q2" vid="PRO 6:26">पर एक व्यभिचारिणी बहुमूल्य जीवन का शिकार कर लेती है।<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />क्या ऐसा हो सकता है</para>
  <para style="q2" vid="PRO 6:27">कि कोई अपनी छाती पर आग रखे</para>
  <para style="q3" vid="PRO 6:27">और उसके कपड़े न जलें?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />क्या ऐसा हो सकता है</para>
  <para style="q2" vid="PRO 6:28">कि कोई मनुष्य अंगारों पर चले</para>
  <para style="q3" vid="PRO 6:28">और उसके पैर न झुलसें?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />पराई स्‍त्री के पास जानेवाले व्यक्‍ति की दशा ऐसी ही होती है;</para>
  <para style="q2" vid="PRO 6:29">जो कोई उस स्‍त्री को स्पर्श करेगा</para>
  <para style="q3" vid="PRO 6:29">वह दंड से न बचेगा।<verse eid="PRO 6:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />लोग उस चोर को तुच्छ नहीं जानते</para>
  <para style="q2" vid="PRO 6:30">जो अपनी भूख मिटाने के लिए चोरी करता है।<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />फिर भी यदि वह पकड़ा जाए तो उसे सातगुणा भरना पड़ेगा;</para>
  <para style="q2" vid="PRO 6:31">उसे अपने घर का सब कुछ देना पड़ेगा।<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />परंतु जो परस्‍त्रीगमन करता है वह निरा मूर्ख है,</para>
  <para style="q2" vid="PRO 6:32">और ऐसा करनेवाला अपना ही विनाश करता है।<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />उसे घायल और अपमानित होना पड़ेगा,</para>
  <para style="q2" vid="PRO 6:33">और उसका कलंक कभी न मिटेगा।<verse eid="PRO 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />क्योंकि ईर्ष्या पति के क्रोध को भड़काती है,</para>
  <para style="q2" vid="PRO 6:34">और जब बदला लेने का समय आएगा</para>
  <para style="q3" vid="PRO 6:34">तो वह दया नहीं दिखाएगा।<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />वह किसी प्रकार की क्षतिपूर्ति ग्रहण न करेगा,</para>
  <para style="q2" vid="PRO 6:35">और चाहे तू उसे बहुत कुछ दे,</para>
  <para style="q3" vid="PRO 6:35">फिर भी वह न मानेगा।<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />हे मेरे पुत्र, मेरी बातों को माना कर,</para>
  <para style="q2" vid="PRO 7:1">और मेरी आज्ञाओं को अपने मन में रखे रह।<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />मेरी आज्ञाओं का पालन कर तो तू जीवित रहेगा;</para>
  <para style="q2" vid="PRO 7:2">मेरी शिक्षा को अपनी आँख की पुतली जानकर सुरक्षित रख।<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />उन्हें अपनी उँगलियों पर बाँध ले,</para>
  <para style="q2" vid="PRO 7:3">और अपने हृदय-पटल पर लिख ले।<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />बुद्धि से कह, “तू मेरी बहन है,”</para>
  <para style="q2" vid="PRO 7:4">और समझ को अपनी कुटुंबिनी बना।<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />तब तू पराई स्‍त्री से बचा रहेगा,</para>
  <para style="q2" vid="PRO 7:5">अर्थात् उस चरित्रहीन स्‍त्री से जो चिकनी-चुपड़ी बातें बोलती है।<verse eid="PRO 7:5" /></para>
  <para style="s1">व्यभिचार की कहानी</para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />एक दिन मैंने अपने घर की खिड़की,</para>
  <para style="q2" vid="PRO 7:6">अर्थात् झरोखे से बाहर झाँका,<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />तो मुझे सरल-हृदय लोगों के बीच</para>
  <para style="q2" vid="PRO 7:7">एक नासमझ युवक दिखाई दिया।<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />वह उस गली के मोड़ तक गया</para>
  <para style="q2" vid="PRO 7:8">जहाँ वह स्‍त्री रहती थी,</para>
  <para style="q3" vid="PRO 7:8">फिर उसने उसके घर का मार्ग लिया।<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />उस समय दिन ढल गया था,</para>
  <para style="q2" vid="PRO 7:9">और साँझ हो गई थी,</para>
  <para style="q3" vid="PRO 7:9">रात का अंधकार गहराता जा रहा था।<verse eid="PRO 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />और देखो, एक स्‍त्री उससे मिली जिसकी वेशभूषा वेश्या की सी थी;</para>
  <para style="q2" vid="PRO 7:10">उसका हृदय धूर्तता से भरा हुआ था।<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />वह अशांत और चंचल थी,</para>
  <para style="q2" vid="PRO 7:11">उसके पैर घर में टिकते न थे।<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />वह कभी गली में, तो कभी चौक में दिखाई देती थी;</para>
  <para style="q2" vid="PRO 7:12">वह हर मोड़ पर शिकार के लिए घात लगाती थी।<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />तब उसने उस युवक को पकड़कर चूमा,</para>
  <para style="q2" vid="PRO 7:13">और निर्लज्‍ज मुँह बना कर उससे कहा :<verse eid="PRO 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />“मुझे मेलबलियाँ चढ़ानी थीं;</para>
  <para style="q2" vid="PRO 7:14">मैंने अपनी मन्‍नतें आज ही पूरी की हैं।<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />इसी कारण मैं तुझसे भेंट करने निकली;</para>
  <para style="q2" vid="PRO 7:15">मैं तुझे ढूँढ़ रही थी,</para>
  <para style="q3" vid="PRO 7:15">और तू अब मिल गया है।<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />मैंने अपने पलंग पर मिस्र की</para>
  <para style="q2" vid="PRO 7:16">रंग-बिरंगी मखमल की चादरें बिछाई हैं।<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />मैंने अपने बिछौने को गंधरस,</para>
  <para style="q2" vid="PRO 7:17">अगर और दालचीनी से सुगंधित किया है।<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />आ, हम भोर तक प्रेम के नशे में डूबे रहें।</para>
  <para style="q2" vid="PRO 7:18">आ, हम एक दूसरे के प्रेम का आनंद लें।<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />मेरा पति घर पर नहीं है;</para>
  <para style="q2" vid="PRO 7:19">वह लंबी यात्रा पर निकल गया है।<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />वह अपने साथ रुपयों की थैली ले गया है,</para>
  <para style="q2" vid="PRO 7:20">और पूर्णिमा के दिन ही घर लौटेगा।”<verse eid="PRO 7:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />लुभावनी बातें कह कहकर उसने उसे फँसा लिया;</para>
  <para style="q2" vid="PRO 7:21">अपनी मीठी-मीठी बातों से</para>
  <para style="q3" vid="PRO 7:21">उसने उसे अपने वश में कर लिया।<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />वह तुरंत उसके पीछे हो लिया, जैसे बैल कसाईखाने को,</para>
  <para style="q2" vid="PRO 7:22">या बेड़ी पहने हुए कोई मूर्ख दंड पाने को जाता है।<verse eid="PRO 7:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23" />अंत में उस युवक का कलेजा तीर से बेधा जाएगा।</para>
  <para style="q2" vid="PRO 7:23">वह ऐसे पक्षी के समान है</para>
  <para style="q1" vid="PRO 7:23">जो वेग से जाल की ओर उड़ता है</para>
  <para style="q2" vid="PRO 7:23">और नहीं जानता कि वह अपने प्राणों से हाथ धो बैठेगा।<verse eid="PRO 7:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />अब हे मेरे पुत्रो, मेरी सुनो,</para>
  <para style="q2" vid="PRO 7:24">और मेरे मुँह के वचनों पर ध्यान दो।<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />तेरा मन ऐसी स्‍त्री के मार्गों की ओर न फिरे,</para>
  <para style="q2" vid="PRO 7:25">तू उसकी राहों में भूलकर भी न जाना।<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />क्योंकि उसने बहुत से लोगों को मारकर घायल किया है;</para>
  <para style="q2" vid="PRO 7:26">उसके द्वारा घात किए हुओं की संख्या बड़ी है।<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />उसका घर अधोलोक का मार्ग है,</para>
  <para style="q2" vid="PRO 7:27">वह मृत्यु की कोठरी में पहुँचाता है।<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">बुद्धि का आग्रह</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />क्या बुद्धि नहीं पुकारती है;</para>
  <para style="q2" vid="PRO 8:1">क्या समझ ऊँची आवाज़ से नहीं बोलती है?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />वह ऊँचे स्थानों पर मार्ग के किनारे</para>
  <para style="q2" vid="PRO 8:2">और चौकों पर खड़ी होती है;<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />वह फाटकों के पास अर्थात् नगर के</para>
  <para style="q2" vid="PRO 8:3">प्रवेश-द्वारों पर ऊँचे स्वर से कहती है :<verse eid="PRO 8:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />हे लोगो, मैं तुम्हें पुकारती हूँ,</para>
  <para style="q2" vid="PRO 8:4">और मेरी वाणी सब मनुष्यों के लिए है।<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />हे भोले लोगो, चतुराई सीखो;</para>
  <para style="q2" vid="PRO 8:5">और हे मूर्खो, समझदार बनो।<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />सुनो, क्योंकि मैं उत्तम बातें कहूँगी,</para>
  <para style="q2" vid="PRO 8:6">और मेरे मुँह से सीधी बातें ही निकलेंगी;<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />मेरे मुँह से सच्‍चाई की बातों का वर्णन होगा;</para>
  <para style="q2" vid="PRO 8:7">दुष्‍टता की बातों से मुझे घृणा है।<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />मेरे मुँह की सब बातें धार्मिकता की होती हैं,</para>
  <para style="q2" vid="PRO 8:8">उनमें से कोई टेढ़ी या कुटिल बात नहीं होती।<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />समझदार के लिए वे सब सहज,</para>
  <para style="q2" vid="PRO 8:9">और ज्ञान प्राप्‍त करनेवालों के लिए खरी हैं।<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />चाँदी को नहीं, बल्कि मेरी शिक्षा को ग्रहण करो;</para>
  <para style="q2" vid="PRO 8:10">सोने को नहीं, बल्कि ज्ञान को प्राप्‍त करो।<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />क्योंकि बुद्धि रत्‍नों से भी उत्तम है,</para>
  <para style="q2" vid="PRO 8:11">और उसकी तुलना किसी भी मनभावनी वस्तु से</para>
  <para style="q3" vid="PRO 8:11">नहीं की जा सकती।<verse eid="PRO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />मैं बुद्धि हूँ। मैं चतुराई में वास करती हूँ,</para>
  <para style="q2" vid="PRO 8:12">और मेरे पास ज्ञान और विवेक हैं।<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />यहोवा का भय मानना बुराई से बैर रखना है।</para>
  <para style="q2" vid="PRO 8:13">मैं घमंड, अहंकार और बुरी चाल से,</para>
  <para style="q3" vid="PRO 8:13">तथा कुटिल बातों से भी बैर रखती हूँ।<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />सम्मति और खरी बुद्धि मेरी ही हैं।</para>
  <para style="q2" vid="PRO 8:14">समझ और पराक्रम भी मेरे हैं।<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />मेरे ही द्वारा राजा राज्य करते हैं,</para>
  <para style="q2" vid="PRO 8:15">और अधिकारी धार्मिकता से न्याय करते हैं।<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />मेरे ही द्वारा शासक शासन करते हैं,</para>
  <para style="q2" vid="PRO 8:16">और सब उच्‍चाधिकारी धार्मिकता से न्याय करते हैं।<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />जो मुझसे प्रेम रखते हैं उनसे मैं भी प्रेम रखती हूँ।</para>
  <para style="q2" vid="PRO 8:17">जो मुझे यत्‍न से ढूँढ़ते हैं,</para>
  <para style="q3" vid="PRO 8:17">वे मुझे पाते हैं।<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />धन और सम्मान मेरे पास हैं,</para>
  <para style="q2" vid="PRO 8:18">बल्कि चिरस्थायी संपत्ति और धार्मिकता भी।<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />मेरा फल सोने से,</para>
  <para style="q2" vid="PRO 8:19">बल्कि कुंदन से भी उत्तम है,</para>
  <para style="q3" vid="PRO 8:19">और मेरी उपज उत्तम चाँदी से अच्छी है।<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />मैं धार्मिकता के मार्ग पर,</para>
  <para style="q2" vid="PRO 8:20">अर्थात् न्याय के पथ पर चलती हूँ,<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />और जो मुझसे प्रेम रखते हैं,</para>
  <para style="q2" vid="PRO 8:21">उन्हें धन प्रदान करती हूँ</para>
  <para style="q3" vid="PRO 8:21">तथा उनके भंडारों को भर देती हूँ।<verse eid="PRO 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />यहोवा ने मुझे अपने कार्य के आरंभ में,</para>
  <para style="q2" vid="PRO 8:22">बल्कि आदिकाल के अपने कार्यों से भी पहले उत्पन्‍न‍ किया।<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />मैं सदाकाल से,</para>
  <para style="q2" vid="PRO 8:23">बल्कि पृथ्वी की सृष्‍टि के पहले ही से ठहराई गई हूँ।<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />जब न तो गहरे सागर थे</para>
  <para style="q2" vid="PRO 8:24">और न जल के उमड़ते हुए सोते थे,</para>
  <para style="q3" vid="PRO 8:24">तभी मैं उत्पन्‍न‍ हुई।<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />पहाड़ों और पहाड़ियों के स्थापित किए जाने से भी पहले,</para>
  <para style="q2" vid="PRO 8:25">मुझे उत्पन्‍न‍ किया गया—<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />यहोवा ने उस समय तक न तो पृथ्वी और मैदानों को बनाया था,</para>
  <para style="q2" vid="PRO 8:26">और न ही जगत की धूल के प्रथम कण ही बनाए थे।<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />जब उसने आकाश को स्थिर किया, तब मैं वहाँ थी,</para>
  <para style="q2" vid="PRO 8:27">जब उसने गहरे सागर के ऊपर आकाशमंडल को ताना,<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />जब उसने ऊपर के आकाशमंडल को स्थिर किया,</para>
  <para style="q2" vid="PRO 8:28">और गहरे सागर के सोते बहाए,<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />जब उसने समुद्र की सीमा बाँधी</para>
  <para style="q2" vid="PRO 8:29">कि जल उसकी आज्ञा का उल्लंघन न करे,</para>
  <para style="q3" vid="PRO 8:29">जब उसने पृथ्वी की नींव डाली,<verse eid="PRO 8:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30" />तब मैं एक कुशल कारीगर के समान उसके साथ थी।</para>
  <para style="q2" vid="PRO 8:30">मैं प्रतिदिन प्रसन्‍न रहती थी,<note caller="+" style="f"><char style="fr" closed="false">8:30 </char><char style="ft" closed="false">कुछ हस्तलेखों में “मैं प्रतिदिन प्रसन्‍न रहती थी” के स्थान पर “मैं प्रतिदिन उसकी प्रसन्‍नता का कारण थी” लिखा है।</char></note></para>
  <para style="q3" vid="PRO 8:30">और उसके सामने सदा आनंदित रहती थी।<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />मैं उसकी बसाई हुई पृथ्वी से आनंदित थी,</para>
  <para style="q2" vid="PRO 8:31">और मेरी प्रसन्‍नता मनुष्यों की संगति में थी।<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />“इसलिए अब हे मेरे पुत्रो, मेरी सुनो;</para>
  <para style="q2" vid="PRO 8:32">क्या ही धन्य हैं वे जो मेरे मार्गों पर चलते हैं।<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />शिक्षा को सुनो, और बुद्धिमान बनो,</para>
  <para style="q2" vid="PRO 8:33">उसकी उपेक्षा मत करो।<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />क्या ही धन्य है वह पुरुष जो मेरी सुनता है,</para>
  <para style="q2" vid="PRO 8:34">और मेरे फाटकों पर प्रतिदिन दृष्‍टि लगाए रहता है,</para>
  <para style="q3" vid="PRO 8:34">बल्कि मेरी चौखट पर प्रतीक्षा करता है।<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />क्योंकि जो मुझे पाता है,</para>
  <para style="q2" vid="PRO 8:35">वह जीवन पाता है और उस पर</para>
  <para style="q3" vid="PRO 8:35">यहोवा की कृपा होती है।<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />परंतु जो मुझे पाने से चूक जाता है,</para>
  <para style="q2" vid="PRO 8:36">वह अपनी ही हानि करता है।</para>
  <para style="q3" vid="PRO 8:36">मुझसे बैर रखनेवाले सब लोग मृत्यु से प्रेम रखते हैं।”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">बुद्धिमानी बनाम मूर्खता</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />बुद्धि ने अपना घर बनाया;</para>
  <para style="q2" vid="PRO 9:1">उसने अपने सात खंभे खड़े किए।<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />उसने अपना पशु काटकर और अपने दाखमधु में मसाला मिलाकर</para>
  <para style="q2" vid="PRO 9:2">अपना भोज तैयार किया है।<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />तब उसने अपनी सेविकाओं को निमंत्रण देने भेजा;</para>
  <para style="q2" vid="PRO 9:3">और वह नगर के ऊँचे स्थानों से पुकारती है :<verse eid="PRO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4" />“जो कोई भोला है वह घर के भीतर आए।”</para>
  <para style="q2" vid="PRO 9:4">और उनसे जो नासमझ हैं वह कहती है :<verse eid="PRO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5" />“आओ, मेरे भोजन में से खाओ,</para>
  <para style="q2" vid="PRO 9:5">और मेरे मसाला मिलाए हुए दाखमधु में से पीओ।<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />अपनी मूर्खता छोड़ो और जीवित रहो,</para>
  <para style="q2" vid="PRO 9:6">तथा समझ के मार्ग में आगे बढ़ो।”<verse eid="PRO 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />जो ठट्ठा करनेवाले को शिक्षा देता है,</para>
  <para style="q2" vid="PRO 9:7">वह स्वयं अपमानित होता है;</para>
  <para style="q1" vid="PRO 9:7">और जो दुष्‍ट व्यक्‍ति को डाँटता है</para>
  <para style="q2" vid="PRO 9:7">वह स्वयं को हानि पहुँचाता है।<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />ठट्ठा करनेवाले को न डाँट,</para>
  <para style="q2" vid="PRO 9:8">नहीं तो वह तुझसे बैर रखेगा;</para>
  <para style="q1" vid="PRO 9:8">बुद्धिमान को डाँट,</para>
  <para style="q2" vid="PRO 9:8">वह तो तुझसे प्रेम रखेगा।<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />बुद्धिमान को शिक्षा दे तो वह अधिक बुद्धिमान होगा;</para>
  <para style="q2" vid="PRO 9:9">धर्मी को सिखा तो वह अपनी विद्या बढ़ाएगा।<verse eid="PRO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />यहोवा का भय मानना बुद्धि का आरंभ है,</para>
  <para style="q2" vid="PRO 9:10">और परमपवित्र को जानना ही समझ है।<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />मेरे द्वारा ही तेरी आयु बढ़ेगी,</para>
  <para style="q2" vid="PRO 9:11">और तेरे जीवन के वर्ष अधिक होंगे।<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />यदि तू बुद्धिमान हो तो बुद्धि का लाभ तुझे ही मिलेगा;</para>
  <para style="q2" vid="PRO 9:12">और यदि तू ठट्ठा करता है</para>
  <para style="q3" vid="PRO 9:12">तो तू ही दुःख उठाएगा।<verse eid="PRO 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />मूर्खता उस स्‍त्री के समान है जो कोलाहल मचाती है,</para>
  <para style="q2" vid="PRO 9:13">वह विवेकहीन है और कुछ नहीं जानती।<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />वह अपने घर के द्वार पर बैठी है;</para>
  <para style="q2" vid="PRO 9:14">वह नगर के ऊँचे स्थानों में अपने आसन पर है,<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />और वह पथिकों से अर्थात् उनसे</para>
  <para style="q2" vid="PRO 9:15">जो अपने-अपने मार्ग पर सीधे जाते हैं,</para>
  <para style="q3" vid="PRO 9:15">पुकार पुकारकर कहती है :<verse eid="PRO 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16" />“जो कोई भोला है वह घर के भीतर आए।”</para>
  <para style="q2" vid="PRO 9:16">और उससे जो नासमझ है वह कहती है :<verse eid="PRO 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17" />“चोरी का पानी मीठा होता है,</para>
  <para style="q2" vid="PRO 9:17">और छिपकर खाई रोटी अच्छी लगती है।”<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />वह यह नहीं जानता कि वहाँ मरे हुओं का वास है,</para>
  <para style="q2" vid="PRO 9:18">और उसके अतिथि अधोलोक के निचले स्थानों में पड़े हैं।<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s1">सुलैमान के नीतिवचन (10.1–22.16)</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />सुलैमान के नीतिवचन।</para>
  <para style="q1" vid="PRO 10:1">बुद्धिमान पुत्र से पिता आनंदित होता है,</para>
  <para style="q2" vid="PRO 10:1">परंतु मूर्ख पुत्र अपनी माता के दुःख का कारण होता है।<verse eid="PRO 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />दुष्‍टता से प्राप्‍त धन से लाभ नहीं होता,</para>
  <para style="q2" vid="PRO 10:2">परंतु धार्मिकता मृत्यु से छुड़ाती है।<verse eid="PRO 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />यहोवा धर्मी को भूखा नहीं रहने देता,</para>
  <para style="q2" vid="PRO 10:3">परंतु वह दुष्‍टों की लालसाओं पर पानी फेर देता है।<verse eid="PRO 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />ढीले हाथों से काम करनेवाला निर्धन हो जाता है,</para>
  <para style="q2" vid="PRO 10:4">परंतु परिश्रमी के हाथ उसे धनी बना देते हैं।<verse eid="PRO 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />जो ग्रीष्मकाल में बटोरता है,</para>
  <para style="q2" vid="PRO 10:5">वह बुद्धिमान पुत्र है,</para>
  <para style="q1" vid="PRO 10:5">परंतु जो पुत्र कटनी के समय सोता रहता है,</para>
  <para style="q2" vid="PRO 10:5">वह लज्‍जा का कारण होता है।<verse eid="PRO 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />धर्मी पर आशिषें बनी रहती हैं,</para>
  <para style="q2" vid="PRO 10:6">परंतु दुष्‍टों के मुँह पर हिंसा छाई रहती है।<verse eid="PRO 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />धर्मी को स्मरण करके लोग आशीर्वाद देते हैं,</para>
  <para style="q2" vid="PRO 10:7">परंतु दुष्‍टों का नाम मिट जाएगा।<verse eid="PRO 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />जो बुद्धिमान है, वह आज्ञाओं को मानता है,</para>
  <para style="q2" vid="PRO 10:8">परंतु जो बकवादी और मूर्ख है,</para>
  <para style="q3" vid="PRO 10:8">वह नष्‍ट हो जाएगा।<verse eid="PRO 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />खराई से चलनेवाला सुरक्षित रहता है,</para>
  <para style="q2" vid="PRO 10:9">परंतु टेढ़ी चाल चलनेवाले का भेद खुल जाएगा।<verse eid="PRO 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />जो नैन से सैन करता है,</para>
  <para style="q2" vid="PRO 10:10">वह दुःख पहुँचाता है,</para>
  <para style="q1" vid="PRO 10:10">परंतु जो बकवादी और मूर्ख है,</para>
  <para style="q2" vid="PRO 10:10">वह नष्‍ट हो जाएगा।<verse eid="PRO 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />धर्मी का मुँह तो जीवन का सोता है,</para>
  <para style="q2" vid="PRO 10:11">परंतु दुष्‍टों के मुँह पर हिंसा छाई रहती है।<verse eid="PRO 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />बैर से तो झगड़े उत्पन्‍न‍ होते हैं,</para>
  <para style="q2" vid="PRO 10:12">परंतु प्रेम सब अपराधों को ढाँप देता है।<verse eid="PRO 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />समझ रखनेवाले की बातों में बुद्धि पाई जाती है,</para>
  <para style="q2" vid="PRO 10:13">परंतु निर्बुद्धि की पीठ के लिए छड़ी होती है।<verse eid="PRO 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />बुद्धिमान लोग ज्ञान का संचय करते हैं,</para>
  <para style="q2" vid="PRO 10:14">परंतु मूर्ख के बोलने से विनाश निकट आता है।<verse eid="PRO 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />धनी का धन उसका दृढ़ नगर है,</para>
  <para style="q2" vid="PRO 10:15">परंतु निर्धन की निर्धनता उसके विनाश का कारण है।<verse eid="PRO 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />धर्मी का परिश्रम जीवन के लिए है,</para>
  <para style="q2" vid="PRO 10:16">परंतु दुष्‍ट की कमाई पाप</para>
  <para style="q3" vid="PRO 10:16">का कारण हो जाती है।<verse eid="PRO 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />जो शिक्षा का पालन करता है,</para>
  <para style="q2" vid="PRO 10:17">वह जीवन के मार्ग पर है,</para>
  <para style="q1" vid="PRO 10:17">परंतु जो डाँट से मुँह मोड़ता है,</para>
  <para style="q2" vid="PRO 10:17">वह भटक जाता है।<verse eid="PRO 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />जो बैर को छिपाए रखता है,</para>
  <para style="q2" vid="PRO 10:18">वह झूठ बोलता है,</para>
  <para style="q1" vid="PRO 10:18">और जो निंदा फैलाता है,</para>
  <para style="q2" vid="PRO 10:18">वह मूर्ख है।<verse eid="PRO 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />जहाँ बातें बहुत होती हैं,</para>
  <para style="q2" vid="PRO 10:19">वहाँ पाप भी होता है,</para>
  <para style="q1" vid="PRO 10:19">परंतु जो अपनी जीभ पर नियंत्रण रखता है,</para>
  <para style="q2" vid="PRO 10:19">वह बुद्धिमान है।<verse eid="PRO 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />धर्मी के वचन तो उत्तम चाँदी के समान हैं,</para>
  <para style="q2" vid="PRO 10:20">परंतु दुष्‍टों के विचारों का कोई महत्त्व नहीं।<verse eid="PRO 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />धर्मी के वचनों से बहुतों को लाभ होता है,</para>
  <para style="q2" vid="PRO 10:21">परंतु मूर्ख लोग समझ की कमी के कारण मर जाते हैं।<verse eid="PRO 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />धन यहोवा की आशिष से ही प्राप्‍त होता है,</para>
  <para style="q2" vid="PRO 10:22">और वह उसके साथ दुःख नहीं मिलाता।<verse eid="PRO 10:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />जैसे मूर्ख के लिए दुष्‍टता करना हँसी खेल है,</para>
  <para style="q2" vid="PRO 10:23">वैसे ही समझदार पुरुष के लिए बुद्धिमानी प्रसन्‍नता लाती है।<verse eid="PRO 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />दुष्‍ट जिस बात से डरता है वही उस पर आ पड़ेगी,</para>
  <para style="q2" vid="PRO 10:24">परंतु धर्मी की मनोकामना पूरी की जाएगी।<verse eid="PRO 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />जब बवंडर आता है तो दुष्‍ट को उड़ा ले जाता है,</para>
  <para style="q2" vid="PRO 10:25">परंतु धर्मी सदा स्थिर बना रहता है।<verse eid="PRO 10:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />जैसे दाँतों को सिरका और आँखों को धुआँ,</para>
  <para style="q2" vid="PRO 10:26">वैसे ही आलसी उनको लगता है</para>
  <para style="q3" vid="PRO 10:26">जो उसे भेजते हैं।<verse eid="PRO 10:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />यहोवा का भय मानने से आयु बढ़ती है,</para>
  <para style="q2" vid="PRO 10:27">परंतु दुष्‍टों के वर्ष घटाए जाते हैं।<verse eid="PRO 10:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />धर्मियों की आशा आनंद लेकर आती है,</para>
  <para style="q2" vid="PRO 10:28">परंतु दुष्‍टों की आशा टूट जाती है।<verse eid="PRO 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />यहोवा का मार्ग खरे मनुष्य के लिए तो दृढ़ गढ़,</para>
  <para style="q2" vid="PRO 10:29">परंतु अनर्थकारियों के लिए विनाश है।<verse eid="PRO 10:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />धर्मी सदा अटल रहेगा,</para>
  <para style="q2" vid="PRO 10:30">परंतु दुष्‍ट लोग पृथ्वी पर बने न रहेंगे।<verse eid="PRO 10:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />धर्मी के मुँह से बुद्धि की बातें निकलती हैं,</para>
  <para style="q2" vid="PRO 10:31">परंतु कुटिल बातें कहनेवाली जीभ काट डाली जाएगी।<verse eid="PRO 10:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />धर्मी जन ग्रहणयोग्य बातें करना जानता है,</para>
  <para style="q2" vid="PRO 10:32">परंतु दुष्‍ट के मुँह से कुटिल बातें निकलती हैं।<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />यहोवा को खोटे तराजू से घृणा है,</para>
  <para style="q2" vid="PRO 11:1">परंतु वह सही नाप-तौल से प्रसन्‍न‍ होता है।<verse eid="PRO 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />घमंड के पीछे-पीछे अपमान भी आता है,</para>
  <para style="q2" vid="PRO 11:2">परंतु नम्र लोगों में बुद्धि का वास होता है।<verse eid="PRO 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />सीधे लोगों की खराई उनकी अगुवाई करती है,</para>
  <para style="q2" vid="PRO 11:3">परंतु कपटियों का कपट उन्हीं का नाश कर देगा।<verse eid="PRO 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />प्रकोप के दिन धन किसी काम नहीं आता,</para>
  <para style="q2" vid="PRO 11:4">परंतु धार्मिकता मृत्यु से बचाती है।<verse eid="PRO 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />निर्दोष व्यक्‍ति की धार्मिकता उसके मार्ग को सीधा करती है,</para>
  <para style="q2" vid="PRO 11:5">परंतु दुष्‍ट अपनी ही दुष्‍टता के कारण गिरता है।<verse eid="PRO 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />सीधे लोगों की धार्मिकता उन्हें बचाती है,</para>
  <para style="q2" vid="PRO 11:6">परंतु कपटी अपनी ही दुष्‍टता में फँस जाते हैं।<verse eid="PRO 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />जब दुष्‍ट जन मरता है,</para>
  <para style="q2" vid="PRO 11:7">तो उसकी आशा मिट जाती है,</para>
  <para style="q3" vid="PRO 11:7">और धन पर उसका भरोसा व्यर्थ ठहरता है।<verse eid="PRO 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />धर्मी विपत्ति से छूट जाता है,</para>
  <para style="q2" vid="PRO 11:8">परंतु दुष्‍ट उसमें फँस जाता है।<verse eid="PRO 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />भक्‍तिहीन अपने पड़ोसी को अपनी बातों से बिगाड़ देता है,</para>
  <para style="q2" vid="PRO 11:9">परंतु धर्मी लोग ज्ञान के द्वारा बच जाते हैं।<verse eid="PRO 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />जब धर्मियों का भला होता है,</para>
  <para style="q2" vid="PRO 11:10">तो नगर के लोग आनंदित होते हैं,</para>
  <para style="q1" vid="PRO 11:10">और जब दुष्‍ट नष्‍ट होते हैं,</para>
  <para style="q2" vid="PRO 11:10">तो जय जयकार होता है।<verse eid="PRO 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />सीधे लोगों के आशीर्वाद से नगर की उन्‍नति होती है,</para>
  <para style="q2" vid="PRO 11:11">परंतु दुष्‍टों की बातों से वह ढाया जाता है।<verse eid="PRO 11:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />जो अपने पड़ोसी का अपमान करता है,</para>
  <para style="q2" vid="PRO 11:12">वह निर्बुद्धि है, परंतु समझदार पुरुष चुपचाप रहता है।<verse eid="PRO 11:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />जो बातों को इधर-उधर करता फिरता है वह भेद प्रकट करता है,</para>
  <para style="q2" vid="PRO 11:13">परंतु विश्‍वासयोग्य मनुष्य बात को छिपाए रखता है।<verse eid="PRO 11:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />जहाँ मार्गदर्शन नहीं होता, वहाँ प्रजा का पतन होता है,</para>
  <para style="q2" vid="PRO 11:14">परंतु सलाहकारों की बहुतायत से विजय प्राप्‍त होती है।<verse eid="PRO 11:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />जो किसी अजनबी की जिम्मेदारी लेता है,</para>
  <para style="q2" vid="PRO 11:15">वह हानि उठाता है,</para>
  <para style="q1" vid="PRO 11:15">परंतु जो ऐसी जिम्मेदारी लेने से घृणा करता है,</para>
  <para style="q2" vid="PRO 11:15">वह सुरक्षित रहता है।<verse eid="PRO 11:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />कृपालु स्‍त्री सम्मान प्राप्‍त करती है,</para>
  <para style="q2" vid="PRO 11:16">जबकि निर्दयी मनुष्य धन को झपट लेते हैं।<verse eid="PRO 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />कृपालु पुरुष अपना भला करता है,</para>
  <para style="q2" vid="PRO 11:17">परंतु क्रूर मनुष्य अपनी ही देह को हानि पहुँचाता है।<verse eid="PRO 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />दुष्‍ट का कमाया धन अस्थिर होता है,</para>
  <para style="q2" vid="PRO 11:18">परंतु जो धार्मिकता का बीज बोता है,</para>
  <para style="q3" vid="PRO 11:18">उसे सच्‍चा प्रतिफल मिलता है।<verse eid="PRO 11:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />जो धार्मिकता में स्थिर रहता है,</para>
  <para style="q2" vid="PRO 11:19">वह जीवन की ओर जाता है;</para>
  <para style="q1" vid="PRO 11:19">परंतु जो बुराई का पीछा करता है,</para>
  <para style="q2" vid="PRO 11:19">वह मृत्यु की ओर बढ़ता है।<verse eid="PRO 11:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />जिनके हृदय कुटिल हैं उनसे यहोवा घृणा करता है,</para>
  <para style="q2" vid="PRO 11:20">परंतु खरी चाल चलनेवालों से वह प्रसन्‍न‍ होता है।<verse eid="PRO 11:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />दुष्‍ट मनुष्य को निश्‍चय ही दंड मिलेगा,</para>
  <para style="q2" vid="PRO 11:21">परंतु धर्मी का वंश छुटकारा पाएगा।<verse eid="PRO 11:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />सुंदर परंतु विवेकहीन स्‍त्री,</para>
  <para style="q2" vid="PRO 11:22">थूथन में सोने की नथ पहने सूअर</para>
  <para style="q3" vid="PRO 11:22">के समान होती है।<verse eid="PRO 11:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />धर्मियों की अभिलाषा का परिणाम तो भलाई,</para>
  <para style="q2" vid="PRO 11:23">परंतु दुष्‍टों की आशा का परिणाम प्रकोप होता है।<verse eid="PRO 11:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />कोई तो उदारता से देता है,</para>
  <para style="q2" vid="PRO 11:24">फिर भी उसकी बढ़ती होती है;</para>
  <para style="q1" vid="PRO 11:24">और कोई तो जितना देना चाहिए उससे कम देता है,</para>
  <para style="q2" vid="PRO 11:24">फिर भी उसे घटी ही रहती है।<verse eid="PRO 11:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />उदार व्यक्‍ति संपन्‍न हो जाता है;</para>
  <para style="q2" vid="PRO 11:25">और जो दूसरों की खेती सींचता है,</para>
  <para style="q3" vid="PRO 11:25">उसकी भी सींची जाएगी।<verse eid="PRO 11:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />जो अनाज की जमाखोरी करता है,</para>
  <para style="q2" vid="PRO 11:26">उसे लोग शाप देते हैं;</para>
  <para style="q1" vid="PRO 11:26">परंतु जो उसको बेच देता है,</para>
  <para style="q2" vid="PRO 11:26">उसे आशीर्वाद दिया जाता है।<verse eid="PRO 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />जो यत्‍न से भलाई को ढूँढ़ता है,</para>
  <para style="q2" vid="PRO 11:27">उसे कृपा प्राप्‍त होती है;</para>
  <para style="q1" vid="PRO 11:27">परंतु जो बुराई को खोजता है,</para>
  <para style="q2" vid="PRO 11:27">उसे बुराई ही मिलती है।<verse eid="PRO 11:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />अपने धन पर भरोसा रखनेवाले का</para>
  <para style="q2" vid="PRO 11:28">पतन हो जाता है,</para>
  <para style="q3" vid="PRO 11:28">परंतु धर्मी लोग हरे पत्तों के समान लहलहाते रहते हैं।<verse eid="PRO 11:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />जो अपने घराने को दुःख देता है,</para>
  <para style="q2" vid="PRO 11:29">उसका भाग वायु ही होगा;</para>
  <para style="q1" vid="PRO 11:29">और जो मूर्ख है,</para>
  <para style="q2" vid="PRO 11:29">वह बुद्धिमान का दास हो जाएगा।<verse eid="PRO 11:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />धर्मी मनुष्य का फल जीवन का वृक्ष है,</para>
  <para style="q2" vid="PRO 11:30">और जो आत्माओं को जीत लेता है</para>
  <para style="q3" vid="PRO 11:30">वह बुद्धिमान है।<note caller="+" style="f"><char style="fr" closed="false">11:30 </char><char style="ft" closed="false">कुछ हस्तलेखों के अनुसार इस वाक्य का अनुवाद इस प्रकार है : “परंतु हिंसा प्राणों को छीन लेती है।”</char></note><verse eid="PRO 11:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />यदि धर्मी को पृथ्वी पर फल मिलता है,</para>
  <para style="q2" vid="PRO 11:31">तो निश्‍चय है कि दुष्‍ट और पापी को भी मिलेगा।<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />जो कोई शिक्षा से प्रीति रखता है,</para>
  <para style="q2" vid="PRO 12:1">वह ज्ञान से प्रीति रखता है;</para>
  <para style="q1" vid="PRO 12:1">परंतु जो ताड़ना से घृणा करता है,</para>
  <para style="q2" vid="PRO 12:1">वह पशु के समान निर्बुद्धि है।<verse eid="PRO 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />भले मनुष्य पर यहोवा कृपा करता है,</para>
  <para style="q2" vid="PRO 12:2">परंतु बुरी युक्‍ति रचनेवाले को वह दोषी ठहराता है।<verse eid="PRO 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />दुष्‍टता करने के द्वारा कोई मनुष्य स्थिर नहीं होता,</para>
  <para style="q2" vid="PRO 12:3">परंतु धर्मियों की जड़ कभी नहीं उखड़ती।<verse eid="PRO 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />गुणी पत्‍नी अपने पति का मुकुट है,</para>
  <para style="q2" vid="PRO 12:4">परंतु निर्लज्‍ज पत्‍नी उसकी हड्डियों की सड़ाहट के समान है।<verse eid="PRO 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />धर्मियों के विचार न्यायसंगत होते हैं,</para>
  <para style="q2" vid="PRO 12:5">परंतु दुष्‍टों की युक्‍तियाँ कपटपूर्ण होती हैं।<verse eid="PRO 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />दुष्‍टों के शब्द प्राणघातक होते हैं,</para>
  <para style="q2" vid="PRO 12:6">परंतु सीधे लोगों की बातें लोगों की रक्षा करती हैं।<verse eid="PRO 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />दुष्‍ट उखाड़ फेंके जाते हैं और वे मिट जाते हैं,</para>
  <para style="q2" vid="PRO 12:7">परंतु धर्मियों का घराना बना रहता है।<verse eid="PRO 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />मनुष्य अपनी बुद्धि के अनुरूप प्रशंसा पाता है,</para>
  <para style="q2" vid="PRO 12:8">परंतु कुटिल मनवाला तुच्छ समझा जाता है।<verse eid="PRO 12:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />सेवक रखनेवाला छोटा मनुष्य उस बड़ाई मारनेवाले मनुष्य से उत्तम है</para>
  <para style="q2" vid="PRO 12:9">जो रोटी के लिए तरसता है।<verse eid="PRO 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />धर्मी अपने पशु के जीवन की भी सुधि लेता है,</para>
  <para style="q2" vid="PRO 12:10">परंतु दुष्‍टों की दया में भी क्रूरता दिखाई देती है।<verse eid="PRO 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />जो अपनी भूमि को जोतेगा,</para>
  <para style="q2" vid="PRO 12:11">उसके पास भरपूर भोजन होगा;</para>
  <para style="q1" vid="PRO 12:11">परंतु जो व्यर्थ कामों में लगा रहता है,</para>
  <para style="q2" vid="PRO 12:11">वह निर्बुद्धि ठहरता है।<verse eid="PRO 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />दुष्‍ट जन बुरे लोगों की लूट की लालसा करते हैं,</para>
  <para style="q2" vid="PRO 12:12">परंतु धर्मियों की जड़ फलवंत होती है।<verse eid="PRO 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />बुरा मनुष्य अपने ही दुर्वचनों के जाल में फँस जाता है,</para>
  <para style="q2" vid="PRO 12:13">परंतु धर्मी संकट से बच निकलता है।<verse eid="PRO 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />मनुष्य अपने मुँह से निकले शब्दों<note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="ft" closed="false">अक्षरशः फल</char></note> के अनुसार भली वस्तुओं से तृप्‍त होता है,</para>
  <para style="q2" vid="PRO 12:14">और उसे अपने ही हाथों के कार्य का प्रतिफल मिलता है।<verse eid="PRO 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />मूर्ख अपने चाल-चलन को अपनी दृष्‍टि में ठीक समझता है;</para>
  <para style="q2" vid="PRO 12:15">परंतु जो सम्मति पर ध्यान देता है,</para>
  <para style="q3" vid="PRO 12:15">वही बुद्धिमान है।<verse eid="PRO 12:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />मूर्ख की रिस तुरंत प्रकट हो जाती है,</para>
  <para style="q2" vid="PRO 12:16">परंतु समझदार व्यक्‍ति अपमान को छिपा रखता है।<verse eid="PRO 12:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />सच बोलनेवाला सच्‍चाई प्रकट करता है,</para>
  <para style="q2" vid="PRO 12:17">परंतु झूठा गवाह झूठ बोलता है।<verse eid="PRO 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />बिना सोचे-समझे बोलनेवाले की बातें तलवार के समान चुभती हैं,</para>
  <para style="q2" vid="PRO 12:18">परंतु बुद्धिमान की बातें स्वस्थ करती हैं।<verse eid="PRO 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />सच्‍चाई<note caller="+" style="f"><char style="fr" closed="false">12:19 </char><char style="ft" closed="false">अक्षरशः सच्‍चे होंठ</char></note> सदा बनी रहेगी,</para>
  <para style="q2" vid="PRO 12:19">परंतु झूठ<note caller="+" style="f"><char style="fr" closed="false">12:19 </char><char style="ft" closed="false">अक्षरशः झूठी जीभ</char></note> पल भर का ही होता है।<verse eid="PRO 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />बुरी युक्‍ति रचनेवालों के मन में छल रहता है,</para>
  <para style="q2" vid="PRO 12:20">परंतु मेल की सम्मति देनेवाले आनंदित रहते हैं।<verse eid="PRO 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />धर्मी की कोई हानि नहीं होती,</para>
  <para style="q2" vid="PRO 12:21">परंतु दुष्‍ट लोग विपत्तियों से घिरे रहते हैं।<verse eid="PRO 12:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />यहोवा को झूठ बोलनेवाले होंठों से घृणा है;</para>
  <para style="q2" vid="PRO 12:22">परंतु जो लोग विश्‍वासयोग्यता से कार्य करते हैं,</para>
  <para style="q3" vid="PRO 12:22">उनसे वह प्रसन्‍न‍ होता है।<verse eid="PRO 12:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />समझदार मनुष्य ज्ञान को छिपाए रखता है,</para>
  <para style="q2" vid="PRO 12:23">परंतु मूर्ख अपने मन की मूर्खता का प्रदर्शन करता है।<verse eid="PRO 12:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />परिश्रम करनेवाले हाथ प्रभुता करते हैं,</para>
  <para style="q2" vid="PRO 12:24">परंतु आलसी हाथों को बेगारी में लगाया जाता है।<verse eid="PRO 12:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />चिंता से मनुष्य का मन निराश हो जाता है,</para>
  <para style="q2" vid="PRO 12:25">परंतु भली बात उसे आनंदित कर देती है।<verse eid="PRO 12:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />धर्मी अपने मित्र का मार्गदर्शन करता है,</para>
  <para style="q2" vid="PRO 12:26">परंतु दुष्‍टों की चाल उन्हीं को भटका देती है।<verse eid="PRO 12:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />आलसी के हाथ अहेर नहीं लगता,</para>
  <para style="q2" vid="PRO 12:27">परंतु परिश्रमी मनुष्य को अनमोल धन प्राप्‍त होता है।<verse eid="PRO 12:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />धार्मिकता के मार्ग में जीवन है,</para>
  <para style="q2" vid="PRO 12:28">और उसके पथ में मृत्यु है ही नहीं।<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />बुद्धिमान पुत्र अपने पिता की शिक्षा को ध्यान से सुनता है,</para>
  <para style="q2" vid="PRO 13:1">परंतु ठट्ठा करनेवाला डाँट-डपट पर भी ध्यान नहीं देता।<verse eid="PRO 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />मनुष्य अपने मुँह से निकले शब्दों के कारण</para>
  <para style="q2" vid="PRO 13:2">भली वस्तुओं का आनंद उठाता है,</para>
  <para style="q1" vid="PRO 13:2">परंतु विश्‍वासघाती लोगों का मन हिंसा से ही</para>
  <para style="q2" vid="PRO 13:2">तृप्‍त होता है।<verse eid="PRO 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />जो अपने मुँह की चौकसी करता है,</para>
  <para style="q2" vid="PRO 13:3">वह अपने प्राण की रक्षा करता है;</para>
  <para style="q1" vid="PRO 13:3">पर जो व्यर्थ की बातें करता है,</para>
  <para style="q2" vid="PRO 13:3">उसका विनाश होता है।<verse eid="PRO 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />आलसी लालसा तो करता है,</para>
  <para style="q2" vid="PRO 13:4">फिर भी उसे कुछ नहीं मिलता;</para>
  <para style="q3" vid="PRO 13:4">परंतु परिश्रमी की लालसा पूरी होती है।<verse eid="PRO 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />धर्मी मनुष्य झूठ बोलने से घृणा करता है,</para>
  <para style="q2" vid="PRO 13:5">परंतु दुष्‍ट मनुष्य लज्‍जा और अपमान के कार्य करता है।<verse eid="PRO 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />धार्मिकता, खराई से चलनेवाले व्यक्‍ति की रक्षा करती है;</para>
  <para style="q2" vid="PRO 13:6">परंतु दुष्‍टता के कारण पापी का नाश हो जाता है।<verse eid="PRO 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />कोई तो धनी होने का दिखावा करता है,</para>
  <para style="q2" vid="PRO 13:7">जबकि उसके पास कुछ नहीं होता;</para>
  <para style="q1" vid="PRO 13:7">और कोई कंगाल होने का दिखावा करता है,</para>
  <para style="q2" vid="PRO 13:7">जबकि उसके पास बहुत धन-संपत्ति होती है।<verse eid="PRO 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />मनुष्य के प्राण की फिरौती उसका धन है,</para>
  <para style="q2" vid="PRO 13:8">परंतु निर्धन को ऐसी धमकी नहीं मिलती।<verse eid="PRO 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />धर्मियों की ज्योति तेज़ चमकती है,</para>
  <para style="q2" vid="PRO 13:9">परंतु दुष्‍टों का दीपक बुझ जाता है।<verse eid="PRO 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />अहंकार से झगड़े ही उत्पन्‍न‍ होते हैं;</para>
  <para style="q2" vid="PRO 13:10">परंतु जो लोग सम्मति को मानते हैं,</para>
  <para style="q3" vid="PRO 13:10">उनमें बुद्धि होती है।<verse eid="PRO 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />छल से कमाया गया धन घटता जाता है,</para>
  <para style="q2" vid="PRO 13:11">पर परिश्रम करके जमा किया गया धन बढ़ता जाता है।<verse eid="PRO 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />आशा में विलंब होने से मन उदास हो जाता है,</para>
  <para style="q2" vid="PRO 13:12">परंतु इच्छा की पूर्ति होना जीवन के</para>
  <para style="q3" vid="PRO 13:12">वृक्ष के समान है।<verse eid="PRO 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />जो शिक्षा को तुच्छ जानता है,</para>
  <para style="q2" vid="PRO 13:13">वह नष्‍ट हो जाता है;</para>
  <para style="q1" vid="PRO 13:13">परंतु आज्ञा का आदर करनेवाले को</para>
  <para style="q2" vid="PRO 13:13">अच्छा फल मिलता है।<verse eid="PRO 13:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />बुद्धिमान की शिक्षा जीवन का सोता है,</para>
  <para style="q2" vid="PRO 13:14">जो मनुष्य को मृत्यु के फंदों से बचाती है।<verse eid="PRO 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />सुबुद्धि से कृपा प्राप्‍त होती है,</para>
  <para style="q2" vid="PRO 13:15">परंतु विश्‍वासघातियों का मार्ग कठोर होता है।<verse eid="PRO 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />प्रत्येक समझदार मनुष्य बुद्धि से कार्य करता है,</para>
  <para style="q2" vid="PRO 13:16">परंतु मूर्ख अपनी मूर्खता का प्रदर्शन करता है।<verse eid="PRO 13:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />दुष्‍ट संदेशवाहक संकट में पड़ता है,</para>
  <para style="q2" vid="PRO 13:17">परंतु विश्‍वासयोग्य दूत कुशल-क्षेम लाता है।<verse eid="PRO 13:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />जो शिक्षा की उपेक्षा करता है,</para>
  <para style="q2" vid="PRO 13:18">उसे निर्धनता और अपमान का सामना करना पड़ता है;</para>
  <para style="q1" vid="PRO 13:18">परंतु जो ताड़ना को स्वीकार करता है,</para>
  <para style="q2" vid="PRO 13:18">उसका सम्मान होता है।<verse eid="PRO 13:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />इच्छा का पूरा होना तो प्राण को सुखद लगता है,</para>
  <para style="q2" vid="PRO 13:19">परंतु बुराई से हटना मूर्खों को बुरा लगता है।<verse eid="PRO 13:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />जो बुद्धिमान के साथ संगति करता है,</para>
  <para style="q2" vid="PRO 13:20">वह बुद्धिमान हो जाता है;</para>
  <para style="q1" vid="PRO 13:20">परंतु जो मूर्खों का साथी होता है,</para>
  <para style="q2" vid="PRO 13:20">वह हानि उठाता है।<verse eid="PRO 13:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />विपत्ति पापियों के पीछे पड़ती है,</para>
  <para style="q2" vid="PRO 13:21">परंतु धर्मियों का प्रतिफल सुख-समृद्धि होता है।<verse eid="PRO 13:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />भला मनुष्य अपने नाती-पोतों के लिए धन-संपत्ति छोड़ जाता है,</para>
  <para style="q2" vid="PRO 13:22">परंतु पापी की संपत्ति धर्मी के लिए रखी जाती है।<verse eid="PRO 13:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />निर्धन के खेत में बहुतायत से अन्‍न‍ होता है,</para>
  <para style="q2" vid="PRO 13:23">परंतु अन्याय के द्वारा उसे हड़प लिया जाता है।<verse eid="PRO 13:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />जो अपने पुत्र को सुधारने के लिए छड़ी नहीं उठाता,</para>
  <para style="q2" vid="PRO 13:24">वह उसका बैरी है;</para>
  <para style="q1" vid="PRO 13:24">परंतु जो उससे प्रेम रखता है,</para>
  <para style="q2" vid="PRO 13:24">वह यत्‍न से उसे अनुशासित करता है।<verse eid="PRO 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />धर्मी भरपेट खाना खाता है,</para>
  <para style="q2" vid="PRO 13:25">परंतु दुष्‍ट भूखे ही रहते हैं।<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />बुद्धिमान स्‍त्री अपने घर को बनाती है,</para>
  <para style="q2" vid="PRO 14:1">परंतु मूर्ख स्‍त्री उसे अपने ही</para>
  <para style="q3" vid="PRO 14:1">हाथों से उजाड़ देती है।<verse eid="PRO 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />जो खराई से चलता है,</para>
  <para style="q2" vid="PRO 14:2">वह यहोवा का भय मानता है;</para>
  <para style="q1" vid="PRO 14:2">परंतु जो टेढ़ी चाल चलता है,</para>
  <para style="q2" vid="PRO 14:2">वह उसे तुच्छ जानता है।<verse eid="PRO 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />मूर्ख की बातें उसकी पीठ पर छड़ी लगवाती हैं,</para>
  <para style="q2" vid="PRO 14:3">परंतु बुद्धिमानों के शब्द उनकी रक्षा करते हैं।<verse eid="PRO 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />जहाँ बैल नहीं, वहाँ चरनी साफ़ तो रहती है,</para>
  <para style="q2" vid="PRO 14:4">परंतु बैल के बल से बहुतायत की उपज होती है।<verse eid="PRO 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />सच्‍चा गवाह झूठ नहीं बोलता,</para>
  <para style="q2" vid="PRO 14:5">परंतु झूठा गवाह झूठी बातें बोलता है।<verse eid="PRO 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />ठट्ठा करनेवाला व्यक्‍ति बुद्धि को ढूँढ़ता है, पर नहीं पाता;</para>
  <para style="q2" vid="PRO 14:6">परंतु समझदार व्यक्‍ति सहजता से ज्ञान प्राप्‍त करता है।<verse eid="PRO 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />मूर्ख से अलग हो जा,</para>
  <para style="q2" vid="PRO 14:7">नहीं तो तू ज्ञान की बातों को समझ नहीं पाएगा।<verse eid="PRO 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />समझदार मनुष्य की बुद्धिमानी अपनी चाल को पहचानना है,</para>
  <para style="q2" vid="PRO 14:8">परंतु मूर्खों की मूर्खता उन्हीं को धोखा देती है।<verse eid="PRO 14:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />मूर्ख लोग पाप को ठट्ठों में उड़ाते हैं,</para>
  <para style="q2" vid="PRO 14:9">परंतु सीधे लोगों के बीच आपस में सद्भाव पाया जाता है।<verse eid="PRO 14:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />मन अपने दुःख को स्वयं जानता है,</para>
  <para style="q2" vid="PRO 14:10">और कोई पराया उसके आनंद में सहभागी नहीं होता।<verse eid="PRO 14:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />दुष्‍टों के घर नष्‍ट हो जाएँगे,</para>
  <para style="q2" vid="PRO 14:11">परंतु सीधे लोगों का डेरा आबाद रहेगा।<verse eid="PRO 14:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />ऐसा मार्ग भी है जो मनुष्य को ठीक प्रतीत होता है,</para>
  <para style="q2" vid="PRO 14:12">परंतु अंत में वह मृत्यु का मार्ग सिद्ध होता है।<verse eid="PRO 14:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />हँसी के समय मन उदास हो सकता है,</para>
  <para style="q2" vid="PRO 14:13">और आनंद का अंत शोक भी हो सकता है।<verse eid="PRO 14:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />जिसका मन परमेश्‍वर से हट जाता है,</para>
  <para style="q2" vid="PRO 14:14">वह अपने आचरण का फल भोगता है,</para>
  <para style="q3" vid="PRO 14:14">परंतु भला मनुष्य अपने अच्छे कार्यों के फल से तृप्‍त होता है।<verse eid="PRO 14:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />भोला मनुष्य तो हर बात पर विश्‍वास करता है,</para>
  <para style="q2" vid="PRO 14:15">परंतु समझदार मनुष्य समझ बूझकर कदम बढ़ाता है।<verse eid="PRO 14:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />बुद्धिमान मनुष्य बुराई से डरता और उससे दूर रहता है,</para>
  <para style="q2" vid="PRO 14:16">परंतु मूर्ख ढीठ और लापरवाह होता है।<verse eid="PRO 14:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />शीघ्र क्रोध करनेवाला मनुष्य मूर्खतापूर्ण कार्य करता है,</para>
  <para style="q2" vid="PRO 14:17">और जो बुरी युक्‍तियाँ रचता है उससे लोग बैर रखते हैं।<verse eid="PRO 14:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />भोलों का भाग मूर्खता ही होता है,</para>
  <para style="q2" vid="PRO 14:18">परंतु समझदार लोगों को ज्ञान का मुकुट पहनाया जाता है।<verse eid="PRO 14:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />बुरे लोग भलों के सम्मुख,</para>
  <para style="q2" vid="PRO 14:19">और दुष्‍ट लोग धर्मियों के फाटकों पर सिर झुकाएँगे।<verse eid="PRO 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />निर्धन से उसका पड़ोसी भी घृणा करता है,</para>
  <para style="q2" vid="PRO 14:20">परंतु धनवान के अनेक मित्र होते हैं।<verse eid="PRO 14:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />जो अपने पड़ोसी को तुच्छ जानता है, वह पाप करता है;</para>
  <para style="q2" vid="PRO 14:21">परंतु जो दीन लोगों पर दया करता है, वह धन्य है।<verse eid="PRO 14:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />क्या बुरी युक्‍ति रचनेवाले भटक नहीं जाते?</para>
  <para style="q2" vid="PRO 14:22">परंतु भली योजना बनानेवालों के साथ</para>
  <para style="q3" vid="PRO 14:22">करुणा और सच्‍चाई का व्यवहार होता है।<verse eid="PRO 14:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />परिश्रम से सदा लाभ होता है,</para>
  <para style="q2" vid="PRO 14:23">परंतु कोरी बकबक से घटी ही होती है।<verse eid="PRO 14:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />बुद्धिमानों का धन उनका मुकुट है,</para>
  <para style="q2" vid="PRO 14:24">परंतु मूर्खों के गले की माला मूर्खता है।<verse eid="PRO 14:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />सच्‍चा गवाह बहुतों के प्राण बचाता है,</para>
  <para style="q2" vid="PRO 14:25">परंतु जो झूठ बोलता है, वह धोखेबाज़ होता है।<verse eid="PRO 14:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />यहोवा का भय माननेवाले को दृढ़ भरोसा प्राप्‍त होता है,</para>
  <para style="q2" vid="PRO 14:26">और उसकी संतान को शरणस्थान मिलता है।<verse eid="PRO 14:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />यहोवा का भय मानना जीवन का सोता है,</para>
  <para style="q2" vid="PRO 14:27">जिससे लोग मृत्यु के फंदों से बच जाते हैं।<verse eid="PRO 14:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />प्रजा की बहुतायत ही राजा की महिमा है,</para>
  <para style="q2" vid="PRO 14:28">परंतु प्रजा के बिना शासक बरबाद हो जाता है।<verse eid="PRO 14:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />जो क्रोध करने में धीमा होता है, वह बहुत समझवाला है;</para>
  <para style="q2" vid="PRO 14:29">परंतु जो क्रोध करने में उतावली करता है, वह मूर्खता को बढ़ाता है।<verse eid="PRO 14:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />शांत मन, तन का जीवन है;</para>
  <para style="q2" vid="PRO 14:30">परंतु ईर्ष्या हड्डियों को गला देती है।<verse eid="PRO 14:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />जो कंगाल पर अंधेर करता है, वह उसके सृजनहार की निंदा करता है;</para>
  <para style="q2" vid="PRO 14:31">परंतु जो दरिद्र पर दया करता है, वह परमेश्‍वर का आदर करता है।<verse eid="PRO 14:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />दुष्‍ट मनुष्य अपने दुष्कर्मों के द्वारा नष्‍ट हो जाता है,</para>
  <para style="q2" vid="PRO 14:32">परंतु धर्मी अपनी मृत्यु के समय भी शरण पाता है।<verse eid="PRO 14:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />समझदार व्यक्‍ति के मन में बुद्धि का वास होता है,</para>
  <para style="q2" vid="PRO 14:33">यहाँ तक कि वह तो मूर्खों के बीच भी प्रकट होती है।<verse eid="PRO 14:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />धार्मिकता से राष्‍ट्र का उत्थान होता है,</para>
  <para style="q2" vid="PRO 14:34">परंतु पाप देश के लिए कलंक है।<verse eid="PRO 14:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />जो सेवक बुद्धिमानी से कार्य करता है, राजा उससे प्रसन्‍न‍ होता है;</para>
  <para style="q2" vid="PRO 14:35">परंतु जो लज्‍जाजनक कार्य करता है, उस पर उसका क्रोध भड़कता है।<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />विनम्र उत्तर सुनने से क्रोध शांत हो जाता है,</para>
  <para style="q2" vid="PRO 15:1">परंतु कटु वचन सुनकर क्रोध भड़क उठता है।<verse eid="PRO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />बुद्धिमानों की जीभ ज्ञान का उचित प्रयोग करती है,</para>
  <para style="q2" vid="PRO 15:2">परंतु मूर्खों का मुँह मूर्खता ही उगलता है।<verse eid="PRO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />यहोवा की आँखें सब स्थानों में लगी रहती हैं,</para>
  <para style="q2" vid="PRO 15:3">वे बुरे और भले दोनों को देखती रहती हैं।<verse eid="PRO 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />शांति देनेवाली जीभ जीवन का वृक्ष है,</para>
  <para style="q2" vid="PRO 15:4">परंतु कुटिल बातों से आत्मा दुःखी होती है।<verse eid="PRO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />मूर्ख अपने पिता की शिक्षा का तिरस्कार करता है,</para>
  <para style="q2" vid="PRO 15:5">परंतु जो पिता की ताड़ना पर ध्यान देता है,</para>
  <para style="q3" vid="PRO 15:5">वह समझदार है।<verse eid="PRO 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />धर्मी के घर में बहुत धन रहता है,</para>
  <para style="q2" vid="PRO 15:6">परंतु दुष्‍ट की कमाई में दुःख पाया जाता है।<verse eid="PRO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />बुद्धिमानों का मुँह ज्ञान फैलाता है,</para>
  <para style="q2" vid="PRO 15:7">परंतु मूर्खों का मन ऐसा नहीं करता।<verse eid="PRO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />दुष्‍ट लोगों के बलिदान से यहोवा घृणा करता है,</para>
  <para style="q2" vid="PRO 15:8">परंतु सीधे लोगों की प्रार्थना से वह प्रसन्‍न‍ होता है।<verse eid="PRO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />दुष्‍ट के चाल-चलन से यहोवा घृणा करता है,</para>
  <para style="q2" vid="PRO 15:9">परंतु जो धार्मिकता का पीछा करता है,</para>
  <para style="q3" vid="PRO 15:9">उससे वह प्रेम रखता है।<verse eid="PRO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />जो मार्ग को छोड़ देता है,</para>
  <para style="q2" vid="PRO 15:10">उसकी बड़ी ताड़ना होती है;</para>
  <para style="q1" vid="PRO 15:10">और जो डाँट से बैर रखता है,</para>
  <para style="q2" vid="PRO 15:10">वह मर जाता है।<verse eid="PRO 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />जब अधोलोक और विनाशलोक यहोवा के सामने खुले रहते हैं,</para>
  <para style="q2" vid="PRO 15:11">तो मनुष्यों के मन और भी कितने अधिक खुले होंगे!<verse eid="PRO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />ठट्ठा करनेवाला अपने डाँटनेवाले से प्रेम नहीं करता,</para>
  <para style="q2" vid="PRO 15:12">और न ही वह बुद्धिमानों के पास जाता है।<verse eid="PRO 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />जब मन आनंदित होता है तो मुख पर प्रसन्‍न‍ता छा जाती है,</para>
  <para style="q2" vid="PRO 15:13">परंतु जब मन दुःखी होता है</para>
  <para style="q3" vid="PRO 15:13">तो आत्मा भी निराश हो जाती है।<verse eid="PRO 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />समझदार मनुष्य का मन ज्ञान की खोज में रहता है,</para>
  <para style="q2" vid="PRO 15:14">परंतु मूर्ख लोग मूर्खता से ही पेट भरते हैं।<verse eid="PRO 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />दुःखी व्यक्‍ति के सब दिन बुरे होते हैं;</para>
  <para style="q2" vid="PRO 15:15">परंतु जिसका मन प्रसन्‍न‍ रहता है,</para>
  <para style="q3" vid="PRO 15:15">वह सदैव उत्सव मनाता है।<verse eid="PRO 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />यहोवा का भय मानने के साथ थोड़ा ही धन, उस अपार संपत्ति से उत्तम है</para>
  <para style="q2" vid="PRO 15:16">जिसमें कष्‍ट पाए जाते हों।<verse eid="PRO 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />प्रेमवाले घर में सागपात का भोजन,</para>
  <para style="q2" vid="PRO 15:17">बैरवाले घर में मोटे पशु के मांस से उत्तम है।<verse eid="PRO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />क्रोधी मनुष्य झगड़ा भड़काता है,</para>
  <para style="q2" vid="PRO 15:18">परंतु जो क्रोध करने में धीमा है,</para>
  <para style="q3" vid="PRO 15:18">वह झगड़े को शांत करता है।<verse eid="PRO 15:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />आलसी का मार्ग काँटों से भरा हुआ होता है,</para>
  <para style="q2" vid="PRO 15:19">परंतु सीधे लोगों का मार्ग समतल होता है।<verse eid="PRO 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />बुद्धिमान पुत्र अपने पिता को प्रसन्‍न‍ करता है,</para>
  <para style="q2" vid="PRO 15:20">परंतु मूर्ख व्यक्‍ति अपनी माता को तुच्छ जानता है।<verse eid="PRO 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />नासमझ मनुष्य के लिए मूर्खता आनंद की बात है,</para>
  <para style="q2" vid="PRO 15:21">परंतु समझवाला मनुष्य सीधी चाल चलता है।<verse eid="PRO 15:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />सम्मति के बिना योजनाएँ निष्फल हो जाती हैं,</para>
  <para style="q2" vid="PRO 15:22">परंतु कई सलाहकार होने से वे सफल होती हैं।<verse eid="PRO 15:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />सटीक उत्तर देना मनुष्य के लिए आनंद की बात है,</para>
  <para style="q2" vid="PRO 15:23">और उपयुक्‍त समय पर कहा गया वचन कितना अच्छा होता है!<verse eid="PRO 15:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />बुद्धिमान के लिए जीवन का मार्ग ऊपर की ओर जाता है,</para>
  <para style="q2" vid="PRO 15:24">जिससे कि वह अधोलोक में जाने से बच जाए।<verse eid="PRO 15:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />यहोवा घमंडियों के घर को ढा देगा,</para>
  <para style="q2" vid="PRO 15:25">परंतु वह विधवा की भूमि को सुरक्षित रखेगा।<verse eid="PRO 15:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />दुष्‍टता भरी योजनाओं से यहोवा घृणा करता है,</para>
  <para style="q2" vid="PRO 15:26">परंतु मधुर वचन मनभावने होते हैं।<verse eid="PRO 15:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />जो अनुचित कमाई का लोभी है,</para>
  <para style="q2" vid="PRO 15:27">वह अपने घर पर कष्‍ट लाता है;</para>
  <para style="q1" vid="PRO 15:27">परंतु जो घूस से घृणा करता है,</para>
  <para style="q2" vid="PRO 15:27">वह जीवित रहेगा।<verse eid="PRO 15:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />धर्मी मनुष्य अपने मन में सोचता है कि वह क्या उत्तर दे,</para>
  <para style="q2" vid="PRO 15:28">परंतु दुष्‍टों का मुँह बुरी बातें उगलता है।<verse eid="PRO 15:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />यहोवा दुष्‍टों से दूर रहता है,</para>
  <para style="q2" vid="PRO 15:29">परंतु वह धर्मियों की प्रार्थना सुनता है।<verse eid="PRO 15:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />आँखों की चमक से मन आनंदित होता है,</para>
  <para style="q2" vid="PRO 15:30">और अच्छे समाचार से हड्डियाँ पुष्‍ट होती हैं।<verse eid="PRO 15:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />जिसके कान जीवनदायक डाँट को सुनते हैं,</para>
  <para style="q2" vid="PRO 15:31">वह बुद्धिमानों के मध्य निवास करेगा।<verse eid="PRO 15:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />जो शिक्षा की उपेक्षा करता है,</para>
  <para style="q2" vid="PRO 15:32">वह अपने प्राण को तुच्छ जानता है;</para>
  <para style="q1" vid="PRO 15:32">परंतु जो ताड़ना पर ध्यान देता है,</para>
  <para style="q2" vid="PRO 15:32">वह समझ प्राप्‍त करता है।<verse eid="PRO 15:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />यहोवा का भय मानने से बुद्धि प्राप्‍त होती है,</para>
  <para style="q2" vid="PRO 15:33">और आदर प्राप्‍त होने से पहले नम्रता आती है।<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />मनुष्य के मन में विचार उत्पन्‍न होते हैं,</para>
  <para style="q2" vid="PRO 16:1">परंतु मुँह के बोल यहोवा की ओर से होते हैं।<verse eid="PRO 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />मनुष्य का सारा चाल-चलन उसकी अपनी दृष्‍टि में तो उचित होता है,</para>
  <para style="q2" vid="PRO 16:2">परंतु यहोवा मन को तौलता है।<verse eid="PRO 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />अपने कार्यों को यहोवा के हाथ में सौंप दे,</para>
  <para style="q2" vid="PRO 16:3">इससे तेरी योजनाएँ सफल होंगी।<verse eid="PRO 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />यहोवा ने हर वस्तु को एक उद्देश्य के लिए रचा है,</para>
  <para style="q2" vid="PRO 16:4">यहाँ तक कि दुष्‍ट को विपत्ति के दिन के लिए।<verse eid="PRO 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />प्रत्येक अहंकारी मन से यहोवा घृणा करता है;</para>
  <para style="q2" vid="PRO 16:5">वह उसे निश्‍चय दंड देगा।<verse eid="PRO 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />अधर्म का प्रायश्‍चित्त करुणा और सच्‍चाई से होता है,</para>
  <para style="q2" vid="PRO 16:6">और यहोवा का भय मानने से मनुष्य बुराई से दूर रहता है।<verse eid="PRO 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />जब यहोवा मनुष्य के चाल-चलन से प्रसन्‍न‍ होता है,</para>
  <para style="q2" vid="PRO 16:7">तो वह उसके शत्रुओं का भी उससे मेल करा देता है।<verse eid="PRO 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />धार्मिकता से कमाया गया थोड़ा धन,</para>
  <para style="q2" vid="PRO 16:8">अन्याय की बड़ी कमाई से उत्तम है।<verse eid="PRO 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />मनुष्य का मन उसके मार्ग की योजनाएँ बनाता है,</para>
  <para style="q2" vid="PRO 16:9">परंतु यहोवा उसके प्रत्येक कदम को निर्धारित करता है।<verse eid="PRO 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />राजा के मुँह से दिव्य वाणी निकलती है;</para>
  <para style="q2" vid="PRO 16:10">न्याय करने में उससे कोई चूक नहीं होती।<verse eid="PRO 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />सच्‍चा तराजू और पलड़े यहोवा ही के हैं;</para>
  <para style="q2" vid="PRO 16:11">थैली के सब बाट उसी के बनाए हुए हैं।<verse eid="PRO 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />दुष्‍टता करना राजाओं के लिए घृणित कार्य है,</para>
  <para style="q2" vid="PRO 16:12">क्योंकि सिंहासन धार्मिकता से ही स्थिर रहता है।<verse eid="PRO 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />धार्मिकता की बातों से राजा प्रसन्‍न‍ होते हैं,</para>
  <para style="q2" vid="PRO 16:13">और सच बोलनेवाले से वे प्रेम रखते हैं।<verse eid="PRO 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />राजा का क्रोध मृत्यु के दूत के समान होता है,</para>
  <para style="q2" vid="PRO 16:14">परंतु बुद्धिमान व्यक्‍ति उसे शांत कर देता है।<verse eid="PRO 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />राजा के मुख की चमक में जीवन होता है,</para>
  <para style="q2" vid="PRO 16:15">और उसकी कृपादृष्‍टि उस बादल के सदृश होती है</para>
  <para style="q3" vid="PRO 16:15">जो वसंत की वर्षा लाता है।<verse eid="PRO 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />बुद्धि को प्राप्‍त करना चोखे सोने से कितना उत्तम है!</para>
  <para style="q2" vid="PRO 16:16">और समझ को प्राप्‍त करना चाँदी से भी बढ़कर है।<verse eid="PRO 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />सीधे लोगों का राजमार्ग बुराई से हटना है;</para>
  <para style="q2" vid="PRO 16:17">जो अपने चाल-चलन की चौकसी करता है,</para>
  <para style="q3" vid="PRO 16:17">वह अपने जीवन की भी रक्षा करता है।<verse eid="PRO 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />विनाश से पहले घमंड,</para>
  <para style="q2" vid="PRO 16:18">और पतन से पहले अहंकार आता है।<verse eid="PRO 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />दीन लोगों के साथ नम्रता से रहना,</para>
  <para style="q2" vid="PRO 16:19">घमंडियों के साथ लूट बाँट लेने से उत्तम है।<verse eid="PRO 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />जो वचन पर मन लगाता है,</para>
  <para style="q2" vid="PRO 16:20">वह भलाई प्राप्‍त करेगा;</para>
  <para style="q1" vid="PRO 16:20">और जो यहोवा पर भरोसा रखता है,</para>
  <para style="q2" vid="PRO 16:20">वह धन्य है।<verse eid="PRO 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />जिसके हृदय में बुद्धि का वास होता है,</para>
  <para style="q2" vid="PRO 16:21">वह समझदार कहलाता है;</para>
  <para style="q1" vid="PRO 16:21">और जो मधुर वाणी बोलता है,</para>
  <para style="q2" vid="PRO 16:21">वह ज्ञान बढ़ाता है।<verse eid="PRO 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />जिसके पास समझ है,</para>
  <para style="q2" vid="PRO 16:22">उसके लिए वह जीवन का सोता है;</para>
  <para style="q3" vid="PRO 16:22">परंतु मूर्खों को ताड़ना देना मूर्खता है।<verse eid="PRO 16:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />बुद्धिमान का हृदय उसके मुँह को बोलना सिखाता है,</para>
  <para style="q2" vid="PRO 16:23">और उसकी बातों में ज्ञान को बढ़ाता है।<verse eid="PRO 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />मनभावने वचन शहद के छत्ते के समान होते हैं;</para>
  <para style="q2" vid="PRO 16:24">वे प्राण के लिए मीठे और देह को स्वस्थ करनेवाले होते हैं।<verse eid="PRO 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />ऐसा मार्ग भी है जो मनुष्य को ठीक प्रतीत होता है,</para>
  <para style="q2" vid="PRO 16:25">परंतु अंत में वह मृत्यु का मार्ग सिद्ध होता है।<verse eid="PRO 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />मज़दूर की भूख उससे परिश्रम करवाती है।</para>
  <para style="q2" vid="PRO 16:26">उसका खाली पेट उसे बाध्य करता है।<verse eid="PRO 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />दुष्‍ट मनुष्य बुराई की युक्‍ति निकालता है,</para>
  <para style="q2" vid="PRO 16:27">और उसके शब्द झुलसानेवाली आग के समान होते हैं।<verse eid="PRO 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />कुटिल मनुष्य झगड़ा उत्पन्‍न करता है,</para>
  <para style="q2" vid="PRO 16:28">और कानाफूसी करनेवाला घनिष्‍ठ मित्रों में भी फूट डाल देता है।<verse eid="PRO 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />उपद्रवी मनुष्य अपने पड़ोसी को फुसलाता है,</para>
  <para style="q2" vid="PRO 16:29">और उसे गलत मार्ग पर ले जाता है।<verse eid="PRO 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />जो आँखों से इशारा करता है,</para>
  <para style="q2" vid="PRO 16:30">वह कुटिल योजनाएँ बनाता है;</para>
  <para style="q1" vid="PRO 16:30">और जो अपने होंठ दबाता है,</para>
  <para style="q2" vid="PRO 16:30">वह बुराई करता है।<verse eid="PRO 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />पके बाल शोभायमान मुकुट ठहरते हैं,</para>
  <para style="q2" vid="PRO 16:31">जो धार्मिकता के मार्ग पर चलने से प्राप्‍त होते हैं।<verse eid="PRO 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />जो क्रोध करने में धीमा है वह वीर योद्धा से,</para>
  <para style="q2" vid="PRO 16:32">और जो अपने मन को वश में रखता है</para>
  <para style="q3" vid="PRO 16:32">वह नगर जीतनेवाले से भी उत्तम है।<verse eid="PRO 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />पर्ची तो डाली जाती है,</para>
  <para style="q2" vid="PRO 16:33">परंतु उसका हर एक निर्णय यहोवा की ओर से होता है।<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />चैन के साथ सूखी रोटी खाना उस घर के स्वादिष्‍ट भोज से उत्तम है,</para>
  <para style="q2" vid="PRO 17:1">जहाँ लड़ाई-झगड़ा होता है।<verse eid="PRO 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />बुद्धिमानी से कार्य करनेवाला सेवक,</para>
  <para style="q2" vid="PRO 17:2">उस पुत्र पर प्रभुता करेगा जो लज्‍जाजनक कार्य करता है;</para>
  <para style="q3" vid="PRO 17:2">वह भाइयों के साथ उत्तराधिकार में सहभागी होगा।<verse eid="PRO 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />चाँदी के लिए कुठाली और सोने के लिए भट्ठी होती है,</para>
  <para style="q2" vid="PRO 17:3">परंतु मनों को यहोवा जाँचता है।<verse eid="PRO 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />कुकर्मी मनुष्य दुष्‍टता की बातों को ध्यान से सुनता है,</para>
  <para style="q2" vid="PRO 17:4">और झूठा मनुष्य विनाशकारी जीभ की बातों पर कान लगाता है।<verse eid="PRO 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />जो निर्धन का उपहास करता है,</para>
  <para style="q2" vid="PRO 17:5">वह उसके सृजनहार की निंदा करता है;</para>
  <para style="q1" vid="PRO 17:5">और जो किसी की विपत्ति पर हँसता है,</para>
  <para style="q2" vid="PRO 17:5">वह निश्‍चय दंड पाएगा।<verse eid="PRO 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />वृद्ध लोगों का मुकुट उनके नाती-पोते होते हैं;</para>
  <para style="q2" vid="PRO 17:6">और बच्‍चों का गौरव उनके माता-पिता हैं।<verse eid="PRO 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />उत्तम बातें बोलना मूर्ख के मुँह से शोभा नहीं देतीं,</para>
  <para style="q2" vid="PRO 17:7">शासक के लिए झूठ बोलना और भी अशोभनीय है।<verse eid="PRO 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />घूस देनेवाला समझता है कि घूस एक जादुई मणि है,</para>
  <para style="q2" vid="PRO 17:8">जहाँ कहीं वह जाता है, उसके काम सफल होते हैं।<verse eid="PRO 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />जो अपराध को ढाँपता है,</para>
  <para style="q2" vid="PRO 17:9">वह प्रेम का खोजी है;</para>
  <para style="q1" vid="PRO 17:9">परंतु जो बात को बार-बार दोहराता है,</para>
  <para style="q2" vid="PRO 17:9">वह घनिष्‍ठ मित्रों में भी फूट डाल देता है।<verse eid="PRO 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />समझदार व्यक्‍ति पर डाँट का इतना गहरा प्रभाव पड़ता है,</para>
  <para style="q2" vid="PRO 17:10">जितना मूर्ख पर सौ घूँसे खाकर भी नहीं पड़ता।<verse eid="PRO 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />बुरा मनुष्य विद्रोह का ही यत्‍न करता है,</para>
  <para style="q2" vid="PRO 17:11">इसलिए उसके विरुद्ध एक क्रूर दूत भेजा जाएगा।<verse eid="PRO 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />मूर्खता से भरे हुए मूर्ख से मिलने की अपेक्षा</para>
  <para style="q2" vid="PRO 17:12">ऐसी रीछनी से मिलना भला है</para>
  <para style="q3" vid="PRO 17:12">जिसके बच्‍चे छीने गए हों।<verse eid="PRO 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />जो कोई भलाई के बदले बुराई करता है,</para>
  <para style="q2" vid="PRO 17:13">उसके घर से बुराई कभी दूर न होगी।<verse eid="PRO 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />झगड़े का आरंभ बाँध में पड़ी दरार के समान है,</para>
  <para style="q2" vid="PRO 17:14">अत: झगड़ा बढ़ने से पहले ही उसे रोक दो।<verse eid="PRO 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />यहोवा दोषी को निर्दोष ठहरानेवाले</para>
  <para style="q2" vid="PRO 17:15">और निर्दोष को दोषी ठहरानेवाले दोनों से घृणा करता है।<verse eid="PRO 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />जब मूर्ख बुद्धि को चाहता ही नहीं तो उसने उसे खरीदने के लिए</para>
  <para style="q2" vid="PRO 17:16">अपने हाथ में दाम क्यों ले रखा है?<verse eid="PRO 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />मित्र सब समयों में प्रेम रखता है,</para>
  <para style="q2" vid="PRO 17:17">और भाई का जन्म विपत्ति के समय के लिए हुआ है।<verse eid="PRO 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />नासमझ मनुष्य शपथ खाता है,</para>
  <para style="q2" vid="PRO 17:18">और अपने पड़ोसी के सामने उत्तरदायी ठहरता है।<verse eid="PRO 17:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />जो अपराध से प्रीति रखता है,</para>
  <para style="q2" vid="PRO 17:19">वह झगड़े से भी प्रीति रखता है;</para>
  <para style="q1" vid="PRO 17:19">जो डींग मारता है,</para>
  <para style="q2" vid="PRO 17:19">वह अपने विनाश को निमंत्रण देता है।<verse eid="PRO 17:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />कुटिल मनवाला व्यक्‍ति सुख-समृद्धि नहीं पाता;</para>
  <para style="q2" vid="PRO 17:20">और जो अपनी बात से पलट जाता है,</para>
  <para style="q3" vid="PRO 17:20">वह विपत्ति में पड़ता है।<verse eid="PRO 17:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />मूर्ख को उत्पन्‍न‍ करनेवाला उससे दुःख पाता है;</para>
  <para style="q2" vid="PRO 17:21">और मूर्ख के पिता को आनंद नहीं मिलता।<verse eid="PRO 17:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />आनंदित हृदय अच्छी औषधि है,</para>
  <para style="q2" vid="PRO 17:22">परंतु निराश मन हड्डियों को सुखा देता है।<verse eid="PRO 17:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />दुष्‍ट मनुष्य न्याय बिगाड़ने के लिए</para>
  <para style="q2" vid="PRO 17:23">गुप्‍त में घूस लेता है।<verse eid="PRO 17:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />बुद्धि समझदार मनुष्य के सम्मुख रहती है,</para>
  <para style="q2" vid="PRO 17:24">परंतु मूर्ख की आँखें पृथ्वी की छोर तक भटकती रहती हैं।<verse eid="PRO 17:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />मूर्ख पुत्र अपने पिता के लिए दुःख,</para>
  <para style="q2" vid="PRO 17:25">और अपनी माता के लिए कष्‍ट का कारण होता है।<verse eid="PRO 17:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />यह उचित नहीं कि धर्मी जन पर जुर्माना लगाया जाए</para>
  <para style="q2" vid="PRO 17:26">और सज्‍जनों को उनके खरे चाल-चलन के लिए पीटा जाए।<verse eid="PRO 17:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />जो अपने शब्दों पर नियंत्रण रखता है, वह ज्ञानवान है;</para>
  <para style="q2" vid="PRO 17:27">और जो शांत स्वभाव का होता है, वह समझदार मनुष्य है।<verse eid="PRO 17:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />मूर्ख भी, जब वह चुप रहता है तो बुद्धिमान समझा जाता है;</para>
  <para style="q2" vid="PRO 17:28">और जब वह अपना मुँह बंद रखता है,</para>
  <para style="q3" vid="PRO 17:28">तो समझदार माना जाता है।<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />जो स्वयं को दूसरों से अलग करता है,</para>
  <para style="q2" vid="PRO 18:1">वह अपनी ही लालसा पूरी करना चाहता है,</para>
  <para style="q3" vid="PRO 18:1">और सब प्रकार की खरी बुद्धि को ठुकरा देता है।<verse eid="PRO 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />मूर्ख तो समझदारी की बातों से नहीं,</para>
  <para style="q2" vid="PRO 18:2">बल्कि अपने ही मन की बातों को</para>
  <para style="q3" vid="PRO 18:2">प्रकट करने से प्रसन्‍न होता है।<verse eid="PRO 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />दुष्‍टता के साथ-साथ अपमान,</para>
  <para style="q2" vid="PRO 18:3">और निरादर के साथ-साथ तिरस्कार भी आता है।<verse eid="PRO 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />मनुष्य के मुँह के वचन बुद्धि के सोते हैं,</para>
  <para style="q2" vid="PRO 18:4">वे गहरे जल और उमड़नेवाले झरने के समान हैं।<verse eid="PRO 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />दुष्‍ट का पक्ष लेना और धर्मी को न्याय से वंचित रखना,</para>
  <para style="q2" vid="PRO 18:5">अच्छा नहीं है।<verse eid="PRO 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />मूर्ख का बोलना झगड़ा उत्पन्‍न करता है,</para>
  <para style="q2" vid="PRO 18:6">और उसके मुँह की बातें मार खाने के योग्य ठहरती हैं।<verse eid="PRO 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />मूर्ख की बातों के कारण उसका विनाश होता है,</para>
  <para style="q2" vid="PRO 18:7">और उसके शब्द उसके प्राण के लिए फंदा बनते हैं।<verse eid="PRO 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />कानाफूसी करनेवाले की बातें स्वादिष्‍ट भोजन के समान होती हैं,</para>
  <para style="q2" vid="PRO 18:8">और वे मन में समा जाती हैं।<verse eid="PRO 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />जो अपने काम में आलसी होता है,</para>
  <para style="q2" vid="PRO 18:9">वह काम बिगाड़नेवाले का भाई ठहरता है।<verse eid="PRO 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />यहोवा का नाम एक दृढ़ गढ़ है;</para>
  <para style="q2" vid="PRO 18:10">धर्मी भागकर उसमें सुरक्षा पाता है।<verse eid="PRO 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />धनी का धन उसकी दृष्‍टि में</para>
  <para style="q2" vid="PRO 18:11">उसका दृढ़ नगर और ऊँची शहरपनाह है।<verse eid="PRO 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />विनाश से पहले मनुष्य का हृदय घमंडी हो जाता है,</para>
  <para style="q2" vid="PRO 18:12">परंतु सम्मान से पहले नम्रता आती है।<verse eid="PRO 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />जो बिना बात सुने उत्तर देता है,</para>
  <para style="q2" vid="PRO 18:13">उसके लिए यह मूर्खता और लज्‍जा की बात है।<verse eid="PRO 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />बीमारी में मनुष्य की आत्मा उसे संभालती है,</para>
  <para style="q2" vid="PRO 18:14">परंतु जब आत्मा दुःखी हो जाती है</para>
  <para style="q3" vid="PRO 18:14">तो उसे कौन संभाल सकता है?<verse eid="PRO 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />समझदार मनुष्य का मन ज्ञान प्राप्‍त करता है,</para>
  <para style="q2" vid="PRO 18:15">और बुद्धिमान के कान ज्ञान की खोज में लगे रहते हैं।<verse eid="PRO 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />मनुष्य द्वारा दी गई भेंट उसे अवसर प्रदान करती है,</para>
  <para style="q2" vid="PRO 18:16">और उसे महापुरुषों के सामने पहुँचाती है।<verse eid="PRO 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />जो मनुष्य मुकदमे में पहले बोलता है,</para>
  <para style="q2" vid="PRO 18:17">वह तब तक सच्‍चा प्रतीत होता है,</para>
  <para style="q3" vid="PRO 18:17">जब तक कि दूसरे पक्षवाला आकर उसे जाँच नहीं लेता।<verse eid="PRO 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />पर्ची डालकर निर्णय करने से झगड़े समाप्‍त होते हैं,</para>
  <para style="q2" vid="PRO 18:18">और इससे शक्‍तिशाली विरोधियों के बीच विवाद शांत हो जाता है।<verse eid="PRO 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />रूठे हुए भाई को मनाना दृढ़ नगर को जीतने से अधिक कठिन है,</para>
  <para style="q2" vid="PRO 18:19">और झगड़े महल में लगी छड़ों के समान होते हैं।<verse eid="PRO 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />मनुष्य का पेट उसके मुँह से निकले शब्दों से भरता है,</para>
  <para style="q2" vid="PRO 18:20">और वह अपने होंठों के फल से संतुष्‍ट होता है।<verse eid="PRO 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />जीभ के वश में मृत्यु और जीवन दोनों होते हैं,</para>
  <para style="q2" vid="PRO 18:21">और जो उसका सदुपयोग करना जानता है,</para>
  <para style="q3" vid="PRO 18:21">वह उसका फल पाएगा।<verse eid="PRO 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />जो पत्‍नी प्राप्‍त करता है,</para>
  <para style="q2" vid="PRO 18:22">वह भलाई प्राप्‍त करता है,</para>
  <para style="q3" vid="PRO 18:22">और उस पर यहोवा का अनुग्रह होता है।<verse eid="PRO 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />निर्धन तो गिड़गिड़ाकर बोलता है,</para>
  <para style="q2" vid="PRO 18:23">परंतु धनी रुखाई से उत्तर देता है।<verse eid="PRO 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />मनुष्य के कुछ ऐसे मित्र होते हैं</para>
  <para style="q2" vid="PRO 18:24">जिनसे उसे हानि हो सकती है,</para>
  <para style="q1" vid="PRO 18:24">परंतु ऐसा मित्र भी होता है</para>
  <para style="q2" vid="PRO 18:24">जो भाई से बढ़कर साथ देता है।<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />खराई से चलनेवाला निर्धन मनुष्य उससे अच्छा है</para>
  <para style="q2" vid="PRO 19:1">जो कुटिल बातें करता है और मूर्ख है।<verse eid="PRO 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />ज्ञान के बिना उत्साह अच्छा नहीं,</para>
  <para style="q2" vid="PRO 19:2">और जो उतावली करता है उसके कदम भटक जाते हैं।<verse eid="PRO 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />जब मनुष्य की मूर्खता उसके मार्ग को बिगाड़ देती है,</para>
  <para style="q2" vid="PRO 19:3">तो उसका हृदय यहोवा के विरुद्ध क्रोध से भड़क उठता है।<verse eid="PRO 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />धन के कारण मित्रों की संख्या बढ़ती जाती है,</para>
  <para style="q2" vid="PRO 19:4">परंतु कंगाल अपने मित्र द्वारा त्याग दिया जाता है।<verse eid="PRO 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />झूठा गवाह निश्‍चय दंड पाएगा,</para>
  <para style="q2" vid="PRO 19:5">और जो झूठ बोलता है वह न बचेगा।<verse eid="PRO 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />उदार मनुष्य की कृपा चाहनेवाले बहुत होते हैं,</para>
  <para style="q2" vid="PRO 19:6">और दानी मनुष्य का मित्र हर एक व्यक्‍ति होता है।<verse eid="PRO 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />जब निर्धन मनुष्य के सब भाई उससे घृणा करते हैं</para>
  <para style="q2" vid="PRO 19:7">तो अवश्य ही उसके मित्र भी उससे दूर होंगे!</para>
  <para style="q1" vid="PRO 19:7">वह उन्हें बातों से मनाना तो चाहता है,</para>
  <para style="q2" vid="PRO 19:7">पर वे नहीं मानते।<verse eid="PRO 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />जो बुद्धि प्राप्‍त करता है,</para>
  <para style="q2" vid="PRO 19:8">वह अपने प्राण से प्रीति रखता है;</para>
  <para style="q1" vid="PRO 19:8">और जो समझ की चौकसी करता है,</para>
  <para style="q2" vid="PRO 19:8">वह समृद्ध होता है।<verse eid="PRO 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />झूठा गवाह निश्‍चय दंड पाएगा,</para>
  <para style="q2" vid="PRO 19:9">और जो झूठ बोलता है वह नष्‍ट हो जाएगा।<verse eid="PRO 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />मूर्ख को सुख-विलास से रहना शोभा नहीं देता,</para>
  <para style="q2" vid="PRO 19:10">और दास का प्रधानों पर प्रभुता करना और भी अशोभनीय है।<verse eid="PRO 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />जो मनुष्य बुद्धि से चलता है,</para>
  <para style="q2" vid="PRO 19:11">वह क्रोध करने में धीमा होता है;</para>
  <para style="q3" vid="PRO 19:11">और अपराध पर ध्यान न देना उसे शोभा देता है।<verse eid="PRO 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />राजा का क्रोध सिंह की दहाड़ के समान होता है,</para>
  <para style="q2" vid="PRO 19:12">परंतु उसकी कृपा घास पर की ओस के समान होती है।<verse eid="PRO 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />मूर्ख पुत्र अपने पिता के विनाश का कारण होता है,</para>
  <para style="q2" vid="PRO 19:13">और पत्‍नी के लड़ाई-झगड़े निरंतर टपकनेवाली छत के समान होते हैं।<verse eid="PRO 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />घर और धन तो पूर्वजों से प्राप्‍त होते हैं,</para>
  <para style="q2" vid="PRO 19:14">परंतु बुद्धिमान पत्‍नी यहोवा ही से मिलती है।<verse eid="PRO 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />आलस्य के कारण गहरी नींद आती है,</para>
  <para style="q2" vid="PRO 19:15">और आलसी मनुष्य भूखा ही रहता है।<verse eid="PRO 19:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />जो आज्ञा का पालन करता है,</para>
  <para style="q2" vid="PRO 19:16">वह अपने प्राण की रक्षा करता है;</para>
  <para style="q1" vid="PRO 19:16">परंतु जो अपने चाल-चलन पर ध्यान नहीं देता,</para>
  <para style="q2" vid="PRO 19:16">वह मर जाएगा।<verse eid="PRO 19:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />जो कंगाल पर तरस खाता है,</para>
  <para style="q2" vid="PRO 19:17">वह यहोवा को उधार देता है;</para>
  <para style="q3" vid="PRO 19:17">और यहोवा उसे उसके भले कार्य का प्रतिफल देगा।<verse eid="PRO 19:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />जब तक आशा है अपने पुत्र की ताड़ना कर,</para>
  <para style="q2" vid="PRO 19:18">और उसकी मृत्यु की इच्छा न कर।<verse eid="PRO 19:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />अति क्रोधी मनुष्य को दंड भुगतना पड़ेगा;</para>
  <para style="q2" vid="PRO 19:19">यदि तू उसे बचाता है,</para>
  <para style="q2" vid="PRO 19:19">तो तुझे उसे बार-बार बचाना पड़ेगा।<verse eid="PRO 19:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />सम्मति को सुन ले और शिक्षा को ग्रहण कर</para>
  <para style="q2" vid="PRO 19:20">कि तू जीवन भर बुद्धिमान बना रहे।<verse eid="PRO 19:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />मनुष्य के मन में बहुत सी योजनाएँ होती हैं,</para>
  <para style="q2" vid="PRO 19:21">परंतु जो यहोवा का उद्देश्य होता है वही पूरा होता है।<verse eid="PRO 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />मनुष्य का दयालु होना शोभनीय है;</para>
  <para style="q2" vid="PRO 19:22">और झूठा होने से उत्तम निर्धन होना है।<verse eid="PRO 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />यहोवा का भय जीवन की ओर ले जाता है;</para>
  <para style="q2" vid="PRO 19:23">और जो उसका भय मानता है,</para>
  <para style="q3" vid="PRO 19:23">वह सुखी रहता है और उस पर विपत्ति नहीं पड़ती।<verse eid="PRO 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />आलसी मनुष्य भोजन की थाली में अपना हाथ डालता तो है,</para>
  <para style="q2" vid="PRO 19:24">परंतु उसे अपने मुँह तक नहीं ले जाता।<verse eid="PRO 19:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />ठट्ठा करनेवाले की पिटाई कर,</para>
  <para style="q2" vid="PRO 19:25">इससे नासमझ मनुष्य समझदार हो जाएगा;</para>
  <para style="q1" vid="PRO 19:25">जिसके पास समझ है उसे डाँट</para>
  <para style="q2" vid="PRO 19:25">तो वह अधिक ज्ञान पाएगा।<verse eid="PRO 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />जो पुत्र अपने पिता से दुर्व्यवहार करता</para>
  <para style="q2" vid="PRO 19:26">और अपनी माता को घर से निकाल देता है,</para>
  <para style="q3" vid="PRO 19:26">वह निंदा और अपमान का कारण है।<verse eid="PRO 19:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />हे मेरे पुत्र, यदि तू शिक्षा की बातें सुनना छोड़ देगा</para>
  <para style="q2" vid="PRO 19:27">तो ज्ञान के वचनों से भटक जाएगा।<verse eid="PRO 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />भ्रष्‍ट गवाह न्याय को ठट्ठों में उड़ाता है,</para>
  <para style="q2" vid="PRO 19:28">और दुष्‍ट मनुष्य बुराई से तृप्‍त होते हैं।<verse eid="PRO 19:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />ठट्ठा करनेवालों के लिए दंड,</para>
  <para style="q2" vid="PRO 19:29">और मूर्खों की पीठ के लिए कोड़े ठहराए जाते हैं।<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />दाखमधु ठट्ठा करनेवाला और मदिरा हल्ला मचानेवाली है;</para>
  <para style="q2" vid="PRO 20:1">जो कोई उनसे मतवाला होता है,</para>
  <para style="q3" vid="PRO 20:1">वह बुद्धिमान नहीं होता।<verse eid="PRO 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />राजा का भयंकर क्रोध सिंह की दहाड़ के समान होता है,</para>
  <para style="q2" vid="PRO 20:2">जो उसे भड़काता है,</para>
  <para style="q3" vid="PRO 20:2">वह अपने प्राण से हाथ धो बैठता है।<verse eid="PRO 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />लडा़ई-झगडे़ से दूर रहना मनुष्य के लिए आदर की बात है,</para>
  <para style="q2" vid="PRO 20:3">परंतु सब मूर्ख झगड़ने को तैयार रहते हैं।<verse eid="PRO 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />आलसी मनुष्य बोआई का समय आने पर हल नहीं जोतता,</para>
  <para style="q2" vid="PRO 20:4">इसलिए कटनी के समय वह भीख माँगता है,</para>
  <para style="q3" vid="PRO 20:4">पर कुछ नहीं पाता।<verse eid="PRO 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />मनुष्य के मन की युक्‍ति अथाह जल के समान है,</para>
  <para style="q2" vid="PRO 20:5">परंतु समझदार मनुष्य उसे खींच निकालता है।<verse eid="PRO 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />बहुत से लोग अपनी विश्‍वासयोग्यता का दावा करते हैं,</para>
  <para style="q2" vid="PRO 20:6">परंतु विश्‍वासयोग्य मनुष्य कौन पा सकता है?<verse eid="PRO 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />धर्मी जन खराई से चलता है;</para>
  <para style="q2" vid="PRO 20:7">और उसके साथ उसकी संतान भी धन्य होती है।<verse eid="PRO 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />न्यायासन पर विराजमान राजा अपनी दृष्‍टि ही से</para>
  <para style="q2" vid="PRO 20:8">सब बुराई को छाँटकर अलग कर देता है।<verse eid="PRO 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />कौन कह सकता है, “मैंने अपना हृदय पवित्र किया है,</para>
  <para style="q2" vid="PRO 20:9">मैं अपने पाप से शुद्ध हो गया हूँ”?<verse eid="PRO 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />खोटे बाट और खोटे माप,</para>
  <para style="q2" vid="PRO 20:10">इन दोनों से यहोवा को घृणा है।<verse eid="PRO 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />बालक भी अपने कामों से पहचाना जाता है</para>
  <para style="q2" vid="PRO 20:11">कि उसका आचरण शुद्ध और उचित है या नहीं।<verse eid="PRO 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />सुननेवाले कान और देखनेवाली आँख,</para>
  <para style="q2" vid="PRO 20:12">इन दोनों को यहोवा ही ने बनाया है।<verse eid="PRO 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />नींद से प्रीति न रख,</para>
  <para style="q2" vid="PRO 20:13">अन्यथा तू दरिद्र हो जाएगा;</para>
  <para style="q3" vid="PRO 20:13">आँखें खोल और तेरे पास पर्याप्‍त भोजन होगा।<verse eid="PRO 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />खरीदने के समय ग्राहक कहता है,</para>
  <para style="q2" vid="PRO 20:14">“यह अच्छी नहीं है,”</para>
  <para style="q3" vid="PRO 20:14">पर खरीदकर ले जाने के बाद बड़ाई मारता है।<verse eid="PRO 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />सोना और बहुमूल्य रत्‍न तो बहुत हैं,</para>
  <para style="q2" vid="PRO 20:15">परंतु ज्ञान भरी बातें और भी अधिक मूल्यवान होती हैं।<verse eid="PRO 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />अजनबी की जमानत देनेवाले के वस्‍त्र,</para>
  <para style="q2" vid="PRO 20:16">और परदेशी की जमानत देनेवाले से कोई वस्तु गिरवी रख ले।<verse eid="PRO 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />छल-कपट से प्राप्‍त रोटी मनुष्य को मीठी तो लगती है,</para>
  <para style="q2" vid="PRO 20:17">परंतु बाद में उसका मुँह कंकड़ से भर जाता है।<verse eid="PRO 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />सम्मति के द्वारा ही योजनाएँ बना,</para>
  <para style="q2" vid="PRO 20:18">और उचित सलाह लेकर ही युद्ध कर।<verse eid="PRO 20:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />जो बातों को इधर-उधर करता फिरता है,</para>
  <para style="q2" vid="PRO 20:19">वह भेद प्रकट करता है,</para>
  <para style="q3" vid="PRO 20:19">इसलिए बकवादी से मेल-जोल न रखना।<verse eid="PRO 20:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />जो अपने माता-पिता को कोसता है,</para>
  <para style="q2" vid="PRO 20:20">उसका दीपक घोर अंधकार में बुझ जाता है।<verse eid="PRO 20:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />जो भाग आरंभ में जल्दबाज़ी से प्राप्‍त होता है,</para>
  <para style="q2" vid="PRO 20:21">उस पर बाद में आशिष नहीं होती।<verse eid="PRO 20:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />मत कह, “मैं बुराई का बदला लूँगा।”</para>
  <para style="q2" vid="PRO 20:22">यहोवा की प्रतीक्षा कर, वही तुझे छुड़ाएगा।<verse eid="PRO 20:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />खोटे बाटों से यहोवा को घृणा है,</para>
  <para style="q2" vid="PRO 20:23">और छल का तराजू अच्छा नहीं।<verse eid="PRO 20:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />मनुष्य के कदमों को यहोवा ही निर्धारित करता है,</para>
  <para style="q2" vid="PRO 20:24">फिर मनुष्य अपना मार्ग कैसे समझ सकता है?<verse eid="PRO 20:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />मनुष्य के लिए बिना सोचे-समझे किसी वस्तु को पवित्र ठहराना,</para>
  <para style="q2" vid="PRO 20:25">और मन्‍न‍त मानकर फिर से विचार करना फंदा ठहरता है।<verse eid="PRO 20:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />बुद्धिमान राजा दुष्‍टों को फटकता है,</para>
  <para style="q2" vid="PRO 20:26">और दाँवने का पहिया उन पर चलवाता है।<verse eid="PRO 20:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />मनुष्य की आत्मा यहोवा का दीपक है,</para>
  <para style="q2" vid="PRO 20:27">जो मनुष्य के सब भीतरी भागों को खोजता है।<verse eid="PRO 20:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />करुणा और सच्‍चाई राजा की रक्षा करती हैं,</para>
  <para style="q2" vid="PRO 20:28">और धार्मिकता<note caller="+" style="f"><char style="fr" closed="false">20:28 </char><char style="ft" closed="false">अक्षरशः निष्‍ठा</char></note> के कारण उसका सिंहासन दृढ़ रहता है।<verse eid="PRO 20:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />जवानों का गौरव उनका बल है,</para>
  <para style="q2" vid="PRO 20:29">परंतु बूढ़ों की शोभा उनके पके बाल हैं।<verse eid="PRO 20:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />कोड़ों के घाव से बुराई दूर होती है,</para>
  <para style="q2" vid="PRO 20:30">और मार खाने से अंतःकरण शुद्ध होता है।<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />राजा का मन यहोवा के हाथ में जल-धारा के समान है,</para>
  <para style="q2" vid="PRO 21:1">वह उसे जहाँ चाहता है मोड़ देता है।<verse eid="PRO 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />मनुष्य का सारा चाल-चलन उसकी अपनी दृष्‍टि में तो ठीक होता है,</para>
  <para style="q2" vid="PRO 21:2">परंतु यहोवा मन को तौलता है।<verse eid="PRO 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />धार्मिकता और न्याय का अनुसरण करना यहोवा को</para>
  <para style="q2" vid="PRO 21:3">बलिदान से भी अधिक ग्रहणयोग्य है।<verse eid="PRO 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />चढ़ी आँखें और घमंडी मन,</para>
  <para style="q2" vid="PRO 21:4">अर्थात् दुष्‍टों की खेती, ये पाप हैं।<verse eid="PRO 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />परिश्रमी की योजनाएँ निश्‍चय ही लाभदायक होती हैं,</para>
  <para style="q2" vid="PRO 21:5">परंतु प्रत्येक जो उतावली करता है</para>
  <para style="q3" vid="PRO 21:5">वह दरिद्र हो जाता है।<verse eid="PRO 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />झूठ बोलकर धन कमाना उड़ जानेवाली भाप</para>
  <para style="q2" vid="PRO 21:6">और मृत्यु का पीछा करने के समान है।<verse eid="PRO 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />दुष्‍टों की हिंसा उन्हीं का नाश करती है,</para>
  <para style="q2" vid="PRO 21:7">क्योंकि वे न्यायोचित कार्य करने से इनकार करते हैं।<verse eid="PRO 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />अपराधी मनुष्य की चाल टेढ़ी होती है,</para>
  <para style="q2" vid="PRO 21:8">परंतु जो पवित्र है उसका चाल-चलन खरा होता है।<verse eid="PRO 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />झगड़ालू पत्‍नी के साथ घर के भीतर रहने की अपेक्षा</para>
  <para style="q2" vid="PRO 21:9">छत पर एक कोने में रहना अच्छा है।<verse eid="PRO 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />दुष्‍ट का मन बुराई की लालसा करता है;</para>
  <para style="q2" vid="PRO 21:10">उसकी आँखों में अपने पड़ोसी के लिए दया नहीं होती।<verse eid="PRO 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />जब ठट्ठा करनेवाले को दंड दिया जाता है,</para>
  <para style="q2" vid="PRO 21:11">तो भोला मनुष्य बुद्धिमान हो जाता है;</para>
  <para style="q1" vid="PRO 21:11">और जब बुद्धिमान को शिक्षा दी जाती है,</para>
  <para style="q2" vid="PRO 21:11">तो वह ज्ञान प्राप्‍त करता है।<verse eid="PRO 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />धर्मी परमेश्‍वर दुष्‍ट के घर पर दृष्‍टि रखता है,</para>
  <para style="q2" vid="PRO 21:12">और दुष्‍टों को विनाश के गड्‌ढे में डाल देता है।<verse eid="PRO 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />जो कंगाल की दुहाई अनसुनी करता है,</para>
  <para style="q2" vid="PRO 21:13">उसकी अपनी पुकार भी सुनी न जाएगी।<verse eid="PRO 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />गुप्‍त में दी गई भेंट क्रोध को शांत कर देती है,</para>
  <para style="q2" vid="PRO 21:14">और चुपके से दिया गया उपहार प्रचंड क्रोध को ठंडा कर देता है।<verse eid="PRO 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />न्याय के कार्य करना धर्मी के लिए तो आनंद,</para>
  <para style="q2" vid="PRO 21:15">परंतु अनर्थकारियों के लिए भय का कारण होता है।<verse eid="PRO 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />जो मनुष्य बुद्धि के मार्ग से भटक जाए,</para>
  <para style="q2" vid="PRO 21:16">वह मरे हुओं के बीच ठिकाना पाएगा।<verse eid="PRO 21:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />जो सुख-विलास से प्रीति रखता है वह कंगाल हो जाएगा;</para>
  <para style="q2" vid="PRO 21:17">जो दाखमधु और तेल से प्रीति रखता है,</para>
  <para style="q3" vid="PRO 21:17">वह कभी धनी न होगा।<verse eid="PRO 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />दुष्‍ट मनुष्य धर्मी के बदले,</para>
  <para style="q2" vid="PRO 21:18">और विश्‍वासघाती सीधे लोगों के बदले दंड भोगते हैं।<verse eid="PRO 21:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />झगड़ालू और चिड़चिड़ी पत्‍नी के साथ रहने से</para>
  <para style="q2" vid="PRO 21:19">जंगल में रहना उत्तम है।<verse eid="PRO 21:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />बुद्धिमान के घर में अनमोल धन और तेल पाए जाते हैं,</para>
  <para style="q2" vid="PRO 21:20">परंतु मूर्ख व्यक्‍ति उन्हें उड़ा देता है।<verse eid="PRO 21:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />जो धार्मिकता और कृपा की खोज में रहता है,</para>
  <para style="q2" vid="PRO 21:21">वह जीवन, धार्मिकता और सम्मान प्राप्‍त करता है।<verse eid="PRO 21:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />बुद्धिमान शूरवीरों के नगर पर चढ़ जाता है,</para>
  <para style="q2" vid="PRO 21:22">और उनके उस गढ़ को ढा देता है</para>
  <para style="q3" vid="PRO 21:22">जिस पर वे भरोसा करते हैं।<verse eid="PRO 21:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />जो अपने मुँह और जीभ पर नियंत्रण रखता है,</para>
  <para style="q2" vid="PRO 21:23">वह अपने प्राण को विपत्तियों से बचाता है।<verse eid="PRO 21:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />“अभिमानी,” “अहंकारी,” और “ठट्ठा करनेवाला,”</para>
  <para style="q2" vid="PRO 21:24">उसी मनुष्य के नाम हैं</para>
  <para style="q3" vid="PRO 21:24">जो बड़े घमंड के साथ कार्य करता है।<verse eid="PRO 21:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />आलसी की लालसा उसकी मृत्यु का कारण होती है,</para>
  <para style="q2" vid="PRO 21:25">क्योंकि उसके हाथ परिश्रम करने से इनकार करते हैं।<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />वह दिन भर लालसा ही किया करता है,</para>
  <para style="q2" vid="PRO 21:26">परंतु धर्मी देता रहता है</para>
  <para style="q3" vid="PRO 21:26">और अपना हाथ नहीं रोकता।<verse eid="PRO 21:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />दुष्‍टों का बलिदान तो घृणित है,</para>
  <para style="q2" vid="PRO 21:27">पर जब वह उसे दुर्भावना से चढ़ाता है</para>
  <para style="q3" vid="PRO 21:27">तो वह और भी अधिक घृणित होगा।<verse eid="PRO 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />झूठा गवाह नष्‍ट हो जाएगा,</para>
  <para style="q2" vid="PRO 21:28">पर जो ध्यान से सुनता है,</para>
  <para style="q3" vid="PRO 21:28">उसकी गवाही स्थिर बनी रहेगी।<verse eid="PRO 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />दुष्‍ट मनुष्य अपने चेहरे को कठोर कर लेता है,</para>
  <para style="q2" vid="PRO 21:29">परंतु सीधा मनुष्य अपनी चाल-चलन पर ध्यान देता है।<verse eid="PRO 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />ऐसी कोई बुद्धि, कोई समझ और कोई युक्‍ति नहीं,</para>
  <para style="q2" vid="PRO 21:30">जो यहोवा के विरुद्ध ठहर सके।<verse eid="PRO 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />घोड़े को युद्ध के दिन के लिए तैयार किया तो जाता है,</para>
  <para style="q2" vid="PRO 21:31">परंतु विजय यहोवा ही से प्राप्‍त होती है।<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />अपार धन की अपेक्षा अच्छा नाम अधिक चाहने योग्य है;</para>
  <para style="q2" vid="PRO 22:1">चाँदी और सोने की अपेक्षा कृपा पाना उत्तम है।<verse eid="PRO 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />धनी और निर्धन में यही समानता है</para>
  <para style="q2" vid="PRO 22:2">कि यहोवा उन दोनों का सृजनहार है।<verse eid="PRO 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />समझदार मनुष्य विपत्ति को आते देखकर छिप जाता है,</para>
  <para style="q2" vid="PRO 22:3">परंतु अनुभवहीन लोग आगे बढ़कर कष्‍ट भोगते हैं।<verse eid="PRO 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />नम्रता का और यहोवा का भय मानने का प्रतिफल धन,</para>
  <para style="q2" vid="PRO 22:4">सम्मान और जीवन हैं।<verse eid="PRO 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />कुटिल मनुष्य के मार्ग में काँटे और फंदे होते हैं;</para>
  <para style="q2" vid="PRO 22:5">जो अपने प्राण की रक्षा करता है,</para>
  <para style="q3" vid="PRO 22:5">वह उनसे दूर रहता है।<verse eid="PRO 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />बच्‍‍चे को उसी मार्ग की शिक्षा दे जिस पर उसे चलना चाहिए,</para>
  <para style="q2" vid="PRO 22:6">और वह बुढ़ापे में भी उससे न हटेगा।<verse eid="PRO 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />धनी मनुष्य निर्धन लोगों पर प्रभुता करता है,</para>
  <para style="q2" vid="PRO 22:7">और उधार लेनेवाला उधार देनेवाले का दास हो जाता है।<verse eid="PRO 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />जो अधर्म का बीज बोता है वह अनर्थ ही काटेगा,</para>
  <para style="q2" vid="PRO 22:8">और उसके क्रोध की लाठी टूट जाएगी।<verse eid="PRO 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />उदार व्यक्‍ति आशीषित होगा,</para>
  <para style="q2" vid="PRO 22:9">क्योंकि वह कंगाल को अपने भोजन में से देता है।<verse eid="PRO 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />ठट्ठा करनेवाले को निकाल दे, तब झगड़ा मिट जाएगा,</para>
  <para style="q2" vid="PRO 22:10">और कलह तथा अपमान दोनों समाप्‍‍त हो जाएँगे।<verse eid="PRO 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />जो मन की शुद्धता से प्रीति रखता है</para>
  <para style="q2" vid="PRO 22:11">और जिसकी बातें मनोहर होती हैं,</para>
  <para style="q3" vid="PRO 22:11">राजा उसका मित्र होता है।<verse eid="PRO 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />यहोवा की आँखें ज्ञान की रक्षा करती हैं,</para>
  <para style="q2" vid="PRO 22:12">पर वह विश्‍वासघाती की बातों को पलट देता है।<verse eid="PRO 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />आलसी मनुष्य कहता है, “बाहर तो सिंह खड़ा है!</para>
  <para style="q2" vid="PRO 22:13">मैं चौक के बीच मार डाला जाऊँगा।”<verse eid="PRO 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />व्यभिचारिणी का मुँह गहरा गड्‌ढा है;</para>
  <para style="q2" vid="PRO 22:14">उसमें वही गिरता है जिससे यहोवा क्रोधित होता है।<verse eid="PRO 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />बच्‍‍चे के मन में मूर्खता की गाँठ बंधी रहती है;</para>
  <para style="q2" vid="PRO 22:15">अनुशासन की छड़ी के द्वारा वह उससे दूर की जाती है।<verse eid="PRO 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />जो अपने लाभ के लिए कंगाल पर अंधेर करता है,</para>
  <para style="q2" vid="PRO 22:16">या धनी को भेंट देता है,</para>
  <para style="q3" vid="PRO 22:16">वह केवल हानि ही उठाता है।<verse eid="PRO 22:16" /></para>
  <para style="s1">बुद्धिमानों के तीस नीतिवचन</para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />अपना कान लगाकर बुद्धिमानों के वचन सुन,</para>
  <para style="q2" vid="PRO 22:17">और मेरे ज्ञान की बातों पर अपना मन लगा;<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />यदि तू उन्हें अपने मन में बसा ले,</para>
  <para style="q2" vid="PRO 22:18">और वे तेरे मुँह से सदा निकला करें,</para>
  <para style="q3" vid="PRO 22:18">तो यह मनभावनी बात होगी।<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />मैंने आज ये बातें तुझे इसलिए बताई हैं</para>
  <para style="q2" vid="PRO 22:19">कि तेरा भरोसा यहोवा पर हो।<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />क्या मैंने तेरे लिए उपदेश</para>
  <para style="q2" vid="PRO 22:20">और ज्ञान की तीस बातें नहीं लिखीं,<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />कि तू सत्य के वचनों की सच्‍चाई जाने,</para>
  <para style="q2" vid="PRO 22:21">और जिन्होंने तुझे भेजा है उन्हें ठीक उत्तर दे सके?<verse eid="PRO 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />किसी दरिद्र को इसलिए न लूट कि वह दरिद्र है,</para>
  <para style="q2" vid="PRO 22:22">और किसी दुखियारे को कचहरी में न पीस;<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />क्योंकि यहोवा स्वयं उनका मुकदमा लड़ेगा,</para>
  <para style="q2" vid="PRO 22:23">और जो उन्हें लूटते हैं उनका प्राण छीन लेगा।<verse eid="PRO 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />क्रोधी मनुष्य से मित्रता न करना,</para>
  <para style="q2" vid="PRO 22:24">और तुरंत क्रोधित होनेवाले व्यक्‍ति के साथ न चलना,<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />कहीं ऐसा न हो कि तू उसके मार्गों पर चले</para>
  <para style="q2" vid="PRO 22:25">और स्वयं फंदे में फँस जाए।<verse eid="PRO 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />तू उनके जैसा न बनना जो दूसरों के ऋण की</para>
  <para style="q2" vid="PRO 22:26">जमानत देने पर सहमत होते हैं।<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />यदि तेरे पास चुकाने के लिए कुछ न हो,</para>
  <para style="q2" vid="PRO 22:27">तो तुझसे तेरा बिस्तर भी छीन लिया जाएगा।<verse eid="PRO 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />जो प्राचीन सीमा-चिह्‍न तेरे पूर्वजों ने ठहराया है,</para>
  <para style="q2" vid="PRO 22:28">उसे न बढ़ाना।<verse eid="PRO 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />यदि तू किसी ऐसे व्यक्‍ति को देखे</para>
  <para style="q2" vid="PRO 22:29">जो अपने कार्य में निपुण हो,</para>
  <para style="q1" vid="PRO 22:29">तो वह राजाओं की सेवा में खड़ा होगा,</para>
  <para style="q2" vid="PRO 22:29">साधारण लोगों की नहीं।<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />जब तू किसी शासक के साथ भोजन करने बैठे,</para>
  <para style="q2" vid="PRO 23:1">तो इस बात का ध्यान रख</para>
  <para style="q3" vid="PRO 23:1">कि तेरे सामने कौन है,<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />और यदि तू अधिक खानेवाला है</para>
  <para style="q2" vid="PRO 23:2">तो थोड़ा ही खाकर उठ जाना।<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />उसके स्वादिष्‍ट भोजन की लालसा न करना,</para>
  <para style="q2" vid="PRO 23:3">क्योंकि वह धोखे का भोजन है।<verse eid="PRO 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />धनी होने के लिए परिश्रम न कर;</para>
  <para style="q2" vid="PRO 23:4">इस पर अधिक ध्यान देना छोड़ दे।<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />क्या तू अपनी दृष्‍टि ऐसी वस्तु पर लगाएगा जो लुप्‍त हो जाती है?</para>
  <para style="q2" vid="PRO 23:5">क्योंकि धन तो निश्‍चय ही पंख लगाकर उकाब के समान आकाश में उड़ जाता है।<verse eid="PRO 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />कंजूस मनुष्य की रोटी न खाना,</para>
  <para style="q2" vid="PRO 23:6">और न उसके स्वादिष्‍ट भोजन की लालसा करना;<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />क्योंकि वह ऐसा मनुष्य है जो मन में हिसाब लगाता रहता है।</para>
  <para style="q2" vid="PRO 23:7">वह तुझसे कहता तो है, “खा और पी!”</para>
  <para style="q3" vid="PRO 23:7">पर उसके मन में तुझसे कोई लगाव नहीं।<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />जो निवाला तूने खाया है वह भी तुझे उगलना पड़ेगा,</para>
  <para style="q2" vid="PRO 23:8">और तेरी मीठी बातें व्यर्थ ठहरेंगी।<verse eid="PRO 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />मूर्ख से बात न करना,</para>
  <para style="q2" vid="PRO 23:9">क्योंकि वह तेरी बुद्धि की बातों को तुच्छ जानेगा।<verse eid="PRO 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />प्राचीन सीमा-चिह्‍न को न बढ़ाना,</para>
  <para style="q2" vid="PRO 23:10">और न अनाथों के खेतों पर कब्ज़ा करना,<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />क्योंकि उनका छुड़ानेवाला सामर्थी है;</para>
  <para style="q2" vid="PRO 23:11">वही उनका मुकदमा तुम्हारे विरुद्ध लड़ेगा।<verse eid="PRO 23:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />अपना मन शिक्षा पर,</para>
  <para style="q2" vid="PRO 23:12">और अपने कान ज्ञान की बातों पर लगा।<verse eid="PRO 23:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />बच्‍‍चे को अनुशासित करने से न रुकना;</para>
  <para style="q2" vid="PRO 23:13">यदि तू उसे छड़ी लगाए तो वह न मरेगा।<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />तू छड़ी लगाकर उसका प्राण अधोलोक से बचा लेगा।<verse eid="PRO 23:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />हे मेरे पुत्र,</para>
  <para style="q2" vid="PRO 23:15">यदि तेरे मन में बुद्धि का वास हो</para>
  <para style="q3" vid="PRO 23:15">तो मेरा मन भी आनंदित होगा।<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />जब तू उचित बातें बोले,</para>
  <para style="q2" vid="PRO 23:16">तब मेरा मन प्रफुल्लित होगा।<verse eid="PRO 23:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />पापियों के प्रति तेरे मन में ईर्ष्या न हो,</para>
  <para style="q2" vid="PRO 23:17">परंतु तू सदा यहोवा के भय में बने रहना।<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />निस्संदेह तेरे लिए एक अच्छा भविष्य है,</para>
  <para style="q2" vid="PRO 23:18">और तेरी आशा न टूटेगी।<verse eid="PRO 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />हे मेरे पुत्र, मेरी बात ध्यान से सुन और बुद्धिमान बन;</para>
  <para style="q2" vid="PRO 23:19">और अपना मन सुमार्ग पर लगा।<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />तू न तो पियक्‍‍कड़ों के साथ,</para>
  <para style="q2" vid="PRO 23:20">और न अत्यधिक मांस खानेवालों के साथ संगति रखना;<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />क्योंकि पियक्‍‍कड़ और पेटू तो दरिद्र हो जाएँगे,</para>
  <para style="q2" vid="PRO 23:21">और उनका नींद में रहना उन्हें चिथड़े पहनाएगा।<verse eid="PRO 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />अपने पिता की सुनना जिसने तुझे उत्पन्‍न‍ किया है,</para>
  <para style="q2" vid="PRO 23:22">और जब तेरी माता बूढ़ी हो जाए</para>
  <para style="q3" vid="PRO 23:22">तो उसे तुच्छ न जानना।<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />सच्‍चाई को खरीद ले और उसे बेच मत;</para>
  <para style="q2" vid="PRO 23:23">बुद्धि, शिक्षा, और समझ को भी प्राप्‍त कर।<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />धर्मी का पिता बहुत मगन होगा;</para>
  <para style="q2" vid="PRO 23:24">और जो बुद्धिमान पुत्र को जन्म देता है,</para>
  <para style="q3" vid="PRO 23:24">वह उसमें अति आनंदित होगा।<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />तेरे माता-पिता आनंदित हों,</para>
  <para style="q2" vid="PRO 23:25">और तेरी जननी मगन रहे।<verse eid="PRO 23:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />हे मेरे पुत्र, अपना मन मेरी ओर लगा,</para>
  <para style="q2" vid="PRO 23:26">और तेरी दृष्‍टि मेरे चाल-चलन पर लगी रहे।<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />वेश्या तो एक गहरे गड्‌ढे के समान,</para>
  <para style="q2" vid="PRO 23:27">और व्यभिचारिणी स्‍त्री एक सकरे कुएँ के समान होती है।<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />वह डाकू के समान घात लगाती है,</para>
  <para style="q2" vid="PRO 23:28">और मनुष्यों में विश्‍वासघातियों की संख्या बढ़ाती है।<verse eid="PRO 23:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />कौन कहता है, हाय? कौन दुःख में है?</para>
  <para style="q2" vid="PRO 23:29">कौन झगड़ों में फँसा है? कौन शिकायतें करता है?</para>
  <para style="q3" vid="PRO 23:29">कौन अकारण घायल है? कौन है जिसकी आँखें लाल हैं?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />वे जो देर तक दाखमधु पीते हैं,</para>
  <para style="q2" vid="PRO 23:30">और जो मसाला मिली हुई मदिरा की खोज में रहते हैं।<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />जब दाखमधु लाल दिखाई देता है,</para>
  <para style="q2" vid="PRO 23:31">जब वह प्याले में लुभावना लगता है,</para>
  <para style="q1" vid="PRO 23:31">जब वह धार के साथ उंडेला जाता है,</para>
  <para style="q2" vid="PRO 23:31">तब उस पर दृष्‍टि न करना।<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />अंत में वह सर्प के समान डसता है,</para>
  <para style="q2" vid="PRO 23:32">और करैत के समान काटता है।<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />तेरी आँखें विचित्र वस्तुएँ देखेंगी</para>
  <para style="q2" vid="PRO 23:33">और तेरे मन से उलटी-सीधी बातें निकलेंगी।<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />तू समुद्र के बीच सोनेवाले के समान,</para>
  <para style="q2" vid="PRO 23:34">या मस्तूल के सिरे पर लेटनेवाले के समान होगा।<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />तू कहेगा, “उन्होंने मुझे मारा,</para>
  <para style="q2" vid="PRO 23:35">पर मुझे पीड़ा नहीं हुई।</para>
  <para style="q1" vid="PRO 23:35">उन्होंने मुझे पीटा, पर मुझे पता भी न चला।</para>
  <para style="q2" vid="PRO 23:35">मैं कब होश में आऊँगा कि फिर से पीऊँ?”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />दुष्‍ट लोगों के प्रति ईर्ष्यालु न होना,</para>
  <para style="q2" vid="PRO 24:1">और न उनकी संगति की चाहत रखना।<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />क्योंकि उनके मन हिंसा की योजना बनाते हैं,</para>
  <para style="q2" vid="PRO 24:2">और उनके मुँह दुष्‍टता की बातें बोलते हैं।<verse eid="PRO 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />घर बुद्धि से बनता है,</para>
  <para style="q2" vid="PRO 24:3">और समझ के द्वारा वह स्थिर रहता है;<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />तथा ज्ञान के द्वारा उसके कमरे सब प्रकार की बहुमूल्य</para>
  <para style="q2" vid="PRO 24:4">और मनभावनी वस्तुओं से भर जाते हैं।<verse eid="PRO 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />बुद्धिमान पुरुष सामर्थी होता है,</para>
  <para style="q2" vid="PRO 24:5">और ज्ञानी पुरुष अपनी शक्‍ति बढ़ाता है।<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />क्योंकि उचित सलाह से युद्ध लड़ा जाता है,</para>
  <para style="q2" vid="PRO 24:6">और सलाहकारों की बहुतायत से विजय प्राप्‍त होती है।<verse eid="PRO 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />बुद्धि तो मूर्ख की पहुँच से परे है;</para>
  <para style="q2" vid="PRO 24:7">सभा में उसके पास बोलने के लिए कुछ नहीं होता।<verse eid="PRO 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />जो बुराई की युक्‍ति करता है,</para>
  <para style="q2" vid="PRO 24:8">उसे लोग षड्यंत्रकारी कहते हैं।<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />मूर्खतापूर्ण योजना बनाना पाप है,</para>
  <para style="q2" vid="PRO 24:9">और ठट्ठा करनेवाले से लोग घृणा करते हैं।<verse eid="PRO 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />यदि तू विपत्ति के समय हार मान ले,</para>
  <para style="q2" vid="PRO 24:10">तो तेरी शक्‍ति बहुत सीमित है।<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />जो लोग मार डाले जाने के लिए घसीटे जाते हैं,</para>
  <para style="q2" vid="PRO 24:11">उन्हें छुड़ा; जो घात होने को लड़खड़ाते हुए जा रहे हैं, उन्हें रोक।<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />यदि तू कहे, “देख, हम तो यह जानते नहीं थे,”</para>
  <para style="q2" vid="PRO 24:12">तो क्या मन का जाँचनेवाला इसे नहीं समझता?</para>
  <para style="q1" vid="PRO 24:12">क्या तेरे प्राण की रक्षा करनेवाला यह नहीं जानता?</para>
  <para style="q2" vid="PRO 24:12">क्या वह मनुष्य को उसके कार्य के अनुसार प्रतिफल न देगा?<verse eid="PRO 24:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />हे मेरे पुत्र, तू मधु खा क्योंकि वह अच्छा है, हाँ,</para>
  <para style="q2" vid="PRO 24:13">छत्ते से टपकनेवाला मधु तुझे मीठा लगेगा;<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />और तू यह भी जान ले कि बुद्धि तेरे प्राण के लिए वैसी ही मीठी लगेगी।</para>
  <para style="q2" vid="PRO 24:14">यदि तू उसे पा ले तो तेरा भविष्य अच्छा होगा</para>
  <para style="q3" vid="PRO 24:14">और तेरी आशा न टूटेगी।<verse eid="PRO 24:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />हे दुष्‍ट, तू धर्मी के निवास को लूटने के लिए घात न लगा,</para>
  <para style="q2" vid="PRO 24:15">और उसके विश्रामस्थान को न उजाड़;<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />क्योंकि धर्मी चाहे सात बार गिरे,</para>
  <para style="q2" vid="PRO 24:16">फिर भी उठ खड़ा होगा;</para>
  <para style="q3" vid="PRO 24:16">परंतु दुष्‍ट लोग विपत्ति के समय गिरकर नष्‍ट हो जाते हैं।<verse eid="PRO 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />जब तेरा शत्रु गिरे तो तू आनंदित न होना,</para>
  <para style="q2" vid="PRO 24:17">और जब वह ठोकर खाए</para>
  <para style="q3" vid="PRO 24:17">तो तेरा मन मगन न हो।<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />कहीं ऐसा न हो कि यहोवा यह देखकर अप्रसन्‍न हो,</para>
  <para style="q2" vid="PRO 24:18">और अपना क्रोध उस पर से हटा ले।<verse eid="PRO 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />कुकर्मियों के कारण मत कुढ़,</para>
  <para style="q2" vid="PRO 24:19">और न दुष्‍ट लोगों के प्रति ईर्ष्या रख;<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />क्योंकि दुष्‍ट मनुष्य का कोई भविष्य नहीं,</para>
  <para style="q2" vid="PRO 24:20">और दुष्‍टों का दीपक बुझ जाएगा।<verse eid="PRO 24:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />हे मेरे पुत्र, यहोवा और राजा दोनों का भय मानना;</para>
  <para style="q2" vid="PRO 24:21">और विद्रोह करनेवालों के साथ न मिलना,<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />क्योंकि उन पर अचानक विपत्ति आ पड़ेगी,</para>
  <para style="q2" vid="PRO 24:22">और दोनों की ओर से आनेवाले विनाश को कौन जानता है?<verse eid="PRO 24:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 24:23" />बुद्धिमानों के वचन ये भी हैं :</para>
  <para style="q2" vid="PRO 24:23">न्याय में पक्षपात करना उचित नहीं है। <verse eid="PRO 24:23" /><verse number="24" style="v" sid="PRO 24:24" />जो दोषी से कहता है, “तू निर्दोष है,”</para>
  <para style="q1" vid="PRO 24:24">उसे लोग शाप देते हैं और राज्य-राज्य के लोग</para>
  <para style="q3" vid="PRO 24:24">उसकी निंदा करते हैं;<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />परंतु जो लोग दोषी को डाँटते हैं उनका भला होता है,</para>
  <para style="q2" vid="PRO 24:25">और उन्हें उत्तम आशिषें प्राप्‍त होंगी।<verse eid="PRO 24:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />जो सीधा उत्तर देता है,</para>
  <para style="q2" vid="PRO 24:26">वह मानो मित्र के समान गले लगाता है।<note caller="+" style="f"><char style="fr" closed="false">24:26 </char><char style="ft" closed="false">मित्र के समान गले लगाता : अक्षरशः होंठों को चूमता</char></note><verse eid="PRO 24:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />पहले अपना बाहर का काम-काज निपटा लेना,</para>
  <para style="q2" vid="PRO 24:27">और अपने खेत का काम संभाल लेना;</para>
  <para style="q3" vid="PRO 24:27">उसके बाद अपना घर बनाना।<verse eid="PRO 24:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />अपने पड़ोसी के विरुद्ध अकारण साक्षी न देना,</para>
  <para style="q2" vid="PRO 24:28">और न अपने होंठों से छल करना।<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />मत कह, “जैसा उसने मेरे साथ किया है</para>
  <para style="q2" vid="PRO 24:29">वैसा ही मैं भी उसके साथ करूँगा,</para>
  <para style="q3" vid="PRO 24:29">और उसके काम का बदला चुकाऊँगा।”<verse eid="PRO 24:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />मैं आलसी मनुष्य के खेत,</para>
  <para style="q2" vid="PRO 24:30">अर्थात् निर्बुद्धि मनुष्य की दाख की बारी के पास से होकर निकला;<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />तो देखो, उसमें चारों ओर कँटीली झाड़ियाँ उग आई हैं;</para>
  <para style="q2" vid="PRO 24:31">वह बिच्छू-घास से ढक गई है,</para>
  <para style="q3" vid="PRO 24:31">और उसकी पत्थर की दीवार ढह गई है।<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />जब मैंने यह देखा तो इस पर विचार किया;</para>
  <para style="q2" vid="PRO 24:32">मैंने देखा और शिक्षा प्राप्‍त की :<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />थोड़ी सी नींद, एक और झपकी,</para>
  <para style="q2" vid="PRO 24:33">हाथ पर हाथ रखकर थोड़ी देर और लेटे रहना,<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />तब तेरी निर्धनता लुटेरे के समान</para>
  <para style="q2" vid="PRO 24:34">और तेरी घटी शस्‍त्रधारी की भाँति तुझ पर आ पड़ेगी।<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s1">राजा सुलैमान के अन्य नीतिवचन</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 25:1" />ये भी सुलैमान के नीतिवचन हैं,</para>
  <para style="q2" vid="PRO 25:1">जिनकी प्रतिलिपि यहूदा के राजा हिजकिय्याह के लोगों ने बनाई थी।<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />परमेश्‍वर की महिमा किसी बात को गुप्‍त रखने में है,</para>
  <para style="q2" vid="PRO 25:2">परंतु राजाओं की महिमा गुप्‍त बात को खोज निकालने में है।<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />जैसे आकाश की ऊँचाई और पृथ्वी की गहराई अथाह है,</para>
  <para style="q2" vid="PRO 25:3">वैसे ही राजाओं का मन भी होता है।<verse eid="PRO 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />जब चाँदी की अशुद्धता दूर कर दी जाती है</para>
  <para style="q2" vid="PRO 25:4">तो वह सुनार के काम की वस्तु बन जाती है;<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />जब दुष्‍टों को राजा के सामने से दूर कर दिया जाता है</para>
  <para style="q2" vid="PRO 25:5">तो उसका सिंहासन धार्मिकता के कारण स्थिर रहता है।<verse eid="PRO 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />राजा के सामने अपनी बड़ाई न करना,</para>
  <para style="q2" vid="PRO 25:6">और न ही बड़े लोगों के स्थान में खड़ा होना;<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />क्योंकि किसी कुलीन पुरुष के सामने तुझे नीचे बैठा दिए जाने की अपेक्षा यह अच्छा है</para>
  <para style="q2" vid="PRO 25:7">कि तुझसे कहा जाए, “आगे आकर बैठ।”<verse eid="PRO 25:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8" />जो तूने देखा है उसे तुरंत न्यायालय में लेकर न जा;</para>
  <para style="q2" vid="PRO 25:8">नहीं तो तू बाद में क्या करेगा</para>
  <para style="q3" vid="PRO 25:8">जब तेरा पड़ोसी तुझे लज्‍जित करेगा?<verse eid="PRO 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />अपने पड़ोसी के साथ विवाद में अपना पक्ष तो रख,</para>
  <para style="q2" vid="PRO 25:9">परंतु किसी दूसरे का भेद न खोल।<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />कहीं ऐसा न हो कि सुननेवाला तुझे धिक्‍‍कारे,</para>
  <para style="q2" vid="PRO 25:10">और तेरी बदनामी होती रहे।<verse eid="PRO 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />उचित समय पर कही गई बात चाँदी की टोकरियों में रखे</para>
  <para style="q2" vid="PRO 25:11">सोने के सेबों के समान होती है।<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />जैसे सोने की बाली या शुद्ध सोने का जेवर अच्छा लगता है,</para>
  <para style="q2" vid="PRO 25:12">वैसे ही माननेवाले के कान में बुद्धिमान की डाँट होती है।<verse eid="PRO 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />कटनी के समय की ठंडी-ठंडी हवा के समान ही विश्‍वासयोग्य दूत होता है,</para>
  <para style="q2" vid="PRO 25:13">क्योंकि वह अपने भेजनेवालों अर्थात् अपने स्वामियों का जी ठंडा करता है।<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />झूठ-मूठ के दान की बड़ाई मारनेवाला मनुष्य बिना वर्षा के बादल</para>
  <para style="q2" vid="PRO 25:14">और हवा के समान होता है।<verse eid="PRO 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />धीरज धरने के द्वारा शासक को मनाया जा सकता है,</para>
  <para style="q2" vid="PRO 25:15">और विनम्र वाणी हड्डी को भी तोड़ डालती है।<verse eid="PRO 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />यदि तुझे मधु मिला है तो उतना ही खा जितना तेरे लिए आवश्यक हो,</para>
  <para style="q2" vid="PRO 25:16">ऐसा न हो कि तू अधिक खाकर उसे उगल दे।<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />अपने पड़ोसी के घर बार-बार जाने से अपने पैरों को रोक,</para>
  <para style="q2" vid="PRO 25:17">ऐसा न हो कि वह ऊब जाए और तुझसे घृणा करे।<verse eid="PRO 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />जो अपने पड़ोसी के विरुद्ध झूठी साक्षी देता है,</para>
  <para style="q2" vid="PRO 25:18">वह घन, तलवार और पैने तीर के समान होता है।<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />विपत्ति के समय विश्‍वासघाती पर भरोसा रखना,</para>
  <para style="q2" vid="PRO 25:19">दुखते दाँत या लड़खड़ाते पैर के समान है।<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />दुःखी मनुष्य के सामने गीत गानेवाला उस व्यक्‍ति के समान है</para>
  <para style="q2" vid="PRO 25:20">जो जाड़े के दिन उसके वस्‍त्र उतारता है</para>
  <para style="q3" vid="PRO 25:20">या उसके जले पर नमक छिड़कता है।<verse eid="PRO 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />यदि तेरा बैरी भूखा है तो उसे खाना खिला,</para>
  <para style="q2" vid="PRO 25:21">और यदि वह प्यासा है तो उसे पानी पिला;<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />क्योंकि इससे तू उसके सिर पर अंगारों का ढेर लगाएगा,</para>
  <para style="q2" vid="PRO 25:22">और यहोवा तुझे प्रतिफल देगा।<verse eid="PRO 25:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />उत्तरी वायु वर्षा लाती है,</para>
  <para style="q2" vid="PRO 25:23">और चुगलखोर जीभ चेहरे पर क्रोध लाती है।<verse eid="PRO 25:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />झगड़ालू पत्‍नी के साथ घर के भीतर रहने की अपेक्षा</para>
  <para style="q2" vid="PRO 25:24">छत पर एक कोने में रहना अच्छा है।<verse eid="PRO 25:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />जैसे थके मांदे प्राणी के लिए ठंडा जल,</para>
  <para style="q2" vid="PRO 25:25">वैसे ही दूर देश से मिला शुभ समाचार होता है।<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />दुष्‍ट के सामने झुकनेवाला धर्मी जन गंदले सोते</para>
  <para style="q2" vid="PRO 25:26">और दूषित कुएँ के समान होता है।<verse eid="PRO 25:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />अधिक मधु खाना अच्छा नहीं,</para>
  <para style="q2" vid="PRO 25:27">और न अपने ही सम्मान की खोज करना कोई सम्मान की बात है।<verse eid="PRO 25:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />जिस मनुष्य में आत्मसंयम नहीं होता,</para>
  <para style="q2" vid="PRO 25:28">वह ऐसे नगर के समान होता है</para>
  <para style="q3" vid="PRO 25:28">जिसकी शहरपनाह तोड़ दी गई हो।<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />जैसे ग्रीष्मकाल में हिम का गिरना</para>
  <para style="q2" vid="PRO 26:1">और कटनी के समय वर्षा का होना,</para>
  <para style="q3" vid="PRO 26:1">वैसे ही मूर्ख को सम्मान मिलना भी उचित नहीं।<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />जैसे फुदकती हुई गौरैया और उड़ती हुई अबाबील नहीं ठहरती,</para>
  <para style="q2" vid="PRO 26:2">वैसे ही अकारण दिया गया शाप भी नहीं ठहरता।<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />घोड़े के लिए चाबुक, गधे के लिए लगाम,</para>
  <para style="q2" vid="PRO 26:3">और मूर्खों की पीठ के लिए छड़ी है।<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />मूर्ख को उसकी मूर्खता के अनुसार उत्तर न देना,</para>
  <para style="q2" vid="PRO 26:4">ऐसा न हो कि तू भी उसके तुल्य ठहरे।<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />मूर्ख को उसी की मूर्खता के आधार पर उत्तर देना,</para>
  <para style="q2" vid="PRO 26:5">ऐसा न हो कि वह अपनी दृष्‍टि में बुद्धिमान ठहरे।<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />जो मूर्ख के हाथ से संदेश भेजता है,</para>
  <para style="q2" vid="PRO 26:6">वह मानो अपने पैर पर कुल्हाड़ी मारता</para>
  <para style="q3" vid="PRO 26:6">और हिंसा को निमंत्रण देता है।<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />जैसे लंगड़े व्यक्‍ति के लटकते हुए पैर व्यर्थ होते हैं,</para>
  <para style="q2" vid="PRO 26:7">वैसे ही मूर्खों के मुँह में नीतिवचन होता है।<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />जैसे गोफन में पत्थर को बाँधना व्यर्थ होता है,</para>
  <para style="q2" vid="PRO 26:8">वैसे ही मूर्ख को सम्मान देना होता है।<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />जैसे शराबी के हाथ में काँटा गड़ता है,</para>
  <para style="q2" vid="PRO 26:9">वैसे ही मूर्खों के मुँह में नीतिवचन होता है।<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />मूर्खों और राह चलते लोगों को मज़दूरी पर लगानेवाला उस धनुर्धारी के समान है</para>
  <para style="q2" vid="PRO 26:10">जो हर एक को घायल करता है।<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />जैसे कुत्ता अपनी उलटी को चाटता है,</para>
  <para style="q2" vid="PRO 26:11">वैसे ही मूर्ख अपनी मूर्खता को दोहराता है।<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />क्या तू ऐसे मनुष्य को देखता है जो अपनी ही दृष्‍टि में बुद्धिमान है?</para>
  <para style="q2" vid="PRO 26:12">उससे बढ़कर आशा तो मूर्ख के लिए है।<verse eid="PRO 26:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />आलसी मनुष्य कहता है, “मार्ग में सिंह है!</para>
  <para style="q2" vid="PRO 26:13">चौक में सिंह है!”<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />जैसे किवाड़ अपने कब्ज़ों पर घूमता है,</para>
  <para style="q2" vid="PRO 26:14">वैसे ही आलसी अपनी खाट पर करवटें लेता है।<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />आलसी मनुष्य भोजन की थाली में अपना हाथ डालता तो है,</para>
  <para style="q2" vid="PRO 26:15">परंतु अपने मुँह तक ले जाने में उसे थकान होती है।<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />आलसी स्वयं को उन सात मनुष्यों से भी अधिक बुद्धिमान समझता है</para>
  <para style="q2" vid="PRO 26:16">जो समझदारी से उत्तर दे सकते हैं।<verse eid="PRO 26:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />जो दूसरों के झगड़े में दख़ल देता है,</para>
  <para style="q2" vid="PRO 26:17">वह उसके समान है जो आवारा कुत्ते को कानों से पकड़ता है।<verse eid="PRO 26:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />जैसा एक पागल जो जलती लकड़ियाँ</para>
  <para style="q2" vid="PRO 26:18">तथा घातक तीर फेंकता है,<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />वैसा ही वह मनुष्य होता है जो अपने पड़ोसी को धोखा देकर कहता है,</para>
  <para style="q2" vid="PRO 26:19">“अरे, मैं तो मज़ाक कर रहा था।”<verse eid="PRO 26:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />जैसे लकड़ी न होने से आग बुझ जाती है,</para>
  <para style="q2" vid="PRO 26:20">वैसे ही जहाँ कानाफूसी करनेवाला नहीं होता,</para>
  <para style="q3" vid="PRO 26:20">वहाँ झगड़ा शांत हो जाता है।<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />जैसे अंगारों के लिए कोयला और आग के लिए लकड़ी होती है,</para>
  <para style="q2" vid="PRO 26:21">वैसे ही झगड़ा भड़काने के लिए झगड़ालू मनुष्य होता है।<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />कानाफूसी करनेवाले की बातें स्वादिष्‍ट भोजन के समान होती हैं,</para>
  <para style="q2" vid="PRO 26:22">और वे मन में समा जाती हैं।<verse eid="PRO 26:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />जैसे मिट्टी के बरतन पर चाँदी की कलई चढ़ी होती है,</para>
  <para style="q2" vid="PRO 26:23">वैसे ही दुष्‍‍ट मनवाले की चिकनी-चुपड़ी बातें होती हैं।<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />बैरी अपनी बातों से बैर को छिपा लेता है,</para>
  <para style="q2" vid="PRO 26:24">और अपने भीतर छल को दबाए रखता है।<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />जब वह मीठी-मीठी बातें करे तो उसका विश्‍वास न करना,</para>
  <para style="q2" vid="PRO 26:25">क्योंकि उसके मन में सात घृणित बातें हैं।<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />चाहे छल के कारण उसका बैर छिप भी जाए,</para>
  <para style="q2" vid="PRO 26:26">फिर भी उसकी दुष्‍‍टता सभा के बीच प्रकट हो जाएगी।<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />जो गड्‌ढा खोदता है वह स्वयं उसमें गिरेगा,</para>
  <para style="q2" vid="PRO 26:27">और जो पत्थर लुढ़काता है</para>
  <para style="q3" vid="PRO 26:27">वह उसी पत्थर के नीचे दब जाएगा।<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />जो व्यक्‍ति किसी को अपनी झूठी बातों से घायल करता है,</para>
  <para style="q2" vid="PRO 26:28">वह उससे बैर रखता है;</para>
  <para style="q3" vid="PRO 26:28">और चापलूसी करनेवाला मुँह विनाशकारी होता है।<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />आने वाले कल के विषय में डींग न मार,</para>
  <para style="q2" vid="PRO 27:1">क्योंकि तू नहीं जानता कि वह दिन तेरे लिए क्या लेकर आएगा।<verse eid="PRO 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />तेरी प्रशंसा कोई दूसरा करे तो करे,</para>
  <para style="q2" vid="PRO 27:2">परंतु तू आप न करना;</para>
  <para style="q1" vid="PRO 27:2">कोई अन्य करे तो करे,</para>
  <para style="q2" vid="PRO 27:2">परंतु तू अपनी प्रशंसा न करना।<verse eid="PRO 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />पत्थर तो भारी और बालू वज़नदार होती है,</para>
  <para style="q2" vid="PRO 27:3">परंतु मूर्ख का क्रोध इन दोनों से भी भारी होता है।<verse eid="PRO 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />प्रकोप तो भयानक और क्रोध बाढ़ के समान होता है,</para>
  <para style="q2" vid="PRO 27:4">परंतु ईर्ष्या के सामने कौन टिक सकता है?<verse eid="PRO 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />खुली डाँट, गुप्‍त प्रेम से उत्तम है।<verse eid="PRO 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />मित्र के द्वारा लगे घाव विश्‍वासयोग्य होते हैं,</para>
  <para style="q2" vid="PRO 27:6">परंतु बैरी अधिक चुंबन करता है।<verse eid="PRO 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />तृप्‍त होने पर मनुष्य को शहद भी फीका लगता है,</para>
  <para style="q2" vid="PRO 27:7">परंतु भूखे को कड़वी वस्तु भी मीठी लगती है।<verse eid="PRO 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />अपना घर छोड़कर भटकनेवाला मनुष्य उस पक्षी के समान है,</para>
  <para style="q2" vid="PRO 27:8">जो अपना घोंसला छोड़कर उड़ता-फिरता है।<verse eid="PRO 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />जैसे तेल और इत्र मन को आनंदित करते हैं,</para>
  <para style="q2" vid="PRO 27:9">वैसे ही मित्र के हृदय से निकली</para>
  <para style="q3" vid="PRO 27:9">मनोहर सम्मति भी मन को आनंदित करती है।<verse eid="PRO 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />अपने मित्र और अपने पिता के मित्र को न त्यागना,</para>
  <para style="q2" vid="PRO 27:10">और अपनी विपत्ति के समय अपने भाई के घर न जाना;</para>
  <para style="q3" vid="PRO 27:10">दूर रहनेवाले भाई की अपेक्षा निकट रहनेवाला पड़ोसी उत्तम है।<verse eid="PRO 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />हे मेरे पुत्र, बुद्धिमान बन और मेरे हृदय को प्रसन्‍न‍ कर,</para>
  <para style="q2" vid="PRO 27:11">तब मैं अपने निंदा करनेवालों को उत्तर दे सकूँगा।<verse eid="PRO 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />विपत्ति को आते देखकर समझदार मनुष्य छिप जाता है,</para>
  <para style="q2" vid="PRO 27:12">परंतु नासमझ लोग बढ़े चले जाते हैं</para>
  <para style="q3" vid="PRO 27:12">और हानि उठाते हैं।<verse eid="PRO 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />अजनबी की जमानत देनेवाले के वस्‍त्र,</para>
  <para style="q2" vid="PRO 27:13">और परदेशी की जमानत देनेवाले से कोई वस्तु गिरवी रख ले।<verse eid="PRO 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />यदि कोई भोर को उठकर अपने पड़ोसी को ऊँचे शब्द से आशीर्वाद देता है,</para>
  <para style="q2" vid="PRO 27:14">तो उस पड़ोसी के लिए वह शाप समझा जाता है।<verse eid="PRO 27:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />वर्षा के दिन पानी का निरंतर टपकना,</para>
  <para style="q2" vid="PRO 27:15">और झगड़ालू पत्‍नी दोनों एक समान हैं;<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />उस स्‍त्री को रोकना ऐसा है मानो हवा को रोकना या</para>
  <para style="q2" vid="PRO 27:16">अपने दाहिने हाथ से तेल को पकड़ना।<verse eid="PRO 27:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />जैसे लोहा, लोहे को तेज़ करता है,</para>
  <para style="q2" vid="PRO 27:17">वैसे ही मित्र, अपने मित्र को सुधारता है।<verse eid="PRO 27:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />जो अंजीर के पेड़ की देखभाल करता है,</para>
  <para style="q2" vid="PRO 27:18">वह उसका फल खाएगा;</para>
  <para style="q1" vid="PRO 27:18">और जो अपने स्वामी की सेवा करता है,</para>
  <para style="q2" vid="PRO 27:18">वह सम्मान पाएगा।<verse eid="PRO 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />जैसे पानी चेहरे को प्रतिबिंबित करता है,</para>
  <para style="q2" vid="PRO 27:19">वैसे ही मनुष्य का मन मनुष्य को प्रतिबिंबित करता है।<verse eid="PRO 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />जैसे अधोलोक और विनाशलोक कभी तृप्‍त नहीं होते,</para>
  <para style="q2" vid="PRO 27:20">वैसे ही मनुष्य की आँखें भी कभी तृप्‍त नहीं होतीं।<verse eid="PRO 27:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />जैसे कुठाली के द्वारा चाँदी को और भट्ठी के द्वारा सोने को,</para>
  <para style="q2" vid="PRO 27:21">वैसे ही मनुष्य को उसकी प्रशंसा के द्वारा परखा जाता है।<verse eid="PRO 27:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />चाहे तू मूर्ख को ओखली में डालकर अनाज के साथ मूसल से कूटे,</para>
  <para style="q2" vid="PRO 27:22">फिर भी उसकी मूर्खता उससे दूर नहीं होगी।<verse eid="PRO 27:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />अपनी भेड़-बकरियों की दशा भली-भाँति जान ले,</para>
  <para style="q2" vid="PRO 27:23">और अपने पशुओं के झुंड पर ध्यान दे;<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />धन-संपत्ति तो सदा नहीं रहती,</para>
  <para style="q2" vid="PRO 27:24">और न ही राजमुकुट पीढ़ी से पीढ़ी तक बना रहता है।<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />जब घास कट जाती है, और नई घास उगने लगती है,</para>
  <para style="q2" vid="PRO 27:25">और पहाड़ों से चारा इकट्ठा किया जाता है,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />तब मेमने तेरे वस्‍त्र के लिए होंगे,</para>
  <para style="q2" vid="PRO 27:26">और बकरों से खेत का मूल्य चुकाया जाएगा।<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />तेरे पास बकरियों का पर्याप्‍त दूध होगा,</para>
  <para style="q2" vid="PRO 27:27">जिससे तेरे और तेरे घराने की तृप्‍ति</para>
  <para style="q3" vid="PRO 27:27">और तेरी दासियों का पोषण होगा।<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />दुष्‍ट तब भी भागते हैं जब कोई उनका पीछा नहीं करता,</para>
  <para style="q2" vid="PRO 28:1">परंतु धर्मी जवान सिंह के समान निडर रहते हैं।<verse eid="PRO 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />देश में विद्रोह की स्थिति होने पर उसके कई शासक बन बैठते हैं,</para>
  <para style="q2" vid="PRO 28:2">परंतु एक समझदार और ज्ञानवान मनुष्य के कारण देश में स्थिरता रहती है।<verse eid="PRO 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />जो निर्धन पुरुष कंगालों पर अंधेर करता है,</para>
  <para style="q2" vid="PRO 28:3">वह ऐसी भारी वर्षा के समान है</para>
  <para style="q3" vid="PRO 28:3">जो कुछ भोजन-वस्तु नहीं छोड़ती।<verse eid="PRO 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />जो लोग व्यवस्था को त्याग देते हैं</para>
  <para style="q2" vid="PRO 28:4">वे दुष्‍टों की प्रशंसा करते हैं,</para>
  <para style="q1" vid="PRO 28:4">परंतु जो व्यवस्था का पालन करते हैं</para>
  <para style="q2" vid="PRO 28:4">वे उनका विरोध करते हैं।<verse eid="PRO 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />बुरे लोग न्याय को नहीं समझते,</para>
  <para style="q2" vid="PRO 28:5">परंतु यहोवा को खोजनेवाले सब कुछ समझते हैं।<verse eid="PRO 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />खराई से चलनेवाला निर्धन मनुष्य,</para>
  <para style="q2" vid="PRO 28:6">टेढ़ी चाल चलनेवाले धनी मनुष्य से उत्तम है।<verse eid="PRO 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />व्यवस्था का पालन करनेवाला पुत्र समझदार होता है,</para>
  <para style="q2" vid="PRO 28:7">परंतु उड़ानेवालों का साथी अपने पिता को लज्‍जित करता है।<verse eid="PRO 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />जो ब्याज और अनुचित लाभ के द्वारा अपना धन बढ़ाता है,</para>
  <para style="q2" vid="PRO 28:8">वह उसके लिए जमा करता है</para>
  <para style="q3" vid="PRO 28:8">जो कंगालों पर कृपा करता है।<verse eid="PRO 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />जो व्यवस्था को सुनने से अपना कान फेर लेता है,</para>
  <para style="q2" vid="PRO 28:9">उसकी प्रार्थना भी घृणित ठहरती है।<verse eid="PRO 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />जो सीधे लोगों को भटकाकर दुष्‍टता के मार्ग पर ले जाता है</para>
  <para style="q2" vid="PRO 28:10">वह अपने ही खोदे हुए गड्‌ढे में गिर जाता है;</para>
  <para style="q3" vid="PRO 28:10">परंतु खरे लोग उत्तम वस्तुओं के भागी होंगे।<verse eid="PRO 28:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />धनी पुरुष अपनी ही दृष्‍टि में बुद्धिमान होता है,</para>
  <para style="q2" vid="PRO 28:11">परंतु जो निर्धन व्यक्‍ति समझदार है</para>
  <para style="q3" vid="PRO 28:11">वह उसे परख लेता है।<verse eid="PRO 28:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />जब धर्मी लोग विजयी होते हैं तो बड़ा आनंद होता है,</para>
  <para style="q2" vid="PRO 28:12">परंतु जब दुष्‍ट प्रबल होते हैं तो लोग स्वयं को छिपा लेते हैं।<verse eid="PRO 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />जो अपने अपराध छिपाता है वह सफल नहीं होगा,</para>
  <para style="q2" vid="PRO 28:13">परंतु जो उन्हें मानकर छोड़ देता है</para>
  <para style="q3" vid="PRO 28:13">उस पर दया की जाएगी।<verse eid="PRO 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />क्या ही धन्य है वह जो सदा प्रभु का भय मानता है,</para>
  <para style="q2" vid="PRO 28:14">परंतु जो अपने मन को कठोर करता है</para>
  <para style="q3" vid="PRO 28:14">वह विपत्ति में पड़ता है।<verse eid="PRO 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />कंगाल प्रजा पर प्रभुता करनेवाला दुष्‍ट शासक दहाड़ते हुए सिंह</para>
  <para style="q2" vid="PRO 28:15">और झपटते हुए रीछ के समान होता है।<verse eid="PRO 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />नासमझ शासक बहुत अंधेर करता है;</para>
  <para style="q2" vid="PRO 28:16">परंतु जो अन्याय के धन से घृणा करता है</para>
  <para style="q3" vid="PRO 28:16">वह दीर्घायु होता है।<verse eid="PRO 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />जो किसी की हत्या के अपराध से दबा हो,</para>
  <para style="q2" vid="PRO 28:17">वह मृत्यु तक भागता फिरेगा;</para>
  <para style="q3" vid="PRO 28:17">कोई उसकी सहायता न करे।<verse eid="PRO 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />जो खराई से चलता है वह बचाया जाएगा,</para>
  <para style="q2" vid="PRO 28:18">परंतु जो टेढ़ी चाल चलता है</para>
  <para style="q3" vid="PRO 28:18">वह अचानक गिर पड़ेगा।<verse eid="PRO 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />जो अपनी भूमि को जोतेगा,</para>
  <para style="q2" vid="PRO 28:19">उसके पास भरपूर भोजन होगा;</para>
  <para style="q1" vid="PRO 28:19">परंतु जो व्यर्थ कामों में लगा रहता है,</para>
  <para style="q2" vid="PRO 28:19">वह निर्धनता से घिरा रहेगा।<verse eid="PRO 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />विश्‍वासयोग्य मनुष्य बहुत सी आशिषें पाएगा,</para>
  <para style="q2" vid="PRO 28:20">परंतु जो शीघ्र धनी बनना चाहता है,</para>
  <para style="q3" vid="PRO 28:20">वह निश्‍चय दंड पाएगा।<verse eid="PRO 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />पक्षपात करना अच्छा नहीं; क्योंकि यह अच्छा नहीं है</para>
  <para style="q2" vid="PRO 28:21">कि पुरुष रोटी के एक टुकड़े के लिए बिक जाए।<verse eid="PRO 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />लोभी मनुष्य धन के पीछे भागता है,</para>
  <para style="q2" vid="PRO 28:22">और यह नहीं जानता कि कंगाली उस पर आ पड़ेगी।<verse eid="PRO 28:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />जो किसी मनुष्य को डाँटता है</para>
  <para style="q2" vid="PRO 28:23">वह बाद में चिकनी-चुपड़ी बातें करनेवाले से अधिक प्रिय हो जाता है।<verse eid="PRO 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />जो अपने पिता या अपनी माता को लूटकर कहता है,</para>
  <para style="q2" vid="PRO 28:24">“यह अपराध नहीं,” वह नाश करनेवाले मनुष्य का साथी ठहरता है।<verse eid="PRO 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />लालची मनुष्य झगड़ा उत्पन्‍न करता है,</para>
  <para style="q2" vid="PRO 28:25">परंतु जो यहोवा पर भरोसा रखता है वह फलता-फूलता है।<verse eid="PRO 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />जो अपने ऊपर भरोसा रखता है, वह मूर्ख है;</para>
  <para style="q2" vid="PRO 28:26">परंतु जो बुद्धिमानी से चलता है, वह छुटकारा पाएगा।<verse eid="PRO 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />जो कंगाल को दान देता है उसे घटी नहीं होती,</para>
  <para style="q2" vid="PRO 28:27">परंतु जो उससे दृष्‍टि फेर लेता है</para>
  <para style="q3" vid="PRO 28:27">उस पर बहुत से शाप आ पड़ते हैं।<verse eid="PRO 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />जब दुष्‍ट प्रबल होते हैं तो लोग छिप जाते हैं,</para>
  <para style="q2" vid="PRO 28:28">परंतु जब वे नाश हो जाते हैं तो धर्मी उन्‍नति करते हैं।<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />जो मनुष्य डाँट खा खाकर भी हठ नहीं छोड़ता,</para>
  <para style="q2" vid="PRO 29:1">वह अचानक नष्‍‍ट हो जाएगा और फिर कोई उपाय न रहेगा।<verse eid="PRO 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />जब धर्मी लोग ऊँचा पद पाते हैं तो प्रजा आनंदित होती है;</para>
  <para style="q2" vid="PRO 29:2">परंतु जब दुष्‍ट मनुष्य प्रभुता करता है</para>
  <para style="q3" vid="PRO 29:2">तो प्रजा कराह उठती है।<verse eid="PRO 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />जो मनुष्य बुद्धि से प्रेम रखता है</para>
  <para style="q2" vid="PRO 29:3">वह अपने पिता को आनंदित करता है,</para>
  <para style="q1" vid="PRO 29:3">परंतु जो वेश्याओं की संगति करता है</para>
  <para style="q2" vid="PRO 29:3">वह धन-संपत्ति को उड़ा देता है।<verse eid="PRO 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />राजा न्याय से देश को स्थिर करता है,</para>
  <para style="q2" vid="PRO 29:4">परंतु घूस लेनेवाला देश का विनाश करता है।<verse eid="PRO 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />जो व्यक्‍ति अपने पड़ोसी से चिकनी-चुपड़ी बातें करता है,</para>
  <para style="q2" vid="PRO 29:5">वह अपने<note caller="+" style="f"><char style="fr" closed="false">29:5 </char><char style="ft" closed="false">या उसके</char></note> पैरों के लिए जाल बिछाता है।<verse eid="PRO 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />दुष्‍ट मनुष्य अपने अपराध के जाल में फँस जाता है,</para>
  <para style="q2" vid="PRO 29:6">परंतु धर्मी जन गीत गाते हुए आनंद मनाता है।<verse eid="PRO 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />धर्मी मनुष्य निर्धनों के अधिकारों के बारे में सोचता है,</para>
  <para style="q2" vid="PRO 29:7">परंतु दुष्‍ट उनकी चिंता नहीं करता।<verse eid="PRO 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />ठट्ठा करनेवाले नगर में आग लगा देते हैं,</para>
  <para style="q2" vid="PRO 29:8">परंतु बुद्धिमान लोग क्रोध को शांत कर देते हैं।<verse eid="PRO 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />जब बुद्धिमान व्यक्‍ति का किसी मूर्ख से विवाद होता है</para>
  <para style="q2" vid="PRO 29:9">तो मूर्ख या तो क्रोधित होता है</para>
  <para style="q1" vid="PRO 29:9">या ठट्ठा करता है,</para>
  <para style="q2" vid="PRO 29:9">और वहाँ शांति नहीं रहती।<verse eid="PRO 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />हत्या करनेवाले उस पुरुष से बैर रखते हैं जो निर्दोष है,</para>
  <para style="q2" vid="PRO 29:10">परंतु खरे लोग उसकी चिंता करते हैं।<verse eid="PRO 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />मूर्ख अपने क्रोध को पूरी तरह से प्रकट करता है,</para>
  <para style="q2" vid="PRO 29:11">परंतु बुद्धिमान अपने क्रोध को शांत कर देता है।<verse eid="PRO 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />यदि शासक झूठी बातों पर ध्यान देता है</para>
  <para style="q2" vid="PRO 29:12">तो उसके सब पदाधिकारी दुष्‍ट हो जाते हैं।<verse eid="PRO 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />निर्धन और अत्याचारी मनुष्य में यह समानता है</para>
  <para style="q2" vid="PRO 29:13">कि यहोवा दोनों की आँखों को ज्योति देता है।<verse eid="PRO 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />जो राजा कंगालों का न्याय सच्‍चाई से करता है,</para>
  <para style="q2" vid="PRO 29:14">उसका सिंहासन सदा स्थिर रहता है।<verse eid="PRO 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />छड़ी और ताड़ना से बुद्धि प्राप्‍त होती है,</para>
  <para style="q2" vid="PRO 29:15">परंतु जिस बच्‍चे को मनमानी करने की छूट दी जाती है</para>
  <para style="q3" vid="PRO 29:15">वह अपनी माता की लज्‍जा का कारण होता है।<verse eid="PRO 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />जब दुष्‍ट लोग बढ़ते हैं तो अपराध भी बढ़ता है,</para>
  <para style="q2" vid="PRO 29:16">परंतु धर्मी लोग उनके पतन को देखेंगे।<verse eid="PRO 29:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />अपने पुत्र की ताड़ना कर, तो वह तुझे सुख प्रदान करेगा; हाँ,</para>
  <para style="q2" vid="PRO 29:17">वह तेरे मन को आनंदित करेगा।<verse eid="PRO 29:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />दर्शन के अभाव में लोग निरंकुश हो जाते हैं,</para>
  <para style="q2" vid="PRO 29:18">पर जो व्यवस्था का पालन करता है वह धन्य होता है।<verse eid="PRO 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />दास को केवल बातों के द्वारा सुधारा नहीं जा सकता,</para>
  <para style="q2" vid="PRO 29:19">क्योंकि समझने पर भी वह नहीं मानता।<verse eid="PRO 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />क्या तू बोलने में उतावली करनेवाले व्यक्‍ति को देखता है?</para>
  <para style="q2" vid="PRO 29:20">उससे बढ़कर आशा तो मूर्ख के लिए है।<verse eid="PRO 29:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />जो अपने दास को बचपन से ही लाड़-प्यार से पालता है,</para>
  <para style="q2" vid="PRO 29:21">वही दास अंत में उसका पुत्र बन बैठेगा।<verse eid="PRO 29:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />क्रोधी मनुष्य झगड़ा उत्पन्‍न करता है,</para>
  <para style="q2" vid="PRO 29:22">और अत्यंत क्रोध करनेवाला अपराध पर अपराध करता है।<verse eid="PRO 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />मनुष्य का अहंकार उसे नीचा दिखाएगा,</para>
  <para style="q2" vid="PRO 29:23">परंतु विनम्र व्यक्‍ति आदर प्राप्‍त करेगा।<verse eid="PRO 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />जो चोर का साथी होता है वह अपने जीवन से बैर रखता है;</para>
  <para style="q2" vid="PRO 29:24">वह शपथ खाकर भी भेद नहीं खोलता।<verse eid="PRO 29:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />जो मनुष्य का भय मानता है वह अपने लिए जाल बिछाता है,</para>
  <para style="q2" vid="PRO 29:25">परंतु जो यहोवा पर भरोसा रखता है, वह सुरक्षित रहता है।<verse eid="PRO 29:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />शासक की कृपा तो कई लोग पाना चाहते हैं,</para>
  <para style="q2" vid="PRO 29:26">परंतु मनुष्य को न्याय यहोवा ही से मिलता है।<verse eid="PRO 29:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />धर्मी लोग कुटिल मनुष्य से घृणा करते हैं,</para>
  <para style="q2" vid="PRO 29:27">और दुष्‍ट जन खरी चाल चलनेवाले से घृणा करता है।<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s1">आगूर के वचन</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 30:1" />याके के पुत्र आगूर के प्रभावशाली वचन।</para>
  <para style="q2" vid="PRO 30:1">उस पुरुष ने ईतीएल और उक्‍‍काल से यह कहा :<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />निश्‍चय ही मैं मनुष्यों में सब से अधिक बुद्धिहीन हूँ</para>
  <para style="q2" vid="PRO 30:2">और मुझमें मनुष्य की सी समझ नहीं।<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />मैंने न तो बुद्धि प्राप्‍त की है,</para>
  <para style="q2" vid="PRO 30:3">और न ही परमपवित्र का ज्ञान मुझे मिला है।<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />कौन है जो स्वर्ग में चढ़कर फिर उतर आया?</para>
  <para style="q2" vid="PRO 30:4">वायु को अपनी मुट्ठी में किसने बटोर रखा है?</para>
  <para style="q1" vid="PRO 30:4">समुद्र को वस्‍त्र में किसने बाँध लिया है?</para>
  <para style="q2" vid="PRO 30:4">पृथ्वी की सीमाओं को किसने निर्धारित किया है?</para>
  <para style="q1" vid="PRO 30:4">क्या तू जानता है कि उसका नाम क्या है,</para>
  <para style="q2" vid="PRO 30:4">और उसके पुत्र का नाम क्या है?<verse eid="PRO 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />परमेश्‍वर का एक-एक वचन ताया हुआ है;</para>
  <para style="q2" vid="PRO 30:5">जो परमेश्‍वर की शरण लेते हैं</para>
  <para style="q3" vid="PRO 30:5">उनके लिए वह ढाल ठहरा है।<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />तू उसके वचनों में कुछ न जोड़,</para>
  <para style="q2" vid="PRO 30:6">कहीं ऐसा न हो कि वह तुझे डाँटे</para>
  <para style="q3" vid="PRO 30:6">और तू झूठा ठहरे।<verse eid="PRO 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />मैंने तुझसे दो वर माँगे हैं;</para>
  <para style="q2" vid="PRO 30:7">मेरे मरने से पहले उन्हें मुझे देने से इनकार न कर :<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />धोखे और झूठ को मुझसे दूर कर दे;</para>
  <para style="q2" vid="PRO 30:8">मुझे न तो निर्धन कर और न धनी बना।</para>
  <para style="q3" vid="PRO 30:8">मेरे प्रतिदिन का भोजन मुझे दिया कर।<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />कहीं ऐसा न हो कि मेरे पास बहुत अधिक हो जाए</para>
  <para style="q2" vid="PRO 30:9">और मैं तेरा इनकार करके कहूँ,</para>
  <para style="q1" vid="PRO 30:9">“यहोवा कौन है?”</para>
  <para style="q2" vid="PRO 30:9">या मैं घटी में पड़कर चोरी करूँ</para>
  <para style="q3" vid="PRO 30:9">और अपने परमेश्‍वर के नाम पर कलंक लगाऊँ।<verse eid="PRO 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />किसी दास की उसके स्वामी से चुगली न करना,</para>
  <para style="q2" vid="PRO 30:10">ऐसा न हो कि वह तुझे कोसे</para>
  <para style="q3" vid="PRO 30:10">और तू दोषी पाया जाए।<verse eid="PRO 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />ऐसे लोग भी हैं जो अपने पिता को शाप देते हैं</para>
  <para style="q2" vid="PRO 30:11">और अपनी माता को धन्य नहीं कहते।<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />ऐसे लोग भी हैं जो अपनी दृष्‍टि में तो शुद्ध हैं,</para>
  <para style="q2" vid="PRO 30:12">परंतु उनका मैल धुला नहीं है।<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />ऐसे लोग भी हैं, देखो, उनकी आँखें घमंड से कैसी भरी रहती हैं!</para>
  <para style="q2" vid="PRO 30:13">और उनकी भौंहें कैसी चढ़ी रहती हैं!<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />ऐसे लोग भी हैं जिनके दाँत तलवार के समान</para>
  <para style="q2" vid="PRO 30:14">और दाढ़ें छुरियों के समान हैं</para>
  <para style="q1" vid="PRO 30:14">कि पृथ्वी पर से दीन लोगों को</para>
  <para style="q2" vid="PRO 30:14">और मनुष्यों में से दरिद्रों को मिटा डालें।<verse eid="PRO 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />जोंक की दो बेटियाँ हैं।</para>
  <para style="q2" vid="PRO 30:15">जैसे वे “दे! और दे!” कहती रहती हैं,</para>
  <para style="q1" vid="PRO 30:15">वैसे ही तीन वस्तुएँ हैं जो तृप्‍त नहीं होतीं,</para>
  <para style="q2" vid="PRO 30:15">बल्कि चार हैं जो कभी “बस” नहीं कहतीं :<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />अधोलोक, बाँझ की कोख, भूमि जो कभी जल से तृप्‍त नहीं होती,</para>
  <para style="q2" vid="PRO 30:16">और आग जो कभी “बस” नहीं कहती।<verse eid="PRO 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />जो आँख अपने पिता की हँसी उड़ाती है,</para>
  <para style="q2" vid="PRO 30:17">और माता की आज्ञा मानने को तुच्छ जानती है,</para>
  <para style="q1" vid="PRO 30:17">उस आँख को तराई के कौए नोच नोचकर निकालेंगे,</para>
  <para style="q2" vid="PRO 30:17">और गिद्ध के बच्‍चे खा जाएँगे।<verse eid="PRO 30:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />तीन बातें मेरी समझ से परे हैं,</para>
  <para style="q2" vid="PRO 30:18">बल्कि चार हैं जिन्हें मैं समझ नहीं सकता :<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />आकाश में उकाब की चाल,</para>
  <para style="q2" vid="PRO 30:19">चट्टान पर सर्प की चाल,</para>
  <para style="q1" vid="PRO 30:19">बीच समुद्र में जहाज़ की चाल,</para>
  <para style="q2" vid="PRO 30:19">और युवती के साथ पुरुष की चाल।<verse eid="PRO 30:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />व्यभिचारिणी की चाल तो यह है :</para>
  <para style="q2" vid="PRO 30:20">वह खाकर अपना मुँह पोंछती, और कहती है,</para>
  <para style="q3" vid="PRO 30:20">“मैंने कोई बुरा काम नहीं किया है।”<verse eid="PRO 30:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />तीन बातें हैं जिनसे पृथ्वी काँपती है,</para>
  <para style="q2" vid="PRO 30:21">बल्कि चार हैं जिन्हें वह सह नहीं सकती :<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />दास का राजा बन जाना,</para>
  <para style="q2" vid="PRO 30:22">मूर्ख का भरपेट भोजन करना,<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />घृणित स्‍त्री का ब्याहा जाना,</para>
  <para style="q2" vid="PRO 30:23">और दासी का अपनी स्वामिन का स्थान ले लेना।<verse eid="PRO 30:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />पृथ्वी पर चार जंतु ऐसे हैं जो छोटे हैं,</para>
  <para style="q2" vid="PRO 30:24">फिर भी अति बुद्धिमान हैं :<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />चींटियाँ तो बलवान प्राणी नहीं हैं, पर</para>
  <para style="q2" vid="PRO 30:25">वे ग्रीष्मकाल में अपनी भोजन-वस्तुएँ बटोरती हैं।<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />बिज्‍जू तो शक्‍तिशाली प्राणी नहीं होते,</para>
  <para style="q2" vid="PRO 30:26">फिर भी वे अपना घर चट्टानों में बनाते हैं।<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />टिड्डियों का कोई राजा नहीं होता,</para>
  <para style="q2" vid="PRO 30:27">फिर भी वे सब की सब दल बाँधकर चलती हैं।<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />छिपकली को हाथ से पकड़ा जा सकता है,</para>
  <para style="q2" vid="PRO 30:28">फिर भी वह राजभवनों में रहती है।<verse eid="PRO 30:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />तीन प्राणी ऐसे हैं जिनकी चाल मनोहर है,</para>
  <para style="q2" vid="PRO 30:29">बल्कि चार हैं जो चलते हुए मनोहर लगते हैं :<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />सिंह जो सब पशुओं में शक्‍तिशाली है</para>
  <para style="q2" vid="PRO 30:30">और किसी के सामने से पीछे नहीं हटता,<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />अकड़कर चलता हुआ मुरगा,</para>
  <para style="q2" vid="PRO 30:31">बकरा और अपनी सेना के आगे चलता हुआ राजा।<verse eid="PRO 30:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />यदि तूने अपनी बड़ाई करने की मूर्खता की हो,</para>
  <para style="q2" vid="PRO 30:32">या कोई षड्यंत्र रचा हो</para>
  <para style="q3" vid="PRO 30:32">तो अपने मुँह पर हाथ रख।<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />जैसे दूध को मथने से मक्खन,</para>
  <para style="q2" vid="PRO 30:33">और नाक को मरोड़ने से लहू निकलता है,</para>
  <para style="q1" vid="PRO 30:33">वैसे ही क्रोध को भड़काने से</para>
  <para style="q2" vid="PRO 30:33">झगड़ा उत्पन्‍न‍ होता है।<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s1">लमूएल के वचन</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 31:1" />लमूएल राजा के प्रभावशाली वचन,</para>
  <para style="q2" vid="PRO 31:1">जो उसकी माता ने उसे सिखाए।<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />हे मेरे पुत्र, मेरे ही गर्भ के पुत्र!</para>
  <para style="q2" vid="PRO 31:2">हे मेरी मन्‍न‍तों के पुत्र!</para>
  <para style="q3" vid="PRO 31:2">मैं तुझसे क्या कहूँ?<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />अपना पौरुष स्‍त्रियों पर न लुटाना,</para>
  <para style="q2" vid="PRO 31:3">और न अपना जीवन उन्हें देना</para>
  <para style="q3" vid="PRO 31:3">जो राजाओं का विनाश कर देती हैं।<verse eid="PRO 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />राजाओं को यह शोभा नहीं देता,</para>
  <para style="q2" vid="PRO 31:4">हे लमूएल, राजाओं को दाखमधु पीना,</para>
  <para style="q3" vid="PRO 31:4">और शासकों को मदिरा पीना शोभा नहीं देता;<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />ऐसा न हो कि वे पीकर व्यवस्था को भूल जाएँ</para>
  <para style="q2" vid="PRO 31:5">और किसी दुखियारे के अधिकार को छीन लें।<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />मदिरा उसे दो जो मरने पर है,</para>
  <para style="q2" vid="PRO 31:6">और दाखमधु उसे दो जिसका मन दुःखी है।<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />वह पीकर अपनी दरिद्रता भूल जाए</para>
  <para style="q2" vid="PRO 31:7">और अपने दुःख को फिर स्मरण न करे।<verse eid="PRO 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />गूँगों के लिए अपना मुँह खोल,</para>
  <para style="q2" vid="PRO 31:8">और सब असहाय लोगों का न्याय चुका।<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />अपना मुँह खोल! सच्‍चाई से न्याय कर!</para>
  <para style="q2" vid="PRO 31:9">और दीन-दरिद्रों के अधिकार की रक्षा कर।<verse eid="PRO 31:9" /></para>
  <para style="s1">गुणवान पत्‍नी</para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />गुणी पत्‍नी कौन पा सकता है?</para>
  <para style="q2" vid="PRO 31:10">उसका मूल्य तो रत्‍नों से भी बहुत अधिक है।<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />उसके पति के मन में उसके प्रति विश्‍वास है,</para>
  <para style="q2" vid="PRO 31:11">और उसे किसी उत्तम वस्तु की घटी नहीं होगी।<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />वह स्‍त्री अपने जीवन भर उससे बुरा नहीं,</para>
  <para style="q2" vid="PRO 31:12">बल्कि भला ही व्यवहार करती है।<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />वह ऊन और सन ढूँढ़ती है,</para>
  <para style="q2" vid="PRO 31:13">और प्रसन्‍न‍तापूर्वक अपने हाथों से काम करती है।<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />वह व्यापारी जहाज़ों के समान</para>
  <para style="q2" vid="PRO 31:14">अपनी भोजन-वस्तुएँ दूर-दूर से लाती है।<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />पौ फटने से पहले ही</para>
  <para style="q2" vid="PRO 31:15">वह जागकर अपने घर के लोगों को भोजन खिलाती है</para>
  <para style="q3" vid="PRO 31:15">और अपनी दासियों को काम बाँटती है।<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />वह सोच विचार करके किसी खेत को खरीद लेती है;</para>
  <para style="q2" vid="PRO 31:16">वह अपनी कमाई से दाख की बारी लगाती है।<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />वह काम करने के लिए अपनी कमर कसती है,</para>
  <para style="q2" vid="PRO 31:17">और अपनी बाँहों को दृढ़ बनाती है।<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />वह अपने व्यापार से होने वाले लाभ को भाँप लेती है,</para>
  <para style="q2" vid="PRO 31:18">और देर रात तक उसका दीपक जलता रहता है।<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />वह तकली चलाने के लिए अपना हाथ बढ़ाती है;</para>
  <para style="q2" vid="PRO 31:19">और उसके हाथ चरखे को पकड़े रहते हैं।<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />वह दीन लोगों के लिए अपने हाथ खोल देती है,</para>
  <para style="q2" vid="PRO 31:20">और दरिद्र की सहायता के लिए अपने हाथ बढ़ाती है।<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />वह अपने घराने के लिए हिमपात से नहीं डरती,</para>
  <para style="q2" vid="PRO 31:21">क्योंकि उसके घर के सब लोग पर्याप्‍त ऊनी वस्‍त्र पहनते हैं।<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />वह स्वयं चादरें बनाती है।</para>
  <para style="q2" vid="PRO 31:22">उसके वस्‍त्र मलमल के और बैंजनी रंग के होते हैं।<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />जब उसका पति नगर के फाटक पर देश के प्रधानों के साथ बैठता है,</para>
  <para style="q2" vid="PRO 31:23">तो वह सम्मान पाता है।<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />वह सन के वस्‍त्र बनाकर बेचती है,</para>
  <para style="q2" vid="PRO 31:24">और व्यापारियों तक कमरबंद पहुँचाती है।<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />वह बल और सम्मान से सुसज्‍जित है,</para>
  <para style="q2" vid="PRO 31:25">और हँसकर आने वाले दिन का सामना करती है।<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />उसके मुँह से बुद्धि की बात निकलती है,</para>
  <para style="q2" vid="PRO 31:26">और उसकी जीभ पर कृपा की शिक्षा रहती है।<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />वह अपनी गृहस्थी की सब बातों पर ध्यान देती है,</para>
  <para style="q2" vid="PRO 31:27">और परिश्रम किए बिना रोटी नहीं खाती।<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />उसके बच्‍चे उठकर उसे धन्य कहते हैं।</para>
  <para style="q2" vid="PRO 31:28">उसका पति भी यह कहकर उसकी प्रशंसा करता है :<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />“बहुत सी स्‍त्रियाँ भले कार्य करती हैं,</para>
  <para style="q2" vid="PRO 31:29">पर तू उन सब से श्रेष्‍‍ठ है।”<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />आकर्षण तो झूठा और सुंदरता व्यर्थ है,</para>
  <para style="q2" vid="PRO 31:30">परंतु जो स्‍त्री यहोवा का भय मानती है,</para>
  <para style="q3" vid="PRO 31:30">उसी की प्रशंसा होगी।<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />उसके परिश्रम का फल उसे दो,</para>
  <para style="q2" vid="PRO 31:31">और सब स्थानों में<note caller="+" style="f"><char style="fr" closed="false">31:31 </char><char style="ft" closed="false">अक्षरशः नगर-द्वारों में</char></note> उसके कार्यों से उसकी प्रशंसा हो।<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>