<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Noiri</book>
  <para style="h">गलाती</para>
  <para style="toc3">गलाती</para>
  <para style="toc2">गलाती</para>
  <para style="toc1">गलातीवालाहां प्रेशित पौलुसोअ पत्र</para>
  <para style="mt2">गलतीकरांस प्रेशित पौलाचे पत्र</para>
  <para style="mt1">गलातीवालाहां प्रेशित पौलुसोअ पत्र</para>
  <para style="imt">ओलखात</para>
  <para style="ip">“गलातीवालाहां प्रेशित पौलुसोअ पत्र” ओं पुस्तक प्रेशित पौलुसे लेख्योहो.<char style="xt"><ref loc="GAL 1:1">1:1</ref></char> ओं पत्र एक आंदास इ.स. 48-57 यां वोऱ्ह्योंम विसमेहें पौलुसे गलातीमेऱ्यीइ वारुज मंडड़ीइ कोअते लेख्योतो. तिया गालाहा गलातीवाले गलाती प्रांताआ रोमन इलाखाम रोतेते एहेलुहू आंदास होय. जाणकार पाक्को नाहां कोत सेकाअतो के, पौलुस ओं पत्र नेमको काअली जागे बोहीत लेख्यो, पोन इफिस नेताहां करिन्थ यां बेन होयरोम कोड्ली बी एकी जागे रोत तिये ओं पत्र लेख्योतो.</para>
  <para style="ip">पौलुसे ओं पत्र गलाती इलाखामेऱ्यीइ मंडड़ीइ यहुदी आन बिगर यहुदी बेनु जातीइ विश्वासी पाव्हीइलाहां लेख्योतो. खास कोइत खोटा शिक्शणोअ विरोद कोइलोअ काजे ओं पत्र लेख्योतो काहाके जे सिकाड़नारा ओता ते कोताते के एका विश्वासीही जुना नियमोअ बी पालन कोइलोअ गरज होय, जेहलोहो खतनाआ कोइलोअ आन खाअलोअ या बाप्तिम. एक एहेलुहू यहुदी मतवादी माहुंउं टोलु ओतु, जो बिगर यहुदी विश्वासी माहुंहूं यहुद्यांआं तो जुनू नियम पालन कोए तेहें जबरजस्ती कोअतेते. आन तें माअहें पौलुसोअ प्रेशितपणोपोअ बी प्रश्न उबो कोअतेते. पौलुस तियां माहुंहूं सोताआ साक्शी आपित कोइत बोराबर उत्तर आपेहे, <char style="xt"><ref loc="GAL 1:11-2:14">1:11—2:14</ref></char> आन तारणोअ काजे फक्त ईसु ख्रिस्तापोअ विश्वास कोअहूं पोड़ेहे कोत हाजी बातमी फोड़ कोइत देखाड़ीत तियांआं विसार खुड़ेहे.<char style="xt"><ref loc="GAL 2:16">2:16</ref> </char>आन कोहे के, “तारण देवोअ मेरवानीइं फल होय, ओं मोनवीइ कारागिरी वाईं नाहां जोड़तो.”</para>
  <para style="iot">रुप-रेशा</para>
  <para style="io1">1. पौलुस पत्राआ सुरुवातीम गलातियाआ आखी मंडड़ीही सलाम कोअहे. <char style="ior"><ref loc="GAL 1:1-5">1:1-5</ref></char></para>
  <para style="io1">2. तिहीं रोत पौलुस सोताआ परिस्थिती कोत देखाड़ेहे तो तियाआ सिकाड़ीइलोअ आधिकारोअ काजे आन तो कायदाआ परमाणे जिवीइलोअ कोशित कोअहे खोरु, पोन तियाहा नाहां बोणती. <char style="ior"><ref loc="GAL 1:6-2:21">1:6—2:21</ref> </char></para>
  <para style="io1">3. आगाड़ी तो कायदाआ साल केहेलिही आन तारणोअ काजे देवोअ मेरवानीइं साल केहेलिही तों कोत आपेहे. <char style="ior"><ref loc="GAL 3-4">3—4</ref> </char></para>
  <para style="io1">4. तिहींइंं फासाड़ी तो हाजो विश्वासी जिवन केहें कोइत जिवीइलोअ तिहींइंं बाप्तिम थोड़ीक सुसना आपेहे. <char style="ior"><ref loc="GAL 5:1-6:10">5:1—6:10</ref> </char></para>
  <para style="io1">5. पौलुस सलाम कोअतुज तियाआ पत्र लेखीइलोअ बंद कोअहे आन आखरीइ विनंती कोइत ओर मिके तेहें कोहे के देव उपरसोल्या नियम पालनोअ देखावा रोत जाअखु नविल बोदलाअला जिवनोहो जाअखो महत्व आपेहे ओं ओर मिकुहूं जोवे. <char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref> </char></para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="s">सलाम</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />जो नाहां माअहूं तरफ से आन नाहां माअहूं वाअहीं, पोन ईसु ख्रिस्त आन देव बाह्हा वाअहीं, जिये तियाहा मोल्याम रोत जिवाड़्यू, तिया प्रेशित पौलुसोअ तरफ से- <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />आन आखा पाव्हीइलाआ तरफ रोत जें माअरी होय, गलातीइ आखी मंडड़ीही सलाम:<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />आपाअ देव आब्हू आन प्रभु ईसु ख्रिस्त नेहें तुमुहूं मेरवानी आन होक आपता रोये.<verse eid="GAL 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4" />आपाआ देव आब्हाआ इश्शा वाअहीं या खाराब जमानाम रोत आपाआ सुटका कोइलोअ काजे प्रभु ईसु ख्रिस्ते आपाआ पापोअ उस्ती सोताआ जीव आपी देदू. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />तियाआ स्तुती हादाजलम ओवती रोये! आमेन.<verse eid="GAL 1:5" /></para>
  <para style="s">बिहीरी कोड्लीज हाजी बातमी कायनाहां</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />आंय बोगलाअयुहू के जिये तुमुहूं ख्रिस्ताआ मेरवानीमेहें हाद्ये, यामेहें रोत एते वेगे मुउड़ात तुमू बिहीरीज हाजी बातमीइ वोल फिरे वोल्ये. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />खोरो मोन्ज्ये, इंहीं बिहीरी हाजी बातमी होय बी नाहां: पोन गोठ ए होय के, केतेहे माअहें एहेलेहे होय बी, जे तुमुहूं काबरावी देतेहे, आन ख्रिस्ताआ हाजी बातमी बिगाड़ीलाआ कोशित कोअतेहे. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />पोन जर आमू, नेताहां होरगाम रोत एखु देवदुत बी जे हाजी बातमी आमू तुमुहूं कोत आप्यीही, ते सोड़ीत बिहीरी हाजी बातमी तुमुहूं कोये, ताहां तियाहा हाराप लागुहूं जोवे. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />जेहें कोइत आमू पेलूज कोत सुकाहा, तेहेंज कोइत आंय ओमे फाशुउ कोहो, के तियी हाजी बातमीहीं सोड़ीत, जियीही तुमू स्विकार कोअयिही, जर एखु बिहीरी हाजी बातमी कोत आपे, तियाहा हाराप लागुहूं जोवे.<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />ओमे आंय माअहोंहों मानाड़ीलोअ कोशित कोअहो के देवोहो? केहें आंय माअहोंहों खुस कोइलाआ कोशित कोअहो के? जर आंय ओमे जाआं माअहोंहों खुस कोअतू रोतु, ताहां ख्रिस्ताआ सेवक ने रोतु.<verse eid="GAL 1:10" /></para>
  <para style="s">पौलुस केहें कोइत प्रेशित बोण्यु</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />माआं पाव्हीइला, आंय तुमुहूं कोत देहो के जे हाजी बातमी आंय कोत आप्यी, ते माअहोंअ बोणावल्यी कायनाहां. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />काहाके ते माहूं एखा माअहोंअ तरफ से नाहां जोड़्यी, के नाहां कोडे सिकाड़्यी; पोन ईसु ख्रिस्ते आपल्या दर्शनोवाईं जोड़्यीही.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />तुमू उनात सुकेहे के माआं यहुदी मत केहेलोह ओतो. आंय देवोअ मंडड़ीही जाअखीलुहू तारास कोआड़तुतो आन आरवीत टाकतुतो.<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">प्रेशित 8:3; 22:4,5; 26:9-11</char></note> <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />आन आंय डायहांआं रुढ़ी लेत सालीइलोम जास्ती सेकलात ओतु, तिहीं वाईं माआं ताड़ेए जाअखीला जोओं रोत आंय आगाड़ी जातु रोयुतो. <verse eid="GAL 1:14" /><verse number="15" style="v" sid="GAL 1:15" />पोन जिये देवे आयहीइ डेडीम रोतुज माहूं निवड़्यू आन तियाआ मेरवानी वाईं हादीत लेदू, <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />जाहां तियाआ इश्शा ओवी के मावाईं सोताआ बेटाह्हाहा प्रगट कोइत सेके, मोन्ज्ये तियाआ हाजी बातमी बिगर यहुदी माअहूंम परसार कोइत सेको, ताहां मी बिहीरा कोडाहा ने फुशो, <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />आन जे मा रोत पेल प्रेशित ओता, तियांआं जागे येरुसालेमोम ने गोयू, पोन ताबुड़ अरब देसोम जातू रोयू आन फाशू दमिश्कोम वापिस आवतू रोयू. <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />तिहीं रोत तीन वोऱ्ह्योंअ फासाड़ी आंय केफाहा मिलीइलो काजे येरुसालेमोम गोयू आन पंदरा दिही जाआं रोयू. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />पोन प्रभुउ पायहो याकोबोहो सोड़ीत बिहीरो कोडो प्रेशित ने मिल्यो.<verse eid="GAL 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20" />जों आंय लेखोहो तों खोरो होय, आन तों देवोहो मुंदू होय, आंय नाहां ठोगतु.<verse eid="GAL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21" />तिहीं रोत आंय सिरिया आन किलिकियाअ प्रान्तामेहें आयू. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />तेहेलाम माहूं ख्रिस्ता मेऱ्याआ यहुदीयाआ मंडड़ीवाला केदिहींज नाहां देख्यू; <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />पोन एतीज गोठ उनाअया कोअतेते के, “जो आपुहूं पेल तारास देतुतो, तो बी ओमे जिया विश्वासोहो पेल आरवीत टाकीइलोअ कोशित कोअतुतो, तियाज विश्वासोअ हाजी बातमी होंबलाड़ेहे!” <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />आन तें माआं बाप्तिमेहें देवोअ स्तुती कोअतेते.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">बिहीरा प्रेशितों रोत जाअखी पौलुसोअ मान्यता</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />सुहूद वोर्ह्योंअ फाटी आंय बरनबासोअरी फाशुउ येरुसालेमोमेहें गोयू, आन तितुसोह बी आरी लेत गोयू. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />माअ जाअलोअ देवोअ दर्शनोवाईं ओवो; आन जे हाजी बातमी आंय बिगर यहुदीमेहें परसार कोअहो, ते आंय तियांहां कोतापी देदी, पोन जे पुढारी जेहें गोणाअताते तियांहां एताज एखलामेहें कोताप्यी, काहाके माआं पेल्लीइ आन ओमेएं मेहेंनत वाया ने जाअहूं जोवे. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />पोन तितुसोह बी जो माअरी ओतू, आन जो युनानी होय, तियापोअ खतना कोइलोअ काजे दाबाव ने टाक्यु. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />ओं प्रश्न तियां वाईं उबो ओवो जे मोनेज आवित विश्वासी ओवीइलोअ ढोंग कोअताते, काहाके ख्रिस्त ईसुमेहें जोड़ल्यी सुटकाहा गुलाम कोइलोअ तियांआं इश्शा ओती. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />एक घेड़ी जाआं तियांआं गोठ मानिइलोअ आमू मान्य ने कोअयो, काहाके खोरी हाजी बातमी तुमामेहें टिकीत रोअहूं जोवे.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />फाशाआ जे माटी पुढारी कोत गोणाअताते, ते जे किबी गोणाअताय तियांअरी माआं कायने लेणो-देणो, काहाके देव कोडाआ भेदभाव नाहां कोअतू. पोन माहूं तियांप रोत कीज नोवी गोठ ने जोड़्यी. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />पोन याआ उलट जेहेलाम तियां देख्यो के, जेहलोहो खतना कोअल्या माअहोंअ काजे हाजी बातमी कोअलोअ काम पेत्राहा होपी देदो, तेहलोज खतना ने ओवला माअहोंअ कोअते हाजी बातमी कोअलाअ काम माहूं होप्योहो. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />काहाके जिये देवे पेत्रा वाईं यहुदी माअहूंमेहें तियाआ सेक्ती वाईं प्रेशितपणोअ कामे कोआड़्ये, तियेज माहूं बी बिगर यहुदी माअहूंमेहें प्रेशितपणोअ कामे कोआड़्ये. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />आन जेहेलाम याकोब, केफा, आन योहान जे मंडड़ीइ पुढारी कोत गोणाअताते, तियां जाइंत लेदो के, माहूं ओं खास काम देवे होप्योहो; ताहां तियां माहूं आन बरनबासोहो संगतीइ आथ मिलाड़्यु, एताआ काजे के आमू बिगर यहुदीइ जागे जात सेको आन ते खतना ओवला माअहोंअ जागे जात सेके; <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />तियां एतोज कोयो के, आपू गरब्योंअ कालजी लेअहूं जोवे. आन आंय या कामोहों कोइलोअ काजे सोताहा बी कोशित कोअतुतो.<verse eid="GAL 2:10" /></para>
  <para style="s">अंताकियाम पौलुस पेत्राआ विरोध कोअत्लू</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />पोन जाहां केफा अंताकियाम आयू, ताहां आंय याअ सोबासोबी लागू काहाके तो खोरीज सुकूतो. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />काहाके याकोबोअहीं रोत थोड़ेक माअहें आविइलाआ पेल तो बिगर यहुद्यांअरी बोहीत खाया कोअतुतो, पोन जेहेलाम तें आये, तेहेलाम खतनावाला माअहोंहों देखीत फाटी होरकीत गोयू, आन एक तोड़्युज जानु वोल्यू. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />तियाअरी थोड़ेक यहुदी माअहें बी ढोंगड़ा कोए वोल्ये, तेतोज नाहां पोन बरनबास जाआं तियांअरी ढोंगड़ाम पोड़ीत गोयू. <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />पोन मी तियांहां देख्या के ए हाजी बातमीइं खोरी वाटेपोअ बोराबर नाहां सालता, ताहां आंय केफाहा कोयो, “तू यहुदी ओत बी बिगर यहुदीइ होस सालेहे, यहुदीइ होस नाहां सालतू, ताहां तू बिगर यहुद्याहां यहुदीइ होस साले तेहें काहा कोहे?”<verse eid="GAL 2:14" /></para>
  <para style="s">विश्वासो वाईं धर्मी ठरीइलो</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />आमू ते तुर्‍याआज यहुदी होय, तियां बिगर यहुदी पाप्योंअ होस नाहां. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />तेबी माहुंउं कायदाआ परमाणे काम कोइलो वाअहीं नाहां, पोन ईसु ख्रिस्तापोअ विश्वास कोइला वाअहीं धर्मी ठरेहे, ओं ओलखीत आमू सोताहा बी ख्रिस्त ईसुपोअ विश्वास कोअयू; एताआ काजे के कायदा पालनो वाईं नाहां, पोन ख्रिस्तापोअ विश्वास कोइलो वाईं आमू धर्मी ठरीत सेको; काहाके कायदा पालनो वाईं कोड्लोज माहुंउं धर्मी नाहां ठरनारो. <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />ताहां, जें आपू ख्रिस्तामेहें धर्मी ठरुहूं होदतेहे, पोन आपूज पापी निहींये, ताहां का ख्रिस्त पापोअ सेवक होय के? बिलकुल बी नाहां! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />काहाके जो किबी आंय वेसड़ी देदो आन वापिस फाशुउ तियाहा बोणावतुय, तेहें कोइत ताहां आंय सोताहा गुनाम तोआहो. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />काहाके आंय ते कायदा वाअहीं कायदाआ काजे ख्रिस्ताअरी मोइत गोयू, तो एताआ वाखरी के आंय देवोअ काजे जिवीत सेको. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />“आंय ख्रिस्ताअरी क्रुसखांबोपोअ सोढ़वाअयुहू, ओमें आंय जिवतु नाहां रोयू, पोन ख्रिस्त मामेहें जिवतु होय, ओमे आंय जो शरीरोम जिवतु होय, तो देवोअ बेटाह्हापोर्‍याआ विश्वासो वाईं जिवतु होये, जिये मापोअ मेर कोइत सोताआ जिवन माआं काजे आपी देदो.” <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />आंय देवोअ मेरवानीहीं नाहां नाकारतू, पोन जर एखो कायदा वाईं धर्मी ठरतोय, ताहां याआ अर्थ होय ख्रिस्ताआ मोइलोअ वाया ओवो!<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">कायदु नेत विश्वास</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />ए गलातीवाला फोगा माट्यों, तुमुहूं कोडे पोटावीत लेदाहा? क्रुस खांबोपोअ टांगल्यू ईसु ख्रिस्त ताम तुमाआं डोआअ सामनेज जेहें ओतू. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />आंय तुमाप रोत एतोज जाअहूं कोअहो के तुमुहूं देवोअ आत्मा कांय कायदा पालनो वाअहीं जोड़्यू के विश्वासोअ बातमी वाअहीं जोड़्यू? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />तुमू का एता बी फोगाज होय के! देवोअ आत्मा वाअहीं सुरुवात कोइत ओमे तुमाआं दोमोपोअ पुरो कोअहूं होदताहा? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />ताहां कांय तुमू एतो एतो दुख वायेज भोग्य के? हुदाअलीज वाया नाहां. <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />जो तुमुहूं देवोअ आत्मा आपेहे आन तुमामेहें समत्कारोअ कामे कोअहे, तो कांय कायदा पालनो वाअहीं के हाजी बातमी उनात विश्वास कोइला वाअहीं एहलोहो कोअहे?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />अब्राहामोअ आनुभाव पाला, वसन कोहे, “तिये देवोपोअ विश्वास मिक्यू, आन यीज गोठी वाईं देवे तियाहा धर्मी गोण्यू.” <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />ताहां ओं जाईंत ल्या के, जें विश्वास कोअतेहे तेंज खोरे अब्राहामोअ कुटूंबाआ माअहें होय. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />आन देव बिगर यहुद्याहां विश्वासो वाअहीं धर्मी ठरवे ओं जांअतीज वसनोवाईं पेलुज रोत अब्राहामोहो ए हाजी बातमी जोड़्यी के, “तावाअहीं आक्खा माअहुंहूं देव आशिर्वाद आपे.” <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />तिहींज वाईं ताम विश्वास कोअनाराहां अब्राहामोअरी आशिर्वाद जोड़त्लू.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />ताहरेए जेते बी माअहें कायदा पालनोपोअ भरिवसू कोअतेहें, तें आखे हारापोम बांदाअले होय, काहाके लेख्यो एहेलोहो होय, “जो कोडो कायदाम लेखल्यी आखी गोठीइ पालन ने कोए तों देवोअ हारापोअ निसे होये.” <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />ताहां, ओमे ए गोठ खुल्ली होय के, कायदा वाअहीं कोड्लोज माहुंउं धर्मी नाहां ठरतों, काहाके वसन कोहे के, “धर्मी माहुंउं विश्वासो वाईं जिवतो रोये.” <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />पोन कायदाअरी विश्वासोअ किज सबंध नाहां आवतो; काहाके पवित्रशास्राम लेख्योहो, “जों कायदाम लेखल्यी गोठी मानित साले, तों जिवतो रोये.”<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LEV 18:5">लेवी 18:5</ref></char></note><verse eid="GAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13" />आपाआ उस्ती ख्रिस्त हारापवालू बोण्यू, तिये आपुहूं कायदाम लेखल्या हारापोम रोत किंमत पोइत सोड़व्ये, काहाके एहेलोह लेख्योहो, “जिया कोडाहा लाकड़ूपोअ टांगी देतेहे, तों देवोअ हारापल्यो होये.”<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="DEU 21:23">कायदा 21:23</ref></char></note> <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />ओं एताआ काजेज ओवो के, अब्राहामोअ आशिर्वाद ख्रिस्त ईसुमेहें बिगर यहुद्याआं जागे जाआं पोतुहूं जोवे, आन आपुहूं विश्वासो वाअहीं तो आत्मा जोड़ुहूं जोवे, जियाआ बाप्तिम देवे आथवसन आप्योतो.<verse eid="GAL 3:14" /></para>
  <para style="s">कायदु आन आथवसन</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />माआं पाव्हीइला, आंय तुमुहूं सादो उदाहरण वापरीत कोहो: जाहां बेन जोओंअ विसमेहें ठरल्यो वसन पाक्को ओत जाहे, ताहां तियाहा नाहां कोडो रद्द कोइत सेकतो के नाहां तियाम काविहीं वादाड़ीत सेकतो. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />ताहां देवे अब्राहामोहो आन तियाआ पोऱ्याहा आथवसने आप्ये. यी जागेहे वसन “पोऱ्याहां” कोत जाअखा जोओंअ उल्लेख नाहां कोअतो, पोन एकाआ बाप्तिम कोहे, “पोऱ्याहा” आन तों ख्रिस्ताआ बाप्तिम होय. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />पोन माआं कोअलाआ उद्देश ओ होय के, जों आथवसन देवे पेलुज रोत पाक्को कोअयोतो, तों आथवसन रद्द ओत जाय तेहें कोत शार होवेन तीस वोर्‍ह्योंअ फासाड़ी कायदु आवित तियाहा नाहां टालित सेकतु. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />काहाके वारसू जर कायदा वाअहीं जोड़तू, ताहां आथवसनोअ गरज ने ओती, पोन देवे तो वारसू मेरवानी कोइत अब्राहामोहो आथवसनो वाईं आप्यू.<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />ताहां कायदु काहा आप्यू? तो सुकी देखाड़ीइलोअ काजे सेलवाआ आप्यू, आन जियी पारवाड़ीइ बाप्तिम आथवसन आप्यो, ते पारवाड़ आवे ताअहूं जाआं तो कायदु रोअहूं जोवे, आन तो कायदु देवदुतों वाईं एका वोग्याआ आथे नेमाअयू. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />वोग्यु ते एकाआज नाहां रोतू, पोन देव एकुज होय.<verse eid="GAL 3:20" /></para>
  <para style="s">कायदाआ उद्देश</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />ताहरुउ कायदु कांय देवोअ आथवसनोअ विरुद्दामेहें होय के? बिलकुल नाहां! काहाके जर जिवन आपे एहेलुहू कायदु जोड़तू, ताहां माहुंउं कायदा पालनो वाईं धर्मी बोणतो. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />पोन वसन कोहे के आखे माहें पापोअ सेक्तीम बांदाइत रोयेहे; तिहीं वाईं वारसा आपीइलोअ तों आथवसन विश्वास कोअनाराआ काजे ईसु ख्रिस्तापोअ विश्वास कोइलो वाईं पुरो ओवुहूं जोवे.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />पोन विश्वास आविइलाअ पेल, तो विश्वास आवे ताअहूं जाआं आपाआ देखबाल कायदाआ बंधनोम ओवतीते. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />तिहींज वाईं आपू ख्रिस्ताआ जागे जाआं पोतुहूं जोवे कोत कायदु आपाआ मास्तर बोण्यू, काहाके आपू विश्वासो वाअहीं धर्मी ठरुहूं जोवे. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />पोन ओमे विश्वास आवित लागू, तिहीं रोत आपू मास्तरोअ ताबाम कायनाहां.<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />काहाके तुमू आखे ख्रिस्त ईसुपोऱ्याआ विश्वासोअ वाअहीं देवोअ पोऱ्ये होये. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />आन तुमाम जेते जोएं ख्रिस्ताआ नावम बाप्तिस्मा लेदोहो, तियां ख्रिस्ताहा फांगीत लेदूहू. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />ओमे रोत नाहां कोडो यहुदी के बिगर यहुदी रोयो, नाहां कोडो बांदाअलो के सुटलो, नाहां माटी के नाहां बोईं, काहाके ख्रिस्त ईसुमेहें तुमू आखे एक होय. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />आन जर तुमू ख्रिस्ताआ होय, ताहां अब्राहामोअ पारवाड़ीइ आन आथवसनोअ परमाणे वारिस बी होय.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />आंय ओमे कोहो के, वारिस जाअहूं जाआं हानू पोर्‍यू होय, भले तो आखी वस्तुउ मालिख बी होय, तेबी तियामेहें आन पावरोमेहें किज फरक कायनाहां. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />पोन आब्हाआ ठरवीइल्यी मुदतेपोअ जाआं तो मास्तर आन पावरोअ ताबाम रोहे. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />तेहेंज कोइत आपू बी जेहेलाम हाने ओते, तेहेलाम दुन्याहां सालाड़नारा आत्माआं ताबाम बांदात रोयेते. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />पोन जेहेलाम वेल पुरी ओवी, तेहेलाम देवे तियाआ बेटाह्हाहा मोकल्यू. तिये एकी बायीइ पेटे जल्म लेदो आन यहुदी कायदाआ पुरमाणे जिवन जिवयू. <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />काहाके जें कायदाआ बंधनोम जिवतेहे तियांहां तो कायदाआ बंधनोम रोत सोड़वीत सेके, मोन्ज्ये आपुहूं देवोअ पोऱ्ये बोणिइलोअ आधिकार जोड़ुहूं जोवे.<verse eid="GAL 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6" />आन तुमू पोऱ्ये होय कोत देवे, “बा, ए बा” कोत हाद कोइलोअ तियाआ बेटाह्हाआ आत्मा आपाआ दिलोमेहें मोकल्युहू. <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />तिहीं वाईं ओमे तु पावर नाहां, पोन पोर्‍यू होय; आन पोर्‍यू होय, ताहां देवो वाअहीं वारिस बी ओवू.<verse eid="GAL 4:7" /></para>
  <para style="s">गलातीवालाआं बाप्तिम पौलुसोअ कालजी</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />पेल ताम तुमू देवोहो ने ओलखीइतेते, आन तिहीं वाईं जे सोभावो वाअहीं देव नाहां एहेलाआं सेवा साकरी कोअतेते. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />पोन ओमे जें तुमू देवोहो ओलखीइतेहें, आंय ते कोहो, देवे तुमुहूं ओलख्येहे, ताहां तियी रुढ़ीखुड़्यी विणकाम्यी वेगीइ-शिक्शणोअ वोल काहा जातेहे? आन काहा तुमू फाशेए तिहींम बांदाअहूं होदतेहे? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />तुमू दिही, मोयना, ठरिवल्यी वेल आन वोऱ्ह्योंहों मानतेहें. <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />तुमाआं कोअते कोअल्यी माआं मेहेंनत वाया जाय एहेलिही माहूं ते तुमाआं बाप्तिम सिंता लागेहे!<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />माआं पाव्हीइला, आंय तुमुहूं रावणी कोअहो, तुमू माआं होस बोणा, काहाके आंय बी तुमाआं होस बोण्युतो. तुमू माआं किज नाहां बिगाड़्यो. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />पोन तुमुहूं मुंदूज होये के, पेल-पेल आंय तुमुहूं हाजी बातमी कोताप्यी काहाके तेहेलाम आंय बिमार ओतू. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />आन माआं शारीरिक कमजोरीइ वोजेसे तुमाआं परिक्शा ओवत्ली तेहेलाम तुमू माआं सीस नाहां कोअयी; पोन माहूं देवदुत आन ख्रिस्ताआ होस स्विकार कोअयू. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />तेहेलाम तुमू जास्ती खुस ओते आन ओमे खोते? आंय सोताहा साक्शी होय, के जर ओत सेकतो, ताहां तुमू सोताआ डोआ बी माहूं काडीत आपी देते. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />ताहां का आंय खोरो गोग्यू कोत तुमाआं दुस्मोन ओवू के?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />ते तुमुहूं दोस्ती बोणावुहूं होदताहा, पोन हाजाआ काजे नाहां; तुमू तियांअरी दोस्ती कोइत लेअहूं जोवे काजे ते तुमुहूं मा रोत नारा कोअहूं होदताहा. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />पोन ओमे, ओं बी हाजोज होय के, जेहेलाम आंय तुमाअरी रोहो तेहेलाम एतोज नाहां, पोन हाजी गोठीइ काजे कायम दोस्ती बोणाविलाआ कोशित कोअहूं जोवे. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />ए माआं पोर्‍यां, जाअहूं जाआं तुमामेहें ख्रिस्ताआ रुप ने बोणे, ताअहूं जाआं आंय तुमाआं काजे फाशुउ पोटावाली बायीइ होसर्‍यीइ पिड़ा वेठोहो. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />इश्शा ते ओवेहे के ओमे तुमाआं जागे आवित कोइत बिहीरीज बाती वाअहीं गोगो, काहाके तुमाआं बाप्तिमेहें माहूं जास्ती फिकर होय!<verse eid="GAL 4:20" /></para>
  <para style="s">सारा आन हागारोअ उदाहरण</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />तुमू जे कायदाआ ताबाम रोअलाअ ईतवीइतेहे, पोन माहूं कोवा, कायदु की कोहे तों तुमू नाहां उनाअते के? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />तिहीं लेख्योहो के, अब्राहामोओं बेन पोर्‍या ओवा; एक कांय साकऱ्यीइ आन एक खाजगी बोईंइ. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />पोन जो साकऱ्यीइ पेटे उबज्यु, तो शरीर सोभावो वाईं उबज्यु; आन जो तियाआ लाडी वाअहीं ओवू, तो आथवसनोअ परमाणे उबज्यु. <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />यीं गोठीही काईंवाईं समजीत सेकतेहे: ए बेनु बोईं बेन करार समजीत ल्या. एक ताम सिनाय डोगोअ जिहीं गुलाम उब्जीइतेहे; आन ते हाजिरा होय. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />आन हाजिरा अरबोअ सिनाय डोगोअ होस समजीत ल्या, आन ओमेएं येरुसालेम तियाआ सारकोहो होय, काहाके तों आन तियाआ पोर्‍येनेहें गुलामीमेहेंज होय. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />पोन उफाअटो येरुसालेम मोकलो होय, आन ते आपाआ याह्ही होय. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />काहाके वसनोम लेख्योहो,</para>
  <para style="q1" vid="GAL 4:27">“ए वांज्यी बाय, तू पोऱ्ये नाहां जोणती तेबी खुसीम रो;</para>
  <para style="q2" vid="GAL 4:27">ताहूं वेणे नाहां आवते, तू आखे काहालेज जय जयकार कोअ;</para>
  <para style="q1" vid="GAL 4:27">काहाके माट्योवाली बोईंइ पोर्‍यां रोत</para>
  <para style="q2" vid="GAL 4:27">सोड़ली बोईंइ पोर्‍ये जाअखे होय.”<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />माआं पाव्हीइला, ओमे आपू इसहाकोअ होस आथवसनोअ पोर्‍ये होय. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />तियी वेले जेहें कोइत शरीरोअ अनुसार उब्जीइल्ये पोऱ्ये आत्माआं अनुसार उब्जीइल्या पोऱ्याहा तारास देतुतो, तेहेंज कोइत ओमे बी ओवेहे. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />पोन वसन कि कोहें? “साकऱ्यीही आन तियीइ पोर्‍याहानेहें काडी दे, काहाके साकऱ्यीइ पोर्‍यू खाजगी बोईंइं पोर्‍याअरी वारीस ने ओवनारु.” <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />तियाहा कोत, पाव्हीइला, आपू साकऱ्यीइ पोऱ्ये नाहां, पोन खाजगी बोईंइ पोऱ्ये होये.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">सुटका टिकाड़ीत मिका</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />मोकलायीइ कोअते ख्रिस्ते आपुहूं सुटका आप्यीही; तियाहा काजे इंहींमेहें टिकीत रोवा, आन गुलामीइ जुहरोम फाशेए मा जुपाअहा.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />पाला! आंय पौलुस तुमुहूं कोहो के जर खतना कोआड़हा, ताहां ख्रिस्ताप रोत तुमुहूं किज ने जोड़नारो. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />फाशोअ बी आंय हारेक खतना कोअनाराहा वारुहूं कोत देहो के, तियाहा पुरु कायदु मानुहूं पोड़े. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />तुमू जे कायदा वाअहीं धर्मी ठरिइलोअ इतवीइतेहे, तुमू ख्रिस्ता रोत अलग आन मेरवानी रोत दुर गोयेहे. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />काहाके आपाआ विश्वासोवाईं काम कोअनारा देवोअ आत्माआं सेक्ती वाईं आमू आशा कोइत सतीपणोअ वाट जोवताहा. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />ख्रिस्ता ईसुमेहें खतना आन बिगर खतना किज कामोअ कायनाहां, पोन विश्वास कोइलोअ कामोअ होय, जो मेरेवाईं काम कोअहे.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />तुमू जास्ती हाजे काम कोअतेते, पोन ओमे सत्याहा मा मानहां एहें कोत तुमुहूं कोडे रुकी देदे? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />तुमाआं हादनारा देवोअ तरफ से एहेलिही हिकवोण कायनाहां. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />वाहींज एतोहो खमीर पुरा केलवीइल्या लोटोहो फुगाड़ी देहे. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />तुमाआं बाप्तिम प्रभु मेहें माहूं भरिवसू होय, कि तुमू बिहीरु किज विसार ने कोअहा, पोन जों तुमुहूं घोटाड़ाम पाड़ेहे तों कोडो बी ओय, तियाहा देव डोंड आपेज.<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />ताहां पाव्हीइला, आंय जर ओमे जाआं खतनाआ परसार कोअतुये, ताहां ओमे जाआं मापोअ सतावणी काहा ओवेहे? तेहें कोइत रोतो, ताहां ख्रिस्ताआ क्रुस खांबोअ अड़सनुज निहींत जाती. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />जे तुमुहूं घोटाड़ाम पाड़ताहा, तेज सोताहा इजड़ाआ होस ओत जाता, तों जाआं हाजो आवतो.<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />माआं पाव्हीइला, तुमुहूं मोकले ओवे तेहें काजे हाद्येहे; पोन ते बी यी मोकलायीही शारीरिक लालस पुरी कोइलोअ सान्सो मा आपहा, पोन मेरे वाअहीं एकान एकाआ सेवा कोआ. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />काहाके आखा कायदा या एकाज नियमोम पुरा ओत जाताहा: “तू ताआ जागेवालापोअ सोताआ होस मेर कोअ.” <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />पोन जर तुमू एकान बिहीराअरी सुंदाअहा आन टेकाअहा, ताहां हेएजा! एखाआ सत्यानाश मा कोई देहा.<verse eid="GAL 5:15" /></para>
  <para style="s">पवित्र आत्मा आन मोनवी सोभाव</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />पोन आंय कोहो, आत्मा वाअहीं सालहा, ताहां तुमू शरीरोअ लालस नेज पुरी कोइत सेकहा. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />काहाके शरीर आत्माआं विरुद्दाम आन आत्मा शरीरोअ विरुद्दाम लालस कोअहे आन एं बेनू एकान एकाआ विरुद्दाम होये. तिहींज वाईं जों तुमू पोटेहे तों नाहां कोइत सेकाअतो. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />आन जर तुमुहूं आत्मा सालाड़तुय, ताहां तुमू कायदाआ बांदाअले कायनाहां.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />शरीरोअ कामे ताम खुल्ले देखाअतेहें, मोन्ज्ये सिनालो, सोगदाय, लुसड़ाय; <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />मुर्तीपुजा, मंतर-तंतर, दुस्मोनी, भान्गड़, खोद्राय, खोताइलोअ, विरोध कोइलोअ, फाटाफुट कोइलोअ, टोला पाड़ीइलोअ, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />टुड्राय, पिदाड़, नशामेहें नासीइलोअ आन यांआं होसऱ्येए वारुज कामे होय, यांआं बाप्तिमेहें आंय तुमुहूं पेलुज कोत सुकुहू आन ओमे बी कोत देहो के, एहेलेहे कामे कोअनारे देवोअ राज्याआ वारीस नाहां ओवनारे. <verse eid="GAL 5:21" /><verse number="22" style="v" sid="GAL 5:22" />पोन आत्माआं फल मेर, खुसी, होक, धिर, मेरवानी, भलाय, विश्वास, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />नम्रता,आन संयम होय; यां कामोअ विरुद्धामेहें कोड्लूज नियम कायनाहां. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />आन जें माहें ख्रिस्त ईसुउ होय, तियां शरीर सोभावोहो लोभ लालसनेहें आरीज क्रुस खांबोपोअ लटकाड़ी देदोहो. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />जर आपू आत्मा वाअहीं जिवते होय, ताहां आत्मा वाईं सालुहूं बी जोवे. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />आपू वोडाऱ्ये बोणीत एकान बिहीराहा ने खिजवुहूं जोवे आन आद्राय बी ने कोअहूं जोवे.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">एकान बिहीराहा मदत कोआ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />माआं पाव्हीइला, जर एखो माहुंउं गुनाम तोआयो, ताहां तुमू जें आत्मिक होये, नम्रता वाईं एहेला माहुंहूं सांबाला, आन तुमू सोताहा बी गुनाम ने पोड़ुहूं जोवे कोत जाबालीत रोवा. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />तुमू एकान एकाआ वोजू उसला, मोन्ज्ये एहें कोइत तुमू ख्रिस्ताआ नियम पुरु कोअहा. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />काहाके जर एखु किज कायनाहां तेबी सोताहा आंय बी की तेबी होंव कोत सोमजेहे, ताहां तो सोताहा दोका खाहे. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />तिहीं वाईं हारेक जोओं जिवज्योअ काम फारकीत लेअहूं जोवे, आन ताहांज बिहीराआ नाहां, पोन सोताआ बाप्तिमेहें तियाहा वोडाय कोइलोअ सान्सो जोड़े. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />काहाके हारेक जोओंहों सोताआ वोजू आखलुहूं पोड़े.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />जियाहा वसनोअ शिक्शण जोड़ेहे, तों तियाआ आखी हाजी वस्तुमेहें वसन सिकाड़नाराहा बी सामिल कोअहूं जोवे. <verse eid="GAL 6:6" /><verse number="7" style="v" sid="GAL 6:7" />दोकू मा खाहा; देवोहो कोडोज फोगू नाहां बोणावीत सेकतो. काहाके, माहुंउं जों किबी ओएहे तोंज वाडेहे. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />जों सोताआ शरीरोअ काजे ओएहे, तों तियाआ शरीरो वाईं मोतोअ फल वाडीत टोलू कोए; आन जों आत्माआं काजे ओएहे, तों आत्मा वाईं हादाफल्याआ जिवनोअ फल वाडीत टोलू कोए. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />आपू हाजे कामे कोइलाम उजगाय ने कोअहूं जोवे, काहाके जर आपू याम ढिल्ले ने पोड़ो ताहां बोराबर वेलेपोअ फल वाडीत टोलू कोअहूं. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />तियाहा काजे जेतो ओत सेके तेतो आपू आखाअरी हाजोज कोअहूं जोवे, खास कोइत विश्वासी पाव्हीइलांअरी.<verse eid="GAL 6:10" /></para>
  <para style="s">आखरीइ सुसना आन सलाम</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />आंय सोताआ आथोवाईं केहेलाहा वोडा वोडा आक्शरोमेहें तुमुहूं लेख्योहो तों पाला! <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />जे माअहें उपरसोल्यू देखावू कोअहूं होदतेहें, तेंज तुमू खतना कोअहूं जोवे कोत दाबाव टाकतेहे, तेंबी काहा काजे के, ख्रिस्ताआ क्रुसखांबोअ वाखरी तियांहां सतावणी ने ओवुहूं जोवे कोत. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />आन खतना कोअनारे सोताहा ते कायदाआ पालन नाहां कोअते, पोन तुमाआं उपरसोल्या देखावाआ वोडाय कोइलोअ काजे तें तुमाआं खतना कोआड़ुहूं होदतेहे. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />आपाआ प्रभु ईसु ख्रिस्ताआ क्रुस खांबोअ वोडायीइ सिवाय आंय किहाआज वोडाय ने कोओ; तियाआ क्रुस खांबोअ वाखरी दुन्या माआं नजरेम मोयीही आन आंय दुन्याअ नजरेम मोयुहू. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />एखाआ खतना ओवोय नेत ने बी ओवोय तियाआ कीज महत्व नाहां, पोन नोवो बोणुहूं जोवे ओंज महत्वाआ होय. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />आन जेते जोएं या कायदापोअ सालतेय तियांपोअ आन देवोअ इस्राएलो पोअ शांती आन दया ओवती रोअहूं जोवे!<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />आगाड़ी रोत कोडोज माहूं दुख मा देहा, काहाके आंय ईसुउ निशाणी माआं डिलोपोअ लेत फिरोहो.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />माआं पाव्हीइला, आपाआ प्रभु ईसु ख्रिस्ताआ मेरवानी तुमाअरी रोअहूं जोवे. आमेन!<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>