<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Noiri</book>
  <para style="h">प्रगटीकरण</para>
  <para style="toc3">प्रगटी</para>
  <para style="toc2">प्रगटी</para>
  <para style="toc1">योहानोहो ओवल्यो प्रगटीकरण</para>
  <para style="mt2">योहानाला झालेल्या प्रकटीकरणाचे पुस्तक</para>
  <para style="mt1">योहानोहो ओवल्या प्रगटीकरणोअ पुस्तक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">प्रगटीकरणोअ ओं पुस्तक नवा नियमोअ सेवट्योअ पुस्तक होये. ओं पुस्तक एक आंदास ख्रिस्त जल्म 95 मेहें प्रेशित योहानोअ आथे लेखाअयोतो. <char style="xt"><ref loc="REV 1:1">1:1</ref></char> योहाने लेखल्यी हाजी बातमी तिये लेख्यी आन योहानोअ पेहलो पत्र, दुसरो पत्र आन तिसरो पत्र एं बी तियेज लेख्ये. योहानोहो ईसु जास्ती मेर कोअत्लु कोत तियाहा, “ईसुउ मेरालु” एहें कोत बी ओलखीइतेहें. <char style="xt"><ref loc="JHN 13:23">योहान 13:23</ref> </char> “योहानोहो ओवल्यो प्रगटीकरण ओं पुस्तक” योहाने पतमुस<note caller="+" style="f"><char style="fr" closed="false">1:0 </char><char style="fq" closed="false">पतमुस </char><char style="ft" closed="false">ओ एक दोऱ्याआ विसमेऱ्युउ टेंबू होय जिहीं ओलावीइलोअ शिक्शा होपाअतीते</char></note> बेटोपोअ बोहीत लेख्यो, काहाके तेहेलाम तियाहा ईसु ख्रिस्ताआ हाजी बातमीइ परसार कोअत्लू काजे हाद्दीपार कोइ देदुतो. <char style="xt"><ref loc="REV 1:9">प्रगटी 1:9</ref></char></para>
  <para style="ip">योहान ओं प्रगटीकरणोअ पुस्तक याआ काजे लेखेहे, काहाके याआ वासनाराहां ईसु ख्रिस्ताअरी इमानदार रोअलोअ हिम्मत जोड़ुहूं जोवे आन तियांहां आशा जोड़ुहूं जोवे. काहाके ईसुउ आवीइलोअ आहनो रोयोहो. <char style="xt"><ref loc="REV 1:3">1:3</ref>; <ref loc="REV 22:7">22:7</ref> </char> ओं आखा विश्वासी माअहोंअ काजे लेख्योहो आन खास कोइत साँत मंडड़ीइ नाव लेत कोइत लेख्योहो. आध्याय <char style="xt"><ref loc="REV 2-3">2—3</ref>.</char> योहान तियाआ या लेख्याहा भविश्यवाणीइ रुप आपेहे आन दर्शनोमेहें जाअखिली गोठी तिये ते समजाड़ीलोअ काजे अलग अलग सित्राआ वापर कोइत वर्णन कोअहे. या पुस्तकोमेऱ्युउ वारुज भाग जुना नियमोमेऱ्युउ जोड़ेहे. खास कोइत <char style="xt"><ref loc="ZEC 6:1-8">जख 6:1-8</ref>.</char> हांत तुरी आन हांत वाटकाआ आखरीपोअ ईसुउ जित ओवेहे. तिहीं रोत जें तियाआ नावोपोअ विश्वास कोअतेहे तें आखे तियाअरी हादाफल जिवन काटे. ओं पुस्तक सेतावणी आपेहे आन आशा आपेहे के ईसु वेगु आवनारु होय.</para>
  <para style="iot">रुप रेशा</para>
  <para style="io1">1. योहान तो कोडु होय तो कोत देखाड़ीत सुरुवात कोअहे आन तियाहा प्रगटीकरणोअ दर्शन कि कोइत ओवो तों कोत देखाड़ेहे. <char style="ior"><ref loc="REV 1:1-20">1:1-20</ref> </char></para>
  <para style="io1">2. योहान ईसु ख्रिस्तापोअ रोत खबर लेत कोइत पाद्रुज हांत मंडड़ीइ जागे पोताड़ेहे<char style="ior"><ref loc="REV 2:1-3:22">2:1—3:22</ref> </char></para>
  <para style="io1">3. तिहीं रोत तो हांत सिक्काआ बाप्तिम फोड़ कोइत देखाड़ेहे. <char style="ior"><ref loc="REV 4:1-8:5">4:1—8:5</ref></char> आन हांत तुरीइ बाप्तिम कोत आपेहे.<char style="ior"><ref loc="REV 8:6-11:19">8:6—11:19</ref></char></para>
  <para style="io1">4. तिहींइंं फासाड़ी योहान हांतमुंड्या हापोअरी एका हाना पोऱ्याआ लोड़ायीइ वर्णन कोअहे. <char style="ior"><ref loc="REV 12:1-14:20">12:1—14:20</ref> </char></para>
  <para style="io1">5. तिहींइंं फाटी तो देवोअ खोतेए हांत वाटकाआ बाप्तिम कोत आपेहे. <char style="ior"><ref loc="REV 15:1-16:18">15:1—16:18</ref></char></para>
  <para style="io1">6. आगाड़ी योहान होरगाम देव तियाआ दुस्मोनोहों केहेलुहू हारवेहे तों कोत आपेहे.<char style="ior"><ref loc="REV 17:1-20:15">17:1—20:15</ref></char></para>
  <para style="io1">7. आखरीपोअ योहान नवी धरती आन नवो जुग जो दुन्याआ सेवटीपोअ आवनारो होय तियाआ वर्णन आपेहे.<char style="ior"><ref loc="REV 21:1-22:21">21:1—22:21</ref> </char></para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />ओं ईसु ख्रिस्ताआ प्रगटीकरण होय. जे गोठी वेगीज ओवनारी होये, ते देवे तियाआ सेवकोहों देखाड़ीइलोअ काजे ख्रिस्ताहा आप्यी, आन ख्रिस्ते तियाआ देवदुतोहो मोकलीत कोइत ए आखी गोठी तियाआ सेवक योहानोहो कोय तेहें कोयो. <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />योहान देवोअ वसनोअ बाप्तिम आन ईसू ख्रिस्ताआ बाप्तिम मोन्ज्ये जों जों तिये देख्यो, तियाआ बाप्तिमेहें साक्शी आप्यी. <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />यी भविश्यवाणीइ वसने जो वासित देखाड़ेहे, आन जें उनाअतेहे आन जें यामेहें लेखल्यी गोठीही मानतेहे तें आशिर्वादीत होय; काहाके ए गोठी पुरी ओवीइलोअ वेल आहने आवीत लागीही.<verse eid="REV 1:3" /></para>
  <para style="s">सलाम</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:4 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 3:14">निर्ग 3:14</ref>; <ref loc="REV 4:5">प्रगटी 4:5</ref></char>
    </note>आसियामेर्‍यीइ हांत मंडड़ीही योहानोअ संदेश:</para>
  <para style="p" vid="REV 1:4">जो होय, जो ओतु आन जो आवनारु होय, तियाअहें रोत, तियाआ राजगादीइ आगाड़ी हजर रोनारी हांत आत्माअहें रोत, <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" /><note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ISA 55:4">यश 55:4</ref>; <ref loc="PSA 89:27">भजन 89:27</ref></char></note> जो खोरु साक्शीदार आन मोल्याम रोत जिवीत उठनारामेहें पेलठू आन धरतीइ राजहांअ पुडारी होय, तिया ईसू ख्रिस्ताअहें रोत तुमुहूं मेरवानी आन शांती जोड़ुहूं जोवे.</para>
  <para style="p" vid="REV 1:5">तो आपापोअ मेर कोअहे, आन तिये सोताआ रक्तावाअहीं आपुहूं पापोम रोत वासाड़्येहे, <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" /><note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="EXO 19:6">निर्ग 19:6</ref>; <ref loc="REV 5:10">प्रगटी 5:10</ref></char></note> आन आपुहूं राज्य आन आपाआ देव आब्हाआ काजे आपुहूं पुंजारा बोणावी देदा, तियाआज महिमा आन पराक्रम हादाजलम रोअहूं जोवे, आमेन.<verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:7 </char>
      <char style="xt" closed="false">
        <ref loc="DAN 7:13">दानि 7:13</ref>; <ref loc="MAT 24:30">मत्तय 24:30</ref>; <ref loc="MRK 13:26">मार्क 13:26</ref>; <ref loc="LUK 21:27">लुक 21:27</ref></char>
    </note> पाला, तो वाद्लापोअ आवनारु होय, हारेक माहुंउं तियाहा पाले, एतोज नाहां जियां तियाहा खिला ठोक्याते, तें बी तियाहा पाले, आन धरतीपोर्‍येए आखे माअहें तियाआ वाखरी जुदे रोड़े, एहलोज ओवे! आमेन<verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:8 </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:13">प्रगटी 22:13</ref>; <ref loc="EXO 3:14">निर्ग 3:14</ref></char>
    </note> जो होय, जो ओतू आन जो आवनारु होय, तोज आखाम रोत वोडी ताकतवालु यहोवा देव कोहे, “अल्फा आन ओमेगा<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="fq" closed="false">अल्फा आन ओमेगा </char><char style="ft" closed="false">पेलठू आन आखरी होय.</char></note> आंयज होय.”<verse eid="REV 1:8" /></para>
  <para style="s">ख्रिस्ताआ दर्शन</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />आंय तुमाआ पाही योहान होय, आन ईसुउ तारास, राज्य आन धिरोमेहें तुमाआं हेंगात्यू, देवोअ वसन आन ईसूउ बाप्तिमेहें साक्शी आपीइलाअ वाअहीं आंय पतमुस नावोअ बेटोपोअ ओतु. <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />आंय प्रभुउ दिहोमेहें आत्माम पोआत गोयु, आन माआ फासाड़ी तुरीइ होस वोडा आवाजोम एहें कोत्लाहा उनाअयु, <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />तिये एहें कोयो, “तु जो किबी पालेहे, तियाहा पुस्तकोम लेख आन तियाहा इफिस, स्मुरणा, पर्गम, थुवतीरा, सारदीस, फिलादेलफिया, आन लौदीकिया जागऱ्यीइ हांतू मंडड़ीइ जागे मोकली दे.”<figure style="fig" alt="Map of seven churches in Asia" file="HK00378C.tif" size="span" copy="Horace Knowles ©" ref="1:11">आसियामेऱ्यीइ हांत मंडड़ीइ नाकाशु</figure><verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />माअरी कोडो गोगेहे, तियाहा पालीइलाअ काजे आंय फाटी फिरीत पाल्यो, ताहां होनाआं हांत दिवा देख्या; <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" /><note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानि 7:13</ref>; <ref loc="DAN 10:5">10:5</ref></char></note> आन तिंया दिवाआ विसमेहें माहुंउं बेटाह्हाअ होस एका माट्योहो देख्यू, तो नांबो आंगड़ो गुडाअहीं जाआं पोवित ओतू, आन तियाआ साती पोअ होनाअ पोट्टू बांदल्यु ओतू. <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" /><note caller="+" style="x"><char style="xo" closed="false">1:14</char><char style="xt" closed="false"><ref loc="DAN 7:9">दानि 7:9</ref>; <ref loc="DAN 10:6">10:6</ref></char></note>तियाआ मुन्काआ सिंग्ये बर्फाआ होसर्‍येए पांडे पांडेज आसला रुंग्हांआं होस ओते, आन तियाआ डोआ आगीइ होस भोबलीइताते. <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" /><note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="EZK 1:24">यहे 1:24</ref>; <ref loc="EZK 43:2">43:2</ref></char></note> तियाआ गुडा बाठीम तोपवीइल्या ईसत्लेए होस समकीइताते आन तियाआ आवाज दोर्‍याअ होस हुहवीइतुतो. <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />तो तियाआ हाजाड़्या आथोमेहें हांत तारा लेत ओतू, आन तियाआ सोबिम रोत वाडाली बेन तार्‍यी तारवाअ निहींतीते, आन तियाआ सोब माजन्या दिहोअ होस समकीइतीते. <verse eid="REV 1:16" /><verse number="17" style="v" sid="REV 1:17" />आंय तियाहा पालताज वाआ मोल्याआ होस तियाआ गुडाअ जागे उठ्लीत पोड़्यू. तिये मापोअ तियाआ हाजाड़्यू आथ मिकीत कोइत कोयो, “बिही मा; आंय सुरवात आन आखरी होय.<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="ISA 44:6">यश 44:6</ref>; <ref loc="ISA 48:12">48:12</ref>; <ref loc="REV 2:8">प्रगटी 2:8</ref>; <ref loc="REV 22:13">22:13</ref></char></note> <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />जिवनोअ उकलू आंय होय, आंय मोइत गोयुतो तेबी पाला, आंय हादाजलम जिवतु होय! मोतोअ आन अधोलोकोअ कुसी माजपोअ होय. <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />तियाहा काजे तुमे जो देख्योहो, आन जे गोठी ओवेहे आन जे गोठी याअ फासाड़ी ओवनारी होय, तियीं आखीही लेखीत ले. <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />जियां हांत ताराहा तुमे माआं हाजाड़्या आथोम देख्या, तियांआं आन होनाअ हांत दिवाआ अर्थ एहें कोइत होय: हांत तारा ए हांत मंडड़ीइ दुत होय, आन हांत होनाअ दिवा ए हांत मंडड़ी होय.”<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s">इफिसोअ मंडड़ीही संदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />“इफिसोअ मंडड़ीइ दुतोहो ओं लेख:</para>
  <para style="p" vid="REV 2:1">“जो तियाआ हाजाड़्या आथोमेहें हांत तारा लेत होय, आन होनाअ हांत दिवाआ विसमेहें सालेहे, तो एहें कोहे: <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />माहूं ताआ काम, मेहेंनत आन धिर मुंदू होय; आन ओं बी मुंदू होय के तू पापी माअहुंहूं सहन नाहां कोइत सेकतु; आन जे सोताहा प्रेशित समजीइताहा, पोन ते प्रेशित कायनाहां, तुमे तियांआं परिक्शा लेदीही आन ते ठोग निहींयाहा. <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />तू धिर खेटेहे, आन माआं नावोअ काजे दुख वेठताम तु हार ने मान्यू. <verse eid="REV 2:3" /><verse number="4" style="v" sid="REV 2:4" />पोन माहूं ताआ विरुद्दाम ओं कोअलो होय के, तु पेल मापोअ कोअहे तेहेलीही मेर ओमे नाहां कोअतु. <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />तियाहा काजे ओर कोअ के तू का रोत पोड़्युहू. मोन फिरव आन पेल कोअहे तेहलेहे कामे कोअ; जर तू मोन ने फिरावही, ताहां आंय ताआ जागे आवीत ताआ दिवू तियाआ जागे रोत फेड़ी देहीं. <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />तेबी तामेहें ए हाजी गोठ होय के, माआं होस तू बी निकोलायीइ कामोहों सीस कोअहे.<verse eid="REV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:7 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 2:9">उत्प 2:9</ref>; <ref loc="REV 22:2">प्रगटी 22:2</ref>; <ref loc="EZK 28:13">यहे 28:13</ref>; <ref loc="EZK 31:8">31:8</ref></char>
    </note> “आत्मा मंडड़ीही की कोहे तो जियांआं कान ओय तों उनाइत ल्या!</para>
  <para style="p" vid="REV 2:7">“जो जिके, तियाहा आंय एहला जिवनोअ साड़ोअ फल खाय तेहें आपीहीं जों देवोअ होरगाआ बोगिसाम होय.<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="REV 2:11">प्रगटी 2:11</ref></char></note><verse eid="REV 2:7" /></para>
  <para style="s">स्मुरणा मंडड़ीही संदेश</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:8 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 44:6">यश 44:6</ref>; <ref loc="ISA 48:12">48:12</ref>; <ref loc="REV 1:17">प्रगटी 1:17</ref>; <ref loc="REV 22:13">22:13</ref> </char>
    </note>“स्मुरणाआ मंडड़ीइ दुतोहो ओं लेख:</para>
  <para style="p" vid="REV 2:8">“जो पेहलु आन सेवट्युउ होय, जो मोइत गोयुतो आन फाशुउ जिवीत उठ्युहू, तो एहें कोहे: <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />ताआ अड़सनी आन गरीबी माहूं मुंदू होय. तेबी तु कुन्बी होय; जें सोताहा यहुदी समजीइतेहे पोन होयज नाहां, तें निस्ते सैतानोअ आराधनालयोअ सदस्य होय, आन तें माहें ताआ केतीही बदनामी कोअतेहे तों बी माहूं मुंदू होय. <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />जों दुख ताहूं वेठीइलोअ आवनारोहो, तियाहा मा बिही. काहाके सैतान तुमाआ परिक्शा लेअलाअ उद्देशोवाअहीं तुमामेर्‍याअ थोड़ाक जोअहों जेलेम टाकी देय आन तुमू दोहो दिही जाआं अड़सनीम पोड़ीत रोहा. जिव निहींत जाय ताअहूं जाआं तु इमानदार रो; ताहां आंय तुमुहूं जिवनोअ टोपू आपीहीं.<verse eid="REV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:11 </char>
      <char style="xt" closed="false">
        <ref loc="REV 20:14">प्रगटी 20:14</ref>; <ref loc="REV 21:8">21:8</ref> </char>
    </note> “आत्मा मंडड़ीही कि कोहे तो जियांआं कान ओय तों उनाइत ल्या.</para>
  <para style="p" vid="REV 2:11">“जों जिके, तियाहा दुसरा मोतोअ किज तारास ने ओवे.<verse eid="REV 2:11" /></para>
  <para style="s">पर्गम मंडड़ीही संदेश</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />“पर्गम मंडड़ीइ दुतोहो ओ संदेश लेख: जियापोअ वाडाली आन बेनतारी तारवाआ होय, तो एहें कोहे, <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />तु का रोहे तों माहूं मुंदू होय. जिहीं सैतानोअ गादी होय तिहीं तू माआं नाव वातड़ो तोइत रोयुहू. आन जिहीं सैतान रोहे तिहीं माआं खोरु साक्शीदार अंतिपास तुमामेहें माआंयु, तेहलाम बी तुमे मापोर्‍युउ विश्वास ने सोड़्यू. <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" /><note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="NUM 22:5">गणती 22:5</ref>; <ref loc="NUM 7">7</ref>; <ref loc="NUM 31:16">31:16</ref>; <ref loc="DEU 23:4">कायदा 23:4</ref>; <ref loc="NUM 25:1-3">गणती 25:1-3</ref> </char></note> पोन तेबी ताआ थोड़ीक गोठी सुकतीही ते कोअलोअ माहूं भाग होय. ते गोठी ए होय के, बालामोअ शिक्शण माननारे माहें ताआ जागे होय, तिये मुर्तीही पुंजल्‍यी वस्तुउ खाये तेहें आन सिनालो कोए तेहें इस्राएलवालाआं सामने बालाकोहो टेवाड़्यु. <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />तेहलेज तुमाआ विसमेहें जें निकोलायोअ शिक्शणोहों मानतेहें एहलेहे थोड़ेक माअहें बी होय, जियांआं आंय सीस कोअहो. <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />तियाहा काजे पापोअहें रोत मोन फिरव; नेते आंय ताआ जागे वेगुज आविहीं आन माआं मुखोअ तारवाइ वाअहीं तियां माअहोंअरी सुलाअहीं.<verse eid="REV 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17" />“आत्मा मंडड़ीही की कोहे तों जियाआ कान ओय तों उनाइत ल्या! जों जिके, तियाहा आंय निकाड़ल्या मान्नाम रोत आपीहीं; आन तियाहा एक पांडू डोण बी आपीहीं; आन तिया डोणोपोअ एक नोवो नाव लेखल्यो रोय, जियाहा तो डोण जोड़े तिया सिवाय बिहीरो कोडो ने जाइंत सेके.<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="EXO 16:14-15">निर्ग 16:14-15</ref>; <ref loc="EXO 16:33-34">16:33-34</ref>; <ref loc="JHN 6:48-50">योहान 6:48-50</ref>; <ref loc="ISA 62:2">यश 62:2</ref>; <ref loc="ISA 65:15">65:15</ref></char></note><verse eid="REV 2:17" /></para>
  <para style="s">थुवतीराआ मंडड़ीही संदेश</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />“थुवतीराआ मंडड़ीइ दुतोहो ओ संदेश लेख:</para>
  <para style="p" vid="REV 2:18">“जियाआ डोआ आगीइ होस भोबलीइताहा, आन जियाआ गुडा इसत्लेए होस समकीइताहा, तो देवोअ बेटुह्हू एहें कोहे, <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />माहूं ताआ कामोअ, ताआ मेर आन विश्वास, सेवा, आन धिरोअ बाप्तिमेहें मुंदू होय, आन ताआ सेलवार्‍येए कामे पेल्लाआ कामों रोत हाजे होय, ओं बी माहूं मुंदू होय. <verse eid="REV 2:19" /><verse number="20" style="v" sid="REV 2:20" /><note caller="+" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="1KI 16:31">1 राजां 16:31</ref>; <ref loc="2KI 9:22">2 राजां 9:22</ref>,<ref loc="2KI 9:30">30</ref></char></note> पोन माआं ताहूं ए सुक देखाड़ीइलो भाग होय के, तू तियी इजेबेल नावोअ बोईंहीं तुमाआं विसमेहें रोअहूं देहे. जे सोताहा भविश्यवक्ती कोहे आन तियीइ शिक्शणो वाअहीं माआं सेवकोहों सिनालो कोइलाअ आन मुर्तीही पुंजल्यो माहां खाय तेहें काजे भटकाड़ेहे. <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />आंय तियीही मोन फिरावे तेहें काजे वेल आप्यी, पोन सिनालो सोड़ीइलोअ तियीइ इश्शा कायनाहां. <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />पाल, तियीही आंय खाट्लाम रोत ने उठे एहलिही बिमार कोइ देहीं, आन जर तियीइरी सिनालो कोअनारे तियांआं कामोअहें रोत मोन ने फिरावे, ताहां आंय तियांपोअ वोडी पिड़ा टाकीहीं. <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" /><note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="PSA 7:9">भजन 7:9</ref>; <ref loc="JER 17:10">यिर्म 17:10</ref>; <ref loc="PSA 62:12">भजन 62:12</ref> </char></note> आंय तियीइ पोर्‍याहां माइत टाकीहीं; ताहां आखी मंडड़ीही मुंदू जाय के दिल आन मोनोअ फारकीइनारु आंयज होय, आन आखाहा जिवज्योअ कामोअ पुरमाणे फल आपीहीं.<verse eid="REV 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24" />“पोन थुवतीरावाले जें बाकी रोयेहे तें तुमू तियीइ शिक्शणोहों नाहां मानते आन सैतानोअ गुप्त्यी गोठी कोतेहे ते जियांहां नाहां मुंदू, तियां आखाहा आंय एहें कोहो: आंय तुमापोअ फाशुउ वोजू ने टाको. <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />पोन आंय आविहीं ताअहूं जाआं जों शिक्शण तुमापोअ होय, तियाम तुमू मजबुत रोवा. <verse eid="REV 2:25" /><verse number="26" style="v" sid="REV 2:26" />जों जिकीत जाय आन सेवटी जाआं माआं कामोअ पुरमाणे कोअतो रोय, तियाहा आंय आखा देशोअ माअहूं पोअ माहूं जोड़्युहू तेहलुहू आधिकार आपीहीं. <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" />आन जेहें कोइत कुंबारोअ बासने लोड़ाआ डांडा वाअहीं सुउवात जातेहे, तेहें कोइत लोड़ाआ राजडांडू<note caller="+" style="f"><char style="fr" closed="false">2:27 </char><char style="fq" closed="false">राजडांडू </char><char style="ft" closed="false">राजाआ आथोमेऱ्यीइ आधिकारोअ डेंगार</char></note> लेत कोइत तों तियांपोअ राज कोए. <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />आन आंय तियाहा उजाल्यु तारु आपीहीं.<verse eid="REV 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29" />“आत्मा मंडड़ीही की कोहे तों जियाआ कान ओय तों उनाइत लेय.”<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s">सारदीस मंडड़ीही संदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />“सारदीसोअ मंडड़ीइ दुतोहो ओं लेख:</para>
  <para style="p" vid="REV 3:1">“जियापोअ देवोअ हांत आत्मा आन हांत तारा होय, तो एहें कोहे के, ताआ कामे माहूं मुंदू होय, तु जिवतु होय एहें कोत माहें कोतेहे, पोन तू मोल्यू होय. <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />निंदेम रोत ऊठ, आन जों वाहींज रोयोहो आन जों आरवाअहूं कोअहे, तियाहा वातड़ो तोअ; काहाके ताआ कोड्लाज कामोहों आंय माआं देवोअ नजरेम पुरो ओवत्लो नाहां देख्यो. <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" />तियाहा काजे तुमे जों शिक्शण लेदो आन उनाअयुहू, तिहींम वातड़ू रो आन मोन फिरव. जर तू निंदेम रोत ने उठही, ताहां आंय बांडोअ होस कोड्ली वेले आवीत लागिहीं तों ताहूं मुंदून्ने जाय. <verse eid="REV 3:3" /><verse number="4" style="v" sid="REV 3:4" />पोन सारदीसोमेहें ताआ जागे थोड़ेक एहलेहे माअहें बी होय, जियां सोताआ आंगड़े ने मोलव्ये, तें माअरी पांडे आंगड़े पोवित फिरे, काहाके तें याआज लायकीइ होय. <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" />जों जिके तियाहा एहेलेज पांडे आंगड़े जोड़े, आन आंय तियाआ नांव जिवनोअ पुस्तकोम रोत ने खुड़ो, पोन माआं आब्हाआ आन तियाआ देवदुतोअ सामने तियाआ नाव मानित लेहीं.<verse eid="REV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6" />“आत्मा मंडड़ीही की कोहे तों जियाहा कान ओय तों उनाइत लेय.<verse eid="REV 3:6" /></para>
  <para style="s">फिलादेलफिया मंडड़ीही संदेश</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />“फिलादेलफिया मंडड़ीइ दुतोहो ओं लेख:</para>
  <para style="p" vid="REV 3:7">“जो पवित्र आन सत्य होय, जियापोअ दाविदोअ किल्ली होय, जियाआ उगाड़ल्यो कोडोज बोंद नाहां कोइत सेकतो, आन जियाआ बोंद कोअल्यो कोडोज उगाड़ीत नाहां सेकतो, तो एहें कोहे: <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />माहूं ताआ कामोअ मुंदू होय, आंय ताआ काजे एक बाआ उगाड़ीत मिक्योहो, जियाहा कोडोज बोंद नाहां कोइत सेकतो; ताआ सेक्ती वाहीं एतीही होय, तेबी तुमे माआं शब्द पालन कोअयोहो आन माआं नावोहो नाहां नाकार्‍यो. <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />पाल, जें सैतानोअ आराधनालयोअ सदस्य होय, तें सोताहा यहुदी कोतेहे, पोन तें यहुदी कायनाहां, तें ठोगतेहे, आंय एहलोहो कोअहीं के तें आवीत कोइत ताआ पागे पोड़े, आन तियांहां मुंदू जाय के आंय तापोअ मेर कोअहो. <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />तू माआं आदेशोअ पुरमाणे मजबुत रोयु, तियाहा काजे आंय बी ताहूं तियी परिक्शाआ वेले सांबालीत मिकीहीं, जे धरतीइ आखा रोनाराहा फारकीइलाअ काजे पुरी दुन्यापोअ आवनारी होय. <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" />आंय वेगुज आवनारु होय; जे हिकवोण तापोअ होय, तियीपोअ वातड़ू रोजी; जियावाअहीं एखू तुमुहूं तुमाआ टोपा रोत सेटे ने कोअहूं जोवे. <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" />जो जिके तियाहा आंय माआ देवोअ मंदिरोमेहें एक खांबू बोणाविहीं, तो फाशुउ केदिहीं तियाआ बारथे ने जाये; आंय माआं देवोअ नाव, माआं देवोअ गांव, मोन्ज्ये नोवा येरुसालेमोअ नाव, जो माआं देवोअ जागे होरगाम रोत उतरीइनारो होय, आन माआं नोवो नाव बी तियापोअ लेखीहीं.<verse eid="REV 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13" />“जियाआ कान ओय तो उनाइत लेय के आत्मा मंडड़ीही की कोहे.<verse eid="REV 3:13" /></para>
  <para style="s">लौदीकीया मंडड़ीही संदेश</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />“लौदीकिया मंडड़ीइ दुतोहो ओं लेख;</para>
  <para style="p" vid="REV 3:14">“जो आमेन आन विश्वास कोअहूं जोगुहू आन खोरु साक्शी होय, आन देवोअ बोणावल्यी कोलीइ मुख्य पायू होय, तियाआ संदेश एहेंकोइत होय: <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />माहूं ताआ कामोअ मुंदू होय, के तू नाहां हेलू आन नाहां उनू: केतोहो हाजो आवतो के तू हेलू नेत उनू रोतु. <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />तू ते उनू बी नाहां आन हेलू बी नाहां, पोन तू कुकनू होय, तियाहा काजे आंय ताहूं माआ सोबिम रोत ओकारीत टाकुहूं कोअहो. <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />तू एहें कोहे के, आंय कुन्बी होय आन मालदार ओत गोयुहू आन माहूं कोड्लीज गोठीइ कमी कायने; आन तू ओं नाहां समजीइतु के तू टाकाअलू, खाराब, गरीब आन आंद्लू आन उगड़ाअलुज होय. <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />तियाहा काजे तू माआं गोठ मान, आन मापोअ रोत आगीवाअहीं सोकाटल्यो होनो वेसातो लेत लेन कुन्बी बोणीत जा, आन पांडो आंगड़ो लेत कोइत पेवित ले आन ताआ उगड़ाअला डिलोअ इज्जत टापित ले; काजली लेत कोइत ताआ डोआम हार, जियी वाअहीं तू पालीत सेकीही. <verse eid="REV 3:18" /><verse number="19" style="v" sid="REV 3:19" />आंय जियांपोअ मेर कोअहो, तियांहां हेकड़ोहो आन शिक्शा आपोहो; तियाहा काजे जागित जा आन मोन फिरव. <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />पाल! आंय बाअपुरे उबू रोत बाअणो ठोक्या कोअहो; जर एखू माआं आवाज उनाइत कोइत बाआ उगाड़े, ताहां आंय तियाआ जागे मायते आवीत कोइत तियाअरी रोटू खाहीं आन तो माअरी खाय. <verse eid="REV 3:20" /><verse number="21" style="v" sid="REV 3:21" />जो जिके, तियाहा आंय माअरी माआं राजगादीपोअ बोहाड़ीहीं, जेहेंकोइत आंय जिकीत कोइत माआं आब्हाअरी तियाआ राजगादीपोअ बोहीत गोयुहू.<verse eid="REV 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22" />“जियाआ कान ओय, तों उनाइत लेय के आत्मा मंडड़ीही की कोहे!”<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s">होरगामेहें भक्ती</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />याआ फासाड़ी आंय बिहीरो दर्शन पाल्यो, आंय देख्यो के होरगामेहें एक बाआ उगाड़्योहो आन तो तुरीइ होसर्‍युउ आवाज, जियाहा आंय पेल बी माअरी गोठी कोअत्लाहा उनाअयुतो, कोहे: “इंहीं, उसे आव, आंय ताहूं देखाड़ीहीं के याआ फासाड़ी की ओवनारोहो.” <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />तुरतूज आंय आत्मामेहें पोआइत गोयु, आंय पाल्यो, के होरगामेहें एक राजगादी मिक्यीही आन तियापोअ कोडो तेबी बोहीत रोयोहो. <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />जो तियापोअ बोठुहू, तो यास्फे आन सार्दीइ होस ओतू. राजगादीइ मेरेमेरे मरकतोअ होस एक बाण देखाअहे. <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />तियी राजगादीइ मेरेमेरे बिहीरी शोवीस राजगादी होय; आन तियीं राजगादीपोअ शोवीस डायहां पांडे आंगड़े पोवित कोइत बोहीत रोयाहा, आन तियांआं मुन्कापोअ होनाआ टोपा होय. <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />तियी राजगादीमेहें रोत विजलीइलोअ आन गाजीइलाअ आवाज निहीतुतो; आन राजगादीइ आगाड़ी आगीइ हांत दिवा पेटाअताहा, ते देवोअ हांत आत्मा होय.<verse eid="REV 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 4:6" />राजगादीइ आगाड़ी खासोअ दोर्‍या जेहें कितेबी देखाअतोतो.</para>
  <para style="p" vid="REV 4:6">राजगादीइ विसमेहें आन राजगादीइ मेरेमेरे शार जनवारे होय, जियांआं आगाड़ी फासाड़ी डोआन डोआ होय. <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />पेल्लोअ जनवार सिहांअ होस होय, आन दुसरो जनवार बोलदोअ होस होय, तिसरा जनवारोअ सोब माहुंउं होस होय, आन शोवथो जनवार उड्नारा मोरागाआ होस होय. <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />तियां हारेक जनवारोअ सोव सोव फाके होय; आन ते जनवारे मायते बारथे आन मेरेमेरे डोआ वालेज ओते; आन ते रातेन दिही बिगर थाक मुड़्येज एहें कोयाज कोअतेहे,</para>
  <para style="q1" vid="REV 4:8">“पवित्र, पवित्र, पवित्र प्रभु देव, आखाम रोत वोडी ताकतवालु,</para>
  <para style="q2" vid="REV 4:8">जो ओतु, जो होय आन जो आवनारु होय.”<verse eid="REV 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9" />जाहां तें शार जनवारे जो राजगादीपोअ बोहीत रोयुहू, तिया हादाजलम जिवता रोनाराआ महिमा, मानपान आन आभार मानतेते; <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />ताहां ते शोवीस डायहां राजगादीपोअ बोहनाराआ सामने उबडू पोड़ताहा, हादाजलम जिवता रोनाराआ आराधना कोअता आन एहें कोत कोइत राजगादीइ सामने तियांआं टोपा टाकी देताहा आन कोताहा,<verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />“आमाआ प्रभु देव,</para>
  <para style="q2" vid="REV 4:11">तुज महिमा, मानपान आन ताकतोअ लायक होय;</para>
  <para style="q1" vid="REV 4:11">काहाके तुमेज पुरी कोलीही बोणावयी</para>
  <para style="q2" vid="REV 4:11">आन ताआज मोर्जी वाअहीं ते उब्ज्यी आन बोणावयीही.”<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s">पुस्तक आन मेडू</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />जो राजगादीपोअ बोहीत ओतु, तियाआ हाजाड़्या आथोमेहें एक पुस्तक देख्यो जो मायते आन बारथे लेखल्यो ओतो, आन तों पुस्तक हांत सिक्का मारीत कोइत बोंद कोअयोतो. <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />आन आंय एका सेक्तीमान देवदुतोहो देख्यू, जो वोडा आवाजोमेहें आअड़ीतुतो, “या पुस्तकोहो उगाड़ीइलोअ आन या सिक्काआ तोड़ीइलाअ लायक कोडो होय?” <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />पोन होरगाम, धरतीपोअ, धरतीइ निसे कोडोज एहेलोहो माहुंउं नाहां सापड़्यो, जो पुस्तक उगाड़ीइलोअ नेते वासीइलाम सेक्तीमान ओय. <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />ताहरुउ आंय जाअखीलुहू रोड़ू वोल्यू. काहाके तिया पुस्तकोहो उगाड़ीइलाअ नेताहां वासीइलाआ लायक कोडोन्ने सापड़्यो. <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />ताहरोअ तियां डायहां मेर्‍युउ एक जोओं माहूं कोयो, “मा रोड़ही; पाल, तो यहुदाआ पारवाड़ीइ सिहूंवाग होय, जो दाविदोअ बिज होय, तो जिकुहू; तियाहा काजे तो पुस्तक आन तियाआ सिक्का उगाड़ीइलाअ लायक होय.”<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />ताहरुउ राजगादीइ जागे शार जनवारोअ आन तियां डायहांअ विसमेहें आंय एक गाराहा कोअल्यू मेडू उबोइत रोल्यू देख्यू. तियाआ हांत हिंगे आन हांत डोआ ओता; ए देवोअ हांत आत्मा होय, जियींहीं देवे पुरी धरतीपोअ मोकल्यीही. <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />ताहां मेडू आहने आवीत कोइत राजगादीपोअ बोहनाराअ हाजाड़्या आथोम रोत पुस्तक लेदो. <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />जेहेलाम तिये मेडे पुस्तक लेत लेदो, तेहेलाम तें शारु जनवारे आन शोवीस डायहां मेडाअ पागे पोड़्या. तियां आखा डायहांआं आथोम तंबिवरे ओते, आन आगरबत्ती वाअहीं पोआअला वाटका ओता,जे पवित्र माहुंउं प्रार्थना होय. <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />ते ओं नोवो गित गावा वोल्या:</para>
  <para style="q1" vid="REV 5:9">“तू या पुस्तकोहो लेएलाआ आन तियाआ</para>
  <para style="q2" vid="REV 5:9">सिक्का उगाड़ीइलाअ लायक होय.</para>
  <para style="q1" vid="REV 5:9">काहाके तुमे गाराहा ओवीत कोइत सोताआ रक्तावाअहीं हारेक कुल, पारवाड़ी आन राज्या राज्यामेहें बाशा गोगनारा,</para>
  <para style="q2" vid="REV 5:9">आक्खामेहें रोत देवोअ काजे माअहुंहूं वेसाते लेदेहे,<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />आन तियांहां आपाआ देवोअ काजे एक राज्य</para>
  <para style="q2" vid="REV 5:10">आन पुंजारु बोणावयाहा:<note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="EXO 19:6">निर्ग 19:6</ref>; <ref loc="REV 1:6">प्रगटी 1:6</ref> </char></note> आन ते धरतीपोअ राज कोअताहा.”<verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />फाशोअ आंय पाल्यो, ते राजगादी, जनवारोअ आन डायहांअ मेरेमेरे जाअखीलाहा देवदुतोअ आवाज उनाअयु, आन तियांआं गणती लाखोअ आन करोड़ोअ ओती. <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />ते वोडा आवाजोमेहें ओं गित गावताते,</para>
  <para style="q1" vid="REV 5:12">“जो गाराहा ओवल्यू तोज</para>
  <para style="q2" vid="REV 5:12">सेक्ती, धन, बुध्दी, ताकत,</para>
  <para style="q2" vid="REV 5:12">मानपान, महिमा आन स्तुतीइ लायक होय!”<verse eid="REV 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13" />फाशोअ आंय होरगामेहें, धरतीपोअ, धरतीइ निसे आन दोर्‍यामेर्‍याआ हारेक जिवोहो एहें कोत्लाहा उनाअयु,</para>
  <para style="q1" vid="REV 5:13">“जो राजगादीपोअ बोठुहू तियाहा</para>
  <para style="q2" vid="REV 5:13">आन मेडाहा वोडाय आन मानपान, महिमा</para>
  <para style="q2" vid="REV 5:13">आन सेक्ती हादाजलम रोअहूं जोवे!”<verse eid="REV 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14" />आन तियां शारु जनवारो कोयो, “आमेन!” आन डायहां पागे पोड़ीत वोंद्यो.<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s">सिक्का</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />तिहीं रोत आंय देख्यो, मेडे तियां हांत सिक्कामेहें रोत एकाहा उगाड़्यु; आन तेहेलाम आंय शार जनवारोमेहें रोत एकाहा गाजेए होस आवाजोम एहें कोत्लाहा उनाअयु, “आव!” <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />आन माआं डोआअ सामने एक पांडू कोड़ु देखाअयू, जो तियापोअ बोठुतो, तियाआ आथोम बिलखो ओतो; आन तियाहा एक टोपू आप्यू, आन तो जिकीत कोइत फाशोअ बी जिकीइलोअ काजे निहीत पोड़्यू.<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />जाहां मेडे दुसरु सिक्कु उगाड़्यु, ताहां आंय बिहीरा जनवारोहो एहें कोत्लाहा उनाअयु, “आव!” <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />आन फाशुउ एक बिहीरु कोड़ु देखाअयू, तो रात्लु ओतु; जो तियापोअ बोठुतो, तियाहा धरतीपोअ रोत होक काडीत लेअलोअ आधिकार आप्यु, जियावाअहीं माअहें एकमेकाआ खुन कोए; आन तियाहा एक वोडी तारवाअ आप्यी.<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />जेहेलाम मेडे तिसरु सिक्कु उगाड़्यु, ताहां आंय तिसरा जनवारोहो एहें कोत्लाहा उनाअयु, “आव!” आन माआं डोआअ सामने एक काल्लू कोड़ु देखाअयू, आन जो तियापोअ बोठुतो, तियाआ आथोम ताराजू ओतु; <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />आन शारु जनवारोअ विसमेहें आंय एक आवाज एहें कोत्लाहा उनाअयु, “एका रुप्याअ आठ्यो पोइत गोंवें आन एका रुप्याआ तिन आठ्ये पोइत जव, पोन जेयतुनोअ तेल आन दाराक्शाआ किम्मत मा वादाड़ीही.”<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />जाहां मेडे शोवथु सिक्कु उगाड़्यु, तांहा आंय शोवथा जनवारोहो एहें कोत्लाहा उनाअयु, “आव!” <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />आन माआं डोआअ सामने एक पिवलू कोड़ु देखाअयू; जो तियापोअ बोठुतो, तियाआ नाव मोत ओतो; आन तियाआ फाटी फाटी अधोलोक सालतोतो; तियाहा धरतीइ शोवथा भागोपोअ ओ आधिकार आप्यू, मोन्ज्ये तिया आधिकारो वाअहीं तो तारवाअ, काल, महामारी, आन धरतीपोर्‍याआ रानठ्या जनवारोवाअहीं माअहोंहों माइत सेके.<verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />जाहां मेडे पासवू सिक्कु उगाड़्यु, ताहां आंय देवान्याअ थुड़ी तियां माहुंउं आत्माहां देख्यी, जियांहां देवोअ वसनोअ बाप्तिमेहें साक्शी आपीइलो वाअहीं माइत टाक्येते. <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />तिये वोडा आवाजोम आअड़ीत कोइत कोयो, “आखाम रोत वोडी ताकतवाला, सोकाम सोका आन खोरा प्रभु; तू कोयों जाआं न्याय ने कोअनारु? आन धरतीपोअ रोनाराहां आमाआं रक्ताआ बोदलू कोयों जाआं ने लेनारु?” <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />तियांमेर्‍याअ हारेक जोअहों पांडे आंगड़े आप्ये आन तियांहां एहें कोयो के, तुमाआं हाती सेवक आन तुमाआं पाही तुमाआं होस जिव आपनाराआं बी गणती पुरी ने ओत जाय, ताअहूं जाआं तुमू थोड़ीक वाआ आराम कोआ.<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />आंय पालतीज रोयु: मेडे साहावू सिक्कु उगाड़्यु, आन जाअखीलोहो वोडो भुकंप ओवो, आन दिही कांबलाआ होस कालु पोड़ीत गोयू, आन सांद रक्ताआ होस रात्लु ओत गोयु. <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />जुगोमेर्‍याआ तारा धरतीपोअ वोडा वादुउ वाअहीं अंजिरोअ निल्ले फलवे ओदरीत पोड़तेहे तेहेलाहा टुटीत पोड़्या. <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />जुग एहेलुहू बिड़ी वोलीत होरकीत गोयु, जेहेलोहो एखु कागल बिड़ी वोलीत जाहे; आन हारेक डोगोअ आन बेट, जिवज्योअ जागापोअ रोत होरकीत गोया. <verse eid="REV 6:14" /><verse number="15" style="v" sid="REV 6:15" />धरतीपोर्‍याआ राजा, प्रधान, सेनापती, कुन्बी आन ताकतवान माअहें, आन हारेक नोवकर, आन सोड़ले माहें डोगोमेर्‍याआ कुपामेहें आन खड़काआ कापड़ाटीमेहें जात निकाअये. <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />आन तें डोगोहो आन खड़काहा कोने वोल्ये, “आमापोअ ओदरीत पोड़ा; राजगादीपोअ बोहनाराआ नजरेम रोत आन मेडाअ खोतेप रोत आमुहूं निकाड़ीत ल्या! <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />काहाके तियां बेनुउं खोतेए वोडू दिही आवीत लागुहू, ओमे कोडो टिकीत सेके?”<note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="MAL 3:2">मला 3:2</ref>; <ref loc="JOL 2:11">योएल 2:11</ref>; <ref loc="NAM 1:6">नहूम 1:6</ref>; <ref loc="ZEP 1:14">सफ 1:14</ref>,<ref loc="ZEP 1:15">15</ref></char></note><verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s">इस्राएलोअ एक लाख शौरेशाड़ीस हाजार माअहें</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />आन तिहींइं फासाड़ी आंय धरतीइ शारु खुणापोअ शार देवदुत उबा रोल्या देख्या. ते धरतीइ शारु वाराहा रुकीत रोयाते, याअ काजे के धरतीपोअ नेताहां दोर्‍यामेहें नेताहां कोड्लाज साड़ोपोअ वारो ने सालुहूं जोवे. <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />आंय एका बिहीरा देवदुतोहो जिवता देवोअ सिक्कु लेत कोइत दिही उगताअहें रोत उसे आवत्लाहा देख्यू; तिये तियां शारु देवदुतोंहों, जियांहां धरती आन दोर्‍याहा उजाड़ीइलाअ आधिकार ओतु, आअड़ीत कोइत कोयो, <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />आमाआ देवोअ सेवकहोंअ आंगड़ाअरी सिक्कु मारुहूं ताअहूं जाआं तुमू धरतीही आन दोर्‍याहा आन साड़ोहो किज नुकसान मा कोअहा. <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />आन आंय सिक्का मारल्या माअहुंउं गणती उनाअयु– ए गणती एक लाख शौरेशाड़ीस हाजार ओती आन तें इस्राएलोअ आखा कुलोमेर्‍येए ओते: <verse eid="REV 7:4" /><verse number="5" style="v" sid="REV 7:5" />यहुदाअ पारवाड़ीमेर्‍याआं बारा हाजारोपोअ सिक्का मार्‍या; रुबेनोअ पारवाड़ीमेर्‍याअ बारा हाजारोपोअ; गादोअ पारवाड़ीमेर्‍याअ बारा हाजारोपोअ; <verse eid="REV 7:5" /><verse number="6" style="v" sid="REV 7:6" />आशेरोअ पारवाड़ीमेर्‍याअ बारा हाजारोपोअ; नफतालीइ पारवाड़ीमेर्‍याअ बारा हाजारोपोअ; मनश्शेए पारवाड़ीमेर्‍याअ बारा हाजारोपोअ; <verse eid="REV 7:6" /><verse number="7" style="v" sid="REV 7:7" />शिमोनोअ पारवाड़ीमेर्‍याअ बारा हाजारोपोअ; लेवीइ पारवाड़ीमेर्‍याअ बारा हाजारोपोअ; इस्साखारोअ पारवाड़ीमेर्‍याअ बारा हाजारोपोअ; <verse eid="REV 7:7" /><verse number="8" style="v" sid="REV 7:8" />जबुलुनोअ पारवाड़ीमेर्‍याअ बारा हाजारोपोअ; योसेफोअ पारवाड़ीमेर्‍याअ बारा हाजारोपोअ; बिन्यामीनोअ पारवाड़ीमेर्‍याअ बारा हाजारोपोअ सिक्का मार्‍या.<verse eid="REV 7:8" /></para>
  <para style="s">एक वोडी गर्दी</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />याअ फासाड़ी आंय आखा देसोहो, कुलोहो, हारेक जात आन बाशाआ एक एहलिही वोडी गर्दीही देख्यी, जियांहां कोडोज गोणीत ने सेकतोतो. ते राजगादीइ सामने आन मेडाअ सामने उबे ओते. आन ते पांडे आंगड़े पोवित आन तियांआं आथोमेहें खारक्याअ बेड्ये ओते. <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />आन वोडा आवाजोमेहें आअड़ीत कोइत कोतेहे, “राजगादीपोअ तारणोअ काजे बोठला आमाआ देवोअ, आन मेडाअ जयजयकार ओवे!” <verse eid="REV 7:10" /><verse number="11" style="v" sid="REV 7:11" />आन आखा देवदुत राजगादीइ आन डायहांअ आन शारु जनवारोअ मेरेमेरे उबा रोत होय, आन ते आक्खा राजगादीइ सामने उबडा पोड़ीत देवोअ भक्ती कोअयी. <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />आमेन! आमाआ देवोहो हादाजलम जाआं भक्ती, महिमा, बुध्दी, आभार, मानपान, सेक्ती आन ताकत! आमेन.<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />ताहां डायहांमेर्‍येए एके जोएं माहूं फुश्यो, “एं पांडा आंगड़ावाले कोडे होय? आन का रोत आवयेहे?”<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />आंय तियाहा कोयो, “प्रभु, ओं ताहूंज मुंदू होय.” तिये माहूं कोयो, “एं तें माहें होय, जें वोडी पिड़ामेहें रोत निहींत कोइत आवयेहे. यां मेडाआ रक्तामेहें सोताआ आंगड़े तुवीत कोइत उजालीत लेदेहे. <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />तियाहाज काजे तें देवोअ राजगादीइ सामने होय, आन ते रातेन दिही मंदिरोमेहें तियाआ सेवा कोअतेहे, आन जो राजगादीपोअ बोठुहू, तो तियांआं उपोअ तंबू ताएं. <verse eid="REV 7:15" /><verse number="16" style="v" sid="REV 7:16" />ते फाश्येए फुकल्येन तिहील्ये ने रोय, आन ने तियांपोअ तोप, ने कोड्लीज जातीइ गरमी तियांपोअ पोड़े. <verse eid="REV 7:16" /><verse number="17" style="v" sid="REV 7:17" />काहाके राजगादीइ विसमेहें होय तो मेडू याआं सारवाल्यु रोय, आन तियांहां जिवनोअ पाअयोंअ उकलाआ जागे लेत जाया कोए; आन देव तियांआं डोआमेर्‍येए आखे रोज्ये नुसी देय.”<note caller="+" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="EZK 34:23">यहे 34:23</ref>; <ref loc="REV 5:6">प्रगटी 5:6</ref>; <ref loc="ISA 2:13">यश 2:13</ref>; <ref loc="PSA 23:2">भजन 23:2</ref>; <ref loc="JER 25:8">यिर्म 25:8</ref></char></note><verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s">हांतवू सिक्कु</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />जाहां तिये मेडे हांतवू सिक्कु उगाड़्यु, ताहां आरदू तास जाआं होरगो सामसुम ओत गोयो. <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />तिहींइं फासाड़ी आंय तियां हांतू देवदुतोंहों देख्या, जे देवोअ सामने उबा रोताहा, आन तियांहां हांत तुरी आप्यी.<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />फाशुउ एक देवदुत होनाआं आगरबत्ती लेत कोइत आयु, आन देवान्याअ जागे उबु रोयू, तियाहा जाअखीलीही आगरबत्त्यी आप्यी, जियीं वाअहीं तो आक्खा देवोअ माअहोंअ प्रार्थनाअरी राजगादीइ सामनेवाला होनाआं देवान्यापोअ सोढ़वे. <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />तियी आगरबत्त्यीइ तुमाणू पवित्र माअहुंउं प्रार्थना नेहें देवदुतोअ आथे देवोअ सामने पोत्यु. <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />ताहरुउ देवदुते आगरबत्ती लेत कोइत तियीमेहें देवान्याअ आग पोअयी आन धरतीपोअ टाकी देदी; तिहीं वाअहीं गाजीइलोअ, आवाज आन विज पोड़्यी आन <note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">धरती आल्यी</char></note>भुकंप ओवयो.<verse eid="REV 8:5" /></para>
  <para style="s">हांत तुरी</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />ताहराअ ते हांतू देवदुत, जियांपोअ हांत तुरी ओती, ते तियींहीं फुकुहूं तियार ओवा.<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />पेलठे देवदुते तुरी फुक्यी, आन रक्तालेज गारे आन आग तियार ओवी, आन धरतीपोअ टाकी देदी;<note caller="+" style="x"><char style="xo" closed="false">8:7 </char><char style="xt" closed="false"><ref loc="EXO 9:23-25">निर्ग 9:23-25</ref>; <ref loc="EZK 38:22">यहे 38:22</ref> </char></note> आन धरतीइ बाराने भाग बोलीत गोयू, आन साड़ोअ बाराने भाग बोलीत गोयू,आन आक्खू निलू सारु पेटाइत गोयू.<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />बिहीरे देवदुते तुरी फुक्यी, तांहा आग जेहें पेटाअत्लू एक वोडू डोगोअ दोर्‍याम टाकी देदू; आन दोर्‍याअ बाराने भाग रक्त बोणीत गोयो. <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />आन दोर्‍याअ बाराने भाग जनवारे मोइत गोये, आन बाराने भाग जाहाज आरवाइत गोयी.<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />तिसरे देवदुते तुरी फुक्यी, आन ताहरुउ दिवीइ होस पेटाअत्लू एक वोडू तारु जुगोम रोत निसे टुटीत पोड़्यू, तो खाडीइ बाराने भागोपोअ आन पाअयोंअ उकलापोअ आवीत पोड़्यू. <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />तिया ताराआ नाव जेरेन जेर होय; आन बाराने भाग पाईं कोड़वो ओत गोयो, आन जाअखीलेहे माअहें मोइत गोये; काहाके तो पाईं कोड़वो ओत गोयोतो.<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />सौथे देवदुते तुरी फुक्यी, तांहा दिहोअ बाराने भाग, आन सांदोअ बाराने भाग आन ताराआ बाराने भागोपोअ पिड़ा ओवयी, आन तियांआं बाराने भाग आंदारो ओत गोयो: आन दिहोअ बाराने भागोमेहें उजालो ने ओवतोतो, आन रातीइ बी एज दशा ओती.<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />आंय फाशोअ पाल्यो, ताहां जुगोमेहें एका मोरागाहा उड्त्लाहा आन वोडा आवाजोमेहें एहें कोत्लाहा उनाअयु, “ते तीन देवदुत तुरी फुकनारा ओता, जे ओमे बाकी होय, धरतीपोअ रोनारा तुमाआं जुदी विते, विते, विते!”<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />जेहेलाम पासवे देवदुते तुरी फुक्यी, ताहां आंय होरगाम रोत धरतीपोअ एका ताराहा पोड़त्लू देख्यू, आन तिया ताराहा वोडा उंडा खायाराआ किल्ली आप्यी. <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />तिये तारे खायाराहा उगाड़्यु, तांहा खायीमेहें रोत वोडी बाठीइ होस तुमाणू निहीयु, आन तिया तुमाणावाअहीं दिही आन पुरु जुग कालान कालाआ ओत गोयू. <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />तिया तुमाणामेहें रोत धरतीपोअ टिडे निहींये, आन तियांहां धरतीपोर्‍याआ विश्योअ होस सेक्ती आप्यी. <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />तियांहां ओ आदेश जोड़्यू के पुंयपोर्‍याआ खोड़ोहो आन कोड्ला निला साड़ोहो नुकसान मा कोअहा, पोन जियां माअहुंउं निंडाअपोअ देवोअ सिक्कु ने ओय; तियांहां तुमू तारास देजा. <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />टिडाहां तियां माअहुंहूं माइलाअ नाहां पोन पास मोयना जाआं पिड़ा देअलोअ आधिकार जोड़्यू; आन विसीइ टोसल्या वाअहीं जेहेलुहू तारास ओवेहे, तेहेलुहूज तियां वाअहीं तारास ओवतुतो. <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />तियां दिहोमेहें माअहें मोइलाअ वेल होदे, पोन तियांहां ने जोड़े; ते मोतोअ लालस कोए पोन मोत तियांआं आहने ने आवे.<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />तियां टिड्याआं रुप लड़ायीइ काजे तियार कोअल्या कोड़ाआ होस ओतू; एहेलेहे देखाअतेते के तियांआं मुन्कापोअ होनाअ टोपा ओता, आन तियांआं सोब माअहुंउं होस ओती. <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />आन तियांआं सिंग्ये बोईं सिंग्याअ होस आन तियांआं दात सिहां वागोअ दातोअ होस ओता. <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />तियांआं सातीपोअ लोड़ाअ आंगड़े ओते, तियांआं उडीइलाअ आवाज लड़ायीम गुगदीइनारा जाअखिलाहा कोड़ाआ गाडाअ आवाजोअ होस ओतू. <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />तियांहां विश्योअ होस सेपटे आन तियांअरी हुयटा ओता, आन माअहुंहूं पास मोयना जाआं तारास देअलोअ आधिकार जोड़्युतो, तियांआं जेहर तियांआं सेपटामेहें ओतो. <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />उंडा खायाराअ दुत ओ तियांपोअ राजा होय, इब्री बाशामेहें तियाआ नाव अबद्दोन, आन युनानी बाशामेहें तियाआ नाव अपल्लूओन<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="fq" closed="false">अपल्लूओन </char><char style="ft" closed="false">मोन्ज्ये आरवीत टाकनारु.</char></note> होय.<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />पेल्लीइ पिड़ा ओत गोयी; यीइ फासाड़ी फाशीइ बेन वोडी पिड़ा आवनारी होय.<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />साहावे देवदुते तुरी फुक्यी; ताहां होनाअ देवान्याअ शारु खुणापोर्‍याअ हिंगोम रोत एक आवाज आंय उनाअयू, <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />तुरी लेत रोनारा साहावा देवदूतोहो तो आवाज एहें कोत्लाहा आंय उनाअयू, “वोडी फरात नोयीइ जागे बांदल्या शारु देवदुतोहो सोड़ी दे.” <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />ताहां माअहुंउं बाराने भाग माइलाअ काजे ते ठरवीइल्यी वेल, दिही, मोयनु, आन वोरीही याअ काजे, जे शार देवदुत तियार कोअयाते तियांहां सोड़्या. <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />कोड़ा गुगदाड़नाराअ गणती विही करोड़ ओती; ए आंय तियांआं गणती उनाअयू. <verse eid="REV 9:16" /><verse number="17" style="v" sid="REV 9:17" />माहूं या दर्शनोमेहें कोड़ा आन तियांपोअ बोहनारा देखाअया: सेयनिक आगीइ होस लाल, निल्ला, आन गंधकोअ होस पिवला लोड़ाआ आंगड़े पोवीत ओता, आन तियां कोड़ा मुन्के सिहां वागोअ मुन्काआ होस ओते, आन तियांआं सोबीम रोत आग, तुमाणू आन गंधक निहीतुतो. <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />तियांआं सोबीमेहें रोत निहींनारा तुमाणा वाअहीं, आगीवाअहीं आन गंधकोवाअहीं बाराने भाग माहें मोइत गोये. <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />काहाके तियां कोड़ाआ सेक्ती तियांआं सोबीम एतीज नाहां, तियांआं सेपटाम बी ओती; तियांआं सेपटे हापोअ होस ओते, तियांहां मुन्के बी ओते, आन तियां वाअहींज ते तारास देतेते.<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />बाकी रोल्ये माअहें जे यीं पिड़ा वाअहीं ने मोये, तें तियांआं आथोअ कामोअ वाखरी मोन ने फिरव्यो, तें पुतोंअ पुंजन कोअते रोये आन होना, सांदी, इसत्लेए, डोणोअ आन लाकड़ुउ देवताआ मुर्तीइ बी, जे नाहां पालीत सेकती, नाहां उनाइत सेकती, आन नाहां सालीत सेकती. <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />तियां कोअल्या खुन, जादू मंतर, सिनालो आन बांड्गायीइ बाप्तिम बी मोन ने फिरव्यो.<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s">देवदुत आन हानो पुस्तक</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />तिहींइं फासाड़ी आंय एका बिहीरा ताकतवाला देवदुतोहो जुगोम रोत उतरीइत्लाहा देख्यू. तो वादला वाअहीं टापाइत ओतू, आन तियाआ मुन्कापोअ बाण ओती आन तियाआ सोब दिहोअ होस सोमकीइतीते आन तियाआ गुडा आगीइ खांबाआ होस ओता. <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />तियाआ आथोमेहें एक हान्नो एवडोहो लेखल्यो पुस्तक ओतो; तिये तियाआ हाजाड़्यू गुडू दोर्‍यापोअ आन बांगाड़्यू गुडू धरतीपोअ मिक्यू, <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />तो सिहांआ होसे जाअखीलीही जोरे आअड़्यू; आन तो आअड़्यू तेहलामेहें हांत बाला तियां-तियांआं गाजीइलाआ आवाज काड्यू. <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />जेहेलाम हांतू बाला आवाज आयू, ताहां आंय लेखनारुज ओतू; पोन आंय जुगोम रोत एक आवाज एहें कोत्लाहा उनाअयू, “हांत बालाआ संदेश सिक्कु मारीत निकाड़ीत मिक; तियाहा मा लेखीही.”<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />जिया देवदुतोहो दोर्‍यापोअ आन धरतीपोअ उबा रोल्याहा आंय देख्यू, तिये तियाआ हाजाड़्यू आथ जुगोअहें उसू कोअयू, <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />आन जो हादाजलम जिवतु होय, जिये जुग आन जो किबी तियामेहें होय, धरती आन जो किबी तियीपोअ होय, आन दोर्‍या आन जो किबी तियामेहें होय, तियाहा बोणावयोहो; तियाआ शप्पत खात कोइत देवदुते ओं कोयो, “ओमे जारिक बी वाआ ने लागे; <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />जेदिहीं हांतवा देवदुतोअ तुरी फुकाय, तेदिहीं देवोअ निकाअली गोठी पुरी ओत जाय, जे तिये के तिये तियाआ सेवकोहो, मोन्ज्ये भविश्यवक्ताहां सुसना कोइत आप्यीते.”<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />जो आवाज आंय जुगोम रोत आवत्लाहा उनाअयुतो, तो आवाज तेहेलाम फाशुउ माहूं कोयो, “जा, जो देवदुत दोर्‍यापोअ आन धरतीपोअ उबु रोयुहू, तियाआ आथोम रोत उगाड़ल्यो पुस्तक मागीत ले.”<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />तियाहा काजे आंय देवदुतोअ जागे जात कोइत तियाहा रावणी कोअयी, के तो पुस्तक माहूं आपी दे. तिये कोयो, “ले, याहा खात्ले; ओं ताआ पेटोहो कोड़वो ते लागे, पोन ताआ सोबीही मोदोअ होस गुल्यो लागे.”<verse eid="REV 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10" />ताहरोअ आंय तो हानो पुस्तक देवदुतोअ आथोम रोत मागीत लेदो आन खात लेदो. तों माआं सोबीही मोदोअ होस गुल्यो लागो, पोन जाहां आंय तियाहा गिईंत लेदो, ताहां माआं पोटू कोड़वू ओत गोयू. <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />ताहां माहूं ओं कोयो, “ताहूं जाअखिलाहा माअहुंउं, देसोअ, हारेक बाशा गोगनारे आन राजाहांआं बाप्तिमेहें भविश्यवाणी कोअहूं पोड़े.”<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s">बेन साक्शीदार</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />फाशोअ कोडे तेबी माहूं मापे तेहें काजे एक बुओं आप्यो, आन कोयो, “उठ आन देवोअ मंदिरोअ, देवान्याहां आन तिहींइं भक्ती कोअनाराहा मापीत ले. <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />पोन मंदिरोअ बाअथेए खोली रोअहूं देजी, तियाहा मा मापीही; काहाके तो जागू पारका माअहुंउं ताबे कोइ देदुहू, आन तें सोका होयरोहो बेशाड़ीस मोयना जाआं खुंदरे. <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />आंय माआं बेन साक्शीदारोहों मोकलिहीं, ते गोंठो फांगीत कोइत बारा होवेन साट दिही जाआं देवोअ संदेश कोत आपे.”<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />ए साक्शीदार तेज जेयतुनोअ ते बेन साड़े आन बेन दिवा होय, जे धरतीइ मालख्योअ सामने उबा रोताहा. <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />जर एखू तियां साक्शीदारोअ नुकसान कोअहूं होदेहे, ताहां तियांआं मुखोम रोत आग निहेंहे आन ते तियांआं दुस्मोनोहों आरवीत टाकेहे; जो कोडो यांहां तारास देएलाआ इश्शा कोअहे, तियाहा एहेंज कोइत मोअहूं पोड़े. <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />तियांआं भविश्यवाणीइ दिहोमेहें वोऱ्हात ने पोड़ुहूं जोवे काजे जुग बोंद कोइलाआ तियांहां ओ आधिकार होय. यांहां पाअयोंहों रक्तामेहें बोदलीइलाअ आन जाहां जाहां यांहां जोवे, ताहां ताहां धरतीपोअ वोडी मोराय मोकलीइलाअ आधिकार होय.<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />जाहां ते तियांआं साक्शी आपी देय, ताहां उंडा खायाराम रोत उपोअ निहीनारो जनवार तियांअरी लड़ाय कोए आन तियांहां हारवीत कोइत माईं देय.<note caller="+" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="DAN 7:7">दानि 7:7</ref>,<ref loc="DAN 7:21">21</ref>; <ref loc="REV 13:5-7">प्रगटी 13:5-7</ref>; <ref loc="REV 17:8">17:8</ref> </char></note> <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />तियांआं तोड़ तिया वोडा होयरोअ सोवक्ड़ीमेहें पोड़ीत रोये, जे आत्मिक अर्थावाअहीं सदोम आन मिसर कोतेहे, आन जिहीं यांआं प्रभुहू क्रुसोपोअ टांग्युतो. <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />साड़े तीन दिही जाआं हारेक जातीइ, कुल, बाशा आन देसोअ आखे माअहें तियांआं तोड़ पाले आवे, आन तियांआं तोड़ोहो ओजीइलाअ परवानगी ने आपे. <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />यां बेन जोंअ मोत पालीत धरतीपोर्‍येए माअहें खुस ओवे, मोज्या कोए आन एका-मेकाहा भेट मोकले, काहाके तियां भविश्यवक्ता धरतीपोअ रोनाराहा तारास कोआड़्या कोअताते. <verse eid="REV 11:10" /><verse number="11" style="v" sid="REV 11:11" />साड़े तीन दिहोअ फासाड़ी देवोअहीं रोत तियां बेनुमेहें जिवनोअ हावा आयी, आन ते जिवीत उठ्या, ताहरेए तियांहां देखनारे आखे जुदे बित गोये. <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />ताहां तियांहां जुगोम रोत एक आवाज एहें कोत्लाहा ते उनाअया, “इंहीं उसे आव,” आन तियांआं दुस्मोनोअ देखताइज वाद्लापोअ बोहीत जुगोम जाता रोया. <verse eid="REV 11:12" /><verse number="13" style="v" sid="REV 11:13" />तेहेलाजमेहें वोडो बी भुकंप ओवयो, आन होयरोअ दाहवू भाग खेकराइत गोयू; आन हांत हाजार माअहें मोइत गोये, आन रोल्ये माअहें बित कोइत होरगामेर्‍याआ देवोअ महिमा कोअयी.<verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />दुसरी पिड़ा वितीत गोयी; आन तिसरी पिड़ा वेगीज आवनारी होय.<verse eid="REV 11:14" /></para>
  <para style="s">हांतवी तुरी</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />जाहां हांतवे देवदुते तुरी फुक्यी, ताहां होरगामेहें रोत आवाज आवेहे, जो वोडा आवाजोमेहें कोहें: “यी दुन्याआं राज्य आमाआं प्रभुउ आन तियाआ ख्रिस्ताआ राज्य बोणीत गोयोहो, आन तो तियापोअ हादाजलम राज कोए.” <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />शोवीस डायहां, जे देवोअ सामने तियांआं राजगादीपोअ बोहीत रोयाहा, उब्डा पोड़ीत आन एहें कोत देवोअ आराधना कोआ वोल्या,<verse eid="REV 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 11:17" />“ए प्रभु, आखाम रोत वोडी ताकतवाला देवा, जो होय, जो ओतू, आमू ताआ आभार मानतेहें,</para>
  <para style="q1" vid="REV 11:17">काहा के ताआ वोडी ताकत तू लेत लेदीही</para>
  <para style="q2" vid="REV 11:17">आन तूमे ताआ राज वापरीइलाआ सुरुवात कोअयीही.<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />आखी जातीइ माअहुंहूं खोत लागी,</para>
  <para style="q2" vid="REV 11:18">पोन ओमे ताआ खोत कोइलोअ वेल आवीत लागीही.</para>
  <para style="q2" vid="REV 11:18">मोल्याआं न्यायनिवाड़ु कोइलाआ वेल आवित लागीही,</para>
  <para style="q1" vid="REV 11:18">आन ताआ सेवक, भविश्यवक्ता</para>
  <para style="q2" vid="REV 11:18">आन ताआ पवित्र माअहें,</para>
  <para style="q2" vid="REV 11:18">आन ताआ नावोअ बिक मिकीत सालनारे हाना वोडाहां इलाम आपिलोअ वेल आवित लागीही,</para>
  <para style="q1" vid="REV 11:18">आन धरतीही बिगाड़नाराहां आरवीइलाअ वेल आवित लागीही!”<verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />ताहां होरगामेहें देवोअ मंदिर उगड़ीत गोयो, आन मंदिरोमेहें तियाआ वायदाअ पेटी देखाअयी; आन विजल्योन गाज्यो, वोडु तुदड़ाआ आवाज आयु, भुकंप ओवो, आन वोडे-वोडे गारे पोड़्ये.<note caller="+" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="REV 8:5">प्रगटी 8:5</ref>; <ref loc="REV 16:18">16:18</ref>,<ref loc="REV 16:21">21</ref> </char></note><verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s">बोईं आन अजगर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />ताहरोअ होरगा मेहें एक वोडी बी निशाणी देखाअयी, ते ए के एक बोईं देखाअयी, ते दिहोअ उजालो फांगीत ओती आन तियीइ गुडाआ निसे सांद आन तियीइ मुंडोपोअ बार ताराआ टोपू ओतू. <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />ते पोटावाली बोईं ओती आन वेणे देत ठाल्ली पोड़ीइलाआ कोअते आअड़ीतीते.<verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />होरगामेहें बिहीरी एक निशाणी देखाअयी ते ए; पाला, एक वोडू बी रात्लू अजगर देखाअयू, तियाहा हांत मुन्के आन दोहो हिंगे ओते आन तियाआ मुंडोपोअ हांत टोपा ओता. <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />तिया अजगरोअ सेपटी जुगोमेर्‍याआ तारामेहें रोत बाराने भागोहो ओदारीत पाड़ीत धरतीपोअ टाकी देदा, ते बोईं ठाल्ली पोड़े, ताहां तियीइ पोर्‍याहा खात जाअलोअ कोअते तो अजगर तियी बोईंइ आगाड़ी उबू रोयू. <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />आखा देसोपोअ लोड़ाआ डेंगारा वाअहीं राज कोए, एहेलाहा पोर्‍याहा तियी जल्म आप्यो; पोन तिया पोर्‍याहा आखलीत कोइत देवोअ जागे आन तियाआ राजगादीइ जागे पोताड़ी देदू. <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />ताहरीइ ते बोईं रानोमेहें नाहींत गोयी, तिहीं तियीही बारा होव साट दिही वारुहूं रोय तेहें काजे देवे एक जागू तियार कोअयुतो.<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />फाशीइ होरगामेहें लड़ाय ओवी, मिखाएल आन तियाआ देवदुत अजगरोअरी लड़ाय कोइलाअ काजे निहींया, आन तियाअरी अजगर आन तियाआ दुत लड़ाय कोअयी; <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />पोन ते तियांआं आगाड़ी टिकीत ने सेका, आन होरगामेहें तियांआं कोअते किज जागू नाहां रोयू. <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />ताहां तिया वोडा जुना हापोहो, जियाहा आरोप लागाड़नारु सैतान कोतेहे, तो आखी दुन्याहां भटकाड़ेहें, तियाहा तियाआ दुतोअरी धरतीपोअ आस्टी देदू.<note caller="+" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="GEN 3:1">उत्प 3:1</ref>; <ref loc="LUK 10:18">लुक 10:18</ref> </char></note><verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />आंय होरगामेहें एका जोअहों वोडा आवाजोम एहें कोत्लाहा उनाअयू, “ओमे आमाआं देवोअ तारण, ताकत, राज्य आन तियाआ ख्रिस्ताआ आधिकार देखाअयुहू, काहाके आमाआं पाव्हीइलापोअ आरोप लागाड़नाराहा निसे टाकी देदुहू, जो रातेन दिही आमाआं देवोअ सामने तियांपोअ आरोप लागाड़्या कोअतुतो.<note caller="+" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="REV 11:15">प्रगटी 11:15</ref>; <ref loc="JOB 1:11">इयोब 1:11</ref>; <ref loc="ZEC 3:1">जख 3:1</ref> </char></note> <verse eid="REV 12:10" /><verse number="11" style="v" sid="REV 12:11" />तें मेडाअ रक्तावाअहीं आन सोताआ साक्शीइ वसनोवाअहीं सैतानोहो हारवी देदू, काहाके तियां सोताआ जिवोहो मेर ने कोअयी, पोन मोत बी वेठीत लेदो. <verse eid="REV 12:11" /><verse number="12" style="v" sid="REV 12:12" />तियाहा काजे होरगो आन तियाम रोनारे खुशी कोआ; पोन ए धरती आन दोर्‍या तुमाआ केतीही विते! काहाके सैतान माआं थोड़ीज वेल रोयीही, ओं जाइंत कोइत जुदी खोतेम आन कावराअतुज तुमाआं जागे उतरीत आयुहू.”<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />अजगरोहो मुंदू गोयू के तियाहा निसे धरतीपोअ आस्टी देदुहू, ताहरुउ तो तियी बोईंइ फाट लागू, जियी तिया पोर्‍याहा जल्म आप्योतो. <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />तियी बोईंहीं वोडा मोरागाआ फाके आप्ये, ताहरीइ ते तियां फाका वाअहीं देवे वारुहूं रोय तेहें काजे बोणावल्या जागामेहें उडीत जाती रोय, जिहीं तियीही साड़े तीन वोरह्ये अजगरोअ दाके मिक्यीते. <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />तिये अजगरे तियी बोईंहीं वोहाड़ीत लेत जाय एहेलोहो नोयीइ होसर्‍योअ पाईं तियीइ फासाड़ी तियाअ सोबीम रोत सोड़ी देदो. <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />पोन धरती तियी बोईंइ मदत कोअयी, आन तियीइ सोब उगाड़ीत कोइत तियी नोयीही पीत गोयी, जे अजगरे तियाआ सोबीवाअहीं वोहाड़्यीते. <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />ताहां अजगरोहो तियी बोईंपोअ जुदी खोत लागी आन देवोअ आदेश पालन कोअनारा आन ईसुउ बाप्तिमेहें आपल्यी साक्शीपोअ मजबुत रोनाराअरी, तो लढ़ाय कोउ गोयू. <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />आन तो दोर्‍याआ रेटापोअ जात उबू रोयू.<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s">बेन जनवारे</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />ताहां आंय दोर्‍याम रोत उपोअ आवत्लाहा एका जनवारोहो देख्यो, तियाआ दोहो हिंगे आन हांत मुनके ओते. तियाआ हिंगोपोअ दोहो टोपा ओता आन तियां आक्खा हिंगोपोअ देवोअ निंदाआ नावे लेखल्ये ओते.<note caller="+" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="DAN 7:3">दानि 7:3</ref>; <ref loc="REV 17:3">प्रगटी 17:3</ref>,<ref loc="REV 17:7-12">7-12</ref> </char></note> <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />आंय जिया जनवारोहो देख्यो, तो बिलाड़्या वागोअ होस ओतो पोन तियाआ गुडा आसालाआ गुडाअ होस आन मुख सिहांआं सोबीइ होस ओतो,<note caller="+" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="DAN 7:4-6">दानि 7:4-6</ref> </char></note> आन तिये अजगरे तियाआ ताकत, तियाआ राजगादी आन वोडू आधिकार तियाहा आपी देदू. <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />आंय तियाआ मुंडोमेहें एक एहेलोहो दुखाअलो देख्यो, आन तो मोइत जाय एहेलोहो ओतो, पोन तियाआ तो दुखाअलो हाजो ओत गोयो, पुरी धरतीइ माअहें बोगलाइत कोइत तिया जनवारोअ फासाड़ी जाने वोल्ये. <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />माअहें तिया अजगरोअ पागे पोड़्ये, काहाके अजगरे तिया जनवारोहो तियाआ आधिकार आपी देदुतो, तें माअहें एहें कोत कोइत तिया जनवारोअ बी पुज्या कोअयी, “या जनवारोअ हारको कोडो होय? कोडो याअरी लड़ाय कोइत सेकेहे?”<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />आन तिया जनवारोहो लोफाट्यी गोठी, आन विणलाज्यी गोठी कोइलाअ सोब आप्यीते; आन तियाहा ओं कोइलाअ बेशाड़ीस मोयना आधिकार आप्युतो. <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />तिये देवोअ अपमान कोइलाअ आन तियाआ नावोअ, तियाआ रोअलाअ जागा आन तियां माअहुंउं निंदा कोउ वोल्यू, जे होरगाम रोतेहे. <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />तियाहा पवित्र माअहुंउं आरी लड़ाय कोइलाअ आन तियांहां हारवीइलाअ आदेश मिल्यू, आन तियाहा हारेक कुल, माअहें, बाशा आन देसोपोअ आधिकार जोड़्यू. <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />जियांआं नावे कोल बोणावीइलोअ पेल गाराहा ओवल्या मेडाअ जिवनोअ पुस्तकोमेहें नाहां लेख्ये, एहेलेहे धरतीपोअ रोनारे आक्खे माअहें तिया जनवारोअ पुंजन कोए.<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />जियाआ कान ओय, तो उनाय. <verse eid="REV 13:9" /><verse number="10" style="v" sid="REV 13:10" />जियाहा जेलेमेहें जाअलोअ ओय, तो जेलेमेहें जाय; जो तारवाइ वाअहीं माए, तियाहा बी तारवाइ वाअहीं माईं देवाय. ओमे पवित्र माअहुंउं धिर आन विश्वासोअ वेल होय.<verse eid="REV 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />एका बिहीरा जनवारोहो धरतीमेहें रोत निहीत्लाहा आंय देख्यो, तियाआ मेडाअ हिंगोअ होस बेन हिंगे ओते, आन तो अजगरोअ होस गोगतोतो. <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />तो तिया पेल्लाआ जनवारोअ आखु आधिकार तियाआ सामने कामे लागाड़तुतो; तो धरती आन तियीमेहें रोनाराहा पेल्लाआ जनवारोअ भक्ती कोआड़तुतो, जियाआ मुंडोम दुखतो निहींयोतो, पोन तों दुखतो हुदरीत गोयोतो. <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />तो जुगोम रोत धरती पोअ आग पाड़त्लू, एताहा वोडा समत्कार माअहोंअ सामने देखाड़तुतो. <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />जनवारोअ सामने तियाहा जियां समत्कारोहो देखाड़ीइलाअ आदेश जोड़्युहू, तियां समत्कारोवाअहीं तो धरतीपोर्‍याआ रोनाराहा भटकावेहे. आन धरतीपोअ रोनाराहां कोहे के जिया जनवारोहो तारवाअ वाज्यीते तों जिवीत गोयोहो, तियाआ मुर्ती बोणावा. <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />तियाहा जनवारोअ मुर्तीमेहें जिव टाकीइलाआ आदेश मिल्यू, के ते मुर्ती गोगीत सेके आन तियां आखा माअहुंहूं माईं देये, जे तिया जनवारोअ भक्ती ने कोए. <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />तिये जनवारे हाना-वोडा, गरीब, कुन्बी, मालिख, पावर आखा माअहुंहूं तियांआं आथोपोअ नेत निंडाअ पोअ निशाणी कोआड़े. <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />जियापोअ ते निशाणी जनवारोअ नाव नेताहां तियाआ नावोअ आकड़ू ने ओय, तो लेणो-देणो ने कोइत सेके.<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />इंहीं ओकलेए काम होय; जियाहा बुद्दी होय, तों जनवारोअ नावोअ आकड़ू काडुहूं जोवे; काहाके तो एखा माअहुंउं नावोअ आकड़ू होय आन तियाआ आकड़ू सोव होव साहासाट होय.<note caller="+" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="REV 17:9">प्रगटी 17:9</ref></char></note><verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">मेडू आन तियाआ माअहें</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />आंय फाशोअ देख्यो, मेडू सियोन डोगोपोअ उबू रोत रोयुहू, तियाअरी एक लाख शोवरेशाड़ीस हाजार माअहें होय, जियांआं निंडाअ पोअ तियाआ नाव आन तियाआ आब्हाअ नाव लेख्योहो.<note caller="+" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EZK 9:4">यहे 9:4</ref>; <ref loc="REV 7:3">प्रगटी 7:3</ref> </char></note> <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />आंय जाअखीलीही जोरे वोहनारा खाडीइ पाअयोंअ आन जाअखीलीही जोरे गाजीइलाअ आवाज होरगामेहें उनाअयू, आन जो आवाज आंय उनाअयू तो तंबिवरो वाजाड़नाराआ आवाजोअ होसे ओतू. <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />तें माअहें राजगादीइ सामने, शार जनवारोअ आन डायहांआं सामने एक नोवो गित गावतेते. तियां एक लाख शोवरेशाड़ीस हाजार माअहुंउं सिवाय, जे धरती पोअ वेसाते लेदेते, बिहीरो कोडोज तो गित नाहां सिकाइत सेको. <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />एं माअहें बोईंइरी नाहां सुके, एं कुवांरे होय; जिहीं काबी मेडू जाहे, तें तियाअरी सालतेहे; देवोअ आन मेडाअ काजे पेल्लाआ फलोअ होस तियांहां वेसाते लेदेहे. <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />तियांआं सोब खोटो नाहां गोग्यी, ते निर्दुस होय.<verse eid="REV 14:5" /></para>
  <para style="s">तीन देवदुत</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />फाशुउ आंय एका देवदुतोहो जुगोम रोत उतरीइत्लाहा देख्यू, आन तियापोअ धरतीपोअ रोनारा हारेक देस, कुल, जाती-जातीइ बाशा गोगनाराआ आन माअहुंउं काजे तियापोअ एक हादाजलम्यीइ हाजी बातमी ओती. <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />तिये वोडा आवाजोमेहें कोयो, “देवोहो बिवा, आन तियाआ महिमा कोआ, काहाके न्यायनिवाड़ाआ दिही आहने आवीत लागुहू; जिये होरगो, धरती, दोर्‍या आन पाअयोंअ उकला बोणावया, तियाआ आराधना कोआ.”<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />तियाआ फाटी एक बिहीरु देवदुत आवयू आन कोनु वोल्यू, “तो आरवाइत गोयोहो, आन बाबेल वोडो होयर आरवाइत गोयोहो, तिये आखा देसोहो तियाआ सिनालोअ जास्ती माणू दाराक्शाआ रोह पिवाड़्युतो.”<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />फाशुउ तियाआ फाटी एक तिसरु देवदुत आयु आन तो वोडा आवाजोम कोनु वोल्यू, “जर एखू जनवारोअ नेताहां तियाआ मुर्तीइ भक्ती कोए आन तियाआ निंडाअ पोअ नेत आथोपोअ तियाआ निशाणी लागाड़े, <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />ताहां तियाहा देवोअ खोतेए दाराक्शाआ रोहो पिवाड़ाय, तो कोरु रोहो, तियाआ खोतेए गिलासोमेहें ओल्युहू. आन तो पवित्र देवदुतोअ आन मेडाअ हुंबर आगीइ आन गंधकोअ पिड़ामेहें पोड़े. <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />जे माअहें जनवारोअ नेत तियाआ मुर्तीइ आराधना आन तियाआ नावोअ निशाणी लागाड़तेहे, तियांआं पिड़ाआ तुमाणू कायम उसे उड्तू रोय; आन तियांहां रातेन दिही जोलोम होक ने आवे.”<verse eid="REV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12" />ओमे पवित्र माअहुंउं धिरोअ वेल होय, जे देवोअ आदेशोअ पालन कोअतेहे आन ईसु मेहें विश्वासोम मजबुत रोतेहे.<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />आंय होरगामेहें कोडाहा माहूं एहें कोत्लाहा उनाअयू, “लेख: धन्य होय तें मोअनारे, जें ओमे रोत देवोमेहें विश्वास मिकीत मोअतेहे!” आत्मा कोहे, “होव! काहाके तियांहां कामोम रोत आराम जोड़ुहूं जोवे, तियांआं कामे तियांअरी जातेहे.”<verse eid="REV 14:13" /></para>
  <para style="s">धरतीइ वाडीइलोअ दिही</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />आंय पाल्यो के माहूं एक पांडो वादलो देखाअहे, तिया पोअ माहुंउं बेटुह्हू जेहें कोडो तेबी बोहीत रोयोहो,<note caller="+" style="x"><char style="xo" closed="false">14:14 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानि 7:13</ref> </char></note> आन तियाआ मुन्कापोअ होनाआ टोपू होय आन तियाआ आथोमेहें एक वाडालू दात्लू होय. <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />फाशुउ एक बिहीरु देवदुत मंदिरोमेहें रोत निहित, आन वोडा आवाजोमेहें आअड़ीत कोइत वादला पोअ बोहनाराहा कोहे, “ताआ दात्ला वाअहीं वाड, काहाके वाडीइलोअ वेल आवीत लागीही, आन धरतीइ कामाय पाकीत गोयीही.” <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />वादला पोअ बोहनारे तियाआ दात्ला वाअहीं धरती पोअ वाडीइलोअ सुरवात कोअयी, आन आखी कामाय वाडाइत गोयी.<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />ताहरुउ एक देवदुत होरगाआ मंदिरोमेहें रोत निहयू, तियापोअ बी एक वाडालू दात्लू ओतू.<verse eid="REV 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18" />जियाहा आगीपोअ आधिकार ओतू एहेलुहू एक देवदुत देवान्यामेहें रोत निहयू; तिये जियापोअ वाडालू दात्लू ओतू तियाहा तिये जोरे आवाजोमेहें कोयो के तू ताआ वाडाली तारे वालू दात्लू सालाड़ीत धरतीइ दाराक्शाआ गुमसू तोड़ीत ले; तियांआं दाराक्शे पाकले होय. <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />ताहां तिये देवदुते तियाआ दात्लू धरतीपोअ सालाड़्यू आन दाराक्शाआ गुमसा तोड़ीत देवोअ खोतेए दाराक्शाआ कुंडामेहें टाक्या. <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />होयरोअ बारथे दाराक्शाआ कुंडामेहें गुमसा पेएसी देदा; तियांमेहें रोत जों रक्त वोहयो तों कोड़ाआ लगामोअ जागे जाआं पोतो, मोन्ज्ये एक होव कोस एतीही सेटे वोहीत गोयो.<note caller="+" style="x"><char style="xo" closed="false">14:20 </char><char style="xt" closed="false"><ref loc="ISA 63:3">यश 63:3</ref> </char></note><verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s">आखरीइ हांत पिड़ा आन वाटी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />फाशुउ आंय जुगोमेहें एक वोडी निशाणी देख्यी, मोन्ज्ये हांत देवदुत जियापोअ हांत आखरीइ पिड़ा ओती, काहाके देवोअ खोत तिहीं रोत सेलाइत जानारी ओती.<verse eid="REV 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2" />आंय जेहेलाम पाल्यो, ताहां एक आग पेलीत मिकल्यू दोर्‍या देख्यू; आन जें माअहें तिया जनवारोपोअ, आन मुर्तीपोअ तियाआ नावोअ आकड़ाहा जिकीत गोयेते, तें तिया खासोअ होसऱ्याआ दोर्‍याअ जागे, देवोअ आपल्यो तंबिवरो लेत कोइत उबे रोत रोयेते. <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />तें देवोअ सेवक मोशेए गित, आन मेडाआ गित गावीत कोइत कोतेते:</para>
  <para style="q1" vid="REV 15:3">“आखाम रोत वोडी ताकतवाला प्रभुदेवा,</para>
  <para style="q2" vid="REV 15:3">ताआ कामे वोडे आन बोगलाइत जाय एहलेहे होय!</para>
  <para style="q1" vid="REV 15:3">आखा देसोअ राजा,</para>
  <para style="q2" vid="REV 15:3">ताआ वाट हाजी आन खोरी होय.<note caller="+" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="EXO 15:1">निर्ग 15:1</ref> </char></note><verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />प्रभु, कोडो ताहूं ने बिनारो?</para>
  <para style="q2" vid="REV 15:4">कोडो ताआ नावोअ महिमा ने कोअनारो?</para>
  <para style="q2" vid="REV 15:4">काहाके तुज पवित्र होय.</para>
  <para style="q1" vid="REV 15:4">आन ताआ सती कामे प्रगट ओवेहे,</para>
  <para style="q2" vid="REV 15:4">तियाहा कोत आखे राश्टे ताआ सामने आवीत,</para>
  <para style="q2" vid="REV 15:4">ताआ भक्ती कोए.”<verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />तिहीं फासाड़ी आंय पाल्यो, ताहां साक्शीइ मंडपोअ होरगामेर्‍योअ मंदिर उगड़्यो; <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />आन तिया मंदिरोमेहें रोत हांत देवदुत बाअथे निहींया; तियांपोअ हांत पिड़ा ओती. सोत्राले आन सोमक्ये आंगड़े पोवीत आन सातीपोअ होनाआ पोट्टा बांदीत ओता. <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />ताहां तियां शारु जनवारोमेहें रोत एके जोएं हादाजलम जिवता रोनारा देवोअ खोतेए वाअहीं पोअल्या हांत होनाअ वाटका तियां हांत देवदुतोहो आप्या; <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />देवोअ महिमा, आन ताकत वाअहीं मंदिर तुमाणा वाअहीं पोआत गोयू; आन तियां हांत देवदुतोंअ हांत पिड़ा ने सेलाअयी ताअहूं जाआं कोडो बी मंदिरोमेहें ने जात सेको<note caller="+" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ISA 6:4">यश 6:4</ref></char></note>.<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s">देवोअ खोतेए वाटकू</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />ताहां आंय मंदिरोमेहें रोत एक वोडु आवाज उनाअयू; तो तियां हांत देवदुतोहो कोहे: “जावा देवोअ खोतोअ हांत वाटका धरतीपोअ रेसवी द्या.”<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />तेहलाम पेलठु देवदुत जात कोइत तियाआ वाटकु धरतीपोअ रेसवी देदू. आन जियां माअहुंउं पोअ तिया जनवारोअ निशाणी ओती आन जे तियी मुर्तीइ पागे पोड़तेते, तियांआं डिलो पोअ एकी जातीइ खाराब आन सिसड़ाअलाहा फोड़क्या निहीया.<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />बिहीरे देवदुते तियाआ वाटकु दोर्‍यामेहें रेसवी देदू. ताहां दोर्‍यामेहें मोल्‍या माअहुंउं रक्‍ताआ होस ओत गोयो, आन तिया मेर्‍येए आखे जिवजंतु मोइत गोये.<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />तिसरे देवदुते बी तियाआ वाटकु खाडीइ आन पाअयोंअ उकलामेहें ओली देदू आन तें रक्त बोणीत गोये. <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />तेहेलामेहें आंय पाअयोंअ देवदुतोहो एहें कोत्लाहा उनाअयू, “पवित्र, जो होय, जो ओतु, जो तू न्यायी होय, आन तुमेज ओ न्यायनिवाड़ू कोअयुहू! <verse eid="REV 16:5" /><verse number="6" style="v" sid="REV 16:6" />काहाके तियां देवोअ माअहोंअ आन देवोअ भविश्यवक्ताआं रक्त वोहाड़्योतो, आन तू तियांहां रक्त पिवाड़्यो; काहाके तें यी लायकीइ होय.” <verse eid="REV 16:6" /><verse number="7" style="v" sid="REV 16:7" />फाशोअ आंय देवान्याअहीं रोत एहें कोत्लाहा उनाअयू के “होव, ए प्रभु देवा, वोडी ताकतवाला देवा, ताआ न्‍यायनिवाड़ु खोरु आन हाजू होय.”<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />सौथे देवदुते तियाआ वाटकु दिहोपोअ ओली देदू, आन तियाहा आगी वाअहीं माअहुंहूं पुजीत टाकीइलाआ अधिकार आप्यू. <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />आन मांअहें दिहोअ तोपोवाअहीं पुजाइत गोये. ताहां तियी पिड़ा पोअ जियाहा आधिकार होय, तिया देवोअ नावोअ तियां निंदा कोअयी आन देवोअ नावोअ महिमा कोइलोअ कोअते मोन ने फिरव्यो.<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />पासवे देवदुते तियाआ वाटकु जनवारोअ राजगादीपोअ ओली देदू, ताहां तियाआ राज्याहा आंदारे टापित लेदो, आन तियांआं दुखोअ वोजेसे जिव जिवोअ जिबीही सावे वोल्ये. <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />तियांआं दुखोअ आन फोड़क्‍याआं वाखरी तियां होरगामेर्‍याआ देवोअ निंदा कोअयी; पोन तियांआं सोताआ खाराब कामोंअ बोदले मोन ने फिरव्यो.<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />साहावे देवदुते जाहां तियाआ वाटकु वोडी फरात नावोअ खाडीपोअ रेसवी देदू, ताहां तियी खाडीइ पाईं आटाइत गोयो, याआ कोअता के दिही उगताआ वोल रोत आवनारा राजाअ कोअता वाट बोणुहूं जोवे. <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />ताहां आंय तिया अजगरोअ सोबीमेहें रोत, आन तिया जनवारोअ सोबी मेहें रोत, आन तिया ठोग भविश्यवक्ताआ सोबीमेहें रोत तिन एठा आत्माहां डेट्काआ रुपोमेहें निहींत्‍लाहा देख्‍यो. <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />काहाके एं समत्कार देखाड़नारे पुतोअ आत्मे होय, जे आखी कोलीपोर्‍याआ राजहांअ जागे याअ काजेहे निहीत जातेहे के तियांहां वोडी ताकतवाला देवोअ वोडा दिहोअ लड़ायीइ काजेहे एकठा कोए.<verse eid="REV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15" />“पाला, जेहें कोइत बांड आवेहे तेहेंज कोइत आंय आवोहो; आन उगड़ाअला एहेलाहा मा सालहा, पोन तुमांआं लाज माअहुंहूं ने देखाअहूं जोवे, तियाहा कोत जो जागतू रोय, आन तियाआ आंगड़े पेवित रोय तो धन्य होय!”<verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />ते आत्में तियां राजहांहां इब्री बाशामेहें अरमोगिदोन कोतेहे तिया जागापोअ एकठा कोअया.<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />हांतवे देवदुते तियाआ वाटकु वारामेहें रेसवी देदू, ताहां मंदिरोमेहें रोत राजगादी पोअ रोत एक वोडूबी आवाज निहीयु तिये कोयो के, “पुरो ओत गोयो.” <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />ताहां विजल्‍यो, बाला गाजा वोल्या, आन जोरे बी धरती आल्यी, ते एतीही जोरे आल्यी के जोयोंअ रोत माहुंउं धरतीपोअ आयो, तोयोंअ रोत एहेलोहो केदिहींज नाहां ओवो. <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />यावाअहीं तिया वोडा होयरोअ तिन डुन्का ओत गोया, आन राज्या राज्यामेहें होयरे ओदरात पोड़्ये आन देवे वोडा बाबेल होयरोअ ओर कोअयी के तो खोतेए बाल्लायी वाअहीं दाराक्शाआ रोहो पिवाड़े. <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />आन आखा दोर्‍या मेर्‍याआ डोगोअ पोड़ीत गोया, आन डोगोअ नाव निशाणीज ने रोया. <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />जुगोमेहें रोत एक मोण वजनोवाले गारे माअहूं पोअ पोड़्ये, ताहां गाराआ पिड़ा आवल्यी कोत माअहूं देवोअ निंदा कोअयी, काहाके तियां गाराआ पिड़ा खुब वोडी ओती.<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s">नावासी रांडी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />जियां हांत देवदुतों पोअ जे हांत वाटका ओता, तियांमेहें रोत एके जोएं आवीत माहूं एहें कोत कोयो, “एहें आव” आंय ताहूं तियी नावासी रांडीइ डोंड केहें कोइत ओवे तो देखाड़ोहो, वोडो सेर जो जाअखिलाहा पाअयोंपोअ बोठोहो. <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />तियीइरी धरती पोर्‍याआ राजाहां सिनालो कोअयो; आन तियीइ सिनालाआ दाराक्शाआ रोहो वाअहीं साकीत गोया.<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />ताहां तो माहूं आत्माम जंगलोमेहें लेत गोयू, आन आंय रात्ला रंगोअ जनवारो पोअ, जो निंदाआ नावो वाअहीं पोआलो ओतो आन तियाआ हांत मुन्के आन दोह हिंगे ओते, एकी बोईंहीं बोहीत रोल्यी देख्यी. <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />ते बोईं जामण्या रंगोअ आन रात्ला रंगोअ साअके पोवित ओती, होनो आन मोगला मोणक्या आन किमती डायमंड यावाअहीं होतरीइल्यी ओती, आन तियीइ आथोमेहें एक होनाअ वाटकू ओतु जो आखी खाराब वस्तू वाअहीं आन तियीइ आखी सिनालो गोठी वाअहीं पोआलु पियालू ओतु. <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />तियीइ निंडाअ पोअ वोडी बाबेल, आखा रांडाआ आन खाराब कामोंअ आयही ओं नाव लेखल्यो ओतो.<verse eid="REV 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 17:6" />आंय तियी बोईंहीं देवोअ माअहुंउं रक्‍तावाअहीं आन ईसुउ काजे साक्शीदारोअ रक्त पित कोइत मातीत रोल्यी देख्यी; तियीही पालित आंय बोगलाइत गोयु. <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />ताहां तिये देवदुते माहूं कोयो, “तु काहा बोगलाइत गोयू? आंय ताहूं यी बोईंइ आन तियीही डिलोपोअ बोहाड़ीत लेत फिरनारा जनवारोअ बाप्तिम आन जियाहा हांत मुनके आन दोहो हिंगे होय, तिया जनवारोअ निकाअली गोठ ताहूं कोत आपोहो. <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />जों जनवार तुमे देख्योहो, तों पेल ओतो पोन ओमे कायनाहां, आन तों उंडा खायाराम रोत निहींत कोइत आरवाइत जाय; आन धरतीपोअ तें रोनारे जियांआं नावे दुन्याआं बोणीलोअ पेल जिवनोअ पुस्तकोमेहें नाहां लेखाअये, जनवारोहो पालीत कोइत बोगलाइत जाय, काहाके तों ओतो आन ओमे कायनाहां आन फाशोअ आगाड़ी आवनारोहो.<verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />“इंहीं हुशार बुद्दीइ गरज होय, ते हांत मुनके एं हांत डोगोअ होय, जियांपोअ ते बोईं बोहयीही. आन ते मुनके बी हांत राजा होय. <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />आन हांत राजा होय, पास पोड़्याहा, एक होय आन बिहीरु फाशुउ नाहांजी आयू; आन तो आवे ताहां तियाहा थोड़ीज वेल रोअहूं पोड़े. <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />तों जनवार, जों पेल ओतो आन ओमे कायनाहां, तों आंठवो होय; पोन तो हांतू राजामेहें रोत बोण्युहूं आन तो आरवाइत जाय.<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />“तुमे जियां दोहो हिंगोहो देख्ये, ते दोहो राजा होय. याहां ओमे जाआं राज्य नाहां जोड़्यो, पोन तियांहां तिया जनवारोअरी तात्पुरतू राज्य कोइलाअ आधिकार जोड़े. <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />तियांआं एकूज विसार होय, के ते तियांआं ताकत आन आधिकार तियां जनवारोहो होपी देय. <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />ते मेडाअरी लड़ाय कोए, पोन मेडू तियांहां हारवी देय, काहाके तो देवोअ देव आन राजाआं राजा होय. मेडाअरी तियाआ फासाड़ी सालनारे बी जिकीत जाय; जें हादाअयेहे आन निवड़ाअयेहे आन इमानदार बी होय.”<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />देवदुते माहूं ओं कोयो, “तुमे जिया दोर्‍याहा देख्यू; जिहीं वोडी रांडी बोठीही, तिया दोर्‍याआ ओं अर्थ होय, माअहें, आखी जाती, देस आन आक्खी बाशा. <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />तुमे जियां दोहो हिंगोहो आन जनवारोहो देख्यो, तें रांडीही सीस कोए, आन तियीही नागरी कोइत एखलीहीज ओड़ीत काडे, तियीइ माहां खाये आन तियीही आगीम पेटाड़ी देय. <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />काहाके ते एक मोन ओवित कोइत देवोअ वसने पुरे ओवे ताअहूं जांआं तियाआ इश्शा पुरी कोइलाअ काजे तियांआं राज्य जनवारोहो आपे, ओं देवे तियांआं मोनोमेहें टाक्यो.<verse eid="REV 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18" />“तुमे जियी बोईंहीं देख्यी, तों एक वोडो होयर होय, जों धरतीइ राजहांपोअ राज कोअहे.”<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s">बाबेल होयर खेकराअयो</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />याआ फासाड़ी आंय एका बिहीरा देवदुतोहो होरगामेहें रोत उतरीइत्लाहा देख्यू. तियाहा वोडू आधिकार जोड़्युतो; आन धरती तियाआ उजालावाअहीं पुरी सोमक्यी. <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />तिये वोडा आवाजोमेहें आअड़ीत कोइत कोयो, “तों खेकराअयो! वोडो बाबेल होयर खेकराअयो! तो हारेक जातीइ पुतोअ आत्माआं हाड्डू, आन हारेक खाराब आन एठा सिड़ाआ हाड्डू बोणित गोयो. <verse eid="REV 18:2" /><verse number="3" style="v" sid="REV 18:3" />काहाके तियीइ सिनालाआ जास्ती नशावालू दाराक्शाआ रोहो आखा देशोवालां पिदुहू, धरतीइ राजाहां तियीइरी सिनालो कोअयोहो आन कोलीइ आखा वेपारी आखी बातीइ मोज्या कोइलाआ वस्तु वाअहीं कुन्बी बोणित गोयाहा.”<verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />माहूं होरगामेहें एक बिहीरु आवाज एहें कोत्लाहा आंय उनाअयु,</para>
  <para style="q1" vid="REV 18:4">“माआं माअहूं, वोडा होयरोम रोत निहींत आवा,</para>
  <para style="q2" vid="REV 18:4">एहेलोहो ने ओवुहूं जोवे के, तुमू तियाआ पापोमेहें भागिदार ओवहा,</para>
  <para style="q2" vid="REV 18:4">आन तियाआ पिड़ाआ भागिदार बोणित जाहा.<verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />काहाके तियाआ पापोअ टिग जुगोअ एतुहू उसू ओत गोयुहू,</para>
  <para style="q2" vid="REV 18:5">आन देवे तियाआ गुनाआं ओर कोअयीही.<verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />तिये वोडे होयरे जेहेलोहो कोअयो, तुमू बी तियाअरी तेहेलोज कोआ,</para>
  <para style="q2" vid="REV 18:6">तियाआ खाराब कामोअ दुप्पट बोदलू आपा,</para>
  <para style="q1" vid="REV 18:6">आन तिये जो गिलास बिहीराआ काजे पोअयुहू,</para>
  <para style="q2" vid="REV 18:6">तियामेहें तियाआज काजे दुप्पट पोई द्या.<verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />तिये जेती वोडाय कोअयी आन जेतीही मोज्यादान कोअयीही,</para>
  <para style="q2" vid="REV 18:7">तियाहा तेतुहू तारास आन पिड़ा आपा; तों तियाआ मोनोमेहें एहें कोहे,</para>
  <para style="q1" vid="REV 18:7">‘आंय राणीइ होस राजगादी पोअ बोठीही,</para>
  <para style="q1" vid="REV 18:7">आंय राणी बोणीत बोठीही,</para>
  <para style="q2" vid="REV 18:7">आंय रोंडोअ कायनाहां,</para>
  <para style="q2" vid="REV 18:7">आन केदिहीं विखु ने कोअनारी!’<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />तियाहा कोत तियीइ पिड़ा मोन्ज्ये मोत,</para>
  <para style="q2" vid="REV 18:8">दुख आन काल एकेज दिही आवीत पोड़े,</para>
  <para style="q1" vid="REV 18:8">आन तियीही आगीमेहें पेटाड़ी टाकीत देय,</para>
  <para style="q2" vid="REV 18:8">काहाके तियीइ न्यायनिवाड़ु कोअनारु प्रभु देव ताकतवालू होय.”<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />जाहां धरतीइ राजा, जियां बाबेलोअरी सिनालो आन मोज्यादान कोअयी, तों वोडो होयर पेटाइलाआ तुमाणू देख्यू, ताहराआ ते रोड़े आन विखु कोए. <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />ते तियाआ पिड़ाहा देखीत बित जाय आन एहें कोत सेटेज उबा रोये, “विखु! ताआ काजे विखु! ए वोडा होयर, सेक्तीवाला बाबेल होयर! ताहू ताब्बुड़ डोंड मिलीत गोयू.”<verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />धरतीपोर्‍याआ आखा वेपारी तियाआ काजे रोड़े आन विखु कोए, काहाके कोडोज फाशोअ तियाआ माल वेसातु ने लेय. <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />होनाआ, सांदीइ, हिराआ, रुपाआ, आन मोवेमोवेज, जामण्ये, रेशमी साअके, रात्ला रंगोअ आंगड़े; हाजे गोंदाण्ये हारेक जातीइ हाजे लाकड़े; आथीइ दात, मोगले लाकड़े, इसत्लेए वस्तु, लोड़ो, संगमरमरोअ हारेक जातीइ बासन; <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />आन दालसिनी, मासालो, हाजी गुंदाअनारी आगरबत्ती, तेल, ऊद, दाराक्शाआ रोहो, जेयतुन साड़ोअ तेल, हाजू लोट, गोंवें, वासड़ीन-बोलोद, मेडेन बोकड़े, कोड़ा, गाडे, पावर, आन माअहुंउं जिव ओ तियांआं माल कोडो ने लेय. <verse eid="REV 18:13" /><verse number="14" style="v" sid="REV 18:14" />तियाहा काजे वेपारी कोयो, “ओ वोडा होयर! ताहूं जों फल गोमतोतो, तों तारोत सेटे जातो रोयो, आक्खी होवादी आन खुसी आपनारी वस्तु आरवाइत गोयी. तु याहा फाशोअ ने देखीत सेकही!” <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />यीं वस्तुउ वेपारी, जे बाबेलोअ मोज्या कोइलाअ वस्तु वाअहीं कुन्बी ओत गोयाते, ते तियाआ पिड़ावाअहीं बित कोइत सेटेज उबा रोय, आन ते एहें कोत रोड़े आन विखु कोए.<note caller="+" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="EZK 27:31">यहे 27:31</ref>,<ref loc="EZK 27:36">36</ref> </char></note> <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />“आरेरे! पाला, ओं वोडो होयर मोवोमोवोज, जामण्या, रात्ला रंगोअ आंगड़ो पोवीत ओतो, आन होनाआ, हिराआ आन सांदीइ गोवणा वाअहीं हिक्राइत ओतो. <verse eid="REV 18:16" /><verse number="17" style="v" sid="REV 18:17" />तियीइ आखो मालधन एका तालोम उजड़ीत गोयो!” जाहाजीइ सालाड़नारा, जाहाजीम बोहनारे, जाहाजीइ देखबाल कोअनारे आन दोर्‍याअ वेपारी ए आक्खेज सेटेज उबे रोये,<note caller="+" style="x"><char style="xo" closed="false">18:17 </char><char style="xt" closed="false"><ref loc="ISA 23:14">यश 23:14</ref>; <ref loc="EZK 27:26-30">यहे 27:26-30</ref> </char></note> <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />आन तियाआ पेटाइलोअ तुमाणो देखीत कोइत जाअखीलीही जोरे कोने वोल्ये, “या वोडा होयरोअ बोराबरी कोडो कोइत सेके?” <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />ते तियांआं मुन्कापोअ तुलो टाकित कोइत, जाअखीलिही जोरे रोड़ते आन विखु कोअते जात एहें कोतेते, “ए केतीही दुखोअ गोठ होय! या वोडा होयरो पोअ! याआ मालधनो वाअहीं जाहाजीइ आखा मालिख कुन्बी बोणित गोया, ओं तालेकोज मेहें उजड़ीत गोयो.”<verse eid="REV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20" />ए होरगा, ए देवोअ माअहों, आन सेवकोहों, आन भविश्यवक्ताहां, खुसी कोआ, काहाके देवे तियाआ विरुद्दामेहें तियांहां न्याय आप्युहू.<verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />ताहरुउ एक ताकतेवालू देवदुत कोअटाआ वोडा पुड़ोअ होस एक वोडू डोण उसल्यू, तियाहा दोर्‍याम टाकी देदू आन कोयो, “वोडो होयर बाबेल एहेंज कोइत जुदी जोरे ओदरीत पोड़े आन फाशोअ तों केदिहीं ने देखाय. <verse eid="REV 18:21" /><verse number="22" style="v" sid="REV 18:22" />तंबिवरो वाजीइलोअ, आन गितार्‍याहां, पावी आन तुरीइ वाजाड़नाराआ आवाज तामेहें फाशुउ केदिहीं ने होंबलाय; तामेहें धंदा कोअनारा वेपारी फाशाअ केदिहीं ने मिले; कोअटी दोइलोअ आवाज तुमामेहें याआ आगाड़ी फाशुउ केदिहीं ने होंबलाय. <verse eid="REV 18:22" /><verse number="23" style="v" sid="REV 18:23" />दिवाआ उजालो तामेहें फाशोअ केदिहीं ने देखाय, आन वोर आन वोड़लीइ आवाज तामेहें फाशुउ केदिहीं ने होंबलाय, काहाके ताआ वेपारी धरतीपोअ वोडा पुडारी ओता, आन आखा देसोहों ताआ ठोगोअ ज्यादू वाअहीं भटकाड़्याहा!”<verse eid="REV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24" />बाबेलोमेहें भविश्यवक्ताआ, आन देवोअ माअहुंउं आन तियां आखा माअहुंउं रक्त सापड़्यो, जियांहां धरतीपोअ माईंत टाक्येते.<note caller="+" style="x"><char style="xo" closed="false">18:24 </char><char style="xt" closed="false"><ref loc="JER 51:49">यिर्म 51:49</ref> </char></note><verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />याआ फासाड़ी आंय होरगामेहें एका जाअखीलाहा माअहुंउं गोवाराआ होस वोडु आवाज एहें कोत्लाहा उनाअयु, “हालेलुया! तारण, महिमा आन ताकत आमाआं देवोओज होय. <verse eid="REV 19:1" /><verse number="2" style="v" sid="REV 19:2" />काहाके तियाआ न्याय खोरु आन हाजू होय. तिये तियी वोडी रांडीही डोंड आप्युहू, जे तियीइ सिनालावाअहीं धरतीही बिगाड़तीते, देवे तियाआ सेवकोंअ रक्ताआ वारी काड्यीही.” <verse eid="REV 19:2" /><verse number="3" style="v" sid="REV 19:3" />ते फाशेए बिहरीवारी कोयो, “हालेलूया! तियाआ पेटाअनारा होयरोअ तुमाणू पिढ़ीन पिढ़ी तुमाअतू रोय.” <verse eid="REV 19:3" /><verse number="4" style="v" sid="REV 19:4" />ताहराआ राजगादीपोअ बोठ्ला देवोअ सामने ते शोवीस डायहां आन तें शार जनवारे उब्डा पोड़ीत कोइत वोंदीत कोइत कोयो, “आमेन! हालेलुया!”<verse eid="REV 19:4" /></para>
  <para style="s">मेडाआ वेहवाल</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />याआ फासाड़ी राजगादीइहें रोत एक आवाज आंय एहें कोत्लाहा उनाअयु, “ए आमाआं देवोहो बिनारा आखा सेवकों, हानान वोडा तुमू आखा देवोअ स्तुती कोआ.” <verse eid="REV 19:5" /><verse number="6" style="v" sid="REV 19:6" />ताहां आंय जाअखीलाहा माअहोंअ गोवाराआ आवाज जेहें, दोर्‍याआ उपाड़ाआ जेहें आन गाजनारा वाद्ला आवाजोअ होस जेहें आवाज उनाअयु, तो एहें कोइत, “हालेलुया! काहाके आमाआं प्रभुउ आखाम रोत वोडु सेक्तीमान देव राज्य कोअहे. <verse eid="REV 19:6" /><verse number="7" style="v" sid="REV 19:7" />आपू सेकलाइत कोइत खुसी कोअहूं आन देवोअ महिमा गावुहूं, काहाके मेडाआ वेहेवालोअ दिही आवीत लागाहा, आन तियाआ वोड़ली सोताहा तियार ओत गोयीही. <verse eid="REV 19:7" /><verse number="8" style="v" sid="REV 19:8" />आन तियीही हाज्जेहे पांडे मोवे साअके फांगे तेहें काजे आप्ये, काहाके यां मोवा साअकाआ अर्थ ओं होय, देवोअ माअहुंउं हाजे कामे.”<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />आन तिये देवदुते माहूं कोयो, “ओं लेख, धन्य होय तें, जें मेडाआ वेहेवालोअ पांगातीमेहें हादाअयेहे,” आन फाशोअ तिये माहूं ओं बी कोयो, “ओं देवोअ सत्य वसन होय.”<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />ताहां आंय तियाआ भक्ती कोइलाअ काजे तियाआ गुडापोअ उठ्लीत पोड़्यू. पोन तिये माहूं कोयो, “एहें मा कोअही, आंय बी ताआ आन ताआ तियां पाव्हीइलाअ सेवक होय, जें ईसुउ आपल्यी साक्शी सांबालीत मिकतेहे. तु देवोहोज वोंदजी.”</para>
  <para style="p" vid="REV 19:10">काहाके ईसुउ साक्शी भविश्यवाणीइ आत्मा होय.<verse eid="REV 19:10" /></para>
  <para style="s">पांडा कोड़ापोअ बोहीत जानारु</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />ताहां आंय होरगो उगड़ीइल्यो पाल्यो, आन एक पांडू कोड़ु देखाअयू; तियापोअ जो बोठ्लू होय, तियाहा इमानदार आन खोरु कोतेहे; आन तो निती वाअहीं न्याय आन लड़ाय कोअहे.<note caller="+" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="EZK 1:1">यहे 1:1</ref>; <ref loc="PSA 96:13">भजन 96:13</ref>; <ref loc="ISA 11:4">यश 11:4</ref> </char></note> <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />तियाआ डोआ आगीइ हांगाड़ाआ होस आन तिया मुन्कापोअ जाअखीलाहा टोपा होय, आन तिये डिलोपोअ एक नाव लेख्योहो, जियाहा तियाहा सोड़ीत बिहीरा कोडाहाज नाहां मुंदू. <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />तो रक्तामेहें बुल्ल्ये आंगड़े पोवित होय, आन तियाआ नाव “देवोअ शब्द होय.” <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />होरगा मेर्‍यीइ सेना पांडे सोके मोवे आंगड़े पोवित आन पांडा कोड़ापोअ बोहीत कोइत तियाआ फासाड़ी फासाड़ी सालेहे. <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />आखा देसोअ माअहुंहूं माइलाआ काजे तियाआ मुखोम रोत वाडाली तारवाआ निहेंहे. तो लोड़ाआ राजडेंगारा वाअहीं तियांपोअ राज कोए आन आखाम रोत वोडी ताकतवाला देवोअ खोतेए दाराक्शाआ रोहोअ कुंडे सुउवी देय. <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />तियाआ जांगेपोअ आन साअकापोअ ओं नाव लेख्योहो: “राजाआं राजा आन प्रभुउं प्रभु.”<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />आंय एका देवदुतोहो दिहोपोअ उबा रोल्याहा देख्यू. तिये वोडा आवाजोमेहें जुगोम उड्नारा आखा सिड़ाहां कोयो, “आवा, देवोअ वोडी पांगातीइ काजे टोलु वोला, <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />तुमू राजाहांआं माहां, सेनापतीइं माहां, आन बाहादिरोओं माहां, कोड़ाआं माहां आन कोड़ापोअ बोहनाराआं माहां, मालिख, पावर आन हाना वोडाआ आक्खा माअहोंअ माहां खावा.”<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />ताहां आंय जनवारोहो आन धरती पोर्‍याआ राजहांहां देख्या आन तियीं सेनाहां बी देख्यी, जे पांडा कोड़ापोअ बोहनारा माट्योअरी आन तियाआ सेनाअरी लड़ाय कोइलाआ कोअते टोलु वोल्यीते. <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />तिया जनवारोहो, आन तियाअरी तिया ठोग भविश्यवक्ताहा तोअया, जिये तियाआ सामने माअहुंहूं एहेलिही निशाणी देखाड़ीत कोइत भटकाड़्येते, जियांआं आथोमेहें तिया जनवारोअ निशाणी ओती, आन तें तियाआ मुर्तीइ पुंजन कोअतेते, यां बेनुहूं जिवताइज तिया गंधकोवाअहीं पेटाअनारा आगीइ तालावोमेहें टाकी देदा.<note caller="+" style="x"><char style="xo" closed="false">19:20 </char><char style="xt" closed="false"><ref loc="REV 13:1-18">प्रगटी 13:1-18</ref> </char></note> <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />रोल्ये माअहें कोड़ापोअ बोहनाराआ सोबीम रोत निहींनारी तारवाइ वाअहीं मोये आन आक्खे सिड़े तियांआं माहां खात ताराइत गोये.<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s">हाजार वोरह्ये</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />याआ फासाड़ी एका देवदुतोहो होरगाम रोत उतरीइत्लाहा देख्यू, तियाआ आथोमेहें उंडा खायाराआ किल्ली आन एक वोडी हाकल ओती. <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />तिये अजगरोहो, जुना हापोहो मोन्ज्ये आरोप लागाड़नारा सैतानोहों तोइत कोइत हाजार वोरह्योंअ कोअते बांद्यु,<note caller="+" style="x"><char style="xo" closed="false">20:2 </char><char style="xt" closed="false"><ref loc="REV 12:9">प्रगटी 12:9</ref></char></note> <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />आखा माअहुंहूं ने भटकावे तेहें काजे तिया अजगरोहो उंडा खायारामेहें टाकी देदू, आन बोंद कोइत सिक्कु मारी देदू, तिहींइं फासाड़ी थोड़ीक वेलेए कोअते तियाहा सोड़ी देएलाआ गरज होय.<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />फाशीइ आंय राजगादी देख्यी आन तियींपोअ माअहें बोठे, तियांहां न्याय कोइलाआ आधिकार आप्यू, आंय तियां माहुंउं आत्माहां बी देख्यी, जियांआं मुनके ईसुउ साक्शी आन देवोअ वसनोअ वाखरी तोड़ीत टाक्येते, आन जियां तिया जनवारोअ आन तियाआ मुर्तीइ भक्ती ने कोअयीते, आन तियांआं निंडाआपोअ आन आथोपोअ तिया जनवारोअ सापोअ आकड़ू ने लागाड़ुहूं देदूतो. तें फाशेए जिवित कोइत ख्रिस्ताअरी एक हाजार वोरह्ये जाआं राज कोए.<note caller="+" style="x"><char style="xo" closed="false">20:4 </char><char style="xt" closed="false"><ref loc="DAN 7:22">दानि 7:22</ref></char></note> <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />ते थोड़ेक मोल्ये माअहें हाजार वोरह्ये पुरे ने ओवे ताअहूं ने जिव्ये. ओं पेहलो पुनरुत्थान होय. <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />धन्य आन सोके तें होय, जें पेहला पुनरुत्थानोमेहें सामिल होय. एहेला माअहूं पोअ दुसरा मोतोअ अधिकार ने रोय. पोन तें देवोअ आन ख्रिस्ताआ पुंजारे बोणे आन तियाअरी हाजार वोरह्ये जाआं राज कोए.<verse eid="REV 20:6" /></para>
  <para style="s">सैतानोअ हार</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />एक हाजार वोरह्ये पुरे ओत जाय ताहां सैतान जेलेम रोत सुटीत जाय. <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />आन तो धरतीइ शारु खुणामेहें वेराइत रोल्या देसोहों मोन्ज्ये गोग आन मागोग यांहां, जियांआं गणती दोर्‍याआ रेटाआ एतीही होय, सैतान तियांहां ठोगित कोइत लोड़ायीइ काजे एक्ठे कोइलाआ कोअते बाअथे निहे. <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />तियां आखी धरतीपोअ पसरीत कोइत देवोअ माअहोंअ पोड़ावाहा, आन मेराला होयरोहों केंडवारीत लेदो, ताहां जुगोम रोत आग उतऱ्यी आन तियांहां आरवीत टाक्ये. <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />तियां ठोगनारा सैतानोहों आगीइ आन गंधकोअ तालावोमेहें टाकी देदू; तिहींमेहें तिया जनवारोहो आन तिया ठोग भविश्यवक्ताहा बी टाकी देदा, आन ते दिहीन रात हादाजलम तड़पिइता रोय.<note caller="+" style="x"><char style="xo" closed="false">20:10 </char><char style="xt" closed="false"><ref loc="MAT 25:46">मत्तय 25:46</ref></char></note><verse eid="REV 20:10" /></para>
  <para style="s">सेलवार्‍युउ न्यायनिवाड़ु</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />तिहींइं फासाड़ी आंय फाशोअ एक पांडी वोडी राजगादी आन तियीपोअ बोठ्ला एका माहुंहूं देख्यो. धरती आन जुग तियाआ सामने आरताइत गोये आन तियांहां काज जागू ने जोड़्यू. <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />आन आंय हाना-वोडा आक्खा मोल्याहां राजगादीइ सामने उबे रोल्ये देख्ये, आन पुस्तक उगाड़्यो; ताहां फाशोअ एक बिहीरो पुस्तक, तो जिवनोअ पुस्तक होय, उगाड़्यो; तियां पुस्तकोम लेखाअली गोठीइ परमाणे तियां मोल्या माअहोंअ कामोअ न्यायनिवाड़ू ओवू. <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />दोर्‍यामेहें मोअनाराहां दोर्‍ये आपी देदे, मोत आन अधोलोकोमेहें मोअयेते, तियां बी तियांम मोल्या माअहोंहों आपी देदे; आन हारेकोअ जियातियाआ कामोअ पुरमाणे न्यायनिवाड़ू ओवू. <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />तिहींइं फासाड़ी मोत आन अधोलोक, बेनुहूं आगीइ दोर्‍यामेहें टाकी देदे. ए आगीइ दोर्‍या दुसरी मोत होय; <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />आन जियांआं नावे जिवनोअ पुस्तकोमेहें ने सापड़्ये, तियांहां आगीइ दोर्‍यामेहें टाकी देदे.<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s">नवू जुग आन नवी धरती</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />ताहां आंय एक नोवू जुग आन नोवी धरती देख्यी, जुनू जुग आन जुनी धरती बेनू आरतात गोयेते, आन दोर्‍या बी ने रोयू. <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />ताहां आंय सोको होयर, नोवा येरुसालेमोहों देवोअ जागे जुगोमेहें रोत उतरीइत्लाहा देख्यो, तों वोरोअ काजे हिंगरावल्यी वोड़ली जेहें होबाड़ल्यो ओतो. <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />ताहां आंय राजगादीइहीं रोत निहींल्या एका आवाजोहो उनाअयू, “पाला, देवोअ वोहती माअहोंअ विसमेहें होय. तो तियांआं विसमेहें रोय, आन तें तियाआ माहें बोणे आन देव सोताहा तियांआं विसमेहें रोत कोइत तियांआं देव बोणे.<note caller="+" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="LEV 26:11">लेवी 26:11</ref>,<ref loc="LEV 26:12">12</ref>; <ref loc="EZK 37:27">यहे 37:27</ref></char></note> <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />तो तियांआं डोआमेर्‍येए आक्खे रोज्ये नुसीत टाके; आन तिहींइं फासाड़ी ने मोत रोय, ने रोड़ीइलोअ, ने विखु, आन ने दुख, काहाके जुनी गोठी निहींत गोयीही.”<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />ताहां राजगादीपोअ बोहनारे कोयो, “पाला, आंय आक्खो नोवो कोअहो.” फाशोअ तिये कोयो, “ए गोठी लेखीत ले, काहाके ए खोरी आन सत्य होय.” <verse eid="REV 21:5" /><verse number="6" style="v" sid="REV 21:6" />तिये फाशोअ माहूं कोयो, “काम पुरो ओत गोयो! अल्फा आन ओमेगा, सुरुवात आन सेवट आंय होंव. आंय तिहील्याहा जिवनोअ पाअयोंअ उकलामेहें रोत फुकटोम पाईं पिवाड़ीहीं. <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />जों जिके तोंज यी आखी वस्तुउ वारीस रोय; आंय तियाआ देव बोणिहीं आन तों माआं पोर्‍यो बोणे. <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />पोन बिकर्‍ये, आन विश्वास ने कोअनारे, खाराब कामे कोअनारे, खुन कोअनारे, सिनालो कोअनारे, मोतरीइनारे, मुर्तीइ पुंजन कोअनारे आन आखे ठोग यांआं वाटू तिया दोर्‍यामेहें जोड़े: ओं दुसरो मोत होय.”<verse eid="REV 21:8" /></para>
  <para style="s">नवो येरुसालेम</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />जे हांत देवदुत हांत वाटका लेत कोइत ओता, जिहींमेहें सेलवार्‍यीइ हांत पिड़ा पोइत ओती, तियांमेहें रोत एके जोएं माआं जागे आवीत कोइत कोयो, “एहें आव, आंय ताहूं वोड़ली, मेडाआ लाडी देखाड़ीहीं.” <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />ताहां आंय आत्मावाअहीं पोआइत गोयू, आन देवदुत माहूं एका जाअखीलाहा वोडा आन उसा डोगोपोअ लेत गोयू. तिये माहूं येरुसालेम सोको होयर होरगाम देवोअ जागे रोत निसे उतरीइत्लाहा देखाड़्यो.<note caller="+" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="EZK 40:2">यहे 40:2</ref> </char></note> <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />तों होयर देवोअ महिमा वाअहीं हिंगरात ओतो; आन तियाआ उजालो मोगला डोणोअ आन समकीइनारा डोणोअ होस समकीइतोतो. <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />तियाआ मेरेमेरे एक वोडी आन उसी पितड़ाआ वाड़ ओती, जियीमेहें बारा गेट ओता आन हारेक गेटोपोअ एकेक देवदुत ओता; आन तियां गेटोपोअ इस्राएलोअ बारा कुलोअ नावे लेखल्ये ओते. <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />उक्तामाअहें तिन बाएं; आन पालामाअहें तिन बाएं; देहामाअहें तीन बाएं आन बुट्टामाअहें तिन बाएं ओते.<note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="EZK 48:30-35">यहे 48:30-35</ref></char></note> <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />होयरोअ पितड़ाआ वाड़ बारा डोणोअ पायापोअ उबी ओती, आन तियां डोणोपोअ मेडाआ बारा प्रेशितोंअ नावे लेख्येते. <verse eid="REV 21:14" /><verse number="15" style="v" sid="REV 21:15" />जो माअरी गोठी कोअतुतो, तिया देवदुतोपोअ होयर, तियाआ गेटोअ आन तियाआ पितड़ाआ आन वाड़ीही मापीइलोअ काजे एक होनाआं बुओं ओतो. <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />तों होयर शार खुण्‍यो ओतो, तों नांबोन पोलो हारकोज ओतो; तिये देवदुते बुआं वाअहीं होयर माप्यो, ताहां तों बेन हाजार शार होव किलो मिटर निहींयो: आन तों नांबोन पोलो आन उसो हारकोज ओतो. <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />तिये देवदुते तिया होयरोअ मेरेमेरे पितड़ाआ वाड़ीइ माप लेदो, ताहां तों माअहुंउं मापोअ देवदुते वापर कोअयू, तिया मापोअ पुरमाणे एक होवेन शोवरेशाड़ीस आथ उसो निहींयो. <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />तियाआ पितड़ाआ वाड़ सोमक्या डोणोअ बोण्यीते, आन तों होयर पिवर होनाआ ओतो, जों हाजा बी खासोअ होस ओतो. <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />तिया होयरोअ पितड़ाआ पाया राज्या राज्यामेहें मोगला डोणोवाअहीं मोडाड़ल्या ओता. पेल्लूउ यास्फेए ओतू, बिहीरु निलमणीइ, तिसरु लालड़ी, शौथू मरकत, <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />पासवू गोमेद, साहावू मोणक्याआ, हांतवू पिवला खासोअ मणक्याआ, आंठवू पेरोज, नोववू पुश्कराज, दाहवू लहसनीइ, आकरावू धुम्रकांतोअ आन बारावू याकोतोअ. <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />बारा बाएं बारा मोतीइ बोण्येते; हारेक बाआ एकेक मोतीइ बोण्योतो, आन होयरोअ सड़क हाजा खासोअ होस पिवर होनाआ ओती.<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />माहूं तिया होयरोमेहें एक बी मंदिर नाहां देखाअयो, काहाके आखाम रोत वोडु सेक्तीमान प्रभु देव आन मेडू तियाआ मंदिर होय. <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />तिया होयरोहो दिहोअ आन सांदोअ उजालाअ गरज कायनाहां, काहाके देवोअ महिमा तियाआ उजालो आन मेडू तियाआ दिवू होय. <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />दुन्यां तियाआ उजालामेहें साले; आन धरतीइ राजहां तियामेहें मालधन लेतावे. <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />तिया होयरोअ बाएं दिहेए वेले केदिहीं बोंद ने ओवे; आन तिहीं केदिहीं रात ने पोड़े.<note caller="+" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ISA 60:11">यश 60:11</ref>; <ref loc="ZEC 14:7">जख 14:7</ref></char></note> <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />आन दुन्याआं माअहें महिमा आन मालधन तियामेहें लेतावे. <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />पोन तिया होयरोमेहें ने कोड्लीज एठी वस्तु फोहीत सेकनारी आन ने खाराब कामे कोअनारो आन ठोगनारो फोहीत सेकनारो. पोन तेंज फोहीत सेकनारे, जियांआं नावे जिवनोअ पुस्तकोमेहें लेखाअयेहे.<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />तिहींइं फासाड़ी देवदुत माहूं किमती डोणोअ होस जिवनोअ पाअयोंअ खाड देखाड़्यी, जे देवोअ आन मेडाअ राजगादीइ जागे रोत वोहतीते. <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />ते खाड होयरोअ सड़केए पोरापोर वोहतीते. तियी खाडीइ यी तोड़े आन तियी तोड़े जिवनोअ साड़े ओते; तियां हारेक साड़ोहों बारा जातीइ फलवे लागतेते, आन तें हारेक मोयनाम फलतेते; आन तियां साड़ोअ पालावाअहीं आखी जातीइ माअहें हुदरीइतेते.<verse eid="REV 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 22:3" />तिहीं रोत तिया होयरोम हारापोअ जोगोहो किज ने रोय, आन तिया होयरोम देवोअ आन मेडाअ राजगादी रोय. तियाआ सेवक तियाआ आराधना कोए.<note caller="+" style="x"><char style="xo" closed="false">22:3 </char><char style="xt" closed="false"><ref loc="ZEC 14:11">जख 14:11</ref> </char></note> <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />तें तियाहा आमने सामने पाले, आन तियाअ नाव तियांआं निंडाअ पोअ लेखल्यो रोय. <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />तिहीं रात केदिहीं ने ओवे; आन तियांहां दिवाआ आन दिहोअ उजालाआ गरज ने पोड़े, काहाके प्रभु देव सोताआ उजालो तियांपोअ हादाजलम पाड़े.<verse eid="REV 22:5" /></para>
  <para style="s">ईसुउ आविइलोअ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />फाशोअ देवदुते माहूं कोयो, “ए गोठी सत्य आन भरिवसाआ होय.” आन प्रभु देव, जो तियाआ आत्मा तियाआ भविश्यवक्ताहां आपेहे. तिये तियाआ देवदुतोहो याअकाजे मोकल्यू के तियाआ सेवकोहों जे गोठी वेगीज ओवनारी होय ते देखाड़े.<verse eid="REV 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />ईसु कोहे, “उनाआ! आंय वेगुज आवोहो! धन्य होय तों जों या पुस्तकोमेर्‍यीइ भविश्यवाणी मानेहें.”<verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />आंय योहान होय, जो यीं गोठीहीं देख्यी आन उनाअयू. जेहेलाम आंय उनाअतुतो आन पाल्या कोअतुतो, तेहेलाम देवदुत माहूं ए गोठी देखाड़तुतो, आंय तियाआ गुडाअहीं पागे पोड़ीइलोअ काजे उठ्लीत पोड़्यू. <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />पोन तिये माहूं ओं कोयो, “तु एहें मा कोअही; काहाके आंय बी ताआ आन ताआ पाही भविश्यवक्ताआं, आन जें या पुस्तकोमेर्‍यीइ गोठी मानतेहे तियां माअहों सेवकोमेर्‍युउ एक होय, तु देवोओज भक्ती कोअ.” <verse eid="REV 22:9" /><verse number="10" style="v" sid="REV 22:10" />फाशोअ तिये माहूं कोयो, “या पुस्तकोमेर्‍यीइ भविश्यवाणीइ गोठी मा बोंद कोअही; काहाके वेल आहने होय. <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />बाक्तो कोअनारो बाक्तो कोअतोज रोय, जों सोगद्यो ओय, तों सोगदायीमेहें वादतो जाय; जों हाजो तो हाजोज कोअतो रोय. जों सोको होय तों सोको ओवतोज रोय.”<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />ईसु कोहे, “उनाआ! आंय वेगुज आवोहो! आन हारेक जोओंहों जियां तियांआं कामोंअ पुरमाणे बक्शीस आपिहीं. <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" />आंय अल्फा आन ओमेगा, पेहलु आन सेलवाऱ्युउ, सुरुवात आन सेवट होंव.”<verse eid="REV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14" />तें हाजे होय, जें सोताआ आंगड़े तुवीत लेतेहे, तियांहां जिवनोअ साड़ोअ जागे आवीइलोअ आधिकार जोड़े, आन तें बाओमेहें रोत होयरोमेहें फोहे. <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />पोन हुंणे, मोत्रीइनारे, सिनालो कोअनारे, खुन कोअनारे, मुर्तीइ पुंजन कोअनारे, लबाड़ी पसन कोअनारे आन लबाड़ी कोअनारे आखे होयरोअ बारथे रोय.<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />“आंय, ईसु, माआं देवदुतोहो याआ काजे मोकल्यू के तुमाआं आगाड़ी मंडड़ीइ बाप्तिमेहें यी गोठीइ साक्शी आपित सेके. आंय दाविदोअ मुल, पारवाड़, आन वेगऱ्युउ समकीइनारु तारु<note caller="+" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="ISA 11:1">यश 11:1</ref>,<ref loc="ISA 11:10">10</ref> </char></note> होय.”<verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />आत्मा आन वोड़ली बेनू कोतेहे, “आव!” जो उनाअहे, तो उत्तर आपे, “आवा!” जों तिहील्यो होय तों आवे, आन जियाहा जोवे तों जिवनोअ पाईं फुकट लेत जाय.<verse eid="REV 22:17" /></para>
  <para style="s">आखरी</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />जे माअहें या पुस्तकोअ भविश्यवाणीइ गोठी उनाअतेहें, आंय तियां आखाहा ओं वारुहूं कोत देहो: के जर एखू माअहुंउं यी गोठीही वादाड़े, ताहां देव या पुस्तकोमेहें लेखल्यी आखी पिड़ा तियापोअ टाकी देय. <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />जर एखु यी भविश्यवाणीइ पुस्तकोअ गोठीमेहें रोत काविहीं काडे, ताहां देव या पुस्‍तकोमेहें कोत आपल्या जिवनोअ साड़ आन सोका होयरोम रोत तियाआ वाटु काडीत टाके.<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />यीं गोठीइ साक्शी आपनारु एहें कोहे, “होव, आंय वेगुज आवोहो!” आमेन! प्रभु ईसु आव!<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />प्रभु ईसु ख्रिस्ताआ मेरवानी पवित्र माअहोंअरी रोअहूं जोवे. आमेन.<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>