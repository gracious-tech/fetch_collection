<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Noiri</book>
  <para style="h">1थेस्सलनी</para>
  <para style="toc3">1 थेस्स</para>
  <para style="toc2">1 थेस्सलनी</para>
  <para style="toc1">थेस्सलनीवालाहां प्रेशित पौलुसोअ पेहलो पत्र</para>
  <para style="mt2">थेस्सलनिकाकरांस प्रेशित पौलाचे पहिले पत्र</para>
  <para style="mt1">थेस्सलनीवालाहां प्रेशित पौलुसोअ पेहलो पत्र</para>
  <para style="imt">ओलखात</para>
  <para style="ip">“थेस्सलनीवालाहां प्रेशित पौलुसोअ पेहलो पत्र” ओं प्रेशित पौलुसे लेख्योहो <char style="xt"><ref loc="1TH 1:1">1:1</ref></char> ओत सेकेहे पौलुसे लेखल्यो ओं पत्र वसनोअ पेहलु भाग बोण्यु ओय, आन ओं आंदासीज ख्रिस्ताअ जल्माअ 51 वोर्ह्योंअ फाटी लेखाअयोहो, जाहां पौलुस थेस्सलनी वालाआं मंडड़ीही पत्र लेखतुतो तेहेलाम तो करिन्थ सेहरोम ओतू, यी मंडड़ीही तिये दुसरी मिशनरी प्रवासोअ होमसे थापन कोअयीते. <char style="xt"><ref loc="ACT 17:1-10">प्रेशित 17:1-10</ref></char> प्रेशितोंअ कामोंअ पुस्तकोमेहें एहेलोह कोयोहो के ए मंडड़ी थोड़ाक यहुदी आन वारुज युनानी माअहों वाईं बोण्यीते.</para>
  <para style="ip">यी मंडड़ीही थापन कोअयी तोयोंअ पौलुस थेस्सलनी मेहें वादार दिही जाआं ने रुकाइत सेकू. तियाहा काजे तो तिहींइं विश्वास्याहां प्रोत्साहन आपीइलोअ काजे ओं पत्र मोकल्योहो. या पत्रामेहें वारुज मुद्दा आन ख्रिस्ती जिवन कि कोइत जिवुहूं जोवे, याआ सादी सुसना आप्यीही. पौलुस ख्रिस्ताअ दुसरी वारी आविइलोअ बाप्तिमेहें ध्यान खेसेहे. केहेंनेत थेस्सलनी वालाआं मंडड़ी मेहें रोनारा विश्वास्याहां या मुद्दाहा जाइंलोअ खास रोढ ओती. पौलुस ख्रिस्ताअ बिहीरी वाआ आविइलाअ बाप्तिम वापर कोइत तियांहां देवोहो गोमे एहेलोह जिवन जिवे तेहें उत्साहीत कोअहे. <char style="xt"><ref loc="1TH 5:6-8">5:6-8</ref></char></para>
  <para style="iot">रुप-रेशा</para>
  <para style="io1">1. पौलुस तियाआ पत्राआ सुरुवात मंडड़ीही सलाम आन देवोहो धन्यवाद कोअतू जात कोअहे <char style="ior"><ref loc="1TH 1">1</ref></char></para>
  <para style="io1">2. पौलुस तियाआ काम आन तिमोथ्ये लेतावल्यी बातमीइ बाप्तिमेहें सर्सा कोअहे <char style="ior"><ref loc="1TH 2-3">2—3</ref></char></para>
  <para style="io1">3. तिहींइं फासाड़ी पौलुस ईसुउ बिहीरी वारी आविइलोअ वेले ख्रिस्ती जिवन केहें कोइत जिवुहूं जोवे तों सुसना कोअहे <char style="ior"><ref loc="1TH 4:1-5:15">4:1—5:15</ref></char></para>
  <para style="io1">4. पौलुस पत्राआ सेवट मंडड़ीही सलाम आन तियांहां कोहे के ते ओं पत्र वासुहूं जोवे <char style="ior"><ref loc="1TH 5:16-28">5:16-28</ref></char></para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="s">सलाम</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />पौलुस, सिल्‍वानुस आन तिमथ्याअहें रोते— थेस्सलनीइ मंडड़ीइ नावसे, जे देव बाह्हाआ आन प्रभु ईसु ख्रिस्ता मेहें होये:</para>
  <para style="p" vid="1TH 1:1">देवोअ मेरवानी आन होक तुमुहूं जोड़तू रोये.<verse eid="1TH 1:1" /></para>
  <para style="s">थेस्सलनी वालाआं जिवन आन विश्वास</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />आमू कायम आमाअ प्रार्थना मेहें तुमुहूं ईत कोअताहा आन हादाफल तुमा आखाआ बाप्तिमेहें देवोअ धन्यवाद कोअताहा. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />आन आपाआ देव आन आब्हाआ सामने तुमाआं विश्वासो वाईं कोअल्या कामोंहों आन मेरे वाईं कोअल्यी मेहेंनतोहो, आन आमाअ प्रभु ईसु ख्रिस्तामेहें आशा वाईं सहन कोइलाअ सेक्तीही कायम ओर कोअताहा. <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />आमाआं पाव्हीइला आमुहूं मुंदू होय, के देव तुमापोअ मेर कोअहे, आन तिये तुमुहूं तियाआ खाजगी माअहें ओवे तेहें काजे निवड़्येहे. <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />काहाके आमाअ हाजी बातमी तुमाअ जागे निस्ती शब्दामेहें एतीज नाहां पोती, पोन सेक्ती वाईं, पवित्र आत्मा वाईं आन पुरा भरिवसा वाअहीं पोतीही, ओं तुमुहूं मुंदू होय के आमू जाहां तुमाअ जागे ओता, ताहां तुमाअ फायदाअ काजे केहेलोहो जिवन जिवताते. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />तुमू वोडी आफतोमेहें ओते, तेबी पवित्र आत्मा वाअहीं आपल्यी खुसी वाईं वसन मानित कोइत आमाआं होसे आन प्रभुउ होसे साले वोल्ये. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />तिहीं वाईं तुमू मकिदुनिया आन अखायाआ विश्वास्याआं काजे एक नमुनू बोणीत गोये. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />काहाके तुमाअ जागे रोत प्रभुउ वसनोअ पुकारु फुटू, तो निस्तु मकिदुनिया आन अखाया एतुज नाहां, पोन देवोपोर्‍युउ तुमाअ विश्वास आखी जागे पोसऱ्यु, ताहां आमुहूं किज कोअलाअ गरज नाहां.<verse eid="1TH 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 1:9" />काहाके तुमाअ जागे आमाआं आविइलोअ कि कोइत ओवो, आन तुमू जिवता आन खोरा देवोअ सेवा कोइलोअ काजे कि कोइत मुर्तीइहें रोत देवोअहें फिर्‍ये; तो तें सोताहाज आमाआं बाप्तिमेहें कोतेहे. <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />आन तियाआ बेटाह्हाअ होरगाम रोत आविइलाअ वाट जोवते रोवा, तो तियाआ बेटुह्हू ईसु होय, जो मोल्याम रोत जिवीत उठ्यू आन जो देवोअ आवनारी खोते रोत वासाड़ेहे.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">थेस्सलनी मेहें पौलुसोअ काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />माआं पाव्हीइला, आमाअ तुमाअ जागे आविलोअ वाया ने ओवो ओ तुमुहूं बी मुंदू होय. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />पोन तुमू सोताहा जांअतेहे के पेल फिलीप्पी मेहें दुख वेठीत आन अपमान खेटीत बी आमू देवोअ हाजी बातमी जाअखा विरोदो मेहें तुमुहूं उनाड़ीत सेको एहेलुहू आपाअ देवे आमुहूं धिर आप्यू. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />काहाके आमाअ कोअलोअ सुकीइ, नेत खाराब उद्देश, नेते माहुंहूं ठोगीइलाआ कायनाहां; <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />पोन जेहें कोइत देवे आमुहूं हाजी बातमी परसार कोइलोअ काजेहे फारकीत पसन कोअयाहा, तिहीं वाईं ते आमू कोत आपताहा, आन यामेहें आमू माअहुंहूं जोवे तेहलोहो नाहां, पोन जो आमाआं मोनोहो फारकेहे तिया देवोहो जोवे तेहलोहो आमू गोगताहा.<verse eid="1TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1TH 2:5" />तुमुहूं वारुहूं मुंदू होय के आमू ने केदिहीं गुल्यी-गुल्यी गोठी कोअताते, आन ने लाभोअ गोठी कोअताते, देव साक्शी होय; <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />आमू माअहूं पोअ रोत कोड्लूज मान सन्मान लेअलाआ कोशित ने कोअयी, ने तुमाप रोत, आन ने बिहीरा कोडा पोअ रोत. <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />आमू ख्रिस्ताआ प्रेशित होय कोत तुमापोअ ओं होदताते, पोन जेहलीही एक आयही तियाआ पोर्‍याहा दुध पिवाड़ीत कोइत पालन पोशण कोअहे, तेहलाहा आमू तुमाअरी नम्रता वाअहीं रोया. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />काहाके तुमाआं बाप्तिम आमाआं मेरेए वाखरी देवोअहीं रोत जोड़ल्यी हाजी बातमी आपीइलोअ तेतोज नाहां, पोन सोताआ जिवन बी आमू तुमाअ काजे आपीइलाआ ईतवीइताहा, काहाके तुमू आमाअ मेराले ओत गोयेहे.<verse eid="1TH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9" />माअ पाव्हीइला, आमू केहेलिही कठीण मेहेंनत आन तारास कोअयू, तो तुमू पाक्के ओर मिका; तुमापोअ वोजू ने आवुहूं जोवे कोत आमू दिहीन रात काम कोअता जात देवोअ हाजी बातमीइं परसार कोअयू.<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />तुमा विश्वासी माअहों मेहें आमाआं वेवारो केहेलोह सोको आन धर्मी आन निर्दुस रोयो, तो तुमू सोताहा आमाआं साक्शी होय, आन देव बी साक्शी होय. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />तुमुहूं मुंदू होय के, जेहें कोइत बाह्हू तियाआ पोर्‍यांअरी वागेहे, तेहेंज कोइत आमू बी तुमाअरी वाग्या. <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />आमू तुमुहूं प्रोत्साहीत कोअये, आमू तुमुहूं होमजाड़्ये, आन तुमुहूं तारबंद विनंती कोअता रोया, के एहेलोहो जिवन जिवा, जों देवोहो गोमेहें, जिये तुमुहूं तियाआ सोताआ राजोअ आन महिमाअ भागीदार ओवीइलाआ काजे हाद्येहे.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />तियाहा काजे आमू बी कायम देवोअ धन्यवाद कोअताहा, के जेहेलाम आमाअ जागे रोत देवोअ वसन तुमाअ जागे पोतो, तेहेलाम तुमू तों माअहुंउं नाहां, पोन देवोअ कोत मानित लेदो आन खोरीज ओं एहेलोज होय; काहाके देव तुमा विश्वास कोअनारा मेहें काम कोअहे. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />माअ पाव्हीइला, तेज आखी गोठी तुमाअरी ओयी, जे यहुदीया मेहें देवोअ तियी मंडड़ीइ आरी ओयीते, जे ख्रिस्त ईसु मेहें होय, तुमू तुमाअ हेंगात्यांअरी तेहेलुहूज तारास वेठ्युहू, जेहलुहू तियां यहुदीइ आथे वेठ्युतो, <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />जियां प्रभु ईसुहू आन भविश्यवक्ताहां बी माईंत टाक्या, आन आमुहूं बी तारास देदू, देव तियां वाईं खुस कायनाहां, आन तें आखा माअहुंउं विरोद कोअतेहे, <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />बिगर यहुदी माहुंहूं सुटका मिलुहूं जोवे कोत जो संदेश आमू आपताहा तियाहा ते रुकतेहे, यी गोठी मेहें तें सादाज तियांआं पापोअ मापलो पोअया कोअतेहे, तियां पोअ देवोहो पुरी खोत लागीही.<verse eid="1TH 2:16" /></para>
  <para style="s">पौलुसोअ फाशोअ तियांहां मिलीइलाअ इश्शा</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />माआं पाव्हीइला, जेहेलाम आमू थोड़ा वेलोअ काजे, तुमाअरी रोत सेटे ओत गोयाते, तेबी मोनो वाअहीं नाहां, पोन डिलो वाअहीं, ताहां आमू वोडी आशा वाअहीं तुमाअ सोब पालीइलाअ जाअखीलिही कोशित कोअयी. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />तिहीं वाईं आमू तुमाअ जागे आविइलाअ इश्शा कोअयी; आंय पौलुसे एक वाआ नाहां ते बेन वाआ इश्शा कोअयी, पोन सैताने आमुहूं रुक्या. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />काहाके आपाआ प्रभु ईसुउ सामने, तियाआ आविइलाआ टायमोहों आमाअ आशा, आमाअ खुसी आन आमाअ इलामोअ टोपू जियापोअ आमू वोडाय कोअताहा तो की होय? तें तुमूज होय ना? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />खोरीज आमाअ वोडाय आन खुसी तुमूज होय.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />तियाहा काजे जेहेलाम आमुहूं बी धिर ने खेटाअयू, ताहां एथेन्स सेहरो मेहें एखलाज रोत जाअलो हाजो आवे एहेलोह आमुहूं लागो; <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />आन आमू तिमथ्याहा, जो ख्रिस्ताआ हाजी बातमी मेहें आमाअ पाही आन देवोअ सेवामेहें हाती होय. याहा एताआ कोअते मोकल्यू के तुमुहूं मजबुत कोए आन तुमाअ विश्वासोअ बाप्तिमेहें तुमुहूं उत्साहीत कोए, <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />काहाके कोडो यां तारासो वाअहीं फासाड़ी ने वोलुहूं जोवे. तुमू सोताहा जांअतेहे के आपू याआज कोअते निवडाअयेहे. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />काहाके जेहेलाम आमू तुमाअहीं ओता, तेहेलाम तुमुहूं पेलुज कोया कोअताते के, आपुहूं तारास वेठुहूं पोड़े, आन ओं बोराबर तेहलोज ओवोहो, ओं ते तुमुहूं मुंदूज होय. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />तिहीं वाअहीं माहूं बी ने रोवाअयो, ताहरुउ आंय बी तुमाआं विश्वासोअ हालत जाईंत लेअलोअ काजे कोशित कोअयी, केहेंनेत परिक्शा लेनारे तुमाअ परिक्शा लेदी ओय, आन आमाआं मेहेंनत वाया जाती रोयी ओय.<verse eid="1TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />पोन ओमे तिमथ्या, जो तुमाअहीं रोत आमाअ जागेहे आयुहू, तिये तुमाअ विश्वास आन मेरेए हाजी बातमी उनावयी, आन ए गोठ बी कोत आप्यी, के तुमू हादाफल आमाआं बाप्तिम ओर कोअतेहे, आन आमुहूं हेइलोअ आहरु कोअतेहे, जेहें कोइत आमू बी तुमुहूं मिलीइलोअ इश्शा कोअताहा. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />याअ कोअते ए पाव्हीइला, आमू आमाआं आखा दुख आन तारासो मेहें तुमाअ विश्वासो वाअहीं आमू तुमाअ बाप्तिमेहें रोढवाइत गोयाहा. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />काहाके, ओमे जर तुमू प्रभु मेहें टिकीत रोहा, ताहां आमू जिवता होय. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />आन जेहेली खुसी आमुहूं तुमा वाअहीं आपाआ देवोअ आगाड़ी होय, तियाआ बद्दल तुमाअ बाप्तिमेहें केहें कोइत देवोअ आभार मानुहूं जोवे? <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />आमू रात दिही जाअखीलाहा प्रार्थना कोअता रोताहा के तुमाअ सोब हुंबाहूंब पालित सेको, आन तुमाअ विश्वासोअ कमी पुरी कोइत सेको.<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />ओमे आपाआ देव आन बाह्हू सोताहा आन आपाआ प्रभु ईसु, तुमाअ जागेहे आविइलाअ काजे आमाआं वाट तियार कोए. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />आन जेहें कोइत आमू तुमा पोअ मेर कोअताहा, तेहेलीज मेर तुमा सोतामेहें आन आखा माअहूं मेहें वादे आन वादती जाय एहेलोह प्रभु कोइ देअहूं जोवे. <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />याअ कोअते के जेहेलाम आपाआ प्रभु ईसु तियाआ आखा सोका माअहोंअरी आवे, ताहां तो आपाअ देव आन बाह्हाआ सामने तुमाअ मोनोहो सोकायी मेहें निर्दुस आन मजबुत कोए.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">देवोहो खुस कोअनारो जिवन</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />तियाहा काजे पाव्हीइला, आमू तुमुहूं रावणी कोअताहा आन तुमुहूं प्रभु ईसु मेहें समजाड़ताहा, के जेहें कोइत तुमू आमाअरी हाजे साल्ये आन देवोहो खुस कोइलाअ सिकाअयेहे, आन जेहें कोइत तुमू सालतेहे बी, तेहेंज कोइत तुमू वादारेन वादार वादते जावा. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />काहाके तुमुहूं मुंदू होय के प्रभु ईसुउ आधिकारो वाअहीं आमू तुमुहूं काअली सुसना आप्यीही. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />काहाके देवोअ इश्शा ए होय के, तुमू सोके बोणे: आन एकसोट्येज सिनालो कोइलो रोत सुटीत जावा, <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />आन तुमा मेर्‍योअ हारेक जोओं सोकायी मेहें आन मानपानो वाअहीं सोताआ लाडीही ताबाम लेअलोअ जाईंत लेअहूं जोवे. <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />आन ओं काम लालसायी वाईं नाहां, आन जें देवोहो नाहां ओलखीइते एहेला माअहोंअ होस बी ने कोइलो.<verse eid="1TH 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 4:6" />यीं गोठी मेहें कोडोज विश्वासी पायहोहो ने ठोगुहूं जोवे, आन कोडोज तियापोअ दाबाव ने टाकुहूं जोवे, काहाके एहेला आखाआ वोतीइ प्रभु डोंड आपनारु होये; जेहें कोइत आमू पेल बी तुमुहूं कोताते आन समजाड़ताते. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />काहाके देवे आपुहूं एठे ओवे तेहें नाहां, पोन सोके ओवे तेहें काजे हाद्येहे. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />तियाहा काजे जो या शिक्शणोहों नाकारेहे, तो एखा माहुंहूं नाहां नाकारतो, पोन तिया देवोहो जो तुमुहूं पवित्र आत्मा आपेहे, तियाहा नाकारेहे.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />विश्वासी पाव्हीइलाआ मेरेए बाप्तिमेहें ओं गरज नाहां, के आंय तुमाअ कोअते कि तेबी लेखो, काहाके एक बिहीरा पोअ मेर कोइलाअ तुमू सोताहा देवो पोअ रोत सिकाअयेहे; <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />आन हुदाअलीज पुरा मकिदुनियाआ आखा पाव्हीइलांअरी एहलोहो तुमू कोअतेहे जे, पोन पाव्हीइला, आमू तुमुहूं विनंती कोअताहा के फाश्येए बी वादते जावा. <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />आन जेहें कोइत आमू तुमुहूं कोत आप्योहो, तेहेंज कोइत ठावके रोअलाआ आन जिव जिवोअ काम-काज कोइला आन जिव जिवोअ आथो वाअहीं कामाविलाआ कोशित कोआ; <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />एहें कोइत तुमू जे माअहें विश्वास नाहां कोअते तियां पोअ रोत तुमुहूं मानपान जोड़ीत सेके, आन तुमुहूं काअलीज वस्तुउ कमी ने ओवुहूं जोवे.<verse eid="1TH 4:12" /></para>
  <para style="s">प्रभुउ आविलोअ</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />आमाअ पाव्हीइला, आमाअ ए इश्शा होय के तुमू तियांआं बाप्तिमेहें जें हुवतेहे, ओजाण्ये ने जोवे; मोन्ज्ये बिहीराअ होस विखा ने कोइलो जियांहां आशा कायनाहां. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />काहाके जर आपू ओ विश्वास कोअतेहे के ईसु मोयू आन जिवीत बी उठ्यू, ताहां ईसु मेहें जें मोअतेहे, तियांहां बी देव तियाअरी लेत आवे.<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />आन आमू जो तुमुहूं प्रभुउ वसनो वाअहीं ओं कोताहा, के आपू जे जिवते होय आन प्रभुउ आविइलाआ दिहे जाआं जिवते रोहूं, ते जे मोयेहे तियां रोत आगाड़ी केदिहींज ने जात सेकहूं. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />काहाके प्रभु सोताहाज होरगाम रोत उतरे; तियी वेले पोअ वोडू आवाज, आन मुख्य देवदुतोअ शब्दाआ आवाज होंबलाय, आन देवोअ तुरी फुकाय; आन ख्रिस्तामेहें जे मोयेहे, तें पेल जिवित उठे. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />तेहेलाम आपू जे जिवते आन वासाइत रोहूं, तेहलेज तियाअरी वादला पोअ हावामेहें प्रभुहू मिलीइलोअ काजे विसाइत जाहूं. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />आखरी पोअ यां शब्दा वाअहीं एकान बिहीराहा समजाडते रोवा.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s">प्रभु फाशुउ आवनारु होय तियारीम रोजा</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />पोन विश्वासी पाव्हीइला, वेल आन वाडोअ बाप्तिम तुमुहूं लेखीइलोअ कीज गरज कायनाहां. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />काहाके तुमू सोताहाज वारुहूं जांअतेहे के, जेहें कोइत बांड राती होल्याज आवेहे, तेहेंज कोइत प्रभुउ दिही बी आवनारु होय. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />जेहेलाम माअहें कोय, “होक होय, आन हाजे हुतेहे होय,” ताहां जेहें कोइत पोटाअरीइ बायी पोअ तारास आवेहे, तेहें कोइत उसकाहीज तियां पोअ नाश आवित पोड़े; आन किबी कोइत बी तें वासाअनारे कायने.<verse eid="1TH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4" />पोन विश्वासी दोस्तां, तो दिही तुमा पोअ होल्याज बांडोअ होस आवित पोड़े एहेलेहे तुमू आंदाराम कायनाहां. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />तुमू आखे उजालाअ पोर्‍ये आन दिहोअ पोर्‍ये होय. आपू नाहां रातीइ होय, नाहां आंदाराआ. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />तियाहा काजे आपू बिहीराअ होस हुवते ने रोअहूं जोवे, पोन जागते आन तियारीम रोअहूं जोवे. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />काहाके जे हुवतेहे ते रातीज हुवतेहे, आन जे साकवाले रोतेहे तें रातीज साकवाल रोतेहे. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />पोन आपू जे दिहोअ होय, तियाहा काजे विण साकवाल रोअहूं जोवे. आवा विश्वास आन मेरेए आंगड़ो पेवित कोइत आन तारणोओं आशाआ टोपू पेवित रोहूं.<verse eid="1TH 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 5:9" />काहाके देवे आपुहूं तियाआ खोतेए काजे नाहां, पोन याअ काजे ठरव्येहे के आपुहूं आपाआ प्रभु ईसु ख्रिस्ता वाअहीं तारण जोड़ुहूं जोवे.<verse eid="1TH 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 5:10" />तो आपाआ काजे एताआ वोतीइ मोयु के आपू जिवते रोंव नेत मोइत जांव, तेबी आखे मिलीत तियाअरीज जिवते रोत सेको. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />आन एकान बिहीराहा उत्साहीत कोआ आन एकान बिहीराहा मदत कोआ, जेहलोहो तुमू ओमे बी कोअयाज कोअतेहे.<verse eid="1TH 5:11" /></para>
  <para style="s">आखरीइ सुसना</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />माअ पाव्हीइला, आमू तुमुहूं रावणी कोअताहा के जे तुमाअरी मेहेंनत कोअतेहे, आन ख्रिस्तामेहें तुमुहूं वाट देखाड़तेहे, आन जे तुमुहूं सिकाड़तेहे, तियांआं मानपान कोआ. <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />आन तियांआं कामोअ वाखरी तियांअरी मेरेवाईं तियांआं मानपान कोआ. आन सोताहा आखाअरी होकेहे रोवा.<verse eid="1TH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14" />ए पाव्हीइला, आमू तुमुहूं रावणी कोअताहा, के जे आलहाय कोअतेहे तियांहां समजाड़ी द्या, थतरीइनाराहां धिर आपा, कमजोरोहो मदत कोआ, आखाअरी धिर खेटीत रोवा. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />ओं ध्यानम मिका! कोडो कोडाआ सुकीइ बोदले सुक ने कोअहूं जोवे; पोन हादाफल एकान एकाआ हाजो कोइलाआ उद्देश मिका, एकान बिहीराअरी आन आखा माहुंउं बी हाजो कोइलोअ कोशित कोआ.<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />हादाफल खुसीम रोवा. <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />कायम प्रार्थना कोआ. <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />आखी परिस्थिती मेहें देवोअ धन्यवाद कोआ; काहाके ख्रिस्त ईसु मेहें देवोहो ओंज जोवेहे.<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />पवित्र आत्माहां मा उलवाहा. <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />भविश्यवाणीहीं कमी मा समजाहा. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />आखी गोठीही फारका; जे हाजी होय ते तोइत रोवा. <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />आखी जातीइ खाराबीम रोत सेटे रोवा.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />होक आपनारु देव सोताहाज तुमुहूं हारेपुरे सोके कोए; आन तुमाअ आत्मा आन जिव आन शरीर आपाअ प्रभु ईसु ख्रिस्त आवे ताअहूं जाआं निर्दुस आन सांबालित मिकुहूं जोवे. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />तुमाअ हादनारु इमानदार होय, आन तो ओं कोएज.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />पाव्हीइला, आमाअ काजे प्रार्थना कोआ.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />आखा विश्वास्याहां सोकी गुट लेत सलाम कोआ.<verse eid="1TH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />आंय तुमुहूं प्रभुउ आधिकारो वाअहीं रावणी कोअहो, के ओं पत्र आखा विश्वासी माहुंहूं जोरे आवाजोम वासीत देखाडा.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />आपाअ प्रभु ईसु ख्रिस्ताआ मेरवानी तुमाअ आरी रोअहूं जोवे. आमेन.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>