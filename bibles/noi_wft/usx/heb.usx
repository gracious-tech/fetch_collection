<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Noiri</book>
  <para style="h">इब्री</para>
  <para style="toc3">इब्री</para>
  <para style="toc2">इब्री</para>
  <para style="toc1">इब्री माअहुंहूं पत्र</para>
  <para style="mt2">इब्री लोकांस पत्र</para>
  <para style="mt1">इब्री माअहुंहूं पत्र</para>
  <para style="imt">ओलखात</para>
  <para style="ip">इब्री ओं पुस्तक ओं एक हिम्मत आपनारो पत्र होय, जों देखाड़ेहे के, ईसु केहें कोइते जुना नियमोमेर्‍यीइ भविश्यवाणी पुरी कोअयी. ओं पुस्तक संदेशोअ होस लेखाअयोहो. या पुस्तकोमेहें जुना नियमोमेर्‍येए 60 संदर्भ वसने एहेलेहे होय जिहीं वाईं स्पश्ट देखाअहे के, ईसु जुना करारोअ भविश्यवाणी केहें कोइत पुरी कोअयी आन तिये डाया पुंजाराआ कामकाज जों रोहे तों पुरो कोअयो. यी गोठी वाईं यहुदी विश्वासी पाव्हीइलाहां हिम्मत जोड़ेहे. या पुस्तकोम मुंदू जाहे के ईसु ख्रिस्त एकुज वारीम आखाआ काजे आखा पापोअ गाराहा बोण्यु. वर्तमान कालोमेऱ्याआ विश्वासी पाव्हीइलाहां बी जें ईसु ख्रिस्तापोअ विश्वास कोअतेहे आन विश्वास मिकीत सालीइलोअ काजे कोशित कोअतेहे तियांहां या पुस्तकोम रोत हाजी हिम्मत जोड़ीत जाहे. <char style="xt"><ref loc="HEB 12:2">12:2</ref> </char></para>
  <para style="ip">इब्रीइ पत्र कोडे लेख्योहो तों नाहां मुंदू, पोन थोड़ाक जाणकारोअ आंदास होय के, ओं पत्र पौलुस, लुक नेताहां बरनबासे लेख्योये. याआ लेखीइलोअ तारीख बी कोडाहा नाहां मुंदू, पोन एक आंदास ख्रिस्त जल्म 70 वोऱ्ह्योंअ फाटी लेखाअयोहो.</para>
  <para style="iot">रुपरेशा</para>
  <para style="io1">1. लेखाऱ्यु कोत देखाड़ेहे के ईसु भविश्यवक्ता आन देवदुतों रोत बी उसा पदोपोअ देवोअ हाजाड़ीइ वोल बोठुहू <char style="ior"><ref loc="HEB 1:1-4:13">1:1—4:13</ref> </char></para>
  <para style="io1">2. आगाड़ी जात लेखाऱ्यु देखाड़ेहे के ईसु येरुसालेम मंदिरोम सेवा कोअनारा पुंजारा रोत बी उसेए होय.<char style="ior"><ref loc="HEB 4:14-7:28">4:14—7:28</ref></char></para>
  <para style="io1">3. फाशोअ आगाड़ी मुंदू जाहे के ईसु ख्रिस्ताआ सेवा जुना करारोमेऱ्याआ मोशेए कायदा रोत बी वोडी होय. <char style="ior"><ref loc="HEB 8:1-10:31">8:1—10:31</ref> </char></para>
  <para style="io1">4. आखी पद्दती वाईं ईसु आखाम रोत उसेए होये कोत फोड़ीत देखाड़्यो तिहींइंं फासाड़ी लेखाऱ्यु थोड़ीक वेवाराआ गोठी कोत आपेहे. <char style="ior"><ref loc="HEB 10:32-13:17">10:32—13:17</ref> </char></para>
  <para style="io1">5. आखरीपोअ लेखाऱ्यु थोड़ीक सुसना आपित सलाम कोअहे आन पत्रलेखन बंद कोअहे. <char style="ior"><ref loc="HEB 13:18-25">13:18-25</ref> </char></para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />देव जुना वाडोमेहें आपाआ वेगाआ डायहांअरी भविश्यवक्ता वाअहीं खेलवारी आन बाती-बातीइ पद्धतीमेहें गोठी कोअयी, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />पोन यां आखरीइ दिहोमेहें तिये आपाअरी सोताआ बेटाह्हा वाअहीं गोठी कोअयिही, जियाआ आथो वाअहीं तिये पुरी कोल बोणायीही आन तियाहा आखी वस्तुउ वारीस बी ठरव्युहू. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />तो देवोअ महिमाआं उजालो आन सोताहा देवोअ साप होय. आखी वस्तुहू तो तियाआ ताकतवाला वसनो वाअहीं सांबालेहे. तोज आखाआ पापोहो तुवीत कोइत उसा जागापोअ जो देवोअ देव होय, तियाआ हाजाड़ीइ वोलेहे जात कोइत बोठुहू.<verse eid="HEB 1:3" /></para>
  <para style="s">देवोअ बेटाह्हाआ वोडु जागू</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />देवोअ बेटुह्हू देवदुतों रोत बी जाअखु वोडु बोण्यू, देवे तियाहा देवदुतों रोत बी जास्ती उसो नाव आप्यो. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />काहाके देवदुतों मेर्‍याआं कोडाहाज तिये काअहांज नाहां कोयो के,</para>
  <para style="q1" vid="HEB 1:5">“तू माआं बेटुह्हू होय;</para>
  <para style="q2" vid="HEB 1:5">आज आंय ताआ आब्हू ओवू.”</para>
  <para style="p" vid="HEB 1:5">आन फाशोअ एका देवदुतोहो बी तिये एहें नाहां कोयो के,</para>
  <para style="q1" vid="HEB 1:5">“आंय तियाआ बाह्हू बोणिहीं,</para>
  <para style="q2" vid="HEB 1:5">आन तो माआं बेटुह्हू बोणे.”<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />आन तिहीं रोत पेलठा बेटाह्हाहा यी धरतीपोअ मोकलीइली वेले तो एहें कोहे के,</para>
  <para style="q1" vid="HEB 1:6">“आक्खा देवदुत तियाहा वोंदुहूं जोवे.”<verse eid="HEB 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 1:7" />आन देवदुतोंअ बाप्तिमेहें देव एहें कोहे के,</para>
  <para style="q1" vid="HEB 1:7">“तो तियाआ दुतोहों वारो,</para>
  <para style="q2" vid="HEB 1:7">आन दुड़ूदुड़ू पेटाअनारी आग बोणावेहे.”<verse eid="HEB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 1:8" />पोन बेटाह्हाआ बाप्तिमेहें देव एहें कोहे,</para>
  <para style="q1" vid="HEB 1:8">देवा, ताआ राज हादाजल्म्योंअ होय,</para>
  <para style="q2" vid="HEB 1:8">तु ताआ माहूंपोअ धर्मी राजोवाअहीं राज कोअत्लू.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />जो खोरो होय तियापोअ तु मेर कोअत्लू,</para>
  <para style="q2" vid="HEB 1:9">आन जो सुकीइ होय तियाआ सीस कोअत्लू;</para>
  <para style="q2" vid="HEB 1:9">तिहींज वाअहीं देव, ताआ देवे ताहूं निवड़्युहू, आन ताआ हेंगात्यों रोत जाअखी वोडी खुसी ताहूं आप्यीही.<verse eid="HEB 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 1:10" />आन तो एहें बी कोहे,</para>
  <para style="q1" vid="HEB 1:10">“मालिख, सुरुवातिही तुमे यी धरतीइ पायू टाक्यु,</para>
  <para style="q2" vid="HEB 1:10">आन जुग ताआ आथोअ कला होय.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />तें ताम आरवात जानारे, पोन तु हादाजोलम रोनारु;</para>
  <para style="q2" vid="HEB 1:11">आन तें आखे साअकाआ होस जुने ओत जानारे;<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />आन तु तियांहां सादराआ होस कोड़ी वाली देही;</para>
  <para style="q2" vid="HEB 1:12">आन तें साअकाआ होसऱ्येए बोदलात जाय;</para>
  <para style="q1" vid="HEB 1:12">पोन तु तोज होय,</para>
  <para style="q2" vid="HEB 1:12">ताआ जिवन केदिहींज नाहां सेलाअतो.”<verse eid="HEB 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 1:13" />आन देव तियाआ देवदुतोंहों केदिहींज नाहां कोयो के,</para>
  <para style="q1" vid="HEB 1:13">“जाअहूं जाआं आंय ताआ दुस्मोनोहों ताआ गुडाआ थुड़तेए पाट्लू ने कोइ देंव,</para>
  <para style="q2" vid="HEB 1:13">ताअहूं जाआं तु माआं हाजाड़्यीइ वोल बोहो.”<note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन 110:1</ref></char></note><verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />ताहां ते देवदुत कोडा होय? ते आखा सेवा कोअनारे आत्मे होय, जें तारण स्विकारनाराआं सेवा कोए तेहें काजे मोकलीइल्ये रोतेहें.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">वोडी सुटका</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />तियाहा काजे जे सत्य गोठी आपू उनाअयेहे, तियी पोअ आपू जास्ती दिहान देअहूं जोवे, ताहांज बी आपू मार्गाम रोत भटकीत दुर ने जाहूं. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />काहाके, आपाआ डायहांआं काजे देवदुतोंवाअहीं आपल्यू संदेश एतुहू खोरु ओतू, के जों कोडो बी तिया संदेशोहो ने मान्यो, पोन टाली देदू, तियाहा डोंड जोड़्युज. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />ताहां, जर यी वोडी सुटकाआ वोल आपू दिहान ने देहूं, ताहां आपू केहें कोइत वासाइत सेकहूं? यी सुटकाआ पेहलु पुकारु सोताहा प्रभुदेवे कोअयुहू, आन उनाअनारा आखा आपाआ काजे ओं खोरो होय कोत पुरावू आप्यू. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />आन तेहेंज कोइत तियाआ मोर्जीइ परमाणे देव बी तियाआ निशाणी, वोडे-वोडे कामे, बाती-बातीइ समत्कार कोइत आन विश्वासी माअहोंहों पवित्र आत्माआं वरदाने आपीत कोइत, ए आखी गोठी खोरी होय कोत पुरावू आपतू रोयू.<verse eid="HEB 2:4" /></para>
  <para style="s">आपाआ तारनारु</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />जियी आवनारी नोवी दुन्याआं आपू माग काडतेहें, तियीपोअ राज कोए तेहें काजे देवे देवदुतोंहों नाहां निवड़्या. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />पोन, पवित्रशास्राम एकी जागे कोडे तेबी एहेलिही साक्शी आप्यीही के,</para>
  <para style="q1" vid="HEB 2:6">“विसार कोअहूं जोगोहो या मोनव्योमेहें कि होय?</para>
  <para style="q2" vid="HEB 2:6">नेत या माहुंउं बेटाह्हाम एहेलोहो कि होय के, तु तियाआ कालजी कोअहूं जोवे?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />तुमे तियाहा देवदुतों रोत जारकीज कमी कोअयुहू;</para>
  <para style="q2" vid="HEB 2:7">तुमे तियाहा महिमा आन मानसन्मानोअ पागड़ी बांद्यीही, आन तुमे तियाहा ताआ आथिवल्या कामोपोअ आधिकार आप्युहू.<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />आन तुमे आखी वस्तु तियाआ गुडाआ थुड़ी कोइ देदीही.”</para>
  <para style="p" vid="HEB 2:8">आन आखो तियाआ ताबाम कोइ देदोहो, ताहां एक बी वस्तू एहेलिही बाकी ने सुटी, जे तियाआ ताबाम ने ओय. ओमे ताअहूं आपू आखो बोठो तियाआ ताबाम नाहां देखते. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />पोन आपू ईसुहू देखतेहे, जियाहा देवदुतों रोत जारकीज कमी कोअयुतो, आन मोतोअ तारास वेठीत लेदू तिहींवाअहीं तियाहा महिमा आन मानसन्मानोअ पागड़ी पेवाड़्यीही, ओं याअकाजे काहाके, देवोअ मेरवानी वाअहीं तो हारेक माहुंउं काजे मोतोअ आनुभाव कोइत सेके. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />काहाके, देव, जिये आखो बोणायो आन जियाआ महिमाआं काजे आखो होय, तियाहा ओंज गोम्यो के, जाअखीलां बेटाह्हांहां महिमामेहें भागीदार कोइलोअ काजे तिये ईसुहू दुख वेठाड़ीलोवाअहीं पाक्कू कोइत तियांआं तारनारु बोणायू.<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />काहाके पवित्र कोअनारु आन जे पवित्र कोआयेहे तें नेहें आखे एकाज कुटूंबाआ होय; यीज गोठी वाअहीं तो तियांहां पाही कोत गोगाड़ीइलोम नाहां लाजवाअतू. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />तो ते कोहे,</para>
  <para style="q1" vid="HEB 2:12">“आंय ताआ नाव माआं पायहोंहों कोत देखाड़ीहीं;</para>
  <para style="q2" vid="HEB 2:12">सभामेहें आंय ताआ भजन गाविहीं.”<verse eid="HEB 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 2:13" />आन तो फाशुउ कोहे, “आंय तियापोअ भरिवसू मेकिहीं,” आन फाशुउ कोहे, “पाला, आंय पोर्‍यांहां आरी लेत कोइत होय, जियांहां देवे माहूं आप्येहे.”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />ताहरोअ, पोर्‍ये जेहलेहे माहां आन रक्ताआ बोण्येहें, तेहेंज कोइत ईसु बी तियांआं सारकुज तियांअरी भागिदार ओत गोयू. तो याअकाजे के, मोतोपोअ जियाआ आधिकार ओतू, तिया सैतानोअ सेक्तीइ नाश कोइत सेके, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />आन जेते जोएं जिंदगी पोइत मोतोअ बिकेवाअहीं बांदाखानीम जेहें जिवन जिवतेते, तियांहां सोड़वीत सेके. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />काहाके, तो देवदुतोंहों नाहां पोन अब्राहामोअ पिढ़ीही सांबालेहे. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />याअ काजे देवोअ सेवामेहें दयालू आन इमानदार एहेलुहू मुख्य पुंजारु बोणिइलोअ काजेहे आन माअहोंअ गुनाआं वोतीइ गाराहा आपिइलो काजेहे ईसुहू आक्खी गोठीमेहें तियाआ पायहोंअ होस बोणिइलोअ खुब गरज ओती. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />काहाके, जेहेलाम तियाआ परिक्शा ओवी, तेहेलाम तियाहा दुख वेठुहूं पोड़्यो, ताहां तो जियांआं परिक्शा ओवेहे, तियांहां बी मदत कोइत सेकेहे.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">ईसु मोशे रोत वोडु</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />माआं विश्वासी पाव्हीइला, तुमू जें देवोअ माहें होय आन होरगाआ राजोअ काजे हादाअले होय, तुमू ईसुउ बाप्तिम विसार कोअहूं जोवे, जो देवोअ प्रेशित आन आपाआ विश्वासोअ मुख्य पुंजारु<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="fq" closed="false">पुंजारु </char><char style="ft" closed="false">देवोअ सेवक</char></note> होय. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />तो तियाआ काम होपनारा देवोअरी इमानदार ओतू, तेहलुज मोशे बी देवोअ पुरा कोअमेहें इमानदार ओतू. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />जेहें कोइत कोअ बांदनाराहा कोओ रोत जाअखु मानपान रोहे, तेहेंज कोइत ईसुहू मोशे रोत जाअखु मानपान जोड़्यू. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />काहाके, हारेक कोओअ कोडोन कोडो बोणावनारो रोहे, पोन‍ जिये आखो बोणायोहो तो देव होय. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />मोशे ताम देवोअ पुरा कोअमेहें पावरोअ होसर्‍युउ इमानदार रोयू, काहाके तिये जे गोठी भविश्याम ओवनारी ओती तियींहीं पेलुज कोत आपी देदी. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />पोन ख्रिस्त बेटाह्हाअ होसर्‍युउ देवोअ पुरा कोओअ इमानदार आधिकारी होय; आन जर आपू बी आपाआ धिर, आशा आन देवोपोऱ्याआ पाक्का विश्वासोअ वोडाय कोअतेय ताहां आपू देवोअ कोअ होय आन आपू आखरी जाआं टिकीत रोअहूं जोवे.<verse eid="HEB 3:6" /></para>
  <para style="s">इमानदार रोवा</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />ताहरोअ, जेहेंकोइत पवित्र आत्मा कोहे के,</para>
  <para style="q1" vid="HEB 3:7">“जर आज तुमू तियाआ शब्द उनाअहा,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />ताहां तुमाआं मोन कठीण मा कोअहा,</para>
  <para style="q2" vid="HEB 3:8">जेहेंकोइत तुमाआं डायहां देवोहो पारजाणीलोअ काजे रानोमेहें देवोअ विरुद्दाम दोंगा कोअया.<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />जिहीं तुमाआं डायहां माहूं पारजाणीत कोइत फारक्यु,</para>
  <para style="q2" vid="HEB 3:9">आन सालीही वोरह्ये जाआं माआं कामें देख्ये.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />तिहीं वाअहीं आंय तियी पिढ़ीइ माअहोंअरी खोतात रोयू,</para>
  <para style="q2" vid="HEB 3:10">आन कोयो, ‘यांआं मोने कायम भटकीइते फिरतेहे आन माआं वाट यां नाहां ओलख्यी.’<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />तिहींइंरी आंय खोतेमेहें शप्पत खात कोयो,</para>
  <para style="q2" vid="HEB 3:11">‘एं माहें आरामोंअ जागाम नाहां आवित सेकनारे.’”<note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="NUM 14:21-23">गणती 14:21-23</ref>; <ref loc="DEU 1:34">कायदा 1:34</ref>,<ref loc="DEU 1:35">35</ref></char></note><verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />हेएजा पाव्हीइला, जिवता देवोहो सोड़ी देय एतो खाराब आन विणविश्वासी मोन तुमामेएं कोडाआज ने जोवे. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />पोन जिया दिहोहो “आज्युउ दिही” कोतेहे, तेदिहीं जाआं दाड़ख्येए एकमेकाहा हिम्मत आपते रोवा, काहाके तुमामेएं कोडोज बी पापोम पोड़ीत डांबराय ने कोअहूं जोवे. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />जर आपू सुरुवातीइ विश्वास आखरी जाआं मिकीत रोहूं, ताहांज आपू ख्रिस्ताअरी भागिदार होय.<verse eid="HEB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15" />जेहलोहो वसनोम लेख्योहो के,</para>
  <para style="q1" vid="HEB 3:15">“आज जर तुमू तियाआ आवाज उनाअहा ताहां,</para>
  <para style="q2" vid="HEB 3:15">तुमाआं मोने वातड़े मा कोअहा,</para>
  <para style="q2" vid="HEB 3:15">जेहलोहो तुमाआं डायहां देवोअ विरुद्दाम कोअयोतो.”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />देवोअ आवाज उनाइत बी देवोहो खोत लागाड़्यी तें कोड्ले माहें ओते? मोशे जियांहां मिसर देसोम रोत काडीत लेतायू तेंज माहें ओते ना? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />आन देव सालीही वोरह्ये जाआं कोड्ला माअहोंअरी खोतात रोयू? जियां पाप कोअयू आन जियांआं तोड़े एहेंज रानोमेहें पोड़ीत रोये तें तेंज माहें ओते ना?<note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="NUM 14:29">गणती 14:29</ref></char></note> <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />आन कोड्ला माअहोंअ बाप्तिम देवे शप्पत खादी के, “जो आरामोअ जागू आंय आप्युहू तिहीं तुमू आवित ने सेकाहा?” जियां देवोअ आदेश टाली देदू तियांआं बाप्तिमेहेंज ना?<note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="PSA 106:24-26">भजन 106:24-26</ref></char></note> <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />ताहां इंहीं आपू पालित सेकतेहे के तियां विश्वास तोड़्यू तिहीं वाअहीं तें ने पोतीत सेके.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="s">देवोअ माअहुंउं आराम</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />देवोअ आरामोअ जागामेहें जाअलोअ जोड़्योहो तों आथवसन ओमे जाआं सालुज होय, ताहां, तुमामेर्‍योअ एखू तिया आरामोंअ जागामेहें जाअलोअ ने रोत जाअहूं जोवे कोत बिअहूं जोवे. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />काहाके आपुहूं बी इस्राएलवालाआं होस हाजी बातमी जोड़्यीही, पोन जे खबर तें उनाअये तियीइ तियांहां किज फायदू ने ओवू; काहाके उनाअनारा ते खबर मोनोमेहें विश्वासो वाअहीं ने स्विकाऱ्यी. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />पोन आपू जियां विश्वास कोअयुहू, तिया आरामोअ जागामेहें जातेहे; जेहेंकोइत तिये कोयोहो,</para>
  <para style="q1" vid="HEB 4:3">“आंय खोतात कोइत शप्पत खादी के,</para>
  <para style="q2" vid="HEB 4:3">तें माआं आरामोअ जागामेहें आवित नाहां सेकानारे.”<verse eid="HEB 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 4:4" />काहाके हाँतवा दिहोअ बाप्तिमेहें तिये वसनोम एहें कोयोहो के, “देवे हांत दिहोम आखे कामें नेवरीत कोइत आराम कोअयू.” <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />आन फाशुउ तो कोहे, “तें माआं आरामोअ जागामेहें आवित ने सेकनारे” <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />ताहां, ए गोठी बाकी होय के, केतेहे तेबी जोएं आरामोंअ जागाम जाअलोअ रोयेहे, आन जियांहां पेल देवोअ हाजी बातमी होंबलाड़्यीही, तें आदेश ने मान्ये तिहीं वाअहीं तें आरामोअ जागाम पोतीत ने सेक्ये. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />तिहीं वाअहीं तिये एक खास दिही ठरवीत कोइत एता दिहोअ फासाड़ी दाविदोअ पुस्तकोमेहें तो</para>
  <para style="q1" vid="HEB 4:7">“आज्युउ दिही” कोहे.</para>
  <para style="q2" vid="HEB 4:7">जेहें कोइत पेल कोयोतो, “जर आज तुमू तियाआ शब्द उनाअहा ताहां, तुमाआं मोन कठीण मा कोअहा.”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />काहाके, जर यहोशवा तियांहां आरामोअ दिहोम पोताड़ी देतू, ताहां देव बिहीरा दिहोअ गोठुन्ने काटतू. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />तियाहा कोत ओं जाइंत ल्या के देवोअ माअहोंअ काजे आरामोअ दिही<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="fq" closed="false">आरामोअ दिही </char><char style="ft" closed="false">आरामोअ हांतवु दिही जो पवित्र दिही होय.</char></note> बाकी होय; <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />काहाके जों बी आरामोअ जागामेहें पोतोहो, तों तियाआ कामे पुरे कोइत देवोअ होस आराम कोअयुहू. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />ताहरेए, आपू बी तिया आरामोअ जागामेहें जाअलोज कोशित कोअहूं जोवे, जेहलोहो इस्राएलवालां देवोअ आदेश तोड़्यू तिहीं वाअहीं तियांहां आरामोअ जागाम ने जाअहूं जोड़्यो तेहेलोहो आपू ने कोइलो.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />काहाके देवोअ वसन जिवतो, काम कोअनारो, कोड्ली बी बेन तार्‍यी तारवाआ रोत जास्ती वाडालो होय, आन जिव आन आत्माहां पेरो-पेरोम आन आडो-आडोम रोत आरपार सोरकीत जाहे आन मोनोअ भावना आन विसारोहो फारकीत लेहे. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />कोलीइ कोड्लीज वस्तु देवोअ नजरे रोत निकाअली कायनाहां, आन तियाहा आखी गोठीइ इसाब आपुहूं पोड़नारु होय, तियाआ डोआअ हुंबर आखी वस्तु खुल्ली आन सापड़े होय.<verse eid="HEB 4:13" /></para>
  <para style="s">डायु पुंजारु ईसु</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />तियाहा कोत जाहां आपाआ एहेलुहू डायु पुंजारु<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="fq" closed="false">डायु पुंजारु </char><char style="ft" closed="false">देवोअ आन माअहोंअ विसमेर्‍युउ वोग्यु</char></note> होय, जो होरगाम गोयुहू, मोन्ज्ये देवोअ बेटुह्हू ईसु, ताहां आवा, आपू जो विश्वास कोअतेहे तियाहा पाक्कू वातड़ू तोइत रोहूं. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />काहाके, आपाआ एहेलुहू डायु पुंजारु कायनाहां जो आपाआ कमजोरी मेहें आपाअरी दुखी ने ओत सेके; पोन तो आपाअ होसर्‍युउ परिक्शाम ते पोड़्यू, तेबी तो निर्दुस निहींयू. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />तियाहा काजे आवा, आपापोअ दया ओवे तेहें कोत दयाआ राजगादीइ<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="fq" closed="false">दयाआ राजगादीइ </char><char style="ft" closed="false">देवोअ बोहीइलोअ कुर्सी.</char></note> सामने हिम्मत कोइत जाहूं आन आपाआ गरज पोड़े तेहेली वेले आपुहूं मदत जोड़ीत सेकुहूं जोवे कोत तियी मेरवानीइं स्विकार कोअहूं.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />काहाके हारेक डाया पुंजाराआ निवड़ माअहूंम रोत ओवेहे आन माअहोंअ काजेज ओवेहे, तों याआ काजे काहाके देवोअ सामने तियांआं पापोअ वोतीइ गाराहा आन भेट आप्या कोअहूं जोवे. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />तो सोताहा ओजाण्याआं आन टाकाअला मिकाअलांअरी नरमायी वाअहीं वागित सेकेहे, काहाके तो सोताहा बी कमजोरीम पोड़्युतो. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />आन तिहींज वाअहीं तियाहा सोताआ पापोअ काजे आन माअहोंअ पापोअ काजे गाराहा आपुहूंज पोड़तोतो. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />आन जाअहूं जाआं आरोनोअ होस देवोअहें रोत ने ठरवाय, ताअहूं जाआं ओं डाया पुंजाराआ पद कोडो बी सोताहाज नाहां लेत सेकतो.<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />तिहींज वाअहीं ख्रिस्ते बी डायु पुंजारु बोणिइलोअ मानपान सोताहा ने लेदू, पोन तियाहा जिये एहें कोयोतो के,</para>
  <para style="q1" vid="HEB 5:5">“तू माआं बेटुह्हू होय, आज मीज ताहूं जल्म आप्योहो,”</para>
  <para style="q2" vid="HEB 5:5">तियेज तो मानपान तियाहा आप्यू. <figure style="fig" alt="High priest with his priestly clothes and censer" file="HK00267C.TIF" size="col" copy="Horace Knowles ©" ref="5:5">पुंजारपणोअ आंगड़े पेवित डायु पुंजारु</figure><verse eid="HEB 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 5:6" />एहेंज कोइत तो बिहीरी जागे बी कोहे,</para>
  <para style="q1" vid="HEB 5:6">“तु मलकीसेदेकोअ रितीइ होस</para>
  <para style="q2" vid="HEB 5:6">हादाजल्म्युउं पुंजारु होय.”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />जाहां ईसु इंहीं धरतीपोअ ओतु तेहेलाम आअड़ी आअड़ीइ आन रोड़ी रोड़ीइ मोतोम रोत वासाड़ीत सेकनारा देवोहो प्रार्थना आन विनंती कोअयी, आन तियाआ हाजी भक्ती वोजेसे देवे तियाआ प्रार्थना होंबलीत लेदी. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />तो देवोअ बेटुह्हू ओत बी तिये दुख वेठी-वेठीइ आदेश मानीइलोअ टेवाअयु. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />आन एहें कोइत तो पाक्कू बोणीत कोइत, जें तियाआ आदेशोअ पालन कोअतेहें तियांआं काजे तो हादाफल्योअ तारण कोअनारु बोण्यु. <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />आन देवे तियाहा मलकीसेदेकोअ रितीइ परमाणे डाया पुंजाराआ पद आप्यो.<verse eid="HEB 5:10" /></para>
  <para style="s">विश्वासोम रोत भटकीइलो फल</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />याआ बाप्तिम आमुहूं जाअखीलीही गोठी कोअलो होय, जियीं गोठीही समजाड़ीलोअ बी कठीण होय, काहाके तुमू समजीइलोम धिमे होय. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />वेल पाल्ल्ये एताम जाआं तुमू गुरु बोणीत जाअहूं जोवतेते, पोन तुमू एहलेहे ओत गोयेहे के सुरवातीमेऱ्योअ देवोअ वसनोअ शिक्शण फाशोअ ओमे सिकाड़ुहूं जोवे. तुमू ताम ओंनोअ बोदले ओंमे जाआं दुदूज जोवे एहेलेहे ओत गोयेहे. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />काहाके दुद पिनारा पोर्‍याहा ताम नितीशिक्शणोअ एती बोठी समज कायनाहां रोती, काहाके तों पोर्‍योज होय. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />पोन जियांआं समज आभ्यास कोइ-कोईइ हाजो-बाक्तो की तो जांइलोम हुशार ओत गोयीही तियां वोडा माहुंउं काजे ओंन होय.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />तियाहा कोत आवा आपू ख्रिस्ताआ सुरवातीमेऱ्याआ शिक्शणो रोत आगाड़ी वोदित पाक्के बोणते साला, आन फालतू कामोअ वोल रोत मोन वालीत देवोपोअ विश्वास कोइलो, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />बाप्तिस्माआं शिक्शण आन आथ मिकीइलो, मोतोम रोत जिवीत उठीइलो,<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">पुनरुत्थान</char></note> आन जलमजुग्युउ न्यायोअ डोंड एहेला शिक्शणोअ पायू फाशुउ ने टाकीइलू. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />जर देवोअ इश्शा ओय ताहां आपू ओंज कोअहूं.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />काहाके जियां एकवारी उजालो देख्यो, आन होरगाआ गोठीइ<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">वरदान</char></note>आनुभाव लेत लेदुहू आन पवित्र आत्माआं भागिदार बोण्येहें, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />आन देवोअ हाजाम हाजा वसनोअ आन आगाड़ी आवनारी जमानाआ सेक्तीइ आनुभाव लेत सुकेहे,<verse eid="HEB 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 6:6" />आन जर तेंज भटकीत जाय, ताहां तें फाशेए मोन फिरावे एहेलोहो ओतीज नाहां सेकतो; काहाके तें देवोअ बेटाह्हाहा फाशेए क्रुस खांबोपोअ<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">आडवु उबु लाकड़ुउ खांब जियापोअ जिवता माहुंहूं खिलावाईं ठोकित टांगी देत्ले.</char></note> टांगतेहें आन माअहूंमेहें तें तियाआ नाव खाराब कोअतेहें. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />काहाके जों खेत ताल-ताल पोड़नारा वोऱ्हातोअ पाईं पिय-पिय खेड़नारा माअहोंअ काजे ओंन पाकाड़ेहे, एहेला खेतोहो देव आशिर्वाद आपेहे. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />पोन जर तों खेत साटवे आन काटेनेहें उगाड़तोय, ताहां तों विणकाम्यों होय आन तियाहा देवोअ हाराप लागुहूं कोअहे, आन तियाहा सेवटीपोअ आगीम पेटाड़ी देये.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />मेराला पाव्हीइला, तुमुहूं ए गोठी आमू कोताहा, पोन तेबी तुमाआं बाप्तिमेहें आमू यारोत हाजी आन तारणवाली गोठीइ भरिवसू कोअताहा के ते तुमू कोअहा. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />काहाके तियाआ काजे तुमू कोअल्यी विश्वासी माअहोंअ सेवा आन तियापोऱ्योअ तुमाआं मेर आन जों बी तुमू कोअया कोअतेहे तों आखो विहीरात जाय एतुहू अन्यायी देव कायनाहां. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />पोन आमाआं जास्ती इश्शा होय के तुमामेर्‍याअ हारेक जोओं जियी गोठीइ तुमू आशा कोइत रोयेहे ते पुरी ओवुहूं जोवे काजे आखरी जाआं कोशित कोअहूं जोवे. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />काहाके यी गोठीम तुमू आलहाय ने कोअहूं जोवे, पोन जें विश्वास आन धिरोवाअहीं देवोअ आथवसनोअ वारीस बोणतेहे तेहेला माअहोंअ फासाड़ी तुमू सालुहूं जोवे.<verse eid="HEB 6:12" /></para>
  <para style="s">ने टोलनारो देवोअ आथवसन</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />देवे अब्राहामोअरी आथवसन लेअली वेले शप्पत खाअलोअ काजेहे तिया रोत वोडो कोडो ने जोड़्यो, ताहां सोताआज शप्पत खात कोइत कोयो, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />“आंय ताहूं खोरीज खुब आशिर्वाद आपिहीं, आन ताआ पोर्‍याहां वादाड़तु जाहीं.”<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">उत्प 22:17</char></note> <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />एहें कोइत तो धिर खेटीत रोयु ताहां देवे आपल्यो आथवसन तियाआ जिवनोम पुरो ओवो. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />माहें ताम जो कोडो वोडो रोहे तियाआ शप्पत खातेहे, आन तियांआं आखी भान्गड़ी मिटाड़ीलोअ काम शप्पतोवाअहीं पाक्को ओवेहे. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />तिये आपल्यो आथवसन केदिहीं नाहां बोदलाअतो ओं तियाआ वारसदारोहों देखाड़ीलोअ देवोअ इश्शा होय, तिहींवाअहीं तिये शप्पत खात कोइत पुरु भरिवसू आप्यू. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />ने बोदलाअनारी बेन गोठीइ वोजेसे देव केदिहींज नाहां ठोगित सेकतु, यीज गोठी वाअहीं आपू तियापोअ पाक्की आशा मिक्यिही, काहाके इंहीं वाअहीं आपुहूं जाअखी हिम्मत जोड़ीत सेकेहे. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />एज आशा आमाआं जिवोअ काजेहे बी एहली लंगरोअ<note caller="+" style="f"><char style="fr" closed="false">6:19 </char><char style="fq" closed="false">लंगरोअ </char><char style="ft" closed="false">जाहाज पाअयोंमेहें उबी कोअत्ले ताहां आलुहूं ने जोवे कोत दोअड़ा वाअहीं नेत हाकले वाअहीं बांदीत कोइत उंडे निसे पाअयोंमेहें टाकीइलोअ एक वजनदार वस्तु, तियाहा कोत्ले लंगर</char></note> होस होय जे एकदम पाक्की आन मजबुत होय, आन ते मंदिरोअ पोड़दाआ फासाड़ी मांयते जाआं पोतेहे. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />जिहीं ईसु मलकीसेदेकोअ होस पिढ़ीन पिढ़ीइ काजे डायु पुंजारु बोणीत, आपाआ वोतीइ आगाड़ी जात मांयते फोटुहू.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">ईसु मलकीसेदेकोअ होसऱ्युउ डायु पुंजारु</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />ओ मलकीसेदेक सालेमोअ राजा, आन आखाम रोत वोडा देवोअ पुंजारु ओतू, जेहलामेहें अब्राहाम राजहांहां हारवीत कोइत वापिस आवतुतो, तेहलाम ओज पुंजारु अब्राहामोहो मिल्युन ताहरुउ तियाहा आशिर्वाद आप्यू. <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />या मलकीसेदेकोहोज अब्राहामे आखी वस्तुउ दाहवू भाग बी आप्यू.<note caller="+" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="GEN 14:17-20">उत्प 14:17-20</ref></char></note> पेल मलकीसेदेक या नावोअ अर्थ, “धर्मी राजा,” एहलोहो ओतो; काहाके तो सालेमोअ राजा ओतू. या नावोअ अर्थ बी “शांतीइ राजा” एहेलोहो बोणेहे. <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />तियाआ कांय आब्हू ने के, आयही ने के, पारवाड़ी बी ने ओती. तियाआ जिवनोअ सुरुवात आन सेवट बी नाहां जोड़ती; पोन तो देवोअ बेटाह्हाआ होस ठरीत कोइत हादाजलम्युउं पुंजारु बोणीत होय.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />ओमें यी गोठीपोअ विसार कोआ के मलकीसेदेक केतुहू वोडु ओतू! जियाहा कुलपती अब्राहामे लड़ायीम रोत जिकीत लेतावल्या हाजाम हाजी वस्तुउ दाहवू भाग आप्यू. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />लेवीइ कुटूंबाम रोत जियांहां पुंजाराआ पद जोड़ेहे तियांहां अब्राहामोअ उब्जीइल्या पोऱ्याप रोत मोन्ज्ये तियांआं पायहोंप रोत, लेखाअला कायदाआ परमाणे दाहवू भाग<note caller="+" style="f"><char style="fr" closed="false">7:5 </char><char style="ft" closed="false">दशांश</char></note> लेअलोअ आदेश होय.<note caller="+" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">गणती 18:21</ref></char></note> <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />मलकीसेदेक लेवीइ पारवाड़ीमेएं ने ओतू तेबी तिये अब्राहामोपोअ रोत दाहवू भाग लेदू, जियाहा देवोअ आथवसन जोड़्योतो तियाहा तिये आशिर्वाद आप्यू. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />वोडो हानाहां आशिर्वाद आपेहे, यामेहें काविहीं फुसुहूं सारकी गोठ कायनाहां. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />आन इंहीं ताम आरवाअनारे एहलेहे माअहें दाहवू भाग लेतेहे, पोन तिहीं तोंज लेहे जियाआ साक्शी आपाअहे के तों जिवतो होय. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />ताहां आपू ओं बी कोत सेकताहा के लेवी बी जे दाहवू भाग लेताहा,ते अब्राहामोअ आथऱ्युउ दाहवू भाग लेताहा. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />काहाके, जेहलाम मलकीसेदेक अब्राहामोहो मिल्यू, तेहलाम लेवी तियाआ बाहा अब्राहामोअ डिलोम ओतू.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />जर लेवीइ पुंजारपणोअ पदो वाअहीं काम पुरो ओत सेकतोतो, जो कायदाआ आधारोपोअ ओतो, ताहां फाशीइ कि गरज पोड़्यी के आरोनोअ बोदले बिहीरु पुंजारु मलकीसेदेकोअ होसऱ्युउ उबू रोत सेके? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />काहाके पुंजाराआ पद बोदलाअहे ताहां कायदु बी बोदलीइलोअ गरज पोड़ेहे. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />काहाके जियाआ बाप्तिमेहें ए गोठी कोयीही के, तो लेवी नाहां पोन बिहीरी पारवाड़ीइ होय, जिहींमेहें रोत कोडे बी देवान्याआं सेवा नाहां कोअयी. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />ताहां खुल्ली गोठ होय के, आपाआ प्रभु यहुदाआ पारवाड़ीम रोत निहींयुहू, यी पारवाड़ीइ बाप्तिमेहें पुंजारपणोअ बद्दल मोशे तोम किन्नाहां कोयो.<verse eid="HEB 7:14" /></para>
  <para style="s">मलकीसेदेकोअ होस बिहीरु डायु पुंजारु</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />आन जाहां मलकीसेदेकोअ होसर्‍युउ फाशुउ बिहीरु एक पुंजारु आवित लागेहे ताहां ए गोठ जाअखी खुल्ली ओत जाहे. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />मोनव्योअ नियमोअ परमाणे तियाहा पुंजारपण नाहां जोड़्यो, पोन अमर जिवनोअ ताकतेए आधारे तियाहा पुंजारपण जोड़्यो. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />काहाके तियाआ बाप्तिमेहें वसन कोहे, “तु मलकीसेदेकोअ होसर्‍युउ पिढ़ीन पिढ़ीइ पुंजारु होय.” <verse eid="HEB 7:17" /><verse number="18" style="v" sid="HEB 7:18" />एहेंकोइत जुनू नियम रद्द ओत गोयू, काहाके तो दुबलू आन ने कामोंअ ओतू. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />काहाके मोशेए कायदा वाअहीं कोड्लीज गोठ हारीपुरी ने ओवी, आन ओमे एती हाजी आशा आपुहूं जोड़्यीही के जिहीं वाअहीं आपू देवोअ हुंबर जात सेकतेहे.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />ओं बी खोरो होय के, देवे ईसुहू शप्पते सिवाय मुख्य पुंजारु नाहां बोणायू. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />काहाके बिहीराहा ताम बिगर शप्पतेए पुंजाराआ पद जोड़्यो, पोन ईसुहू ताम पुंजाराआ पद जोड़्यो तेहलाम देवे तियाआ बाप्तिमेहें शप्पत खादीन कोयो,</para>
  <para style="q1" vid="HEB 7:21">“मी शप्पत खादीही,</para>
  <para style="q2" vid="HEB 7:21">आन माआं ए शप्पत केदिहीं ने बोदलाय,</para>
  <para style="q1" vid="HEB 7:21">काहाके तु पिढ़ीन-पिढ़ीइ पुंजारु होय.”<verse eid="HEB 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 7:22" />यी गोठी वाअहीं ईसु एक वादार हाजी शप्पतोअ जामिन ठर्‍यु.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />बिहीरा डाहटा जोआं पुंजारा बोणता आया, पोन मोते तियांहां ने टिकुहूं देदा, तिहीं वाअहीं ते पुंजारपण कायम सालू ने मिकीत सेका. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />पोन तो पिढ़ीन-पिढ़ी कायम रोहे, तियाहा काजे तियाआ पुंजाराआ पद हादाफल्योअ होय. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />तिहीं वाअहीं जे माहें तिया वाअहीं देवोअ जागे आवतेहे, तियांआं तो पुरोनपुरो तारण कोइत सेकेहे. काहाके, तियांआं वोतीइ रावणी कोइलो काजेहे तो हादाजोलम जिवतु होय.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />तिहीं वाअहीं, एहेलुहू डायु पुंजारु आपाआ काजे रोअहूंज जोवतुतो, काहाके तो पवित्र, निर्दुस आन सोकू होय; आन पाप्यों रोत आंगे, जुगोरोत बी उसू जागू तियाहा जोड़्युहू. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />तियां मुख्य पुंजारकाआं होस तियाहा गरज कायनाहां के रोज पेल सोताआ पापोंअ काजे आन फाशोअ माअहोंअ पापोंअ काजे गाराहा सोढ़वे; काहाके जाहां तिये सोताआ जिवोहो गाराहा कोत सोढ़वी देदो, ताहां तिये तों एक्कुज वारीम हादाजल्म्योअ पुरो कोइ देदो. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />काहाके कायदु ताम कमजोर मोनविही मुख्य पुंजारु कोत उबो कोअहे, पोन तियी शप्पतेए वसन जों कायदाआ फासाड़ी पिढ़ीन-पिढ़ीइ काजे आप्यो, तिहीं वाअहीं देवोअ बेटाह्हाहा हादाफल्युउ पाक्कू डायु पुंजारु बोणावी देदुहू.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">प्रभु ईसु आपाआ डायु पुंजारु</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />ओंमे खास मुद्दाआ गोठ ए होय के, आपाआ काजे एहेलुहू डायु पुंजारु होय, जो होरगामेहें खोराखोर महान राजगादीइ हाजाड़ीइ वोलेहे जात कोइत बोठुहू.<note caller="+" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन 110:1</ref>; <ref loc="HEB 10:12">इब्री 10:12</ref></char></note> <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />आन तो एखे मोनवी बोणावल्या तंबाआ सेवक नाहां, पोन देवे बोणावल्या खोरा तंबाआ तो सेवक बोण्यू.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />हारेक डायु पुंजारु भेट आन गाराहा आपेतेहें काजे नेमाअहे, तियाहा काजे पुंजारापोअ काविहीं तेबी गाराहा आपीइलोअ काजेहे रोअहूं जोवे. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />जर तो धरतीपोअ रोतु, ताहां तो पुंजारु बी ने बोणतु; काहाके कायदाआ परमाणे गाराहा आपनारा ताम होये. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />ते जें कामें कोअताहा, तें होरगामेर्‍यीइ गोठीइ नमुनू आन सावलू जेहें होय तियाआ सेवा ते कोअताहा. जेहलाम मोशे तंबू बोणावनारु ओत्लू तेहेलाम, देवे तियाहा एहें कोयो, “पाल, जो नमुनू ताहूं आंय डोगोपोअ देखाड़्युतो तेहेंज कोइत तु आखी वस्तु बोणावजी.” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />पोन तियां पुंजारा रोत वादार हाजी सेवा ईसुहू जोड़्यी, काहाके तो फाशुउ बी जाअखी हाजी शप्पतोअ वोग्यु ठर्‍यु; जो जाअखा हाजा आथवसनोअ आधारे कोअयोहो.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />जर पेल्लीइ शप्पत निर्दुस रोती, ताहां बिहीरी शप्पतेए गरज ने पोड़ती. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />पोन देवे तियाआ माअहूंमेहें सुक सापड़ावयी, ताहां पाला, तो कोहे,</para>
  <para style="q1" vid="HEB 8:8">“एहेलाहा दिही आवताहा के, जेहेलाम आंय इस्राएली</para>
  <para style="q2" vid="HEB 8:8">आन यहुदाआ माअहोंअरी नोवी शप्पत खाहीं.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />जेहें कोइत आंय तियांआं डायहांअरी शप्पत खादीही</para>
  <para style="q2" vid="HEB 8:9">तेहलिही ए शप्पत नाहां रोनारी,</para>
  <para style="q1" vid="HEB 8:9">तेदिहीं आंय तियांहां आथ तोइत मिसर देसोम रोत बारथे काडीत लेतायु,</para>
  <para style="q2" vid="HEB 8:9">तेबी तें माअरी खाद्ली शप्पतेम इमानदार ने रोये, तिहींइं काजे आंय बी यांआं वोल रोत सोब मुउड़ीत लेदी, एहें प्रभु कोहे.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />तिहींइं फासाड़ी आंय इस्राएल माअहोंअरी एहलीही शप्पत खाहीं ते ए होय के,</para>
  <para style="q2" vid="HEB 8:10">आंय माआं नियम तियांआं मोनोम टाकीहीं,</para>
  <para style="q1" vid="HEB 8:10">तियांआं दिलोपोअ तो लेखी देहीं,</para>
  <para style="q2" vid="HEB 8:10">आंय तियांआं देव आन तें माआं माअहें बोणे.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />‘तुमाआं देवोहो ओलखा’ एहें कोत जागेवाला के पायहोंहों कोअलोअ गरज ने पोड़े,</para>
  <para style="q2" vid="HEB 8:11">काहाके, तिहींमेऱ्येए हाने रोत ते वोडे जाआं आखे माअहें माहूं ओलखे.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />काहाके, आंय दयालु बोणीत गुनाआं माफी कोअहीं,</para>
  <para style="q2" vid="HEB 8:12">आन तियांआं सुकीइ ओर ने कोओ.”<verse eid="HEB 8:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="HEB 8:13" />यी शप्पतेहे “नोवू करार” कोयो तिहीं वाअहीं पेल्लीइ शप्पत जुनी ठर्‍यी. जे वस्तु जुनी आन जिरीत गोयीही ते आरवात जाअहूं कोअहे.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">जुनू पवित्र जागू आन नवू पवित्र जागू.</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />पेल्लीइ तियी शप्पतेम बी भक्तीइ बाप्तिमेहें सेवाआ नियम ओता, तो एक मोनवीइ बोणावल्यू एक सोकु जागू ओतू, जो यी धरतीपोर्‍युउ ओतू. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />काहाके एक तंबू बोणायुतो, आन तिहींमेहें बेन खुली तियार कोअयीते, पेहली खुलीमेहें दिवाआ खांबू,<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="ft" closed="false">दिवू मेकीइलोअ हांत आथ्यु खांबू</char></note> रोटू मेकीइलोअ टेबल, आन भेटेए रोटू ओतू, आन तियाहा सोकु जागू कोतेहे. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />बिहीरी खुली पोड़दाआ फासाड़ी ओती, तिया जागाहा जाअखु सोकु जागू<note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="fq" closed="false">जाअखु सोकु जागू </char><char style="ft" closed="false">परमपवित्रस्थान</char></note> कोतेहे. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />तियामेहें होनाआं देवान्यो आन शारी ओरी होनावाअहीं निपल्यी शप्पतेए पेटी आन तिहींम मान्ना पोअल्यो होनाआं बासन आन आरोनोअ डेंगार जिहींम फुलेन-फलवे आवित गोयेते आन दगड़ाआ कोड़ल्यी शप्पतेए पाटी ओती. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />तियापोअ बेन उजलाफट करुब ओता, जे दयासनोअ टापणापोअ सावलू कोइत ओता, ओं आखो एकेक कोइत फोड़ीत कोअलोअ ओंमे वेल कायनाहां.<figure style="fig" alt="Interior of tabernacle" file="BK00278C.TIF" size="span" copy="Horace Knowles ©" ref="9:2">तंबाआ मायतेवालू भाग</figure><verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />यी पद्धती वाअहीं ए वस्तु तियार कोअयीते. तिया तंबाआ पेहली खुलीमेहें पुंजारा कायम माय जात कोइत सेवाआ कामे पुरे कोअत्ला. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />पोन तंबाआ बिहीरी खुलीमेहें फक्त मुख्य पुंजारु पुरा वोऱ्ह्योंम एकुज वारी जाहे आन रक्त लेयावासी नाहां जातू; आन तों रक्त तियाहा सोताआ वोतीइ आन माअहोंअ पापोअ वोतीइ गाराहा आपीइलो काजे लेत जाअहूं पोड़ेहे. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />यावाअहीं पवित्र आत्मा ओं सिकाड़ेहे के, जाअहूं जाआं तंबाआ पेहली खुली उबी होय ताअहूं जाआं दुसरी खुलीम जाअखा सोका जागाआ खुल्ली वाट कायनाहां. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />ओ तंबू आज्याआ दिहोअ काजे एक नमुनू होय, मोन्ज्ये याआ अर्थ एहलोहो के जे भेट आन गाराहा आपतेहे तिहीं वाअहीं भक्ती कोअनाराआं बुद्दी हारीपुरी नाहां बोणीत सेकती. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />काहाके तें फक्त खाअलोन पिइलोअ वस्तु आन बाती बातीइ सोकालीलोअ रितीइ आधारोपोअ दुन्यादारीइ नियम होय, जे हुदरिइलोअ वेल आवे ताअहूं जाआं ठरवाअला होय.<verse eid="HEB 9:10" /></para>
  <para style="s">ख्रिस्ताअ रक्ताम ताकत</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />पोन ख्रिस्त जाहां आवनारी हाजी-हाजी वस्तुउ डायु पुंजारु बोणीत आयु, ताहां तिये जाअखा हाजा आन पाक्का तंबामेहें रोत आयु जो कोडा मोनवीइ आथेए नाहां बोणायू मोन्ज्ये यी कोलीइ नाहां, <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />आन बोकड़ान वासड़ाआ रक्तावाअहीं नाहां, पोन सोताआ रक्तावाअहीं एकुज वारी सोका जागाम गोयु, आन तिये हादाफल्यीइ सुटका लेत लेदी. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />काहाके जाहां बोकड़ाआ आन बोलदोअ रक्त आन किलवड़ वासड़ीइ खाआं एठा माहूंपोअ हिपड़ीइतेहे, ताहां तिहींमेहें माहुंउं डिल सोको कोइलोअ ताकत होय. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />ताहां जिये सोताआ जिवोहो अमर आत्मावाअहीं देवोअ सामने निर्दुस गाराहा कोत आपी देदू, तिया ख्रिस्ताआ रक्त तुमाआं बुद्दीही तुमू जिवता देवोअ सेवा कोअहूं जोवे काजे खाराब कामोम रोत केहें ने सोको कोइत सेके?<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />ख्रिस्त यीज गोठी वाअहीं देव आन माअहुंउं विसमेऱ्यीइ नोवी शप्पतोअ वोग्यु बी होय, तो याअ काजे काहाके तियाआ मोतो वाअहीं पेल्लीइ शप्पतेए वेले जो पाप ओवू तिहींम रोत सुटका जोड़ुहूं जोवे, आन जें माअहें वायदाअ परमाणे हादाअले तियांहां अमर जिवनोअ वाटू जोड़ुहूं जोवे.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />काहाके, जिहीं शप्पत खावाअयीही तिहीं शप्पत खानाराआ मोत ओवोहो कोत पुरावू देखाड़ीलोअ बी गरज होय. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />काहाके एहलीही शप्पत मोअत्ले ताहांज पाक्की ओवत्ली, आन जाअहूं जाआं शप्पत खानारु जिवतु होय ताअहूं जाआं ते शप्पत किज कामोअ नाहां रोती. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />तिहींवाअहीं पेल्लीइ शप्पत बी रक्ता सिवाय नाहां लेदी. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />काहाके जाहां मोशे कायदामेऱ्याआ आखा आदेश माअहुंहूं कोताप्या, ताहां तिये वासड़ाआ आन बोकड़ाआ रक्त लेत कोइत, पाईंन, लाल पोटको आन रुंगहाल खोड़ोवाअहीं तिया पुस्तकोपोअ ना आखा माहूंपोअ हितड़ी देदो. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />आन ताहरोअ कोयो, “जे शप्पत पालीइलोअ देवे तुमाआं काजे आदेश आप्युहू तियी‍ शप्पतेए ओं रक्त होय.”<note caller="+" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="EXO 24:8">निर्ग 24:8</ref> </char></note> <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />आन तेहेंज कोइत तिये तंबापोअ आन सेवाआ आखा सामानोपोअ रक्त हितड़ी देदो. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />खोरो पाल्ल्ये, कायदाआ परमाणे आखी वस्तु रक्ता वाअहीं सोकी ओवतिही, आन रक्त वोहाड़्या सिवाय गुनाआं माफी नाहां जोड़ती.<verse eid="HEB 9:22" /></para>
  <para style="s">ख्रिस्ताआ गाराहा वाईं गुनाआं माफी</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />तिहीं वाअहीं होरगामेर्‍यीइ वस्तुउ नमुनो यी गाराहा वाअहीं सोको कोइलोअ गरज ओती, पोन यारोत बी जाअखी हाजी गाराहा वाअहीं होरगामेर्‍यीइ वस्तु सोकी कोआतिही. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />काहाके ख्रिस्त आथोवाअहीं बोणावल्या तिया सोका जागाम जो खोरा सोका जागाआ नमुनू होय, तिहीं तो ने गोयू पोन होरगाजमेहें गोयू, मोन्ज्ये तो आपाअ काजे देवोअ सामने हजर ओत सेके. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />जेहेंकोइत डायु पुंजारु जाअखा सोका जागामेहें वोऱ्ह्योअ डिठ डोगरान बोकड़ाआ रक्त लेत जाया कोअहे तेहेंकोइत ख्रिस्ताहा ताल-ताल सोताआ जिवन गाराहा ने कोअहूं पोड़तोतो. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />तेहलोह रोतो ताहां ख्रिस्ताहा दुन्याअ सुरवातिही रोत सोताआ जिवोअ ताल-ताल दुख वेठुहूं पोड़तो. पोन यां आखरीइ दिहोमेहें सोताआ जिव गाराहा कोत आपीत पाप काडीत टाकीइलो काजे तो एक्कुज वारी प्रगट ओवुहू. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />आन जेहलोहो मोनवीइ एकुज वारी मोइलो तिहींरोत न्यायनिवाड़ु ठरवीत मिक्युहू. <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />तेहेंज कोइत ख्रिस्ते बी जाअखीला जोओंअ पापोहों विसीत लेअलोअ काजे एकुज वारी गाराहा बोण्यु; आन बिहीरी वारी तो जें माहें तियाआ वाट जोवतेहे, तियांआं पापोअ काजे नाहां, पोन तियांआं तारणोअ काजे देखाये.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s">ख्रिस्त एक्कुज वारी आखाआ काजे गाराहा बोण्यु</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />काहाके, मोशेए कायदु आवनारी हाजी गोठीइ फक्त एक सावलू होय, तो असली रुप कायनाहां, तियाहा काजे नियमोअ परमाणे वोऱ्ह्योअ डिठ एकुज जातीइ गाराहा वाअहीं आहने आवनारो हारोपुरो नाहां ओत सेकतो. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />जर कायदु माअहुंहूं हारोपुरो कोइत सेकतु, ताहां गाराहा कोइलोअ बोंद काहा ने ओत जातो? काहाके सेवा कोअनारे एकुज वारीम सोके ओत जाते ताहां, तियांआं मोन तियांहां पापी ने ठरवीइतो. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />पोन तियाआ उलटो तों गाराहा वोऱ्ह्योन वोऱ्ह्योअ पापोअ ईतवुउ कोइ देहे. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />काहाके बोलदोअ आन बोकड़ाआ रक्तावाअहीं पाप दुर ओवे एहलोहो ओतीज नाहां सेकतो.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />तियाहा काजे ख्रिस्त यी दुन्याम आवती वेले कोहे के,</para>
  <para style="q1" vid="HEB 10:5">“गाराहा आन भेट ताहूं ने जोवयी,</para>
  <para style="q2" vid="HEB 10:5">पोन तुमे माआं काजे एक शरीर तियार कोअयो.”<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />कोड्लीज गाराहा वाअहीं देव खुस नाहां ओवू.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />ताहां आंय कोयो, “देवा, मोशेए पुस्तकोमेहें माआं बाप्तिम लेख्याआ परमाणे,</para>
  <para style="q2" vid="HEB 10:7">देख, आंय ताआ इश्शा पुरी कोउ आवित लागुहू!”<verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />उसे ताम तो कोहे के, “कोड्लीज गाराहा<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="fq" closed="false">गाराहा </char><char style="ft" closed="false">मेलबली, होमबली आन पापबली</char></note> आन भेट ताहूं ने जोवयी, तियांवाअहीं तु खुस ने ओवू,” भले आखी गाराहा नियमोंअ परमाणे आपाअयाज कोअतीते, <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />तेबी कोहे, “देख, ताआ इश्शा पुरी कोइलोअ काजे आंय आवित लागुहू,” ताहरुउ तो पेल्लाआ तियाहा उठाड़ी देहेन बिहीराहा बोहाड़ेहे. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />देवोअ तियीज इश्शा वाअहीं आपू ईसु ख्रिस्ताआ शरीरोअ एकुज वारी ओवल्या गाराहा वाअहीं पवित्र कोआयेहे.<figure style="fig" alt="Burnt offering on an altar" file="HK00256C.TIF" size="col" copy="Horace Knowles ©" ref="10:10">देवान्यापोऱ्यीइ गाराहा</figure><verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />आखा यहुदी पुंजारा दाड़ख्याआ सेवा कोअताहा, तिया वाअहीं पाप नाहां तुवाअतू तेबी ते एहलोहो गाराहा ताल ताल आप्या कोअताहा. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />पोन ओ माटी ताम पापोअ बोदले हादाजल्म्युउं गाराहा एक्कुज वारीम आपी देत देवोअ हाजाड़ीइ वोल जात बोठुहू. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />आन तोयोंअ रोत तियाआ दुस्मोन तियाआ गुडाआ थुड़ीइ पाट्लू बोणुहूं जोवे यी गोठीइ तो वाट जोवया कोअहे. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />काहाके जें पवित्र ओवतेहे तियांहां एकीज गाराहा वाअहीं पापोम रोत एकसोट्येज हारेपुरे कोइ देदेहे.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />पवित्र आत्मा बी याआ बाप्तिमेहें आपुहूं साक्शी आपेहे. काहाके तिये पेल कोयोतो,<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />देव कोहे, “तियां दिहोअ फासाड़ी,</para>
  <para style="q2" vid="HEB 10:16">तियांअरी शप्पत खाहीं ते एहलिही होय के,</para>
  <para style="q1" vid="HEB 10:16">आंय माआं नियमोहों तियांआं मोनोम लेखिहीं,</para>
  <para style="q2" vid="HEB 10:16">आन आंय तियांआं दिमाकोम टाकिहीं.”<verse eid="HEB 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 10:17" />फाशुउ तो एहें कोहे, “आंय तियांआं गुना आन तियांआं खाराब कामोहों फाशुउ केदिहीं ओर ने कोओ.” <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />आन जिहीं गुनाआं माफी ओत गोयीही, तिहीं फाशोअ पापोअ काजे गाराहा आपिइलोअ ने रोयो.<verse eid="HEB 10:18" /></para>
  <para style="s">देवोअ आहने आवा</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />तिहींइं काजे पाव्हीइला, आपुहूं ईसुउ रक्ता वाअहीं जाअखा सोका जागाम जाअलोअ हिम्मत जोड़ेहे. <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />जो तिये पोड़दामेहें मोन्ज्ये सोताआ शरीरोमेहें रोत आपाआ काजे ते नोवी आन जिवती वाट थापन कोअयिही. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />आन तिहीं वाअहीं आपुहूं एहेलुहू महान पुंजारु जोड़्युहू जो देवोअ कोर्‍युउ आधिकारी होय. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />ताहां साला, आपू खोरा मोनोवाअहीं आन पुरा विश्वासोवाअहीं, बुद्दीइ दोश दुर कोइलोअ काजेहे मोन हितड़ावल्यो आन सोका पाअयों वाअहीं तुवल्यो शरीर लेत कोइत देवोअ आहने आवा. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />आवा आपू जे आशा तोअयिही तिहींम वातड़े रोहूं, काहाके जिये आथवसन आप्योहो, तो इमानदार होय. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />आन एकमेकाहा समजीत लेहूं आन मेर, हाजे कामे कोए तेहें काजे एकमेकाहा हिम्मत आपहूं. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />आन जेहलोहो बिहीरे वारुज जोएं कोअतेहे तेहेलोहो तुमू एकमेकाहा मिलीइलोअ मा सोड़हा, पोन एकमेकाहा समजाड़ते रोवा; आन जेहें जेहें तो दिही आहने आवत्लू देखाअहे, तेहें तेहें या रोत वादार कोअते जावा.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />पाव्हीइला, जर आपू खोरो कि होय तो जाइंत बी देखदेखीइज पाप कोअते रोहूं, ताहां फाशोअ पाप माफीइ काजे बिहीरो गाराहा बाकी नाहां रोयो. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />पोन होव! एक खुब वोडु न्यायनिवाड़ु आन आगीमेहें पेटाइलोअ बाकी रोयोहो, जों आखा दुस्मोनोहों खाँआं वाली देय. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />जाहां मोशेए नियम ने माननाराहा बेन नेताहां तीन साक्शी वाअहीं वाहीं दया माया ने कोअत्ले पोन माइत टाकत्ले. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />ताहां विसार कोआ, जिये देवोअ बेटाह्हाहा गुडाआ थुड़ी सेंद्यु आन शप्पतेए रक्ताहा, जिहींवाअहीं तो पवित्र ठऱ्यू तिया रक्ताहा एठो होमजेहे, आन जिये मेरवानींइं आत्माआं बेइजती कोअयी तियाहा केतुहू वादार डोंड जोड़े तुमुहूं मुंदू होय! <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />काहाके आपू तियाहा ओलखीइतेहे के, जो कोहे, “बोदलू लेअलोअ माआं काम होय, आंयज बोदलू आपिहीं.” आन फाशोअ एहें कोहे के, “प्रभु सोताआ माअहोंअ न्याय कोए.” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />जिवता देवोअ आथोम पोड़ीइलो सादी गोठ कायनाहां.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />पोन फासल्याआ तियां दिहोअ ओर कोआ, जियां दिहोम तुमुहूं उजालो जोड़तोतो, तेहेलाम तुमू वोडी हाकड़ेम बी टिकीत रोये. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />केतीही वारी ताम तुमाआं बेइजती ओवी आन तुमू गाई खादी, आन केतीही तेबी वारी तुमू तारास वेठनाराअरी तारास वेठीइलोम भागिदार बोण्ये. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />काहाके तुमू जें तोआत जेलेम गोये तियांअरी बी मिलीत दुख वेठ्यो. आन तुमापोअ जे मालमिलकोत ओती तेबी खुसीवाअहीं लुटुहूं देदी: काहाके तुमापोअ यारोत बी जाअखी हाजी आन कायम टिकनारी मालमिलकोत होरगामेहें होय ओं तुमुहूं मुंदू ओतो. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />तियाहा काजे तुमाआं हिम्मत मा सोड़हा, काहाके तियाआ बक्शीस वोडो होय. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />तुमाआं धिर खेटीइलोअ गरज होय, मोन्ज्ये तुमू देवोअ इश्शा पुरी कोइत तियाआ आथवसनोअ बक्शीस तुमुहूं जोड़ुहूं जोवे. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />वसन कोहे के,</para>
  <para style="q1" vid="HEB 10:37">“ओमे जाअखीज थोड़ी वेल रोयीही;</para>
  <para style="q2" vid="HEB 10:37">काहाके जो आवनारु होय तो आवे,</para>
  <para style="q2" vid="HEB 10:37">तो वाआ ने लागाड़े.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />पोन माआं धर्मी माहुंउं विश्वासोवाअहीं जिवतो रोय,</para>
  <para style="q2" vid="HEB 10:38">आन जर तों वापिस जातो रोय,</para>
  <para style="q2" vid="HEB 10:38">ताहां माआं मोनोहो खुसी ने ओवे.”<verse eid="HEB 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39" />पोन आपू ताम आरवाइलोअ काजे फासाड़ी होरकीत वापिस जानारामेर्‍येए कायनाहां, पोन विश्वास कोइत जिव वासाड़नारामेर्‍येए होय.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">विश्वासोअ ताकत</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />विश्वास आशा कोअल्यी गोठीइ भरीवसू आन ने देखाअनारी गोठीइ बद्दल पुरावू होय. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />काहाके यी गोठीइ बाप्तिमेहें आपाअ पेल्लाआ डायहांआं साक्शी हाजी नावलाअयिही.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />विश्वासोवाअहीं आपुहूं जाआंत जाहे के आखी कोल देवोअ शब्दावाअहीं बोण्यीहीं. मोन्ज्ये जे देखाअनारी गोठी होय, तियीं वाअहीं नाहां बोण्यी. <verse eid="HEB 11:3" /><verse number="4" style="v" sid="HEB 11:4" />विश्वासोवाअहींज हाबेले काइनो रोत हाजो गाराहा देवोअ काजे आप्यो; तिहीं वाअहीं तियाहा धर्मी होय कोत साक्शी जोड़्यी. काहाके देवे तियाआ भेटेए बाप्तिम साक्शी आप्यी. तियाहाज काजे तो मोइत गोयुहू तेबी गोग्याज कोअहे.<note caller="+" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="GEN 4:3-5">उत्प 4:3-5</ref></char></note><verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />हनोकोहो मोतोअ आनुभाव ने आवुहूं जोवे कोत तियाआ विश्वासोज वाअहीं तो उसे विसाइत गोयू, आन तियाआ पोत्तुज ने लागू, काहाके देवे तियाहा विसीत लेदू, आन तियाआ विसाइलोअ पेल, “तिये देवोहो खुस कोअयू” एहलिही साक्शी आप्यी.<note caller="+" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="GEN 5:21-24">उत्प 5:21-24</ref></char></note> <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />विश्वासो सिवाय देवोहो खुस नाहां कोइत सेकते. काहाके देवोअ जागे आवनारो एहें कोत विश्वास कोअहूं जोवे के तो होय, आन जें माहें तियाहा खोरा मोनोवाअहीं होदतेहे, तियांहां तो बक्शीस आपेहे.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />विश्वासोवाअहीं नोहे वेगी केदिहीं नाहां देख्यी एहली गोठीइ सुसना जोड़्यी तेहेलामेहें आदरमानो वाअहीं भक्ती कोइत सोताआ कुटूंबाहा वासाड़ीलोअ काजेहे जाहाज बोणायी, आन एहें कोइत तिये दुन्याहा दोशी ठरव्यी आन विश्वासो वाअहीं तो धर्मी जिवनोअ वारिस बोण्यु.<note caller="+" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 6:13-22">उत्प 6:13-22</ref>; <ref loc="GEN 7:1">7:1</ref></char></note><verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />विश्वासोज वाअहीं अब्राहामे देवे हाद्यू, ताहां आदेश मानित एहलिही जागे निहीत गोयु के तो जागू तियाहा वारिस हक्काजमेहें जोड़नारु ओतू; तियाहा काअली वोग जाअलोअ तोंज ने मुंदू ओतू तेबी तो निहींत गोयू. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />विश्वासोज वाअहीं, तो आथवसन जोड़ल्या देसोम पोरदेसीइ होस रोयू; आन तियीज जागेहे तियाआ वारिस इसाहाक आन याकोब यांअरी तो तंबामेहें वोहती कोइत रोयू. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />काहाके, जियाआ योजना कोअनारु आन बांदनारु देवुज होय एहला होयरोअ तो वाट जोवतुतो.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />विश्वासोवाअहींज, सारा डायी ओत गोयी तेबी तियीही पोर्‍याहा जल्म आपिइलोअ ताकत जोड़्यी; काहाके तियी आथवसन आपनाराहा इमानदार समज्युतो. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />तिहींज वाअहीं फक्त एकाज पोअ रोत, जो मोअहूं वाटे लागुतो एहला डायापोअ रोत जुगोमेर्‍याआ ताराआ होस आन दोर्‍याआ मेरेपोर्‍याआ रेटाआ होस गोणाय ने एतीही पारवाड़ी उब्ज्यी.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />एं आखे विश्वासोम रोत कोअतीज मोये; तियांहां देवे आपल्यो आथवसन पुरो ओवत्लो ने देखाअयो. पोन सेटेज रोत पालीत कोइत खुस ओवे आन तियां मानित लेदो के, “आपू धरतीपोअ पारके आन वाटहारे होय.” <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />जें एहलिही गोठी कोतेहे, तें ओं देखाड़तेहे के तें वावड़्या देसोअ होदवाली होय. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />आन जिया देसोम रोत तें निहीत आयेते, जर तियाआ विसार कोअते ताहां तियांहां वापिस जाअलाआ सान्सो ओतो. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />पोन ते‍ं एक जाअखा हाजा मोन्ज्ये होरगाआ देसोअ लालस कोअतेहे, तिहींवाअहीं देवोहो बी तियांआं देव एहें कोत कोवड़ाइलोम नाहां लाज आवती, काहाके तिये तियांआं कोअते एक होयर बोणायोहो.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />विश्वासोज वाअहीं अब्राहामे तियाआ परिक्शाआ वेले इसहाकोहो गाराहा कोत आपी देदू; जियाआ बाप्तिम तिये देवोअ आथवसन खोरो मान्योतो.<note caller="+" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="GEN 22:1-10">उत्प 22:1-10</ref></char></note> <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />आन तियाआ बाप्तिम देवे तियाहा कोयोतो के, “इसहाकोपोअ रोत ताआ पारवाड़ साले.” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />काहाके अब्राहामे समजीत लेदो के, देव तियाहा मोल्याम रोत बी जिवाड़ीत सेकेहे; एहेंकोइत एक पाल्ल्ये इसाहाक तियाहा मोल्याम रोतुज वापिस जोड़्यू.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />विश्वासोज वाअहीं इसहाके याकोबोहो आन एसावोहो आवनारी गोठीइ बाप्तिमेहें आशिर्वाद आप्यू.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />विश्वासोज वाअहीं याकोबे मोइले वेले योसेफोअ बेनू पोर्‍यांम रोत एकेकाहा आशिर्वाद आप्यू आन डेंगारीइ सेंडीइ टेकु लेत कोइत वोंद्यो.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />विश्वासो वाअहीं योसेफे जेहलाम तो मोइत जाय एहेलुहू ओतू, तेहलाम इस्राएलवालाआं निहींत जाअलोअ सर्सा कोअयी आन तियाआ आडोअ बाप्तिमेहें आदेश आप्यू.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />विश्वासोज वाअहीं मोशे ऊब्जीइयू तोयोंअ रोत तियाआ आयहीन आब्हू तियाहा तीन मोयना जाआं निकाड़ीत मिक्यू, काहाके पोर्‍यू हाजूबी होये ओं तियां देख्यू, आन तियांहां राजाआ आदेशोअ बिक ने लागी.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />विश्वासोज वाअहीं मोशे, वोडू ओयु तेहलाम फारो राजाआ बेटिह्हीइ पोर्‍यू कोवड़ाइलोअ नाकारी देदो. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />काहाके तियाहा पापोम थोड़ा दिहोअ सुख भोगीइला पेक्शा देवोअ माअहोंअरी दुख भोगीइलोअ जाअखो पसन कोअयो. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />तिये ख्रिस्ताआ वाखरी निंदा वेठीइलोअ मिसर देसोअ धनो रोत जाअखु वोडु लाभ होमज्यो, काहाके तारासोअ बोदले भविश्याम मिलनारा बक्शीसोअ वोग तियाआ नजर ओती.<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />विश्वासोज वाअहीं तो राजाअ खोतेहे ने बियू आन मिसर देसोहो सोड़ी देदू, काहाके जो नाहां देखाअतू तियाआ वोल तो देखत्लाआ होस मजबुत रोयू. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />विश्वासोज वाअहीं तिये वल्हांडण आन रक्त हितड़ीइलोअ नियम मान्य कोअयू, काहाके आरिवनारु इस्राएली माअहुंहूं आथ ने लागाड़ुहुं जोवे.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />विश्वासोज वाअहीं, तें लाल दोर्‍याम रोत कोअड़ी पुयींपोअ सालत्लाआ होस मेरे उनकीत गोये आन मिसरवाले बी तेहेंज कोए गोयेन आखेज मिलीत बुडीत मोये.<note caller="+" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="EXO 14:21-31">निर्ग 14:21-31</ref></char></note><verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />विश्वासो वाअहीं जाहां इस्राएली माहें यरीहोअ पितड़ाआ मेरेमेरे हांत फेरी मार्‍यी ताहां तों खोहलात पोड़्यो. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />विश्वासोवाअहीं, राहाब रांडी<note caller="+" style="f"><char style="fr" closed="false">11:31 </char><char style="ft" closed="false">वेश्या</char></note> आदेश तोडनारांअरी ने आरवाअयी; काहाके तियी देस हेअनारा तिरवाश्याहां<note caller="+" style="f"><char style="fr" closed="false">11:31 </char><char style="ft" closed="false">हेरोहों</char></note> कोअमेहें निकाड़ीत मिक्याते.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />ओमें आंय फाशुउ केतुहू जाआं कोत देखाड़ो? गिदोन, बाराक, शिमशोन, यिप्तह, दाविद, शमुवेल आन भविश्यवक्ता यांआं बाप्तिमेहें आंय कोनु वोलो ताहां वेल ने पुरनारी. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />यां विश्वासो वाअहींज राज्ये जिक्ये; हाजे कामे कोअये, देवोअ आपल्या आथवसनोअ फल देख्यो, सिहांवागोअ जोड़बे बोंद कोअये. <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />आगीइ हेकेहे हेली कोअयी; तारवारीइ तारे रोत वासात निहींये; कमजोरीमेहें ताकत जोड़्यी; लड़ायीमेहें बाहदिर निहींये; बिहीरा देसोवाला सेयनिकोहों ओड़ीत काड्या.<verse eid="HEB 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 11:35" />वारुज बोईंहीं तियींइं मोल्या माटी फाशाआ जिवता ओवीत वापिस मिल्या; वारुज जोओं ताम वापिस जिवित उठीइलो काजेहे मार खाता खाता मोइत गोया पोन सुटका ने होद्यी. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />वार जोएं ताम निंदा वेठीइलोम, सापका खाअलोम, बेड़ीम के जेलेम पोड़ीइलोम पारजाणाम पोड़्ये. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />डोणोअ मारु खादू; करवती वाअहीं सिराअये; तियांआं परिक्शा ओवी; तारवारी वाअहीं मोये; हाकड़ेमेहें आन तारासोमेहें, दुख वेठते जात मेडांआं आन बोकड़ाआ सांबड़े फांगते जात इंहींन-तिहीं वाजते इंड्ये; <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />आन रानोमेहें, डोगोमेहें, कुपामेहें आन धरतीइ कापड़ाटामेहें भटकिइते फिर्‍ये. काहाके दुन्या तियांआं काजे ने हाजी ओती. <verse eid="HEB 11:38" /><verse number="39" style="v" sid="HEB 11:39" />यां आखाहा विश्वासोज वाअहीं हाजी साक्शी जोड़्यी, तेबी तियांहां आथवसन आपल्यी वस्तु ने जोड़्यी. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />आपाआ काजे देवे हाजाम हाजी गोठ ठरवित मिक्यी काहाके ते आपा वाअहींज पुरी ओत सेकुहूं जोवे.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">विश्वासोअ मुख्य नमुनू ईसु</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />तियाहा काजे साक्शीइ एती वोडी गर्दी आपुहूं केंडवारीत होये, ताहां आवा, हारेक रुकनारी वस्तू आन हेलमेहें गुसवीइनारा पापोहो सोड़ीत, आपुहूं ठरवीत आपल्या गुगदीइलोअ पोट्टापोअ बागे रोत गुगदुहूं. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />जो विश्वासोअ थापनारु आन पुरो कोअनारु होय तिया ईसुउहें ध्यान लागाड़ीत रोहूं, जिये तियाआ आगल्‍यीइ खुसीइ काजे, लाज सोड़ीत क्रुस खांबोअ दुख वेठ्यो, आन ओमे तो देवोअ राजगादीइ हाजाड़ीइ वोलेहे जात कोइत बोठुहू.<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />तियाहा कोत तियापोअ मोन लागाड़ा, जिये सोताआ विरुद्दामेहें पापी माअहोंअ एतुहू वोडू विरोध वेठीत लेदू, काहाके तुमू नाराज ओत कोइत हिम्मत ने सोड़ी देअहूं जोवे. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />तुमू पापोअरी सुलाअता सुलाअता रक्त वोहे एतुहू विरोध नाहां जी कोअयू. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />आन तुमुहूं बेटाह्हाआ होस कोल्यी गोठी विहीरात गोयेहे के?</para>
  <para style="q1" vid="HEB 12:5">“माआं पोर्‍यां, प्रभुउ शिक्शाहा ओल्की मा जाअहीं,</para>
  <para style="q2" vid="HEB 12:5">आन तो ताहूं हेकाटे, ताहां नाराज मा ओवीही.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />काहाके प्रभु जियापोअ मेर कोअहे,</para>
  <para style="q2" vid="HEB 12:6">तियाहा तो शिक्शा बी कोअहे आन जियाहा तो तियाआ बेटुह्हू कोत मानेहें, तिया हारेक जोओंहों तो थापुड़ बी देहे.”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />तुमू कठीण दुखोहो तियाआ हानेए काजे होय कोत मानित ल्या ताहां, काहाके देव बी तुमुहूं बेटेह्हे कोत मानेहे. कोडो एहेलोहो पोऱ्यो होय, जियाहा हानेए काजे थापुड़ ने पोड़तीय?<note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="PRO 3:11">निती 3:11</ref>,<ref loc="PRO 3:12">12</ref>; <ref loc="DEU 8:5">कायदा 8:5</ref>; <ref loc="2SA 7:14">2 शमु 7:14</ref></char></note> <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />पोन जे शिक्शा आखाहाज जोड़ेहे, पोन तुमुहूं ने जोड़तीय, ताहां तुमू सिनालोअ पोर्‍ये होय खोरे पोर्‍ये कायनाहां. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />जेहलाम दुन्यामेऱ्युउ आपाआ आब्हू जाआं हानेए कोअते थापुड़ देहे, तिहींइं बोदले आपू तियाआ आदर कोअतेहे, ताहरेए आपू आपाआ आत्मिक आब्हाआ ताबाम रोत कोइत काहा ने जिवुहूं जोवे? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />दुन्यामेऱ्युउ आब्हू ताम जिवज्योअ होमोजोअ परमाणे थोड़ा दिहोअ कोअते शिक्शा कोअहे, पोन देव ताम आपाआ हाजाआ कोअते कोअहे, काहाके आपू बी तियाआ पवित्रतामेहें सामिल ओवुहूं जोवे एहलिही तियाआ इश्शा होय. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />कोड्ली बी शिक्शा वाअहीं खुसी ताहरीइ नाहांज ओवती पोन दुख लागेहे, तेबी जियांहां तियी शिक्शाआ आनुभाव जोड़्युहू, तियांहां आगाड़ी जात धर्मी जिवन आन शांती जिवनोअ फल जोड़ेहे.<verse eid="HEB 12:11" /></para>
  <para style="s">सुसना आन सेतावणी</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />तियाहा काजे तुमाआं डिल्ला आथ उसे कोआ आन तुमाआ कापाऱ्या गुडा वातड़ा कोआ! <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />आन तुमाआ गुडाआ काजे सिदी वाट तियार कोआ लेंगड़ाआं गुडा मुड़ात ने जाअहूं जोवे, पोन हुदरीत जाअहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">निती 4:26</ref> </char></note><verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />आखा माअहोंअरी होकेहे रोवा आन पवित्रता होदीइलोअ कोशित कोआ. काहाके तिया सिवाय कोडाहाज प्रभुउ दर्शन नाहां जोड़नारो.<note caller="+" style="x"><char style="xo" closed="false">12:14 </char><char style="xt" closed="false"><ref loc="1PE 3:11">1 पेत्र 3:11</ref>; <ref loc="PSA 34:14">भजन 34:14</ref></char></note> <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />वारुहूं पालते रोवा, काहाके कोडोज देवोअ मेरवानी रोत सेटे ने रोअहूं जोवे, नेताहां जाअखिलेहे जोएं बिगड़ीत जाय एहलोहो एखू कड़वो मुल फुटीत कोइत तुमुहूं तारास ने देअहूं जोवे. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />कोडो बी सिनाल ने रोअहूं जोवे, नेताहां एकी वेलेए रोटाआ कोअते तियाआ डाया पायहोअ आधिकार वेसनारा एसावोअ होसर्‍योअ दुन्यादारीइ विसारोवालो ने जोवे याअहें तुमू द्यान द्या. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />तुमुहूं मुंदूज ओय के, सेलीसेलवाआ तो आशिर्वादोअ काजे रोड़ी रोड़ीइ थाकीत गोयू, पोन आशिर्वाद ने जोड़्यू तेबी तियाआ आब्हाआ मोन तो बोदलीत ने सेक्यु.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />जिया डोगोहो आथ लागाड़ीत सेकतेहे; जो आगीइ हांगाड़ा वाअहीं पेटाअतुतो, आन काल्लो वाद्लो, आन आंदारो, आन वादुउ यां वाअहीं पोआलू ओतू तियाआ जागे तुमू नाहां आये. पोन एक नविल जागे आयेहे. <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />आन तुरीइ वोडू बी आवाज आन गोगनाराआ एतू वोडू आवाज के, तो आवाज उनाअनारे माहें विनंती कोए वोल्ये, “ओंमे रोत आमू जाअखी गोठी नाहां उनाअते.” <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />काहाके तें तियाआ तो आदेश सहन ने कोइत सेक्ये: “जर एखू जनवार बी डोगोहो टेके, ताहां डोणो वाअहीं देअहूं जोवे.” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />आन तों दर्शन एतोहो बिवाड़े एहलोहो ओतो के मोशे कोत पोड़्यू, “माहूं जाअखीलिही बिक लागेहे आन कापाड़ेहे.”<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />पोन तुमू ताम सियोन डोगोअ जागे आन जिवता देवोअ होयर, होरगाआ येरुसालेमोअ जागे लाखेन लाख देवदुत <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />आन देवोअ डाया पोऱ्याआं सभा आन मंडड़ी जियांआं नावे होरगाम लेखाअयेहे, आन आखाआ न्यायनिवाड़ु कोअनारा देवोअ जागे, पाक्की कोअल्यी धर्मी माअहोंअ आत्मा, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />आन नोवी शप्पतेए वोग्यु ईसु, आन हितड़ावल्या रक्ताआ जागे तुमू आयेहे, जो हाबेलोअ रक्ता रोत बी जाअखो हाजी गोठी कोअहे.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />हेएजा, आन जों कोत आपनारो होय तियाअहें सोब मा मुंउड़ाहा, काहाके तें माअहें जाआं धरतीपोर्‍याआ सुसना आपनाराअहें रोत सोब मुंउड़ीत लेदी तें जाआं ने वासाअये, ताहरेए आपू होरगाम रोत सुसना आपनाराअहें रोत सोब मुउड़्यी ताहां केहें कोइत वासाअहूं? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />तिया गालाहा ताम तिये शब्दाज वाअहीं धरती आलवीत टाक्यी, पोन ओंमे तिये एहें कोत‍ आथवसन लेदोहो के, “आंय फाशुउ एकवारी जाआं निस्ती धरतीज नाहां, पोन जुग बी आलविहीं.” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />आन “फाशुउ एकवारी जाआं” यी गोठीइ अर्थ होये के, जे वस्तु आलीत जातिही, ते वस्तु बोणावल्यी होय तिहींवाअहीं निहींत जानारी; काहाके जे वस्तु नाहां आलती ते टिकीत रोअहूं जोवे.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />तियाहा काजे आपुहूं एहेलोहो टिकनारो राज जोड़ेहे जो आलीत नाहां सेकतो, आवा, आपू देवोअ धन्यवाद कोअहूं, आन आदरमान, भक्तिभावो वाअहीं तियाहा गोमे एहेलिही आराधना कोअहूं; <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />काहाके आपाआ देव खाँआन खाँआं वालीत टाकनारी आग होय.<note caller="+" style="f"><char style="fr" closed="false">12:29 </char><char style="ft" closed="false">सादी आग नाहां</char></note><verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">ख्रिस्ती जिवन जिवीइलोअ सुसना</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />विश्वासी कोत एकमेकाअरी मेर कोइत रोवा. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />पावणाय तोइलोअ विहिराअहा मा. काहाके यावाअहीं थोड़हा जोओं ओजाणेमेहें देवदुतोंअ पावणाय कोअयिही. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />जें जेलेम होय तियांअरी तुमू सोताहा जेलेम होय एहलोहो होमजीत तियांआं कालजी ल्या. तुमाआं बी डिल होय, ओं इतवीत जें दुख वेठतेहे तियांआं बी कालजी ल्या.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />वेहवाल आखामेहें मानपानोअ गोठ कोत मानुहूं जोवे, आन आथरुउ सोको मिकुहूं जोवे.<note caller="+" style="f"><char style="fr" closed="false">13:4 </char><char style="ft" closed="false">बेनु एकमेकाअरी इमानदार जोवे</char></note> काहाके जें सिनालो कोअतेहे, आन बिहीराआ बोईंहीं राखतेहें, तियांआं न्यायनिवाड़ु देव कोए.<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />तुमाआं सोभाव पोशाअ लालसवालू ने जोवे, आन जों तुमापोअ होय तियाजमेहें खुस रोवा; काहाके तिये सोताहा कोयोहो के, “आंय ताहूं केदिहीं ने सोड़ो, आन ने केदिहीं टाको.” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />तियाहा काजे आपू मानमुखाऱ्येज कोत सेकतेहे,</para>
  <para style="q1" vid="HEB 13:6">“माहूं मदत कोअनारु माआं देव होय,</para>
  <para style="q2" vid="HEB 13:6">तियाहा काजे आंय नाहां बिनारु;</para>
  <para style="q1" vid="HEB 13:6">मोनवी माआं कि कोइत सेकेहे?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />जियां तुमुहूं देवोअ वसन सिकाड़्यो तियां सेवकोअ ओर मिका; आन तियांआं हाजा गुण<note caller="+" style="f"><char style="fr" closed="false">13:7 </char><char style="fq" closed="false">गुण </char><char style="ft" closed="false">सोभाव</char></note> देखीत कोइत तियांआं होऱ्युउ विश्वास लेत साला. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />ईसु ख्रिस्त काल, आज आन पिढ़ीन पिढ़ी एकसारकुज होय.<note caller="+" style="x"><char style="xo" closed="false">13:8 </char><char style="xt" closed="false"><ref loc="PSA 90:2">भजन 90:2</ref>; <ref loc="REV 1:8">प्रगटी 1:8</ref>; <ref loc="ISA 41:4">यश 41:4</ref></char></note> <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />जुदी जुदी बातीइ शिक्शणो वाअहीं भटकीत मा जाहा, काहाके देवोअ मेरवानीम मोन वातड़ो मिकीइलो हाजो होय, आन खाअलोअ वस्तुउ नियमोअ पालनी वाअहीं कोडाहा बी लाभ नाहां ओवू.<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />जिया देवान्यापोऱ्यीइ वस्तु खाअलोअ आधिकार मंडपोम सेवा कोअनाराहां जाआं कायनाहां, एहलोहो एक देवान्यो आपाअ जागे होय. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />काहाके जियां जनवारोअ रक्त मुख्य पुंजारु जाअखा सोका जागाम पापोअ बोदले गाराहा लेत जात्लु, तियां जनवारोअ तोड़ पोड़ावाआ बारथे पेटाड़त्ले. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />तिहींज वाअहीं, ईसु बी सोताआ रक्ता वाअहीं माअहुंहूं पवित्र कोइलोअ काजेहे गांव-हींवोंअ बारथे दुख वेठ्यो. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />तियाहा काजे आवा, तियाआ निंदा सोतापोअ लेत कोइत गांव-हींवोंअ बारथे तियाआ जागे साला.<note caller="+" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="LUK 6:22">लुक 6:22</ref></char></note> <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />काहाके इंहीं आपाआ कोड्लोज टिकनारो होयर कायनाहां, आपू ताम आवनारा होयरोअ ताकेम होय. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />तियाहा कोत आपू स्तुतीरुप गाराहा, मोन्ज्ये तियाआ नाव कबुल कोअनारा ओठोअ फल ख्रिस्ता वाअहीं देवोहो कायम आप्या कोइलो. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />बिहीराआ काजे हाजो कोइलो आन दानधर्म कोइलोअ मा विहीराअहा; काहाके एहलोहो गाराहा देवोहो गोमत्लो.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />तुमाआं सेवकोंअ गोठी माना आन ते जेहें कोय तेहें कोआ. काहाके तुमुहूं सांबालीलोअ जाबाबदारी तियांपोअ होय, आन तियांहां देवोहो इसाब आपुहूं पोड़नारु होय. तिहीं वाअहीं तियांआं गोठी माना मोन्ज्ये ते नाराज ओत नाहां खुसी वाअहीं तियांआं काम कोइत सेके.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />आमाआं काजे प्रार्थना कोअते रोवा, काहाके आमुहूं भरिवसू होय के आमाआं बुद्दी सोकी होय: आन आखी गोठीमेहें आमू हाजीहुतेहे सालता रोंव एहेलिही आमाआं इश्शा होय. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />आंय तुमुहूं विनंती कोअहो के देव माहूं तुमाआं जागे मामार वापिस मोकलुहूं जोवे कोत प्रार्थना कोइलो कोअजा.<verse eid="HEB 13:19" /></para>
  <para style="s">सेलवाऱ्यीइ प्रार्थना</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />ओमे शांतीवालू देव आपाआ प्रभु ईसुहू ,जो मेडाआं महान राखवाली होय, हादाजल्म्यीइं शप्पतेए रक्ताआ गुणोवाअहीं मोल्याम रोत जिवाड़ीत लेतायू. <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />तियाआ इश्शा पुरी कोइलोअ काजे तुमुहूं हाजी गोठी वाअहीं पाक्के कोअहूं जोवे आन ईसु ख्रिस्ता वाअहीं तियाहा पसन आवनारे कामे तो आपामेहें कोअहूं जोवे. आखी महिमा हादाजलम तियाहाज जोड़ुहूं जोवे. आमेन!<verse eid="HEB 13:21" /></para>
  <para style="s">आखरीइ संदेश</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />पाव्हीइला, ओ जो हिकाअहूं जोगुहू संदेश आंय थोड़ाज शब्दामेहें लेख्युहू, तो तुमू धिर तोइत उनाआ एहलिही आंय तुमुहूं विनंती कोअहो. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />तुमू जाइंत ल्या के, आपाआ पाही तिमथ्या जेलेम रोत सुटीत गोयुहू आन जर तो उतवाल आयु, ताहां आंय तियाहा लेतुज तुमुहूं मिलू आविहीं.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />आखा मंडड़ीइ सेवकोहों आन आखा विश्वासी पाव्हीइलाहां सलाम कोवा, इटलीवाले तुमुहूं सलाम कोतेहे.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />देवोअ मेरवानी तुमा आखापोअ रोअहूं जोवे. आमेन.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>