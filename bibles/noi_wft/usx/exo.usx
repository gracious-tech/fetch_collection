<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EXO" style="id">- Noiri</book>
  <para style="toc3">निर्ग</para>
  <para style="toc2">निर्ग</para>
  <para style="toc1">निर्गमोअ पुस्तक</para>
  <para style="mt2">निर्गमोअ पुस्तक</para>
  <para style="mt1">निर्गमोअ पुस्तक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">“निर्गम” या शब्दाआ अर्थ होय “निहींइलो.” ओं अब्राहामोअ पारवाड़ीइ बाप्तिमेहें कोत देखाड़ेहे, जों उत्पत्तीइ पुस्तकोमेहें सुरवात ओवो मोन्ज्ये मिसर देसोमेहें रोत इस्राएलवाले निहीत कोइत तियांआं देसोम जाअलाआ वायदो देवे अब्राहामोअरी कोअयोतो. वेगो रोतीज जुना जाणकारोअ कोअलाआ जाहे के निर्गम या पुस्तकोअ आरदू भाग मोशे वाअहीं लेखाअयुतो, ओं यां आध्यायोमेहें मुंदू पोड़ीत जाहे. <char style="xt"><ref loc="EXO 24:4">निर्ग 24:4</ref></char> कोहे के मोशे या पुस्तकोअ थोड़ुक भाग कि कोइत लेख्युये. <char style="xt"><ref loc="JOS 8:31">यहो 8:31</ref></char> यामेहें <char style="xt"><ref loc="EXO 20:25">निर्ग 20:25</ref></char> आपल्या आदेसोअ संदर्भ कोत देखाड़ेहे आन कोहे के “मोशेए कायदाआ पुस्तकोमेहें लेखाअयोतो.” नोवू नियम मोशे वाअहीं लेखाअला पुस्तकोअ काहीक वाआ उल्लेख ओवेहे. उदाहरण काजे जेहेलाम पेटाअनारा साटवामेहें जों ओवो तियाआ बाप्तिमेहें गोठी कोअतेते आन ओं बी कोतेते के मोशे ओं पुस्तक लेख्योतो. मिसर देसोम रोत इस्राएल माअहोंहों काडीइलोअ पेल एक आंदास 1300 नेत 1400 वोरह्योम ओवोतो. <char style="xt"><ref loc="1KI 6:1">1 राजां 6:1</ref></char> मेहें कोयोहो के निर्गम इस्राएलो पोअ राजा शलमोन राज शार वोरह्यों रोत ते 480 वोरह्योंअ पेल ओवोतो.</para>
  <para style="ip">निर्गम यापोअ जोर देहे के देव अब्राहाम, इसहाक आन याकोबोपोअ रोत कोअल्या वायदाहा कि कोइत पुरो कोअतुतो. ओ अब्राहामोअ पारवाड़, इस्राएल देसोअ मिसर देसोअ धरतीइ देव ताकतवाला तारणोअ बाप्तिमेहें कोहे, <char style="xt"><ref loc="EXO 1-12">निर्ग 1—12</ref></char> तिहीं रोत देव तियाआ माअहुंहूं सिनाय डोगोपोअ जाआं लेत गोयू जिहीं तिये मोशेहे इस्राएल माअहें पालन कोए तेहें काजे थोड़ाक नियम आप्याते <char style="xt"><ref loc="EXO 12-19">निर्ग 12—19</ref>.</char> ओ नियम कोहे के ते कि कोइत काम कोअहूं जोवे, आन ते कि कोइत गाराहा आपुहूं जोवे, आन तोंबू जिहींमेहें देवोअ हजरी रोतीते, तोंबामेहें पुज्या कोइलोअ काजे शप्पतोअ पेटी आन बिहीरा कामोअ काजे बी, आन पुंजाराआ खास आंगड़े <char style="xt"><ref loc="EXO 20-31">निर्ग 20—31</ref></char> मेहें बोणावीलोअ काजे वारुज सुसना कोत आप्यी. फाशोअ एक वोडा विरोदोअ फासाड़ी जिहीं इस्राएल एका वासड़ाआ होनाआ मुर्ती बोणावयीते. मोशे फाशुउ देवोहो मिल्यू <char style="xt"><ref loc="EXO 32-33">निर्ग 32—33</ref>.</char> पुस्तकोअ सेलवार्‍या भागोमेहें, आपू वासतेहे के वेगो कोत आप्यो तियी वस्तुहू कि कोइत बोणायोय. <char style="xt"><ref loc="EXO 33-40">निर्ग 33—40</ref></char></para>
  <para style="iot">रुपरेशा</para>
  <para style="io1">1. इस्राएलवालाहां मिसर देसोम केहें कोइत गुलाम बोणाये तियाआ माग. <char style="ior"><ref loc="EXO 1">1</ref> </char></para>
  <para style="io1">2. मोशेए ओलखात आन तियाआ जिवनोअ बाप्तिमेहें कोयोहो. देवे तियाहा माअहोंहों सोड़वीइलोअ काजे हादीइलोअ आगोदोऱ्योअ जिवन. <char style="ior"><ref loc="EXO 2-4">2—4</ref></char></para>
  <para style="io1">3. फाशुउ लेखाऱ्यु कोहे के कि कोइत देव तियाआ माअहोंहों तिया देसोम रोत आन फारोअ ताड़ेप रोत वासाड़ीलाआ काजे मिसर देसोमेहें रोत वोडा वोडा समत्कार देखाड़्या आन विरोद कोअया. <char style="ior"><ref loc="EXO 5:15-21">5:15-21</ref></char></para>
  <para style="io1">4. इंहीं रोत इस्राएल देस सियोन डोगोअ जागे जाआं गोयो. <char style="ior"><ref loc="EXO 15:22-27">15:22-27</ref></char></para>
  <para style="io1">5. आपू वासतेहें ताहां देव कि कोइत मोशेहे आदेश आप्यू, तिहींमेहें देवोअ माअहें, मोन्जे इस्राएलवाले कि कोइत जिवन जिवुहूं जोवे आन भक्ती कि कोइत कोअहूं जोवे, तियाआ बाप्तिमेहें कोत आप्योहो.<char style="ior"><ref loc="EXO 20-31">20—31</ref></char></para>
  <para style="io1">6. इस्राएलवालां मोशेए पाही आरोनोहो होनाआ वासड़ाआ आकारोअ मुर्ती बोणावुहूं लागाड़्यी आन देवोअ विरुद्दाम जाअलोअ माग. <char style="ior"><ref loc="EXO 32">32</ref> </char></para>
  <para style="io1">7. मोशे देवोअ महिमा केहें कोइत देख्यी आन इस्राएलवालाहां देवोअ नियमोअ सुसना जोड़्यी, आन फाशोअ मंडप, साक्शीइ पेटी, देवोअ हजरीम गाराहा कोइलोअ वस्तु आन पुंजाराआ पेरोठोअ माग कोत देखाड़्युहू. <char style="ior"><ref loc="EXO 33-40">33—40</ref></char></para>
  <chapter number="1" style="c" sid="EXO 1" />
  <para style="s">मिसर देसोमेहें इस्राएलवालाआं तारास</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 1:1" />इस्राएलोअ मोन्जे याकोबोअ बेटाह्हाआ नावे, जे जिव जिवोअ कुटुंबाहा आरी लेत कोइत याकोबोअरी मिसर देसोम आवयाते, ते ए होय: <verse eid="EXO 1:1" /><verse number="2" style="v" sid="EXO 1:2" />रूबेन, शिमोन, लेवी, यहुदा, <verse eid="EXO 1:2" /><verse number="3" style="v" sid="EXO 1:3" />इस्साखार, जबुलून, बिन्यामीन, <verse eid="EXO 1:3" /><verse number="4" style="v" sid="EXO 1:4" />दान, नफ्ताली, गाद आन आशेर. <verse eid="EXO 1:4" /><verse number="5" style="v" sid="EXO 1:5" />आन योसेफ तोम मिसर देसोम पेलुज आवीत रोयुतो. याकोबोअ सोताआ पारवाड़ीमेहें जे उब्ज्ये ते आखेज सत्तर<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">सत्तर </char><char style="ft" closed="false">थोड़ाक जुना शास्त्रा लेखोमेहें सत्तर आन थोड़हाम पोन्शात्तर लेख्योहो</char></note> जोएं ओते. <verse eid="EXO 1:5" /><verse number="6" style="v" sid="EXO 1:6" />योसेफ आन तियाआ आखा पाही आन तियाआ पिड़ीइ आखे माअहें मोइत गोये. <verse eid="EXO 1:6" /><verse number="7" style="v" sid="EXO 1:7" />पोन इस्राएलोअ पिड़ी फुलीन-फोली वोल्यी; आन ते माहें जास्तीज मजबुत ओवते गोये, आन एतेहे जाअखे वादीत गोये के आखू देस तियां वाअहीं पोआइत गोयु.<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="ACT 7:17">प्रेशित 7:17</ref></char></note><verse eid="EXO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 1:8" />मिसर देसोम एक नोवू राजा गादीपोअ बोठू जो योसेफोहो ने ओलखीइतुतो. <verse eid="EXO 1:8" /><verse number="9" style="v" sid="EXO 1:9" />तिये तियाआ माअहोंहों कोयो, “पाला, इस्राएलवाले आपा रोत जाअखे आन मजबुत बोणित गोयेहे. <verse eid="EXO 1:9" /><verse number="10" style="v" sid="EXO 1:10" />तियाह काजे आवा, आपू यांअरी हुशारी वाअहीं वेवारो कोअहूं, एहें ने ओवुहूं जोवे के जेहेलाम ते जाअखीलेहे वादीत जाय आन जर लढाय कोइलाआ वेल आवीत पोड़े, ताहां आपाआ दुस्मोनोअरी मिलित कोइत आपाअरी लढाय कोए आन या देसोम रोत निहीत जाते रोय.”<note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="ACT 1:1-10">प्रेशित 1:1-10</ref></char></note> <verse eid="EXO 1:10" /><verse number="11" style="v" sid="EXO 1:11" />तियाह काजे मिसर देसोवाले तियांपोअ काम कोआड़नारा मुकड़दोमोहों नेम्या के ते तियांपोअ वोजू टाकी टाकीइ तियांहां तारास देअहूं जोवे; आन तियां फारो राजाआ काजे पितोम आन रामसेस नावोअ बेन गोडावनवाले होयरे बोणावये. <verse eid="EXO 1:11" /><verse number="12" style="v" sid="EXO 1:12" />पोन जेहें जेहें ते तियांहां दुख देते गोये तेहें तेहें ते वादते आन पसरीइते गोये; तियाह काजे ते मिसर देसो वाले इस्राएलवालाहां जाअखीलेहें बित कोइत सीस कोए वोल्ये. <verse eid="EXO 1:12" /><verse number="13" style="v" sid="EXO 1:13" />तेबी मिसरवालां इस्राएलवालाहां उदाबादीज जोरो वाअहीं कामे कोआड़्ये, <verse eid="EXO 1:13" /><verse number="14" style="v" sid="EXO 1:14" />आन तियांआं जिवोहो गारो, इटे आन खेतोअ बाती बातीइ कामोवाअहीं तियांहां ओसवी देदे; किबी काम तें तियांहां उदाबादीज कोआड़तेते.<verse eid="EXO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 1:15" />शिप्रा आन पूआ नावोअ यी बेन इब्री हुंवारकीहीं मिसरोअ राजे आदेस आप्यु के, <verse eid="EXO 1:15" /><verse number="16" style="v" sid="EXO 1:16" />“जाहां तुमू इब्री बोईंहीं ठाल्ली पाड़हा ताहां नजर टाकीत पालजा, जर सोऊ ओवू ताहां माइत टाकजा, आन जर सोई ओवे ताहां जिवती रोअहूं देजा.” <verse eid="EXO 1:16" /><verse number="17" style="v" sid="EXO 1:17" />पोन ते हुंवारकी देवोहो बित सालतीते, तियाह काजे मिसरोअ राजाआ आदेस ने मानित सोआहा बी जिवताज रोअहूं देतीते. <verse eid="EXO 1:17" /><verse number="18" style="v" sid="EXO 1:18" />ताहां मिसरोअ राजे हादाड़ीत कोइत फुश्यो, “तुमू जे सोआहा जिवताज रोअहूं देत्यीही, ताहां एहेलोहो काहा कोअत्यीही?”<verse eid="EXO 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 1:19" />हुंवारक्यी फारोहो कोयो, “इब्री बोईं मिसरवालीइं होस कायनाहां; ते एती उतवाल्यी होय के, आमू हुंवारकी ने पोतत्ली तेहेंज ते ठाल्ली पोड़ीत जात्ली.” <verse eid="EXO 1:19" /><verse number="20" style="v" sid="EXO 1:20" />तियाह काजे देवे हुंवारकीइं हाजो कोअयो; आन ते माअहें गणतीमेहें खुब वादीत कोइत जाअखीलेहें ताकतवान ओत गोये. <verse eid="EXO 1:20" /><verse number="21" style="v" sid="EXO 1:21" />एताआ काजे के हुंवारकीहीं देवोहो बित सालतीते, तिहीं वाअहीं तिये तियींइं कोएं थांगे लागाड़्ये. <verse eid="EXO 1:21" /><verse number="22" style="v" sid="EXO 1:22" />ताहां फारो राजा तियाआ आखा माअहोंहों आदेस आप्यू के, “इब्री माअहोंओं जेता सोआ उब्जे तियां आखाहा नील नोयीमेहें टाकी देजा आन आखी सोईहीं जिवती रोअहूं देजा.”<verse eid="EXO 1:22" /></para>
  <chapter eid="EXO 1" />
  <chapter number="2" style="c" sid="EXO 2" />
  <para style="s">मोशेए जल्म</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1" />लेवीइ पारवाड़ीमेहें एक माट्ये एकी लेवी पारवाड़ीइ बोईंइरी वेहेवाल कोइत लेदो. <verse eid="EXO 2:1" /><verse number="2" style="v" sid="EXO 2:2" />ते बोईं पोटाअरी ओवी आन तियीइ एक सोऊ ओवू; ओ पोर्‍यू बाहरी एतुज होय ओं देखीत, तियी तियाहा तिन मोयना जाआं निकाड़ीत मेक्यो.<note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="ACT 7:20">प्रेशित 7:20</ref>; <ref loc="HEB 11:23">इब्री 11:23</ref></char></note> <verse eid="EXO 2:2" /><verse number="3" style="v" sid="EXO 2:3" />पोन ते तियाहा हांहतिही जाआं निकाड़ीत ने सेक्यी, ताहां तियाआ काजे ते दुंग्लाआ एक टोपली बोणावीत तियीही मांयते आन बारथे डांबऱ्या वाअहीं निपी देदी. आन तिहींमेहें पोऱ्याहा मिकीत कोइत नील नोयीइ मेरेपोअ उसा खोड़ोमेहें मिकीत आयी. <verse eid="EXO 2:3" /><verse number="4" style="v" sid="EXO 2:4" />तिया पोऱ्याअ बोअह्ही सेटेज रोत की ओवेहे तो पालीइलो काजेहे उबी रोयी.<verse eid="EXO 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 2:5" />ताहां फारोअ पोऱ्यी नील नोयीइ मेरे उंगली आवयी. तियीइ पावरी पोऱ्यी नोयीइ मेरे फिऱ्या कोअतीते. ताहां तियी उसा दुंग्लामेहें ते टोपली देख्यी आन तियीइ पावरीहीं ते टोपली लेत हाद्यी. <verse eid="EXO 2:5" /><verse number="6" style="v" sid="EXO 2:6" />जाहां ते टोपली उगाड़ीत कोइत देख्यी, ताहां एक रोड़त्लोज पोऱ्यो देख्यो, ताहां तियीही कीइमाय आयी आन तियी कोयो, “ओं तोम एखा इब्रीइ पोर्‍यू ओय.”<verse eid="EXO 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 2:7" />ताहां तिया पोऱ्याअ बोअह्हीं फारोअ बेटिह्हीही कोयो, “आंय जात कोइत या पोऱ्याहा बुजी पिवाड़ीत सेके एहेलिही एखू इब्री बोईंहीं हादीत लेतावो के?”<verse eid="EXO 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 2:8" />फारोअ बेटिह्ही कोयो, “जा.” ताहां ते पोऱ्यी जात कोइत तिया पोऱ्याअ आयहीही हादीत लेत आवयी. <verse eid="EXO 2:8" /><verse number="9" style="v" sid="EXO 2:9" />फारोअ बेटिह्ही तियीही कोयो, “तु या पोऱ्याहा लेत जात कोइत माआ काजे बुजी पिवाड़्या कोअजी, आन आंय ताहूं मोजरी आपिहीं.” ताहां ते बोईं तिया पोऱ्याहा लेत जात कोइत बुजी पिवाड़ी वोल्यी. <verse eid="EXO 2:9" /><verse number="10" style="v" sid="EXO 2:10" />जेहेलाम पोऱ्यो वोडो ओत गोयो ताहां तियी फारो राजाअ बेटिह्हीइ जागे लेत गोयी, आन तो तियीइ बेटुह्हू बोण्यू; आन तियी एहें कोत कोइत तियाआ नाव मोशे मेक्यो, “मी याहा पाअयोंम रोत काड्युतो.”<verse eid="EXO 2:10" /></para>
  <para style="s">मोशेए मिद्यान देसोम नाहींइलोअ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11" />जाहां मोशे जुवान ओत गोयू, तिया दिहोमेहें बारथे तियाआ पाव्हीइलाआ जागे जात कोइत तियांआं तारास देखु वोल्यू; ताहां तिये देख्यो के एक मिसरवालू एका इब्री माट्योहो देहे.<note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="HEB 11:24">इब्री 11:24</ref>; <ref loc="ACT 7:23-28">प्रेशित 7:23-28</ref> </char></note> <verse eid="EXO 2:11" /><verse number="12" style="v" sid="EXO 2:12" />तिये एहें-तेहें पाल्यो के कोडोज नाहां, ताहां तिया मिसरवालाहा माइत टाक्यू आन रेटामेहें निकाड़ी देदू.<verse eid="EXO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 2:13" />फाशुउ बिहीरे दिहे बाअथे जात कोइत पाल्यो के बेन इब्री पाही तियां तियांआंज सुलाअताहा. ताहां तिये पाप्योहो कोयो, “तु ताआ पायहोहो काहा देहे?”<verse eid="EXO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 2:14" />तिये कोयो, “कोडे ताहूं आमापोअ आधिकारी आन न्यायाधिश कोअयुहू? जेहें कोइत तिया मिसरवालाहा माइत टाक्यु, तेहेंज कोइत माहूं बी माअहूं होदेहे के?” ताहां मोशे ओ विसार कोइत बित गोयू, “खोरीज ते गोठ खुल्ली ओत गोयीही.” <verse eid="EXO 2:14" /><verse number="15" style="v" sid="EXO 2:15" />जाहां फारो ए गोठ उनाअयू ताहां तो मोशेहे माअहूं कोअतुतो.</para>
  <para style="p" vid="EXO 2:15">पोन मोशे फारोअ सामने रोत नाठू; आन मिद्यान देसोम जात कोइत रोनु वोल्यू; आन तो तिहीं एकी वेईइ जागे जात कोइत बोहीत गोयू.<note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="ACT 7:29">प्रेशित 7:29</ref>; <ref loc="HEB 11:27">इब्री 11:27</ref></char></note> <verse eid="EXO 2:15" /><verse number="16" style="v" sid="EXO 2:16" />मिद्यान देसोअ पुंजाराआ हांत बेटिह्ही ओती; आन ते तिहीं आवीत कोइत पाईं काडी वोल्यी, ते तियींइं आब्हाआ मेडे-बोकड़े पाईं पियतेहें कोड्बामेहें पाईं पोई वोल्यी. <verse eid="EXO 2:16" /><verse number="17" style="v" sid="EXO 2:17" />ताहां सारवाली आवीत कोइत तियींहीं सेटे कोआ वोल्या; तिहीं वाअहीं मोशे उबू रोत कोइत तियींहीं मदत कोअयी, आन मेडा-बोकड़ाहां पाईं पिवाड़्यो. <verse eid="EXO 2:17" /><verse number="18" style="v" sid="EXO 2:18" />जाहां ते तियींइं आब्हा रूएलोअ जागे पोत्यी, ताहां तिये तियींहीं फुश्यो, “आज केहें एती वेगी फिरीत आवयीही.”<verse eid="EXO 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 2:19" />तियीं कोयो, “एके मिसरवाले माट्ये आमुहूं सारवाल्योंअ आथे रोत वासाड़्यी, आन आमाआ काजे जाअखीलोह पाईं पोइत कोइत मेडा-बोकड़ाहां पिवाड़्यो,”<verse eid="EXO 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 2:20" />ताहां तिये तियाआ बेटिह्हीहीं कोयो, “तो माटी का होय? तुमू तियाहा का सोड़ी देत आयीही? तियाहा रोटू खायतेहें हादीत लेतावा,”<verse eid="EXO 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 2:21" />आन मोशे तिया माट्योअरी रोअलाआ तियार ओवू. तिये तियाअरी सोताआ बेटिह्ही सिप्पोराअ वेहेवाल कोइत आप्यो. <verse eid="EXO 2:21" /><verse number="22" style="v" sid="EXO 2:22" />तियाआ एक बेटुह्हू उबज्यु, ताहां मोशे एहें कोत कोइत तियाआ नाव गेर्शोम<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="fq" closed="false">गेर्शोम </char><char style="ft" closed="false">मोन्ज्ये तिहीं पारकू ओतू, काडी देवाय.</char></note> मेक्यो, “आंय यी जागेहे पारकू होय.”<verse eid="EXO 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23" />वारुज वोरह्ये सेके तेहेलाम मिसरोअ राजा मोइत गोयू. इस्राएलोअ माअहें कठीण तारासो वाअहीं काहें वोल्ये आन हाद कोए वोल्ये, आन तियांआं प्रार्थना जे कठीण तारासोअ वाखरी ओवी ते देवोअ जागे पोती. <verse eid="EXO 2:23" /><verse number="24" style="v" sid="EXO 2:24" />देवे तियांआं काहींइलोअ उनात कोइत तियाआ शप्पतेहे, जे तिये अब्राहाम, इसाहाक आन याकोबोअरी खादी ते ओर कोअयी.<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="GEN 15:13-14">उत्प 15:13-14</ref></char></note> <verse eid="EXO 2:24" /><verse number="25" style="v" sid="EXO 2:25" />आन देवे इस्राएल माअहोंअ दशा देखीत कोइत तियांपोअ नजर टाक्यी.<verse eid="EXO 2:25" /></para>
  <chapter eid="EXO 2" />
  <chapter number="3" style="c" sid="EXO 3" />
  <para style="s">देव मोशेहे हादत्लू</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1" />मोशेए होवरुह्हू यित्रो नावोअ ओतू, जो मिद्यान देसोअ पुंजारु ओतू. तियाआ मेडे-बोकड़े मोशे सारतुतो. एक दिही तो तियांहां दिही बुड्ताआ वोलेहे रानम होरेब नावोअ देवोअ डोगोअ वोलेहे लेत गोयू. <verse eid="EXO 3:1" /><verse number="2" style="v" sid="EXO 3:2" />डोगोपोअ एका पेटाअत्ला साटवाम देवोअ देवदूतोहो देख्यू. मोशे नजर टाकीत कोइत पाल्यो ताहां एहेलोह देखाअयो के साटवो आगी वाअहीं पेटाअहे, पोन नाहां निजलाअतो. <verse eid="EXO 3:2" /><verse number="3" style="v" sid="EXO 3:3" />ताहां मोशे विसार कोअयू, “फोलो साटवो काहा नाहां निजलाअतो या वोडा समत्कारोहो आंय तिहीं जात कोइत पालिहीं.”<verse eid="EXO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 3:4" />जाहां यहोवा देवे मोशेहे आहने आवत्लाहा देख्यू, ताहां तिये मोशेहे साटवाम रोत हाद कोअयू, “ए मोशे, ए मोशे!”</para>
  <para style="p" vid="EXO 3:4">मोशे कोयो, “आंय इंहीं होंव.”<verse eid="EXO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 3:5" />तिये कोयो, “इंहीं आहने मा आवही; आन ताआ गुडामेएं खाहड़े काड, काहाके जिया जागाम तु उबू होय तो जागू सोकू होय.” <verse eid="EXO 3:5" /><verse number="6" style="v" sid="EXO 3:6" />फाश्योअ तिये कोयो, “आंय ताआ डायहांअ देव होय, अब्राहाम, इसाहाक आन याकोबोअ देव होय.” मोशेहे देवोअहें पालीइलोअ हिम्मत ने ओवी, तिहीं वाअहीं तिये सोब टापित लेदी.<verse eid="EXO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 3:7" />फाशुउ यहोवा देव कोयो, “मिसर देसोमेहें माआ माहुंहूं केहेलुहू तारास ओवेहे तो आंय देख्योहो, तियांहां मेहेंनत कोआड़नारा मुकोड़दोमोअ वाखरी तियांआं किगलीइलोअ बी मी होंबल्योहो, आन तियांआं पिड़ापोअ आंय नजर टाक्यीही. <verse eid="EXO 3:7" /><verse number="8" style="v" sid="EXO 3:8" />तिहीं वाअहीं ओमे माआ माअहुंहूं मिसरवालाआं आथोम रोत वासाड़ीइलोअ काजे आंय निसे उतरीत आयुहू; आन आंय तियां तिया देसोम रोत काडीत कोइत एक हाजा आन वोडा देसोम, जिहीं दुद आन मोदोअ तारी वोहतीही तिहीं मोन्ज्ये कनानी, हित्ती, एमोरी, परिज्जी, हिव्वी आन यबूसी माअहुंउं जागामेहें पोताड़ो.<note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="GEN 15:19-21">उत्प 15:19-21</ref></char></note> <verse eid="EXO 3:8" /><verse number="9" style="v" sid="EXO 3:9" />तियाहा काजे ओमे उनाआ, इस्राएलवाला माअहुंउं रोड़ीइलोअ आवाज माहूं होंबलाअयुहू, आन मिसरवालाआं तियांहां तारास कोआड़ीलोअ बी मी देख्योहो. <verse eid="EXO 3:9" /><verse number="10" style="v" sid="EXO 3:10" />तियाहा काजे तू जा, आंय ताहूं फारो राजाअ जागेहे मोकलोहो के तु माआं माहें इस्राएलोहो मिसरोम रोत बारथे काडीत लेतावुहूं जोवे.”<verse eid="EXO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 3:11" />पोन मोशे देवोह कोयो, “आंय कोडू होय के आंय फारो राजाअ जागेहे जांव आन इस्राएलवालाहां मिसरोअ आथोम रोत काडीत लेत आवो?”<verse eid="EXO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 3:12" />देवे उत्तर आप्यो, “आंय ताअरी होंव; आंय ताहूं मोकलोहो याआ निशाणी ए होय के जेहेलाम तु माआं माहुंहूं मिसरोम रोत काडीत लेत आवही ताहां तु याज डोगोपोअ माआं आराधना कोअही.”<verse eid="EXO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 3:13" />पोन मोशे देवोहो कोयो, “जर आंय इस्राएलवालाआ जागे जात कोइत तियांहां कोहीं के, ‘तुमाआं डायहांआं देवे माहूं तुमाआ जागे मोकल्युहू,’ ताहां तें माहूं फुसे, ‘तियाआ नाव की होय,’ ताहां आंय तियांहां की कोंव?”<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 6:2-3">निर्ग 6:2-3</ref></char></note><verse eid="EXO 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 3:14" />देवे मोशेहे कोयो, “‘आंय जो होय तोज होय,’<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fq" closed="false">आंय जो होय तोज होय,</char><char style="ft" closed="false">वारुज लेखाऱ्या कोताहा, “आंय जो ओविहीं तो ओविहीं.”</char></note> तु इस्राएलवालाहां जात कोइत को, जियाआ नाव ‘आंय होंव’<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fq" closed="false">आंय होंव</char><char style="ft" closed="false">वारुज लेखाऱ्या कोताहा, “आंय ओविहीं.”</char></note> होय तियेज माहूं तुमाआ जागे मोकल्युहू.”<note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="REV 1:4">प्रगटी 1:4</ref>,<ref loc="REV 1:8">8</ref></char></note> <verse eid="EXO 3:14" /><verse number="15" style="v" sid="EXO 3:15" />फाश्योअ देवे मोशेहे ओं बी कोयो, “तु इस्राएलवालाहां एहें कोजी के तुमाआं डायहांआं देव, मोन्ज्ये अब्राहाम, इसाहाक आन याकोबोअ यहोवा देव, तियेज माहूं तुमाआं जागे मोकल्युहू; देख, माआं नाव हादाजोलम्योअ ओंज होय. आन पिड़ीन पिड़ी याज वाअहीं माआं ओर कोआय. <verse eid="EXO 3:15" /><verse number="16" style="v" sid="EXO 3:16" />तियाह काजे ओमे जात कोइत इस्राएली पुडाऱ्योहों टोलू कोअ, आन तियांहां को, तुमाआं वेगाआ डाया अब्राहाम, इसाहाक आन याकोबोअ यहोवा देव माहूं दर्शन आपित कोइत ओं कोयो के आंय तुमापोअ आन तुमुहूं तारास देनारा मिसरवालापोअ बी नजर मिक्यीही; <verse eid="EXO 3:16" /><verse number="17" style="v" sid="EXO 3:17" />आन मी ठरवीत लेदोहो के तुमुहूं मिसरोअ तारासोम रोत काडीत कनानी, हित्ती, एमोरी, परिज्जी, हिव्वी, आन यबूसी माहुंउं देसोम लेत जाहीं, जो एहेलुहू देस होय जिहींमेहें दुद आन मोदोअ तारी वोहत्यीही.”<verse eid="EXO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 3:18" />“ताहां ते पुडारी ताआ गोठी माने; आन तु इस्राएलवाला डायहांहां आरी लेत कोइत मिसरवाला राजाआ जागे जात कोइत तियाहा एहें कोजी, ‘इब्रीइ, यहोवा देवोअरी आमू मिल्याहा; तियाहा काजे ओमे आमुहूं तिन दिहोअ वाट सालित कोइत जाअहूं दे; काहाके आमाआं यहोवा देवोहो गाराहा आपित सेको.’ <verse eid="EXO 3:18" /><verse number="19" style="v" sid="EXO 3:19" />माहूं मुंदू होय के मिसरोअ राजा वोडी सेक्ती ने देखे ताअहूं जाआं तुमुहूं ने जाअहूं देय. <verse eid="EXO 3:19" /><verse number="20" style="v" sid="EXO 3:20" />तियाहा काजे आंय समत्कार देखाड़ीत कोइत माआ आथोअ सेक्ती वाअहीं मिसर देसोहो डोंड आपिहीं; तिहींइं फासाड़ी तो तुमुहूं जाअहूं देय.”<verse eid="EXO 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 3:21" />“ताहां मिसरवाले माअहें तुमापोअ मेरवानी कोए एहेलोहो आंय कोई देहीं; आन जेहेलाम तुमू निहाहा ताहां ठाल्ले आथेज ने निहाहा.<note caller="+" style="x"><char style="xo" closed="false">3:21 </char><char style="xt" closed="false"><ref loc="EXO 12:35">निर्ग 12:35</ref>,<ref loc="EXO 12:36">36</ref></char></note> <verse eid="EXO 3:21" /><verse number="22" style="v" sid="EXO 3:22" />हरेक इस्राएलवाली बोईं जागेवाली मिसरवाली बोईंपोअ रोत होना-सांदीइ गोवणो, आन आंगड़े मागित लेय, आन तुमू तुमाआं बेटाह्हा-बेटिह्हीही पेवाड़हा; एहें कोइत तुमू मिसरवालाहां लुटहा.”<verse eid="EXO 3:22" /></para>
  <chapter eid="EXO 3" />
  <chapter number="4" style="c" sid="EXO 4" />
  <para style="s">मोशेहे देवोप रोत समत्कारोअ सेक्ती जोड़त्ली</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1" />ताहां मोशे उत्तर आप्यो, “तें माआं गोठीपोअ विश्वास ने कोए आन माआ गोठी ने उनाय, पोन कोय, ‘यहोवा देवे ताहूं दर्शन नाहां आप्यो.’”<verse eid="EXO 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 4:2" />यहोवा देवे तियाहा कोयो, “ताआ आथोमेहें फोअलो की ओं?” तिये कोयो, “डेंगार.”<verse eid="EXO 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 4:3" />तिये कोयो, “यीही पुंयी पोअ टाकी दे.” ताहां जे डेंगार टाक्यी ते हाप बोणित गोयी, आन मोशे तियाआ सामने रोत सेटे गुगद्यू. <verse eid="EXO 4:3" /><verse number="4" style="v" sid="EXO 4:4" />ताहां यहोवा देवे, मोशेहे कोयो, “आथ आगाड़ी कोइत याआ सेपटी तोइत ले.” जाहां तिये आथ आगाड़ी कोइत तियीही तोअयी ताहां फाशुउ तो हाप डेंगार बोणीत गोयू. <verse eid="EXO 4:4" /><verse number="5" style="v" sid="EXO 4:5" />“काहाके तें माहें विश्वास कोअहूं जोवे के तुमाआं डायहांआं देव, यहोवा देवे मोन्ज्ये अब्राहाम, इसाहाक आन याकोबोअ यहोवा देवे ताहूं दर्शन आप्योहो.”<verse eid="EXO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 4:6" />फाशोअ यहोवा देवे मोशेहे ओं बी कोयो, “ताआ आथ सातीपोअ मिकीत टाप.” ताहां तिये सोताआ आथ सातीपोअ मिकीत टापित लेदू; तिहीं रोत फाशुउ काडीत पाल्यू ते तियाआ आथ वोडा दुखो वाअहीं बोर्फाआ होस पांडू बोणित गोयुहू. <verse eid="EXO 4:6" /><verse number="7" style="v" sid="EXO 4:7" />ताहां तिये कोयो, “ताआ आथ फाशुउ साती पोअ मिकीत टाप.” तिये सोताआ आथ सातीपोअ मिकीत टापित लेदू; आन जाहां तिये तो आथ सातीपोअ रोत काड्यू, ताहां तो वापिस फाशुउ बाकी डिलोअ होस होय तेहेलुज बोणीत गोयू. <verse eid="EXO 4:7" /><verse number="8" style="v" sid="EXO 4:8" />यहोवा देवे कोयो, “जर ते ताआ गोठीइ विश्वास ने कोए आन पेहली निशाणीही ने माने, ताहां दुसरी निशाणीइ विश्वास कोए. <verse eid="EXO 4:8" /><verse number="9" style="v" sid="EXO 4:9" />आन जर तें यां बेनू निशाणीइ विश्वास ने कोए आन ताआ गोठीही ने माने, ताहां तु नील नोयीइ थोड़ोक पाईं लेत आवीत कोइत कोअड़ी जागेहे ओली देजी; जों पाईं तु नोयीम रोत लेत आविही तों कोअड़ी जागेहे रक्त बोणित जाय.”<verse eid="EXO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10" />मोशे यहोवा देवोहो कोयो, “नाहां, प्रभु, माहूं मा मोकलिही, माहूं गोगता नाहां जमती, सुरवातिही रोतीज नाहां जमती, आन जेहेलाम तुमे माहूं गोगाड़्यू, तेहेलाम बी नाहां, आंय तोम गोगताम तोतराअत्लु आन जिबीमेहें बोबड़्यू होय.”<verse eid="EXO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 4:11" />यहोवा देवे मोशेहे कोयो, “माअहुंउं सोब कोडे बोणायीही? आन माहुंहूं कुंगो, बोयरो, देखनारो, नेत आंद्लो आंय यहोवा सोड़ीत कोडो बोणावत्लो? केहें तो आंय यहोवा नाहां के. <verse eid="EXO 4:11" /><verse number="12" style="v" sid="EXO 4:12" />ओमे जा, आंय ताहूं गोगीइलाअ मदत कोअहीं, आन ताहूं की कोअलोअ ओय तों कोत आपिहीं.”<verse eid="EXO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 4:13" />तिये कोयो, “माआं प्रभु, मेरवानी कोइत बिहीरा एखाहा मोकल.”<verse eid="EXO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 4:14" />ताहां यहोवा देवोहो मोशेपोअ खोत सोड़्यी आन तिये कोयो, “ताआ पाही लेवी कुटूंबाआ आरोन कायनाहां के? माहूं मुंदू होय तो वारुहूं गोगीत सेकेहे, आन तो ताहूं मिलीइलोअ काजे आवेहे आन तो ताहूं देखीत खुस ओत जाय. <verse eid="EXO 4:14" /><verse number="15" style="v" sid="EXO 4:15" />तियाहा काजे तु तियाअरी गोठी कोअजी, आन की कोइलोअ होय तों तियाहा कोजी. आंय तुमू बेनुहूं बी गोगीइलाअ मदत कोअहीं, आन कि कोअलोअ तों सिकाड़ीहीं. <verse eid="EXO 4:15" /><verse number="16" style="v" sid="EXO 4:16" />तो ताआ वोतीइ माअहोंअरी गोगे; तु तियाआ काजे देव ठरही. <verse eid="EXO 4:16" /><verse number="17" style="v" sid="EXO 4:17" />तु ए डेंगार लेत जात कोइत यीज वाअहीं निशाणी देखाड़जी.”<verse eid="EXO 4:17" /></para>
  <para style="s">मोशेए मिसर देसोम वापिस आवीइलो</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18" />ताहां मोशे तियाआ होवराह्हा यित्रोअ जागे वापिस गोयू आन कोयो, “माहूं वाट लागाड़ मोन्ज्ये मिसर देसोम रोनारा माआ पाव्हीइलाहा आंय जात कोइत पालिहीं, के तें का ओमे जाआं जिवते होय के नाहां.” यित्रे कोयो, “हाजी हुतेहे जा.”<verse eid="EXO 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 4:19" />मोशे मिद्यान देसोम ओतू तेहेंज यहोवा देवे मोशेहे कोयो, “मिसर देसोम वापिस जा; काहाके जें ताआ जिव लेअहूं होदतेते तें मोइत गोयेहे.”<note caller="+" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="ACT 7:34">प्रेशित 7:34</ref>; <ref loc="MAT 2:20">मत्तय 2:20</ref></char></note> <verse eid="EXO 4:19" /><verse number="20" style="v" sid="EXO 4:20" />ताहां मोशे तियाआ लाडी आन पोऱ्याहां गोदड़ापोअ बोहाड़ीत मिसर देसोअहें देवे आपल्यी ते डेंगार लेतुज फाशुउ वापिस निहीयु.<verse eid="EXO 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 4:21" />ताहां यहोवा देवे मोशेहे कोयो, “जाहां तू मिसर देसोम पोतीही ताहां दिहान मेक के जे समत्कार आंय ताआ ताबाम आप्याहा तियां आखाहा फारोअ सामने देखाड़जी; पोन आंय तियाआ मोनोहो कड़क कोइ देहीं, आन तो माआं माहुंहूं ने जाअहूं देय. <verse eid="EXO 4:21" /><verse number="22" style="v" sid="EXO 4:22" />आन तु फारोहो कोजी, ‘यहोवा देव एहें कोहे, के इस्राएल माआ बेटुह्हू आन डायु पोर्‍यू होय.<note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="DEU 1:31">कायदा 1:31</ref>; <ref loc="JER 31:9">यिर्म 31:9</ref></char></note> <verse eid="EXO 4:22" /><verse number="23" style="v" sid="EXO 4:23" />आन आंय ताहूं कोत देदोहो के माआ बेटाह्हाहा माआ आराधना सेवा कोए तेहें जाअहूं दे; आन तुमे ओमे जाआं तियाहा नाहां जाअहूं देदू तिहीं वाअहीं ओमे आंय ताआ डाया पोऱ्याहा माईंत टाकी देहीं.’”<verse eid="EXO 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 4:24" />ताहां एहेलोहो ओवो के वाटेज रोअलाअ जागेहे यहोवा देवे मोशेहे माइलोअ कोशित कोअयी. <verse eid="EXO 4:24" /><verse number="25" style="v" sid="EXO 4:25" />ताहां सिप्पोरा एक वाडाल्लुहू डोण विशू आन तियीइ बेटाह्हाआ टोंडीइ सुटक्यो वाडीत टाक्यो, आन एहें कोत कोइत मोशेए गुडापोअ टाकी देदो, “खोरीज तू माआं कोअते रक्तावालू माआं माटी होय.” <verse eid="EXO 4:25" /><verse number="26" style="v" sid="EXO 4:26" />ताहां यहोवा देवे मोशेहे सोड़ी देदू. तियी वेले खतनाआ वाखरी तियी कोयो, “तु रक्त वोहाड़नारु माआ माटी होय.”<verse eid="EXO 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 4:27" />ताहां यहोवा देवे आरोनोहो कोयो, “मोशेहे मिलीइलोअ काजे रानोम जा.” ताहां तो गोयू आन देवोअ डोगोपोअ तियाहा मिल्यू आन तियाहा गुउं देदू. <verse eid="EXO 4:27" /><verse number="28" style="v" sid="EXO 4:28" />ताहां मोशे आरोनोहो ओं कोत देखाड़्यो के यहोवा देवे की की गोठी कोत मोकल्यीही, आन कोड्ली कोड्ली निशाणी देखाड़ीलोअ आदेस आप्युहू. <verse eid="EXO 4:28" /><verse number="29" style="v" sid="EXO 4:29" />ताहां मोशे आन आरोन जात कोइत आखा इस्राएल माअहोंअ डायहांहां टोलू कोअया. <verse eid="EXO 4:29" /><verse number="30" style="v" sid="EXO 4:30" />आन जेती गोठी यहोवा देवे मोशेहे कोयीते ते आखी आरोने तियांहां कोत देखाड़्यी, आन माअहोंअ सामने ते निशाणी बी देखाड़्यी. <verse eid="EXO 4:30" /><verse number="31" style="v" sid="EXO 4:31" />आन माअहें तियांआं गोठीपोअ विश्वास कोअयू; आन यहोवा देवे इस्राएलोअ कालजी लेदीही आन तियांआं दुखोपोअ नजर टाक्यीही, ओं उनाइत तियां टुंगा पोड़ीत वोंद्यो.<note caller="+" style="x"><char style="xo" closed="false">4:31 </char><char style="xt" closed="false"><ref loc="EXO 14:31">निर्ग 14:31</ref>; <ref loc="JHN 2:11">योहान 2:11</ref></char></note><verse eid="EXO 4:31" /></para>
  <chapter eid="EXO 4" />
  <chapter number="5" style="c" sid="EXO 5" />
  <para style="s">मिसरोअ राजाअ सामने मोशे आन आरोन</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1" />तिहींइं फासाड़ी मोशे आन आरोन फारोअ सामने जात कोइत कोयो, “इस्राएलोअ यहोवा देवे एहें कोहे: जंगलोमेहें माआं काजे तिवार कोए तेहें काजे माआं माहुंहूं जाअहूं दे.”<verse eid="EXO 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 5:2" />फारो राजा कोयो, “यहोवा कोडू होय के तियाआ गोठ उनाइत कोइत इस्राएल वालाहां जाअहूं देंव? आंय यहोवाहा ने ओलखीइत्लू, आन आंय ने जाअहूं देनारु.”<verse eid="EXO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 5:3" />मोशे आन आरोने कोयो, “इब्रीवालाआ देव आमुहूं सोताहाज मिल्युहू; तियाह काजे आमुहूं रानोमेहें तिन दिही जाआं वाटे सालीत जाअलोअ काजे परवांगी आप, काहाके आमाआ देव यहोवाहा गाराहा आपित सेको. एहेलोह ने ओवे के तो आमामेहें मोराय मोकले नेत तारवाअ सालाड़े.”<verse eid="EXO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 5:4" />मिसर देसोअ राजा मोशे आन आरोनोहो कोयो, “तुमू माहुंउं कामे काहा सोड़ावुहूं होदताहा? जावा तुमू, तुमा-तुमाआ वोजाआ काम कोआ.” <verse eid="EXO 5:4" /><verse number="5" style="v" sid="EXO 5:5" />आन फारो कोयो, “पाला, या देसोमेहें ते जास्ती वादीत गोयेहे. आन याहां वोजाआ कामोमेहें रोत आराम कोआड़ुहूं होदताहा!”<verse eid="EXO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 5:6" />फारो राजा तेदिहींज तियां वेठाड़नाराहां जे तियां माअहूं पोअ ओता, आन तियांआं आधिकाऱ्योहों ओ आदेश आप्यू के: <verse eid="EXO 5:6" /><verse number="7" style="v" sid="EXO 5:7" />“तुमू जे ओमे जाआं इटे बोणावे तेहें माहुंहूं पुहूटो आप्या कोअताते, ओमे आगाड़ी रोत मा आपहा; तें सोताहाज जात कोइत तियांआं कोअते खोड़ हाटवे. <verse eid="EXO 5:7" /><verse number="8" style="v" sid="EXO 5:8" />तेबी जेतेहे इटे ओमे जाआं तियांहां बोणावुहूं पोड़तेते तेतेहेज आगाड़ी बी तियांहां बोणावुहूं लागाड़जा, इटाआ गणती वाहीं बी मा कमी कोअहा; काहाके तें उजग्ये होय, तियाह कोअते ते एहें कोइत आअड़ीइतेहे, ‘आमू जात कोइत आमाआ देवोअ काजे गाराहा आपित सेको.’ <verse eid="EXO 5:8" /><verse number="9" style="v" sid="EXO 5:9" />तियां माहुंहूं फाशोअ बी कठीण काम होपा के तें तियांआं काम कोअते रोय आन ठोगोअ गोठीपोअ मोन ने लागाड़े.”<verse eid="EXO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 5:10" />ताहां माहुंहूं काम कोआड़नारा आन आधिकारी नेहें बाअथे जात कोइत तियांहां कोयो, “फारो एहेंकोइत कोहे, ‘आंय तुमुहूं पुहूटो ने आपो. <verse eid="EXO 5:10" /><verse number="11" style="v" sid="EXO 5:11" />तुमूज जात कोइत जिहीं काबी पुहूटो जोड़े तिहीं रोत होदीत लेत आवजा; पोन तुमाआ कामोम किज बी कमी ने ओवे.’” <verse eid="EXO 5:11" /><verse number="12" style="v" sid="EXO 5:12" />तियाहा कोअते तें माअहें पुरा मिसर देसोमेहें पुहूटो होदीइलाअ काजे वेरासेर ओत गोये. <verse eid="EXO 5:12" /><verse number="13" style="v" sid="EXO 5:13" />काम कोआड़नारा ओं कोत कोइत तियांहां तावणी कोआड़ता रोया, के जेहें कोइत तुमू पुहूटो होदीत कोइत काम कोअया कोअतेते, तेहेंज कोइत तुमाआ हरेक दिहोअ काम ओमे बी पुरो कोआ, <verse eid="EXO 5:13" /><verse number="14" style="v" sid="EXO 5:14" />आन इस्राएलोमेहें रोत जियांहां सिपाय कोत ठरव्याते तियांहां फारोअ काम कोआड़नारा मुकोड़दोमो आवित मार देदू आन फुश्यो, “काहा काजे तुमू तुमाआ ठरवीइल्या इटाआ गणतीइ पुरमाणे पेल ओते तेहें कोइत काल आन आज इटे पुरे नाहां कोआड़्ये?”<verse eid="EXO 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 5:15" />ताहां इस्राएलोअ सिपायों तकराट लेत जात कोइत फारोहो कोयो, “तू ताआ सिपायोंअरी एहें कोइत काहा सालेहे? <verse eid="EXO 5:15" /><verse number="16" style="v" sid="EXO 5:16" />ताआ आधिकारी ते पुहूटो होदीत नाहां आपता आन ते आमुहूं कोया कोअताहा, ‘इटे बोणावा,’ आन ताआ सिपायों मार बी खादुहू; पोन सुक ताआज आधिकाऱ्योंअ होय.”<verse eid="EXO 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 5:17" />फारो कोयो, “तुमू आलह्या होय आलह्या, कामोअ नेट्या; तियाहा कोत कोताहा, के ‘आमुहूं यहोवा देवोअ काजे गाराहा आपीइलाअ काजे जाअहूं द्या.’ <verse eid="EXO 5:17" /><verse number="18" style="v" sid="EXO 5:18" />ओमे जात कोइत तुमाआ काम कोआ; आन तुमुहूं पुहूटो होदीत ने जोड़े, पोन इटाआ गणती तुमुहूं पुरी कोइली आवे.” <verse eid="EXO 5:18" /><verse number="19" style="v" sid="EXO 5:19" />जेहेलाम इस्राएलवालाआ सिपायी ए गोठ उनाअया के तियांआं इटाआ गणती कमी ने ओवे, आन हरेक दिही एतोहोज काम पुरो कोअहूं पोड़े, ताहां तियां जांइत लेदो के तियांआं ओड़सनीइ दिही आवीत लागाहा.<verse eid="EXO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 5:20" />जेहेलाम ते फारोअ सामने रोत बाअथे निहींत आया, ताहां मोशे आन आरोन, जे तियांहां मिलीइलाअ काजे उबा रोयाते, तियांहां मिल्या; <verse eid="EXO 5:20" /><verse number="21" style="v" sid="EXO 5:21" />आन तियां मोशे आन आरोनोहो कोयो, “यहोवा देव तुमापोअ नजर टाकीत न्याय कोए, काहाके तुमू आमुहूं फारोअ आन तियाआ आधिकाऱ्योंअ नजरेमेहें आमाआ सीस ओवे एहेलोहो आमाआ विरुद्दाम कोअयोहो; तुमू आमुहूं माआड़ीलोअ काजे तियांआं आथोम तारवाआ आपी देदीही.”<verse eid="EXO 5:21" /></para>
  <para style="s">देवोहो मोशेए तकराट</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22" />ताहां मोशे यहोवाआ जागे वोलीत कोइत कोयो, “प्रभु, तु यां माअहोंहों एहेलोहो दुख काहा आप्यो? आन तु माहूं इंहीं काहा मोकल्यू. <verse eid="EXO 5:22" /><verse number="23" style="v" sid="EXO 5:23" />जोयोंअ रोत आंय ताआ नावसे फारोअ जागे गोठी कोइलाआ कोअते गोयु, तिहीं रोत तिये यां माअहोंअरी बाक्त वेवारो कोअयोहो, आन तुमे ताआ माअहुंहूं थोड़ीक बी मदत नाहां कोअयी.”<verse eid="EXO 5:23" /></para>
  <chapter eid="EXO 5" />
  <chapter number="6" style="c" sid="EXO 6" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1" />ताहां यहोवा मोशेहे कोयो, “जो वेवारो आंय फारोअरी कोअहीं तो ओमें तु देखही. हुदाअलीज माआ वोडी सेक्ती पालित कोइत तो तुमुहूं जाअहूं देय.”<verse eid="EXO 6:1" /></para>
  <para style="s">देव मोशेहे हादत्लू</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2" />देवे मोशेहे कोयो, “आंय यहोवा होय. <verse eid="EXO 6:2" /><verse number="3" style="v" sid="EXO 6:3" />आंय सर्वसेक्तिमान देवोअ नावसे अब्राहाम, इसाहाक, आन याकोबोहो दर्शन आपतुतो, पोन यहोवाआ नावसे आंय तियांपोअ प्रगट नाहां ओवू.<note caller="+" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="GEN 17:1">उत्प 17:1</ref>; <ref loc="GEN 28:3">28:3</ref>; <ref loc="GEN 35:11">35:11</ref>; <ref loc="EXO 3:13-15">निर्ग 3:13-15</ref>; <ref loc="GEN 14:22">उत्प 14:22</ref></char></note> <verse eid="EXO 6:3" /><verse number="4" style="v" sid="EXO 6:4" />आन आंय तियांआं आरी माआ शप्पत मजबुत कोअयीही, मोन्जे कनान देसोम जियामेहें ते पारके ओत कोइत रोतेते, तियांहां तो आपी देंव<note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="GEN 15:18">उत्प 15:18</ref>; <ref loc="GEN 17:7">17:7</ref> </char></note> <verse eid="EXO 6:4" /><verse number="5" style="v" sid="EXO 6:5" />इस्राएली जियांहां मिसरवाले माअहें गुलामीमेहें मेकतेहे, तियांआं तारासो बाप्तिमेहें उनाइत कोइत आंय माआ शप्पत ओर कोअयीही. <verse eid="EXO 6:5" /><verse number="6" style="v" sid="EXO 6:6" />याअ कोअते तू इस्राएल वालाहां को, ‘आंय यहोवा होय, आन आंय मिसरीइ वोजाआ निसे रोत काडीहीं, आन तियांआं गुलामगिरीम रोत वासाडीहीं, आन माआं आथ नांबू कोइत आन तियांहां वोडू डोंड आपित कोइत तुमुहूं सोड़वीहीं, <verse eid="EXO 6:6" /><verse number="7" style="v" sid="EXO 6:7" />आन आंय तुमुहूं माआं माअहें बोणावीइलोअ काजे हादीत लेहीं, आन आंय तुमाआं देव ठरिहीं; आन तुमू जाईंत लेहा के आंय तुमाआं यहोवा होय जो तुमुहूं मिसरवालाआं दाबावोअ निसे रोत काडीत लेतायू, <verse eid="EXO 6:7" /><verse number="8" style="v" sid="EXO 6:8" />आन जिया देसोहो आपीइलाअ शप्पत आंय अब्राहाम, इसाहाक, आन याकोबोअरी खादीते, तियामेहें आंय तुमुहूं पोताड़ीत कोइत तियाहा तुमाआं ताबाम कोई देहीं, आंय ते यहोवा होय.’” <verse eid="EXO 6:8" /><verse number="9" style="v" sid="EXO 6:9" />ए गोठी मोशे इस्राएलोहो उनाड़्यी, पोन तियें मोनोअ सिंता आन गुलामगिरीइ तारासोवाअहीं तियाआ ने उनाअये.<verse eid="EXO 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 6:10" />ताहां यहोवा मोशेहे कोयो, <verse eid="EXO 6:10" /><verse number="11" style="v" sid="EXO 6:11" />“तु जात कोइत मिसरोअ राजा फारोहो को के तो इस्राएल माअहोंहों तियाआ देसोम रोत निहींत जाअहूं देअहूं जोवे.”<verse eid="EXO 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 6:12" />पोन मोशे यहोवाहा कोयो, “पाल, इस्राएलोअ माअहें माआ ने उनाये; ताहां फारो माआ सारखा तोतर्‍याआ केहें कोइत उनाये?”<verse eid="EXO 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 6:13" />ताहां यहोवा मोशेहे आन आरोनोहो हुकूम आप्यू: “इस्राएल माहुंहूं आन मिसरोअ राजा फारोहो को के मी इस्राएल माअहोंहों मिसर देसोम रोत बाहर काडीत लेत जाअलोअ आदेश आपी देदुहू.”<verse eid="EXO 6:13" /></para>
  <para style="s">मोशेए आन आरोनोअ पारवाड़</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 6:14" />तियांआं डायहांआ घराणाआ मुख्य माटी ए होय: इस्राएलोअ डायु पोर्‍यु, रूबेनोअ बेटुह्हू: हानोक, पल्लू, हेस्रोन, आन कर्म्मी; यांवाअहीं रूबेनोअ कुटुंबो निहींयो. <verse eid="EXO 6:14" /><verse number="15" style="v" sid="EXO 6:15" />शिमोनोअ बेटुह्हू: यमूएल, यामीन, ओहोद, याकीन आन सोहार, आन एक कनानी बायीइ पोऱ्यु शाऊल; तियांमेहें रोत शिमोनोअ कुटुंबो निहींयो.<note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="GEN 40:10">उत्प 40:10</ref></char></note> <verse eid="EXO 6:15" /><verse number="16" style="v" sid="EXO 6:16" />लेवीइ बेटाह्हा जियावाअहीं तियांआं पारवाड़ी साल्यी ते, तियांआं नाव ए होय; मोन्जे गेर्शोन, कोहात आन मरारी; आन लेवीइ एक होवेन सदोतीस वोरह्ये जिवयू.<note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="NUM 3:17">गणती 3:17</ref>; <ref loc="GEN 40:8-13">उत्प 40:8-13</ref></char></note> <verse eid="EXO 6:16" /><verse number="17" style="v" sid="EXO 6:17" />गेर्शोनोअ पोऱ्या लिबनी आन शिमी ओता जियां वाअहीं तियांआं पारवाड़ साल्यी. <verse eid="EXO 6:17" /><verse number="18" style="v" sid="EXO 6:18" />कहातोअ पोऱ्या: अम्राम, यिसहार, हेब्रोन आन उज्जीएल; आन कोहातोअ पुरो वय एक होव तेहेंतीस वोर्ह्ये ओवो.<note caller="+" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="1CH 6:18">1 इति 6:18</ref></char></note> <verse eid="EXO 6:18" /><verse number="19" style="v" sid="EXO 6:19" />मरारीइ पोऱ्या: महली आन मूशी. लेवीइ कुटुंबो जियां वाअहीं तियांआं पारवाड़ी साल्यी.<verse eid="EXO 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 6:20" />अम्रामे तियाआ फुयी योखबेद यीइरी वेहेवाल कोअल्यो आन तियीइ आरोन आन मोशे उबज्या; आन अम्रामोअ पुरो वय एक होव सदोतीस वोरहोअ ओवी. <verse eid="EXO 6:20" /><verse number="21" style="v" sid="EXO 6:21" />यिसहारोअ पोऱ्या: कोरह, नेपेग, आन जिक्री. <verse eid="EXO 6:21" /><verse number="22" style="v" sid="EXO 6:22" />उज्जीएलोअ पोऱ्या: मिशाएल, एलसापान आन सित्री.<verse eid="EXO 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 6:23" />आरोन आम्मीनादाबोओ पोऱ्यी, आन नहशोनोअ बोअह्हीं, एलिशेबाअ आरी वेहवाल कोअयो; आन तियाप रोत नादाब, अबीहू, एलाजार, आन ईतामार उब्ज्ये. <verse eid="EXO 6:23" /><verse number="24" style="v" sid="EXO 6:24" />कोरहोअ पोऱ्या: अस्सीर, एलकाना आन अबीआसाप; आन यांपोअ रोत कोरहोअ जाती निहींयी. <verse eid="EXO 6:24" /><verse number="25" style="v" sid="EXO 6:25" />आरोनोअ पोऱ्यु एलाजार पुतीएलोअ एकी पोर्‍यीइरी वेहेवाल कोअयो; आन तियीपोअ रोत पिनाहास उबज्यु. तियाप रोत तियाआ जात साल्यी. लेवीइ घराणाअ पारवाड़ीइ मुख्य माटी ओज होय.<verse eid="EXO 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 6:26" />आरोन आन मोशे ए तेज होय जियांहां यहोवा देवे ओ आदेश आप्युतो; “इस्राएलोहो टोला टोला कोइत मिसरोम रोत बारथे काडा.” <verse eid="EXO 6:26" /><verse number="27" style="v" sid="EXO 6:27" />ए तेज मोशे आन आरोन होय जिये मिसरोअ राजा फारोहो कोयो के आमू इस्राएलोहो मिसर मेहें रोत काडीत लेत जाहूं.<verse eid="EXO 6:27" /></para>
  <para style="s">मोशे आन आरोनोहो प्रभुउ आदेश</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 6:28" />जेहेलाम प्रभु यहोवा मिसर देसोम मोशेहे ए गोठ कोअयी, <verse eid="EXO 6:28" /><verse number="29" style="v" sid="EXO 6:29" />तिया तियाहा कोयो, “आंय यहोवा होय; तियाह काजे जो किबी आंय ताहूं कोहीं तों आखो मिसरोअ राजा फारोहो कोजी.”<verse eid="EXO 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 6:30" />पोन मोशे यहोवाहा उत्तर आप्यो, “आंय ते गोगीइलाम तोतर्‍यू होय; आन फारो केहें कोइत माआ उनाये.”<verse eid="EXO 6:30" /></para>
  <chapter eid="EXO 6" />
  <chapter number="7" style="c" sid="EXO 7" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1" />ताहां यहोवा प्रभु मोशेहे कोयो, “उनाआ, आंय ताहूं फारोअ काजे प्रभुउ होस ठरवोहो; आन ताआ पाही आरोन ताआ भविश्यवक्ता ठरे. <verse eid="EXO 7:1" /><verse number="2" style="v" sid="EXO 7:2" />जो जो आदेश आंय ताहूं आपिहीं तोज तू कोजी, आन आरोन तिया फारोहो कोये, ताहां तो इस्राएलोहो तियाआ देसोम रोत निहींत जाअहूं देय. <verse eid="EXO 7:2" /><verse number="3" style="v" sid="EXO 7:3" />पोन आंय फारोअ मोनोहो कठीण कोइ देहीं, आन माआ वारुज समत्कार मिसर देसोमेहें देखाड़ीहीं.<note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="ACT 7:36">प्रेशित 7:36</ref></char></note> <verse eid="EXO 7:3" /><verse number="4" style="v" sid="EXO 7:4" />तेबी फारो तुमाआ ने उनाये; आन आंय मिसर देसो पोअ मिसरोहो आंय वोडु डोंड आपित कोइत माआ सेना मोन्ज्ये माआ इस्राएलोअ माअहुंहूं मिसर देसोम रोत काडीत लेहीं, <verse eid="EXO 7:4" /><verse number="5" style="v" sid="EXO 7:5" />आन जेहेलाम आंय मिसरोपोअ आथ टाकीत इस्राएलोहो तियांआं विसमेहें रोत काडीत लेहीं, ताहां मिसरवाले जाईंत लेय, के आंय यहोवा होय.” <verse eid="EXO 7:5" /><verse number="6" style="v" sid="EXO 7:6" />ताहां मोशे आन आरोन यहोवाआ आदेशोअ नुसार कोअयो. <verse eid="EXO 7:6" /><verse number="7" style="v" sid="EXO 7:7" />जेहेलाम ते फारोअरी गोठी कोआ वोल्या, ताहां मोशे हांयशी वोरहोअ, आन आरोन त्र्यांयशी वोरहोअ ओतू.<verse eid="EXO 7:7" /></para>
  <para style="s">आरोनोअ डेंगार</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8" />ताहां यहोवा देवे मोशे आन आरोनोहो कोयो, <verse eid="EXO 7:8" /><verse number="9" style="v" sid="EXO 7:9" />“जाहां फारो तुमुहूं कोये, ‘तुमाआ सेक्ती वाअहीं एखु समत्कार देखाड़ा,’ ताहां तू आरोनोहो कोजी, ‘ताआ डेंगार लेत कोइत फारोअ आगाड़ी टाकी दे के तो हाप बोणीत जाय.’” <verse eid="EXO 7:9" /><verse number="10" style="v" sid="EXO 7:10" />ताहां मोशे आन आरोन फारोअ जागे जात कोइत देवोअ आदेशोअ परमाणे कोअयो; आन जेहेलाम आरोन तियाआ डेंगार फारो आन तियाआ आधिकारीइ आगाड़ी टाकी देदी, ताहां ते हाप बोणित गोयी. <verse eid="EXO 7:10" /><verse number="11" style="v" sid="EXO 7:11" />ताहां फारो राजे माहाराजोहों आन बोड़वाहा हादाड़्या; आन मिसरोअ जादुगारोहों आवीत कोइत तियां तियांआं तंतर-मंतर कोअयो.<note caller="+" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="2TI 3:8">2 तिम 3:8</ref> </char></note> <verse eid="EXO 7:11" /><verse number="12" style="v" sid="EXO 7:12" />तियें बी तियां तियांआं डेंगार टाकी देदी, आन ते बी हाप बोणीत गोयी; पोन आरोनोअ डेंगार तियांआं डेंगारीही गिंइत लेदो. <verse eid="EXO 7:12" /><verse number="13" style="v" sid="EXO 7:13" />पोन फारोअ मोन फाशोअ कोठीण ओत गोयो, मोशेहे आन आरोनोहो गोठीही ने मान्यू. जेहेलोहो यहोवा देवे कोयोतो.<verse eid="EXO 7:13" /></para>
  <para style="ms">मिसर दोह देसोपोअ पिड़ा:</para>
  <para style="s">पेहली पिड़ा: रक्त</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14" />ताहां यहोवा प्रभु मोशेहे कोयो, “फारोअ मोन वातड़ो ओत गोयोहो आन तो तियां माअहोंहों जाअहूं नाहां देतु. <verse eid="EXO 7:14" /><verse number="15" style="v" sid="EXO 7:15" />जेहेलाम फारो वेगीइ वेले, नोयीइहें आवे ताहां तु तियाआ जागे जाजी, तु नील नोयीइ मेरे तियाआ वाट जोवजी, जे डेंगार हाप बोणीत गोयीते, तियीही ताआ आथोम लेत लेजी. <verse eid="EXO 7:15" /><verse number="16" style="v" sid="EXO 7:16" />आन तु तियाहा कोजी, ‘इब्री माअहोंअ देव यहोवा ताहूं एहें कोय तेहें मोकल्युहू के, तू माआं माअहोंहों रानोमेहें माआं भक्ती कोए तेहें जाअहूं दे. पोन ओमे जाआं तू नाहांजी उनाअयू. <verse eid="EXO 7:16" /><verse number="17" style="v" sid="EXO 7:17" />यहोवा ओं कोहे, तियापोअ रोत तु जाईंत लेही के आंयज यहोवा होय; पाल, आंय माआ आथोमेऱ्यीइ डेंगारीही नील नोयीइ पाअयोंपोअ लागावीहीं, आन नोयीइ पाईं रगत बोणीत जाय,<note caller="+" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="ACT 16:4">प्रेशित 16:4</ref> </char></note> <verse eid="EXO 7:17" /><verse number="18" style="v" sid="EXO 7:18" />आन जे मासे नील नोयीमेहें होय तें मोइत जाय, ताहरीइ खाड गुंदाइ वोले, आन खाडीइ पाईं मिसरवालाआं काजे पिअहूं जोगोहो ने रोय.’”<verse eid="EXO 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 7:19" />तिहीं रोत यहोवा देवे मोशेहे कोयो, “आरोनोहो को के, ताआ डेंगार लेत कोइत मिसर देसोअ आखी खाडीपोअ, खोबरीपोअ आन धरणोपोअ ताआ आथ तोइत उबू रो, ताहां तो आखो पाईं रगत बोणित जाय, आन आखा मिसर देसोअ पाईं पोइलोअ बासने मोन्ज्ये लाकड़ुउ कोड्बे आन डोणोअ देगे नेहें रक्ताल्लाज ओत जाय.”<verse eid="EXO 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 7:20" />ताहां मोशे आन आरोने यहोवा देवे जेहें कोयो, तेहेंज कोइत कोअयो, मोन्ज्ये तियाआ डेंगार उसी कोइत फारो आन तियाआ सिपायड़ाआ देखताइज नील खाडीइ पाअयोंपोअ लागावयो, ताहां खाडीइ आखो पाईं रक्त बोणीत गोयो.<note caller="+" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="PSA 78:44">भजन 78:44</ref>; <ref loc="PSA 105:29">105:29</ref></char></note> <verse eid="EXO 7:20" /><verse number="21" style="v" sid="EXO 7:21" />आन खाडीइ आखे मासे मोइत गोये; आन खाड सिसड़ाअलिही गुंदाइ वोल्यी, ताहां मिसरवाले माअहें खाडीइ पाईं पीत ने सेके; आन आखा मिसर देसोम रक्त ओत गोयो. <verse eid="EXO 7:21" /><verse number="22" style="v" sid="EXO 7:22" />ताहां मिसरोअ जादूगारहों बी तियांआं जादू-मोंतरो वाअहीं तेहेलोज कोअयो; तेबी फारोअ मोन वातड़ो ओत गोयो, आन यहोवा देवोअ कोल्यी गोठी तो मोशेए ना आरोनोअ ने मान्यू. <verse eid="EXO 7:22" /><verse number="23" style="v" sid="EXO 7:23" />फारो यापोअ बी दिहान ने देदो, आन मुउड़ात तियाआ कोअ जातू रोयू. <verse eid="EXO 7:23" /><verse number="24" style="v" sid="EXO 7:24" />आन आखे मिसरवाले माअहें पीइलाअ पाअयोंअ काजे नील खाडीइ मेरे कुवा खुएं वोल्ये, काहाके तें खाडीइ पाईं ने पीत सेकतेते.<verse eid="EXO 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 7:25" />जेहेलाम यहोवा देवे नील नोयीही लागावयो तेदिहीं रोत हांत दिही ओत गोयाते.<verse eid="EXO 7:25" /></para>
  <chapter eid="EXO 7" />
  <chapter number="8" style="c" sid="EXO 8" />
  <para style="s">दुसरी पिड़ा:</para>
  <para style="s2">डेटके</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 8:1" />तिहीं रोत यहोवा देवे मोशेहे कोयो, “फारोअ जागे जात कोइत को, ‘यहोवा ताहूं एहें कोहे के: माआं माअहोंहों माआं भक्ती कोए तेहें जाअहूं दे. <verse eid="EXO 8:1" /><verse number="2" style="v" sid="EXO 8:2" />तु जर तेहें ने कोअही, ताहां आंय ताआ पुरा देसोहो डेटके मोकलीत कोइत डोंड आपिहीं. <verse eid="EXO 8:2" /><verse number="3" style="v" sid="EXO 8:3" />आन नील खाडीम डेटके एतेज पोआइत जाय, ते ताआ राजवाड़ाअहें आवे आन ते ताआ हुवीइलोअ खुलीमेहें ताआ आथरुपोअ, आन ताआ कर्मसाऱ्योंअ कोअमेहें आन ताआ आखा माअहोंअ कोअमेहें, तेतोज नाहां पोन ताआ आंड्लो आन रांदीत खाअलाअ बासनोमेहें सोड़ीत लागे; <verse eid="EXO 8:3" /><verse number="4" style="v" sid="EXO 8:4" />तें डेटके तापोअ, ताआ माअहों पोअ आन ताआ कर्मसाऱ्यों पोअ आन आखापोअ सोड़ीत लागे.’”<verse eid="EXO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 8:5" />फाशुउ यहोवा देव मोशेहे कोयो, “आरोनोहो को, के तियाआ डेंगार खाडीपोअ, खोबरीपोअ आन धरणोपोअ आथ उसू कोइत तोइत रोय आन डेटके मिसर देसोम पोआत गोये.” <verse eid="EXO 8:5" /><verse number="6" style="v" sid="EXO 8:6" />ताहां आरोन मिसर देसोअ आखाअ पाअयोंअ जागा पोअ तियाआ आथ उसू कोइत रोयू; आन डेटके आवीत कोइत मिसर देसोहो टापित लेदू.<note caller="+" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="PSA 105:30">भजन 105:30</ref></char></note> <verse eid="EXO 8:6" /><verse number="7" style="v" sid="EXO 8:7" />पोन जादूगार बी मिसर देसोपोअ तियांआं जादू-मंतर कोइत डेटके लेत आवया.<verse eid="EXO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 8:8" />ताहां फारो राजे मोशेहे आन आरोनोहो हादीत कोयो, “यहोवा देवोह रावणी कोआ के तो यां डेटकाहां माआं जागे रोते आन माआं माअहोंअ जागे रोत सेटे कोई देअहूं जोवे; आन आंय इस्राएलवाला माअहोंहों जाअहूं देहीं, मोन्ज्ये तें यहोवा देवोहो गाराहा आपित सेके.”<verse eid="EXO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 8:9" />ताहां मोशे फारो राजाहा कोयो, “आंय ताआ वोतीइ प्रार्थना कोइलाआ काजे खुस होये, पोन एतीज गोठ कोत दे के आंय केती वेले ताआ वोतीइ रावणी कोओ, के तापोअ आन ताआ कोअमेहें, ताआ कर्मसाऱ्यों पोअ आन ताआ माअहोंपोअ रोत यहोवा देव डेटके दुर कोई देय, आन निस्ते नील नोयीम एतेज रोय.”<verse eid="EXO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 8:10" />तिये कोयो, “हांदाआ माआं काजे प्रार्थना कोअजी.” मोशे तियाहा कोयो, “तुमे कोयो तेहेंज कोइत ओवे, मोन्ज्ये ताहूं मुंदू पोडुहूं जोवे के आमाआं परमेश्वर यहोवाआ हारकू बिहीरु कोड्लूज देव कायनाहां. <verse eid="EXO 8:10" /><verse number="11" style="v" sid="EXO 8:11" />आन डेटके ताआ जागे रोते आन ताआ कोअमेहें रोते, ताआ कर्मसाऱ्योंअ जागे रोते आन ताआ माअहोंअ जागे रोते सेटे ओत जाय, निस्ते नील खाडीम एतेज रोय.” <verse eid="EXO 8:11" /><verse number="12" style="v" sid="EXO 8:12" />ताहां मोशे आन आरोन फारो राजाअ सामने रोत निहींत जाता रोया; आन मोशे यहोवा देवोह रावणी कोअयी के तें डेटके फारोपोअ मोकल्ये तें सेटे ओत जाय. <verse eid="EXO 8:12" /><verse number="13" style="v" sid="EXO 8:13" />आन यहोवा देवे मोशे कोयो तेहेंज कोइत कोअयो; आन डेटके कोअमेहें, खोलीमेहें, गावोमेहें आन खेतोमेहें मोइत गोये. <verse eid="EXO 8:13" /><verse number="14" style="v" sid="EXO 8:14" />माअहें तियां डेटकाआ टिग कोइ देदा, आन पुरु देस गोंदारुन गोंदारु वोलीत गोयू. <verse eid="EXO 8:14" /><verse number="15" style="v" sid="EXO 8:15" />पोन फारो राजे देख्यो के ओमे आराम जोड़्युहू ताहां यहोवा देवोअ कोल्याआ परमाणे फाशुउ तियाआ मोन वातड़ो कोइत लेदो, आन तियांआं गोठी ने उनाअयू.<verse eid="EXO 8:15" /></para>
  <para style="s">तिसरी पिड़ा:</para>
  <para style="s2">पिहवे</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16" />फाश्योअ यहोवा देवे मोशेहे कोयो, “आरोनोहो को, ‘तु ताआ डेंगार उसलीत पुयींपोऱ्याआ तुलाहा लागाव, तिया तुलावाअहीं मिसर देसोम पिहवे बोणित जाअहूं जोवे.’” <verse eid="EXO 8:16" /><verse number="17" style="v" sid="EXO 8:17" />ताहरोअ आरोने तियाआ आथोमेऱ्यीइ डेंगार विसीत पुयींपोऱ्याआ तुलापोअ लागावयी, आन तिहीं वाअहीं आखा मिसर देसोम तुलाआ पिहवे बोणित गोये. तें जनवारोपोअ आन माअहोंपोअ पिहवे ओत गोये. <verse eid="EXO 8:17" /><verse number="18" style="v" sid="EXO 8:18" />ताहां जादूगारों बी तियांआं जादू-मोंतरोवाअहीं तुलामेहें रोत पिहवे बोणाविलोअ कोशित कोअयी, पोन ते ने कोइत सेका. तें पिहवे जनवार आन माअहों पोअ तेहेलेज रोत गोये. <verse eid="EXO 8:18" /><verse number="19" style="v" sid="EXO 8:19" />ताहां जादूगारों फारो राजाहा कोयो, “ओं ते देवोअ आथऱ्योअ<note caller="+" style="f"><char style="fr" closed="false">8:19 </char><char style="fq" closed="false">आथऱ्योअ </char><char style="ft" closed="false">आंगूउ</char></note> काम होय.” तेबी यहोवा देवोअ कोल्या परमाणे फारो राजाअ मोन वातड़ो ओवतो गोयो, आन तिये मोशे आन आरोनोअ गोठ ने मान्यू.<note caller="+" style="x"><char style="xo" closed="false">8:19 </char><char style="xt" closed="false"><ref loc="LUK 11:20">लुक 11:20</ref></char></note><verse eid="EXO 8:19" /></para>
  <para style="s">शोवथी पिड़ा:</para>
  <para style="s2">डाहां</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20" />फाश्योअ यहोवा देवे मोशेहे कोयो, “हांदाआ वेगीइ जात कोइत फारो राजाआ सामने जात उबू रोजी, तो खाडीअहें आवे, तेहेलाम तु तियाहा कोजी, ‘यहोवा देव ताहूं कोहे: माआं माअहोंहों माआं भक्ती कोए तेहें जाअहूं दे. <verse eid="EXO 8:20" /><verse number="21" style="v" sid="EXO 8:21" />जर तु माआ माअहोंहों ने जाअहूं देही, ताहां उनाइत ले, आंय तापोअ आन ताआ कर्मसाऱ्यों पोअ, ताआ माअहों पोअ डाहांआं गोअड़ी मोकलीहीं आन मिसरवालाआं कोएं आन तियांआं रोअलाआ जागू बी डाहां वाअहीं पोआत जाय. <verse eid="EXO 8:21" /><verse number="22" style="v" sid="EXO 8:22" />तेदिहीं आंय गोशेन देसोहो जिहीं माआं माअहें रोतेहे तियांहां आलांग कोअहीं, पोन तेदिहीं तियामेहें डाहें ने रोय; मोन्ज्ये तिया वाअहीं तू जाईंत लेअहूं जोवे के, धरतीपोअ<note caller="+" style="f"><char style="fr" closed="false">8:22 </char><char style="fq" closed="false">धरतीपोअ </char><char style="ft" closed="false">देसोअ विसमेहें</char></note> आंयज यहोवा देव होय. <verse eid="EXO 8:22" /><verse number="23" style="v" sid="EXO 8:23" />आन आंय माआ माअहों में आन ताआ माअहोंअ विसमेहें गालो मेकिहीं. ओ समत्कार हांदाआ ओवे.’” <verse eid="EXO 8:23" /><verse number="24" style="v" sid="EXO 8:24" />ताहां यहोवा देवे तेहेंज कोइत कोअयो, फारोअ कोअमेहें आन तियाआ कर्मसाऱ्योंअ कोअमेहें, आखा मिसर देसोमेहें डाहांआं टोलान टोला पोआइत गोया, आन डाहां वाअहीं तियाआ देसोअ नुकसान ओवो.<note caller="+" style="x"><char style="xo" closed="false">8:24 </char><char style="xt" closed="false"><ref loc="PSA 78:45">भजन 78:45</ref></char></note><verse eid="EXO 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 8:25" />ताहां फारो राजे मोशे आन आरोनोहो हादाड़ीत कोयो, “तुमू जावा आन याज देसोमेहें तुमाआ देवोअ काजे गाराहा आपा.”<verse eid="EXO 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 8:26" />मोशे कोयो, “काहाके आमाआ देवोअ काजे एहें कोइलोअ बोराबर कायनाहां के आमू मिसरवालाआं सिसड़ाअली वस्तु गाराहा आपो; आन जर आमू मिसरवालाआं देखताइज तियांआं सिसड़ाअली वस्तु गाराहा आपो<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">सोड़वो</char></note> ताहां तें आमुहूं डोणाटतीज ने माइत टाकी देय के? <verse eid="EXO 8:26" /><verse number="27" style="v" sid="EXO 8:27" />आमू रानोमेहें तिन दिही जाआं सालीत जाहूं आन आमाआं देव यहोवाअ काजे तो जेहलोहो कोय तेहेलोहो गाराहा आमू आपहूं.”<verse eid="EXO 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 8:28" />फारो राजे कोयो, “आंय तुमुहूं रानोमेहें तुमाआं यहोवा देवोहो गाराहा आपे तेहें काजे जाअहूं देहीं; पोन वादार सेटे मा जाहा. माआं वोतीइ प्रार्थना कोआ.”<verse eid="EXO 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 8:29" />ताहां मोशे उत्तर आप्यो, “उनाआ, आंय ताआ जागे रोत निहींत जाहीं तेहेलाम आंय यहोवा देवोहो प्रार्थना कोअहीं के डाहांआं टोला जाता रोय, आन ताआ आन ताआ कर्मसाऱ्योंअ आन माअहोंअ जागे रोत हांदाआज सेटे ओत जाय; पोन आगाड़ी रोत आमाआं यहोवा देवोहो गाराहा आपीइलोअ काजे जाहूं, ताहां फारो ठोगित कोइत आमुहूं ने रुकुहूं जोवे.”<verse eid="EXO 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 8:30" />ताहां मोशे फारोअ जागे रोत बारथे निहींत कोइत यहोवा देवोह प्रार्थना कोअयी. <verse eid="EXO 8:30" /><verse number="31" style="v" sid="EXO 8:31" />आन मोशेए कोल्या परमाणे यहोवा देवे डाहांआं टोलू फारो आन तियाआ कर्मसारी आन तियाआ माअहोंअ जागे रोत दूर कोई देदू; एक बी डाहों ने रोयो. <verse eid="EXO 8:31" /><verse number="32" style="v" sid="EXO 8:32" />ताहां फारो यी फेरे बी तियाआ मोन कठीण कोअयो, आन तियां माअहोंहों जाअहूं ने देदे.<verse eid="EXO 8:32" /></para>
  <chapter eid="EXO 8" />
  <chapter number="9" style="c" sid="EXO 9" />
  <para style="s">पासवी पिड़ा:</para>
  <para style="s2">जनवारोंअ मोत</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1" />तिहीं रोत यहोवा देवे मोशेहे कोयो, “फारोअ जागे जात कोइत को, ‘इब्री माअहोंअ देव यहोवा ताहूं एहें कोहे: माआं माअहोंहों जाअहूं दे के तें माआं भक्ती कोइत सेके. <verse eid="EXO 9:1" /><verse number="2" style="v" sid="EXO 9:2" />जर तु तियांहां ने जाअहूं देही, फाश्युउ बी तोइत रोही, <verse eid="EXO 9:2" /><verse number="3" style="v" sid="EXO 9:3" />ताहां पालीत लेजी, आंय ताहूं एहेलुहू डोंड आपिहीं, के ताआ जे कोड़ा, गोदड़े, उटड़े, मेडे, डोगरेन बोकड़े एहेलेहे जनवारे होय तियांपोअ यहोवा देवोअ पाअयू आथ पोड़े आन जुदी वोडी मोराय साले. <verse eid="EXO 9:3" /><verse number="4" style="v" sid="EXO 9:4" />पोन यहोवा देव इस्राएलवालाआ जनवारोंमेहें आन मिसरवालाआ जनवारोअ विसमेहें गालो मेकिहीं, इस्राएलवालाआ एक बी ने मोए’.” <verse eid="EXO 9:4" /><verse number="5" style="v" sid="EXO 9:5" />फाश्योअ यहोवा एहें कोत कोइत एक वेल ठरव्यी, “आंय ओं काम या देसोम हांदाआ कोअहीं.”<verse eid="EXO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 9:6" />बिहीरे दिहे यहोवा देवे तेहेंज कोअयो; आन मिसरवालाआ तोम आखे जनवारे मोइत गोये, पोन इस्राएलवालाआ एक जनवार बी ने मोयो.<note caller="+" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="PSA 78:50">भजन 78:50</ref></char></note> <verse eid="EXO 9:6" /><verse number="7" style="v" sid="EXO 9:7" />आन फारो राजा माअहोंहों मोकल्ये, पोन इस्राएलवालाआ एक बी जनवार ने मोअयोतो. ते बी फारोअ मोन वातड़ोज रोयो, तिये माअहोंहों जाअहूं ने देदो.<verse eid="EXO 9:7" /></para>
  <para style="s">साहावी पिड़ा:</para>
  <para style="s2">फुपला आन फोडक्ये</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8" />फाश्योअ यहोवा देवे मोशेहे आन आरोनोहो कोयो, “तुमू बेनू जोओं बाठीमेहें रोत एक मुठ खाआं लेतावा, आन मोशे तो खाआं फारोअ सामने जुगोमेहें उडाड़ी देय. <verse eid="EXO 9:8" /><verse number="9" style="v" sid="EXO 9:9" />ताहां तो सिणो तुलो बोणित पुरा मिसर देसोमेहें माअहूं आन जनवार बेनुपोअ फुपला आन फोड़क्ये बोणित जाय.”<note caller="+" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="REV 16:2">प्रगटी 16:2</ref></char></note> <verse eid="EXO 9:9" /><verse number="10" style="v" sid="EXO 9:10" />तियाह काजे बाठीमेऱ्युउ मुठ पोइत खाआं लेत कोइत फारोअ सामने उबा रोया, आन मोशे तो खाँआं जुगोम हावाआ वोल उडाड़ी देदू, ताहां तो माअहों आन जनवारोंअ पोअ फुपला आन फोड़क्ये बोणित गोये. <verse eid="EXO 9:10" /><verse number="11" style="v" sid="EXO 9:11" />तियां फोड़क्याआ वोजेसे ते जादूगार मोशेए सामने उबा रोत ने सेक्या, काहाके ते फोडक्ये जेहेलेहे आखा मिसरवाला माअहोंहों लागे तेहेलेज जादुगारोहों बी उबरीत पोड़्येते. <verse eid="EXO 9:11" /><verse number="12" style="v" sid="EXO 9:12" />पोन यहोवा देवे फारोअ मोनोहो फाशोअ वातड़ो कोइ देदो, जेहलोहो यहोवा देवे मोशेहे कोयोतो, तिये तियांआं गोठ ने मान्यू.<verse eid="EXO 9:12" /></para>
  <para style="s">सांतवी पिड़ा:</para>
  <para style="s2">गाराआ वोरहात</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13" />फाशुउ यहोवा देवे मोशेहे कोयो, “हांदाआ वेगऱ्युउ उठीत फारोअ सामने उबू रोजी, आन तियाहा कोजी, इब्री माअहोंअ देव यहोवा एहें कोहे: माआं माअहोंहों माआं भक्ती कोए तेहें जाअहूं दे. <verse eid="EXO 9:13" /><verse number="14" style="v" sid="EXO 9:14" />नेते आंय तापोअ<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="fq" closed="false">तापोअ </char><char style="ft" closed="false">ताआ दिलोपोअ</char></note> आन ताआ कर्मसाऱ्यों पोअ आन ताआ माअहोंपोअ आखी जातीइ पिड़ा टाकीहीं, जिहींवाअहीं तु जाईंत लेही के पुरी धरतीपोअ माआ होस बिहीरु कोडो देव कायनाहां. <verse eid="EXO 9:14" /><verse number="15" style="v" sid="EXO 9:15" />जर आंय आथ उठाड़तू ताहां तू आन ताआ माअहुंहूं पिड़ा वाअहीं माईंत टाकतु आन तुमूं धरतीपोअ रोत एकसोट्येज आरवात जाते. <verse eid="EXO 9:15" /><verse number="16" style="v" sid="EXO 9:16" />पोन खरीज आंय ताहूं एताआ काजे जिवतू रोअहूं देदू के आंय माआं सेक्ती ताहूं देखाडीत सेको, आन माआं नाव पुरी धरतीपोअ गाजाड़ो.<note caller="+" style="x"><char style="xo" closed="false">9:16 </char><char style="xt" closed="false"><ref loc="ROM 9:17">रोम 9:17</ref></char></note> <verse eid="EXO 9:16" /><verse number="17" style="v" sid="EXO 9:17" />केहें ओमे जाआं तु माआं माअहोंअ सामने सोताहा वोडू सोमजेहे, आन तियांहां जाअहूं नाहां देतू? <verse eid="EXO 9:17" /><verse number="18" style="v" sid="EXO 9:18" />होंबल, हांदाआ आंय यीज वेले एहेलेहे वोडे वोडे गारे पाडीहीं, एहेलेहे गारे मिसर देस थापन ओयुय तोयोंअ रोत ओमे जाआं केदीहींज ने पोड़्येय. <verse eid="EXO 9:18" /><verse number="19" style="v" sid="EXO 9:19" />तियाहा काजे ओमे माहुंहूं मोकलीत तुमाआ कोर्‍येए जनवारे आन सापड़ा जागामेहें जो किबी ओय तो मामार हाजा जागाम लेत जात रोअहूं जोवे; नेत जेते माअहें आन कोर्‍येए जनवारे सापड़ाम रोत जाय आन कोअमेहें ने जाय तियांपोअ गारे पोड़े, आन तें मोइत जाये.” <verse eid="EXO 9:19" /><verse number="20" style="v" sid="EXO 9:20" />तियाह काजे फारोअ थोड़ाक कर्मसारी जे देवोअ गोठीही बित सालताते तियां जिव जिवोअ सेवकोहों आन जनवारोहों कोअमेहें लेताया. <verse eid="EXO 9:20" /><verse number="21" style="v" sid="EXO 9:21" />पोन जियां यहोवा देवोअ गोठीपोअ ध्यान ने लागाड़्यो तियां सोताआ सेवक आन जनवारे सापड़ेज रोअहूं देदे.<verse eid="EXO 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 9:22" />ताहां यहोवा देवे मोशेहे कोयो, “ताआ आथ जुगोअहें उसू कोअ मोन्ज्ये आखा मिसर देसोअ माअहों, जनवारों आन खेतोअ आखी निली कामायीपोअ गारे पोड़े.” <verse eid="EXO 9:22" /><verse number="23" style="v" sid="EXO 9:23" />ताहां मोशे तियाआ डेंगारिही जुगोअहें उसी कोअयी, आन यहोवा देवोअ सेक्तीवाअहीं जुग गाजो वोल्यो आन गारे पोड़े वोल्ये आन आग धरतीपोअ जाआं आवी वोल्यी. एहें कोइत यहोवा देवे मिसर देसोपोअ गारे पाड़्ये. <verse eid="EXO 9:23" /><verse number="24" style="v" sid="EXO 9:24" />जे गारे पोडतेते तियांअरी आग बी पेलीत ओती, आन ते गारे एहेलेहे ओते के जोयोंअ रोत मिसर देस थापन ओतू तोयोंअ रोत एहेलेहे गारे केदिहींज नाहां पोड़्ये.<note caller="+" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="PSA 78:47">भजन 78:47</ref>; <ref loc="REV 8:7">प्रगटी 8:7</ref>; <ref loc="REV 16:21">प्रगटी 16:21</ref></char></note> <verse eid="EXO 9:24" /><verse number="25" style="v" sid="EXO 9:25" />तिहीं वाअहीं पुरा मिसर देसोम आखे माअहें, आखे जनवारे गारा वाअहीं मोइत गोये. आन खेतोमेऱ्यीइ आखी कामाय आन सापड़ामेऱ्येए आखे साड़े बी मुड़ात पोड़्ये.<note caller="+" style="x"><char style="xo" closed="false">9:25 </char><char style="xt" closed="false"><ref loc="REV 8:7">प्रगटी 8:7</ref>; <ref loc="REV 16:21">16:21</ref>; <ref loc="PSA 105:33">भजन 105:33</ref></char></note> <verse eid="EXO 9:25" /><verse number="26" style="v" sid="EXO 9:26" />निस्ते गोशेन इलाखामेऱ्येए इस्राएलवाले रोत्ले तिहीं एतेज गारे नाहां पोड़्ये.<verse eid="EXO 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 9:27" />ताहां फारो राजे मोशेहे आन आरोनोहो हादाड़्या आन तियांहां कोयो, “यी फेरे मी पाप कोअयुहू; यहोवा देव खोरु होय, आन आंय आन माआं माहें पापी होय. <verse eid="EXO 9:27" /><verse number="28" style="v" sid="EXO 9:28" />यहोवा देवोहो प्रार्थना कोआ; वाद्लाआ गाजीइलोअ आन गाराआ वोर्‍हात तोम जाअखुज ओत गोयू; ओमे ताहां आंय तुमुहूं जाअहूं देहीं, आन तुमु ने रुकाअहा.”<verse eid="EXO 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 9:29" />मोशे तियाहा कोयो, “होयरोम रोत निहींताज आंय यहोवा देवोअहें आथ उसा कोअहीं, ताहां वाद्लाआ गाजीइलोअ बोंद ओत जाय आन गारे बी फाशे ने पोड़े, इंहीं वाअहीं तु जाईंत लेही के धरती यहोवा देवोओज होय. <verse eid="EXO 9:29" /><verse number="30" style="v" sid="EXO 9:30" />तेबी माहूं मुंदू होय के, ओमेज बी तु आन ताआ कर्मसारी देवोह बित नाहां सालता.”<verse eid="EXO 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 9:31" />होंण आन काठ्ये गोंवें गारावाअहीं मोइत गोये, काहाके काठ्ये गोंवें निहींवीत गोयेते आन होंण फुला वोल्याते. <verse eid="EXO 9:31" /><verse number="32" style="v" sid="EXO 9:32" />पोन एक बी गोंव नुकसान ने ओवो, काहाके गोवें हांहतेहे पाकत्ले.<verse eid="EXO 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 9:33" />जाहां मोशे फारोअ जागे रोत होयरोअ बारथे जात कोइत यहोवा देवोअहें आथ उसा कोइत प्रार्थना कोअयी ताहां वाद्लो गाजीइलाअ आन गारे पोडीइलाअ बोंद ओवो आन तिहीं रोत वादार वोर्‍हात ने पोड्यू. <verse eid="EXO 9:33" /><verse number="34" style="v" sid="EXO 9:34" />जेहेलाम वोरहात, गारे, आन गाजीइलोअ बोंद ओवो, तेहेलाम फारो ओं देख्योन ताहरुउ मोन कड़क कोइत लेदोन फाशुउ तिया पाप कोअयू. <verse eid="EXO 9:34" /><verse number="35" style="v" sid="EXO 9:35" />आन एहें कोइत फारोअ मोन कोठीण ओवतो गोयो, आन तिये इस्राएल वालाहां जाअहूं ने देदे, जेहें कोइत यहोवा मोशे वाअहीं कोवाड़्योतो.<verse eid="EXO 9:35" /></para>
  <chapter eid="EXO 9" />
  <chapter number="10" style="c" sid="EXO 10" />
  <para style="s">आंठवी पिड़ा:</para>
  <para style="s2">टिड्ड्ये</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 10:1" />तिहीं रोत यहोवा देवे मोशेहे कोयो, “फारोअ जागे जा; काहाके मीज तियाआ आन तियाआ कर्मसाऱ्योंअ मोन कड़क कोई देदोहो, मोन्ज्ये आंय माआं समत्कार तियांआं विसमेहें देखाड़ीत सेको; <verse eid="EXO 10:1" /><verse number="2" style="v" sid="EXO 10:2" />आन तुमू तुमाआ पोऱ्याहां आन पोऱ्याआ पोऱ्याहां कोत देखाड़ीत सेकहा, के यहोवा देवे मिसर देसोवालाहां केहेलेहे फोगे बोणावये, आन माआ केहेला केहेला समत्कार तियांआं विसमेहें कोइत देखाड़्या; जियावाअहीं तुमू जाईंत लेहा के आंय यहोवा होय.”<note caller="+" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="DEU 4:9">कायदा 4:9</ref>; <ref loc="PSA 44:1">भजन 44:1</ref></char></note><verse eid="EXO 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 10:3" />ताहां मोशे आन आरोन फारोअ जागे जात कोइत कोयो, “इब्रीवालाआ देव यहोवा एहेंकोइत कोहे: तुमू केदिहीं जाआं माआ ने उनाअनारे? माआ माअहुंहूं जाअहूं द्या के ते माआ भक्ती कोए. <verse eid="EXO 10:3" /><verse number="4" style="v" sid="EXO 10:4" />जर तु माआ माहुंहूं जाअहूं ने देही ताहां उनाआ, हांदाआ आंय ताआ देसो मेहें टिड्ये लेत आविहीं, <verse eid="EXO 10:4" /><verse number="5" style="v" sid="EXO 10:5" />आन ते धरतीही एहेंकोइत टापित लेय के ते देखाइत ने पोड़े; आन तुमाआ जो किबी बोर्फा वाअहीं वासाइत रोयोहो तियाहा आरवीत देय, आन तुमाआ जेतेहे बी साड़े खेतोमेहें लागाड़्येहे तियांहां बी तें आरवीत देय, <verse eid="EXO 10:5" /><verse number="6" style="v" sid="EXO 10:6" />आन तें ताआ आन ताआ आखा आधिकाऱ्योंहों, इंहीं जाआं के आखा मिसरोअ कोअमेहें पोआइत जाय; एतेहे टिड्ड्ये ताआ डायहां नेत वेगाआ डायहां जोयोंअ रोत धरती पोअ उबज्या तोयोंअ रोत आज जाआं केदिहीं ने देख्यो.” ताहां तो फिरीत कोइत फारोअ जागे रोत जातु रोयू.<verse eid="EXO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 10:7" />ताहां फारोअ आधिकारी तियाहा कोना वोल्या, “तें माअहें केदिहीं जाआं आमाआं काजे फांदू बोणीत रोय? तियां माअहुंहूं जाअहूं दे के तें तियांआं देव यहोवाआ भक्ती कोए. केहें तु ओमे जाआं नाहां जांअतू के आखो मिसर आरवाअहे?”<verse eid="EXO 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 10:8" />ताहां मोशे आन आरोनोहो फारोअ जागे फाशोअ हाद्यो, आन तिये तियांहां कोयो “जावा, तुमाआ देव यहोवाअ भक्ती कोआ; पोन जे जानारे होय ते कोडे कोडे होय?”<verse eid="EXO 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 10:9" />मोशे कोयो, “आमुं ते पोऱ्या-पोर्‍यी, मेडे, डोगरेन बोकड़े आरी आन पोर्‍याअहीं रोत ते डायाअहीं जाआं आखे बादे जानारे, काहाके आमुहूं यहोवाअ काजे तिवार कोइलोअ होय.”<verse eid="EXO 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 10:10" />एहेंकोइत फारो राजा तियांहां कोयो, “यहोवा तुमाआरी रोये जर आंय तुमुहूं पोर्‍याअरीज जाअहूं देहीं ताहां; पाला, तुमाआ मोनोमेहें खाराबी होय. <verse eid="EXO 10:10" /><verse number="11" style="v" sid="EXO 10:11" />नाहां, एहलोहो ने ओवे; निस्ता तुमू माटी एताज जात कोइत यहोवाआ भक्ती कोअजा, तुमुहूं ओंज ते जोवतोतो.” आन मोशे आन आरोन फारोअ आगाड़ी रोत निहींत गोया.<verse eid="EXO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 10:12" />ताहां यहोवा मोशेहे कोयो, “मिसर देसोअ वोल ताआ आथ आगाड़ी कोअ के टिड्याआ टोलु मिसर देसोम सोड़ीत कोइत धरती पोअ जेतोहो बी ओन होय आन गारा वाअहीं वासाइत रोयोहो तिया आखाहा खात जाय.” <verse eid="EXO 10:12" /><verse number="13" style="v" sid="EXO 10:13" />तियाहा कोत मोशे तियाआ आथोमेऱ्यीइ डेंगार लेत मिसर देसोपोअ उमाअयू, ताहां यहोवा देवे दिही पोइत आन रात पोइत वारो सालाड़्यो, आन जेहेलाम हुज्यो तेहेलाम तियाआ वाराअरी टिड्ये आये. <verse eid="EXO 10:13" /><verse number="14" style="v" sid="EXO 10:14" />आन ते टिड्ये मिसर देसोमेहें आखे रानेज पसरीत गोये, तियांआं टोलू एतुहू वोडू ओतू के एतुहू वोडू टोलू मिसर देसोमेहें नाहां केदिहीं आयू आन फासाड़ी ने केदिहीं आवे.<note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="REV 9:2-3">प्रगटी 9:2-3</ref>; <ref loc="PSA 78:46">भजन 78:46</ref>; <ref loc="PSA 105:34">105:34</ref>; <ref loc="REV 9:2">प्रगटी 9:2</ref></char></note> <verse eid="EXO 10:14" /><verse number="15" style="v" sid="EXO 10:15" />तिये टोले आखी धरतीही टापित लेदी, तेतोज नाहां पोन तियांआं उसे उडीइला वाअहीं पुरा मिसर देसोम आंदारो सेवात गोयो; आन गाराआ तोड़ाका वाअहीं जों किबी वासाअयो ओय, तों आखो टिड्या खात नावासट नुसी देदो; आन मिसर देसोमेहें कोड्लाज साड़ोअ नेत साटवाआ निलो पान बी ने रोयो आन खेतोमेहें किज कामाय ने रोयी.<verse eid="EXO 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 10:16" />तेहेलाम फारो राजे मोशेहे आन आरोनोहों ताबुड़तुड़ हादाड़्या आन कोयो, “आंय तोम तुमाआ देव यहोवाअ विरुद्दाम आन तुमाआं विरुद्दाम पाप कोअयुहू. <verse eid="EXO 10:16" /><verse number="17" style="v" sid="EXO 10:17" />तियाह काजे ओमेएं फेरे तेबी माआ पाप माफ कोइ द्या आन तुमाआ देवोहो प्रार्थना कोआ के तो माआ पोअ रोत ए मोतोअ पिड़ा सेटे कोइ देय.” <verse eid="EXO 10:17" /><verse number="18" style="v" sid="EXO 10:18" />ताहां मोशे फारो राजा सामने रोत निहींत जातु रोयू आन देवोहो प्रार्थना कोअयी. <verse eid="EXO 10:18" /><verse number="19" style="v" sid="EXO 10:19" />ताहां यहोवा देवे दिही बुडताअहें वारो वोहाड़्यो आन तो वारो आखा टिड्याहां वोहाड़ीत लाल दोर्‍यामेहें टाकी देदे, ताहां मिसर देसोमेहें एक बी टिड्यो नाहां रोयो. <verse eid="EXO 10:19" /><verse number="20" style="v" sid="EXO 10:20" />पोन तेबी यहोवा देवे फारो राजाअ मोन फासोअ कठीण कोई देदो आन तिये इस्राएलवालाहा ने जाअहूं देदे.<verse eid="EXO 10:20" /></para>
  <para style="s">नोववी पिड़ा:</para>
  <para style="s2">आंदारो</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21" />ताहां यहोवा मोशेहे कोयो, “ताआ आथ जुगोअहें उसु कोअ के मिसर देसोपोअ आंदारो टापाइत जाय, एहलोहो आंदारो के आथो वाअहीं जाआं सापलाय.” <verse eid="EXO 10:21" /><verse number="22" style="v" sid="EXO 10:22" />ताहां मोशे तियाआ आथ जुगोअहें उसू कोअयू, आन पुरा मिसर देसोमेहें तिन दिही जाआं जाडो आंदारो टापाइत रोयो.<note caller="+" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="PSA 105:28">भजन 105:28</ref>; <ref loc="REV 16:10">प्रगटी 16:10</ref></char></note> <verse eid="EXO 10:22" /><verse number="23" style="v" sid="EXO 10:23" />तिन दिही जाआं कोडाहा कोडे ने देख्यो आन कोडोज जागापोअ रोत ने आल्यो; पोन पुरा इस्राएलवालाआ कोअमेहें उजालो ओतो.<verse eid="EXO 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 10:24" />ताहां फारो राजे मोशेहे हादाड़ीत कोइत कोयो, “तुमू जावा, तुमाआं देवोअ यहोवाआ भक्ती कोआ; तुमाआ पोऱ्याहां बी आरी लेतेज जावा; पोन तुमाआं मेडे, डोगरेन बोकड़े इहींज मिकीत जावा.”<verse eid="EXO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 10:25" />मोशे कोयो, “आमाआं एतेज नाहां पोन ताहूं बी गाराहा आन भेट कोइलाआ बोकड़े-वासड़े आपीइले आवनारे, तियांहां आमू आमाआं देवोह गाराहा आपित सेको. <verse eid="EXO 10:25" /><verse number="26" style="v" sid="EXO 10:26" />या कोअते आमाआ पाल्ल्ये जनवारे बी आमाअरी आवे, तियांआं एक खुर्‍यो बी ने रोय, काहाके तियाजमेहें रोत आमुहूं आमाआ देव यहोवाहा भक्तीइ सामान लेअलो आवे, आन आमू जाअहूं जाआं तिहीं नाहां पोते ताअहूं जाआं नाहां जाअते के कि कि लेत कोइत यहोवाअ भक्ती कोइला ओय.”<verse eid="EXO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 10:27" />पोन यहोवा देवे फारो राजाअ मोन कठीण कोइ देदो, तिहीं वाअहीं तिये तियांहां जाअहूंन्ने देदे. <verse eid="EXO 10:27" /><verse number="28" style="v" sid="EXO 10:28" />ताहां फारो राजे मोशेहे कोयो, “माआ सामने रोत निहींत जा! ओमे रोत ताआ सोब माहूं फाशुउ मा देखाड़ही, जेदिहीं ताआ सोब माहूं देखाड़ही तेदिहींज तु मोअही.”<verse eid="EXO 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 10:29" />मोशे कोयो, “तुमे ए गोठ बोराबर कोयो; आंय ताआ सोब ओमे रोत केदिहींन्ने पालो.”<verse eid="EXO 10:29" /></para>
  <chapter eid="EXO 10" />
  <chapter number="11" style="c" sid="EXO 11" />
  <para style="s">दाहावी पिड़ा:</para>
  <para style="s2">पेलठा पोऱ्याआ मोतोअ सेतावणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1" />फाशोअ यहोवा देवे मोशेहे कोयो, “फाशुउ एक वारी जाआं मिसर देसोपोअ आंय एक पिड़ा मोकलोहो, तिहींइं फासाड़ी फारो तुमुहूं मिसर देसोमेहें रोत जाअहूं देये; तेतोज नाहां, पोन तो तुमुहूं खोरीज बारथे काडी देये. <verse eid="EXO 11:1" /><verse number="2" style="v" sid="EXO 11:2" />ओमे आखा इस्राएलोअ माअहुंहूं माआं ए गोठ कोत देखाड़, के तुमू माटीन बोईं तुमाआं आहने रोनारा मिसर देसोअ रेवाशाआ होनोन सांदीइ गोवणो मागित लेजा.” <verse eid="EXO 11:2" /><verse number="3" style="v" sid="EXO 11:3" />ताहां यहोवा देवे मिसर देसोवालाहां इस्राएलोअ माअहूंपोअ मेरवानी कोइ देदो. तेतोज नाहां, पोन मिसर देसोअ फारोअ कर्मसारी आन आखे माअहें मोशेहे आखाम रोत वोडू कोत मानेतेते.<verse eid="EXO 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 11:4" />फाशुउ मोशे फारोहो कोयो, “देव कोहे, ‘आरदी राती आंय मिसर देसोअ विसमेहें रोत सालीहीं. <verse eid="EXO 11:4" /><verse number="5" style="v" sid="EXO 11:5" />आन मिसर देसोमेएं राजगादीपोअ बोहनारा फारोअ सोआ रोत ते दोन्नो दोअनारी वेठाऱ्यीइ सोआ मिलीत पेल्लाअठीज उब्जीइल्ये आखेज मोइत जाय; आन बोकड़ा-वासड़ाआ बासे जें पेल्लाअठीज उब्जे तें आखेज मोइत जाय. <verse eid="EXO 11:5" /><verse number="6" style="v" sid="EXO 11:6" />मिसर देसोम पेल एहेलोहो केदिहीं नाहां ओवो आन ने केदिहीं ओवे एहेलोहो रोड़ीइलोअ आवाज आवे. <verse eid="EXO 11:6" /><verse number="7" style="v" sid="EXO 11:7" />पोन इस्राएली माअहूंपोअ हुंणो जाआं ने पोहे, आन तियांआं बोकड़ान वासड़ाहा बी कीज ने ओवे. इंहीं वाअहीं तुमुहूं जाआंत जाय, के आंय यहोवा देव इस्राएल आन मिसर देसोमेहें फरक कोइत मेकोहो.’ <verse eid="EXO 11:7" /><verse number="8" style="v" sid="EXO 11:8" />ताहां एं ताआ वेठाऱ्ये मिसरवाले माहूं पागे पोड़ीत माआं भक्ती कोए आन कोय, ‘ताआ जों आखो ओय, तों लेत निहींत जा. तिहीं रोत आंय बी निहींत जाहीं.’” एहें कोत कोइत मोशे खोतेमेहें खिजवात फारोहो सोड़ीत निहींत गोयू.<verse eid="EXO 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 11:9" />यहोवा देवे मोशेहे कोयोतो के, “फारो राजा तुमाआ गोठी ने उनाय; काहाके मिसर देसोमेहें आंय जाअखीला समत्कार देखाड़ीत सेको.” <verse eid="EXO 11:9" /><verse number="10" style="v" sid="EXO 11:10" />मोशे आन आरोने ए आखा समत्कार कोइत देखाड़्या; पोन यहोवा देवे फारोअ दिल वातड़ो कोइ देदो, तिहीं वाअहीं तिये इस्राएलवालाहां ने जाअहूं देदे.<verse eid="EXO 11:10" /></para>
  <chapter eid="EXO 11" />
  <chapter number="12" style="c" sid="EXO 12" />
  <para style="s">वल्हांडणोअ तिवार</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1" />फाश्योअ यहोवा मिसर देसोमेहें मोशे आन आरोनोहो कोयो, <verse eid="EXO 12:1" /><verse number="2" style="v" sid="EXO 12:2" />“ओज मोयनु तुमाआ कोअते सालोअ पेहलू मोयनु ठरे. <verse eid="EXO 12:2" /><verse number="3" style="v" sid="EXO 12:3" />इस्राएलोअ पुरी मंडड़ीही ओं कोजा; याज मोयनाआ दाहवा दिहोमेहें तुमू तुमाआं जिव जिवोअ वेगाआ डायहांआं पुरमाणे, कुटूंबाआ डिठ एक मेडाआ बोसो लेत मिकजा; <verse eid="EXO 12:3" /><verse number="4" style="v" sid="EXO 12:4" />आन जर एखा कुटूंबामेहें आखवो मेडो खाअलोअ काजे माअहें कमी पोड़तेय, ताहां तो जाअखा आहने रोनाराअरी माअहुंउं गोणतीइ परमाणे एक गिद्लू लेत मिकजा; आन तुमू हरेक जोओंअ खाअलाअ इसाबोवाअहीं गिद्लाआ इसाब मिकजा. <verse eid="EXO 12:4" /><verse number="5" style="v" sid="EXO 12:5" />तुमाआ गिद्लू निर्दुस आन एका वोरह्योअ नर जोवे. तुमू तियाहा मेडामेएं नेत बोकड़ीमेहें रोत निवड़ीत लेजा.<note caller="+" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="LEV 22:19">लेवी 22:19</ref>; <ref loc="1PE 1:19">1 पेत्र 1:19</ref></char></note> <verse eid="EXO 12:5" /><verse number="6" style="v" sid="EXO 12:6" />आन या मोयनाअ शोवदावे दिहे जाआं तियाहा बांदीत मिकजी, आन तेदिहींज हांजेए वेले इस्राएलोअ आखी टोलाआ माअहें गाराहा आपुहूं जोवे. <verse eid="EXO 12:6" /><verse number="7" style="v" sid="EXO 12:7" />ताहां ते तियाआ रक्ताम रोत थोड़क रक्त लेत कोइत जिया कोअमेहें गिद्लाहा खाये तिया कोओअ बाअणाआ बेनू वोगेहे आन शोवकोटीपोअ लागाड़ी देअहूं जोवे. <verse eid="EXO 12:7" /><verse number="8" style="v" sid="EXO 12:8" />आन तें तियाआ माहां तियीज राती आगीम पुजीत बिगर खमीरवाला रोटाअरी आन कड़वी वस्तुउरी खाअहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="1CO 5:7">1 करिन्थ 5:7</ref></char></note> <verse eid="EXO 12:8" /><verse number="9" style="v" sid="EXO 12:9" />तियाहा मुनको, गुडा, आते नेहें आगीम पुजीत खाजा, निल्लोजे नेताहां पांअयोंम कीज मा रांदीत खाहा. <verse eid="EXO 12:9" /><verse number="10" style="v" sid="EXO 12:10" />आन तिहींमेऱ्योअ वेगीइ जाआं कीज मा उगारहा, आन जर वेगीइ जाआं रोतीज बी जाय, ताहां तियाहा आगीमेहें पेटाड़ी देजा. <verse eid="EXO 12:10" /><verse number="11" style="v" sid="EXO 12:11" />आन वल्हांडण तिवारोहो खाअलोअ नियम एहेलुहू होय: कंबर बांदीत, गुडाम खाहड़े पोवित आन आथम डेंगारेन उतवाल्ये खाअहूं जोवे; ओ तोम यहोवा देवोअ तिवार रोय.”<note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="LEV 23:5">लेवी 23:5</ref>; <ref loc="NUM 9:1-5">गणती 9:1-5</ref>; <ref loc="NUM 28:16">28:16</ref></char></note><verse eid="EXO 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 12:12" />“काहाके तियी राती आंय मिसर देसोअ विसमेहें रोत सोरकिहीं, आन मिसर देसोअ माहुंउं पेल्लोअ पोऱ्यो ओय नेत जनवारोअ पेल्लोअ बोसो ओय, आखाहा माअहीं; आन मिसर देसोअ आखा देवोहों बी डोंड आपिहीं; आंय यहोवा होय. <verse eid="EXO 12:12" /><verse number="13" style="v" sid="EXO 12:13" />आन जियां कोअमेहें तुमू रोहा तियां पोअ तो रक्त तुमाआ काजे निशाणी रोय; मोन्ज्ये तिया रक्ताहा देखीत कोइत आंय तुमुहूं उनकावित जातू रोहीं, आन जाहां आंय मिसरवालाहां माअहीं, ताहां ते आफत तुमापोअ ने पोड़े आन तुमू ने आरवाअहा.<note caller="+" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="LEV 23:5">लेवी 23:5</ref>; <ref loc="NUM 9:1-5">गणती 9:1-5</ref>; <ref loc="NUM 28:16">28:16</ref>; <ref loc="DEU 16:1">कायदा 16:1</ref>,<ref loc="DEU 16:2">2</ref>; <ref loc="NUM 33:4">गणती 33:4</ref>; <ref loc="HEB 11:28">इब्री 11:28</ref></char></note> <verse eid="EXO 12:13" /><verse number="14" style="v" sid="EXO 12:14" />आन या दिहोअ तुमुहूं ओर जोवे के तुमू या दिहोहो यहोवा देवोअ काजे तिवार कोत मानुहूं जोवे. ओ दिही तुमाआ हादाजल्म्युउ तिवार ठरुहूं जोवे.”<verse eid="EXO 12:14" /></para>
  <para style="s">बिगर खमीरवाला रोटाआ तिवार</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 12:15" />फाशोअ देवे कोयो, “हांत दिही जाआं बिगर खमीरवालू रोटू खाया कोअजा; तिया दिहोअ पेल्लेए दिहेज खमीर काडीत टाकजा, तुमामेहें जो कोडो खमीरोअ वस्तु खाय ताहां तियाहा इस्राएल माअहूंमेहें रोते बारथे काडी देअहूं जोवे. <verse eid="EXO 12:15" /><verse number="16" style="v" sid="EXO 12:16" />पेल्लेए दिहे एक पवित्र मेलू आन हांतवे दिहे बी एक पवित्र मेलू हादुहूं जोवे. यां बेनू दिहोंमेहें कीज काम ने कोअहूं जोवे; रांदीइलोअ काम सोड़ीत बिहीरो कोड्लोज काम ने कोअहूं जोवे. <verse eid="EXO 12:16" /><verse number="17" style="v" sid="EXO 12:17" />तियाहा कोत तुमू बिगर खमीरोअ तिवार कोअहूं जोवे, काहाके तिये दिहे आंय तुमुहूं टोलान टोला पाडीत मिसर देसोम रोत बारथे काडीत लेतावयुहू; तियाह काजे ओ दिही तुमाआं आखाअ पिड़ीन पिड़ीइ काजे नियम कोत मानजा.<note caller="+" style="x"><char style="xo" closed="false">12:17 </char><char style="xt" closed="false"><ref loc="LEV 23:6-8">लेवी 23:6-8</ref>; <ref loc="NUM 28:17-25">गणती 28:17-25</ref>; <ref loc="MAT 26:17">मत्तय 26:17</ref></char></note> <verse eid="EXO 12:17" /><verse number="18" style="v" sid="EXO 12:18" />पेहला मोयनाआ शोवदावा दिहोअ हांजेपोअ रोत एकविसवा दिहोअ हांजेपोअ जाआं तुमू बिगर खमीरोअ रोटू खाया कोअजा. <verse eid="EXO 12:18" /><verse number="19" style="v" sid="EXO 12:19" />हांत दिही जाआं तुमाआं कोअमेहें थोड़ुक बी खमीर ने जोवे. जो कोडो बी खमीर वाली वस्तु खाय ताहां तो कोऱ्योअ ओय नेत बाऱ्योअ ओय, तियाहा इस्राएल वाला माअहूं मेहें रोत माइत टाकुहूं जोवे. <verse eid="EXO 12:19" /><verse number="20" style="v" sid="EXO 12:20" />कोडो बी खमीर ने खाअहूं जोवे; तुमू जिहीं बी रोहा तिहीं बिगर खमीरोअ रोटूज खाजा.”<verse eid="EXO 12:20" /></para>
  <para style="s">पेहलू वल्हांडण तिवार</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21" />ताहां मोशे आखा इस्राएलोअ डायाहां हादीत कोइत कोयो, “तुमू तुमाआ कुटूंबाआ डिठ एक एक गिद्लू लेत आवजा; आन वल्हांडण तिवारोअ काजे गाराहा आपजा. <verse eid="EXO 12:21" /><verse number="22" style="v" sid="EXO 12:22" />आन तियाआ रक्त जो वाटकामेहें रोय तो एका आदाआ<note caller="+" style="f"><char style="fr" closed="false">12:22 </char><char style="ft" closed="false">रुंग्हाल खोड़</char></note> डालखा वाअहीं बुस्कड़ीत दरवाजाआ सोवकोटोअ बेनू वोगेहे लागाड़जा; आन हुजे ताअहूं जाआं कोडो बी कोअमेहें रोत बारथे ने निहुंहूं जोवे. <verse eid="EXO 12:22" /><verse number="23" style="v" sid="EXO 12:23" />काहाके यहोवा देव मिसर देसोम रोत पेहला उबजीइल्याहां माईंत सोरकीइतुज जाय; तियाह काजे जिहीं जिहीं तो रक्त सोवकटेपोअ आन बेनू वोगेहे लागाड़ल्यो देखाय, तिहीं तिहीं तियां बाअणाहां उनकावित जातु रोय, आन माअनाराहा तुमाआ कोअमेहें ने जाअहूं देय.<note caller="+" style="x"><char style="xo" closed="false">12:23 </char><char style="xt" closed="false"><ref loc="EZK 9:6">यहे 9:6</ref>; <ref loc="HEB 11:28">इब्री 11:28</ref></char></note> <verse eid="EXO 12:23" /><verse number="24" style="v" sid="EXO 12:24" />तिहीं रोत ए रिती जोलिमक्यीज तुमाआं पिड़ीइ रिती कोत मानजा. <verse eid="EXO 12:24" /><verse number="25" style="v" sid="EXO 12:25" />ताहां यहोवा देवे जेहें कोइत वायदो कोअयोहो तियाआ पुरमाणे तो देस आपे, आन तुमू जाहा तेहेलाम ओ नियम पालन कोअजा. <verse eid="EXO 12:25" /><verse number="26" style="v" sid="EXO 12:26" />जेहेलाम तुमाआं पोऱ्ये तुमुहूं ओं फुसे, के ‘आपू ए रिती काहा मानतेहे?’<note caller="+" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="DEU 32:7">कायदा 32:7</ref>; <ref loc="JOS 4:6">यहो 4:6</ref></char></note> <verse eid="EXO 12:26" /><verse number="27" style="v" sid="EXO 12:27" />ताहां तुमू तियांहां कोजा, ‘यहोवा देवे मिसरवालाहां माईंलोअ होमसे आपा इस्राएलवालाआं कोएं सोड़ीत आपाआ कुटूंबाहा वासाड़्ये, तिहींइं काजे तियाआ वल्हांडण तिवार मानत्ले.’” ताहां इस्राएलवालां पागे पोड़ीत देवोह जारीत लेदो. <verse eid="EXO 12:27" /><verse number="28" style="v" sid="EXO 12:28" />इस्राएलवालां जात कोइत जो आदेश देवे मोशे आन आरोनोहो आप्युतो तेहेंज कोइत कोअयो.<verse eid="EXO 12:28" /></para>
  <para style="s">आखरीइ दाहावी पिड़ा: पेलठाआ मोत</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29" />एहेलोहो ओवो के पोरापोर रातीही मिसर देसोमेएं आखा पेल्लाअठीज उब्जीइनाराहां, यहोवा देवे राजगादीपोअ बोहनारा फारो राजाआ पोऱ्याहा लेत ते जेलेम रोनारा गुलामोअ जाआं आखाआ पेलठा पोऱ्याहां आन पाल्ल्या जनवारोअ पेलठा बासाहा जाआं माईंत टाक्ये.<note caller="+" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="PSA 105:36">भजन 105:36</ref>; <ref loc="PSA 135:8">135:8</ref>; <ref loc="PSA 136:10">136:10</ref></char></note> <verse eid="EXO 12:29" /><verse number="30" style="v" sid="EXO 12:30" />आन फारो रातीज उठीत बोठू, आन तियाआ आखा कर्मसारी आन आखे मिसरवाले उठ्ये, आन मिसर देसोमेहें जुदी जोरे रोड़ीत उठ्ये. आन एक बी एहेलोहो कोअ ने सुटो जियांअहीं कोडोज ने मोयोय. <verse eid="EXO 12:30" /><verse number="31" style="v" sid="EXO 12:31" />ताहां फारो राजा राताम रात मोशे आन आरोनोहो हाद्या, आन कोयो, “तुमू आन तुमाआं इस्राएलवाले निहींत जावा, माआं देस सोड़ीत जाते रोवा; आन जेहेलोहो तुमू कोयो तेहेलोज जात कोइत तुमाआ यहोवा देवोअ भक्ती कोआ. <verse eid="EXO 12:31" /><verse number="32" style="v" sid="EXO 12:32" />आन तुमू कोयोहो तेहेंज कोइत मेडे, डोगरेन बोकड़े नेहें लेत जावा; आन माहूं आशिर्वाद आपतेज जावा.” <verse eid="EXO 12:32" /><verse number="33" style="v" sid="EXO 12:33" />मिसरवाले इस्राएलवालापोअ दाबाव टाकीत कोतेते के, “आमाआं देस सोड़ीत मामार जाते रोवा, नेत आमू आखे मोइत जाहूं.” <verse eid="EXO 12:33" /><verse number="34" style="v" sid="EXO 12:34" />ताहरेए तें बिगर खमीरवालू केलवीइल्यू लोट पारातीइरीज बांदीत तियांआं खांदोपोअ मिकीत लेदू. <verse eid="EXO 12:34" /><verse number="35" style="v" sid="EXO 12:35" />इस्राएलवालां मोशे कोयो तेहेंज कोइत मिसरवालापोअ होना-सांदीइ गोवणो आन आंगड़े मागित लेदे;<note caller="+" style="x"><char style="xo" closed="false">12:35 </char><char style="xt" closed="false"><ref loc="EXO 3:22">निर्ग 3:22</ref></char></note> <verse eid="EXO 12:35" /><verse number="36" style="v" sid="EXO 12:36" />यहोवा देवे मिसरवालाहां इस्राएलवाला पोअ एहेलेहे मेरवानी कोअये के तियां जों जों माग्यो तों आखो तियांहां आपी देदो. एहें कोइत इस्राएलवालां मिसरवालाहां लुटीत लेदे.<note caller="+" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="EXO 3:21-22">निर्ग 3:21-22</ref></char></note><verse eid="EXO 12:36" /></para>
  <para style="s">इस्राएलोअ मिसर देस सोडीइलोअ</para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37" />ताहां इस्राएलवाले रामसेस रोत सुक्कोतोअहें वाट लागे, तें बोईंन-पोऱ्ये सोड़ीत निस्ता पागे सालनारा मेएं माटी एताज सोव लाख एताहा ओता. <verse eid="EXO 12:37" /><verse number="38" style="v" sid="EXO 12:38" />तियांअरी बिगर इस्राएलवाले एक गोवारु माअहें बी आरी गोये, आन मेडे, डोगरेन बोकड़े नेहें आरीज गोये. <verse eid="EXO 12:38" /><verse number="39" style="v" sid="EXO 12:39" />आन जो केलवीइल्यू लोट आरी लेतेज आयेते, तियाआ तियां बिगर खमीरवालू रोटू बोणावयू; काहाके तें मिसरोम रोत निठले तेहेलाम तियांहां एतीही जाआं पारवाआ नाहां जोड़्यी के वाटे खाअलोअ रोटू रांदीत सेके, तिहींज वाअहीं तो लोट बिगर खमीरोअ ओतू.<verse eid="EXO 12:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 12:40" />इस्राएलवाले शार होवेन तीस वोर्ह्ये जाआं मिसर देसोमेहें रोयेते. <note caller="+" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="GEN 15:13">उत्प 15:13</ref>; <ref loc="ACT 7:6">प्रेशित 7:6</ref>; <ref loc="GAL 3:7">गलाती 3:7</ref> </char></note> <verse eid="EXO 12:40" /><verse number="41" style="v" sid="EXO 12:41" />आन तियां शार होव तीस वोर्ह्ये फासाड़ी, तेदिहींज रोत यहोवा देवोअ पुरे माअहें मिसर देसोम रोत बारथे निहींत गोये. <verse eid="EXO 12:41" /><verse number="42" style="v" sid="EXO 12:42" />यहोवा देव इस्राएलवालाहां मिसर देसोम रोत काडीत लेतावयू, तिहींइं वाखरी ते रात मानुहूं जोगीही होय; ए एहेलिही रात होय, जियीही इस्राएलवाले पिड़ीन पिड़ी जाआं मानिइलोअ जुरुड़ी होय.<verse eid="EXO 12:42" /></para>
  <para style="s">वल्हांडणोअ बाप्तिम नियम</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43" />फाशोअ यहोवा देवे मोशे आन आरोनोहो कोयो, “तिवारोअ नियम ओ होय: कोडोज पारको माहुंउं वल्हांडण तिवारोअ रोटू ने खाअहूं जोवे. <verse eid="EXO 12:43" /><verse number="44" style="v" sid="EXO 12:44" />पोन जर वेसातू लेद्लू एखू पावर ओय, आन तियाआ खतना ओवू ओय, ताहां तो तिहींमेहें रोत खात सेकेहे. <verse eid="EXO 12:44" /><verse number="45" style="v" sid="EXO 12:45" />पोन पारके आन मोजऱ्ये माअहें तिहींमेहें रोत ने खात सेकत्ले. <verse eid="EXO 12:45" /><verse number="46" style="v" sid="EXO 12:46" />तिया तिवारोअ रोटू एकाज कोअमेहें खाअहूं जोवे; तिहींमेऱ्योअ कीज बी बारथे ने लेत जाअहूं जोवे; आन गाराहा आपल्या कोड्लाज आड ने मुड़ुहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">12:46 </char><char style="xt" closed="false"><ref loc="NUM 9:19">गणती 9:19</ref>; <ref loc="JHN 19:36">योहान 19:36</ref></char></note> <verse eid="EXO 12:46" /><verse number="47" style="v" sid="EXO 12:47" />आखा इस्राएलवालाआं काजे ओ तिवारोअ पालन कोइलोअ जुरुड़ी होय. <verse eid="EXO 12:47" /><verse number="48" style="v" sid="EXO 12:48" />जर एखू पारको माहुंउं तुमाअरी रोतोय आन तुमाअरी तिवार मानुहूं होदे, ताहां तियाआ खतना कोइलोअ जुरुड़ी होय. ताहां तो इस्राएलवालाआं होस बोणे. ताहां देवोअ काजे तियाहा तिया तिवारोम भाग लेता आवे; पोन जियाअ खतना ने ओवू ओय तियाहा वल्हांडण तिवारोम भाग ने लेता आवे. <verse eid="EXO 12:48" /><verse number="49" style="v" sid="EXO 12:49" />ओ नियम आखाआ काजे एक हारकुज होय, तो पारको ओय नेत इस्राएलवालो ओय.”<note caller="+" style="x"><char style="xo" closed="false">12:49 </char><char style="xt" closed="false"><ref loc="NUM 9:4">गणती 9:4</ref>; <ref loc="NUM 15:15">15:15</ref>; <ref loc="NUM 16:19">16:19</ref>; <ref loc="LEV 26:22">लेवी 26:22</ref> </char></note> <verse eid="EXO 12:49" /><verse number="50" style="v" sid="EXO 12:50" />यहोवा देवे मोशे आन आरोनोहो जो आदेश आप्यू, तो आखा इस्राएलवाला पालन कोअयू. <verse eid="EXO 12:50" /><verse number="51" style="v" sid="EXO 12:51" />एहें कोइत यहोवा देवे आखा इस्राएलवाला माहुंहूं मिसर देसोम बारथे काड्ये.<verse eid="EXO 12:51" /></para>
  <chapter eid="EXO 12" />
  <chapter number="13" style="c" sid="EXO 13" />
  <para style="s">पेहला पोऱ्याआ अर्पण</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1" />फाशोअ यहोवा देवे मोशेहे कोयो, <verse eid="EXO 13:1" /><verse number="2" style="v" sid="EXO 13:2" />“इस्राएलोमेहें जेत्ते जोएं माहुंउं नेते जनवारोअ जें पेल्लाअठीज उबजीइये ओय, तें नर माआं काजे सोके मानुहूं जोवे.”<note caller="+" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="NUM 13:3">गणती 13:3</ref>; <ref loc="LUK 2:23">लुक 2:23</ref></char></note><verse eid="EXO 13:2" /></para>
  <para style="s">बिगर खमीरवाला रोटाअ तिवार</para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3" />फाश्योअ मोशे माअहुंहूं कोयो, “या दिहोहो ओर कोआ, जियामेहें तुमू गुलामोअ कोअमेहें, मोन्जे मिसरोमेहें रोत निहीत आवयेहे; यहोवा तुमुहूं तिहीं रोत तियाआ सेक्ती वाअहीं काडीत लेत आवयुहू; यामेहें खमीरोअ रोटू ने खाअहूं जोवे. <verse eid="EXO 13:3" /><verse number="4" style="v" sid="EXO 13:4" />आबिबोअ मोयनामेहें आज्येए दिहे तुमू निहींयेहे. <verse eid="EXO 13:4" /><verse number="5" style="v" sid="EXO 13:5" />याअकाजे जेहेलाम यहोवा तुमुहूं कनानी, हित्ती, एमोरी, हिव्वी, आन यबूसी माअहोंअ देसोम पोताड़े, जियाहा आपिलोअ काजे तिये तुमाआ वेगाआ डायहांअरी शप्पत खादीते, आन जियामेहें दुद आन मोदोअ तार वोहेहे; ताहां तुमू याज मोयनामेहें तिवार कोअजा. <verse eid="EXO 13:5" /><verse number="6" style="v" sid="EXO 13:6" />हांत दिही जाआं बिगर खमीरोअ रोटू खाया कोअजा, आन सातवे दिहे यहोवा देवोअ काजे तिवार मानजा. <verse eid="EXO 13:6" /><verse number="7" style="v" sid="EXO 13:7" />यां हांतू दिहोम तुमू बिगर खमीरवालू रोटू खाजा. तुमाआ देसोअ हांत दिही जाआं खमीर ने देखाअहूं जोवे. <verse eid="EXO 13:7" /><verse number="8" style="v" sid="EXO 13:8" />आन ‘ये दिहे देवे आमुहूं मिसर देसोम रोत बारथे काडल्ये, तिहीं वाअहीं आमू ओ तिवार मानत्ले’ एहें कोत तुमू तुमाआ पोऱ्याहा कोत देखाड़ुहूं जोवे. <verse eid="EXO 13:8" /><verse number="9" style="v" sid="EXO 13:9" />ओ तिवारोअ दिही मोन्ज्ये तुमाआ काजे एक ओर मिकीइलोअ काजे निशाणी जेहें तुमाआ नजरेए सामने रोअहूं जोवे; जिहीं वाअहीं तुमुहूं देवोअ नियमोअ ओर रोय. काहाके देवे तुमुहूं मिसर देसोम रोत तियाआ आथो वाअहीं बारथे काड्येहे. <verse eid="EXO 13:9" /><verse number="10" style="v" sid="EXO 13:10" />तियाहा काजे तुमू या नियमोहो वोर्ह्योंअ डिठ ठरिवल्या दिहोपोअ मानजा.”<note caller="+" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="NUM 15:39">गणती 15:39</ref>; <ref loc="MAT 23:5">मत्तय 23:5</ref></char></note><verse eid="EXO 13:10" /></para>
  <para style="s">पेलठो उब्जीइल्यो पोर्‍यो</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11" />“फाशोअ जेहेलाम यहोवा तियी शप्पतेए होस, जो तिये तुमाआ वेगाआ डायहां रोत आन तुमाअरी बी खादीही, तुमुहूं कनानोअ देसोम पोताड़ीत कोइत तियाहा तुमुहूं आपी देय. <verse eid="EXO 13:11" /><verse number="12" style="v" sid="EXO 13:12" />ताहां तुमामेहें जेतेहे तुमा तुमाआ याह्हीइ पेल्लाआ पोऱ्या ओय, तियांहां आन तुमाआ जनवारोमेहें रोत जे एहेलेहे ओय, तियांहां बी यहोवा देवोअ काजे गाराहा आपजा; पेहलो उब्जीइल्यो हरेक बाल-बासो यहोवा देवोअ होय. <verse eid="EXO 13:12" /><verse number="13" style="v" sid="EXO 13:13" />आन गोदड़ाआ आखा पेहला बासाआ हाटे एक मेडो आपित तियाहा सोड़वीत लेजा, आन जर तुमू तियाहा सोड़वीइलो ने ओय, ताहां तियाआ गोलू तोड़ी देजा. पोन तुमाआ आखाआ पेल्लाआ पोऱ्याहा हाटे आपित कोइत सोड़वीत लेजा. <verse eid="EXO 13:13" /><verse number="14" style="v" sid="EXO 13:14" />आन आगाड़ी दिहोमेहें जेहेलाम तुमाआ पोर्‍ये तुमुहूं फुसे, ‘ओं की होय?’ ताहां तियांहां कोजा, ‘यहोवा आमुहूं गुलामोअ कोअमेहें रोत, मोन्जे मिसर देसोमेहें रोत तियाआ आथोअ सेक्ती वाअहीं काडीत लेतायुहू. <verse eid="EXO 13:14" /><verse number="15" style="v" sid="EXO 13:15" />तियी वेले जेहेलाम फारो कठीण ओत कोइत आमुहूं जाअहूं देअलोअ ने कोअयो, ताहां यहोवा मिसर देसोमेहें माअहोंअ जागे रोत ते जनवारोअहीं जाआं पेलठाहा माईंत टाक्ये. तियाहा काजे जनवारोमेहें जेतेहे तियां तियांआं याह्हीइ पेलठे उब्जीइल्ये होय, तियांहां आमू यहोवा देवोअ काजे गाराहा आपतेहे; पोन आमाआ आखा पेल्लाआ पोर्‍याहां आमू हाटे आपित कोइत सोड़वीत लेत्ले.’ <verse eid="EXO 13:15" /><verse number="16" style="v" sid="EXO 13:16" />ओं तुमाआ आथोपोर्‍यीइ एक निशाणी आन नेवणाआ विसमेर्‍युउ टिलू जेहें रोअहूं जोवे; काहाके यहोवा आपुहूं मिसर देसोम रोत तियाआ सेक्तीवाअहीं काडीत लेतायुहू.”<verse eid="EXO 13:16" /></para>
  <para style="s">वाद्लाआ खांब आन आगीइ खांब</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17" />जेहेलाम फारो माअहुंहूं जाअलोअ आदेश आपी देदू, पोन पलिश्तीइ माअहुंहूं देसोम ओत कोइत जे वाट जातीते ते हानी ओती; तेबी देव ओ विसार कोइत तियांहां तिये वाटे नाहां लेत गोयु के एहलोहो ने ओवुहूं जोवे के जेहेलाम एं माअहें लोड़ाय पाले ताहां फास्ताइत मिसरोमेहें फिरीत कोइत आवे.<note caller="+" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="NUM 14:1">गणती 14:1</ref></char></note> <verse eid="EXO 13:17" /><verse number="18" style="v" sid="EXO 13:18" />याआ कोअते देव तियांहां सोमकीर फेरवी फेरवीइ लाल दोर्‍याआ जंगलोअ वाटे लेत गोयु. आन इस्राएलवाले मिसर देसोम रोत लड़ायीइ काजे तियार ओत बारथे निहींये.<verse eid="EXO 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 13:19" />आन मोशे योसेफोअ आडोहों आरीज लेतुज गोयु; काहाके योसेफे इस्राएलवालाहां एहें कोत कोइत पाक्की शप्पत लेवाड़्यीते के, “जेहेलाम देव तुमुहूं सोड़वे, तेहेलाम तुमू इंहीं रोत माआं आडे आरीज लेतेज जाजा.”<note caller="+" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="GEN 50:25">उत्प 50:25</ref>; <ref loc="JOS 24:32">यहो 24:32</ref></char></note><verse eid="EXO 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 13:20" />ताहां तियें सुक्कोतोअहीं जागु सोड़ीत कोइत जंगलोअ रानोमेहें एथाम यी जागेहे पोड़ावू टाक्यू. <verse eid="EXO 13:20" /><verse number="21" style="v" sid="EXO 13:21" />आन यहोवा तियांहां दिहोअ वाट देखाड़ीलोअ काजे वाद्लाआ खांबू आन राती उजालो आपीइलोअ काजे आगीइ खांबू ओत कोइत तियांआं आगाड़ी आगाड़ी साल्या कोअतुतो, जिहीं वाअहीं तें राती आन दिहे बेनुमेहें सालीत सेके. <verse eid="EXO 13:21" /><verse number="22" style="v" sid="EXO 13:22" />तिये ते वाद्लाआ खांबाहा दिहे आन ने आगीइ खांबोहो राती माअहुंउं आगाड़ी रोत सेटे कोअयो.<verse eid="EXO 13:22" /></para>
  <chapter eid="EXO 13" />
  <chapter number="14" style="c" sid="EXO 14" />
  <para style="s">लाल दोर्‍या उनकीइलोअ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 14:1" />ताहरोअ यहोवा मोशेहे कोयो: <verse eid="EXO 14:1" /><verse number="2" style="v" sid="EXO 14:2" />“इस्राएलोहो आदेश आपेए, के ते फिरीत कोइत मिग्दोल आन दोर्‍याआ विसमेहें, पिहाहिरोथोअ जागे, बालसफोनोअ सामने तियांआं पोड़ावू कोइलाआ, तियाआज आगाड़ी दोर्‍याआ टेकोपोअ पोड़ावू कोए. <verse eid="EXO 14:2" /><verse number="3" style="v" sid="EXO 14:3" />ताहां फारो इस्राएलोअ बाप्तिमेहें विसार कोए, ‘तें ओजाण्या देसोम जात कोइत पुलवात गोयेहे.’ <verse eid="EXO 14:3" /><verse number="4" style="v" sid="EXO 14:4" />ताहां आंय फारोअ मोन कठीण कोई देहीं, आन तो तियांआं फासाड़ी लागे. ताहां फारो आन तियाआ आखा सेवको वाअहीं माआ महिमा ओवे; आन मिसर देश जांइत लेय के, आंय यहोवा होय.” आन तियां तेहेंज कोअयो.<verse eid="EXO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 14:5" />जेहेलाम मिसरोअ राजाहा ए हाजी बातमी मिल्यी के ते माअहें गुगदे वोल्ये, ताहां फारो आन तियाआ आधिकारोअ मोन तियांआं विरोध मेहें बोदलात गोयो, आन ते कोने वोल्ये “आमुं ओं कि कोअयो के इस्राएलोहो आपाआ गुलामगिरीम रोत सोड़ीत कोइत जाअहूं देदे!” <verse eid="EXO 14:5" /><verse number="6" style="v" sid="EXO 14:6" />ताहां तिये तियाआ कोड़ाआ गाडो<note caller="+" style="f"><char style="fr" closed="false">14:6 </char><char style="fq" closed="false">गाडो </char><char style="ft" closed="false">रथ</char></note> जुपाड़्यो आन तियाआ सेनाहा आरी लेदा. <verse eid="EXO 14:6" /><verse number="7" style="v" sid="EXO 14:7" />तिये सोव होव हाजाम हाजे कोड़ाआ गाडे आन मिसरोअ आखे कोड़ाआ गाडे लेत लेदे आन तियां आखापोअ आधिकारी बोहाड़्या. <verse eid="EXO 14:7" /><verse number="8" style="v" sid="EXO 14:8" />आन यहोवा मिसरोअ राजा फारोअ मोन कठीण कोइ देदो. तियाहा काजे ते इस्राएलोअ फासाड़ी लागा; पोन इस्राएल जिके वाअहीं निहीत जातेते. <verse eid="EXO 14:8" /><verse number="9" style="v" sid="EXO 14:9" />पोन फारोअ आखा कोड़ा आन गाडे, आन तें सालवीइनारा तोइत मिसर सेना तियांआं फासाड़ी लागीत कोइत तियांआं जागी, जे पिहाहिरोथोअ जागे, बालसफोनोअ आगाड़ी, दोर्‍याआ टेको पोअ पोड़ावू टाकीत रोयाते, जात पोत्या.<verse eid="EXO 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 14:10" />जेहेलाम फारो जागे आयू, ताहां इस्राएल नजर उसे कोइत पाल्यो के मिसर आपाआ फासाड़ी आवेहे; आन इस्राएलवाले जाअखीलेहे बित गोये, आन यहोवाहा आअड़्ये; <verse eid="EXO 14:10" /><verse number="11" style="v" sid="EXO 14:11" />आन तें मोशेहे कोने वोल्ये, “तु आमुहूं मिसरोमेहें रोत माइलोअ काजे इंहीं जंगलोमेहें लेतायुहू, केहें तिहीं माहणे ने ओतो के? तु आमुहूं मिसरोमेहें रोत काडीत लेतायुहू, ओं तुमे आमाअरी कि कोअयोहो? <verse eid="EXO 14:11" /><verse number="12" style="v" sid="EXO 14:12" />केहें आमू ताहूं मिसरोमेहें ए गोठ ने कोते रोये के, ‘आमुहूं रोअहूं दे के आमू मिसरोअ सेवा कोअहूं?’ आमाआ काजे जंगलोमेहें मोइलाआ रोत हाजो मिसरोअ सेवा कोइलाआ ठिक ओतो.”<note caller="+" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="EXO 16:3">निर्ग 16:3</ref>; <ref loc="EXO 17:3">17:3</ref></char></note><verse eid="EXO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 14:13" />मोशे माअहुंहूं कोयो, “बिहा मा, उबे उबे तों तारणोअ काम पाला, जों यहोवा आज तुमाआ काजे कोए; काहाके जिया मिसरोहो तुमू आज देखतेहे, तियाहा फाशेए केदिहींज ने देखहा. <verse eid="EXO 14:13" /><verse number="14" style="v" sid="EXO 14:14" />यहोवा सोताहा तुमाआं काजे लड़ाय कोए, तियाहा काजे तुमू ठावके रोवा.”<note caller="+" style="x"><char style="xo" closed="false">14:14 </char><char style="xt" closed="false"><ref loc="DEU 20:4">कायदा 20:4</ref>; <ref loc="JOS 10:14">यहो 10:14</ref>; <ref loc="ISA 30:15">यश 30:15</ref></char></note><verse eid="EXO 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 14:15" />ताहां यहोवा मोशेहे कोयो, “तू माहूं रावणी काहा कोअहे? इंहीं रोत इस्राएलोहो आगाड़ी जाय तेहें काजे को. <verse eid="EXO 14:15" /><verse number="16" style="v" sid="EXO 14:16" />आन तु ताआ डेंगार विसीत कोइत ताआ आथ दोर्‍यापोअ उसू कोअ, आन तो बेन भाग ओत जाय; ताहां इस्राएल दोर्‍याआ विसमेहें ओत कोइत सालीत जाय. <verse eid="EXO 14:16" /><verse number="17" style="v" sid="EXO 14:17" />आन उनाआ, आंय सोताहा मिसरोअ मोनोहो कोठीण कोअहो, आन ते तिहीं बी तियांआं फासाड़ी लागे. ताहां फारो आन तियाआ आखा सेवक, कोड़ाआ गाडो आन कोड़ापोर्‍याआ मोइत जाय ताहां माआ महिमा ओवे. <verse eid="EXO 14:17" /><verse number="18" style="v" sid="EXO 14:18" />आन जेहेलाम फारो आन तियाआ कोड़ाआ गाडे, आन कोड़ाआ गुगदाड़नारा हारवाइलो वाअहीं माआ महिमा ओवे. ताहां मिसर जाईंत लेय, के आंय यहोवा होय.”<verse eid="EXO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19" />ताहां देवोअ देवदूत जो इस्राएलोअ सेनाआ आगाड़ी आगाड़ी साल्या कोअतुतो, तो जात कोइत तियांआं आगाड़ी ओत गोयु; आन वाद्लाआ खांब तियांआं आगाड़ी रोत टोलीत कोइत तियांआं फासाड़ी आवीत उबू रोयू. <verse eid="EXO 14:19" /><verse number="20" style="v" sid="EXO 14:20" />एहेंकोइत तो मिसरोअ सेनाआ आन इस्राएल माअहोंअ सेनाआ विसमेहें आवीत लागू. तों वाद्लो मिसरी सेनापोअ आंदारो कोअयो आन इस्राएल माअहोंहों उजालो आप्यो तियाहा कोत ते रात पोइत एकमेकाआ जागे आवीत ने सेके.<verse eid="EXO 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 14:21" />ताहां मोशे तियाआ आथ दोर्‍याअ उपोअ कोअयू; आन यहोवा रात पोइत जुदो वारो सोड़्यो, आन दोर्‍याआ विसमेहें बेन भाग कोइत पाईं एहलोहो वेरी देदो, जेहेलोहो तियाआ विसमेहें उगाअली धरती ओत गोयी.<note caller="+" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="PSA 106:9">भजन 106:9</ref>; <ref loc="PSA 114:3">114:3</ref></char></note> <verse eid="EXO 14:21" /><verse number="22" style="v" sid="EXO 14:22" />ताहां इस्राएल दोर्‍याआ विसमेहें कोअड़ा जागाम साल्ये, आन पाईं तियांआं हाजाड़्यी आन बांगाड़्यीइ वोल भिंताआ होस उबो ओतो. <verse eid="EXO 14:22" /><verse number="23" style="v" sid="EXO 14:23" />तेहेलाम मिसरवाला ओड़ीत लागा, मोन्ज्ये फारोअ आखा कोड़ा, कोड़ाआ गाडे आन गोदड़ापोर्‍याआ सवार नेहें दोर्‍याआ विसमेहें ओत तियांआं फासोअ गोया. <verse eid="EXO 14:23" /><verse number="24" style="v" sid="EXO 14:24" />आन वेगर्‍याआ सिंजीवड़ाअरीही यहोवा वाद्ला आन आगीइ खांबामेहें रोत मिसरोअ सेनापोअ नजर टाकीत कोइत तियांहां काबरावये. <verse eid="EXO 14:24" /><verse number="25" style="v" sid="EXO 14:25" />आन तिये तियांआं कोड़ाआ गाडाआ साके काडीत टाक्ये, जिया वाअहीं तियांआं सालाड़ीलोअ कठीण ओत गोयो. ताहां मिसरवाला तियां तियांआं कोना वोल्या, “साला, आपू इंहीं रोत नाहींत जाता; काहाके यहोवा इस्राएलोअ वोगेहे रोत मिसरवालाआं विरुद्दामेहें लोड़ाय कोअहे!”<verse eid="EXO 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 14:26" />फाश्योअ यहोवा मोशेहे कोयो, “ताआ आथ दोर्‍या पोअ नांबू कोएए, ताहां तों पाईं मिसर वाला आन तियांआं गाडो, आन कोड़ापोर्‍याआ बोहनाराहां बुडाड़ीत लेय.” <verse eid="EXO 14:26" /><verse number="27" style="v" sid="EXO 14:27" />ताहां मोशे तियाआ आथ दोर्‍याअ वोल नांबू कोअयू, आन दिही उगता-उगता दोर्‍या जेहेलुन तेहेलुज ओत गोयू; आन मिसर वाला उलटा गुगदीइलोअ कोशित कोअयी, पोन यहोवा तियांहां दोर्‍यामेहें बुडाड़ीत देदा. <verse eid="EXO 14:27" /><verse number="28" style="v" sid="EXO 14:28" />आन पाईं ओतो तेहेलोज ओत गोयो, ताहां जेतेहे रथ आन कोड़ा पोर्‍याअ सवार इस्राएलोअ फाटी दोर्‍या मेहें आयाते, आन आखा फारोअ सेयनिक नेहें तियामेहें बुडीत गोया, आन तियांमेहें रोत एक बी ने वासाअयो. <verse eid="EXO 14:28" /><verse number="29" style="v" sid="EXO 14:29" />पोन इस्राएल वाले दोर्‍याआ पोरापोर कोअड़ी वाटे पोअ सालीत कोइत एकी मेरे जाते रोये, आन तों पाईं तियांआं हाजाड़ी आन बांगाड़ी बेनू वोल भिंताआ होस ओत गोयो.<verse eid="EXO 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 14:30" />ताहां एहें कोइत यहोवा तिये दिहे इस्राएलोहो मिसर वालाआं आथोम रोत सोड़व्ये; आन इस्राएलवालां मिसर वालाहां दोर्‍याआ मेरे मोइत रोल्ये देख्ये. <verse eid="EXO 14:30" /><verse number="31" style="v" sid="EXO 14:31" />जेहेलाम इस्राएलवालां यहोवा देवोअ मिसरोपोअ वोडे सेक्तीवाले कामे पालित कोइत बिये आन यहोवा पोअ आन तियाआ सेवक मोशे पोअ बी विश्वास कोअयू.<verse eid="EXO 14:31" /></para>
  <chapter eid="EXO 14" />
  <chapter number="15" style="c" sid="EXO 15" />
  <para style="s">मोशेए गित</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1" />ताहां मोशे आन इस्राएलवाले यहोवाआ काजे ओं गित गावये.</para>
  <para style="b" vid="EXO 15:1" />
  <para style="q1" vid="EXO 15:1">“आंय यहोवाआ गित गाविहीं, काहाके तिये वोडे कामे कोअयेहे;</para>
  <para style="q2" vid="EXO 15:1">कोड़ाअरी तियांआं सालाड़नाराहां बी तिये दोर्‍यामेहें टाकी देदा.<note caller="+" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="REV 15:3">प्रगटी 15:3</ref></char></note><verse eid="EXO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="EXO 15:2" />यहोवा माआ मजबुत राखवाली होय,</para>
  <para style="q2" vid="EXO 15:2">आन तियेज माआं तारण कोअयोहो.</para>
  <para style="q1" vid="EXO 15:2">आन तो माआं देव होय, आन आंय तियाआ स्तुती कोअहीं, तो माआ डायाआ देव होय;</para>
  <para style="q2" vid="EXO 15:2">आंय तियाआ वोडी गोठीइ बाप्तिम गिते गाविहीं.<note caller="+" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="ISA 12:2">यश 12:2</ref>; <ref loc="PSA 118:14">भजन 118:14</ref></char></note><verse eid="EXO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EXO 15:3" />यहोवा आखाम रोत वोडू होय;</para>
  <para style="q2" vid="EXO 15:3">तियाआ नाव प्रभु होय.<verse eid="EXO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="EXO 15:4" />तिये फारोअ कोड़ाआ गाडे आन सेयनिकोहों दोऱ्याम टाकी देदा;</para>
  <para style="q2" vid="EXO 15:4">आन तिये फारोअ हाजाम हाजा आधिकाऱ्योहों लाल दोर्‍याम बुडाड़ी देदा.<verse eid="EXO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EXO 15:5" />उंडे पाअयें तियांहां बुडाड़ीत लेदा;</para>
  <para style="q2" vid="EXO 15:5">ते डोणोअ होस उंडा पाअयोंम बुडीत गोया.<verse eid="EXO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="EXO 15:6" />यहोवा देवा, ताआ हाजाड़्यू आथ जुदू सेक्तीवालू होय;</para>
  <para style="q2" vid="EXO 15:6">तिया आथो वाअहीं तू दुस्मोनोहों सुउवीत टाकत्लू.<verse eid="EXO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EXO 15:7" />ताआ विरुद्दाम उठनाराहां तू ताआ वोडी ताकते वाअहीं पाड़ीत टाकेहे;</para>
  <para style="q2" vid="EXO 15:7">तु ताआ खोत काडेहे आन ते पुहूटाआ होस पेटाइत जातेहे.<verse eid="EXO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EXO 15:8" />तुमे जोरमेहें सालाड़ल्या वारा वाअहीं पाईं टिगोअ होस उबो रोत गोयो,</para>
  <para style="q2" vid="EXO 15:8">जोरे सालनारा सेलकाआ पाअयोंअ वातड़ा पितड़ाआ होस उबो रोत गोयो;</para>
  <para style="q2" vid="EXO 15:8">दोऱ्याआ विसमेहें उंडामेहें पाईं जाअखोज गाडात गोयो.<verse eid="EXO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EXO 15:9" />दुस्मोने कोयो तो, ‘आंय याआं फाट लागिहीं, आंय जात कोइत तोइत लेहीं;</para>
  <para style="q2" vid="EXO 15:9">आंय लुटीत कोइत माल वाटीत लेहीं, तिया वाअहीं माआ जिव ताराइत जाय.</para>
  <para style="q2" vid="EXO 15:9">माआ आथोवाअहीं तारवाआ उमात कोइत तियांहां आंय माईंत टाकीहीं.’<verse eid="EXO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EXO 15:10" />पोन तुमे ताआ हावा सोड़्यी, ताहां दोऱ्याआ पाअयें तियांहां डुबाड़ीत लेदा;</para>
  <para style="q2" vid="EXO 15:10">ते लोड़ाआ होस दोऱ्याआ उंडा पाअयोंम बुडीत गोया.<verse eid="EXO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="EXO 15:11" />यहोवा देवा, ताआ होसऱ्युउ देवतामेहें कोडू होय?</para>
  <para style="q2" vid="EXO 15:11">ताआ सारकू बिहीरु कोडू होय कायनाहां, तू सोकायीइ वाखरी जुदू ताकतवालू होय,</para>
  <para style="q2" vid="EXO 15:11">ताआ कामे सोमत्कारोवाले होय, आन तु जुदे वोडे कामे कोअत्लू!<verse eid="EXO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EXO 15:12" />तुमे ताआ हाजाड़्यू आथ उमाड़्यू</para>
  <para style="q2" vid="EXO 15:12">आन धरती तियां दुस्मनोहों गिईंत लेदाहा.<verse eid="EXO 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EXO 15:13" />तुमे सोड़वीइल्या माअहुंहूं तु ताआ दया वाअहीं सालाड़्ये;</para>
  <para style="q2" vid="EXO 15:13">ताआ सेक्ती वाअहीं तु तियांहां ताआ सोकी जागेहे लेत जाहे.<verse eid="EXO 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EXO 15:14" />पारका देसोवाले ए गोठ उनाइत कोइत बिके वाअहीं काबरात जाय;</para>
  <para style="q2" vid="EXO 15:14">पलिश्तीवाले माअहें धाके वाअहीं कापे वोले.<verse eid="EXO 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EXO 15:15" />एदोमोअ प्रधान बित जाय;</para>
  <para style="q2" vid="EXO 15:15">मोवाबोअ पेडा माटी थुर थुर कापे वोले;</para>
  <para style="q2" vid="EXO 15:15">आन आखे कनान वाले माअहें जिव पाड़ीत लेय.<verse eid="EXO 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="EXO 15:16" />तियांमेहें बिक आन कापारु फोहीत जाय;</para>
  <para style="q2" vid="EXO 15:16">आन ताआ ताकत देखीत कोइत, ए यहोवा, ताआ माअहें जें तुमे ताऱ्येहे,</para>
  <para style="q2" vid="EXO 15:16">तें निहींत जाय ताअहूं जाआं तें डोणोअ होस ठावकेज उबे रोत जाय.<verse eid="EXO 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EXO 15:17" />तु तियांहां पोताड़ीत कोइत ताआ डोगोअ खास जागामेहें मिकिही;</para>
  <para style="q2" vid="EXO 15:17">ओ तो जागु होय, ए यहोवा जियाहा तु ताआ रोअलाआ काजे बोणायुहू,</para>
  <para style="q2" vid="EXO 15:17">आन तो सोकु जागु होय जियाहा ए प्रभु तुमे सोताहा तियार कोअयुहू.<verse eid="EXO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EXO 15:18" />यहोवा ताआ राज हादाजोलम रोय.”<verse eid="EXO 15:18" /></para>
  <para style="s">मिरयामोअ गित</para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19" />मिसरवालाआ कोड़ाआ गाडे, मोन्ज्ये फारोअ, कोड़ा आन तियांआं सालाड़नारा दोऱ्याम जाता रोया, यहोवा देवे तियांहां दोऱ्याअ पाअयोंम बुडाड़ी देदा; पोन इस्राएलवाले दोऱ्याम कोअड़ी जागे सालीत मेरे निहींत गोये.<note caller="+" style="x"><char style="xo" closed="false">15:19 </char><char style="xt" closed="false"><ref loc="1SA 18:6">1 शमु 18:6</ref></char></note><verse eid="EXO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 15:20" />तेहेलाम आरोनोअ बोअह्हीं मिरयाम नावोअ भविश्यवक्ती ओती, ते तियीइरी बाकी बोईं नेहें आथोम डोफणो वाजाड़तीन नास्तीज तियाआ फासाड़ी आयी. <verse eid="EXO 15:20" /><verse number="21" style="v" sid="EXO 15:21" />मिरयाम ओं गित गावतीते:</para>
  <para style="q1" vid="EXO 15:21">“यहोवा देवोअ गित गावा, काहाके तिये जुदे वोडे कामे कोअयेहे.</para>
  <para style="q2" vid="EXO 15:21">तिये कोड़ाअरीज कोड़ाआ गाड़ीवालाहां बी दोऱ्याम टाकी देदा.”<verse eid="EXO 15:21" /></para>
  <para style="s">कोड़वो पाईं</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22" />तिहीं रोत मोशे इस्राएल माअहुंहूं लाल दोर्‍याअ रोत आगाड़ी लेत गोयू. ते माअहें शूर नावोअ रानम आये. तें तिन दिही जाआं रानम रोत सालित गोये; पोन तियांहां पाईं ने जोड़्यो. <verse eid="EXO 15:22" /><verse number="23" style="v" sid="EXO 15:23" />तिहींइं फासाड़ी तें मारा नावोअ एकी जागेहे पोते, तिहीं पाईं कड़वो ओतो तिहीं वाअहीं तें पीत ने सेके, तिहींज वाअहीं तिया जागाअ नाव मारा<note caller="+" style="f"><char style="fr" closed="false">15:23 </char><char style="fq" closed="false">मारा </char><char style="ft" closed="false">या नावोअ अर्थ इब्री बाशाम कोड़वो एहें कोवाअत्लो.</char></note> पोड्यो. <verse eid="EXO 15:23" /><verse number="24" style="v" sid="EXO 15:24" />माअहें मोशेए जागे टुटणीइतेज आयेन कोयो, “आमू इंहीं की पिवें?” <verse eid="EXO 15:24" /><verse number="25" style="v" sid="EXO 15:25" />ताहां मोशे यहोवा देवोहो रावणी कोअयी, तेहेलाम देवे तियाहा एक साड़ देखाड़्यो. मोशे तिया साड़ोअ डिन्गो पांअयोंम टाक्यू, ताहां तो पाईं मिठो ओत गोयो.</para>
  <para style="p" vid="EXO 15:25">तिया गालाहा देवे तियांहां जिवीइलोअ नियम बोणावीत आप्या. तिहींज तिये तियांआं विश्वासोअ परिक्शा बी पाल्यी. <verse eid="EXO 15:25" /><verse number="26" style="v" sid="EXO 15:26" />तिये कोयो, “जर तु ताआ देवोअ वसन पुरा मोनोवाअहीं मानित सालही, जो तियाआ नजरेम हाजो होय तो कोअही, तियाआ आदेशोपोअ कान देही; आन तियाआ आखी गोठी मानही, ताहां जेती बिमारी आंय मिसर देसोपोअ मोकल्यीही, तिहींमेएं एक बी तापोअ ने मोकलो; काहाके आंय ताहूं नेराय आपनारु देव होय.”<verse eid="EXO 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 15:27" />ताहरेए इस्राएल माअहें सालित कोइत एलीम नावोअ जागेहे आये, तिहीं पाअयोंअ बारा उकला आन खारक्याआ सत्तर साड़े ओते; तिहीं तियां पाअयोंअ जागेहे पोड़ावू टाक्यू.<verse eid="EXO 15:27" /></para>
  <chapter eid="EXO 15" />
  <chapter number="16" style="c" sid="EXO 16" />
  <para style="s">मान्ना आन लावे</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1" />फाशोअ एलीम इंहीं रोत इस्राएलोअ आखी मंडड़ी, मिसर देसोम रोत निहींये ताहां बिहीरा मोयनाआ पोनरवे दिहे, एलीम आन सिनाय डोगोअ विसमेहें सिन नावोअ जंगलोमेहें आवीत पोती. <verse eid="EXO 16:1" /><verse number="2" style="v" sid="EXO 16:2" />जंगलोमेहें इस्राएलोअ आखी मंडड़ी मोशे आन आरोनोअ विरुद्दामेहें टुटणे वोल्ये. <verse eid="EXO 16:2" /><verse number="3" style="v" sid="EXO 16:3" />आन इस्राएलवाले तियांहां कोने वोल्ये, “जेहेलाम आमू मिसर देसोमेहें माहोंअ आंडीइ जागे बोहीत कोइत ताराईत रोटू खाताते, ताहां जर आमू यहोवाआ आथो वाअहीं माइत टाकाअते बी तेबी तों हाजो ओतो; पोन तुमू आमुहूं या जंगलोमेहें या आखा समाजोहो फुके माइलोअ काजे काडीत लेत आवयाहा.”<note caller="+" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="NUM 11:4">गणती 11:4</ref>; <ref loc="EXO 14:12">निर्ग 14:12</ref></char></note><verse eid="EXO 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 16:4" />ताहां यहोवा मोशेहे कोयो, “पाला, आंय तुमाआ काजे जुगोम रोत खाअलोअ वस्तु टाकीहीं; आन एं माअहें दाड़ीइज बारथे जात कोइत दाड़ीइज रोटा टोलू कोए, तिया वाअहीं आंय तियांआं परिक्शा कोअहीं के तें माआ नियमो पोअ सालतेहे के नाहां.<note caller="+" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="PSA 78:24">भजन 78:24</ref>; <ref loc="PSA 105:40">105:40</ref>; <ref loc="DEU 8:2">कायदा 8:2</ref></char></note> <verse eid="EXO 16:4" /><verse number="5" style="v" sid="EXO 16:5" />आन एहलोहो ओवे के साहावा दिही तो खाणो बिहीरा दिहो रोत बेन भाग जाअखो रोये, याअकाजे जों किबी तें तिया दिही टोलू वालहा, तियाहा तियार कोइत मिका.”<verse eid="EXO 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 16:6" />तिहीं वाअहीं मोशे आन आरोने आखा इस्राएलोहो कोयो, “हांस्तीइ वेले तुमू जाईंत लेहा, के जो तुमुहूं मिसर देसोम रोत काडीत लेतायुहू तो यहोवा होय, <verse eid="EXO 16:6" /><verse number="7" style="v" sid="EXO 16:7" />हांदाआ वेगीइ तुमुहूं यहोवाआ उजालो देखाय; काहाके तुमू जिया देवोअ विरुद्दाम टुटणीइतेहे तिये उनाइत लेदोहो, आन आमू कि होय, के तुमू आमापोअ टुटण्या कोअताहा.” <verse eid="EXO 16:7" /><verse number="8" style="v" sid="EXO 16:8" />जेहेलाम मोशे कोयो, “ओं तेहेलाम ओवे जेहेलाम यहोवा हांस्तीइ वेले तुमुहूं खाअला काजे माहां आन वेगीइ रोटू आपे; काहाके तुमू जे तियापोअ टुटणीइतेहे तियाहा तो उनाअहे. आन आमू कि होय? तुमाआ टुटणीइलोअ आमाअरी नाहां पोन यहोवाअरी होये.”<note caller="+" style="x"><char style="xo" closed="false">16:8 </char><char style="xt" closed="false"><ref loc="LUK 10:16">लुक 10:16</ref></char></note><verse eid="EXO 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 16:9" />फाशोअ मोशे आरोनोहो कोयो, “इस्राएलोहो आखी मंडड़ीही हुकुम आपे के यहोवाअ आगाड़ी तियाआ हुंबर आवे, काहाके तियांआं टुटणे कोइला उनाअयुहू.” <verse eid="EXO 16:9" /><verse number="10" style="v" sid="EXO 16:10" />आन एहलोहो ओवो के जेहेलाम आरोन इस्राएलोअ आखी मंडड़ीअरी एहेलीज गोठी कोअया कोअतुतो के उसकाहीज तियां जंगलोअ वोल नजर टाकीत कोइत पाल्यो, आन तियांहां यहोवाआ उजालो वाद्लामेहें देखाओ वोल्यो. <verse eid="EXO 16:10" /><verse number="11" style="v" sid="EXO 16:11" />ताहां यहोवा मोशेहे कोयो, <verse eid="EXO 16:11" /><verse number="12" style="v" sid="EXO 16:12" />आंय “इस्राएलवालाआ टुटणीइलोअ उनाअयुहू. तियांहां को, दाड़ीइज हांजेपोअ तुमू माहां खाहा आन वेगीइ तुमू जोवे तेतु रोटू खाहा, ताहां तुमुहूं मुंदू जाय के आंय तुमाआं देव यहोवा होय.”<verse eid="EXO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 16:13" />तेदिहीं हांजे पोअ लावे सिड़े आखू पोड़ावू पोइत बोहीत गोये, वेगीइ वेले पोड़ावाआ मेरे जागेज साकलो पोड्यो.<note caller="+" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="NUM 11:31">गणती 11:31</ref></char></note> <verse eid="EXO 16:13" /><verse number="14" style="v" sid="EXO 16:14" />जेहेलाम साकलो उगात गोयो ताहां पुयीं पोअ वाहीं एवडेहे खोरपण्ये जेहें पोड़ीत रोल्ये देख्ये. <verse eid="EXO 16:14" /><verse number="15" style="v" sid="EXO 16:15" />जाहां तों देखीत इस्राएलवाले माअहें एकान एकाहा फुसे वोल्ये, “ओं की होय?” काहाके तियांहां ओं की होय तो ने मुंदू ओतू.</para>
  <para style="p" vid="EXO 16:15">मोशे तियांहां कोयो, “देव ओं ओन तुमुहूं खाय तेहें काजे तुमुहूं आप्योहो.<note caller="+" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="1CO 10:3">1 करिन्थ 10:3</ref></char></note> <verse eid="EXO 16:15" /><verse number="16" style="v" sid="EXO 16:16" />जो आदेश यहोवा आप्युहू तो ओ होय: तुमू तियाम रोत तुमाआ गरज ओय तेतोज खाअलाअ लेजा. मोन्जे तुमु तुमाआ माअहुंउं गणतीइ इसाबो वाअहीं एका एक जोंअ फासाड़ी आँठ वाटकी मोन्जे एक ओमेर<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="fq" closed="false">ओमेर </char><char style="ft" closed="false">मोन्ज्ये एक किलो</char></note> टोलू कोअजा; जियाआ पोड़ावामेहें जेतेहे ओय ते तियांआंज काजे टोलू वाल्या कोए.”<verse eid="EXO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 16:17" />आन इस्राएलवाला तेहेंज कोअयो; आन कोडे जाअखो कोडे थोड़ोज टोलू वाल्यो. <verse eid="EXO 16:17" /><verse number="18" style="v" sid="EXO 16:18" />जेहेलाम तियां ओमेरो वाअहीं माप्यो, ताहां जियापोअ जाअखो ओतो तियाआ जाअखो ने ओवो, आन जियापोअ थोड़ो ओतो तियाहा कमी ने ओवो;<note caller="+" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="2CO 8:15">2 करिन्थ 8:15</ref></char></note> काहाके एकेक माहुंउं तियांआं खाणो मापोवाअहीं लेदोतो. <verse eid="EXO 16:18" /><verse number="19" style="v" sid="EXO 16:19" />फाशोअ मोशे तियांहां कोयो, “कोडोज यामेहें रोत उगारीत वेगीइ जाआं मा मिकहा.” <verse eid="EXO 16:19" /><verse number="20" style="v" sid="EXO 16:20" />तेबी तियां मोशेए गोठ ने मान्यी; याअकाजे जेहेलाम थोड़ेक माअहें तियाम रोत थोड़क वेगीइ जांआं मिकीत रोये, ताहां तिया मेहें किड़ा पोड़ीत गोया आन तो गोंदाओ वोल्यो; ताहां मोशेहे तियांपोअ खोत लागी. <verse eid="EXO 16:20" /><verse number="21" style="v" sid="EXO 16:21" />ते वेगीइ जाआं दाड़ीइज तियांहां जोवे तेतोहो टोलू वालीत लेतेते, आन जेहेलाम जाअखो तोपतोतो तेहेलाम, तो ओगलीत जातो तो.<verse eid="EXO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 16:22" />फाशोअ एहलोहो ओवो के साहावा दिही तियां बेन भाग, मोन्जे एका माअहों फासाड़ी बेन बेन ओमेर वाटीत लेदो, आन मंडड़ीइ आखा पुडारी आवीत कोइत मोशेहे कोत देदे. <verse eid="EXO 16:22" /><verse number="23" style="v" sid="EXO 16:23" />मोशे तियांहां कोयो, “यहोवा एहें कोहे के, हांदाआ आरामोअ दिही मोन्जे यहोवाआ काजे सोकू दिही आरामोअ रोय, याअकाजे तुमुहूं जो रांदीइलोअ ओय तियाहा रांदा, आन जों सुड़वीइलोअ ओय तों सुड़वा, आन यामेहें रोत जों वासाय तियाहा वेगीइ जाआं मिकीत रोवा.”<note caller="+" style="x"><char style="xo" closed="false">16:23 </char><char style="xt" closed="false"><ref loc="EXO 20:8">निर्ग 20:8</ref></char></note> <verse eid="EXO 16:23" /><verse number="24" style="v" sid="EXO 16:24" />जेहेलोहो तियां मोशेए या आदेशोअ पुरमाणे वेगीइ जाआं मिकीत रोये, ताहां तो ने खाराब ओवो, आन तियामेहें किड़ा ने पोड़्या. <verse eid="EXO 16:24" /><verse number="25" style="v" sid="EXO 16:25" />ताहां मोशे तियांहां कोयो, “आज ओंज खावा, काहाके आज यहोवाआ आरामोअ दिही होय; याअकाजे आज तुमुहूं तो सापड़ा मेहें ने जोड़े. <verse eid="EXO 16:25" /><verse number="26" style="v" sid="EXO 16:26" />सोव दिही ते तुमू टोलू वालहा; पोन सांतवू दिही आरामोअ दिही होय, तियामेहें तो ने जोड़े.”<verse eid="EXO 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 16:27" />तेबी थोड़ेक माअहें हांतवा दिही बी टोलू वालीइलोअ काजे बाअथे गोया, पोन तियांहां किज ने मिल्यो, <verse eid="EXO 16:27" /><verse number="28" style="v" sid="EXO 16:28" />ताहां यहोवा मोशेहे कोयो, “तुमू केदिहीं जाआं माआ नियमोहों ने माननारे? <verse eid="EXO 16:28" /><verse number="29" style="v" sid="EXO 16:29" />पाला, यहोवा जो तुमुहूं आरामोअ दिही आप्युहू, याअकाजे तो तुमुहूं साहावा दिहोअ दिही बेन दिहोअ रोटू तुमुहूं आपेहे; याअकाजे तुमू आपा जिव जिवोअ कोअ बोहीत रोजा, हांतवा दिहोहो कोडो जागापोअ रोत बाअथे मा जाहा.” <verse eid="EXO 16:29" /><verse number="30" style="v" sid="EXO 16:30" />तियाहा काजे माअहें हांतवा दिही आराम कोअयू.<verse eid="EXO 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31" />इस्राएल वाले माअहें तिया वस्तुउ नाव मान्ना मेक्यो; धान्याआ आकारोअ होस आसलो बिजो ओतो, आन तियाआ होवाद मोदोअ बोणल्या सातड़ाआ होस ओतू.<note caller="+" style="x"><char style="xo" closed="false">16:31 </char><char style="xt" closed="false"><ref loc="NUM 11:7">गणती 11:7</ref></char></note> <verse eid="EXO 16:31" /><verse number="32" style="v" sid="EXO 16:32" />फाशोअ मोशे कोयो, “यहोवा जो आदेश आप्यू तो ओ होय के याम रोत ओमेर पोइत ‘मान्ना’ आपाआ पिड़ी पिड़ीइ काजे मिकीत रोजा, जिया वाअहीं ते जाएं के यहोवा आमुहूं मिसर देसोम रोत काडीत कोइत जंगलोमेहें केहेलुहू रोटू खावाड़तुतो.” <verse eid="EXO 16:32" /><verse number="33" style="v" sid="EXO 16:33" />ताहां मोशे आरोनोहो कोयो, “एक बासोन लेत कोइत तियाम मान्ना पोइत लेत कोइत तियाहा यहोवा देवोअ आगाड़ी मेकी दे कि तो तुमाआं पिड़ीइ काजे मिकीत रोय.”<note caller="+" style="x"><char style="xo" closed="false">16:33 </char><char style="xt" closed="false"><ref loc="HEB 9:4">इब्री 9:4</ref></char></note> <verse eid="EXO 16:33" /><verse number="34" style="v" sid="EXO 16:34" />जेहेंकोइत यहोवा मोशेहे आदेश आप्युतो, तियाआ अनुसार आरोने तियाहा साक्शीइ पेटीइ आगाड़ी तोअयो के तो तिहीं मिकीत रोय. <verse eid="EXO 16:34" /><verse number="35" style="v" sid="EXO 16:35" />इस्राएल जाअहूं जाआं वोहती कनान देसोम ने पोत्ये ताअहूं जाआं, मोन्जे सालही वोरह्ये जाआं मान्ना खाते रोये; ते जाअहूं जांआं कनान देसोम हाद्दीम ने पोत्ये ताअहूं जाआं मान्ना खाते रोये.<note caller="+" style="x"><char style="xo" closed="false">16:35 </char><char style="xt" closed="false"><ref loc="JOS 5:12">यहो 5:12</ref></char></note> <verse eid="EXO 16:35" /><verse number="36" style="v" sid="EXO 16:36" />एक ओमेर ते एफाआ<note caller="+" style="f"><char style="fr" closed="false">16:36 </char><char style="fq" closed="false">एफाआ </char><char style="ft" closed="false">एक ओमेर ताहां एफाआ लगभग दाहवू भाग होय.</char></note> दाहवू भाग होय.<verse eid="EXO 16:36" /></para>
  <chapter eid="EXO 16" />
  <chapter number="17" style="c" sid="EXO 17" />
  <para style="s">खड़काम रोत पाईं</para>
  <para style="r">(<ref loc="NUM 20:1-13">गणती 20:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1" />फाशोअ इस्राएलोअ आखी मंडड़ी सिन नावोअ जंगलोम रोत निहींयी, आन यहोवाअ आदेशोअ अनुसार पोड़ावू कोअते रफीदीम इंहीं तियांआं पोड़ावू कोअयू; आन तिहीं तियां माअहुंहूं पिअहूं पाईं ने जोड़्यो.<note caller="+" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="NUM 14:12">गणती 14:12</ref>,<ref loc="NUM 14:14">14</ref></char></note> <verse eid="EXO 17:1" /><verse number="2" style="v" sid="EXO 17:2" />याअकाजे ते मोशेएरी सुलाअतेज कोने वोल्ये, “आमुहूं पिअहूं पाईं आपे.”</para>
  <para style="p" vid="EXO 17:2">मोशे तियांहां कोयो, “तुमू माअरी काहा सुलाअतेहे? आन यहोवाआ परिक्शा काहा लेतेहे?”<verse eid="EXO 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 17:3" />फाशोअ तिहीं माहुंहूं तोरोहो लागी, ताहां ते ओं कोत मोशेएरी टुटणे वोल्ये, “तु आमुहूं बालबासाहा आन जनवारोहो माईंलोअ काजे मिसर मेहें रोत काहा लेतायुहू?”<note caller="+" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="EXO 14:12">निर्ग 14:12</ref></char></note><verse eid="EXO 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 17:4" />ताहां मोशे यहोवाहा रावणी कोइत कोयो, “यां माअहोंअरी कि कोओ? एं आखे माहूं डोणाटीलोअ तियार होय.”<verse eid="EXO 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5" />यहोवा मोशेहे कोयो, “इस्राएलोअ माट्योमेहें रोत थोड़ाक डायहांहां ताअरी लेत जा; आन जियी डेंगारी वाअहीं तू नील नोयीपोअ लागावयीते, तियीही ताआ आथोम लेत कोइत माअहों आगाड़ी साल. <verse eid="EXO 17:5" /><verse number="6" style="v" sid="EXO 17:6" />पाल, आंय ताआ आगाड़ी सालित कोइत होरेब डोगोअ एका खड़कापोअ उबू रोही आन तु तिया खड़कापोअ लागावजी, ताहां तियामेहें रोत पाईं निहे, जियाहा एं माअहें पिये.” ताहां मोशे इस्राएलोअ डाया माहुंहूं पालताज तेहेंज कोअयो.<verse eid="EXO 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 17:7" />आन मोशे तियाआ जागाआ नाव मस्सा आन मरिबा मेक्यो, काहाके इस्राएलवाला माअहूं तिहीं भान्गड़ कोअयी आन “देव आमाअरी होय के नाहां” एहें कोत देवोअ देवोहो पारजाणीत हेएयू.<verse eid="EXO 17:7" /></para>
  <para style="s">अमालेकवालाअरी लड़ाय</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8" />तिहीं रोत अमालेक देसोअ माअहें आवीत कोइत रफीदीमीमेहें इस्राएलोअरी लड़ाय कोए वोल्ये.<note caller="+" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="1SA 15:2">1 शमु 15:2</ref></char></note> <verse eid="EXO 17:8" /><verse number="9" style="v" sid="EXO 17:9" />ताहां मोशे यहोशवाहा कोयो, “आपाआ काजे थोड़ाक माट्योहों निवड़ीत ले, आन बाअथे जात कोइत अमालेकी वालाअरी लड़ाय कोअ; आन आंय हांदाआ देवोअ डेंगार आथोम लेत कोइत डोगोअ सुटीपोअ उबू रोहीं.” <verse eid="EXO 17:9" /><verse number="10" style="v" sid="EXO 17:10" />मोशेए या आदेशोअ परमाणे यहोशवा अमालेकी वालाअरी लड़ाय कोउ वोल्यू; आन मोशे, आरोन, आन हूर डोगोअ सुटीपोअ सोड़ीत लागा. <verse eid="EXO 17:10" /><verse number="11" style="v" sid="EXO 17:11" />जाहां जाहां मोशे तियाआ आथ उसे कोअतुतो ताहां ताहां इस्राएल जिकतोतो; पोन जाहां जाहां तो तियाआ आथ निसे कोअतुतो ताहां ताहां अमालेकी जिकतोतो.<note caller="+" style="x"><char style="xo" closed="false">17:11 </char><char style="xt" closed="false"><ref loc="PSA 44:6">भजन 44:6</ref>; <ref loc="JAS 5:16">याकोब 5:16</ref></char></note> <verse eid="EXO 17:11" /><verse number="12" style="v" sid="EXO 17:12" />पोन जेहेलाम मोशेए आथ थाकीत गोया, ताहां आरोन आन हुर नेहें डोंण लेत कोइत मोशेए निसे मेकी देदो, आन तो तियापोअ बोहीत गोयु, आन आरोन आन हूर बेनू वोल एक एक फाकड़ो तोइत तियाआ आथोहो वातड़ो तोइत रोया; आन तियाआ आथ दिही बुडू ताअहूं जाआं तोइत रोया. <verse eid="EXO 17:12" /><verse number="13" style="v" sid="EXO 17:13" />आन यहोशवा तारवाईइ तारे वाअहीं अमालेकी माअहोंहों हारवी देदे.<verse eid="EXO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14" />ताहां यहोवा मोशेहे कोयो, “ओर कोत ए गोठ पुस्तकोम लेखीत ले आन यहोशवाहा कोतापी दे के आंय जुगोअ निसे रोत अमालेकोवालाहां नावासट आरवीत टाकीहीं.”<note caller="+" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="DEU 25:17-19">कायदा 25:17-19</ref>; <ref loc="DEU 17:1">17:1</ref>; <ref loc="1SA 15:2-9">1 शमु 15:2-9</ref></char></note> <verse eid="EXO 17:14" /><verse number="15" style="v" sid="EXO 17:15" />ताहां मोशे एक देवान्यो बोणायो आन तियाआ नाव “यहोवा निस्सी”<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="fq" closed="false">निस्सी </char><char style="ft" closed="false">यहोवा माहूं जिकाड़नारु, माआ प्रभु माआ जेंडू</char></note> मिक्यो; <verse eid="EXO 17:15" /><verse number="16" style="v" sid="EXO 17:16" />आन तिये कोयो, “यहोवाआ जेंडू तोइत रोवा. अमालेकी वालाअरी यहोवाआ काजे आमाआं लड़ाय पिड़ीन पिड़ी सालुज रोय.”<verse eid="EXO 17:16" /></para>
  <chapter eid="EXO 17" />
  <chapter number="18" style="c" sid="EXO 18" />
  <para style="s">यित्रो मोशेहे मिलत्लू</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1" />जेहेलाम मोशेए होवरुह्हू मिद्यानोवालू पुंजारु यित्रो ओ उनाअयू के देवो मोशे आन तियाआ माअहें इस्राएलोअ काजे कि कि कोअयोहो, मोन्जे ओं के केहें कोइत इस्राएलोहो मिसर मेहें रोत काडीत लेतायुहू, <verse eid="EXO 18:1" /><verse number="2" style="v" sid="EXO 18:2" />ताहां मोशेए होवरुह्हू यित्रो मोशेए लाडी सिप्पोराहा, जियीही पेल तियीइ डायाअहीं मोकली देदीते, <verse eid="EXO 18:2" /><verse number="3" style="v" sid="EXO 18:3" />आन तियाआ बेनू पोर्‍याहा बी लेत आयू; तियाम रोत एकाआ नाव मोशे ओं कोत कोइत गेर्शोम मिक्योतो: “आंय बिहीरा देसोम पारकू ओतू.” <verse eid="EXO 18:3" /><verse number="4" style="v" sid="EXO 18:4" />आन बिहीरा पोऱ्याआ नाव तिये ओं कोत एलीएजेर मेक्यो: “माआं बाह्हाआ देवे माहूं मदत कोइत माहूं फारोअ तारवाइप रोत वासाड़्यू.” <verse eid="EXO 18:4" /><verse number="5" style="v" sid="EXO 18:5" />मोशेए लाडी आन मोशेए पोर्‍याहा, तियाआ होवरुह्हू यित्रो आरी लेत कोइत मोशेए जागे जंगलोअ तियी जागेहे आयू, जिहीं देवोअ डोगोअ जागे तियाआ पोड़ावू रोतुतो. <verse eid="EXO 18:5" /><verse number="6" style="v" sid="EXO 18:6" />आन आवीत कोइत तिये मोशेए जागे ओं कोत मोकल्यो, “आंय ताआ होवरुह्हू यित्रो होय, आन बेनू पोर्‍याहा आरी लेत कोइत ताआ लाडीही ताआ जागे लेतायुहू,” <verse eid="EXO 18:6" /><verse number="7" style="v" sid="EXO 18:7" />ताहां मोशे तियाआ होवराह्हा मिलीइलोअ काजे आयू, आन तियाह नमस्कार कोइत गुउं देदू; आन ते खुसीइ गोठ कोइत तियाआ पोड़ावाआ जागे आवीत लागे. <verse eid="EXO 18:7" /><verse number="8" style="v" sid="EXO 18:8" />तिहीं मोशे तियाआ होवराह्हा कोत आप्यो के यहोवा इस्राएलोअ काजे फारो आन मिसरोअरी कि कि कोअल्यो, आन इस्राएलो वाटे कि कि तारास कोअयू, फाशोअ यहोवा तियांहां केहें केहें कोइत सोड़वीत लेतायुहू. <verse eid="EXO 18:8" /><verse number="9" style="v" sid="EXO 18:9" />ताहां यित्रो तियी आखी हाजी गोठी जे यहोवा इस्राएलोअ आरी कोअयीते, तियांहां मिसरोअ आथोम रोत सोड़व्येते, खुस ओत कोइत कोयो, <verse eid="EXO 18:9" /><verse number="10" style="v" sid="EXO 18:10" />यित्रो तियाहा कोयो, “प्रभु यहोवा हाजू होय, जिये तुमुहूं फारो आन मिसरोअ आथोम रोत सोड़व्ये, जो तुमुहूं मिसरोअ आथम रोत सोडव्येहे. <verse eid="EXO 18:10" /><verse number="11" style="v" sid="EXO 18:11" />ओमे आंय जाईंत लेदोहो के यहोवा आखा देवोम रोत वोडू होय; काहाके तिये ए गोठी तियां इस्राएलवालाअरी कोअयीते.” <verse eid="EXO 18:11" /><verse number="12" style="v" sid="EXO 18:12" />ताहां मोशेए होवरुह्हू यित्रो देवोअ काजे गाराहा आन आगीपोअ गाराहा आप्यो, शांतीइ गाराहा आप्यो. आन आरोन इस्राएलोअ आखा डायहांअरी मोशेए होवरुह्हू यित्रो देवोअ आगाड़ी रोटू खाअलाआ काजे आया.<verse eid="EXO 18:12" /></para>
  <para style="s">न्यायाधिशोंअ निवड़</para>
  <para style="r">(<ref loc="DEU 1:9-18">कायदा 1:9-18</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13" />बिहीरे दिही मोशे माअहुंउं न्याय कोउ बोठू, ताहां वेगीइ ते हांस्तीइ वेले जाआं माअहें मोशेए आसे पासे उबे ओते. <verse eid="EXO 18:13" /><verse number="14" style="v" sid="EXO 18:14" />जाहां मोशेए होवरुह्हू ओं पालित कोइत मोशेए माहुंउं काजे कि कि कोअहे, तियाआ होवराह्हा कोयो, “ओं कि काम होय जो तु माहुंउं काजे कोअहे? कि कारण होय के तु एखलुज बोहीत रोहे, आन माअहें वेगीइ ते हांस्तीइ वेले जाआं ताआ आसेपासे उबे रोतेहे?”<verse eid="EXO 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 18:15" />मोशे तियाआ होवराह्हा कोयो, “माअहें माआ जागे देवोअ इश्शा फुसीइलोअ काजे आवतेहे. <verse eid="EXO 18:15" /><verse number="16" style="v" sid="EXO 18:16" />जाहां जाहां तियांआं भान्गडी ओवतिही ताहां ताहां तें माआं जागे आवतेहे, आन आंय तियांआं विसमेहें न्याय कोअहो, आन देवोअ विधी आन नियम तियांहां समजाड़ोहो.”<verse eid="EXO 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 18:17" />मोशेए होवरुह्हू तियाहा कोयो, “जो काम तु कोअहे, तो बोराबर कायनाहां. <verse eid="EXO 18:17" /><verse number="18" style="v" sid="EXO 18:18" />यावाअहीं तु कि, पोन एं माहें बी जे ताअरी होय एं बी थाकीत जाय. काहाके ओं काम ताआ काजे जास्ती कठीण होय; तु याहा एखलुज नाहां कोइ सेकतू.<note caller="+" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="NUM 11:14">गणती 11:14</ref>; <ref loc="DEU 1:9">कायदा 1:9</ref></char></note> <verse eid="EXO 18:18" /><verse number="19" style="v" sid="EXO 18:19" />ओमे तुमू माआ गोठ उनाआ जे आंय तुमुहूं कोत आपोहो, आन देव तुमाअरी रोय! तुमू यां माअहोंअ कोअते देवोअ जागे जाया कोआ, आन तियांआं भान्गडीही तु देवोअ जागे पोताड़तु रोजी. <verse eid="EXO 18:19" /><verse number="20" style="v" sid="EXO 18:20" />याहां आदेश आन नियमोओं शिक्शण आपित कोइत जियी वाटे पोअ तियांहां सालीइलो होय, आन जों जों काम तियांहां कोइलाआ होय, तो तियांहां कोत देखाड़जी. <verse eid="EXO 18:20" /><verse number="21" style="v" sid="EXO 18:21" />पोन तु आखा इस्राएलवालां माहूंम रोत एहेलाहा माटी निवड़ीत ले, जे हाजा ओय, आन देवोह बित सालनारा, विश्वासी, आन लासेए लाभ्या ने ओय; आन तियांहां हाजार हाजार, एक एक होव, पोन्नास पोन्नास, आन दोह दोह माअहूं पोअ आधिकार्‍योंअ निवड़ कोइ दे. <verse eid="EXO 18:21" /><verse number="22" style="v" sid="EXO 18:22" />आन ते आखी वेले यां माहुंउं न्याय कोअया कोए; आन आखा वोडी वोडी भान्गड़ ते ताआ जागे लेतावया कोए, आन हानी हानी केसेए न्याय तुज कोअया कोअजी; ताहां ताआ वोजू ओलवू ओवे, काहाके या वोजाहा ते बी ताअरी आखलीत लागे. <verse eid="EXO 18:22" /><verse number="23" style="v" sid="EXO 18:23" />जर तु एहें कोअही, आन देव ताहूं एहेलुहू आदेश आपे, ताहां तु उबू रोत सेकीही, आन एं आखे माअहें तियांआं जागा पोअ खुसी वाअहीं पोतीत सेके.”<verse eid="EXO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24" />तियाआ होवराह्हाआ ए गोठ मानित कोइत मोशे तियाआ आखी गोठीइ पुरमाणे कोअयो. <verse eid="EXO 18:24" /><verse number="25" style="v" sid="EXO 18:25" />आन तिये आखा इस्राएलवाला माअहूंमेहें रोत हाजा माट्योहों निवड़ीत तियांहां हाजार हाजार, होव होव, पोन्नास पोन्नास, दोह दोह माअहूं पोअ मुख्या कोत ठरव्या. <verse eid="EXO 18:25" /><verse number="26" style="v" sid="EXO 18:26" />आन ते आखा माहुंउं न्याय कोआ वोल्या; जे मुद्दा कठीण रोताते तियांहां ते मोशेए जागे लेत आवताते. आन आखा हाना हानी केसेए न्याय ते सोताहाज कोअताते.<verse eid="EXO 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 18:27" />ताहां मोशे तियाआ होवराह्हा वाटे लागाड़्यू, आन तिये तियाआ देसोअ वाट तोअयी.<verse eid="EXO 18:27" /></para>
  <chapter eid="EXO 18" />
  <chapter number="19" style="c" sid="EXO 19" />
  <para style="s">इस्राएलवाले माअहें सिनाय डोगोपोअ जात्ले</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1" />इस्राएलवाले माअहें मिसर देसोम रोत निंहील्याहा जेदिहीं तिन मोयना ओवा, तेदिहीं ते सिनायोअ जंगलो मेहें आये.<note caller="+" style="x"><char style="xo" closed="false">19:1 </char><char style="xt" closed="false"><ref loc="NUM 33:15">गणती 33:15</ref></char></note> <verse eid="EXO 19:1" /><verse number="2" style="v" sid="EXO 19:2" />आन जेहेलाम ते रफीदीम रोत सिनायोअ जंगलो मेहें आये, ताहां इस्राएलवाला जंगलोमेहें पोड़ावू कोअयू; <verse eid="EXO 19:2" /><verse number="3" style="v" sid="EXO 19:3" />ताहरुउ मोशे डोगो पोअ देवोअ जागे सोढ़ीत लागू,</para>
  <para style="p" vid="EXO 19:3">आन यहोवा डोगोपोअ रोत तियाहा आअड़ीत कोयो, “याकोबोअ घराणाहा एहें को, आन इस्राएलोहो माआ ओं वसन कोत आप: <verse eid="EXO 19:3" /><verse number="4" style="v" sid="EXO 19:4" />तुमू देख्योहो के मी मिसर वालाअरी कि कि कोअयोहो; तुमुहूं आंय मोरागाआ फाकापोअ बोहाड़ीत कोइत माआ जागे लेत आयुहू.<note caller="+" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="DEU 32:11">कायदा 32:11</ref>; <ref loc="ISA 63:9">यश 63:9</ref></char></note> <verse eid="EXO 19:4" /><verse number="5" style="v" sid="EXO 19:5" />तिहींज वाअहीं ओमे जर तुमू माआ गोठ कान देत उनाअहा, आन माआ नियम पालन कोअहा; ताहां आखा माअहूंम रोत तुमूज माआ खास सोको देस ठरहा; आखी कोल ते माआ होय.<note caller="+" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="DEU 4:20">कायदा 4:20</ref>; <ref loc="DEU 7:6">7:6</ref>; <ref loc="DEU 10:10">10:10</ref>; <ref loc="DEU 26:18">26:18</ref>; <ref loc="TIT 2:14">तित 2:14</ref></char></note> <verse eid="EXO 19:5" /><verse number="6" style="v" sid="EXO 19:6" />आन तुमू माआ नजरेमेहें पुंजाराआ राज आन सोका देस बोणहा. जे गोठी ताहूं इस्राएलोहो कोअलोअ होय, ते एज होय.”<note caller="+" style="x"><char style="xo" closed="false">19:6 </char><char style="xt" closed="false"><ref loc="1PE 2:9">1 पेत्र 2:9</ref>; <ref loc="REV 1:6">प्रगटी 1:6</ref>; <ref loc="REV 5:10">5:10</ref></char></note> <verse eid="EXO 19:6" /><verse number="7" style="v" sid="EXO 19:7" />ताहां मोशे आवीत कोइत डाया माट्योहों हाद्या, आन ए आखी गोठी, जियांहां कोअलाआ आदेश यहोवा तियाहा आप्युतो, तियांहां समजाड़ी देदी. <verse eid="EXO 19:7" /><verse number="8" style="v" sid="EXO 19:8" />आन आखा माट्यों मिलीत एकवार्‍याज उत्तर आप्यो, “जों किबी यहोवा देवे कोयोहो तों आखो आमू कोअहूं.” माअहोंअ ए गोठी मोशे यहोवाहा उनावयी.<note caller="+" style="x"><char style="xo" closed="false">19:8 </char><char style="xt" closed="false"><ref loc="JOS 24:14">यहो 24:14</ref></char></note><verse eid="EXO 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 19:9" />ताहां यहोवा मोशेहे कोयो, “उनाआ, आंय काल्ला वाद्लाआ आंदाराम रोत ओत कोइत ताआ जागे आवोहो, याअकाजे के जेहेलाम आंय ताअरी गोठी कोअहीं ताहां ते माअहें उनाय, आन हादाफल तापोअ विश्वास कोए.” आन मोशे यहोवाहा माअहोंअ गोठी कोताप्यी. <verse eid="EXO 19:9" /><verse number="10" style="v" sid="EXO 19:10" />ताहां यहोवा मोशेहे कोयो, “तु माअहोंअ जागे जा आन तियांहां आज आन हांदाआ सोताहा सोके ओवे तेहें को, आन तें तियांआं आंगड़े तुवीत लेअहूं जोवे, <verse eid="EXO 19:10" /><verse number="11" style="v" sid="EXO 19:11" />आन तें तिसरे दिही जांआं तियार ओत जाअहूं जोवे; काहाके तिसरे दिही यहोवा आखा माहुंउं डोए देखताइज सिनाय डोगोपोअ उतरीत आवे. <verse eid="EXO 19:11" /><verse number="12" style="v" sid="EXO 19:12" />आन तु माहुंउं काजे शारी वोगेहे वाड़ बांदी देजी, आन तियांहां कोजी के कोडोज डोगोपोअ ने सोड़ुहूं जोवे आन तियाआ हिवेहें बी ने टेकुहूं जोवे; आन जों कोडो डोगोहो टेके तियाहा मोतोअ डोंड जोड़े.<note caller="+" style="x"><char style="xo" closed="false">19:12 </char><char style="xt" closed="false"><ref loc="EXO 12:20">12:20</ref></char></note> <verse eid="EXO 19:12" /><verse number="13" style="v" sid="EXO 19:13" />तियाहा कोडोज आथ ने लागाड़ुहूं जोवे; जों आथ लागाड़े, तों डोणोवाअहीं नेत बिलखा वाअहीं मोए; जनवारे ओय नेत माहुंउं, तों जिवतो ने मिकीइलो. जेहेलाम वोडा आवाजोवाली मेडाआ हिंगोअ तुरीइ शब्द हांहतोहो जाआं होंबलाय, ताहां माअहें डोगोअ जागे आवुहूं जोवे.”<verse eid="EXO 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 19:14" />ताहां मोशे डोगोपोअ रोत उतरीत कोइत माअहुंउं जागे आवीत कोइत तियांहां सोके कोआड़्ये; आन तियां सोताआ आंगड़े तुवीत लेदे. <verse eid="EXO 19:14" /><verse number="15" style="v" sid="EXO 19:15" />आन मोशे कोयो, “तिसरे दिहे जाआं तियार ओत जाजा; बोईंइ जागे मा जाहा.”<verse eid="EXO 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16" />जेहेलाम तिसरु दिही आयू, ताहां हुजताज वाआ वादलो गाज्यो आन विजलो वोल्यो, आन डोगोपोअ कालु सावलू आवीत लागू, फाशुउ तुरीइ वोडा शब्दाआ आवाज ओवू, आन पोड़ावा मेऱ्येए जेतेहे माअहें ओते तें आखे बित गोये. <verse eid="EXO 19:16" /><verse number="17" style="v" sid="EXO 19:17" />ताहां मोशे माअहोंहों देवोहो मिले तेहें काजे पोड़ावाम रोत काडीत लेत गोयु; आन तें डोगोअ थुड़ोअहीं उबे रोये.<note caller="+" style="x"><char style="xo" closed="false">19:17 </char><char style="xt" closed="false"><ref loc="DEU 4:10">कायदा 4:10</ref></char></note> <verse eid="EXO 19:17" /><verse number="18" style="v" sid="EXO 19:18" />आन यहोवा जो आगीम रोत ओत कोइत सिनाय डोगोपोअ उतऱ्युतो, देव डोगोम रोत उतरीइल्यु कोत आखु डोगोअ तुमाणा वाअहीं टापाइत गोयु; आन तों तुमाणो दावाड़ाआ होस तुमाअतोतो, आन डोगोअ जाअखीलुहू कापतुतो. <verse eid="EXO 19:18" /><verse number="19" style="v" sid="EXO 19:19" />आन जेहेलाम तुरीइ आवाज वोडु वोडु वादतू गोयु, ताहां मोशे गोग्यू, आन देवो आवाज उनाइत कोइत तियाहा उत्तर आप्यो. <verse eid="EXO 19:19" /><verse number="20" style="v" sid="EXO 19:20" />आन यहोवा सिनाय डोगोअ सुटीपोअ रोत निसे उतऱ्यु; आन मोशेहे डोगोअ सुटीपोअ हाद्यू, आन मोशे डोगोपोअ सोड़ीत लागू. <verse eid="EXO 19:20" /><verse number="21" style="v" sid="EXO 19:21" />ताहां यहोवा मोशेहे कोयो, “निसे उतरीत कोइत माअहुंहूं कोत देखाड़, एहलोहो ने ओवुहूं जोवे के वाड़ तोड़ीत कोइत यहोवाहा पालीइलोअ काजे आवे, आन तियांम रोत वार जोएं मोईत जाय. <verse eid="EXO 19:21" /><verse number="22" style="v" sid="EXO 19:22" />आन पुंजारा जे यहोवाआ आगाड़ी आया कोअताहा ते बी सोताहा सोका ओवुहूं जोवे, एहेलोह ने ओवुहूं जोवे के यहोवा तियांहां डोंड आपे.”<verse eid="EXO 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 19:23" />मोशे यहोवाहा कोयो, “तें माअहें सिनाय डोगोपोअ नाहां सोड़ीत सेकते; काहाके तुमे आमुहूं ओं कोत देखाड़्योहो के डोगोअ शारी वोलेहे वाड़ बांदीत कोइत तियाहा सोको मिका.”<verse eid="EXO 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 19:24" />यहोवा तियाहा कोयो, “उतरीत जा, आन आरोनोहों लेतुज उसे आव; पोन पुंजारा नेत कोड्लाज माअहुंहूं इंहीं मा लेत आवही, एहेलोहो ने ओवुहूं जोवे के यहोवा तियांहां डोंड आपे.” <verse eid="EXO 19:24" /><verse number="25" style="v" sid="EXO 19:25" />ताहां ए गोठी मोशे डोगोपोअ रोत उतरीत कोइत माअहुंउं जागे आवित तियांहां कोयी.<verse eid="EXO 19:25" /></para>
  <chapter eid="EXO 19" />
  <chapter number="20" style="c" sid="EXO 20" />
  <para style="s">दाहा आदेश</para>
  <para style="r">(<ref loc="DEU 5:1-21">कायदा 5:1-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1" />ताहां देवे एं आखे वसने कोये: <verse eid="EXO 20:1" /><verse number="2" style="v" sid="EXO 20:2" />“आंय ताआ यहोवा देव होय. तुमू मिसर देसोम वेठाऱ्ये ओते, ताहां आंयुज तुमुहूं तिहीं रोत काडीत लेत आयुहू.<verse eid="EXO 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 20:3" />“तु माहूं सोड़ीत बिहीरा कोडाहाज देव कोत मा मानही.<verse eid="EXO 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 20:4" />“तु ताआ काजे कोड़ल्यी मुर्ती मा बोणावही; उसे जुगोमेएं नेत निसे धरतीपोअ नेत धरतीइ निसे पाअयोंमेएं, किहाआज मुर्ती मा बोणावही.<note caller="+" style="x"><char style="xo" closed="false">20:4 </char><char style="xt" closed="false"><ref loc="EXO 34:17">निर्ग 34:17</ref>; <ref loc="LEV 19:4">लेवी 19:4</ref>; <ref loc="LEV 26:1">26:1</ref>; <ref loc="DEU 4:16">कायदा 4:16</ref></char></note> <verse eid="EXO 20:4" /><verse number="5" style="v" sid="EXO 20:5" />तु तियांहां टुंगू पोड़ीत मा वोंदही, आन तियांआं सेवा बी मा कोअही; काहाके आंय ठोटाय<note caller="+" style="f"><char style="fr" closed="false">20:5 </char><char style="fq" closed="false">ठोटाय </char><char style="ft" closed="false">जलन कोअनारु</char></note> कोअनारु देव होय, आन जें माआं सीस कोअतेहे तियांहां डोंड आपत्लू; आंय तियांआं पोऱ्याआ पोर्‍याहा शार पिड़ी जाआं तियांआं आब्हाआ बोदले डोंड आपत्लू. <verse eid="EXO 20:5" /><verse number="6" style="v" sid="EXO 20:6" />पोन जें मापोअ मेर कोअतेहे आन माआं आदेश मानतेहे तियांआं हाजारेन हाजार पिड़ीपोअ आंय दया कोअत्लू.<note caller="+" style="x"><char style="xo" closed="false">20:6 </char><char style="xt" closed="false"><ref loc="EXO 34:6-7">निर्ग 34:6-7</ref>; <ref loc="NUM 14:18">गणती 14:18</ref>; <ref loc="DEU 7:9-10">कायदा 7:9-10</ref></char></note><verse eid="EXO 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 20:7" />“तु ताआ यहोवा देवोअ नाव फालतू मा लेही; काहाके जो कोडो तियाआ नाव फालतू लेय, तियाहा तो डोंड आपे.<note caller="+" style="x"><char style="xo" closed="false">20:7 </char><char style="xt" closed="false"><ref loc="LEV 19:12">लेवी 19:12</ref></char></note><verse eid="EXO 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 20:8" />“आरामोअ दिहोहो ओर कोइत सोकू दिही कोत मानजी.<note caller="+" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="EXO 16:23-30">निर्ग 16:23-30</ref></char></note> <verse eid="EXO 20:8" /><verse number="9" style="v" sid="EXO 20:9" />सोव दिही जाआं तु मेहेंनत कोइत ताआ आखो कामकाज कोअजी;<note caller="+" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="EXO 23:12">निर्ग 23:12</ref></char></note> <verse eid="EXO 20:9" /><verse number="10" style="v" sid="EXO 20:10" />पोन सांतवू दिही ओ आरामोअ दिही कोत देवोअ काजे होप्युहू, ये दिहे तु, नेत ताआ पोऱ्ये, नेत पावरे, नेत डोगरे, नेत काअलोज पारको माहुंउं जों ताआ देसोम रोहे तों कीज कामकाज ने कोअहूं जोवे; <verse eid="EXO 20:10" /><verse number="11" style="v" sid="EXO 20:11" />काहाके साहावा दिहोअ दिही यहोवा जुग, धरती, दोऱ्या, आन जों किबी तियाम होय, तों आखो बोणायो, आन हांतवे दिही आराम कोअयू; तियाहा काजे यहोवा देवे आरामोअ दिहोहो आशिर्वाद आप्यू आन सोकू ठरव्यु.<verse eid="EXO 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 20:12" />“तु ताआ आब्हाआ आन ताआ आयहीइ मानपान कोअजी, जिहीं वाअहीं जो देस ताआ देव यहोवा ताहूं आपेहे तियामेहें तू जाअखीलाहा दिही जाआं रोही.”<verse eid="EXO 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 20:13" />“तु खुन मा कोअही.<note caller="+" style="x"><char style="xo" closed="false">20:13 </char><char style="xt" closed="false"><ref loc="GEN 9:6">उत्प 9:6</ref>; <ref loc="LEV 24:17">लेवी 24:17</ref>; <ref loc="ROM 13:9">रोम 13:9</ref>; <ref loc="JAS 2:11">याकोब 2:11</ref>; <ref loc="MAT 5:21">मत्तय 5:21</ref></char></note><verse eid="EXO 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 20:14" />“तु सिनालो मा कोअही.<verse eid="EXO 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 20:15" />“तु बांडगाय मा कोअही.<note caller="+" style="x"><char style="xo" closed="false">20:15 </char><char style="xt" closed="false"><ref loc="LEV 19:11">लेवी 19:11</ref></char></note><verse eid="EXO 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 20:16" />“तु कोडाआ विरुद्दाम ठोगोअ साक्शी मा आपही.”<verse eid="EXO 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 20:17" />“तु कोडाआ कोओअ लालस मा कोअही; आन मा कोडाआ बोईंइ लालस कोअही, आन मा कोडा पावरोअ के बोलोद, गोदड़ाआ, के कोडाआ; कोड्लीज वस्तुउ लालस कोअही.”<verse eid="EXO 20:17" /></para>
  <para style="s">इस्राएल माअहोंहों बिकाणो</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18" />जाहां आखे माअहें वाद्लो गाजीइलोन विजलीइलो आन तुरीइ आवाज उनाअते जात डोगोपोअ तुमाणू पालते रोये, ताहां बिकेवाअहीं कापते जात सेटे सेटे उबे रोत गोये.<note caller="+" style="x"><char style="xo" closed="false">20:18 </char><char style="xt" closed="false"><ref loc="HEB 12:18">इब्री 12:18</ref></char></note> <verse eid="EXO 20:18" /><verse number="19" style="v" sid="EXO 20:19" />आन तें मोशेहे कोने वोल्ये, “तुज आमाअरी गोठी कोअजी, ताहांज आमू उनाअहूं; पोन देव आमाअरी गोठी ने कोअहूं जोवे, नेत आमू मोईत जाहूं.”<verse eid="EXO 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 20:20" />मोशे माअहोंहों कोयो, “बिहा मा; काहाके देव तुमाआ परिक्शा लेअलोअ कोअते आयुहू, मोन्ज्ये तुमू तियाहा बिहा ताहां तुमू पाप ने कोअहा.” <verse eid="EXO 20:20" /><verse number="21" style="v" sid="EXO 20:21" />आन ते माअहें सेटेज उबे रोये पोन मोशे तिया जाडा आंदाराम गोयु जिहीं देव ओतू.<verse eid="EXO 20:21" /></para>
  <para style="s">वेदीइ बाप्तिम नियम</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22" />ताहां यहोवा मोशेहे कोयो, “तु इस्राएलोहो माआ ए गोठी कोत आप: तुमू माअहें सोताहाज देख्येहे के आंय तुमाअरी जुगोम रोत गोठी कोअयीही. <verse eid="EXO 20:22" /><verse number="23" style="v" sid="EXO 20:23" />तुमू माहूं सोड़ीत, मोन्जे तुमाआ कोअते सांदीइ नेत होनाआ देवे मा बोणावहा. <verse eid="EXO 20:23" /><verse number="24" style="v" sid="EXO 20:24" />माआ काजे कादवोअ एक देवान्यो बोणावजा, आन तियापोअ आगीइ गाराहा, शांतीबली आपजा, तुमाआ मेडे, डोगरेन बोकड़े गाराहा आपजा. आन जिहीं जिहीं आंय माआ नावोअ ओर कोआड़ीहीं, तिहीं तिहीं आंय आवीत कोइत तुमुहूं आशिर्वाद आपीहीं. <verse eid="EXO 20:24" /><verse number="25" style="v" sid="EXO 20:25" />आन जर तुमू माआ काजे डोणोअ देवान्यो बोणावहा, ताहां कोड़ल्या डोणोअ मा बोणावहा; नेते जिहीं तुमू तियापोअ आथ्यार लागाड़हा तिहीं तुमू तियाहा एठो कोई देहा. <verse eid="EXO 20:25" /><verse number="26" style="v" sid="EXO 20:26" />आन तुमाआ डिल नागरो देखात पोड़े एहलोहो निहीणावालो देवान्यो माआ कोअते मा बोणावहा.”<verse eid="EXO 20:26" /></para>
  <chapter eid="EXO 20" />
  <chapter number="21" style="c" sid="EXO 21" />
  <para style="s">पावरोअरी वेवारो</para>
  <para style="r">(<ref loc="DEU 15:12-18">कायदा 15:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1" />“फाशुउ जो नियम ताहूं तियांहां समजाड़ीइलोअ होय तो ओ होय: <verse eid="EXO 21:1" /><verse number="2" style="v" sid="EXO 21:2" />जर तुमू एखा इब्री पावरोहो वेसातू लेहा, ताहां तो सोव वोरह्ये जाआं सेवा कोअतू रोय, आन सांतवा वोरह्योम मोकलु ओत कोइत पागार लेत कोइत जातु रोय. <verse eid="EXO 21:2" /><verse number="3" style="v" sid="EXO 21:3" />जर तो सोड़लुज आयुय, ताहां सोड़लुज जातु रोअहूं जोवे; आन जर लाडीइरी आयुय, ताहां लाडीइरीज जातू रोअहूं जोवे. <verse eid="EXO 21:3" /><verse number="4" style="v" sid="EXO 21:4" />आन जर तियाआ मालख्ये तियाहा लाडी होदीत आप्यीये, आन तियीइ पोऱ्ये ओत गोयेय, ताहां तियाआ लाडी आन तें पोऱ्ये नेहें मालख्योअ रोय, पोन तो एखलुज सुटीत जातू रोअहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="LEV 25:44">लेवी 25:44</ref></char></note> <verse eid="EXO 21:4" /><verse number="5" style="v" sid="EXO 21:5" />पोन जर तो पावर तियाआ मालख्योअरी रोअहूं होदतुये आन तियाआ मालख्योपोअ आन तियाआ बोईं-पोऱ्यापोअ मेर कोअतुये, आन सोड़ीत जाअलोअ ईश्शा ने ओय, <verse eid="EXO 21:5" /><verse number="6" style="v" sid="EXO 21:6" />ताहां तियाआ मालिख तियाहा देवोअ सामने लेत जाअहूं जोवे; तिहीं रोत बाओअ जागे नेत सोवकोटीइ जागे लेत जात हुयाली टासणी वाअहीं तियाआ कान विंदी देअहूं जोवे. तिहीं रोत तो पावर तियाआ मालिख मोए ताअहूं जाआं सेवा कोअतू रोय.”<verse eid="EXO 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 21:7" />“जर एखू तियाआ पोऱ्यीही पावरायीमेहें वेसीत खात जाय, ताहां तियीही माट्योअ होस पावरायीमेहें सुटका कायने जोड़े. <verse eid="EXO 21:7" /><verse number="8" style="v" sid="EXO 21:8" />जर तियीइ मालिख तियीही लाडी बोणावीत खुस ने रोय, ताहां तियीही फाशीइ तियीइ आब्हाहा वेसी देत सोड़ली कोई देअहूं जोवे; पोन पारका माअहोंहों वेसीइलोअ तियाहा आधिकार कायनाहां. <verse eid="EXO 21:8" /><verse number="9" style="v" sid="EXO 21:9" />जर तिये तियाआ बेटाह्हाअरी तियीइ वेहेवाल कोइ देदोय ताहां, तो तियीही पावरोअ होस नाहां पोन बेटिह्हीइ होस वागवुहूं जोवे. <verse eid="EXO 21:9" /><verse number="10" style="v" sid="EXO 21:10" />जर मालिख बिहीरी लाडी बी होदे, तेबी पेल्लीइ बोईंइ खावटी, आंगड़े-पोतड़े आन तियीइ हक्क कमी ने पाडुहूं जोवे. <verse eid="EXO 21:10" /><verse number="11" style="v" sid="EXO 21:11" />जर ए तिनू गोठी पुरी ने कोए, ताहां ते बोईं बिगर दाम सुकाड़्येज जाती रोअहूं जोवे.”<verse eid="EXO 21:11" /></para>
  <para style="s">मारामारीइ बाप्तिम नियम</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12" />“जों कोडो एखा माहुंहूं एतोहो देय के तों मोइत जाय ताहां तियाहा बी माईंत टाकुहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="LEV 24:17">लेवी 24:17</ref></char></note> <verse eid="EXO 21:12" /><verse number="13" style="v" sid="EXO 21:13" />जर तो तियाआ माईलाअ काजे ने बोठू ओय, आन देवोअ ईश्शा वाअहीं तो तियाआ आथोम पोड़ीत गोयु ओय, ताहां एहेलाहा माहुंउं निकाइलोअ काजे आंय एक जागू ठरवीहीं जिहीं तो गुगदू वोले. <verse eid="EXO 21:13" /><verse number="14" style="v" sid="EXO 21:14" />पोन जर कोडू जाईंजाईंज एखाहा देनू जाय आन तियाहा माईं देय, ताहां तियाहा माइलोअ काजे माआ देवान्याआ जागे रोत सेटे लेत जाजा.”<verse eid="EXO 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 21:15" />“जों तियाआ आयहीही नेत आब्हाहा देनो जाय तियाहा माइत टाकी देअहूं जोवे.<verse eid="EXO 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 21:16" />“जों कोडो एखा माहुंहूं सोए, नेत लेत जात वेसी देय, नेत तियाआ जागे देखाय, ताहां तियाहा बी माईंत टाकजा.<verse eid="EXO 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 21:17" />“जो तियाआ आयहीही नेत आब्हाहा हाराप आपे तियाहा बी माईंत टाकजा.<verse eid="EXO 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 21:18" />“जर माअहें सुलाअतेय, ताहां बेनुहूं बी डोणोअ नेत तुंबावाअही एहलोहो देजा के ते ने मोए, पोन आथरुपोअ लोटीत रोय, <verse eid="EXO 21:18" /><verse number="19" style="v" sid="EXO 21:19" />जेहेलाम तो उठीत कोइत डेंगारीइ आदारो वाअहीं बाअथे सालो-फिरो वोले, ताहां तियाहा देनारो माहुंउं निर्दुस ठोरे; तियी वेले खर्साआ कोअते नुकसान भरपायी आपी देअहूं जोवे, आन तियाहा हाजो कोई देअहूं जोवे.<verse eid="EXO 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 21:20" />“जर एखे मालख्ये तियाआ पावरोहो डेंगारी वाअहीं एतो देदो के तो तियाआ देद्लावाअहीं मोइत जाय, ताहां तों बोईं नेत माटी कोडो बी ओय, ताहां तिया मालख्योहो डोंड आपुहूं जोवे; <verse eid="EXO 21:20" /><verse number="21" style="v" sid="EXO 21:21" />पोन जर तो एक, बेन दिही जिवतो रोयो, ताहां मालख्योहो डोंड ने आपुहूं जोवे, काहाके तो तियाआ धन होये.<verse eid="EXO 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 21:22" />“जर बेन माटी एकमेकाअरी सुलाअताये आन तियांआं धक्कू लागीत एखी पोटावाली बोईंइ पोऱ्यो पोड़ीत जाय, पोन कीज नुकसान ने ओवे, ताहां तियी बोईंइ माटी पोन्सामेहें जो डोंड ठरवे तो तियाहा पोअहूं पोड़े. <verse eid="EXO 21:22" /><verse number="23" style="v" sid="EXO 21:23" />पोन जर तियी बोईंहीं काविंहीं नुकसान ओवे, ताहां जिवोअ बोदले जिव आपुहूं पोड़े, <verse eid="EXO 21:23" /><verse number="24" style="v" sid="EXO 21:24" />डोआआ बोदले डोऊ, दातोअ बोदले दात, आथोअ बोदले आथ, गुडाआ बोदले गुडू, <verse eid="EXO 21:24" /><verse number="25" style="v" sid="EXO 21:25" />आगीइ सटकाआ बोदले सटकू, जखमेए बोदले जखम आन मारोअ बोदले मार एहेलुहू डोंड आपुहूं जोवे.<verse eid="EXO 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 21:26" />“जर एखू मालिख तियाआ पावरोहो एहेलुहू मारु देय के तियाआ डोऊ फुटीत जाय, ते बोईं ओय नेते माटी, तियाहा सुटका कोइत जाअहूं देअहूं जोवे. <verse eid="EXO 21:26" /><verse number="27" style="v" sid="EXO 21:27" />जर एखे मालख्ये एखा पावरोहो सोबीपोअ लागावतामेहें दात पाड़ीत टाक्युय, ताहां ते बोईं नेत माटी ओय, तियाहा दातोअ बोदले सुटका कोइत जाअहूं देअहूं जोवे.”<verse eid="EXO 21:27" /></para>
  <para style="s">मालख्योअ जबाबदारी</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28" />“एखाआ बोलदे एखी बोईंहीं नेत माट्योहो सुंदीत माइत टाकी देय, ताहां तिया बोलदोहो दोगड़ाट्तीज माइत टाकुहूं जोवे, तियाआ माहां बी खाअहूं ने जोवे. पोन तिया बोलदोअ मालिख निर्दुस ठरे. <verse eid="EXO 21:28" /><verse number="29" style="v" sid="EXO 21:29" />पोन जर तिया बोलदोअ हिंगो कोइत पेल रोतुज माअहोंहों सुंदीइलोअ टेव ओय, आन तियाआ मालख्योहो बी यी गोठीइ सुसना ओय, पोन तिये तिया बोलदोहो ने बांदीत मिक्यू तिहीं वाअहीं तो बोलोद एखा माट्योहो नेते बोईंहीं सुंदीत माईंत टाके, ताहां तो मालिख दोशी ठरे, तिया बोलदोहो डोणाटतीज माइत टाकुहूं जोवे, आन तिया मालख्योहो बी माईंत टाकुहूं जोवे. <verse eid="EXO 21:29" /><verse number="30" style="v" sid="EXO 21:30" />पोन जर मोअनारा माहुंउं कुटुंबामेऱ्याआ माहुंहूं तिया मालख्योअ जिवोअ बोदले जे किम्मत ठरे ते तियाहा आपुहूं पोड़े. <verse eid="EXO 21:30" /><verse number="31" style="v" sid="EXO 21:31" />जर बोलदे एखा पोऱ्याहा नेते पोऱ्यीही सुंदीत माए, तेबी ओज नियम लागू रोय. <verse eid="EXO 21:31" /><verse number="32" style="v" sid="EXO 21:32" />एखे बोलदे जर पावरोहो सुंदीत माईंत टाके, ताहां तिया बोलदोअ धोणी तिया पावरोअ धोण्योहो तीस सांदीइ रुप्या आपुहूं जोवे आन तिया बोलदोहो दोगड़ाट्टीज माइत टाकुहूं जोवे. ओ नियम बोईंन माटी बेनुहूं हारकुज रोय.”<verse eid="EXO 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 21:33" />“जर एखू वेए ने ताहां खाडू खुएं आन तिया पोअ कीज ने टापे, आन एखाआ बोलोद नेत गोदड़ो मांय पोड़े, <verse eid="EXO 21:33" /><verse number="34" style="v" sid="EXO 21:34" />ताहां खाड्डाआ मालिख नुकसान भरपायी कोइत आपी देअहूं जोवे, आन जनवारोअ मालख्योहो तियाआ किम्मत आपुहूं जोवे आन मोल्यो जनवार तिया खाड्डावाला मालख्योअ रोय. <verse eid="EXO 21:34" /><verse number="35" style="v" sid="EXO 21:35" />जर एखाआ बोलदे बिहीराआ बोलदोहो सुंदतीज माइत टाकी देय, ताहां जिवतू रोय तो बोलोद वेसीत बेनू मालिख निम्मे निम्मे पोशा वाटीत लेअहूं जोवे, आन तो मोल्यू बोलोद बी आरदू आरदू वाटीत लेअहूं जोवे. <verse eid="EXO 21:35" /><verse number="36" style="v" sid="EXO 21:36" />पोन जर तो बोलद पेल्लूउज सुंदत्लू नावलाअतुये आन तियाआ मालख्ये तियाहा सुंदरा बोलदोहो मोकलू सोड़ल्याआ वाखरी दोशी ठरे; तो मोल्या बोलदोअ बोदले जिवतू बोलोद आपी देअहूं जोवे, आन मोल्यू बोलोद तो लेत जात रोअहूं जोवे.”<verse eid="EXO 21:36" /></para>
  <chapter eid="EXO 21" />
  <chapter number="22" style="c" sid="EXO 22" />
  <para style="s">नियम आन डोंड</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1" />“एखे मेडे, डोगरेन बोकड़े सोअये ओय तियाहा की डोंड आपुहूं जोवे? एखे बोलोद नेत मेडो सोइत माईंत खादो नेताहां वेसी देदो ओय, ताहां तियाहा तोज वापिस कोअता ने आवनारो तिहीं वाअहीं, एका डोगराआ सोरीइ बोदले पास डोगरे आन एका मेडाआ बोदले शार मेडे आपुहूं जोवे. सोरीइ बोदले तो एहेलिही भरपायी कोअहूं जोवे. <verse eid="EXO 22:1" /><verse number="2" style="v" sid="EXO 22:2" />जर बांड सोरी कोअतामेहें तोआयू, आन तियापोअ एहेलुहू मारु पोड़े के तो मोइत जाय, ताहां तियाआ खुनोअ गुनू ने लागे; <verse eid="EXO 22:2" /><verse number="3" style="v" sid="EXO 22:3" />जर दिही उगीत जाय, ताहां तियाआ रक्ताआ गुनू लागे; बांडोहो नुकसान भरपाई कोअहूं पोड़े, जर तियापोअ किज ने ओय, ताहां तियाहा सोरीइ बोदले वेसी देअहूं जोवे. <verse eid="EXO 22:3" /><verse number="4" style="v" sid="EXO 22:4" />जर सोअल्यू बोलोद, नेत गोदड़ो, नेत मेडो, नेत बोकड़ो तियाआ आथोम जिवतो मिले, ताहां तो तियाआ बेन भाग पोइत आपुहूं जोवे.”<verse eid="EXO 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 22:5" />“जर एखु तियाआ डोगरेन बोकड़े एखाअ खेतोम नेत दाराक्शाआ मोलाम सारे, मोन्जे तियाआ डोगरान बोकड़ाहा एहेलोज सोड़ी देय के तो बिहीराआ खेतोम सोरीत लेय, ताहां तो तियाआ खेतोम रोत दाराक्शाआ वाड़ाम रोत हाजाम हाजो फोलवाम रोत नुकसान भरपाई आपुहूं जोवे.”<verse eid="EXO 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 22:6" />“जर एखु तियाआ खेतोमेऱ्येए काटे पेटाड़ीलोअ काजे आग पेटाड़्यी आन वोडी आग पेटाइत उठ्यी आन सामनेवालाआ खेतोमेऱ्योअ उबलो ओन नेताहां आन खेत पेटाइत जाय, ताहां जिये आग पेटाड़्यी ओय तों नुकसान भरपायी पोई देअहूं जोवे.”<verse eid="EXO 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 22:7" />“जर एखु बिहीरापोअ तियाआ पोशा नेत वस्तु मिके तेहें आप्यो ओय, आन तो तियाआ कोअ रोत सोआत जाय, ताहां बांड तोआत जाय ताहां बेन भाग तियाहा पोअहूं पोड़े. <verse eid="EXO 22:7" /><verse number="8" style="v" sid="EXO 22:8" />जर बांड ने तोआय, ताहां कोओअ मालख्योहो देवोअ सामने लेत आवजा, मोन्जे मुंदू ओत जाय के तिये तियाआ पायहोअ मालमिलकते पोअ आथ लागाड़्यु के नाहां.”<verse eid="EXO 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 22:9" />“बोलोद ओय, गोदड़े ओय, नेत मेडे नेत बोकड़े, नेत आंगड़े नेत एखी जातीइ टाकाअली वस्तुउ बाप्तिम तकराट आवे, जियाहा बेन जोआं माआ, माआ कोअताहा, ताहां बेनुहूं देवोअ<note caller="+" style="f"><char style="fr" closed="false">22:9 </char><char style="fq" closed="false">देवोअ </char><char style="ft" closed="false">न्याय कोअनारा देवोअ जागे</char></note> जागे लेत आवजा; आन देव जियाहा दोशी ठरवे, तो बिहीराहा बेन भाग पोइत आपुहूं जोवे.”<verse eid="EXO 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 22:10" />“जर एखु तियाआ जागेवालाहा गोदड़ो, नेत बोलोद, नेत बोकड़ो, नेत मेडो नेताहां काअलोज बी जनवार मिके तेहें आपे, आन कोडोज ने पाले तेहेंज मोइत जाय, नेत सोआत जाय नेत ओड़ीत लेत जाय. <verse eid="EXO 22:10" /><verse number="11" style="v" sid="EXO 22:11" />ताहां तियां बेनुउं विसमेहें यहोवा देवोअ शप्पत खावाड़ीइलोअ, ‘आंय तियाआ मालमिलकतो पोअ आथ नाहां टाक्यु;’ ताहां मालमिलकोतोअ मालिख तियाहा खोरो माने, आन बिहीराहा तियाहा थोड़क बी पोइत आपुहूं ने पोड़े. <verse eid="EXO 22:11" /><verse number="12" style="v" sid="EXO 22:12" />जर तो हुदाअलीज तियाअहीं रोत सोआयोय, ताहां तों तियाआ मालख्योहो भरपायी कोइत आपुहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">22:12 </char><char style="xt" closed="false"><ref loc="GEN 31:39">उत्प 31:39</ref> </char></note> <verse eid="EXO 22:12" /><verse number="13" style="v" sid="EXO 22:13" />आन जर तो रानठ्या जनवारोअ वाअहीं माआयो ओय, ताहां तिया मोअल्या जनवारोहो पुरावाआ काजे लेत आवजा, ताहां तियाहा तियाआ नुकसान पोइत ने आपुहूं पोड़े.”<verse eid="EXO 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 22:14" />“फाशोअ जर एखु कोडो बिहीरा पोअ जनवार मागित लेतावे, आन तिया मालिख आरी ने रोय आन जनवार दुखाअयो नेत मोईत जाय, ताहां तो तियाआ नुकसान पोई देअहूं जोवो, <verse eid="EXO 22:14" /><verse number="15" style="v" sid="EXO 22:15" />जर तियाआ मालिख आरी ओय, ताहां बिहीराहा तियाआ नुकसान ने पोअहूं पोड़े; जर तो पाड़ाआ ओय, ताहां तियाआ नुकसान तिया पाड़ाजमेहें वोसुल ओत जाय.”<verse eid="EXO 22:15" /></para>
  <para style="s">निती आन हाजा नियम</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16" />“जर एखु माटी कुवारी पोऱ्यीही, जियीइ वेहेवालोअ गोठी ने ओवी ओय, ठोगित कोइत तियीइरी सिनालो कोए, ताहां तो देजो आपित कोइत तियीइरी वेहेवाल कोइत लेअहूं जोवे. <verse eid="EXO 22:16" /><verse number="17" style="v" sid="EXO 22:17" />पोन तियाआ आब्हाआ इश्शा ने ओय, ताहां सिनालो कोअनारु कोज्याआ पोशा रितीइ पुरमाणे आपुहूं जोवे.”<verse eid="EXO 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 22:18" />“डाखण विद्या कोअनारी बोईंहीं जिवती मा रोअहूं देहा.<note caller="+" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="DEU 18:10-11">कायदा 18:10-11</ref></char></note><verse eid="EXO 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 22:19" />“जों कोडो जनवारोअरी सिनालो कोए, तियाहा नक्की माइत टाकुहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">22:19 </char><char style="xt" closed="false"><ref loc="LEV 18:23">लेवी 18:23</ref>; <ref loc="LEV 20:15">20:15</ref>; <ref loc="DEU 27:21">कायदा 27:21</ref></char></note><verse eid="EXO 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 22:20" />“जो कोडो यहोवा देवोहो सोड़ीत कोइत बिहीरा देवोहो गाराहा आपे तियाहा माईंत टाकुहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="DEU 17:2-7">कायदा 17:2-7</ref></char></note><verse eid="EXO 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 22:21" />“तुमाआ देसोम पारको माहुंउं आवे तियाहा तारास मा देहा आन दाबाव मा टाकहा; काहाके तुमू बी मिसर देसोम पारके ओते ओं ओर मिकजा.<note caller="+" style="x"><char style="xo" closed="false">22:21 </char><char style="xt" closed="false"><ref loc="EXO 23:9">निर्ग 23:9</ref>; <ref loc="LEV 19:33-34">लेवी 19:33-34</ref>; <ref loc="DEU 17:18">कायदा 17:18</ref></char></note> <verse eid="EXO 22:21" /><verse number="22" style="v" sid="EXO 22:22" />कोड्ली बी रोंडोअ बोईंही नेताहां विखावाला पोऱ्याहा तारास मा देहा. <verse eid="EXO 22:22" /><verse number="23" style="v" sid="EXO 22:23" />जर तुमू तियांहां तारास देहा आन तें माहूं प्रार्थना कोए; ताहां आंय तियांआं प्रार्थना नक्कीज उनाअहीं. <verse eid="EXO 22:23" /><verse number="24" style="v" sid="EXO 22:24" />ताहां माहूं खोत लागे ताहां आंय तुमुहूं तारवाआ लेत माईंत टाकीहीं, तुमाआं बोईं बी रोंडात जाय आन तुमाआं पोऱ्ये बी विखावाले ओत जाय.”<verse eid="EXO 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 22:25" />“जर तुमे माआं एखा गरीब माहुंहूं उसन्यो पोशा आप्याये, ताहां हावकारोअ होस वियाज मा लेही आन पोशा वेगो आपुहूं जोवे कोत जोर मा देखाड़ही.<note caller="+" style="x"><char style="xo" closed="false">22:25 </char><char style="xt" closed="false"><ref loc="LEV 25:35-38">लेवी 25:35-38</ref>; <ref loc="DEU 15:7-11">कायदा 15:7-11</ref>; <ref loc="DEU 23:19-20">23:19-20</ref></char></note> <verse eid="EXO 22:25" /><verse number="26" style="v" sid="EXO 22:26" />जर एखू सोड़ीवताआ बोली कोअ साअको मिकीत जाय, ताहां दिही बुडताआ पेल तो तियाआ साअको वापिस कोइ देजी.<note caller="+" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="DEU 26:10-13">कायदा 26:10-13</ref></char></note> <verse eid="EXO 22:26" /><verse number="27" style="v" sid="EXO 22:27" />काहाके तियाहा राती फांगीइलोअ बिहीरो कीज ने ओय, ताहां तियाहा राती हेलो लागे, एहेलामेहें तो मापोअ रावण्या कोए, ताहां आंय तियाआ रावणी उनाइत लेही, काहाके आंय मायालू देव होय.”<verse eid="EXO 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 22:28" />“तुमू तुमाआ देवोहो दोस मा देहा, आन तुमाआ माअहोंअ पुडाऱ्योहों बी हाराप मा देहा.<note caller="+" style="x"><char style="xo" closed="false">22:28 </char><char style="xt" closed="false"><ref loc="ACT 23:5">प्रेशित 23:5</ref></char></note><verse eid="EXO 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 22:29" />“आन ताआ खेतोमेर्‍योअ पेहलो फोलवो आन फोलवामेएं पेहलू रोहो माहूं भेट कोअजी.</para>
  <para style="p" vid="EXO 22:29">“ताआ पोऱ्यामेएं पेलठो पोऱ्यो माहूं होपी देजी. <verse eid="EXO 22:29" /><verse number="30" style="v" sid="EXO 22:30" />तेहेंज कोइत वासड़ीइ पेहलो बासो आन मेडा-बोकड़ामेएं पेहली वेतेए गिद्लाहा माहूं भेट कोअजी. उबजे तेदिहीं रोत हांत दिही जाआं तें तियां आयहीइ जागे रोय, तिहीं रोत आंठवे दिहे तें माहूं आपुहूं जोवे.”<verse eid="EXO 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 22:31" />“तुमू माआं खास निवड़ीइल्ये सोके माअहें होय, तियाहा काजे तुमू जोराखा जनवारो वेतरीत टाकल्या जनवारोहो मा खाहा, तियांहां हुंणाहां आपी देजा.”<note caller="+" style="x"><char style="xo" closed="false">22:31 </char><char style="xt" closed="false"><ref loc="LEV 17:15">लेवी 17:15</ref></char></note><verse eid="EXO 22:31" /></para>
  <chapter eid="EXO 22" />
  <chapter number="23" style="c" sid="EXO 23" />
  <para style="s">न्याय आन निती</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1" />“तु ठोगोअ गोठीइ मा परसार कोअही. पापी माअहोंअ वोल साक्शी मा देही. <verse eid="EXO 23:1" /><verse number="2" style="v" sid="EXO 23:2" />तु सुकी कोअनारा वोडा टोलाअरी सामिल मा ओवही; आन तु वोडा टोलाआ मोर्जीइ परमाणे गुनामेहें न्याय बिगाड़ीलोअ काजे साक्शी मा देही; <verse eid="EXO 23:2" /><verse number="3" style="v" sid="EXO 23:3" />आन गरीबोअ न्याय होय कोत तियाआ भेदभाव मा कोअही.”<verse eid="EXO 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4" />“जर ताआ दुस्मोनोअ बोलोद नेत गोदड़ो टाकाअलो ताहूं जोड़्यो, ताहां तियाहा तियाआ मालख्योअ जागे पोताड़ी देजी. <verse eid="EXO 23:4" /><verse number="5" style="v" sid="EXO 23:5" />जर तु ताआ दुस्मोनोअ गोदड़ाहा वोजा वाअहीं दाबाइत रोल्यो देखही, ताहां तियापोर्‍यीइ खोत विहीराइत तियाआ गोदड़ाहा वोजू उठाड़ीइलोअ मदत कोअजी.”<note caller="+" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="DEU 22:1-4">कायदा 22:1-4</ref></char></note><verse eid="EXO 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 23:6" />“तुमामेहें जो गरीब ओय तियाआ न्याय मा बिगाड़ही.<note caller="+" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="DEU 16:19">कायदा 16:19</ref></char></note> <verse eid="EXO 23:6" /><verse number="7" style="v" sid="EXO 23:7" />तु ठोगोअ आरोप मा लागाड़ही, आन निर्दुस आन न्यायी माहोंअ खुन मा कोअही, काहाके आंय पापीही निर्दुस ने सोड़ो. <verse eid="EXO 23:7" /><verse number="8" style="v" sid="EXO 23:8" />लास मा लेहा, काहाके लास माहुंहूं सत्य गोठी रोत आंद्लो कोइ देहे आन निर्दुसोअ न्याय बिगड़ीत जाहे.”<verse eid="EXO 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 23:9" />“तु पारका माहूंपोअ दाबाव मा टाकही. काहाके तुमुहूं मुंदू होय के तुमू बी मिसर देसोम पारके ओते.”<note caller="+" style="x"><char style="xo" closed="false">23:9 </char><char style="xt" closed="false"><ref loc="EXO 22:9">निर्ग 22:9</ref>; <ref loc="LEV 19:33">लेवी 19:33</ref>,<ref loc="LEV 19:34">34</ref></char></note><verse eid="EXO 23:9" /></para>
  <para style="s">हांतवो वोरिही आन हांतवू दिही</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10" />“तु सोव वोरह्ये जाआं सोताआ खेतोमेहें बियारु ओअजी आन ओन पाक टोलु वालजी;<note caller="+" style="x"><char style="xo" closed="false">23:10 </char><char style="xt" closed="false"><ref loc="LEV 25:11">लेवी 25:11</ref></char></note> <verse eid="EXO 23:10" /><verse number="11" style="v" sid="EXO 23:11" />पोन हांतवे साल मा खेड़ही, तिहींमेएं जों ओन उगे आन पाके ताहां कीज बी मा वाडही, पोन गोरब्योअ काजे रोअहूं देजी. जों बाकी रोत जाय तों रानठ्या जनवारोंअ काजे रोअहूं देजी. तेहेंज कोइत ताआ दाराक्शाआ मोलू आन जेयतुनोअ वाडीइ बी तेहेंज कोअजी.”<note caller="+" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="LEV 25:1-7">लेवी 25:1-7</ref></char></note><verse eid="EXO 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 23:12" />“तु सोव दिही जाआं मेहेंनत कोअजी, पोन हांतवे दिही आराम कोअजी; काहाके ताआ बोलोद आन गोदड़ाहा आराम जोड़े ताआ पावरोअ पोर्‍ये आन बिहीरा देसोअ पारको माहुंउं बी आराम कोइत सेके.<note caller="+" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LEV 23:3">लेवी 23:3</ref>; <ref loc="DEU 5:13-14">कायदा 5:13-14</ref></char></note><verse eid="EXO 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 23:13" />“जों किबी आंय तुमुहूं कोयोहो तों कान देत उनाअजा; आन बिहीरा देवोअ माग बी मा काडहा, आन तियांआं नाव तुमाआ सोबीपोअ जाआं मा लेहा.”<verse eid="EXO 23:13" /></para>
  <para style="s">तिन वोडा तिवार</para>
  <para style="r">(<ref loc="EXO 34:18-26">निर्ग 34:18-26</ref>; <ref loc="DEU 16:1-17">कायदा 16:1-17</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14" />“वोरह्योअ डिठ तिनवारी माआ काजे तिवार कोअजा. <verse eid="EXO 23:14" /><verse number="15" style="v" sid="EXO 23:15" />खमीरोअ रोटाआ तिवार कोअजा; तियाम माआ नियमोअ पुरमाणे आबीब मोयनाआ नियमोअ होमसे हांत दिही जाआं खमीरोअ रोटू खाया कोअजा, काहाके तियाज मोयनामेहें तुमू मिसरोमेहें रोत निहींत आयेते. कोडोज बी ठाल्ले आथे माआं सामने ने आवुहूं जोवे.”<note caller="+" style="x"><char style="xo" closed="false">23:15 </char><char style="xt" closed="false"><ref loc="LEV 23:6-8">लेवी 23:6-8</ref>; <ref loc="NUM 28:17-25">गणती 28:17-25</ref></char></note><verse eid="EXO 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 23:16" />“जर ताआ ओअल्या खेतोमेएं पेलठो फोलवो ओन पाकीज जाय, ताहां वाडीइलोअ तिवार कोअजा.</para>
  <para style="p" vid="EXO 23:16">“वोरहोअ सेवटी जेहेलाम तु मेहेंनतोअ फोलवे टोलू वालित टिग कोअहा, ताहां टोलू वालीइलोअ तिवार कोअजा.<note caller="+" style="x"><char style="xo" closed="false">23:16 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">लेवी 23:15-21</ref>; <ref loc="LEV 23:39-43">23:39-43</ref>; <ref loc="NUM 28:26-31">गणती 28:26-31</ref></char></note> <verse eid="EXO 23:16" /><verse number="17" style="v" sid="EXO 23:17" />वोरह्योअ डिठ तिनू वारी तुमू आखा माटी प्रभु यहोवा देवोअ सामने हजर ओवजा.”<verse eid="EXO 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 23:18" />“गाराहा कोअल्यो रक्त खमीरोअ रोटाअरी माआ जागे मा लेत आवहा, आन माआ तिवारोअ हाजो गाराहामेहें<note caller="+" style="f"><char style="fr" closed="false">23:18 </char><char style="fq" closed="false">गाराहामेहें </char><char style="ft" closed="false">थोड़ाक लेख्यामेहें सरबी लेख्यो जोड़ेहे.</char></note> रोत थोड़ोक बी वेगीइ जाआं रोअहूं मा देहा.<verse eid="EXO 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 23:19" />“तुमाआ कामायीइ पेलठो फोलवो तुमाआ यहोवा देवोअ कोअमेहें लेतावा. मेडाआ नेताहां बोकड़ीइ बासाहा तियाआ आयहीइ दुदोम मा रांदहा.”<note caller="+" style="x"><char style="xo" closed="false">23:19 </char><char style="xt" closed="false"><ref loc="DEU 26:2">कायदा 26:2</ref>; <ref loc="DEU 14:21">14:21</ref>; <ref loc="EXO 34:26">निर्ग 34:26</ref></char></note><verse eid="EXO 23:19" /></para>
  <para style="s">हुकूम आन खबर</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20" />“उनाआ, आंय एक देवदूत ताआ आगाड़ी आगाड़ी मोकलोहो जो वाटेमेहें ताआ राखवाली कोए, आन जिया जागाहा आंय तियार कोअयुहू तियामेहें ताहूं पोताड़ीहीं. <verse eid="EXO 23:20" /><verse number="21" style="v" sid="EXO 23:21" />तियाआ सामने सांबालीत रोजी, आन तियाआ मानजी, तियाआ विरोद मा कोअही, काहाके तो ताआ गुनाहां माफ ने कोए; याअकाजे के तियामेहें माआ नाव रोहे. <verse eid="EXO 23:21" /><verse number="22" style="v" sid="EXO 23:22" />जर तु खोराखर तियाआ मानिहीं आन जो किबी आंय कोहीं तो कोअही, ताहां आंय ताआ दुस्मोनोअ दुस्मोन आन विरोद कोअनाराआ विरोद कोअहीं. <verse eid="EXO 23:22" /><verse number="23" style="v" sid="EXO 23:23" />एहेंकोइत माआ देवदूत ताआ आगाड़ी आगाड़ी सालीत कोइत ताहूं एमोरी, हित्ती, परिज्जी, कनानी, हिव्वी, आन यबूसी माअहोंअ जागे पोताड़े, आन आंय तियांहां आरवीत टाकीहीं. <verse eid="EXO 23:23" /><verse number="24" style="v" sid="EXO 23:24" />तियांआं देवताआ पागे मा पोड़हा, आन तियांआं सेवा मा कोअहा, पोन तियांआं मुर्तीही फोड़ीत टाकजा, आन तियांआं देवोअ पाल्याहा फोड़ीत कोइत पुकरान पुकरा कोइत टाकजा. <verse eid="EXO 23:24" /><verse number="25" style="v" sid="EXO 23:25" />तु ताआ देवोअ यहोवाअ भक्ती कोअजी, ताहां तो ताआ रोटा पाअयोंपोअ आशिर्वाद आपे, आन ताआ विसमेहें रोत बिमारी सेटे कोए. <verse eid="EXO 23:25" /><verse number="26" style="v" sid="EXO 23:26" />ताआ देसोम कोड्लीज बोईंइ पोर्‍यो ने पोड़े आन ने वांज्यी रोय; आन ताआ वय आंय पुरी कोअहीं.”<verse eid="EXO 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 23:27" />“आन जेताहा माअहोंअ विसमेहें तु जाही तियां आखाअ मोनोमेहें आंय माआं बिक पेलरोतुज एहे कोइत पोई देहीं के ते पोंगलात जाये, आन ते आखे बित कोइत गुगदे वोले. <verse eid="EXO 23:27" /><verse number="28" style="v" sid="EXO 23:28" />आन आंय ताआ रोत पेल डांग्ये मोकलिहीं जें हिव्वी, कनानी, आन हित्ती माअहोंहों ताआ सामने रोत ओड़ीत काडे. <verse eid="EXO 23:28" /><verse number="29" style="v" sid="EXO 23:29" />आंय तियांहां ताआ सामने रोत एकाज वोरह्योमेहें ने काडो, एहेलोह ने ओवुहूं जोवे देस उजड़ीत जाय, आन रानठ्ये जनवारे वादीत कोइत ताहूं तारास देने वोले. <verse eid="EXO 23:29" /><verse number="30" style="v" sid="EXO 23:30" />जाअहूं जाआं तु ताआ गणती वादाड़ीत कोइत देसोहो ताआ सोताआ आधिकारोम ने कोइत लेहीं ताअहूं जाआं आंय तियांहां ताआ सामने रोत थोड़थोड़े कोइत काडतू रोहीं. <verse eid="EXO 23:30" /><verse number="31" style="v" sid="EXO 23:31" />आंय लाल दोर्‍याअहीं रोत पलिश्तीइ दोर्‍याआ जागे जाआं आन जंगलोअहीं रोत फरात नोयीइ जागर्‍युउ आखु मुलख ताआ ताबाम कोइ देहीं; आंय तिया देसोम रोनाराहा बी ताआ ताबाम कोइ देहीं, आन तु तियांहां ताआ सामने रोत आखाहा काडी देही. <verse eid="EXO 23:31" /><verse number="32" style="v" sid="EXO 23:32" />तु तियांअरी आन तियांआं देवताअरी शप्पत मा खाही. <verse eid="EXO 23:32" /><verse number="33" style="v" sid="EXO 23:33" />ते ताआ देसोम रोअहूं ने जोवे, जर रोये, ताहां तें ताहूं माआ विरुद्दाम पाप कोआड़े; आन जर तु तियांआं देवताआ भक्ती कोअही, ताहां ओं ताआ काजे फांदू बोणे.”<verse eid="EXO 23:33" /></para>
  <chapter eid="EXO 23" />
  <chapter number="24" style="c" sid="EXO 24" />
  <para style="s">यहोवा आन इस्राएलोअ विसमेहें शप्पत</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1" />फाशोअ तिये मोशेहे कोयो, “तु आरोन, नादाब, अबीहू आन इस्राएलोअ सत्तर डायहांअरी यहोवाआ जागे उसे आवीत सेटे रोत वोंदजा; <verse eid="EXO 24:1" /><verse number="2" style="v" sid="EXO 24:2" />मोशे एतुज यहोवाअ जागे आवुहूं जोवे; पोन बाकी माहें आहने ने आवुहूं जोवे. आन बिहरे माअहें तियाआ जागे उसे ने सोड़ुहूं जोवे.”<verse eid="EXO 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 24:3" />मोशे माअहोंअ जागे जात कोइत यहोवाअ आखी गोठी आन आखा नियम कोत आप्या. ताहां आखे माअहें एका आवाजोम कोने वोल्ये, “जेतीही गोठी यहोवा देवे कोयीही तियी आखी गोठीही आमू मानहूं.”<note caller="+" style="x"><char style="xo" closed="false">24:3 </char><char style="xt" closed="false"><ref loc="JOS 4:3">यहो 4:3</ref></char></note> <verse eid="EXO 24:3" /><verse number="4" style="v" sid="EXO 24:4" />ताहां मोशे यहोवाअ आखे वसने लेखीत देदे; आन रात्र्युउ उठीत कोइत डोगोअ निसे एक देवान्यो बोणायो आन इस्राएलोअ बारा पारवाड़ीइ परमाणे बारा खांबा बी बोणावया. <verse eid="EXO 24:4" /><verse number="5" style="v" sid="EXO 24:5" />ताहां तिये थोड़ाक इस्राएल जुवान्याहां मोकल्या, तियां यहोवा देवोअ काजे गाराहा कोइलोअ काजे हानो वासड़ो आगीइ गाराहा कोअयो. <verse eid="EXO 24:5" /><verse number="6" style="v" sid="EXO 24:6" />आन मोशे आरदो रक्त लेत कोइत वाटकामेहें मिक्यो, आन आरदो देवान्यापोअ हितड़ी देदो. <verse eid="EXO 24:6" /><verse number="7" style="v" sid="EXO 24:7" />ताहां शप्पतेए पुस्तकोहो लेत कोइत माअहुंहूं वासीत कोइत उनाड़्यो; तियाहा उनाइत कोइत तियें कोयो, “जों किबी यहोवा देवे कोयोहो तों आखो आमू कोअहूं, आन तियाआ आदेश मानहूं.”<verse eid="EXO 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 24:8" />ताहां मोशे रक्त लेत कोइत माअहूं पोअ हिपड़ी देदो, आन तियांहां कोयो, “पाला, ओं तिया शप्पतेए रक्त होय, जियाहा यहोवा या आखा वसनोपोअ तुमाअरी बांद्यीही.”<note caller="+" style="x"><char style="xo" closed="false">24:8 </char><char style="xt" closed="false"><ref loc="MAT 26:28">मत्तय 26:28</ref>; <ref loc="1CO 11:25">1 करिन्थ 11:25</ref></char></note><verse eid="EXO 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 24:9" />ताहां मोशे, आरोन, नादाब, अबीहू आन इस्राएलोअ सत्तर डायहां उसे डोगोपोअ गोया, <verse eid="EXO 24:9" /><verse number="10" style="v" sid="EXO 24:10" />तियां इस्राएलोअ देवोहो पाल्यो. तियाआ गुडाआ थुड़ी निलमणीइ पाट्लाआ होस जेहें कि तेबी ओतो, जो जुगोअ होस साफसुफ ओतो. <verse eid="EXO 24:10" /><verse number="11" style="v" sid="EXO 24:11" />आन तिये इस्राएलोअ मुख्यापोअ आथ ने उठाड़्यु; ताहां तियां देवोअ दर्शन कोअयो, आन खादोन पिदो.<verse eid="EXO 24:11" /></para>
  <para style="s">सिनाय डोगोपोअ मोशे</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12" />ताहां यहोवा मोशेहे कोयो, “डोगोपोअ माआ जागे सोड़ीत आव आन तिहीं रो; आंय ताहूं डोणोअ पाटी, आन माहें सिकाय तेहें काजे आंय लेखल्यू नियम आन आदेश आपीही.” <verse eid="EXO 24:12" /><verse number="13" style="v" sid="EXO 24:13" />ताहां मोशे यहोशवा नावोअ तियाआ सेवकोअरी देवोअ डोगोपोअ सोड़ीत लागू. <verse eid="EXO 24:13" /><verse number="14" style="v" sid="EXO 24:14" />आन डायहांहां बी तो ओं कोत कोइत गोयु, “जाअहूं जाआं आमू तुमाआ जागे फाशाअ ने आवो ताअहूं जाआं तुमू इंहीं आमाआ वाट पाल्या कोअजा; आन उनाआ, आरोन आन हूर तुमाअरी होय; जर एखाआ भान्गड़ ओत जाय, ताहां तियांआं जागे जाजा.”<verse eid="EXO 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 24:15" />ताहां मोशे डोगो पोअ सोढ़ीत लागू, आन वादलो डोगोहो टापित लेदो. <verse eid="EXO 24:15" /><verse number="16" style="v" sid="EXO 24:16" />ताहां यहोवाआ महिमा सिनाय डोगोपोअ सेवात गोयी, आन तों वादलो सोव दिही जाआं टापाइत रोयो; आन हांतवा दिही तिये मोशेहे वाद्लाआ विसमेहें रोत गोगाड़्यो. <verse eid="EXO 24:16" /><verse number="17" style="v" sid="EXO 24:17" />डोगोअ सुटीपोअ यहोवाआ महिमा इस्राएलोअ नजरेमेहें हांगाड़ाआ होस देखाअयीते. <verse eid="EXO 24:17" /><verse number="18" style="v" sid="EXO 24:18" />ताहां मोशे वाद्लाआ विसमेहें रोत डोगो पोअ सोड़ीत लागू. आन मोशे डोगो पोअ सालिही दिही आन सालिही रात रोयू.<note caller="+" style="x"><char style="xo" closed="false">24:18 </char><char style="xt" closed="false"><ref loc="DEU 9:9">कायदा 9:9</ref>; <ref loc="MAT 4:2">मत्तय 4:2</ref></char></note><verse eid="EXO 24:18" /></para>
  <chapter eid="EXO 24" />
  <chapter number="25" style="c" sid="EXO 25" />
  <para style="s">सोका जागाआ काजे भेट</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1" />यहोवा मोशेहे कोयो, <verse eid="EXO 25:1" /><verse number="2" style="v" sid="EXO 25:2" />“इस्राएलोहो ओ कोजा के माआ काजे भेट लेतावे; जेतेहे तियांआं इश्शा वाअहीं आपिइलोअ कोए तियां आखा पोअ रोत माआ भेट लेजा. <verse eid="EXO 25:2" /><verse number="3" style="v" sid="EXO 25:3" />आन जियी वस्तुउ भेट तियांपोअ रोत लेअलोअ होय ते ए होय; मोन्जे होनो, सांदी, तांबो, <verse eid="EXO 25:3" /><verse number="4" style="v" sid="EXO 25:4" />निलो, जामण्यो, आन रात्ला रंगोअ कापड़, पात्ला हुतोअ कापड़, बोकड़ाआ सिंग्ये, <verse eid="EXO 25:4" /><verse number="5" style="v" sid="EXO 25:5" />रात्ला रंगोवाअहीं रंगल्यो, जाट्याल मेडाआ सांबड़ो, सुस नावोअ वोडा मासाआ, बाबल्योअ साड़, <verse eid="EXO 25:5" /><verse number="6" style="v" sid="EXO 25:6" />दिवाआ काजे तेल, अभिशेकोअ तेल आन हाजो गोंदाय तेहें गोंदाण्यो तेल, <verse eid="EXO 25:6" /><verse number="7" style="v" sid="EXO 25:7" />एपोदोमेहें<note caller="+" style="f"><char style="fr" closed="false">25:7 </char><char style="fq" closed="false">एपोद </char><char style="ft" closed="false">एकी जातीइ खास पुंजाराआ पेवीइलोअ डोगलो</char></note> आन सातीइ पोट्टामेहें लागाड़ीलोअ काजे सुलेमानी डोणोअ मोंड्ये. <verse eid="EXO 25:7" /><verse number="8" style="v" sid="EXO 25:8" />तें माआ वोतीइ एक सोकु मंडप बांदे ताहां तियामेहें आय रोहीं. <verse eid="EXO 25:8" /><verse number="9" style="v" sid="EXO 25:9" />जो किबी आंय ताहूं देखाड़ोहो, मोन्जे रोअलोअ जागू आन तियाआ आखा सामानोअ नमुनू, तियाआ होस तुमू माअहें तियाहा बोणावजा.”<verse eid="EXO 25:9" /></para>
  <para style="s">करारोअ पेटी</para>
  <para style="r">(<ref loc="EXO 37:1-9">निर्ग 37:1-9</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10" />“बाबल्याआ साड़ोअ एक वायदाआ पेटी बोणावजा; ते आड़ीस आथ नांबी आन पोली डेड़ आथ आन उसी डेड़ आथ जोवे. <verse eid="EXO 25:10" /><verse number="11" style="v" sid="EXO 25:11" />आन तियीही सोका होना वाअहीं मायतेन बाअथे मोडाड़जा, आन पेटीइ उपोअ शारु वोलेहे होनाआ कोर बोणावजा. <verse eid="EXO 25:11" /><verse number="12" style="v" sid="EXO 25:12" />तिहीं रोत तियां शारु गुडापोअ, होनाआ शार कोड़ी टाकाड़ीत कोइत एकी वोलेहे बेन आन एकी वोलेहे लागाड़ी देजा. <verse eid="EXO 25:12" /><verse number="13" style="v" sid="EXO 25:13" />फाशाआ बाबल्योअ लाकड़ाआ डेंगारा बोणावीत लेजा, आन तियांहां बी होना वाअहीं मोडाड़जा. <verse eid="EXO 25:13" /><verse number="14" style="v" sid="EXO 25:14" />आन डेंगाराहा पेटीइ बेनी वोलेहे कोड़ीमेहें टाकीत लेजा. जिया वाअहीं तियाआ वजन उसलीइता आवे. <verse eid="EXO 25:14" /><verse number="15" style="v" sid="EXO 25:15" />ते डेंगारा पेटीइ कोड़ीमेहें रोअहूं देजा; आन तियाहा अलग मा कोअहा. <verse eid="EXO 25:15" /><verse number="16" style="v" sid="EXO 25:16" />आन आंय जो ताहूं साक्शीपत्र आपिहीं तियाहा तियी पेटीमेहें मिकजी.”<verse eid="EXO 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 25:17" />“फाशोअ सोका होनाआ एक टापणो बोणावजा; तों आड़ीस आथ नांबो जोवे, आन पोलो डेड़ आथोअ जोवे. <verse eid="EXO 25:17" /><verse number="18" style="v" sid="EXO 25:18" />आन होनो टाकीत कोइत बेन फाकावाला देवदूत बोणावीत कोइत दयासनोअ टापणाआं बेनू वोल मिकाड़जी. <verse eid="EXO 25:18" /><verse number="19" style="v" sid="EXO 25:19" />एक करुब<note caller="+" style="f"><char style="fr" closed="false">25:19 </char><char style="fq" closed="false">करुब </char><char style="ft" closed="false">एकी जातीइ फाकावालू देवदूत</char></note> एकी मेरे आन बिहीरु करुब एकी मेरेपोअ मिकाड़जी; आन देवदूतोहो आन दयासनोअ टापणाहा नेहें एकाज तुकाड़ा वाअहीं बोणावीत कोइत तियाआ बेनू वोल पोअ मिकाड़जी. <verse eid="EXO 25:19" /><verse number="20" style="v" sid="EXO 25:20" />तियां करुबोअ फाके उपोअ रोत एहेलेहे पोलावीत रोल्ये जेहें बोणावजा के दयासनोअ टापणो तियांआं वाअहीं टापाअलो रोअहूं जोवे, आन तियांआं सोब हुंबरा हुंबर आन दयासनोअ टापणाआ वोगेहे रोअहूं जोवे. <verse eid="EXO 25:20" /><verse number="21" style="v" sid="EXO 25:21" />आन तिया टापणाहा पेटीपोअ लागाड़जा; आन जों साक्शीपत्र आंय ताहूं आपीहीं तियाहा तु पेटीइ मायते मिकजी. <verse eid="EXO 25:21" /><verse number="22" style="v" sid="EXO 25:22" />आंय तियाआ उपोअ रोत कोइत ताहूं मिल्या कोअहीं; आन इस्राएलवालाआ काजे जेताहा कायदा माहूं ताहूं आपीइलोअ ओय, तियां आखाअ बाप्तिमेहें दयासनोअ टापणापोअ रोत तियां देवदूतोअ विसमेहें रोत, जों साक्शी पत्राआ पेटीपोअ ओय, ताअरी गोठी कोअया कोअहीं.”<verse eid="EXO 25:22" /></para>
  <para style="s">सोकू टेबल</para>
  <para style="r">(<ref loc="EXO 37:10-16">निर्ग 37:10-16</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23" />“फाशोअ बाबल्योअ लाकड़ाआ एक पवित्र टेबल बोणावजा; तियाहा बेन आथ नांबू, एक आथ सोवड़ू, आन डेड़ आथोअ उसू रोअहूं जोवे. <verse eid="EXO 25:23" /><verse number="24" style="v" sid="EXO 25:24" />तियाहा सोका होना वाअहीं मोडाड़जी, आन तियाआ शारु वोलेहे होनाआ वाड़ बोणावजी. <verse eid="EXO 25:24" /><verse number="25" style="v" sid="EXO 25:25" />आन तियाआ शारु वोगेहे शार आंगली सोवड़ी एक कोर बोणावजी, आन तियी कोरीइ शारु वोगेहे होनाआ एक वाड़ बोणावजा. <verse eid="EXO 25:25" /><verse number="26" style="v" sid="EXO 25:26" />आन होनाआ शार कोड़ी बोणावीत कोइत टेबलोअ तिया शारु खुणाआ वोल बोहाड़ुहूं लागाड़जा जे तियाआ शारु पायामेहें रोय. <verse eid="EXO 25:26" /><verse number="27" style="v" sid="EXO 25:27" />ते कोड़ी कोरीइ जागेज जोवे, ताहां डेंगारा वाअहीं टेबलोअ वोजू वोहीइलोअ काजे तियीं कोड़ीमेहें वातडू बोहुंहूं जोवे. <verse eid="EXO 25:27" /><verse number="28" style="v" sid="EXO 25:28" />बाबल्योअ लाकड़ाआ डांडू बोणावीत कोइत होना वाअहीं मोडाड़जी, आन टेबल तियाज वाअहीं आखलुहूं जोवे. <verse eid="EXO 25:28" /><verse number="29" style="v" sid="EXO 25:29" />आन तियाआ पारात, तुमाणाआ सादन, जेग आन वाटका, आखो सोका होनाआ बोणावजी. <verse eid="EXO 25:29" /><verse number="30" style="v" sid="EXO 25:30" />आन टेबलोपोअ माआ आगाड़ी भेटेए रोटा कायम मिकजा.”<note caller="+" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="LEV 24:5-8">लेवी 24:5-8</ref></char></note><verse eid="EXO 25:30" /></para>
  <para style="s">दिवू मिकीइलाआ होनाआ खांब</para>
  <para style="r">(<ref loc="EXO 37:17-24">निर्ग 37:17-24</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31" />“फाशुउ सोका होनाआ एक खांबू बोणावाड़जी. होनो टाकाड़ीत कोइत तिया खांबाआ थुड़ो डांडाअरीज बोणावहूं लागाड़जी; तियाआ फुलोअ गुंबरु, आन पेर आन फुल, आखो एकाज तुकड़ा वाअहीं बोणुहूं जोवे; <verse eid="EXO 25:31" /><verse number="32" style="v" sid="EXO 25:32" />आन तिया मेरे रोत सोव डाली निहे, तिन डाली ते खांबाआ एकी वोल आन तिन डाली तियी बिहीरी वोल निहील्यी जोवे; <verse eid="EXO 25:32" /><verse number="33" style="v" sid="EXO 25:33" />एकेकी डालीमेहें बादामोअ फुलोअ होस तिन तिन फुलोअ डुड्ड्याआ एक गाठ, आन एक एक फुल जोवे; दिवू मिकीइलोअ खांबाम रोत निहील्यी सोव डालीइ ओ आकार रुप जोवे; <verse eid="EXO 25:33" /><verse number="34" style="v" sid="EXO 25:34" />आन दिवाआ खांबामेहें बादामोअ फुलोअ होस शार फुलोअ पेर जोवे आन ते पेर फुलोअ होस जोवे; <verse eid="EXO 25:34" /><verse number="35" style="v" sid="EXO 25:35" />आन दिवाम रोत निहील्यी सोव डाली जोवे. तियीम रोत बेन बेन डालीइ निसे एक एक खांद जोवे, तों दिवाआ खांबाअरी एकुज तुकड़ाआ बोणल्यो जोवे. <verse eid="EXO 25:35" /><verse number="36" style="v" sid="EXO 25:36" />तियांआं पेर आन डाली, आखे दिवाअरीज एकाज तुकाड़ाआ जोवे, सोको होनो टाकाड़ीत कोइत आखु दिवू एकाज तुकाड़ाआ बोणावाड़जा. <verse eid="EXO 25:36" /><verse number="37" style="v" sid="EXO 25:37" />आन हांत दिवा बोणावाड़जा; आन दिवा पेटाड़जा के ते दिवाआ आगाड़ीइ भागोम उजालो आपे. <verse eid="EXO 25:37" /><verse number="38" style="v" sid="EXO 25:38" />ईंगाआ विसीइलोअ सिपटू आन ठाली एं बी सोका होनाआ जोवे. <verse eid="EXO 25:38" /><verse number="39" style="v" sid="EXO 25:39" />तों आखो सामान लगभग शोवतीस किलो सोका होनाआ बोणावुहूं जोवे. <verse eid="EXO 25:39" /><verse number="40" style="v" sid="EXO 25:40" />आन वारुहूं मोन लागाड़ीत यी आखी वोस्तुहू तियाआ नमुनाआ होस बोणावाड़जा. जो ताहूं डोगोपोअ देखाड़्युहू.”<note caller="+" style="x"><char style="xo" closed="false">25:40 </char><char style="xt" closed="false"><ref loc="ACT 7:40">प्रेशित 7:40</ref>; <ref loc="ACT 8:5">8:5</ref></char></note><verse eid="EXO 25:40" /></para>
  <chapter eid="EXO 25" />
  <chapter number="26" style="c" sid="EXO 26" />
  <para style="s">देवोअ हजरीइ तोंबू</para>
  <para style="r">(<ref loc="EXO 36:8-38">निर्ग 36:8-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1" />“फाशोअ देवोअ हजरीइ तोंबाआ काजे दोहो पोड़दा बोणावाड़जी; तियांहां निला, जामण्या आन रात्ला हुतो वाअहीं हिंवल्या हाना हुतोअ दोहो तुकड़ाम रोत तिया रंगोअ हुतो वाअहीं बोणावाड़जी. <verse eid="EXO 26:1" /><verse number="2" style="v" sid="EXO 26:2" />एकेक पोड़दू विहीन आंठ आथ पोलू शार आथ जोवे: आखा पोड़दा एकाज मापोअ जोवे. <verse eid="EXO 26:2" /><verse number="3" style="v" sid="EXO 26:3" />पास पोड़दा एकमेकाअरी जुड़ल्या जोवे; फाशाआ ए जे बाकी पास पोड़दा रोय तेबी एकमेकाअरी जुड़ल्या जोवे. <verse eid="EXO 26:3" /><verse number="4" style="v" sid="EXO 26:4" />आन जिहीं ए पोड़दा जुड़ात जाये तिहींइ बेनू मेरेपोअ निले फुन्दे लागाड़जा <verse eid="EXO 26:4" /><verse number="5" style="v" sid="EXO 26:5" />बेनू कोरेपोअ पोन्नास पोन्नास फुन्दे एहलेहे लागाड़जा जे ते हुंबरा हुंबर ओय. <verse eid="EXO 26:5" /><verse number="6" style="v" sid="EXO 26:6" />आन होनाआ पोन्नास आकाड़ा बोणावाड़जा; आन तिया पोड़दाहा तियांज आकाड़ा वाअहीं एक बिहीराहा जुड़जा के तोंबु एक बोणे.”<verse eid="EXO 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7" />“फाशोअ रोअलाअ तोंबापोऱ्याआ तोंबाआ काजे बोकड़ाआ सिंग्याआ ईग्यार पोड़दा बोणावाड़जा. <verse eid="EXO 26:7" /><verse number="8" style="v" sid="EXO 26:8" />एकेक पोड़दू तीस आथ नांबू आन शार आथ पोलू जोवे; ईग्यार पोड़दा एकाज मापोअ जोवे. <verse eid="EXO 26:8" /><verse number="9" style="v" sid="EXO 26:9" />पास पोड़दा आंगेज आन फाशाआ सोव पोड़दा आंगेज जुड़वुहूं लागाड़जा, आन साहावा पोड़दाहा तोंबाआ आगाड़ी मुउड़ीत कोइत वाली देजा. <verse eid="EXO 26:9" /><verse number="10" style="v" sid="EXO 26:10" />आन तु पोन्नास आकड़ा तिया पोड़दाआ मेरेए भागोम रोत जो बाअथे रोत जोड़े आन पोन्नास आकड़ा बिहीरी वोग रोत पोड़दाआ मेरेए भागोम रोत जो बाअथे रोत जोड़ता आवे एहेलोहो बोणावाड़जा. <verse eid="EXO 26:10" /><verse number="11" style="v" sid="EXO 26:11" />आन इसत्लेए पोन्नास आकड़ा बोणावजा, आन आकड़ाहा फुन्दामेहें लागाड़ीत कोइत तोंबाहा जुड़जा के तो जुड़ात एक ओत जाय. <verse eid="EXO 26:11" /><verse number="12" style="v" sid="EXO 26:12" />आन तोंबाआ पोड़दाहा लटकीइल्यु भाग, मोन्जे जो आरदू भाग रोय, तो तोंबाआ सेवट्याआ भागोम लागीत रोय. <verse eid="EXO 26:12" /><verse number="13" style="v" sid="EXO 26:13" />आन तोंबाआ पोड़दाआ लांबीम रोत आथ पोइत कोइत इंहीं, आन आथ पोइत कोइत तिहीं मोंडपोहो टापीइलोअ काजे तियाआ बेनू वोल टांगाइत रोल्यो जोवे.”<verse eid="EXO 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 26:14" />“ताहरोअ तोंबाआ काजे रात्ला रंगोवाअहीं मेडाआ वातड़ा सांबड़ाआ टापीइलोअ वस्तु बोणावजा आन सुस नावोअ मासाआ सांबड़ाआ बी एक फांगीइलोअ बोणावजी.<verse eid="EXO 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 26:15" />“फाशोअ रोअलाआ मोंडपोहो उबो कोइलोअ काजे बाबल्योअ लाकड़ाआ रिपे बोणावाड़जा. <verse eid="EXO 26:15" /><verse number="16" style="v" sid="EXO 26:16" />एकेक सोवकट दोहो आथ नांबी आन डेड़ आथ सोवड़ी जोवे. <verse eid="EXO 26:16" /><verse number="17" style="v" sid="EXO 26:17" />एकेका रिपामेहें रोत एक बिहीराहा जुड़ल्याज बेन बेन डुसा जोवे; तोंबापोअ आखा रिपाहा एहें कोइत बोणावाड़जा. <verse eid="EXO 26:17" /><verse number="18" style="v" sid="EXO 26:18" />मंडपोअ काजे जे रिपे तु बोणावाड़ीही तियांम रोत विही रिपे ते देहामोअ वोल जोवे; <verse eid="EXO 26:18" /><verse number="19" style="v" sid="EXO 26:19" />आन विही रिपाआ निसे सांदीइ सालीही कुर्सी बोणावाड़जी, मोन्जे एक एका रिपाआ निसे तियाआ बोहीइलोअ काजे बेन बेन कुर्सी जोवे. <verse eid="EXO 26:19" /><verse number="20" style="v" sid="EXO 26:20" />मंडपोअ बिहीरी वोगेहे मोन्जे पालामाअहें काजे विही रिपे बोणावाड़जा; <verse eid="EXO 26:20" /><verse number="21" style="v" sid="EXO 26:21" />आन तियांआं काजे सालिही सांदीइ पाया बोणावाड़जा, मोन्जे एक एका रिपाआ निसे बेन बेन पाया जोवे. <verse eid="EXO 26:21" /><verse number="22" style="v" sid="EXO 26:22" />मंडपोअ फासाड़ी वोल, बुट्टामा भागोअ काजे सोव पाट्ये बोणावाड़जा. <verse eid="EXO 26:22" /><verse number="23" style="v" sid="EXO 26:23" />आन फासाड़ी भागोअ तोंबाआ खुणाआ काजे बेन पाट्ये बोणावाड़जी; <verse eid="EXO 26:23" /><verse number="24" style="v" sid="EXO 26:24" />आन ते निसे रोत बेन बेन भागोअ जोवे, आन बेनू भाग उपऱ्याआ मुन्काअहीं जाआं एक एका आकड़ामेहें जुड़ात जाये; बेनू रिपाआ ओज आकार जोवे; ए बेनू खुणाआ काजे रोय. <verse eid="EXO 26:24" /><verse number="25" style="v" sid="EXO 26:25" />आन आंठ रिपे जोवे, आन तियाआ सांदीइ होल कुर्सी रोय; मोन्जे एक एका रिपाआ निसे बेन बेन कुर्सी रोय.”<verse eid="EXO 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 26:26" />“फाशोअ बाबल्योअ लाकड़ाआ पास आडवा डांडा बोणावजा, मोन्जे मंडपोअ एकी वोल रिपाआ काजे पास, <verse eid="EXO 26:26" /><verse number="27" style="v" sid="EXO 26:27" />आन मंडपोअ बिहीरी वोल रिपाआ काजे पास डांडा, आन रोअलाअ जो भाग बुट्टामाअहें फासाड़ी वोल रोये, तियाआ काजे पास आडवा डांडा बोणावजा. <verse eid="EXO 26:27" /><verse number="28" style="v" sid="EXO 26:28" />विसमेऱ्याआ आडवा डांडा जो रिपाआ विसमेहें ओय तो तोंबाआ एकी मेरे रोत ते बिहीरी मेरे जाआं पोते. <verse eid="EXO 26:28" /><verse number="29" style="v" sid="EXO 26:29" />फाशोअ रिपाहा होना वाअहीं मोडाड़जा, आन तियाआ आकड़ा जे आडवा डांडाहां वातड़ो कोइत रोय तियांहां बी होनाअ वाअहीं मोडाड़जा; आन आडवा डांडाहां बी होना वाअहीं मोडाड़जा. <verse eid="EXO 26:29" /><verse number="30" style="v" sid="EXO 26:30" />आन रोअलोअ तोंबाआ जागाहा एहें कोइत बांदजा के जेहेलोहो आंय ताहूं या डोगो पोअ देखाड़्योहो.”<verse eid="EXO 26:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31" />“फाशोअ निला, जामण्या आन रात्ला रंगोअ आन पात्ला हुतोअ बोणावल्या साअका वाअहीं एक विसमेऱ्युउ पोड़दू गुथीत कोइत बोणावाड़जा; तियापोअ वारुहूं करुबोअ सित्रे बोणावजा. <verse eid="EXO 26:31" /><verse number="32" style="v" sid="EXO 26:32" />आन तियाहा होना वाअहीं मोडाड़ल्या बाबल्योअ लाकड़ाआ शार खांबोपोअ टांगजा, तियाआ आकड़ा होनाआ जोवे, आन ते सांदीइ शार कुर्सी पोअ उबा रोअहूं जोवे. <verse eid="EXO 26:32" /><verse number="33" style="v" sid="EXO 26:33" />आन विसमेऱ्याआ पोड़दाहा आकड़ीइ निसे आलवीत कोइत, तिया विसमेहें साक्शी पत्राआ पेटीइ मायते लेत जाजा, एहें कोइत तो विसमेऱ्युउ पोड़दू तुमाआ काजे सोका जागाहा जाअखा सोका जागा रोत आलाग कोइत रोअहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">26:33 </char><char style="xt" closed="false"><ref loc="HEB 6:19">इब्री 6:19</ref>; <ref loc="HEB 9:3-5">9:3-5</ref> </char></note> <verse eid="EXO 26:33" /><verse number="34" style="v" sid="EXO 26:34" />फाश्योअ वादार सोका जागाम साक्शीइ पेटीपोअ दयासनोअ टापणो मिकजा. <verse eid="EXO 26:34" /><verse number="35" style="v" sid="EXO 26:35" />आन तिया पोड़दाआ बारथे आराम कोइलाआ पालामाअहें पांगात मिकजा; आन तियाआ देहामाअहें टेबलोअ हुंबर दिवू मिकजा.”<verse eid="EXO 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 26:36" />“फाशोअ तोंबाआ बाअणाआ काजे निला, जामण्या आन रात्ला रंगोअ आन पात्ला हुतोअ बोणावल्या साअका वाअहीं जिया पोअ सित्रे काड्ये ओय, एक पोड़दू बोणावजा. <verse eid="EXO 26:36" /><verse number="37" style="v" sid="EXO 26:37" />आन या पोड़दाआ काजे बाबल्योअ पास खांब बोणावजा, आन तियांहां होना वाअहीं मोडाड़जा; तियांआं आकड़ा होनाअ जोवे, आन तियांआं काजे तांबाअ पास कुर्सी टाकाड़ीत कोइत बोणावजा.”<verse eid="EXO 26:37" /></para>
  <chapter eid="EXO 26" />
  <chapter number="27" style="c" sid="EXO 27" />
  <para style="s">गाराहा आपिलोअ देवान्यो</para>
  <para style="r">(<ref loc="EXO 38:1-7">निर्ग 38:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1" />“फाश्योअ देवान्यो बाबल्योअ लाकड़ाआ, पास आथ नांबी आन पास आथ पोली बोणावजी; देवान्यो शार खुण्यो जोवे, आन तियाआ उसी तिन आथोअ जोवे. <verse eid="EXO 27:1" /><verse number="2" style="v" sid="EXO 27:2" />आन तियाआ शारु खुणापोअ शार हिंग बोणावजा; तो एकुज तुकड़ाआ जोवे, आन तियाहा तांबाआ वाअहीं मोडाड़जा. <verse eid="EXO 27:2" /><verse number="3" style="v" sid="EXO 27:3" />आन तियाआ खाँआं विसीइलोअ बासन, पावड़ो, वाटकी, दाताल पावड़ो, सुपड़ी बोणावजा; तियाआ आखो सामान इसत्लेए बोणावाड़जा. <verse eid="EXO 27:3" /><verse number="4" style="v" sid="EXO 27:4" />तियाआ काजे इसत्लेए जालीइ एक सारी बोणावाड़जी; आन तियाआ शारी वोल मुन्कापोअ इसत्लेए शार आकड़ा लागाड़जी. <verse eid="EXO 27:4" /><verse number="5" style="v" sid="EXO 27:5" />आन तियी इसत्लेए सारीही देवान्याआ शारी वोल सुटीइ निसे एहें कोइत लागाड़ावजी के तो देवान्याआ उसेए पोरापोर जाआं पोते. <verse eid="EXO 27:5" /><verse number="6" style="v" sid="EXO 27:6" />आन देवान्याआ काजे बाबल्योअ लाकड़ाआ डांडू बोणावजा, आन तियांहां तांबाअ वाअहीं मोडाड़जा. <verse eid="EXO 27:6" /><verse number="7" style="v" sid="EXO 27:7" />आन डांडू कोड़ीमेहें टाकजा के जाहां जाहां देवान्यो उसलीइलोअ वेल आवे ताहां ताहां ते तियाआ बेनू मेरेपोअ रोय. <verse eid="EXO 27:7" /><verse number="8" style="v" sid="EXO 27:8" />देवान्याहा रिपे मेकीत कावलो बोणावजा; जेहेलोहो तो या डोगोपोअ ताहूं देखाड़्योहो तेहेलोज बोणावजा.”<verse eid="EXO 27:8" /></para>
  <para style="s">तोंबाआ जागाअ खोली</para>
  <para style="r">(<ref loc="EXO 38:9-20">निर्ग 38:9-20</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9" />“फाश्योअ रोअलाअ खोली बोणावजा. तियाआ देहामाआ भागोअ काजे पात्ला हुतो बोणल्यो साअकाआ पोड़दू जोवे, तियाआ नांबी होव आथोअ जोवे; एके मेरे एतोज जोवे. <verse eid="EXO 27:9" /><verse number="10" style="v" sid="EXO 27:10" />आन तियाआ काजे विही खांब बोणे, आन तियांआं काजे इसत्लेए विही कप्पा बोणे, आन खांबोअ कुंडे आन तियांआं पोट्टी सांदीइ जोवे. <verse eid="EXO 27:10" /><verse number="11" style="v" sid="EXO 27:11" />आन एहें कोइत खोलीइ पालामाआ वोल लांबीमेहें बी होव आथ नांबी पोड़दा जोवे, आन तियांआं काजे बी विही खांबे आन तियांआं काजे तांबाअ विही कप्पा जोवे; आन तियाआ खांबोअ कुंडे आन पोट्टी सांदीइ जोवे. <verse eid="EXO 27:11" /><verse number="12" style="v" sid="EXO 27:12" />फाश्योअ पोली खोलीइ काजे बुड्तामाआ वोलेहे बावीस मीटर नांबा पोड़दा जोवे, तियांआं काजे दोहो खांबे आन कप्पा बी दोहो जोवे. <verse eid="EXO 27:12" /><verse number="13" style="v" sid="EXO 27:13" />उगता वोल खोली पोली पोन्नास आथोअ जोवे. <verse eid="EXO 27:13" /><verse number="14" style="v" sid="EXO 27:14" />खोलीइ बाअणाअ वोल पोनर आथोअ पोड़दा जोवे, आन तियांआं काजे खांब तिन आन कप्पा तिन जोवे; <verse eid="EXO 27:14" /><verse number="15" style="v" sid="EXO 27:15" />आन बिहीरी वोल बी पोनर आथोअ पोड़दा जोवे, तियांआं काजे बी खांबे तिन आन कप्पा तिन जोवे. <verse eid="EXO 27:15" /><verse number="16" style="v" sid="EXO 27:16" />खोलीइ बाअणाआ काजे एक पोड़दू बोणावजा, जो निलू, जामण्यु आन रात्ला रंगोअ पात्ला हुतोअ साअकाआ बोणल्यू पोड़दू विही आथोअ जोवे, तियाआ काजे खांबे शार आन कप्पा बी शार जोवे. <verse eid="EXO 27:16" /><verse number="17" style="v" sid="EXO 27:17" />खोलीइ शारु वोल आखे खांबे सांदीइ पोट्टीही जोड़ात रोल्ये जोवे, तियांआं आकड़ा सांदीइ आन कप्पा तांबाआ जोवे. <verse eid="EXO 27:17" /><verse number="18" style="v" sid="EXO 27:18" />खोली होव आथ नांबी पोन्नास आथ पोली, आन तियाआ पोड़दू पास आथ उसू जोवे, आन तो पोड़दू पात्ला हुतोअ बोणल्यू जोवे, खांबोअ कुर्सी तांबाआ जोवे. <verse eid="EXO 27:18" /><verse number="19" style="v" sid="EXO 27:19" />रोअलो जागाअ कोअते राज्या राज्यामेहें बासने आन आखो सामान आन तियाआ आखा खुटा आन खोलीइ बी आखा खुटा तांबाआज जोवे.”<verse eid="EXO 27:19" /></para>
  <para style="s">दिवाआ देखबाल</para>
  <para style="r">(<ref loc="LEV 24:1-4">लेवी 24:1-4</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20" />“फाश्योअ तु इस्राएलोहो आदेश आपजी, के माआ जागे दिवाआ काजे कुटीत कोइत काडल्यो जेयतुनोअ हाजो तेल लेत आवजा, जिया वाअहीं दिवू हादाफल पेटाअतु रोय. <verse eid="EXO 27:20" /><verse number="21" style="v" sid="EXO 27:21" />देवोअ हजरीइ तोंबामेहें, तिया विसमेऱ्याआ पोड़दा वाअहीं बाअथे जो साक्शीपत्राअ आगाड़ी ओय, आरोन आन तियाआ पोऱ्ये दिवू हांजेए वेले रोत ते वेगीइ जाआं यहोवा देवोअ आगाड़ी होबाड़ीत मिके. ए विधी इस्राएलोअ काजे हादाजलमीइ बोणित रोय.”<verse eid="EXO 27:21" /></para>
  <chapter eid="EXO 27" />
  <chapter number="28" style="c" sid="EXO 28" />
  <para style="s">पुंजाराआ काजे सोके आंगड़े</para>
  <para style="r">(<ref loc="EXO 39:1-7">निर्ग 39:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1" />“फाश्यो तु इस्राएलोम रोत ताआ पाही आरोन, आन नादाब, अबीहू, एलाजार आन ईतामार नावोअ तियाआ पोर्‍याहा माआ काजे पुंजाराआ काम कोए तेहें ताअरी लेतावजी. <verse eid="EXO 28:1" /><verse number="2" style="v" sid="EXO 28:2" />आन ताआ पाही आरोनोअ काजे मानपान आन होबाआ कोअते सोके आंगड़े बोणावजी. <verse eid="EXO 28:2" /><verse number="3" style="v" sid="EXO 28:3" />आन जेत्ता जोआं बुद्दीवाला कारागीर होय, जियांहां आंय बुद्दी आपनारा आत्मा वाअहीं पुरा पोअयाहा, तियांहां तु आरोनोअ आंगड़े बोणावीइलाआ आदेस आप के तो माआ काजे पुंजाराआ काम कोइलाआ काजे सोका बोणुहूं जोवे. <verse eid="EXO 28:3" /><verse number="4" style="v" sid="EXO 28:4" />जे आंगड़े तियांहां बोणावीलोअ होय ते एं होय, मोन्ज्ये सातीइ पट्टू, आन एपोद<note caller="+" style="f"><char style="fr" closed="false">28:4 </char><char style="fq" closed="false">एपोद </char><char style="ft" closed="false">एकी जातीइ उसे रोत निसे गुडाअहीं जाआं पेवीइलोअ पुंजाराआ नांबो आंगड़ो.</char></note>, आन कोट, आन शार खुण्यो नांबो आंगड़ो, पागड़ी आन पोट्टू; एं सोके आंगड़े ताआ पाही आरोन आन तियाआ पोर्‍याआ कोअते बोणावजी के ते माआ कोअते पुंजाराआ काम कोए. <verse eid="EXO 28:4" /><verse number="5" style="v" sid="EXO 28:5" />आन ते होनाअ आन निला जामण्या आन रात्ला रंगोअ आन पात्ला हुतोअ कापड़ लेजा.”<verse eid="EXO 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 28:6" />“तो एपोदोहो होना आन निला, जामण्या आन रात्ला रंगोअ कपड़ाआ आन पात्ला हुतोअ कपड़ाआ बोणावजा, जो हाजा कारागिरोअ काम कोअनाराआ आथोअ काम जोवे. <verse eid="EXO 28:6" /><verse number="7" style="v" sid="EXO 28:7" />तो एहें कोइत जोड़ाअहूं जोवे के तियाआ बेनू खांदपोट्टाआ सेड़ा एकमेकाअरी जुड़ात रोय. <verse eid="EXO 28:7" /><verse number="8" style="v" sid="EXO 28:8" />आन एपोद बांदीइलाआ काजे बोणावल्यी जे पट्टी तियाआ बोणावट तियाआ होसुज जोवे, आन आरी लागतीज जोवे, आन होनाआ आन निलो, जामण्यो आन रात्ला रंगोवाले आन पात्ला हुतोअ कपड़ाआ जोवे. <verse eid="EXO 28:8" /><verse number="9" style="v" sid="EXO 28:9" />फाशेए बेन सुलेमानी मोंड्या लेत कोइत तियांपोअ इस्राएलोअ पोर्‍याआ नाव कोरवीइजा, <verse eid="EXO 28:9" /><verse number="10" style="v" sid="EXO 28:10" />तियांआं नावो मेहें रोत सोव नावे एका मोंड्या पोअ, बिहीरा पोअ सोव, एहें कोइत इस्राएलोअ पोर्‍याअ जल्माआ पुरमाणे कोरवीइजा. <verse eid="EXO 28:10" /><verse number="11" style="v" sid="EXO 28:11" />मोंड्या कोरवीइनाराआ कामोंअ होस जेहें कोइत सापू कोरवीइतेहे, तेहेंज कोइत तियां बेन मोंड्या पोअ इस्राएलोअ पोर्‍याआ नावे कोरवीइजा; आन तियांहां होनाआ कप्पा कप्पामेहें जुड़ी देजा. <verse eid="EXO 28:11" /><verse number="12" style="v" sid="EXO 28:12" />आन बेनू किड़्याहा एपोदोअ बेनू खांदपोट्टीपोअ लागाड़जा, ते इस्राएलोअ ओर कोआड़नारा मोंड्या ठोरे; मोन्जे आरोन तियांआं नावे यहोवा आगाड़ी खांदोपोअ ओरेए काजे लागाड़ीत रोय. <verse eid="EXO 28:12" /><verse number="13" style="v" sid="EXO 28:13" />फाशेए होनाआ कप्पा बोणावजा, <verse eid="EXO 28:13" /><verse number="14" style="v" sid="EXO 28:14" />आन दोरीइ होस गुथल्यी बेन हाकल सोका होनाआ बोणावजा; आन गुथल्यी हाकल तियां खुणामेहें जुड़जा.”<verse eid="EXO 28:14" /></para>
  <para style="s">सातीइ पोट्टू</para>
  <para style="r">(<ref loc="EXO 39:8-21">निर्ग 39:8-21</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15" />“फाशोअ न्यायोअ सातीइ पोट्टाहा बी कारागिरोअ कामोवाअहीं तियार कोइत लेजा, एपोदोअ होस होनाआ, आन निला, जामण्या आन रात्ला रंगोअ आन हाना पात्ला हुतोअ कपड़ाआ बोणावजा. <verse eid="EXO 28:15" /><verse number="16" style="v" sid="EXO 28:16" />ओं शार खुण्यो बेनु वोल जोवे, आन तियाआ लांबी आन सोवड़ाय एकेक बिलासोअ जोवे. <verse eid="EXO 28:16" /><verse number="17" style="v" sid="EXO 28:17" />आन तियामेहें शार ओली मोंड्या जुड़जा. पेहली रांगीमेहें मोगला डोणोअ शार मोंड्या ए होय: माणिक्य, पद्यराग आन लालड़ी जोवे; <verse eid="EXO 28:17" /><verse number="18" style="v" sid="EXO 28:18" />दुसरी रांगीमेहें मरकत, निलमणी आन हिरा. <verse eid="EXO 28:18" /><verse number="19" style="v" sid="EXO 28:19" />तिसरी रांगीमेहें लसम, सुर्यकांत आन निलम; <verse eid="EXO 28:19" /><verse number="20" style="v" sid="EXO 28:20" />आन शोवथी रांगीमेहें फिरोजा, सुलेमानी डोण आन यशब रोय; ओं आखो होनाआ कप्पा कप्पामेहें जुड़जा. <verse eid="EXO 28:20" /><verse number="21" style="v" sid="EXO 28:21" />इस्राएलोअ पोर्‍याअ जेतेहे नावे होय तेताहाज मोंड्या जोवे, मोन्जे तियांआं नावोअ गणतीइ अनुसार बारा नावे कोरवीइजा, बारा पारवाड़ी मेहें रोत एक एकाअ नावे एकेक किड़्यापोअ एहेलोहो कोरवीइजा जेहेलोहो सापू सापात जाय. <verse eid="EXO 28:21" /><verse number="22" style="v" sid="EXO 28:22" />फाशोअ सातीइ पोट्टापोअ दोरीइ होस विईंत सोको होनाअ हाकली बोणावजा. <verse eid="EXO 28:22" /><verse number="23" style="v" sid="EXO 28:23" />आन सातीइ पोट्टामेहें होनाआ बेन कोड़यी लागाड़जा, आन बेनु कोड़ीही सातीइ पोट्टाआ बेनु खांदोअ सेवड़ापोअ आगल्यीइ वोल लागाड़जा. <verse eid="EXO 28:23" /><verse number="24" style="v" sid="EXO 28:24" />आन होनाआ बेनु विंइल्यी हाकलेहे तियी बेनु कोड़ीमेहें जे सातीइ पोट्टाआ सेवड़ापोअ लागाड़जा; <verse eid="EXO 28:24" /><verse number="25" style="v" sid="EXO 28:25" />आन गुथल्या बेनु हाकलीइ बेनु सेड़ा बेनु खांदोपोअ जुड़वीत एपोदोअ बेनु खांदोअ पोट्टापोअ तियाआ आगाड़ी लागाड़जी. <verse eid="EXO 28:25" /><verse number="26" style="v" sid="EXO 28:26" />फाशोअ होनाअ बेनु कोड़यी बोणावीत कोइत एपोदोअ निसर्‍याआ सेवड़ापोअ मायतीइ वोल लागाड़ीलोअ. <verse eid="EXO 28:26" /><verse number="27" style="v" sid="EXO 28:27" />फाशोअ तिया होनाअ बेन कड़ी बोणावीत कोइत एपोदोअ बेनु सेवड़ा कोरेपोअ, निसे रोत तियाआ आगाड़ी आन तियाआ जुड़पाआ जागे पोन सातीइ पोट्टाआ निसर्‍याआ भागोम आगाड़ीइ वोल जुड़पाआ कलाकारी वाअहीं विईंल्या पोट्टाअरी लागाड़जा. <verse eid="EXO 28:27" /><verse number="28" style="v" sid="EXO 28:28" />आन सातीइ पोट्टाआ तियाआ कोड़ी वाअहीं एपोदोअ कड़ी मेहें निला दोरा वाअहीं बांदजा, एहें कोइत तो एपोदोअ बोणावल्या पोट्टापोअ मजबुत बांदाइत रोय आन सातीइ पट्टू एपोद पोअ रोत आलाग ने ओवुहूं जोवे.”<verse eid="EXO 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 28:29" />“जेहेलाम आरोन सोका जागामेहें जाय, तेहेलाम सातीइ पोट्टापोअ इस्राएलोअ बारा पारवाड़ीइ बारा घराणाआ नावे लागाड़ल्ये जोवे, जिया वाअहीं यहोवाआ आगाड़ी तियांआं ओर हादाफल रोय. <verse eid="EXO 28:29" /><verse number="30" style="v" sid="EXO 28:30" />आन तु सातीइ पोट्टापोअ उरिम<note caller="+" style="f"><char style="fr" closed="false">28:30 </char><char style="fq" closed="false">उरिम </char><char style="ft" closed="false">पुंजारा वाईं देवोअ ईश्शा जाईंलोअ काजे याआ वापर ओवत्लू कोत्ले.</char></note> आन थुम्मीमोहों मिकजी, आन जाहां जाहां आरोन यहोवाअ आगाड़ी आवे, ताहां ताहां ते तियांआं सातीपोअ लेत रोय. एहें कोइत आरोन इस्राएलोअ काजे यहोवाअ न्यायोहो तियाआ सातीपोअ लेत रोय.”<note caller="+" style="x"><char style="xo" closed="false">28:30 </char><char style="xt" closed="false"><ref loc="NUM 27:21">गणती 27:21</ref>; <ref loc="DEU 33:8">कायदा 33:8</ref>; <ref loc="EZR 2:63">एज्रा 2:63</ref>; <ref loc="NEH 7:65">नहे 7:65</ref></char></note><verse eid="EXO 28:30" /></para>
  <para style="s">पुंजारा पोदोअ बाकी आंगड़े</para>
  <para style="r">(<ref loc="EXO 39:22-31">निर्ग 39:22-31</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31" />“फाशोअ एपोदोअ कोअते कोट पुरो जामण्या रंगोअ बोणावजा. <verse eid="EXO 28:31" /><verse number="32" style="v" sid="EXO 28:32" />तियाआ बोणाव एहेलुहू कोअजी के तियाआ विसमेहें मुन्को फोहाड़ुहूं डुसू जोवे, आन तिया डुसाआ शारु वोल विईंल्या दोरा वाअहीं कालोरोअ होस मजबुत कोअजी के तों ने फाटुहूं जोवे. <verse eid="EXO 28:32" /><verse number="33" style="v" sid="EXO 28:33" />तियाआ निसेए भागोमेहें शारु वोल निला, जामण्या आन रात्ला रंगोअ कपड़ाआ डाड़ींबो बोणावजा, आन तियाआ विस विसमेहें शारु वोल होनाआ कागर्‍यी लागाड़जा, <verse eid="EXO 28:33" /><verse number="34" style="v" sid="EXO 28:34" />मोन्जे एक होनाआ कागऱ्यी आन एक डाड़ींबो, फाशोअ एक होनाआ कागरी आन एक डाड़ींबो एहें कोइत कोटोअ निसा जागामेहें शारु वोल एहेलोज जोवे. <verse eid="EXO 28:34" /><verse number="35" style="v" sid="EXO 28:35" />आन आरोन ओ कोट सेवा कोइलोअ वेले पोवे, के जाहां जाहां तो सोका जागाअ मायते यहोवाअ आगाड़ी जाय नेत बाअथे निहे, ताहां ताहां तियाआ शब्द होंबलाअहूं जोवे, नेते तो मोइत जाय.”<verse eid="EXO 28:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 28:36" />“तु सोका होनाआ एक पोट्टी बोणावजी आन ताहरुउ तियापोअ जेहेलोहो सिक्कापोअ आक्शर कोरवीत लेखतेहे तेहेलोहो कोरवीइजी: ‘यहोवा देवोहो होपाअलो.’ <verse eid="EXO 28:36" /><verse number="37" style="v" sid="EXO 28:37" />आन तियीही पागड़ीइरी लागाड़ीत हुंबे निंडेज निल्ला दोरा वाअहीं बांदजी. <verse eid="EXO 28:37" /><verse number="38" style="v" sid="EXO 28:38" />आन तो आरोनोअ निंडाअपोअ रोअहूं जोवे, एताआ काजे के इस्राएलवाले माअहें जे सोकी वस्तुउ भेट आपिलोअ बाप्तिमेहें काविहीं सुकभुल ओत जाय, ताहां तियाआ दोस आरोनोपोअ लागे, एहें कोइत देव तुमाआं स्विकार कोए.”<verse eid="EXO 28:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="EXO 28:39" />“आन कोट सिणा हुतोअ शार खुण्यो आंगड़ो गुथीत बोणावजी, आन एक पागड़ी बी हाजा मेर्‍याआ सिणा पात्ला हुतोअ कपड़ाआ बोणावजा, आन हाजा कारागीर कोअल्या कामोअ सोन्गावालू कंबरेए पोट्टू बोणावजी.”<verse eid="EXO 28:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 28:40" />“फाशोअ आरोनोअ पोर्‍याआ कोअते आंगड़े, कंबर पोट्टू, टोपी बोणावजी, तियांआं एं आंगड़े वोडाय आन होबाआ काजे बोणावजी. <verse eid="EXO 28:40" /><verse number="41" style="v" sid="EXO 28:41" />ताआ पाही आरोन आन तियाआ बेटाह्हाआ काजे एं आंगड़े पोवाड़ीत तियांपोअ तेल ओलीत कोइत आंगे कोअजी आन तियांहां पुंजारा कोत माआ काम कोए तेहें काजे अभिशेक कोअजी. <verse eid="EXO 28:41" /><verse number="42" style="v" sid="EXO 28:42" />आन तियांआं काजे कंबरे रोत निसे जांआं टापाइत रोय तेहें काजे सुट बोणावजी आन तें हाजा मेर्‍योअ हुतोअ बोणावजी. <verse eid="EXO 28:42" /><verse number="43" style="v" sid="EXO 28:43" />आरोन आन तियाआ पोर्‍या मिलन तोंबामेहें नेताहां सोका जागाम पुंजारा कोत सेवा कोआ जाय, तेहेलाम कायम ते सुट पोवुहूं जोवे नेते उगड़ाअलाज देखाअया, ताहां मोइत जाय. ओ आरोन आन तियाआ घराणाआ काजे हादाफल्युउ नियम होय.”<verse eid="EXO 28:43" /></para>
  <chapter eid="EXO 28" />
  <chapter number="29" style="c" sid="EXO 29" />
  <para style="s">आरोन आन तियाआ पोऱ्याहा तेल ओलीत कोइत पुंजाराआ सेवाआ काजे निवड़</para>
  <para style="r">(<ref loc="LEV 8:1-36">लेवी 8:1-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1" />“तियांहां सोको कोइला काजे जो काम ताहूं तियांअरी कोइलाआ होय के ते माआं काजे पुंजाराआ काम कोए, तों ओं होय: एक निर्दुस डोगरान बोकड़ाआ बासो आन बेन निर्दुस मेडा लेजा, <verse eid="EXO 29:1" /><verse number="2" style="v" sid="EXO 29:2" />आन खमीरोअ रोटू, आन तेलोम कुहूंणीइल्या लोटो वाअहीं बोणावल्या मोयदाआ बिगर खमीरोअ सान्क्ये, आन तेलोवाअहीं बोणावल्या खमीरोअ पापड़ी बी लेजा. ओं आखो गोवोंअ मोयदाआ बोणावजा. <verse eid="EXO 29:2" /><verse number="3" style="v" sid="EXO 29:3" />तियांहां एकी टोपलीम मिकीत कोइत तियी टोपलीही तिया डोगराआ बासाहा आन तियां बेनू मेडाहां आरी लेत आवजा.”<verse eid="EXO 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 29:4" />“फाश्योअ आरोन आन तियाआ पोऱ्याहा मिलन तोंबाआ बाअणाआ आगाड़ी लेतावीत कोइत पाअयों वाअहीं उंगलावजा. <verse eid="EXO 29:4" /><verse number="5" style="v" sid="EXO 29:5" />ताहां तियां आंगड़ाहा लेतावीत कोइत आरोनोहो कोट आन एपोदोअ आंगड़ो पोवजी, आन एपोद आन सातीइ पोट्टू बांदजी, आन एपोदोअ कलाकारी वाअहीं कोअल्या कामोअ पोट्टू बी बांदजी; <verse eid="EXO 29:5" /><verse number="6" style="v" sid="EXO 29:6" />आन तियाआ मुंडोपोअ पागड़ी मिकजा, आन पागड़ी पोअ सोकी सुटी मिकजा. <verse eid="EXO 29:6" /><verse number="7" style="v" sid="EXO 29:7" />ताहां सोको तेल लेत कोइत तियाआ मुन्कापोअ ओलीत कोइत तियाहा अभिशेक कोअजी.”<verse eid="EXO 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 29:8" />“फाश्योअ तियाआ पोऱ्याहां तिहीं लेतावीत कोइत आंगड़े पोवाड़जी. <verse eid="EXO 29:8" /><verse number="9" style="v" sid="EXO 29:9" />आन तियांआं मोन्जे अहरोनोअ आन तियाआ पोऱ्याअ कंबर बांदजी आन तियांआं मुन्कापोअ टोपी मिकजी; जिया वाअहीं पुंजाराआ पद पोअ हादाजोलम तियांआं हक्क रोय. एहें कोइत आरोनोअ आन तियाआ पोऱ्याआ सांवसार कोअजा.”<verse eid="EXO 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 29:10" />“ताहां डोगराआ बासाहा मिलन तोंबाआ हुंबर लेतावजी. आरोन आन तियाआ पोऱ्ये, बासाआ मुन्कापोअ तियांआं आथ मिकुहूं जोवे, <verse eid="EXO 29:10" /><verse number="11" style="v" sid="EXO 29:11" />ताहां तिया डोगराआ बासाहा यहोवा आगाड़ी मिलापवाला तोंबाआ बाअणाज पोअ गाराहा कोअजा, <verse eid="EXO 29:11" /><verse number="12" style="v" sid="EXO 29:12" />आन डोगराआ बासाआ रक्तामेहें रोत थोड़ोक लेत कोइत ताआ आथोअ आंगी वाअहीं देवान्याआ हिगोंपोअ लागाड़जी, आन आखो रक्त देवान्याआ पायाआ जागे रेसवी देजी. <verse eid="EXO 29:12" /><verse number="13" style="v" sid="EXO 29:13" />आन जियी सरबी वाअहीं आते टापाइत रोतेहे, आन जे कांअजापोअ रोनारी सरबी, आन बेनू किडनीही तियाआ उपऱ्यीइ सरबी आरी लेत कोइत आखो देवान्यापोअ पेटाड़जा. <verse eid="EXO 29:13" /><verse number="14" style="v" sid="EXO 29:14" />पोन वासड़ाआ माहां, आन सांबड़ो, आन साआं, पोड़ावाआ बाअथे आगीम पेटाड़ी देजा; काहाके ओं पापोअ गाराहा रोय.”<verse eid="EXO 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 29:15" />“फाश्योअ एक मेडो लेजा, आन आरोन आन तियाआ पोऱ्या तियाआ मुन्कापोअ तियांआं आथ मिके, <verse eid="EXO 29:15" /><verse number="16" style="v" sid="EXO 29:16" />ताहां तिया मेडाहा गाराहा कोअजा, आन तियाआ रक्त लेत कोइत देवान्याआ शारु वोल हितड़ावजा. <verse eid="EXO 29:16" /><verse number="17" style="v" sid="EXO 29:17" />ताहां तिया मेडाहा डुन्का डुन्काज कोअजा, आन तियाआ आते आन गुडा तुवीत कोइत तियाआ डुन्काहा आरीज मिकजा,<note caller="+" style="x"><char style="xo" closed="false">29:17 </char><char style="xt" closed="false"><ref loc="EPH 5:2">इफिस 5:2</ref>; <ref loc="PHP 4:18">फिलि 4:18</ref></char></note> <verse eid="EXO 29:17" /><verse number="18" style="v" sid="EXO 29:18" />आन तिया आखा मेडाहा देवान्यापोअ पेटाड़जा; तो ते यहोवाअ काजे आगीइ गाराहा रोय; तो यहोवाआ काजे खुसी आपनारी गोंद होय.”<verse eid="EXO 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 29:19" />“फाश्योअ बिहीरा मेडाहा लेजा; आन आरोन आन तियाआ पोऱ्या तियाआ मुंडोपोअ सोताआ आथ मिकुहूं जोवे. <verse eid="EXO 29:19" /><verse number="20" style="v" sid="EXO 29:20" />ताहां तिया मेडाहा बली कोअजा, आन तियाआ रक्ताम रोत थोड़ोक लेत कोइत आरोन आन तियाआ पोऱ्याआ हाजाड़्या कानोअ मुंडोपोअ, आन तियांआं हाजाड़्यु आथ आन हाजाड़्यु गुडाआ आकड़ापोअ लागाड़जी, आन रक्ताहा देवान्यापोअ शारु वोलेहे साटारी देजा. <verse eid="EXO 29:20" /><verse number="21" style="v" sid="EXO 29:21" />फाश्योअ देवान्यापोऱ्योअ रक्त आन अभिशेकोअ तेल, यां बेनुमेहें रोत थोड़-थोड़ो लेत कोइत आरोन आन तिया आंगड़ापोअ, आन तियाआ पोऱ्या आन तियांआं आंगड़ा पोअ बी हितड़ावी देजा; ताहां तो तियाआ आंगड़ाआ आरीज, आन तियाआ पोर्‍या बी तियांआं आंगड़ा आरीज सोके ओत जाय.”<verse eid="EXO 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 29:22" />“ताहां मेडाहा होपाअलो होय कोत तियाम रोत सरबी आन वोडी सेपटी, आन जियी सरबी वाअहीं आते टापाइत रोतेहे तियाहा, आन कांअज्याअरी सरबी, आरीज बेनू किडनी आन हाजाड़ी जांग लेजा, <verse eid="EXO 29:22" /><verse number="23" style="v" sid="EXO 29:23" />आन बिगर खमीरोअ रोटाअ टोपली जे यहोवाअ आगाड़ी तोअयी ओय तियाम रोत बी एक रोटू, आन तेलोम केलवीइल्या मोयदाआ एक रोटू, आन एक सान्की लेत कोइत, <verse eid="EXO 29:23" /><verse number="24" style="v" sid="EXO 29:24" />ओं आखो आरोन आन तियाआ पोऱ्याआ आथोम मिकीत कोइत डोलवीइलाअ भेट ठरवीत यहोवा देवोअ सामने डोलवी देजा.”<verse eid="EXO 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 29:25" />“ताहां तिया वस्तुहू तियांआं हाथोम रोत लेत आगीइ गाराहा देवान्यापोअ पेटाड़ी देजा, जिया वाअहीं तो यहोवा आगाड़ी खुसी आपनारी गोंद आवे; यहोवाअ काजे आगीइ गाराहा होय.<verse eid="EXO 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 29:26" />“फाश्योअ आरोनोअ होपाअलो जों मेडो रोय तियाआ सातीही लेत कोइत डोलवीइलाअ भेटेए काजे यहोवाअ आगाड़ी डोलवीइजा; आन तो ताआ भाग रोय.<verse eid="EXO 29:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 29:27" />“आन आरोन आन तियाआ पोऱ्याआ होपाअलो जों मेडो ओय, तियाम रोत डोलवीइलाअ भेट साती जे डोलवीइनारे होय ते आन होपाअली मांडी यां बेनुहूं तु सोकालजी. <verse eid="EXO 29:27" /><verse number="28" style="v" sid="EXO 29:28" />आन ए हादाजलम्यीइ रिती पोअ इस्राएलोअ वोल रोत आरोन आन तियाआ पोऱ्याअ भाग ठोरे, काहाके ए होपल्यी गाराहा ठऱ्यीही; आन ए इस्राएलोअ वोल रोत तियांआं शांतीबलीम रोत यहोवा काजे होपाअलो गाराहा होय.”<verse eid="EXO 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 29:29" />“आरोनोअ जें सोके आंगड़े रोय ते तियाआ फासाड़ी तियाआ पोऱ्याअ पोर्‍याहा यांहां मिलते रोय, जिया वाअहीं तियांहां पेवीत रोल्या तियांहां तेल ओलीत अभिशेक आन निवड़ कोअजा. <verse eid="EXO 29:29" /><verse number="30" style="v" sid="EXO 29:30" />तियाआ पोऱ्या मेहें रोत जो तियाआ जागा पोअ पुंजारु ओय, तो जेहेलाम सोका जागामेहें सेवा कोइला काजे मिलापवाला तोंबामेहें पेल आवे, ताहां तिया आंगड़ाहा हांत दिही जाआं पेवित रोय.<verse eid="EXO 29:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 29:31" />“फाश्योअ पुंजाराआ होपाअलो जो मेडो ओय तियाहा लेत कोइत तियाआ माहां सोका जागा मेहें रांदजा; <verse eid="EXO 29:31" /><verse number="32" style="v" sid="EXO 29:32" />ताहां आरोन तियाआ पोऱ्याअ आरी तिया मेडाअ माहां आन टोपला मेऱ्युउ रोटू, बेनू मिलापवाला तोंबाआ बाओपोअ खाय. <verse eid="EXO 29:32" /><verse number="33" style="v" sid="EXO 29:33" />सोताहा सोका ओवीइलोअ काजे जो रोटू तियां गाराहा कोत आप्यू आन तियाहा तेंज खाअहूं जोवे, पोन बिहीरे तो ने खाअहूं जोवे, काहाके तो सोकू होय. <verse eid="EXO 29:33" /><verse number="34" style="v" sid="EXO 29:34" />जर होपाअलो माहां नेत रोटामेहें रोत थोड़क वेगीइ जाआं उगरे, ताहां उगरीइल्यो तियाहा आगीमेहें पेटाड़ी देजा, तो ने खाअहूं जोवे; काहाके तो सोको रोये.<verse eid="EXO 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 29:35" />“आंय ताहूं जो जो आदेश आप्युहू तियाआ पुरमाणे तु, आरोन आन तियाआ पोऱ्या नेहें कोअजा; आन हांत दिही जाआं तियांआं सांवसार कोअजा, <verse eid="EXO 29:35" /><verse number="36" style="v" sid="EXO 29:36" />मोन्ज्ये पापोअ गाराहाआ काजे एक डोगराआ बासो पापोअ माफीइ वेले सोको कोअजा, आन तियाहा सोको कोइलाआ काजे तियाहा अभिशेक कोअजा. <verse eid="EXO 29:36" /><verse number="37" style="v" sid="EXO 29:37" />हांत दिही जांआं देवान्याहा सोको कोअजा, ताहां तों सोकाम सोको ठोरे; आन जो कोडो नेत जो किबी तियाहा टेकीत जाय तों बी सोको ओत जाय.”<verse eid="EXO 29:37" /></para>
  <para style="s">दाड़ख्यीइ गाराहा</para>
  <para style="r">(<ref loc="NUM 28:1-8">गणती 28:1-8</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38" />“जो ताहूं देवान्यापोअ दाड़ीइज सोड़वुहूं पोड़े तों ओं होय: दाडीइज एक एक वोरहोअ बेन मेडाआ बासे. <verse eid="EXO 29:38" /><verse number="39" style="v" sid="EXO 29:39" />एक मेडाअ बासाहा वेगीइ वेले, आन बिहीरा मेडाआ बासाहा हांजेए वेले गाराहा कोअजा. <verse eid="EXO 29:39" /><verse number="40" style="v" sid="EXO 29:40" />आन पेल्लाआ मेडाआ बासाहा आन सिपड़ीत काडल्यो जेयतुनोअ बेन लिटर तेल, तेलोमेहें कुहूंणीइल्यु मोयदाआ लोट आन भेटेए कोअते दाराक्शाआ रोहो ओं अर्पण कोअजा. <verse eid="EXO 29:40" /><verse number="41" style="v" sid="EXO 29:41" />हांजेए वेले बी बिहीरो मेडाआ बासो गाराहा कोअहूं जोवे आन तियाअरी वेगीइ कोअयोहो तेहेंज कोइत ओनोअ आन रोहोअ गाराहा आपुहूं जोवे; ओं यहोवा देवोहो गोमनारो गाराहा होय. <verse eid="EXO 29:41" /><verse number="42" style="v" sid="EXO 29:42" />तुमाआ पिड़ीइ ते पिड़ी मेहें जाआं यहोवाअ आगाड़ी मिलापवाला तोंबाआ बाओपोअ हादाफोल एहेंज कोइत आगीइ गाराहा ओवतु रोय; ओं तो जागू होय जिया मेहें आंय तुमू माअहोंहों याअ कोअते मिल्या कोअहीं के ताअरी गोठी कोअहीं. <verse eid="EXO 29:42" /><verse number="43" style="v" sid="EXO 29:43" />ओ तो जागू होय जिहीं आंय इस्राएलोहो मिल्या कोअहीं आन तो तोंबु माआ उजाला वाअहीं सोकू ओत जाय; <verse eid="EXO 29:43" /><verse number="44" style="v" sid="EXO 29:44" />आन आंय मिलापवाला तोंबाहा आन देवान्याहा सोको कोअहीं, आन आरोन आन तियाआ पोऱ्याहा बी सोको कोअहीं के ते माआ काजे पुंजाराआ काम कोए. <verse eid="EXO 29:44" /><verse number="45" style="v" sid="EXO 29:45" />आन आंय इस्राएलोअ विसमेहें रोहीं, आन तियांआं देव बोणिहीं. <verse eid="EXO 29:45" /><verse number="46" style="v" sid="EXO 29:46" />ताहां ते जाईंत लेय के आंय यहोवा तियांआं देव होय, जो तियांहां मिसर देसोम रोत याआ कोअते काडीत लेतायुहू के तियांआं विसमेहें रोअहूं आयू; आंयुज तियांआं देवो यहोवा होय.”<verse eid="EXO 29:46" /></para>
  <chapter eid="EXO 29" />
  <chapter number="30" style="c" sid="EXO 30" />
  <para style="s">तुमाणाआ देवान्यो</para>
  <para style="r">(<ref loc="EXO 37:25-28">निर्ग 37:25-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1" />“फाश्यो तुम्हावीलोअ काजे बाबल्योअ लाकड़ाआ देवान्यो बोणावजा. <verse eid="EXO 30:1" /><verse number="2" style="v" sid="EXO 30:2" />तियाआ लांबी एक आथ आन सोवड़ाय एक आथोअ जोवे, तों शारी खुणे सोका होनाआ वाअहीं निपल्यो जोवे, आन बेन आथ उसी जोवे, आन तियाआ हिंगे तियाआज डुन्का वाअहीं बोणावजा. <verse eid="EXO 30:2" /><verse number="3" style="v" sid="EXO 30:3" />आन देवान्याआ उपऱ्युउ भाग आन तियाआ शारु खुणा आन तियाआ हिंगे ओं आखो सोका होना वाअहीं मोडाड़जा, आन तियाआ शारी वोलेहे होनाआ एक वाड़ बोणावजा. <verse eid="EXO 30:3" /><verse number="4" style="v" sid="EXO 30:4" />आन तियी वाड़ीइ निसे तियाआ हुंबाहुंब बेनू वोलेहे होनाआ बेन बेन कोड़ी बोणावीत कोइत ते बेनू वोल लागाड़जा, तिहींमेहें डांडा कालीत आखलीइता आवुहूं जोवे. <verse eid="EXO 30:4" /><verse number="5" style="v" sid="EXO 30:5" />डेंगारा बाबल्योअ लाकड़ाआ बोणावीत कोइत तियाहा होना वाअहीं मोडाड़जा. <verse eid="EXO 30:5" /><verse number="6" style="v" sid="EXO 30:6" />आन तु तियाहा तिया पोड़दाआ आगाड़ी मिकजी जो साक्शीपत्राआ पेटीइ आगाड़ी होय, मोन्जे पापोअ माफी टापणाआ आगाड़ी जो साक्शी पत्राआ उपोअ होय, तिहीं आंय ताहूं मिल्या कोअहीं. <verse eid="EXO 30:6" /><verse number="7" style="v" sid="EXO 30:7" />आन तियी देवान्यो पोअ आरोन हाजी गोंदेए तुमाणू पेटाड़्या कोए; दाड़ीइज वेगीइ जेहेलाम दिवाहा वारुहूं कोए तेहेलाम तो तुमाणू पेटाड़े, <verse eid="EXO 30:7" /><verse number="8" style="v" sid="EXO 30:8" />आन फाश्योअ हांजेए वेले जेहेलाम आरोन दिवू पेटाड़े ताहां तुमाणू पेटाड़्या कोए, ओ तुमाणो यहोवाअ आगाड़ी पिड़ीन पिड़ी जाआं पेटाड़ते रोय. <verse eid="EXO 30:8" /><verse number="9" style="v" sid="EXO 30:9" />तिया देवान्यापोअ तुमू कोड्लीज जातीइ तुमाणू मा कोअहा, आन ने तियापोअ गाराहा आन ने तियापोअ शांतीइ गाराहा आन ने ओनोअ भेट कोइलो; ने तियापोअ रोहोअ गाराहा कोइलो. <verse eid="EXO 30:9" /><verse number="10" style="v" sid="EXO 30:10" />आरोन वोरह्योम एक वारी तियाआ हिंगोपोअ पापोअ माफीइ काजे गाराहा कोअहूं जोवे, पापोअ माफीइ काजे रक्ताआ गाराहा आपुहूं जोवे; ओं देवान्यो यहोवा काजे जास्ती सोको होय.”<verse eid="EXO 30:10" /></para>
  <para style="s">जिवोअ माफीइ फालू</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11" />ताहां यहोवा मोशेहे कोयो, <verse eid="EXO 30:11" /><verse number="12" style="v" sid="EXO 30:12" />“जेहेलाम तु इस्राएलोअ गणती लेनू वोलही, ताहां गोणतामेहें जियांआं गोणती ओत गोयीय तें जिवज्योअ जिवोअ काजे यहोवाहा गाराहा भेट आपे, जिया वाअहीं जेहेलाम तु तियांआं गोणती कोअया कोअहो तेहेलाम काअलीज ओड़सन तियांपोअ आवीत ने पोड़े. <verse eid="EXO 30:12" /><verse number="13" style="v" sid="EXO 30:13" />जेतेहे माअहें गोणाइत जाय तें सोका जागाम सालताय तिया इसाबो वाअहीं आरदू शेकेल आपे ओं शेकेल<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="fq" closed="false">शेकेल </char><char style="ft" closed="false">एक शेकेल ताहां विही गिऱ्याम होय</char></note> विही गेरे रोहे, यहोवाअ भेट आरदू शेकेल<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="fq" closed="false">आरदू शेकेल </char><char style="ft" closed="false">सोव गिऱ्यामोअ एतोहो</char></note> जोवे.<note caller="+" style="x"><char style="xo" closed="false">30:13 </char><char style="xt" closed="false"><ref loc="EXO 38:25-26">निर्ग 38:25-26</ref>; <ref loc="MAT 17:26">मत्तय 17:26</ref></char></note> <verse eid="EXO 30:13" /><verse number="14" style="v" sid="EXO 30:14" />विही वोरहोअ नेत तियाआ रोत जाअखा वोयोअ जेतेहे गोणाय तियाम रोत एक एक जोंअ यहोवाआ काजे भेट आपे. <verse eid="EXO 30:14" /><verse number="15" style="v" sid="EXO 30:15" />जेहेलाम तुमाआ जिवोअ कोअते गाराहा कोत यहोवा देवोअ सामने भेट कोअहा, ताहां कुन्बी माअहें आरदा शेकेलो रोत वादार ने आपुहूं जोवे; आन ने गरीब माअहें तियापरोत कम आपुहूं जोवे. <verse eid="EXO 30:15" /><verse number="16" style="v" sid="EXO 30:16" />आन तु इस्राएलवालापोअ रोत पोशा टोलू कोइत ते मिलापवाला तोंबाम काम लागाड़जा; आन इस्राएलवाला कोअते गाराहाआ काजे ते पोशा यहोवा देवोअ आगाड़ी ओरेए काजे ठोरे.”<verse eid="EXO 30:16" /></para>
  <para style="s">तांबाआ तोपल्यो</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17" />यहोवा मोशेहे कोयो, <verse eid="EXO 30:17" /><verse number="18" style="v" sid="EXO 30:18" />“तुवीइलाअ काजे तांबाआ एक तोपल्यो, आन तियाआ बुंद्यो बी तांबाआज बोणावजा. तियाहा मिलापवाला तोंबुउ आन देवान्याआ विसमेहें मिकीत कोइत तियामेहें पाईं पोई देजा;<note caller="+" style="x"><char style="xo" closed="false">30:18 </char><char style="xt" closed="false"><ref loc="EXO 38:8">निर्ग 38:8</ref></char></note> <verse eid="EXO 30:18" /><verse number="19" style="v" sid="EXO 30:19" />आन तियामेहें आरोन आन तियाआ पोऱ्या तियांआं आथेन गुडा तुव्या कोए. <verse eid="EXO 30:19" /><verse number="20" style="v" sid="EXO 30:20" />जाहां जाहां ते मिलापवाला तोंबामेहें फोहे ताहां ताहां ते आथेन गुडा पाअयों वाअहीं तुवुहूं जोवे, नेत ते मोईत जाय; आन जियी जियी वेले ते देवान्याआ जागे सेवा कोए, मोन्जे यहोवा काजे गाराहा पेटाड़ा आवे, ताहां ताहां ते आथेन गुडा तुवुहूं जोवे, एहेलोहो ने ओवुहूं जोवे के ते मोइत जाय. <verse eid="EXO 30:20" /><verse number="21" style="v" sid="EXO 30:21" />ओं आरोन आन तियाआ पिड़ीन पिड़ीइ पारवाड़ीइ काजे हादाजोल्म्यीइ रिती ओत जाय.”<verse eid="EXO 30:21" /></para>
  <para style="s">सोको कोअल्यो तेल</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22" />फाश्यो यहोवा मोशेहे कोयो, <verse eid="EXO 30:22" /><verse number="23" style="v" sid="EXO 30:23" />“तु हाजाम हाजो गोंदाण्यो तेल, मोन्जे सोका जागाआ काजे शेकेलोअ अनुसार पास होव शेकेल तिया तियाआ निहील्यू हाजू गुंदाअनारु सिक, आन तियाआ आरदो, मोन्जे आड़ी होव शेकेल हाजो गुंदाअनारो दालसिनीइ साड़, आन हाजाम हाजी गुंदाअनारी आगरबत्ती, <verse eid="EXO 30:23" /><verse number="24" style="v" sid="EXO 30:24" />आन सोव किलो तेजपान, आन शार लिटर जेयतुनोअ तेल लेत कोइत, <verse eid="EXO 30:24" /><verse number="25" style="v" sid="EXO 30:25" />तियांआं अभिशेकोअ सोको तेल, मोन्जे हाजी गोंदेए काजे गुंदाअनारो तेल बोणावजा; ओं अभिशेकोअ सोको तेल ठोरे. <verse eid="EXO 30:25" /><verse number="26" style="v" sid="EXO 30:26" />आन तियाहा मिलापवाला तोंबुउ, आन साक्शीपत्राआ पेटीइ, <verse eid="EXO 30:26" /><verse number="27" style="v" sid="EXO 30:27" />आन टेबल आन तियाअरीइ आखी वस्तु, दिवाआ थुड़ो आन तियाअरीइ सामान आन तुमाणाआ देवान्यो, <verse eid="EXO 30:27" /><verse number="28" style="v" sid="EXO 30:28" />आन आखा सामानोअरीज गाराहाआ काजे आगीइ देवान्यो, आन बुंद्याअरीज तोपल्याआ अभिशेक कोअजा, <verse eid="EXO 30:28" /><verse number="29" style="v" sid="EXO 30:29" />आन तियांहां सोको कोअजा, जियावाअहीं तों जाअखो सोको ठोरे; आन जों किबी तियाहा टेकीत जाय तों सोको ओत जाय. <verse eid="EXO 30:29" /><verse number="30" style="v" sid="EXO 30:30" />फाश्यो आरोनोहों तियाआ पोऱ्याअरी निवड़ कोअजा, आन एहेंकोइत तियांहां माआ काजे पुंजाराआ काम कोए तेहें सोको कोअजा. <verse eid="EXO 30:30" /><verse number="31" style="v" sid="EXO 30:31" />आन इस्राएलोहो माआं ओ हुकूम कोत आपजा, ‘ओं तेल तुमाआ पिड़ीन पिड़ी जाआं माआ काजे सोको कोअल्यो तेल रोय. <verse eid="EXO 30:31" /><verse number="32" style="v" sid="EXO 30:32" />ओं एखा माअहोंअ डिलोअरी हारीइलोअ काजे मा वापराहा, आन सान्बीत कोइत तियाआ हारको किज मा बोणावहा; ओं सोको होय, ओं तुमाआ काजे बी सोको रोय. <verse eid="EXO 30:32" /><verse number="33" style="v" sid="EXO 30:33" />जों कोडो याआ होस किबी बोणावे, नेत जों कोडो याम रोत बिहीरा एखा पारकाहा हारे, तियाहा तियाआ माहूंम काडी देजा.’”<verse eid="EXO 30:33" /></para>
  <para style="s">सोको हाजो गोंदाण्यो वस्तु</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34" />फाश्युउ यहोवा देव मोशेहे कोयो, “तु, हाजो गोंदाण्यो मासालो मोन्ज्ये नोखी<note caller="+" style="f"><char style="fr" closed="false">30:34 </char><char style="fq" closed="false">नोखी </char><char style="ft" closed="false">एकी जातीइ हाजो गोंदाण्यो ठिबाआ होसऱ्योअ वस्तु</char></note>, गोंदाण्यु रोहो, गोंदाण्यी वस्तु आन गुगलाआ सिक लेतावजी, ओं आखो एक हारको जोवे. <verse eid="EXO 30:34" /><verse number="35" style="v" sid="EXO 30:35" />आन तियांआं गोंद मोन्जे खारो सान्बीत कोइत गुंदाअनारा अत्तरोअ होस हाजो आन सोको गुंदाअनारो तेल बोणावजा. <verse eid="EXO 30:35" /><verse number="36" style="v" sid="EXO 30:36" />आन तियाम रोत थोड़ोक कुटीत कोइत हानो कोइ देजा, ताहां तियाम रोत थोड़ोक मिलापवाला तोंबाम साक्शीपत्राअ आगाड़ी, जिहीं आंय ताहूं मिल्या कोअहीं, तिहीं मिकजी; तो तुमाआ काजे वोडो सोको रोय. <verse eid="EXO 30:36" /><verse number="37" style="v" sid="EXO 30:37" />जे हाजी गुंदाअनारी वस्तु तु बोणावही, सान्बीत बोणावल्यी वस्तु तुमू सोताआ काजे मा बोणावहा; ते वस्तु यहोवा देवोअ काजे तुमू सोकी मानजा. <verse eid="EXO 30:37" /><verse number="38" style="v" sid="EXO 30:38" />जों कोडो वास लेअलोअ कोअते सोताआ काजे बोणावे तियाहा माआ माहूंम रोत काडी देजा.”<note caller="+" style="x"><char style="xo" closed="false">30:38 </char><char style="xt" closed="false"><ref loc="EXO 36:38">निर्ग 36:38</ref></char></note><verse eid="EXO 30:38" /></para>
  <chapter eid="EXO 30" />
  <chapter number="31" style="c" sid="EXO 31" />
  <para style="s">तोंबाआ काजे हुतार</para>
  <para style="r">(<ref loc="EXO 35:30-36:1">निर्ग 35:30—36:1</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1" />फाश्याआ यहोवा मोशेहे कोयो, <verse eid="EXO 31:1" /><verse number="2" style="v" sid="EXO 31:2" />“उनाआ, आंय ऊरीइ पोऱ्या बसालेलोहो, जो हुरोअ पोर्‍याआ पोर्‍यू आन यहुदाअ पारवाड़ीइ होय, नाव तोइत हादोहो, <verse eid="EXO 31:2" /><verse number="3" style="v" sid="EXO 31:3" />आन आंय तियाहा देवोअ आत्मा वाअहीं पोइत कोइत बुद्दी, हुशारी, आन आखी गोठी समज आप्यीही. <verse eid="EXO 31:3" /><verse number="4" style="v" sid="EXO 31:4" />तो होनो, सांदी आन तांबाआ बाहरी बाहरी हुतारोअ कामे कोए; <verse eid="EXO 31:4" /><verse number="5" style="v" sid="EXO 31:5" />आन जुड़ीइलोअ काजे मोंड्या जोड़ीत आपे; आन लाकड़ूपोअ नक्शीइ काम कोए. <verse eid="EXO 31:5" /><verse number="6" style="v" sid="EXO 31:6" />आन उनाआ, आंय दानोअ पारवाड़ीम रोत अहिसामाकोअ पोऱ्या अहलियाबहो तियाअरी कोइ देहो; नेत जेतेहे हुशार होय तियां आखाहा बुद्दी आपोहो, जियाहा जेती वस्तुउ आंय ताहूं आदेश आप्यीही ते आखी ते बोणावे; <verse eid="EXO 31:6" /><verse number="7" style="v" sid="EXO 31:7" />मोन्जे मिलापवाला तोंबु, आन साक्शीपत्राआ पेटी आन तियापोऱ्योअ दयासनोअ टापणो आन तोंबाआ आखो सामान, <verse eid="EXO 31:7" /><verse number="8" style="v" sid="EXO 31:8" />आन सामानोअरीज बोहीत खाअलाआ टेबल, आन आखा सामानोअ आरीज सोका होनाअ दिवाआ खांब, आन तुमाणाआ देवान्यो, <verse eid="EXO 31:8" /><verse number="9" style="v" sid="EXO 31:9" />आन आखा सामानोअरीज आगीइ देवान्यो, आन बुंद्याअरीज तोपल्यो, <verse eid="EXO 31:9" /><verse number="10" style="v" sid="EXO 31:10" />आन विंइल्ये आंगड़े, आन आरोन पुंजारु या नातावाअहीं कामोअ सोके आंगड़े, आन तियाआ पोऱ्याआ आंगड़े, <verse eid="EXO 31:10" /><verse number="11" style="v" sid="EXO 31:11" />आन अभिशेकोअ तेल, आन सोका जागाअ काजे हाजी गुंदाअनारी आगरबत्ती, ओं आखो तियां आखा आदेशोअ पुरमाणे बोणावुहूं जोवे जों आंय ताहूं कोत आप्योहो.”<verse eid="EXO 31:11" /></para>
  <para style="s">सब्बाथ मोन्जे आरामोअ दिही</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12" />फाश्यो यहोवा मोशेहे कोयो, <verse eid="EXO 31:12" /><verse number="13" style="v" sid="EXO 31:13" />“तु इस्राएलोहो ओं बी कोजी, ‘तुमू माआ आरामोअ दिहोहो मानजा, काहाके तुमाआ पिड़ीइ पिड़ीमेहें माआंन तुमाआ माअहों विसमेहें ए एक निशाणी ठऱ्यीही, तियी गोठीही तुमू जाईंत लेजा, के यहोवा आमाआं सोकू कोअनारु देव होय. <verse eid="EXO 31:13" /><verse number="14" style="v" sid="EXO 31:14" />याआ कोअते तुमू आरामोअ दिहोहो मानजा, काहाके तो तुमाआ काजे सोकू ठऱ्युहू; जों तियाहा एठो कोए, तियाहा माईंत टाकी देअहूं जोवे; जों कोडो तिया दिहोमेहें किबी कामकाज कोए, तियाहा माआ माहूंम रोत काडी देजा. <verse eid="EXO 31:14" /><verse number="15" style="v" sid="EXO 31:15" />सोव दिही ते कामकाज कोए, पोन सांतवू दिही वोडू आरामोअ दिही आन यहोवाआ काजे सोकू होय; याआ कोअते जों कोडो आरामोअ दिहोमेहें जों किबी कामकाज कोए तियाहा माईंत टाकजा.<note caller="+" style="x"><char style="xo" closed="false">31:15 </char><char style="xt" closed="false"><ref loc="EXO 20:8-11">निर्ग 20:8-11</ref>; <ref loc="EXO 34:2">34:2</ref>; <ref loc="LEV 23:3">लेवी 23:3</ref>; <ref loc="DEU 12:26">कायदा 12:26</ref></char></note> <verse eid="EXO 31:15" /><verse number="16" style="v" sid="EXO 31:16" />याआ कोअते इस्राएल आरामोअ दिहोहो मान्या कोअहूं जोवे, नेत पिड़ीन पिड़ी जाआं तियाहा हादाफोल्यीइ शप्पत जाईंत कोइत मान्या कोअहूं जोवे. <verse eid="EXO 31:16" /><verse number="17" style="v" sid="EXO 31:17" />ते माआन इस्राएलोअ विसमेहें हादाजोलमाऱ्यीइ निशाणी रोय; काहाके सोव दिहोमेहें यहोवा जुग आन धरतीही बोणायी, आन सांतवे दिहे आराम कोइत तियाआ थाक मुड़्यी.’”<note caller="+" style="x"><char style="xo" closed="false">31:17 </char><char style="xt" closed="false"><ref loc="EXO 20:11">निर्ग 20:11</ref></char></note><verse eid="EXO 31:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 31:18" />जेहेलाम देव मोशेअरी सिनाय डोगोपोअ ए गोठ कोइत लेदी, ताहां तिये तियाहा सोताआ आंगी वाअहीं आदेश लेखल्यी बेन डोणोअ पाटी आप्यी.<verse eid="EXO 31:18" /></para>
  <chapter eid="EXO 31" />
  <chapter number="32" style="c" sid="EXO 32" />
  <para style="s">होनाआ वासड़ो</para>
  <para style="r">(<ref loc="DEU 9:6-29">कायदा 9:6-29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1" />जेहेलाम माअहों पाल्यो के डोगो पोअ रोत उतरीइलामेहें मोशेहे वाआ लागेहे, ताहां तें आरोनोअ जागे टोलू वोलीत कोइत कोने वोल्ये, “ओमे आमाआं काजे देव बोणाव, जो आमाआ काजे आगाड़ी आगाड़ी साले; काहाके तिया आमुहूं मिसर देसोम रोत काडीत लेतावनारा मोशेए की ओवो तों आमुहूं नाहां मुंदू?”<note caller="+" style="x"><char style="xo" closed="false">32:1 </char><char style="xt" closed="false"><ref loc="ACT 7:40">प्रेशित 7:40</ref></char></note><verse eid="EXO 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 32:2" />आरोन तियांहां कोयो, “तुमाआ बोईंइ आन पोऱ्याअ पोऱ्यीइ कानोमेहें होनाआ जे बिजल्ये ओय तियांहां काडा, आन माआ जागे लेतावा.” <verse eid="EXO 32:2" /><verse number="3" style="v" sid="EXO 32:3" />ताहां आखा माअहों तियांआं कानो मेहें रोत होनाअ बिजल्ये काडीत कोइत, आरोनोअ जागे लेताये. <verse eid="EXO 32:3" /><verse number="4" style="v" sid="EXO 32:4" />आरोने तियांआं आथोम रोत होनो लेत आवीत विंजणा वाअहीं कोड़ीत कोइत तियाआ एक वासड़ो बोणायो.</para>
  <para style="p" vid="EXO 32:4">ताहां माअहें कोने वोल्ये, “ए इस्राएल, ताआ देव जो ताहूं मिसर देसोम रोत काडीत लेतायुहू, तो ओज होय.”<note caller="+" style="x"><char style="xo" closed="false">32:4 </char><char style="xt" closed="false"><ref loc="1KI 12:28">1 राजां 12:28</ref>; <ref loc="ACT 7:14">प्रेशित 7:14</ref></char></note><verse eid="EXO 32:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 32:5" />ओं पालित कोइत आरोनो तियाआ आगाड़ी एक देवान्यो बोणायो; आन ओं परसार कोअयू, “हांदाअ यहोवाअ काजे तिवार रोये.” <verse eid="EXO 32:5" /><verse number="6" style="v" sid="EXO 32:6" />आन बिहीरा दिही वेगीइ उठीत कोइत आगीइ गाराहा कोअयो, आन शांतीबली लेताये; फाशेए बोहीत कोइत खानेन पिने वोल्येन मोस्ती कोए वोल्ये.<note caller="+" style="x"><char style="xo" closed="false">32:6 </char><char style="xt" closed="false"><ref loc="1CO 10:7">1 करिन्थ 10:7</ref></char></note><verse eid="EXO 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 32:7" />ताहां यहोवा मोशेहे कोयो, “निसे उतरीत जा, काहाके ताआ माअहें, जियांहां तु मिसर देसोम रोत काडीत लेतायुहू तें ते खाराब कामे कोए वोल्येहे; <verse eid="EXO 32:7" /><verse number="8" style="v" sid="EXO 32:8" />आन जियी वाटे पोअ सालीइलाअ आदेश आंय तियांहां आप्युतो तियाहा सोड़ीत कोइत तियां एक वासड़ो बोणावीत लेदोहो, तियाहा ते पागे पोड़्ये, आन तियाहा गाराहा बी आप्यू, आन ओं कोयो, ए इस्राएल, तुमाआ देव जो तुमुहूं मिसर देसो मेहें रोत सोड़वीत लेतायू तो ओ होय.” <verse eid="EXO 32:8" /><verse number="9" style="v" sid="EXO 32:9" />फाश्योअ यहोवा मोशेहे कोयो, “आंय यां माहुंहूं पाल्योहो, आन उनाआ, एं माअहें डांबऱ्ये होय. <verse eid="EXO 32:9" /><verse number="10" style="v" sid="EXO 32:10" />ओमें माहूं मा रुकही, माहूं तियांपोअ खोत सोड़्यीही, खोतोअ वाअहीं तियांहां आरवी देअहूं दे; पोन आंय तावाअहीं एक देस बोणाविहीं.”<verse eid="EXO 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11" />ताहां मोशे तियाआ देव यहोवाहा ओं कोत कोइत विनंती कोउ वोल्यू, “ए यहोवा, ताआ खोत ताआ माअहूं पोअ काहा आयीही, जियाहा तु वोडी सेक्तीवाला आथो वाअहीं मिसर देसोम रोत काडीत लेतायुहू? <verse eid="EXO 32:11" /><verse number="12" style="v" sid="EXO 32:12" />मिसरवाले एहें काहा कोअहूं जोवे, के ‘तो तियांहां माईंत कोइत धरती पोअ रोत आरवीत टाकीइलोअ काजे खाराब मोनो वाअहीं काडीत लेत गोयुहू?’ तु ताहूं लागली खोतेहे आवरीत ले, आन ताआ माअहूंपोअ एहेलिही ओड़सन मा लेत आवही, रुकाइत जा.”<verse eid="EXO 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 32:13" />“ताआ सेवक अब्राहाम, इसाहाक, आन याकोबोहो ओर कोअ, जियांहां तु ताआज शप्पत खात कोइत एहें कोयोतो, ‘आंय तुमाआ पारवाड़ीही जुगोअ ताराआ होस वादाड़ीहीं, आन ओ आखु देस जियाआ आंय गोठी कोअयीही, तो तुमाआ पारवाड़ीही आपिहीं, मोन्ज्ये ते तियाआ आधिकारी कायम रोत सेके.’”<note caller="+" style="x"><char style="xo" closed="false">32:13 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">उत्प 22:16-17</ref>; <ref loc="GEN 17:8">17:8</ref></char></note> <verse eid="EXO 32:13" /><verse number="14" style="v" sid="EXO 32:14" />ताहां यहोवा तियाआ माअहोंअ नुकसान कोइलाम रोत तिये तियाआ मोन बोदल्यो.<verse eid="EXO 32:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 32:15" />ताहां मोशे फिरीत कोइत साक्शीइ बेनू पाटीही आथोम लेत कोइत डोगो पोअ रोत उतरीत आयू. तियी बेनू पाटी पोअ बेनू वोल लेख्योतो, <verse eid="EXO 32:15" /><verse number="16" style="v" sid="EXO 32:16" />आन ते पाटी देवोअ बोणावल्यी ओती, आन तियांपोअ जो कोरवीत कोइत लेखाअयोतो तों देवोअ लेखल्यो ओतो.<verse eid="EXO 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 32:17" />जेहेलाम यहोशवाहा माअहोंअ गर्दी होंबलाअयी, ताहां तिये मोशेहे कोयो, “पोड़ावाअहीं रोत लोड़ायीइ जेहे आवाज होंबलाअहे.”<verse eid="EXO 32:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 32:18" />तिये कोयो, “ओ जो आवाज आवेहे ओ जिकनाराआ जेहें बी नाहां आन ने हारवाअनाराआ जेहें बी नाहां, पोन माहूं ते गावानाराआज शब्द होंबलाअहे.”<verse eid="EXO 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 32:19" />पोड़ावाआ जागे आवताज मोशेहे तों वासड़ो आन नासीइलोअ देखात पोड़्यो, ताहां मोशेहे तियांपोअ खोत लागी, आन तिये पाटीही तियाआ आथोम रोत डोगोअ निसे आस्टीत फोड़ीत टाक्यी. <verse eid="EXO 32:19" /><verse number="20" style="v" sid="EXO 32:20" />ताहां तिये तियांआं बोणावल्या वासड़ाहा लेत कोइत आगीम टाकीत ओगलावी देदो. आन तियाहा कुटीत सुउवीत पाअयोंमेहें टाकी देदो, आन तों पाईं इस्राएलवालाहां पिअहूं लागाड़्यो. <verse eid="EXO 32:20" /><verse number="21" style="v" sid="EXO 32:21" />ताहां मोशे आरोनोहों कोनु वोल्यू, “या माअहों ताअरी एहलोहो कि कोअयो के तु एता वोडा पापोमेहें फोसीत गोयू?”<verse eid="EXO 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 32:22" />आरोने उत्तर आप्यो, “मालिख, मापोअ खोत मा कोअही; तु यां माअहुंहूं ते ओलखेहे के तें खाराब गोठी पोअ मोन लागाड़ीत रोतेहे. <verse eid="EXO 32:22" /><verse number="23" style="v" sid="EXO 32:23" />आन तियां माहूं कोयो, ‘आमांआं काजे देव बोणाव जो आमाआ आगाड़ी आगाड़ी साले; काहाके तिया माटी मोशेहे, जो आमुहूं मिसर देसोम सोड़वीत लेतायुहू, आमू नाहां जांअते के कि ओवोहो?’<note caller="+" style="x"><char style="xo" closed="false">32:23 </char><char style="xt" closed="false"><ref loc="ACT 7:40">प्रेशित 7:40</ref></char></note> <verse eid="EXO 32:23" /><verse number="24" style="v" sid="EXO 32:24" />ताहां आंय तियांहां कोयो, ‘जिया जियापोअ होनाआ सामान ओय, तों तें काडीत लेतावे;’ आन जेहेलाम तियां माहुं तो आप्यो, आंय तियाहा आगी मेहें टाकी देदो, ताहां ओं वासड़ो निहींत आयो.”<verse eid="EXO 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 32:25" />आरोन तियां माहुंहूं खुल्ले सोड़ी देदे आन ते तियांआं दुस्मोनोअ कोअते तियांआं तोमाशु बोण्ये एहलोहो मोशे देख्यो. <verse eid="EXO 32:25" /><verse number="26" style="v" sid="EXO 32:26" />मोशे पोड़ावाआ बाअणाअहीं उबू रोत कोइत कोयो, “जों कोडो यहोवा देवोअ वोल ओय तों माआ जागे आवुहूं जोवे;” ताहां आखे लेवी कुटूंबो तियाआ जागे टोलू वोल्ये. <verse eid="EXO 32:26" /><verse number="27" style="v" sid="EXO 32:27" />तिये तियांहां कोयो, “इस्राएलोअ देव यहोवा ओं कोहे के तुमू तुमाआ जांगीपोअ तलवार बांदीत कोइत पोड़ावाआ एकी मेरे रोत एकी मेरे जाआं सोमकीर फिरीत तुमाआ खाजगी पाव्हीइला, दोस्ती आन जागेवालाहा माईंत टाका.” <verse eid="EXO 32:27" /><verse number="28" style="v" sid="EXO 32:28" />मोशेए या आदेशोअ पुरमाणे लेवी उनाअया; आन तेदिहीं तिन हाजार एतेहे माअहें मोये. <verse eid="EXO 32:28" /><verse number="29" style="v" sid="EXO 32:29" />ताहां मोशे कोयो, “तुमू आज्याआ दिही यहोवाअ काजे तुमाआ पुंजारकाआ कामोअ काजे निवड़ कोअयीही, तुमाआ खाजगी पोऱ्याआ आन पाव्हीइलाअ विरुद्दाम ओते, आन तो तुमुहूं आशिर्वाद आपे.”<verse eid="EXO 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30" />बिहीरे दिही मोशे माअहुंहूं कोयो, “तुमु जास्ती वोडू गुनू कोअयुहू. ओमे आंय यहोवाआ जागे सोड़ीत लागीहीं; ओत सेकेहे तुमाआ पापोअ माफीइ काजे रावणी कोइत सेकाय.” <verse eid="EXO 32:30" /><verse number="31" style="v" sid="EXO 32:31" />ताहां मोशे यहोवाअ जागे जात कोइत कोनु वोल्यू, “तियां माअहों होनाअ देव बोणावीत कोइत जुदो वोडो पाप कोअयोहो. <verse eid="EXO 32:31" /><verse number="32" style="v" sid="EXO 32:32" />तेबी ओमे तु तियांआं पापोहो माफ कोअ नेत तुमे लेखल्या पुस्तकोमेहें रोत माआ नाव काडी दे.”<note caller="+" style="x"><char style="xo" closed="false">32:32 </char><char style="xt" closed="false"><ref loc="PSA 69:28">भजन 69:28</ref>; <ref loc="REV 3:5">प्रगटी 3:5</ref></char></note><verse eid="EXO 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 32:33" />यहोवा मोशेहे कोयो, “जियां माआ विरुद्दाम पाप कोअयुहू तियांआज नाव आंय माआ पुस्तकोमेहें रोत काडी देहीं. <verse eid="EXO 32:33" /><verse number="34" style="v" sid="EXO 32:34" />ओमें तु जात कोइत तियां माअहुंहूं तिया जागामेहें लेत साल जे गोठ आंय ताअरी कोअयीते; पाल, माआ देवदूत ताआ आगाड़ी आगाड़ी साले. पोन जेदिहीं आंय मिलीहीं तेदिहीं यांआं पापोअ डोंड बी आपिहीं.”<verse eid="EXO 32:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 32:35" />आरोने बोणावल्यो वासड़ो तियां माअहूंज बोणायोतो, तियाहा काजे यहोवा देव तियांपोअ पिड़ा टाक्यी.<verse eid="EXO 32:35" /></para>
  <chapter eid="EXO 32" />
  <chapter number="33" style="c" sid="EXO 33" />
  <para style="s">सिनाय डोगोअ जागे रोत निहींइलोअ देवोअ आदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1" />फाश्यो यहोवा मोशेहे कोयो, “तु तियां माअहुंहूं जियांहां मिसर देसोम रोत सोड़वीत लेतायुहू आरी लेत कोइत तिया देसोम जा, जियाअ बाप्तिमेहें आंय अब्राहाम, इसाहाक आन याकोबोअरी शप्पत खात कोइत कोयोतो, के आंय तियाहा तुमाआ पारवाड़ीही आपीहीं.<note caller="+" style="x"><char style="xo" closed="false">33:1 </char><char style="xt" closed="false"><ref loc="GEN 12:7">उत्प 12:7</ref>; <ref loc="GEN 28:7">28:7</ref>; <ref loc="GEN 26:3">26:3</ref> </char></note> <verse eid="EXO 33:1" /><verse number="2" style="v" sid="EXO 33:2" />आन आंय ताआ आगाड़ी आगाड़ी एका देवदूतोहो मोकलिहीं, आन कनानी, एमोरी, हित्ती, परिज्जी, हिव्वी, आन यबूसी माअहोंहों काडी देहीं. <verse eid="EXO 33:2" /><verse number="3" style="v" sid="EXO 33:3" />तुमु तिया देसोम जावा जियामेहें दुद आन मोदोअ ताऱ्यी गोलतीही; पोन तुमू वोडाऱ्ये होय, तिहीं वाअहीं आंय तुमाआ विसमेहें ओत कोइत ने सालनारु, एहेलोह ने ओवुहूं जोवे के आंय तुमुहूं वाटे मेहें आरवीत देहीं.”<note caller="+" style="x"><char style="xo" closed="false">33:3 </char><char style="xt" closed="false"><ref loc="ACT 7:51">प्रेशित 7:51</ref> </char></note><verse eid="EXO 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 33:4" />ए खाराब खबर उनाइत कोइत ते माअहें विसारोम पोड़ीत गोये; आन कोडोज तियांआं होनाआ सामान ने पोवयो. <verse eid="EXO 33:4" /><verse number="5" style="v" sid="EXO 33:5" />काहाके यहोवा देवे मोशेहे कोत देदोतो, “इस्राएलोहो माआ ओं वसन कोत देखाड़, ‘तुमू ते वोडाऱ्ये होय; जर आंय थोड़ाक वेलोअ काजे तुमाआ विसमेहें ओत कोइत सालीहीं, ताहां तुमुहूं आरवीत टाकीहीं. तियाहा काजे ओमे तुमाआ डिलोपोअ रोत गोवणो काडीत मिका, ताहां आंय तुमाआ कि कोइलोअ तों आंय कोअहीं.’” <verse eid="EXO 33:5" /><verse number="6" style="v" sid="EXO 33:6" />तिहीं वाअहीं इस्राएलवाले होरेब डोगोअहीं रोत आगाड़ी तियांआं बिगर गोवणाआ रोये.<verse eid="EXO 33:6" /></para>
  <para style="s">यहोवा देवोअ हजरीइ तोंबु</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7" />मोशे पोड़ावाआ तोंबुहू बाअथे मोन्जे सेटे बोणावया कोअतुतो, आन तियाहा मिलापवालू तोंबु कोतुतो. जिया कोडाहा बी यहोवा देवोहो काविहीं फुसीइलोअ रोयो, ताहां तिया मिलापवाला तोंबाआ जागे जातेते. <verse eid="EXO 33:7" /><verse number="8" style="v" sid="EXO 33:8" />जेहेलाम जेहेलाम मोशे तोंबाआ जागे जातुतो, ताहां ताहां आखे माअहें उठीत कोइत तियां तियांआं तोंबाआ बाअणापोअ उबे रोत जातेते, आन मोशे तिया तोंबामेहें फोहे ताअहूं जाआं तें तियाअहें ठावकेज पालीत रोतेते. <verse eid="EXO 33:8" /><verse number="9" style="v" sid="EXO 33:9" />जेहेलाम मोशे तिया तोंबामेहें फोहतुतो, ताहां वाद्लाआ खांब उतरीत कोइत तिया तोंबाआ बाअणापोअ रुकाइत जातुतो, आन यहोवा मोशेएरी गोठी कोअतुतो. <verse eid="EXO 33:9" /><verse number="10" style="v" sid="EXO 33:10" />आन आखे माअहें जेहेलाम वाद्लाआ खांबोहो तोंबाआ बाअणापोअ उबू रोल्यू देखतेते, तेहलाम उठीत कोइत जिवज्योअ तोंबाआ बाअणापोअ रोत पागे पोड़तेते. <verse eid="EXO 33:10" /><verse number="11" style="v" sid="EXO 33:11" />एखा दोस्तीइरी गोठी मिकतेहे तेहें कोइत यहोवा देव मोशेएरी हुंबाहुंब गोठी कोअतुतो, आन मोशे ते पोड़ावाम आवतु रोतुतो, पोन तियाआ सेवक नुनोअ पोऱ्यु यहोशवा तो तोंबू सोड़ीत बारथे ने निहीतुतो.<note caller="+" style="x"><char style="xo" closed="false">33:11 </char><char style="xt" closed="false"><ref loc="NUM 12:8">गणती 12:8</ref>; <ref loc="DEU 34:10">कायदा 34:10</ref></char></note><verse eid="EXO 33:11" /></para>
  <para style="s">देवोअ तियाआ माअहोंअरी वायदो</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12" />मोशे यहोवाहा कोयो, “उनाआ तु माहूं कोहे के, ‘यां माहुंहूं लेत साल;’ पोन तु माअरी कोडाहा मोकलीइनारु तों नाहांजी कोयो. तेबी तुमे कोयोहो, ‘आंय ताहूं नावो वाअहीं ओलखोहो, आंय ताआ बाप्तिम खुस होय.’ <verse eid="EXO 33:12" /><verse number="13" style="v" sid="EXO 33:13" />आन ओमे जर मापोअ मेरेए नजर ओय, ताहां माहूं ताआ वाट देखाड़, जिया वाअहीं आंय ताआ सेवा कोइत सेकहीं आन हमेशा ताहूं खुस कोइत सेकहीं. एं आखे माअहें ताआ होय ओं तू ओर मिकजी.”<verse eid="EXO 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 33:14" />यहोवा देवे कोयो, “आंय सोताहा ताअरी आविहीं आन आंय ताहूं आराम आपिहीं.”<verse eid="EXO 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 33:15" />ताहां मोशे देवोहो कोयो, “जर तू आमाअरी ने आवनारु ओय, ताहां आमुहूं इंहीं रोत आगाड़ी मा मोकलिही. <verse eid="EXO 33:15" /><verse number="16" style="v" sid="EXO 33:16" />तु आमा वाअहीं खुस होय ओं आमुहूं की कोइत सोमजाय? तू आमाअरी आवही ताहांज आंय आन एं माअहें नेहें दुन्यामेऱ्याआ माअहूं रोत फरक होय ओं तियांहां समजाय ना?”<verse eid="EXO 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 33:17" />ताहां यहोवा देवे मोशेहे कोयो, “तुमे जों कोयोहो तों आंय कोअहीं; काहाके आंय तापोअ खुस होय आन आंय ताहूं ताआ नावो वाअहीं ओलखोहो.”<verse eid="EXO 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18" />मोशे कोयो, “मेरवानी कोइत माहूं ताआ महिमाआ उजालो देखाड़.”<verse eid="EXO 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 33:19" />तिये कोयो, “आंय ताआ आगाड़ी ओत कोइत सालतु रोत ताहूं माआ आखी हाजी गोठी देखाड़ीहीं, आन ताआ हुंबर यहोवाअ नावोअ परसार कोअहीं; आन जिया पोअ आंय मेर कोइला कोअहीं तियाज पोअ मेर कोअहीं, आन जियापोअ दया कोइलाआ कोअहीं तियाजपोअ दया कोअहीं.”<note caller="+" style="x"><char style="xo" closed="false">33:19 </char><char style="xt" closed="false"><ref loc="ROM 9:15">रोम 9:15</ref></char></note> <verse eid="EXO 33:19" /><verse number="20" style="v" sid="EXO 33:20" />फाशोअ तिये कोयो, “तु माआ मुखोअ दर्शन नाहां लेत सेकतू; काहाके माहुंउं माआ मुखोअ दर्शन लेत कोइत जिवतो नाहां रोत सेकतो.” <verse eid="EXO 33:20" /><verse number="21" style="v" sid="EXO 33:21" />फाश्योअ यहोवा कोयो, “उनाआ, माआ जागे एक जागू होय, इंहीं तु तिया खोड़कापोअ उबू रो; <verse eid="EXO 33:21" /><verse number="22" style="v" sid="EXO 33:22" />आन जाअहूं जाआं माआ उजालो ताआ सामने रोत ने जाय, ताअहूं जाआं आंय ताहूं खोड़काआ कापड़ाटामेहें मिकीहीं आन आंय आगाड़ी निहीत जाहीं ताअहूं जाआं माआ आथो वाअहीं ताहूं टापित मिकीहीं; <verse eid="EXO 33:22" /><verse number="23" style="v" sid="EXO 33:23" />तिहींइं फासाड़ी आंय माआ आथ काडीत लेहीं, ताहां तु माआ डिलोअ दर्शन लेही; पोन माआ सोबीइ दर्शन ने मिले.”<verse eid="EXO 33:23" /></para>
  <chapter eid="EXO 33" />
  <chapter number="34" style="c" sid="EXO 34" />
  <para style="s">डोणोअ नवी पाटी</para>
  <para style="r">(<ref loc="DEU 10:1-5">कायदा 10:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1" />फाश्योअ यहोवा मोशेहे कोयो, “पेल्लीइ पाटीइ होस बेन डोणोअ पाटी तियार कोइत ले; ताहां जें वसने पेल्लीइ पाटीपोअ लेख्येते, तेंज वसने आंय तियी पाटीपोअ लेखीहीं. <verse eid="EXO 34:1" /><verse number="2" style="v" sid="EXO 34:2" />हांदाआ वेगीइ तियार रोजी, आन वेगीइ वेले सिनाय डोगो पोअ सोड़ीत कोइत तियाआ सेंडीपोअ माआ आगाड़ी उबू रोजी. <verse eid="EXO 34:2" /><verse number="3" style="v" sid="EXO 34:3" />ताअरी कोडो ने सोडुहूं जोवे, आन डोगोपोअ कोडो माहुंउं काज ने देखाअहूं जोवे; आन मेडे, डोगरेन बोकड़े बी डोगोअ आगाड़ी ने सोरुहूं जोवे.” <verse eid="EXO 34:3" /><verse number="4" style="v" sid="EXO 34:4" />ताहां मोशे पेल्लीइ पाटीइ होस बेन आन पाटी बोणाया; आन वेगीज उठीत कोइत तियाआ आथो मेहें डोणोअ ते बेनू पाटी लेत कोइत यहोवाअ हुकूम नुसार सिनाय डोगो पोअ सोड़ीत लागू.<verse eid="EXO 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 34:5" />ताहां यहोवा वाद्लामेहें उतरीत कोइत तियाअरी तिहीं उबू रोत कोइत यहोवा नावोअ परसार कोअयू. <verse eid="EXO 34:5" /><verse number="6" style="v" sid="EXO 34:6" />यहोवा तियाआ आगाड़ी ओत कोइत तियाआ नावोअ परसार कोअतूज जातु गोयु, “यहोवा, यहोवा, यहोवा देव मेरालू आन दयालू, आन मेर कोअनारु, खोत कोइलामेहें दिमू, आन जाअखू दायावालू आन सत्य,<note caller="+" style="x"><char style="xo" closed="false">34:6 </char><char style="xt" closed="false"><ref loc="EXO 20:5-6">निर्ग 20:5-6</ref>; <ref loc="DEU 5:9-10">कायदा 5:9-10</ref>; <ref loc="NUM 14:18">गणती 14:18</ref></char></note> <verse eid="EXO 34:6" /><verse number="7" style="v" sid="EXO 34:7" />हाजार पिड़ी जाआं कायम मेर कोअनारु, खाराब काम आन गुना, आन पापोअ माफी कोअनारु होय, पोन तो गुनेगारोहो केहें बी कोइत निर्दुस ने ठरवे; तो वेगाआ डायहांआं खाराब कामोअ डोंड तियांआं बेटाह्हा नेत पोऱ्याआ पोऱ्या आन तियांआं पोर्‍याआ पोऱ्याहां बी आपनारु होय.”<verse eid="EXO 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 34:8" />ताहां मोशे ताबुड़ धरतीइहें टुंगू पोड़ीत कोइत पागे पोड़्यु. <verse eid="EXO 34:8" /><verse number="9" style="v" sid="EXO 34:9" />आन तिये कोयो, “प्रभु, जर ताआ मेरवानीइं नजर मापोअ ओय, ताहां प्रभु आमाआ विसमेहें ओत कोइत साल; एं माअहें डांबऱ्ये ते होय, तेबी आमाआ खाराब काम आन पापोअ माफ कोअ आन आमुहूं ताआ सोताआ खास भाग मानित कोइत स्विकार कोअ.”<verse eid="EXO 34:9" /></para>
  <para style="s">आदेशोहो नवो कोइला</para>
  <para style="r">(<ref loc="EXO 23:14-19">निर्ग 23:14-19</ref>; <ref loc="DEU 7:1-5">कायदा 7:1-5</ref>; <ref loc="DEU 16:1-17">16:1-17</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10" />यहोवा देवे कोयो, “पाल, आंय एक शप्पत लेहो. ताआ आखा माअहुंउं सामने आंय एहेलेहे वोडे वोडे कामे कोअहीं जें धरतीपोअ आन आखा देसोमेहें केदिहीं ने ओवे; आन तें आखे माअहें जियांअ विसमेहें तु रोहे यहोवा देवोअ कामोंहों पाले; काहाके जों आंय तुमाआ काजे कोइलाआ होय तो बिइलोअ हारको काम होय. <verse eid="EXO 34:10" /><verse number="11" style="v" sid="EXO 34:11" />जो आदेश आंय आज तुमुहूं आपोहो तियाहा तुमू मानजा. पाला, आंय तुमाआ आगाड़ी रोत एमोरी, कनानी, हित्ती, परिज्जी, हिव्वी, आन यबूसी माअहोंहों काडोहो. <verse eid="EXO 34:11" /><verse number="12" style="v" sid="EXO 34:12" />तियाहा काजे तियारीम रोजा के जिया देसोम तु जानारु होय तिया देसोम रोनाराअरी शप्पत मा लेहा; एहेलोहो ने ओवुहूं जोवे के तो ताआ काजे फांदू ठोरे. <verse eid="EXO 34:12" /><verse number="13" style="v" sid="EXO 34:13" />आन तियांआं देवान्याहां ओदारीत टाकजी, आन तियांआं भक्ती कोइलोअ खांबोहो तोड़ीत टाकजा, आन तियांआं आशेरा नावोअ मुर्तीही पाड़ीत टाकजी.”<note caller="+" style="x"><char style="xo" closed="false">34:13 </char><char style="xt" closed="false"><ref loc="DEU 16:21">कायदा 16:21</ref> </char></note><verse eid="EXO 34:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 34:14" />“बिहीरा कोडाहाज देव कोत मा मानही; काहाके यहोवा जियाअ नाव ठोटाय कोअनारु देव होय, खिजवात उठनारु देव होय. <verse eid="EXO 34:14" /><verse number="15" style="v" sid="EXO 34:15" />हेअजी! तु तियांआं देसोअ माअहोंअरी शप्पत मा लेही, आन नेत तें तियांआं देवोअ फासाड़ी जात कोइत सोगदाय कोए, आन तियांआं सामने गाराहा कोए, आन एखु ताहूं नेवतो आपेन तु तियाआ गाराहा कोअल्यी वस्तु खाही. <verse eid="EXO 34:15" /><verse number="16" style="v" sid="EXO 34:16" />आन तु तियांआं पोर्‍यीही ताआ पोर्‍याआ काजे लेत आवही आन ते पोऱ्यी खाराब विसारो वाअहीं तियांआं देवोअ पुंजन कोइलाआ काजे तियांआं वाते लागाड़े.”<verse eid="EXO 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 34:17" />“तुमू देवोअ कोड़ल्यी मुर्ती मा बोणावहा आन तियीइ भक्ती मा कोअहा.<note caller="+" style="x"><char style="xo" closed="false">34:17 </char><char style="xt" closed="false"><ref loc="EXO 20:4">निर्ग 20:4</ref>; <ref loc="LEV 19:4">लेवी 19:4</ref>; <ref loc="DEU 5:8">कायदा 5:8</ref>; <ref loc="DEU 27:15">27:15</ref></char></note><verse eid="EXO 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 34:18" />“विण खमीरोओ रोटाआ तिवार मानजा. तियामेहें माआ आदेसोअ पुरमाणे आबीब मोयनाअ ठरिवल्यी वेलेपोअ हांत दिही जाआं विण खमीरोअ रोटू खाया कोअजा; काहाके तुमू मिसर देसोम रोत आबीब मोयनामेहें निहीत आयेते.”<note caller="+" style="x"><char style="xo" closed="false">34:18 </char><char style="xt" closed="false"><ref loc="EXO 12:4-20">निर्ग 12:4-20</ref>; <ref loc="LEV 23:6-8">लेवी 23:6-8</ref>; <ref loc="NUM 28:25">गणती 28:25</ref></char></note><verse eid="EXO 34:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 34:19" />“हारेक पेलठो माआ होय; आन बोलोद नेताहां, मेडो, ताआ पाल्ल्या मालधनो मेहें रोत जे पेल्लोअ ओय ते आखे माआ होय.<note caller="+" style="x"><char style="xo" closed="false">34:19 </char><char style="xt" closed="false"><ref loc="EXO 13:2">निर्ग 13:2</ref></char></note> <verse eid="EXO 34:19" /><verse number="20" style="v" sid="EXO 34:20" />गोदड़ाआ पेल्लाआ बासाआ हाटे मेडो आपीत कोइत सोड़वीत लेजी, जर तु तियाहा ने सोड़वीइनारु ओय तांहा तियाआ बोस तोड़ीत टाकजी. पोन तुमाआ आखा पेल्लाआ बेटाह्हा हाटे कोइत सोड़वीइजा.<note caller="+" style="f"><char style="fr" closed="false">34:20 </char><char style="ft" closed="false">निर्ग 13:13 </char></note> कोडो बी ठाल्ले आथेज माआ सामने ने आवुहूं जोवे.”<verse eid="EXO 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21" />“सोव दिही जाआं काम कोअजा, पोन हाँतवे दिहे आराम कोअजा; नेत खेड़ीइलोअ आन वाडीलोअ टेमोहों बी आराम कोअजा.<note caller="+" style="x"><char style="xo" closed="false">34:21 </char><char style="xt" closed="false"><ref loc="EXO 31:15">31:15</ref>; <ref loc="EXO 35:2">35:2</ref>; <ref loc="LEV 23:3">लेवी 23:3</ref>; <ref loc="DEU 5:13">कायदा 5:13</ref>,<ref loc="DEU 5:14">14</ref> </char></note><verse eid="EXO 34:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 34:22" />“आन तु आठीवड़ाआ तिवार मानजी जो पेलठो फोलवो गोवोंअ तिवार कोवाअहे, आन वोरहोअ आखरीइ टेमोहों वाडीइलोअ तिवार मानजा.<note caller="+" style="x"><char style="xo" closed="false">34:22 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">लेवी 23:15-21</ref>; <ref loc="NUM 28:26-31">गणती 28:26-31</ref></char></note><verse eid="EXO 34:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 34:23" />“वोरह्योम तिन वारी ताआ आखा माटी इस्राएलोअ प्रभु यहोवाहा तियांआं सोब देखाड़े. <verse eid="EXO 34:23" /><verse number="24" style="v" sid="EXO 34:24" />काहाके आंय बिहीरा देसोहो ताआ आगाड़ी रोत काडीत कोइत ताआ हींव वोदाड़ीहीं; आन वोरह्योमेहें तिन वारी तू ताआ देवोअ सामने हजर रोनू आवही, ताहां ताआ जागाआ कोडो लालस ने कोए.<verse eid="EXO 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25" />“माआ गाराहा आपल्या रक्ताहा खमीरवाला रोटाअरी अर्पण ने कोअहूं जोवे. वल्हांडण तिवारोअ गाराहा आपल्या वस्तुमेहें रोत कीज वेगीइ जाआं मा रोअहूं देहा.<note caller="+" style="x"><char style="xo" closed="false">34:25 </char><char style="xt" closed="false"><ref loc="EXO 12:10">निर्ग 12:10</ref></char></note><verse eid="EXO 34:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 34:26" />“पाकला ओनोअ पेलठो फोलवो ताआ देवोअ कोअमेहें लेत आवजी; बोकड़ाआ गिद्लाआ माहां तियाआ आयहीइ दुदोमेहें मा रांदही.”<note caller="+" style="x"><char style="xo" closed="false">34:26 </char><char style="xt" closed="false"><ref loc="EXO 23:19">निर्ग 23:19</ref>; <ref loc="DEU 24:21">कायदा 24:21</ref>; <ref loc="DEU 26:2">26:2</ref></char></note><verse eid="EXO 34:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 34:27" />ताहां यहोवा देवे मोशेहे कोयो, “आंय कोयीही ए आखी गोठी लेखीत मिक; काहाके यींज गोठी वाअहीं आंय ताअरी आन इस्राएली माअहोंअरी शप्पत खादीही.” <verse eid="EXO 34:27" /><verse number="28" style="v" sid="EXO 34:28" />मोशे तिहीं देवोअरी सालिही दिही आन सालिही रात रोयू; ताअहूं जाआं तिये रोटू पाईं ने पिदो. आन तिये ते शप्पतोअ गोठ्यी बेन डोणोअ पाटी पोअ लेखी देदी.<verse eid="EXO 34:28" /></para>
  <para style="s">मोशेए सिनाय डोगो पोअ रोत निसे उतरीइत्लू</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 34:29" />जेहेलाम मोशे देवोअ साक्शीइ बेनू पाटी लेत निसे उतरीइतुतो, तेहेलाम देवोअरी गोठी कोइलाआ वाअहीं तियाआ मुखोअ पोअ रोत उजालो निहीतोतो, पोन तियाहा ओं ने मुंदू गोयू. के तियाआ मुखोअ पोअ रोत उजालो निहेंहे.<note caller="+" style="x"><char style="xo" closed="false">34:29 </char><char style="xt" closed="false"><ref loc="2CO 3:7-16">2 करिन्थ 3:7-16</ref></char></note> <verse eid="EXO 34:29" /><verse number="30" style="v" sid="EXO 34:30" />जेहेलाम आरोन आन आखे इस्राएल मोशेहे पाल्यो के तियाआ मुखोअ पोअ रोत उजाला निहेंहे, ताहां ते तियाआ जागे जाअलाआ बित गोये. <verse eid="EXO 34:30" /><verse number="31" style="v" sid="EXO 34:31" />पोन मोशे तियांहां हाद्ये ताहां आरोन आन इस्राएलोअ माअहोंअ पुडारी तियांअरी गोया ताहां मोशे तियांअरी गोठी कोउ वोल्यू. <verse eid="EXO 34:31" /><verse number="32" style="v" sid="EXO 34:32" />तिहीं फासाड़ी आखे इस्राएल वाले माअहें मोशेए जागे आये आन जे गोठी सिनाय डोगोपोअ देवे तियाहा कोत आप्यीते ते आखी तिये तियांहां कोताप्यी. <verse eid="EXO 34:32" /><verse number="33" style="v" sid="EXO 34:33" />जाअहूं मोशे माअहूंअरी गोगित ने नेवराअयू ताअहूं जाआं तो तियाआ सोब कापड़ वाअहीं टापित रोयू. <verse eid="EXO 34:33" /><verse number="34" style="v" sid="EXO 34:34" />पोन कोड्ली बी वेले मोशे जेहेलाम देवोअ जागेहे गोठी कोउ जातुतो, तेहेलाम सोबी पोअ रोत कापड़ काडीत लेतुतो; फाशू बारथे आवतुतो तेहेलाम देवे जे गोठी कोयी ओय ते इस्राएल वालाहां माहुंहूं कोत आपतुतो. <verse eid="EXO 34:34" /><verse number="35" style="v" sid="EXO 34:35" />मोशेए समकीइनारी सोब इस्राएलवाले माहें पालतेते, ताहां तो फाशुउ तियाआ सोब टापित लेतुतो; आन देवोअरी गोगीइलोअ काजे फाशुउ जाय ताअहूं जाआं तो कापड़ वाअहीं टापित मिकतुतो.<verse eid="EXO 34:35" /></para>
  <chapter eid="EXO 34" />
  <chapter number="35" style="c" sid="EXO 35" />
  <para style="s">आरामोअ दिहोहो नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1" />मोशे इस्राएलोअ आखी मंडड़ीही टोलू वालित कोइत तियांहां कोयो, “जे कामे कोइलाआ आदेश यहोवा आप्युहू तो ओ होय: <verse eid="EXO 35:1" /><verse number="2" style="v" sid="EXO 35:2" />सोव दिही काम काज कोअजा, पोन हांतवु दिही तुमाआ काजे सोकू आन यहोवाआ काजे वोडू आरामोअ दिही ठोरे; तियामेहें जो कोडो काम काज कोए तियाहा मोइत टाकजा;<note caller="+" style="x"><char style="xo" closed="false">35:2 </char><char style="xt" closed="false"><ref loc="EXO 20:8-11">निर्ग 20:8-11</ref>; <ref loc="EXO 23:12">23:12</ref>; <ref loc="EXO 31:15">31:15</ref>; <ref loc="EXO 34:21">34:21</ref>; <ref loc="LEV 23:3">लेवी 23:3</ref>; <ref loc="LEV 5:12-14">5:12-14</ref></char></note> <verse eid="EXO 35:2" /><verse number="3" style="v" sid="EXO 35:3" />आरामोअ दिहे तुमू तुमाआ कोअमेहें आग बी मा पेटाड़हा.”<verse eid="EXO 35:3" /></para>
  <para style="s">सोका तोंबाआ कोअते भेट</para>
  <para style="r">(<ref loc="EXO 25:1-9">निर्ग 25:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4" />फाशोअ मोशे इस्राएलोअ आखा माअहोंहों कोयो, “जियी गोठीइ आदेश यहोवा देवे आप्युहू तो ओ होय: <verse eid="EXO 35:4" /><verse number="5" style="v" sid="EXO 35:5" />तुमू यहोवा देवोअ काजे भेट लेत आवुहूं जोवे; देवोअ काजे भेट कोइलोअ जियांआं मोन से इश्शा ओय तें यहोवा देवोअ होनो, सांदी, तांबो; <verse eid="EXO 35:5" /><verse number="6" style="v" sid="EXO 35:6" />निला, जामण्या आन रात्ला रंगोअ हुत आन पात्ला हुतोअ कपड़ो; बोकड़ाआ सिंग्ये; <verse eid="EXO 35:6" /><verse number="7" style="v" sid="EXO 35:7" />रात्ला रंगोवाअहीं रंगल्यो मेडाआ सांबड़ो, सुस नावोअ मासाआ सांबड़ो; बाबल्योअ लाकुड़, <verse eid="EXO 35:7" /><verse number="8" style="v" sid="EXO 35:8" />उजालो आपे तेहें तेल, सोको कोअल्यो तेल आन आगरबत्तीइ काजे गोंदाण्यो मासालो, <verse eid="EXO 35:8" /><verse number="9" style="v" sid="EXO 35:9" />आन एपोद आन सातीइ पोट्टाआ कोअता सुलेमानी मोंड्ये आन जुड़ीइलोअ काजे मोंड्या लेतावुहूं जोवे.”<verse eid="EXO 35:9" /></para>
  <para style="s">यहोवा देवोअ हजरीइ तोंबाआ काजे जाती जातीइ वस्तु</para>
  <para style="r">(<ref loc="EXO 39:32-43">निर्ग 39:32-43</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10" />“तुमाआ विसमेहें जेतेहे जोएं हुशार कारागीर ओय, ते आखे आवीत कोइत जियी जियी वस्तुउ आदेश यहोवा आप्यू ओय तों आखो बोणावुहूं जोवे. <verse eid="EXO 35:10" /><verse number="11" style="v" sid="EXO 35:11" />देवोअ हजरीइ तोंबू, तोंबू तियाआ टापीइलोअ पोड़दू, आकड़ा, रिपे, सोवकट, खांबा, आन कुर्सी; <verse eid="EXO 35:11" /><verse number="12" style="v" sid="EXO 35:12" />फाश्योअ शप्पतोअ पेटी आन तियाआ डांडा, आन दयासनोअ टापणो, आन विसमेऱ्युउ पोड़दू; <verse eid="EXO 35:12" /><verse number="13" style="v" sid="EXO 35:13" />डांडाआ आन आखा सामानोअरी टेबल, आन भेटेए रोटा; <verse eid="EXO 35:13" /><verse number="14" style="v" sid="EXO 35:14" />उजालाआ काजे दिवाआ खांब, तियाआ बाकी सामान आन उजालो आपे तेहें तेल; <verse eid="EXO 35:14" /><verse number="15" style="v" sid="EXO 35:15" />डांडाअरी आगरबत्तीइ देवान्यो, सोको तेल, हाजो गोंदाण्यो आगरबत्ती, आन रोअलाआ मंडपोअ बाओअ पोड़दू; <verse eid="EXO 35:15" /><verse number="16" style="v" sid="EXO 35:16" />तांबाअ सारी, डांडू एतोहो आखो सामान आन आगीइ देवान्यो, तोपल्यो; <verse eid="EXO 35:16" /><verse number="17" style="v" sid="EXO 35:17" />खांब आन तियाआ कुर्सीइरीज खोलीइ पोड़दा, आन खोलीइ बाअणाआं पोड़दा; <verse eid="EXO 35:17" /><verse number="18" style="v" sid="EXO 35:18" />रोअलाअ आन खोलीइ बेनुउं खुटा, आन दोअड़ी; <verse eid="EXO 35:18" /><verse number="19" style="v" sid="EXO 35:19" />सोका जागा मेहें सेवा कोअनारा काजे विंइल्ये आंगड़े, पुंजाराआ काम कोइलाआ काजे आरोन याजकोओ सोके आंगड़े, आन तियाआ पोऱ्याअ आंगड़े.”<verse eid="EXO 35:19" /></para>
  <para style="s">माअहें भेट लेत आवत्ले</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20" />ताहां इस्राएलवालाआ आखे माअहें मोशे सामने रोत जाते रोये. <verse eid="EXO 35:20" /><verse number="21" style="v" sid="EXO 35:21" />आन जियांआं मोनोम लागो आन इश्शा ओवी, तियां मिलापवाला तोंबाआ कामोअ काजे आन तिहींमेएं आखी सेवाआ काजे आन सोका आंगड़ाआ काजे यहोवा देवोहो भेट लेताये. <verse eid="EXO 35:21" /><verse number="22" style="v" sid="EXO 35:22" />जियांआं मोनोमेहें इश्शा ओवी तें आखे बोईंन माटी आये आन तें आखे नाकन्यी, बिजल्ये, मुंदी, गोलामेर्‍यीइ होनाआ हाकोल आन आखी जातीइ होनाआ सामान लेताये, एहें कोइत आखे माअहें यहोवा देवोअ काजे होनाआ भेट लेताये. <verse eid="EXO 35:22" /><verse number="23" style="v" sid="EXO 35:23" />आन जिया जिया माट्योपोअ निला, जामण्ये नेत रात्ला रंगोअ आंगड़े, सिणा हुतोअ साअको, नेते बोकड़ाआ सिंग्ये, सुस नावोअ मासाआ सांबड़ो नेत रात्ला रंगोवाअहीं रंगल्ये मेडाआ सांबड़े, ते तों लेताया. <verse eid="EXO 35:23" /><verse number="24" style="v" sid="EXO 35:24" />फाशेए जेतेहे माअहें सांदी, आन तांबाआ भेट आपनारे ओते ते यहोवा देवोअ काजे तेहेलीही भेट लेताये; आन जिया जियापोअ सेवाआ कामोअ काजे बाबल्योअ लाकड़े ओते तें लेताये. <verse eid="EXO 35:24" /><verse number="25" style="v" sid="EXO 35:25" />आन जियीं बोईंइ मोनोम बुद्दीइ कला ओती, तियीं सोताआ आथोवाअहीं हुत विंइ-विंइइ निले, जामण्ये आन रात्ला रंगोअ, आन पात्ला हुतो वाअहीं विंइल्ये साअके लेतायी. <verse eid="EXO 35:25" /><verse number="26" style="v" sid="EXO 35:26" />आन जेती बोईंइ मोनोमेहें एहेलिही कला ओती, तियीं बोकड़ाआ सिंग्ये बी विंइये. <verse eid="EXO 35:26" /><verse number="27" style="v" sid="EXO 35:27" />आन पुडारी माटी एपोद आन सातीइ पोट्टाआ काजे सुलेमानी मोंड्या, आन जुड़ीइलोअ काजे मोंड्या, <verse eid="EXO 35:27" /><verse number="28" style="v" sid="EXO 35:28" />आन दिवाआ काजे आन अभिशेकोअ काजे तेल आन आगरबत्तीइ गोंदाण्यो मासालो लेत आया. <verse eid="EXO 35:28" /><verse number="29" style="v" sid="EXO 35:29" />जे जे वस्तु बोणाविलोअ आदेश यहोवा मोशेए वाअहीं आप्युतो, तियाहा कोत जों किबी गरज ओती, तियाहा तें आखे माटीन बोईं मिलीत लेत आये, जियांआं मोनोमेहें एहेलिही इश्शा ओवीते. एहें कोइत इस्राएलवाले यहोवा काजे तियांआं इश्शा वाअहीं भेट लेताये.<verse eid="EXO 35:29" /></para>
  <para style="s">मिलापवाला तोंबाआ काजे कारागीर</para>
  <para style="r">(<ref loc="EXO 31:1-11">निर्ग 31:1-11</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30" />ताहां मोशे इस्राएलोहो कोयो, “उनाआ, यहोवा देवे यहुदाआ पारवाड़ी बसालेलोहो, जो ऊरीइ बेटुह्हू आन हुरोअ घराणाआ होय, तियाहा नाव लेत कोइत हाद्युहू; <verse eid="EXO 35:30" /><verse number="31" style="v" sid="EXO 35:31" />आन तिये तियाहा देवोअ आत्मावाअहीं आपित कोइत ओकल, बुद्दी, समज आन कला आप्यीही. <verse eid="EXO 35:31" /><verse number="32" style="v" sid="EXO 35:32" />काहाके तो कारागिरीइ कामे कोइत सेकुहूं जोवे, आन होनो, सांदी आन तांबो याआ काम कोइत सेके; <verse eid="EXO 35:32" /><verse number="33" style="v" sid="EXO 35:33" />आन जुड़ीइलोअ काजे मोंड्या तोड़ीत सेके, आन लाकड़ूपोअ नक्शी कोरवीइलोअ काम, आन आखी जातीइ कारागिरीइ कामे कोइत सेके. <verse eid="EXO 35:33" /><verse number="34" style="v" sid="EXO 35:34" />फाशोअ यहोवा देवे तियाआ मोनोमेहें दानोअ पारवाड़ीइ अहिसामाकोअ पोऱ्यु अहलियाबोअ मोनोमेहें बी सिकाड़ीलोअ सेक्ती आप्यीही. <verse eid="EXO 35:34" /><verse number="35" style="v" sid="EXO 35:35" />नक्शीइ कामे कोइला मेहें आन कारागिरीइ कामे आन निला, जामण्या, आन रात्ला रंगोअ आंगड़े, आन पात्ला हुतो वाअहीं बोणावल्या कपड़ापोअ गुथनारे, आंगड़े विंइनारे आन आखी जातीइ कारागिरीइ कामे कोअनारे बाहरी कामोअ योजना कोअनारे एहेला आखाआ काजे तिये यां बेन जोओंअ मोनोमेहें बुद्दी पोअयी.”<verse eid="EXO 35:35" /></para>
  <chapter eid="EXO 35" />
  <chapter number="36" style="c" sid="EXO 36" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 36:1" />“बसालेल आन अहलियाब आन आखे हुशार माअहें जियांहां यहोवा देवे एहेलिही हुशार बुद्दी आन समज आप्यीते के तें यहोवाआ आखा आदेशोअ पुरमाणे सोका जागाआ सेवाआ काजे आखी जातीइ कामे कोइत सेके.”<verse eid="EXO 36:1" /></para>
  <para style="s">माअहें जाअखीलीही भेट लेत आवत्ले</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2" />ताहां मोशे बसालेल आन अहलियाब आन आखा हुशार माअहोंहों जियांअ मोनोमेहें यहोवा देवे खास बुद्दी आप्यीते, या कामोमेहें मदत आन सेवा कोइलाआ तियांआं इश्शा ओती. <verse eid="EXO 36:2" /><verse number="3" style="v" sid="EXO 36:3" />आन इस्राएलवाले माअहें जे जे भेट लेत आयेते, ते आखी भेट तियां मोशेए जागेहे रोत सोकू तोंबु बोणावीइलोअ काजे लेत आया. माअहें सोताआ खुसी वाअहीं तियांआं भेट लेत आविइलोअ सालुज मिक्यो. <verse eid="EXO 36:3" /><verse number="4" style="v" sid="EXO 36:4" />आन सोका जागाम काम कोअनारा आखा खास बुद्दीवाला कारागिर तियांआं काम सोड़ीत कोइत मोशेए जागेहे आया, <verse eid="EXO 36:4" /><verse number="5" style="v" sid="EXO 36:5" />आन कोना वोल्या, “जिया कामोहों कोइलाआ आदेश यहोवा देवे आप्युहू तियाहा जेतीही वस्तु जोवे तिया रोत बी जाअखो तें लेत आयेहे.”<verse eid="EXO 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 36:6" />ताहां मोशे पोड़ावामेहें या आदेशोअ परसार कोआड़्यु, “माटी ओय, नेते बोईं ओय, कोडोज सोका जागाआ काजे भेट मा लेत आवहामे.” ताहां माअहें भेट लेत आविलोअ बोंद ओवो <verse eid="EXO 36:6" /><verse number="7" style="v" sid="EXO 36:7" />काहाके आखो काम बोणावीइलाअ काजे जेत्ता सामानोअ गरज ओती, तियाआ रोत जाअखो सामान पोतीत लागोतो.<verse eid="EXO 36:7" /></para>
  <para style="s">यहोवाअ हजरीइ तोंबु बोणाविलोअ</para>
  <para style="r">(<ref loc="EXO 26:1-37">निर्ग 26:1-37</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8" />काम कोअनारे जेतेहे बुद्दीमान कारागिर ओते तियें रोअलाअ जागाअ काजे पात्ला हुतोअ वाअहीं बोणल्ये आंगड़ाआ, आन निला, जामण्यो आन रात्ला रंगोअ हुतोअ दोहो पोड़दाआ फाकावाला देवदूतोअरीज सित्रे हिंव्ये. <verse eid="EXO 36:8" /><verse number="9" style="v" sid="EXO 36:9" />एकेक पोड़दू आँठ्ठावीस आथ नांबू <note caller="+" style="f"><char style="fr" closed="false">36:9 </char><char style="fq" closed="false">आँठ्ठावीस आथ नांबू </char><char style="ft" closed="false">बारा मिटर नांबू </char></note>आन शार आथ पोली ओतू; आखा पोड़दा एकाज मापोअ बोणायाते. <verse eid="EXO 36:9" /><verse number="10" style="v" sid="EXO 36:10" />तिये पास पोड़दा एकान एकाअरी जोड़ी देदा, आन बिहीरे पास पोड़दा बी एकानेकाहा जोड़ी देदा. <verse eid="EXO 36:10" /><verse number="11" style="v" sid="EXO 36:11" />आन जिहीं ए पोड़दा जुड़्या तिहीं बेनू कोरेपोअ तिये निला निला फांदा लागाड़्या. <verse eid="EXO 36:11" /><verse number="12" style="v" sid="EXO 36:12" />तिये बेनू कोरे पोअ पोन्नास पोन्नास फांदा एहें कोइत लागाड़्या के ते एकान एकाअ सामने ओता.<verse eid="EXO 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 36:13" />आन तिये पोन्नास पोन्नास होनाआ आकड़ा बोणावया, आन तियां वाअहीं पोड़दाहा एकान एकाअरी जोड़ी देदे आन तियां आखाहा जोडीत कोइत एक रोअलाआ मंडप बोणित गोयू. <verse eid="EXO 36:13" /><verse number="14" style="v" sid="EXO 36:14" />फाशोअ रोअलाआ तोंबाआ उपोअ तोंबाआ काजे तिये बोकड़ाआ सिंग्याआ ईग्यार पोड़दा बोणाया. <verse eid="EXO 36:14" /><verse number="15" style="v" sid="EXO 36:15" />एक एक पोड़दाआ लांबी तीस आथ आन पोली शार आथोअ ओवी; आन ईग्यार पोड़दा एकाज मापोअ ओता. <verse eid="EXO 36:15" /><verse number="16" style="v" sid="EXO 36:16" />तियामेहें रोत तिये पास पोड़दा आलाग आन सोव पोड़दा आलाग जोड़ी देदा. <verse eid="EXO 36:16" /><verse number="17" style="v" sid="EXO 36:17" />आन जिहीं बेनू जोड़ी देदा तिहींइं कोरे पोअ पोन्नास पोन्नास फांदा लागाड़्या. <verse eid="EXO 36:17" /><verse number="18" style="v" sid="EXO 36:18" />आन तिये तोंबा जुड़ीइलोअ काजे तांबाआ पोन्नास आकाड़ा बी बोणावया जिया वाअहीं तो एक ओत जाय. <verse eid="EXO 36:18" /><verse number="19" style="v" sid="EXO 36:19" />आन तिये तोंबाआ काजे रात्ला रंगोवाअहीं रंगल्ये मेडाआ सांबड़ाआ एक फांगरुउ बोणायो आन तियापोअ सुस नावोअ मासाआ सांबड़ाआ टापणो बोणायो.<verse eid="EXO 36:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 36:20" />फाशोअ तिये रोअलाअ तोंबाआ काजे बाबल्योअ लाकड़ाआ रिपाहा उबे रोय तेहें काजे बोणावये. <verse eid="EXO 36:20" /><verse number="21" style="v" sid="EXO 36:21" />एकेक रिपाआ लांबी दोह आथ आन पोली डेड़ आथोअ ओवी. <verse eid="EXO 36:21" /><verse number="22" style="v" sid="EXO 36:22" />एकेका रिपामेहें रोत एकानेकाहा जुड़ीइलोअ काजे बेन बेन खाते बोणाये, मिलापवाला तोंबाआ आखे रिपे तिये एहेंज कोइत बोणावये.<verse eid="EXO 36:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 36:23" />तिये मिलापवाला तोंबाआ कोअते रिपाहा बोणावये के देहामोअ वोल विही रिपे लागे; <verse eid="EXO 36:23" /><verse number="24" style="v" sid="EXO 36:24" />आन तिया विही रिपाआ निसे सांदीइ सालिही खाते, मोन्जे एकेक रिपाआ निसेए तियाआ बेन बुंद्याआ काजे तिये बेन खाते बोणाये. <verse eid="EXO 36:24" /><verse number="25" style="v" sid="EXO 36:25" />आन मिलापवाला तोंबापोअ बिहीरी वोल, मोन्जे पालामाआ वोलेहे बी तिये विही रिपे बोणाये; <verse eid="EXO 36:25" /><verse number="26" style="v" sid="EXO 36:26" />आन तियांआं काजे बी तिये सांदीइ सालही पाया, मोन्जे एक एकाअ रिपाआ निसे बेन बेन पाया बोणाया. <verse eid="EXO 36:26" /><verse number="27" style="v" sid="EXO 36:27" />आन मिलापवाला तोंबाआ फासाड़ी वोल, मोन्जे बुट्टामाआ वोलेहे तिये सोव रिपे बोणावये. <verse eid="EXO 36:27" /><verse number="28" style="v" sid="EXO 36:28" />आन फासाड़ीइ वोल्याआ भागोअ काजे खुणाआ काजे तिये बेन रिपे बोणावये. <verse eid="EXO 36:28" /><verse number="29" style="v" sid="EXO 36:29" />ते निसे रोत बेन बेन भागोअ बोण्ये, आन बेनू भाग उपोअ जाआं एकेकी कोड़ीमेहें जुड़ी देदे; तिये तियां बेनू रिपाआ आकार एहलुज बोणावयू. <verse eid="EXO 36:29" /><verse number="30" style="v" sid="EXO 36:30" />एहेंकोइत आँठ रिपे ओवे, आन तियांआं सांदीइ होल खाते ओवे; मोन्जे एक एक रिपाआ निसे बेन बेन खाते ओवे.<verse eid="EXO 36:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 36:31" />तिये बाबल्योअ लाकड़ाआ डांडा बोणाया, मोन्जे मिलापवाला तोंबाआ एकी वोलेहे काजे पास डांडा, <verse eid="EXO 36:31" /><verse number="32" style="v" sid="EXO 36:32" />आन मिलापवाला तोंबाआ बिहीरी वोलेहे रिपाआ काजे पास डांडा, फासाड़ी बुट्टामाआ वोल ओतू तियाआ काजे बी पास डांडा बोणाया. <verse eid="EXO 36:32" /><verse number="33" style="v" sid="EXO 36:33" />आन तिये विस मेऱ्याआ सोवकटीइ रिपाआ विसमेहें रोत तोंबाआ एकी मेरे रोत बिहीरी मेरे जाआं पोते एहेलोहो बोणायो. <verse eid="EXO 36:33" /><verse number="34" style="v" sid="EXO 36:34" />आन रिपाहा तिये होना वाअहीं मोडाड़्ये, आन डांडाआ आलवीइलोअ कोड़्यी बी होनाआ बोणावयी, आन डांडा बी होनावाअहीं मोडाड़्या.<verse eid="EXO 36:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35" />फाशोअ तिये निला, जामण्या आन रात्ला रंगोअ सिणा हुतोअ आंगड़ाआ विसमेऱ्युउ पोड़दू बोणावयू; तिया पोअ तिये करुबोअ सित्रे बोणावये. <verse eid="EXO 36:35" /><verse number="36" style="v" sid="EXO 36:36" />तिये बाबल्योअ लाकड़ाआ शार खांबा बोणावया, आन तियांहां होना वाअहीं मोडाड़्या; आन तियांआं आकड़्यी होना वाअहीं मोडाड़्यी, तियांआं काजे तियें सांदीइ शार कुर्सी बोणावयी. <verse eid="EXO 36:36" /><verse number="37" style="v" sid="EXO 36:37" />तिये तोंबाआ बाअणाआ काजे निला, जामण्या, रात्ला रंगोअ साअकाआ आन सिणा हुतोअ साअकाआ नक्शीइ काम कोअल्या पोड़दू बोणावयू. <verse eid="EXO 36:37" /><verse number="38" style="v" sid="EXO 36:38" />आन तिये पास खांबा आन तियांअरी आकड़ा बी बोणावयी. तियांआं उपऱ्युउ भाग आन तियांआं जुड़ीइलोअ बांदपोट्टीही होना वाअहीं मोडाड़्यी; आन तांबाआ पास पाया बोणाया.<verse eid="EXO 36:38" /></para>
  <chapter eid="EXO 36" />
  <chapter number="37" style="c" sid="EXO 37" />
  <para style="s">शप्पतोअ पेटी बोणावट</para>
  <para style="r">(<ref loc="EXO 25:10-22">निर्ग 25:10-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1" />बसालेले बाबल्योअ लाकड़ाआ एक शप्पतोअ पेटी बोणावयी; ते आड़ीस आथ नांबी, डेड़ आथ सोवड़ी, आन डेड़ आथ उसी ओती. <verse eid="EXO 37:1" /><verse number="2" style="v" sid="EXO 37:2" />तिये तियी पेटीही मायतेन बारथे सोका होना वाअहीं मोडाड़्यी. आन तियीइ शारु वोल होनाआ कोर बोणावयी. <verse eid="EXO 37:2" /><verse number="3" style="v" sid="EXO 37:3" />तियी पेटीइ शारु पायाहा लागाड़ीइलोअ काजे एकी वोग बेन आन बिहीरी वोग बेन एहें कोत कोड़ी लागाड़्यी. <verse eid="EXO 37:3" /><verse number="4" style="v" sid="EXO 37:4" />फाशा पवित्र पेटी उसलीत लेत जाअलोअ कोअते तियां बाबल्योअ लाकड़ाआ बेन डांडा बोणावया आन तियांहां होना वाअहीं मोडाड़्या. <verse eid="EXO 37:4" /><verse number="5" style="v" sid="EXO 37:5" />शप्पतोअ पेटी आखलीइलोअ काजे ते डांडा बेनू वोगेहे तियीं कोड़ीमेहें टाक्या. <verse eid="EXO 37:5" /><verse number="6" style="v" sid="EXO 37:6" />तिहीं रोत तिये सोका होनाआ दयासनोअ टापणो बोणावयो; तियाआ लांबी आड़ीस आथ आन सोवड़ाय डेड़ आथोअ ओती. <verse eid="EXO 37:6" /><verse number="7" style="v" sid="EXO 37:7" />तिये होनो टाकीत कोइत बेन करुब देवदूत दयासनोअ बेनू मेरे पोअ बोणावये. <verse eid="EXO 37:7" /><verse number="8" style="v" sid="EXO 37:8" />एक करुब एकी मेरे आन एक करुब बिहीरी मेरे पोअ बोणावयू; तिये तियांहां होनाआ एकाज तुकड़ा वाअहीं बोणावया. <verse eid="EXO 37:8" /><verse number="9" style="v" sid="EXO 37:9" />तियां करुबोअ फाके उपोअ रोत एहलेहे पसरीइये, के तिहीं वाअहीं दयासन टापाअयोतो, आन तियांआं सोब हुंबाहुंब आन दयासनोअ टापणाआ वोल कोइत ओती.<verse eid="EXO 37:9" /></para>
  <para style="s">रोटाआ काजे सोका टेबलोअ बोणावट</para>
  <para style="r">(<ref loc="EXO 25:23-30">निर्ग 25:23-30</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10" />फाशोअ तिये बाबल्योअ लाकड़ाआ रोटाआ टेबल बोणावयू; तो बेन आथ नांबू, एक आथ पोलू, आन डेड़ आथ उसू ओतू; <verse eid="EXO 37:10" /><verse number="11" style="v" sid="EXO 37:11" />आन तिये तियाहा सोका होना वाअहीं मोडाड़्यू, आन तियामेहें शारी वोगेहे होनाआ एक वाड़ बोणायी. <verse eid="EXO 37:11" /><verse number="12" style="v" sid="EXO 37:12" />आन तिये तियाआ काजेहे शार आंगली पोली कोर बोणायी आन यी कोरीइ काजे शारी वोगेहे होनाआ वाड़ बोणावयी. <verse eid="EXO 37:12" /><verse number="13" style="v" sid="EXO 37:13" />तिये रोटाआ टेबलोअ काजे होनाआ शार गोल कोड़ी बोणावीत कोइत तियां शारु पायाआ शारु खुणामेहें लागाड़्यी. <verse eid="EXO 37:13" /><verse number="14" style="v" sid="EXO 37:14" />ते कोड़ी कोरीइ जागे खुणापोअ ओती, तिहींमेहें डांडा टाकीत टेबल उसलीइता आवतुतो. <verse eid="EXO 37:14" /><verse number="15" style="v" sid="EXO 37:15" />तिये टेबल उसलीइलोअ कोअते तियां डांडाहा बाबल्योअ लाकड़ाआ बोणावया आन तियांहां होना वाअहीं मोडाड़्या. <verse eid="EXO 37:15" /><verse number="16" style="v" sid="EXO 37:16" />तिहीं तिये टेबलोपोर्‍येए बासने मोन्जे पारात, तुमाणाआं बासन, वाटका, जेग आखे सोका होनाआ बोणावये.<verse eid="EXO 37:16" /></para>
  <para style="s">दिवाआ खांबाआ बोणावट</para>
  <para style="r">(<ref loc="EXO 25:31-40">निर्ग 25:31-40</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17" />तिये सोका होनाआ दिवाआ खांब बोणायू. ओ दिवाआ खांब तियाआ पाट्ली, तियाआ डांडू, तियाआ वाटी, तियाआ डुड्ड्या आन तियाआ फुले ओं आखो पुरा एकाज तुकड़ाआ बोणायो.<verse eid="EXO 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 37:18" />या दिवाआ खांबाम सोव फेगड़ा ओता; ते एकी वोग तिन आन एकी वोग तिन ओता; <verse eid="EXO 37:18" /><verse number="19" style="v" sid="EXO 37:19" />तियां आखा फेगड़ामेहें बादामोअ फुलोअ होस एकेक डुड्ड्यू आन एकेक फुल बोणायो; एकी वोग बी तेहेंज कोइत तिनू फेगड़ाम बादामोअ फुलोअ होस एकेक डुड्ड्यू आन एकेक फुल बोणायो; दिवाम रोत निहील्या तियां सोव फेगड़ाआ बोणावट एहेंज कोइत ओवी. <verse eid="EXO 37:19" /><verse number="20" style="v" sid="EXO 37:20" />आन दिवाआ डांडामेहें बादामोअ फुलोअ होस डुड्ड्यान फुलोअरीज शार वाटकी ओती. <verse eid="EXO 37:20" /><verse number="21" style="v" sid="EXO 37:21" />आन दिवाम रोत निहील्यी सोव डालीमेहें रोत बेन बेन डालीइ निसे एक एक पेर दिवाअरीज एकाज तुकाड़ाआ बोण्यी. <verse eid="EXO 37:21" /><verse number="22" style="v" sid="EXO 37:22" />पेर आन डाली आखे दिवाअरीज एकाज तुकड़ाआ बोण्यी; आखु दिवू सोका होना वाअहीं आन एकाज तुकाड़ाआ बोणावयोतो. <verse eid="EXO 37:22" /><verse number="23" style="v" sid="EXO 37:23" />आन तिया दिवाआ खांबोअ हांत दिवा आन सिपटा आन वाटकी सोका होनाआ बोणायी. <verse eid="EXO 37:23" /><verse number="24" style="v" sid="EXO 37:24" />तिये आखा सामानोअरीज दिवाहा एक आंदास शोवतीस किला सोका होनाआ बोणावयो.<verse eid="EXO 37:24" /></para>
  <para style="s">देवान्याआ बोणावट</para>
  <para style="r">(<ref loc="EXO 30:1-5">निर्ग 30:1-5</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25" />फाशोअ तिये बाबल्योअ लाकड़ाआ तुमाणाआ देवान्यो बी बोणावयो; तियाआ लांबी आन पोली एक एक आथोअ ओती; तों शार खुणाआ बोण्यो, आन तों बेन आथोअ उसो ओतो; आन तियाआ हिंगे एकुज तुकाड़ाआ बोणायेते. <verse eid="EXO 37:25" /><verse number="26" style="v" sid="EXO 37:26" />उपऱ्याआ खुणा, तियाआ शारु वोल हिंगोअरीज तुमाणाआ देवान्याहा सोका होना वाअहीं मोडाड़्यो; आन तियाआ शारु वोल होनाआ एक वाड़ बोणायी, <verse eid="EXO 37:26" /><verse number="27" style="v" sid="EXO 37:27" />आन तियीइ वाड़ीइ निसे तियाआ बेनू मेरेपोअ तिये होनाआ बेन कोड़ी बोणावयी, देवान्यो आखलीत लेत जाअलो काजे. <verse eid="EXO 37:27" /><verse number="28" style="v" sid="EXO 37:28" />आन डांडाहा तिये बाबल्योअ लाकड़ाआ बोणावये, आन होना वाअहीं मोडाड़्यो.<verse eid="EXO 37:28" /></para>
  <para style="s">सोको तेल आन हाजी गोंदाअनारी वस्तुउ बोणावट</para>
  <para style="r">(<ref loc="EXO 30:22-38">निर्ग 30:22-38</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29" />मोशे सोको तेल आन अभिशेकोअ तेल तुमाणाआ काजे गोंदेए इसाबो वाअहीं बोणावयो.<verse eid="EXO 37:29" /></para>
  <chapter eid="EXO 37" />
  <chapter number="38" style="c" sid="EXO 38" />
  <para style="s">आगीइ देवान्याआ बोणावट</para>
  <para style="r">(<ref loc="EXO 27:1-8">निर्ग 27:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1" />फाशुउ मोशे बाबल्योअ लाकड़ाआ एक आगीइ देवान्यो बी बोणावयो; तों पास आथ नांबो आन पास आथ पोलो ओतो, एहें कोइत तों शार खुण्यो बोण्यो आन तिन आथ उसो ओतो. <verse eid="EXO 38:1" /><verse number="2" style="v" sid="EXO 38:2" />तिये तियाआ शारु खुणापोअ शार हिंगे बोणाये, देवान्यो आन हिंगे पुरा एकाज लाकड़ुउ बोणायोतो; आन तिये तियाहा तांबावाअहीं मोडाड़्यो. <verse eid="EXO 38:2" /><verse number="3" style="v" sid="EXO 38:3" />आन मोशे देवान्याआ आखो सामान, मोन्जे तोपल्ये, पावड़े, वाटकी, दाताल पावड़े, खाआं हाडीइलोअ बासने, ओं आखो सामान तांबाआ बोणायो. <verse eid="EXO 38:3" /><verse number="4" style="v" sid="EXO 38:4" />तिये देवान्याआ सोमकीर सुटीइ निसे तांबाआ सारी बोणायी; ते देवान्याआ निसे आरदाम रोत उसे ओती. <verse eid="EXO 38:4" /><verse number="5" style="v" sid="EXO 38:5" />तिये तांबाआ सारीइ शारु मेरेए शार कोड़ी ठासाम टाकीत बोणायी, ते तिये तियामेहें डांडा टाकीत उसलीत लेत जाअलोअ काजे बोणायी. <verse eid="EXO 38:5" /><verse number="6" style="v" sid="EXO 38:6" />फाशोअ तियें डांडाहा बाबल्योअ लाकड़ाआ बोणावयो आन तांबावाअहीं मोडाड़्यो. <verse eid="EXO 38:6" /><verse number="7" style="v" sid="EXO 38:7" />ताहां तिये देवान्याहा उसलीत लेत जाअलोअ काजे तियाआ मेरे कोड़ीमेहें डांडा टाक्या. देवान्याहा तिये रिपा वाअहीं कावलो बोणायो.<verse eid="EXO 38:7" /></para>
  <para style="s">तांबाअ तोपल्याआ बोणावट</para>
  <para style="r">(<ref loc="EXO 30:18">निर्ग 30:18</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8" />तिये तोपल्यो आन तियाआ बेनू पाया तांबाआ बोणाया, ओं मिलापवाला तोंबाआ बाअणापोअ सेवा कोअनारी बोईंइ आरहाआ तांबो ओतो.<verse eid="EXO 38:8" /></para>
  <para style="s">मिलापवाला तोंबाआ खोलीइ बोणावट</para>
  <para style="r">(<ref loc="EXO 27:9-19">निर्ग 27:9-19</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9" />फाशोअ तिये खोली बोणायी; आन तियाहा देहामाआ वोल्यीइ खोलीइ काजे पात्ला हुतोअ पोड़दा बोणाया आन ते आखाज एक होव आथ नांबा ओता; <verse eid="EXO 38:9" /><verse number="10" style="v" sid="EXO 38:10" />तियांआं कोअते विही खांबे, आन तियांआं तांबाआ विही खाड्डा बोणाया; खांबोअ आकड़ी आन तियाहा जुड़ीइलोअ बांदपोट्टी सांदीइ बोणायी. <verse eid="EXO 38:10" /><verse number="11" style="v" sid="EXO 38:11" />आन पालामाआं वोल्यीइ खोलीइ काजे पात्ला हुतोअ पोड़दा बोणाया आन ते आखाज एक होव आथ नांबा ओता; खांबोअ आकड़ी आन तियाहा जुड़ीइलोअ बांदपोट्टी सांदीइ बोणायी. <verse eid="EXO 38:11" /><verse number="12" style="v" sid="EXO 38:12" />आन बुट्टामाआं वोल्यीइ खोलीइ काजे पात्ला हुतोअ पोड़दा बोणाया आन ते आखाज पोन्नास आथ नांबा ओता; तियांआं कोअते दोहो खांबे आन दोहो पाया ओता, आन खांबोअ आकड़ी आन तियाआ बांदीइलोअ बांदपोट्टी सांदीइ ओती. <verse eid="EXO 38:12" /><verse number="13" style="v" sid="EXO 38:13" />आन उगताआ वोगेहे बी ते पोन्नास आथोअ ओता. <verse eid="EXO 38:13" /><verse number="14" style="v" sid="EXO 38:14" />खोलीइ बाअणाआ एकी वोलेहे पोनर आथ नांबा जुड़ीत बोणावल्या पोड़दा ओता; आन तियाआ काजे तिन खांब आन तिन खाड्डा ओता. <verse eid="EXO 38:14" /><verse number="15" style="v" sid="EXO 38:15" />खोलीइ बाअणाआ एकी वोलेहे बी तेहेलोज बोण्योतो; आन खोलीइ बाअणाआ यी वोलेन तिवोल पोनर पोनर आथोअ पोड़दा बोणायाते; आन तियांआं कोअते तिन तिन खांब, आन तिन तिन खाड्डा बी ओता. <verse eid="EXO 38:15" /><verse number="16" style="v" sid="EXO 38:16" />खोलीइ शारु वोग्याआ आखा पोड़दा पात्ला हुतोअ वाअहीं बोणल्या साअकाआ ओता. <verse eid="EXO 38:16" /><verse number="17" style="v" sid="EXO 38:17" />आन खांबोअ खाड्डा तांबाआ, आन आकड़ान बांदपोट्टी सांदीइ ओती, आन तियांआं मुंडे बी सांदी वाअहीं मोडाड़्येते, आन खोलीइ आखा खांब सांदीइ बांदपोट्टी वाअहीं जुड़्याते. <verse eid="EXO 38:17" /><verse number="18" style="v" sid="EXO 38:18" />खोलीइ बाअणाआ पोड़दा नक्शीइ काम कोअल्यो, निला, जामण्या आन रात्ला रंगोअ कपड़ाआ, आन पात्ला हुतोअ कपड़ाआ बोणल्या ओता; आन ते विही आथ नांबा ओता, आन ते खोलीइ जागे पास आथ उसा बोणायाते. <verse eid="EXO 38:18" /><verse number="19" style="v" sid="EXO 38:19" />आन तियांआं काजे शार खांब, आन खांबोअ काजे तांबाआ पाया शार ओता; तियांआं सेंडी सांदी वाअहीं मोडाड़्यीते, आन तियांआं बांदपोट्टी सांदीइ ओती. <verse eid="EXO 38:19" /><verse number="20" style="v" sid="EXO 38:20" />रोअलाअ आन खोलीइ शारु वोल आखा खुटा तांबा वाअहीं बोणायाते.<verse eid="EXO 38:20" /></para>
  <para style="s">देवोअ हजरीम वापरीइलोअ वस्तु</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21" />साक्शीपत्राअ रोअलाअ सामान जो लेवीइ सेवा-साकरीइ काजे बोण्यो, आन जियाआ गणती आरोन पुंजाराआ पोर्‍यू ईतामारोअ वाअहीं मोशेए कोल्या वाअहीं ओवोतो, तियाआ खुलासु ओ होय.<verse eid="EXO 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 38:22" />जियी जियी वस्तुहू बोणावीइलाअ आदेश यहोवा देवे मोशेहे आप्युतो तियाहा यहुदाआ पारवाड़ीइ बसालेल, जो हुरोअ पोर्‍याआ पोर्‍यू आन ऊरीइ पोर्‍यू ओतू तिये बोणावी देदो. <verse eid="EXO 38:22" /><verse number="23" style="v" sid="EXO 38:23" />आन तियाअरी दानोअ पारवाड़ीवाले, अहिसामाकोअ पोर्‍यू, अहलियाब ओतू, जो नक्शी काडनारु आन कोरवीइनारु आन निलो, जामण्यो आन रात्ला रंगोअ आन पात्ला हुतोअ साअकापोअ सित्रे काडनारु हुशार कारागिर ओतू.<verse eid="EXO 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 38:24" />सोका जागाआ पुरा कामोमेहें जों भेटेए होनो लागो तों सोका जागाआ तोलाआ इसाबे एक हाजार बेन किलो ओतो. <verse eid="EXO 38:24" /><verse number="25" style="v" sid="EXO 38:25" />आन मंडड़ीइ गोणल्या माअहोंअ भेटेए सांदी सोका जागाअ तोलाआ हिसाबो वाअहीं तिन हाजार शार होव ओती. <verse eid="EXO 38:25" /><verse number="26" style="v" sid="EXO 38:26" />मोन्जे जेतेहे विही वोरहोअ आन तिया रोत जाअखा वोयोअ गोणाअये, ते सोव लाख तिन हाजार पास होव पोन्नास माटी ओता, आन एकेका जोओंपोअ रोत सोका जागाआ तोलाआ इसाबो वाअहीं आरदो तोलो, जों एक बेका एतोहो ओवेहे तों जोड़्यो.<note caller="+" style="x"><char style="xo" closed="false">38:26 </char><char style="xt" closed="false"><ref loc="MAT 17:24">मत्तय 17:24</ref>; <ref loc="EXO 30:11-16">निर्ग 30:11-16</ref></char></note> <verse eid="EXO 38:26" /><verse number="27" style="v" sid="EXO 38:27" />आन तो लगबग तिन हाजार शार होव किलो गिऱ्याम सांदी सोका जागाआ आन विसमेर्‍याआ पोड़दाआ बेनु खाड्डाआ काजे लागो. एकेक एक खाड्डू एकेक किक्कारोअ<note caller="+" style="f"><char style="fr" closed="false">38:27 </char><char style="fq" closed="false">किक्कार </char><char style="ft" closed="false">एक होव किक्कार ताहां एक आंदास तिन हाजार</char></note> बोण्यू. <verse eid="EXO 38:27" /><verse number="28" style="v" sid="EXO 38:28" />आन सातरा होव सत्तरेन पास शेकेल सांदी खांबाआ काजे, आकड़ीइ काजे, खांबाआ सेंडी मोडाड़ीलोअ काजे, आन आन बांदपोट्टी बोणावीलोअ काजे लागी. <verse eid="EXO 38:28" /><verse number="29" style="v" sid="EXO 38:29" />साड़े सोवीस टनो रोत वादार तांबो देवोअ काजे भेट आप्यो. <verse eid="EXO 38:29" /><verse number="30" style="v" sid="EXO 38:30" />तों लेत कोइत तियाहा काजे मिलापवाला तोंबाआ बाअणाआ खाड्डा, तांबाअ देवान्यो, तांबाआ सारी, आन देवान्याआ आखो सामान; <verse eid="EXO 38:30" /><verse number="31" style="v" sid="EXO 38:31" />आन खोलीइ शारु वोल खाड्डा, आन मिलापवालू तोंबु, आन खोलीइ शारु वोलेहे खुटा बी बोणाया.<verse eid="EXO 38:31" /></para>
  <chapter eid="EXO 38" />
  <chapter number="39" style="c" sid="EXO 39" />
  <para style="s">पुंजाराआ आंगड़े तियार कोइलो</para>
  <para style="r">(<ref loc="EXO 28:1-14">निर्ग 28:1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1" />फाशोअ मोशे यहोवा देवोअ आदेशोअ पुरमाणे, सोकाआ जागाआ सेवाआ काजे निला, जामण्या आन रात्ला रंगोअ वारुहूं हाजे साअके विंइत बोणावये आन आरोनोअ काजे बी सोके आंगड़े बोणावये;<verse eid="EXO 39:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 39:2" />तिये एपोदोहो होनो, आन निला, जामण्या आन रात्ला रंगोअ कपड़ाआ, आन पात्ला हुतोअ बोणल्या कपड़ाआ बोणावयो. <verse eid="EXO 39:2" /><verse number="3" style="v" sid="EXO 39:3" />आन तियां होनाहा टेपरीत कोइत तियाआ पात्रे बोणावये, आन तियां पात्राहा कात्रीत कोइत तात बोणावयी, आन तियी तातेहे निला तियां बुद्दीमान कारागिरों, जामण्या आन रात्ला रंगोअ साअकामेहें, आन सिणा हुतोअ बोणावल्या साअकामेहें पोवी देदी. <verse eid="EXO 39:3" /><verse number="4" style="v" sid="EXO 39:4" />तियां एफोदोअरी खांदपोट्टी जुड़ी देदी; तियाआ बेनू सेंडी जुड़ी देदी. <verse eid="EXO 39:4" /><verse number="5" style="v" sid="EXO 39:5" />तियां कंबर पोट्टू विंइयू आन तो एफोदोहो लागाड़्यु, ओ पोट्टू बी एफोदोअ होसुज मोन्जे होनाआ आन निला, जामण्या आन रात्ला रंगोअ कपड़ाआ, आन पात्ला हुतो वाअहीं बोणल्या कपड़ाआ बोण्युतो; यहोवा देवे मोशेहे कोयो तेहें कोइत कोअयो. <verse eid="EXO 39:5" /><verse number="6" style="v" sid="EXO 39:6" />तियें सुलेमानी मोंड्या कोरवीत कोइत तियामेहें इस्राएलोअ बारा पोर्‍याआ नावे, जेहें ठासु पाड़त्ले तेहें कोइत कोरव्ये, आन होनाआ जालीवाला खाताम पोवी देदा. <verse eid="EXO 39:6" /><verse number="7" style="v" sid="EXO 39:7" />आन तिये तियांहां एपोदोअ खांदपोट्टीपोअ लागाड़्या, जिया वाअहीं इस्राएलोअ काजे ओर कोअनारा मोंड्या ठोरे; जेहें कोइत यहोवा मोशेहे आदेश आप्युतो.<verse eid="EXO 39:7" /></para>
  <para style="s">सातीइ पोट्टाआ बोणावट</para>
  <para style="r">(<ref loc="EXO 28:15-30">निर्ग 28:15-30</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8" />तिये सातीइ पोट्टाहा एपोदोअ होस होनाआ, आन निला, जामण्या आन रात्ला रंगोअ कपड़ाआ, आन पात्ला हुतोअ बोणल्या कपड़ाआ नक्शीइ काम कोअल्या कामोअ जेहें बोणायो. <verse eid="EXO 39:8" /><verse number="9" style="v" sid="EXO 39:9" />सातीइ पोट्टू शोवकड़्यू ओवहूं जोवे काजे बेनी वोल हारको बोणायो, आन तो एक बिलास नांबो आन एक बिलास पोलो बोणायो. <verse eid="EXO 39:9" /><verse number="10" style="v" sid="EXO 39:10" />आन तियां तियामेहें शार रांगीमेहें मोंड्या जुड़्या, आन पेल्लीइ रांगीमेहें माणिक्य; पद्यराग आन लालड़ी जुड़्या; <verse eid="EXO 39:10" /><verse number="11" style="v" sid="EXO 39:11" />आन बिहीरी रांगीमेहें मरकत, निलमणी आन हिरा ओता. <verse eid="EXO 39:11" /><verse number="12" style="v" sid="EXO 39:12" />आन तिसरी रांगीमेहें लसम, सुर्यकांत आन निलम; <verse eid="EXO 39:12" /><verse number="13" style="v" sid="EXO 39:13" />आन शोवथी रांगीमेहें फिरोजा, सुलेमानी डोण, आन यशब जुड़्या; ए आखा होनाआ जालीवाला तातेम पोवी देदा. <verse eid="EXO 39:13" /><verse number="14" style="v" sid="EXO 39:14" />आन एं मोंड्ये इस्राएलोअ पोर्‍याआ गणतीइ अनुसार बारा ओते; बारा पारवाड़ी मेहें रोत एका एकाआ नाव जेहें कोइत साप पाड़े तेहें कोत तेहेंज कोरव्यो. <verse eid="EXO 39:14" /><verse number="15" style="v" sid="EXO 39:15" />आन तियें सातीइ पट्टू नाड़ाआ होस गुथल्या सोका होनाअ हाकोल बोणावीत कोइत लागाड़्यी; <verse eid="EXO 39:15" /><verse number="16" style="v" sid="EXO 39:16" />फाशोअ तियें होनाआ बेन बांगड़्यी, आन होनाअ बेन कोड़ी बोणावीत कोइत बेनू सेवड़ा सातीइ पोट्टाआ जागे उपोअ बेनू मेरेपोअ लागाड़्यी. <verse eid="EXO 39:16" /><verse number="17" style="v" sid="EXO 39:17" />ताहां तियां होनाआ बेनू गुथल्यी हाकलीही सातीइ पोट्टाआ सेंडीपोअ बेनू कोड़ीमेहें लागाड़्यी. <verse eid="EXO 39:17" /><verse number="18" style="v" sid="EXO 39:18" />आन गुथल्या हाकलीइ बेनू सेड़ाहा तियां जुड़ीत कोइत एपोदोअ सामने बेनू खांदपोट्टीपोअ लागाड़्या. <verse eid="EXO 39:18" /><verse number="19" style="v" sid="EXO 39:19" />ताहां तियें होनाआ बेन कोड़ी बोणावीत कोइत सातीइ पोट्टाआ बेनू सेंडीपोअ तियाआ तियी कोरेपोअ, एपोदोअ मायते भागोमेहें ओती तिहीं लागाड़्यी. <verse eid="EXO 39:19" /><verse number="20" style="v" sid="EXO 39:20" />आन तियां होनाआ फाशीइ बेन कोड़ी बोणावीत कोइत एपोदोअ बेनू खांदपोट्टीपोअ मिकीत निसे रोत तियाआ सामने, आन जुड़ीइलोअ जागे रोत एपोदोअ काडल्यी नक्शीइ पोट्टापोअ लागाड़्यो. <verse eid="EXO 39:20" /><verse number="21" style="v" sid="EXO 39:21" />ताहां तियें सातीइ पोट्टाहा तियीइ कोड़ी वाअहीं एफोदोअ कोड़ीमेहें निला दोरा वाअहीं एहेलोहो बांद्यो के तों एपोदोअ काडल्या सातीइ पोट्टापोअ रोय, आन सातीइ पोट्टू एपोदोअ रोत आलाग ने ओवुहूं जोवे; जेहें कोइत यहोवा देवे मोशेहे हुकूम आप्युतो.<verse eid="EXO 39:21" /></para>
  <para style="s">बाकी पुंजाराआ आंगड़ाआ बोणावट</para>
  <para style="r">(<ref loc="EXO 28:31-43">निर्ग 28:31-43</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22" />ताहरोअ एपोदोअ काजे आखो निला रंगोअ कोट बोणावया. <verse eid="EXO 39:22" /><verse number="23" style="v" sid="EXO 39:23" />आन तियाआ बोणाविलोअ एहेलोह ओवो के तियाआ विसमेहें एक डुसू मेक्यु, आन डुसाआ शारु वोल एक कोर बोण्यी के ते फाटीत ने सेके. <verse eid="EXO 39:23" /><verse number="24" style="v" sid="EXO 39:24" />तियां तियाआ निसेए कोरेपोअ निला, जामण्या आन रात्ला रंगोअ कपड़ाआ डाड़ींबे बोणावये. <verse eid="EXO 39:24" /><verse number="25" style="v" sid="EXO 39:25" />तियां सोका होना वाअहीं गोंठी बी बोणावीत कोइत कोटोअ निसे शारु वोल डाड़ींबाआ विस-विसमेहें लागाड़्यी. <verse eid="EXO 39:25" /><verse number="26" style="v" sid="EXO 39:26" />मोन्जे कोटोअ निसे शारु वोल एक होनाआ गोंठी, आन एक डाड़ींबो, फाशीइ एक गोंठी आन एक डाड़ींबो लागाड़्यो एहें कोइत ओवो के ओ कोट पोवित कोइत सेवाआ काम कोए; जेहें कोइत यहोवा मोशेहे हुकूम आप्युतो.<verse eid="EXO 39:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 39:27" />फाशोअ तियें आरोन, आन तियाआ पोर्‍याअ काजे पात्ला हुतोअ साअकाआ कोट बोणावया. <verse eid="EXO 39:27" /><verse number="28" style="v" sid="EXO 39:28" />आन पात्ला हुतोअ कपड़ाआ पागड़ी, आन पात्ला हुतोअ कपड़ाआ हाजी टोपी; आन पात्ला हुतोअ साड्डो, <verse eid="EXO 39:28" /><verse number="29" style="v" sid="EXO 39:29" />आन पात्ला हुतोअ साअकाआ आन निला, जामण्या आन रात्ला रंगोअ नक्शीइ काम कोअल्यो कंबरेए पोट्टू; यां आखाहा जेहें कोइत यहोवा देवे मोशेहे आदेश आप्युतो तेहेंज कोइत बोणावयो. <verse eid="EXO 39:29" /><verse number="30" style="v" sid="EXO 39:30" />फाशोअ तियें सोका टोपापोऱ्यीइ सुटीइ काजे होनाआ सोकी पोट्टी बोणावयी; आन सापोअ काजे तियामेहें नावे कोरव्ये, मोन्जे “यहोवाआ काजे सोके.” <verse eid="EXO 39:30" /><verse number="31" style="v" sid="EXO 39:31" />आन तियें तियामेहें निलु दोरू लागाड़्यु, जिया वाअहीं तो उपोअ पागड़ी पोअ रोय, जेहें कोइत यहोवा मोशेहे आदेश आप्युतो.<verse eid="EXO 39:31" /></para>
  <para style="s">काम पुरो ओवीइलोअ</para>
  <para style="r">(<ref loc="EXO 35:10-19">निर्ग 35:10-19</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32" />एहें कोइत मिलापवाला तोंबाआ आखो काम सेलाअयो, आन जिया जिया कामोअ हुकूम यहोवा मोशेहे आप्यु तो, इस्राएलो तियाआ पुरमाणे कोअयो. <verse eid="EXO 39:32" /><verse number="33" style="v" sid="EXO 39:33" />ताहां ते रोअलाअ तोंबाआ वस्तु मोशेए जागे लेताये, मोन्जे गोल कोड़ी, रिपे, आकड़ी, खांबे, पाया एतोहो आखो सामान. <verse eid="EXO 39:33" /><verse number="34" style="v" sid="EXO 39:34" />आन रात्ला रंगोवाअहीं रंगवीइल्या मेडाआ सांबड़ाआ टापणो, आन सुस नावोअ वोडा मासाआ सांबड़ो, आन विसमेर्‍युउ पोड़दू; <verse eid="EXO 39:34" /><verse number="35" style="v" sid="EXO 39:35" />डांडाअरी साक्शीइ पेटी, आन दयासनोअ टापणो; <verse eid="EXO 39:35" /><verse number="36" style="v" sid="EXO 39:36" />रोटाआ टेबलोअरीज आखो सामान, आन भेटेए रोटू; <verse eid="EXO 39:36" /><verse number="37" style="v" sid="EXO 39:37" />आखा सामानोअरीज सोका होनाआ बोणावल्यू दिवाआ खांब, आन तियाआ होबाड़ल्यू दिवू, उजालो आपे तेहें तेल; <verse eid="EXO 39:37" /><verse number="38" style="v" sid="EXO 39:38" />होनाअ देवान्यो, आन सोको तेल; आन हाजी गोंदाण्यी आगरबत्ती, आन तोंबाआ बाअणाअ पोड़दा; <verse eid="EXO 39:38" /><verse number="39" style="v" sid="EXO 39:39" />तांबाअ सारी, डांडाअरीज आखो सामान आन तांबाअ देवान्यो; आन तोपल्यो; <verse eid="EXO 39:39" /><verse number="40" style="v" sid="EXO 39:40" />खांब आन पायाअरीज खोलीइ पोड़दा, आन खोलीइ बाअणाअ पोड़दा, आन दोरा, आन खुटा, आन मिलापवाला तोंबाआ सेवाआ आखो सामान; <verse eid="EXO 39:40" /><verse number="41" style="v" sid="EXO 39:41" />सोका जागामेहें सेवा कोइलाआ वेले पोइलाआ नक्शी कोअल्ये आंगड़े, आन आरोन पुंजाराआ सोके आंगड़े, आन तियाआ पोर्‍याअ आंगड़े, जियांहां पोवित कोइत तियांहां पुंजाराआ काम कोइलाआ ओतो. <verse eid="EXO 39:41" /><verse number="42" style="v" sid="EXO 39:42" />मोन्जे जो जो आदेश यहोवा मोशेहे आप्युतो तियाआ पुरमाणे इस्राएल आखो काम कोअयो. <verse eid="EXO 39:42" /><verse number="43" style="v" sid="EXO 39:43" />ताहां मोशे आखो काम वारुहूं यहोवा देवोअ आदेशोअ पुरमाणे तियां कोअयो तों पाल्यो ताहां तिये आन मोशे तियांहां आशिर्वाद आप्यू.<verse eid="EXO 39:43" /></para>
  <chapter eid="EXO 39" />
  <chapter number="40" style="c" sid="EXO 40" />
  <para style="s">मिलापवालू तोंबू उबू कोइलू आन तियाआ सोकाय</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1" />यहोवा देवे मोशेहे कोयो, <verse eid="EXO 40:1" /><verse number="2" style="v" sid="EXO 40:2" />“पेहला मोयनाआ पेहला दिहोहो तु मिलापवालू तोंबु उबू कोइ देजी. <verse eid="EXO 40:2" /><verse number="3" style="v" sid="EXO 40:3" />आन तियामेहें साक्शीइ पेटीही मिकीत कोइत पोड़दाआ विसमेहें कोइ देजा. <verse eid="EXO 40:3" /><verse number="4" style="v" sid="EXO 40:4" />आन रोटाआ टेबलोहो मायते लेत जात कोइत जो किबी तियापोअ होबाड़ीलोअ ओय तियाहा होबाड़ी देजा; ताहां दिवाआ खांबाहा मायते लेत जात कोइत तियाआ दिवाहा पेटाड़ी देजा. <verse eid="EXO 40:4" /><verse number="5" style="v" sid="EXO 40:5" />आन साक्शीपत्राआ पेटीइ सामने होनाआ देवान्याहा, जों आगरबत्तीइ काजे होय तियाहा मिकजा, आन मिलापवाला तोंबाआ बाअणाआ पोड़दाहा लागाड़ी देजा. <verse eid="EXO 40:5" /><verse number="6" style="v" sid="EXO 40:6" />आन मिलापवाला तोंबाआ बाअणाआ सामने आगीइ देवान्यो मिकजा. <verse eid="EXO 40:6" /><verse number="7" style="v" sid="EXO 40:7" />आन मिलापवाला तोंबाआ आन देवान्याआ विसमेहें तोपल्यो मिकीत कोइत तियामेहें पाईं पोअजा. <verse eid="EXO 40:7" /><verse number="8" style="v" sid="EXO 40:8" />आन शारु वोल वाड़ बोणावजा, आन खोलीइ बाअणापोअ पोड़दाहा टांगी देजा.”<verse eid="EXO 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 40:9" />“आन सोको तेल लेत कोइत रोअलाअ जागाहा आन जो किबी तियाम ओय तो आखो सोको कोअजा, आन आखो सामान लेत कोइत तियाहा सोको कोअजा; ताहां तो सोको ठरे. <verse eid="EXO 40:9" /><verse number="10" style="v" sid="EXO 40:10" />आखा सामानोअरीज आगीइ देवान्याहा अभिशेक कोइत तियाहा गाराहा कोअजा; ताहां तों जाअखो सोको ठोरे. <verse eid="EXO 40:10" /><verse number="11" style="v" sid="EXO 40:11" />खांबोअरीज तोपल्याहा बी अभिशेक कोइत तियाहा माआ कोअते सोको कोअजा.<verse eid="EXO 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 40:12" />“ताहां आरोन आन तियाआ पोर्‍याहा मिलापवाला तोंबाआ बाअणापोअ लेत जात कोइत पाअयों वाअहीं उंगलावजा, <verse eid="EXO 40:12" /><verse number="13" style="v" sid="EXO 40:13" />आन आरोनोहो सोके आंगड़े पोवाड़जा, आन तियाहा होपीत कोइत तियाहा सोको कोअजा के तो माआ काजे पुंजाराआ काम कोए. <verse eid="EXO 40:13" /><verse number="14" style="v" sid="EXO 40:14" />आन तियाआ पोर्‍याहा जागे लेत आवित कोइत कोट पोवाड़जा, <verse eid="EXO 40:14" /><verse number="15" style="v" sid="EXO 40:15" />आन जेहें कोइत तु तियांआं बाह्हाहा अभिशेक कोअयुहू, तेहेंज कोइत तियांहां बी अभिशेक कोअजी, के ते माआ काजे पुंजाराआ काम कोए; आन तियांआं अभिशेक तियांआं पिड़ी पिड़ीइ काजे तियांआं हादाफोल्याआ पुंजाराआ निशाणी ठोरे.”<verse eid="EXO 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 40:16" />एहें कोइत मोशे, जो जो आदेश यहोवा तियाहा आप्युतो तियाआ पुरमाणे कोअयो. <verse eid="EXO 40:16" /><verse number="17" style="v" sid="EXO 40:17" />आन बिहीरा वोरहोअ पेहला मोयनाआ पेल्लेए दिहे मिलापवालू तोंबू उबू कोअयू. <verse eid="EXO 40:17" /><verse number="18" style="v" sid="EXO 40:18" />मोशे मिलापवालू तोंबू उबू कोआड़्यु, आन तियाआ पाया कोएं तियांआं पाट्ये लागाड़ीत कोइत तियांमेहें तियाआ खांबोहो उबू कोअयू; <verse eid="EXO 40:18" /><verse number="19" style="v" sid="EXO 40:19" />आन तिये मिलापवालू तोंबू उबू कोअयू आन तियापोअ सेवी देदो; जेहें कोइत यहोवा मोशेहे कोयो तेहें कोइत तिये कोअयो. <verse eid="EXO 40:19" /><verse number="20" style="v" sid="EXO 40:20" />आन तिये साक्शी पत्र लेत कोइत पेटीमेहें मिक्यो, आन पेटीमेहें डांडाहा लागाड़ीत कोइत तियापोअ दयासनोअ टापणो मिक्यो; <verse eid="EXO 40:20" /><verse number="21" style="v" sid="EXO 40:21" />आन तिये शप्पतोअ पेटीही तिया तोंबामेहें पोताड़्यी, आन विसमेर्‍याआ पोड़दाहा टांगीत कोइत साक्शीपत्राआ पेटीही तियाआ मायते कोअयो; जेहें कोइत यहोवा मोशेहे कोयो तेहें कोइत कोअयो.<verse eid="EXO 40:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 40:22" />आन तिये मिलापवाला तोंबामेहें रोअलाअ तोंबाआ पालामाआ वोल विसमेर्‍याआ पोड़दाआ बाअथे रोटाआ टेबल लागाड़्यु; <verse eid="EXO 40:22" /><verse number="23" style="v" sid="EXO 40:23" />आन तियापोअ तिये यहोवाआ आगाड़ी रोटू वारुहूं कोइत मिक्यू; जेहें कोइत यहोवा मोशेहे कोयो तेहेंज कोइत कोअयो.<note caller="+" style="x"><char style="xo" closed="false">40:23 </char><char style="xt" closed="false"><ref loc="EXO 25:30">निर्ग 25:30</ref>; <ref loc="EXO 39:36">39:36</ref>; <ref loc="LEV 24:5-9">लेवी 24:5-9</ref></char></note> <verse eid="EXO 40:23" /><verse number="24" style="v" sid="EXO 40:24" />आन तिये मिलापवाला तोंबामेहें रोटाआ टेबलोअ हुंबर रोअलाअ जागाअ देहामोअ वोल दिवाआ खांब मिक्यो, <verse eid="EXO 40:24" /><verse number="25" style="v" sid="EXO 40:25" />आन तिये दिवाहा यहोवा देवोअ आगाड़ी पेटाड़ी देदो; जेहें कोइत यहोवा मोशेहे आदेश आप्युतो. <verse eid="EXO 40:25" /><verse number="26" style="v" sid="EXO 40:26" />आन तिये मिलापवाला तोंबाआ विसमेर्‍याआ पोड़दाआ आगाड़ी होनाअ देवान्याहा मेक्यो, <verse eid="EXO 40:26" /><verse number="27" style="v" sid="EXO 40:27" />आन तिये तियापोअ हाजी गोंदाण्यी आगरबत्ती पेटाड़्यी; जेहें कोइत यहोवा मोशेहे आदेश आप्युतो. <verse eid="EXO 40:27" /><verse number="28" style="v" sid="EXO 40:28" />आन तिये रोअलाअ बाअणापोअ पोड़दाहा लागाड़्यो. <verse eid="EXO 40:28" /><verse number="29" style="v" sid="EXO 40:29" />आन मिलापवाला तोंबाआ बाअणापोअ आगीइ देवान्यो मिकीत कोइत तियापोअ आगीइ गाराहा आन ओनोअ भेट कोअयो; जेहें कोइत यहोवा मोशेहे आदेश आप्युतो. <verse eid="EXO 40:29" /><verse number="30" style="v" sid="EXO 40:30" />आन तिये मिलापवाला तोंबु आन देवान्याआ विसमेहें तोपल्यो मिकीत कोइत तियामेहें तुवीइलाअ काजे पाईं टाक्यो, <verse eid="EXO 40:30" /><verse number="31" style="v" sid="EXO 40:31" />आन मोशे आन आरोन आन तियाआ पोर्‍या तियां तियांआं आथेन गुडा तुवे; <verse eid="EXO 40:31" /><verse number="32" style="v" sid="EXO 40:32" />आन जेहेलाम जेहेलाम ते मिलापवाला तोंबामेहें नेत देवान्याआ जागे जातेते ताहां ताहां ते आथेन गुडा तुवताते; जेहें कोइत यहोवा मोशेहे कोयो तेहें कोइत कोअयो. <verse eid="EXO 40:32" /><verse number="33" style="v" sid="EXO 40:33" />आन तिये रोअलाअ तोंबाआ शारु वोल आन देवान्याआ आहने-पासे खोलीइ पोड़दू उबू कोआड़्यू, आन खोलीइ बाअणाहा पोड़दा लागाड़ी देदा. एहें कोइत मोशे आखो काम पुरो कोअयो.<verse eid="EXO 40:33" /></para>
  <para style="s">मिलापवाला तोंबापोअ वाद्लो</para>
  <para style="r">(<ref loc="NUM 9:15-23">गणती 9:15-23</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34" />ताहां वाद्लो मिलापवाला तोंबा पोअ सावलू कोअयू, आन यहोवाअ उजालो रोअलाअ तोंबा पोअ पोआइत गोयो. <verse eid="EXO 40:34" /><verse number="35" style="v" sid="EXO 40:35" />आन वाद्लो मिलापवाला तोंबापोअ रुकाइत गोयो, आन यहोवाअ उजाला रोअलाआ तोंबामेहें पोआइत गोयो, तिहीं वाअहीं मोशे तियामेहें फोहीत ने सेक्यू. <verse eid="EXO 40:35" /><verse number="36" style="v" sid="EXO 40:36" />इस्राएलोअ आखी वाटेमेहें एहेलोहो ओवतो तो, के जाहां जाहां तो वाद्लो रोअलाआ जागामेहें रोत उपोअ जातो रोतोतो, ताहां ताहां तें आगाड़ी जातेते. <verse eid="EXO 40:36" /><verse number="37" style="v" sid="EXO 40:37" />आन जर तो तिहींज रोत ने जाय, ताहां जेदिहीं जाआं तो ने जाय तेदिहीं जाआं ते तिहींज रोतेते. <verse eid="EXO 40:37" /><verse number="38" style="v" sid="EXO 40:38" />इस्राएलोअ माअहोंअ पुरा प्रवासोमेहें दिहे ते रोअलाअ जागापोअ यहोवाआ वाद्लो, आन राती तिया वाद्लामेहें आग तियां माअहोंहों देखाअतीते.<verse eid="EXO 40:38" /></para>
  <chapter eid="EXO 40" />
</usx>