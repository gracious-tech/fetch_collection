<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Noiri</book>
  <para style="h">आमोस</para>
  <para style="toc3">आमोस</para>
  <para style="toc2">आमोस</para>
  <para style="toc1">आमोसोअ पुस्तक</para>
  <para style="mt2">आमोसोअ पुस्तक</para>
  <para style="mt1">आमोसोअ पुस्तक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">या पुस्तकोमेहें आमोसोअ भविश्य कोत आपनारी खोबर होय. आमोस एक सारवाली <char style="xt"><ref loc="AMO 1:1">1:1</ref></char> आन एक खेती कोअनारु ओतु. <char style="xt"><ref loc="AMO 7:14">7:14</ref></char> ताहां देवे तियाहा तियाआ भविश्यवक्तु बोणावीइलोअ कोअते हाद्यू. आमोस तेकोवाआ रेवासी ओतू, जों देहामाआ वोगऱ्याआ यहुदाआ राज्यामेहें होय; पोन वादार कोइत तियाआ संदेश पालामा इस्राएल राज्याआ कोअते ओतू. जाहां उज्जीया यहुदाआ राजा ओतू तेहेलामेहें आमोसे भविश्यवाणी कोअयी, आन तेहेलामेहें यारोबाम दुसरु इस्राएलोअ राजा ओतु. ए लगभग 750 इ.स. आगाड़ीइ गोठ होय.</para>
  <para style="ip">आमोसे पेहला बेन आध्यायोमेहें वारुज बिहीरा देसोअ विरुद्दामेहें न्यायोअ भविश्यवाणी कोअयी; पोन जाअखा कोइत तियाआ संदेश इस्राएलोअ कोअते ओता. ए इस्राएलोअ कोअते पान्गीइलोअ वेल ओती. तियी पान्गीइलोअ होमसे तें देवोहो विहीरात गोये आन गोरब्योअरी खाराब वेवारो कोअयो. <char style="xt"><ref loc="AMO 2:6">2:6</ref></char> तियांआं कोअते देवोअ न्याय गुलाम बोणावित लेत जाअलोअ ओतो. <char style="xt"><ref loc="AMO 7:17">7:17</ref></char> तेबी देवे वायदो कोअयो के जियां बिहीरा देसो पेल राज कोअयोतो, तियांपोअ तो इस्राएलवालाहां जिकीइलोअ काजे मदत कोए. <char style="xt"><ref loc="AMO 9:12">9:12</ref></char></para>
  <para style="iot">रुपरेशा</para>
  <para style="io1">1. पेहला वसनोमेहें आमोस तियाआ ओलखात आपेहे.</para>
  <para style="io1">2. फाशुउ बाकी भागोमेहें तो वारुज देसोपोअ निर्णय होंबलाड़ेहे. <char style="ior"><ref loc="AMO 1-2">1—2</ref></char></para>
  <para style="io1">3. आमोस इस्राएलोअ न्याय आन गुलामीइ बाप्तिमेहें गोठी कोअहे. <char style="ior"><ref loc="AMO 9:11">9:11</ref></char></para>
  <para style="io1">4. देव आखरीमेहें रोल्या विश्वासीही इस्राएलोमेहें वापिस लेतावीइलोअ वायदो आपेहे. <char style="ior"><ref loc="AMO 9:12-15">9:12-15</ref></char></para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />तेकोवावालू आमोस जो मेडा-बोकड़ाआ सारवाल्योमेऱ्युउ ओतू, तियाआ ओं वसन होय; जो तिये यहुदाआ राजा उज्जीयाआ आन योवाशोअ बेटाह्हा इस्राएलोअ राजा यारोबामोअ दिहोमेहें भुकंपाआ बेन वोरह्योंअ पेल इस्राएलोअ बाप्तिमेहें दर्शन देखीत कोयो:<verse eid="AMO 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="AMO 1:2" />“यहोवा सियोनोम पुकारु कोए,</para>
  <para style="q2" vid="AMO 1:2">येरुसालेम रोत तियाआ आवाज उनाड़े;</para>
  <para style="q1" vid="AMO 1:2">ताहां सारवाल्योअ जागू विखा कोए,</para>
  <para style="q2" vid="AMO 1:2">आन कर्मेल डोगोअ सुटी सुल्लाइत जाय.”<verse eid="AMO 1:2" /></para>
  <para style="s">इस्राएलोअ आहनेवाला देसोअ न्याय</para>
  <para style="s2">सिरिया</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />यहोवा देव एहें कोहे, “दमिश्कोअ ताल-ताल कोअल्या गुनाआं वाखरी आंय तियाआ डोंड ने सोड़ो; काहाके तिये गिलादोहो मोलीइलोअ लोड़ाआ सादानोवाअहीं मोलीत टाक्युहू. <verse eid="AMO 1:3" /><verse number="4" style="v" sid="AMO 1:4" />तियाहा काजे आंय हजाएलोअ किल्लाम आग लागाड़ीहीं, आन तियावाअहीं बेन्हदेदोअ किल्लू बी बोलीत जाय. <verse eid="AMO 1:4" /><verse number="5" style="v" sid="AMO 1:5" />आंय दमिश्कोअ गेटोहो तोड़ीत टाकीहीं, आन आवेन नावोअ काटोम रोनाराहां आन बेतएदेनोअ कोअमेएं आधिकारीही आरवीत टाकिहीं; अरामवालाहां बांदीत कोइत कीर लेत जाते रोय, यहोवा देवोअ ओंज वसन होय.”<verse eid="AMO 1:5" /></para>
  <para style="s2">पलिश्ती</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />यहोवा देव एहें कोहे, “गाजाआ ताल-ताल कोअल्या गुनाआं वाखरी आंय तो डोंड ने सोड़ो; काहाके तें आखा माअहोंहों गुलाम कोइत तियांहां एदोमोअ आथोम पाड़ीइलोअ काजे लेत गोयेहे. <verse eid="AMO 1:6" /><verse number="7" style="v" sid="AMO 1:7" />तियाहा काजे आंय गाजाआ होयरोअ वाड़ीमेहें आग लागाड़ीहीं आन तिहीं वाअहीं तियाआ किल्लू बोलीत जाय. <verse eid="AMO 1:7" /><verse number="8" style="v" sid="AMO 1:8" />आंय अशदोदोअ रोनाराहां आन अश्कलोनोअ आधिकारी आरवीहीं; आंय माआं आथ एक्रोनोअ विरुद्दाम सालाड़ीहीं, आन बाकी पलिश्ती माअहें आरवात जाय, यहोवा देवोअ ओंज वसन होय.”<verse eid="AMO 1:8" /></para>
  <para style="s2">सोर</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />यहोवा देव एहें कोहे, “सोरोअ ताल-ताल कोअल्या गुनाआं वाखरी आंय तियाआ डोंड ने सोड़ो; काहाके तियां आखा माअहोंहों गुलाम कोइत एदोमोअ ताबाम कोइत देदेहे आन पायहोअरीइ शप्पत ओर ने कोअयी. <verse eid="AMO 1:9" /><verse number="10" style="v" sid="AMO 1:10" />तियाहा काजे आंय सोर होयरोअ वाड़ीमेहें आग लागाड़ीहीं, आन तिहीं वाअहीं तियांआं गोड बोलीत जाय, एहें कोत यहोवा देव कोहे.”<verse eid="AMO 1:10" /></para>
  <para style="s2">एदोम</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />“एदोम, यहोवा देव एहें कोहे, एदोमोअ ताल-ताल कोअल्या गुनाआं वाखरी आंय तियाआ डोंड ने सोड़ो; काहाके तिये सोताआ पायहोहो तारवाइ वाअहीं ओड़ीत लागुहू आन वाहीं दया ने कोअयी, पोन खिजेमेहें कायम सिरतुज रोयू, तियाआ खोत हादाफल मिकीत रोयू. <verse eid="AMO 1:11" /><verse number="12" style="v" sid="AMO 1:12" />तियाहा काजे आंय तेमान होयरोमेहें आग लागाड़ीहीं, आन तिहीं वाअहीं बोस्राआ किल्लाम आग पेटात जाय.”<verse eid="AMO 1:12" /></para>
  <para style="s2">आमोन</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />यहोवा देव एहें कोहे, “आम्मोनोअ ताल-ताल कोअल्या गुनाआं वाखरी आंय तियाआ डोंड ने सोड़ो; काहाके तियां सोताआ हींव वादाड़ीलोअ काजे गिलादोअ मुलखोअ पोटावाली बोईंहीं सिरीत टाक्यी. <verse eid="AMO 1:13" /><verse number="14" style="v" sid="AMO 1:14" />तियाहा काजे आंय राब्बाआ होयरोअ वाड़ीमेहें आग लागाड़ी देहीं, आन तिहीं वाअहीं तियाआ किल्लू बी बोलीत जाय. तियी लोड़ायीइ दिहोमेहें पुकारु ओवे, तो वादुउ आन पुत्याआ दिही ओवे; <verse eid="AMO 1:14" /><verse number="15" style="v" sid="AMO 1:15" />आन तियांआं राजा तियाआ सिपायड़ाअरी जेलेमेहें जाय, यहोवा देवोअ ओंज वसन होय.”<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s2">मोवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />यहोवा देव एहें कोहे, “मोवाबोअ ताल-ताल कोअल्या गुनाआं वाखरी, आंय तियाआ डोंड ने सोड़ो; काहाके तिये एदोमोअ राजाआ आडे बालीत खाआं वाली देदू. <verse eid="AMO 2:1" /><verse number="2" style="v" sid="AMO 2:2" />तियाहा काजे आंय मोवाब मुलखोमेहें आग लागाड़ीहीं, आन तिहीं वाअहीं करिय्योत होयरोअ किल्लू बोलीत जाय; आन मोवाब दोंगा, पुकारु, आन तुरीइ आवाज ओवता-ओवता मोइत जाय. <verse eid="AMO 2:2" /><verse number="3" style="v" sid="AMO 2:3" />आंय तियाआ विसमेहें रोत न्याय कोअनारा आधिकाऱ्योहों आरवीत टाकिहीं, आन आरी-आरी तियाआ आखा आधिकाऱ्योहों बी माइत टाकिहीं,” यहोवा देवोअ ओंज वसन होय.<verse eid="AMO 2:3" /></para>
  <para style="s2">यहुदा</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />यहोवा देव एहें कोहे, “यहुदाअ मुलखोमेहें ताल-ताल कोअल्या गुनाआं वाखरी, आंय तियाआ डोंड ने सोड़ो; काहाके तियां यहोवा देवोअ नियमोहों ने मान्ये आन तियाआ कायदाआ पालन ने कोअयो; आन जियीं गोठीइ फासाड़ी तियांआं डायडायहां सालताते, तियां ठोगोअ देवताआ वाखरी तें बी भटकीत गोयेहे. <verse eid="AMO 2:4" /><verse number="5" style="v" sid="AMO 2:5" />तियाहा काजे आंय यहुदामेहें आग लागाड़ीहीं, आन तिहीं वाअहीं येरुसालेमोअ किल्लू बोलीत जाय.”<verse eid="AMO 2:5" /></para>
  <para style="s">इस्राएलोअ न्याय</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />यहोवा देव एहें कोहे, “इस्राएल तिन की, पोन शार गुनाआं वाखरी, आंय तियाआ डोंड ने सोड़ो; काहाके तियां निर्दुसोहों पोशाआ उस्ती आन गोरब्योहों एकी जोड़ी खाहड़ाआ काजे वेसी देदेहे. <verse eid="AMO 2:6" /><verse number="7" style="v" sid="AMO 2:7" />तें लुलाहा आन टाकाअलाहा पुयींइं तुलाआ होस सेंदतेहे, आन नम्र माअहोंहों वाटेज रोत सेटे हारी देतेहे; आन माआं सोका नावोहो एठो कोइलोअ काजे बाह्हून बेटुह्हू बेनू एकुज कुवांरी पोऱ्यीइ जागे जाताहा. <verse eid="AMO 2:7" /><verse number="8" style="v" sid="AMO 2:8" />ते उसन्ये साअके फांगीत देवान्याआं जागे हुवताहा, आन डोंडोअ रुप्यावाअहीं वेसातू लेद्लू दाराक्शाआ रोहो तियांआं देवताआ मंदीरोम पित लेताहा.<verse eid="AMO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 2:9" />“मी तियांआं सामने रोत एमोरीवालाहां आरवीत टाक्येते, जें देवदार साड़ोअ होस उसे ओते, आन जियांआं ताकत वांज्या साड़ोअ होस ओती; तेबी आंय उसे रोत फलवे आन निसे तियाआ मुले तोड़ीत टाक्ये.<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="DEU 3:8-11">कायदा 3:8-11</ref></char></note> <verse eid="AMO 2:9" /><verse number="10" style="v" sid="AMO 2:10" />आंय तुमुहूं मिसर देसोम रोत काडीत लेत आयू आन तुमू एमोरीइ देसोअ आधिकारी बोणे तेहें काजे रानोमेहें सालीही वोरह्ये जाआं लेत फिरतू रोयू. <verse eid="AMO 2:10" /><verse number="11" style="v" sid="AMO 2:11" />आंय तुमाआ पोऱ्यामेहें रोत देवोअ भविश्यवक्ता बोणे तेहें काजे आन तुमाआ थोड़ाक जुवानोमेहें रोत नाजीर<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fq" closed="false">नाजीर </char><char style="ft" closed="false">देवोअ काजे होपाअलो नांबा सिंग्याआ माहुंउं</char></note> बोणे तेहें काजे ठरव्याहा. ओ इस्राएलवाला, केहें ओं आखो बोराबर नाहां के? यहोवा देवोअ ओं वसन होय. <verse eid="AMO 2:11" /><verse number="12" style="v" sid="AMO 2:12" />पोन तुमू नाजीरोहो दाराक्शाआ रोहो पिवाड़्यु, आन भविश्यवक्ताहा भविश्यवाणी ने कोइलोअ आदेश आपी देदू. <verse eid="AMO 2:12" /><verse number="13" style="v" sid="AMO 2:13" />पाला, जेहें कोइत सिपाटो पुला बांदीत गाडामेहें दाबीत पोअतेहे तेहें कोइत आंय तुमुहूं दाबीहीं. <verse eid="AMO 2:13" /><verse number="14" style="v" sid="AMO 2:14" />तियाहा काजे जोरे गुगदीइनाराहा नाहींत जाअलोअ बी जागू ने जोड़े, आन ताकतवालाआ ताकत किज कामोम ने आवे; ने बाहादीर तियाआ जिव वासाड़ीत सेके; <verse eid="AMO 2:14" /><verse number="15" style="v" sid="AMO 2:15" />तोंद्लीवालू उबू ने रोत सेकनारु, ताबुड़ गुगदीइनारु ने वासाअनारु; कोड़ापोअ बोहीत जानारु बी सोताआ जिव ने वासाड़ीत सेके; <verse eid="AMO 2:15" /><verse number="16" style="v" sid="AMO 2:16" />आन बाहदीरोमेएं जो जाअखू जोरावार ओय, तो बी तेदिहीं नागरुज गुगदू वोले, यहोवा देवोअ ओंज वसन होय.”<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />ओ इस्राएलवाला, तुमाआ पुरा कुटूंबाआ बाप्तिम मोन्ज्ये जियांहां आंय मिसर देसोम रोत काडीत लेतायुहू, तें तुमू यहोवा देवे जों वसन कोयोहो तों उनाआ, तों एहें कोइते: <verse eid="AMO 3:1" /><verse number="2" style="v" sid="AMO 3:2" />“धरतीपोऱ्याआ आखा माअहूंमेहें रोत आंय निस्तो तुमापोअ मोन लागाड़्योहो, तियाहा काजे आंय तुमाआं आखा खाराब कामोअ डोंड आपीहीं.”<verse eid="AMO 3:2" /></para>
  <para style="s">भविश्यवक्ताआ काम</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3" />“जर बेन माटी एकमेकापोअ राजी ने ओय, ताहां का ते आरी मिलीत सालीत सेके के?”<verse eid="AMO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 3:4" />“हावोज ने जोड़्यो ताहां सिहूंवाग घांगरीत सेके के? केहें जुवान सिहूंवाग विण हावोज तोअयेज तियाआ दोराम रोत घांगरे के?”<verse eid="AMO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 3:5" />“फांदुज ने मांड्यू ताहां कांय सिड़ी फांदाम लागीत सेके के?”</para>
  <para style="p" vid="AMO 3:5">“केहें काविहीं बिगर फोश्येज फांदू पुयींपोअ रोत उसकड़े के?”<verse eid="AMO 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 3:6" />“होयरोम तुरी फुके ताहां माहें ने थुरथुर कापे वोले के?”</para>
  <para style="p" vid="AMO 3:6">“केहें यहोवा देवे मोकल्या सिवाय एखा होयरोम एखु आफत पोड़ीत सेकेहे के?”<verse eid="AMO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 3:7" />“एहेंज कोइत प्रभु यहोवा देव तियाआ सेवक भविश्यवक्ताहां तियाआ गुप्त्यी गोठी फोड़ीत कोया सिवाय किज नाहां कोअतू.”<verse eid="AMO 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 3:8" />“सिहूंवाग घांगऱ्यू ताहां कोडू ने बिय?”</para>
  <para style="p" vid="AMO 3:8">“यहोवा देव गोग्यू ताहां कोडू होय जो भविश्यवाणी ने कोए?”<verse eid="AMO 3:8" /></para>
  <para style="s">शोमरोनोअ आरवाइलोअ</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9" />अशदोदोओन मिसर देसोअ किल्लाआ बाप्तिम पुकारु कोअ, “शोमरोनोअ डोगोपोअ टिग वोलीत पाला के तिहींम की जातीइ दोंगा आन तिहीं विसमेहें केतुहू तारास होय!”<verse eid="AMO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 3:10" />यहोवा देवोअ ओंज वसन होय, “जें माअहें तियांआं किल्लामेहें दोंगू आन लुटल्या पोशा हेंगालतेहे, तियांहां सिदो काम कोइलोअ नाहां मुंदू.” <verse eid="AMO 3:10" /><verse number="11" style="v" sid="AMO 3:11" />तियाहा काजे यहोवा देव एहें कोहे, “देसोहो केंडवारनारु दुस्मोन रोय, आन तो ताआ ताकत काडीत लेय, आन ताआ किल्लू लुटीत लेय!”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />यहोवा देव एहें कोहे, “जेहें कोइत सिहांवागोअ जोड़बाम रोत बेन गुडा नेताहां कानोअ एक तुकड़ू टाकाड़तेहे आन आथरुउ एक खुणू नेताहां खाट्लाआ पायाआ एक तुकड़ू टाकड़तेहे, तेहेंज कोइत इस्राएलोवाला माअहुंहूं जें शोमरोनोमेहें रोतेहे, तियांहां बी तो टाकाड़े.”<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />“उनाआ, आन याकोबोअ कुटुंबाहा ताबलीत कोवा एहें सेनाआ प्रभु, यहोवा देव कोहे. <verse eid="AMO 3:13" /><verse number="14" style="v" sid="AMO 3:14" />जेहेलाम आंय इस्राएलोहो तियाआ पापोअ डोंड आपीहीं, तेहलाजमेहें आंय बेथेलोअ देवान्याहां डोंड आपीहीं, आन देवान्याआं हिंग टुटीत कोइत पुयींपोअ ओदरीत पोड़े.<note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="2KI 23:15">2 राजां 23:15</ref> </char></note> <verse eid="AMO 3:14" /><verse number="15" style="v" sid="AMO 3:15" />आंय हियालेए आन उनालेए कोओहो, बेनुहूं ओदारीहीं; आन आथीइ दातोअ बोणावल्ये कोएं बी आरवीत टाकीहीं, आन वोडे वोडे कोएं आरवात जाय, यहोवा देवोअ ओंज वसन होय.”<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1" />ओ शोमरोन राज्याआ मात्ली बोईं! ओ बाशान डोगोमेऱ्यीइ वासड़्यी! ओ संदेश उनाआ! तुमू जे कांगालोहों दोमत्यीही, आन गोरब्योहों सेंदीत टाकत्यीही, आन सोताआ माट्योहो कोत्यीही के, “ओमहूं लेतावाते, आपू पिहूं!” <verse eid="AMO 4:1" /><verse number="2" style="v" sid="AMO 4:2" />यहोवा देव तियाआ सोकायीइ शप्पत खात कोइत कोहे, “पाला, तुमापोअ एहेलाहा दिही आवनाराहा, के तुमुहूं काटावाअहीं आन तुमाआ फासाड़ीइ पिड़ीही मासाआ गोली वाअहीं ओसकीत लेत जाय. <verse eid="AMO 4:2" /><verse number="3" style="v" sid="AMO 4:3" />तुमामेएं हारेक जोओं पितड़ाआ डुसामेहें रोत निहींत जाहा; आन हार्मोनोअ डोगोमेहें टाकी देवाअहा,” एहें कोत यहोवा देव कोहे.<verse eid="AMO 4:3" /></para>
  <para style="s">हुदरीइलोम इस्राएलोअ कसर पोड़्यी</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4" />“इस्राएल ने हुदरीत सेकू, बेथेलोम आवीत गुनू कोआ, आन गिलगालोम आवीत जाअखू गुनू कोआ; तुमाआ गाराहा वेगीइ आन तुमाआ दाहवू भाग तिसरा दिहोअ डिठ लेत आवया कोअजा; <verse eid="AMO 4:4" /><verse number="5" style="v" sid="AMO 4:5" />खमीर कालीत धन्यवादोअ भेट आपा, तुमाआ राजीखुसी आपल्यी भेट कोत देखाड़ा; काहाके ए इस्राएलवाला, तुमुहूं तोम ओंज गोमत्लो,” एहें कोत यहोवा देव कोहे.<verse eid="AMO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 4:6" />“आंय ते तुमाआ आखा होयरोम फुकेए काल पाड़्यु, आन तुमाआ आखी जागे रोटाआ कमी पाड़्यीही, तेबी तुमू माआ आहने फिरीत ने आये,” एहें कोत सेनाआ यहोवा देव कोहे. <verse eid="AMO 4:6" /><verse number="7" style="v" sid="AMO 4:7" />“जाहां वाडीइलोअ तिन मोयना बाकी रोया, तेहेलाम आंय वोरहात ने पाड़्यू. आंय एका होयरोम पाईं पाड़्यो आन बिहीराम ने पाड़्यो; एका खेतोम पाईं पोड़्यो पोन बिहीराम ने पोड़्यो, तों उगात गोयो. <verse eid="AMO 4:7" /><verse number="8" style="v" sid="AMO 4:8" />तियाहा काजे माअहें होयरो होयरो पिइलोअ पाईं होदीत फिऱ्ये, पोन तियांआं तिही ने उडी; तेबी तुमू माआ वोग वोलीत ने आये,” एहें कोत यहोवा देव कोहे.<verse eid="AMO 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 4:9" />“आंय तुमाआ ओनोहो झांव आन किड़ा वाअहीं नुकसान कोइत टाक्यो, आन जाहां तुमाआ बोगिसू आन दाराक्शाआ मोलान, अंजीरेन जेयतुनोअ साड़े जाअखीलेहे वादीत गोये, ताहां टिड्ये तियांहां खात गोये; तेबी तुमू माआ जागे वोलीत ने आये,” एहें कोत यहोवा देव कोहे.<verse eid="AMO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 4:10" />“आंय मिसर देसोअ होस तुमाआ विसमेहें मोराय सालाड़्यी; तुमाआ कोड़ा बुउसाड़ीत तुमाआ जुवान्याहां तारवाइ वाअहीं माआड़्या; तुमाआ पोड़ावाआ घाण वास तुमाआ नाकोम पोतू; तेबी तुमू माआ जागे वोलीत ने आये,” एहें कोत यहोवा देव कोहे.<verse eid="AMO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 4:11" />“तुमामेऱ्याआ थोड़ाक जोओंहों आंय एहेलाहा आरव्या, के तियांआं दशा सदोम आन गोमोराअ होस ओत गोयी, आन तुमू आगीम रोत काडल्या सेन्काआ होस ओत गोये; तेबी तुमू माआ वोल फिरीत ने आये,” यहोवा देवोअ ओंज वसन होय.<note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="GEN 19:24">उत्प 19:24</ref></char></note> <verse eid="AMO 4:11" /><verse number="12" style="v" sid="AMO 4:12" />“तियाहा काजे, ओ इस्राएल, आंय ताअरी एहेंज कोअहीं, तियाहा कोत आंय ओं काम ताअरी कोअहूं कोअहो, ओ इस्राएल, ताआ देवोअ सामने आवुहूं तियार ओत जा!”<verse eid="AMO 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />“पाल, डोगोहो</para>
  <para style="q2" vid="AMO 4:13">आन वाराहा बोणावनारु</para>
  <para style="q1" vid="AMO 4:13">आन मोनवीइ मोनोअ विसार कोत आपनारु,</para>
  <para style="q2" vid="AMO 4:13">वेगीइ वेले आंदारो पाड़नारु,</para>
  <para style="q2" vid="AMO 4:13">जो धरतीइ उसा जागाम सालनारु होय;</para>
  <para style="q1" vid="AMO 4:13">तियाआज नाव सेनाआ यहोवा देव होय!”<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">फासतावू कोइलोअ पुकारु</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />“ओ इस्राएलोअ कुटूंबा, या विखाआ गितोअ शब्दे उनाआ जें आंय तुमाआ बाप्तिम कोहो:<verse eid="AMO 5:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />इस्राएल देस एक कुवांरी पोऱ्यी होय,</para>
  <para style="q1" vid="AMO 5:2">जे पोड़ीत गोयी, आन फाशीइ उठीत ने सेकी;</para>
  <para style="q1" vid="AMO 5:2">तियीही तियीइ जागाजपोअ आस्टी देदीही आन तियीही उठाड़नारो कोडोज कायनाहां.”<verse eid="AMO 5:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />काहाके यहोवा देव एहें कोहे: “जिया होयरोम रोत हाजार सेयनिक निहींताते तिहींम रोत इस्राएलोअ होवुज बाकी रोय, आन जिहीं होव निहींताते तिहींमेहें दोहूज वासात रोय.”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />यहोवा देव, इस्राएलोअ घराणाहा कोहे: “माहूं होदा, ताहां जिवते रोहा. <verse eid="AMO 5:4" /><verse number="5" style="v" sid="AMO 5:5" />बेथेलोहो मा होदहा, गिलगालोम मा जाहा, आन बेर्शेबाम मा जाहा; काहाके गिलगाल हुदाअलीज गुलामीम जाय, आन बेथेल हुंद्लो पोड़ीत रोय.”<verse eid="AMO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 5:6" />“यहोवा देवोहो होदा, ताहां जिवता रोहा, नेते तो योसेफोअ घराणापोअ आगीइ होस बाल्लात उठे, आन ते आग तियाहा बालीत टाके, बेथेलोमेहें तियीही उलवीइनारो कोडोज ने रोय. <verse eid="AMO 5:6" /><verse number="7" style="v" sid="AMO 5:7" />ओ न्यायोहो कोड़वामेहें बोदलीइनारा आन हाजी गोठीही आरवीइनारा!”<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />“जो जुगोअ कोर</para>
  <para style="q2" vid="AMO 5:8">आन तारा बोणावनारु होय,</para>
  <para style="q1" vid="AMO 5:8">जो जाडा आंदाराहा उजालो बोणावी देहे,</para>
  <para style="q2" vid="AMO 5:8">दोऱ्याआ पाईं पुयींपोअ वोहाड़ी देहे,</para>
  <para style="q1" vid="AMO 5:8">तियाआ नाव यहोवा देव होय.<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />तो ताकतवालाहा ताबुड़ आरवीत टाकत्लू, आन गोडोहो बी आरवीत टाकत्लू.”<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="AMO 5:10" />कोर्ठामेहें जो खोरु न्याय कोअहे तियाअरी तें दुस्मोनी राखीत रोतेहे आन खोरी गोठ कोत देखाड़नारे याहां वाहीं बी नाहां गोमते. <verse eid="AMO 5:10" /><verse number="11" style="v" sid="AMO 5:11" />तुमू गोरब्योपोअ दाबाव टाकताहा, आन तियांपोअ फालू एहें कोत ओन पाड़ावीत लेताहा, तिहींज वाअहीं तोम तुमू दोगड़ाआ कोएं बांद्येहे, पोन तिहींम तुमुहूं रोअहूं ने जोड़े. आन जो बाहरी एतुज दाराक्शाआ मोलू तुमू लागाड़्युहू, तिहींम रोत तुमुहूं रोहो ने पीइहूं जोड़े. <verse eid="AMO 5:11" /><verse number="12" style="v" sid="AMO 5:12" />काहाके माहूं मुंदू होय के तुमाआ गुना जास्ती वजन होय. तुमू धर्मी माहुंहूं तारास देताहा आन लास खाताहा, आन कोर्ठोम गोरब्योअ न्याय बिगाड़ताहा. <verse eid="AMO 5:12" /><verse number="13" style="v" sid="AMO 5:13" />तियाहा काजे जों समजदार ओय, तों एहलीही गाले ठावको रोअहूं जोवे, काहाके वेल खाराब होय.<verse eid="AMO 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 5:14" />तुमू कुहराय मा पोन हाजलाय होदा, ताहांज तुमू जिवते रोहा; आन जेहें कोइत तुमू कोताहा तेहलोज सेनाआ प्रभु यहोवा हुदाअलीज तुमाअरी रोय. <verse eid="AMO 5:14" /><verse number="15" style="v" sid="AMO 5:15" />कुहराय काडा आन हाजलाय मिका, आन कोर्ठोमेहें न्याय टिकाड़ीत मिका; वाअलुहू सेनाआ प्रभु यहोवा योसेफोअ बाकी रोल्या माअहूं पोअ मेरवानी कोए.<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />तियाहा काजे सेनाआ देव, प्रभु यहोवा एहें कोहे: “आखी जागे जिहीं-तिहीं रोड़ीइलोअ सालू रोय. आखी सड़केज माहें किगलीइते इंडे; तें खेते कोअनाराहां रोड़े तेहें काजे, आन जें विखा कोइलोम हाजे कोड़ाअले ओय, तियांहां विखा कोएन रोड़े तेहें काजे हादे; <verse eid="AMO 5:16" /><verse number="17" style="v" sid="AMO 5:17" />आन दाराक्शाआ मोलाम रोड़ीइलोअ सालू रोय,” काहाके यहोवा देव एहें कोहे, “आंय तुमाआं विसमेहें ओवतुज जाहीं.”<verse eid="AMO 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="AMO 5:18" />तियांआं केतीही विते, जें यहोवा देवोअ दिहोअ ईश्शा कोअतेय! यहोवा देवोअ दिहो वाअहीं तुमुहूं की जोड़े? तो ते उजालाआ नाहां पोन आंदाराआ दिही रोय. <verse eid="AMO 5:18" /><verse number="19" style="v" sid="AMO 5:19" />जेहें कोइत फोलो तों सिहांवागोहो देखीत गुगदे आन तियाहा आसालो मिले; नेताहां कोअमेहें आवीत पितड़ाअरी आथ मिकताज एखू हाप टोसी देय. <verse eid="AMO 5:19" /><verse number="20" style="v" sid="AMO 5:20" />यहोवा देवोअ दिही ओ उजालाआ नाहां पोन आंदाराआ दिही रोनारुहू, ए गोठ बोराबर कायनाहां के? होव, एताहा जाडा आंदाराआ दिही जिहींम वाहीं बी उजालो ने रोय.<verse eid="AMO 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="AMO 5:21" />“माहूं तुमाआ तिवारोअ सोगदाय आवेहे, आन आंय नाहां मानतू; तुमाआ वोडी सभा वाअहीं आंय खुस कायनाहां. <verse eid="AMO 5:21" /><verse number="22" style="v" sid="AMO 5:22" />तुमू आगीइ आन ओनोअ जोवे तेती गाराहा आपहा, तेबी आंय खुस ने ओवो, आन तुमाआ पालल्या मात्ला जनवारोअ गाराहा बी आंय ने पालो.<note caller="+" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="ISA 1:11-14">यश 1:11-14</ref></char></note> <verse eid="AMO 5:22" /><verse number="23" style="v" sid="AMO 5:23" />तुमाआ गितोअ कोकलू मारोत सेटे कोआ; तुमाआ रोंअठ्याआ आवाज आंय नाहां उनाअनारु. <verse eid="AMO 5:23" /><verse number="24" style="v" sid="AMO 5:24" />पोन न्यायोहो खोबरीइ होस, आन हाजी गोठीही खाडीइ होस वोहुंहूं द्या.”<verse eid="AMO 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />“ओ इस्राएलोअ घराणा, तुमू हुंद्ला जागाम सालीही वोरह्ये जाआं जनवारोअ आन ओनोअ भेट कांय माहूंज आपतेते के? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />तुमू तोम तुमाआ राजाआ तोंबु, आन तुमाआ सक्कुत मुर्तीइ पाट्लू, आन तुमाआ केयवान देवताआ तारु लेत फिऱ्या कोअतेते. <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />तियाहा काजेज आंय तुमुहूं दमिश्कोअ तिवोल जेलेम जाअहूं देहीं, सेनाआ देव यहोवाआ ओंज वसन होय.”<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">इस्राएलोअ आरवाइलोअ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1" />तियांआं केतीही विते तियांआं जें सियोनोमेहें होकेहे रोतेहे, आन तियांआं बी जें शोमरोन डोगोपोअ बेफिकऱ्ये रोतेहे, जें देसोमेहें नावलाअतेहे, जियांआं जागे इस्राएलोअ घराणाआ माअहें आवया कोअतेहे! <verse eid="AMO 6:1" /><verse number="2" style="v" sid="AMO 6:2" />कलने होयरोम जात कोइत पाला, आन तिहीं रोत हमात नावोअ वोडा होयरोम जावा; फाश्योअ पलिश्तीइ गत होयरोम जावा. केहें तें यां बेनू राज्या रोत जाअखे हाजे होय के? केहें तियांआं हींव तुमाआ हींवे रोत जाअखी वोडी होय के? <verse eid="AMO 6:2" /><verse number="3" style="v" sid="AMO 6:3" />तुमू बाक्ता दिही सेटे कोई देताहा, आन राड़ेवाली गादी आहने लेत आवताहा. <verse eid="AMO 6:3" /><verse number="4" style="v" sid="AMO 6:4" />तुमू आथीइ दातोअ बोणावल्यी पोलांगीपोअ हुवताहा, आन जिवज्योअ आथरुपोअ गुडा पोलावीत हुवताहा, आन तुमू खोटामेएं बोकड़े-वासड़े हाजे मात्ले पालीत खात लेताहा. <verse eid="AMO 6:4" /><verse number="5" style="v" sid="AMO 6:5" />तुमू रोंअठ्याअरी गित गावताहा, आन दाविदोअ होस बाती बातीइ वाजे ओकले वाअहीं बोणाताहा; <verse eid="AMO 6:5" /><verse number="6" style="v" sid="AMO 6:6" />तुमू सिंगलेन सिंगले दाराक्शाआ रोहो टोहलीइताहा, आन हाजो हाजो तेल हारताहा, पोन योसेफोपोअ आवनारी आफत देखीत नाहां रोड़ता; <verse eid="AMO 6:6" /><verse number="7" style="v" sid="AMO 6:7" />आन तियाहा काजे तियांआं देसोम रोत तेज वेगा काडी देवाय, आन जे गुडा पोलावीत हुवताहा, तियांआं मोज्या जाती रोय.<verse eid="AMO 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />सेनाआ प्रभु यहोवा सोताआ शप्पत खात कोइत कोयोहो, “जिहींपोअ याकोब वोडाय कोअहे, तियाआ माहूं सीस लागेहे, आन तियाआ किल्ला माहूं नाहां गोमता; आन आंय या होयरोहो आन तिहींम रोनारा आखाहा दुस्मोनोअ आथोम पाड़ी देहीं.”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />जर एखा कोअमेहें दोहो माटी वासाअयाय, तेबी मोइत जाय. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />जेहेलाम एखाआ आजलुह्हू जो तियाहा डाग देनारु ओये, तियाआ आडोहों कोअमेहें रोत काडीत लेत जाअलोअ काजे आखले, आन जों कोअमेहें खुणे ओय तियाहा कोय, “केहें ताअरी एखु होयजी के?”</para>
  <para style="p" vid="AMO 6:10">ताहां तों कोय, “कोडोन्ने;”</para>
  <para style="p" vid="AMO 6:10">ताहां तो कोय, “ठावकू रो! आपू यहोवा देवोअ नाव ने लेएहूं जोवे.”<verse eid="AMO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 6:11" />काहाके यहोवा देवोअ आदेशो वाअहीं वोडा कोअमेहें डुसू पोड़ीत जाय आन हाना कोअमेहें सिहीं पोड़ीत जाय. <verse eid="AMO 6:11" /><verse number="12" style="v" sid="AMO 6:12" />केहें कोड़ा खड़कापोअ गुगदे के? केहें एखु एहलीही जागे बोलोद जुपे के, जिहीं तुमू न्यायोहो जेरोम बोदल्यो आन हाजा कामोअ फोलवे कोड़वाम बोदलीत टाक्येहे?<verse eid="AMO 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 6:13" />तुमू एहलीही फालतू गोठी वाअहीं खुस ओवताहा आन कोताहा, “केहें आपू सोताआ दोमोपोअ कारनाइम होयर ने जिक्या के?”<verse eid="AMO 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 6:14" />तिहींज वाअहीं सेनाआ यहोवा देवोअ ओंज वसन होय, “ओ इस्राएलोअ कुटूंबा, पाल, जें हमात काटोम रोत ते अराबा खाडीइ जागे जाआं तुमुहूं अड़सनेम टाके, एहेलाहा देसोअ माअहें तुमाआ विरुद्द उबे कोअहीं.”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">आरवाइलोअ तीन दर्शने:</para>
  <para style="s">टिड्ये</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />यहोवा देवे माहूं ओं देखाड़्यो. आन माहूं कि देखाअहे के तिये फासल्योअ खोड़ उगीइलोअ सुरुवातीहीज टिड्ये बोणावी देदे; आन तों राजाआ कामाय वाडीत लेदो तिहींइं फासाड़ीइ खोड़ ओतो. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />जाहां तें पुंयींपोऱ्योअ आखो खोड़ खात सुके, ताहां मी कोयो, “यहोवा देवा, माप कोइ दे! नेत याकोब केहें कोइत टिकीत सेके? तो केतुहू हानू आन लुलू होय!” <verse eid="AMO 7:2" /><verse number="3" style="v" sid="AMO 7:3" />यी गोठी वाअहीं यहोवा देवे विसार बोदल्या आन तिये कोयो, “एहलीही गोठ ओमे ने ओवे.”<verse eid="AMO 7:3" /></para>
  <para style="s">आग</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />यहोवा देवे माहूं एहलोहो देखाड़्यो, आन तिहींम की देखाअयो के यहोवा देवे आगी वाअहीं न्याय आपीइलोअ पुकारु कोअयू, आन तियी आगी वाअहीं वोडू दोऱ्या उगात गोयू, आन पुंय बी बोली वोल्यीते. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />तेहेलाम आंय कोयो, “ओ यहोवा देवा, थोबीत जा! नेत याकोब केहें कोइत टिकीत सेकेहे? तो केतुहू लुलू होय.” <verse eid="AMO 7:5" /><verse number="6" style="v" sid="AMO 7:6" />याआ बाप्तिम बी यहोवा देवे विसार बोदल्या; आन तिये कोयो, “एहलीही गोठ फाश्यीइ ने ओवे.”<verse eid="AMO 7:6" /></para>
  <para style="s">वालांबू</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />तिये माहूं ओं बी देखाड़्यो के, मालिख वालांबू लागाड़ीत बोणावल्या पितड़ापोअ उबू रोत होये, आन तियाआ आथोम वालांबू होय. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />यहोवा देवे माहूं कोयो, “ए आमोस, ताहूं की देखाअहे?”</para>
  <para style="p" vid="AMO 7:8">आंय कोयो, “एक वालांबू.”</para>
  <para style="p" vid="AMO 7:8">ताहां देवे कोयो, “पाल, आंय माआ इस्राएलवाला माअहोंअ विसमेहें वालांबू लागाड़ीहीं, आन ओमे आंय तियांहां डोंड आप्या सिवाय ने सोड़ो.” <verse eid="AMO 7:8" /><verse number="9" style="v" sid="AMO 7:9" />इसाकोअ उसू जागू आरवात जाय, आन इस्राएलोअ सोकू जागू हुंद्लू ओत जाय, आन आंय यारोबामोअ कुटूंबापोअ तारवाआ उमाअतुज लोड़ाय कोऊ जाहीं.<verse eid="AMO 7:9" /></para>
  <para style="s">आमोस आन आमस्यू</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />ताहां बेथेलोअ पुंजारे आमस्ये इस्राएलोअ कुटूंबाआ विसमेहें राजा यारोबामोअ जागे कोत मोकल्यो, “आमोस इस्राएलोअ कुटूंबाआ विसमेहें ताअरी कदर काड्यीही; तियाआ आखी गोठीही देस नाहां वेठीत सेकतू. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />काहाके आमोस एहें कोहे, ‘यारोबाम तारवाइ वाअहीं मोए, आन इस्राएलवाले तियांआं देसोम रोत गुलामीम जानारे ताहां जानारेज.’”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />ताहां आमस्ये आमोसोहो कोयो, “ओ जाओण, इंहीं रोत निहींत यहुदा देसोम नाहींत जा, आन तिहींज रोटू खाया कोओ, आन तिहींज भविश्यवाणी कोअया कोओ; <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />पोन बेथेलोम फाशोअ केदिहीं भविश्यवाणी मा कोअही, काहाके ओ राजाआ सोकू जागू आन राजाआ कोअ होय.”<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />आमोसे आमस्याहा उत्तर आपीत कोयो, “आंय ने ते भविश्यवक्तू ओतू आन ने भविश्यवक्ताआ पोऱ्यु; आंय तोम सारवाली आन उंबरोअ साड़े सिंदनारु ओतू. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />आन यहोवा देवे माहूं मेडा-बोकड़ाआं फासाड़ी फासाड़ी फिरत्लू तिहीं रोत हादीत कोइत कोयो, ‘जा, माआं इस्राएलवाला माअहोंअ काजे भविश्यवाणी कोओ.’ <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />तियाहा काजे ओमे तु यहोवा देवोअ वसन उनाआ, तु कोहे के, ‘इस्राएलोअ विरुद्दाम भविश्यवाणी मा कोअही; आन इसाकोअ घराणाआ बाप्तिमेहें ताल ताल गोठी मा होंबलाड़ही.’ <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />तियाहा काजे यहोवा देव एहें कोहे. ‘ताआ बोयोंओं होयरोम रांडी बोणीत जाय, आन ताआ पोऱ्यान पोऱ्यी तारवाइ वाअहीं मोए, आन ताआ जागू दोरु मापीत वाटीत लेय; आन तु सोताहा एठा देसोम मोअही, आन इस्राएल हुदाअलीज तियाआ जागाम रोत गुलामीम जातू रोय.’”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">फोलवा वाअहीं पोआली टोपलीइ दर्शन</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />यहोवा देवे माहूं ओं देखाड़्यो: के उनालामेऱ्याआ फोलवा वाअहीं पोआली एक टोपली होय. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />तिये कोयो, “ए आमोस, ताहूं कि देखाअहे?”</para>
  <para style="p" vid="AMO 8:2">आंय कोयो, “उनालामेऱ्याआ फोलवा वाअहीं पोआली एक टोपली.”</para>
  <para style="p" vid="AMO 8:2">ताहां यहोवा देवे माहूं कोयो, “माआं माअहूं इस्राएलोअ सेलवाऱ्यीइ वेल आवीत लागीही; ओमे आंय तियाहा फाशुउ ने सोड़ो.” <verse eid="AMO 8:2" /><verse number="3" style="v" sid="AMO 8:3" />यहोवा देवोअ वसन होय, “तेदिहीं मंदीरोअ गिते विखामेहें बोदलात जाय, आन तोड़ोअ वोडू टिग ओत जाय; आन हुंद्ली जागे तियांहां ठावकेज टाकी देवाय.”<verse eid="AMO 8:3" /></para>
  <para style="s">इस्राएलोअ आरवाइलो</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4" />ओं उनाआ, तुमू जे गरब्योहों गिइंत लेएहूं होदताहा आन देसोअ कांगाल माअहोंहों आरवुहूं होदताहा, <verse eid="AMO 8:4" /><verse number="5" style="v" sid="AMO 8:5" />जे कोताहा, “नोवू कोयों सेके ताहां आपू दाणा वेसीत सेको? आरामोअ दिही केदिहीं सेके, के जिया वाअहीं आपू आपाअ गोवें वेसीइलोअ काजे मापलो आन ताराजाहा एहेलुहू ओलवू कोइत लेहूं, के माअहुंहूं ठोगीत सेको. <verse eid="AMO 8:5" /><verse number="6" style="v" sid="AMO 8:6" />आन कांगालोहों पोशा आपीत कोइत, आन गोरब्योहों एक जोड़ी खाहड़ाआ किमतेम वेसाते लेत लेतेहे, आन खाराब ओन वेसीत सेके?”<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />जियापोअ याकोबोहो वोडाय कोइलोअ जागू होय, तोज यहोवा देव, सोताआ शप्पत खात कोइत कोहे, आंय तुमाआ कोड्लाज कामोहों केदिहीं ने विहीराओ. <verse eid="AMO 8:7" /><verse number="8" style="v" sid="AMO 8:8" />केहें यी गोठी वाअहीं धरती ने कापे के? तिहींपोऱ्येए रोनारे आखे विखु ने कोए के? ओ देस आखो बादो मिसर देसोअ नील नोयीइ होस रोय, जे वाद्या कोअहेन घोटीत जाहे. <verse eid="AMO 8:8" /><verse number="9" style="v" sid="AMO 8:9" />यहोवा देवोअ ओंज वसन होय, “तिया गालाहा आंय माजोन दिहेज दिही बुडाड़ीहीं, आन या देसोहो दिहीदोवल्येज आंदारो कोई देहीं. <verse eid="AMO 8:9" /><verse number="10" style="v" sid="AMO 8:10" />आंय तुमाआं खुसीइ तिवारोहो सेटे कोइत विखू कोआड़ीहीं; आन आंय तुमा आखाआ विखाआ आंगड़े पोवाड़ीहीं, आन तुमा आखाआ मुन्के बोड़ावीहीं, आन जेहलुहू एखला पोऱ्याआ विखु कोअतेहे तेहलुहू विखु कोआड़ीहीं, आन तियाआ सेवट कोठीण दुखोअ दिहोम जेहें ओवे.”<verse eid="AMO 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 8:11" />यहोवा देवोअ ओंज वसन होय, “पाला, एहेलाहा दिही आवताहा, जाहां आंय या देसोमेहें काल पाड़ी देहीं; तेहेलाम ने ओनोअ फुक रोये के ने पाअयोंअ तिही रोय, पोन यहोवा देवोअ वसन उनाइलोअ फुकेन तिही रोय. <verse eid="AMO 8:11" /><verse number="12" style="v" sid="AMO 8:12" />माअहें यहोवा देवोअ वसन या दोऱ्या रोत फोला दोऱ्याआ जागे जाआं आन पालामाअहें रोत ते उगतामाअहें जाआं होदी होदीइ थाके, पोन तियांहां ने जोड़े. <verse eid="AMO 8:12" /><verse number="13" style="v" sid="AMO 8:13" />तेहेलाम बाहरी जुवान पोऱ्यान पोऱ्यी बेनू तोरह्येज कोमाइत जाय. <verse eid="AMO 8:13" /><verse number="14" style="v" sid="AMO 8:14" />जें माअहें शोमरोनोअ पापमूल देवताआ शप्पत खातेहे, आन जें कोतेहे, ‘दानोअ देवताआ जिवोअ शप्पत, आन बेर्शेबाआ पंथाआ शप्पत,’ तें आखे निसे पोड़े तिहीं रोत ने उठे.”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">देवोअ न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />आंय प्रभुहू देवान्यापोअ उबोइत रोल्यू देख्यू आन तिये कोयो, “खांबोअ सुटीही लागाव, जिहीं वाअहीं ओटू आलीत सेके आन तों आखो माअहुंउं मुंडीपोअ पाड़ीत कोइत पुकरान पुकरा कोओ; आन तिहीं रोत जों वासाय, तियांहां आंय तारवाआ वाअहीं माअहीं; तिहींमेहें रोत एक बी ने नाहीत सेके, आन जों सोताहा वासाओ जाय तों ने वासाइत सेके. <verse eid="AMO 9:1" /><verse number="2" style="v" sid="AMO 9:2" />काहाके तें खुंइत कोइत पातालोम उतरीत जाय, तिहीं रोत बी आंय आथ आगाड़ी कोइत तियांहां लेत आविहीं; तें जुगोम सोड़ीत लागे तिहीं रोत बी आंय तियांहां उतारीत लेत आविहीं. <verse eid="AMO 9:2" /><verse number="3" style="v" sid="AMO 9:3" />कर्मेल डोगोअ टुशापोअ निकाइत जाय, तेबी तियांहां आंय होदीत काडीहीं, आन तें दोऱ्याआ बुंद्यामेहें माआं नजरेम रोत निकाय, तेबी तियांहां आंय हाप टोसे तेहें आदेश आपीहीं. <verse eid="AMO 9:3" /><verse number="4" style="v" sid="AMO 9:4" />तियांहां दुस्मोन ओड़तुज गुलामीम लेत जाय, तिहीं बी तारवाआ लेत कोइत आंय तियांहां माआड़ी देहीं, आन आंय तियांपोअ हाजाआ काजे नाहां पोन नुकसानोअ काजे नजर टाकिहीं.<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />सेनाआ यहोवा देवोअ आथलीइल्या वाअहीं,</para>
  <para style="q2" vid="AMO 9:5">धरती ओगलीत जात्ली,</para>
  <para style="q2" vid="AMO 9:5">आन तियीपोअ रोनारे आखे विखु कोअत्ले;</para>
  <para style="q1" vid="AMO 9:5">तें आखेन आखे मिसरोअ नोयीइ होस ओत जात्ले, जें वादते जात्ले आन घोटीत जात्ले.<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />तो जुगोमेहें तियाआ कोअ बोणावत्लू, आन धरतीपोअ जुगमोंड्लाआ पायू टाकत्लू,</para>
  <para style="q2" vid="AMO 9:6">आन दोऱ्याहा आदेश कोअत्लू ताहां पाईं धरतीपोअ वोहो वोलत्लो,</para>
  <para style="q1" vid="AMO 9:6">तियाआज नाव यहोवा होय.<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7" />“ओ इस्राएलवाला,” यहोवा देवोअ ओं वसन होय, “केहें तुमू माआं काजे कुशीवालाआं होस नाहां के? केहें आंय इस्राएलोहो मिसर देसोम रोत आन पलिश्तीवालाहां काप्तोरोम रोत ने काडीत लेत आयू के? आन अरामीवालाहां कीरोम रोत ने लेत आयू के? <verse eid="AMO 9:7" /><verse number="8" style="v" sid="AMO 9:8" />पाला, यहोवा देवोअ नजर या पापी राज्यापोअ लागीत होय, आन आंय याहा धरतीप रोत आरवीत टाकिहीं; तेबी आंय याकोबोअ घराणाहा आखोज ने आरवो,” प्रभु यहोवा देवोअ ओंज वसन होय.<verse eid="AMO 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 9:9" />“माआ आदेशो वाअहीं इस्राएलोअ घराणो आखा देसोमेहें रोत फोलो सारीमेहें ओन सारतेहे तेहेलोहो साराय, पोन तियाआ एक बी मोटू दाणू पुयींपोअ ने पोड़े. <verse eid="AMO 9:9" /><verse number="10" style="v" sid="AMO 9:10" />माआ माअहूं मेऱ्येए आखे पापी जें कोतेहे , ‘ते आफत आमापोअ नाहां आवनारी, आन आमुहूं नाहां केंडनारी,’ तें आखे तारवाइ वाअहीं मोइत जाय.”<verse eid="AMO 9:10" /></para>
  <para style="s">इस्राएलोअ फाशोअ बोणीइलोअ</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />“तियाज गालाहा आंय दाविदोअ पोड़ल्यी खुपड़ीही उबी कोअहीं, आन तियाआ वाड़ीइ नाकाहा हुदारिहीं, आन तियाआ खुटोहो वापिस बोणाविहीं, आन जेहलोहो तों जुना वाडोम ओतो, तेहलोज आंय तियाहा बोणावीहीं; <verse eid="AMO 9:11" /><verse number="12" style="v" sid="AMO 9:12" />जिहीं वाअहीं जें बाकी रोल्ये एदोमवाले होय आन जें बी माअहें माआं कोत गोणाअतेहे तियां आखा देसोहो ताबाम कोइत सेको, ओं काम जो पुरो कोअहे तिया यहोवाआ ओंज वसन होय.”<verse eid="AMO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 9:13" />यहोवा देवोअ ओं बी वसन होय, “पाला,</para>
  <para style="q2" vid="AMO 9:13">एहेलाहा दिही आवताहा के ओल जुपनारो वाडनाराहा</para>
  <para style="q2" vid="AMO 9:13">आन दाराक्शे पेस्कीइनारो बीज लागाड़नाराहा ओलगीत लेय;</para>
  <para style="q1" vid="AMO 9:13">आन डोगोम रोत नोवू दाराक्शाआ रोहो गोलू वोले,</para>
  <para style="q2" vid="AMO 9:13">आन आखा डोगोम रोत निहूं वोले.<verse eid="AMO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 9:14" />आंय माआं इस्राएलवाला माअहुंहूं गुलामीम रोत काडीत लेत आविहीं,</para>
  <para style="q2" vid="AMO 9:14">आन तें उजड़ीइल्या होयरोहो फाश्येए हुदारीत तिहींम वोहती कोए.</para>
  <para style="q2" vid="AMO 9:14">आन दाराक्शाआ मोला लागाड़ीत तियांआं रोहो पिये,</para>
  <para style="q2" vid="AMO 9:14">आन बोगिसा लागाड़ीत तियांआं फोल खाय.<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />आंय तियांहां, तियांआंज जागाम ठाईं देहीं,</para>
  <para style="q2" vid="AMO 9:15">आन मी तियांहां जो जागू आप्युहू तिहींम रोत तें फाशेए केदिहीं ने उपटे,”</para>
  <para style="q1" vid="AMO 9:15">एहें कोत यहोवा देवे कोयोहो.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>