<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Noiri</book>
  <para style="h">इफिस</para>
  <para style="toc3">इफिस</para>
  <para style="toc2">इफिस</para>
  <para style="toc1">इफिसवालाहां प्रेशित पौलुसोअ पत्र</para>
  <para style="mt2">इफिसकरांस प्रेशित पौलाचे पत्र</para>
  <para style="mt1">इफिसवालाहां प्रेशित पौलुसोअ पत्र</para>
  <para style="imt">ओलखात</para>
  <para style="ip">“इफिसवालाहां प्रेशित पौलुसोअ पत्र” ओं पुस्तक तेहलाजमेहें लेखाअयो, जेहलामेहें कलस्सेवालाहां ख्रिस्त जल्माआ 60 वोरह्योंअ फाटी लेख्योतो. या पुस्तकोअ लेखाऱ्यु कोहे के आंय प्रेशित पौलुस होय <char style="xt"><ref loc="EPH 1:1">1:1</ref></char> जाअखे सिकाअले माअहें एहलोहो मानतेहे के पौलुस इफिसवालाहां पत्र लेख्यो, पोन तेबी जो कलस्सेए पत्राम सलाम लेख्यू तेहलुहू वावड़्यु सलाम या पत्रामेहें कायनाहां. यीज गोठी वाईं भागोभागोमेऱ्यीइ वारुज मंडड़ीम या पत्राआ परसार ओवू. पौलुस ओं बी कोहे के, ओं पत्र लेखीइलोअ होमसे तो जेलेमेहें ओतू. <char style="xt"><ref loc="EPH 3:1">3:1</ref>; <ref loc="EPH 4:1">4:1</ref></char> आन <char style="xt"><ref loc="EPH 6:20">6:20</ref></char> पौलुस ओं पत्र इफिसोअ मंडड़ीम तुखिकुस नावोअ जोड़ीदारोअ आथम लेत मोकल्यो. <char style="xt"><ref loc="EPH 6:21-22">6:21-22</ref> </char></para>
  <para style="ip">इफिस ओं जास्ती वोडो होयर ओतो आन आशिया मायनरोअ रोमन इलाखाआ राजधानी ओती. ग्रीक देवता अरतिमिस देवीइ मंदिरोअ काजे इफिस ओं होयर नावासी ओतो. <char style="xt"><ref loc="ACT 19:23-31">प्रेशित 19:23-31</ref> </char>इफिसोअ मंडड़ी सुरुवातिही पुरी उबारीमेहें ओती. पोन तिहींइं फासाड़ी ते धिमी ओत गोयी. प्रगटी <char style="xt"><ref loc="EPH 2:1-7">2:1-7</ref></char></para>
  <para style="ip">पेल्लाआ आरदा पत्रामेहें पौलुस फोड़ कोइत आपेहे के ईसु ख्रिस्तावाअहीं केहें कोइत देव तियाआ माअहुंहूं निवड़्येहे, आन तियांआं पापोमेहें रोत वासाड़ीत लेदेहे. तो मंडड़ीही मोनवीइ शरीरोअरी तुलना कोइत मुनको आन आवालीइ मुख्य कोपराआ डोण ख्रिस्त होय कोहे. या पुस्तकोअ आरदा भागोमेहें विश्वासी जिवन केहें कोइत जिवीइलोअ तों पौलुस कोत आपेहे.</para>
  <para style="iot">रुप रेशा</para>
  <para style="io1">1 पेल्लाआ आध्यायोम <char style="ior"><ref loc="EPH 1:1-2">1:1-2</ref> </char>पौलुस तियाआज ओलखात काडीत आपेहे आन इफिसवालाहां सलाम कोहे.</para>
  <para style="io1">2 ताहरुउ तो फोड़ कोइत कोहे मंडड़ीइ ख्रिस्ताअरीइ नातो <char style="ior"><ref loc="EPH 1:3-3:21">1:3—3:21</ref> </char></para>
  <para style="io1">3 ताहरुउ पौलुस लेखेहे विश्वासी जिवन जिवीइलोअ वाट <char style="ior"><ref loc="EPH 4:1-6:20">4:1—6:20</ref> </char></para>
  <para style="io1">4 सेवटी पोअ पौलुस थोड़ीक गोठ कोत आपित पत्र बंद कोअहे <char style="ior"><ref loc="EPH 6:21-24">6:21-24</ref></char></para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:19-21">प्रेशित 18:19-21</ref>; <ref loc="ACT 19:1">19:1</ref></char>
    </note>पौलुसोअहीं रोत, जो देवोअ इश्शा वाअहीं ख्रिस्त ईसुउ डायु खोबर्‍यू होय, इफिसोमेर्‍याआं विश्वासी माअहुंहूं, जें ख्रिस्त ईसुमेहें इमानदार होय:<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />आपाआ देव बाह्हू आन मालिख ईसु ख्रिस्त तुमुहूं मेरवानी आन शांती आपुहूं जोवे.<verse eid="EPH 1:2" /></para>
  <para style="s">ख्रिस्तामेहें आत्मिक आशिर्वाद</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />आपाअ मालिख ईसु ख्रिस्ताआ देव आन बाह्हाअ आभार ओवे, के तिये आपुहूं ख्रिस्तामेहें होरगामेर्‍याआ आखी जातीइ आत्मिक आशिर्वाद आप्याहा.<verse eid="EPH 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 1:4" />जेहलोहो देवे आपुहूं दुन्यांअ बोणीलोअ पेल ख्रिस्तामेहें निवड़ीत लेदेहे के आपू तियाआ सामने मेरेमेहें सोके आन निर्दुस रोअहूं जोवे. <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />देवे पेलूज रोत ठरवीइल्यो के ईसु ख्रिस्तावाअहीं तो आपुहूं तियाआ बेटेह्हे बोणावे एज तियाआ खुसी आन उद्देश. <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />के देवोअ तियी मेरवानीइं महिमाअ स्तुती ओवे, जे मेरवानी तिये आपुहूं मेराला बेटाह्हामेहें फुकट आप्यी. <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" /><note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 1:14">कलस्से 1:14</ref> </char></note>ईसु ख्रिस्ताआ रक्तावाअहीं आपुहूं सुटका मोन्ज्ये आपाआ पापोअ माफी मिल्यी. केतीही वोडी देवोअ मेरवानी,<verse eid="EPH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 1:8" />जियाहा तिये आखी बुद्दी आन होमोजोंअरी आपापोअ भारपुर कोअयी. <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />देवे जो कोयो तो कोअयो, आन आपुहूं गुप्त्यी योजनाआ बाप्तिमेहें कोयो जो तिये पेल रोतुज ख्रिस्ता वाअहीं पुरो कोइलोअ ठरव्योतो, <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />के वेल पुरी ओवीइलोअ एहलीही योजना बोणे के जों किबी होरगामेहें होय, आन जों किबी धरतीपोअ होय, आखो बोठो देव ख्रिस्तामेहें एक्ठो कोए.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />आखी वस्तू देवोअ योजनाआ काजे होय; आन देवे आपुहूं तियाआज योजनाआ काजे ख्रिस्ताअरी मिलीत तियाआ खाजगी माअहोंअ रुपोमेहें निवड़्ये ओं तिये पेलूज रोत ठरव्योतो. <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />के आपू, जियां पेलरोत ख्रिस्तापोअ आशा मेक्यीते, देवोअ महिमा स्तुतीइ कारण ओवे!<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />आन जेहेलाम तुमू खोरु संदेश उनाअये तेहेलाम तुमू बी देवोअ माअहें बोण्ये, ते हाजी बातमी जिहीं वाईं तुमुहूं सुटका जोड़्यी. तुमू ख्रिस्तापोअ विश्वास कोअयू, आन देवे तुमुहूं पवित्र आत्मा आपित कोइत खासगी हक्काआ कोत तुमापोअ तियाआ सिक्कु लागाड़्यु, जियाआ तिये आथवसन आप्योतो. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />आत्मा जो होय तो तिये सोताआ माअहोंहों आपल्य आथवसन होय, यावाअहीं आपुहूं पाक्कू भरिवसू जोड़ेहे के देव तियाआ माअहोंहों पुरी सुटका आपे. आवा आपू तियाआ महिमाआं स्तुती कोअहूं!<verse eid="EPH 1:14" /></para>
  <para style="s">पौलुसोअ प्रार्थना</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />तिहीं वाईं आंय बी प्रभु ईसुपोर्‍युउ तुमाआं विश्वासोअ उनाइत आन देवोअ माहूंपोर्‍यीइ तुमाआं मेर देखीत कोइत, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />तुमाआं कोअते देवोहो आभार मानीइलोअ नाहां सोड़तू, आन माआं प्रार्थनामेहें तुमुहूं ओर कोअया कोअहो. <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />काहाके आपाअ प्रभु ईसु ख्रिस्ताआ देव जो महिमाआं बाह्हू होय, तुमुहूं तियाआ ओलखातीमेहें बुद्दी आन उजालाअ आत्मा आपे, <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />आन तुमाआं मोनोअ डोआ उजालावाला ओवे के तुमू जाइंत लेअहूं जोवे के तियाआ हादीइलोअ आशा कि होय, आन पवित्र माअहूंमेहें तियाआ वारसाआ महिमाआं धन केतोहो होय, <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />आन जें विश्वास कोअतेहे तियां आपामेहें तियाआ ताकत केतीही वोडी होय, तियाआ ताकतोअ जोर तियाआ कामोअ इसाबोवाअहीं समजीत लेअहूं जोवे, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" /><note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन 110:1</ref></char></note> तिये तों काम ख्रिस्तामेहें कोअयो के तियाहा मोल्यामेहें रोत जिवाड़ीत कोइत होरगाआ जागामेहें तियाआ हाजाड़्यी वोगेहे बोहाड़्यू. <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />आखी जातीइ राज, आधिकार, ताकत, राज सालाड़नारी ताकत, आन जों नाव फक्त यी धरतीपोअ एतोज नाहां, पोन आवनारा राजोमेहें बी तोंज नाव रोय, तियाहा बादा नावो रोत उसे बोहाड़्यू. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />आन आक्खोज तियाआ गुडाआ थुड़ी कोई देदो; आन तियाहा आखी वस्तूपोअ मुख्य ठरवीत कोइते मंडड़ीही आपी देदू.<note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="PSA 8:6">भजन 8:6</ref>; <ref loc="COL 1:18">कलस्से 1:18</ref></char></note> <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />मंडड़ी ख्रिस्ताआ शरीर होय, आन तियाआज भारपुरी होय, जो आखामेहें आक्खोज पुरो कोअहे.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">मोतोअहें रोत जिवनोम</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="COL 2:13">कलस्से 2:13</ref>
      </char>
    </note> तिये तुमुहूं बी जिवाड़्ये जें सोताआ सुक आन पापोअ वाखरी मोइत रोयेते. <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />जियामेहें तुमू पेल यी दुन्याअ पद्दतीवाईं, आन जुगोमेऱ्याआ राज्याआ आधिकारी मोन्ज्ये तुमू तिया आत्माआं परमाणे सालतेते, जो ओमे बी आदेश ने माननारा माहूंमेहें काम कोअहे. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />यामेहें आपू बी आखेज पेल आपाअ शरीरोअ लालसोमेहें दिही काटतेते, आन शरीरोअ आन मोनोअ इश्शा पुरी कोअतेते, आन बिहीरा माअहोंअ होस सोभावोज वाअहीं देवोहो खोत लागाड़नारे पोर्‍ये ओते.<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />पोन देव जो दयाआ मालिख होय, तियाआ तियी वोडी मेरेए वाखरी, जियी वाअहीं तिये आपापोअ मेर कोअयी, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />जाहां आपू सुकीइ वाखरी मोल्ये ओते, ताहां आपुहूं ख्रिस्ताअरी जिवाड़्ये; मेरवानीज वाअहीं तुमाआं तारण ओवोहो.<note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="COL 2:13">कलस्से 2:13</ref></char></note> <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />आन आपुहूं ख्रिस्त ईसुमेहें तियाअरी जिवाड़्ये आन होरगाआ जागाम तियाअरी बोहाड़्ये. <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />काहाके तो तियाआ तियी मेरवानी वाअहीं जे ख्रिस्त ईसुमेहें आपापोअ होय, आवनारा दिहोमेहें तियाआ वोडी मेरवानी देखाड़ीत सेके. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />काहाके देवोअ मेरवानी वाअहींज विश्वासोअ वाखरी तुमू वासाअयेहे; आन ओं तुमा वाअहीं नाहां ओवो, पोन देवोअ भेट होय, <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />आन ओं नाहां आपाआ कामों वाअहीं, एहलोहो ने ओवुहूं जोवे के एखु वोडाय कोए. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />काहाके आपू देवोअ बोणावल्ये होय, आन ख्रिस्त ईसुमेहें तियां हाजा कामोंअ काजे बोणायेहे, जियांहां देवे आपाआ काजे पेलुज रोत तियार कोअयेहे.<verse eid="EPH 2:10" /></para>
  <para style="s">ख्रिस्तामेहें एक</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />याअ काजे ओर कोआ के, तुमू एका गालाहा शारीरिक रितीवाअहीं बिगर यहुदी ओते, आन जियां माअहुंउं खतना शरीरोमेहें आथोवाअहीं ओवुतो, तें माअहें खतनावाले कोवाड़तेते, आन ते तुमुहूं बिगर खतनावाले कोत गोगाड़तेते. <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />तियी वेले तुमू ख्रिस्ताअरी रोत आलांग ओते, आन इस्राएलोअ माअहुंउं जागापोअ रोत आलांग कोअल्ये, आन शप्पतोअ आथवसनोअ भागीदार ने ओते, आन विण आशाआ आन दुन्यामेहें बिगर देवोअ ओते. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />पोन तुमू जें पेल ख्रिस्त ईसु रोत सेटे ओते, ओमे ख्रिस्ताआ रक्तावाअहीं<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="fq" closed="false">रक्तावाअहीं </char><char style="ft" closed="false">ख्रिस्ताआ मोतोवाअहीं</char></note> आहने ओत गोयेहे. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />काहाके ख्रिस्त आपाअ मिलवीइनारु होय, जिये यहुदी आन बिगर यहुदी बेनुहूं एक कोअये. तिये आलाग कोअनारा विसमेऱ्याआ पितड़ाहा ओदारीत टाक्यो. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" /><note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="COL 2:14">कलस्से 2:14</ref></char></note>आन ते कायदा आन नियमोंअ रिती तिये सोताआ शरीरोवाईं रद्द कोअयी. तों याअकाजे के सोतामेहें बेनुहूं एक नोवो माहुंउं बोणावीत तियांहां मिलाड़ीत सेके. <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" /><note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="COL 1:20">कलस्से 1:20</ref> </char></note>आन क्रुसोपोअ दुस्मोनीहीं आरवीत कोइत तियावाअहीं बेनुहूं एक शरीर बोणावीत देवोअरी मिलाड़ीत सेके. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" /><note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="ISA 57:19">यश 57:19</ref></char></note> ख्रिस्ते आवित कोइत जें सेटे ओते आन जें आहने ओते, तियां बेनुहूं जुड़वीइलाआ हाजी बातमी कोत आप्यी. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />काहाके ख्रिस्ता वाअहीं आपा बेनुउं एका आत्मामेहें देव आब्हाआ जागे जाअलोअ लायकी जोड़ेहे.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />तियाहाकोत तुमू परदेसी आन वाटारे कायनाहां, पोन पवित्र माअहोंअ हेंगात्ये खाजगी देसोवाले आन देवोअ कुटूंबामेर्‍येए ओत गोये. <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />आन तुमू ताम प्रेशित आन भविश्यवक्ताआं पायापोअ बांदल्यी आवाली होय, ख्रिस्त ईसु सोताहा तियी आवालीइ कोपराअ डोण होय. <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />पुरी आवाली तियावाईं जुड़ात रोयीही आन प्रभुमेहें एक पवित्र मंदिर बोणतो जाहे, <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />तिहींमेहें तुमू बी एकमेकाअरी आत्मावाअहीं देवोअ रोअलाअ ठिकाण बोणिइलोअ काजे एक्ठेज बांदाअते जातेहे.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">बिगर यहुदीमेहें पौलुसोअ सेवा</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />यीज गोठी वाअहीं आंय पौलुस जो तुमा बिगर यहुदीइ काजेहे ख्रिस्त ईसुउ काजे बांदाअलू होये. <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />जर तुमू देवोअ तियी मेरवानीइ योजनाआं खबर उनायेय, जे तुमाआं काजेहे माहूं जोड़्यीही; <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />मोन्ज्ये ओं के ते गुप्त्यी योजना माहूं देखाड्‍यी, आन आंय पेल बी थोड़ाक शब्दाम लेख्यीही; <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />जियाहा तुमू वासीत कोइत जाईंत सेकतेहे के, आंय ख्रिस्ताआ ते गुप्त्यी गोठ समजाड़ोहो.<note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="COL 1:26-27">कलस्से 1:26-27</ref></char></note> <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />ते गोठी जेहेंकोइत आत्माआं वाअहीं ओंमे तियाआ पवित्र प्रेशितों आन भविश्यवक्तांपोअ देखाड़ी देदीही तेहेंकोइत जुना वाडोमेऱ्यीइ पिढ़ीही नाहां देखाड़्यी. <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />मोन्ज्ये एहलोहो के ख्रिस्त ईसुमेहें हाजी बातमी वाअहीं बिगर यहुदी मांअहें वारसामेहें भागीदार, आन एक्कुज शरीरोअ भाग आन शप्पतोअ भागिदार होय.<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />देवोअ मेरवानीइ तियी भेटेए इसाबोवाअहीं जे तियाआ ताकतोअ इसाबो वाअहीं माहूं आप्यीही, तियी हाजी बातमीइं आंय सेवक बोण्यु. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />आंय जो आखा सोका माअहूंमेहें रोत हानाम रोत हानू होय, देवे तियाआ मेरवानी माहूं आप्यी, काहाके आंय बिगर यहुदी ख्रिस्ताआ गोणाय ने एताहा धनोअ हाजी बातमी कोत सेको, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />आन जो आखाआ बोणावनारु होय तिये देवे कोलीइ सुरुवातिही रोत गुप्त्यी मिक्यीते, ते गोठ्यी आखाहा उगाड़ीत देखाड़ीत सेको. <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />याअकाजे के ओंमे मंडड़ीवाअहीं, देवोअ बातीवानीइ बुद्दी, तियां मुख्याहां आन आधिकार्‍योंहों जे होरगाआ जागाम होय, तियांहां ए गोठी मुंदू जाअहूं जोवे. <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />देव तियाआ हादाफल्याआ उद्देशोअ कोअता एहलोहो कोअयो, जो तिये आपाआ प्रभु ईसु ख्रिस्ताआ वाअहीं पुरु कोअयू. <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />जियामेहें आपुहूं तियापोअ विश्वास कोअल्या वाअहीं हिम्मत आन भरीवसाअरी देवोअ हजरीमेहें आविइलोअ आधिकार जोड़्युहू. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />तियाहा काजे आंय तुमुहूं रावणी कोअहो, के आंय तुमाआं काजे जों दुख वेठोहो, तिहीं वाईं तुमू नाराज मा ओवहा. काहाके ओं आखो तुमाआं हाजाआ काजेज होय.<verse eid="EPH 3:13" /></para>
  <para style="s">ख्रिस्ताआ मेर</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />याआ वाखरी आंय देव आब्हाआ सामने मांड्या पोड़ीत वोंदोहो. <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />इंहीं वाअहीं होरगामेहें आन धरतीपोअ आखा परिवारोहो बोणावीत नाव मिक्योहो. <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />काहाके तो तियाआ महिमाआ धनो वाअहीं तुमुहूं ओं दान आपे आन तुमू तियाआ आत्मा वाअहीं आपाआ मायवाला जिवोमेहें मजबुत बोणित सेके. <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />आन आंय प्रार्थना कोअहो के विश्वासो वाअहीं ख्रिस्त तुमाआं मोनोमेहें तियाआ कोअ बोणावीत रोअहूं जोवे, आन तुमू मेरेमेहें उंडे रोत मजबुत पायू बांदल्याआ होस रोअहूं जोवे. <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />याआकाजे के, तुमू आखे देवोअ मांअहें, ख्रिस्ताआ मेर केतीही पोली, नांबी, उसी, आन केतीही उंडे रोत होय तों ओलखुंहूं जोवे. <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />काहाके ख्रिस्ताआ वोडी मेर तुमू समजीत सेकहा जे आपाआ ओकलेए बाहर होय, मोन्ज्ये तुमू देवोअ एतेहे हारेपुरे ओत जाअहूं जोवे.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />ओंमे जो एतुहू सेक्तीवालू देव होय के आपाआ विनंती आन ओकलेए बाहर तियी सेक्तीवाअहीं तो आपामेहें काम कोअहे. <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />देवोअ महिमा मंडड़ीमेहें आन ख्रिस्त ईसुमेहें कायम आन पिढ़ीन पिढ़ी रोअहूं जोवे! आमेन.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">ख्रिस्ताआ शरीरोमेहें एकी</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />तियाहा काजे आंय जो देवोअ सेवा कोअत्लू कोत जेलेम होय, तो तुमुहूं विनंती कोअहो: देवे तुमुहूं हाद्येहे तांहा तुमू तियाहा पोटे एहलोहो जिवन जिवा. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" /><note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="COL 3:12-13">कलस्से 3:12-13</ref> </char></note>कायम नम्र, हानाले रोवा, आन धिर तोइत रोवा, आन मेरेमेहें एकमेकाहा वेंडारीत ल्या. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />आत्माआं एकी मिकीइलाआ कोअते ओवे तेती मेहेंनत कोआ. शांतीमेहें एकमेकाअरी जुड़ात रोवा. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />जेहलेहे तुमुहूं बी एकुज आशाम भागीदार ओवे तेहें काजे हाद्येहे तेहेंज कोइत एक शरीर आन एकुज आत्मा होय. <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />एकुज प्रभु, एकुज विश्वास, एकुज बाप्तिस्मा<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="fq" closed="false">बाप्तिस्मा </char><char style="ft" closed="false">पांअयोंम बुडाड़ीत बाअथे काडीइलोअ रिती</char></note>; <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />आखाआ एकुज देव आब्हू होय, जो आखाप रोत उसे, आखाआ विसमेहें आन आखाम रोत कोइत काम कोअहे.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />पोन आपामेहें हारेक जोओंहों ख्रिस्ताआ दानोअ मापोअ पुरमाणे मेरवानी जोड़्यीही. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />तियाहा काजे वसन एहें कोहे:</para>
  <para style="q1" vid="EPH 4:8">“जेहलामेहें तो आखाम रोत उसे गोयू,</para>
  <para style="q2" vid="EPH 4:8">आन तो वारुज जेलाऱ्याहां सोताअरी लेत गोयू,</para>
  <para style="q2" vid="EPH 4:8">आन तिये माअहुंहूं वरदान आप्यो.”<verse eid="EPH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 4:9" />ओमे, “तो उसे गोयू,” याअ अर्थ कि? याअ अर्थ ओं के तो पेल तियी कोली धरतीइ आखाम रोत निसर्‍याआ जागामेहें उतर्‍यू.<note caller="+" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="HEB 2:9">इब्री 2:9</ref>; <ref loc="JHN 3:13">योहान 3:13</ref> </char></note> <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />आन जो निसे उतर्‍यू तोज उसे जुगोम गोयू, आन तिया रोत बी उसे गोयुहू, जिहीं वाईं तो आखी गोठी पुरी कोइत सेके. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />दान आपनारु तोज होय, आन तिये थोड़ाक जोओंहों प्रेशित कोत निवड़्याहा, आन थोड़ाक जोओंहों भविश्यवक्ता कोत, आन थोड़ाक जोओंहों सुवार्ता कोत आपनारा, आन थोड़ाक जोओंहों सेवक आन मास्तर कोत निवड़्याहा. <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />जिहीं वाअहीं देवोअ माअहें तियार ओत सेके आन सेवाआ काम कोअहूं जोवे आन ख्रिस्ताआ शरीर आत्माम वादतो जाअहूं जोवे. <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />जाअहूं जाआं आपू आखेज विश्वास आन देवोअ बेटाह्हाआ ओलखातीमेहें एक ने ओत जाहूं, आन एक समजदार माअहें ने ओत जाहूं, ताअहूं जाआं ख्रिस्ताआ होस बुद्दीमेहें एक ने ओत जाहूं . <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />तांहा ओमे रोत आगाड़ी आपू पोर्‍ये जेहें ने रोअहूं जोवे, जो माअहुंउं ठोग-हिकवोण आन हुशारी वाअहीं, तियांआं ठोगोअ गोठीइ हारेक हिकवोणो वाअहीं, फोला वाराअरी एहें-तेहें आलवाअनारा नावड़ाआ होस ने ओवुहूं जोवे. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />पोन मेरेवाईं सत्य गोगुहूं जोवे आन आखी गोठीमेहें जो मुंड होय, मोन्ज्ये ख्रिस्तामेंहे वादते जाअहूं जोवे. <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />जिहींवाईं आखो शरीर, हारेक मुलोवाअहीं आरी मिलीत आन एक्ठे ओवीत, तिया प्रभावो वाअहीं जो शरीरोअ हारेक भाग ठीक ठीक काम कोअल्या वाअहीं तियामेहें रोहे, तेहेलोहो आपाआ डिलोअ भाग बी जिवज्योअ मेरेमेहें वादता जाताहा.<verse eid="EPH 4:16" /></para>
  <para style="s">ख्रिस्तामेहें नवो जिवन</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />याअ कोअते प्रभुउ नावसे आंय रावणी कोअहो के, जेहलेहे बिगर विश्वासी माहें खाराब विसार लेत सालतेहे, तेहेलेहे तुमू ओमे आगाड़ी रोत मा सालहा. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />काहाके तियांआं बुद्दी आंदारामेहें होय, तियांआं मोने कठीण ओत गोयेहे तियाहाकोत तें विण ओकल्ये बोणीत ते देवोअ जिवणा रोत पारके ओत गोयेहे. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />आन तें आखी जातीइ खाराब कामे लालसोवाअहीं कोअया कोइलोअ काजे विणलाज्ये ओत कोइत लुसड़ायीइ कामोमेहें लागीत गोयेहे.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />पोन तुमू ख्रिस्ताप रोत एहलिही हिकवोण नाहां हिकाअये. <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />जर तुमू तियाआ बाप्तिम उनाअयेय आन जेहलोहो ईसुमेहें सत्य होय, तेहलोहो तियाम सिकाअयेय, <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />ताहां तुमामेर्‍युउ जुनू सोभाव काडीत टाकुहूं जोवे, काहाके तो तुमाआं जुना जिवनोहो खाराब लालसोवाईं बिगाड़्याज कोअहे. <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />आन तुमू तुमाआं मोनोअ आत्मिक सोभावोमेहें नवे बोणते जाअहूं जोवे. <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />आन तुमू नोवू सोभाव पोवित लेअहूं जोवे, जो देवोअ होसऱ्योअ सत्य सतीपण आन सोको जिवन होय.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />तियाहा कोत ठोगहा मा! हारेक जोओं एकमेकाअरी खोरो गोगुहूं जोवे, काहाके आपू आखे ख्रिस्ताआ शरीरोमेहें एकमेकाअरी जुड़ाअला भाग होय.<note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="COL 3:9">कलस्से 3:9</ref>; <ref loc="ROM 12:5">रोम 12:5</ref>; <ref loc="ZEC 8:16">जख 8:16</ref></char></note> <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />खोत कोआ, पोन पाप मा कोअहा; दिही बुड्ताआ आगोदर तुमाआं खोत उलात जाअहूं जोवे. <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />सैतानोहो जागू मा आपहा. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />सोरी कोअनारु फाशोअ सोरी ने कोअहूं जोवे, पोन उलटो हाजे कामे कोइलाआ काजे सोताआ आथोवाअहीं मेहेंनत कोअहूं जोवे; तों याआकाजे के जें गरीब होय तियांहां मदत कोइलोअ काजे तियांपोअ वाजिहीं सिल्लक रोअहूं जोवे. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />तुमाआं सोबीम रोत तुमू उसक्ड़्ये शब्दे मा वापराहा, पोन गरज पोड़्यी ताहां हाजु सुधार ओवुहूं जोवे एहलेहे शब्देज वापरा, ताहां बिहीराहा बी उनात कोइत हाजो लागे. <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />देवोअ पवित्र आत्माहां दुखी मा कोअहा, काहाके तो तुमाआं सुटकाआ दिहोअ काजे तुमापोअ देवोअ हक्काआ सिक्कु लागाड़्युहू. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />आखी जातीइ कड़वा विसार, खिजवाइलोअ, खोत कोइलोअ, जोराखा उठीइलो आन रोवा कोइलोअ, ओं आखी जातीइ खाराब तुमामेहें रोत काडीत टाका. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />आन तुमू एकमेकापोअ मेर कोअनारे, आन माया कोअनारे ओवा; जेहेंकोइत देवे ख्रिस्तामेहें तुमाआं गुनां माफ कोअया, तेहेंज कोइत तुमू बी एकमेकाहा माफ कोआ.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">उजालाआ पोर्‍ये बोणा</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />तुमू देवोअ मेराले पोर्‍ये होय, तिहींवाईं तुमू तियाआज होस बोणुहूं जोवे. <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />जेहेंकोइत ख्रिस्ते आपापोअ मेर कोअयी तेहेंज कोइत तुमू बी मेरेवाईं वागा; तिये ताम देवोहो गोमे एहलोहो अर्पण आन गाराहा कोत सोताआ जिव आपाआ काजे आपी देदू.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />जेहलोहो देवोअ माअहुंहूं ने होबे एहलोहो तुमामेहें सिनालो, आन कोड्ली बी जातीइ एठो काम नेत लालस कोइलोअ गोठी ने जोवे. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />आन नेत विणलाज्यी बाशाआ वापर, नेत साड़गाय, नेत निंदा कोइलोअ, ए गोठी तुमाम ने जोवे, एहलिही गोठी होबा नाहां देती. तेताआ वोतीइ तुमू देवोअ धन्यवाद कोअहूं जोवे. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />काहाके तुमू ओं जांअतेहे के सिनालो, खाराब कामे कोअनारे, लालसी मांअहें, ओं मुर्तीपुजाआ होस होय. एहलेहे माहें ख्रिस्ताआ आन देवोअ राजोअ वारसदार नाहां ओवनारे.<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />रिकामा बाशणोवाअहीं कोडो तुमुहूं ठोगुहूं ने जोवे; काहाके यांज कामोवाअहीं देवोअ खोत आदेश ने माननारा माहूंपोअ पोड़केहे. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />तियाहाकोत तुमू तियांअरी भागिदार मा बोणहा. <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />काहाके तुमू पेल आंदारामेहें ओते, पोन जेदिहीं रोत तुमू देवोअ माअहें बोण्येहें, तेदिहीं रोत तुमू उजालामेहें होय, तियाहाकोत तुमू उजालाम सालनारा माअहुंउं होस साला. <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />काहाके उजालाअ फल आखी जातीइ भलाय, आन सतीपण, आन सत्य होय, <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />आन देवोहो कि गोमेहें तो फारकीत ल्या. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />आंदाराआ फालतु कामोमेहें भागिदार मा ओवहा, पोन उलटो तियाहा खुल्लो कोइत देखाड़ा. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />काहाके तियांआं गुप्त्ये कामे सोबीवाअहीं कोत आपीइलोअ बी लाज आवेहे. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />आन आखी गोठी उजालामेहें खुल्ली देखाअतीही, आन उजालो पाड़नारु ताम तो दिवू होय. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />याअ कोअते तो कोहे,</para>
  <para style="q1" vid="EPH 5:14">“ए हुवनारा उठ,</para>
  <para style="q2" vid="EPH 5:14">मोल्याम रोत जिवतु ओव;</para>
  <para style="q1" vid="EPH 5:14">ताहां ख्रिस्ताआ उजालो तापोअ सोमके.”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />तियाहाकोत तुमू केहें कोइत जिवतेहे तों सांबाला. विणहान्या माहुंउं होस मा सालहा, पोन हानाला माहुंउं होस साला. <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />वेलेए हाजू वापर कोइत ल्या, काहाके दिही खाराब होय.<note caller="+" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="AMO 5:13">आमोस 5:13</ref>; <ref loc="COL 4:5">कलस्से 4:5</ref></char></note> <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />तियाहाकोत तुमू विण ओकल्याआ होस मा ओवहा, पोन देवोअ मोर्जी कि होय तों तुमू जांइत ल्या.<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />दाराक्शाआ रोह<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="fq" closed="false">दाराक्शाआ रोह </char><char style="ft" closed="false">दाराक्शे आवाड़ीत गालीत कोइत बोणावल्यी एकी जातीइ पीइलोअ नशाआ वस्तू</char></note> पीत कोइत झिंगवाअहा मा; काहाके या वाअहीं लुसड़ाय ओवेहे, पोन आत्मा वाअहीं पोआते जावा. <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />एकमेकाअरी भजने, स्तुतीगिते आन आत्मिक गिते गावया कोआ, जिवज्योअ मोनोमेहें प्रभुउ सामने स्तुतीगिते गावते रोवा. <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />आन सादा आखी गोठीइ काजे आपाआ प्रभु ईसु ख्रिस्ताआ नावोवाअहीं देव आब्हाआ धन्यवाद कोअते रोवा.<verse eid="EPH 5:20" /></para>
  <para style="s">बेन माहुंउं जिवणो</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />ख्रिस्ताआ बिके वाअहीं मानपान कोइत एकमेकाआ ताबाम रोवा.<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />बोईं, तुमू जेहेंकोइत देवोअ ताबाम रोतीही, तेहेंज कोइत तुमू जिवज्योअ कोअधण्योअ ताबाम रोवा. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />काहाके जेहेंकोइत ख्रिस्त मंडड़ीइ मुख्य होय, तेहेंज कोइत माटी बोईंइ मुख्य होय, आन ख्रिस्त तियाआ पुरा शरीरोअ तारनारु होय. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />पोन मंडड़ी जेहेंकोइत ख्रिस्ताआ ताबाम होय, तेहेंज कोइत बोईं, तुमू बी आखी गोठीम जिवज्योअ माट्योअ ताबाम रोअहूं जोवे.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />माट्यों, तुमू जिवज्योअ बोईंहीं मेर कोआ, जेहें कोइत ख्रिस्ते मंडड़ी पोअ मेर कोइत तियाआ जिव मंडड़ीइ काजे आपी देदू. <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />ओं याअ कोअते के, तो मंडड़ीही तियाआ वसनरुप पाअयों वाअहीं तुवीत, सोकी आन पवित्र कोइत देवोहो होपीत सेके. <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />एताआ काजे के, तो मंडड़ीही वोड़लीइ होस सोताआ काजे हिंगरावित देवोअ सामने हजर कोइत सेके, तियीम वाहीं बी डाग, सुक नेत आरोप ने जोवे, पोन सोकी आन निर्दुस जोवे. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />तेहेंज कोइत माटी बी खाजगी बोईंपोअ सोताआ जिवोअ होस मेर कोअहूं जोवे. जो खाजगी बोईंपोअ मेर कोअहे, तो सोतापोअ मेर कोअहे. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />कोडो बी सोताआ शरीरोअ सीस नाहां कोअतो, पोन तो वारुहूं सांबालेहे, तेहेंज कोइत ख्रिस्त बी मंडड़ीही सांबालेहे. <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />काहाके आपू ख्रिस्ताआ शरीरोअ भाग होय. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />“याअ कोअते माटी तियाआ आयहीन आब्हाहा सोड़ीत तियाआ लाडीइरी मिलीत रोय, आन तें बेनु एक डिल बोणीत रोय.”<note caller="+" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="GEN 2:24">उत्प 2:24</ref></char></note> <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />ए ते जास्ती उंडेए गुप्त्यी गोठी होय, पोन आंय ख्रिस्त आन मंडड़ीइ विसमेऱ्यीइ गोठी कोहो. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />तेहेंज कोइत तुमामेर्‍याआ आखाज जेहेंकोइत सोतापोअ तेहेंज कोइत तुमाआं बोईंपोअ मेर कोआ, आन बोईं सोताआ कोअधण्योअ मानपान मिकुहूं जोवे.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">आयहीन आब्हू आन पोर्‍ये</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />पोर्‍या तुमू देवोमेहें तुमाआं आयहीन आब्हाआ गोठी माननारे बोणा, काहाके ओं हाजो होय. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“तु ताआ आयहीन आब्हाआ मानपान कोओ,” ओ एहेलुहू पेहलुज आदेश होय जियाअरी आथवसन बी होये. <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />तों एताआ काजे के ताआ हाजो ओवुहूं जोवे आन ताहूं धरतीपोअ नांबो जिवन जोड़ुहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="EXO 20:12">निर्ग 20:12</ref>; <ref loc="DEU 5:16">कायदा 5:16</ref></char></note><verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />ए पोर्‍यावाला, तुमाआं पोर्‍याहां मा खिजवाहा; पोन तियांहां प्रभुउ हिकवोण आन सुसना पालन कोइलोअ सिकाड़ते जावा.<verse eid="EPH 6:4" /></para>
  <para style="s">मालिख आन पावर</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />ए पावरों, यी दुन्यामेहें जे तुमाआं मालिख होय, तियांआं जेहेंकोइत तुमू ख्रिस्ताआ बिक राखीत ख्रिस्ताआ गोठी मानताहा, तेहेंज कोइत तुमाआं मोनोअ इमानदारी वाईं मानपान आन कापता जात तियांआं गोठी माना. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />माअहुंहूं खुस कोइलोअ काजे उपरसोल्यी देखाड़ीइलोअ सेवा मा कोअहा, पोन ख्रिस्ताआ सेवकोअ होस पुरा मोनोवाअहीं देवोअ इश्शाआ पुरमाणे साला. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />ए माअहुंउं सेवा नाहां, पोन देवोअ सेवा जेहें समजीत खुसी वाअहीं कोआ. <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />काहाके, तुमुहूं ओं मुंदू होय के, तो गुलाम ओय नेत सुटलू ओय, जो कोडो हाजो काम कोए, तिया हारेक जोओंहों देवोअहीं रोत इलाम जोड़े.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />मालख्यों, तुमू बी तुमाआं पावरोहों धमकी देअलोअ सोड़ीत तियांअरी हाजा वागा; काहाके तुमुहूं ओं मुंदू होय के, तुमाआं आन तियांआं बेनुउं देव होरगाम होय आन तो कोडाआ भेदभाव नाहां कोअतु.<note caller="+" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="LUK 6:31">लुक 6:31</ref>; <ref loc="DEU 10:17">कायदा 10:17</ref>; <ref loc="2CH 19:7">2 इति 19:7</ref></char></note><verse eid="EPH 6:9" /></para>
  <para style="s">विश्वासी माअहोंअ आत्मिक आथ्यारे</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />तियाहाकोत, देवोमेहें आन तियाआ वोडी सेक्तीमेहें मजबुत बोणा. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />सैतानोअ योजनाआ सामने उबे रोअलोअ काजे देवोअ आथ्यारे बांदीत ल्या. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />काहाके आपाआ ए लड़ाय रक्ता-माहोंअरी नाहां, पोन राज कोअनारा जुगोमेर्‍याआ खाराब आत्मिक आधिकारीइरी, आज्याआ आंदारामेर्‍याआ दुन्याआ मुख्याअरी, आन जुगोमेऱ्याआं पुतोंअरी होय. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />तियाहाकोत देवोअ आथ्यारे बांदीत ल्या के तुमू खाराब दिहोमेहें लड़ाय कोइत सेकहा, आन आखो पुरो कोइत वातड़े रोत सेकहा.<figure style="fig" alt="Roman soldier" file="LB00196C.TIF" size="col" copy="Horace Knowles ©" ref="6:10">रोमन सैनिक</figure><verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />तियाहा कोत तुमाआं कंबर सत्यावाअही बांदा; सतीपणोअ लोखिंडाआ आंगड़ो पोवित ल्या, <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />आन गुडामेहें शांतीइ हाजी बातमीइं काजे तियारीइ बुटे पोवित ल्या, <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />आन यां आखाअरी विश्वासोअ ढाल आथोम तोआ आन उबे रोवा. यावाअहीं तुमू तियां आखा सैतानोअ पेटाअनारा बिलखाहा उलवित सेकहा. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />आन तारणोअ टोपू, आत्माआं तारवाआ, जों देवोअ वसन होय तों लेत ल्या.<note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="ISA 49:2">यश 49:2</ref>; <ref loc="ISA 59:17">59:17</ref>; <ref loc="HEB 4:12">इब्री 4:12</ref> </char></note> <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />केती बी वेले आन केहें कोइत बी आत्मामेहें प्रार्थना, आन रावणी कोअते रोवा, आन आखा सोका माअहुंउं कोअते कायम प्रार्थना कोअते जात जागते रोवा. <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />माआं कोअते बी प्रार्थना कोआ, काहाके आंय जेहलाम गोगहीं, तेहलाम माहूं हाजी बातमी कोअलोअ काजे हाजे शब्दे जोड़ुहूं जोवे. <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />काहाके यी हाजी बातमीइं काजे आंय जेलेम केंडाअलु राजदुत होय, आन माहूं हिमते वाईं गोगता आवड़ुहूं जोवे कोत प्रार्थना कोआ.<verse eid="EPH 6:20" /></para>
  <para style="s">आखरीपोअ सलाम</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />मेरालू पाही आन प्रभुमेहें भरिवसाआ सेवक तुखिकुस ओ तुमुहूं आखो कोये के, माआं कि सालू होय तों तुमुहूं बी समजाय. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />आमू हाजा होय, ओं तुमुहूं समजे आन ताहां तुमाआं मोनोमेहें होक आवे, तियाहाकोत आंय तियाहा तुमाआं जागे मोकल्युहू.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />देव आब्हा आन प्रभु ईसु ख्रिस्ताप रोत आखा पाव्हीइलाहां होक आन विश्वासोअरी मेर जोड़ुहूं जोवे. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />आपाआ प्रभु ईसु ख्रिस्तापोअ जें मेर कोअतेहे तियां आखापोअ देवोअ मेरवानी रोअहूं जोवे.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>