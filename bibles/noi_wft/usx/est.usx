<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EST" style="id">- Noiri</book>
  <para style="h">एस्तेर</para>
  <para style="toc3">एस्तेर</para>
  <para style="toc2">एस्तेर</para>
  <para style="toc1">एस्तेरोअ पुस्तक</para>
  <para style="mt2">एस्तेरोअ पुस्तक</para>
  <para style="mt1">एस्तेरोअ पुस्तक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">एस्तेरोअ पुस्तक कोहे, के केहें कोइत फारस देसोमेहें गुलाम बोणावल्या तियां इस्राएलवालाहां एक एहेला दुस्मोनोप रोत वासाड़्ये, जो तियांहां आरवीइलोअ कदर काडतुतो. एस्तेरोअ पुस्तकोमेहें देवोअ नावोअ उल्लेख नाहां कोअयू पोन तेबी ओं खुल्लो होय, के देवे तियां आखाहा यी मोइलोअ वाटेम रोत वासाड़्ये. कोडोज नाहां जांअतो के एस्तेरोअ पुस्तक कोडो लेख्योहो. इब्री बाशाआ पद्दतीइ आधारोपोअ, थोड़ाक हुशारोअ कोअलोअ ओं होय के एस्तेरोअ पुस्तक लगभग 400 इ.स. पुर्व लेखाअयोतो.</para>
  <para style="ip">एस्तेरोअ पुस्तकोमेहें वर्णन कोअल्यी घटना देखाड़तीही के यहुदी पुरीमोअ तिवारोहो केहें कोइत मानतेहे. हामान नावोअ एके अमालेकोवाले माट्ये यहुदी माअहोंहों आरवीइलोअ योजना बोणायी. इस्राएल आन अमालेक तोयोंअ रोत दुस्मोन ओते जोयोंअ रोत इस्राएलवाले रेटावाला जागाअहें रोत ओवतेज तिया देसोमेहें पोतेते, जियाआ वायदो देवे तियांअरी कोअयोतो. <char style="xt"><ref loc="EXO 17:8-16">निर्ग 17:8-16</ref></char> तोयोंअ रोतीज जेहें हामान यहुदीही आरवीइलाअ योजना बोणावतुतो. एस्तेर जे एक यहुदी ओती, ते फारस देसोअ राणी बोणीत गोयी. तियाआ कोऱ्याआ मोर्देखायोअ सल्लावाअहीं एस्तेर हामानोअ योजनाहा रुकीत सेकतीते. यहुदी वाअहीं तियांआं दुस्मोनोपोअ जिक मिल्यी तिहींइं फासाड़ी, एस्तेर <char style="xt"><ref loc="EST 9:20-22">9:20-22</ref></char> मोर्देखाये तियांहां यी जिकेए खुसीइ तिवार कोए तेहें कोयो. एहें कोइत यहुदीवाले पुरीमोअ तिवार मानीइलोअ सुरु कोअयो.</para>
  <para style="iot">रुपरेशा</para>
  <para style="io1">1. एस्तेरोअ फारसोअ राणी बोणीइलोअ. <char style="ior"><ref loc="EST 1-2">1—2</ref></char></para>
  <para style="io1">2. हामानोअ यहुद्याहां आरवीइलोअ कदर आन तेज कदर तियापोअ आवित पोड़्यी. <char style="ior"><ref loc="EST 3-7">3—7</ref> </char></para>
  <para style="io1">3. यहुदी तियांआं दुस्मोनोहों केहें कोइत हारव्यू आन पुरीमोअ तिवारोअ सुरुवात केहें कोइत कोअयी. <char style="ior"><ref loc="EST 8-10">8—10</ref></char></para>
  <chapter number="1" style="c" sid="EST 1" />
  <para style="s">वशती राणी अश्वेरोश राजाआ गोठ ने मानत्ली</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 1:1" />राजा अश्वेरोशोअ वाडोमेर्‍यीइ गोठ होये. तो राजा भारतोम रोत ते कूश देसोअहीं जाआं आखाज एक होव ना सात्तावीस देसोपोअ राज कोअतुतो. <verse eid="EST 1:1" /><verse number="2" style="v" sid="EST 1:2" />तिया दिहोमेहें अश्वेरोश राजा राजगादीपोअ बोहीत जो शूशन नावोअ राजधानीम रोतुतो.<verse eid="EST 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 1:3" />तियाआ राजकारणोअ तिसरा वोरह्योम तिये आखा मोंत्र्योहों आन आधिकार्‍योहों पांगात आप्यी. फारस आन मादी राज्याआ सेयनिकोअ मुख्य आधिकारी आन राज्यपाल बी हजर ओता. <verse eid="EST 1:3" /><verse number="4" style="v" sid="EST 1:4" />पुरा सोव मोयना जाआं तो तियाआ राज्याआ वेयभवोअ मालधन आन तियाआ वोडी ताकतेए हाजाम हाजी वस्तू देखाड़्यी.<verse eid="EST 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 1:5" />ते दिही सेकीत गोया, तिहींइं फासाड़ी तिये राजे आखा हाना वोडाहा, जे तिहीं शूशन नावोअ राजधानीमेहें टोलू वोलीत रोयाते, तियांहां राजवाड़ाआ बोगिसामेहें हांत दिही जाआं पांगात आप्यी. <verse eid="EST 1:5" /><verse number="6" style="v" sid="EST 1:6" />तिहींइं ते पोड़दा पांडा आन निल्ला हुतोअ ओता, आन हाजा हुतोअ आन जामण्या रंगोअ खोड़ा वाअहीं सांदीइ आकड़ामेहें, मारबलोअ खांबोअरी ते पोड़दा बांद्याते; आन तिहींइं ते कोड़ीमेहें होना-सांदीइ ओती; आन लाल, पांडा, पिवला आन काल्ला मारबलोअ बोणल्यी फरशीपोअ मिकल्ये ओते. <verse eid="EST 1:6" /><verse number="7" style="v" sid="EST 1:7" />तियी पांगातीमेहें होनाआ रासोमेहें राजाआ लायकीइ बातीवानीइ दाराक्शाआ रोहो पोइत कोइत राजाआ ओलवायी वाअहीं पोटे तेतुहू पिवाड़तेते. <verse eid="EST 1:7" /><verse number="8" style="v" sid="EST 1:8" />पीइलाआ ते नियमोअ पुरमाणे रोतोतो, कोडाहा रावणी कोइत ने पिवाड़तेते, काहाके राजा राजवाड़ा मेर्‍याआ आखा वाटीणक्याहा आदेश आप्युतो, के हारेक पावणो तियाहा पोटे तेतोहो पीत सेके.<verse eid="EST 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 1:9" />वशती राणी बी अश्वेरोश राजाआ राजवाड़ामेहें बोईंहीं पांगात आप्यी.<verse eid="EST 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 1:10" />सांतवा दिही, जेहेलाम राजा दाराक्शाआ रोहो पिइलाआ धुंदेम ओतु, ताहां अश्वेरोशे महूमान, बिजता, हार्बोना, बिकता, अबगता, जेतेर आन कर्कस नावोअ हाँतू तियाआ खाजगी सिपायड़ाहा<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">सिपायड़ाहा </char><char style="ft" closed="false">बायल्या</char></note> हादे तेहें काजे तियाआ साकर्‍याहां आदेश आप्यू, <verse eid="EST 1:10" /><verse number="11" style="v" sid="EST 1:11" />के वशती राणीही राजमुकुट पोवतीज कोइत राजाआ सामने लेत आवुहूं जोवे; जिहीं वाअहीं देसो देसोअ माअहें आन आधिकार्‍योअ आगाड़ी ते तियीइ रुप देखाड़े; काहाके ते देखाइलाम जाअखी भारी ओती. <verse eid="EST 1:11" /><verse number="12" style="v" sid="EST 1:12" />पोन सेवकोवाअहीं राजाअ ओ आदेश होंबलीत कोइत वशती राणी आविइलोअ नाकार आप्यु. यी गोठी वाअहीं राजाहा जास्ती खोत लागी.<verse eid="EST 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 1:13" />ताहां राजा जाणकारोहों आन सल्लाकारोहों हादाड़ीत फुशो— राजा ते निती आन न्यायोअ आखा जाणकारोअरी एहेलोज कोअया कोअतुतो. <verse eid="EST 1:13" /><verse number="14" style="v" sid="EST 1:14" />तियाअरी कर्शना, शेतार, अदमाता, तार्शीश, मेरेस, मर्सना, आन ममूकान नावोअ फारस आन मादी मेर्‍याआ हांत आधिकारी ओता, जे राजाहा आमने-सामने मिलताते, आन राज्यामेहें मुख्य मुख्य पदोपोअ निवड़ीत मिक्याते. <verse eid="EST 1:14" /><verse number="15" style="v" sid="EST 1:15" />राजा तियांहां फुशो, “वशती राणी राजा अश्वेरोशे सेवकोवाअहीं आपल्यू आदेश नाहां मान्यी, ताहां कायदाआ पुरमाणे तियीइरी की वेवारो कोअहूं जोवे?”<verse eid="EST 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 1:16" />ताहां राजाहा आन आखा मंत्र्योअ सामने ममूकाने उत्तर आप्यो, “वशती राणी जो अपमान कोअयुहू, तो निस्तु राजाआ एतुज नाहां, पोन आखा मंत्र्योअ आन आखा देसोअ माहुंउं बी जें राजा अश्वेरोशोअ आखा प्रान्तामेहें रोतेहे. <verse eid="EST 1:16" /><verse number="17" style="v" sid="EST 1:17" />काहाके अश्वेरोश राजा वशती राणीही तियाआ सामने लेत आवीइलोअ आदेश आप्यू, पोन ते ने मान्यी, ए गोठ आखी बोईं उनाइत लेय, ताहां ते बी जिवज्योअ माट्योहो कमी समजी वोले. <verse eid="EST 1:17" /><verse number="18" style="v" sid="EST 1:18" />आज्याआ दिही फारसी आन मादीवाला देसोअ मंत्र्योअ बोईं बी राणीइ ए गोठ उनाअयीही, ते बी जिवज्योअ माट्योअरी एंहेंज कोइ वोले: एहें कोइत माट्योहो तियीं बोईं पोअ जास्ती खोत लागी वोले. <verse eid="EST 1:18" /><verse number="19" style="v" sid="EST 1:19" />जर अश्वेरोश राजाहा ए गोठ स्विकार ओय, ताहां वशती राणी राजाआ सामने फाश्यीइ जोलोम ने आवुहूं जोवे, एहेलोहो मादीइ देसोम आन फारसीइ कायदामेहें लेखाअहूं जोवे, आन ओं केदिहीं ने बोदलाअहूं जोवे, आन राणीइ पद एखी बिहीरी राणीहीं आपुहूं जोवे, जे तियीइ रोत बाहरी ओय. <verse eid="EST 1:19" /><verse number="20" style="v" sid="EST 1:20" />जेहेलाम राजाआ ओ आदेश पुरा राज्याम पुकारु ओत जाय, तेहेलाम आखी बोईं जिवज्योअ माट्योअ तियाआ मानपान कोअती रोय, तो गरीब रोय नेत मालदार रोय.”<verse eid="EST 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 1:21" />ए गोठ राजाहा आन मोंत्र्योहों गोम्यी आन राजा ममूकानोअ गोठीपोअ राजी ओवू आन तियाआ आखा राज्यामेहें, <verse eid="EST 1:21" /><verse number="22" style="v" sid="EST 1:22" />मोन्ज्ये आखा प्रांताआ आक्शरोमेहें आन आखी जातीइ बाशामेहें सिट्टी मोकल्यी, के आखा माटी जिवज्योअ कोअमेहें आधिकार सालाड़ुहूं जोवे, आन सोताआ बाशा गोग्या कोअहूं जोवे.<verse eid="EST 1:22" /></para>
  <chapter eid="EST 1" />
  <chapter number="2" style="c" sid="EST 2" />
  <para style="s">एस्तेर राणी बोणत्ली</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 2:1" />थोड़ाक दिहोअ फासाड़ी जेहेलाम अश्वेरोश राजाआ खोत उलाअयी, तेहलाम तियाहा वशती राणीइ ओर आयी, आन तियाहा ओर आवयी के वशती राणी की काम कोअयोतो, आन तियीइ विरुद्दाम कोड्लू राजआदेश परसार कोअयुतो. <verse eid="EST 2:1" /><verse number="2" style="v" sid="EST 2:2" />ताहां राजाआ सेवा कोअनारा खाजगी सेवकहों तियाहा कोयो, “राजाआ काजे देख्याम बाहरी एतीज कुवारी पोर्‍यी होदुहूं जोवे. <verse eid="EST 2:2" /><verse number="3" style="v" sid="EST 2:3" />आन राजा तियाआ राज्याआ आखा देसोम रोत एकेक आधिकारी ठरवी द्या, मोन्ज्ये ते आखी बाहरी बाहरी जुवान्यीहीं शूशन राजधानीमेहें लेत आवीत सेके, आन बोईंइ आधिकारी हेगेहे जो राजाआ सेवक ओतु, तियाहा होपी देय; आन सोकी कोइलाआ लायक वस्तु तियींहीं आपुहूं जोवे. <verse eid="EST 2:3" /><verse number="4" style="v" sid="EST 2:4" />ताहां तियींम रोत जे जुवान्यी राजाहा पसन आवे, तियीही वशती राणीइ जागापोअ उप-राणी बोणावुहूं जोवे.”</para>
  <para style="p" vid="EST 2:4">ए गोठ राजाहा गोम्यी आन तिये एहेलोज कोअयो.<verse eid="EST 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 2:5" />शूशन राजधानी मेहें मोर्देखाय नावोअ एक यहुदी रोतुतो, जो कीश नावोअ एक बिन्यामीनोअ जातीइ शिमीइ पोर्‍याआ पोर्‍यु, आन याईरोअ पोर्‍यु ओतू. <verse eid="EST 2:5" /><verse number="6" style="v" sid="EST 2:6" />जेहेलाम बाबेलोअ राजा नबुकदनेस्सर यहुदाअ राजा यकोन्याहां येरुसालेमोम रोत गुलाम बोणावीत कोइत लेत गोयुतो, ताहां मोर्देखाय बी तियांमेर्‍युउ ओतु. <verse eid="EST 2:6" /><verse number="7" style="v" sid="EST 2:7" />तिये हादस्सा नावोअ तियाआ सुलत पायहोअ पोऱ्यी, जियीही एस्तेर बी कोतेहे तियीही पोहयीते; काहाके तियीइ आयहीन आब्हू कायने ओते, आन ते पोर्‍यी बाहरी आन होबात्लीही ओती, आन जेहेलाम तियीइ आयहीन आब्हू मोइत गोये, तेहेलाम मोर्देखाय तियीही तियाआ पोर्‍यी कोत पोहयी.<verse eid="EST 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 2:8" />जेहेलाम राजाआ आदेश आन कायदा उनाड़्या, आन जाअखीलीही जुवान्यी शूशन राजधानीमेहें हेगेए आधिकारोअ निसे टोलू कोअयी, ताहां एस्तेर बी राजवाड़ामेहें बोईंइ आधिकारी हेगेए आथोम होपाअयी. <verse eid="EST 2:8" /><verse number="9" style="v" sid="EST 2:9" />ते कुवारी तियाआ नजरेमेहें हाजी देखाअयी; आन तो तियीही पालित खुस ओवू; ताहां तिये जाअखी वाआ ने लागाड़्यी, तियीही राजवाड़ाम रोत सोको कोइलाआ वस्तु, आन तियीइ रोटू, आन तियीइ काजे हांत निवड़ीइल्यी सेविकाहा बी आप्यी, एस्तेर आन तियीइ सेविकाहा रोय तेहें काजे आखाम रोत हाजु जागू आप्यू.<verse eid="EST 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 2:10" />एस्तेर तियीइ कुटूंबो आन तियीइ पारवाड़ीइ बाप्तिमेहें किज नाहां कोयो, काहाके मोर्देखाये तियीही आदेश आप्युतो, के तियाहा किज मा कोत आपीही. <verse eid="EST 2:10" /><verse number="11" style="v" sid="EST 2:11" />एस्तेरोअ की ओवे कोत तियीइ हालसाल जाईंलोअ काजे मोर्देखाय दाड़ीइज खोलीइ आगाड़ी एहें तेहें फिर्‍या कोअतुतो.<verse eid="EST 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 2:12" />जेहेलाम एकी पोर्‍यीइ पाडी आयी, के ते अश्वेरोशे राजाआ जागे जाय आन ओं तियी वेले ओवो, जेहेलाम तियीइरी बोईंइ काजे ठरवीइल्या नियमोअ पुरमाणे बारा मोयना जाआं वेवारो कोअयोतो; मोन्ज्ये तियींइं सोको ओवीइलाआ दिही एहें कोइत सेकीत गोया, के सोव मोयना जाआं हाजो गोंदाण्यो तेल, आन सोव जाआं बोईंहीं सोको कोइलाआ बिहीरो सामान बी लागाड़तेते. <verse eid="EST 2:12" /><verse number="13" style="v" sid="EST 2:13" />एहें कोइत ते कुवारी जेहेलाम राजाआ जागे जातीते, तेहेलाम जों किबी तियींहीं जोवतोय, तों तियींहीं आपाअतोतो; काहाके रोअलाअ खुलीम रोत राजवाड़ामेहें आरी लेत जात सेके. <verse eid="EST 2:13" /><verse number="14" style="v" sid="EST 2:14" />पोर्‍यी राजाआ राजवाड़ामेहें हांस्तीइ वेले जातीते आन वेगीइ तिहीं रोत निहीत कोइत बिहीरी जागे रोवाख ओती तिया कोअमेहें जाती रोतीते, ओं बिहीरो रोअलाआ कोअ राजाआ सिपाय शाशगजोअ आधिकारोम ओतो. शाशगज राजाआ लाडीइ नोवकर देखबाल कोअतुतो. जाहां पोर्‍यी राजाहा पसन आवतीते, आन राजा तियीही नाव तोइत हादतुतो, ताहां ते बिहीरी वारी तियाआ राजवाड़ामेहें जातीते. नेते उदड़ीज ने जातीते.<verse eid="EST 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 2:15" />जेहेलाम मोर्देखायोअ काकुह्हू आबीहेलोअ बेट्टीही एस्तेर, जियीही मोर्देखाये बेट्टीही मानित कोइत मिक्यीते, तियीइ राजाआ जागे जाअलाआ वेल आयीते, तेहेलाम जों किबी बोईंइ सांबालनारे राजाआ सिपाय हेगे तियीइ काजे ठरव्योतो, तिया रोत जाअखो तियी फाशोअ किज ने माग्यो. जेता जोओं एस्तेरोहो पाल्यो ते आखा खुस ओवा. <verse eid="EST 2:15" /><verse number="16" style="v" sid="EST 2:16" />ताहां एस्तेर राजवाड़ा मेहें राजा अश्वेरोशोअ जागे तियाआ राज्याआ हांतवा वोरह्योम तेबेत नावोअ दाहवा मोयनामेहें पोताड़्यी. <verse eid="EST 2:16" /><verse number="17" style="v" sid="EST 2:17" />राजा एस्तेरोहो आखी बोईंइ रोत जाअखी मेर कोअयी, आन बिहीरी आखी जुवान्यी रोत जाअखी माया आन मेरवानी तियीपोअ ओवी. तियीइ मुन्कापोअ राजमुकुट मिक्यू आन वशतीइ जागापोअ राणी बोणायी. <verse eid="EST 2:17" /><verse number="18" style="v" sid="EST 2:18" />ताहां राजा तियाआ आखा मोंत्र्योहों आन आधिकार्‍योहों एक वोडी पांगात आप्यी, आन तियाहा एस्तेरोअ पांगात कोयो; आन आखा प्रान्तामेहें कर माफ कोआड़्यू, खुल्ला मोनो वाअहीं माअहोंहों बक्शिसे आप्ये.<verse eid="EST 2:18" /></para>
  <para style="s">मोर्देखाय राजाआ जिव वासाड़त्लू</para>
  <para style="p">
    <verse number="19" style="v" sid="EST 2:19" />तिया गालाहा राजे मोर्देखायोहो राजवाड़ाआ बाअणा पोअ सारकाऱ्यी नोवकरीपोअ नेम्युतो. <verse eid="EST 2:19" /><verse number="20" style="v" sid="EST 2:20" />एस्तेर सोताआ माअहोंअ आन कुटूंबाआ गोठ ने कोयीते, काहाके मोर्देखाये तियीही ने कोअला आदेश आप्युतो; आन एस्तेर मोर्देखायोअ गोठ जेहें कोइत तियाआ जागे तियीइ पालन पोशण कोइला वेले मानतीते तेहेंज कोइत मान्यी.<verse eid="EST 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 2:21" />तियां दिहोमेहें मोर्देखाय राजाआ राजवाड़ाआ बाओपोअ बोहीत रोतुतो, ताहां राजाआ सिपाय बी बाओपोअ देखरेख बी कोअताते, तियांमेहें बिकतान आन तेरेश नावोअ बेन जोओं राजा अश्वेरोशोअरी खोताइत कोइत माइलोअ काजे हेंहींत बोठाते. <verse eid="EST 2:21" /><verse number="22" style="v" sid="EST 2:22" />ए गोठ मोर्देखायोहो मुंदू पोड़्यू, आन तिये ए गोठ एस्तेर राणीहीं कोयी, आन एस्तेर राणी मोर्देखायोअ नाव लेत कोइत राजाहा सेतावणी आप्यी. <verse eid="EST 2:22" /><verse number="23" style="v" sid="EST 2:23" />तापास काड्यू ताहां ते गोठ खोरी निहींयी आन तियां बेनुहूं साड़ोअ उसे टांगी देदा, आन ए गोठ राजाआ सामने इतिहासोअ पुस्तकोमेहें लेखाअयी.<verse eid="EST 2:23" /></para>
  <chapter eid="EST 2" />
  <chapter number="3" style="c" sid="EST 3" />
  <para style="s">यहुदीही माइलोअ कदर</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 3:1" />यी गोठीइ फासाड़ी अश्वेरोश राजे अगागोअ कुटूंबाआ हम्मदाताआ पोर्‍यु हामानोहो उसा पदोपोअ नेमी देदू. <verse eid="EST 3:1" /><verse number="2" style="v" sid="EST 3:2" />राजवाड़ाआ बाओपोअ रोनारा राजाआ आखा सेवक हामानोहो नमस्कार कोअताते, काहाके राजा तियाआ बाप्तिम तेहेलुज आदेश आप्युतो; पोन मोर्देखाय नमस्कार ने कोअतुतो आन पागे बी ने पोड़तुतो. <verse eid="EST 3:2" /><verse number="3" style="v" sid="EST 3:3" />ताहां राजाआ सेवक जे राजवाड़ाआ बाओपोअ रोताते, तियां मोर्देखायोहो फुशो, “तु राजाआ आदेश काहा नाहां मानतु?” <verse eid="EST 3:3" /><verse number="4" style="v" sid="EST 3:4" />ते तियाहा दाड़ीइज एहेंज कोता रोया, पोन तो तियांआं ने होंबल्यू, ताहां मोर्देखायोअ ए गोठ हामानोहो साले के ने कोत पालीइलोअ विसारो वाअहीं तियां हामानोहो कोत देदो; काहाके तिये तियांहां आंय यहुदी होय एहें कोत देदोतो. <verse eid="EST 3:4" /><verse number="5" style="v" sid="EST 3:5" />मोर्देखाय तियाहा टुंगू पोड़ीत पागे नाहां पोड़तू एहलोहो हामाने पाल्यो, ताहां तियाहा जाअखीलिही खोत लागी. <verse eid="EST 3:5" /><verse number="6" style="v" sid="EST 3:6" />तिये निस्त मोर्देखायोपोअ एतोज आथ टाकीइलोअ ठिक ने समज्यो. काहाके मोर्देखाय काअली जातीइ होय तों तियां हामानोहो कोत देदोतो; तिहीं वाअहीं हामाने अश्वेरोशोअ राज्याम रोनारा आखा मोर्देखायोअ माअहुंहूं आन आखा यहुदीही आरवीत टाकीइलोअ कदर काड्यी.<verse eid="EST 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 3:7" />राजा अश्वेरोशोअ बारावा वोरहोअ निसान नावोअ पेहला मोयनाम रोत तियां हामानोअ सामने सिट्टी<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="fq" closed="false">सिट्टी </char><char style="ft" closed="false">“पुर” एहें कोतेते</char></note> टाकुहूं लागाड़्यी. एहें कोइलोअ तियां मोयना डिठ अदार नावोअ बारावू मोयनू सेलाय ताअहूं जाआं सालुज मिक्यो.<verse eid="EST 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 3:8" />ताहां हामाने राजा अश्वेरोशोहो कोयो, “ताआ राज्याआ आखा प्रान्तामेहें रोनारे देसो देसोअ माअहोंअ विसमेहें वेरासेर ओत कोइत रोनारे एकी जातीइ माअहें होय, तियांआं कायदा बाकी माअहोंअ कायदा रोत जुदाज होय; आन तें राजाआ कायदाआ पुरमाणे नाहां सालते, तियाहा कोत तियांहां रोअहूं देअलो राजाआ कोअते फायदाआ कायनाहा. <verse eid="EST 3:8" /><verse number="9" style="v" sid="EST 3:9" />जर राजाआ मोर्जी ओय ताहां तियांहां आरवीइलोअ आदेश काडुहूं जोवे, आन आंय राजभांडारोम दोह हाजार किक्कार सांदी राजाआ कारभार्‍योअ आथोम आपीहीं.”<verse eid="EST 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 3:10" />ताहां राजा तियाआ मुंदी तियाआ आथोम रोत काडीत कोइत, अगागी हम्मदाताआ पोर्‍यु हामानोहो, जो यहुदीइ दुस्मोन ओतु तियाहा आपी देदी; <verse eid="EST 3:10" /><verse number="11" style="v" sid="EST 3:11" />आन राजा हामानोहो कोयो, “सांदी ताहूं आप्यीही, एं माअहें बी ताआ आथोम होय, तियांअरी ताहूं पोटे तेहें कोअ.”<verse eid="EST 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 3:12" />तिया पेहला मोयनाआ तेरावा दिहोहो राजाआ लेखार्‍या हाद्या, आन हामानोअ आदेशोअ पुरमाणे राजाआ आखा कारभारी, आन आखा प्रान्ताआ मुख्यू, आन देसो देसोअ माअहोंअ मोंत्र्योंअ कोअते सिट्टी एकेकाआ राज्याआ बाशामेहें, आन एकेक देसोअ माअहोंअ बाशामेहें राजा अश्वेरोशोअ नावो वाअहीं लेखाअयी; आन तियामेहें राजाआ मुंदीइ सिक्कु लागाड़्यु. <verse eid="EST 3:12" /><verse number="13" style="v" sid="EST 3:13" />राज्याआ आखा प्रान्तामेहें तिरवाश्या वाअहीं सिट्टी मोकल्यी एकेज दिही मोन्जे अदार नावोअ बारावा मोयनाआ तेरावे दिही जुवान, डाया, बोईंन पोर्‍ये एहला आखा यहुदी माहुंहूं माइत टाकुहूं जोवे, आरवुहूं जोवे आन तियांआं मालधन लुटीत लेअहूं जोवे. <verse eid="EST 3:13" /><verse number="14" style="v" sid="EST 3:14" />तिया आदेशोअ लेखल्या पत्राआ नकल आखा प्रान्तामेहें कायदु कोत आप्यी, आखा देसोअ माअहें तेदिहीं काजे तियार रोअहूं जोवे.<verse eid="EST 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 3:15" />तिया आदेशपत्राआ एकेक नकल शूशन राजधानीम आप्यी, आन तिरवाश्या राजाआ आदेशो वाअहीं ताबुड़ निहींत गोया. राजा आन हामान पिअहूं बोहीत गोया; पोन शूशन होयरोमेहें बिक पसरीत गोयी.<verse eid="EST 3:15" /></para>
  <chapter eid="EST 3" />
  <chapter number="4" style="c" sid="EST 4" />
  <para style="s">मोर्देखाय एस्तेरेपोअ मदत मागत्लू</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 4:1" />जेहेलाम मोर्देखायोहो मुंदू पोड़्यु, ताहां तिये सोताआ आंगड़े फाड़्ये, पेंडीइ पोतो फांगीत मुन्कापोअ खाआं टाक्यून ताहरुउ होयरोअ विसमेहें जात कोइत वोडी हादेज रेकू वोल्यू; <verse eid="EST 4:1" /><verse number="2" style="v" sid="EST 4:2" />आन तो राजवाड़ाम बाओ जागे पोत्यु, पोन पोते फांगीत राजवाड़ाआ बाअणाआ मायते जाअलोअ कोडाहाज परवानगी ने ओती. <verse eid="EST 4:2" /><verse number="3" style="v" sid="EST 4:3" />एकेका प्रान्तामेहें, जिहीं जिहीं राजाआ आदेश आन नियम पोत्या, तिहीं तिहीं यहुदी पोता फांगीत आन उपास कोइत आन रोड़े वोल्ये; आन वारुज जोएं पोते फांगीत खाओंम बोहीत रोये.<verse eid="EST 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 4:4" />एस्तेर राणीइ सेविका आन सेवक<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="fq" closed="false">सेवक </char><char style="ft" closed="false">बायल्ये</char></note> तियीइ जागे आवित तियीही कोत देदो, ताहां राणी जास्ती नाराज ओवी; तियी मोर्देखायोअ काजे पोते काडीत आंगड़े पोवे तेहें काजे लेत मोकल्ये, तियांहां तिये ने तोअये. <verse eid="EST 4:4" /><verse number="5" style="v" sid="EST 4:5" />ताहां एस्तेर राजाआ सेवकोमेहें रोत हताकोहो जियाहा राजा तियाआ जागे रोअलाअ कोत ठरव्युतो, तियाहा हादाड़ीत कोइत कोत मोकल्यो के, ए गोठ केहें काय होय आन काहा काजे तों मोर्देखायोअ सोवकिशी कोइत सेके. <verse eid="EST 4:5" /><verse number="6" style="v" sid="EST 4:6" />ताहां हताक राजवाड़ाआ तिया बाओअ सामने होयरोअ जागे सोवकड़ीपोअ मोर्देखायोअ जागे गोयु. <verse eid="EST 4:6" /><verse number="7" style="v" sid="EST 4:7" />मोर्देखाये तियाअरी कि कि ओवो तों तियाहा आखो कोत आपी देदो, आन हामाने यहुदी माअहोंहों आरवीइलोअ परवानगी जोड़े तेहें काजे राजवाड़ामेहें केताहा पोशा आप्याहा तों बी आखो बोराबर कोत देदो. <verse eid="EST 4:7" /><verse number="8" style="v" sid="EST 4:8" />फाशोअ यहुदी माअहोंहों आरवीइलाअ जो आदेश शूशन होयरोमेहें आप्युतो, तियाआ एक नकल बी तिये हताकोअ आथे, एस्तेरोहो देखाड़े तेहें आप्यी, आन ए आखी गोठ ते मायते राजाआ जागे जात कोइत तियीइ माअहोंअ कोअता रावणी आन विनंती कोए तेहें वारुहूं कोत मोकल्यो. <verse eid="EST 4:8" /><verse number="9" style="v" sid="EST 4:9" />ताहां हताक एस्तेरोअ जागे जात कोइत मोर्देखायोअ ए गोठ कोत आपी देदी. <verse eid="EST 4:9" /><verse number="10" style="v" sid="EST 4:10" />ताहां एस्तेरे मोर्देखायोअ जागे हताकोहो एहें कोत मोकल्यो के, <verse eid="EST 4:10" /><verse number="11" style="v" sid="EST 4:11" />“राजाआ आखा आधिकार्‍योहों, आन राजाआ आखा प्रांताआ माअहोंहों बी मुंदू होय, एखु माटी नेत बोईं बिगर हाद्येज राजाआ मायतेए खोलीइ गोयो तियाहा माईंत टाकीइलोअ आदेश होय; जर राजा होनाआ राजडांडू जियाआ वोल आगाड़ी कोए तोंज वासाय, पोन माहूं तोम आज कोइत तिस दिही ओत गोया राजाआ जागे नाहां हाद्यी जी.”<verse eid="EST 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 4:12" />एस्तेरोअ ए गोठ मोर्देखायोहो कोत देखाड़्यी. <verse eid="EST 4:12" /><verse number="13" style="v" sid="EST 4:13" />ताहां मोर्देखाय एस्तेरोअ जागे ओं कोत मोकल्यो, “तु मोनोमेहें ओ विसार मा कोअहीं, के आंय राजवाड़ामेहें रोहो कोत आखा यहुदीमेहें रोत वासात जाहीं. <verse eid="EST 4:13" /><verse number="14" style="v" sid="EST 4:14" />काहाके तु जर यी वेले तु ठावकी रोही, ताहां केहेंन केहें कोइत यहुदी माअहें वासात जाय, पोन तु आन ताआ आब्हाआ घराणो आरवात जाय. केहें नेत ताहूं यी वेलेए काजेज ताआ राणी कोत निवड़ ओवी ओय?”<verse eid="EST 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 4:15" />ताहां एस्तेर मोर्देखायोअ जागे ओं कोत मोकल्यो, <verse eid="EST 4:15" /><verse number="16" style="v" sid="EST 4:16" />“तु जात कोइत शूशनोअ आखा यहुदीही टोलु वाल, आन तुमू आखे मिलित कोइत माआ कोअते उपास कोआ, तिन दिहीन तिन रात किज मा खाहान किज मा पिहा. आंय बी माआ सेविकाअरी एहेंज कोइत उपास तोअहीं; आन एहेलीज दशामेहें आंय नियमोअ विरुद्द राजाआ जागे मायते जाहीं; जर माए ताहरोअ माए.”<verse eid="EST 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EST 4:17" />ताहां मोर्देखाय जातु रोयू आन एस्तेरोअ आदेशोअ पुरमाणे तिये कोअयो.<verse eid="EST 4:17" /></para>
  <chapter eid="EST 4" />
  <chapter number="5" style="c" sid="EST 5" />
  <para style="s">एस्तेर राजाहान हामानोहो पावणा तोअत्ली</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 5:1" />तिसरे दिही एस्तेर तियीइ राजआंगड़े पोवीत कोइत राजमोंदिरोअ मायते जात कोइत, राजमोंदिरोअ आगाड़ी उबी रोयी; राजा राजमोंदिरोमेहें राजगादीपोअ राजवाड़ाआ बाओअ सामने बोठुतो; <verse eid="EST 5:1" /><verse number="2" style="v" sid="EST 5:2" />आन जेहेलाम राजा एस्तेर राणीही खोलीमेहें उबी रोल्यी देख्यी, ताहां तिये तियीपोअ मेरवानी देखाड़्यी आन तिये तियाआ आथोमेऱ्युउ होनाआ राजडांडू तियीइ वोल आगू कोअयू. ताहां एस्तेरे आहने जागे जात कोइत राजडांडाआ सेंडीही आथ लागाड़्यू. <verse eid="EST 5:2" /><verse number="3" style="v" sid="EST 5:3" />ताहां राजा तियीही फुशो, “ए एस्तेर राणी, ताहूं कि जोवे? तु कि मागेहे? माग आंय ताहूं आरदो राज्यो जाआं आपिहीं.”<verse eid="EST 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 5:4" />एस्तेर कोयो, “जर राजा सायबोअ मोर्जी ओय, ताहां राजाआ पावणायीइ काजे आज मी जो रोटू तियार कोअयुहू तिहीं हामानोहो आरी लेत कोइत आवुहूं जोवे.”<verse eid="EST 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 5:5" />ताहां राजा ताबुड़ आदेश मोकलीत हामानोहो मामार हादाड़्यू, काहाके एस्तेरोअ कोल्याआ पुरमाणे पावणायीमेहें जात सेकाय. ताहराआ राजा आन हामान एस्तेर तियार कोअल्या रोटाआ पावणायीमेहें गोया. <verse eid="EST 5:5" /><verse number="6" style="v" sid="EST 5:6" />रोटू खाअलोअ वेले दाराक्शाआ रोहो पितामेहें राजा एस्तेरोहो फुशो, “ताआ कि इश्शा होय? ते मान्य ओत जाय. तु कि मागेहे? माग, आरदो राज जाआं ताहूं जोड़ीत जाय.”<verse eid="EST 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 5:7" />एस्तेर उत्तर आप्यो, “माआ विनंती आन मागणी ए होय: <verse eid="EST 5:7" /><verse number="8" style="v" sid="EST 5:8" />जर राजाआ मेरवानी मापोअ ओय आन माआ रावणी मान्य कोए एहलोहो राजाहा लागो ताहां आंय पावणे तोअहीं, तेहलाम राजा आन हामान हांदाआ पावणायीमेहें आवुहूं जोवे, तेहलाम आंय राजा साहीब कोयोहो तेहें कोइत माआ कि मागीइलो होय तों मागीहीं.”<verse eid="EST 5:8" /></para>
  <para style="s">मोर्देखायोहो माइलोअ कदर</para>
  <para style="p">
    <verse number="9" style="v" sid="EST 5:9" />तेदिहीं हामान खुस आन खुसी मोनेज बाअथे निहींयू, पोन जेहेलाम राजवाड़ाआ बाओपोअ मोर्देखाय तियाहा देखीत वाहीं उठ्यू ने के बियू ने, तों देखीत तिया हामानोहों जास्ती खोत लागी. <verse eid="EST 5:9" /><verse number="10" style="v" sid="EST 5:10" />ताहां हामान तियाआ खोतेहे आवरीत कोइत तियाआ कोअ गोयु; आन तियाआ दोस्ती आन तियाआ लाडी जेरेशोहो हादे मोकल्ये. <verse eid="EST 5:10" /><verse number="11" style="v" sid="EST 5:11" />ताहां हामान तियांआं आगाड़ी तियाआ मालधन आन तियाआ पोर्‍याआ पोर्‍ये वाद्येहे आन राजा तियाहा केहें कोइत बिहीरा आखा मंत्र्यो आन आखा आधिकार्‍यों रोत उसेए जागू आप्युहू, तों आखो कोत आप्यो. <verse eid="EST 5:11" /><verse number="12" style="v" sid="EST 5:12" />हामाने ओं बी कोयो, “एस्तेर राणी बी माहूं सोड़ीत बिहीरा कोडाहा राजाअरी, पांगातीमेहें नाहां हादती; आन हांदाआ राजाअरी तियी माहूं नेवतो आप्योहो. <verse eid="EST 5:12" /><verse number="13" style="v" sid="EST 5:13" />एतो आखो होय तेबी जाअहूं जाआं तो राजवाड़ाआ बाओपोअ बोहीत रोनारु यहुदी मोर्देखाय माहूं देखाय, ताअहूं जाआं ओं आखो माहूं फालतू हासवाअहे.”<verse eid="EST 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 5:14" />तियाआ लाडी जेरेश आन तियाआ आखा दोस्ती तियाहा कोयो, “पोन्नास आथोअ<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="fq" closed="false">पोन्नास आथोअ </char><char style="ft" closed="false">विही मिटर</char></note> उसू खांब कोअहूं जोवे आन हांदाआ वेगीइ राजाहा कोजी के, तिया मोर्देखायोहो तिया खांबोपोअ टांगी द्या; आन खुसी खुसी राजाअरी पावणायीमेहें जाजी.” ए गोठ हामानोहो पोटीत गोयी आन तिये तेहेलुज एक फासीइ काजे खांब तियार कोआड़ीत लेदू.<verse eid="EST 5:14" /></para>
  <chapter eid="EST 5" />
  <chapter number="6" style="c" sid="EST 6" />
  <para style="s">राजा मोर्देखायोअ मानपान कोअत्लू</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 6:1" />तियी राती अश्वेरोश राजाहा निंद ने आयी, तियाहा कोत तियाआ आदेशोअ पुरमाणे इतिहासोअ पुस्तक लेत आवित कोइत राजाहा वासीत देखाड़्यो. <verse eid="EST 6:1" /><verse number="2" style="v" sid="EST 6:2" />तिहींमेहें ओ माग लेखल्यू जोड़्यू, के अश्वेरोश राजाआ राजवाड़ाआ बाओपोअ देखबाल कोअनारा सिपायड़ा ओता, तियांमेर्‍याआ बिकतान आन तेरेश नावोअ बेन जोआं तियाहा माईंत टाकीइलोअ कदर कोअयीते, पोन मोर्देखाये तियीही खोबर कोई देदीते. <verse eid="EST 6:2" /><verse number="3" style="v" sid="EST 6:3" />ताहां राजे फुशो के, “याआ बाप्तिम मोर्देखायोअ वाजिहीं मानपान के इलाम आपल्यू के नाहां?”</para>
  <para style="p" vid="EST 6:3">राजाअ सेवक जे तियाआ सेवा कोअनारा ओता, तियां कोयो, “तियाआ कोअते किज नाहां कोअयो.”<verse eid="EST 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 6:4" />राजे फुशो, “खोलीम कोडो होय?” तियीज वेले हामान राजाआ राजवाड़ाआ बाअथे खोलीमेहें तिये मोर्देखायोअ काजे जो खांब तियार कोआड़्युतो तियापोअ तियाहा टांगी देअलोअ गोठ राजाअरी कोअहीं, या विसारो वाअहीं तो आयुतो. <verse eid="EST 6:4" /><verse number="5" style="v" sid="EST 6:5" />ताहां राजाआ सेवके राजाहा कोयो, “खोलीमेहें ते हामान उबु होय.”</para>
  <para style="p" vid="EST 6:5">राजा कोयो, “तियाहा मायते हादीत लेत आवा.”<verse eid="EST 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 6:6" />जेहेलाम हामान मायते आयु, ताहां राजा तियाहा फुशो, “जिया माअहोंअ वोडाय राजा कोअहूं जोवे, तियाहा तियाअरी कि कोए ताहां हाजो रोय?” हामाने ओ विसार कोअयू, के मारोत जाअखु राजा कोडाआ वोडाय कोइत सेकेहे.<verse eid="EST 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 6:7" />हामाने राजाहा उत्तर आप्यो, “जिया माअहोंअ काजे राजा मानपान कोअहूं जोवे, <verse eid="EST 6:7" /><verse number="8" style="v" sid="EST 6:8" />तियाआ कोअते जें राजा पोवतुय तें आंगड़े लेतावा आन जियापोअ राजा बोहेहे तो एक कोड़ू बी लेतावा, आन तियाआ मुन्कापोअ जो राजमुकुट रोहे तो बी लेतावा. <verse eid="EST 6:8" /><verse number="9" style="v" sid="EST 6:9" />फाशेए ते आंगड़े, आन तो कोड़ू राजा एखा वोडा अधिकाऱ्योअ आथोम आपीत राजा जियाआ मानपान कोअहूं होदे तियाहा तो आंगड़ो पोवाड़े, आन तियाहा कोड़ापोअ बोहाड़ीत कोइत होयरोअ सोवकड़ीइहें फिरावुहूं जोवे; आन तियाआ आगाड़ी ओ परसार कोअहूं जोवे, जियाआ मानपान राजा कोअहूं होदे, तियाअरी एहलोहोज ओवे.”<verse eid="EST 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 6:10" />राजा हामानोहो कोयो, “जेहें कोइत तुमे कोयो तियाआ पुरमाणे, तें आंगड़े आन ते कोड़ा लेत कोइत, तिया राजवाडाआ बाओपोअ बोहीत रोनारा यहुदी मोर्देखायोअरी तेहेंज कोअ, तुमे कोयीही ए एक बी गोठ ने सुकुहूं जोवे.”<verse eid="EST 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 6:11" />ताहां हामान तें आंगड़े, तियां कोड़ाहा लेत कोइत, मोर्देखायोहो पोवाड़्ये, आन तियाहा कोड़ापोअ बोहाड़ीत होयरोअ वाटे वाटे पुकारु कोअतु फिरव्यो, “जियाआ वोडाय राजा कोअहूं होदे तियाअरी एहलोहोज ओवे.”<verse eid="EST 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 6:12" />ताहां मोर्देखाय ते राजवाड़ाआ बाओअ जागे जातु रोयु, पोन हामान नाराज ओत कोइत आन मुन्को टापित ताबुड़तुड़ तियाआ कोअ जातु रोयु. <verse eid="EST 6:12" /><verse number="13" style="v" sid="EST 6:13" />हामाने तियाआ लाडी आन तियाआ दोस्त्योहों तियाअरी जों ओवो तों आखो बादो उखरीत कोत आप्यो, ताहां तियाआ हुशार दोस्ती आन तियाआ लाडी जेरेश तियाहा कोयो, “मोर्देखाय जियाहा तु निसो देखाड़ीलोअ कोअहे, पोन जर तो यहुदी पारवाड़ीमेर्‍युउ ओय, ताहां तु तियाहा नाहां जिकीत सेकतू, तियाआ आगाड़ी तु नक्की हारवाअनारु होय.”<verse eid="EST 6:13" /></para>
  <para style="s">हामोनोअ मोत</para>
  <para style="p">
    <verse number="14" style="v" sid="EST 6:14" />ते तियाअरी गोठीज कोअते ते राजाआ सेवक आवित कोइत हामानोहो एस्तेरे तोअल्यी पावणायीम हादीत लेत गोया.<verse eid="EST 6:14" /></para>
  <chapter eid="EST 6" />
  <chapter number="7" style="c" sid="EST 7" />
  <para style="m">हामानोहो मोतोअ डोंड <verse number="1" style="v" sid="EST 7:1" />ताहां राजा आन हामान एस्तेर राणीइ पावणायीमेहें आया. <verse eid="EST 7:1" /><verse number="2" style="v" sid="EST 7:2" />राजा बिहीरे दिही होरु पिता-पितामेहें एस्तेरोहो फाशोअ फुशो, “ए एस्तेर राणी! ताआ कि मागणी होय? तो पुरो कोइलाम आवे. तु कि मागेहे? माग, आरदो राज्य जाआं ताहूं आपिहीं.”<verse eid="EST 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 7:3" />एस्तेर राणी कोयो, “राजा साहीब! जर तु मापोअ खुस ओय, आन ताआ मोर्जी ओय, ताहां माआ नम्र विनंती स्विकार कोअहूं जोवे, आन माआ माअहोंहों जिवदान आपुहूं जोवे ए माआ मागणी होय. <verse eid="EST 7:3" /><verse number="4" style="v" sid="EST 7:4" />काहाके माहूं आन माआ माअहोंहों माइत आरवीइलोअ काजे वेसी देदेहे; जर आमू गुलाम कोत वेसाअते तेबी आंय ठावकी रोती; तेबी तियी दशामेहें तिया दुस्मोनोहों राजाआ नुकसानोअ भरपाइ ने कोअता आवती.”<verse eid="EST 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 7:5" />ताहां राजा अश्वेरोशे एस्तेर राणीहीं फुशो, “एहलोहो कोइलोअ हिम्मत कोअनारु कोडू होय आन तो का होय?”<verse eid="EST 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 7:6" />एस्तेर कोयो, “तो विरोधी आन दुस्मोन ओ हामानुज होय!”</para>
  <para style="p" vid="EST 7:6">ताहां ए गोठ उनात कोइत हामान राजा-राणीइ सामने बित गोयु. <verse eid="EST 7:6" /><verse number="7" style="v" sid="EST 7:7" />राजा खोतेए बाल्लायी रोटू खातुखातुज राजवाड़ाआ बोगिसामेहें जातु रोयु; ताहां हामाने ओं पालीत लेदो के, राजा ओमे माहूं माइलाआ विसार कोइत लेदुहू, तियाहा काजे तो एस्तेर राणीइ सामने जात जिवदान मागू वोल्यू. <verse eid="EST 7:7" /><verse number="8" style="v" sid="EST 7:8" />ताहरुउ राजा राजवाड़ाआ बोगिसाम रोत वापिस खाअला-पीइलाआ जागे आयु, ताहां तिये हामानोहो एस्तेरोअ सामने सोवकड़ीपोअ आड्लात रोल्यू देख्यू, ताहां राजा बावराअयू, “तु या कोअमेहें आन माआ सामनेज राणीही उदाबादीज आथे तोअहूं होदेहे के?”</para>
  <para style="p" vid="EST 7:8">राजा एहें कोताज वाआ सेवक मायते आया आन हामानोअ सोब टापी देदी. <verse eid="EST 7:8" /><verse number="9" style="v" sid="EST 7:9" />ताहां राजाआ आगाड़ी हजर रोनारा सेवकोमेहें रोत हार्बोना नावोअ एके जोएं राजाहा कोयो, “जिये राजाआ जिव वासाड़्यू तिया मोर्देखायोअ कोअते हामाने पोन्नास आथ उसु फासीइ खांब उबु कोअयुहू.”</para>
  <para style="p" vid="EST 7:9">राजा कोयो, “तियाहा हिद्लाआ खांबोपोअ टांगी द्या.”<verse eid="EST 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 7:10" />ताहां जो खांब तिये मोर्देखायोअ कोअते तियार कोअयुतो तिया हिद्लाआ खांबोपोअ हामानोहों फासी आपी देदी. ताहां राजाआ खोत उलाअयी.<verse eid="EST 7:10" /></para>
  <chapter eid="EST 7" />
  <chapter number="8" style="c" sid="EST 8" />
  <para style="s">यहुदीही सोताआ जिव वासाड़ीइलोअ आधिकार जोड़ीत गोयू</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 8:1" />तेदिहींज राजा अश्वेरोशे यहुदीइ विरोदी हामानोअ कोअबाआ एस्तेर राणीहीं आपी देदो. मोर्देखाय राजाहा सामने आयु, काहाके तियाअरी एस्तेरोअ कि नातो होय तों तियी राजाहा कोयोतो. <verse eid="EST 8:1" /><verse number="2" style="v" sid="EST 8:2" />ताहां राजा तियाआ ते मुंदी जे तिये हामानोपोअ रोत मागित लेदीते. ते काडीत कोइत मोर्देखायोहो आपी देदी. एस्तेर मोर्देखायोहो हामानोअ कोओपोअ आधिकारी कोत नेमी देदू.<verse eid="EST 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 8:3" />फाशीइ एस्तेर दुसरा वारी राजाअरी गोग्यी; आन तियाआ पागे पोडीत कोइत, रोडी रोडीइ तियाहा विनंती कोअयी के अगागोअ पारवाड़ी हामाने कोअल्यी यहुद्याहां आरवीइलोअ खाराब योजना राजा रद्द ओवुहूं जोवे. <verse eid="EST 8:3" /><verse number="4" style="v" sid="EST 8:4" />ताहां राजा एस्तेरोअ वोल होनाआ राजडांडू कोअयू. तेहेलाम एस्तेर उठीत कोइत राजाआ हुंबर उबी रोयी; <verse eid="EST 8:4" /><verse number="5" style="v" sid="EST 8:5" />आन कोनी वोल्यी, “जर राजाहा स्विकार ओय आन तियाआ मेरवानी मापोअ ओय आन ए गोठ तियाहा ठिक हासवाय, आन आंय बी तियाहा पसन आवती ओय, ताहां जे सिट्टी हम्मदाता अगागोअ पोर्‍यु हामाने राजाआ आखा प्रांताआ यहुदीही आरवीइलोअ कदर कोइत लेखाड़्यीते, तियांहां रद्द कोइला काजे लेख्याम आवे. <verse eid="EST 8:5" /><verse number="6" style="v" sid="EST 8:6" />काहाके आंय माआ माअहोंपोअ आवनारी ओड़सनीही केहें कोइत पालीत सेकिहीं? माआ कुटूंबो आरवाअत्लो आंय केहें कोइत देखीत सेकिहीं?”<verse eid="EST 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 8:7" />ताहां राजा अश्वेरोशे एस्तेर राणीहीं आन मोर्देखाय यहुदीही कोयो, “हामाने यहुद्यांपोअ आथ उठाड़्यु कोत आंय तियाआ कोअ एस्तेरोहो आपी देदो, आन तियाहा फासीपोअ टांगी देदू. <verse eid="EST 8:7" /><verse number="8" style="v" sid="EST 8:8" />ओमे तुमुहूं पोटे तेहें कोइत यहुद्याआं बाप्तिम राजाआ नावसे लेखा; तियी सिट्टीपोअ राजाआ मुंदीइ साप बी लागाड़ा; काहाके जे सिट्टी राजाआ नावसे लेखाअली सिट्टी आन तिहींपोऱ्युउ तियाआ मुंदीइ साप कोडाहाज रद्द कोअता ने आवे.”<verse eid="EST 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 8:9" />तियी गालाहा सिवान नावोअ तिसरा मोयनाआ तेविसवा दिहोम राजाआ लेखार्‍याहां हादाड़्या आन जियी मोर्देखाय जेहें कोइत कोय तेहें कोइत इस्राएलवालाहां आन आधिकाऱ्योहों आन भारतोहो लागाड़ीत ते कूश<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="fq" closed="false">कूश </char><char style="ft" closed="false">इथीओपिया</char></note> देसोअ जागे जाआं, आखाज एक होव सात्तावीस प्रान्ताआ आधिकारी आन सिपायड़ाहां जियांतियांआं प्रांताआ अक्शरोमेहें आन जियांतियांआं देसोअ बाशामेहें आन यहुदीही तियांआं आक्शरोमेहें आन बाशामेहें लेख्यो लेत मोकल्यो. <verse eid="EST 8:9" /><verse number="10" style="v" sid="EST 8:10" />मोर्देखाये राजा अश्वेरोशोअ नाव से सिट्टी लेखाड़ीत कोइत तियापोअ राजाआ मुंदीइ साप लागाड़ीत कोइत, जोरे गुगदीइनारा सारकाऱ्या कोड़ापोअ बातमी वेरनाराआ आथोम लेत मोकली देदी.<verse eid="EST 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 8:11" />तियी सिट्टीमेहें राजाआ तरफ से आखा होयरोअ यहुद्याहां एहें कोइत परवानगी जोड़्यीते के तें सोताआ जिव वासाड़ीइलोअ काजे सोताहाज उबे रोअहूं जोवे आन जिया जियाआ प्रांताआ माअहें उदाबादीज तुमुहूं तुमाआ बोईं-पोऱ्याहां तारास देने आवे तियांहां माइत आरवीत टाकीइलोअ आन तियांआं मालधन लुटीत लेअलो. <verse eid="EST 8:11" /><verse number="12" style="v" sid="EST 8:12" />ओं आखो अदार नावोअ बारावा मोयनाआ तेरावे दिही राजा अश्वेरोशोअ आखा प्रान्तामेहें एकेज दिही कोअहूं जोवे. <verse eid="EST 8:12" /><verse number="13" style="v" sid="EST 8:13" />यां आदेशपत्राआ नकल आखा प्रान्तामेहें, आखा देसोअ माअहोंअ जागे मोकली देजा; तेदिहीं आखे यहुदी तियांआं दुस्मोनोअरी बोदलू लेअलोअ काजे तियारीम रोअहूं जोवे. <verse eid="EST 8:13" /><verse number="14" style="v" sid="EST 8:14" />बातमी पोताड़नारा जोरे गुगदीइनारा कोड़ापोअ बोहीत कोइत राजाआ आदेशो वाअहीं वेगा जाता रोअहूं जोवे; शूशन राजधानीमेहें रोत ओ आदेश सोड़्यू.<verse eid="EST 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 8:15" />ताहां मोर्देखाय निला आन पांडा रंगोअ हाजा हुतोअ आंगड़े पोवीत आन मुन्कापोअ होनाआ वोडू टोपू मिकीत आन जामण्या रंगोअ आंगड़ो पोवीत राजाआ आगाड़ी निहीयु, आन शूशन होयरोमेर्‍येए माअहें खुसीइ तिवारोअ पुकारु कोअयू. <verse eid="EST 8:15" /><verse number="16" style="v" sid="EST 8:16" />ताहां यहुद्याहां खुसी ओवी, हाजो लागो आन तियांहां वोडू मानपान जोड़्यू. <verse eid="EST 8:16" /><verse number="17" style="v" sid="EST 8:17" />आन जिया जिया प्रान्तामेहें आन जिया जिया होयरोमेहें, जिहीं काबी राजाआ आदेश पोतू तिहींइं यहुद्याहां जास्ती खुसी ओवी आन तेदिहीं पांगाती मिकीत कोइत तिवार कोअयू. आन तिया देसोमेर्‍येए वारुज माअहें यहुदी बोणित गोये, काहाके तियांहां यहुद्या माअहोंअ जास्ती बिक लागी.<verse eid="EST 8:17" /></para>
  <chapter eid="EST 8" />
  <chapter number="9" style="c" sid="EST 9" />
  <para style="s">यहुदी तियांआं दुस्मोनोहों आरवीइत्ले</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 9:1" />अदार नावोअ बारावा मोयनाआ तेरावे दिही, जेदिहीं राजाआ आदेश आन पुकारु ओविइलोअ ओतो आन यहुदी माअहोंहों दाबनारे एहलुहू आहरुज ओतू; पोन आखो उलटोज ओवो, यहुदी तियांआं दुस्मोनोहों दाबीत टाक्या; <verse eid="EST 9:1" /><verse number="2" style="v" sid="EST 9:2" />तेदिहीं यहुदी माअहें राजा अश्वेरोशोअ आखा प्रान्तामेहें तियां तियांआं होयरोमेहें तियांआं दुस्मोनोहों देअलोअ काजे टोलू वोल्ये; कोडाहाज तियांआं नुकसान कोइलोअ हिम्मत ने ओवतीते, आखा माअहोंहों तियांआं धाक ओती. <verse eid="EST 9:2" /><verse number="3" style="v" sid="EST 9:3" />आन आखा प्रान्ता मेर्‍याआ मोंत्री, आधिकारी, सिपायड़ा आन राजाआ आधिकार्‍यों यहुदीही मदत कोअयी; काहाके तियांहां मोर्देखायोअ धाक ओती. <verse eid="EST 9:3" /><verse number="4" style="v" sid="EST 9:4" />राजवाड़ामेहें मोर्देखायोअ जास्ती वोडू मानपान ओतू, आन तियाआ नाव आखा प्रान्तामेहें पसरीत गोयोतो; मोर्देखायोअ नाव जाअखो वोडो वोडो ओवतो गोयो. <verse eid="EST 9:4" /><verse number="5" style="v" sid="EST 9:5" />यहुदी तियांआं आखा दुस्मोनोहों तारवाइ वाअहीं माईंत कोइत आरवीत टाक्या, आन मोनोहों पोटे तेहें कोइत तियांआं दुस्मोनोपोअ बोदलू.<verse eid="EST 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 9:6" />शूशन या राजधानी होयरोमेहें यहुदी पास होव माअहोंहों माईंत आरवीत टाक्ये. <verse eid="EST 9:6" /><verse number="7" style="v" sid="EST 9:7" />तियां पर्शन्दाता, दाल्पोन, अस्पाता, <verse eid="EST 9:7" /><verse number="8" style="v" sid="EST 9:8" />पोराथा, अदल्या, अरीदाता, <verse eid="EST 9:8" /><verse number="9" style="v" sid="EST 9:9" />पर्मशता, आरीसाय, अरीदे आन वेजाता, <verse eid="EST 9:9" /><verse number="10" style="v" sid="EST 9:10" />यां यहुद्याआं विरोधी हम्मदाताआ हामानोअ दोहू पोर्‍याहा माईंत टाक्या; पोन तियांआं मालधन ने लुट्यो.<verse eid="EST 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 9:11" />तेदिहींज शूशन राजधानीमेहें मोल्या माअहोंअ गणती राजाहा कोत आप्यी. <verse eid="EST 9:11" /><verse number="12" style="v" sid="EST 9:12" />ताहां राजा एस्तेर राणीही कोयो, “यहुद्यां शूशन राजवाड़ामेहें पास होव माअहोंहों आन हामानोअ दोहू पोर्‍याहा बी माईंत आरवी देदाहा; फाशोअ राज्याआ बिहीरा प्रान्तामेहें कि कि ओवोय तों कि मुंदू! ओमे ताआ फाशीइ काविहीं मागणी होय जी के? ते बी मान्य ओवे. ताआ काविहीं मागीइलोअ ओय ताहां को, तों बी ताहूं जोड़ीत जाय.”<verse eid="EST 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 9:13" />एस्तेर कोयो, “जर राजाआ मोर्जी ओय ताहां शूशनोमेर्‍याआ यहुद्याहां आज कोअयो तेहलोहो हांदाआ बी परवानगी रोअहूं जोवे आन हामानोअ दोहू पोर्‍याहा फासीइ खांबोपोअ टांगी देअहूं.” <verse eid="EST 9:13" /><verse number="14" style="v" sid="EST 9:14" />ताहां तेहेंज कोए तेहें राजाआ आदेश निहींयू. ओ आदेश शूशनोमेहें रोत निहींयू, आन माअहूं हामानोअ दोहू पोर्‍याहा फासीपोअ सोड़वी देदा. <verse eid="EST 9:14" /><verse number="15" style="v" sid="EST 9:15" />शूशनवाले यहुदी माअहें अदार मोयनाआ शोवदावे दिही बी टोलु वोलीत कोइत शूशनोमेहें तिन होव माअहोंहों माईंत टाक्ये, पोन मालधन ने लुट्यो.<verse eid="EST 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 9:16" />राज्याआ आलाग आलाग प्रांताआ यहुदी टोलु वोलीत कोइत तियां तियांआं जिव वासाड़ीलोअ काजे उबे रोये, आन तियांआं दुस्मोनोमेहें रोत पोन्शात्तर हाजार माअहोंहों माईंत उडाड़्ये, ताहां तियांहां दुस्मोनो रोत होक जोड़्यू; पोन तियां मालधन ने लुट्यो. <verse eid="EST 9:16" /><verse number="17" style="v" sid="EST 9:17" />ओं अदार मोयनाआ तेरावा दिहोहो ओवो; आन शोवदावा दिहोहो तियां तिवारोअ दिही ठरव्यू. <verse eid="EST 9:17" /><verse number="18" style="v" sid="EST 9:18" />पोन शूशनवाले यहुदी माअहें अदार मोयनाआ तेरावा आन शोवदावे बेन दिही टोलू वोल्ये आन पोंद्रावा दिहोहो तिवारोअ कोत ठरव्यु. <verse eid="EST 9:18" /><verse number="19" style="v" sid="EST 9:19" />तियाहाज काजे हाना होयरोम रोनारे आन खेड़ागावोम रोनारे यहुदी माअहें अदार मोयनाआ शोवदावा दिहोहो तिवारोअ दिही कोत ठरवीत एकमेकाअहीं रोटू लेत मोकलीइत्ले.<verse eid="EST 9:19" /></para>
  <para style="s">पुरीम तिवार</para>
  <para style="p">
    <verse number="20" style="v" sid="EST 9:20" />यी गोठीइ माग लेखीत कोइत मोर्देखाय राजा अश्वेरोशोअ आखा प्रान्तामेहें, सेटे आन आहने रोनारा आखा यहुदी जागे सिट्टी मोकल्यी, <verse eid="EST 9:20" /><verse number="21" style="v" sid="EST 9:21" />आन ओ आदेश आप्यू, के अदार मोयनाआ शोवदावा आन पोंद्रावा दिहोहो वोरह्योअ डिठ तिवार मान्या कोअहूं जोवे कोत ठरव्यो. <verse eid="EST 9:21" /><verse number="22" style="v" sid="EST 9:22" />या दिहोअ दिही यहुद्याहां तियांआं दुस्मोनो रोत होक जोड़्यू, आन याज मोयनाम दुख निहीत कोइत होक आयु, रोज्ये जाते रोये आन खुसी आयी; तियाहा कोत ओ मोयनु तिवारोअ मोयनू कोत पालजा. एकमेकाहा आन गरिबोहों पांगात आपजा आन दानधरम कोअजा. <verse eid="EST 9:22" /><verse number="23" style="v" sid="EST 9:23" />तिहीं वाअहीं यहुदी जेहें कोइत सुरुवात कोअयीते, आन जेहेलोहो मोर्देखाये तियांहां लेख्यो, तेहेंज कोइलाआ ठरवीत लेदो.<verse eid="EST 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EST 9:24" />काहाके हम्मदाता अगागोअ पोर्‍यु हामान जो आखा यहुदीइ विरोधी ओतु, तिये यहुदीही माईंलाअ कदर काड्यी, आन तियांहां आरवीत देअलोअ काजे सिट्टी टाक्यीते. <verse eid="EST 9:24" /><verse number="25" style="v" sid="EST 9:25" />पोन जेहेलाम राजा ओं जाईंत लेदो, ताहां तिये आदेश आप्यू आन लेखाड़्यो के जे खाराब योजना हामाने यहुदीइ विरुद्दाम कोअयीते ते तियाआज बोसी आलाअयी, ताहां तियाहा आन तियाआ पोर्‍याहा नेहें फासीपोअ टांगी देदा. <verse eid="EST 9:25" /><verse number="26" style="v" sid="EST 9:26" />तियाहा काजे पुर शब्दा वाअहीं तिया दिहोअ नाव पुरीम कोत पोड़्यो. यी सिट्टीमेऱ्युउ माग आन यीं आखी गोठीइ बाप्तिम जों किबी तियां पाल्यो आन जों किबी तियांअरी ओवो तिहीं वाअहीं बी, <verse eid="EST 9:26" /><verse number="27" style="v" sid="EST 9:27" />यहुदी माअहूं तियांआं काजे आन तियांआं पोर्‍याआ काजे आन जें तियांम सामील ओवेय तियांआं काजे एहलुहू कड़क नियम आन आदेश काडी के, तिया लेखल्याआ पुरमाणे वोरह्योअ डिठ तियाआ ठरवीइल्यी वेलेपोअ एं बेन दिही पालुहूं जोवे; <verse eid="EST 9:27" /><verse number="28" style="v" sid="EST 9:28" />आन पिड़ीन पिड़ीइ, हारेक कुटूंबाम, प्रान्ता प्रान्ताआ, हारेक होयरोम ए दिही ओर कोइत पालन कोअहूं जोवे. यहुदी माअहें या पुरीम तिवारोअ पालन कोइलोअ ने सुकवुहूं जोवे; यां दिहोहो ओर कोइलोअ यहुदी माअहें केदीहींज ने विहीराअहूं जोवे. <verse eid="EST 9:28" /><verse number="29" style="v" sid="EST 9:29" />ताहां आबीहेलोअ पोर्‍यी एस्तेर राणी आन मोर्देखाय यहुदी पुरीमोअ बाप्तिम ए दुसरी सिट्टी वोडा अधिकारो वाअहीं लेख्यी. <verse eid="EST 9:29" /><verse number="30" style="v" sid="EST 9:30" />तियाआ ते सिट्टी मोर्देखाये अश्वेरोशोअ राज्याआ एक होव सात्तावीस प्रांताआ आखा यहुदीइ जागे शांती आन सुभेश्शा मोकल्यी. <verse eid="EST 9:30" /><verse number="31" style="v" sid="EST 9:31" />के पुरीम तिया दिहोहो खास ठरवीइल्या वेलो मेहें मोर्देखाय यहुदी आन एस्तेर राणीइ आदेशोअ अनुसार, आन जे यहुदी तियां आन तियांआं पोर्‍याआ काजे ठरवित लेदोतो, तियाआ पुरमाणे बी उपास आन विखु कोअहूं जोवे. <verse eid="EST 9:31" /><verse number="32" style="v" sid="EST 9:32" />पुरीमोअ बाप्तिम ओ नियम एस्तेरोअ आदेशो पुरमाणे पाक्कू कोई देदू, आन तियांआं सर्सा पुस्तकोमेहें लेखाअयो.<verse eid="EST 9:32" /></para>
  <chapter eid="EST 9" />
  <chapter number="10" style="c" sid="EST 10" />
  <para style="s">राजा अश्वेरोश आन मोर्देखायोअ ताकत</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 10:1" />राजा अश्वेरोशे देस आन दोर्‍याआ आहनेएं बेटोपोअ कर लागाड़्यु. <verse eid="EST 10:1" /><verse number="2" style="v" sid="EST 10:2" />तिये कोअल्ये आखे वोडे कामे आन सेक्तीइ कामे, आन मोर्देखायोहो उसा पदोपोअ बोहाड़ीइलोअ पुरु माग फारस आन मादी राजाआ इतिहासोअ पुस्तकोम लेख्युहू. <verse eid="EST 10:2" /><verse number="3" style="v" sid="EST 10:3" />यहुदी मोर्देखाय, अश्वेरोशोअ राजाआ निसे ओतु, आन यहुद्याआं नजरेमेहें वोडू ओतु, आन तियाआ आखा पाही तियापोअ खुस ओता, काहाके तो तियाआ माअहोंअ काजे हाजे कामे कोअतुतो आन तियाआ आखा माअहोंअ हाजो केहें कोइत ओवे तों पालतुतो.<verse eid="EST 10:3" /></para>
  <chapter eid="EST 10" />
</usx>