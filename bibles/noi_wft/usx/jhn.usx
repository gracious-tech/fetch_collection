<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Noiri</book>
  <para style="h">योहान</para>
  <para style="toc3">योहान</para>
  <para style="toc2">योहान</para>
  <para style="toc1">योहाने लेखल्यी हाजी बातमी</para>
  <para style="mt2">योहानाने लिहिलेले शुभवर्तमान</para>
  <para style="mt1">योहाने लेखल्यी हाजी बातमी</para>
  <para style="imt">ओलखात</para>
  <para style="ip">“योहाने लेखल्यी हाजी बातमी” ओं पुस्तक नवा नियमोअ तियां शार पुस्तकोमेहें रोत एक होय, जे ईसु ख्रिस्ताआ जिवनोअ बाप्तिम कोत आपतेहे. यां शारु पुस्तकोहों “हाजी बातमी” कोतेहे. ईसुउ मोतोअ फासाड़ी मत्तय, मार्क, लुक आन योहान यांवाअहीं एं पुस्तके लेखाअये. केहेंनेत ईसु ख्रिस्ताआ जल्माआं 90 वोर्ह्योंअ आसे-पासेज ओं पुस्तक प्रेशित योहानो वाअहीं लेखाअयोहो. या पुस्तकोम एहेलोह नाहां लेख्यो के प्रेशित योहान याआ लेखार्‍यू होय. तेबी या पुस्तकोअ लेखीइलोअ पद्धत “पेहला योहान, दुसरा योहान आन तिसरा योहान” यां पत्राअरी मिलती-जुलती होये. थोड़ाक वेगाआ लेखार्‍या एहेलोह मानताहा के तियां दिहोंम योहान इफिस होयरोमेहें रोतुतो. तिहीं वाईं ओं पुस्तक इफिसोम लेखाअयोये.</para>
  <para style="ip">योहान या पुस्तकोअ उद्देश साफ देखाड़ेहे के, माअहुंहूं ईसु ओज “ख्रिस्त” होय एहेलुहू विश्वास कोइलोअ मदत जोड़े, जो जिवता देवोअ बेटुह्हू होय. <char style="xt"><ref loc="JHN 20:31">योहान 20:31</ref></char> या विश्वासो वाअहीं आपुहूं तियाआ नावम जिवन जोड़े. ओं पुस्तक यहुदी आन बिगर यहुदी यां बेनू वासनाराआं काजे लेखाअयोहो. योहानोअ हाजी बातमीमेहें बाकी तिन पुस्तकों रोत थोड़ीक गोठी वारुज आलांग होय. तो ईसु ख्रिस्ते कोअल्या समत्कारोअहें ध्यान खेसेहे, पोन तियाआ काईंइं बाप्तिम वादार नाहां लेखतू. बिहीरी मुख्य घटना मोन्ज्ये जेहेलीही के ईसुउ बाप्तिस्मा आन हुंद्ला जागाम तियाआ परिक्शा एहेलिही घटना या पुस्तकोम नाहां लेखाअयी.</para>
  <para style="iot">रुप-रेशा</para>
  <para style="io1">1. योहान हाजी बातमीइ सुरुवात कोअहे.<char style="ior"><ref loc="JHN 1:1-18">1:1-18</ref></char></para>
  <para style="io1">2. तिहींइं फासाड़ी तो ईसुउ कोअल्या थोड़ाक समत्कारोअ बाप्तिम लेखेहे.<char style="ior"><ref loc="JHN 1:19-12:50">1:19—12:50</ref> </char></para>
  <para style="io1">3. तो ईसुउ जिवनोअ वारुज गोठी कोत देखाड़ेहे जे तियाआ मोतोम रोत फाशोअ जिवतो ओविइलाआ बाप्तिम होय, आन माअहोंओं सेवा.<char style="ior"><ref loc="JHN 13:1-20:31">13:1—20:31</ref> </char></para>
  <para style="io1">4. योहान 21 वा आध्यायोमेहें हाजी बातमीइ सेवट कोअहे, जिहींमेहें ईसुउ मोतोम रोत जिवतो ओवीत माअहोंहों देखाइलो आन आखरी पोअ या पुस्तकोहो लेखीइलाअ उद्देश कोत आपित बंद कोअहे.</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">शब्द शरीर रुप बोण्यो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />सुरुवातीमेहें शब्द ओतो, आन शब्द देवोअरी ओतो, आन शब्द देव ओतो. <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />ओंज शब्द सुरुवातिही देवोअरी ओतो. <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />आखो बादो तियाज वाअहीं बोण्यों, आन जों किबी बोण्योहों तिहींमेहें रोत कोड्ली बी वस्तु तियाआ सिवाय ने बोण्‍यी. <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />तिया शब्दामेहें जिवन ओतो, आन तों जिवन मोनव्योअ उजालो ओतो. <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />उजालो आंदारामेहें सोमकेहे, आन आंदारो तियाहा जिकीत ने सेको<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">आंदारो तियाहा जिकीत ने सेको </char><char style="ft" closed="false">आंदारे तियाहा स्विकार ने कोअयू.</char></note>.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />देवे तियाआ एका खबर्‍याहा मोकल्यू; जियाआ नाव योहान ओतो.<note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="MAT 3:1">मत्तय 3:1</ref>; <ref loc="MRK 1:4">मार्क 1:4</ref>; <ref loc="LUK 3:1-2">लुक 3:1-2</ref></char></note> <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />तो आखा माअहोंहों उजालाआ बाप्तिम साक्शी कोअलोअ काजे आयू, जिहीं वाअहीं आखे माअहें उनाय आन विश्वास मिकीत सेके. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />तो सोताहा उजालो ने ओतू, पोन तिया उजालाआ बाप्तिम साक्शी आपू आयुतो. <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />खोरो उजालो जो हारेक माअहुंहूं सोमकाडेहे, तों धरतीपोअ आवनारो ओतो.<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />तों शब्द दुन्याम ओतो, आन देवे दुन्‍या तिया वाअहीं बोणायी, तेबी दुन्‍या तियाहा ने ओलख्यु. <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />तो तियाआ कोअमेहें आयू, तेबी तियाआ कोर्‍याआ माअहूं तियाहा ने ओलख्यु. <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />पोन जियां तियाहा स्विकार कोअयू, मोन्ज्ये तियाआ नावोपोअ विश्वास कोअयू, तियांहां देवोअ पोर्‍ये बोणीइलाआ आधिकार आप्यू. <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />तें ने रक्ता वाअहीं के, शरीरोअ इश्शा वाअहीं के, मोनव्योअ इश्शा वाअहीं उब्ज्ये, पोन तें देवोप रोत उब्ज्ये.<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />आन शब्द शरीर बोण्यो; आन मेरवानी आन सत्या वाअहीं पुरो ओवीत आमाआं विसमेहें वोहती कोअयी, आन आमू तियाआ एहेलिही महिमा देख्यी, जे आब्हाआ एखला बेटाह्हाअ महिमा ओये.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />बाप्तिस्मा कोअनारे योहाने तियाआ बाप्तिमेहें साक्शी आप्यी, आन आअड़ी-आअड़ीइ कोयो के, “ओ तोज होये, जियाआ बाप्तिमेहें आंय कोताप्य के, जो माआं फासाड़ी आवेहे, तो मापरोत वादार होय, काहाके तो मारोत पेल ओतू.”<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />तियाआ मेरवानीइं भारपुरी वाअहीं तो आपाअ काजे आशिर्वाद बोण्यु, आपू आखाहा तियाआ आशिर्वादोअ फासाड़ी आशिर्वाद जोड़्यू. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />देवे मोशे वाअहीं नियम आप्यू, पोन मेरवानी आन सत्य ईसु ख्रिस्ता वाअहीं आयो. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />देवोहो कोडे केदीहींज नाहां देख्यू, पोन देवोअ एखले बेटेह्हेज, जो सादा आब्हाआ बोदाम रोहे, तिये तियाहा प्रगट कोअयू.<verse eid="JHN 1:18" /></para>
  <para style="s">बाप्तिस्मा आपनारा योहानोअ संदेश</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्तय 3:1-12</ref>; <ref loc="MRK 1:1-8">मार्क 1:1-8</ref>; <ref loc="LUK 3:1-18">लुक 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />योहानोअ साक्शी ए होय के, जेहेलाम यहुदी आधिकार्‍यों येरुसालेमोम रोत थोड़ाक पुंजाराहां आन लेवीहीं बाप्तिस्मा कोअनारा योहानोहो ओं फुसे तेहें काजे मोकल्या के, “तू कोडू होये?”<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />तेहेलाम योहाने उत्तर आपीइलो ने नाकार्‍यो, पोन तो बिन्दास गोग्यू आन वारुहूं कोयो, “आंय ख्रिस्त कायनाहां.”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />ताहां तियां योहानोहो फुशो,</para>
  <para style="p" vid="JHN 1:21">“ताहरुउ तु कोडू होये?” “तु एलिया होय के?”</para>
  <para style="p" vid="JHN 1:21">तिये कोयो, “आंय नाहां.”</para>
  <para style="p" vid="JHN 1:21">तियां फुशो, “ताहां तु तो भविश्यवक्ता होय के?”</para>
  <para style="p" vid="JHN 1:21">तिये वालित उत्तर आप्यो, “नाहां.”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />ताहां तियां तियाहा फुशो, “ताहरुउ तू कोडू होये? काहाके आमू आमाआं मोकलिइनाराहा जात कोइत कोत सेको. तू सोताआ बाप्तिमेहें कि कोहे?”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />योहाने कोयो, “जेहें कोइत यशया भविश्यवक्ते कोयो:</para>
  <para style="q1" vid="JHN 1:23">“‘आंय जंगलोमेहें एका आअड़ीइनाराआ आवाज होये,</para>
  <para style="q2" vid="JHN 1:23">प्रभुउ काजे वाट हुदी बोणावा.’”<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />जियां खबर्‍याहां फरिसी माट्यों मोकल्याते. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />तियां योहानोहो ओं प्रश्न फुशो, “जर तू ख्रिस्त नाहां, आन नाहां एलिया, आन नाहां तो भविश्यवक्ता, ताहरुउ बाप्तिस्मा काहा आपेहे?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />बाप्तिस्मा कोअनारे योहाने कोयो, “आंय ताम पाअयों वाअहीं बाप्तिस्मा कोअहो, पोन तुमाआं विसमेहें एक जोऊं उबू रोत रोयुहू, जियाहा तुमू नाहां ओलखीइता. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />जो माआ फासाड़ी आवनारु होय, पोन आंय तियाआ खाहाड़ाआ पट्टी सोड़ीइलोअ बी लायक कायनाहां.”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />ए गोठी यारदेन खाडीइ तियी तोड़े बेथानी गावोमेहें ओवी, जिहीं योहान बाप्तिस्मा आपतुतो.<verse eid="JHN 1:28" /></para>
  <para style="s">दुन्याअ पाप आखलीत लेत जानारु देवोअ गिद्लू</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />बिहीरे दिही योहाने ईसुहू तियाआ वोलेहे आवत्लु देखीत कोयो, “पाला, ओ देवोअ गिद्लू<note caller="+" style="f"><char style="fr" closed="false">1:29 </char><char style="fq" closed="false">देवोअ गिद्लू </char><char style="ft" closed="false">यहुदी संस्कृतीमेहें मेडाआ पेलठा बासाहा गाराहा आपत्ले.</char></note> होये, जो दुन्याआ पाप विसीत लेत जाहे. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />ओ तोज होये, जियाआ बाप्तिमेहें मी कोयोतो, ‘एक माटी माआं फासाड़ी आवेहे, पोन तो माआं रोत वोडु होये, काहाके तो मारोत वेगुउ ओतू.’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />आंय सोताहा तियाहा ने ओलखीइतुतो, पोन आंय याअकाजे पाअयों वाअहीं बाप्तिस्मा आपतू आवोहो, काहाके इस्राएलोअ माअहें तियाहा जाईंत लेअहूं जोवे.”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />आन योहाने ए साक्शी आप्यी: “आंय आत्माहां पेरवाअ होस होरगाम रोत उतरीइत्लू देख्यू आन तो तिया पोअ बोहीत गोयू. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />आंय सोताहा तियाहा ने ओलखीत सेकू, पोन देव, जिये माहूं पाअयों वाअहीं बाप्तिस्मा आपे तेहें मोकल्‍यू, तियेज माहूं कोयो, ‘तू आत्माहां निसे उतरीइत्लू आन जियापोअ रुकाअत्लू देखही, तोज माटी होय, जो पवित्र आत्मा वाअहीं बाप्तिस्मा आपनारु होये.’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />आन आंय तियाहा देख्युहू,” आन आंय तुमुहूं साक्शी आपोहो के, “तो देवोअ बेटुह्हू होये.”<verse eid="JHN 1:34" /></para>
  <para style="s">ईसुउ पेहला सेला</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />फाशुउ आगल्येए दिहे योहान तियाआ बेन सेलाअरी तिहीं उबू रोत रोयुतो, <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />आन तिये ईसुहू जात्लाहा देखीत कोइत कोयो, “पाला, ओ देवोअ गिद्लू होये,”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />ताहां ते बेन सेला तियाआ ए गोठ उनाइत कोइत ईसुउ फासाड़ी गोया. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />ईसु फासाड़ी वोलीत तियांहां तियाआ फासाड़ी आवत्लाहा देख्या, आन तियांहां कोयो, “तुमू कोडाहा होदताहा?”</para>
  <para style="p" vid="JHN 1:38">तियां तियाहा उत्तर आप्यो, “रब्बी, मोन्ज्ये ‘गुरुजी’ तु का रोत्लू?”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />ईसु तियांहां कोयो, “आवा आन पाला.” आन ते तियाअरी जाना वोल्या, तियां देख्यो के तो का रोहे, तेदिहीं ते तियाअरी रुकाइत गोया. काहाके एक आंदास हांजेए शारेक वाजीत गोयेते.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />तियां बेनुमेहें रोत, जे योहानोअ गोठ उनाइत कोइत ईसुउ फासाड़ी आयाते, एक शिमोन पेत्राआ पाही आंद्रिया ओतू. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />तिये पेल तियाआ पाही शिमोनोहो मिलीत कोइत तियाहा कोयो, “आमुहूं मसीहा जोड़ीत गोयू, मोन्ज्ये ख्रिस्त.” <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />ताहरुउ आंद्रिया शिमोनोहो ईसुउ जागे लेत आवयू.</para>
  <para style="p" vid="JHN 1:42">ईसु तियाहा पाल्यो आन कोयो, “तू योहानोअ पोर्‍यू शिमोन होये: तू केफा, मोन्ज्ये पेत्र कोवाअही.”<verse eid="JHN 1:42" /></para>
  <para style="s">फिलीप्पोहो आन नथनेलोहो ईसु हादत्लू</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />बिहीरे दिही ईसु गालील जाअलोअ ठरव्यो. तो फिलीप्पोहो मिल्यू आन कोयो, “माआं फासाड़ी आव.” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />फिलीप बेथसैदाअ रेवासी ओतू, जिहीं आंद्रिया आन पेत्र रोताते. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />फिलीप्प नथनेलोहो मिल्यू आन तियाहा कोयो, “जियाआ बाप्तिमेहें मोशेए नियमोमेहें आन भविश्यवक्तां बी लेख्योहो, तो आमुहूं जोड़ीत गोयुहू; तो योसेफोअ पोर्‍यू, ईसु नासरेथवालू होये.”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />नथनेले तियाहा कोयो, “केहें एखू हाजी वस्तू बी नासरेथोम रोत निहींत सेकेहे के?”</para>
  <para style="p" vid="JHN 1:46">फिलीप्पे तियाहा कोयो, “आव आन पाल.”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />जाहां ईसु नथनेलोहो तियाअहें आवत्लाहा देख्यू, ताहां तियाआ बाप्तिम कोयो, “पाला, ओ खोराम खोरु इस्राएली होय: यामेहें कीज खोटी कायनाहां.”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />नथनेले तियाहा कोयो, “तू माहूं कि कोइत ओलखेहे?”</para>
  <para style="p" vid="JHN 1:48">ईसु उत्तर आप्यो, “जेहेलाम ताहूं फिलीप्पे हादल्यू, तिया रोत बी पेल तू अंजिरोअ साड़ोअ निसे ओतू, तेहेलाम आंय ताहूं देख्यूतो.”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />नथनेले तियाहा उत्तर आप्यो, “गुरुजी, तू देवोअ बेटुह्हू होय; तू इस्राएलोअ महाराजा होये.”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />ईसु तियाहा कोयो, “आंय जो ताहूं कोयो के ‘आंय ताहूं अंजिरोअ साड़ोअ निसे देखल्यू,’ केहें तू याआज काजे विश्वास कोअहे? तू आगाड़ी या रोत बी वोडे वोडे कामे देखही.” <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />आन तिये तियांहां कोयो, “आंय तुमुहूं खोरीज कोहो, तुमू होरगाहा उगड़ीइल्यो, आन देवदुतोंहों माहुंउं बेटाह्हा पोअ निसे उतरीइत्लाहा आन उसे जात्लाहा देखहा.”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">काना होयरोम वेहवाल</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />तिसरा दिहोमेहें गालीलोअ काना होयरोमेहें कोडाआ तेबी वेहवाल ओतो, आन ईसुउ आयही बी तिहीं ओती. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />ईसु आन तियाआ सेलां बी तिया वेहेवालोम आयाते. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />जेहेलाम दाराक्शाआ रोह सेलाइत गोयू, ताहां ईसुउ आयही तियाहा कोयो, “तियां पोअ दाराक्शाआ रोह सेलाइत गोयू.”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />ईसु तियीही कोयो, “ए बाय, ओं तु माहूं काहा कोतापेहे? माआं वेल ओमे नाहांजी आयी.”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />तियाआ आयही, सेवकोहों कोयो, “ओ जों कोय, तोज तुमू कोअजा.”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />तिहीं पाईं पोइलाआ डोणोअ सोव कुंडे मिकीत रोयेते, एं या उद्देशोवाअहीं मेक्येते के, यहुदी कायदाअ पुरमाणे सोकायीइ काजे कामोमेहें लागाड़ीत सेके. हारेक कुंडामेहें एहेलोहो 80 ते 120 लिटर जाआं पाईं होमाअतोतो. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />ईसु सेवकोहों कोयो, “कुंडामेहें पाईं पोई द्या.” आन तियां सेवकहों कुंडाहां सिकार पोई देदे. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />फाशोअ तिये तियांहां कोयो, “ओमे जारिक पाईं काडा आन रांदीणक्याआ मुख्याआ जागे लेत जावा.” आन ते तियाहा लेत गोया. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />जेहेलाम रांदीणक्याआ मुख्ये तों पाईं साकीत पाल्यो, जों दाराक्शाआ रोह बोणीत गोयोतो आन ने मुंदू ओतू के तो का रोत आयुहू, पोन जियां सेवकों पाईं काड्योतो, तियांहां मुंदू ओतू, ताहरुउ रांदीणक्याआ मुख्ये वोरोहो हाद्‍यू, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />आन तियाहा कोयो, “हारेक माहुंउं पेल हाजू दाराक्शाआ रोह वाटेहे, आन जेहेलामेहें माहें पित कोइते साकीत जातेहे, तेहेलामेहें मध्याममेर्‍युउ दाराक्शाआ रोह आपतेहे; पोन तुमे तोम हाजू दाराक्शाआ रोह ओमे जाआं वासाड़ीत मिक्युहू.” <figure style="fig" alt="Filling water in the stone jars" file="LB00135C.TIF" size="col" copy="Horace Knowles ©" ref="2:10">दगड़ाआ कुंडाम पाईं पोअनारो माहुंउं</figure><verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />ईसु गालीलोअ काना होयरोमेहें तियाआ ओ पेल्लूउ समत्कार देखाड़ीत कोइत तियाआ महिमा देखाड़्यी, आन तियाआ सेलहां तियापोअ विश्वास कोअयू.<verse eid="JHN 2:11" /></para>
  <para style="s">ईसु मंदिरोहो सोको कोअत्लू</para>
  <para style="r">(<ref loc="MAT 21:12">मत्तय 21:12</ref>,<ref loc="MAT 21:13">13</ref>; <ref loc="MRK 11:15-17">मार्क 11:15-17</ref>; <ref loc="LUK 19:45">लुक 19:45</ref>,<ref loc="LUK 19:46">46</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />याआ फासाड़ी ईसु आन तियाआ आयहीन, तियाआ पाही आन तियाआ सेला नेहें कफर्णहुमोमेहें गोये; आन तिहीं थोड़ाज दिही रोये.<verse eid="JHN 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />यहुदीया वालाआ वल्हांडण<note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">निर्ग 12:1-27</ref></char></note> तिवार आहने ओतू, तियाहा काजे ईसु येरुसालेमोमेहें गोयू. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />तिहीं तो मंदिरोमेहें बोलोद, मेडें आन पेरवाआं वेसनारा आन पोशा बोदलीइनारा वापार्‍योहों तिहीं बोहीत रोल्या देख्या. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />तियाहा काजे तिये एक दोअड़ाआ सापकू बोणावीत कोइत, आखा मेडाहांन बोलदोहों मंदिरोम रोत काडी देदे, आन पोशाआ बोदली कोअनाराआं पोशा वेरीत टाक्या आन टेबल उलटावी देदा; <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />आन पेरवे वेसनाराहां कोयो, “याहां इंहीं रोत बारथे लेत जावा. माआं आब्हाआ कोओहो बाजार मा बोणावहा.” <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />इंहींपोअ तियाआ सेलाहां ओर आयी के वसनोमेहें लेख्योहो, “ताआ कोओअ धुंद माहूं खात जाये.”<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />या उत्तरोमेहें यहुदी आधिकार्‍यों ईसुहू कोयो, “तू आमुहूं कोड्लू समत्कार देखाडीत सेकेहे? जियावाअहीं तु जों कोअहे, याआ तू आधिकारी होय, ओ पुरावू ओत सेके.”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />ईसु तियांहां उत्तर आप्यो, “या मंदिरोहो उठ्लावीत पाड़ा, आंय याहा तिन दिहोम फाशोअ बोणावी देहीं.”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />यापोअ यहुदी आधिकार्‍यों कोयो, “या मंदिरोहो बोणावीइलोमेहें शेहेशाड़ीस वोरह्ये लागे, आन तू याहा तिन दिहोमेहें बोणावही?”<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />पोन तिये तियाआ सोताआज शरीररुप मंदिरोअ बाप्तिम कोयोतो. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />जेहेलाम तो मोल्याम रोत जिवीत उठ्यू, ताहां तियाआ सेलाहां ओर आयी, के ईसु ओं कोयोतो; आन तियां वसनोपोअ आन ईसुउ शब्दापोअ विश्वास कोअयू.<verse eid="JHN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />वल्हांडणोअ तिवारोअ दिहोमेहें, जेहेलाम ईसु येरुसालेमोमेहें ओतू, ताहां जाअखीलेहे माअहें तियाआ समत्कारोहों पालीत कोइत तियापोअ विश्वास मिक्यू. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />पोन ईसु सोताहा तियांआं भरिवसे ने रोयू, काहाके तो आखा माहुंहूं जांअतुतो; <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />तियाहा यी गोठीइ गरज कायने के तियाहा कोडो तियां माहुंउं बाप्तिमेहें कोत आपे, काहाके तो तियां माअहोंअ मोनोम की होय तों जांअतुतो.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">निकुदेमुसोहो ईसुउ शिक्शण</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />फरिसी टोलाआ एक माटी ओतू, जियाअ नाव निकुदेमुस ओतो. तो यहुदीइ एक पुडारी ओतू. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />तिये राती ईसुउ जागे आवित कोइत तियाहा कोयो, “गुरु, आमुहूं मुंदू होय के तू देवोअहीं रोते गुरु बोणीत कोइत आयुहू, काहाके कोडोज यां समत्कारोहों जे तू देखाड़ेहे, जर देव तियाअरी ने ओय, ताहां ने देखाड़ीत सेकतो.”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />ईसु तियाहा उत्तर आप्यो, “आंय ताहूं खोरीज कोहो, जर नवीन जल्म ने लेय, ताहां देवोअ राज कोडोज बी नाहां देखीत सेकतो.”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />निकुदेमुसे तियाहा कोयो, “जाहां माहुंउं डायो ओत जाहे, ताहां तों कि कोइत फाशोअ जल्म लेत सेकेहे? केहें तों तियाआ आयहीइ पोटामेहें बिहरीवारी फोहीत कोइत जल्म लेत सेकेहे?”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />ईसु उत्तर आप्यो, “आंय ताहूं खोरीज कोहो, जाअहूं जाआं एखू माहुंउं पाईं आन आत्मा वाअहीं ने जल्म लेय, ताअहूं जाआं तो देवोअ राजोमेहें फोहीत नाहां सेकतो. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />काहाके जो डिलो वाअहीं जल्म्योहो, तो डिल होये; आन जो आत्मा वाअहीं जल्म्योहो, तो आत्मा होय. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />बोगलाअही मा के आंय ताहूं एहें कोयो, ‘ताहूं नविल जल्म लेअलोअ गरज होये.’ <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />हावा जेहें पोटे तेहें सालेहे, आन तु तियीइ आवाज उनाअहे, पोन नाहां जांअतू के ते का रोत आवेहे आन का जाहे? आन आत्मामेहें उब्जीइल्यो तो माहुंउं बी एहेलोज होये.”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />उत्तरोमेहें निकुदेमुसे कोयो, “ओं की कोइत ओत सेकेहे?”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />ईसु तियाहा उत्तर आप्यो, “तू इस्राएलोअ वोडू गुरु ओत बी केहें ओं नाहां जांअतू? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />आंय ताहूं खोरो कोहो के, आमुहूं जो मुंदू होये तोज कोताहा, आन आमू जो देख्योहो तियाआ साक्शी आपताहा, पोन तुमू जो आमू कोताहा तियाहा स्विकार नाहां कोअता. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />जेहेलाम आंय तुमुहूं धरतीइ गोठी कोयी ताहां तुमू विश्वास नाहां कोअता, आन जर आंय तुमुहूं होरगाआ गोठी कोवें, ताहराआ कि कोइत विश्वास कोअहा? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />कोडोज होरगामेहें नाहां सोढ्यो, निस्तु तोज जो होरगाम रोत उतर्‍यू, मोन्ज्ये माहुंउं बेटुह्हू जो होरगाम होये.”<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />आन जेहें कोइत मोशे रानोमेहें हापोहो उसे आखल्युतो, तेहेंज कोइत जरुरी होये के माहुंउं बेटाह्हाहा बी उसे आखलुहूं जोवे. <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />काहाके जो कोडो तियापोअ विश्वास मिके तियाहा हादाफल्योअ जिवन जोड़े. <verse eid="JHN 3:15" /><verse number="16" style="v" sid="JHN 3:16" />काहाके देवे दुन्यापोअ एतीही मेर कोअयी के, तिये तियाआ एखलू बेटुह्हू आपी देदू, एताआ काजे के जो कोडो तियापोअ विश्वास मिके, तो ने आरवाअहूं जोवे, पोन तियाहा हादाजल्म्योंअ जिवन जोड़ुहू जोवे. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />देवे तियाआ बेटाह्हाहा दुन्यामेहें याअ काजे नाहां मोकल्यू, के दुन्याआ न्याय निवाड़ू कोए, पोन तियाहा याअकाजे मोकल्यू के दुन्याआ तारण ओवुहूं जोवे.<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />जो तियापोअ विश्वास कोअहे, तियापोअ डोंडोअ आदेश नाहां आवतू, पोन जो तियापोअ विश्वास नाहां कोअतो, तो दोशी ठरवात गोयोहो; याअकाजे के तिये देवोअ एखला बेटाह्हाअ नावोपोअ विश्वास ने कोअयू. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />आन डोंडोअ आदेशोअ कारण ओं होये के उजालो दुन्यामेहें आयोहो, पोन माअहें उजाला रोत वादार आंदारापोअ मेर कोअयी, काहाके तियांआं कामे खाराब होये. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />काहाके हारेक माहुंउं जो बाक्ते कामे कोअहे, तो उजालाआ आरी दुस्मोनी मिकेहे, आन उजालाआ आहने नाहां आवतो, काहाके एहेलोह ने ओवुहूं जोवे के तियाआ बाक्ते कामे मुंदू पोड़ीत जाये. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />पोन जो सत्यापोअ सालेहे, तों उजालाआ आहने आवेहे, काहाके उजालामेहें ओं देखाइत सेके के तियाआ कामे देवोअ आदेशोअ पुरमाणे कोआयेहे.<verse eid="JHN 3:21" /></para>
  <para style="s">ईसुउ बाप्तिम बाप्तिस्मा आपनारा योहानोअ साक्शी</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />याअ फासाड़ी ईसु तियाआ सेलांअरी यहुदीयाआ इलाखाम जातु रोयू; तो तिहीं थोड़ीक वेल रोत कोइत बाप्तिस्मा आपू वोल्यू. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />तिहींज सलीम होयरोअ आहने एनोनोअ जागे योहान बी बाप्तिस्मा आप्या कोअतुतो, काहाके तिहीं खुब पाईं ओतो, आन माअहें आवित कोइत बाप्तिस्मा लेतेते. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />योहान तेहेलाम जाआं जेलेम ने तोआयूतो.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />तिहीं योहानोअ सेला एका यहुदीइरी<note caller="+" style="f"><char style="fr" closed="false">3:25 </char><char style="fq" closed="false">यहुदीइरी </char><char style="ft" closed="false">थोड़ाक लेख्यामेहें यहुद्यांअरी</char></note> सोकायीइ बाप्तिमेहें सुलाअया. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />आन तियां योहानोअ जागे आवित कोइत तियाहा कोयो, “गुरु, जो माहुंउं यारदेन खाडीइ तियी वोग ताअरी ओतो, आन जियाआ तुमे साक्शी आप्यीही; तो बाप्तिस्मा आपेहे, आन आखे माअहें तियाआ जागे जातेहे.”<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />योहाने कोयो, “माहुंहूं होरगाम रोत ने आपे ताअहूं जाआं तियाहा कीज नाहां जोड़ीत सेकतो. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />तुमू ताम सोताहाज माआं साक्शीदार होय के आंय कोयोतो, ‘आंय ख्रिस्त कायनाहां, पोन आंय ते तियाआ आगाड़ी मोकलाअयुहू.’ <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />वर तोज होय, जियाहा वोड़ली जोड़ेहे; पोन वोरोअ दोस्ती जो उबू रोत तियाआ उनाअहे, वोरोअ गोठी वाअहीं खुब खुस ओवेहे: ओमे माआं ए खुसी पुरी ओयीही. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />गरजेए होय के तो वादे आन आंय कमी ओवो.”<verse eid="JHN 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />“जो उसे रोत आवेहे तो आखाम रोत वोडू होये; आन तो जो धरतीइ होय, तो धरतीइरी जुडाअलू होये, तियाहा काजे तो धरतीइज गोठी कोअहे: जो होरगाम रोत उतर्‍युहू, तो आखाम रोत उसे होये. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />तिये जो किबी देख्योहो आन उनाअयुहू, तियाआ तो साक्शी आपेहे; पोन तियाआ साक्शी कोडोज नाहां स्विकारतो. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />जिये तियाआ साक्शी स्विकार कोइत लेदी, तिये यी गोठीपोअ सिक्कु लागाड़ी देदू के देव खोरु होये. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />काहाके जियाहा देवे मोकल्युहू तो देवोअ गोठी कोहे; काहाके देव तियाहा आत्मा मोजीत-मापीत आपेहे. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />आब्हू बेटाह्हा पोअ मेर कोअहे, आन तिये आखी वस्तु तियाआ आथोम आपी देदीही.<note caller="+" style="f"><char style="fr" closed="false">3:35 </char><char style="ft" closed="false">मत्तय 11:27; लुक 10:22</char></note> <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />जो बेटाह्हा पोअ विश्वास कोअहे, हादाफल्योअ जिवन तियाआ होय; पोन जो बेटाह्हाआ नाहां मानतो, तो जिवनोहो ने देखे, पोन देवोअ खोत तियापोअ रोहे.”<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">शोमरोनवाली बायीइरी ईसु गोठी कोअत्लू</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />जेहेलाम फरिसी ओं उनाअया के ईसु योहानोअ रोत वादार सेला बोणावेहे आन तियांहां बाप्तिस्मा आपेहे. <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />खोरीज, ईसु सोताहा नाहां पोन तियाआ सेला बाप्तिस्मा आपताते. <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />जेहेलाम ईसु ओं उनाअयू, ताहां तो यहुदीयाहा सोड़ीत कोइत वापिस गालीलोम जातु रोयू, <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />यी फेरे तियाहा शोमरोनोमेहें रोत जाअहूं पोडनारो ओत्लो.<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />तियाहा काजे तो सुखार नावोअ शोमरोनोअ एका होयरोमेहें आवयू, ओं होयर तिया खेतोअ आहने ओतो, जियाहा याकोबे तियाआ पोर्‍या योसेफोहो आप्योतो; <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />आन याकोबोअ वेए बी तिहींज ओती. आन ईसु वाटे साली सालीइ थाकलुज तियी वेईइ जागे आवित बोहीत गोयू. ए गोठ दिहेए वेले ओवी.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />तेताजमेहें तिहीं एक शोमरोनोवाली बाय पाईं पोइ आयी. ईसु तियीही कोयो, “माहूं पाईं पीइहूं आपा.” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />तियाआ सेला रोटू वेसातू लेअलाअ काजे गांवोंमेहें गोया.<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />तियी शोमरोनोवाली बायी तियाहा कोयो, “तुमू यहुदी होय आन आंय शोमरोनोअ होय, तेबी तुमू मापोअ पीइलोअ काजे पाईं काहा मागतेहे?” काहाके यहुदी तोम शोमरोन वालाअरी कोड्लोज सबंध ने मेकतेते.<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />ईसु उत्तर आप्यो, “जर तू देवोअ वरदान की होय तो जांअती, आन ओं बी जांअती, के जो ताहूं कोहे, ‘माहूं पाईं पीइहूं आप,’ तो कोडू होये, ताहां तू तियापोअ मागती, आन तो ताहूं जिवनोअ पाईं आपतू.”<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />तियी बोईं तियाहा कोयो, “प्रभु, तुमापोअ कोड्लोज बासन कायनाहां, आन वेए तोम जाअखीलीही उंडी होये; ताहां तुमापोअ जिवनोअ पाईं का रोत रोनारो? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />केहें तू आमाआं आब्हा याकोबोअ रोत वोडू होये, जिये सोताहा आमुहूं ए वेए आप्यीही; तो आन तियाआ पोर्‍ये, आन तियाआ बोकड़ेन डोगरे इंहीं रोत पाईं पितेते?”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />ईसु तियीही उत्तर आप्यो, “जो कोडो ओं पाईं पिये तियाहा फाश्यी तोरह लागे, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />पोन जो कोडो तिया पाअयोंमेहें रोत पिये जो आंय तियाहा आपिहीं, तो फाशोअ केदीहींज तोरह्‍यो ने रोये; पोन जो पाईं आंय तियाहा आपिहीं, तो तियामेहें एक उकलू बोणीत जाये, जो हादाजल्म्याअ जिवनोअ काजे निहीया कोए.”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />बायी तियाहा कोयो, “प्रभु, तो पाईं माहूं आपेए, काहाके माहूं तोरह ने लागुहूं जोवे आन ने पाईं पोई एवडी सेटे आवुहूं पोड़े.”<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />ईसु तियीही कोयो, “जा, आन ताआ माट्योहो हादीत लेत वापिस आव.”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />तियी बायी कोयो, “माआं कोड्लूज माटी कायनाहां.”</para>
  <para style="p" vid="JHN 4:17">ईसु कोयो, “तू कोहे के, ‘माआं माटी कायनाहां,’ ताहां ओं तू बोराबर कोहे. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />काहाके ताआ पास माटी ओता, आन ओमे तू जिया माट्योअरी जिवेहे, तो बी ताआ माटी कायनाहां. तियाहा काजे तुमे जो कोयोहो तो खोरो कोयोहो.”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />तियी बोईं तियाहा कोयो, “साहीब, माहूं लागेहे के तुमू भविश्यवक्ता होये. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />आमाआं वेगाअ डायहां याज डोगो पोअ देवोअ आराधना कोअयिही, पोन तुमू यहुदी कोतेहे के येरुसालेमुज आराधनाआ कोइलोअ जागू होये.”<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />ईसु तियीही कोयो, “ए बाय, माआं गोठीइ विश्वास कोअ के ते वेल आवेहे के तुमू ने डोगोपोअ आब्हाअ आराधना कोअहा, ने येरुसालेमो मेहें. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />तुमू शोमरोनोअ माअहें जियाहा नाहां ओलखीइते, तियाआ आराधना कोअतेहे; पोन आमू यहुदी जियाहा ओलखीइतेहे तियाआ आराधना कोअतेहे; काहाके तारण यहुदीमेहें रोतुज होय. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />पोन ते वेल आवेहे, आन आवतीज लागीही, जाहां खोरे भक्ते आब्हाअ आराधना आत्मा आन खोरा मोनो वाअहीं कोअनारे, देव आब्हू एहेलाहाज भक्तोहों होदेहे. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />देव आत्मा होय, आन ओं जोवयोज के तियाआ आराधना कोअनारे आत्मा आन खोरा मोनो वाअहीं तियाआ आराधना कोअहूं जोवे.”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />तियी बोईं ईसुहू कोयो, “माहूं मुंदू होये के मसीहा जो आवनारु होय; तो जेहेलाम आवे, तेहेलाम आमुहूं आखी गोठी समजाड़ी देये.”<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />ईसु तियीही कोयो, “आंय जो ताअरी गोठी कोअहो, तो आंय तोज होये.”<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />तेताजमेहें ईसुउ सेला तिहीं वापिस आवित लागा, आन ते ओं देखीत कोइत हुदाअलीज एहेलाहा बोगलाअया के तो एकी बोईंइरी गोठी कोअहे; पोन कोडेज तियाहा किन्ने कोयो, के “ताहूं यी बोईंइरी की लेणो-देणो?” नेते “तू यीइरी काहा गोगेहे?”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />ताहरीइ ते बोयोंअ तियीइ पाईं पोइलाआ डोसरो तिहींज टाकी देत होयरोम वोलीत गोयी, आन माअहोंहों कोनी वोल्यी, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“आवा आन पाला, एक एहेलोहो माहुंउं होये, जिये आंय जो किबी कोअयोहो तो आखो कोत देदोहो. केहें तोज ख्रिस्त ओत सेकेहे के?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />यी गोठी वाअहीं माअहें होयर सोड़ीत ईसुउ जागे जात पोते.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />तेहेलाजमेहें ईसुउ सेलहां तियाहा रावणी कोअताते, “ए गुरु, वाहींक ते खात ले.”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />पोन ईसु तियांहां कोयो, “मापोअ खाअलाअ काजे एहेलुहू रोटू होये जियाअ बाप्तिम तुमू नाहां जांअता.”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />इंहीं वाअहीं सेला तियां तियांआंज एकानेकाहा फुसा वोल्या, “एखू याअ काजे खाअलोअ लेतायोय के?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />ईसु तियांहां कोयो, “माआं रोटू ओ होये के आंय माहूं मोकलीइनाराआ ईश्शाआ पुरमाणे सालो आन तिये होपल्यो काम पुरो कोओ. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />तुमू कोताहा के ‘शार मोयना फाश्याआ होय, ताहां कामाय आवे.’ पाला, आंय तुमुहूं कोहो, वारुहूं खेतोअहें पाला, ओन पाकीत गोयोहो आन वाडीइलाअ काजे तियार होये. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />वाड्नारु मोजरी मेलवेहे आन हादाजल्म्याआं जिवनोअ काजे फल हाटवेहे, काहाके पेएनारु आन वाड्नारु बेनू मिलीत खुस रोअहूं जोवे. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />काहाके यी जागेहे ए काईं खोरी होये: ‘एक पेएहे आन बिहीरो वाडेहे.’ <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />आंय तुमुहूं तियी कामायीही वाडेतेहें मोकल्याहा जियीपोअ तुमाआं मेहेंनत नाहां लागी: जियीपोअ बिहीरे मेहेंनत कोअयिही आन तियांआं मेहेनतीइ फल तुमुहूं जोड़्योहो.”<verse eid="JHN 4:38" /></para>
  <para style="s">वारुज शोमरोन वालाआं विश्वास कोइलो</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />तिया होयरोमेर्‍येए जाअखीलेहे शोमरोनोअ माअहें तियी बायीइ कोल्यावाअहीं ईसुपोअ विश्वास कोअयू; काहाके तियी ए साक्शी आप्यीते: “तिये आक्खोज जों आंय कोअयोहो, तों माहूं कोत देदो.” <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />तियाहा काजे जेहेलाम एं शोमरोनोवाले तियाआ जागे आवये, ताहां तियाहा रावणी कोए वोल्ये के आमाआं जागे रुकाआ. ताहरुउ ईसु तिहीं बेन दिही जाआं रोयू.<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />तियाआ वसनोवाअहीं बिहीरे बी जाअखीलेहे माअहें विश्वास कोअयू, <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />आन तियां तियी बायीही कोयो, “ओमे आमू ताआ कोअला वाअहींज विश्वास नाहां कोअते; काहाके आमू सोताहाज उनाइत लेदो, आन समजीत लेदो के ओज हादामक्युज दुन्याअ तारनारु होये.”<verse eid="JHN 4:42" /></para>
  <para style="s">आधिकार्‍योअ पोर्‍याहा ईसु हुदारत्लू</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />बेन दिहोअ फासाड़ी ईसु तिहीं रोत निहीत कोइत गालीलोम गोयू, <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />काहाके ईसु सोताहाज कोयोतो के, “कोड्लाज भविश्यवक्ताहा सोताआ जागामेहें मानपान नाहां जोड़तू.” <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />जेहेलाम तो गालीलोम आयू, ताहां गालील वाले तियाआ स्वागत कोअयो; काहाके जेते कामे तिये येरुसालेमोमेहें वल्हांडणोअ तिवारोअ होमसे कोअयेते, तियां ते आखे कामे देख्येते, काहाके तें बी वल्हांडणोअ तिवारोमेहें सामील ओते.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />फाशुउ एक वारी ईसु गालीलोअ काना गांवोंमेहें आयू, जिहीं तिये पांअयोंअ दाराक्शाआ रोहो बोणावी देदूतो. कफर्णहुमोमेहें एका राजाआ आधिकार्‍योअ पोर्‍यू बिमार ओतू. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />जेहेलाम राजाआ आधिकार्‍ये होंबल्यो के यहुदीयामेहें रोत ईसु गालीलोम आयुहू, ताहां तो तियाआ जागे आयू आन रावणी कोअयी के तो कफर्णहूम जात कोइत तियाआ बेटाह्हाहा हाजू कोई दे: जो मोअहूंज ओतू. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />ईसु तियाहा कोयो, “जाअहूं जाआं तुमू समत्कार आन वोडे वोडे कामे ने देखहा ताअहूं जाआं विश्वास ने कोअहा.”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />राजाआ आधिकार्‍ये कोयो, “मालिख, माआं पोर्‍याआ मोईलोअ पेल तुमू माअहीं साला.”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />ईसु तियाहा कोयो, “जा, ताआ पोर्‍यू जिवतु रोये.”</para>
  <para style="p" vid="JHN 4:50">तो माटी ईसुउ कोल्यी गोठी पोअ विश्वास कोअयू आन कोअ जातु रोयू. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />तो कोअ वोलत्लू, ताहां वाटेज मेहें ओतू तेहेंज तियाआ सेवके तियाहा खोबर आप्यी, “ताआ पोर्‍यू जिवतु होये.”<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />तिये तियांहां फुशो, “कोड्ली वेले तो हाजू ओनू वोल्यू?” तियां तियाहा कोयो, “काल दिहे एक वासता तियाआ जोरु उतरीत गोयू.” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />पोर्‍याअ आब्हाहा दिहानोमेहें आयो के ए बोराबर तेज वेल ओती, जाहां ईसु तियाहा कोयोतो, “ताआ पोर्‍यू जिवतु रोये.” एहेंकोइत तियाआ पुरा कुटूंबाअरी विश्वासी बोणीत गोयू.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />ओ दुसरु समत्कार ओतू, जो ईसु यहुदीयाम रोत गालीलोम आवित कोइत देखाड़्यू.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">कुंडीइ जागेहे नेराय</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />याअ फासाड़ी ईसु यहुदीइ एका तिवारोअ काजे येरुसालेम गोयू. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />येरुसालेमोमेहें मेडाअ दरवाजाआ जागे एक कुंडी होये, जियीही इब्री बाशामेहें बेथसैदा कोतेहे; तियाआ पास ओटा होये. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />जिहीं आंद्ले, पांगले आन लखवाअ बिमार आन एहेला खुब मांदवाड़्या माहुंउं गर्दी पोड़ीत रोतीते. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />काहाके ठरवीइल्यी वेलेपोअ देवोअ देवदुत कुंडीमेहें उतरीत कोइत पाईं आलव्या कोअताते. पाईं आलताज वाआ जो कोडो पेल उतरीइतोतो, तो हुदरीत जातोतो. भले तियाआ कोड्लीज बी बिमारी काहा नाहां रोती. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />तिहीं एक माहुंउं ओतो, जो आड़ोतीस वोरह्ये बिमारीम ओतो. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />ईसु तियाहा लोटीत रोल्यो पालित कोइत आन ओं जाईंत कोइत के तो जाअखीलाहा दिहीर्‍योअ यी दशामेहें पोड़ीत रोयोहो, तियाहा फुशो, “केहें ताआ हुदरीइलोअ इश्शा होये?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />तिये बिमारी माहें, तियाहा उत्तर आप्यो, “प्रभु, माआ जागे कोडो माहुंउं कायनाहां जो पाईं आलवाय तेहेलाम माहूं कुंडीमेहें उतारीत सेके; पोन माहूं पोत्ता-पोत्ता बिहीरो मारोत पेल उतरीत पोडेहे.”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />ईसु तियाहा कोयो, “उठ आन ताआ खाट्लो लेत सालू वोल.” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />तों माहुंउं ताअहांज हाजो ओत गोयो, आन तियाआ खाट्लो विसीत सालो वोल्यो.</para>
  <para style="p" vid="JHN 5:9">ओं तेदिहीं ओवो जेदिहीं आरामोअ दिही ओतू. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />यापोअ यहुदी आधिकार्‍यों तियापोअ जियाहा नेराय जोड़्यीते, तियाहा कोअलाअ सुरु कोअयो, “आज आरामोअ दिही होये, आन आमाआं कायदाअ पुरमाणे खाट्लो उसलीइलोअ ओं विरुद्दाम होये.”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />तिये तियांहां उत्तर आप्यो, “जिये माहूं हुदार्‍यू, तियेज माहूं कोयो, ‘ताआ खाट्लो विस, आन सालू वोल.’”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />तियां तियाहा फुशो, “तो कोडू माटी होये, जिये ताहूं कोयो, ‘आथरुउ विस, आन सालू वोल?’”<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />पोन जो हुदरीत गोयुतो, तियाहा ईसु कोडू होय तो ने ओलखाअयू, काहाके तियी जागे जाअखीलिही गर्दी ओती, आन ईसु तिहीं रोत ठावकुज जातु रोयुतो.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />यीं गोठीइ फासाड़ी तो ईसुहू मंदिरोमेहें मिल्यू. ईसु तियाहा कोयो, “पाल, तू हुदरीत गोयुहू: फाशुउ पाप मा कोअही, एहेलोह ने ओवुहूं जोवे, के यापरोत जाअखी पाअयी अड़सन तापोअ आवित पोड़े.”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />तिये माहें जात कोइत यहुदी आधिकार्‍योहों कोत देदो के ईसु माहूं हुदार्‍युतो.<verse eid="JHN 5:15" /></para>
  <para style="s">बेटाह्हा वाअहीं जिवन</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16" />यी गोठी वाअहीं यहुदी ईसुहू तारास देअलोअ सुरु कोअयो, काहाके तो एहेलेहे कामे आरामोअ दिही कोअतुतो. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />ईसु तियांहां कोयो, “माआ आब्हू कायम काम कोअया कोअहे, आन आंय बी काम कोअया कोअहो.”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />तिहीं वाअहीं यहुदी फाश्याआ बी वादार तियाहा माईंत टाकीइलाआ कोशित कोआ वोल्या, काहाके तो निस्तु आरामोअ दिहोअ नियम एतुज ने तोडतुतो, पोन देवोहो माआं आब्हू कोत कोइत सोताहा देवोअ सारकुहू गोणतुतो.<verse eid="JHN 5:18" /></para>
  <para style="s">बेटाह्हाआ आधिकार</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />यापोअ रोत ईसु तियांहां कोयो, “आंय तुमुहूं खोरीज कोहो, बेटुह्हू सोताहाज किज नाहां कोइत सेकतु, फक्त जों आब्हाहा कोअत्लाहा देखेहे तोंज कोअहे; काहाके जियां जियां कामोंहों आब्हू कोअहे तियां कामोंहों बेटुह्हू बी कोअहे. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />काहाके आब्हू बेटाह्हा पोअ मेर कोअहे आन जों जों काम तो सोताहा कोअहे, तों आखो तियाहा देखाड़ेहे; आन तो यांप रोत बी वोडे कामे तियाहा देखाड़े, काहाके तुमू बोगलाअहूं जोवे. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />आब्हू जियांहां मोल्याम रोत उठाड़ेहे आन तियांहां जिवन आपेहे, तेहेंज कोइत बेटुह्हू बी जियांहां जिवाड़ुहूं होदेहे तियांहां जिवाड़ेहे. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />आब्हू कोडाअ न्याय ने कोअत्लू, पोन न्याय कोइलाआ आधिकार बेटाह्हाहा आपी देदुहू, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />के आखे माअहें जेहें कोइत आब्हाअ मानपान कोअतेहे तेहेंज कोइत बेटाह्हाअ बी मानपान कोअहूं जोवे. जो बेटाह्हाअ मानपान नाहां कोअतो, तो आब्हाअ जिये तियाहा मोकल्युहू, मानपान नाहां कोअतो.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />“आंय तुमुहूं खोरीज कोहो, जो माआं शब्द उनाइत कोइत माहूं मोकलीइनारा पोअ विश्वास कोअहे, हादाजल्म्योंअ जिवन तियाआ होय; आन न्यायोअ डोंड तियापोअ ने आवे, पोन याअ बोदले तों मोतोम रोत उनकीत जिवनोम जातो रोयो. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />आंय तुमुहूं खोरीज कोहो ते वेल आवेहे, पोन आवतीज लागीही, जियीमेहें मोल्ये देवोअ बेटाह्हाअ आवाज उनाये, आन जें उनाय तें जिवे. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />काहाके जेहें कोइत आब्हू जिवनोअ उकलू होय, तेहेंज कोइत तियाआ बेटाह्हाहा बी जिवनोअ उकलू बोणावयुहू; <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />फाशुउ तियाहा न्याय कोइलाआ बी आधिकार आप्युहू, याअकाजे के तो माहुंउं बेटुह्हू होये. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />या वाअहीं मा बोगलाअहा; काहाके ते वेल आवेहे के जेत्ते बी माहणोम होय, तें तियाआ आवाज उनाइत कोइत निहींत आवे. <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />जियां हाजे कामे कोअयेहे तें जिवनोअ पुनरुत्थानोअ काजे आन जियां खाराब कामे कोअयेहे, तें डोंडोअ पुनरुत्थानोअ काजे जिवीत उठे.<verse eid="JHN 5:29" /></para>
  <para style="s">ईसुउ बाप्तिम साक्शी</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />“आंय माआं माआंज किज नाहां कोइत सेकतु; जेहलुहू उनाअहो, तेहलुहू न्याय कोअहो; आन माआं न्याय खोरु होय, काहाके आंय माआं इश्शा नाहां, पोन माहूं मोकलीइनाराअ इश्शा होदोहो.<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />“जर आंय माआं सोताआ साक्शी आपो, ताहां माआं साक्शी खोरी नाहां. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />एक बिहीरु होय जो माआं साक्शी आपेहे, आन माहूं मुंदू होय के माआं जे साक्शी तो आपेहे, ते खोरी होये. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />तुमू योहानोअ जागे खबर्‍या मोकल्‍या आन तिये सत्याआ साक्शी आप्यी. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />पोन माआं बाप्तिमेहें माहुंउं साक्शी नाहां जोवती; तेबी आंय ए गोठी याअकाजे कोहो के तुमाआं तारण ओवुहूं जोवे. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />योहान ते पेटाअत्लू आन सोमकीइत्लू दिवू ओतू, आन तुमुहूं थोड़ीक वाआ जाआं तियाआ उजालाम मोज्या लेअलोअ हाजो लागो. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />पोन मापोअ जे साक्शी होय ते योहानोअ साक्शी रोत वोडी होये; काहाके जो काम आब्हे माहूं पुरो कोअहूं जोवे काजे होप्योहो, मोन्ज्ये ओंज काम जो आंय कोअहो, ओंज काम माआं साक्शीदार होये के आब्हे माहूं मोकल्युहू. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />आन आब्हू जिये माहूं मोकल्युहू, तियेज माआं साक्शी आप्यीही. तुमू नाहां केदिहीं तियाआ आवाज उनाअये, आन नाहां तियाआ रुप देख्यू; <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />आन नाहां तुमू सोताआ मोनोम तियाआ संदेश स्विकारते, काहाके तुमू मोकलीइनारा पोअ विश्वास नाहां कोअते. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />तुमू वसनोअ लेख्याहा वासतेहें, काहाके तुमाआं विसार होय के तुमुहूं तियां वाअहीं हादाजल्म्योंअ जिवन जोड़े; पोन ओं वसनोअ लेख्योज माआं साक्शी आपेहे; <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />तेबी तुमू जिवन मिलवीलाअ काजे माआं जागे आविइलाअ नाहां कोअते.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />“माहूं मोनव्योअ वाअहीं कोअल्यू मानपान नाहां जोवतू. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />काहाके माहूं मुंदू होय के तुमामेहें देवोअ मेर कायनाहां. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />आंय माआं आब्हाअ आधिकारो वाअहीं आवयुहू, तेबी तुमू माहूं स्विकार नाहां कोअते; जर बिहीरो एखो सोताआज नावसे आवे, ताहां तियाहा स्विकार कोइत लेहा. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />तुमू ते एकान बिहीरा पोअ रोत मानपान होदतेहे, पोन तुमू जो एकुज देव होये तियाअहें रोत मानपान नाहां होदते, ताहां मापोअ की कोइत विश्वास कोइत सेकतेहे? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />ओं मा समजाहा के आंय आब्हाअ सामने तुमा पोअ आरोप लागाड़ीहीं; तुमा पोअ आरोप लागाड़नारु तोम मोशे होये, जिया पोअ तुमू आशा मिक्यीही. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />काहाके जर तुमू मोशेए विश्वास कोअते, ताहां माआं बी विश्वास कोअते, काहाके तिये माआं बाप्तिमेहें लेख्योहो. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />जाहां तुमू जो तिये लेख्योहो तियाज मेहें विश्वास नाहां कोअते, ताहां माआं गोठीपोअ की कोइत विश्वास कोअहा?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">पास हाजार माअहोंहों ईसु तारीवत्लू</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्तय 14:13-21</ref>; <ref loc="MRK 6:30-44">मार्क 6:30-44</ref>; <ref loc="LUK 9:10-17">लुक 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />यीं गोठीइ फासाड़ी ईसु गालील दोर्‍याअ मोन्ज्ये तिबिरियास दोर्‍याआ तिवोग गोयू. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />आन एक वोडी गर्दी तियाआ फासाड़ी जानी वोल्यी, काहाके तियां मांदवाड़्ये हुदरीइलाअ तिये कोअल्या समत्कार देख्याते. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />ताहरुउ ईसु डोगो पोअ सोढीत कोइत तियाआ सेलांअरी बोहीत गोयू. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />यहुद्याआं वल्हांडणोअ तिवार आहने ओतू. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />जाहां ईसु तियाआ सोमकीर नजर फेरवीत वोडी गर्दीही तियाअहें आवत्लाहा देख्यी, तेहेलाम फिलीप्पोहो कोयो, “आपू यां माअहोंअ काजे ताराइत खाय एतुहू रोटू का रोत वेसातू लेतावहूं?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />तिये ए गोठ फिलीप्पोहो फारकीइलाअ काजे कोयी, काहाके तो सोताहा जांअतुतो के तो कि कोअनारु होये.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />फिलीप्पे तियाहा उत्तर आप्यो, “बेन होव सांदीइ रुप्याआ<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="fq" closed="false">सांदीइ रुप्या </char><char style="ft" closed="false">मोन्ज्ये दिनार</char></note> रोटा वेसाता लेय आन हारेक जोओंहों थोड़ थोड़ा बी आपे, तेबी पुगी ने आवे.”<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />तियाआ सेलामेर्‍युउ शिमोन पेत्राआ पाही आंद्रिये तियाहा कोयो, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“इंहीं एक पोर्‍यू होये जिया पोअ जवोअ पास रोटा आन बेन मासा होये; पोन एता माअहोंअ काजे ते काहा पुरेमे?”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />ईसु कोयो, “माअहोंहों बोहाड़ी द्या.” तियी जागेहे जाअखीलोह खोड़ ओतो: ताहां आखे माअहें बोहीत गोये; जियांमेहें एका आंदासोवाअहीं माट्योंअ गणती पास हाजार ओती. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />ताहरुउ ईसु आथोमेहें रोटू लेदू, आन देवोहो धन्यवाद आपीत कोइत तिहीं बोहनारा माअहोंहों वाटी देदू; आन तेहेंज कोइत मासे बी वाटी देदे, आन तियांहां जेते जोवे तेतेहे जोड़्ये. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />जेहेलाम ते खात कोइत ताराइत गोये, ताहां तिये तियाआ सेलाहां कोयो, “उगरीइल्या कुटका हाटवीत ल्या के किज वाया ने जाअहूं जोवे.” <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />ताहराअ तियां हाटव्या, आन पास जवोअ रोटाअ कुटका वाअहीं जे खानारापोअ रोत उगर्‍याते, बारा टोपले पोआये.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />ताहां जो समत्कार ईसु तियांहां कोइत देखाड़्यू, तियाहा काजे तें माअहें कोने वोल्ये, “जो भविश्यवक्तू दुन्यामेहें आवनारु ओतू तो हादामक्यु ओज होये.” <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />ईसु ओं ओलखीत कोइत के तें तियाहा जबरजस्तीज राजा बोणावीइलाअ काजे तोअनारे होये, ताहां तो डोगो पोअ एखलुज जातु रोयू.<verse eid="JHN 6:15" /></para>
  <para style="s">ईसुउ पाअयों पोअ सालीइलो</para>
  <para style="r">(<ref loc="MAT 14:22-33">मत्तय 14:22-33</ref>; <ref loc="MRK 6:45-52">मार्क 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />जेहेलाम हांजेए वेल आयी, ताहां ईसुउ सेला दोर्‍याअहें गोया, <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />आन एका नावड़ामेहें बोहीत दोर्‍याअ एकी मेरे कफर्णहुमोमेहें जाना वोल्या. तेहेलामेहें वारुज आंदारो ओत गोयोतो, तेबी ईसु ओमे जाआं तियांआं जागे ने आयुतो. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />वोडू वादुउ सालू वोल्यू तिहीं वाअहीं दोर्‍यामेहें सेलकाआ उसला वोल्या. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />जेहेलाम ते पास सोव किलो मिटर जाता रोया, ताहां तियां ईसुहू दोर्‍याआ पाअयों पोअ सालित कोइत नावड़ाअहें आवत्लू देख्यू, आन ते बित गोया. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />ईसु तियांहां कोयो, “आंय होंव, मा बिहा.” <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />ताहराअ ते तियाहा नावड़ामेहें बोहाड़ीलोअ काजे तियार ओवा, आन ताबुड़ तों नावड़ो तियी मेरे जात पोत्यो जिहीं तियांआं जाअलो ओत्लो.<verse eid="JHN 6:21" /></para>
  <para style="s">माहें ईसुहू होद्त्ले</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />बिहीरे दिही तियी गर्दीइ माअहें, जे दोर्‍याअ तियी मेरे गोयेते, तियां ओं देख्यो के इंहीं एका नावड़ाअ सिवाय बिहीरो कोड्लो नावड़ो कायने ओतो; आन ईसु तियाआ सेलांअरी तिया नावड़ामेहें ने बोठू, ओं तियांहां मुंदू पोड़ीत गोयू, पोन निस्ता तियाआ सेला एताज गोयाते. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />ताहां बिहीरे नावडे तिबिरियास रोत तिया जागाआ आहने आवये, जिहीं तियां प्रभुउ आभार मानित रोटू खादूतो. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />तियाहा काजे गर्दीइ माअहूं देख्यो के इंहीं नाहां ईसु आन नाहां तियाआ सेला, ते बी नावड़ामेहें बोहीत कोइत ईसुहू होदते होदते कफर्णहुमोअहें जाने वोल्ये.<verse eid="JHN 6:24" /></para>
  <para style="s">ईसु जिवनोअ रोटू</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />जाहां माअहें ईसुहू दोर्‍याआ एकी मेरे मिल्ये ताहां कोयो, “गुरु, तू इंहीं केती वेले आयू?”<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />ईसु तियांहां उत्तर आप्यो, “आंय तुमुहूं खोरीज कोहो, तुमू माहूं याअकाजे नाहां होदते के तुमू समत्कार देख्या, पोन याअ काजे के तुमू रोटू खात कोइत ताराअये. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />आरवाअनारा ओनोअ काजे मेहेंनत मा कोअहा, पोन तिया ओनोअ काजे मेहेंनत कोआ जों हादाजलम जिवनोम टिकीत रोहे, जियाहा माहुंउं बेटुह्हू तुमुहूं आपे; काहाके आब्हे मोन्ज्ये देवे तियाज पोअ सिक्कु लागाड़्युहू.”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />तियां तियाहा कोयो, “देवोअ काम कोइलाआ कोअते आमू कि कोओ?”<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />ईसु तियांहां उत्तर आप्यो, “देवोअ काम ओं होय के तुमू तिया पोअ, जियाहा तिये मोकल्युहू, विश्वास कोआ.”<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />ताहां तियां तियाहा उत्तर आप्यो, “ताहरुउ तू कोड्लू समत्कार देखाड़ेहे के आमू देखीत कोइत तापोअ विश्वास कोअ? तू की कोअही? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />आमाआं वेगाअ डायहां जंगलोमेहें मान्ना खादो; जेहलोहो लेख्योहो, ‘तिये तियांहां खाअहूं काजे होरगाम रोत रोटू आप्यू.’”<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />ईसु तियांहां कोयो, “आंय तुमुहूं खोरीज कोहो के मोशे तुमुहूं तो रोटू होरगाम रोत नाहां आप्यू, पोन माआं आब्हू होय जो तुमुहूं होरगाम रोत खोरु रोटू आपेहे. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />काहाके तो रोटू जियाहा देव आपेहे तो होरगाम रोत उतर्‍युहू आन दुन्याहा जिवन आपेहे.”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />ताहां तियाहा तियां कोयो, “प्रभु, ओ रोटू आमुहूं सादाज आप्या कोअजी.”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />ईसु तियांहां कोयो, “जिवनोअ रोटू आंय होय: जो माआं जागे आवे तो केदिहीं फुकल्यो ने रोये, आन जो मापोअ विश्वास कोअहे, तो केदिहीं तिहील्यो ने रोय. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />पोन आंय तुमुहूं कोयोतो के तुमू माहूं देखीत लेदूहू, तेबी विश्वास नाहां कोअते. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />हारेक जोओं जियाहा आब्हू माहूं आपेहे, तो माआं जागे आवे, आन जो माआं जागे आवेहे तियाहा केदिहीं वोलीत जाअहूं ने देंव. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />काहाके आंय माआं इश्शा नाहां, पोन माहूं मोकलीइनाराआ इश्शा पुरी कोइलाआ काजे होरगाम रोत उतर्‍युहू; <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />आन माहूं मोकलीइनाराअ इश्शा ए होय के जो किबी तिये माहूं आप्योहो, तियामेर्‍योअ आंय किज ने टाकाअहूं देंव, पोन आखरीइ दिही तियां आखाहा जिवाड़ी देहीं. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />काहाके माआं आब्हाअ इश्शा ए होय के जो कोडो बेटाह्हाहा देखे आन तियापोअ विश्वास कोए, तो हादाजल्म्योंअ जिवन मेलवे; आन फाशुउ आंय तियांहां आखरीइ दिहोमेहें जिवते कोअहीं.”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />तियाहा काजे यहुदी तिया पोअ टुटणे वोल्ये, काहाके तिये कोयोतो, “जो रोटू होरगाम रोत उतर्‍यू, तो आंय होय.”<verse eid="JHN 6:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 6:42" />आन तियां कोयो, “केहें ओ योसेफोअ बेटुह्हू ईसु नाहां? ताहां तो कि कोइत कोत सेकेहे के आंय होरगाम रोत उतर्‍युहू?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />ईसु तियांहां उत्तर आप्यो, “तुमा तुमाआंज टुटण्या मा कोअहा. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />कोडोज माआं जागे नाहां आवित सेकतो जाअहूं जाआं आब्हू तियाहा ने हादे, आन आंय तियाहा आखरीइ दिही फाशुउ जिवाड़ीहीं. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />भविश्यवक्ताआ लेख्याम ओं लेख्योहो: ‘तें आखे देवोअहें रोत सिकाअले रोनारे.’ जो कोडो आब्हाप रोत उनाअयो आन सिकाअयोहो, तो माआं जागे आवेहे. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />याआ ओं अर्थ कायनाहां के एखे आब्हाहा देख्युहू; पोन जो देवोअहीं रोत होये, निस्तू तियेज आब्हाहा देख्युहू. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />आंय तुमुहूं खोरीज कोहो के जो कोडो विश्वास कोअहे, हादाजल्म्योंअ जिवन तियाआज होय. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />जिवनोअ रोटू आंय होये. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />तुमाआं वेगाअ डायहां मेहें मान्ना खादो आन तेबी ते मोइत गोया. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />ओ तो रोटू होय, जो होरगाम रोत उतर्‍युहू, जों होरगाम रोत आवल्या या रोटाहा खाये तो ने मोए. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />जिवनोअ रोटू जो होरगाम रोत उतर्‍यू, तो आंय होय. जर एखू या रोटामेहें रोत खाय, ताहां हादाजल्म्योंअ जिवतो रोये; आन जो रोटू आंय दुन्याअ जिवनोअ काजे आपीहीं, तो माआं डिल होये, याज वाअहीं दुन्या जिवती रोये.”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />यी गोठीपोअ यहुद्याहां खोत लागी तियां तियांआंज सोबासोबी ओत गोये, “ओं माहुंउं याअ डिल आपुहूं खायतेहें केहें कोइत आपीत सेकेहे?”<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />ईसु तियांहां कोयो, “आंय तुमुहूं खोरीज कोहो के जाअहूं जाआं तुमू माहुंउं बेटाह्हाअ डिल ने खाहा, आन तियाआ रक्त ने पीहा, ताअहूं जाआं तुमामेहें जिवन नाहां रोनारो. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />जो माआं माहां खाहे आन माआं रक्त पीहे, हादाजल्म्योंअ जिवन तियाआज होय; आन आंय तियाहा आखरीइ दिही फाशुउ जिवाड़ीहीं. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />काहाके माआं डिल हादामक्योज खाअलाअ रोटू होय, आन माआं रक्त हादामक्योज पीइलाअ वस्तू होय. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />जो माआं डिल खाहे आन माआं रक्त पीहे तों मामेहें जिवतो रोहे, आन आंय तियामेहें जिवतु रोहो. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />जेहें कोइत जिवते आब्हे माहूं मोकल्यू, आन आंय आब्हा वाअहीं जिवतु होय, तेहेंज कोइत जों माआं डिल खाये तों माआं वाअहीं जिवतो रोय. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />जो रोटू होरगाम रोत उतर्‍युहू तो ओज होय, जो वेगाअ डायहां खादू आन फासाड़ी ते मोइत गोया; पोन जो या रोटाहा खाये, तो सादा जिवतो रोये.”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />ए गोठी तिये कफर्णहुमोमेहें एका यहुदी आराधनालयोमेहें सिकाड़त्लू तेहेलाम कोयी.<verse eid="JHN 6:59" /></para>
  <para style="s">वारुज सेला ईसुहू सोड़ी देत्ला</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />ईसुउ वारुज सेला ए गोठ उनाइत कोइत कोयो, “ए हिकवोण खुब कठीण होये; यीही कोडो उनाइत सेकेहे?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />ईसु तियाआ मोनोम ओं जांइत कोइत के माआं सेला तियां तियांआंज यी गोठी वाअहीं टुटणीइताहा, तियांहां फुशो, “केहें यी हिकवोणो वाअहीं तुमू टुटणीइताहा के? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />जर तुमू माहुंउं बेटाह्हाहा जिहीं तो पेल ओतू, तिहीं उसे जात्लाहा देखहा, ताहां कि ओवे? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />जो जिवन आपेहे तो आत्मा होये, डिलो वाअहीं किज फायदू कायनाहां; जे गोठी आंय तुमुहूं कोयीही ते आत्मा आन जिवन होये. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />पोन तुमामेहें थोड़ाक एहेलाहा होये, जे विश्वास नाहां कोअता,” काहाके ईसुहू पेलुज मुंदू ओतू के कोडू विश्वास नाहां कोअतू आन कोडू तियाहा तोइत आपनारु होये. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />आन ईसु आगाड़ी कोयो, “तियाहा काजे आंय तुमुहूं कोयोतो के माआं फासाड़ी ताअहूं जाआं कोडोज नाहां आवित सेकतो, जाअहूं जाआं माआं आब्हू तियाहा माआं जागे आविइलाअ परवानगी ने आपे.”<verse eid="JHN 6:65" /></para>
  <para style="s">पेत्राआ विश्वास</para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />यी गोठीपोअ तियाआ सेलामेर्‍याआ वारुज जोंअ फासाड़ी फिरीत वोल्या आन फाश्याआ केदिहींज तियाआ फासाड़ी ने गोया.<verse eid="JHN 6:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67" />ताहरुउ ईसु तियाआ बारु सेलाहां कोयो, “केहें तुमू बी सोड़ीत कोइत जाअहूं होदताहा?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />शिमोन पेत्रे तियाहा उत्तर आप्यो, “प्रभु, आमू कोडाअ जागे जांव? हादाजल्म्याआं जिवनोअ गोठी तोम ताआज जागे होय; <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />आन आमू विश्वास कोअयुहू आन मुंदू ओत गोयुहू के देवोअ पवित्र माहुंउं तो तुज होय.”<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />ईसु तियांहां उत्तर आप्यो, “केहें आंय तुमू बारा जोअहों नाहां निवड़्या? तेबी तुमामेर्‍युउ एक जोउं सैतान होये.” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />ओं तिये शिमोन इस्कार्योतोअ बेटाह्हा यहुदाअ बाप्तिमेहें कोयोतो, काहाके तोज जो बारा जोंअं मेर्‍युउ एक ओतू, जो तियाहा तोइत आपनारु ओतू.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">ईसु आन तियाआ पाही</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />तिहींइं फासाड़ी ईसु गालीलोम फिरतू रोयू; काहाके यहुदी तियाहा माइलाअ फासाड़ी लागाते, तियाहा काजे तो यहुदीयामेहें ने जाअहूं ओतू. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />यहुदीइ मंडपोअ तिवार आहने आवतुतो.<note caller="+" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="LEV 23:34">लेवी 23:34</ref></char></note> <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />तियाहा काजे तियाआ पायहों तियाहा कोयो, “तू ओ जागू सोड़ीत कोइत यहुदीयाम जातु रो, मोन्ज्ये तू कोअहे ओं काम ताआ सेला बी देखीत सेके. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />काहाके जियाअ नाव गाजाड़ीलाअ इश्शा ओय, तों निकाइत कोइत कामे ने कोअत्लो. जर ओं काम तू कोअहे, ताहां सोताहा आखी दुन्यापोअ प्रगट ओव.”<verse eid="JHN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 7:5" />काहाके तियाआ पाही बी तियापोअ विश्वास ने कोअताते.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />ताहां ईसु तियांहां कोयो, “माआं वेल ओमेज नाहांजी आयी, पोन तुमाआं काजे आखी वेल ठीक होये. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />दुन्या तुमाअरी दुस्मोनी नाहां कोइत सेकती, पोन ते माअरी दुस्मोनी कोअहे, काहाके आंय दुन्याअ विरुद्दाम ए साक्शी आपोहो के तियांआं कामे खाराब होये. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />या तिवारोम तुमू जावा; आंय नाहां जातु, काहाके माआं काजे बोराबर वेल नाहांजी आयी.” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />तो तियांहां ए गोठी कोत कोइत गालीलोजमेहें थोबीत गोयू.<verse eid="JHN 7:9" /></para>
  <para style="s">मांडव तिवारोम ईसु</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />पोन जेहेलाम ईसुउ पाही तिवारोम जाता रोया, ताहां तो बी सामनेज नाहां, पोन निकाईत कोइत गोयू. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />यहुदी आधिकारी तिवारोमेहें तियाहा ओं कोत कोइत होदा वोल्या, “तो का होये?”<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />आन माहूंमेहें तियाआ बाप्तिम निकाइ निकाईइ डाहटी गोठी ओवी: थोड़ेक कोतेते, “तो हाजू माटी होये.” आन थोड़हे कोतेते, “नाहां, तो माहुंहूं ठोगेहे.” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />तेबी यहुदी आधिकार्‍योअ बिके वाअहीं कोडोज तियाआ बाप्तिम जोरे ने गोगतोतो.<verse eid="JHN 7:13" /></para>
  <para style="s">तिवारोम ईसुउ शिक्शण</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />जेहेलाम तिवारोअ आरदा दिही वितीत गोया; ताहरुउ ईसु मंदिरोम जात कोइत सिकाड़ु वोल्यू. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />ताहरेए यहुदी बोगलाइत कोइत कोयो, “याहा विण हिक्येज विद्या का रोत आयी?”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />ईसु तियांहां उत्तर आप्यो, “जों आंय सिकाड़ोहो तों माआं वोलेहे रोत नाहां, पोन तों शिक्शण माहूं मोकलीइनारा देवोअहीं रोत होय. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />जर एखो देवोअ ईश्शापोअ सालीइलाअ इश्शा कोअतोय, ताहां तो यी हिकवणोअ बाप्तिमेहें जाईंत लेये के ए देवोअहें रोत होय के आंय माआं मोनोअ कोहो. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />जों सोताआ आधिकारो वाअहीं गोगेहे, तों सोताआ काजे महिमा मेलवुहूं होदेहे; पोन जो तियाहा मोकीलनाराहा महिमा आपुहूं होदेहे, तोज माहुंउं खोरो होये, तियामेहें कोड्लीज खाराबी कायनाहां. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />केहें मोशे तुमुहूं कायदु नाहां आप्यू? तेबी तुमामेर्‍योअ कोडोज कायदापोअ नाहां सालतो. तुमू काहा माहूं माईंलाअ कोशित कोअताहा?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />गर्दी उत्तर आप्यो, “तामेहें सैतान होय, कोडो ताहूं माईलाअ कोशित कोअहे?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />ईसु तियांहां उत्तर आप्यो, “आंय एक काम कोअयो, आन तुमू आखे बोगलाअतेहे. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />तियाहा काजे मोशे तुमुहूं खतना कोइलोअ आदेश आप्युहू, तो मोशेए वोगेहे रोत नाहां, पोन तुमाआं वेगाअ डायहांअहें रोत सालित आयुहू, आन तुमू आरामोअ दिही पोर्‍याआं खतना कोअताहा. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />जाहां आरामोअ दिही माहुंउं खतना कोअतेहे, काहाके मोशेए कायदाअ आदेश टोलीत ने जाअहूं जोवे, ताहां तुमू मापोअ काहा याअकाजे खोत कोअताहा के आंय आरामोअ दिही एका माहुंउं पुरो हुदारी देदो? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />सोब पालित न्याय मा कोअहा, पोन खोरु न्याय कोआ.”<verse eid="JHN 7:24" /></para>
  <para style="s">केहें ओज ख्रिस्त होय?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />तेहेलाम थोड़ेक येरुसालेमवाले कोने वोल्ये, “जियाहा यहुदी आधिकारी माईंत टाकीइलोअ कोशित कोअताहा तो ओज ना? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />पोन पाला, तो आखा माहुंउं विसमेहें गोगेहे आन तें माअहें कीज नाहां कोते, केहें यहुदी पुढाऱ्यों खोरीज जाईंत लेदोहो के ओज ख्रिस्त होय? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />याहा तोम आपू ओलखीइतेहे के ओ काआ होये; पोन ख्रिस्त जेहेलाम आवे ताहां तियाहा कोडोज ने ओलखे के तो का रोत आयुहू.”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />ताहां ईसु मंदिरोमेहें सिकाड़त्लू तेहेलाम आअड़ीत कोयो, “तुमू माहूं ओलखीइतेहे, आन ओ बी जांअतेहे के आंय काआ होये, पोन माहूं मोकलीइनारु खोरु होय, तियाहा तुमू नाहां ओलखीइते. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />आंय तियाहा ओलखोहो काहाके आंय तियाअहींज रोत होय आन तियेज माहूं मोकल्युहू.”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />ताहरेए ते तियाहा तोइत बांदीइलोअ कोशित कोए वोल्ये, पोन कोडोज बी तियापोअ आथ ने टाकीत सेको, काहाके तियाआ वेल ओमेज ने आवयीते. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />तेबी गर्दीमेर्‍येए वारुज माअहें तियापोअ विश्वास कोअयू, आन कोने वोल्‍ये, “ख्रिस्त जेहेलाम आवे ताहां केहें यापरोत वादार समत्कार देखाड़े जे ये देखाड़्या?”<verse eid="JHN 7:31" /></para>
  <para style="s">ईसुहू तोइलोअ कदर</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />तें माअहें की गोठी ईसुउ बाप्तिमेहें कोअतेहे, ए फरिसी उनाअया: आन ते आन डाया पुंजारहां नेहें तियाहा तोइत बांदीइलुउ काजे सिपायड़ाहां मोकल्या. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />ईसु कोयो, “आंय थोड़ीक वाआ जाआं फाशुउ तुमाअरी होये, आन तिहीं रोत वापिस तियाआ जागे जातु रोनारु जिये माहूं मोकल्युहू. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />तुमू माहूं होदहा, पोन आंय तुमुहूं ने जोड़ो; आन जिहीं आंय होय तिहीं तुमू ने आवित सेकहा.”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />ताहरेए यहुदी तियां तियांआंज कोने वोल्ये, “ओ का जानारु होये के आपू याहा ने होदीत सेको? केहें ओ तियांआं जागे जानारु होये, जे युनानीमेहें आपाआ माअहें वेरासेर ओत कोइत रोतेहे, आन ग्रीक बाशामेहें बी सिकाड़े? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />ए की गोठ होय जे तिये कोयी, के ‘तुमू माहूं होदहा, पोन आंय ने जोड़ो; आन जिहीं आंय होय, तुमू तिहीं ने आवित सेकहा?’”<verse eid="JHN 7:36" /></para>
  <para style="s">जिवनोअ पांअयोंअ खाड्यी</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />तिवारोअ आखरीइ दिही, जो मुख्य दिही होय, ईसु उबू रोयू आन आअड़ीत कोइत कोयो, “जर एखू तिहील्यो ओय तो माआं जागे आवुहूं जोवे आन पीइहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="LEV 23:36">लेवी 23:36</ref> </char></note> <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />जो मापोअ विश्वास मिके, जेहलोहो वसनोमेहें कोयोहो, ‘तियाम रोत जिवनोअ पांअयोंअ खाड्यी वोहीत निहे.’”<note caller="+" style="x"><char style="xo" closed="false">7:38 </char><char style="xt" closed="false"><ref loc="EZK 47:1">यहे 47:1</ref>; <ref loc="ZEC 14:8">जख 14:8</ref> </char></note> <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />ईसु ओं आत्माआं बाप्तिमेहें कोयो, जो तियापोअ विश्वास कोअनाराहां जोड़नारु ओतू; काहाके आत्मा ओमे जाआं ने उतर्‍युतो, काहाके ओमे जाआं तियाआ महिमा ने ओवीते.<verse eid="JHN 7:39" /></para>
  <para style="s">माअहूंमेहें टोला</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />ताहरेए गर्दीमेहें रोत कोडे तेबी ए गोठ्यी उनाइत कोइत कोयो, “हुदाअलीज ओ माटी तो भविश्यवक्तू होये.”<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />थोड़ेक माअहें कोयो, “ओज ख्रिस्त होये.”</para>
  <para style="p" vid="JHN 7:41">पोन थोड़ाक जोओं कोयो, “गालीलोम रोत ख्रिस्त केहें कोइत आवित सेकेहे? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />केहें वसनोमेहें ओं नाहां आयो के ख्रिस्त दाविदोअ पारवाडीम रोते आन बेथलेहेम गावोंम रोत आवनारु, जिहीं दाविद रोतुतो?”<note caller="+" style="x"><char style="xo" closed="false">7:42 </char><char style="xt" closed="false"><ref loc="2SA 7:12">2 शमु 7:12</ref>; <ref loc="MIC 5:2">मिखा 5:2</ref> </char></note> <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />ताहरोअ या वाअहीं माअहूंमेहें टोला पोड़्या. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />तियांमेर्‍येए थोड़ेक तियाहा तोइलाअ कोशित कोअतेते, पोन कोडेज तियापोअ आथ ने टाक्यु.<verse eid="JHN 7:44" /></para>
  <para style="s">यहुदी पुढार्‍योंअ अविश्वास</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />ताहराअ मंदिरोअ सिपायी मुख्य पुंजाराआं आन फरिसीइं जागे वोलीत आया; तियां तियांहां कोयो, “तुमू तियाहा काहा नाहां लेताया?”<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />सिपायडां उत्तर आप्यो, “कोड्लेज माहें एहेलिही गोठी नाहां कोअयी, जेहलीही ये कोयी.”<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />या वाअहीं फरिसी तियांहां उत्तर आप्यो, “केहें तिये तुमुहूं बी फोगा बोणावयाहा के? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />केहें आधिकारी नेत फरिसीमेहें रोत एखे तिया पोअ विश्वास कोअयुहू के जियाहा तुमू ओलखीइताहा? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />पोन एं गर्दी जे कायदाहा नाहां जांअती, तियाहा काजे ए हारापोम होये.”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />फरिसी मेर्‍युउ निकुदेमुस<note caller="+" style="x"><char style="xo" closed="false">7:50 </char><char style="xt" closed="false"><ref loc="JHN 3:1">योहान 3:1</ref>,<ref loc="JHN 3:2">2</ref> </char></note> नावोअ एक जोउं ओतू, जो पेल ईसुउ जागे आयुतो, तिये तियांहां कोयो, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“आपाआ कायदाअ पुरमाणे आपू एखा माहुंहूं ताअहूं जाआं दोशी ठरवीत ने सेकत्ला, के जाअहूं जाआं पेल तियाआ उनाइत कोइत जाईंत ने लेय के तिये की कोअयोहो.”<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />तियां तियाहा उत्तर आप्यो, “केहें तू बी गालीलोअ होय? वसनोअ आभ्यास कोअ आन ताहूं देखाय के गालीलोम रोत कोड्लूज भविश्यवक्तू नाहां आवनारु.” <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />ताहराआ तिहीं रोत आक्खा जिव जिवोअ कोअ जाता रोया.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">सिनालाम तोआली बोयोंअ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />पोन ईसु जेयतुन डोगोपोअ गोयू. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />आगल्येए दिहे वेगर्‍युउ सिंजीवड़ाअरीही तो फाशुउ मंदिरोम आयू. आखे माहें तियाआ जागे आये आन तो बोहीत कोइत तियांहां सिकाड़ु वोल्यू. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />ताहराअ कायदाअ मास्तर आन फरिसी एकी बायीही लेताया, जे सिनालामेहें तोआयीते, आन तियीही विसमेहें उबी राखीत ईसुहू कोयो, <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />“गुरु, ए बोईं सिनालो कोअत्लीज सापड़्यीही. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />कायदामेहें मोशे आमुहूं आदेश आप्युहू के एहेली बोईंहीं डोणाट्जा. ताहां तू यी बोईंइ बाप्तिम कि कोहे?” <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />ते तियाहा फोसाड़ीइलोअ काजे ए गोठ कोयी, काहाके तियापोअ दोश लागाड़ीइलोअ काजे एखू गोठ सापड़े. पोन ईसु टुंगू पोड़ीत ईंगाअठी वाअहीं पुंयींपोअ लेखू वोल्यू.<verse eid="JHN 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 8:7" />जेहेलाम ते तियाहा फुशाज कोअताते, ताहां तो होल्लुज उबू रोत कोइत तियांहां कोयो, “तुमामेहें जों पापी ने ओय, तोंज माहुंउं पेल यीही डोण देये.” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />आन फाशुउ तो टुंगू पोड़ीत पुंयींपोअ ईंगाअठी वाअहीं लेखू वोल्यू. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />पोन ते ओं उनाइत कोइत डाये माअहें बाकी एकाअ फाटी एक निहींत गोये, आन ईसु एखलुज रोत गोयू, आन ते बोईं तिहींज उबी रोत गोयी. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />ईसु उबू रोत कोइत तियीही कोयो, “ए बाय, तें आखे का गोये? केहें एखे तापोअ दोश लागाड़्यु?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />तियी बोईं कोयो, “प्रभु, कोडेज नाहां.”</para>
  <para style="p" vid="JHN 8:11">ईसु कोयो, “आंय बी ताहूं डोंडोअ आदेश नाहां आपतू; जा, आन फाशीइ पाप मा कोअही.”<verse eid="JHN 8:11" /></para>
  <para style="s">ईसुउ जिवनोअ उजालो</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />ईसु फाशुउ फरिसीहीं कोयो, “दुन्याअ उजालो आंय होय; जों माआं फासाड़ी आवे, तों आंदारामेहें ने साले, पोन जिवनोअ उजालो तियाहा जोड़े.”<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />फरिसी माट्यों तियाहा कोयो, “तू ताआ साक्शी सोताहा आपेहे, ताआ साक्शी खोरी कायनाहां.”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />ईसु तियांहां उत्तर आप्यो, “भले आंय माआं साक्शी सोताहा आपोहो, तेबी माआं साक्शी खोरी होय, काहाके माहूं मुंदू होय के आंय का रोत आयुहू, आन का जाहो? पोन तुमुहूं ने मुंदू के आंय का रोत आवोहो आन का जाहो. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />तुमू माअहोंअ न्याय शरीरोअ पुरमाणे कोअताहा; आंय कोडाअ न्याय नाहां कोअतू. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />आन जर आंय न्याय कोओ बी, ताहां माआं न्याय खोरु रोय; काहाके आंय एखलुज नाहां, पोन आब्हू जिये माहूं मोकल्युहू तो माअरी होये. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />तुमाआं कायदामेहें बी लेख्योहो के बेन जोओंअ साक्शी मिलीत कोइत खोरी ठरेहे; <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />एक तोम आंय सोताहा माआं साक्शी आपोहो, आन बिहीरु आब्हू माआं साक्शी आपेहे जिये माहूं मोकल्युहू.”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />तियां तियाहा कोयो, “ताआ आब्हू का होय?”</para>
  <para style="p" vid="JHN 8:19">ईसु उत्तर आप्यो, “नाहां तुमू माहूं ओलखीइता, नाहां आब्हाहा जर तुमू माहूं ओलखीइता ताहां आब्हाहा बी ओलखीइता.”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />ए गोठी ईसु मंदिरोम सिकाडतु जात एकी खुलीमेहें कोयी, जिहीं अर्पणोअ पेटी मेक्यीते.आन कोडेज तियाहा ने तोअयु, काहाके तियाआ वेल ओमे जाआं ने आयीते.<verse eid="JHN 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />फाशोअ ईसु तियांहां कोयो, “आंय जातु रोहीं, आन तुमू माहूं होदहा, पोन तुमू तुमाआं पापोमेहें मोअहा; जिहीं आंय जाहो, तिहीं तुमू नाहां आवित सेकते.”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />ताहां यहुदी आधिकार्‍यों कोयो, “केहें विसार कोअताहा के तो सोताहा मोइत जानारु ओये, जो कोहे के, ‘जिहीं आंय जाहो तिहीं तुमू नाहां आवित सेकते?’”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />ईसु तियांहां कोयो, “तुमू निसेए होय, पोन आंय उसेए होय; तुमू यी दुन्याम रोत होये, आंय यी दुन्याम रोत कायनाहां. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />तियाहा काजे आंय तुमुहूं कोयो, के तुमू तुमाआं पापोमेहें मोअहा, काहाके जर तुमू विश्वास नाहां कोअता के ‘आंय जो होय तोज होय,’ ताहां तुमू तुमाआं पापोमेहें मोअहा.”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />तियां तियाहा फुशो, “तू कोडू होय?” ईसु तियांहां उत्तर आप्यो, “तोज होंव जो सुरुवातिही रोत तुमुहूं कोतू आयुहू. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />माआं तुमुहूं वारुज गोठी कोअलोअ, आन वारुज गोठीइ निर्णय कोइलो होये; पोन माहूं मोकलीइनारु खोरु होय, आन आंय जो तिया पोअ रोत उनाअयुहू तोज दुन्याहा कोहो.”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />तियांहां ओं ने समजाअयो के ईसु तियांहां आब्हाआ बाप्तिमेहें कोहे. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />ताहां ईसु तियांहां कोयो, “जेहेलाम तुमू माहुंउं बेटाह्हाहा उसे सोढवाहा, तेहेलाम तुमू जाईंत लेहा के ‘आंय जो होय तोज होंव,’ ताहां तुमू सोताहाज जाईंत लेहा के आंय माआं सोताआ आधिकार वाअहीं कीज नाहां कोअतू, पोन आंय जेहलोहो माआं आब्हे माहूं सिकाड़्युहू तेहलोज कोहो. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />आन माहूं मोकलीइनारु माअरी होय; तिये माहूं एखलू नाहां सोड़्यु, काहाके आंय सादा तोंज काम कोअहो जों तियाहा पोटेहे.”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />तो ए गोठी कोयाज कोअतुतो के डाहटे जोएं तिया पोअ विश्वास कोअयू.<verse eid="JHN 8:30" /></para>
  <para style="s">सत्य तुमुहूं मोकले कोए</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />ताहरुउ ईसु तियापोअ विश्वास कोअनारा तियां यहुदीही कोयो, “तुमू माआं वसनोमेहें रोहा, ताहां हादामक्याज माआं सेला ठरहा. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />तुमू सत्याहा ओलखाहा, आन सत्य तुमाआं सुटका कोए.”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />तियां ईसुहू उत्तर आप्यो, “आमू ते अब्राहामोअ पारवाड़ीइ होये, आन केदिहीं कोडाआज नोवकर नाहां बोण्या. ताहरुउ तू कि कोइत कोहे के तुमू मोकला ओत जाहा?”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />ईसु तियांहां कोयो, “आंय तुमुहूं खोरीज कोहो के जो कोडो पाप कोअहे, तो पापोअ नोवकर होये. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />कोडू बी नोवकर सादा कोअमेहें नाहां रोतू; फक्त बेटुह्हू सादाज रोहे. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />तियाहा काजे जर बेटुह्हू तुमुहूं मोकलू कोए, ताहां हादामक्याज तुमू मोकला ओत जाहा. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />माहूं मुंदू होये के तुमू अब्राहामोअ पारवाड़ीइ होये; तेबी माआं वसनोहो तुमाआं मोनोमेहें जागू नाहां जोड़तू, तियाहा काजे तुमू माहूं माईंत टाकीइलोअ कोशित कोअताहा. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />आंय तोंज कोहो, जो माआं बाह्हाआ जागे देख्योहो; आन तुमू तोंज कोअतेहे, जो तुमू तुमाआं बाह्हाप रोत उनाअयेहे.”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />तियां तियाहा उत्तर आप्यो, “आमाआं आब्हू तोम अब्राहाम होय.” ईसु तियांहां कोयो, “जर तुमू अब्राहामोअ पोर्‍या रोता, ताहां अब्राहामोअ होस काम कोअता. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />पोन ओमे तुमू माआं सारका माहुंहूं माईंत टाकीइलोअ कोअताहा, के ये तुमुहूं तों खोरो वसन कोताप्यो, जों देवोअहें रोत उनाअयू; एहेलोह ते अब्राहाम ने कोअयोतो. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />तुमू तुमाआं बाह्हाअ होस काम कोअताहा.”</para>
  <para style="p" vid="JHN 8:41">तियां तियाहा कोयो, “आमू सिनालोअ नाहां उबज्या, आमाआं एक आब्हू होये मोन्जे देव.”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />ईसु तियांहां कोयो, “जर देव तुमाआं आब्हू रोतु, ताहां तुमू मापोअ मेर कोअता; काहाके आंय देवोअहें रोत आयुहू. आंय माआं आधिकारो वाअहीं नाहां आयू, पोन तियेज माहूं मोकल्यू. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />तुमू माआं गोठीही काहा नाहां समजीइता? याअ काजे के तुमू माआं वसन उनाइत नाहां सेकता. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />तुमू तुमाआं आब्हा सैतानोअ पोर्‍या होये आन तुमाआं आब्हाआ ईश्शाहा पुरी कोअहूं होदताहा. तो ते सुरुवाती रोतुज खुनी होये, आन सत्या पोअ मजबुत नाहां रोयू, काहाके सत्य तियामेहें कायनाहां. जाहां तो ठोगेहे, ताहां तो तियाआ सोभावो वाअहींज गोगेहे; काहाके तो ठोग होय आन ठोगोअ आब्हू होय. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />पोन आंय जो खोरो कोहो, तियाहाज काजे तुमू माआं विश्वास नाहां कोअता. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />तुमामेर्‍योअ कोडो माहूं पापी ओवीइलाआ दोश लागाड़ेहे? जर आंय खोरो कोहो, ताहां तुमू माआं विश्वास काहा नाहां कोअता? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />जो देवोअहें रोत होये, तो देवोअ गोठी उनाअहे; आन तुमू याअकाजे नाहां उनाअता काहाके देवोअहें रोत कायनाहां.”<verse eid="JHN 8:47" /></para>
  <para style="s">सोताआ बाप्तिम ईसुउ कबुली</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />यहुद्यां तियाहा कोयो, “केहें आमू बोराबर ने कोताते के तू शोमरोन वालू होये, आन तामेहें पुत होये?”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />ईसु उत्तर आप्यो, “मामेहें पुतोअ आत्मा कायनाहां; पोन आंय तोम माआं आब्हाअ मानपान कोअहो, आन तुमू माआं अपमान कोअतेहे. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />पोन आंय माआं आदर नाहां कोअतू; होव, एक होय जो इतवेहे आन न्याय बी कोअहे. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />आंय तुमुहूं खोरीज कोहो, जर एखु माहुंउं माआं हिकवोण माने, तो केदिहींज ने मोए.”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />यहुदी तियाहा कोयो, “ओमे आमू जाइंत लेदो के तामेहें हुदाअलीज पुतोअ आत्मा होये. तेतोज नाहां पोन अब्राहाम मोइत गोयू, आन भविश्यवक्ता बी मोइत गोया; आन तू कोहे, ‘जर एखु माआं हिकवोण लेत साले, ताहां तो मोतोअ होवाद केदिहींज ने साके.’ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />आमाआं आब्हू अब्राहाम तोम मोइत गोयू. केहें तू तियाआ रोत वोडू होय कोत पुरावू कोअहे? आन भविश्यवक्तां बी मोइत गोया. तू सोताहा कि समजेहे?”<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />ईसु उत्तर आप्यो, “जर आंय सोताआ महिमा कोओ, ताहां माआं महिमा किज नाहां;पोन माआं महिमा कोअनारु माआं आब्हू होय, जियाहा कोतेहे के तो आमाआं देव होय. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />तुमू तोम तियाहा केदिहींज नाहां ओलख्यु: पोन आंय तियाहा ओलखोहो. जर आंय कोंव के आंय तियाहा नाहां ओलखीइतू, ताहां आंय तुमाआं होस ठोग ठरिहीं; पोन आंय तियाहा ओलखोहो आन तियाआ शब्दा पोअ सालोहो. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />तुमाआं आब्हू अब्राहाम माआं दिही देखीइलाअ आशा वाअहीं खुब खुस ओतू; आन तिये देख्यू आन खुसी कोअयी.”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />यहुदी तियाहा कोयो, “ओमेज तू पोन्नास वोरह्योअ जाआं नाहां, तेबी तुमे अब्राहामोअ देखीत लेदू?”<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />ईसु तियांहां कोयो, “आंय तुमुहूं खोराखोर कोहो के, अब्राहामोअ उबजीइलाअ पेल आंय होंव.”<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />ताहरेए ते तियाहा माईलाअ काजे डोणे विशे, पोन ईसु निकाइत कोइत मंदिरोमेहें रोत निहींत गोयू.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">ईसुउ जल्मार्‍याअ आंदला माहुंहूं हुदारीइलो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />सालता सालतामेहें तिये एका माहुंहूं देख्यो, जो जल्मार्‍योओज आंद्लो ओतो. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />तियाआ सेला तियाहा फुशो, “गुरु, कोडे पाप कोअयुतो के ओं आंद्लो उबज्यो, ये के याअ आयहीन आब्हे?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />ईसु उत्तर आप्यो, “ये नाहां पाप कोअयू, नाहां याअ आयहीन आब्हू; पोन ओं याअकाजे ओवोहो के देवोअ काम यामेहें रोत देखाअहूं जोवे. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />जिये माहूं मोकल्युहू, आपुहूं तियाआ काम दिही होय ताअहूं कोइलाआ जरुरी होय; ते रात आवनारी होये, जियीमेहें कोडोज काम ने कोइत सेकनारो. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />जाअहूं जाआं आंय दुन्यामेहें होय, ताअहूं जाआं आंय दुन्याअ उजालो होय.”<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />ओं कोत कोइत तिये पुयींपोअ थुप्यो, आन तिया थुपोवाअहीं कादुउ केलव्यू, आन तो कादुउ तिया आंद्लाआ डोआपोअ लागाड़ीत कोइते, <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />तियाहा कोयो, “जा, सिलोहोअ कुंडीमेहें तुवीत ले.” सिलोहोअ अर्थ होय “मोकलीइल्यू.” तिये जात कोइत डोआ तुव्या आन पालतूज वोलीत आवयू.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />ताहां आहने रोनारें आन जियां पेल तियाहा बिख मागत्लू पाल्युतो, तें कोने वोल्ये, “केहें ओ तोज नाहां के, जो बोठ बोठू बिख मांग्या कोअतुतो?”<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />थोड़हे माअहें कोयो, “ओ तोज होय,” बिहीरे कोयो, “नाहां पोन तियाआ सारकुज होये.”</para>
  <para style="p" vid="JHN 9:9">तिये कोयो, “आंय तोज माटी होये.”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />ताहरेए ते तियाहा फुसे वोल्ये, “ताआ डोआ कि कोइत उगड़्या?”<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />तिये उत्तर आप्यो, “ईसु नावोअ एक माहुंउं कादुउ केलवीइल्यू, आन माआं डोआपोअ लागाड़ीत कोइत कोल्यो, ‘सिलोहोमेहें जात कोइत तुवीत ले,’ ताहरुउ आंय गोयू आन तुवया ताहां देखाओ वोल्यो.”<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />तियां तियाहा फुशो, “तो का होये?”</para>
  <para style="p" vid="JHN 9:12">तिये कोयो, “माहूं ने मुंदू.”<verse eid="JHN 9:12" /></para>
  <para style="s">नेरायीइ बाप्तिम तापास कोअनारा फरिसी</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />एक माहुंउं जों पेल आंद्लो ओतो, तियाहा माहें फरिसीइ जागे लेत गोये. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />जेदिहीं ईसु कादुउ पिगवीत हाऱ्यु आन तियाआ डोआ उगाड़्याते, तो आरामोअ दिही ओतू. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />ताहराअ फरिसी फाश्याआ एकवारी तियाहा फुशो के, “ताआ डोआ कि कोइत उगड़ीत गोया?” तिये तियांहां उत्तर आप्यो, “तिये माआं डोआपोअ कादुउ पिगवीत लागाड़्यु, ताहरुउ आंय तुवीत लेदो, आन ओमे देखोहो.”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />यापोअ थोड़ाक फरिसी कोना वोल्या, “ओं माहुंउं देवोअहें रोत नाहां, काहाके तों आरामोअ दिही नाहां पालतो.”</para>
  <para style="p" vid="JHN 9:16">बिहीरा कोयो, “पापी माहुंउं एहेलाहा समत्कार कि कोइत देखाड़ीत सेकेहे?” ताहां तियांमेहें टोला पोड़ीत गोया.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />तियां तिया आंदलाहा फाशोअ कोयो, “तिये ताआ डोआ उगाड़्याहा ठीक होय, पोन तू तियाआ बाप्तिम कि कोहे?” तिये कोयो, “तो भविश्यवक्तू होय.”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />पोन यहुद्याहां विश्वास ने बोहतुतो के तो आंदलु ओतू आन ओमे पालु वोल्युहू, ताहरोअ तियां जियाआ डोआ उगड़ीत गोया तियाआ आयहीन आब्हाहा हादीत कोइत फुशो. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />“केहें ओ तुमाआं पोर्‍यू होये, जियाहा तुमू कोतेहे के आंदलु उबज्युतो? ताहरुउ ओमे ओ केहें कोइत देखेहे?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />तियाआ आयहीन आब्हे उत्तर आप्यो, “आमुहूं मुंदू होये के ओ आमाआं पोर्‍यू होये, आन आंदलु उबज्युतो; <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />पोन आमुहूं ओं ने मुंदू के ओमे ओ कि कोइत पालेहे, आन ओं बी ने मुंदू के याअ डोआ कोडे उगाड़्या. तो जांअतू होये, याहाज फुसीत ल्या; ओ याअ बाप्तिम सोताहा कोत देये.” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />ए गोठी तियाआ आयहीन आब्हे याअ कोअते कोयी काहाके तें यहुद्याहां बितेते, काहाके यहुद्याआं एकमत ओत गोयोतो के जर एखु कोये के तो ख्रिस्त होये, ताहां तियाहा यहुदी आराधनालयोमेहें रोत काडी देअलो. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />तिहींज वाअहीं तियाआ आयहीन आब्हे कोयो, “तो जांअतू होय, तियाहाज फुसीत ल्या.”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />ताहराअ तियां तिया माहुंहूं जो आंदलो ओतो, बिहीरी वारी हादीत कोइत कोयो, “देवोअ स्तुती कोअ. आमुहूं ते मुंदू होय के तो माटी पापी होये.”<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />तिये उत्तर आप्यो, “माहूं ने मुंदू के तो पापी होय के नाहां; माहूं ते एक गोठ मुंदू होये के आंय आंदलू ओतू आन ओमे माहूं देखाअहे.”<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />तियां तियाहा फाशोअ फुशो, “तिये ताअरी कि कोअयो? आन कि कोइत ताआ डोआ उगाड़्या?”<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />तिये तियांहां कोयो, “आंय ते तुमुहूं कोत देदो, आन तुमू ने उनाअया; ओमे बिहीरी वारी काहा उनाइलाआ इश्शा कोअताहा? केहें तुमू बी तियाआ सेला बोणुहूं होदताहा के?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />ताहां तियाहा डाणवित कोयो, “तुज तियाआ सेलू होये, आमू ते मोशेए सेला होये. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />आमुहूं मुंदू होय के देवे मोशेएरी गोठी कोअयी; पोन या माहुंहूं आमू ने ओलखीइत्ला के कावालो होये.”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />तिये तियांहां उत्तर आप्यो, “एते बोगलाअहूं हारकी गोठ होये के तुमू ने ओलखीइत्ला के तो कावालू होये, तेबी तिये माआं डोआ उगाड़ी देदा. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />आमुहूं मुंदू होय के देव पाप्योंअ नाहां उनाअतू, जो देवोअ भक्ती कोअहे आन तियाआ इश्शा पोअ सालेहे, ताहां तो तियाआ उनाअहे. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />कोलीइ सुरुवातिही रोते ओं केदिहींज कानोम नाहां पोड़्यो के एखू जल्मार्‍याअ आंद्लाआ डोआ उगाड़्याये. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />जर ओं माहुंउं देवोअहें रोत ने रोतो, ताहां किज ने कोइत सेकतो.”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />तियां तियाहा उत्तर आप्यो, “तू ते निस्तू पापोमेहें उबज्युहू, तू आमुहूं कि सिकाड़त्लू?” आन तियां तियाहा बारथे काडी देदू.<verse eid="JHN 9:34" /></para>
  <para style="s">आत्मिक आंद्लाय</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />ईसु उनाअयू के यहुदी आधिकार्‍यों तियाहा ठेपलीत बारथे काडी देदुहू, आन जेहेलाम तो तियाहा मिल्यू, ताहां कोयो, “केहें तू माहुंउं बेटाह्हापोअ विश्वास कोअहे?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />तिये उत्तर आप्यो, “प्रभु, तो कोडू होये माहूं को, के आंय तियापोअ विश्वास कोइत सेको?”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />ईसु तियाहा कोयो, “तू तियाहा पाल्युहू बी, आन जो ताअरी गोठी कोअया कोअहे तो तोज होये.”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />तिये कोयो, “प्रभु, आंय विश्वास कोअहो.” आन तो तियाआ पागे पोड़्यू.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />ताहरुउ ईसु कोयो, “आंय यी दुन्यामेहें न्यायनिवाड़ाअ काजे आयुहू, काहाके जें नाहां देखते तें देखे, आन जें देखतेहे तें आंदले ओत जाय.”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />थोड़ाक जे फरिसी तियाअरी ओता, तियां ए गोठी उनाइत कोइत तियाहा कोयो, “केहें, ताहराआ आमू बी आंदला ए?”<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />ईसु तियांहां कोयो, “जर तुमू आंदला रोता ताहां पापी ने ठरता; पोन ओमे कोताहा के आमू देखताहा, तियाहा काजे तुमाआं पाप होय तेहलुज रोहे.”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">सारवाली आन तियाआ मेडाआं गोवारु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />ईसु कोयो, “आंय तुमुहूं खोरीज कोहो के जो कोडो बाअणाअहें रोत मेडाअ वाड़गामेहें नाहां फोहतो, पोन बिहीरीज वाटे रोत फोहेहे, तों बांड आन डाखू होय. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />पोन जो बाअणाअहें रोत मायते सिदी वाटे फोहेहे तो मेडाआं सारवाली होय. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />तियाआ काजे बाअणाअ राखवाली बाअणो उगाड़ी देहे, आन मेडे तियाआ आवाज उनाअतेहें, तो तियाआ मेडाहां नाव लेत कोइत हादेहे आन बारथे लेत जाहे. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />जेहेलाम तो तियाआ मेडाहां बारथे काडीत लेत जाहे, तेहेलाम तो तियांआं आगाड़ी आगाड़ी सालेहे, आन मेडे तियाआ फासाड़ी फासाड़ी सालतेहे, काहाके तें तियाआ आवाज ओलखीइतेहें. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />पोन ते ओजाण्याअ फासाड़ी ने जाय, पोन तेहेला माहुंउं जागे रोत सेटे जाते रोय, काहाके तें ओजाण्याअ आवाज नाहां ओलखीइते.”<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />ईसु तियांहां ए काईं कोत आप्यी, पोन तियांहां ते ने समजाअयी के ए कि गोठी होये.<verse eid="JHN 10:6" /></para>
  <para style="s">हाजु सारवाली ईसु</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />ताहरुउ ईसु तियांहां फाशुउ कोयो, “आंय तुमुहूं खोरीज कोहो, मेडाअ बाअणो आंय होय. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />जेत्ता बी मारोत पेल आया ते आखा बांड आन डाखू होये, पोन मेडे तियांआं आवाज नाहां उनाअये. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />बाअणो आंय होय; जर एखो मा वाअहीं मायते फोहे, ताहां तियाहा तारण जोड़े, आन तो मायतेन बारथे आव-जाव कोए आन तियाहा सारु जोड़े. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />बांड कोड्ला बिहीरा कामोअ काजे नाहां, पोन निस्तु सोरी कोइलो आन माइलो आन आरवीइलाअ कोअते आवेहे; आंय याअ काजे आयुहू के तियांहां जिवन मिले, आन खुब वादार मिले. <figure style="fig" alt="Shepherd with his sheep in sheepfold" file="LB00014C.TIF" size="span" copy="Horace Knowles ©" ref="10:7">मेडाआ वाड़गाम मेडाआ सारवाली</figure><verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />“हाजू सारवाली आंय होय; हाजू सारवाली मेडाअ कोअते तियाआ जिव आपेहे. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />पावर जो नाहां सारवाली होय आन नाहां मेडाअ मालिख होय, कोलवाहा आवत्लाहा देखीत मेडाहां सोड़ीत कोइत नाहींत जाहे; आन कोल्वू तियांहां तोइत आरजा-बुरजी कोई देहे. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />तो याअ काजे नाहींत जाहे काहाके तो एक मोजुर होय, आन तियाहा मेडाअ सिंता कायनाहां.<verse eid="JHN 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14" />“हाजू सारवाली आंय होये; आंय माआं मेडाहां ओलखोहो, आन माआं मेडे माहूं ओलखीइतेहें. <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />जेहें कोइत आब्हू माहूं ओलखेहे आन आंय आब्हाहा ओलखोहो आन आंय माआं मेडाआं काजे माआं जिव आपोहो. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />माआं फाशेए बी मेडे होये, जें या मेडाआं वाड़गामेर्‍येए कायनाहां, माहूं तियांहां बी लेतावीइलो गरज होय. तें बी माआं आवाज उनाये, आन याज मेडाअ वाड़गामेहें आवित एक्कुज गोवारु ओत जाय, आन एक्कुज सारवाली रोये.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />“आब्हू याअकाजे मापोअ मेर कोअहे के आंय माआं जिव आपीइलो काजे तियार होय, मोन्ज्ये आंय तियाहा फाशुउ वापिस लेत लेंव. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />माआं जिव कोडो बी मापोअ रोत नाहां बुउसीइतो, पोन आंय सोताहा माआं इश्शा वाअहीं तो आपोहो. माहूं तो आपीइलोअ बी आधिकार होय, आन फाशुउ लेअलोअ बी आधिकार होये. ओ आदेश माहूं माआं आब्हापोअ रोत जोड़्युहू.”<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />ताहां यां शब्दाअ वाखरी यहुदी माअहूंमेहें फाश्याआ टोला पोड़्या. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />तियां मेर्‍येए वारुज जोएं कोने वोल्‍ये, “तियामेहें पुतोअ आत्मा होये, आन तो गांडू होये; तियाआ काहा उनाअतेहे?”<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />पोन बिहीरे माअहें कोने वोल्ये, “ए गोठी कोडा एहेलाहा माहुंउं नाहां, जियाम पुतोअ आत्मा बोठूये. पुतोअ आत्मा एखा आंद्लाआ डोआ केहें कोइत उगाड़ीत सेकेहे?”<verse eid="JHN 10:21" /></para>
  <para style="s">यहुद्याआं अविश्वास</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />येरुसालेमोमेहें अर्पणोअ तिवार कोअतेते; आन ते हियालाआ दिही ओता. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />ईसु मंदिरोम शलमोनोअ ओटापोअ फिर्‍या कोअतुतो. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />ताहरेए यहुदी आवित कोइत तियाहा शारु सोमकीर केंडीत फुशो, “तू आमाआं मोनोहो कोयों जाआं बेन भरिवसे मिकनारु? जर तू ख्रिस्त होय ताहां आमुहूं सिदु सिदु कोत दे.”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />ईसु तियांहां उत्तर आप्यो, “आंय तुमुहूं पेलुज कोत देदो, पोन तुमू विश्वास नाहां कोअता. जें कामें आंय माआं आब्हाअ नावसे कोअहो, तेंज माआं साक्शी होये, <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />पोन तुमू याअकाजे विश्वास नाहां कोअता, काहाके तुमू माआं मेडामेएं कायनाहां. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />माआं मेडें माआं आवाज उनाअतेहें; आंय तियांहां ओलखोहो, आन तें माआं फासाड़ी फासाड़ी सालतेहें; <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />आन आंय तियांहां हादाजल्म्योंअ जिवन आपोहो. ते केदिहींज ने आरवाय, आन कोडो माआं आथोम रोत ने बुउसे. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />माआं आब्हू, जिये तियांहां माहूं आप्येहे, तो आखा रोत वोडु होये, आन कोडोज तियांहां आब्हाआ आथोम रोत बुउसीत नाहां सेकतो. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />आंयेन आब्हू एक होय.”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />तिहीं रोत यहुदी माअहूं तियाहा डोणोवाअहीं देअलोअ काजे फाशे डोणे विशे.<verse eid="JHN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 10:32" />ईसु कोयो, “आंय तुमुहूं माआं आब्हाअ तरफ से जाअखीलेहे हाजे कामे देखाड़्येहे; तियांमेर्‍याअ कोड्ला कामोअ काजे तुमू माहूं डोणाट्टेहे?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />यहुद्यां तियाहा उत्तर आप्यो, “हाजा कामोंअ काजे आमू ताहूं नाहां डोणाट्टा, पोन देवोअ अपमान कोइलाआ वाखरी; आन याअकाजे के तू मोनवी ओत कोइत बी सोताहा देव कोवडावेहे.”<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />ईसु तियांहां उत्तर आप्यो, “तुमाआं कायदामेहें लेखल्यो कायनाहां, के ‘मी कोयो, तुमू देव होये?’<note caller="+" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="PSA 82:6">भजन 82:6</ref></char></note> <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />जर तिये तियांहां देव कोयो जियांआं जागे देवोअ वसन पोत्यो आन वसनोअ गोठ ठोगोअ नाहां ओत सेकती, <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />ताहां जियाहा आब्हे पवित्र ठरवीत कोइत दुन्यामेहें मोकल्युहू, तुमू तियाहा कोताहा, ‘तू निंदा कोअहे,’ याअकाजे के आंय कोयो, ‘आंय देवोअ बेटुह्हू होये?’ <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />जर आंय माआं आब्हाअ काम नाहां कोअतू, ताहां मापोअ विश्वास मा कोअहा. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />पोन जर आंय कोअहो, तांहा माआं विश्वास नाहांज बी कोअता, पोन तियां कामोअ तेबी विश्वास कोआ, तुमू जाअहूं आन समजुहूं जोवे के आब्हू मामेहें होय आन आंय आब्हामेहें होंव.”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />ताहां तियां फाशेए तियाहा तोइलाअ कोशित कोअयी, पोन तो तियांआं आथोम रोत निहींटीत गोयू.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />ताहरुउ ईसु यारदेन खाडीइ तियी मेरे तिया जागापोअ जातु रोयू, जिहीं योहान पेल बाप्तिस्मा आप्या कोअतुतो, आन तिहींज रोयू. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />वारुज माहें तियाआ जागे आवित कोइत कोतेते, “योहाने ते कोड्लूज समत्कार ने देखाड़्यू, पोन जों किबी योहाने याअ बाप्तिमेहें कोयोतो, तों आखो खोरो निहींयो.” <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />आन तिहीं जाअखीलेहे जोएं ईसु पोअ विश्वास कोअयू.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">लाजरोअ मोयात</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />मरिया आन तियीइ बोअह्हीं मार्थाआ गांव बेथानीमेहें लाजर नावोअ एक माटी मांदवाड़्यू ओतू. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />ए तेज मरिया ओती जियी प्रभु पोअ अत्तर टाकीत कोइत तियाआ गुडाहा तियीइ सिंग्यां वाअहीं पुशाते, यीइज पाही लाजर बिमार ओतू. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />तियाआ बोअह्हीं तियाहा कोत मोकल्यो, “प्रभु, देख, ताआ तो मेरालू दोस्ती बिमार होये.”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />ओं उनाइत कोइत ईसु कोयो, “ए बिमारी मोतोअ नाहां; पोन देवोअ महिमाआं काजे होये, के तियी वाअहीं देवोअ बेटाह्हाअ महिमा ओवुहूं जोवे.”<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />ईसु मार्था आन तियीइ बोअह्हीं आन लाजरोपोअ मेर कोअतुतो. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />तेबी जेहेलाम तिये होंबल्यो के लाजर बिमार होय, ताहां जियी जागे तो ओतू, तिहीं फाशुउ बेन दिही रुकाइत गोयू. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />याअ फासाड़ी तिये सेलाहां कोयो, “आवा, आपू फाशाआ यहुदीयामेहें जाता.”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />सेलां ईसुहू कोयो, “गुरु, ओमेज ते यहुदी माटी ताहूं डोणाटीइलाअ कोशित कोअयीते, आन केहें तू फाशुउ बी तिहींज वापिस जाअहूं होदेहे?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />ईसु उत्तर आप्यो, “केहें दिहोअ बारा तास नाहां रोता के? जर एखु दिहोअ उजालामेहें सालेहे तो नाहां ठोकाअतू, काहाके यी कोलीइ उजालो देखेहे. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />पोन जर एखु राती सालेहे, ताहां तो ठोकाअहे, काहाके तिया मेहें उजालो कायनाहां.”<verse eid="JHN 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 11:11" />तिये ए गोठी कोयी, आन याअ फासाड़ी तियांहां कोनु वोल्यू, “आपाअ दोस्ती लाजर हुवीत गोयुहू, पोन आंय तियाहा जागाड़ू जाहो.”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />ताहां सेला तियाहा कोयो, “प्रभु, जर तो हुवीत गोयू ओय, ताहां हाजू ओत जाये.”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />ईसु ते तियाआ मोतोअ बाप्तिमेहें कोयोतो, पोन सेलां समज्यो के तिये निंदेए बाप्तिम कोयोहो. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />ताहरुउ ईसु तियांहां सिदो सिदो कोत देदो, “लाजर मोइत गोयुहू; <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />आन आंय तुमाआं वाखरी खुसीम होय काहाके आंय तियाआ जागे ने ओतू मोन्ज्ये तुमू विश्वास कोइत सेकहा. पोन ओमे आवा, आपू तियाआ जागे जात्ला.”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />ताहां थोमे जियाहा दिदमुस कोतेहे, तिये तियाअरीइ हेंगात्या सेलाहां कोयो, “आवा, आपू बी प्रभुअरी मोआ जाता.”<verse eid="JHN 11:16" /></para>
  <para style="s">ईसुउ पुनरुत्थान आन जिवन</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />जेहेलाम ते तिहीं पोता, तेहेलाम ईसुहू ए खबर जोड़्यी के लाजरोहो माहणोमेहें मेकल्याहा शार दिही ओत गोयाहा. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />बेथानी येरुसालेमोअ रोत तिन किलो मिटर एतोहो सेटे ओतो. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />वारुज यहुदी मार्था आन मरियाअ जागे तियींइं पायहोअ मोयातीपोअ विखे बोहे आयेते.<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />जेहेलाम मार्था ईसुउ आविइलाअ खबर उनाअयी ताहां तियाहा मिलीइलोअ काजे बारथे गोयी, पोन मरिया कोअमेहें बोहीत रोयी. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />मार्था ईसुहू कोयो, “प्रभु, जर तू इंहीं रोतू, ताहां माआं पाही केहेंनेत ने मोअतू! <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />पोन ओमे बी माहूं मुंदू होय, के जों किबी तू देवोपोअ रोत मागही, तों देव ताहूं आपे.”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />ईसु तियीही कोयो, “ताआ पाही फाशुउ जिवीत उठे.”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />मार्था तियाहा कोयो, “माहूं मुंदू होय के आखरीइ दिहोमेहें पुनरुत्थानोअ होमसे तो जिवीत उठे.”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />ईसु तियीही कोयो, “पुनरुत्थान आन जिवन आंयेंज होय; जो कोडो मापोअ विश्वास कोअहे तों जर मोइत बी जाय तेबी जिवे, <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />आन जों कोडो जिवतो होय आन मापोअ विश्वास कोअहे, तों केदिहींज ने मोए. केहें तू यी गोठी पोअ विश्वास कोअहे?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />तियी तियाहा कोयो, “होव प्रभु, आंय विश्वास कोअहो के देवोअ बेटुह्हू ख्रिस्त जो दुन्यामेहें आवनारु ओतू, तो तुज होय.”<verse eid="JHN 11:27" /></para>
  <para style="s">ईसु रोड़्यु</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />ओं कोत कोइत ते जाती रोयी, आन तियीइ बोअह्हीं मरियाहा हादीत कोइत एखलीहीज हादीत कोयो, “गुरु इंहींज होये आन तिये ताहूं हाद्यीही.” <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />जाहां मरिया ओं उनाअयी, तेहेलाम ते ताबुड़ उठीत कोइत तियाआ जागे आयी. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />ईसु ओमेज गांवोंमेहें ने पोतुतो, पोन तियीज जागे ओतू जिहीं मार्था तियाहा मिल्यीते. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />ताहरेए जे यहुदी तियीइरी कोअमेहें ओते आन तियीही होमजाड़तेते, ओं देखीत कोइत के मरिया ताबुड़ उठीत कोइत बारथे गोयीही ओं समज्यो के ते कबरे पोअ रोड़ी जाहे, ताहां तियीइ फासाड़ी गोये.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />जेहेलाम मरिया तिहीं पोती, जिहीं ईसु ओतू, ताहां तियाहा देखतीज कोइत तियाआ गुडाअहीं बोहीत पोड़्यी आन कोयो, “प्रभु, जर तू इंहीं रोतु ताहां माआं पाही ने मोअतू.”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />जेहेलाम ईसु तियीही आन तियां यहुदीही जें तियीइरी आयेते, रोड़त्ले देख्ये, ताहां आत्मामेहें खुब उदास आन दुखी ओवू, <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />आन कोयो, “तुमू तियाहा का मिक्युहू?”</para>
  <para style="p" vid="JHN 11:34">तियां तियाहा कोयो, “प्रभु, जात कोइत पालीत ले.”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />ईसु रोड़्यु. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />ताहां यहुदी कोने वोल्ये, “पालाते लाजरोपोअ केतीही मेर कोअतुतो.”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />पोन तियांमेर्‍याआ थोड़ाक जोओं कोयो, “ओ माटी जिये आंद्लाआ डोआ उगाड़्या, ये लाजरोहो बी मोइला रोत वासाड़ीत केहें ने सेकू?”<verse eid="JHN 11:37" /></para>
  <para style="s">ईसुउ लाजरोहो जिवाड़ीइलो</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />ईसु मोनोमेहें फाशुउ जास्तीज उदास ओत कोइत कबरेए जागे आयू. तिहीं एक कुपू ओतू आन एक डोण तियापोअ मिक्युतो. <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />ईसु कोयो, “डोण सेटे कोआ.”</para>
  <para style="p" vid="JHN 11:39">तिया मोअनाराअ बोअह्हीं मार्था तियाहा कोनी वोल्यी, “प्रभु, ओमे ते तों गोंदाअतोये, काहाके तियाहा ओजल्याहा शार दिही ओत सुकाहा.”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />ईसु तियीही कोयो, “केहें आंय ताहूं ने कोयोतो के जर तू विश्वास कोअही, ताहां देवोअ महिमा पालही.”<verse eid="JHN 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41" />ताहां तियां तिया डोणोहों सेटे होरकायू. ईसु उसे पालीत कोयो, “बा, आंय ताआ आभार मानोहो के तू माआं उनाअयुहू. <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />माहूं मुंदू होय के तू सादा माआं उनाअहे, पोन जे गर्दी आहने उबी होये, तियांआं वाखरी आंय ओं कोयो, जिहीं वाअहीं के तें विश्वास कोए के तुमे माहूं मोकल्युहू.”<verse eid="JHN 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43" />ओं कोत कोइत तिये वोडा आवाजोमेहें कोयो, “ए लाजर बारथे आव!” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />तो माटी जो मोइत गोयूतो तियाआ आथेन गुडा बांद्ल्याज हिद्लाअ साअकाअरी निहींत आयू, आन तियाआ सोब साअका वाअहीं बांदल्यी ओती. ईसु तियांहां कोयो, “याहा सोड़ा आन जाअहूं द्या.”<verse eid="JHN 11:44" /></para>
  <para style="s">ईसुहू माइलोअ कदर</para>
  <para style="r">(<ref loc="MAT 26:1-5">मत्तय 26:1-5</ref>; <ref loc="MRK 14:1">मार्क 14:1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="LUK 22:1">लुक 22:1</ref>,<ref loc="LUK 22:2">2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />ताहां जे यहुदी माहें मरियाअरी आयेते आन ईसुउ ओं काम देख्यो, तियांमेर्‍येए वारुज जोएं तियापोअ विश्वास कोअयू. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />पोन तियांमेर्‍येए थोड़ेक जोएं फरिसीइ जागे जात कोइत ईसुउ कामोअ खबर कोयी. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />यापोअ मुख्य पुंजारा आन फरिसीहीं यहुद्याआं महासभा हादाड़्यी, आन कोयो, “आपुहूं कि कोअहूं जोवे? ओं माटी तोम जाअखीलेहे समत्कार देखाड़ेहे. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />जर आपू तियाहा एहेलोज कोअहूं देदो, ताहां आखे तियापोअ विश्वास कोए वोले, आन एहें कोइत रोमन आधिकारी इंहीं आवित कोइत आपाअ मंदिर आन देस बेनू आरवीत टाकी देये.”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />ताहां तिया वोरह्योअ डायु पुंजारु कैफा ओतू, तियांहां कोयो, “तुमुहूं किज बी नाहां मुंदू; <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />आन तुमू ओं नाहां समजीइता के तुमाआं काजे ओं हाजो होय, के आपाअ माअहुंउं कोअते एक माहुंउं मोए आन आखी जाती आरवाअहूं ने जोवे.” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />ए गोठ तियांहां तियाअहें रोत ने कोयी, पोन तिया वोरह्योअ डायु पुंजारु ओत कोइत तिये भविश्यवाणी कोअयी, के ईसु यहुदी माअहोंअ काजे मोए; <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />आन निस्तु तियाआ यहुदी माअहुंउं काजे एतुज नाहां, पोन याअकाजे बी के देवोअ माअहें जे वेरासेर ओवेहे तियांहां एकठे कोइत सेके.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />ताहराअ एहें कोइत तेदिहींज रोत यहुदी आधिकारी ईसुहू माइत टाकीइलाअ कदर काडा वोल्या. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />तियाहा काजे ईसु तोयोंअ रोत यहुद्याआं विसमेहें फाशुउ खुल्लाम खुल्लू ने फिर्‍यू, पोन तिहीं रोत जंगलोअ आहनेए मुलखोअ एफ्राइम नावोअ एका होयरोमेहें जातु रोयू; आन तियाआ सेलाअरी तिहीं रोनु वोल्यू.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />यहुद्याआं वल्हांडणोअ तिवार आहने आवतुतो, आन जाअखीलेहे माअहें तिवारो रोत पेल बाहेर्‍याआ गांवोंमेर्‍येए येरुसालेमोमेहें गोये, के सोताहा सोके कोए. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />ते ईसुहू होदे वोल्ये, आन मंदिरोमेहें उबे रोत कोइत तियां तियांआंज कोने वोल्ये, “तुमुहूं केहेलोहो हासवाअहे? केहें तो हुदाअलीज या तिवारोमेहें ने आवे?” <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />मुख्य पुंजारहां आन फरिसीहीं ओ आदेश आपीत मिक्युतो के जर एखाहा मुंदू पोड़े के तो का होय ताहां कोअहूं जोवे, काहाके ते तियाहा तोइत सेके.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">बेथानीमेहें ईसुउ अभिशेक</para>
  <para style="r">(<ref loc="MAT 26:6-13">मत्तय 26:6-13</ref>; <ref loc="MRK 14:3-9">मार्क 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />ईसु वल्हांडण तिवारोअ रोत सोव दिहोअ पेल बेथानीमेहें आवयू जिहीं लाजर ओतू, जियाहा ईसु मोल्याम रोत जिवाड़्युतो. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />तिहीं ते तियाआ काजे रोटू तियार कोअयू; आन मार्था वाटु कोअयू, आन लाजर तियांमेहें रोत एक ओतू जो तियांअरी रोटू खाअलाअ काजे बोठुतो. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />तेहेलाम मरिया जटामांसीइ आरदो लिटर जाअखीलोहो मोगो अत्तर लेत कोइत ईसुउ गुडापोअ हारीत कोइत तियीइ सिंग्या वाअहीं तियाआ गुडा नुश्‍या; आन अत्तरो वाअहीं आखो कोअ मोगो मोगो गोंदाओ वोल्यो. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />पोन तियांअरी सेलामेर्‍युउ यहुदा इस्कार्योत नावोअ एक सेलू जो तियाहा तोइत आपनारु ओतू, तो कोनु वोल्यू, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“ओं अत्तर तिन होव सांदीइ रुप्यामेहें वेसीत कोइत गोरब्योहों काहा ने आप्यो?” <figure style="fig" alt="Alabaster jars" file="HK00142C.TIF" size="col" copy="Horace Knowles ©" ref="12:3">संगमरमरोअ बासने</figure><verse eid="JHN 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 12:6" />तिये ए गोठ याअकाजे नाहां कोयी के तियाहा गोरब्योंअ सिंता ओती, पोन याअकाजे के तो बांड ओतू, आन तियापोअ तियांआं पोशाआ खोत्ली रोतीते आन तियीमेहें जों किबी मिकाअलो रोतोतो, तों सोइत लेतुतो.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />पोन ईसु कोयो, “यिही रोअहूं द्या. तियी ओं माहूं डाटीइलाअ दिहोअ काजे कोअयोहो. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />काहाके गरीब ते सादा तुमाआं आरी रोतेहे, पोन आंय तुमाअरी सादाज नाहां रोनारु.”<verse eid="JHN 12:8" /></para>
  <para style="s">लाजरोहो माईंलोअ कदर</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />जेहेलाम यहुदीइ वोडी गर्दीही मुंदू पोड़्यु के तो बेथानिया मेहें होय, ताहां तें निस्ते ईसुउ काजे एतेज नाहां आये, पोन याअ काजे बी के लाजरोहो देखीत सेके, जियाहा तिये मोल्याम रोत जिवाड़्युतो. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />ताहां मुख्य पुंजारां लाजरोहो बी माइत टाकीइलाअ कदर काड्यी. <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />काहाके याअ वाखरी वारुज यहुदी माहें तियांहां सोड़ीत ईसु पोअ विश्वास कोए वोल्येते.<verse eid="JHN 12:11" /></para>
  <para style="s">येरुसालेम जाअलो</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्तय 21:1-11</ref>; <ref loc="MRK 11:1-11">मार्क 11:1-11</ref>; <ref loc="LUK 19:28-40">लुक 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />बिहरे दिहे डाहटी गर्दीइ माअहें जें तिवारोमेहें आयेते ओं उनाअये के ईसु येरुसालेमोमेहें आवेहे. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />तियाहा काजे तियां खारक्याअ डाली लेदी आन तियाहा मिलीइलाअ काजे निहींये, आन आअड़े वोल्ये, “होसान्ना! प्रभुउ नावसे आवनारु इस्राएलोअ राजा आशिर्वादीत होये!”<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />जेहेलाम ईसुहू एक गोदडीइ बासो मिल्यो; ताहां तो तिया पोअ बोहीत गोयू, जेहलोहो के वसनोमेहें लेख्योहो,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“ए सियोनोअ होयर, बिही मा;</para>
  <para style="q2" vid="JHN 12:15">देख, ताआ राजा गोदड़ीइ बासापोअ बोहीत आवेहे.”<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />तियाआ सेला ए गोठी पेल ने समज्याते, पोन जेहेलाम ईसुउ महिमा देखाअयी, ताहां तियांहां ओर आयी के ए गोठी तियाआ बाप्तिमेहें वसनोमेहें लेखल्यी ओती, आन माअहें तियाअरी एहेंज कोइत वेवारो कोअयोतो.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />ताहां तियां गर्दीइ माअहूं साक्शी आप्यी, जें तेहेलामेहें तियाअरी ओते जेहेलाम तिये लाजरोहो माहणोम रोत गोगाड़ीत कोइत मोल्याम रोत जिवाड़्युतो. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />तिये ओ समत्कार देखाड़्युहू कोत तियां माअहूं उनात लेदोन ताहरेए तें तियाहा मिले आयेते. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />ताहां फरिसी तियां तियांआं एकानेकाहा कोयो, “इत्वात खोरा, के तुमुहूं किज नाहां कोइत सेकाअतो. पाला, आखी दुन्या तियाआ फासाड़ी जानी वोल्यीही.”<verse eid="JHN 12:19" /></para>
  <para style="s">युनानीइ ईसुहू होदीइलो</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />जे माअहें तिया तिवारोमेहें येरुसालेमो मेहें आराधना कोए आयेते तियांमेर्‍येए थोड़ेक युनानी ओते. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />तियां गालीलोअ बेथसैदावाला फिलीप्पअ जागे आवित कोइत तियाहा रावणी कोअयी, “साहीब, आमाआं ईसुहू मिलीइलोअ होये.”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />फिलीप्पे आवित कोइत आंद्रियाहा कोयो, ताहां आंद्रिया आन फिलीप्पे जात कोइत ईसुहू कोयो. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />ईसु तियांहां कोयो, ते वेल आवित लागीही के माहुंउं बेटाह्हाअ महिमा ओवे. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />आंय तुमुहूं खोरीज कोहो, के जाअहूं जाआं गोंवोंअ दाणू पुंयींमेहें पोड़ीत कोइत मोइत नाहां जातु, ताअहूं जाआं तो एखलुज रोहे; पोन जाहां मोइत जाहे, ताहां गणतीइ बाहर फल आपेहे. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />जो सोताआ जिवोह मेर कोअहे, तो तियाहा आरवी देये; आन जो यी दुन्यामेहें सोताआ जिवोह मेर नाहां कोअतो, तो हादाजल्म्याआं जिवनोअ काजे तियाआ राखवाली कोए. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />जर एखो माआं सेवा कोअनारो ओय, ताहां माआं फासाड़ी आवे; आन जिहीं आंय होय, तिहीं माआं सेवक बी रोय. जर एखु माआं सेवा कोअनारो ओय, ताहां आब्हू तियाआ मानपान कोए.<verse eid="JHN 12:26" /></para>
  <para style="s">मोतोअ बाप्तिम ईसुउ कबुली</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />“ओमे माआं दिल दुखी होय, ओमे आंय कि कोंव? ‘ए बा, माहूं यी दुखोअ वेलेप रोत वासाड़?’ पोन आंय याआज काजे यी वेलेए जागे पोतुहू. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />ए बा, ताआ नावोअ महिमा कोओ.”</para>
  <para style="p" vid="JHN 12:28">ताहां जुगोम रोत ओ आवाज आयू, “मी तियाआ महिमा कोअयिही, आन फाशुउ कोअहीं.”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />ताहां तिहीं ओती ते गर्दी कोनी वोल्यी, “वादलो गाज्यो,” बिहीरा कोयो, “एखु देवदुत तियाअरी गोग्यू.”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />यापोअ ईसु कोयो, “ओ होरगाआ आवाज माआं काजे नाहां, पोन तुमाआं काजे आयुहू. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />ओमे यी दुन्याअ न्याय निवाड़ू ओवेहे, ओमे यी दुन्याअ आधिकार्‍योहो काडी देये; <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />आन आंय जर धरतीपोअ रोत उसे सोढवाइत जाहीं, ताहां आखाहा माआं जागे खेसिहीं.”<verse eid="JHN 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 12:33" />एहेलोह कोत कोइत तिये ओं देखाड़्यो के तो केहेलिही मोते वाअहीं मोए.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />या वाअहीं गर्दीइ माअहें तियाहा कोयो, “आमू कायदाअ ए गोठ उनाअयेहे के ख्रिस्त सादा रोये, ताहरुउ तू काहा कोहे के माहुंउं बेटाह्हाहा उसे सोढ़वीइलोअ गरज होये? ओ माहुंउं बेटुह्हू कोडू होय?”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />ईसु तियांहां कोयो, “उजालो ओमे थोड़ीक वाआ जाआं होये, जाअहूं जाआं तो उजालो रोय ताअहूं जाआं साला, एहेलोह ने ओवुहूं जोवे के आंदारो तुमुहूं आवित केंडे; जो आंदारामेहें सालेहे तो नाहां जांअतो के कोड्ली वोग जाहे. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />जाअहूं जाआं उजालो तुमाअरी होय, उजालापोअ विश्वास कोआ ताहां तुमू उजालाअ माअहें बोणीत सेकहा.”</para>
  <para style="p" vid="JHN 12:36">ए गोठी कोत कोइत ईसु जातु रोयू आन तियांआं नजरे रोत निकाइत गोयू.<verse eid="JHN 12:36" /></para>
  <para style="s">यहुद्याआं अविश्वास</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />तिये तियांआं सामने एता समत्कार देखाड़्या, तेबी तियां तिया पोअ विश्वास ने कोअयू; <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />काहाके यशया भविश्यवक्ताआ वसन पुरो ओवुहूं जोवे जों तिये कोयो:</para>
  <para style="q1" vid="JHN 12:38">“प्रभु, आमाआं संदेशोपोअ कोडे विश्वास कोअयुहू?</para>
  <para style="q2" vid="JHN 12:38">आन प्रभुउ वोडी ताकत कोडापोअ प्रगट ओवीही?”<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />तिहीं वाअहीं तें विश्वास ने कोइत सेके, काहाके यशया ओं बी कोयोतो:<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“तिये तियांआं डोआ आंदला,</para>
  <para style="q2" vid="JHN 12:40">आन तियांआं मोन वातड़ो कोइ देदोहो;</para>
  <para style="q1" vid="JHN 12:40">एहेलोह ने ओवुहूं जोवे के ते डोआवाअहीं पाले,</para>
  <para style="q2" vid="JHN 12:40">आन मोनो वाअहीं समजे,</para>
  <para style="q2" vid="JHN 12:40">आन फिरे,</para>
  <para style="q2" vid="JHN 12:40">आन आंय तियांहां हुदारो.”<note caller="+" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="ISA 6:10">यश 6:10</ref> </char></note><verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />यशया ए गोठी याअकाजे कोयी के तिये तियाआ महिमा देख्यी, आन तिये तियाआ बाप्तिमेहें गोठी कोअयी.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />तेबी वारुज आधिकार्‍यों ईसु पोअ विश्वास कोअयू, पोन फरिसीइं धाके ते खुल्लाम खुल्ला ने मानताते, काहाके एहेलोह ने ओवुहूं जोवे के ते यहुदी आराधनालयोम रोत काडी देवाये: <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />काहाके तियांहां देवे आपल्‍या मानपानो रोत वादार माअहूं आपल्यू मानपान जाअखु गोमतुतो.<verse eid="JHN 12:43" /></para>
  <para style="s">ईसुउ वसन न्याय निवाड़ाआ आधार</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />ईसु आअड़ीत कोइत कोयो, “जों मापोअ विश्वास कोअहे, तों मापोअ नाहां पोन माहूं मोकलीइनारा पोअ विश्वास कोअहे. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />आन जों माहूं देखेहे, तों माहूं मोकलीइनाराहा देखेहे. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />आंय दुन्यामेहें उजालाआ होस आयुहू, काहाके जों कोडो मापोअ विश्वास कोए, तों आंदारामेहें ने रोअहूं जोवे.<verse eid="JHN 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47" />“जर एखु माआं गोठी उनाइत कोइत ने माने, ताहां आंय तियाहा दोशी नाहां ठरवीइतू; काहाके आंय दुन्याहा दोशी ठरवीइलोअ काजे नाहां, पोन दुन्याअ तारण कोइलाआ काजे आयुहू. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />जो माहूं नाकारेहे आन माआं वसनोहो स्विकार नाहां कोअतो तियाआ न्यायनिवाड़ु कोअनारो तोम एक होय; तों मोन्ज्ये मी कोयोहो ओं वसन, तोंज आखरीइ दिहोमेहें तियाआ न्याय निवाड़ू कोए <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />ओं खोरो होय, काहाके आंय माआं वोगेहे रोत गोठी नाहां कोअयी; पोन आब्हू जिये माहूं मोकल्युहू तियेज माहूं की की कोअलोन की की गोगीइलो तो आदेश आप्युहू. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />आन माहूं मुंदू होये के तियाआ आदेश हादाजल्म्योंअ जिवन होय. तिहींज वाअहीं आंय जों किबी गोगोहो, तों जेहलोहो आब्हे माहूं कोयोहो तेहेंज कोइत गोगोहो.”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">ईसु तियाआ सेलाआं गुडा तुवत्लू</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />वल्हांडण तिवारोअ पेलेए तो दिही ओतू, जेहेलाम ईसुहू जाआंत गोयो के दुन्याहा सोड़ीत आब्हाअ जागे जाअलोअ माआं ते वेल आवित लागीही, ताहां तियाआ माअहें जें दुन्यामेहें ओते जियांपोअ तो कायम मेर कोअतुतो, तियां पोअ आखरी जाआं तेहेलीहीज मेर कोअतू रोयू.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />ताहां रोटू खाअलाअ वेले जाहां सैतान शिमोन इस्कार्योतोअ पोर्‍यू यहुदाआ मोनोमेहें ओं टाकीत सुकूतो के तियाहा तोआडो, <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />ईसु, ओं जाइंत कोइत के आब्हे आखो बादो तियाआ आथोम कोइ देदोहो आन तो देवोअ जागे रोत आयुहू आन देवोअ जागे जाहे, <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />तियाहा काजे तो रोटू खाअलोअ सोड़ी देत उठीत कोइते तियाआ उपर्‍येए आंगड़े काडी देदे, आन पोतड़ू लेत कोइत तियाआ कंबरेएरी वेटालित लेदू. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />ताहरुउ बासनोमेहें पाईं पोइत कोइत सेलाअ गुडा तुवीइलोन हिद्लाआ कंबरेएरी बांदल्या पोतड़ा वाअहीं नुसीइलोअ सालू कोअयो. <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />जाहां तो शिमोन पेत्राअ जागे आयू, तेहेलाम पेत्रे तियाहा कोयो, “प्रभु, केहें तू माआं गुडा तुवेहे?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />ईसु तियाहा उत्तर आप्यो, “जो आंय कोअहो, तों ताहूं ओमे ने समजाये, पोन याअ फासाड़ी समजीही.”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />पेत्रे तियाहा कोयो, “तू माआं गुडा केदिहींज ने तुवुहूं जोवे!”</para>
  <para style="p" vid="JHN 13:8">ओं उनाइत कोइत ईसु तियाहा कोयो, “जर आंय ताआ गुडा ने तुवो, ताहां माअरी ताआ किज वाटू ने रोनारु.”<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />शिमोन पेत्रे तियाहा कोयो, “प्रभु, ताहां माआं गुडा एताज नाहां, पोन आथ आन मुन्को बी तुवीदे.”<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />ईसु तियाहा कोयो, “जो उंगल्योहो तो सोको होय, तियाहा गुडाअ सिवाय बिहीरो किज तुवीइलाअ गरज नाहां; आन तुमू सोका होये, पोन आखाज नाहां.” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />ईसु तियाहा ओलखीइतुतो जो तियाहा धोकू देत तोइत आपनारु ओतू, तिहींज वाअहीं तिये कोयो, “तुमू आखाज सोका कायनाहां.”<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />जेहेलाम ईसु तियांआं गुडा तुवी देदा, आन तियाआ आंगड़े पेवीत कोइत फाशुउ बोहीत गोयू, ताहां तियांहां कोनु वोल्यू, “केहें तुमुहूं समजाअयो के आंय तुमाअरी कि कोअयोहो? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />तुमू माहूं गुरु आन प्रभु कोताहा, आन तुमू बोराबरुज कोताहा, काहाके आंय तोज होंव. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />जर आंय गुरु आन प्रभु ओत कोइत तुमाआं गुडा तुवया, ताहां तुमू बी एकान एकाअ गुडा तुवुहूं जोवे. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />काहाके आंय तुमुहूं नमुनू देखाड़ी देदुहू, ताहां जेहें कोइत आंय तुमाअरी कोअयोहो, तेहेंज कोइत तुमू बी कोअया कोआ. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />आंय तुमुहूं खोरीज कोहो, एक सेवक तियाआ मालख्यो रोत वोडू कायनाहां, आन नाहां खबर्‍यु तियाआ मोकलीइनारा रोत वोडू. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />ओमे तुमुहूं ओं सत्य मुंदू होये, आन ओं जर तुमू सोताआ जिवनोम लेत सालहा ताहां तुमाआं केतोह बाहरी ओवे!<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“आंय तुमाआं आखाआ बाप्तिम नाहां कोतू; जियांहां मी निवड़ीत लेदेहे, तियांहां आंय ओलखोहो; पोन ओं याअकाजे होये के पवित्र शास्राआ ओं वसन पुरो ओवे, ‘जिवेज रोटू आप्यू आन जिवोहोज देनो उठ्यो.’ <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />ओमे तो ओवीइलोअ पेल आंय तुमुहूं कोत मेकोहो, के जेहेलाम ओं ओवे तेहेलाम तुमू विश्वास कोआ के ‘आंय जो होय तोज होंव.’ <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />आंय तुमुहूं खोरीज कोहो के जो मी मोकल्योहो तियाहा स्विकार कोअहे, तो माहूं स्विकार कोअहे; आन जो माहूं स्विकार कोअहे, तो माहूं मोकलीइनाराआ स्विकार कोअहे.”<verse eid="JHN 13:20" /></para>
  <para style="s">ईसुउ तोआइलोअ सौंसू</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />ए गोठी कोत कोइत ईसु आत्मामेहें दुखी ओवू आन ए साक्शी आप्यी, “आंय तुमुहूं खोरीज कोहो, के तुमामेर्‍युउ एक जोउं माहूं धोकू देत तोआडे.”<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />ताहां तियाआ सेला एकान बिहीराअहें पाला वोल्या आन विसारोमेहें पोड़्या, के तो कोडाअ बाप्तिमेहें कोहे. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />सेलामेर्‍युउ एक जोऊँ जियापोअ ईसु मेर कोअतुतो, ईसुउ एकी वोगेहे ओंणाइत बोठुतो. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />ताहां शिमोन पेत्रे तियाहा इशारु कोअयून फुशो, “कोडाअ बाप्तिमेहें कोत्लू तों आमुहूं को एहें कोत फुसेए?”<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />ताहां तिये तेहेंज कोइत ईसुउ सातीइहें ओंणाइत तियाहा फुशो, “प्रभु, तो कोडू होये?”<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />ईसु उत्तर आप्यो, “ओ रोटाअ कुटकू आंय वाटकामेहें जियाहा पिगवीत कोइत आपीहीं तोज होये.” आन तिये कुटकू पिगवीत कोइत शिमोन इस्कार्योतोअ बेटाह्हा यहुदाहा आप्यू. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />जेहेंज रोटाअ कुटकू आथम लेदू तेहेंज सैतान तियामेहें फोहीत गोयू, ताहरुउ ईसु तियाहा कोयो, “तू जों कोअहे, तों तु ताबुड़ कोअ.” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />पोन आरीवाला बोहनाराहां कोडाहाज ने समजाअयो के ईसु ए गोठ तियाहा किहाअ काजे कोयी. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />यहुदा पोअ खोत्ली रोतीते, तियाहा काजे थोड़ाक सेलाहां ओं समजाअयो के ईसु तियाहा कोहे के जों किबी आपुहूं तिवारोअ काजे जोवनारोहो तों वेसातो लेत्ले, नेते एहेलोह के गोरब्योहों वाजिहीं आपी दे. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />तियाहा काजे यहुदे रोटाअ कुटकू लेत कोइत ताबुड़ बारथे जातु रोयू; आन ते रातीइ वेल ओती.<verse eid="JHN 13:30" /></para>
  <para style="s">एक नवू आदेश</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />जेहेलाम यहुदा बारथे जातु रोयू, तेहेलाम ईसु कोयो, “ओमे माहुंउं बेटाह्हाअ महिमा ओवीही, आन देवोअ महिमा तियामेहें प्रगट ओवीही. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />जर तियामेहें देवोअ महिमा प्रगट ओवीही, ताहां देव बी सोतामेहें तियाआ महिमा प्रगट कोए आन ताबुड़ कोए. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />माआं पोर्‍यां,आंय फाशुउ थोड़ीक वाआ जाआं तुमाअरी होंव: ताहराअ तुमू माहूं होदहा, आन जेहेंकोइत आंय यहुदी आधिकार्‍योहों कोयो, ‘जिहीं आंय जाहो तिहीं तुमू नाहां आवित सेकता,’<note caller="+" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="JHN 7:34">योहान 7:34</ref></char></note> तेहेंज कोइत आंय ओमे तुमुहूं बी कोहो. <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />आंय तुमुहूं एक नोवू आदेश आपोहो के एकान एकापोअ मेर कोआ; जेहलीही आंय तुमापोअ मेर कोअयिही, तेहेंज कोइत तुमू बी एकान एकापोअ मेर कोआ. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />जर एकान एकापोअ मेर कोअहा, ताहां याज वाअहीं आखे ओलखे के तुमू माआं सेला होये.”<verse eid="JHN 13:35" /></para>
  <para style="s">पेत्राआ नाकारोअ बाप्तिम ईसुउ भविश्यवाणी</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />शिमोन पेत्रे तियाहा फुशो, “प्रभु, तू का जाहे?”</para>
  <para style="p" vid="JHN 13:36">ईसु उत्तर आप्यो, “जिहीं आंय जाहो तिहीं तू ओमे माआं फासाड़ी नाहां आवित सेकतु; पोन याआ फाटी माआं फासाड़ी आविही.”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />पेत्रे तियाहा कोयो, “प्रभु, ओमे आंय ताआ फासाड़ी काहा नाहां आवित सेकतु? आंय ते ताआ काजे माआं जिव जाआं आपुहूं तियार होये.”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />ईसु उत्तर आप्यो, “केहें तू खोरीज माआं काजे ताआ जिव आपुहूं तियार होये? आंय ताहूं खोरीज कोहो के जाअहूं जाआं तू माहूं तिन वारी ने नाकारीही, ताअहूं जाआं कुकड़ू ने वाहें.<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">ईसु देव आब्हाअ जागे जाअलोअ वाट</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />“तुमाआं मोन दुखी ने ओवुहूं जोवे; देवोपोअ विश्वास मिका आन मापोअ बी विश्वास मिका. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />माआं आब्हाअ कोअमेहें जाअखीलुहू रोअलाआ जागू होये, जर ने रोतू ताहां आंय तुमुहूं कोत देतु; काहाके आंय तुमाआं काजे जागू तियार कोउ जाहो. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />आन जर आंय जात कोइत जागू तियार कोअहीं, ताहां फाशुउ आवित कोइत तुमुहूं माआं जागे लेत जाहीं के जिहीं आंय रोहीं तिहीं तुमू बी रोहा. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />आन जिहीं आंय जाहो तिहींइं वाट तुमुहूं मुंदू होये.”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />थोमे तियाहा कोयो, “प्रभु, आमुहूं ने मुंदू के तू का जाहे; ताहां तिहींइं वाट कि कोइत जाईंत सेकताहा?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />ईसु तियाहा कोयो, “वाट, सत्य आन जिवन आंयुंज होय; माआं जागे आया सिवाय कोडोज आब्हाआ जागे नाहां पोतीत सेकतो. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />जर तुमू माहूं ओलखीइता, ताहां माआं आब्हाहा बी ओलखीइता; आन ओमे तुमू तियाहा ओलखीइताहा, आन तियाहा देखीत बी लेदूहू.”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />फिलीप्पे तियाहा कोयो, “प्रभु, आब्हाहा आमुहूं देखाड़ी दे, ओंज आमाआं काजे खुब होये.”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />ईसु तियाहा कोयो, “फिलीप, आंय एता दिही ओत गोया तुमाअरीज होये, केहें तू माहूं ओमे जाआं नाहां ओलखीइतू? जिये माहूं देख्युहू तिये आब्हाहा देख्युहू. ताहां तू काहा कोहे के ‘आमुहूं आब्हू देखाड़?’ <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />केहें तू विश्वास नाहां कोअतू के आंय आब्हामेहें होय आन आब्हू मामेहें होय? ए गोठी जे आंय तुमुहूं कोहो, ते माआं तरफ रोत नाहां कोतू, पोन आब्हू मामेहें रोत कोइत तियाआ काम कोअहे. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />माआं विश्वास कोआ के आंय आब्हामेहें होय आन आब्हू मामेहें होय; नेताहां कामोंहों पालित तेबी माआं विश्वास कोआ. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />आंय तुमुहूं खोरीज कोहो के जो मापोअ विश्वास कोअहे, एं कामे जे आंय कोअहो, तें तोबी कोए, पोन यांरोत बी वोडे कामे कोए, काहाके आंय आब्हाअ जागे जाहो. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />जों किबी तुमू माआं नावसे मागहा, तों आंय कोअहीं के बेटाह्हा वाअहीं आब्हाअ महिमा ओवुहूं जोवे. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />जर तुमू मापोअ माआं नावसे काविंहीं मागहा, ताहां आंय तियाहा कोअहीं.<verse eid="JHN 14:14" /></para>
  <para style="s">पवित्र आत्माआं बाप्तिम वायदो</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“जर तुमू मापोअ मेर कोअतेय, ताहां माआं आदेशोंहों मानहा. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />आंय आब्हाहा रावणी कोअहीं, आन तो तुमुहूं फाशुउ एक हाती आपे के जो सादा तुमाअरी रोये. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />तो ओ आत्मा होय, जो देवोअ बाप्तिम सत्य देखाड़ेहे. दुन्या तियाआ स्विकार नाहां कोइत सेकती, काहाके ते तियाहा देखीत नाहां सेकती आन नाहां तियाहा ओलखीइती; पोन तुमू तियाहा ओलखीइताहा, काहाके तो तुमाअरी रोहे, आन तो तुमामेहें होये.<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />“जेहेलाम आंय जाहीं, ताहां तुमुहूं एखला ने सोडो; आंय तुमाआं जागे वापिस आविहीं. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />आन थोड़ीज वाआ बाकी रोत गोयीही के फाशीइ दुन्या माहूं ने देखे, पोन तुमू, माहूं देखहा; याअकाजे के आंय जिवतु होय, तुमू बी जिवते रोहा. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />तेदिहीं तुमू जाअहां के आंय माआं आब्हामेहें होय, आन तुमू मामेहें, आन आंय तुमामेहें.<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />“जों माआं आदेशोअ स्विकार कोअहे, आन तियांआं पालन कोअहे, तोंज मापोअ मेर कोअहे; आन जों मापोअ मेर कोअहे, तियापोअ माआं आब्हू मेर कोए, आन आंय बी तियापोअ मेर कोअहीं आन सोताहा तियापोअ प्रगट ओविहीं.”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />तिये यहुदा जो इस्कार्योत ने ओतू, तियाहा कोयो, “प्रभु, की ओयो के तू आमापोअ सोताहा प्रगट कोइलाआ कोअहे आन दुन्यापोअ नाहां?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />ईसु तियाहा उत्तर आप्यो, “जों कोडो मापोअ मेर कोए, ताहां तों माआं शिक्शण माने, आन माआं आब्हू तियां पोअ मेर कोए, आन आमू तियाआ जागे आवहूं आन तियाअरी रोहूं. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />जो मापोअ मेर नाहां कोअतो, तो माआं शिक्शण नाहां मानतो; आन जो शिक्शण तुमू उनाअताहा तों माआं नाहां पोन आब्हाअ होये, जिये माहूं मोकल्यू.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />“ए गोठी आंय तुमुहूं तेहेलाम कोयी जेहेलाम आंय तुमाअरी ओतू. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />पोन हाती मोन्ज्ये पवित्र आत्मा जियाहा आब्हू माआं नावसे मोकले, तो तुमुहूं आखी गोठी सिकाड़े आन जो किबी आंय तुमुहूं कोयोहो, तो आखो तुमुहूं ओर कोइत आपे.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />“आंय तुमुहूं शांती आपीत जाहो, माआं शांती तुमुहूं आपोहो, जेहलीही दुन्या आपेहे, तेहेलीही आंय तुमुहूं नाहां आपतू; तुमाआं मोन दुखी ने ओवुहूं जोवे आन ने बिअहूं जोवे. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />तुमू उनाअये के आंय तुमुहूं कोयो, ‘आंय जाहो, आन तुमाआं जागे फाशुउ आविहीं.’ जर तुमू मापोअ मेर कोअता, ताहां यी गोठी वाअहीं खुस ओवता के आंय आब्हाअ जागे जाहो, काहाके आब्हू माआं रोत वोडू होये. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />आन आंय ओमे ए घटना ओवीइलाआ पेलुज तुमुहूं कोत देहो, जेहेलाम ते ओत जाय, ताहां तुमू विश्वास कोआ. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />आंय ओमे तुमाअरी फाशीइ वादार गोठी नाहां कोइत सेकतु, काहाके यी दुन्याअ राज कोअनारु आवेहे. मा पोअ तियाआ किज आधिकार कायनाहां; <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />पोन ओं दुन्या जाईंत लेअहूं जोवे के आंय आब्हापोअ मेर कोअहो, आन जेहें कोइत आब्हे माहूं आदेश आप्युहू, तेहेंज कोइत आंय कोअहो.”</para>
  <para style="p" vid="JHN 14:31">“उठा, इंहीं रोत साला.”<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">दाराक्शाआ वेलो आन डाली</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“खोरो दाराक्शाआ वेलो आंय होय, आन माआं आब्हू जागल्यू होय. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />जे डाली मामेहें होय आन नाहां फलती, तियी हारेक डालीही तो वाडीत टाकेहे; आन जे फलतीही, तियींहीं तो जाअखी फले तेहें काजे सिंदीत टाकेहे. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />तुमू तोम मी कोयोहो तिया शिक्शणो वाअहीं पेलुज रोत सोके ओवेहे. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />तुमू मामेहें रोवा, आन आंय तुमामेहें रोहीं. जेहें कोइत फाकड़ी जर दाराक्शाआ वेलामेहें ने रोये, ताहां ते नाहां फलीत सेकती. तेहेंज कोइत तुमू बी जर मामेहें ने रोहा ताहां नाहां फलीत सेकते.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />“आंय दाराक्शाआ वेलो होय आन तुमू फाकड़ी होये. जो मामेहें रोहे आन आंय तियामेहें रोहो, तों जाअखीलोहो फल आपेहे, काहाके मापरोत आंगे ओत कोइत तुमू किज बी ने कोइत सेकत्ले. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />जों मामेहें नाहां रोतो, तों उगाअली डालीइ होस होये; आन एहेली डालीही टोलू कोइत आगीमेहें टाकी देतेहे, आन ते पेटाइत जातिही. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />जर तुमू मामेहें आन माआं शब्दे तुमामेहें रोय, ताहां जो जोवे मागा आन तो तुमाआं काजे ओत जाये. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />माआं आब्हाअ महिमा याज वाअहीं ओवेहे, के तुमू जाअखीलोहो फल लेतावे, ताहांज तुमू माआं सेला बोणहा. <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />जेहलीही देव आब्हे मापोअ मेर कोअयी, तेहेलीज आंय तुमापोअ मेर कोअहो; माआं मेरेमेहें टिकीत रोवा. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />जर तुमू माआं आदेशोहो मानहां, ताहां माआं मेरेमेहें रोहा; जेहलोहो आंय माआं आब्हाआ आदेश मान्युहूं, आन तियाआ मेरेमेहें टिकीत रोहो.<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />“आंय ए गोठी तुमुहूं याअकाजे कोयीही, के माआं खुसी तुमामेहें रोये, आन तुमाआं खुसी पुरी ओत जाय. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />माआं आदेश ओ होय, के जेहेलीही आंय तुमापोअ मेर कोअयी, तेहेंज कोइत तुमू बी एकमेकापोअ मेर कोआ. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />यापरोत वोडी मेर कोड्लीज कायनाहां के कोडो तियाआ दोस्तीइ कोअते जिव आपे. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />जो आदेश आंय तुमुहूं आपोहो, जर तो मानहां ताहां तुमू माआं दोस्ती होय. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />ओमे रोत आंय तुमुहूं साकर्‍या ने कोंव, काहाके साकर्‍याहा ने मुंदू के तियाआ मालिख की कोअहे; पोन आंय तुमुहूं दोस्ती कोहो, काहाके आंय जे गोठी माआं देव आब्हाप रोत उनाअयू. ते आखी तुमुहूं कोत देदी. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />तुमू माहूं नाहां निवड़्यू पोन मी तुमुहूं निवड़्येहे आन तुमुहूं नेम्येहे, के तुमू जात कोइत वादार फल लेतावुहूं जोवे आन तुमाआं फल टिकीत रोअहूं जोवे, के तुमू माआं नावसे जो किबी देव आब्हापोअ मागहा, ताहां तो तुमुहूं आपे. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />आंय तुमुहूं यीं गोठीइ आदेश आपोहो के तुमू एकमेकापोअ मेर कोअहूं जोवे.<verse eid="JHN 15:17" /></para>
  <para style="s">सेलाहां दुन्या सीस कोअत्ली</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“जर दुन्या तुमाअरी दुस्मोनी कोअहे, ताहां तुमू जांअतेहे के तिये तुमा रोत पेल माअरी दुस्मोनी कोअयी. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />जर तुमू दुन्याअ माहें रोते, ताहां दुन्या तियाआ कोर्‍याअरी मेर कोअती; पोन याअ कोअते के तुमू दुन्याअ नाहां, पोन आंय तुमुहूं दुन्याम रोत निवड़ीत लेदेहे. याआज काजे दुन्या तुमाआं आरी दुस्मोनी कोअहे. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />जे गोठ आंय तुमुहूं कोयीते, सेवक मालख्योअ रोत वोडू नाहां रोतू, तियाहा ओर मिका. जर तियां माहूं तारास कोआड़्यू. ताहां तुमुहूं बी तारास कोआड़े; जर तियां माआं हिकवोण मान्यी, ताहां तुमाआं बी माने. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />पोन ओं आखो बादो ते माआं नावसे तुमाअरी कोए, काहाके ते माहूं मोकलीइनाराहा ने ओलखीइत्ले. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />जर आंय ने आवतू आन तियांअरी गोठी ने कोअतू, ताहां ते पापोअ दोशी ने ठरते; पोन ओमे तियांहां तियांआं पापोअ काजे किज बाहानु कायने. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />जो माअरी दुस्मोनी मिकेहे, तो माआं देव आब्हाअरी बी दुस्मोनी मिकेहे. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />जर आंय तियांमेहें ते कामे ने कोअतू जे बिहरे कोडेज नाहां कोअये, ताहां ते पापी ने ठरते; पोन ओमे ते तियां माहूं आन माआं आब्हाहा बेनुहूं देख्या आन बेनुउं आरी दुस्मोनी कोअयी. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />ओं याअकाजे ओवयो के तो वसन पुरो ओवे, जो तियांआं कायदामेहें लेख्योहो: ‘तियां माअरी वायाज दुस्मोनी कोअयी.’<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />“पोन जेहेलाम तो हेंगात्यु आवे. जियाहा आंय तुमाआं जागे आब्हाअहीं रोत मोकलिहीं, मोन्जे सत्याआ आत्मा जो आब्हाअहीं रोत निहेंहे, ताहां तो माआं साक्शी आपे; <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />आन तुमू बी माआं साक्शीदार होय, काहाके तुमू सुरवाती रोत माअरी रोयाहा.<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />“ए गोठी आंय तुमुहूं याअकाजे कोयीही के तुमाआं विश्वास कम ने पोड़ुहूं जोवे. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />ते तुमुहूं यहुदी आराधनालयोमेहें रोत काडी देये, पोन ते वेल आवेहे, के जो कोडो तुमुहूं माइत टाके तो समजे के आंय देवोअ सेवा कोअहो. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />एहेलोह ते याअकाजे कोअनारे के तियां नाहां आब्हाहा ओलख्युहू आन नाहां माहूं ओलखीइते. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />पोन ए गोठी आंय याअकाजे तुमुहूं कोयी, के जेहेलाम यांआं वेल आवे, तेहेलाम तुमुहूं ओर आवहूं जोवे के आंय तुमुहूं पेलुज कोत देदोतो.</para>
  <para style="p" vid="JHN 16:4">“आंय सुरुवातीमेहें तुमुहूं ए गोठी याअकाजे नाहां कोयी काहाके आंय तुमाअरी ओतू.<verse eid="JHN 16:4" /></para>
  <para style="s">पवित्र आत्माआं काम</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />“पोन ओमे आंय माहूं मोकलीइनाराअ जागे जाहो; आन तुमामेर्‍योअ कोडोज माहूं नाहां फुसतो, ‘तू का जाहे?’ <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />पोन आंय जे ए गोठी तुमुहूं कोयीही, तियाहा काजे तुमाआं मोन दुखोवाअहीं पोआइत गोयोहो. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />पोन आंय तुमुहूं खोरीज कोहो के माआं जाअलोअ तुमाआं काजे हाजो होय, काहाके जर आंय ने जांव ताहां तो हेंगात्यु तुमाआं जागे ने आवे; पोन जर आंय जाहीं, ताहां तियाहा तुमाआं जागे मोकलिहीं. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />आन जाहां तो आवे ताहां दुन्याहां पुरावू कोइत देखाड़े के, पाप आन सतीपण आन न्यायोअ बाप्तिमेहें पुरावू कोइत आपे. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />पापोअ बाप्तिमेहें याअकाजे के ते मापोअ विश्वास नाहां कोअते; <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />आन सतीपणोअ बाप्तिमेहें याअकाजे के आंय आब्हाअ जागे जाहो, आन तुमू माहूं फाशे ने देखहा; <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />न्यायोअ बाप्तिमेहें याअकाजे के दुन्याअ आधिकारी दोशी ठरवाअयुहू.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />“माहूं तुमुहूं फाशीइ बी जाअखीलीही गोठी कोइली होय, पोन ओमे तुमू तियीहीं वेठीत नाहां सेकते. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />पोन जेहेलाम तो मोन्ज्ये सत्याआ आत्मा आवे, तेहेलाम तो तुमुहूं आखी सत्याआ वाट कोतापे, काहाके तो सोताआ तरफ से ने कोय, पोन जों किबी उनाये तोंज कोये, आन आवनारी गोठी तुमुहूं कोतापे. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />तो माआं महिमा कोए, काहाके तो माआं गोठीमेहें रोत लेत कोइत तुमुहूं कोतापे. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />जो किबी आब्हाअ होय, तो आखो माआं होय; तियाहा काजे आंय कोयो के तो माआं गोठीमेहें रोत लेत कोइत तुमुहूं कोतापे.<verse eid="JHN 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />“थोड़ीक वाएमेहें तुमू माहूं ने पालहा, आन फाशे थोड़ीक वाएमेहें माहूं पालहा.”<verse eid="JHN 16:16" /></para>
  <para style="s">दुख खुसीमेहें बोदलात जाय</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />ताहां तियाआ थोड़ाक सेला तियां तियांआंज कोयो, “ओं कि होय जो तो आपुहूं कोहे, ‘थोड़ीक वाएमेहें तुमू माहूं ने देखहा, आन फाशाआ थोड़ीक वाएमेहें माहूं देखहा?’ आन ओं याअकाजे के आंय आब्हाअ जागे जाहो?”<verse eid="JHN 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 16:18" />ताहां तियां कोयो, “ए ‘थोड़ीक वाआ’ जो तो कोहे, कि गोठ होय? आपुहूं नाहां मुंदू के तो कि कोहे.”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />ते माहूं फुसीइलाअ कोशित कोअताहा ओं जाइंत ईसु तियांहां कोयो, “केहें तुमू माआं यी गोठीइ बाप्तिमेहें तुमा तुमाआंज विसार कोअताहा के, ‘थोड़ीक वाएमेहें तुमू माहूं ने देखहा, आन फाशाआ थोड़ीक वाएमेहें माहूं देखहा?’ <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />आंय तुमुहूं खोरीज कोहो के तुमू रोड़हा आन विखु कोअहा, पोन दुन्या खुसी कोए; तुमुहूं दुख ओवे, पोन तुमाआं दुख खुसीमेहें बोदलाइत जाय. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />ठाल्ली पोड़ीइला वेले बोईंहीं पिड़ा ओवेहे, काहाके तियीइ दुखोअ वेले आवित पोतीही, पोन जेहेलाम ते पोर्‍याहा जल्म आपी देहे, ताहां यी खुसीवाअहीं के दुन्यामेहें एक माहुंउं उबज्यो, तिया तारासोहो फाशीइ ओर ने कोअत्ली. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />तेहेंज कोइत तुमुहूं बी ओमे ते पिड़ा होय, पोन आंय तुमुहूं फाशुउ मिलीहीं आन तुमाआं मोन खुसीवाअहीं पोआइत जाये; आन तुमाआं खुसी कोडोज तुमाप रोत बुउसीत ने लेये.<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />“तेदिहीं तुमू माहूं किज ने फुसहा. आंय तुमुहूं खोरीज कोहो, जर आब्हापोअ किज बी मागाहा, ताहां तो माआं नावसे तुमुहूं आपे. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />ओमे जाआं तुमू माआं नावसे किज नाहां माग्यो; मागा ताहां जोड़े, काहाके तुमाआं खुसी पुरी ओत जाअहूं जोवे.<verse eid="JHN 16:24" /></para>
  <para style="s">ईसु दुन्याहां जिकीत होय</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“आंय ए गोठी तुमुहूं काईंमेहें कोयीही, पोन ते वेल आवेहे के आंय तुमुहूं फाशुउ काईंमेहें ने कोनारु, पोन खुल्लाम खुल्लू तुमुहूं आब्हाअ बाप्तिम कोत आपीहीं. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />तेदिहीं तुमू माआं नावसे मागाहा;आन आंय तुमुहूं ओं नाहां कोतू के आंय तुमाआं काजे आब्हाहा प्रार्थना कोअहीं; <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />काहाके आब्हू तोम सोताहाज तुमापोअ मेर कोअहे, याअकाजे के तुमू मापोअ मेर कोअयिही आन ओ बी विश्वास कोअयुहू के आंय देवोअहीं रोत आवयू. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />आंय आब्हाअहीं रोत दुन्यामेहें आयुहू; आंय फाशुउ दुन्या सोड़ीत कोइत आब्हाअ जागे जाहो.”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />तियाआ सेला कोयो, “देख, ओमे ते तू खुल्लामखुल्लू कोहे, आन कोड्ली काईं नाहां कोतू. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />ओमे आमू समजीत गोयाहा, के तू आखोज जाअहें, ओमे याअ गरज नाहां के एखु ताहूं प्रश्न फुसे; या वाअहीं आमुहूं ओ विश्वास बोहेहे के तू देवोअहीं रोत आयुहू.”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />ओं उनाइत कोइत ईसु तियांहां कोयो, “केहें तुमू ओमे विश्वास कोअतेहे? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />पाला, ते वेल आवेहे पोन आवित पोतीही के तुमू आखे वेरा-सेर ओतकोइत जिवज्योअ वाट तोअहा, आन माहूं एखलाहा सोड़ी देहा; तेबी आंय एखलुज कायनाहां काहाके आब्हू माआं आरी होय. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />आंय ए गोठी तुमुहूं याअकाजे कोयीही के तुमुहूं मामेहें शांती मिले. दुन्यामेहें तुमुहूं तारास ओवेहे, पोन हिम्मत मिका, आंय दुन्याहां जिकीत लेदीही.”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">ईसुउ सोताआ काजे प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />ईसु ए गोठी कोयी आन जुगोअहें पालित कोइत कोयो, “बा, ते वेल आवित लागीही; ताआ पोर्‍याअ महिमा कोओ के पोर्‍यू बी ताआ महिमा कोइत सेके, <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />काहाके तुमे तियाहा आखा मोनव्योंपोअ आधिकार आप्यू, काहाके जियांहां तुमे तियाहा आप्येहे तियां आखाहा तो कायम जिवन आपे. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />आन कायम जिवन ओं होय के ते ताहूं एकनिस्ता खोरा देवोहो आन ईसु ख्रिस्ताहा, जियाहा तुमे मोकल्युहू, जाएं. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />जो काम तुमे माहूं कोइलाआ काजे आप्योतो, तियाहा पुरो कोइत आंय धरतीपोअ ताआ महिमा कोअयिही. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />बा! ओमे तू माआ महिमा जे दुन्या बोणाविलोअ पेल ताअरी ओती तियी महिमाअरी माहूं बी ताअरी महिमावालू कोअ.<verse eid="JHN 17:5" /></para>
  <para style="s">सेलाआं काजे ईसुउ प्रार्थना</para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“आंय ताआ तियां माअहुंहूं देखाड़्योहो जियांहां तुमे दुन्यामेहें रोत माहूं आप्ये, ते ताआ ओते आन तुमे तियांहां माहूं आप्ये, आन तियां ताआ वसनोहो मानित लेदोहो. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />ओमे तियां जाइंत लेदोहो के जो किबी तुमे माहूं आप्योहो तो आखो ताअहें रोत होय; <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />काहाके जे वसने तुमे माहूं आप्ये, आंय तियां वसनोहो तियांआं जागे पोताड़ी देदे; आन तें तियां वसनोहो स्विकार कोअये, आन खोराखर जाइंत लेदोहो के आंय ताआ जागे रोत आयुहू, आन विश्वास कोइत लेदुहू के तुमेज माहूं मोकलीइल्यू.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />“आंय तियांआं काजे विनंती कोअहो; दुन्याअ काजे विनंती नाहां कोअतू, पोन तियांआंज काजे जियांहां तुमे माहूं आप्येहे, काहाके ते ताआ होय; <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />आन जो किबी माआं होय तो आखो ताआ होय, आन जो ताआ होय तो माआं होय, आन यांवाअहीं माआं महिमा देखाअयीही. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />आंय ओमे फाशुउ वादार वेल दुन्यामेहें नाहां रोनारु, पोन एं दुन्यामेहें रोनारेहे, आन आंय ताआ जागे आवोहो. पवित्र बा, ताआ तिया नावोवाअहीं जो तुमे माहूं आप्योहो, तियांआं राखवाली कोओ के ते आपाअ होस एक रोअहूं जोवे. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />जेहेलाम आंय तियांअरी ओतू, ताहां आंय ताआ तिया नावोअ ताकते वाअहीं, जो तुमे माहूं आप्योहो, तियांआं राखवाली कोअयी आन तिया आरवाअनारा बेटाह्हाहा सोड़ीत तियांमेर्‍योअ कोडोज ने आरवाअयो, याअकाजे के वसनोमेहें जों कोयोहो तों पुरो ओवुहूं जोवे.<verse eid="JHN 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13" />“ओमे आंय ताआ जागे आवोहो, आन ए गोठी दुन्याम कोहो, के माआं खुसी तियांआं दिलोमेहें पुरी ओत जाअहूं जोवे. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />आंय ताआ शब्द तियांआं जागे पोताड़ी देदोहो; आन दुन्या तियांअरी दुस्मोनी कोअयी, काहाके जेहेंकोइत आंय दुन्याअ नाहां तेहेंज कोइत ते बी यी दुन्याअ नाहां. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />आंय ए रावणी नाहां कोअतू के तू तियांहां दुन्याम रोत विसीत ले; पोन ए रावणी कोअहो के तू तियांहां खाराबोप रोत वासाड़ीत मिक. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />जेहेंकोइत आंय दुन्याअ नाहां, तेहेंज कोइत ते बी दुन्याअ नाहां. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />सत्यावाअहीं ताआ काजे तियांहां सोके कोएए: ताआ वसन सत्य होये. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />जेहेंकोइत तुमे माहूं दुन्याम मोकल्यू, तेहेंज कोइत आंय बी तियांहां दुन्याम मोकल्ये; <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />आन तियांआं काजे आंय सोताहा पवित्र ओवोहो, मोन्ज्ये तें बी सत्यावाअहीं पवित्र ओत सेके.<verse eid="JHN 17:19" /></para>
  <para style="s">ईसुउ आखा विश्वास्याआं कोअते प्रार्थना</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“आंय निस्तु तियांआंज काजे प्रार्थना नाहां कोअतू, पोन तियां काजे बी जे यांआं वसनोवाअहीं मापोअ विश्वास कोअनारे, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />के ते आखे एक ओवुहूं जोवे; जेहेंकोइत तू ए बा मामेहें होय, आन आंय तामेहें होय, तेहेंज कोइत ते बी आपामेहें रोअहूं जोवे, जियावाअहीं दुन्या विश्वास कोए के तुमेज माहूं मोकल्युहू. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />ते महिमा जे तुमे माहूं आप्यी आंय तियांहां आप्यीही, के ते तेहेंज कोइत एक रोअहूं जोवे जेहेंकोइत के आपू एक होय, <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />आंय तियांमेहें रोहीं आन तू मामेहें रोही जिया वाअहीं के ते पुरे ओत कोइत एक ओत जाय, आन दुन्या ओलखे के तुमेज माहूं मोकल्यू, आन जाईंत लेय के तुमे मापोअ मेर कोअयिही आन तेहेंज कोइत तियांपोअ बी मेर कोअल्यी.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />“बा, माआं इश्शा होय के, जियांहां तुमे माहूं आप्येहे, तें बी जिहीं आंय होय, तिहीं माआं जागे रोअहूं जोवे, मोन्ज्ये जे महिमा तुमे माहूं आप्यीही, तियीही तेंबी देखीत सेके, काहाके तुमे दुन्या बोणिइलोअ पेल मापोअ मेर कोअयी. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />ए धर्मी बा, दुन्या ताहूं ने ओलख्यु, पोन मी ताहूं ओलख्यु; आन माआं सेला बी जांअताहा के तुमेज माहूं मोकल्युहू. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />आंय ताआ नाव तियांहां कोताप्यो आन कोतापतू रोहीं के जे मेर ताहूं मापोअ ओती ते तियांमेहें रोअहूं जोवे, आन आंय बी तियांमेहें रोअहूं जोवे.”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">ईसुउ तोआइलो</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्तय 26:47-56</ref>; <ref loc="MRK 14:43-50">मार्क 14:43-50</ref>; <ref loc="LUK 22:47-53">लुक 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />ईसु ए गोठी कोत कोइत तियाआ सेलाअरी किद्रोन खोब्रीइ तिवोल गोयू. तिहीं एक बोगीसू ओतू, जियामेहें तो आन तियाआ सेला गोया. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />तियाहा तोइत आपनारु यहुदा बी तिया जागाहा जांअतुतो, काहाके ईसु तियाआ सेलाहां तिहीं कायम मिल्या कोअतुतो. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />तियाहा काजे यहुदा, रोमन सिपायड़ाआं एकी तुकडीही आन मुख्य पुंजारकाहां आन फरिसीइ पावरोहों लेत कोइत, दिवा, मशाली आन आथार्‍ये लेत कोइत तिहीं आयू. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />ताहां ईसु, तियीं आखी गोठीही जे तियापोअ आवनारी ओती जांइत कोइत, आगाड़ी आयु आन तियांहां कोयो, “तुमू कोडाहा होदताहा?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />तियां तियाहा उत्तर आप्यो, “ईसु नासरीही.” ईसु तियांहां कोयो,</para>
  <para style="p" vid="JHN 18:5">“तो आंय होय.”</para>
  <para style="p" vid="JHN 18:5">तियाहा धोकू देत तोइत आपनारु यहुदा बी तियांअरी उबोइत रोयुतो. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />तियाआ ओं कोताज, के “आंय होय,” ते फासाड़ी ओहरीत कोइत पुयींपोअ लोटीत गोया. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />ताहां ईसु फाशोअ तियांहां फुशो, “तुमू कोडाहा होदताहा?”</para>
  <para style="p" vid="JHN 18:7">तियां कोयो, “ईसु नासरीही.”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />ईसु उत्तर आप्यो, “आंय ते तुमुहूं कोत सुकुहू के आंय होय, जर तुमू माहूं होदता ओय, ताहां यांहां जाअहूं द्या.” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />ओं याअकाजे ओवयो के तो वसन पुरो ओवुहूं जोवे जो तिये कोयोतो: “जियांहां तुमे माहूं आप्येहे तियांमेर्‍येए आंय एकाहा बी ने टाकाअहूं देंव.”<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />ताहरुउ शिमोन पेत्रे तलवार, जे तियापोअ ओती, काड्यी आन डाया पुंजाराआ सेवकोअ हाजाड़्यु कान तोड़ीत टाक्यु. तिया पावरोअ नाव मलखुस ओतो. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />ताहां ईसु पेत्राहा कोयो, “ताआ तारवाआ म्यानोम मिक. जो दुखोअ वाटकू आब्हे माहूं आप्युहू, केहें आंय तियाहा ने पिवें?”<verse eid="JHN 18:11" /></para>
  <para style="s">हन्नाआ सामने ईसु</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />ताहां रोमन तुकड़ीइ सिपायडां आन तियांआं आधिकारी आन यहुदीइ मंदिरोअ पावरहों ईसुहू तोइत कोइत बांदीत लेदू, <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />आन पेल तियाहा हन्नाअ जागे लेत गोये, काहाके तो तिया वोरह्योअ डायु पुंजारु कैफाआ होवरुह्हू ओतू. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />ओ तोज कैफा ओतू, जिये यहुदीही सल्लू आप्युतो के आपाअ आखा माअहुंउं काजे एका माट्योअ मोइलाअ हाजो होय.<verse eid="JHN 18:14" /></para>
  <para style="s">पेत्राअ पेहलु नाकार</para>
  <para style="r">(<ref loc="MAT 26:69">मत्तय 26:69</ref>,<ref loc="MAT 26:70">70</ref>; <ref loc="MRK 14:66-68">मार्क 14:66-68</ref>; <ref loc="LUK 22:55-57">लुक 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />शिमोन पेत्र आन एक बिहीरु सेलू बी ईसुउ फासाड़ी जाना वोल्या. ओ सेलू डाया पुंजाराआ ओलखातीइ ओतू, तियाहा काजे तो ईसुउ आरी डाया पुंजारकाआ राजवाड़ामेहें गोयू, <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />पोन पेत्र बारथे बाओअ जागे उबू रोयू. ताहां तो बिहीरु सेलू जो डाया पुंजाराआ ओलखातीइ ओतू, बारथे निहींयू आन जागल्यीही कोत कोइत पेत्राहा मायते लेतायु. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />ते पावरीइं जे जागल्यी ओती, तियी पेत्राहा कोयो, “केहें तू बी या माहुंउं सेलामेर्‍युउ ते नाहां?”</para>
  <para style="p" vid="JHN 18:17">तिये कोयो, “नाहां, आंय नाहां.”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />नोवकर आन पावर हियालाआ वोजेसे कोल्या पेटाड़ीत कोइत आगी हेकाअताते, आन पेत्र बी तियांअरी उबू रोत कोइत आगी हेकाअतुतो.<verse eid="JHN 18:18" /></para>
  <para style="s">ईसुहू प्रश्न फुसनारु पुंजारु</para>
  <para style="r">(<ref loc="MAT 26:59-66">मत्तय 26:59-66</ref>; <ref loc="MRK 14:55-64">मार्क 14:55-64</ref>; <ref loc="LUK 22:66-71">लुक 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />ताहां डाये पुंजारे ईसुहू तियाआ सेलाअ बाप्तिम आन तियाआ हिकवणोअ बाप्तिमेहें प्रश्न फुशो. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />ईसु तियाहा उत्तर आप्यो, “आंय दुन्याआं विसमेहें आखाअरी खुल्लामखुल्ली गोठी कोअयी; आंय यहुदी आराधनालयोमेहें आन मंदिरोमेहें, जिहीं आखे यहुदी टोलू वोल्या कोअतेहे, सादा सिकाड़तू रोयु आन निकाड़ीत कोइत किज बी नाहां कोयो. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />तू माहूं काहा फुसेहे? उनाअनाराहां फुस के आंय तियांहां कि कोयोहो. पाल, तियांहां मुंदू होय के आंय कि कि कोयोहो.”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />जेहेलाम तिये ओं कोयो, ताहां मंदिरोअ पावरोमेर्‍येए एके जोएं जो तियाआ आहने उबू रोयुतो, ईसुहू थापुड़ देत कोइत कोयो, “तुमे पुंजाराहा एहेंकोइत उत्तर आपीइलोअ हिम्मत केहें कोइत कोअयी?”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />ईसु तियाहा उत्तर आप्यो, “जर आंय काविंहीं सुकीइ कोअयीय, ताहां तियी सुकीइ पुरावू आप; पोन जर आंय बोराबर कोयो, ताहां तु माहूं काहा देहे?”<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />ताहां हन्ने तियाहा बांदल्युज कैफा डाया पुंजाराअ जागे मोकली देदू.<verse eid="JHN 18:24" /></para>
  <para style="s">पेत्राआ बेन आन तिन वारी ईसुहू नाकारीइलो</para>
  <para style="r">(<ref loc="MAT 26:71-75">मत्तय 26:71-75</ref>; <ref loc="MRK 14:69-72">मार्क 14:69-72</ref>; <ref loc="LUK 22:58-62">लुक 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />शिमोन पेत्र उबू रोत आगी हेकाअतुतो. ताहां तियां तियाहा कोयो, “केहें तू बी तियाआ सेलामेर्‍युउ ते नाहां?”</para>
  <para style="p" vid="JHN 18:25">तिये नाकारीत कोइत कोयो, “आंय नाहां.”<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />डाया पुंजाराआ सेवकोमेर्‍युउ एक, जो तियाआ कुटूंबामेर्‍युउ ओतू जियाअ कान पेत्रे तोड़ीत टाक्युतो, कोयो, “केहें आंय ताहूं तियाअरी बोगिसामेहें नाहां देख्यू के?”<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />यावाअहीं पेत्रे फाशोअ नाकारी देदो, आन तेहेलाम कुकड़े वाहीं देदो.<verse eid="JHN 18:27" /></para>
  <para style="s">पिलातोअ सामने ईसु</para>
  <para style="r">(<ref loc="MAT 27:1">मत्तय 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">मार्क 15:1-5</ref>; <ref loc="LUK 23:1-5">लुक 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />ताहराअ ते ईसुहू कैफाआ जागे रोत राज्यपालोअ राजवाड़ाम लेत मोकल्यू, आन हांजेए वेल ओती, पोन ते सोताहा राज्यपालोअ राजवाडामेहें नाहां गोया काहाके एठा ने ओवुहूं जोवे पोन वल्हांडणोअ रोटू खात सेके. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />ताहां पिलात तियांआं जागे बारथे निहीत आयू आन कोयो, “तुमू या माट्यो पोअ कोड्ली गोठीइ गुनू लागाड़ताहा?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />तियां तियाहा उत्तर आप्यो, “जर तो पापी ने रोतु ताहां आमू तियाहा ताआ आथोम ने होपता.”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />पिलाते तियांहां कोयो, “तुमूज याहा लेत जात कोइत तुमाआं कायदाअ पुरमाणे तियाआ न्याय कोआ.” यहुदी तियाहा कोयो,</para>
  <para style="p" vid="JHN 18:31">“आमुहूं आधिकार नाहां के कोडाअ जिव लेंव.”<verse eid="JHN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 18:32" />ओं याअकाजे ओवयो के ईसुउ ते गोठी पुरी ओवुहूं जोवे जे तिये ओ इशारु कोइत कोयीते के तियाआ मोत कि कोइत ओवे.<note caller="+" style="f"><char style="fr" closed="false">18:32 </char><char style="xt" closed="false"><ref loc="JHN 3:14">योहान 3:14</ref>; <ref loc="JHN 12:32">12:32</ref> </char></note><verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />ताहां पिलात फाशुउ राजवाड़ाअ मायते गोयू, आन ईसुहू हादीत कोइत तियाहा फुशो, “केहें तू यहुदीइ राजा होय?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />ईसु उत्तर आप्यो, “केहें तू ए गोठ सोताहाज कोहे के बिहीरे माआं बाप्तिमेहें ताहूं ओं कोयोहो?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />पिलाते उत्तर आप्यो, “केहें आंय यहुदी होय? ताआज जातीइ माअहूं आन मुख्य पुंजारा ताहूं माआ आथोम होप्युहू. तुमे कि कोअयोहो?”<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />ईसु उत्तर आप्यो, “माआं राज यी दुन्याअ नाहां; जर माआं राज यी दुन्याअ रोतो, ताहां माआं सेवक लड़ाय कोअता के आंय यहुदीइ आथोम ने होपाअहूं जोवे: पोन माआं राज इंहींइं नाहां.”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />पिलाते तियाहा कोयो, “ताहां केहें तू राजा होय?” ईसु उत्तर आप्यो, “तू कोहे के आंय राजा होय. आंय याअकाजे जल्म लेदो आन याअकाजे दुन्याम आवयुहू के सत्याआ साक्शी आपो. जो कोडो सत्याआ होय, तो माआं शब्द उनाअहे.”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />पिलाते तियाहा कोयो, “सत्य कि होय?” ओं कोत कोइत तो फाशुउ यहुदीइ जागे निहीत आवयू आन तियांहां कोयो, “माहूं ते तियामेहें किज दोस नाहां देखाअतू. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />पोन तुमाआं ए रीत होय आंय वल्हांडण तिवारोम तुमाआं काजे एका माहुंहूं सोड़ी देंव. केहें तुमाआं इश्शा होय के आंय तुमाआं काजे यहुदीइ राजाहा सोड़ी देंव?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />ताहरेए ते फाशेए आअड़ीत कोइत कोयो, “याहा नाहां, पोन आमाआं काजे बरब्बाहा सोड़ी दे.” आन बरब्बा डाखू ओतू.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s">ईसुहू मोतोअ डोंडोअ आदेश</para>
  <para style="r">(<ref loc="MAT 27:15-31">मत्तय 27:15-31</ref>; <ref loc="MRK 15:6-20">मार्क 15:6-20</ref>; <ref loc="LUK 23:13-25">लुक 23:13-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />ताहरुउ पिलाते ईसुहू सापका देअहूं लागाड़्या. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />सिपायडां काटाआ एक पागड़ी गुथीत कोइत तियाआ मुंडोम पेवाड़ी देदी, आन तियाहा एक जामण्यो आंगड़ो पेवाड़्यो, <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />आन तियाआ आहने आवी-आवीइ कोना वोल्या, “ए यहुदीइ राजा, ताआ जयजयकार ओवे!” आन तियाहा थापड़े वाअहीं बी देदू.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />ताहां पिलाते फाशुउ बारथे निहीत कोइत माहुंहूं कोयो, “पाला, आंय तियाहा तुमाआं जागे फाशुउ बारथे लेत आवोहो; काहाके तुमू जाअहूं जोवे के माहूं तियामेहें किज दोस नाहां देखाअतू.” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />ताहरुउ ईसु काटाआ पागड़ी आन जामण्यो आंगड़ो पोवित कोइत बारथे निहीयु; आन पिलात तियांहां कोयो, “पाला, ओ होय तो माटी!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />जाहां मुख्य पुंजारा आन मंदिरोअ पावरों तियाहा पाल्य, ताहां आअड़ीत कोइत कोयो, “याहा क्रुस खांबोपोअ टांगा, याहा क्रुसोपोअ टांगा!” पिलात तियांहां कोयो, “तुमूज याहा लेत जावा आन क्रुस खांबोपोअ टांगा, काहाके माहूं तियामेहें किज गुनू नाहां देखाअतू.”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />यहुदी तियाहा उत्तर आप्यो, “आमाआं बी कायदु होय आन तिया कायदाआ पुरमाणे तो माइत टाकुहूं जोगुहू होय, काहाके तो सोताहा देवोअ बेटुह्हू कोत समजेहे.”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />जाहां पिलात ए गोठी उनाअयू ताहां जाअखुज बित गोयू, <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />आन फाशुउ राजवाड़ाआ मायते गोयू आन ईसुहू कोयो, “तू काआ होय?”</para>
  <para style="p" vid="JHN 19:9">पोन ईसु तियाहा किज उत्तर ने आप्यो. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />पिलाते तियाहा कोयो, “माअरी काहा ने गोगत्लू? केहें ताहूं ने मुंदू के ताहूं सोड़ीइलाअ आधिकार माहूं होये आन ताहूं क्रुसोपोअ टांगीइलाअ बी माहूं आधिकार होय?”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />ईसु उत्तर आप्यो, “तुमुहूं ताअहूं जाआं मापोअ आधिकार ने ओतू जाअहूं जाआं उसे रोत ने जोड़तू, ताहां ताआ मापोअ किज आधिकार ने रोतू; तियाहा काजे जिये माहूं ताआ आथोम तोइत आप्युहू तियाआ पाप वादार होय.”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />इहींप रोत पिलात तियाहा सोड़ी देअलो ईतव्यो, पोन यहुदी आअड़ी-आअड़ीइ कोयो, “जर तू याहा सोड़ी देही, ताहां तू कैसरोअ दोस्ती नाहां. जों कोडो सोताहा राजा बोणावेहे तों कैसरोअ विरोद कोअहे.”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />ए गोठी उनाइत कोइत पिलात ईसुहू बारथे लेतायू आन तिहीं एक जागू ओतू जियाहा इब्री बाशामेहें “गब्बथा” कोतेहे, आन तिहीं तो न्यायगादीपोअ बोहीत गोयू. <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />ओ वल्हांडण तिवार आठीवड़ाआ तियारीइ दिही ओतू, आन ते माजन्या दिहोअ वेल ओती. ताहां तिये यहुदीही कोयो, “पाला तुमाआं राजा!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />पोन तें आअड़्ये, “याहा लेत जावा! याहा लेत जावा! याहा क्रुसोपोअ टांगा!”</para>
  <para style="p" vid="JHN 19:15">पिलाते तियांहां कोयो, “केहें तुमाआं इश्शा होय आंय तुमाआं राजाहा क्रुसोपोअ टांगो?”</para>
  <para style="p" vid="JHN 19:15">मुख्य पुंजारा उत्तर आप्यो, “कैसरोहो सोड़ीत आमाआं बिहीरु कोड्लूज राजा कायने.”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />ताहां पिलात तियाहा तियांआं आथोम होपी देदू के तें क्रुसोपोअ टांगुहूं जोवे, आन एहें कोइत तियां ईसुहू ताबाम लेत लेदू.<verse eid="JHN 19:16" /></para>
  <para style="s">ईसुहू क्रुस खांबो पोअ टांगीइलो</para>
  <para style="r">(<ref loc="MAT 27:32-44">मत्तय 27:32-44</ref>; <ref loc="MRK 15:21-32">मार्क 15:21-32</ref>; <ref loc="LUK 23:26-43">लुक 23:26-43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />ताहरेए ते ईसुहू लेत गोये, आन तो तियाआ क्रुस आखलीत कोइत “मुन्काआ खोबज्यो” कोतेहे तियी जागे जाआं लेत गोयू, आन तियाहा इब्री बाशामेहें “गुलगुता” कोतेहे. <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />तिहीं ते तियाहा आन तियाअरी फाशाआ बेन माट्योहो क्रुसोपोअ टांग्या, एकाहा यी वोग आन एकाहा तिवोग, आन विसमेहें ईसुहू. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />पिलाते एक दोस-पत्र लेखीत कोइत क्रुसोपोअ ठोकी देदो, आन तियामेहें ओं लेखल्यो ओतो, “ईसु नासरी, यहुदीइ राजा.” <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />ओं आरोप-पत्र जाअखीलाहा यहुदी वाश्यो, काहाके तो जागू जिहीं ईसुहू क्रुसोपोअ टांग्युतो गांवोंअ आहने ओतू; आन पत्र इब्री आन लटीन आन ग्रीक बाशामेहें लेख्योतो. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />ताहां यहुदीइ मुख्य पुंजारा पिलातोहो कोयो, “‘यहुदीइ राजा’ एहें कोइत मा लेखीही, पोन ‘तिये कोयो, आंय यहुदीइ राजा होय.’ एहें कोइत लेख.”<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />पिलाते उत्तर आप्यो, “आंय जों लेखी देदो, तों लेखी देदो.”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />जाहां सेयनिक ईसुहू क्रुसोपोअ टांगीत सुका, ताहां तियाआ आंगड़ो लेदो आन तियाआ शार भाग कोअया, हारेक सेयनिकोअ काजे एक भाग, आन कुरतु बी लेदू; पोन तो कुरतु विण सिल्लायीइ उसे रोत निसे जाआं गुथल्यु ओतू. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />तियाहा काजे तियां सिपायड़ां कोयो, “आपू याहा नाहां फाड़ता, पोन ओं कोडाआ ओवे तों यापोअ सिट्टी टाकीत पालत्ला.” ओं याअकाजे ओवो के वसनोमेहें जों लेख्योहो तों पुरो ओवुहूं जोवे,</para>
  <para style="q1" vid="JHN 19:24">“तियां माआं आंगड़े जिवजिवोअ वाटित लेदे,</para>
  <para style="q2" vid="JHN 19:24">आन माआं आंगड़ापोअ सिट्टी टाक्यी.” तियाहा काजे सिपायडां तेहेंज कोअयो.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />ईसुउ क्रुस खांबोअ आहने तियाआ आयही, आन तियाआ आजलीह्ही, क्लोपासोअ लाडी मरिया, आन मरिया मग्दालिनी उबी ओती. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />जाहां ईसु तियाआ आयही, आन तियाआ मेराला सेलाहा जिया पोअ तो मेर कोअतुतो आहने उबू रोल्यू देख्यू, ताहां तियाआ आयहीही कोयो, “ए बाय, पाल, ओ ताआ बेटुह्हू होय.”<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />ताहां तिये सेलाहा कोयो, “ए ताआ आयही होय.” आन तियीज वेले रोत तो सेलू तियीही तियाआ कोअ लेत गोयू.<verse eid="JHN 19:27" /></para>
  <para style="s">ईसुउ मोत</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्तय 27:45-56</ref>; <ref loc="MRK 15:33-41">मार्क 15:33-41</ref>; <ref loc="LUK 23:44-49">लुक 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />याअ फासाड़ी ईसु ओं जांइत कोइत के ओमे आखो पुरो ओत सुको, वसनोमेहें जो लेखाअयोहो तो पुरो ओवुहूं जोवे काजे कोयो, “आंय तिहील्यू होये.”<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />तिहीं कड़वू रोह पोइत मिकल्यो एक बासन ओतो, ताहराआ तियां कड़वा रोहोम बुसकाड़ल्या स्पंजोहो<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="fq" closed="false">स्पंज </char><char style="ft" closed="false">पाईं, रोह एहेलोह सुंहनारो दोर्‍याम रोनारो साराल्लोहो जिव-जंतू.</char></note> एका डाफाआ हुयाला सुटक्यापोअ खोसकावीत तियाआ सोबीइरी लागाड़्यो. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />जाहां ईसु कड़वू रोह पिदू, ताहां कोयो, “पुरो ओवो!”</para>
  <para style="p" vid="JHN 19:30">आन निसे मुंड कोइत जिव सोड़ी देदू.<verse eid="JHN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />ओ वल्हांडणोअ तियारीइ दिही ओतू, यहुदी पिलातोहो विनंती कोअयी के तो आदेश आपे के तियांआं गुडा तोड़ी देअहूं जोवे आन तियांहां उतारुहूं जोवे, काहाके आरामोअ दिही तियांआं तोड़े क्रुसोपोअ ने रोअहूं जोवे, काहाके तो आरामोअ दिही तियांआं महत्वाआ दिही ओतू. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />ताहराअ सैनिकहों आवित कोइत तियांमेर्‍याअ पेहलाआ गुडा तोड़्या आन दुसराआ बी तोड़्या, जियांहां तियाअरी क्रुस खांबोपोअ टांग्याते; <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />पोन जाहां ईसुउ जागे आवित कोइत पाल्यो के तो मोइत गोयुहू, ताहराआ तियाआ गुडा ने तोड़्या. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />पोने सैनिकोंमेर्‍युउ एके जोएं तियाआ खुकीम डाफो खोसकाड़्यो, आन तियाम रोत सालुज रक्त आन पाईं निहींयो. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />जिये ओं देख्यो, तिये साक्शी आप्यीही, आन तियाआ साक्शी खोरी होय; आन तियाहा मुंदू होय के तो खोरो कोहे के तुमू बी विश्वास कोआ. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />ए गोठी याअकाजे ओवी के वसनोमेऱ्योअ जो कोयोहो तो पुरो ओवुहूं जोवे, “तियाआ कोड्लोज आड ने तोड़ाय.” <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />फाशोअ बिहीरी एकी जागे बी वसन एहें कोइत लेख्योहो, “जियां तियाम डाफो खोसकाड़्योहो, तें तियाहा देखे.”<verse eid="JHN 19:37" /></para>
  <para style="s">ईसुहू डाटीइलो</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्तय 27:57-61</ref>; <ref loc="MRK 15:42-47">मार्क 15:42-47</ref>; <ref loc="LUK 23:50-56">लुक 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />यीं गोठीइ फासाड़ी अरमितीयावाले योसेफे जो ईसुउ सेलू ओतू, पोन यहुद्याआं बिके वाअहीं ए गोठ निकाड़ीत मिक्यी, तिये ईसुउ तोड़ लेत जाअलो काजे पिलातोहो रावणी कोअयी. पिलाते तियाआ रावणी मान्य कोअयी, आन तो आवित कोइत तियाआ तोड़ लेत गोयू. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />निकुदेमुस बी, जो पेल ईसुउ जागे राती गोयुतो.<note caller="+" style="x"><char style="xo" closed="false">19:39 </char><char style="xt" closed="false"><ref loc="JHN 3:1">योहान 3:1</ref>,<ref loc="JHN 3:2">2</ref> </char></note> एक आंदास तीस किलो गिऱ्याम अत्तर आन कुवरफाडी नेहें सान्बीइल्यो वस्तु तोड़ोपोअ लागाड़ीइलोअ काजे लेतायू. ताहराआ ते ईसुउ तोड़ लेत गोया. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />यहुदीइ डाटीइलाअ रितीइ पुरमाणे तियाहा हाजो गुंदाअनारो मासालो हारीत कफनोमेहें गुउंटावीत लेदू. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />तिया जागापोअ जिहीं ईसुहू क्रुसोपोअ टांग्युतो, एक बोगिसू ओतू, आन तिया बोगिसाम एक नोवी कबर ओती जियीमेहें केदिहींज कोडाहा ने मिक्योतो. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />काहाके ओ यहुद्याआं आरामोअ दिहोअ पेल्लुउ दिही ओतू, तियाहा काजे तियां ईसुउ तोड़ोहो तियाजमेहें मिक्यो, काहाके ते कबर आहने ओती.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">ईसुउ फाशोअ जिवीत उठीइलाअ</para>
  <para style="r">(<ref loc="MAT 28:1-8">मत्तय 28:1-8</ref>; <ref loc="MRK 16:1-8">मार्क 16:1-8</ref>; <ref loc="LUK 24:1-12">लुक 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />दितवारोअ दिही सिंजीवड़ाअरीही जाहां आंदारोज ओतो, मरिया मग्दालिनी माहणोअहीं आवयी, आन डोणोहो माहणों पोअ रोत होरकीइल्यु देख्यू. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />ताहां ते गुगद्यी आन शिमोन पेत्र आन तिया बिहीरा सेलाअ जागे जिया पोअ ईसु मेर कोअतुतो, आवित कोइत कोयो, “ते प्रभुहू माहणोमेहें रोत काडीत लेत गोयेहे, आन आमुहूं नाहां मुंदू के तियाहा का मिकी देदुहू.”<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />ताहां पेत्र आन तो बिहीरु सेलू निहीत कोइत माहणोंअहें जाना वोल्या. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />ते बेनू आरी-आरीज गुगदीइताते, पोन बिहीरु सेलू पेत्राहा फासाड़ी टाकीत कोइत कबरेपोअ पेल पोत्यु; <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />आन उसावित कोइत कफनोअ साअके पोड़ीत रोल्ये देख्ये, तेबी तो मायते नाहां गोयू. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />ताहां शिमोन पेत्र तियाआ फाटी-फाटीज पोत्यु, आन कबरेए मायते गोयू आन साअके पोड़ीत रोल्ये देख्ये; <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />आन तो रुमाल जो तियाआ मुंडोअरी बांद्युतो साअकाअरी पोड़ीत रोल्यू नाहां, पोन आंगेज एकी जागे सुंउडु वालित कोइत मिकल्यू देख्यू. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />ताहां बिहीरु सेलू बी जो कबरेपोअ पेल पोत्युतो, मायते गोयू आन पालित कोइत विश्वास कोअयू. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />ते बेनू ओमे जाआं वसनोअ ते गोठी ने समज्याते के तियाहा मोल्यामेहें रोत जिवीत उठीइलोअ ठरल्योज होय.<verse eid="JHN 20:9" /></para>
  <para style="s">मरिया मग्दालीइ सामने ईसुउ दर्शन</para>
  <para style="r">(<ref loc="MAT 28:9">मत्तय 28:9</ref>,<ref loc="MAT 28:10">10</ref>; <ref loc="MRK 16:9-11">मार्क 16:9-11</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 20:10" />ताहां ए सेला तियांआं कोअ वोलीत जाता रोया.<verse eid="JHN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />पोन मरिया रोड़ती रोड़ती कबरेए आहनेज बारथे उबी रोयी, आन रोड़ी-रोड़ीइ कबरेमेहें उसावित पाल्यो, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />जिहीं ईसुउ तोड़ मिक्योतो तिहीं उजले आंगड़े पोवित कोइत बेन देवदुतोहो एकाहा मुंडोअहें आन एकाहा गुडाअ वोलेहे बोहीत रोल्या देख्या.<verse eid="JHN 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13" />तियां तियीही कोयो, “ए बाय, तू काहा रोड़ेहे?”</para>
  <para style="p" vid="JHN 20:13">तियी तियांहां कोयो, “ते माआं प्रभुहू आखलीत लेत जाते रोये आन माहूं नाहां मुंदू के तियाहा का मिक्युहू.”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />ओं कोत कोइत ते फासाड़ी फिर्‍यी आन ईसुहू उबू रोल्यू देख्यू, पोन ने ओलख्यु के ओ ईसु होय.<verse eid="JHN 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15" />ईसु तियीही कोयो, “ए बाय, तू काहा रोड़ेहे? कोडाहा होदेहे?”</para>
  <para style="p" vid="JHN 20:15">तियी बोईं बोगिसाअ राखवाली समजीत कोइत तियाहा कोयो, “मालिख, जर तुमू तियाहा लेत गोयेय ताहां माहूं कोत द्या, तियाहा का मिक्युहू, आन आंय तियाहा लेत जाहीं.”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />ईसु तियीही कोयो, “मरिया!” ते फासाड़ी फिरीत कोइत तियाहा इब्रीमेहें कोयो, “रब्बुनी!” मोन्ज्ये “गुरुजी”<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />ईसु तियीही कोयो, “माहूं आथ मा लागाड़ही, काहाके आंय ओमे जाआं देव आब्हाआ जागे उसे नाहांजी गोयू, पोन माआं पायहोंअ जागे जात कोइत कोत दे, के आंय माआं देव आब्हू आन तुमाआं देव आब्हू, आन माआं देव आन तुमाआं देवोअ जागे उसे जाहो.”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />मरिया मग्दालिनी जात कोइत सेलहांहां कोयो, “आंय प्रभुहू देख्यू, आन तिये माहूं ए गोठी कोयी.”<verse eid="JHN 20:18" /></para>
  <para style="s">सेलाआं सामने ईसु दर्शन आपत्लू</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्तय 28:16-20</ref>; <ref loc="MRK 16:14-18">मार्क 16:14-18</ref>; <ref loc="LUK 24:36-49">लुक 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />तेदिहींज दितवारोअ दिही, हांजेए वेले जेहेलाम यहुदीइ बिके वाअहीं जिहीं सेला ओता तिहींइं बाअणे बोंद ओते, तेहेलाम ईसु तिहीं आवित आन तियांआं विसमेहें उबू रोत कोइत तियांहां कोयो, “तुमुहूं शांती जोड़ुहूं जोवे.”<verse eid="JHN 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 20:20" />आन ओं कोत कोइत तिये तियाआ आथ आन तियाआ खुकी तियांहां देखाड़्यी. ताहां सेला प्रभुहू देखीत कोइत जास्ती खुस ओवा.<verse eid="JHN 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21" />ईसु फाशुउ तियांहां कोयो, “तुमुहूं शांती जोड़ुहूं जोवे; जेहेंकोइत देव आब्हे माहूं मोकल्युहू, तेहेंज कोइत आंय बी तुमुहूं मोकलोहो.”<verse eid="JHN 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 20:22" />ओं कोत कोइत तिये तियांपोअ फुक्यो आन तियांहां कोयो, “पवित्र आत्माहां ल्या! <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />जर एखाआ पाप तुमू माफ कोअतेहे, ताहां तियांआं काजे माफ कोआयेहे; जिया एखा तुमू मिकतेहे, ताहां तें रोत गोयेहे.”<verse eid="JHN 20:23" /></para>
  <para style="s">ईसु आन थोमा</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />पोन बारा जोओंमेर्‍युउ एक, मोन्ज्ये थोमू जो दिदमुस मोन्ज्ये जेड़ख्यू कोवाअहे, जाहां ईसु आवल्यु ताहां तियांआं आरी ने ओतू. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />जाहां बिहीरा सेला तियाहा कोना वोल्या, “आमू प्रभुहू देख्युहू,”</para>
  <para style="p" vid="JHN 20:25">ताहां तिये तियांहां कोयो, “जाअहूं जाआं आंय तियाआ आथोमेहें खिलाआ डुसाला ने पालीत लेंव, आन खिलाआ डुसालामेहें माआं आंगली ने टाकीत पालित लेंव, ताअहूं जाआं आंय विश्वास ने कोअनारु.”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />एका आठीवड़ाआ फासाड़ी तियाआ सेला फाशाअ कोअमेहें ओता, आन थोमू बी तियांअरी ओतू; आन बाअणे बोंद ओते, ताहां ईसु आयू आन तियांआं विसमेहें उबू रोत कोइत कोयो, “तुमुहूं शांती जोड़ुहूं जोवे.” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />ताहां तिये थोमाहां कोयो, “ताआ आंगुउ इंहीं लेतावीत माआं आथोम टाकित पाल आन ताआ आथ माआं खुकिम टाक, विणविश्वाशु मा रोही, पोन विश्वासी बोण.”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />ओं उनाइत थोमे उत्तर आप्यो, “माआं प्रभु, माआं देवा!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />ईसु तियाहा कोयो, “तुमे माहूं पाल्युहू, केहें याअ काजे विश्वास कोअयुहू? धन्य ते होय जियां विण देख्येज विश्वास कोअयू.”<verse eid="JHN 20:29" /></para>
  <para style="s">या पुस्तकोअ उद्देश</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />ईसु फाश्येए बी जाअखीलेहे समत्कारोअ कामे सेलाआं सामने देखाड़्ये, जें या पुस्तकोमेहें नाहां लेखाअये; <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />पोन एं याअकाजे लेखाअयेहे के तुमू विश्वास कोअहूं जोवे के ईसुज देवोअ बेटुह्हू ख्रिस्त होये, आन विश्वासो वाअहीं तियाआ नावसे तुमुहूं जिवन जोड़ुहूं जोवे.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">ईसुउ हांत सेलाहा दर्शन</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />यीं गोठीइ फासाड़ी ईसु सोताहा तिबिरियास दोर्‍याअ मेरे सेलाहां दर्शन आप्यो, आन तो एहें कोइत आप्यो: <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />शिमोन पेत्र, आन थोमू जो जेड़ख्यू कोवाअहे, आन गालीलोअ कानावालू नथनेल, आन जब्दीइ पोऱ्या, आन ईसुउ सेलामेर्‍याआ बेन जोओं मिलीत आखा टोलू वोलीत रोयाते. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />शिमोन पेत्रे तियांहां कोयो, “आंय मासे तोऊ जाहो.”</para>
  <para style="p" vid="JHN 21:3">तियां तियाहा कोयो, “आमू बी ताअरी आवताहा.” ताहराअ ते निहीत कोइत नावड़ाम बोठा, पोन तियी राती किज ने तोअयो. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />हुजता हुजता ईसु पाअयोंअ मेरे आवित उबू रोयू; तेबी सेलहां ने ओलख्यु के ओ ईसु होय. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />ताहां ईसु तियांहां कोयो, “पोर्‍यां, केहें तुमापोअ वाजीहीं मासे होय के?”</para>
  <para style="p" vid="JHN 21:5">तियां उत्तर आप्यो, “कायने.”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />तिये तियांहां कोयो, “नावड़ाअ हाजाड़्यीइ वोल जाल टाकहा ताहां तुमुहूं कि तेबी मिले.” ताहराअ तियां जाल टाक्यी, आन ओमे मासे जाअखीलेहे तिहीं वाअहीं जालेहे खेसीत ने सेका.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />ताहां तिये सेले जियापोअ ईसु मेर कोअतुतो, पेत्राहा कोयो, “ओ ते प्रभु होय!” शिमोन पेत्रे ओं उनाइत कोइत के तो प्रभु होय, कंबरेएरी साअको बांदीत लेदो, काहाके तो उगड़ाअलुज ओतू, तालावोमेहें उडीत पोड़्यु. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />पोन बिहीरा सेला नावड़ापोअ मासावाअहीं पोआली जाल खेसता खेसता आया, काहाके ते मेरेपोअ रोत वादार सेटे ने ओता, पोन एहेलाहा एक होव मिटर सेटे ओय. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />जेहेलाम ते मेरेपोअ उतर्‍या, ताहां तियां आराआ आग आन तियीपोअ मासे मिकल्ये, आन रोटू देख्यू. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />ईसु तियांहां कोयो, “जे मासे तुमू ओमे तोअयेहे, तियांमेर्‍येए थोड़ेक लेतावा.”<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />ताहां शिमोन पेत्र नावड़ापोअ सोढ़ीत कोइत 153 वोडे मासावाअहीं पोआली जाल मेरेपोअ आपक्यी, आन एवडे मासे ओते तेबी जाल नाहां फाट्यी. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />ईसु तियांहां कोयो, “आवा, रोटू खावा.” सेलामेर्‍याअ कोडाहा हिम्मत ने ओवयी के तियाहा फुसो, “तू कोडो होय?” काहाके ते जांअताते के ओ प्रभुज होय. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />ईसु आयु आन रोटू विसीत कोइत तियांहां आप्यू, आन तेहेंज कोइत मासे बी.<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />ओं तिसरीवारी होय के ईसु मोल्याम रोत जिवीत उठीइलाअ फाटी सेलाहां देखाअयू.<verse eid="JHN 21:14" /></para>
  <para style="s">ईसु आन पेत्र</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />रोटू खाअलाअ फासाड़ी ईसु शिमोन पेत्राहा कोयो, “शिमोन, योहानोअ पोर्‍या, केहें तू यांरोत वादार मापोअ मेर कोअहे?” तिये तियाहा कोयो, “होव, प्रभु; ताहूं ते मुंदू होय के आंय तापोअ मेर कोअहो.” ईसु तियाहा कोयो, “माआं गिद्लाहां सार.”<verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />तिये फाशोअ बिहरीवारी तियाहा कोयो, “शिमोन, योहानोअ पोर्‍या, केहें तू मापोअ मेर कोअहे?” तिये तियाहा कोयो, “होव, प्रभु; ताहूं मुंदू होय के आंय तापोअ मेर कोअहो.” तिये तियाहा कोयो, “माआं मेडाअ राखवाली कोओ.”<verse eid="JHN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17" />आन ईसु तिसरी वारी तियाहा कोयो, “शिमोन, योहानोअ पोर्‍या, केहें तू मापोअ मेर कोअहे?” पेत्र नाराज ओवयू के तिये तियाहा तिसरीवारी जाआं एहेंज कोइत कोयो, “केहें तू मापोअ मेर कोअहे?” आन तियाहा कोयो, “प्रभु, ताहूं ते आखो मुंदू होय; तू ओं जाअहें के आंय तापोअ मेर कोअहो.”</para>
  <para style="p" vid="JHN 21:17">ईसु तियाहा कोयो, “माआं मेडाहां सार. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />आंय ताहूं खोरीज कोहो, जेहेलाम तू जुवान ओतू ताहां सोताआ कंबर बांदीत कोइत जिहीं इत्वीइतुतो तिहीं फिरतुतो; पोन जाहां तू डायु ओवीही ताहां ताआ आथ पसरावही, आन बिहीरो ताआ कंबर बांदीत कोइत जिहीं तू ने जाअहूं होदही तिहीं ताहूं लेत जाय.”<verse eid="JHN 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 21:19" />ईसु यीं गोठीवाअहीं ईसारु आप्यु के पेत्र केहेलाहा मोतो वाअहीं देवोअ महिमा कोए. आन ताहां ईसु तियाहा कोयो, “माआं फासाड़ी आव.”<verse eid="JHN 21:19" /></para>
  <para style="s">ईसुउ मेरालु सेलू</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />पेत्र वोलीत कोइत तिया सेलाहा फासाड़ी आवत्लू देख्यू, जियापोअ ईसु मेर कोअतुतो, आन जिये रोटू खाअलाअ वेले तियाआ सातीइहें ओंणाइत कोइत फुशोतो, “प्रभु, ताहूं धोकू देत तोआड़नारु कोडु होय?” <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />तियाहा देखीत कोइत पेत्रे ईसुहू कोयो, “प्रभु, याअ बाप्तिम की?”<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />ईसु तियाहा कोयो, “जर माआं इश्शा ओय के तो आंय दुसरीवारी आविहीं ताअहूं जाआं रोय, ताहां ताहूं याअरी कि? तू माआं फासाड़ी आव.”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />तियाहा काजे पायहोंमेहें ए गोठ पसरीत गोयी के तो सेलू ने मोअनारु; तेबी ईसु तियाहा ओं नाहां कोयो के तो ने मोए, पोन ओं कोल्यो के, “जर माआं इश्शा ओय के तो माआं आविइलाअ वेले जाआं रुकाइत रोय, ताहां ताहूं याअरी कि?”<verse eid="JHN 21:23" /></para>
  <para style="s">समाप्ती</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />आन ओ तोज सेलू होय जो यीं गोठीइ साक्शी आपेहे आन जिये यीं गोठीही लेख्यीही, आन आमुहूं मुंदू होय के तियाआ साक्शी खोरी होय.<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />फाशे बी जाअखीलेहे कामे होय, जे ईसु कोअये; जर ते एक एक कोइत लेखाअते, ताहां माहूं एहेलोह लागेहे के पुस्तके जे लेखाअते ते दुन्यामेहें बी ने होमाअते.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>