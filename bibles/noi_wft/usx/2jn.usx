<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Noiri</book>
  <para style="h">2 योहान</para>
  <para style="toc3">2 योहान</para>
  <para style="toc2">2 योहान</para>
  <para style="toc1">योहानोअ दुसरो पत्र</para>
  <para style="mt2">योहानाचे दुसरे पत्र</para>
  <para style="mt1">योहानोअ दुसरो पत्र</para>
  <para style="imt">ओलखात</para>
  <para style="ip">योहानोअ पेहलो पत्र ओं ईसु ख्रिस्ताअ जल्माआं 50 ते 100 वोर्‍ह्योंअ विसमेहें प्रेशित योहानोअ आथे लेखायोहो. योहान सोताहा लेखार्‍यु एहेंकोत नाहां समजीइतु, पोन सोताहा एक डायु एहेंकोत समजेहे. 2 योहानोमेहें जों वाक्य लेख्योहो तों योहानोअ हाजी बातमीइ पुस्तकोम बी पालुहूं मिलेहे. खास कोइत तो एकान बिहीरापोअ मेर कोइलोअ बाप्तिमेहें जोर देत कोहे आन एहें कोइत तो देवोअ गोठी मानित सालित ईसुपोअ मेर कोअहे <char style="xt"><ref loc="2JN 1:5-6">1:5-6</ref>,</char> <char style="xt"><ref loc="JHN 15:9-10">योहान 15:9-10</ref></char> विश्वास एहेलुहू बोहेहे के योहानोअ हाजी बातमीइ पुस्तकोअ होस बाकी 3 पत्रे बी लेख्येहे, जेहेलाम तो इफिस सेहरोम रोतुतो तेहलाम 1 योहान, 2 योहान आन 3 योहान एं पुस्तके लेखाअये.</para>
  <para style="ip">योहाने या पत्रामेहें “निवड़ीइल्यी बाय आन तियीइ पोर्‍ये” एहेंकोत गोगाड़ीत कोहे. केहेंनेत तो एकी मंडड़ीइ बाप्तिम कोत देखाड़ेहे. या पत्राहा लेखीइलोअ योहानोअ उद्देश मंडड़ीही हिम्मत आपीइलो आन तियां ठोग मास्तरोहों ईसारु आपीइलू ओतू.</para>
  <para style="iot">रुपरेशा</para>
  <para style="io1">1. योहान ओं कोत कोइत पत्र आगाड़ी मिकेहे के ओं कोडाअ काजेहे होय आन पत्र स्विकारनाराहां सलाम कोहे <char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref></char></para>
  <para style="io1">2. फाशुउ तो मंडड़ीही हिम्मत आपेहे आन तियांहां देवोअ वोडी गोठीइ ईत कोइत आपेहे <char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref> </char></para>
  <para style="io1">3. ताहरुउ ठोगोअ मास्तरहोंअ विरुद्दाम सेतावणी <char style="ior"><ref loc="2JN 1:7-11">1:7-11</ref> </char></para>
  <para style="io1">4. योहान आखरीपोअ मंडड़ीमेर्‍याआ विश्वासी माहुंहूं सलाम कोइत पत्र लेखीइलोअ पुरो कोअहे जिहीं तो रोतुतो <char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref> </char></para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />मंडड़ीइ डायाअहें रोत– देवे निवड़ीइल्यी बाय आन तियीइ पोऱ्याआं नावसे– जियांपोअ आंय खोरो मेर कोअहो, फक्त आंय एतुज नाहां, पोन जें सत्याहा जांअतेहे तें बी मेर कोअतेहे; <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />जों सत्य आपामेहें रोहे तों सादाज आपाअरी रोय.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />देव बाह्हू आन तियाआ बेटुह्हू ईसु ख्रिस्त यापोअ रोत मेरवानी, दया, शांती एं सत्याम आन मेरेम आपाअरी रोअहूं जोवे.<verse eid="2JN 1:3" /></para>
  <para style="s">सत्य आन मेर</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />ताआ थोड़ेक पोऱ्ये देव बाह्हाअ गोठीइ पुरमाणे सत्यापोअ सालत्ले देखीत माहूं जास्ती खुसी ओयी. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />ताहां ए बाय, आंय ताहूं विनंती कोअहो के आपू आखे एकमेकापोअ मेर कोअहूं जोवे. ओ आंय ताहूं कोड्लू नोवू आदेश नाहां लेखतू, पोन जो पेल रोतुज आपापोअ होय तोज आदेश लेखोहो. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />आन आपू देवोअ आपल्या आदेशोअ पुरमाणे सालीइलोअ एज ते मेर होय; जे तुमू वेगे रोत उनाअयेहे आन तेहेंज कोइत सालुहूं बी जोवे.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />काहाके, जाअखीलेहे ठोगनारे दुन्यामेहें उठीत पोड़्येहे,आन ईसु ख्रिस्त एक माहुंउं जल्म लेत यी दुन्यामेहें आयु एहें कोत जो नाहां मानतु तोंज ठोगनारु आन ख्रिस्ताआ दुस्मोन होय. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />सोताआ बाप्तिमेहें सांबालित रोवा, आमू कोअयिही ते मेहेंनत मा जाअहूं देहा, पोन तियाआ पुरो फल जोड़ुहूं जोवे कोत कालजी ल्या.<verse eid="2JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9" />ख्रिस्ताआ हिकवोण सोड़ीत कोइत जो कोडो आगाड़ी-आगाड़ी जाहे तियाहा देव नाहां जोड़्यू; जो कोडो तियाआ हिकवोण मानित सालेहे तियाहा बाह्हून बेटुह्‍हू बेनू जोड़्याहा. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />ताहां एज हिकवोण ने आपनारो एखु तुमाआं जागे आयो, ताहां तियाहा तुमाआं कोअमेहें बी मा हादहा आन तियाहा सलाम बी मा कोअहा. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />काहाके, जो कोडो एहेला माहुंहूं हादेहे, तों तियाआ खाराब कामोमेहें भागिदार बोणेहे.<verse eid="2JN 1:11" /></para>
  <para style="s">सेलवाऱ्येए शब्दे</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />माहूं तुमुहूं जाअखीलीही गोठी लेखीइली होय, पोन कागल आन सहीवाईं नाहां, माआं आशा होय के आंय सोताहा तुमाअ जागे आविहीं आन एकमेकाअरी सामने मिलीत गोठी मिकहूं, ताहां आपाआ खुसी पुरी ओत जाय.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />देवोअ निवड़ीइल्यी ताआ बोअह्हींइं पोऱ्ये ताहूं सलाम कोतेहे.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>