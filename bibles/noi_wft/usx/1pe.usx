<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">-Noiri</book>
  <para style="h">1 पेत्र</para>
  <para style="toc3">1 पेत्र</para>
  <para style="toc2">1 पेत्र</para>
  <para style="toc1">पेत्राआ पेहलो पत्र</para>
  <para style="mt2">पेत्राचे पहिले पत्र</para>
  <para style="mt1">पेत्राआ पेहलो पत्र</para>
  <para style="imt">ओलखात</para>
  <para style="ip">पेत्राआ पेहलो पत्र ओं पेत्रे लेख्योहो. ओं पेत्रे एहें कोत लेखीइलोअ सुरवात कोअहे के, तो कोडु ओतू आन कोडाआ कोअते तो लेखतुतो, तिये तियां आखा ख्रिस्ती माअहुंहूं पत्र लेख्योहो, जियांहां तिये “परदेसी” <char style="xt"><ref loc="1PE 1:1">1:1</ref></char>, <char style="xt"><ref loc="1PE 1:17">1:17</ref></char>, <char style="xt"><ref loc="1PE 2:1">2:1</ref></char> एहेंकोत कोयोहो. तिये तियाआ वासनाराहां वारुज वाआ एहेंकोत कोहे. काहाके तें बिहीरा-बिहीरा देसोमेहें वेरात रोयेते. ओं पत्र थोड़ीक पद्दती वाअहीं इफिसवालाहां पौलुसोअ पत्र जेहे देखाअहे. वारुज माअहें मानतेहे के ख्रिस्ताआ जल्माआं 65 वोरह्योअ फाटी इफिसोअ फासाड़ी पेलठो पत्र लेखाअयोतो. पेत्रे ओं पत्र रोम होयरोमेहें रोत लेख्योतो, जियाहा तिये बाबेल कोयो <char style="xt"><ref loc="1PE 5:13">5:13</ref></char></para>
  <para style="ip">पेत्र कोहे के, तिये या पत्राहा तुमू ओं खोरो माने तेहें काजे लेख्योहो, काहाके देवोअ खोरी मेरवानी होय.<char style="xt"><ref loc="1PE 5:12">5:12</ref></char> <char style="xt"><ref loc="1PE 2:11-3:7">1 पेत्र 2:11—3:7</ref></char>; आन कलस्से <char style="xt"><ref loc="1PE 3:18-4:6">3:18—4:6</ref></char> याआं विसमेहें वारुज गोठी एकरंगीज होय. यां तिनू वर्गामेहें कोऱ्योअ नातो आन आधिकारीइ मानीइलोअ याअ बाप्तिमेहें होय. आन तो कोत आपेहे के ख्रिस्ती माअहें वातड़े रोअहूं जोवे काहाके सेवट्यीइ वेल आहने होय <char style="xt"><ref loc="1PE 4:1">4:1</ref> </char></para>
  <para style="iot">रुपरेशा</para>
  <para style="io1">पेत्र तियाआ पत्र वासनाराहां सोताहा ओलखात काडीत आपेहे. <char style="ior"><ref loc="1PE 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. फाशुउ तो तारणोअ काजे देवोहो धन्यवाद कोअहे. <char style="ior"><ref loc="1PE 1:3-2:10">1:3—2:10</ref></char></para>
  <para style="io1">3. फाश्यूउ तो विश्वास्याहां सिकाड़ेहे के तें दुन्यामेहें कि कोइत हाजाम हाजे रोत सेके <char style="ior"><ref loc="1PE 2:11-4:11">2:11—4:11</ref></char> या नाताआ बाप्तिमेहें तो कोत आपेहे.</para>
  <para style="io1">4. याआ फासाड़ी पेत्र कोत आपेहे के वारुहूं कि कोइत वातड़ा उबा रोअलोअ <char style="ior"><ref loc="1PE 4:12-5:11">4:12—5:11</ref> </char></para>
  <para style="io1">5. ताहरोअ तिये तियाआ पत्र लेखीइलाअ बंद कोअहे <char style="ior"><ref loc="1PE 5:12-14">5:12-14</ref> </char></para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="s">सलाम</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />ईसु ख्रिस्ताआ प्रेशित पेत्राअ वोगेहे रोत जो जें पोन्तुस, गलातीया, कप्‍पदुकिया, आसिया आन बिथुनिया या भागोमेहें परदेसी कोत रोतेहे, तियां देवोअ माअहोंअ काजे ओं पत्र होय.<verse eid="1PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1PE 1:2" />देव बाह्हाआ योजनाआं पुरमाणे तुमू निवड़ाअयेहे, तिये तुमुहूं पवित्र आत्मावाईं सोके कोअयेहे, आन तुमू तियाआ आदेश मानित सालुहूं जोवे, तियाहा कोत प्रभु ईसु ख्रिस्ताआ रक्त तुमापोअ हिपड़्योहो. तुमुहूं मेरवानी आन शांती भारपूर जोड़ुहूं जोवे.<verse eid="1PE 1:2" /></para>
  <para style="s">जिवती आशा</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />आपाआ प्रभु ईसु ख्रिस्ताआ देव बाह्हाआ धन्यवाद! तिये ख्रिस्ताहा मोतोम रोत फाशुउ जिवतु कोइत तियाआ वोडी दया वाअहीं आपुहूं जिवती आशामेहें नोवो जल्म आप्योहो. <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />आन तियावाईं एक हादाफल्योअ, सोको आन अमर मालधनोअ आशिर्वाद होरगामेहें तुमाआं काजे राखित मिक्युहू. <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />आखरीइ दिहोमेहें प्रगट कोइलोअ काजे तियार कोअल्या तिया तारणोअ कोअते देवोअ ताकतो वाअहीं विश्वासो वाअहीं तुमाआं राखवाली ओवीही.<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />पोन ओमें यीज गोठी वाईं थोड़ाक दिही जाआं तुमू जुदी जुदी परिक्शा वाअहीं दुख वेठतेहे तेबी खुस ओवतेहे; <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />ओं याअ कोअता होय, काहाके तुमांआं फारकीइल्यु विश्वास, जो आगी वाअहीं तापासल्या आरवाअनारा होना रोत बी जास्ती कामोअ होय, ईसु ख्रिस्त आवे तियी वेले मान महिमा, स्तुतीइ कारण ओवुहूं जोवे. <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />तुमू तियाहा ने देख्यू तेबी मेर कोअतेहे, आन ओमे ताम विणदेख्येज बी तियापोअ विश्वास कोइत तुमू शब्दाम ने कोत सेकाय एहलिही महिमावाली खुसीवाईं पोआत जातेहे. <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />आन तुमाअ या विश्वासोअ फल मोन्ज्ये आत्माआं तारण तुमू स्विकारतेहे.<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />यी तारणोअ मेरवानीइ बाप्तिमेहें जियां भविश्यवक्तां जे भविश्यवाणी कोअयीते, तियीइ जास्ती होदफुस आन तापास कोअयू. <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />तियांमेऱ्युउ ख्रिस्ताआ आत्मा जेहलाम ख्रिस्ताआ तारास आन तियाआ फासाड़ी ओवनारी महिमाआं साक्शी पेलुज रोत आपतुतो, तेहेलाम तो कोड्ली आन केहली वेलेएहें इशारु कोअतुतो, ए गोठ तियां होदीत काड्यी. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />देवे तियां भविश्यवक्ताहां देखाड़्योतो के, तियांआं काम सोताआ काजे नाहां, पोन तुमाआं सेवाअ काजेहे ओतो. जे हाजी बातमी तुमुहूं होंबलाड़्यी ते होरगाम रोत मोकलीइल्या पवित्र आत्मा वाअहीं जोड़्यी; आन यीं गोठीहीं देवदुत बी ध्यान लागाड़ीत पालीइलोअ इश्शा कोअताहा.<verse eid="1PE 1:12" /></para>
  <para style="s">सोके रोअलोअ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />तियाहा काजे तुमू सोताआ मोन तियार कोइत जागते रोवा, ईसु ख्रिस्ताआ प्रगट ओवीइलोअ वेले तुमापोअ जे मेरवानी ओवनारी होय तियीइ पुरी आशा मिका. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />तुमू देवोअ आदेश माननारे पोऱ्ये बोणा. पेल अजाणेम कोअतेहे तेहलेहे सोताआ लोभ लालसोम मा रोहा. <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />पोन जिये तुमुहूं निवड़्ये तो सोकु होय, तेहलेहे तुमू बी आखी गोठीमेहें सोके बोणा.<verse eid="1PE 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1PE 1:16" />काहाके वसन एहें कोहे, “सोके बोणा, काहाके आंय सोकु होंव.” <verse eid="1PE 1:16" /><verse number="17" style="v" sid="1PE 1:17" />जो बिगर भेदभाव कोअयेज जिया तियाआ कामोअ पुरमाणे न्यायनिवाड़ु कोअहे, तियाहा जर तुमू, “बा,” कोत गोगाड़तेहे, ताहां इंहीं या धरतीपोऱ्याआ जिवनोम तुमू तियाहा बित कोइत वागुहूं जोवे. <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />काहाके तुमाआं सुटका वेगाआ डायहां ठरिवल्या रितीरिवाजो वाअहीं मोन्ज्ये होना-सांदी आन आरवात जानारी वस्तु वाईं नाहां ओवी. <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />पोन निर्दुस आन वाहीं डाग ने एहेलाहा ख्रिस्ताआ जास्ती किमती रक्तावाअहीं तुमाआं सुटका ओवीही. <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />तियाहा ताम दुन्या बोणावीइलोअ पेल रोत देवे नेम्युतो. पोन ओमे यां सेवट्याआ दिहोमेहें तो तुमाआं काजे प्रगट ओवुहू. <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />तुमू जियावाअहीं देवोपोअ विश्वास मिकनारे ओवेहे; तिये देवेज तियाहा मोअल्यामेहें रोत जिवाड़ीत महिमा बी आप्यी, काहाके यावाअहीं तुमाआं विश्वास आन आशा देवोपोअ रोअहूं जोवे.<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />तुमू सत्याआ आदेशोअ पालनो वाईं तुमाआं मोन सोको कोइत लेदोहो, तियाहा कोत एकान बिहीरापोअ पुरा मोनोवाअहीं खोरी मेर कोआ. <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />काहाके मोअनारा बिजोवाअहीं नाहां, पोन अमर बिजोवाअहीं मोन्ज्ये देवोअ जिवता आन अमर शब्दा वाअहीं तुमुहूं नविल जल्म जोड़्योहो. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />काहाके, देवोअ वसन एहें कोइत कोहे के</para>
  <para style="q1" vid="1PE 1:24">“आखे माहें खोड़ोअ होसऱ्येए होय;</para>
  <para style="q2" vid="1PE 1:24">आन तियांआं महिमा फुलोअ हारकी होय;</para>
  <para style="q1" vid="1PE 1:24">खोड़ उगात जाहे</para>
  <para style="q2" vid="1PE 1:24">आन फुल कोमात जाहे;<verse eid="1PE 1:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25" />पोन देवोअ वसन अमर होय.”</para>
  <para style="p" vid="1PE 1:25">ओंज तों हाजी बातमी वसन होय जों तुमुहूं कोयोहो.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">जिवतु डोण आन सोकु देस</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />तियाहा काजे आक्खी जातीइ फोगाय, ठोगोअ कामें, ढोंगड़ाय, खोद्राय, निंदा कोइलोअ एहलोहो आखो सेटे कोइत, <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />ओमे उब्जीइल्या हाना पोर्‍याअ होस, सोका आत्मिक दुदोअ तर्ह्ये बोणा, ताहां यावाईं तुमू तारणोअ काजे वादते रोहा. <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />काहाके देव हाजू होय एहें कोइत तुमू फारकीत लेदोहो.<note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="PSA 34:8">भजन 34:8</ref></char></note><verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />ख्रिस्ताआ जागे आवा, जियाहा माअहें रिकामू समज्यु, पोन देवोअ नजरेमेहें तो निवड़ीइल्यु आन महत्वाआ जिवतु डोण एहेलुहू होय. <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />तुमू बी जिवता डोणोअ होस आत्मिक कोअ बोणते जातेहे, जिहीं तुमू सोका पुंजारहांआं होस सेवा कोअहा, तियाहा आत्मिक दान आन पोटे एहेलोहो गाराहा ईसु ख्रिस्ता वाअहीं देवोहो आपा. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />देवोअ वसन एहें कोइत कोहे के:</para>
  <para style="q1" vid="1PE 2:6">“आंय खास कामोअ डोण निवड़्यु,</para>
  <para style="q2" vid="1PE 2:6">जियाहा आंय कोपराअ डोण एहेंकोत सियोनोम बोहाड़्युहू;</para>
  <para style="q2" vid="1PE 2:6">तियापोअ जों बी विश्वास मिके तों केदिहीं ने होरमाय.”<verse eid="1PE 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 2:7" />तियाहा कोत तुमू विश्वास मिकनाराआ कोअते तो खास होय; पोन जे विश्वास नाहां मिकते तियांहां,</para>
  <para style="q1" vid="1PE 2:7">“मिस्त्र्यां जिया डोणोहों बिनकामोअ समजीइयू</para>
  <para style="q2" vid="1PE 2:7">तोज कोपराआ डोण ओत गोयू.”<verse eid="1PE 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 2:8" />आन बिहीरी जागे वसन एहें कोहे के,</para>
  <para style="q1" vid="1PE 2:8">“ओ ठोकात पोड़ीइलाआ डोण</para>
  <para style="q2" vid="1PE 2:8">आन अटकाव कोअनारु डोण एहेलुहू ओत गोयुहू.”</para>
  <para style="p" vid="1PE 2:8">तें ठोकाअये काहाके तियां तियाआ वसनोहो ने मान्ये; याअ कोअते ते निवड़ीइल्ये ओते<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />पोन तुमू एक निवड़ीइल्यी पारवाड़, राज-पुंजाराआ समाज, सोको देस, देवोअ खाजगी माअहें एहलेहे होय, याअ कोअता, काहाके, जिये तुमुहूं आंदाराम रोत वोडा उजालाम हाद्येहे, तिया देवोअ गुण देखाड़ुहूं जोवे. <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />पेल तुमू तेहलेहे माअहें ने ओते, ओमे तुमू देवोअ माअहें होय; तुमुहूं दया ने जोड़्यीते, पोन ओमे दया जोड़्यीही.<verse eid="1PE 2:10" /></para>
  <para style="s">देवोअ सेवक</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />माआं मेराला दोस्ता, जे तुमू वाटहारा आन परदेसी होय, तियाहा कोत तुमुहूं आंय विनंती कोअहो के, जिवात्माअरी लड़ाय कोअनारी दुन्यादारीइ लालसो रोत सेटे रोवा; <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />परदेसी माअहूंमेहें तुमाआं सोभाव हाजू मिकजा, काहाके, तें जियी गोठीइ बाप्तिमेहें तुमुहूं खाराब समजीइतेहें, तेबी तुमाआं हाजे कामे पालीत तियाआ आविइलोअ दिही देवोअ महिमा कोइत सेके.<verse eid="1PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />प्रभुउ कोअता तुमू माअहूं बोणावल्या हारेक नियमोअ पालन कोअजा; राजा आखाआ डायु होय कोत, तियाआ आधिकारोम रोवा; <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />आन आधिकारी ए बाक्तो कोअनाराहां डोंड आपे तेहें आन हाजो कोअनाराअ नाव वोडो कोइलाआ कोए तेहें काजे तिये मोकल्याहा, तियाहा कोत तियांआं बी ताबाम रोवा. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />देवोअ इश्शा ए होय के, तुमू हाजे कामे कोइत विणहान्या माअहुंउं खाराब कामे बंद कोई देअहूं जोवे. <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />तुमू सोताहा सुटले होय एहेंकोत होमजा, पोन यी सुटकाहा तुमू खाराब कामोंअ कोअता मा वापराहा, पोन तुमू सोताहा देवोअ सेवक एहेंकोत समजीत साला. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />आखाहा मानपान आपा; आखा पाव्हीइलापोअ मेर कोआ, देवोहो बित साला, राजाहा मानपान आपा.<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="PRO 24:21">निती 24:21</ref>; <ref loc="ROM 12:10">रोम 12:10</ref></char></note><verse eid="1PE 2:17" /></para>
  <para style="s">दुख वेठनारा ख्रिस्ताआ नमुनो</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />सेवकों, तुमू तुमाआं मालख्योअ ताबाम रोवा; जे हाजा आन हाजो कोअताहा तियांआं एतोज नाहां, पोन जे जोराखा होय तियांआं बी आथोअ निसे रोवा. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />जर एखाहा देवोअ वाखरी विण सुकीज तारास वेठुहूं पोड़तोय, ताहां तों हाजो होय. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />काहाके पाप कोइत ठावकोज मार खाअहूं पोड़े, तिहींम कि वोडाय होय? पोन हाजो कोइत बी दुख वेठुहूं पोड़तोय, ताहां तों हाजो होय, ओं ते देवोहो गोमेहें. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />काहाके याअ काजेज देवे तुमाआं निवड़ कोअयीही; जेहेंकोइत ख्रिस्ते बी तुमाआ कोअते दुख वेठ्यो तेहेंज कोइत के तुमू बी तियाआ पायरोपोअ पायर मिकीत सालुहूं जोवे. <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />तिये पाप नाहां कोअयू, आन तियाआ जिबानीम रोत वाहीं खोटी जिबान नाहां उनाअहूं जोड़्यी. <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />तो गाई उनात बी फाशुउ फिरीत गाईत ने देतुतो; दुख वेठीत बी कोडाहा धमकी ने देदुतो; पोन खोरी निती वाईं न्याय कोअनारा देवोअ आथोम होपात जातुतो. <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />ख्रिस्ते सोताहा आपाआ आखु पाप सोताआ डिलोपोअ उसलीत कोइत क्रुस खांबोपोअ सोढ़्यू, तो याअ कोअते के आपू पापोअ कोअते मोइत, हाजी गोठीइ कोअते जिवन जिवुहूं जोवे. ईसुउ मार खाद्ला वाअहीं तुमुहूं नेराय जोड़्यीही. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />तुमू वाट पुलवाअला मेडाआं होस भटकीइतेते; पोन ओमे तुमू तुमाआं सारवाल्योअ फाटी जो तुमाअ जिवोअ राखवाली कोअहे, तियाआ जागे वापिस आवित लागेहे.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">बेनू माअहोंअ कोअता</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:1 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:22">इफिस 5:22</ref>; <ref loc="COL 3:18">कलस्से 3:18</ref></char>
    </note> तेहेंज कोइत, बोईं, तुमू सोताआ माट्योअ ताबाम रोवा; याअ कोअते के, तियांमेएं जर एखु ओमे जाआं देवोअ वसनोपोअ विश्वास ने कोअतोय, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />ताहां तों वसनोअ परमाणे तुमाआं सोकु सोभाव देखीत देवोपोअ विश्वास मिकीत सेकेहे. <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" /><note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="1TI 2:9">1 तिम 2:9</ref></char></note> तुमाआं होबा सिंग्याअ पातार गुथीइलो, होना सांदीइ गोवणो पोवीइलोअ, आन भारी भारी आंगड़े पोवीइलोअ एहलुहू उपरसोल्यू देखावू ने जोवे. <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />पोन तुमाआं मोनोम दोड़पाअला मोनवी सोभावोम मोन्ज्ये देवोअ नजरेमेहें जास्ती महत्वाआ एहला हानाला आन शांत आत्माआं अमर गोवणावाईं होबात रोअहूं जोवे. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />काहाके एहेंज कोइत जुना वाडोमेहें देवोपोअ आशा मिकनारी सोकी बोईं बी, जिवजिवोअ माट्योअ ताबाम रोत कोइत सोताआ होबाय कोअतीते. <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" /><note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 18:12">उत्प 18:12</ref></char></note> जेहलीही सारा अब्राहामोहो मालिख समजीत तियाआ गोठ मानित साल्यी. तेहेंज कोइत तुमू बी हाजे कामे कोअती रोहा आन कोड्लीज गोठीही ने बिहा, ताहां तुमू बी तियीइ बेटीह्ही गोणाअहा.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:7 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:25">इफिस 5:25</ref>; <ref loc="COL 3:9">कलस्से 3:9</ref></char>
    </note> तेहेंज कोइत, माट्यों, तुमू बी तुमाआं बोईंइरी समजदारी वाईं जिवन जिवा, काहाके बोईंहीं नाजुक जिव समजीत तियीइ मानपान कोअजा, एहलोहो समजीत कोइत के बेनु माहें जिवनोअ वरदानोअ वारिस होय, जिहीं वाअहीं तुमाआं प्रार्थना रुकाअहूं ने जोवे.<verse eid="1PE 3:7" /></para>
  <para style="s">हाजाआ बोद्ले विरोध</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />आखरीपोअ तुमू आक्खे एक मोनोअ, पाव्हीइलापोअ दया कोअनारे, मेर कोअनारे, किइमाय कोअनारे, हानाले बोणा. <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />बाक्ताआ बोदले बाक्तो मा कोअहा, गाईइ बोदले गाईत मा देहा; पोन उलटे तुमू आशिर्वाद आपा. काहाके देवे तुमुहूं आशिर्वादोअ वारिस ओवे तेहें काजे हाद्येहे. <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" /><note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="PSA 34:12-16">भजन 34:12-16</ref></char></note> वसन एहेंकोइत कोहे के:</para>
  <para style="q1" vid="1PE 3:10">“जो कोडो जिवीइलोअ इश्शा कोअतोय</para>
  <para style="q2" vid="1PE 3:10">आन हाजा दिही देखीइलोअ इश्शा कोअतोय,</para>
  <para style="q2" vid="1PE 3:10">ताहां तों सोताआ जिबीही बाक्ती गोठी गोगीइलो रोत,</para>
  <para style="q2" vid="1PE 3:10">आन ओठोहो ठोगोअ गोठी रोत आवरुहूं जोवे.<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />तों बाक्ताआ हेंगात सोड़ुहूं जोवे, हाजे कामे कोअहूं जोवे;</para>
  <para style="q2" vid="1PE 3:11">तों शांतीम रोअलोअ कोअते पुरा मोनोवाअहीं कोशित कोअहूं जोवे.<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />काहाके देवोअ नजर धर्मी माअहूं पोअ रोहे;</para>
  <para style="q2" vid="1PE 3:12">आन तियाआ कान तियांआं विनंती वोल रोताहा;</para>
  <para style="q2" vid="1PE 3:12">पोन देव बाक्तो कोअनाराआ विरुद्दाम रोहे.”<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />जर तुमू हाजो कोइलाअ धुंद मिकतेय, तांहा तुमाआं बाक्तो कोअनारो कोडो होय? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" /><note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 5:10">मत्तय 5:10</ref>; <ref loc="ISA 8:12-13">यश 8:12-13</ref></char></note> पोन हाजे कामे कोइलाअ कोअता दुख बी वेठीइलोअ आवे ताहां तुमू धन्य होय. तें बिवाड़े ताहां तुमू बिहा मा आन काबराअहा मा, <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />पोन ख्रिस्ताहा प्रभु एहें कोइत जिवज्योअ मोनोमेहें पवित्र माना; जो कोडो तुमुहूं तुमाआं आशाआ बाप्तिमेहें किबी फुसे ताहां तियांहां उत्तर आपिइलो काजे कायम तियारीजमेहें रोवा, पोन ओं वारुहूं हानालाय आन मानपानो वाईं कोअजा. <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />आन दिमाक बी सोकु मिका, याअ कोअते के जियी गोठीइ कोअता तुमाआ बदनामी ओवेहे, तियाआ बाप्तिमेहें तुमू ख्रिस्ता विश्वासोम हाजू सोभाव लेत सालतेहे कोत तुमांआं जें बदनामी कोअतेहे, तें लाजवाअहूं जोवे. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />काहाके हाजो कोइत बी तुमू दुख वेठे एहलिही देवोअ इश्शा ओय, ताहां बाक्तो कोइत दुख वेठीइलाप रोत ओं हाजो होय. <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />काहाके आपुहूं देवोअ जागे लेत जाअलाअ कोअते ख्रिस्ते बी पापोअ बोद्ले, मोन्ज्ये पापीइ कोअते धर्मी माट्ये एकुज वारीम आखाआ कोअते तारास वेठ्यु, पोन शरीर रुपोमेहें तियाहा माईं देदू, आन आत्माम तो जिवतु ओवू. <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />तियाज आत्मावाअहीं तिये जात कोइत जेलेमेऱ्याआ आत्माहां वसन कोयो. <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />एं आत्मे मोन्ज्ये पेल नोहाआ दिहोमेहें जेहेलाम तो जाहाज बोणावतुतो, तेहलामेहें देव धिर खेटीत तियांआं वाट जोवतुतो, तिया वाडोहो जियां तियाआ आदेश टाली देदू तें एंज आत्मे ओते, तिया जाहाजोमेहें निस्ते आंठुज जोंएं पांअयोंम रोत वासाअये. <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />तिया पांअयोंअ नमुना जो बाप्तिस्मा, तियाआ अर्थ डिलोअ मोल तुवीइलो नाहां, पोन सोकु दिमाक मिकीइलाअ देवोअरी रोअलोअ होय. तों ओमे ईसु ख्रिस्ताआ फाशोअ जिवीत उठीइला वाअहीं आपाआ तारण ओवोहो. <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />तो होरगाम गोयुहू आन देवोअ हाजाड़्यी वोग होय, आन देवदुत, होरगामेर्‍युउ आधिकार आन सेक्ती तियाआ आथोम होय.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">बोद्लाअलो जिवन</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />ख्रिस्ते बी शरीरोमेहें रोत कोइत दुख वेठ्यो, तेहेंज कोइत तुमू बी तेंज आथ्यारे पोवित ल्या; काहाके जिये शरीरोमेहें दुख वेठ्योहो तो पापोम रोत सुटीत गोयू; <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />याअ कोअते के तुमू तुमाआं उगरीइल्यो जिवन मोनवीइ लालसोअ काजे नाहां, पोन देवोअ इश्शाआ काजे जिवुहूं जोवे. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />काहाके बिगर विश्वासीइ मोर्जी वाअहीं कामे कोइलो, आन लुसड़ायीइ खाराब लालस, पिद्राय<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="fq" closed="false">पिद्राय </char><char style="ft" closed="false">होरु पिनाराआ सोभाव</char></note>, झिंगवात नासीइलोअ, होरु पिइलो, मुर्तीपुजाआ सोगदाय यामेहें आपू जेते रोये ततोज बास. <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />तुमू तियांआं लबाड़ीम सामिल नाहां ओवता, ओं तियांहां नाहां गोमतो, तिहींवाईं तें तुमाआं निंदा कोअतेहे. <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />जो जिवताआ आन मोल्याआं न्यायनिवाड़ु कोइलोअ काजे तियार होय, तियाहा तें ईसाब आपे.<note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="2TI 4:1">2 तिम 4:1</ref></char></note> <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />काहाके हाजी बातमी मोल्याहां बी कोयीते, जिहींवाईं तियांआं न्यायनिवाड़ु माअहुंउं होस शरीरोमेहें ओवू, पोन आत्माम देवोअ होस जिवते रोअहूं जोवे.<verse eid="1PE 4:6" /></para>
  <para style="s">देवोअ वरदानोअ हाजू कारभारी</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />आखी गोठी वेगीज सेलाअनारी होय; तियाहा कोत सिंहाणे रोवा, आन प्रार्थना कोइलाआ कोअते तियारीम रोवा. <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />आखाम रोत वोडी गोठ ए होय के, एकमेकापोअ वादार मेर कोआ; काहाके मेर पापोहो टापी देहे.<note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PRO 10:12">निती 10:12</ref></char></note> <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />बिगर टुटण्येज एकमेकाआ पावणाय तोआ. <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />हारेक जोंओं देवोप रोत जों वरदान जोड़्योहो, तों बाती बातीइ वरदानोअ हाजा कारभारीइ होसे तियाहा एकमेकाआ सेवाम लागाड़जा; <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />जों कोडो गोगतोय, तों एहेंकोइत गोगुहूं जोवे, के आंय देवोअ वसन कोहो; जों कोडो सेवा कोअतोय, तों देव आपेहे तियी सेक्ती वाअहीं सेवा कोअहूं जोवे; तों याअ कोअते के आक्खी गोठीम ईसु ख्रिस्तावाअहीं देवोअ वोडाय ओवुहूं जोवे; महिमा आन सेक्ती पिढ़ीन पिढ़ीइ तियाज होय. आमेन.<verse eid="1PE 4:11" /></para>
  <para style="s">ख्रिस्ताआ वाखरी दुख वेठीइलो</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />मेराला पाव्हीइला, तुमुहूं फारकीत पालीइलाअ कोअते जे आगीइ परिक्शा तुमांपोअ पोड़कीत उठ्यीही. ओं देखीत ए काविहीं जुदीज गोठ होय कोत तुमू बोगलाअहा मा. <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />पोन उलटे तुमू ख्रिस्ताआ दुखोम सामिल ओवतेहे कोत, खुसी कोआ; जिहीं वाईं तियाआ महिमा प्रगट ओवे तेहेलाम तुमू वोडी खुसी वाईं सेकलाअहा. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />ख्रिस्ताआ नावोअ कोअता तुमाअ निंदा ओवतीय, ताहां तुमू धन्य होय; काहाके महिमाआं आत्मा मोन्ज्ये देवोअ आत्मा तुमापोअ सावलू कोअहे. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />तेबी तुमू खुन कोअनारे, बांड, खाराब कामे कोअनारे, नेत बिहीराआ कामोम आथ टाकनारे एहलेहे ओवित दुख वेठनारे मा बोणहा. <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />ख्रिस्ती होय कोते एखाहा दुख बी वेठुहूं पोड़तोय, ताहां तियाहा लाज ने आवुहूं जोवे; पोन यी गोठीइ कोअते देवोअ महिमा कोअहूं जोवे.<verse eid="1PE 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17" />काहाके ते वेल आवित पोत्यीही के, जिहींम पेल देवोअ माअहुंउं न्यायनिवाड़ु ओवे; जाहां न्यायनिवाड़ाआ सुरवात आपाआ जागे रोतीज ओवे, ताहां तियांआं कि ओवे, जें देवोअ हाजी बातमी नाहां मानते?<note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="HEB 12:24">इब्री 12:24</ref>,<ref loc="HEB 12:25">25</ref>; <ref loc="JER 25:29">यिर्म 25:29</ref>; <ref loc="EZK 9:6">यहे 9:6</ref> </char></note> <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />जेहलोहो वसन कोहे,</para>
  <para style="q1" vid="1PE 4:18">“धर्मी माहुंहूं जाआं कठीण मेहेंनत कोइत तारण जोड़े,</para>
  <para style="q2" vid="1PE 4:18">ताहां ने विश्वास कोअनाराआ आन पाप्योअ कि ठिकाणो?”<verse eid="1PE 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19" />तियाहा काजे जें देवोअ मोर्जीइ परमाणे दुख वेठतेहे, तें हाजे कामे कोअते जात सोताहा कोलीइ बोणावनाराआ इमानदार देवोअ आथोमेहें होपी द्या.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">डाया आन जुवान्याआं कोअते सुसना</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />तुमामेहें जे डाया होय, आंय तियांआज होस डायु आन ख्रिस्ताआ दुखोअ साक्शी आन देखाअनारी महिमामेहें आरी मिलीत कोइत तियांहां ओं समजाड़ोहो के <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />देवोअ तिया टोलाआ जो तुमाआं विसमेहें होय, तियाआ राखवाली कोआ; आन ओं दाबावो वाअहीं नाहां, पोन देवोअ मोर्जीइ पुरमाणे खुसी वाअहीं, आन विणलाज्यी कामायीइ काजे नाहां, पोन रोडे वाईं कोआ. <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />जे माअहें तुमाआं आथोम होप्येहे, तियांपोअ आधिकार मा सालाड़हा, पोन टोलाआ काजेहे नमुनो बोणा. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />जेहेलाम वोडू राखवाली प्रगट ओवे, तेहेलाम तुमुहूं महिमाआ टोपू आपे, जो केदिहीं नाहां कोमाअतू.<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />तेहेंज कोइत ए जुवानो! तुमू बी डायहांअ ताबाम रोवा, आन तुमू आखे बोठेज एकमेकाआ सेवा कोइलाआ कोअते तियारीम रोवा, काहाके वसन कोहे, “देव वोडाऱ्या माहुंउं विरोध कोअहे, पोन हानाला माहूंपोअ मेरवानी कोअहे.” <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" />तियाहा कोत देवोअ ताकतवाला आथोअ निसे हानाले रोवा, ताहां तो तुमुहूं बोराबर वेलेपोअ उसे कोए. <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />तुमाआं आक्खी सिंता तियापोअ टाका, काहाके तियाहा तुमाआं कालजी होय.<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />हेएजा, आन जागते रोजा; काहाके तुमाआं दुस्मोन सैतान ओ घांगरीइनारा सिहांवागोअ होस कोडाहा वेतरीत खांव एहेंकोत होदतु फिरेहे; <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />विश्वासोमेहें मजबुत रोत कोइत, तियाआ विरुद्दाम उबे रोवा, काहाके तुमाआं पाव्हीइले जें दुन्याम होय तें एंहेंज कोइत दुख वेठतेहे. <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />ओमे जिये तुमुहूं ख्रिस्तामेहें तियाआ कायम महिमाआं काजे हाद्येहे तो आखी मेरवानी आपनारु देव होय, तुमाआं थोड़ीक वाआ जाआं दुख वेठीइलाआ फासाड़ी सोताहाज तुमुहूं पाक्के आन मजबुत आन ताकतवाले बोणावे. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />तियाआज राज पिढ़ीन पिढ़ी रोये. आमेन!<verse eid="1PE 5:11" /></para>
  <para style="s">सलाम</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />आंय सिल्‍वानुसोअ आथे जियाहा आंय इमानदार पाही कोत मानोहो, थोड़ाजमेहें लेखीत तुमुहूं समजाड़्योहो, आन ए साक्शी आप्यीही के देवोअ खोरी मेरवानी एज होय, इंहींजमेहें टिकीत रोवा.<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />जें बाबेलोमेहें तुमाआं हारके निवड़ीइल्ये विश्वासी माअहें तुमुहूं सलाम कोतेहे; आन माअ पोर्‍यू मार्क ओ बी सलाम कोहे.<verse eid="1PE 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 5:14" />मेरे वाअहीं गले लागाड़ीत एकान बिहीराहा सलाम कोआ. ख्रिस्तामेहें तुमू आखाहा होक जोड़तू रोअहूं जोवे.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>