<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">- Noiri</book>
  <para style="h">योना</para>
  <para style="toc3">योना</para>
  <para style="toc2">योना</para>
  <para style="toc1">योनाआ पुस्तक</para>
  <para style="mt2">योनाआ पुस्तक</para>
  <para style="mt1">योना</para>
  <para style="imt">योनाआ पुस्तकोअ ओलखात</para>
  <para style="ip">निनवे होयरोमेहें योना भविश्यवक्ताआ सेवाआ बाप्तिमेहें ओं पुस्तक होय. बिहीरी भविश्यवाणीइ पुस्तकोअ रोत आलाग, ओं पुस्तक देवोअ संदेशोअ तुलनामेहें भविश्यवक्ता आन तियाआ कामोपोअ वादार दिहान खेसेहे. जेहेलाम यारोबाम दुसरा इस्राएलोअ राजा ओतु तियीज होमसे योनाहा देवे हाद्यू. ए घटना एक आंदास 800-750 इ.स. आगोदर ओवी; पोन ओं पुस्तक तिये सोताहा कोयों लेख्योतो ओं जाणकारोहो नाहां मुंदू.</para>
  <para style="ip">देवे योनाहा निनवेए विरुद्दामेहें परसार कोए तेहें काजे मोकल्यू, पोन योनू आदेश ने मान्यू आन निनवे रोत ओनखेज जातु रोयू. <char style="xt"><ref loc="JON 1:1-3">1:1-3</ref></char> तो तार्शीश होयरोअ वोल जानारी एकी जाहाजीमेहें बोहीत गोयू ताहां देवे एक वोडु वादुउ मोकल्यू आन जाहाज सालाड़नारा बित गोया. आन तियां देवोअ खोत उलाय तेहें काजे योनाहा दोऱ्यामेहें टाकी देदू. ताहरुउ योनाहा गिईंत लेय तेहें काजे देवे एका वोडा मासाहा मोकल्यू. योने फासतावू कोअयू आन देवे तियाहा जिवतु रोअहूं देदू. आखरीमेहें, योना तिया निनवे होयरोअ विरुद्दामेहें परसार कोइलाअ काजे गोयु, आन तिया होयरोअ माअहें फासतावू कोअयू. योनाआ पुस्तक यी गोठीपोअ जोर आपेहे के देव केतुहू दयालू होय, भले योनू एहेलुहू विसार ने कोअतुतो के देव दयालु रोअहूं जोवे <char style="xt" closed="false"><ref loc="JON 4:2">4:2</ref>.</char></para>
  <para style="iot">रुपरेशा</para>
  <para style="io1">1. योनू केहेलुहू देवोप रोत सेटे नाहांतुतो आन मासाआ पोटामेहें जातु रोयू.<char style="ior"><ref loc="JON 1:1-17">1:1-17</ref></char></para>
  <para style="io1">2. योने मासाआ पोटामेहें रोत कोइते देवोहो कोअल्यी प्रार्थनाआ वर्णन होय.<char style="ior"><ref loc="JON 2:1-10">2:1-10</ref></char></para>
  <para style="io1">3. योनू निनवेमेहें परसार कोअहे आन होयरोअ माअहें फासतावू कोअतेहे. आन देव तियांहां वासाड़ीइलोअ निर्णय लेहे.<char style="ior"><ref loc="JON 3:1-10">3:1-10</ref></char></para>
  <para style="io1">4. योना यी गोठी वाअहीं खोतेम होय, के देव निनवे माअहूं पोअ दया देखाड़्यी; आन देव योनाहा कोहे, के तो आक्खा माअहूं पोअ मेर कोअहे.<char style="ior"><ref loc="JON 4:1-11">4:1-11</ref></char></para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">योनू देवोअ आदेश ने मानत्लू</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />अमित्तेए पोऱ्या योनाअरी देव एहें कोइत गोग्यू: <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />“उठीत कोइत फोला वोडा निनवे होयरोम जात कोइत तियांआं विरुद्दाम परसार कोओ; काहाके तियांआं खाराब कामे माआ नजरेम वादीत गोयेहे.” <verse eid="JON 1:2" /><verse number="3" style="v" sid="JON 1:3" />पोन योना तार्शीशोअ वोल नाहींत जाअलोअ काजे उठ्यू, आन याफामेहें तार्शीश जानारी एक जाहाज तियाहा मिल्यी. ताहरुउ तो देवोअ सामने रोत तार्शीशोअ वोग जाअलोअ काजे पाड़ो आपीत तियी जाहाजीम सोड़ीत माय जातू रोयू.<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />तेहेलाम यहोवा देवे दोऱ्यामेहें एक नाहाजू वोडू वारु मोकल्यू, आन दोऱ्याम जास्ती वोडू वादुउ सालू ओत गोयू. तिहींइंरी ते जाहाज टुटीत जाअहूं कोअतीते. <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />ताहां ते जाहाजेए सालाड़नारा आखा बियबिय जिवज्योअ देवी-देवताआ नाव लेना वोल्या. आन जाहाज ओल्की कोइलोअ काजे तिहींमेऱ्योअ धंदाआ आखो सामान दोऱ्याम टाका वोल्या. पोन योनू तोम जाहाजीइ निसऱ्याआ जागाम जात कोइत वारुहूं हाजू हुवीत गोयुतो.<verse eid="JON 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 1:6" />ताहां जाहाजीइ मुख्यू तियाआ जागे आवित कोनु वोल्यू, “तु केहें इंहीं वारुहूं हाजू हुवेहे? उठ, ताआ देवोहो नाव लेत गोगाड़! ओत सेकेहे देव आपाआ कालजी कोइत आपुहूं ने मोअहूं देय.”<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />ताहां जाहाजेए सालाड़नारा कोयो, “आवा, कोडाआ वाखरी ए वोडी आफत आयीही, तों जांइत लेअलोअ काजे सिट्टी फोड़कावता.” ताहां तियां सिट्टी फोड़कावयी, आन ते सिट्टी योनाआ नावोपोअ निहींयी. <verse eid="JON 1:7" /><verse number="8" style="v" sid="JON 1:8" />ताहां तियां योनाहा फुशो, “ए आफत आपापोअ काहा काजे आयीही तों आमुहूं को? ताआ धंदू की होय? तु कोड्ला देसोम रोत आयुहू? तु कोड्ला माहूम रोत आयुहू?”<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />तिये तियांहां कोयो, “आंय इब्री होंव. जिये जुग, धरती आन दोऱ्या ओं आखो बोणायोहो तिया यहोवा देवोअ आंय भक्ती कोअहो.” <verse eid="JON 1:9" /><verse number="10" style="v" sid="JON 1:10" />जाहां तो यहोवा देवोअ सामने रोत नाहींत आयुहू एहलोहो तियांहां मुंदू पोड़ीत गोयू, ताहां ते जुदा बित गोया; काहाके तिये सोताहा तियांहां कोत देखाड़ी देदोतो.</para>
  <para style="p" vid="JON 1:10">ताहराआ ते तियाहा कोना वोल्या, “तुमे एहेलोहो काहा कोअयोहो?” <verse eid="JON 1:10" /><verse number="11" style="v" sid="JON 1:11" />ताहां तियां योनाहा फुशो, “ताहां ओमे दोऱ्याआ उपाड़ा बोंद ओत जाय तेहें काजे आमू ताहूं की कोओ?” तेहेलाम दोऱ्याआ उपाड़ा बी जाअखा जाअखा वोदा वोल्याते.<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />ताहां तिये तियांहां कोयो, “तुमू माहूं विसीत दोऱ्याम टाकी द्या; ताहां दोऱ्याआ उपाड़ा बोंद ओत जाय; काहाके ए आफत माआंज उस्ती तुमापोअ आयीही ओं माहूं मुंदू होय.”<verse eid="JON 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13" />तेबी ते माटी जाहाज मेरे लेतावीइलोअ काजे जास्ती मेहेंनत कोअयी; पोन दोऱ्याआ उपाड़ा जास्ती सालू ओता तिहीं वाअहीं ते मेरे ने पोतीत सेका. <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />ताहां तियां यहोवा देवोहो प्रार्थना कोइत कोयो, “ओ यहोवा देवा, या माट्योअ जिवोअ बोदले तु आमाआ जिव मा लेही, आन आमापोअ निर्दुसोअ खुनोअ गुनू मा लागाड़ही. काहाके ओ यहोवा देवा, ताआ मोर्जीइ परमाणे तुमे कोअयोहो.” <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />ताहां तियां तिया योनाहा उसलीत पाअयोंम टाकी देदू. तेहेलाम दोऱ्यामेऱ्याआ वोडा उपाड़ा बोंद ओत गोया. <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />ताहां ते माटी यहोवा देवोहो जास्तीज बित गोया, आन तियाहा गाराहा आप्यी आन तियाआ पालनी तोअयी.<verse eid="JON 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17" />यहोवा देवे योनाहा गिईंत लेय तेहें काजे एक जुदू वोडू मासू ठरवीत मेक्युतो; आन योनू तिया मासाआ पोटाम तिन दिहीन तिन रात पोड़ीत रोयू.<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAT 12:40">मत्तय 12:40</ref></char></note><verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">योनाआ प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />तेहेलाम योने तिया मासाआ पोटाम रोत तियाआ देव यहोवाहा प्रार्थना कोइत कोयो;<verse eid="JON 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JON 2:2" />“आंय तारासोम पोड़ल्युज यहोवा देवोहो प्रार्थना कोअयी,</para>
  <para style="q2" vid="JON 2:2">आन तिये माआं प्रार्थना उनाइत लेदी;</para>
  <para style="q1" vid="JON 2:2">पातालोम रोत मी ताहूं हाद कोअयू,</para>
  <para style="q2" vid="JON 2:2">आन तुमे हुदाअलीज माआ प्रार्थना उनाइत लेदी.<verse eid="JON 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3" />तुमे माहूं दोऱ्याम आखाम रोत बुंद्ये लागाड़ी देदू;</para>
  <para style="q2" vid="JON 2:3">तिहीं माआं शारी सोमकीर निस्तो पाईंन पाईं ओतो.</para>
  <para style="q2" vid="JON 2:3">तुमे पोड़कावल्या उपाड़ा</para>
  <para style="q2" vid="JON 2:3">आन सेलका मापोअ साल्या कोअताते.<verse eid="JON 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4" />ताहां मी कोयो, ‘आंय ताआ सामने रोत काडी देवाअयुहू;</para>
  <para style="q2" vid="JON 2:4">ओमे कि कोइत ताआ सोका मंदिरोहो फाशुउ आंय पालित सेकहीं?’<verse eid="JON 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5" />माहूं पाअयें एतुहू टापित लेदू</para>
  <para style="q2" vid="JON 2:5">के माआ जिव निहींतीज जाअहूं कोअतुतो;</para>
  <para style="q2" vid="JON 2:5">आन माआ मुंडीपोअ दोऱ्याआ हेंवालो वेट्लात रोयोतो.<verse eid="JON 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6" />आंय डोगोअ थुड़ोम लागीत गोयुतो;</para>
  <para style="q2" vid="JON 2:6">आंय पुयींमेहें रेटात गोयुतो;</para>
  <para style="q1" vid="JON 2:6">तेबी माआ प्रभु यहोवा,</para>
  <para style="q2" vid="JON 2:6">तुमे माआ जिव मोतोअ खायाराम रोत उसे काड्यू.<verse eid="JON 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7" />जाहां आंय माआ जिव निहीत जाअहूं कोअतुतो, तेहेलाम आंय देवोअ ओर कोअयी;</para>
  <para style="q2" vid="JON 2:7">आन माआं प्रार्थना ताआ जागे,</para>
  <para style="q2" vid="JON 2:7">ताआ सोका मंदिरोम पोतीत गोयी.<verse eid="JON 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8" />जें माहें बिगर कामोअ वस्तूपोअ मोन लागाड़तेहे,</para>
  <para style="q2" vid="JON 2:8">तें तिया वोडी मेरमायावाला देवोहो सोड़ी देतेहे.<verse eid="JON 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9" />पोन आंय तोम जोरे आवाजोम ताआ धन्यवादोअ गित गावीत ताहूं गाराहा आपीहीं;</para>
  <para style="q2" vid="JON 2:9">जे पालनी आंय तोअयीही ते पुरी कोअहीं.</para>
  <para style="q2" vid="JON 2:9">तारण देवोज पोअ रोत जोड़ेहे!”<verse eid="JON 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />ताहां यहोवा देवे तिया जुदा वोडा मासाहा आदेश आप्यू, आन तो मासू तिया योनाहा दोऱ्याआ मेरे आवित ओगालीत टाक्यू.<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">योनू देवोअ आदेश मानत्लू</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />ताहां यहोवा देव दुसरी वारी योनाअरी गोग्यू: <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />“उठ आन तिया वोडा निनवे होयरोम जा, आन जे गोठ आंय ताहूं कोहीं, ते तु तिहीं पुकारु कोअजी.” <verse eid="JON 3:2" /><verse number="3" style="v" sid="JON 3:3" />ताहां योना यहोवा देवोअ कोल्याआ पुरमाणे निनवे गोयू. निनवे जास्ती वोडो होयर ओतो. तों पुरो होयर फिरुहूं तिन दिही लागीत जाताते. <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />योनू एक दिही पोइत होयरोम सालतू जात एहें कोइत पुकारु कोऊ वोल्यू, “आज कोइत सालीही दिही रोयाहा, तिहीं रोत निनवे होयर आरवात जाय!”<verse eid="JON 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 3:5" />ताहां निनवेवाला माअहूं देवोअ गोठीपोअ विश्वास कोअयू; आन उपास कोइलोअ ठरव्यो आन हाने रोत ते वोडे जाआं आखाज गोंठो फांगीत उपास तोअयु.<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />ताहां ए बातमी निनवेए राजाआ कानोपोअ पोड़्यी; आन तो बी राजगादीपोअ रोत उठीत कोइत तियाआ राज-आंगड़े काडीत मेकी देदे, आन गोंठो फांगीत लेदोन खाओंम बोहीत गोयू. <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />निनवेए राजे तियाआ मोंत्र्योंअरी गोठी कोइत ठरवी देदोन पुकारु कोई देदू, के “कोडो किज ने खाअहूं जोवे, माअहें ने के, मेडे ने के, डोगरेन बोकड़े ने के, बिहीरे कोड्लेज जनवारे ने. आन पाईं बी ने पिअहूं जोवे. <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />माअहें आन जनवारे आखे गोंठो फांगुहूं जोवे, आन तें देवोहो रोड़ी रोड़ीइ प्रार्थना कोअहूं जोवे; आन सोताआ खाराब कामोम रोत मोन फिरवुहूं जोवे, आन तियांआं भान्गड़्यीइ उस्ती माफी मागुहूं जोवे. <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />ओत सेकेहे, देव दया कोए आन तियाआ खिज उलवीत लेय, आन तियाआ खोत कमी कोइत लेय आन आपू आरवाइलो रोत वासात जाहूं.”<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />तें माअहें तियांआं खाराब वाट सोड़त्ले देखीत देवे तियाआ विसार बोदली देदू, आन तियांहां आरवीइलोअ ठरव्योतो पोन तियांहां ने आरव्ये.<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">योनाआ खोत आन देवोअ दया</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />ए गोठ योनाहा जास्ती खाराब लागी, आन तियाहा जास्ती खोत लागी. <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />ताहां तिये एहें कोत कोइत यहोवा देवोहो प्रार्थना कोअयी, “यहोवा देवा, जाहां आंय माआ देसोमेहें ओतु तेहेलाजमेहें ए गोठ ने कोयोतो के, तु तेहेंज कोअनारु होय? तियाहाज काजे तोम आंय ताआ आदेश टाली देत उतवालेहे तार्शीशोअ वोग नाहींत गोयुतो; काहाके माहूं मुंदू ओतू, के तु मेरवानी कोअनारु आन दयालू देव होय, आन बागे राखीत खोत कोअनारु मेरालू देव होय, अड़सन पाड़ीत ताहूं खुसी नाहां ओवती एहलुहू तु देव होय. <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />ताहां देवा, ओमे तु माहूं माइत ले; काहाके आंय जिवतू रोंव तेतोहो जी मोइत गोल्ये हाजो पुरड़े.”<verse eid="JON 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4" />यहोवा देवे कोयो, “ताहूं जे खोत लागीही ए ठिक होय के?”<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />यी गोठीवाअहीं योनू तिया होयरोम रोत निहींत उगतामाआं वोग सावलाआ काजे मालू बोणायू, आन तियाआ थुड़ते बोहीत होयरोअ की ओवेहे तों ठावकुज बोहीत पालु वोल्यू. <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />तेहेलाम यहोवा देवे एक ताबुड़ पोहाअनारो वेलो उगाड़्यो आन तिया मालापोअ सावलू ओत जाय तेहें काजे ताबुड़ वोडो कोई देदो. तिया वेलाहा देखीत योनाहा जास्ती खुसी ओवी. <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />वेगीइ जेहेलाम हुजो वोल्यो, ताहां देवे तिया वेलाहा कात्री देय तेहें एका किड़ाहा मोकल्यू, तिये वेलाहा कात्री देदो आन तो वेलो उगात गोयो. <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />तिहीं रोत दिही उगू तेहेलाम देवे उगताअहें रोत झांव सालू कोई देदी, आन योनाअ मुन्कापोअ एहलोहो तोपो वोल्यो, के तो जाखलाउ वोल्यू आन ताहरुउ देवोहो कोनु वोल्यू, “आंय इंहीं जिवतू रोंव, तेतोहो जी मोइत गोल्ये पुरड़्यो.”<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />ताहां देवे योनाहा कोयो, “तिया वेलाआ वाखरी ताहूं खोत लागी, ओं ठिक होय के?” तिये कोयो, “होव, ठिक होय, इंहीं वाअहीं माहूं मोत बी आवित जाय तेबी साले.”<verse eid="JON 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10" />ताहां यहोवा देवे कोयो, “जिया वेलाआ काजे तुमे वाहीं मेहेंनत ने कोअयी, ने तियाहा वोडो कोअयो. तों एकीज रातीम वोडो ओवो आन बिहीरी रातीम आरवात गोयो, तियापोअ ताहूं एती किव आवेहे; <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />ताहां ओं एतो वोडो निनवे होयर होय, जिहींम एक लाख विही हाजार माअहें होय. जियांहां आगो-फाशोअ किज नाहां मुंदू, आन वारुज पाल्ल्ये जनवारे बी तिहींम रोतेहे. ताहां केहें आंय तियांपोअ किव ने कोओ के?”<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>