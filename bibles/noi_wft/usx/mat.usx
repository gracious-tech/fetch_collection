<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Noiri</book>
  <para style="h">मत्तय</para>
  <para style="toc3">मत्तय</para>
  <para style="toc2">मत्तय</para>
  <para style="toc1">मत्तये लेखल्यी हाजी बातमी</para>
  <para style="mt2">मत्तयने लिहिलेले शुभवर्तमान</para>
  <para style="mt1">मत्तये लेखल्यी हाजी बातमी</para>
  <para style="imt">ओलखात</para>
  <para style="ip">“मत्तये लेखल्यी हाजी बातमी” ओं पुस्तक तियां शार पुस्तकोमेहें रोत एक एहेलोह पुस्तक होय; जों ईसु ख्रिस्ताआ जिवनोअ बाप्तिम कोत आपेहे. यां शारु पुस्तकोहों “गॉस्पल” एहें कोतेहे, तियाआ अर्थ बोणेहे हाजी बातमी. ईसु होरगाम जातु रोयू, तिहींइं फासाड़ी मत्तय, मार्क, लुक आन योहान यां लेखार्‍या एं पुस्तके लेख्ये. मत्तये लेखल्‍यी हाजी बातमी, ओं पुस्तक ठीक कोयों लेखाअयोये, याआ खबर कोडा जाणकारोहो कायनाहां, पोन आपू एहें कोत सेकतेहे के ईसुउ जल्माआं 60 वोर्‍ह्योंअ फाटी ओं पुस्तक लेखाअयोये. तेहेंज कोइत ओं पुस्तक का लेखाअयोय? याआ बी खबर कायनाहां, तेबी थोड़हे एहेलोह मानतेहे, के ओं पुस्तक पलिस्टीमेहें, नेताहां येरुसालेम होयरोमेहें लेखाअयोहो.</para>
  <para style="ip">या पुस्तकोअ लेखार्‍यू मत्तय होये, जो ईसुउ सेलू बोणिइलोअ पेल तो नाकेदारो मेर्‍युउ एक ओतू, तियाहा लेवी नावो वाअहीं बी ओलखीइतेहे. मत्तय ओ बारा प्रेशितों मेर्‍युउ एक ओतू, आन तिये यहुदी वासनाराआं काजे ओं पुस्तक लेख्यो. तिहींज वाअहीं आपू पालतेहे, के या पुस्तकोमेएं 60 रोत वादार लेख्यो जुना नियमोमेएं होय, जियाआ बाप्तिमेहें भविश्यवाणी ओवीते, के तो तारनारु “ख्रिस्त ईसुज होय,” ओं तियाआ कोअलोअ ओतो. मत्तये देवोअ राज्याआ बाप्तिमेहें वारुज लेख्यो. यहुद्यांआं आशा ओती, के ख्रिस्त राजकारणोमेहें राजा बोणे. मत्तय यां विसारोहो नाकारतु जात तो देवोअ आत्मिक राजोअ बाप्तिम कोत आपेहे.</para>
  <para style="ip">“मत्तये लेखल्‍यी हाजी बातमी” ओं एक हाजो पुस्तक होय, जिया वाअहीं नोवा नियमोओं सुरुवातीही ओं पुस्तक जुना नियमोअ वोलेहे ताल ताल आपाआ मोन खेसीत लेहे. ओं पुस्तक जुनू नियम आन नोवू नियम यां बेनू पुस्तकोहो जुड़ेहे. जाणकार एहेलुहू मुंदू काडीत आपताहा, के या पुस्तकोमेहें मोशे लेखल्ये पास पुस्तके, जें जुना नियमोंअ सुरुवातीइ पुस्तके होय, तियांआं होस लेखीइलोअ मत्तये कोशित कोअयीही. ईसु जो संदेश टेंबा पोअ रोत आप्‍यू. <char style="xt"><ref loc="MAT 5-7">मत्तय 5—7</ref></char> याहा आपू यहोवा देवे मोशेहे आपल्या नियमोअरी हारकावीत सेकतेहे. <char style="xt"><ref loc="DEU 19:3-23:25">कायदा 19:3—23:25</ref></char></para>
  <para style="iot">रुप-रेशा</para>
  <para style="io1">1. ईसुउ जल्म आन तियाआ सेवाआ सुरुवात कोइलोअ बाप्तिम मत्तय तियाआ हाजी बातमीइं सुरुवात कोअहे. <char style="ior"><ref loc="MAT 1-4">1—4</ref></char></para>
  <para style="io1">2. मत्तय ईसुउ सेवाआ बाप्तिमेहें आन जियी वारुज गोठीइ बाप्तिमेहें हिकवोण आप्यी तियींइं बाप्तिमेहें कोत आपेहे. <char style="ior"><ref loc="MAT 5-25">5—25</ref></char></para>
  <para style="io1">3. मत्तये लेखल्‍यी हाजी बातमीइं आखरीइ भाग जो होय, तो ईसुउ सेवा, मोत आन फाशोअ जिवित उठीइलोअ बाप्तिम होय. <char style="ior"><ref loc="MAT 26-28">26—28</ref></char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">ईसु ख्रिस्ताआ पारवाड़</para>
  <para style="r">(<ref loc="LUK 3:23-38">लुक 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />अब्राहामोअहीं रोत ते दाविदोअ जागे जाआं ईसु ख्रिस्ताआ<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">ख्रिस्त </char><char style="ft" closed="false">मसीहा मोन्ज्ये “अभिशिक्त” नेताहां एका खास कामोअ काजे निवड़ीइल्यू.</char></note> पारवाड़ एहें कोइत होय<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="GEN 22:1-19">उत्प 22:1-19</ref>; <ref loc="GAL 3:16">गलाती 3:16</ref></char></note>:<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />अब्राहामोहो इसाहाक, <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="GEN 21:1-12">उत्प 21:1-12</ref> </char></note>आन इसहाकोहो याकोब,<note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="GEN 25:19-28">उत्प 25:19-28</ref> </char></note> याकोबोहो यहुदा<note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="GEN 29:35">उत्प 29:35</ref>; <ref loc="GEN 49:8-10">49:8-10</ref> </char></note> आन तियाआ पाही ओवा, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />यहुदाहा तामारे वाअहीं पेरेस आन जेरह ओवा: पेरेसोहो हेस्रोन ओवू,<note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="GEN 38:27-30">उत्प 38:27-30</ref></char></note> आन हेस्रोनोहो अराम, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />अरामोहों अम्मीनादाब, अम्मीनादाबोहो नहशोन आन नहशोनोहो शलमोन, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />शलमोन आन राहाबेए बोवाज ओवू, बोवाज<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="RUT 4:13">रुथ 4:13</ref>,<ref loc="RUT 4:21">21</ref>,<ref loc="RUT 4:22">22</ref> </char></note> आन रुथेहे ओबेद, आन ओबेदोहो इसाय ओवू.<verse eid="MAT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 1:6" />आन इसायोहो दाविद राजा ओवू, <note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="1SA 16:1">1 शमु 16:1</ref>; <ref loc="1SA 17:12">17:12</ref> </char></note> दाविदोअ लाडी जे पेल्लीइ उरीयाआ लाडी<note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2SA 12:24">2 शमु 12:24</ref> </char></note> ओती, तियी पोअ रोत दाविदोहो शलमोन ओवू, <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />शलमोनोहो रहबाम, रहबामोहो आबिया, आबियाहा आसा, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />आसाहा यहोशाफाट, यहोशाफाटोहो योराम, योरामोहो उज्जीया:<note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="1CH 3:10-14">1 इति 3:10-14</ref> </char></note> <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />उज्जीयाहा योथाम, योथामोहो आहाज<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="2KI 15:38">2 राजां 15:38</ref></char></note>, आहाजोहो हिजकिया ओवू, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />हिजकियाहा<note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="2KI 20:21">2 राजां 20:21</ref></char></note> मनश्शे, मनश्शेहे आमोन, आमोनोहो योशिया ओवू, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />आन बाबेलोमेहें ओटक<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2KI 24:14">2 राजां 24:14</ref>,<ref loc="2KI 24:15">15</ref>; <ref loc="2CH 36:5-21">2 इति 36:5-21</ref>; <ref loc="JER 27:20">यिर्म 27:20</ref>; <ref loc="JER 29:1-4">29:1-4</ref>; <ref loc="DAN 1:1">दानि 1:1</ref>,<ref loc="DAN 1:2">2</ref> </char></note> कोइत लेत गोये तेहेलाम योशियाहा<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1CH 3:15">1 इति 3:15</ref>,<ref loc="1CH 3:16">16</ref> </char></note> येखन्यू आन तियाआ पाही ओवा;<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />बाबेलोमेहें ओटक कोइत लेत गोये, तेहेलाम येखन्याहा<note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="1CH 3:17">1 इति 3:17</ref> </char></note> शेल्तीएल, शेल्तीएलोअ जेरुब्बाबेल ओवू<note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="EZR 3:2">एज्रा 3:2</ref>,<ref loc="EZR 3:8">8</ref> </char></note>, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />जेरुब्बाबेलोहो अबीहूद, अबीहूदोहो एल्याकीम, एल्याकीमोहो आज्जूर, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />आज्जूरोहो सादोक, सादोकोहो याखीम, याखीमोहो एलीहूद, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />एलीहूदोहो एलाजार, एलाजारोहो मत्तान, मत्तानोहो याकोब ओवू, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />आन याकोबोहो योसेफ ओवू. ओ योसेफ तियी मरियाआ कोओ धोणी ओतू, जियी मरियाआ पेटे ईसु जल्माहा आयू, जियाहा ख्रिस्त<note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="LUK 2:11">लुक 2:11</ref>; <ref loc="JHN 4:25">योहान 4:25</ref>,<ref loc="JHN 4:26">26</ref> </char></note> कोतेहे.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />एहें कोइत अब्राहामोअहीं रोत ते दाविदोअ जागे जाआं आखी सुहूद पिढ़ी ओवी; आन बाबेलोमेहें ओटक कोइत लेत गोये तिहीं रोत ते ख्रिस्ताआ जागे जाआं सुहूद पिढ़ी ओवी.<verse eid="MAT 1:17" /></para>
  <para style="s">ईसु ख्रिस्ताआ जल्म</para>
  <para style="r">(<ref loc="LUK 2:1-7">लुक 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />ईसु ख्रिस्ताआ जल्म एहें कोइत ओवो; तियाआ आयही मरिया ए योसेफोअ कोअते फुसाअली ओती. पोन एहेलोह देखाअयो के, ते वेहवाल ओवीइलोअ पेल पवित्र आत्मा वाअहीं उंगलीत रोयी.<note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="LUK 1:35">लुक 1:35</ref> </char></note> <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />तियीइ ओवनारु माटी योसेफ ओ धर्मी माटी ओतू, तिहीं वाअहीं तियीइ नाव बिगाड़ीलोअ तियाआ मोर्जी ने ओती. तियाहा काजे तिये मोनेज होगाय तोड़ी देअलोअ विसार कोअयू, <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />एहें कोत तो तियी गोठीइ बाप्तिम विसार कोअया कोअतुतो, ताहां पाला, प्रभुउ एक देवदुत तियाहा होपनामेहें दर्शन आपीत कोयो, “दाविदोअ पोर्‍या, योसेफ, तू मरियाअरी वेहवाल कोइलोअ बिही मा, काहाके तियीइ जो पोटू होय, तो पवित्र आत्मा वाअहीं होय. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />तियीही सोऊ ओवे, आन तू तियाआ नाव ईसु<note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">लुक 1:31</ref>; <ref loc="LUK 2:21">2:21</ref></char></note> मिकजी, काहाके तोज तियाआ माअहुंहूं तियांआं पापोमेहें रोत वासाड़े.”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />ओं आखो याआ काजे ओवो, काहाके जों वसन प्रभुउ भविश्यवक्तां वाअहीं कोयो, तों पुरो ओवुहूं जोवे: <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“पाल, एक कुवांरी पोटाअरी रोये आन तियीही सोऊ ओवे, आन तियाआ नाव ‘इम्मानुएल’ मिके; या नावोअ अर्थ होय ‘देव आपाअरी.’”<note caller="+" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">यश 7:14</ref>; <ref loc="ISA 9:6">9:6</ref>,<ref loc="ISA 9:7">7</ref></char></note><verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />ताहरुउ योसेफ निंदेमेहें रोत उठ्यू, ताहां तिये प्रभुउ दुतोअ आदेशोअ पुरमाणे कोअयो, तिये मरियाअरी वेहवाल कोअयो. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />आन तियीही सोऊ ओवू, ताअहूं जाआं तो तियीही आथ ने लागाड़्यु<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="fq" closed="false">तियीही आथ ने लागाड़्यु </char><char style="ft" closed="false">मोन्ज्ये तियीइरी ने हुतू.</char></note>; आन तिये तिया सोआआ नाव ईसु<note caller="+" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">लुक 2:21</ref> </char></note> मिक्यो.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">दिही उगताअहेंएं जाणकार माटी</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />हेरोद राजाआ<note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="LUK 1:5">लुक 1:5</ref></char></note> दिहोमेहें जेहेलाम यहुदीया मेर्‍याआ बेथलेहेम गांवोंमेहें ईसुउ जल्म ओवो,<note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="MIC 5:2">मिखा 5:2</ref>; <ref loc="LUK 2:4-7">लुक 2:4-7</ref> </char></note> ताहां पाला, दिही उगताअहें रोत ताराआ आभ्यास कोअनारा हुशार माटी येरुसालेमोमेहें आया, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />आन फुसा वोल्या, “जियाआ जल्म ओयोहो तो यहुद्याआं राजा का होय? काहाके आमू दिही उगताआ वोगेहे तियाआ तारु देख्युहू आन तियाहा पागे पोड़ा आयाहा.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />ओं उनाइत हेरोद राजा आन येरुसालेमो मेर्‍येए आखे माअहें काबराइत गोये. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />ताहां तिये यहुदीइ आखा मुख्य पुंजारा आन कायदाआ मास्तर यांहां एकीज जागे एकठा कोइत फुशो के, “ख्रिस्ताआ जल्म का ओवुहूं जोवत्लो?”<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />माहें राजाहा कोयो, “यहुदीयाआ बेथलेहेम गांवोंमेहें,” काहाके भविश्यवक्तां एहें कोइत लेख्योहो के,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“ओ यहुदाअ मुलख, बेथलेहेम,</para>
  <para style="q2" vid="MAT 2:6">तु आखा आधिकार्‍योंम रोत हानू होय, तेबी काय वांदो ने;</para>
  <para style="q1" vid="MAT 2:6">काहाके तामेहें रोत एक एहेलुहू आधिकारी निहे</para>
  <para style="q2" vid="MAT 2:6">जो माआं इस्राएल माअहोंअ राखवाली कोए.”<note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">मिखा 5:2</ref></char></note><verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />तांहा हेरोद ताराआ आभ्यास कोअनारा तियां माट्योहों ठावकुज हादीत कोइत फुशो के, “जो तारु देखाअयू तो नेमकू केती वेलेहे देखाअयुतो?” <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />आन तियांहां ओं कोत कोइत बेथलेहेमोमेहें मोकल्या, “जावा, तिया पोर्‍याआ बाप्तिमेहें वारुहूं तापास कोआ; आन जाहां तो तुमुहूं जोड़े, ताहां माहूं बी खबर कोअजा, ताहां आंय बी आवित तिया पोऱ्याआ पागे पोड़ीहीं.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />ताहराआ ते राजाआ ए गोठ उनाइत कोइत निहींया, ताहां पाला, जो तारु तियां दिही उगताआ वोगेहे देख्युतो, तो जिहीं पोर्‍यो ओतो तिया जागापोअ जात उबू रोत गोयू. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />तिया ताराहा पालीत कोइत तियांहां जाअखीलीही खुसी ओवी. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />ते कोअमेहें गोया, ताहां तिया पोर्‍याहा तियाआ आयही मरियाअरी देख्यो आन तियां तियाआ हुंबर टुंगा पोड़ीत तियाआ भक्ती कोअयी, <note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="ISA 60:3">यश 60:3</ref> </char></note>आन मोगला सामानोअ खोत्लू सोड़ीत होनो, गुगलाआ सिक<note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="ISA 60:6">यश 60:6</ref></char></note> आन गंधरस एहेलिही भेट आप्यी.<figure style="fig" alt="Frankincense branch, censer and incense altar" file="BK00116C.TIF" size="col" copy="Horace Knowles ©" ref="2:11">लोबान, एकी जातीइ तुम्हांवीइलोअ कुड़्यो आन देवान्यो</figure><verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />ताहां तियांहां होपनामेहें<note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MAT 27:19">मत्तय 27:19</ref>; <ref loc="HEB 8:5">इब्री 8:5</ref>; <ref loc="HEB 11:7">11:7</ref></char></note> देवे कोयो, हेरोद राजाअ जागे फाशाअ फिरीत मा जाहा, तियाहा काजे ते बिहीरी वाटे रोत तियांआं देसोमेहें जाता रोया.<verse eid="MAT 2:12" /></para>
  <para style="s">मिसर देसोअहें जाअलोअ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />ताहां ते जाता रोया तिहींइं फासाड़ी, प्रभुउ दुत योसेफोहो होपनामेहें देखाअयू; तिये कोयो, “उठ, पोर्‍याहा आन तियाआ आयहीही लेत मिसर देसोमेहें नाहींत जा, आन आंय ताहूं कोहीं ताअहूं जाआं तिहींज रोजी; काहाके पोर्‍याहा माइलाआ काजे हेरोद होदनारु होय.”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />ताहां योसेफ रातीज उठीत कोइत पोर्‍याहा आन तियाआ आयहीही लेत कोइत मिसर देसोमेहें नाहींत गोयू; <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />आन हेरोद मोयू ताअहूं जाआं तो तिहींज रोयू, याअ काजे के जों वसन प्रभु भविश्यवक्ता वाअहीं कोयोतो तों पुरो ओवुहूं जोवे: “आंय माआं बेटाह्हाहा मिसर देसोम रोत हाद्यू.”<note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">होशे 11:1</ref> </char></note><verse eid="MAT 2:15" /></para>
  <para style="s">पोर्‍याहां माइत टाकीइलोअ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />हेरोद राजाहा जेहेलाम तियां जाणकार माट्यों माहूं ठोग्युहू एहेलोहो तियाहा मुंदू गोयू. ताहां तियाहा जुदी खोत लागी. आन जे वेल तियां जाणकार माट्यों कोताप्यी, तियी वेलेए पुरमाणे बेथलेहेमोमेहें आन तियाआ आहने-पाहनेए आखा मुलखोमेहें तियाआ माअहें मोकलीत कोइत बेन वोर्‍ह्योंअ आन तिया रोत कमी वोर्‍ह्योंअ पोर्‍ये ओते, तियां आखाहा माआड़ी देदे.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />भविश्यवक्ते यिर्मये जों कोयोतो, तों तियी वेले पुरो ओवो, तो एहें कोइते:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“रामामेहें किइमाल्लोहो रोड़ीइलोअ आवाज</para>
  <para style="q2" vid="MAT 2:18">आन वोडी विखा वाअहीं रोड़ीइलोअ आवाज होंबलाअहे,</para>
  <para style="q1" vid="MAT 2:18">राहेल तियीइ पोर्‍यांअ काजे रोड़ेहे,</para>
  <para style="q2" vid="MAT 2:18">काहाके ओमे रोत तें ने रोयेमें;<note caller="+" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="JER 31:15">यिर्म 31:15</ref> </char></note></para>
  <para style="q2" vid="MAT 2:18">तियाहा काजे ते नाहां होमजीइती.”<verse eid="MAT 2:18" /></para>
  <para style="s">मिसर देसोमेहें रोत वापिस आवीइलो</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />हेरोद राजा मोयू, ताहां पाला, प्रभुउ दुत मिसर देसोमेहें योसेफोहो दर्शन आपीत कोयो. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />“ऊठ, पोर्‍याहा आन तियाआ आयहीही लेत इस्राएल देसोमेहें जा, काहाके जें पोर्‍याआ जिव लेअहूं होदतेते, तें मोइत गोयेहे.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />ताहां योसेफ उठीत पोऱ्याहा आन तियाआ अायहीही लेत इस्राएल देसोमेहें आयू.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />पोन तो एहेलोह उनाअयू के, आर्खेलाव ओ तियाआ आब्हा हेरोद याआ जागापोअ यहुदीयामेहें राजा बोण्युहूं, ताहां तो तिहीं जाअलोअ काजे बियू, आन होपनामेहें तियाहा देवे तेहें कोइत खबर आप्‍यी, तियाहा काजे तो गालील मुलखोमेहें जातु रोयू. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />आन तिये नासरेथ नावोअ गांवोंमेहें जात वोहती कोअयी काहाके, “तियाहा नासरी कोये”<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MRK 1:9">मार्क 1:9</ref>,<ref loc="MRK 1:24">24</ref>; <ref loc="LUK 2:39">लुक 2:39</ref>,<ref loc="LUK 2:51">51</ref>; <ref loc="LUK 4:16">4:16</ref>; <ref loc="JHN 1:45">योहान 1:45</ref>,<ref loc="JHN 1:46">46</ref> </char></note> एहें कोत भविश्यवक्ता जों कोयोहो तों पुरो ओवुहूं जोवे याअ काजे एहलोहो ओवो.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">बाप्तिस्मा कोअनारु योहान आन तियाआ बाशण</para>
  <para style="r">(<ref loc="MRK 1:1-8">मार्क 1:1-8</ref>; <ref loc="LUK 3:1-18">लुक 3:1-18</ref>; <ref loc="JHN 1:19-28">योहान 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />तियां दिहोमेहें बाप्तिस्मा आपनारु<note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="MAT 11:2-14">मत्तय 11:2-14</ref>; <ref loc="MAT 14:1-12">14:1-12</ref>; <ref loc="LUK 1:13">लुक 1:13</ref>,<ref loc="LUK 1:57-66">57-66</ref>; <ref loc="ACT 19:3">प्रेशित 19:3</ref>,<ref loc="ACT 19:4">4</ref> </char></note> योहान यहुदीयाआ जंगलोमेहें आवित एहेलुहू परसार कोउ वोल्यू के, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />“तुमाआं पापोहो सोड़ीत मोन फिरवा!” “काहाके होरगाआ राज<note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">मत्तय 4:17</ref>; <ref loc="MAT 7:21">7:21</ref>; <ref loc="MRK 1:15">मार्क 1:15</ref>; <ref loc="LUK 10:9">लुक 10:9</ref>; <ref loc="LUK 11:20">11:20</ref>; <ref loc="LUK 17:20">17:20</ref>,<ref loc="LUK 17:21">21</ref>; <ref loc="LUK 21:31">21:31</ref>; <ref loc="JHN 3:3">योहान 3:3</ref>,<ref loc="JHN 3:5">5</ref> </char></note> आहने आवित लागोहो.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />ओ तोज होय, जियाअ बाप्तिमेहें यशया भविश्यवक्ते कोयोतो:</para>
  <para style="q1" vid="MAT 3:3">“रानोमेहें एका बोंबलीइनाराआ आवाज आवेहे,</para>
  <para style="q2" vid="MAT 3:3">‘प्रभुउ सड़क तियार कोआ;</para>
  <para style="q2" vid="MAT 3:3">तियाआ वाट हुदी कोआ!’”<note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यश 40:3</ref>; <ref loc="MAL 3:1">मला 3:1</ref>; <ref loc="LUK 1:76">लुक 1:76</ref> </char></note><verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />योहान उटड़ाआ रुंग्हाआ आंगड़े पोवित ओतू<note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 राजां 1:8</ref></char></note>, आन तियाआ कंबरेमेहें सांबड़ाआ पोट्टू ओतू, तियाआ खाणो टिडे<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="fq" closed="false">टिडे </char><char style="ft" closed="false">अक्रिदेस ओं युनानी बाशाआ शब्द होय, कनान देसोमेहें पाकनारा करब नावोअ साड़ोअ पापड़्याआ बाप्तिम बी कोहे.</char></note>, आन रानोमेऱ्योअ मोद ओतो. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />ताहरेए येरुसालेमोमेर्‍येए आन पुरा यहुदीया मेर्‍येए आन यारदेन खाडीइ आहने-पाहनेए बादा गांवोंमेहें रोनारे माअहें तियाआ जागे आये. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />आन जिवज्योअ गुनां कबुल कोइत यारदेन खाडीमेहें तियाआ आथे बाप्तिस्मा<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="fq" closed="false">बाप्तिस्मा </char><char style="ft" closed="false">सोको ओवीइलोअ उद्देशो वाईं माहुंहूं पाअयों मेहें बुडाड़ीत बारथे काडीलोअ नियम</char></note> लेदो.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />जाहां फरिसी<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="fq" closed="false">फरिसी </char><char style="ft" closed="false">ईसुउ जमाना मेर्‍याआ यहुदी पंथाआ आन राजकारणी पुढार्‍योंअ टोलू</char></note> आन सादूकी<note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 16:1">मत्तय 16:1</ref>,<ref loc="MAT 16:11">11</ref>,<ref loc="MAT 16:12">12</ref>; <ref loc="MAT 23:13-36">23:13-36</ref>; <ref loc="ACT 23:6-7">प्रेशित 23:6-7</ref></char></note> यांमेर्‍याआ वारुज जोओंहों बाप्तिस्माआं काजे तियाआ वोगेहे आवत्लाहा देखीत तिये तियांहां कोयो, “ए हापोअ पिलां, देवोअ आवनारी खोते रोत नाहींइलोअ काजे तुमुहूं कोडे कोत देदो? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />तुमू पापोअहें रोत फिरीत देवोअ वोगेहे सालताहा, एहेलोह जिवन सोताहा जिवीत देखाड़ा. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />आन अब्राहाम आपाआ बाह्हू होय एहें कोत कोअलोअ विसार तुमू तुमाआं मोनोमेहें कोअहा मा; काहाके आंय तुमुहूं कोहो के, देव अब्राहामोअ काजे यां डोणोओं पोर्‍ये उब्जाड़ीत सेकेहे. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />आन ओमेज रोत साड़ोअ थुड़ोमेहें कुवाड़ो मिक्योहो; एताआ वोतीइ के जों साड़ हाजो फल नाहां आपतो, तों साड़ वाडीत कोइत आगीमेहें टाकी देवाय. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />आंय पाअयों वाअहीं तुमुहूं मोन फिरावीलाआ बाप्तिस्मा आपोहो, पोन जो माआं फासाड़ी आवनारु होय, तो माआं रोत बी जाअखु ताकतवान होय, आंय तियाआ खाहड़े तोइलोअ बी लायकीइ नाहां; तो तुमुहूं पवित्र आत्मा वाअहीं आन आगी वाअहीं बाप्तिस्मा आपे. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />तियाआ आथोमेहें हुप होय, आन तो तियाआ खोलो सोको कोए आन तियाआ गोंवें मोठीमेहें मिके, पोन पुहूटो केदिहींज ने उलाअनारी एहेलिही आगीमेहें पेटाड़ी देय.”<verse eid="MAT 3:12" /></para>
  <para style="s">ईसुउ बाप्तिस्मा</para>
  <para style="r">(<ref loc="MRK 1:9-11">मार्क 1:9-11</ref>; <ref loc="LUK 3:21">लुक 3:21</ref>,<ref loc="LUK 3:22">22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />ताहां योहानोअ आथे बाप्तिस्मा लेअलोअ काजे ईसु गालीलोम रोत यारदेन खाडीइ मेरे आयू. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />पोन योहान तियाहा कोनु वोल्‍यू, “आंय ताआ आथे बाप्तिस्मा लेअहूं जोगोहो होये, तेबी तू माआं आथे बाप्तिस्मा लेनु आयुहू?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />पोन ईसु तियाहा उत्तर आप्यो, “ओमे एहेंज कोइत ओवुहूं देमे; काहाके जों जों खोरो होय तों तों आपू कोअहूं जोवे एहेलिही देवोअ इश्शा होय.” ताहां योहाने तियाआ गोठ मानित लेदी.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />बाप्तिस्मा लेत कोइत ईसु पाअयोंमेहें रोत बाअथे निहींताज जुग उगड़ीत गोयु, आन देवोअ आत्मा पेरवाअ होस तियापोअ उतरीइत्लूज देख्यू. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />आन पाला, जुगोमेहें रोत एक आवाज आयू, “ओ माआं मेरालू बेटुह्हू होये, याआ बाप्तिमेहें आंय जुदू खुस होये.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">ईसुउ परिक्शा</para>
  <para style="r">(<ref loc="MRK 1:12-13">मार्क 1:12-13</ref>; <ref loc="LUK 4:1-13">लुक 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />ताहां सैतानो वाअहीं परिक्शा ओवुहूं जोवे कोत आत्मा ईसुहू जंगलोमेहें लेत गोयू. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />आन तिये सालीही दिही आन सालीही रात उपास कोअयू, तिहींइं फासाड़ी तियाहा फुक लागी. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />ताहरुउ परिक्शा लेनारे आहने आवित कोइत कोयो, “तू जर देवोअ बेटुह्हू ओय, ताहां यां डोणोहों रोटू ओवे तेहें आदेश आप.”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />पोन ईसु उत्तर आपीत कोयो, “देवोअ वसनोमेहें एहें कोइत लेख्योहो के, माअहुंउं निस्त रोटा वाअहीं एतोज नाहां, पोन देवोअ सोबीमेहें रोत निहींनारा हारेक वसनो वाअहीं जिवे.”<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />ताहां सैतान ईसुहू पवित्र होयरोमेहें लेत आयू, आन मंदिरोअ सुटीपोअ उबू कोअयू. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />आन तियाहा कोयो, “जर तू देवोअ बेटुह्हू ओय, ताहां निसे उडीत पोड़;” काहाके एहेलोह लेखाअयोहो के,</para>
  <para style="q1" vid="MAT 4:6">“‘तो तियाआ दुतोंहों ताआ काजे आदेश आपे,</para>
  <para style="q2" vid="MAT 4:6">आन ताआ गुडा डोणोहों ठोकाअहूं ने जोवे काजे</para>
  <para style="q2" vid="MAT 4:6">ते ताहूं उसाअ उसेज सेलवीत लेये.’”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />ईसु तियाहा कोयो, “वसनोमेहें ओं बी लेख्योहो के, ‘तू, ताआ देव प्रभु याआ परिक्शा मा लेही.’”<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />फाशुउ सैतान ईसुहू जाअखीला उसा डोगोपोअ लेत गोयू, आन दुन्यामेर्‍योअ आखो राज आन तियाआ वोडी वोडी गोठी तियाहा देखाड़्यी. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />आन सैताने तियाहा कोयो, “जर तू माआं पागे पोड़ीत भक्ती कोअही, ताहां आंय ओं आखो बादो ताहूं आपी देहीं.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />ताहां ईसु तियाहा कोयो, “ए सैतान! माआं जागेहे रोत निहींत जा, काहाके लेख्योहो, ‘तू, ताआ देव प्रभु याआ पागे पोड़, आन निस्तु तियाआज भक्ती कोअ!’”<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />ताहां सैतान ईसुहू सोड़ीत निहींत गोयू: आन पाला, देवोअ दुत आवित ईसुउ सेवा कोआ वोल्या.<verse eid="MAT 4:11" /></para>
  <para style="s">गालीलोमेहें ईसुउ कामोअ सुरुवात</para>
  <para style="r">(<ref loc="MRK 1:14">मार्क 1:14</ref>,<ref loc="MRK 1:15">15</ref>; <ref loc="LUK 4:14">लुक 4:14</ref>,<ref loc="LUK 4:15">15</ref>,<ref loc="LUK 4:31">31</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />जेहेलाम ईसु उनाअयू के योहानोहो जेलेम केंड्युहू, तेहेलाम तो गालीलोमेहें जातु रोयू. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />आन नासरेथ सोड़ीत तो जबुलुन आन नफताली यां मुलखोमेर्‍याआ दोर्‍याआ मेरे कफर्णहुम होयरोम आवित रोनु वोल्यू. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />ओं याआ काजे ओवो के, यशया भविश्यवक्ते जों कोयोतो, तों पुरो ओवुहूं जोवे, तों एहेलोहो होये:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“दोऱ्याआ वाटेएहें जबुलुन आन नफतालीइ मुलख,</para>
  <para style="q2" vid="MAT 4:15">यारदेन खाडीइ तियी वोगर्‍याआ,</para>
  <para style="q2" vid="MAT 4:15">बिगर यहुदी माअहुंउं गालील मुलख!<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />जे माअहें आंदारामेहें जिवतेहे,</para>
  <para style="q2" vid="MAT 4:16">तियां वोडो उजालो देख्यो;</para>
  <para style="q1" vid="MAT 4:16">आन जें मोतोअ देसोम आन सावलामेहें रोतेहे,</para>
  <para style="q2" vid="MAT 4:16">तियांपोअ उजालो सोमक्यो.”<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />तेहेलाम रोत ईसु संदेश कोनु वोल्यू के, “तुमाआं पापोअहें रोत फिरा, काहाके होरगाआ राज आहने आयोहो!”<verse eid="MAT 4:17" /></para>
  <para style="s">शार मासाराहां ईसु हादत्लू</para>
  <para style="r">(<ref loc="MRK 1:16-20">मार्क 1:16-20</ref>; <ref loc="LUK 5:1-11">लुक 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />ईसु गालीलोअ दोऱ्याआ टेकोपोअ रोत जानु वोल्यू; ताहां तिये बेनू पायहोहो मोन्ज्ये पेत्र कोतेहे तिया शिमोनोहो, आन तियाआ पाही आंद्रिया यांहां दोर्‍यामेहें जाल टाकत्लाहा देख्या; काहाके ते मासारा ओता. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />ईसु तियांहां कोयो, “तुमू माआं फासाड़ी आवा, ताहां आंय तुमुहूं देवोअ राजोमेहें माहें तोअनारा बोणाविहीं.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />ते ताबुड़तुड़ जालीही सोड़ीत देत ईसुउ फासाड़ी गोया.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />आन तिहीं रोत आगाड़ी जात ईसु बिहीरा बेन पायहोहो देख्या, ते जब्दीइ पोर्‍या याकोब आन तियाआ पाही योहान, यांहां तियांआं आब्हू जब्दी याअरी नावड़ामेहें तियांआं जाल हुदारत्लाहा देख्या आन ईसु तियांहां हाद्या. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />ताहां ते ताबुड़तुड़ नावड़ाहा आन तियांआं आब्हाहा टाकी देत ईसुउ फासाड़ी गोया.<verse eid="MAT 4:22" /></para>
  <para style="s">ईसुउ हिकवोण, परसार, आन नेराय</para>
  <para style="r">(<ref loc="LUK 6:17-19">लुक 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />ईसु पुरा गालीलो मेहें फिरतुज यहुदीइ आराधनालयो मेहें सिकाडतु आन राज्याआ हाजी बातमीइ परसार कोअतू, आन माअहुंउं हारेक जातीइ बिमारी आन आखी जातीइ कमजोरी हुदारतु फिर्‍यू. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />आन पुरा सिरिया देसोमेहें तियाआ बातमी पसरीत गोयी; आन माअहें आखा बिमारी वालाहां, जे जुदी जुदी बिमारी आन कमजोरी मेहें दाबाइत रोयेते, आन जियां मेहें पुतोअ आत्मा ओती, आन फेपरा वाले आन लखवाआ बिमारी वालाहां, तियाआ जागे लेतावये आन तिये आखाहा हाजे कोअये. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />ताहां गालील आन दकापलीस<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">दोहो गावोंअ मुलोख; </char><char style="xt"><ref loc="MRK 5:20">मार्क 5:20</ref>; <ref loc="MRK 7:31">7:31</ref></char></note>, येरुसालेम, यहुदीया, आन यारदेन खाडीइ तियी मेरेए मुलखो मेर्‍येए गोवारान गोवारा माअहें ईसुउ फासाड़ी जाने वोल्ये.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">टुरापोर्‍यीइ ईसुउ हिकवोण</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />ईसु माअहोंअ गोवाराहा पालीत टुरापोअ सोड़ीत लागू, आन जेहेलाम निसे बोठू, ताहां तियाआ सेला तियाआ जागे आवया. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />आन तो तियांहां सिकाडू वोल्यू.<verse eid="MAT 5:2" /></para>
  <para style="s">आशिर्वादोअ वसन</para>
  <para style="r">(<ref loc="LUK 6:20-23">लुक 6:20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“‘जें आत्मामेहें गरीब होय, तियांआं हाजो होय,</para>
  <para style="q2" vid="MAT 5:3">काहाके होरगाआ राज तियांआंज होय;<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />जें तारास कोअतेहे, तियांआं हाजो होय,</para>
  <para style="q2" vid="MAT 5:4">काहाके तियांहां होक जोड़े;<note caller="+" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="ISA 61:2">यश 61:2</ref> </char></note><verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />जें नम्र तियांआं हाजो होय,</para>
  <para style="q2" vid="MAT 5:5">काहाके तें धरतीइ आधिकारी बोणे;<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />जें सतीपणोअ काजे फुकल्ये आन तोरह्ये होय तियांआं हाजो होय,</para>
  <para style="q2" vid="MAT 5:6">काहाके देव तियांहां तारवे!<note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 55:1">यश 55:1</ref>,<ref loc="ISA 55:2">2</ref></char></note><verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />जें दयालू तियांआं हाजो होय,</para>
  <para style="q2" vid="MAT 5:7">काहाके तियांपोअ दया ओवे!<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />जें मोनोमेहें सोके होय, तियांआं हाजो होय,</para>
  <para style="q2" vid="MAT 5:8">काहाके तें देवोहो देखे;<note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 24:3">भजन 24:3</ref></char></note><verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />जें होमजाड़ीलाआ काम कोअतेहे, तियांआं हाजो होय,</para>
  <para style="q2" vid="MAT 5:9">काहाके तियांहां देवोअ पोर्‍ये कोये.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />सतीपणोअ काजे जियांहां तारास ओवू, तियांआं हाजो होय.</para>
  <para style="q2" vid="MAT 5:10">काहाके होरगाआ राज तियांआंज होय;’<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />“जाहां माआं काजे माअहें तुमाआं विरुद्धामेहें गोगे, तारास देय आन तुमाआं विरुद्धामेहें आखी जातीइ खाराब लबाड़ी कोइत गोगे, ताहां तुमाआं हाजो होय. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />मोज्या कोआ, खुसीवाअहीं उसला, होरगामेहें तुमाआं इलाम वोडू होय; काहाके तुमा रोत पेल जे भविश्यवक्ता ओत गोया, तियांहां तियां एहेंज कोइत दुख वेठाड़्यो.<note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="ACT 7:52">प्रेशित 7:52</ref></char></note><verse eid="MAT 5:12" /></para>
  <para style="s">खारो आन दिवू</para>
  <para style="r">(<ref loc="MRK 9:50">मार्क 9:50</ref>; <ref loc="LUK 14:34">लुक 14:34</ref>,<ref loc="LUK 14:35">35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“तुमू धरतीइ खारो होय; पोन जर खाराआ खारी सव निहींत गोयी, ताहां फाशोअ तियाहा कि कोइत खारसो बोणावता आवे? ओनखे तियाआ कोड्लाज कामोम वापर ने ओवनारु, पोन तियाहा बाअथे टाकी देत आन माअहोंओं गुडाआ थुड़ी सेंदीइलाआ कामोम आवनारो.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />“तुमू दुन्याआ उजालो होय; टुशा पोर्‍योओ होयर निकाइत नाहां सेकतो. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />दिवू पेटाड़ीत कोइत टोपलीइ थुड़ी नाहां मिकते, पोन तियाहा बेलकाआ उसे मेकतेहे, याआ काजे के जें कोअमेहें होय तियां बादाहा तो उजालो आपित सेके; <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />तेहेंज कोइत तुमाआं उजालो माअहोंओं हुंबूर एहेलोहो पोड़ुहूं द्या के, तें तुमाआं हाजे कामे पालीत तुमाआं होरगामेर्‍याआ आब्हाआ नाव उसो कोए.<verse eid="MAT 5:16" /></para>
  <para style="s">कायदाआ बाप्तिम हिकवोण</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“एहेलोहो मा समजाहा, के आंय मोशेए कायदाआ नेताहां भविश्यवक्ताआं हिकवोण खुड़ीत टाकीइलो काजे आयुहू. आंय आरवीत टाकू नाहां, पोन पुरो कोउ आयुहू. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />काहाके आंय तुमुहूं नक्की कोहो के, जुग आन धरती सेलाइत जाय, ताअहूं जाआं आखी गोठी पुरी ओया सिवाय कायदाआ पुस्तकोअ एक बी कानू नेत मात्रू ने टोले<note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">लुक 16:17</ref></char></note>. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />तिहीं वाअहीं जों कोडो या वाहीं एवडा आदेशोमेहें रोत एकदू काडीत टाके आन तेहेंज कोइत माअहुंहूं सिकाड़े, तों होरगाआ राजोमेहें जाअखो हानो गोणाय; पोन जों कोडो तियाहा माने आन सिकाड़े, तों होरगाआ राजोमेहें वोडो गोणाय. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />आंय तुमुहूं कोहो, कायदाआ सिकाड़नारा मास्तर आन फरिसी यांआं सतीपणो रोत तुमाआं सतीपण वादार ओया सिवाय तुमू होरगाआ राजोमेहें ने जात सेकनारा.<verse eid="MAT 5:20" /></para>
  <para style="s">खोतेए बाप्तिम हिकवोण</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“खुन मा कोअही; जों कोडो खुन कोए तों कोर्ठामेहें डोंडोअ दोशी ठरे, एहें कोइत वेगाआ माअहुंहूं कोयोतो, ओं तुमू उनाअयाहा.<note caller="+" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">निर्ग 20:13</ref>; <ref loc="DEU 5:17">कायदा 5:17</ref></char></note> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />पोन आंय तुमुहूं कोहो के, जिया कोडाहा तियाआ पायहोपोअ उदड़ीज खोत लागतीय, तियाहा कोर्ठाम डोंड जोड़े; जों कोडो तियाआ पायहोहो ‘ए फोगा,’ एहें कोये, तों वोडा पोन्साम डोंडाअहूं जोगोहो बोणे, आन जों कोडो तियाआ पायहोहो ‘ओ विण ओकल्या!’ एहें कोये, तियाहा नरकाआ आगीम जाअहूं पोड़े. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />तिहीं वाअहीं, जर तू ताआ गाराहा देवान्यापोअ लेत आवही, आन तिहीं ताहूं ओर आवे, के माआं मोनोमेहें माआं पायहोअ विरुद्दाम कि तेबी गोठ होय, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />ताहां तू ताआ गाराहा तिहींज देवान्याअ सामने मिकी दे, आन जात कोइत पेल ताआ पायहोअरी होमजोण कोइत ले, आन तिहींइं फाटी आवित कोइत ताआ ते गाराहा आप.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />“जर ताआ दुस्मोन ताआ विरुद्धामेहें आरोप लेतावे, आन ताहूं कोर्ठम लेत जाय, ताहां तापोअ वेल होय ताअहांज कोर्ठम जाअलोअ पेल तू तियाअरी होमजोण कोइत ले. नेत एकवारी तू तिहीं जाही, ताहां तो ताहूं न्यायाधिशोअ आथोम तोइत आपी देय, आन तो न्यायाधिश ताहूं पुलशोअ आथोम होपी देय, आन पुलिस ताहूं जेलेम टाकी देय. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />आंय ताहूं नक्की कोहो, जाअहूं जाआं आनोन आनो डोंड ने पोई देही, ताअहूं जाआं तू तियामेहें रोत ने सुटही.<verse eid="MAT 5:26" /></para>
  <para style="s">सिनालाआ बाप्तिम हिकवोण</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“तु सिनालो मा कोअही; एहें कोइत कोयोतो, तों तुमू उनाअयेहे.<note caller="+" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">निर्ग 20:14</ref>; <ref loc="DEU 5:18">कायदा 5:18</ref></char></note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />पोन आंय तुमुहूं कोहो के, जो कोडो एकदी बोईंइ वोग बाक्ती नजर बी टाक्यी, तेबी तो तियाआ मोनोम तियीइरी सिनालो कोइत सुकुहू. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />जर ताआ हाजाड्यू डोऊ ताहूं पाप कोआड़तुय, ताहां तियाहा काडीत टाकी दे; काहाके ताआ पुरो डिल नरकाम जाय तिया रोत हाजो, ताआ डिलोअ एक भाग आरवात जाय तो फायदाअ होय. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />जर ताआ हाजाड़्यू आथ ताहूं पाप कोअहूं लागाड़तुय, ताहां तु तियाहा वाडीत टाकी दे; काहाके ताआ पुरो डिल नरकाम जाय, या रोत हाजो जी तु ठुटू ओत जाही तो ताहूं पुरड़े.<verse eid="MAT 5:30" /></para>
  <para style="s">सोड़ले ओविइलाआ बाप्तिम हिकवोण</para>
  <para style="r">(<ref loc="MAT 19:9">मत्तय 19:9</ref>; <ref loc="MRK 10:11">मार्क 10:11</ref>,<ref loc="MRK 10:12">12</ref>; <ref loc="LUK 16:18">लुक 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“ओं बी कोयोतो के, ‘जों कोडो तियाआ लाडीही सोड़नारो ओय, तों तियीही सोड़सिट्टी आपुहूं जोवे.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />पोन आंय तुमुहूं कोहो के, जों कोडो तियाआ लाडीही सिनालाअ वासी बिहीरा कोड्ला कारणो वाअहीं सोड़सिट्टी आपे, ताहां तों तियीही सिनालो कोआड़ेहे; आन जों कोडो तियी सोड़ल्यी बोईंइरी वेहवाल कोअहे, तों बी सिनालो कोअहे.<note caller="+" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="LUK 16:18">लुक 16:18</ref>; <ref loc="1CO 7:10">1 करिन्थ 7:10</ref>,<ref loc="1CO 7:11">11</ref></char></note><verse eid="MAT 5:32" /></para>
  <para style="s">शप्पतेए बाप्तिम हिकवोण</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“ओं बी तुमू उनाअयेहे के जुना वाडोमेर्‍याआ माअहूं कोयोतो, ‘खोटी शप्पत मा खाही, पोन ताआ शप्पत प्रभुउ सामने पुरी कोअजी.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />पोन आंय तुमुहूं कोहो, के शप्पत लेहाज मा; होरगाआ बी मा लेहा, काहाके तों देवोअ राजगादी होय; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />धरतीइ बी मा लेहा, काहाके ते तियाआ गुडा मेकीइलोअ पाट्लू होय. येरुसालेमोअ बी मा, काहाके तों महान राजाआ होयर होय. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />तू ताआ मुन्काआ बी शप्पत मा लेही, काहाके तू ताआ एक बी सिंग्यो पांडो नेताहां कालो नाहां कोइत सेकतु. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />पोन तुमाआं गोगीइलोअ ‘होव’ ताहां होवजे आन ‘नाहां’ ताहां नाहांज जोवे. काहाके या रोत वादार जों होय, तों सैतानोप रोत होय.<verse eid="MAT 5:37" /></para>
  <para style="s">बोदलू लेअलाआ बाप्तिम हिकवोण</para>
  <para style="r">(<ref loc="LUK 6:29">लुक 6:29</ref>,<ref loc="LUK 6:30">30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“‘डोआअ बोदले डोऊ, आन दातोअ बोदले दात’ एहें कोयोतो, तों तुमू उनाअयेहे. <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />पोन आंय तुमुहूं कोहो, के जों कोडो तुमाआं बाक्तो कोए, तियाआ बोदलू मा लेहा; पोन जों कोडो ताआ हाजाड़्या गालोपोअ देय, ताहां बांगाड़्यू गाल बी आगोअ कोई दे. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />आन जर कोडो ताहूं ताआ आंगड़ाआ काजे आरोप लागाड़ीत कोर्ठामेहें लेत जाअहूं होदे, ताहां तियाहा ताआ कोट बी आपी दे. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />आन जर एकदो ताहूं उदाबादीज एक डोंग होंडाड़े, ताहां तियाअरी बेन डोंग जा. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />जो कोडो तापोअ मागे, तियाहा आप; आन जों कोडो तापोअ उसन्यो मागे, ताहां तियाआ वोगेहे सोब मा मुउड़ीही.<verse eid="MAT 5:42" /></para>
  <para style="s">दुस्मोनोहों मेर कोइलोअ</para>
  <para style="r">(<ref loc="LUK 6:27">लुक 6:27</ref>,<ref loc="LUK 6:28">28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“‘ताआ दोस्ती पोअ मेर कोअ, आन ताआ दुस्मोनोअ सीस कोअ’ एहें कोयोतो, तों तुमू उनाअयेहे. <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />पोन आंय तुमुहूं कोहो के, तुमू तुमाआं दुस्मोनोहों मेर कोआ, आन जे तुमुहूं तारास कोआड़तेहें, तियांआं काजे प्रार्थना कोआ. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />एहें कोइत, तुमू तुमाआं होरगामेर्‍याआ आब्हाआ पोर्‍ये बोणहां; काहाके तो बाक्ता आन हाजा बेनू पोअ बी दिही उगाड़ेहे, आन धर्मी आन पापी बेनू पोअ बी वोऱ्हात पाड़ेहे. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />काहाके जें तुमापोअ मेर कोअतेहे, तियांपोअ तुमू बी मेर कोअहा, ताहां तुमुहूं कि इलाम जोड़े? नाकेदार बी एहेंज कोअताहा के नाहां? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />आन जर तुमू फक्त तुमाआं पाव्हीइलाहा एतेज गोगाड़हा, ताहां की वोडो काम कोअतेहे? बिहीरे माअहें बी तेहेंज कोअतेहे के नाहां? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />तियाहा काजे जेहलुहू तुमाआं होरगामेर्‍युउ आब्हू पाक्कू होय, तेहलेज तुमू बी पाक्के बोणा.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">दानधरम</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“हेएजा! तुमू माअहोंहों देखाड़ीइलोअ काजे सेवाभक्तीइ कामें मा कोअहा, जर तुमू एहें कोअहा, ताहां तुमाआं होरगामेर्‍याआ आब्हाप रोत तुमुहूं किज इलाम ने जोड़े.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />“तिहीं वाअहीं जाहां तू गोरब्योहो दानधरम कोअही, ताहां आगाड़ी आगाड़ी भोंगू मा वाजाड़ही, जेहें कोइत वोडार्‍या आराधनालयोमेहें आन वाटेपोअ माअहें तियांआं वोडाय कोए तेहें काजे भक्ती कोअताहा, तेहलोहो तू वोडू देखावू मा कोअही. आंय तुमुहूं खोरीज कोहो, के तियांआं फल तियांहां जोड़ीत गोयोहो. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />पोन जाहां तू गोरब्योहो दानधरम कोअही, ताहां तों मोनेज कोअजी, जो ताआ हाजाड़्यू आथ कोए, तों बांगाड़्या आथोहो ने मुंदू जाअहूं जोवे. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />तिहीं वाअहीं, ताआ दानधरम तू मोनेज कोअहूं जोवे, आन ताआ होरगामेऱ्युउ आब्हू, जो ताहूं एखलामेहें पालेहे, तो ताहूं तियाआ फल आपे.<verse eid="MAT 6:4" /></para>
  <para style="s">प्रार्थना कि कोइत कोइलो</para>
  <para style="r">(<ref loc="LUK 11:2-4">लुक 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“जेहेलाम तू प्रार्थना कोअही, तेहेलाम तू वोडार्‍याआं होस मा कोअही! काहाके तियांहां आराधनालयोमेहें आन वाटे पोअ उबा रोत प्रार्थना कोइलोअ गोमत्लो. आंय तुमुहूं खोरीज कोहो, के तियांहां तियांआं फल जोड़ीत गोयोहो. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />पोन जेहेलाम तू प्रार्थना कोअही, तेहेलाम तू ताआ खुलीम जा; आन बाअणो वालित ले, आन ताआ होरगा मेऱ्याआ आब्हाहा एखलामेहें प्रार्थना कोअ. ताहां ताआ होरगा मेऱ्युउ आब्हू जो ताहूं एखलामेहें पालेहे तो ताहूं फल आपे.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />“जाहां तू प्रार्थना कोअही, ताहां बिगर यहुदी माअहुंउं होस उदड़ीज मा पोणीहीं; काहाके तियांहां लागेहे के आपू जाअखा गोगहूं, ताहां देव आपाअ उनाइत लेय. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />पोन तुमू तियांआं होस मा बोणहा, काहाके तुमुहूं कि गरज होय तों तुमाआं मागीइलोअ पेल तुमाआं आब्हाहा मुंदू होय.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />“तिहीं वाअहीं तुमू एहें कोइत प्रार्थना कोआ:</para>
  <para style="q1" vid="MAT 6:9">“‘ओ आमाआं होरगामेर्‍याआ बा,</para>
  <para style="q2" vid="MAT 6:9">ताआ नाव सोको मानाअहूं जोवे.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />ताआ राज आवुहूं जोवे. जेहें कोइत होरगामेहें तेहें कोइत धरती पोअ बी</para>
  <para style="q2" vid="MAT 6:10">ताआ ईश्शाआ परमाणे ओवुहूं जोवे.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />आमाआं दाडख्‍युउ रोटू आज आमुहूं आपेए.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />आन जेहें कोइत आमू आमाआं गुनेगारोहों माफ कोअयेहे,</para>
  <para style="q2" vid="MAT 6:12">तेहेंज कोइत तू आमाआं गुना माफ कोअ.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />आन आमुहूं परिक्शाम मा लेत जाही,</para>
  <para style="q2" vid="MAT 6:13">पोन बाक्तायी रोत वासाड़; काहाके राज, ताकत आन महिमा कायम ताआज होय.’ आमेन.<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />“तियाहा काजे जर तुमू माअहुंउं गुना माफ कोअहा, ताहां तुमाआं होरगामेर्‍युउ आब्हू बी तुमुहूं माफ कोए. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />पोन जर तुमू बिहीराहा माफ ने कोअहा, ताहां तुमाआं आब्हू बी तुमाआं गुना माफ ने कोए.<verse eid="MAT 6:15" /></para>
  <para style="s">उपासोअ बाप्तिम हिकवोण</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“तुमू जाहां उपास कोअहा, ताहां ढोंगड़ा कोअनाराअ होस आखाहा देखाय तेहें काजे कोमाअली सोबीज उपास मा कोअहा. आंय तुमुहूं नक्की कोहो के, तियांहां तियांआं फल मिलीत गोयोहो. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />तु जेहेलाम उपास कोअही, तेहेलाम ताआ मुंडोअरी तेल हारीत ले, ताआ सोब तुवीत, सिंग्ये ओखवीत ले. <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />मोन्ज्ये, तू उपास कोअही तों माअहोंहों नाहां, पोने देव आब्हाहा देखाअहूं जोवे, जो ताहूं गुप्तमेहें उपास कोअत्लू देखीत कोइत बक्शीस आपे.<verse eid="MAT 6:18" /></para>
  <para style="s">होरगामेएं धन</para>
  <para style="r">(<ref loc="LUK 12:33">लुक 12:33</ref>,<ref loc="LUK 12:34">34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“धरती पोअ तुमाआं काजे धन मा हाटवाहा, जिहीं ओदायो आन किट लागीत आरवात जाहे, आन बांड कोअ फोड़ीत कोइत सोइत लेताहा. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />तियाहा काजे होरगामेहें तुमाआं काजे धन हाटवा, जिहीं ओदाय ने लागे आन किट ने लागे आन बांड कोअ फोड़ीत सोरी बी नाहां कोअता. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />काहाके जिहीं ताआ धन होय तिहीं ताआ मोन बी लागीत रोय.<verse eid="MAT 6:21" /></para>
  <para style="s">शरीरोअ उजालो</para>
  <para style="r">(<ref loc="LUK 11:34-36">लुक 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“डोऊ शरीरोअ दिवू होय; याआ काजे ताआ डोऊ हाजू ओय, ताहां आखो शरीर बी उजालामेहें रोय. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />पोन ताआ डोऊ बाक्तू ओय, ताहां ताआ आखो शरीर आंदारामेहें रोय, तिहीं वाअहीं तामेर्‍योअ उजालोज जर आंदारो रोय, ताहां तों आंदारो किजातीइ वोडो रोये!<verse eid="MAT 6:23" /></para>
  <para style="s">देव आन धन</para>
  <para style="r">(<ref loc="LUK 16:13">लुक 16:13</ref>; <ref loc="LUK 12:22-31">12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“कोडो बी बेन धण्योअ साकरी नाहां कोइत सेकतो, काहाके तों एकाहा सीस कोए आन बिहीराहा मेर कोए; नेत एकाअरी हाजो आन बिहीराअरी बाक्तो रोय. तुमू देवोअ आन पोशाआ बेनुउं साकरी एकवाऱ्यीज नाहां कोइत सेकते.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />“याआ काजे आंय तुमुहूं कोहो के, आपाआ जिवोअ काजे ए सिंता मा कोअहा, के आमू कि खाहूं आन कि पीहूं; आन नेत आपाआ शरीरोअ काजे कि पेवहूं. केहें जिव रोटा रोते आन शरीर आंगड़ा रोत मोगो नाहां के? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />जुगोमेर्‍याआ सिड़ाअहें पाला; के तें नाहां पेएते, नाहां वाडते, आन नाहां हाटवीत मोठीमेहें मिकते; तेबी तुमाआं होरगामेर्‍युउ आब्हू तियांहां खायतेहें आपेहे; तुमू तियां रोत वादार मोगे नाहां के? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />तुमामेहें कोडो होय, जो सिंता कोइत तियाआ जिवणाआ वय एक आथ पोइत वादाड़ीत सेकेहे?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />“आन आंगड़ाआ काजे काहा सिंता कोअतेहे? जंगलोमेर्‍याआ फुलोअहें पाला, तें केहें कोइत वोदतेहे? तें काम नाहां कोअते, नेत तियांआं काजे आंगड़े नाहां बोणावते. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />पोन आंय तुमुहूं कोहो के, शलमोन राजा बी तियाआ आखी महिमा वाअहीं तिंया आखाम रोत एका फुलोअ होस बी हाजे आंगड़े नाहां पेवये. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />जो रानोमेर्‍योअ खोड़ आज होय आन हांदाआ आगीम जातो रोहे, तियाहा जर देव एहेलुहू पेरवट पेवाड़ेहे, ताहां ओ लुला विश्वासी, तो तियां रोत वादार तुमुहूं पेरवट ने पेवाड़े के?<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />“तिहीं वाअहीं तुमू सिंता कोइत एहें मा कोहा के आपू कि खाहूं, नेत कि पीहूं, नेत कि पेवहूं. <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />काहाके ए आखी गोठी मेलवीलोअ काजे दुन्याआ माअहें तोड़पीइतेहें. तुमुहूं यीं आखी गोठीइ गरज होय ओं तुमाआं होरगामेर्‍याआ आब्हाहा मुंदू होय. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />तियाहा काजे पेल तुमू देवोअ राज आन सतीपण होदीइलोअ कोशित कोआ, ताहां तियाअरी ए आखी गोठी बी तुमुहूं जोड़ीत जाय. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />तियाहा काजे हांदार्‍यीइ सिंता मा कोअहा, काहाके हांदार्‍यीइ सिंता हांदाआ; आज्‍याआ दिहोअ दुख आज्याआ दिहोअ कोअते पुरतो होय.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">बिहीरा पोअ आरोप लागाड़ीइलो बाप्तिम</para>
  <para style="r">(<ref loc="LUK 6:37">लुक 6:37</ref>,<ref loc="LUK 6:38">38</ref>,<ref loc="LUK 6:41">41</ref>,<ref loc="LUK 6:42">42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“कोडापोअ आरोप मा लागाड़हा, ताहां तुमापोअ बी आरोप ने लागे. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />काहाके जेहें कोइत तुमू बिहीरा पोअ आरोप लागाड़हा, तेहेंज कोइत तुमापोअ बी आरोप लागे, आन जिया मापोवाअहीं तुमू मापित आपहा, तियाज मापोवाअहीं तुमुहूं बी पोइत जोड़े. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />तु ताआ डोआ मेर्‍याआ मुहलोअहें पालीइलोअ सोड़ी देत ताआ पायहोअ डोआ मेर्‍याआ हुकलाअहें काहा पालेहे? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />नेताहां, ‘ताआ डोआ मेर्‍योअ हुकलो माहूं काडी देअहूं दे,’ एहें कोइत तू ताआ पायहोहो केहें कोइत कोत सेकेहे? पाल, ताआज डोआ मेहें तोम मुहल होये. <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />आरे ढोंगी, पेल ताआ डोआ मेर्‍योअ मुहल काडीत टाकेए, ताहां ताआ पायहोअ डोआ मेर्‍योअ हुकलो काडीइलोअ काजे ताहूं वारुहूं हाजो देखाय.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />“सोकी वस्तु हुंणाहां मा आपहा, आन तुमाआं मोती भुंडड़ाआं आगाड़ी मा टाकहा; जर टाकहा, ताहां केहेंनेत तें तियांआं गुडाअ थुड़ी सेंदीत टाकी देय, आन फिरीत तुमुहूंज वेतरीत टाके.<verse eid="MAT 7:6" /></para>
  <para style="s">मागहा ताहां जोड़े</para>
  <para style="r">(<ref loc="LUK 11:9-13">लुक 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“मागा, ताहां तुमुहूं जोड़े; होदा, ताहां तुमुहूं सापड़े, ठोका, ताहां तुमाआं काजे बाअणो उगड़ीत जाय. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />काहाके जो कोडो मागेहे तियाहा जोड़ेहे, जो कोडो होदेहे तियाहा सापडेहे, आन जो कोडो ठोकेहे तियाआ काजे उगड़ीत जाहे. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />तुमामेहें एहेलोहो कोड्लो माहुंउं होय, जों तियाआ पोर्‍यू रोटू मागे, ताहां तियाहा डोण आपे? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />नेताहां मासू मागे तियाआ वोतीइ जनवार आपे? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />तुमू खाराब होय तेबी तुमाआं पोर्‍याहा हाजी वस्तु आपीइलोअ मुंदू होय, ते तुमाआं होरगामेर्‍याआ आब्हापोअ जें मागतेहे तियांहां तो हाजी वस्तु केहें ने आपे?<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />“तिहींइं काजे, जेहें कोइत माअहें तुमाअरी सालुहूं जोवे एहेलिही तुमाआं इश्शा होय, तेहेंज कोइत तुमू बी तियांअरी साला, काहाके कायदाअ पुस्तक आन भविश्यवक्ताहांआं पुस्तक बी ओंज सिकाड़ेहे.<verse eid="MAT 7:12" /></para>
  <para style="s">हाकड़ी वाट</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“हाकड़ी वाटे जावा, काहाके मोकली वाट हुदी होय आन ते नरकाअहें जाहे; आन तिहीं जानारे जाअखे जोएं होय. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />पोन जिवनोम जाअलोअ बाअणो हाकडो होये, आन तिहीं लेत जानारी वाट कठीण होये, आन थोड़ाज माअहुंहूं ते जोड़ेहे.<verse eid="MAT 7:14" /></para>
  <para style="s">जेहलोहो साड़ तेहलोहो फल</para>
  <para style="r">(<ref loc="LUK 6:43">लुक 6:43</ref>,<ref loc="LUK 6:44">44</ref>,<ref loc="LUK 6:46">46</ref>; <ref loc="LUK 13:25-27">13:25-27</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“ठोग भविश्यवक्ताहां रोत सांबालजा. ते मेडाआं वेहे लेत तुमाआं जागे आवताहा, पोन मांयते वेतरीइनारा कोलवाआं होस होये. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />तियांआं कामों वाअहीं तुमू तियांहां ओलखीत लेहा. काटाआ साड़ोप रोत दाराक्शे, नेताहां उपकाटाप रोत अंजिर<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="fq" closed="false">अंजिर </char><char style="ft" closed="false">अंजिर एकी जातीइ उंबराआ होसर्‍योअ फल होय.</char></note> पाडतेहे के? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />तेहेंज कोइत हाजा साड़ोहो हाजे फलवे लागतेहे आन खाराब साड़ोहो खाराब फलवे लागतेहे. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />हाजो साड़ खाराब फलवे ने आपनारो, आन खाराब साड़ हाजे फलवे ने आपनारो. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />जो साड़ हाजे फलवे नाहां आपतो, तिया साड़ोहो वाडीत आगीम टाकी देतेहे. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />तिहीं वाअहीं तियांआं कामों वाअहीं तुमू ठोग भविश्यवक्ताहां ओलखीत लेहा.<verse eid="MAT 7:20" /></para>
  <para style="s">आंय तुमुहूं केदिहींज नाहां ओलखीइतू</para>
  <para style="r">(<ref loc="LUK 13:25-27">लुक 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“जों माहूं ‘प्रभु, प्रभु’ एहें कोहे, तों हारेक माहुंउं होरगाआ राजोमेहें जायजे एहेलोहो कायनाहां, पोन जों कोडो माआं होरगामेर्‍याआ आब्हाआ मोर्जीइ पुरमाणे सालेहे तोज जाये. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />तो न्याय निवाड़ू कोइलोअ दिही आवे, तेदिहीं जाअखीलाहा जोंओं माहूं कोये, ‘प्रभु, प्रभु! आमू ताआ नावोवाअहीं संदेश आप्यू, ताआ नावोवाअहीं पुते काड्ये आन ताआ नावोवाअहीं जाअखीलाहा समत्कार नाहां कोअया के?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />ताहां आंय तियांहां कोहीं, ‘आंय तुमुहूं केदिहींज नाहां ओलखीइतू; ओ खाराब कामे कोअनारां, माआं जागे रोत सेटे जाते रोवा!’<verse eid="MAT 7:23" /></para>
  <para style="s">बेन कोअ बांदनारा</para>
  <para style="r">(<ref loc="LUK 6:47-49">लुक 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“तियाहा काजे, जो कोडो माआं ए हिकवोण उनाअहे आन मानित सालेहे, तो एका हुशार माहुंउं सारकोह होये, जिये तियाआ कोओ खड़कापोअ बांद्यो. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />आन वोऱ्हात पोड़्यु, खाडू वोहयू, वादुउ बी साल्यू, आन तिया कोओहो आवित ठोकाअयू, तेबी तों कोअ ने पोड़्यो, काहाके तियाआ पायू खड़कापोअ बांद्युतो.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />“पोन जो कोडो माआं ए हिकवोण उनाअहे आन नाहां मानित सालतो, तो एका फोगा माहुंउं सारकोह होये, तिये तियाआ कोअ रेटापोअ बांद्यो. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />आन वोऱ्हात पोड़्यु, खाडू आवयू, वादुउ बी आयू, आन तिया कोओहो आवित ठोकाअयू, ताहां तो कोअ पोड़ीत गोयो आन आखो नावासट आरवात गोयो!”<verse eid="MAT 7:27" /></para>
  <para style="s">ईसुउ आधिकार</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />जाहां ईसु ए गोठी कोत नेवराअयू, ताहां आखे माअहें तियाआ हिकवोणो वाअहीं बोगलात गोये. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />काहाके तो तियांहां कायदाआ मास्तरोंअ होस नाहां, पोन आधिकारो वाअहीं सिकाड़तुतो.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">ईसु एका वोडा दुखोवालाहा हुदारत्लू</para>
  <para style="r">(<ref loc="MRK 1:40-45">मार्क 1:40-45</ref>; <ref loc="LUK 5:12-16">लुक 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />जेहेलाम ईसु तिया डोगोपोअ रोत निसे उतर्‍यू, ताहां गोवारान गोवारा माअहें तियाआ फासाड़ी जाने वोल्ये. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />आन पाला, वोडा दुखोवालो माहुंउं तियाआ जागे आवयो, तियाहा पागे पोड़ीत कोनो वोल्यो के, “प्रभु, ताआ इश्शा ओय, ताहां तु माहूं सोकू कोइत सेकेहे.”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />ताहां ईसु तियाहा आथ लागाड़ीत कोइत कोयो, “माआं मोर्जी होय, तु सोकू ओत जा!” आन तों माहुंउं ताअहांज तिया वोडो दुखोम रोत हुदरीत गोयो. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />फाशोअ ईसु तियाहा कोयो, “पाल, ओं कोडाहाज मा कोही, पोन तु जात कोइत सोताहा पुंजाराहा देखाड़ आन आखाहा तु हुदरीइल्याआ पुरावू देखाअहूं जोवे काजे, जे गाराहा मोशे ठरव्यीही ते तू आपी देजी.”<verse eid="MAT 8:4" /></para>
  <para style="s">एका मुख्य सिपायड़ाआ विश्वास</para>
  <para style="r">(<ref loc="LUK 7:1-10">लुक 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />जेहेलाम ईसु कफर्णहुमोमेहें आयू, ताहां एक रोमी सिपायड़ाआ आधिकार्‍ये तियाआ जागे आवित कोइत तियाहा रावणी कोअयी, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“प्रभु, माआं पावर कोअमेहें लखवाअ बिमारी वाअहीं जाअखीलुहू मांदवाड़्यु होये.”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />ईसु तियाहा कोयो, “आंय आवित कोइत तियाहा हुदारीहीं.”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />सिपायड़ाआ आधिकार्‍ये कोयो, “प्रभु, तू माआं कोअ आवे एहेलिही मामेहें लायकी कायनाहां, पोन फक्त सोबीवाअहीं एतुज कोत देही, तेबी माआं पावर हुदरीत जाय. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />काहाके आंय बी वोडा आधिकार्‍योंअ निसे रोहो, आन माआं आथोअ निसे बी सिपायडां होये. जेहेलाम तियाहा आंय कोत्लू, ‘जा!’ ताहां तो जात्लू; आन बिहीराहा कोत्लू, ‘आव!’ ताहां तो आवत्लू; आन जेहेलाम माआं पावरोहो कोत्लू, ‘ओं कोअ’ ताहां तो कोअत्लू.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />ए गोठ उनाइत कोइत ईसु पोंगलात गोयू, आन जें माहें तियाआ फासाड़ी आवतेते तियांहां कोयो, “आंय तुमुहूं खोरीज कोहो, इस्राएलोमेहें बी एहेलुहू विश्वास माहूं नाहां देखुहूं जोड़्यू. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />फाशुउ आंय तुमुहूं कोहो के, दिही उगताआ वोगेहे आन दिही बुड्ताआ वोगेहे रोत जाअखीलेहे जोएं आवे, आन होरगाआ राजोमेहें अब्राहाम, इसाहाक, आन याकोबोअ पांगातीम बोहे. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />पोन राज्याआ पोर्‍ये बाअथे आंदारामेहें टाकी देवाय, जिहीं रोड़ीइलो आन दात कोकरावीइलोअ रोय.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />ताहां ईसु तिया सिपायड़ाआं आधिकाऱ्योहो कोयो, “कोअ जा, जेहलुहू ताआ विश्वास होय, तेहलोज ताआ काजे ओत जाये.” आन तियाआ पावर तेतीज वेले हुदरीत गोयू.<verse eid="MAT 8:13" /></para>
  <para style="s">ईसु वारुज मांदवाड़्याहां हुदारत्लू</para>
  <para style="r">(<ref loc="MRK 1:29-34">मार्क 1:29-34</ref>; <ref loc="LUK 4:38-41">लुक 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />ईसु पेत्राआ कोअ गोयू, आन तिहीं तिये पेत्राआ हावेह्हेहे आथरुपोअ जोराअरी लोटीत रोल्यी देख्यी. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />ताहां तिये तियीइ आथोहो आथ लागाड़्यु, आन तियीइ जोरु उतरीत गोयू, आन ते उठीत तियाआ सेवा कोइ वोल्यी.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />हांजेए वेले जाहां माअहें पुते लागला माअहोंहों ईसुउ जागे लेतावये, ताहां तिये पुतोहों तियाआ शब्दा वाअहींज काडीत टाक्ये, आन जें मांदवाड़्ये ओते तियांहां हुदार्‍ये. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />ओं तिये याआ काजे कोअयो के, जो यशया भविश्यवक्ते कोयोतो तो पुरो ओवुहूं जोवे, “तिये आपाआ कमजोरी सोतापोअ लेदी आन आपाआ बिमारी वोहीत लेदी.”<note caller="+" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">यश 53:4</ref>; <ref loc="1PE 2:24">1 पेत्र 2:24</ref> </char></note><verse eid="MAT 8:17" /></para>
  <para style="s">ईसुउ सेला बोणिइलोअ किम्मत</para>
  <para style="r">(<ref loc="LUK 9:57-62">लुक 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />माअहोंअ एक वोडी गर्दी पालीत ईसु तियाआ सेलाहां दोर्‍याआ तियी मेरे जाअलोअ आदेश आप्यू. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />ताहां एके कायदाआ मास्तरे तियाआ जागे आवित कोइत कोयो, “मास्तर, तू जिहीं जाही तिहीं आंय ताआ फासाड़ी आवुहूं तियार होय.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />ईसु तियाहा कोयो, “कोल्याआं काजे दोरसे, आन जुगोमेऱ्याआ सिड़ाआं काजे पांजरा रोताहा, पोन माहुंउं बेटाह्हाअ काजे मुंड मेकीइलोअ बी जागू कायनाहां.”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />फाशुउ एक जोऊं, जो सेलू बी ओतू, तिये कोयो, “प्रभु, पेल माहूं माआं आब्हाहा डाटीत आवुहूं दे ताअहूं.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />ईसु तियाहा कोयो, “तू माआं फासाड़ी आव, आन जें मोअल्ये होय तियांहां तियांआं मोल्या माअहुंहूं डाटुहूं दे.”<verse eid="MAT 8:22" /></para>
  <para style="s">ईसु वादुहू ठावकू कोअहे</para>
  <para style="r">(<ref loc="MRK 4:35-41">मार्क 4:35-41</ref>; <ref loc="LUK 8:22-25">लुक 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />जाहां ईसु नावड़ामेहें सोढ़्यू, ताहां तियाआ सेला बी तियाअरी गोया. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />ताहां पाला, दोर्‍यामेहें एतुहू वोडु वादुउ आवयू के तो नावड़ो उपाड़ा वाअहीं टापाओ वोल्यो, पोन ईसु हुवतूतो. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />ताहां सेला तियाआ जागे आवित तियाहा उठाड़्यु आन कोयो, “प्रभु आमुहूं वासाड़, आमू बुडुहूं कोअताहा.”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />ईसु तियांहां कोयो, “तुमू काहा बिताहा? तुमाआं विश्वास केतुहू कमी होय!” ताहां तिये उठीत वादुहू आन पाअयोंहों बावराअयू आन उपाड़ा बोंद ओत गोया, आन आखो ठावकोज ओत गोयो.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />ताहां तें माहें जुदे बोगलाअये आन कोने वोल्ये, “ओं कोड्ली जातीइ माहुंउं होये, के वादुउ आन दोर्‍या बी याआ आदेश मानतेहे.”<verse eid="MAT 8:27" /></para>
  <para style="s">ईसु पुते लागला बेन माअहोंहों हुदारत्लू</para>
  <para style="r">(<ref loc="MRK 5:1-20">मार्क 5:1-20</ref>; <ref loc="LUK 8:26-39">लुक 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />जाहां ईसु तियी तोड़े गदरेकर देसोमेहें पोतू, ताहां बेन माअहें जियांमेहें पुते ओते, तें माहणोमेहें रोत निहींत आवत्लेज तियाहा मिल्ये. तें जुदे जोराखे उठतेते, तिहीं वाअहीं कोडोज तियी वाटे जाआं ने सरकीत सेकतोतो. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />तियां आअड़ीत कोयो के, “ए देवोअ बेटाह्हा, आमाआं ताअरी कि काम? केहें तू वेलेए पेल आमुहूं दुख देनू इंहीं आयुहू?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />तियांआं जागे रोत थोड़ीक सेटे एक वोडू भुंडड़ाआ गोवारु सोरतुतो. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />ताहां तियां पुतों ईसुहू रावणी कोइत कोयो, “जर तू आमुहूं काडतुये, ताहां फोला भुंडड़ाआ टोलामेहें आमुहूं मोकली दे.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />ईसु तियांहां कोयो, “जावा!” ताहां तें निहींये आन भुंडड़ाआ टोलामेहें जात फोहीत गोये. आन आखा भुंडड़ाआ गोवारु तुदडू मिकीत टेकोपोअ रोत दोर्‍यामेहें जात पोड़्यू आन बुडीत मोयु.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />भुंडड़ाआ सारवाली होयरोमेहें गुगदा वोल्या आन तियां तिया पुते लागला माहुंउंरी जो किबी ओवो तो आखो जात कोइत परसार कोइ देदो. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />ताहां होयरोमेर्‍येए आखे माअहें ईसुहू मिले आये; आन जाहां तियां तियाहा देख्यू, ताहां तियां ईसुहू रावणी कोइत तियांआं मुलखो मेहें रोत निहींत जाय तेहें कोयो.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">ईसु एक लखवावाला माहुंहूं हुदारत्लु</para>
  <para style="r">(<ref loc="MRK 2:1-12">मार्क 2:1-12</ref>; <ref loc="LUK 5:17-26">लुक 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />फाश्यू ईसु नावड़ामेहें बोहीत तियी तोड़े तियाआ गावोमेहें गोयू, <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />आन पाला, थोड़ेक माअहें लखवा लागला एका माहुंहूं खाट्लापोअ लोटाड़ीत तियाआ जागे लेतावये. ताहां ईसु तियांआं विश्वास पालित लखवा लागला माहुंहूं कोयो, “बेटा, धिर खेट; ताआ पापोअ माफी ओत गोयी.”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />ताहां कायदाआ थोड़ाक मास्तरहों तियां तियांआंज कोना वोल्या, “ओ देवोअ निंदा कोअहे.”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />ईसु तियांआं विसार जांइत कोयो, “तुमू तुमाआं मोनोमेहें खाराब विसार काहा कोअताहा?” <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />“काहाके ‘ताआ पापोअ माफी ओवयीही’ एहें कोअलोअ नेत ‘उठीत कोइत साल’ एहें कोअलोअ, यामेहें रोत कोड्लो सोपो होये? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />पोन एताआ काजे के, तुमुहूं मुंदू जाअहूं जोवे के, माहुंउं बेटाह्हाहा धरती पोअ पापोंअ माफी कोइलोअ आधिकार होय,” ताहां तिये तिया लखवाअ मांदवाड़्या माट्योहो कोयो, “उठ, ताआ खाट्लो उसल, आन ताआ कोअ जातु रो.”<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />ताहां तो उठीत कोइत तियाआ कोओ जातु रोयू. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />जाहां तों तियां माअहूं देख्यो, तें बित गोये, आन देवे माअहुंहूं एहेलुहू आधिकार आप्यू, तिहीं वाअहीं तियां देवोअ वोडाय कोअयी.<verse eid="MAT 9:8" /></para>
  <para style="s">मत्तयोअ निवड़</para>
  <para style="r">(<ref loc="MRK 2:13-17">मार्क 2:13-17</ref>; <ref loc="LUK 5:27-32">लुक 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />फाश्यू ईसु तिहीं रोत आगाड़ी जात, मत्तय नावोअ एका माट्योहो नाकापोअ बोहीत रोल्यू देख्यू, तिये तियाहा कोयो, “माआं फासाड़ी आव.”</para>
  <para style="p" vid="MAT 9:9">ताहां तो उठीत तियाआ फासाड़ी गोयू.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />जाहां ईसु मत्तयोअ कोअमेहें रोटू खातुतो, ताहां जाअखीलाहा नाकेदार आन पापी आवित ईसु आन तियाआ सेलांअरी खाना बोठा. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />ओं पालीत थोड़ाक फरिसी तियाआ सेलाहां कोयो, “तुमाआं गुरु यां नाकेदार आन पाप्योंअरी काहा खाहे?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />ओं उनाइत ईसु तियांहां कोयो, “नेरा माअहोंहों डाक्‍टरोअ गरज नाहां रोती, पोन बिमारी माअहोंअ काजे गरज होये. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />‘माहूं गाराहा नाहां, पोन दया जोवे.’ जावा याआ अर्थ कि होय तो सिकाइत ल्या, काहाके आंय धर्मी माहुंहूं नाहां, पोन पापी माहुंहूं हादू आयुहू.”<verse eid="MAT 9:13" /></para>
  <para style="s">उपासोअ प्रश्न</para>
  <para style="r">(<ref loc="MRK 2:18-22">मार्क 2:18-22</ref>; <ref loc="LUK 5:33-39">लुक 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />ताहां बाप्तिस्मा आपनारा योहानोअ सेला ईसुहू आवित कोयो, “आमू आन फरिसी खुब वारी उपास कोअताहा, पोन ताआ सेला उपास नाहां कोअता, एहेलोह काहा?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />ईसु तियांहां कोयो, “जानेएरी वर होय, ताअहूं जाआं जान दुखी रोय के? नाहां! पोन एहेलुहू दिही आवे के, तियांआं जागे रोत वर निहींत जाय, ताहां ते उपास कोए.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“कोडो बी नोवा कापड़ोअ थिगलूउ जुना आंगड़ाहा नाहां लागाड़तो, काहाके तिया थिगला वाअहीं तो आंगड़ो खेसाइत जाहे आन जाअखो फाटीत जाहे. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />तेहेंज कोइत कोडो बी नोवू दाराक्शाआ रोह जुना सांबड़ाआ खोत्लामेहें नाहां मेकतो, मिके ताहां तो सांबड़ाआ खोत्लू फाटीत जाय आन दाराक्शाआ रोह बी वोहीत जाये, आन सांबड़ाआ खोत्लू बी आरवात जाये. तियाहा काजे नोवू दाराक्शाआ रोह नोवा सांबड़ाआ खोत्लामेहें मेकतेहे ताहां बेनू टिकीत रोतेहे.”<verse eid="MAT 9:17" /></para>
  <para style="s">रोमी आधिकार्‍योअ पोर्‍यी आन ईसुउ आंगड़ाहा आथिलनारी एक मांदवाड़्यी बाय</para>
  <para style="r">(<ref loc="MRK 5:21-43">मार्क 5:21-43</ref>; <ref loc="LUK 8:40-56">लुक 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />जेहेलामेहें ईसु ए गोठी कोअतुतो ताहां, एक यहुदी आधिकारी तियाआ जागे आवयू, आन पागे पोड़ीत कोनु वोल्यू, “माआं पोर्‍यी ओंमेज मोयीही, पोने आवेए ना ताआ आथ तियी पोअ मेकेए, ताहां ते जिवती ओत जाये.”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />ताहां ईसु उठीत तियाआ सेलांअरी तियाआ फासाड़ी जानु वोल्यू.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />ताहां पाला एक बाय जियीही बारा वोरह्ये रक्त वोहीइलाआ बिमारी ओती, तियी ईसुउ आंगड़ाआ कोरेहे आथ लागाड़्यु. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />काहाके ते तियीइ मोनोमेहें कोतीते के, “जर आंय तियाआ आंगड़ाहा आथ एतीज लागाड़ीहीं, तेबी हुदरीत जाहीं.”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />ईसु फासाड़ी वोलीत पाल्यो आन कोयो, “पोर्‍यी धिर तोअ, ताआ विश्वासे ताहूं हुदार्‍यीही.” तियीज घेड़ी ते बाय हाजी ओत गोयी.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />जाहां ईसु तिया आधिकार्‍योअ कोओ पोतू, आन वाजे वाजाड़नाराहां आन माअहोंअ गर्दीही देख्यी. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />ताहरोअ तिये कोयो, “आखे सेटे होरका, पोऱ्यी नाहां मोयी; पोन ते हुवेहे.” ताहां तें आखे तियाहा ओंहें वोल्ये. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />पोन जाहां गर्दीही सेटे कोअयी, ताहां तिये मांयते जात कोइत तियी पोर्‍यीइ आथ तोअयु, आन ते पोऱ्यी उठीत उबी रोयी. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />ए बातमी तिया आखा देसोमेहें पसरीत गोयी.<verse eid="MAT 9:26" /></para>
  <para style="s">ईसु बेन आंदलाहां हुदारत्लू</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />जाहां ईसु तिहीं रोत आगाड़ी निठू, ताहां बेन आंदला तियाआ फासाड़ी हाद कोअताज गोया, “ए दाविदोअ पोर्‍या, आमापोअ दया कोअ!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />जाहां ईसु कोअमेहें पोतू ताहां ते आंदला तियाआ जागे आवया, आन ईसु तियांहां कोयो, “केहें आंय तुमुहूं हुदारी देहीं एहेलुहू तुमाआं विश्वास होय के?”</para>
  <para style="p" vid="MAT 9:28">तियां ईसुहू कोयो, “होव, प्रभु!”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />ताहां तिये तियांआं डोआहां सापलीत कोयो, “जेहलुहू तुमाआं विश्वास, तेहलोज तुमाआं काजे ओवे!” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />आन तियांआं डोआ फाश्याआ हुदरीत गोया. ईसु तियांहां कड़क बाशामेहें कोयो, “ए गोठ कोडाहाज मा कोहा!”<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />पोन तियां जात कोइत ईसुउ ते बातमी आखा देसोमेहें परसार कोइ देदी.<verse eid="MAT 9:31" /></para>
  <para style="s">ईसु एका मुकाहा हुदारत्लू</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />जाहां ते बाअथे जाताते, तेहेलाम थोड़ेक माअहें एका पुत लागला मुकाहा ईसुउ जागे लेतावये. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />आन जाहां तिया पुतोहो काडी देदू, ताहां मुको गोगो वोल्यो, आन आखे माहें बोगलाइत गोये, आन कोने वोल्ये के, “आमू एहलोहो इस्राएलोमेहें कोयोंज नाहां देख्यो.”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:34 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:25">मत्तय 10:25</ref>; <ref loc="MAT 12:24">12:24</ref></char>
    </note>पोन जे फरिसी ओता तियां कोयो के, “ओते पुतोअ आधिकारीइ आधारो वाअहीं पुते काडेहे.”<verse eid="MAT 9:34" /></para>
  <para style="s">माअहोंअ काजे ईसुउ किइमाय</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:35 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:2">मत्तय 4:2</ref>; <ref loc="MRK 1:39">मार्क 1:39</ref>; <ref loc="LUK 4:44">लुक 4:44</ref></char>
    </note> ईसु आखा होयरोमेहें आन गांवोंमेहें फिरतू रोयू आन तिये आराधनालयोमेहें शिक्शण आप्यो, आन राज्याआ हाजी बातमीइ परसार कोअतू फिऱ्यू, आन आखी जातीइ बिमारी आन मांदवाड़्या माअहोंहों हुदार्‍ये. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />ताहां तिया माअहोंओं गोवाराहा पालीत किइमाय आयी, काहाके तें तियां मेडाआं होस ओते, जियांआं सारवाली कायने, फिकरेमेहें आन टाकाअले एहेलेहे ओते. <note caller="+" style="x"><char style="xo" closed="false">9:36</char><char style="xt" closed="false"><ref loc="NUM 27:17">गणती 27:17</ref>; <ref loc="1KI 22:17">1 राजां 22:17</ref>; <ref loc="2CH 18:16">2 इति 18:16</ref>; <ref loc="EZK 34:5">यहे 34:5</ref>; <ref loc="MRK 6:34">मार्क 6:34</ref> </char></note> <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />ताहां तिये तियाआ सेलाहां कोयो, “खेतोमेहें वाडीइलोअ जाअखो होये, पोन मोजर्‍ये थोड़े होये<note caller="+" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="LUK 10:2">लुक 10:2</ref> </char></note>. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />तियाहा काजे खेतोअ मालख्योहो प्रार्थना कोआ के, तो तियाआ खेतोमेहें वाडीइलोअ काजे मोजर्‍ये मोकली देये.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">बारा सेला</para>
  <para style="r">(<ref loc="MRK 3:13-19">मार्क 3:13-19</ref>; <ref loc="LUK 6:12-16">लुक 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />ताहां ईसु तियाआ बारा सेलाहां आहने हाद्या, आन तियांहां खाराब आत्मा काडीइलोअ आन आखी जातीइ बिमारी आन कमजोरी हुदारीलोअ आधिकार आप्यू. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />तियां बारा सेलाआं नावे एं होय: पेहलु, पेत्र कोतेहे तो शिमोन, आन तियाआ पाही आंद्रिया; जब्दीइ पोर्‍यू याकोब आन तियाआ पाही योहान, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />फिलीप, बार्थलमय, थोमा आन नाकापोअ फालू लेनारु मत्तय, आल्फेयोअ पोर्‍यू याकोब आन तद्दय. <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />शिमोन कनानी, आन ईसुहू तोइत आपनारु यहुदा इस्कार्योत.<verse eid="MAT 10:4" /></para>
  <para style="s">बारा सेलाआं सेवा</para>
  <para style="r">(<ref loc="MRK 6:3">मार्क 6:3</ref>; <ref loc="LUK 9:1-6">लुक 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />यां बारा सेलाहां ईसु ओ आदेश आपीत मोकल्‍या: “बिगर यहुदीइ जागे मा जाहा, आन शोमरोनोअ कोड्लाज होयरोमेहें मा जाहा. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />पोन इस्राएलोअ टाकाअला मेडाआं जागे जाजा. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />आन जाता जाता ओं परसार कोअताज जाजा के, ‘होरगाआ राज आहने आयोहो!’<note caller="+" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">लुक 10:4-12</ref> </char></note> <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />मांदवाड़्याहां हुदारा, मोल्याहां जिवाड़ा, वोडा दुखोवालाहां सोके कोआ, पुते काडा. तुमुहूं फुकोट जोड़्योहो, फुकोट आपा. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />तुमाआं सेवड़े होनो, सांदी नेत तांबाअ आनो मा लेहा; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" /><note caller="+" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 करिन्थ 9:14</ref>; <ref loc="1TI 5:18">1 तिम 5:18</ref></char></note>वाटेए काजे सोलाल खोत्लू, नेत उगार आंगड़ो, खाहड़े नेते डेंगार मा लेहा. काहाके मोजर्‍याहां तियांआं मोजरी जोड़ुहूं जोवे.”<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />“जिया कोड्ला बी होयरोमेहें नेत गांवोंमेहें जाहा, ताहां मुंदू पाड़ीत ल्या, के तिहीं कोडो हाजो कोआड़े, आन जाहां तिहीं रोत निहींत जाहा ताअहूं जाआं तियाअहींज रोवा. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />कोअमेहें फोहती वेले आशिर्वाद आपा.<note caller="+" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="1SA 25:6">1 शमु 25:6</ref></char></note> <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />जर तिया कोअमेर्‍येए माअहें हाजे ओये, ताहां तुमाआं आशिर्वाद तियांहां जोड़े; पोन जर तें हाजे ने ओय, ताहां तुमाआं आशिर्वाद तुमाआं जागेहे वोलीत आवे. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" /><note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">प्रेशित 13:51</ref></char></note> आन जर एखो तुमाआं स्विकार ने कोए, नेताहां तुमाआं गोठी ने उनाये, ताहां तियाआ कोअमेहें रोते नेत होयरोम रोत बारथे निहींइली वेले तुमाआं गुडाअ थुड़ीइ तुलो बी फोकड़ीत टाकी द्या. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" /><note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">मत्तय 11:24</ref>; <ref loc="GEN 19:24-28">उत्प 19:24-28</ref> </char></note> आंय तुमुहूं नक्की कोहो, के न्याय निवाड़ाआ दिही तिया होयरो रोत देव सदोम आन गोमोराहा जाअखी दया देखाड़े!<verse eid="MAT 10:15" /></para>
  <para style="s">आवनारो संकट</para>
  <para style="r">(<ref loc="MRK 13:9-13">मार्क 13:9-13</ref>; <ref loc="LUK 21:12-17">लुक 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“उनाआ! आंय तुमुहूं कोलवाआं विसमेहें मेडाहां मोकलीइलाआ होस मोकलोहो; तियाहा काजे तुमू हापोअ होस हुशार आन पेरवाअ होस भोले बोणा<note caller="+" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 11:24">मत्तय 11:24</ref>; <ref loc="GEN 19:24-28">उत्प 19:24-28</ref> </char></note>. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />पोन एहेला माहूं रोत जाबालीत रोवा, जें तुमुहूं पोन्साहा तोइत आपी देय, आन तें तियांआं आराधनालयोमेहें सापका वाअहीं देये.<note caller="+" style="x"><char style="xo" closed="false">10:17</char><char style="xt" closed="false"><ref loc="MRK 13:9-11">मार्क 13:9-11</ref>; <ref loc="LUK 12:11-12">लुक 12:11-12</ref>; <ref loc="LUK 21:12-15">21:12-15</ref> </char></note> <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />माआं वाखरी तुमुहूं आधिकाऱ्योओं आन राजहांआं सामने साक्शी देअलो काजे लेत जाय, आन तुमू माआं बातमी बिगर यहुदी माअहुंहूं कोत देखाड़हा. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />जाहां तें तुमुहूं ओटक कोए, ताहां तुमू ए फिकर मा कोअहा के, आमू की गोगहूं नेते केहें कोइत कोहूं, काहाके जो किबी तुमुहूं कोअलोअ रोय, तो तियीज वेले तुमुहूं कोत देवाय. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />काहाके गोगनारा तुमू नाहां, पोन तुमाआं आब्हाआ आत्मा तुमामेहें रोहे तो गोगे.”<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />“पाही पायहोहो आन आब्हू पोर्‍याहा माईंलोअ काजे तोइत आपे, आन पोर्‍यें आयहीन आब्हाआ विरुद्दामेहें उठे आन तियांहां माआड़ी देये<note caller="+" style="x"><char style="xo" closed="false">10:21 </char><char style="xt" closed="false"><ref loc="MRK 13:12">मार्क 13:12</ref>; <ref loc="LUK 21:16">लुक 21:16</ref></char></note>. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />हारेक जोओं माआं नावोअ वाखरी तुमाआं विरोध कोए. पोन जो कोडो आखरी जाआं टिकीत रोय तोज वासाय.<note caller="+" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">मत्तय 24:9</ref>; <ref loc="MRK 13:13">मार्क 13:13</ref>; <ref loc="LUK 21:17">लुक 21:17</ref></char></note> <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />जाहां तें तुमुहूं एका गांवोंमेहें तारास देय, ताहां बिहीरा गांवोंमेहें गुगदे वोलजा. आंय तुमुहूं नक्की कोहो के, माहुंउं बेटुह्हू आवे ताअहूं जाआं इस्राएलोमेहें आखा होयरों फिरीइलाआ तुमाआं ने सेलाय.<verse eid="MAT 10:23" /></para>
  <para style="s">सेलू बोणिइलोअ अर्थ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />“सेलू तियाआ गुरु रोत वोडू नाहां; आन पावर तियाआ मालख्योप रोत वोडू नाहां रोतू.<note caller="+" style="x"><char style="xo" closed="false">10:24 </char><char style="xt" closed="false"><ref loc="LUK 6:40">लुक 6:40</ref>; <ref loc="JHN 13:16">योहान 13:16</ref>; <ref loc="JHN 15:20">15:20</ref></char></note> <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />सेलू तियाआ गुराआ एतुहू, आन पावर तियाआ मालख्योअ एतुहू बोणे तेतोज बास होये. जर तियां कोअ धण्योहोंज बालजाबुल कोयो ताहां तियाआ कोर्‍यांहां केतेहे वादार कांय कांय कोये!”<note caller="+" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">मत्तय 9:34</ref>; <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">मार्क 3:22</ref>; <ref loc="LUK 11:15">लुक 11:15</ref> </char></note><verse eid="MAT 10:25" /></para>
  <para style="s">कोडाहा बिइलो</para>
  <para style="r">(<ref loc="LUK 12:2-7">लुक 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“तियाहा कोत माअहोंहों मा बिहा; काहाके एहलोहो किज टापाअलो कायनाहां जो ने उगड़े, आन एहलोहो किज निकाअलो कायनाहां जो ने जाआंय, आन आखो खुल्लो होय.<note caller="+" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="MRK 4:22">मार्क 4:22</ref>; <ref loc="LUK 8:17">लुक 8:17</ref>; <ref loc="1CO 4:5">1 करिन्थ 4:5</ref></char></note> <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />जों आंय तुमुहूं आंदारामेहें कोहो, तों तुमू उजालामेहें कोवा; आन जों तुमू कानोमेहें उनाअयेहे तों कोओपोअ सोढ़ीत परसार कोआ. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />जें शरीरोहो माईंत सेकतेहे, पोन आत्माहां माईंत नाहां सेकते तियांहां मा बिहा; पोन जो आत्मा आन शरीर यां बेनुहूं नरकामेहें टाकीत सेकेहे तियाहा बिवा. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />केहें एका आनामेहें बेन गिनसिड़ी नाहां वेसाअती के? तेबी तुमाआं आब्हाआ इश्शा सिवाय तियांमेहें रोत एक बी पुंयी पोअ ने पोड़ीत सेके. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />तुमाआं मुन्काआ सिंग्ये बी आखे गणल्ये होये. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />तियाहा काजे मा बिहा; तुमू तियां सिड़ां रोत केतेहे वादार किमती होये!” <figure style="fig" alt="Flat-roofed, olden house in Israel" file="lb00234b.tif" size="col" copy="Horace Knowles ©" ref="10:27">इस्राएलोमेऱ्याआ कोओपोऱ्युउ भाग</figure><verse eid="MAT 10:31" /></para>
  <para style="s">ईसुहू स्विकारीलोअ नेत नाकारीलोअ</para>
  <para style="r">(<ref loc="LUK 12:8-9">लुक 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“जो कोडो माअहोंअ सामने माआं स्विकार कोए, तियाहा आंय बी माआं होरगाआ आब्हाआ सामने स्विकार कोअहीं. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" /><note caller="+" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="MRK 8:38">मार्क 8:38</ref>; <ref loc="LUK 9:26">लुक 9:26</ref>; <ref loc="2TI 2:12">2 तिम 2:12</ref> </char></note> पोन जर कोडो माअहोंअ सामने माहूं नाकारे, तियाहा आंय बी माआं होरगामेऱ्याआ आब्हाआ सामने नाकारीहीं.”<verse eid="MAT 10:33" /></para>
  <para style="s">होक नाहां पोन तारवाआ</para>
  <para style="r">(<ref loc="LUK 12:51-53">लुक 12:51-53</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“ओं मा समजाहा के, आंय धरती पोअ होक आपिइलोअ काजे आयुहू. नाहां, आंय होक आपू नाहां, पोन तारवाआ सालाड़ू आयुहू. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />आंय आंगे कोउ आयुहू, पोर्‍याहा तियाआ आब्हाआ विरुद्ध आन पोऱ्यीही तियीइ आयहीइ विरुद्ध, आन वोवड़ीह्हीही तियीइ हावेह्हेए विरुद्धामेहें फाटाफुट कोइलोअ काजे आयुहू.<note caller="+" style="x"><char style="xo" closed="false">10:35 </char><char style="xt" closed="false"><ref loc="MIC 7:6">मिखा 7:6</ref> </char></note> <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />आन तुमाआं कोर्‍येए माहेंज तुमाआं दुस्मोन बोणे.”<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />“जो कोडू तियाआ आयहीन आब्हापोअ मापरोत जाअखु मेर कोअहे, तो माआं लायकीइ सेलू नाहां; जो कोडू तियाआ पोऱ्यापोअ नेत पोऱ्यीपोअ मापरोत जाअखु मेर कोअहे, तो माआं लायकीइ सेलू नाहां. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />आन जो कोडू तियाआ क्रुस लेत माआं फाटी ने साले तो माआं लायकीइ सेलू नाहां.<note caller="+" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">मत्तय 16:24</ref>; <ref loc="MRK 8:34">मार्क 8:34</ref>; <ref loc="LUK 9:23">लुक 9:23</ref></char></note> <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />जो कोडो तियाआ जिव वासाड़े तो तियाहा जावाड़े; पोन जो कोडो माआं वाखरी तियाआ जिव जावाड़े: तो तियाहा मेलवे.<note caller="+" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">मत्तय 16:25</ref>; <ref loc="MRK 8:35">मार्क 8:35</ref>; <ref loc="LUK 9:24">लुक 9:24</ref>; <ref loc="LUK 17:33">17:33</ref>; <ref loc="JHN 12:25">योहान 12:25</ref> </char></note>”<verse eid="MAT 10:39" /></para>
  <para style="s">बक्शीस</para>
  <para style="r">(<ref loc="MRK 9:41">मार्क 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“जो कोडो तुमुहूं स्विकार कोअहे, तो माहूं स्विकार कोअहे; आन जो माहूं स्विकार कोअहे, तो माहूं मोकलीइनाराहा स्विकार कोअहे.<note caller="+" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="MRK 9:37">मार्क 9:37</ref>; <ref loc="LUK 9:48">लुक 9:48</ref>; <ref loc="LUK 10:16">10:16</ref>; <ref loc="JHN 13:20">योहान 13:20</ref></char></note> <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />जो कोडो बी भविश्यवक्ताहा<note caller="+" style="f"><char style="fr" closed="false">10:41 </char><char style="ft" closed="false">भविश्यवक्ताआ अर्थ होय देवोअ गोठ माहुंउं जागे पोताड़नारु खबऱ्यु</char></note> भविश्यवक्तू जाईंत स्विकार कोअहे, तो भविश्यवक्ताआ बक्शीस लेय, आन जो धर्मीहीं धर्मी जाईंत स्विकार कोअहे, तो धर्मीइ बक्शीस लेये. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />जो कोडो या हानामेहें रोत एकाहा बी माआं सेलू जाईंत निस्तु एकुज गिलास बी पाईं पिवाडे, तेबी आंय तुमुहूं नक्की कोहो के, तियाहा बक्शीस जोड़्या सिवाय ने रोय.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">बाप्तिस्मा आपनारा योहानोअ खबऱ्या</para>
  <para style="r">(<ref loc="LUK 7:18-35">लुक 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />जाहां ईसु तियाआ बारा सेलाहां ए गोठी कोत आपी देदी, ताहां तो तिया होयरोमेहें संदेश आन परसार कोइलोअ काजे तिहीं रोत जातू रोयू.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />जेहेलाम योहान जेलेमेहें ख्रिस्ताआ कामोंअ सर्सा उनाअयू, तेहेलाम तो तियाआ सेलाहां ईसुउ जागे ओं फुसे तेहें खबऱ्या मोकल्या, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />“आमुहूं को, जो आवनारु होय तो तूज होय के, आमू बिहीरा एखाआ वाट जोवो?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />ईसु उत्तर आप्यो, “जो किबी तुमू उनाअताहा आन देखताहा, तो आखो जात कोइत योहानोहो कोत द्या, <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />आंदले देखतेहें, पांगले सालतेहें, वोडा दुखोवाले हुदरीइतेहें, बोयरे उनाअतेहें, मोल्ये जिवते ओवतेहें, आन गरब्‍योहों हाजी बातमी उनाअहूं जोड़ेहे. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />हाजो होय तो, जो माआं बाप्तिमेहें सौंसू नाहां कोअतो!”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />जेहेलामेहें योहानोअ सेलां तिहीं रोत जाना वोल्या, तेहेलाम ईसु योहानोअ बाप्तिमेहें माअहुंहूं कोनु वोल्यू, “तुमू जंगलोमेहें कि पाला गोयाते? केहें वाराअरी आलनारा बुआंहां? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />ताहराअ तुमू कि पाला गोयाते? केहें मोगवाड़्ये आंगड़े पोवनारा माहुंहूं? पाला, जें माहें मोगवाड़्ये आंगड़े पोवतेहे, तें राजवाडामेहें रोतेहे. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />ताहराआ काहा गोल्या? केहें एखा भविश्यवक्ताहा पाला? होव, पोन आंय तुमुहूं कोहो के भविश्यवक्ता रोत बी वोडाहा. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />ओ तोज होय जियाअ बाप्तिमेहें लेख्योहो: ‘पाल, आंय माआं दुतोहो ताआ आगाड़ी मोकलोहो, जो ताआ आगाड़ी वाट तियार कोए.’<note caller="+" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">मला 3:1</ref></char></note> <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />आंय तुमुहूं नक्की कोहो, के जें बोईंप रोत उब्ज्येहे तियांम रोत कोडोज बाप्तिस्मा वाला योहानो रोत वोडो कायनाहां ओवो; पोन जो होरगाआ राजोमेहें हानाम रोत हानू होये, तो योहानो रोत वोडू होये. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />बाप्तिस्मा कोअनारा योहानोअ दिहोमेहें परसार ओवुहूं तोयोंअ रोत ओमें जाआं होरगा राजोमेहें माअहें जोर देत फोहतेहे, आन जोरावार तियाहा बुउसीत लेताहा. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />योहानोअ वाडोम जाआं आखा भविश्यवक्ता आन मोशेए कायदुनेहें राजोअ बाप्तिमेहें कोत देखाड़्यो; <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />आन ओ मानिइलोअ तुमाआं मोर्जी ओय ताहां माआं गोठ मानित ल्या, काहाके एलिया जो आवनारु होय, तो योहान होये. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />जियांआं कान ओय, तें उनाइत लेय.”<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“यी पिढ़ीइ माअहुंहूं आंय कोडाआ होस मानो? ते तियां पोर्‍याआ होस होय, जे बाजारोमेहें बोहीत एकान बिहीराहा आअड़ीत कोतेहे के, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />‘आमू तुमाआं काजे वेहेवालोमेहें पावी वाजाड़्यी, पोन तुमू ने नाशा; आमू मोयातीइ वाजे बांदाड़्ये, पोन तुमू ने रोड़्या.’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />काहाके योहान उपास तोअतुज आयू आन दाराक्शाआ रोहो ने पिदू, आन ते कोताहा के, ‘यामेहें पुत होये!’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />जाहां माहुंउं बेटुह्हू आयू, तिये खादो पिदो, आन हारेक जोएं कोयो, ‘या माट्योअहें पाला! ओड़ख्यू आन पिदाड़्, नाकेदारों आन पाप्योंअ दोस्ती!’ पोन देवोअ बुद्दी तियाआ ओवनारा कामों वाअहीं खोरी ठर्‍यीही.”<verse eid="MAT 11:19" /></para>
  <para style="s">बिगर विश्वासी गांव</para>
  <para style="r">(<ref loc="LUK 10:13-15">लुक 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />ताहां ईसु जिया होयरोमेहें जाअखीलाहां वोडा समत्कार कोअया, तियां होयरो मेर्‍येए माअहें पापोअहें रोत मोन नाहां वाल्यो, तिहीं वाअहीं तिये तियां होयरो पोअ आरोप लागाड़्यु. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“ओ खुराजीन! ताआ दशा केहेलिही ओवे! ए बेथसैदा! ताआ दशा केहेलिही ओवे! काहाके तुमामेहें जें वोडे कामें ओवेहे, तें सुर आन सिदोनोमेहें ओवते, ताहां तिहींइं माअहें तुरतुज पेंडीइ पोता फांगीत आन खाँओंमेहें बोहीत, तियांआं पापोअहें रोत काहार्‍येए मोन वालित लेते. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />पोन आंय तुमुहूं कोहो के न्याय निवाड़ाआ दिही देव तुमा रोत वादार दया सुर सिदोनोपोअ कोए. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />ए कफर्णहुम! केहें तु होरगे जाआं उसे सोढीही? तु ते नरकाअहीं जाआं निसे जाही! जें वोडे कामे तामेहें ओवेहे, तें जर सदोम सेरोमेहें ओवते, ताहां तों आज जाआं टिकीत रोतो. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />पोन आंय तुमुहूं कोहो, न्याय निवाड़ाआ दिही देव तापरोत जाअखी दया सदोम सेरोपोअ देखाड़े.”<verse eid="MAT 11:24" /></para>
  <para style="s">वोजावाईं थाकला माअहोंअ काजे आराम</para>
  <para style="r">(<ref loc="LUK 10:21-22">लुक 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />तियी वेले ईसु कोयो, “ओ बा, जुग आन धरतीइ मालिख, आंय ताआ धन्यवाद कोअहो, के तूमे यीं गोठीही बुद्दीमान आन सिकाअलां माअहों रोत निकाड़ीत मिक्यी, आन जें आड़ामी होय तियांहां प्रगट कोअयी.” <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />होव, ओ बा, काहाके ताहूं ओंज हाजो लागो.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />“माआं आब्हे माहूं आखो आप्योहो;<note caller="+" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="MAT 28:18">मत्तय 28:18</ref>; <ref loc="JHN 3:35">योहान 3:35</ref>; <ref loc="JHN 13:3">13:3</ref>; <ref loc="JHN 17:2">17:2</ref></char></note> आन कोडो आब्हा वासी बेटाह्हाहा ने ओलखीइत्लो, आन ने कोडो बेटाह्हा वासी आब्हाहा ओलखीइत्लो, पोन तो जियापोअ बेटुह्हू प्रगट कोअहूं होदे तोज.”<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“ए वोजावाअहीं थाकला आखा माअहूं, तुमू माआं जागे आवा; आंय तुमुहूं आराम आपीहीं.<note caller="+" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="EXO 33:14">निर्ग 33:14</ref>; <ref loc="JER 31:25">यिर्म 31:25</ref>; <ref loc="JHN 7:37">योहान 7:37</ref></char></note> <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />आंय मोनोमेहें गरीब आन हानालू होये;<note caller="+" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JHN 13:14">योहान 13:14</ref>; <ref loc="PHP 2:7">फिलि 2:7</ref>,<ref loc="PHP 2:8">8</ref></char></note> माआं जुहर तुमू आखलीत ल्या, आन मापोअ रोत सिकाआ,<note caller="+" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JHN 13:15">योहान 13:15</ref>; <ref loc="PHP 2:5">फिलि 2:5</ref>; <ref loc="1PE 2:21-23">1 पेत्र 2:21-23</ref>; <ref loc="1JN 2:6">1 योहान 2:6</ref></char></note> आन तुमुहूं मोनोमेहें आराम जोड़े. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />काहाके माआं जुहर ओलवो, आन माआं वोजू ओल्कू होये.”<note caller="+" style="f"><char style="fr" closed="false">11:30 </char><char style="ft" closed="false">1 योहान 5:3</char></note><verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">आरामोअ दिहोअ बाप्तिमेहें प्रश्न</para>
  <para style="r">(<ref loc="MRK 2:23-28">मार्क 2:23-28</ref>; <ref loc="LUK 6:1-5">लुक 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:1 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 23:25">कायदा 23:25</ref>
      </char>
    </note>ताहां ईसु आरामोअ <note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">आरामोअ दिही, सांतवू दिही</char></note> दिहोअ दिही खेतोमेहें रोत जातुतो, आन तियाआ सेलाहां फुक लागी, ताहां ते कोहें तोड़ी-तोड़ीइ खाना वोल्या. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />फरिसी ओं पालीत, ईसुहू कोयो, “पाल, ताआ सेला जो काम कायदाआ पुरमाणे आरामोअ दिहोअ दिही ने कोअहूं जोवे तो काम कोअताहा.”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:3 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 21:1-6">1 शमु 21:1-6</ref> </char>
    </note>ईसु उत्तर आप्यो, “दाविद आन तियाआ हाती फुकवाअला, ताहां तियां कि कोअल्यो तो तुमू नाहां वाश्यो के? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" /><note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">लेवी 24:9</ref> </char></note> तेबी तो देवोअ मंदिरोमेहें केहें कोइत गोयू, आन देवोहो भेट कोअल्या रोटा कायदाआ पुरमाणे तियाहा आन तियाआ हात्योहों खाअलोअ परवानगी ने ओती, फक्त पुंजाराहा खाअलोअ परवानगी ओती, ते तियां केहें कोइत खादा? <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" /><note caller="+" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">गणती 28:9-10</ref></char></note>ओं तुमू नाहां वाश्यो के? पुंजारा आरामोअ दिहोअ दिही मंदिरोमेहें आरामोअ कायदु तोड़ताहा, तेबी ते निर्दुस ठरताहा. <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />पोन आंय तुमुहूं कोहो के, इंहीं जो होय तो मंदिरो रोत बी वोडु होये. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" /><note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">मत्तय 9:13</ref>; <ref loc="HOS 6:6">होशे 6:6</ref></char></note> वसन कोहे, ‘के माहूं दया जोवे, जनवारोअ गाराहा नाहां.’ याआ अर्थ कि होय तो तुमू सोमजीइता, ताहां तुमू निर्दुस माहुंहूं दोशी ने ठरवीइता; <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />काहाके माहुंउं बेटुह्हू आरामोअ दिहोअ बी प्रभु होय.”<verse eid="MAT 12:8" /></para>
  <para style="s">उगाअला आथोअ माहुंउं</para>
  <para style="r">(<ref loc="MRK 3:16">मार्क 3:16</ref>; <ref loc="LUK 6:6-11">लुक 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />तिहीं रोत सालित कोइत ईसु यहुदीइ आराधनालयोमेहें आयू. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />तिहीं एक लखवा लागला आथोअ माहुंउं ओतो, फरिसी माअहें ईसु पोअ आरोप लागाड़ीइलोअ काजे तियाहा फुशो के, “आरामोअ दिहोअ दिही बिमारी हुदारीइलोअ ओं कायदाआ पुरमाणे ठीक होय के?”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:11 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 14:5">लुक 14:5</ref> </char>
    </note>ईसु तियांहां उत्तर आप्यो, “तुमामेहें एहलोहो कोडो होय, जियाआ एक्कुज मेडो ओये, आन तो आरामोअ दिहोअ दिही खाडामेहें पोड़ीत जाय, ताहां तो तियाहा तोइत ने काडे?<note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="LUK 14:5">लुक 14:5</ref></char></note> <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />पाला, माहुंउं किंमत मेडा रोत केतीही वादार होये! तियाहा काजे आरामोअ दिहोअ दिही कायदाआ पुरमाणे हाजो काम कोइलोअ बोराबर होय.”<note caller="+" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="MAT 6:26">मत्तय 6:26</ref>; <ref loc="MAT 10:31">10:31</ref></char></note> <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />ताहां तिये उगाअला आथोवाला माहुंहूं कोयो, “ताआ आथ नांबू कोअ.”</para>
  <para style="p" vid="MAT 12:13">ताहां तिये आथ नांबू कोअयू, आन तो आथ बिहीरा हाजा आथोअ होस हाजू ओत गोयू. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />ताहां फरिसी माट्यों बारथे जात कोइत ईसुहू केहें कोइत माईंलोअ ते योजना कोअयी.<verse eid="MAT 12:14" /></para>
  <para style="s">देवोअ निवड़ीइल्यु सेवक</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />ताहां ईसुहू ए गोठ मुंदू पोड़्यी. आन जाअखीलेहे माअहें तियाआ फासाड़ी गोये; आन तिये आखाहा बिमारीम रोत हुदार्‍ये,<note caller="+" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="MAT 4:23">मत्तय 4:23</ref></char></note> <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />आन तियांहां कड़क आदेश आप्यू के माआं बाप्तिम बिहीराहा मा कोहा. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />ओं याआ काजे ओवयो के, जो वसन यशया भविश्यवक्ते कोयो, तो पुरो ओवुहूं जोवे:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“पाला, ओ माआं सेवक होय, जियाहा मी निवड़्युहू,</para>
  <para style="q2" vid="MAT 12:18">माआं मेरालू होय, यावाअहीं माआं जिव खुस होय.</para>
  <para style="q1" vid="MAT 12:18">आंय माआं आत्मा तियापोअ मोकलिहीं,</para>
  <para style="q2" vid="MAT 12:18">आन तो बिगर यहुदीही न्यायोअ बातमीइं परसार कोए.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />तो भान्गड़ ने कोए, आन ने आअड़े,</para>
  <para style="q2" vid="MAT 12:19">आन बाजारोमेहें तियाआ आवाज ने कोडो उनाय.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />तो आडा पोड़ल्या बुआंहां ने मुड़े,</para>
  <para style="q2" vid="MAT 12:20">आन पेटात्ली बत्तिही तो ने उलवे,</para>
  <para style="q1" vid="MAT 12:20">जाअहूं जाआं तो न्यायोहो मजबुत ने कोए.<note caller="+" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">यश 42:1-4</ref></char></note><verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />आन आखे माअहें तियाआ नावोपोअ आशा मिके.”<note caller="+" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="ROM 15:12">रोम 15:12</ref></char></note><verse eid="MAT 12:21" /></para>
  <para style="s">ईसु आन बालजाबुल</para>
  <para style="r">(<ref loc="MRK 3:20-30">मार्क 3:20-30</ref>; <ref loc="LUK 11:14-23">लुक 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />ताहां माअहें एक आंद्ला-मुकाहा ईसुउ जागे लेतावये, जियामेहें पुत ओतू; ईसु तियाहा हुदार्‍यु, आन तो पालु वोल्यू आन गोगु वोल्यू. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />ए घटना देखीत आखे माअहें बोगलात गोये आन कोने वोल्ये, “केहें ओ दाविदोअ पोर्‍यू नाहां के?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />पोन फरिसी ओं उनाइत कोयो, “ओ पुतोअ आधिकारी बालजाबुलोअ<note caller="+" style="f"><char style="fr" closed="false">12:24 </char><char style="fq" closed="false">बालजाबुल </char><char style="ft" closed="false">बालजाबुल ओ पुतोंअ मुख्य आधिकारी होय.</char></note> आधारो वाअहींज पुते काडेहे.”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />ईसु तियांआं मोनोअ विसार जाइंत तियांहां कोयो, “जिया राजोमेहें टोला पोड़ताहा, तो उजड़ीत जाहे, आन एकदो होयर नेत कुटूंबो, जियामेहें टोला पोड़ताहा, तों ने टिकीत सेके. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />आन जर सैतानोहो सैतानुज काडे, ताहां तियांआं सोतामेहेंज टोला पोड़ीत गोया, ताहरोअ तियाआ राज कि कोइत टिकीत सेके? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />पोन जर आंय बालजाबुलोअ आधारो वाअहीं पुते काडोहो, ताहां तुमाआं पोर्‍ये कोडाआ सेक्ती वाअहीं पुते काडतेहे? तिहीं वाअहीं तेंज तुमाआं न्यायनिवाड़ु कोए. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />पोन जर आंय देवोअ आत्माआं मदतो वाअहीं पुते काडोहो, ताहां देवोअ राज तुमाआं जागे आवित लागोहो.”<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />“नेत ताकतवान माट्योहो पेल बांद्या सिवाय तियाआ कोअमेहें फोहीत तियाआ धन लुटता आवे के? तियाहा बांदे ताहांज तो तियाआ कोअ लुटीत सेकेहे.”<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:30 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:40">मार्क 9:40</ref> </char>
    </note> “जो माआं हाती कायनाहां तो माआं विरोदी होय, आन जो माअरी टोलू नाहां कोअतू तो वेरेहे. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />तियाहा काजे आंय तुमुहूं कोहो के माअहोंअ आखी जातीइ पाप आन निंदा माफ ओवे, पोन पवित्र आत्माआं निंदा माफ ने ओवे. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" /><note caller="+" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">लुक 12:10</ref> </char></note> जो कोडो माहुंउं बेटाह्हाआ विरोदो मेहें कोड्ली बी गोठ कोये, ते तियाआ गुनू माफ ओत जाय, पोन जों कोडो पवित्र आत्माआं विरुद्दामेहें गोगे, तियाआ गुनाआं माफी ने यी कोली ने तियी कोली ओवे.”<verse eid="MAT 12:32" /></para>
  <para style="s">साड़ आन तियाआ फल</para>
  <para style="r">(<ref loc="LUK 6:43-45">लुक 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:20">मत्तय 7:20</ref>; <ref loc="LUK 6:44">लुक 6:44</ref></char>
    </note> जर साड़ हाजो ओय, ते तियाआ फल बी हाजो रोय, जर साड़ ने हाजो ओय, ताहां तियाआ फल बी ने हाजो रोय, काहाके साड़ तियाआ फलो वाअहीं फारकात जाहे.<note caller="+" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="MAT 7:16-20">मत्तय 7:16-20</ref></char></note> <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" /><note caller="+" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्तय 3:7</ref>; <ref loc="MAT 23:33">23:33</ref>; <ref loc="MAT 15:18">15:18</ref>; <ref loc="LUK 3:7">लुक 3:7</ref>; <ref loc="LUK 6:45">6:45</ref></char></note> ए हापोअ पिलां, तुमू खाराब होय तेबी हाजी गोठी केहें गोगतेहे? काहाके जों मोनोम पोआलो होय, तोंज सोबीइ वाटे सोकतेहे. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />हाजो माअहुंउं तियाआ हाजा मोनोअ भांडारोम रोत हाजी गोठी काडेहे, आन खाराब माअहुंउं तियाआ खाराब मोनोअ भांडारोमेहें रोत खाराब गोठी काडेहे.<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />“आन आंय तुमुहूं कोहो के, जें जें शब्दे माहें गोगे, तियां हारेक फालतू शब्दाआ न्यायनिवाड़ु ओवे तेदिहीं तियांहां ईसाब आपुहूं पोड़े. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />काहाके तु ताआ गोठी वाअहीं निर्दुस आन ताआ गोठीज वाअहीं दोशी ठरही.”<verse eid="MAT 12:37" /></para>
  <para style="s">होरगामेऱ्याआ समत्कारोअ मागणी</para>
  <para style="r">(<ref loc="MRK 8:11-12">मार्क 8:11-12</ref>; <ref loc="LUK 11:29-32">लुक 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />ताहां थोड़ाक कायदाआ मास्तर आन थोड़ाक फरिसी तियाहा कोयो, “ए मास्तर, आमू तुमे कोअल्यू एक समत्कार पालुहूं कोअताहा.”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:4">मत्तय 16:4</ref>; <ref loc="MRK 8:12">मार्क 8:12</ref> </char>
    </note> तिये तियांहां उत्तर आप्यो, “यी कोलीइ खाराब आन सिनाल माअहें समत्कार होदतेहे, पोन योना नावोअ भविश्यवक्ताआ समत्कारो वासी बिहीरु कोड्लू समत्कार तियांहां ने जोड़े. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" /><note caller="+" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="JON 1:17">योना 1:17</ref></char></note> योनू तीन दिहीन तीन रात जाअखीला वोडा मासाआ पोटामेहें रोयू, तेहेंज कोइत माहुंउं बेटुह्हू बी, तीन रातेन दिही धरतीइ पोटामेहें रोये. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" /><note caller="+" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="JON 3:5">योना 3:5</ref> </char></note> निनवे होयरोअ माअहें न्यायनिवाड़ाआ दिही या जमानाअ माअहोंअरी उठीत तियांहां दोशी ठरवे, काहाके तियां योनाअ परसार उनाइत तियांआं पापोअहें रोत मोन फेरव्यो, आन फाशोअ पाला, इंहीं जो होय तो योना रोत बी वोडु होये. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" /><note caller="+" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 राजां 10:1-10</ref>; <ref loc="2CH 9:1-12">2 इति 9:1-12</ref> </char></note> देहोअ वोग्‍यीइ राणी न्यायनिवाड़ाआ दिही यी कोलीइ माअहोंअरी उठीत तियांहां दोशी ठरवे, काहाके ते शलमोन राजाआ हिकवोण उनाइलोअ काजे तियीइ देसोमेहें रोत आयी, आन पाला, इंहीं जो होय तो शलमोन राजा रोत बी वोडु होये.”<verse eid="MAT 12:42" /></para>
  <para style="s">खाराब आत्माआं वापिस आविइलोअ</para>
  <para style="r">(<ref loc="LUK 11:24-26">लुक 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“जाहां खाराब आत्मा माहूंमेहें रोत निहीत जाहे, ताहां आराम कोइला कोअते उगाअलू जागू होदती फिरेहे, पोन नाहां जोड़तू. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />ताहां कोहे के, ‘आंय माआं तिया कोअमेहें जिहीं रोत निहींयीही तिहींज वापिस वोलीत जाहीं,’ आन जाहां तियाहा तो हुंद्लो, बाअल्यो, होबाड़ल्यो देखाअहे. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />ताहां तो जात कोइत तिया रोत बी वादार हांत खाराब आत्मे तियाअरी लेत आवेहे, आन तें तियामेहें वाहा टाकीत रोने वोलतेहे, आन तिया माहुंउं दशा पेल्लीइ रोत बी वादार उत्यार ओत जाहे. या जमानाअ माअहोंअ दशा बी एहेलीज ओवे.”<verse eid="MAT 12:45" /></para>
  <para style="s">ईसुउ आयही आन पाही</para>
  <para style="r">(<ref loc="MRK 3:31-35">मार्क 3:31-35</ref>; <ref loc="LUK 8:19-21">लुक 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />जाहां ईसु माअहोंअरी गोग्याज कोअतुतो, तेहेलाम तियाआ आयही आन पाही बाअथे तियाअरी गोठी कोइलो काजे उबे रोयेते. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />ताहां कोडे तेबी तियाहा कोयो, “पाल, ताआ आयही आन पाही नेहें ताअरी गोठी कोइलोअ काजे बाअथे उबे रोयेहे.”<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />ओं उनाइत ईसु तिया कोनाराहा उत्तर आप्यो, “कोडो होय माआं आयही? आन कोडो होय माआं पाही?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />आन तियाआ सेलाअहें आथ देखाडीत कोयो, “पाला, माआं आयही आन पाही एं होये! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />काहाके जो कोडो माआं होरगाआ आब्हाआ मोर्जी पुरमाणे साले, तोज माआं पाही, आन माआं बोअह्हीं, आन माआं आयही होये.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">बियारु ओअनाराआ काईं</para>
  <para style="r">(<ref loc="MRK 4:1-9">मार्क 4:1-9</ref>; <ref loc="LUK 8:4-8">लुक 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />तेदिहींज ईसु कोअमेहें रोत निहींत दोर्‍याअ मेरे सिकाड़ीइलोअ काजे जात कोइत बोठू. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" /><note caller="+" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">लुक 5:1-3</ref> </char></note> आन तियाआ जागे एतीही वोडी गर्दी आवयी के तो नावड़ामेहें सोढ़ीत बोहीत गोयू, आन पुरी गर्दी मेरे उबी रोयी. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />आन तिये तियांहां काईं कोत आपीत जाअखीलिही गोठी कोत आप्‍यी,</para>
  <para style="p" vid="MAT 13:3">“एक ओअनारु बियारु ओउ निहींयू. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />ओइलोअ वेले थोड़ुक बियारु वाटेए मेरेपोअ पोड़्यु, आन सिड़े आवित खात गोये. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />थोड़ुक बियारु काकराट्यामेहें पोड़्यु, जिहीं तियाहा जाअखु कादुउ ने जोड़्यू आन उपरसोल्यू कादुव जोड़्यू, तिहीं वाअहीं तो वेगुज उगित गोयू. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />पोन दिही उगू तेहेलाम ते हुका मोइत गोया, आन मुले उंडे ने गोये, तिहीं वाअहीं उगात गोया. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />थोड़ुक बियारु काटाआ वोणसाम पोड़्यु, आन वोणसू वादीत गोयू, आन हुका सिवात गोया. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />पोन थोड़ुक बियारु हाजा कादवोमेहें पोड़्यु आन, थोड़क होव पोट, थोड़हो साट पोट, आन थोड़हो तिस पोट ओन पाको.”<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />ताहां ईसु कोत नेवराअयू, “जियाहा कान होय तो उनाइत ल्या!”<figure style="fig" alt="Jesus teaching the crowd by the sea" file="LB00299C.TIF" size="span" copy="Horace Knowles ©" ref="13:9">ईसु दोऱ्याआ मेरे नावड़ाम बोहीत गर्दीही सिकाड़त्लु</figure><verse eid="MAT 13:9" /></para>
  <para style="s">काईंइं उद्देश</para>
  <para style="r">(<ref loc="MRK 4:10-12">मार्क 4:10-12</ref>; <ref loc="LUK 8:9-10">लुक 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />ताहां सेला ईसुउ जागे आवित कोना वोल्या, “तू माअहूंअरी काईं वाअहीं काहा गोठी मेकत्लू?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />ताहां ईसु तियांहां उत्तर आप्यो, “तुमुहूं होरगाआ राजोअ निकाअली गोठी जाईंत लेअलोअ समज होय, पोन तियांहां कायनाहां. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" /><note caller="+" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">मत्तय 25:29</ref>; <ref loc="MRK 4:25">मार्क 4:25</ref>; <ref loc="LUK 8:18">लुक 8:18</ref>; <ref loc="LUK 19:26">19:26</ref> </char></note> काहाके जियापोअ होय, तियाहा फाशोअ बी जोड़े, आन तियापोअ जाअखीलोहो ओत जाय, पोन जियापोअ किज नाहां, तियापोअ जो किबी होय तो बी मागित लेय. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />आंय काईं वाअहीं तियांअरी याआकाजे गोठी मेकोहो, काहाके तें देखतेहे, पोन तियांहां नाहां देखाअतो, आन तें उनाअतेहें, पोन तियांहां नाहां समजाअतो. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />तियांआं बाप्तिमेहें यशयाआ भविश्यवाणी पुरी ओवेहे:</para>
  <para style="q1" vid="MAT 13:14">“‘एं माहें कानो वाअहीं ते उनाय, पोन ने समजे,</para>
  <para style="q2" vid="MAT 13:14">आन डोआ वाअहीं ते देखे, पोन ने देखाय.<note caller="+" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="ISA 6:10">यश 6:10</ref></char></note><verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />काहाके यां माअहुंउं मोने ते वोडे ओत गोयेहे,</para>
  <para style="q2" vid="MAT 13:15">आन तियां कान बुजीत लेदाहा,</para>
  <para style="q2" vid="MAT 13:15">आन ते तियांआं डोआ मिसीत लेदाहा;</para>
  <para style="q1" vid="MAT 13:15">एहेलोह ने ओवुहूं जोवे के ते डोआ वाअहीं देखे,</para>
  <para style="q2" vid="MAT 13:15">आन कानो वाअहीं उनाय,</para>
  <para style="q2" vid="MAT 13:15">आन मोनो वाअहीं समजे,</para>
  <para style="q1" vid="MAT 13:15">आन ते तियांआं मोन माआं वोगेहे वाले,</para>
  <para style="q2" vid="MAT 13:15">आन आंय तियांहां हुदारो.’<note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ISA 6:9">यश 6:9</ref>,<ref loc="ISA 6:10">10</ref>; <ref loc="JHN 12:40">योहान 12:40</ref>; <ref loc="ACT 28:26">प्रेशित 28:26</ref>,<ref loc="ACT 28:27">27</ref>; <ref loc="ROM 11:8">रोम 11:8</ref> </char></note><verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />“पोन केताहा हाजा होय तुमाआं डोआ, जे देखताहा; आन तुमाआं कान जे उनाअताहा.<note caller="+" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="LUK 10:23-24">लुक 10:23-24</ref> </char></note> <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />काहाके आंय तुमुहूं खोरीज कोहो, के जे गोठी तुमू देखतेहे ते वारुज भविश्यवक्ता आन धर्मी माअहूं देखीइलोअ इश्शा कोअयी, पोन तें ने देखीत सेके; आन जे गोठी तुमू उनाअतेहे ते तियां उनाइलोअ इश्शा कोअयी, पोन तें ने उनाइत सेके.<verse eid="MAT 13:17" /></para>
  <para style="s">बियारु ओअनाराआ काईं ईसु फोड़ कोइत आपत्लू.</para>
  <para style="r">(<ref loc="MRK 4:13-20">मार्क 4:13-20</ref>; <ref loc="LUK 8:11-15">लुक 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“ओमे तुमू बियारु ओअनाराआ काईंइं अर्थ उनाआ आन समजा. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />जो कोडो राज्याआ वसन उनाइत बी नाहां समजीइतो, तियाआ मोनोमेहें जो किबी ओआयोहो, तो एहलोहो होय, जो वाटेए मेरे ओअल्या बियाराअ होस होये. जियाहा तो पुत आवेहे आन बुउसीत लेत जातु रोहे. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />आन जो काकराट्यामेहें पोडल्यू होय, तो एहेलुहू बियारु होय, जो वसन उनाइत ताबुड़ खुसी वाअहीं मानित लेहे. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />पोन तियामेहें मुले कायने तिहीं वाअहीं तों थोड़ाज दिही टिकेहे, आन जाहां वसनोअ वोजेसे दुख नेत तारास ओवेहे, ताहां तों तुरतुज सोड़ी देत जातो रोहे. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />जों वोणसामेहें पोड़्यो, तों एहेला बियाराअ होस होये, जों वसन उनाअहे, पोन यी दुन्याअ सिंता आन धनोअ लालस वसनोहो दाबी देहे, आन तों नाहां फलतो. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />जों हाजा कादवूम पोड़्यो, तों एहेलोहो होय, जो वसनोहो उनाइत समजेहे आन फलवे आपेहे, कोडो होव पोट, कोडो साठ पोट, कोडो तीस पोट.”<verse eid="MAT 13:23" /></para>
  <para style="s">रानठ्या बियाराआ काईं</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />ईसु तियांहां फाश्यी एक काईं कोयी: “होरगाआ राज<note caller="+" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="MAT 13:31">मत्तय 13:31</ref>,<ref loc="MAT 13:33">33</ref>,<ref loc="MAT 13:44">44</ref>,<ref loc="MAT 13:45">45</ref>,<ref loc="MAT 13:47">47</ref>; <ref loc="MAT 18:23">18:23</ref>; <ref loc="MAT 20:1">20:1</ref>; <ref loc="MAT 22:2">22:2</ref>; <ref loc="MAT 25:1">25:1</ref>; <ref loc="MRK 4:26">मार्क 4:26</ref>,<ref loc="MRK 4:30">30</ref>; <ref loc="LUK 13:18">लुक 13:18</ref>,<ref loc="LUK 13:20">20</ref> </char></note> तिया माहुंउं होस होय, जिये तियाआ खेतोमेहें हाजू बियारु ओअयू. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />पोन जेहलामेहें माअहें हुवतेते, ताहां तियाआ दुस्मोन आवित गोंवोंमेहें रानठ्यू बियारु पेइ देत जातु रोयू. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />जाहां हुका निहीया आन जाहां निहींवे वोल्ये, ताहां रानठ्या बियाराआ खोड़ बी देखाअये. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />ताहां कोअ धण्योअ पावरों आवित तियाहा कोयो, ‘मालिख, तुमे ताआ खेतोमेहें हाजू बियारु नाहां ओअयू के? ताहां रानठ्या बियाराआ खोड़ तियामेहें का रोत आयो?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />तिये तियांहां कोयो, ‘ओं एखा दुस्मोनोअ काम होये.’ पावरों तियाहा कोयो के, ‘ताआ इश्शा होय के आमू जात कोइत तों उफड़ीत टाको?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />तिये कोयो, ‘नाहां, एहलोहो ने ओवुहूं जोवे के, रानठ्या बियाराआ खोड़ उफड़ाहा, तेहेलाम तुमू तियांअरी गोंवें बी उफड़ीत लेहा. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />वाडे ताअहूं जाआं बेनुहूं आरीज वोडे ओवुहूं द्या, आन वाडीइलोअ वेले आंय वाडनाराहां कोहीं के पेल रानठ्या बियाराआ खोड़ टोलू वालित पेटाड़ीलोअ काजे तियांआं पुला बांदी द्या, आन गोंवें माआं मोठीमेहें पोआ.’”<verse eid="MAT 13:30" /></para>
  <para style="s">रायीइ दाणाअ काईं</para>
  <para style="r">(<ref loc="MRK 4:30-32">मार्क 4:30-32</ref>; <ref loc="LUK 13:18-19">लुक 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />ईसु तियांहां फाश्यीइ एक काईं कोयी: “होरगाआ राज रायीइ दाणाआं होस होय, तों एखा माहुंउं होस जों लेत जात कोइत तियाहा खेतोमेहें ओइ देदू. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />तो आखा दाणामेहें रोत हानू होय, पोन जाहां वोडो ओत जाहे, तो बिहीरा आखापोअ रोत वोडो साड़ बोणीत जाहे, ताहां जुगोमेर्‍येए सिड़े आवित तियाआ डालीपोअ पांजरु बोणावतेहे.”<verse eid="MAT 13:32" /></para>
  <para style="s">खमीरोअ काईं</para>
  <para style="r">(<ref loc="LUK 13:20-21">लुक 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />ईसु तियांहां फाश्यी एक काईं कोयी: “होरगाआ राज खमीरोअ<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="fq" closed="false">खमीर </char><char style="ft" closed="false">मोन्ज्ये लोटोहो फुगाड़ीलोअ एक सोड़ाआ होसर्‍युउ वस्तू</char></note> होस होय, जियाहा एकी बोईं लेत जात कोइत तीन तागारी लोटोमेहें सान्बी देदू, आन रोता रोता तो आखु लोट खमीर वालू ओत गोयू.”<verse eid="MAT 13:33" /></para>
  <para style="s">ईसु काईंइं वापर कोअत्लू</para>
  <para style="r">(<ref loc="MRK 4:33-34">मार्क 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />ए आखी गोठी ईसु काईं वाअहीं माअहुंहूं कोत आप्यी, आन बिगर काईं वाअहीं कीज ने कोतूतो. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />के जो वसन भविश्यवक्ता वाअहीं कोयो, तो पुरो ओवे:</para>
  <para style="q1" vid="MAT 13:35">“आंय काईं कोअलोअ काजे माआं सोब उगाड़ीहीं;</para>
  <para style="q2" vid="MAT 13:35">आंय तियी गोठीही जे दुन्याआ बोणिइलोअ पेल गुप्त्यी होय, ते देखाड़ीहीं.”<verse eid="MAT 13:35" /></para>
  <para style="s">ईसु रानठ्या बियाराआ काईं फोड़ कोइत आपेहे</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />ताहां ईसु गर्दीही सोड़ीत कोअमेहें आवयू, आन तियाआ सेला तियाआ जागे आवित कोयो, “खेतोमेर्‍याआ रानठ्या बियाराआ काईं समजाड़ी दे.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />ईसु तियांहां उत्तर आप्यो, “हाजा बियाराआ ओअनारु माहुंउं बेटुह्हू होय. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />खेत कांय ए दुन्या होय, हाजू बियारु कांय देवोअ राज्याआ माअहें होय, आन रानठ्यू बियारु कांय पुतोअ माअहें होय. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />जिये दुस्मोने तो बियारु ओअयू, तो कांय सैतान होय; वाडीइलोअ वेल का दुन्याआं आखरी होय, आन वाडनारा कांय देवदुत होय. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />ताहां जेहें कोइत रानठ्या खोड़ोअ बियारु टोलू वालित पेटाड़तेहे तेहेंज कोइत दुन्याआ सेवट ओवे. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />माहुंउं बेटुह्हू तियाआ देवदुतोंहों मोकले, आन ते तियाआ राजोमेहें जे पाप कोआड़तेहे आन खाराब कामें कोअनाराहां एकठे कोए. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />आन तियांहां आगीइ दोर्‍यामेहें टाके, जिहीं रोड़ीइलोअ आन दात कोकराविलोअ रोय. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />तिये वेले देवोअ माअहें तियांआं आब्हाआ राजोमेहें दिहोअ होस सोमके. जियाअ कान होय तो उनाइत लेय.<verse eid="MAT 13:43" /></para>
  <para style="s">रेटल्या खोजानाआ काईं</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“होरगाआ राज एखा खेतोमेहें रेटल्या खोजानाआ होस होय. जो एखा माहुंहूं जोड़्यो आन तिये तो रेटी देदो, आन खुसीमेहें जात कोइत तियापोअ ओतो-नोतो तो आखो वेसी देदो आन तिया खेतोहो वेसातो लेत लेदो.”<verse eid="MAT 13:44" /></para>
  <para style="s">मोगला मोतीइ काईं</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“फाशोअ, होरगाआ राज एका वेपारीइ माहुंउं होस होये, जो हाजा मोतीही होदतुतो. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />जाहां तियाहा खुब किमती मोती जोड़्यू, ताहां तिये जात कोइत तिया पोअ ओतो तेतो आखो वेसी देदो आन तिया मोतीही वेसातु लेत लेदू.”<verse eid="MAT 13:46" /></para>
  <para style="s">जालेए काईं</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“फाश्योअ, होरगाआ राज तियी वोडी जालेए होस होये, जे दोर्‍यामेहें टाक्यी, आन आखी जातीइ मासे हारकीत लेतायी. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />आन जाहां जाल पोआत गोयी, ताहां मासारा ते जाल मेरे काड्यी, आन बोहीत हाजे-हाजे मासे बोअनामेहें एकठे कोअये, आन बिगर कामोअ ते टाकी देदे. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />दुन्याआं आखरीमेहें एहेंज कोइत ओवे. होरगाआ दुत आवित पाप्योहों धर्मी रोत अलग कोए. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />आन तियांहां आगीइ दोर्‍यामेहें टाके जिहीं रोड़ीइलो आन दात कोकराविलोअ रोय.”<verse eid="MAT 13:50" /></para>
  <para style="s">जुनी आन नवी शिक्शणोअ महत्व</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />ईसुहू तियां फुशो, “केहें तुमुहूं ए आखी गोठी समजाअयी के?”</para>
  <para style="p" vid="MAT 13:51">तियां कोयो, “होव प्रभु.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />तिये तियांहां कोयो, “तियाहा काजे हारेक कायदाआ मास्तर जो होरगाआ राजोअ सेलू बोण्युहूं, तो तियाआ कोठीमेहें रोत जुनी-नवी गोठी काडनारा एखा कोअ धण्योअ होस होय.”<verse eid="MAT 13:52" /></para>
  <para style="s">नासरेथ गांवोंमेहें ईसुउ नाकार</para>
  <para style="r">(<ref loc="MRK 6:1-6">मार्क 6:1-6</ref>; <ref loc="LUK 4:16-30">लुक 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />ताहां ए काईं कोत नेवराअयू तेहेलाम ईसु तिहीं रोत निहींयू. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />आन तियाआ गांवोंमेहें आवित तियांआं आराधनालयोमेहें तो तियांहां एहलोहो सिकाड़ु वोल्‍यू के, ते बोगलात कोना वोल्या के, “एती ओकल आन एं वोडे कामे कोइलाआ ताकत याहा का रोत जोड़्यी? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />ओ ते हूतारोअ पोर्‍यू ना? याआ आयहीही मरिया कोतेहे ना? याकोब, योसेफ, शिमोन, आन यहुदा ए याआ पाही होय ना? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />केहें याआ आखी बोअह्हीं आपाआ विसमेहें नाहां रोती के? ताहरीइ ए आखी गोठी याहा का रोत जोड़्यी?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />एहें कोइत तियां तियाआ नाकार कोअयू.</para>
  <para style="p" vid="MAT 13:57">ईसु तियांहां कोयो, “भविश्यवक्ताहा तियाआ गांवोंमेहें आन कोअमेहें सोड़ीत आखी जागे मानपान जोड़ेहे.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />काहाके तियांआं कमी विश्वासोअ वोजेसे तिहीं तिये वोडे कामें ने कोअये.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">बाप्तिस्मा आपनारा योहानोअ मोत</para>
  <para style="r">(<ref loc="MRK 6:14-29">मार्क 6:14-29</ref>; <ref loc="LUK 9:7-9">लुक 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />तिया गालाहा गालील भागोअ राजा हेरोद, ओ ईसुउ सर्सा उनाअयू. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />आन तियाआ आधिकार्‍योहों कोयो, “ओ बाप्तिस्मा आपनारु योहान होये, जो मोल्यामेहें रोत जिवीत उठ्युहू, तियाहा काजे तो वोडे वोडे कामें देखाड़ेहे.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:3 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 3:19-20">लुक 3:19-20</ref> </char>
    </note>काहाके हेरोद तियाआ पाही फिलीप याअ लाडी हेरोदिया यीइ वाखरी, योहानोहो तोइत बांद्यू आन जेलेमेहें केंडी देदूतो.<note caller="+" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="MAT 4:12">मत्तय 4:12</ref>; <ref loc="MAT 11:2">11:2</ref>; <ref loc="LUK 3:19-20">लुक 3:19-20</ref></char></note> <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" /><note caller="+" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="LEV 18:16">लेवी 18:16</ref>; <ref loc="LEV 20:21">20:21</ref></char></note>काहाके योहाने हेरोदोहो कोयोतो के, “ताआ काजे हेरोदियाहा राखीइलोअ हाजो कायनाहां.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />तियाहा काजे हेरोद तियाहा माईं देअहूं कोअतुतो, पोन तो यहुदी माअहुंहूं बितूतो, काहाके तें योहानोहो भविश्यवक्तू कोत मानतेते.<note caller="+" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="MAT 21:26">21:26</ref>; <ref loc="LUK 20:6">लुक 20:6</ref></char></note><verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />पोन जाहां हेरोद राजाआ जल्माआं दिही आयू, ताहां हेरोदियाआ बेट्टीही दरबारोमेहें नासीत हेरोद राजाहा खुस कोअयू. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />ताहां तिये आथवसन आप्यो के, “जो किबी तू मागही तो आंय ताहूं आपिहीं.”<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />ते तियीइ आयही कोयो तेहेंज कोइत कोयो, “बाप्तिस्मा आपनारा योहानोअ मुनको ठालीमेहें इंहींज माहूं लेतावीत आप.”<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />राजा दुखी ओवू, पोन तियाआ आथवसनोअ, आन आरी बोहनाराआं वाखरी, तों आपी देय तेहें काजे आदेश आपी देदू. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />आन तिये जेलेमेहें माहें मोकलीत योहानोअ मुनको वाडीत टाक्यो; <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />आन तियाआ मुनको ठालीमेहें लेत आवया आन पोर्‍यीही आप्यो, तो मुनको ते तियीइ आयहीइ जागे लेत गोयी. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />ताहां योहानोअ सेला आवया आन तियाआ तोड़, लेत गोया आन डाटी देदो, आन जात कोइत ईसुहू खबर आप्यी.<verse eid="MAT 14:12" /></para>
  <para style="s">ईसु पास हाजार माहुंहूं रोटू खावाड़त्लू</para>
  <para style="r">(<ref loc="MRK 6:30-44">मार्क 6:30-44</ref>; <ref loc="LUK 9:10-17">लुक 9:10-17</ref>; <ref loc="JHN 6:1-14">योहान 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />जाहां ईसु योहानोअ मोयातीइ खबर उनाअयू, ताहां तो नावड़ामेहें बोहीत तिहीं रोत हुंदली जागे जातु रोयू. माअहें ओं उनाइत होयर सोड़ीत तियाआ फासाड़ी पागे पागेज गोये. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />तिये नावड़ाप रोत उतरीत कोइत एक वोडी गर्दी देख्यी, आन तियांपोअ तियाहा किइमाय आवयी आन जें बिमार ओते तियांहां हुदार्‍ये.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />हांजे पोअ तियाआ सेला तियाआ जागे आवित कोयो, के “ओ हुंदलू जागू होये आन वाआ बी लागेहे, यां माअहुंहूं जाअहूं दे, मोन्ज्ये तें वोहतीमेहें जात कोइत जिव जिवोअ काजे रोटू वेसातू लेत लेय.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />“पोन ईसु तियांहां कोयो, ते ने जाअहूं जोवे! तुमूज याहां कि तेबी खायतेहें आपा!”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />तियां तियाहा कोयो, “इंहीं आमापोअ पास रोटा आन बेन मासे या वासी बिहीरो किज कायनाहां.”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />ईसु कोयो, “ते माआं जागे लेतावा!” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />ताहां तिये माअहुंहूं डोमटा पोअ बोहे तेहें कोयो, आन ते पास रोटा आन बेन मासा आथम लेत कोइत होरगाअहें पालीत देवोअ धन्यवाद कोअयो, आन रोटा मुड़ी-मुड़ीइ सेलाहां आप्या, आन सेला माअहुंहूं आप्या. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />जाहां आखे खात ताराईत गोये, ताहां सेला उगरीइल्या कुटकाआ बारा टोपली पोअयी. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />आन खानारामेएं बोईं आन पोर्‍ये सोड़ीत पास हाजार माटी ओता.<verse eid="MAT 14:21" /></para>
  <para style="s">ईसु पाअयों पोअ सालत्लू</para>
  <para style="r">(<ref loc="MRK 6:45-52">मार्क 6:45-52</ref>; <ref loc="JHN 6:15-21">योहान 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />ताहां ईसु ताबुड़ तियाआ सेलाहा नावड़ामेहें सोड़ीत तालावोअ तियी तोड़े जाय तेहें काजे कोयो. ताअहूं जाआं तो माअहुंहूं वाटे लागाड़नारु ओतू. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />तो माअहुंहूं वाटे लागाड़ीत कोइत, प्रार्थना कोउ बिहीरा डोगोपोअ जातु रोयू; आन हांजे पोअ तो एखलुज ओतू. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />ताहां नावड़ो दोऱ्याअ विसमेहें सेलका वाअहीं आलतोतो, काहाके वारो सामनेए वोल ओतो.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />आन ईसु रात्र्युउ तीन ते सोव वाजता पाअयों पोअ सालतूज तियांआं जागे आयू. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />सेला तियाहा पाअयों पोअ सालत्लाहा देखीत बित गोया. आन कोना वोल्या, “ओ पुत होय!” आन बिके वाअहीं किगला वोल्या.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />ताहां ईसु तियांअरी लगेज गोठी कोअयी आन कोयो, “हिम्मत मिका! आंय होय, बिहा मा!”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />पेत्र तियाहा कोयो, “प्रभु, जर तूज ओय, ताहां माहूं ताआ जागे पाअयों पोअ सालित आविइलोअ आदेश आप.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />ईसु तियाहा कोयो, “आव!” ताहां पेत्र नावड़ा पोअ रोत उतरीत ईसु जागे जाअलो काजे पाअयों पोअ सालु वोल्यू. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />पोन वादुहू पालीत बित गोयू, आन जेहेलाम बुडू वोल्यू तेहेलाम आअड़ीत कोयो, “प्रभु, माहूं वासाड़!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />ईसु लगेज आथ आगाड़ी कोइत तोइत लेदू आन तियाहा कोयो, “ताआ विश्वास केतुहू कमी होय! तू काहा सौंसू कोअयू?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />जाहां ते बेनू नावड़ामेहें सोढीत लागा, ताहां वादुउ आल्हात गोयू. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />ताहां सेला जे नावड़ामेहें बोहीत रोया ते ईसुउ पागे पोड़्या आन कोयो के “तू खोरीज देवोअ बेटुह्हू होय.”<verse eid="MAT 14:33" /></para>
  <para style="s">गनेसरेतोमेहें बिमाऱ्योहों हुदारीइलोअ</para>
  <para style="r">(<ref loc="MRK 6:53-56">मार्क 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />ते तियी तोड़ उतरीत कोइत गनेसरेतोमेहें पोतीत गोया, <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />तिहींइं माअहें ईसुहू ओलखीत लेदू आन आहने-पासेए आखा देसोमेहें खबर मोकल्यी, आन आखा मांदवाड़्याहां तियाआ जागे लेत आये. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />आन तियाहा रावणी कोए वोल्ये, के तु आमुहूं निस्तु ताआ साअकाआ कोरेहे एतुज तोअहूं दे; आन जेते जोएं तियाहा आथल्ये ते आखे हाजे ओत गोये.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">वेगाआ डायहांअ हिकवोण</para>
  <para style="r">(<ref loc="MRK 7:1-13">मार्क 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />ताहां येरुसालेमोमेहें रोत थोड़ाक फरिसी आन कायदाअ मास्तर ईसुउ जागे आवित कोना वोल्या, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“ताआ सेला आपाआ वेगाआ डायहांआं रिती-रिवाजोहों काहा नाहां मानता? ते बिगर आथ तुवयेज रोटू खाताहा.” <figure style="fig" alt="Ceremonial washing" file="LB00280C.TIF" size="col" copy="Horace Knowles ©" ref="15:2">यहुदी माअहोंअ आथ तुवीइलोअ रिती</figure><verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />ईसु तियांहां कोयो, “तुमू बी तुमाआं रिती-रिवाजोअ कोअता देवोअ आदेश काहा टाली देताहा? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" /><note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">निर्ग 20:12</ref>; <ref loc="EXO 21:17">21:17</ref>; <ref loc="DEU 5:16">कायदा 5:16</ref>; <ref loc="LEV 20:9">लेवी 20:9</ref> </char></note>काहाके देवे कोयोहो, ताआ ‘आब्हाआ आन आयहीइ मानपान कोअजी, आन जो कोडो आब्हाहा नेत आयहीही हाराप आपे, तियाहा माईंत टाकुहूं जोवे!’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />पोन तुमू कोताहा के जर कोडो तियाआ आयहीन आब्हाहा कोय, ‘जो किबी ताहूं मापोअ रोत लाभ ओवनारु ओतू, तो देवोहो भेट कोइ देदुहू,’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />ताहां तो तियाआ आयहीन आब्हाआ मानपान ने कोए, एहें कोइत तुमू तुमाआं रिती-रिवाजोअ काजे देवोअ वसन टाली देदो. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />ए ढोंगी! यशये तुमाआं बाप्तिमेहें ए भविश्यवाणी बोराबर कोअयीही.<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />“‘एं माअहें ओठो वाअहीं ते माआं मानपान कोअतेहें,</para>
  <para style="q2" vid="MAT 15:8">पोन यांआं मोन मारोत सेटे होय.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />आन एं वायबार माआं भक्ती कोअतेहे,</para>
  <para style="q2" vid="MAT 15:9">काहाके एं मोनवीइ नियमोहों देवोअ कायदु कोत सिकाड़तेहे.’”<verse eid="MAT 15:9" /></para>
  <para style="s">मोनव्योहो एठो पाड़नारी गोठी</para>
  <para style="r">(<ref loc="MRK 7:14-23">मार्क 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />ताहां ईसु माअहुंहूं तियाआ जागे हादीत तियांहां कोयो, “उनाआ आन समजा. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />जों सोबीमेहें जाहे, तों मोनव्योहो एठो नाहां कोअतो, पोन जों सोबीमेहें रोत निकलेहे, तोंज मोनव्योहो एठो कोअहे.”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />ताहां सेला आवित तियाहा कोयो, “ए गोठ उनाइत फरिसी नाराज ओत गोयाहा ओं ताहूं मुंदू होय के?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />ईसु उत्तर आप्यो, “हारेक साड़ जो माआं होरगामेर्‍येए आब्हे नाहां ठांअयों, तों मुलम रोत उफड़ीत टाकी देवाय. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />तियांहां जाअहूं द्या; ते आंदला पुडारी होये आन जर आंद्लो आंद्लाहाज वाट देखाड़े, ताहां बेनू बी खाड्डामेहें टुटीत पोड़े.”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />ओं उनाइत पेत्र तियाहा कोयो, “ए काईं आमुहूं समजाड़ी दे.”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />ईसु कोयो, “केहें तुमू बी ओमे जाआं नाहां समजीइता के? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />जों कि बी सोबीमेहें जाहे तो पोटामेहें जाहे, आन तों ओगीइली वाटे बारथे निहींत जाहे ओं तुमू नाहां समजीइता के? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />पोन जो किबी सोबीइ वाटे रोत बारथे निहेंहें, तों मोनोम रोत निहेंहें आन तोज मोनव्योहो एठो कोअहे. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />काहाके खाराब विसार, खुन, सिनालो, सोरी, ठोगोअ साक्शी आन निंदा ए गोठी मोनोम रोतीज निहींतिहीं. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />एंज गोठी होये जे मोनव्योहो एठो कोअतिही, पोन बिगर आथ तुवयेज रोटू खाअलो वाअहीं माहुंउं एठो नाहां ओवतो.”<verse eid="MAT 15:20" /></para>
  <para style="s">एकी बायीइ विश्वास</para>
  <para style="r">(<ref loc="MRK 7:24-30">मार्क 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />ईसु तिहीं रोत निहीत, सुर आन सिदोन मुलखोअ वोगेहे जातु रोयू. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />तिया मुलखोमेहें रोत एक कनानी बाय निठी, आन आअड़ीत कोनी वोल्यी, “ए प्रभु! दाविदोअ पोर्‍या, मापोअ दया कोअ! माआं बेटिह्हीही पुत जाअखीलुहू तारास देहे.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />पोन ईसु तियीही किज उत्तर ने आप्यो, ताहां तियाआ सेला आवित तियाहा रावणी कोअयी, “यिही वाटे लागाड़, काहाके ए आपाआ फाटी आअड़ीतीज आवेहे.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />ईसु उत्तर आप्यो, “आंय इस्राएलोअ घराणाआ टाकाअला मेडाआ काजे एतुज आयुहू.”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />पोन ते बाय आवयी, आन ईसुहू पागे पोड़ीत कोनी वोल्यी, “प्रभु माहूं मदत कोअ.”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />ईसु उत्तर आप्यो, “पोर्‍याआ रोटू तोइत हुंणाआं आगाड़ी टाकीइलोअ नाहां हाजो.”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />तियी कोयो, “खोरो होय प्रभु, पोन हुंणे बी तोम तियांआं मालख्योअ टेबलोपोअ रोत वेराअला रोटाआ सुउवूउ विसीत खातेहे.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />ताहां ईसु तियीही उत्तर आप्यो, “ए बाय ताआ विश्वास वोडू होय. जेहलीही ताआ इश्शा तेहलोज ताआ काजे ओत जाअहूं जोवे.” आन तियीइ बेटिह्ही तेताजमेहें हुदरीत गोयी.<verse eid="MAT 15:28" /></para>
  <para style="s">ईसु जाअखीला दुखोवाला माअहुंहूं हुदारत्लू</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />ईसु तिहीं रोत गालील दोर्‍याअ जागे आयू, आन डोगोपोअ सोढीत बोहीत गोयू. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />ताहां गोवरान गोवरा माअहें तियाआ जागे आवये. ते तियांअरी लेंगडाहां, आंद्लाहां, मुकाहां, पांगलाहां आन बिहीरा जाअखीला जोओंहों ईसुउ जागे लेत आवये, आन तियांहां तियाआ गुडाआ जागे मिकी देदे, आन तिये तियांहां हुदारी देदे. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />जाहां माअहूं देख्यो के मुके गोगतेहे, आन पांगले हुदरीइतेहें, आन लेंगड़े सालतेहे, आन आंद्ले देखतेहे, ताहां तें बोगलाअये आन इस्राएलोअ देवोअ स्तुती कोअयी.<verse eid="MAT 15:31" /></para>
  <para style="s">ईसु शार हाजार माअहुंहूं रोटू खावाड़त्लू</para>
  <para style="r">(<ref loc="MRK 8:1-10">मार्क 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />ईसु तियाआ सेलाहां हाद्या आन कोयो, “माहूं या माअहुंउं गोवारा पोअ दया आवेहे, काहाके तें तीन दिहीर्‍येए माअरीज होये, आन यांपोअ खाअलोअ काजे किज कायनाहां, आन यांहां फुकल्येज मोकलीइलोअ माआं इश्शा कायनाहां, काहाके एहलोहो ने ओवुहूं जोवे के तें वाटेज थाकीत जाय.”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />सेला तियाहा कोयो, “आमुहूं या जंगलोमेहें का रोत एतुहू रोटू जोड़े के आमू एता वोडा माअहुंउं गोवाराहा तारवीत सेको?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />ईसु तियांहां फुशो, “तुमापोअ केताहा रोटा होय?”</para>
  <para style="p" vid="MAT 15:34">तियां कोयो, “हांत रोटा, आन थोड़ेक हाने मासे.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />ताहां ईसु माअहुंहूं पुंयींपोअ बोहे तेहें कोयो. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />आन तिये हांत रोटा आन मासे लेत धन्यवाद कोइत रोटा मुड्या, आन तियाआ सेलाहा आपतू गोयू, आन सेला माअहुंहूं आपता गोया. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />एहें कोइत आखे खात ताराइत गोये, आन सेला उगरीइल्या रोटाआ कुटका वाअहीं पोआली हांत टोपली विश्यी. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />खानारे बोईंन पोर्‍ये सोड़ीत शार हाजार माटी ओता.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />ताहां ईसु माअहुंउं गोवाराहा वाटे लागाड़ीत नावड़ामेहें बोहीत गोयू, आन मगदान इलाखाअ हाद्दीइहीं आयू.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">समत्कारोअ मागणी</para>
  <para style="r">(<ref loc="MRK 8:11-13">मार्क 8:11-13</ref>; <ref loc="LUK 12:54-56">लुक 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />फरिसी आन सादूकी आहने आवित ईसुहू कोलित पालीइलोअ काजे तियाहा कोयो, “आमुहूं कितेबी होरगामेर्‍यीइ निशाणी देखाड़.” <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />ईसु तियांहां उत्तर आप्यो, “दिही बुड्ताअरीही तुमू कोताहा, ‘आज वातावरण हाजो रोय, काहाके जुग रातू होय.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />आन हुजताअरिही तुमू कोताहा, ‘आज पाईं आवे, काहाके जुग रातू आन कालू होय.’ तुमू जुगोअ निशाणी पालित तियाआ आंदास लागाड़ीत सेकताहा, पोन यी वेलेए निशाणी केहें नाहां ओलखीत सेकता? <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />यी दुन्याआ खाराब आन सिनाल माअहें निशाणी होदतेहे, पोन योनाअ निशाणी वासी यांहां बिहीरी कोड्लीज निशाणी ने जोड़े.”</para>
  <para style="p" vid="MAT 16:4">आन तो तियांहां सोड़ीत जातु रोयू.<verse eid="MAT 16:4" /></para>
  <para style="s">फरिसी आन सादूकीइ खमीर</para>
  <para style="r">(<ref loc="MRK 8:14-21">मार्क 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />सेला दोर्‍याअ तियी मेरे पोत्या, पोन ते रोटू लेअलाआ विहराइत गोयाते. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />ईसु तियांहां कोयो, “पाला, फरिसी आन सादूकीइ खमीरोप रोत सांबालित रोजा.”<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />ते तियां तियांआंज विसार कोआ वोल्या, “आमू रोटू नाहां लेत आवया तियाहा काजे ओ एहें कोहे.”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />ओं जाइंत ईसु तियांहां कोयो, “तुमाआं विश्वास केतुहू कमी होये! तुमू तुमा तुमाआंज काहा विसार कोअताहा के आमापोअ रोटू कायनाहां? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />केहें तुमू ओमे जाआं नाहां समज्या? केहें तुमुहूं तियां पास रोटा वाअहीं पास हाजार माअहें खात कोइत तुमू केतेहे टोपले पोइत रोटू विशू तों ओर कायनाहां के? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />आन तियां हांत रोटा वाअहीं शार हाजार माअहें खात कोइत तुमू केतेहे टोपले विशेते? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />तुमू काहा ने समजीइत्ला के आंय तुमुहूं रोटाआ बाप्तिमेहें नाहां कोयो, पोन ओं के तुमू फरिसी आन सादूकीइ खमीरो पोअ रोत सांबालित रोजा.”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />ताहां तियांहां समजाअयो के तिये रोटाआ खमीरो पोअ रोत नाहां, पोन फरिसी आन सादूकीइ हिकवोणो रोत सांबालित रोय तेहें कोयोतो.<verse eid="MAT 16:12" /></para>
  <para style="s">पेत्र ईसुहू मसीहा कोत मानेहे</para>
  <para style="r">(<ref loc="MRK 8:27-30">मार्क 8:27-30</ref>; <ref loc="LUK 9:18-21">लुक 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />ईसु कैसरीया फिलिप्पीइ मुलखोमेहें आवयू, आन तियाआ सेलाहां फुसू वोल्यू, “माअहें माहुंउं बेटाह्हाहा कि कोतेहे?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:1-2">मत्तय 14:1-2</ref>; <ref loc="MRK 6:14-15">मार्क 6:14-15</ref>; <ref loc="LUK 9:7-8">लुक 9:7-8</ref></char>
    </note> तियां कोयो, “थोड़ेक बाप्तिस्मा आपनारु योहान कोतेहे, आन थोड़ेक एलिया, आन थोड़ेक यिर्मया भविश्यवक्तामेहें रोत कोडू तेबी एक कोतेहे.”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />तिये तियांहां कोयो, “पोन तुमू माहूं कि कोताहा?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />शिमोन पेत्रे उत्तर आप्यो, “तू मसीहा<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">ख्रिस्त</char></note>, जिवता देवोअ बेटुह्हू होय.”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />ईसु तियाहा उत्तर आप्यो, “ए शिमोन, बार्योनाआ पोर्‍या, तु आशिर्वादीत होय, काहाके कोडा माअहूं पोअ रोत नाहां, पोन माआं बाह्हे जो होरगामेहें होय, तिये ए गोठ ताहूं देखाड़्यीही. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />आन आंय बी ताहूं कोहो के तू पेत्र होय, आन या खड़कापोअ माआं मंडड़ी बोणाविहीं, आन अधोलोक<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">मोल्या माहुंउं काजे तियी कोली तारासोअ जागु</char></note> बी याहा जिकीत ने सेके. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" /><note caller="+" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">मत्तय 18:18</ref>; <ref loc="JHN 20:23">योहान 20:23</ref></char></note> आंय ताहूं होरगाआ राजोअ किल्ली आपीहीं: आन जों कि बी तु धरती पोअ बांदिही, तों होरगामेहें बांदाय, आन जों किबी तु धरती पोअ सोड़ही, तो होरगामेहें सुटे.”<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />ताहां तिये सेलाहां तो मसीहा होय ए गोठ कोत कोडाहाज ने कोअहूं जोवे कोयो.<verse eid="MAT 16:20" /></para>
  <para style="s">ईसुउ सतावणी आन मोतोअ बाप्तिमेहें कोअलोअ</para>
  <para style="r">(<ref loc="MRK 8:31">मार्क 8:31</ref>; <ref loc="MRK 9:1">9:1</ref>; <ref loc="MRK 9:22-27">9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />ताहांज रोत ईसु तियाआ सेलाहा कोनु वोल्यू, “एहलोहो होय के आंय येरुसालेमोम जात कोइत डाया, आन मुख्य पुंजाराआं, आन कायदाअ मास्तरोंअ आथे जाअखीलोहो दुख वेठो; आन माहूं माइत टाके; आन तिसरे दिही जिवित उठीहीं.”<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />यापोअ रोत पेत्र तियाहा टोलतुज काडीत बावराउ वोल्यू, “प्रभु, एहेलोह ने ओवुहूं जोवे! ताअरी एहलोहो केदिहीं ने ओवुहूं जोवे!”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />ईसु फासाड़ी वोलीत पेत्राहा कोयो, “ए सैतान, माआं आगाड़ी रोत निहींत जा! तू माआं वाटी पोअ अड़सन होये, काहाके ए विसार देवोअहीं रोत नाहां, पोन माहुंउं विसार होये.”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />ताहां ईसु तियाआ सेलाहा कोयो, “जर कोडो माआं फासाड़ी आवुहूं कोअतो ओय, ताहां तो सोताआ जिवोहो विहराइत जाअहूं जोवे, आन तियाआ क्रुस उसलीत माआं फासाड़ी आवुहूं जोवे. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" /><note caller="+" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्तय 10:39</ref>; <ref loc="LUK 17:33">लुक 17:33</ref>; <ref loc="JHN 12:25">योहान 12:25</ref> </char></note> काहाके जो कोडो तियाआ जिव वासाड़ीइलोअ कोअतो ओय, तो तियाहा जावाड़ी देये, पोन जो कोडो माआं काजे तियाआ जिव आपे, तो तियाहा जोड़े. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />जर माहुंउं आखी दुन्या मेलवीत लेय, आन तियाआ जिव जावाड़े, ताहां तियाहा कि लाभ ओवे? नेत माहुंउं तियाआ जिवोअ बोदले कि आपे? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" /><note caller="+" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">मत्तय 25:31</ref>; <ref loc="PSA 62:12">भजन 62:12</ref>; <ref loc="ROM 2:6">रोम 2:6</ref> </char></note>माहुंउं बेटुह्हू तियाआ होरगाआ दुतोंअरी तियाआ आब्हाअरी महिमामेहें आवे, ताहां तियी वेले तो हारेक जोओंहों तियांआं कामोंअ पुरमाणे बक्शीस आपे. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />आंय तुमुहूं नक्की कोहो के जें इंहीं उबे रोयेहे, यांमेहें रोत थोड़ेक एहलेहे होय के जाअहूं जाआं माहुंउं बेटाह्हाहा तियाआ राजोमेहें आवत्लाहा ने पालीत लेय ताअहूं जाआं मोत ने देखे.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">ईसुउ बोदलाअलू रुप</para>
  <para style="r">(<ref loc="MRK 9:2-13">मार्क 9:2-13</ref>; <ref loc="LUK 9:28-36">लुक 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />सोव दिहोअ फासाड़ी ईसु पेत्र आन याकोब आन तियाआ पाही योहान यांहां आरी लेदा, आन तियांहां सामसुम जागे एका डोगोपोअ लेत गोयू. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />तिहीं तियांआं सामने ईसुउ रुप बोदलाअयू, आन तियाआ सोब दिहोअ होस सोमक्यी वोल्यी आन तियाआ साअको दिवाआ होस उजलो ओत गोयो. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />ताहां मोशे आन एलिया तियाअरी गोठी कोअत्ला तियां तीनू सेला देख्यो. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />ताहां पेत्रे ईसुहू कोयो, “प्रभु आपाआ इंहीं रोअलोअ हाजो होय. जर ताआ मोर्जी ओय ते आंय इंहीं तीन तंबा बोणावोहो; एक ताआ काजे, एक मोशेए काजे, आन एक एलियाआ काजे.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />तो गोग्याज कोअत्लू तेहेंज एक आसलो वादलो तियाहा टापित लेदू, आन तिया वादला मेहें रोत एहेलुहू आवाज आयू के, “ओ माआं मेरालू बेटुह्हू होये, जिया वाअहीं आंय खुस होय याआ उनाआ!”<note caller="+" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="DEU 18:15">कायदा 18:15</ref>; <ref loc="ISA 42:1">यश 42:1</ref></char></note><verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />सेला ओं उनाइत उबडा पोड़ीत गोया, काहाके ते जाअखीलाहा बित गोयाते. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />ईसु आहने आवित तियांहां आथ लागाड़ीत कोयो, “उठा, बिहा मा.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />ताहां तियां तियांआं डोआ उगाड़्या, पोन तियांहां ईसु वासी बिहीरो कोडोज ने देखाअयो.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />जाहां ते डोगोपोअ रोत निसे उतीरताते ताहां ईसु तियांहां ओ आदेश आप्यू, “जाअहूं जाआं माहुंउं बेटुह्हू मोइत फाशुउ जिवित ने उठे, ताअहूं जाआं जो किबी तुमू देख्योहो तो कोडाहाज मा कोहा.”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">17:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAL 4:5">मला 4:5</ref> </char>
    </note>ताहां तियाआ सेला तियाहा फुशो, “कायदाअ मास्तर काहा कोताहा के एलियाआ पेल आविइलोअ जरूरी होय?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />ईसु कोयो, “एलिया ते नक्की आवे आन आखो हुदारे. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" /><note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">मत्तय 11:14</ref> </char></note>पोन आंय तुमुहूं कोहो के एलिया आवित गोयुहू, आन माहें तियाहा ने ओलख्यु, पोन जेहलोहो पोटे तेहलोहो तियाअरी कोअयो. एहेंज कोइत माहुंउं बेटुह्हू बी तियांआं आथे दुख वेठे.”<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />ताहां सेला समज्यो के तिये आपुहूं बाप्तिस्मा आपनारा योहानोअ बाप्तिमेहें कोयोहो.<verse eid="MAT 17:13" /></para>
  <para style="s">ईसु पुत लागला पोर्‍याहा हुदारत्लू</para>
  <para style="r">(<ref loc="MRK 9:14-29">मार्क 9:14-29</ref>; <ref loc="LUK 9:37-43">लुक 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />जाहां ते गर्दीइ जागे पोत्या, ताहां एक माअहुंउं तियाआ जागे आयो, आन पागे पोड़ीत कोनो वोल्यो, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“प्रभु, माआं पोर्‍यापोअ दया कोअ! काहाके याहा फेपरो आवेहे, आन तो खुब तारास कोअहे, आन ताल-ताल आगीमेहें आन ताल-ताल पाअयोंमेहें टुटीत पोडेहे. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />आंय ताआ सेलाआ जागे लेत गोयूतो, पोन ते तियाहा हाजो ने कोइत सेक्या.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />ईसु उत्तर आप्यो, “ए विण विश्वासोवालां आन कोंबड़्या माअहों, आंय तुमाअरी कोयों जाआं रोंव? कोयों जाआं तुमाआं वेठो? या पोर्‍याहा माआं जागे लेतावा.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />ताहां ईसु पुतोहो आदेश आप्यू, आन तो पुत तियामेहें रोत निहीत गोयू; आन तो पोर्‍यू तियीज घेड़ी हुदरीत गोयू.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />ताहां सेला नेवराज ईसुउ जागे आवित कोइत कोयो, “आमू तिया पुतोअ आत्माहां काहा ने काडीत सेक्या?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />ईसु तियांहां कोयो, “तुमाआं कमी विश्वासोअ वोजेसे, काहाके आंय तुमुहूं खोरीज कोहो, जर तुमाआं विश्वास एका रायीइ दाणाअ एवडुहू बी ओय, ते या डोगोहो बी तुमू कोत सेकाहा के, ‘इंहीं रोत होरकीत तिहीं जातु रो,’ ताहां तो जातु रोय; आन कोड्लीज गोठ तुमाआं काजे कठीण ने रोय. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />पोन यी जातीइ पुते बिगर प्रार्थना आन उपासोवाअहीं नाहां निहींते.”<note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">थोड़ाक लेख्याम ओं वसन नाहां जोड़तो.</char></note><verse eid="MAT 17:21" /></para>
  <para style="s">ईसु फाशुउ तियाआ मोतोअ बाप्तिमेहें कोत आपत्लू</para>
  <para style="r">(<ref loc="MRK 9:30-32">मार्क 9:30-32</ref>; <ref loc="LUK 9:43-45">लुक 9:43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />जाहां ते गालीलोमेहें ओता, ताहां ईसु तियांहां कोयो, “माहुंउं बेटुह्हू माअहुंउं आथे तोआये, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />तें तियाहा माईंत टाके, आन तो तिसरे दिही जिवीत उठे.”</para>
  <para style="p" vid="MAT 17:23">यी गोठी पोअ सेला जास्ती नाराज ओवा.<verse eid="MAT 17:23" /></para>
  <para style="s">मंदिरोअ फालू</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />जाहां ईसु आन तियाआ सेला कफर्णहुम पोता, ताहां मंदिरोअ फालू लेनारा पेत्राआ जागे आवित फुशो के, “तुमाआं गुरु मंदिरोअ फालू ने आपत्लू के?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />पेत्रे कोयो, “होव, आपत्लू.”</para>
  <para style="p" vid="MAT 17:25">जाहां पेत्र कोअमेहें आवयू, ताहां ईसु तियाआ फुसीइलोअ पेलुज तियाहा कोयो, “ए शिमोन तू कि विसार कोअहे? धरतीइ राजा फालू नेत कर कोडापोअ रोत लेताहा? तियांआं पोर्‍यापोअ के पारकापोअ?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />पेत्रे तियांहां कोयो, “पारकापोअ.”</para>
  <para style="p" vid="MAT 17:26">ईसु तियाहा कोयो, “ताहां बेटुह्हू कर आपिइलाम रोत वासाइत गोयू. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />तेबी आपावाअहीं याहां माठो ने लागुहूं जोवे, तु दोर्‍याअहीं जा, आन मासे माइलोअ गोली टाक, आन जो मासु पेल लागे; तियाआ सोब उगाड़ही, ताहां ताहूं एक सांदीइ रुप्यु<note caller="+" style="f"><char style="fr" closed="false">17:27 </char><char style="fq" closed="false">सांदीइ रुप्यु </char><char style="ft" closed="false">ग्रीक सलन स्टाटेर: याआ किंमत शार जोओंअ फालू आपित सेके एतीही ओती.</char></note> जोड़े, तो लेत जात माआं आन ताआ बोदले तियांहां कर आपी देजी.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">होरगाआ राजोमेहें वोडो कोडो</para>
  <para style="r">(<ref loc="MRK 9:33-37">मार्क 9:33-37</ref>; <ref loc="LUK 9:46-48">लुक 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">18:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">लुक 22:24</ref> </char>
    </note>ताहां सेला ईसुउ जागे आवित फुसा वोल्या, “होरगाआ राजोमेहें वोडो कोडो होय?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />ताहां ईसु एका हाना पोर्‍याहा आहने हादीत तियांआं विसमेहें उबो कोअयो, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" /><note caller="+" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="MRK 10:15">मार्क 10:15</ref>; <ref loc="LUK 18:17">लुक 18:17</ref> </char></note>आन कोयो, “आंय तुमुहूं खोरो कोहो, के जाअहूं जाआं तुमू ने बोदलाअहा आन हाना पोर्‍याआ होस ने बोणहां, ताअहूं जाआं तुमू होरगाआ राजोमेहें नाहां जात सेकता. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />जो कोडो सोताहा या पोर्‍याआ होस हानो बोणावे, तो होरगाआ राजोमेहें वोडो बोणे. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />आन जो कोडो माआं नावसे एक एहेला पोर्‍याहा स्विकार कोअहे, तो माहूं स्विकार कोअहे.<verse eid="MAT 18:5" /></para>
  <para style="s">अड़सन टाकनाराआं काजे दुखोअ गोठ</para>
  <para style="r">(<ref loc="MRK 9:42-48">मार्क 9:42-48</ref>; <ref loc="LUK 17:1">लुक 17:1</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />“पोन जों कोडो मापोअ विश्वास कोअनारा यां हानामेहें रोत एकाहा बी अटकाव कोए, तियाआ गोलामेहें वोडु बी कोअटीइ पुड़ बांदीत कोइत, आन तियाहा उंडा दोर्‍याम टाकी देय तों जाआं पुरड़े. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />विश्वासोम अटकाव कोअनाराअ वोजेसे दुन्याआ केतीही खाराब हालत ओवे! अटकाव ते नक्की ओवे, पोन जों अटकाव कोअहे तिया माहुंउं केतीही खाराब हालत ओवे!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">18:8 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:30">मत्तय 5:30</ref> </char>
    </note> “जर ताआ आथ, नेत गुडू ताहूं अटकाव कोए, ताहां तियाहा वाडीत टाकी दे! बेन आथेन बेन गुडा लेत जलमजुग्‍यीइ आगीमेहें पोड़ीइलोअ यापरोत जाअखो हाजो ते ठुटो नेत लेंगड़ो ओत कोइत हादाफल्याआ जिवनोमेहें जाअलोअ पुरड़्यो. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />जर ताआ डोऊ ताहूं विश्वासोम अड़सन टाकतुये, ताहां तियाहा काडीत टाकी दे! बेन डोआ लेत नरकाआ आगीम पोड़ीइलो यारोत हाजो ते एक डोऊ लेत हादाफल्याआ जिवनोमेहें जाअलोअ ताआ काजे पुरड़्यो.<verse eid="MAT 18:9" /></para>
  <para style="s">टाकाअला मेडाआ काईं</para>
  <para style="r">(<ref loc="LUK 15:3-7">लुक 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />“पाला, तुमू या हानामेहें रोत एकाहा बी निसे मा मानहा, काहाके आंय तुमुहूं कोहो के होरगामेहें तियांआं दुत होरगामेऱ्याआ माआं आब्हाआ सोब हादाजोलम देखताहा. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />काहाके माहुंउं बेटुह्हू टाकाअलाहां वासाड़ू आयुहू.<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">थोड़हा जुना लेख्यामेहें ओं वसन नाहां जोड़तो.</char></note><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />“तुमू कि विसार कोअताहा? जर एकदा माहुंउं होव मेडे ओये, आन तियांमेहें रोत एक टाकाइत जाय, ताहां तो एक कमी होव मेडे सोड़ी देत तिया टाकाअला मेडाहा डोगोमेहें ने होदो जाय के? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />आन जर तों मेडो जोड़ीत गोयो, ताहां आंय तुमुहूं खोरीज कोहो के, जेतिही खुसी तियाहा बाकी नवह्यान्नव मेडा वाअहीं ने ओविये, एतीही खुसी तिया एका मेडाआ वाखरी ओवे. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />तेहलोज यां हानाम रोत एक बी ने आरवाअहूं जोवे एहलिही तुमाआं होरगामेऱ्याआ आब्हाआ इश्शा होय.<verse eid="MAT 18:14" /></para>
  <para style="s">गुनू कोअनाराअ बाप्तिम</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“जर ताआ पाही ताआ विरुद्दाम गुनू कोए, ताहां जा, आन तियाहा एखलाम लेत जात कि गुनू ओवुहू तो गोठी कोइत समजाड़, जर तो ताआ उनाय, ताहां तु ताआ पायहोहो जिकीत लेदू. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />पोन जर तो ने उनाय, ताहां एक नेत बेन जोओंहों ताअरी लेत जा, काहाके जेहलोहो कायदाआ पुस्तकोम लेख्योहो के, ‘एक गोठ बेन नेत तीन साक्शीदारोअ विसमेहें ओवुहूं जोवे.’ <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />जर तो तियांआं बी ने माने, ताहां मंडड़ीही कोत दे. पोन जर तो मंडड़ीइ बी ने माने, ताहां तू तियाहा बिगर यहुदी आन फालू लेनारा नाकेदारोअ होस मानजी.<verse eid="MAT 18:17" /></para>
  <para style="s">बांदीइलो आन सोड़ीइलो</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />“आंय तुमुहूं खोरीज कोहो के, जों किबी तुमू धरतीपोअ बांदहा, तों होरगामेहें बांदाय, आन जों किबी तुमू धरतीपोअ सोड़हा, तों होरगामेहें सुटे.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />“फाशुउ आंय तुमुहूं कोहो के, जर तुमामेहें बेन जोओं धरतीपोअ कोड्ली बी गोठ एक मोन ओत कोइत तियापोअ मागहा, ताहां माआं होरगामेऱ्याआ आब्हाआ वोगेहे रोत तियांआं काजे ते गोठ ओत जाय. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />काहाके जिहीं बेन नेताहां तीन माआं नावोमेहें टोलू ओवतेहे, तिहीं आंय तियांआं विसमेहें रोहो.”<verse eid="MAT 18:20" /></para>
  <para style="s">माफ ने कोअनारा सेवकोअ काईं</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />ताहां पेत्र ईसुउ जागे आवित कोयो, “प्रभु, जर माआं पाही गुनू कोअतू रोय, ताहां आंय तियाहा केतीही वाआ माफ कोओ, केहें हांत वाआ जाआं?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />ईसु तियाहा कोयो, “आंय ताहूं ओं नाहां कोतू के, तू हांत वाआ कोअ, पोन हांतोअ सत्तर वारी माफ कोअजी.” <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />“तियाहा काजे होरगाआ राज तिया राजाआ होस होय के, जिये तियाआ पावरोअ ईसाब लेअलोअ ठरव्यो. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />जेहेलाम तो ईसाब लेनु वोल्यू, तेहेलाम एका जोओंहों तियाआ सामने लेताये जो करोड़ो रुप्याआ कर्जावालू ओतू. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />जाहां तियापोअ कर्ज फिटीइलोअ काजे किज ने ओतो, ताहां तियाआ मालख्ये कोयो, ‘याहा आन याआ बोईंन पोर्‍याहा आन जों किबी याआ ओय, तों आखो वेसी द्या, आन कर्ज फिटी द्या.’ <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />ताहां तिये पावरे पागे पोड़ीत कोयो, ‘मालिख थोड़ाक दिही जाआं थोबेए, ताहां आंय आखो कर्ज फिटी देहीं!’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />ताहां मालख्ये तिया पावरोहो किइमाय कोइत सोड़ी देदू, आन तियाआ कर्ज बी माफ कोइ देदो.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“पोन जाहां तो पावर बाअथे निठू, आन तियाआ आरीइ पावरोमेहें रोते एकाहा मिल्यू, ताहां तियाआ होव रुप्याआ कर्ज ओतो. तिये तियाहा तोइत तियाआ गोलू दाबीत कोयो, ‘तापोअ माआं जों बी लेणो होय तों फिटी दे.’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />ताहां तियाआ हाती पावर जारी जारीइ रावणी कोउ वोल्यू, ‘थोड़ाक दिही थोबेए, आंय आखो फिटी देहीं.’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />तो ने मान्यू; पोन तियाहा कर्ज फिटे ताअहूं जाआं जेलेम टाकी देदू. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />ताहरुउ ओं देखीत कोइत तियाअरीइ हाती पावर खुब नाराज ओवयू, आन जात कोइत तियाआ मालख्योहो आखी गोठी कोत आपी देदी. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />ताहां तियाआ मालख्ये तियाहा हादीत कोयो, ‘ए रिकामा पावर! तुमे माहूं रावणी कोअयी, ताहां आंय ताआ आखो कर्ज माफ ने कोअयो के? <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />ताहरोअ जेहलीही आंय तापोअ किइमाय कोअयी, तेहेंज कोइत तु बी ताआ हाती पावरोपोअ किइमाय ने कोअहूं जोवतीते के?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />आन ताहरुउ तिये मालख्ये खोतेए बाल्लायी, तिया पावरोहो पुरो कर्ज ने फिटे ताअहूं जाआं जेलेम टाकी देदू.”<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />आन सेवटीपोअ ईसु कोयो, “एहेंज कोइत जर तुमामेहें हारेक जोंओं सोताआ पायहोहो जाअहूं जाआं पुरा मोनसे माफ ने कोए, ताअहूं जाआं माआं आब्हू जो होरगामेहें होय, तो बी तुमाअरी तेहलोज कोए.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">सोड़सिट्टीइ बाप्तिमेहें ईसुउ हिकवोण</para>
  <para style="r">(<ref loc="MRK 10:1-12">मार्क 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />जेहेलाम ईसु ए गोठी कोत नेवराअयू, तेहेलाम तो गालीलोमेहें जातु रोयू, आन यारदेनोअ तियी तोड़ यहुदीयाआ मुलखोमेहें आयू. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />ताहां वोडी गर्दी तियाआ फाटी आवी वोल्यी, आन तिये तियांहां तिहीं हुदार्‍ये.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />ताहां फरिसी तियाहा फारकीइलोअ कोअते आहने आवित कोना वोल्या के, “कोड्ला बी कारणो वाअहीं आपाआ कायदाआ पुरमाणे सोताआ बोईंही सोड़ीइलोअ ठीक होय के?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:4 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:27">उत्प 1:27</ref>; <ref loc="GEN 5:2">5:2</ref> </char>
    </note> ईसु उत्तर आप्यो, “तुमू कायदाआ पुस्तकोम नाहां वाश्यो के, जिये तियांहां बोणाये, तिये सुरुवातीमेहें रोत माटी आन बोईं कोत बोणाये?<verse eid="MAT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 19:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:5 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 2:24">उत्प 2:24</ref> </char>
    </note> “आन ताहरोअ देवे कोयो, ‘तिहींइं वाखरी माटी तियाआ आयहीन आब्हाअहीं रोत आंगे ओत तियाआ लाडीइरी रोय, आन तें बेनू एक जिव ओवे.’ <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />तिहींवाअहीं ओमे तें बेन नाहां, पोन तें एक जिव होय, ताहां जियांहां देवे जुड़्येहे, तियांहां कोडो माअहुंउं आंगे ने कोअहूं जोवे.”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />फरिसी माट्यों तियाहा कोयो, “ताहरोअ मोशे कायदाम ओं काहा ठरव्यो के सोड़सिट्टी आपीत तियीही सोड़ी देअहूं जोवे?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />ईसु तियांहां कोयो, “मोशे तुमाआं कड़क मोनोअ वोजेसे तुमुहूं जिव जिवोअ बोईंहीं सोड़सिट्टी आपेतेहें आदेश आप्यू, पोन कोलीइ सुरुवातीही रोते एहलोहो ने ओतो. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />आन आंय तुमुहूं कोहो के, जो कोडो सिनालाअ वासी बिहीरा एखा कारणोअ वोजेसे तियाआ बोईंहीं सोड़ीत बिहीरीइरी वेहवाल कोअहे, तो सिनालो कोअहे.”<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />तियाआ सेला तियाहा कोयो, “जर माट्योअ बोईंइंरी एहेलोह नातो ओय, ताहरोअ जी वेहवाल ने कोअल्ये हाजो रोनारो.”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />ईसु तियांहां कोयो, “आखेज ओं वसन स्विकार नाहां कोइत सेकते, फक्त तेंज स्विकार कोइत सेकतेहे, जियांहां एहलोहो दान आप्योहो. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />काहाके थोड़ेक सोडले एहलेहे होय, जें आयहीइ पोटाजमेहें रोत एहलेहे जल्माहां आवयेहे, आन थोड़ेक सोडले एहलेहे होये, जियांहां माअहूं सोडले बोणाये, आन थोड़ेक सोडले एहलेहे होय, जियां होरगाआ राजोअ काजे सोताआ जिवन सोडलो मेक्येहो. जो ओं स्विकार कोइत सेकेहे, तो स्विकार कोए.”<verse eid="MAT 19:12" /></para>
  <para style="s">ईसु हाना पोर्‍याहां आशिर्वाद आपत्लू</para>
  <para style="r">(<ref loc="MRK 10:13-16">मार्क 10:13-16</ref>; <ref loc="LUK 18:15-17">लुक 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />ताहरेए माअहें पोर्‍याहां ईसुउ जागे लेतावये के तो तियांपोअ आथ मिके आन प्रार्थना कोए, पोन सेला तियांहां बावराआ वोल्या. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />ईसु कोयो, “पोर्‍याहां माआं जागे आवुहूं देवा, आन तियांहां रुकाहा मा, काहाके के होरगाआ राज यांआं होसर्‍याआंज होये.”<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />आन तिये तियांपोअ आथ मिकीत तिहीं रोत जातु रोयू.<verse eid="MAT 19:15" /></para>
  <para style="s">मालदार जुवान</para>
  <para style="r">(<ref loc="MRK 10:17-31">मार्क 10:17-31</ref>; <ref loc="LUK 18:18-30">लुक 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />एक माअहुंउं ईसु जागे आयो, आन तियाहा कोयो, “ए गुरु, आंय कोड्लो हाजो काम कोओ, के माहूं हादाफल्योअ जिवन जोड़ीत सेके?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />ईसु तियाहा कोयो, “कि हाजो होये एहें कोत तू माहूं काहा फुसेहे? हाजू ताम एकुज होये, पोन जर तू जिवनोमेहें जाअलोअ कोअतुये, ताहां आदेशोअ पालन कोअजी.”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />तिये तियाहा कोयो, “कोड्ला आदेशे?”</para>
  <para style="p" vid="MAT 19:18">ईसु तियाहा कोयो, “खुन मा कोअही, सिनालो मा कोअही, सोरी मा कोअही, खोटी साक्शी मा आपिही, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />ताआ आब्हान आयहीइ मान-पान कोअजी, आन आहनेवालां पोअ ताआज होस मेर कोअजी.”<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />तिये जुवाने कोयो, “यां आखा आदेशोंहों आंय मानोहो, ओमे मामेहें फाश्यीइ कोड्ली गोठीइ कमी होये?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />ईसु तियाहा कोयो, “जर तु पुरो ओवीइलोअ कोअतुये, ताहां जा, ताआ आखो मालधन वेसीत गोरब्योहों आपी दे, आन ताहूं होरगामेहें धन जोड़े, आन तू आवित कोइत माआं फाटी सालेए.”<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />पोन तो जुवान ए गोठ उनाइत नाराज ओत कोइत जातु रोयू, काहाके तो खुब मालदार ओतू.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />ताहां ईसु तियाआ सेलाहां कोयो, “आंय तुमुहूं खोरो कोहो के मालदारोअ होरगाआ राजोमेहें जाअलोअ जाअखो कठीण होय. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />तुमुहूं फाशुउ कोहो के, देवोअ राजोमेहें मालदार जाय तेतोहो जी हुयीइ नाकोम रोत उटड़ो सोरकीत जाय तों जाआं सोपो होये.”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />ओं उनाइत सेला खुब बोगलात गोया. तियां फुशो, “ताहां कोडाआ तारण ओवे?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />ईसु तियांअहें पालीत कोयो, “माअहूं वाअहीं ते ओं नाहां ओत सेकतो, पोन देवोअ काजे आखो ओत सेकेहे.”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />ताहां पेत्रे कोयो, “पाल आमू ते आखो सोड़ीत ताआ फाटी आयाहा: ताहां आमुहूं कि जोड़े?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />ईसु तियांहां कोयो, “आंय तुमुहूं खोरो कोहो, के नोवी कोलीमेहें जाहां माहुंउं बेटुह्हू तियाआ महिमामेहें राजगादीपोअ बोहे, तेहेलाम तुमू बी जे माआं फाटी आवयाहा, बारा राजगादीपोअ बोहीत इस्राएलोअ बारा पारवाड़ीइ न्यायनिवाड़ु कोअहा. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />आन जिये कोडे बी कोअ, नेते पाही, बोअह्हीं, आब्हाहा, नेत आयहीही, नेत पोर्‍याहा, खेतोहो माआं नावोअ काजे सोड़ी देदोये, तियाहा होव पोट मिले, आन तो हादाफल्याआ जिवनोअ आधिकारी ओवे. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />पोन वारुज जोंअ जे पेहला होये ते सेवट्याआ बोणे; आन जे सेवट्याआ ते पेहला बोणे.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">दाराक्शाआ मोलाम काम कोअनाराआं काईं</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“होरगाआ राज एका कोअधण्योअ होस होये, जो वेगर्‍यूउ तियाआ दाराक्शाआ मोलामेहें मोजर्‍याहां कामे लागाड़ीइलो काजे निठू. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />तिये मोजर्‍याहां एक सांदीइ रुप्याआ रोजनदारी ठरव्यी, आन तियांहां तियाआ दाराक्शाआ मोलामेहें कामोहों मोकल्ये. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />फाशुउ नोव वाजता तिये जात कोइत थोड़ाक माअहुंहूं बाजारोमेहें बिगर कामोओं उबे रोत रोल्ये देख्ये, <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />आन तियांहां कोयो, ‘तुमू बी दाराक्शाआ मोलामेहें जावा, आन जे बी बोराबर मोजरी ओय, ते आंय तुमुहूं आपीहीं.’ ताहां तें बी गोये. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />फाशुउ तो बारा वाजता आन तीन वाजता जात कोइत तेहेंज कोअयो. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />पास वाजता जेहें जाहां तो बाजारोमेहें गोयू, ताहां वारुज जोओं फाश्याआ उबा रोत रोल्या देख्या आन तियांहां कोयो, ‘तुमू काहा दिही पोइत इंहीं उबा रोया?’ तियां तियाहा कोयो, ‘याआकाजे के कोडे बी आमुहूं कामोपोअ ने लागाड़्या.’ <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />तिये तियांहां कोयो, ‘तुमू बी दाराक्शाआ मोलामेहें जावा.’<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />“हांजेपोअ दाराक्शाआ मोलाआ मालख्ये तियाआ जागल्याहा कोयो, ‘मोजर्‍याहां हादीत सेलवार्‍यां रोत ते पेलठाहा जाआं तियांआं मोजरी आपी दे.’<note caller="+" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">लेवी 19:13</ref>; <ref loc="DEU 24:15">कायदा 24:15</ref></char></note> <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />जाहां ते आये जे पास वाजता कामोपोअ आयेते, ताहां तियांहां एक-एक सांदीइ रुप्यू आप्यू. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />जें पेल आवयेते, तियांहां ओं समज्यो के आमुहूं वादार मिले, पोन तियांहां बी एक-एक सांदीइ रुप्यू जोड़्यू. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />जाहां रुप्यू जोड़्यू, ताहां ते लेत कोइत कोअ धण्योअ बाप्तिमेहें टुटणा वोल्या, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />‘यां सेलीसेवाआ एकुज तास काम कोअयो, आन तुमे तियांहां बी आमाआं एतीही मोजरी आप्यी, जियां दिही पोइत काम कोअयो आन तोप सेल्यू, तियांहां बी तेतीहीज मोजरी आप्यी?’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />तिये तियांमेहें रोत एकाहा उत्तर आप्यो, ‘ए दोस्ता, आंय तापोअ किज अन्याय नाहां कोअतू. तुमेज माहूं एका दिहोअ मोजरी एक सांदीइ रुप्यू नाहां ठरव्यू के? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />जो ताआ होय, तों विसीत लेन जातु रो, माआं मोर्जी ए होय के जेतोहो ताहूं तेतोहो सेलवार्‍याहा बी आपो. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />केहें आंय माआं पोशा माआं गोमताज नाहां वापरीत सेकतु के? आंय हाजू रोत्लू काजे तू आदरात्लू के?’”<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />एहें कोइत ईसु नेवराअयू, “जें सेलवाऱ्येए होय, तें पेलठे बोणे, आन जें पेलठे होय, तें सेलवाऱ्येए बोणे.”<verse eid="MAT 20:16" /></para>
  <para style="s">सोताआ मोतोअ बाप्तिमेहें ईसुउ तिसरी भविश्यवाणी</para>
  <para style="r">(<ref loc="MRK 10:32-34">मार्क 10:32-34</ref>; <ref loc="LUK 18:31-34">लुक 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />ईसु येरुसालेमोमेहें जात्लू तेहेलामेहें बारा सेलाहां नेवरुज लेत गोयू, आन वाटेज तियांहां कोनु वोल्यू, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“पाला, आपू येरुसालेमोमेहें जाताहा, आन माहुंउं बेटुह्हू डाया पुंजारा आन कायदाअ मास्तरोंअ आथे तोआत जाये, आन ते तियाहा माइत टाके. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />आन तियाहा बिगर यहुदी माअहोंअ आथोमेहें होपी देये, के ते तियाआ टिंगल कोए, आन सापका देये, आन क्रुस खांबोपोअ टांगे, आन तो तिसरे दिही जिवीत उठे.”<verse eid="MAT 20:19" /></para>
  <para style="s">एकी आयहीइ रावणी</para>
  <para style="r">(<ref loc="MRK 10:35-45">मार्क 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />ताहां जब्दीइ लाडी, तियीइ पोर्‍यांअरी ईसु जागे आवित पागे पोड़्यी, आन तियापोअ कितेबी मागी वोल्यी.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />ईसु तियीही फुशो, “ताहूं कि जोवे?” तियी तियाहा कोयो, “माआं बेनू पोर्‍या तुमाआं राजोमेहें एकाहा तुमाआं हाजाड़ीइ वोगेहे आन एकाहा तुमाआं बांगड़्यीइ वोगेहे बोहे एहेलोह आथवसन आपा.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />ईसु उत्तर आप्यो, “तुमू नाहां जांअते के तुमू कि मागतेहे. जो कोटीवरु आंय पिअहूं कोअहो, केहें तुमू पित सेकतेहे के?”</para>
  <para style="p" vid="MAT 20:22">तियां तियाहा कोयो, “पित सेकताहा.”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />ईसु तियांहां कोयो, “तुमू माआं कोटीवरु ते पित सेकतेहे. पोन माआ हाजली वोगे नेताहां बांगाड़्यीइ वोग बोहाड़ीलोअ माआं काम कायने, पोन जियाआ काजे माआं आब्हे तियार कोअयोहो, तियांआंज काजे होय.”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />ओं उनाइत बेनू पायहों पोअ दोहू सेलाहां खोत लागी. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />ईसु तियांहां जागे हादीत कोयो, “तुमू जांअताहा के बिगर यहुदीइ राजाहां तियांआं माहूंपोअ राज देखाड़ीइलो गोमेहें, आन तियांआं पुढाऱ्योहों तियांहां पोटे तेहेली पद्दतीवाअहीं आधिकार वापरीइताहा. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />पोन तुमामेहें एहलोहो ने ओवे; पोन जो कोडो तुमामेहें वोडो बोणुहूं होदतोये, तो तुमाआं सेवक बोणे; <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />आन जो तुमामेहें पेलठू ओवहूं कोअतू ओय, तो तुमाआं पावर बोणे; <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />जेहलोहो के माहुंउं बेटुह्हू; तो याआकाजे नाहां आवयू के तियाआ सेवा कोए, पोन याआकाजे आयुहू के तुमाआं सेवा कोए, आन खुब जोओंअ काजे जिव आपे.”<verse eid="MAT 20:28" /></para>
  <para style="s">ईसु बेन आंद्लाहां हुदारत्लू</para>
  <para style="r">(<ref loc="MRK 10:46-52">मार्क 10:46-52</ref>; <ref loc="LUK 18:35-43">लुक 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />जाहां ईसु आन तियाआ सेलां यरीहो रोत निहींताते, ताहां एक वोडी गर्दी तियाआ फाटी आयी. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />आन बेन आंदले जे सडकेए मेरे बोठे ते, ओं उनाइत के ईसु जाहे, हाद कोइत कोना वोल्या, “प्रभु<note caller="+" style="f"><char style="fr" closed="false">20:30 </char><char style="fq" closed="false">प्रभु </char><char style="ft" closed="false">थोड़हा लेख्यामेहें प्रभु शब्द नाहां जोड़तो</char></note>, दाविदोअ पोर्‍या, आमापोअ दया कोअ!”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />ते ठावकाज रोय तेहें काजे माहें तियांहां गाई देने वोल्ये; पोन ते फाश्याआ बी आअड़ीत कोयो, “प्रभु, दाविदोअ पोर्‍या आमापोअ दया कोअ!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />आन ईसु ऊबू रोत कोइत, तियांहां हाद्या आन कोयो, “तुमुहूं कि जोवे के आंय तुमाआं काजे कोए?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />तियां तियाहा कोयो, “प्रभु, आमांआं डोआ उगड़ीत जाय एहेलोहो कोइ दे.”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />ईसु किइमाय कोइत तियांआं डोआहां आथ लागाड़्या, आन ते तुरतुज पाला वोल्या; आन तियाआ फाटी गोया.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">येरुसालेमोमेहें विजयी प्रवेश</para>
  <para style="r">(<ref loc="MRK 11:1-11">मार्क 11:1-11</ref>; <ref loc="LUK 19:28-40">लुक 19:28-40</ref>; <ref loc="JHN 12:12-19">योहान 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />जेहेलाम ईसु आन तियाआ सेला येरुसालेमोअ आहने पोता, आन जेयतुन डोगोपोअ बेथफागेए जागे आया, ताहरुउ ईसु बेन सेलाहा ओं कोत कोइत मोकल्या, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />“हुंबर्‍याआ गांवोंमेहें जावा. तिहीं पोत्ताज वाआ एक बांदल्यी गोदड़ी आन तियीइरी बासो तुमुहूं देखाय. तियाहा सोड़ीत कोइत माआं जागे लेतावा. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />आन एकदो काविंहीं कोये, ताहां कोजा, ‘प्रभुहू याआ गरज होय;’ ताहां तों तुमुहूं ताबुड़तुड़ मोकले.” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />ओं याअ काजे ओवो काहाके, भविश्यवक्ता जों कोयो तों पुरो ओवुहूं जोवे; तों एहें कोइते:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">21:5 </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 9:9">जख 9:9</ref>
      </char>
    </note> “‘सियोनोअ पोर्‍यीही कोवा,</para>
  <para style="q2" vid="MAT 21:5">पाल, ताआ राजा नम्र ओत कोइत,</para>
  <para style="q1" vid="MAT 21:5">तो गोदड़ीइ बासापोअ बोहीत</para>
  <para style="q2" vid="MAT 21:5">ताआ जागे आवेहे.’”<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />सेला जात कोइत, जेहेंकोइत ईसु तियांहां कोयो, तेहेंज कोइत कोअयो. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />आन गोदड़ी आन तियीइ बासो लेतावीत तियापोअ तियांआं आंगड़े टाक्ये आन ईसु तियापोअ बोहीत गोयू. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />ताहां वारुज माअहें तियांआं आंगड़े वाटेपोअ आथर्‍ये, थोड़हे माअहें साड़ोअ डाली वाडीत वाटेपोअ आथर्‍यी. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />जे गर्दी तियाआ आगाड़ी जातीते आन फाटी आवतीते ते आअड़ी आअड़ीइ कोतीते, “दाविदोअ पोर्‍याहा होसान्ना!<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">होसान्ना मोन्ज्ये, जय हो! </char></note> आशिर्वादीत होय तो, जो देवोअ नावसे आवेहे! उसे जुगोमेहें होसान्ना!”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />जाहां ईसु येरुसालेमोमेहें आयू ताहां आखो होयर गुजुगुजु कोओ वोल्यो, आन तें माअहें कोने वोल्ये, “ओ कोडू होये?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />गर्दीमेर्‍याअ माअहूं कोयो, “ओ गालीलोअ नासरेथ होयरोमेर्‍युउ भविश्यवक्ता ईसु होये.”<verse eid="MAT 21:11" /></para>
  <para style="s">ईसु मंदिरोमेहें जात्लू</para>
  <para style="r">(<ref loc="MRK 11:15-19">मार्क 11:15-19</ref>; <ref loc="LUK 19:45-48">लुक 19:45-48</ref>; <ref loc="JHN 2:13-22">योहान 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />ईसु देवोअ मंदिरोमेहें जात कोइत तियां आखाहा जे मंदिरोमेहें वेवारो कोअताते, काडी देदा, आन पोशाअ वेवारो कोअनाराआं टेबल आन पेरवे वेसनाराआ कुर्सी उलटावी देदी. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" /><note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">यश 56:7</ref>; <ref loc="JER 7:11">यिर्म 7:11</ref> </char></note> आन तियांहां कोयो, “वसनोमेहें एहें कोइत लेख्योहो के, ‘माआं कोअ प्रार्थनाअ कोअ एहें कोये.’ पोन तुमू याहा बांडोअ कुपा कोइत रोयाहा!”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />ताहां आंद्ले आन लेंगड़े तियाआ जागे मंदिरोमेहें आये, तियांहां तिये हुदार्‍ये. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />ताहां तिये कोअल्ये समत्कारोअ कामे पालीत “दाविदोअ पोर्‍याहा होसान्ना!” एहें कोत मंदिरोमेहें आअड़ीनारा पोर्‍याहां पालीत मुख्य पुंजारु आन कायदाआ मास्तर याहां खोत लागी. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" /><note caller="+" style="x"><char style="xo" closed="false">21:16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">भजन 8:2</ref> </char></note> आन ते ईसुहू कोना वोल्या, “तू उनाअहे के एं कि कोतेहे?”</para>
  <para style="p" vid="MAT 21:16">ईसु तियांहां कोयो, “होव; केहें तुमू ओं केदिहींज नाहां वाश्यो, के ‘पोर्‍याहा आन बुजी खानारा पोर्‍याआं सोबी वाअहीं तुमे खुब स्तुती कोआड़्यी?’”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />ताहां ईसु तिया सेहरोहो सोड़ीत बेथानी नावोअ गाँवोम गोयू आन तिहींज रात काड्यी.<verse eid="MAT 21:17" /></para>
  <para style="s">ईसु अंजिरोअ साड़ोहो हाराप आपत्लू</para>
  <para style="r">(<ref loc="MRK 11:12-14">मार्क 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />वेगीइ वेले जाहां तो होयरोअहें वोलीत आवत्लू, तेहलाम तियाहा फुख लागी. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />सडकेए मेरे एक अंजिरोअ साड़ देखीत तो तियाआ जागे गोयू, आन पानोवासी तियामेहें बिहीरो किज ने जोड़्यो, तिये तिया साड़ोहो कोयो, “ओमें रोत ताहूं फाशोअ फिरीत केदिहीं फल ने लागे.” आन अंजिरोअ साड़ ताब्बुड़ उगाईत गोयो.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />ओं देखीत सेला पोंगलाईत गोया आन तियां कोयो, “ओं अंजिरोअ साड़ ताब्बुड़ कि कोइत उगाईत गोयोहो?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">21:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 17:20">मत्तय 17:20</ref>; <ref loc="LUK 17:6">लुक 17:6</ref>; <ref loc="1CO 13:2">1 करिन्थ 13:2</ref> </char>
    </note> ईसु तियांहां कोयो, “आंय तुमुहूं खोरो कोहो, जर तुमू विश्वास मिकहा आन सौंसू ने कोअहा, ताहां एतोज ने कोअहा जो या अंजिरोअ साड़ोअरी कोअयोहो, पोन जर या डोगोहो बी कोहा, ‘उपटित जा, आन दोर्‍यामेहें जात पोड़,’ ताहां ओं ओत जाये. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />आन जो किबी तुमू प्रार्थनामेहें विश्वासो वाअहीं मागहा तो आखो तुमुहूं मिले.”<verse eid="MAT 21:22" /></para>
  <para style="s">ईसुउ आधिकारो पोअ प्रश्न</para>
  <para style="r">(<ref loc="MRK 11:27-33">मार्क 11:27-33</ref>; <ref loc="LUK 20:1-8">लुक 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />ईसु फाशुउ मंदिरोमेहें जात कोइत हिकवोण आपतुतो, ताहां मुख्य पुंजारु आन डाया तियाआ जागे आवित फुशो, “तु ओं काम कोड्ला आधिकारो वाअहीं कोअत्लू? आन ताहूं ओं आधिकार कोडे आप्युहू?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />ईसु तियांहां उत्तर आप्यो, “आंय बी तुमुहूं एक गोठ फुसोहो; जर ते माहूं कोत आपहा, ताहां आंय बी तुमुहूं कोहीं के ओं काम कोड्ला आधिकारो वाअहीं कोअहो. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />योहानोअ बाप्तिस्मा का रोत ओतू? होरगामेहें रोत के माअहूं पोअ रोत?”</para>
  <para style="p" vid="MAT 21:25">ताहां ते तियां तियांआंज बिबड़ा वोल्या, “जर आपू कोहूं ‘होरगामेहें रोत,’ ताहां तो आपुहूं कोये, ‘ताहराआ तुमू तियापोअ विश्वास काहा नाहां कोअयू?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />आन जर कोहूं ‘माअहूं पोअ रोत,’ ताहां आपुहूं माअहूं गर्दीइ बिक होय, काहाके तें आखे योहानोहो भविश्यवक्ता कोत मानत्ले.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />ताहां तियां ईसुहू उत्तर आप्यो, “आमुहूं ने मुंदू.”</para>
  <para style="p" vid="MAT 21:27">तिये बी तियाहा कोयो के, “आंय बी तुमुहूं नाहां कोतू के ओं काम कोड्ला आधिकारो वाअहीं कोअहो.”<verse eid="MAT 21:27" /></para>
  <para style="s">बेन पोर्‍याआ काईं</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“ओमे तुमुहूं कि लागेहे तो कोवा? एका माट्योओ बेन पोर्‍या ओता; ताहां तो डाया पोर्‍याआ जागे गोयू आन कोयो, ‘पोर्‍या, जा आन आजे दाराक्शाआ मोलामेहें काम कोअजी.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />तिये कोयो ‘होव बा, आंय जाहो,’ पोन तो ने गोयू. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />ताहां बाह्हू हानीइला पोर्‍याआ जागे गोयू आन तियाहा बी पेहला पोर्‍याहा कोयो तेहेंज कोइत कोयो. ताहां तिये कोयो, ‘आंय नाहां जातू बा’ पोन तो सेलवाआ मोन वालित कोइत गोयू. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />यां बेनुमेहें रोत कोडे बाह्हाआ इश्शा पुरी कोअयी?”</para>
  <para style="p" vid="MAT 21:31">तियां कोयो, “हानीइले पोर्‍ये.”</para>
  <para style="p" vid="MAT 21:31">ताहां ईसु तियांहां कोयो, “आंय तुमुहूं कोहो के, फालू लेनारे आन रांडे देवोअ राजोमेहें तुमारोत आगाड़ी जातेहे. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" /><note caller="+" style="x"><char style="xo" closed="false">21:32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">लुक 3:12</ref>; <ref loc="LUK 7:29-30">7:29-30</ref></char></note> काहाके योहान धर्मीइ वाट देखाड़तुज तुमाआं जागे आयू, आन तुमू तियापोअ विश्वास ने कोअयू; पोन नाकेदारों आन रांडे यां तियापोअ विश्वास कोअयू. तुमू ओं देख्यो तेबी तुमाआं मोन वालित तियापोअ भरिवसू ने कोअयू.”<verse eid="MAT 21:32" /></para>
  <para style="s">मोलाम काम कोअनारा जागल्याआं काईं</para>
  <para style="r">(<ref loc="MRK 12:1-12">मार्क 12:1-12</ref>; <ref loc="LUK 20:9-19">लुक 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />
    <note caller="+" style="x">
      <char style="xo" closed="false">21:33 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:1-2">यश 5:1-2</ref> </char>
    </note> ईसु कोयो, “फाशीइ एक बिहीरी काईं उनाइत ल्या, एक माहुंउं ओतो तिये दाराक्शाआ मोलू लागाड़्यु. तियाआ सोमकीर वाड़ बांद्यी, तियाआ मांयते दाराक्शाआ रोहोअ काजे कुंडे बोणाये, आन राखीत बोहीइलाआ काजे मालू बोणायू. आन जागल्याहां होपी देत तो परदेसोमेहें जातु रोयू. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />जाहां दाराक्शे तोडीइलोअ वेल आयी, ताहां तियाआ पावरोहो तियाआ मोलाअ राखवाली जागल्याआं जागे फल आना मोकल्या. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />पोन जागल्यां तियां पावरोहो तोइत कोइत, कोडाहा मार देदू, आन कोडाहा माइत टाक्या, एखाहा का डोणाट्या. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />फाशाआ तिये पेलरोत वादार पावर मोकल्या, आन तियांअरी बी तियां तेहेंज कोइत कोअयो. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />सेलेसेलवाआ तिये तियाआ पोर्‍याहा तियांआं जागे एहेलुहू विसार कोइत मोकल्यू के, ‘ते माआं पोर्‍याआ तेबी मानपान कोए.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />पोन जागल्यां तिया पोर्‍याहा देखीत कोयो, ‘ओ ते मालख्योअ पोर्‍यू होये, आवा, याहा माईंत टाकता आन याआ जागू लेत लेता.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />ताहां तियां तियाहा तोअयु आन दाराक्शाआ मोलामेहें रोत बाअथे काडीत माईंत टाक्यु.” <figure style="fig" alt="Watchtower in a vineyard" file="HK00105C.TIF" size="col" copy="Horace Knowles ©" ref="21:33">दाराक्शाआ मोलु राखीइलाआ मालु</figure><verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />ताहरोअ ईसु फुशो, “जाहां दाराक्शाआ मोलाआ मालिख आवे, ताहां तियां जागल्यांअरी कि कोए?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />तियां तियांहां कोयो, “तो तियां खाराब जागल्याहां माअतीज टाके; आन दाराक्शाआ मोलाआ ठेकू बिहीरा जागल्याहां आपी देय, जे वेलेपोअ तियाहा पाक आप्या कोए.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />ईसु तियांहां कोयो, “केहें तुमू देवोअ वसनोमेहें ओं केदिहींज नाहां वाश्यो के?</para>
  <para style="q1" vid="MAT 21:42">“‘जिया डोणोहो राजमिस्तर्‍यां बिगरकामोंअ ठरव्यू,</para>
  <para style="q2" vid="MAT 21:42">तोज कोपराआ डोण ओत गोयू?<note caller="+" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="ACT 4:11">प्रेशित 4:11</ref>; <ref loc="1PE 2:7">1 पेत्र 2:7</ref> </char></note></para>
  <para style="q1" vid="MAT 21:42">ओं प्रभुउ वोगेहे रोत ओवो,</para>
  <para style="q2" vid="MAT 21:42">आन आमाआं नजरेमेहें बोगलाय एहलोहो होय.’<note caller="+" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">भजन 118:22-23</ref></char></note><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“याआ काजे आंय तुमुहूं कोहो के, देवोअ राज तुमापोअ रोत मागीत लेय आन एहेला माअहुंहूं आपी देये, जें तियाहा फल आपित सेके. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" /><note caller="+" style="f"><char style="fr" closed="false">21:44 </char><char style="ft" closed="false">थोड़हा लेख्यामेहें ओं वसन नाहां जोड़तो</char></note>जो कोडो याआ डोणोपोअ पोड़े, तियाआ पुकरान पुकरा ओत जाय; आन जियापोअ ओ डोण पोड़े, तियाहा तो पिइड़ीत टाके.<note caller="+" style="x"><char style="xo" closed="false">21:44 </char><char style="xt" closed="false"><ref loc="LUK 2:34">लुक 2:34</ref></char></note>”<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />मुख्य पुंजारा आन फरिसी तियाआ काईं उनाइत समजीत गोया के तो तियांआं बाप्तिमेहें कोहे. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />ताहां तियाअ ईसुहू तोइलोअ कोशित ओती. पोने ते माअहुंहूं बिया, काहाके तें तियाहा देवोअ जागेहे रोत आवनारु भविश्यवक्ता मानतेते.<note caller="+" style="x"><char style="xo" closed="false">21:46 </char><char style="xt" closed="false"><ref loc="MAT 21:11">मत्तय 21:11</ref>; <ref loc="LUK 7:16">लुक 7:16</ref>; <ref loc="JHN 7:40">योहान 7:40</ref> </char></note><verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">वेहेवालोअ पांगातीइ काईं</para>
  <para style="r">(<ref loc="LUK 14:15-24">लुक 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />फाशुउ ईसु माअहोंअरी काईं वाअहीं गोठी कोउ वोल्यू. <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“होरगाआ राज तिया राजाआ होस होये, जिये तियाआ पोर्‍याआ वेहेवालोअ रोटू खावाड़्यू. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />आन तिये जियांहां वेहेवालोअ नेवतो आप्यो, तियांहां हादे तेहें काजे तियाआ पावरोहो मोकल्या; पोन तियां माअहूं तो नेवतो ने स्विकार कोअयो. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />ताहां तिये तियाआ पावरोहो ओं कोत कोइत मोकल्या, नेवतो आपल्या माअहुंहूं कोवा: ‘पाला, आंय पांगात तियार कोइ देदीही, माआं पाल्ल्या गोदा आन पाल्ल्ये जनवारे माइत कोइत आखो तियार होये; वेहेवालोअ पांगातीमेहें आवा.’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />पोन नेवतो आपल्या माअहूं दिहान ने देदो, आन तें जिव जिवोअ कामे जाते रोये: एखु खेतोमेहें जातु रोयू, ते एखु तियाआ धंदापोअ जातु रोयू, <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />बिहीरा माटी तियां बाकी पावरोहो तोइत अपमान कोअयू आन माईंत टाक्या. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />ताहां राजाहा जाअखीलिही खोत लागी, आन तिये तियाआ सेयनिकोहों मोकलीत तियां माअनाराहां आरवीत टाक्या, आन तियांआं होयरोहो आग लागाड़ी देदी. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />ताहां तिये तियाआ पावरोहों कोयो, ‘वेहेवालोअ पांगात तोम तियार होय, पोन हादल्ये माअहें लायक ने ओते. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />तिहीं वाअहीं तुमू वोडी सड़केपोअ जात कोइत, जें तुमुहूं जोड़े तियां आखाहा वेहेवालोअ पांगातीमेहें लेतावा.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />ताहां ते पावर सडके पोअ जात कोइत हाजे-बाक्ते जेतेहे बी मिल्ये, तेतां आखाहा एकठे कोअये; आन वेहेवालोअ तोंबू माअहूं वाअहीं पोआत गोयू.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />“जाहां राजा पावणाहां मिलू मांयते आयू, ताहां तिये तिहीं एका माहुंहूं देख्यो, जो वेहेवालोअ आंगड़े ने पेवयेते. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />राजा तियाहा फुशो, ‘ए दोस्ता; तू वेहेवालोअ आंगड़े बिगर पोवयेज इंहीं केहें आयू?’ ताहां तियाहा किज उत्तर ने आपाअयो. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" /><note caller="+" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">मत्तय 8:12</ref>; <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">लुक 13:28</ref></char></note> ताहां राजा तियां पावरोहों कोयो, ‘याआ आथेन गुडा बांदीत बाअथे आंदारामेहें टाकी द्या, तिहीं रोड़ीइलोन दात कोकराविलोअ रोय.’”<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />ईसु कोयो, “हादल्ये ते जाअखीलेहे होये, पोन निवड़ीइल्ये थोड़े होय.”<verse eid="MAT 22:14" /></para>
  <para style="s">कैसरोहो कर आपिइलोअ बाप्तिम प्रश्न</para>
  <para style="r">(<ref loc="MRK 12:13-17">मार्क 12:13-17</ref>; <ref loc="LUK 20:20-26">लुक 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />ताहां फरिसी जात कोइत तियां तियांज विसार कोआ वोल्या, के केहें कोइत तियाहा प्रश्नामेहें फसाड़ीत सेके. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />ताहां ते तियांआं थोड़ाक सेलाहां आन हेरोदोअ पार्ठीइ थोड़ाक जोओंहों ओं कोअलो काजे मोकल्या, “गुरु आमू जांअताहां के तू खोरु होय, आन देवोअ वाट हाजी हुतायी सिकाड़ेहे, आन कोडाआ भेदभाव नाहां कोअतू, काहाके तू माअहुंउं सोब पालीत गोठी नाहां कोअतू. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />तियाहा काजे आमुहूं को के ताआ विसार कि होये? आपाआ कायदाआ पुरमाणे कैसरोहो कर आपिइलोअ हाजो होय के नाहां?”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />ईसु तियांआं ए खाराब उद्देश जाइंत कोयो, “ए ढोंगी! माहूं काहा पारजाणताहा? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />कर पोइलोअ आनो माहूं देखाड़ा.”</para>
  <para style="p" vid="MAT 22:19">ताहां ते एक आनो लेत आयान तियाहा देखाड़्यो.<verse eid="MAT 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 22:20" />आन तिये तियांहां फुशो, “यापोअ ओ कोडाआ साप आन नाव होये?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />ताहां तियां कोयो “कैसरोअ.” ताहां तिये तियांहां कोयो, “जों कैसरोअ होय तों कैसरोहो; आन जों देवोअ होय, तों देवोहो आपा.”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />जाहां ते ओं उनाअया ताहां पोंगलाईत गोया; आन तियाहा सोड़ीत जाता रोया.<verse eid="MAT 22:22" /></para>
  <para style="s">मोतोमेहें रोत जिवीत उठिइलाअ बाप्तिमेहें प्रश्न</para>
  <para style="r">(<ref loc="MRK 12:18-27">मार्क 12:18-27</ref>; <ref loc="LUK 20:27-40">लुक 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:23 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">प्रेशित 23:8</ref> </char>
    </note> तिये दिहे सादूकी आवित कोना वोल्या के मोतोमेहें रोत फाशोअ जिवीत उठीइलोअ एहेलोह होयज नाहां, आन तियाआ जागे आवित फुशो, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" /><note caller="+" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="DEU 25:5-6">कायदा 25:5-6</ref> </char></note>“ए गुरु, मोशे कोयोतो के जर कोडो बिगर पोर्‍याआ मोइत जाये, ते तियाआ पाही तियाआ लाडीइरी वेहवाल कोइत तियाआ पायहोअ काजे वंश उब्जाड़े. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />ओमे आमाआं हांत पाही ओता; पेल्लूउ पाही वेहवाल कोइत मोइत गोयू, आन पोर्‍ये ने ओवये तियाहा काजे तियाआ लाडी तियाआ पायहोअ काजे सोड़ीत गोयू. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />एहेंज कोइत दुसरे आन तिसरे बी कोअयो, आन सांतू जोओंअ ओंज ओवो. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />सेली सेलवाआ ते बाय बी मोइत गोयी. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />ओमे जिवीत उठे ताहां तियां सांतूमेहें रोत ते कोडाआ लाडी बोणे? काहाके ते आखाआ लाडी बोण्यीते.”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />ईसु तियांहां उत्तर आप्यो, “तुमू वसन आन देवोअ ताकत नाहां जांअता; तिहीं वाअहीं तुमू केताहा सुकिम पोड़्याहा! <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />काहाके मोल्ये जिवीत उठे, ताहां तें होरगामेर्‍याआ देवदुतोंअ होस रोये आन तें ने वेहवाल कोए. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />पोन, मोल्याआं जिवीत उठीइलोअ बाप्तिमेहें केहें तुमू ओं वसन नाहां वाश्यो के जो देव तुमुहूं कोयो: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" /><note caller="+" style="x"><char style="xo" closed="false">22:32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">निर्ग 3:6</ref>,<ref loc="EXO 3:16">16</ref> </char></note> ‘आंय अब्राहामोअ देव, इसहाकोअ देव, आन याकोबोअ देव होय, तो जिवताआं देव होय मोल्याआं नाहां.’” <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />जेहेलाम ओं उनाअये ताहां माअहें तियाआ हिकवोणो वाअहीं बोगलाइत गोये.<verse eid="MAT 22:33" /></para>
  <para style="s">आखा रोत वोडू आदेश</para>
  <para style="r">(<ref loc="MRK 12:28-34">मार्क 12:28-34</ref>; <ref loc="LUK 10:25-28">लुक 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />जाहां फरिसी उनाअया के ईसु सादूकीइ सोब बोंद कोअयी, ताहां ते एकठा ओवा, <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />आन तियांमेहें रोत एक जोऊं जो कायदाआ हिकवणेएं मास्तर ओतू, तिये तियाहा फारकीइलोअ काजे तियाहा फुशो, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“मास्तर, कायदामेहें कोड्लू आदेश वोडू होये?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:37 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:5">कायदा 6:5</ref> </char>
    </note>ईसु उत्तर आप्यो, “‘तू ताआ प्रभु देव यापोअ पुरा मोनोवाअहीं, पुरा जिवोवाअहीं, पुरी ओकले वाअहीं मेर कोओ,’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />ओज वोडू आन मुख्य आदेश होये. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" /><note caller="+" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लेवी 19:18</ref> </char></note>आन याआज होस ओ बिहीरु बी होय के, ‘तू ताआ जागेवाला पोअ ताआज होस मेर कोअ.’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />एज बेनू आदेश मोशेए कायदाआ आन भविश्यवक्ताआं शिक्शणोअ आधार होय.”<verse eid="MAT 22:40" /></para>
  <para style="s">मसीहाआ बाप्तिम प्रश्न</para>
  <para style="r">(<ref loc="MRK 12:35-37">मार्क 12:35-37</ref>; <ref loc="LUK 20:41-44">लुक 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />जाहां फरिसी टोलू वोलीत रोयाते, तेहेलाम ईसु तियांहां फुशो,<verse eid="MAT 22:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 22:42" />“मसीहाआ बाप्तिमेहें तुमू कि विसार कोअताहा? तो कोडाआ पोर्‍यू होये?” तियां तियाहा कोयो, “दाविदोअ.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />ईसु तियांहां फुशो, “ताहां दाविद आत्मामेहें आवित तियाहा ‘प्रभु’ काहा कोहे?<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:44 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 110:1">भजन 110:1</ref> </char>
    </note> “प्रभु माआं प्रभुहू कोयो:</para>
  <para style="q2" vid="MAT 22:44">‘जाअहूं जाआं आंय ताआ दुस्मोनोहों ताआ गुडाआ थुड़ी ने टाकी देंव</para>
  <para style="q2" vid="MAT 22:44">ताअहूं जाआं माआं हाजाड़ीइ वोगेहे बोहो.’<verse eid="MAT 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />“ताहां, दाविद मसीहाहा ‘प्रभु,’ कोहे, ताहां तो तियाआ पोर्‍यू केहें कोइत बोण्यु?”<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />ईसुउ उत्तरोम तेदिहीं रोत कोडाहा बी तियाहा प्रश्न फुसीइलोअ हिम्मत ने ओवी.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">कायदाआ मास्तर आन फरिसी यां रोत जाबालीत रोवा</para>
  <para style="r">(<ref loc="MRK 12:38-39">मार्क 12:38-39</ref>; <ref loc="LUK 11:43-46">लुक 11:43-46</ref>; <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />फाशुउ ईसु माअहोंहों आन तियाआ सेलाहां कोयो. <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“कायदाआ मास्तर आन फरिसी मोशेए गादीपोअ बोठाहा; <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />तियाहा काजे ते तुमुहूं जों किबी कोय, तों मानजा आन कोअजा, पोन तियांआं होस कामे मा कोअहा; काहाके ते कोताहा खोरा, पोन नाहां कोअता. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />ते जियाहा उसलीइलोअ बी कठीण होय, एहेलाहा पाअया वोजाहा बांदीत माअहोंअ खांदोपोअ मिकी देताहा; पोन ते तियांहां आंगी वाअहीं जाआं आधार नाहां देता. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />ते तियांआं कामे माअहोंहों देखाड़ीलोअ काजे कोअताहा: ते तियांआं आथोमेर्‍येए वसन लेखल्ये पत्रे पोले कोअताहा, आन तियांआं साअकाआ कोरी नांबी कोअताहा. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />पांगातीमेहें मुख्य मुख्य जागा, आन आराधनालयोमेहें मुख्य मुख्य जागा तियांहां गोमताहा. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />बाजारोमेहें ‘सलाम,’ आन माअहोंमेहें ‘मास्तर’ कोवड़ाइलोअ तियांहां हाजो लागेहे. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />पोन तुमू ‘मास्तर’ मा कोवड़ाअहा. काहाके तुमू पाव्हीइले होय आन तुमा आखाआ एकुज मास्तर होये. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />आन यी धरती पोअ तुमू कोडाहा ‘बा,’ एहें मा कोहा, काहाके तुमाआं होरगामेहें एकुज आब्हू होये. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />आन मालक बी मा कोवड़ाअहा काहाके तुमाआं आखाआ ख्रिस्त ओ एकुज मालक होय. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />जों कोडो तुमामेहें वोडो होय, तो तुमाआं सेवक बोणे. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />जों कोडो सोताहा वोडो माने, तों हानो बोणे आन जों कोडो सोताहा हानो बोणावेहे, तों वोडो बोणे.”<verse eid="MAT 23:12" /></para>
  <para style="s">कायदाअ मास्तर आन फरिसीइ ढोंगड़ायीइ शिक्शा</para>
  <para style="r">(<ref loc="MRK 12:40">मार्क 12:40</ref>; <ref loc="LUK 11:39-42">लुक 11:39-42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“ए वोडार्‍या! कायदाअ मास्तर आन फरिसी, तुमाआं कि हाल ओवे! तुमू माअहों विरुध्दामेहें होरगाआ राजोअ बाएं बोंद कोअताहा, आन नेते तुमू तियामेहें फोहताहा के ने तियामेहें फोहनाराहां फोहुंहूं देताहा. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />ए वोडार्‍या! कायदाअ मास्तर आन फरिसी, तुमाआं कि हाल ओवे! तुमू रोंडाअली बोईंइ कोओहो खात जाताहा, आन देखाड़ीलोअ काजे जाअखीलिही वाआ जाआं प्रार्थना कोअता रोताहा: तियाहा काजे तुमुहूं वादार डोंड जोड़े.<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">ओं वसन थोड़ाक जुना लेख्यामेहें नाहां जोड़तो</char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />“ए कायदाअ मास्तर आन फरिसी, तुमाआं कि हाल ओवे, तुमू ढोंगी! तुमू एका जोओंहों तुमाआं वोगेहे वालीइलोअ काजे आखा दोर्‍या आन देसोमेहें फिरताहा;आन जाहां तो तुमाआं वोल आवित जाहे, ताहां तियाहा तुमा रोत बेन वाटा नरकाआ भागिदार बोणावी देताहा!<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />“ए आंदला पुढार्‍यों, तुमाआं कि हाल ओवे! तुमू सिकाड़ताहा के, ‘जर एकदो मंदिरोअ शप्पत खाय ते किज ने, पोन जर मंदिरोअ होनाअ शप्पत खाय ताहां तों बांदाइत जाय.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />ए फोगा आन आंदलां! की वोडो होय, होनो के मंदिर, जों होनाहा पवित्र बोणावेहे? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />तुमू बी सिकाड़ताहा, ‘जर एकदो देवान्‍याआ शप्पत खाय ते कीज ने, पोन जे भेट देवान्यापोअ होय, जर एकदो तियाआ शप्पत खाय ते तो बांदाइत जाय.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />ए आंदलां! की वोडो होय, भेट के देवान्यो जियापोअ भेट पवित्र ओवेहे? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />तियाहा काजे जों देवान्याअ शप्पत खाहे ताहां तों तियाआ, आन जो किबी तियापोअ होय, तियाआ बी शप्पत खाहे. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />आन जों मंदिरोअ शप्पत खाहे, तों तियाआ आन तियामेहें रोनाराआ देवोअ बी तो शप्पत खाहे. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" /><note caller="+" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">यश 66:1</ref>; <ref loc="MAT 5:34">मत्तय 5:34</ref></char></note> आन जो होरगाआ शप्पत खाहे, तो देवोअ राजगादीइ आन तियी पोअ बोहनाराअ बी शप्पत खाहे.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />“ए ढोंगी कायदाआ मास्तर आन फरिसी, तुमाआं जुदी विते! तुमू पुदिना, वरालो, जिरो याआं दाहवू भाग ते आपताहा, पोन तुमू नियमोअ महत्वाआ गोठी मोन्ज्ये: न्याय, दया, विश्वास ए गोठी तुमू सोड़ी देताहा; तुमू ए गोठी बी मानता आन ते गोठी बी ने सोड़ता ताहां हाजो आवतो.<note caller="+" style="x"><char style="xo" closed="false">23:23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">लेवी 27:30</ref></char></note> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />ए आंदला पुढार्‍यों, तुमू सिमणाहां ते टाली देताहा, पोन उटड़ाहा गिइंत लेताहा!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“ए ढोंगी कायदाआ मास्तर आन फरिसी, तुमाआं कि हाल ओवे! तुमू वाटकी आन ठाली उपोअ उपोअ ते उजालताहा, पोन ते मांयते हिंसा, आन स्वार्थाम पोआले होये. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />ए आंदला फरिसी, पेल वाटकी आन ठालीही मायतेए वोगेहे रोत उजाल, ताहांज ते बाअथे बी खोरो उजलीइल्यो रोय!<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />“ए वोडार्‍या कायदाअ मास्तर आन फरिसी, तुमाआं कि हाल ओवे! तुमू रंग लागाड़ल्यी कबरेए होस होय जो उपोअ रोत ते हाजो बी देखाअहे, पोन मांयते ते मोल्या माअहोंअ आटके आन आखी जातीइ घाणी वाअहीं पोआली होय. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />एहेंज कोइत तुमू बी उपोअ रोत धर्मी देखाअताहा, पोन मांयते ढोंगड़ाय आन खाराबी वाअहीं पोआइत रोयाहा.”<verse eid="MAT 23:28" /></para>
  <para style="s">फरिसीहीं डोंड</para>
  <para style="r">(<ref loc="LUK 11:47-51">लुक 11:47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“ए वोडार्‍या कायदाअ मास्तर आन फरिसी, तुमाआं कि दशा ओवे! तुमू भविश्यवक्ताआ कबर होबाड़ताहा आन धर्मीइ कबर बोणावताहा. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />आन कोताहा के, ‘जर आमू आपाआ डायहांअ दिहोमेहें रोता, ताहां ते भविश्यवक्ताआं खुनोमेहें भागिदार ने बोणता.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />पोन जियां भविश्यवक्ताहां माअया, तियां खुनीइं तुमू पोर्‍या होये, एहेलिही तुमू सोताहा साक्शी आपताहा. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />ताहां, जावा, आन तुमाआं डायहां सुरवात कोअल्यो आरदो पापोअ कुंडो पुरो पोई द्या! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" /><note caller="+" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्तय 3:7</ref>; <ref loc="MAT 12:34">12:34</ref>; <ref loc="LUK 3:7">लुक 3:7</ref></char></note> ए हापों, आन हापोंअ पिलां! तुमू नरकाआ डोंडोम रोत कि कोइत वासाअहा? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />तिहींवाअहीं पाला, आंय तुमाआं जागे भविश्यवक्ता, हुशार माट्योहों, मास्तरोंहों नेहें मोकलोहो; आन तुमू तिहींमेएं थोड़ाक जोओंहों माइत टाकहा, आन क्रुस खांबोपोअ टांगहा; आन थोड़हाहा तुमाआं आराधनालयोमेहें सापका देहा, आन एका होयरोमेहें रोत एका होयरोम ओड़ताज फिरहा. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" /><note caller="+" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="GEN 4:8">उत्प 4:8</ref>; <ref loc="2CH 24:20-21">2 इति 24:20-21</ref></char></note> या वाअहीं धर्मी हाबेलो रोत ते बिरीकियाआ पोर्‍यू जखर्‍याआ जाआं, जियाहा तुमू मंदिर आन देवान्याअ विसमेहें माईंत टाक्यु, जेता बी धर्मी माट्योंअ रक्त धरतीपोअ वोहाड़्योय, तियां आखाआ खुनोअ पापोअ डोंड तुमाआं मुंडी पोअ आवित पोड़े. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />आंय तुमुहूं खोरो कोहो, के यां आखा खुनोअ डोंड यी पिढ़ी पोअ आवित पोड़े!<verse eid="MAT 23:36" /></para>
  <para style="s">ईसुउ येरुसालेमोअ काजे मेर</para>
  <para style="r">(<ref loc="LUK 13:34-35">लुक 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“ए येरुसालेम, ए येरुसालेम! तू जो भविश्यवक्ताहां माइत टाकेहे आन जियांहां ताआ जागे खबर्‍या मोकल्या तियांहां डोणाटेहे! केताहा तेबी वाआ माआं इश्शा ओवी के जेहलीही कुकड़ी तियीइ पिलाहां तियीइ फाकड़ाआं थुड़ी एकठे कोअहे, तेहेंज कोइत आंय बी ताआ पोर्‍याहा एकठे कोइत लेंव, पोन ताहूं ने गोम्यो. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />पाला, ओमे तुमाआं मंदिर उजाड़्यो पोड़े. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />काहाके आंय तुमुहूं कोहो, के ओमे रोत जाअहूं जाआं तुमू ने कोहा, ‘आशिर्वादीत होय तो, जो प्रभुउ नाव से आवेहे’ ताअहूं जाआं तुमू माहूं फाशेए केदिहींज ने देखहा.”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">मंदिर आरवाइलोअ ईसुउ भविश्यवाणी</para>
  <para style="r">(<ref loc="MRK 13:1-2">मार्क 13:1-2</ref>; <ref loc="LUK 21:5-6">लुक 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />जाहां ईसु मंदिरोमेहें रोत निहीत जानु वोल्यू, ताहां तियाआ सेला तियाआ जागे तियाहा मंदिरोअ बोणावट देखाड़ीलोअ काजे आया. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />तिये तियांहां कोयो के, “तुमू आखा ओं देखताहा ना? आंय तुमुहूं नक्की कोहो, इंहीं ने खोदलाय एहेलुहू डोणोपोअ डोण बी ने रोय.”<verse eid="MAT 24:2" /></para>
  <para style="s">अड़सन आन सताव</para>
  <para style="r">(<ref loc="MRK 13:3-13">मार्क 13:3-13</ref>; <ref loc="LUK 21:7-19">लुक 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />आन जाहां ईसु जेयतुन डोगोपोअ बोठू, ताहां सेला आंगेज आवित कोयो, “आमुहूं को के ए गोठी कोयों ओवे? आन ताआ आविइलोअ, आन दुन्याआ आरवाइलोअ की निशाणी रोये?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />ईसु तियांहां उत्तर आप्यो, “हेएजा! कोडो बी तुमुहूं ने ठोगुहूं जोवे. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />काहाके वारुज एहलेहे माआं नाव से आवित कोये, ‘आंय ख्रिस्त होय,’ आन वारुज जोओंहों ठोगी देये. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />तुमू लढाय आन लढायीइ सर्सा उनाअहा; पाला, काबराइत मा जाहा; काहाके ओं ओवनारोजे. पोन तियी वेले सेवट ने ओवे. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />काहाके जाती पोअ जाती, आन राज्यापोअ राज्यो लढाय कोए, आन जागे जागे काल पोड़े, आन धरती आले. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />ए आखी गोठी ठाल्ले पोड़ीइलोअ पेल्ले वेणे जेहें होय.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">24:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:22">मत्तय 10:22</ref>
      </char>
    </note> “ताहां तुमुहूं दुख देअलोअ काजे तोइत आपे, आन माइत टाके आन माआं नावोअ वाखरी आखी जातीइ माअहें माआं वाखरी तुमाआं सीस कोए. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />तेहेलाम वारुज जोएं तियांआं विश्वास सोड़ी देये, आन एकान बिहीराहा तोइत आपेन, एकान बिहीराआ सीस कोए. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />ताहां वारुज ठोग भविश्यवक्ता देखाय आन वारुज माअहोंहों ठोगी देये. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />आन पाप वादीत जाय तिहीं वाअहीं वारुज जोंओंअ मेर हेली पोड़ीत जाये. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />पोन जो आखरी जाआं धिर खेटीत रोय, तोज वासाय. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />आन राज्याआ ए हाजी बातमी आखा देसोमेहें साक्शी ओवे तेहें काजे आखा दुन्यामेहें परसार ओवे, ताहां सेवट ओत जाय.<verse eid="MAT 24:14" /></para>
  <para style="s">वोडी आफतोअ सुरवात</para>
  <para style="r">(<ref loc="MRK 13:14-23">मार्क 13:14-23</ref>; <ref loc="LUK 21:20-24">लुक 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“तिहीं वाअहीं जेहेलाम तुमू तियी उजाड़नारी सिसड़ाअली वस्तुहू पवित्र जागामेहें उबी रोल्यी देखहा. जियीइ बाप्तिम दानियेल भविश्यवक्ताआ पुस्तकोमेहें कोयोहो<note caller="+" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दानि 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char></note> वासनारो समजीत लेअहूं जोवे. <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />ताहां जो कोडो यहुदीयामेहें ओय तो डोगोमेहें गुगदो वोलुहूं जोवे. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />जो कोओपोअ ओय, तों तियाआ कोओमेर्‍योअ सामान आनो निसे ने उतरुहूं जोवे. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />आन जों खेतोमेहें ओय, तों तियाआ कोट आनो वापिस फिरीत ने आवुहूं जोवे. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />तियां दिहोमेहें जे बोईं पोटाअरी आन हाना पोर्‍याहा बुजी खावाड़तीये तियींइं की हाल ओवे! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />देवोहो प्रार्थना कोआ; के तुमुहूं हियालामेहें नेत आरामोअ दिहोअ दिही गुगदीइलो ने आवे. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />काहाके तियी वेले एहेलिही कठीण आफत पोड़े, जे दुन्याआ सुरुवातिही रोत ओमे जांआं नाहां पोड़्यी, आन ने केदिहीं पोड़े.<note caller="+" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="EZK 5:9">यहे 5:9</ref>; <ref loc="DAN 12:1">दानि 12:1</ref>; <ref loc="REV 7:14">प्रगटी 7:14</ref></char></note> <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />आन ते दिही जर कमी ने कोआता, ताहां कोडोज ने वासाअतो; पोन निवड़ीइल्या माअहोंअ काजे ते दिही देव कमी कोई देये.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />“तियी वेले जर एकदो तुमुहूं कोये के, ‘पाला, ख्रिस्त इंहीं होये!’ नेत ‘तिहीं होय!’ ताहां भरिवसू मा कोअहा.<note caller="+" style="x"><char style="xo" closed="false">24:23 </char><char style="xt" closed="false"><ref loc="LUK 17:23">लुक 17:23</ref>; <ref loc="LUK 21:8">21:8</ref></char></note> <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />काहाके ख्रिस्तविरोधी आन ठोग भविश्यवक्ता उठीत उबा रोये, आन वोडी निशाणी आन वोडे कामे देखाड़े, के जर ओत सेके ते निवड़ीइल्याहां बी ठोगी देये. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />उनाआ! आंय तुमुहूं पेलरोतुज ओं आखो कोत देदोहो.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />“तियाहा काजे जर ते तुमुहूं कोय, ‘पाल, तो जंगलोमेहें होय,’ ताहां तिहीं मा जाहा; आन ते कोय, ‘पाला, मांयते खुलीमेहें होय,’ तेबी भरिवसू मा कोअहा. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />काहाके जेहेंकोइत दिही उगताआ वोगेहे निहीत कोइत दिही बुडताआ वोगेहे विज विजलीइतीज जाहे, तेहेंज कोइत माहुंउं बेटाह्हाआ बी आविइलोअ आवे.<verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />“जिहीं मोल्यो तोड़ रोय, तिहीं डिगरावा टोलू वोले.<verse eid="MAT 24:28" /></para>
  <para style="s">माहुंउं बेटाह्हाअ वापिस आविइलोअ</para>
  <para style="r">(<ref loc="MRK 13:24-27">मार्क 13:24-27</ref>; <ref loc="LUK 21:25-28">लुक 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“तियां दिहोमेर्‍याआ तारासोअ फाटी ताबुड़ दिही कालू ओत जाय, आन सांदोअ उजालो जातो रोय, आन तारा जुगोमेहें रोत टुटीत पोड़े आन जुगोमेर्‍यीइ आखी ताकत तियीइ जागे रोत आलित जाय. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />आन तियी वेले माअहुंउं बेट्टाहाआ निशाणी जुगोम देखाय; आन ताहां धरतीइ आखे माअहें रोड़े; जेहलामेहें तें माहुंउं बेटाह्हाहा जुगोमेर्‍याआ वाद्ला पोअ वोडी सेक्ती आन ताकते वाअहीं आवत्लाहा देखे. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />आन तुरीइ वोडू आवाज आवे, तेहेलाम तो तियाआ देवदुतोहों मोकले, आन ते जुगोअ एका खुणामेहें रोत ते बिहीरा खुणाम जाआं तियाआ निवड़ीइल्या माअहोंहों टोलू कोए.<verse eid="MAT 24:31" /></para>
  <para style="s">अंजिरोअ साड़ोप रोत हिकवोण</para>
  <para style="r">(<ref loc="MRK 13:28-31">मार्क 13:28-31</ref>; <ref loc="LUK 21:29">लुक 21:29</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“अंजिर साड़ोप रोत ए गोठ सिकाआ: जाहां तियाआ डालीइ डिरा फुटताहा आन पाने वोअलीतेहे, ताहां तुमू जाइंत लेतेहे, के उनालू आहने होय. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />एहेंज कोइत, जाहां तुमू ए आखी गोठी पालहा, ताहां ओं जांअजा, के वेल आहने होय, निस्ती बाअपुरेज होय. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />आंय तुमुहूं नक्की कोहो, के जाअहूं जाआं ए आखी गोठी पुरी ने ओत जाय, ताअहूं जाआं ए पिड़ी ने सेलाय. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />जुगेन धरती आरवात जाय, पोन माआं वसने केदीहींज ने आरवाय.<verse eid="MAT 24:35" /></para>
  <para style="s">कोडाहाज तियी वेलेए आन दिहोअ बाप्तिम कायने मुंदू</para>
  <para style="r">(<ref loc="MRK 13:32-37">मार्क 13:32-37</ref>; <ref loc="LUK 17:26-30">लुक 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“कोडाहाज तियी वेलेए आन दिहोअ बाप्तिम नाहां मुंदू, नेत होरगाआ दुतोहो, आन नेत बेटाह्हाहा, पोन निस्तो बाह्हाहा एतोज मुंदू होये. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />जेहेलाहा नोहाअ दिही ओता, तेहेंज कोइत माहुंउं बेटाह्हाआ बी आविइलोअ ओवे. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />काहाके जेहेलाम रेल आवल्यी तिया गालाहा माअहें खातेतेन-पितेते, आन तियांमेहें वेहेवाले बी ओवतेते. जाअहूं जाआं नोहू जाहाजीम ने सोढ़्यू, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />आन एक्काइजे रेल आवित कोइत तियां आखाहा वोहाड़ीत लेत ने गोयी, ताअहूं जाआं तियांहां किज मुंदू ने गोयू; तेहेंज माहुंउं बेटाह्हाआ बी आविइलोअ आवे. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />तियी वेले बेन जोएं खेतोमेहें रोय, एक विसाइत जाय आन बिहीरो रोत जाय. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />बेन बाय कोअटी ओड्या कोए, तिहींमेएं एक विसाइत जाय आन बिहीरी रोत जाय. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />तियाहा काजे जागते रोवा, काहाके तुमू नाहां जांअते के तुमाआं प्रभु कोड्ले दिहे आवे. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />पोन ओं जाईंत ल्या के जर कोअ धोणी ओं जांअतू के बांड केती वेले आवे, ताहां तो जागतू रोतू; आन तियाआ कोअमेहें सोरी ने ओवहूं देतू.<note caller="+" style="x"><char style="xo" closed="false">24:43 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">लुक 12:39-40</ref></char></note> <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />तियाहा काजे तुमू बी तियार रोवा, काहाके जियी वेलेए बाप्तिम तुमू विसार बी नाहां कोअते, तियी वेले माहुंउं बेटुह्हू आवित लागे.<verse eid="MAT 24:44" /></para>
  <para style="s">इमानदार सेवक आन खाराब सेवक</para>
  <para style="r">(<ref loc="LUK 12:41-48">लुक 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“ताहां इमानदार आन हुशार सेवक कोडो होय, जियाहा मालख्ये तियाआ नौकरों-साकर्‍या पोअ मुकड़दम ठरव्यू, के वेलेपोअ तियांहां रोटू आपे. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />हाजू होय तो सेवक, जियाहा तियाआ मालिख आवित एहेलोह कोअत्लाहा देखे. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />आंय तुमुहूं नक्की कोहो; मालिख तिया सेवकोहो तियाआ आखा मालधनोपोअ आधिकारी ठरवे. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />पोन जर तो सेवक मोनोम खाराब विसार कोऊ वोले के, माआं मालख्योहो वाआ लागेहे. <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />आन जर तो आरीइ हाती नौकरोहों देनू वोले, आन पिदाड़ोंअरी खायेन-पिये. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />ताहां तिया सेवकोअ मालिख एहेला दिहोपोअ आवे, जेहेलाम तो सेवक तियाआ वाट बी ने जोवतुये, आन एहेलिही वेले के तियाहा मुंदू बी ने ओये, <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />आन मालिख तियाहा डुनकान डुन्का कोई देय, तियाआ भाग ढोंगड़ाय कोअनाराअरी ठरवे: तिहीं रोड़ीइलोन दात कोकराविलोअ रोय.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">दोहो कुवांरीइं काईं</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“ताहां होरगाआ राज तियी दोहो कुवांरी होस रोय जे तियींइं दिवा लेत वोरोहो मिली निठी. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />तियींमेएं पास जोईं फोगी आन पास जोईं हुशार ओती. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />फोगी ते तियींइं दिवा लेदा, पोन तियीं उपराव तेल आरी नाहां लेदो. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />पोन हुशार जे ओती तियीं दिवा आन उपराव तेल बी कुड्यामेहें पोइत लेदो. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />जाहां वोरोहो आविइलोअ वाआ लागी, ताहां ते आखी उंगाई वोल्यी आन हुवीत गोयी.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />“आरदी राती एहेलुहू आवाज आयू, के ‘पाला, वोर आवेहे! तियाहा मिले साला.’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />ताहां ते आखी दोहू कुवांरी पोर्‍यी उठीत तियींइं दिवा वारुहूं कोइ वोल्यी. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />आन फोगहीं हुशार जुवान्यीहीं कोयो, ‘तुमाआं तेलोमेहें रोत थोड़ोक आमुहूं बी आपा, काहाके आमाआं दिवा उलाआ वोल्याहा.’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />पोन हुशार कुवांरी उत्तर आप्यो, ‘तुमाआं आन आमाआं काजे पुरे एतोहो कायनाहां; तुमू दुकानोमेहें जात कोइत तुमाआं काजे तेल वेसातो लेत लेहा तों पुरड़े.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />ताहां ते फोगी जुवान्यी दुकानोमेहें थोड़ोक तेल वेसाती लेनी गोयी, जेहलामेहें ते जाती रोयी, तेताजमेहें वोर आवित लागू. आन जे पास जोईं तियार ओती ते तियाअरी वेहेवालोअ कोअमेहें जाती रोयी आन बाआ वालित लेदो.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />“तिहींइं फाटी ते बिहीरी जुवान्यी आवित कोनी वोल्यी, ‘मालिख, मालिख, आमाआं काजे बाआ उगाड़ी द्या.’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />वोरे उत्तर आप्यो के, ‘आंय तुमुहूं नक्की कोहो, आंय तुमुहूं ने ओलखीइत्लू.’ <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />तियाहा काजे जागते रोवा, काहाके तुमू तिया दिहोहो नाहां जांअते आन तियी वेलेहे बी नाहां जांअते.<verse eid="MAT 25:13" /></para>
  <para style="s">तीन पावरोंअ बाप्तिमेहें काईं</para>
  <para style="r">(<ref loc="LUK 19:11-27">लुक 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“तिये वेले होरगाआ राज एहेलोह रोय. एकवारी एक माटी ओतू जो परदेसोम जानारु ओतू; तिये तियाआ सेवकोहों हादीत तियाआ मालधन सांबाले तेहें काजे तियांहां होपी देदो. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />तिये एकाहा पास हाजार रुप्या, आन एकाहा बेन हाजार रुप्या, आन एकाहा एक हाजार रुप्या मोन्ज्ये हारेक जोओंहों तियां तियांआं सेक्तीइ पुरमाणे आप्यो, आन तो परदेसोमेहें निहींत पोड़्यू. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />जियाहा पास हाजार रुप्या आप्या, तिये ताअहांज जात कोइत वापारो कोअयो, आन पास हाजार रुप्या फाश्याआ बी कामावया. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />एहेंज कोइत जियाहा बेन हाजार आप्या, तिये बी बिहीरा बेन हाजार रुप्या कामावया. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />पोन जियाहा एक हाजार आप्या, तिये जात कोइत खाडू खुंउंयू, आन तियाआ मालख्योअ पोशा निकाड़ी देदा.<figure style="fig" alt="Talents" file="HK00168C.TIF" size="col" copy="Horace Knowles ©" ref="25:15">होनाआ रुप्या</figure><verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“खुब दिहोअ फासाड़ी तियां पावरोअ मालिख आवित इसाब मागू वोल्यू. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />जियाहा पास हाजार रुप्या आप्याते, तिये फाशाअ बिहीरा पास हाजार रुप्या लेतावीत कोयो, ‘मालिख, तुमे माहूं पास हाजार रुप्या आप्याते, पाल आंय पास हाजार फाशाअ बी कामावयाहा.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />तियाआ मालख्ये तियाहा कोयो, ‘शाबास, हाजा आन इमानदार सेवक, तू थोड़ी गोठीमेहें बी इमानदार रोयू, आंय ताहूं वादार मालधनोअ आधिकारी बोणाविहीं. आव आन ताआ मालख्योअ खुसीमेहें सामील ओव!’ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />आन जियाहा बेन हाजार आप्या, तिये बी आवित कोयो, ‘मालिख तुमे माहूं बेन हाजार आप्याते, पाल, बेन हाजार रुप्या फाश्याआ बी कामावयाहा.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />तियाआ मालख्ये तियाहा कोयो, ‘शाबास, हाजा आन इमानदार सेवक! तु थोड़ी गोठीमेहें बी इमानदार रोयू, आंय ताहूं वादार गोठीइ आधिकारी बोणाविहीं. आव आन ताआ मालख्योअ खुसीमेहें सामील ओव.’ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />तिहींइं फासाड़ी जियाहा एक हाजार रुप्या आप्या तिये बी आवित कोयो, ‘मालिख, माहूं मुंदू होय के तू कड़क माटी होये: तु जिहीं नाहां ठांअतू तिहीं रोत वाडेहे, आन जिहीं नाहां ओअतू तिहीं रोत हाटवेहे; <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />तियाहा काजे आंय बियू आन ताआ एक हाजार रुप्या पुंयींमेहें डाटी देदा; पाल, जो ताआ होय, तों ओं होय.’ <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />तियाआ मालख्ये उत्तर आप्यो, के ‘ए खाराब आन आलह्या सेवक, ओं ताहूं मोलोम ओतो, के जिहीं मी ने ठांअयो तिहीं रोत वाडोहो; आन जिहीं मी ने ओअयो तिहीं रोत हाटवोहो. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />ताहां तू माआं पोशा एखा हावकारोहो आपी देतू, ताहां आंय आवित माआं पोशा वियात्ताज लेत लेतू.’ <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />ओमे याआ ते हाजार रुप्या यापरोत मागित ल्या, आन जियापोअ दोहो हाजार रुप्या होय, तियाहा आपी द्या. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />काहाके जिया कोडा पोअ होय, तियाहा फाशोअ जोड़े; आन तियापोअ जाअखो ओत जाय; पोन जियापोअ कायनाहां, तियापोअ जो ओय तों बी मागीत लेवाय. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />आन या आलह्या सेवकोहो बाअथे आंदारामेहें टाकी द्या, जिहीं रोड़ीइलो आन दात कोकराविलोअ रोय.<verse eid="MAT 25:30" /></para>
  <para style="s">आखरीइ न्यायनिवाड़ु</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“जाहां माहुंउं बेटुह्हू तियाआ महिमामेहें आखा देवदुतोअरी आवे, तेहेलाम तो तियाआ महिमाआ राजगादीपोअ बोहे. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />आन आखे माअहें तियाआ सामने एकठे कोए; आन जेहलुहू डोरक्यू मेडाहां बोकड़ाम रोत आंगे कोइ देहे, तेहेंज कोइत तो तियांहां एकान बिहीरा रोत आंगे कोए. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />आन तो मेडाहां तियाआ हाजाड़ीइ वोगेहे आन बोकड़ाहां तियाआ बांगाड़्यीइ वोगेहे उबे कोए. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />ताहां राजा तियाआ हाजाड़्यीइ वोगर्‍याअ माअहुंहूं कोये, ‘ए माआं आब्हाआ आशिर्वादीत माअहूं! आवा, तिया राजोअ आधिकारी ओत जावा! जो दुन्याआं पेल रोत तुमाआं काजे तियार कोअयोहो. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />काहाके आंय फुकल्यू ओतू, तेहेलाम तुमू माहूं रोटू आप्यू; तिहील्यू ओतू, तेहेलाम तुमू माहूं पाईं पिवाड्यो; आंय परदेसी ओतू, तेहेलाम तुमू माहूं कोअमेहें हाद्यू. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />आंय उगड़ाअलुज ओतू, तेहेलाम तुमू माहूं आंगड़े पोवाड़्ये; आंय बिमार ओतू, तेहेलाम तुमू माहूं वेंडार्‍यू; आंय जेलेम ओतू तेहेलाम तुमू माहूं मिले आये.’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />ताहां धर्मी तियाहा उत्तर आपे, ‘प्रभु, आमू ताहूं काअहां फुकल्यू देख्यू आन खावाड़्यो, नेत तिहील्यू देख्यू आन पाईं पिवाड़्यो? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />आमू ताहूं कोयों परदेसी देख्यू आन आमाआं कोअमेहें मिक्यू नेत उगड़ाअलुज देख्यू, आन आंगड़े पोवाड़्ये? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />आमू ताहूं कोयों बिमार देख्यू नेत जेलेम देख्यू आन ताहूं मिले आये?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />ताहां राजा तियांहां उत्तर आपे, ‘आंय तुमुहूं नक्की कोहो, के तुमू जों माआं या हानाम रोत हाना पाव्हीइला कोडा एकाअरी बी कोअयो, तों माअरीज कोअयो!’<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />“ताहां तो बांगाड़्यीइ वोल्याहां कोये, ‘ए देवोअ हारापल्या माअहूं, माआं सामने रोत तियी हादाजल्मार्‍यीइं आगीम जाते रोवा! जे सैतान आन तियाआ दुतोअ काजे तियार कोअयिही. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />काहाके आंय फुकल्यू ओतू, आन तुमू माहूं खाअहूं ने आप्यो, आंय तिहील्यू ओतू, आन तुमू माहूं पाईं ने पिवाड्यो; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />आंय परदेसी ओतू, आन तुमू माहूं तुमाआं कोअमेहें ने हाद्यू; आंय नागरु ओतू, आन तुमू माहूं आंगड़े ने पोवाड़्ये; आंय बिमार आन जेलेम ओतू, तेहेलाम तुमू माआं कालजी ने लेदी.’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />ताहां तें उत्तर आपे, ‘प्रभु, आमू ताहूं कोयों फुकल्यू, नेते तिहील्यू, नेते परदेसी, नेत नागरु, नेते बिमार, नेते जेलेम देख्यू, आन ताआ मदत ने कोअयी?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />ताहां तो राजा तियांहां उत्तर आपे, ‘आंय तुमुहूं नक्की कोहो के तुमू जों या हानामेहें रोत हाना एकाअरी बी ने कोअयो, तों माअरी बी ने कोअयो.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />ताहां एं हादाजलम्युउं डोंड भोगे, पोन धर्मी हादाजल्म्याआं जिवनोमेहें जाये.”<note caller="+" style="x"><char style="xo" closed="false">25:46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">दानि 12:2</ref></char></note><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">ईसुहू माइलोअ योजना</para>
  <para style="r">(<ref loc="MRK 14:1-2">मार्क 14:1-2</ref>; <ref loc="LUK 22:1-2">लुक 22:1-2</ref>; <ref loc="JHN 11:45-53">योहान 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />जाहां ईसु ए आखी गोठी कोत नेवराअयू, ताहां तियाआ सेलाहां कोनु वोल्यू. <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“तुमू जांअताहा, के बेन दिहोअ फाटी वल्हांडणोअ तिवार आवे; आन माहुंउं बेटुह्हू क्रुस खांबोपोअ सोढ़वाइलोअ काजे तोआत जाय.”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />ताहां मुख्य पुंजारा आन पुडारी नेहें कैफा नावोअ डाया पुंजाराआ राजवाड़ाम एक्ठा ओवा. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />आन तियां तियांज विसार कोआ वोल्या के ईसुहू केहें कोइत तोइत माइत टाके. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />पोन ते कोताते के, “वल्हांडण तिवारोअ होमसे नाहां; एहलोहो ने ओवुहूं जोवे के माअहूंमेहें दोंगा मातीज जाय.”<verse eid="MAT 26:5" /></para>
  <para style="s">मोगला अत्तरोवाईं ईसुउ अभिशेक</para>
  <para style="r">(<ref loc="MRK 14:3-9">मार्क 14:3-9</ref>; <ref loc="JHN 12:1-8">योहान 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />जेहेलाम ईसु बेथानीम वोडा दुखोवाला शिमोनोअ कोअमेहें ओतू. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />ताहां एक बाय संगमरमरोअ<note caller="+" style="f"><char style="fr" closed="false">26:7 </char><char style="ft" closed="false">संगमरमर ओ एकी जातीइ डोण होय.</char></note> बासनोमेहें अत्तर लेत कोइत ईसुउ जागे आयी, आन जाहां ईसु रोटू खानू बोठू, तेहेलाम तियी तियाआ मुंडोपोअ ओली देदो. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />ओं पालीत, तियाआ सेला बावराइत कोना वोल्या, “ओं नुकसान काहा? तिंया कोयो. <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />ओं ते हाजी किमतेम वेसीत गोरब्योहों आपी देवाअतो.”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />ओं जाईंत ईसु तियांहां कोयो, “बायीही काहा तारास देताहा? यी माअरी हाजो आन बाहरी काम कोअयोहो. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />गरीब माअहें सादा तुमाअरी रोतेहे, पोन आंय तुमाअरी सादाज नाहां रोनारु. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />यी माआं डिलोपोअ जो अत्तर ओल्योहो, तों माहूं डाटीइलोअ तियारीइ काजे कोअयोहो. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />आंय तुमुहूं नक्की कोहो, के आखी दुन्यामेहें जिहीं का बी ए हाजी बातमी परसार ओवे, तिहीं यीइ या कामोअ वर्णन बी तियीइ ईतेमेहें ओवे.”<verse eid="MAT 26:13" /></para>
  <para style="s">यहुदा ईसुहू तोइत आपीइलोम राजी</para>
  <para style="r">(<ref loc="MRK 14:10-11">मार्क 14:10-11</ref>; <ref loc="LUK 22:3-6">लुक 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />ताहां बारा सेलामेर्‍युउ एक जोऊं जियाआ नाव यहुदा इस्कार्योत, तो मुख्य पुंजाराआ जागे गोयू <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />आन तिये कोयो, “जर आंय तुमुहूं ईसुहू तोइत आपिहीं, ताहां तुमू माहूं कि आपहा?” तियां तियाहा तीस सांदीइ रुप्या गोणीत आपी देदा. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />ताअहां रोत यहुदा ईसुहू तोइत आपिइलोअ काजे हाजो गालो पालु वोल्यू.<verse eid="MAT 26:16" /></para>
  <para style="s">ईसुउ तियाआ सेलांअरी वल्हांडण तिवारोअ सेलवार्‍यीइ पांगात</para>
  <para style="r">(<ref loc="MRK 14:12-21">मार्क 14:12-21</ref>; <ref loc="LUK 22:7-13">लुक 22:7-13</ref>; <ref loc="LUK 21-23">21—23</ref>; <ref loc="JHN 13:21-30">योहान 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />वल्हांडण तिवारोअ पेल्लेए दिहे सेला ईसुउ जागे आवित कोना वोल्या के, “ताआ काजे आमू वल्हांडण तिवारोअ रोटू खाअलोअ तियारी काअली जागे कोओ?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />तिये कोयो, “होयरोम अमुक माहुंउं जागे जात कोइत कोवा के, ‘गुरु कोहे, माआं वेल आहने होय, आंय माआं सेलांअरी ताआ जागे वल्हांडण तिवार कोअहीं.’”<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />ताहां सेलां ईसुउ आदेश मान्या आन वल्हांडणोअ रोटू तियार कोअयू.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />जेहेलाम सिंजिवड़ो पोड़्यो, तेहेलाम ईसु बारा सेलांअरी रोटू खानू बोठू. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />जेहेलाम ते खाताते तेहेलाम ईसु कोयो, “आंय तुमुहूं नक्की कोहो, के तुमामेर्‍युउ एक जोऊं माहूं तोइत आपे.”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />ताहां सेला खुब नाराज ओवा, आन हारेक जोओं तियाहा फुसा वोल्या, “गुरु, तो आंय होय के?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />ईसु उत्तर आप्यो, “जिये माअरी ठालीमेहें आथ टाक्युहू, तोज माहूं तोइत आपे. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />माहुंउं बेटुह्हू ते जेहलोहो तियाआ बाप्तिमेहें लेख्योहो, तेहेंज कोइत तो जाहे खोरु; पोन तिया माहुंउं केतीही वाजे जियाअ आथोवाअहीं माहुंउं बेटुह्हू तोआये: जर तिया माहुंउं जल्मज ने ओवतो तों तियाआ काजे हाजो रोतो.”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />ताहां तियाहा तोइत आपनारु यहुदा कोयो, “गुरु, तो आंय होय के?”</para>
  <para style="p" vid="MAT 26:25">ईसु तियाहा कोयो, “तुमे कोत देदो.”<verse eid="MAT 26:25" /></para>
  <para style="s">प्रभु भोज</para>
  <para style="r">(<ref loc="MRK 14:22-26">मार्क 14:22-26</ref>; <ref loc="LUK 22:14-20">लुक 22:14-20</ref>; <ref loc="1CO 11:23-25">1 करिन्थ 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />जाहां ते खाया कोअताते, ताहां ईसु रोटू लेदू, आन आशिर्वादोअ प्रार्थना कोअयी, आन रोटू मुड़्यू, आन सेलाहां आपीत कोयो, “ल्या, खावा; ओं माआं डिल होय.”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />फाशुउ तिये वाटकू लेत कोइत देवोअ धन्यवाद कोअयो, आन तियांहां आपीत कोयो, “तुमू आखा यामेहें रोत पिवा, <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />काहाके ओं माआं शप्पतोअ रक्त होये, जों जाअखीलां जोओंअ पापोअ माफीइ काजे वोहाड़्योहो. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />आंय तुमुहूं कोहो, के दाराक्शाआ ओ रोहो तिये दिही जाआं आंय केदिहींज ने पिंव जाअहूं जाआं तुमाअरी माआं बाह्हाआ राजोमेहें नोवू दाराक्शाआ रोहो ने पिंव.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />ताहराअ ते भजन गावीत जेयतुन डोगोपोअ गोया.<verse eid="MAT 26:30" /></para>
  <para style="s">पेत्राआ नाकारोअ बाप्तिम ईसुउ भविश्यवाणी</para>
  <para style="r">(<ref loc="MRK 14:27-31">मार्क 14:27-31</ref>; <ref loc="LUK 22:31-34">लुक 22:31-34</ref>; <ref loc="JHN 13:36-38">योहान 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />ताहां ईसु तियांहां कोयो, “तुमू आखा आजूज राती माहूं सोड़ीत जाता रोहा, काहाके वसन कोहे, ‘देव डोरक्याहा माईं देये; आन गोवाराआ मेडे वेरासेर ओत जाये.’ <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />पोन आंय जिवीत उठीहीं ताहां तुमारोत पेल गालीलोमेहें जाहीं.”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />यी गोठीपोअ रोत पेत्रे ईसुहू कोयो, “आखा ताहूं टाकीत जाता रोये, पोन आंय ताहूं केदिहींज टाकीत ने जांव!”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />ईसु पेत्राहा कोयो, “आंय ताहूं नक्की कोहो, के आजूज राती कुकड़ा वांहीइलोअ पेल तू तीन वारी माहूं ने ओलखीइत्लू एहें कोही.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />पेत्रे कोयो, “ताअरी माहूं मोअहूं पोड़े तेबी आंय एहें नेज कोंव!”</para>
  <para style="p" vid="MAT 26:35">आन एहेंज कोइत आखा सेला बी कोयो.<verse eid="MAT 26:35" /></para>
  <para style="s">गेथसेमनी बोगिसाम ईसुउ प्रार्थना</para>
  <para style="r">(<ref loc="MRK 14:32-42">मार्क 14:32-42</ref>; <ref loc="LUK 22:39-46">लुक 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />ताहां ईसु तियाआ सेलांअरी गेथसेमनी नावोअ जागापोअ आयू आन तिये तियांहां कोयो, “आंय जात कोइत प्रार्थना कोअहो ताअहूं जाआं तुमू इंहींज बोहीत रोजा.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />आन तिये पेत्राहा आन जब्दीइ बेन पोर्‍याहा आरी लेत गोयू, आन उदास आन दुखी ओनू वोल्यू. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />ताहां तिये तियांहां कोयो, “माआं मोन खुब दुखी होये, एतोह दुखी के माईंत लेय एहेलोह लागेहे. तुमू इंहींज उबा रोवा, आन माअरी जागता रोवा.”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />फाशुउ तो थोड़ुक आगाड़ी जात कोइत उबडू पोड़ीत ए प्रार्थना कोअयी, “ए माआं आब्हा जर ओत सेके ते ओ दुखोअ वाटकू माआं जागे रोत टोलीत जाअहूं दे, तेबी माआं मोर्जी नाहां पोन ताआ मोर्जीइ परमाणे ओवुहूं दे.”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />ताहरुउ वापिस सेलाआं आहने आवित तियांहां हुवत्लाहा देख्या, आन पेत्राहा कोयो, “के तुमू तीनू माअरी एक तास जाआं जागित नाहां सेकता के? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />जागता रोवा, आन प्रार्थना कोअता रोवा, के तुमू परिक्शाम ने पोडहा! आत्मा ते तियार होय, पोन शरीर कमजोर होय.”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />फाशुउ ईसु बिहीरी वारी जात कोइत ए प्रार्थना कोअयी, “ए माआं आब्हा, जर ओं माआं पिया वासी नाहां टोलीत सेकतो ते ताआ मोर्जी पुरी ओवे.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />तो फाशुउ एक वारी वोलीत आयू आन सेलाहां हुवत्लाज देख्या; काहाके ते निंदवाअयाते.<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />आन फाशुउ एकवारी जाआं तियांहां टाकीत जातु रोयू, आन तेहेंज कोइत, तिसरी वारी प्रार्थना कोअयी. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />ताहां तो सेलाआं जागे वोलीत आयू आन कोयो, “ओमे जाआं तुमू हुवयाज कोअताहा आन आराम कोअताहा के? पाला! वेल आवित लागीही, आन माहुंउं बेटुह्हू पाप्योअ आथम तोइत आपाअहे. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />उठा, साला. पाला, माआं तोअनारु आहनेज आवित लागुहू.”<verse eid="MAT 26:46" /></para>
  <para style="s">ईसुहू तोअत्ले</para>
  <para style="r">(<ref loc="MRK 14:43-50">मार्क 14:43-50</ref>; <ref loc="LUK 22:47-53">लुक 22:47-53</ref>; <ref loc="JHN 18:3-12">योहान 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />ईसु ए गोठी कोत्लू तेहेलाजमेहें, यहुदा जो बारा सेलामेर्‍युउ एक जोऊं ओतू तो आयू, आन तियाअरी मुख्य पुंजारा आन डायहांआं वोडी गोरदी तारवाआ आन डेंगारा लेत कोइत आयी. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />तियाहा तोइत आपनारे यहुदे माहुंहूं इशारु कोई देदू: “जियाहा आंय गुउं देही; तियाहा तोइत लेजा!”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />आन यहुदा होल्लुज ईसुउ जागे गोयू आन कोयो, “गुरु, सलाम,” आन तियाहा गुऊँ देदू.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />ईसु तियाहा कोयो, “ए दोस्ता, जिया कामोंअ काजे तू आयुहू, तों मामार कोइत ले!” ताहां तियां माअहूं आहने आवित ईसुहू तोइत लेदू, आन बेड़ी लागाड़ी देदी. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />ताहां ईसुउ हातीमेर्‍येए एके जोएं तारवाआ काड्यीन मुख्य पुंजाराआ पावरोअ कान साटकीत टाक्यु. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />ताहां ईसु तियाहा कोयो, “ताआ तारवाआ मांय मिकीत ले, काहाके जें तारवाआ सालाडतेहें, तें आखे तारवाअ वाअहीं मोए. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />केहें तू नाहां समजीइतू के, आंय माआं बाह्हाहा रावणी कोइत सेकोहो, आन तो देवदुतोंअ सेयनिकोअ बारा तुकड़ी रोत बी वादार माआं कोअते मोकलीत सेकेहे? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />जर एहें कोअहूं ताहां, देवोअ वसन केहें कोइत पुरो ओवे, जों कोहे के एहेलोह ओवुहूंज जोवे?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />ताहां ईसु तियांहां कोयो, “केहें तुमू तारवाआ आन डेंगारा लेत कोइत माहूं डाखुउ होस तोआ आया? आंय दाड़ख्युउ मंदिरोमेहें बोहीत संदेश आपतुतो, तेहेलाम तुमू माहूं नाहां तोअयु. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />पोन ओं आखो याअ काजे ओवो के भविश्यवक्ताआ वसने पुरे ओवे.”</para>
  <para style="p" vid="MAT 26:56">ताहां आखा सेला तियाहा टाकीत गुगदा वोल्या.<verse eid="MAT 26:56" /></para>
  <para style="s">पोन्साअ सामने ईसुहू तोइत लेतावीइलो</para>
  <para style="r">(<ref loc="MRK 14:53-65">मार्क 14:53-65</ref>; <ref loc="LUK 22:54-55">लुक 22:54-55</ref>; <ref loc="LUK 22:63-71">22:63-71</ref>; <ref loc="JHN 18:13-14">योहान 18:13-14</ref>; <ref loc="JHN 18:19-24">18:19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />जिहीं कायदाआ मास्तरहों आन डायहां टोलू वोलीत रोयाते, तिहीं ईसुहू तोअनारा तियाहा कैफा नावोअ डाया पुंजाराआ जागे लेत गोया. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />आन पेत्र सेटेज रोत फासाड़ी-फासाड़ी डाया पुंजाराआ खोलीमेहें जाआं गोयू, आन मांयते जात कोइत की ओवनारो होय तो पालिइलोअ काजे जागल्याआं जागे जात कोइत बोहीत गोयू. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />डाया पुंजारा आन आखु पोन्सूज ईसुहू माईंत टाकीइलोअ काजे खोटू पुरावू होदताते. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />पोन वारुज खोटू पुरावू आपनारा आया तेबी ने बोण्यी. आखरी पोअ बेन जोओं आगाड़ी आया, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" /><note caller="+" style="x"><char style="xo" closed="false">26:61 </char><char style="xt" closed="false"><ref loc="JHN 2:19-21">योहान 2:19-21</ref></char></note> आन कोयो, “ये कोयोहो के आंय तीन दिहोमेहें देवोअ मंदिरोहो पाड़ीत सेकोहो आन तीन दिहोमेहें बोणावीत सेकोहो.”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />ताहां डाये पुंजारे उबू रोत कोइत ईसुहू कोयो, “तू केहें नाहां उत्तर आपतू? एं माअहें ताआ विरुध्दामेहें कि पुरावू देतेहे?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />पोन ईसु ठावकुज रोयू. ताहां डाये पुंजारे तियाहा कोयो “आंय ताहूं जिवता देवोअ शप्पत खात कोइत कोहो, के खोरीज तू देवोअ बेटुह्हू ‘ख्रिस्त’ ओय ताहां आमुहूं वारुहूं कोत दे.”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />ईसु तियाहा कोयो, “तुमेज कोत देदो; पोन आंय तुमुहूं ओं बी कोहो, के ओमे रोत तुमू निस्तु माहुंउं बेटाह्हाहा आखा रोत वोडी ताकतवालाआ हाजाड़्यीइ वोगेहे बोठलू, आन जुगोमेर्‍याआ वाद्ला पोअ आवत्लाहा देखहा.”<note caller="+" style="x"><char style="xo" closed="false">26:64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानि 7:13</ref></char></note><verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />ताहां डाये पुंजारे सोताआ आंगड़े सिरी देत कोयो, “ये देवोअ निंदा कोअयिही! ओमे आपुहूं पुरावाआ की गरज? पाला, तुमू ओमेज ए निंदा उनाअयाहा!<note caller="+" style="x"><char style="xo" closed="false">26:65 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेवी 24:16</ref></char></note> <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />तुमू की समजीइताहा?”</para>
  <para style="p" vid="MAT 26:66">तियां उत्तर आप्यो, “याहा माईं देअहूं जोवे.”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />ताहां तियां तियाआ सोबीपोअ थुप्यो आन तियाहा तुंबा वाअहीं देदू; जियां तुंबा वाअहीं देदू, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />तियां कोयो “ए ख्रिस्ता! आमुहूं भविश्यवाणी कोइत को, के ताहूं कोडे देदू?”<verse eid="MAT 26:68" /></para>
  <para style="s">पेत्र ईसुहू नाकारत्लू</para>
  <para style="r">(<ref loc="MRK 14:66-72">मार्क 14:66-72</ref>; <ref loc="LUK 22:56-62">लुक 22:56-62</ref>; <ref loc="JHN 18:15-18">योहान 18:15-18</ref>; <ref loc="JHN 18:25-27">18:25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />पेत्र बाअथे खोलीमेहें बोठुतो आन एक पावरीइं तियाआ जागे आवित कोयो, “तू बी तोम गालीलवाला ईसुउरी ओतू.”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />तिये आखा सामने ओं कोत कोइत नाकार कोअयू, “तू की कोहे तोज माहूं नाहां समजाअतो.” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />जाहां तो बाअथे दरवाजामेहें जातु रोयू, ताहां बिहीरी पावरीइं जे तिहीं ओती तियी देखीत कोइत तिया माट्योहो कोयो, “ओं बी ताम नासरेथवाला ईसुउरी ओतो जी.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />तिये फाशुउ शप्पत खात कोइत कोयो, “आंय तिया माहुंहूं नाहां ओलखीइतू.”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />थोड़ीक वेलेमेहें तिहीं उबे रोत रोयेते, तियां पेत्राहा आहने आवित कोयो, “खोरीज तु बी तियांमेर्‍युउ एक जोओं होय; काहाके ताआ बोली वाअहीं तू ओलखात जाहे!”<note caller="+" style="f"><char style="fr" closed="false">26:73 </char><char style="ft" closed="false">याआ अर्थ ओं होय के तू गालीलोअ होय.</char></note><verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />ताहां तो शप्पत खात कोइत कोनु वोल्यू, “आंय या माहुंहूं ने ओलखीइत्लू!”</para>
  <para style="p" vid="MAT 26:74">आन तेताजमेहें कुकड़े वाहीं देदो. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />ताहां पेत्राहा ईसु कोल्यी गोठ ओर आयी, “कुकड़ू वांहीइलोअ पेल तू तीन वारी माहूं नाकारही,” आन तो बाअथे गोयुन ताहरुउ फोको फोको रोड़्यु.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">पिलातोअ सामने ईसु</para>
  <para style="r">(<ref loc="MRK 15:1">मार्क 15:1</ref>; <ref loc="LUK 23:1-2">लुक 23:1-2</ref>; <ref loc="JHN 18:28-32">योहान 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />हुजताअरीही आखा डाया पुंजारा आन पुडारी ईसुहू माईंत टाकीइलोअ योजना कोअयी. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />आन तियां तियाहा बेड़ी लागाड़ीत कोइत रोमी राज्यपाल पिलातोअ आथोमेहें होपी देदू.<verse eid="MAT 27:2" /></para>
  <para style="s">यहुदा इस्कार्योतोअ मोत</para>
  <para style="r">(<ref loc="ACT 1:18">प्रेशित 1:18</ref>,<ref loc="ACT 1:19">19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />जाहां ईसुहू तोइत आपनारे यहुदे देख्यो के ईसुहू दोशी ठरव्युहू, ताहां तो फासताअयू आन ते तीस सांदीइ रुप्या तियां डाया पुंजारहां आन डायहांआं सामने वापिस लेत गोयू. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />आन कोयो, “मी एका निर्दुस माट्योहो मोतोअ काजे तोइत आपीत पाप कोअयुहू!”</para>
  <para style="p" vid="MAT 27:4">तियां कोयो, “आमू की कोओमें? तो ताम तुज पालेएमें.”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />ताहां यहुदा मंदिरोमेहें<note caller="+" style="f"><char style="fr" closed="false">27:5 </char><char style="ft" closed="false">मोन्ज्ये पवित्र जागु</char></note> तियां सांदीइ रुप्याहां टाकी देत् जातु रोयू; आन जात कोइत तिया तियाआज फासी लेत लेदी.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />मुख्य पुंजारहां पोशा विसीत कोइत कोयो, “ए पोशा दान पेटीमेहें मिकीइलो कायदाआ विरुध्दामेहें होय, काहाके ए रक्ताआ दामोअ पोशा होये.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />सेलवाआ तियां मानित कोइत तियां पोशाआ पोरदेस वालाहां डाटीइलोअ काजे कुंबारोअ खेत वेसातो लेत लेदो. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />तियाहाज काजे तिया खेतोहो आज बी “रक्ताआ खेत” कोतेहे.<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />ताहां जो वसन यिर्मया भविश्यवक्ता वाअहीं कोल्यो तोओं पुरो ओवो: “तियां ते तीस सांदीइ रुप्या जे इस्राएलवाला माअहूं तियाआ वोतीइ किंमत ठरव्यीते लेत लेदा.<note caller="+" style="x"><char style="xo" closed="false">27:9 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">जख 11:12-13</ref>; <ref loc="JER 32:6-9">यिर्म 32:6-9</ref></char></note> <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />आन जेहलोहो प्रभु माहूं आदेश आप्युतो तेहेंज कोइत ते पोशा तियां कुंबारोअ खेत लेअलोअ काजे वापर्‍या.”<verse eid="MAT 27:10" /></para>
  <para style="s">पिलात ईसुहू प्रश्न फुसत्लु</para>
  <para style="r">(<ref loc="MRK 15:2-5">मार्क 15:2-5</ref>; <ref loc="LUK 23:3-5">लुक 23:3-5</ref>; <ref loc="JHN 18:33-38">योहान 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />जाहां ईसु रोमन राज्यपालोअ सामने ऊबू रोयू, तेहेलाम तिये राज्यपाले फुशो, “केहें तू यहुद्यांआं राजा होय के?”</para>
  <para style="p" vid="MAT 27:11">ईसु तियाहा कोयो, “तुज कोहे ना.” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />जेहलामेहें मुख्य पुंजारा आन डायहां तियापोअ आरोप लागाड़ताते, तेहेलाम तिये किज उत्तर ने आप्यो.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />यी गोठीपोअ रोत पिलाते तियाहा कोयो, “केहें तू नाहां उनाअतू के, एं ताआ विरुध्दामेहें केतुहू पुरावू आपतेहे?”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />पोन ईसु राज्यपालोहो एक बी गोठीइ उत्तर ने आप्यो, ताहां राज्यपाल जास्ती बोगलाअयू.<verse eid="MAT 27:14" /></para>
  <para style="s">ईसुउ मोतोअ मागणी</para>
  <para style="r">(<ref loc="MRK 15:6-15">मार्क 15:6-15</ref>; <ref loc="LUK 23:13-25">लुक 23:13-25</ref>; <ref loc="JHN 18:39-19:16">योहान 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />आन वल्हांडण तिवारोअ काजे रोमन राज्यपालोअ ए रीत ओती, के कोड्ला बी एका जेलेमेर्‍याआ आरोपीही माअहोंअ मागणीइं परमाणे सोड़ी देतुतो. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />तिया जमानामेहें ईसु बरब्बास नावोअ एक नावासी आरोपी तिहीं ओतू. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />जाहां माअहें टोलू वोल्ये ताहां पिलाते कोयो, “आंय तुमाआं काजे कोडाहा सोडो? बरब्बासोहो के जियाहा ‘ख्रिस्त’ कोतेहे तिया ईसुहू?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />तियाहा वारुहूं हाजो मुंदू ओतो के यहुदी आधिकारी ईसुहू तियाआ आथोमेहें होप्युहू काहाके ते आद्राअताते.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />जाहां पिलात कोर्ठोमेहें बोठुतो तेहेलाम तियाआ लाडी तियाहा एहें कोत कोइत मोकल्यो, “तू तिया निर्दुस माहुंहूं किज मा कोअही, काहाके आज राती होपनामेहें याआ वास्तायी मी खुब दुख वेठ्योहो.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />मुख्य पुंजारा आन डायहां बरब्बासोहो सोडे तेहें आन ईसुहू माएं तेहें काजे माअहुंहूं उरी सोढ़व्यी. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />पोन पिलात माअहुंहूं फुशो के, “यां बेनुमेहें रोत कोडाहा सोडो एहेलिही तुमाआं इश्शा होये?”</para>
  <para style="p" vid="MAT 27:21">तियां कोयो, “बरब्बासोहो!”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />ताहां पिलात तियां माअहुंहूं फुशो, “ताहरुउ जियाहा ‘ख्रिस्त’ कोतेहे तिया ईसुहू की कोओ?”</para>
  <para style="p" vid="MAT 27:22">आखाज तियाहा कोयो, “याहा क्रुस खांबोपोअ सोढ़वा!”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />पोन पिलाते कोयो, “काहा, ये की गुनू कोअयुहू?”</para>
  <para style="p" vid="MAT 27:23">पोन तें वादार आअड़ी आअड़ीइ कोने वोल्ये, “याहा क्रुस खांबोपोअ सोढ़वा!”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />जेहेलाम पिलाते देख्यो के कीज नाहां जमती, पोन हालत बिगड़ीइतीज जाहे, ताहां तिये पाईं लेत कोइत माअहोंअ सामने तियाआ आथ तुवया आन कोयो, “या धर्मी माहुंउं खुनोअ जाबाबदार आंय नाहां! ओं तुमाआंज काम होये!”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />आखा माअहूं कोयो, “याआ मोतोअ जाबाबदारी आमापोअ आन आमाआं पिढीपोअ ओवे!”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />यी गोठीपोअ रोत पिलात बरब्बासोहो तियांआं काजे सोड़ी देदू, आन ईसुहू सापका देत क्रुस खांबोपोअ सोढवे तेहें काजे तियांआं आथम होपी देदू.<verse eid="MAT 27:26" /></para>
  <para style="s">सैनिक ईसुउ अपमान कोअत्ला</para>
  <para style="r">(<ref loc="MRK 15:16-20">मार्क 15:16-20</ref>; <ref loc="JHN 19:2-3">योहान 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />ताहां पिलातोअ सैनिकहों ईसुहू राज्यपालोअ राजवाड़ाम लेत गोया, आन आखी तुकड़ी तियाआ शारी वोगेहे टोलू वोल्यी. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />आन तियाआ आंगड़े काडीत रात्ला रंगोअ आंगड़ो पेवाड़्य. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />आन काटाआ टोपू गुथीत तियाआ मुन्कापोअ मिक्यू; आन तियाआ हाजाड़्या आथोमेहें डेंगार तोआड़्यी; ताहराअ तियाआ आगाड़ी मांड्या पोड़ीत, “ए यहुद्यांआं राजा जय जयकार!” एहें कोय कोय मोज्या लेना वोल्या. <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />आन तियापोअ थुप्यो; आन ते डेंगार मागीत कोइत मुंडोमेहें देना वोल्या. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />जाहां ते तियाआ मोज्या लेत लेदी, तेहेलाम तों आंगड़ो काडीत फाशाअ तियाआज आंगड़े पेवाड़्ये, आन तिहीं रोत क्रुस खांबोपोअ सोढ़वीइलोअ काजे लेत गोया.<verse eid="MAT 27:31" /></para>
  <para style="s">ईसुहू क्रुस खांबोपोअ टांगत्ले</para>
  <para style="r">(<ref loc="MRK 15:21-32">मार्क 15:21-32</ref>; <ref loc="LUK 23:26-43">लुक 23:26-43</ref>; <ref loc="JHN 19:17-27">योहान 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />बाअथे जात्ला तेहेलामेहें एक शिमोन नावोअ कुरेनीवालू माटी मिल्यू, तियां सैनिकहों तियाहा ईसुउ क्रुस खांब आखले तेहें काजे जबरजस्ती कोअयी. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />आन तिया जागापोअ जियाहा गुलगुता मोन्ज्ये मुन्काआ खोबज्यो कोतेहे तिहीं पोता. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />तिहीं ईसुहू कड़वू रोहो सान्बीत दाराक्शाआ रोहो पिय तेहें आप्यू, पोन तिये ने पिदू.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />ताहां तियां तियाहा क्रुस खांबोपोअ सोढव्यू; आन सिट्टी टाकीत तियाआ आंगड़े वाटीत लेदे. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />आन ताहराआ तिहीं बोहीत कोइत पाला वोल्या. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />आन तियाआ आरोपोअ पाटी, तियाआ मुंडीइ उसीइ वोगेहे लागाड्यी, तियीपोअ ओं लेख्योतो: “ईसु ओ यहुद्याआं राजा होय.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />ताहां ईसुउरी बेन डाखा एकाहा हाजाड़्यीइ वोगेहे आन एकाहा बांगाड़्यीइ वोगेहे क्रुस खांबोपोअ सोढव्या. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />आन आवनारे-जानारे मुंड आलवी-आलवीइ ईसुउ निंदा कोअयी. <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />आन एहें कोतेते, “ए मंदिरोहो पाडनारा आन तीन दिहोम बोणावनारा सोताहा तेंव वासाड़! जर तू देवोअ बेटुह्हू ओय ताहां क्रुस खांबोपोअ रोत निसे उतरीत आव!”<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />एहेंज कोइत मुख्य पुंजारा आन कायदाआ मास्तरहों आन डायहां बी मोज्या लेत कोइत कोताते, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“ये बिहीराहा वासाड़्ये, पोन सोताहा नाहां वासाड़ीत सेकतु. ओ जर इस्राएलोअ राजा ओय ताहां ओमे क्रुस खांबोपोअ रोत उतरीत आवे, ताहां आमू तियापोअ विश्वास कोअहूं! <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />ये देवोपोअ भरिवसू मिक्युहू आन सोताहा देवोअ बेटुह्हू कोहे. ठीक होय तेहलोहो ओय ताहां देव याहा ओमे वासाड़ेहे के नाहां तों पालता!”<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />एहेंज कोइत डाखा बी जे तियाअरी क्रुस खांबोपोअ टांगात रोयाते, तेबी तियाआ निंदा कोअताते.<verse eid="MAT 27:44" /></para>
  <para style="s">ईसुउ मोयात</para>
  <para style="r">(<ref loc="MRK 15:33-41">मार्क 15:33-41</ref>; <ref loc="LUK 23:44-49">लुक 23:44-49</ref>; <ref loc="JHN 19:28-30">योहान 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />हिराआ पोअ रोत ते तीन तास जाआं पुरा देसोमेहें आंदारो सेवात गोयो. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />कमीत कमी तिनेक वाजता जेहें ईसु जोरेबी आअड़ीत कोयो, “एली, एली, लमा शबकतनी?” मोन्ज्ये “ओ माआं देवा, ओ माआं देवा, तुमे माहूं काहा सोड़ी देदू?”<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />जे तिहीं उबा रोया तियां ओं उनाइत तियांम रोत वारुज जोओं कोयो, “ओ ते एलियाहा हाद कोअहे रा!” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />तियांमेर्‍युउ एक जोओं गुगदीइतूज जात कोइत, सुहांरो लेत कोइत खाटा रोहोमेहें बुडाड़्यो आन डेंगारीइ सुटक्यापोअ मिकीत तियाहा सुगलाड़्यो.<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />पोन थोड़ाक जोओं कोयो, “माताअहूं, एलिया आवित याहा वासाड़ेहे के नाहां पाला ताअहूं!”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />ताहां ईसु फाशुउ जोरे बी आअड़ीत जिव सोड़ी देदू.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />ताहां, मंदिरोअ पोड़दू उसे रोत ते निसे जाआं फाटीत बेन भाग ओवा: आन धरती आल्यी आन खड़को जाआं फुटीत गोयो. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />आन माहणें उगड़ीत गोये, आन वारुज मोल्ये देवोअ माअहें जिवते ओत गोये. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />आन ईसु मोल्याम रोत जिवीत उठ्यू तिहींइं फाटी तें माहणोम रोत निहींत पवित्र होयरोमेहें गोये, आन वारुज जोओं तियांहां देख्ये.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />जाहां सेयनिकोअ मुख्य आधिकारी आन तियाआ सेयनिक ईसुउ राखवाली कोअताते, तेहेलाम भुकंप आन जो की बी ओवो तों पालीत जास्तीज बित गोया, आन कोयो, “खोरीज ओ देवोअ बेटुह्हू<note caller="+" style="x"><char style="xo" closed="false">27:54 </char><char style="xt" closed="false"><ref loc="MAT 17:5">मत्तय 17:5</ref></char></note> ओतू!”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />तिहीं वारुज बोंईं जे गालीलोमेहें रोत ईसुउ सेवा कोअती तियाअरी आयीते, ते सेटे रोत पालतीते. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />तियीमेहें मरिया मग्दालिनी आन याकोब आन योसेफोअ आयही, आन जब्दीइ लाडी ओती.<verse eid="MAT 27:56" /></para>
  <para style="s">ईसुहू ओजे पाडीइलो</para>
  <para style="r">(<ref loc="MRK 15:42-47">मार्क 15:42-47</ref>; <ref loc="LUK 23:50-56">लुक 23:50-56</ref>; <ref loc="JHN 19:38-42">योहान 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />हांजेपोअ योसेफ नावोअ अरमितीवालू एक कुन्बी माटी जो ईसुउ सेलू ओतू तो आयू. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />योसेफे पिलातोअ जागे जात कोइत ईसुउ तोड़ माग्यो. ताहां पिलाते तों तोड़ आपेतेहें आदेश आप्यू. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />योसेफ तोड़ोहो लेत कोइत तियाहा सोत्राला सादरामेहें गुंउंटायो, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />आन तियाहा तियाआ नोवा माहणोमेहें मिक्यो, जों तिये खड़कामेहें खुआंण्योतो. तिहीं रोत तिये माहणोअ दोओपोअ वोडू बी डोण होरकावी देत जातू रोयू. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />मरिया मग्दालिनी आन बिहीरी मरिया नेहें तिहीं माहणोअ सामने बोहीत रोयीते.<verse eid="MAT 27:61" /></para>
  <para style="s">ईसुउ माहणोपोअ जागल्या</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />बिहीरे दिही जो आरामोअ दिही ओतू, मुख्य पुंजारहां आन फरिसी पिलातोहो मिल्या आन कोयो. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />“मालिख, आमुहूं ओर होये के, तो लबाड़ जिवतुज ओतू तेहेलाम कोयोतो, के ‘आंय तीन दिहोअ फाटी जिवीत उठीहीं.’<note caller="+" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 12:40">मत्तय 12:40</ref>; <ref loc="MAT 16:21">16:21</ref>; <ref loc="MAT 17:23">17:23</ref>; <ref loc="MAT 20:19">20:19</ref>; <ref loc="LUK 8:2">लुक 8:2</ref>,<ref loc="LUK 8:3">3</ref> </char></note> <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />ताहरोअ तुमू तीन दिही जाआं माहणोअ राखवाली कोए तेहें काजे आदेश आपा, एहलोहो ने ओवुहूं जोवे के तियाआ सेला आवित कोइत तियाआ तोड़ सोइत लेत जाता रोयेन ताहराआ माअहुंहूं कोना वोले, के ‘तो मोतोमेहें रोत जिवीत उठ्युहू,’ ताहराआ ते आपू पेल्लाआ ठोगाअया तिया रोत सेलवाआ ठोगाअहूं तों जाअखो खाराब ओवे.”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />पिलाते तियांहां कोयो, “जागल्या ताम होय, जावा, तुमाआं मोर्जीइ पुरमाणे राखवाली कोआ.”<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />ताहां ते गोयान कबरेपोअ डोण हारीत पाक्को बुजी देदो, आन राखवली कोए तेहें जागल्‍या लागाड़ी देदा.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">ईसुउ जिवीत उठीइलोअ</para>
  <para style="r">(<ref loc="MRK 16:1-10">मार्क 16:1-10</ref>; <ref loc="LUK 24:1-12">लुक 24:1-12</ref>; <ref loc="JHN 20:1-19">योहान 20:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />आरामोअ दिहोअ फासाड़ी दितवारोअ दिही वेगऱ्यीइजे मग्दालिनी मरिया आन बिहीरी मरिया माहणोअहीं पाली आयी. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />ताहां एक वोडो भुकंप ओवो; काहाके प्रभुउ एक दुत होरगामेहें रोत उतर्‍यू, आन आहने आवित तिये डोणोहों होरकावी देदू, आन तियापोअ बोहीत गोयू. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />तियाआ रुप विजेए होस आन तियाआ आंगड़े बर्फाआ होस पांढे-पांढेज ओते. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />तियाआ बिके वाअहीं जागल्या थुर थुर थोतरा वोल्या आन मोल्याआ होस ओत गोया.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />देवदुत तियीं बायींहीं कोयो, “मा बिहा, माहूं मुंदू होये, के तुमू ईसुहू जो क्रुस खांबोपोअ सोड़वाअयुतो तियाहा होदतिही. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />तो इंहीं कायनाहां, पोन तो तियाआ वसनोअ अनुसार जिवीत उठ्युहू; आवा, ओ जागू पाला, जिहीं प्रभु लोटीत रोयुतो. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />आन मामार जात कोइत तियाआ सेलाहा कोवा, के तो मोतोमेहें रोत जिवीत उठ्युहू; आन तो तुमारोत पेल गालीलोमेहें जाहे, तिहीं तियाआ दर्शन जोड़े, पाला आंय तुमुहूं कोत देदो.”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />आन ते बिक आन वोडी खुसी वाअहीं माहणोअहीं रोत मामार वोलीत तियाआ सेलाहां खबर कोअलोअ काजे गुगदी वोल्यी.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />उसकाहीज ईसु तियांहां मिल्यू आन कोयो, “सलाम” आन तें तियाआ जागे आवित तियाआ पागे पोड़ीत तियाआ भक्ती कोअयी. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />ताहां ईसु तियांहां कोयो, “मा बिहा; माआं पायहोहों जात कोइत कोवा, के गालीलोमेहें जाये आन तिहीं ते माहूं देखे.”<verse eid="MAT 28:10" /></para>
  <para style="s">जागल्याअ खबर</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />ते बोईं तियींइं वाटे लागी, ताहां जागल्यामेहें रोत थोड़ाक जोआं होयरोम आवित कोइत पुरी हालत मुख्य पुंजाराहां कोत देदी. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />ताहां मुख्य पुंजारा पुढार्‍योंअरी एकठा ओत कोइत योजना बोणायी, आन सिपायड़ाहां जाअखीलाहां पोशा आप्या <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />आन कोयो, “तुमू एहें कोजा के आमू राती हुवत्ला तेहेलाम तियाआ सेलां आवित कोइत तियाआ तोड़ सोइत लेत जाता रोल्या. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />आन जर ए गोठ राज्यपालोअ कानोपोअ जाआं गोयी, ताहां आमू तियाहा पोटावीत कोहूं के तुमू निर्दुस होये, आन तुमुहूं फिकर कोइलोअ कीज गरज कायनाहां.”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />ताहां जागल्या पोशा लेत कोइत तियां जेहलोहो कोअहूं लागाड़्यो तेहेंज कोइत कोअयो; आन ए गोठ आज बी यहुदी माहें मानतेहे.<verse eid="MAT 28:15" /></para>
  <para style="s">ईसु तियाआ सेलाहां दर्शन</para>
  <para style="r">(<ref loc="MRK 16:14-18">मार्क 16:14-18</ref>; <ref loc="LUK 24:36-49">लुक 24:36-49</ref>; <ref loc="JHN 20:19-23">योहान 20:19-23</ref>; <ref loc="ACT 1:6-8">प्रेशित 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />ईग्यार सेला गालीलोमेहें तिया डोगोपोअ गोया, जिहीं ईसु तियांहां जाय तेहें कोयोतो. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />तियां ईसुहू देख्यू आन तियाआ पागे पोड़्या, पोन थोडहाहा ते सौंसू आयू. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />ईसु तियांआं जागे आवित कोयो, “होरगाआ आन धरतीइ आखु आधिकार माहूं आप्युहू. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />तियाहा काजे तुमू जावा आन आखा देसोअ माअहुंहूं सेला बोणावा; आन तियांहां बाह्हाअ, आन बेटाह्हाआ, आन पवित्र आत्माआं नावसे बाप्तिस्मा आपा, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />आन तियांहां आखी गोठी जे आंय तुमुहूं आदेश आप्युहू, ते मानिइलोअ सिकाड़ा: आन पाला, आंय दुन्या सेलाय ताअहूं जाआं तुमाअरी होंवे.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>