<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Noiri</book>
  <para style="h">मिखा</para>
  <para style="toc3">मिखा</para>
  <para style="toc2">मिखा</para>
  <para style="toc1">मिखाआ पुस्तक</para>
  <para style="mt2">मिखाआ पुस्तक</para>
  <para style="mt1">मिखाआ पुस्तक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">या पुस्तकोमेहें मिखाआ भविश्यवाणी होये. मिखा यहुदाआ मोरेशेत होयरोवालू ओतू. <char style="xt"><ref loc="MIC 1:1">1:1</ref></char> आन यिर्मया 26:18 तिये यहुदाआ राजा योथाम, आहाज आन हिजकिया यांआं राजोमेहें भविश्यवाणी कोअयी. याआ अर्थ होय के तियाआ सेवा एक आंदास 750 इ.स. साल ते 700 इ.स. सालोअ आगोदर ओती. तिया गालाहा यशाया आन होशे यां बी भविश्यवाणी कोअयीते. मिखेज ए भविश्यवाणी लेख्यीय के तियाआ सेला तियाआ वोतीइ लेख्यीय तों नाहां मुंदू. जों बी ओय पोन ओं पुस्तक इ.स. आगोदर 700 साल ते इ.स. आगोदर 608 सालोअ विसमेहें लेखाअयोहो. काहाके यिर्मयाआ पुस्तकोम बी याआ माग काड्युहू.</para>
  <para style="ip">मिखाआ भविश्यवाणी देवोअ न्याय आन तियाआ तारणोअ विसमेहें आगी-फाशी ओवती रोहे. तो गोरब्योअरी सुकीइ वेवारो आन लालस कोइलोअ बाप्तिम यहुदापोअ आरोप लागाड़ेहे. <char style="xt"><ref loc="MIC 2:2">2:2</ref> </char>तो सुकीइ वागनारा तियाआ भविश्यवक्ता पोअ बी आरोप लागाड़ेहे. <char style="xt"><ref loc="MIC 2:6">2:6</ref></char> तियाहा काजे, देव तियांआं होयर आरवीत टाकी देय. <char style="xt"><ref loc="MIC 1:6">1:6</ref></char> आन <char style="xt"><ref loc="MIC 3:12">3:12</ref></char> तिहीं रोत तियांहां इस्राएलो रोत सेटे आन यहुदामेहें रोत गुलामीम मोकली देय. पोन तेबी देव तियाआ आथवसन ओर मिके आन थोड़ाक विश्वासी माअहुंहूं वापिस लेत आवे. <char style="xt"><ref loc="MIC 4:6">4:6</ref></char> देवे बेथलेहेमोम रोत एका पुढारी मोन्ज्ये एका ख्रिस्ताहा मोकलीइलोअ आथवसन आप्योतो. ताहां इस्राएल पुरी दुन्यापोअ राज कोअनारो. <char style="xt"><ref loc="MIC 5:4">5:4</ref></char> मिखाआ पुस्तक अब्राहाम आन याकोबोअरीइ देवोअ शप्पत ओर कोइत आपतो जात सेलाअहे. देवोअ मेर-माया तियाआ खोते रोत वादार होय.</para>
  <para style="iot">रुपरेशा</para>
  <para style="io1">1. न्याय आन तारणोअ पेहलू भाग. <char style="ior"><ref loc="MIC 1-2">1—2</ref></char></para>
  <para style="io1">2. न्याय आन तारणोअ दुसरु भाग होय. <char style="ior"><ref loc="MIC 3-5">3—5</ref></char></para>
  <para style="io1">3. न्याय आन तारणोअ तिसरु आन आखरी भाग होय. <char style="ior"><ref loc="MIC 6-7">6—7</ref></char></para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />यहोवा देवे मोरेशेत होयरोमेहें रोनारा मिखाहा यहुदाआ मुलखोअ राजा योताम, आहाज आन हिजकिया यांआं राज कोइलाअ दिहोमेहें तियाआ संदेश आप्यु, मिखे शोमरोन आन येरुसालेमोअ बाप्तिमेहें ओं दर्शन पाल्यो:<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 15:32">2 राजां 15:32</ref>; <ref loc="2KI 16:20">16:20</ref>; <ref loc="2KI 18:1-20:21">18:1—20:21</ref>; <ref loc="2CH 27:1-7">2 इति 27:1-7</ref>; <ref loc="2CH 28:1">28:1</ref>; <ref loc="2CH 32:33">32:33</ref></char></note><verse eid="MIC 1:1" /></para>
  <para style="s">शोमरोन आन येरुसालेमोअ काजे विखु</para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />ओ आखा देसोअ माअहों, तुमू आखे उनाआ;</para>
  <para style="q2" vid="MIC 1:2">ए धरती, तु आन जें तामेहें होय तें आखे दिहान लागाड़ा!</para>
  <para style="q1" vid="MIC 1:2">प्रभु यहोवा तुमाआ विरुद्दाम,</para>
  <para style="q2" vid="MIC 1:2">आन प्रभु तियाआ सोका मंदिरोमेहें रोत तुमाआ बाप्तिम साक्शी आपे.<verse eid="MIC 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />पाला, यहोवा देव तियाआ पवित्र जागाम रोत बारथे निहेंहे,</para>
  <para style="q2" vid="MIC 1:3">तो निसे आवे, आन तो धरतीपोऱ्याआ उसा डोगोपोअ साले.<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />जेहेंकोइत मेणबत्ती आगीवाअहीं ओगलीत जाहे,</para>
  <para style="q2" vid="MIC 1:4">तेहेंकोइत तियाआ गुडाआ थुड़ीइ डोगोअ ओगलीत जाय,</para>
  <para style="q1" vid="MIC 1:4">आन जेहेलोहो काटोपोअ रोत पाअयोंअ खोब्दू निसे पोड़ेहे,</para>
  <para style="q2" vid="MIC 1:4">तेहें कोइत काट फाश्याआ बी वादार उंडा पोड़े.<verse eid="MIC 1:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MIC 1:5" />ओं आखो याकोबोअ पाप आन इस्राएलोअ घराणाआ पापोअ उस्ती ओवेहे. याकोबोअ गुनू की होय? केहें शोमरोन नाहां के? यहुदाआ उसा जागा की होय? केहें येरुसालेम नाहां के? <verse eid="MIC 1:5" /><verse number="6" style="v" sid="MIC 1:6" />तियाहा काजे यहोवा देव कोहे, “आंय शोमरोनोहों रानोमेऱ्याआ टिगोअ होस बोणावी देहीं; एहेलुहू जागु जिहीं माअहें दाराक्शाआ मोलू लागाड़े. आंय तियाआ डोणे बारीमेहें लुड़वी देहीं, आन तियाआ पायू उफड़ीत टाकिहीं. <verse eid="MIC 1:6" /><verse number="7" style="v" sid="MIC 1:7" />तियाआ देवताआ मुर्तीइ पुकरान पुकरा कोई देही; आन जों किबी तिये सिनालो कोइत कामावयोहो तों आगीमेहें नावासट आरवी देहीं. आंय तियाआ आखी मुर्तीही सुउवीत टाकीहीं; काहाके तिये सिनालाआ कामायी वाअहीं तियांहां हाटव्येते, तियाहा काजे रांडीइ कामायीइ होस ते बी आरवाइत जाय.”<verse eid="MIC 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 1:8" />भविश्यवक्ते कोयो, “आंय यी आफतेए काजे विखु कोअहीं; आंय रोड़हीं. आंय बिगर खाहाड़ाआ आन उगड़ाअलुज फिऱ्या कोअहीं; आंय कोल्याआ होस आअड़ीहीं, आन राजकुकड़ाआ होस रोड़हीं. <verse eid="MIC 1:8" /><verse number="9" style="v" sid="MIC 1:9" />शोमरोनोअ दुख केदिहींज ने हुदरे एहेलोहो होय; तियाआ आफत यहुदापोअ बी आवीत पोड़्यी, एतीज नाहां पोन ते माआं पाव्हीइलाअ पोअ आवीत कोइत येरुसालेमोअ गेटोअ जागे जाआं पोतीत गोयीही.”<verse eid="MIC 1:9" /></para>
  <para style="s">दुस्मोनोअ येरुसालेमोअहें जाअलोअ</para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 1:10" />गत होयरोमेहें तियाआ माग मा काडहा, तिहीं तुमू रोड़हा मा; पोन बेथ-आप्रामेहें<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">बेथ-आप्रामेहें </char><char style="ft" closed="false">तुलाआ जागु</char></note> तुलामेहें ओंअडा. <verse eid="MIC 1:10" /><verse number="11" style="v" sid="MIC 1:11" />ओ शापीरोवाली, उगड़ाअली आन विणलाज्यी तुमू निहींत जावा, इंहीं मा रुकाअहा. ओ सानानोवाली गावोंम रोत बारथे नाहां निहींयी; बेथसेलोअ विखु तुमुहूं तिहीं उबू ने रोअहूं देय. <verse eid="MIC 1:11" /><verse number="12" style="v" sid="MIC 1:12" />मारोतोवाली तोम मदतेए वाट जोवी-जोवीइ नाराज गोयीही, काहाके यहोवा देवोअहें रोत येरुसालेमोअ गेटोअ जागे जाआं आफत आवीत पोतीही. <verse eid="MIC 1:12" /><verse number="13" style="v" sid="MIC 1:13" />ओ लाकीशोवाली जोरे गुगदीइनारा कोड़ा गाडामेहें जुपा, आन जावा; काहाके सियोनोवाली<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="fq" closed="false">सियोनोवाली </char><char style="ft" closed="false">सियोनोअ बेटिह्ही</char></note> ताजपोअ रोत पाप कोइलोअ सिकाअयेहे, ताजमेहें इस्राएलवालाआ गुनाआं मिंजो होय. <verse eid="MIC 1:13" /><verse number="14" style="v" sid="MIC 1:14" />तिहीं वाअहीं तु गतोअ मोरेशेतोहो दान आपीत कोइत सेटे कोइ देहीं; अकजीब<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">दोगु</char></note> राजवंश ओं इस्राएली राजहांहां दोगु देय.<verse eid="MIC 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MIC 1:15" />ओ मारीशवाली, आंय तुमापोअ एक आधिकारी ठरवीहीं, आन इस्राएलोअ पुडाऱ्योहों अदुल्लामोअ कुपामेहें आवुहूं पोड़े. <verse eid="MIC 1:15" /><verse number="16" style="v" sid="MIC 1:16" />तुमाआ मेराला पोऱ्याआ काजे दुखोमेहें तियाआ मुन्काआ सिंग्ये कातरावा आन डिगरावाआ होस सोताआ टालगी कोइत ल्या, काहाके तुमाआ पोऱ्ये तुमाआ जागे रोत गुलाम बोणित कोइत जाते रोय.<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s">गोरब्योहो दोमनाराआ की ओवे</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 2:1" />जें पोलांगीपोअ लोट-लोटे खाराब गोठी इतव्या कोअतेहे, आन खाराब कामोअ इश्शा कोअतेहे, आन तें हुजेहे तेहेलाम तियांआं योजनाहां पुरी बी कोअतेहे, तियांआं केतिही वाजे! काहाके एहेलोहो कोइलाआ सेक्ती तियांआं आथोम होय. <verse eid="MIC 2:1" /><verse number="2" style="v" sid="MIC 2:2" />तें बिहीराआ खेतोअ लालस कोअतेहे, आन तियांहां बुउसीत लेतेहे; तें बिहीराआ कोओअ लालस कोअतेहे, आन तें तियांहां बी बुउसीत लेतेहे. तें आहने रोनारा आन तियांआं परिवारोहो दोमतेहे, आन तें बिहीरा माअहुंउं आन तियाआ डायहांआं आथऱ्यीइ मालमिलकत आन तियां माअहुंहूं नेहें दोमतेहे.<verse eid="MIC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3" />“तिहीं वाअहीं यहोवा देव एहें कोहे: आंय यां दोमारा माअहोंअ विरुद्दाम आफतेए योजना बोणावोहो. तुमू यी योजनाआ निसे रोत तुमाआं बोस काडीत ने सेकहा, काहाके ते वेलुज खाराब रोनारी. <verse eid="MIC 2:3" /><verse number="4" style="v" sid="MIC 2:4" />तेहेलाम तुमावाले माअहें तुमाआं नावे लेत साती ठोकी ठोकीइ विखु कोए:</para>
  <para style="b" vid="MIC 2:4" />
  <para style="q1" vid="MIC 2:4">आमू बार्बाद ओत गोये!</para>
  <para style="q1" vid="MIC 2:4">प्रभुउ माअहुंउं डायहांअ आथऱ्युउ जागु बिहीराअ ताबामेहें जाहे,</para>
  <para style="q1" vid="MIC 2:4">तो तियाहा आमाआं आथोम रोत बुउसेहे. आपुहूं दोगू देनाराआ आथोमेहें आपाआ जागु वाटी आपी देहे.”<verse eid="MIC 2:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MIC 2:5" />यहोवाअ मंडड़ीमेहें सिट्टी टाकित कोइत आन दोअड़ी वाअहीं मापित कोइत जागाहा वाटनारो कोडोज ने रोय आन तुमुहूं जागाआ एक तुकड़ू बी ने जोड़े.<verse eid="MIC 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 2:6" />“तियांआं भविश्यवक्ता कोताहा, ‘भविश्यवाणी मा कोअहा, यीं गोठीइ बाप्तिम भविश्यवाणी मा कोअहा, काहाके आमुहूं कोड्लुज अपमान वेठुहूं ने पोड़े.’ <verse eid="MIC 2:6" /><verse number="7" style="v" sid="MIC 2:7" />ओ याकोबोअ घराणा, केहें माहुंउं माहूं ओं प्रश्न फुसीत सेकेहे? ‘केहें यहोवा देवोअ आत्मा धिर टाकित बोठुहू के? केहें एं तियाआ कामे होय के? माआं वसनोवाअहीं जों सिदो सालेहे तियाआ हाजो नाहां ओवतो के?’”<verse eid="MIC 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 2:8" />“पोन तुमू दुस्मोनोअ होस माआं माअहुंउं विरुद्दाम उबा रोया. जें लड़ायीइ इश्शा बी नाहां कोअते, जें तुमापोअ विश्वास कोइत ठावकेज वाटे सालतेहे, तियां भोला भाला माअहोंअ डिलोपोऱ्येए आंगड़े काडीत लेताहा. <verse eid="MIC 2:8" /><verse number="9" style="v" sid="MIC 2:9" />माआं माअहुंउं बोईंहीं तुमू होकेहे रोअलाअ कोअमेहें रोत काडी देताहा, आन तियींइं पोऱ्याहां मी आपल्यी हाजाम हाजी वस्तु एकसोट्यीज बुउसीत लेताहा. <verse eid="MIC 2:9" /><verse number="10" style="v" sid="MIC 2:10" />उठा, आन निहींत जावा! काहाके ओ तुमाआं आरामोअ जागु कायनाहां; यी एठायीइ वाखरी तुमुहूं एकसोट्येज आरवी देय.<verse eid="MIC 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MIC 2:11" />“जर एखु रिकामी गोठी कोअतो आन एहें तेहें ठोगतो फिरेहे, आन एहें कोहे, ‘आंय तुमुहूं कायम दाराक्शाआ रोहोअ आन होराअ बाप्तिमेहें सिकाड़ोहो,’ ताहां तोज यां माअहुंउं भविश्यवक्तू ठरेहे.<verse eid="MIC 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MIC 2:12" />“पोन प्रभु कोहे: आंय हुदाअलीज तुमू आखाहा फाशेए एक्ठे कोअहीं; आंय रोल्या इस्राएलवालाहां फाशुउ एक्ठे कोअहीं; जेहेलोहो कोंडवाड़ामेहें मेडाहां, नेताहां रानोमेहें डोगरान बोकड़ाआ गोवाराहा एकीज जागे लेत रोतेहे, तेहेंज कोइत आंय तुमुहूं मिकीहीं. तुमाआं गणती हाजारेन हाजार ओवे.”<verse eid="MIC 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MIC 2:13" />तियांआं आगाड़ी आगाड़ी कोंडवाड़ाहा तोड़नारु गोयुहू, तियाहा काजे तें बी तियाहा तोड़तेहे, आन बाअणाम रोत सोरकीत बारथे निहींत जातेहे; तियांआं राजा तियांआं आगाड़ी आगाड़ी गोयु मोन्ज्ये यहोवा देवुज तियांआं वाट देखाड़नारु रोय.<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s">इस्राएलवाला पुडाऱ्योंपोअ मिखाआ आरोप</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />ताहां मी कोयो, ओ याकोब पारवाड़ीइ पुढाऱ्यों, माआं गोठ माना! ओ इस्राएलोअ पारवाड़ीइ न्याय कोअनारा, तुमुहूं न्यायोहो उंडे रोत जाइंलोअ इश्शा कायनाहां के? <verse eid="MIC 3:1" /><verse number="2" style="v" sid="MIC 3:2" />तुमू हाजी गोठीइ सीस कोअताहा, पोन खाराब गोठीही मेर कोअताहा. तुमू माआं खाजगी माअहुंउं सांबड़े काडीत लेताहा, आन तियांआं आडोअरीइ माहां होरीत लेताहा; <verse eid="MIC 3:2" /><verse number="3" style="v" sid="MIC 3:3" />एतोज नाहां पोन तुमू माआं वावड़्या माअहुंउं माहां खाताहा, आन तियांआं सांबड़े बी होरीत लेताहा; तुमू तियांआं आडोहो आंड्लामेहें बाफीइलाआ काजे पुकरा कोअताहा आन तियांआं माहां आंड्लामेहें रांदीइलाआ काजे पुकरा कोअताहा. <verse eid="MIC 3:3" /><verse number="4" style="v" sid="MIC 3:4" />ओड़सनीइ वेले तुमू यहोवा देवोहो हाद कोअहा, पोन तो तुमाआं ने उनाय, एतोज नाहां पोन तियी वेले तो तुमाआं खाराब कामोअ वाखरी तुमाअहें रोत सोब फेरवीत लेये.<verse eid="MIC 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5" />यहोवा देवोअ ओं वसन होय के, जे भविश्यवक्ता माआं माअहुंहूं भटकावी देताहा, आन जाहां तियांहां खाअहूं जोड़ेहे, ताहां “हाजो, हाजो” कोत आअड़ीइताहा, आन जर एखू तियांहां खाअहूं किज ने आपे, ताहां तियाअरी सुलाअहूं तियार ओत जाताहा. <verse eid="MIC 3:5" /><verse number="6" style="v" sid="MIC 3:6" />तिहीं वाअहीं तुमापोअ एहेलिही रात आवे के तुमुहूं किज दर्शन ने जोड़े, आन तुमू एहेलाहा आंदारामेहें पोड़हा के भविश्य ने कोत सेकहा. भविश्यवक्ताआं काजे दिही बुडीत जाय, आन तुमाआं दिही बी आंदाराम बोदलात जाय.<note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="AMO 5:18-20">आमोस 5:18-20</ref></char></note> <verse eid="MIC 3:6" /><verse number="7" style="v" sid="MIC 3:7" />दर्शन देखनारे लाजवाय, आन भविश्य कोनाराआ सोब काली ओवे; ते सोताआ सोब टापे, काहाके देव तियांहां उत्तर ने आपे.<verse eid="MIC 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 3:8" />पोन आंय देवोअ सेक्ती, आन यहोवा देवोअ आत्मावाअहीं पोआलू होय; मामेहें न्याय आन ताकत होय, याअकाजे के आंय याकोबोहो तियाआ सुक, आन इस्राएलोहो तियाआ पाप देखाड़ीत सेको. <verse eid="MIC 3:8" /><verse number="9" style="v" sid="MIC 3:9" />ओ याकोबोअ पारवाड़ीइ पुडाऱ्यों, ओ इस्राएल पारवाड़ीइ न्याय कोअनारा, ओं उनाआ! काहाके तुमू न्यायोहो सीस कोअताहा, आन तुमू सिदी गोठीही उलटी-सुलटी कोई देताहा. <verse eid="MIC 3:9" /><verse number="10" style="v" sid="MIC 3:10" />तुमू सियोन होयरोअ खुन कोइत आन येरुसालेमोहों ओन्यायोवाअहीं मजबुत कोअताहा. <verse eid="MIC 3:10" /><verse number="11" style="v" sid="MIC 3:11" />तुमाआं पुडारी लास खात कोइत न्याय कोअताहा, आन पुंजारा पोशा लेत कोइत कायदाआ गोठी सिकाड़ताहा, आन भविश्यवक्ता पोशा लेत कोइत भविश्य कोताहा; तेबी ते एहें कोत यहोवा देवोपोअ भरिवसू मिकताहा, “यहोवा देव आमाआं विसमेहें होय, तिहीं वाअहीं किज अड़सन आमापोअ नाहां आवनारी.”<verse eid="MIC 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MIC 3:12" />तियाहा काजे तुमा वाअहीं सियोन होयर खेड़ल्या खेतोअ होस देखाय; आन येरुसालेम आरवाइलाअ टिग बोणे, आन जिया डोगोपोअ मंदीर बांदाअयोहो, तों उजाड़ीइ उसा जागाआ होस ओत जाये.<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="JER 26:18">यिर्म 26:18</ref></char></note><verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s">शांतीइ राज्य</para>
  <para style="r">(<ref loc="ISA 2:2-4">यश 2:2-4</ref>)</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 4:1" />आखरीइ दिहोमेहें ओं ओवे के यहोवा देवोअ मंदिरोअ डोगोअ आखा डोगोमेहें रोत वोडू मानाय;</para>
  <para style="q2" vid="MIC 4:1">आन तो आखा डोगोम रोत उसू रोय.</para>
  <para style="q1" vid="MIC 4:1">हारेक राज्याआ माअहें खाडीइ होस तियाआ वोगेहे आवे.<verse eid="MIC 4:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 4:2" />आन ते आवित कोइत एहें कोये,</para>
  <para style="q1" vid="MIC 4:2">“आवा आपू यहोवा देवोअ डोगोपोअ सोड़ुहूं,</para>
  <para style="q2" vid="MIC 4:2">याकोबोअ देवोअ मंदिरोमेहें जाहूं;</para>
  <para style="q1" vid="MIC 4:2">ताहां तो आपुहूं तियाआ वाट सिकाड़े,</para>
  <para style="q2" vid="MIC 4:2">आन आपू तियाआ वाटेपोअ सालहूं.”</para>
  <para style="q1" vid="MIC 4:2">काहाके यहोवा देवोअ नियम सियोनोम रोत,</para>
  <para style="q2" vid="MIC 4:2">आन तियाआ आवाज येरुसालेमोम रोत निहे.<verse eid="MIC 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />तो जाअखिलाहा देसोअ माअहुंउं न्याय कोए,</para>
  <para style="q2" vid="MIC 4:3">आन सेटे सेटे जाआं जोराखा राज्याआ माअहें भान्गड़्यी मिटाड़े;</para>
  <para style="q1" vid="MIC 4:3">तियाहा काजे तें सोताआ तारवाइ टिपीत कोइत तियांआं ओलोअ फाल बोणावे,</para>
  <para style="q2" vid="MIC 4:3">आन धाऱ्याआ दात्लू बोणावे;</para>
  <para style="q1" vid="MIC 4:3">ताहां एका राज्याआ माअहें</para>
  <para style="q2" vid="MIC 4:3">बिहीरा राज्याआ माअहुंउं विरुद्दाम फाशेए तारवाआ ने सालाड़े;<note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="JOL 3:10">योएल 3:10</ref></char></note><verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />हारेक माहुंउं तियाआ दाराक्शाआ मोलाम,</para>
  <para style="q2" vid="MIC 4:4">आन अंजीर साड़ोअ थुड़ी आराम लेते बोहीत रोय,</para>
  <para style="q2" vid="MIC 4:4">तियांहां दुस्मोनोअ ताड़ेए बिक ने रोय;</para>
  <para style="q1" vid="MIC 4:4">होरगामेऱ्यीइ सेनाआ प्रभु यहोवा सोताहा ओं कोयोहो.<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="ZEC 3:10">जख 3:10</ref></char></note><verse eid="MIC 4:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MIC 4:5" />आखा देसोअ माअहें जिवज्योअ देवताआ नावोपोअ सालतेहे; पोन आपू हादाजोलोम आपाआ यहोवा देवोअ नावोपोअ सालहूं.<verse eid="MIC 4:5" /></para>
  <para style="s">गुलामीम रोत इस्राएलोअ सुटका</para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 4:6" />यहोवा देव एहें कोहे, “तेदिहीं आंय लेंगड़ाहा टोलु वालीहीं, वेराअलाहा टिग वालीहीं; आन जियांहां तारास देदुतो, तियांहां बी टोलु वालीहीं. <verse eid="MIC 4:6" /><verse number="7" style="v" sid="MIC 4:7" />लेंगड़ाहा आंय बाकी तियांआं राज्य बोणाविहीं. जें बाकी रोयेहे तियांवाअहीं आंय एक ताकतवालो राज्य बोणाविहीं. आज रोत यहोवा देव सियोन डोगोपोअ रोत कोइत तियांपोअ राज्य कोए.”<verse eid="MIC 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 4:8" />ओ एदेरोअ माला! ओ येरुसालेमोअ माल<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="fq" closed="false">माल </char><char style="ft" closed="false">उसू जागु</char></note>! ताहूं पेल्लीइ होस सालती जोड़े, ताहूं येरुसालेमोअ राज्य जोड़े. <verse eid="MIC 4:8" /><verse number="9" style="v" sid="MIC 4:9" />ओ येरुसालेम होयर! तु गोलू फाड़ी फाड़ीइ काहा आअड़ेहे? केहें ताआ जागे एखु राजा कायनाहां के? केहें ताहूं हान देनारे मोइत गोयेहे के जियावाअहीं तु पोटाअरीइ बोईंइ होस ठाल्ली पोड़ीइलोअ पिड़ावाअहीं तोड़पेहे? <verse eid="MIC 4:9" /><verse number="10" style="v" sid="MIC 4:10" />ओ सियोनोअ बेटिह्ही! पोटाअरीइ बोईंइ होस काहेंहें! तु गावोंम रोत बारथे निहींही, आन ताहूं सापड़ा रानोमेहें रोअहूं पोड़े. तु बाबेल देसोमेहें जाही. तिहीं प्रभु ताहूं सोड़वे; ताआ दुस्मोनोअ आथोम रोत यहोवा देव ताहूं वासाड़े. <verse eid="MIC 4:10" /><verse number="11" style="v" sid="MIC 4:11" />ओमे जाअखिलेहे राज्याआ माअहें ताआ विरुद्दामेहें टोलु वोलीत कोइत एहें कोतेहे, “सियोनोहों एठो कोइ द्या, आन आमू आमाआं डोआवाअहीं आरवाअत्लाहा पालहूं.” <verse eid="MIC 4:11" /><verse number="12" style="v" sid="MIC 4:12" />पोन तियांहां यहोवा देवोअ विसार नाहां मुंदू, आन तियाआ योजनाहा नाहां समजीइते, जेहेंकोइत खोलामेहें पुला टिग वालतेहे तेहेंज कोइत यहोवा देव तियांहां सुउवीइलोअ कोअते टिग वाल्येहे.<verse eid="MIC 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MIC 4:13" />“ओ सियोन होयर, उठ! आन मोलो वोल, आंय ताआ हिंगे लोड़ाआ, आन खुऱ्यी इसत्लेए बोणाविहीं; ताहां तु जाअखीला राज्याआ माअहुंहूं सुउवीही, आन तु तियांआं मालधन आखी कोलीइ यहोवा देवोहो भेट कोई देही.”<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 5:1" />ए येरुसालेम होयर! तु ताआ सेयनिकोहों टोलु वाल, काहाके तिये ताहूं केंडवारीत लेदोहो; ते इस्राएलोअ आधिकाऱ्योहों डेंगारी वाअहीं गालोपोअ देय.<verse eid="MIC 5:1" /></para>
  <para style="s">बेथलेहेमोम रोत एका राजाआ आविलोअ वायदो</para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 5:2" />प्रभु कोहे: “ओ एप्राता मुलखोअ बेथलेहेम, तु यहुदामेऱ्योअ आखा रोत हानो होयर होये. पोन तामेहें रोत एका इस्राएलोअ राज कोअनाराहा आंय माआं काजे काडीहीं, तियाआ कुटूंबाआ वेलू आगाड़ी रोतीज सुरु ओवुहू.”<note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 2:6">मत्तय 2:6</ref>; <ref loc="JHN 7:42">योहान 7:42</ref></char></note><verse eid="MIC 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 5:3" />जाअहूं जाआं पोटाअरीइ बोईं पोऱ्याहा ने जल्म आपे, ताअहूं जाआं यहोवा देव इस्राएलवालाहां गुलामीमेहेंज रोअहूं देय, तिहींइं फाटी बाकी रोल्ये इस्राएली तियांआं पाव्हीइलाआ जागे वोलीत आवे. <verse eid="MIC 5:3" /><verse number="4" style="v" sid="MIC 5:4" />आन तो उबु रोत कोइत यहोवा देवे आपल्यी सेक्ती वाअहीं, आन तियाआ यहोवा देवोअ महान नावोवाअहीं, तियांआं सारवाली कोए. ते हाजीहुतेहे रोय, काहाके ओमे तो धरतीइ मेरे-कोरे जाआं महान ठोरे.<verse eid="MIC 5:4" /></para>
  <para style="s">सुटका आन डोंड</para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 5:5" />तो शांतीइ मुल ठोरे. जाहां आश्शूरवाली सेना आपाआ देसोपोअ ताड़ आवे, आन आपाआ राजवाड़ामेहें गुडू मिके, ताहां आपू हांत सारवाल्योहों एतोज नाहां पोन आंठ माअहोंअ पुडारी तियाआ विरुद्दामेहें उबा कोअहूं. <verse eid="MIC 5:5" /><verse number="6" style="v" sid="MIC 5:6" />ते आश्शूर देस आन निम्रोदोअ फोहीइलोअ वाट तारवाइ वाअहीं आरवी देय; आश्शूर आपाआ देसोम आवे, आन आमाआं हाद्दीइ मायते गुडा मिके, तेहेलाम तो माटी तियांआं आथोम रोते आमाआं सुटका कोए.<note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="GEN 10:8-11">उत्प 10:8-11</ref></char></note><verse eid="MIC 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MIC 5:7" />ताहरीइ जाअखीला देसोवाअहीं केंडाअली बाकी रोल्यी याकोबोअ पारवाड़ी यहोवा देवोअहें रोत पोड़नारा साकलाआ होस, आन खोड़ोपोअ पोड़त्ला वोरहातोअ होस ओवे, जों कोडाआज काजे नाहां रुकाअतो आन मोनव्योअ वाट नाहां जोवतो. <verse eid="MIC 5:7" /><verse number="8" style="v" sid="MIC 5:8" />याकोबोअ रोल्ये माअहें आखे राज्य आन देसो देसोअ माअहुंउं विसमेहें एहेलेहे बोणे, जेहेलेहे रानठ्या जनवारोमेहें सिहोंवागोअ होस, आन मेडान बोकड़ाआ गोवारामेहें जुवान सिहोंवागोअ होस बोणे, काहाके जाहां तो तियांआं विसमेहें रोत सोरके, ताहां गोदारु पाड़तुज आन वेतरीइतुज जाय, आन कोडोज ने वासाड़ीत सेके. <verse eid="MIC 5:8" /><verse number="9" style="v" sid="MIC 5:9" />ताआ आथ ताआ विरोध कोअनारापोअ पोड़े आन ताआ आखा दुस्मोन आरवाइत जाय.<verse eid="MIC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10" />यहोवा देव ओं कोहे: “तेदिहीं आंय ताआ विसमेहें रोत ताआ आक्खा कोड़ाहा माइत टाकिहीं, आन ताआ आखा गाडाहा मुड़ीत टाकिहीं. <verse eid="MIC 5:10" /><verse number="11" style="v" sid="MIC 5:11" />आंय ताआ देसोअ आखा होयरोहो आरवीहीं, आन ताआ आखा किल्लाहां ओदारी देहीं. <verse eid="MIC 5:11" /><verse number="12" style="v" sid="MIC 5:12" />आंय ताआ आथोमेऱ्युउ जादू आरवी देहीं, आन ताआ जागे भविश्य कोनारे जिवते ने रोय. <verse eid="MIC 5:12" /><verse number="13" style="v" sid="MIC 5:13" />आंय ताआ मुर्तीही आन ताआ विसमेहें रोत ताआ पुंजीइलोअ पाल्याहा आरवी देहीं; आन तिहीं रोत तु ताआ आथोवाअहीं बोणावल्यी वस्तुउ भक्ती ने कोइत सेकही. <verse eid="MIC 5:13" /><verse number="14" style="v" sid="MIC 5:14" />आंय ताआ विसमेहें रोत आशेरा नावोअ मुर्तीही मुलोम रोत उफड़ीत टाकिहीं, आन आंय ताआ होयरोहो आरवी देहीं. <verse eid="MIC 5:14" /><verse number="15" style="v" sid="MIC 5:15" />आन जे माअहें माआ कोल्ये नाहां मानते, तियांहां आंय जुदी खोतेवाअहीं बोदलू लेहीं.”<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s">इस्राएलोअरी देवोअ राड़</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />“इस्राएलोअ माअहोंअ विरुद्दाम यहोवा देव की कोहे तों उनाआ!</para>
  <para style="p" vid="MIC 6:1">“उठा, डोगोअ सामने यहोवा देवोअरी गोठी कोआ, आन टेंबा बी ताआ उनाअहूं जोवे.<verse eid="MIC 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 6:2" />“ओ डोगोअ, यहोवा देवोअ गोठ उनाआ, आन ए धरतीइ मजबुत पाया, तुमू बी उनाआ; काहाके यहोवा देव तियाआ खाजगी माअहूं पोअ दोस लागाड़ेहे, आन तो इस्राएलोअरी गोठी कोअहे.<verse eid="MIC 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 6:3" />“ए माआं माअहों, आंय तुमाआं की बिगाड़ल्यो? माहूं कोवा के की गोठी वाअहीं आंय तुमुहूं तारास देदू? <verse eid="MIC 6:3" /><verse number="4" style="v" sid="MIC 6:4" />आंय तुमुहूं मिसर देसोम रोत बारथे काड्ये; आंय तुमुहूं गुलामीम रोत काड्ये आन तुमुहूं लेत सालीइलोअ काजे आंय मोशेहे, आरोनोहो, आन मिरयामोहो मोकल्ये.<note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="EXO 4:10-16">निर्ग 4:10-16</ref>; <ref loc="EXO 12:50">12:50</ref>,<ref loc="EXO 12:51">51</ref>; <ref loc="EXO 15:20">15:20</ref></char></note> <verse eid="MIC 6:4" /><verse number="5" style="v" sid="MIC 6:5" />ओ माआं माअहों, ओर कोआ, मोवाबवालू राजा बालाके तुमाआं विरुद्दाम केहेलिही गोठी बोणावयीते, आन बोरोअ पोऱ्यु बालामे तियाहा की सल्लु आप्यु तों ओर कोआ, ताहां शित्तीमोम रोत गिलगालोअ जागे जाआं ओवल्यी गोठीही, मोन्ज्ये यहोवा देवोअ हाजे कामे सोमजीत सेकहा.”<note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="NUM 22:2-24:25">गणती 22:2—24:25</ref>; <ref loc="JOS 3:1-4:19">यहो 3:1—4:19</ref></char></note><verse eid="MIC 6:5" /></para>
  <para style="s">देवोहो की जोवे</para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 6:6" />“आंय कोड्ली वस्तु आथोम लेत कोइत यहोवा देवोअ सामने जांव आन वोडी राजगादीपोअ बोहनारा देवोअ सामने आराधना कोओ? केहें आंय तियाआ सामने आगीइ गाराहा कोइलोअ काजे एका वोरह्योअ गिद्लो लेत जांव के? <verse eid="MIC 6:6" /><verse number="7" style="v" sid="MIC 6:7" />केहें यहोवा देव हाजार मेडावाअहीं आन जेयतुन तेलोअ लाख खाड्यीइ भेटेवाअहीं खुस ओवेहे के? केहें माआं गुनाआं माफीइ काजे डाया पोऱ्याआ गाराहा आपुहूं पोड़े के? माआं जिवे कोअल्या पापोअ बोदले माआं उब्जाड़ल्या एखाहा आपो के? <verse eid="MIC 6:7" /><verse number="8" style="v" sid="MIC 6:8" />ओ मोनवी, यहोवा देवे ताहूं कोयोहो के हाजो की होय; आन तो तापोअ रोत की आहरु कोअहे. ओंज ना के तु न्यायोवाअहीं काम कोअहूं जोवे, आन दया-माया वाअहीं मेर कोअहूं जोवे, आन नम्रतावाअहीं ताआ देवोअ वाटेम सालुहूं जोवे?”<verse eid="MIC 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MIC 6:9" />यहोवा देवोअ आवाज येरुसालेम होयरोहो हाद कोअहे, बुद्दीमान माहुंउं यहोवा देवोअ नावोहो बित सालेहे, “तियाहा तुमू कोत डोंडोअ गोठीपोअ दिहान द्या, जियापोअ मालमिलकत आपीइलोअ आधिकार होय. <verse eid="MIC 6:9" /><verse number="10" style="v" sid="MIC 6:10" />ओमे जाआं पाप्योअ कोअमेहें लबाड़ी वाअहीं कामावल्यी मिलकत आन हानो मापलो सुकीइ कायनाहां के? <verse eid="MIC 6:10" /><verse number="11" style="v" sid="MIC 6:11" />केहें आंय ठोगोअ ताराजू मिकनाराहा, आन सोताआ थेयलीमेहें ठोगोअ वोजनोअ दोगड़ा मिकनाराहा विण डोंड आप्येज सोड़ी देंव? <verse eid="MIC 6:11" /><verse number="12" style="v" sid="MIC 6:12" />ताआ कुन्बी माअहें दोमतेहे आन ताआ रोनारे ठोगतेहे आन तियांआं जिब दोगु देनारी गोठी सोकतीही. <verse eid="MIC 6:12" /><verse number="13" style="v" sid="MIC 6:13" />तियाहा काजे आंय तुमुहूं मारु देएलाआ कोअते सुरवात कोअयीही, आन आंय ताआ पापोअ वाखरी ताहूं उजाड़ी देहीं. <verse eid="MIC 6:13" /><verse number="14" style="v" sid="MIC 6:14" />तु रोटू खाही पोन ने ताराअही, ताआ पोटू कायम ठाल्लुज रोये; तु पोशा मेलवीही ते खोरु, पोन वासाड़ीत ने सेकही, जों किबी तु वासाड़ही, तियाहा आंय तापोअ तारवाआ सालाड़नाराहा आपी देहीं. <verse eid="MIC 6:14" /><verse number="15" style="v" sid="MIC 6:15" />तु ओअही पोन वाडीत ने सेकही; तु जेयतुनोअ तेल पाड़ही, पोन तियाहा मुंडोअरी ने हारीत सेकही; तु दाराक्शाआ रोहो पाड़ही, पोन ने पित सेकही. <verse eid="MIC 6:15" /><verse number="16" style="v" sid="MIC 6:16" />काहाके ते ओम्रीइ रितीपोअ, आन आहाबोअ घराणाआ आखा कामोअ पुरमाणे सालतेहे; आन तुमू तियांआं कामोअ पुरमाणे सालतेहे; तियाहा काजे आंय ताहूं उजाड़ी देहीं, आन या गावोंअ रोनारे माअहें तुमाआ टिंगल कोए.”<note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="1KI 16:23-34">1 राजां 16:23-34</ref>; <ref loc="1KI 21:25">21:25</ref></char></note><verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s">इस्राएलोहो देव माफ कोए</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 7:1" />की ओवे माआं, आंय वेल जावाड़ी देदी! काहाके आंय तियांआं होस ओत गोयू, जेहें कोइत उनालाम फलवे पाड़ीत लेदे तिहीं रोत एक बेन रोत जातेहे, आन दाराक्शे वितीत गोये तिहीं रोत हेरवू रोत जाहे तेहलुहू आंय ओत गोयुहू; माहूं गोमे एहलुहू दाराक्शाआ एखु गुम्सू जाआं ने सापड़्यू आन पेल्ला बारोअ अंजीरोअ एखु फलवो माहूं ने सापड़्यो. <verse eid="MIC 7:1" /><verse number="2" style="v" sid="MIC 7:2" />इमानदार माअहें धरतीपोअ रोत आरवाइत गोयेहे, आन मोनव्योमेहें एक बी सिदो माअहुंउं ने रोयो; आखे माअहें खुन कोइलाअ उद्देशोवाअहीं हेंहींत रोतेहे, आन जाल मांडीत कोइत जिवज्योअ पायहोहो हावोज बोणावतेहे. <verse eid="MIC 7:2" /><verse number="3" style="v" sid="MIC 7:3" />तें तियांआं बेनु आथोवाअहीं मोन लागाड़ीत खाराब कामे कोअतेहे; आधिकारी आन न्यायाधिश लास खाअहूं तियार रोताहा, आन वोडे माअहें तियांआं पोट्टोज कोअतेहे, एहें कोइत एं आक्खे मिलीत कोइत ठोगोअ सालाड़तेहे. <verse eid="MIC 7:3" /><verse number="4" style="v" sid="MIC 7:4" />तियां मेऱ्येए जें आखा रोत हाजे ओते, तें कड़वा साड़ोअ होस दुख आपनारो होय, जो आखा रोत सिदो होय, तो काटावाली वाड़ी रोत बी खाराब होय. ताआ जागल्याहा कोल्यु दिही मोन्जे ताआ डोंडोअ दिही आवित लागुहू. ते ताअहांज फोगजीत जाय. <verse eid="MIC 7:4" /><verse number="5" style="v" sid="MIC 7:5" />दोस्तीपोअ विश्वास मा कोअहा, खास जोड़ीदारोपोअ बी भरिवसू मा मिकहा; एतोज नाहां पोन तुमाआं मेराली लाडीइरी बी सांबालीत रोजा. <verse eid="MIC 7:5" /><verse number="6" style="v" sid="MIC 7:6" />काहाके पोऱ्यु तियाआ आब्हाअ मानपान नाहां कोअतु, आन पोऱ्यी आयहीइ मानपान नाहां कोअती, आन वोवड़ीह्ही हावेह्हेए सोबी लागेहे; आन मोनव्योअ दुस्मोन तियाआ कोऱ्येएज माअहें रोतेहे.<note caller="+" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="MAT 10:35">मत्तय 10:35</ref>,<ref loc="MAT 10:36">36</ref>; <ref loc="LUK 12:55">लुक 12:55</ref> </char></note> <verse eid="MIC 7:6" /><verse number="7" style="v" sid="MIC 7:7" />पोन आंय यहोवा देवोअहें नजर टाकोहो, आंय माआं तारनारा देवोअ वाट पालोहो; माआं देव माआं उनाय.<verse eid="MIC 7:7" /></para>
  <para style="s">तारण देवोअहींज रोत</para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 7:8" />ए माआं दुस्मोन! माहूं पालित खुश मा ओवीही; काहाके आंय पोड़ीहीं तेबी फाशुउ उठीहीं; आन आंय आंदाराम पोड़ीहीं तेबी यहोवा देव माआं काजे उजालो होय. <verse eid="MIC 7:8" /><verse number="9" style="v" sid="MIC 7:9" />आंय यहोवा देवोअ विरुद्दाम पाप कोअयुहू, जाअहूं जांआं यहोवा माआं आडवारी ने पोड़े, आन माआं वोगेहे निर्णय ने आपे, ताअहूं जांआं माहूं तियाआ खोत वेठुहूंज पोड़े. तो माहूं उजालाअ जागे जांआं पोताड़े; आन आंय तियाआ न्याय पालिहीं. <verse eid="MIC 7:9" /><verse number="10" style="v" sid="MIC 7:10" />ताहां माआं दुस्मोन जो माहूं ओं कोहे के, ताआ यहोवा देव का टोलीत गोयु, तें बी तियाहा पाले आन लाजे वाअहीं सोब टापे. आन आंय माआं डोआवाअहीं तियाहा पालिहीं; ताहां तें वाटेए मेरेए गाराआ होस टाकी देवाय. <verse eid="MIC 7:10" /><verse number="11" style="v" sid="MIC 7:11" />ताआ होयरोअ वाड़ बांदीइलाआ दिही आवे, तेदिहीं ताआ हींव पोली ओवे. <verse eid="MIC 7:11" /><verse number="12" style="v" sid="MIC 7:12" />तेदिहीं आश्शूर होयरोम रोत्ते मिसर देसोम जांआं, आन मिसरोम रोत्ते फरात नोयीइ जागे जांआं, आन एकी दोऱ्या रोत्ते बिहीरी दोऱ्या, आन एका डोगोअ रोत्ते बिहीरा डोगोअ रोनारे माअहें ताआ जागे आवनारे. <verse eid="MIC 7:12" /><verse number="13" style="v" sid="MIC 7:13" />तेबी धरतीपोअ रोनारा वाअहीं आन तियांआं खाराब कामोअ फलोअ वाखरी उजाड़ुज रोय.<verse eid="MIC 7:13" /></para>
  <para style="s">इस्राएलोपोअ देवोअ दया</para>
  <para style="p">
    <verse number="14" style="v" sid="MIC 7:14" />सोताआ माअहोंअ राखवाली आन सोताआ इसामेहें जोड़ल्या मेडाआ टोलाआ राखवाली ताआ डेंगारी वाअहीं कोअजी, जे उजाड़ जागामेहें आन हाजा जागाआ विसमेहें रोतेहे. तियांहां पेल रोतुज जेहेलोहो बाशान आन गिलादोअ जागामेहें सोरुहूं द्या.<verse eid="MIC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MIC 7:15" />जेहेलेहे मिसर देसोम रोत ताआ निहीत आवीइलोअ दिहोमेहें बोगलाइलाअ कामे देखाड़्ये, तेहेलेज ओमे आंय तियाहा देखाड़ीहीं. <verse eid="MIC 7:15" /><verse number="16" style="v" sid="MIC 7:16" />आक्खे देसे ते केतेहे बी सेक्तीमान काहा नाहां रोते, ते इस्राएल देसोहो पालीत कोइत बोगलाइत जाये. आन तियांआं कानोअ पोड़दा फाटीत जाय; आन तियांआं सोबीम रोत आवाज ने निहे. <verse eid="MIC 7:16" /><verse number="17" style="v" sid="MIC 7:17" />ते होरतींडनारा जिवतोरोअ होस, हापोअ होस तुलो साटे, आन ते कापते- कापते तियांआं दोराम रोत बारथे निहे. आन ते बिते-बिते आपाआ यहोवा देवोअ जागे जाये; ते ताआ ताके कापे. <verse eid="MIC 7:17" /><verse number="18" style="v" sid="MIC 7:18" />ताआ होसऱ्युउ एहेलुहू देव का होय जो पापोहो माफ कोए आन सोताआ खाजगी वासाअला माअहुंउं पापोहो टापी देय? तु सादाज नाहां खोत कोअतु रोतु, काहाके तु दया वाअहीं खुस ओवेहे. <verse eid="MIC 7:18" /><verse number="19" style="v" sid="MIC 7:19" />तु आमापोअ फाशुउ दया कोअही, आन आमाआं पापोअ कामोहों सोताआ गुडाआ थुड़ी सेंदीत टाकही, तु आमाआं आखा पापोहो उंडा दोऱ्यामेहें टाकी देही. <verse eid="MIC 7:19" /><verse number="20" style="v" sid="MIC 7:20" />तु याकोबोअ बाप्तिमेहें ते खोरी गोठ कोअही, आन अब्राहामोअ बाप्तिमेहें ते मेर देखाड़ही, जियीइ शप्पत तुमे जुनावाडोअ दिहोम रोत्ते ओमे जाआं आमाआं वेगाआ डायहांअरी खातु आयुहू.<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>