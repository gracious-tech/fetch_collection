<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="DAN" style="id">- Noiri</book>
  <para style="h">दानियेल</para>
  <para style="toc3">दानि</para>
  <para style="toc2">दानि</para>
  <para style="toc1">दानियेलोअ पुस्तक</para>
  <para style="mt2">दानिएलाचे पुस्तक</para>
  <para style="mt1">दानियेलोअ पुस्तक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">ओं दानियेलोअ पुस्तक बाबेलोम इस्राएल माअहें गुलामीम ओते, तेहेलाम दानियेलोअ जिवन आन भविश्यामेहें ओवनारी गोठीइ दर्शने कोत आपेहे. ओं पुस्तक दानियेल आन तियाआ दोस्त्योंअ इमानदारी, तेहेंज कोइत देसोओं आन दुन्याआं बाप्तिमेऱ्यीइ भविश्यवाणी कोत देखाड़ेहे. ओं पुस्तक एक आंदास सोव होव पास ते पास होव पोस्तीस वोरह्योंअ जाआं वेल देखाड़ेहे. जिहींम दानियेले बाबेलोम शार आलाग-आलाग राजहांआं राजोम सेवा कोअयीते. आखे ओं मानतेहे के दानियेले सोताहा ओं पुस्तक बाबेलोम ओतू तेहेलाम लेख्यो, पोन थोड़ाक आज्याआ जाणकार एहें कोताहा के ओं इ.स. आगोदर दुसरा शतकोम इस्राएलोम लेखाअयोतो. थोड़ाक जोओं कोताहा के या पुस्तकोअ थोड़ुक भाग आलाग-आलाग वेलेपोअ लेखाअयुतो.</para>
  <para style="ip">दानियेलोअ पुस्तक गुलामीम रोनारा इस्राएलवाला माअहोंपोअ कठीण वेल आवयी, ताहां तियांआं आवनारी पिड़ीही बी आशा जोड़े तेहें काजे लेख्योतो. दानियेलोअ जिवनोमेऱ्यीइ घटनाआं आन भविश्याआ बाप्तिम भविश्यवाणी वाअहीं देव राजहां आन देसोंपोअ तियाआ ताकत देखाड़ेहे. बायबलोअ संदर्भाम ओं नवा नियमोम देवोअ राज समजीइलोअ काजे मदत कोअहे. <char style="xt"><ref loc="DAN 7:13-14">दानि 7:13-14</ref></char> ख्रिस्ताआ बाप्तिम भविश्यवाणी कोअयीही. आखरीइ दिहोअ बाप्तिम दानियेलोअ दर्शनोहो <char style="xt"><ref loc="MAT 24:15">मत्तय 24:15</ref></char>, <char style="xt"><ref loc="MRK 13:14">मार्क 13:14</ref></char> आन योहानोअ प्रगटीकरणोहों ईसु कोत देखाड़ेहे. दानियेल यिर्मयाआ भविश्यवाणीपोअ बी विसार कोअहे. <char style="xt"><ref loc="DAN 9:1-3">दानि 9:1-3</ref> </char></para>
  <para style="iot">रुप-रेशा</para>
  <para style="io1">1. नबुकदनेस्सरोअ राजोमेहें बाबेलोमेऱ्याआ दानियेल आन तियाआ दोस्त्योंअ बाप्तिम कोत देखाड़ेहे. <char style="ior"><ref loc="DAN 1-4">1—4</ref> </char></para>
  <para style="io1">2. राजा बेलेतशेस्सरोअ दर्शन आन तियाआ अर्थ दानियेल कोत आपेहे.<char style="ior"><ref loc="DAN 5">5</ref></char></para>
  <para style="io1">3. दारा राजाआ राजोम सिहांवागोअ दोरसाम दानियेलोअ घटना. <char style="ior"><ref loc="DAN 6">6</ref></char></para>
  <para style="io1">4. भविश्याम ओवनारी घटनाआं बाप्तिम दानिएलोहो देवोअ खुलासू. <char style="ior"><ref loc="DAN 7-12">7—12</ref></char></para>
  <para style="io1">क. भविश्याआ बाप्तिम दानियेलोहो बेन दर्शनोअ खुलासू. <char style="ior"><ref loc="DAN 7-8">7—8</ref> </char></para>
  <para style="io1">ब. दानियेल तियाआ माअहोंअ काजे प्रार्थना कोइलो आन गाब्रियेल देवदुतो वाअहीं तियाहा उत्तर जोड़ीइलो.</para>
  <para style="io1">क. भविश्यामेऱ्यीइ आखरीइ वेल घटनाआं बाप्तिम गाब्रियेल देवदुतोअ खुलासू.</para>
  <chapter number="1" style="c" sid="DAN 1" />
  <para style="s">दानियेल आन तियाआ दोस्ती</para>
  <para style="r">(<ref loc="DAN 1:1-6:28">1:1—6:28</ref>)</para>
  <para style="s">शार जुवान नबुकदनेस्सरोअ राजसभामेहें</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1" />यहुदाआ राजा यहोयाकीमोअ सालतीइ तिसरा वोरह्योम बाबेलोअ राजा नबुकदनेस्सरे येरुसालेमोहों केंडवारीत लेदोन लड़ाय कोइलोअ तियारी कोअयी.<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2 राजां 24:1</ref>; <ref loc="2CH 36:5-7">2 इति 36:5-7</ref></char></note> <verse eid="DAN 1:1" /><verse number="2" style="v" sid="DAN 1:2" />ताहां प्रभु देवे यहुदाआ राजा यहोयाकीमोहों आन तियाआ होयरोहो नबुकदनेस्सरोअ आथोम होपी देदो. नबुकदनेस्सर यहोवा देवोअ मंदिरोअ थोड़हा सोका बासनोपोअ बी आधिकार लेत लेदू, आन तो तियां बासनोहों शिनार देसोमेर्‍याआ तियाआ देवताआ मंदिरोम लेत जातु रोयू. आन तियां बासनोहों तियां देवताआ कोअमेहें मिकी देदे.<note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="GEN 10:10">उत्प 10:10</ref></char></note><verse eid="DAN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 1:3" />ताहां तिये राजे इस्राएली राजपरिवारोम आन हाजा नावलाअला माट्योमेहें रोत एहेलाहा वार जुवान्याहां लेतावे तेहें काजे तियाआ आधिकाऱ्योअ मुख्या अश्पनजोहो आदेश आप्यु. <verse eid="DAN 1:3" /><verse number="4" style="v" sid="DAN 1:4" />ते जुवान निर्दुस, देख्याम बाहरी होबात्लाहा आन आखी गोठीम कोड़ाअला, आन बुद्दी वाअहीं पोआला आन जाणकार रोअहूं जोवे. ते राजमाहालोमेहें सेवा कोअहूं जोगाहा जोवे, आन तियांहां खास्द्याआं शास्र आन बाशाआ हिकवण आपाअहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2KI 20:17">2 राजां 20:17</ref>,<ref loc="2KI 20:18">18</ref>; <ref loc="2KI 24:10-16">24:10-16</ref>; <ref loc="2CH 36:10">2 इति 36:10</ref>; <ref loc="ISA 39:7">यश 39:7</ref>,<ref loc="ISA 39:8">8</ref> </char></note> <verse eid="DAN 1:4" /><verse number="5" style="v" sid="DAN 1:5" />ते पोहाअता रोअहूं जोवे काजे राजा तियाआ रोटू आन पीइलाआ दाराक्शाआ रोहो<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">दाराक्शाआ रोहो </char><char style="ft" closed="false">दाराक्शाआ माणू रोहो.</char></note> तियांहां तिन वोरह्ये जाआं आपीइलोअ आदेश आप्यु, तिहींइं फासाड़ी तियांहां राजाआ सामने हजर कोअहूं जोवे. <verse eid="DAN 1:5" /><verse number="6" style="v" sid="DAN 1:6" />तियांमेहें यहुदाआ कुलोअ निवड़ीइल्या दानियेल, हनन्या, मिशाएल, आन अजऱ्या नावोअ यहुदी ओता. <verse eid="DAN 1:6" /><verse number="7" style="v" sid="DAN 1:7" />मुख्य आधिकाऱ्योअ मुख्ये तियांआं नावे बिहीरे मिक्ये; मोन्ज्ये दानियेलोअ नाव बेलेतशेस्सर, हनन्याआ शद्रक, मिशाएलोअ मेशक, आन अजऱ्याआ नाव अबेदनगो मिक्यो.<verse eid="DAN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 1:8" />पोन राजा जो रोटू खातुतो आन जो दाराक्शाआ रोहो पितुतो, तो खात-पित कोइत ने विट्लीइलोअ काजे दानियेले तियाआ मोनोम ठरवीत लेदो आन तियाहा काजे तिये आधिकाऱ्योअ मुख्याहा रावणी कोअयी. <verse eid="DAN 1:8" /><verse number="9" style="v" sid="DAN 1:9" />देवे आधिकाऱ्योअ मुख्याआ मोनोम दानियेलोअ बाप्तिम मेर-माया पोई देदी. <verse eid="DAN 1:9" /><verse number="10" style="v" sid="DAN 1:10" />आधिकाऱ्योअ मुख्ये दानियेलोहो कोयो, “आंय माआ मालख्योहो बिहो, काहाके तुमाआ खाअलो-पीइलोअ तियेज ठरव्योहो, एहेलोहो ने ओवुहूं जोवे के तु ताअरीइ बाकी जुवानोअ रोत जाअखु रेज्यालू आन नाराज देखाअही आन राजा माहूं माअतीज टाकी देय.”<verse eid="DAN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 1:11" />ताहां आधिकाऱ्योअ मुख्याहा जियाहा दानियेल, हनन्या, मिशाएल, आन अजऱ्या याआं साकरी कोए तेहें मिक्युतो, तियाहा दानियेले कोयो, <verse eid="DAN 1:11" /><verse number="12" style="v" sid="DAN 1:12" />“आंय ताहूं विनंती कोअहो, के ताआ सेवकोहों दोहो दिही जाआं तापास आन आमाआ खाअलाआ काजे पाजोपालो आन पीइलाअ काजे पाईं एतोज आपजी. <verse eid="DAN 1:12" /><verse number="13" style="v" sid="DAN 1:13" />ताहरुउ दोहो दिहोअ फासाड़ी आमाआ सोब आन जे जुवान राजाआ खाणो खाताहा तियांआं सोब पालजी; आन ताहूं पोटे तेहेलोहो आमुहूं वागवीइजी.”<verse eid="DAN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 1:14" />तियांआं ए रावणी तिये मानित लेदी, आन दोहो दिही जाआं तियांहां फारकीइतु रोयु. <verse eid="DAN 1:14" /><verse number="15" style="v" sid="DAN 1:15" />दोहो दिहोअ फासाड़ी तियांआं सोब राजाअ खाणो खानारा जुवानोअ रोत वादार हाजी आन नेरी देखाअयी. <verse eid="DAN 1:15" /><verse number="16" style="v" sid="DAN 1:16" />ताहां तो मुख्यू तियांआं खाणो आन तियांआं पीइलोअ काजे ठरवीइल्यु दाराक्शाआ रोहो सोड़ीत, तियांहां पाजोपालोज आपू वोल्यू.<verse eid="DAN 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 1:17" />यहोवा देवे तियां शारुहू आखी जातीइ हिकवोणीम आन शास्राआ आखी जातीइ विद्यामेहें समजदारी आन ओकल आप्यी; आन दानियेल आखी जातीइ दर्शन आन होपनाआ अर्थ जांअनारु ओत गोयु.<verse eid="DAN 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 1:18" />नबुकदनेस्सर राजे जुवानोहों राजमहालोम लेत आवीइलोअ काजे तिन वोरह्ये जाआं आदेश आप्युतो आन ते दिही सेका, तिहींइं फाटी आधिकाऱ्योंअ मुख्यू तियांहां राजाअ सामने लेत गोयु. <verse eid="DAN 1:18" /><verse number="19" style="v" sid="DAN 1:19" />राजा तियांअरी गोठी कोउ वोल्यु; आन दानियेल, हनन्या, मिशाएल, आन अजऱ्या याआं बोराबर तियां आखामेहें कोडोज ने ठर्‍यो; तिहींइं काजे ते राजाआ सामने हजर रोना वोल्या. <verse eid="DAN 1:19" /><verse number="20" style="v" sid="DAN 1:20" />बुद्दी आन हारेक जातीइ सोमोजोअ बाप्तिम जों किबी राजा तियांहां फुसतुतो, तियामेहें ते राज्यामेर्‍याआ आक्खा माहाराज आन जादूगार रोत दोहो भाग वादार समजदार निहींताते. <verse eid="DAN 1:20" /><verse number="21" style="v" sid="DAN 1:21" />आन दानियेल कोरेश राजाआ सालतीइ पेलठे वोरह्ये जाआं तिहीं सेवा कोअतू रोयु.<verse eid="DAN 1:21" /></para>
  <chapter eid="DAN 1" />
  <chapter number="2" style="c" sid="DAN 2" />
  <para style="s">नबुकदनेस्सर राजाआ होपनो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1" />नबुकदनेस्सर राजाआ सालतीइ दुसरो वोरिही ओतो. तेहलामेहें एहेलोहो होपनो तिये देख्यो के जिहींवाअहीं तो उत्क्राअयु आन तियाआ डोआम रोत निंद उडीत गोयी. <verse eid="DAN 2:1" /><verse number="2" style="v" sid="DAN 2:2" />ताहां राजे आदेश आप्यू, के माहाराज, बोड़वा, जादूगार आन खास्द्यां यां आखाहा हादा के राजाहा तियाआ होपनो कोत आपीत सेके;<note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="GEN 41:8">उत्प 41:8</ref></char></note> तिहींइं काजे ते आवया आन राजाआ सामने हजर ओवा. <verse eid="DAN 2:2" /><verse number="3" style="v" sid="DAN 2:3" />ताहां राजे तियांहां कोयो, “मी एक होपनो पाल्योहो, आन माआ मोन जास्ती फिकरेम होय, के आंय या होपनाहां कि कोइत समजो?”<verse eid="DAN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 2:4" />ताहां खास्द्यां राजाहा अरामी बाशामेहें<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="fq" closed="false">बाशामेहें </char><char style="ft" closed="false">इंहीं रोत ते हांतवा आध्यायोअ सेवटी जाआं वापराअली बाशा इब्रानी नाहां, पोन अरामी बाशा होय.</char></note> कोयो, “राजा, तु कायम जिवतू रोअहूं जोवे! तू आमुहूं ताआ होपनो को, आन आमू तियाआ अर्थ कोहूं.”<verse eid="DAN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 2:5" />राजे तियां खास्द्याहां उत्तर आप्यो, “ओ आदेश आंय आपीत सुकुहू के जर तुमू माआ होपनो आन तियाआ अर्थ माहूं ने कोत आपहा, ताहां तुमू पाक्का जाईंत ल्या के आंय तुमाआं पुकरान पुकरा कोई देहीं आन तुमाआं कोएं पेटाड़ी देहीं. <verse eid="DAN 2:5" /><verse number="6" style="v" sid="DAN 2:6" />पोन जर तुमू माआ होपनो आन तियाआ अर्थ बी कोत देहा, ताहां आंय तुमुहूं जुदा-जुदा इलाम, भेट आन वोडू मानपान आपहीं. तिहींइं काजे ओमे तुमू माहूं होपनो आन तियाआ अर्थ बी कोत आपा.”<verse eid="DAN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 2:7" />तियां बिहीरी वारी राजाहा कोयो, “राजा, ताआ होपनो आमुहूं कोत आपेए, ताहां आमू तियाआ अर्थ समजाड़ी देहूं.”<verse eid="DAN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 2:8" />राजे तियांहां उत्तर आप्यो, “माहूं पाक्कू मुंदू होय के तुमू ए गोठी निस्ती वेल जावाड़ीइलोअ काजे कोया कोअताहा, काहाके माआ गोठ पाक्की ओत गोयीही ओं तुमुहूं मुंदू पोड़ीत गोयुहू एहलोहो माहूं लागेहे. <verse eid="DAN 2:8" /><verse number="9" style="v" sid="DAN 2:9" />तियाहा काजे जर तुमू माहूं होपनो ने कोहा, ताहां तुमाआ काजे मोतोअ डोंड ठरवीइल्युज होय. काहाके तुमू तुमातुमाआज एक गोठ कोइत रोया ओय, के जाअहूं जांआं वेल ने बोदलाय, ताअहूं जाआं आपू राजाआ सामने ठोगोअ आन बोणावटी गोठी कोया कोअहूं. तियाहा काजे तुमू माहूं होपनो कोवा, ताहां माहूं मुंदू जाय के तुमू तियाआ अर्थ बी समजाड़ीत सेकहा.”<verse eid="DAN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 2:10" />तियां खास्द्यां जाणकारो राजाहा कोयो, “धरतीपोअ एहेलोहो कोडोज नाहां ओवो, जों राजाआ मोनोमेर्‍यीइ गोठ कोत सेके; आन याआ सारकू कोडू बिहीरु राजा, मंत्री आन आधिकारी नाहां जी ओवू, जिये माहाराज, बोड़वा आन खास्द्याहां एहेलिही गोठ फुशीये. <verse eid="DAN 2:10" /><verse number="11" style="v" sid="DAN 2:11" />जे गोठ राजा फुसेहे ते जास्ती कठीण होय, एहेलिही गोठ ते देवेज कोत सेकतेहे, पोन देवे ताम मोनव्योम नाहां रोते.”<verse eid="DAN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 2:12" />ए गोठ उनात कोइत राजा हाजीक खिजवाअयू, आन खोतेए बाल्लायी आखा बाबेलोवाला जाणकारोहों माइत टाकीइलोअ आदेश आप्यू. <verse eid="DAN 2:12" /><verse number="13" style="v" sid="DAN 2:13" />आखा बाबेलवाला जाणकारोहों माइत टाकीइलोअ आदेश निहील्यू देखीत राजाआ माअहें दानियेल आन तियाआ हात्योहों बी माइत टाकीइलोअ काजे होदीत फिरतेते.<verse eid="DAN 2:13" /></para>
  <para style="s">देवोअ तरफ से दानियेलो वाअहीं राजाआ होपनाआ खुलासू</para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14" />बाबेलोवाला जाणकारोहों माइलोअ काजे निहींनारा तिया राजाआ राखवाली कोअनारा मुख्या आर्योकोहो दानियेले वारुहूं विसार कोइत ओकले वाअहीं समजाड़ीत देखाड़्यो; <verse eid="DAN 2:14" /><verse number="15" style="v" sid="DAN 2:15" />तिये आर्योकोहो फुशो, “एतू कठीण आदेश राजाआ जिबानीम रोत काहा निहींयू?” ताहां आर्योके दानियेलोहो उंडे रोत कोत देखाड़्यो.<verse eid="DAN 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 2:16" />ताहरुउ दानियेले राजाहा होपनाआ अर्थ कोत देखाड़ीइलोअ काजे एखू वेल ठरवुहूं जोवे कोत मांय जात कोइत राजाहा रावणी कोअयी. <verse eid="DAN 2:16" /><verse number="17" style="v" sid="DAN 2:17" />ताहां दानियेल कोअ जात कोइत तियाआ हाती हनन्या, मिशाएल, आन अजऱ्या यांहां खबर कोई देदी. <verse eid="DAN 2:17" /><verse number="18" style="v" sid="DAN 2:18" />यी गोठीइ बाप्तिम होरगामेर्‍याआ देवोअ दया जोड़े तेहें प्रार्थना कोआ, बाबेलोवाला आखा जाणकारोअरी दानियेल आन तियाआ हात्योहों बी ने माअहूं जोवे. <verse eid="DAN 2:18" /><verse number="19" style="v" sid="DAN 2:19" />तेहेलाम ए दोड़ाअली गोठी दानियेलोहो राती दर्शनोमेहें होरगामेर्‍येए देवे प्रगट कोअयी. ताहां दानियेले होरगामेर्‍याआ देवोअ धन्यवाद कोअयो.<verse eid="DAN 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="DAN 2:20" />“देवोअ नावोहो हादाफल धन्यवाद;</para>
  <para style="q2" vid="DAN 2:20">काहाके बुद्धी आन ताकत तियाआ होय!<verse eid="DAN 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="DAN 2:21" />वेल आन दिहोहो तोज बोदलीइत्लू;</para>
  <para style="q2" vid="DAN 2:21">राजहांहां बोहाड़ीलोअ आन उतारीइलो तियाआज काम होय;</para>
  <para style="q2" vid="DAN 2:21">ओकल्याहां ओकल आन हानालाहां हान तोज आपत्लू;<verse eid="DAN 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="DAN 2:22" />दोड़ाअली गोठी तोज उखरीत काड्त्लू;</para>
  <para style="q2" vid="DAN 2:22">तियाहा आंदारामेऱ्यीइ गोठी मुंदू होय;</para>
  <para style="q2" vid="DAN 2:22">आन उजालो हादाफल तियाअरी रोहे.<verse eid="DAN 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="DAN 2:23" />ए माआं डायहांआं देव, आंय ताआ धन्यवाद आन स्तुती कोअहो,</para>
  <para style="q1" vid="DAN 2:23">काहाके तुमे माहूं बुद्दी आन सेक्ती आप्यीही,</para>
  <para style="q2" vid="DAN 2:23">आन ओमे तुमे ते उंडेए गोठी माहूं कोत देखाड़्यी, जे आमू तापोअ माग्यीते;</para>
  <para style="q2" vid="DAN 2:23">तुमे आमुहूं राजाआ गोठ कोत आप्यीही.”<verse eid="DAN 2:23" /></para>
  <para style="s">राजाआ होपनो आन तियाआ अर्थ कोत आपीइलोअ</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24" />ताहां राजा बाबेलोअ जाणकारोहों आरवीइलाअ कोअते निवड़ कोअयीते, जियाहा आर्योकोअ जागे मायते जात कोइत दानियेले कोयो, “बाबेलोमेर्‍याआ जाणकारोहो मा आरवीही, पोन माहूं राजवाड़ामेहें राजाआ जागे लेत साल, आंय राजाहा तियाआ होपनाआ अर्थ कोहीं.”<verse eid="DAN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 2:25" />ताहरुउ आर्योक दानियेलोहो ताबुड़ राजमहालोम लेत गोयु, आन तिये राजाहा एहें कोयो, “राजा माहूं यहुदी गुलामोमेहें एक माटी सापड़्युहू, जो ताआ होपनो आन तियाआ अर्थ ताहूं कोत सेकेहे.”<verse eid="DAN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 2:26" />राजा दानियेलोहो फुशो, जियाआ नाव बेलतशस्सर बी ओतो, “केहें जों होपनो आंय पाल्योहो, तियाआ अर्थ कोअलोअ तामेहें एतिही सेक्ती होय के?”<verse eid="DAN 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 2:27" />दानियेले राजाहा उत्तर आप्यो, “राजा, जे उंडेए गोठ तुमे फुशीही, तियीही नाहां जादूगार, नाहां माहाराज, नाहां खास्द्यां, आन नाहां बोड़वा कोत सेकता, <verse eid="DAN 2:27" /><verse number="28" style="v" sid="DAN 2:28" />पोन उंडेए गोठीइ अर्थ कोत आपनारु होरगामेऱ्युउ देवुज होय; आन तियेज नबुकदनेस्सर राजा ताहूं सेवट्याआ दिहोमेहें कि कि ओवनारो होय तों कोयोहो. तु हुवत्लु तेहेलाम जों होपनो देखाअयोहो, तों ओं होय:<verse eid="DAN 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 2:29" />“राजा, जेहेलाम लोटलोटू भविश्यामेहें कि कि ओवनारोहो यीं गोठीइ विसार कोअया कोअतुतो, तेहेलाम उंडेए गोठीइ अर्थ कोत आपनारे देवे ताहूं कि कि ओवनारो होय तों कोयो. <verse eid="DAN 2:29" /><verse number="30" style="v" sid="DAN 2:30" />आंय आखा माअहोंम रोत हुशार होंव काजे ए गोठ माहूं नाहां कोयी, पोन ताहूं समजाअहूं जोवे काजे या होपनाआ अर्थ राजाहा कोत आपोहो, ताहां तु ताआ मोनोअ विसार समजीत सेकही.<verse eid="DAN 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 2:31" />“राजा, जेहेलाम तु होपनो पालतुतो, तेहेलाम ताहूं एक वोडी मुर्ती देखाअयी जे ताआ आगाड़ी उबी ओती. ते नांबीन पोली ओती; ते जुदी समकीइतीते, आन तियी मुर्तीइ रुप जुदू ओतु. <verse eid="DAN 2:31" /><verse number="32" style="v" sid="DAN 2:32" />तियी मुर्तीइ मुनको सोका होनाआ ओतो, तियीइ सातिन आथ सांदीइ ओता, तियीइ पोटू आन कंबर तांबाआ ओती. <verse eid="DAN 2:32" /><verse number="33" style="v" sid="DAN 2:33" />तियीइ टोसणे लोड़ाआ आन तियीइ गुडा थोड़ाक लोड़ाआ आन थोड़ाक कादवोअ ओता. <verse eid="DAN 2:33" /><verse number="34" style="v" sid="DAN 2:34" />फाशोअ पालता पालतामेहें ताहूं एहलोहो देखाअयो के एक डोण कोडोज ने लुड़वीइता, तो तिया तियाआज मुर्तीइ गुडापोअ आवीत पोड़्यु, आन तियी मुर्तीही सुउवीत उडाड़्यी. <verse eid="DAN 2:34" /><verse number="35" style="v" sid="DAN 2:35" />जेहेलोहो उनालामेहें खोलामेऱ्योअ पुहूटो वाराअरी उडीत जाहे, तेहेलोहो तों लोड़ाआ, कादुउ, तांबाआ, सांदीइ आन होनाआं आखो जों ओतो तों उडीत गोयो आन तियी मुर्तीइ वाहीं पात्तु ने साल्यु, आन जो डोण मुर्तीपोअ पोड़्युतो, तो डोण वोडू डोगोअ बोणीत कोइत पुरी धरतीपोअ पसरीत गोयु.<verse eid="DAN 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 2:36" />“राजाआ होपनो ओंज होय; आन ओमे आंय राजाहा होपनाआ अर्थ समजाड़ीत कोहीं. <verse eid="DAN 2:36" /><verse number="37" style="v" sid="DAN 2:37" />राजा, तु ताम आखा राजामेहें रोत वोडू राजा होय, ताहूं होरगामेर्‍येए देवे राज्य, सेक्ती, सालती आन महिमा आप्यीही. <verse eid="DAN 2:37" /><verse number="38" style="v" sid="DAN 2:38" />देव ताआ आथोम धरतीपोर्‍येए आक्खे माअहें, जंगलोमेर्‍येए जनवारे आन जुगोमेर्‍येए सिड़े होप्येहे; आन राजा, देवुज ताहूं तियांपोअ आधिकार सालवीइलोअ सेक्ती आप्यीही आन ओं होनाअ मुनको तुज होय. <verse eid="DAN 2:38" /><verse number="39" style="v" sid="DAN 2:39" />ताआ फासाड़ी फाशोअ दुसरो राज उबो रोय, तों ताआ राजो रोत हानो रोय; फाशोअ एक तिसरो राज इसत्लेए होस उबो रोय, जों पुरी धरतीपोअ राज कोए. <verse eid="DAN 2:39" /><verse number="40" style="v" sid="DAN 2:40" />ताहां शोवथो राज्य उबो रोय जों लोड़ाआ होस मजबुत रोय; जेहेलोहो लोड़ो आखी वस्तुहू सुउवीत टाकेहे, तेहेंज कोइत ओं राज बी यां आखाहा सुउवीत टाके. <verse eid="DAN 2:40" /><verse number="41" style="v" sid="DAN 2:41" />राजा, तुमे जे मुर्तीइ गुडा आन इंगाअठ्यी पाल्यी, ते थोड़ही कुंबारोअ कादवोअ आन थोड़ही लोड़ाआ ओती, तेहेलोहो ओं शोवथो राज बी वाटाअलो रोय; तेबी कादवोम पेलाअलो लोड़ो जेहेलोहो वातड़ो रोहे तेहेलोहो तों राज बी वातड़ो रोय. <verse eid="DAN 2:41" /><verse number="42" style="v" sid="DAN 2:42" />जेहेलीही गुडाआ इंगाअठ्यी थोड़ही लोड़ाआ आन थोड़ही कादवोअ ओती, तेहेंज कोइत तों राज बी थोड़क मजबुत आन थोड़क लुलो रोय. <verse eid="DAN 2:42" /><verse number="43" style="v" sid="DAN 2:43" />राजा, जेहेलोहो लोड़ो कादवोमेहें पेलाइत रोल्यो तुमे देख्यो तियाआ अर्थ ओं होय, के तियाआ राजोअ माअहें एकमेकाअरी मिलीत ते रोय, पोन जेहेलोहो लोड़ो कादवोअरी नाहां पेलाअतो, तेहलेज तें माअहें बी ने पेलाय. <verse eid="DAN 2:43" /><verse number="44" style="v" sid="DAN 2:44" />तियां राजहांआं दिहोमेहें होरगाअ देव, एक एहलोहो राज उबो कोए जों केदिहीं ने आरवाय, आन तों कोडा बिहीराअ आथोम ने पोड़े, पोन तों राज बिहीरा आखा राजोहों सुउवी देय, तियांहां नावासट आरवी देय; आन तों राज हादाफल टिकीत रोय. <verse eid="DAN 2:44" /><verse number="45" style="v" sid="DAN 2:45" />राजा, जेहेलोहो तुमे देख्यो के एक डोण बिगर लुड़व्येज डोगोपोअ रोत निसे आवीत पोड़्यु, आन तिये आखो जो लोड़ो, इस्तल, तांबो, कादुउ, सांदी, आन होनो तिया आखाहा सुउवीत टाक्यो, एहें कोइत देवे राजाहा होपनो देखाड़्यो.”<verse eid="DAN 2:45" /></para>
  <para style="s">दानियेलोअ मानपान</para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46" />ओं उनाइत कोइत नबुकदनेस्सर राजा उबडू पोड़ीत कोइत दानियेलोअ पागे पोड़्यू, आन दानियेलोअ काजे गाराहा सोढ़वे आन तियाआ सामने हाजी गुंदाअनारी वस्तु पेटाड़े तेहें काजे आदेश आप्यू. <verse eid="DAN 2:46" /><verse number="47" style="v" sid="DAN 2:47" />फाशोअ राजे दानियेलोहो कोयो, “हुदाअलीज तुमाआं देवुज आखा देवोअ देव होय, तोज यीं निकाअली गोठीइ अर्थ प्रगट कोअहे. ओं काम निस्तु तुज कोइत सेकू.” <verse eid="DAN 2:47" /><verse number="48" style="v" sid="DAN 2:48" />ताहां राजे दानियेलोहो राजवाड़ामेहें एका वोडा पदोपोअ नेमी देदू, आन तियाहा जाअखीलीही वोडी वोडी भेट आप्यी; आन ओ आदेश आप्यू के तो बाबेलोअ पुरा देसोपोअ अधिकारी आन बाबेलोअ आखा ग्यानीपोअ मुख्य बोणावी देदू. <verse eid="DAN 2:48" /><verse number="49" style="v" sid="DAN 2:49" />ताहां दानियेलोअ रावणी वाअहीं राजे शद्रक, मेशक, आन अबेदनगोहो बाबेल देसोअ कामकाजोअ कोअते निवड़ कोइ देदी; पोन दानियेल सोताहा राजाआ राजवाड़ामेहें रोतुतो.<verse eid="DAN 2:49" /></para>
  <chapter eid="DAN 2" />
  <chapter number="3" style="c" sid="DAN 3" />
  <para style="s">होनाआ मुर्तीही वोंदीइलोअ आदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1" />नबुकदनेस्सर राजे होनाआ एक मुर्ती बोणायी, ते साट आथ उसी आन सोव आथ पोली ओती. तिये मुर्तीही दुरा नावोअ बाबेलोअ सापड़ामेहें उबी कोअयी. <verse eid="DAN 3:1" /><verse number="2" style="v" sid="DAN 3:2" />तियी मुर्तीइ थापनामेहें भाग लेय तेहें काजे नबुकदनेस्सर राजे आधिकार्‍योहों, मोंत्र्योहों, राज्यपालोहों, सल्लागारोहों, कारभार्‍योहों, न्यायाधिशोहों, जाणकारोहों आन पुरा राज्याआ वोडा-वोडा आधिकार्‍योहों हादाड़्या. <verse eid="DAN 3:2" /><verse number="3" style="v" sid="DAN 3:3" />ताहां ते आधिकारी, मोंत्री, राज्यपाल, सल्लागार, कारभारी, न्यायाधिश, जाणकार आन पुरा राज्याआ आखा वोडा-वोडा आधिकारी टोलू वोल्या आन नबुकदनेस्सर राजाआ थापल्यी मुर्तीइ सामने उबा रोया. <verse eid="DAN 3:3" /><verse number="4" style="v" sid="DAN 3:4" />ताहां राजाआ वोतीइ पुकारु फोड़नारे पुकारु फोड़्यू, “ओ आलांग आलांग राज्याआ जुदी-जुदी बाशावाला, कान द्या! तुमुहूं आगल्युउ ओ आदेश जोड़ेहे: <verse eid="DAN 3:4" /><verse number="5" style="v" sid="DAN 3:5" />जेहेलाम तुमू तुरी, पावी, तंबिवरो, सितार<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="fq" closed="false">सितार </char><char style="ft" closed="false">तातीवालो वाजो</char></note>, पेपारो, आक्खी जातीइ वाजाआ आवाज उनाअहा, तेहेलाजमेहें मांड्या पोड़ीत नबुकदनेस्सर राजाआ थोपाड़ल्यी होनाआ मुर्तीही वोंदजा. <verse eid="DAN 3:5" /><verse number="6" style="v" sid="DAN 3:6" />आन जो कोडो मांड्या पोड़ीत ने वोंदे तो तेहेलाजमेहें तुदड़ीइत्ली आगीइ बाठीमेहें टाकी देवाय.” <verse eid="DAN 3:6" /><verse number="7" style="v" sid="DAN 3:7" />तिहीं वाअहीं तेहेलाम आखी जातीइ माअहें जेहेलुहू तुरी, पावी, तंबिवरो, सितार, पेपारो, आक्खी जातीइ वाजाआ आवाज उनाअये, आन उनाअताज वाआ देसोदेसोअ आन राज्याआ आलांग आलांग जातीइ माअहें आन जुदी जुदी बाशा गोगनारे माअहें खुट्या पोड़ीत तियी होनाआ मुर्तीही वोंद्यो, जे नबुकदनेस्सर राजे थोपाड़्यीते.<verse eid="DAN 3:7" /></para>
  <para style="s">दानियेलोअ दोस्त्योंपोअ आदेश तोड़ीइलाअ आरोप</para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 3:8" />तेहेलाजमेहें थोड़ाक खास्द्या माटी राजाआ जागे गोया, आन यहुद्यांआं विरुद्दाम कुहूरायी वाअहीं साड़ी कोआ वोल्या. <verse eid="DAN 3:8" /><verse number="9" style="v" sid="DAN 3:9" />ते नबुकदनेस्सर राजाहा कोना वोल्या, “राजा, तू हादाजलम जिवतू रोअहूं जोवे! <verse eid="DAN 3:9" /><verse number="10" style="v" sid="DAN 3:10" />राजा, तुमे ते ओ आदेश आप्युहू के जों माहुंउं तुरी, पावी, तंबिवरो, सितार, पेपारो यां आखी जातीइ वाजाआ आवाज उनाय, तों खुट्या पोड़ीत तियी होनाआ मुर्तीही वोंदुहूं जोवे; <verse eid="DAN 3:10" /><verse number="11" style="v" sid="DAN 3:11" />आन जों कोडो खुट्या पोड़ीत ने वोंदे, तों तुदड़ीइत्ली आगीइ बाठीम टाकी देवाय. <verse eid="DAN 3:11" /><verse number="12" style="v" sid="DAN 3:12" />पाल राजा, शद्रक, मेशक, आन अबेदनगो नावोअ थोड़ाक यहुदी माटी होय, जियांहां तुमे बाबेल देसोअ कामोपोअ नेम्याहा. तियां माट्यो ताआ आदेशोअ किज विसार ने कोअयू; ते ताआ देवताआ भक्ती नाहां कोअता, आन जे होनाआ मुर्ती तुमे थोपाड़्यीही, तियीही नाहां वोंदता.”<verse eid="DAN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 3:13" />ताहरुउ नबुकदनेस्सर राजा खोतेए बाल्लायी आदेश आप्यु के शद्रक, मेशक, आन अबेदनगोहो लेतावा. ताहां तियां माट्योहो राजाआ सामने हुजुर कोअया. <verse eid="DAN 3:13" /><verse number="14" style="v" sid="DAN 3:14" />नबुकदनेस्सर राजे तियांहां फुश्यो, “शद्रक, मेशक, आन अबेदनगो, तुमू माआं देवताआ भक्ती नाहां कोअता, आन माआं थोपाड़ल्यी मुर्तीही नाहां वोंदता, ताहां केहें ओं तुमू मुद्दाम कोअताहा के? <verse eid="DAN 3:14" /><verse number="15" style="v" sid="DAN 3:15" />ओमे जर तुमू तियार ओय, आन जेहेलाम तुरी, पावी, तंबिवरो, सितार, पेपारो यां आखी जातीइ वाजाआ आवाज उनाअहा, आन तेहेलामेहें मांड्या पोड़ीत माआ बोणावल्यी मुर्तीही वोंदहा, ताहां वासाअहा; आन जर तुमू ने वोंदहा ताहां तेहेलाजमेहें तुदड़ीइत्ली आगीइ बाठीमेहें टाकी देवाअहा; आन एहेलुहू कोड्लू देवता होय, जो तुमुहूं माआं आथोम रोत वासाड़ीत सेके?”<verse eid="DAN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 3:16" />शद्रक, मेशक आन अबेदनगो यां तिया राजाहा कोयो, “राजा नबुकदनेस्सर, यी बाप्तिमेहें आमू ताआ सामने वासाओ एहलीही आमुहूं गरज नाहां हासवाअती. <verse eid="DAN 3:16" /><verse number="17" style="v" sid="DAN 3:17" />आमाआं देव जियाआ आमू भक्ती कोअताहा तो आमुहूं तियी तुदड़ीइत्ली आगीइ बाठीम रोत बी वासाड़ीत सेकेहे; तेतोज नाहां राजा, पोन तो आमुहूं ताआ आथोम रोत बी सोड़वीत सेकेहे. <verse eid="DAN 3:17" /><verse number="18" style="v" sid="DAN 3:18" />पोन जर ने बी वासाड़े, तेबी राजा ताहूं आमू कोत देताहा, के आमू ताआ देवताआ भक्ती ने कोअनारा, आन तुमे थोपाड़ल्यी होनाआ मुरतीही ने वोंदनारा.”<verse eid="DAN 3:18" /></para>
  <para style="s">दानियेलोअ जोड़ीदारोहों बाठीम टाकीइलो</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19" />ताहरीइ नबुकदनेस्सर राजाहा जुदी खोत लागी, आन तियाआ सोब खोतेवाअहीं रातणाआं ओत गोयी. आन राजा शद्रक, मेशक, अबेदनगोपोअ खिजवाअयू. आन तिये आदेश आप्यु के बाठी हांत भाग वादार तुदड़ावा. <verse eid="DAN 3:19" /><verse number="20" style="v" sid="DAN 3:20" />ताहरुउ तियाआ सेयनिकोमेर्‍याआ मजबुत सेयनिकोहों राजे शद्रक, मेशक, अबेदनगोहो बांदीत कोइत यांहां तुदड़ीइत्ली आगीइ बाठीम टाकी देय तेहें आदेश आप्यू. <verse eid="DAN 3:20" /><verse number="21" style="v" sid="DAN 3:21" />ताहरोअ यां तिनू माट्योहों तियांआं कुरतो, आंगड़े, पागड़ी आन आक्खे आंगड़ेन-हांगड़े बांदीत कोइत, तियी तुदड़ीइत्ली आगीइ बाठीमेहें टाकी देदा. <verse eid="DAN 3:21" /><verse number="22" style="v" sid="DAN 3:22" />ते बाठी राजाआ कड़क आदेशोवाअहीं जुदी तुदड़ावी देदीते, तिहीं वाअहीं जे सेयनिक शद्रक, मेशक, अबेदनगोहो बांदीत कोइत आखल्या, ते सेयनिक बी आगीइ हेकेवाअहीं सुल्लाइत मोइत गोया, <verse eid="DAN 3:22" /><verse number="23" style="v" sid="DAN 3:23" />आन तियीज तुदड़ीइत्ली आगीइ बाठीमेहें तिनू माट्योहो, शद्रक, मेशक, अबेदनगोहो बांदल्याज टाकी देदा.<verse eid="DAN 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 3:24" />ताहां नबुकदनेस्सर राजा बोगलाइत गोयुन उठीत बोठु, आन तियाआ मोंत्र्योहों फुसू वोल्यु, “केहें आपू यी आगीमेहें तिन माटी बांदीत कोइत ने टाक्याते के?”</para>
  <para style="p" vid="DAN 3:24">तियें राजाहा उत्तर आप्यो, “होव राजा, हुदाअलीजे.”<verse eid="DAN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 3:25" />फाशोअ राजे कोयो, “पोन आंय शार माट्योहो आगीमेहें सुट्लाज फिरत्लाहा पालोहो, आन तियांआं डिल जाराक बी नाहां सुउंणाअयो; आन शोवथा माट्योअ अवतार देवोअ बेटाह्हाआ होसर्‍युउ होय.”<verse eid="DAN 3:25" /></para>
  <para style="s">दानियेलोअ हेंगात्योंअ वोडाय</para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26" />ताहरुउ नबुकदनेस्सर राजा तियी तुदड़ीइत्ली आगीइ बाठीइ बाओअ जागे जात कोइत कोनु वोल्यू, “ए शद्रक, मेशक, अबेदनगो, ए वोडाम वोडा देवोअ सेवकहों, बारथे निहीत आवा!” ओं उनाइत कोइत शद्रक, मेशक, आन अबेदनगो आगीम रोत बारथे निहीत आवया. <verse eid="DAN 3:26" /><verse number="27" style="v" sid="DAN 3:27" />जे तिहीं टोलु वोलीत रोयाते तियां कुन्ब्यों, आधिकार्‍यो, राज्यपाल, आन राजाआ मोंत्र्यो, तियां तिनू माट्योअहें पाल्यो, ताहां तियांआं डिलोम आगी वाअहीं डाजल्याआ वाहीं बी निशाणी ने सापड़्यी; आन तियांआं मुन्काआ एक सिंग्य बी नाहां सुउंणाअयो, आन तियांआं मोजे बी जेहेलेन तेहेलेज ओते, आन तियांआं डिलोपोऱ्योअ एक रुंग्हो बी ने सुल्लाअयो.<verse eid="DAN 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 3:28" />नबुकदनेस्सर राजा कोनु वोल्यू, “हाजू होय शद्रक, मेशक, आन अबेदनगोअ देव, जिये देवदूत मोकलीत कोइत तियाआ यां सेवकोहों वासाड़्या! काहाके तियां जुवानो राजाआ आदेश टालीत कोइत देवोपोअ भरीवसू मिक्यू, आन ओ विसार कोइत सोताआ डिल बी अर्पण कोअयो, के आमू आमाआं देवोहो सोड़ीत, बिहीरा देवताआ भक्ती नाहां कोअनारा, के वोंदनारा बी नाहां.<verse eid="DAN 3:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 3:29" />“तियाहा काजे ओमे आंय ओ आदेश काडोहो के देसोदेसोअ आखा माअहूं, आन जुदी जुदी बाशा गोगनारामेहें रोत जों कोडो शद्रक, मेशक, आन अबेदनगोअ देवोअ जाराक बी निंदा कोए, तियाआ पुकरान पुकरा कोआय, आन तियाआ कोअ उजाड़ी देवाय; काहाके एहेलुहू बिहीरु कोड्लुज देवता नाहां जो एहें कोइत वासाड़ीत सेके.”<verse eid="DAN 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 3:30" />ताहरुउ राजा बाबेलोमेहें शद्रक, मेशक, आन अबेदनगोअ पद फाशोअ उसो कोअयो.<verse eid="DAN 3:30" /></para>
  <chapter eid="DAN 3" />
  <chapter number="4" style="c" sid="DAN 4" />
  <para style="s">नबुकदनेस्सर राजाआ दुसरो होपनो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 4:1" />नबुकदनेस्सर राजे धरतीपोर्‍याआ देसो देसोअ आन जुदी-जुदी बाशा गोगनारा माअहोंहों सिट्टीम ए खबर लेखीत मोकल्यी:</para>
  <para style="p" vid="DAN 4:1">“तुमाआं हाजोज ओवुहूं जोवे! <verse eid="DAN 4:1" /><verse number="2" style="v" sid="DAN 4:2" />वोडाम वोडे देवे माआं काजे जो समत्कार देखाड़्यू, तों तुमुहूं कोत देखाड़ुहूं कोअहो.<verse eid="DAN 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="DAN 4:3" />“तियाआ देखाड़ल्या समत्कार केताहा जबरदस्त होय!</para>
  <para style="q1" vid="DAN 4:3">तियाआ समत्कारोम केतीही वोडी सेक्ती होये!</para>
  <para style="q1" vid="DAN 4:3">तियाआ राज ताम हादाफल्योअ आन पिढ़ीन पिढ़ी जाआं रोय.”<verse eid="DAN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 4:4" />“आंय नबुकदनेस्सर माआं राजवाड़ाम हाजीहुतेहे रोतुतो, आन वोडी खुशालीम ओतू. <verse eid="DAN 4:4" /><verse number="5" style="v" sid="DAN 4:5" />माहूं जों होपनो पोड़्यो तिहीं वाअहीं आंय बित गोयु; आन पोलांगीपोअ लोटलोटू जे विसार माआं मोनोमेहें आया आन जे गोठी मी देख्यी, तिहीं वाअहीं आंय फिकरेम पोड़ीत गोयुतो. <verse eid="DAN 4:5" /><verse number="6" style="v" sid="DAN 4:6" />ताहां आंय आदेश आप्यू के बाबेलोअ आखा जाणकारोहों माआ होपनाआ अर्थ कोत आपे तेहें काजे माआ सामने हुजुर कोअहूं जोवे. <verse eid="DAN 4:6" /><verse number="7" style="v" sid="DAN 4:7" />जेहेलाम बोड़वा, खास्द्यां जाणकार, आन भविश्यवाणी कोअनारा राजवाड़ाम आवया, आन आंय तियांहां माआ होपनो कोताप्यो; पोन ते होपनाआ अर्थ ने कोत सेका. <verse eid="DAN 4:7" /><verse number="8" style="v" sid="DAN 4:8" />आखरीपोअ दानियेल माआ सामने आवयू, जियाआ नाव माआ देवताआ नावोपोअ रोत बेलतशस्सर मिक्योतो, आन जियामेहें पवित्र देवहोंअ आत्मा रोहे; आंय दानियेलोहो माआ होपनो कोत आप्यो आन तियाहा ओं कोयो: <verse eid="DAN 4:8" /><verse number="9" style="v" sid="DAN 4:9" />ए बेलतशस्सर, तु ते आखा जाणकारोअ मुख्यू होय, माहूं मुंदू होय के तामेहें पवित्र देवोअ आत्मा रोहे, आन ताआ काजे कोड्लीज बी दोड़ाअली गोठीइ अर्थ कोत आपीइलोअ किज कठीण कायनाहां; तियाहा काजे आंय जों होपनो पाल्योहो, तों होपनो आन तियाआ अर्थ माहूं कोत आप.”<verse eid="DAN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 4:10" />“जेहेलाम आंय आथरुपोअ लोटीत रोयुतो, तेहेलाम आंय दर्शन पाल्यो: आंय पाल्यो, के धरतीइ पोरापोर एक साड़ ठांअल्यो होय, आन तों जुदो उसो वाद्योहो. <verse eid="DAN 4:10" /><verse number="11" style="v" sid="DAN 4:11" />तों साड़ वोडो पोहात मजबुत ओत गोयोहो, आन तों जुगोअ एतोहो वाद्योहो, आन पुरी धरतीइ मेरे-कोरे रोत देखाअतोतो. <verse eid="DAN 4:11" /><verse number="12" style="v" sid="DAN 4:12" />तियाआ पाने देख्याम हाजेबी, आन तियाआ फलवे जुदे लागेते, आन तियाआ फलवे एतेहे लागेते के आखे जनवारे तियांहां खात कोइत ताराइत सेकतेते आन तियाआ सावलामेहें धरतीइ आखे जनवारे आराम लेतेते, आन तिया साड़ोअ उसे जुगोमेर्‍येए आखे सिड़े बोहतेते, आन आखे जनवारे तियावाअहीं पोहाअतेते.<verse eid="DAN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 4:13" />“आंय पोलांगीपोअ दर्शन पालीइलाअ वेले की देख्यो, के एक होरगाम रोत पवित्र देवदूत उतरीत आयू. <verse eid="DAN 4:13" /><verse number="14" style="v" sid="DAN 4:14" />तिये वोडा आवाजोम आअड़ीत कोइत कोयो, ‘साड़ोहो वाडीत टाका, या साड़ोअ डाल्यी सिंदी द्या, आन याआ पाने सेंदड़ी द्या, याआ फलवे उडाड़ी द्या; याआ निसे रोत जनवारे सेटे जाते रोअहूं जोवे, आन सिड़े याआ डालीपोअ रोत उडीत जाअहूं जोवे. <verse eid="DAN 4:14" /><verse number="15" style="v" sid="DAN 4:15" />तेबी याआ खुटोहो मुलेन होंअको पुयींजमेहें रोअहूं द्या, आन तियाहा लोड़ाआ आन इस्लेए पोट्टावाअहीं बांदीत कोइत रानोमेर्‍याआ निला खोड़ोअ विसमेहें रोअहूं द्या.’</para>
  <para style="p" vid="DAN 4:15">“ताहां तो जुगोमेर्‍याअ साकलावाअहीं पिग्या कोए आन जोंगल्या जनवारोअ होस पुयींपोऱ्योअ खोड़ खाया कोअहूं जोवे. <verse eid="DAN 4:15" /><verse number="16" style="v" sid="DAN 4:16" />तियाआ मोन माअहुंउं होसर्‍योअ ने रोअहूं जोवे, पोन जनवारोअ होस बोदलात जाअहूं जोवे आन एहें कोइत तियापोअ हांत वोरह्ये सेकुहूं जोवे. <verse eid="DAN 4:16" /><verse number="17" style="v" sid="DAN 4:17" />ओ आदेश जागल्या पवित्र देवदूतोअ निर्णयोंवाअहीं आन ए गोठ पवित्र माअहुंउं वसनोवाअहीं निहींयी के, ‘जें जिवते होय तें जांइत लेअहूं जोवे, के आखाम रोत वोडू देव मोनवीइ राजोम राज कोअहे, आन तों राज जियाहा आपो लागे तियाहा तो आपी देहे, आन तो हानाम हाना माहुंहूं बी तियापोअ नेमी देहे.’”<verse eid="DAN 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 4:18" />“आंय नबुकदनेस्सर राजा ओंज होपनो पाल्यो. तियाहा काजे बेलतशस्सर, तु याआ अर्थ माहूं कोत आप, काहाके माआं राज्यामेहें बिहीरु कोड्लुज जाणकार याआ अर्थ माहूं नाहां समजाड़ीत सेकतू, पोन तामेहें तोम पवित्र देवहोंअ आत्मा रोहे, तिहीं वाअहीं तु याहा समजाड़ीत सेकेहे.”<verse eid="DAN 4:18" /></para>
  <para style="s">दानियेल होपनाआ अर्थ कोत्लु</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 4:19" />ताहरुउ दानियेल जियाअ नाव बेलतशस्सर बी ओतो, एक ताल जाआं बितू रोयु, आन इतवी इतवीइ फिकरेम पोड़्यु. ताहां राजा कोनु वोल्यू, “बेलतशस्सर, या होपना वाअहीं नेताहां याआ अर्थावाअहीं तु फिकरेम मा पोड़ही.” बेलेतशेस्सरे कोयो, “ए माआ मालिख, ओं होपनो ताआ दुस्मोनोपोअ, आन याआ अर्थ ताआ दुस्मोनोपोअ उतरुहूं जोवे! <verse eid="DAN 4:19" /><verse number="20" style="v" sid="DAN 4:20" />जिया साड़ोहो तुमे देख्यो, जों वोडो आन मजबुत ओत गोयोहो, आन जों जुगोअ एतोहो उसो आन जों धरतीइ मेरे-कोरे रोत देखाअतोतो; <verse eid="DAN 4:20" /><verse number="21" style="v" sid="DAN 4:21" />जियाआ पाने हाजे बी आन फलवे जाअखीलेहे ओते, जिहीं वाअहीं आखाहाज खाअहूं जोड़तोतो; जियाआ थुड़ी धरतीपोर्‍येए आखे जनवारे रोतेते, आन जियाआ डालीपोअ जुगोमेर्‍येए आक्खे सिड़े बोहतेते.”<verse eid="DAN 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 4:22" />“राजा, तों साड़ तुज होय. तु वोडू आन सेक्तीमान ओत गोयु, ताआ महिमा वाद्यी आन जुगोम जाआं पोतीत गोयी, आन ताआ सालती धरतीइ मेरे-कोरे जाआं पोसर्‍यीही. <verse eid="DAN 4:22" /><verse number="23" style="v" sid="DAN 4:23" />राजा, तुमे जो एका पवित्र खबऱ्या देवदूतोहो होरगाम रोत उतरीइत्लाहा आन एहें कोत्लाहा देख्यू के, ‘या साड़ोहो वाडीत टाका आन आरवी द्या, पोन खुटोहो मुलेन होंअके पुयींम रोअहूं द्या, आन याहा लोड़ाआ आन इस्लेए पोट्टा वाअहीं बांदीत कोइत रानोमेर्‍याआ निला साराम रोअहूं द्या; ताहां तो जुगोमेर्‍याआ साकलावाअहीं पिग्या कोए, आन तियाहा हांत वोरह्ये जाआं जनवारोंअरीज रोअहूं पोड़े.’”<verse eid="DAN 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 4:24" />“राजा, याआ अर्थ जों वोडाम वोडे देवे ठरवीत लेदोहो तों ओं होय के, ओं ताअरी ओवे. <verse eid="DAN 4:24" /><verse number="25" style="v" sid="DAN 4:25" />ताहूं माअहुंउं विसमेहें रोत निहींत जाअहूं पोड़े, आन जोंगल्या जनवारोअरी रोअहूं पोड़े; तू बोलदोअ होस सारु खाही आन जुगोमेर्‍याअ साकला वाअहीं पिग्या कोअही; आन हांत वोरह्ये निहींत जाय तिहींइं फासाड़ी, ताहां ताहूं मुंदू जाय के मोनव्योअ राज्यामेहें राज कोअनारु वोडाम वोडू तोज होय, आन तियाहा आपो लागे तियाहा तो राज होपी देहे. <verse eid="DAN 4:25" /><verse number="26" style="v" sid="DAN 4:26" />तिया साड़ोअ खुटोहो मुलेनहुले रोअहूं देअलोअ आदेश जोड़्युहू, याआ अर्थ ओं होय के, ताआ राज ताहूं फाशोअ वापिस जोड़े; आन जाहां ताहूं मुंदू जाय के दुन्याआ मालिख होरगाजमेहें होये, ताहां तु फाश्युउ राज कोइत सेकही. <verse eid="DAN 4:26" /><verse number="27" style="v" sid="DAN 4:27" />तिहीं वाअहीं, ए राजा, माआं गोठ मानित ले, के जर तू पाप सोड़ीत कोइत हाजे कामे कोउ वोलही, आन खाराब कामे सोड़ीत कोइत गरब्योंपोअ दया-माया कोउ वोलही, ताहां ओत सेकेहे के एहेलोहो कोअहीं ताहां ताहूं होक जोड़ीत सेकेहे.”<verse eid="DAN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 4:28" />ओं आक्खो नबुकदनेस्सर राजाअरी ओवयो. <verse eid="DAN 4:28" /><verse number="29" style="v" sid="DAN 4:29" />बारा मोयना सेका तिहींइं फासाड़ी जाहां तो बाबेलोअ राजवाड़ापोअ फिऱ्या कोअतुतो, ताहरुउ तो कोनु वोल्यु, <verse eid="DAN 4:29" /><verse number="30" style="v" sid="DAN 4:30" />“ओं बाबेल केतोहो वोडो राज होये! जियाहा मीज माआं दोमोपोअ आन सेक्तीवाअहीं राजधानीम रोअलोअ काजे बोणायोहो, आन सोताआ महिमा आन वोडायीइ काजे बोहाड़्योहो!”<verse eid="DAN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 4:31" />ओं वसन राजाआ मुखोम रोत निठो ने निठो तेहेंज जुगोम रोत आवाज आयू, “ए राजा नबुकदनेस्सर, ताआ बाप्तिमेहें ओ आदेश निहींयुहू: राज ताआ आथोम रोत निहीत गोयोहो! <verse eid="DAN 4:31" /><verse number="32" style="v" sid="DAN 4:32" />आन ताहूं माअहोंम रोत निहींत जाअहूं पोड़े, आन जनवारोअरी रोअहूं पोड़े; आन हांत वोरह्ये जाआं बोलदोअ होस सारु खाअहूं पोड़े; ताहां तू जांइत लेही के आखाम रोत वोडू देव, मोनव्योम राज कोअहे, आन तो जियाहा आपो लागे तियाहा राज आपी देहे.”<verse eid="DAN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 4:33" />तेहेलाजमेहें ओं वसन नबुकदनेस्सर राजाआ बाप्तिमेहें पुरो ओवो. तियाहा माअहूंमेहें रोत काडी देदू, आन तो बोलदोअ होस सारु खानू वोल्यु, आन तियाआ डिल जुगोमेर्‍याआ साकला वाअहीं पिगतोतो, तेतोज नाहां पोन तियाआ सिंग्ये मोरागाआ फिसाआ होस आन तियाआ नोखे सिड़ाआ नोखोअ होस वादीत गोये.<verse eid="DAN 4:33" /></para>
  <para style="s">नबुकदनेस्सर राजा वाअहीं देवोअ स्तुती गित</para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 4:34" />ते हांत वोरह्ये सेकीत गोये तिहींइं फासाड़ी, राजा नबुकदनेस्सर सोताआ नजर होरगाअहें टाक्यीन कोयो, “माआं ओकल फाशीइ जेहेलीन तेहेलीज ओत गोयी; ताहां मी वोडाम वोडा देवोअ धन्यवाद कोअयो, आन जो सादा जिवतु होय तियाआ स्तुती आन महिमा एहें कोत कोउ वोल्यू:</para>
  <para style="q1" vid="DAN 4:34">“तियाआ सालती हादाजलम्यीइं होय,</para>
  <para style="q2" vid="DAN 4:34">आन तियाआ राज्य पिढ़ीन पिढ़ी जाआं टिकीत रोनारो होय.<verse eid="DAN 4:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="DAN 4:35" />धरतीइ आखे रोनारे तियाआ सामने किज नाहां गोणाअते,</para>
  <para style="q2" vid="DAN 4:35">आन तो होरगामेर्‍यीइ सेना,</para>
  <para style="q2" vid="DAN 4:35">आन धरतीपोअ रोनाराआ विसमेहें तियाआज इश्शाआ पुरमाणे काम कोअहे;</para>
  <para style="q1" vid="DAN 4:35">आन कोडोज तियाहा रुकीत कोइत,</para>
  <para style="q2" vid="DAN 4:35">‘तुमे ओं की कोअयो?’ कोत नाहां फुसीत सेकतो.”<verse eid="DAN 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 4:36" />“तेहेलाजमेहें, माआं ओकल फाशीइ जेहेलीन तेहेलीज ओत गोयी; आन माआं राज्याआ महिमाआ काजे माआं सालती आन माआं राजटोपू मापोअ फाशुउ आवीत लागू. माआं मंत्री आन माआं आधिकारी माहूं मिलीइलाअ काजे आवा वोल्या, आन आंय माआं राज्याम मजबुत ओत गोयु; आन माआं फाश्यीइ वादार वोडाय ओवी वोल्यी.”<verse eid="DAN 4:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="DAN 4:37" />“ओमे आंय नबुकदनेस्सर होरगाअ राजाहा वोंदोहो; आन तियाआ स्तुती आन महिमा कोअहो, काहाके तियाआ आखे कामे खोरे, आन तियाआ आखी गोठी सिदी होय; आन जे माहें वोडायी वाअहीं सालतेहे, तियांहां तो निसे कोइत सेकेहे.”<verse eid="DAN 4:37" /></para>
  <chapter eid="DAN 4" />
  <chapter number="5" style="c" sid="DAN 5" />
  <para style="s">बेलेतशेस्सरोअ पांगात</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1" />बेलशस्सर नावोअ राजा तियाआ हाजार आधिकाऱ्योंहों वोडी पांगात आप्यी, आन तियां आखा मिलीत दाराक्शाआ रोहो<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fq" closed="false">दाराक्शाआ रोहो </char><char style="ft" closed="false">दाराक्शाआ होरु</char></note> पिदू. <verse eid="DAN 5:1" /><verse number="2" style="v" sid="DAN 5:2" />दाराक्शाआ रोहो पिता पिताम तियाआ आब्हे नबुकदनेस्सरे येरुसालेमोअ मंदिरोम रोत होना-सांदीइ जें बासने काड्येते तें लेत आवे तेहें बेलशस्सरे आदेश आप्यु, आन राजा आन तियाआ आधिकारी, आन राण्यी आन तियीइ साकऱ्यी नेहें मिलीत तियां बासनोम रोत पित सेके. <verse eid="DAN 5:2" /><verse number="3" style="v" sid="DAN 5:3" />ताहां जें होनाआ बासने येरुसालेमोमेहें देवोअ मंदिरोम रोत काड्येते, तें बासने तिहीं लेतावये; आन राजान तियाआ आखा आधिकारी, राण्यीन तियींइं साकऱ्यी नेहें आखे मिलीत तियां बासनोमेहें पिने वोल्ये. <verse eid="DAN 5:3" /><verse number="4" style="v" sid="DAN 5:4" />ते दाराक्शाआ रोहो पित कोइत होनाआ, सांदीइ, इसत्लेए, लोड़ाआ, कादुउ, आन डोणोअ देवताआ स्तुती कोअया कोअतेते.<verse eid="DAN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 5:5" />तेताजमेहें माहुंउं आथोअ होसर्‍यीइ ईंगाअठ्यी निहीत कोइत कोंदिलोअ सामने राजवाड़ाआ सुनो हारल्या पितड़ापोअ किवानीइ लेखी वोल्यी; आन जो आथ लेखतुतो तो भाग राजाहा एतुज नजरे पोड़्यू. <verse eid="DAN 5:5" /><verse number="6" style="v" sid="DAN 5:6" />तियाहा देखीत राजा बित गोयु, आन तो मोनाआ मोनोम काबरात गोयु, आन तियाआ कंबरेए नोहे डिल्ले ओत गोये, आन तियाआ टोसणे कापी कापीइ एकमेकाहा तेड़काए वोल्ये. <verse eid="DAN 5:6" /><verse number="7" style="v" sid="DAN 5:7" />ताहरुउ राजा जाअखीलीही जोरे आअड़ीत कोइत जाणकारोहों, खास्द्याहां आन बिहीरा भविश्य कोनाराहां हादाड़ीलोअ आदेश आप्यु. जाहां बाबेलवाला जाणकार तियाआ जागे आया, तेहेलाम राजा तियांहां कोनु वोल्यु, “जों कोडो फोलो लेखल्यो होय याहा वासीत कोइत याआ अर्थ माहूं समजाड़े, तियाहा आंय जामण्या रंगोअ साअको आपीहीं, आन तियाआ गोलामेहें होनाआ हाकल पोवाड़ीहीं; आन माआं राज्यामेहें तिसरु तोज राज कोए.” <verse eid="DAN 5:7" /><verse number="8" style="v" sid="DAN 5:8" />ताहराआ राजाआ आखा जाणकार माटी मायते आया, पोन तिया लेख्याहा ने वासीत सेका आन ने राजाहा तियाआ अर्थ समजाड़ीत सेका. <verse eid="DAN 5:8" /><verse number="9" style="v" sid="DAN 5:9" />तिहींइंरी बेलशस्सर राजा जाअखीलुहू बित गोयु आन काबराकाबर ओत गोयु; आन तियाआ आधिकारी बी फिकरेम पोड़ीत गोया.<verse eid="DAN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 5:10" />राजा आन आधिकाऱ्योंअ गोठी उनाइत कोइत, राणी रोटू खाअलोअ कोअमेहें आयीन कोनी वोल्यी, “राजा, तू हादाफल जिवतु रोअहूं जोवे! ताआ जिव एवडू मा पाड़ीत लेही आन नाराज मा ओवीही. <verse eid="DAN 5:10" /><verse number="11" style="v" sid="DAN 5:11" />ताआ राज्यामेहें दानियेल नावोअ एक माटी होय जियाआ नाव ताआ आब्हे बेलतशस्सर मिक्योतो. तियामेहें पवित्र देवहोंअ आत्मा रोतीही, आन तिया राजाआ दिहोमेहें तियामेहें उजालो, हुशारी आन देवहोंअ हारकी बुद्दी सापड़्यी. नबुकदनेस्सर राजा, ताआ आब्हू जो राजा ओतु, तिये तियाहा आखा जाणकारोओन, बोड़वाआन, खास्द्याआं, आन बिहीरा भविश्य कोत आपनाराआ मुख्य ठरव्युतो, <verse eid="DAN 5:11" /><verse number="12" style="v" sid="DAN 5:12" />काहाके तियामेहें हाजाम हाजु आत्मा, हान, समजदारी, होपनाआ अर्थ कोअलाआ, दोड़ाअली गोठी उखरीत काडीइलोअ आन सोंवसु दुर कोइलाअ सेक्ती सापड़्यी. ताहरोअ जियाआ नाव राजे बेलतशस्सर कोत मिक्यतो तिया दानियेलोहो हादी द्या, आन तो या लेख्याआ अर्थ कोत आपे.”<verse eid="DAN 5:12" /></para>
  <para style="s">लेख्याआ अर्थ कोत आपीइलो</para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13" />ताहां दानिएलोहो राजाअ सामने मायते हाद्यु. राजा दानियेलोहो फुसू वोल्यु, “दानियेल, जो माआं आब्हू नबुकदनेस्सर राजा यहुदा देसोम रोत लेतायू तियां यहुदी गुलामोमेऱ्युउ तु होय के? <verse eid="DAN 5:13" /><verse number="14" style="v" sid="DAN 5:14" />आंय ताआ बाप्तिमेहें उनाअयुहू के देवहोंअ आत्मा तामेहें रोतीही; आन बुद्दी, समजदारी, आन हाजाम हाजी ओकल तामेहें रोहे. <verse eid="DAN 5:14" /><verse number="15" style="v" sid="DAN 5:15" />पाल, ओं लेखल्यो होय याहा वासे आन याआ अर्थ माहूं कोतापे तेहें काजे ओमे जाणकार, बोड़वा माटी माआं सामने हादाअयाते, पोन ते यी गोठीइ अर्थ ने समजाड़ीत सेक्या. <verse eid="DAN 5:15" /><verse number="16" style="v" sid="DAN 5:16" />पोन आंय ताआ बाप्तिमेहें उनाअयुहू के दानियेल निकाअली गोठी फोड़ीत कोत सेकेहे. तियाहा काजे ओमे जर तु या लेख्याहा वासीत सेकही आन याआ अर्थ बी माहूं समजाड़ीत सेकही, ताहां ताहूं जामण्या रंगोअ साअको, आन ताआ गोलाम होनाआं हाकल पोवाड़ीहीं, आन माआं राज्यामेहें तिसरु तुज राज कोअही.”<verse eid="DAN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 5:17" />दानियेले राजाहा कोयो, “ताआ भेट ताजपोअ रोअहूं दे; आन जे भेट तु आपनारु होय, ते एखाहा आपजी; पोन ए लेखल्यी गोठी आंय राजाहा कोत आपीहीं, आन याआ अर्थ बी आंय ताहूं समजाड़ीहीं.<verse eid="DAN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 5:18" />“राजा, वोडाम वोडे देवे ताआ आब्हा नबुकदनेस्सरोहो राज्य, वोडाय, मानपान, आन सालती आप्यीते; <verse eid="DAN 5:18" /><verse number="19" style="v" sid="DAN 5:19" />आन तियी वोडायी वाअहीं जे देवे तियाहा आप्यीते, देसोदेसोअ, राज्या राज्याआ आखे माअहें, आन जुदी जुदी बाशा गोगनारे तियाआ सामने थुरथुर कापतेते; जियाहा माइलोअ ओय तियाहा तो माईं देतुतो, आन जिवतो मिकीइलो ओय, तियाहा जिवतो मिकतुतो; जियाहा उसो कोइलो ओय तियाहा उसो कोअतुतो, आन जियाहा पाड़ीइलो ओय तियाहा पाड़ी देतुतो. <verse eid="DAN 5:19" /><verse number="20" style="v" sid="DAN 5:20" />पोन जेहेलाम तियाआ मोन फुगीत उठ्यो, आन तियाआ आत्मा एतीही कठीण ओत गोयी के तो वोडाय कोउ वोल्यु, तेहेलाम तियाहा तियाआ राजगादीपोअ रोत उतारी देदू, आन तियाआ सालती आरवी देदी; <verse eid="DAN 5:20" /><verse number="21" style="v" sid="DAN 5:21" />तियाहा मोनव्योम रोत काडी देदू, आन तियाआ मोन जनवारोअ होसर्‍योअ ओत गोयो, आन तो रान गोदड़ाअरी रोयू; तो बोलदोअ होस सारु सोऱ्यू, आन तियाआ डिल जुगोमेर्‍याअ साकलावाअहीं पिग्या कोअतोतो, ताहां तिये जाइंत ने लेदो के वोडाम वोडू देव मोनव्योअ राज्याम राज कोअहे आन जियाहा तिया पदोपोअ मिकीइलाअ ओय तियाहा मिकेहे.”<verse eid="DAN 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 5:22" />“तेबी, बेलशस्सर, तु जो तियाआ बेटुह्हू होय, आन ओं आखो ताहूं मुंदू ओतो, तेबी ताआ मोन नम्र ने ओवो. <verse eid="DAN 5:22" /><verse number="23" style="v" sid="DAN 5:23" />गाठ्योअ तुमे होरगाआ मालख्योअ विरुद्दाम मुन्को उसो कोइत तियाआ कोअमेऱ्येए बासने मागाड़ीत कोइत ताआ सामने मिकीत लेवाड़्ये, आन ताआ मुख्याहान, राण्यीहीं, आन तियींइं साकऱ्यीहीं नेहें आरी लेत कोइत तुमे तियांमेहें दाराक्शाआ रोहो पिदू; आन होनान-सांदीइ, इसत्लेए आन कादुउ, आन लोड़ाआन डोणोअ देवता, जें नाहां पालते, नाहां उनाअतेन नाहां की जांअते, तियांआं स्तुती कोअयी. पोन जियाआ आथोमेहें ताआ जिव होय, आन जियाआ ताबामेहें ताआ इंडीइलो-फिरीइलोअ होय, तिया देवोअ तुमे मानपान ने कोअयू. <verse eid="DAN 5:23" /><verse number="24" style="v" sid="DAN 5:24" />तिहींज वाअहीं ओ आथोअ एक भाग तियाअहेंज रोत प्रगट ओवुहू आन तें शब्दे लेखाअयेहे.”<verse eid="DAN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 5:25" />“जे शब्दे लेखाअयेहे ते एं होय: मने, मने, तकेल, आन ऊपर्सीन.<note caller="+" style="f"><char style="fr" closed="false">5:25 </char><char style="fq" closed="false">मने, मने, तकेल, आन ऊपर्सीन. </char><char style="ft" closed="false">मने ताहां “गोणीइलो,” तकेल ताहां तोलीइलो, आन ऊपर्सीन-वाटीइलो</char></note> <verse eid="DAN 5:25" /><verse number="26" style="v" sid="DAN 5:26" />या लेख्याआ अर्थ ओं होय: मने, मोन्ज्ये देवे ताआ राज्याआ दिही गोणीत कोइत तियाआ सेवट कोइ देदोहो. <verse eid="DAN 5:26" /><verse number="27" style="v" sid="DAN 5:27" />तकेल, मोन्ज्ये तु समजीत ले एका ताराजाम तोलाअयु आन ओलवू निहींयुहू. <verse eid="DAN 5:27" /><verse number="28" style="v" sid="DAN 5:28" />परेस, मोन्ज्ये ताआ राज्य वाटीत कोइत मादीही आन पारसी माअहुंहूं आपी देवाअयोहो.”<verse eid="DAN 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 5:29" />ताहरुउ बेलशस्सरे आदेश आप्यु, आन दानियेलोहो जामण्या रंगोअ साअको आन याआ गोलामेहें होनाअ हाकल पोवाड़्यी; आन वाजवाल्यो तियाआ बाप्तिमेहें आअड़ीत कोयो के, “राज्यामेहें तिसरु मुख्यू दानियेलुज राज कोए.” <verse eid="DAN 5:29" /><verse number="30" style="v" sid="DAN 5:30" />तेदिहींज राती खास्द्याआं राजा बेलशस्सरोहो माइत टाक्यू, <verse eid="DAN 5:30" /><verse number="31" style="v" sid="DAN 5:31" />आन तिहींइं फासाड़ी दारा जो मादी ओतू आन बाहासाट वोरह्योअ ओतु तो राजगादीपोअ बोठू.<verse eid="DAN 5:31" /></para>
  <chapter eid="DAN 5" />
  <chapter number="6" style="c" sid="DAN 6" />
  <para style="s">दानियेल सिहांआ दोराम</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1" />दारा राजाहा ओं हाजो गोम्यो के तियाआ राज्यापोअ एक होवेन विही एहेलाहा आधिकारी ठरव्या, जे पुरा राज्यापोअ आधिकार मिके. <verse eid="DAN 6:1" /><verse number="2" style="v" sid="DAN 6:2" />आन तियांपोअ तिये तिन आदक्श, जियांमेहें दानियेल बी एक ओतु, तो याअ काजे ठरवाअयु के ते तियां आधिकार्‍योअ इसाब मिक्या कोए, आन एहें कोइत राजाअ किज नुकसान ने ओवुहूं जोवे. <verse eid="DAN 6:2" /><verse number="3" style="v" sid="DAN 6:3" />जेहेलाम ओं पाल्यो के दानियेलोमेहें हाजाम हाजी आत्मा रोहे, ताहां तियाहा तियां मुख्याआ, आन आधिकार्‍योअ रोत वादार मानपान जोड़्यू; एतोज नाहां पोन पुरो राज्य तियाहा होपी देअलोअ राजाआ मोन ओतो. <verse eid="DAN 6:3" /><verse number="4" style="v" sid="DAN 6:4" />ताहराअ आदक्श आन आधिकारी राजकार्याआ बाप्तिमेहें दानियेलोअ विरुद्दाम गुना होदा वोल्या; पोन तो इमानदार ओतु, आन तियाआ कामोम एखु सुक नेताहां गुनू ने जोड़्यू, आन तो एहेलाहा किज गुनाम नेताहां पापोम ने सापड़ीत सेकू. <verse eid="DAN 6:4" /><verse number="5" style="v" sid="DAN 6:5" />ताहराअ ते माटी कोना वोल्या, “आपू या दानियेलोअ देवोअ कायदाहा सोड़ीत, बिहीरी कोड्लीज बाप्तिमेहें तियाआ विरुद्दाम गुनू ने सापड़ावीत सेकनारा.”<verse eid="DAN 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 6:6" />ताहराआ ते आदक्श आन आधिकारी राजाअ जागे उतवाल आवयान तियाहा कोयो, “दारा राजा, हादाफल जिवतु रोअहूं जोवे! <verse eid="DAN 6:6" /><verse number="7" style="v" sid="DAN 6:7" />राज्याआ आखा मुख्या, पुडारी, आधिकारी, न्यायी, राज्यपालहों यां आखाआज गोठी ओवीही, के राजा एहेलुहू आदेश आपे आन एहेलुहू कड़क आदेश काडुहूं जोवे, के तिन दिही जाआं जों कोडो, राजा, ताहूं सोड़ीत बिहीरा एखा माहुंहूं नेताहां देवताहा विनंती कोए, ताहां तो सिहांआ दोराम टाकी देवाअहूं जोवे. <verse eid="DAN 6:7" /><verse number="8" style="v" sid="DAN 6:8" />तिहींइं काजे राजा, ओमे एहेलुहू आदेश आप, आन या पत्रापोअ सही कोअ, जिहींवाअहीं ए गोठ मादी आन पारसीइ कायदाआ होस ने बोदलीत सेकाय आन ने रद्द बी कोइत सेकाय.” <verse eid="DAN 6:8" /><verse number="9" style="v" sid="DAN 6:9" />ताहरुउ दारा राजे तिया आदेशपत्रापोअ सही कोइ देदी. <verse eid="DAN 6:9" /><verse number="10" style="v" sid="DAN 6:10" />जेहेलाम दानियेलोहो मुंदू गोयु के तिया आदेशपत्रापोअ सही ओत गोयीही, ताहां तो तियाआ कोअमेहें गोयु, जियाआ उपर्‍यीइ खुलीइ खिड़की येरुसालेमोअहें उगड़ीत रोतीते, आन तियाआ सवायीइ पुरमाणे जेहेलुहू तो दिहोम तिन वारी तियाआ देवोअ सामने मांड्या पोड़ीत प्रार्थना आन धन्यवाद कोअतुतो, तेहेंज कोइत तेहेलाम बी कोअतु रोयु.<verse eid="DAN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 6:11" />ताहराअ ते माटी एक मोन ओत कोइत दानियेलोहो तियाआ देवोअ सामने विनंती कोअत्लाहा आन रोड़ी-रोड़ीइ प्रार्थना कोअत्लाहा देख्यू. <verse eid="DAN 6:11" /><verse number="12" style="v" sid="DAN 6:12" />ताहराअ ते राजाअ जागे जात कोइत, तियाआ आदेशोअ बाप्तिम तियाहा कोना वोल्या, “राजा, केहें तुमे एहेलाहा आदेशपत्रापोअ सही नाहां कोअयी के, तिस दिही जाआं जों कोडो ताहूं सोड़ीत, बिहीरा एखा माहुंउं नेताहां देवताहा विनंती कोए. तियाहा सिहांवागोअ दोरामेहें टाकी देवाय?”</para>
  <para style="p" vid="DAN 6:12">राजे उत्तर आप्यो, “होव, मादी आन पारसीइ ने बोदलाअनारा कायदाआ पुरमाणे ए गोठ पाक्की होय.”<verse eid="DAN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 6:13" />ताहां राजाहा तियां कोयो, “यहुदी गुलामोमेहें रोते जो दानियेल होय, ए राजा, तिये ते ताअहें दिहानुज नाहां देदो आन नाहां तुमे सही कोअल्या आदेशपत्राअहें दिहान देतू; तो दिहोम तिन वारी तियाआ देवोहो विनंती कोअया कोअहे.”<verse eid="DAN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 6:14" />ए गोठ उनाइत कोइत, राजा जाअखीलुहू नाराज ओवू, आन दानियेलोहो वासाड़ीइलोअ वाट होदू वोल्यू; आन दिही बुडू ताअहूं जाआं तियाहा वासाड़ीइलोअ कोशित कोअतु रोयु. <verse eid="DAN 6:14" /><verse number="15" style="v" sid="DAN 6:15" />ताहराअ ते माटी राजाअ जागे उतवाल्या आवीत कोइत तियाहा कोताहा, “राजा, ओं जाइंत ले, के मादी आन पारसीमेहें ओ कायदू होय के जों जों ने कोइलोअ नियम नेताहां जो जो आदेश राजा ठरवे, तो नाहां बोदलाइत सेकतू.”<verse eid="DAN 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 6:16" />ताहरुउ राजे आदेश आप्यू, आन दानियेलोहो लेतावीत कोइत सिहांआ दोराम टाकी देदू. तेहेलाम राजे दानिएलोहो कोयो, “ताआ देव, जियाआ तु कायम भक्ती कोअहे, तोज ताहूं वासाड़े!” <verse eid="DAN 6:16" /><verse number="17" style="v" sid="DAN 6:17" />ताहरुउ एक डोण लेतावीत कोइत तिया दोरापोअ मिकी देदू, आन दानियेलोअ बाप्तिमेहें किज ने बोदलाअहूं जोवे काजे राजे तियापोअ तियाआ मुंदीवाअहीं आन तियाआ पुडाऱ्योअ मुंदीवाअहीं सिक्कू लागाड़ी देदू. <verse eid="DAN 6:17" /><verse number="18" style="v" sid="DAN 6:18" />ताहरुउ राजा तियाआ राजवाड़ामेहें जातु रोयु, आन तेदिहीं राती फुकल्युज पोड़ीत रोयु; आन तियाआ जागे सुखसांतीइ किज वस्तु ने पोताड़्यी, आन तियाहा निंद बी ने आयी.<verse eid="DAN 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 6:19" />वेगीइ हुस्ताज वाआ राजा उठ्यू आन सिहांवागोअ दोराअहें तावणी कोइत गुगद्यू. <verse eid="DAN 6:19" /><verse number="20" style="v" sid="DAN 6:20" />जाहां राजा दोराआ आहने आयू, ताहां विखावालाआ होस आवाजोम आअड़ू वोल्यु, आन दानिएलोहो कोयो, “दानियेल, ए जिवता देवोअ सेवक! केहें ताआ देव, जियाआ तु कायम भक्ती कोअहे, तिये ताहूं सिंहावागो रोत वासाड़्यू के?”<verse eid="DAN 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 6:21" />ताहरुउ दानियेल राजाहा कोयो, “राजा, तु हादाफल जिवतु रोअहूं जोवे! <verse eid="DAN 6:21" /><verse number="22" style="v" sid="DAN 6:22" />माआं देवे तियाआ दुत मोकलीत कोइत यां सिहांवागोअ जोड़बे एहेलेहे बोंद कोई देदे के तियां माआ किज नुकसान ने कोअयो; याआ अर्थ ओं होय के आंय तियांआं सामने निर्दुस सापड़्यू; आन राजा, ताआ सामने बी मी किज सुक नाहां कोअयी.”<verse eid="DAN 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 6:23" />ताहरुउ राजा, जाअखीलुहू खुस ओत कोइत, दानियेलोहो दोराम रोत काडीइलाअ आदेश आप्यु. ताहरुउ दानिएलोहो दोराम रोत बारथे काड्यू, आन तियापोअ वाहीं दुखाइलोअ डाग ने सापड़्यु, काहाके तो तियाआ देवोपोअ विश्वास मिकतुतो. <verse eid="DAN 6:23" /><verse number="24" style="v" sid="DAN 6:24" />ताहरुउ जियां माट्यों दानियेलोअ बाप्तिम दोश लागाड़्युतो, तियांआं बाप्तिम राजे आदेश आप्यू, ताहां तियांहांन तियांआं बोईंन-पोर्‍ये नेहें लेतावीत कोइत सिहांवागोअ दोरसाम टाकी देदे; आन तियांहां ते सिंहांवाग दोराआ टेकोपोअ उसाअ-उसेज रोत सेलवीत आडेन-हाडे सावीत खात गोया.<verse eid="DAN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 6:25" />ताहरुउ दारा राजा पुरी धरतीइ रोनारा देस-देसोअ, राज्या राज्याआ आक्खा माअहुंहूं, आन जुदी जुदी बाशा गोगनाराआ जागे ओं लेखीत मोकल्यो के:</para>
  <para style="p" vid="DAN 6:25">“तुमा आखाआ हाजोज ओत जाअहूं जोवे! <verse eid="DAN 6:25" /><verse number="26" style="v" sid="DAN 6:26" />आंय ओ आदेश आपोहो, के जिहीं जिहीं माआं राज्याआ आधिकार होय, तिहींइं माअहें दानियेलोअ देवोअ सामने बिते-बिते आन कापते-कापते रोअहूं जोवे.</para>
  <para style="q1" vid="DAN 6:26">“काहाके तो जिवतु देव होय,</para>
  <para style="q2" vid="DAN 6:26">आन हादाजलम रोनारु देव तोज होय;</para>
  <para style="q1" vid="DAN 6:26">तियाआ राज्य ने आरवाअनारो,</para>
  <para style="q2" vid="DAN 6:26">आन तियाआ सालती कायम मजबुत रोय.<verse eid="DAN 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="DAN 6:27" />जिये दानियेलोहो सिंहांप रोत वासाड़्युहू,</para>
  <para style="q2" vid="DAN 6:27">तोज वासाड़नारु आन सोड़वीइनारु होय;</para>
  <para style="q2" vid="DAN 6:27">आन होरगाम आन धरतीपोअ निशाणी</para>
  <para style="q1" vid="DAN 6:27">आन समत्कार देखाड़नारु होय.”<verse eid="DAN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 6:28" />एहें कोइत दानियेल, दारा आन कोरेश, पारसी, बेनु राज्याआ दिहोमेहें सुख-शांती वाअहीं रोयु.<verse eid="DAN 6:28" /></para>
  <chapter eid="DAN 6" />
  <chapter number="7" style="c" sid="DAN 7" />
  <para style="s">दानियेलोअ दर्शन</para>
  <para style="r">(<ref loc="DAN 7:1-12:13">7:1—12:13</ref>)</para>
  <para style="s">शार जनवारे</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1" />बाबेलोअ बेलशस्सर राजाआ पेलठा वोरह्योम, दानियेले आथरुपोअ लोटलोटू होपनो पाल्यो. ताहां तिये तों होपनो लेख्यो, आन तियाहा फोड़ीत कोइत कोत बी देखाड़्यो. <verse eid="DAN 7:1" /><verse number="2" style="v" sid="DAN 7:2" />दानियेले ओं कोयो,</para>
  <para style="p" vid="DAN 7:2">“आंय राती ओं होपनो पाल्यो के वोडा दोर्‍यामेहें शारु वोल वादुउ सालू वोल्यु. <verse eid="DAN 7:2" /><verse number="3" style="v" sid="DAN 7:3" />ताहां दोर्‍याम रोत शार वोडे वोडे जनवारे निहींत आवत्ले देखाअये, तें आखे जुदे जुदेज ओते. <verse eid="DAN 7:3" /><verse number="4" style="v" sid="DAN 7:4" />पेलठो जनवार सिहांआ होस ओतो आन तियाआ फाके मोरागाआ होसर्‍येए ओते. माआं देखता देखता तियाआ फाकाआ फिसे उफड़ीत टाकाअये आन तों पुयींपोअ रोत आखलात गोयो, माहुंउं होस बेन गुडापोअ उबो रोत गोयो; आन मोनवीइ मोन तियाहा जोड़्यो.”<verse eid="DAN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 7:5" />“फाश्योअ मी एका जनवारोहो देख्यो, जों आसालाआ होस ओतो, आन तों फासल्याआ गुडापोअ उबो रोत रोयोतो, आन तियाआ सोबीम दातोअ विसमेहें तिन आडे ओते; आन माहें तियाहा कोतेते, ‘उठीत कोइत जाअखीलोहो माहां खा.’”<verse eid="DAN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 7:6" />“तिहींइं फासाड़ी माहूं फाश्योअ एक बिलाड़्यावागोअ होसऱ्योअ जनवार देखाअयो. जियाआ टुंगोपोअ सिड़ाआ होस शार फाके होय; आन तिया जनवारोअ शार मुन्के ओते; आन तियाहा आधिकार जोड़्यू.<verse eid="DAN 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 7:7" />“तिहींइं फासाड़ी फाश्योअ आंय होपनाम देख्यो, के एक शोवथो जनवार होय, जों जुदो ताकतवालो आन बिवाड़े एहेलोहो आन जाअखीलोहो जोराखो होय; आन तियाआ वोड्डा-वोड्डाहा लोड़ाआ दात होय; तों आक्खो खात लेहे आन सुउवुन-सुउवुउ कोअहे, आन जों टोलीत जाहे, तियाहा गुडावाअहीं खुंदरीत टाकेहे. तों आखा पेल्लाआ जनवारो रोत आलाग होय; आन तियाआ दोहो हिंगे होय. <verse eid="DAN 7:7" /><verse number="8" style="v" sid="DAN 7:8" />आंय तियां हिंगोहो दिहान लागाड़ीत पालतुतो, ताहां की देख्यो के तियांआं विसमेहें एक फाशोअ हान्नोहों हिंग उगो, आन तियाआ सेक्तीवाअहीं तियां पेल्लाआ हिंगोम रोत तिन हिंगे उफड़ीत टाक्ये; फाशोअ आंय देख्यो के या हिंगोम माहुंउं होसर्‍याआ डोआ, आन वोडी वोडी गोठी सोड़नारी सोब होय.”<verse eid="DAN 7:8" /></para>
  <para style="s">हादाजलम रोनाराआ दर्शन</para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 7:9" />“आंय पालता-पालताम आखरीपोअ की देख्यो, के राजगादी मांड्यी, आन एक वेगुउ डायु तिहींपोअ बोठू; तियाआ आंगड़ो बर्फाआ होस आसो, आन तियाआ मुन्काआ सिंग्ये कापाहोअ होस पांडेपांडेज ओते; तियाआ राजगादी आगीइ होस आन तियाआ साके जलजल कोअत्ला आराआ होस देखाअताते. <verse eid="DAN 7:9" /><verse number="10" style="v" sid="DAN 7:10" />तिया डायाआ सामने रोत आगीइ खाड निहीत वोहतीते; ताहरेए हाजारो हाजार माअहें तियाआ सेवासाकरी कोअतेते, आन लाखेनलाख माअहें तियाआ सामने हुजुर ओते; ताहराआ न्यायी बोहीत गोया, आन पुस्तके उगाड़्ये.”<verse eid="DAN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 7:11" />“तेहेलाम तों हिंग वोडी वोडी गोठी सोक्या कोअतोतो, आन आंय उनाइत कोइत पालतीज रोयु, आन पालता पालता आखरीमेहें देख्यो के तिया जनवारोहो माइत टाक्यो, आन तियाआ डील तुदड़ीइत्ली आगीम टाकी देदो. <verse eid="DAN 7:11" /><verse number="12" style="v" sid="DAN 7:12" />बाकी जनवारोंअ अधिकार मागीत लेदू, पोन तियांहां थोड़ाक दिही जिवे तेहें काजे सोड़ी देदे.<verse eid="DAN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 7:13" />“आंय राती दर्शनोमेहें पाल्यो, ताहां पाला, मोनवीइ बेटाह्हाआ होस कोडू तेबी जुगोम वाद्लापोअ बोहीत आवतुतो, आन तो वेगाआ डायाआ जागे जात पोतू, आन ते तियाहा राजाआ सामने आगाड़ी लेत आये. <verse eid="DAN 7:13" /><verse number="14" style="v" sid="DAN 7:14" />ताहां तियाहा एहेलुहू अधिकार, महिमा आन राज्य आप्यो, के देस देसोअ आन राज्या राज्याआ माअहें आन जुदी जुदी बाशा गोगनारे आखे माअहें तियाआ ताबामेहें ओवे; तियाआ आधिकार कायम टिकीत रोय, आन तियाआ राज केदिहीं ने आरवाय.”<verse eid="DAN 7:14" /></para>
  <para style="s">दर्शनोअ अर्थ</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15" />“आंय दानियेल, माआं मोन फिकरेम पोड़ीत गोयो, आन जों किबी आंय पाल्योतो तिहीं वाअहीं आंय काबरात गोयुतो. <verse eid="DAN 7:15" /><verse number="16" style="v" sid="DAN 7:16" />ताहां जें माअहें जागे उबे ओते, तियांमेर्‍याआ एकाआ जागे जात कोइत तियीं आखी गोठीइ अर्थ फुशो, तिये ओं कोत कोइत तियीं आखी गोठीइ अर्थ कोयो, <verse eid="DAN 7:16" /><verse number="17" style="v" sid="DAN 7:17" />‘तियां शार वोडा वोडा जनवारोंअ अर्थ शार राजा<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="fq" closed="false">शार राजा </char><char style="ft" closed="false">राज्य</char></note> होय, जे धरतीपोअ थापन ओवे. <verse eid="DAN 7:17" /><verse number="18" style="v" sid="DAN 7:18" />पोन वोडाम वोडा देवोअ सोका माअहुंहूं राज्य जोड़े, आन तें हादाफल्येए आधिकारी बोणित जाय.’”<verse eid="DAN 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 7:19" />“ताहां माआ मोनोमेहें ए इश्शा ओवी के, तिया शोवथा जनवारोअ अर्थ बी जाईंत लेंव, जों बिहीरा तिनू रोत आलाग आन जुदो बिवाड़े एहलोहो ओतो, आन जियाआ दात लोड़ाआ आन नोखे तांबाआ ओते; तों किज बी सावीत सुउवान सुउवा कोअतोतो, आन बाकी रोल्याहां गुडाआ निसे रोंद्लीत टाकतोतो. <verse eid="DAN 7:19" /><verse number="20" style="v" sid="DAN 7:20" />फाशोअ तियाआ मुन्कामेहें दोह हिंगे ओते, आन तिहींरोत फाशोअ एक नवो हिंग निहींयो तिहींवाअहीं जें तिन हिंगे ओते तें ओदरात पोड़्ये; तिया हिंगोअ डोआ आन वोडाय कोअनारी सोब ओती आन तों हिंग बाकी हिंगो रोत पेडो देखाअतोतो, तियाआ अर्थ जाइंलाआ बी माआं इश्शा ओवी.”<verse eid="DAN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 7:21" />“फाशोअ आंय पाल्योतो के, तों हिंग सोका माअहोंअरी लड़ायी कोइत तियी वेलेए कोअते जिकीत बी लेदो, <verse eid="DAN 7:21" /><verse number="22" style="v" sid="DAN 7:22" />जाअहूं जाआं तो जुनू डायु ने आयु, आन देवोअ सोका माअहोंअ न्याय ने ठऱ्यु, पोन तिहीं रोत तियां सोका माअहोंअ राज्याआ आधिकारी बोणिइलोअ वेल ने आयी.”<verse eid="DAN 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 7:23" />“तिये कोयो, ‘तिया शोवथा जनवारोअ अर्थ, एक शोवथो राज्य होय, जों धरतीपोअ ओत कोइत आन आखा राज्या रोत आलाग रोय, आन आखी धरतीही आरवीत टाकी देय, आन गुडाआ थुड़ी मोलीत सुउवी देय. <verse eid="DAN 7:23" /><verse number="24" style="v" sid="DAN 7:24" />तियां दोह हिंगोअ अर्थ ओं होय, के तिया राज्यामेहें रोत दोह राजा उबा रोय, आन तियांआं फासाड़ी तियां पेल्लाआ रोत फाशुउ आलाग एक राजा उबु रोय, जो तिनू राजाहां जिकीत लेय. <verse eid="DAN 7:24" /><verse number="25" style="v" sid="DAN 7:25" />आन तो देवोअ विरुद्दाम गोगे, आन देवोअ सोका माअहोंहों पिइड़ीत टाके, आन वेल आन नियमोहों बोदलीइलोअ आशा कोए, आन साड़े तिन वोरह्ये जाआं आखो तियाआ आथोमेहें होपात जाय. <verse eid="DAN 7:25" /><verse number="26" style="v" sid="DAN 7:26" />पोन तेहेलाम न्यायी बोहे, आन तियाआ अधिकार बुउसीत लेय; आन नावासट आरवी देय. <verse eid="DAN 7:26" /><verse number="27" style="v" sid="DAN 7:27" />ताहां राज आन आधिकार आन महिमा, देवोअ माअहोंहों मोन्ज्ये तियाआ सोका माअहोंहों होपाय, तियाआ राज हादाफल्योअ रोय, आन आखे आधिकार सालवीइनारे तियाआ ताबामेहें रोय आन तियाआ आदेश माने.’”<verse eid="DAN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 7:28" />“यीं गोठीइ वर्णन मी ओमे कोअयोहो, आन आंय दानियेल, माआं मोनोमेहें वोडी बिक फोहीत गोयी, आन आंय काबरात गोयु; यीं गोठीहीं आंय माआं मोनोमेहें मिक्यी.”<verse eid="DAN 7:28" /></para>
  <chapter eid="DAN 7" />
  <chapter number="8" style="c" sid="DAN 8" />
  <para style="s">एका मेडाआ आन एका बोकड़ाआ दर्शन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1" />बेलशस्सर राजाआ राज्याआ तिसरा वोरह्योमेहें तिया पेहला दर्शनोअ फासाड़ी फाशीइ एक गोठ माहूं दानियेलोहो दर्शनोअ वाअहीं देखाड़्यी. <verse eid="DAN 8:1" /><verse number="2" style="v" sid="DAN 8:2" />जेहेलाम आंय एलाम नावोअ होयरोअ, शूशन नावोअ राजधानीमेहें रोतुतो, तेहेलाम आंय दर्शनोमेहें देख्यो के, आंय उलय नोयीइ मेरेपोअ होय. <verse eid="DAN 8:2" /><verse number="3" style="v" sid="DAN 8:3" />फाशोअ आंय नजर उसे कोइत पाल्यो, ताहां माहूं तियी नोयीइ मेरेपोअ बेन हिंगोवालो एक मेडो उबोइत देखाअयो. तियाआ बेनू हिंगे वोडे होय, पोन तियांमेहें रोत एक जाअखो वोडो होय, आन जों वोडो होय, तों बिहीराआ फासाड़ी निहींयो. <verse eid="DAN 8:3" /><verse number="4" style="v" sid="DAN 8:4" />आंय तिया मेडाहा पाल्यो, तो बुट्टामाआं, पालामाआं आन देहामाआं वोल हिंग लागावेहे, आन काअलोज जनवार तियाआ आगाड़ी उबो नाहां रोत सेकतो, आन तियाआ आथोम रोत कोडो कोडाहा वासाड़ीत बी नाहां सेकतो; आन तो तियाआ इश्शाआ पुरमाणे काम कोअतु आगाड़ी जातुतो.<verse eid="DAN 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 8:5" />आंय विसारुज कोअतुतो, ताहां कि पाल्यो, के एक बोकड़ू बुट्टामाआं वोल रोत निहींत कोइत आखी धरतीपोअ एहें कोइत फिर्‍यू के धरतीपोअ सालीइलोअ वेले तियाआ खुर्‍ये ने टेकतेते आन तिया बोकड़ाआ डोआअ विसमेहें देखुहूं जोगोहो एक हिंग ओतो. <verse eid="DAN 8:5" /><verse number="6" style="v" sid="DAN 8:6" />जिया बेन हिंगोवाला मेडाहा आंय नोयीइ मेरे देख्युतो तियाआ जागे तो बोकड़ू जात कोइत, तियापोअ खिजवाइत गुगदीइतुज जात टेकाऊ वोल्यू. <verse eid="DAN 8:6" /><verse number="7" style="v" sid="DAN 8:7" />आंय पाल्यो के तो मेडाआ जागे आवीत कोइत तियापोअ खिजवाअयू; आन मेडाअरी टेकाइत तियाआ बेनु हिंगोहों तोड़ी देदे; मेडू बोकड़ाहा हारवित ने सेकू; ताहां बोकड़ू तियाहा पुयींपोअ पाड़ीत तुलाम कुहूंणी देदू; आन मेडाहा वासाड़ीत सेके एहेलोहो कोडोज ने ओतो.<verse eid="DAN 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 8:8" />जेहेलाम बोकड़ू जास्ती वोडाय कोउ वोल्यु, आन ताकतवालू ओवू तेहेलाम तियाआ वोडो हिंग टुटीत गोयो, आन तियाआ जागापोअ पालुहूं जोगेहे शार हिंगे निहींत कोइत शारी ओरी वादे वोल्ये. <verse eid="DAN 8:8" /><verse number="9" style="v" sid="DAN 8:9" />फाशोअ तियां शारु हिंगोम रोत एक हानो हिंग निहींयो. तों देहामाआं वोल, उगतामाआं वोल आन “हाजाबी देसोअ” वोल जाअखो वादतो गोयो. <verse eid="DAN 8:9" /><verse number="10" style="v" sid="DAN 8:10" />तों होरगाआ सेनाअहें जाआं वादतो गोयो; आन तिये जुगोमेर्‍येआ तारामेहें रोत केताहा तेबी ताराहा पुयींपोअ टाकी देदा आन तियांपोअ नासी देदो. <verse eid="DAN 8:10" /><verse number="11" style="v" sid="DAN 8:11" />तों सेनाआं मुख्याआ जागे जाआं पोतीत लागो, आन तियाआ दाड़ख्याआ गाराहा कोइलोअ बोंद कोआड़्यो; आन तियाआ सोका जागाहा आरवीत टाक्यू. <verse eid="DAN 8:11" /><verse number="12" style="v" sid="DAN 8:12" />आन माअहोंअ पापोअ दाड़ख्याआ गाराहाआ बोदले सेना बी तियाआ आथोम होपी देदी, आन तिये हिंगे हाजी गोठीही एकसोट्यीज आरवी देदी, आन तिये सोताआ मोनोअ इश्शा पुरी कोइत लेदी.<verse eid="DAN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 8:13" />ताहां आंय एका जोओंहों गोगत्लू उनाअयु; फाशोअ एक सोको जोओं ओतो तिये पेल्लाआ गोगनाराहा फुशो, “दाड़ख्यीइ बली आन उजाड़ी देनारा पापोअ बाप्तिमेहें जों किबी दर्शनोम देखाअयो, तों केदिहीं जाआं सालतो रोय; मोन्ज्ये सोकू जागू आन सेनाहां गुडाआ थुड़ी सेंदीइलोअ केदिहीं जाआं सालनारो?”<verse eid="DAN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 8:14" />“ताहां तिये माहूं कोयो, ‘जाअहूं जाआं बेन हाजार तिन होव वारी दिही ने उगेन-बुडे ताअहूं जाआं तों ओवतो रोय; तिहीं रोत सोका जागाहा सोकू कोए.’”<verse eid="DAN 8:14" /></para>
  <para style="s">गाब्रीएल देवदुतो वाअहीं होपनाआ अर्थ कोअलोअ</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15" />“ए गोठी दर्शनोमेहें पालित कोइत, आंय दानियेल, याहा समजीइलोअ कोशित कोउ वोल्यु, तेताजमेहें माटीइ रुप लेत कोइत कोडो तेबी माआं आगाड़ी उबो रोल्यो देखाअयो. <verse eid="DAN 8:15" /><verse number="16" style="v" sid="DAN 8:16" />ताहां माहूं उलय नोयीमेहें रोत एका माहुंउं आवाज आयु, जो आअड़ीत कोइत कोतुतो, ‘ए गाब्रीएल, या माट्योहो ये देखल्यी गोठी समजाड़ी दे.’ <verse eid="DAN 8:16" /><verse number="17" style="v" sid="DAN 8:17" />ताहां जिहीं आंय उबु ओतु, तिहीं तो माआं जागे आयु; आन तियाहा आवताज आंय बित गोयु; आन निसे पुयींपोअ उठ्लीत पोड़्यू. ताहां तिये माहूं कोयो, ‘ए माहुंउं पोर्‍या, तुमे देखल्यी गोठीही समजीत ले, काहाके ते आखरीइ दिहोअ बाप्तिम होय.’ <verse eid="DAN 8:17" /><verse number="18" style="v" sid="DAN 8:18" />जेहेलाम तो माअरी गोठी कोअतुतो, तेहेलाम आंय माआं सोब पुयींइं वोल कोइत वोडी निंदेमेहें पोड़्युतो, पोन तिये माहूं आथ लागाड़ीत कोइत सिदु उबू कोअयू. <verse eid="DAN 8:18" /><verse number="19" style="v" sid="DAN 8:19" />ताहां तिये कोयो, ‘आखरीइ खोत कोइलाआ दिहोमेहें जों ओवनारो होय, तों आंय ताहूं कोहो; काहाके ठरवीइल्या दिहोमेहें आखी सेवट्यीइ गोठी पुरी ओत जाय.’”<verse eid="DAN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 8:20" />“जो बेन हिंगोवालू मेडू तुमे देख्यू, तियाआ अर्थ मादी आन फारसी एं बेन राज्ये<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="fq" closed="false">राज्ये </char><char style="ft" closed="false">राजा</char></note> होय. <verse eid="DAN 8:20" /><verse number="21" style="v" sid="DAN 8:21" />आन तो बुराल बोकड़ू ग्रीसोअ राज्य<note caller="+" style="f"><char style="fr" closed="false">8:21 </char><char style="fq" closed="false">राज्य </char><char style="ft" closed="false">राजा</char></note> होय; आन तियाआ डोआअ विसमेहें हिंग निहींयो, तो पेहलु राजा होय. <verse eid="DAN 8:21" /><verse number="22" style="v" sid="DAN 8:22" />जों हिंग टुटीत गोयो तियाआ जागापोअ बिहीरे शार हिंगे निहींये, तियाआ अर्थ ओं होय, तिया राज्यामेहें रोत शार राज्ये बोणे, पोन तें पेल्लाआ राज्याआ होस मजबुत ने रोय.”<verse eid="DAN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 8:23" />“तियां राज्याआ सेवट वेगुज ओवे, काहाके तें जास्ती खाराब ओत जाय, तेहेलाम एक जिद्दी, पापी आन धोकू देनारु राजा उठे. <verse eid="DAN 8:23" /><verse number="24" style="v" sid="DAN 8:24" />तियाआ सेक्ती वोडी रोय, पोन तिया पेल्लाआ राजाआ होस ने रोय; तो निस्तु जुदे माहें माएं, आन जिकीत कोइत काम कोअतु रोय, ताकतवाला आन सोका माअहोंअ टोलाहा आरवी देय. <verse eid="DAN 8:24" /><verse number="25" style="v" sid="DAN 8:25" />तियाआ हुशारी वाअहीं तो जिकीत जाय, आन तो मोनोमेहें वोडाय कोइत वारुज माअहोंहों आरवी देय. तो वारुज अधिकाऱ्योअ विरुद्दामेहें उबु रोय; पोन सेवटी तो माहुंउं आथ ने लागे तेहेंज मोइत जाय. <verse eid="DAN 8:25" /><verse number="26" style="v" sid="DAN 8:26" />हांजेए वेले आन वेगीइ वेले जों किबी तुमे देख्यो आन होंबल्यो तों खोरो होय; पोन जों किबी तु दर्शनोमेहें पाल्योहो तियाहा निकाड़ीत मिकजी, काहाके तो वारुज दिहोअ फासाड़ी पुरो ओवनारो होय.”<verse eid="DAN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 8:27" />“ताहां आंय दानियेल, आंय लुलू ओत गोयू, आन आंय थोड़ाक दिही जाआं बिमार पोड़ीत रोयु, ताहां आंय उठीत कोइत राजाआ कामकाज फाशुउ कोउ वोल्यु; पोन जों आंय पाल्यो तिहीं वाअहीं बोगलात गोयू, काहाके तिया होपनाआं अर्थ समजाड़नारो कोडोज ने ओतो.”<verse eid="DAN 8:27" /></para>
  <chapter eid="DAN 8" />
  <chapter number="9" style="c" sid="DAN 9" />
  <para style="s">सोताआ माअहोंअ कोअते दानियेलोअ प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1" />अश्वेरोशोअ पोर्‍यु दारा जो मादी ओतू, तो खास्द्याआं देसोपोअ राजा बोण्युतो. <verse eid="DAN 9:1" /><verse number="2" style="v" sid="DAN 9:2" />तियाआ राज्याआ पेहला वोरह्योमेहें, आंय दानियेले सोका पुस्तकों वाअहीं समजीत लेदो के, यिर्मया भविश्यवक्ताहा यहोवा देवे आपल्या वसनोअ परमाणे थोड़ेक वोरह्ये सेकीत जाय तिहींइं फासाड़ी, मोन्ज्ये सत्तर वोरह्योंअ फासाड़ी येरुसालेमोअ उजड़ीइल्यी दशा पुरी ओत जाय. <verse eid="DAN 9:2" /><verse number="3" style="v" sid="DAN 9:3" />ताहां आंय माआं सोब प्रभु देवोअ वोल कोइत प्रार्थना कोअयी, आन उपास कोइत पेंडीइ पोताआ आंगड़े पोवित, खाँओंम बोहीत विनंती कोअयी. <verse eid="DAN 9:3" /><verse number="4" style="v" sid="DAN 9:4" />आंय माआं देव यहोवाहा एहेंकोइत प्रार्थना कोअयी आन पापोहो कबुल कोअयू, “प्रभु देवा, तु वोडाम वोडु आन मानपानोअ जोगुहू देव होय. तापोअ मेर कोअनाराअरी आन आदेश माननाराअरी तु ताआ शप्पत पुरी कोअहे आन दया कोअहे.<verse eid="DAN 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 9:5" />“आमू पाप कोअयू, लबाड़ी कोअयी, खाराब कामे कोअये, ताआ नाकार कोअयू, ताआ आदेश आन नियमोहों तोड़ी देदू. <verse eid="DAN 9:5" /><verse number="6" style="v" sid="DAN 9:6" />ताआ सेवक जे भविश्यवक्ता ओता, ते आमाआं राजां, आधिकाऱ्यों, डायहां आन आखा माअहोंअरी ताआ नावसे गोठी कोअयी, तियांआं आमू ने उनाअया. <verse eid="DAN 9:6" /><verse number="7" style="v" sid="DAN 9:7" />प्रभु, तु धर्मी होय, पोन आज आमुहूं लाजवाअहूं पोड़ेहे, मोन्जे येरुसालेमोम रोनारा आखा यहुद्याहां, जागेवाले, सेटेवाले आखा इस्राएलवाला माअहोंहों, तापोऱ्युउ विश्वास तोड़ल्यु कोत तियांहां वेरासेर कोइत टाक्येहे, ताआ विरुद्दाम खाराब कामे कोअल्ये कोत तियांहां लाजवाअहूं पोड़ेहे. <verse eid="DAN 9:7" /><verse number="8" style="v" sid="DAN 9:8" />यहोवा देवा, आमू आमाआं राजाहां आधिकाऱ्योहों आन डायहान-होंअका ताआ विरुद्दाम पाप कोअयुहू, तियाहाकोत आमुहूं लाज आवेहे. <verse eid="DAN 9:8" /><verse number="9" style="v" sid="DAN 9:9" />पोन यहोवा प्रभु, तु दयालू होय. जियां माअहूं खाराब कामे कोअये तेबी माफी आप्यी, आमू खोरीज ताआ विरुद्दाम काम कोअयोहो. <verse eid="DAN 9:9" /><verse number="10" style="v" sid="DAN 9:10" />आमू ते आमाआं यहोवा देवोअ कायदू उनाइत कोइत बी ने मान्ये, जो तिये तियाआ सेवक भविश्यवक्ता वाअहीं कोत आप्युतो. <verse eid="DAN 9:10" /><verse number="11" style="v" sid="DAN 9:11" />आखे इस्राएलवाले ताआ शिक्शण ने मान्ये; तियां आखा ताआ वोल सोब मुउड़ीत लेदी; तें ताआ गोठी ने उनाअये. तिहीं वाअहीं जे हाराप आन नियम देवोअ सेवक मोशेए कायदामेहें लेखाअया, ते हाराप आमापोअ आवित लागा; काहाके आमू तियाआ विरुद्दाम गुनू कोअयुहू. <verse eid="DAN 9:11" /><verse number="12" style="v" sid="DAN 9:12" />तियाहाकोत तिये आमाआं आन पुडाऱ्योअ बाप्तिमेहें जें वसने कोयेते, तें तिये आमापोअ वोडी अड़सन लेतावित पुरे कोअये; जेहेलिही आफत येरुसालेमोपोअ पोड़्यीही, तेहलिही धरतीपोअ काज ने पोड़्यी. <verse eid="DAN 9:12" /><verse number="13" style="v" sid="DAN 9:13" />जेहेलोहो मोशेए कायदामेहें लेख्योहो, तेहेंज कोइत ए आखी अड़सन आमापोअ आवीत पोड़्यी, तेबी आमू आमाआं देव यहोवाआ आगाड़ी आमाआं खाराब कामोंहों मानुहूं काजे तियार ने ओवे, आन ने ताआ खोरी गोठीपोअ ध्यान देदो. <verse eid="DAN 9:13" /><verse number="14" style="v" sid="DAN 9:14" />तियाहाकोत यहोवा देवे सोसी-समजीत आमापोअ अड़सन टाक्यी; काहाके आमाआं देव यहोवा जेते कामे कोअहे तियां आखामेहें खोरु ठरेहे; पोन आमू तियाआ गोठी ने उनाअये.<verse eid="DAN 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 9:15" />“ओमे, आमाआं देवा, प्रभु, ताआ माअहोंहों मिसर देसोमेहें रोत, वोडी ताकतवाला आथोवाअहीं काडीत लेत आयू आन ताआ वोडो नाव कोअयो, जों आज जाआं नावलीइतेहे, पोन आमू पाप कोअयुहू आन खाराब कामे बी कोअयेहे. <verse eid="DAN 9:15" /><verse number="16" style="v" sid="DAN 9:16" />प्रभु, आमाआं पाप आन आमाआं डायहांआं खाराब कामोंअ वाखरी आमाआं आसेपासेए आखे माअहें येरुसालेमोअ वोल ताआ माअहोंओं बदनामी कोअतेहे; तियाहा काजे तु ताआ आखा हाजा कामों वाअहीं ताआ खोत आन जलन ताआ सोका डोगोपोअ बोठ्ला ताआ होयर येरुसालेमोपोअ रोत काडीत ले. <verse eid="DAN 9:16" /><verse number="17" style="v" sid="DAN 9:17" />आमाआं देवा, ताआ सेवकोअ प्रार्थना आन विनंती उनाइत कोइत, ताआ उजड़ीइल्या सोका जागापोअ ताआ मुखोअ उजालो सोमकाड़; ए प्रभु, ताआ नावोअ वाखरी ओं कोअ. <verse eid="DAN 9:17" /><verse number="18" style="v" sid="DAN 9:18" />माआं देवा, आमाअहें कान दे, ताआ नजर आमाआं वोल कोअ, आमाआं उजड़ीइल्यी दशा आन तिया होयरोहो बी पाल जों ताआ कोवाअहे; काहाके आमू जे आगाड़ी विनंती कोअतेहे, आमू हाजे होय एहें कोत नाहां, पोन ताआ वोडी दयापोअ भरीवसू मिकीत कोइत कोअतेहे. <verse eid="DAN 9:18" /><verse number="19" style="v" sid="DAN 9:19" />प्रभु, उनाइत ले; माआं प्रभु, पापोअ माफी आप; प्रभु, ध्यान मिकीत जो कोइलाआ होय तों कोअ, वाआ मा लागाड़ही, ए माआं देवा, ताआ होयर आन ताआ माअहें ताआज कोत ओलखाअतेहे; तियाहा कोत ताआ नावोअ वाखरी एहें कोअ.”<verse eid="DAN 9:19" /></para>
  <para style="s">गाब्रीएल भविश्यवाणीहीं समजाड़त्लू</para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 9:20" />“एहें कोइत आंय प्रार्थना कोअतुतो, आन माआं आन माआं इस्राएलवाला पाव्हीइलाआं पापोअ कबुली कोअतुज, आपाआ यहोवा देवोअ हुंबर तियाआ सोका डोगोअ काजे विनंती कोअतुतो, <verse eid="DAN 9:20" /><verse number="21" style="v" sid="DAN 9:21" />ताहां तो माटी गाब्रीएल जियाहा आंय तियी वेले देख्यो जेहेलाम माहूं पेलुज दर्शन ओवोतो, तो जोरे जोरे उडीत माआ जागे आयू, हांस्तीइ वेले गाराहा कोइलोअ वेले माहूं टेक्यु; माहूं समजाड़ीत गोठी कोउ वोल्यु. <verse eid="DAN 9:21" /><verse number="22" style="v" sid="DAN 9:22" />तिये माहूं कोयो, ‘ए दानियेल, आंय ताहूं बुद्दी आन समज आपीइलो काजे निहींत आयुहू. <verse eid="DAN 9:22" /><verse number="23" style="v" sid="DAN 9:23" />जेहेलाम तु विनंती कोइलाअ सुरुवात कोअयी, ताहांज आदेश जोड़्यू, तियाहा कोत आंय ताहूं कोअलोअ काजे आयुहू; काहाके तु मेरालु ठर्‍युहू; तियाहा कोत तु तियी गोठीही समजीत ले आन दर्शनोअ गोठीइ अर्थ जाईंत ले.’”<verse eid="DAN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 9:24" />“ताआ माअहें आन ताआ सोका होयरोअ काजे सत्तर आठीवड़ा ठरवाअयाहा, काहाके तियामेहें तियांआं सेवट जाआं पाप कोइलाआ आन खाराब काम कोइलाआ सोड़ी देअहूं जोवे, आन हादाफल्योअ सतीपण प्रगट ओवुहूं जोवे; आन दर्शनोअ गोठी पोअ आन भविश्यवाणी पोअ सिक्कू लागुहूं जोवे, आन सोकाम सोकाआ अभिशेक कोअहूं जोवे. <verse eid="DAN 9:24" /><verse number="25" style="v" sid="DAN 9:25" />तियाहा कोत ओं जाईंत आन समजीत ले, काहाके येरुसालेमोहों फाशोअ बोहाड़ीइलोअ आदेश निहींइलो वाअहीं अभिशेक कोअल्या<note caller="+" style="f"><char style="fr" closed="false">9:25 </char><char style="fq" closed="false">अभिशेक कोअल्या </char><char style="ft" closed="false">मसीह</char></note> मुख्याआ वेले जाआं हांत आठीवड़ा सेके. तिहीं रोत बाहासाट आठीवड़ा सेके, तेहेलाम सोवकड़ी आन खायारान-हायारा तिया होयरोहो फाशोअ तारासोअ दिहोम बोहाड़े. <verse eid="DAN 9:25" /><verse number="26" style="v" sid="DAN 9:26" />ते बाहासाट आठीवड़ा सेकीत जाय, तेहेलाम तिया देवोअ निवड़ीइल्या माट्योहो माइत टाके; पोन किज ने आथ लागे; आन बिहीरा आवनारा मुख्याआ माअहें होयर आन सोका जागाहा आरवीत देय, आन तिया मुख्याआ सेवट फोला खाडाआ होस ओवे; तेबी तियाआ सेवट जाआं लड़ायी ओवती रोय; काहाके तियाहा उजाड़ीइलो नक्की ठरीत गोयोहो. <verse eid="DAN 9:26" /><verse number="27" style="v" sid="DAN 9:27" />तो मुख्यू एका आठीवड़ाआ काजे वारुज जोओंअरी कड़क शप्पत खाय, पोन आरदाज आठीवड़ा सेके तेहेलाम तो अर्पण आन गाराहा कोइलाआ बोंद कोए; ताहां उजाड़नारी सिसड़ाअली वस्तू देखाय आन ठरल्यी गोठ पुरी ओवे ताअहूं जाआं उजाड़नारापोअ देवोअ खोत रोय.”<verse eid="DAN 9:27" /></para>
  <chapter eid="DAN 9" />
  <chapter number="10" style="c" sid="DAN 10" />
  <para style="s">दानियेलोअ खाडीइ मेरे दर्शन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1" />फारस देसोअ राजा कोरेश तियाआ सालतीइ तिसरा वोरह्योमेहें दानियेलोपोअ एक गोठ प्रगट कोअयी, जियाहा बेलेतशेस्सर कोत बी ओलखीइतेते. ते गोठ खोरी ओती के वोडी लड़ायी ओवे. तिये ए गोठी जाईंत लेदी, आन तियाहा ए देखल्यी गोठी समजात गोयी.<verse eid="DAN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 10:2" />“तियां दिहोमेहें, आंय दानियेल तिन आठीवड़ा जाआं जास्ती दुखी ओतु. <verse eid="DAN 10:2" /><verse number="3" style="v" sid="DAN 10:3" />ते तिन आठीवड़ा पुरा ओवे ताअहूं जाआं, आंय ने होवादू रोटू के, माहां के, दाराक्शाआ रोहो माआं सोबीम गोयू, आन ने माआं डिलोपोअ तेल लागाड़्यो.<verse eid="DAN 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 10:4" />“फाशोअ पेहला मोयनाआ शोविसवा दिहोअ दिही जेहेलाम आंय हिद्देकेल नावोअ नोयीइ मेरे उबु ओतु, <verse eid="DAN 10:4" /><verse number="5" style="v" sid="DAN 10:5" />ताहां आंय उसे नजर कोइत पाल्यो, ते पेंडीइ हुतोअ आंगड़े पोवित, आन उफाज देसोअ होनाआ पोट्टा वाअहीं कंबर बांदीत एक माटी उबु रोत रोल्यू देख्यू. <verse eid="DAN 10:5" /><verse number="6" style="v" sid="DAN 10:6" />तियाआ डिल समकीइनारा फिरोजा नावोअ डोणोअ होस, तियाआ मुख विजेए होस, तियाआ डोआ पेटाअत्ली दिवीइ होस, तियाआ आथेन गुडा समकीइनारा तांबाआ होस, तियाआ आवाज माअहोंअ गर्दीइ होस वोडू ओतु.<verse eid="DAN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 10:7" />“तियाहा निस्त आंय दानियेले एतोज देख्यो, आन माअरीइ हात्योहों तियाआ किज दर्शन ने ओवो; पोन तेबी जास्तीज कापा वोल्या, आन निकाइलोअ कोअते गुगदा वोल्या. <verse eid="DAN 10:7" /><verse number="8" style="v" sid="DAN 10:8" />ताहां आंय एखलुज रोत कोइत ओं वोडो दर्शन पालतु रोयू. यावाअहीं माआं सेक्ती कमी पोड़ीत गोयी, आन माआं सोब उगात गोयी; आन जास्ती लुलू पोड़ीत गोयू. <verse eid="DAN 10:8" /><verse number="9" style="v" sid="DAN 10:9" />ताहां आंय तियाहा गोगत्लाहा उनाअयु, तियाआ आवाज उनाअताम आंय पुयींपोअ उबडू पोड़ीत गोयू आन वोडी निंदेम पोड़ीत रोयू. <verse eid="DAN 10:9" /><verse number="10" style="v" sid="DAN 10:10" />ताहां कोडे तेबी तियाआ आथो वाअहीं माहूं तोइत उठाड़्यू आन टोसणोन आथोअ जोरो वाअहीं कापत्लाहाज बोहाड़्यू.”<verse eid="DAN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 10:11" />ताहां तिये माहूं कोयो, “ए दानियेल, देव तापोअ मेर कोअहे, जों वसन आंय ताहूं कोहो, तियाहा समजीत ले, आन हुदू उबू रो, काहाके ओमे आंय ताआ जागे आवयुहू.” जेहेलाम तिये माहूं ओं वसन कोयो, तेहेलाम आंय उबू ते रोयू, पोन थुर थुर कापतू रोयु.<verse eid="DAN 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 10:12" />फाशोअ तिये माहूं कोयो, “ए दानियेल, मा बिही, काहाके पेल्लाआज दिहोम तुमे समजीइलाआ काजे मोन लागाड़्यो आन देवोअ हुंबर सोताहा नम्र ओवू, तेदिहींज देवे ताआ शब्द उनाइत लेदो, आन आंय ताआ प्रार्थना वाअहींज इंहीं आयुहू. <verse eid="DAN 10:12" /><verse number="13" style="v" sid="DAN 10:13" />फारसोअ राज्याआ मुख्यू एकविस दिही जांआं माअरी लड़ायी कोअतु रोयू; पोन मिखाएल जो मुख्य पुडाऱ्योंमेहें रोत होय, तो माआं मदत कोइलोअ काजे आयु, तियाहा कोत आंय फारसवाला राजाआ जागे रोयु, <verse eid="DAN 10:13" /><verse number="14" style="v" sid="DAN 10:14" />आन ओमे आंय ताहूं समजाड़ू आयुहू, के सेवट्याआ दिहोमेहें ताआ माअहोंअ कि दशा ओवे, काहाके जों दर्शन तुमे पाल्योहो तों थोड़ाक दिहोमेहें पुरो ओवे.<verse eid="DAN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 10:15" />“जेहेलाम तो माटी माहूं ए गोठी कोत आप्यी, ताहां आंय धरतीइ वोल सोब कोअयीन ठावकुज रोयू. <verse eid="DAN 10:15" /><verse number="16" style="v" sid="DAN 10:16" />ताहां माअहोंअ होस देखाअनारो एक जोंओं माआं सोबीही आथ लागाड़्यू, आन आंय सोब उगाड़ीत कोइत गोगु वोल्यु. जो माआं हुंबर उबु ओतु, तियाहा आंय कोयो: ए माआं मालिख, यीं दर्शनोअ गोठी वाअहीं आंय बियुहू, आन मामेहें किज ताकत नाहां रोयी. <verse eid="DAN 10:16" /><verse number="17" style="v" sid="DAN 10:17" />तियाहाकोत मालिख, आंय ताआ सेवक, आंय ताअरी केहें कोइत गोठी कोइत सेकहीं? काहाके माआं डिलोमेहें ते सेक्ती ने रोयी, आन माआं दोम रुकाउ वोल्यू.”<verse eid="DAN 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 10:18" />“ताहां माअहोंअ होस कोडे तेबी आथ लागाड़ीत माहूं तोअयु आन फाशीइ माहूं टोणकाय जोड़्यी. <verse eid="DAN 10:18" /><verse number="19" style="v" sid="DAN 10:19" />आन तिये कोयो, ‘देव तापोअ मेर कोअहे, मा बिही, ताहूं शांती जोड़े; तु मजबुत ओव आन धिर तोअ.’ जेहेलाम तिये ओं कोयो ताहां आंय मजबुत ओवीत कोइत कोयो: ए माआं मालिख, ओमे को, काहाके तुमे माहूं धिर आप्युहू.”<verse eid="DAN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 10:20" />ताहां तिये कोयो, “केहें तु जाअहें के आंय ताआ जागे काहा आयुहू? ओमे आंय फारसोअ मुख्याअरी लड़ायी कोऊ जाहीं; आन जेहेलाम आंय निहींहीं, ताहां युनानोअ मुख्यू आवे. <verse eid="DAN 10:20" /><verse number="21" style="v" sid="DAN 10:21" />जो किबी खोरी गोठीवाअहीं पोआला पुस्तकोमेहें लेख्योहो, तों आंय ताहूं कोहो, तियां मुख्याआ विरुद्दाम वातड़ू उबू रोनारु तुमाआं मुख्या मिखाएलोहो सोड़ीत माअरी फाशोअ कोडोज कायनाहां.”<verse eid="DAN 10:21" /></para>
  <chapter eid="DAN 10" />
  <chapter number="11" style="c" sid="DAN 11" />
  <para style="p">
    <verse number="1" style="v" sid="DAN 11:1" />“दारा नावोअ मादी राजाआ सालतीइ पेलठा वोरह्योमेहें तियाहा आधार आन ताकत आपिइलाआ काजे आंयुज उबू रोत गोयू.”<verse eid="DAN 11:1" /></para>
  <para style="s">मिसर आन सिरियाआ राज्य</para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 11:2" />“ओमे आंय ताहूं खोरी गोठ कोहो, पाल, फारसोअ राज्यामेहें ओमे तिन राजा उठे; आन तिहींइं फासाड़ी एक शोवथु राजा उठे. ओ राजा तियां फारसवाला राजां रोत जाअखू मालदार रोय; आन तो राज सालाड़ीइलो काजे पोशाआ वापर कोए, आन बाकी माअहोंहों ग्रीस राज्याआ विरुद्दामेहें उरी सोड़वे.”<verse eid="DAN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 11:3" />“तिहींइं फासाड़ी एक वोडी ताकतेवालू राजा उठे आन तियाआ राज्य वादाड़े, आन तियाहा पोटे तेहेलोहो तो राज कोए. <verse eid="DAN 11:3" /><verse number="4" style="v" sid="DAN 11:4" />पोन तियाआ जम ने बोहे तेहेंज तियाआ राज्य टुटीत कोइत शारी ओरी वाटाइत जाय; तिहीं रोत तियाआ राज्याहा पेल होय तेहलीही सेक्ती ने जोड़े आन तियाआ पारवाड़ीही बी किज ने जोड़े; काहाके तियाआ राज्य उपटीत बिहीराआ ताबाम जातो रोय.”<verse eid="DAN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 11:5" />“ताहां देहामाआं मिसर<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="fq" closed="false">मिसर </char><char style="ft" closed="false">इजिप्त देश</char></note> देशोअ राजा सेक्ती वालू बोणे: पोन तियाआज एक सेनापती तियाहा हारवीत कोइत तो राज कोउ वोले आन तोज जम बोहाड़ीत लेय. <verse eid="DAN 11:5" /><verse number="6" style="v" sid="DAN 11:6" />थोड़ेक वोरह्ये सेकीत गोये तिहींइं फासाड़ी, ए बेनू एकमेकाहा मिले, आन देहामा देसोअ राजाआ पोर्‍यी पालामा वोल्याआ सिरिया देसोअ राजाअरी शांती करारोअ काजे वेहेवाल कोइत लेय; पोन तियीइ ताकत ने रोय, माअहें तियीइ आन तियीइ पोऱ्याआ विरुद्दाम उठे आन तियीही तिया देशोम लेत आवनाराहां नेहें माइत टाके. <verse eid="DAN 11:6" /><verse number="7" style="v" sid="DAN 11:7" />फाशोअ तियीइज कुटूंबामेहें रोत एक जोऊं देहामाआं वोल्याआ राजाआ जागू लेत लेय, आन तो पालामाआ राजाआ सेनाअरी लड़ाय कोइत जिकीत जाय. <verse eid="DAN 11:7" /><verse number="8" style="v" sid="DAN 11:8" />तो तियांआं देवताआं मुर्ती, लोड़ाआ आथिवल्यी मुर्ती आन होना-सांदीइ मोगवाड़्यी वस्तु बुउसीत कोइत मिसरोमेहें लेतावे; ताहरुउ थोड़ेक वोरह्ये जाआं पालामाआं वोल्याआ राजाअरी लड़ाय ने कोए. <verse eid="DAN 11:8" /><verse number="9" style="v" sid="DAN 11:9" />तिहीं रोत तो राजा देहामाआं देसोअ राजाअरी लड़ाय कोऊ आवे, पोन फाशुउ तियाआ देसोम जातु रोय.”<verse eid="DAN 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 11:10" />“फाशाआ तियाआ पोर्‍या लड़ाय सुरु कोई देय आन वोडी वोडी सेयनिकोअ तुकड़ी टोलू वाले, आन हाडाअतेज देशोअ विसमेहें रोत सोरके आन वोलीइली वेले तियाआ गोडोअ जागे जाआं आवित ठोकाय. <verse eid="DAN 11:10" /><verse number="11" style="v" sid="DAN 11:11" />ताहां देहामाआं वोल्युउ राजा खिजवाय, आन निहींत कोइत पालामा वोल्याआ राजाअरी लड़ाय कोउ वोले, आन तो राजा लड़ायीइ कोअते वोडी गर्दी टोलू वाले, पोन ते गर्दी देहाम्या राजाआ आथोम होपात जाय. <verse eid="DAN 11:11" /><verse number="12" style="v" sid="DAN 11:12" />तियी गर्दीही जिकीत कोइत तो तियाआ मोनोम वोडाय कोए, आन तो लाखो माअहोंहों माए, पोन तियाआ जित जाअखी ने टिके.<verse eid="DAN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 11:13" />“काहाके पालामा देसोअ राजा आवीत कोइत पेल्लीइ गर्दी रोत जाअखी वोडी गर्दी टोलू वाले; आन थोड़ाक दिहोम नेत थोड़ेक वोरह्ये सेलाय; तेहेलाम तो वोडी सेना आन धन लेत आवे. <verse eid="DAN 11:13" /><verse number="14" style="v" sid="DAN 11:14" />तियां दिहोमेहें वारुज माअहें देहाम्या देसोअ राजाआ विरुद्दाम उठे; आन ताआज माअहोंमेहें रोत नुकसान कोअनारे उठीत पोड़े, जिहीं वाअहीं ए दर्शनोअ गोठ पुरी ओत जाय; पोन तें उदड़ीज ठोकात पोड़े. <verse eid="DAN 11:14" /><verse number="15" style="v" sid="DAN 11:15" />ताहां पालामा देसोअ राजा आवीत कोइत केंडवारीत लेय आन मजबुत होयरोहो लेत लेय; आन आन देहामा देसोअ ने ते पुडारी उबा रोय आन ने वोडा बाहादीर, काहाके कोडामेहें उबा रोअलोअ ताकत ने रोय. <verse eid="DAN 11:15" /><verse number="16" style="v" sid="DAN 11:16" />ताहां जो बी तियांआं विरुद्दामेहें आवे, तो सोताआ इश्शा पुरी कोए, आन तो आथोमेहें आरवाइलोअ सेक्ती लेत मुख्य देसोमेहें उबू रोय आन तियाअरी टक्कर लेनारु कोडुज ने रोय.<verse eid="DAN 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 11:17" />“ताहां तो तियाआ राजोअ पुरी ताकतो वाअहीं, थोड़ाक हाजा माअहोंहों आरी लेत कोइत आवे, आन तियाआ इश्शाआ परमाणे काम कोअया कोए. तो तियाआ राज्य बिगाड़ीलोअ काजे तियाहा एक बोईं आपे; पोन ते टिकीत ने रोय आन ते ने तिया राजाआ बोणे. <verse eid="DAN 11:17" /><verse number="18" style="v" sid="DAN 11:18" />ताहां तो विसगाल्या दोर्‍याआ मेरेए देसोंअरी लड़ाय कोऊ आवे, आन वारुज होयरोहों जिकीत लेय, पोन तियाआ एक सेनापती तियाआ वोडाय काडीत टाके. <verse eid="DAN 11:18" /><verse number="19" style="v" sid="DAN 11:19" />ताहां तो राजा तियाआ देसोअ मजबुत किल्लामेहें फाशुउ जाय, पोन तो कमजोर ओत पोड़े आन सेलात जाय.<verse eid="DAN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 11:20" />“ताहां तियाआ जागापोअ एखु एहेलुहू उठे, जो मुख्य राज्यामेहें फालू टोलु कोअनाराहा फिरवे; पोन थोड़ाक दिही सेकीत जाय तेहेलाम तो खोते वाअहीं नाहां, पोन बिगर लड़ाय कोअयेज आरवाइत जाय.”<verse eid="DAN 11:20" /></para>
  <para style="s">सिरियाआ खाराब राजा</para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 11:21" />“तियाआ जागापोअ एक खाराब राजा गादीपोअ बोहे, जो राजा बोणिइलोअ लायक ने रोय, पोन तो गुल्यी गुल्यी गोठी वाअहीं राज्य मिलवीत लेय. आन जाहां माअहें पोलेमेहें पोड़ीत रोय तेहेलाम तो बिगर सुसना कोअयेज गादीपोअ बोहीत जाय. <verse eid="DAN 11:21" /><verse number="22" style="v" sid="DAN 11:22" />ताहां तियाआ सेक्तीमान सेना वाअहीं माअहें आन शप्पतोअ पुडारी बी ठोगाइत आरवाइत जाय. <verse eid="DAN 11:22" /><verse number="23" style="v" sid="DAN 11:23" />काहाके तो तियाअरी ठोगोअ करार कोए, आन थोड़ाज माअहोंहों आरी लेत कोइत जिकीत जाय. <verse eid="DAN 11:23" /><verse number="24" style="v" sid="DAN 11:24" />तो बिगर कोताज मालदार देसोपोअ लड़ाय कोए; जों काम तियाआ डायहां आन डायहांआं डायहां ने कोअयोय, तियाहा तो कोए; आन लुटल्या मालधनोमेहें रोत वाट्या कोए. तो थोड़ेक वोरह्ये जाआं मजबुत होयरो पोअ ताबू लेअलाआ विसार कोअतु रोय.<verse eid="DAN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 11:25" />“ताहां तो देहामा देसोअ राजाआ विरुद्दाम वोडी सेना लेत तियाआ ताकत आन हिम्मत वादाड़े, देहामा देसोअ राजाआ खुब वोडी आन ताकतवाली सेना लेत कोइत लड़ाय ते कोए, पोन तियाहा ने टिकाय, काहाके माअहें तियाआ विरुद्दामेहें विसार कोए. <verse eid="DAN 11:25" /><verse number="26" style="v" sid="DAN 11:26" />तियाआ रोटू खानारे बी तियाहा हारवी देय; तियाआ सेना आरवाइत जाय, तियाआ वारुज माअहें मोए. <verse eid="DAN 11:26" /><verse number="27" style="v" sid="DAN 11:27" />ताहां ते बेनु राजा लबाड़ी कोआ वोले, ते एकाज टेबलोपोअ बोहीत कोइत ठोगोअ गोठी कोए, पोन यावाअहीं किज ने ओवे; काहाके यी गोठीइ सेवट वेलेपोअ ओवे. <verse eid="DAN 11:27" /><verse number="28" style="v" sid="DAN 11:28" />ताहां पालामाआं राजा वोडी लुट लेत तियाआ देसोम आवे, आन तियाआ मोन सोकी शप्पतेए विरुद्दाम रोय, तो तियाआ इश्शा पुरी कोइत तियाआ देसोमेहें आवतु रोय.<verse eid="DAN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 11:29" />“बोराबर वेल आवताज तो फाशुउ देहामा देसोअहें जाय, पोन तो पेल जिकुहू तेहेलोहो ओमे तियाहा ने जिकाये. <verse eid="DAN 11:29" /><verse number="30" style="v" sid="DAN 11:30" />काहाके कित्तीवालाआं जाहाजी तियाआ विरुद्दामेहें आवे, आन तो नाराज ओवित फासकुंड्या फिरे, आन सोकी शप्पतेए वाखरी खिजवात कोइत तियाआ इश्शा पुरी कोए. तो आवीत कोइत सोकी शप्पत तोड़नाराआ कालजी लेय. <verse eid="DAN 11:30" /><verse number="31" style="v" sid="DAN 11:31" />ताहां तियाआ सेयनिक उबा रोत कोइत मजबुत सोका जागाहा एठु कोए, आन दाडख्युउ होमबली बोंद कोए. ते तियी खाराब वस्तुहू उबी कोए, जे एठी समजाअहे. <verse eid="DAN 11:31" /><verse number="32" style="v" sid="DAN 11:32" />आन जें माअहें पापी ओत कोइत तियी शप्पतेहे तोड़े, तियांहां तो गुल्यी गुल्यी गोठ कोत आपित विण-भक्तीवाले बोणावी देय; पोन जें माअहें तियांआं देवोअ आदेश माने, तें हिम्मत कोइत वोडे वोडे कामे कोए. <verse eid="DAN 11:32" /><verse number="33" style="v" sid="DAN 11:33" />माअहोंहों सिकाड़नारे हुशार माअहें वारुज जोअहों समजाड़े, तेबी तें वारुज दिही जाआं तारवाई वाअहीं माआंय आन आगी वाअहीं पेटाय, आन जेलीमेहें टाकाय, कोएं लुटाय, एहें कोइत वोडी आफतोमेहें पोड़ीत रोय. <verse eid="DAN 11:33" /><verse number="34" style="v" sid="DAN 11:34" />जेहेलाम ते आफतोमेहें पोड़ीत रोय तेहेलाम तियांहां खुब कमी मदत जोड़े, पोन वारुज माअहें गुल्यी गुल्यी गोठ कोत आपित तियांमेहें सान्बात जाय; <verse eid="DAN 11:34" /><verse number="35" style="v" sid="DAN 11:35" />आन थोड़ेक समजदार माअहें पोड़े, तें काहा कोत पोड़े, काहाके, तें सोके आन साफसुफ ओवुहूं जोवे. ए दशा सेवट जाआं रोय, काहाके ए आखी गोठी सेवटीपोअ बोराबर वेलेपोअ ओवनारी होय.<verse eid="DAN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 11:36" />“ताहां तो राजा तियाआ इश्शाआ पुरमाणे काम कोए, आन सोताहा आखा देवोम रोत वोडू कोवड़ावे; तेहेंज आखा देवताआ बोगवानोअ विरुद्दामेहें बी बाक्ती गोठी कोए. जाअहूं जाआं देवोअ खोत ठावकी ने ओत जाय ताअहूं जांआं तिया राजाआ कामोंअ जिक ओवती रोय; काहाके जों किबी पाक्को कोइत ठरवीत लेदोहो तों हुदाअलीज पुरो ओवनारो होय. <verse eid="DAN 11:36" /><verse number="37" style="v" sid="DAN 11:37" />तो तियांआं डायहांआं देवोअ विसार ने कोए, ने बोईंइं बाप्तिम मेरेए सिंता कोए आन ने कोडा देवोअ; काहाके तो सोताहा आंय आखाम रोत वोडू कोत समजे. <verse eid="DAN 11:37" /><verse number="38" style="v" sid="DAN 11:38" />तो तियाआ राजपदोपोअ टिकीत कोइत गोडोअ देवताआज पुंजन कोए, एक एहेला देवोअ जियाहा तियाआ डाये बी ने ओलखीइतेते. तो होनो, सांदी, मोगलू डोण आन गोवणो आपीत कोइत तियाआ पुंजन कोए. <verse eid="DAN 11:38" /><verse number="39" style="v" sid="DAN 11:39" />तियां पारका देवताआ मदते वाअहीं पाक्का किल्लाअरी लड़ाय कोए, आन जो कोडो तियाहा माने तियाहा तो वोडू मान आपे, आन तियाआ लाभोअ कोअते तियाआ देसोअ जागाहा वाटी देय.<verse eid="DAN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="DAN 11:40" />“सेवट्याआ दिहोम मिसर देसोअ राजा लड़ाय कोउ वोले; पोन सिरिया देसोअ राजा पुत्याआ होस जाअखीलां कोड़ाआ गाडे, कोड़ापोअ बोहनारा सेयनिक आन वोडा टोला लेत आवेन ताहरुउ लड़ाय कोए. एहें कोइत तो वारुज देसोमेहें पसरीत जाय, आन तियांमेहें रोत निहींत जाय. <verse eid="DAN 11:40" /><verse number="41" style="v" sid="DAN 11:41" />तो मुख्य देसोमेहें बी आवे, आन वारुज देस उजड़ीत जाय, पोन एदोमी, मोवाबी आन मुख्य मुख्य आम्मोनवाले यां माहुंउं देस तियाआ आथोम रोत वासात जाय. <verse eid="DAN 11:41" /><verse number="42" style="v" sid="DAN 11:42" />तो वारुज देसोंअरी लड़ाय कोए आन मिसर देस बी ने वासाय. <verse eid="DAN 11:42" /><verse number="43" style="v" sid="DAN 11:43" />तो मिसर देसोअ होना-सांदीइ खजानो आन आखी रोमेगोमे एहेली वस्तुउ मालिख बोणीत जाय; आन लुबी कुशोवाले माअहें बी तियाआ ताबाम ओवे वोले. <verse eid="DAN 11:43" /><verse number="44" style="v" sid="DAN 11:44" />तेहेलाम तो उगतामा आन पालामाआं वोल रोत बातमी उनाइत कोइत बित जाय, आन वोडी खोतेए बाल्लायी वारुज जोओंहों आरवीइलाअ कोअते निहींत पोड़े. <verse eid="DAN 11:44" /><verse number="45" style="v" sid="DAN 11:45" />तो बेनु दोर्‍याआ विसमेहें सोका मुख्य डोगोअ जागे तियाआ राज तोंबू उबु कोआड़े; एतोहो कोअताज वाआ तो सेलात जाय, आन कोडो तियाअ मदत ने कोए.”<verse eid="DAN 11:45" /></para>
  <chapter eid="DAN 11" />
  <chapter number="12" style="c" sid="DAN 12" />
  <para style="s">आखरीइ वेल</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1" />“तियी वेले मिखाएल नावोअ वोडू मुख्यू, जो ताआ माअहुंउं वोल उबू रोहे, तो उबू रोय. ताहां एहेलिही ओड़सनीइ वेल रोय, जेहेलोहो यी धरतीपोअ राज्ये बोण्ये तोयोंअ रोत ओमे जाआं केदिहीं नाहां ओवो, आन ने ओवे; तेहेलाम ताआ माअहूंम रोत जेताहा जोंओंअ नावे देवोअ पुस्तकोमेहें लेखाअयेहे, तें वासात जाय. <verse eid="DAN 12:1" /><verse number="2" style="v" sid="DAN 12:2" />जें धरतीइ निसे माहणोमेहें हुवित रोयेहे तियांमेर्‍येए वारुज माअहें जागीत उठे, वार जोएं ते हादाफल्याआ जिवनोअ कोअते उठे, आन वार जोएं ते तियांआं खाराब नावोवाअहीं आन हादाफल्याआ अपमानोअ काजे उठे. <verse eid="DAN 12:2" /><verse number="3" style="v" sid="DAN 12:3" />ताहां समजदार माअहें जुगोअ उजालाआ होस रोय, आन जें वार जोओंहों धर्मी बोणावतेहे, तें हादाफल ताराआ होस उजालावाले रोये.”<verse eid="DAN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 12:4" />“पोन ए दानियेल, तु या पुस्तकोपोअ सिक्कू लागाड़ीत यां वसनोहों दुन्याआं सेवट जाआं गुप्त्यी मिक.<note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="REV 22:11">प्रगटी 22:11</ref></char></note> जाअखीलेहे माअहें होदफुस कोए, आन यावाअहीं ज्ञान बी वादीत जाय.”<verse eid="DAN 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 12:5" />“ओं आखो उनाइत, आंय दानियेल उसे नजर कोइत कि पाल्यो के बेन माटी उबा होय, एक कांय नोयीइ यी मेरे उबु होय, आन बिहीरु नोयीइ तियी मेरे उबू होय. <verse eid="DAN 12:5" /><verse number="6" style="v" sid="DAN 12:6" />ताहां जो माटी पेंडीइ हुतोअ आंगड़े पोवित खाडीइ पाअयोंपोअ ओतू, तियाहा तियांमेर्‍येए एके माट्ये फुशो, ‘यां बोगलाड़नारा कामोअ सेवट कोयों ओवे?’”<verse eid="DAN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 12:7" />“ताहां जो माटी पेंडीइ हुतोअ आंगड़े पोवीत नोयीइ पाअयोंपोअ ओतु, तिये आंय उनाअत्लू तेहेंज तियाआ हाजाड़्यू आन बांगाड़्यू बेनू आथ होरगाआ वोल उसा कोइत, हादाजलम जिवता रोनारा देवोअ शप्पत खात कोइत कोयो, ‘ए दशा साड़े तिन वोरह्ये जाआं एतीज रोय; आन जेहेलाम सोका माअहोंअ सेक्ती कमी कमी ओत सेलात जाय, ताहां ए आखी गोठी पुरी ओवे.’”<verse eid="DAN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 12:8" />“आंय ए गोठी उनाअतुतो खोरु पोन माहूं किज ने समजाअयो. ताहां आंय कोयो: माआं प्रभु, यीं आखी गोठीइ सेवट्योअ फल कि रोय?”<verse eid="DAN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 12:9" />तिये कोयो, “ए दानियेल, तु जातु रो; काहाके ए आखी गोठी आखरीइ दिहोअ काजे गुप्त्यी मिक्यीही, आन यींपोअ सिक्कू लागाड़्युहू. <verse eid="DAN 12:9" /><verse number="10" style="v" sid="DAN 12:10" />वारुज माअहें ते सोताहा सोके आन साफसुफ ओत जाय; पोन पापी माअहें खाराब कामे कोअते रोय; आन तियां पाप्योमेऱ्याआ कोडाहाज ए गोठी ने समजाय; पोन जें समजदार होय तियांहांज समजाय.”<verse eid="DAN 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 12:11" />“जोयोंअ रोत होमबली कोइलाआ बोंद ओवे, आन एठी वस्तुहू तिहीं थापन कोए, तोयोंअ रोत बारा होव नोव्वोद दिही सेकीत जाय. <verse eid="DAN 12:11" /><verse number="12" style="v" sid="DAN 12:12" />जें हिम्मत तोइत कोइत एक हाजार तिन होव पोस्तीस दिही पुरा कोए, तियांआं जाअखो हाजो आवे.”<verse eid="DAN 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 12:13" />“पोन दानियेल, ओमे तु जात कोइत ताआ जिवीइलोअ दोरी ओय ताअहूं जाआं जिवही तिहीं रोत वोडी निंदेम जातु रोही; आन सेवटीपोअ वोडी निंदेम रोत उठही तेहेलाम ताहूं ताआ ठरवीइल्यू वाटू जोड़े.”<verse eid="DAN 12:13" /></para>
  <chapter eid="DAN 12" />
</usx>