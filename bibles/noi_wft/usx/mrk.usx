<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Noiri</book>
  <para style="h">मार्क</para>
  <para style="toc3">मार्क</para>
  <para style="toc2">मार्क</para>
  <para style="toc1">मार्के लेखल्यी हाजी बातमी</para>
  <para style="mt2">मार्काने लिहिलेले शुभवर्तमान</para>
  <para style="mt1">मार्के लेखल्यी हाजी बातमी</para>
  <para style="imt">ओलखात</para>
  <para style="ip">ईसुउ जिवनोअ बाप्तिम कोत आपनारा शार पुस्तकोमेहें रोत एक पुस्तक होय, तों मोन्ज्ये मार्के लेखल्यी हाजी बातमी ओं पुस्तक ईसुउ हाजी बातमी कोत आपेहे. ईसुउ मोत आन जिवीत उठीत होरगाम जाअलोअ फासाड़ी मत्तय, मार्क, लुक आन योहान एं शार हाजी बातमीइं पुस्तके लेखाअयेहे. यां शारु पुस्तकोमेहें रोत मार्के लेखल्यी हाजी बातमी ओं पुस्तक आखाम रोत हानो होय. थोड़ाक जाणकार एहेलोहो मानताहा के मार्के लेखल्यी हाजी बातमी ओं पुस्तक आखाम रोत पेल लेखाअयोहो. बाकी तीनू हाजी बातमीइ पुस्तके ईसुउ जल्माआं 65 ते 70 वोर्ह्योंअ फाटी लेखाअये, आन पुस्तक लेखीइलोअ कारण मोन्ज्ये रोम होयरो मेर्‍यीइ ख्रिस्ती मंडड़ीइ मोनोअ सेक्ती वादाड़ीलोअ आन तियांहां उभारीम लेताविलोअ काजे लेख्यो.</para>
  <para style="ip">ओ मार्क कोडू होय? सेवक पौलुस आन बरनबास यांआं ओ जुवान जोड़ीदार ओतू. योहान, मार्क मोन्ज्ये मार्के लेखल्यी हाजी बातमीइं लेखार्‍यू मार्क याअरी पेहली फेरे जाअलो वेले विसमेहें सोड़ीत जाअलो वाअहीं तियाआ मोनोहो वाईट लागो. प्रेशित <char style="xt"><ref loc="MRK 13:13">13:13</ref></char> तिहींइं फाटी, ओ मार्क बरनबासोअरी सेवकायीमेहें सामिल ओतू. प्रेशित<char style="xt"><ref loc="MRK 15:37-39">15:37-39</ref></char> वसनोंअ पुरमाणे मार्क ओ पेत्राआ आहनेएं हाती ओतू. <char style="xt"><ref loc="1PE 5:13">1 पेत्र 5:13</ref></char> जाणकारोअ एहेलोह मानीइलो होय के जेहेलाम मार्के ईसुउ जिवनोअ सेवकायी आमने सामने नाहां देख्यी, ताहां पेत्राआ साक्शीइ आदारोपोअ तिये तियाआ हाजी बातमी लेख्यी. ए मार्काआ हाजी बातमीइं आधारोअ गोठ होय. मार्के लेखल्‍यी हाजी बातमीइं बेन खास गोठ होय, ते मोन्ज्ये ईसुउ खोरा सेला बोणिइलो आन आखरी ओवनारी गोठीइ बाप्तिम ईसुउ हिकवोण. मार्के लेखल्यी हाजी बातमीमेहें ईसुहू हानालू सेवक आन देव आब्हाआ मेरालू बेटुह्हू यां बेन रुपोमेहें देखाड़्युहू. तेहेंज कोइत मार्के ईसुउ आथोवाअहीं कोअल्‍या वोडा कामोंअ बाप्तिमेहें जाअखाम जाअखो लेख्‍योहो. ओं हाजी बातमीइं पुस्तक ईसुउ सेलाहां आपल्‍या वोडा आदेशो वाअहीं सेलाअहे.</para>
  <para style="iot">रुप-रेशा</para>
  <para style="io1">1. बाप्तिस्मा कोअनारु योहान आन ईसुउ बाप्तिस्मा <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref></char></para>
  <para style="io1">2. ईसुउ आथे गालील मुलखोमेहें ओवले वोडे कामें <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref></char></para>
  <para style="io1">3. येरुसालेमोमेहें जाआं ईसु जात्लू आन मंदिरोमेहें जात्लू <char style="ior"><ref loc="MRK 10:1-12">10:1-12-44</ref></char></para>
  <para style="io1">4. आवनारा दिहोमेहें कि ओवनारो तियाआ बाप्तिमेहें ईसु कोत आपत्लू <char style="ior"><ref loc="MRK 13:1-37">13:1-37</ref></char></para>
  <para style="io1">5. ईसुउ मोत, फाशोअ जिवित उठीइलो आन वोडू आदेश<char style="ior"><ref loc="MRK 14:1-10">14:1-10</ref>; <ref loc="MRK 16:20">16:20</ref> </char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">बाप्तिस्मा कोअनारा योहानोअ परसार</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्तय 3:1-12</ref>; <ref loc="LUK 3:1-18">लुक 3:1-18</ref>; <ref loc="JHN 1:19-28">योहान 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />देवोअ बेटुह्हू<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="MAT 4:3">मत्तय 4:3</ref></char></note> ईसु ख्रिस्ताआ हाजी बातमीइं सुरुवात. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />जेहलोहो यशया भविश्यवक्ताआ पुस्‍तकोम लेख्योहो के,</para>
  <para style="q1" vid="MRK 1:2">“देवे कोयो, ‘आंय माआं खबर्‍याहा ताआ आगाड़ी मोकलिहीं,’</para>
  <para style="q2" vid="MRK 1:2">तो ताआ काजे वाट तियार कोए;<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />रानोमेहें एका आअड़ीनाराआ आवाज होंबलाअहे के,</para>
  <para style="q2" vid="MRK 1:3">‘प्रभुउ वाट तियार कोआ,</para>
  <para style="q2" vid="MRK 1:3">तियाआ सड़क हुदी कोआ.’”<note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यश 40:3</ref></char></note><verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />तियाहा काजे योहान नेवरी जागेहे बाप्तिस्मा आन हिकवोण आपतू जात माअहोंहों परसार कोअयू के, “तुमाआं गुनां रोत सेटे रोवा आन माफीइ कोअते मोन फिराविइलाआ बाप्तिस्मा ल्या, आन देव तुमाआं गुनाआं माफी कोए.”<note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="JHN 1:26">योहान 1:26</ref>,<ref loc="JHN 1:33">33</ref>; <ref loc="ACT 1:5">प्रेशित 1:5</ref>,<ref loc="ACT 1:22">22</ref></char></note> <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />आखा यहुदीया मुलखो मेर्‍येए आन येरुसालेम सेहरो मेहें रोनारे निहींत आखे तियाआ जागे गोये, आन सोताआ गुनाआं कबुली कोइत यारदेन खाडी मेहें तियाआ आथे बाप्तिस्मा लेदो.<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />योहान उटड़ाअ रुंगहाअ आंगड़े पेवित आन कंबरेमेहें सांबड़ाआ पोट्टू बांदीत रोतुतो आन टिड्ये आन मोद खातुतो, <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />आन एहेलुहू परसार कोअतुतो, “माआं फासाड़ी जो आवनारु होय, तो माआं रोत वादार सेक्तीवालू होय; आंय तोम टुंगू पोड़ीत तियाआ बुटोअ दोअड़ी सोडीइलोअ बी लायक कायनाहां. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />आंय तोम तुमुहूं पाअयों वाअहीं बाप्तिस्मा आपोहो, पोन तो तुमुहूं पवित्र आत्मा वाअहीं बाप्तिस्मा आपे.”<verse eid="MRK 1:8" /></para>
  <para style="s">ईसुउ बाप्तिस्मा आन पारजाणो</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">मत्तय 3:13—4:11</ref>; <ref loc="LUK 3:21">लुक 3:21</ref>,<ref loc="LUK 3:22">22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />तियां दिहोमेहें ईसु नासरेथ रोत गालील मुलखोमेहें आयू, आन यारदेन खाडीम योहानोअ आथे बाप्तिस्मा लेदो. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />ईसु पांअयोंम रोत उसे आवत्लू, तेहेलाम होरगो उगड़ीइल्यो आन पवित्र आत्मा तिया पोअ पेरवाआ होस उतरीइत्लूज तियाहा देखाअयू. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />आन होरगाम रोत एक आवाज आयू के, “तू माआं मेरालू बेटुह्हू होय, आंय ताआ वाखरी खुस होये.”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />ताहां पवित्र आत्मा तुरतूज ईसुहू नेवरी जागेहे लेत गोयू, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />रानोमेहें तियाहा सालिही दिही जाआं सैताने पारजाणीत पाल्‍यू; तिहीं रानोमेर्‍येए जनवारे बी ओते, पोन देवदुत तियाआ सेवा कोअताते.<verse eid="MRK 1:13" /></para>
  <para style="s">शार मासाराहां ईसु हादत्लू</para>
  <para style="r">(<ref loc="MAT 4:12-17">मत्तय 4:12-17</ref>; <ref loc="LUK 4:14">लुक 4:14</ref>,<ref loc="LUK 4:15">15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />योहान तोआयू तोयोंअ रोते ईसु गालील मुलखोमेहें आवित देवोअ राजोअ हाजी बातमीइं परसार कोउ वोल्‍यू. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />आन कोयो, “खोरी वेल आवित लागीही, देवोअ राज आहने आवित लागोहो, पापोअहें रोत फिरा आन हाजी बातमी पोअ भरिवसू मिका!”<note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">मत्तय 3:2</ref></char></note><verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />ईसु जेहेलाम गालीलोअ दोर्‍याअ मेरे जात्लू तेहेलाम तिये शिमोन आन तियाआ पाही आंद्रिया याहां दोर्‍यामेहें जाल टाकत्ला देख्‍या, काहाके ते मासारा ओता. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />ईसु तियांहां कोयो, “माआं फासाड़ी आवा, आंय तुमुहूं माअहोंहों देवोअ राजोम लेतावनारा बोणाविहीं.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />तेताजमेहें ते जाल सोड़ीत तियाअरी गोया.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />तो तिहीं रोत जारिक आगाड़ी गोयू, ताहां तियाहा बेन पाही देखाअया ते जब्दीइ बेटाह्हा याकोब आन योहान ओता. ते तियांआं नावड़ापोअ जाल हुदारताते. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />तिये तियांहां लगेज हाद्या, आन तियांआं आब्हा जब्दीही आन तियाआ मोजर्‍याहां नावड़ाम सोड़ीत तियाआ फासाड़ी गोया.<verse eid="MRK 1:20" /></para>
  <para style="s">एक पुत लागलो माहुंउं</para>
  <para style="r">(<ref loc="LUK 4:31-37">लुक 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />ताहां ईसु आन तियाआ सेला कफर्णहुम होयरोम आया, आन आगल्‍याआ आरामोअ दिही यहुदीइ आराधनालयोमेहें<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">यहुदीइ पोन्सू टोलू वोलिइलाअ एक आखा गांवलांअ कोअ</char></note> जात कोइत सिकाडू वोल्‍यू.<note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="MAT 4:23">मत्तय 4:23</ref>; <ref loc="MRK 10:1">मार्क 10:1</ref></char></note> <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />आन तें माअहें तो जे हिकवोण आपतुतो तियीं हिकवोणो वाअहीं बोगलाइत गोये; काहाके तो तियांहां कायदाअ मास्तरहोंअ होस नाहां पोन आधिकार लेत कोइत जेहें सिकाड़तुतो.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />तेहेलाजमेहें, तियांआं आराधनालयोमेहें एक माहुंउं ओतो, जिया मेहें एक खाराब आत्मा ओती. <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />तिये आअड़ीत कोइत कोयो, “ए ईसु नासरेथवाला, तू आमाआं विसमेहें काहा पोडेहे? तू आमुहूं आरवीत टाकू आवयुहू के? तू कोडू होय तो माहूं मुंदू होय, तूज तोम देवोअ पवित्र संदेश लेतावनारु होय!”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />पोन ईसु तियाहा बावरात कोयो, “ठावको रो, आन या माट्योमेहें रोत निहीं!”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />ताहरीइ ते खाराब आत्मा तियाहा पिल्लित कोइत आन जोरेज आअड़ीत कोइत तिया मेहें रोत निहींत गोयी. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />आन तिहीं ओते तें आखे माअहें एकान बिहीराहा फुसे वोल्ये, “ओं एहेलोह कि होय? ए काविंहीं नविल हिकवोण होय के? या माअहूं पोअ खाराब आत्मा काडीइलोअ आधिकार होय, आन तें याअ गोठी मानतेहे!”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />आन ईसुउ बाप्तिमेर्‍यीइ ए बातमी ताबुड़तुड़ गालील मुलखोअ आखा भागोमेहें पसरीत गोयी.<verse eid="MRK 1:28" /></para>
  <para style="s">ईसु वारुज माअहुंहूं हुदारत्लू</para>
  <para style="r">(<ref loc="MAT 8:14-17">मत्तय 8:14-17</ref>; <ref loc="LUK 4:38-41">लुक 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />ईसु आन तियाआ सेला आराधनालयोअहीं रोत जाता रोया, आन लगेज तो योहान आन याकोबोअरी शिमोन आन आंद्रिया यांआं कोअ गोयू. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />शिमोनोअ हावेह्हे जोरु सोडल्यू काजे खाटलाम लोटीत रोयीते. ताहां तियां ताबुड़तुड़ ईसुहू तियीइ बाप्तिम कोयो. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />ताहां तिये आहने जात कोइत तियीही आथे तोइत उठाड़्यी, आन तियीइ जोरु उतरीत गोयू आन ते तियांआं सेवा कोइ वोल्‍यी.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />दिही बुटताअरिही मोन्ज्ये हांजे पोअ माअहें आखी जातीइ मांदवाड़्या माअहोंहों आन पुतवाअलांहां ईसुउ जागे लेतावये. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />होयरोअ आखे माअहें बाओअ हुंबर टोलू वोलीत उबे रोये. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />तिये जे बातीवानीइं मांदवाड़्ये ओते तियांहां हुदार्‍ये आन खुब माअहूंमेहें रोत पुते काड्ये. पोन तिये पुतोहों ने गोगुहूं देदे, काहाके तें तियाहा ओलखीइतेते.<verse eid="MRK 1:34" /></para>
  <para style="s">गालीलोमेहें ईसुउ बाशण</para>
  <para style="r">(<ref loc="LUK 4:42-44">लुक 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />ताहां ईसु वेगर्‍यूउ सिंजिवड़ेए उठीत कोइत कोअमेहें रोत निहींत बारथे हुंद्ला जागामेहें गोयू आन तिहीं तिये प्रार्थना कोअयी. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />पोन शिमोन आन तियाअरीइ हेंगात ईसुहू होदा निहींया, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />आन जेहेलाम ते तियाहा मिल्‍या, ताहां तियाहा कोयो, “आखा ताहूं होद्या कोअताहा.”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />पोन ईसु तियांहां कोयो, “साला, आपुहूं आहनेएं गांवोंम बी जावाअहूं जोवे, काहाके तिहीं बी आंय परसार कोइत सेको, आन आंय तियाहाज काजे आयुहू.”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />ताहां तो पुरा गालील सेरोमेहें तियांआं आराधनालयो मेहें परसार कोअतू आन पुते काडतू फिर्‍यू.<verse eid="MRK 1:39" /></para>
  <para style="s">ईसु वोडा दुखोवाला माहुंहूं हुदारत्लू</para>
  <para style="r">(<ref loc="MAT 8:1-4">मत्तय 8:1-4</ref>; <ref loc="LUK 5:12-16">लुक 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />एक वोडा दुखोअ माहुंउं ईसुउ जागे आवयो, आन तियाआ हुंबर मांड्या पोड़ीत वोंदतो जात रावण्या कोओ वोल्‍यो. तों ईसुहू कोनो वोल्‍यो, “जर ताआ इश्शा ओय ताहां तू माहूं सोकू कोइत सेकेहे.”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />ईसुहू दया आयी, आन तिये आथ आगाड़ी कोइत तिया पोअ मेक्‍यू आन कोयो, “माआं इश्शा होय के तू सोकू ओव!” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />आन तेताज मेहें तियाआ वोडो दुख तियाहा सोड़ीत जातो रोयो आन तों सोको ओत गोयो. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />ताहरुउ ईसु तियाहा कड़क शब्दा मेहें सेतावणी आप्‍यी आन वेगुज जातु रोयतेहें कोयो, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />आन एहें कोयो, “पाल, याअ बाप्तिम कोडाहा कीज मा कोही, पोन जात कोइत तापासेतेहें काजे पुंजाराहा देखाड़; तिहीं रोत सोको ओवीइलोअ पुरावाआ काजे मोशे कोयोहो तिया नियमोंअ पुरमाणे बाधा सुटजी.”<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />पोन तो तिहीं रोत गोयू, आन ते बातमी एतीही जाआं वेर्‍यी के ईसु खुल्लाम खुल्लू होयरोम जात ने सेक्यू. तियाहा कोत तो बारथे रानोंज मेहें रोयू आन शारी वोलेहे रोत माअहें तियाआ जागे आवयाज कोअतेते.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">ईसु एका लखवाआ मांदवाड़्याहा हुदारत्लू</para>
  <para style="r">(<ref loc="MAT 9:1-8">मत्तय 9:1-8</ref>; <ref loc="LUK 5:17-26">लुक 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />थोड़ाक दिहोअ फासाड़ी ईसु फाशुउ कफर्णहुम गांवोंम गोयू, आन तो कोअ होय एहेलिही खबर आखी जागे पसरीत गोयी. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />ताहां एतेहे माअहें टोलू वोल्‍ये के बाओअ जागे बी जागू ने उगर्‍यू. आन ईसु तियांहां सिकाड़तुतो. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />तेहेलाम शार माटी तिया लखवाअ मांदवाड़्याहा उसलीत ईसुउ जागे लेत आवया. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />पोन गर्दी ओती तिहीं वाअहीं तिया मांदवाड़्याहा ने लेत जात सेक्‍या. ताहां ते तो ओतू तिहींइं कोओ पोर्‍येए नाल्ल्ये फेड़ी देदे आन जिया खाट्लापोअ तो ओतू तिया खाटलाहा ते कोओपोअ रोत निसे उतरीत सेके एहेलोह गालो कोअयो आन तिहीं तिया मादवाड़्याहा उतार्‍यो. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />तियांआं विश्वास देखीत कोइत ईसु लखवाअ मांदवाड़्या माहुंहूं कोयो, “माआं सोआ, ताआ गुनाआं माफी ओवीही.”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />तिहीं थोड़ाक कायदाअ मास्तरहों बोहीत रोयाते. ते तियांआं मोनोमेहें विसार कोआ वोल्‍या के, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“ये एहें कोअलोअ केहें कोइत हिम्मत कोअयी? ए निंदा होय! देवुज गुनाआं माफी आपित सेकेहे!”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />पोन ईसु तेताजमेहें आत्मामेहें समजीत लेदो के, तें तियां-तियांज विसार कोअताहा, ताहां तिये तियांहां कोयो, “तुमू मोनोम एहेलाहा विसार काहा कोअताहा? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />या लखवा लागला माहुंहूं ‘ताआ गुनाआं माफी ओवी’ एहें कोअलोअ सोपो के ‘ऊठ, ताआ आथरुउ विस आन सालु वोल’ एहें कोअलोअ सोपो? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />पोन जिया वाअहीं तुमू जाईंत लेअहूं जोवे के, माहुंउं बेटाह्हाहा धरती पोअ गुनाआं माफी कोइलोअ आधिकार होय.” ताहां तो तिया लखवा लागला माहुंहूं कोयो, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“आंय ताहूं कोहो, उठ, ताआ खाट्लो विस आन कोअ जा!”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />तियां आखा माअहोंअ देखताइज तो मांदवाड़्यु उठ्यू, तियाआ आथरुउ विसीत लेदो आन जानु वोल्यू. ओं देखीत आखे माअहें बोगलाइत गोये आन देवोअ स्तुती कोअते जात कोतेहे, “आमू एहेलोह केधिहींज नाहां देख्यो!”<verse eid="MRK 2:12" /></para>
  <para style="s">ईसु लेविही हादत्लू</para>
  <para style="r">(<ref loc="MAT 9:9-13">मत्तय 9:9-13</ref>; <ref loc="LUK 5:27-32">लुक 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />ईसु निहीत कोइत गालीलोअ तालावोअ मेरे गोयू, आन एक गोवारु माअहें तियाआ जागे आये, आन तो तियांहां सिकाड़ु वोल्‍यू, <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />तिहीं रोत तो जात्लू तेहेलामेहें हल्फीइ बेटुह्हू लेवीही नाकापोअ बोहीत रोल्‍यू देख्यू. ताहां ईसु लेविही कोयो, “माआं फासाड़ी आव,” ताहरुउ तो उठ्यू आन ईसुउ फासाड़ी गोयू.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />जेहेलाम ईसु लेविइ कोअ रोटू खानू बोठू. तिहीं वारुज जोओं फालू लेनारा आन पापी बी ईसु आन तियाआ सेलांअरी रोटू खाना बोठा; काहाके ते जाअखा जोओं ओता आन तियाआ फासाड़ी आवयाते. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />तेहेलाम थोड़ाक कायदाअ मास्तरहों जे फरिसी होय, ईसुहू पापी आन फालू लेनाराअरी बोहीत कोइत रोटू खात्लू देख्यू. ते तियाआ सेलाहां कोयो, “ओ यां माअहोंअरी रोटू काहा बोहीत कोइत खाहे?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />एहेलोह उनाइत कोइत ईसु तियांहां कोयो, “नेरा माअहोंहों डाक्‍टरोअ गरज ने रोत्ली, पोन मांदवाड़्याहां रोत्ली. आंय धर्मी माअहोंअ काजे नाहां, पोन पाप्योंहों हादीइलोअ काजे आवयुहू.”<verse eid="MRK 2:17" /></para>
  <para style="s">उपासोअ बाप्तिम प्रश्न</para>
  <para style="r">(<ref loc="MAT 9:14-17">मत्तय 9:14-17</ref>; <ref loc="LUK 5:33-39">लुक 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />बाप्तिस्मा कोअनारा योहानोअ सेला आन कायदाअ मास्तरहों जे फरिसी उपास कोअताते; ताहां थोड़ाक जोओं ईसुउ जागे आवित कोइत तियाहा कोयो, “योहानोअ सेला आन फरिसी उपास कोअताहा, पोन ताआ सेला काहा उपास नाहां कोअता?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />ईसु तियांहां कोयो, “जाअहूं जाआं वर जानेएरी वेहेवालोअ मांडवोअ थुड़ी होय, ताअहूं जाआं तें उपास कोइत सेकतेहे के? ताहां जाअहूं जाआं वर आरी होय ताअहूं जाआं तें उपास ने कोइत सेकनारे. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />पोन एहेलाहा दिही आवे के वर तियांअरी रोत उसे विसाइत जाय; ताहां तें उपास कोए.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“कोडो बी नोवा आंगड़ाआ सिवरो जुना आंगड़ाहा नाहां लागड़तो, जर तेहें कोअयो ताहां नोवो सिवरो जुना आंगड़ाहा फाडीत कोइत वोडू डुसू पाड़ीत टाके. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />नोवू दाराक्शाआ रोह जुना सांबड़ाआ खोत्लामेहें कोडोज ने मेकत्लो, नेत तो दाराक्शाआ रोह तियाहा फाडीत टाकी देय आन दाराक्शाआ रोह आन सांबड़ाआ खोत्लू बेनू आरवात जाय; पोन नोवू दाराक्शाआ रोह नोवा सांबड़ाआ खोत्ला मेहें पोअत्ले.” <figure style="fig" alt="Wineskin bag" file="LB00145C.TIF" size="col" copy="Horace Knowles ©" ref="2:22">दाराक्शाआ रोह मिकीइलोअ सांबड़ाआ खोत्लू</figure><verse eid="MRK 2:22" /></para>
  <para style="s">आरामोअ बाप्तिमेहें प्रश्न</para>
  <para style="r">(<ref loc="MAT 12:1-8">मत्तय 12:1-8</ref>; <ref loc="LUK 6:1-5">लुक 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />एहेलोह ओयो के ईसु आरामोअ दिही गोवोंअ खेतो मेहें ओवतुज जातुतो, आन तियाआ सेला सालता जात गोवोंअ सोंवें तोड़ा वोल्‍या.<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="DEU 23:25">कायदा 23:25</ref></char></note> <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />ताहां कायदाआ मास्तरहों जे फरिसी ईसुहू कोना वोल्‍या, “पाल, आरामोअ दिही ताआ सेला कोअताहा ओं काम आपाअ कायदाआ विरुद्दाम होय!”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />ईसु तियांहां कोयो, “जेहेलामेहें दाविद आन तियाआ हात्योहों गरज पोड्‍यी आन फुक लागी ताहां तिये कि कोअयो तों तुमू नाहां वाश्यो? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />अबियाथार डायु पुंजारु ओतू ताहां तो देवोअ कोअमेहें केहें कोइत गोयू आन देवोहो होपल्यू रोटू कायदाआ इसाबो वाअहीं पुंजाराआ सिवाय कोडोज ने खाअहूं जोवे, तो रोटू तिये केहें कोइत खादू आन तियाआ हात्योहों बी आप्यू?”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />ईसु तियांहां कोयो, “आरामोअ दिही माअहोंअ काजे बोणावयुहू, माहुंउं आरामोअ दिहोअ काजे नाहां. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />तियाहा काजे माहुंउं बेटुह्हू आरामोअ दिहोअ बी प्रभु होय.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">उगाअला आथोवालो माहुंउं</para>
  <para style="r">(<ref loc="MAT 12:9-14">मत्तय 12:9-14</ref>; <ref loc="LUK 6:6-11">लुक 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />ईसु फाशुउ आराधनालयोमेहें गोयू, तिहीं एक माहुंउं ओतो जियाआ आथ लखवाअ बिमारी वाअहीं उगात गोयुतो. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />थोड़हा तियापोअ आरोप लागाड़ीइलोअ कोअते तो आरामोअ दिही तियाहा हुदारेहे के नाहां तों पालीइलोअ काजे निकाइत बोठाते. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />ईसु तिया उगाअला आथोवाला माहुंहूं कोयो, “इंहीं आखाआ सामने उबू रो.” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />आन तिये तियांहां कोयो, “आरामोअ दिहोअ दिही कायदाआ पुरमाणे हाजो कोइलोअ ठीक होय के, बाक्तो कोइलो? जिव वासाडीलोअ के माइलोअ ठीक होय? पोन ते ठावकाज रोया.”<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />ताहां ईसु तियांआं कठीण मोनोअ वाखरी दुखी ओत कोइत तियांहां खिजवाअली नजरे वाअहीं सारी सोमकीर पाल्यो, आन तिया माहुंहूं कोयो, “ताआ आथ नांबू कोअ.” तिये आथ नांबू कोअयू, आन तियाआ आथ पेल्लूउ ओतु तेहेलुज हुदरीत गोयू. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />ताहां कायदाअ मास्तरहों जे फरिसी बारथे जात कोइत ईसुउ विरुध्दाम हेरोदोअ पार्ठीइ माअहोंहों जात मिल्या आन तियाहा कि कोइत आरवीइलोअ ते कदर काडा वोल्या.<verse eid="MRK 3:6" /></para>
  <para style="s">तालावोअ मेरे गर्दी</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />ईसु तियाआ सेलांअरी तालावोअ जागे गोयू, आन गालील आन यहुदीयाअ मुलखो मेहें रोत एक वोडी गर्दी तियाआ फासाड़ी आवयी, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />येरुसालेम रोत इदुमिया भाग, यारदेन खाडीइ तियी वोलेहे रोत, आन सुर आन सिदोनोअ आहने-पाहनेवाला भागोम रोत ईसु वोडे वोडे कामे कोअत्लू पो एहेलोह उनाइत कोइत आवये. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />गोरदी वाअहीं दाबाअहूं ने जोवे काजे तियाआ सेलाहां नावड़ो तियार मिके तेहें कोयो. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />काहाके तिये जाअखीलाहा माअहोंहों हुदार्‍येते, तियाहा काजे जेते बी रोगो वाले माअहें ओते तें तियाहा आथ लागाड़ीइलो कोअते तियापोअ आवित ठेपलाअतेते. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />खाराब आत्में बी जेहेलाम तियाहा देखतेते, ताहां तियाआ सामने आवित पोड़तेते, आन किगलीत कोइत कोतेते के “तू देवोअ बेटुह्हू होय!”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />पोन ईसु तियां खाराब आत्माहां तो कोडू होय तो कोडाहाज ने कोअहूं जोवे तियाहा काजे कड़क आदेश आप्यू.<verse eid="MRK 3:12" /></para>
  <para style="s">ईसुउ बारा सेलाहां निवड़ीइलोअ</para>
  <para style="r">(<ref loc="MAT 10:1-4">मत्तय 10:1-4</ref>; <ref loc="LUK 6:12-16">लुक 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />ताहरुउ ईसु डोगो पोअ सोड़्यू आन तियाहा जोवताते एहेलाहा जे सेला ओता, तियांहां तिये तियाआ जागे हाद्या आन ते तियाआ जागे आवया. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />ताहां तिये बारा जोओंहों निवड़्या, तिये तियांहां प्रेशित एहें कोत नाव आप्यो, “आंय तुमुहूं एताआ काजे निवड़्याहा के तुमू माअरी रोअहूं जोवे, आन आंय तुमुहूं बिहीरी जागे परसार कोए तेहें काजे मोकलीत सेको, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />आन तुमापोअ पुते काडीइलोअ आधिकार रोअहूं जोवे.”<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />ए बारा सेला तिये निवड़्या: ईसु शिमोन याअ नाव पेत्र मिक्यो. <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />जब्दीइ बेटाह्हा याकोब आन तियाआ पाही योहान, ईसु तियांआं नाव बोआनर्गेस मिक्यो मोन्ज्ये गाजनाराअ पोर्‍या एहेलोह तियाआ अर्थ बोणेहे. <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />आंद्रिया, फिलीप, बार्थलमय, मत्तय, थोमा, आल्फेयोअ बेटुह्हू याकोब, तद्दय, शिमोन कनानी, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />आन ईसुहू तोइत आपनारु यहुदा इस्कार्योत.<verse eid="MRK 3:19" /></para>
  <para style="s">ईसु आन बालजाबुल</para>
  <para style="r">(<ref loc="MAT 12:22-32">मत्तय 12:22-32</ref>; <ref loc="LUK 11:14-23">लुक 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />ताहां ईसु कोअ आयू. फाश्यीइ बी तेहेलीज गर्दी टोलू वोल्यी आन तियांहां रोटू खाअलोअ बी वेल ने जोड़्यी. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />तियाआ कुटूंबामेएं माअहें याअ बाप्तिम उनाअये ताहां, तियाहा तोइत आने गोये, काहाके माअहें तियाआ नाव पाड़तेते के, “ओ गांडू बोणीत गोयुहू!”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />येरुसालेम रोत आवनारा थोड़ाक कायदाअ मास्तर कोताते के, “यामेहें बालजाबुल<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="fq" closed="false">बालजाबुल </char><char style="ft" closed="false">पुतोंअ आधिकारी</char></note> होय! आन तिया पुतोअ आधिकार्‍योअ आधारो वाअहीं ओ पुते काड्त्लू.”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />ताहां तियांहां आहने हादीत कोइत काईंइं आधारो वाअहीं कोनु वोल्‍यू: “सैतान सैतानोहोंज केहें कोइत काडीत सेकेहे? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />जर तिया-तियाआज राजो मेहें भाग पोड़ीत जाय ताहां तो राज नाहां टिकीत सेकतो. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />एखा कुटुंबामेहें सुलाईत कोइत बेन भाग पोड़ीत गोयाय तो कोअ बी ने टिकीत सेकत्लो. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />तियाहा काजे जर सैतान सोताआज विरुद्ध कोउ वोले ताहां तो नाहां टिकीत सेकतु, नेत तियाआ ते आखरी ओत जाय.”<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />“जाअहूं जाआं तिया ताकतवान माट्योहो ने बांदे, ताअहूं जाआं तियाआ कोअमेर्‍युउ माल लुटीत ने सेकाय, पेल तिया ताकतवान माट्‍योहो बांदुहूं जोवे ताहांज तियाआ कोओहो लुटीत सेकाय. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />आंय तुमुहूं खोरीज कोहो के, माअहोंअ गुनाआं आन तियां कोअल्‍यी देवोअ निंदाआ माफी ओत जाय. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />पोन जो कोडो पवित्र आत्माआं विरुद्दाम निंदा कोए तियाहा केदिहींज माफी ने जोड़े आन तो हादाजल्म्योंअ गुनाआं दोशी ठरे.” <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />ईसु एहें कोयो काहाके, थोड़हे माअहें कोतेते के, “यामेहें खाराब आत्मा होय.”<verse eid="MRK 3:30" /></para>
  <para style="s">ईसुउ आयही आन पाही</para>
  <para style="r">(<ref loc="MAT 12:46-50">मत्तय 12:46-50</ref>; <ref loc="LUK 8:19-21">लुक 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />ताहां ईसुउ आयहीन पाहीनेहें आये, आन बारथे उबे रोत कोइत तियाहा हादू मोकल्‍यू. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />ईसुउ मेरे-मेरे माअहुंउं गर्दी बोहीत रोयीते, आन तियां तियाहा कोयो, “ताआ आयहीन ताआ पाव्हीइले नेहें ताहूं बारथे वाट जोवेतेहे.”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />तिये उत्तर आप्यो, “माआं आयही आन माआं पाव्हीइले कोडे होय?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />ताहां तो तियाआ मेरे-मेरे बोठ्ला माअहोंअहें पालीत कोइत कोयो, “पाला, माआं आयहीन माआं पाव्हीइले एंएं होय! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />जें कोडे देवोअ इश्शाआ परमाणे सालतेय, तेंज माआं पाव्हीइले आन आयही होय.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">बियारु पेएनाराआ काईं</para>
  <para style="r">(<ref loc="MAT 13:1-9">मत्तय 13:1-9</ref>; <ref loc="LUK 8:4-8">लुक 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />ईसु फाशुउ गालील तालावोअ मेरे सिकाडू वोल्यू. आन एतीही गर्दी तियाआ जागे टोलू वोल्‍यी के तो तालावोमेहें एका नावड़ा मेहें बोहीत गोयू, आन आखी गर्दी तालावोअ मेरे उबी रोयी. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />तो काईं वाअहीं जाअखीलिही गोठी सिकाडू वोल्‍यू आन एहें कोत कोयो,<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />“कान द्या! एक पेएनारो बियारु पेओ निहींयो. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />आन पेएत्लो तेहेलाम थोडहू बियारु वाटेपोअ पोड्‍यू, आन तो सिड़ा विसीत खात लेदू. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />थोडहू बियारु खरबाल जागा मेहें पोड्‍यू, तिहीं जाअखु कादुव ने जोड़्यू तिहीं वाअहीं उतवाल उगो. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />पोन दिही उग्यू तेहेलाम तोपो वाअहीं कोमात गोयो, आन मुले ने काल्‍ये तिहीं वाअहीं उगाईत गोयो. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />थोडहू बियारु काटाआ साटवा मेहें पोड्‍यू तिहीं वाअहीं तें, काटाआ साटवेज उसे वादीत गोये आन ओनोहों दाबी देदो ताहरोअ तिया ओनोहों फल ने आयो. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />थोडहू बियारु हाजा कादवूम पोड्‍यू तो उगू, आन वोडो ओवित पाको; थोडहो तीस भाग, थोडहो साट भाग, थोडहो हौ भाग पाको.”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />ईसु कोयो, “जिया पोअ उनाइलोअ कान ओय, तो उनाआ!”<verse eid="MRK 4:9" /></para>
  <para style="s">काईं कोअलोअ उद्देश</para>
  <para style="r">(<ref loc="MAT 13:10-17">मत्तय 13:10-17</ref>; <ref loc="LUK 8:9">लुक 8:9</ref>,<ref loc="LUK 8:10">10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />ईसु एखलुज ओतू ताहां तिहीं उनाअनारा मेर्‍याआ थोड़ाक जोओं बारा सेलाअरी लागीत तियाआ जागे आवया आन काईंइं बाप्तिम फुशो. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />तिये तियांहां कोयो, “तुमुहूं देवोअ राजोअ दोड़पाअली गोठी समजीइलोअ समज मिल्‍यीही, पोन बारथेवालांअ कोअते आखी गोठी काईं मेहें कोवाअत्ली, <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />एताआ काजे के,</para>
  <para style="q1" vid="MRK 4:12">“‘तें देख्याज कोअतेहे, देखुहूं जोवे,</para>
  <para style="q2" vid="MRK 4:12">आन तियांहां नाहां देखाअतो;</para>
  <para style="q1" vid="MRK 4:12">तें उनाअयाज कोअतेहे, उनाअहूं जोवे,</para>
  <para style="q2" vid="MRK 4:12">आन तियांहां नाहां समजाअतो.</para>
  <para style="q1" vid="MRK 4:12">केहेंनेत तें देवोअ वोलेहे फिरते</para>
  <para style="q2" vid="MRK 4:12">ताहां देव तियांहां माफ कोअतू.’”<verse eid="MRK 4:12" /></para>
  <para style="s">ईसु बियारु पेएनाराआ काईं फोड़ कोइत कोत आपत्लू</para>
  <para style="r">(<ref loc="MAT 13:18-23">मत्तय 13:18-23</ref>; <ref loc="LUK 8:11-15">लुक 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />ताहां ईसु तियांहां कोयो, “केहें ए काईं तुमुहूं नाहां समजाअयी के? ताहां बाकी बिहीरी तुमू केहें कोइत समजाहा? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />पेएनारो वसन पेएहे. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />वाटेपोअ वसन पेएयो, तें एहेलेहे माअहें होय, जें वसन उनाअत्ले, ताहां सैतान आवित कोइत ताबुड़ विसीत लेत जातु रोत्लू. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />तेहलोज खरबाल जागा मेहें पेआअले तें एहेलेहे माअहें होय, जें वसन उनाअताज वाआ खुसी वाअहीं मानित लेत्ले; <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />पोन तियां सोतामेहें मुले ने तोअये तिहीं वाअहीं थोड़ाज दिही टिकाव तोअत्ले, तिहींइं फासाड़ी वसनोअ वाखरी अड़सन नेताहां सताव आवत्लू ताहां तें ताबुड़ सोड़ीत जाते रोत्ले. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />काटाआ साटवामेहें पेआअले तें एहेलेहे माअहें होय जें वसन उनाइत लेतेहे, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />पोन दुन्यादारीइ सिंता, पोशाअ धोकू, आन बिहीरी वारुज वस्तुउ लोभ तियांमेहें फोहीत कोइत वसनोहों दाबी देतेहे, आन तों फल नाहां फलतो. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />पोन हाजा कादवाला जागामेहें पेएल्यो तें एहेलाहा माअहोंअ होस होये, जें वसन उनाइत कोइत तो मानित लेतेहे, आन तीस भाग, साट भाग आन हौ भाग फल आपतेहे.”<verse eid="MRK 4:20" /></para>
  <para style="s">टोपलीइ थुड़ी दिवू</para>
  <para style="r">(<ref loc="LUK 8:16-18">लुक 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />फाशुउ ईसु तियाहा कोयो, “दिवू पेटाड़ीत टोपलाआ नेत खाट्लाआ निसे मेकीइलोअ काजे लेतावत्ले के? बेलकाअ उसे मेकीइलोअ काजे लेतावत्ले ना? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />जो किबी टापाअलो ओय तो उगड़ीत जाय आन हारेक निकाअली गोठी देखात जाय. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />जियाहा उनाइलोअ कान होय तो उनाइत लेवा!”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />फाशुउ तिये तियांहां कोयो, “तुमू जे गोठी उनाअताहा तियाआ बाप्तिमेहें सांबालित रोवा! जिया मापोवाअहीं तुमू मापित आपहा तियाज मापोवाअहीं तुमुहूं बी मापित जोड़े. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />काहाके जियापोअ होय तियाहा फाशोअ जोड़े पोन जियापोअ कायनाहां तियाहा तियापोअ जो ओय तों बी बुउसीत लेवाय.”<verse eid="MRK 4:25" /></para>
  <para style="s">उगनारा बीजोअ काईं</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />फाशुउ ईसु कोयो, “देवोअ राज याअ होस होय, एक माहुंउं खेतोम बियारु पेई देहे. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />आन राती हुवीत जाहे आन दिहे जागित उठेहे, आन तों बीज केहें कोइत उगेहे आन पोहाअहे, ओं तियाहा नाहां मुंदू जातू. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />धरती तियी तियीइज फल आपेहे, पेल डिरा फुटताहा, तिहीं रोत सोंवें निहींतेहे, आन सोवोंमेहें मोटा दाणा. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />पोन जेहेलामेहें ओन पाकीत जाहे, ताहां तो माहुंउं दात्ला वाअहीं वाडेहे, काहाके वाडीइलोअ वेल आवित लागीही.”<verse eid="MRK 4:29" /></para>
  <para style="s">रायीइ दाणाअ काईं</para>
  <para style="r">(<ref loc="MAT 13:31">मत्तय 13:31</ref>,<ref loc="MAT 13:32">32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18">लुक 13:18</ref>,<ref loc="LUK 13:19">19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />ईसु कोयो, “आपू देवोअ राजोहो किहाआ होस समजुहूं, किहाआ काईं पाड़ीत कोत आपहूं? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />तो रायीइ दाणाअ होस होय. तियाहा ओइलो वेले पुंयी पोर्‍याअ आखा दाणा रोत हानू दाणू रोहे. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />पोन वोडो ओवेहे तेहेलाम आखा पाजा पालाआ साड़ोम रोत वोडो पोहाअहे. तों एतोहो वोडो ओत जाहे के जुगोमेर्‍येए सिड़े तियाआ डालीपोअ पांजरु बोणावीत सेकतेहे.”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />ईसु एहेलिही वारुज काईं पाड़ी पाड़ीइ तियांहां समजाय एहेलिही पद्धती वाअहीं संदेश कोत आपतुतो. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />तो बिगर काईं कोया वासी कोड्लीज गोठ ने कोतुतो. पोन एखलामेहें तो तियाआ सेलाहां समजाड़ीत कोतुतो.<verse eid="MRK 4:34" /></para>
  <para style="s">ईसु वादुउ बंद कोअत्लू</para>
  <para style="r">(<ref loc="MAT 8:23-27">मत्तय 8:23-27</ref>; <ref loc="LUK 8:22-25">लुक 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />तेदिहींज हांजेपोअ ईसु तियाआ सेलाहां कोयो, “साला, आपू दोर्‍याअ तियी मेरे जात्ला.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />ताहां तियी गोरदीही सोड़ीत देत तो जेहलुहू ओतू तेहलुज ते हिद्लाआ नावड़ामेहें तियाहा लेताज गोया; आन तियांअरी बिहीरे बी नावड़े ओते. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />तेताजमेहें वोडू वादुउ आयू, आन सेलकाआ नावड़ापोअ एताहा जाआं ठोकाआ वोल्या के, तिया नावड़ामेहें पाईं पोआओ वोल्‍यो. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />पोन ईसु नावड़ामेहें फासाड़ीइ वोलेहे उहुट्यापोअ मुंड मिकीत हुवया कोअतुतो. तेहेलाम सेला तियाहा जागाड़ीत कोइत कोयो, “गुरु, आपू मोअहूं कोअताहा तेबी ताहूं कायनाहां विसार आवतू के?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />ताहां ईसु उठीत कोइत वाराहा आदेश आप्यू “ठावको ओत जा!” आन पाअयोंहो कोयो, “रुकात जा!” आन वादुउ बोंद ओत गोयू आन एकदम होक आयू. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />ताहां ईसु तियांहां कोयो, “तुमू काहा बिताहा? तुमुहूं ओमे जाआं विश्वास कायनाहां के?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />पोन ते जुदाकाम बियाते आन एकान बिहीराहा कोना वोल्‍या, “वादुउ आन दोर्‍या बी याअ गोठी उनाअतेहे, ओ होय कोडु!”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">ईसु पुते लागला माहुंहूं हुदारत्लु</para>
  <para style="r">(<ref loc="MAT 8:28-34">मत्तय 8:28-34</ref>; <ref loc="LUK 8:26-39">लुक 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />ईसु आन तियाआ सेला तालावोअ तियी वोगेहे गेरासेनेवालाआं मुलखो मेहें पोत्या. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />आन जेहलामेहें ईसु नावड़ा मेहें रोत उतर्‍यू ताहां लगेज एक माहुंउं जियामेहें खाराब आत्मा ओती, तो माहणोमेहें रोत निहीत तियाहा मिल्यो. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />तो माहणोअहीं रोतोतो आन कोडो तियाहा हाकले वाअहीं बी ने बांदीत सेकतोतो, <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />काहाके वारुज वाआ तियाआ आथेन गुडा हाकले वाअहीं बांद्याते, पोन तिये हाकलेहे बी तोड़ी देदीते, आन बेड़ीइ बोटकान- बोटका कोइ देदाते, आन तियाहा गाठाड़ीलोअ सेक्ती कोडाजमेहें ने ओती. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />तो तालताल रातेन दिही माहणोमेहें आन डोगो मेहें आअड़ीतो फिरतोतो, आन तिया तियाआज डोणो वाअहीं वाडीत लेतोतो.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />तो ईसुहू देखीत सेटेज रोत गुगद्‍यू, आन तियाआ पागे पोड़्यु. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />आन जोरेबी आअड़ीत कोयो, “ईसु, आखाम रोत वोडा देवोअ बेटाह्हा, माअरी ताआ कि काम? आंय ताहूं देवोअ शप्पत आपीत कोहो, के माहूं डोंड मा आपीही.” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />काहाके ईसु तियाहा कोयोतो, “ए खाराब आत्मा, या माअहूंमेहें रोत निहीत आव.”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />ईसु तियाहा फुशो, “ताआ कि नाव होय?”</para>
  <para style="p" vid="MRK 5:9">तिये माअहें कोयो, “माआं नाव सैन्य होय; काहाके आमू जाअखा होय.” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />आन तिये ईसुहू खुब रावणी कोअयी, “आमुहूं या मुलखोमेहें रोत बाअथे मा मोकलिही.”<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />तिहीं डोगो पोअ भुंडड़ाआ एक वोडू गोवारु सोरतू तो. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />आन तियां खाराब आत्मा ईसुहू रावणी कोइत कोयो, “आमुहूं फोलां भुंडड़ामेहें मोकली दे, के आमू तियांआं मांयते जांव.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />ताहां ईसु तियांहां हुकूम आप्यू आन खाराब आत्में निहीत भुंडड़ामेहें फोहीत गोये आन तो गोवारु एक आंदास बेन हाजारोअ ओतू, टेकोपोअ रोत तालावोम पोड़्ये आन बुडीत मोये.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />आन भुंडड़ाआ सारवाली गुगदिइताज सेरोमेहें आन गांवोंम खबर कोयी, आन जो ओवल्यो तो, माअहें तियाहा पाले आवये. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />ताहरेए ते ईसुउ जागे आये, आन तिया पुतवाअला माहूंमेहें जियामेहें पुतोंअ टोलू ओतू तियाहा आंगड़े पोवल्ये आन सुद्दीपोअ बोठलाहा पालीत कोइत बित गोये. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />आन देखनारे माअहें तिया पुतवाअलाआ जियामेहें पुतोंअ टोलू ओतू, आन भुंडड़ाआ पुरी हालत तियांहां कोत आप्यी.<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />ताहां ते ईसुहू रावणी कोइत कोने वोल्ये, के आमांआं मुलखोमेहें रोत जातु रो.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />जेहेलाम ईसु नावड़ा मेहें सोड़ू वोल्यू, ताहां तो पुतवाअलो जिया मेहें पेल पुत ओतू, तियाहा रावणी कोउ वोल्यू, “माहूं बी ताआ आरीज आवुहूं दे.”<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />पोन ईसु तियाहा रोअहूं दे कोयो, तेबी तिये तियाहा कोयो, “ताआ कोअ जात कोइत ताआ कोर्‍याआ माअहुंहूं को, के तापोअ दया कोइत मालख्ये ताआ काजे केतोहो वोडो काम कोअयोहो.”<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />ताहां तो जात कोइत दकापलीसोअ<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="fq" closed="false">दकापलीस </char><char style="ft" closed="false">दोहो सेरोअ इलाखू</char></note> माअहुंहूं यी गोठीइ परसार कोउ वोल्यू, के ईसु माआं काजे केतेहे वोडे काम कोअये; आखे बोगलाअतेते.<verse eid="MRK 5:20" /></para>
  <para style="s">याईरोअ मोल्यी पोर्‍यी आन एक मांदवाड़्यी बाय</para>
  <para style="r">(<ref loc="MAT 9:18-26">मत्तय 9:18-26</ref>; <ref loc="LUK 8:40-56">लुक 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />जेहेलाम ईसु फाशुउ नावड़ामेहें एकी तोड़ गोयू, ताहां एक वोडू माअहुंउं गोवारु तियाआ जागे टोलू वोलीत गोयू; आन तो तालावोअ मेरेज पोअ ओतू. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />आन याईर नावोअ आराधनालयोअ एक पुडारी आवयू, आन ईसुहू पालीत, तियाआ पागे पोड़्यु. <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />आन तिये ओं कोत कोइत जाअखीलीही रावणी कोअयी, “माआं हानीइली बेटिह्ही मोअहूं कोअहे: तू आवित तियी पोअ आथ मिक, के ते हाजी ओवीत जिवती रोय.”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />ताहां ईसु तियाअरी गोयू; आन माअहुंउं वोडू गोवारु ईसुउ फाटी गोयी, एतीही गर्दी के माअहें तिया पोअ जाआं उठ्लीत पोड़तेते.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />आन एक बाय ओती, जियीही बारा वोरह्योअ रक्त पोड़ीइलोअ बिमारी ओती. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />तियी खुब दुख वेठ्यो आन जाअखिलाहा डाक्‍टरोअहीं ईलाज कोआड़्यू. तियी आखा पोशा खरसीत टाक्या, तेबी किज फायदू ने ओवू, पोन जाअखीज बिमार ओत गोयी. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />ते ईसुउ बाप्तिमेहें सर्सा उनाअयी, तियाहा काजे गोरदीमेहें तियाआ फासाड़ी रोत आयी, आन तियाआ आंगड़ाहा आथलीत लेदो, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />काहाके ते तियी-तियीइज कोतीते, “जर आंय तियाआ आंगड़ाहा एतीज बी आथलीत लेहीं, तेबी हाजी ओत जाहीं.”<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />आन ताबुड़ तियीइ रक्त वोहीइलाअ बिमारी हाजी ओत गोयी; आन तियीही सोताआ डिलोमेहें जाआंत गोयो, के आंय तियी बिमारीमेहें रोत हाजी ओत गोयीही. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />ईसु ताबुड़ तिया तियाआज जाइंत लेदो, के मामेहें रोत सेक्ती निहींयीही, आन गोरदी मेहें फासाड़ी वोलीत फुशो, “माआं आंगड़ाहा कोडे आथल्यो?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />तियाआ सेला तियाहा कोयो, “ताहूं देखाअहे, के माअहें तापोअ उठते पोड़तेहे, आन तू कोहे; के माहूं कोडे आथल्यू?”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />पोन ईसु शारी वोगेहे पालतूज रोयू के कोडे एहलोहो काम कोअयोहो. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />ताहां ते बाय ओं जाइंत, के तियीइरी कि ओवयोहो, बिती बिती आन कापती कापती आयी, आन तियाआ पागे पोड़ीत, तियाहा खोरो कोत देदो. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />ईसु तियीही कोयो, “माआं बेटी, ताआ विश्वासे ताहूं हुदरावयीही: होकेहे जा, आन ताआ यी बिमारीम रोत वासाइत रोजी.”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />ईसु जेहेलाम ओं कोतूतो, ताहां आराधनालयोअ पुढार्‍योअ कोर्‍येए माअहें आवित कोयो, “ताआ ते बेटिह्ही ते मोइत गोयी; ओमे गुरुहू काहा तारास देहे?” <verse eid="MRK 5:35" /><verse number="36" style="v" sid="MRK 5:36" />जे गोठ ते कोतेते, तियांअहें ईसु दिहान नाहां देदी, पोन पोन्साआ पुढार्‍योहो कोयो, “मा बिही; निस्तु भरिवसू मिक.” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />आन तिये पेत्र आन याकोब आन याकोबोअ पाही योहान यां वासी, बिहीरा कोडाहा तियाअरी ने आवुहूं देदा. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />आन आराधनालयोअ पुडारी याइरोअ कोअ पोत्या, ताहां ईसु माअहुंहूं कि कोएन किन्ने एहेलेहे जाअखीलेहे रोड़त्लाहा आन आअड़ीइत्लाहा देख्ये. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />ताहां तिये मांयते जात कोइत तियांहां कोयो, “ए कापाली काहा कोअतेहे? काहा रोडतेहे तुमू? पोर्‍यी नाहां मोअयी, पोन हुवेहे.”<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />ते तियांअहें ओंहये, पोन तिये आखाहा काडीत कोइत पोर्‍यीइ आयहीन आब्हाहा आन तियाआ सेलाहां लेत कोइत, मांयते पोर्‍यीही लोटाडीत मिकल्यी तिहीं गोयू. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />आन पोर्‍यीइ आथ तोइत तियीही कोयो, “तलीता कूमी,” मोन्ज्ये “ए पोर्‍यी, आंय ताहूं कोहो, उठ.”<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />आन पोर्‍यी ताबुड़ उठीत साली फिरी वोल्यी; काहाके ते बार वोरह्योंअ ओती. यी गोठी वाअहीं तें माअहें बोगलाइत गोये. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />पोन ईसु तियांहां कड़क शब्दाम कोयो के, ए गोठ कोडाहाज मा कोहा, आन कोयो, “यिही कि तेबी खायतेहें काजे आपा.”<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">नासरेथोमेहें ईसुउ नाकार</para>
  <para style="r">(<ref loc="MAT 13:53-58">मत्तय 13:53-58</ref>; <ref loc="LUK 4:16-30">लुक 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />तिहीं रोत निहीत ईसु तियाआ नासरेथ होयरोम आवयू, आन तियाआ सेला तियाआ फाटी गोया. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />आरामोअ दिहोअ दिही तो आराधनालयो मेहें संदेश आपू वोल्यू; आन वारुज माअहें उनाइत कोइत बोगलाइत गोये आन कोने वोल्ये, “याहा ए गोठी का रोत मुंदू पोड़्यु?” एहेलिही हिकवोण याहा कोडे आप्यी? याआ आथे एते वोडे कामे केहें कोइत ओवतेहे? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />केहें ओ तोज हुतार नाहां के जो मरियाआ पोर्‍यू, आन याकोब, योसेफ, यहुदा आन शिमोनोअ पाही होय? आन याआ बोअह्हीं इंहीं आपाआ विसमेहें नाहां रोती के? तियाहा काजे तियां तियाआ नाकार कोअयू.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />ईसु तियांहां कोयो, “भविश्यवक्ताहा फक्त तियाआ कुटूंबामेहें आन कोअमेहें आन कोर्‍याआ माहूंमेहें सोड़ीत आखी जागे मानपान जोड़त्लू.”<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />आन तो तिहीं कोड्ले वोडे कामे नाहां कोइत सेक्यू, फक्त थोड़ाज मांदवाड़्यापोअ आथ मिकीत तियांहां हाजे कोअये. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />आन तो बोगलाइत गोयू, काहाके तियां माअहुंउं अविश्वास ओतू.</para>
  <para style="p" vid="MRK 6:6">फाश्यू तो गांवोंमेहें माअहुंहूं सिकाड़तु फिरु वोल्यू.<verse eid="MRK 6:6" /></para>
  <para style="s">ईसु बारा सेलाहा सेवाहा मोकलीइत्लू</para>
  <para style="r">(<ref loc="MAT 10:5-15">मत्तय 10:5-15</ref>; <ref loc="LUK 9:1-6">लुक 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />आन ईसु बारा सेलाहा तियाआ जागे हादीत कोइत तियांहां बेन बेन जोओंहों मोकलु वोल्यू; आन तियांहां खाराब आत्मा पोअ आधिकार आप्यू. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />आन तियांहां हुकुम आप्यू, “के वाटेए काजे डेंगार सोड़ीत बिहीरो किज मा लेहा; ने रोटू, ने खोत्लू, ने खुहेंमेहें पोशा. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />पोन खाहड़े पोवजा आन पोवित रोल्या आंगड़ा वासी बिहीरो आंगड़ो मा लेहा.” <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />आन तिये तियांहां कोयो, “जिहीं तुमाआं स्वागत ओवे, तिहीं रोत जाअहूं जाआं तो कोअ टाकीत ने जाहा, ताअहूं जाआं तिहींज रोजा. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />जिया गावोंअ माअहें तुमुहूं स्विकार ने कोए, आन तुमाआं ने उनाये, तिहीं रोत निहींत तुमाआं गुडाआ थुड़ीइ तुलो बी फोकड़ीत टाका, काहाके तों तियांआं काजे साक्शी बोणुहूं जोवे.”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />ताहां तियां जात कोइत परसार कोअयू के पाप कोइलोअ सोड़ा, आन देवोअ वोल मोन फेरवा. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />आन वारुज पुते काड्ये, आन वारुज मांदवाड़्यापोअ जेयतुनोअ तेल हारीत कोइत हाजे कोअये.<verse eid="MRK 6:13" /></para>
  <para style="s">बाप्तिस्मा आपनारा योहानोअ खुन</para>
  <para style="r">(<ref loc="MAT 14:1-12">मत्तय 14:1-12</ref>; <ref loc="LUK 9:7-9">लुक 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />आन हेरोद राजा ईसुउ सर्सा उनाअयू, काहाके तियाआ नाव पसरीत गोयोतो, आन तिये कोयो, के “योहान बाप्तिस्मा आपनारु मोतो मेहें रोत जिवीत उठ्यूहू, तियाहा कोत तिया वाअहीं एं वोडे कामे ओवतेहे.”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />आन बिहीरा कोयो, “ओ एलिया होय,”</para>
  <para style="p" vid="MRK 6:15">पोन थोड़हा कोयो, “भविश्यवक्ता नेत भविश्यवक्ता मेर्‍युउ कोडू तेबी एकाआ होस होय.”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />हेरोद ओं उनाइत कोयो, “जिया योहानोअ मुंड तोडल्यो, तोज जिवीत उठ्यूहू.” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />काहाके हेरोद तियाआ पाही फिलीप्पअ लाडी हेरोदियास, जियीइरी तिये वेहवाल कोअल्यो, माअहुंहूं मोकलीत योहानोहो तोइत जेलेमेहें टाकी देदूतो. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />काहाके योहान हेरोदोहो कोयोतो, “ताआ पायहोअ लाडीही मिकीइलोअ ताहूं कायदाअ पुरमाणे नाहां होबा देतो.”<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />तियाहा काजे तियाअरी हेरोदियाआ ने जोमतीते आन एहेलुहू विसार कोअतीते, के योहानोहो माईं देअहूं जोवे, पोन एहलोहो ने ओवयो. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />काहाके हेरोद योहानोहो धर्मी आन पवित्र माअहुंउं कोत बितूतो, आन तियाहा वारुहूं वेंडारतूतो, आन तियाआ गोठ उनाइत जाअखिलुहू बितूतो, पोन खुसीमेहें उनाअतूतो.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />आन बोराबर वेल आयी पोन जाहां हेरोद तियाआ जल्माआं दिहोपोअ तियाआ मुख्याहां आन सेयनिकोअ मुख्याहां, आन गालील मुलखोमेर्‍याआ डायहांआं काजे पांगात मिक्यी. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />आन ते हेरोदियाआ बेटिह्ही मांयते आवयी, आन नासीत कोइत हेरोद आन तियाअरी बोहनाराहां खुस कोअया; ताहां राजा पोर्‍यीही कोयो, “ताहूं जों जोवे तों मापोअ माग, आंय ताहूं आपिहीं.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />आन तिये शप्पत खादी के, “आंय माआं आरदो राज्यो जाआं जो किबी तू मापोअ मागही तों आंय ताहूं आपिहीं.”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />ताहां ते पोर्‍यी बाअथे जात कोइत तियीइ आयहीही फुशो, “आंय कि मागो?”</para>
  <para style="p" vid="MRK 6:24">तियी कोयो, “बाप्तिस्मा कोअनारा योहानोअ मुनको.”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />ते ताबुड़ राजाअ जागेहे मांयते गोयी, आन तियाहा विनंती कोअयी, के “माहूं ओंमेज बाप्तिस्मा आपनारा योहानोअ मुनको एकी ठालीमेहें लेतावीत आपुहूं जोवे.”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />ताहां राजा खुब उदास ओवयू, पोन तियाआ शप्पतेए वाखरी आन आरी बोहनाराआं वाखरी तो तियीही नाकारीत ने सेक्यू. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />ताहां राजा ताबुड़ एका सिपायोहो तियाआ मुनको वाडीत लेतावेतेहें काजे हुकूम आप्यू, तिये जेलेमेहें जात कोइत तियाआ मुनको वाड्‍यो. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />आन एकी ठाली मेहें मिकीत लेतायू, आन तियी पोर्‍यीही आप्यो, आन पोर्‍यी तियीइ आयहीही आप्यो. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />ओं उनाइत कोइत योहानोअ सेला आवया, आन तियाआ तोड़ विसीत माहणोमेहें ओज्यो.<verse eid="MRK 6:29" /></para>
  <para style="s">ईसुउ हाजार माअहोंहों खावाड़ीइलो</para>
  <para style="r">(<ref loc="MAT 14:15-21">मत्तय 14:15-21</ref>; <ref loc="LUK 9:11-17">लुक 9:11-17</ref>; <ref loc="JHN 6:1-14">योहान 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />साकर्‍या ईसुउ जागे आवित कोइत एकठा ओवा, आन जों किबी तियां कोअयो, आन सिकाड़्यो तों, आखो तियाहा कोत देखाड्यो. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />फाश्यू तिये तियांहां कोयो, “तुमू रानोमेहें हुंदली जागे साला आन थोड़ुक आराम कोआ.” काहाके तिहीं जाअखीलेहे माअहें जातेते आन आवतेते नेहें तिहीं वाअहीं तियांहां रोटू खाअलोअ बी वेल ने जोड़तीते. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />ताहां ते आखा नावड़ाम बोहीत नेवरी जागेहे गोया.<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />पोन वारुज माअहें तियांहां जात्ला देखीत लेदा आन ते कोडा होय ते ओलखीत लेदा ताहां तिहींइं आसे-पासेए आखे माअहें पागेज गुगदीइतेज निहींये आन तियां रोत आगाड़ी तें तिहीं पोते. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />ईसु जाहाजीम रोत उतर्‍यू, ताहां तिये वोडी गर्दी देख्‍यी; तें सारवाली ने ओय एहेलाहा मेडाआं होसर्‍येए ओते, तियाहा काजे तियाहा तियां पोअ दया आयी; तियाहा काजे तो तियांहां वारुज गोठीइ बाप्तिम सिकाडू वोल्‍यू. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />जेहेलाम दिही वारुज डोलीत गोयू तेहेलाम सेला तियाआ जागे आवित कोइत तियाहा कोयो, “ओ हुंदलू जागू होये आन दिही बी जाअखुज डोलीत गोयुहू. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />माअहुंहूं वाटे लागाड़ मोन्ज्ये तें आसे-पासेए खेतोम आन गांवोंमेहें जात कोइत सोताआ काजे कि तेबी लेत खाय.”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />ईसु तियांहां कोयो, “तुमूज तियांहां खायतेहें काजे आपा.” तियां तियाहा कोयो, “आमू तियांहां खायतेहें काजे बेन होव दीनारोअ<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="fq" closed="false">दीनार </char><char style="ft" closed="false">दीनार ताहां सांदीइ आनो आन एक दीनार ताहां एका दिहोअ मोजरी एतीही तियाआ किंमत बोणत्ली.</char></note> वेसातू रोटू लेतावो के?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />ईसु तियांहां फुशो, “तुमापोअ केतुहू रोटू होय?” जावा आन पाला,</para>
  <para style="p" vid="MRK 6:38">आन तियां होदीत कोइत कोयो, “पास रोटा आन बेन मासा होय.”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />ताहां ईसु तियाआ सेलाहां कोयो, के आखाहा रांगी-रांगीमेहें निला सारा पोअ बोहाड़ी द्या. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />तियाहा काजे तें होव-होव आन पोन्नास-पोन्नास जोओं एहेलिही रांग्यी कोइत बोठे. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />ताहरुउ ईसु पास रोटा आन बेन मासा लेत कोइत होरगाआ वोलेहे पाल्‍योन ताहरुउ देवोअ आभार मान्यू. आन माअहुंहूं वाटेतेहें काजे सेलाहां मुड़ीत-मुड़ीत आपतू गोयू आन बेन मासा बी वाटीत कोइत तियां आखाहा आप्या. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />आन बादे खात कोइत ताराईत गोये. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />ताहराअ सेला उगरीइल्‍या रोटाअ कुटका वाअहीं बारा टोपले पोइत लेदे आन मासाआ बी पुकरा टोलू कोअया. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />जियां रोटू खादू तियांमेहें निस्ता पास हाजार माटी ओता.<verse eid="MRK 6:44" /></para>
  <para style="s">ईसु पाअयोंपोअ सालत्लु.</para>
  <para style="r">(<ref loc="MAT 14:22-33">मत्तय 14:22-33</ref>; <ref loc="JHN 6:15-21">योहान 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />ताहरुउ ईसु ताब्बुड़ तियाआ सेलाहां नावड़ा मेहें बोहाड़्या आन ते तिया रोत पेल तियी तोड़े बेथसैदा मेहें जाता रोयतेहें कोयो, जाअहूं जाआं के तो माअहोंहों मोकले. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />तियांहां मोकलीत कोइत तो डोगो पोअ प्रार्थना कोउ गोयू. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />जेहेलाम वेल पोड़्यी, ताहां नावड़ो तालावोअ विसमेहें ओतो, आन ईसु मेरेपोअ एखलुज ओतू. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />जेहेलाम तिये देख्यो के ते नावड़ो सालाड़ी-सालाड़ीइ काबरात गोयाहा, काहाके हावा तियांआं विरुद्दाम सालतीते, ताहां रातीइ शार वाजताआ वेलेए विसमेहें हुजीइला रोत पेल तो तालावो पोअ सालित तियांआं जागे आयू; काहाके तियाआ तियांआं रोत आगाड़ी जाअलोअ विसार ओतू. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />पोन ते तियाहा पाअयों पोअ सालत्लु पालित कोइत समज्या के पुत होय, आन आअड़ा वोल्या; <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />काहाके आखा तियाहा पालीत कोइत काबराईत गोयाते.</para>
  <para style="p" vid="MRK 6:50">पोन ताबुड़ ईसु तियांहां कोयो, “हिम्मत मिका: आंय होय; मा बिहा!” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />ताहरुउ तो तियांआं जागे नावड़ाम आयू, आन वारो बोंद ओत गोयो: ताहराअ ते जुदा बोगलाइत गोया. <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />ते तियां पास हाजार माअहोंहों रोटू खावाड़ीइलाअ गोठीइ अर्थ नाहां समजीत सेके, काहाके तियांआं मोन टाठो ओत गोयेते.<verse eid="MRK 6:52" /></para>
  <para style="s">ईसु गनेसरेतोमेहें मांदवाड़्याहां हुदारत्लू</para>
  <para style="r">(<ref loc="MAT 14:34-36">मत्तय 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />जेहेलाम ते दोर्‍या उनकावित कोइत गनेसरेत पोत्या, आन नावड़ो मेरे बांदी देदो. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />जेहेलाम ते नावड़ामेहें रोत उतर्‍या, ताहां माअहें ताब्बुड़ ईसुहू ओलखीत लेदू, <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />आहने पाहनेए आखा भागोमेहें गुगद्ये, आन मांदवाड़्याहा खाट्ला पोअ टाकीत कोइत, जिहीं जिहीं तियाआ खबर मिल्यी, तिहीं तिहीं रोत वोहीत फिर्‍ये. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />आन जिहीं काबी ईसु गांवोंम, सेहरोम नेते खेतोमेहें जातुतो, माअहें मांदवाड़्याहा बोर बाजारोमेहें लेतावीत मिकतेते आन ताआ साअकाआ कोरेहे तेबी आथ लागाड़ुहूं दे, एहें कोइत तियाहा रावण्या कोअतेते, आन जेत्ते जोएं तियाहा आथ लागाड़्यु, तेत्ते आखे हाजे ओत गोये.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">रितीरिवाज पालनोअ बाप्तिम प्रश्न</para>
  <para style="r">(<ref loc="MAT 15:10-20">मत्तय 15:10-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />ताहराअ थोड़ाक कायदाअ मास्तरहों आन फरिसी जे येरुसालेमोमेहें रोत आयाते, ईसुउ जागे टोलू वोल्या,<verse eid="MRK 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 7:2" />आन ते तियाआ थोड़ाक सेलाहां एठो मोन्ज्ये विण तुवल्ये आथेज रोटू खात्ला देख्या.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />काहाके कायदाअ मास्तरहों जे फरिसी आन आखा यहुदी, वेगाआ डायहांआं रिती पोअ सालताहा आन जाअहूं जाआं वारुहूं आथ ने तुवे ताअहूं जाआं ते रोटू ने खात्ला; <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />आन बाजारोम रोत आवित उंगल्या सिवाय कोड्‍लीज वस्तु ने खात्ला. आन एहेलिही वारुज गोठी ते पालनी कोइत सालत्ला, आन गिलास, डोसरे, तांबाअ बासने, आथरुउ साफसुफ कोइलोअ एहेलिही बाकी वारुज रिती ते पालत्ला.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />तियाहा काजे फरिसी आन कायदाअ मास्तरहों ईसुहू फुशो, “ताआ सेला डायहांआं रितीइ परमाणे काहा ने सालत्ला? आन बिगर आथ तुवयेज रोटू काहा खात्ला?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />
    <note caller="+" style="f">
      <char style="fr" closed="false">7:6 </char>
      <char style="ft" closed="false">यशया 29:13 </char>
    </note>ईसु तियांहां कोयो, यशया कोअयिही ते भविश्यवाणी तुमा ढोंगड़ा कोअनाराआ बाप्तिमेहें बोराबर ओती, तो कोत्लू,</para>
  <para style="q1" vid="MRK 7:6">“एं माअहें ओठो वाअहीं तोम माआं मान सन्मान कोअतेहे:</para>
  <para style="q2" vid="MRK 7:6">पोन यांआं मोन माआं रोत सेटे होय.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />एं वायबार माआं भक्ती कोअतेहे,</para>
  <para style="q2" vid="MRK 7:7">काहाके मोनव्योअ कायदाहा</para>
  <para style="q2" vid="MRK 7:7">ते देवोअ कायदु होय एहें कोत सिकाड़तेहे.<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false">यशया 29:13</char></note>”<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />“काहाके तुमू देवोअ आदेश टालित कोइत माअहोंअ रितीही मानताहा.”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />ईसु तियांहां कोयो, “तुमू तुमाआं रितीरिवाज कायम मिकीइला काजे देवोअ आदेशोहो टालीइलोअ सोपी वाट होदीत काड्यीही. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />काहाके मोशे कोयोहो, ‘तुमाआं आयहीन आब्हाआ मानपान कोआ,’ आन ‘जों कोडो आब्हाहा नेत आयहीही हाराप आपे, माअतीज टाकी देअहूं जोवे.’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />पोन तुमू सिकाड़ताहा के जर कोडो तियाआ आब्हाहा नेत आयहीही कोये, जो किबी ताहूं मावाअहीं लाभ ओत सेकतुतो, तो आंय देवोहो भेट कोइलोअ ठरव्योहो. <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />ताहां तुमू तियाहा तियाआ आयहीइ नेत आब्हाआ किज मदत नाहां कोअहूं देता. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />एहें कोइत तुमू तुमाआं रितीरिवाजो वाअहीं, जियांहां तुमू ठरव्याहा, देवोअ वसन टाली देताहा आन एहलेहे वारुज कामे होय जे तुमू कोअताहा.”<verse eid="MRK 7:13" /></para>
  <para style="s">माअहुंहूं एठी बोणावनारी गोठ</para>
  <para style="r">(<ref loc="MAT 15:10-20">मत्तय 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />ताहां ईसु माअहुंहूं तियाआ जागे हादीत तियांहां कोयो, “तुमू आखा माआं उनाआ, आन समजा. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />एहलीही कोड्लीज वस्तु कायनाहां जे माअहूंमेहें बारथे रोत मांयते जात कोइत तियाहा एठो बोणावे; पोन जे गोठी माअहुंउं मांयते रोत निहींतिही, तेज गोठी तियाहा एठो बोणावेहे. <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />जिया कोडाहा कान ओय तो उनाइत लेवा.”<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />जेहेलाम तो गोरदी मेहें रोत कोअमेहें गोयू ताहां तियाआ सेला यी काईंइं बाप्तिमेहें तियाहा फुशो. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />ईसु तियांहां कोयो, “केहें तुमू बी एहेलाहा नादान होय? केहें तुमू नाहां समजीइता के जे वस्तु बारथे रोत माहुंउं मांयते जाहे,” ते वस्तु तियाहा एठो नाहां बोणावीत सेकती? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />काहाके तो तियाआ मोनोमेहें नाहां, पोन पोटामेहें जाहे, आन पोटाम रोत ओगीइली वाटे बारथे निहींत जाहे, ओं कोत कोइत तिये आखी खाअलोअ वस्तुहू सोकी ठरव्यी.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />फाश्यो तिये कोयो, “जे गोठी माअहूं मेहें रोत बारथे निहींतिही, तेज माअहुंहूं एठी कोअतिही. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />काहाके मांयते रोत, मोन्ज्ये माअहुंउं मोनोमेहें रोत, खाराब खाराब विसार, सोद्राय, सोरी, खुन, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />सिनालो, लालसाय, खोद्राय, लबाड़ी, लुसड़ाय, खाराब नजर, रोवा, वोडाय, आन फोगाय निहेंहे. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />ए आखी खाराब गोठी मांयतेज रोत निहींतिही आन माअहुंहूं एठो बोणावतिही.”<verse eid="MRK 7:23" /></para>
  <para style="s">एकी बायीइ विश्वास</para>
  <para style="r">(<ref loc="MAT 15:21-28">मत्तय 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />ताहरुउ ईसु तिहीं रोत ऊठीत कोइत सुर आन सैदाआ देसोमेहें आयू; आन एका कोअमेहें गोयू आन तियाआ विसार ओतू के कोडाहाज ने मुंदू जाअहूं जोवे; पोन तो निकाइत ने सेकू. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />आन तेताज मेहें एक बोंईं जियीइ हानीइली पोर्‍यीमेहें खाराब आत्मा ओती, ईसुउ सर्सा उनाइत कोइत आयी, आन तियाआ गुडाआ जागे बोहीत पोड़्यी. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />एक बिगर यहुदी जातीइ बाय आन तियीइ जल्म सुरुफिनीकी मेहें ओवोतो. तियी ईसुहू रावणी कोअयी के, “माआं पोर्‍यीमेहें रोत पुतोअ आत्मा काडी दे.” <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />तिहीं पोअ ईसु कोयो, “पेल पोर्‍याहा ताराअहूं दे, काहाके पोर्‍याआ रोटू हुंणाआं आगाड़ी टाकीइलू ओं कांय बोराबर कायनाहां.”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />पोन तियी तियाहा उत्तर आप्यो, “मालिख, हुंणे बी तोम पोर्‍याआ आथोम रोत वेराअलू सुअवूउ खात्ले.”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />ईसु तियी बायीही कोयो, “ताआ या उत्तरो वाअहीं जा, ताआ पोर्‍यीमेहें रोत पुतोअ आत्मा निहींत गोयीही.”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />ताहरीइ ते कोअ आयी तेहेलाम तियीइ पोर्‍यी खाट्लापोअ लोटीत रोल्‍यी आन तियी मेहें रोत पुतोअ आत्मा निहींत गोयीही, एहेलिही तियी देख्यो.<verse eid="MRK 7:30" /></para>
  <para style="s">ईसु बोयरा-मुका माहुंहूं हुदारत्लू</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />ताहरुउ ईसु सुर आन सिदोन देसोम रोत निहीत कोइत दकापलीसोअहें<note caller="+" style="f"><char style="fr" closed="false">7:31 </char><char style="fq" closed="false">दकापलीसोअहें </char><char style="ft" closed="false">दोहो सेरोअ इलाखाअहें</char></note> फिरतुज ना गालीलोअ तालावोअ जागे पोत्यु. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />ताहरेए माअहें एका बोयराहा जो तोत्र्यो बी ओतो, तियाआ जागे लेतावीत तियाहा रावणी कोअयी के ताआ आथ यापोअ मिके. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />ईसु तियाहा गोरदी मेहें रोत आंगेज लेत जात कोइत तियाआ कानोमेहें तिये आंगुउ काल्यी आन थुपीत कोइत तियाआ जिबीही लागाड़्यो. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />आन ईसु होरगाअहें पाल्‍यो आन काहींत कोइत तियाहा कोयो, “इप्फथ्था” मोन्ज्ये “मोकलू ओत जा!”<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />तियाआ कान उगड़ीत गोया आन जिबीइ गाठ सुटीत गोयी आन तो गोगु वोल्यू. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />ताहरुउ ईसु माअहुंहूं कड़क शब्दाम कोयो के ओं कोडाहाज मा कोहा, पोन जेत्तो तिये तियांहां वारुहूं कोयो तेत्तो तें जाअखे परसार कोए वोल्ये. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />तें जाअखेज बोगलात कोइत कोने वोल्ये, “तो जों किबी कोअहे तों हाजोज कोअहे; तो बोयराहा ऊनाइलाआ, आन मुकाहां गोगीइलाअ सेक्ती आपेहे.”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">ईसुउ शार हाजार माअहुंहूं खावाड़त्लू</para>
  <para style="r">(<ref loc="MAT 15:32-39">मत्तय 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />तियां दिहोमेहें जाहां वोडी गोरदी एकठी ओवयी, आन तियांपोअ किज खाअलोअ ने ओतो, ताहां ईसु तियाआ सेलाहां आहने हादीत तियांहां कोयो, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“माहूं यां माअहूं पोअ किइमाय आवेहे, काहाके एं माअहें तीन दिहर्‍येए माअरीज होय, आन यांपोअ किज खाअलोअ कायनाहां. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />जर आंय यांहां फुकल्येज कोअ मोकली देहीं, ताहां वाटेज थाकीत रोत जाय; काहाके यांमेर्‍येए कोडे कोडे ते सेटेरोत आवयेहे.”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />तियाआ सेला तियाहा उत्तर आप्यो, “इंहीं जंगलोमेहें एताहा रोटा कोडो का रोत लेतावे के एं ताराय?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />तिये तियांहां फुशो, “तुमांपोअ केताहा रोटा होय?”</para>
  <para style="p" vid="MRK 8:5">तियां कोयो, “हांत.”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />ताहां तिये माअहुंहूं पुंयपोअ बोहे तेहें कोयो. आन ते हांत रोटा लेदा आन आभार मानित मुड्या, आन माअहुंहूं वाटेतेहें तियाआ सेलाहां आप्या, आन सेलहां एहलोहो कोअयो. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />आन तियां पोअ थोड़ेक हाने मासे बी ओते: ईसु आभार मानित कोइत तियांहां बी माअहुंहूं वाटेतेहें आपी देदे. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />ते खात कोइत ताराईत गोये, आन सेला उगरीइल्या रोटाआ कुटका हांत टोपले पोइत टोलू वाल्या. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />आन माअहें एक आंदास शार हाजार ओते; ताहां ईसु तियांहां वाटे लागाड़्ये, <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />आन तो ताब्बुड़ तियाआ सेलांअरी नावड़ामेहें बोहीत कोइत दलमनूता जिल्हा मेहें जातु रोयू.<verse eid="MRK 8:10" /></para>
  <para style="s">फरिसीइ वोडे कामे कोइलोअ होरगामेर्‍यीइ मागणी</para>
  <para style="r">(<ref loc="MAT 16:1-4">मत्तय 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />थोड़ाक कायदाअ मास्तरहों जे फरिसी आवित कोइत ईसुउ आरी सोबा सोबी लाग्या, आन तियाहा फारकीलोअ काजे तिया पोअ कि ते बी होरगामेर्‍यीइ निशाणी माग्यी.<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">मत्तय 12: 38 लुक 11:16 </char></note> <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />पोन ईसु तियाआ आत्मामेहें कांहीत कोयो, “आज्येए माअहें निशाणी काहा मागतेहे? आंय तुमुहूं नक्की कोहो के आज्याआ माअहुंहूं<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="fq" closed="false">आज्याआ माअहुंहूं </char><char style="ft" closed="false">पिढ़ी</char></note> किज निशाणी ने आपाय.”<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />आन तो तियांहां टाकीत फाश्यू नावड़ामेहें बोहीत तियी तोड़ जातु रोयू.<verse eid="MRK 8:13" /></para>
  <para style="s">फरिसी आन हेरोदेस यांआं खमीर</para>
  <para style="r">(<ref loc="MAT 16:5-12">मत्तय 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />सेला रोटू लेअलोअ विहराइत गोयाते, आन नावड़ामेहें तियांपोअ एकुज रोटू ओतू. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />ईसु तियांहां आदेश आप्यू, “हेएजा, फरिसीइ खमीर<note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="fq" closed="false">खमीर </char><char style="ft" closed="false">एक सोड़ाआ होस एक लोटोहो फुगाड़नारो एक पावडर</char></note> आन हेरोदेसोअ खमीरोपरोत सांबालित रोजा.”<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />ते तियां तियांआंज गोठी कोइत कोना वोल्या, “आमापोअ रोटू कायनाहां.”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />ओं जांइत कोइत ईसु तियांहां कोयो, “तुमू काहा तुमा तुमाआंज एहेलिही गोठी कोअताहा के आपापोअ रोटू कायनाहां? केहें ओमे जाआं नाहां जांअता आन नाहां समजीइता? केहें तुमाआं मोन वातड़ो ओत गोयोहो? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />केहें डोआ लेत रोयाहा तेबी नाहां देखाअतो, आन कान लेत रोयाहा तेबी नाहां उनाअता? आन केहें तुमुहूं ओर नाहां आवती? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />जेहेलाम आंय पास हाजार माअहुंउं काजे पास रोटा मुड़्याते, तेहेलाम तुमू केतीही टोपली पोइत रोटू टोलू वाल्यू?”</para>
  <para style="p" vid="MRK 8:19">तियां तियाहा कोयो, “बारा टोपले.”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />फाशोअ ईसु फुशो, “आन जाहां शार हाजार माअहुंउं काजे हांत रोटा ओता ताहां तुमू केतीही टोपली पोइत रोटू विशुतो?”</para>
  <para style="p" vid="MRK 8:20">तियां तियाहा कोयो, “हांत टोपले.”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />तिये तियांहां कोयो, “केहें तुमू ओमे जाआं नाहां समज्या?”<verse eid="MRK 8:21" /></para>
  <para style="s">ईसुउ बेथसैदा होयरोमेहें आंद्लाहा हुदारीइलोअ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />ते बेथसैदा मेहें आवया; आन माअहें एका आंदलाहा ईसुउ जागे लेतावये आन तियाहा आथ लागाड़े तेहें काजे रावणी कोअयी <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />तो तिया आंद्लाआ आथ तोइत कोइत गांवोंअ बारथे लेत गोयू, आन तियाआ डोआ पोअ थुपीत कोइत तियापोअ आथ मिक्या, आन तियाहा फुशो, “तू वाजिहीं देखीत सेकेहे के?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />तिये उसे पालित कोइत कोयो, “होव, आंय माअहुंहूं देखीत सेकोहो; ते माहूं सालत्ला साड़ोअ होस देखाअतेहे.”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />ताहरुउ ईसु बिहीरी वारी तियाआ डोआ पोअ आथ मिक्या, आन तियाआ डोआअ नजर फाशीइ आवित लागी. आन आखो वारुहूं वारुहूं देखु वोल्यू. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />ईसु तियाहा ओं कोत कोइत कोअ मोकल्यू, “या गांवोंम गुडू बी मा मिकही.”<verse eid="MRK 8:26" /></para>
  <para style="s">पेत्राआ ईसुहू ख्रिस्त स्विकारीलाआ</para>
  <para style="r">(<ref loc="MAT 16:13-20">मत्तय 16:13-20</ref>; <ref loc="LUK 9:18-21">लुक 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />ईसु आन तियाआ सेला कैसरीया फिलिप्पीइ गांवोंमेहें गोया. वाटे तिये तियाआ सेलाहां फुशो, “माअहें माहूं कि कोतेहे?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />तियां कोयो, “बाप्तिस्मा आपनारु योहान; पोन थोड़हे थोड़हे एलिया आन थोड़हे थोड़हे भविश्यवक्ता मेर्‍युउ एक कोतेहे.” <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" />तिये तियांहां फुशो, “पोन तुमू माहूं कि कोताहा?” पेत्रे तियाहा कोयो, “तू ख्रिस्त<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="fq" closed="false">ख्रिस्त </char><char style="ft" closed="false">अभिशिक्त मोन्ज्ये निवड़ीइल्यू</char></note> होय.”<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">योहान 6:68-69</char></note> <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />ताहरुउ ईसु तियांहां आदेश आपित कोयो के, “माआं बाप्तिमेहें ओं कोडाहाज मा कोहा.”<verse eid="MRK 8:30" /></para>
  <para style="s">सोताआ मोतोअ बाप्तिमेहें ईसु भविश्यवाणी</para>
  <para style="r">(<ref loc="MAT 16:21-23">मत्तय 16:21-23</ref>; <ref loc="LUK 9:22">लुक 9:22</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />ताहरुउ ईसु तियांहां सिकाड़ु वोल्यू के माहुंउं बेटाह्हाअ काजे गरजेए होय के तो खुब दुख वेठे, आन वेगाआ डाया आन डाया पुंजारा, आन कायदाअ मास्तरहों तियाहा बिगर कामोओं समजीत कोइत माईंत टाके, आन तो तीन दिहोअ फासाड़ी जिवीत उठे. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />तिये ए गोठ तियांहां वारुहूं समजाड़ीत कोत देदी. ताहरुउ पेत्र तियाहा आंगेज लेत जात कोइत बावराऊ वोल्यू, <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />पोन ईसु वोलीत कोइत तियाआ सेलाअहें पाल्य, आन पेत्राहा बावराइत कोयो, “ए सैतान माआं सामने रोत सेटे जातु रो; काहाके तू देवोअ गोठी पोअ नाहां, पोन माअहुंउं गोठी पोअ मोन लागाड़ेहे.”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />ईसु गोरदीही तियाआ सेलाअरी आहने हादीत कोइत तियांहां कोयो, “जर एखाहा माआं फासाड़ी आविइलोअ ओय ताहां तो सोताहा नाकारुहूं जोवे. आन तियाआ क्रुस खांब आखलीत कोइत, माआं फासाड़ी आवुहूं जोवे.<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="ft" closed="false">मत्तय 10:38; लुक 14:27</char></note> <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />काहाके जो कोडो तियाआ जिव वासाडुहूं होदे, तो तियाहा आरवे, पोन जो कोडो माआं काजे आन हाजी बातमीइं काजे तियाआ जिव आरवे, तो तियाहा वासाड़े.<note caller="+" style="f"><char style="fr" closed="false">8:35 </char><char style="ft" closed="false">मत्तय 10:39; लुक 17:33; योहान 12:25</char></note> <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />जर माअहुंउं आखी दुन्या जिकीत लेदी आन सोताआ जिवोहो आरवीत टाक्यो ताहां तियाहा कि लाभ? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />जिवोअ बोदले माहुंउं कि आपीत सेकेहे? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />जो कोडो यी सिनाल आन पापी जातीइ विसमेहें माहूं आन माआं हिकवोणेहे लाजवाय, माहुंउं बेटुह्हू बी जाहां तो पवित्र देवदुतोंअ आरी तियाआ बाह्हाआ महिमामेहें आवे, ताहां तियाहा बी लाजवाड़े.”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />ईसु तियांहां कोयो, “आंय तुमुहूं खोरीज कोहो के जे इंहीं उबले होय, यांमेर्‍येए थोड़ेक एहलेहे होय, के जाअहूं जाआं देवोअ राजोहो सेक्तीइरी आवल्याहा ने देखीत लेय, ताअहूं जाआं तियांहां मोत ने आवे.”<verse eid="MRK 9:1" /></para>
  <para style="s">ईसुउ बोद्लाअलू रुप</para>
  <para style="r">(<ref loc="MAT 17:1-13">मत्तय 17:1-13</ref>; <ref loc="LUK 9:28-36">लुक 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />सोव दिहोअ फाटी ईसु पेत्राहा आन याकोबोहो आन योहानोहो आरी लेदा, आन हुंद्ला जागामेहें एका उसा डोगोपोअ लेत गोयू. तिहीं तियांआं देखताइज ईसुउ रुप बोद्लात गोयू. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />आन तियाआ आंगड़े एहलेहे सोमके वोल्ये आन उजालो जाआं पोड़्यो, एतेहे के धरती पोअ कोड्लूज आंगड़ाआ तुवनारु बी तेतेहे उजले ने कोइत सेकतु. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />ताहां तीनू सेला मोशे आन एलियाहा ईसुउरी गोठी मिकत्लाहा देख्या. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />यापरोत पेत्रे ईसुहू कोयो, “गुरु, आपाआ इंहीं रोअलोअ केतोहो हाजो होय: तियाहा काजे आपू तीन तंबा बोणावता; एक ताआ काजे, एक मोशेए काजे, आन एक एलियाआ काजे.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />पेत्र आन सेला एताहा बित गोया के कि उत्तर आपो तोज पेत्राहा ने समजाअयो.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />ताहां तियांहां एके वाद्ले टापित लेदा, आन तिया वाद्लामेहें रोत ओ आवाज निहींयू, “ओ माआं मेरालू बेटुह्हू होय, याआ उनाअजा<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">मत्तय 3:17; मार्क1:11; लुक 3:22भजन 2:7</char></note>.” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />ताहां तियां शारी वोगेहे नजर टाक्यी, आन ईसुहू सोड़ीत तियांअरी बिहीरो कोडोज ने देखाअयो.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />डोगोप रोत उतरीइली वेले ईसु तियांहां कोयो के “जाअहूं जाआं माहुंउं बेटुह्हू मोल्यामेहें रोत जिवीत ने उठे, ताअहूं जाआं जों किबी तुमू देख्योहो तों कोडाहाज मा कोहा.”<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />तियां तियाआ ए गोठ मानित लेदी; आन तियां तियांज गोठी कोआ वोल्या, “मोतोमेहें रोत जिवित उठिइलोअ ताहां कि ओय?” <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />आन तियां ईसुहू फुशो, “कायदाअ मास्तरहों काहा कोताहा के एलियाआ पेल आविइलोअ जरुरी होय?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />तिये तियांहां उत्तर आप्यो, “एलिया खोरीज पेल आवित आखोज हुदारे, पोन माहुंउं बेटाह्हाअ बाप्तिमेहें ओं काहा लेख्योहो के, तो खुब दुख वेठे, आन तियाहा नाकारी देय? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />पोन आंय तुमुहूं कोहो, के एलिया ते आवित लागुहू, आन जेहलोहो तियाआ बाप्तिमेहें लेख्योहो, तियांहां जो किबी कोओ लागो तों तियाअरी कोअयो.”<verse eid="MRK 9:13" /></para>
  <para style="s">ईसुउ पुतवाअला पोर्‍याहा हुदारत्लू</para>
  <para style="r">(<ref loc="MAT 17:14-21">मत्तय 17:14-21</ref>; <ref loc="LUK 9:37-43">लुक 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />जाहां तो सेलाआं जागे आवयू, ताहां देख्यो के तियाआ शारी वोगेहे वोडी गोरदी ओवयिही आन कायदाअ मास्तरहों तियाअरी सोबा सोबी कोआ वोल्या. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />ईसुहू पालताज आखे जास्तीज पोंगलाए वोल्ये, आन तियांहां गुगदीत तियाहा सलाम कोअयो. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />ईसु तियाआ सेलाहां फुशो, “तुमू यांअरी किहाआ बाप्तिमेहें सुलाअताहा?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />गर्दी मेर्‍येए एके जोएं उत्तर आप्यो, “गुरु, आंय माआं पोर्‍याहा ताआ जागे लेतायुहू, काहाके यामेहें मुकी आत्मा होय. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />जिहीं काबी ते तियाहा तोअहे, तिहींज आसाटी देहे: आन तो सोबीमेहें फेबद्रुउ वाली देहे आन दात कोकरावेहे, आन आखड़ात जाहे. आंय तियाहा काडे तेहें कोत ताआ सेलाहां बी कोयो, पोन ते तियाहा काडीत ने सेक्या.”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />ईसु तियांहां कोयो, “ए बिगर विश्वासी माअहूं, आंय तुमाआं आरी कोयों जाआं रोंव? आन कोयों जाआं तुमाआं वेठ्या कोओ? पोर्‍याहा माआं जागे लेतावा.” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />ताहां ते तियाहा ईसुउ जागे लेतावया:</para>
  <para style="p" vid="MRK 9:20">आन जाहां तो आत्मा ईसुहू देख्यू, ताहां तिये तिया पोर्‍याहा ताबुड़ पिल्ली देदो; आन तो पुंयींपोअ पोड़्यो, आन सोबी मेहें फेबद्रुउ वालतोज ओंअडो वोल्यो. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />तिये तियाआ आब्हाहा फुशो, “याआ ए दशा कोयों रोत होय?”</para>
  <para style="p" vid="MRK 9:21">तिये कोयो, “हानू रोत. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />तिये याहा आरवीइलाअ काजे केदिहीं आगी मेहें आन केदिहीं पाअयों मेहें टाक्यु; पोन जर ताहूं बी ओत सेकतोय, ताहां आमा पोअ किइमाय कोइत आमा पोअ उपकार कोअ.”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />ईसु तियाहा कोयो, “जर ताहूं बी ओत सेकेहे? ए कि गोठ होय! भरिवसू कोअनाराअ काजे आक्खोज ओत सेकेहे.”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />पोर्‍याआ बाह्हू ताबुड़ रोड़ी रोडीइ कोयो, “प्रभु, आंय भरिवसू कोअहो, माआं अविश्वासोहो काडी दे!”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />जेहेलाम ईसु पाल्यो के माअहें गुगदा गुगद कोअते गर्दी कोअतेहे, ताहां तिये खाराब आत्माहां एहें कोत कोइत धमकी आप्यी, “ए मुकी आन बोयरी आत्मा, आंय ताहूं आदेश आपोहो, तियाम रोत निहीत जा, आन फाश्यी तियामेहें केदिहींज मा फोहीही.”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />ताहरीइ ते आअड़ीत कोइत आन तियाहा मुउडीत कोइत, निहीत गोयी; आन पोर्‍यू मोल्याआ हारकु ओत गोयू, आन वारुज माअहें कोने वोल्ये के तो मोइत गोयू. <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />पोन ईसु तियाआ आथ तोइत कोइत तियाहा उठाड़्यु, आन तो उठीत उबू रोयू.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />जेहेलामेहें तो कोअमेहें आयू, ताहां तियाआ सेला एखलामेहें तियाहा फुशो, “आमू तिया पुतोअ आत्माहां काहा ने काडीत सेका?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />तिये तियांहां कोयो, “ए जात प्रार्थनाअ सिवाय बिहीरा किहाज वाअहीं नाहां निहीत सेकती.”<verse eid="MRK 9:29" /></para>
  <para style="s">सोताआ मोतोअ बाप्तिमेहें ईसुउ फाश्यीइ भविश्यवाणी</para>
  <para style="r">(<ref loc="MAT 17:22">मत्तय 17:22</ref>,<ref loc="MAT 17:23">23</ref>; <ref loc="LUK 9:43-45">लुक 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />ते तिहीं रोत निहीया आन गालीलोमेहें रोत जाताते. तियाआ इश्शा ने ओती के कोडाहा मुंदू जाय, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />काहाके तो तियाआ सेलाहां सिकाडतु आन तियांहां कोतूतो, “माहुंउं बेटुह्हू, माअहुंउं आथोम तोइत आपाय, आन ते तियाहा माईंत टाके; आन तो मोए तिहीं रोत तीन दिहोम जिवीत उठे.” <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />पोन यी गोठीइ अर्थ तियांहां नाहां समजाअयो, आन ते तियाहा फुसुहूं बिताते.<verse eid="MRK 9:32" /></para>
  <para style="s">आखाम रोत वोडु कोडू?</para>
  <para style="r">(<ref loc="MAT 18:1-5">मत्तय 18:1-5</ref>; <ref loc="LUK 9:46-48">लुक 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />ताहराअ ते कफर्णहुमोमेहें आया; आन कोअमेहें तिये तियांहां फुशो, “वाटे तुमू किहाअ बाप्तिमेहें गोठी कोअत्ला तेरा?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />ते ठावकाज रोया, काहाके वाटे तियां ए गोठी कोअयीते के आपा मेहें वोडू कोडू होय.<note caller="+" style="f"><char style="fr" closed="false">9:34 </char><char style="ft" closed="false">लुक 22:24</char></note> <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />ताहरुउ ईसु बोहीत कोइत आन बारा जोओंहों हादीत कोइत तियांहां कोयो, “जर एखू वोडू बोणनारु ओय, ताहां तो आखाम रोत हानू आन आखाआ सेवक बोणुहूं जोवे.”<note caller="+" style="f"><char style="fr" closed="false">9:35 </char><char style="ft" closed="false">मत्तय 20:26,27;23:11; मार्क 10:43-44; लुक22:26</char></note> <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />आन तिये एका पोर्‍याहा लेत कोइत तियांआं विसमेहें उबो कोअयो, आन तियाहा बोदाम लेत कोइत तियांहां कोयो, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“जो एखू माआं नावसे यां पोर्‍या मेर्‍याआ कोडा एकाहा बी स्विकार कोअहे, तो माहूं स्विकार कोअहे; आन जो कोडो माहूं स्विकार कोअहे, तो माहूं नाहां, पोन माहूं मोकलिइनाराहा स्विकार कोअहे.”<note caller="+" style="f"><char style="fr" closed="false">9:37 </char><char style="ft" closed="false">मत्तय10:40; लुक 10:16; योहान13:20</char></note><verse eid="MRK 9:37" /></para>
  <para style="s">जो आपाआ विरुद्दाम नाहां, तो आपाअ वोलेहे होय</para>
  <para style="r">(<ref loc="LUK 9:49">लुक 9:49</ref>,<ref loc="LUK 9:50">50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />ताहरुउ योहान ईसुहू कोयो, “गुरु, आमू एका माहुंहूं ताआ नावो वाअहीं पुतोअ आत्माहां काडत्लो देखल्यो आन आमू तियाहा मा काडीही कोल्यो, काहाके तो आपा मेर्‍योअ ने ओतो.”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />ईसु तियांहां कोयो, “तियाहा मा रुकहा; काहाके एहेलोह कोडोज नाहां जो माआं नावसे वोडे कामे कोए, आन मामार माहूं खाराब कोत सेके, <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />काहाके जो आपाआ विरुद्दाम नाहां, तो आपाअ वोलेहे होय.<note caller="+" style="f"><char style="fr" closed="false">9:40 </char><char style="ft" closed="false">मत्तय12:30; लुक11:23</char></note> <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />जो कोडो एक गिलास पाईं तुमुहूं याआ काजे पिवाडे के तुमू ख्रिस्ताआ होय, ताहां आंय तुमुहूं खोरीज कोहो के तियाआ फल तियाहा मिले.” <note caller="+" style="f"><char style="fr" closed="false">9:41 </char><char style="ft" closed="false">मत्तय 10:42 </char></note><verse eid="MRK 9:41" /></para>
  <para style="s">पापोअ काजे पारजाणो</para>
  <para style="r">(<ref loc="MAT 18:6-9">मत्तय 18:6-9</ref>; <ref loc="LUK 17:1">लुक 17:1</ref>,<ref loc="LUK 17:2">2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“मापोअ भरिवसू कोअनारा यां हानामेहें रोत एकाहा बी जों कोडो भरिवसू सोड़ावे, ताहां तियाआ गोलामेहें एकी वोडी कोअटीइ पुड़ बांदीत तियाहा दोर्‍यामेहें टाकी देद्ले तियाआ काजे हाजो आवे. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />जर ताआ आथ ताहूं विश्वास सोड़ावे, ताहां तियाहा वाडीत टाक. बेन आथ ओत नरकाआ आगीमेहें जाअलोअ या रोत जी ठुटो बोणीत हादाजल्म्याआं जिवनोमेहें जाअलोअ हाजो होय. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" /><note caller="+" style="f"><char style="fr" closed="false">9:44 </char><char style="ft" closed="false">थोड़हा लेख्यामेहें ओं वसन नाहां जोड़तो.</char></note>जिहीं तियाआ किडू नाहां मोअतु, आन आग केदिहींज नाहां उलाअती. <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />जर ताआ गुडू ताआ विश्वास सोड़ावे, ताहां तियाहा वाडीत टाक! बेनु गुडा ओत नरकाआ आगीमेहें जाअलोअ, या रोत जी लेंगडू ओत हादाजल्म्याआं जिवनोमेहें जाअलोअ ताआ काजे हाजो होय. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" /><note caller="+" style="f"><char style="fr" closed="false">9:46 </char><char style="ft" closed="false">ओं वसन थोड़हा लेख्यामेहें नाहां जोड़तो</char></note>जिहीं तियाआ किड़ू नाहां मोअतु, आन आग केदिहींज नाहां उलाअती. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />जर ताआ डोऊ ताआ विश्वास सोड़ावे, ताहां तियाहा काडीत टाक! बेनु डोआ ओत बी नरकाआ आगीमेहें जाअलोअ, या रोत जी एक डोऊ लेत कोइत देवोअ राजोमेहें जाअलोअ ताआ काजे हाजो होय. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" /><note caller="+" style="f"><char style="fr" closed="false">9:48 </char><char style="ft" closed="false">यशया 66:24</char></note>जिहीं तियाआ किड़ू नाहां मोअतु, आन आग केदिहींज नाहां उलाअती.<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />“काहाके जेहें कोइत देवोहो आपिइलोअ गाराहा खारा वाअहीं सोको कोअतेहे, तेहें कोइत हारेक जोओं आगी वाअहीं सोको ओवे.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />“खारो ते हाजो होय; पोन जर खाराआ सव जाती रोयी, ताहां तियाहा किहा वाअहीं खारसो कोइत सेकहा?</para>
  <para style="p" vid="MRK 9:50">“तुमाआं विसमेहें खाराआ होस सव मिका, आन एकमेकाअरी होकेहे रोवा.”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">सोडले ओवीइलोअ बाप्तिमेहें ईसुउ हिकवोण</para>
  <para style="r">(<ref loc="MAT 19:1-12">मत्तय 19:1-12</ref>; <ref loc="LUK 16:18">लुक 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />फाश्यू ईसु तिहीं रोत उठीत यहुदीया हिवेंमेहें आन यारदेन खाडीइ तियी वोग आवयू. गर्दी फाश्यीइ तियाआ जागे टोलू वोल्यी, आन तो तियाआ रितीइ पुरमाणे तियांहां फाशुउ हिकवोण आपू वोल्यू.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />ताहां कायदाआ मास्तरहों जे फरिसी तियाआ जागे आवित तियाहा पारजाणीइलोअ काजे तियाहा फुशो, “केहें ओं कायदाअ पुरमाणे बोराबर होय के माटी तियाआ लाडीही सोडे?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />ईसु तियांहां उत्तर आप्यो, “मोशे तुमुहूं कि आदेश आप्युतो?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />तियां कोयो, “मोशे सोड़सिट्टी लेखीइलोअ आन सोड़ीइलोअ आदेश आप्युहू.” <note caller="+" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="EXO 24:1-4">निर्ग 24:1-4</ref>; <ref loc="MAT 5:31">मत्तय 5:31</ref> </char></note><verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />ईसु तियांहां कोयो, “तुमाआं वातड़ा मोनोअ वाखरी तिये तुमाआं काजे ओ आदेश लेख्यू. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />पोन वसनोमेहें लेख्योहो, कोलीइ सुरुवातीहीज रोत देवे माटी आन बोईं कोत तियांहां बोणायेहे.<note caller="+" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">उत्प 1:27</ref>; <ref loc="GEN 5:2">5:2</ref> </char></note> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />तियाहा काजे माअहुंउं तियाआ आयहीन आब्हाअहीं रोत आंगे ओत कोइत तियाआ लाडीइरी रोय, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />आन तें बेनू एक जिव ओवे; तियाहा काजे तें ओमे बेन नाहां, पोन एक डिल होय. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />तियाहा काजे जियांहां देवे जुड़्येहे, तियांहां माअहुंउं अलग ने कोअहूं जोवे,”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />जाहां ते कोअमेहें गोया, ताहां सेला ईसुहू यी गोठीइ बाप्तिमेहें फाश्यो फुशो. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />तिये तियांहां कोयो, “जो माटी तियाआ लाडीही सोड़ी देत बिहीरी बोईंइरी वेहवाल कोअहे, तो तियाआ पेल्लीइ लाडीइ विरुध्दामेहें सिनालो कोअहे; <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />आन जर बोयोंअ बी तियीइ माट्योहो सोड़ीत बिहीरा माट्योअरी वेहवाल कोअहे, ते बी सिनालो कोअहे.” <note caller="+" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="MAT 5:32">मत्तय 5:32</ref>; <ref loc="1CO 7:10">1 करिन्थ 7:10</ref>,<ref loc="1CO 7:11">11</ref> </char></note><verse eid="MRK 10:12" /></para>
  <para style="s">ईसु हाना पोर्‍याहां आशिर्वाद आप्यू</para>
  <para style="r">(<ref loc="MAT 19:13-15">मत्तय 19:13-15</ref>; <ref loc="LUK 18:15-17">लुक 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />ताहरेए माअहें पोर्‍याहां ईसुउ जागे लेतावे वोल्ये के तो तियांपोअ आथ मिकीत सेके, पोन सेला तियांहां बावराअया. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />ओं पालित ईसुहू खोत लागी आन तिये तियांहां कोयो, “पोर्‍याहां माआं जागे आवुहूं द्या, आन तियांहां मा रुकहा, काहाके देवोअ राज एहेलाआं काजेज होये. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />आंय तुमुहूं खोरीज कोहो के जो कोडो देवोअ राजोहो पोर्‍याअ होस स्विकार ने कोए, तों तिहींमेहें केदिहींज ने जात सेकनारो.”<note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">मत्तय 18:3</ref></char></note> <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />आन तिये पोर्‍याहां बोदाम लेदे, आन तियांपोअ आथ मिकीत कोइत तियांहां आशिर्वाद आप्यू.<verse eid="MRK 10:16" /></para>
  <para style="s">कुन्बी माहुंउं</para>
  <para style="r">(<ref loc="MAT 19:16-30">मत्तय 19:16-30</ref>; <ref loc="LUK 18:18-30">लुक 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />जेहेलाम ईसु तिहीं रोत निहीत कोइत वाटे जातुतो, ताहरोअ एक माअहुंउं तियाआ जागे गुगदीइतोज आयो, आन तियाआ आगाड़ी मांड्या पोड़ीत कोइत तियाहा फुशो, “आखाम रोत हाजा गुरु, हादाजल्म्योंअ जिवन मिलवीलाअ काजे आंय कि कोओ?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />ईसु तियाहा कोयो, “तू माहूं आखाम रोत हाजू काहा कोहे? निस्त देवो सिवाय कोडोज आखाम रोत हाजो कायनाहां. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />ताहूं आदेश ते मुंदू होये: ‘खुन मा कोअही, सिनालो मा कोअही, सोरी मा कोअही, ठोगोअ पुरावू मा देही, मा ठोगही, ताआ आयहीन आब्हाअ मानपान मिकजी.’”<note caller="+" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">निर्ग 20:12-16</ref>; <ref loc="DEU 5:16-20">कायदा 5:16-20</ref></char></note><verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />तिये ईसुहू कोयो, “गुरु, हानू तोयोंअ आंय यां हुकुमोंहों मानतु आयुहू.”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />ईसु तियापोअ नजर टाकीत कोइत तियाहा मेर कोअयी, आन तियाहा कोयो, “तामेहें एकी गोठीइ कमी होय. जा, जों किबी ताआ होय, तियाहा वेसीत कोइत गोरब्योहों आपी दे, आन ताहूं होरगामेहें मालधन जोड़े, आन आवित कोइत माआं फासाड़ी साल.” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />यी गोठी वाअहीं तियाआ सेहरापोअ नाराजी आवित लागी, आन तो दुखी ओत कोइत जातु रोयू, काहाके तो जास्ती मालदार ओतू.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />ईसु शारी मेरे पालीत कोइत तियाआ सेलाहां कोयो, “कुन्बीइ काजे देवोअ राजोम जाअलो केहेलोहो कठीण होय!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />सेला तियाआ गोठी वाअहीं बोगलाइत गोया. पोन ईसु तियांहां फाशुउ कोयो, “माआं पोर्‍या, तियाआ काजे देवोअ राजोम जाअलोअ केतोहो कठीण होय! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />कुन्बीइ देवोअ राजोम जाअलो तिया रोत उटड़ाहा हुयीइ डुसाम सरकीइलो सोपो होय.”<figure style="fig" alt="Merchant leading a camel outside a city wall and gate" file="HK00041C.TIF" size="col" copy="Horace Knowles ©" ref="10:25">होयरोमेहें आन होयरोअ बाअथे लाट्यू उटड़ाहा देखाड़ेहे</figure><verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />ते जाअखाज बोगलाइत कोइत तियां तियांआंज कोना वोल्या, “ताहरोअ कोडो वासाइत सेकेहे?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />ईसु तियांअहें पालीत कोइत कोयो, “ओं माअहूं वाअहीं नाहां ओत सेकतो, पोन देवो वाअहीं ओत सेकेहे; काहाके देवो वाअहीं आखोज ओत सेकेहे.”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />पेत्र तियांहां कोनु वोल्यू, “पाल आमू आखो बादो सोड़ीत कोइत ताआ फासाड़ी आयाहा.”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />ईसु कोयो, “आंय तुमुहूं खोरीज कोहो, एहेलोह कोडोज नाहां जो माआं हाजी बातमीइं काजे कोअ नेत पाव्हीइलाहां नेत आयहीन-आब्हाहा नेत बालबासाहां सोड़ी देदो ओय, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />आन या‍ं सेलवार्‍याअ दिहोमेहें हौ पोट जोड़े, आन कोअ, पाव्हीइले आन आयहीन-आब्हू आन बालबासे आन खेतोमेहें, पोन तारास कोइत आन आवानारां दिहोम हादाजल्म्योंअ जिवन जोड़े. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />पोन वारुज जोएं जे पेल्लेए होय, तें सेलवार्‍येए ओवे; आन जे सेलवार्‍येए होय, तें पेल्लेए ओवे.”<note caller="+" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्तय 20:16</ref>; <ref loc="LUK 13:30">लुक 13:30</ref> </char></note><verse eid="MRK 10:31" /></para>
  <para style="s">ईसु सोताआ मोतोअ बाप्ति मेहें तिसरी भविश्यवाणी कोअत्लू</para>
  <para style="r">(<ref loc="MAT 20:17-19">मत्तय 20:17-19</ref>; <ref loc="LUK 18:31-34">लुक 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />ते येरुसालेमोमेहें जात्ला तेहेलामेहें वाटे ओता, आन ईसु तियांआं आगाड़ी आगाड़ी जातुतो, सेला काबराईत गोयाते आन जे तियाआ फासाड़ी फासाड़ी जाताते ते बित गोयाते. तेहेलाम तो फाशुउ तियां बारु सेलाहां आलांग लेत जात कोइत तियांहां ते गोठी कोतापू वोल्यू, जे तिया पोअ आवनारी ओती, <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />“पाला, आपू येरुसालेमोमेहें जाताहा, आन माहुंउं बेटुह्हू मुख्य पुंजाराआ आन कायदाआ मास्तरहोंअ आथोम तोइत आपाय, आन ते तियाहा दोशी ठरवे, आन बिगर यहुदी माअहोंओं आथोम होपी देय. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />ते तियाआ मोज्या लेये, तियापोअ थुपे, आन तियाहा सापका मारु देये आन तियाहा माईंत टाकी देय, पोन तीन दिहोम तो जिवीत उठे.”<verse eid="MRK 10:34" /></para>
  <para style="s">याकोब आन योहानोअ रावणी</para>
  <para style="r">(<ref loc="MAT 20:20-28">मत्तय 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />तेहेलाम जब्दीइ पोर्‍या याकोब आन योहान तियाआ जागे आवित कोइत कोयो, “गुरु, आमाआं इश्शा होय, के जो किबी आमू मागुहूं, तो तू आमाआं काजे कोअहूं जोवे.”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />ईसु तियांहां कोयो, “तुमाआं कि इश्शा होय के आंय तुमाआं काजे कोओ?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />तियां तियाहा कोयो, “आमुहूं ओं आपे के ताआ महिमामेहें आमामेर्‍युउ एक जोओं ताआ हाजाड़्यीइ वोले आन एक जोओं बांगाड़्यीइ वोल बोहे.”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />ईसु तियांहां कोयो, “तुमुहूं नाहां मुंदू के तुमू कि मागताहा? जो वाटकू आंय पीइहूं होय, केहें तुमू पीत सेकताहा? आन जो बाप्तिस्मा आंय लेएहूं होय, केहें तुमू लेत सेकताहा?”<note caller="+" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">लुक 12:50</ref></char></note><verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />तियां ईसुहू कोयो, “आमा वाअहीं ओत सेकेहे.” ईसु तियांहां कोयो, “जो वाटकू आंय पीइहूं होय, तुमू पीत सेकहा; आन जो बाप्तिस्मा आंय लेएहूं होय, तियाहा लेत सेकहा. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />पोन देवे जियांआं काजे तियार कोअयुहू, तियांहां सोड़ीत कोइत बिहीरा कोडाहाज तियाआ हाजाड़्यी वोल आन तियाआ बांगाड़्यी वोल बोहाड़ीलोअ माआं काम कायनाहां.”<note caller="+" style="f"><char style="fr" closed="false">10:40 </char><char style="ft" closed="false">नेते तियाआ हाजली वोल आन बांगाड़्यी वोल कोडाहा बोहाड़ीइलो माआं काम नाहां, पोन जियांआं काजे तियार कोआयुहू तियांआंज काजे होय. </char></note><verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />ओं उनाइत कोइत तियां दोहू सेलाहां याकोब आन योहान पोअ खोत लागी. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />ताहरुउ ईसु तियांहां आहने हादीत कोयो, “तुमुहूं मुंदू होय के जे बिगर यहुदीइ पुडारी समजीइताहा, ते तियांपोअ राज सालाड़ताहा; आन तियांमेर्‍येए जे वोडा होय, ते तियांपोअ आधिकार वापरीइताहा. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />पोन तुमामेहें एहेलोहो कायनाहां, आन जो कोडो तुमामेहें वोडो बोणनारो ओय तों तुमाआं सेवक बोणुहूं जोवे;<note caller="+" style="x"><char style="xo" closed="false">10:43 </char><char style="xt" closed="false"><ref loc="MAT 23:11">मत्तय 23:11</ref>; <ref loc="MRK 9:35">मार्क 9:35</ref>; <ref loc="LUK 22:26">लुक 22:26</ref></char></note> <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />आन जो कोडो तुमामेहें मुख्य बोणनारो ओय, तों आखाआज पावर बोणे. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />काहाके माहुंउं बेटुह्हू याअकाजे नाहां आयू के, तियाआ सेवा कोअहूं जोवे, पोन याअकाजे आयुहू के सोताहा सेवा कोए, आन जाअखीलाहा जोओंअ सुटकाअ काजे तियाआ जिव आपित सेके.”<verse eid="MRK 10:45" /></para>
  <para style="s">आंद्ला बार्तीमायोहो ईसुउ नजरदान</para>
  <para style="r">(<ref loc="MAT 20:29-34">मत्तय 20:29-34</ref>; <ref loc="LUK 18:35-43">लुक 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />ते यरीहो गांवोंमेहें आया, ताहां ईसु आन तियाआ सेला, आन एक वोडी गोरदी यरीहोम रोत निहींतीते, ताहां तिमायाआ पोर्‍यू बार्तीमय, एक आंदलु भिखारी, सडकेए मेरे बोठुतो. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />तो ओं उनाइत कोइत के ईसु नासरेथकर होय, आअड़ी आअड़ीइ कोनु वोल्यू, “ए दाविदोअ पोर्‍या, ईसु मा पोअ दया कोओ!”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />जाअखीलेहे जोएं तियाहा बावराअये के ठावकुज रोय, पोन तो जाअखुज आअड़ू वोल्यू, “ए दाविदोअ पोर्‍या, मापोअ दया कोअ.”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />ताहरुउ ईसु उबू रोयू आन कोयो, “तियाहा हादा.”</para>
  <para style="p" vid="MRK 10:49">ताहरेए माअहें तिया आंदलाहा हादीत कोइत कोयो, “हिम्मत राख! उठ! ईसु ताहूं हादेहे.”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />तो तियाआ साअको टाकीत कोइत मामार उठीत उबू रोयू, आन ईसुउ जागे आयू.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />ईसु तियाहा कोयो, “ताआ कि इश्शा होय के आंय ताआ काजे कोअ?”</para>
  <para style="p" vid="MRK 10:51">आंदले तियाहा कोयो, “गुरु, आंय फाशुउ देखीत सेको.”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />ईसु तियाहा कोयो, “जातु रो, ताआ विश्वासे ताहूं हाजू कोइ देदुहू.”</para>
  <para style="p" vid="MRK 10:52">तो ताब्बुड़ पालु वोल्यू, आन सडके पोअ ईसुउ फासाड़ी जानु वोल्यू.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">येरुसालेमोमेहें विजयी प्रवेश</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्तय 21:1-11</ref>; <ref loc="LUK 19:28-40">लुक 19:28-40</ref>; <ref loc="JHN 12:12-19">योहान 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />जेहेलाम ते येरुसालेम होयरोअ आहने, जेयतुन डोगो पोअ बेथफागे आन बेथानीयाआ जागे आया ताहां तिये तियाआ सेला मेर्‍याआ बेन जोओंहों ओं कोत कोइत मोकल्या, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />आन तियांहां ओ आदेश आपित मोकल्‍या, “हुंबर्‍याआ गांवोंमेहें जावा, आन तिहीं पोत्ताज वाआ एक गोदडीइ बासो, जिया पोअ कोडोज नाहां बोठो, बांदीत मिकल्यो तुमुहूं मिले. तियाहा सोड़ीत कोइत लेतावा. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />जर तुमुहूं एखो फुसे, ‘ओं काहा कोअताहा?’ ताहां कोजा, मालख्योहो याअ गरज होय, आन तो तियाहा मामार इंहीं लेत मोकली देये.”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />ते जात कोइत तिया गोदडीइ बासाहा बारथे बाओअ सामने खोली मेहें बांदीत मिकल्यो देख्यो, आन सोड़ा वोल्या. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />तिहीं ऊबा रोनारा मेर्‍याअमेहें रोत थोड़ेक कोने वोल्ये, “ओं कि कोअताहा, गोदडीइ बासाहा काहा सोडताहा?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />जेहलोहो ईसु कोयोतो, तेहेंज कोइत तियांहां कोत देदो; ताहरेए माअहें तियांहां जाअहूं देदा. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />ते गोदडीइ बासाहा ईसुउ जागे लेतावीत कोइत तिया पोअ तियांआं आंगड़े आथर्‍ये, आन तो तिया पोअ बोहीत गोयू. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />ताहरेए जाअखीलेहे माअहें तियांआं आंगड़े वाटे पोअ आथर्‍ये आन बिहरे माअहें खेतोमेहें जात कोइत डाले वाडी वाडीइ वाटे पोअ आथरी देदे. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />आन जे तियाआ आगाड़ी आगाड़ी सालते आन फासाड़ी फासाड़ी सालित आवतेते, आअड़ी आअड़ीइ कोतेज जातेते, “होसान्ना! धन्य होय जो मालख्योअ नावसे आवेहे.<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">भजन 118:26</char></note> <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />आपाअ बाह्हा दाविदोअ राज जो आवेहे; धन्य होय! होरगा मेहें होसान्ना!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />ईसु येरुसालेमोमेहें पोतीत कोइत मंदिरो मेहें आयू, आन शारु खुणा आखो बिडारो पालीत कोइत बारा सेलाअरी बेथानी गोयू, काहाके वेल पोड़ीत गोयीते.<verse eid="MRK 11:11" /></para>
  <para style="s">अंजिरोअ साड़ोहो हाराप</para>
  <para style="r">(<ref loc="MAT 21:18-19">मत्तय 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />बिहरे दिहे जेहेलाम ईसु आन तियाआ सेला बेथानी रोत आवताते, ताहां ईसुहू फुक लागी. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />ताहां तिये सेटेज रोत एक अंजिरोअ साड़ निलो निलोज देखीत कोइत आहने गोयू: पोन तिहीं तियाहा पालाआ सिवाय किज नाहां जोड़्यो; काहाके ते वेल फलवाआ कायने ओती. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />ईसु तिया साड़ोहो कोयो, “आज रोत ताआ फल कोडोज केदिहीं ने खाय!”</para>
  <para style="p" vid="MRK 11:14">आन तियाआ सेला ओं उनाअताते.<verse eid="MRK 11:14" /></para>
  <para style="s">ईसुउ मंदिरोमेहें जाअलोअ</para>
  <para style="r">(<ref loc="MAT 21:12-27">मत्तय 21:12-27</ref>; <ref loc="LUK 19:45-48">लुक 19:45-48</ref>; <ref loc="JHN 2:13-22">योहान 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />ताहरुउ ईसु आन तियाआ सेला येरुसालेम मेहें आया. आन तो मंदिरोम गोयू; आन जे लेएलो-वेसीइलो वेवारो कोअया कोअताते तियांहां बारथे काडू वोल्‍यू, आन पोशा बोदलीत कोइत आपनारा आन पेरवे वेसनाराआ कुर्सी उलटावित टाक्यी. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />आन मंदिरोम रोत कोडाहाज सामान लेत कोइत आवुहूं जाअहूं ने देदे. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />आन ईसु तियांहां सिकाडू वोल्यू, “माआं कोअ आखी कोलीइ माअहुंउं काजे प्रार्थना कोओ कोवाय, एहेलोह वसनोमेहें नाहां लेख्यो के? पोन तुमू तियाहा बांडोअ कुपू बोणावी देदू.”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />ओं उनाइत कोइत मुख्य पुंजारु आन कायदाअ मास्तरहों तियाहा माईलाआ कोअते कदर काडा वोल्या; काहाके ते तियाहा बिताते याअ काजे के आखे माअहें तियाआ हिकवणो वाअहीं खुस ओवतेते.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />सिंजिवड़ो पोड़ताज ईसु आन तियाआ सेला सेहरोअ बारथे जाता रोया.<verse eid="MRK 11:19" /></para>
  <para style="s">उगाअला अंजिरोअ साड़ोअ हिकवोण</para>
  <para style="r">(<ref loc="MAT 21:20-22">मत्तय 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />ताहराअ बिहरे दिहे वेगीइ ईसु आन तियाआ सेला तियीज वाटे रोत जाताते, ताहां तियां तिया अंजिरोअ साड़ोहो मुलम रोत ऊगाअलो देख्यो. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />पेत्राहा ते गोठ ओर आयी, तिये ईसुहू कोयो, “गुरु, पाल! ओं अंजिरोअ साड़ जियाहा तुमे हाराप आप्यू तों उगात गोयोहो.”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />ईसु तियांहां उत्तर आप्यो, “देवो पोअ विश्वास मिका. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />आंय तुमुहूं खोरीज कोहो के जो कोडो या डोगोहो कोये, ‘तू उपटित जा, आन दोर्‍या मेहें जात पोड़,’ आन तियाआ मोनो मेहें सौंसू ने कोए, पोन भरिवसू कोए के जो कोहो तो ओत जाय, ताहां तियाआ काजे तोज ओवे.<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">मत्तय 17:20; 1कुरिन्थी13:2</char></note> <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />तियाहा काजे आंय तुमुहूं कोहो, के जो किबी तुमू प्रार्थना कोइत मागहा, ताहां विश्वास कोइत लेजा के तुमुहूं जोड़ीत गोयो, आन तुमुहूं जोड़ीत जाय. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />आन जेहेलाम तुमू प्रार्थनाआं कोअते उबे रोहा, ताहां तुमाआं मोनो मेहें काविंहीं विरोध जर एकदाआ बाप्तिमेहें ओय, ताहां माफ कोआ: याअकाजे के तुमाआं होरगामेर्‍युउ देव बाह्हू बी तुमाआं पाप माफ कोए. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />आन जर तुमू माफ ने कोअहा ताहां तुमाआं देव बाह्हू बी जो होरगामेहें होय, तुमाआं पाप माफ ने कोए.”<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">ओं वसन थोड़हा लेख्यामेहें नाहां जोड़तो</char></note><verse eid="MRK 11:26" /></para>
  <para style="s">ईसुउ आधिकारोपोअ प्रश्न</para>
  <para style="r">(<ref loc="MAT 21:23-27">मत्तय 21:23-27</ref>; <ref loc="LUK 20:1-8">लुक 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />ते फाश्याआ येरुसालेम मेहें आया, आन ईसु मंदिरोम फिर्‍या कोअतुतो ताहां मुख्य पुंजारु आन कायदाअ मास्तरहों आन डायहां तियाआ जागे आवित कोइत फुसा वोल्या, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />“तू एं कामे कोड्ला आधिकार वाअहीं कोअहे? आन ओ आधिकार ताहूं कोडे आपल्यु के तू एं कामे कोए?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />ईसु तियांहां कोयो, “आंय तुमुहूं एक गोठ फुसोहो; माहूं उत्तर आपा, ताहरुउ आंय तुमुहूं कोहीं के एं कामे कोड्ला आधिकार वाअहीं कोअहो. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />योहानोअ बाप्तिस्मा कांय होरगाम रोत ओतू के माअहूंअहें रोत ओतू? माहूं उत्तर आपा.”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />ताहराअ ते तियां तियांआंज गोठी कोआ वोल्या के “जर आपू कोहूं ‘होरगाअहें रोते,’ ताहां तो कोये, ‘ताहराअ तुमू तिया पोअ भरिवसू काहा नाहां मिक्यू?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />आन जर आपू कोहूं, ‘माअहूंअहें रोते’ ताहां माअहुंउं बिक होय, काहाके आखाहा मुंदू होय के योहान खोराखर भविश्यवक्ता ओतू.” <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />ताहां तियां ईसुहू कोयो, “आमुहूं ने मुंदू.”</para>
  <para style="p" vid="MRK 11:33">ईसु तियांहां कोयो, “आंय बी तुमुहूं ने कोनारु के एं कामे कोड्ला आधिकारो वाअहीं कोअहो.”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">दाराक्शाआ मोलाआ जागल्याआ काईं</para>
  <para style="r">(<ref loc="MAT 21:33-46">मत्तय 21:33-46</ref>; <ref loc="LUK 20:9-19">लुक 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />ताहरुउ ईसु काईं वाअहीं तियांअरी गोठी कोउ वोल्यू: “एके माअहें दाराक्शाआ मोलु लागाड़्यु, आन तिया मोलाआ मेरेमेरे वाड़ बांद्यी, आन दाराक्शाआ रोहोअ खाण खुंअयी, आन मालू बोणावयू; आन जागल्याहा ठेकू आपित कोइत पोरदेस जातु रोयू. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />आन जाहां दाराक्शे तोड़ीइलोअ वेल आयी, ताहां तिये एका पावरोहो तियां जागल्‍याआ जागे फलवाअ इसु लेत आवे तेहें मोकल्यू. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />पोन तियां तिया पावरोहो तोइत कोइत बोहाट्यू आन ठाल्ले आथेज मोकली देदू. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />फाशुउ तिये एका पावरोहो तियांआं जागे मोकल्यू; पोन तियां तियाआ बी मुन्को फोड़ीत टाक्यो आन तियाआ अपमान कोअयू. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />मालख्ये फाशुउ एका पावरोहो मोकल्‍यू; पोन तियां तियाहा माईंत टाकी देदू. ताहां तिये फाशाआ जाअखा जोअहों मोकल्या; तियांमेर्‍याअ तियां थोड़ाक जोअहों बोहाट्या, आन थोड़ाक जोअहों माईंत टाक्या. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />ओमे एकुज जोओं उगर्‍युतो, जो तियाआ मेरालू पोर्‍यू ओतू; आखरी पोअ तिये तियाहा बी तियांआं जागे ओं समजीत कोइत मोकल्यू के ते माआं पोर्‍याआ मानपान मिके. <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />पोन ते जागल्या तियां तियांआंज गोठी कोअयी, ओते वारीस होय; साला, आपू याहा माईंत टाकी देहूं, ताहां जागू आपाअ ओत जाय. <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />आन तियां तियाहा तोइत कोइत माईंत टाक्यु, आन तिया तोड़ोहो दाराक्शाआ मोलाआ बारथे उडाड़ी देदो.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />“तियाहा काजे दाराक्शाआ मोलाआ मालिख कि कोए? तो आवित कोइत तियां जागल्याहा माइत टाके, आन दाराक्शाआ मोलु बिहीराहा आपी देय. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />केहें तुमू वसनोमेहें ओं नाहां वाशो के?</para>
  <para style="q1" vid="MRK 12:10">“‘जिया डोणोहों राजमिस्त्र्यां बिगर कामोअ ठरव्युतो,</para>
  <para style="q2" vid="MRK 12:10">तोज कोपराआ खास कामोअ डोण बोण्यु.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />ओं प्रभुउ तरफ से ओवो,</para>
  <para style="q2" vid="MRK 12:11">आन आमाआं नजरेम जुदो बाहरी होये!’”<note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="PSA 118:23">भजन 118:23</ref></char></note><verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />ताहराअ यहुदी पुढार्‍यों तियाहा तोइलाअ कोअयू; काहाके तियांहां मुंदू पोड़ीत गोयू के ए काईं तिये तियांआं विरुद्धामेहें कोयीही. पोन ते माअहुंहूं बित गोया आन जाता रोया.<verse eid="MRK 12:12" /></para>
  <para style="s">फालू आपीइलोअ बाप्तिम प्रश्न</para>
  <para style="r">(<ref loc="MAT 22:15-22">मत्तय 22:15-22</ref>; <ref loc="LUK 20:20-26">लुक 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />ताहराअ ते ईसुहू गोठी मेहें फोसाड़ीइलोअ काजे थोड़ाक कायदाअ मास्तरहों जे फरिसी आन हेरोदोअ पार्ठीइ माट्योहों तियाआ जागे मोकल्या. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />ते तियाआ जागे आवया आन कोयो, “गुरु, आमुहूं मुंदू होय के तू खोरो कोत देखाड़ेहे; आन कोडाअ भेदभाव नाहां कोअतू, काहाके तू माअहोंअ सोब पालीत गोठी नाहां कोअतू पोन देवोअ वाट माअहोंहों बोराबर कोत आपेहे. ताहां आमुहूं को, केहें कैसरोहो फालू आपीइलो कायदाअ पुरमाणे बोराबर के सुकीइ? आमू तो आपीइलो के ने?”<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />पोन ईसु तियांआं ढोंगड़ा ओलखीत कोइत तियांहां कोयो, “माहूं काहा फारकिइताहा? एक सांदीइ आनो माआं जागे लेत आवा, के आंय तियाहा पालो.”<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />ते लेत आवया, आन तिये तियांहां कोयो, “ओ सापू आन नांव कोडाआ होय?”</para>
  <para style="p" vid="MRK 12:16">तियां कोयो, “कैसरोअ.”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />ईसु तियांहां कोयो, “जो कैसरोअ होय तो कैसरोहो आपा, आन जो देवोअ होय तो देवोहो आपा.”</para>
  <para style="p" vid="MRK 12:17">ताहां ते बोगलाइत गोया.<verse eid="MRK 12:17" /></para>
  <para style="s">मोतोमेहें रोत जिवित उठिइलाअ बाप्ति मेहें प्रश्‍न</para>
  <para style="r">(<ref loc="MAT 22:23-33">मत्तय 22:23-33</ref>; <ref loc="LUK 20:27-40">लुक 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />फाश्याआ थोड़ाक सादूकी, जे कोताहा के “मोतोम रोत जिवित उठिइलोअ होयज नाहां,” ईसुउ जागे आवित कोइत तियाहा फुशो, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“गुरु, मोशे आमांआं काजे लेख्योहो के ‘जर कोडाअ बी पाही बिगर पोर्‍यो ओवयेज मोइत जाय आन तियाआ लाडी जिवती रोय, ताहां मोअनाराआ पाही तियाआ लाडीइ आरी वेहवाल कोइत लेय आन तियाआ पायहोअ काजे पोर्‍ये उब्जाड़े.’ <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />हांत पाही ओता. पेल्लूउ पाही वेहवाल कोइत बिगर पोर्‍याआ मोइत गोयू. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />ताहां बिहरे पायहे तियी बोंईं आरी वेहवाल कोइत लेदो आन बिगर पोर्‍याआ मोइत गोयू; आन तेहेंज कोइत तिसरे बी कोअयो. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />आन बिहीरा आखा हांतू जोओंअ बी पोर्‍ये ने ओवये आन ते मोइत गोया. आखाआ फासाड़ी ते बोईं बी मोइत गोयी.” <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />पोन जाहां आखे मोतोम रोत जिवीत उठे, ताहां ते कोडाआ लाडी बोणे? काहाके तियी हांतू जोओंअ आरी वेहवाल कोअयोतो.<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />ईसु तियांहां कोयो, “तुमू केताहा सुकीइ होय! काहाके तुमुहूं वसन आन देवोअ सेक्ती नाहां मुंदू. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />काहाके जाहां ते मोतो मेहें रोत जिवित उठे, ताहां तें ने वेहवाल कोअनारे आन ने वेहवाल कोइत आपनारे, पोन होरगामेर्‍याआ देवदुतोअ होस रोये. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />मोअनाराअ जिवीत उठिइलाअ बाप्तिमेहें केहें तुमू मोशेए पुस्तकोम पेटाअत्ला साटवाआ काईं नाहां वाशी के, देव तियाहा कोयो, ‘आंय अब्राहामोअ देव, आन इसहाकोअ देव, आन याकोबोअ देव होय?’<note caller="+" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">निर्ग 3:6</ref> </char></note> <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />देव मोल्याआ नाहां पोन जिवताआ देव होय; तुमू खुब सुकताहा.”<verse eid="MRK 12:27" /></para>
  <para style="s">आखाम रोत वोडु आदेश</para>
  <para style="r">(<ref loc="MAT 22:34-40">मत्तय 22:34-40</ref>; <ref loc="LUK 10:25-28">लुक 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />एक कायदाअ मास्तर आवित कोइत तियांहां गोठी कोअत्ला उनाअयू, आन ओं फारकीत कोइत के ईसु तियांहां मोस्तेए उत्तर आप्यो, तियाहा फुशो, “आखाम रोत खास आदेश कोड्लू होय?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />ईसु तियाहा उत्तर आप्यो, “आखा आदेशोम रोत ओ खास होय: ‘ए इस्राएल उनाआ! प्रभु आपाअ देव एक्कुज प्रभु होय,’ <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />आन ‘तू प्रभु ताआ देवोपोअ पुरा मोनो वाअहीं, आन ताआ पुरा जिवो वाअहीं, आन ताआ पुरी बुद्दी वाअहीं, आन ताआ पुरी सेक्ती वाअहीं मेर कोअजी.’<note caller="+" style="x"><char style="xo" closed="false">12:30 </char><char style="xt" closed="false"><ref loc="DEU 6:4">कायदा 6:4</ref>,<ref loc="DEU 6:5">5</ref> </char></note> <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />आन बिहीरु आदेश ओ होय के, ‘तू ताआ आहने रोनारा पोअ ताआ हारकीज मेर कोअ.’<note caller="+" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लेवी 19:18</ref> </char></note> यापोअ रोत वोडू बिहीरु कोड्लूज आदेश कायनाहां.”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />कायदाअ मास्तर तियाहा कोयो, गुरु, खुब हाजो! तुमे खोरो कोयो, तो एक्कुज होय, आन तियाहा सोड़ीत कोइत बिहीरु कोड्लूज कायनाहां.<note caller="+" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="DEU 4:35">कायदा 4:35</ref> </char></note><verse eid="MRK 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 12:33" />आन तियापोअ पुरो मोन, पुरी बुद्दी, पुरु जिव आन पुरी ताकते वाअहीं मेर कोअजी; आन आहने रोनाराहा ताआज होस मेर कोअजी, ओं आखी भेटेए, आन गाराहा रोत वादार कामोअ होय.<note caller="+" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">होशे 6:6</ref> </char></note><verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />जाहां ईसु देख्यो के तिये समझदारी वाअहीं उत्तर आप्यो, ताहां तियाहा कोयो, “तू देवोअ राजोअ रोत सेटू कायनाहां.” आन ताअहां रोत कोडाहा फाश्यो तियाहा किज फुसीइलोअ हिम्मत ने ओवी.<verse eid="MRK 12:34" /></para>
  <para style="s">मसीहा बाप्तिमेहें प्रश्‍न</para>
  <para style="r">(<ref loc="MAT 22:41-46">मत्तय 22:41-46</ref>; <ref loc="LUK 20:41-44">लुक 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />फाश्यू ईसु मंदिरो मेहें सिकाड़त्लू तेहेलाम ओं कोयो, “कायदाअ मास्तर केहें कोइत कोताहा के ख्रिस्त दाविदोअ पोर्‍यू होय? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />दाविद तिया तियाआज पवित्र आत्मामेहें ओत कोइत कोयो:</para>
  <para style="q1" vid="MRK 12:36">“‘प्रभु माआं प्रभुहू कोयो:</para>
  <para style="q2" vid="MRK 12:36">जाअहूं जाआं आंय ताआ दुस्मोनोहों ताआ गुडाआ थुड़ी ने टाकी देंव</para>
  <para style="q2" vid="MRK 12:36">ताअहूं जाआं तु माआं हाजाड़ीइ वोग बोहो.’<note caller="+" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन 110:1</ref> </char></note><verse eid="MRK 12:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 12:37" />“दाविद ते सोताहा तियाहा प्रभु कोहे, ताहरुउ तो दाविदोअ पोर्‍यू कि कोइत बोण्यु?”</para>
  <para style="s" vid="MRK 12:37">कायदाअ मास्तरहों रोत सांबालित रोजा</para>
  <para style="r" vid="MRK 12:37">(<ref loc="MAT 23:1-36">मत्तय 23:1-36</ref>; <ref loc="LUK 20:45-47">लुक 20:45-47</ref>)</para>
  <para style="p" vid="MRK 12:37">आन गर्दी मेर्‍येए माअहें ईसुउ गोठी खुसी वाअहीं उनाअतेते. <verse eid="MRK 12:37" /><verse number="38" style="v" sid="MRK 12:38" />ताहां तिये तियाआ हिके मेहें तियांहां कोयो, “कायदाअ मास्तरहों रोत सांबालित रोजा, जे नांबा नांबा झगा पोवित फिरीइलो आन बाजारो मेहें सलाम, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />आन आराधनालयो मेहें मुख्य मुख्य कुर्सी आन पांगाती मेहें मुख्य मुख्य जागा बी होदताहा. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />ते रोंडाअली बोईंइ फायदू उठाडताहा आन तियींइं कोअ लुटीत लेताहा, आन देखाड़ीइलोअ काजे नांबी प्रार्थना कोअता रोताहा. याहां वादार डोंड मिले.”<verse eid="MRK 12:40" /></para>
  <para style="s">रोंडाअली बायीइ दान</para>
  <para style="r">(<ref loc="LUK 21:1-4">लुक 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />ईसु मंदिरोअ भेटेए पेटीइ सामने बोहीत कोइत पालतूतो के माअहें मंदिरोअ पेटी मेहें कि कोइत पोशा टाकतेहे; आन थोड़ाक कुन्ब्यों बी वारुज पोशा टाक्या. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />तेताजमेहें एक गरीब रोंडोअ बाय आवित कोइत बेन हाने तांबाआ आने <note caller="+" style="f"><char style="fr" closed="false">12:42 </char><char style="fq" closed="false">बेन हाने तांबाआ आने </char><char style="ft" closed="false">ग्रीक बाशामेहें हाना रुप्याहा “लेप्टोस” आन वोडा रुप्याहा “कोड्रांटेस” कोतेहे.</char></note>टाक्ये, मोन्ज्ये एका दिहोअ मोजरी रोत बी थोड़ो कोवाय. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />ताहां ईसु तियाआ सेलाहां आहने हादीत कोइत कोयो, “आंय तुमुहूं खोरीज कोहो, के यी रोंडोअ बायी आखाम रोत जाअखी भेट पेटीमेहें टाक्यीही. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />काहाके आखे तियांआं कामायीम रोत टाक्यो, पोन ए गरीब रोंडोअ बाय यीपोअ ओतो तेतो आखो टाकी देदो. जियापोअ यीइ जिवणो सालतोतो तों आखो यी आपी देदो.”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">मंदिर आरवाइलोअ ईसुउ भविश्यवाणी</para>
  <para style="r">(<ref loc="MAT 24:1">मत्तय 24:1</ref>,<ref loc="MAT 24:2">2</ref>; <ref loc="LUK 21:5">लुक 21:5</ref>,<ref loc="LUK 21:6">6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />जेहेलाम ईसु मंदिरोम रोत निहींत कोइत आवतुतो, तेहेलाम तियाआ सेलामेर्‍येए एके जोएं कोयो, “गुरुजी, पाल, केहेलाहा वोडा बी डोण आन केतीही वोडी आवाली होय!”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />ईसु तियाहा कोयो, “तुमू ए वोडी वोडी आवाली हेएताहा के? इंहीं डोणोपोअ डोण बी ने रोय, आखो ओदालित टाके.”<verse eid="MRK 13:2" /></para>
  <para style="s">अड़सन आन तारास</para>
  <para style="r">(<ref loc="MAT 24:3-14">मत्तय 24:3-14</ref>; <ref loc="LUK 21:7-19">लुक 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />जाहां ईसु जेयतुनोअ डोगोपोअ मंदिरोअ सामने बोठुतो, ताहां पेत्र, याकोब, योहान आन आंद्रियानेहें आंगेज जात कोइत तियाहा फुशो, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“आमुहूं को के ए गोठी कोयों ओवे? आन जेहेलाम ए आखी गोठी पुरी ओवुहूंज कोए तेहेलाम कि निशाणी रोय?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />ईसु तियांहां कोनु वोल्यू, “तुमुहूं कोडो ठोगुहूं ने जोवे, तियाहा काजे सांबालित रोवा. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />जाअखीलेहे माअहें माआं नावो वाअहीं आवित कोइत कोय, ‘आंय तोज होय!’ आन ते जाअखीला माअहोंहों ठोगी देय. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />आन जेहेलाम तुमू लड़ाय आन लड़ायीइ गोठी उनाअहा, तेहेलाम काबरात मा जाहा; काहाके ए गोठी ओवनारीज होय, पोन तेहेलाम सेवट ने ओवे. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />काहाके देसोपोअ देस आन राज्यापोअ राज्य लोड़ाय कोए. जागजागे भुकंप ओवे आन काल पोड़े. ओं ते पिड़ाआ सुरुवात रोय.<note caller="+" style="x"><char style="xo" closed="false">13:8 </char><char style="xt" closed="false"><ref loc="JER 6:24">यिर्म 6:24</ref></char></note><verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />“पोन तुमू सांबालित रोवा. काहाके माअहें तुमुहूं कोर्ठोम तोइत लेत जाय, आन तुमुहूं आराधनालयोअ सामने देय, आन माआं वाखरी तुमुहूं आधिकार्‍योअ आन राजहांआं सामने उबे कोए, एताआ काजे के तियांआं काजे साक्शी बोणुहूं जोवे. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />पोन आखरी ओवीइलोअ पेल पुरी दुन्‍यामेहें हाजी बातमीइं परसार ओवुहूं जोवे. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />जेहेलाम तें तुमुहूं लेत जात तोइत आपी देय, ताहां पेलूज रोत सिंता मा कोअहा के आमू कि कोहूं; पोन जों किबी तुमुहूं कोअलो ओय, तों तियीज वेले सुसना जोड़े तोंज कोजा; काहाके गोगनारे तुमू कायनाहां, पोन पवित्र आत्मा होय.<note caller="+" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">मत्तय 10:17-20</ref>; <ref loc="LUK 12:11">लुक 12:11</ref>,<ref loc="LUK 12:12">12</ref> </char></note> <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />पायहोहो पाही माईं देवाड़े, आन आब्हाहा बेटुह्हू माईंलाअ काजे तियाआ विरुद्दाम जाय, आन पोर्‍ये आयहीन-आब्हाअ विरुद्दाम उठीत कोइत तियांहां माआड़ी देय. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />आन माआं नावसे तुमुहूं आखे माअहें निंदा कोए; पोन जो आखरी जाआं खेटीत रोय, तोज वासाय.<note caller="+" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्तय 10:22</ref> </char></note><verse eid="MRK 13:13" /></para>
  <para style="s">वोडु संकट-काल</para>
  <para style="r">(<ref loc="MAT 24:15-28">मत्तय 24:15-28</ref>; <ref loc="LUK 21:20-24">लुक 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“कापारु सुटे एहेलिही खाराब वस्तु जिहीं ने जोवे तिहीं उबी रोल्‍यी तुमू पालहा, ‘वासनारो याअ अर्थ कि ओय तो समजीत लेअहूं जोवे,’<note caller="+" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दानि 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char></note> ताहां जो यहुदीयामेहें ओय तो डोगो पोअ जातो रोअहूं जोवे. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />जो कोओपोअ ओय, तो तियाआ उसे रोत काविंहीं आनो निसे ने उतरुहूं जोवे आन ने कोअमेहें जाअहूं जोवे; <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />आन जो खेतोम ओय, तो तियाआ साअकाआ काजे कोअ ने जाअहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="LUK 17:31">लुक 17:31</ref> </char></note> <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />तियां दिहोम जे उंगलित रोल्यी बायी आन बुजी खावाड़ती ओय, तियींइं काजे दुखोअ गोठ होय! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />आन देवोहो प्रार्थना कोआ के, ओं हियालाम ने ओवुहूं जोवे. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />काहाके ते दिही एहेलाहा तारासोअ रोय के कोलीइ सुरवाती रोत, जे देवे बोणावयीही, तोयोंअ रोत ते ओमे जाआं नाहां ओवो आन ने केदिहीं ओवे.<note caller="+" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DAN 12:1">दानि 12:1</ref>; <ref loc="REV 7:14">प्रगटी 7:14</ref> </char></note> <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />जर मालिख तियां दिहोहो ने कमी कोअतू, ताहां कोडोज ने वासाअतो; पोन तियां निवड़ीइल्या माअहोंअ काजे जियांहां तिये निवड़्येहे, तियां दिहोहो कमी कोअयाहा.<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />“तियां दिहोमेहें जर एखू तुमुहूं कोय, ‘पाला, ख्रिस्त इंहीं होय!’ नेते ‘पाला, तिहीं होय,’ ताहां भरिवसू मा कोअहा; <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />काहाके ख्रिस्तविरोधी आन ठोग भविश्यवक्ता उठे, आन निशाणी आन वोडे वोडे कामे कोइत देखाड़े के जर ओत सेके ताहां निवड़ीइल्याहां बी भटकाड़ी देय. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />पोन तुमू सांबालित रोजा; पाला, आंय तुमुहूं आखी गोठी पेलूज रोत कोतापी देदीही.<verse eid="MRK 13:23" /></para>
  <para style="s">माअहुंउं बेटाह्हाआ वापिस आविइलोअ</para>
  <para style="r">(<ref loc="MAT 24:29-31">मत्तय 24:29-31</ref>; <ref loc="LUK 21:25-28">लुक 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />“तियां दिहोमेहें, तिया तारासोअ फासाड़ी दिही आंदारावालू ओत जाय, आन सांद उजवड़ ने आपे;<note caller="+" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="ISA 13:10">यश 13:10</ref>; <ref loc="EZK 32:7">यहे 32:7</ref>; <ref loc="JOL 1">योएल</ref> </char></note> <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />आन जुगोम रोत तारा निसे टुटीत पोड़े; आन जुगोमेर्‍यीइ सेक्ती आलवाईत जाय.<note caller="+" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">यश 34:4</ref>; <ref loc="JOL 2:10">योएल 2:10</ref>; <ref loc="REV 6:13">प्रगटी 6:13</ref> </char></note> <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />ताहरेए माअहें माहुंउं बेटाह्हाहा वोडी सेक्ती आन महिमाआं आरी वाद्लामेहें आवत्लुज पाले.<note caller="+" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानि 7:13</ref>; <ref loc="REV 1:7">प्रगटी 1:7</ref> </char></note> <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />तियी होमसे तो तियाआ देवदुतोंहों मोकलीत कोइत, धरतीइ ये जोड़पे रोत जुगोअ तिये जोड़पे जाआं, शारी ओरी रोत देवोअ निवड़ीइल्या माअहुंहूं टोलू कोए.<verse eid="MRK 13:27" /></para>
  <para style="s">अंजिरोअ साड़ोप रोत शिक्शण</para>
  <para style="r">(<ref loc="MAT 24:32-35">मत्तय 24:32-35</ref>; <ref loc="LUK 21:29-33">लुक 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“अंजिरोअ साड़ोप रोत ओं सिकाआ: जेहेलाम तियाआ डालीही डिरा फुटताहा आन पालो निहीत्लो देखतेहे, तेहेलाम तुमुहूं उनालू आहने आयू एहेलोह समजाअहे. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />तेहेंज कोइत जेहेलाम ए गोठी ओवत्ली देखाय, ताहां जाईंत लेहा के ते वेल आहनेज होय नेताहां बाअणाज पोअ होय. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />आंय तुमुहूं खोरीज कोहो के जाअहूं जाआं ए गोठी ने पुरी ओवे ताअहूं जाआं ए पिढ़ी ने आरवाय. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />जुग आन धरती टोलीत जाय, पोन माआं गोठी केदिहींज ने टोले.<note caller="+" style="x"><char style="xo" closed="false">13:31 </char><char style="xt" closed="false"><ref loc="ISA 40:8">यश 40:8</ref>; <ref loc="LUK 21:33">लुक 21:33</ref></char></note><verse eid="MRK 13:31" /></para>
  <para style="s">ते वेल आन दिही कोडाहाज ने मुंदू</para>
  <para style="r">(<ref loc="MAT 24:36-44">मत्तय 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“तिया दिहोअ नेताहां तियी वेलेए बाप्तिम कोडाहाज नाहां मुंदू, ने होरगाआ देवदुतोंहों के ने बेटाह्हाहा; पोन आब्हाहा एतूज मुंदू होय. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />पाला, जागते रोवा आन प्रार्थना कोअते रोवा; काहाके तुमुहूं नाहां मुंदू के ते वेल कोयों आवे. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />ते वेल एहेलिही होय के, एखू माहुंउं दुर पोरदेस जाअली वेले कोअ सोड़ीत जाय आन तियाआ पावरोहो आधिकार आपे: आन आखाहा तियां तियांआं कामे वाटीत आपी देय, आन जागल्‍याहा जागतू रोय तेहें काजे आदेश आपे. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />तियाहा काजे जागते रोवा, काहाके तुमुहूं नाहां मुंदू के कोओअ मालिख केती वेले आवे, हांजे पोअ, नेत पोरापोर रातीही, नेत कुकड़ाआ वांहेंअरी, नेत वेगीइ. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />जर तो उसकाहीज आवे ताहां एहेलोह ने ओवुहूं जोवे के तुमू हुवत्लेज सापड़े. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />आन जो आंय तुमुहूं कोहो, तोज आखाहा कोहो: जागते रोवा!”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">ईसुहू तोइलाआ कदर</para>
  <para style="r">(<ref loc="MAT 26:1-5">मत्तय 26:1-5</ref>; <ref loc="LUK 22:1">लुक 22:1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">योहान 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />बेन दिहोअ फासाड़ी वल्हांडण आन बिगर खमीरोअ रोटाआ तिवार आवनारु ओतू.<note caller="+" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">निर्ग 12:1-27</ref> </char></note> डाया पुंजारा आन कायदाअ मास्तरहों यी गोठीइ फासाड़ी ओता के तियाहा कि कोइत सुकी वाअहीं तोइत माईंत टाको; <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />पोन ते कोताते, तिवारोअ दिही नाहां नेत एहेलोह ओत जाय के माअहें दोंगु कोए वोले.<verse eid="MRK 14:2" /></para>
  <para style="s">बेथानीमेहें ईसुहू तेल मालीस</para>
  <para style="r">(<ref loc="MAT 26:6-13">मत्तय 26:6-13</ref>; <ref loc="JHN 12:1-8">योहान 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />जेहेलाम ईसु बेथानी गांवोंम शिमोनोअहीं रोटू खानु बोठु, जो वोडा दुखोवालू ओतू, ताहां एक बाय मोगो अत्तर<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">अलाबास्त्राआ साड़ोअ बोणल्यो जाअखीलोहो मोगो सोको तेल, अत्तर</char></note> लेत कोइत आयी; आन संगमरमरोअ बासोन फोड़ीत कोइत तों अत्तर तियाआ मुंडीपोअ ओली देदो.<note caller="+" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37">लुक 7:37</ref>,<ref loc="LUK 7:38">38</ref> </char></note> <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />पोन तियांमेर्‍याआ थोड़ाक जोओंहों खोत लागी आन कोना वोल्या, “या मोगा तेलोहो एहलोज ओलीत टाकीइलो होबेहे के? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />काहाके ओं तेल ते तीन होव होनाआं आना रोत वादार मोगो वेसता आवतो आन ते पोशा गोरब्योहों वाटीत आपित सेकाअता.” आन ते तियाअरी टुटणा वोल्या.<figure style="fig" alt="Jars with spikenard" file="HK00117C.TIF" size="col" copy="Horace Knowles ©" ref="14:3">जटामांसीइ अत्तर मिकीइलोअ जेग</figure><verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />पोन ईसु कोयो, “तियीही सोड़ी द्या; तियीही काहा तारास देताहा? तियी तोम माआं आरी हाजो कोअयोहो. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />गरीब तुमाआं आरी सादाज रोतेहे, आन तुमू पोटे तेहेलाम तियांआं हाजो कोइत सेकताहा;<note caller="+" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">कायदा 15:11</ref> </char></note> पोन आंय तुमाआं आरी सादाज नाहां रोनारु. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />जो किबी तियीप रोत ओत सेको, तियी कोअयो; यी बायी माआं मोतोअ तियारी मेहें पेलूज रोत माआं डिलोपोअ अस्तर ओल्योहो. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />आंय तुमुहूं खोरीज कोहो, के आखी दुन्यामेहें जिहीं जिहीं हाजी बातमी परसार कोआय, तिहीं तियीइ या कामोअ सर्सा बी तियीइ ओरेए काजे कोआय.”<verse eid="MRK 14:9" /></para>
  <para style="s">यहुदाआ खाराब विश्वास</para>
  <para style="r">(<ref loc="MAT 26:14-16">मत्तय 26:14-16</ref>; <ref loc="LUK 22:3-6">लुक 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />ताहरुउ यहुदा इस्कार्योत जो बारा सेलामेएं एक ओतू, डाया पुंजाराआं जागे गोयू के ईसुहू तियांआं आथोम तोइत आपी देय. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />ते ओं उनाइत कोइत खुस ओत गोया, आन यहुदाहा पोशा आपिइलोअ आथवसन स्विकार कोअयो; आन तो वेल पालु वोल्यू के तियाहा किबी कोइत तोइत आपी देंव.<verse eid="MRK 14:11" /></para>
  <para style="s">सेलाअ आरी वल्हांडणोअ आखरीइ पांगात</para>
  <para style="r">(<ref loc="MAT 26:17-25">मत्तय 26:17-25</ref>; <ref loc="LUK 22:7-14">लुक 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">योहान 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />बिगर खमीरोअ रोटाअ तिवारोअ पेल्लेए दिही, जियामेहें ते वल्हांडणोअ बोकड़ाआ गाराहा आपतेते, तियाआ सेला तियाहा फुशो, “वल्हांडण खाअलाअ एहेलिही ताआ इश्शा का होय, के आमू जात कोइत ताआ काजे तियारी कोअ?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />ईसु तियाआ सेलामेर्‍याआ बेन जोअहों ओं कोत कोइत मोकल्या, “गांवोंम जावा, आन एक माहुंउं पांअयोंअ कुंडो आखलीत रोल्य तुमुहूं मिले, तियाआ फासाड़ी वाट लागजा; <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />आन तो जिया कोअमेहें जाय, तिया कोओ मालिखोहो कोजा, ‘गुरु कोहे के जिहीं माहूं माआं सेलाअ आरी वल्हांडण तिवारोअ रोटू बोणाविइलु एहेलिही पावणायीइ खुली का होय?’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />तो तुमुहूं एक होबाड़ल्यी, आन तियार कोअल्यी उसेए मालीपोर्‍यीइ खुली देखाडे, तिहीं आपाअ काजे तियार कोआ.”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />सेला निहीत कोइत गांवोंम आया, आन जेहलोहो ईसु तियांहां कोयोतो, तेहलोज देख्यो; आन वल्हांडण तिवारोअ काजे रोटू तियार कोअयू.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />जेहेलाम वेल पोड़्यी, ताहां तो बारा सेलाअरी आयू. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />जेहेलाम ते बोहीत कोइत खाया कोअताते, ताहां ईसु कोयो, “आंय तुमुहूं खोरीज कोहो के तुमामेर्‍युउ एक जोओं, जो माआं आरीज रोटू खाया कोअहे, तो माहूं तोइत आपे.”<note caller="+" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजन 41:9</ref> </char></note><verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />तियांआं सेहरापोअ नाराजी आवित गोयी आन ते एकाआ फासाड़ी एक तियाहा फुसा वोल्या, “तो आंयेंज के?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />ईसु तियांहां कोयो, “तो बारा जोओं मेर्‍युउ एक होय, जो माआं ठाली मेहें रोटू पिगवीत खाहे. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />काहाके माहुंउं बेटुह्हू तोम, जेहलोहो तियाआ बाप्तिम लेख्योहो, तो जाहेजे; पोन तिया माअहूं पोअ केतोहो वोडो दुख! जिया वाअहीं माहुंहूं बेटुह्हू तोइत आपाअहे! जर तिया माअहुंउं जल्मज ने ओवतो, ताहां तियाआ काजे फायदाआ ओतो.”<verse eid="MRK 14:21" /></para>
  <para style="s">प्रभु-भोज</para>
  <para style="r">(<ref loc="MAT 26:26-30">मत्तय 26:26-30</ref>; <ref loc="LUK 22:14-20">लुक 22:14-20</ref>; <ref loc="1CO 11:23-25">1 करिन्थ 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />जेहेलाम ते खायाज कोअताते, तेहेलाम ईसु रोटू विशू, आन आशिर्वाद मागीत कोइत मुड्यू, आन तियांहां आप्यू, आन कोयो, “ल्या, ओं माआं डिल होय.”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />फाशुउ तो कोल्हयु आथोम लेत कोइत आभार मान्यू, आन तियांहां आप्यू; आन ते आखा तियाज मेहें रोत पिदो. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />आन ईसु तियांहां कोयो, “ओं माआं रक्त होय; जो देव आन माअहोंअ विसमेहें नोवी शप्पतेए सिक्कु लागाड़ेहे, जो जाअखीलां जोओंअ काजे वोहाड़ाअहे<note caller="+" style="x"><char style="xo" closed="false">14:24 </char><char style="xt" closed="false"><ref loc="EXO 24:8">निर्ग 24:8</ref>; <ref loc="JER 31:31-34">यिर्म 31:31-34</ref></char></note>. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />आंय तुमुहूं खोरीज कोहो, देवोअ राजोम जाअहूं जाआं नोवू दाराक्शाआ रोह ने पिंव ताअहूं जाआं ओमे रोत दाराक्शाआ रोह ने पिंव.”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />ताहराअ ते भजन गावीत कोइत बारु जोओं जेयतुनोअ डोगो पोअ गोया.<verse eid="MRK 14:26" /></para>
  <para style="s">ईसुउ पेत्राहा नाकारीइलाअ भविश्यवाणी</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्तय 26:31-35</ref>; <ref loc="LUK 22:31-34">लुक 22:31-34</ref>; <ref loc="JHN 13:36-38">योहान 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />ताहरुउ ईसु तियांहां कोयो, “तुमू आखाज माहूं सोड़ीत नाहींत जाहा. काहाके लेख्योहो: ‘राखवालीही आंय माईंत टाकीहीं आन मेडे वेरा-सेर ओत जाय.’<note caller="+" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">जख 13:7</ref> </char></note> <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />पोन आंय माआं जिवीत उठीइला फासाड़ी तुमारोत पेल गालीलोम जाहीं.”<note caller="+" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्तय 28:16</ref> </char></note><verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />पेत्रे तियाहा कोयो, “आखा सोड़ीत जाय ते जाय, पोन आंय ने जांव.”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />ईसु तियाहा कोयो, “आंय ताहूं खोरीज कोहो, के आजूज यीज राती कुकड़ू बेन वारी वाहींइलाअ पेल, तीन वारी तू माहूं नाकारीही.”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />पोन तिये फाश्यू हिम्मते वाअहीं कोयो, “जर माहूं ताआ आरी मोईलो बी पोड़े, तेबी आंय ताआ नाकार केदिंहीन्ने कोओ.”</para>
  <para style="p" vid="MRK 14:31">एहेंज कोइत बिहीरा आखा बी कोयो.<verse eid="MRK 14:31" /></para>
  <para style="s">गेथसेमेनी बोगिसाम ईसुउ प्रार्थना</para>
  <para style="r">(<ref loc="MAT 26:36-46">मत्तय 26:36-46</ref>; <ref loc="LUK 22:39-46">लुक 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />ताहराअ ईसु आन तियाआ सेला गेथसेमनी नावोअ एकी जागे आया, आन तिये तियाआ सेलाहां कोयो, “आंय प्रार्थना कोअहो, ताअहूं जाआं इंहीं बोहीत रोवा.” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />आन तो पेत्राहा आन याकोबोहो आन योहान यांहां तियाअरी लेत गोयू; तो जाअखीलुहू दुखी आन कालावाला कोउ वोल्यू, <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />आन तिये तियांहां कोयो, “आंय मोनोम खुब दुखी होय, एतुहू दुखी के आंय मोइत जाअहूं कोअहो: तुमू इंहीं उबा रोवा, आन जागता रोवा.”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />ताहरुउ तो थोड़ुक आगाड़ी गोयू आन पुंयपोअ उठ्लीत पोड़्यु आन प्रार्थना कोउ वोल्यू के जर ओत सेकतोय ताहां ए वेल मापोअ रोत टोलीत जाअहूं दे, <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />आन कोयो, “देव बाह्हा, ताआ काजे आखो ओत सेकेहे; या दुखोअ वाटकाहा मापोअ रोत सेटे कोइ दे: पोन जेहलोहो आंय ईतवोहो एहेलोह नाहां, पोन जो तू ईतवेहे तोज ओवुहूं दे.”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />ताहरुउ तो आयू आन तियांहां हुवत्ला पालीत कोइत पेत्राहा कोयो, “शिमोन, तू हुवत्लु ओ? केहें तू एक घेड़ी बी ने जागित सेकत्लू के? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />जागता रोवा आन प्रार्थना कोअता रोवा, मोन्ज्ये तुमू पारजाणामेहें ने पोड्हा. आत्मा ते तियार होय, पोन डिल लुलो होय.”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />आन फाशुउ तो जातु रोयू आन तियांज शब्दामेहें प्रार्थना कोअयी. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />ताहरुउ आवित कोइत तियांहां हुवत्लाज देख्या, काहाके तियांआं डोआ नींदेम पोआईत ओता; आन तियाहा कि उत्तर आपीइलो ओं बी ने मुंदू.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />ताहरुउ तिसरी वारी आवित कोइत तियांहां कोयो, “केहें तुमू ओमे जाआं आरामसीर हुवयाज कोअताहा? एहें, ताहराअ हुवताज रोजा. ते वेल आवित गोयीही जेहेलाम माहुंउं बेटुह्हू तोइत आपाईत पाप्योंओं आथोम होपाअहे. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />उठा, साला! पाला, माहूं तोइत आपनारु आहने आवित रोयुहू!”<verse eid="MRK 14:42" /></para>
  <para style="s">ईसुउ तोआइलो</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्तय 26:47-56</ref>; <ref loc="LUK 22:47-53">लुक 22:47-53</ref>; <ref loc="JHN 18:3-12">योहान 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />ईसु ओं कोयाज कोअतुतो के यहुदा जो बारा सेला मेर्‍युउ ओतू, तियाअरी डाया पुंजारा आन कायदाअ मास्तर आन डायहांआं तरफ रोत मोकलिइल्ये माअहें लेत कोइत ताब्बुड़ आवित पोतू, जे तलवार आन डेंगारा लेत रोयेते. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />ईसुउ तोइत आपनारे तियांहां ओं कोत मिक्यतो के जियाहा आंय गुउं देहीं तोज होय, तियाहा तोइत कोइत सांबालित लेत जाजा.<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />यहुदा आयू, आन मामार तियाआ जागे आवित कोइत कोयो, “गुरु!” आन तियाहा जाअखीलाहा गुंआं देदा. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />ताहराअ ते तियाहा तोइत बांदीत लेदू. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />तिहीं आहने उबा रोनारा मेर्‍यामेएं एके जोएं तियाआ तलवार काडीत कोइत डाया पुंजारकाआं पावरोहो लागाव्यु, आन तियाआ कान तोड़ीत टाक्यु. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />ईसु तियांहां कोयो, “तुमू माहूं डाखू जाईंत कोइत तोइला काजे तारवाआ आन डेंगारा लेत कोइत निहींयाहा के? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />आंय तोम दाडख्‍युउ मंदिरोम तुमाआं आरी रोत कोइत सिकाड्या कोअतुतो, आन तेहेलाम माहूं तुमू नाहां तोअयु:<note caller="+" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">लुक 19:47</ref>; <ref loc="LUK 21:37">21:37</ref>; <ref loc="PSA 88:18">भजन 88:18</ref></char></note> पोन ओं याअकाजे ओयोहो के वसनोमेर्‍यीइ गोठ पुरी ओवुहूं जोवे.”<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />ताहां आखा सेला तियाहा सोड़ीत कोइत गुगदा वोल्या.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />एक जुवान उगड़ाअला डिलोपोअ साअको फांगीत कोइत तियाआ फासाड़ी जानु वोल्यू; आन माअहें तियाहा तोअयु. <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />पोन तो साअको टाकी देत उगड़ाअलुज गुगदू वोल्यू.<verse eid="MRK 14:52" /></para>
  <para style="s">पोन्साआ सामने ईसु</para>
  <para style="r">(<ref loc="MAT 26:57-68">मत्तय 26:57-68</ref>; <ref loc="LUK 22:54">लुक 22:54</ref>,<ref loc="LUK 22:55">55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13">योहान 18:13</ref>,<ref loc="JHN 18:14">14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />ताहराअ ते ईसुहू डाया पुंजाराआं जागे लेत गोया; आन आखा डाया पुंजारा आन डायहां आन कायदाअ मास्तरहों तिहीं टोलू वोलीत गोया. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />पेत्र सेटेज रोत तियाआ फासाड़ी-फासाड़ी डाया पुंजाराआ खोली मेहें जाआं गोयू, आन कामदारोअ आरी बोहीत कोइत आगी हेकाउ वोल्यू. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />डाया पुंजारा आन पुरु पोन्सू ईसुहू माईंत टाकीइलो काजे तियाआ विरुद्दाम पुरावू होदताते, पोन नाहां जोड़्यू. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />काहाके वारुज जोओं तियाआ विरुद्दाम ठोगोअ पुरावू आपताते, पोन तियांआं पुरावू एक हारकू कायने ओतू.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />ताहरेए थोड़ेक माअहें उठीत कोइत तियाआ विरुद्दाम ओ ठोगोअ पुरावू आप्यू, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“आमू याहा ओं कोत्लू उनाअयाहा, ‘आंय या आथोवाअहीं बोंणावल्या मंदिरोहो पाड़ीत टाकीहीं, आन तीन दिहोमेहें बिहीरु मंदिर बोणाविहीं, जो आथो वाअहीं नाहां बोण्यों.’<note caller="+" style="x"><char style="xo" closed="false">14:58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">योहान 2:19</ref> </char></note>” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />तेबी तियांआं पुरावू एक हारकू ने निहयू.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />ताहरुउ डायु पुंजारु विसमेहें उबू रोत कोइत ईसुहू फुशो, “तू किज उत्तर नाहां आपतू? एं माअहें ताआ विरुद्धामेहें कि पुरावू आपतेहे?” <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />पोन ईसु ठावकुज रोयू, आन तिये किज उत्तर ने आप्यो. डाये पुंजारके फाश्यो तियाहा फुशो, “केहें तू तिया परमधन्य देवोअ बेटुह्हू ख्रिस्त होय?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />ईसु कोयो, “आंय होय: आन तुमू माहुंउं बेटाह्हाहा आखाम रोत वोडी सेक्तीवालाआ हाजाड़्यीइ वोलेहे बोठ्लू, आन जुगोमेर्‍याआ वाद्लाअ आरी आवत्लू देखहा.”<note caller="+" style="x"><char style="xo" closed="false">14:62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानि 7:13</ref>; <ref loc="PSA 110:1">भजन 110:1</ref></char></note> <verse eid="MRK 14:62" /><verse number="63" style="v" sid="MRK 14:63" />ताहां डाये पुंजारके तियाआ आंगड़ो सिरीत कोइत कोयो, “ओमे आपुहूं पुरावाआ फाश्यीइ काविंहीं गरज होय के? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />तुमू ए देवोअ निंदा उनाअये. तुमुहूं कि हासवाअहे?”</para>
  <para style="p" vid="MRK 14:64">तियां आखाज कोयो के ओ मोतोअ लायकीइ होय.<note caller="+" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेवी 24:16</ref> </char></note><verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />ताहरेए थोड़ेक जोएं तियापोअ थुपे वोल्ये, आन थोड़ेक जोएं तियाआ सोब टापित थापुड़ देनेवोल्ये आन तियाहा कोने वोल्ये, “भविश्यवाणी कोअ!” आन कामदारहों तियाहा तोइत कोइत थापडे वाअहीं देदू.<verse eid="MRK 14:65" /></para>
  <para style="s">पेत्राआ नाकारीइलो</para>
  <para style="r">(<ref loc="MAT 26:69-75">मत्तय 26:69-75</ref>; <ref loc="LUK 22:56-62">लुक 22:56-62</ref>; <ref loc="JHN 18:15-18">योहान 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />जेहेलाम पेत्र निसे खोलीमेहें ओतू, ताहां डाया पुंजाराआ पावरीं मेर्‍यीइ एक जोईं तिहीं आयी, <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />आन तियी पेत्राहा आगी हेकाअत्लू देख्यू, आन तियाहा ध्यान लागाड़ीत पाल्यू आन कोनी वोल्यी, “तू बी तोम तिया ईसु नासरेथकरोअरी ओतू.”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />पोन पेत्र तो नाकारी देदो, आन कोनु वोल्यू, “तू कि कोहे ओं माहूं नाहां फारकाअतो आन समजाअतो बी नाहां.” ताहरुउ तो बारथे खोलीइ ओटाआ दरवाजाअ जागे गोयू; आन कुकड़ू वाहयूं.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />ते पावरीइं तियाहा पालीत कोइत तियांहां जे आहने उबे रोत रोयेते, फाश्यीइ कोनी वोल्यी, “ओ तियांमेर्‍युउ एक होय.” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />पेत्र फाशुउ तियाहा नाकारी देदो.</para>
  <para style="p" vid="MRK 14:70">फाशुउ एकताल रोत जे आहने उबा रोत रोयाते तियां पेत्राहा कोयो, “खोरीज तू तियांमेर्‍युउ एक होय; काहाके तू बी गालीलोअ होय.”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />ताहरुउ तो हाराप आपू आन शप्पत खानु वोल्‍यू, “आंय तिया माहुंहूं, जियाअ तुमू सर्सा कोअतेहे, ने ओलखीइत्लू.”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />ताहरुउ ताब्बुड़ बिहीरी वारी कुकड़ू वांहयूं. पेत्राहा ते गोठ जे ईसु तियाहा कोयी, ते ओर आयी: “कुकड़ू बेन वारी वाहींइलाअ पेल तू तीन वारी माहूं नाकारीही.” आन तो यीं गोठीहीं ईतवीत कोइत जोरे-जोरे रोड़ू वोल्यू.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">पिलातोअ सामने ईसु</para>
  <para style="r">(<ref loc="MAT 27:1">मत्तय 27:1</ref>,<ref loc="MAT 27:2">2</ref>; <ref loc="MAT 11-14">11—14</ref>; <ref loc="LUK 23:1-5">लुक 23:1-5</ref>; <ref loc="JHN 18:28-38">योहान 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />हुसताअरीही मामार डाया पुंजारा, डायहां, आन कायदाअ मास्तरहों, आन पुरु पोन्सूज निर्णय लेदो. ईसुहू बांद्यू, आन तियाहा लेत जात कोइत पिलातोअ आथोम होपी देदू. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />पिलाते तियाहा फुशो, “तू यहुदीइ राजा होय के?”</para>
  <para style="p" vid="MRK 15:2">तिये तियाहा कोयो, “तूज सोताह कोहे.”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />डाया पुंजारा तियापोअ वारुज गोठीइ आरोप लागाड़ताते. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />पिलाते तियाहा फाशोअ फुशो, “केहें तू कीज उत्तर नाहां आपतू के, पाल, एं तापोअ केतीही गोठीइ आरोप लागडतेहे?”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />ईसु तिहीं रोत कीज उत्तर ने आप्यो; पिलात जाआं जुदू बोगलाईत गोयू.<verse eid="MRK 15:5" /></para>
  <para style="s">मोत आपिइलोअ हुकूम</para>
  <para style="r">(<ref loc="MAT 27:15-26">मत्तय 27:15-26</ref>; <ref loc="LUK 23:13-25">लुक 23:13-25</ref>; <ref loc="JHN 18:39-19:16">योहान 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />पिलात तिया तिवारोम कोडा बी एका गुनेगारोह तियांआं काजे सोड़ी देतुतो. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />जियां दोंगा मेहें खुन कोअयोतो तिहीं मेर्‍युउ बरब्बा नावोअ एक माटी ओतू <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />आन गर्दी उसे जात कोइत रावण्या कोइ वोल्‍यी, के जेहें कोइत तु आमाआं काजे एता वोर्ह्यों कोअतू आयू तेहेंज कोइत कोअ. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />पिलाते तियांहां कोयो, “आंय यहुदीइ राजाहा सोड़ी देंव एहेलिही तुमाआं इश्शा होय के?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />काहाके तियाहा मुंदू ओतू के डाया पुंजारा आद्रायी वाअहीं तियाहा तोआड्युतो.<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />पोन डाया पुंजारा माअहोंहों रोढे आवाड्‍ये के तो बरब्बाहाज तुमाआं कोअते सोड़ी देअहूं जोवे. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />एहेलोह उनाइत पिलात फाशुउ तियांहां फुशो, “ताहां जियाहा तुमू यहुदीइ राजा कोतेहे तियाहा आंय कि कोओ?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />तें फाशेए आअड़्ये, “तियाहा क्रुस खांबो पोअ टांगी देवा!”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />पिलाते तियांहां कोयो, “काहा? ये कि बाक्तो कोअयोहो?”</para>
  <para style="p" vid="MRK 15:14">पोन तें फाश्येए बी आअड़्ये, “याहा क्रुस खांबो पोअ टांगी देवा!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />ताहां पिलात माअहोंहों खुस कोइलोअ इश्शा वाअहीं बरब्बाहा तियांआं कोअते सोड़ी देदू, आन ईसुहू सापका देत कोइत क्रुस खांबोपोअ टांगेतेहें काजे होपी देदू.<verse eid="MRK 15:15" /></para>
  <para style="s">सैनिक ईसुउ अपमान कोअत्ला</para>
  <para style="r">(<ref loc="MAT 27:27-31">मत्तय 27:27-31</ref>; <ref loc="JHN 19:2">योहान 19:2</ref>,<ref loc="JHN 19:3">3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />सेयनिक ईसुहू राजवाड़ाआ मांयते खोलीमेहें लेत गोया, तियी खोलीइ नाव प्रीटोरियम ओतो, आन पुरी तुकड़ीही हादीत लेतावया. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />ताहां तियां ईसुहू जामण्यो आंगड़ो पेवाड़्यो आन काटाआ पागड़ी गुथीत कोइत तियाआ मुंडोपोअ मिकी देदी, <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />एहें कोत वोंदा वोल्या, “ए यहुदीयांआं राजा सलाम!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />ते तियाआ मुंडोपोअ बुरवाड़ा वाअहीं देता जात तियाआ सोबीपोअ थुपताते, आन टोसणे पोड़ीत तियाहा वोंदताते. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />जाहां ते तियाआ अपमान कोइत सुक्या, ताहां तियाहा पेवाड़ल्यो जामण्यो आंगड़ो काडीत तियाआ आंगड़ो पेवाड़ी देदो; आन ताहां क्रुस खांबोपोअ टांगीइलो काजे बारथे लेत गोया.<verse eid="MRK 15:20" /></para>
  <para style="s">क्रुसखांबोपोअ ईसु</para>
  <para style="r">(<ref loc="MAT 27:32-44">मत्तय 27:32-44</ref>; <ref loc="LUK 23:26-43">लुक 23:26-43</ref>; <ref loc="JHN 19:17-27">योहान 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />अलेक्झांडर आन रुफुसोअ आब्हू शिमोन, तो एक कुरेनी ओतू, तो गांवोंअहें रोत आवत्लू तेहलुज तेहेंज रोत निहींयू, तियां तियाहा क्रुस खांब आखलीत जायतेहें काजे जबरजस्तीज तोअयु. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />ते ईसुहू गुलगुता नावोअ जागे लेत आवया जियाअ अर्थ मुनकाअ खोबज्याअ जागू होय. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />तिहीं तियाहा मोगो मोगो गुंदाअनारु रोह पेलीत दाराक्शाआ रोह आपा वोल्‍या, पोन तिये ने पिदू. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />तिहीं रोत तियाहा क्रुस खांबो पोअ टांगी देदू आन तियाआ आंगड़े तियां वाटीत लेदे, आन कोडो कि लेनारो होय तो पालिइलोअ काजे तियां सिट्टी फडकावयी.<note caller="+" style="x"><char style="xo" closed="false">15:24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">भजन 22:18</ref></char></note> <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />दिहेए नोव वाज्येते जेहेलाम तियां तियाहा क्रुस खांबोपोअ टांग्यू. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />तियाआ विरुद्दाम एकी पाटी पोअ लेख्योतो, “यहुदीयांआं राजा” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />तियाअरी बेन डाखा बी क्रुस खांबोपोअ ओता, एक तियाआ हाजाड़्यीइ वोगेहे आन बिहीरु बांगाड़्यीइ वोगेहे. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />ताहां पवित्र शास्त्राअ ओं वसन पुरो ओवो के, तियाआ गणती डाखुमेहें ओवी.<verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />आन तियाआ जागे रोत वाटे लागनारे माअहें तियाआ निंदा कोअतेते आन मुनके कुटावी कुटावीइ कोतेते, आरे वा! तुज तोम ना मंदिरोहो ओदारीत कोइत तीन दिहोम फाशुउ बोणावनारु! <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />क्रुस खांबोपोअ रोत निसे उतर आन सोताआ जिवोह तेंव वासाड़!<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />एहेंज कोइत डाया पुंजारा आन कायदाअ मास्तरहों बी ईसु अपमान कोअयू. ते तियां तियांआज कोना वोल्‍या “बिहीराहा वासाड्या पोन सोताआ जिवोह ने वासाड़ीत सेकत्लू! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />ओमे या ‘ख्रिस्त’ आन इस्राएलोअ राजाहा क्रुस खांबो पोअ रोत निसे उतरुहूं दे, एताआ काजे के आमू ओं देखीत भरिवसू कोइत सेको.”</para>
  <para style="p" vid="MRK 15:32">जियांहां तियाअरी क्रुस खांबो पोअ सोढ़व्याते, तियां बेनू बी ईसुउ निंदा कोअयी.<verse eid="MRK 15:32" /></para>
  <para style="s">ईसुउ मोत</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्तय 27:45-56</ref>; <ref loc="LUK 23:44-49">लुक 23:44-49</ref>; <ref loc="JHN 19:28-30">योहान 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />ताहां पुरा मुलखोमेहें दिहेए वेले जाआं आंदारो टापाइत रोयो. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />दिहे तीन वाजता ईसु जोरेज आअड़ीत कोयो, “इलोई, इलोई, लमा शबकतनी.” मोन्ज्ये “माआं देवा, माआं देवा, तुमे माहूं काहा सोड़ी देदू?”<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />जें आहने उबे रोयेते, तिहीं मेर्‍येए थोड़हे माअहें उनाअये, ताहां तियां कोयो, “होंबला, ओ एलियाहा हादेहे.” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />एक जोंअ गुगदीइतुज गोयू. तिये कडवा-खाटा रोहोम स्पंज बुडाड़ीत पिगव्यू. आन तो बुरवाडाआ डांडा पोअ मिकीत कोइत ईसुहू पियतेहें काजे आप्यू आन कोयो, “माताअहूं, याहा निसे उतारीइलो काजे एलिया आवेहे के नाहां तो आपू पालत्ला.”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />ताहां ईसु जोरमेहें आअड़ीत रोड़्यू आन जिव सोड़ी देदू.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />ताहां मंदिरोअ पोड़दू उसे रोत निसे जाआं फाटीत कोइत बेन तुकड़ा ओत गोयू. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />सैनिकहोंअ एक आधिकारी जो ईसुउ सामने उबू रोत रोयुतो, तियाहा आअड़ीत केहें कोइत जिव सोडत्लू तो देख्यू. ताहां तिये कोयो, “ओ माटी खोरीज बी देवोअ बेटुह्हू ओतू!”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />थोडही बोईं जे तिहीं उबी रोत रोयीते तिहींमेएं मरिया मग्दालिनी, हाना याकोबोअ आन योसेफोअ आयही मरिया आन सलोमी ए ओती. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />ईसु जेहेलाम गालील मुलखोमेहें ओतू ताहां ए आखी बोईं तियाआ सेवा कोअतीते; आन येरुसालेमोम बिहीरी बी बोईं ओती.<verse eid="MRK 15:41" /></para>
  <para style="s">ईसुहू डाटी देत्ले</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्तय 27:57-61</ref>; <ref loc="LUK 23:50-56">लुक 23:50-56</ref>; <ref loc="JHN 19:38-42">योहान 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />तेहेलाम दिही बुडीत गोयूतो आन आरामोअ दिहोअ<note caller="+" style="f"><char style="fr" closed="false">15:42 </char><char style="fq" closed="false">आरामोअ दिहोअ </char><char style="ft" closed="false">यहुदी माअहोंअ आरामोंअ दिही.</char></note> आगल्‍युउ दिही मोन्ज्ये तियारी कोइलोअ दिही ओतू. <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />अरमितीवालू योसेफ ओतू, तो वोडा पोन्साअ सदस्य ओतू आन तो सोताह देवोअ राज आवेतेहें काजे वाट जोवतुतो. तो योसेफ हिम्मतो वाअहीं पिलातोअ जागे गोयू आन ईसुउ तोड़ माग्यो. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />ईसु एतू वेगु केहें कोइत मोयु तों देखीत पिलात पोंगलाईत गोयू; आन तिये सेयनिकोअ आधिकार्‍योहो हादीत कोइत फुशो. ईसुहू मोल्‍याहा जाअखीलिही वेल ओवली के केहें? <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />आधिकार्‍ये कोल्‍यी खबर उनाइत कोइत पिलाते योसेफोहो तो तोड़ आपी देय तेहें कोयो. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />ताहां योसेफ हाजामेर्‍योओ एक साअको वेसातो लेदो, आन तोड़ोहो क्रुस खांबोपोअ रोत उतारीत कोइत तिया साअकामेहें गुंउंटावित तियाहा तिये खड़कामेहें खुउंल्‍या माहणोमेहें मिक्यो. तिहीं रोत तिये माहणोअ दोओपोअ एक डोण होरकावी देदू. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />ईसुहू का मिकतेहे तों मरिया मग्दालिनी आन याकोब आन योसेफोअ आयही मरिया नेहें पाल्या कोअतीते.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">ईसुउ मोतोमेहें रोत जिवित उठीइलोअ</para>
  <para style="r">(<ref loc="MAT 28:1-8">मत्तय 28:1-8</ref>; <ref loc="LUK 24:1-12">लुक 24:1-12</ref>; <ref loc="JHN 20:1-10">योहान 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />जाहां आरामोअ दिही सेलाइत गोयू, ताहां मरिया मग्दालिनी, आन याकोबोअ आयही मरिया आन सलोमी यीं ईसुउ डिलोपोअ हारीलोअ काजे मासालाआ वस्तु आन हाजो गुंदाअनारो तेल वेसातो लेतावयी. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />आठीवड़ाआ पेल्‍लेए दिहे वेगीइ वेले, दिही उगताअरीही, ते माहणोअहीं आवयी. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />आन तियीं तियींइज गोठी कोअतीते, “आपाअ काजे माहणोअ दोओपोर्‍यूउ डोण कोडो होरकावे?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />जेहेलाम तियीं उसे नजर टाकीत पाल्‍यो, ताहां माहणोपोऱ्युउ डोण होरकावल्‍यूज देख्यू, तो जुदू वोडू ओतू. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />माहणोमेहें मांयते जात कोइत तियीं एका जुवानोहों पांडो आंगड़ो पेवित कोइत हाजाड़ीइ वोलेहे बोहीत रोल्‍यू देख्‍यू, आन जुदी बोगलात गोयी.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />तिये तियींहीं कोयो, “काबराअहा मा, माहूं मुंदू होय के तुमू नासरेथवाला ईसुहू होदतिही, जियाहा क्रुस खांबो पोअ टांग्यूतो, तो जिवित उठ्युहू, तो इंहीं कायनाहां; पाला, ओज तो जागू होय, जिहीं तियां तियाहा मिक्युतो. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />पोन तुमू जावा, आन तियाआ सेलाहां आन पेत्राहा कोवा के तो तुमारोत पेल गालील मुलखोमेहें जाय. जेहलोहो तिये तुमुहूं कोयोतो, तुमू तियाहा तिहींज देखहा.”<note caller="+" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">मत्तय 26:32</ref>; <ref loc="MRK 14:28">मार्क 14:28</ref></char></note><verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />आन ते माहणोअहीं रोत निहीत गोयी. काहाके ते काबराईत गोयीते आन बियीते आन तियीं कोडाहा किज ने कोयो, काहाके ते बियीते.<verse eid="MRK 16:8" /></para>
  <para style="s">ईसु मरिया मग्दालिनीहीं देखाअत्लू</para>
  <para style="r">(<ref loc="MAT 28:9">मत्तय 28:9</ref>,<ref loc="MAT 28:10">10</ref>; <ref loc="JHN 20:11-18">योहान 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />आठीवड़ाआ पेल्लेए दिहे रविवारोअ दिही वेगर्‍यूउ ईसु मोतोमेहें रोत जिवित उठ्‍यू, ताहां तो पेल मरिया मग्दालिनीहीं देखाअयू, जियीमेहें रोत तिये हांत पुते काड्येते. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />तियी ईसुउ हात्योहों जात कोइत खबर आप्‍यी. जे विखे बोठाते आन रोडतेते. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />आन जेहेलाम तियीइ गोठ ते उनाअये के ईसु जिवतु होय, आन तियी तियाहा देखल्‍यू, ताहां तियांहां तियीइ गोठी पोअ भरिवसू ने ओवू.<verse eid="MRK 16:11" /></para>
  <para style="s">ईसु बेन सेलाहां देखाअत्लू</para>
  <para style="r">(<ref loc="LUK 24:13-35">लुक 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />फाशुउ ईसु बिहीरा वेहोमेहें देखाअयू, तेहेलाम तियांमेर्‍याअ बेन सेला गांवोंअहें जाताते. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />ते फाशा फिरीत आवया आन खबर आप्यी, पोन तियांपोअ बी तें विश्वास ने कोअयू.<verse eid="MRK 16:13" /></para>
  <para style="s">ईसु ईग्यार जोओंहों देखाअत्लू</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्तय 28:16-20</ref>; <ref loc="LUK 24:36-49">लुक 24:36-49</ref>; <ref loc="JHN 20:19-23">योहान 20:19-23</ref>; <ref loc="ACT 1:6-8">प्रेशित 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />आखाआ फासाड़ी, ईसु तियां ईग्यार सेलाहां बी जेहेलाम ते रोटू खाना बोठाते तेहेलाम देखाअयू. आन तो तियांहां बावराअयू, काहाके जियां तियाहा मोतो मेहें रोत जिवीत उठल्‍याहा देख्यूतो, तियाआ गोठी पोअ बी तियांहां भरिवसू ने ओतू आन तियांआं मोन वातड़ो ओत गोयोतो. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />तिये तियांहां कोयो, “आखी दुन्यामेहें जात कोइत कोली मेहें रोनारा आखा माअहोंहों हाजी बातमीइं परसार कोआ.<note caller="+" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">प्रेशित 1:8</ref></char></note> <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />जों भरिवसू कोए आन बाप्तिस्मा लेय तोज वासाय, पोन जों भरिवसू ने कोए तों दोशी ठरे; <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />भरिवसू कोअनारा मेहें ए निशाणी रोय, के तें माआं नावम पुते काडे, नोवी-नोवी बाशा गोगे, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />तें हापोहो विसीत लेय, आन केहेलोह बी जेहर पीत लेय, तेबी तियांआं कीज नुकसान ने ओवे; तें मांदवाड़्यां पोअ आथ मिके, ताहां मांदवाड़्ये हुदरीत जाय.”<verse eid="MRK 16:18" /></para>
  <para style="s">ईसुउ होरगाम विसाइत जाअलोअ</para>
  <para style="r">(<ref loc="LUK 24:50-53">लुक 24:50-53</ref>; <ref loc="ACT 1:9-11">प्रेशित 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />मालिख ईसु तियाअरी गोठी कोअयी तिहीं रोत तो होरगाम विसाइत गोयू. आन देवोअ हाजाड़ीइ वोलेहे जात बोहीत गोयू.<note caller="+" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">प्रेशित 1:9-11</ref></char></note> <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />आन तियां जात कोइत आखी जागे परसार कोअयू, आन मालिख तियांअरी काम कोअतू रोयू, आन तियीं निशाणी वाअहीं जे तियांअरी ओवतीते तियीं वाअहीं वसनोहों पाक्कू कोअतू रोयू.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>