<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Noiri</book>
  <para style="h">3 योहान</para>
  <para style="toc3">3 योहान</para>
  <para style="toc2">3 योहान</para>
  <para style="toc1">योहानोअ तिसरो पत्र</para>
  <para style="mt2">योहानाचे तिसरे पत्र</para>
  <para style="mt1">योहानोअ तिसरो पत्र</para>
  <para style="imt">ओलखात</para>
  <para style="ip">योहानोअ तिसरो पत्र ओं ईसु ख्रिस्ताआ जल्माआं 50 ते 100 एताहा वोर्‍ह्योंअ विसमेहें प्रेशित योहानोअ आथे लेखाअलो होय. इंहीं योहान सोताहा लेखार्‍यु एहें कोत नाहां पोन तो मंडड़ीइ डायु कोत होमजेहे <char style="xt"><ref loc="3JN 1:1">1:1</ref></char> योहानोअ दुसरा पत्राआ होस या पत्राम नाहां लेखतु <char style="xt"><ref loc="3JN 1:1">1:1</ref></char> भरिवसू एहेलुहू लागेहे के योहानोअ लेखल्यो “हाजी बातमीइं पुस्तक” आन 1 योहान, 2 योहान आन 3 योहान एं इफिसोअ मंडड़ीम ओतू तेहेलाम लेखाअयेहे.</para>
  <para style="ip">ओं पत्र योहाने एका गायस नावोअ विश्वासीही लेख्योहो आन तो तियाहा तियाआ दोस्ती कोत मानेहे आन तिया भागोमेहें आवनारा विश्वासी पाव्हीइलाआ कोअते तो पावणाय कोअनारु रोयतेहें कोत सुसना कोहे.</para>
  <para style="iot">रुप-रेशा</para>
  <para style="io1">1. योहान तियाआ पत्राआ ओलखात आपेहे <char style="ior"><ref loc="3JN 1:1">1:1</ref> </char></para>
  <para style="io1">2. तियाआ फासाड़ी तो गायुसोहो विश्वासी माअहोंअ पावणाय कोइलाअ बाप्तिम सुसना आपेहे <char style="ior"><ref loc="3JN 1:2-8">1:2-8</ref></char></para>
  <para style="io1">3. आगाड़ी तो बिहीरा बेन जोओंअ मोन्ज्ये दियुत्रिफेस आन देमेत्रियुसोअ बाप्तिम गोठी कोहे <char style="ior"><ref loc="3JN 1:9-12">9-12</ref> </char></para>
  <para style="io1">4. आखरीमेहें तो तियाआ पत्र पुरो कोअहे, <char style="ior"><ref loc="3JN 1:13-15">13-15</ref> </char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />माआं मेरालु पाही गायस याहा मडड़ीइ डायु योहानोअ तरफ से, जियापोअ माआं खोरी मेर होय.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />मेराला पाही, जेहलुहू तु हाजी हुतेहे होय तेहलुज तु आखी गोठीमेहें हाजी हुतेहे आन नेरु रोअहूं जोवे एहलिही आंय ताअकाजे प्रार्थना कोअहो. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />काहाके, तु सत्यापोअ सालेहे एहलिही विश्वासी पाही माआं जागे आवित ताआ बाप्तिमेहें साक्शी आप्यी, जियापोअ तु खोराखोर सालेहे, ताहां आंय खुब खुस ओत गोयू. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />माआं पोऱ्ये सत्यामेहें सालतेहे ओं उनाइत माहूं जे खुसी ओवेहे याअ रोत जाअखी खुसी बिहीरी कोड्लीज गोठीम नाहां.<verse eid="3JN 1:4" /></para>
  <para style="s">गोयसोअ स्तुती</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />माअ मेराला पाही, जों काम तुमे विश्वासी पायहोंअ काजे आन ओजाण्याआं काजे बी कोअहे, तों खुब इमानदारी वाईं कोअहे. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />तियां मंडड़ीइ सामने तुमे कोअल्या मेरेए साक्शी बी आप्यीही, देवोहो पोटेहे एहलोहो तियांहां तु वाटे लागाड़ही ताहां हाजो कोअही. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />काहाके तें ख्रिस्ताआ नावोअ काजे बारथे निहींयेहे आन बिगर विश्वासी माअहूं पोअ रोत किज नाहां लेते. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />तिहीं वाईं एहेला माहुंउं आपू मदत कोअहूं जोवे ताहां आपू बी सत्यामेहें तियांअरी भागिदार बोणित सेकहूं.<verse eid="3JN 1:8" /></para>
  <para style="s">दियुत्रिफेस आन देमेत्रियुस</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />मंडड़ीही आंय वाहींज लेख्योतो; पोन, तिहींइं तो दियुत्रिफेस जियाहा तियांआं डायु बोणिइलोअ ओतो, तियाहा काजे तो आमाआं स्विकार नाहां कोअतू. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />पोन आंय तिहीं आविहीं तेहेलाम तियाआ कामें देखाड़ी देहीं. तो आमाआं बाप्तिमेहें फोगायी कांय कांय कोतू फिरेहे, एताज वाअहीं तियाहा होक नाहां आवतू, आन आपाअ ख्रिस्ती पायहोंहों बी तो नाहां स्विकारतु, पोन उलटू जें स्विकारुहूं होदतेहे तियांहां बी रुकेहे आन तियांहां मंडड़ीम रोत बारथे काडी देहे.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />माआं मेराला दोस्ता, जों बाक्त ओय तियाहा नाहां पोन जों हाजो ओय तियाहा होय तोइत साल. काहाके जो हाजो काम देवोअ तरफ से होय. जों बाक्त काम कोअहे, तिये देवोहो नाहांजी पाल्यो.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />देमेत्रियुसोअ बाप्तिमेहें आखे हाजीज साक्शी आपतेहे, आन आमू बी तियाआ बाप्तिम कोताहा, आन तुमुहूं मुंदूज होये के आमाआं साक्शी खोरी होय.<verse eid="3JN 1:12" /></para>
  <para style="s">आखरीपोअ सलाम</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />माहूं ताअकाजे खुब गोठी लेखीइली जी होये, पोन पेनेन सहीवाईं नाहां लेखीइलो. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />आशा कोअहो के आंय ताहूं वेगुज मिलीहीं, तेहेलाम आपू हुंबाहूंब मिलीत गोठी मिकहूं.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />देवोअ शांती तुमाअरी रोअहूं जोवे. ताआ दोस्ती ताहूं सलाम कोताहा. तिहींवाला आखा दोस्ताहां नावे तोइत सलाम कोयोहो कोत देजी.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>