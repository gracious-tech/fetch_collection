<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Noiri</book>
  <para style="h">प्रेशित</para>
  <para style="toc3">प्रेशित</para>
  <para style="toc2">प्रेशित</para>
  <para style="toc1">प्रेशितोंअ कामोंअ लेखल्यु इतिहास</para>
  <para style="mt2">प्रेषितांच्या कृत्यांचा लेहिलेला इतिहास</para>
  <para style="mt1">प्रेशितोंअ कामोंअ लेखल्‍यु इतिहास</para>
  <para style="imt">ओलखात</para>
  <para style="ip">प्रेशितोंअ पुस्तक मंडड़ीइ सुरुवात की कोइत ओवी आन ते येरुसालेमोम, यहुदाम, शोमरोनोम आन तियाआ आगाड़ी जाआं केहें कोइत पसर्‍यी? जेहें कोइत ईसु तियाआ सेलाहां होरगाम जाअलोअ पेल कोयोतो <char style="xt"><ref loc="ACT 1:8">1:8</ref></char>. जिये लुकोअ हाजी बातमी लेख्यी, तियेज ओं पुस्तक बी लेख्यो. तो लेखार्‍यू एक डाक्टर ओतू, आन तो काईंहीं बोराबर सांबालित लेखीइलाम हुशार ओतू. तिये तियाआ हाजी बातमी आन या पुस्तकोवाअहीं, थियुफिलुसोहो कोत देखाड़्योहो, जे ग्रीक आन यहुदी बेनू जोड़ीदार ओता. <char style="xt"><ref loc="ACT 1:1">1:1</ref></char></para>
  <para style="ip">प्रेशितोंअ ओं पुस्तक ख्रिस्ती समाजोअ काजे लेख्योहो, आन ओं पुस्तक ईसुउ जल्माआं 60-64 वोर्‍ह्योंअ फाटी लेखाअयोतो. आपुहूं यापोअ रोत समजाअहे, काहाके पौलुसोअ जेलेम रोत सुटका ओवीइलाआ पेलुज ओं पुस्तक सेलाअहे. लूके बी पौलुसोअरी प्रवास कोअयू, आन तिये अंताकिया होयरोमेहें ओं पुस्तक लेख्योये. यी गोठीइ सुरुवात लूकोअ हाजी बातमीइं दुसरु भाग होय. आन तियाआ सुरुवात ईसु ख्रिस्ताअ होरगाम जाअलोअ वाअहीं ओवेहे. जिया उद्देशोवाअहीं तिये लूकोअ हाजी बातमी लेख्यीही, तियाज उद्देशोवाअहीं ओं पुस्तक बी लेख्योहो. थियुफिलुस आन तियाअरी कायम वोदनारु ख्रिस्ती समाज, जे गोठी तियां सिकाअयी तियींइं तापास कोइत लेअहूं जोवे, तियाहा काजे तिये ओ इतिहास लेख्यू.</para>
  <para style="ip">ओ इतिहास ईसुउ जिवन आन ख्रिस्ती विश्वासोअ परसार की कोइत ओवयू याअ बाप्तिम होये. सुरुवातीइ मंडड़ी केहेलिही ओती, याअ एक दर्शन आपुहूं या पुस्तकोम सापड़ेहे. तेहेंज कोइत तियी होमसे ईसु पोअ विश्वास मिकनारे माहें जिवन की कोइत जिवतेते, ओं आपुहूं याम रोत समजाअत्लो. हाजी बातमी बिहीराअ जागे परसार कोअत्ले, तेहेलाम पवित्र आत्माआं सेक्तीपोअ केहें कोइत भरिवसू कोइत रोअलो तो प्रेशितोंअ नमुनावाअहीं आपुहूं मुंदू पोड़त्लू.</para>
  <para style="iot">रुप रेशा</para>
  <para style="io1">1. सेलांपोअ पवित्र आत्मा उतरीइलोअ आन मंडड़ी वादीइलोअ.<char style="ior"><ref loc="ACT 1:1-8:1">1:1—8:1</ref> </char></para>
  <para style="io1">2. याअ फासाड़ी मंडड़ीही सोतावणी आन येरुसालेमोअ बाहर मंडड़ीइ पसरीइलोअ. <char style="ior"><ref loc="ACT 8:2-12:23">8:2—12:23</ref></char></para>
  <para style="io1">3. याअ फासाड़ी पौलुस पेल्लीइ सेवाअ वाटेम जात्लू. <char style="ior"><ref loc="ACT 12:24-14:28">12:24—14:28</ref> </char></para>
  <para style="io1">4. नवीन विश्वास्यांप रोत की आहरु ओं ठरवीइलाअ कोअते येरुसालेमोमेहें धर्मपरिशद <char style="ior"><ref loc="ACT 15:1-35">15:1-35</ref> </char></para>
  <para style="io1">5. तिहींइं फासाड़ी पौलुस दुसरी फेरे सेवाअ काजे वाटे लागत्लू. <char style="ior"><ref loc="ACT 15:36-18:22">15:36—18:22</ref> </char></para>
  <para style="io1">6. याअ फासाड़ी पौलुस तिसरी फेरे सेवाअ काजे वाटे लागत्लू. <char style="ior"><ref loc="ACT 18:23-20:38">18:23—20:38</ref> </char></para>
  <para style="io1">7. तिहींइं फासाड़ी पौलुसोअ येरुसालेमोमेहें तोआइलोअ. <char style="ior"><ref loc="ACT 21-26">21—26</ref> </char></para>
  <para style="io1">8. सेलवाआ पौलुसोह रोम सेहरोअहें लेत जाअलोअ. <char style="ior"><ref loc="ACT 27-28">27—28</ref></char></para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">पवित्र आत्माआं वायदो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />ए मेराला थियुफिलुस:</para>
  <para style="p" vid="ACT 1:1">आंय पेल्लोअ पुस्तक तियीं आखी गोठीइ बाप्तिमेहें लेख्यो, जे ईसु तियाआ कामोअ सुरवाती रोत कोअतू आन सिकाड़तू रोयू, <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />तिये दिहे जाआं जेदिहीं तो उसे होरगाम विसाइत ने गोयू. तियाआ उसे विसाइलाआ पेल जियां प्रेशितोंहों तिये निवड़्याते तियांहां पवित्र आत्मा वाअहीं सुसना आप्यी. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />मोइलाअ फासाड़ी जाअखीलाहा पाक्का पुरावा वाअहीं सोताहा तिये तियांहां जिवतु देखाड़्यू. आन सालीही दिही जाआं तो तियांहां देखाअतू रोयू, आन देवोअ राजोअ गोठी कोअतू रोयू. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />आन जेहेलाम तें टोलू वोलीत ओते, तेहेलाम तिये तियांहां आदेश आप्यू के, “येरुसालेम होयरोह मा सोड़हा, पोन बाह्हाआ तिया वायदाहा पुरो ओविइलाआ वाट जोवते रोजा, जों आंय तुमुहूं कोताप्योहो. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />योहाने तोम पाअयों वाअहीं बाप्तिस्मा आप्यो, पोन थोड़ाक दिहोम तुमाआं बाप्तिस्मा पवित्र आत्मा वाअहीं ओवे.”<verse eid="ACT 1:5" /></para>
  <para style="s">ईसुउ होरगाम जाअलोअ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />जाहां प्रेशितहों ईसुउरी एक्ठा ओवा, तेहेलाम तियाहा फुशो, “प्रभु, तू यीज वेले फाशुउ इस्राएलोह राज वापिस आपी देवाड़ही के?”<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />ईसु तियांहां कोयो, “तियीं वेलेहे, नेत तियां कालोहो जाइंलोअ तुमाआं काम कायनाहां, जियांहां बाह्हे सोताआज आधिकारो वाअहीं ठरवीत मिक्योहो. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />पोन जेहेलाम पवित्र आत्मा तुमापोअ आवे, तेहेलाम तुमुहूं सेक्ती जोड़े; आन येरुसालेम, आखा यहुदीयाम, शोमरोन इलाखामेहें, आन धरतीइ सेवट जाआं तुमू माआं साक्शीदार बोणहा.” <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />ओं कोत कोइत तो तियांआं देखते देखतेज उसे विसाइत गोयू, आन वादले तियाहा तियांआं नजरेम रोत टापित लेदू.<verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />तियाआ जाअलोअ वेले जेहेलाम तें जुगोअहें एक सारकेज पालित रोयेते, तेहेलाम पाला, बेन माटी पांडे साअके पोवित रोल्या तियांआं जागे आवित उबा रोया, <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />आन कोयो, “ए गालीलवाला, तुमू काहा जुगोअहें पालतेहे? ओज ईसु, जो तुमाआं जागे रोत होरगामेहें विसाइत गोयुहू, जेहें कोइत तुमू तियाहा होरगामेहें जात्लाहा देख्युहू, तेहेंज कोइत तो फाशुउ वापिस आवनारु होय.”<verse eid="ACT 1:11" /></para>
  <para style="s">यहुदाआ जागापोअ बिहीरा सेलाआ निवड़</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />तेहेलाम प्रेशितहों एकदू किलो मिटर एतीही सेटे जेयतुन नावोअ डोगोपोअ रोत येरुसालेम होयरोम वोलीत आया. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />जाहां ते तिहीं पोत्या, ताहां तियी उसेए एकी खुलीमेहें गोया, जिहीं पेत्र, योहान, याकोब, आंद्रिया, फिलीप, थोमा, बार्थलमय, मत्तय, आल्फेयोअ पोर्‍यू याकोब, शिमोन जेलोतेस आन याकोबोअ पोर्‍यू यहुदा ए रोताते. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />ते आखा आन थोड़ीक बोईं, ईसुउ आयही मरिया आन ईसुउ आखा पाही नेहें मिलीत एक मोन ओत कोइत एक सारखे प्रार्थना मेहें लागीत रोये.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />ताहां थोड़ाक दिहोअ फासाड़ी विश्वासी पाव्हीइलाआं विसमेहें जें एक होवेन विही जोएं एतेहे ओते, तियांम पेत्र उबू रोत कोइत कोनु वोल्यू, <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />“ए माआं विश्वासी पाव्हीइला, ईसुहू तोइत लेत जानाराहां वाट देखाड़नारा यहुदाआ बाप्तिम पवित्र आत्मे दाविदोअ मुखोम रोत जों भविश्य पेलुज रोत कोयोतो, तों पुरो ओवीइलोअ गरज ओती. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />तो ते आपामेर्‍युउ एक ओतू, आन यी सेवामेहें सामिल ओवीइलाआ वाटू तियाहा बी जोड़्युतो.”<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />यहुदा खाराब कामायी वाअहीं एक खेत वेसातो लेदो, आन निसे मुंड कोइत पोड़्यू, आन तियाआ पोटू फुटीत गोयू, आन तियाआ आखे आते निहींत गोये. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />ए गोठ आखा येरुसालेम वालाहां मुंदू पोड़ीत गोयी, आन तिया खेतोअ नाव तियांआं बाशामेहें “हकलदमा” मोन्ज्ये “रक्ताआ खेत” पोड़ीत गोयो. <verse eid="ACT 1:19" /><verse number="20" style="v" sid="ACT 1:20" />भजनोअ पुस्तकोमेहें एहें कोइत लेखाअयोहो के,</para>
  <para style="q1" vid="ACT 1:20">“तियाआ कोअ उजड़ीत जाअहूं जोवे,</para>
  <para style="q2" vid="ACT 1:20">आन तियामेहें कोडोज ने रोअहूं जोवे;”</para>
  <para style="p" vid="ACT 1:20">आन एहेलोहो बी लेख्योहो के,</para>
  <para style="q1" vid="ACT 1:20">“तियाआ जागू एखु बिहीरो लेत लेअहूं जोवे.”<verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />“तियाहा काजे जेताहा दिही जाआं प्रभु ईसु आमाअरी आवतु जातु रोयू, मोन्ज्ये योहानोअ बाप्तिस्माआं परसारोअ वेले रोत ते तियाआ आमाअरी रोत उसे विसाइत जाअलोअ दिही जाआं, जे माटी बोराबर आमाअरी रोया, <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />तियामेहें रोत एक माटी आमाअरी ईसुउ जिवीत उठीइलाअ साक्शीदार बोणुहूं जोवे.”<note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 3:16">मत्तय 3:16</ref>; <ref loc="MRK 1:9">मार्क 1:9</ref>; <ref loc="LUK 3:21">लुक 3:21</ref>; <ref loc="MRK 16:19">मार्क 16:19</ref>; <ref loc="LUK 24:51">लुक 24:51</ref></char></note><verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />ताहां तियां बेन जोओंहों उबा कोअया, तिहींमेएं एक होय योसेफ, जियाहा बरसब्बास बी कोतेहे, तियाआ कोर्‍योअ नाव यूसतुस होये, आन दुसरु होय मत्तिया. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />आन ए प्रार्थना कोअयी, “ए आखाआ मोने जांअनारा प्रभु, ओं देखाड़, के यां बेनुमेहें रोत तुमे कोडाहा निवड़्युहू, <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />मोन्जे तो या प्रेशितोअ जागू लेये, जो जागू यहुदा सोड़ीत कोइत तियाआ जागे जातु रोयू.” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />तेहेलाम तियां बेनू जोओंअ बाप्तिम सिट्टी टाक्यी, आन तेहलाम सिट्टी मत्तियाआ नावोपोअ निहींयी. तिहीं वाअहीं तो तियां ईग्यार प्रेशितोंअरी गोणाअयु.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">पवित्र आत्माआं उतरीइलोअ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />जाहां पेन्टिकास्टोअ<note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">लेवी 23:15-21</ref>; <ref loc="DEU 16:9-11">कायदा 16:9-11</ref> </char></note> दिही आयू, ताहां तें आखे विश्वासी एकीज जागे टोलवात रोयेते. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />एक्काइजे जुगोमेहें रोत वोडा वादुउ होस हुहवीइतुज आवाज आयू, आन तिया वाअहीं जिहीं ते बोठेते तो आखो कोअ होंहणों वोल्यो. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />आन तियांहां आगीइ होस जीब फाटत्लीज आन वेराअत्लीज देखाअयी, आन तिहीं बोठ्ला माहुंउं डिठ आखापोअ आवित बोहीत गोयी. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />तें बादे पवित्र आत्मा वाअहीं पोआइत गोये आन जेहलीही गोगीइलाआ सेक्ती आत्मे तियांहां आप्यी, तेहें कोइत तें जुदी जुदी बाशा गोगे वोल्ये.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />जुगोअ निसे आक्खा देसोम रोत आवल्ये राज्या राज्यामेहें बाशा गोगनारे यहुदी भक्ते येरुसालेमोमेहें रोतेते. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />जेहेलाम ओ आवाज उनाअये, ताहां गोरदी ओत गोयी, आन माअहें बोगलात गोये, काहाके हारेक जोओं ओंज उनाअतोतो के विश्वासी माहें तियांआं बाशामेहें गोगतेहे. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />तें आखे बोगलाइत विसारोम पोड़ीत कोने वोल्ये, “पाला, गोगतेहे एं आखे ताम गालीलवाले होये! <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />ताहां केहें आपामेर्‍योअ हारेक जोओं आपाआ जिव जिवोअ बाशामेहें उनाअहे? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />आपू ताम पारथी, मेदी, एलामी, मेसोपोटामिया, यहुदीया, कप्‍पदुकिया, पोन्तुस आन आसिया, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />आन फ्रूगिया, पंफूलिया, मिसर, लिबिया देस जे कुरेनेए आहने पाहनेए होये. आपामेएं थोड़ेक ताम रोमन वाटहार्‍ये होये, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />मोन्ज्ये यहुदी आन यहुदीइ विसार माननारे, क्रेतेवाले आन अरबी बी होये. पोन तेबी आपू जिवज्योअ बाशामेहें तियांअरी देवोअ वोडा वोडा कामोअ माग उनाअतेहे” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />आना तें आखे बोगलाइत गोये आन विसारोम पोड़ीत एकानेकाहा कोने वोल्ये, “ओं की सालु होये?”<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />पोन बिहरे कुहुराइत कोइत कोयो, “एं तोम दाराक्शाआ रोह पीत कोइत साकवाल ओत गोयेहे.”<verse eid="ACT 2:13" /></para>
  <para style="s">पेत्राआ संदेश</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />तेहेलाम पेत्र तियां ईग्यार प्रेशितोंअरी उबू रोयुन आअड़ीत कोइत कोनु वोल्यू, “ए यहुद्यां आन ए आखा येरुसालेमोमेहें रोनारां, ओं जाईंत ल्या, तुमू कान देत माआं गोठी उनाआ. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />जेहलोहो तुमू होमजीइतेहे, तेहेलेहे एं माअहें साकवाले कायनाहां; काहाके ओमे तोम वेगर्‍येए नवुज वाजतेहे. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />पोने, ए तोम ते गोठ होये, जे योएल भविश्यवक्ते कोयीते:<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />“देव कोहे के, सेलवार्‍याअ दिहोमेहें एहलोहो ओवे के,</para>
  <para style="q2" vid="ACT 2:17">आंय माआं आत्मा आखा माअहूं पोअ ओली देहीं,</para>
  <para style="q1" vid="ACT 2:17">आन तुमाआं पोर्‍या आन तुमाआं पोर्‍यी भविश्यवाणी कोए,</para>
  <para style="q2" vid="ACT 2:17">आन तुमाआं जुवान पोर्‍याहां दर्शन जोड़े,</para>
  <para style="q2" vid="ACT 2:17">आन तुमाआं डायहांहां होप्ने पोड़े.<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />तियां दिहोमेहें आंय माआं साकऱ्यां पोअ बोईंन माट्योंपोअ बी</para>
  <para style="q2" vid="ACT 2:18">माआं आत्मामेहें रोते ओलीहीं,</para>
  <para style="q2" vid="ACT 2:18">आन तें भविश्यवाणी कोए.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />आन आंय उसे जुगोमेहें समत्कार,</para>
  <para style="q2" vid="ACT 2:19">आन निसे धरती पोअ वोडे वोडे कामें,</para>
  <para style="q1" vid="ACT 2:19">मोन्ज्ये रक्त, आग आन तुमाणाआं वाद्लो देखाड़ीहीं.<verse eid="ACT 2:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="ACT 2:20" />प्रभुउ वोडा आन महिमावाला दिहोअ आविइलोअ पेल,</para>
  <para style="q2" vid="ACT 2:20">दिही कालू पोड़ीत जाय,</para>
  <para style="q2" vid="ACT 2:20">आन सांद रक्ताआ होस ओत जाय.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />ताहरोअ, जों कोडो बी प्रभुउ नाव लेत कोइत प्रार्थना कोए, तों वासाय.”<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />“ए माआं इस्राएलवाला, ए गोठी उनाआ! ईसु नासरी एक जोऊं ओतू, जियाआ देवोअहीं रोते ओवीइलाआ पुरावू मोन्ज्ये, तिया वाअहीं वोडे वोडे कामे, समत्कार आन निशाणी देखाड्यी, इंहीं वाअहीं देवे तुमाआं काजे मान्य कोअल्यू पुरावू एहेलुहू तो माटी ओतू, ओं तुमू सोताहा बी जांअतेहे. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />तियाज ईसुहू, जो देवोअ पेलुज रोत ठरवाअली योजनाअ पुरमाणे तोइत आपाअयू, तुमू तियाहा पापी माअहोंअ आथे क्रुस खांबो पोअ टांगीत कोइत माईंत टाक्यु. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />पोन देवेज तियाहा मोल्याम रोत जिवतु कोअयू, काहाके ओं ओतीज ने सेकतोतो के मोत तियाहा सोताआ ताबाम मिकीत सेके.<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 28:5">मत्तय 28:5</ref>,<ref loc="MAT 28:6">6</ref>; <ref loc="MRK 16:6">मार्क 16:6</ref>; <ref loc="LUK 24:5">लुक 24:5</ref></char></note> <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />काहाके दाविद तियाआ बाप्तिमेहें कोहे, के</para>
  <para style="q1" vid="ACT 2:25">“आंय प्रभुहू कायम माआं सामने देख्युहू:</para>
  <para style="q2" vid="ACT 2:25">याअ काजे के तो माआं हाजाड़्या आथोअहें होये, आन आंय केदिहींज ने लोथड़ो.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />या वाअहीं माआ जिव खुसीम होय आन</para>
  <para style="q2" vid="ACT 2:26">माआ जिब खुसी वाअहीं गीगलाअहे;</para>
  <para style="q2" vid="ACT 2:26">माआ डिल बी आशामेहें जिवे,<note caller="+" style="f"><char style="fr" closed="false">2:26 </char><char style="ft" closed="false">दिल</char></note><verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />काहाके तु माआं जिवोहो अधोलोकोम<note caller="+" style="f"><char style="fr" closed="false">2:27 </char><char style="ft" closed="false">निसऱ्यीइ मोतोअ कोल</char></note> ने रोअहूं देही,</para>
  <para style="q2" vid="ACT 2:27">तु ताआ पवित्र सेवकोहो माहणोमेहें ने जिरुहूं देही.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />तुमे माहूं जिवनोअ वाट देखाड़्यीही;</para>
  <para style="q2" vid="ACT 2:28">ताआ हजरी वाअहीं आंय खुस ओत जाहीं.”<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />“माआं पाव्हीइला, आंय वेगाअ डाया दाविदोअ बाप्तिम तुमुहूं साती ठोकीत कोहो, के तो तोम मोइत गोयू आन तियाहा डाटीत बी देदू, आन तियाआ माहोंण आज बी आपाआ जागे होय. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />तो देवोअ भविश्यवक्ता ओतू, आन तियाहा मुंदू ओतू, के देवे शप्पत खादीही: आंय ताआ पारवाड़ी मेहें रोते एका जोओंहों ताआ गादीपोअ बोहाड़ीहीं; <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />तिये ओवनारी गोठीही पेलुज रोत पालित कोइत ख्रिस्ताआ जिवीत उठीइलाअ बाप्तिमेहें भविश्यवाणी कोअयी के,</para>
  <para style="q1" vid="ACT 2:31">“तियाआ जिव अधोलोकोम नाहां टाक्यु,</para>
  <para style="q2" vid="ACT 2:31">आन नाहां तियाआ तोड़ोहो माहणोमेहें जिरुहूं देदो.”<verse eid="ACT 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 2:32" />याज ईसुहू देवे मोल्याम रोत जिवाड़्यू, जियाआ आमू आखे साक्शीदार होय. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />एहें कोइत तियाहा देवोअ हाजाड़्या आथो वोल आखा रोत उसो पद जोड़्यो, आन बाह्हापोअ रोत तो पवित्र आत्मा जोड़्यू जियाआ बाप्तिम आथवसन आप्योतो, ते भेट ओली देदीही, जों तुमू पालतेहे आन उनाअतेहे. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />काहाके दाविद तोम होरगामेहें नाहां गोयू; पोन तो सोताहा कोहे,</para>
  <para style="q1" vid="ACT 2:34">“‘प्रभु माआं प्रभुहू कोयो,</para>
  <para style="q2" vid="ACT 2:34">माआं हाजाड़्यीइ वोल बोहो,<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />जाअहूं जाआं के आंय ताआ दुस्मोनोहों ताआ गुडाआ निसेए पाट्लू ने बोणावी देंव.’<verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />“याअ काजे ओमे इस्राएलोअ बादे माअहें जाईंत लेअहूं जोवे, के ईसुहू जियाहा तुमू क्रुस खांबो पोअ सोढव्यू, तियाहाज देवे प्रभु बी आन ख्रिस्त बी ठरव्युहू.”<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />तेहेलाम उनाअनाराआ मोनोहों लागीत गोयो, आन तें पेत्राहा आन बाकी प्रेशितोहों फुसे वोल्ये, “पाही, आमू की कोओमें?”<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />पेत्र तियांहां कोयो, “मोन फिरवा, आन तुमामेएं हारेक जोओं जिवज्योअ पापोअ माफीइ काजे ईसु ख्रिस्ताआ नावसे बाप्तिस्मा लेवा; ताहां तुमुहूं पवित्र आत्माआं दान जोड़े. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />काहाके ओं आथवसन तुमाअरी आन तुमाआं पोर्‍याआं काजे आन तियां दुर दुर्‍याआ आखा माअहुंउं काजे बी होय, जियांहां प्रभु आपाअ देव तियाआ जागे हादे.”<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />तिये वारुज बिहीरी गोठी वाअहीं बी साक्शी आपी-आपीइ समजाड़्यो, के “तुमू यी खाराब जातीइ माअहूं रोत सोताआ जिवोह वासाड़ा.” <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />याअकाजे जियां तियाआ वसन स्विकार कोअयो, तियां बाप्तिस्मा लेदो; आन तेदिहींज तीन हाजार माअहें तियांअरी जुड़ात गोये. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />आन तें प्रेशितों पोअ रोत हिकाइलोअ, आन संगतीम रोअलोअ, आन रोटू मुडीइलोअ, आन प्रार्थना कोइलोअ यामेहेंज रोतेते.<verse eid="ACT 2:42" /></para>
  <para style="s">विश्वासी माअहोंअ जिवन</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />ताहां आखे माअहें बित गोये, आन प्रेशितों वाअहीं खुब वोडे वोडे कामें आन समत्कार ओवताते. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />आखे विश्वास कोअनारे एकठेज रोतेते, आन तियांआं आखी वस्तु गोवांदीमेहें ओती. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />तें जिव जिवोअ मालधन वेसी वेसीइ जियांआं जेहलीही गरज तेहेंज कोइत वाटीत आपी देतेते. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />तें दाड़ख्येए एक मोन ओत कोइत मंदिरोम टोलू ओवतेते, आन तियांआं कोओं-कोओं खुसी आन खोरा मोनो वाअहीं रोटू खातेते, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />आन देवोअ स्तुती कोअतेते, आन आखे माअहें तियांहां पालित खुस ओवतेते: आन जियांहां तारण जोड़तोतो, तियां माअहुंहूं प्रभु तियांमेहें जुड़ी देतुतो.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">लेंगडा भिखारीइ हुदरीइलो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />एक दिही पेत्र आन योहान दिहे तीन वाजता प्रार्थनाअ वेले मंदिरोम गोया. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />आन माअहें एका जल्मार्‍याआ लेंगड़ाहा लेतावीत दाड़ख्येए मंदीरोअहीं “बाहरी” नावोअ बाअपुरे मंदिरोमेहें जानारा पोअ बिख मागे तेहें बोहाड़ी देतेते. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />जेहेलाम तिये पेत्राहा आन योहानोहो मंदिरोमेहें जात्लाहा देख्या, ताहां तिये तियांपोअ बिख माग्यी. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />पेत्रे योहानोअरी तियाआ वोलेहे ध्यान लागाड़ीत पाल्योन कोयो, “आमाअहें पाल!” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />याअकाजे तो की तेबी मिले एहेलिही आशा मिकीत तियांआं वोग पालु वोल्यू.<verse eid="ACT 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 3:6" />ताहरुउ पेत्रे कोयो, “मापोअ नाहां सांदी आन नाहां होनो, पोन जो मापोअ होय तों ताहूं आपोहो; नासरेथवाला ईसु ख्रिस्ताआ नावसे सालु वोल.” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />आन पेत्रे तियाहा हाजाड़्यू आथ तोइत कोइत उठाड़्यु; आन ताब्बुड़ तियाआ गुडाम आन टोसणोम सेक्ती आवित लागी. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />तो उसलीइतुज उबू रोत गोयू, आन सालु-फिरु वोल्यू; आन सालतू, नासतू, आन देवोअ स्तुती कोअतूज तियांअरी मंदिरोम गोयू. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />आखे माअहें तियाहा सालत्लू फिरत्लू आन देवोअ स्तुती कोअत्लू पालित कोइते, <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />तियाहा ओलखीत लेदू के ओ तोज भिखारी होय जो मंदिरोअ “बाहरी” नावोअ बाओ पोअ बोहीत कोइत बिख माग्या कोअतुतो; आन ते घटना जे तियाअरी ओवीते, तों देखीत कोइत आखे जुदे बोगलाइत गोये.<verse eid="ACT 3:10" /></para>
  <para style="s">शलमोनोअ ओटापोअ पेत्राअ बाशण</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />जेहेलाम तो पेत्र आन योहानोअ आरी ओतू, ताहां आखे माअहें जाअखीलेहे बोगलाअतेज शलमोनोअ ओटू कोतेहे तियी जागे गुगदीइतेज आये. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />ओं पालित कोइत पेत्रे माअहुंहूं कोयो, “ए इस्राएलवाला, तुमू या माहुंहूं देखीत काहा बोगलाअतेहे? आन आमाआं वोलेहे एहें कोइत काहा पालतेहे? तुमुहूं लागतोय के आमाआं सोताआ सेक्ती भक्ती वाअहीं याहा आमू सालतू फिरतू कोई देदू. <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />अब्राहाम, इसाहाक आन याकोबोअ देव, आपाअ डायहांआं देवे तियाआ सेवक ईसुउ महिमा कोअयी, जियाहा तुमू तोइत आपी देदू, आन जेहेलाम पिलाते तियाहा सोड़ी देअलोअ विसार कोअयू, तेहेलाम तुमू पिलातोअ हुंबर तियाआ नाकार कोअयू. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />तुमू तिया पवित्र आन धर्मीइ नाकार कोअयू, आना विनंती कोअयी के एका माहोंण माराहा तुमाआं काजे सोड़ी देअहूं जोवे;<note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">मत्तय 27:15-23</ref>; <ref loc="MRK 15:6-14">मार्क 15:6-14</ref>; <ref loc="LUK 23:13-23">लुक 23:13-23</ref>; <ref loc="JHN 19:12-15">योहान 19:12-15</ref></char></note> <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />आन तुमू जिवनोअ उकलाहा माईंत टाक्यु, जियाहा देवे मोल्याम रोत जिवतु कोअयू; आन यी गोठीइ आमू साक्शीदार होय. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />आन तियाआज नावम, तिया विश्वासो वाअहीं जो तियाआ नावोपोअ होय या माहुंहूं ताकत जोड़्यीही; जियाहा तुमू पालतेहे आन जांअतेहे बी, तियेज विश्वासे जो तियाआ नावो वाअहीं होय, याहा तुमा आखाआ हुंबर मोस्तेए हुदारी देदुहू.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />“ओमे ए पाव्हीइला, माहूं मुंदू होय, के ओं काम तुमू विण जांअयेंज कोअयो, आन एहेंज कोइत तुमाआं पुढाऱ्यों बी कोअयो. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />पोन जियीं गोठीही देवे आखा भविश्यवक्ताआं जिबानी वाअहीं पेलुज कोत देदीते, के तियाआ ख्रिस्त दुख वेठे, तियीं गोठीही तिये एहें कोइत पुरी कोअयी. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />तिहीं वाअहीं, पापोअहें रोत मोन फिरवा आन वोलीत आवा मोन्ज्ये तुमाआं पाप माफ ओत सेके, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />आरामोअ दिही प्रभुउ तरफ से आवुहूं जोवे आन तो ईसुहू मोकले जो तुमाआं काजे पेलुज रोत ख्रिस्त कोत ठरवाअयुहू. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />तो आखी गोठीइ सुदार कोइत लेय, जियींइं बाप्तिमेहें जुना वाडोम रोत देवे तियाआ पवित्र भविश्यवक्ताआं जिबानी वाअहीं वसन आप्योतो, ताअहूं जाआं तियाआ होरगामेहें रोअलोअ जरुरी होये. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />जेहें कोइत मोशे कोयो, के ‘प्रभु देव तुमाआं पायहोम रोत तुमाआं काजे माआं हारकू एक भविश्यवक्तू उबू कोए, आन जो किबी तो तुमुहूं कोये, तियाआ तुमू उनाअजा.<note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="DEU 18:15">कायदा 18:15</ref>,<ref loc="DEU 18:18">18</ref></char></note> <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />पोन जों माहुंउं तियां भविश्यवक्ताआ गोठ ने उनाये, तों माअहूंम रोत आरवी देवाय.’ <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />आन शमुवेलोअ जागे रोत तियाआ फासाड़ी वालाआ जागे जाआं जेत्ता भविश्यवक्ताहां कोल्यो, तियां आक्खा यां दिहोअ खबर कोत आप्यीही. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />तुमू भविश्यवक्ताआं वारीस आन तिया शप्पतेए भागीदार होये, जे देवे तुमाआं डायहांअरी खादीते, जेहेलाम तिये अब्राहामोहो कोयो, ‘ताआ पारवाडीम रोत धरतीइ बादे माअहें आशिर्वादीत ओवे.’ <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />देवे तियाआ सेवकोहो उठाड़ीत कोइत पेल तुमाआं जागे मोकल्यू, के तुमामेहें रोत हारेक जोओं तुमाआं खाराब गोठीम रोत मोन फिरवे, ताहां तुमुहूं आशिर्वाद आपीत सेके.”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">पोन्साअ सामने पेत्र आन योहान</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />जेहेलाम पेत्र आन योहान माअहुंहूं ओं कोत आपताते, ताहां पुंजारा आन मंदिरोअ डायहां आन सादूकी तियांअहें आया. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />तियांहां खुब खोत लागी काहाके ते बेनू जोओं माअहुंहूं सिकाड़ताते के ईसु मोल्याम रोत जिवीत उठ्युहू आन ओज तो पुरावू होये के मोल्ये बी जिवीत उठे. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />ताहां तियां पेत्र आन योहानोहो तोइत कोइत बिहीरे दिही जाआं जेलेम मिक्या, काहाके वेल पोड़ीत गोयीते. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />पोन वसन उनाअनारा मेहें रोत वारुज जोओं विश्वास कोअयू, आन तियांआं गणती एक आंदास पास हाजार एतीही ओत गोयी.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />बिहीरे दिही एहेलोह ओवो के तियांआं आधिकारी, डायहां आन कायदाअ मास्तर, <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />तिहींमेहें पुंजारा हन्ना आन कैफा, योहान, अलेक्झांडर आन जेताहा पुंजाराआ कुटूंबाअ ओता, आखा येरुसालेमोमेहें टोलू वोल्या. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />ते तियां प्रेशितोहों विसमेहें उबा राखीत फुसा वोल्या, के “तुमू ओं काम कोड्ली सेक्ती वाअहीं आन कोडाअ नावो वाअहीं कोअयो?”<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />ताहरुउ पेत्रे पवित्र आत्मा वाअहीं पोआईत कोइत तियांहां कोयो, “ए माअहोंअ पुढाऱ्यों आन डाया: <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />या लेंगड़ा माहुंउंरी हाजी गोठ ओवी, ताहां किहा वाअहीं हुदरीइल्यू कोत आमापोअ तियाआ बाप्तिम आज सौकीशी जर कोअताय, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />ताहां तुमू बी जाईंत ल्या, आन आखे इस्राएली माअहें बी जाईंत लेय के, नासरेथवाला ईसु ख्रिस्ताआ नावसे ओं माहुंउं तुमाआं हुंबर हाजलोज उबो रोयोहो, जियाहा तुमू क्रुस खांबोपोअ टांग्यू, आन देवे तियाहा मोल्याम रोत जिवाड़्यू, <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />ओ ईसु तोज माटी होये, जियाआ बाप्तिम लेख्योहो के,</para>
  <para style="q1" vid="ACT 4:11">“‘ओ तोज डोण होय जियाहा तुमू राजमिस्त्र्यां बी विण कामोअ ठरव्यू</para>
  <para style="q2" vid="ACT 4:11">आन तोज कोपराआ वोडु डोण ओत गोयू.’<verse eid="ACT 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 4:12" />“बिहीरा कोडाज वाअहीं तारण<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="fq" closed="false">तारण </char><char style="ft" closed="false">सुटका, पापोअ माफी</char></note> नाहां; काहाके होरगाआ निसे माअहूंमेहें फाशोअ कोड्लोज बिहीरो नाव नाहां आप्यो, जिया वाअहीं आपुहूं तारण जोड़ीत सेके.”<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />जेहेलाम तियां पेत्राअ आन योहानोअ हिम्मत देख्यी, आन ओं जाअयों, के ए आड़ाम्या आन सादा माटी होये, ताहां बोगलाअया; आन तियांहां मुंदू पोड़्यू, के ए ईसुउरी रोयाते. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />तिया लेंगड़ा माहुंहूं जो हुदर्‍योतो, तियांअरी देखीत कोइते, तियांआं विरुद्दाम ते किज ने कोत सेका. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />पोन तियांहां आराधनालयोअ बारथे जायतेहें कोयोन ताहराआ तियां तियांआं विसार कोआ वोल्या, <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />“आपू यां माअहोंअरी की कोअहूं? काहाके येरुसालेमोम रोनारे आखे माअहूं देख्योहो, के यांवाअहीं एक नावासी समत्कार देखाड़्युहू; आन आपू तियाआ नाकार नाहां कोइत सेकता. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />पोन याअकाजे के ए गोठ माअहूंमेहें फाशीइ वादार पसरीत ने जाअहूं जोवे कोत आपू तियांहां धमकी देत्ला, के ते या नावोवाअहीं फाशाआ कोडा माअहोंअरी गोठी ने कोअहूं जोवे.”<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />ताहां पेत्र आन योहानोहो हाद्या आन आदेश आपीत कोइत कोयो, “ईसुउ नावोवाअहीं किज मा सोकहा आन कीज मा सिकाड़हा.” <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />पोन पेत्र आन योहाने तियांहां उत्तर आप्यो, “केहें आमू देवोअ गोठी रोत वादार तुमाआं गोठ मानीइली, ओं देवोअ नजरेम केतोह बोराबर होय तो तुमूज ठरवा. <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />काहाके, ओं ते आमा वाअहीं ने ओत सेके के, जो आमू पाल्यो आन उनाअयाहा, तो ने कोंव.” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />ताहां तियां पेत्राहा आन योहानोहो फाशीइ धमकी आपीत कोइत सोड़ी देदा, काहाके माअहुंउं वोजेसे तियांहां डोंड आपीइलाअ कठीण ओत गोयो, याअकाजे के जे घटना ओवीते तियीइ काजे आखे माअहें देवोअ स्तुती कोअतेते. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />तो हुदरीइनारो माहुंउं, जियापोअ ओं हुदरीइलाअ समत्कार देखाड़्युतो, सालीही वोर्ह्यों रोत वादार डायो ओतो.<verse eid="ACT 4:22" /></para>
  <para style="s">विश्वासी माअहोंअ हिम्मतोअ काजे प्रार्थना</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />पेत्र आन योहान सुटित कोइत तियांआं जोड़ीदारोअ जागे आया, आन जो कि बी आधिकारी आन डायहां तियांहां कोयोतो, तों तियांहां कोताप्यो. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" /><note caller="+" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="EXO 20:11">निर्ग 20:11</ref>; <ref loc="NEH 9:6">नहे 9:6</ref>; <ref loc="PSA 146:6">भजन 146:6</ref></char></note>ओं उनाइत तियां एक मोन ओत कोइते जोरे आवाजोम देवोहो कोयो, “ए मालिख, होरगो, धरती, दोर्‍या आन तियामेहें जों किबी होये, तों आखो तुमेज बोणायोहो! <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />पवित्र आत्मा वाअहीं ताआं सेवक आमाआं कुलपती दाविद याआ जिबानी वाअहीं तुमे कोयो,</para>
  <para style="q1" vid="ACT 4:25">“‘बिगर यहुदी माअहूं दोंगू काहा माताड़्यू?</para>
  <para style="q2" vid="ACT 4:25">आन देसो देसोअ माअहें फालतू योजना काहा बोणायी?<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:26 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:1">भजन 2:1</ref>,<ref loc="PSA 2:2">2</ref></char>
    </note>प्रभु आन तियाआ ख्रिस्ताआ विरुद्दाम</para>
  <para style="q2" vid="ACT 4:26">धरतीइ राजहां उबा रोया,</para>
  <para style="q2" vid="ACT 4:26">आन पुडारी आखा एकठा ओत गोया.’<verse eid="ACT 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:27 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:1">मत्तय 27:1</ref>,<ref loc="MAT 27:2">2</ref>; <ref loc="MRK 15:1">मार्क 15:1</ref>; <ref loc="LUK 23:1">लुक 23:1</ref>,<ref loc="LUK 23:7-11">7-11</ref>; <ref loc="JHN 18:28">योहान 18:28</ref>,<ref loc="JHN 18:29">29</ref></char>
    </note>“काहाके हुदाअलीज ताआ पवित्र सेवक ईसुउ विरुद्धामेहें, जियाअ तुमे अभिशेक कोअयू, हेरोद आन पंतीयुस पिलात बी बिगर यहुदी आन इस्राएल वालाअरी या होयरोमेहें एकठा ओवाहा, <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />काहाके जों किबी पेल रोत ओवे तेहें काजे ताआ सेक्ती आन इश्शा वाअहीं ठरव्योतो, तोंज ते कोअहूं जोवे. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />ओमे ए प्रभु, तियांआं धमकी देअलाअहें पाल; आन ताआ सेवकोहों ओं वरदान आप, के ताआ वसन वोडी हिम्मतो वाअहीं कोत सेके. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />तू ताआ आथ हुदारीइलोअ काजे नांबू कोअ, काहाके समत्कार आन वोडे वोडे कामे ताआ पवित्र सेवक ईसुउ नावो वाअहीं ओवुहूं जोवे.”<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />जेहेलाम तियां प्रार्थना कोइत लेदी, तेहेलाम तिहींइं तो जागू आलित गोयू जिहीं तें एकठे ओवेते, आन ते आखे पवित्र आत्मा वाअहीं पोआइत गोये, आन देवोअ वसन हिम्मतो वाअहीं कोतापते रोये.<verse eid="ACT 4:31" /></para>
  <para style="s">विश्वासी माहें तियांआं मालधन वाटीत खात्ले</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />विश्वास कोअनारा माहुंउं मंडड़ी एका मोनोअ आन एका जिवोअ ओती, एतेहे जाआं के कोडोज बी सोताआ मालधन माआं ने कोतोतो, पोन आखो बादो गोवांदीमेहें सालतोतो. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />प्रेशित वोडी सेक्ती वाअहीं प्रभु ईसुउ जिवीत उठीइलाअ साक्शी देता रोया आन तियां आखा पोअ वोडी मेरवानी ओती. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />तियांमेहें कोडोज गरीब ने ओतो, काहाके जियांपोअ खेते, नेत कोएं ओते, तियांहां तें वेसी वेसीइ जे किंमत आवतीते तेज किंमत आपी देतेते; <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />आन तियीही प्रेशितोंअ गुडाअ जागे मिकतेते; आन जेहलीही जियाहा गरज रोतीते, तियाआ पुरमाणे हारेक जोओंहों तें वाटी देतेते.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />योसेफ नावोअ सायपरसोअ एक लेवी ओतू जियाआ नाव प्रेशितहों बरनबास, मोन्ज्ये “हिम्मत आपनारु.” मिक्यतो. <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />तियाआ थोड़ेक खेते ओते, जियांहां तिये वेशे, आन खेतोअ किमतेए पोशा लेतावीत कोइत सेलाअ गुडाअ जागे मिकी देदा.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">हनन्या आन सफीरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />हनन्या नावोअ एक माटी जो तियाआ लाडी सफीराअरी तियांआं थोड़ुक जागू वेशु. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />आन तियी किंमतेमेहें रोत तिये थोड़ाक पोशा मिकीत लेदा, आन ए गोठ तियाआ लाडीही बी मुंदू ओतू, आन तियाआ एक भाग लेतावीत कोइते सेलाअ गुडाअहीं मिकी देदू. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />पेत्रे कोयो, “ए हनन्या! सैताने ताआ मोनोमेहें ए गोठ काहा टाक्यी के तू पवित्र आत्माहां ठोगे, आन जागाअ किंमतेमेहें रोत थोड़ाक पोशा मिकीत लेय? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />जाअहूं जाआं जागू तापोअ ओतू, ताअहूं जाआं तो ताआ ने ओतो के? आन जेहेलाम जागू वेसाअयू, तेहेलाम पोशा ताआ ताबाम ने ओता के? ताहां तुमे एहेलोह काम कोइलाअ ताआ मोनोम विसार काहा कोअयू? तू माअहुंहूं नाहां, पोन देवोअ आगाड़ी खोटो गोग्युहू.” <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />ए गोठ उनाअताज वाआ हनन्या उठ्लीत पोड़्यू आन जिव सोड़ी देदू, आन आखा उनाअनाराम बिक फोहीत गोयी. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />ताहराअ जुवान उठीत कोइत तियाआ सिड़ी बोणावीत बारथे लेत जात कोइत ओजी देदो.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />एहेलाहा तिनेक तासोअ फासाड़ी तियाआ लाडी मायते आयी, पोन जे गोठ ओवी ते तियीही ने मुंदू ओतू.<verse eid="ACT 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 5:8" />ताहरोअ पेत्रे तियीही कोयो, “माहूं को, केहें तुमू तो जागू तेताआज वेसल्यू के?” तियी कोयो, “होव, तेताआजे.”<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />पेत्रे तियीही कोयो के, “ओं केहें ओवो, के तुमू बेनू जोएं प्रभुउ आत्माआं परिक्शाआ काजे एक मोन कोइत लेदो? पाल, ताआ माट्योहो ओजनारा बाअणापोअ उबलाज होये, आन ताहूं बी बारथे लेत जायमे.” <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />ताहरीइ ते ताब्बुड़ तियाआ गुडाअ जागे उठ्लीत पोड़्यी, आन जिव सोड़ी देदू; आन जुवान्या मायते आवित कोइते तियीही मोल्यीज देख्यी, आन बारथे लेत जात कोइत तियीइ माट्योअ जागे लेत जात ओजी देदी. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />पुरी मंडड़ीइ माअहें आन यी गोठीइ उनाअनारे आखे माअहें जाअखीलेहे बित गोये.<verse eid="ACT 5:11" /></para>
  <para style="s">समत्कार आन वोडे वोडे कामे</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />प्रेशितोंअ आथोवाअहीं जाअखीलाहा समत्कार आन वोडे वोडे कामे माअहुंउं विसमेहें ओवतेते, आन तें आखे विश्वासी एक मोन ओत कोइत शलमोनोअ ओटापोअ टोलू वोलीत ओते. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />पोन बिहीरा कोडाअ ए हिम्मत ने ओवतीते के तियांअरी जुड़ात सेके; तेबी माअहें तियांआं वोडाय कोअतेते. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />पोन विश्वास कोअनारे जाअखीलेहे बोईंन माटी प्रभुउ मंडड़ीम आवित जुड़ाअतेते. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />एतेहे जाआं के माअहें मांदवाड़्याहां सडके पोअ लेतावी लेतावीइ खाट्ला आन सटायी पोअ लोटाड़ी देतेते, के जेहेलाम पेत्र आवे ताहां तियाआ सावलू तेबी तियां एखा पोअ पोड़े. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />येरुसालेमोअ आहने-पाहने सेहरोम रोत खुब माअहें मांदवाड़्ये आन पुते दोमल्ये एहेलाहा लेतावी लेतावीइ टोलू कोअतेते, आन बादे हुदरीत जातेते.<verse eid="ACT 5:16" /></para>
  <para style="s">प्रेशितोंहों सताव</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />ताहां डायु पुंजारु आन तियाआ आखा हाती जे सादूकी जातीइ ओता, प्रेशितों पोअ आद्राय कोआ वोल्या. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />आन तियां सेलाहां तोइत कोइत जेलेमेहें केंडी देदा. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />पोन राती प्रभुउ एके देवदुते जेलेए बाअणो उगाड़ीत कोइते तियांहां बारथे लेतावीत कोइत कोयो, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“जावा, मंदिरोम उबा रोत कोइत या जिवनोअ आखी गोठी माअहुंहूं कोतापा.”<verse eid="ACT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 5:21" />ते ओं उनाइत कोइत हुसता हुसता मंदिरोम जात कोइत हिकवोण आपा वोल्या. ताहराअ डाया पुंजारा आन तियाआ हाती आवित कोइत महासभाहा आन इस्राएल वाला बादा डायहांहां टोलू कोअया, आन तियांहां लेतावे तेहें जेलेमेहें कोत मोकल्यो. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />पोन आधिकारी तिहीं आया, तेहेलाम तियांहां ते जेलेमेहें ने सापड़्या, आन वोलीत आवित खबर आप्यी, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />“आमू जेलेहे वारुहूं सांबालित बोंद कोअल्यी आन जागल्याहां बारथे बाओ पोअ उबा रोल्या देख्या; पोन जेहेलाम बाआ उगाड्यो, तेहेलाम मांयते कोडोज ने सापड्यो.” <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />जेहेलाम डाया पुंजारा आन मंदिरोअ मुख्य आधिकार्‍यों ए गोठ उनाअया, ताहां तियांआं बाप्तिमेहें जुदा बोगलाअया के प्रेशितोंअ की ओवो! <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />तेताजमेहें एके जोएं आवित कोइते तियांहां कोयो, “जियांहां तुमू जेलेमेहें केंड्याते, ते माटी मंदिरोम उबा रोत कोइत माअहुंहूं सिकाड़ताहा.” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />ताहरुउ सिपायडाअ आधिकारी तियाआ माट्योहों लेत जात कोइते प्रेशितोहों लेतायू, पोन तियांपोअ जबरजस्ती ने कोअयी, काहाके तियांहां माअहें डोणो वाअहीं ने देअहूं जोवे कोत ते माअहुंहूं बिताते.<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />सिपायडां प्रेशितोहों लेतावीत कोइत वोडा पोन्साअ हुंबर उबा कोइ देदा; ताहरोअ मुख्य पुंजारां तियांहां कोयो. <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />“आमू तुमुहूं कड़क आदेश आप्युतो के तुमू या नावोवाअहीं मा सिकाड़हा, पोन पाला, तुमू ते फाशाअ बी आखा येरुसालेम होयरोहो तुमाआं हिकवोणो वाअहीं पोई देदोहो! आन तिया माहुंउं खुनोअ आरोप आमाआं बोसी आलवुहूं होदताहा.”<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />ताहराअ पेत्र आन आरीइ प्रेशितों उत्तर आप्यो, “आपू माअहोंअ आदेशो रोत वादार देवोअ आदेशोहों मानिइलोअ जाअखी गरज होये. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />आपाअ डायहांआं देवे ईसुहू जिवाड़्यू, जियाहा तुमू क्रुस खांबो पोअ टांगीत कोइत माईंत टाक्युतो. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />देवे बी तियाहाज सोताआ हाजाड़्या आथोअ वोगेहे पुडारी आन तारनारु कोत बोणावी देदू, मोन्ज्ये तो इस्राएल वालाहां मोन फिरावीलाअ सेक्ती आपे आन पापोअ माफी आपित सेके. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />आमू यी गोठीइ साक्शीदार होये, आन जे तियाआ आदेश मानतेहें तियांहां देवे जो पवित्र आत्मा भेट कोत आप्युहू, तो बी साक्शीदार होये.”<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />ओं उनाइत कोइत ते खिजवात गोया, आन प्रेशितोहों माईंत टाकीइलोअ ईतव्यो. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />पोन तियांमेहें रोत गमालिएल नावोअ एक जोऊं ओतू जो एक कायदाअ मास्तर बी ओतू, आन तो फरिसी आन आखा माअहूंमेहें हाजू गणाअतुतो, तिये पोन्सामेहें उबू रोत कोइत प्रेशितोहों एक घेड़ी बारथे काडीइलोअ आदेश आप्यू. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />ताहरुउ पोन्सात्या माहुंहूं कोयो, “ए इस्राएलवाला, तुमू जों किबी यां माट्योंअरी कोइलाअ ईतवीइताहा, तों समजीत कोइत कोअजा. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />काहाके तुमुहूं ओर ते ओयजे के थोड़ाक दिहोअ पेल थियुदास ओ आगाड़ी आवित आंयहांआं कि तेबी होय कोतूज उठ्यू; आन शार होव केतेहे माअहें तियाआ वोलेहे वालित लेदे, पोन जेहेलाम तो माआंयू, ताहां जेते बी माअहें तियाआ वोलेहे ओते, तें बादे वेरासेर ओत गोये आन आरवात गोये. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />तियाआ फासाड़ी नावे टिपीइलाअ दिहोमेहें यहुदा गालीलवालू उठ्यू, आन थोड़ेक माहें हाती कोइत लेदे; तो बी आरवात गोयू आन तियाहा मानतेते तें बी आखे वेरासेर ओत गोये. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />तियाहाज काजे ओमे आंय तुमुहूं कोहो, यां माट्यों रोत सेटेज रोवा आन यांहां यांअ यांआं रोअहूं द्या; काहाके जर ओं काम माअहूंअहें रोत ओय, ताहां तो आरवात जाय; <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />पोन जर देवोअहीं रोत ओय, ताहां तुमू तियांहां केदिहींज नाहां आरवीत सेकता. एहेलोह ने ओवुहूं जोवे के तुमू देवोअरी बी सुलाअनारा ठरे.” <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />ताहराअ ते तियाआ गोठ मानित लेदी; आन प्रेशितोहों हादीत कोइत मार खावाड़्यू; आन ओ आदेश आपी देदू के फाशाअ फिरीत ईसुउ नाव लेत कोडाअरी गोठी मा कोअहा. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />ते यी गोठी वाअहीं खुस ओत कोइत वोडा पोन्साम रोत जाता रोया, के आमू तियाआ नावोवाअहीं अपमानोअ लायक तेंव ठर्‍या. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />ते रोत दिही मंदिरोमेहें आन कोओं कोओं सिकाड़ता, आन यी गोठीइ हाजी बातमी कोत आपीइलोअ ने सोड़्यो के ईसुज ख्रिस्त होय.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">हांत सेवकोहों निवडीइलोअ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />तियां दिहोमेहें जाहां सेलाआं गणती खुब वादी वोल्यी, तेहेलाम ग्रीक बाशा गोगनारे इब्री बाशा वालांपोअ टुटणे वोल्ये, के दाड़ख्यीइ वाटणीइ सेवामेहें आमाआं रोंडाअली बायहींइं कोडो कालजी नाहां कोअतो. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />ताहराअ ते बारा सेला विश्वास्याआं मंडड़ीही तियांआं जागे हादीत कोइत पोन्सू बोहाड़्यू ताहरोअ कोयो, “ओं बोराबर नाहां, के आपू देवोअ वसन सोड़ीत कोइत खाअलान पीइलाआ सेवामेहें रोअहूं जोवे. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />तियाहा काजे, ए पाव्हीइला, तुमू आपामेहें रोत हांत हाजा माट्योहों जे पवित्र आत्मा वाअहीं आन बुद्दी वाअहीं पोआला ओय, तियांहां निवड़ीत ल्या, मोन्ज्ये आमू तियांहां या कामोअ काजे ठरवी देहूं. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />पोन आमू ते प्रार्थना आन वसन कोत आपीइलाआ सेवामेहें लागीत रोहूं.”<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />ए गोठ आखी मंडड़ीही पोट्यी, ताहां तियां स्तिफन नावोअ एका माट्योहो जो विश्वासो वाअहीं आन पवित्र आत्मा वाअहीं पोआलू ओतू, आना फिलीप, प्रोखुरुस, नीकानोर, तीमोन, परमिनास, आन अंताकियावालू नीकलाव जो यहुदी बोण्युतो, यांहां निवड़ीत लेदा. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />तियांहां प्रेशितोंअ हुंबर उबा राख्या आन तियां प्रार्थना कोइत तियांपोअ आथ मेक्या.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />देवोअ वसन पसरीइतो गोयो आन येरुसालेमोमेहें सेलाआं गणती खुब वादीत गोयी; आन पुंजारका जातीइ वारुज जोओं या विश्वासोहो मानित लेदू.<verse eid="ACT 6:7" /></para>
  <para style="s">स्तिफनोअ तोआइलोअ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />स्तिफन देवोअ वोडी मेरवानी आन ताकते वाअहीं पोआइत कोइत माअहोंअ सामने समत्कार आन वोडे वोडे कामे देखाड़तुतो. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />ताहां तिया यहुदी आराधनालयोमेहें रोते जें सुटली जातीइ यहुदी माहें कोत गणाअतेते, आना कुरेनी आन अलेक्झांद्रिया सेहरोअ आन किलिकिया सेहरोअ, आन आसियाआ माअहूंमेहें रोत थोड़ेक ऊठीत कोइत स्तिफनोअरी सुलाए वोल्ये. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />पोन आत्मा स्तिफनह एहेलिही बुद्दी आप्यी के तो जाहां बी गोठी कोअतुतो, तेहेलाम तियाआ गोठीही ते खोटी ठरवीत ने सेका. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />ताहराअ ते थोड़ाक माअहुंहूं ओं कोय तेहें सिकाड़ी देदे, “आमू याहा मोशेए आन देवोअ विरुद्धामेहें निंदा कोअत्लाहा उनाअया.” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />ताहराआ माअहें आन डायहां आन कायदाअ मास्तर ए आखा पोडकीत उठ्या आन स्तिफनह तोइत कोइत पोन्साअ सामने लेताया. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />आन ठोग साक्शीदार उबा कोअया, तियां कोयो, “ओ माटी सादा या पवित्र जागाआ आन मोशेए नियमोंअ निंदा कोअहे. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />काहाके आमू याहा एहें कोत्लाहा उनाअयाहा के ओज ईसु नासरी या मंदिरोहो निसे पाड़ी देये, आन तियीं रितिही बोदलीत टाकी देये जे आपुहूं मोशेप रोत जोड़्यीही!” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />ताहां आखा माअहूं जें पोन्सामेहें बोठेते, तियापोअ नजर टाक्यी ताहां तियाआ सोब देवदुतोअ होस देख्यी.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">स्तिफनोअ बाशण</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />ताहां डाये पुंजारके स्तिफनोह फुशो, “केहें ए गोठी खोरीज होय के?”<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />स्तिफने उत्तर आप्यो, “ए आखा पाही आन डाया उनाआ! आपाआ आब्हू अब्राहाम हारान देसोमेहें वोहती कोइलाअ पेल जेहेलाम मेसोपोटामिया मेहें ओतू; तेहेलाम महिमावाले देवे तियाहा दर्शन आप्यो. <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />आन तिये अब्राहामोहो कोयो, ‘तू ताआ कुटूंबाम रोत आन देसोम रोत निहींत कोइते आंय ताहूं देखाड़ीहीं तिया देसोम जा.’ <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />ताहरुउ तो कसदीइ देसोमेहें रोत निहीत कोइत हारान देसोमेहें जात वोहती कोअयी. तियाआ आब्हू मोयू तिहींइं फाटी देव तियाहा तिहीं रोत या देसोमेहें लेतावीत कोइत बोहाड़्यू, जिहींम ओमे तुमू वोहती कोइत रोताहा. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />आन या देसोमेहें देवे अब्राहामोहो तियाआ हक्काआ किज ने आप्यो, तेतोज नाहां पोन तियाहा गुडू मिकीइलाअ जागू बी ने आप्यू, पोन देवे शप्पत खादी के आंय ओ देस ताहूं आन ताआ फासाड़ी ताआ पारवाड़ीही हक्काआ कोत आपी देहीं; पोन तिया गालाहा अब्राहामोअ कोड्लोज पोर्‍य ने ओतो. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />आन देवे ओं कोयो, ‘ताआ पोऱ्ये पारका देसोमेहें पारके ओवे, आन ते तियांहां वेठाऱ्ये बोणावीत लेये, आन शार होव वोरह्ये जाआं तारास देये.’<verse eid="ACT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 7:7" />“फाशोअ देवे कोयो, ‘जिया देसोअ ते साकरी कोए, तियाहा आंय डोंड आपीहीं, आन याअ फासाड़ी ते निहींत कोइते यीज जागे माआं सेवा कोए.’ <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />आन देवे तियाअरी खतनाआ शप्पत खादी; आन यीज होमसे अब्राहामोहो इसाहाक ओवू, आन आँठ दिहोमेहें तियाआ खतना कोअयू; आन इसहाकोअ याकोब ओवू आन याकोबोअ बारा पोर्‍या ओवा, जे आपाआ कुलपती बोण्या.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />“वेगाअ डायहां योसेफोअरी आद्राय कोइत तियाहा मिसर देसोम जानाराहां वेसीत खात गोया, पोन देव तियाअरी ओतू, <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />आन योसेफोहो तियाआ आखा तारासोमेहें रोत सोड़वीत कोइत मिसर देसोअ राजा फारोअ नजरेमेहें मेरवानी आन बुद्दी आप्यी, आन फारो राजा तियाहा मिसर देसोपोअ आन तियाआ आखा कोअमेहें आधिकारी नेम्यू. <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />ताहरोअ मिसर आन कनानोअ आखा देसोमेहें काल पोड़्यू; जिया वाअहीं खुब वोडु हाल ओवू, आन आपाअ वेगाअ डायहांहां दाणा ने जोड़ताते.<note caller="+" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="GEN 42:1">उत्प 42:1</ref>,<ref loc="GEN 42:2">2</ref></char></note> <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />पोन याकोबे ओं उनाइत कोइत के मिसर देसोमेहें दाणा होये, आपाअ वेगाआ डायहांहां पेल्लीज वारी मोकल्या. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />बिहीरी खेपे योसेफे तियाआ पायहोहो तियाआ बाप्तिम कोताप्य आन फारोहो योसेफोअ कुटूंबाआ मुंदू जोड़्यू. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />ताहरुउ योसेफ तियाआ आब्हा याकोबोहो आन तियाआ पुरा कुटूंबाहा, जें पोन्शात्तर माअहें ओते, तियांहां हादे मोकल्ये. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />ताहरुउ याकोब मिसर देसोमेहें गोयू; आन जिहीं तो आन आपाआ वेगाआ डायहां मोइत गोया. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />तियांआं तोड़ शेखेमोमेहें लेतावीत कोइत तिया माहणोमेहें ओजी देदे, जियाहा अब्राहामे सांदी आपीत कोइत हमोरोअ पोर्‍यापोअ वेसात लेदोत.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />“पोन जेहेलाम तियी शप्पतेए पुरो ओवीइलाआ वेल आहने आयी जे देवे अब्राहामोअरी खादीते, ताहरेए मिसर देसोमेहें तें माअहें जाअखीलेहे वादीत गोये आन गणतीमेहें जाअखे ओत गोये. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />ताहरुउ मिसर देसोमेहें बिहीरु राजा आयू जो योसेफोह ने ओलखीइतुतो. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />राजा आपाआ घराणाअरी हुशारी कोइत आपाअ वेगाअ डायहांअरी एतुहू खाराब साल्यू, के तियांहां सोताआ पोर्‍ये टाकी देअलो पोड़्यो के तें जिवते ने रोअहूं जोवे. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />तिया गालाहा मोशेए जल्म ओवो. तो देवोअ नजरेमेहें खुब हाजू ओतू. तो तीन मोयना जाआं तियाआ आब्हाअ कोअमेहें वोडु ओवू. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />पोन जेहेलाम टाकी देदू ताहां फारोअ राजाअ बेटिह्ही तियाहा बारथे काड्यू, आन सोताआ पोर्‍यू कोत पोहयू. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />मोशेहे मिसरवालाआं आखी विद्या सिकाड़्यी, आन तो वसन आन काम बेनुमेहें ताकतवान ओतू.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />“जेहेलाम तो सालिही वोरह्योअ ओवू, ताहां तियाआ मोनोम लागो के आंय माआं इस्राएलवाला पायहोंहों मिलो. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />तिये एका पायहोहो तारास कोआड़त्ले देखीत कोइत तियाहा वासाड़्यू, आन मिसरवालाहा माईंत देत तिया तारास कोआडल्याआ बोदलू लेदू. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />मोशेए विसार ओ ओतू के देव माआं आथोवाअहीं तियांआं सुटका कोए; पोन तियां एहेलोह ने समज्यो. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />बिहीरे दिही जेहेलाम ते तियां तियांआं सुलाअया कोअताते, तेहेलाम मोशे तिहीं आयू; आन ओं कोत कोइत तियांहां होमजोण काडीइलोअ कोशित कोअयी, ‘उनाआ पाही, तुमू तोम पाही पाहीज होयेन बेनू एकमेकाअरी काहा सुलाअताहा?’ <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />पोन जो जागर्‍याहा तारास देतुतो, तिये मोशेहे ठेपलीत देत कोयो, ‘ताहूं कोडे आमापोअ आधिकारी आन न्याय कोअनारु ठरव्युहू? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />केहें तू काल मिसरवालाहा माअल्यू तेहेंज कोइत माहूं बी माऊ आयुहू के?’ <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />ए गोठ उनाइत कोइत मोशे नाठू आन मिद्यान देसोमेहें वोहत्यू बोणीत रोनु वोल्यू, आन तिहीं तियाहा बेन पोर्‍या ओवा.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />“जेहेलाम पुरे सालिही वोरह्ये ओत गोये, ताहां एक देवदुत सिनाय डोगोप जंगलोमेहें मोशेहे पेटाअत्ला साटवामेहें दर्शन आप्यो. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />मोशे ओं दर्शन देखीत कोइत बोगलाइत गोयू, आन जेहेलाम पालीइलाअ कोअते आहने गोयू, तेहेलाम प्रभुउ ओ आवाज उनाअयू: <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />‘आंय ताआ डायहांआं देव, अब्राहाम, इसाहाक आन याकोबोअ देव होय,’ तेहेलाम मोशे कापित रोयू, एतीही बिक लागी के तियाहा पालुहूं हिम्मत ने रोयी. <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />ताहां प्रभु मोशेहे कोयो, ‘ताआ गुडामेएं खाहड़े काडी दे, काहाके जिया जागापोअ तू उबू रोयुहू तो पवित्र जागू होये. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />आंय मिसर देसोमेहें रोनारा माआं माअहूं पोअ ओवनारा तारासोहो देख्युहू; आन तियांआं रोड़ीइलो होंबल्योहो. आंय तियांआं सुटका कोअहूं काजे उतर्‍युहू. ओमे तियार ओव! आंय ताहूं मिसर देसोम मोकलिहीं.’<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />“जिया मोशेहे तियां ओं कोत कोइत नाकार्‍यू, ‘ताहूं कोडे आमापोअ आधिकारी आन न्याय कोअनारु कोत नेम्युहूं?’ तियाहाज जिये देवदुते तियाहा साटवामेहें दर्शन आप्यो तिया वाअहीं देवे आधिकारी आन सुटका कोअनारु कोत नेमीत कोइत मोकल्यू. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />ओज मोशे मिसर देसोम आन लाल दोर्‍या आन जंगलोमेहें सालीही वोरह्ये जाआं वोडे वोडे कामे आन समत्कार देखाड़ी देखाड़ीइ तियांहां काडीत लेतायू. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />ओ तोज मोशे होय, जिये इस्राएल वालाहां कोयो, ‘देव तुमाआं पायहोंमेहें रोतीज तुमाआं काजे माआं सारकू एक भविश्यवक्ता उबू कोए.’ <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />ओ तोज होय, जिये जंगलोमेहें मंडड़ीइ विसमेहें तिया देवदुतोअरी सिनाय डोगोपोअ तियांअरी गोठी कोअयीते आन आपाअ वेगाअ डायहांअरी तो ओतू, तियाहाज जिवते वसने जोड़्ये मोन्ज्ये तो आपाअ जागे जाआं पोताडीत सेके.<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />“पोन आपाअ डायहां तियाआ गोठी ने मान्या, गाठ्याअ तियाहा ओनखे कोइत तियांआं मोन मिसर देसोअहें फिरव्यो, <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />आन आरोनोहो कोयो, ‘आमाआं काजे एहेलेहे देवें बोणाव जें आमाआं आगाड़ी आगाड़ी साले, काहाके ओ मोशे जो आमुहूं मिसर देसोमेहें रोत काडीत लेतायू, आमुहूं ने मुंदू के तियाहा की ओवो?’<note caller="+" style="x"><char style="xo" closed="false">7:40 </char><char style="xt" closed="false"><ref loc="EXO 32:1">निर्ग 32:1</ref></char></note> <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />तियां दिहोमेहें तियां एका वासडीइ बासाअ मुर्ती बोणावीत कोइत तियीइ आगाड़ी गाराहा आप्यू, आन तियांआं आथीवल्या कामोवाअहीं मोज्या कोअयी. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />तियाहा काजे देवे तियांआं वोगेहे रोत सोब मुअडीत लेदी आन तियांहां जुगोमेएं ताराआं पुंजन कोए तेहें सोड़ी देदे, जेहलोहो भविश्यवक्ताआं पुस्तकोमेहें लेख्योहो:</para>
  <para style="q1" vid="ACT 7:42">“‘ए इस्राएलोअ माअहूं,</para>
  <para style="q2" vid="ACT 7:42">केहें तुमू जंगलोमेहें सालीही वोरह्ये जाआं मेडा-बोकड़ाआं गाराहा</para>
  <para style="q2" vid="ACT 7:42">आन ओनोअ भेट माहूंज आपतेते के?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />तुमू मोलेकोअ तंबू आन रिफान देवताराहा तोइत कोइत फिरतेते,</para>
  <para style="q2" vid="ACT 7:43">गाठ्येए तियीं मुर्तीहीं जियींहीं तुमू पुंजन कोइलोअ काजे बोणायींते.</para>
  <para style="q1" vid="ACT 7:43">तियाहा काजे आंय तुमुहूं बाबेलोअ आहने लेत जात कोइत वोहती कोआड़ीहीं.’<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />“साक्शीइ तंबू जंगलोमेहें आपाअ डायहांअ विसमेहें ओतू, जेहें कोइत तिये मोशेहे कोयोतो के, ‘जों माप तुमे देख्योहो, तियाज मापोवाअहीं याहा बोणाव.’ <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />तियाज तंबाहा जो तिया वाडोमेहें आपाआ डायहांअ आथे लागुतो, ताहां यहोशवाअरी इंहीं लेताया; तियी होमसे तियां बिगर यहुदीइ जागू ताबाम लेत लेदू, जियांहां देवे आपाअ डायहांअ सामने रोत काडी देदे, आन तो तंबू दाविदोअ वाडोमेहें जाआं रोयू. <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />तियापोअ देवे मेरवानी कोअयी, तियाहा काजे तिये विनंती कोअयी के तो याकोबोअ देवोअ काजे रोअलाअ तंबु बोणावीत सेके. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />पोन शलमोने तियाआ काजे कोअ बोणायो.<note caller="+" style="x"><char style="xo" closed="false">7:47 </char><char style="xt" closed="false"><ref loc="1KI 6:1-38">1 राजां 6:1-38</ref>; <ref loc="2CH 3:1-17">2 इति 3:1-17</ref></char></note><verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />“पोने आखाम रोत वोडु देव आथोवाअहीं बोणावल्या कोअमेहें नाहां रोतू, जेहेंकोइत भविश्यवक्ता कोयो,<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />“‘प्रभु कोहे, होरगो माआं राजगादी</para>
  <para style="q2" vid="ACT 7:49">आन धरती माआं गुडाअ निसेए पाट्लू होये,</para>
  <para style="q1" vid="ACT 7:49">माआं काजे तुमू केहेलोह कोअ बोणावहा?</para>
  <para style="q2" vid="ACT 7:49">आन माआं आरामोअ कोड्लू जागू रोये?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />केहें ए बादी वस्तू माआं आथोवाअहीं बोणायी के?’<note caller="+" style="x"><char style="xo" closed="false">7:50 </char><char style="xt" closed="false"><ref loc="ISA 66:1">यश 66:1</ref>,<ref loc="ISA 66:2">2</ref></char></note><verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />“ए जिद्दी आन कानोअ विणखतनावाला माअहूं, तुमू सादाज पवित्र आत्माआं विरोध कोअतेहें. जेहेंकोइत तुमाआं वेगेए डाये कोअतेते, तेहेंज कोइत तुमू बी कोअतेहें. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />जियाहा तुमाआं डायहां तारास ने कोआड्युये एहेलुहू भविश्यवक्तामेएं एखू सुटुहू के? तियां तिया धर्मी सेवकोअ आविइलाअ बाप्तिम आगी खबर आपनाराहां माईंत टाक्या; ओमे तुमू तिया धर्मी सेवकोह बी तोअनारे आन माअनारे बोण्ये. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />तुमुहूं देवोअ नियम देवदुतोंअ ठरिवल्या वाअहीं ते जोड़्यू, पोन तियाआ पालन ने कोअयो.”<verse eid="ACT 7:53" /></para>
  <para style="s">स्तिफनोपोअ दगडमार</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />ए गोठ्यी उनाइत कोइत तें खिजवात गोये आन तियापोअ दात निसके वोल्ये. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />पोन तिये पवित्र आत्माम पोआइत कोइते होरगाअहें पाल्यो आन देवोअ महिमाहा आन ईसुहू देवोअ हाजाड्यीइ वोल उबू रोल्यू देखीत कोइत कोयो, <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />“पाला, आंय होरगाआ बाआ उगडाअलो आन माहुंउं बेटाह्हाहा देवोअ हाजाड्यीइ वोल उबू रोत रोल्यू देखोहो.”<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />ताहरेए तियां आअड़ीत कोइत कान बोंद कोइत लेदा, आन एकवार्‍येज तियापोअ टुटीत पोड़्ये; <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />आन स्तिफनह सेहरोअ बारथे काडीत कोइत तियाहा डोणाटे वोल्ये, साक्शीदारों तियांआं आंगड़े शाऊल नावोअ एका जुवानोअ गुडाअहीं काडीत कोइत मिकी देदे. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />ते स्तिफनोपोअ डोणाट्याज कोअतेते, आन स्तिफन एहें कोत कोइत प्रार्थना कोअतू रोयू, “ए प्रभु ईसु माआं आत्माहां स्विकार कोअ.” <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />ताहरुउ तिये मांड्या पोड़ीत आअड़ीत कोयो, “प्रभु, ओ पाप यांपोअ मा मोजही,” आन एहें कोत कोइत तिये जिव सोड़ी देदू.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />शाऊल तियाआ खुनोमेहें सामिल ओतू.</para>
  <para style="s" vid="ACT 8:1">शाऊल मंडड़ीइ विरोध कोअत्लू</para>
  <para style="p" vid="ACT 8:1">तेदिहीं रोत येरुसालेमोमेर्‍यीइ मंडड़ीपोअ वोडू तारास सुरु ओत गोयू, आन प्रेशितोहों सोड़ीत बाकी आखे विश्वासी यहुदीया आन शोमरोन देसोमेहें वेरासेर ओत गोये. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />थोड़ेक विश्वासी पाव्हीइले स्तिफनोअ तोड़ोहो माहणोमेहें ओज्यो आन तियाआ कोअते खुब रोड्ये.<verse eid="ACT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3" />शाऊल मंडड़ीही आरवीत टाकीइलोअ कोशित कोअतुतो; आन कोओं कोओं जात कोइते माट्योहोंन बोईंहीं ओडी ओडीइ जेलेमेहें टाकतुतो.<note caller="+" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="ACT 22:4">प्रेशित 22:4</ref>,<ref loc="ACT 22:5">5</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char></note><verse eid="ACT 8:3" /></para>
  <para style="s">शोमरोनोम हाजी बातमीइ परसार</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />जें वेरासेर ओत गोयेते तें विश्वासी माहें जिहीं गोये तिहीं हाजी बातमी कोते फिर्‍ये; <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />आन फिलीप शोमरोन सेहरोमेहें जात कोइते माअहूंमेहें ख्रिस्ताआ परसार कोउ वोल्यू. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />जे गोठी फिलीप्पे कोयी ते गोठी माअहें कान देत उनाअतेते आन जे समत्कार तो देखाड़तुतो तियांहां तें देखतेते. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />काहाके डाहटा जोओंमेहें रोते पुते किगलीइतेज निहींत गोये, आन डाहाटा जोओंमेहें रोत लखवाअ बिमारीवाले आन लेंगड़े बी हुदरीत गोये; <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />आन तिया सेहरोमेहें जुदी खुसी आवित लागी.<verse eid="ACT 8:8" /></para>
  <para style="s">शिमोन जादूगार</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />यारोत पेल तिया सेहरोमेहें शिमोन नावोअ एक माटी ओतू, जो जादूमंतर कोइत शोमरोनोअ माअहुंहूं बोगलाडतुतो आन सोताहा महान समजीइतुतो. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />हानेन वोडे आक्खे तियाहा मान आपते जात कोतेते, “ओं माहुंउं देवोअ तेए सेक्ती होय, जियीही महान सेक्ती कोतेहे.” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />तिये तियांहां खुब पेल रोत तियाआ जादू वाअहीं बोगलाडीत मिक्येते, तिहींज वाअहीं तें तियाहा जास्ती मानतेते. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />पोन जेहेलाम तियां फिलीप्पोअ गोठीपोअ विश्वास कोअयू जो देवोअ राजोअ आन ईसु ख्रिस्ताआ बाप्तिम हाजी बातमी कोत आपतुतो, ताहां माअहें माटीन बोईं बाप्तिस्मा लेने वोल्ये. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />ताहां शिमोने बी विश्वास कोअयू आन बाप्तिस्मा लेत कोइत फिलीप्पोअरी रोनु वोल्यू. आन तो समत्कार आन वोडे वोडे ताकतवाले कामे ओवत्ले देखीत कोइत बोगलाअतुतो.<verse eid="ACT 8:13" /></para>
  <para style="s">शोमरोनोमेहें पेत्र आन योहान</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />जेहेलाम येरुसालेमोमेहें रोनारा प्रेशितहों उनाअया के शोमरोनोअ माअहूं देवोअ वसन मानित लेदोहो ताहां पेत्र आन योहानोहो तियांआं जागे मोकल्या. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />ते बेनू जात कोइत तियां विश्वासी माअहुंहूं पवित्र आत्मा जोड़े तेहें काजे प्रार्थना कोअयी. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />काहाके तिहीं ताअहूं जाआं तियांमेहें कोडाज पोअ पवित्र आत्मा ने उतर्‍युतो; तियां तोम फक्त प्रभु ईसुउ नावो वाअहीं बाप्तिस्मा एतोज लेदोतो. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />ताहराअ पेत्र आन योहान तियांपोअ आथ मिक्या आन तियांहां पवित्र आत्मा जोड़्यू.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />जेहेलाम शिमोने देख्यो, के प्रेशितोंअ आथ मिकताज वाआ विश्वासी माअहोंहों पवित्र आत्मा जोड़ेहे, ताहां तिये तियांआं जागे पोशा लेतावीत कोयो, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />“ओ आधिकार माहूं बी आपा, मोन्ज्ये जिया कोडापोअ आंय आथ मेकिहीं तियाहा पवित्र आत्मा जोड़ीत सेके.”<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />पेत्रे तियाहा कोयो, “ताआ पोशा ताअरी फुकाय, काहाके तुमे देवोअ दान पोशा वाअहीं वेसातो लेअलोअ विसार कोअयू. <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />यी गोठीमेहें नाहां ताआ इसु आन नाहां ताआ भाग होय, काहाके ताआ मोन देवोअ हुंबर सिदो कायनाहां. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />तियाहा काजे ताआ यी खाराबीइहें रोत मोन फेरवीत कोइत प्रभुहू प्रार्थना कोओ, मोन्ज्ये ओत सेकेहे के तो ताआ मोनोअ विसार माफ कोइ देय. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />काहाके माहूं देखाअहे के तू पित्राअ होस कडवू आन पापोअ जालेम पोड़्युहू.”<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />शिमोने तियां पेत्र आन योहानोहो कोयो, “तुमू माआं काजे प्रभुहू प्रार्थना कोआ के जे गोठी तुमू कोयो, ते मापोअ ने आवुहूं जोवे.”<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />ताहराअ ते बेनू साक्शी कोताप्यी आन प्रभुउ वसन कोताप्योन ताहराअ येरुसालेमोम वोलीत गोया, आन शोमरोनोअ डाहटा गावोमेहें हाजी बातमी होंबलाड़ताज गोया.<verse eid="ACT 8:25" /></para>
  <para style="s">फिलीप आन इथीओपिया देसोअ आधिकारी</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />ताहरोअ प्रभुउ एके देवदुते फिलीप्पोहो कोयो, “उठ आन बुड्तामाआं वोगेहे तियी वाटे जा, जे येरुसालेमोम रोत गाजाअहें जाहे.” ए रेटामेर्‍यीइ वाट होये. <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />फिलीप्प उठीत कोइत गोयू, ताहां इथीओपिया देसोअ एक माहुंउं आवत्लो देखाअयो, तों इजड़ाआ जातीइ ओतो आन तों इथीओपिया देसोअ राणी कन्दाकेए मंत्री आन पोशाअ कारभारी ओतो. तों भक्ती कोइलोअ काजे येरुसालेम आयोतो. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />तों तियाआ गाडापोअ बोहीत रोयोतो, आन यशया भविश्यवक्ताआ पुस्तक वासतो वासतो जातोतो. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />तेहेलाम पवित्र आत्मे फिलीप्पोहो कोयो, “आहने जात कोइत या कोड़ाआ गाडाअ जागेहे जा” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />फिलीप तियाआ वोगेहे गुगदीइतुज गोयू आन तियाहा यशया भविश्यवक्ताआ पुस्तक वासत्लाहा उनाअयू, आन तियाहा फुशो “तु जों वासेहे तों ताहूं समजाअहे के?”<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />तिये कोयो, “जाअहूं जाआं एखो माहूं ने समजाड़े ताअहूं जाआं ओं माहूं कि कोइत समजाये?” आन तिये फिलीप्पोहो गाडापोअ सोढ़ीत कोइत तियाआ जागे बोहे तेहें काजे विनंती कोइत हाद्यू. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />वसनोअ जो भाग तों वासतोतों, तो भाग ओ होय:</para>
  <para style="q1" vid="ACT 8:32">“तो माईंलोअ काजे लेत जातेहे तिया मेडाआ होस ओतू,</para>
  <para style="q2" vid="ACT 8:32">आन जेहें कोइत मेडो तियाआ रुंगहे कात्रीइनाराअ आगाड़ी ठावकोज रोहे,</para>
  <para style="q2" vid="ACT 8:32">तेहेंज कोइत तिये बी तियाआ सोब ने उगाड़्यी.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />तियाहा निसेए कोत गोण्यू, तियाआ न्यायनिवाड़ू नाहां ओत सेकू.</para>
  <para style="q2" vid="ACT 8:33">तियी पिढ़ीइ माअहोंअ गोठी कोडो फोड़ीत कोत आपे?</para>
  <para style="q2" vid="ACT 8:33">काहाके धरतीपोर्‍योअ तियाआ जिवन सेलाइत गोयोहो.”<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />ताहरोअ तिये आधिकार्‍ये फिलीप्पोहो फुशो, “आंय ताहूं रावण्या कोअहो, ओ भविश्यवक्ता कोडाआ बाप्तिम कोहे, आपाअ के बिहीरा एखाअ बाप्तिमेहें?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />ताहरुउ फिलीप्पे गोगीइलाअ सुरुवात कोअयी, आन तियाज वसनोम रोत सुरु कोइत तियाहा ईसुउ हाजी बातमी कोताप्यी. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />वाटे सालता सालता ते एका पाअयों जागे पोता. ताहरुउ आधिकारी कोहे, “देख इंहीं पाईं होय, ओमे माहूं बाप्तिस्मा लेअहूं की वांदो होय?” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />फिलीप्पे कोयो, “जर तू पुरा मोनोवाअहीं विश्वास कोअतुय ताहां बाप्तिस्मा लेत सेकेहे.” तिये कोयो, “आंय विश्वास कोअहो के, ईसु ख्रिस्त देवोअ बेटुह्हू होये.”<verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />ताहां तिये आधिकार्‍ये गाडाअ सालाडनाराहा गाडो उबो राखे तेहें कोयो, आन फिलीप्पे आधिकार्‍योहो बाप्तिस्मा आप्यो. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />जेहेलाम ते पाअयोंमेहें रोत बारथे निहीया, ताहां प्रभुउ आत्मा फिलीप्पोहो विसीत लेत जातू रोयू, तिहीं रोत तिया आधिकार्‍योहो तो फिलीप ने देखाअयू, ताहरुउ तो खुस ओवतुज तियाआ वाटे लागीत गोयू. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />फिलीप्पोहो मुंदू गोयू के तो अश्दोदोमेहें होये, आन जाअहूं जाआं केसरिया सेहरोमेहें ने पोतू, ताअहूं जाआं तो गांवों गांवों हाजी बातमी कोतूज गोयू.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">शाऊलोअ मोनोम बदल</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />शाऊल जो ओमे जाआं प्रभुउ सेलाहा धमकी देअलो आन माइत टाकीइलाआ धुंदेमेहें ओतू, तो डाया पुंजाराआ जागे गोयू. <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />आन तियापोअ दमिश्कोअ आराधनालयोअ नावोपोअ यी माहितीइ सिट्टी माग्यी के माटीन बोंईं जो कोडो बी प्रभुउ मार्गाआ विश्वासी देखाय तियाहा बांदीत कोइत येरुसालेमोम लेतावे.<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />पोन जाता जाता जेहेलाम तो दमिश्कोअ आहने पोतू, ताहां एक्काइज जुगोम रोत तियाआ शारी वोल उजालो सोमक्यो, <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />आन तो पुंयींपोअ ओदरीत पोड़्यू आन ओ आवाज उनाअयू, “ए शाऊल, ए शाऊल, तू माहूं काहा तारास कोआड़ेहे?”<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />तिये फुशो, “ए प्रभु, तू कोडू होय?” तिये कोयो, “आंय ईसु होय, जियाहा तू तारास देहे. <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />पोन ओमे उठीत कोइत होयरोम जा, आन ताहूं जो कोइलो पोडनारोहो तो ताहूं कोवात जाय.”<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />जे माटी तियाअरी ओता, ते ठावकाज उबा रोत गोया; काहाके आवाज ताहराआ उनाअताते पोन कोडोज ने देखाअतोतो. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />ताहरुउ शाऊल पुंयींपोअ रोत उठ्यू, आन डोआ उगाड़्या तेहेलाम तियाहा कीज ने हुज्यो, ताहराआ ते तियाआ आथ तोइत कोइत दमिश्क होयरोम लेत गोया. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />तो तीन दिही जाआं आंद्लूज रोयू, आन ने खादो के ने पिदो.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />दमिश्क होयरोमेहें हनन्या नावोअ एक विश्वासी ओतू, तियाहा प्रभु दर्शनोम कोयो, “ए हनन्या!” तिये कोयो, “ओय, प्रभु.”<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />ताहां प्रभु तियाहा कोयो, “उठीत कोइत तियी गेल्लीम जा जियीही ‘सिदी’ कोतेहे, आन यहुदाआ कोअमेहें शाऊल नावोअ एका तारसुसवालाहा फुस; काहाके पाल, तो प्रार्थना कोअया कोअहे, <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />आन तिये हनन्या नावोअ एका माट्योहो मायते आवत्लु आन तियापोअ आथ मिकत्लाहा देख्यू; काहाके फाशुउ पालित सेके.”<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />हनन्ये उत्तर आप्यो, “ए प्रभु, आंय या माट्योअ बाप्तिमेहें डाहटा जोंअं पोअ रोत उनाअयुहू के ये माट्ये येरुसालेमोमेहें ताआ विश्वासी माअहुंहूं खुब तारास देदुहू; <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />आन इंहीं बी ओ डाया पुंजारापोअ रोत आधिकार लेत कोइत आयुहू, काहाके जें माहें ताआ भक्ती कोअतेहें, तियां आखाहा तोइत कोइत लेत जाय.”<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />पोन प्रभु हनन्याहा कोयो, “तू जा; काहाके तो बिगर यहुदीइ आन राजहांआं आन इस्राएलवाला माअहोंअ सामने माआं नाव कोतापे तेहें काजे माआं निवड़ीइल्यू माटी होय. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />आन आंय तियाहा कोहीं के माआ नावोअ काजे तियाहा केहेलो केहेलोह दुख वेठीइलो पोड़े.”<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />ताहरुउ हनन्या उठीत कोइत तिया कोअमेहें गोयू, आन शाऊलोपोअ आथ मिकीत कोइत कोयो, “ए शाऊल पाही, जो प्रभु ईसु ताहूं इंहीं आविइलोअ वेले वाटे ताहूं दर्शन आप्योतो, तियेज माहूं मोकल्युहू के ताहूं फाशोअ देखाओ वोले आन पवित्र आत्मा वाअहीं पोआइत जाय.” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />आन ताअहांज तियाआ डोआमेहें रोत खरपण्ये जेहें की तेबी ओदरीत पोड़्यो आन तियाहा देखाओ वोल्यो, आन तिये उठीत कोइत बाप्तिस्मा लेदो; <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />आन रोटू खादू ताहां तियाहा फाशीइ टोणकाय जोड़्यी.</para>
  <para style="s" vid="ACT 9:19">दमिश्कमेहें शाऊलोअ परसार</para>
  <para style="p" vid="ACT 9:19">तो थोड़ाक दिही दमिश्कमेहें विश्वासी माअहोंअरी रोयू.<verse eid="ACT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />तो शाऊल ताब्बुड़ आराधनालयोमेहें जात कोइत परसार कोऊ वोल्यू के ईसु देवोअ बेटुह्हू होये.<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />आखे उनाअनारे बोगलाइत कोइत कोने वोल्ये, “केहें ओ तो माटी नाहां के जो येरुसालेमोमेहें या नावोअ भक्ती कोअनाराहां आरवीइतुतो? केहें ओ इंहीं याअकाजे ने आयुतो के तियांहां बांदीत कोइत मुख्य पुंजाराआ जागे लेत जाय?”<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />पोन शाऊल जाअखुज ताकतवान ओवतू गोयू, आन यी गोठीइ पुरावू आपित कोइत के ईसुज ख्रिस्त होय, तो दमिश्कमेहें रोनारा यहुद्याआं सोब बोंद कोअतू रोयू.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />जेहेलाम वारुज दिही ओत गोया, ताहराअ यहुदी मिलीत कोइत तियाहा माईंत टाकीइलोअ कदर काड्यी. <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />पोन तियांआं कदर शाऊलोहो जाआंत गोयी. ते तियाहा माईंलाअ काजे रातेन दिही होयरोअ गेटोपोअ हेंहींत बोहीत रोताते. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />पोन राती तियाआ सेला तियाहा बोखामेहें बोहाड़ी देदू आन होयरोअ मेरेमेरे बांदल्या पितड़ाआ खिड़कीमेहें रोत निसे उतारी देदू.<verse eid="ACT 9:25" /></para>
  <para style="s">येरुसालेमोमेहें शाऊल</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />येरुसालेमोमेहें पोतीत कोइत तिये सेलांअरी पेलाइलाअ कोशित कोअयी; पोन आखा तियाहा बिताते, काहाके तियांहां विश्वास ने ओतू, के तोबी सेलू होये. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />पोन बरनबास नावोअ एक सेलू ओतू, तिये तियाहा मदत कोअयी, तो तियाआ आरीइ सेलाआ जागे लेत जात कोइत तियांहां कोत आप्यो, के ये कि कोइते वाटे प्रभुहू देख्यू, आन तिये याअरी केहेलिही गोठी कोअयी; आन कोयो के ये दमिश्कमेहें की कोइते वोडी हिम्मतो वाअहीं ईसुउ नावसे परसार कोअयू. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />तो तियांअरी रोयू आन येरुसालेमोमेहें आवतू जातू रोयू आन हिम्मते वाअहीं प्रभुउ नावसे परसार कोअतू रोयू. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />आन ग्रीक बाशा गोगनारा यहुद्यांअरी गोठी कोइत सोबा-सोबी ओत जातुतो; पोन ते शाऊलोहो माईंलाअ कोशित कोआ वोल्या. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />ओं जाईंत कोइत विश्वासी पाही शाऊलोहो केसरिया लेताया, आन तारसुस होयरोम मोकली देदू.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />एहें कोइत आखे यहुदीया, गालील आन, शोमरोनोमेहें मंडड़ीही आराम मिल्यू, आन ते पान्गीइती गोयी; आन पवित्र आत्माआं शांतीमेहें आन प्रभुउ बिकेमेहें वादती गोयी.<verse eid="ACT 9:31" /></para>
  <para style="s">लुद्दा आन याफामेहें पेत्र</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />तेहलाम एहलोहो ओवो के पेत्र हारेक जागे फिरतू फिरतू, तियां देवोअ माअहोंअ जागे बी पोतू जें लुद्दामेहें रोतेते. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />तिहीं तियाहा एक एनियास नावोअ लखवाअ बिमारीवालो माहुंउं मिल्यो, जों आँठ वोरह्ये ओत गोये खाट्लाजमेहें ओतो. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />पेत्रे तियाहा कोयो, “ए एनियास! ईसु ख्रिस्त ताहूं हुदारेहे. उठ, ताआ आथरुउ विस.” ताहरुउ तो ताब्बुड़ उठीत उबू रोयू. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />ताहरोअ लुद्दा आन शारोनोम रोनारा आखा तियाहा देख्योन प्रभुउ वोगेहे वोल्ये.<verse eid="ACT 9:35" /></para>
  <para style="s">तबीता नावोअ एक विश्वासी बाय</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />याफामेहें तबीता<note caller="+" style="f"><char style="fr" closed="false">9:36 </char><char style="fq" closed="false">तबीता </char><char style="ft" closed="false">मोन्ज्ये “ओंअणी” तियाआ ग्रीक अर्थ दोरकास होय.</char></note> मोन्ज्ये दोरकास नावोअ एक विश्वासी बाय रोतीते. ते खुब हाजे हाजे कामे आन दान कोअतीते. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />तियांज दिहोमेहें ते बिमार पोड़ीत कोइत खारबात गोयी; आन तियां तियीही उंगलावीत कोइत उपर्‍यीइ खुलीम मेक्यी. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />याअकाजे के लुद्दा याफा सेरोअ आहने ओतो, सेला उनाअया के पेत्र तिहीं होय, ताहां बेन माटी मोकलीत कोइत तियाहा विनंती कोअयी, “ताब्बुड़ आमाआं जागे आवेए.” <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />ताहरुउ पेत्र उठीत कोइत तियांअरी गोयू, आन जेहेलाम तो तिहीं पोत्यु ताहां तें तियाहा उपर्‍यीइ खुलीमेहें लेत गोये. आन आखी रोंडाअली बोईं रोड़ती रोड़ती तियाआ जागे आवित कोइत उबी रोयी, आन जे डोगले आन साअके तबीता तियांअरी रोत्ली तेहेलाम जिवती ओती ताहां बोणायेते, देखाड़ी वोल्यी. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />ताहरुउ पेत्र आखाहा बारथे काडी देदे, आन मांड्या पोड़ीत कोइत प्रार्थना कोअयी आन तोड़ोअहें पालीत कोइत कोयो, “ए तबीता, उठ!” ताहरीइ तियी डोआ उगाड़्या; आन पेत्राहा देखीत कोइत उठीत बोठी. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />पेत्र तियीही आथ आगाड़ी कोइत उठाड़्यी, आन आखा विश्वासी माअहोंहों आन रोंडोअ बोईंहीं हादीत कोइत तियीही जिवती कोइत देखाड़ी देदी. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />ए गोठ आखा याफा सेरोमेहें पसरीत गोयी; आन वारुज जोंअं प्रभु पोअ विश्वास कोअयू. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />आन पेत्र याफामेहें शिमोन नावोअ एका सांबड़ाआ धंदू कोअनाराअहीं डाहटा दिही जाआं रोयू.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">कुरनेलियुस आन पेत्र</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />केसरियामेहें कुरनेलियुस नावोअ एक माटी ओतु, जो इटलीयन नावोअ सेयनिकोअ तुकडीइ आधिकारी ओतू. <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />तो देवोहो बित सालनारु भगत माटी ओतू, आन तियाआ पुरो कुटूंब मिलीत देवोअ आराधना कोअतेते, आन गरीब यहुदी माअहुंहूं दान आपतुतो, आन हमेशा देवोहो प्रार्थना कोअतुतो. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />एक दिही तिये तिनेक वाजता दर्शनोमेहें वारुहूं देख्य के देवोअ एक देवदुत तियाआ जागे मायते आवित कोहे, “ए कुरनेलियुस!”<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />कुरनेलियुसे तियाहा ध्यान लागाड़ीत पाल्य आन बित कोइत कोयो, “ए प्रभु! की होय?” देवदुते तियाहा कोयो, “ताआ प्रार्थना आन ताआ दानधरम देवोहो गोम्योहों आन तो ताहूं उत्तर आपीइलाअ काजे तियार होय; <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />आन ओमे याफा गांवोम थोड़ेक माहें मोकलीत कोइत पेत्र कोतेहे तिया शिमोनोहो हादीत ले. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />तो सांबड़ाआ धंदू कोअनारा शिमोनोअहीं पावणू होये, आन तियाआ कोअ दोर्‍याअ टेको पोअ होये.” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />ताहरुउ देवदुत जातू रोयू आन कुरनेलियुसे तियाआ बेन सेवकोहोंन तियाआ एका भगत सिपायोहो नेहें आहने हाद्या. <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />आन तियांहां ओवली आखी गोठी कोत देखाड़ीत याफामेहें मोकल्या.<verse eid="ACT 10:8" /></para>
  <para style="s">पेत्राआ दर्शन</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />बिहरे दिही ते साली सालीइ जेहेलाम याफा गांवोंअ आहने पोत्या, तेहेलाम दिहेए वेले पेत्र कोओपोअ प्रार्थना कोऊ सोढ्यू. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />तियाहा फुक लागीन काविंहीं खांव लागो, रोटाअ तियारी सालुज ओती तेहेलाम तो बेसुद ओत गोयु; <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />आन तिये देख्य, के जुग उगड़ीत गोयो; आन एक बासन वोडा सादराआ होसे शारु खुणा ताइंत धरती पोअ उतरेहे. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />जियामेहें धरतीइ बादी जातीइ शार गुडावाले जनवारे, आन होरतींडनारे जंतू, आन जुगोमेएं सिड़े ओते. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />ताहरुउ तियाहा एक आवाज होंबलाअयू, “ए पेत्रा उठ! आन माईंत कोइत खा.”<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />पोन पेत्रे कोयो, “नाहां प्रभु! आजिबात नाहां; काहाके आंय केदीहींज एठी आन खाराब वस्तू नाहां जी खादी.” <verse eid="ACT 10:14" /><verse number="15" style="v" sid="ACT 10:15" />फाशुउ बिहीरी वारी पेत्र आवाज उनाअयू, “जो किबी देवे सोको कोअयोहो, तियाहा तू एठो मा कोही.” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />तीन वारी जाआं एहेंज कोइत ओवो; आन लगेज तो सादरो जुगोमेहें विसाइत गोयो.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />जेहेलाम पेत्र तियाआ मोनोम विसार कोअतुतो, के ओं दर्शन जो आंय देख्योहो ओं की ओत सेकेहे, तेताजमेहें कुरनेलियुसे मोकलीइल्ये माहें शिमोनोअ कोअ फुसते फुसते खोलीम आवित बाअणाअहीं उबे रोये. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />आन हाद कोइत फुशो, “केहें पेत्र कोतेहे तो शिमोन, इंहींज पावणू होय के?”<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />पेत्र तिया दर्शनोअ बाप्तिमेहें विसार कोअयाज कोअतुतो, तेहेलाम आत्मा तियाहा कोयो, “देख तीन माटी ताहूं होदताहा. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />तियाहा काजे उठीत कोइत निसे जा, आन ठावकुज तियांअरी जा; काहाके तियांहां मीज मोकल्याहा.” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />ताहरुउ पेत्र निसे उतरीत कोइत तियां माट्योहों कोयो, “जियाहा तुमू होदताहा, तो आंयुज होये. तुमू की कामे आवल्या?”<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />तियां कोयो, “कुरनेलियुस सेयनिकोअ आधिकारी होये, जो धर्मी आन देवोहो बित सालनारु आन बादे यहुदी माहें तियाहा हाजू गणत्ले, तियाहा एके देवदुते कोयो के ताहूं तियाआ कोअ हादीत कोइत तू जो कोय तो वसन उनाय.”<verse eid="ACT 10:22" /></para>
  <para style="s">कुरनेलियुसोअहीं पेत्र</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 10:23" />ताहरोअ पेत्रे तियांहां कोअमेहें हाद्यान तिहींज रात काड्यी. बिहीरे दिही पेत्र तियांअरी गोयू, आन याफा गांवोंमेर्‍येए थोड़ेक विश्वासी तियाअरी गोये. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />बिहीरे दिही ते केसरिया सेहरोम पोत्या, आन कुरनेलियुस तियाआ कुटूंबाहा आन दोस्त्योहों टोलू कोइत पेत्राअ वाट जोवतुतो. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />जेहेलाम पेत्र कोअमेहें आवतुतो, तेहेलाम कुरनेलियुस तियाहा मिल्यू, आन पेत्राअ पागे पोड़ीत तियाहा वोंद्यू; <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />पोन पेत्र तियाहा उठाड़ीत कोइत कोयो, “उठीत उबू रो, आंय बी माहुंउंज होय.” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />आन तियाअरी गोठी कोअतूज मायते गोयू, आन वारुज माअहें टिग वोलीत रोल्ये पालित कोइत <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />तियांहां कोयो, “तुमुहूं मुंदू होय के बिगर यहुदीया वालाअरी सबंध मिकीइलो नेत तियाअहीं जाअलो यहुदीइ काजे पाप होये, पोन देवे माहूं कोयोहो के कोड्ला बी माहुंहूं एठो नेत खाराब ने कोअहूं जोवे. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />तियाहा काजे जेहेलाम माहूं तुमू हाद्यू तेहेलाम आंय शुपशाप आयू. ओमे आंय फुसोहो के माहूं की कामोअ काजे हाद्यू?”<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />कुरनेलियुसे कोयो, “यीज वेले, पुरा तीन दिही ओवा, आंय माआं कोअमेहें दिहे तिनेक वाजता प्रार्थना कोअतुतो; तेहेलाम एक माटी समक्ये आंगड़े पोवित कोइत, माआं सामने आवित उबू रोयू. <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />आन कोनु वोल्यू, ‘ए कुरनेलियुस, ताआ प्रार्थना उनाइत लेदीही आन ताआ दान आपीइलो देवोअ सामने ओर कोआयेहे. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />तियाहा काजे एखाहा याफा सेहरोम मोकलीत कोइत जियाआ पुरो नाव शिमोन पेत्र होय तियाहा हादाड़. तो दोर्‍याअ मेरे पोअ शिमोन, सांबड़ाआ धंदू कोअनाराअ कोअमेहें पावणू होये.’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />ताहां मी ताब्बुड़ ताआ जागे माअहें मोकल्ये, आन तूमे हाजो कोअयो जो आवित लागू. ओमे आपू बादे देवोअ सामने होय, काहाके जों किबी देव ताहूं कोयोहो तों उनाइत सेको.”<verse eid="ACT 10:33" /></para>
  <para style="s">पेत्राअ बाशण</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />ताहरुउ पेत्र कोनु वोल्यू, “ओमे माहूं समजाइत गोयो के देव कोडाअरी भेदभाव नाहां कोअतु. <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />माहुंउं कोड्ली बी पारवाड़ीइ काहा नाहां रोतो, जर तो देवोअ भक्ती कोअतोय आन हाजो काम कोअतोय, तो देवोहो पोटेहे. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />ईसु ख्रिस्त, जो आखाआ प्रभु होय, तिया वाअहीं देवे होकेए हाजी बातमी गाजाडीइलोअ वेले तियाआ वसन इस्राएलोअ आखा माअहोंअ जागे मोकल्यो. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />ते घटना तुमुहूं मुंदू होय, जे योहानोअ बाप्तिस्माआं परसारोअ फासाड़ी गालीलोम रोत सुरवात ओत कोइत पुरा यहुदीया भागोमेहें पसरीत गोयी: <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />देव केहें कोइत नासरेथवाला ईसुहू पवित्र आत्मा आन सेक्ती वाअहीं अभिशेक कोअयू; तो हाजे कामे कोअतू आन बादाहा जें सैतानोअ<note caller="+" style="f"><char style="fr" closed="false">10:38 </char><char style="fq" closed="false">सैतानोअ </char><char style="ft" closed="false">इब्लीस</char></note> सेक्ती वाअहीं बांदाअले ओते, तियांहां हुदारतू फिर्‍यू, काहाके देव तियाअरी ओतू.<note caller="+" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="ISA 61:1-3">यश 61:1-3</ref></char></note> <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />आमू तियां बादा कामोअ साक्शीदार होय; जें तिये यहुदीया देसोम आन येरुसालेमोमेहें बी कोअये, आन तियां ईसुहू क्रुस खांबोपोअ टांगीत कोइत माईंत टाक्यु. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />तियाहा देवे तीन दिहोम जिवाड़्यू आन देखाड़ीत बी देदुहू; <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />बादा माअहूं पोअ नाहां पोन तियां साक्शीदारों पोअ जियांहां देवे पेलुज रोत निवड़्येते, ते साक्शीदार आमूज होये, ईसु मोतोम रोत जिवित उठल्यू तेहेलाम आमूज तियाअरी खादोन पिदो; <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />आन तिये आमुहूं आदेश आप्यू के माअहूं मेहें परसार कोआ आन साक्शी आपा, के ओ तोज होय जियाहा देव जिवताआं आन मोल्याआं न्याय कोअनारु ठरव्युहू. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />तियाआ आखा भविश्यवक्ता साक्शी आपताहा के जो कोडो बी तियापोअ विश्वास मिके, तियाहा तियाआ नावोअ सेक्ती वाअहीं पापोअ माफी जोड़े.”<verse eid="ACT 10:43" /></para>
  <para style="s">बिगर यहुद्याहां पवित्र आत्मा जोड़त्लू</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />पेत्र ए गोठी कोयाज कोअतुतो, तेहेलाम पवित्र आत्मा वसन उनाअनारा आखा माअहूं पोअ उतरीत आयू. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />आन जेतेहे खतना ओवले विश्वासी माअहें पेत्राअरी आयेते, तें बोगलाअये के बिगर यहुदी पोअ बी देवे तियाआ पवित्र आत्माआं दान ओली देदोहो. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />काहाके ते तियांहां जुदी जुदीज बाशा गोगत्ले आन देवोअ स्तुती कोअत्ले उनाअया तेहेलाम पेत्रे कोयो, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“केहें एखू यां माअहुंहूं पांअयोंअ बाप्तिस्मा ने कोअहूं जोवे कोत रुकीत सेकेहे के, जियांहां आपाअ होसूज पवित्र आत्मा जोड़्युहू?” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />आन पेत्रे आदेश आप्यू के तियांहां ईसु ख्रिस्ताआ नावो वाअहीं बाप्तिस्मा आपुहूं जोवे. ताहरेए तियां तियाहा थोड़ाक दिही जाआं तियांअरी रोय तेहें रावणी कोअयी.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">येरुसालेम मंडड़ीमेहें पेत्राआ कामोअ ईसाब</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />ताहराअ प्रेशितहों आन विश्वासी पाही जे यहुदीयामेहें रोताते तियां उनाअयो के बिगर यहुद्यां बी देवोअ वसन मानित लेदोहो, <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />तियाहा काजे जेहेलाम पेत्र येरुसालेम सेहरोम आयू, तेहेलामेहें खतना ओवले माहें तियाअरी भान्गड़ कोए वोल्ये. <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />“तुमे विण खतना ओवला माअहोंअहीं जात कोइत तियांअरी खादोन-पिदो.” <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />ताहरुउ पेत्रे तियांहां सुरवाती रोत लाइनशीर आखी गोठी कोताप्यी:<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />“आंय याफा सेहरोमेहें प्रार्थना कोअया कोअतुतो, आन दर्शन देख्यो के एक बासन वोड्डाहा साअका होस शारु खुणा बांदीत कोइत, जुगोम रोत उतरीत कोइत माआं जागे आवित रुकाअयो. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />जेहेलाम आंय तियाहा पाल्यो, ताहां तियामेहें धरती पोर्‍येए शार गुडावाले जनवारे आन होरतींडनारे जनवारे आन जंगलोमेर्‍येए जनवारे आन जुगोमेर्‍येए सिड़े देख्ये; <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />आन ओ आवाज बी उनाअयू, ‘ए पेत्रा, उठ, आन माईंत खा.’ <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />मी कोयो, ‘नाहां प्रभु, नाहां! काहाके आंय कोड्लो एठो नेत खाराब खाणो सोबिम नाहां टाक्यो.’ <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />याआज उत्तर मेहें जुगोम रोत बिहीरी वारी आवाज आयू, ‘जो किबी देवे सोको ठरव्योहो, तियाहा एठो मा कोही.’ <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />तीन वारी जाआं एहेंज कोइत ओवो; ताहरोअ आखोज फाशोअ जुगोमेहें जातो रोयो. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />आन पाला, ताअहांज तीन माअहें जें केसरिया सेहरोम रोत माआं जागे आये, जिया कोअमेहें आंय रोतुतो तिहीं आवित उबे रोये. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />तेहेलाम पवित्र आत्मे माहूं ठावकुज तियांअरी जाय तेहें कोयो, आन ते सोव विश्वासी पाही बी माअरीज आया; आन आमू तिया कुरनेलियुसोअ कोअ गोया. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />तिये आमुहूं कोयो, के आंय एका देवदुतोहो माआं कोअमेहें देख्यू, जिये माहूं कोल्यो, ‘याफा सेहरोमेहें माअहें मोकलीत कोइत शिमोनोहो जियाहा पेत्र कोतेहे, तियाहा हादीत लेताव. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />तो तुमुहूं एहेलिही गोठी कोतापे, जियीं वाअहीं ताहूं आन ताआ पुरा कुटूंबाहा सुटका जोड़े.’ <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />जेहेलाम आंय गोठी कोउ वोल्यू, ताहां पवित्र आत्मा जेहेंकोइत सुरुवातीमेहें आपापोअ आयू, तेहेंज कोइत तियांपोअ बी आयू. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />ताहरोअ माहूं प्रभुउ तोओं वसन ओर आवयो; जों तिये कोयोतो, ‘योहाने ताम पाअयों वाअहीं बाप्तिस्मा आप्यो, पोन तुमू पवित्र आत्मा वाअहीं बाप्तिस्मा लेहा.’<note caller="+" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="ACT 1:5">प्रेशित 1:5</ref></char></note> <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />तियाहा काजे जेहेलाम देवे तियांहां बी तोज वरदान आप्यो, जो आपुहूं प्रभु ईसु ख्रिस्तापोअ विश्वास मिकीइला वाअहीं जोड़्यो; ताहां आंय कोडू होय जो देवोहो रुकीत सेको?”<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />ओं उनाइत कोइत तें ठावकाज ओत गोये, आन देवोअ स्तुती कोइत कोने वोल्ये, “ताहरोअ ते देवे बिगर यहुदीही बी जिवनोअ काजे मोन फिराविइलाआ दान आप्योहो.”<verse eid="ACT 11:18" /></para>
  <para style="s">अंताकियाआ मंडड़ी</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />स्तिफन माआंयू तियी होमसे जें माअहें विरोद ओवू तिहीं वाखरी वेरासेर ओत गोयेते, तें दुर दुर फिनीके, सायपरस आन अंताकियामेहें पोते; पोन तें यहुदी माअहुंहूं सोड़ीत बिहीरा कोडाहाज वसन ने कोत आपतेते. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />पोन तियांमेर्‍येए थोड़ेक सायपरसवाले आन कुरेनीवाले ओते, जें अंताकियामेहें आवित कोइत ग्रीक बाशाआ माहुंहूं बी प्रभु ईसुउ हाजी बातमी कोतापे वोल्ये. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />प्रभुउ सेक्ती तियांपोअ ओती, आन डाहटे माअहें विश्वास मिकीत कोइत प्रभुउ वोगेहे मोन फिरावयो.<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />जेहेलाम तियांआं सर्सा येरुसालेमोअ मंडड़ी उनाअयी, ताहां तियां बरनबासोहो अंताकिया मोकल्यू. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />तो तिहीं पोतीत कोइत आन देवोअ मेरवानी पालीत कोइत खुस ओवू, आन आखाहा सिकाड़्ये के मोन लागाड़ीत कोइत प्रभुउरी इमानदार आन खोरे रोजा. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />तों एक हाजो माहुंउं ओतो, तो पवित्र आत्माआं आन विश्वासोम पाक्को ओतो; आन वारुज माअहें प्रभुमेहें आवित जुडाअये.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />ताहरुउ बरनबास शाऊलोहो होदीइलाअ काजे तारसुसोहो जातू रोयू. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />जेहेलाम तो शाऊलोहो मिल्यू, ताहां तियाहा अंताकिया हादीत लेतायू; आन एहेलोह ओवो के ते एक साल जाआं मंडड़ीइरी मिलीत आन डाहटा माअहुंहूं सिकाड़तु रोयु; आन आखा रोत पेल अंताकियाजमेहें विश्वासी माअहोंहों “ख्रिस्ती” ओं नाव जोड़्यो.<verse eid="ACT 11:26" /></para>
  <para style="s">बरनबास आन शाऊल येरुसालेम जात्ला</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />तियांज दिहोमेहें थोड़ाक भविश्यवक्ता येरुसालेमोम रोत अंताकिया आया. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />तियांमेर्‍युउ अगबुस<note caller="+" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="ACT 21:10">प्रेशित 21:10</ref></char></note> नावोअ एके जोएं उबू रोत कोइत आत्माआं सेक्ती वाअहीं ओं कोयो के, आखी दुन्याम वोडु काल पोड़े, आन तो काल क्लौदियुसोअ दिहोमेहें पोड़्यू. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />ताहराआ सेलहां ठरव्यो के यहुदीयाम रोनारा विश्वासी पाव्हीइलाहां मदत कोइलोअ काजे तियांमेएं हारेक जोओं जिव जिवोअ पुरवाअतोज की तेबी मोकलुहूं जोवे. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />तियां पोशा गोड़ा कोइत बरनबास आन शाऊलोअ आथे डायहांअ जागे लेत मोकली देदो.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">याकोबोअ मोत आन पेत्राआ सुटका</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />तियां दिहोमेहें हेरोद राजा मंडड़ीइ थोड़ाक माअहुंहूं तारास देअलोअ सुरु कोअयो. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />तिये योहानोअ पाही याकोबोहो तारवाई वाअहीं माआड़ी देदू. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />जेहेलाम तिये होमज्यो के यहुदी माअहें या कामोवाअहीं खुस ओवतेहे, ताहां तिये पेत्राहा बी तोइत लेदू, आन ते दिही बिगर खमीरोअ रोटाअ तिवारोअ ओता. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />तिये पेत्राहा तोइत कोइत जेलेम केंडी देदू, आन शार शार सिपायडाअ शार पाड़ी मिक्यी; या विसारो वाअहीं के वल्हांडणोअ तिवारोअ फासाड़ी तियाहा माअहोंअ सामने लेतावीत सौकीशी कोइत सेके. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />जेलेमेहें पेत्र बोंद ओतू; पोन तियाआ काजे मंडड़ी मोन लागाड़ीत देवोहो प्रार्थना कोअतीते.<verse eid="ACT 12:5" /></para>
  <para style="s">जेलेम रोत पेत्राआ सुटका</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />जेहेलाम हेरोद तियाहा माअहुंउं सामने लेतावनारु ओतू, एकी रातीइ आगाड़ी पेत्राहा बेन हाकले वाअहीं बांद्युतो, आन तो बांदाअलुज बेन सिपायड़ाअ विसमेहें हुवतूतो; आन सिपायडां जेलेए बाअणाअहीं राखवाली कोअताते. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />ताहां पाला, प्रभुउ एक देवदुत आयू आन तियी खुलीमेहें उजेड़ समक्यू, आन पेत्राहा आथ लागाड़ीत जागाड्यू आन कोयो, “मामार उठे.” आन पेत्राअ आथोमेएं हाकली निंगलीत पोड़्यी. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />ताहरुउ देवदुत पेत्राहा कोयो, “कंबर बांद, आन ताआ खाहड़े पोवित ले.” पेत्रे तेहेंज कोअयो. ताहरुउ देवदुते तियाहा कोयो, “ताआ आंगड़ो पोवित लेन माआं फासाड़ी आव.” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />पेत्र निहीत कोइत तियाआ फासाड़ी जानु वोल्यू; पोन ने मुंदू ओतू के जो देवदुत कोअहे ओं खोरीज होये, पोन एहेलोह समज्यो के आंय दर्शन पालोहो. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />ताहराअ ते पेल्लीइ टोली आन दुसरी सिपायड़ाआ टोलीही टाकीत कोइत तिया लोड़ाअ बाअणापोअ पोत्या, जिहीं रोत होयरोमेहें सड़क जाहे. तों बाअणो तियांआं काजे तिया तियाआज उगड़ीत गोयो, आन ते निहींत कोइत एक्कीज गेल्लीम रोत गोया, आन तेत्ताजमेहें देवदुत पेत्राहा सोड़ीत कोइत जातू रोयू. <figure style="fig" alt="Chains embedded in prison wall" file="HK00204C.TIF" size="col" copy="Horace Knowles ©" ref="12:7">जेलेमेऱ्याआ पितड़ाअरी बांदीत मिकल्यी हाकलेए बेड़ी</figure><verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />ताहरुउ पेत्र सुद्दीपोअ आवित कोइत कोयो, “ओमे माहूं खोरीज समजात गोयो के, प्रभु तियाआ देवदुत मोकलीत माहूं हेरोदोअ आथोम रोत सोड़वीत लेदुहू, आन यहुद्याआं बादी आशा तोड़ी देदीही.”<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />तियाहा मुंदू गोयू, तेहेलाम तो योहान मार्काआ आयही मरियाआ कोओ आयू. तिहीं डाहटे माहें टोलू वोलीत प्रार्थना कोअया कोअतेते. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />जेहेलाम पेत्रे बाअणो ठोक्य, ताहां रुदा नावोअ एक पावर बाय ओतीते पाली आयी. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />पेत्राआ आवाज उनाइत कोइत तियी खुसीइ बाल्लायी बाआ जाआं ने उगाड़्यो, पोन गुगदीइतीज कोअमेहें गोयी आन कोयो के पेत्र बाअणाअहीं उबू रोत रोयुहू. <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />तियां तियीही कोयो, “तू गांडी होये!” पोन तियी साती ठोकीत कोयो खोरीज होये. ताहरेए तियां कोयो, “तो तियाआ देवदुत ओये.”<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />पोन पेत्र बाअणो ठोक्याज कोअतुतो; आन तियाहा काजे तियां बाआ उगाड़्यो आन तियाहा पालित कोइत बोगलाइत गोये. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />ताहरुउ पेत्र तियांहां ठावकेज रोय तेहें आथोवाअहीं ईशारु कोअयू; आन तियांहां कोयो के प्रभु की कोइत तियाहा जेलेमेहें रोत काडीत लेतायुहू. फाशोअ कोयो, “याकोब आन विश्वासी पायहोंहों ए गोठ कोत देजा.” ताहरुउ निहीत कोइत बिहीरी जागे जातू रोयू.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />हुज्यन हुज्य सिपायडां विसारोम पोड़ीत गोया के पेत्राअ की ओवोये. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />जेहेलाम हेरोदे तियाहा होदीत हेएयो आन तो ने जोड़्यू, ताहां सिपायडाअ सौकीशी कोइत तियांहां माईंत टाकीइलाआ आदेश आप्यु: आन तो यहुदीया सोड़ीत कोइत थोड़ाक दिहोअ काजे केसरियाम जात कोइत रोनू वोल्यू.<verse eid="ACT 12:19" /></para>
  <para style="s">हेरोदोअ मोत</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />हेरोद सुर आन सिदोनोअ माअहूं पोअ जास्ती खोताअयुतो. तियाहा काजे तें माअहें एक मोन ओत कोइत तियाआ जागे आये, आन बलास्तुसोहो जो राजाआ एक सेवक ओतू; तियाहा पोटावीत होमजीइलाअ गोठी कोअतेते; काहाके राजाअ देसोम रोत तियांआं देसोमेहें दाणाअ आन खाअला-पीइलाअ सोय ओवतीते.<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />आन ठरिवल्या दिहोपोअ हेरोद राजा राज आंगड़े पोवित कोइत राजगादीपोअ बोठू, आन तियांहां बाशण देनू वोल्यू. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />ताहरेए माहें आअड़े वोल्ये, “ओ ते माअहुंउं नाहां देवोअ आवाज होय!” <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />तियीज वेले प्रभुउ एके देवदुते तियाहा एक लागावयी, काहाके तिये देवोहो महिमा ने आप्यी; आन तो किड़ा पोड़ीत मोइत गोयू. <verse eid="ACT 12:23" /><verse number="24" style="v" sid="ACT 12:24" />पोन देवोअ वसन पसरीइतो आन वादतो गोयो.<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />बरनबास आन शाऊल तियांआं सेवा पुरी कोइत लेदीन ताहराआ योहान जियाहा मार्क कोतेहे तियाहा आरी लेत कोइत येरुसालेम रोत वोल्या.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">बरनबास आन शाऊलोहो निवड़ीत कोइत मोकलीइलो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />अंताकियाअ मंडड़ीमेहें थोड़ाक भविश्यवक्ता आन मास्तर ओता; जेहेंकोइत बरनबास आन शिमोन जियाहा नीगर कोतेहे; आन कुरेनीइं रेवासी लूकियुस, आन आधिकारी हेरोदोअ दुध-पाही<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="fq" closed="false">दुध-पाही </char><char style="ft" closed="false">मोन्ज्ये तियाअरी वोडू ओवलू</char></note> मनाएन, आन शाऊल. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />जेहेलाम ते उपास तोइत प्रभुउ भक्ती कोअतेते, तेहेलाम पवित्र आत्मे कोयो, “माआं काजे बरनबास आन शाऊलोहो तिया कामोअ काजे आलांग कोआ जियांअ काजे आंय तियांहां हाद्याहा.”<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />ताहराअ ते उपास आन प्रार्थना कोइत बरनबास आन शाऊलोपोअ आथ मिकीत कोइत तियांहां वाटे लागाड़्या.<verse eid="ACT 13:3" /></para>
  <para style="s">सायप्रसोमेहें बरनबास आन शाऊल</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />बरनबास आन शाऊल पवित्र आत्मा वाअहीं मोकलीइल्या सिलुकियामेहें गोया; आन तिहीं रोत जाहाजीमेहें बोहीत कोइत सायपरस यी जागे गोया; <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />आन सलमीस होयरोम पोतीत कोइत, देवोअ वसन यहुदीइ आराधनालयोमेहें कोताप्य, आन योहान तियांआं सेवक ओतू.<figure style="fig" alt="Front view of a synagogue" file="LB00246C.TIF" size="col" copy="Horace Knowles ©" ref="13:5">यहुदी आराधनालयोअ सामनेवालु भाग (सिनेगाग)</figure><verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />ते तिया पुरा बेटोपोअ ओवताज पाफुस पोत्या तिहीं तियांहां बार-ईसु नावोअ एक यहुदी बोड़वू आन ठोग भविश्यवक्तू मिल्यू. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />तो राज्यपाल सेरगियुस पौलुसोअरी ओतू, जो समजदार माटी ओतू. तिये बरनबास आन शाऊलोहो तियाआ जागे हादीत कोइत देवोअ वसन उनाइलोअ इश्शा कोअयी. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />पोने एलीमास बोड़वे, तियाआ नावोअ अर्थ ओंज होय, तियांआं विरोद कोइत राज्यपालोहो विश्वास ने कोअहूं जोवे कोत रुकीइलाआ कोशित कोअयी. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />ताहरुउ शाऊले जियाअ नाव पौलुस बी होय, तिये पवित्र आत्मा वाअहीं पोआइत कोइत तियाअहें नजर लागाड़ीत पाल्यो आन कोयो, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />“ए आखी खाराबी आन आखी ठगरायी वाअहीं पोआला सैतानोअ पोर्‍या, हाजी गोठीइ दुस्मोन, तु प्रभुउ सिदी वाट वाकड़ी कोइलोअ ने सोड़नारु के? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />ओमे देख, प्रभुउ आथ तापोअ पोड़्युहू; आन तू थोड़ाक दिही जाआं आंदलू ओत जाही आन दिही ने देखाय.”</para>
  <para style="p" vid="ACT 13:11">ताहरुउ तेताजमेहें तियाहा साको-साकोज देखाओ वोल्यो आन तियाहा आंदारो देखाओ वोल्यो, ताहरुउ तो एखो तियाहा आथे तोइत लेत जाय तेहें कोत जेहें तेहेंज सापलू वोल्यू. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />ताहरुउ राज्यपाल जो ओयोतो तियाहा देखीत कोइत आन प्रभुउ हिकवोणो वाअहीं बोगलात कोइत विश्वास कोअयू.<verse eid="ACT 13:12" /></para>
  <para style="s">पिसिदियाअ अंताकियामेहें</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />पौलुस आन तियाआ हाती पाफुसोम रोत जाहाजीमेहें बोहीत कोइत पंफूलिया भागोअ पिरगा सेहरोमेहें आया; आन योहान तियांहां सोड़ीत कोइत येरुसालेमोमेहें वोलीत आवतू रोयू. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />पौलुस आन बरनबास पिरगा सेहरोम रोत वाट लागा आन पिसिदिया भागोअ अंताकियामेहें पोत्या; आन यहुदीइ आरामोअ दिही आराधनालयोमेहें जात कोइत बोहीत गोया. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />ताहराआ नियम आन भविश्यवक्ताआ पुस्तक वाशोन ताहराअ आराधनालयोअ आधिकार्‍यों तियांआं जागे कोत मोकल्यो, “ए पाही, जर माअहुंउं प्रोत्साहनोअ काजे तुमू काविंहीं कोनारा ओय ताहां कोवा.”<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />ताहरुउ पौलुस उठीत कोइत आन आथोवाअहीं ईशारु कोइत कोयो, “ए इस्राएलवालां, आन देवोअ भक्ती कोअनारा उनाआ: <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />इस्राएली माअहुंउं देवे आपाअ वेगाअ डायहांहां निवड़्या, आन जेहेलाम एं माअहें मिसर देसोमेहें जिवण्ये ओते, ताहां तिये तियांहां वादाड्ये; आन वोडी सेक्ती वाअहीं तो तियांहां काडीत लेतायू. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />तो सालीही वोरह्ये जाआं जंगलोमेहें तियांआं वेठतू रोयू, <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />आन कनान देसोमेहें हांत राज्याहा आरवीत कोइत इस्राएल वालाहां वारस हक्क आप्यो.<verse eid="ACT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 13:20" />“यीं गोठीही आंदासीज हाड़ा शार होव वोरह्ये ओवे, तिहींइं फासाड़ी तिये शमुवेल भविश्यवक्ताआ जागे जाआं तियांमेएं न्याय निवाड़ू कोअनारा ठरव्या. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />तिहीं फासाड़ी तियां एक राजा माग्यू; ताहां देवे सालीही वोरह्योअ काजे बिन्यामीनोअ जातीम रोत किशोअ पोर्‍या शाऊलोहो तियांपोअ राजा ठरव्यू <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />ताहरुउ शाऊलोहो काडीत कोइत दाविदोहो तियांआं राजा ठरव्यू; जियाअ बाप्तिमेहें तिये साक्शी आप्यी, ‘माहूं इसायोअ पोर्‍यू दाविद, माआं मोनोअ गोमतुज जोड़ीत गोयुहू; तोज माआं इश्शा पुरी कोए.’ <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />देव तियाआ वायदाआ पुरमाणे तियाज दाविदोअ पारवाड़ीमेहें रोत इस्राएलोअ काजे एका तारनाराहा, मोन्ज्ये ईसुहू मोकल्यू. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />जियाआ आविइलाअ पेल योहाने आक्खा इस्राएलोमेहें मोन फिरावोअ बाप्तिस्माआं परसार कोअयू. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />जेहेलाम योहानोअ सेवा पुरी ओवुहूंज ओती, तेहेलाम तिये कोयो, ‘तुमू माहूं की समजीइताहा? आंय तो नाहां जियाआ तुमू वाट जोवताहा! पोन पाला, माआं फासाड़ी एक जोउं आवनारु होये, जियाआ गुडामेएं खाहड़े काडुहूं बी माआं लायकी नाहां.’<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />“माआं पाव्हीइला, तुमू जे अब्राहामोअ पोर्‍ये होये; आन तुमू जे देवोहो बितेहे, तुमाआं जागे या तारणोअ वसन मोकलाअयोहो! <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />काहाके येरुसालेमोमेएं रोनारे आन तियांआं डायहां, तियाहा ने ओलख्यु आन नाहां भविश्यवक्ताआ गोठी समज्यी, जे हारेक यहुदी आरामोअ दिही वासतेहे, तेबी ईसुहू दोशी ठरवीत कोइत तियी गोठीही पुरी कोअयी. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />तियांहां माइलोअ जोगीही कोड्लीज सुक ने जोड़्यी तेबी तियां पिलातोहो रावणी कोअयी के तियाहा माईंत टाकुहूं जोवे. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />ते तियाआ बाप्तिमेहें नियमोअ पुस्तकोमेहें जो किबी लेख्योहो, तों पुरो ओवीइलाआ फासाड़ी तियाहा क्रुस खांबोपोअ रोत उतार्‍यू आन माहणोम मिक्यू. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />पोन देवे तियाहा मोल्याम रोत जिवतु कोअयू, <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />आन तो तियांहां जे तियाअरी गालीलोम रोत येरुसालेमोमेहें आयेते, डाहटा दिही जाआं देखाअतू रोयू; इस्राएली माअहुंउं सामने ओमे तेंज तियाआ साक्शीदार होय. <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />आमू तुमुहूं तिया आथवसनोअ बाप्तिमेहें ए हाजी बातमी कोत आपताहा, जों वेगाआ डायहांअरी लेदोतो <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />के देवे ईसुहू जिवाड़ीत कोइत, तोज वायदो आपाअ पोर्‍याअ काजे पुरो कोअयो; जेहलोहो दुसरा भजनोमेहें बी लेख्योहो:</para>
  <para style="q1" vid="ACT 13:33">“तू माआं बेटुह्हू होय;</para>
  <para style="q2" vid="ACT 13:33">आंय ताआ आब्हू बोण्युहूं.”<verse eid="ACT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 13:34" />आन तियाआ मोल्याम रोत जिवाड़ीइलाअ बाप्तिमेहें बी देवे एहें कोइत कोयो, के तो केदिहीं ने जिरे:</para>
  <para style="q1" vid="ACT 13:34">“आंय दाविदोहो आपल्यू पवित्र आन पाक्कू आशिर्वाद</para>
  <para style="q2" vid="ACT 13:34">तुमुहूं आपिहीं.”<verse eid="ACT 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 13:35" />तियाहा काजे तिये फाशोअ एका भजनोमेहें बी कोयोहो,</para>
  <para style="q1" vid="ACT 13:35">“तू ताआ इमानदार सेवकोहो ने जिरुहूं देही.”<verse eid="ACT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />काहाके दाविद तोम देवोअ ईश्शाअ पुरमाणे तियाआ दिहोमेहें सेवा कोइत हुवीत गोयू, आन तियाआ तोड़ वेगाअ डायहांअरी डाटी देदो, आन तियाआ तोड़ माहणोम जिरीत बी गोयो. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />पोन जियाहा देवे जिवाड़्यू, तो जिरीत ने सेकू. <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />तियाहा काजे, पाव्हीइला, तुमू जाईंत ल्या, के ईसु वाअहीं तुमुहूं पापोअ माफीइ खबर जोड़्यीही <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />आन जियीं गोठीमेहें तुमू मोशेए कायदावाअहीं निर्दुस ने ठरीत सेकतेते, तियीं आखीज गोठीमेहें हारेक विश्वास कोअनारो ईसु वाअहीं निर्दुस ठरेहे. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />तियाहा काजे सांबालीत रोवा, एहेलोहो ने ओवुहूं जोवे के भविश्यवक्ताआ पुस्तकोमेहें जो कोअयोहो, तो तुमापोअ बी आवित पोड़े:<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />“ए निंदा कोअनारां, पाला,</para>
  <para style="q2" vid="ACT 13:41">आन बोगलाआ, आन</para>
  <para style="q2" vid="ACT 13:41">आरवाइत जावा!</para>
  <para style="q1" vid="ACT 13:41">काहाके आंय तुमाआं दिहोमेहें एक काम कोअहो,</para>
  <para style="q2" vid="ACT 13:41">एहेलोहो काम के जर एखू तुमाअरी तियाआ गोठी</para>
  <para style="q2" vid="ACT 13:41">समजाड़े, ताहां तुमू केदिहीं विश्वास ने कोअहा!”<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />जेहेलाम पौलुस आन बरनबास बारथे निहीत्ला तेहेलाम माअहें तियांहां रावणी कोए वोल्ये के आगल्याआ आरामोअ दिही आमुहूं ए गोठी फाशीइ कोतापजा. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />जेहेलाम सभा उठीत गोयी तेहेलाम यहुदी आन यहुदीइ विश्वास मानित सालनारा भक्तोंम रोत वारुज जोएं पौलुस आन बरनबासोअ फासाड़ी जाने वोल्ये; आन तियां तियांहां गोठी कोइत समजाड़्यो के देवोअ मेरवानीमेहें मजबुत रोजा.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />आगल्याआ आरामोअ दिही होयरोमेर्‍येए आखेज कोअलेहे माअहें प्रभुउ वसन उनाइलोअ काजे टोलू वोलीत गोये. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />पोन यहुदी गर्दीही पालीत कोइत खोते वाअहीं पोआइत गोया, आन निंदा कोइत पौलुसोअ गोठीइ विरुद्दाम गोगा वोल्या. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />ताहां पौलुस आन बरनबास हिमते वाअहीं कोयो, “देवोअ वसन पेल तुमुहूं कोत आपाअतो याआ गरज ओती; पोन जाहां तुमू तियाहा सेटे हारताहा, आन सोताहा अमर जिवनोअ लायकीइ नाहां ठरीवता, ताहां पाला, आमू बिगर यहुदीइ जागे जाताहा. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />काहाके प्रभु आमुहूं आदेश आयुहू:</para>
  <para style="q1" vid="ACT 13:47">“आंय ताहूं बिगर यहुदीइ काजे</para>
  <para style="q2" vid="ACT 13:47">उजालो ठरव्योहो,</para>
  <para style="q1" vid="ACT 13:47">काहाके तू धरतीइ मेरे कोपरे जाआं</para>
  <para style="q2" vid="ACT 13:47">तारणोअ बाआ बोणुहूं जोवे.”<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />ओं उनाइत कोइत बिगर यहुदी खुस ओत गोये, आन प्रभुउ वसनोअ स्तुती कोए वोल्ये; आन जेतेहे कायम जिवनोअ काजे निवाड़ाअयेते, तियां विश्वास कोअयू.<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />ताहरोअ प्रभुउ वसन तिया आक्खा मुलखोमेहें पसरो वोल्यो. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />पोन यहुदी माट्यों भक्तण बोईंहीं आन होयरो मेर्‍याआ पुढार्‍योहों पोडकावया, आन पौलुस आन बरनबासोअ विरुद्दाम कांय-कांय कोत कोइत तियांहां तियांआं गावोंअ हिंवोंअ बारथे काडी देदा. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />ताहराअ ते तियांआं सामने तियांआं गुडाअरी तुलो फोकड़ीत कोइत इकुनियुम जाता रोया. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />आन अंताकिया मंडड़ीइ विश्वासी खुसी वाअहीं आन पवित्र आत्मा वाअहीं भारपुर पोआते गोये.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">इकुनियुम मेहें पौलुस आन बरनबास</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />इकुनियुमोमेहें एहेलोहो ओवो के ते यहुदीइ आराधनालयोमेहें आरी आरी गोया, आन एहें कोइत गोठी कोअयी के यहुदी आन युनानी बेनुमेहें रोत डाहटे जोएं विश्वास कोअयू. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />पोन विश्वास ने कोअनारा यहुदी माअहूं बिगर यहुदीइ मोने भटकाड़ीत कोइत विश्वासी पाव्हीइलाआं विरुद्दाम खिजवी देदे. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />प्रेशितहों जाअखिलाहा दिही जाआं तिहीं रोया, आन प्रभुउ बाप्तिमेहें हिमते वाअहीं गोठी कोअताते; आन जो तियांआं आथे समत्कार आन वोडे वोडे कामे कोआडीत कोइत तियाआ मेरवानीइं वसनो पोअ साक्शी आपतुतो. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />पोन होयरोमेर्‍याअ माअहूंमेहें भाग पोड़ीत गोयाते, यावाअहीं केतेहे तेबी यहुदीइ वोगेहे आन केतेहे प्रेशितोअ वोगेहे ओत गोये.<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />पोन जेहेलाम बिगर यहुदी आन यहुदी तियांआं अपमान कोइलो आन तियांहां डोणाटीइलोअ काजे तियांआं आधिकार्‍योंअरी तियांअहें गुगदीत आवये, <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />जाहां प्रेशितोहों ए गोठी मुंदू गोयी तेहेलाम आन लुकावनियाआ लुस्रा आन दिरबे होयरोमेहें, आन आहने-पाहनेए मुलखोमेहें नाहीत गोया. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />आन तिहीं हाजी बातमी कोतापा वोल्या.<verse eid="ACT 14:7" /></para>
  <para style="s">लुस्रा आन दिरबेमेहें पौलुस आन बरनबास</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />लुस्रामेहें एक माहुंउं ओतो, जो गुडाम पांगलो ओतो. तो जल्मार्‍योअज लेंगड़ो ओतो आन केदिहींज ने साल्योतो. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />तों पौलुसोअ गोठी उनाअया कोअतोतो. पौलुसे तियाअहें एक नजरेज पाल्यो के तियाहा हुदरीत जाअलोअ विश्वास होये, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />आन आअड़ीत कोयो, “ताआ गुडाअ ताकते वाअहीं उठीत उबू रो.” ताहां तो उब्बोज उसल्योन सालो वोल्यो. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />माअहें पौलुसोअ ओं काम पालीत कोइत लुकावनिया बाशामेहें आअड़ीत कोइत कोयो, “देवे माहें बोणीत आपाअ जागे उतरीत आयेहे.” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />तियां बरनबासोहो ज्यूस, आन पौलुसोहो कांय हेरमेस कोयो, काहाके तो गोठी कोइलोमेहें मुख्य ओतू. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />ज्यूसोअ तिया मंदिरोअ माहराज जो तियांआं होयरोअ सामने ओतो, बोलोद आन फुलोअ हार नेहें गेटोपोअ लेतावीत माअहोंअरी गाराहा आपुहूं कोअतुतो.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />पोन बरनबास आन पौलुस जेहेलाम ओं उनाअया, ताहां तियांआं आंगड़े फाड्ये आन गर्दीम फोहयान आअड़ीत कोइत कोना वोल्या, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />“माअहूं, तुमू ओं की कोअतेहे? आमू बी तोम तुमाआं होसूज माअहें होय, आन तुमुहूं हाजी बातमी कोतापताहा के यीं फालतू वस्तुअहें रोत मोन वालित कोइत जिवता देवोअहें फिरा, जिये होरगो आन धरती आन दोर्‍या आन जो किबी तियांमेहें होय बोणायो. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />गोल्या दिहोमेहें तिये आखी जातीइ माअहोंहों जिवज्योअ वाटे सालुहूं देदे. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />तेबी तो तुमाआं काजे हाजी हाजी गोठी कोअतू रोयू, ओ तियाआ पुरावू होये के तो होये. तो तुमुहूं जुगोम रोत वोर्‍हात पाड़त्लू, बोराबर वेलेपोअ ओन पाकाड़त्लू; तो तुमुहूं रोटू आपत्लू आन तुमाआं मोनोहों खुस कोअत्लू.”<verse eid="ACT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 14:18" />ओं कोत कोइत बी बरनबास आन पौलुसे माअहुंहूं वोडी जिगरी वाअहीं रुक्ये के तियांआं काजे गाराहा ने कोअहूं जोवे.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />पोन थोड़ेक यहुदी माअहें अंताकिया आन इकुनियुम रोत आवित कोइत माअहुंहूं तियांआं वोग वालित लेदे, आन पौलुसोहो डोणाट्यू, आन मोल्यू समजीत कोइत तियाहा गांवोंअ बारथे ओडीत कोइत टाकीत आये. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />पोन जेहेलाम सेला तियाआ मेरे मेरे आवित उबा रोया, ताहां तो उठीत कोइत गांवोम गोयू आन बिहरे दिही बरनबासोअरी दिरबे जातू रोयू.<verse eid="ACT 14:20" /></para>
  <para style="s">सिरियाअ अंताकिया रोत वापिस वोलीइलो</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />पौलुस आन बरनबास तिया गांवोंअ माअहुंहूं हाजी बातमी उनाड़ीत कोइत, आन वारुज सेला बोणावीत कोइत, लुस्रा आन इकुनियुम आन पिसिदियाअ अंताकियाम वापिस आवता रोया, <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />आन सेलाआ मोनोहो मजबुत कोअता रोया आन ओं सिकाड़ताते के विश्वासोम पाक्का रोवा; आन कोताते, “आपुहूं वोडु तारास कोअतेज देवोअ राज्याम जाअहूं पोड़े.” <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />आन तियां बादी मंडड़ीमेहें तियांआं काजे पुडारी ठरवी देदा, आन उपासोअरी प्रार्थना कोइत तियांहां प्रभुउ आथोम होप्या जियापोअ तियां विश्वास कोअयुतो.<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />ताहराअ पिसिदियाअहें ओवताज ते पंफूलियाम पोत्या; <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />ताहराअ पिरगामेहें वसन कोतापीत कोइत अत्तलियाम आया. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />आन तिहीं रोत ते जाहाजीम बोहीत अंताकिया गोया, जिहीं तियां कामोंअ सुरुवात कोअयीते, जों तियां देवोअ मेरवानीमेहें होपाइत ओमे पुरो कोअयोतो.<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />तिहीं पोतीत कोइत तियां मंडड़ीही टोलू कोअयी आन कोताप्यो के देवे तियांअरी रोत कोइत केहेलेहे बाहरी बाहरी कामें कोअये, आन बिगर यहुदीइ काजे विश्वासोअ बाअणो उगाड़ी देदो. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />आन ते सेलांअरी वारुज दिही जाआं रोया.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">येरुसालेमोअ सभा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />ताहराआ थोड़ाक माटी यहुदीया रोत अंताकिया आवित कोइत विश्वासी माअहोंहों सिकाड़ा वोल्या: “जर मोशेए रिती पोअ तुमाआं खतना<note caller="+" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="LEV 12:3">लेवी 12:3</ref> </char></note> ने ओवे ताहां तुमुहूं तारण ने जोड़ीत सेकनारो.” <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />जेहेलाम पौलुस आन बरनबासोअ तियांअरी खुब भान्गड़ आन सोबासोबी ओवा ताहां ओं ठरवाअयो के पौलुस आन बरनबास आन तियांमेर्‍येए थोड़ेक माअहें यी गोठीइ बाप्तिमेहें की मत पोड़ेहे तियाआ काजे प्रेशितोंअ आन डायहांअ जागे येरुसालेमोमेहें जाये.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />ताहां मंडड़ी तियांहां थोड़ीक सेटे जाआं पोताड़्या; आन ते फिनीके आन शोमरोनोअहें फिरताज माहुंहूं कोता गोया, के बिगर यहुदी केहें कोइत देवोअहें फिऱ्ये: आन यी खबरे वाअहीं विश्वासी माअहें खुब खुस ओवे. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />जाहां ते येरुसालेमोमेहें पोत्या, ताहां मंडड़ी आन प्रेशित आन डायहां तियांहां खुसी वाअहीं मिल्या, आन देवे तियांअरी रोत कोइत केहले-केहलेहे कामे कोअयेते तें तियां कोत देखाड़्यो. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />पोन फरिसीइ पंथामेर्‍याआ जियां विश्वास मिक्युतो, तियांमेर्‍याआ थोड़ाक जोओं उठीत कोइत कोयो, “तियांहां खतना कोआड़ीइलो आन मोशेए नियमोहों मानीइलाअ आदेश आपुहूं जोवे.”<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />ताहराअ प्रेशित आन डायहां यी गोठीइ बाप्तिमेहें विसार कोइलाअ काजे टोलू वोल्या. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />ताहरुउ पेत्र वारुज सोबासोबी ओवीइलाआ फासाड़ी उबू रोत कोइत तियांहां कोयो, “माआं पाव्हीइला, तुमुहूं मुंदू होय के वारुज दिही ओवा देवे तुमामेहें रोत माहूं निवड़ीत लेदू के माआं मुखोवाअहीं बिगर यहुदी माहें हाजी बातमीइ वसन उनाइत कोइत विश्वास कोए.<note caller="+" style="x"><char style="xo" closed="false">15:7 </char><char style="xt" closed="false"><ref loc="ACT 10:1-43">प्रेशित 10:1-43</ref> </char></note> <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />मोनोअ जांअनारे देवे तियांहां बी आपाअ होस पवित्र आत्मा आपीत कोइत तियाआ साक्शी आप्यी;<note caller="+" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 2:4">प्रेशित 2:4</ref>; <ref loc="ACT 10:44">10:44</ref> </char></note> <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />आन विश्वासो वाअहीं तियांआं पापोअ माफी कोइत आपामेहें आन तियांमेहें किज फरक ने मिक्यू. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />ताहां ओमे तुमू काहा देवोअ परिक्शा लेताहा के, सेलाआं बोसीपोअ एहेलोहो जुहर मिकताहा, जियाहा आपाआ वेगाअ डायहां नाहां उसलीत सेक्या आन आपू बी नाहां उसलीत सेकता? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />होव, आमाआं ओ भरिवसू होय के जेहें कोइत तें प्रभु ईसुउ मेरवानी वाअहीं वासाअतेहे; तेहेंज कोइत आपू बी वासाअतेहे.”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />ताहरीइ आखी सभा ठावकीज बरनबासोअ आन पौलुसोअ उनाइ वोल्यी, के देवे तियां वाअहीं बिगर यहुदीमेहें केहेलाहा वोडा-वोडा समत्कार आन जबरदस्त कामे देखाड़्ये. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />जेहेलाम ते गोगीइलोअ आलहाअया तेहेलाम याकोब कोनु वोल्यू, “पाव्हीइला, माआं उनाआ. <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />शिमोने कोताप्यो के देवे पेलपेल बिगर यहुदी पोअ केहेलिही मेरवानीइं नजर कोअयी के तियांमेर्‍येए तियाआ नावोअ काजे थोड़ेक माअहें काडीत लेदे. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />याअरी भविश्यवक्ताआं गोठी बी जुड़ाअतीही, जेहलोहो लेख्योहो के,<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />“याआ फासाड़ी आंय फाशुउ आवित कोइत</para>
  <para style="q2" vid="ACT 15:16">दाविदोअ पोड़ल्यो राज्य फाशोअ उबो कोअहीं,</para>
  <para style="q1" vid="ACT 15:16">आन तियाआ डुसा बुजीत फाशोअ हुदारिहीं,</para>
  <para style="q2" vid="ACT 15:16">आन तियाहा मजबुत कोअहीं,<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />याअकाजे के बाकी रोल्ये माअहें, मोन्ज्ये आखे</para>
  <para style="q2" vid="ACT 15:17">बिगर यहुदी जियांहां माआं नावोअ काजे हाद्येहे, प्रभुहू होदुहूं जोवे,<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />ओ तोज प्रभु कोहे के जो दुन्याअ उत्पत्ती रोत यीं गोठीइ खबर कोअतू आयू.”<note caller="+" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="AMO 9:11">आमोस 9:11</ref>,<ref loc="AMO 9:12">12</ref> </char></note><verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />“तियाहा काजे माआं विसार ओ होय के बिगर यहुदीमेहें रोत जे माअहें देवोअहें फिरतेहे, आपू तियांहां दुख ने देअहूं जोवे; <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />पोन तियांहां पत्र लेखीत मोकलुहूं जोवे के, तें मुर्तीइ सोगदाय आन सिनालो आन बोस दाबीत माअल्यो माहां आन रक्त यां रोत सेटे रोअहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="EXO 34:15-17">निर्ग 34:15-17</ref>; <ref loc="LEV 17:10-16">लेवी 17:10-16</ref>; <ref loc="LEV 18:6-23">18:6-23</ref> </char></note> <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />काहाके जुना वाडोम रोत गांवों गांवोंम मोशेए नियमोअ परसार ओवतू आयुहू, आन तियाहा हारेक आरामोअ दिही आराधनालयोमेहें वासतेहे.”<verse eid="ACT 15:21" /></para>
  <para style="s">बिगर यहुदी विश्वासी माअहुंहूं सिट्टी</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />ताहरोअ प्रेशित आन डायहां पुरी मंडड़ीइरी ओं ठरव्यो के आपामेहें रोत थोड़ाक माअहुंहूं निवड़ीइलो, मोन्ज्ये यहुदा जियाहा बरसब्बास कोतेहे, आन सिलासोहो जो विश्वासी पायहोंमेहें मुख्य ओतू; आन तियांहां पौलुस आन बरनबासोअरी अंताकिया मोकल्या.<verse eid="ACT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 15:23" />तियां बरनबास आन सीलासोअ आथे ए सिट्टी लेखीत मोकल्यी: “अंताकिया, सिरिया आन किलिकियामेहें रोनारा विश्वासी पायहोंहों जे बिगर यहुदीमेहें रोत होय, तुमाआं पाही प्रेशित आन डाया याआं वोगेहे रोत तुमुहूं सलाम. <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />आमू उनाअयाहा के आमामेर्‍याआ थोड़ाक जोंअ तिहीं जात कोइत, तुमुहूं तियांआं गोठी वाअहीं काबरावी देदा; आन तुमाआं मोने दुखाड़ी देदेहे, पोन आमू तियांहां तेहेली सुसना ने आप्यीते. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />तियाहा काजे आमू आखाहाज मिलीत ठीक लागो के आमामेर्‍याआ थोड़ाक निवड़ीइल्या माट्योहों आपाअ मेराला पाही बरनबास आन पौलुसोअरी तुमाआं जागे मोकलो. <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />ए माटी एहेलाहा होय जियां आपाअ प्रभु ईसु ख्रिस्ताआ कामोअ काजे सोताआ जिव धोकाम टाक्यु. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />तियाहा काजे आमू यहुदा आन सिलासोहो मोकल्याहा, जे गोठी आमू लेखताहा ते सोताहा तुमुहूं कोत देये. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />आन यीं गरजेए गोठीही सोड़ीत, तुमापोअ फाशुउ बिहीरु वोजू ने टाको एहेलोह पवित्र आत्माहां आन आमुहूं ठीक लागो; <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />ते गोठी ए के तुमू मुर्तीही आपल्य गाराहा, रक्त, गोलू दाबीत माअल्य माहांमासो, आन सिनालो यांरोत सेटे रोवा. यांपरोत सेटे रोहा ताहां तुमाआं भलो ओवे. आगाड़ी तुमुहूं शांती.”<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />ताहराअ तियांहां मोकल्या तिहीं रोत ते अंताकियामेहें पोत्या, आन आखा विश्वाशाहां टिग वालीत ते सिट्टी तियांहां आपी देदी. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />ते सिट्टी वासीत कोइत तें जाअखीलेहे खुस ओवे. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />यहुदा आन सिलास जे सोताहा बी भविश्यवक्ता ओता, डाहटी गोठी वाअहीं विश्वासी पाव्हीइलाहां शिक्शण आपीत कोइत मजबुत कोअये. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />ते थोड़ाक दिही रोत कोइत, विश्वासी पाव्हीइलाआं जागे रोत तियांआं मोकलीइनाराआं जागे होकेहे वाट लागीत पोड़्या. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />पोन सिलासोहो तिहींज रोअलोअ पोट्य.<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">थोड़ाक जुना लेख्यामेहें ओं वसन नाहां जोड़तो.</char></note><verse eid="ACT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35" />पोन पौलुस आन बरनबास अंताकियामेहें रुकाइत गोया: आन बिहीरा डाहटा माअहोंअरी प्रभुउ वसनोअ हाजी बातमीइ परसार कोअता आन सिकाड़ता रोया.<verse eid="ACT 15:35" /></para>
  <para style="s">पौलुस आन बरनबासोअ वाटाइलोअ</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />थोड़ाक दिहोअ फासाड़ी पौलुसे बरनबासोहो कोयो, “जिया जिया सेहरोम आपू प्रभुउ वसन कोताप्योतो, साला, फाशाआ तियांमेहें फिरीत कोइत आपाअ विश्वासी पाव्हीइले केहेलेहे होय ते पालुहूं.” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />बरनबासोअ इश्शा ओती के योहान जियाहा मार्क कोतेहे, तियाहा आरी लेअलाअ विसार कोअयू. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />पोन पौलुसोह तियाहा आरी लेत जाअलोअ ने पोट्य, काहाके योहान जो पंफूलियामेहें रोत वोलीत आवतु रोयुतो, आन सेवाआ कामोपोअ तियांअरी आखरी जाआं ने रोयुतो. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />यी गोठी पोअ बेनुमेहें एतीही सोबासोबी ओत गोयी के बेनू आंगे आंगेज ओत गोया; आन बरनबास मार्काहा आरी लेत कोइत जाहाजीम बोहीत कोइत सायपरसोमेहें जातू रोयू. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />पोन पौलुस सिलासोहो निवड़ीत लेदू, आन विश्वासी पाव्हीइला वाअहीं प्रभुउ मेरवानीम होपाइत कोइत तिहीं रोत जातू रोयू. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />आन तो मंडड़ीही मजबुत कोअतूज सिरिया आन किलिकियामेहें ओवतुज गोयू.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">तिमथ्या पौलुसोअरी जाअलोअ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />तिहीं रोत पौलुस दिरबे आन लुस्रामेहें बी गोयू, तिहीं तिमथ्या नावोअ एक सेलू ओतू, तियाआ आयही यहुदीया वाली ओती जे विश्वासी ओती, पोन तियाआ आब्हू युनानी ओतू. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />तो लुस्रा आन इकुनियुमोमेर्‍याअ विश्वासी पायहोंमेहें हाजू नावलात ओतू. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />पौलुसोअ इश्शा ओती के तिमथ्य तियारी आवुहूं जोवे; आन जें यहुदी माअहें तियी जागे ओते, तियांआं वोजेसे तियाआ खतना कोअयू, काहाके तियां आखाहा मुंदू ओतू के तियाआ आब्हू युनानी ओतू. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />आन गांवों गांवों जात कोइत माअहोंअ जागे तियां नियम पोताड्यू, जो येरुसालेमोअ मंडड़ीइ प्रेशितहों आन डायहां ठरव्युतो, के तें माअहें तियाआ पालन कोअहूं जोवे. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />एहेंकोइत मंडड़ी विश्वासोमेहें मजबुत ओवती गोयी आन माअहोंअ गणती रोद्दीही वादती गोयी.<verse eid="ACT 16:5" /></para>
  <para style="s">त्रोआसोमेहें पौलुसोह दर्शन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />ते फ्रूगिया आन गलातिया भागोमेहें फिरताज गोया, काहाके पवित्र आत्मे तियांहां आसियामेहें वसन परसार ने कोअहूं जोवे कोत रुक्या. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />तियां मुसियाअ गावोंअ हाद्दीइ आहने पोतीत कोइत, बिथुनियामेहें जाअलोअ ईतव्यो; पोन ईसुउ आत्मा तियांहां परवानगी ने आप्यी. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />तियाहा काजे ते मुसियामेहें फिरताज त्रोआसोमेहें आया. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />तिहीं पौलुसे राती एक दर्शन देख्यो के एक मकिदुनियावालू माटी तियाआ सामने उबू रोत रावण्या कोइत कोहे, “उतरीत कोइत मकिदुनियामेहें आव, आन आमाआं मदत कोअ!” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />तियाआ ओं दर्शन हेएताज वाआ आमू ताअहांज मकिदुनिया जाअलो तियारी कोअयी, ओं समजीत कोइत के देव आमुहूं तियांहां हाजी बातमी कोतापीइलाअ काजे हाद्याहा.<verse eid="ACT 16:10" /></para>
  <para style="s">फिलीप्पीमेहें लुदियाअ परिवर्तन</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />तियाहा काजे त्रोआसोम रोत जाहाज तोइत आमू पादराज सुमात्राकेमेहें आन बिहीरे दिही नियापुलिसोमेहें आया. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />तिहीं रोत आमू फिलीप्पी पोत्या, जो मकिदुनिया इलाखाअ मुख्य सेहर आन रोमवालाअ वोहती होये; आन आमू तिया सेहरोमेहें थोड़ाक दिही जाआं रोया. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />आरामोअ दिही आमू सेहरोअ बारथे नोयीइ तोड़े ओं समजीत कोइत गोया के तिहीं प्रार्थना कोइलाअ जागू ओये, आन बोहीत कोइत तिहीं टिग वोलीत रोल्यी बोईंइरी गोठी कोआ वोल्या. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />लुदिया नावोअ थुवतीरा होयरोअ जामण्ये साअके वेसनारी एक भक्तण बाय उनाअया कोअतीते. प्रभु तियीइ मोन उगाड़्यो के ते पौलुसोअ गोठीपोअ मोन लागाडे. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />जेहेलाम लुदिया तियीइ कुटूंबाअरी बाप्तिस्मा लेदो, ताहां तियी आमुहूं रावणी कोअयी के, “तुमू जर माहूं प्रभुउ खरी विश्वासी समजीइतेय, ताहां साला आन माआं कोअमेहें रोवा,” आन ते बाय आमुहूं मानाड़ीत कोइत लेत गोयी.<verse eid="ACT 16:15" /></para>
  <para style="s">फिलिप्पीइ जेलेमेहें</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />एक दिही आमू जेहेलाम प्रार्थना कोइलाअ जागे जाताते, तेहेलाम एक पुतवाअली बोयोंअ मिल्यी, जियीमेहें भविश्य कोनारी पुतोअ आत्मा ओती. ते भविश्य कोत कोइत तियीइ मालख्योहो जाअखीलाहा पोशा कामावित आपतीते. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />ते पौलुसोअ आन आमाआं फासाड़ी आवित कोइत आअड़ी वोल्यी, “एं माअहें आखाम रोत वोडा देवोअ सेवक होये, जें तुमुहूं सुटकाअ वाटेए काईं कोतापतेहे.” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />ते बोयोंअ जाअखीलाहा दिही जाआं एहेंज कोअती रोयी; पोन पौलुस जुदू ओसवाअयू, आन वोलीत कोइत तियी आत्माहां कोयो, “आंय ताहूं ईसु ख्रिस्ताआ नावसे आदेश आपोहो के यी बोईंमेहें रोत निहीत जा!” तेताजमेहें ते आत्मा तियीम रोत निहीत गोयी.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />जेहेलाम तियी बोड़वीइ मालख्योहों मुंदू गोयू के आमाआं कामायीइ आशाज जाती रोयी, ताहां पौलुस आन सिलासोहो तोइत कोइत सौकडीमेहें आधिकार्‍योंअ जागे गोसाट्टाज लेत गोया; <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />ते तियांहां रोमन आधिकार्‍योंअ जागे लेत गोया आन कोयो, “एं माअहें जे यहुदी होये, एं आपाअ गांवोंमेहें दोंगू माताड़तेहें; <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />आन एहेलिही रिती कोतापतेहे, जियींहीं स्विकार कोइलोअ नेत मानीइलो आपाअ रोमनवाला माअहोंअ काजे कायदाअ पुरमाणे बोराबर कायनाहां.”<verse eid="ACT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />ताहरीइ माअहोंअ गर्दी बी तियांआं विरुद्धामेहें टोलू वोलीत कोइत पौलुस आन सीलासोअहें गुगदीत आयी, तेहेलाम आधिकारी तियांआं आंगड़े फाडीत कोइत काडीत टाक्ये, आन तियांहां सापका देअलोअ आदेश आप्यू. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />ताहराआ जाअखीलाहा सापका देत कोइत तियां सिलास आन पौलुसोहो जेलेमेहें टाकी देदा, सिपायडाअ मुख्याहा आदेश आप्यू के तो तियांहां वारुहूं केंडीत मिके. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />तिये ओ आदेश उनात कोइत तियांहां मायतेए खुलीमेहें मिक्या आन तियांआं गुडा लाकडामेहें सिपड़ी देदा.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />आरदी राती पौलुस आन सिलास प्रार्थना कोअता जात देवोअ भजन गावया कोअताते, आन जेलीमेर्‍येए बाकी माअहें कान देत उनाअया कोअतेते. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />तेताजमेहें एक वोडो भुकंप ओयो, जेलेए पायू जाआं आलित गोयू, आन ताब्बुड़ आखे बाअणे उगड़ीत गोये; आन जेलेमेर्‍याआ आखाआ बेड़ी टुटीत गोयी. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />जेलेए राखवाली निंदेम रोत जाग्यू, आन जेलेए बाअणे उगडाअले देखीत कोइत समज्यो के जेलेमेर्‍येए माअहें नाहींत गोयेहे, तियाहा काजे तिये तलवार काडीत कोइत सोताहाज मोइत जाअलो इतव्यो. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />पोन पौलुस वोडा आवाजोमेहें आअड़ीत कोइत कोयो, “सोताआ काविंहीं नुकसान मा कोइत लेही, काहाके आमू आखा इहींज होये.”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />ताहरुउ जेलेए राखवाली कोअनारे एक कोंदील मागाड्यू आन ताब्बुड़ मायते गुगद्यू, आन कापतू कापतू पौलुस आन सिलासोअ पागे पोड़्यू; <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />आन तियांहां बारथे काडीत कोइत फुशो, “महाराज, वासाइलोअ काजे आंय की कोओ?”<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />पौलुस आन सीलासे कोयो, “प्रभु ईसु पोअ विश्वास कोअ, ताहां तू आन ताआ कुटूंबो वासाइत जाये.” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />आन पौलुस आन सिलास तियाहा आन तियाआ कोअमेर्‍याआ आखा माअहुंहूं प्रभुउ वसन कोताप्य. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />तियी वेले रातीज तिये जेलेए राखवाल्ये तियांहां लेत जात कोइत तियांआं जखम तुवयी, आन तिये आन तियाआ आखा माअहूं तुरतुज बाप्तिस्मा लेदो. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />ताहरोअ तिये तियांहां तियाआ कोअमेहें लेत जात कोइत रोटू खावाड़्यू, आन आखा कोअबार्‍याअरी देवोपोअ विश्वास मिकीत खुशी कोअयी.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />जेहेलाम दिही उगु ताहराअ रोमन आधिकार्‍यों सिपायडाअ मुख्याहा कोत मोकल्यो, के तियां माअहुंहूं सोड़ी द्या.<verse eid="ACT 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36" />जेलेए राखवाल्ये ए गोठी पौलुसोहो कोयी, “आधिकार्‍ये तुमुहूं सोड़ी देअलोअ आदेश मोकल्युहू. तियाहा काजे ओमे निहीत कोइत होकेहे जाता रोवा.”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />पोन पौलुस सिपायडाअ आधिकार्‍योहो कोयो, “आमू जे रोमन माटी होय, बिगर गुनेज माअहोंअ सामने देदा आन जेलेम टाक्या. ओमे काहा आमुहूं ठावकाज काडताहा? एहेलोहो ने जोवे; पोन रोमवाला आधिकारी सोताहा आवित कोइत आमुहूं बारथे काडुहूं जोवे.”<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />सिपायडाअ आधिकार्‍यों ए गोठी रोमन आधिकार्‍योहों कोयी, आन ते ओं उनाइत कोइत बित गोया, के ते रोमी होय. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />आन आवित कोइत तियांहां पोटावया, आन बारथे लेत जात कोइत रावणी कोअयी के गावोंम रोत जाता रोवा. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />ते जेलेम रोत निहीत कोइत लुदियाअ कोअ गोया, आन विश्वासी पायहोहों मिलीत कोइत तियांहां धिर आपीत कोइत जाता रोया.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">थेस्सलनीके सेहरोम</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />ताहराअ पौलुस आन सिलास अम्फिपुलिस आन अपुल्लोनियामेहें फिरताज थेस्सलनीकेमेहें आया, जिहीं यहुदी वालाआं एक आराधनालय ओतो. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />पौलुस तियाआ रितीइ परमाणे तिहीं गोयू, आन तीन आरामोअ दिही जाआं वसनोम रोत तियांअरी गोठी कोअयी; <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />आन तियाआ अर्थ फोड़ कोइत समजाड़तुतो के ख्रिस्ताआ दुख वेठीइलो, आन मोल्याम रोत जिवीत उठीइलो, याअ गरज ओती; आन “ओज ईसु जियाअ आंय तुमुहूं गोठी कोतापोहो, ‘ख्रिस्त’ होये.” <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />तियांमेर्‍याआ थोड़ाक माअहूं भरिवसू कोअयू आन तें पौलुस आन सिलासोअरी जुड़ात गोये. आन डाहटे युनानी आन वारुज हाजला घराणाअ बायहीं बी ओती जियीं देवोअ भक्ती कोअयी.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />पोन यहुदी माअहें जोरोम आवित ऊगार माअहूंमेहें रोत थोड़ाक गुंडा माअहुंहूं तियांअरी लेत लेदा, आन गर्दी टिग वालित कोइत गावोमेहें दोंगु माताड़ा वोल्या, आन यासोनोअ कोओपोअ देत कोइत तियांहां माअहुंउं सामने लेत आविइलाअ कोशित कोअयी. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />पोन ते तियांहां ने मिल्या, तिहीं वाअहीं ते ओं आअड़ीइतेज यासोन आन थोड़ाक विश्वासी पायहोहो गांवोंअ पुढार्‍योंअ सामने ओडीत लेत गोयान कोयो, “जियां कोलीही उलटीफुलटी कोई देदीही, तें माअहें इंहीं बी आवित लागेहे.”<verse eid="ACT 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 17:7" />यासोने तियांहां सोताआ कोअमेहें हाद्ये. एं आखेज एहें कोतेहे के ईसु राजा होये, आन कैसरोअ नियमोहों विरोद कोअतेहे <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />तियां माअहुंहूं आन गावोंअ पुढार्‍योहों ओं उनाड़ीत कोइत बिवाड़ी देदा. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />याअकाजे तियां यासोन आन थोड़ाक माअहोंहों जामिन लेत कोइत सोड़ी देदे.<verse eid="ACT 17:9" /></para>
  <para style="s">बिरीया सेहरोमेहें</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />विश्वासी पायहों ताब्बुड़ राताम रात पौलुस आन सिलासोहो बिरीया मोकली देदा; आन ते तिहीं पोतीत कोइत यहुदीया वालाआ आराधनालयोमेहें गोया. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />ए माअहें ते थेस्सलनीके मेर्‍याआ माअहोंअ रोत खुब हाजे ओते, आन तियां वोडी तलबे वाअहीं वसन स्विकार्‍य, आन हारेक दिही वसन वासित जे गोठी पौलुसे कोयीते ते कांय बोराबर होय के नाहां तों तापासतेते. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />तियाहा काजे तियांमेर्‍येए डाहटे जोएं, आन युनानीमेएं जाअखीलेहे जोएं वोडा घराणाआं बोईंन माट्यों विश्वास कोअयू. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />जेहेलाम थेस्सलनीकेवालां यहुद्याहां मुंदू गोयू के पौलुस बिरीयामेहें बी देवोअ वसन कोतापेहे, ताहां तिहीं बी आवित कोइत माअहुंहूं उरी सोढव्यी आन भान्गड़ माताड़े वोल्ये. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />ताहराअ विश्वासी पाही ताबुड़ पौलुसोहो दोर्‍याअ टेकोपोअ जायतेहें काजे मोकली देदू; पोन सिलास आन तिमथ्य तिहींज रोत गोया. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />पौलुसोहो पोताड़नारा विश्वासी तियाहा एथेन्स जाआं लेत गोया; आन सिलासे ना तिमथ्य तियाआ जागे वेगा आवे तेहें काजे ते पौलुसोअ आदेश लेत कोइत निहींया.<verse eid="ACT 17:15" /></para>
  <para style="s">एथेन्स सेहरोमेहें</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />जेहेलाम पौलुस एथेन्स होयरोमेहें तिमथ्या आन सीलासोहो वाट जोवतुतो, तेहेलाम तो गांवोंमेहें मुर्तीन मुर्ती पालीत कोइत तियाहा आत्मामेहें जुदो दुख लागो. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />तियाहा काजे तो यहुदीइ आराधनालयोमेहें यहुद्याहां आन बिगर यहुद्याहां जें देवोअ भगत, बाजारोम आवनारा जानारा माअहोंअरी दाड़ख्युउ वादावादी कोअया कोअतुतो.<verse eid="ACT 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 17:18" />ताहराअ इपिकुरी आन स्तोईकी जाणकारो मेर्‍याआ थोड़ाक जोओं वादावादी कोआ वोल्या, आन थोड़ाक जोओं कोयो, “ओ सोकनारु की सोकेहे?” पोन बिहीरा कोयो, “ओ बिहीरा देवोअ परसार कोअनारु जेहें लागेहे,” काहाके तो ईसुउ आन मोल्याम रोत जिवीत उठीइलाअ हाजी बातमी कोतापतुतो. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />ताहराआ तियां पौलुसोहो तियांअरी अरियुपगुस टेकड़ीपोअ लेत जात फुशो, “आमू जाईंत सेकताहा, के ए नोवी शिक्शा जे तु कोतापेहे, की होय? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />काहाके तू जे आमुहूं ओजाण्यी गोठी कोतापेहे, तियाहा काजे आमुहूं जाईंलोअ होय के याअ अर्थ की होये.” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />याअकाजे के एथेन्सवाले आन जिवण्ये जें तिहीं रोतेते, नोवी नोवी गोठी कोअलाअ आन उनाइलाआ सोड़ीत बिहीरो कीज काम ने कोअतेते.<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />ताहरुउ पौलुस अरियुपगुसोअ विसमेहें उबू रोत कोइत कोयो, “ए एथेन्सवालां, तुमू हारेक गोठीमेहें देवोहो खुब माननारे माअहें होय एहेलोहो माहूं देखाअहे. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />काहाके आंय तुमाआं होयरोमेहें फिरता फिरता जेहेलाम तुमाआं भक्ती कोइलाअ जागाहा पाल्यो, तेहेलाम एक एहेलोह देवान्यो बी देख्यो, जिहीं पोअ लेख्योतो, ‘ओजाण्या देवोअ काजे.’ तियाहा काजे जियाहा तुमू नाहां ओलखीइते पोन भक्ती कोअतेहे, तियाआ बाप्तिमेहें आंय तुमुहूं कोत आपोहो. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />जिये देवे धरती आन तियाआ आखी वस्तुहू बोणायी, तो होरगो आन धरतीइ मालिख होय आन आथो वाअहीं बोणावल्या मंदिरोमेहें नाहां रोतू; <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />आन नाहां तियाहा काविंहीं वस्तुउ कमी कोत मोनवीइ आथोअ सेवा लेतू, काहाके तो ताम सोताहाज आखाहा जिवन, हाह आन आखोज आपत्लू.<note caller="+" style="x"><char style="xo" closed="false">17:25 </char><char style="xt" closed="false"><ref loc="ISA 42:5">यश 42:5</ref>; <ref loc="ACT 7:48">प्रेशित 7:48</ref></char></note> <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />तिये एका माअहूं वाअहीं पुरी मोनवीइ जात पुरी धरती पोअ रोय तेहें काजे बोणावयीही; आन तिये तियांआं वेल आन तियांआं रोअलाअ जागाअ हींव ठरवी देदीही. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />याअ कोअते के, तें देवोहो होदीत पाले, आन केहेंनेत तो तियांहां जोड़े, तेबी तो आपामेर्‍याआ कोडा रोत सेटे कायनाहां. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />कोडे तेबी कोयोहो,</para>
  <para style="p" vid="ACT 17:28">“‘काहाके आपू तियामेहें जिवतेहे, सालते फिरतेहे आन टिकीत रोतेहे.’ तुमाआं केताहा तेबी कवी जाआं कोयोहो के, ‘आपू ताम तियाआज पोर्‍ये होये.’<verse eid="ACT 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29" />“तियाहा काजे आपू देवोअ पोर्‍ये होय, तेबी होना, सांदी नेत डोणोअ बोणावल्यी मोनवीइ कलाकारी आन कारागिरी वाअहीं कोड़ल्या रुपोहो देव कोत समजीइलोअ आपाआ काजे बोराबर कायनाहां. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />तिहींज वाअहीं माहें देवोहो ने ओलखीइतेते, तियी वेलेएहें देवे ध्यान ने देदो, पोन ओमे हारेक जागे बादा माअहुंहूं मोन फिरावीलाअ आदेश आपेहे. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />काहाके तिये एक दिही एहेलुहू ठरव्युहू के, जिहींमेहें तिये नेमल्यू एक माटी ईसु वाअहीं तो दुन्याअ न्याय निवाडु सतीपणो वाअहीं कोए; आन जियाहा तिये मोल्याम रोत जिवाड़ीत कोइत ए गोठ आखा माअहूं पोअ पुरावू कोइत देखाड़ी देदुहू.”<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />मोल्याम रोत जिवित उठीइलाअ गोठ उनाइत कोइत थोड़ाक ताम पौलुसोहो ओंहां वोल्या, आन थोड़ाक जोओं कोयो, “ए गोठ आमू तापोअ रोत एकदू दिही उनाअहूं.” <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />तियाहा काजे पौलुस तियांआं विसमेहें रोत निहीत गोयू. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />पोन थोड़ेक माअहें तियाअरी जुड़ात गोये, आन विश्वास कोअयू; तिहींमेएं दिओनिसियुस जो अरियुपगुस होयर पोन्साअ सदस्य ओतू, आन दामारिस नावोअ एक बायी ओती, आन तियांअरी फाशेए बी माअहें ओते.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">करिन्थ सेहरोम पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />तिहींइं फासाड़ी पौलुस एथेन्स होयर टाकीत करिन्थमेहें आयू. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />तिहीं तियाहा अक्विला नावोअ एक यहुदी मिल्यू, जियाअ जल्म पोन्तुसोमेहें ओयोतो. तो तियाआ लाडी प्रिस्किल्लाअरी इटली रोत तेहेलाजमेहें आयुतो, काहाके क्लौदियुसे आखा यहुदीही रोम सेहरोम रोत निहीत जाअलाअ आदेश आप्युतो. तियाहाज काजे पौलुस तियांहां मिलू गोयू. <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />पौलुसोअ आन तियांआं एकुज धंदू ओतू, तियाहा काजे तो तियांअरी रोयू आन तियांअरी तंबू बोणावीइलाअ काम कोअयो, काहाके तंबू बोणावीलाअ तियांआं धंदू ओतू. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />तो हारेक आरामोअ दिही आराधनालयोमेहें वाद-विवाद कोइत यहुदीही आन युनानीही कोल्यी गोठी पोअ विश्वास मिके तेहें काजे तो कोत समजाडीइलोअ कोशित कोअतुतो.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />जेहेलाम सिलास आन तिमथ्या मकिदुनियाम रोत आया, ताहां पौलुस वसन कोतापीइलाअ धुंदेमेहें यहुदीही साक्शी कोतापू वोल्यू के ईसुज ख्रिस्त होय. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />पोन जेहेलाम तें विरोद आन निंदा कोए वोल्ये, ताहां तिये तियाआ आंगड़े झटकीत कोइत कोयो, “तुमाआं रक्त तुमाआंज बोसी रोये! आंय निर्दुस होय. ओमे रोत आंय बिगर यहुद्याआं जागे जानारु.” <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />तिहीं रोत उठीत कोइत तो तितुस युस्तुस नावोअ देवोअ एका भक्तोअ कोअमेहें आयू; तियाआ कोअ आराधनालयोहो लागीत ओतो. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />ताहरुउ आराधनालयोअ पुडारी क्रिसपुसे तियाआ पुरो घराणो मिलीत प्रभुपोअ विश्वास मिक्यू; आन वारुज करिन्थवालां उनाइत कोइत विश्वास मिक्यू आन बाप्तिस्मा लेदो. <verse eid="ACT 18:8" /><verse number="9" style="v" sid="ACT 18:9" />प्रभु एकी राती दर्शनोवाअहीं पौलुसोहो कोयो, “मा बिही, पोन कोतूज जा आन बोंद मा रोही; <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />काहाके आंय ताअरी होंव, आन कोडोज ताआ नुकसान ने कोइत सेके; काहाके या गावोमेहें माआं जाअखीलेहे माअहें होय.” <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />तियाहा काजे तो तियांमेहें देवोअ वसन सिकाडतू जात डेड़ वोर्ह्ये जाआं रोयू.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />जेहेलाम गल्लियो अखाया देसोअ राज्यपाल ओतू, ताहां यहुदी माअहें एकी कोइत पौलुसोअहें सालित आये, आन तियाहा कोर्ठोम लेतावीत कोने वोल्ये, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />“ओ माअहुंहूं समजाडेहे के देवोअ भक्ती एहेली रिती वाअहीं कोअहूं जोवे, जे कायदाअ विरुद्दाम होये.”<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />जाहां पौलुस गोगुहूंज कोअतुतो, तेहेलाम गल्लियो यहुद्याहां कोयो, “ए यहुदीया वाला, जर ए काविंहीं अन्याय नेत सुकीइ गोठ रोती, ताहां बोराबर रोतो के आंय तुमाआं उनाअतू. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />पोन जर ए गोठी भान्गडीइ शब्दाअ, आन नावोअ, आन तुमाआं जागर्‍याअ कायदाअ बाप्तिमेहें ओय, ताहां तुमुहूंज मुंदू; काहाके आंय एहेली गोठीइ न्यायी नाहां बोणनारु.” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />आन तिये तियांहां कोर्ठाम रोत काडी देदे. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />ताहरेए आखे माअहें आराधनालयोअ पुडारी सोस्थेनेसोहो तोइत कोइत कोर्ठोअ सामने देदू. पोन गल्लियो यीं गोठी पोअ किज दिहान ने देदो.<verse eid="ACT 18:17" /></para>
  <para style="s">अंताकियाम वापिस वोलीइलो</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />पौलुस जाअखीला दिही जाआं तिहीं रोयू. ताहरुउ विश्वासी पायहोंअरी रोत विदा ओत कोइत किंख्रियामेहें याअकाजे मुन्को कात्रायो, काहाके तिये पालनी तोअयीते,<note caller="+" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="NUM 6:18">गणती 6:18</ref></char></note> आन जाहाजेपोअ सिरिया जानु वोल्यू आन तियाअरी प्रिस्किल्ला आन अक्विला ओते. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />तिये इफिसोम पोतीत कोइत प्रिस्किल्लान अक्विलाहा तिहीं सोड्ये, आन तो आराधनालयोमेहें जात कोइत यहुद्यांअरी तोणाउ वोल्यू. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />जेहेलाम तियां तियाहा विनंती कोअयी, “आमाअरी फाशाअ थोड़ाक दिही रो.” ताहां तो ने मान्यू; <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />पोन ओं कोत कोइत तियांअहीं रोत जानु वोल्यू, “जर देवोअ इश्शा ओय ताहां आंय तुमाआं जागे फाशुउ आविहीं.” ताहरुउ तो इफिसोमेहें रोत जाहाजेम बोहीत कोइत जातू रोयू;<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />आन केसरियामेहें उतरीत कोइत येरुसालेमोम गोयू आन मंडड़ीही सलाम कोइत अंताकियाम आयू. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />ताहरुउ थोड़ाक दिही रोत कोइत तो तिहीं रोत निहींयू, आन एकी वोगेहे रोत गलातिया आन फ्रूगिया मुलखोमेहें आखा सेलाहा मजबुत कोअतू फिर्‍यू.<verse eid="ACT 18:23" /></para>
  <para style="s">इफिस आन करिन्थ होयरोमेहें अपुल्लोस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />अपुल्लोस नावोअ एक यहुदी, जियाअ जल्म अलेक्झांद्रियामेहें ओयोतो, जो हुशार माटी ओतू आन वसनोहों वारुहूं जांअतुतो, तो इफिसोमेहें आयू. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />तिये प्रभुउ मार्गाआ शिक्शण लेदोतो, आन मोन लागाड़ीत कोइत ईसुउ बाप्तिम वारुहूं वारुहूं उनाअतू आन सिकाड़तुतो, पोन निस्ती योहानोअ बाप्तिस्माआं गोठ तियाहा मुंदू ओती. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />तो आराधनालयोमेहें बिन्दास ओत कोइत गोगु वोल्यू, पोन प्रिस्किल्ला आन अक्विला तियाआ गोठी उनात कोइत तियाहा तियांआं जागे लेत गोये आन देवोअ वाट तियाहा जाअखी वारुहूं कोताप्यी. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />जेहेलाम अपुल्लोसे ठरव्यो के तियी तोड़ उतरीत कोइत अखायामेहें जाअलोहो, ताहां विश्वासी पायहों तियाहा हिम्मत आपीत कोइत अखायावाला विश्वास्याहां लेख्यो के ते तियाहा वारुहूं मिलुहूं जोवे; आन तिये तिहीं पोतीत कोइत तियां माअहोंअ खुब मदत कोअयी जियां देवोअ मेरवानी वाअहीं विश्वास कोअयुतो. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />काहाके तो वसनोअ आधारो वाअहीं ईसु ओज ख्रिस्त होये कोत वोडी हिम्मतो वाअहीं यहुदी माअहोंअ आगाड़ी कोतू रोयू.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">इफिस होयरो मेहें पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />जेहेलाम अपुल्लोस करिन्थमेहें ओतू, ताहां पौलुस उसर्‍याआ आखा मुलखोम रोत इफिसोमेहें आयू. तिहीं थोड़ाक सेलाहा पालित कोइत<verse eid="ACT 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 19:2" />तियांहां कोयो, “केहें तुमुहूं विश्वास कोइलाअ वेले पवित्र आत्मा जोड़्यू?” तियें तियाहा कोयो, “आमू ते पवित्र आत्माआं बाप्तिमेहें गोठ बी नाहां उनाअया.”<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />तिये तियांहां कोयो, “ताहां तुमू कोडाअ बाप्तिस्मा लेदो?” तियें कोयो, “योहानोअ बाप्तिस्मा.”<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />पौलुसे कोयो, “जो माआं फासाड़ी आवनारु होय, तियाआ पोअ मोन्ज्ये ईसु पोअ विश्वास कोअजा, एहें कोत योहाने मोन फिरावीलाअ बाप्तिस्मा आप्यो.”<note caller="+" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="MAT 3:11">मत्तय 3:11</ref>; <ref loc="MRK 1:4">मार्क 1:4</ref>,<ref loc="MRK 1:7">7</ref>,<ref loc="MRK 1:8">8</ref>; <ref loc="LUK 3:4">लुक 3:4</ref>,<ref loc="LUK 3:16">16</ref>; <ref loc="JHN 1:26">योहान 1:26</ref>,<ref loc="JHN 1:27">27</ref> </char></note><verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />ओं होंबलीत कोइत तियां प्रभु ईसुउ नावोमेहें बाप्तिस्मा लेदो. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />जेहेलाम पौलुसे तियांपोअ आथ मिक्यू, तेहेलाम तियांपोअ पवित्र आत्मा उतर्‍यू, आन तें जुदी-जुदी बाशा गोगे वोल्ये आन भविश्यवाणी कोए वोल्ये. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />ते लगबग बारा माटी ओता.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />तो यहुदी आराधनालयोमेहें जात कोइत तीन मोयना जाआं हिम्मते वाअहीं गोगतू रोयू, आन देवोअ राजोअ बाप्तिमेहें गोठी कोअतू आन समजाड़तू रोयू. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />पोन जेहेलाम थोड़ेक माअहें कुंगे ओत कोइत तियाआ ने मान्ये पोन माअहुंउं आगाड़ी या मार्गाहा खाराब कोने वोल्ये, ताहां पौलुसे तियांहां सोड़ी देदेन सेलहांहां आलाग कोइत लेदा, आन दाडीइज तुरन्नुसोअ शाड़ामेहें गोठी कोताप्या कोअतुतो. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />बेन वोरह्ये जाआं एहेंज कोइत सालतो रोयो, तेतोज नाहां पोन आसियामेहें रोनारा, यहुदी आन युनानी यां आखाज प्रभुउ वसन उनाइत लेदो.<verse eid="ACT 19:10" /></para>
  <para style="s">स्केवाअ पोऱ्या</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />देव पौलुसोअ आथोवाअहीं ओकल ने पुरे एहेलेहे कामे देखाड़तुतो. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />तेतोज नाहां पोन रुमाल नेत आंगड़े तियाअरी हारीत कोइत मांदवाड़्यां पोअ टाकतेते, आन तियांआं बिमारी जाती रोतीते; आन पुते तियांमेहें रोत निहीत जाया कोअतेते. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />पोन थोड़ेक यहुदी जें मोतीरते फिरतेते, एहेलोह कोए वोल्ये के जियामेहें पुते ओय तियापोअ प्रभु ईसुउ नाव एहें कोत कोइत फुकीइलो, “पौलुस जिया ईसुउ परसार कोअहे, तियाआज आंय तुमुहूं शप्पत आपोहो.” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />आन स्केवा नावोअ एका यहुदी मुख्य पुंजाराआ हांत पोर्‍या ओता, जे एहेंज कोअताते.<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />पोन पुते तियांहां उत्तर आप्यो, “ईसुहू आंय ओलखोहो, आन पौलुसोहो बी ओलखोहो, पोन तुमू कोडा होय?”<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />आन तिये माहें जियामेहें पुत ओतू तियांअहें गुगदीइतोज आयोन तियांहां ताबम कोइत, तियांहां एहेलुहू तारास कोआड्यू के ते दुखाअया आन नागराज तिया कोअमेहें रोत निहीत गुगद्या. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />ए गोठ इफिसोम रोनारा आखा यहुदी आन युनानीही बी मुंदू गोयू, आन तियां आखाहा बित लागी; आन प्रभु ईसुउ नावोअ वोडाय ओवी. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />जियां विश्वास कोअयुतो, तियांमेहें रोत वार जोओं आवित कोइत जिवज्योअ कामोहों मानित लेदे आन कबुल कोअये. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />जादू कोअनारामेहें रोत वार विश्वासी माअहें जिवज्योअ पुस्तके टोलू वालित कोइत आखाआ सामने पेटाड़ी देदे, आन तियांआं किंमत काड्यी ताहां, तें पोन्नास हाजार सांदीइ रुप्या एतीही निहींयी. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />एहें कोइत प्रभुउ वसन सेक्ती वाअहीं पसरीइतो आन एकदम जबरदस्त वादतो गोयो.<verse eid="ACT 19:20" /></para>
  <para style="s">इफिसोमेहें दोंगू</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />जेहेलामेहें ए गोठी ओत सुकी ताहां पौलुसे आत्मामेहें ठरवीत लेदो के मकिदुनिया आन अखायामेहें रोत ओवतुज येरुसालेमोमेहें जांव, आन कोयो, “तिहीं जाअलोअ फासाड़ी माहूं रोम होयरोहो बी पालाअहूं जोवे.” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />तियाहा कोत तिये आरी मदत कोअनारामेहें रोत तिमथ्या आन इरास्तुसोहो बी मकिदुनिया मोकलीत कोइत सोताहा तिहीं आसियामेहें थोड़ाक दिही रोत गोयू.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />तियी वेले या प्रभुउ मार्गाअ वाखरी इफिस होयरोम वोडू दोंगू ओवू. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />काहाके देमेत्रियुस नावोअ एक हुनार अरतिमिसोअ सांदीइ मंदिर बोणावाडीत कारागिरोहों खुब काम आप्या कोअतुतो. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />तिये तियांहां आन एहेलीज वस्तुउ कारागिरोहों टोलू वालीत कोइत कोयो, “माट्यों, तुमुहूं मुंदू होय के, या कामों वाअहीं आपुहूं केताहा पोशा जोड़ताहा. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />तुमू उनाअताहा के निस्त इफिसोमेहें एतोज नाहां, पोन पुरा आसियामेहें ओं कोय कोय ये पौलुसे डाहटा माअहुंहूं समजाड़्ये आन भटकाड़्येहे बी, के जें आथोअ कलाकारी होय, तें देव कायनाहां. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />यावाअहीं ओमे निस्ती यी गोठी एतीज बिक कायनाहां के आपाअ या धंदाआ इज्जत जाती रोनारी, पोन महान देवी अरतिमिसोअ मंदिर बी एठो समजाये, आन जियीही आखो आसिया आन दुन्या पुंजेहे तियीइ किंमत बी जाती रोनारी.”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />ते ओं उनाइत कोइत खोते वाअहीं खिजवात उठ्ये आन आअड़ी-आअड़ीइ कोने वोल्ये, “इफिसोवालाआं अरतिमिस, महान होय!” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />आन पुरा होयरोमेहें पुरी गड़बड़ ओत गोयी, आन माअहें मकिदुनियावाला रेवासी गयुस आन अरिस्तर्खुसोहो जे पौलुसोअ आरी हेंगाती ओता, तियांहां तोइत लेदा, आन एकवार्‍येज नाटकशाड़ामेहें गुगदीत गोये. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />जाहां पौलुसे माअहुंउं जागे मायते जाअलाआ कोअयो ताहां सेलां तियाहा जाअहूंन्ने देदू. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />आसियावाला आधिकार्‍यों मेर्‍याआ पौलुसोअ थोड़ाक दोस्ती ओता तियां तियाआ जागे कोत मोकल्यो आन विनंती कोअयी के नाटकशाड़ामेहें जात कोइत दुख मा वेठीही. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />तिहीं एखु कीज आअड़ीइतोतो आन एखु कीज कोअतोतो, काहाके पोन्सामेहें वोडी गड़बड़ी ओवतीते, आन वारुज माहुंहूं ते ओंज मुंदूज ने ओतू के आपू किहाअ काजे टोलू वोल्येहे. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />ताहां तियां अलेक्झान्डरोहो, जियाहा यहुद्यांज उबू कोअयुतो, गर्दीम रोत आगाड़ी कोअयू. अलेक्झान्डरे आथोवाअहीं इशारु कोइत माअहोंअ सामने उत्तर आपीइलाअ कोशित कोअयीते. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />पोन जाहां तियां जांइत लेदो के तो यहुदी होय, ताहां आखे एका आवाजोम पुरा बेन तास जाआं आअड़ीइतेज रोये, “इफिसोवालाआं अरतिमिस, महान होय!”<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />ताहरुउ होयरोअ मंत्री माअहोंहों शांत कोइत कोयो, “ए इफिसोवालां, कोडाहा ने मुंदू के इफिस होयरोअ महान देवी अरतिमिसोअ मंदिर, आन ज्यूसोअहें<note caller="+" style="f"><char style="fr" closed="false">19:35 </char><char style="fq" closed="false">ज्यूसोअहें </char><char style="ft" closed="false">मोन्ज्ये जुगोम</char></note> रोत पोड़ल्या सोका डोणोअ मुर्तीइ साकरीवालो इफिस होय. <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />तियाहा काजे यी गोठीइ नाकारनारो कोडोज नाहां ताहां तुमू ठावके रोवा, आन विण सोशे-समज्येज किज मा कोअहा. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />काहाके तुमू यां माट्योहों लेतायाहा जे नाहां मंदिरोहो लुटनारा के नाहां आपाअ देवीइ निंदा कोअनारा होय. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />जर देमेत्रियुस आन तियाआ जोड़ीदार कारागिरोओं एखाअरी भान्गड़ ओय ताहां कोर्ठ खुल्लो होय आन आधिकारी बी ताम होय; ताहां एकान एकापोअ आरोप लागाड़ीत सेकताहा. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />पोन जर तुमू एखी बिहीरी गोठीइ बाप्तिम फुसीइलाअ कोअता ओय, ताहां ठरिवल्या पोन्सामेहें फैसलू लेवाय. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />काहाके आज्याआ दोंगाअ किज कारण कायनाहां, ताहां आपुहूं यी गर्दी टोलू वोलीइलाअ किज उत्तर ने आपीत सेकाय, तिहीं वाअहीं आपापोअ दोश लागीत सेके एहेलिही बिक होय.” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />एहें कोत कोइत तिये पोन्साहा वेरायतेहें कोयो.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">मकिदुनिया आन आसिया</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />जाहां दोंगू बोंद ओवू ताहां पौलुसे सेलाहां हादाड़ीत कोइत समजाड्या, आन तिये आंय जाहो एहें कोत कोइत मकिदुनियाअहें जानु वोल्यू. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />तिया आखा मुलखोमेहें फिरतुज आन सेलाहां खुब धिर आपीत कोइत तो ग्रीस देसोमेहें आयू. <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />जेहेलाम तिन मोयना रोत कोइत तो तिहीं रोत जाहाजेम सिरियाअहें जाअहूं ओतू, तेहेलाम यहुदी तियाहा माइलाअ फासाड़ी लागा, तियाहा काजे तिये ओं निर्णय लेदो के मकिदुनियाम फिरीत कोइत वोलीत जांव. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />बिरीयावालू पुर्रुसोअ पोर्‍यू सोपत्रस, थेस्सलनीमेर्‍याआ अरिस्तर्खुस आन सिकुन्दुस; दिरबेवालू गयुस; तिमथ्या आन आसिया भागोअ तुखिकुस आन त्रुफिमुस आसिया जाआं तियाअरी गोया. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />ते आगाड़ी जात कोइत त्रोआसोमेहें आमाआं वाट जोवता रोया. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />आन आमू विण खमीरोअ रोटाअ दिहोअ फासाड़ी फिलीप्पीम रोत जाहाजेम बोहीत कोइत पास दिहोम त्रोआसोमेहें तियाआ जागे पोत्या, आन हांत दिही जाआं तिहींज रोया.<verse eid="ACT 20:6" /></para>
  <para style="s">त्रोआसोमेहें पौलुसोअ सेलवार्‍योअ मिलणो</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />आठीवड़ाआ पेल्लेए दिहे जेहेलाम आमू रोटू मुड़ीइलाअ<note caller="+" style="x"><char style="xo" closed="false">20:7 </char><char style="xt" closed="false"><ref loc="ACT 2:42">प्रेशित 2:42</ref></char></note> काजे टोलू वोल्या, ताहां पौलुस तियांअरी गोठी मिकू वोल्यू, काहाके तो बिहीरे दिही जानारु ओत्लू, आन तिये पोरापोर राती जाआं गोठी मिक्याज कोअयी. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />जियी उपर्‍यीइ खुलीम आमू टोलू वोलीत ओता, तिहीं जाअखीलाहा दिवा पेटाअताते. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />आन युतुखूस नावोअ एक जुवान खिड़कीपोअ बोठ-बोठू उंगाअया कोअतुतो. जेहेलाम पौलुस हांहतुहू जाआं गोठी कोअतू रोयू, तेहेलाम तो निंदेवाअहीं तिसरी तालीप रोत निसे टुटीत पोड़्यू, आन तियाहा मोल्यूज विसीत लेत गोये. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />पोन पौलुस उतरीत कोइत तियाहा गलाअरी सोपटीत लेदोन कोयो, “बिहा मा; काहाके याअ जिव याजमेहें होय.” <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />आन उसे जात कोइत रोटू मुड्यू आन खात कोइत एतुहू हांहतुहू जाआं तियांअरी गोठी मिकतू रोयू के हुजीत गोयो. ताहरुउ तो जातू रोयू. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />आन ते तिया जुवानोहो जिवतुज कोअ लेताया आन तियांहां जुदू होक जोड़्यू.<verse eid="ACT 20:12" /></para>
  <para style="s">त्रोआसोम रोत मिलेतुस जाआं</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />आमू पेलुज जाहाजीम बोहीत कोइत या विसारोवाअहीं आगाड़ी अस्सुसोहो आवता रोया के तिहीं रोत आमू पौलुसोहो बोहाड़ीत लेंव, काहाके तिये ओं याअकाजे ठरव्योतो के तो सोताहा पागेज जानारु ओतू. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />जेहेलाम तो अस्सुसोम आमुहूं मिल्यू ताहां आमू तियाहा बोहाड़ीत कोइत मितुलेनेमेहें आया. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />तिहीं रोत जाहाज सोड़ीत कोइत आमू बिहीरे दिही खियुसोअ सामने पोता, आन आगल्येए दिही सामुसोमेहें आवित पोता; फाशाअ बिहीरे दिही मिलेतुसोमेहें आया. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />काहाके पौलुसे इफिसोअ आहने रोत जाअलाअ ठरव्योतो काहाके तियाहा आसियामेहें जाअखी वेल ने रुकाइलोअ ओतो; तिहींज वाअहीं तो तावणीम ओतू काहाके जर ओत सेके ते तो पेन्टिकास्टोअ दिही येरुसालेमोमेहें रोत सेके.<verse eid="ACT 20:16" /></para>
  <para style="s">इफिसोअ डायहांहां पौलुसोअ बाशण</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />पौलुसे मिलेतुस रोत इफिसोमेहें कोत मोकल्यो, आन मंडड़ीइ डायहांहां हादाड़्या. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />जाहां ते तियाआ जागे आया, ताहां तियांहां कोयो: “तुमुहूं मुंदू होय के आसियाम आवयुहू तेदर्‍युउ आंय तुमाअरी आखा दिही केहें कोइत रोयू. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />मोन्ज्ये पुरी नम्रता वाअहीं, आन रोज्ये पाड़ी-पाडीइ, तियीं परिक्शामेहें जे यहुदीइ कदरे वाअहीं मापोअ आवयी, तेबी आंय प्रभुउ सेवा कोअतूज रोयू; <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />आन जे जे गोठी तुमाआं फायदाअ ओती, तियीहीं कोतापीइलाअ आन माअहोंअ सामने आन कोओं कोओं सिकाड़ीलोअ मी केदिहीं आलहाय ने कोअयी. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />पोन यहुदीइ आन बिगर यहुदीइ सामने साक्शी आपतू रोयू के पाप सोड़ीत देवोअहें मोन फिरावुहूं जोवे आन आपाअ प्रभु ईसु ख्रिस्तापोअ विश्वास कोअहूं जोवे. <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />ओमे पाला, आंय आत्मामेहें बांदाअलूज येरुसालेमोमेहें जाहो, आन माहूं ने मुंदू के तिहीं माअरी की की ओवे; <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />निस्त ओं के पवित्र आत्मा हारेक गांवोंमेहें साक्शी आपी आपीइ माहूं ओं कोहे के जेल आन तारास ताआ वाट जोवतेहे. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />पोन आंय माआं जिवोह किज नाहां समजीइतू के यापोअ मेर कोओ, पोन ओं के आंय माआं काम आन ते सेवा पुरी कोअहूं जोवे, जे सेवा देवोअ मेरवानीइं हाजी बातमी पोअ साक्शी आपीइलाअ काजे प्रभु ईसु माहूं आप्यीही.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />“ओमे पाला, माहूं मुंदू होय के तुमू आखा जियांमेहें आंय देवोअ राज्याआ परसार कोअतू फिर्‍यू, ओमे रोत माहूं फाशाआ ने देखहामें. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />तियाहा काजे आंय आज्युउ दिही तुमुहूं साक्शी आपी आपीइ कोहो, के आंय आखाआ रक्ताप रोत निर्दुस होंव. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />काहाके देवोअ पुरु उद्देश कोतापीइलाअ काजे मी आलहाय नाहां कोअयी. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />तियाहा काजे सोताआ आन मेडाआ गोवाराआ कालजी ल्या, जो पवित्र आत्मे तुमाआं आथम होप्युहू, के तुमू देवोअ मंडड़ीइ राखवाली कोअहूं जोवे, जियीही तिये तियाआ बेटाह्हाअ रक्ता वाअहीं वेसाती लेदीही. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />माहूं मुंदू होय के माआं जाअलाअ फासाड़ी वेतीरनारे कोलवे तुमामेहें आवे जें मेडाआं गोवाराहा ने सोडे. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />तुमाआंज विसमेहें रोत एहेले-एहेले माअहें आवे, जें सेलाहां तियांआं फासाड़ी वालीइलाअ काजे वाकड़ी तिकड़ी गोठी कोत देखाड़े. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />तियाहा काजे जागते रोवा, आन ओर कोआ के आंय तीन वोरह्ये जाआं रात दिही रोज्ये पाड़ी पाडीइ हारेक जोओंहों जाबालालित रोयतेहें कोअलाअ ने सोड्ये.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />“आन ओमे आंय तुमुहूं देवोअ आन तियाआ मेरवानीइं वसनोअ ताबाम होपी देहो; जों तुमुहूं पान्गाड़ीत सेकेहे आन आखा निवड़ीइल्या माअहूंमेहें सामिल कोइत आशिर्वाद आपीत सेकेहे. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />मी कोडाअ सांदी, होनो नेत साअकाआ लालस ने कोअयी. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />तुमुहूं मुंदू होय के यांज आथोवाअहीं माआं आन माआं जोड़ीदारोंअ गरज पुरी ओवी. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />आंय तुमुहूं आखो कोइत देखाड़ी देदोहो के यी पद्धती वाअहीं मेहेंनत कोअता जात लुलाहां मदत कोअहूं जोवे आन प्रभु ईसुउ वसन ओर मिकुहूं जोवे जो तिये सोताहाज कोयोहो: ‘मागीइला रोत आपिइलाम जाअखी खुसी रोत्ली.’”<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />ओं कोत कोइत तो मांड्या पोड़्यू आन तियां आखाअरी मिलीत प्रार्थना कोअयी. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />ताहां तें आखे खुब रोड्ये आन पौलुसोअ गले लागीत कोइत तियाहा गुउं देने वोल्ये. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />तें खास कोइत यी गोठी वाअहीं दुखी ओते काहाके तिये कोयीते के तुमू माहूं फाशेए ने देखहामें. ताहराअ तियां तियाहा जाहाजेए जागे जाआं पोताड्यू.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">पौलुसोअ येरुसालेमोमेहें जाअलोअ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />आमू तिहीं रोत जाताहामे कोत जाहाजेम बोठा आन पाद्राज कोस बेटोपोअ आवित पोता, आन बिहीरे दिही रुदुसोमेहें आन तिहीं रोत पतरा होयरोम आया. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />तिहीं एक फिनीके जानारी जाहाज मिल्यी, आन आमू तियी जाहाजेम बोहीत कोइत आगाड़ी निहीया. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />जेहेलाम आमुहूं सायपरस बेट देखाअ वोल्यो, ताहां आमू तियाहा बांगाड्यीइ वोल टाकी देत सिरिया जात कोइत सुरोमेहें उतर्‍या; काहाके तिहीं जाहाजेमेर्‍युउ माल उतारीलुउ ओतू. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />सेलाहां मिलीत कोइत आमू तिहीं हांत दिही जाआं रोया. तियां आत्माआं सिकाड़ल्या वाअहीं पौलुसोह कोयो के येरुसालेमोमेहें पाग मा मिक्ही. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />जाहां ते दिही पुरा ओत गोया, ताहां आमू तिहीं रोत जाना वोल्या; आन आक्खे बोईंन पोर्‍ये आमुहूं गावोंअ बारथे जाआं मिके आये; आन आमू दोर्‍याआ मेरेपोअ मांड्या पोड़ीत कोइत प्रार्थना कोअयी, <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />तिहीं रोत आमू एकानेकाहा जाजाम कोत कोइत वेराअया, आमू ते जाहाजेम बोठा पोन तें जिवज्योअ कोओअहें वोलीत गोये.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />ताहराआ आमू सुरोम् रोत जाहाजेम बोहीत् कोइत पतुलिमायिसोम पोत्या, आन विश्वासी पायहोंहों मिल्यान् ताहराआ तियांअरी एक दिही रोया. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />बिहीरे दिही आमू तिहीं रोत निहीत कोइत केसरियामेहें आया, आन हाजी बातमी परसार् कोअनारा फिलीप्पअ कोअमेहें जो हांत जोओं मेर्‍युउ एक ओतू; जात कोइत तियाअहीं रोया. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />तियाआ शार कुवांरी पोर्‍यी ओती, जे भविश्यवाणी कोअतीते. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />जेहेलाम आमू तिहीं वारुज दिही रोत सुका, ताहां अगबुस<note caller="+" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="ACT 11:28">प्रेशित 11:28</ref></char></note> नावोअ एक भविश्यवक्तू यहुदीया रोत आयू. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />तिये आमाआं जागे आवित कोइत पौलुसोअ पोट्टू माग्यू, आन सोताआ आथेन गुडा बांदीत कोइत कोयो, “पवित्र आत्मा एहें कोहे के, ओ पोटटू जिया माहुंउं होय, तियाहा येरुसालेमोमेहें यहुदी एहेंज कोइत बांदे, आन बिगर यहुदीइ आथम होपी देये.”<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />“जेहेलाम आमू ए गोठी उनाअया, ताहां आमू आन तिहींइं माअहें नेहें तियाहा विनंती कोअयी के येरुसालेमोमेहें मा जाही. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />पोन पौलुसे उत्तर आप्यो, ओं तुमू की कोअतेहे, एहें कोइत रोड़ी-रोड़ीइ तुमू माआं दिल तोड़तेहे? आंय ते प्रभु ईसुउ नावोअ काजे येरुसालेमोम निस्तू बांदाइलाआ काजे एतुज नाहां, पोन मोइलाअ काजे बी तियार होंव.”<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />जाहां तो ने मान्यू ताहां आमू एहें कोत कोइत ठावका ओत गोया, “प्रभुउ इश्शा पुरी ओवे.”<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />यां दिहोअ फासाड़ी आमू तियारी कोअयी आन येरुसालेमोमेहें जाना वोल्या. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />केसरियामेर्‍याआ बी थोड़ाक सेला आमाअरी आवा वोल्या, आन सायपरस वाला मनासोन नावोअ एका जुना सेलाअहीं रोय तेहें काजे ते आमुहूं लेताया.<verse eid="ACT 21:16" /></para>
  <para style="s">पौलुस याकोबोह मिलत्लू</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />जेहेलाम आमू येरुसालेमोम पोत्या, ताहां विश्वासी पाही खुसी वाअहीं आमुहूं मिल्या. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />बिहीरे दिही पौलुस आमुहूं लेत कोइत याकोबोअ जागे गोयू, जिहीं आखा डायहां टोलू वोलीत रोयाते. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />ताहां तिये तियांहां सलाम कोइत, जे जे कामे देवे तियाआ सेवकायी वाअहीं बिगर यहुदीमेहें कोअयेते, एक एक कोइत आक्खे कोताप्ये. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />तियां ओं उनाइत कोइत देवोअ महिमा कोअयी, आन तियाहा कोयो, “पाही, तू देखीत सेकेहे के यहुदी मेर्‍येए केताहा हाजार माअहूं विश्वास कोअयुहू; आन आखे मोशेए कायदाआ धुंदीमेहें होये. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />तियांहां ताआ बाप्तिम् एहेलोह सिकाड़्यह के तू बिगर यहुदीमेहें रोनारा यहुदीही मोशेए कायदाप रोत वोलीत जायतेहें सिकाड़ेहे, आन कोहे, के तुमाआं पोर्‍याआ खतना मा कोअहा आन रिती रिवाजपोअ मा सालहा. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />ताहरोअ की कोअहूं जोवे? माअहें नक्की होम्बिलनारे के तू आयुहू. <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />तियाहा काजे जो आमू ताहूं कोताहा, तों कोअ. आमाआं जागे शार माटी होय जियां पालनी तोअयिही. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />तियांहां लेत कोइत तियांअरी सोताहा सोकु ओव्; आन तियांआं काजे खर्स आप् के ते सिंग्ये कात्रावे. ताहां आखे जाईंत लेय के जे गोठी तियांहां ताआ बाप्तिमेहें कोयीही, ते वाहीं बी खरी कायनाहां पोन तू सोताहा बी कायदाहा मानित कोइत तियाआ पुरमाणे सालेहे. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />पोन तियां बिगर यहुदीइ बाप्तिमेहें जियां विश्वास कोअयुहू, आमू ओ निर्णय कोइत लेखीत मोकल्योहो के तें मुर्तीइ सामने गाराहा कोअल्यो माहां, रक्त, गलु टिबलीत माअल्या जनवारोअ माहां आन सिनालो यां रोत सेटे रोअहूं जोवे.<note caller="+" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ACT 15:29">प्रेशित 15:29</ref> </char></note>”<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />ताहरुउ पौलुस तियां माट्योहों आरी लेत कोइत, आन बिहीरे दिही तियांअरी सोकु ओत कोइत मंदिरोम गोयू, आन सोको ओवीइलाआ दिही, मोन्ज्ये तियांमेर्‍याआ हारेकोअ काजे गाराहा आपीइलोअ दिही कोयों पुरा ओवे तो तिहीं कोत देदो.<verse eid="ACT 21:26" /></para>
  <para style="s">पौलुस मंदिरोमेहें तोआयू</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />जाहां हांत दिही पुरा ओवुहूं कोअताते, ताहराआ आसियावाला यहुदी माट्यों पौलुसोहो मंदिरोमेहें देखीत कोइत आखा माहुंहूं पोड़काये, आन एक्काइज आअड़ीत कोइत तियाहा तोइत लेदू. <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />“ए इस्राएलवाला, मदत कोआ; ओ तोज माटी होय, जो आपाआ माहुंउं, कायदाआ, आन या जागाआ विरुद्दाम आखी जागे माहुंहूं सिकाड़ेहे, तेतोज नाहां पोन ये युनानी माहुंहूं बी मंदिरोमेहें लेतावीत कोइत या सोका जागाहा एठु कोअयुहू.” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />याआ रोत पेल तियां इफिसवाला त्रुफिमुसोह तियाअरी गावोंमेहें देख्युतो,<note caller="+" style="x"><char style="xo" closed="false">21:29 </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेशित 20:4</ref> </char></note> आन समज्याते के पौलुस तियाहा मंदिरोमेहें लेतायुहू.<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />ताहरोअ पुरा गावोंमेहें दोंगू मातीत गोयू, आन माहें गुगदीइतेज टोलू वोल्ये आन पौलुसोहो तोइत कोइत मंदिरोअ बारथे ओढ़ीत लेताये, आन ताब्बुड़ बाअणे वालीत देदे. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />जेहेलाम ते तियाहा माइत टाकीइलाअ कोअतेते, ताहरुउ रोमी सेयनिकोअ मुख्याहा खबर पोती के पुरा येरुसालेमोमेहें दोंगू ओवेहे. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />ताहरुउ तो ताबुड़ सेयनिकोहों आन आधिकारीही लेत कोइत तियांआं जागे निसे गुगदीत आयू; आन तियां रोमी सेयनिकोअ मुख्याहा आन सेयनिकोहों देखीत कोइत पौलुसोहो मार देएलाआ सोड़ी देदो. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />ताहरुउ रोमी सेयनिकोअ आधिकारी आहने आवित कोइत तियाहा तोइत लेदू; आन बेन हाकले वाअहीं बांदीइलाआ आदेश आपीत कोइत फुसू वोल्यू, “ओं कोडो होय आन ये की गुनू कोअयुहू?” <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />पोन गर्दीमेहें रोत एखु की कोय बिहीरो की कोय आअड़ीते रोये. जाहां गर्दी वाअहीं तो खोरी गोठ जाइंत ने सेकू, ताहां तियाहा किल्लामेहें लेत जाअलाअ आदेश आप्यू. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />जेहेलाम तो पायत्रीइ जागे पोत्यु, ताहां एहेलोहो ओवो के गर्दीइ दाबावोवाअहीं सेयनिकोहों तियाहा उसलीत लेत जाअहूं पोड़्य. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />काहाके माअहुंउं गर्दी ओं आअड़ीइतीज तियाआ फासाड़ी आवतीते, “याहा माइत टाकी द्या.”<verse eid="ACT 21:36" /></para>
  <para style="s">पौलुस वासाइत जात्लु</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />जेहेलाम ते पौलुसोह किल्लामेहें लेत जाअहूं ओता, तेहेलाम तिये रोमी सेयनिकोअ मुख्याहा कोयो, “आंय ताअरी गोठी मिकीत सेकोह के?” तिये कोयो, “ताहूं ग्रीक बाशा आवड़ेहे के? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />केहें तू तो मिसरवालू ते नाहां, जो यां थोड़ाक दिहोअ पेल लबाड़ी कोइत शार हाजार दहशतवादी माहुंहूं जंगलोमेहें लेत गोयू?”<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />पौलुसे उत्तर आप्यो, “आंय ताम तारसुसवालू यहुदी माटी होये! किलिकियाआ नावासी होयरोअ रेवासी होय. आंय ताहूं विनंती कोअहो के माहूं यां माअहोंअरी गोठी कोअहूं दे.”<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />जाहां तिये परवानगी आप्यी, ताहां पौलुसे पायत्री पोअ उबू रोत कोइत माहुंहूं आथोवाअहीं इशारु कोअयू. जेहेलाम तें ठावके ओत गोये, ताहां तो इब्री बाशामेहें गोगु वोल्यू:<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />“माआं यहुदी पायहों, जों आंय ओमे तुमाआं सामने कोतापोहो तों माआं उत्तर उनाआ!” <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />तियाहा तियांअरी इब्री बाशामेहें गोगत्लू उनाइत तें जाअखेज ठावके ओत गोये, ताहां पौलुसे कोयो:<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />“आंय ताम यहुदी माटी होय, जो किलिकियाआ तारसुसोमेहें उबज्यु; पोन या होयरोम गमालिएल गुराआ जागे बोहीत सिकाअयु, आन वेगाआ डायहांआं कायदाआ खरी रितीवाअहीं सिकाअयु; आन देवोअ काजे एहेलिही धुंद ओती, जेहलीही धुंद आज तुमू आखा होय. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />आंय या पंथाआ माहुंहूं एतुहू तारास देदू के तियांहां माआड़ीत बी देदे. आंय माट्योहोंन बोईंहीं बांदी-बांदीइ जेलेमेहें टाकी देदे. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />यी गोठीइ काजे डाया पुंजारकां आन पुरु पोन्सू बी साक्शी होय, के माहूं तियांप रोत दमिश्कवालां यहुद्याहां लेखल्यो आदेश पत्र जोड़्यो, ताहां आंय तों लेत कोइत तिहींइं विश्वासी माहुंहूं बी बांदीत कोइत येरुसालेमोम लेतावीइलोअ काजे आन तियांहां डोंड आपाड़ीलाआ काजे दमिश्कमेहें वाट लागुतो.<note caller="+" style="x"><char style="xo" closed="false">22:5 </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेशित 8:3</ref>; <ref loc="ACT 26:9-11">26:9-11</ref> </char></note><verse eid="ACT 22:5" /></para>
  <para style="s">पौलुसोअ जिवनोम बदल</para>
  <para style="r">(<ref loc="ACT 9:1-19">प्रेशित 9:1-19</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />“जेहेलाम आंय साली-सालीइ दमिश्क होयरोअ आहने पोतू, ताहां एहेलोहो ओवो के एक आंदास माजन दिहेए वेले एक्काइज एक वोडी उजेड़ जुगोम रोत माआं शारु मेरे सोमक्यी. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />आन आंय पुयींपोअ ओदरीत पोड़्यु आन ओ आवाज उनाअयू, ‘शाऊल, शाऊल, तू माहूं काहा तारास देहे?’ <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />आंय उत्तर आप्यो, ‘प्रभु, तू कोडू होय?’ तिये माहूं कोयो, ‘आंय ईसु नासरी होय, जियाहा तू तारास देहे.’ <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />माआ जोड़ीदारहों उजेड़ ते देख्यू, पोन जो माअरी गोगतुतो तियाआ आवाज ने उनाअया. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />ताहां आंय कोयो, ‘ए प्रभु, आंय की कोअ?’ प्रभु माहूं कोयो, ‘उठीत कोइत दमिश्कोम जा, आन जों किबी देवे ताआ काजे ठरव्योहो तों ताहूं कोइलोअ आवे.’ <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />जाहां तिया उजाला वाअहीं आंय आंद्लू ओत गोयू, ताहां आंय माआ जोड़ीदारोंअ आथ तोइत कोइत दमिश्कमेहें आयू.<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />“ताहरुउ हनन्या नावोअ कायदाआ पुरमाणे सालनारु एक भगत माटी ओतू, तियाआ तिहीं रोनारा आखा यहुद्यामेहें जाअखु मानपान ओतू. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />तो माआं जागे आयू, आन उबू रोत कोइत माहूं कोयो, ‘ए पाही शाऊल, फाशुउ पालु वोल!’ तेताजमेहें माहूं देखाओ वोल्यो आन आंय तियाअहें पाल्य. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />ताहां तिये कोयो, ‘आपाआ वेगाआ डायहांआं देवे ताहूं तियाआ इश्शा ओलखे तेहें, आन तियाआ धर्मी सेवकोहो पाले तेहें आन तियाआ कोल्यी गोठी उनाय तेहें काजे निवड़्युहू. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />मोन्ज्ये जे गोठी तुमे देख्यीही आन उनाअयुहू ते आखा माअहुंउं सामने कोत कोइत तू तियाआ तियीं साक्शी बोणीत सेकही. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />आन ओमे काहा वाआ लागाड़ेहे? उठ, तियाआ नावोम बाप्तिस्मा ले, आन तियाहा प्रार्थना कोअ आन ताआ पाप तुवीत ले.’<verse eid="ACT 22:16" /></para>
  <para style="s">बिगर यहुदीमेहें पौलुसोअ परसार</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />“जेहेलाम आंय फाशुउ येरुसालेमोम आवित कोइत मंदिरोम प्रार्थना कोअया कोअतुतो, तेहेलाम आंय दर्शन देख्यो. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />आन तिहींमेहें प्रभु देखाअयू, जो माहूं कोहे, ‘तावणी कोइत येरुसालेमोम रोत वेगु निहीत जा; काहाके तें माआं बाप्तिमेहें ताआ साक्शी ने माने.’ <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />ताहां मी कोयो, ‘प्रभु, ते तोम सोताहा जांअताहा के आंय तापोअ विश्वास कोअनाराहां जेलेमेहें टाकतुतो आन गावों-गावों आराधनालयोमेहें मार देवाड़तुतो. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />जेहेलाम ताआ साक्शीदार स्तिफनोहों माअताते, तेहेलाम आंय बी तिहीं उबू रोत रोयुतो आन यी गोठीम पेलाअयुतो, आन तियाहा माअनाराआ आंगड़े सांबालतुतो.’ <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />तेहेलाम प्रभु माहूं कोयो, ‘जातुरो: काहाके आंय ताहूं बिगर यहुदीइ जागे दूर-दूर मोकलिहीं.’”<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />माहें तियाआ एती गोठ जाआं उनाइत रोयेन, ताहरेए खुब जोरे आअड़्ये, “एहेला माहुंहूं का माईंत टाका! याआ जिवता रोअलाअ लायकी कायनाहां!” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />जेहेलाम तें माहें आअड़ीते जात आंगड़े काडीत गुंउंवीइते आन जुगोमेहें तुलो ऊडाड़तेते; <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />ताहरुउ रोमी सेयनिकोअ अधिकाऱ्ये कोयो, “याहा किल्लाम लेत जावा, आन फोमहूं सापका देत कोइत कोबलावा. ताहां एं यहुदी माहें की गोठी वाअहीं याआ विरुद्दामेहें एहेलेहे आअड़ीइतेहें तों माहूं बी समजाय.” <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />जाहां तियां पौलुसोहो सांबड़ाआ दोअड़ा वाअहीं बांद्यु, ताहां तिये तिहीं आहने उबु ओतू तिया आधिकाऱ्योहो कोयो, “तुमू एका रोमनवाला माट्योहो, आन तोबी विण सुकीज, सापका देएलो ओं कायदाअ पुरमाणे ठीक होय के?”<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />ओं उनाइत कोइत आधिकार्‍ये रोमन सेयनिकोअ मुख्याआ जागे जात कोइत कोयो, “तू ओं की कोअहे? ओ ते रोमी माटी होय.”<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />ताहां रोमन सेयनिकोअ मुख्ये तियाआ जागे आवित कोइत कोयो, “माहूं को, तू रोमनवालू होय?” तिये कोयो, “होव.”<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />ओं उनाइत कोइत रोमी सेयनिकोअ फुद्दारे कोयो, “जाअखीलाहा पोशा आप्या ताहां जात माहूं रोमन बोणिइलोअ पद जोड़्योहो.” पोन पौलुस कोयो, “आंय ताम जल्मार्‍युज रोमनवालू होय.”<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />ताहां जें माअहें तियाआ सौकीशी कोअनारे ओते, तें ताब्बुड़ तियाआ जागे रोत सेटे होरकीत गोये; आन रोमन सेयनिकोअ फुद्दार बी ओ रोमनवालू होये आन आंय याहा बांद्युहू, एहेलोह जाइंत कोइत तोबी बित गोयू.<verse eid="ACT 22:29" /></para>
  <para style="s">महासभाआ सामने पौलुस</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />यहुदी माहें पौलुसोपोअ किहाआ आरोप लागाड़तेहे तों वारुहूं जाइंलाआ इश्शा वाअहीं रोमन सेयनिकोअ फुद्दारे बिहीरे दिही तियाआ बेड़ी सोड़ी देदी; मुख्य पुंजारा आन पुरी महासभाहा टोलू वोले तेहें आदेश आप्यू, आन ताहरुउ पौलुसोहो निसे लेत जात कोइत तियांआं सामने उबू कोइ देदू.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />पौलुसे महासभाअहें एक सारकी नजरेवाअहीं पाल्यो आन कोयो, “माआं इस्राएली पायहों, आंय आज जाआं देवोअ काजे बिलकुल खोरा विसारोवाअहीं जिवन जिवतु रोयुहू.” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />डाये पुंजारके हनन्ये तिहीं जागेज उबा रोत रोयाते तियांहां पौलुसोअ कानसावणाम थापुड़ देयतेहें आदेश आप्यू. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />तांहा पौलुसे तियाहा कोयो, “ए सुनो हारल्या पितड़ा,<note caller="+" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="MAT 23:27">मत्तय 23:27</ref>,<ref loc="MAT 23:28">28</ref> </char></note> देव ताहूं देय. तू कायदाआ पुरमाणे माआ न्याय कोऊ बोठुहू, तेबी फाशुउ कायदाआ विरुद्दाम माहूं देएलाआ आदेश आपेहे!”<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />जे पौलुसोअ आहने उबा रोयाते तियां कोयो, “केहें तू देवोअ पुंजाराहा गाइ देत्लू के?”<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />पौलुसे कोयो, “ए पायहों, माहूं ने मुंदू ओतू के ओ डायु पुंजारु होय; काहाके लेख्योहो: ‘तुमाआं पुढार्‍योअ विरुद्दाम तू बाक्ती गोठी मा कोही.’”<note caller="+" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="EXO 22:28">निर्ग 22:28</ref> </char></note><verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />फाशुउ पौलुस ओं ओलखीत कोइत के एक भाग सादूकीइ आन एक भाग फरिसीइ होय, सभामेहें आअड़ीत कोइत कोयो, “पायहों, आंय फरिसी आन फरिसीइ घराणाआ माटी होय.<note caller="+" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="ACT 26:5">प्रेशित 26:5</ref>; <ref loc="PHP 3:5">फिलि 3:5</ref> </char></note> मोल्याआं आशा आन फाशोअ जिवीत उठीइलाआ बाप्तिम इंहीं माआं सौकीशी ओवेहे.”<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />जाहां तिये ए गोठ कोयी ताहां फरिसी आन सादूकीमेहें भान्गड़ी ओनी वोल्यी; आन सभामेहें बेन भाग पोड़ीत गोया. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />काहाके सादूकी माअहें ते ओं कोतेहे, के नाहां फाशोअ जिवीत उठीइलो, नाहां देवदुत आन नाहां आत्मा;<note caller="+" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="MAT 22:23">मत्तय 22:23</ref>; <ref loc="MRK 12:18">मार्क 12:18</ref>; <ref loc="LUK 20:27">लुक 20:27</ref> </char></note> पोन फरिसी ओं आखो मानतेहे. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />ताहां वोडु तुदड़ू उठ्यू आन थोड़ाक फरिसीइ वोगर्‍याआ कायदाआ मास्तर ओता ते, उठीत उबा रोया आन एहें कोत कोइत सुलाआ वोल्या, “आमुहूं या माट्योमेहें किज सुक नाहां देखाअती, आन जर एखु आत्मा नेत देवदुत तियाअरी गोग्युय ताहां किमें?”<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />जाहां जाअखीज भान्गड़ मातीत गोयी, ताहां तें पौलुसोअ तुकड़ा-हुकड़ा ने कोइ देय तो रोमी सेयनिकोअ मुख्यू बियू, आन उतरीत कोइत तियाहा तियांआं विसमेहें रोत जबरजस्ती काडीत किल्लाम लेत जाय तेहें सेयनिकोहो आदेश आप्यू.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />तियीज राती प्रभु पौलुसोअ आहने उबू रोत कोइत कोयो, “तू धिर खेट; काहाके जेहलीही तुमे येरुसालेमोमेहें माआं साक्शी आप्यी, तेहेंज कोइत ताहूं रोमोमेहें बी साक्शी आपुहूं पोड़े.”<verse eid="ACT 23:11" /></para>
  <para style="s">पौलुसोहो माईंलाआ कदर</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />जाहां दिही उगु ताहां यहुदी एक गोठ कोइते आन शप्पत खादी के जाअहूं जाआं आमू पौलुसोहो ने माईंत टाको, ताअहूं जाआं रोटा-पाअयोंहों आमू आथ ने लागाड़नारा. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />जियां ए शप्पत खादीते, ते सालिही जोओं रोत वादार ओता. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />तियां मुख्य पुंजारा आन डायहांआं जागे जात कोइत कोयो, “आमू पौलुसोहो माईंत ने टाको ताअहूं जाआं रोटा-पाअयोंहों आथ ने लागाड़नारा कोत शप्पत खादीही. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />ताहां ओमे महासभाअरी रोमी सेयनिकोअ मुख्याहा सोमजाड़ा के ते तियाहा तुमाआं जागे लेतावे, आन एहेलोह कोवड़ावजा के तुमू तियाआ बाप्तिमेहें फाशीइ बी वारुहूं सौकीशी कोअनाराहा; पोन आमू तियाहा पोतीइलाआ पेलुज माईंत टाकीइलाअ काजे तियार रोहूं.”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />ते तियाहा माअनारा होय एहेलोह पौलुसोअ पांअजुह्हू उनाअयू, ताहरुउ तो किल्लामेहें जात कोइत पौलुसोहो खबर आप्यी. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />पौलुसे आधिकाऱ्योमेर्‍याआ एका जोओंहों तियाआ जागे हादीत कोइत कोयो, “या जुवानोहों रोमी सेयनिकोअ मुख्याआ जागे लेत जा, ओ तियाहा किवानीइ तेबी कोनारु होय.” <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />ताहरोअ तिये तियाहा रोमी सेयनिकोअ मुख्याआ जागे लेत जात कोयो, “जेलेमेर्‍युउ पौलुस माहूं हादीत कोइत विनंती कोअयी के ओ जुवान रोमी सेयनिकोअ मुख्याहा किवानीइ तेबी कोनारु होय; याहा तियाआ जागे लेत जावा.”<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />रोमी सेयनिकोअ मुख्ये तियाहा आथेज तोइत आंगेज लेत जात फुशो, “तू माहूं की कोनारु ओतुतो को?”<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />तिये कोयो, “पौलुसोहो तियाआ बाप्तिम वारुहूं सौकीशी कोइलो होय, एहें कोवड़ावित यहुदी आधिकार्‍यों हांदाआ पौलुसोहो महासभामेहें लेतावे तेहें कोत ताहूं विनंती कोइलोअ मान्य कोअयोहो. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />पोन तियांआं मा मानही, काहाके तियांमेर्‍येआ सालिही रोत वादार जोंओं होय जे तियाहा माईलाआ फाट लागाहा. तियां ओं ठरवीत लेदोहो के जाअहूं जाआं पौलुसोहो ने माएं, ताअहूं जाआं रोटू नेन पाईं ने पिनारा.”<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />ताहां रोमी सेयनिकोअ मुख्ये तिया जुवानोहो ए गोठ कोत मोकल्यी, “कोडाहाज मा कोही के तुमे माहूं ए गोठ कोयीही.”<verse eid="ACT 23:22" /></para>
  <para style="s">पौलुसोहो फेलिक्स राज्यपालोअ जागे मोकलीइलोअ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />ताहरुउ सेयनिकोअ मुख्ये बेन आधिकाऱ्योहों हादीत कोइत कोयो, “बेन होव सेयनिक, सत्तर कोड़ापोअ बोहनारा सेयनिक, आन बेन होव डाफावाला सेयनिक, आज राती नोव वाजे तेहेलाम केसरियाहा जाअलाआ काजे तियार कोइत मिका. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />आन पौलुसोहो राज्यपाल फेलिक्सोअ जागे होकेहे पोताड़ीत सेके तेहें कोड़ा तियार मिका.” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />तिये एहें कोइत सिट्टी बी लेख्यी:<verse eid="ACT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26" />“माननीय फेलिक्स राज्यपालोहो क्लौदियुस लूसियासोअ सलाम. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />या माट्योहो यहुदी आधिकार्‍यों तोइत माईंत टाकीइलाआ कोअल्यो, पोन माहूं मुंदू गोयू के ओ रोमनवालू होये, ताहां सेयनिक लेत जात कोइत मी याहा टाकाड़्यू. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />ते तियापोअ की गोठी वाअहीं आरोप लागाड़ताहा तो माहूं जाइंत लेअलोअ ओत्लो तियाहा काजे आंय तियाहा तियांआं महासभामेहें लेत गोयू. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />तेहेलाम माहूं एहेलुहू मुंदू गोयू के माईंत टाकीइलाअ नेत बांदीइलाआ जोगीही तियामेहें किज सुक कायनाहां. पोन तियापोर्‍युउ तियांआं आरोप तियांआं कायदाआ प्रश्नाआं बाप्तिम ओतू. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />तियाहा माईलाअ फाट लागेहे कोत माआं कानोपोअ पोड़्यो, ताहां आंय लगेज तियाहा ताआ जागे मोकली देदू; आन आरोप लागाड़नाराहां बी आदेश आप्यू के ते ताआं सामने तियापोअ आरोप लागाड़े.”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />जेहलुहू सेयनिकोहो आदेश जोड़्युतो, तेहेंज कोइत ते पौलुसोहो लेत कोइत राताम-रात अन्तिपत्रिसोमेहें आया. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />बिहीरे दिहे ते कोड़ापोअ बोहनाराहां तियाअरी जायतेहें काजे सोड़ीत कोइत ते किल्लाम वापिस वोल्या. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />तियां केसरियाम पोतीत कोइत राज्यपालोहो सिट्टी आप्यी; आन पौलुसोहो बी तियाआ सामने उबू कोअयू. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />राज्यपाल सिट्टी वासीत कोइत फुशो, “ओ कोड्ला इलाखाआ होय?” आन किलिकियाआ होय कोत मुंदू पोड़्यू. <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />ताहां तिये कोयो, “जाहां तापोअ आरोप लागाड़नारे बी आवे, ताहां आंय ताआ की होय तो पालिहीं.” आन तिये हेरोदोअ किल्लामेहें तियाआ राखवाली कोइत मिके तेहें आदेश आप्यू.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">पौलुसोअ विरुद्दाम केस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />पास दिहोअ फासाड़ी डायु पुंजारु हनन्या थोड़ाक डायहां आन तिरतुल्लुस नावोअ एका वकीलोहो आरी लेत कोइत आयू. तियां फेलिक्सोअ सामने पौलुसोअ विरुद्दाम आरोप लागाड़्यु.<verse eid="ACT 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 24:2" />जाहां पौलुसोहो हाद्यु ताहां तिरतुल्लुस तियापोअ आरोप लागाड़ीत कोनु वोल्यू: “माननीय फेलिक्स, तावाअहीं आमुहूं खुब होक जोड़्युहू; आन ताआ पुढारपणो वाअहीं या देशोम वारुज हाजी गोठी हुदरीइतीही. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />आमू यी गोठीइ बादी जागे आन आखु वारी स्वागत कोअताहा. आन आमू खुल्ला मोनोवाअहीं आभार मानताहा. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />ताआ वादार वेल माहूं नाहां लेंव लागतो, पोन आंय ताहूं रावणी कोअहो के मेरवानी कोइत आमाआं बेनेक गोठी उनाइत ले. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />काहाके आमुहूं ओ माटी अड़सन टाकत्लू आन दुन्याआं आखा यहुदीमेहें दोंगू माताड़नारु देखाअत्लू, आन ओ नासरीइ पन्थाआ पुडारी होय. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />ये मंदिरोहो एठो कोइलोअ कोशित कोअयी, पोन ताअहूं आमू याहा तोइत लेदू.<note caller="+" style="f"><char style="fr" closed="false">24:6 </char><char style="ft" closed="false">थोड़हा लेख्यामेहें जोड़ेहे के, “आमू याहा आमाआं कायदाआ पुरमाणे डोंड आपनारा ओता.”</char></note> <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />पोन रोमी सेयनिकोअ मुख्यू लुसियासे याहा उदाबादीज आमाआं आथोम रोत बुउसीत लेदू,<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="ft" closed="false">थोड़हा लेख्यामेहें ओं वसन नाहां मिलतो.</char></note> <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />आन आरोप लागाड़नाराहां ताआ सामने आविइलोअ आदेश आप्यू.<note caller="+" style="f"><char style="fr" closed="false">24:8 </char><char style="ft" closed="false">थोड़हा लेख्यामेहें ओं वसन नाहां मिलतो.</char></note> यीं आखी गोठीही जियींइ बाप्तिम आमू यापोअ आरोप लागाड़ताहा, तू सोताहाज याहा फारकीत कोइत जाइंत लेही.” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />यहुदी बी तियाआ साथ देत कोइत कोयो, ए गोठी बोराबर होये.<verse eid="ACT 24:9" /></para>
  <para style="s">फेलिक्सोअ सामने पौलुसोअ उत्तर</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />जाहां राज्यपाले पौलुसोहो गोगीइलाआ इशारु कोअयू, ताहां तिये उत्तर आप्यो, “माहूं मुंदू होय के तू खुब वोर्‍ह्योंअ रोत या देशोअ न्याय कोअहे, तियाहा काजे आंय सोताहा ताआ सामने उत्तर आपीइलोअ काजे खुस होय. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />तू सोताहा जाइंत सेकेहे के माहूं येरुसालेमोमेहें आराधना कोइलोअ काजे गोल्याहा बारा दिहो रोत उसे नाहां ओवा. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />यां यहुदी माट्यों माहूं नाहां मंदिरोमेहें के नाहां आराधनालयोमेहें, आन नाहां गावोंमेहें कोडाअरी सोबी लागत्लाहा नेत पोड़कावत्लाहा देख्यू; <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />आन नाहां ते यीं गोठीइ खोरु पुरावू आपीत सेकता, जियींइं ते ओमे मापोअ आरोप लागाड़ताहा. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />पोन आंय ताआ सामने ओं मानित लेहो के जिया पंथाहा ते खाराब पन्थ कोताहा, तियाआज रितीपोअ आंय आमाआं वेगाआ डायहांआं देवोअ सेवा कोअहो; आन जे गोठी कायदाआ आन भविश्यवक्ताआ पुस्तकोमेहें लेखल्यी होय, तियीं आखी पोअ विश्वास कोअहो. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />आन जे आशा ते सोताहा मिकताहा तेहलीही आशा आंय बी देवोपोअ मिकोहो, के जिहींम धर्मी आन पापी बेनुउं जिवीत उठीइलोअ रोय. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />तिहीं वाअहीं आंय सोताहा बी देवोअ आन माअहोंअ सामने माआं विसार सादाज निर्दुस मिकीइलाआ कोशित कोअहो.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />“वारुज वोर्‍ह्योंअ आगोदर आंय आमाआं माअहोंअ काजे थोड़ाक पोशा आन मंदिरोम गाराहा आपू येरुसालेम आयुतो.<note caller="+" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="ACT 21:17-28">प्रेशित 21:17-28</ref></char></note> <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />माहूं तियां सोकायीइ तिवार ओवू तिहीं रोत मंदिरोमेहें होदीत काड्यू, तेहें कोअताम माअरी गर्दीहाआं ने ओती आन माआं आथे कीज सुक बी ने पोड़्यी. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />पोन, आसियाआ थोड़ाक यहुदी तिहीं ओता, जर माआं विरुद्दाम तियां पोअ काविहीं गोठ ओय ताहां ते सोताहा इंहीं ताआ सामने आवित कोइत मापोअ दोश लागाड़ुहूं जोवे. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />नेत आंय महासभाआ सामने उबू ओतू, तेहेलाम तियां मामेहें कोड्लू गुनू देख्यू तो तेंव इंहींवालाहां कोत देखाड़ुहूं जोवे? <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />जे गोठ आंय तियांआं विसमेहें उबू रोत कोइत कोयीते तियी एकी गोठीही सोड़ीत: ‘मोल्याम रोत जिवीत उठीइलाआ गोठीपोअ विश्वास कोइलोअ बाप्तिमेहें आज तुमाआं सामने माआं सौकीशी ओवेहे.’”<note caller="+" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="ACT 23:6">प्रेशित 23:6</ref></char></note><verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />फेलिक्से, जियाहा या पंथाआ बोराबर मुंदू ओतू, तिये ते केस आगाड़ी ठेपलीत कोइत कोयो, “जाहां रोमी सेयनिकोअ मुख्य लूसियास आवे, ताहां तुमाआं गोठीइ निकाल लागाड़े.” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />आन तिये पौलुसोअ राखवाली आधिकाऱ्योहो आदेश आप्यू के पौलुसोहो थोड़ुक मोकलू मिकीत कोइत राखवाली कोअजा, आन तियाआ दोस्त्योंमेर्‍याआ कोडाहा बी तियाआ सेवा कोइलाआ काजे मा रुकहा.<verse eid="ACT 24:23" /></para>
  <para style="s">फेलिक्स आन द्रुसिल्लाआ आगाड़ी पौलुस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />थोड़ाक दिहोअ फासाड़ी फेलिक्स तियाआ लाडी द्रुसिल्लाहा, जे यहुदी ओती, तियीही आरी लेत कोइत आयू आन पौलुसोहो हादाड़ीत कोइत ख्रिस्त ईसु पोर्‍याआ तियाआ विश्वासोअ बाप्तिमेहें तियाप रोत उनाअयू. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />जाहां तो सतीपण, संयम, आन आवनारा न्यायनिवाड़ाआ सर्सा कोअतुतो, ताहां फेलिक्से बिय बिय उत्तर आप्यो, “ओमे तू जात सेकेहे; गालो पालीत आंय ताहूं फाशुउ हादीहीं.” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />तियाहा पौलुसोपोअ रोत वाजीहीं पोशा जोड़े कोत बी आशा ओती, तियाहा काजे फाशुउ बी हादी-हादीइ तियाअरी गोठी कोअया कोअतुतो.<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />पोन जाहां बेन वोरह्ये सेकित गोये ताहां पोरकियुस फेस्तुस, फेलिक्सोअ जागापोअ आयू; आन फेलिक्स यहुद्याहां खुश कोइलाआ इश्शा वाअहीं पौलुसोहो जेलेजमेहें सोड़ीत गोयू.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">वोडा राजाअ सामने पौलुसोअ रावणी</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />तिया मुलखोम पोतीइलाआ तीन दिहोअ फासाड़ी फेस्तुस केसरिया रोत येरुसालेम गोयू. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />ताहां डाया पुंजारा आन यहुदी पुढार्‍यों तियाआ सामने पौलुसोअ विरुद्दाम आरोप लागाड़्यु; आन तियाहा विनंती कोअयी. <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />तियां फेस्तुसोहो रावणी कोअयी के तो पौलुसोहो येरुसालेम हादाड़े, काहाके तियां पौलुसोहो वाटेज माइत टाकीइलाअ कदर काड्यीते. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />फेस्तुसे उत्तर आप्यो, “पौलुस केसरियाम जेलेम होय, आन आंय सोताहा तिहीं उतवाल जाहीं.” <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />फाशोअ कोयो, “तुमामेर्‍याअ जे पुडारी होय ते आरी आवजा, आन जर ये माट्ये काविहीं खाराब काम कोअयोय ताहां ते तियापोअ दोश लागाडे.”<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />फेस्तुस तियांआं विसमेहें आंठेक-दोहेक दिही रोत कोइत केसरिया जातु रोयू; आन बिहरे दिही न्यायनिवाड़ाआ कोर्ठोम बोहीत कोइत पौलुसोहो लेतावे तेहें आदेश आप्यू. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />जेहेलाम तो आयू ताहां जे यहुदी येरुसालेमोम रोत आयाते. तियां केंडवारीत उबा रोत कोइत तियापोअ जाअखीलाहा कठीण आरोप लागाड़्या, जियांअ पुरावू ते ने आपीत सेकताते. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />पोन पौलुसे उत्तर आप्यो, “आंय नाहां यहुदीइ कायदाआ, नाहां मंदिरोअ, नाहां कैसरोअ विरुध्दाम काविंहीं पाप कोअयू.”<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />ताहरुउ फेस्तुसे यहुद्याहां खुस कोइलोअ इश्शा वाअहीं पौलुसोहो कोयो, “केहें ताआ इश्शा होय के येरुसालेमोमेहें जात कोइत तिहीं माआं सामने ताआ न्यायनिवाड़ु ओवे?”<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />पौलुसे कोयो, “आंय कैसरोअ न्यायनिवाड़ाआ कोर्ठोअ सामने उबू होय; माआ न्यायनिवाड़ु इहींज ओवुहूं जोवे. तुमुहूं ताम होसकोअतीज मुंदू होय के मी यहुद्याआ किज गुनू नाहां कोअयू. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />जर आंय गुनेगार ओय आन माइत टाकुहूं जोगोहो काविहीं काम कोअयोय, ताहां माआं मोइलाआ बी तियारी होय; पोन जियीं गोठीइ ए मापोअ आरोप लागाड़ताहा, जर तियांमेर्‍यीइ कोड्ली बी गोठ खरी ने ठर्‍यी, ताहां कोडोज माहूं यांआं आथोम होपतीज नाहां सेकतो. आंय कैसरोहो रावणी कोअहो.”<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />ताहरुउ फेस्तुसे सल्लागारोअरी सभा हादीत गोठी कोयीन ताहरुउ उत्तर आप्यो, “तुमे कैसरोपोअ न्याय माग्युहू, ताहां तू कैसरोअ जागेज जाही.”<verse eid="ACT 25:12" /></para>
  <para style="s">राजा आग्रिप्पा आन बिरनीकेए सामने पौलुस</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />थोड़ाक दिहोअ फासाड़ी आग्रिप्पा राजा आन बिरनीके केसरियामेहें आवित कोइत फेस्तुसोहो मिल्या. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />ते वारुज दिही तिहीं रोया तिहींइं फाटी फेस्तुसे पौलुसोअ बाप्तिमेहें राजाहा कोयो: “एक माटी होय, जियाहा फेलिक्स जेलेमेहें सोड़ीत गोयुहू. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />जेहेलाम आंय येरुसालेमोम ओतू, तेहेलाम मुख्य पुंजारु आन यहुदी डायहां तियाआ सौकीशी कोअयी आन तियांआं इश्शा ओती के तियाहा डोंडोअ आदेश जोड़े. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />पोन मी तियांहां उत्तर आप्यो, कोड्ला बी माहुंहूं जाअहूं जाआं गुनेगारोहो तियापोअ गुनू लागाड़नाराआ सामने उबू रोत कोइत गुनाआं उत्तर आपीइलाअ संदी ने जोड़े, ताअहूं जाआं डोंडोअ काजे होपी देअलोअ एहेलिही सवाय रोमनवालाआ कायनाहां. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />तियाहा काजे ते इंहीं टोलवाअला, तेहेलाम आंय जारिक बी वाआ ने लागाड़्यी, पोन दुसरे दिही न्यायनिवाड़ाआ कोर्ठोम बोहीत कोइत तिया माट्योहो सामने लेतावे तेहें आदेश आप्यू. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />जाहां तियाआ गुनू लागाड़नारा उबू रोया, ताहां जेहलुहू आंय समजीइतुतो तेहलुहू कठीण गोठीइ गुना तियां नाहां लागाड़्यु. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />पोन ते तियांआं पंथाआ आन ईसु नावोअ एका माट्योअ बाप्तिम वादावाद कोअताते, जो मोइत गोयूतो आन पौलुस तियाहा जिवतु होय कोतूतो. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />माहूं यीं गोठीइ मुंदू की कोइत जोड़े कोत विसारोम पोड़्यू? तियाहा काजे आंय पौलुसोहो फुशो, ‘केहें तू येरुसालेमोम जाही के तिहीं ताआ यीं गोठीइ फैसलू ओवे?’ <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />पोन जाहां पौलुसे न्याय माग्यू के तियाआ यी केसेए फैसलू सम्राटोअ जागे ओवुहूं जोवे, ताहां मी आदेश आप्यू के जाअहूं जाआं आंय कैसरोअ जागे ने मोकलो ताअहूं जाआं याहा देखरेखीम मिका.”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />ताहरुउ आग्रिप्पे फेस्तुसोहो कोयो, “आंय बी तिया माट्योअ गोठ उनाअहूं कोअहो.” तिये कोयो, “तू हांदाआ उनाइत लेही.”<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />बिहरे दिही जाहां आग्रिप्पा आन बिरनीके वारुहूं तियारी कोइत आया आन रोमी सेयनिकोअ मुख्या आन गांवोंमेर्‍याआ मुख्य पुढार्‍योंअरी सभागृहामेहें आया, ताहां पौलुसोहो लेतावे तेहें काजे फेस्तुसे आदेश आप्यू. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />फेस्तुसे कोयो के, “राजा आग्रिप्पा, आन आखा माअहूं जे इंहीं आमाअरी होय, तुमू या माट्योहो पालताहा, जियाआ बाप्तिमेहें आखा यहुद्यां येरुसालेमोम आन इंहीं बी आअड़ी-आअड़ीइ माहूं विनंती कोअयी के ओ माटी जिवतो रोअलाआ लायकीइ नाहां. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />पोन आंय जांइत लेदो के माइत टाकाय एहेलोहो ये किज नाहां कोअयो; आन जेहेलाम ये सोताहाज माननीय राजाआ न्याय माग्यू, ताहां आंय याहा रोम मोकलीइलोअ निर्णय कोअयो. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />माहूं याआ बाप्तिमेहें किज पाक्की गोठ ने जोड़यी के माआं मालख्योअ जागे लेखो. तियाहा काजे याहा तुमाआं सामने आन खास कोइत राजा आग्रिप्पा, तुमाआं सामने लेतायुहू के सौकीशी ओवे तिहीं रोत माहूं वाजीहीं लेखुहूं जोगोहो जोड़े. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />काहाके जेलार्‍यापोर्‍युउ आरोप वारुहूं स्पश्ट ने कोअता आवे ताअहूं जाआं एहेलोज मोकलीइलो माहूं बोराबर नाहां देखाअतो.”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">आग्रिप्पाआ सामने पौलुसोअ वासाइलो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />आग्रिप्पे पौलुसोहो कोयो, “ताहूं ताआ बाप्तिम गोगीइलाआ परवांगी होय.” ताहां पौलुस आथ आगाड़ी कोइत उत्तर आपू वोल्यू, <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />“राजा आग्रिप्पा, जेत्ती गोठीइ यहुदी मापोअ आरोप लागाड़तेहे, आज तुमाआ सामने तियांआं उत्तर आपीइलामेहें आंय सोताहा नसीब समजोहो, <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />खास कोइत याअकाजे के तुमू यहुदीइ आखो वेवारो आन विवादोहो जांअताहा. तियाहा काजे आंय विनंती कोअहो, धिर खेटीत माआं गोठ उनाआ.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />“हानुज रोत आंय केहें कोइत जिवयू तों आखा यहुद्याहां मुंदू होय. आमाआं जातीइ माअहूं मेहें आन येरुसालेमोमेहें माआं जिवन केहेलोह ओतो तों तियांहां मुंदू होये. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />जर ते साक्शी आपनारे ओय, ताहां हानुज रोत माहूं ओलखीइतेहे के आंय फरिसी होय कोत माआं पंथाआ आखाम रोत कठीण पंथाआ पुरमाणे साल्यु.<note caller="+" style="x"><char style="xo" closed="false">26:5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">प्रेशित 23:6</ref>; <ref loc="PHP 3:5">फिलि 3:5</ref> </char></note> <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />आन ओमे वेगाआ डायहांहां देवे आपल्या आथवसनोअ बाप्तिम मी आशा तोअयीही तिहींइं वाखरी इंहीं मापोअ न्याय निवाड़ू सालेहे. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />तियाज वायदाअ पुरो ओवीइलाआ आशा लागाड़ीत, आमाआं बारा पारवाड़ी तियांआं पुरा मोनो वाअहीं रातेन दिही देवोअ सेवा कोअते आयेहे. ए राजा, यीज आशाआ बाप्तिमेहें यहुदी मापोअ आरोप लागाड़तेहे! <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />देव मोल्याहां फाशुउ जिवाड़त्लू, यी गोठीपोअ तुमामेर्‍याआ वार जोओंहों विश्वास काहा नाहां बोहतू?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />“ईसु नासरीइ नावोअ विरुद्दाम माहूं खुब काही कोअहूं जोवे एहेलोह माहूं बी लागतोतो. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />आन तेहलोज मी येरुसालेम होयरोम कोअयो; काहाके मुख्य पुंजारां पोअ रोत तेहलुहू आधिकार बी जोड़्युतो. तिहींज वाअहीं ताम जाअखीलाहा देवोअ माअहुंहूं जेलेम टाक्ये, आन जियांहां माइत टाकी देदे, तियांआं विरुद्ध माआं बी सहमती आप्यीते. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />हारेक आराधनालयोम आंय तियांहां तारास देय-देय बोलजबरीज ईसुउ निंदा कोआड़तुतो, तेतोज नाहां पोन खोतेए बाल्लायी एतुहू गांडवात गोयू के बाहेर्‍याअ गावोंमेहें बी जात कोइत तियांहां तारास देतुतो.<note caller="+" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेशित 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>,<ref loc="ACT 22:5">5</ref> </char></note><verse eid="ACT 26:11" /></para>
  <para style="s">पौलुस तियाआ बोदलाअलो जिवन कोतापेहे</para>
  <para style="r">(<ref loc="ACT 9:1-19">प्रेशित 9:1-19</ref>; <ref loc="ACT 22:6-16">22:6-16</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />“यीज धुंदेमेहें जेहेलाम आंय मुख्य पुंजारां पोअ रोत आधिकार आन आदेश-पत्र लेत कोइत दमिश्कमेहें जातुतो; <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />ताहां, महाराज! वाटेज दिहेए वेले जुगोम रोत दिहो रोत बी वादार एक उजालो, माआं आन माअरीइ हात्योओं शारी सोमकीर सोमकीइत्लो देखाअयो. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />जाहां आमू आक्खा पुंयपोअ पोड़ीत गोया, ताहां इब्री बाशामेहें माहूं एहें कोइत गोगत्लो एक आवाज होंबलाअयू, ‘शाऊल, शाऊल, तू माहूं काहा तारास देहे? पेराणा पोअ लात देअलो ताआ काजे कठीण होय.’ <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />आंय कोयो, ‘तू कोडू होय?’ प्रभु कोयो, ‘आंय ईसु होय, जियाहा तू तारास देहे, <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />पोन तू उठ, आन ताआ गुडापोअ उबू रो; काहाके आंय याआ काजे दर्शन ताहूं आप्यो के जे गोठी तुमे देख्यीही, जियींहीं आंय ताहूं देखाड़ीहीं तियीं गोठीइ ताहूं सेवक आन साक्शीदार कोत ठरवीत सेको. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />आन आंय ताहूं यां इस्राएलवाला रोत आन बिगर यहुद्यां रोत वासाड़ीहीं, जियांआं जागे आंय ओमे ताहूं याअकाजे मोकलोहो, <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />के तू तियांआं डोआ उगाड़े के ते आंदाराम रोत उजालाअहें, आन सैतानोअ आधिकारोम रोत देवोअहें फिरे; मोन्ज्ये मापोअ विश्वास मिकीइला वाअहीं तियांहां पापोअ माफी जोड़ीत सेके आन माआं निवड़ीइल्या माअहोंअरी जागू जोड़ीत सेके.’<verse eid="ACT 26:18" /></para>
  <para style="s">पौलुस तियाआ कामोअ बाप्तिम कोतापत्लू</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />“तियाहा काजे राजा आग्रिप्पा, आंय तिया होरगाआ दर्शनोअ गोठ ने टाल्यी. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />पोन पेल दमिश्कोअ, तिहींइं फासाड़ी येरुसालेमोअ, आन ताहरेए यहुदीयाअ पुरा देसोअ रोनाराहां, आन बिगर यहुदीही समजाड़तू रोयू, के मोन फेरवा आन देवोअहें फिरीत कोइत मोन फिरावीलाअ लायक काम कोआ.<note caller="+" style="x"><char style="xo" closed="false">26:20 </char><char style="xt" closed="false"><ref loc="ACT 9:20">प्रेशित 9:20</ref>,<ref loc="ACT 9:28">28</ref>,<ref loc="ACT 9:29">29</ref> </char></note> <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />यीं गोठीइ वाखरी यहुदी माहूं मंदिरोमेहें तोइत कोइत माइत टाकीइलाअ कोशित कोअयी. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />पोन देवोअ मदतो वाअहीं आज आंय इंहीं उबू रोत कोइत हानान वोडाआ सामने साक्शी आपोहो, आन तियीं गोठीही सोड़ीत किज नाहां कोतू जे भविश्यवक्ता आन मोशे बी कोयीते के ओवनारी होय, <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />आन तियाआ परमाणे ख्रिस्ताहा दुख वेठीइलो आवे, आन तोज आखा रोत पेल मोल्याम रोत जिवीत उठीत कोइत, आमाआं माअहूंम आन बिगर यहुदीमेहें सुटका आपनारा उजालाअ परसार कोए.”<note caller="+" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="ISA 42:6">यश 42:6</ref>; <ref loc="ISA 49:6">49:6</ref>; <ref loc="1CO 15:20">1 करिन्थ 15:20</ref> </char></note><verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />जेहेलाम तो एहें कोइत उत्तर आप्या कोअतुतो, तेहेलाम फेस्तुसे आअड़ीत कोयो, “पौलुस, तू गांडू होय. जाअखी विद्या वाअहीं तू गांडवात गोयुहू.”<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />पोन पौलुसे कोयो, “माननीय फेस्तुस, आंय गांडू नाहां, पोन खोरी गोठ आन ओकलेए गोठी कोहो. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />जे गोठी आंय साती ठोकीत सामने गोगोहो, ते गोठी राजाहा बी मुंदू होय; आन माहूं विश्वास होय के यीं गोठीमेर्‍यीइ कोड्लीज गोठ तियांप रोत आडल नाहां निकाअयी, काहाके ए घटना एखा खुणामेहें नाहां ओवी. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />राजा आग्रिप्पा, केहें तू भविश्यवक्ताआ विश्वास कोअहे के? होव, माहूं मुंदू होय के तू विश्वास कोअहे.”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />ताहरुउ आग्रिप्पे पौलुसोहो कोयो, “ताआ एतीज गोठी वाअहीं आंय ख्रिस्ती बोणीत जाहीं एहेलोह ताहूं लागत्लो के?”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />पौलुसे कोयो, “देवोहो माआं प्रार्थना होय, के थोड़ीज ओय नेत जाअखी ओय, निस्तु तू एतुज नाहां, पोन जेते माहें आज माआ गोठी उनाअतेहे, यीं बेड़ीही सोड़ीत तें आक्खे माआं होस बोणीत जाअहूं जोवे.”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />ताहां राजा आन राज्यपाल आन बिरनीके आन तियांअरी बोहनारे उठीत उबे रोये; <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />आन आंगेज जात कोइत तियां तियांआज कोने वोल्ये, “ओ माटी ते किज नाहां कोतू, जों मोतोअ डोंड नेत जेलेमेहें केंडुहूं जोगोहो ओय.” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />आग्रिप्पे फेस्तुसोहो कोयो, “जर ओ माटी कैसरोअ न्याय ने मागतू ताहां सुटीत सेकतुतो.”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">पौलुस जाहाजेम बोहीत रोम होयरोम जात्लू</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />जेहेलाम जाहाजेम बोहीत इटली जाअलोअ आमाआं ठरीत गोयो, ताहां तियां पौलुस आन थोड़ाक बिहीरा जेलार्‍यांहां बी यूलियुस नावोअ औगुस्तुसोअ रोमी सेयनिकोअ एका आधिकाऱ्योअ आथोम होपी देदा. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />अद्रमुथियुमोअ एकी जाहाजेम बोहीत कोइत आमू तियीही सोड़ी देदी, जे आसियाआ मेरेए वोल जानारीज ओती, आन अरिस्तर्खुस नावोअ थेस्सलनीकेए एक मकिदुनियावालू विश्वासी बी आमाअरी ओतू. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />बिहीरे दिही आमू सिदोनोमेहें पोता, आन यूलियुसे पौलुसोपोअ मेरवानी कोइत तियाहा दोस्त्योअहीं रोत मदत स्विकारे तेहें जाअहूं देदू. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />तिहीं रोत हावा हुम्बीज ओती, तिहीं वाअहीं आमू जाहाज सोड़ीत सायपरस बेटोअ मेरे-मेरे जाना वोल्या; <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />आन किलिकिया आन पंफूलियाआ आहनेए दोर्‍याम ओवताज लूसियाआ मुरा नावोअ बंदरोमेहें उतर्‍या. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />तिहीं आधिकाऱ्योहो अलेक्झान्डरीया वालाआ एक जाहाज इटली जात्ली मिल्यी, ताहां आमुहूं तिये तिहींम बोहाड़ी देदा. <verse eid="ACT 27:6" /><verse number="7" style="v" sid="ACT 27:7" />आमू जाअखीलाहा दिही जाआं बागे-बागे सालीत कोइत जेमतेम कनिदुसोअ सामने पोता, काहाके हावा आमुहूं आगाड़ी जाअहूंन्ने देतीते, आमू सलमोनेए सामनेज रोत ओवताज क्रेतेए आडल रोत जाना वोल्या; <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />आन तियाआ होड़ीज होड़ीज जात कोइत “शुभलंगरबारी” नावोअ एकी जागे बोले पोत्या, जिहीं रोत लसया गांव आहने ओतो.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />जेहेलाम वारुज दिही सेकित गोया आन जलप्रवास कोइलोमेहें तारास याअकाजे ओवतुतो, काहाके उपासोअ दिही ओमे खुटाअयाते. ताहां पौलुसे तियांहां एहें कोत कोइत समजाड़्या, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />“ए माट्यों, माहूं जी या प्रवासोमेहें धोकू आन नुकसान ओवे एहेलोह देखाअहे, निस्त मालोन जाहाजोअ एतोज नाहां, पोन आपाआ जिवोअ बी नुकसान ओवनारोहो.” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />पोन आधिकार्‍ये पौलुसोअ गोठी रोत वादार कप्तान आन जाहाजोअ मालख्योअ गोठी पोअ ध्यान देदो. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />तों बंदरगा<note caller="+" style="f"><char style="fr" closed="false">27:12 </char><char style="fq" closed="false">बंदरगा </char><char style="ft" closed="false">जाहाज उबो राखीइलोअ ठिकाण</char></note> हियालाम रोअलाआ काजे ने हाजो ओतो, तियाहा काजे वारुज जोंओंअ विसार ओतू के तिहीं रोत जाहाज सोड़ीत कोइत जर ओत सेके ताहां फिनिक्सोम पोतीत कोइत तिहीं हियालू सेकाड़े. ओं ते क्रेतेए एक बंदरगा होय जो देहाम-बुड्ताम आन पालाम-बुड्तामाअहें सोब कोइत खुलो होय.<verse eid="ACT 27:12" /></para>
  <para style="s">दोऱ्याम वादुउ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />जाहां जार-जारीही देहामी हावा साली वोल्यी, ताहराआ आपाआ काम पुरो ओवो कोत समजीत कोइत लंगर फेड़्यीन कोर तोइत क्रेतेए आहने रोत जाना वोल्या. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />पोन एकुज तालेन धरतीइहें रोत एक वोडु वादुउ लागू वोल्यू, जियाहा “यूरकुलीन” कोतेहे. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />जाहां वादुउ जाहाजोअहें आवित ठोकाअयू, ताहां ते तियाआ सामने टिकीत ने सेकी, तियाहा काजे आमू तियीही वोहुहूं देदी आन एहेंज कोइत वोहताज जाता रोया. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />ताहराआ कौदा नावोअ एका हाना एवडाहा बेटोअ होड़ीज वोहता-वोहता आमू बोले कोइत नावड़ाहा ताबाम कोइत सेका. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />ताहराअ जाहाजेए सांबालनारा तियाहा ओढीत कोइत मांय लेताया आन वोग पालित कोइत जाहाजेहे निसे रोत्ते उसे जाआं आपकीत बांद्यी, आन जाहाज सुर्ती नावोअ निंडी रेटावाली जागे जात ठोकाय यी बिकेवाअहीं पोड़दू निसे उतारीत लेदू, ताहां वाराअरी वोहताज जाता रोया. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />जाहां आमू वादुउ वाअहीं जाहाजीमेहें बुसकण्याआं आन धक्का खादा, ताहां बिहरे दिही ते जाहाजेमेर्‍योअ सामान दोर्‍याम उडाड़ा वोल्या; <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />आन तिसरे दिही तियां सोताआ आथोवाअहीं जाहाजेए सामान बी उडाड़ी देदो. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />जाहां वारुज दिही जाआं ने दिही, ने तारा देखाअया आन जुदू जोरे वादुउ सालतू रोयू, ताहां आखरीमेहें आमाआं वासाइलाअ आखी आशा बी खुटात गोयी.<figure style="fig" alt="Ship being wrecked in a storm" file="LB00219C.TIF" size="col" copy="Horace Knowles ©" ref="27:18">दोऱ्याआ उपाड़ाम जाहाज</figure><verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />जाहां ते वारुज दिही जाआं फुकल्याज ओता, तेहेलाम पौलुसे तियांआं विसमेहें उबू रोत कोइत कोयो, “ए माअहूं, तुमू माआं गोठ मानित कोइत क्रेते रोत जाहाज ने सोड़ता ताहां हाजो ओतो, ताहां ए आफत ने आवती आन ने ओं नुकसान भोगुहूं पोड़तो. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />पोन ओमे आंय तुमुहूं समजाड़ोहो के हिम्मत मिका, काहाके तुमामेर्‍याआ कोडाआज जिवोअ नुकसानी ने ओवे, निस्ती जाहाज एतीज आरवाय. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />काहाके देव जियाअ आंय होय, आन जियाअ सेवा कोअहो, तियाआ देवदुते हांस्तीइ राती माआं जागे आवित कोइत कोयो, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />‘ए पौलुस, मा बिही! ताहूं कैसरोअ सामने उबो रोअलोअ जरुरी होय. पाल, ताअरी होय तियां आखाहा देवे ताहूं आपी देदेहे.’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />तियाहा काजे, ए माट्यों, हिम्मत मिका; काहाके माहूं देवोपोअ विश्वास होय, काहाके जेहलोहो माहूं कोयोहो, तेहेंज कोइत ओवे. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />पोन आपुहूं एखा उनावाअहीं रुकाअहूं पोड़े.”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />जाहां सौदावी रात आयी, आन आमू अद्रिया दोर्‍यामेहें भटकीइता फिरताते, तेहेलाम पोरापोर रातीइ वेलेहे जाहाजेए सांबालनारा आंदास कोअयू के आपू एखी पुयींइं आहने पोतताहा. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />तियां पाईं केतोहो उंडो होय तों मोजीत पाल्यो, ताहां सालीही मिटर निहींयो, आन आगाड़ी जात कोइत फाशोअ मोजीत पाल्यो, ताहां तीस मिटर निहींयो. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />ताहां डोणाट्यी जागेहे ठोकाइलाआ बिके वाअहीं तियां जाहाजेए फासाड़ीइ वोगेहे शार लंगर टाक्या, आन हुसत्लाहा वाट जोवा वोल्या. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />पोन जेहेलाम जाहाजेए राखवाली जाहाजेम रोत नाहींइलाआ कोशित कोअताते, आन आगाड़ी रोत लंगर टाकीइलाअ नाटक कोइत नावड़े दोर्‍यामेहें उतारी देदे; <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />ताहां पौलुसे आधिकाऱ्योहो आन सेयनिकोहो कोयो, “जर ए जाहाजेम ने रोया, ताहां तुमू बी ने वासाइत सेकहा.” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />ताहां सैनिकहों दोअड़े तोड़ीत नावड़े ओदारी देदे.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />जेहेलाम हुजुहूं कोअतोतो, तेहेलाम पौलुसे ओं कोत कोइत आखाहा रोटू खायतेहें समजाड़्यो, “आज शौदा दिही ओत गोया, तुमू सिंता कोइ-कोईइ फुकल्याज रोया, आन वाहीं रोटू ने खादू. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />तियाहा काजे तुमुहूं समजाड़ोहो के वाजिहीं रोटू खात ल्या, जिहीं वाअहीं तुमू वासाअहा; काहाके तुमामेर्‍याआ कोडाआज मुन्काआ एक सिंग्यो बी ने ओदरे.” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />एहें कोत कोइत तिये रोटू विशू आन आखाआ सामने देवोअ धन्यवाद कोअयो आन मुड़ीत कोइत खानु वोल्यू. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />ताहराअ ते आखा बी हिम्मत कोइत रोटू खाना वोल्या. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />आमू आखा मिलीत कोइत जाहाजेम बेन होव सत्तरेन सोव जोआं ओता. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />जेहेलाम ते रोटू खात कोइत ताराअया, ताहां आखे गोंवें दोर्‍यामेहें टाकीत कोइत जाहाज ओलवी कोआ वोल्या.<verse eid="ACT 27:38" /></para>
  <para style="s">जाहाज आरवाइलो</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />जेहेलाम दिही उगू, तेहेलाम तो देस तियांहां ने ओलखाअयू, पोन एक पुयींइं भाग देख्यू जियाअ मेरेए भाग शौकड़्यू ओतू, आन विसार कोअयू के जर ओत सेके ताहां याज पोअ जाहाज उबी कोअहूं. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />ताहां तियां लंगरोहो सोड़ीत कोइत दोर्‍याम टाकी देदी आन पाताआ गाठ सोड़ी देदा, आन वाराआ हुंबर आगल्युउ पोड़दू सोढ़वीत कोइत मेरे पोअ आवा वोल्या. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />पोन बेन दोर्‍याअ मिलनोअ जागा पोअ रोत कोइत तियां जाहाजेहे रुकीत मिक्यी, आन आगाड़ीइ भाग ते धक्का खात कोइत फुटीत गोयू आन टोलीत ने सेकू; पोन फासाड़ीइ भाग उपाड़ाआ मारो वाअहीं टुटू वोल्यू.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />ताहां जेलार्‍या आखा तोरीत कोइत निहीत जाय कोत ते सैनिकहों ओ विसार कोअयू के माइत टाकत्ला. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />पोन आधिकार्‍ये पौलुसोहो वासाड़ीलोअ इश्शा वाअहीं तियांआं ए योजना रुकी देदी आन एहें कोयो, के जे तोरीत सेकताहा, ते पेल उडीत कोइत मेरेपोअ निहीत जावा; <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />आन बाकी रोय ते पाट्यापोअ, आन जाहाजेए एकदी वस्तुउ आधार लेत निहींत जाय. एहें कोइत पुरे माहें मेरेपोअ वासाइत निहींये.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">माल्टा बेटोपोअ पौलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />जेहेलाम आमू वासाइत कोइत मेरे पोता, ताहां मुंदू गोयू के या बेटोअ नाव माल्टा होय. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />तिहीं रोनारे माअहें आमाअरी जास्ती हाजे वाग्ये; काहाके पाईं बी पोड़तोतो आन हेलो बी लागतोतो, तिहीं वाअहीं तियां आग पेटाड़ीत कोइत आमू आखाहा हाद्या. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />जेहेलाम पौलुसे एक पारु एतेहे लाकड़े टोलू वालीत आगी पोअ मिक्ये, तेहेलाम एक गोड़हू हेके वाअहीं निहींयू आन तियाआ आथोअरी वेट्लाइत गोयू. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />जेहेलाम तिहीं रोनारे माअहें गोड़हू तियाआ आथोअरी वेट्लाइत रोल्यू देख्यू, ताहां तियां तियांआंज कोने वोल्ये, “हादामक्योज ओं माहुंउं माहोंणमारो ओय, दोर्‍याम रोत बोले वासात आयो, तेबी बोगवानोअ न्याय याहा जिवतो रोअहूं ने देदो.” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />ताहरुउ तिये गोड़हाहा आगीम फोकड़ीत उडाड़्यू, आन तियाहा किज नुकसान ने ओवो. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />पोन तें माहें वाट जोवतेते के तो हुजीत जाय नेत ताबुड़ फोपड़ीत मोइत जाय, पोन जेहेलाम हांहतेहे जाआं पाल्याज कोअयो पोन तियाहा किज बी ने ओवो. ताहरोअ तियांआं विसार बोदलात गोयुन कोने वोल्ये “ओं ते काविहीं देवुज होये.”<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />तिया जागाअ आहने पाहने पुब्ल्यास नावोअ आधिकार्‍योअ खेते ओते. तिये आमुहूं तियाआ कोअ लेत जात कोइत तीन दिही जाआं दोस्त्योंअ होस पावणा तोअया. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />पुब्ल्यासोअ आब्हू जोराअरी आन बारथीइरी ओतू. तियाहा काजे पौलुस तियाअहीं कोअमेहें जात कोइत प्रार्थना कोअयी आन तियापोअ आथ मिकीत कोइत तियाहा हुदार्‍यु. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />जेहेलाम एहेलोहो ओयो ताहां तिया बेटोपोअ रोनारे बाकी बिमारी माअहें बी आयेन हुदरीत गोये. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />तियां आमुहूं वारुज भेटवस्तू आपीत जास्ती इज्जत कोअयी, आन जेहेलाम आमू जाना वोल्या तेहेलाम जो किबी वाटे जोवनारो ओतो तों जाहाजेम मिकी देदो.<verse eid="ACT 28:10" /></para>
  <para style="s">माल्टा बेटोअहें रोत रोम सेहरोअहें</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />तीन मोयनाआं फासाड़ी आमू अलेक्झान्डरीया वालाआ एकी जाहाजेम बोहीत कोइत निहीत पोड़्या, जे तिया बेटोपोअ हियालू सेकाड़तीते, आन तियी जाहाजेए नाव “जुड़वा पाही<note caller="+" style="f"><char style="fr" closed="false">28:11 </char><char style="fq" closed="false">जुड़वा पाही </char><char style="ft" closed="false">इब्री शब्द “दियुसकूरी” होय.</char></note>” ओतो. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />सुरकुसामेहें जाहाज उबी कोइत आमू तीन दिही काड्या. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />तिहीं रोत आमू फिरीत कोइत रेगियुमोमेहें आया; आन एका दिहोअ फासाड़ी देहामी हावा साल्यी, ताहराअ आमू बिहरे दिही पुतियुलीमेहें आया. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />तिहीं आमुहूं विश्वासी पाही मिल्या, ताहरोअ तियांआं कोयावाअहीं आमू तियांआं जागे हांत दिही जाआं रोया; आन एहें कोइत आमू रोमोमेहें आवया. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />तिहींइं विश्वासी पाव्हीइले आमू आवताहा ओं उनाइत कोइत “अप्पियुस” नावोअ सौकड़ी आन “तीन सराय” नावोअ जागे जाआं आमुहूं मिले आवये. जियांहां देखीत कोइत पौलुसे देवोअ आभार मान्यू आन तियाहा हिम्मत जोड़्यी.<verse eid="ACT 28:15" /></para>
  <para style="s">रोमोमेहें पौलुस</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />जेहेलाम आमू रोमोमेहें पोत्या, ताहरोअ पौलुसोहो तियाआ राखवाली कोअनारा एका सैनिकोअरी एखलाहाज रोअलाआ परवानगी जोड़्यी. <figure style="fig" alt="Street scene of The Roman city" file="HK00242C.TIF" size="span" copy="Horace Knowles ©" ref="28:16">रोमन होयरोअ सड़केए देखावु</figure><verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />तीन दिहोअ फासाड़ी तिये यहुद्याआं पुढार्‍योहों हाद्या, आन जेहेलाम ते टोलू वोल्या, ताहां तियांहां कोयो, “माआं होगा पायहों, आंय आपाअ नेत वेगाअ डायहांअ रुढ़ीइ विरुद्दाम किज नाहां कोअयो, तेबी माहूं तोइत येरुसालेमोमेहें रोत रोमनवालाआ आथोम होपी देदू. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />तियां माहूं फारकीत कोइत सोड़ी देअलोअ कोअयो, काहाके मामेहें मोतोअ जोगुहू कोड़लूज गुनू ने ओतू. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />पोन जेहेलाम यहुद्यां याआ विरोध कोअयू, ताहां माहूं कैसरोहो विनंती कोअहूं पोड़्यी: माहूं माआं होगा पोअ एखु दोश लागाड़ीइलू एहेलोह बी ने ओतो.<note caller="+" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 25:11">प्रेशित 25:11</ref></char></note> <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />पोन आंय ताम तुमुहूं मिलीइलोन गोठी कोइलोअ काजे हाद्याहा; काहाके आंय इस्राएलोअ आशाआ काजे यी हाकले वाअहीं बांदाअयुहू.”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />तियां पौलुसोहो कोयो, “ने आमुहूं ताआ बाप्तिमेहें यहुदीया रोत सिट्टी जोड़्यी, आन ने होगा पायहोमेर्‍योअ एखो आवित ताआ बाप्तिमेहें काविहीं कोयो, के ने बाक्तो कोयो. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />पोन ताआ विसार की होय तो आमू तापोअ रोत उनाअहूं कोअताहा, काहाके आमुहूं मुंदू होय के हारेक जागे या पंथाआ विरुद्दाम माअहें गोठी कोअतेहे.”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />ताहराअ तियां पौलुसोअ काजे एक दिही ठरव्यू, आन वारुज माअहें तियाआ जागे टोलू वोल्ये, आन तो देवोअ राजोअ गोठी कोतापतू रोयू, मोशेए नियमोअ आन भविश्यवक्ताआ पुस्तकोम रोत वेग्र्युउ रोत ते हांजेपोअ जाआं ईसुउ बाप्तिमेहें समजाड़ी समजाड़ीइ कोतापतू रोयू. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />ताहराआ थोड़ाक जोओं तियीं गोठीही मानित लेदी, आन थोड़ाक जोओं विश्वास ने कोअयू. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />जेहेलाम तियां तियांजमेहें एक मत पोड़्यो, ताहराआ पौलुसोअ ए गोठ कोताजमेहें ते वेरात गोया: “पवित्र आत्मा यशया भविश्यवक्ता वाअहीं तुमाआं वेगाआ डायहांहां बोराबरुज कोयो!<verse eid="ACT 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />“‘जात कोइत यां माअहुंहूं को,</para>
  <para style="q1" vid="ACT 28:26">के उनाअते ते रोहा, पोन ने समजाहा,</para>
  <para style="q2" vid="ACT 28:26">आन पालते ते रोहा, पोन ने देखहा;<note caller="+" style="f"><char style="fr" closed="false">28:26 </char><char style="ft" closed="false">यशया. 6: 9-10 </char></note><verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />काहाके यां माअहुंउं मोन नादान ओत गोयोहो</para>
  <para style="q2" vid="ACT 28:27">आन कान बोयरात गोयाहा,</para>
  <para style="q2" vid="ACT 28:27">आन तियां डोआ मिसीत लेदाहा,</para>
  <para style="q1" vid="ACT 28:27">नेते तें डोआ वाअहीं देखते,</para>
  <para style="q2" vid="ACT 28:27">कानो वाअहीं उनाअते,</para>
  <para style="q2" vid="ACT 28:27">मोनो वाअहीं समजीइते,</para>
  <para style="q1" vid="ACT 28:27">माअहें फिरते,</para>
  <para style="q2" vid="ACT 28:27">आन आंय तियांहां हुदारतू.’ एहें कोत देव कोहे.”<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />“तियाहा काजे तुमू ओलखा के देवोअ ओ तारणोअ संदेश बिगर यहुदीइ जागे मोकलाअयहू, आन तें उनाये!” <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />जेहेलाम तिये ओं कोयो ताहां यहुदी तियां तियांआं जाअखीलेहे सुलाए वोल्ये आन तिहीं रोत जाते रोये.<note caller="+" style="f"><char style="fr" closed="false">28:29 </char><char style="ft" closed="false">थोड़ाक लेख्यामेहें ओं वसन नाहां जोड़तो.</char></note><verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />पौलुस पुरे बेन वोरह्ये जाआं तिया पाड़े लेदला कोअमेहें रोयू, <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />आन जे तियाआ जागे आवतेते, तियां आखाहा मिलतू रोयू आन हिम्मत कोइत देवोअ राजोअ परसार कोअतू रोयू आन प्रभु ईसु ख्रिस्ताआ गोठी सिकाड़तू रोयू.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>