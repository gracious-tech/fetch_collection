<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">-Noiri</book>
  <para style="h">2 थेस्सलनी</para>
  <para style="toc3">2 थेस्स</para>
  <para style="toc2">2 थेस्सलनी</para>
  <para style="toc1">थेस्सलनीवालाहां प्रेशित पौलुसोअ दुसरो पत्र</para>
  <para style="mt2">थेस्सलनिकाकरांस प्रेशित पौलाचे दुसरे पत्र</para>
  <para style="mt1">थेस्सलनीवालाहां प्रेशित पौलुसोअ दुसरो पत्र</para>
  <para style="imt">ओलखात</para>
  <para style="ip">थेस्सलनी वालाआं नावसे दुसरो पत्र ओं पौलुसे लेख्योहो. <char style="xt"><ref loc="2TH 1:1">1:1</ref></char> तिये ओं पेहलो पत्र लेखीइलाअ थोड़ाज टेमोअ फाटी लेख्यो. ओं पत्र आंदासीज ख्रिस्ताअ जल्माअ 51 वोर्‍ह्योंअ फाटी लेख्यो. जाहां तिये ओं पत्र लेख्यो. तेहेलाम बी तो करिन्थ सेहरोम ओतू. ए मंडड़ी पौलुसे तियाआ बिहीरी वाआ मिशनरी प्रवासोअ होमसे थापन कोअयी. <char style="xt"><ref loc="ACT 17:1-10">प्रेशित 17:1-10</ref></char> प्रेशितोंअ पुस्तकोमेहें एहेलोह कोहे, के ए मंडड़ी थोड़ाक यहुदी आन वारुज युनानी माअहों वाईं बोण्यी.</para>
  <para style="ip">थेस्सलनी वालाआं मंडड़ीइ माअहें आखरीइ वेल आन प्रभुउ बिहीरी वाआ आविइलाअ बाप्तिमेहें विसार कोअतेते. काहाके पौलुस तियाआ बेनू थेस्सलनीइ पत्रामेहें यीं गोठीइ बाप्तिमेहें वादार लेख्योहो. यां पत्राआ आरदू रोत वादार भाग आखरीइ वेलेए बाप्तिमेहें होय. पौलुस आलहायीइ बाप्तिम बी सेतावणी आपेहे. आन ओं कोहे के हारेक जोओं तियाआ रोटाअ काजे काम कोअहूं जोवे. <char style="xt"><ref loc="2TH 3:6-10">3:6-10</ref></char></para>
  <para style="iot">रुप-रेशा</para>
  <para style="io">1. पौलुस या पत्राआ सुरुवात सोताअ आन तियाआ जोड़ीदारोअ ओलखाती वाईं कोअहे <char style="ior"><ref loc="2TH 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. फाशुउ पौलुस थेस्सलनीइ मंडड़ीइ काजे देवोअ धन्यवाद आन तियांआं काजे प्रार्थना कोअहे. <char style="ior"><ref loc="2TH 1:3-12">1:3-12</ref></char></para>
  <para style="io1">3. 2 रा आध्यायोमेहें पौलुस आखरीइ वेलेए बाप्तिमेहें कोत देखाड़ेहे.<char style="ior"><ref loc="2TH 2">2</ref></char></para>
  <para style="io1">4. फाशुउ पौलुस आलहायीइ विरुध्दाम आन मेहेंनतोअ गरजेए बाप्तिमेहें कोहे. <char style="ior"><ref loc="2TH 3:1-15">3:1-15</ref> </char></para>
  <para style="io1">5. पौलुस या पत्राआ सेवट मंडड़ीही फाशुउ सलाम कोइत बंद कोअहे <char style="ior"><ref loc="2TH 3:6-10">3:6-10</ref></char></para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="s">सलाम</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />पौलुस, सिल्‍वानुस आन तिमथ्याआ जागेहे रोत थेस्सलनी मेऱ्यीइ मंडड़ीइ नावसे, जे आपाअ देव बाह्हू आन प्रभु ईसु ख्रिस्तामेहें होय: <verse eid="2TH 1:1" /><verse number="2" style="v" sid="2TH 1:2" />आपाअ देव बाह्हू आन प्रभु ईसु ख्रिस्ताआ जागेहे रोत तुमुहूं मेरवानी आन होक मिलतू रोय.<verse eid="2TH 1:2" /></para>
  <para style="s">धन्यवाद आन प्रार्थना</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />आमाआं पाव्हीइला, तुमाअ बाप्तिमेहें आमू सादा देवोअ धन्यवाद कोअहूं जोवे, आन ओं बोराबर बी होय, याअ काजे के तुमाअ विश्वास खुब वादतू जाहे, आन तुमा आखाआ मेर एकान बिहीरा पोअ जास्तीज वादती जाहे. <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />तिहीं वाईं आमू सोताहा देवोअ मंडड़ी मेहें तुमाअ बाप्तिमेहें वोडाय कोअताहा, काहाके जेतू बी विरोध आन तारास तुमू वेठतेहे, तियां आखामेहें तुमाअ धिर आन विश्वास देखाअहे.<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />ओ देवोअ खोरा न्यायोअ पुरावू होय, के तुमू देवोअ राज्याआ लायकीइ बोणुहूं जोवे, जियाअ कोअते तुमू आखे दुख बी वेठतेहे. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />काहाके देव जो ठीक ओय तोज कोए: जें तुमुहूं तारास देतेहे, तियाआ बोदले तो तियांहां तारास आपे. <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />आन तुमू जें तारास वेठतेहे, तो तुमुहूं आमाअरी आराम आपे; तो ओं तियी वेले कोए जेहेलाम प्रभु ईसु तियाआ ताकतवाला दुतोंअरी, आगीइ हांगाड़ाम होरगाम रोत प्रगट ओवे. <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />आन जियां माअहूं देवोहो नाकार्‍यू, आन जें आपाअ प्रभु ईसुउ हाजी बातमीहीं नाहां मानते तियांहां डोंड आपे.<verse eid="2TH 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2TH 1:9" />तें हादाफल्योअ आरवाइलोअ डोंड वेठे, प्रभुउ सामने आन तियाआ महिमावाली सेक्तीइ उजवडे रोत सेटे ओत जाय. <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />ओं तियां दिहों मेहें ओवे, जेहेलाम तो तियाआ पवित्र माअहूं मेहें महिमा मिलवु आवे आन आखा विश्वास कोअनारा मेहें बोगलाइलाअ गोठीइ काजे आवे, तियां मेहें तुमू बी रोहा, काहाके तुमू आमाअ साक्शी पोअ विश्वास कोअयू.<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />तियाहाज काजे आमू तुमाअ कोअते हादाफल प्रार्थना बी कोअताहा. आमू आपाअ देवोहो कोताहा के तिये तुमुहूं लायकीइ जिवन जिवे तेहें काजे हाद्येहे, आन तो तुमाआं हाजी गोठीइ हारेक इश्शा आन विश्वासोअ हारेक कामोंहों तियाआ सेक्ती वाईं पुरो कोअहूं जोवे. <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />एहें कोइत आपाअ देव आन प्रभु ईसु ख्रिस्त यांआं मेरवानी वाईं आपाआ प्रभु ईसु ख्रिस्ताआ नावोहो तुमामेहें आन तुमुहूं तियामेहें महिमा जोड़े.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">पापी माटी मोन्ज्ये आरवाअनारु बेटुह्हू</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />विश्वासी पाव्हीइला, ओमे आपू आपाअ प्रभु ईसु ख्रिस्ताआ फाशोअ आविइलाअ, आन तियाअरी हुंबाहूंब आपाआ टोलू वोलीइलाअ बाप्तिमेहें आंय तुमुहूं रावणी कोअहो:<verse eid="2TH 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 2:2" />तुमू ओं विसार कोइत के जिहीं मेहें कोयोय के, प्रभुउ दिही आवित पोत्युहू कोत हेलमेहें सकराअहा मा. आन एखा विसारो वाईं नेत एखू भविश्यवाणी नेत, संदेश, नेताहां आमू लेखल्या पत्रावाईं बी मा काबराअहा. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />तुमू सोताहा किबी कोइत कोडा वाअहीं बी ठोगाअहा मा. काहाके तिया दिहोअ आविइलोअ पेल विश्वास निहींत जाय आन तो खाराब नितीइ माटी मोन्जे आरवाअनारु बेटुह्हू प्रगट ओवे. <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />जो विरोद कोअहे आन जियाहा देव नेत महाराज कोतेहे, एहेला आखा रोत सोताहा वोडु ठरवेहे, तेतोज नाहां पोन तो देवोअ मंदिरोमेहें बोहीत कोइत सोताहा देव होमजेहे.<verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />केहें तुमुहूं ओर कायने के जेहेलाम आंय तुमाअहीं ओतू, ताहां तुमुहूं ए आखी गोठी कोया कोअतुतो? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />तुमू तोम जांअतेहे के, तो पापी माटी तियाआज ठरवीइल्यी वेले पोअ प्रगट ओवे, बिहीरी वेले पोअ नाहां, तिहीं वाईं ते गोठ तियाहा ओमे रुकीत होये. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />काहाके पापोअ रहस्य पेल रोतुज काम कोअतो जाहे, पोन ओमे एक रुकनारु होय. आन जाअहूं जाआं तो सेटे ने ओत जाय ताअहूं जाआं तो रुकीत रोये. <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />ताहां तो पापी प्रगट ओवे, जाहां प्रभु ईसु आवे आन तो तियाआ सोबी वाअहीं फुकीत माइत टाके, आन तियाआ दर्शनोवाईं आरवी देये.<verse eid="2TH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2TH 2:9" />तो पापी सैतानोअ सेक्ती वाईं आवे आन आखी जातीइ ठोग सेक्ती, आन निशाणी, आन समत्कारोअ कामें कोए, <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />आन तो पापी आखी जातीइ खाराब कामें लेतुज आवे, काहाके तियां सत्यापोअ मेर ने कोअयी जिहीं वाअहीं तियांआं तारण ओवेहे. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />ठोगोपोअ विश्वास कोए तेहें कोअते देव तियांमेहें एक भटकावी देनारी सेक्तीही मोकले, <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />याअ काजे के जेते माअहें सत्यापोअ विश्वास नाहां कोअते, पोन ठोगोअ गोठी मेहें खुस ओवतेहे, तियां आखाहा डोंड जोड़ुहूं जोवे.<verse eid="2TH 2:12" /></para>
  <para style="s">तुमुहूं सुटकाअ कोअते निवड्येहे</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />विश्वासी पाव्हीइला, आन प्रभुउ मेराला माअहों, आमू तुमाअ बाप्तिमेहें हादाफल देवोअ धन्यवाद कोअते रोअहूं जोवे, काहाके आत्मा वाअहीं पवित्र बोणीत कोइत, आन सत्यापोअ विश्वास मेकीत कोइत तारण जोड़े तेहें काजे देवे तुमुहूं पेहलो फल कोत निवड़ीत लेदेहे. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />जियाअ कोअते देवे तुमुहूं आमाअ हाजी बातमी वाअहीं आपाअ प्रभु ईसु ख्रिस्ताआ महिमा जोड़ुहूं जोवे काजे हाद्येहे. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />ताहरेए, माआं पाव्हीइला, मजबुत रोवा; आन जो संदेश आन जे गोठी आमाआं पत्रा वाअहीं सिकाअयेहे, ते वातड़ी तोइत रोवा.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />आपाअ प्रभु ईसु ख्रिस्त सोताहा, आन जिये आपापोअ मेर कोइत मेरवानी वाईं कायम उत्साह आप्यो आन हाजी आशा आप्यीही तो आपाअ देव बाह्हू, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />तुमाआं मोनोहो प्रोत्साहन आपे, आन तुमुहूं हारेक हाजा काम आन वसनोमेहें मजबुत कोअहूं जोवे.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">आमाआं काजे प्रार्थना कोअजा</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />आखरी पोअ, आमाअ पाव्हीइला, आमाआं काजेहे प्रार्थना कोअते रोजा के प्रभुउ वसन वेगो पसरुहूं जोवे आन महिमा जोड़ुहूं जोवे, जेहलोहो तुमा मेहें ओवोहो, <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />प्रार्थना कोअजा के आमू बाक्ता आन पापी माअहूं रोत वासाइत रोंव, काहाके आखा माअहूं मेहें विश्वास नाहां रोतु.<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />पोन प्रभु इमानदार होय; तो तुमुहूं ताकते वाईं मजबुत कोए आन तिया पापी रोत वासाड़े. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />आन आमुहूं प्रभु मेहें तुमापोअ पुरु भरिवसू होय, के आमू जो आदेश तुमुहूं आपताहा, तियाहा तुमू मानतेहे, आन मानते बी रोहा.<verse eid="2TH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5" />देवोअ मेर आन ख्रिस्ताआ धिरोमेहें प्रभु तुमाअ मोनोहों वादार हाजी वाट देखाडे.<verse eid="2TH 3:5" /></para>
  <para style="s">आलहायीइ बाप्तिम सेतावणी</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />आमाआं पाव्हीइला, आमू तुमुहूं आपाअ प्रभु ईसु ख्रिस्ताआ नावसे आदेश आपताहा के, तुमू एहेला हारेक विश्वासी माअहूं रोत अलग रोवा, जे आलहायीइ जिवन जिवतेहे आन जे आमू आपल्यी सुसनाआं पालन नाहां कोअते. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />काहाके तुमू सोताहा वारुहूं जांअतेहे, के जेहें कोइत आमू सालताहा तेहें कोइत तुमू बी सालुहूं जोवे, काहाके आमू तुमाअ विसमेहें ओता तेहेलाम केदिहींज आलहाय नाहां कोअयी. <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />आन कोडाअ रोटू फुकट्यू नाहां खादू; पोन मेहेंनत आन काम रात दिही कोअताते, काहाके तुमामेहें कोडा पोअ वोजू ने ओवुहूं जोवे.<verse eid="2TH 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2TH 3:9" />आमुहूं तुमापोअ मदत मागीइलोअ आधिकार कायनाहां एहेलोह नाहां, पोन एताआ कोअते के; जेहलोहो आमू तुमाआं कोअते नमुना बोण्या तेहलोहो तुमू बी कोअहूं जोवे. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />काहाके जेहेलाम आमू तुमाआं जागेहे ओता, तेहेलाम बी आमू तुमुहूं ओ आदेश आपताते के, “जर कोडाहा काम ने कोइलो ओय ताहां तों रोटू बी ने खाअहूं जोवे.”<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />आमू ओं एताआ काजे कोताहा काहाके आमू उनाअताहा के, थोड़ेक जोएं तुमाअ विसमेहें होय, जे आलहायीइ जिवन जिवतेहे, आन बिहीराअ कामों मेहें आडांगू टाकतेहे. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />एहेला माहुंहूं आमू प्रभु ईसु ख्रिस्ताआ नावोमेहें आदेश आपताहा आन समजाड़ताहा, के ठावकेज काम कोइत जिव जिवोअ कामायीइ रोटू खाया कोअहूं जोवे.<verse eid="2TH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13" />पोन माआं पाव्हीइला, तुमू हाजो कोइला मेहें मा थाकहा. <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />जर एखू या पत्रामेहें लेखल्यो वसन ने माने, ताहां तिया पोअ नजर मेकजा, आन तियाहा लाज आवुहूं जोवे काजे तियाअरी सबंध मा मिकहा. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />पोन तियाहा दुस्मोन मा समजाहा, पोन पाही जांइत समजाड़ी द्या.<verse eid="2TH 3:15" /></para>
  <para style="s">आशिर्वाद</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />ओमे प्रभु जो होक आपनारु देव होय, तो सोताहाज तुमुहूं हादाफल आन आखी जातीइ होक आपे. प्रभु तुमा आखाअरी रोये.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />आंय पौलुस, माआं सोताआ लेख्यामेहें ओं सलाम लेखोहो. आंय आखा पत्रा मेहें माआं सही कोअहो; माआं लेखीइलोअ पद्धत एज होय.<verse eid="2TH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18" />आपाअ प्रभु ईसु ख्रिस्ताआ मेरवानी तुमा आखापोअ ओवती रोय.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>