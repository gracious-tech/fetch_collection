<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Noiri</book>
  <para style="h">1 योहान</para>
  <para style="toc3">1 योहान</para>
  <para style="toc2">1 योहान</para>
  <para style="toc1">योहानोअ पेहलो पेत्र</para>
  <para style="mt2">योहानाचे पहिले पत्र</para>
  <para style="mt1">योहानोअ पेहलो पत्र</para>
  <para style="imt">ओलखात</para>
  <para style="ip">योहानोअ पेहलो पत्र ओं ईसु ख्रिस्ताअ जल्माअ 50 ते 100 एताहा वोर्‍ह्योंअ विसमेहें प्रेशित योहानोअ आथे लेखाअलो होये. योहान सोताहा लेखार्‍यू एहें कोत नाहां समजीइतू, पोन पेहलु आध्याय ओं देखाड़ेहे के तो ईसुउ जिवनोअ आन जिवित उठीइलाअ डोआअ सामनेएं साक्शीदार होय. <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char> योहानोअ पेहला पत्राआ लेखीइलोअ पद्धत ए योहाने लेखल्या हाजी बातमीइ पुस्तकोअ होसर्‍यीइ होये. योहाने तियाआ हाजी बातमीइ पुस्तकोअ होस बाकी 3 पत्रे बी लेख्येहे. इफिस होयरोम रोतुतो तेहेलाम तिये 1 योहान, 2 योहान आन 3 योहान एं पत्रे लेख्ये.</para>
  <para style="ip">योहाने आखा विश्वासी माहुंहूं एकवार्‍येज एं पत्रे लेख्ये. जेहेलामेहें “ग्नोस्टिक” मोन्ज्ये “ज्ञानवादी” नावोअ माअहुंउं टोला वाअहीं मंडड़ीही तारास ओवतुतो. तें माअहें एहेलोह मानतेते के “ईसु खोरीज देव ओतू, पोन यी धरतीपोअ शरीरोम रोतुतो, तेहेलाम तो माहुंउं ने ओतू.” यीज गोठीइ वाखरी योहाने लेख्योहो के, ईसुउ जिवनोअ बाप्तिमेहें आंय सोताहा साक्शी होये, आन आंय तियाहा सोताअ आथो वाईं सापलीत पाल्युहू. ओं पत्र लेखीइलोअ योहानोअ उद्देश ओ होय के, तियाआ खुसी पुरी ओत जाय. <char style="xt"><ref loc="1JN 1:4">1 योहान 1:4</ref></char>, विश्वासी माहुंहूं पापोम रोत रुकीइलो काजेहे <char style="xt"><ref loc="1JN 2:1">1 योहान 2:1</ref></char> विश्वासी माहुंहूं ठोगोअ शिक्शणो रोत वासाड़ीलोअ काजेहे, आन तियांहां पाक्कू भरिवसू आपीइलो काजे लेख्यो. <char style="xt"><ref loc="1JN 5:13">5:13</ref></char></para>
  <para style="iot">रुपरेशा</para>
  <para style="io1">1. योहाने तियाआ पत्र आगाड़ी मिक्यो ओ आन काहा लेख्योहो तो देखाड्यो <char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">2. आन फाशुउ तो फोडीत कोतापेहे के देव केहेलुहू उजालो होस होय आन आपू बी येशुउ होस जिवन जिवुहूं जोवे. <char style="ior"><ref loc="1JN 1:5-3:10">1:5—3:10</ref> </char></para>
  <para style="io1">3. याअ फासाड़ी तो एका-बिहीराहा मेर कोए तेहें कोत ओर कोइत आपेहे <char style="ior"><ref loc="1JN 3:11-5:12">3:11—5:12</ref></char></para>
  <para style="io1">4. आध्याय <char style="ior"><ref loc="1JN 5:13-21">5:13-21</ref></char> यामेहें तो तियाआ पत्र लेखीइलो बंद कोअहे.</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">जिवनोअ वसन</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />तिया जिवनोअ वसनोअ बाप्तिमेहें, जो पेलरोत ओतो, जो आमू उनाअया, जो आमू सोताहा डोआ वाईं देख्यो, होव! जो आमू वारुंहूंज देख्यो आन आथो वाईं सापलीत पाल्यो. <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />तो जिवन देखाअयो आन आमू तियाहा देख्यो आन तियाआ साक्शी बी आपताहा, आन तुमुहूं तिया अमर जिवनोअ खबर कोताहा, जो आब्हाअरी ओतो आन आमुहूं देखाअयो. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />जो कि बी आमू देख्योहो आन उनाअयाहा तियाआ खबर तुमुहूं बी आपताहा. याअकाजे के, तुमू बी आमाअरी हेंगात बोणुहूं जोवे; आन आमाअ ए हेंगात आब्हाअरी आन तियाआ बेटाह्हा ईसु ख्रिस्त याअरी होय. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />आन आमाअ खुसी पुरी ओत जाय तेहें काजे ए गोठी आमू तुमुहूं लेखताहा.<verse eid="1JN 1:4" /></para>
  <para style="s">देव उजालो होय.</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />जे खबर आमू तियापोअ रोत उनाअया आन तेज तुमुहूं बी कोताहा ते ए होय के, देव उजालो होय आन तियामेहें जारिक बी आंदारो कायनाहां. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />जर तियाअरी बैठक होये एहें आपू कोतेय बी, पोन आंदाराम सालतेय, ताहां आपू ठोग होये, आन सत्यापोअ नाहां सालते. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />पोन, जर तो जेहें कोइत उजालाम सालेहे, तेहें कोइत आपू बी उजालाम सालो, ताहां आपू एकमेकाअरी बैठक मिकतेहे, आन तियाआ बेटुह्हू ईसुउ रक्त आपुहूं, आखा पापोम रोत सोको कोअहे.<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />जर आपू कोहूं के, आमू किज पाप नाहां कोअयू, ताहां सोताआ जिवोह ठोगतेहे आन, आपामेहें सत्य कायनाहां. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />जर आपू आपाअ पापोहों देवोअ हुंबर कबुल कोअहूं, ताहां तो आपाअ पाप माफ कोइलो आन आपुहूं आखा खाराब कामोम रोत सोको कोइलोअ काजे इमानदार आन धर्मी होय. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />जर आपू कोहूं के, आमू ते पाप नाहां कोअयू, ताहां आपू देवोहो लबाड़ ठरवीइतेहे, आन तियाआ वसन आपामेहें कायनाहां.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">ख्रिस्त आपाअ मदत कोअनारु</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />माआं मेराला पोर्‍या, आंय ए गोठी तुमुहूं याअकाजे लेखोहो के, तुमू पाप ने कोअहूं जोवे; आन जर एखू पाप कोए ताहां, देव आब्हाअ जागे एक वोग्यु होय, तो धर्मी ईसु ख्रिस्त होय; <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />आन तोज आपाअ पापोअ काजे गाराहा होये, फक्त आपाअ वोतीइ एतुज नाहां, पोने आखी दुन्याअ पापोअ काजे बी.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />जर आपू देवोअ आदेशोअ पालन कोअताहा, ताहां या पोअ रोत आपू जांअताहा के, आपू तियाहा ओलख्युहू. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />जो कोडू एहें कोहे के, “आंय तियाहा ओलख्युहू,” पोन तियाआ गोठी नाहां मानतु, तो ठोग होय, आन तियामेहें सत्य कायनाहां. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />पोन, जो कोडो बी तियाआ वसनोअ पुरमाणे सालेहे, तियामेहें खोराखर देवोअ मेर देखाअहे, या वाईं आमुहूं मुंदू जाहे के, आमू देवोअ हेंगातीम होय: <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />जो कोडो एहें कोतोय के, “आंय तियामेहें रोहो” ताहां तियाहा, जेहें कोइत ईसु ख्रिस्त सालतुतो तेहेंज कोइत सोताहा बी सालुहूं जोवे.<verse eid="1JN 2:6" /></para>
  <para style="s">नवू आदेश</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />माआं मेराला, आंय कोड्लू नोवू आदेश नाहां लेखतू, पोन तोज जुनू आदेश जो खूब आगाड़ी रोत तुमुहूं जोड़्युहू, ओ जुनू आदेश, तों वसन होय, जों तुमू पेल रोत उनाअयेहे. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />फाशुउ बी आंय तुमुहूं नोवू आदेश लेखोहो, आन ओ ख्रिस्तामेहें आन तुमामेहें खोरु ठरेहे; काहाके, आंदारो आरवाअतो जाहे आन सत्याआ उजालो सोमको वोल्योहो.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />जो कोडू एहें कोहे के, आंय उजालाम होय, आन सोताआ पायहोअ सीस कोअहे, तो ओमे बी आंदाराजमेहें होये. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />जो कोडो सोताआ पाव्हीइला पोअ मेर कोअतोय, तों उजालाम रोहे, आन तों नाहां ठोकात सेकतो. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />पोन, जों कोडो सोताआ पाव्हीइलाहा सीस कोअतोय तों आंदाराम सालेहे, आन का जाहे तों तियाहा नाहां मुंदू, काहाके, आंदारे तियाआ डोआ आंदला कोइत टाक्याहा.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />माआं पोर्‍यां, आंय तुमुहूं याअकाजे लेखोहो के, ख्रिस्ताआ नावोवाईं तुमाअ पापोअ माफी ओवीही. <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />ए डायहां, आंय तुमुहूं याअकाजे लेखोहो के, जो पेलरोत होय तियाआ तुमुहूं मुंदू होय. ए जुवान्या, आंय तुमुहूं याअकाजे लेखोहो के, तुमू तिया सैतानोहो हारवीइयुहू. ए पोर्‍यां, आंय तुमुहूं याअकाजे लेखोहो के, तुमू आब्हाहा ओलखीत लेदुहू.<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />ए डायहां, आंय तुमुहूं याअकाजे लेखोहो के जो पेल रोत होय, तियाहा तुमू जाईंत लेदुहू. ए जुवान्या, आंय तुमुहूं याअकाजे लेख्योहो के तुमू मजबुत होय, आन देवोअ वसन तुमाअ मांयते रोहे, आन तुमू तिया सैतानोहो जिकीत लेदुहू,<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />तुमू दुन्यापोअ आन दुन्यामेर्‍यीइ गोठीपोअ मेर मा कोअहा, जर एखु दुन्यापोअ मेर कोअतोय, ताहां तियामेहें देव आब्हाअ मेर कायनाहां. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />काहाके, जो किबी दुन्यामेहें होय मोन्ज्ये शरीरोअ लालस, लालसी नजर आन दुन्यादारीइ वोडाय, ओं देव आब्हाअ वोलेहे रोत कायनाहां, पोन ओं आखो दुन्याअ वोलेहे रोत होये. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />दुन्या आन तियाआ लालस बेनू आरवअते जातेहे, पोन जों देवोअ मोर्जीपोअ सालेहे तों हादाफल जिवे.<verse eid="1JN 2:17" /></para>
  <para style="s">ख्रिस्ताअ दुस्मोन</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />मेराला पोऱ्या, ए दुन्याअ आखरी वेल होय; आन जेहें कोइत तुमू उनाअयेहे के, ख्रिस्ताआ दुस्मोन आवनारु होये, तेहेंज कोइत वारुज ख्रिस्ताआ दुस्मोन ओमेज उठीत पोड़्याहा. या वाईं आपू जांअतेहे के ए दुन्याआ आखरी वेल होय. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />ते आपाजमेहें रोत निहींयात खोरा, पोन आपामेर्‍याआ ने ओता; काहाके जर ते आपामेर्‍याआ ओता, ताहां आपाअरी रोता; पोन ते याअकाजे निहींत गोया के, ते आखा आपामेर्‍याआ ने ओता ओं खोरो होय.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />पोन तुमापोअ ताम पवित्र आत्माआं अभिशेक तिया ख्रिस्तावाईं ओवुहू आन तुमू आखाहा खोरो कि होय तों जांआंत गोयोहो. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />आंय तुमुहूं याअकाजे नाहां लेख्यो के, तुमू सत्याहा नाहां जांअते, पोन याअकाजे के तियाहा जांअतेहे, आन याअकाजे कोड्लो बी खोटो सत्यापोअ रोत कायनाहां.<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />ठोग कोडू होय? फक्त तोज, जो ईसुहू “ख्रिस्त” एहें कोत नाहां मानतु आन तोज ख्रिस्ताआ दुस्मोन होय जो आब्हाआ आन बेटाह्हाअ नाकार कोअहे. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />जो कोडो बेटाह्हाअ नाकार कोअहे तियाअरी बाह्हू बी कायनाहां; जो बेटाह्हाहा मानित लेहे, तियाअरी बाह्हू बी होये.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />जो किबी सुरुवातिही रोत तुमू उनाअयेहे; तोज तुमामेहें रोअहूं जोवे; जो तुमू पेलरोत उनाअयेहे, तों जर तुमामेहें रोय ताहां तुमू बी बेटाह्हामेहें आन आब्हामेहें टिकीत रोहा, <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />आन जियाअ आथवसन तिये आपुहूं आप्योहो तों हादाफल्योअ जिवन होय.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />जें तुमुहूं फंअसाड़तेहें, तियांआं बाप्तिमेहें, ए गोठी मी तुमुहूं लेख्यीही. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />पोन तुमापोर्‍युउ तो अभिशेक जो ख्रिस्ते सोताआ आत्माम रोत तुमापोअ ओल्युतो, तो तुमाम रोहे; एखु तुमुहूं सिकाड़े तियाआ बी गरज कायनाहां, काहाके तियाआ आत्मामेर्‍युउ अभिशेक आखी गोठी तुमुहूं सिकाड़ेहे. तो जों सिकाड़ेहे तों खोरो होय, खोटो नाहां. आत्माआं हिकवोण मानतेहे ताहां तुमू ख्रिस्तामेहें टिकीत रोतेहे.<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />ताहां, माअ पोर्‍यां, तुमू तियाअरी जुड़ात रोवा, ताहां ख्रिस्त प्रगट ओवे तेहेलाम आपुहूं वोडी हिम्मत जोड़ुहूं जोवे आन तो प्रगट ओवे तेहेलाम आपुहूं लाज ने आवुहूं जोवे. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />तुमुहूं ताम मुंदूज होये के ख्रिस्त धर्मी होये, आन ओं बी तुमुहूं मुंदू होये के जो कोडो हाजो काम कोअहे तों देवोअ पोर्‍यो होये.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">देवोअ पोर्‍ये</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />आपुहूं देवोअ पोऱ्ये ओं नाव जोड़्योहो याम देव आब्हे आपापोअ केतीही मेर देखाड़्यिही तों पाला! आन खोरीज आपू तेहलेहे होयज बी. तिहीं वाईं दुन्या आपुहूं नाहां ओलखीइती, काहाके तियां देवोहो बी ने ओलख्यु. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />माआं मेराला पाव्हीइला, ओमे आपू देवोअ पोऱ्ये होय, आन ओमे जाआं ओं नाहां जी मुंदू के, आपू की रोहूं, पोन एतुहू मुंदू होय के, जाहां ख्रिस्त आवे, ताहां आपू बी तियाआ होस रोहूं, काहाके जेहलुहू तो होय, तेहलुन तेहलुज आपू तियाहा देखहूं. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />आन जिये कोडे बी आशा मिक्यिही, ख्रिस्त जेहलुहू सोकु होय, तेहेंज कोइत तो आपुहूं बी सोके कोअहे.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />जो कोडो बी पाप कोअहे, तों देवोअ नियम तोड़ेहे; काहाके पाप ताम देवोअ नियमोंअ विरुद्द होय. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />तुमुहूं मुंदू होय के, पाप उसलीत लेत जाअलोअ काजे ख्रिस्त प्रगट ओवू; आन तियाआ सोभावोम पाप कायनाहां. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />तिहीं वाईं जों कोडो ख्रिस्ताम जिवन जिवेहे तों पाप नाहां कोअतो. पोन जों कोडो पाप कोअहे, तिये नाहां केदिहीं तियाहा देख्यू के नाहां केदिहीं ओलख्यु.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />माअ पोर्‍यां, ठोगाअहा मा! जों कोडो हाजे कामे कोअहे, तों ख्रिस्ताआ होस धर्मी होय. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />पाप कोअनारो सैतानोअ वोगेहे रोत होय; काहाके सैतान सुरवातिही रोतीज पाप कोअतू आयुहू. सैतानोअ कामे आरवीत टाकीइलोअ काजे देवोअ बेटुह्हू आयू.<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />जों देवोअ पोऱ्यो होय, तों पाप नाहां कोअतो. काहाके देवोअ बीज तियामेहें रोहे; आन तों पाप कोअतीज नाहां सेकतो, काहाके तों देवोअ उब्ज्योहो. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />याज वाईं देवोअ पोऱ्ये आन सैतानोअ पोऱ्ये ओलखात जातेहे. जों कोडो हाजे कामें नाहां कोअतो तों देवोअ कायनाहां आन जों सोताआ पाव्हीइलापोअ मेर नाहां कोअतो, तों बी देवोअ माहुंउं कायनाहां.<verse eid="1JN 3:10" /></para>
  <para style="s">एकमेकापोअ मेर कोआ</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />जो संदेश तुमू वेगे रोत उनाअयेहे तो ओंज होय के, आपू एकमेकापोअ मेर कोअहूं जोवे. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />काइन तिया पाप्योअहीं रोत ओतू आन तिये सोताआ पाही हाबेलोअ खुन कोअयो, आपू तियाआ सारके ने बोणुहूं जोवे; आन तिये काहा कोत तियाआ पायहोअ खुन कोअयो? काहाके तियाआ कामे खाराब ओते, आन तियाआ पायहोअ कामे हाजे ओते.<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />माआं पाव्हीइला, जर दुन्या तुमाआं सीस कोअतीय ताहां पोंग्लाअहा मा. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />आपुहूं मुंदू होय के, आपू मोतोम रोत पार उनकीत जिवनोमेहें पोतीत गोयेहे, काहाके आपू आपाआ पाव्हीइलापोअ मेर कोअतेहे. जो कोडो मेर नाहां कोअतो तों मोतोजमेहें रोहे. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />जो कोडो पायहोअ नेत बोअह्हींइं सीस कोअहे तों खुनी होय; आन खुनी माअहूं पोअ अमर जिवन नाहां रोतो, ओं ते तुमुहूं मुंदूज होय. <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />तिये आपाआ काजेहे सोताआ जिव आपी देदू या वाअहीं आपू तियाआ मेर ओलख्यी; आन आपू बी आपाआ पाव्हीइलाआं काजे जिव आपुहूं जोवे. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />पोन आपामेऱ्याआ एखापोअ दुन्यादारीइ मालधन ओये, आन तों तियाआ पाव्हीइलाहां गरीब देखीत कीइमाय ने कोअतोय ताहां तियाम देवोपोअ मेर होये एहें कि कोइत कोत सेकतेहे? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />माआं पोऱ्या, आपाआ मेर शब्दा वाईं आन जिबी वाईं एतीज नाहां, पोन कामोवाअहीं आन सत्यावाअहीं बी मेर कोअहूं जोवे.<verse eid="1JN 3:18" /></para>
  <para style="s">देवोअ सामने हिम्मत</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />याज वाअहीं आपू ओलखाअहूं के आपू सत्याआ होय; आन जियी गोठीम आपाआ मोन आपुहूं दोशी ठरवे तियी गोठीम आपू देवोअ सामने सोताआ मोनोहो हिम्मत आपित सेकहूं. <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />काहाके जर आपाआ मोन आपुहूं दोशी ठरिवतोय ताहां देव आपाआ मोनो रोत वोडु होय आन तियाहा आखो मुंदू होय. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />मेराला दोस्तां, जर आपाआ मोन आपुहूं दोशी ने ठरवे ताहां, आपुहूं देवोअ सामने आविलोअ हिम्मत जोड़ेहे. <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />आन जों कि बी आपू मागतेहे तो आपुहूं जोड़ीत जाहे, काहाके आपू तियाआ आदेश मानतेहे आन तियाहा जो गोमेहें तोंज कोअतेहे. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />तियाआ आदेश ओज होय के आपू तियाआ बेटाह्हा ईसु ख्रिस्ताआ नावोपोअ विश्वास कोअहूं जोवे आन तिये आदेश आप्युहू तेहेंज कोइत एकमेकापोअ मेर कोअहूं जोवे. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />जों देवोअ आदेशोअ पालन कोहे तों देवोअरी रोहे, आन देव तियाअरी रोहे. आन तिये जो पवित्र आत्मा आपुहूं आप्युहू तिया वाअहीं आपुहूं मुंदू जाहे के देव आपाअरी रोहे.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">आत्मे फारकीत पाला</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />माआं मेराला दोस्तां, आखाज आत्माआं विश्वास मा कोअहा, पोन तें देवोअ वोलेहे रोत होय के नाहां तों फारकीत पाला; काहाके वारुज ठोग भविश्यवक्ता दुन्याम उठीत पोड़्याहा. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />देवोअ आत्माहां तुमू एहेंकोइत ओलखीत सेकतेहे के; जो भविश्यवक्ता ईसु ख्रिस्त माअहोंअ रुपोम आयुहू आन तो देवोअ वोलेहे रोत होय एहें कोत मानित लेहे, तियाम देवोअ आत्मा होय. <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />पोन जे आत्मा ईसुहू नाहां मानती, ते देवोअहें रोत कायनाहां; आन तेज ताम ख्रिस्ताआ दुस्मोन आत्मा होय. याआ बाप्तिम तुमू होंबलीत सुकेहे के, ते आवनारी होय, आन ते ओमेज बी यी दुन्याम होय.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />पोन माआं मेराला पोऱ्या, तुमू देवोअ होय, आन तुमू तियां आत्माहां हारवी देदेहे; काहाके जो आत्मा तुमामेहें होय, तो दुन्याम जो होय, तिया रोत जाअखु वोडू होय. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />तें आत्में दुन्याआ होय, तियाहा कोत तें दुन्यादारीइ गोठी कोतापतेहे, आन दुन्या तियांआं गोठी उनाअतिही. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />पोन आपू ताम देवोअ होय, जों कोडो देवोहो ओलखेहे तों आपाआ गोठी होंबलेहे; जो कोडो देवोहो नाहां ओलखीइतो, तों आपाआ गोठी नाहां होंबलीइतो. ताहां यावाईं आपू सत्याआ आत्मा आन ठोग आत्माहां ओलखीत सेकतेहे.<verse eid="1JN 4:6" /></para>
  <para style="s">देव मेर होय</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />मेराला दोस्तां, आपू एकमेकापोअ मेर कोअहूं जोवे, काहाके मेर देवोअहें रोत होय. जों कोडो मेर कोअहे, तों देवोअ उबज्योहो आन तों देवोहो ओलखेहे. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />जों मेर नाहां कोअतो तों देवोहो नाहां ओलखीइतो, काहाके देव मेर होय. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />देवे तियाआ एखलु बेटुह्हू यी दुन्याम मोकल्युहू, तो याअ काजे काहाके आपुहूं तिया वाईं अमर जिवन जोड़ुहूं जोवे. एहें कोइत तिये आपापोअ मेर देखाड़्यिही. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />आपू देवोपोअ मेर कोअयी एहलोहो नाहां, पोन तिये आपापोअ मेर कोअयी आन आपाआ पापोअ वोतीइ गाराहा कोत तियाआ बेटाह्हाहा मोकल्यू; याजमेहें खोरी मेर देखाअहे.<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />मेराला दोस्तां, जाहां देवे आपापोअ एहेंकोइत मेर कोअयी, ताहां आपू बी एकमेकापोअ मेर कोअहूं जोवे. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />देवोहो आज कोडे केदिहींज नाहांजी देख्यू; जर आपू एकमेकापोअ मेर कोअहूं ताहां देव आपाम रोहे, आन तियाआ मेर आपामेहें पुरो ओवेहे.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />इंहींज वाईं आपुहूं समजाअहे के देव आपामेहें रोहे आन आपू तियामेहें रोतेहे; काहाके तिये सोताआ आत्मा आपामेहें मिक्युहू. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />आन आमू देखीत बी लेदुहू आन साक्शी बी आपताहा के देव आब्हे तियाआ बेटाह्हाहा दुन्याआं तारनारु कोत मोकल्युहू. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />जो कोडो “ईसु देवोअ बेटुह्हू होय” एहें कोत कबलेहे, तियाअरी देव रोहे आन तों देवोअरी रोहे.<verse eid="1JN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 4:16" />आपापोअ देवोअ मेर केतीही तों आपू ओलख्योहो, आन तियी मेरेपोअ आपाआ भरिवसू होय.</para>
  <para style="p" vid="1JN 4:16">देव मेर होय, आन जों मेरेम जिवेहे तों देवोअरी रोहे आन देव तियाअरी रोहे. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />यावाअहीं आपामेहें मेर पुरी ओवीही, तों याअ काजे के न्यायनिवाड़ु ठरवीइलोअ दिही आपाम हिम्मत रोअहूं जोवे; काहाके जेहेंकोइत ख्रिस्त होय तेहेंज कोइत आपू बी यी दुन्याम होय. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />मेरेम बिक नाहां रोती; हारीपुरी मेर बिकुज काडीत टाकेहे; काहाके बिक रोयी ताहां डोंड जोड़ेज ओ विसार रोहे, आन बिकऱ्यो माहुंउं मेरेम पाक्को नाहां ओवो. <verse eid="1JN 4:18" /><verse number="19" style="v" sid="1JN 4:19" />पेल देवे आपापोअ मेर कोअयी, तिहींइं काजे आपू मेर कोअतेहे. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />जर एखु कोय, “आंय देवोपोअ मेर कोअहो,” पोन तियाआ पायहोअ सीस कोअतोय ताहां तों ठोग होय; जर तों तियाआ सामने देखाअनारा पायहोपोअ मेर ने कोअतोय, ताहां तों तियाआ सामने ने देखाअनारा देवोपोअ की कोइत मेर कोइत सेकेहे? <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />जों कोडो देवोपोअ मेर कोअतोय तों तियाआ पाव्हीइलापोअ बी मेर कोअहूं जोवे, ओ ख्रिस्ताआ आदेश होय.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">विश्वासोवाईं दुन्यापोअ आपाआ जीत</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />“ईसु ओज ख्रिस्त होय” एहेलुहू जियाआ विश्वास होय तोंज देवोअ उबज्योहो. जों कोडो आब्हापोअ मेर कोअहे तों तियाआ पोर्‍यापोअ बी मेर कोअहे. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />जाहां आपू देवोपोअ मेर कोअतेहे आन तियाआ आदेश मानित लेतेहे, ताहां यावाअहीं आपुहूं होमजाअहे के आपू देवोअ पोऱ्यापोअ मेर कोअतेहे. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />देवोपोअ मेर कोइलो अर्थ होय तियाआ आदेश पालन कोइलो; आन तियाआ आदेश कठीण कायनाहां. <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />काहाके जों कोडो देवोअ उब्ज्योहो तों दुन्याहां जिकीत लेहे आन जिहीं वाअहीं आपू दुन्याहां जिकतेहे तो आपाआ विश्वास होय. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />दुन्याहां कोडो हारवीत सेकेहे? फक्त तोज माहुंउं जों एहेंकोइत विश्वास कोअहे के, “ईसु ओज देवोअ बेटुह्हू होय.”<verse eid="1JN 5:5" /></para>
  <para style="s">ईसु ख्रिस्ताआ बाप्तिमेहें साक्शी</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />ओ तोज होय जो पाअयोंवाईं आन रक्तावाईं आयुतो; मोन्ज्ये ईसु ख्रिस्त; पाअयोंवाअहीं एतुज नाहां पोन, पाईं आन रक्तावाअहीं आयुतो. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />आन जो साक्शी आपेहे, तो आत्मा होय; काहाके आत्मा सत्य होय. <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />साक्शी आपनारे तिनू होय, आत्मा, पाईं आन रक्त; तिनू बी एक हारकी साक्शी आपतेहे. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />आपू माहुंउं साक्शी मानित लेतेहे, पोन देवोअ साक्शी तिया रोत जाअखी खोरी होये; आन देवोअ साक्शी ए होय के, तिये तियाआ बेटाह्हाअ बाप्तिमेहें साक्शी आप्यीही. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />जों देवोअ बेटाह्हापोअ विश्वास मिकेहे तियाआज मोनोमेहें साक्शी होय. जिये देवोपोअ विश्वास ने कोअयू, तिये देवोहो ठोग समजीइयुहू, काहाके जे साक्शी देवे तियाआ बेटाह्हाअ बाप्तिमेहें आप्यीही तियीपोअ तिये विश्वास ने कोअयू. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />आन ते साक्शी ए होय के, देवे आपुहूं अमर जिवन आप्योहो आन ओं जिवन तियाआ बेटाह्हाम होय. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />जियाहा देवोअ बेटुह्हू जोड़्युहू तियाहा जिवन जोड़्योहो; आन जियाहा देवोअ बेटुह्हू ने जोड़्यू तियाहा जिवन ने जोड़्यो.<verse eid="1JN 5:12" /></para>
  <para style="s">अमर जिवन</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />देवोअ बेटाह्हाअ नावोपोअ विश्वास मिकनारा तुमापोअ अमर जिवन होय, ओं तुमुहूं समजाअहूं जोवे कोत आंय तुमुहूं ओं लेखोहो. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />आन आमुहूं देवोपोअ भरिवसू होय, काहाके, तियाआ मोर्जीपोअ जों किबी आपू मागतेहे, ताहां तो आपाअ गोठ उनाइत लेहे. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />जेताआ बी आपू मागतेहे, आन जों बी मागतेहे ताहां तो आपाअ उनाइत लेहे, तेहेलोज आपुहूं ओं बी मुंदू होय के, जों किबी आपू तियापोअ रोत माग्योहो तों जोड़्योहो.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />जर एखा विश्वासीही एहेलुहू पाप कोअत्लो देखहा, जियाअ फल मोत कायनाहां, ताहां देवोहो प्रार्थना कोअहूं जोवे मोन्ज्ये देव तियाहा जिवन आपे; जियाआ पापोअ फल मोत ने ओय तियाहाज ओं लागू पोड़ेहे. पोन, एहेलुहू बी पाप होय जियाआ फल मोत होय, एहेलाआं काजे तुमू देवोहो प्रार्थना कोअजा एहें आंय नाहां कोतू. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />आक्खी जातीइ खाराब कामे ताम पाप होय, पोन एहेलाहा बी पाप होय के, जियाअ फल मोत कायनाहां.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />आपुहूं मुंदू होय के, जों देवोअ पोऱ्यो होय तों पाप नाहां कोअतो; काहाके, देवोअ बेटुह्हू तियांहां वासाड़ीत मिकेहे. आन सैतान तियाहा आथ नाहां लागाड़ीत सेकतु.<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />आपुहूं मुंदू होय के, आपू देवोअ होय, आन पुरी दुन्या तिया खाराबोअ ताबाम होय.<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />आन आपुहूं ओं बी मुंदू होय के, देवोअ बेटुह्हू आवित लागुहू आन तिये आपुहूं एहलीही ओकल आप्यीही, के आपू तिया खोरला देवोहो ओलखीत सेको, आन आपू जें तिया खोरला देवोमेहें रोतेहे मोन्ज्ये देवोअ बेटाह्हा ईसु ख्रिस्तामेहें रोतेहे. ओज खोरलु देव आन तोज अमर जिवन होय.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />माआं पोऱ्या, तुमू सोताहा मुर्तीपुजा रोत सेटे रोजा.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>