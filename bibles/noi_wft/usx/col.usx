<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Noiri</book>
  <para style="h">कलस्से</para>
  <para style="toc3">कलस्से</para>
  <para style="toc2">कलस्से</para>
  <para style="toc1">कलस्सेवालाहां प्रेशित पौलुसोअ पत्र</para>
  <para style="mt2">कलसैकरास प्रेशित पौलाचे पत्र</para>
  <para style="mt1">कलस्सेवालाहां प्रेशित पौलुसोअ पत्र</para>
  <para style="imt">ओलखात</para>
  <para style="ip">ओं पत्र प्रेशित पौलुसे लेख्योहो <char style="xt"><ref loc="COL 1:1">1:1</ref></char> तिये ओं पत्र एक आंदास ख्रिस्त जल्माआं 60 वोऱ्ह्योंअ फाटी रोमोमेऱ्यीइ जेलेम ओतु तेहेलाम लेख्यो. कलस्सेए पत्र ओं फिलिप्पी आन फिलेमोन या पत्राआ होसुज जेलेम रोत लेखाअयोहो, आन तिहींवाईं यां पत्राहा “जेलाऱ्ये पत्रे” बी कोतेहे. पौलुसे ओं पत्र कलस्से होयरोअ मंडड़ीही लेख्यो. कलस्सेए मंडड़ी तिये नाहां थापन कोअयी, जेहलोहो <char style="xt"><ref loc="COL 2:1">2:1</ref></char> मेहें कोयोहो, पोन मंडड़ीइ थोड़ीक जाबाबदारी तियाहा लेंव लागी. ए मंडड़ीही एपफ्रासे थापन कोअयीही एहेलुहू आंदास होये, काहाके एपफ्रास तिहींवालू ओतु.</para>
  <para style="ip">पौलुसे थोड़ाक खोटा शिक्शकोअ बाप्तिम कलस्सेए मंडड़ीही सुसना आप्यी. तिये जास्ती कोइत खोटी हिकवोण आपनाराआं बाप्तिम पत्रे लेख्येहे. तिहीं वारुज यहुदी विश्वासी माहें ओते जें बाकी विश्वासी पाव्हीइलाहां यहुद्याआं जुनू करार पालन कोए तेहें काजे दाबाव टाकतेते. जिहींमेहें खतना कोइलो, बिगर यहुद्याअहीं रोटू ने खाअलो एहलोहो ओतो. खास कोइत पौलुस ओं लेखेहे के, जिये ख्रिस्ताहा स्विकारित लेदो, तियाहा देव स्विकार कोअहे, या रोत वादार एतोहो महत्वाआ विश्वासीइ काजे बिहीरो किज कायनाहां.</para>
  <para style="iot">रुपरेशा</para>
  <para style="io1">पौलुस कलस्सेवाली मंडड़ीही सलाम कोअतुज पत्राआ सुरवात कोअहे <char style="ior"><ref loc="COL 1:1-2">1:1-2</ref></char></para>
  <para style="io1">तिहीं रोत तो खास कोइत खोटा शिक्शणोअ विरुद्दाम उत्तर आपीइलोअ काजे ख्रिस्ताआ महानता कोत देखाड़ेहे <char style="ior"><ref loc="COL 1:3-3:4">1:3—3:4</ref> </char></para>
  <para style="io1">पौलुसे एहेलेहे वारुज पत्रे लेख्ये जिहींम तिये खोरो विश्वासी जिवन जिवीइलोअ काजे खास मार्गदर्शन आप्यो. <char style="ior"><ref loc="COL 3:5-4:6">3:5—4:6</ref> </char></para>
  <para style="io1">पौलुस या पत्राहा मंडड़ीम जोरेज वासित देखाड़ीइलोअ सुसना आपेहे आन सलाम कोइत पत्रलेखन बंद कोअहे <char style="ior"><ref loc="COL 4:7-18">4:7-18</ref> </char></para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="s">सलाम</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />पौलुसोअ वोगेहे रोत, जो देवोअ मोर्जी वाअहीं ख्रिस्त ईसुउ प्रेशित होय, आन ख्रिस्तामेहें आपाआ पाही तिमथ्याआ वोगेहे रोत,<verse eid="COL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2" />ख्रिस्तामेहें तियां देवोअ माअहों आन इमानदार पाव्हीइलाआ नावे जे कलस्सेमेहें रोतेहे:</para>
  <para style="p" vid="COL 1:2">आपाआ देव आब्हाअहीं रोत तुमुहूं मेरवानी आन होक मिलतू रोये.<verse eid="COL 1:2" /></para>
  <para style="s">धन्यवादोअ प्रार्थना</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />आमू तुमाआं कोअते हमेशा प्रार्थना कोइत आपाअ मालिख ईसु ख्रिस्ताआ बाह्हाआ मोन्जे देवोअ धन्यवाद कोअताहा, <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />काहाके आमू उनाअयाहा के ख्रिस्त ईसु पोअ तुमाआं विश्वास होय, आन आखा देवोअ माअहूं पोअ तुमू मेर कोअताहा; <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />तुमाआ काजे होरगाम मिकल्यी आशा बाप्तिम तुमू हाजी बातमी वाईं सत्यवसनोम उनाअये. <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />जे तुमाआं जागे पोत्यीही, आन जेहें कोइत दुन्याम बी फल लेतावेहे आन वादतो जाहे, तेहेंज कोइत जेदिहीं रोत तुमू तियाहा उनाअये आन खोरा मोनोवाअहीं देवोअ मेरवानी ओलख्यीही, तुमामेहें बी एहेंज कोइत कोअहे. <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />तियाआज शिक्शण तुमू आमाअ मेरालू हाती एपफ्रासोपोअ रोत सिकाअये, जो आमाअ काजे ख्रिस्ताआ इमानदार सेवक होय.<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 4:12">कलस्से 4:12</ref>; <ref loc="PHM 1:23">फिले 23</ref></char></note> <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />तियेज तुमाआं मेरेहे जे आत्मामेहें होय आमापोअ देखाड्यी.<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />तियाहाज काजे जेदिहीं रोत ओं उनाअयाहा, आमू बी तुमाअ काजे प्रार्थना आन रावण्‍या कोइलाआ नाहां सोड़ता, के तुमू आक्खी आत्मिक ज्ञान आन बुद्दीइरी देवोअ इश्शाआ ओलखातीमेहें पाक्के ओत जावा. <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />काहाके तुमू प्रभुहू पोटे एहलोहो जिवन जिवुहूं जोवे, आन तों आखी गोठीमेहें खुस कोए एहलोहो जोवे, आन तुमामेहें हारेक जातीइ हाजा कामोंअ फल लागुहूं, आन तुमू देवोअ ओलखातीमेहें वादते जावा. <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />तियाआ महिमाअ सेक्तीइ होसे आखी जातीइ ताकतोवाअहीं मजबुत ओवते जावा, एतेहे जाआं के खुसीइरी हारेक जातीइ धिरोवाईं आन सहनसेक्ती देखाड़ीत सेकहा. <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />आन खुसी वाअहीं देव आब्हाआ धन्यवाद कोअते रोवा, जिये आपुहूं याआ लायकी बोणावया के उजवड़, पवित्र माअहुंउं आरी वाटामेहें सामील ओवे. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />तियेज तोम आपुहूं आंदाराआ राजोम रोत सोड़वीत तियाआ मेराला बेटाह्हाआ राजोम पोताड़्याहा, <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />आन तियामेहें आपुहूं सुटका मोन्ज्ये पापोअ माफी मिल्‍यीही<verse eid="COL 1:14" /></para>
  <para style="s">ख्रिस्त आन तियाआ कामे</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />ख्रिस्त तोम ने देखाअनारा देवोअ रुप आन आखी कोलीमेएं पेल्लूउ होय. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />काहाके तियाजमेहें आखी वस्तु बोण्यी, होरगाआ ओय नेत धरतीइ, देखाअनारी ने देखाअनारी, तियामेहें आत्मिक सेक्ती, राजगादी, राज कोअनारा आन आधिकारी. देवे आखी दुन्या तियाज वाअहीं आन तियाआज काजे बोणावयीही. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />तोज आखी वस्‍तुमेहें रोत पेलठू होय, आन आखी वस्तू तियामेहें टिकीत रोयीही. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />ख्रिस्त ओज डिल, मोन्ज्ये मंडड़ीइ मुंड होय; तोज पेलठू होय, आन मोअल्यामेहें रोत जिवीत उठनाराम पेलठू आन आखी गोठीमेहें पेल्लुउ जागू तियाहाज जोड़ुहूं जोवे. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />काहाके बाह्हाअ खुसी यामेहें होय के, बेटाह्हामेहें आखी गोठी भारपुर रोय. <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />होरगामेर्‍यीइ आन धरतीपोर्‍यीइ आखी वस्तु तियाआ वोगेहे आवुहूं जोवे, तियाहा काजे तियाआ बेटेह्हे सोताआ मोतोवाअहीं जो कोअयो तियावाअहीं एक वाट तियार कोअयी आन तियी वाटीइ वोजेसे, क्रुस पोर्‍याआ तियाआ मोतोवाअहीं आन तियाआ वोहल्‍या रक्तावाअहीं आखाआ सबंध मिठो ओत गोयो.<verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />एक वेल एहेलिही ओती के तुमू देवोअरी पारके जेहें ओते, आन तुमाअ खाराब कामोअ वाखरी मोनोवाअहीं तियाआ दुस्मोन जेहें ओते. <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />पोन ओमें, देवे तियाआ बेटाह्हाअ मोतोअ गाराहा वाअहीं तुमुहूं तियाआ दोस्ती बोणावयाहा, याअकाजे के तियाआ सामने पवित्र, सोका, आन निर्दुस जेहें मिकीत सेके. <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />पोन तुमू विश्वासोम मजबुत रोअहूं जोवे: आन तियी हाजी बातमीइ आशा जे तुमू उनाअयेहे ते मा सोड़हा. आन जे हाजी बातमी जुगोअ थुड़ते पुरी कोलीइ माअहुंहूं उनाइलोअ सान्सो जोड़्योहो, तियीइ आंय पौलुस सेवक बोण्‍युहूं.<verse eid="COL 1:23" /></para>
  <para style="s">मंडड़ीइ सेवक पौलुस</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />पोन तुमाअ काजे दुख वेठीइलोअ कोअते आंय खुस होय काहाके ख्रिस्ते तियाआ डिलोअ कोअते मोन्ज्ये मंडड़ीइ कोअते जो दुख वेठीइलोअ काजे बाकी उगरीइयोहो तों माआ डिलोमेहें पुरो कोअहो. <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />आन आंय देवोअ वोलेहे रोत मंडड़ीइ सेवक बोणावाअयुहू जिये माहूं ओं काम कोए तेहें काजे होप्योहो. <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />जे दोड़पाअली गोठ खुब वेगी रोत आन पिढ़ीन-पिढ़ी रोत निकाड़ीत मिक्यीते, पोन ओमें तियाआ माअहुंहूं उगाड़ीत देखाड़ल्यी होय, ते ओं देवोअ वसन होय. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />देवोअ योजना एहलिही होय के तियाआ माअहें तियाआ दोड़पाअली गोठीइ किम्मत बिहीरा माअहोंअ काजे की होय ते जाईंत सेके, आन महिमाआ आशा मोन्जे ख्रिस्त ओज ते तुमामेहें दोड़पाअली गोठ होय. <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />तियाहाज काजे आमू ख्रिस्ताआ परसार आखाहा कोअताहा, कड़क जिबानी वाईं कोताहा आन हारेक जोओंहों पुरी गोठी मुंदू कोइत कोताहा, एताआ काजे के आखा माअहुंहूं पाक्के कोइत उबो कोइत सेको. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />यींज गोठीइ काजे पाक्को मोन आन ताकत लागाड़ीत कोइत मेहेंनत कोअहो, काहाके तियाआ ताकतोअ पुरमाणे जे मामेहें सेक्तीवाईं जोर देहे.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />आंय तुमाअ काजे लौदीकिया मेहें रोनारां माअहोंअ काजे आन तियां आखाआ काजे जियां माअ सोब नाहां देख्यी, बिहीराअ काजे आंय केतीही मेहेंनत कोअहो ओं तुमुहूं मुंदू पोड़ुहूं जोवे ए माआं इश्शा होय. <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />ते मेहेंनत एताआ काजे के तियाआ मोन हिम्मतो वाअहीं पोआत मेरे वाअहीं एकान बिहीराअरी बांदाइत जाय आन ते बादी ओकलेए आखी मिलती मिलवुहूं जोवे, आन देवोअ दोड़पाअली गोठ मोन्जे ख्रिस्ताहा ओलखीत लेअहूं जोवे. <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />जियाम बुद्दीइ आन ज्ञानोअ धन निकात रोयोहो.<verse eid="COL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4" />ओं आंय याअकाजे कोहो के कोड्लो बी माअहुंउं तुमुहूं हाद आवनारी गोठी वाअहीं तारास ने देअहूं जोवे. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />आंय डिलो वाअहीं तुमाअ रोत सेटे होय, तेबी आत्मा वाअहीं तुमाअ आहने होय, तुमाआं हाजी हुतायीइ जिवन आन तुमाआं ख्रिस्तापोर्‍युउ पाक्कू विश्वास देखीत कोइत खुस होय.<verse eid="COL 2:5" /></para>
  <para style="s">ख्रिस्तामेहें पोआलो जिवन</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />ताहां जेहेंकोइत तुमू ख्रिस्ताहा देव कोत स्विकार कोअयोहो, एहेंज कोइत सालते रोवा. <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />आन याजमेहें मुल टाकीत वातड़े बोणते जावा, आन जेहेंकोइत तुमू सिकाअयेहे तेहेंज कोइत विश्वासोम मजबुत ओवते जावा, आन वादारेन वादार धन्यवाद कोअते रोवा.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />जे ओकलेए गोठी ख्रिस्ताआ हिकवणोअ परमाणे कायनाहां पोन माअहुंउं विसारो परमाणे आन दुन्याहां गोमे एहेलिही गोठीइ परमाणे होय, एहेलिही कावली आन ठोगोअ ओकलेए गोठीम रोत सांबालित रोवा. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />काहाके ख्रिस्तामेहें देवोअ आखा गुण सोभाव तियाआ डिलोमेहें रोताहा. <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />आन तुमुहूं तियाआ एकीमेहें पुरो जिवन जोड़ीत गोयोहो, तोज आखा राजाआ आन आधिकारोअ मुख्य होय.<verse eid="COL 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 2:11" />तियाजमेहें तुमाआं एहेलुहू खतना कोअयुहू जो आथोवाईं नाहां ओवतु, मोन्ज्ये ख्रिस्ताआ खतना, जिया वाअहीं पापी सोभाव निहींत जाहे, <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />आन ख्रिस्‍ताअरीज बाप्तिस्मा मेहें बुडीत गोये, आन तियाजमेहें देवोअ सेक्तीपोअ विश्वास कोइत, जिये तियाहा मोल्यामेहें रोत जिवाड़्यु, तियाअरीज जिवित बी उठ्ये. <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" /><note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EPH 2:1-5">इफिस 2:1-5</ref></char></note>देवे तुमुहूं बी, जे सोताआ पापो वाअहीं आन बिगर यहुदीइ दशामेहें मोल्‍ये ओते, तियाअरी फाश्येए जिवाड़्ये, आन आपाआ आखा गुनाआं माफी कोअयी, <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />देवे आपाअ विरुद्दामेर्‍युउ लेखाअलु इसाब तियाआ यादीमेहें रोत खुड़ीत टाक्‍यू आन तियाहा क्रुसोपोअ खिलावाईं ठोकीत कोइत सामने रोत सेटे कोइ देदू. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />आन एहें कोइत तिये ताबाम कोअनाराहां आन आधिकार्‍योहों नाड़ीत कोइत तियांआं विरुद्दाम क्रुसोपोअ जिकीत कोइत आखाआ सामने अपमान कोअयू.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />तियाहा काजे खाअलो-पीइलोअ बाप्तिमेहें, नेत तिवार, नेत नोवाआ तिवार, नेत आरामोअ दिहोअ बाप्तिमेहें कोडाहा मा ठरवुहूं देहा. <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />काहाके ए तोम आखी आवनारी गोठीइ सावलू ओतू, पोन मुख्य गोठी तोम ख्रिस्ताआ होय. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />तुमू सोताहा ठोगाइत देवदुतोअ हुंबर वोंदे आन तियांआं पागे पोड़े मा जाहा, आन ख्रिस्तामेर्‍यीइ देवोअ खुसी रोत सेटे मा जाहा, एहेलोह माहुंउं माहूं दर्शन जोड़ल्‍यो एहें कोत्लो, आन तियाआ दुन्‍यादारीइ मोन दुन्‍यादारीइ विसारोवाअहीं फुगवी देहे. <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />आन डिलोअ खास भाग मुनको होय, जो ख्रिस्त होय तियाहाज नाहां तोइत रोतो, जियावाअहीं पुरो डिल मोणक्‍या आन गुड़्या वाअहीं वोदतो आन देवोअ इश्शामेहें मजबुत ओवतो जाहे.<verse eid="COL 2:19" /></para>
  <para style="s">जिवीइलो- मोइलो ख्रिस्ताअरी</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />तुमू ख्रिस्ताअरी मोइत गोयेहे आन दुन्यापोअ राज सालाड़नारा आत्मा रोत सुटका मिलीत गोयीही, ताहां काहा यी दुन्‍यादारीइ होस जिवन जिवतेहे? एहेलिही रुढ़ी लेत काहा सालत्ले <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />“याहा ने टेकीइलो” आन “फोलाहा ने साकीइलो” आन “तियाहा आथ ने लागाड़ीइलो?” <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />ए आखी गोठी कामोमेहें लेत आवता लेत आवता आरवाइत जाये, काहाके ए माअहुंउं राजोअ गोठी आन हिकवोणोअ पुरमाणे होय. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />यीं रुढ़ी मेहें तियांआं सोताआ मोर्जी वाअहीं भक्ती कोइलोअ रिती, देवदुतोअ आन खोतरीइ पुजा कोइलो, आन डिलोहो तारास देअलोअ ओकलेए गोठ होय कोत मानताहा खोरा, पोन डिलोअ इश्शा रुकीइलोमेहें तियां वाअहीं किज फायदू ने ओवत्लू.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />तियाहा कोत तुमू ख्रिस्‍ताअरी फाशेए जिवित उठ्येहे ताहां, तुमाअ मोन होरगाआ गोठीइहें लागाड़ा, जिहीं ख्रिस्त देवोअ हाजाड़्या आथोअ वोलेहे तियाआ राजगादी पोअ बोठुहू.<note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन 110:1</ref></char></note> <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />धरती पोर्‍यीइ नाहां पोन होरगाआ गोठीपोअ मोन लागाड़ा, <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />काहाके तुमू ते मोइत गोये आन तुमाअ जिवन ख्रिस्ताआ आरी देवोमेहें निकात रोयोहो. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />ताहां ख्रिस्त जो तुमाअ जिवन होय, तो देखाये, तेहलाम तुमू बी तियाअरी महिमामेहें देखाअहा.<verse eid="COL 3:4" /></para>
  <para style="s">जुनो आन नवो जिवन</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />तियाहाकोत आपाअ या शरीर सोभावोहो माइत टाका, जे तुमामेहें काम कोअताहा, मोन्ज्ये सिनालोअ कामे, एठे कामे, खाराब कामे, घाण इश्शा आन लोभ जो मुर्तीपुजाअ होसुज होय.<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">नेते मुर्तीपुजा होय</char></note> <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />यींज गोठी वाअहीं आदेश ने माननारापोअ देवोहो खोत लागत्ली. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />आन तुमू बी, जेहेलाम यीं खाराब गोठीमेहें जिवतेते ताहां तेहेंज कोइत सालतेते.<verse eid="COL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8" />पोन ओमे तुमू बी खोत कोइलो, जाअखो खिजवाइलो, सीस कोइलो, रोवा कोइलो आन सोबीवाअहीं गाई देअलो ए आक्खी गोठी सोड़ी द्या. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />एकमेकाहा ठोगहा मा, काहाके तुमू जुना सोभावोहो तियाआ सोवायीइरीज काडीत टाक्युहू.<note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="EPH 4:22">इफिस 4:22</ref></char></note> <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />आन नोवा सोभावोहो पोवित लेदुहू, जो आपाअ बोणावनाराआ रुपोअ होसूज ज्ञानोमेहें नोवू बोणतु जाहे. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />तियामेहें ने कोडू युनानी ने यहुदी, ने खतनावालु के ने बिगर खतनाआ, ने रानठ्यु के, ने स्कुथी, ने बांदाअलू के ने सुटलू, फक्त ख्रिस्तज आखो आन आखाजमेहें होय.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />तियाहा कोत तुमू जें देवोअ निवड़ीइल्याअ होस, पवित्र आन मेराले माहें होय, तुमू वोडी माया, आन हाजली गोठी, आन हानालाय, आन सहनसेक्ती याहां पोवित ल्या. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />जर कोडाहा एखापोअ आरोप लागाड़ुहूं जोगिही काविहीं गोठ ओय, तेबी एकमेकाहा वेंडारीत ल्या, आन एकमेकाआ सुकी माफ कोइ द्या, जेहें कोइत देवे तुमुहूं माफ कोअयेहे तेहेंज कोइत तुमू बी माफ कोआ.<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EPH 4:32">इफिस 4:32</ref></char></note> <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />यां रोत बी जाअखो मेर ओं एक एहेलोह बंधन होय, जों आपुहूं पाक्के बोणावेहे याहा पोवित ल्या. <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />ख्रिस्ताआ होक तुमाआं मोनोम राज कोअहूं जोवे, जियाअ कोअते तुमुहूं देवे एकठेज हाद्येहे; आन तुमू आभार मानते रोवा. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />ख्रिस्ताआ वसनोहो तुमाअ मोनोम वादार वोहती कोअहूं द्या, आन पुरी ओकोल देत कोइत एकमेकाहा हिकाड़ा आन मुंदू काडीत आपा, आन जिव जिवोअ मोनोमेहें धन्यवाद कोअतेज, देवोअ काजे भजने आन स्तुतीइ गिते आन आत्मिक गिते गावा. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />आन तुमाआं गोगीइलो मेहें नेत कामोमेहें जों किबी कोअहा, तों बादो प्रभु ईसुउ नावो वाअहीं कोआ, आन तिया वाअहीं देव बाह्हाआ आभार माना.<verse eid="COL 3:17" /></para>
  <para style="s">नवा जिवनोअ कुटूंबाअ नियम</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />ए बोईं, जेहें कोइत प्रभुमेहें ठीक होय, तेहेंज कोइत जिव जिवोअ माट्योअ ताबाम रोवा.<verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />ए माट्यों, तुमू जिवज्योअ बोईंपोअ मेर कोआ, आन तियांअरी जोराखा मा वागहा.<verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />ए पोर्‍यां, तुमू जिव जिवोअ आयहीन आब्हाआ गोठी माना, काहाके ओं देवोहो गोमेहें.<verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />ए पोर्‍यावालां, जिव जिवोअ पोर्‍याहां खिजवाहा मा, नेत तियांआं हिम्मत टुटीत सेकेहे.<verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />ए नौकरों, मोनवीम जो तुमाअ मालिख होय, तियांआं बादी गोठीम आखा आदेश माना, माअहुंहूं देखाड़ीइलो काजे मा, पोन खोरा मोनो वाअहीं देवोअ बिकेवाअहीं तियांआं आदेश माना. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />जों किबी तुमू कोअहा तों पुरा मोनोवाअहीं कोआ, एहेलोहो समजीत कोआ के माअहुंउं काजे नाहां, पोन देवोअ काजे कोअताहा; <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />काहाके याअ बोदले तुमुहूं मालख्योपोअ रोत बक्शीस जोड़े ओं तुमुहूं मुंदू होय; तुमू मालिख ख्रिस्ताआ सेवा कोअता रोवा. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />काहाके जो बाक्तो कोए तियाआ मोजरी तियाहा जोड़े, देवोअ जागे कोडाआ भेदभाव कायनाहां.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />ए मालख्यों, जिव जिवोअ पावरोअरी न्यायनिवाड़ू आन वारुहूं वेवारो कोआ, ओं समजीत कोइत के होरगामेहें तुमाआं बी एक मालिख होय.<verse eid="COL 4:1" /></para>
  <para style="s">थोड़ीक वेवाराआ गोठी</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />प्रार्थना कोअते रोवा, आन धन्यवाद कोअते जात तियारीजमेहें रोवा; <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />आन तेहेलाजमेहें आमाअ कोअते बी प्रार्थना कोअते रोवा, कि देव आमाअ कोअते वसन उनाड़ीलोअ एहेलोह बाअणो उगाड़ी देअहूं जोवे, के आमू ख्रिस्ताआ एहेलिही निकाअली गोठी कोत सेको जियाअ वाखरी आंय जेलेम होय. <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />आन ते गोठी एहेलिही कोता आवड़ुहूं जोवे के, जेहेंकोइत माहूं कोअलोअ होय.<verse eid="COL 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5" />वेल ओलखीत कोइत बिगर विश्वासीइरी ओकल वापरीत कोइत काम कोआ. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />तुमाआं बाशण सादाज गोमे एहलोहो आन होवादो जोवे मोन्ज्ये हारेक माहुंहूं बोराबर उत्तर आपता आवड़ुहूं जोवे.<verse eid="COL 4:6" /></para>
  <para style="s">आखरीइ सलाम</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />आमाअ मेरालू पाही आन इमानदार सेवक, तुखिकुस<note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेशित 20:4</ref>; <ref loc="2TI 4:12">2 तिम 4:12</ref></char></note> जो प्रभुउ कामोमेहें माआं हेंगात्यु होय, तो माआं आक्खी गोठी तुमुहूं कोत आपी देय. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />तियाहा आंय एताआ काजे तुमाअ जागे मोकल्युहू के तुमुहूं आमाअ दशा मुंदू ओत जाय आन तो तुमाअ मोनोहों होक देय.<note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="EPH 6:21">इफिस 6:21</ref>,<ref loc="EPH 6:22">22</ref></char></note> <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />तियाआ आरी आंय उनेसिमुसोह बी मोकल्युहू जो इमानदार आन मेरालू पाही आन तुमाज मेर्‍युउ होय; ए तुमुहूं इहींइं आखी गोठी कोत देखाड़ी देय.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />अरिस्तर्खुस, जो माअरी जेलेम होय, आन मार्क जो बरनबासोअ पाही लागेहे जियाअ बाप्तिमेहें तुमुहूं आदेश मिल्‍युतो के जर तो तुमाअ जागे आवे, ताहां तियाअरी वारुहूं सालजा. <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />आन ईसु जो युस्तुस कोत ओलखीइतेहे, तुमुहूं सलाम कोअताहा. खतना कोअल्या माअहूंमेहें रोत फक्त एताज जोओं देवोअ राज्याआ कोअते माहूं मदत कोअयी, आन होक आप्‍यू<verse eid="COL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12" />एपफ्रास<note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="COL 1:7">कलस्से 1:7</ref>; <ref loc="PHM 1:24">फिले 24</ref></char></note> जो तुमामेर्‍युउज आन ईसु ख्रिस्ताआ सेवक होय, तुमुहूं सलाम कोहे, आन कायम तुमुहूं प्रार्थनामेहें ईतविलाअ कोशित कोअहे, एता कोअते तुमू पाक्के ओत कोइत पुरा विश्वासोअरी देवोअ इश्शा पोअ मजबुत रोअहुं जोवे. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />आंय तियाआ साक्शी होय कि, तो तुमाअ कोअते आन लौदीकियावालां आन हियरपुलिसवालाआं कोअते वोडी मेहेंनत कोअतू रोहे. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />मेरालू डाक्टर लुक आन देमासोअहीं रोत तुमुहूं सलाम.<verse eid="COL 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 4:15" />लौदीकियावाला पायहोंहों, आन नुम्फा आन तियांआं कोर्‍यीइ मंडड़ीही सलाम कोजा. <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />ताहां एहें कोअजा के ओं पत्र तुमाअ जागे वासीत लेहा ताहां, लौदीकियाअ मंडड़ीम बी वासे तेहें आपी देजा, आन जो पत्र लौदीकीयाम रोत आवे तो तुमू बी वासजा. <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />आन अर्खिप्पुसोहो कोजा के, “जे सेवा प्रभुमेहें ताहूं होपी देदीही हाजी हुतायी पुरी कोअजी.”<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />माआं सोताआ आथोवाअहीं आंय ओं लेखोहो, पौलुसोअ तरफ से सलाम, माअ बेड़ीही इतविइजा, देवोअ मेरवानी तुमाअरी ओवती रोय. आमेन.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>