<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Noiri</book>
  <para style="h">उपदेशक</para>
  <para style="toc3">उप</para>
  <para style="toc2">उप</para>
  <para style="toc1">उपदेशोकोअ पुस्तक</para>
  <para style="mt2">उपदेशोकोअ पुस्तक</para>
  <para style="mt1">उपदेशोकोअ पुस्तक</para>
  <para style="imt">ओलखात</para>
  <para style="ip">उपदेशोकोअ ओं एक एहलोहो पुस्तक होय जों जिवीइलोअ ग्यान सिकाड़ेहे. या पुस्तकोअ नावोअ शब्दाआ इब्री बाशाआ अर्थ बोणेहे, जो माअहें एक्ठे कोअहे तो. वार जाडा जाणकारोअ कोअलाआ पोड़ेहे के या पुस्तकोअ लेखाऱ्यु राजा शलमोन ओतू. पोन थोड़ाक जोओं यी गोठीही नाहां मानता. या पुस्तकोहो जर शलमोन लेखतू, ताहां ओं एक आंदास 970 ते 931 इ. स. सालोअ आगोदर लेखाअयोतो, ए तोयोंअ गोठ होय जेहेलाम तो जिवतुज ओतू. बिहीरा थोड़ाक जाणकार मानताहा के याहा बिहीरेज एखे लेख्योहो, काहाके यामेहें राजाआ बाशाआ बोदले वार जाडीज सेवकोअ बाशाआ वापर कोअयुहू. (उपदेशक <char style="xt"><ref loc="ECC 5:8-9">5:8-9</ref></char>)</para>
  <para style="ip">ते जाणकार एहलोहो मानताहा के उपदेशोकोअ पुस्तक शलमोनोअ फाटी वार हांहतोहो लेखाअयोतो, मोन्ज्ये 400 ते 200 इ.स. सालोअ विसमेहें उपदेशक एहें कोत सुरु कोअहे के, आखो बादो एकी हावाआ होसऱ्योअ होय जों एका तालोम आरतात जाहे. <char style="xt"><ref loc="ECC 1:2">1:2</ref></char> याआ अर्थ एहलोहो होय के आपाआ जिवन आन आपाआ काम थोड़ी वेलेए काजे होय आन याहा जाइंलोअ मिश्क्योल होय. याआ वारुज गोठी एका तालोम रोत विहीरात जावाअतीही. याआ वारुज गोठी आपाआ ताबाम नाहां रोती. या जिवनोहो जेहेलो होय तेहलोज स्विकारुहूं पोड़े, आन जों आपापोअ होय तिहींजमेहें खुस रोअलोअ हाजो होय. <char style="xt"><ref loc="ECC 9:9">9:9</ref></char> जिवनोअ आखी कठीण गोठीइ आन खुसीइ विसार कोअताम या पुस्तकोअ हिक होय के, देवोहो बित सालीइलो आन तियाआ आदेशोअ पालन कोइलोअ होय. <char style="xt"><ref loc="ECC 12:13">12:13</ref></char> एज खास कामोअ गोठ होय.</para>
  <para style="iot">रुपरेशा</para>
  <para style="io1">1. उपदेशक पुस्तकोमेहें पुस्तकोअ लेखाऱ्याआ जिवन आन तियाआ थोड़ाक आनुभावोअ ओलखात कोत देखाड़्यीही. <char style="ior"><ref loc="ECC 1:1-11">1:1-11</ref></char></para>
  <para style="io1">2. जिवनोअ अर्थाआ बाप्तिम सर्सा कोअयीही. <char style="ior"><ref loc="ECC 1:12-6:9">1:12—6:9</ref></char></para>
  <para style="io1">3. मास्तरोअ सल्लु कोत देखाड़्युहू. <char style="ior"><ref loc="ECC 6:10-12:8">6:10—12:8</ref> </char></para>
  <para style="io1">4. आखरीपोअ एहें कोत कोइत पुस्तकोअ सेवट कोअयुहू के देवोहो बित सालीइलो आन तियाआ आदेशोअ पालन कोइलोअ, ओज जिवनोअ खोरु उद्देश होय.<char style="ior"><ref loc="ECC 12:9-14">12:9-14</ref></char></para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s">जिवन वाया होय</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />येरुसालेमोअ राजा, दाविदोअ पोऱ्यु आन उपदेशकोअ वसन.<verse eid="ECC 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 1:2" />उपदेशकोअ ओं वसन होय, “वाया होय, वाया होय! वायाज होय! आखो बादो वायाज होय.” <verse eid="ECC 1:2" /><verse number="3" style="v" sid="ECC 1:3" />जे मेहेंनत माहुंउं यी धरतीपोअ <note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="fq" closed="false">धरतीपोअ </char><char style="ft" closed="false">दिहोअ उजालाम होय</char></note>कोअहे, तिहीं वाअहीं कि जोड़ेहे? <verse eid="ECC 1:3" /><verse number="4" style="v" sid="ECC 1:4" />एक पिड़ी जाहे, आन बिहीरी पिड़ी आवेहे, पोन धरती जेहेलीन तेहेलीहीज हादाफल रोहे. <verse eid="ECC 1:4" /><verse number="5" style="v" sid="ECC 1:5" />दिही उगेहेन बुडेहे बी, आन तो जिहीं रोत उगेहे तिया जागा पोअ वेगुज जातु रोहे. <verse eid="ECC 1:5" /><verse number="6" style="v" sid="ECC 1:6" />वारो देहामाआ वोल सालेहे, आन फिरीत कोइत पालामाआ वोल आवेहे; तो सालतो-फिरतो रोहे, आन जिहीं रोत आवेहे तिहींज जातो रोहे. <verse eid="ECC 1:6" /><verse number="7" style="v" sid="ECC 1:7" />आखी खाडी एकाज जागाअहें तालताल वोहयाज कोअतीही, आन ते आखी दोऱ्यामेहें जात कोइत एक्ठी ओवतीही, पोन तेबी दोऱ्या जोलोम नाहां पोआतू. <verse eid="ECC 1:7" /><verse number="8" style="v" sid="ECC 1:8" />आखी गोठी थाकाड़नारीज होय; माहुंउं यी पुरी गोठीही नाहां कोत सेकतो; नाहां ते डोआ पालीत कोइत थाकता, आन कान उनाइत कोइत नाहां पोआता. <verse eid="ECC 1:8" /><verse number="9" style="v" sid="ECC 1:9" />जे गोठ ओत गोयीही, ते फाशीइ ओवे, जों किबी बोणित गोयोहो तों फाशोअ बोणे; यी धरतीपोअ किज बी नोवो कायनाहां. <verse eid="ECC 1:9" /><verse number="10" style="v" sid="ECC 1:10" />केहें एहेलिही एखु गोठ होय जियीइ बाप्तिम माहुंउं कोत सेके के पाला ए नोवी होय? ए ते आमा रोत जास्ती वेगाआ वाडोम रोतुज ओवती रोयीही. <verse eid="ECC 1:10" /><verse number="11" style="v" sid="ECC 1:11" />जुनी गोठीइ किज ओर नाहां रोती, आन तियांआं फासाड़ी आवनाराहां बी ओवनारी गोठीइ ओर ने रोय.<verse eid="ECC 1:11" /></para>
  <para style="s">बुद्दी आन ग्यान</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />आंय उपदेशक येरुसालेमोमेहें इस्राएलोअ राजा ओतु. <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />यी धरतीपोअ जों बी ओवेहे, बुद्दी वाअहीं होदीइलाअ आन तिया मेऱ्यीइ गोठी जाइंलोअ कोअते आंय माआ मोन लागाड़्योहो. ए एक तारासोअ गोठ होय जे देवे या मोनवीइ कोअते ठरव्यीही के तों तिहींज मेहें लागीत रोय. <verse eid="ECC 1:13" /><verse number="14" style="v" sid="ECC 1:14" />आंय तियां आखा कामोहों पाल्ये जें धरतीपोअ ओवतेहे, तें आखे वाया होय, ओं ते फोलो वाराहा तोअतेहे तेहेलोज होय. <verse eid="ECC 1:14" /><verse number="15" style="v" sid="ECC 1:15" />जों वाकड़ो होय तों सिदो नाहां ओवित सेकतो, आन जों होयज नाहां तियाआ गणती नाहां ओत सेकती.<verse eid="ECC 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16" />आंय माआ मोनोमेहें कोयो, “पाल, तु जाअखीलोहो ग्यान मिलवीत लेदोहो, एतोहो के तियां आखा राजाआं रोत वादीत गोयोहो, जे ताआ रोत पेल येरुसालेमोमेहें ओता, ताहूं जाअखीलिही बुद्दी आन ग्यानोअ आनुभाव ओत गोयुहू.”<note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1KI 4:29-31">1 राजां 4:29-31</ref></char></note> <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />आंय ओं जाइंलोअ कोअते माआ मोन लागाड़्यो के बुद्दी कि होय, गांडाय आन फोगाय कि होय. ताहां माहूं समजाअयो के ओं बी वाराहा तोअत्लाआ होस होय. <verse eid="ECC 1:17" /><verse number="18" style="v" sid="ECC 1:18" />काहाके जाअखी बुद्दी वाअहीं जाअखी सिंता बी आवेहे, आन जों ग्यान वादाड़ेहे तों तियाआ दुख बी वादाड़ेहे.<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />आंय माआ मोनोमेहें कोयो, “साल, ओमे आंय मोज्यादान कोइत पालिहीं; ओवे तेतीही खुसी कोअहीं; तियाहा कोत खुसी कोअ. पोन पाला, ओं बी वायाज होय. <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />आंय ओंहींइलोअ बाप्तिम कोयो, हादाफल ओंहींइलोअ बी गांडाय होय, आन खुसीइ बाप्तिमेहें, तियामेहें कि मिलेहे?” <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />आंय माआ मोनोम विसार कोअयू के केहें कोइत माआ बुद्दी टिकीत रोय, दाराक्शाआ रोहो वाअहीं केहें कोइत माआ डिलोहो खुस कोओ आन केहें कोइत फोगायीही रुकीत रोंव, जाअहूं जांआं ओं ने जाइंत लेंव के तों हाजो काम काअलो होय जियाहा माहुंउं तियाआ पुरा जिवनोमेहें कोइत सेके.<verse eid="ECC 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4" />आंय वोडे वोडे कामे कोअये; आंय माआ कोअते कोएं बोणावीत लेदे आन माआ कोअते दाराक्शाआ मोला लागाड़ीत लेदा;<note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="1KI 10:23-27">1 राजां 10:23-27</ref></char></note> <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />आंय माआ कोअते मोला आन बोगिसा लागाड़ीत लेदा, आन तिहींमेहें बाती बातीइ फलवाआ साड़े लागाड़ीत लेदे. <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />आंय माआ कोअते तालाव बांदाड़ीत लेदा के तियांआं पाअयोंअ वापर तिया जंगलोअ काजे ओत सेके जियामेहें साड़े ठांअयेते. <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />आंय बोईंन माटी नोवकर वेसाते लेदे, माआं कोअमेहें उब्ज्ये तें बी माआंज ओत गोये. जे मारोत वेगा येरुसालेमोमेहें ओता तियां रोत वादार मापोअ वासड़ीन बोलोद ओत गोये.<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="1KI 4:23">1 राजां 4:23</ref></char></note> <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />आंय राजहांआं आन देसोअ होनो, सांदी आखी मोगली वस्तु बी टोलु वालित लेदी;<note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="1KI 10:10">1 राजां 10:10</ref>; <ref loc="1KI 10:14-22">10:14-22</ref></char></note> आंय माआ कोअते गिताऱ्यान गिताऱ्यी बी मिक्येते, माआ जागे माट्योअ मोनोहों खुस कोअनारी जाअखीलीही बोईं बी ओती.<note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="1KI 10:23-27">1 राजां 10:23-27</ref>; <ref loc="2CH 9:22-27">2 इति 9:22-27</ref></char></note><verse eid="ECC 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 2:9" />एहेंकोइत आंय माआ रोत पेल आखा येरुसालेमवाला रोत जाअखु वोडु आन मालधन वालू ओत गोयु;<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="1CH 29:25">1 इति 29:25</ref></char></note> तेबी माआ बुद्दी माआ साथ ने सोड़्यी. <verse eid="ECC 2:9" /><verse number="10" style="v" sid="ECC 2:10" />आन जेतीही वस्तुहू पालीइलोअ माआ इश्शा ओवी, तों आखो पालीइलोअ आंय माआ मोनोहो ने रुक्यो; आंय माआ मोनोहो काअलीज बी खुसीइ बाप्तिमेहें ने रुक्यो, काहाके माआ मोन माआ आखी मेहेनतीइ कामोमेहें खुस ओवोतो. आन ए खुसी माआ आखी मेहेनतीइ फल ओतो. <verse eid="ECC 2:10" /><verse number="11" style="v" sid="ECC 2:11" />ताहां आंय फाशोअ माआ आथोअ आखा कामोहों, आन माआ आखी मेहेंनतोहो पाल्यो, ताहां कि पाल्यो के आखो बादो वाया होय आन वाराहा तोअत्लाआ होस होय, आन धरतीपोअ किज लाभ कायनाहां.<verse eid="ECC 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 2:12" />ओमे आंय बुद्दी, गांडाय आन फोगायीइ विसार कोउ वोल्यु, काहाके जों माहुंउं राजाआ फासाड़ी आवे तों कि कोए? जों सालतो आयोहो तोज कोए ना. <verse eid="ECC 2:12" /><verse number="13" style="v" sid="ECC 2:13" />ताहां आंय पाल्यो के जेहेलोहो उजालो आंदाराआ रोत हाजो होय, तेहेलोज बुद्दी बी फोगायीइ रोत हाजी होय. <verse eid="ECC 2:13" /><verse number="14" style="v" sid="ECC 2:14" />जो बुद्दीमान होय, तियाआ मुन्कामेहें डोआ रोताहा, पोन फोगो आंदारामेहें सालेहे; ताहांज आंय जाईंत लेदो के बेनुउं दशा एक हारकीज होय. <verse eid="ECC 2:14" /><verse number="15" style="v" sid="ECC 2:15" />ताहां आंय मोनोमेहें कोयो, “जेहेलीही फोगाआ दशा रोय, तेहेलीज माआ बी रोय; ताहां केहें आंय जाअखु हुशार ओवू के?” आन आंय मोनोमेहें कोयो के ओं बी वायाज होय. <verse eid="ECC 2:15" /><verse number="16" style="v" sid="ECC 2:16" />काहाके बुद्दीमानोअ आन फोगाआ ओर हादाजलम नाहां रोती, पोन थोड़ाक दिहोमेहें माहुंउं आखो बादो विहीरात जाहे. जेहेलोहो फोगो मोअहे तेहेंज कोइत बुद्दीमान बी मोअहे! <verse eid="ECC 2:16" /><verse number="17" style="v" sid="ECC 2:17" />तियाहा कोत आंय माआ जिवनोहो सीस कोअहो, काहाके धरतीपोअ ओवनारे आखे कामे माहूं खाराब हासवाअये. काहाके आखो बादो वायाज होय आन वाराहा तोअत्लाआ होस होय.<verse eid="ECC 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 2:18" />आंय माआ आखी मेहेनतीइ फलवो जों आंय मेलव्योहो तों माआ फासाड़ी आवनाराआ काजे आंय सोड़ीत जानारुहू ओं माहूं मुंदू गोयू, ताहां जे मेहेंनत मी धरतीपोअ कोअयी तियाआ सीस लागी. <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />ओं कोडाहा मुंदू ओय के तो माहुंउं हुशार ओय के फोगो? तेबी धरतीपोअ तो माआ मेहेनतीइ फलोअ आन जों किबी आंय माआ बुद्धी वाअहीं टोलु कोअयोहो तिया आखाआ आधिकारी रोय. ओं बी वायाज होय. <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />ताहां आंय माआ मोनोमेहें तियी आखी मेहेनतीइ बाप्तिम जो आंय धरतीपोअ कोअयोतो नाराज ओवू. <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />केदिहीं एहेलोहो बी ओवत्लो माहुंउं हुशारी, बुद्दी वाअहीं मेहेंनत कोअत्लो आन जिकीत बी जाहे, तियाआ मेहेंनत एहेलाहा माअहोंअ कोअते सोड़ीत जाअहूं पोड़ेहे, जियाम तिये किज मेहेंनत ने कोअयी. ओं बी वायाज आन जास् खाराब होय. <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />माहुंउं जो धरतीपोअ मोन लागाड़ीत काम कोअहे तियामेहें तियाहा कि लाब होय? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />तियाआ आखा दिही ते दुखोमेहें पोआइत रोताहा, आन तियाआ काम दुखोमेहेंज ओवेहे; राती बी तियाआ मोनोहों होक नाहां जोड़तू.<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="JOB 5:7">इयोब 5:7</ref>; <ref loc="JOB 14:1">14:1</ref> </char></note> ओं बी वायाज होय.<verse eid="ECC 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24" />माहुंउं कोअते खाअलाआ पीइलाअ आन मेहेंनत कोअताज तियाआ जिवोहो खुस मिकीइला सिवाय किज नाहां हाजो.<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="ECC 3:13">उप 3:13</ref>; <ref loc="ECC 5:18">5:18</ref>; <ref loc="ECC 9:7">9:7</ref>; <ref loc="LUK 12:19">लुक 12:19</ref>; <ref loc="1CO 15:32">1 करिन्थ 15:32</ref></char></note> आंय पाल्यो के ओं बी देवोअहीं रोत जोड़ेहे; <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />काहाके तिया रोत सेटे रोत कोइत कोडो खात-पित कोइत खुसीम रोत सेकेहे? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />देवोअ नजरेमेहें जों माहुंउं हाजो ओय, तियाहा तो बुद्दी आन हुशारी आन खुसी आपेहे;<note caller="+" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="JOB 32:8">इयोब 32:8</ref>; <ref loc="PRO 2:6">निती 2:6</ref></char></note> पोन पापीही तो दुखोम पोआलो काम आपेहे के तो तियाहा आपीइलोअ कोअते टोलु वालित टिग कोए जो देवोअ नजरेमेहें हाजो ओय. ओं बी वायाज होय आन वाराहा तोअत्लाआ होय.<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s">आखा कामोअ एक ठरवीइल्यी वेल होय</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1" />आखी गोठीइ एक वेल रोहे आन धरतीपोअ<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="fq" closed="false">धरतीपोअ </char><char style="ft" closed="false">दिहोअ निसे</char></note> ओवनारा आखा कामोअ एक वेल होय.<verse eid="ECC 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 3:2" />जल्म लेअलाआ वेल, आन मोइलाअ बी वेल;</para>
  <para style="q1" vid="ECC 3:2">ठांइलोअ वेल आन तियाहा उफड़ीइलोअ बी वेल होय;<verse eid="ECC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 3:3" />देअलोअ वेल, आन हुदारीइलोअ वेल;</para>
  <para style="q1" vid="ECC 3:3">आरवीइलाआ वेल, आन बोणावीइलाआ बी वेल रोहे;<verse eid="ECC 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 3:4" />रोड़ीइलाआ वेल, आन ओंहींइलोअ बी वेल रोहे;</para>
  <para style="q1" vid="ECC 3:4">विखू कोइलाआ वेल, आन नासीइलाअ बी वेल रोहे;<verse eid="ECC 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 3:5" />डोणे टाकीइलोअ वेल, आन डोणे हाटवीइलाआ बी वेल रोहे,</para>
  <para style="q1" vid="ECC 3:5">गोले लागाड़ीलोअ वेल, आन गोले ने लागाड़ीलोअ रुकीइलाआ बी वेल रोहे;<verse eid="ECC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 3:6" />होदीइलोअ वेल, टाकीइलोअ बी वेल;</para>
  <para style="q1" vid="ECC 3:6">वासाड़ीत मिकीइलोअ, आन उडाड़ीलोअ बी वेल रोहे;<verse eid="ECC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 3:7" />फाड़ीइलोअ वेल, आन हिंवीइलोअ बी वेल रोहे;</para>
  <para style="q1" vid="ECC 3:7">ठावका रोअलाअ वेल, आन गोगीइलोअ बी वेल रोहे;<verse eid="ECC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 3:8" />मेर कोइलाआ वेल, आन दुस्मोनी कोइलाआ बी वेल रोहे;</para>
  <para style="q1" vid="ECC 3:8">लड़ायीइ वेल, आन होकेहे रोअलाआ बी वेल रोहे.<verse eid="ECC 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9" />काम कोअनाराहा तियाआ मेहेंनती रोत कि लाब ओवेहे? <verse eid="ECC 3:9" /><verse number="10" style="v" sid="ECC 3:10" />देवे मोनवीइ काजे जें वोजावाले कामे होप्येहे तें मी देख्येहे. <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />तियीं आखी वस्तुहू तियाआ कोअते हाजी वेलेमेहेंज बोणावयीही. तिये माहुंउं मोनोमेहें हादाफल्यीइ ओकलेए ताकत आप्यीही, ते बी माहुंउं नाहां समजीइतो के देव सुरवाती रोत ते आखरी जाआं कि कोअयोहो. <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />आंय जाइंत लेदोहो के माहुंउं कोअते खुसी कोइलाआ आन जिवन पोइत हाजो कोइला सिवाय बिहीरो किज हाजो कायनाहां. <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />आन माहुंउं खाय-पिय आन तियाआ आखी मेहेंनती मेहें खुस रोय ओं बी देवोअ दान होय.<verse eid="ECC 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 3:14" />आंय जांअहों के देव जों किबी कोअहे तों हादाफल टिकीत रोहे; तियामेहें ने कमी कोइत सेकत्ले आन ने वादाड़ीत सेकत्ले; देव एहेलोहो याआ कोअते कोअहे काहाके माअहें तियाहा बित सालुहूं जोवे. <verse eid="ECC 3:14" /><verse number="15" style="v" sid="ECC 3:15" />जों किबी ओवो तों याआ पेल बी ओत गोयोतो; जों ओवनारो होय, तो बी ओत गोयोहो; आन देव ओवल्यी गोठीही फाशुउ ताल ताल कोअहे.<verse eid="ECC 3:15" /></para>
  <para style="s">दुन्यामेहें अन्याय</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />फाशोअ आंय धरतीपोअ कि पाल्यो के न्यायोअ जागापोअ अन्याय रोहे, आन हाजा कामोअ जागापोअ बी खाराब कामे ओवतेहे. <verse eid="ECC 3:16" /><verse number="17" style="v" sid="ECC 3:17" />आंय मोनोमेहें कोयो, “देव धर्मी आन पापी बेनुउं न्याय कोए,” काहाके तियाआ जागे एक एक गोठीइ आन एक एक कामोंअ वेल होय. <verse eid="ECC 3:17" /><verse number="18" style="v" sid="ECC 3:18" />आंय मोनोमेहें कोयो, “याआ काजे ओवेहे के देव माअहुंहूं तापासे ताहां तियांहां मुंदू जाय के तें जनवारोअ होस होय.” <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />काहाके जेहेलीही माहुंउं तेहेलीज जनवारोअ बी दशा रोहे; बेनुउं तेज दशा रोहे, जेहेलोहो एक मोअहे तेहेलोज बिहीरो बी मोअहे. आखाआ हावा एक हारकी रोहे, माहुंउं जनवारो रोत वादीत नाहां; आखो वायाज होय. <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />आखे एकाज जागामेहें जातेहे; आखे कादवोअ बोण्येहे, आन आखे कादवोम जानारे होय. <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />केहें माहुंउं आत्मा उपोअ जाहे आन जनवारोअ जिव निसेए वोल जात कोइत कादवोम मिलाअहे? ओं कोडो जांअहें? <verse eid="ECC 3:21" /><verse number="22" style="v" sid="ECC 3:22" />सेवटी आंय ओं पाल्यो के याअ रोत जाअखो किज हाजो नाहां, के माहुंउं तियाआ कामोमेहें खुस रोअहूं जोवे, काहाके तियाआ भाग ओज होय; माहुंउं एखो मोइत जाय तिहींइं फासाड़ी तियाहा वापिस लेतावित कोइत तियीं गोठीही कोडो देखाड़ीत सेकेहे के?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />ताहां आंय पाल्यो के धरतीपोअ केतुहू अन्याय ओवेहे. जियांपोअ अन्याय ओवेहे, तें डोआम रोत रोज्ये काडतेहे, पोन तियांआं रोज्ये पुसनारो कोडो कायनाहां. अन्याय कोअनारापोअ सेक्ती ओती, पोन रोड़नाराआ जागे तियांहां ठावको कोअनारो कोडो ने ओतो. <verse eid="ECC 4:1" /><verse number="2" style="v" sid="ECC 4:2" />तियाहा कोत जें ओमे जाआं जिवते होय तियां रोत जी, जें मोइत गोयेहे तियांआं जाअखो हाजो होय एहलोहो आंय कोहो. <verse eid="ECC 4:2" /><verse number="3" style="v" sid="ECC 4:3" />पोन मोल्या माहुंउं आन जिवता माहुंउं रोत तियाआ दशा हाजी होय जियाआ जल्म नाहां ओवो, आन धरतीपोअ ओवनारे खाराब कामे नाहां पाल्ये.<verse eid="ECC 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4" />ताहां आंय आखी मेहेंनती वाले कामे आन हाजा कामोहों पाल्ये जें माअहें तियांआं जागेवालाआ वस्तु देखीत ओड़खू कालीत लेतेहे. ओं बी वायाज आन वाराहा तोअत्लाआ होस होय. <verse eid="ECC 4:4" /><verse number="5" style="v" sid="ECC 4:5" />फोगो आथ बांदीत कोइत रोहे, आन तियाआ सोताआज नुकसान कोइत लेहे. <verse eid="ECC 4:5" /><verse number="6" style="v" sid="ECC 4:6" />तारास कोइत आन विणकामोअ बेन मुठी रोत जी, एक मुठेन मोनोम होक ओय तोज पुरड़्यो.<verse eid="ECC 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7" />फाशोअ आंय धरतीपोअ ए बिगरकामोअ गोठ बी देख्यी. <verse eid="ECC 4:7" /><verse number="8" style="v" sid="ECC 4:8" />एखो एखलोज रोहे आन तियाआ कोडोज कायनाहां; नाहां तियाआ पोऱ्यु, नाहां पाही; तेबी तियाआ मेहेंनत नाहां सेलाअती; तियाआ डोआ मालधनो वाअहीं बी नाहां ताराअता; आन तों नाहां कोतो, आंय कोडाआ कोअते मेहेंनत कोओ आन माआ जिवनोहों काहा दुखी मिको? ओं बी वायाज होय आन तारासोवालोज काम होय.<verse eid="ECC 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 4:9" />एका रोत बेन हाजे होय, काहाके तियांआं मेहेनतीइ हाजो फल जोड़ेहे. <verse eid="ECC 4:9" /><verse number="10" style="v" sid="ECC 4:10" />आन तियांमेहें रोत एक पोड़्यो ताहां बिहीरो तियाहा उठाड़ीत सेकेहे. पोन जों एखलोज ओय तियाहा कोडो उठाड़नारो ने रोयो, ताहां ते केतीही दुखोअ गोठ होय. <verse eid="ECC 4:10" /><verse number="11" style="v" sid="ECC 4:11" />फाशोअ जर बेन जोएं हुवे ताहां ते उफाले रोय, पोन एखलो माहुंउं केहें कोइत उफालो ओत सेकेहे? <verse eid="ECC 4:11" /><verse number="12" style="v" sid="ECC 4:12" />एक जोओं एखलाहा गाठाड़ीत सेकेहे, पोन बेन जोओं तियाहा हारवीत सेकताहा; जों दोअड़ो तिन फेली वाअहीं बोण्योहों तो वेगो नाहां टुटीत सेकतो.<verse eid="ECC 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13" />सल्लु ने माननारा तियां डाया आन फोगा राजा रोत जी समजदार गरीब जुवान जाआं हाजु. <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />ओत सेकेहे राजा तियाआ देसोमेहें गरब्योअहीं जल्म लेत राजा बोण्युय, नेत जेलेमेहें रोत निहींत कोइत राजा ओवू ओय. <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />पोन धरतीपोअ जिवनारे आखे माअहें तिया समजदार जुवानोअ वोल ओते तों मी देख्यो. <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />जाअखीलेहे माअहें तिया जुवानोअ फासोअ जाय; पोन सेलवाआ तियां माअहोंहों तो ने गोमे. हुदाअलीज ए गोठ बी वायाज आन बिगर कामोअ होय.<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s">तावणीमेहें पालनी मा तोअहा</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />जेहेलाम तु देवोअ मंदिरोमेहें जाही, ताहां सांबालतीज जाजी<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fq" closed="false">सांबालतीज जाजी </char><char style="ft" closed="false">सोताआ गुडाहा सांबालजी</char></note>; देवोअ गोठ उनाइलोअ ओं फोगा माअहोंअ कोअल्या गाराहा रोत बी जाअखो हाजो होय; फोगाहा ते खाराब कामे कोअतेहे तों नाहां मुंदू जातू. <verse eid="ECC 5:1" /><verse number="2" style="v" sid="ECC 5:2" />गोठी कोइलामेहें जल्दी मा कोअही, आन ताआ मोनोमेऱ्यीइ एखु गोठ देवोअ सामने उतवाल मा कोत देही, काहाके देव होरगामेहें होय आन तु धरतीपोअ होय; तियाहा कोत ताआ गोगीइलो थोड़ो जोवे. <verse eid="ECC 5:2" /><verse number="3" style="v" sid="ECC 5:3" />जाअखी कालजी लेअलो वाअहीं खाराब होपने पोड़तेहे आन जाअखो गोगीइला वाअहीं फोगे ठरवाअतेहे. <verse eid="ECC 5:3" /><verse number="4" style="v" sid="ECC 5:4" />जेहेलाम तु देवोअ काजे पालनी तोअही, ताहां ते पुरो कोइलामेहें वाआ मा लागाड़ही; काहाके तो फोगा वाअहीं खुस नाहां ओवतु. जे पालनी तु तोअही, तियीही पुरो कोअजी.<note caller="+" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="PSA 66:13-14">भजन 66:13-14</ref></char></note> <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />पालनी तोइत ते पुरी ने कोए तिया रोत जी पालनीज ने तोइली तों जाआं हाजो. <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />सोताआ जिबानीम गुतीत कोइत पापोमेहें मा फोसीत जाही, आन माहूं सुकीत गोगी देवाअयो कोत देवदुतोअ सामने मा कोही, नेत ताआ शब्द उनात कोइत देवोहो खोत लागेन तो तुमाआ मेहेंनती वाअहीं कोअल्या कामोहों आरवीत टाकी देय. <verse eid="ECC 5:6" /><verse number="7" style="v" sid="ECC 5:7" />जेहेलाम माहुंउं जाअखो जाअखो होपने पालो वोलेहे, ताहां तियाआ रिकामी गोठी बी वादीत जातीही: पोन तु देवोहो बित सालजी.<verse eid="ECC 5:7" /></para>
  <para style="s">जिवन वायाज होय</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />जर तु एखा मुलखोमेहें गरीब पोअ विरोद ओवत्लाहा पालही, न्याय आन हुदी गोठीही बिगड़ीइत्लाहा पालही, ताहां बोगलाअही मा; काहाके एका आधिकारीइ उपोअ तियाआ रोत वोडु आधिकारी रोहे आन तियाआ रोत बी वोडु आधिकारी रोहे.<verse eid="ECC 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 5:9" />धरतीपोऱ्योअ ओन आखाआ काजे होय, आन राजाहा बी खेतीइ पोरहेज रोअहूं पोड़ेहे.<verse eid="ECC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 5:10" />जियांहां पोशा जाअखा गोमताहा तें पोशा वाअहीं केदिहीं ने ताराअनारे; आन जों माहुंउं पोशाआ लालस कोअहे, तियाहा किज लाब नाहां जोड़तू, ओं बी वायेज होय. <verse eid="ECC 5:10" /><verse number="11" style="v" sid="ECC 5:11" />जेहेलाम मालमिलकत वादेहे, ताहां तियाहा खानारे बी वादतेहे, तेहलाम तियाआ मालख्योहो कि लाब? तो निस्तु तियाहा डोआ वाअहीं पालेहे तेतुज मे! <verse eid="ECC 5:11" /><verse number="12" style="v" sid="ECC 5:12" />मेहेंनत कोअनारो थोड़ो खाय नेत वादार, तेबी तियाहा हाजी निंद आवेहे; पोन मालदारोहो तियाआ मालधन वादीइलो वाअहीं निंद नाहां आवती.<verse eid="ECC 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13" />आंय धरतीपोअ एक खाराब गोठ पाल्यी, धनोअ मालिख तियाआज नुकसानीइ कोअते पोशा हेंगालेहे. <verse eid="ECC 5:13" /><verse number="14" style="v" sid="ECC 5:14" />आन ते पोशा एखा खाराब कामोमेहें उडीत जाताहा, आन तियाआ कोअमेहें पोऱ्यु उब्जेहे, पोन तियाआ आथोमेहें किज नाहां रोतो. <verse eid="ECC 5:14" /><verse number="15" style="v" sid="ECC 5:15" />जेहेलुहू तो याह्हीइ पोटाम रोत जल्म लेदो तेहेलुज नागरुज जातु रोय, तो तियाआ आथोमेहें मेहेनतीइ फल किज नाहां लेत जात सेकतु.<note caller="+" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="JOB 1:21">इयोब 1:21</ref>; <ref loc="PSA 49:17">भजन 49:17</ref>; <ref loc="1TI 6:7">1 तिम 6:7</ref></char></note> <verse eid="ECC 5:15" /><verse number="16" style="v" sid="ECC 5:16" />ए जुदी खाराब गोठ होय, जेहेलुहू तो आयुतो, तेहेंज कोइत तो इंहीं रोत जातु रोय. तियाहा तियाअ मेहेंनती पोअ रोत कि लाब ओवू? <verse eid="ECC 5:16" /><verse number="17" style="v" sid="ECC 5:17" />तिये आंदाराम बोहीत खादो, तिये दुखोमेहें, सिंतामेहें, बिमारीमेहेंन खोतेमेहें पुरो जिवन काट्यो.<verse eid="ECC 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18" />पाल, जे हाजी गोठ आंय आनुभाव कोअयीही ते ए होय के, माहुंउं खाय-पिय आन जे तियाआ मेहेंनत जे तो धरतीपोअ कोअहे, तियाआ पुरा जिवनोमेहें जो देव तियाहा आप्योहो, खुस रोय; काहाके तियाआ भाग ओज होय. <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />आखा माहुंहूं, जियाहा देव मालमिलकत आप्यीही, आन तियाहा वापरीइलोअ आन तियामेहें रोत भाग लेअलाआ आन मेहेंनत कोअतामेहें खुसी कोइलाआ बी सेक्ती आप्यीही: ओं देवोअ वरदान होय. <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />माहुंउं तियाआ पुरा जिवनोहो कायम ओर ने मिके, काहाके देव तियाहा मोनोमेहें खुस मिकेहे.<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />धरतीपोअ आंय एक खाराब गोठ देख्यी, जियाआ वोजा वाअहीं माहुंउं दाबात रोहे. <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />एखा माहुंहूं देव मालमिलकत आन मानपान एतुहू आपेहे के जों किबी तियाआ मोन कोय तियाहा किज कमी नाहां पोड़तो, तेबी देव तियामेहें रोत तियाहा खाअहूं नाहां देतु, एखु बिहीरोज तियाहा खाहे; ओं वायाज आन केतोहो खाराब दुख होय. <verse eid="ECC 6:2" /><verse number="3" style="v" sid="ECC 6:3" />जर एखा माट्योअ होव पोऱ्या बी ओवा, आन तो जाअखीले वोरह्ये जिवतू रोयू आन तियाआ जिवीइलोअ दोरी वादीत बी जाय, पोन तियाआ जिव खुस ने रोयू आन मोयू तिहींइं फासाड़ी तियाहा ओजी देदू, ताहां आंय कोत्लू, तिया रोत जी आरदो उब्जीइल्यो पोऱ्यो जाआं हाजो ओये. <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />काहाके तो वायाज आयु आन आंदारा मेहेंज जातु रोयु, आन तियाआ नाव बी आंदारा मेहेंज निकात गोयो. <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />आन ने दिहोहो पाल्यो, ने एखु गोठीही जाइंत सेकू; तेबी याहा तिया माअहोंअ रोत जाअखू आराम जोड़्यू. <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />तो बेन हाजार वोरह्ये जिवे पोन तेबी जिवनोमेहें खुसी ने जोड़्यीय ताहां तियाहा कि लाब? आखे माहें आखरीपोअ एकाज जागाम जातेहे.<verse eid="ECC 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 6:7" />आखी मेहेंनत माहुंउं खाअलोज काजे कोअहे, पोन तियाआ पेट नाहां पोआतो. <verse eid="ECC 6:7" /><verse number="8" style="v" sid="ECC 6:8" />ओमे हुशार माहुंउं काअली गोठीमेहें फोगा माहुंउं रोत हुशार बोण्यो? गरीब माहुंउं जिवनोमेहें केहें कोइत सालुहूं जोवे ओं जाअहें, ते बी तियाहा यामेहें कि लाब? <verse eid="ECC 6:8" /><verse number="9" style="v" sid="ECC 6:9" />हादाफल कि तेबी मेलवीइलोअ मोनोअ इश्शा मिकीइला रोत हाजो ओं होय के तुमापोअ जों किबी ओय तियामेहें सुख माना. ओं वायाज होय; वाराहा तोअत्लाआ होस होय.<verse eid="ECC 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 6:10" />जों कोडो बी माहुंउं ओय, तियाहा तियाआ नाव सुरुवातीज आपी देदोतो: आन माहुंउं बाप्तिमेहें ओं प्रगट कोई देदोतो के तो निस्तो कादुउ होय. तियाहा काजे तो तियाआ रोत वादार ताकतवान माअहोंअरी सुलाईत नाहां सेकतो. <verse eid="ECC 6:10" /><verse number="11" style="v" sid="ECC 6:11" />वारुज गोठी होय जिया वाअहीं जिवन फाशोअ बी वायाज रोहे, ताहां एहेलाहा जिवनोपोअ रोत माहुंहूं कि लाब? <verse eid="ECC 6:11" /><verse number="12" style="v" sid="ECC 6:12" />मोनव्योअ एका तालोअ जिवनोमेहें तियाआ कोअते धरतीपोअ कि हाजो होय तो कोडो कोत सेकेहे? आगाड़ी कि ओवनारो होय तो तियाहा कोडो कोत नाहां सेकतो.<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s">जिवनोअ बाप्तिमेहें विसार</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 7:1" />हाजो नाव किमती अत्तर रोत हाजो होय आन मोतोअ दिही जल्माआ दिहो रोत हाजु होय.<note caller="+" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="PRO 22:1">निती 22:1</ref></char></note><verse eid="ECC 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 7:2" />तिवारोम जाअलो रोत ते मोयात ओवल्या परिवारोमेहें जाअलाआ हाजो; काहाके आखा माअहोंअ सेवट ओंज होय, आन जों जिवतो होय तों मोन लागाड़ीत कोइत यी गोठीइ विसार कोए.<verse eid="ECC 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 7:3" />ओंहींइलोअ रोत रोड़ीइलोअ हाजो होय, काहाके सोबीपोऱ्याआ दुखो वाअहीं मोन हुदरेहे.<verse eid="ECC 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 7:4" />बुद्दीमान माहुंउं मोन विखु कोअनाराआ कोओअ वोल लागीत रोहे, पोन फोगाआ मोन मोज्या कोअनाराआ कोअमेहें लागीत रोहे.<verse eid="ECC 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 7:5" />फोगाआ गित उनाइलोअ रोत ते बुद्दीमानोअ गाई उनाइलोअ हाजो होय.<verse eid="ECC 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 7:6" />काहाके फोगाआ ओंहींइलोअ मोन्ज्ये आंड्लाआ थुड़ी तितड़ीइनारा काटाआ होस रोहे; ओं बी वायाज होय.<verse eid="ECC 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 7:7" />ठोगोअ कामायी वाअहीं हुशार बी फोगो बोणीत जाहे, लास लेअला वाअहीं बुद्दी सेलाअहे.<verse eid="ECC 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 7:8" />एखा कामोअ सुरवात कोइलो रोत तियाआ सेवट हाजू रोहे; आन धिर खेटनारो माहुंउं वोडाय कोअनारा रोत हाजो होय.<verse eid="ECC 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 7:9" />तुमाआ मोनोम उतवाल खोत मा कोअहा, काहाके खोत फोगाआ मोनोमेहें रोहे.<note caller="+" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="JAS 1:19">याकोब 1:19</ref> </char></note><verse eid="ECC 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 7:10" />ओं मा कोहा, “आज्याआ दिहो रोत सेकला दिही हाजा ओता?” काहाके याआ बाप्तिम तुमाआ एहेलोहो कोअलोअ बुद्दी वाअहीं नाहां.<verse eid="ECC 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 7:11" />बुद्दी मालधनोअ होस हाजी होय, जिवता माअहोंअ कोअते बुद्दी फायदाआ होय. <verse eid="ECC 7:11" /><verse number="12" style="v" sid="ECC 7:12" />पोशा वाअहीं आधार जोड़ेहे तेहलुज ओकले वाअहीं आधार जोड़ेहे. जियापोअ ओकल होय तियाआ जिवोअ राखवाली ओवेहे.<verse eid="ECC 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13" />देवोअ कामोपोअ विसार कोआ; जियाहा देवो वाकड़ो बोणायो ओय तियाहा कोडो हुदो कोइत सेकेहे? <verse eid="ECC 7:13" /><verse number="14" style="v" sid="ECC 7:14" />खुसीइ दिहोमेहें खुसी बोणावा, आन दुखोअ दिहोमेहें विसार कोअ, काहाके देव बेनुहूं आरी मिक्योहो, जिया वाअहीं माहुंउं तियाआ फासाड़ी ओवनारी एखी गोठीही ने समजीत सेके.<verse eid="ECC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15" />एखु धर्मी हाजे कामे कोअहे तेबी आरवात जाहे, आन पापी खाराब कामे कोअहे तेबी जाअखो जिवेहे, आंय माआ वाया गोल्या जिवनोमेहें ओं आखो पाल्योहो; <verse eid="ECC 7:15" /><verse number="16" style="v" sid="ECC 7:16" />सोताहा जाअखो धर्मी मा बोणावही, आन जाअखो बुद्दीमान बी मा बोणावही; नेत तु सोताआ गुडापोअ कुवाड़ो लागावीत लेही.<verse eid="ECC 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 7:17" />जाअखो खाराब बी मा बोणही, आन मा फोगो बोणही; तु वेले रोत पेलुज काहा मोअहूं जोवे? <verse eid="ECC 7:17" /><verse number="18" style="v" sid="ECC 7:18" />हाजो ओं होय के तु यी गोठीही तोइत रो; आन तियी आखी गोठीप रोत आथ मा फेड़ीत लेही; काहाके जों देवोहो बित सालेहे तों कठीण गोठीही उनकावित लेय.<verse eid="ECC 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 7:19" />ओकल माहुंहूं सेक्ती आपेहे. एक हुशार माहुंउं होयरोअ दोह पुडारी रोत जाअखु ताकत वालू रोहे.<verse eid="ECC 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 7:20" />यी धरतीपोअ हादाफल हाजे कामे कोअनारो आन केदिहीं पाप ने कोअनारो एहेलोहो माहुंउं कायने.<verse eid="ECC 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 7:21" />जेतीही गोठी कोये तियी आखी गोठीपोअ कान मा लागाड़ही, जर तु तेहें कोअही ताहां केहें नेत ताआ सेवकुज ताआ निंदा कोए; <verse eid="ECC 7:21" /><verse number="22" style="v" sid="ECC 7:22" />काहाके तु सोताहा जाअहें के तुमे बी वारुज वारी बिहीराआ निंदा कोअयी.<verse eid="ECC 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23" />ओं आखो आंय बुद्दीइ वाअहीं जाइंत लेदोहो; आंय कोयो, “आंय बुद्दीमान ओत जाहीं;” पोन ओं मारोत सेटे रोयो. <verse eid="ECC 7:23" /><verse number="24" style="v" sid="ECC 7:24" />तो जो सेटे आन खुब उंडे तियाहा कोडो जाइंत सेकेहे? <verse eid="ECC 7:24" /><verse number="25" style="v" sid="ECC 7:25" />आंय बुद्दी आन ओकलेए बाप्तिमेहें जांइलोन होदीइलो कोअते माआ मोन लागाड़्यो; पापी टेव फोगाय आन गांडाय होय ओं समजीइलोअ काजे फाशुउ आंय माआ मोन लागाड़्यो.<verse eid="ECC 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ECC 7:26" />आय मोतोपोअ रोत एक दुख आपनारी गोठ पाल्यी, मोन्जे ते बोयोंअ जियीइ मोन फांदू आन जाल होय आन जियीइ आथोमेहें आथकोड़्यी होय, जियापोअ देव खुस ओवेहे, तो माटी एतू वासाइत सेकेहे, पोन पापी तियाआ आटालाम पोड़े. <verse eid="ECC 7:26" /><verse number="27" style="v" sid="ECC 7:27" />पाल, उपदेशक कोहे, हुशारीइ कोअते आलाग आलाग गोठी जोड़ीत कोइत तापाशी, आन ए गोठ निहींयी <verse eid="ECC 7:27" /><verse number="28" style="v" sid="ECC 7:28" />पोन जियाहा आंय होदतु रोयू, तो माहूं ने जोड़्यू. हाजार माट्योमेहें का तेबी एक माटी मिल्यू, पोन तियामेहें माहूं एक बोयोंअ बी ने देखाअयी. <verse eid="ECC 7:28" /><verse number="29" style="v" sid="ECC 7:29" />पाला, माहूं एज गोठ देखुहूं जोड़्यीही, के देवे मोनवीही सिदो बोणायोहो, पोन तिये जाअखीलीही कदर काड्यीही.<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 8:1" />बुद्दीमान माहुंउं होस कोडो होय? एखी गोठीइ अर्थ कोडो लागाड़ीत सेकेहे? मोनव्योअ बुद्दी वाअहीं तियाआ मुख सोमकेहे, आन तियाआ मुखोअ दुख निहींत जाहे.<verse eid="ECC 8:1" /></para>
  <para style="s">राजाआ आदेश मानीइलो</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />आंय ताहूं सल्लु आपोहो के देवोअ हुंबर लेद्ली शप्पतोअ वाअहीं राजाआ आदेशोअ पालन कोआ. <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />तियाआ सामने जाअलोअ उतवाल्या मा ओवहा; जर तो एखी गोठीपोअ रोत नाराज ओय ताहां तुमू तिहीं उबे मा रोहा, काहाके राजाआ मोनोमेहें जेहेलोहो आवेहे तेहेलोहो तो कोअहे. <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />काहाके राजाआ शब्दामेहें ताकत रोहे, आन तियाहा कोडो कोत सेकेहे के तु एहेलोहो काहा कोअहे? <verse eid="ECC 8:4" /><verse number="5" style="v" sid="ECC 8:5" />जों राजाआ आदेशोहो माने, तों वासाइत जाय, पोन एक बुद्दीमान माहुंउं एहेलोहो कोइलोअ बोराबर वेल जांअहें आन तो ओं बी जांअहें के ए गोठ कोयों कोअहूं जोवे. <verse eid="ECC 8:5" /><verse number="6" style="v" sid="ECC 8:6" />काहाके आखी गोठीइ ठरवीइल्यी वेल आन पद्दत रोहे, तेबी माहुंउं दुख तियाआ कोअते जाअखीलोहो रोहे. <verse eid="ECC 8:6" /><verse number="7" style="v" sid="ECC 8:7" />तो नाहां जांअतो के कि ओवनारो होय, आन कोयों ओवनारो होय? ओं तियाहा कोडो कोत सेकेहे? <verse eid="ECC 8:7" /><verse number="8" style="v" sid="ECC 8:8" />जिव निहे तेहेलाम जिवोहो रुकीत लेय एहलीही काअलाज माहूंपोअ सेक्ती नाहां रोती; मोत आवीइलोअ दिही कोडाआ ताबामेऱ्यीइ गोठ कायनाहां; आन यी लड़ायीमेहें रोत कोडाहाज नाहां सुटीत सेकाअतो, आन पापी माहुंउं तियाआ पापोम रोत नाहां वासाइत सेकतो.<verse eid="ECC 8:8" /></para>
  <para style="s">पापी आन धर्मी</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9" />जेतेहे कामें धरतीपोअ ओवतेहे तियां आखाहा ध्यान लागाड़ीत ओं आखो आंय पाल्यो, आन ओं बी पाल्यो के एक माहुंउं बिहीरा माहूंपोअ आधिकारी बोणीत कोइत सोतापोअ नुकसान कोइत लेहे. <verse eid="ECC 8:9" /><verse number="10" style="v" sid="ECC 8:10" />ताहां आंय पाप्योहों माहणोमेहें डेटत्लाहा पाल्यो. पोन जियां हाजे कामे कोअये तियांहां सोकू जागू सोड़ीत जाअहूं पोड़ेहे, आन होयरोमेएं माहें तियांहां विहीरात जातेहे. ओं बी वायाज होय.<verse eid="ECC 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11" />खाराब कामोअ डोंड माहुंहूं वेगु नाहां जोड़तू; तियाहा कोत तियांआं मोन खाराब काम कोइलामेहें लागीत रोहे. <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />पापी माहुंउं होव वारी पाप कोएन जाअखो जिवे, तेबी माहूं मुंदू होय के देवोहो बित सालनाराआ हाजोज ओवे. <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />पोन पापीइ सेवट हाजो नाहां ओवतो, आन सावलाआ होस तियाआ जिवन एका तालोअ रोहे, काहाके तों देवोहो नाहां बितो. <verse eid="ECC 8:13" /><verse number="14" style="v" sid="ECC 8:14" />फाशीइ एक वाया गोठ होय जे धरतीपोअ ओवेहे; के पापीही जोड़ुहूं जोवे तों फल धर्मी माहुंहूं भोगुहूं पोड़ेहे, आन धर्मीही जोड़ुहूं जोगोहो हाजो फल तियां पाप्योहों जोड़ेहे. आंय कोहो के ओं बी वायाज होय.<verse eid="ECC 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 8:15" />तियाहाकोत आंय माहुंहूं सल्लु आपोहो: खुसी कोआ, धरतीपोअ माहुंउं कोअते खाअलाअ पीइलाअ आन खुसी कोइलोअ सिवाय किज नाहां हाजो. जो जिवन देव तियाहा यी धरतीपोअ आप्योहो, तिहींम काम कोअतामेहें ओंज तियाअरी रोय.<verse eid="ECC 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16" />जेहेलाम आंय बुद्दी मिलवीलोअ, आन धरतीपोअ ओवनारा आखा कामोहों पालीइलोअ कोअते माआ मोन लागाड़्यो, के एं माअहें केहें कोइत रातेन दिही जागते रोतेहे; <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />ताहां देवोअ आखो काम आंय पाल्यो जों धरतीपोअ ओवेहे, माहुंउं तियाआ खास गोठी जाइंलोअ केतोहो बी मेहेंनत काहा ने कोए, तेबी तों तियाहा जाइंत नाहां सेकतो. जर एखु हुशार माहुंउं तियाहा जाइंलोअ कोशित कोए तेबी तो तियाहा जाइंत नाहां सेकतो.<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />यीं आखी गोठीइ बाप्तिम उंडे रोत विसार कोअयू, ताहां माहूं जाआंयो के धर्मी आन समजदार माहें आन तियांआं कामे आन तियांआं मेर आन तियांआं सीस देवोअ आथोम होये. आगाड़ी की ओवनारो होय तों कोडाहा नाहां जाआंतो, के तियाहा की आथ लागनारो होये. <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />आखी गोठी आखाआ कोअते हारकीज होय, धर्मी ओय नेत पापी, सोको ओय नेत एठो, गाराहा कोअनारे आन ने कोअनारे, आखाआ दशा एक हारकी रोहे. जेहेलीही हाजा माअहोंअ दशा, तेहेलीज पापीइ दशा; जेहेलीही शप्पत खानाराआ दशा, तेहेलीज जों शप्पत खाअहूं बिहे तियाआ दशा. <verse eid="ECC 9:2" /><verse number="3" style="v" sid="ECC 9:3" />जों किबी धरतीपोअ ओवेहे यामेहें ए एक खाराब गोठ होय के आखा माअहोंअ एकुज दशा ओवेहे; आन माहुंउं मोनोमेहें खाराब गोठी पोआत रोतीही, आन जाअहूं जाआं तें जिवते रोतेहे ताअहूं जाआं तियांआं मोनोमेहें फोगाय रोहे, आन तिहींइं फासाड़ी तें मोल्याहां जात मिलतेहे. <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />जाअहूं जांआं माहुंउं जिवतो रोहे, तियाहा आशा होय, काहाके हुंणो मोअल्या सिहां रोत हाजो होय. <verse eid="ECC 9:4" /><verse number="5" style="v" sid="ECC 9:5" />काहाके जें जिवते होय, तें जांअतेहे के तियांहां एक दिही मोइलाअ होय, पोन जे मोइत गोयेहे, ते कि जांअतेहे? तियांहां बक्शीस मिल्योहो. तियांआं ओर बी नाहां ओवती. <verse eid="ECC 9:5" /><verse number="6" style="v" sid="ECC 9:6" />तियांआं मेर आन तियांआं सीस आन तियांआं आद्राय आखो तियांअरीज आरवात गोयोहो, ओमे यी धरतीपोअ जों बी ओवेहे तियामेहें तियांआं भाग जोलमजुग्योअ किज ने रोनारो.<verse eid="ECC 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7" />ताआ वाटे जातु रो, ताआ रोटू खुसी वाअहीं खाया कोअ, आन मोनोमेहें सुख मानित कोइत दाराक्शाआ होरु पिया कोअ; काहाके देव ताआ कामों वाअहीं खुस होय. <verse eid="ECC 9:7" /><verse number="8" style="v" sid="ECC 9:8" />ताआ आंगड़े हादाफल उजले रोअहूं जोवे, तुमाआ मुन्कापोअ हादाफल तेल लागाड़ल्यो रोअहुं जोवे.<verse eid="ECC 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 9:9" />देव धरतीपोअ या वाया जिवनोअ जेताहा बी दिही आप्याहा, तियामेहें ताआ मेराली लाडीइरी जिवन जिवीइलोअ खुसी कोआ, काहाके जिवनोमेहें ओंज तुमाआं भाग होय. जे मेहेंनत तुमू धरतीपोअ कोअतेहे तियामेहें ओज तुमाआं भाग होय. <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />तुमांआं आथोमेहें जो काम जोड़े तियाहा पुरी सेक्तीइ वाअहीं कोअजा, काहाके पातालोमेहें जिहीं तुमू तुमांआं मोतोअ फासाड़ी जाहा तिहीं किज काम ने, कदर ने, हुशारी ने, के बुद्दी नाहां.<verse eid="ECC 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11" />फाशोअ आंय यी धरतीपोअ पाल्यो, के जोरे गुगदीइनारो नाहां जिकतो आन लड़ायीमेहें बाहदीर नाहां जिकतू. हुशार माहुंहूं खाअहूं रोटू नाहां जोड़तू, आन समजदारोहो मालमिलकत नाहां मिलती आन ग्यानीही मेरवानी नाहां जोड़ती. ओं आखो वेलोअ आथोम होय. <verse eid="ECC 9:11" /><verse number="12" style="v" sid="ECC 9:12" />काहाके माहुंउं तियाआ वेल नाहां जांअतो. जेहेलोहो मासे अड़सनीम टाकनारी जालेमेहें आन सिड़े फांदामेहें फोसीत जातेहे, तेहेंज कोइत माहुंउं दुखोअ जालेमेहें फोसीत जाहे आन ए जाल कोत कोइत नाहां आवती.<verse eid="ECC 9:12" /></para>
  <para style="s">बुद्दी आन फोगायीइ बाप्तिम विसार</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />आंय धरतीपोअ बुद्दीइ एक उदाहरण बी पाल्यो. ओं माहूं जाअखो खास हासवाअयो. <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />एक हानो एवडोहो होयर ओतो, जियामेहें थोड़ेज माअहें रोतेते, आन एक दिही एक वोडु राजा ताड़ बांदीत कोइत केंडवारीत लेदो. <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />पोन तियामेहें एक गरीब बुद्दीमान माटी ओतु, आन तिये तिया होयरोहो तियाआ बुद्दी वाअहीं वासाड़्यो. तेबी तिया गरब्योहो आक्खे माअहें विहीरात गोये. <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />ताहां आंय कोयो, “जर गोरब्योअ बुद्दी कमी गोणाअती ओय, आन तियाआ गोठ कोडोज ने उनाअतोय तेबी सेक्तीइ रोत बुद्दी वादार हाजी होय.” <verse eid="ECC 9:16" /><verse number="17" style="v" sid="ECC 9:17" />फोगाआ विसमेहें राजाआ आअड़ीत कोइत गोगीइलो रोत जी एखलामेहें बुद्दीमानोअ गोठी उनाइत लेअलोअ केतोहो हाजो होय. <verse eid="ECC 9:17" /><verse number="18" style="v" sid="ECC 9:18" />लड़ायीइ आथ्यारो रोत बुद्दी वादार हाजी होय, पोन एक पापी माहुंउं जाअखीली हाजी गोठीही आरवी देहे.<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 10:1" />जेहलोहो मोल्या माखा वाअहीं पुरो अत्तर बिगड़ीत जाहे; आन जारिक फोगायी वाअहीं बुद्दी आन हाजो नाव खाराब ओत जाहे.<verse eid="ECC 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 10:2" />बुद्दीमानोअ मोन हाजी गोठीमेहें लागीत रोहे, पोन फोगाआ मोन खाराब गोठीमेहें रोहे. <verse eid="ECC 10:2" /><verse number="3" style="v" sid="ECC 10:3" />फोगो जेहेलाम वाटे सालेहे, ताहां तियाआ सालीइलो वाअहींज तियाआ फोगाय देखाअहे, जिया वाअहीं माअहें देखीत लेतेहे के तों फोगो होय.<verse eid="ECC 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 10:4" />जर आधिकारी तुमा वाअहीं खिजवात जाय, ताहां तुमू तुमाआं जागु मा सोड़हा, काहाके धिर खेटीइलो वाअहीं वोडा वोडा गुना रुकाअताहा.<verse eid="ECC 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ECC 10:5" />आंय धरतीपोअ एक बाक्ती गोठ पाल्यी आन ते आधिकारीइ सुकी वाअहीं ओवेहे. <verse eid="ECC 10:5" /><verse number="6" style="v" sid="ECC 10:6" />फोगाआ वोडा पदोअ कोअते निवड़ ओवेहे, आन मालदार माहें निसे बोहतेहे. <verse eid="ECC 10:6" /><verse number="7" style="v" sid="ECC 10:7" />आंय पावरोहो कोड़ापोअ बोहीत जात्लाहा पाल्यो, आन राजकुमारोहो गुलामोअ होस पागेज सालत्लाहा पाल्योहो.<verse eid="ECC 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 10:8" />जो खाडू खुएं, तोज तियाम पोड़े, आन जो वाड़ तोड़े तियाहा हाप टोसे.<note caller="+" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="PSA 7:15">भजन 7:15</ref>; <ref loc="PRO 26:27">निती 26:27</ref></char></note> <verse eid="ECC 10:8" /><verse number="9" style="v" sid="ECC 10:9" />जो हेडाआ डोण हारे, तोज हिद्लाआ डोणोवाअहीं दुखाय, आन जो लाकड़े वाडे, तियाहा तियाआ बिक रोय. <verse eid="ECC 10:9" /><verse number="10" style="v" sid="ECC 10:10" />जर कुवाड़ो बोगदो ओय आन माहुंउं तियाहा ने निहांणे, ताहां जाअखो जोर लागाडुहूं पोड़े; पोन ओकल वापरे ताहां फल जोड़े. <verse eid="ECC 10:10" /><verse number="11" style="v" sid="ECC 10:11" />जर मोत्रीइनारा रोत पेल हाप टोसी देय, ताहां मोत्रीइनाराआ कि लाब? <verse eid="ECC 10:11" /><verse number="12" style="v" sid="ECC 10:12" />सिहांणा माअहोंअ जिबानी वाअहीं तियांहां मानपान जोड़ीत जाहे, पोन फोगे सोताआज जिबानी वाअहीं आरवाअतेहें. <verse eid="ECC 10:12" /><verse number="13" style="v" sid="ECC 10:13" />फोगाआ सोबीम रोत निहींल्ये शब्दे सुरुवाती रोत ते सेवट जाआं फोगवाअलेज रोतेहे आन तियाआ फल फोगायीइज रोहे. <verse eid="ECC 10:13" /><verse number="14" style="v" sid="ECC 10:14" />फोगे माहें जाअखीलीही गोठी वादाड़ीत कोइत कोतेहे,</para>
  <para style="p" vid="ECC 10:14">तेबी एखु माहुंउं नाहां जांअतो के कि ओवनारो होय, आन कोडो कोत सेकेहे के याआ फासाड़ी कि ओवनारो होय?<verse eid="ECC 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 10:15" />फोगाआ मेहेंनत तियाहा थाकाड़ी देहे, एतीही थाकाड़ेहे के तों कोओअ वाट बी विहीरात जाहे.<verse eid="ECC 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 10:16" />ए देस, जर ताआ राजा कोवलू जुवान ओय; आन ताआ आधिकारी उग्ये दिहे खाअला पिइलाम एताज लागीत रोताय, ताहां ताआ केतीही विते! <verse eid="ECC 10:16" /><verse number="17" style="v" sid="ECC 10:17" />ए देस, जर ताआ राजा हाजा कुटूंबामेएं ओय आन आन ताआ आधिकारी वेलेपोअ खातान पिताय, आन तेबी जिंगवाइलोअ काजे नाहां, पोन सेक्तीइ काजे खाताय! ताहां ताआ हाजो होय!<verse eid="ECC 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 10:18" />आलहाय कोअत्ले ताहां कोओअ पाहू खेकरात पोड़त्लू; आन आथोअ उजगायी कोअ गोलत्लो.<verse eid="ECC 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ECC 10:19" />पांगात मोज्यादानोअ काजे ओवेहे, आन दाराक्शाआ रोहो वाअहीं जिवनोमेहें खुसी मिलेहे; आन पोशा वाअहीं आखोज जोड़ेहे.<verse eid="ECC 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ECC 10:20" />राजाहा मोनोमेहें जाआं हाराप मा आपही, आन कुन्ब्योहो ओडोल डोए हाराप मा आपही; नेते एखु सिड़ो उडीत ताआ गोठ पोताड़ी देय.<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s">बुद्दीमानोअ सोभाव</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 11:1" />तुमाआ पोशा हाजी जागे लागाड़ा, ताहां सेलवाआ थोड़ाक दिहोमेहें तियाआ फायदू तुमुहूं जोड़े. <verse eid="ECC 11:1" /><verse number="2" style="v" sid="ECC 11:2" />तु हांत कि पोन आंठ जोओंहों वाटीत आप, काहाके ताहूं नाहां मुंदू धरतीपोअ कि आफत आवनारी होय.<verse eid="ECC 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 11:3" />जर वाद्लामेहें पाईं ओय, ताहां वोरहात पोड़नारुज. साड़ जर देहामाआ वोग नेत पालामाआ वोग पोड़्यो, ताहां तों जिहीं पोड़े तिहींज रोनारो. <verse eid="ECC 11:3" /><verse number="4" style="v" sid="ECC 11:4" />जर तुमू वाराहा पाल्या कोअहा, ताहां बियारु ओइत ने सेकहा; जर तुमू वाद्लाहा पालते रोये ताहां केदिहीं वाडीत ने सेकहा. <verse eid="ECC 11:4" /><verse number="5" style="v" sid="ECC 11:5" />वारो केहें रोत लागेहे ओं तुमुहूं नाहां जाआंतो. आन याह्हीइ पोटामेहें पोऱ्यो केहें कोइत वोडो ओवेहे तों बी तुमुहूं नाहां मुंदू, तेहेंज कोइत जिये आखो बोणायोहो तिया देवोअ कामोहों तुमू नाहां जाईंत सेकते. <verse eid="ECC 11:5" /><verse number="6" style="v" sid="ECC 11:6" />तियाहा कोत वेगऱ्योअ ओइलोअ सालु कोइ द्या आन हांजे वेले जाआं मा रुकाअहा; काहाके काअली गोठीम तुमुहूं फायदू जोड़े तों ने कोत सेकाय, केहेंनेत याम नेत फोलाम, नेताहां बेनुमेहें फायदू ओत सेकेहे.<verse eid="ECC 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 11:7" />उजालो हाजो होय, आन दिहोअ उजालो डोआहा हाजो गोमेहे. <verse eid="ECC 11:7" /><verse number="8" style="v" sid="ECC 11:8" />जर माहुंउं जाअखा दिही जिवतो रोयो, ताहां तों तियां आखा दिहोम खुस रोअहूं जोवे; काहाके आंदाराआ दिही बी जाअखा रोनाराहा ओं बी तियाहा ओर मिकुहूं पोड़े. जों किबी ओवेहे तों आखो वायाज होय.<verse eid="ECC 11:8" /></para>
  <para style="s">जुवान्याहां सल्लु</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9" />ए जुवान, ताआ जुवानीमेहें मोज्या कोअ, आन ताआ जुवानीइ दिहोमेहें खुस रो; आन ताआ मोनोहो पोटे तेहें कोइत साल आन देखाय तिवोल जा; पोन यीं आखी गोठीइ बाप्तिमेहें देव ताआ इसाब लेनारु होय ओं तु ओर मिक.<verse eid="ECC 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 11:10" />ताआ मोनोमेहें रोत नाराजी काडीत टाक, डिलोहो तारास मा ओवुहूं देही; काहाके कोवली वय आन जुवानी बेनु वाया होय.<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1" />ताआ जुवानीइ दिहोमेहें ताआ बोणावनाराआ ओर मिक, पाल, खाराब दिही आवताहा, आन एहेलेहे वोरह्ये आहने आवतेहे, के जियांमेहें तु कोही, “माहूं मोज्या नाहां आवती.” <verse eid="ECC 12:1" /><verse number="2" style="v" sid="ECC 12:2" />तेहलाम दिहीन सांदेन ताराआ उजालो लुपाओ वोले, वोरहात पोड़ीत जाय तेबी वाद्लो आवयाज कोए. <verse eid="ECC 12:2" /><verse number="3" style="v" sid="ECC 12:3" />तेदिहीं जागल्या कापा वोले, तोगड़ा माटी डिला पोड़े; बोगरा ओत जाय ताहां सावाओ ने वोले, आन डुसे पालनारा डोआ आंद्ला ओत जाय. <verse eid="ECC 12:3" /><verse number="4" style="v" sid="ECC 12:4" />वाटे सालनाराआ आवाज कानो वाअहीं ने होंबलाउ वोले, आन दोइलोअ<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="fq" closed="false">दोइलोअ </char><char style="ft" closed="false">दातोवाअहीं सिणो कोइलोअ</char></note> बोंद ओत जाय, आन सिड़ाआ आवाजो वाअहीं तियाआ बी निंद उडीत जाय, आन आखा गावनाराआ आवाज धिमु ओत जाय. <verse eid="ECC 12:4" /><verse number="5" style="v" sid="ECC 12:5" />उसवाहा देखीत बिक लागी वोले. वाट बी बिक लागे एहलीही देखाइ वोले, बादामोअ साड़ोअ होस तुमाआं सिंग्ये फुलीत जाय. टिडाआ होस जिव पाअयू लागू वोले, जिवीइलोअ आहरु रोत जाय,</para>
  <para style="p" vid="ECC 12:5">काहाके माहुंउं सेवटीपोअ तियी कोली हादाफल्यीइ जागे जाअहूं वाटे लागे, तिहीं रोत मुंडी तोइत रोड़नारे सड़के-सड़के फिरे.<verse eid="ECC 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ECC 12:6" />तियी वेले सांदीइ तार टुटीत जाय आन होनाआ वाटकू फुटीत जाय, आन पाअयोंअहीं टोसवो फुटीत जाय, आन वेईपोऱ्योअ फिरको टुटीत जाय. <verse eid="ECC 12:6" /><verse number="7" style="v" sid="ECC 12:7" />ताहां कादुउ कादवोजमेहें पेलाइत जाय, आन देवे आपल्यू जिव देवोअहींज जातु रोय.<verse eid="ECC 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 12:8" />उपदेशक कोहे, वायाज होय, वायाज होय! आखो बादो वायाज होय.<verse eid="ECC 12:8" /></para>
  <para style="s">मोनवीइ आखी जबाबदारी</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />उपदेशक जो बुद्दीमान ओतु, तो माहुंहूं ग्यान बी सिकाड़तुतो, आन दिहान लागाड़ीत कोइत आन जाईंत फारकीत कोइत वारुज नितीवसने वारुहूं लेख्ये. <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />हुदो लेखल्यो सत्य आन हाजो वसन होदीइलोअ काजे उपदेशोके कोशित कोअयीही. <verse eid="ECC 12:10" /><verse number="11" style="v" sid="ECC 12:11" />बुद्दीमानोअ गोठ्यी पेराणाआ होस रोतीही, आन सभाआ आधिकाऱ्योअ गोठी ठोकल्या खिलाआ होस रोतीही, काहाके ते एकाज सारवाल्योपोअ रोत जोड़तीही.<verse eid="ECC 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 12:12" />ए माआ पोऱ्या, हिकवणोअ बाप्तिम सुसना आपुहूं कोअहो. पुस्तके लेखीइलोअ नाहां रुकाअतो, आन जाअखे पुस्तके वासीइलोअ बी डिलोहो थाकाड़ी देहे.<verse eid="ECC 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 12:13" />जों किबी तुमू उनाअयेहे; याम रोत ओं सिकाअहूं जोड़ेहे के देवोहो बित कोइत साला आन तियाआ आदेशोअ पालन कोआ; काहाके माहुंउं ओंज काम होय.<verse eid="ECC 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 12:14" />काहाके देव आखा कामोअ आन आखी निकाअली गोठीइ न्याय कोए, ते हाजी ओय नेत बाक्ती ओय.<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>