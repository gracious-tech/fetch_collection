<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Noiri</book>
  <para style="h">1 तिमथ्या</para>
  <para style="toc3">1 तिम</para>
  <para style="toc2">1 तिम</para>
  <para style="toc1">तिमथ्याहा प्रेशित पौलुसोअ पेहलो पत्र</para>
  <para style="mt2">तिमथ्याला प्रेशित पौलाचे पहिले पत्र</para>
  <para style="mt1">तिमथ्याहा प्रेशित पौलुसोअ पेहलो पत्र</para>
  <para style="imt">ओलखात</para>
  <para style="ip">तिमथ्याआ ओं पत्र प्रेशित पौलुसोअ तरफ से तियाआ सेलू तिमथ्याहा लेख्योहो. ओं पत्र एक आंदास ईसुउ जल्माआं फासाड़ी 62-64 यां सालोमेहें लेखाअयोये. ओं पत्र पौलुसोअ जिवनोअ सेलीसेलवाअ जेहें लेखाअयोये. पौलुसोअ तिमथ्याअरी जाअखी आहनेएं नातो ओतो, आन तिहींज वाईं तिये तियाहा वारुज वाआ बेटुह्हू एहें कोत गोगाड़ेहे.<char style="xt"><ref loc="PHP 2:22">फिलि 2:22</ref></char>, <char style="xt"><ref loc="1TI 1:2">1 तिम 1:2</ref></char>,<char style="xt"><ref loc="1TI 1:18">1:18</ref> </char></para>
  <para style="ip">पौलुसोअ शार पत्रामेहें रोत ओं एक पत्र होय, जों एकी मंडड़ीइ बोदले एका माहुंहूं कोहे. बिहीरे तीन पत्रे मोन्ज्ये 2 तिमथ्या, तितुस, आन फिलेमोन एं होय. तिमथ्याआ पेहला पत्रामेहें मंडड़ी मेऱ्यीइ भक्तीइ बाप्तिमेहें वारुज सुसना कोत आप्यीही <char style="xt"><ref loc="1TI 2:1-15">2:1-15</ref></char> मंडड़ीइ पुढाऱ्योंओं कोअते शिक्शण <char style="xt"><ref loc="1TI 3:1-13">3:1-13</ref></char> आन ठोग मास्तरोंओं विरुध्दाम सुसना. <char style="xt"><ref loc="1TI 1:1-11">1:1-11</ref>,</char> <char style="xt"><ref loc="1TI 4:1-5">4:1-5</ref></char>, <char style="xt"><ref loc="1TI 6:1-5">6:1-5</ref></char> या पत्रा वाअहीं आपुहूं ओं समजाअहे के, पौलुस तिमथ्याहा मंडड़ीइ पुढारी बोणिइलोअ काजेहे किरंगो शिक्शण आपतुतो. या पत्रामेहें वारुज एहेलिही गोठी कोत आप्यीही, के जे आज्याआ दिहोमेहें मंडड़ीइ सेवकोहों हानी हानी मंडड़ी सालाडीइलोअ काजे कामोम आवित सेकतीही.</para>
  <para style="iot">रुप-रेशा</para>
  <para style="io1">1. पौलुस तिमथ्याहा सलाम कोअतू जात सुरवात कोअहे <char style="ior"><ref loc="1TI 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. फाशुउ तो ठोग मास्तरोंओं विरुद्धामेहें सुसना आपेहे <char style="xt"><ref loc="1TI 1:3-11">1:3-11</ref> </char></para>
  <para style="io1">3. तिहींइं फासाड़ी पौलुस ईसु ख्रिस्ताआ काजे देवोअ आभार मानेहे <char style="xt"><ref loc="1TI 1:12-19">1:12-19</ref> </char></para>
  <para style="io1">4. आगाड़ी तो तिमथ्याहा आराधना आन मंडड़ीइ सेवकोअ बाप्तिम सुसना आपेहे. <char style="xt"><ref loc="1TI 2-3">2—3</ref> </char></para>
  <para style="io1">5. पौलुस तिमथ्याहा आखरीइ सुसना आपतुज पत्र लेखीइलोअ बंद कोअहे.<char style="ior"><ref loc="1TI 4-6">4—6</ref></char></para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />पौलुसोअ तरफ रोत जो आपाअ तारनारु देव आन आपाआ आशाआ आधारो वाईं ख्रिस्त ईसुउ आदेशो वाअहीं प्रेशित होय,<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />तिमथ्याआ नावसे जो विश्वासो मेहें माआं खोरलु बेटुह्हू होय: देव बाह्हू, आन आपाअ प्रभु ख्रिस्त ईसु पोअ रोत ताहूं मेरवानी, दया आन होक मिलतू रोये.<verse eid="1TI 1:2" /></para>
  <para style="s">ठोगोअ शिक्शणोअ विरुद्दाम सेतावणी</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />जेहें कोइत आंय मकिदुनिया जाअलोअ वेले ताहूं समजाड़्योतो, के इफिसोमेहें रोत कोइत थोड़ाक माअहुंहूं आदेश आप के आलांग जातीइ‍ शिक्शण ने आपुहूं जोवे. <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />आन तियीं काईं आन पिढीन पिढ़ीइ पारवाड़ी पोअ मोन ने लागाड़े तेहें, जियां वाअहीं बिगर कामोंअ भान्गड़ी ओवतिही, आन देवोअ तियी योजनाअ अनुसार नाहां, जे विश्वासोअ आधारो पोअ होय. तेहेंज कोइत फाश्यु बी कोहो. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />आदेशोअ उद्देश ओ होय के, सोको मोन आन हाजी बुद्दी, आन खोरा विश्वासोअ मेरे वाअहीं सेकलाअहूं जोवे. <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />यां हाजा गुणोहों सोड़ीत कोइत केतेहे माअहें फालतू गोठीम लागीत गोयेहे, <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />आन तियांआं कायदाअ मास्तर बोणिइलोअ इश्शा ते होय, पोन जे गोठी कोतेहे आन हिम्मत काडीत गोगतेहे, ते गोठी तियांहांज नाहां समजाअती.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />पोन आमुहूं मुंदू होय के जर एखो कायदाहा बोराबर कामोम वापरे ताहां तो हाजो होय. <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />ओं होमजीत के कायदु हाजा माहुंउं काजे नाहां, पोन कायदाअ तोडनारा, गुनू कोअनारा, विणभक्तीवाला, एठे कामे कोअनारा, देवोअ गोठी ने माननारा, आन पापी, आयहीन- आब्हाहा माअनारा, खुन कोअनारा, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />सिनाल, माट्योअरी माटीज राखाअनारा, माहुंहूं वेसीत खानारा, ठोगनारा, ठोगोअ शप्पोत खानारा, आन याअ रोत बी खोरा शिक्शणोअ विरोध कोअनाराअ काजेहे ठरवाअयुहू. <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />एज वोडी हाजाम हाजी हिकवोण देवोअ महिमाअ तियी हाजी बातमीइ इसाबोवाअहीं होय जे माहूं होप्यीही.<verse eid="1TI 1:11" /></para>
  <para style="s">देवोअ दयाअ काजेहे आभार</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />आंय आपाअ प्रभु ख्रिस्त ईसुउ जिये माहूं ताकत आप्यीही, आभार मानोहों के तिये माहूं इमानदार समजीत तियाआ सेवाआ काजेहे ठरव्युहू. <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />आंय तोम पेल रोवा कोअनारु<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="fq" closed="false">रोवा कोअनारु </char><char style="ft" closed="false">निंदा कोअनारु</char></note>, आन तारास देनारु, अपमान कोअनारु ओतू; तेबी देवोअ दया मापोअ ओवयीही, काहाके आंय बिगर विश्वासोअ दशामेहें विण जांअयेंज एं कामे कोअयेते. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />आन आपाअ प्रभुउ मेरवानी तिया विश्वासोअ आन मेरे वाईं जे ख्रिस्त ईसु मेहें होय, जाअखीलिही ओयी. <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />ए गोठी खोरीज मानुहूं जोगिही आन विश्वास कोअहूं जोगीही होय के, ख्रिस्त ईसु पापी माहुंउं सुटका कोइलोअ काजेहे दुन्यामेहें आयू, जिहींमेहें आखाम रोत वोडू पापी आंयज होय. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />पोन मापोअ एताआ काजे दया ओवीही के, माआं सारका आखाम रोत वोडा पाप्योमेहें ईसु ख्रिस्त सोताआ पुरी सहनसेक्ती देखाड़ीत सेके, काहाके आगाड़ी जें माअहें तियापोअ अमर जिवनोअ कोअते विश्वास मिके, तियांआं काजे आंय एक नमुनू बोणित सेको. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />ओमे सनातन राजा मोन्ज्ये अमर, ने देखाअनारा, एक्काज देवोअ आदर आन महिमा पिढ़ीन पिढ़ी ओवती रोअहूं जोवे! आमेन.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />ए माआं पोर्‍या तिमथ्या, आंय ओ आदेश भविश्यवाणीइ शब्दाआ परमाणे होपोहो, जो पेल ताआ बाप्तिमेहें आप्युतो, के तू तियां शब्दाआ आथ्यारोअ होस हाजी लढ़ायीमेहें वापर कोअहूं जोवे. <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />आन विश्वास आन तियी हाजी ओकलेहे मजबुत मिक, जियीही सेटे कोइलो वाअहीं केताहा जोंओंअ विश्वास खुटात गोयुहू. <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />तियांज मेर्‍याआ हुमिनयुस आन अलेक्झान्डर होय, जियांहां आंय डोंड भोगेतेहें काजे सैतानोअ आथोम होपी देदाहा, के ते देवोअ निंदा कोइलोअ बंद कोअहूं जोवे.<verse eid="1TI 1:20" /></para>
  <para style="b" />
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">मंडड़ीइ आराधना</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />ओमे आंय आखा रोत पेल ए विनंती कोअहो के, विनंती, प्रार्थना, निवेदन आन ध‍न्यवाद आखा माअहोंअ काजे कोअहूं जोवे. <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />राजहां आन बादा उसा पदोवालाआ वाखरी याअ काजे प्रार्थना कोआ, काहाके आपुहूं आरामसीर आन होकेहे पुरी भक्ती मेहें आन वारुहूं जिवन जिवीत सेकाय. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />ओं आपुहूं वासाड़नारा देवोहो हाजो लागेहे आन गोमेहें बी, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />तो ओं होदेहे के आक्खा माअहुंउं सुटका ओवुहूं जोवे, आन ते सत्याआ ओकलेहे हाजीहुतायी ओलखीत लेय. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />काहाके देव एकुज होय,आना देवोअ आन माअहोंअ विसमेहें मोन्जे माहुंउं जो ईसु ख्रिस्त ओ माटी एक्कुज वोग्यु होय. <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />जिये आखाआ सुटकाअ काजेहे सोताहा आपी देदू, आन तियाआ साक्शी बोराबर वेले पोअ आपाअयी. <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />आंय खोरीज कोहो, नाहां ठोगतु, के आंय या उद्देशो वाअहीं परसारक आन प्रेशित आन बिगर यहुदीइ काजे खोरा विश्वासोअ मास्तर सत्याआ पुकारु कोअनारु ठरवाअयुहू.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />तियाहा काजे माअ इश्शा होय के हारेक उपासोअ जागे माटी विण खोतेए आन बिगर सोबी लाग्येज पवित्र आथोहो उसा कोइत प्रार्थना कोअया कोआ. <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />तेहेंज कोइत बोईं बी विश्वास आन समजदारीम हाजा साअका वाअहीं सोताहा होबाड़ुहूं जोवे; निस्त सिंग्ये गुथीइलो आन होनो, मोती आन मोगला साअका वाअहीं एतोज नाहां; <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />पोन हाजा कामों वाअहीं, काहाके देवोअ भक्ती कोअनारी बायहींहीं ओंज होबेहे बी. <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />बोईं ठावकीज रोत पुरा ताबामेहें रोत कोइत सिकाअहूं जोवे. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />आंय कोहो के बोईंहीं सिकाडीलाअ परवानगी कायनाहां, आन माट्योपोअ आधिकार सालाडीलाअ परवानगी कायनाहां, पोन ठावकीज रोअहूं जोवे. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />काहाके आदाम पेल, तिहींइं फासाड़ी हव्वाहा बोणावयी. <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />आन आदाम नाहां ठोगाअयु, पोन बोईं ठोगाइत कोइत देवोअ नियम तोड़्यू. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />तेबी बोईं पोर्‍ये जोणीइलो वाईं वासाइत जाय, जर ते समजदारीम विश्वास, मेर, आन सोकायीमेहें मजबुत रोय ताहां.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">मंडड़ीइ पुढारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />ए गोठ खोरी होय के जो आदिक्श बोणुहूं होदेहे, तो हाजा कामोंअ इश्शा कोअहे. <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />ओं गरजेए होय के सेवक निर्दुस, आन एकीज बोईंइ माटी, संयमी, हाजो मोन, हाजो नाव, पावणाय तोअनारु, आन सिकाडीइलो मेहें पाक्कू हुशार जोवे. <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />साकल्यु नेत सुलाअनारु ने जोवे; पोन नरम रोअहूं जोवे, आन ने भान्गड्यु, आन ने पोशाअ लालसी जोवे. <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />तियाआ कोर्‍याआ माहुंउं हाजी देखबाल कोअनारु जोवे, आन तियाआ पोर्‍याहां हाजी हुतायी ताबाम मेकनारु जोवे. <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />जेहेलाम एखु कुटूंबाआ देखबाल हाजी हुतायी ने कोइत सेकतुय, ताहां देवोअ मंडड़ीइ माअहुंहूं केहें कोइत सांबलीत सेके? <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />फाश्यो ओं के नोवू विश्वासी ने जोवे, एहेलोह ने ओवुहूं जोवे के तो वोडाय कोइत सैतानोअ होस डोंड हाटवे. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />आन बारथेए माहूंम बी तियाआ हाजो नाव जोवे, नाव खाराब कोइत सैतानोअ फांदाम फोसीत जाय एहलोहो ने ओवुहूं जोवे.<verse eid="1TI 3:7" /></para>
  <para style="s">मंडड़ीइ सेवक</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />तेहेंज कोइत सेवकोअ बी सोभाव हाजू जोवे, आन बेन मुंड्यू ने जोवे, दाराक्शाआ रोह पित झिंगवाअनारु ने जोवे आन खाराब वाटेएहें रोत पोशा कामाविलाआ लालस ने जोवे; <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />पोन विश्वासोअ गोठीही सोका मोनो वाअहीं सांबालित मिकुहूं जोवे. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />आन ए बी पेल फारकीत पालाअहूं जोवे, जाहां जर निर्दुस निहें, ताहां सेवकोअ काम कोअहूं जोवे. <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />एहेंज कोइत बोईं बी हाजा सोभावोअ रोअहूं जोवे; साड़ग्यी ने जोवे, पोन मस्तेए आन आखी गोठीम इमानदार जोवे. <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />सेवक एकुज लाडीवालू जोवे, आन तियाहा पोर्‍ये आन सोताआ परिवारोअ हाजी देखबाल कोइलाआ मुंदू जोवे. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />काहाके जे सेवकोअ काम हाजीहुतायी कोइत सेकतेहे, तियांहां सोताआ काजे हाजू जागू आन ख्रिस्त ईसु पोऱ्याआ विश्वासो वाईं वोडी हिम्मत जोड़ेहे.<verse eid="1TI 3:13" /></para>
  <para style="s">दोडपाअली वोडी गोठ</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />आंय ताआ जागे वेगु आविइलोअ आशा कोअहो तेबी ए गोठी ताहूं याअकाजे लेखोहो के, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />तेबी जर माअ आविइला मेहें वाआ लागे, ताहां तू जाइंत लेजी जे जिवता देवोअ मंडड़ी होय आन जो सत्याआ खांबू आन पायू होय, तिया देवोअ कुटुंबामेहें केहें कोइत सालुहूं जोवे, ओं ताहूं समजाअहूं जोवे. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />यामेहें किज फिकर कायनाहां के भक्तीइ दोडपाअली गोठ सादी कायनाहां, मोन्ज्ये,</para>
  <para style="q1" vid="1TI 3:16">तो जो माहुंउं बोणीत कोइत आयू,</para>
  <para style="q2" vid="1TI 3:16">आत्मामेहें धर्मी ठर्‍यु, देवदुतोहों देखाअयू,</para>
  <para style="q2" vid="1TI 3:16">देसो-देसोमेहें तियाआ परसार ओवू,</para>
  <para style="q1" vid="1TI 3:16">आन दुन्यामेहें तियापोअ विश्वास कोआयू</para>
  <para style="q2" vid="1TI 3:16">आन तो महिमामेहें उसे विसाइत गोयू.<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">ठोगरा मास्तर</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />पोन आत्मा वारुहूंज कोहे के आवनारी वेलेमेहें केतेहे तेबी माअहें विश्वास सोड़ी देत कोइत, ठोगरी आन पुतोअ आत्माआं शिक्शणोअहें मोन लागाडे. <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />ओं तियां ठोगनाराआं लबाड़ीइ वाखरी ओवे, जियांआं मोन तोपीवल्या वारांगा वाअहीं डाजवीइल्याअ होस होय, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />तें एहेलोह सिकाड़े के, वेहवाल कोइलो सुकीइ होये, आन अमुक-ढमुक वस्तु ने खाअहूं जोवे,पोन ए वस्तु देवे याअ काजे बोणावयी के विश्वासी आन सत्याहा ओलखीइनारे माहें तियींहीं आभार मानित खाअहूं जोवे. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />काहाके देवोअ बोणावल्यी आखी वस्तु हाजी होय, आन कोड्लीज वस्तु नाकारे एहेलिही कायने; पोन ओंज के आभार मानित कोइत खाअहूं जोवे. <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />काहाके देवोअ वसन आन प्रार्थना वाअहीं सोकी ओत जाहे.<verse eid="1TI 4:5" /></para>
  <para style="s">ख्रिस्त ईसुउ हाजू सेवक</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />जर तू विश्वासी माअहोंहों यीं गोठीहीं ओर कोइत आपतू लेही, ताहां ख्रिस्त ईसुउ हाजू सेवक बोणही; आन विश्वास, तियी हाजी शिक्शणोअ गोठी वाअहीं, जे तु मानतु आयुहू, ताआ पालन पोशण ओवतो रोये. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />पोन सोगद्यीइलीही आन डुकर्‍याआं काईंहीं मा उनाअही; आन हाजी भक्तीवाला जिवनोअ सवाय लागाड़. <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />काहाके डिलोअ वायाम कोइलो वाअहीं फायदू कमी ओवेहे, पोन भक्तीइ वायाम कोइला वाईं आखा कामोम लाभ होय, काहाके यी वेलेए आन आवनारा जिवनोअ बी आथवसन याआज काजे होय. <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />ए गोठ खोरी आन हुदाअलीज मानुहूं जोगीही होय. <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />काहाके आमू मेहेंनत आन कोशित याआज काजे कोअताहा के आमाअ आशा तिया जिवता देवो पोअ होय, जो आखा माअहुंउं आन खास कोइत विश्वासी माअहोंअ तारनारु होय.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />यीं गोठीइ सुसना आप आन सिकाडतु रो. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />कोडो ताआ जुवान वयोहो कमी ने समजुहूं जोवे; पोन वसन, सोभाव, मेर, विश्वास आन पवित्रता मेहें विश्वाश्याआं काजे नमुनू बोणीत जा. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />जाअहूं जाआं आंय ने आवो, ताअहूं जाआं देवोअ वसन वासीइलो, ओकल देअलो आन सिकाड़ीइलोमेहें लागीत रो. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />तिया वरदानोअ बाप्तिमेहें जो तामेहें होय,आन भविश्यवाणी वाअहीं मंडड़ीइ डायहांअ आथ मेकतामेहें जोड़्योतो, तियाहा टालही मा. <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />यीं गोठीइ विसार कोअतू रो आन यींज गोठी मेहें ताआ ध्यान लागाड़ीत मिक. याअ काजे के ताआ कामाय आखाहा देखाअहूं जोवे. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />ताआ आन तुमे आपल्या शिक्शणोअ ओर मिक. यीं गोठी पोअ वातड़ू रो, जर एहें कोअतू रोही, ताहां तु बी वासाअही आन ताआ होंबलीत सालनाराहां बी वासाड़ही.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">विश्वासीइ बाप्तिम जाबाबदारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />कोडा डाया माहुंहूं मा गाई देही, पोन तियाहा आब्हू जांइत समजाड़ी दे, आन जुवान्याहां पाही जांइत कोइत समजाड़; <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />डायी बोईंहीं आयही जांइत कोइत; आन जुवान बोईंहीं पुरा सोका मोनो वाअहीं बोअह्हीं जांइत कोइत समजाड़ी दे.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />जे बायहीं खोरीज रोंडाअली होय, तियींइं आदर कोअ. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />जर रोंडाअली बायीइ पोऱ्ये नेत पोऱ्याआ पोऱ्ये ओय, ताहां तें पुरो कुटूंबोज विश्वासोम सोताआ जबाबदारी पुरी कोअहूं, आन सोताआ आयहीन आब्हाआ आन वोडाब्हा आन वोडी याह्हीही तियांआं हक्क आपुहूं जोवे, काहाके ओ देवोहो गोमेहें. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />जे बाय खोराखोर रोंडोअ होय, आन तियीइ कोडोज कायनाहां, ते देवो पोअ आशा मिकेहे; आन रातेन दिही विनंती आन प्रार्थना मेहें लागीत रोहे; <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />पोन जे लालसो मेहें पोड़ीत गोयी, ते जिवताइज मोइत गोयीही. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />यीं गोठीइ बी आदेश आपतू ले के ते निर्दुस रोअहूं जोवे. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />पोन जर एखू सोताआ माअहुंउं आन खास कोइत तियाआ सोताआ कुटूंबाअ कालजी ने कोए, ताहां तो विश्वासोमरोत सोब मुअडीत लेदीही आन बिगरविश्वासीइ रोत बी उत्यार बोणीत गोयुहू.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />जे साठ वोरह्यों रोत वादार ओय तियींज रोंडोअ बायीइ नाव टिपाअहूं जोवे, आन तेबी एकाज माट्योअ लाडी रोयीय ताहां, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />आन हाजा कामोम नावासी ओय, जियी पोर्‍याहां वारुहूं वेंडार्‍ये ओय; पावणाआं सेवा कोअयी ओय, पवित्र माअहुंउं गुडा तुवया ओय, दुखी माअहुंउं मदत कोअयी ओय, आन हारेक हाजा कामोमेहें मोन लागाड़्यो ओय.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />पोन जुवान रोंडोअ बायहींइं नावे मा लेखही. काहाके जाहां ते ख्रिस्ताआ विरोध कोइत लालसोमेहें पोड़ीत जातिही ताहां वेहवाल कोअहूं होदतीही, <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />आन दोशी ठरतीही, काहाके तियीं पेल्लुउ विश्वास सोड़ी देदुहू. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />तेहेलीहीज ते कोओं कोओं फिरीत कोइत आलह्यी टेवात जातीही, आन तेतोज नाहां, पोन विण इसाबेज साड़ी कोअती फिरतीही, आन बिहीराअ कामोम आथ बी टाक्ती फिरतीही आन खाराब गोठी गोगतीही. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />तियाहा काजे माआं ए इश्शा होय के जुवान रोंडोअ बायहीं वेहवाल कोइत लेअहूं जोवे, आन पोर्‍याहां जल्म आपुहूं जोवे, आन कोअबाआ सांबालुहूं जोवे, आन कोडा विरोद कोअनाराहा निंदा कोइलोअ सान्सो ने आपुहूं जोवे. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />काहाके थोड़ीक तोम भटकीत कोइत सैतानोअ फासाड़ी लागीत गोयीही. <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />जर एखा विश्वासीइहीं रोंडोअ बाय ओय, ताहां तोंज तियींइं मदत कोअहूं जोवे, काहाके मंडड़ी पोअ वोजू ने पोड़ुहूं जोवे, मोन्ज्ये मंडड़ी जे खोरीज रोंडाअली होय एहली बायहींइं मदत कोइत सेके.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />जे डायहां हाजे कामे कोअताहा, खास कोइत जे वसन उनाड़ीइलामेहें आन सिकाड़ीइलामेहें मेहेंनत कोअताहा ते बेन भाग आदरोअ लायक होय. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />काहाके वसन एहें कोहे के, “मोलनारा बोलदोअ सोबीज मुंहको मा बांदही,” काहाके “मोजुर तियाआ मोजरीइ हक्कदार होय.” <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />एखू गुनू एखा डायापोअ लागे, ताहां बेन नेताहां तीन साक्शीदारो सिवाय तियाहा मा उनाअही. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />पाप कोअनाराहा आखाआ सामने हेकाटी दे, के फाशे बिहरे बी बिइहूं जोवे.<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />देव आन ख्रिस्त ईसु आन निवड़ीइल्या देवदुतोहो हजर जांइत कोइत आंय ताहूं कोतापोहो के तू बेफिकऱ्यु यीं गोठीही मान्या कोअ, आन कोड्लोज काम भेदभावो वाअहीं मा कोअही. <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />देवोअ सेवाआ कोअते कोडापोअ उतवाल आथ मा मेकीहीं, आन बिहीराअ पापोमेहें मा पेलाअही; सोताआ जिवन पवित्र मिक.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />आवनारा दिहोम निस्तु पाईं एतोज पिनारु मा रोही, पोन ताआ पेटोअ काजे आन ताल-ताल बिमार पोडीइलाअ वाखरी थोड़-थोडू दाराक्शाआ रोह बी पिया कोअजी.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />थोड़हा माहुंउं पाप देखाइत जाताहा आन न्यायनिवाड़ाआ काजे आगाड़ीज पोतीत जाताहा, पोन थोड़हाआ पाप फासाड़ी रोत मुंदू जाहे. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />तेहेंज कोइत थोड़ेक हाजे कामे बी देखाअतेहे; आन जें एहेलेहे नाहां रोते, तें बी निकाइत नाहां सेक्ते.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />जेतेहे जोएं गुलामीइ जुहरोअ निसे होय, ते जिव जिवोअ मालिख्योहों खुब आदर आपुहूं जोवे, काहाके देवोअ नावोअ आन शिक्शणोअ बदनामी ने ओवुहूं जोवे. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />जियांआं मालिख विश्वासी होय तियांहां ते पाही होय कोत कमी ने मानुहूं जोवे, पोन तियांआं फाश्यीइ बी सेवा कोअहूं जोवे, काहाके याअ वाअहीं लाभ लेनारे विश्वासी आन मेराले होय. यीं गोठीही सिकाडतु ले आन समजाड़तु ले.<verse eid="1TI 6:2" /></para>
  <para style="s">ठोगोअ हिकवोण आन खोरो मालधन</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />जर एखू बिहीरीज जातीइ हिकवोण आपेहे आन खोरी गोठी, मोन्ज्ये आपाअ प्रभु ईसु ख्रिस्ताआ गोठीही आन तियी हिकवोणोहों नाहां मानतु, जे भक्तीइ इसाबोवाअहीं होय, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />ताहां तो वोडार्‍यु ओत गोयुहू आन किज नाहां जांअतू; पोन तियाहा भान्गड़ आन शब्दापोअ तोणाइलोअ रोग होय, जियावाअहीं खोद्राय, राड़ी, रोवाआ गोठ्यी, आन खाराब खाराब सौंसु, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />आन तियां माहूंमेहें बिगर कामोअ राड़ी-भान्गड़ी उत्पन्न ओवतिही, आन जियांआं बुद्दी बिगड़ीत गोयीही, आन ते सत्याअहीं रोत नांबे जाते रोयेहे, जे होमजीइतेहे के भक्ती वोडी कामायीइ दरवाजू होय.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />पोन होय तियाजमेहें खुस रोय ताहां भक्ती वोडी कामाय होय. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />काहाके आपू दुन्यामेहें किज नाहां लेताये आन नाहां की लेत जात सेक्ते. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />जर आपापोअ खाअलोअ आन फांगीइलोअ रोयो, ताहां तियाजमेहें खुस रोअहूं जोवे. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />पोन जें मालदार बोणुहूं होदतेहे, तें एहलीही परिक्शा आन फांदाम आन वारुज एहलीही बिगर कामोअ आन नुकसान कोअनारी लालसोम गुसवाअतेहें, जे माहुंहूं बिगाड़ीत टाकेहे आन तारासोअ दोर्‍याम बुडाड़ीत टाकेहे. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />काहाके रुप्याअ लालस आखी जातीइ खाराब गोठीइ मुल होय, जियाहा मेलविइलोअ काजे मेहेंनत कोअते जात केतेहे जोएं विश्वासोम रोत भटकीत कोइत सोताहा बातीवानीइ दुखोवाअहीं सारी बोणावीत लेदोहो.<verse eid="1TI 6:10" /></para>
  <para style="s">वावड़्यी सुसना</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />पोन ए देवोअ माटी, तु यीं गोठी रोत सेटे भाग, आन सती जिवन, भक्ती, विश्वास, मेर, धिर आन नम्रताआ फाटी लाग. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />विश्वासोअ लड़ाय वारुहूं लड़जी; आन तिया अमर जिवनोहो तोइत ले, जियाअ काजे देवे ताहूं हाद्युहू आन वारुज साक्शीदारोअ सामने हाजी कबुली आप्यीते. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />आंय ताहूं, देवोहो जो आखाहा जिवतु मिकेहे, आन ख्रिस्त ईसुहू साक्शी कोइत तुमू पंतीयुस पिलातोअ सामने विश्वासोअ हाजी कबुली आप्यी, ओ आदेश आपोहो <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />के तु आपाअ प्रभु ईसु ख्रिस्त देखाय ताअहूं जाआं या आदेशोहो इमानदारी वाअहीं आन निर्दुस मिकजी, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />जियाहा तो बराबोर वेलेपोअ देखाड़े, जो परमधन्य आन एक्कुज मंत्री होय, आन राजाअ राजा आन प्रभुउ प्रभु होय. <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />तो एखलुज कायम जिवतु होय, आन वोडा उजालाम रोहे, आन नाहां तियाहा कोडो माअहुंउं देख्यू आन ने केदिहीं पालित सेकनारो. सन्मान आन राज्य हादाजलम तियाआज रोय! आमेन.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />यी दुन्याआं कुन्ब्योहों आदेश आप के, ते वोडाय ने कोअहूं जोवे, आन ताबुड़ उडीत जानारा पोशापोअ आशा ने कोअहूं जोवे, पोन जो आपाअ सुखोअ काजे आखोज पुरीत उगरे एतोहो आपेहे तिया देवोपोअ आशा मिकुहूं जोवे. <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />ते हाजो कोअहूं जोवे, आन हाजा कामोमेहें मालदार बोणुहूं जोवे, आन खुल्ला मोनोवाईं मदत कोइलामेहें उतवाल्या रोअहूं जोवे, <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />आन आगाड़ीइ दिहोअ काजे एक हाजू पायू टाकीत लेअहूं जोवे के, खोरा जिवनोहों ताबामेहें कोइत सेके.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />ए तिमथ्या, ताआ आथोम जो होप्योहो, तियाहा वारुहूं सांबालित मिकजी; आन फालतु विरोद आन फोगायीइ गोठीम रोत सेटे रो. <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />केतेहे जोएं तिया ज्ञानोहो स्विकार कोइत विश्वासोम रोत भटकीत गोयेहे.</para>
  <para style="p" vid="1TI 6:21">तुमा आखापोअ देवोअ मेरवानी ओवती रोअहूं जोवे.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>