<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Noiri</book>
  <para style="h">फिलिप्पी</para>
  <para style="toc3">फिलि</para>
  <para style="toc2">फिलि</para>
  <para style="toc1">फिलिप्पीवालाहां प्रेशित पौलुसोअ पत्र</para>
  <para style="mt2">फिलिप्पीकरांस प्रेशित पौलाचे पत्र</para>
  <para style="mt1">फिलिप्पीवालाहां प्रेशित पौलुसोअ पत्र</para>
  <para style="imt">ओलखात</para>
  <para style="ip">ओं पत्र एक आंदास ख्रिस्त जल्माआं 61 वोऱ्ह्योअ फाटी पौलुसे फिलिप्पीवालां विश्वासी माअहुंहूं लेख्यो. ओं पत्र लेखीइलोअ होमसे तो जेलेम ओतु <char style="xt"><ref loc="PHP 1:13">1:13</ref></char> जाणकार एहलोहो मानताहा के ते जेल रोमोमेहें ओती. ओं पत्र फिलिप्पी होयरोम रोनारां विश्वासी पाव्हीइलाहां लेख्योतो. फिलिप्पी होयरो एती-तेतीही माहिती प्रेशितोंअ पुस्तकोम जोड़ेहे. फिलिप्पी होयर मकिदुनिया प्रांताआ राजधानी ओती. तेहेलोज मकिदुनिया प्रांताम ते पेहली मंडड़ी थापन ओवीते. पौलुस आन सिलास नेहें मिलीत ए मंडड़ी थापन कोअयीते. तियाज गालाहा तियांहां जेलेम बी केंडी देदाते, <char style="xt"><ref loc="ACT 16">प्रेशित 16</ref> </char></para>
  <para style="ip">ओं पत्र लेखीइलाम पौलुसोअ वारुज अलग अलग उद्देश ओता. तो जेलेम होय कोत खबर उनात कोइत फिलिप्पीइ मंडड़ीवाला माअहूं पौलुसोहो भेट लेत मोकल्यी, तिहींइं काजे तो तिहींइं मंडड़ीही धन्यवाद कोअहे. <char style="xt"><ref loc="PHP 4:10-19">4:10-19</ref></char> तो तियांहां जेलेमेएं हालत बी कोत देखाड़ेहे आन तिमथ्याहा आन एपाप्रदितोहो नेहें मंडड़ीइ कोअते मोकलिहीं कोत सुसना आपेहे. <char style="xt"><ref loc="PHP 2:19-30">2:19-30</ref></char> मोन्ज्ये ते जाय तेहेलाम मंडड़ी तियांआं आन तियांआं सेवाआ मानपान कोअहूं जोवे.</para>
  <para style="iot">रुप-रेशा</para>
  <para style="io1">1. पौलुस पत्राआ सुरुवातीही सलाम कोअहे <char style="ior"><ref loc="PHP 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. आगाड़ी तो तियाआ दशा कोत आपेहे आन थोड़ीक दिहान देअहूं जोगिही सुसना आपेहे <char style="ior"><ref loc="PHP 1:3-2:30">1:3—2:30</ref> </char></para>
  <para style="io1">3. तिहीं रोत तो ख्रिस्ती जिवनोअ वेवाराआ गोठी कोत देखाड़ेहे <char style="ior"><ref loc="PHP 3:1-4:9">3:1—4:9</ref></char></para>
  <para style="io1">4. पौलुस आखरीपोअ फिलिप्पीइ मंडड़ीही तियां मोकलीइल्यी भेटेए वोतीइ आभार मानेहे आन सलाम कोइत पत्रलेखन बंद कोअहे <char style="ior"><ref loc="PHP 4:10-23">4:10-23</ref></char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />ख्रिस्त ईसुउ साकर्‍या पौलुस आन तिमथ्या, यांआं तरफ रोत, आखा देवोअ माअहोंअ नावसे, जें ख्रिस्त ईसुमेहें ओत कोइत फिलीप्पीमेहें रोतेहें, डाया सेवकहों आन मदत कोअनाराअरी मिलता सलाम; <figure style="fig" alt="City of Philippi" file="hk00363c.tif" size="span" copy="Horace Knowles ©" ref="1:1">फिलिप्पी होयर</figure><verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />आपाअ देव आब्हा आन प्रभु ईसु ख्रिस्ताअहीं रोत तुमुहूं मेरवानी आन होक मिलतु रोअहूं जोवे.<verse eid="PHP 1:2" /></para>
  <para style="s">पौलुसोअ प्रार्थना आन आभार</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />जाहां जाहां आंय तुमाआं ओर कोअहो, ताहां ताहां आपाअ देवोअ धन्यवाद कोअहो; <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />आन जाहां बी आंय तुमा आखाआ कोअते प्रार्थना कोअहो, ताहां सादाज खुसीवाअहीं प्रार्थना कोअहो. <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />याअकाजे के तुमू पेल्ले दिहे रोत आज जाआं हाजी बातमी कोत आपीइलामेहें माआं मदत कोअयीही, तियाहा काजे आंय देवोअ धन्यवाद कोअहो. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />माहूं यी गोठीइ भरिवसू होये के जिये देवे तुमाआं विसमेहें हाजा कामोओं सुरुवात कोअयिही, तोज ईसु ख्रिस्ताआ दिही आवे ताअहूं जाआं पुरो कोए. <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />खोरी गोठ होय एहलोहो माहूं लागेहे के आंय तुमा आखाआ काजेहे एहलुज विसार कोओ, काहाके तुमू माआं मोनोम आवित बोठेहे, आन ओंमे आंय जेलेम होय, तेबी हाजी बातमीइ काजेहे उत्तर, आन पुरावू आपिइलाम तुमू आखे माअरी मेरवानीमेहें हाती बोणित रोयेहे. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />यामेहें देव माआं साक्शीदार होय के, आंय ईसु ख्रिस्ताआ होसर्‍यीइ मेर कोइत तुमा आखाआ काजे जास्ती इश्शा कोअहो.<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />आंय एज प्रार्थना कोअहो के तुमाआं मेर जाअखी जाअखी वोदुहूं जोवे आन खोरो ज्ञान आन खोरी ओकल फाश्यीइ बी वादती जाअहूं जोवे, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />याअकाजे तुमू हाजाम हाजी गोठीहीं पसन कोअहूं जोवे, आन ख्रिस्ताआ वापिस आवीइलोअ दिही आवे ताअहूं जाआं खोरे आन निर्दुस बोणित रोअहूं जोवे. <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />आन ईसु ख्रिस्तावाअहीं जोड़ताहा तियां सतीपणोअ गुणोवाअहीं पोआते जावा, जिहीं वाअहीं देवोअ महिमा आन भक्ती ओवया कोअहूं जोवे.<verse eid="PHP 1:11" /></para>
  <para style="s">ख्रिस्ताआ काजे जिवीइलो</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />माआं पाव्हीइला, माहूं जे वित्यीही, तिहीं वाअहीं हाजी बातमीइ काम वाद्योहो ओं तुमू जांइत लेअहूं जोवे एहेलोह माहूं लागेहे. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />तेतोज नाहां पोन पुरा राजवाड़ाआ आखी सैनिकोअ तुकड़ीही आन बाकी आखा माहुंहूं ओं मुंदू होय के, आंय ख्रिस्ताआ वाखरी जेलेम होय; <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />आन प्रभुमेहें जे पाही होय, तियांमेहें रोत वारुज जोंअ आंय तोआलु काजे, पुरु भरिवसू मिकीत विणबियेज देवोअ वसन कोअलोअ हिम्मत कोअयिही.<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />थोड़ाक ताम खोद्राय आन भान्गड़्यी कोइली कोत ख्रिस्ताआ परसार कोअताहा, आन थोड़हा हाजी इश्शा वाअहीं कोअताहा. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />ते हाजी बातमीइ काजे उत्तर आपिलोअ आवनारो होय, ओं जांइत कोइत मेरेवाईं परसार कोअताहा. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />आन थोड़हा ताम हाजलायी वाईं नाहां, पोन विरोदो वाअहीं ख्रिस्ताआ काईं कोत आपताहा, ते माहूं जेलेमेहें जाअखु तारास उत्पन्न ओवुहूं जोवे या विसारोवाईं कोअताहा.<verse eid="PHP 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18" />ताहां कि ओवो? बोणावटी गोठी वाअहीं नेत खोरा मोनो वाअहीं, पोन ख्रिस्ताआ काईं परसार ओवेहे ओंज, आन आंय यी गोठी वाअहीं खुस होय आन खुस बी रोहींज. <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />काहाके माहूं मुंदू होय के, तुमाआं प्रार्थना वाअहीं, आन ईसु ख्रिस्ताआ आत्मा वाअहीं माआं तारण ओवे. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />आंय ताम ओज वादार आहरु कोअहो आन आशा मिकोहो के आंय कोड्ली गोठीम ने लाजवाओ, पोन माआं वातड़ी हिम्मतोअ वाईं पेल ओवेहे तेहें कोइत ओमे जिवतु रोहीं तेन मोइत जाहीं ते, ख्रिस्ताआ महिमा माआं शरीरोवाअहीं सादा ओवती रोय. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />ताहां ओं जिवन कि होय? काहाके माआं काजे ताम जिवता रोअलो ख्रिस्त होय, आन मोइत जाअलो फायदू होय. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />पोन जर डिलोमेहें जिवता रोअलोज माआं काजे फायदाआ होय, ताहां कोड्लो निवड़ो तोंज माहूं नाहां समजाअतो. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />काहाके आंय बेनुउं विसमेहें ओदर टांगाअयुहू. जिवम ताम एहलोहो लागेहे के जिव सोड़ीत ख्रिस्ताअरी जातु रोंव, काहाके ओं ते जास्ती हाजो होय. <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />पोन आंय जिवतु रोहीं, ताहां ओं तुमाआं काजे हाजो होय. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />यीज गोठी वाअहीं माहूं भरिवसू होय के आंय जिवतु रोहीं, आन तुमा आखाअरी रोहीं, जिहीं वाअहीं तुमू विश्वासोमेहें मजबुत ओवते जाहा आन तियामेहें खुस रोहा; <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />आन जे वोडाय तुमू माआं बाप्तिमेहें कोअतेहे, ते आंय फाशुउ आविहीं ताहां ख्रिस्त ईसुमेहें जाअखे वादते जाहा.<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />फक्त एतोज कोआ के तुमाआं उठिइलो बोहीइलो ख्रिस्ताआ हाजी बातमीइ लायक मिका, ताहां आंय तुमुहूं आवित देखो, नेत ने बी देखो, पोन तुमाआं बाप्तिमेहें माहूं ओंज उनाअहूं जोड़े के तुमू एक्कुज आत्माम रोत कोइत विश्वासोम टिकीत होय, आन एक मोन ओत कोइत हाजी बातमीइ काजे मेहेंनत कोअते रोतेहे. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />आन कोड्लीज गोठीमेहें विरोध कोअनाराहां नाहां बिते. पोन कायम हिम्मत कोइत रोतेहे, ए तियांआं काजे नुकसानोअ पोन तुमाआं काजेहे तारणोअ हुद्दी निशाणी होय, आन ए देवोअ तरफ से होय. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />काहाके ख्रिस्ताआ वाखरी तुमापोअ ए मेरवानी ओवीही के, निस्ते विश्वास एतेज मा मिकहा, पोन तियाआ वाखरी दुख बी वेठा; <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />आन जेहेंकोइत तुमू माहूं कोअत्लू देख्युहू, तेहेंज कोइत मेहेंनत कोआ, आन ओमें तुमू बी उनाअतेहे के आंय तेहेंज कोअहो.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">ख्रिस्ताआ नम्रता आन महानता</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />ताहरोअ, जर ख्रिस्तामेहें थोड़ुक होक, मेरेवाईं हिम्मत, आत्माआं संगती, थोड़ीक माया आन दया होय, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />ताहां तुमू एक मोन्ये रोवा, आन एक्कुज मेर, एक्कुज जिव आन एक्कुज दिहान मिका, आन एहें कोइत तुमू माआं ए खुसी पुरी कोआ. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />आन विरोध नेत फालतु वोडायीइ काजे किज मा कोअहा, पोन नम्रता वाअहीं एकमेकाहा सोताप रोत जाअखे हाजे समजा. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />हारेक जोओं सोताआ एतीज कालजी नाहां, पोन बिहीराआ हाजाआ काजे बी कालजी कोआ. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />जेहलुहू ख्रिस्ताआ सोभाव ओतू, तेहलुहू तुमाआं बी सोभाव रोअहूं जोवे;<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />जो देवोअ रुप ओत बी देवोअ होस रोअलोअ</para>
  <para style="q2" vid="PHP 2:6">लाभ होये एहेलोह ने समज्यू.<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />पोन सोताहा एतुहू हानू बोणावी देदू,</para>
  <para style="q2" vid="PHP 2:7">आन तो मोनवीइ ओवतार लेत कोइत,</para>
  <para style="q2" vid="PHP 2:7">नौकरोअ होस बोणीत गोयू.<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />आन तो माहुंउं रुपोम बोणीत कोइत सोताहा नम्र बोण्यू, आन एतोहो जाआं आदेश पालन कोअयो के,</para>
  <para style="q2" vid="PHP 2:8">मोत, होव, क्रुस खांबोपोर्‍योअ मोत बी वेठीत लेदो.<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />तियाहाज काजे देवे बी तियाहा आखाम रोत बी वोडु बोणायू,</para>
  <para style="q2" vid="PHP 2:9">आन तियाहा एहलोहो नाव आप्यो, जों आक्खा नावोम रोत बी वोडो होय.<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />याअ काजे के जें होरगाम, धरतीपोअ</para>
  <para style="q2" vid="PHP 2:10">आन धरतीइ निसे होय,</para>
  <para style="q2" vid="PHP 2:10">तें आक्खे ईसुउ नावोम टोसणे टेकवुंहूं जोवे;<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />आन देव बाह्हाअ महिमाआं काजेहे हारेक जिब मानित लेअहूं जोवे के,</para>
  <para style="q2" vid="PHP 2:11">ईसु ख्रिस्त ओज प्रभु होय.<verse eid="PHP 2:11" /></para>
  <para style="s">दुन्यामेहें दिवाआ होस सोमका</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />तियाहाज कोत ए माआं मेराला, जेहेंकोइत तुमू सादाज गोठी मानते आयेहे, तेहेंज कोइत ओंमे बी माअरी रोहा ताहां एतोज नाहां, पोन खास कोइत मारोत सेटे रोत कोइत बी, बिते आन कापते जात जिवज्योअ तारणोअ काम पुरो कोअते जावा; <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />काहाके देवुज होय जो तियाआ राजीखुसी वाअहीं तुमाआं मोनोमेहें इश्शा आन काम, बेनू गोठी कोइलाअ जोर आपेहे.<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />आखे कामें बिगर टुटण्येज आन विण दाती कोअयेज कोआ. <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />याअ काजेहे के तुमू निर्दुस आन भोले ओत कोइत वाकड़ा आन रोवा कोअनारा माअहुंउं विसमेहें देवोअ निर्दुस पोर्‍ये बोणीत रोवा, जियांआं विसमेहें तुमू जिवनोअ वसन लेत कोइत दुन्यामेहें पेटाअत्ला दिवाआ होस देखाअतेहे. <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />जिवनोअ वसनोहों वातड़ो तोइत रोवा, एहें कोअहा ताहां, माहूं ख्रिस्ताआ दिहोअ दिही वोडाय कोअहूं जागू जोड़े, आन माआं गुगदीइलो मेहेंनत वाया ने जाय.<verse eid="PHP 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17" />जर माहूं तुमाआं विश्वास रुप गाराहा आन सेवाअरी माआं रक्त बी वोहाड़ुंहूं पोड़े तेबी आंय खुस होय, आन तुमाआं आखाअरी खुसी कोअहो; <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />तेहेंज कोइत तुमू बी खुस ओत जावा आन माअरी खुसी कोआ.<verse eid="PHP 2:18" /></para>
  <para style="s">तिमथ्या आन एपाप्रदित</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />प्रभु ईसुमेहें आशा होय के आंय तिमथ्याहा तुमाआं जागे तुरतुज मोकलिहीं, याअकाजे के तुमाआं दशा उनाइत कोइत माहूं बी होक आवे. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />काहाके सोका मोनोवाईं तुमाआं कालजी कोए एहेलोह कोडो माआं जागे कायनाहां. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />काहाके आखे बी ईसु ख्रिस्ताआ काजे नाहां पोन जिवज्योअ काजे एतेज दिहान देतेहे. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />पोन तियाहा तुमू फारकीत लेदुहू आन जांइत बी लेदुहू के जेहलुहू आब्हाअरी बेटुह्हू कोअहे, तेहेंज कोइत तिये बी माअरी हाजी बातमी पोताड़ीलोअ काजे मेहेंनत कोअयी. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />आन जेहेंज माहूं मुंदू पोड़े के माआं कि ओवे, तेहेंज आंय तियाहा तुरतुज मोकली देहीं एहलिही आंय आशा कोअहो. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />आन प्रभुमेहें माहूं भरिवसू होय के आंय सोताहा वेगुज आविहीं.<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />पोन जो माआं पाही आन हेंगाती, तुमाआं हाती सैनिक आन खबर पोताड़नारु, आन गरज पोड़े तेहेलाम माहूं मदत कोअनारु एपाप्रदित याहा तुमाआं जागे मोकलीइलोअ माहूं गोम्यो. <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />काहाके तियाआ मोन तुमा आखामेहें लागीत रोयोतो, तिहींवाईं तो सिंताम रोतुतो, काहाके तुमू तियाआ बिमारीइ खबर उनाअयेते. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />खोरीज बिमार ते पोड़्युतो, एतुहू बिमारी ओतू के मोइत जातुमे, पोन देवे तियापोअ दया कोअयी, फक्त तियापोअ एतीज नाहां, पोन माहूं तारासोपोअ तारास ने पोड़ुहूं जोवे कोत मापोअ बी कोअयी. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />तियाहा कोत आंय तियाहा मोकलीइलोअ जास्ती तावणी कोअयी, काहाके तुमू तियाहा मिलीत खुस ओत जाअहूं जोवे, आन माआं बी तारास ओल्कू जाअहूं जोवे. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />तिहींवाईं तुमू तियाहा विश्वासी कोत प्रभुमेहें जास्ती खुसीवाईं मिलजा, एहला माहुंउं आदर कोअते रोजा. <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />काहाके ख्रिस्ताआ कामोंअ काजे तुमाआं कसर पोड़्यी, तिहींवाईं तों काम कोइलोअ काजे तिये सोताआ जिवोहो अड़सनीम टाकीत मोअतु मोअतुज वासाअयु.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">खोरो धर्मी जिवन</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />तियाहा काजे माआं पाव्हीइला, प्रभुमेहें खुस रोवा, आंय तुमुहूं ताल ताल लेखीइलाम उजगाय नाहां कोअतू, पोन तों तुमाआं हाजाआ काजे होय. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />तियां हुंणा रोत, खाराब कामे कोअनारां रोत जाबालीत रोवा. जें निस्ते शरीरोअ खतना एतेज कोइत होय तियां रोत जाबालीत रोवा. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />काहाके आपू जें देवोअ आत्मा वाअहीं देवोअ भक्ती कोअतेहे, जें ख्रिस्त ईसु पोअ वोडाय कोअतेहे, आन शरीरोपोअ भरिवसू नाहां कोअते, तें आपू आपाआ खतना ओत गोयुहू. <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />तेबी शरीरोपोअ भरिवसू मिकिइलो माहूं जागू होय. एखाहा शरीरोपोअ वोडाय कोओ लागतोय, ताहां माहूं तिया रोत जाअखो लागनारो. <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />माआं ताम आंठवा दिहोम खतना ओवलु, इस्राएल माअहूंमेएं, बिन्यामीन कुटुंबामेएं, इब्रीइ इब्री, नियमोअ बाप्तिमेहें फरिसी; <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />उरीइ बाप्तिम कोहा, ताहां मंडड़ीइ तारास देनारु आन नियम पुस्तकोअ परमाणे धार्मिकताआ नजरे वाईं निर्दुस ठरल्यु एहेलुहू ओतू.<verse eid="PHP 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 3:7" />तेबी जे गोठी माआं फायदाआ काजेहे ओती, ते ख्रिस्ताआ उस्ती विणकाम्यी समजीत लेदी. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />एतोज नाहां पोन, माआं प्रभु ख्रिस्त ईसु याअ बाप्तिमेर्‍योअ ज्ञान वादार कामोअ होय, तिहीं वाअहीं बिहीरो आखो विणकामोंअ समजोहो. एताआ वाखरी आंय आखो टाकी देदो आन तियांहां कोसरो सोमजोहो, काहाके माहूं ख्रिस्त ईसुउ लाभ जोड़ुहूं जोवे. <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />आन तियाआ जागे जागु जोड़ुहूं जोवे, आन माआं तियी धार्मिकताअरी नाहां, जे नियमोंअ पुस्तकोमेहें रोत होय, पोन तियी धार्मिकताअरी जे ख्रिस्तापोअ विश्वास कोइलाअ वोतीइ होय, आन देवोअहीं रोत विश्वास मिकतेहे ताहां जोड़ेहे; <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />काहाके आंय ओं होदोहो के ख्रिस्ताहा आन तियाआ फाशोअ जिवीत उठीइलाअ सेक्तीही, आन तियाअरी दुखोमेहें भागिदार ओवीइलाआ गुप्त्यी गोठीहीं जाओं, आन तियाआ मोतोम भाग लेत तियाआ होस बोणो. <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />मोन्ज्ये केहें बी कोइत माहूं मोतोम रोत जिवीत उठीइलो जागे जाआं पोताअहूं जोवे.<verse eid="PHP 3:11" /></para>
  <para style="s">निशाणीइहें गुगदीइलो</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />ओं मा समजाहा के माहूं जोड़ीत गोयोहो, नेताहां आंय पाक्कू ओत गोयुहू; पोन तो इलाम जोड़ुहूं जोवे काजे गुगदीत जाहो, जियाअ काजे सोताहा ख्रिस्त ईसु माहूं ताबाम लेदुहू. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />माआं पाव्हीइला, माआं एहेलुहू विसार कायनाहां<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">थोड़हा लेख्यामेहें “ओमे जाआं नाहां”</char></note> के मी तों ताबाम लेत लेदोहो; पोन फक्त ओं एक काम कोअहो, के जे गोठी फासाड़ी रोत गोयीही तियींहीं विहराइत कोइत, आगल्यीइ गोठीइहें दिहान देत, <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />याअकाजे के जिया इलामोहों ताबाम लेअलोअ काजे देवे माहूं ख्रिस्त ईसुमेहें उसे हाद्युहू तियी निशाणीइहें गुगदीइतुज जाहो.<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />आपामेहें जें पाक्के होय तें ओज विसार मिकुहूं जोवे, आन जर एखी गोठीमेहें आलांग विसार ओय, ताहां तोबी देव तुमुहूं देखाड़े. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />तियाहा काजे ओमें जाआं जेहेंकोइत सालते आयेहे तेहेंज कोइत आगाड़ी बी साला.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />माआं पाव्हीइला, तुमू आखे मिलीत कोइत माआं होस साला, आन जें एहेंकोइत नमुनो देखीत सालतेहे तियांआं वोल दिहान मिका. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />काहाके, जाअखीलेहे माअहें एहलेहे सालतेहे, जियांआं गोठी आंय तुमुहूं जास्ती वारी कोत आप्यीही, आन ओमे बी रोड़ी रोड़ीइ कोहो के, तें तियांआं जिवणावाईं ख्रिस्ताआ क्रुस खांबोअ दुस्मोन होय. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />तें नरकाआ वाटे आरवाए जातेहे, काहाके तियांआं देव तियांआं पोटू होय. तियांआं विणलाज्ये कामे तियांआं होबा होय, आन तें निस्ते दुन्यादारीइ गोठीपोअ एतेज मोन लागाड़ीत रोतेहे. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />पोन, आपाअ देस होरगाम होय; आन आपू आपाआ तारनारा प्रभु ईसु ख्रिस्ताहा तिवोल आवत्लाहा वाट जोवतेहे. <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />तो तियाआ जियी सेक्तीवाईं आखी वस्तुहू सोताआ ताबाम कोइत सेकेहे तियी सेक्तीवाईं तो आपा आखाआ कमजोर शरीरोअ रुप बोदलीत कोइत, तियाआ महिमावाला शरीरोअ होस बोणावी देये.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">सुसना</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />तियाहाकोत माआं मेराला पाव्हीइला, माआं तुमापोअ जास्ती जिव होय, आन आंय तुमाआं जास्ती ईत कोअहो! तुमू माहूं जाअखु खुस कोअयू! आन तुमू माआं बक्शीस होय, माआं पाव्हीइला देवोमेहें एहेंज कोइत वातड़े रोवा.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />आंय युदियाहा बी समजाड़ोहो आन सुन्तुखेहे बी, के तुमू देवोमेहें एक मोन्ये रोवा. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />माआं खोरा हाती, आंय ताहूं विनंती कोअहो के तु तियीं बायहींइं मदत कोअ, काहाके तियीं माअरी हाजी बातमी परसार कोइलोमेहें, क्लेमेंस आन माआं बाकी आरीइ हाती मिलीत मेहेंनत कोअयी, जियांआं नावे जिवनोअ पुस्तकोम लेखाअयेहे.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />प्रभुमेहें कायम खुस रोवा; आंय फाशुउ कोहो, खुस रोवा.<verse eid="PHP 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5" />तुमाआं हानालाय आखा माअहूंमेहें देखाअहूं जोवे. प्रभु आहने होय. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />कोड्लीज बी गोठीइ सिंता मा कोअहा, पोन आखी गोठीम तुमाआं निवेदन, प्रार्थना, आन रावणी वाअहीं धन्यवाद कोइत देवोअ सामने हजर कोआ. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />ताहां देवोअ होक जो होमजायन्ने एतुहू होय, तो तुमाआं मोन आन तुमाआं विसारोहो ख्रिस्त ईसुमेहें वारुहूं मिके.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />तियाहाकोत माआं पाव्हीइला, जे जे गोठी खोरी होय, आन जे जे गोठी मानुहूं जोगीही होय, जे जे गोठी बोराबर होय, जे जे गोठी पवित्र होय, आन जे जे गोठी स्विकारुहूं जोगीही होय, जे जे गोठी गोमे एहलिही होय, मोन्ज्ये जे बी हाजा सोभावोअ आन नाव काडुहूं जोगीही गोठी होय, तियींपोअ मोन लागाड़्या कोआ. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />जे गोठी तुमू मापरोत सिकाअये, स्विकार्‍यी, आन उनाअये, आन मामेहें देख्यी, तियींइंज पालन कोअते रोवा, ताहां देव जो होकेए उकलु होय तो तुमाअरी रोय.<verse eid="PHP 4:9" /></para>
  <para style="s">भेटेए वोतीइ आभार</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />माहूं प्रभुमेहें जास्ती खुसी जोड़्यी. ओमें एताहा दिहोअ फासाड़ी माआं बाप्तिम तुमाआं कालजी फाशीइ जागती ओयीही; खोरीज तुमुहूं सुरवातिही बी याआ विसार ओतू, पोन तुमुहूं वेल ने जोड़्यी. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />माहूं काविहीं कमी पोड़्यो कोत आंय गोगोहो एहलोहो नाहां; पोन जियी दशामेहें आंय होय, तियीज दशामेहें खुस रोअलोअ आंय टेवाअयुहू. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />आंय हानू बोणीइलो बी जांअहों आन वोडो बोणीइलो बी जांअहों; आखी गोठी आन आखी दशामेहें खुस रोअलो, फुकल्या रोअलो, आन वोदीअलो कमी ओवीइलोअ माहूं मुंदू होय. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />जो माहूं ताकत आपेहे तियामेहें आंय आखोज कोइत सेकोहो.<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />तेबी तुमू माआं तारासोमेहें माअरी भागिदार बोण्ये हाजो कोअयो. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />फिलीप्पीवालां, तुमू सोताहा बी जांअतेहे के हाजी बातमी सुरुवातीमेहें, जाहां आंय मकिदुनिया रोत निहीयु, ताहां तुमाआं सिवाय बिहीरी कोड्लीज मंडड़ी लेणा-देणाअ बाप्तिमेहें माहूं मदत ने कोअयी. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />एंहेंज कोइत जाहां आंय थेस्सलनीकेमेहें ओतू, ताहां बी तुमू माआं गरज पुरी कोइलोअ काजेहे एकवारी सोड़ीत बेनवारी जाआं मदत कोअयी. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />माहूं भेट जोवे एहेलोहो नाहां, पोन माहूं तुमाआं फायदाअ काजेहे वादतो जानारो फल जोवे. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />मापोअ आखोज होय, भारपुर बी होय; जे वस्तु तुमू एपाप्रदितोअ आथे मोकल्यी, ते तोइत आंय ताराइत गोयुहू, ते ताम गोमे एहेलुहू वास, देवोहो मान्य ओवे एहलिही गाराहा होय, आन गोमे एहलिही भेट होय. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />माआं देव बी तियाआ तिया मालधनोम रोत जों महिमाअरी ख्रिस्त ईसुमेहें होय, तुमाआं आखी गरज पुरी कोए. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />आपाआ देव आन बाह्हाअ महिमा पिढ़ीन पिढ़ी रोअहूं जोवे! आमेन.<verse eid="PHP 4:20" /></para>
  <para style="s">आखरीइ सलाम</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />हारेक विश्वासी पाव्हीइलाहा, जों ख्रिस्ताम होय तियाहा सलाम कोवा. जे पाही माअरी होय ते तुमुहूं सलाम कोताहा <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />आखे देवोअ माअहें, खास कोइत जे कैसरोअ कुटूंबामेर्‍येए होय, तुमुहूं सलाम कोतेहे. <verse eid="PHP 4:22" /><verse number="23" style="v" sid="PHP 4:23" />आपाआ प्रभु ईसु ख्रिस्ताआ मेरवानी तुमाअ आत्माअरी रोये.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>