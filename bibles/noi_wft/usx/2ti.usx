<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Noiri</book>
  <para style="h">2 तिमथ्या</para>
  <para style="toc3">2 तिम</para>
  <para style="toc2">2 तिम</para>
  <para style="toc1">तिमथ्याहा प्रेशित पौलुसोअ दुसरो पत्र</para>
  <para style="mt2">तिमथ्याला प्रेशित पौलाचे दुसरे पत्र</para>
  <para style="mt1">तिमथ्याहा प्रेशित पौलुसोअ दुसरो पत्र</para>
  <para style="imt">ओलखात</para>
  <para style="ip">तिमथ्याआ पुस्तक ओं प्रेशित पौलुसोअ दुसरो पत्र होय, जों तियाआ सेलू तिमथ्याहा लेख्योहो. 2 तिमथ्या ओं पत्र पौलुसोअ जिवनोअ आखरीमेहें लेखाअयोहो. <char style="xt"><ref loc="2TI 1:16">1:16</ref></char> तिया वाडोहो तो रोम होयरोअ जेलेम ओतू. पौलुसोअ तिमथ्याअरी जास्ती आहनेएं नातो ओतो, तियाहा कोत तो तिमथ्याहा ताल ताल बेटाह्हा कोत गोगाड़ेहे. <char style="xt"><ref loc="PHP 2:22">फिलि 2:22</ref></char>, <char style="xt"><ref loc="1TI 1:2">1 तिम 1:2</ref></char>, <char style="xt"><ref loc="2TI 1:18">1:18</ref></char></para>
  <para style="ip">पौलुसोअ शार पत्रामेहें रोत ओं बी एक पत्र होय जो एकी मंडड़ीइ बोदले एका जोओंहों लेख्योहो. बिहरे 3 पत्रे एं होय: 1. 1 तिमथ्या, 2. तितुस आन 3. फिलेमोन. ओं पत्र लेखाइलोअ वाडोम रोम देसोअ राजा तिहींइं विश्वासी माहुंहूं दोमतुतो. याआज वाखरी पौलुस जेलेम ओतू आन तिहीं कठीण दुख वेठीइलोअ वेल आवे एहें कोत सुसना आपतुतो. तिहींइं फासाड़ी तिहीं तो आवनारा दिहोम ओवनारी घटनाआं बाप्तिम सामना कोइलोअ काजे साफ इशारु कोअहे. <char style="xt"><ref loc="1TI 1:16-18">1 तिम 1:16-18</ref></char> पौलुस थोड़ीक वावड़्यी गोठी तिमथ्याहा कोत देखाड़ेहे आन एहें कोहे के आवनारा दिहोम कठीण वेल आवे.<char style="xt"><ref loc="2TI 3:1">3:1</ref></char></para>
  <para style="iot">रुपरेशा</para>
  <para style="io1">1. पौलुस सलाम कोअतूज पत्र लेखीइलाअ सालु कोअहे <char style="ior"><ref loc="2TI 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. आन फाशुउ धिर देहे <char style="ior"><ref loc="2TI 1:3-18">1:3-18</ref></char> तिहीं रोत तो दुख वेठीइलोअ बाप्तिम हिम्मत आपेहे <char style="ior"><ref loc="2TI 2:1-13">2:1-13</ref> </char></para>
  <para style="io1">3. आगाड़ी फाशुउ तो तियाहा थोड़ीक सादी सुसना आपेहे <char style="ior"><ref loc="2TI 2:14-26">2:14-26</ref></char></para>
  <para style="io1">4. आखरीइ दिहोमेऱ्यीइ घटनाआं बाप्तिम सेतावणी <char style="ior"><ref loc="2TI 3:1-4:9">3:1—4:9</ref></char></para>
  <para style="io1">5. पौलुस ओं पत्र थोड़ीक वावड़्यी गोठी कोत कोइत बंद कोअत्लू. <char style="ior"><ref loc="2TI 4:9-22">4:9-22</ref> </char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />ईसु ख्रिस्तामेहें जों जिवन होय तिया जिवनोअ आथवसन प्रगट कोइलोअ काजे देवोअ इश्शा वाअहीं ईसु ख्रिस्ताआ प्रेशित पौलुसोअ तरफ से,<verse eid="2TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2" />मेरालू पोर्‍यू तिमथ्याआ नावे: देव आब्हू आन आपाअ प्रभु ख्रिस्त ईसुउ जागे रोत ताहूं मेरवानी, दया आन शांती जोड़ुहूं जोवे.<verse eid="2TI 1:2" /></para>
  <para style="s">आभार आन प्रोत्साहन</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />जिया देवोअ आंय माआं डायहांअ होस सोका मोनो वाअहीं सेवा कोअहो तियाआ धन्यवाद कोअहो, आन आंय माआं प्रार्थनामेहें ताहूं हमेशा ओर कोअहो. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />आन ताआ रोज्याआ ओर कोई कोईइ रात दिही ताहूं मिलीइलोअ काजे आंय जास्ती फोमवाअयुहू, काहाके ताहूं मिलीत माहूं खुसी जोड़ीत सेके. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />माहूं ताआ तिया खोरा विश्वासोअ ओर आवेहे, जो पेल ताआ वोडी याह्ही लोइस आन ताआ आयही यूनीकेमेहें ओतू, आन माहूं भरीवसू होय के तोज विश्वास तामेहें बी होय.<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेशित 16:1</ref></char></note> <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />याआज काजे आंय ताहूं ओर कोइत आपोहो, काहाके तू देवोअ तिया वरदानोहों जों माआं आथ मिकीइला वाअहीं ताहूं जोड़्योहो तों फाशोअ बी पेटाड़ी दे. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />काहाके देवे आपुहूं बिकेए नाहां, पोन ताकतोअ आन मेरेए आन संयमोअ<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">ताबाम रोअलोअ</char></note> आत्मा आप्युहू.<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />तिहींवाअहीं आपाआ प्रभुउ साक्शी आपिलोअ काजे मा लाजवाअही, आन आंय तोआयुहू कोत बी मा लाजवाअही; पोन तियी देवोअ ताकतोअ पुरमाणे हाजी बातमीइ काजे माअरी दुख वेठ. <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />जिये आपाअ सुटका कोअयी आन तियाआ सोताआ माअहें ओवीइला काजे हाद्येहे, आन ओं आपाअ कामोअ पुरमाणे नाहां, पोन तियाआ उद्देश आन मेरवानी वाअहीं जे ख्रिस्त ईसुमेहें पेल रोत आपापोअ ओवीही. <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />पोन ओमे आपाअ तारनारा ख्रिस्त ईसुउ प्रगट ओवीइला वाअहीं उजालो ओवो. ख्रिस्ते मोतोहो आरवी देदो आन तियी हाजी बातमी वाअहीं अमर जिवनोअ उजवोड़ेम लेतायुहू.<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />जियाअ काजे आंय परसार कोअनारु, प्रेशित, आन मास्तर बी ठर्‍यु.<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1TI 2:7">1 तिम 2:7</ref></char></note> <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />तियाहा काजे आंय यां दुखोहो बी वेठोहो, आन नाहां लाजवाअतू, काहाके जियापोअ आंय विश्वास कोअयुहू, तियाहा आंय ओलखोहो; आन माहूं पाक्कू विश्वास होय के तो माआ इसाआ तिया दिहोअ दिही जाआं राखवाली कोइत सेकेहे. <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />जे खोरी गोठी तु मापोअ रोत उनाअयुहू, तियींहीं ख्रिस्त ईसुमेऱ्याआ विश्वासोअरी आन मेरेवाअहीं नमुनू बोणावीत मिक. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />आन पवित्र आत्मा वाअहीं जो आपामेहें रोहे, तिया हाजा इसाआ राखवाली कोअ.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />ताहूं मुंदू होय के आसियावाले आखे माहें माहूं सोड़ीत गोयेहे, जियांमेहें फुगिलुस आन हेरमोगेनेस होय. <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />उनेसिफुरुसोअ घराणापोअ प्रभु दया कोए, काहाके तिये जाअखीलिही वारी माआं जिवोहो खुस कोअयू आन आंय तोआयू तेबी तो ने लाजवाअयु. <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />पोन जेहेलाम तो रोम सेहरोमेहें आयू, ताहां जाअखीलिही मेहेंनत कोइत माहूं होद्यु आन मिल्यू. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />प्रभु कोए के तेदिहीं तियापोअ प्रभुउ दया ओवुहूं जोवे आन जे जे सेवा तिये इफिसोमेहें कोअयिही तियींहीं बी तु हाजीहुतायी जांअहें.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">ख्रिस्त ईसुउ हाजू सिपायड़ु</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />तियाहा काजे ए माआ पोर्‍या, तू तियी मेरवानी वाअहीं जे ख्रिस्त ईसुमेहें आमाआ होय, ताकतवालु ओत जा, <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />आन जे गोठी तू जाअखीलाहा साक्शीदारोअ सामने मापोअ रोत उनाअयुहू, तियींही विश्वासी माअहुंहूं होपी दे; जे बिहीराहा बी सिकाड़ीलाअ हाजी आवे.<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />ख्रिस्त ईसुउ हाजा सेयनिकोअ होस माअरी दुख वेठेए. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />जेहेलाम एखू सेयनिक लड़ाय कोऊ जाहे, ताहां याअकाजे के तियाआ भरती कोअनाराहा खुस कोए; तिहींवाअहीं तो सोताहा दुन्याआ कामोमेहें ने फसाड़तू. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />फाशोअ बारामेहें लड़ाय कोअनारु जर नियमोअ परमाणे ने लड़े, ताहां तियाहा बक्शीस ने जोड़नारो. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />जो खेतोअ कोअनारु मेहेंनत कोअहे, तियाहा फलवाअ इसु पेल जोड़ुहूं जोवे. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />जों आंय कोहो तियापोअ ध्यान दे, आन प्रभु ताहूं आखी गोठीइ समज आपे.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />ईसु ख्रिस्ताहा ओर मिक,जो दाविदोअ पारवाड़ीमेहें रोत ओवू आन मोल्यामेहें रोत जिवीत उठ्यू, आन ओं माआ हाजी बातमीइ पुरमाणे होय. <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />जियाअ काजे आंय खाराब कामे कोअनाराअ होस दुख वेठोहो, एतोहो जाआं के जेलेम बी होंव; पोन देवोअ वसन बांदाअलो कायनाहां. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />याअकाजे आंय निवड़ीइल्या माहुंउं काजे आखोज वेठोहो, के ते बी तियी सुटकाहा जे ख्रिस्त ईसुमेहें होय हादाफल्यीइ महिमा जोड़ीत सेके. <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />ए गोठ खोरी होय,</para>
  <para style="q1" vid="2TI 2:11">के जर आपू तियाअरी मोइत गोयेहे,</para>
  <para style="q2" vid="2TI 2:11">ताहां तियाअरी जिवहूं बी;<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />जर आपू धिर तोइत वेठते रोहूं,</para>
  <para style="q2" vid="2TI 2:12">ताहां तियाअरी राज बी कोअनारे;</para>
  <para style="q1" vid="2TI 2:12">जर आपू तियाआ नाकार कोअहूं,</para>
  <para style="q2" vid="2TI 2:12">ताहां तो बी आपाअ नाकार कोए;<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />जर आपू बिगर विश्वासी बी ओय,</para>
  <para style="q2" vid="2TI 2:13">तेबी तो इमानदार बोणीत रोहे,</para>
  <para style="q2" vid="2TI 2:13">काहाके तो सोताआ सोभावोअ विरुद्द नाहां वागित सेकतु.<verse eid="2TI 2:13" /></para>
  <para style="s">हाजाम हाजू कारागिर</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />यीं गोठीइ तियांहां ओर कोइत आप आन प्रभुउ सामने हेकी दे, काहाके शब्दापोअ भान्गड़ ने कोअहूं जोवे, जिहीं वाअहीं कीज फायदू कायनाहां ओवतु, पोन उनाअनारे आरवात जातेहे. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />तु सत्य वसनोहो बोराबर पद्दतीवाअहीं कोत आपनारु एहलुहू, आन जों काम कोअहे तिहींम ने लाजवाअनारु एहलुहू, आन देवोहो गोमनारो काम कोअनारु बोणिइलोअ कोशित कोअ. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />पोन फोगायीइ गोठी रोत वासाइत रो, काहाके एहलेहे माअहें फाशेए बी विणभक्तीमेहें वादते जानारे. <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />आन तियांआं वसन बरजीइनारा दुक्ताआ होस पसरीइतो जानारो. तियांमेर्‍याआ हुमिनयुस आन फिलेतुस होय. <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />जे पुनरुत्थान<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="fq" closed="false">पुनरुत्थान </char><char style="ft" closed="false">मोल्यामरोत जिवीत उठीइलोअ</char></note> ओत सुकोहो एहें कोत कोइत सत्याम रोत भटकीत गोयाहा, आन केताहा जोओंअ तेबी विश्वास सेली देताहा. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />तेबी देवोअ पायू पाक्कू बोणीत रोहे, आन तियापोअ ओ साप लागुहू: “प्रभु तियाआ कोर्‍याआ माहुंहूं ओलखेहे,” आन “जों कोडो प्रभुउ नाव लेहे, तों खाराब कामोम रोत वासाइत रोअहूं जोवे.”<note caller="+" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="NAM 1:7">नहूम 1:7</ref></char></note><verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />वोडा कोअमेहें होनान सांदी एतेज नाहां, पोन लाकड़ुउ आन कादवोअ बासने बी रोतेहे; एखू-एखू खास कामोअ काजे, आन एखू-एखू किरकोड़ कामोअ काजे. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />जर एखो सोताहा यांमेहें रोत सोको ओवे, ताहां तों आदरोअ बासन आन पवित्र ठरे; आन मालख्योअ कामोम आवे, आन हारेक हाजा कामोअ काजे तियार कोअल्या बासनोअ होस बोणे. <verse eid="2TI 2:21" /><verse number="22" style="v" sid="2TI 2:22" />जुवानीमेएं लालसोमेहें रोत सेटे रो, आन जें सोका मोनोवाअहीं प्रभुउ नाव लेतेहे तियांअरी धर्मी, आन विश्वास, आन मेर, आन होक यीं गोठीइ फाट लाग. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />पोन फोगायीइ आन बिगर बुद्दीइ भान्गड़ीम रोत आलांग रो, काहाके ताहूं मुंदू होय के यांवाअहीं भान्गड़्यी उत्पन्न ओवतीही. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />प्रभुउ सेवक राड़गाट्यु ने जोवे, पोन तो आखाअरी हाजू आन शिक्शणोम हुशार आन धिर खेटनारु जोवे. <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />तो दुस्मोनोहों नम्रतावाअहीं समजाड़ुहूं जोवे, की मुंदू देव तियांहां मोन फेरवीइलाअ मोन आपे, आन तें बी सत्याहा ओलखे, <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />आन यावाअहीं सैताने तियाआ मोर्जी पुरी कोइलाआ काजे तोइत लेत गोयुहू, तिया फांदाम रोत सुटीइलोअ काजे तें सुद्दीपोअ आवित सेके.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">सेवट्याआ दिही</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />पोन ओं ओर मिक के आखरीइ दिहोमेहें कठीण वेल आवनारी होय. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />काहाके माहें उपकार ने जांअनारे इजऱ्ये, लालसी, बोड़ाय कोअनारे, वोडाय कोअनारे, निंदा कोअनारे, आयहीन आब्हाअ गोठी ने माननारे, मदत ने कोअनारे, विणधर्मी, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />दया ने कोअनारे, माफ ने कोअनारे, साड़ग्ये, मोनोपोअ ताबू ने मिकनारे, हाजाहा पसन ने कोअनारे, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />विश्वास तोड़नारे, ठोहजात रोनारे, वोडाय कोअनारे, देवोअ मेर नाहां पोन दुन्यादारीइ मेर होदनारे. <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />तें भक्तीइ वेहे तोअनारे, पोन देवोअ सेक्तीही ने माननारे; एहेला माअहोंअ रोत सेटे रोवा. <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />यांजमेर्‍येए तें माअहें होय जें कोअमेहें होल्याज फोहीत आवतेहे, आन तियीं सेत्राअली बोईंहीं, जे पापोवाअहीं दाबाइत आन हारेक जातीइ लालसोम पोआत होय, तियींहीं ताबाम कोइत लेतेहे, <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />आन ते सादाज हिकाअती रोतीही, पोन सत्याआ पुरी ओकलेए जागे जाआं नाहां पोत्ती. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />जेहेंकोइत यान्नेस आन यम्ब्रेसे मोशेए विरोध कोअयुतो, तेहेंज कोइत एं बी सत्याआ विरोध कोअतेहे; एं एहेलेहे माअहें होय, जियांआं बुद्दी खाराब ओत गोयीही आन तें विश्वासोअ बाप्तिमेहें वाया गोल्ये माहें होय. <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />पोन एं माहें यारोत आगाड़ी नाहां वोदीत सेक्ते, काहाके जेहेंकोइत तियांआं फोगाय आखा माअहुंहूं देखात गोयी, तेहेंज कोइत यांअ बी फोगाय देखात जाय.<verse eid="2TI 3:9" /></para>
  <para style="s">तिमथ्याहा आखरीइ सुसना</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />पोन तु माआं हिकाड़ल्यी गोठी, माआं सोभाव, माआं मोनोअ इश्शा लेत साल्यू; माआं विश्वास, माआं सहन कोइलोअ सेक्ती, माआं मेर, माआं धिर तोइलोअ, माआं तारास वेठीइलो आन मापोअ आवल्यी आफत तुमे ओलखीत लेदीही. <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />अंताकिया आन इकुनियुम आन लुस्रामेहें जो विरोध वेठ्यु आन जो तारास आंय सहन कोअयू तों आखो ताहूं मुंदू होय, पोन प्रभु माहूं तियां आखाम रोत वासाड़ीत लेदू. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />पोन जेते बी जोएं ख्रिस्त ईसुमेहें सोको जिवन जिवीइलो कोअतेहे तियां आखाहा तारास सहन वेठुहूंज पोड़े; <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />पोन पापी आन ठोगनारे माहें धोकु देतेज आन धोकु खातेज, बिगड़ीइतेज जाते रोनारे. <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />पोन तू जे गोठी सिकाअयुहू आन विश्वास कोअयुहू, ते वातड़ी तोइत रो, आन ओर मिक के ते गोठी तू कोड्ला माअहूं पोअ रोत सिकाअयुहू. <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />आन तु हानू ओतू तोयोंअ रोतुज वसन ताहूं मुंदू होय, जों ताहूं ख्रिस्तापोअ विश्वासो वाअहीं सुटका ताआ कोइलो काजे ताहूं बुद्दीमान बोणावीत सेकेहे. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />पुरो वसन देवोअ विसारो वाअहीं लेखाअयोहो आन ओं सिकाड़ीलोअ, समजाड़ीलोअ, आन हुदारीइलोअ, आन धार्मिकताआ शिक्शणोअ काजे फायदाआ होय. <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />काहाके देवोअ माहुंउं हुदो बोणे, आन हारेक हाजा कामोअ काजे तियार ओत जाअहूं जोवे.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />देवोअ आन ख्रिस्त ईसुहू साक्शीदार मिकीत कोइत, जो जिवताआ आन मोल्याआं न्याय निवाड़ू कोए, आन तियाआ राज्य आवनारो होय तियाआ ओर मिकीत कोइत आंय ताहूं आदेश आपोहो. <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />के तू वसनोअ परसार कोअ, वेलेपोअ आन बिगर वेलेपोअ तियार रो, आखी जातीइ धिर आन हिकवोणो वाअहीं सुक देखाड़ आन ताबल आन समजाड़. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />काहाके एहलिही वेल आवे, जेहलाम माअहें खोरी हिकवोण ने उनाए वोले, पोन उलटे तियांआं मोर्जी पुरी कोए एहेलाहा तियांआं पोटताज सेवक निवड़ीत लेय. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />आन तियांआं कान सत्याअहें रोत फेरवीत बोणावटी काईंइं वोल लागाड़े. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />पोन तू आखी गोठीमेहें तियारीम रो, दुख वेठ, हाजी बातमी परसार कोइलाआ काम कोअ, आन देवोअ सेवक या नाता वाअहीं ताआ जबाबदारी पुरी कोअ.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />काहाके ओमे माआं गाराहा ओवीइलोअ आन यी दुन्याम रोत जाअलोअ वेल आवित लागीही. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />आंय हाजी कुस्ती रोमीत सुकुहू, आंय माआं गुगदीइलोअ पुरो कोइत लेदोहो, आंय विश्वासोम टिकीत रोयुहू. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />ओमे माआं काजे धर्मीपणोअ तो टोपू वाट जोवेहे, जियाहा धर्मी आन न्यायी प्रभु माहूं तेदिहीं आपे, आन माहूं एतोज नाहां, पोन तियां आखाहा बी जें तियाआ प्रगट ओवीइलाहा मेरे वाअहीं वाट जोवतेहे.<verse eid="2TI 4:8" /></para>
  <para style="s">खाजगी गोठी</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />माआ जागे वेगु आवीइलोअ कोशित कोअ. <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />काहाके यी दुन्याअ सुख हाजो गोमत्लो कोत देमास माहूं सोड़ीत देत थेस्सलनीके जातु रोयुहू. क्रेसकेंस गलातीया जातू रोयुहू आन तितुस दलमतिया इलाखाम जातु रोयुहू. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />निस्तु लुक एतुज माअरी होये. मार्काहा लेतुज आवेए; काहाके सेवाआ काजे तो माआ जास्ती कामोअ होय. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />तुखिकुसोहो आंय इफिसोह मोकल्युहू. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />जो कोट आंय त्रोआसोमेहें कार्पाअहीं मिकीत आयुहू तो आन पुस्तके खास कोइत सांबड़ाआ पत्रे नेहें जेहेलाम तू आविही तेहेलाम लेतू आवजी.<figure style="fig" alt="Scrolls standing by ink well" file="HK00153C.TIF" size="col" copy="Horace Knowles ©" ref="4:13">सहीइ डाबड़ी आन बिड़ु वालित मिकल्ये पुस्तके</figure><verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />अलेक्झान्डर<note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="1TI 1:20">1 तिम 1:20</ref> </char></note> ठठेरे माहूं जास्ती तारास देदुहू; पोन प्रभु तियाहा तियाआ कामोअ परमाणे फल आपे.<note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="PSA 62:12">भजन 62:12</ref>; <ref loc="ROM 2:6">रोम 2:6</ref> </char></note> <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />तू बी सांबालीत रोजी, काहाके तिये आमाआं गोठीइ जास्ती विरोध कोअयुहू.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />जेहेलाम माहूं पेल्लीइ वेले न्यायालयोमेहें जाबाब आपुहूं पोड़्यू, तेहेलाम कोडेज माहूं साथ नाहां देदी, आखे माहूं सोड़ी देदू. याआ तियांहां जाबाब ने आपुहूं पोड़े ताहरोअ हाजो आवे! <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />पोन प्रभु माअरी रोयू आन माहूं सेक्ती आप्यी; काहाके मावाअहीं पुरो पुरो परसार ओवित सेके, आन आखे बिगर यहुदी माहें उनाइत लेअहूं जोवे. आंय सिहांवागोअ जोड़बाम रोत वासात निहींयुहू.<note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="PSA 22:21">भजन 22:21</ref>; <ref loc="DAN 6:21">दानि 6:21</ref></char></note> <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />आन प्रभु माहूं हारेक खाराब कामोम रोत वासाड़े, आन होरगाआ राजोमेहें हाजीहुतायी पोताड़े. तियाआज महिमा सादाजलम ओवती रोअहूं जोवे. आमेन.<verse eid="2TI 4:18" /></para>
  <para style="s">आखरीइ सलाम</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />प्रिस्किल्ला आन अक्विलाहा<note caller="+" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">प्रेशित 18:2</ref> </char></note> आन उनेसिफुरुसोअ कुटूंबाहा सलाम. <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />इरास्तुस करिन्थीमेहें रोत गोयू, आन त्रुफिमुसोहो आंय मिलेतुसोमेहें मांदवाड़्युज टाकी देत आयुहू.<verse eid="2TI 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2TI 4:21" />हियालू सुरु ओवीइलोअ पेल आविइलाअ कोशित कोअ. युबुलूस, पुदेंस, लीनुस आन क्लौदिया आन ओमे आखा पाही ताहूं सलाम कोताहा.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />प्रभु ताआ आत्माअरी रोअहूं जोवे. तुमा आखा पोअ मेरवानी ओवती रोअहूं जोवे.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>