<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">JON- Shikilagar</book>
  <para style="toc3">ಯೊನ</para>
  <para style="toc1">ಯೊನ ಬುಕ್</para>
  <para style="toc2">ಯೊನ</para>
  <para style="toc1">ಯೊನ ಬುಕ್ಕ</para>
  <para style="mt2">ಯೊನ</para>
  <para style="mt1">ಯೊನ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಯೊನಾನು ಪುಸ್ತಕ ಯೊನಾ ನಿನೆವಿ ಗಾಮಾನಾಹುತಿ ರ‍್ಹಯಲ ಉಪದೆಶನಾ ಹುತಿ ಕವಸ. ಬಿಜಾ಼ ಪ್ರವಾದಿಯೊನಾ ಪುಸ್ತಕೊತಿ ಎ ಪುಸ್ತಕ ಯಹೊವಾನಿ ಸಂದೆಶತಿ ಯೊನಾನಾ ಚಾಳಿನಾ ಹುತಿ ವರಿ ಕಾಮೊನಾ ಹುತಿ ದೆಕಾಡಿನೆ ದಿವಸ.ಯೊನಾನಿ ಸೆವೆ ಇಸ್ರಾಯೆಲನೊ ರಾಜೊ಼ ಯೆರೊಬಾಬನ ಕಾಲಮಾ ಕದ್ಯಾಮ ಕಮ್ಸಿ ಕಮ್ಮ ಕ್ರಿಸ್ತ ಪು ಆಟಕ್ಹೊ-ಕ್ಹಾತಕ್ಹೊನ ಐವತ್ತ ಇಸ್ವಿಮಾ ಥಯುಸ. ಕೈನ ಬರೊಕ್ಹೊ ಕರಸ. ತೆ ನೈಸೊ ಎ ಪುಸ್ತಕ ಕೆಳಮಾ ಬರದ್ಯಾಸ ವಿದ್ವಾಂಸೊನೆ ಕವಾನು ಗ್ವತ್ತ ನತ್ತಿ.</para>
  <para style="ip">ಯಹೊವಾ ಯೊನಾನೆ ನೆನಿವೆನಾ ವಿರುದ್ದ ಉಪದೆಶ ಕರಾನಾ ಹುತಿ ಮೊಕಲ್ಯೊ. ತೆ ನೈಸೊ ಯೊನಾ ಯಹೊವಾನಿ ವಾತ ಐಕ್ಯಾ ವಾಚಿ ಪಾಲಶ್ಯಾವಾಚಿ ನೆನಿವೆನಾ ವಿರುದ್ದ ದಿಕ್ಕನೆ ಗಯೊ. 1:1-3. ತೆ ತಾರ್ಶಿಶೆ ಜಾ಼ವಾನಾ ಹಡಗಾಮ ಚಡ್ಯೊ. ಹಡಗೊ ಸಮುದ್ರಪರ ಅಗೊ ಜಾ಼ತಾಮಾ ಯಹೊವಾ ಸಮುದ್ರಪರ ಘನ್ನು ಮ್ಹೊಟು ಔಂದನ ಆವಾ ವರಕ್ಹು ಕರ‍್ಯೊ. ತೆಳಾಮಾ ಹಡಗೊ ಚ಼ಲಾವಾಲಾ ಘನ್ನಾ ಭುಚಕ್ಯಾ. ವರಿ ಯಹೊವಾನಿ ಶಿಟ್ಟ ಶಾಂತ ಥಾವಾದೆ ಮನಕ್ಹೊ ಕೈನ ಯೊನಾನೆ ಸಮುದ್ರಮಾ ನಾಕಿ ಪಾಡ್ಯಾ. ಪಾಚಾ಼ತಾ ಯಹೊವಾ ಯಕ್ಕ ಮ್ಹೊಟಿ ಮಚ಼ಲಿನೆ ಯೊನಾನೆ ಗಳಾನಾ ಹುತಿ ಮೊಕಲ್ಯೊ. ಯೊನಾ ಪಶ್ಚಾತಾಪ ಪಡ್ಯೊ ವರಿ ಯಹೊವಾ ತಿನೆ ವಾಚಾನಾ ಹುತಿ ಅಪ್ಪಣೆ ದಿದ್ಯೊ. ಲಾಸ್ಟಮಾ ಯೊನಾ ನೆನಿವೆಯೆ ಗೈನ ಉಪದೆಶ ಕರ‍್ಯೊ. ವರಿ ತೆ ಗಾಮನಾ ಮನಕ್ಹೊ ಪಶ್ಚಾತಾಪ ಪಡ್ಯಾ. ಯೊನಾನು ಪುಸ್ತಕಮಾ ಯಹೊವಾ ಕೆಕ್ಲೊ ಮರಗಾಲೊ ವ್ಹೈ ಕೈನ ಕವಾನು ದೆಕಾಡಿನೆ ದಿವಸ. ಕಾ ಕದ್ಯಾಮ ಯೊನಾ ಯಹೊವಾ ಮರಗಸ ಕವಾನು ಗ್ವತ್ತ ನ್ಹೊತು. 4:2.</para>
  <para style="iot">ರುಪರೆಖಾ</para>
  <para style="io1">1 ಅದ್ಯಾಯ 1: ಯೊನಾ ಯಹೊವಾಕ್ಹು ಚು಼ಕೈಲಿವನಾ ಹುತಿ ಕೊಶಿಸ ಕರಸ. ವರಿ ಮಚ್ಲಿನಾ ಪೆಟಮಾ ಲಾಸ್ಟ ಥಾವಸ.</para>
  <para style="io1">2 ಅಧ್ಯಾಯ 2: ಯೊನಾ ಮಚ್ಲಿನಾ ಪೆಟಮಾ ಯಹೊವಾನೆ ಪ್ರಾಥನಾ ಕರಸ.</para>
  <para style="io1">3 ಅಧ್ಯಾಯ 3: ಯೊನಾ ನಿನೆವಿ ಗಾಮಮಾ ಉಪದೆಶ ಕರಸ ವರಿ ಮನಕ್ಹೊ ಪಶ್ಚಾತಾಪ ಪಡಸ. ಯಹೊವಾ ತ್ಯುನೊನೆ ಮಾಫ ಕರಸ.</para>
  <para style="io1">4 ಅಧ್ಯಾಯ 4: ಯೊನಾ ಯಹೊವಾ ನಿನೆವಿ ಗಾಮನೆ ಮರಗಲ ಹುತಿ ತೆ ಶಿಟ್ಟ ಥಯೊ. ಯಹೊವಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊಪರ ಮಯಾ ಛೆ ಕವಾನು ದೆಕಡಿನೆ ದಿವಸ.</para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">ಯೊನಾ ಯಹೊವಾನೆ ಅವಿಧೆಯ ಥಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />ಯಕ್ಕ ದಿನ್ನ ಯಹೊವಾನಿ ವಾಕ್ಯಾ ಅಮತ್ಯನಾ ದಿಕ್ರಾನೆ ಯೊನ ಕವಾಲಾನೆ ಮಳಿ. ತೆ ಸವೈ ಕದ್ಯಾಮ, <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />ತು ಉಟ, ತೆ ನೆನಿವಿ ಕವಾಲಾ ಮ್ಹೊಟಾ ಗಾಮೆ ಗೈನ ಗಾಮನಾ ವಿರುಧ್ದ ಪ್ರಸಂಗ ಕರ ಕಾಕದ್ಯಾಮ ತ್ಯುನಾ ಕೆಟ್ಟ ಕಾಮೊ ಯಹೊವಾನಾ ಕ್ಹಾಮಾ ಭರಿಗಯಾಸ <verse eid="JON 1:2" /><verse number="3" style="v" sid="JON 1:3" />ತೆ ನೈಸೊ ಯೊನಾ ಯಹೊವಾನೆ ಕ್ಹಾಮಾತೊ ದುರ ಜಾ಼ವಾನಾಹುತಿ ತಾರಷಿಸಿ ಗಾಮೆ ನಾಟಿ ಜಾವಾಹುತಿ ಯೊಪ್ಪಮಾ ಉತ್ರಿನ ತಾರ್ಷಿಶಿನೆ ಜಾ಼ವಾನಾಹುತಿ ಹಡಗಾಮಾ ಬೈಟೊ ವರಿ ತಿನಾಹುತಿ ತೆ ಪ್ರಯಾಣನಿ ಕಿಮ್ಮತ ದಿದ್ಯೊ.<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />ತೆಳಾಮಾ ಯಹೊವಾ ಮ್ಯೊಟೊ ವಾರೊ ಸಮುಂದರಪರ ಆವಾ ವರಕ್ಹು ಕರ‍್ಯೊ. ಸಮುಂದರಪರ ಮ್ಹೊಟು ತುಫಾನ ಐನ ಹಡಗೊ ಫುಟಿಜಾವಾ ವರಕ್ಹು ವ್ಹತ್ತೊ. <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />ತೆಳಾಮಾ ಹಡಗೊ ಚ಼ಲಾವಾಲಾ ಭುಚ಼ಕ್ಯಾ, ವರಿ ಯೆಕಕಲಾ ತಿವ್ನಾ ತಿವಾನಾ ದಿವಸ್ತಾನೊನೆ ವದರ‍್ಯಾ ಹಡಗೊ ಶಾಂತ ಕರುಕೈನ ವರಿ ಹಡಗಾನು ವಜ್ಜು ಕಮ್ಮ ಕರಾನಾ ಹುತಿ ತಿಮಾ ರ‍್ಹಯಲ ಸಾಮಾನ ಸಮುಂದರಮಾ ನಾಕ್ಯಾ ತೆಳಾಮಾ ಯೊನ ಹಡಗಾನಾ ಹೆಟ್ಲೆಭಾಗಮಾ ಗೈನ ಘನಿ ನಿಂದರ ಕರಾಡೊತೊ.<verse eid="JON 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 1:6" />ಹಡಗಾನು ಖಾಸ ಅದಿಕಾರಿ ತಿಕನ ಐನ ಕದ್ಯೊ ತು ಕಾ ಕ್ಹುರೊಯೊಸ?. ತು ಉಟಿನ ಗೈನ ತಾರಾ ಯಹೊವಾನೆ ಪ್ರಾಥನಾ ಕರ ವರಿ ತಾರೊ ಯಹೊವಾ ಎ ನಾಶಕ್ಹು ಹಮ್ನೊನೆ ವಚಾ಼ಡ್ಸ.<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />ತೆಳಾಮಾ ಹಡಗಾ ಚಲಾವಾಲಾ ತ್ಯುನೊಮಾಜ಼ ಬಿಲ್ಲಿದ್ಯಾ. ಎ ತ್ರಾಸ ಆವಾನೆ ಕುನ್ನ ಕಾರಣ ವಸ ಕೈನ ಬೊಲ್ಲಿದ್ಯಾ? ಆವೊ ಚಿಟಿಯೊ ಘಾಲ್ಲಿನ ದೆಕಿಯೆ ಕೈಲೆತಾಮಾ ತಿಮ್ಮ ಕರ್ತಾಮಾ ಯೊನಾನಾ ನಾಮನಿ ಚಿಟಿ ನಿಕ್ಹಳಿ. <verse eid="JON 1:7" /><verse number="8" style="v" sid="JON 1:8" />ತೆಳಮಾ ಹಡಗಾ ಚ಼ಲಾವಾಲಾ ಎ ದುರಂತನೆ ಕಾರಣ ಕುನ್ನ ವ್ಹೈ ಕೆ? ಕಯಾ ಕಾಮೆ ಆಯೊಸ? ತು ಕಜ್ಗಾತೊ ಆಯೊಸ? ತುಯಾ ಜನಂಗನೊ ವ್ಹೈ?. ತು ಕಯಾ ದೆಶ ವ್ಹೈ? ಕೈನ ಪುಚ್ಯಾ.<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />ತೆ ವಾತೆ ಯೊನಾ "ಮಿ ಹಿಬ್ರಿಯವಾಲೊ ವ್ಹೈ. ಸಮುದ್ರ ಭುಮಿ ತಯ್ಯಾರಕರಲ ಪರಲೊಕನೊ ಯಹೊವಾ ಥಯಲ ಸರ್ವೆಶಕ್ತನೊ ಭೆಮಾ ರ‍್ಹವಾಲೊ ವ್ಹೈ ಕೈನ ಕದ್ಯೊ. <verse eid="JON 1:9" /><verse number="10" style="v" sid="JON 1:10" />ತೆ ನೈಸೊ ತೆ ಆ ಸ್ವಾಮಿನಾ ಸನ್ನಿಧಿಮಾತೊ ನ್ಹಾಟಿ ಚಾ಼ಲ್ಯೊಸ ಕೈನ ಕದ್ಯೊ.</para>
  <para style="p" vid="JON 1:10">ಎ ಐಕಲ ತ್ಯುನೆ ಘನ್ನಾ ಭುಚ್ಕಿನ ತಿನಿ "ತು ಆ ಸುಕರ‍್ಯೊ! ಕೈನ ಪುಚ್ಯಾ. <verse eid="JON 1:10" /><verse number="11" style="v" sid="JON 1:11" />ತೆಳಾಮಾ ಸುಮುದ್ರಪರ ವರಿ ಝೊರ ವಾರೊ ಥಾವಾಡ್ಯಾತು. ತಿನಾಹುತಿ ತ್ಯುನೆ ತಿನೆ ಪುಚ್ಯಾ ನಾವಿಕೊ ಯೊನಾನೆ ಸಮುದ್ರ ಶಾಂತ ಥಾವಾದೆ ಕದ್ಯಾಮ ಹಮೆ ತುನೆ ಸು ಕರಿಯೆ” ಕೆ ಕೈನ ಪುಚ್ಯಾ.<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />ತೆಳಾಮಾ ಯೊನಾ ತ್ಯುನೊನೆ ಮನೆ ಉಚೈನ ಸಮುಂದರಮಾ ನಾಕೊ ತೆಳಾಮಾ ತುಫಾನ ಶಾಂತ ಥಾವಸ ಎ ತುಫಾನ ಆವಾನೆ ಕಾರಣಜ಼ ಮಿ ವ್ಹೈ ಕೈನ ಕದ್ಯೊ.<verse eid="JON 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13" />ಹಡಗಾಮಾ ರ‍್ಹಯಲವಾಲಾ ತೆ ವಾತೆ ವಪ್ಯಾವಾಚಿ಼ ಹಡಗಾನೆ ದಂಡಿಯೆ ವಾಪಾಸ ನಿಂಜಾವು ಕೈನ ಘನ್ನಿ ಕೊಶಿಶ ಕರ‍್ಯಾ ತ್ಯುನೊನೆ ಥಯು ನೈ ಕಾದ್ಯಾಮ ಸಮುಂದರ ಅಲ್ಲೊಲ ಕಲ್ಲೊಲ ಥಾವಾಡ್ಯುತು. <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ತ್ಯುನೆ ಯಹೊವಾನೆ ಪ್ರಾಥನಾ ಕರ‍್ಯಾ ಹಮೆ ಆ ಮನಕ್ಹೊನು ಜ಼ಲಮ ಹಮಾರಾಹುತಿ ನಾಶ ಥಾವುನೈ ಅಪರಾದ ನೈಸೊ ರಗತ ಹಮೊಪರ ಚ಼ಡು ನಕೊ ಯಹೊವಾ ಆ ಕ್ಹಾರೊ ಆಯಲ ತಾರಿ ಚಿತ್ತ. <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />ಪಾಚಾ಼ತಾ ತ್ಯುನೆ ಯೊನಾನೆ ಉಚೈನ ಸಮುದ್ರಮಾ ನಾಕ್ಯಾ ತೆಳಾನಾ ತೆಳೆಜ಼ ಸುಮುದ್ರ ತಿನು ಅರ್ಭಾಟ ಹುಬ್ರಾಡಿನ ಶಾಂಥ ಥಯು. <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />ತೆಳಾಮಾ ತೆ ಮನಕ್ಹೊ ಯೆಹೊವಾಕ್ಹು ಘನ್ನಾ ಭುಚ಼ಕಿನ ಯಹೊವಾನೆ ಬಲಿ ಚಡಾಯಾ ವರಿ ಯೆಹೊವಾನೆ ಮನ್ನತ ಮಾಂಗ್ಯಾ.<verse eid="JON 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17" />ತೆ ಥಯಲಪರ ಯಹೊವಾ ಯೊನನೆ ಗಳಾನಾಹುತಿ ಮ್ಹೊಟಿ ಮಚ಼ಲ ಕರ‍್ಯೊ ಯೊನ ತೆ ಮಚಲಿನಾ ಪೆಟಮಾ ತನ್ನ ದಿನ್ನ ತನ್ನ ರಾತ ವ್ಹತ್ತೊ.<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">ಯೊನನಿ ಪ್ರಾಥನಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />ಯೊನ ತೆ ಮಚಲಿನಾ ಪೆಟಮಾತೊ ರ‍್ಹೈನ ತಿನೊ ಯಹೊವಾ ಥಯಲ ಯಹೊವಾನೆ ಇಮ್ಮ ಪ್ರಾಥನಾ ಕರ‍್ಯೊ.<verse eid="JON 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JON 2:2" />ಕಷ್ಟನಾ ಟೈಮಾ ಮಿ ಯಹೊವಾನೆ</para>
  <para style="q2" vid="JON 2:2">ಬರೊಕ್ಹೊ ಮುಕ್ಯೊಸ. ವರಿ ತೆ ಮನೆ</para>
  <para style="q1" vid="JON 2:2">ಜ಼ವಾಬ ದಿವಸ ನರಕನಾ ಗರ್ಭಮಾತೊ ಸಹಾಯಕರ ಕೈನ</para>
  <para style="q2" vid="JON 2:2">ಮಿ ವದ್ರಿನ ಕದ್ಯೊ. ತೆಳಾಮಾ ಮಿ ಬಲಾಯಲ ತು ಐಕ್ಯೊ.<verse eid="JON 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3" />ಕಾ ಕದ್ಯಾಮ ಮನೆ ತು ಸಮುಂದರನಿ</para>
  <para style="q2" vid="JON 2:3">ಉಂಡಿ ರ‍್ಹಯಲ ಜ಼ಗಾಮಾ</para>
  <para style="q2" vid="JON 2:3">ನಾಕಿಪಾಡ್ಯೊಸ್ತೊ, ಸಮುಂದರಮಾ</para>
  <para style="q2" vid="JON 2:3">ರ‍್ಹಯಲ ವರಿ ಪ್ರವಾಹ ಮನೆ ಸುತ್ತಿಲಿದಿಯೊ; ಮ್ಹೊಟಿಯೊ ಅಲಿಯೊ ಮಾರಾ ಮಾತಾಪರ್ತಿಯೊ ಚಾ಼ಲಿಯೊತಿಯೊ<verse eid="JON 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4" />ತೆಳಾಮಾ ಮಿ ಕದಲ ತಾರಾ ಡೊಳಾನಾ ಕ್ಹಾಮಾತೊ ಭಾರೊ</para>
  <para style="q2" vid="JON 2:4">ಘಾಲಿಪಾಡಲಂಗತಚೆ ಥೈತಬಿ ಮಿ ತಾರಾ ಪರಿಶುದ್ಧ ಸನ್ನಿದಿಮಾ ಫರಿನ ವರಿ ದೆಕುಸ<verse eid="JON 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5" />ಮಾರಾ ಸುತ್ತೆ ಫರಾನು ಪಾನಿ ಮನೆ</para>
  <para style="q2" vid="JON 2:5">ಭುಚ಼ಕಾಡ್ಯು ಉಂಡುರ‍್ಹಯಲ ಮನೆ ಸುತ್ತೆ ಝಾಕಿಪಾಡ್ಯು</para>
  <para style="q2" vid="JON 2:5">ಪಚಿಯೊ ಮಾರಾ ಮಾತಾನೆ ಸುತ್ತಿಲಿದಿಯೊತ್ಯೊ<verse eid="JON 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6" />ಡೊಂಗರೊನಾ ವಚ಼ಮಾ ಉತರಿಗಯೊತೊ,</para>
  <para style="q2" vid="JON 2:6">ವರಿ ಜಿಮಿನಮಾ ಮ್ಹೈ</para>
  <para style="q1" vid="JON 2:6">ಗೈನ ಬಾಕಲನ್ಯೊ ಚಾವಿಯೊ</para>
  <para style="q2" vid="JON 2:6">ಘಲಾಯಿಗಯೊ. ವರಿಬಿ ಉಂಡಾಮಾತು ತು ಮನೆ ಉಪ್ಪರ ಲಾಯೊಸ. ಎ ಮಾರೊ ಯಹೊವಾ ಥಯಲ ಯಹೊವಾ,<verse eid="JON 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7" />ಮಾರೊ ಜ಼ಲಮ ಮಾರಾಮಾತೊ</para>
  <para style="q2" vid="JON 2:7">ಕುಂದಿಗಯಲ ಟೈಮಾ ಯಹೊವಾ ತುನೆ ಶೆಕರಲಿನ ಮಾರಿ</para>
  <para style="q2" vid="JON 2:7">ಪ್ರಾಥನಾ ತುಕನ ತಾರಿ ಪರಿಶುದ್ಧ ಆಲಯಮಾ ಐ.<verse eid="JON 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8" />ಉಪಯೊಗ ನೈಸೊ ಮೊರತಿಯೊನೆ ಪುಜಾಕರಾಲಾ.</para>
  <para style="q2" vid="JON 2:8">ಯಹೊವಾನಿ ಮಯಾ ಛೊಡಿಪಾಡಸ.<verse eid="JON 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9" />ವರಿ ಮಿ. ಸ್ತೊತ್ರಾ ಕವಾನು ಯಕ್ಕ</para>
  <para style="q2" vid="JON 2:9">ರಿಕಾಡ ನಾ ಕ್ಹಾತೆ ಬಲಿ ಚ಼ಡೌಸ,</para>
  <para style="q2" vid="JON 2:9">ಮಿ ಕಯಿಲಿದಲ ಪುರಾಕರ‍್ಯೊಸ.</para>
  <para style="q1" vid="JON 2:9">ರಕ್ಷಣಾ ಯಹೊವಾ ಕಂತುಜ಼ ಆವಸ ಕೈನ ಕದ್ಯೊ.<verse eid="JON 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />ತೆಳಾಮಾ ಯಹೊವಾ ಯಹೊವಾ ಮಚಲಿನ ಕತಾ ಟೈಮಾ ತೆ ಮಚಲಿ ಯೊನನೆ ಜಿಮಿನ್ಪರ ವಕ್ಕಕಿಪಾಡಿ.<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">ಯೊನಾ ಯಹೊವಾನೆ ವಿಧೆಯ ಥಾವಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />ಯೊನನೆ ಯಹೊವಾನಿ ವ್ಯಾಕ್ಯಾ ಬೆವಾಸಲಾ ಐ, ವರಿ ಅಮ್ಮ ಕದ್ಯೊ. <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />"ತು ಉಟಿನ ಗೈನ ನಿನೆವಿ ಕವಾಲಾ ಮ್ಹೊಟಾ ಗಾಮೆಮಿ ತುನೆ ಕದಲ ಸಂದೆಶ ಕ್ಹಾರು ತ್ಯಾನಾ ರ‍್ಹಯಲವಾಲಾ ಮನಕ್ಹೊನೆ ಕೆ ಕೈನ ಕದ್ಯೊ. <verse eid="JON 3:2" /><verse number="3" style="v" sid="JON 3:3" />ತೆಳಾಮಾ ಯೊನ ಉಟಿನ ಯಹೊವಾನಿ ಸಂದೆಶಲಿನ ನಿನೆವಿ ಗಾಮೆ ತನ್ನ ದಿನ್ನ ಪ್ರಯಾಣ ಯಕುಲು ಘನ್ನು ಮ್ಹೊಟುಗಾಮ ವ್ಹತ್ತು. <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />ಯೊನ ತೆ ಗಾಮ್ಮಾ ಗೈನ ಯಕ್ಕ ದಿನ್ನ ಯಕಲು ಪ್ರಯಾಣ ಕರ್ತೊ ಚಾ಼ಳಕ್ಹ ದಿನ್ನ ಥಯಲಪರ ನಿನೆವಿ ಕವಾನಾಗಾಮ ಪಾಡಾಲಗಾಡಿಪಡಸ” ಕೈನ ಕದ್ಯೊ.<verse eid="JON 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 3:5" />ಎ ಐಕಿನ ನಿನೆವಿನಾ ಮನಕ್ಹೊ ಯಹೊವಾಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಿನ ಉಪಾಸ ಕರೊ ಕೈನ ಕದ್ಯಾ ಮ್ಹೊಟಾವೊತಿ ಧರಿನ ನ್ಹಾನಾ ಲಕ್ಕಾ ತೆಕಲಾ ಜ಼ನಾ ಕೊತಳಾ ಸುತ್ತಿಲಿದ್ಯಾ.<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />ಯೊನನು ಸಂದೆಶ ನಿನೆವಿನಾ ರಾಜಾ಼ನೆ ಮಳಿ ತೆಳಾಮಾ ತಿನಿ ಸಿಂಹಾಸನ ಛೊಡಿನ ಉಟಿನ ತಿನಾ ವಣ್ಣಾ ಕಾಡಿನ ಕೊತಳಾ ಸುತ್ತಿಲಿನ ರಾಕಮಾ ಬೈಟೊ. <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />ತೆ ತಿನಿ ವರಿ ರಾಜಾಧಿಕಾಧಿರಮಾತೊ ಆಗನ್ಯಾ ದಿದ್ಯೊ ಮನಕ್ಹೊ ಪ್ರಾಣಿಯೊನು ಹಿಂಡ ಸುಜ಼ ಸವಾದ ದೆಕು ನೈ ಖೌ ನೈಸೊ ವರಿ ಸುಜ಼ ಪ್ಯುನೈಸೊ, <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />ಕ್ಹಾರಾ ಘನ್ನಾ ಪ್ರಾಥನಾ ಕರಿಯೆ ಯಕೆಕ್ಲಾ ತ್ಯುನಾ ಕೆಟ ಕಾಮೊಚೊಡಿಪಾಡ್ಯಾ. ಮನಕ್ಹೊ ಜಾನವಬರಿ ಕೊತಳಾ ವಳ್ಳಿದ್ದಾ ತ್ಯುನಾ ಕೆಟ್ಟ ಕಾಮೊ ಛೊಡಿಪಾಡ್ಯಾ. <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />ಇಮ್ಮ ಕರ‍್ಯಾಮ ಯಹೊವಾ ಯಕ್ಕ ಟೈಮ ಮನಸ ಬದಲಾವಣೆ ಕರಲೆಸ ತಿನಿ ಶಿಟ್ಟ ಇಕ್ಹರಿನ ತಿನಿ ಮರಗಾ ಹಮ್ನೊನೆ ವಚಾ಼ಡಸ ಕೈನ ಕವಾನು ನಿನೆವಿ ಗಾಮ್ಮಾ ಕದ್ಯಾ.<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />ತೆಳಾಮಾ ಯಹೊವಾ ನಿನೆವಿನಾ ಗಮಾನಾ ತ್ಯುನಾ ಕೆಟ ಕಾಮೊ ಚೊ಼ಡಲ ದೆಕಿನ ಮರಗಿನ ತೆ ತ್ಯುನೊನೆ ಕೆಡಕ್ಹು ವಚಾ಼ಡ್ಯೊ.<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">ಯೊನಾನಿ ಶಿಟ್ಟ ವರಿ ಯಹೊವಾನಿ ಮರ್ಗಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />ತೆ ನೈಸೊ ಎ ಕ್ಹಾರು ದೆಕಿನ ಯೊನ ಘನ್ನೊ ಬಾಜಾ಼ರ ಥೈನ ಶಿಟ್ಟ ಥಯೊ. <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />ತೆ ಸಿಟ್ಟ ಥೈನ ಯಹೊವಾನೆ ಪ್ರಾಥನಾ ಕರ‍್ಯೊ. "ಯಹೊವಾ ಮಿ ಮಾರಾ ದೆಶಮಾ ರಥಾ ಟೈಮಾಜ ಇಮ್ಮ ಥಾವಸ ಕೈನ ಕದ್ಯೊತೊ ನೈ ಇನಾಹುತಿ ಮಿ ಚು಼ಕೈಲಿನ ತಾರ್ಶಿಶಿನೆ ನ್ಹಾಟಿ ಚಾ಼ಲ್ಯೊತೊ. ತು ಮಯಾನು ರುಪ ವ್ಹೈ. ತು ದಯಾಳು ಮರಗಾಲೊ ವ್ಹೈ. <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />ತಿನಾಹುತಿ ಎ ಯಹೊವಾ ಮಾರೊ ಜ಼ಲಮ ಮಾರಾಮಾತೊ ಕಾಡ ಮಿ ವಾಚೊಬಿತಿ ಮರಿಜಾ಼ವಾನು ಚೊ಼ಕು ವ್ಹೈ” ಕೈನ ಮಾಂಗಿಲಿದ್ಯೊ. <verse eid="JON 4:3" /><verse number="4" style="v" sid="JON 4:4" />ತಿನಾ ಹುತಿ ಯಹೊವಾ ತಿನೆ ತು ಸಿಟ್ಟ ಥಾವಾನು ಚೊ಼ಕು ವಹಿಸು? ಕೈನ ಪುಚ್ಯೊ. <verse eid="JON 4:4" /><verse number="5" style="v" sid="JON 4:5" />ಪಚಾತೊ ಯೊನ ತೆ ಗಾಮ ಛೊಡಿನ ಪುರ್ವಬಗಲ ಗೈ ಯಕ್ಕ ಝುಪಡು ಭಾಂದಿಲಿನ ಗಾಮ್ಮಾ ಸು ಥಾವಾಡ್ಯುಸ ಕೈನ ದೆಕತೊ ಬೈಟ್ಯೊ. <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />ತೆಳಾಮಾ ಯಹೊವಾ ಯೊನಾನಾ ಉಪರ ಯಕ್ಕ ಬಳ್ಳಿನ ಬೆಳಸಿನ ಛವಲಿ ಕರ‍್ಯೊ ತಿನಿ ಹೊಂದಾಣಿಕೆ ಥವಾವರಕ್ಹು ಕರಲ ದೆಕಿನ ಯೊನನೆ ಘನ್ನಿ ಖುಶಿ ಥೈ. <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />ಮರ್ನಾ ದಿನ್ನೆ ಉಜಾಲು ಥಾತಾಮಾ ಯಹೊವಾ ಯಕ್ಕ ಕಿಡು ಕರ‍್ಯೊ. ವರಿ ತೆ ಕಿಡು ತೆ ಬಳ್ಳಿನೆ ಕುಕ್ಹೈನ ಜಾವಾವರಕ್ಹು ಮಾರ‍್ಯು. <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />ಸುರ್ಯೊ ಹುಟ್ತಾಮಾ ಯಹೊವಾ ಘನ್ಯೊ ಉನ್ನೊ ವಾರೊ ಕರ‍್ಯೊ ತೆಳಾಮಾ ತಡಕೊ ಯೊನಾನೆ ಮಾತಾಪರ ಲಾಗತಾಮಾ ಚಕ್ಕರ ಆವಾ ವರಕ್ಹು ಥಯು ಮನೆ ಮೌತ ಮಾಂಗಾಡ್ಯೊ ಮಿ ವಾಚಾ಼ತಿ ಬಿ ಮರಾನು ಚೊ಼ಕು ವ್ಹೈ ಕದ್ಯೊ. <verse eid="JON 4:8" /><verse number="9" style="v" sid="JON 4:9" />ತೆಳಾಮ ಯಹೊವಾ ಯೊನನೆ "ತು ಬಳ್ಳಿನಾ ಹುತಿನ. ಶಿಟ್ಟ ಥಯೊಸ ಚೊ಼ಕು ವ್ಹೈಸು? ಕದ್ಯೊ ತೆ ಮಿ. ಮರಿಜಾ಼ವಾ ವರಕ್ಹೊ ಶಿಟ್ಟ ಥಾವಾನು ಚೊ಼ಕು ವ್ಹೈ ಕದ್ಯೊ. <verse eid="JON 4:9" /><verse number="10" style="v" sid="JON 4:10" />ತೆಳಾಮ ಯಹೊವಾ ತು ಬಳ್ಳಿನಾ ಹುತಿ ಕಷ್ಟಪಡ್ಯೊನೈ ಬೆಳೆಶ್ಯೊ ನೈ ಯಕ್ಕ ರಾತಮಾ ಹುಟ್ಟಿನ ಯಕ್ಕ ರಾತಮಾ ನಾಷ ಥಯಲಹುತಿ ತು ಯಕ್ಲೊ ಕಾಳಜಿ ಕರಾಡ್ಯೊಸ. <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ತ್ಯುನೆ ಸು ತಪ್ಪ ಕರಾಡ್ಯಾಸ ಕವಾನು ಗ್ವತ್ತ ನೈಸೊ ಯಕ್ಕ ಲಾಕ ಇಕ್ಹ ಹಜಾ಼ರ ಮನಕ್ಹೊನೆ ವರಿ ಜಾನವರೊನೆ ರ‍್ಹಯಲ ನೆನೆವೆ ಮ್ಹೊಟಾ ಗಾಮನೆ ಮಿ ಕೆಕ್ಲೊ ಚಿಂತಾ ಕರು ನೈಸು?. ಕದ್ಯೊ<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>