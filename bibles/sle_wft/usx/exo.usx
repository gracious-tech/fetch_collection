<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EXO" style="id">- Shikkalgar</book>
  <para style="h">ವಿಮೊಚನಕಾಂಡ</para>
  <para style="toc3">ವಿಮೊಚನಕಾಂಡ</para>
  <para style="toc2">ವಿಮೊಚನ</para>
  <para style="toc1">ವಿಮೊಚನಕಾಂಡ ಬುಕ್ಕ</para>
  <para style="mt2">ವಿಮೊಚನನಕಾಂಡ</para>
  <para style="mt1">ವಿಮೊಚನಕಾಂಡ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಆದಿಕಾಂಡಮಾ ಗಮನಾ ವ್ಯಯಕ್ತಿಕ ಪಿತಾಮಹಾನಾ ಉಪ್ಪರ ದೆಕಾಡಸ, ವಿ ಮೊಚನಕಾಂಡಮಾ ಎ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನಾ ಉಪ್ಪರ ಯಾಕೊಬ ವರಿ ತಿನಾ ಬಚ್ಚಾವೊನಾ ಕುಟುಂಬೊನೆ ಮಳಲ ಸತ್ತರ ಮನಕ್ಹೊ (ಆದಿಕಾಂಡ 46:27; ವಿಮೊಚನಕಾಂಡ. 1:1), ಹಮ್ನಾ ಇಸಾಬ ನೈಸೊ ಘನ್ನಾ ಜನಾ ಥಯಾಸ ವರಿ ಇಸ್ರಾಯೆಲೊ, ಕದ್ಯಾಮ, ‘ಇಸ್ರಾಯೆಲನಾ ಬಚ್ಚಾ. (7; 1 ವಚನಾ; ಆದಿಕಾಂಡ 42:5; ವರಿ 45:21; 46:5) ವರಿ ‘ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊ’ 9). ಅದ್ಯಾಯ 1 ಮಾ ಇಸ್ರಾಯೆಲೊನಿ ದಬ್ಬಾಳಿಕೆ ಅದ್ಯಾಯ 3 ನಿ ಬಿಡುಗಡೆನು ಬರೊಕ್ಹಾನೆ ಆಧಾರ ರ‍್ಹಯಲ ಹಿನ್ನಲೆ ದೆಕಾಡಸ. ಪುಸ್ತಕನಾ ಬಿಜಾ ಭಾಗೊ ಕ್ಹುದಾ ವಾಗ್ದಾನ ಕರಲ ಎ ಬಿಡುಗಡೆಮಾ ಕಿಮ್ಮ ಚಲಾವಸ ವರಿ ವಾಟಮಾ ಆವಾನಾ ತ್ರಾಸೊನೆ ಇಸ್ರಾಯೆಲೊ ಕಿಮ್ಮ ಕರಸ ಕವಾನಾಹುತಿ ಸಂಬಂದ ಛೆ. ವಿಮೊಚನಕಾಂಡ ಪುಸ್ತಕ ಇಸ್ರಾಯೆಲನಿ ಔಪಚಾರಿಕ ಶುರುವಾತನೆ ಯಹೊವಾನಾ ಮನಕ್ಹೊ ಲಿಂಗತ ದೆಕಾಡಸ. ತ್ಯುನೆ ಕಿಮ್ಮ ಬಿಡುಗಡೆ ಥಯಾ, ಘಟ್ಟ ಥಯಾ ವರಿ ಸಿನಾಯನಾ ಉಪ್ಪರ ನಿಯಮೊನೆ ಕಿಮ್ಮ ಲಿದ್ಯಾ ಕವಾನು ಎ ದೆಕಾಡಿನ ದಿವಸ. ಇಮ್ಮ ರ‍್ಹಯುತಬಿ ಎ ಕ್ಹರಿನು ಶುರುವಾತನು ಪುಸ್ತಕ ನೈತೊ ‘ಬೈಬಲನು ಪಸ್ಟ ಪುಸ್ತಕ ವ್ಹೈ’ ಕೈನ ಕಳ್ತು ನೈ (ಡರ್ಹಾಮ, ವಿಮೊಚನಕಾಂಡ, ನಾ ವಿರುದ್ದ). ಹೊ, ಎ ‘ಬರೊಕ್ಹಾನು ಪುಸ್ತಕ ವ್ಹೈ, ಬರೊಕ್ಹಾನಾಹುತಿ, ವರಿ ಶುರುವಾತನೊ ಬರೊಕ್ಹೊ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಕರಲ ಛೆ. ತೆನೈಸೊ ತೆ ಬರೊಕ್ಹಾನೊ ಕ್ಹರಿನಿ ಶುರುವಾತ ಆದಿಕಾಂಡಮಾ ಅಬ್ರಾಹಾಮ ವರಿ ‘ಇಸ್ರಾಯೆಲನಾ ಬಚ್ಚಾ’ ಕಾನಿಯೊಮಾ ಛೆ. ಆದಿಕಾಂಡ ಆಂ ಬರೊಕ್ಹಾನೆ ತಪ್ಪ ಒಪ್ಪಿಕೆನು ವರಿ ಸಾಮಾಜಿಕ ಕಿಮ್ಮ ರ‍್ಹವಾನು ಕೈನ ದೆಕಾಡಸ. ಎ ಬರೊಕ್ಹೊ ಉಜಾಲಾಮಾ, ಆದಿಕಾಂಡಮಾ ಲಿಕ್ಕಲ ಛೆ, ವಿಮೊಚನಕಾಂಡಮಾ ಇಸ್ರಾಯೆಲೊನಾ ಬರೊಕ್ಹಾನಾ ಕಾನಿಯೊ ತಿಳ್ದಿ ಲ್ಯು. ಶಿರ್ಷಿಕೆ ವರಿ ಪಟ್ಯ ಗ್ರಿಕ ಸೆಪ್ಟುಅಜಿಂಟ (LXX) ಲ್ಯಾಟಿನ ವಲ್ಗೆಟ್ ಎ ಪುಸ್ತಕನೆ ‘ವಿಮೊಚನಕಾಂಡ’ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯಾಸ. ಕಾಕದ್ಯಾಮ ಇಸ್ರಾಯೆಲೊ ಐಗುಪ್ತಮಾತಾ ಜಾವಾನು ಎ ಪುಸ್ತಕಮಾ ಒತ್ತಿನ ಕದ್ಯಾಸ, 19:1 ಹಿಬ್ರು ಬೈಬಲ ಎ ಪುಸ್ತಕನೆ ‘ವರಿ ಇನಾ ನಾಮೊ’ ಕೈನ ಬಲಾವಸ. ಎ ಶಿರ್ಷಿಕೆನೆ 1:1 ತಾ ಲಿದಲ ಛೆ ವರಿ ಆದಿಕಾಂಡಮಾ 46:8 ಮಾ ಎಜ ಶಿರ್ಷಿಕೆನೆ ಶೆಂ ಕರಸ. ವಿಮೊಚನಕಾಂಡ 1:1-5 ವಾಸ್ತವಮಾ ಸಾರಾಂಶನಾ ರುಪಮಾ ಆದಿಕಾಂಡ 46:8-27 ಹಜಿ ಯಕ್ಕ ಸಲಾ ಶುರು ಕರಲ ಛೆ.</para>
  <para style="ip">‘ವರಿ’ ಕವಾನಿ ಸಂಯೊಗ ಎ ಪುಸ್ತಕಮಾ ಛೆ. ಆದಿಕಾಂಡಮಾ ಸು ಥಯು ಕವಾನು ಸಿದಾ ಜವಾಬನು ಭಾಗ ಥಯುಸ ಕೈನ ದೆಕಾಡಸ. ಆದಿಕಾಂಡನು ಲಾಸ್ಟ ಭಾಗ ವಿಮೊಚನಕಾಂಡನೆ ದೆಕಾಡಸ, ಯೊಸೆಫ ತಿನಿ ಮರಣನಾ ವಚ್ಚಾನಾವೊನೆ ತಿನಿ ಆಸ ಕವಸ, ಯಕ್ಕ ದಿನ್ನ ತಿನಾ ಹಡ್ಕಾವೊನೆ ಐಗುಪ್ತತೊ ವಾಗ್ದಾನ ಕರಲ ದೆಶನೆ ತಿನಾ ಕ್ಹಾಂದಾನವಾಲಾ ಲಿನ ಜಾ಼ವಸ (ಆದಿಕಾಂಡ 48; ಹಿಬ್ರು 11:22). ಆದಿಕಾಂಡ ಲಿಂಗತ, ಪುಸ್ತಕನಾ ಕ್ಹಾಸ ಪಟ್ಯ ಸಾಕ್ಷಿಯೊ ಕದ್ಯಾಮ;</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1) ಮೆಸೊರೆಟಿ ಪಟ್ಯ (MT),</para>
  <para style="io1">2) ಸಮರಿಟನ ಪೆಂಟಟೆಚ್ (SP),</para>
  <para style="io1">3) ಸೆಪ್ಟುಅಜಿಂಟ್ (LXX) ವರಿ,</para>
  <para style="io1">4) ಕುಮ್ರಾನನಾ ತುಣುಕೊ. MT ಘನ್ನು ಬರೊಕ್ಹಾನು ಛೆ. ಕುಮ್ರಾನನಾ ತುಣುಕೊ MT ತಾ ದಕ್ಹಾ ರುಪಾಂತರೊನೆ ದೆಕಾಡಸ. ಲೆಖಕ ವರಿ ತಾರಿಕ ಮೊಶೆ, "ಕ್ಹುದಾನಾ ಕ್ಹಾರಾ ವಾತೊನೆ ಲಿಕ್ಯೊ" 24:4 ಇಮಾ ‘ಅಮಾಲೆಕ್ಯವಾಲಾವೊನಾ ಕ್ಹಾತೆ ಥಯಲ ಯುದ್ದನೊ ದಾಖಲೊ 17:14 ದಕ್ಹ ಆಗನ್ಯಾ 34:4, 27-29 ವರಿ ಒಡಂಬಡಿಕೆನು ಪುಸ್ತಕ 20:22, 23:33 ಛೆ. OT ದೆಕಾಡಿನ ದಿವಸ ವರಿ NT ಒಪ್ಪಸ.. 7:7 34:7 ಕಮ್ಮಶಿ ಕಮ್ಮ 1445 ಕ್ರಿ.ಪು ಸೊಲೊಮೊನ ತಿನಿ ಆಳ್ವಿಕೆನಾ ಚಾರವಾ ವರಕ್ಹಮಾ ದೆವಾಲಯ ಕರಾನು ಶುರು ಕರ‍್ಯೊ, ತೆ ಟೈಮೆ ವಿಮೊಚನಕಾಂಡನಾ ತಾರಿಕತೊ 480 ವರಕ್ಹೊ ಥಯಾಸ 1 ಅರಸುಗಳು 6:1. ವಿಮೊಚನಕಾಂಡ 12:40 ಕಯೆ ನಿಂಗತ ಯಾಕೊಬ ವರಿ ತಿನಾ ಮ್ಹೊಟು ಕುಟುಂಬ ವಿಮೊಚನಕಾಂಡಮಾ ತಾರಿಕತಾ 430 ವರಕ್ಹೊತಿ ಪೈಲಾ ಐಗುಪ್ತನೆ ಗಯಾತಾ, ಕದ್ಯಾಮ ಕಮ್ಮಶಿ ಕಮ್ಮ 1875 ಬಿ.ಸಿ ಇಮ್ಮ ಯೊಸೆಫ ಐಗುಪ್ತನಾ ಇತಿಹಾಸನಾ ವಚ್ಮಾ ಸಾಮ್ರಾಜ್ಯನೆ ವರಿ ಮೊಶೆನು ನವು ಸಾಮ್ರಾಜ್ಯನಾ ಟೈಮೆ ಮಳಲವಾಲಾ ವ್ಹೈ. ಪುಸ್ತಕನು ರಚನೆ 1-15, ಪಸ್ಕ ಸನ್ನನಾ ದಾಖಲಾನಾ ಕ್ಹಾತೆ ದೆಕಾಡಿನ ದಿವಾನಾ ವಿಮೊಚನಕಾಂಡನಾ ಉಪ್ಪರ ಒತ್ತ ದಿದಲ ಛೆ. 15:22, 18:27 ರಾನ ರವಾನು (ಮಾರಾ, ಮಸ್ಸಾ ಮತ್ತು ಮೆರಿಬಾ) 19-24, ಡಿಕಾಲಾಗ್ 20:1-17 ವರಿ ಒಡಂಬಡಿಕೆನು ಪುಸ್ತಕ 20:22, 23:19 24:7. 32-34, ಒಡಂಬಡಿಕೆ ತುಟಾನು ವರಿ ನವಿಕರಣ ಕರಾನು ನವಿಕರಣನಾಹುತಿ ದೆಕಾಡ್ಯಾಸ. 25-31; 35-40 ತಿಮಾ ಸು ಛೆ ಕವಾನಾಹುತಿ ಮುಲಕ ಉಟಿನ ದಿಕ್ಹಸ, ಕದ್ಯಾಮ, ಗುಡಾರನೆ ತಯ್ಯಾರ ಕರಾನೆ ವರಿ ಸಿನಾಯ 25-31 ಮಾ ಕ್ಹುದಾಕಂತೊ ಮೊಶೆ ಲಿದಲ ಆರಾದನೆನಾ ಸುಚನೆನಾ ವರಿ ಗುಡಾರ ಭಾಂದಾನಾ ಕಾಮನೆ ಕಿಮ್ಮ ಕರಾನಾ ಸುಚನೆ 35-40. ಎ ಯಾಜಕಕಾಂಡನಾ ಪುಸ್ತಕಮಾ ಅಗು ಬಡಸ. ಯಾಜಕಕಾಂಡ 8 ವಾ ಅದ್ಯಾಯ ಎಕ್ಸ್ ಮಾ ಕದಲ ಯಾಜಕೊನಾ ದಿಕ್ಷಾನಾ ಕಾಮೊನೆ ದೆಕಾಡಿನ ದಿವಸ. 29 ಕ್ಹುದಾನು ಶಾಸ್ತ್ರ: ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊ ಲಿಂಗತ: ಪಿತೃ ಪ್ರಭುತ್ವ ದೆಕಾಡಾಮಾ ವಿರಶುರೊ ಮನಕ್ಹೊ ಥಯಾತಾ, ತೆನೈಸೊ ಎ ವಿಮೊಚನಕಾಂಡಮಾ ‘ಮನಕ್ಹೊ ದಿಕ್ಹಸ’ (ರೆಂಡ್‌ಟಾರ್ಫ್, 139). ಯಾಕೊಬ ವರಿ ತಿನಾ ಬಚ್ಚಾವೊನಾ ಕುಟುಂಬನಾ ಸತ್ತರ ಜನಾ ಪುರಾ ಜಿಮಿನನೆ ಭರಾನಾ ‘ಇಸ್ರಾಯೆಲೊ ವ್ಹೈ’ ತೆನೈಸೊ ‘ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊ ಥಾವಸ. ವಿಮೊಚನಕಾಂಡ ಪುಸ್ತಕಮಾತಾ ನಿರುಪಣೆನು ಸ್ವರುಪ ಬಿಜು ಥಾವಸ. ಅದ್ಯಾಯ 2 ಮಾ ದಕ್ಹಾ ಉದಾರಣೆನೆ ಛೊಡಿನ ಮನಕ್ಹೊ ಎದರಸಾನಾ ಮನಕ್ಹೊನೆ ಹಮೆ ಸಾಕ್ಷಿಯೊ ನೈ ಥಾತಾ. ತ್ಯುನಾ ಬದಲ ಇಸ್ರಾಯೆಲ ನೈತೊ ಮೊಶೆನಾ ಮನಕ್ಹೊ ಫರೊಹನ ನೈತೊ ಮ್ಹೈನಾ ಮನಕ್ಹೊ ಬಿಜಾ ಎದರ ಥಾವಸ. ಮನಕ್ಹೊ ಶಕ್ಕನೆ ವರಿ ಅಪನಂಬಿಕೆನೆ ವ್ಹಂದ್ಯಾಸ ವರಿ ಮೊಶೆ ತ್ಯುನೊನೆ ಎದರ ಥೌ ಲಾಗ್ಯು. ಇಸ್ರಾಯೆಲೊನಾ ದಬ್ಬಾಳಿಕೆ ಅದ್ಯಾಯ 1 ಮಾ ಪುರಾ ಛೆ ವರಿ ತ್ಯುನು ಬಿಡುಗಡೆ ಅದ್ಯಾಯ 3 ತು ಬಿಜಾ ದೆಕ್ಲಾಡಾನಿ ಕಾಳಜಿ ವ್ಹೈ. 4:31 ವರಿ 14:31 ಮನಕ್ಹೊ ತ್ಯುನಾ ತರಫತಾ ಯಹೊವಾನ ಕಾಮ ಕರಾನಿ ಸುದ್ದಿನೆ ಬರೊಕ್ಹೊ ಕರ‍್ಯಾ. ಇನೆ ದೆಕಾಡಾನೆ ಒತ್ತಿನ ಕದಲ ಛೆ. ಪುಸ್ತಕನು ಉದ್ದೆಶ: "ಐಗುಪ್ತತೊ ಯಾಕೊಬನಾ ಖಾಂದಾನವಾಲಾವೊನಿ ಜಲ್ದಿ ಬೆಳದಾನು ಕ್ಹುದಾನಿ ತಾಕತ ಮನಕ್ಹೊನೆ ಸ್ಥಾಪನೆನೆ ಪತ್ತೊ ಲಗಾಡಾನೆ". ಕ್ಹುದಾ ಇಸ್ರಾಯೆಲೊನೆ ಯಕ್ಕ ಶಾಸನ ದಿದ್ಯೊ, ತ್ಯುನಾಕ್ಹು ಆಳಾನಾ ತಿನಾ ಮನಕ್ಹೊ ನಿಂಗತ ಇಸ್ರಾಯೆಲಮಾ ರ‍್ಹವಾನು ನಿಯಮ (ಧರ್ಮೊ. 4:7-8; ರೊಮ 9:4-5). ತೆ ಕುನ್ನ ವ್ಹೈ ಕವಾನಾಹುತಿ ಯಹೊವಾ ತಿನಾ ಸ್ವಂತ ಮನಕ್ಹೊನೆ ಸುಚನೆ ದಿವಸ: ಸರ್ವಶಕ್ತ, ಮ್ಹೊಟೊ, ಚೊಕೊ, ಪವಿತ್ರ, ಮರ್ಗಾಲೊ, ವರಿ ಹಬಾಳ ವರಿ ಜಿಮಿನನೊ ಯಕ್ಲೊಜ ಸೃಷ್ಟಿಕರ್ತಾ ವ್ಹೈ (ವಿಮೊಚನ. 3; 6; 33; 34). ವಿಮೊಚನಕಾಂಡ ವರಿ ಪಾಚಲ್ತಾ ಥಯಲ ಘಟನಾವೊನೊ ದಾಖಲೊ ಕಿರ್ತನೆ 105:25-45; 106:6-27; ನ್ಯಾಯಸ್ಥಾಪಕ 7:17-44; ಕೊರಿಂಥಿಯಾನ್ಸ್ 10:1-13 ವರಿ ಹಿಬ್ರು ಪುಸ್ತಕ 9:1-6; 11:23-29.</para>
  <chapter number="1" style="c" sid="EXO 1" />
  <para style="s">ಐಗುಪ್ತಮಾ ಇಸ್ರಾಯೆಲೊ ತ್ರಾಸಕ್ಹು ಚಲಾಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 1:1" />ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಐಗುಪ್ತ ದೆಶನೆ ತ್ಯುನಾ ತ್ಯುನಾ ಘರವಾಲಾವೊನಾ ಕ್ಹಾತೆ ಆಯಲ ಇಸ್ರಾಯೆಲನಾ ಗಂಡ ಬಚ್ಚಾ಼ವೊನಾ ನಾಮೊ: <verse eid="EXO 1:1" /><verse number="2" style="v" sid="EXO 1:2" />ರುಬೆನ, ಸಿಮೆಯೊನ, ಲೆವಿ, ವರಿ ಯೆಹುದ, <verse eid="EXO 1:2" /><verse number="3" style="v" sid="EXO 1:3" />ಇಸ್ಸಾಕಾರ, ಜೆಬುಲುನ, ವರಿ ಬೆನ್ಯಾಮಿನ; <verse eid="EXO 1:3" /><verse number="4" style="v" sid="EXO 1:4" />ದಾನ, ಗಾದ, ನಫ್ತಾಲಿ, ವರಿ ಅಶೆರ. <verse eid="EXO 1:4" /><verse number="5" style="v" sid="EXO 1:5" />ಯಾಕೊಬನಾ ಕ್ಹಾರಾ ಸಂತತಿವಾಲಾ ಮಳಿನ ಸತ್ತರ ಜ಼ನಾ, ತೆನೈಸೊ ಯೊಸೆಫ ಪೈಲಾಜ ಐಗುಪ್ತಮಾ ವ್ಹತ್ತೊ. <verse eid="EXO 1:5" /><verse number="6" style="v" sid="EXO 1:6" />ತೆ ಥಯಲ್ಪರ ಯೊಸೆಫ, ತಿನಾ ಭಾಯೊ ಕ್ಹಾರಾ ಜ಼ನಾ ವೈಸ ಥೈನ ಮರ‍್ಯಾ. <verse eid="EXO 1:6" /><verse number="7" style="v" sid="EXO 1:7" />ತೆನೈಸೊ ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾ ಜಾಸ್ತ ಥೈನ, ತಾಕತವರ ಥಯಾ. ತೆ ಐಗುಪ್ತ ದೆಶಮಾ ನಿಸ್ತಾ ತ್ಯುನೆಜ಼ ಭರಿ ಗಯಾ. <verse eid="EXO 1:7" /><verse number="8" style="v" sid="EXO 1:8" />ತೆ ಥಯಲ್ಪರ ಯೊಸೆಫನೆ ವಳಕ ನೈಸೊ ರ‍್ಹಯಲ ಯಕ್ಕ ನವೊ ರಾಜೊ಼ ಐಗುಪ್ತ ದೆಶ ಚ಼ಲಾವಾಡೊತೊ. <verse eid="EXO 1:8" /><verse number="9" style="v" sid="EXO 1:9" />ತೆ ನವೊ ರಾಜೊ಼ ತ್ಯುನಾ ಮನಕ್ಹೊನೆ, "ದೆಕೊ, ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊಜ಼ ಜಾಸ್ತ ಛೆ ವರಿ ತ್ಯುನೆ ಅಪ್ನೊತಿ ತಾಕತವರ ಛೆ.” <verse eid="EXO 1:9" /><verse number="10" style="v" sid="EXO 1:10" />ಅಪನಾ ವಿರೊದ್ದ ಕುನ್ನಬಿ ಯುದ್ದ ಕರಾನೆ ಆಯಾರೆ ತ್ಯುನೆ ಅಪನಾ ದುಶ್ಮನೊನಾ ಕ್ಹಾತೆ ಮಳಿನ ಅಪನಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರಿನ ಅಪ್ನು ದೆಶ ಛೊಡಿನ ಗೈ ಪಡಸ. ತಿನಾಹುತಿ ತ್ಯುನೆ ಅಪ್ನು ದೆಶ ಛೊಡಿನ ಗಯಾ ಬಗರ ಅಪೆ ಸುಬಿ ವಿಚಾರ ಕರು” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 1:10" /><verse number="11" style="v" sid="EXO 1:11" />ತೆಳಾಮಾ ತ್ಯುನೊನೆ ಗುಲಾಮೊ ಕರಲಿನ ತ್ರಾಸ ದಿವಾನೆ ಚಾಲು ಕರ‍್ಯಾ, ವರಿ ತ್ಯುನೊಪರ ಅದಿಕಾರಿಯೊನೆ ಮುಕ್ಯಾ. ತ್ಯುನೆ ಫರೊಹನನಾಹುತಿ ಪಿತೊಮ ವರಿ ರಾಮ್ಸೆಸ ಕವಾನಾ ಸೆವೆ ಕರಾನಾ ಗಾಮೊ ಭಾಂದಾ ಲಗಾಡ್ಯೊ. <verse eid="EXO 1:11" /><verse number="12" style="v" sid="EXO 1:12" />ತೆನೈಸೊ ಐಗುಪ್ತನಾ ಮನಕ್ಹೊ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನೆ ಕೆಕ್ಲು ತ್ರಾಸ ದಿದ್ಯಾತಬಿ ತ್ಯುನೆ ಬಿನಕ್ಕರ ಜಾಸ್ತ ಥಾತಾ ಪುರಾ ದೆಶಮಾ ಫೈಲಾಡಾತಾ, ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊ ಫೈಲಾನು ದೆಕಿನ ಐಗುಪ್ತನಾ ಮನಕ್ಹೊ ಘನ್ನಾ ಬುಚ಼ಕ್ಯಾ. <verse eid="EXO 1:12" /><verse number="13" style="v" sid="EXO 1:13" />ಐಗುಪ್ತನಾ ಮನಕ್ಹೊ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನೆ ಘನ್ನಾ ತ್ರಾಸ ದಿನ ತ್ಯುನೊಕನ ಕಾಮ ಕರೈಲಿದ್ಯಾ. <verse eid="EXO 1:13" /><verse number="14" style="v" sid="EXO 1:14" />ಮಾತಿನಾ ಕಾಮೊಮಾಬಿ, ಇಟಂಗಿ ಕರಾನಾ ಕಾಮೊಮಾಬಿ, ವರಿ ಖೆತರನಾ ಕಾಮೊಮಾಬಿ ತ್ಯುನೊನೆ ತೆ ಕ್ಹಾರಾ ತರಾನಾ ಕಾಮೊ ಕರೈನ ತ್ರಾಸ ದಿನ ತ್ಯುನಿ ಜಿವ್ನಾಜ಼ ಬೆಜಾರ ಕರಿ ಪಡ್ಯಾ. ಐಗುಪ್ತನಾ ಮನಕ್ಹೊ ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊಕ್ಹು ಕರಾವಾನಾ ಕಾಮೊ ಘನ್ನಾ ತ್ರಾಸನಾ ಕಾಮೊ ವ್ಹತ್ತಾ. <verse eid="EXO 1:14" /><verse number="15" style="v" sid="EXO 1:15" />ತೆನೈಸೊ ಐಗುಪ್ತ ದೆಶನೊ ರಾಜೊ಼ ಇಬ್ರಿಯ ಬಾಕ್ಡಿಯೊನೆ ಜ಼ನ್ನಾ ಲಗಾಡಾಲ್ಯೊ ಬೆ ಬಾಕ್ಡಿಯೊನೆ ಮದತ ಕರ‍್ಯೊ. ತೆ "ಶಿಪ್ರಾ” ವರಿ "ಪುಗಾ” ಕವಾನಾ ಬಾಕ್ಡಿಯೊನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="EXO 1:15" /><verse number="16" style="v" sid="EXO 1:16" />ತೆ ತ್ಯುನೊನೆ, "ತುಮೆ ಇಬ್ರಿಯನಾ ಬಾಕ್ಡಿಯೊನೆ ಜ಼ನ್ನಾಡತಾಮಾ ತೆ ಬಚ್ಚು಼ ಪಟ್ಟೊ ರ‍್ಹಯಾರೆ ತುಮೆ ತಿನೆ ಖಲಾಸ ಕರಿಪಡು, ಛೊಕ್ರಿ ರ‍್ಹಯಾರೆ ಜಿವ್ತಾ ರ‍್ಹವಾನೆ ಛೊಡೊ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 1:16" /><verse number="17" style="v" sid="EXO 1:17" />ತೆನೈಸೊ ತೆ ಜನ್ನಾಡಾಲ್ಯೊ ಬಾಕ್ಡಿಯೊ ಕ್ಹುದಾನೆ ಬುಚ್ಕಿ಼ನ ಐಗುಪ್ತನಾ ರಾಜಾ಼ನಿ ವಾತ ಲಿಂಗತ ಕರ‍್ಯಾ ಬಗರ ಪಟ್ಟಾ ಹುಟ್ಯಾರೆ ತ್ಯುನೊನೆ ಖಲಾಸ ಕರ‍್ಯಾ ಬಗರ ರ‍್ಹಯಾ. <verse eid="EXO 1:17" /><verse number="18" style="v" sid="EXO 1:18" />ತೆಳಾಮಾ ಐಗುಪ್ತನೊ ರಾಜೊ಼ ತೆ ಜನ್ನಾಡಾಲ್ಯೊ ಬಾಕ್ಡಿಯೊನೆ ಬಲೈನ, "ತುಮೆ ತ್ಯುನೊನೆ ಪಟ್ಟಾನೊ ಹುಟ್ಯಾರೆ ಕಾ ಖಲಾಸ ಕರ‍್ಯಾ ನೈ? ಕಾ ತುಮೆ ಮಾರಾ ಕ್ಹಾತೆ ಅಮ್ಮ ಕರ‍್ಯಾ? ಕೈನ ಪುಚ್ಯೊ. <verse eid="EXO 1:18" /><verse number="19" style="v" sid="EXO 1:19" />ತೆ ಜನ್ನಾಡಾಲ್ಯೊ ಬಾಕ್ಡಿಯೊ ಫರೊಹನನೆ, "ಇಬ್ರಿಯನಾ ಬಾಕ್ಡಿಯೊ ಐಗುಪ್ತನಾ ಬಾಕ್ಡಿಯೊ ಲಿಂಗತ ನ್ಹವೈ, ತ್ಯುನೆ ಘನ್ನಾ ಚಾಲು ಶೆ ತ್ಯುನೆ ಹಮೆ ಜಾ಼ವಾತಿ ಪೈಲಾಜ ಜ಼ನ್ನಿ ಪಡಾಡಾತಾ” ಕೈನ ಕದ್ಯಾ. <verse eid="EXO 1:19" /><verse number="20" style="v" sid="EXO 1:20" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ತ್ಯುನೊನೆ ಮರ್ಗಾ ದೆಕಾಡ್ಯೊ, ತಿನಾಕ್ಹು ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊ ಜಾಸ್ತ ಥಾತಾ ಗಯಾ ವರಿ ತಾಕತವರ ಥಾತಾ ಗಯಾ. <verse eid="EXO 1:20" /><verse number="21" style="v" sid="EXO 1:21" />ತೆ ಬಾಕ್ಡಿಯೊ ಕ್ಹುದಾನೆ ಬುಚ಼್ಕಲಕ್ಹು ತ್ಯುನು ಘರದಾನಬಿ ಜಾಸ್ತ ಥಯು. ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊ ಜಾಸ್ತ ಥೈನ ತಾಕತವರ ಥಯಾ. <verse eid="EXO 1:21" /><verse number="22" style="v" sid="EXO 1:22" />ತೆ ಥಯಲ್ಪರ ಫರೊಹನ ತ್ಯುನಾ ಮನಕ್ಹೊನೆ, "ಇಬ್ರಿಯನಾ ಹಮ್ನಾ ಹಮ್ನಾ ಹುಟ್ಟಲ ಪಟ್ಟಾವೊನೆ ಲಿನ ನೈಲ ನದಿಮಾ ನಾಕೊ, ತೆನೈಸೊ ಛೊಕ್ರಿಯೊನೆ ಸು ಕರೊ ನಕೊ” ಕೈನ ಆಗನ್ಯಾ ಕರ‍್ಯೊ.<verse eid="EXO 1:22" /></para>
  <chapter eid="EXO 1" />
  <chapter number="2" style="c" sid="EXO 2" />
  <para style="s">ಮೊಶೆನು ಜನನ</para>
  <para style="m">
    <verse number="1" style="v" sid="EXO 2:1" />ತೆ ಥಯಲ್ಪರ ಲೆವಿನೊ ಖಾಂದಾನವಾಲೊ ಯಕ್ಲೊ ಲೆವಿನಾ ಖಾಂದಾನವಾಲಿ ಯಕ್ಕ ಛೊಕ್ರಿನೆ ಹಿವಾ ಕರಲಿದ್ಯೊ. <verse eid="EXO 2:1" /><verse number="2" style="v" sid="EXO 2:2" />ತೆ ಬಾಕ್ಡಿ ಪೆಟೆ ರ‍್ಹೈನ ಯಕ್ಕ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿ. ತೆ ಪಟ್ಟೊ ದೆಕಾನೆ ಚೊ಼ಕೊ ಶೆ ಕೈನ ತಿನೆ ತನ್ನ ಮ್ಹೈನಾ ಝಾಕಿನ ರಾಕಿ. <verse eid="EXO 2:2" /><verse number="3" style="v" sid="EXO 2:3" />ತೆ ತಿನೆ ಜಾಸ್ತಿ ದಿನ್ನ ಝಾಕಾನೆ ನೈಥಾತಾಕ್ಹು ತಿನೆ ಯಕ್ಕ ಟೊಪ್ಲಿ ಲಿನ ತೆ ಟೊಪ್ಲಿಮಾ ಪಾನಿ ಗಯಾ ಬಗರ ತಿನೆ ಡಾಂಬರ ಲಗಾಡಿನ ತೆ ಟೊಪ್ಲಿಮಾ ತೆ ಪಟ್ಟಾನೆ ಕ್ಹುರಾಡಿನ, ನೈಲ ನದಿನಾ ದಂಡಿನಾ ಚಾರಾಪರ ಛೊಡಿ ಪಡಿ. <verse eid="EXO 2:3" /><verse number="4" style="v" sid="EXO 2:4" />ತೆ ಪಟ್ಟಾನೆ ಸುಬಿ ಥಾಸ ಕೈನ ತಿಳ್ದಿಲಿವಾನಾಹುತಿ ತೆ ಪಟ್ಟಾನಿ ಮ್ಹೊಟಿ ಭೆನ ನಕ್ಕರ ದುರ ದೆಕಾನಾಹುತಿ ಹುಬ್ರೈತಿ. <verse eid="EXO 2:4" /><verse number="5" style="v" sid="EXO 2:5" />ತೆಕ್ಲಾಕ್ಹುಜ಼ ಫರೊಹನನಿ ದಿಕ್ರಿ ಅಂಗ ಧವಾನಾಹುತಿ ನೈಲ ನದಿಕನ ಐ. ತಿನಿಯೊ ಸೆವಕಿಯೊ ತೆ ನದಿನಾ ದಂಡಿಕನ ಫರಾಡ್ಯೊತೊ. ತೆ ಟೊಪ್ಲಿನೆ ದೆಕಿನ, ತಿನಿ ಯಕ್ಕ ಸೆವಕಿನೆ ವಳೈನ ತೆ ಟೊಪ್ಲಿ ಮಂಗೈಲಿದಿ. <verse eid="EXO 2:5" /><verse number="6" style="v" sid="EXO 2:6" />ತೆ ಟೊಪ್ಲಿ ಕಾಡಿನ ದೆಕ್ತಾಮಾ, ಆಹಾ! ರವಾನು ಬಚ್ಚು಼. ತಿನೆ ತಿಪರ ಮರ್ಗಾ ಐನ, "ಎ ಇಬ್ರಿಯಮಾನು ಯಕ್ಕ ಬಚ್ಚು಼ ವಸ” ಕೈನ ಕದಿ. <verse eid="EXO 2:6" /><verse number="7" style="v" sid="EXO 2:7" />ಬಚ್ಚಾ಼ನಿ ಭೆನ ಪಾಚಿ ಹುಬರೈತಿ ತೆಳಾಮಾ ಅಗಿ ಐನ ಫರೊಹನನಿ ದಿಕ್ರಿನೆ ತಾರಾಹುತಿ "ಎ ಪಟ್ಟಾನೆ ದುದ್ದ ಪಿಲೈನ ರಾಕಾನಾಹುತಿ ಯಕ್ಕ ದಾದಿನೆ ಮಿ ಬಲೈ ಲೌ ಸು? ಕೈನ ಪುಚ್ಚಿ. <verse eid="EXO 2:7" /><verse number="8" style="v" sid="EXO 2:8" />ಫರೊಹನನಿ ದಿಕ್ರಿ ತಿನೆ, "ಜಾ಼ ಬಲೈಲಿನ ಆ” ಕದಿ. ತೆ ಗೈನ ತೆ ಬಚ್ಚಾ಼ನಿ ಮಾನೆಜ಼ ಬಲೈಲಿನ ಐ. <verse eid="EXO 2:8" /><verse number="9" style="v" sid="EXO 2:9" />ಫರೊಹನನ ದಿಕ್ರಿ ತೆ ಪಟ್ಟಾನಿ ಯಾನೆ, "ತು ಆಂ ಬಚ್ಚಾ಼ನೆ ಲಿನ ಗೈನ ತಿನೆ ದುದ್ದ ಪಿಲೈನ ಮಾರಾಹುತಿ ರಾಕ, ಮಿ ತುನೆ ಪಗಾರ ದ್ಯುಸ” ಕದಿ. ತೆ ಬಾಕ್ಡಿ ತೆ ಬಚ್ಚಾ಼ನೆ ಲಿನ ಗೈನ ರಾಕಿ. <verse eid="EXO 2:9" /><verse number="10" style="v" sid="EXO 2:10" />ತೆ ಪಟ್ಟೊ ಮ್ಹೊಟೊ ಥಾತಾಮಾ, ತಿನೆ ಫರೊಹನನಿ ದಿಕ್ರಿಕನ ಲಿನೈ, ತೆ ತಿನೊ ದಿಕ್ರೊ ಥಯೊ. "ಅನೆ ಪಾನಿಮಾತಿ ಲೈಸ” ಕೈನ ತೆ ಪಟ್ಟಾನೆ "ಮೊಶೆ<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">ಮೊಶೆ ಕದ್ಯಾಮ ಪಾನಿಮಾತೊ ಎಳದಾಯಲವಾಲೊ ವ್ಹೈ.</char></note>” ಕೈನ ನಾಮ ಮ್ಹೆಲಿ.<verse eid="EXO 2:10" /></para>
  <para style="s">ಮೊಶೆ ಮಿದ್ಯಾನನೆ ನ್ಹಾಟಿನ ಗಯಲ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11" />ಮೊಶೆ ಮ್ಹೊಟೊ ಥಯಲ್ಪರ, ತಿನಾ ಸ್ವಂತ ಮನಕ್ಹೊ ಮಳಾನೆ ಗಯೊ. ವರಿ ತ್ಯುನೆ ಕಸ್ಟ ಪಡಿನ ಕಾಮ ಕರಾನು ದೆಕ್ಯೊ. ತೆಳಾಮಾ ಐಗುಪ್ತವಾಲಾವೊಮಾ ತಿನಾ ಸ್ವಂತ ಮನಕ್ಹೊಮಾನೊ ಇಬ್ರಿಯವಾಲಾ ಯಕ್ಲಾನೆ ಖಲಾಸ ಕರಾನು ದೆಕ್ಯೊ. <verse eid="EXO 2:11" /><verse number="12" style="v" sid="EXO 2:12" />ಮೊಶೆ ಹೈಂಬಿ ತಿಬಿ ದೆಕಿನ, ತ್ಯಾ ಕುನ್ನ ನೈ ರ‍್ಹಯಲಕ್ಹು ತೆ ಐಗುಪ್ತವಾಲಾನೆ ಖಲಾಸ ಕರಿನ ತಿನೊ ಮುರ್ದೊ ಉಸುಕಮಾ ಝಾಕಿ ಪಡ್ಯೊ. <verse eid="EXO 2:12" /><verse number="13" style="v" sid="EXO 2:13" />ತಿನಾ ಅಗಲ್ಯಾ ದಿನ್ನೆ ವರಿ ತೆ ತಿನು ಕಾಮ ಕರಾನೆ ಜಾ಼ತಾಕ್ಹು, ಇಬ್ರಿಯನಾ ಬೆ ಜ಼ನಾ ಲಡೈ ಕಾಡಾನು ದೆಕಿನ ತಿಮಾ ತಪ್ಪ ಕರಲವಾಲಾನೆ "ಕಾ ಬಾ ತು ಅಪನಾ ಮನಕ್ಹನೆಜ ಮಾರಾಡೊಸತೊ? ಕೈನ ಪುಚ್ಯೊ. <verse eid="EXO 2:13" /><verse number="14" style="v" sid="EXO 2:14" />ತೆ ಮನಕ್ಹ ತಿನೆ, "ತುನೆ ಹಮಾರಾ ಉಪ್ಪರ ಅದಿಕಾರಿ ವ್ಹೈ ಕೈನ ಹಮಾರೊ ಫೈಸಲೊ ಕರಾನೆ ಕುನ್ನ ಮುಕ್ಯುಸ? ತೆ ಐಗುಪ್ತವಾಲಾನೆ ಮಾರಲ ಲಿಂಗತ ಮನೆಬಿ ಮಾರು ಕೈನ ಛೆ ಸು? ಕದ್ಯೊ. ತೆ ವಾತ ಐಕಿನ ಮೊಶೆ ಬುಚ್ಕಿ಼ನ, "ಮಿ ಕರಲ ಕಾಮ ಕ್ಹಾರಾವೊನೆ ಗ್ವತ್ತ ಥಯುತೊ” ಕೈನ ಕೈಲಿದ್ಯೊ. <verse eid="EXO 2:14" /><verse number="15" style="v" sid="EXO 2:15" />ಥಯಲ ಪುರಾ ಫರೊಹನನೆ ಗ್ವತ್ತ ಥಾತಾಮಾ, ತೆ ಮೊಶೆನೆ ಖಲಾಸ ಕರು ಕೈನ ವಿಚಾರ ಕರಾಡೊತೊ. ತಿನಾಹುತಿ ಮೊಶೆ ಫರೊಹನ ಕಂತೊ ನ್ಹಾಟಿನ ಗೈನ ಮಿದ್ಯಾನ ದೆಶಮಾ ರ‍್ಹಯಲ ಯಕ್ಕ ಇರ ಕನ ಬೈಟ್ಯೊ. <verse eid="EXO 2:15" /><verse number="16" style="v" sid="EXO 2:16" />ಮಿದ್ಯಾನಮಾ ರ‍್ಹಯಲ ಯಾಜಕನೆ ಕ್ಹಾತ ದಿಕ್ರಿಯೊ ವ್ಹತ್ಯೊ. ತ್ಯುನೆ ತ್ಯಾ ಇರಕನ ಐನ ತಿನಾ ಬಾನಾ ಬಕ್ರಾವೊನೆ ಪಾನಿ ಪಿಲಾವೊನಾ ಹುತಿ, ತೆ ಇರಮಾತು ಟಾಕಿಮಾ ಪಾನಿ ಭರಿಲಿವಾಡ್ಯಾತಾ. <verse eid="EXO 2:16" /><verse number="17" style="v" sid="EXO 2:17" />ತೆಕ್ಲಾಮಾಜ ದಕ್ಹಾ ಬಕ್ರಾ ಚ಼ರಾವಾಲಾ ತ್ಯುನೊನೆ ಇರ ಕಂತಾ ನ್ಹಟಾಡತಾ ಟೈಮಮಾ ಮೊಶೆ ಐನ ತ್ಯುನೊನೆ ಮದದ ಕರಿನ ತ್ಯುನಾ ಬಕ್ರಾವೊನೆ ಪಾನಿ ಪಿಲಾಡ್ಯೊ. <verse eid="EXO 2:17" /><verse number="18" style="v" sid="EXO 2:18" />ತೆ ಥಯಲ್ಪರ ತ್ಯುನೊನೆ ತ್ಯುನೊ ಬಾ ಥಯಲ ರೆಗುವೆಲ ಕನ ಆಯಲ್ಪರ ತೆ ತ್ಯುನೊನೆ, "ಕಾ ಆಜ ಘನ್ನಾ ಜಲ್ದಿ ಆಯಾತೊ? ಕೈನ ಪುಚ್ಯೊ. <verse eid="EXO 2:18" /><verse number="19" style="v" sid="EXO 2:19" />ತಿನಾಹುತಿ ತ್ಯುನೆ, "ಐಗುಪ್ತವಾಲೊ ಯಕ್ಕ ಮನಕ್ಹ ಹಮೊನೆ ಬಕ್ರಾ ಚರಾವಾಲಾವೊಕ್ಹು ವಚಾ಼ಡಿನ ಹಮಾರಾಹುತಿ ಇರಮಾತೊ ಪಾನಿ ಭರಿನ ಬಕ್ರಾವೊನೆ ಪಾನಿ ಪಿಲಾಡ್ಯೊ” ಕದ್ಯಾ. <verse eid="EXO 2:19" /><verse number="20" style="v" sid="EXO 2:20" />ತೆಳಾಮಾ ತೆ ತಿನಿ ದಿಕ್ರಿಯೊನೆ, "ತೆ ಕಿಶೆ? ಕಾ ತುಮೆ ತೆ ಮನಕ್ಹನೆ ಛೊಡಿನ ಆಯಾ? ತಿನೆ ಬಲಾವೊ, ತೆ ಅಪನಾ ಕ್ಹಾತೆ ಖೈನಕಾ” ಕದ್ಯೊ. <verse eid="EXO 2:20" /><verse number="21" style="v" sid="EXO 2:21" />ಇಮ್ಮ ಮೊಶೆ ತೆ ಮನಕ್ಹನಾ ಕ್ಹಾತೆ ರ‍್ಹೌ ಕೈನ ವಿಚಾರ ಕರ‍್ಯೊ. ರೆಗುವೆಲ ತಿನಿ ದಿಕ್ರಿ ಥಯಲ ಚಿಪ್ಪೊರಳನೆ ಮೊಶೆನೆ ಹಿವಾ ಕರಿನ ದಿದ್ಯೊ. <verse eid="EXO 2:21" /><verse number="22" style="v" sid="EXO 2:22" />ತೆ ಯಕ್ಕ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿ ಮೊಶೆ ತಿನೆ, "ಬಿಜಾ಼ ದೆಶಮಾ ಮಿ ಆಯೊಸ ಕೈನ ತಿನೆ ಬಚ್ಚಾ "ಗೆರ್ಷೊಮ<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">ಮುಲ ಭಾಷಾಮಾ ಪ್ರವಾಸಿನೆ ಗೆರ್ಷೊಮ ಕವಸ.</char></note>” ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ.<verse eid="EXO 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23" />ಅಮ್ಮ ಘನ್ನಾ ದಿನ ಥಯಲ್ಪರ ಐಗುಪ್ತ ದೆಶನೊ ರಾಜೊ಼ ಮರ‍್ಯೊ. ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊ ತ್ಯುನೆ ಗುಲಾಮ ಥೈನ ಕರಾನಾ ಕಾಮೊನಾ ಹುತಿ ಘನ್ನಾ ರೊತಾ ಗೊಳಾಡಾತಾ. ತ್ಯುನೆ ರವಾನು ಕ್ಹುದಾನೆ ಐಕು ಅಯು. <verse eid="EXO 2:23" /><verse number="24" style="v" sid="EXO 2:24" />ಕ್ಹುದಾ ತ್ಯುನು ಹಲಬಾನು ಐಕಿನ, ತೆ ಅಬ್ರಾಹಮನಾ, ಇಸಾಕನಾ, ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಕರಲ ವಡಂಬಡಿಕೆ ಶೆ ಕರಲಿದ್ಯೊ. <verse eid="EXO 2:24" /><verse number="25" style="v" sid="EXO 2:25" />ಕ್ಹುದಾ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನೆ ದೆಕಿನ ತ್ಯುನೊನೆ ಮರಗ್ಯೊ.<verse eid="EXO 2:25" /></para>
  <chapter eid="EXO 2" />
  <chapter number="3" style="c" sid="EXO 3" />
  <para style="s">ಕ್ಹುದಾ ಮೊಶೆನೆ ಬಲಾಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1" />ಮೊಶೆ ತಿನೊ ಮಾಮೊ ಥಯಲ, ವರಿ ಮಿದ್ಯಾನನೊ ಯಾಜಕ ಥಯಲ ಇತ್ರೊನನಾ ಬಕ್ರಾ ಚರಾತೊ ರ‍್ಹತಾಮಾ ರಾನನಾ ಬಿಜೆಕ್ಕ ಬಜಿ ತೆ ಬಕ್ರಾವೊನೆ ಚರಾತೊ ಚರಾತೊ, ಸಿನಾಯ ಕವಾನಾ ಪವಿತ್ರ ಡೊಂಗರೆ ಆಯೊ. <verse eid="EXO 3:1" /><verse number="2" style="v" sid="EXO 3:2" />ತೆಳಾಮಾ ಕ್ಹುದಾನೊ ದುತ ತಿನೆ ಕಾಟಾನಿ ಕಂಟಿಯೊಮಾ ಲಾಗೆಲ ಆಗ ಲಿಂಗತ ದಿಕ್ಹ್ಯೊ. ಮೊಶೆ ತೆ ಕಾಟಾನಿ ಕಂಟಿಯೊಕನ ದೆಕ್ತಾಮಾ ತೆ ಕಾಟಾನಿ ಕಂಟಿಮಾ ಆಗ ಲಾಗಿತಿ; ತೆನೈಸೊ ತೆ ಕಾಟಾನಿ ಕಂಟಿಯೊ ಬಳಾಡಾ ನ್ಹೊತಾ. <verse eid="EXO 3:2" /><verse number="3" style="v" sid="EXO 3:3" />ತೆಳಾಮಾ ಮೊಶೆ, "ಆಂ ಸು ವ್ಹೈ! ಆಂ ಕಾಟಾನಿ ಕಂಟಿಯೊ ಬಳಾಡಾ ನತ್ತಿತೊ! ಆಂ ಸು ಥಾವಾಡುಸ ಕೈನ ಕ್ಹಾಮೊ ಗೈನ ದೆಕುಸ” ಕೈನ ವಿಚಾರ ಕರ‍್ಯೊ. <verse eid="EXO 3:3" /><verse number="4" style="v" sid="EXO 3:4" />ತೆ ಸು ಥಾವಾಡುಸ ಕೈನ ದೆಕಾನಾ ಹುತಿ ಕ್ಹಾಮೊ ಆವಾಡೊಸ ಕೈನ ಯಹೊವಾ ಕ್ಹುದಾ ದೆಕ್ಯೊ. ತೆಳಾಮಾ ಕ್ಹುದಾ ತೆ ಕಾಟಾನಿ ಕಂಟಿಯೊಮಾತೊ, "ಮೊಶೆ, ಮೊಶೆ” ಕೈನ ತಿನೆ ಬಲಾಯೊ. ತಿನಾಹುತಿ ಮೊಶೆ, "ಹಾಂ ಮಿ ಛೆ” ಕದ್ಯೊ. <verse eid="EXO 3:4" /><verse number="5" style="v" sid="EXO 3:5" />ಕ್ಹುದಾ ತಿನೆ, "ತು ಆಂ ಕಂಟಿಯೊಕನ ಔ ನಕೊ! ತು ಘಾಲ್ಲಿದಲ ಕಾರಮಲಿಯೊ ಕಾಡ, ಕಾಕದ್ಯಾಮ ತು ಹುಬ್ರಯಲ ಜ಼ಗಾ ಪರಿಶುದ್ದ ಜ಼ಗಾ ವ್ಹೈ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 3:5" /><verse number="6" style="v" sid="EXO 3:6" />ತೆನೈಸೊ ಕ್ಹುದಾ ತಿನೆ, "ಮಿ ತಾರೊ ಪಿತೃ ಥಯಲ, ಅಬ್ರಾಹಾಮನೊ ಕ್ಹುದಾ ವ್ಹೈ, ಇಸಾಕನೊ ಕ್ಹುದಾ ವ್ಹೈ, ಯಾಕೊಬನೊ ಕ್ಹುದಾ ವ್ಹೈ” ಕದ್ಯೊ. ಮೊಶೆ ಕ್ಹುದಾನೆ ದೆಕಾನೆ ಬುಚ್ಕಿ಼ನ ತಿನು ಮ್ಹೊಡು ಝಾಕಿ ಲಿದ್ಯೊ. <verse eid="EXO 3:6" /><verse number="7" style="v" sid="EXO 3:7" />ತೆಳಾಮಾ ಯಹೊವಾ ತಿನೆ, "ಐಗುಪ್ತ ದೆಶಮಾ ರ‍್ಹಯಲ ಮಾರಾ ಮನಕ್ಹೊನು ತ್ರಾಸ ಮಿ ದೆಕ್ಯೊಸ, ತ್ಯುನೆ ಗುಲಾಮೊ ಥೈನ ಕರಾನಾ ಕಾಮೊನಾ ಹುತಿ, ಮಕನ ರವಾನು ಮನೆ ಐಕು ಐಯುಸ. ತ್ಯುನು ದುಕ ಮನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="EXO 3:7" /><verse number="8" style="v" sid="EXO 3:8" />ತಿನಾಹುತಿ ತ್ಯುನೊನೆ ಐಗುಪ್ತನಾ ಹತ್ಮಾತೊ ಛೊಡಾವಾನಾ ಹುತಿ ತೆ ದೆಶತೊ ತ್ಯುನೊನೆ ದುದ್ದ ವರಿ ಜೆನ ಹರದಾನಾ ಮ್ಹೊಟಾ ದೆಶನೆ ಕದ್ಯಾಮ ಕಾನಾನ್ಯನಾ, ಹಿತ್ತಿಯನಾ, ಅಮ್ಮೊರಿಯನಾ, ಪೆರೆಜಿಯನಾ, ಹಿವ್ವಿಯನಾ, ಯೆಬುಸಿಯನಾ ಮನಕ್ಹೊ ರ‍್ಹವಾನಾ ದೆಶನೆ ಲಿನ ಜಾ಼ವಾನಾ ಹುತಿ ಉತ್ರಿನ ಆಯೊಸ. <verse eid="EXO 3:8" /><verse number="9" style="v" sid="EXO 3:9" />ಹಮ್ನಾ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನು ಆವಾಜ ಮನೆ ಐಕು ಐಯುಸ. ಐಗುಪ್ತವಾಲಾ ತ್ಯುನೊನೆ ದಿವಾನು ತ್ರಾಸ ಮಿ ದೆಕ್ಯೊಸ. <verse eid="EXO 3:9" /><verse number="10" style="v" sid="EXO 3:10" />ತಿನಾಹುತಿ ತು ಆಂ, ಮಾರಾ ಮನಕ್ಹೊ ಥಯಲ ಇಸ್ರಾಯೆಲವಾಲಾವೊನೆ ಐಗುಪ್ತ ದೆಶತೊ ಭಾರೊ ಲಾವಾನಾ ಹುತಿ ತುನೆ ಫರೊಹನ ರಾಜಾಕನ ವಳೌಸ” ಕದ್ಯೊ. <verse eid="EXO 3:10" /><verse number="11" style="v" sid="EXO 3:11" />ತೆಳಾಮಾ ಮೊಶೆ ಕ್ಹುದಾನೆ, "ಫರೊಹನನಾ ಕ್ಹಾಮೊ ಜಾ಼ವಾನೆ ವರಿ ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊನೆ ಐಗುಪ್ತ ದೆಶತೊ ಲಾವಾನೆ ಮಿ ಕುನ್ನ ವ್ಹೈ? ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 3:11" /><verse number="12" style="v" sid="EXO 3:12" />ತಿನಾಹುತಿ ಕ್ಹುದಾ, "ಮಿ ಕ್ಹರಿಬಿ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹೌಸ. ತು ಮಾರಾ ಮನಕ್ಹೊನೆ ಐಗುಪ್ತ ದೆಶತೊ ಭಾರೊ ಲಾಯಲ್ಪರ ತುಮೆ ಆಂಜ಼ ಡೊಂಗರಪರ ಮನೆ ಆರಾದನಾ ಕರೊಶಿ. ವರಿ ತುನೆ ವಲಾಯಲವಾಲೊ ಮಿಜ಼಼ ವ್ಹೈ ಕೈನ ವಳಕ ಥೈನ ರ‍್ಹವಸ” ಕದ್ಯೊ.<verse eid="EXO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 3:13" />ತಿನಾಹುತಿ ಮೊಶೆ ಕ್ಹುದಾನೆ, "ಮಿ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮೊ ಗೈನ, ‘ತುಮಾರೊ ಪಿತೃನೊ ಕ್ಹುದಾ ಮನೆ ತುಮೊಕನ ವಳಾಯೊಸ’ ಕೈನ ಕತಾಮಾ, ತ್ಯುನೆ ಮನೆ ತಿನು ನಾಮ ಸು ವ್ಹೈ? ಪುಚ್ಚಾರೆ ಮಿ ಸು ಕೌ? ಕದ್ಯೊ. <verse eid="EXO 3:13" /><verse number="14" style="v" sid="EXO 3:14" />ತೆಳಾಮಾ ಕ್ಹುದಾ ಮೊಶೆನೆ, "ರ‍್ಹವಾಲೊಜ಼ ವ್ಹೈ” ಕೈನ ಕದ್ಯೊ. "ವರಿ ತು ಇಸ್ರಾಯೆಲವಾಲಾವೊನೆ, ರ‍್ಹವಾಲೊಜ಼ ಮನೆ ತುಮೊಕನ ವಳಾಯೊಸ ಕೈನ ಕೌ” ಕದ್ಯೊ. <verse eid="EXO 3:14" /><verse number="15" style="v" sid="EXO 3:15" />ಕ್ಹುದಾ ವರಿ ಮೊಶೆನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ, "ತು ಇಸ್ರಾಯೆಲವಾಲಾವೊನೆ, ತುಮಾರಾ ಪಿತೃ ಥಯಲ ಅಬ್ರಹಾಮ, ಇಸಾಕ, ಯಾಕೊಬನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾಜ ಮನೆ ತುಮೊಕನ ವಳಾಯೊಸ” ಕೈನ ಕೌ. ಎ ಕೆಳಾಮಾಬಿ ರ‍್ಹವಾನು ಮಾರು ನಾಮ ವ್ಹೈ. ಎ ತಲತಲಾಂತರನೆಬಿ ಮನೆ ಶೆ ಕರಾನು ನಾಮ ವ್ಹೈ. <verse eid="EXO 3:15" /><verse number="16" style="v" sid="EXO 3:16" />ಕ್ಹುದಾ, ತು ಗೈನ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾರಾ ಶಾನಾವೊನೆ ಮಳೈನ, ತ್ಯುನೊನೆ "ತುಮಾರಾ ಪುರ್ವಜನೊ ಕ್ಹುದಾ ಕದ್ಯಾಮ ಅಬ್ರಹಾಮ, ಇಸಾಕ, ಯಾಕೊಬನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಮನೆ ದರ್ಶನ ದಿನ ತುಮೊಪರ ಮರ್ಗಾ ದೆಕಾಡಿನ ಐಗುಪ್ತ ದೆಶಮಾ ತುಮೆ ಕ್ಹಾದಲ ತ್ರಾಸ ಮಿ ದೆಕ್ಯೊಸ. <verse eid="EXO 3:16" /><verse number="17" style="v" sid="EXO 3:17" />ಐಗುಪ್ತಮಾ ತುಮೆ ರ‍್ಹಯಲ ಕೆಟ್ಟ ಪರಿಸ್ಥಿತಿಮಾತೊ ತುಮೊನೆ ಕಾಡಿನ, ದುದ್ದ ವರಿ ಜೆನ ಹರದಾನು ದೆಶ ಕದ್ಯಾಮ ಕಾನಾನ್ಯನಾ, ಹಿತ್ತಿಯನಾ, ಅಮ್ಮೊರಿಯನಾ, ಪೆರಿಜಿಯನಾ, ಹಿವ್ವಿಯಾನಾ, ಯೆಬುಸಿಯನಾ ರ‍್ಹವಾನಾ ದೆಶನೆ ತುಮೊನೆ ಬಲೈ ಲೌ ಕೈನ ಫೈಸಲೊ ಕರ‍್ಯೊಸ” ಕೈನ ತ್ಯುನೊನೆ ಕೆ.<verse eid="EXO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 3:18" />ತ್ಯುನೆ ತಾರಾ ವಾತನೆ ಐಕಸ. ತು ವರಿ ಇಸ್ರಾಯೆಲನಾ ಶಾನಾ ಐಗುಪ್ತನಾ ರಾಜಾ಼ಕನ ಗೈನ ತಿನೆ, "ಇಬ್ರಿಯನೊ ಕ್ಹುದಾ ಹಮೊನೆ ದರ್ಶನ ದಿದ್ಯೊಸ. ತಿನಾಹುತಿ ಹಮೆ ಉಸಕನಿ ಜಮಿನ್ಪರ ತನ್ನ ದಿನ್ನ ಲಕ್ಕಾ ದುರ ಚಾ಼ಲಿನ ಹಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಯಜ್ಞ ಕರು. ತಿನಾಹುತಿ ತು ಹಮೊನೆ ಜಾ಼ವಾನೆ ದ್ಯು” ಕೈನ ಮಾಂಗಿಲಿವೊ. <verse eid="EXO 3:18" /><verse number="19" style="v" sid="EXO 3:19" />ತೆನೈಸೊ ತೆ ಐಗುಪ್ತನೊ ರಾಜೊ಼ ತುಮೆ ಕೆಕ್ಲಾ ಮಾಂಗಿಲಿದ್ಯಾತಬಿ ನೈ ಛೊಡತೊ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="EXO 3:19" /><verse number="20" style="v" sid="EXO 3:20" />ತಿನಾಹುತಿ ಮಿ ಮಾರೊ ಹತ್ತ ಆಗೊ ಕರಿನ ಐಗುಪ್ತ ದೆಶಮಾ ಅದ್ಬುತ ಕಾಮೊ ಕರಿನ ತ್ಯುನೊನೆ ಘನ್ನಾ ತರಿಕಾಕ್ಹು ತ್ರಾಸ ಕರುಸ. ತೆಳಾಮಾ ತೆ ರಾಜೊ಼ ತುಮೊನೆ ವಳಾವಸ. <verse eid="EXO 3:20" /><verse number="21" style="v" sid="EXO 3:21" />ತೆನೈಸೊ ಮಾರಾ ಮನಕ್ಹೊಪರ ಐಗುಪ್ತ ದೆಶವಾಲಾ ಮರ್ಗೆ ನಿಂಗತ ಕರುಸ. ತಿನಾಹುತಿ ತುಮೆ ಜಾತಾಮಾ ಕ್ಹಾಲಿ ಹತೆ ಜಾತಾ ನೈ. <verse eid="EXO 3:21" /><verse number="22" style="v" sid="EXO 3:22" />ತುಮೊಮಾನಿ ಹರಯಕ್ಕ ಬಾಕ್ಡಿ ತಿನಾ ಆಜ಼ು಼ ಬಾಜು಼ವಾಲಿಯೊ ಬಾಕ್ಡಿಯೊ ಕಂತಿ, ತುಮಾರಾ ಘರೊಮಾ ರ‍್ಹವಾನೆ ಆಯಲವಾಲಾ ಬಾಕ್ಡಿಯೊ ಕಂತಿ ರುಪ್ಪು ಖೊನು ಘಾಲ್ಯಾನು ಸಾಮಾನ, ವಣ್ಣಾ ಮಾಂಗಿಲಿವಾದೆ. ತುಮೆ ತೆ ತುಮಾರಾ ಹೆಣ್ಣ ಗಂಡ ಬಚ್ಚಾವೊನೆ ಘಾಲೊ. ಅಮ್ಮ ತುಮೆ ಐಗುಪ್ತವಾಲಾವೊಕನು ಸಂಪತ್ತ ಪುರಾ ಲಾಯಲ ಲಿಂಗತ ಥಾವಸ” ಕದ್ಯೊ.<verse eid="EXO 3:22" /></para>
  <chapter eid="EXO 3" />
  <chapter number="4" style="c" sid="EXO 4" />
  <para style="s">ಕ್ಹುದಾ ಮೊಶೆನೆ ದಿದಲ ಅದ್ಬುತನಿ ತಾಕತ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1" />ತೆ ವಾತೆ ಮೊಶೆ ಯಹೊವಾನೆ, "ತ್ಯುನೆ ಮಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲ್ಯಾ ಬಗರ, ಮಾರಿ ವಾತ ಐಕ್ಯಾ ಬಗರ, ಯಹೊವಾ ತುನೆ ದಿಕ್ಹ್ಯೊಜ಼ ನತ್ತಿ ಕೈನ ಕದ್ಯಾಮ ಮಿ ಸು ಕರು? ಕದ್ಯೊ. <verse eid="EXO 4:1" /><verse number="2" style="v" sid="EXO 4:2" />ತೆ ವಾತೆ ಯಹೊವಾ ತಿನೆ, "ತಾರಾ ಹತ್ಮಾ ಸು ಶೆ? ಕೈನ ಪುಚ್ಯೊ. ತೆ, "ಆಂ, ಲಾಕ್ಡಿ ವ್ಹೈ” ಕದ್ಯೊ. <verse eid="EXO 4:2" /><verse number="3" style="v" sid="EXO 4:3" />ಯಹೊವಾ ತಿನೆ, "ತೆ ಹೆಟೊ ಜಿಮಿನ್ಪರ ಭಿರ್ಕಾ” ಕದ್ಯೊ. ತೆ ಲಾಡ್ಕಿ ಜಿಮಿನ್ಪರ ನಾಕಲ ಬರಬ್ಬರ ತೆ ಕ್ಹಾಪ ಥೈ ಗೈ! ಮೊಶೆ ತಿನೆ ದೆಕಿನ ಬುಚ್ಕಿ಼ನ ನ್ಹಾಟಿನ ಗೈ ಪಡ್ಯೊ. <verse eid="EXO 4:3" /><verse number="4" style="v" sid="EXO 4:4" />ಯಹೊವಾ ಮೊಶೆನೆ, "ತು ಹತ್ತ ಆಗೊ ಕರಿನ ತಿನಿ ಪಿಚ್ಡಿ ಧರ” ಕದ್ಯೊ. ತೆ ತಿನಿ ಪಿಚ್ಡಿ ಧರೆಲ ಬರಬ್ಬರ ತೆ ವರಿ ಲಾಕ್ಡಿ ಥೈ. <verse eid="EXO 4:4" /><verse number="5" style="v" sid="EXO 4:5" />ತೆಳಾಮಾ ಯಹೊವಾ ತಿನೆ, "ಅನಾಹುತಿ ತ್ಯುನೆ ತ್ಯುನಾ ಪುರ್ವಜೊ ಥಯಲ ಅಬ್ರಹಾಮ, ಇಸಾಕ, ಯಾಕೊಬನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ, ತುನೆ ದಿಕ್ಹಲ ಕ್ಹರಿ ವ್ಹೈ ಕೈನ ಬರೊಕ್ಹೊ ಕರಸ” ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 4:6" />ಯಹೊವಾ ವರಿ ತಿನೆ, "ತಾರೊ ಹತ್ತ ಅಂಗ್ಡಾನಾ ಮ್ಹೈ ಘಾಲಿನ ಛಾತಿಪರ ಮ್ಹೆಲ್ಲೆ” ಕದ್ಯೊ. ತೆ ತಿನಾ ಲಿಂಗತಜ಼ ಮ್ಹೆಲ್ಲಿದ್ಯೊ ತಿನೊ ಹತ್ತ ಧೊಳಿ ಸುರ್ಮಿ ಲಿಂಗತ ಥೈನ ಬರಪ ಲಿಂಗತ ಧೊಳೊ ಥಯೊ. <verse eid="EXO 4:6" /><verse number="7" style="v" sid="EXO 4:7" />ಯಹೊವಾ ತಿನೆ, ತು ತಾರೊ ಹತ್ತ ವರಿ ಅಂಗ್ಡಾನಾ ಮ್ಹೈ ಘಾಲಿನ ಛಾತಿಪರ ಮ್ಹೆಲ್ಲೆ ಕದ್ಯೊ. ತೆ ವರಿ ತಿನಾ ಲಿಂಗತಜ಼ ಕರ‍್ಯೊ ಕರತಾಮಾ ಪೈಲಾ ಕಿಮ ವ್ಹತ್ತೊ ತಿನೊ ಹತ್ತ ತಿನಾ ಲಿಂಗತ ಥಯೊ. <verse eid="EXO 4:7" /><verse number="8" style="v" sid="EXO 4:8" />ತೆಳಾಮಾ ಯಹೊವಾ ತಿನೆ, "ತ್ಯುನೆ ತುಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲ್ಯಾ ಬಗರ, ಪೈಲಾ ತು ಕರಲ ಕಾಮನೆ ಇನ್ಕಾರ‍್ಯಾ ತಬಿ, ಬೆವಾ ಸಲಾ ಕರಲ ಕಾಮನೆ ದೆಕಿನ ತುಪರ ಬರೊಕ್ಹೊ ಕರಸ. <verse eid="EXO 4:8" /><verse number="9" style="v" sid="EXO 4:9" />ತೆ ಭಂಬಿ ಕಾಮೊ ದೆಕಿನಬಿ, "ತ್ಯುನೆ ತುಪರ ಬರೊಕ್ಹೊ ನೈ ಮ್ಹೆಲ್ಯಾರೆ, ತಾರಿ ವಾತೊ ನೈ ಐಕ್ಯಾರೆ, ತು ನೈಲ ನದಿನು ಪಾನಿ ಲಿನ ಕುಕ್ಹಿ ಜಿಮಿನ್ಪರ ರಿಚೌ. ತೆಳಾಮಾ ತೆ ಕುಕ್ಹಿ ಜಿಮಿನ್ಪರ ರಿಚಾಯಲ ಪಾನಿ ರಗತ ಥಾವಸ” ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10" />ತೆಳಾಮಾ ಮೊಶೆ ಯಹೊವಾನೆ, "ಕರ್ತಾ, ಮನೆ ವಳೌ ನಕೊ. ಮಿ ಕೆಳಾಮಾಬಿ ಚೊಕಿ ತರಾ ಬೊಲಾಲೊ ನ್ಹವ್ಹೈ, ತು ಮಾರಾ ಕ್ಹಾತೆ ಬೊಲ್ತಾಮಾತೊಬಿ ತಿಮ್ಮಜ ಛೆ. ಮಿ ತೊದಲುಸ ವರಿ ಹಲ್ಲು ಶೆ. ಕಿನೆಬಿ ಬೊಲಾನೆ ಮಿ ಪಾಚೊ ಸರ್ಕುಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 4:10" /><verse number="11" style="v" sid="EXO 4:11" />ತೆ ವಾತೆ ಯಹೊವಾ ತಿನೆ, "ಮನಕ್ಹೊನೆ ಬೊಲಾನೆ ಮ್ಹೊಡು ದಿದಲವಾಲು ಕುನ್ನ ವ್ಹೈ? ಯಕ್ಲಾನೆ ಮುಕೊ ,ಯಕ್ಲಾನೆ ಕಿವಡೊ, ಯಕ್ಲಾನೆ ಡೊಳಾ ವರಿ ಯಕ್ಲಾನೆ ಕುಡ್ಡೊ ಕರಲವಾಲು ಕುನ್ನ ವ್ಹೈ? ಯಹೊವಾ ಥಯಲವಾಲೊ ಮಿಜ಼಼ ನ್ಹವ್ಹೈ ಸು? <verse eid="EXO 4:11" /><verse number="12" style="v" sid="EXO 4:12" />ತಿನಾಹುತಿ ತು ಹಮ್ನಾಜ ಜಾ಼, ಮಿ ತುನೆ ಬೊಲಾನೆ ಮದದ ಕರುಸ, ವರಿ ತು ಸು ಬೊಲು ಕೈನ ಮಿ ತುನೆ ಕೌಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 4:12" /><verse number="13" style="v" sid="EXO 4:13" />ತೆ ವಾತೆ ಮೊಶೆ, "ಕರ್ತಾ, ಮಪರ ದಯಾ ಕರಿನ ಬಿಜೆಕ್ಲಾನೆ ವಳಾ” ಕದ್ಯೊ. <verse eid="EXO 4:13" /><verse number="14" style="v" sid="EXO 4:14" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆಪರ ರೆಕ್ಹ ಥೈನ ತಿನೆ, "ಲೆವಿನೊ ಆರೊನ ತಾರೊ ಭೈ ವ್ಹೈ ನೈ? ತಿನೆ ಸಿದಾ ಬೊಲಾನೆ ಆವಸ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. ತೆಜ಼಼ ತುನೆ ಮಳಾನೆ ಆವಸ. ತುನೆ ಮಳತಾಮಾ ತೆ ತಿನಾ ಮನಸಮಾಜ ಕುಶಿ ಥಾವಸ. <verse eid="EXO 4:14" /><verse number="15" style="v" sid="EXO 4:15" />ತು ತಿನಾ ಕ್ಹಾತೆ ಬೊಲಿನ ಕವಾನಾ ವಿಶಯ ತಿಳ್ಸಾ. ಮಿ ತುನೆಬಿ ವರಿ ತಿನೆಬಿ ಸು ಬೊಲು ಕೈನ ಮದದ ಕರುಸ. ವರಿ ತು ಸು ಕರು ಕವಾನು ಕೈನ ದ್ಯುಸ. <verse eid="EXO 4:15" /><verse number="16" style="v" sid="EXO 4:16" />ತೆ ತಾರಾ ಬದಲ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಸ. ತೆ ತುನೆ ಬೊಲಾನಿ ಜಿಬ್ಬ ರ‍್ಹಯಲ ಲಿಂಗತ ರ‍್ಹವಸ. ತು ತಿನೆ ಕ್ಹುದಾನಾ ಲಿಂಗತ ರ‍್ಹಶಿ. <verse eid="EXO 4:16" /><verse number="17" style="v" sid="EXO 4:17" />ತೆನೈಸೊ ಆಂ ಲಾಕ್ಡಿ ತಾರಾ ಕ್ಹಾತೆ ಲಿನ ಜಾ಼. ಅನಾಕ್ಹುಜ಼ ತು ಅದ್ಬುತ ಕಾಮೊ ಕರಶಿ” ಕದ್ಯೊ.<verse eid="EXO 4:17" /></para>
  <para style="s">ಮೊಶೆ ಐಗುಪ್ತ ದೆಶನೆ ಫರಿನ ಆಯಲ</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18" />ತೆಳಾಮಾ ಮೊಶೆ ತಿನೊ ಮಾಮೊ ಥಯಲ ಇತ್ರೊನಕನ ಐನ ತಿನೆ, "ಮಿ ಐಗುಪ್ತ ದೆಶಮಾ ರ‍್ಹಯಲ ಮಾರಾ ಭಾಯೊಕನ ಗೈನ ತ್ಯುನೆ ಜಿವ್ತಾ ಶೆ ಸು ನೈ ಕೈನ ದೆಕುಸ” ಕದ್ಯೊ. ಇತ್ರೊನ ಮೊಶೆನೆ, "ತು ಅರಾಮ ಗೈನ ಆ” ಕದ್ಯೊ. <verse eid="EXO 4:18" /><verse number="19" style="v" sid="EXO 4:19" />ಯಹೊವಾ ಮಿದ್ಯಾನಮಾ ಮೊಶೆನೆ, ತು ಐಗುಪ್ತ ದೆಶನೆ ಫರಿನ ಜಾ಼. ತುನೆ ಖಲಾಸ ಕರಾನೆ ದೆಕಲವಾಲಾ ಮರಿಗಯಾಸ ಕದ್ಯೊ. <verse eid="EXO 4:19" /><verse number="20" style="v" sid="EXO 4:20" />ಮೊಶೆ ತಿನಾ ಬಾಕ್ಡಿ ಬಚ್ಚಾ಼ವೊನೆ ಗದ್ಡಾಪರ ಬೈಟಾಡಿನ ತ್ಯುನೊನೆ ಬಲೈಲಿನ ತಿನಾ ಕ್ಹಾತೆ ತೆ ಕ್ಹುದಾ ಕದಲ ಲಾಕ್ಡಿಬಿ ಲಿನ ಐಗುಪ್ತ ದೆಶೆ ಗಯೊ. <verse eid="EXO 4:20" /><verse number="21" style="v" sid="EXO 4:21" />ಯಹೊವಾ ಮೊಶೆನೆ ಅಮ್ಮ ಕದ್ಯೊ, "ತು ಐಗುಪ್ತ ದೆಶನೆ ಫರಿನ ಆತಾಮಾ ಮಿ ತಾರಾ ಹತೆ ಕರಲ ಅದ್ಬುತ ಕಾಮೊ ತು ಫರೊಹನನಾ ಕ್ಹಾಮೊ ಕರು. ತು ತೆಕ್ಲು ಕ್ಹಾರು ಕರಿತಬಿ ಮಿ ತಿನು ಮನಸ ಮಂಡ ಕರುಸ. ತಿನಾಹುತಿ ತೆ ಮನಕ್ಹೊನೆ ಜಾ಼ವಾನೆ ದೆತೊ ನೈ. <verse eid="EXO 4:21" /><verse number="22" style="v" sid="EXO 4:22" />ತೆಳಾಮಾ ತು ಫರೊಹನನೆ, ‘ಇಸ್ರಾಯೆಲ ಮಾರೊ ಪೈಲಾರ ದಿಕ್ರೊ ವ್ಹೈ. <verse eid="EXO 4:22" /><verse number="23" style="v" sid="EXO 4:23" />ವರಿ ತು ಮಾರಾ ದಿಕ್ರಾನೆ ತಾರಾ ದೆಶತೊ ವಳೈನ ಮನೆ ಆರಾಧನಾ ಕರಾನೆ ತಿನೆ ಇಜಾಜ಼ತ ದ್ಯು. ತು ಮಾರಿ ವಾತ ನೈ ಐಕ್ಯೊ ಕದ್ಯಾಮ, ಮಿ ತುನೆ ರ‍್ಹಯಲ ಪೈಲಾರ ದಿಕ್ರಾನೆ ಮಾರಿ ಪಡುಸ ಕೈನ ಯಹೊವಾ ಕವಾಡೊಸ” ಕೈನ ತಿನೆ ತಿಳಸೌ. <verse eid="EXO 4:23" /><verse number="24" style="v" sid="EXO 4:24" />ತೆನೈಸೊ ಮೊಶೆ ವಾಟ್ಮಾ ಜಾ಼ತಾಮಾ, ಝುಪ್ಡಾಮಾ ರ‍್ಹತಾಮಾ ಯಹೊವಾ ತಿನಾ ಕ್ಹಾಮೊ ಐನ ತಿನು ಜ಼ಲಮ ಕಾಡಿಪಡು ಕೈನ ವ್ಹತ್ತೊ. <verse eid="EXO 4:24" /><verse number="25" style="v" sid="EXO 4:25" />ತಿಮ್ಮ ರ‍್ಹತಾಮಾ ಚಿಪ್ಪೊರಳ ಯಕ್ಕ ಚುಪ ದಗ್ಡೊಲಿನ ತಿನಾ ದಿಕ್ರಾನೆ ಖತ್ನಾ ಕರಿನ ಮೊಶೆನಾ ಪಗೊನೆ ಮುಟ್ಟಾ ಲಾಗಾಡಿ. ತೆ ಥಯಲ್ಪರ "ತು ಮಾರೊ ರಗತಕ್ಹು ಮಾಟಿ ವ್ಹೈ” ಕದಿ. <verse eid="EXO 4:25" /><verse number="26" style="v" sid="EXO 4:26" />ತೆಳಾಮಾ ಯಹೊವಾ ತಿನೆ ಮಾರ‍್ಯೊ ನೈ. ತೆಳಾಮಾ ತೆ, "ಖತ್ನಾ ಕರಲಹುತಿ ತು ಮಾರೊ ರಗತಕ್ಹು ಮಾಟಿ ವ್ಹೈ” ಕೈನ ಕದಿ. <verse eid="EXO 4:26" /><verse number="27" style="v" sid="EXO 4:27" />ತೆನೈಸೊ ಯಹೊವಾ ಆರೊನನೆ, "ತು ಮೊಶೆನೆ ಮಳಾನೆ ಉಸುಕನಿ ಜಿಮಿನ್ಪರ ಜಾ಼” ಕದ್ಯೊ. ತೆ ಗೈನ ಕ್ಹುದಾನಾ ಡೊಂಗರಮಾ ತಿನೆ ಮಳಿನ ಗಳೆ ಲಗಾಳಿನ ಮಟ್ಟಿ ದಿದ್ಯೊ. <verse eid="EXO 4:27" /><verse number="28" style="v" sid="EXO 4:28" />ತೆಳಾಮಾ ಮೊಶೆ ಆರೊನನೆ, ತಿನೆ ವಳಾಯಲ ಯಹೊವಾನಾ ಕ್ಹಾರಾ ವಾತೊ, ತಿನೆ ಕದಲ ಅದ್ಬುತ ಕಾಮೊ, ತೆ ಕರಲ ಪುರಾ ಆರೊನನೆ ತಿಳಸಾಯೊ. <verse eid="EXO 4:28" /><verse number="29" style="v" sid="EXO 4:29" />ತೆ ಥಯಲ್ಪರ ಮೊಶೆ ವರಿ ಆರೊನಾ ಗೈನ ಕ್ಹಾರಾ ಇಸ್ರಾಯೆಲೊನಾ ಶಾನಾವೊನೆ ಮಳಾಯಾ. <verse eid="EXO 4:29" /><verse number="30" style="v" sid="EXO 4:30" />ಯಹೊವಾ ಮೊಶೆನೆ ಕದಲ ಕ್ಹಾರಾ ವಾತೊ ಆರೊನ ತ್ಯುನೊನೆ ತಿಳಸಿನ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮೊ ಅದ್ಬುತ ಕಾಮ ಕರ‍್ಯೊ. <verse eid="EXO 4:30" /><verse number="31" style="v" sid="EXO 4:31" />ಮನಕ್ಹೊ ತೆ ವಾತೊಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲ್ಯಾ. ಯಹೊವಾ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊಪರ ಮರಗಿನ ತ್ಯುನಿ ಕೆಟ್ಟ ಪರಿಸ್ಥಿತಿ ದೆಕ್ಯೊಸ ವರಿ ತ್ಯುನೊನೆ ಛೊಡಾವಸ ಕೈನ, ಐಕ್ತಾಮಾ ಮಾತಾ ಹೆಟಾ ಕರಿನ ತಿನೆ ಆರಾಧನಾ ಕರ‍್ಯಾ.<verse eid="EXO 4:31" /></para>
  <chapter eid="EXO 4" />
  <chapter number="5" style="c" sid="EXO 5" />
  <para style="s">ಐಗುಪ್ತನಾ ರಾಜಾ಼ಕನ ಮೊಶೆ ವರಿ ಆರೊನ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1" />ತೆ ಥಯಲ್ಪರ ಮೊಶೆ ವರಿ ಆರೊನ ಫರೊಹನ ರಾಜಾ ಕನ ಗೈನ, "ಇಸ್ರಾಯೆಲನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ, ಮಾರಾ ಮನಕ್ಹೊ ಮಾರಾಹುತಿ ರಾನಮಾ ಮರ್ಯಾದಿ ದಿವಾನೆ ಜ಼ತ್ರಾ ಕರು ಕೈನ ತ್ಯುನೊನೆ ಅಪ್ಪಣೆ ದ್ಯು ಕೈನ ಕದ್ಯೊಸ” ಕದ್ಯಾ. <verse eid="EXO 5:1" /><verse number="2" style="v" sid="EXO 5:2" />ತಿನಾಹುತಿ ಫರೊಹನ, ಯಹೊವಾ ಕವಾಲೊ ಕುನ್ನ ವ್ಹೈ? ಮಿ ತಿನಿ ವಾತ ಐಕಿನ ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊನೆ ಜಾ಼ವಾನೆ ದ್ಯು ಸು? ಯಹೊವಾ ಕುನ್ನ ವ್ಹೈ ಕೈನ ಮನೆ ಗ್ವತ್ತ ನತ್ತಿ. ಅಕ್ಲುಜ಼ ನೈಸೊ, ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊನೆ ಮಿ ಜಾ಼ವಾನೆ ದೆತೊಜ಼ ನೈ” ಕದ್ಯೊ. <verse eid="EXO 5:2" /><verse number="3" style="v" sid="EXO 5:3" />ತೆಳಮಾ ತ್ಯುನೆ, "ಇಬ್ರಿಯವಾಲಾವೊನೊ ಕ್ಹುದಾ ಹಮೊನೆ ದಿಕ್ಹ್ಯೊ. ತು ಇಜಾಜ಼ತ ದಿದ್ಯಾರೆ ಹಮೆ ಉಸುಕನಿ ಜಿಮಿನ್ಪರ ತನ್ನ ದಿನ್ನ ಲಕ್ಕಾ ದುರ ಚಾ಼ಲಿನ, ಹಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ಹುತಿ ಯಜ್ಞ ಕರಿನ ಐಯೆಸ. ತಿಮ್ಮ ಹಮೆ ನೈ ಕರ‍್ಯಾರೆ ತೆ ಹಮೊನೆ ರೊಗೊಕ್ಹು ವರಿ ತಲವಾರಕ್ಹು ಖಲಾಸ ಕರಿಪಡಸ” ಕೈನ ಕದ್ಯಾ. <verse eid="EXO 5:3" /><verse number="4" style="v" sid="EXO 5:4" />ಐಗುಪ್ತನೊ ರಾಜೊ಼ ತ್ಯುನೊನೆ, "ಮೊಶೆ ವರಿ ಆರೊನ, "ಆಂ ಮನಕ್ಹೊ ತ್ಯುನು ಕಾಮ ನೈ ಕರು ಕೈನ ತುಮೆ ಕಾ ಅಡ್ಡ ಆವಾಡಾಸ? ತುಮೆ ಗುಲಾಮೊ ಕರಾನಾ ಕಾಮೆ ಜಾ಼ವೊ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 5:4" /><verse number="5" style="v" sid="EXO 5:5" />ತೆನೈಸೊ ಫರೊಹನ, "ಇಬ್ರಿಯವಾಲಾ ದೆಶಮಾ ಘನ್ನಾ ಶೆ. ತ್ಯುನೆ ಗುಲಾಮ ಥೈನ ಕರಾನಾ ಕಾಮೊ ಕಾ ಹುಬ್ರಾಡಾಡಾಸ? ಕದ್ಯೊ. <verse eid="EXO 5:5" /><verse number="6" style="v" sid="EXO 5:6" />ತೆಜ಼಼ ದಿನ್ನ ತೆ ಫರೊಹನ ಕಾಮೊ ಕರೈಲಿವಾಲಾವೊನೆಬಿ ವರಿ ತ್ಯುನಾ ಅದಿಕಾರಿಯೊನೆ ಬಲೈನ ಆಗನ್ಯಾ ದಿನ, <verse eid="EXO 5:6" /><verse number="7" style="v" sid="EXO 5:7" />"ಆಜ಼ತಾ ತುಮೆ ತೆ ಮನಕ್ಹೊನೆ ಇಟಂಗಿ ಕರಾನೆ ಚಾರೊ ದಿವೊ ನಕೊ. ತ್ಯುನೆಜ಼ ಚಾರೊ ಲೈನಕಾ, <verse eid="EXO 5:7" /><verse number="8" style="v" sid="EXO 5:8" />ತೆನೈಸೊ ತ್ಯುನೊನೆ ಆಜ಼ ಲಕ್ಕಾ ಕರಲ ಹಿಸಾಬ ಯಕ್ಲಾಜ ಇಟಂಗಿಯೊ ರ‍್ಹೌ, ಸುಜ಼ ಕಮ್ಮ ಥೌ ನೈ. ತ್ಯುನೆ ಅಂಗ ರಾಕಾಲಾ ವ್ಹೈ ತಿನಾಹುತಿ ತ್ಯುನೆ, "ಹಮೆ ಗೈನ ಹಮಾರಾ ಕ್ಹುದಾನೆ ಯಜ್ಞ ಕರಿನ ಆವಾನೆ ಇಜಾಜ಼ತ ದೆ” ಕೈನ ಮಾಂಗಿಲಿವಾಡಾಸ. <verse eid="EXO 5:8" /><verse number="9" style="v" sid="EXO 5:9" />ತುಮೆ ಆಂ ಮನಕ್ಹೊನಾ ಫಾಲತು ವಾತೊಪರ ಧ್ಯಾನ ದ್ಯು ನೈ ಕೈನ ತುಮೆ ಅವ್ನೊಕನ ಜಾಸ್ತ ಕಾಮ ಕರಲಿವೊ. ತ್ಯುನೆ ಹಜು ರಾಬಾದೆ” ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 5:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="EXO 5:10" />ತೆಳಾಮಾ ಕಾಮೊ ಕರೈಲಿವಾಲಾ ವರಿ ಅದಿಕಾರಿಯೊ ತ್ಯಾಂತಾ ಭಾರಾ ಗೈನ ತೆ ಮನಕ್ಹೊನೆ, "ತುಮೊನೆ ಚಾರೊ ದ್ಯು ನೈ ಕೈನ” ಫರೊಹನ ಹಮೊನೆ ಕದ್ಯೊಸ. <verse eid="EXO 5:10" /><verse number="11" style="v" sid="EXO 5:11" />"ತುಮೊನೆ ಚಾರೊ ಕಿ ಮಳಸ ತ್ಯಾಜ ಗೈನ ಲಿವೊ. ತೆನೈಸೊ ತುಮಾರು ಕಾಮ ನಕ್ಕರಬಿ ಕಮ್ಮ ಥೌ ನೈ” ಕೈನ ಕದ್ಯಾ. <verse eid="EXO 5:11" /><verse number="12" style="v" sid="EXO 5:12" />ತಿನಾಹುತಿ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಚಾರೊ ಲಾವಾನಾ ಹುತಿ ಐಗುಪ್ತ ದೆಶಮಾ ಚಾರೊ ಕಿ ಮಲಸ ಕೈನ ಹುಡಕಾನೆ ಫೈಲಿ ಗಯಾ. <verse eid="EXO 5:12" /><verse number="13" style="v" sid="EXO 5:13" />ತೆನೈಸೊ ಕಾಮ ಕರೈಲಿವಾಲಾ, "ತುಮೆ ಚಾರೊ ರ‍್ಹತಾಮಾ ಕಿಮ ಕಾಮ ಕರತಾತಾ ತಿಮ್ಮಜ಼ ಹಮ್ನಾಬಿ ಕಾಮ ಕರು ತೆ ದಿನ್ನನು ಕಾಮ ತೆಜ಼ ದಿನ್ನೆ ಕ್ಹರೌ” ಕೈನ ತ್ಯುನೊನೆ ಜಲ್ದಿ ಜಲ್ದಿ ಕಾಮ ಕರೊ ಕೈನ ಕದ್ಯಾ. <verse eid="EXO 5:13" /><verse number="14" style="v" sid="EXO 5:14" />ಫರೊಹನನಾ ಅದಿಕಾರಿಯೊ ತ್ಯುನೆ ಕರಲ ಇಸ್ರಾಯೆಲನಾ ಮೆಲ್ವಿಚಾರಕರೊನೆ, "ತುಮೆ ಪೈಲಾ ಕಿಮ್ಮ ಇಟಂಗಿಯೊನಾ ಲೆಕ್ಕೊ ದೆತಾತಾ ಕಾಲ ವರಿ ಹಮ್ನಾ ಕಾ ಸಿದಾ ದಿವಾಡಾ ನತ್ತಿ? ಕೈನ ಪುಚ್ಚಿನ ತ್ಯುನೊನೆ ಮಾರತಾತಾ. <verse eid="EXO 5:14" /><verse number="15" style="v" sid="EXO 5:15" />ತಿನಾಹುತಿ ಇಸ್ರಾಯೆಲನಾ ಮೆಲ್ವಿಚಾರಕರೊ ಫರೊಹನ ಕನ ಗೈನ, "ತು ತಾರಾ ಆಳೊನೆ ಅಮ್ಮ ಕಾ ಕರಶಿ? <verse eid="EXO 5:15" /><verse number="16" style="v" sid="EXO 5:16" />ತಾರಾ ಗುಲಾಮೊನೆ, ತು ತ್ಯುನೊಪರ ಮ್ಹೆಲಲ ಅದಿಕಾರಿಯೊ ಚಾರೊ ದಿದ್ಯಾ ಬಗರಜ "ಇಟಂಗಿಯೊ ಕರೊ!” ಕೈನ ಕತಾ ಹಮೊನೆ ಮಾರಾಡಾಸ. ಅಮ್ಮ ತಾರಾ ಮನಕ್ಹೊ ಕರಾನು ಪಾಪನು ಕಾಮ ವ್ಹೈ” ಕೈನ ಕದ್ಯಾ. <verse eid="EXO 5:16" /><verse number="17" style="v" sid="EXO 5:17" />ತೆಳಾಮಾ ರಾಜೊ, "ತುಮೆ ಅಂಗ ರಾಕಾಲಾ ವ್ಹೈ, ತಿನಾಹುತಿಜ಼, ‘ತುಮೆ ಗೈನ ಹಮಾರಾ ಕ್ಹುದಾ ಯಹೊವಾನೆ ಯಜ್ಞ ಕರಿನ ಔ’ ಕೈನ ಕವಾಡಾಸ. <verse eid="EXO 5:17" /><verse number="18" style="v" sid="EXO 5:18" />ತಿನಾಹುತಿ ತುಮೆ ಹಮ್ನಾ ತುಮಾರಾ ಕಾಮೆ ಜಾ಼ವೊ ತುಮೊನೆ ಚಾರೊ ನೈ ದೆತಾ. ಚಾರೊ ನೈ ದಿತಬಿ ಇಟಂಗಿಯೊನೊ ಲೆಕ್ಕೊ ಸಿದಾ ದ್ಯು” ಕದ್ಯೊ. <verse eid="EXO 5:18" /><verse number="19" style="v" sid="EXO 5:19" />ದಿನ್ನೆ ದಿನ್ನೆಬಿ ಇಟಂಗಿಯೊನೊ ಹಿಸಾಬ ಸಿದಾ ದ್ಯು ಕೈನ ಫರೊಹನ ಕದಲಕ್ಹು ಇಸ್ರಾಯೆಲನಾ ಮೆಲ್ವಿಚಾರಕರೊ ತ್ಯುನೆ ಘನ್ನಾ ಕೆಟ್ಟ ಪರಿಸ್ಥಿತಿಮಾ ಅಟ್ಕಿ ಗಯಾಸ ಕೈನ ತಿಳ್ದಿಲಿದ್ಯಾ. <verse eid="EXO 5:19" /><verse number="20" style="v" sid="EXO 5:20" />ತ್ಯುನೆ ಫರೊಹನನಾ ರಾಜ ದರ್ಬಾರಮಾತಾ ಭಾರಾ ಜಾತಾಮಾ ತ್ಯುನೊನೆ ಮಳಾನೆ ಆಯಲ ಮೊಶೆ ವರಿ ಆರೊನನೆ ಹುಬ್ರೈನ ಕೈದಾಡಾತಾ. <verse eid="EXO 5:20" /><verse number="21" style="v" sid="EXO 5:21" />ಮೊಶೆ ವರಿ ಆರೊನನೆ, "ಯಹೊವಾ ತುಮೊನೆ ದೆಕಿನ ಫೈಸಲೊ ಕರಾದೆ. ಕಾಕದ್ಯಾಮ ಫರೊಹನ ವರಿ ತಿನಾ ಅದಿಕಾರಿಯೊ ಹಮೊನೆ ದೆಕಿನ ಅಸೈ ಕರಾವರಕ್ಹು ತುಮೆ ಕರೊಶಿ. ಹಮೊನೆ ಖಲಾಸ ಕರಾನೆ ತ್ಯುನಾ ಹತ್ಮಾ ತುಮೆ ತಲವಾರ ದಿದ್ಯಾಸ” ಕದ್ಯಾ. "ಯಹೊವಾ ತುಮಾರಾ ತಪ್ಪ ಕಾಮನಾ ಲಿಂಗತ ತುಮೊನೆ ಶಿಕ್ಷಾ ದಿವಾದೆ” ಕೈನ ಕದ್ಯಾ.<verse eid="EXO 5:21" /></para>
  <para style="s">ಮೊಶೆ ಯಹೊವಾನೆ ಚಾಡಿ ಕದಲ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22" />ತೆಳಾಮಾ ಮೊಶೆ ತ್ಯುನೊಕಂತೊ ಯಹೊವಾಕನ ಐನ, "ಸ್ವಾಮಿ, ಆಂ ಮನಕ್ಹೊನೆ ಬಿನ್ನಕ್ಕರ ತ್ರಾಸ ದಿದ್ಯೊತೊ? ಮನೆ ವಳಾಯಲ ಶಾನಾಹುತಿ ವ್ಹೈ? <verse eid="EXO 5:22" /><verse number="23" style="v" sid="EXO 5:23" />ಮಿ ಫರೊಹನಕನ ಗೈನ ತಾರಾ ನಾಮಪರ ಬೊಲಲ ದಿನ್ನತೊಬಿ ತೆ ಆಂ ಮನಕ್ಹೊನೆ ತ್ರಾಸ ದಿವಾಡೊಸ. ತು ತಾರಾ ಮನಕ್ಹೊನೆ ವಚಾ಼ಡಾನೆ ಸುಜ ಕರಾಡೊ ನತ್ತಿ!” ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 5:23" /></para>
  <chapter eid="EXO 5" />
  <chapter number="6" style="c" sid="EXO 6" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆನೆ, "ಮಿ ಫರೊಹನನೆ ಕರಾನು ತು ಹಮ್ನಾ ದೆಕಶಿ. ತೆ ಮಿ ಕೆಕ್ಲೊ ತಾಕತವರ ವ್ಹೈ ಕೈನ ದೆಕಿನ ತ್ಯುನೊನೆ ಜಾ಼ವಾನೆ ದಿವಸ. ಮಿ ದಿವಾನಾ ತ್ರಾಸಕ್ಹು ತೆ ತುಮೊನೆ ತಿನಾ ದೆಶತೊ ವಳೈಪಡಸ” ಕದ್ಯೊ.<verse eid="EXO 6:1" /></para>
  <para style="s">ಕ್ಹುದಾ ಮೊಶೆನೆ ಬಲಾಯಲ</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2" />ಕ್ಹುದಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ವರಿ ಬೊಲಿನ ಅಮ್ಮ ಕದ್ಯೊ, "ಮಿಜ಼಼ ವೈ ಯಹೊವಾ, <verse eid="EXO 6:2" /><verse number="3" style="v" sid="EXO 6:3" />ಮಿ ಅಬ್ರಾಹಮನೆಬಿ, ಇಸಾಕನೆಬಿ, ಯಾಕೊಬನೆಬಿ ಸರ್ವಶಕ್ತ ಥಯಲ ಕ್ಹುದಾ ಥೈನ ದಿಕ್ಹ್ಯೊ. ತೆನೈಸೊ ಯಹೊವಾ ಕೈನ ಮಾರು ನಾಮ ತ್ಯುನೊನೆ ಗ್ವತ್ತ ನ್ಹೊತು. <verse eid="EXO 6:3" /><verse number="4" style="v" sid="EXO 6:4" />ಮಿ ತ್ಯುನೊನೆ ಕಾನಾನ ದೆಶ ಕದ್ಯಾಮ, ತ್ಯುನೆ ಬಿಜಾ಼ ದೆಶನಾ ಥೈನ ರ‍್ಹಯಲ ಪ್ರವಾಸನು ದೆಶ ತ್ಯುನೊನೆ ದ್ಯುಸ ಕೈನ ತ್ಯುನಾ ಕ್ಹಾತೆ ವಡಂಬಡಿಕೆ ದಿದಲ ಛೆ. <verse eid="EXO 6:4" /><verse number="5" style="v" sid="EXO 6:5" />ಐಗುಪ್ತವಾಲಾ ಗುಲಾಮೊ ಕರಲಿನ ಮ್ಹೆಲಿದಲ ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊನು ತ್ರಾಸ ಮನೆ ಐಕು ಐಯುಸ. ಮಿ ದಿದಲ ವಡಂಬಡಿಕೆ ಮಿ ವರಿ ಶೆ ಕರ‍್ಯೊ. <verse eid="EXO 6:5" /><verse number="6" style="v" sid="EXO 6:6" />ತಿನಾಹುತಿ, ತು ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನೆ ಮಾರಾ ನಾಮಪರ ಸು ಕೌ ಕದ್ಯಾಮ, ‘ಮಿಜ಼಼ ಯಹೊವಾ ವೈ, ಐಗುಪ್ತಾವಾಲಾ ತುಮೊಕಂತಾ ಕರಾವಾನಾ ಕಾಮೊಕ್ಹು ಛೊಡೈನ, ತ್ಯುನಾ ಗುಲಾಮೊ ಥಯಲ ತುಮೊನೆ ಗುಲಾಮತೊ ಕಾಡಿನ, ಮಿ ತ್ಯುನೊನೆ ಘನ್ನಿ ಮ್ಹೊಟಿ ಶಿಕ್ಷಾದಿನ ತುಮೊನೆ ವಚಾ಼ಡುಸ. <verse eid="EXO 6:6" /><verse number="7" style="v" sid="EXO 6:7" />ಮಿ ತುಮೊನೆ ಮಾರಾ ಸ್ವಂತ ಮನಕ್ಹೊ ವ್ಹೈ ಕೈನ ಇನಿಲಿನ ತುಮೊನೆ ಕ್ಹುದಾ ಥೈನ ರ‍್ಹೌಸ. ಐಗುಪ್ತವಾಲಾ ತುಮೊಕನ ಕರಾವಾನಾ ಕಾಮೊಕ್ಹು ತುಮೊನೆ ಛೊಡಾಯಲ್ಪರ ಯಹೊವಾ ಥಯಲ ಮಿಜ಼಼ ತುಮಾರೊ ಕ್ಹುದಾ ವೈ ಕೈನ ತುಮೊನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EXO 6:7" /><verse number="8" style="v" sid="EXO 6:8" />ತೆನೈಸೊ ಅಬ್ರಹಾಮ, ಇಸಾಕ ವರಿ ಯಾಕೊಬನೆ ವಾತ ದಿದಲ ದೆಶಮಾಜ ತುಮೊನೆ ಲಿನ ಜೌ಼ಸ, ತೆ ದೆಶಜ಼ ತುಮೊನೆ ರ‍್ಹವಾನೆ ಕೈನ ದಿ ಪಡುಸ ಕೈನ ಕವಾಲೊ ಯಹೊವಾ ಮಿಜ಼಼ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಕೆ” ಕದ್ಯೊ. <verse eid="EXO 6:8" /><verse number="9" style="v" sid="EXO 6:9" />ಮೊಶೆ ಕ್ಹುದಾ ಕದಲ ತಿಮ್ಮಜ಼ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನೆ ಕತಾಮಾ, ತ್ಯುನು ಮನಸ ಘನ್ನಾ ದುಕಮಾ ರ‍್ಹಯಲಹುತಿ, ವರಿ ಘನ್ನಾ ತ್ರಾಸಕ್ಹು ತ್ಯುನೆ ಕಾಮೊ ಕರಾನು ಆಯಲಹುತಿಬಿ ತ್ಯುನೆ ಮೊಶೆನಿ ವಾತನೆ ಕಾನ ದಿದ್ಯಾ ನೈ. <verse eid="EXO 6:9" /><verse number="10" style="v" sid="EXO 6:10" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="EXO 6:10" /><verse number="11" style="v" sid="EXO 6:11" />"ತು ಐಗುಪ್ತನೊ ರಾಜೊ಼ ಥಯಲ ಫರೊಹನಕನ ಗೈನ ತೆ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನೆ ತಿನಾ ದೆಶತೊ ಜಾ಼ವಾನೆ ದ್ಯು ಕೈನ ತು ತಿನಾ ಕ್ಹಾತೆ ಬೊಲ” ಕದ್ಯೊ. <verse eid="EXO 6:11" /><verse number="12" style="v" sid="EXO 6:12" />ತಿನಾಹುತಿ ಮೊಶೆ ಯಹೊವಾನಾ ಸನ್ನಿದಿಮಾ, "ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊಜ಼ ಮಾರಿ ವಾತ ನತ್ತಿ ಐಕಾಡಾ; ತಿಮ್ಮ ರ‍್ಹತಾಮಾ ತೊದಲಿನ ಬೊಲಾನಾ ಮಾರಿ ವಾತ ಫರೊಹನ ಐಕಸ ಸು? ಕದ್ಯೊ. <verse eid="EXO 6:12" /><verse number="13" style="v" sid="EXO 6:13" />ಯಹೊವಾ ಮೊಶೆ ವರಿ ಆರೊನನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, "ಇಸ್ರಾಯೆಲವಾಲಾವೊನೆ ಐಗುಪ್ತ ದೆಶತೊ ಬಲೈಲಾವಾನಾ ಹುತಿ‍ ತ್ಯುನೊನೆ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊಕನ ವರಿ ಐಗುಪ್ತನಾ ರಾಜಾ಼ಕನ ವಳಾಯೊ.”<verse eid="EXO 6:13" /></para>
  <para style="s">ಮೊಶೆ ವರಿ ಅರೊನನು ಖಾಂದಾನ</para>
  <para style="m">
    <verse number="14" style="v" sid="EXO 6:14" />ಇಸ್ರಾಯೆಲನಾ ಖಾಂದಾನನಾ ಘರಮಾ ಮ್ಹೊಟಾ: ಇಸ್ರಾಯೆಲನೊ ಪೈಲಾರ ದಿಕ್ರೊ ಥಯಲ ರುಬೆನನಾ ಬಚ್ಚಾ: ಹನೊಕ, ಫಲ್ಲು, ಹೆಚ್ರೊನ, ವರಿ ಕರ್ಮಿ ಇವ್ನೆಜ ರುಬೆನನಾ ಖಾಂದಾನಮಾ ಮ್ಹೊಟಾ ವ್ಹೈ. <verse eid="EXO 6:14" /><verse number="15" style="v" sid="EXO 6:15" />ಸಿಮೆಯೊನನಾ ಬಚ್ಚಾ: ಯೆಮೂಯೆಲ, ಯಾಮಿನ, ಓಹದ, ಯಾಕಿನ, ಚೊಹರ, ವರಿ ಕಾನಾನ್ಯನಿ ಬಾಕ್ಡಿಕಂತೊ ಹುಟ್ಟಲ ಸೌಲ ಇವ್ನೆಜ ಸಿಮೆಯೊನನಾ ಖಾಂದಾನಮಾ ಮ್ಹೊಟಾ ವ್ಹೈ. <verse eid="EXO 6:15" /><verse number="16" style="v" sid="EXO 6:16" />ಲೆವಿನಾ ಖಾಂದನವಾಲಾವೊಮಾ: ಗೆರ್ಷೊನ, ಕೆಹಾತ, ಮೆರಾರಿ, ಇವ್ನೆಜ ವ್ಹೈ. ಲೆವಿ 137 ವರಕ್ಹ ಜಿವ್ತೊ ವ್ಹತ್ತೊ. <verse eid="EXO 6:16" /><verse number="17" style="v" sid="EXO 6:17" />ಖಾಂದಾನನಾ ಹಿಸಾಬೆ ಗೆರ್ಷೊನನಾ ಬಚ್ಚಾ: ಲಿಬ್ನಿ ವರಿ ಶಿಮ್ಮಿ. <verse eid="EXO 6:17" /><verse number="18" style="v" sid="EXO 6:18" />ಕೆಹಾತನಾ ಚಾರ ಬಚ್ಚಾ: ಅಮ್ಮ್ರಾಮ, ಇಚ್ಹಾರ, ಹೆಬ್ರೊನ, ಉಜ್ಜಿಯೆಲ. ಕೆಹಾತ 133 ವರಕ್ಹ ಜಿವ್ತೊ ವ್ಹತ್ತೊ. <verse eid="EXO 6:18" /><verse number="19" style="v" sid="EXO 6:19" />ಮೆರಾರಿನಾ ಬಚ್ಚಾ: ಮಹ್ಲಿ, ಮೂಷಿ ಖಾಂದಾನನಾ ಪ್ರಕಾರ ಲೆವಿನಾ ಘರದಾನಾನಾ ಅವನೆಜ ವೈ. <verse eid="EXO 6:19" /><verse number="20" style="v" sid="EXO 6:20" />ಅಮ್ಮ್ರಾಮ ತಿನಾ ಬಾನಾ ಭೆನ ಥಯಲ ಯೊಕೆಬದಳನೆ ಹಿವಾ ಕರಲಿದ್ಯೊ. ತೆ ತಿನಾಕ್ಹು ಆರೊನನೆ ವರಿ ಮೊಶೆನೆ ಜ಼ನ್ನಿ. ಅಮ್ಮ್ರಾಮ 137 ವರಕ್ಹ ಜಿವ್ತೊ ವ್ಹತ್ತೊ. <verse eid="EXO 6:20" /><verse number="21" style="v" sid="EXO 6:21" />ಇಚ್ಹಾರನನಾ ಬಚ್ಚಾ ಕೊರಹ, ನೆಫೆಗ ವರಿ ಚಿಕ್ರಿ. <verse eid="EXO 6:21" /><verse number="22" style="v" sid="EXO 6:22" />ಉಜ್ಜಿಯರಲನಾ ಬಚ್ಚಾ: ಮಿಷಾಯೆಲ, ಎಲ್ಜಾ಼ಫಾನ ವರಿ ಸಿತ್ರಿ ವ್ಹೈ. <verse eid="EXO 6:22" /><verse number="23" style="v" sid="EXO 6:23" />ಆರೊನ ಅಮ್ಮಿನಾದಾಬನಿ ದಿಕ್ರಿನಾ ಕ್ಹಾತೆ ಕದ್ಯಾಮ ನಹಶೊನನಿ ಭೆನ ಥಯಲ, ಎಲಿಶೆಬನಾ ಕ್ಹಾತೆ ಹಿವಾ ಕರಲಿದ್ಯೊ. ತೆ ಎಲಿಶೆಬ ತಿನಾಕ್ಹು ನಾದಾಬ, ಅಬಿಹು, ಎಲ್ಲಾಜಾರ, ವರಿ ಇತಾಮಾರನೆ ಜ಼ನ್ನಿ. <verse eid="EXO 6:23" /><verse number="24" style="v" sid="EXO 6:24" />ಕೊರಹನಾ ಬಚ್ಚಾ: ಅಸ್ಸಿರ, ಎಲ್ಕಾನ, ಅಬಿಯಾಸಾಫ ಇವ್ನೆಜ ಕೊರಹನನಾ ಘರದಾನನಾ ವ್ಹೈ. <verse eid="EXO 6:24" /><verse number="25" style="v" sid="EXO 6:25" />ಆರೊನನೊ ದಿಕ್ರೊ ಎಲ್ಲಾಜಾರ ಪುಟಿಯೆಲನಾ ಯಕ್ಕ ದಿಕ್ರಿನಾ ಕ್ಹಾತೆ ಹಿವಾ ಕರಲಿದ್ಯೊ. ತೆ ಫಿನೆಹಾಸನೆ ಜ಼ನ್ನಿ. ತ್ಯುನಾ ಘರದಾನನಾ ಹಿಸಾಬೆ ಇವ್ನೆಜ ಲೆವಿಯನಾ ಮ್ಹೊಟಾ ವ್ಹೈ. <verse eid="EXO 6:25" /><verse number="26" style="v" sid="EXO 6:26" />ಇಸ್ರಾಯೆಲನಾ ಘರದಾನಾನಾ ಹಿಸಾಬೆ, ಐಗುಪ್ತ ದೆಶತೊ ತ್ಯುನೊನೆ ಲೌ ಕೈನ ಯಹೊವಾ ಕಿನೆ ಕದ್ಯೊ ತಿವ್ನೆ ಆರೊನನೆ ವರಿ ಮೊಶೆನೆ ವ್ಹೈ. <verse eid="EXO 6:26" /><verse number="27" style="v" sid="EXO 6:27" />ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊನೆ ಐಗುಪ್ತ ದೆಶತಾ ಭಾರಾ ಲಾವಾನಾ ಹುತಿ ಐಗುಪ್ತನೊ ರಾಜೊ಼ ಥಯಲ ಫರೊಹನನಾ ಕ್ಹಾತೆ ಬೊಲಲವಾಲಾ ಮೊಶೆ ವರಿ ಆರೊನ ಇವ್ನೆಜ ವ್ಹೈ.<verse eid="EXO 6:27" /></para>
  <para style="s">ಮೊಶೆ ವರಿ ಆರೊನನೆ ಯಹೊವಾನಿ ಆಗನ್ಯಾ</para>
  <para style="m">
    <verse number="28" style="v" sid="EXO 6:28" />ಯಹೊವಾ ಐಗುಪ್ತ ದೆಶಮಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ಬೊಲಲ ಟೈಮಮಾ, <verse eid="EXO 6:28" /><verse number="29" style="v" sid="EXO 6:29" />ತೆ ಮೊಶೆನೆ, "ಮಿ ಯಹೊವಾ ವ್ಹೈ ಮಿ ತುನೆ ಕವಾನು ಕ್ಹಾರು ತು ಐಗುಪ್ತನಾ ರಾಜೊ಼ ಥಯಲ ಫರೊಹನಕನ ಕೌ” ಕದ್ಯೊ. <verse eid="EXO 6:29" /><verse number="30" style="v" sid="EXO 6:30" />ತೆ ವಾತೆ ಮೊಶೆ ಯಹೊವಾನೆ, "ಐಕ ಸ್ವಾಮಿ ಮಿ ಬೊಲ್ತಾಮಾ ತೊದಲುಸ ವರಿ ಚೊಕಿ ತರಾ ಬೊಲಾನೆ ಆತು ನೈ, ಫರೊಹನ ಕಿಮ್ಮ ಮಾರಿ ವಾತ ಐಕಸ” ಕದ್ಯೊ.<verse eid="EXO 6:30" /></para>
  <chapter eid="EXO 6" />
  <chapter number="7" style="c" sid="EXO 7" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆನೆ ಅಮ್ಮ ಕದ್ಯೊ, "ತುನೆ ಫರೊಹನನಾ ಕ್ಹುದಾನಿ ಜ಼ಗಾ ಹುಬ್ರಾಡ್ಯೊಸ. ದೆಕ, ತಾರೊ ದಾದೊ ಆರೊನನೆ ತಾರೊ ಪ್ರವಾದಿ ಕರ‍್ಯೊಸ. <verse eid="EXO 7:1" /><verse number="2" style="v" sid="EXO 7:2" />ಮಿ ತುನೆ ಆಗನ್ಯಾ ಕರಲ ಕ್ಹಾರು ತು ಕೌ. ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊನೆ ತಿನಾ ದೆಶತೊ ಜಾ಼ವಾನೆ ಇಜಾಜ಼ತ ದ್ಯು ಕೈನ ತಾರೊ ದಾದೊಜ ಫರೊಹನನಾ ಕ್ಹಾತೆ ಬೊಲು. <verse eid="EXO 7:2" /><verse number="3" style="v" sid="EXO 7:3" />ತಿಮ್ಮ ರ‍್ಹೈತಬಿ ಮಿ ಫರೊಹನನೆ ಮನಸ ಮಂಡ ಕರಿನ, ಐಗುಪ್ತ ದೆಶಮಾ ಘನ್ನಾ ಮ್ಹೊಟಾ ಕಾಮೊ ವರಿ ಅದ್ಬುತ ಕಾಮೊ ಕರಿನ ಮಾರಿ ತಾಕತ ದೆಕಾಡುಸ. <verse eid="EXO 7:3" /><verse number="4" style="v" sid="EXO 7:4" />ಫರೊಹನ ತುಮಾರಿ ವಾತ ನೈ ಐಕ್ತೊ. ತೆಳಾಮಾ ಮಿ ಐಗುಪ್ತವಾಲಾವೊನೆ ಘನ್ನೊ ತ್ರಾಸ ದ್ಯುಸ, ತ್ಯುನೊನೆ ಘನ್ನಿ ಮ್ಹೊಟಿ ಶಿಕ್ಷಾ ದ್ಯುಸ ಮಾರಾ ಮನಕ್ಹೊ ಥಯಲ ಇಸ್ರಾಯೆಲನಾ ಸೆನೆನೆ ಐಗುಪ್ತ ದೆಶತೊ ಭಾರೊ ಲೌಸ. <verse eid="EXO 7:4" /><verse number="5" style="v" sid="EXO 7:5" />ಮಿ ಐಗುಪ್ತವಾಲಾವೊನಾ ವಿರೊದ ಹುಬ್ರೈನ ತ್ಯುನಾ ವಚ್ಮಾತೊ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನೆ ಭಾರೊ ಲಾತಾಮ ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಥಾವಸ” ಕದ್ಯೊ. <verse eid="EXO 7:5" /><verse number="6" style="v" sid="EXO 7:6" />ಯಹೊವಾ ಆಗನ್ಯಾ ಕರಲ ತಿಮ್ಮಜ಼ ಮೊಶೆ ವರಿ ಆರೊನ ಕರ‍್ಯಾ. <verse eid="EXO 7:6" /><verse number="7" style="v" sid="EXO 7:7" />ತ್ಯುನೆ ಫರೊಹನನಾ ಕ್ಹಾತೆ ಬೊಲನಾ ಟೈಮಮಾ ಮೊಶೆ 80 ವರಕ್ಹನೊ ವ್ಹತ್ತೊ ವರಿ ಆರೊನ 83 ವರಕ್ಹನೊ ವ್ಹತ್ತೊ.<verse eid="EXO 7:7" /></para>
  <para style="s">ಆರೊನನಿ ಲಾಕ್ಡಿ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8" />ಯಹೊವಾ ಮೊಶೆ ವರಿ ಆರೊನನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="EXO 7:8" /><verse number="9" style="v" sid="EXO 7:9" />"ಫರೊಹನ ತುಮೊನೆ, ‘ಮಿ ತುಮಾರಿ ವಾತಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲು ಕದ್ಯಾಮ ತುಮೆ ಮಾರಾ ಕ್ಹಾಮಾ ಕುನ್ನ ನೈ ಕರಾನಾ ಕಾಮೊ ಕರು’ ಕೈನ ತುಮೊನೆ ಕದ್ಯಾಮ, ‘ತಾರಾ ಹತ್ಮಾ ರ‍್ಹಯಲ ಲಾಕ್ಡಿ ಫರೊಹನನಾ ಕ್ಹಾಮೊ ಹೆಟಿ ನಾಕ’ ಕೈನ ಕೌ. ತೆ ಕ್ಹಾಪ ಥೈ ಜಾ಼ವಸ” ಕೈನ ಆಗನ್ಯಾ ಕರ‍್ಯೊ. <verse eid="EXO 7:9" /><verse number="10" style="v" sid="EXO 7:10" />ಮೊಶೆ ವರಿ ಆರೊನ ಫರೊಹನಕನ ಗೈನ ತ್ಯುನೊನೆ ಆಗನ್ಯಾ ಕರಲ ತಿಮ್ಮಜ಼ ಕರ‍್ಯಾ. ಆರೊನ ತಿನಿ ಲಾಕ್ಡಿ ಫರೊಹನ ವರಿ ತಿನಾ ಸೈನಿಕೊನಾ ವರಿ ಅದಿಕಾರಿಯೊನಾ ಕ್ಹಾಮೊ ಹೆಟೊ ನಾಕ್ಯೊ. ನಾಕಲ್ಪರ ತೆ ಲಾಕ್ಡಿ ಕ್ಹಾಪ ಥೈ ಗೈ. <verse eid="EXO 7:10" /><verse number="11" style="v" sid="EXO 7:11" />ಫರೊಹನ ಐಗುಪ್ತ ದೆಶಮಾ ರ‍್ಹಯಲ ವಿದ್ವಾಂಸೊನೆ ವರಿ ಮಾಟಾಮಂತ್ರಾ ಕರಾಲಾವೊನೆ ಬಲಾಯೊ ತ್ಯುನೆಬಿ ತ್ಯುನಾ ಮಂತ್ರಕ್ಹು ತಿಮ್ಮಜ಼ ಕರ‍್ಯಾ. <verse eid="EXO 7:11" /><verse number="12" style="v" sid="EXO 7:12" />ತ್ಯುನೆ ತ್ಯುನಾ ಲಾಕ್ಡಿಯೊ ಹೆಟಾ ನಾಕತಾಮಾ ಕ್ಹಾಪ ಥೈ ಗಯಾ. ತೆನೈಸೊ ತೆ ಆರೊನನಿ ಲಾಕ್ಡಿ ತ್ಯುನಾ ಕ್ಹಾರಾ ಲಾಕ್ಡಿಯೊನೆ ಗಳಿ ಗೈ. <verse eid="EXO 7:12" /><verse number="13" style="v" sid="EXO 7:13" />ಯಹೊವಾ ಪೈಲಾ ಕದಲ ತಿಮ್ಮಜ಼ ಫರೊಹನನು ಮನಸ ಮಂಡ ಕರಿನ, ತೆ ತ್ಯುನಿ ವಾತ ಐಕ್ಯೊ ನೈ.<verse eid="EXO 7:13" /></para>
  <para style="s">ಐಗುಪ್ತವಾಲಾವೊನು ತ್ರಾಸ</para>
  <para style="s1">ರಗತ</para>
  <para style="m">
    <verse number="14" style="v" sid="EXO 7:14" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆನೆ, "ಫರೊಹನನು ಮನಸ ಘನ್ನು ಮಂಡ ಥೈಯುಸ, ತೆ ಮನಕ್ಹೊನೆ ಜಾ಼ವಾನೆ ನೈ ದೆತೊ ಕವಾಡೊಸ. <verse eid="EXO 7:14" /><verse number="15" style="v" sid="EXO 7:15" />ತು ಪಾಟೆ ಫರೊಹನಕನ ಜಾ಼, ತೆ ನದಿನಾ ಪಾನಿಕನ ಆವಸತೊ. ಕ್ಹಾಪ ಥಯಲ ತೆ ಲಾಕ್ಡಿನೆ ತಾರಾ ಹತ್ಮಾ ಧರ್ಲಿನ ತು ತಿನೆ ಮಳಾನೆ ನೈಲ ನದಿನಾ ಬಿಜೆ ದಂಡಿನೆ ಹುಬ್ರೈನ ತು ತಿನಾಹುತಿ ಕೈದೊ. <verse eid="EXO 7:15" /><verse number="16" style="v" sid="EXO 7:16" />ತೆಳಾಮಾ ತು ರಾಜಾನೆ ಅಮ್ಮ ಕೆ, ‘ಇಬ್ರಿಯನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಮನೆ ತುಕನ ವಳಾಯೊಸ, ರಾನಮಾ ತಿನೆ ಆರಾಧನಾ ಕರಾನೆ ತಿನಾ ಮನಕ್ಹೊನೆ ತು ವಳೌ ಕೈನ ಕೈತಬಿ, ತು ಐಕ್ಯೊ ನೈ. <verse eid="EXO 7:16" /><verse number="17" style="v" sid="EXO 7:17" />ತಿನಾಹುತಿ ಯಹೊವಾ ಸು ಕವಸ ಕದ್ಯಾಮ, ತು ಮನೆ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತಿಳ್ದಿಲಿವಾನಾಹುತಿ ಮಾರಾ ಸೆವಕನೆ ತಿನಾ ಹತ್ಮಾ ರ‍್ಹಯಲ ಲಾಕ್ಡಿಕ್ಹು ನೈಲ ನದಿನೆ ಮಾರಾಲಗಾಡುಸ. ತೆ ನೈಲ ನದಿನು ಪಾನಿ ರಗತ ಥೈ ಜಾ಼ವಸ. <verse eid="EXO 7:17" /><verse number="18" style="v" sid="EXO 7:18" />ನದಿಮಾ ರ‍್ಹಯಲ ಮಚ್ಲಿಯೊ ಮರಸ. ನದಿನಾ ಪಾನಿಮಾತು ಕೆಟ್ಟ ಬಾಸ ಆವಸ. ತೆ ಪಾನಿ ಪಿವಾನೆ ಐಗುಪ್ತವಾಲಾವೊನೆ ನೈ ಥಾತು ಕೈನ ಕೌ” ಕದ್ಯೊ. <verse eid="EXO 7:18" /><verse number="19" style="v" sid="EXO 7:19" />ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, "ತು ಆರೊನನೆ ‘ತಾರಿ ಲಾಕ್ಡಿಲಿನ ತು ಐಗುಪ್ತ ದೆಶನಾ ಹರಯಕ್ಕ ಇರೆ, ಹೊಳೆ, ವಕಳೆ, ಕಾಲುವೆನೆ, ಪಾನಿ ಕಿ ರ‍್ಹವಸ ತ್ಯಾ ಗೈನ ತಾರಿ ಲಾಕ್ಡಿ ಉಚೌ಼’ ಕೈನ ಕೌ. ಆರೊನ ತೆ ಲಾಕ್ಡಿ ಉಚಾತಾಮಾ ಪಾನಿ ಪುರಾ ರಗತ ಥಾವಸ. ಐಗುಪ್ತ ದೆಶಮಾ ರ‍್ಹಯಲ ಲಾಕ್ಡಾನು ಸಾಮನಮಾ ದಗ್ಡಾನಾ ಸಾಮನಮಾ ರ‍್ಹಯಲ ಪಾನಿ ಪುರಾ ರಗತ ಥಾವಸ” ಕದ್ಯೊ. <verse eid="EXO 7:19" /><verse number="20" style="v" sid="EXO 7:20" />ಮೊಶೆ ವರಿ ಆರೊನ ಯಹೊವಾ ಕದಲ ತಿಮ್ಮಜ಼ ಕರ‍್ಯಾ. ಆರೊನ ಫರೊಹನ ವರಿ ತಿನಾ ಅದಿಕಾರಿಯೊನಾ ವರಿ ಸೈನಿಕೊನಾ ಕ್ಹಾಮೊ ಲಾಕ್ಡಿ ಉಚೈನ ನೈಲ ನದಿನೆ ಮಾರತಾಮಾ ತಿಮಾನು ಪುರಾ ಪಾನಿ ರಗತ ಥಯು ಗಯು. <verse eid="EXO 7:20" /><verse number="21" style="v" sid="EXO 7:21" />ತೆ ಪಾನಿಮಾ ರ‍್ಹಯಲ ಮಚ್ಲಿಯೊ ಮರಿ ಗಯೊ. ತೆ ನದಿಮಾನು ಪಾನಿ ಬಾಸಗಂದ ಥಯಲ ಹುತಿ ಐಗುಪ್ತನಾ ಮನಕ್ಹೊನೆ ತೆ ಪಾನಿ ಪಿವಾನೆಜ಼ ಥಯು ನೈ. ಐಗುಪ್ತ ದೆಶಮಾ ಕ್ಹಾಲಿ ರಗತಜ಼ ದಿಕ್ಹಾಡುತು. <verse eid="EXO 7:21" /><verse number="22" style="v" sid="EXO 7:22" />ತೆನೈಸೊ ಐಗುಪ್ತ ದೆಶಮಾ ರ‍್ಹಯಲ ಮಾಟಾಮಂತ್ರಾ ಕರಾಲಾ ತ್ಯುನಾ ಮಂತ್ರಾಕ್ಹು ತಿಮ್ಮಜ಼ ಕರತಾಮಾ ಫರೊಹನನು ಮನಸ ಹಜು಼ನಕ್ಕರ ಮಂಡ ಥಯು. ಯಹೊವಾ ಕದಲ ತಿಮ್ಮಜ಼ ಫರೊಹನ ಮೊಶೆ ವರಿ ಆರೊನನಿ ವಾತ ಐಕ್ಯೊ ನೈ. <verse eid="EXO 7:22" /><verse number="23" style="v" sid="EXO 7:23" />ಇಮ್ಮ ಫರೊಹನ ತೆ ಅದ್ಬುತ ಕಾಮಪರ ಧ್ಯಾನ ದಿದ್ಯೊ ನೈ ತ್ಯಾಂತೊ ತಿನಾ ಘರೆ ಗೈ ಪಡ್ಯೊ. <verse eid="EXO 7:23" /><verse number="24" style="v" sid="EXO 7:24" />ಕ್ಹಾರಾ ಐಗುಪ್ತನಾ ಮನಕ್ಹೊನೆ ನೈಲ ನದಿನು ಪಾನಿ ಪಿವಾನೆ ನೈ ಥಾತಾಮಾ ತ್ಯುನೆ ನದಿನಾ ದಂಡಿಮಾ ಕ್ಹಾಡಿಯೊ ಖಂದ್ಯಾ. <verse eid="EXO 7:24" /><verse number="25" style="v" sid="EXO 7:25" />ಯಹೊವಾ ನೈಲ ನದಿನೆ ಮಾರಿನ ಕ್ಹಾತ ದಿನ್ನ ಥಯಾ.<verse eid="EXO 7:25" /></para>
  <chapter eid="EXO 7" />
  <chapter number="8" style="c" sid="EXO 8" />
  <para style="s">ಬೆಂಡ್ಕಿಯೊ</para>
  <para style="m">
    <verse number="1" style="v" sid="EXO 8:1" />ತೆ ಥಯಲ್ಪರ ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ಬೊಲಿನ ತಿನೆ, "ತು ಫರೊಹನಕನ ಗೈನ ಅಮ್ಮ ಕೌ, ‘ಯಹೊವಾ ತುನೆ ಸು ಕವಸ ಕದ್ಯಾಮ: ಮನೆ ಆರಾಧನಾ ಕರಾನೆ ಮಾರಾ ಮನಕ್ಹೊನೆ ಇಜಾಜ಼ತ ದೆ. <verse eid="EXO 8:1" /><verse number="2" style="v" sid="EXO 8:2" />ತು ತ್ಯುನೊನೆ ಜಾ಼ವಾನೆ ನೈ ದಿದ್ಯಾರೆ, ಮಿ ತಾರಾ ದೆಶನೆ ಬೆಂಡ್ಕಿಯೊಕ್ಹು ತ್ರಾಸ ದ್ಯುಸ. <verse eid="EXO 8:2" /><verse number="3" style="v" sid="EXO 8:3" />ನೈಲ ನದಿಮಾ ತುನೆ ಮೊಜಾ಼ನೆ ಥಾತು ನೈ ತೆಕ್ಲಾ ಬೆಂಡ್ಕಿಯೊ ಹುಟ್ಟಸ. ತೆ ತ್ಯಾಂತೊ ಐನ ತಾರಾ ರಾಜ ಮಹಲಮಾ, ತುಮೆ ಕ್ಹುರ‍್ಯಾನಿ ಜ಼ಗಾಮಾ, ತಾರಾ ಪಲಂಗಪರ ನೈಸೊ ವರಿ ತಾರಾ ಅದಿಕಾರಿಯೊನಾ ವರಿ ತಾರಾ ಮನಕ್ಹೊನಾ ಘರೊಮಾ, ತ್ಯುನಾ ಚು಼ಲ್ಲಾವೊಮಾ, ಸಾಮನೊಮಾ ಜಾ಼ವಸ. <verse eid="EXO 8:3" /><verse number="4" style="v" sid="EXO 8:4" />ತುಪರಬಿ ತಾರಾ ಮನಕ್ಹೊನಾ ಉಪ್ಪರಬಿ ವರಿ ತಾರಾ ಘರದಾನನಾ ಉಪ್ಪರಬಿ ನಿಸ್ತಾ ಬೆಂಡ್ಕಿಯೊಜ ಜಿಗ್ದಸ” ಕದ್ಯೊ. <verse eid="EXO 8:4" /><verse number="5" style="v" sid="EXO 8:5" />ಯಹೊವಾ ಮೊಶೆನೆ, "ತು ಆರೊನನೆ, ತಾರಿ ಲಾಕ್ಡಿಲಿನ ನದಿ, ವಕಳೆ, ಕಾಲುವೆನೆ ಜಾ಼ ತಿನಾ ಉಪ್ಪರ ತಾರಿ ಲಾಕ್ಡಿ ಉಚಾ ತೆಳಾಮಾ ಐಗುಪ್ತ ದೆಶ ಭರಿನ ನಿಸ್ತಾ ಬೆಂಡ್ಕಿಯೊ ರ‍್ಹವಸ” ಕೈನ ಕೌ ಕದ್ಯೊ. <verse eid="EXO 8:5" /><verse number="6" style="v" sid="EXO 8:6" />ತಿನಾಹುತಿ ಆರೊನ ತೆ ದೆಶಮಾ ರ‍್ಹಯಲ ಪಾನಿನಿ ಹರಯಕ್ಕ ಜ಼ಗಾಕನ ಗೈನ ತಿನಿ ಲಾಕ್ಡಿ ಉಚಾತಾಮಾ ತೆ ದೆಶ ಭರಿನ ನಿಸ್ತಿಯೊ ಬೆಂಡ್ಕಿಯೊ ಭರಿಗಯೊ. <verse eid="EXO 8:6" /><verse number="7" style="v" sid="EXO 8:7" />ತೆನೈಸೊ ಮಾಟಾಮಂತ್ರಾ ಕರಾಲಾ ತ್ಯುನಾ ಮಂತ್ರೊಕ್ಹು ತಿಮ್ಮಜ಼ ಐಗುಪ್ತ ದೆಶಮಾ ಬೆಂಡ್ಕಿಯೊ ಆವಾ ಲಗಾಡ್ಯಾ. <verse eid="EXO 8:7" /><verse number="8" style="v" sid="EXO 8:8" />ತೆಳಾಮಾ ಫರೊಹನ ಮೊಶೆ ವರಿ ಆರೊನನೆ ಬಲೈನ, "ತುಮೆ ಯಹೊವಾನೆ ಪ್ರಾಥನಾ ಕರಿನ ಆಂ ಬೆಂಡ್ಕಿಯೊನೆ ಮಕಂತಾ ವರಿ ಮಾರಾ ಮನಕ್ಹೊಕಂತಾ ವಳಾಯಾರೆ ಮಿ ತುಮಾರಾ ಮನಕ್ಹೊನೆ ಯಹೊವಾಹುತಿ ಯಜ್ಞ ಕರಾನೆ ತ್ಯುನೊನೆ ಇಜಾಜ಼ತ ದ್ಯುಸ” ಕದ್ಯೊ. <verse eid="EXO 8:8" /><verse number="9" style="v" sid="EXO 8:9" />ತಿನಾಹುತಿ ಮೊಶೆ ಫರೊಹನನೆ, "ತುಮಾರಾಹುತಿ ಪ್ರಾಥನಾ ಕರಾನೆ ಮನೆ ಕ್ಹುಷಿ ಥಾವಸ. ಮಿ ತುಮಾರಾಹುತಿ ತುಮಾರಾ ಅದಿಕಾರಿಯೊನಾಹುತಿ ವರಿ ತುಮಾರಾ ಮನಕ್ಹೊನಾಹುತಿ ಪ್ರಾಥನಾ ಕರಾನೆ ಟೈಮ ದ್ಯುಸ. ತೆಳಾಮಾ ತುಮೆ ಬೆಂಡ್ಕಿಯೊನೆ ಮಾರಿನ ನಾಕೊಶಿ ವರಿ ನೈಲ ನದಿನೆ ಛೊಡಿನ ಕುನ್ನ ನೈ ವಾಚ್ತು. <verse eid="EXO 8:9" /><verse number="10" style="v" sid="EXO 8:10" />ಫರೊಹನ ಮೊಶೆನೆ, "ವಂತಾಜ಼” ಕದ್ಯೊ. ತೆಳಾಮಾ ಮೊಶೆ, "ತು ಕದಲ ತಿಮ್ಮಜ಼ ಥೈನಕಾ, ಅನಾಕ್ಹು ತು ಹಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ಲಿಂಗತ ಕುನ್ನ ನತ್ತಿ ಕೈನ ತಿಳ್ದಿಲೆಶಿ. <verse eid="EXO 8:10" /><verse number="11" style="v" sid="EXO 8:11" />ಬೆಂಡ್ಕಿಯೊ ತುಕಂತಾ, ತುಮಾರಾ ಘರೊಮಾತಾ, ತಾರಾ ಮನಕ್ಹೊಕಂತಾ ತಾರಾ ಘರವಾಲಾವೊಕಂತಾ ಐನ ಕ್ಹಾಲಿ ನೈಲ ನದಿಮಾ ರ‍್ಹವಸ” ಕದ್ಯೊ. <verse eid="EXO 8:11" /><verse number="12" style="v" sid="EXO 8:12" />ಮೊಶೆ ವರಿ ಆರೊನ ಫರೊಹನಕಂತಾ ಐಪಡ್ಯಾ. ತೆಳಾಮಾ ಮೊಶೆ ಯಹೊವಾಕನ ತು ಫರೊಹನನಾ ಉಪ್ಪರ ಆಯಾಲ ಬೆಂಡ್ಕಿಯೊನೆ ಕಾಡಿ ಪಡು ಕೈನ ಪ್ರಾಥನಾ ಕರ‍್ಯೊ. <verse eid="EXO 8:12" /><verse number="13" style="v" sid="EXO 8:13" />ಯಹೊವಾ ಮೊಶೆ ಮಾಂಗಿಲಿದಲ ಲಿಂಗತಜ಼ ಕರ‍್ಯೊ. ಘರೊಮಾ ರ‍್ಹಯಲ, ಅಂಗಳಾಮಾ ರ‍್ಹಯಲ, ಖೆತ್ರೊಮಾ ರ‍್ಹಯಲ ಬೆಂಡ್ಕಿಯೊ ಕ್ಹಾರಾ ಮರಿ ಗಯೊ. <verse eid="EXO 8:13" /><verse number="14" style="v" sid="EXO 8:14" />ಐಗುಪ್ತವಾಲಾ ತೆ ಮರೆಲ ಬೆಂಡ್ಕಿಯೊನೆ ಯಕ್ಕಜ಼ಗಾ ಲೈನ ಘಾಲ್ಯಾ. ತೆ ಬೆಂಡ್ಕಿಯೊ ಕ್ಹಡಿನ ಪುರಾ ದೆಶಜ಼ ಬಾಸ ಉಟಿಗಯು. <verse eid="EXO 8:14" /><verse number="15" style="v" sid="EXO 8:15" />ತೆನೈಸೊ ಫರೊಹನ ಬೆಂಡ್ಕಿಯೊನು ತ್ರಾಸ ಕ್ಹರ‍್ಯು ಕೈನ ತಿಳ್ದಿಲೆತಾಮಾ, ತಿನಾ ಮನಸನೆ ಮಂಡ ಕರಲಿದ್ಯೊ. ಯಹೊವಾ ಕದಲ ತಿಮ್ಮಜ಼ ತೆ, ಮೊಶೆ ವರಿ ಆರೊನನಿ ವಾತ ಐಕ್ಯಾ ಬಗರ ರ‍್ಹಯೊ.<verse eid="EXO 8:15" /></para>
  <para style="s">ಜುವೊ</para>
  <para style="m">
    <verse number="16" style="v" sid="EXO 8:16" />ವರಿ ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, "ತು ಆರೊನನೆ, ‘ತಾರಿ ಲಾಕ್ಡಿ ಉಚೈನ ಜಿಮಿನನಾ ಧೂಳನೆ ಮಾರ, ತೆಳಾಮಾ ಐಗುಪ್ತ ದೆಶಮಾ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಧೂಳ ಪುರಾ ಜುವೊ ಥಾವಸ” ಕದ್ಯೊ. <verse eid="EXO 8:16" /><verse number="17" style="v" sid="EXO 8:17" />ತ್ಯುನೆ ತಿಮ್ಮಜ಼ ಕರ‍್ಯಾ. ಆರೊನ ಲಾಕ್ಡಿಲಿನ ಉಚೈನ ಜಿಮಿನನಾ ಧೂಳನೆ ಮಾರ‍್ಯೊ. ತೆಳಾಮಾ ಮನಕ್ಹೊಪರಬಿ, ಪಶುವೊಪರಬಿ ಜುವೊ ಆಯಾ. ಐಗುಪ್ತ ದೆಶನಾ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಧೂಳ ಪುರಾ ಜುವೊ ಥೈ ಗಯಾ. <verse eid="EXO 8:17" /><verse number="18" style="v" sid="EXO 8:18" />ತೆನೈಸೊ ಮಾಟಾಮಂತ್ರಾ ಕರಾಲಾ ತ್ಯುನಾ ಮಂತ್ರೊಕ್ಹು ತಿನಾ ಲಿಂಗತ ಜುವೊ ಕರಾನೆ ಗಯಾ ತ್ಯುನೊಕನ ಥಯು ನೈ. ತೆ ಜುವೊ ಮನಕ್ಹೊಪರಬಿ ಪಶುವೊಪರಬಿ ವ್ಹತ್ತಾ. <verse eid="EXO 8:18" /><verse number="19" style="v" sid="EXO 8:19" />ತೆಳಾಮಾ ತೆ ಮಾಟಾಮಂತ್ರಾ ಕರಾಲಾ ಫರೊಹನನೆ, "ಆಂ ಕ್ಹುದಾನು ಕಾಮ ವ್ಹೈ” ಕೈನ ಕದ್ಯಾ. ತೆನೈಸೊ ಫರೊಹನನು ಮನಸ ಮಂಡ ವ್ಹತ್ತು. ಯಹೊವಾ ಮೊಶೆನೆ ಪೈಲಾಜ ಕದಲ ತಿಮ್ಮಜ಼ ಫರೊಹನ ತ್ಯುನಿ ವಾತ ಐಕ್ಯೊ ನೈ.<verse eid="EXO 8:19" /></para>
  <para style="s">ಮಾಕ್ಕಿಯೊ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20" />ತೆ ಥಯಲ್ಪರ ಯಹೊವಾ ಮೊಶೆನೆ, "ತು ಪಾಟೆ ಉಟಿನ ಫರೊಹನನಾ ಕ್ಹಾಮೊ ಗೈನ ಹುಬ್ರೆ. ತೆ ನದಿಕನ ಆವಸ. ತೆ ನದಿಕನ ಆಯಲ್ಪರ ತು ತಿನೆ ಅಮ್ಮ ಕೌ, ‘ಯಹೊವಾ ಸು ಕವಸ ಕದ್ಯಾಮ, ಮನೆ ಆರಾಧನಾ ಕರಾನೆ ಮಾರಾ ಮನಕ್ಹೊನೆ ಇಜಾಜ಼ತ ದ್ಯು. <verse eid="EXO 8:20" /><verse number="21" style="v" sid="EXO 8:21" />ತೆನೈಸೊ ತು, ಮಾರಾ ಮನಕ್ಹೊನೆ ಜಾ಼ವಾನೆ ನೈ ದಿದ್ಯಾರೆ, ಮಿ ತುನೆಬಿ ತುಮಾರಾ ಅದಿಕಾರಿಯೊನೆಬಿ, ತುಮಾರಾ ಘರೊಮಾಬಿ ಮಾಕ್ಕಿಯೊಕ್ಹು ತ್ರಾಸ ದ್ಯುಸ. ಐಗುಪ್ತ ದೆಶನಾ ಮನಕ್ಹೊನಾ ಘರೊಮಾಬಿ ತ್ಯುನಾ ಜಿಮಿನೊಪರಬಿ ಕ್ಹಾಲಿ ತೆ ಮಾಕ್ಕಿಯೊಜ಼ ರ‍್ಹವಸ ಕೈನ ಹುಶಾರ್ಕಿ ಕರಾಡೊಸ. <verse eid="EXO 8:21" /><verse number="22" style="v" sid="EXO 8:22" />ತೆನೈಸೊ ತೆ ದಿನೊಮಾ ಮಿಜ಼಼, ಆಂ ಪುರಾ ದುನಿಯಾಮಾ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತಿಳ್ದಿಲಿವಾನಾ ಹುತಿ ಮಾರಾ ಮನಕ್ಹೊ ರ‍್ಹವಾನಿ ಜ಼ಗಾ ಗೊಷೆನ ಬಿಜೊ಼ ಕರುಸ. ತ್ಯಾ ತೆ ಮಾಕ್ಕಿಯೊನು ತ್ರಾಸ ನೈ ರ‍್ಹತು. <verse eid="EXO 8:22" /><verse number="23" style="v" sid="EXO 8:23" />ಅಮ್ಮ ತಾರಾ ಮನಕ್ಹೊಮಾಬಿ ಮಾರಾ ಮನಕ್ಹೊಮಾಬಿ ಫರಕ ತುನೆ ದೆಕಾಡಿನ ದ್ಯುಸ. ವಂತಾಜ಼ ಆಂ ಮ್ಹೊಟು ಕಾಮ ಥಾವಸ ಕೈನ ಕೌ” ಕದ್ಯೊ. <verse eid="EXO 8:23" /><verse number="24" style="v" sid="EXO 8:24" />ಯಹೊವಾ ಮ್ಹೊಟಾ ಮಾಕ್ಕಿಯೊನೆ ಫರೊಹನನಾ ರಾಜ ಮಹಲಮಾಬಿ, ತಿನಾ ಅದಿಕಾರಿಯೊನಾ ಘರೊಮಾಬಿ ವಳಾಯೊ ಪುರಾ ಐಗುಪ್ತ ದೆಶಮಾ ತೆ ಮಾಕ್ಕಿಯೊಕ್ಹು ತೆ ದೆಶ ಹಾಳ ಥೈ ಗಯು. <verse eid="EXO 8:24" /><verse number="25" style="v" sid="EXO 8:25" />ತೆಳಾಮಾ ಫರೊಹನ ಮೊಶೆನೆ ವರಿ ಆರೊನನೆ ಬಲೈನ ತ್ಯುನೊನೆ, "ತುಮೆ ಗೈನ ಆಂ ದೆಶಮಾ ತುಮಾರಾ ಕ್ಹುದಾನೆ ಯಜ್ಞ ಕರೊ” ಕದ್ಯೊ. <verse eid="EXO 8:25" /><verse number="26" style="v" sid="EXO 8:26" />ತೆ ವಾತೆ ಮೊಶೆ, "ತಿಮ್ಮ ಕರಾನು ಚೊ಼ಕು ನವೈ, ಹಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಯಜ್ಞ ಕರಾನು ಐಗುಪ್ತ ದೆಶನಾ ಮನಕ್ಹೊನೆ ಚೊ಼ಕು ನೈ ಲಾಗತು. ತ್ಯುನೊನೆ ಚೊ಼ಕು ನೈ ಲಾಗಾನು ಕಾಮ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಕರ‍್ಯಾರೆ ತ್ಯುನೆ ಹಮೊನೆ ದಗ್ಡಾ ನಾಕಿನ ಮಾರಿ ಪಡ್ತಾನೈಸು? <verse eid="EXO 8:26" /><verse number="27" style="v" sid="EXO 8:27" />ಹಮೆ ರಾನಮಾ ತನ್ನ ದಿನ ಲಕ್ಕಾ ದುರ ಚಾ಼ಲಿನ ಗೈನ ಹಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಆಗನ್ಯಾ ದಿದಲ ತಿಮ್ಮಜ಼ ಯಜ್ಞ ಕರು” ಕದ್ಯೊ. <verse eid="EXO 8:27" /><verse number="28" style="v" sid="EXO 8:28" />ತೆ ವಾತೆ ಫರೊಹನ ತ್ಯುನೊನೆ, "ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ರಾನ್ಮಾ ಗೈನ ಯಜ್ಞ ಕರಾನೆ ಮಿ ತುಮೊನೆ ಇಜಾಜ಼ತ ದ್ಯುಸ. ತೆನೈಸೊ ತುಮೆ ಜಾಸ್ತಿ ದುರ ಜೌ಼ ನೈ. ಮಾರಾಹುತಿ ಪ್ರಾರ್ಥನಾ ಕರೊ” ಕದ್ಯೊ. <verse eid="EXO 8:28" /><verse number="29" style="v" sid="EXO 8:29" />ತೆ ವಾತೆ ಮೊಶೆ, "ಮಿ ತುಕಂತೊ ಗಯಲ ಬರಬ್ಬರಜ಼, ಫರೊಹನ ಥಯಲ ತುನೆಬಿ, ತಾರಾ ಅದಿಕಾರಿಯೊನೆಬಿ ಮಾಕ್ಕಿಯೊನು ತ್ರಾಸ ವಂತಾತು ರ‍್ಹೌ ನೈ ಕೈನ ಮಿ ಯಹೊವಾಕನ ಪ್ರಾಥನಾ ಕರುಸ. ತೆನೈಸೊ ತು ಯಹೊವಾನೆ ಯಜ್ಞ ಕರಾನೆ ಜಾ಼ವಾನಾಹುತಿ ಹಮೊನೆ ಮೊಸ ಕರು ನೈ” ಕದ್ಯೊ. <verse eid="EXO 8:29" /><verse number="30" style="v" sid="EXO 8:30" />ಮೊಶೆ ಫರೊಹನ ಕಂತೊ ಗೈನ ಯಹೊವಾನೆ ಮಾಂಗಿಲಿದ್ಯೊ. <verse eid="EXO 8:30" /><verse number="31" style="v" sid="EXO 8:31" />ಮೊಶೆ ಪ್ರಾರ್ಥನಾ ಕರಲ ಲಿಂಗತ ಯಹೊವಾ ಕರ‍್ಯೊ. ತೆ ಮಾಕ್ಕಿಯೊ ಫರೊಹನ ಕಂತಾಬಿ ತಿನಾ ಅದಿಕಾರಿಯೊಕಂತಾಬಿ ತಿನಾ ಮನಕ್ಹೊಕಂತಾಬಿ ಗೈ ಪಡ್ಯಾ. ಯಕ್ಕಬಿ ಮಾಕ್ಕಿ ವಾಚಿ ನೈ. <verse eid="EXO 8:31" /><verse number="32" style="v" sid="EXO 8:32" />ತೆನೈಸೊ ಎ ಸಲಾಬಿ ಫರೊಹನ ತಿನು ಮನಸ ಮಂಡ ಕರಲಿನ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನೆ ಜಾ಼ವಾನೆ ದಿದ್ಯೊ ನೈ.<verse eid="EXO 8:32" /></para>
  <chapter eid="EXO 8" />
  <chapter number="9" style="c" sid="EXO 9" />
  <para style="s">ಜಾನವರೊನು ಮರಣ</para>
  <para style="m">
    <verse number="1" style="v" sid="EXO 9:1" />ತೆ ಥಯಲ್ಪರ ಯಹೊವಾ ಮೊಶೆನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ, "ತು ಫರೊಹನಕನ ಗೈನ ತಿನೆ, ‘ಇಬ್ರಿಯವಾಲಾವೊನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ತಿನೆ ಆರಾಧನಾ ಕರಾನಾಹುತಿ ತಿನಾ ಮನಕ್ಹೊನೆ ತು ಇಜಾಜ಼ತ ದ್ಯು ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 9:1" /><verse number="2" style="v" sid="EXO 9:2" />ತು ಹಜಿಬಿ ತ್ಯುನೊನೆ ಜಾ಼ವಾನೆ ದಿದ್ಯಾ ಬಗರ ಹುಬ್ರಾಡ್ಯೊರೆ, <verse eid="EXO 9:2" /><verse number="3" style="v" sid="EXO 9:3" />ಯಹೊವಾ ತುಮಾರಾ ಹರಯಕ್ಕ ಜಾನ್ವರೊನೆ, ಘೊಡೊ, ಗದಡು, ಉಂಟ, ಬೈಲೊ, ಬಕ್ರಾ ಆಂ ಕ್ಹಾರಾವೊಪರ ತಿನೊ ಹತ ಉಚೈನ ತ್ಯುನೊನೆ ಮ್ಹೊಟೊ ರೊಗ ಆವಾಲಗಾಡಸ ಕೈನ ತು ತಿಳ್ದಿಲೆ. ಇಮ್ಮ ಕರಿನ ಮಿ ತುಮೊನೆ ಶಿಕ್ಷಾ ದ್ಯುಸ. <verse eid="EXO 9:3" /><verse number="4" style="v" sid="EXO 9:4" />ಮಿ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನಾ ಜಾನ್ವರೊನೆಬಿ ಐಗುಪ್ತನಾ ಮನಕ್ಹೊನಾ ಜಾನ್ವರೊನೆಬಿ ಫರಕ ಕರ‍್ಯೊ. ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನು ಯಕ್ಕ ಜಾನ್ವರಬಿ ಮರತು ನೈ ಕೈನ ಕೌ” ಕದ್ಯೊ. <verse eid="EXO 9:4" /><verse number="5" style="v" sid="EXO 9:5" />ತೆನೈಸೊ ಯಹೊವಾ, "ತಿನೆಜ಼ ಕೈನ ಟೈಮ ಕಾಡಿನ, ವಂತಾಜ಼ ಆಂ ಕಾಮ ಆಂ ದೆಶಮಾ ಕರುಸ ಕೈನ ಕೆ” ಕದ್ಯೊ. <verse eid="EXO 9:5" /><verse number="6" style="v" sid="EXO 9:6" />ಮರ್ನಾ ದಿನ್ನೆ ಯಹೊವಾ ಆಂ ಕಾಮ ಥಾವಾ ವರಕ್ಹು ಕರ‍್ಯೊ. ಐಗುಪ್ತನಾ ಮನಕ್ಹೊನಾ ಪುರಾ ಜಾನ್ವರೊ ಮರಿ ಗಯಾ. ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನು ಯಕ್ಕಬಿ ಜಾನ್ವರ ಮರ‍್ಯು ನೈ. <verse eid="EXO 9:6" /><verse number="7" style="v" sid="EXO 9:7" />ಫರೊಹನ ಸು ಥಯು ಕೈನ ಪುಚ಼ತಾಮಾ, ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನು ಯಕ್ಕಬಿ ಜಾನ್ವರ ಮರ‍್ಯು ನತ್ತಿ ಕೈನ ತಿಳ್ದಿಲಿದ್ಯೊ. ತಿಮ್ಮ ರ‍್ಹಯುತಬಿ ತೆ ತಿನು ಮನಸ ಮಂಡ ಕರಲಿದಲ ಹುತಿ ತೆ ಮನಕ್ಹೊನೆ ತೆ ಜಾ಼ವಾನೆ ದಿದ್ಯೊ ನೈ.<verse eid="EXO 9:7" /></para>
  <para style="s">ಉಕ್ಳಸ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8" />ಯಹೊವಾ ಮೊಶೆನೆ ವರಿ ಆರೊನನೆ, "ತುಮೆ ಚು಼ಲ್ಲಾನಿ ರಾಕ ಹತ್ತ ಭರಿನ ಲಿವೊ. ಮೊಶೆ ತೆ ರಾಕನೆ ಫರೊಹನನಾ ಡೊಳಾನಾ ಕ್ಹಾಮೊ ವಾರಾಮಾ ನಾಕಾದೆ. <verse eid="EXO 9:8" /><verse number="9" style="v" sid="EXO 9:9" />ತೆಳಾಮಾ ತೆ ರಾಕ ಧುಳ ಥೈನ ಐಗುಪ್ತ ದೆಶಮಾ ಪುರಾ ಮನಕ್ಹೊಪರಬಿ ವರಿ ತ್ಯುನಾ ಜಾನ್ವರೊಪರಬಿ ಹರಿಯಾ ಫುಟಿನ ಮ್ಹೊಟಾ ಗುಮ್ಡಾ ಉಟಾ ವರಕ್ಹು ಕರಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 9:9" /><verse number="10" style="v" sid="EXO 9:10" />ತಿನಾ ಲಿಂಗತ ಮೊಶೆ ವರಿ ಆರೊನ ಚು಼ಲ್ಲಾಮಾನಿ ರಾಕ ಹತ್ಮಾ ಲಿನ ಫರೊಹನನಾ ಕ್ಹಾಮಾ ಹುಬ್ರಾಯಾ. ಮೊಶೆ ತೆ ರಾಕ ವಾರಾಮಾ ನಾಕ್ಯೊ. ತೆಳಾಮಾ ತೆ ರಾಕ ಐಗುಪ್ತನಾ ಮನಕ್ಹೊಪರಬಿ ತ್ಯುನಾ ಜಾನ್ವರೊ ಪರಬಿ ಹರಿಯಾ ಫುಟಿನ ಗುಮ್ಡಾ ಉಟಿನ ದುಕ್ಕ ಥಾವಾ ವರಕ್ಹು ಕರ‍್ಯು. <verse eid="EXO 9:10" /><verse number="11" style="v" sid="EXO 9:11" />ತೆನೈಸೊ ಮಾಟಾಮಂತ್ರಾ ಕರಾಲಾ ಹರಿಯಾನಾ ತ್ರಾಸಕ್ಹು ಮೊಶೆನಾ ಕ್ಹಾಮಾ ಹುಬ್ರಾವಾನೆ ಥಾಯೆ ನೈಸೊ ಗಯಾ. ಕಾಕದ್ಯಾಮ ಹರಿಯಾ ಮಾಟಾಮಂತ್ರಾ ಕರಾಲಾವೊಪರಬಿ ವರಿ ಐಗುಪ್ತನಾ ಮನಕ್ಹೊಪರಬಿ ಉಟ್ಯಾತಾ. <verse eid="EXO 9:11" /><verse number="12" style="v" sid="EXO 9:12" />ಆಂ ಕ್ಹಾರು ಥಯುತಬಿ ಯಹೊವಾ ಮೊಶೆನೆ ಕದಲ ತಿಮ್ಮಜ಼ ಥಯು. ಯಹೊವಾ ಫರೊಹನನು ಮನಸ ಮಂಡ ಕರಲಹುತಿ ತೆ ತ್ಯುನಿ ವಾತನೆ ಕಾನ ದಿದ್ಯಾ ಬಗರ ರ‍್ಹಯೊ.<verse eid="EXO 9:12" /></para>
  <para style="s">ಬರಪನು ಪಾನಿ</para>
  <para style="m">
    <verse number="13" style="v" sid="EXO 9:13" />ತೆ ಥಯಲ್ಪರ ಯಹೊವಾ ಮೊಶೆನೆ, "ತು ಪಾಟೆ ಉಟಿನ ಫರೊಹನನಾ ಕ್ಹಾಮೊ ಹುಬ್ರೈನ ತಿನೆ, ‘ಇಬ್ರಿಯನಾ ಮನಕ್ಹೊನೆ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಸು ಕವಸ ಕದ್ಯಾಮ, ಮನೆ ಆರಾದನೆ ಕರಾನೆ ಮಾರಾ ಮನಕ್ಹೊನೆ ಇಜಾಜ಼ತ ದೆ. <verse eid="EXO 9:13" /><verse number="14" style="v" sid="EXO 9:14" />ಹಮ್ನಾ ಮಿ ಸು ಕರುಸ ಕದ್ಯಾಮ ಮಾರಾ ಹತ್ಮಾ ರ‍್ಹಯಲ ತ್ರಾಸ ತಾರಾ ಮನಕ್ಹೊನೆ ವರಿ ಅದಿಕಾರಿಯೊನೆ ಆವಾ ವರಕ್ಹು ಕರುಸ, ತುನೆಬಿ ಶಿಕ್ಷಾ ದ್ಯುಸ. ತಿನಾಹುತಿ ಆಂ ಪುರಾ ದುನಿಯಾಮಾಜ ಮಾರಾ ಲಿಂಗತ ಕುನ್ನ ನತ್ತಿ ಕೈನ ತು ತಿಳ್ದಿಲೆಶಿ. <verse eid="EXO 9:14" /><verse number="15" style="v" sid="EXO 9:15" />ಮಿ ತುನೆ ವರಿ ತಾರಾ ಮನಕ್ಹೊನೆ ರೊಗೊಕ್ಹು ಮಾರಾನೆ ಮಾರೊ ಹತ್ತ ಉಚಾಯೊಮ ತುಮೆ ಪುರಾ ತರಾ ನಾಶ ಥಾವೊಶಿ. <verse eid="EXO 9:15" /><verse number="16" style="v" sid="EXO 9:16" />ತೆನೈಸೊ ತುನೆ ಮಾರಿ ತಾಕತ ದೆಕಾಡಿನ ದಿವಾನಾ ಹುತಿಜ಼, ಆಂ ದುನಿಯಾಮಾ ಮಾರು ನಾಮ ಪುರಾ ಮನಕ್ಹೊನೆ ಗ್ವತ್ತ ಥಾವಾನಾ ಹುತಿಜ಼ ಹಜು಼ನಲಕ್ಕಾ ತುನೆ ಜಿವ್ತೊ ಮುಕ್ಯೊಸ. <verse eid="EXO 9:16" /><verse number="17" style="v" sid="EXO 9:17" />ತೆನೈಸೊ ತುಮೆ ಸೊಕ್ಕನಾ ರ‍್ಹಯಲಕ್ಹು ಮಾರಾ ಮನಕ್ಹೊನೆ ಜಾ಼ವಾನೆ ದಿವಾಡಾ ನತ್ತಿ? <verse eid="EXO 9:17" /><verse number="18" style="v" sid="EXO 9:18" />ತಿಮ್ಮ ರ‍್ಹಯಾರೆ, ವಂತಾ ಆಂಜ಼ ವಕ್ಹತಮಾ ಘನ್ನೊ ಜೊ಼ರ ಬರಪನು ಪಾನಿ ಹಬಾಳಮಾತೊ ಆವಾ ಲಗಾಡುಸ. ಐಗುಪ್ತ ದೆಶ ಕೆಳಾಮಾತು ಥಯುಸ ತೆಳಾಮಾತು ಹಜು಼ನ ಲಕ್ಕಾ ತ್ಯವು ಬರಪನು ಪಾನಿ ಪಡಲ ತುಮೆ ದೆಕಲಜ಼ ರ‍್ಹೌ ನೈ ತ್ಯವು ಪಾನಿ ಆವಾ ಲಗಾಡುಸ. <verse eid="EXO 9:18" /><verse number="19" style="v" sid="EXO 9:19" />ತಿನಾಹುತಿ ತುಮೆ ತುಮಾರಾ ಗುಲಾಮೊನೆ ವಳೈನ ತುಮಾರಾ ಖೆತ್ರೊಮಾ ರ‍್ಹಯಲ ಹರಯಕ್ಕ ಜಾನ್ವರನೆ ಲಿನ ತುಮಾರಾ ಘರೊಮಾ ಘಟ್ಟ ಜ಼ಗಾವೊಮಾ ಹುಬ್ರಾಡೊ, ಕುನ್ನ ತೆ ದಿನ್ನೆ ಘರಮಾ ರ‍್ಹವಾನು ಛೊಡಿನ ಭಾರು ರ‍್ಹವಸ ತೆ ಮನಕ್ಹ ತೆ ಜಾನ್ವರ ಬರಪನಾ ಪಾನಿ ಮಾರಕ್ಹುಜ ಮರಿ ಜಾ಼ವಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 9:19" /><verse number="20" style="v" sid="EXO 9:20" />ತೆಳಾಮಾ ಫರೊಹನನಾ ಅದಿಕಾರಿಯೊ ಕುನ್ನ ಕುನ್ನ ಯಹೊವಾನಿ ವಾತ ಐಕಿನ ಬುಚ಼ಕ್ಯಾ ತ್ಯುನೆ ತ್ಯುನಾ ಗುಲಾಮೊನೆಬಿ ವರಿ ತ್ಯುನಾ ಜಾನ್ವರೊನೆಬಿ ಘರಮಾ ಝಾಕಿನ ಮ್ಹೆಲ್ಯಾ. <verse eid="EXO 9:20" /><verse number="21" style="v" sid="EXO 9:21" />ಕುನ್ನ ಯಹೊವಾನಿ ಹುಶಾರ್ಕಿನೆ ಐಕ್ಯಾ ಬಗರ ವ್ಹತ್ತಾ ತ್ಯುನೆ ತ್ಯುನಾ ತ್ಯುನಾ ಜಾನ್ವರೊನೆ ಗುಲಾಮೊನೆ ತಿಮ್ಮಜ಼ ಭಾರಾ ಛೊಡ್ಯಾ. <verse eid="EXO 9:21" /><verse number="22" style="v" sid="EXO 9:22" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆನೆ, "ಹಬಾಳಕನ ತಾರೊ ಹತ್ತ ಉಚಾ, ತೆಳಾಮಾ ಐಗುಪ್ತ ದೆಶನಾ ಮನಕ್ಹೊಪರಬಿ ವರಿ ತ್ಯುನಾ ಜಾನ್ವರೊಪರಬಿ, ಖೆತರಮಾ ರ‍್ಹಯಲ ಪುರಾ ಅನಾಜಪರ ಬರಪನಾ ಮ್ಹೊಟಾ ಹೆಂಟಾ ಪಡಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 9:22" /><verse number="23" style="v" sid="EXO 9:23" />ತೆಳಾಮಾ ಮೊಶೆ ತಿನಿ ಲಾಕ್ಡಿ ಹಬಾಳಕನ ಉಚಾತಾಮಾ ಯಹೊವಾ ಬಿಜಿಲಿನೆ ವರಿ ಬರಪನಾ ಪಾನಿನೆ ವಳಾಯೊ. ಬಿಜಲಿ ಜಿಮಿನನೆ ಮಾರಿ. ಯಹೊವಾ ಐಗುಪ್ತ ದೆಶನಾ ಉಪ್ಪರ ಬರಪನು ಪಾನಿ ಆವಾಲಗಾಡ್ಯೊ. <verse eid="EXO 9:23" /><verse number="24" style="v" sid="EXO 9:24" />ತೆ ಬರಪನು ಪಾನಿ ಘನ್ನು ಜೊ಼ರ ಆವಾಡುತು. ತಿನಾ ಕ್ಹಾತೆ ಬಿಜಿಲಿಬಿ ಘನ್ನಿ ಮಾರಾಡಿತಿ. ಐಗುಪ್ತ ದೆಶಮಾ ಹಜು಼ನ ಲಕ್ಕಾ ತ್ಯವು ಬರಪನು ಪಾನಿ ಥಯು ನ್ಹೊತು. <verse eid="EXO 9:24" /><verse number="25" style="v" sid="EXO 9:25" />ತೆ ಬರಪನಾ ಪಾನಿಕ್ಹು ಐಗುಪ್ತ ದೆಶಮಾ ಹರಯಕ್ಕ ಜ಼ಗಾ ಭಾರಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ಜಾನ್ವರೊ ಮರಿ ಗಯಾ. ವರಿ ಖೆತರಮಾ ರ‍್ಹತಾಮಾ ತಿಮ್ಮ ಛೊಡಲ ಅನಾಜ ಕ್ಹಾರು ಹಾಳ ಥೈ ಗಯು. ಖೆತರೊಮಾ ರ‍್ಹಯಲ ಝಾಡೊ ಪುರಾ ಪಡಿ ಗಯಾ. <verse eid="EXO 9:25" /><verse number="26" style="v" sid="EXO 9:26" />ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊ ರ‍್ಹಯಲ ಗೊಷೆನ ಗಾಮ ಯಕ್ಕಜ಼ ಬರಪನು ಪಾನಿ ಪಡ್ಯು ನೈ. <verse eid="EXO 9:26" /><verse number="27" style="v" sid="EXO 9:27" />ತೆಳಾಮಾ ಫರೊಹನ ಮೊಶೆ ವರಿ ಆರೊನನೆ ಬಲೈನ ತ್ಯುನೊನೆ, "ಮಿ ತಪ್ಪ ಕರ‍್ಯೊಸ ಕೈನ ಹಮ್ನಾ ಮಿ ಒಪ್ಪಿಲ್ಯುಸ. ಯಹೊವಾ ಕರೆಟ್ಟ ಫೈಸಲೊ ಕರಾಲೊ ವ್ಹೈ. ಮಿ ಮಾರಾ ಮನಕ್ಹೊ ತಪ್ಪ ಕರಲವಾಲಾ ವ್ಹೈ. <verse eid="EXO 9:27" /><verse number="28" style="v" sid="EXO 9:28" />ಆಂ ಖತರನಾಕ ಬಿಜಲಿ ವರಿ ಬರಪನು ಪಾನಿ ಘನ್ನು ಜಾಸ್ತ ಥಯುಸ. ಎ ಕ್ಹಾರು ಹುಬ್ರಾಡ ಕೈನ ಯಹೊವಾನೆ ಪ್ರಾರ್ಥನಾ ಕರೊ ತುಮೊನೆ ಆಂ ದೆಶತೊ ಜಾ಼ವಾನಾ ಹುತಿ ತುಮೊನೆ ಇಜಾಜ಼ತ ದ್ಯುಸ. ಹಮ್ನಾ ಮಿ ತುಮೊನೆ ಹುಬ್ರಾಡತೊ ನೈ” ಕದ್ಯೊ. <verse eid="EXO 9:28" /><verse number="29" style="v" sid="EXO 9:29" />ತೆ ವಾತೆ ಮೊಶೆ, "ಮಿ ಆಂ ಜ಼ಗಾತೊ ಗಯಲ್ಪರ ಹತ್ತ ಉಚೈನ ಯಹೊವಾಕನ ಪ್ರಾರ್ಥನಾ ಕರುಸ. ತೆಳಾಮಾ ಬಿಜಿಲಿ ವರಿ ಬರಪನು ಪಾನಿ ಹುಬ್ರೈ ಪಡಸ. ತಿನಾಕ್ಹು ತು ಆಂ ಪುರಾ ದುನಿಯಾಜ ಯಹೊವಾನಾ ಹತ್ಮಾ ಶೆ ಕೈನ ತಿಳ್ದಿಲೆಶಿ. <verse eid="EXO 9:29" /><verse number="30" style="v" sid="EXO 9:30" />ತೆನೈಸೊ ಆಂ ಕ್ಹಾರು ಥಯುತಬಿ ತು ವರಿ ತಾರಾ ಅದಿಕಾರಿಯೊ ಯಹೊವಾನೆ ನೈ ಬುಚ್ಕಿ಼ನ ರ‍್ಹತಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ಛೆ” ಕದ್ಯೊ. <verse eid="EXO 9:30" /><verse number="31" style="v" sid="EXO 9:31" />ಜವೆ ಘೌ ವರಿ ಅಗಸೆ ಹಾಳ ಥೈ ಗಯುತು. ಕಾಕದ್ಯಾಮ ಜವೆ ಘೌ ಮೊಳಕೆ ಛೊಡ್ಯುತು, ಅಗಸೆ ಮೊಗ್ಗ ಛೊಡ್ಯುತು. <verse eid="EXO 9:31" /><verse number="32" style="v" sid="EXO 9:32" />ತೆನೈಸೊ ಘೌ ವರಿ ಕಡಲೆ ತೆ ಜುನ್ನು ಅನಾಜ ರ‍್ಹಯಲ ಹುತಿ ತೆ ಹಾಳ ಥಯಾ ನೈ. <verse eid="EXO 9:32" /><verse number="33" style="v" sid="EXO 9:33" />ಮೊಶೆ ಫರೊಹನ ಕಂತೊ ತೆ ಜ಼ಗಾತೊ ಐನ ಯಹೊವಾಕನ ಹತ್ತ ಉಚೈನ ಪ್ರಾರ್ಥನಾ ಕರ‍್ಯೊ. ತೆಳಾಮಾ ತೆ ಬಿಜಿಲಿ ಬರಪನು ಪಾನಿ ಹುಬ್ರೈ ಗಯು. <verse eid="EXO 9:33" /><verse number="34" style="v" sid="EXO 9:34" />ತೆನೈಸೊ ತೆ ಬರಪನು ಪಾನಿ ವರಿ ಬಿಜಿಲಿ ಹುಬ್ರಯಲ ಫರೊಹನ ದೆಕಿನ ತೆ ವರಿ ತಿನಾ ಅದಿಕಾರಿಯೊ ತ್ಯುನು ಮನಸ ಹಜು಼ನ ಮಂಡ ಕರಲಿನ ವರಿ ಪಾಪ ಕರ‍್ಯಾ. <verse eid="EXO 9:34" /><verse number="35" style="v" sid="EXO 9:35" />ಯಹೊವಾ ಮೊಶೆನೆ ಕದಲ ತಿಮ್ಮಜ಼ ಥಯು. ಫರೊಹನ ತಿನು ಮನಸ ಮಂಡ ಕರಲಿನ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನೆ ಜಾ಼ವಾನೆ ದಿದ್ಯೊ ನೈ.<verse eid="EXO 9:35" /></para>
  <chapter eid="EXO 9" />
  <chapter number="10" style="c" sid="EXO 10" />
  <para style="s">ಚಿಡ್ಡಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 10:1" />ತೆ ಥಯಲ್ಪರ ಯಹೊವಾ ಮೊಶೆನೆ, "ಫರೊಹನಕನ ಫರಿನ ವರಿ ಜಾ಼. ಮಿ ಫರೊಹನ ವರಿ ತಿನಾ ಅದಿಕಾರಿಯೊನು ಮನಸ ಮಂಡ ಕರ‍್ಯೊಸ. ಕಾಕದ್ಯಾಮ ಮಿ ತ್ಯುನಾ ಕ್ಹಾಮೊ ಅದ್ಬುತ ಕಾಮೊ ಕರಾನಾ ಹುತಿ . <verse eid="EXO 10:1" /><verse number="2" style="v" sid="EXO 10:2" />ಮಿ ಅದ್ಬುತೊ ಕರ್ತಾಮಾ ಮಿ ಐಗುಪ್ತವಾಲಾವೊನೆ ಕಿಮ್ಮ ಪಿಸಾಳಾ ಕರ‍್ಯೊ ಕೈನ ತುಮಾರಾ ಬಚ್ಚಾ಼ವೊನೆ, ತುಮಾರಾ ನಾತನಾ ನಾತನಿಯೊನೆ ಕವಾನೆ ತುಮೊನೆ ಸಾದ್ಯ ಥಾವಾಸ. ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೆ ಕ್ಹಾರಾ ತಿಳ್ದಿಲಿವೊಶಿ” ಕದ್ಯೊ. <verse eid="EXO 10:2" /><verse number="3" style="v" sid="EXO 10:3" />ತೆಳಾಮಾ ಮೊಶೆ ವರಿ ಆರೊನ ಫರೊಹನಕನ ಗೈನ ತಿನೆ, "ಇಬ್ರಿಯವಾಲಾವೊನೊ ಕ್ಹುದಾ ಯಹೊವಾ ಸು ಕವಸ ಕದ್ಯಾಮ, "ತು ಹಜು ಮಾರಾ ಕ್ಹಾಮೊ ಡೊಗ್ಯಾ ಬಗರ ರ‍್ಹವಾನು ಕೆಳಕ್ಕಾ ವ್ಹೈ? ಮನೆ ಆರಾದನಾ ಕರಾನಾ ಹುತಿ ಮಾರಾ ಮನಕ್ಹೊನೆ ಜಾ಼ವಾನೆ ದೆ. <verse eid="EXO 10:3" /><verse number="4" style="v" sid="EXO 10:4" />ಜಾ಼ವಾನೆ ನೈ ದಿದ್ಯಾರೆ ವಂತಾಜ಼ ತಾರಾ ದೆಶಮಾ ಚಿಡ್ಡಾ ಆವಾಲಗಾಡುಸ. <verse eid="EXO 10:4" /><verse number="5" style="v" sid="EXO 10:5" />ತೆ ತುಮಾರಿ ಪುರಾ ಜಿಮಿನಪರ ಫೈಲಿ ಜಾ಼ವಸ. ತುನೆ ಜಿಮಿನ ನೈ ದಿಕ್ಹತಿ. ಬರಪನಾ ಪಾನಿಕ್ಹು ಸು ಸು ಅನಾಜ ವಾಚುಸ ತೆ ಕ್ಹಾರು ಅನಾಜ ತೆ ಚಿಡ್ಡಾ ಖೈ ಪಡಸ. ತುಮಾರಾ ಖೆತರೊಮಾ ರ‍್ಹಯಲ ಹರಯಕ್ಕ ಝಾಡನು ಪಾಲ ವರಿ ಚಿಗ್ರಾನು ಪಾಲ ತೆ ಚಿಡ್ಡಾ ಖೈ ಪಡಸ. <verse eid="EXO 10:5" /><verse number="6" style="v" sid="EXO 10:6" />ತೆ ಚಿಡ್ಡಾ ತಾರಾ ಮಹೆಲಮಾಬಿ, ತಾರಾ ಮನಕ್ಹೊನಾ ಘರೊಮಾಬಿ, ಐಗುಪ್ತನಾ ಕ್ಹಾರಾ ಘರೊಮಾಬಿ ಭರಿಜಾ಼ವಸ. ತುಮಾರಾ ಪುರ್ವಿಕೊನಾ ಕಾಲತುಬಿ ಹಮ್ನಾ ಲಕ್ಕಾ ತ್ಯವಾ ಚಿಡ್ಡಾವೊನಾ ಗುಂಪನೆ ಕೆಳಾಬಿ ದೆಕ್ಯಾನೊತಾ" ಕೈನ ಕದ್ಯಾ. ಆ ಕೈನ ಮೊಶೆ ಫರಿನ ಫರೊಹನ ಕಂತೊ ಗೈ ಪಡೊ. <verse eid="EXO 10:6" /><verse number="7" style="v" sid="EXO 10:7" />ತೆಳಾಮಾ ಫರೊಹನನಾ ಅಧಿಕಾರಿಯೊ ತಿನೆ, "ಆಂ ಮನಕ್ಹ ಕೆಕ್ಲಾ ದಿನ್ನ ಅಪೊನೆ ತ್ರಾಸ ದಿವಸ? ತೆ ಮನಕ್ಹೊ ತ್ಯುನಾ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಆರಾದನಾ ಕರಾನಾಹುತಿ ಅಪ್ಪಣೆ ದೆ. ಐಗುಪ್ತ ದೆಶ ಹಾಳ ಥಯು ಕೈನ ಹಜಿ ತುನೆ ಗ್ವತ್ತ ಥಯು ನತ್ತಿ ಸು? ಕೈನ ಕದ್ಯಾ. <verse eid="EXO 10:7" /><verse number="8" style="v" sid="EXO 10:8" />ತೆ ಐಕಿನ ಫರೊಹನ, ಮೊಶೆ ವರಿ ಆರೊನನೆ ಫರಿನ ಬಲೈನ ತ್ಯುನೊನೆ, "ತುಮೆ ಗೈನ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಆರಾದನಾ ಕರ ಸಕೊಶಿ, ತೆನೈಸೊ ಕುನ ಕುನ ಜೌ಼ ಕೈನ ಛೆ? ಕೈನ ಪುಚ್ಯೊ. <verse eid="EXO 10:8" /><verse number="9" style="v" sid="EXO 10:9" />ಮೊಶೆ ತಿನೆ, "ಹಮೆ ಯಹೊವಾನೆ ಜತ್ರಾ ಕರು ಕೈನ ಛೆ. ತಿನಾಹುತಿ ನ್ಹಾನಾ ಮನಕ್ಹೊತಿ ಗಡಿಯಾ ಲಕ್ಕಾ ಕ್ಹಾರಾ ಜ಼ನಾ ಗಯೆಸ; ಗಂಡ ವರಿ ಹೆಣ್ಣ ಮನಕ್ಹೊನೆ, ಬೈಲೊ ಬಕ್ರಾನಾ ಗುಂಪನೆ ಲಿನ ಗಯೆಸ” ಕೈನ ಉತ್ತರ ದಿದ್ಯೊ. <verse eid="EXO 10:9" /><verse number="10" style="v" sid="EXO 10:10" />ಯಹೊವಾ ಪುರ್ವ ದಿಕ್ಕನಾ ವಾರಾನೆ ಘನಿ ಜೊರ ರ‍್ಹಯಲ ಪಚ್ಚಿಮ ದಿಕ್ಕನಾ ವಾರಾ ನಿಂಗತ ಬದಲಿ ಕರ‍್ಯೊ. ತೆ ಚಿಡ್ಡಾವೊನೆ ಉಚೈಲಿನ ಲಾಲ ಸಮುಂದರಮಾ ಪಾಡೆ ನಿಂಗತ ಕರ್xಯು. ಐಗುಪ್ತ ದೆಶಮಾ ಯಕ್ಕ ಚಿಡ್ಡೊಬಿ ಉಗ್ರ್ಯೊ ನೈ. <verse eid="EXO 10:10" /><verse number="11" style="v" sid="EXO 10:11" />ತುಮಾರಾಮಾ ಕ್ಹಾಲಿ ದಾಣ್ಗಾ ಗೈನ ಯಹೊವಾನೆ ಆರಾದನಾ ಕರಿನ ಆಸಕೊಶಿ. ತುಮೆ ಮಾಂಗಿಲಿದಲ ತೆಕ್ಲುಜ಼ ನವೈ ಸು? ಕೈನ ತ್ಯುನೊನೆ ಫರೊಹನ ತಿನಾ ಸನ್ನಿದಿತೊ ವಳೈಪಡ್ಯೊ. <verse eid="EXO 10:11" /><verse number="12" style="v" sid="EXO 10:12" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆನೆ, "ಐಗುಪ್ತ ದೆಶನಾ ಉಪ್ಪರ ತಾರೊ ಹತ್ತ ಉಚಾ, ಚಿಡ್ಡಾವೊನೆ ಆವಾಲಗಾಡ. ಬರಪನಾ ಪಾನಿಕ್ಹು ನಾಶ ಥಯಾವಾಚಿ ಉಗ್ರಲ ಪೈರನೆ ಚಿಡ್ಡಾ ಖಾವಾದೆ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 10:12" /><verse number="13" style="v" sid="EXO 10:13" />ಮೊಶೆ ತಿನಾ ಲಾಕ್ಡಿನೆ ಐಗುಪ್ತ ದೆಶಪರ ಉಚಾಯಲಪರ, ಯಹೊವಾ ಪಾಟೆಬಿ ರಾತೆ ಪುರ್ವ ದಿಕ್ಕತು ವಾರಾನೆ ಅವಾವರಕ್ಹೊ ಕರ‍್ಯೊ. ತೆ ಪಾಟನಾ ವಾರಾನಾ ಝೊಕಾಕ್ಹು ಚಿಡ್ಡಾ ಆಯಾತಾ. <verse eid="EXO 10:13" /><verse number="14" style="v" sid="EXO 10:14" />ಚಿಡ್ಡಾ ಕ್ಹಾರಾ ಐಗುಪ್ತ ದೆಶಮಾ ಐನ ಐಗುಪ್ತ ದೆಶನಾ ಕ್ಹಾರಿ ಜ಼ಗಾವೊಕನ ಘನ್ನಾ ಥೈನ ಉತ್ರ್ಯಾ. ತ್ಯವಾ ಚಿಡ್ಡಾವೊನು ಗುಂಪ ಪೈಲಾ ಐಯು ನ್ಹೊತು, ಅಗುಬಿ ಆವಾನೆ ಸಾದ್ಯ ನತ್ತಿ. <verse eid="EXO 10:14" /><verse number="15" style="v" sid="EXO 10:15" />ತೆ ಕ್ಹಾರಿ ಜಿಮಿನನೆ ಝಾಕಿ ಲಿದಲಕ್ಹು ಜಿಮಿನಬಿ ಝಕೈ ಗೈ. ಬರಪನಾ ಪಾನಿಕ್ಹು ನಾಶ ನೈ ಥಯಲ ಕ್ಹಾರಾ ಪೈರನೆ, ಝಾಡೊಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಫಲ್ಲನೆ ತೆ ಖೈ ಪಡ್ಯಾತಾ. ಐಗುಪ್ತನಾ ದೆಶಮಾ ಝಾಡೊ ನೈಸೊ ಥಾವಾದೆ, ಖೆತರನಾ ನ್ಹಾನಾ ಝಾಡೊಮಾ ರ‍್ಹಯಾತಬಿ ಹಸರ ರ‍್ಹಯಲ ಯಕ್ಕಬಿ ಉಗ್ರ್ಯು ನೈ. <verse eid="EXO 10:15" /><verse number="16" style="v" sid="EXO 10:16" />ತೆಳಾಮಾ ಫರೊಹನ, ಮೊಶೆ ವರಿ ಆರೊನನೆ ‍ಜಲ್ದಿ ಬಲೈನ , ಮಿ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ, ತುಮೊನೆ ವಿರುದ್ದ ಥೈನ ಪಾಪ ಕರ‍್ಯೊಸ. <verse eid="EXO 10:16" /><verse number="17" style="v" sid="EXO 10:17" />ತೆನೈಸೊ ಆಂ ಯಕ್ಕ ಸಲಾ ಮಾರಾ ಪಾಪೊನೆ ಮಾಫ ಕರೊ "ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಆಂ ಮರಣಕರ ಥಯಲ ತ್ರಾಸನೆ ಮಕಂತು ಜೌ಼ ಕೈನ ತಿನೆ ಪ್ರಾರ್ಥನಾ ಕರೊ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 10:17" /><verse number="18" style="v" sid="EXO 10:18" />ಮೊಶೆ ಫರೊಹನ ಕಂತೊ ಗೈನ ಯಹೊವಾನೆ ಪ್ರಾಥನಾ ಕರೊ. <verse eid="EXO 10:18" /><verse number="19" style="v" sid="EXO 10:19" />ಯಹೊವಾ ಪುರ್ವ ದಿಕ್ಕನಾ ವಾರಾನೆ ಜೊರ ಕರಿನ ಪಶ್ಚಿಮ ದಿಕ್ಕತೊ ಆಯೆ ಲಿಂಗತ ಕರ‍್ಯೊ. ತೆ ವಾರೊ ಚಿಡ್ಡವೊನೆ ಉಚೈಲಿನ ಗೈನ ಲಾಲ ಸಮಂದರಮಾ ಘಾಲಿಪಡ್ಯು. ಐಗುಪ್ತ ದೆಶಮಾ ಯಕ್ಕಬಿ ಚಿಡ್ಡೊ ಉಗ್ರ್ಯೊ ನೈ. <verse eid="EXO 10:19" /><verse number="20" style="v" sid="EXO 10:20" />ತೆಳಾಮಾ ಯಹೊವಾ ಫರೊಹನನು ಮನಸ ಕಟಿನ ಕರಲಕ್ಹು ತೆ ಇಸ್ರಾಯೆಲೊನೆ ಮೊಕಲಾನೆ ವಪ್ಯೊ ನೈ.<verse eid="EXO 10:20" /></para>
  <para style="s">ಮ್ಹೊಟು ಅಂದಾರು</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21" />ತೆ ಥಯಲ್ಪರ ಯಹೊವಾ ಮೊಶೆನೆ, "ಹಬಾಳಪರ ತಾರಾ ಹತ್ತನೆ ಉಚಾ. ತೆಳಾಮಾ ಐಗುಪ್ತ ದೆಶಮಾ ಕ್ಹಾರು ಅಂದಾರು ಥಾವಸ. ತೆ ಅಂದಾರಾಕ್ಹು ಮನಕ್ಹೊ ಗೊಡಿಯೊ ಮುಟ್ಟಿ ಮುಟ್ಟಿನ ಚಾ಼ಲಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 10:21" /><verse number="22" style="v" sid="EXO 10:22" />ಮೊಶೆ ಹಬಾಳಪರ ಹತ್ತ ಉಚಾಯಲಪರ ಐಗುಪ್ತ ದೆಶಮಾ ಕ್ಹಾರು ತನ್ನ ದಿನ್ನ ಮ್ಹೊಟಾ ಅಂದಾರಾಕ್ಹು ಝಕೈ ಗಯು. <verse eid="EXO 10:22" /><verse number="23" style="v" sid="EXO 10:23" />ತನ್ನ ದಿನ್ನ ಲಕ್ಕಾ ತ್ಯುನೆ ಯಕ್ಲಾನೆ ಯಕ್ಲೊ ದೆಕ್ಯೊ ನೈ. ಕುನಬಿ ತ್ಯುನಾ ಜ಼ಗಾಕಂತೊ ಉಟ್ಯೊಜ಼ ನೈ. ತೆನೈಸೊ ಇಸ್ರಾಯೆಲೊ ರ‍್ಹಯಲ ಜ಼ಗಾವೊಮಾ ಉಜಾಲು ವ್ಹತ್ತು. <verse eid="EXO 10:23" /><verse number="24" style="v" sid="EXO 10:24" />ತೆಳಾಮಾ ಫರೊಹನ ಮೊಶೆನೆ ಬಲೈನ, ತುಮೆ ಗೈನ ಯಹೊವಾನೆ ಆರಾದನಾ ಕರೊ. ತುಮಾರಾ ಘರವಾಲಾಬಿ ತುಮೆ ಜಾ಼ಸಕೊಸಿ. ತುಮಾರಾ ಬೈಲೊ ಬಕ್ರಾವೊನೆ ನ್ಹ್ಯಾಜ ಛೊಡಿನ ಜೌ಼” ಕದ್ಯೊ. <verse eid="EXO 10:24" /><verse number="25" style="v" sid="EXO 10:25" />ತಿನಾಹುತಿ ಮೊಶೆ, ಹಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಹಮೆ ಯಜ್ಞಹೊಮ ಕರಾನೆ ಚಾ಼ಯೆ ಥಯಲ ಕ್ಹಾರಾ ಪಶುವೊನೆ ಲಿನ ಜಾ಼ವಾನೆ ಹಮೊನೆ ಅಪ್ಪಣೆ ದ್ಯು. <verse eid="EXO 10:25" /><verse number="26" style="v" sid="EXO 10:26" />ಹಮಾರಾ ಕ್ಹಾರಾ ಪಶುವೊನೆ ಹಮಾರಾ ಕ್ಹಾತೆ ಬಲೈಲಿನ ಜ಼ೈಯೆಸ. ಯಕ್ಕಬಿ ಹಮೆ ಛೊಡಿನ ಜಾ಼ವಾನೆ ಥಾತು ನೈ; ತೆ ಪಶುವೊಕ್ಹು ಹಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಆರಾದನೆ ಕರುತೊ. ಕಯಾ ಪಶುವೊನೆ ದಿವ ಕವಾನು ಹಮೊನೆ ತ್ಯಾ ಗಯೆ ಲಕ್ಕಾ ಹಮೊನೆ ಸುಜ ಗ್ವತ್ತ ನತ್ತಿ ಕದ್ಯೊ. <verse eid="EXO 10:26" /><verse number="27" style="v" sid="EXO 10:27" />ತೆಳಾಮಾ ಯಹೊವಾ ಫರೊಹನನು ಮನಸನೆ ಕಟಿನ ಕರಲಕ್ಹು ತ್ಯುನೊನೆ ಅಪ್ಪಣೆ ದಿವಾನೆ ವಪ್ಯೊ ನೈ. <verse eid="EXO 10:27" /><verse number="28" style="v" sid="EXO 10:28" />ತೆಳಾಮಾ ಫರೊಹನ ಮೊಶೆನೆ, "ಮನೆ ಛೊಡಿನ ಜಾ಼. ಇತ್ತಿ ಉಪ್ಪರ ಮಾರು ಮ್ಹೊಡು ದೆಕೆವಾಚಿ ಎಚ್ಚರ ಥೈನ ರ‍್ಹೆ. ಕಾಕದ್ಯಾಮ ತು ಮಾರು ಮ್ಹೊಡಾನೆ ದೆಕಲ ದಿನ್ನೆಜ಼ ತು ಮರಶಿ!” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 10:28" /><verse number="29" style="v" sid="EXO 10:29" />ತಿನಾಹುತಿ ಮೊಶೆ, "ತು ಕರೆಟ್ಟ ಕದ್ಯೊ. ಹಮ್ನಾತೊ ಮಿ ತಾರು ಮ್ಹೊಡು ದೆಕ್ತೊಜ಼ ನೈ” ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 10:29" /></para>
  <chapter eid="EXO 10" />
  <chapter number="11" style="c" sid="EXO 11" />
  <para style="s">ಮೊಶೆಕ್ಹು ಪೈಲಾರ ದಿಕ್ರಾನಾ ಮರಣನಾಹುತಿ ಹುಶಾರ್ಕಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆನೆ, "ಫರೊಹನನೆ ವರಿ ಐಗುಪ್ತವಾಲಾವೊನೆ ಹಜಿಯಕ್ಕ ಮಿ ಉಪದ್ರವ ಆವಾ ಲಗಾಡುಸ. ತೆ ಆಯಲ್ಪರ ತೆ ತುಮೊನೆ ನ್ಹ್ಯಾಂತೊ ಜಾ಼ ಕೈನ ಅಪ್ಪಣೆ ದಿವಸ. ತೆ ತುಮೊನೆ ನ್ಹ್ಯಾಂತೊ ನ್ಹಟಾಡಸ. <verse eid="EXO 11:1" /><verse number="2" style="v" sid="EXO 11:2" />ತಿನಾಹುತಿ ದಾಣ್ಗಾ ಬಾಕ್ಡಿಯೊ ಕ್ಹಾರಾ ತ್ಯುನಾ ತ್ಯುನಾ ಆಜ಼ು಼ ಬಾಜು಼ವಾಲಾವೊಕ್ಹು ಕ್ಹೊನಾನಾ ರುಪ್ಪಾನಾ ಸಾಮನೊ ಮಾಂಗಿಲಿವ ಕೈನ ಮನಕ್ಹೊನೆ ಸ್ಪಷ್ಟ ಥೈನ ಕೆ” ಕದ್ಯೊ. <verse eid="EXO 11:2" /><verse number="3" style="v" sid="EXO 11:3" />ವರಿ ಯಹೊವಾ ಇಸ್ರಾಯೆಲೊನಾ ಉಪ್ಪರ ಐಗುಪ್ತವಾಲಾವೊಮಾ ಮರ್ಗಾ ಹುಟ್ಸಾ ಲಗಾಡ್ಯೊ. ತೆನೈಸೊ ಐಗುಪ್ತ ದೆಶಮಾ ಫರೊಹನನಾ ಪ್ರಜಾ ಪರಿವಾರವಾಲಾ ವರಿ ಮನಕ್ಹೊ ಮೊಶೆನೆ ಮಹಾ ಶ್ರೆಷ್ಠ ದಾಣ್ಗೊ ವ್ಹೈ ಕೈನ ನೆಮಸ್ಯಾ. <verse eid="EXO 11:3" /><verse number="4" style="v" sid="EXO 11:4" />ತೆಳಾಮಾ ಮೊಶೆ ಫರೊಹನನೆ, "ಯಹೊವಾ ಅಪ್ಪಣೆ ದಿವಾನು ಸುವೈ ಕದ್ಯಾಮ, ‘ಮಿ ಅರ್ದಿ ರಾತಮಾ ಐಗುಪ್ತನಾ ವಚ್ಮಾ ದಾಟಿನ ಜೌ಼ಸ. <verse eid="EXO 11:4" /><verse number="5" style="v" sid="EXO 11:5" />ತೆಳಾಮಾ ಸಿಂಹಾಸನಪರ ಬೈಟಲ ಫರೊಹನನೊ ಪೈಲಾರ ದಿಕ್ರೊಬಿ, ನಾಕಾನಾ ದಗ್ಡಾನಾ ಪಾಚಾ ಬೈಟಲ ದಾಸಿನಾ ಪೈಲಾರ ದಿಕ್ರಾ ಲಕ್ಕಾ ಐಗುಪ್ತ ದೆಶಮಾ ರ‍್ಹಯಲ ಪೈಲಾರ ಕ್ಹಾರಾ ಬಚ್ಚಾ ಮರಸ. ಪಶುವೊಮಾಬಿ ಪೈಲಾರ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಮರಸ. <verse eid="EXO 11:5" /><verse number="6" style="v" sid="EXO 11:6" />ತೆಳಾಮಾ ಪುರಾ ಐಗುಪ್ತ ದೆಶಮಾ ಮ್ಹೊಟು ಗೊಳಾಟ ಥಾವಸ. ತ್ಯವು ಗೊಳಾಟ ಹಜು಼ನ ಲಕ್ಕಾ ದೆಶಮಾ ಕೆಳಾಮಾಜ ಥಯು ನ್ಹೊತು. ಅಗುಬಿ ಥಾತು ನೈ. <verse eid="EXO 11:6" /><verse number="7" style="v" sid="EXO 11:7" />ತೆ ಥಯಲ್ಪರ ಐಗುಪ್ತವಾಲಾವೊನೆಬಿ ಇಸ್ರಾಯಲವಾಲಾವೊನೆಬಿ ಯಹೊವಾ ವ್ಯತ್ಯಾಸ ಕರ‍್ಯೊಸ ಕವಾನು ತುಮೊನೆ ತಿಳ್ದಾ ವರಕ್ಹು ಇಸ್ರಾಯೆಲೊಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮಾ ರ‍್ಹವಾದೆ, ಪಶುವೊನಾ ಕ್ಹಾಮಾ ರ‍್ಹವಾದೆ ಯಕ್ಕ ಕುತ್ರುಬಿ ವದರ್ತು ನೈ.’” <verse eid="EXO 11:7" /><verse number="8" style="v" sid="EXO 11:8" />ತೆಳಾಮಾ ತಾರಾ ಅದಿಕಾರಿಯೊ ಕ್ಹಾರಾ, ಮಕನ ಐನ ಅಡ್ಡ ಪಡಿನ, ತು ವರಿ ತಾರಾ ಅದಿನಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಹಮೊನೆ ಛೊಡಿನ ಜೌ಼’ ಕೈನ ಮಾಂಗಸ. ಪಾಚ಼ಲ್ತೊ ಮಿ ಗೈ ಪಡುಸ” ಕೈನ ಕದ್ಯೊ. ಮೊಶೆ ಆಂ ವಾತ ಕೈನ ಸಿಟ್ಟ ಥೈನ ಫರೊಹನನೆ ಛೊಡಿನ ಗೈ ಪಡ್ಯೊ. <verse eid="EXO 11:8" /><verse number="9" style="v" sid="EXO 11:9" />ಯಹೊವಾ ಮೊಶೆನೆ, "ಐಗುಪ್ತ ದೆಶಮಾ ಮಾರಾ ಮಹಾತ್ಕಾರ್ಯ ಹಜಿನ ಜಾಸ್ತ ಥಾವಾನಾಹುತಿ ಫರೊಹನ ತುಮಾರಿ ವಾತ ಐಕ್ತೊ ನೈ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 11:9" /><verse number="10" style="v" sid="EXO 11:10" />ಮೊಶೆ ವರಿ ಆರೊನ ಫರೊಹನನಾ ಕ್ಹಾಮಾ ತೆ ಕ್ಹಾರಾ ಮಹಾತ್ಕರ್ಯ ಕರ‍್ಯಾ. ತೆನೈಸೊ ಯಹೊವಾ ಫರೊಹನನಾ ಮನಸನೆ ಕಟಿನ ಕರಲಕ್ಹು ಫರೊಹನ ಇಸ್ರಾಯಲವಾಲಾವೊನೆ ತಿನು ದೆಶ ಛೊಡಿನ ಜಾ಼ವಾನಾಹುತಿ ಅಪ್ಪಣೆ ದಿದ್ಯಾವಾಚಿ ರ‍್ಹಯೊ.<verse eid="EXO 11:10" /></para>
  <chapter eid="EXO 11" />
  <chapter number="12" style="c" sid="EXO 12" />
  <para style="s">ಪಸ್ಕ ಸನ್ನ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1" />ಐಗುಪ್ತ ದೆಶಮಾ ಯಹೊವಾ ಮೊಶೆ ವರಿ ಆರೊನನಾ ಕ್ಹಾತೆ ಬೊಲಿನ ಕದಲ ಸುವೈ ಕದ್ಯಾಮ, <verse eid="EXO 12:1" /><verse number="2" style="v" sid="EXO 12:2" />ಕ್ಹಾರಾ ಮ್ಹೈನಾವೊಮಾ ಆಂಜ಼ ತುಮೊನೆ ಪೈಲಾನೊ ಮ್ಹೈನೊ ಥಯಲ ರ‍್ಹೌ. ಆಂಜ಼ ತುಮೊನೆ ಹರಿಯಕ್ಕ ವರಕ್ಹನೊ ಪೈಲಾನೊ ಮ್ಹೈನೊ ಥೈನ ರ‍್ಹವಸ. <verse eid="EXO 12:2" /><verse number="3" style="v" sid="EXO 12:3" />ಅನಾ ವಿಷಯಮಾ ತುಮೆ ಇಸ್ರಾಯಲನಾ ಕ್ಹಾರಾ ಸಮುಹನೆ ಅಮ್ಮ ಅಪ್ಪಣೆ ಕರು, ‘ಆಂ ಮ್ಹೈನಾನಾ ದಕ್ಹವಾ ದಿನ್ನಮಾ ತುಮಾರಾ ತುಮಾರಾ ಖಾಂದಾನನಾ ಹರಯಕ್ಕ ಘರವಾಲಾ ಯಕ್ಕೆಕ ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ನೆ ರ‍್ಹವಾದೆ, ಬೌಕುಡ ಬಚ್ಚಾ಼ನೆ ರ‍್ಹವಾದೆ ಲ್ಯೂ. <verse eid="EXO 12:3" /><verse number="4" style="v" sid="EXO 12:4" />ಕುಟುಂಬ ನ್ಹಾನು ರ‍್ಹಯಮ, ಯಕ್ಕ ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ನೆ ಪುರಾ ಖಾವಾನೆ ನೈ ಥಯಲಕ್ಹು ಬಾಜು಼ನಾ ಘರವಾಲಾವೊನಾ ಕ್ಹಾತೆ ಮಳಿನ ಯಕ್ಕೆಕ್ಲೊ ಕೆಕ್ಲು ಖಾವಸ ಕವಾನು ತಿಳ್ದಿಲಿನ ಮನಕ್ಹೊನಾ ಸಂಖ್ಯಾ ಲಿಂಗತ ಬೌಕುಡನಾ ಬಚ್ಚಾ಼ವೊನೆ ಲಿವಾದೆ. <verse eid="EXO 12:4" /><verse number="5" style="v" sid="EXO 12:5" />ತೆ ಬಚ್ಚು ದೊಶ ನೈಸೊ ಯಕ್ಕ ವರಕ್ಹನು ಗಂಡ ಬಚ್ಚು ರ‍್ಹೌ. ತುಮೆ ಬಕ್ರಾವೊಕ್ಹು ರ‍್ಹವಾದೆ ನೈತೊ ಬೌಕುಡಕ್ಹು ರ‍್ಹವಾದೆ ತಿನೆ ಲೆ ಸಕೊಸಿ. <verse eid="EXO 12:5" /><verse number="6" style="v" sid="EXO 12:6" />ಆಂ ಮ್ಹೈನಾನಾ ಚೌದಾವಾ ದಿನ್ನ ಲಕ್ಕಾ ತಿನೆ ಮ್ಹೆಲ್ಲಿನ, ತೆ ದಿನ್ನ ಕ್ಹಾಂಜ಼ನಾ ಟೈಮಮಾ ಇಸ್ರಾಯಲನಾ ಕ್ಹಾರಾ ಸಮೂಹವಾಲಾವೊನಾ ಕ್ಹಾತೆ ಮಳಿನ ತಿನೆ ಕಾಟು. <verse eid="EXO 12:6" /><verse number="7" style="v" sid="EXO 12:7" />ತ್ಯುನೆ ತಿನಾ ರಗತಮಾ ದಕ್ಹು ಲಿನ ತ್ಯುನೆ ತೆ ಅನ್ನ ಖಾವಾನಾ ಘರನಾ ಬಾಕಲನಾ ಬೆ ಚೌಕಟನಾ ಪಟ್ಟಿಯೊನೆಬಿ, ವರಿ ಉಪ್ಪರಲ್ಯಾ ಪಟ್ಟಿನೆಬಿ ಲಗಾಡು. <verse eid="EXO 12:7" /><verse number="8" style="v" sid="EXO 12:8" />ತೆಜ಼ ರಾತಮಾ ತೆ ಮಾಕ್ಹ ಖೈಪಡು. ತಿನೆ ಆಗಮಾ ಬಾಳಿನ ಕ್ಹಾಟು ನೈ ರ‍್ಹಯಲ ರೊಕ್ಲಾ ವರಿ ಕಡು ಥಯಲ ಭಾಜಿನಾ ಕಡ್ಡು ಕುಡಾನನಾ ಕ್ಹಾತೆ ಅನ್ನ ಖೌ. <verse eid="EXO 12:8" /><verse number="9" style="v" sid="EXO 12:9" />ತಿನೆ ಕಚ್ಚು ಕರಿನ ಪಾನಿಮಾ ಉಕಳೈನ ಖೌನೈ. ತಿನು ಮಾತು, ಪಗೊ, ಪೆಟಮಾನು ಕ್ಹಾರು, ಇವ್ನಾ ಕ್ಹಾತೆಜ಼ ಆಗಮಾ ಬಾಳಿನ ಖೌ. <verse eid="EXO 12:9" /><verse number="10" style="v" sid="EXO 12:10" />ಮರ್ನಾ ದಿನ್ನೆ ಪಾಟಲಕ್ಕಾ ತಿಮಾ ದಕ್ಹುಬಿ ಉಗ್ರಾಡು ನೈ. ಪಾಟಲಕ್ಕಾ ಉಗ್ರಲ ಆಗಮಾ ಬಾಳಿ ಪಡು. <verse eid="EXO 12:10" /><verse number="11" style="v" sid="EXO 12:11" />ತೆ ಅನ್ನ ಖಾವಾನು ಕಿಮ್ಮ ವೈ ಕದ್ಯಾಮ: ಗಾಮೆ ಜಾವಾಲಾ ಲಿಂಗತ ತುಮೆ ಕಂಬರನೊ ಪಟ್ಟೊ ಭಾಂದಿಲಿನ, ಚಪ್ಪಲೊ ಘಾಲ್ಲಿನ, ಲಾಕಡಿ ಧರಿನ, ಜಲ್ದಿ ಖೌ. ಆಂ ಯಹೊವಾನೆ ಮಹಿಮಾ ಕಾರಾನು ಪಸ್ಕ ಸನ್ನ ವೈ. <verse eid="EXO 12:11" /><verse number="12" style="v" sid="EXO 12:12" />ತೆ ರಾತೆ ಮಿ ಐಗುಪ್ತ ದೆಶನಾ ಉಪ್ಪರ ದಾಟಿನ ಗೈನ ಮನಕ್ಹೊಮಾ ರ‍್ಹವಾದೆ, ಪಶುವೊಮಾ ರ‍್ಹವಾದೆ, ಪೈಲಾರ ರ‍್ಹಯಲ ಕ್ಹಾರು ಖಲಾಸ ಕರುಸ. ಐಗುಪ್ತ ದೆಶನಾ ಕ್ಹಾರಾ ದೆವತೆನೆಬಿ ನ್ಯಾಯಾ ಕರುಸ. ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ. <verse eid="EXO 12:12" /><verse number="13" style="v" sid="EXO 12:13" />ತೆನೈಸೊ ತುಮೆ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ಘರೊನಾ ಬಾಕಲನೆ ಲಗಾಡಲ ರಗತ ತುಮೊನೆ ಗುರುತ ಥಾವಸ. ತೆ ರಗತನೆ ಮಿ ದೆಕ್ತಾಮಾ ತುಮೊನೆ ಕಯುಜ಼ ನಷ್ಟ ಕರೆವಾಚಿ ಅಗೊ ದಾಟಿನ ಜೌ಼ಸ. ಮಿ ಐಗುಪ್ತವಾಲಾವೊನೆ ಖಲಾಸ ಕರಾನಾ ಟೈಮಮಾ ತುಮೊನೆ ಕಯುಜ಼ ಹಾನಿ ಥಾತು ನೈ. <verse eid="EXO 12:13" /><verse number="14" style="v" sid="EXO 12:14" />ಆಂ ದಿನ್ನ ತುಮೊನೆ ಶೆಂ ರ‍್ಹವಸ. ಯಹೊವಾನಾ ಮಹಿಮಾನೆ ತೆ ಸನ್ನನೆ ತಲತಲಾಂತರ ಲಕ್ಕಾ ಕರು. ತಿನೆ ಹಮೆಶಾನೊ ನಿಯಮ ವ್ಹೈ ಕೈನ ಹಮೆಶಾಬಿ ಕರು.<verse eid="EXO 12:14" /></para>
  <para style="s">ಕ್ಹಾಟು ನೈಸೊ ರೊಕ್ಲಾನೊ ಸನ್ನ</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 12:15" />ಕ್ಹಾತ ದಿನ್ನ ಲಕ್ಕಾ ತುಮೆ ಕ್ಹಾಟು ನೈ ರ‍್ಹಯಲ ರೊಕ್ಲಾವೊನೆ ಕ್ಹೌ. ಪಸ್ಟನಾ ದಿನ್ನಮಾಜ಼ ಕ್ಹಾಟೊ ಲೊಟ ತುಮಾರಾ ಘರಮಾತಾ ಕಾಡಿ ಪಡು. ಕಾಕದ್ಯಾಮ ಪಸ್ಟನಾ ದಿನತಾ ಕ್ಹಾತಂವಾ ದಿನ್ನಲಕ್ಕಾ ಕ್ಹಾಟೊ ರೊಕ್ಲೊ ಖಾವಾಲೊ ಇಸ್ರಾಯೆಲೊಮಾತೊ ಕಾಡಿಪಡು. <verse eid="EXO 12:15" /><verse number="16" style="v" sid="EXO 12:16" />ತೆನೈಸೊ ಪಸ್ಟ ದಿನ್ನಮಾಜ಼ ಪರಿಶುದ್ದ ಕ್ಹುದಾನಾ ಆರಾದನಾ ಕರಾನಾಹುತಿ ಸಭೆ ಮಳೌ. ಕ್ಹಾತಂವಾ ದಿನ್ನಮಾಬಿ ಕ್ಹುದಾನಾ ಆರಾದನಾ ಕರಾನಾಹುತಿ ಸಭೆ ಮಳೌ. ಆಂ ಭಂಬಿ ದಿನ್ನೊಮಾ ಕಯಾಜ಼ ಕಾಮೊ ಕರು ನೈ. ಖಾವಾನೆ ಚಾ಼ಯೆ ಥಯಲ ಕರಸಕೊಸಿ ತೆನೈಸೊ ಬಿಜು಼ ಕಯು ಕಾಮ ಕರು ನೈ. <verse eid="EXO 12:16" /><verse number="17" style="v" sid="EXO 12:17" />ತುಮೆ ಕ್ಹಾಟು ನೈ ರ‍್ಹಯಲ ರೊಕ್ಲಾನೊ ಸನ್ನ ಕರು. ಕಾಕದ್ಯಾಮ ಆಂ ದಿನ್ನಮಾ ಮಿ ತುಮೊನೆ ಐಗುಪ್ತ ದೆಶಮಾತೊ ಭಾರೊ ಆವಾ ಲಗಾಡಲಹುತಿ ತುಮೆ, ತುಮಾರಾ ಖಾಂದಾನವಾಲಾ ಆಂ ದಿನ್ನ ಆಚರಣೆ ಕರು. ಆಂ ಹಮೆಶಾಬಿ ಸನ್ನ ನಿಂಗತ ಕರು. <verse eid="EXO 12:17" /><verse number="18" style="v" sid="EXO 12:18" />ಪಸ್ಟನಾ ಮ್ಹೈನಾನಾ ಚೌದಾವಾ ದಿನ್ನನಾ ಕ್ಹಾಂಜ಼ತಾ ತೆಜ಼ ಮ್ಹೈನಾನಾ ಇಕ್ಹಪ್ಪರ ಯಕ್ಕವಾ ದಿನ್ನನಾ ಕ್ಹಾಂಜ಼ಲಕ್ಕಾ ತುಮೆ ಕ್ಹಾಟು ನೈ ರ‍್ಹಯಲ ರೊಕ್ಲೊಜ಼ ಕ್ಹೌ. <verse eid="EXO 12:18" /><verse number="19" style="v" sid="EXO 12:19" />ತೆ ಕ್ಹಾತ ದಿನ್ನ ಲಕ್ಕಾ ತುಮಾರಾ ಘರೊಮಾ ಕ್ಹಾಟೊ ಲೊಟ ರ‍್ಹೌನೈ. ಕ್ಹಾಟು ರ‍್ಹಯಲ ಕುನ್ನ ಖಾವಸ ತೆ ಬಿಜಾ಼ ದೆಶನೊ ರ‍್ಹವಾದೆ ಸ್ವಂತ ದೆಶವಾಲೊ ರ‍್ಹವಾದೆ ಇಸ್ರಾಯಲನಾ ಸಮೂಹಮಾತಾ ಕಾಡಾಲಗಾಡು. <verse eid="EXO 12:19" /><verse number="20" style="v" sid="EXO 12:20" />ತುಮೆ ತುಮಾರಾ ಘರೊಮಾ ಕ್ಹಾಟಾ ನೈ ರ‍್ಹಯಲ ರೊಕ್ಲಾವೊನೆ ಖೌ, ತೆನೈತೊ ಕ್ಹಾಟು ಕಲಾಯಲ ಕಯುಜ಼ ಖೌನೈ’” ಕೈನ ಆಗನ್ಯಾ ಕರ‍್ಯೊ.<verse eid="EXO 12:20" /></para>
  <para style="s">ಪಸ್ಟ ಪಸ್ಕ ಸನ್ನ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21" />ತೆಳಾಮಾ ಮೊಶೆ ಇಸ್ರಾಯಲನಾ ಕ್ಹಾರಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊನೆ ಬಲೈನ ತ್ಯುನೊನೆ, "ತುಮೆ ತುಮಾರಾ ತುಮಾರಾ ಕುಟುಂಬನಾಹುತಿ ಮಂದೆಮಾತಾ ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ವೊನೆ ಇನಿಲಿನ ಪಸ್ಕ ಸನ್ನನೆ ಕಾಟೊ. <verse eid="EXO 12:21" /><verse number="22" style="v" sid="EXO 12:22" />ಹಿಸ್ಸೊಪ ಝಾಡನಾ ಟೊಂಗಿ ಲಿನ ತಪಾಲಾಮಾ ರ‍್ಹಯಲ ರಗತಮಾ ತಿನೆ ಡುಬೈನ ಬಾಕಲನಾ ಉಪ್ಪರ ಅಡಿ ರ‍್ಹಯಲ ಪಟ್ಟಿನೆಬಿ, ತಿನಾ ಬಾಜು಼ಮಾ ರ‍್ಹಯಲ ಭಂಬಿ ಪಟ್ಟಿಯೊನೆ ಲಗಾಡು. ತೆ ಥಯಲ್ಪರ ತುಮಾರಾಮಾ ಯಕ್ಲೊ ಪಾಟ ಥಯೆಲಕ್ಕಾ ಘರನು ಬಾಕಲ ಛೊಡಿನ ಭಾರಾ ಜೌ಼ನೈ. <verse eid="EXO 12:22" /><verse number="23" style="v" sid="EXO 12:23" />ಯಹೊವಾ ಐಗುಪ್ತವಾಲಾವೊನೆ ಖಲಾಸ ಕರಾನಾಹುತಿ ತೆ ದೆಶನಾ ವಚ್ಮಾ ದಾಟಿನ ಜಾ಼ವಸ. ತೆಳಾಮಾ ತುಮಾರಾ ತುಮಾರಾ ಘರನಾ ಬಾಕಲೊನಾ ಉಪ್ಪರಲ್ಯಾ ಪಟ್ಟಿಯೊಮಾ, ಬೆ ಪಟ್ಟಿಯೊಮಾ ತೆ ರಗತನೆ ದೆಕಿನ ಅಗೊ ದಾಟಿನ ಜಾ಼ವಸ. ತುಮಾರೊ ಜ಼ಲಮ ಕಾಡಾನಾಹುತಿ ಮರಣನೊ ದುತ ತುಮಾರಾ ಘರೊಮಾ ಆತೊಜ಼ ನೈ. <verse eid="EXO 12:23" /><verse number="24" style="v" sid="EXO 12:24" />ಆಂ ತುಮೊನೆಬಿ, ತುಮಾರಾ ಸಂತತಿವಾಲಾವೊನೆಬಿ ಹಮೆಶಾನು ನಿಯಮ ವ್ಹೈ ಕೈನ ಕರು. <verse eid="EXO 12:24" /><verse number="25" style="v" sid="EXO 12:25" />ಯಹೊವಾ ತಿನಾ ವಾಗ್ದಾನನಾ ಪ್ರಕಾರ ತುಮೊನೆ ದಿವಾನಾ ದೆಶೆ ತುಮೆ ಆಯಲ್ಪರ, ಆಂ ಆಚರಣೆ ಕರುಜ಼. <verse eid="EXO 12:25" /><verse number="26" style="v" sid="EXO 12:26" />ಅಗಾ ತುಮಾರಾ ಬಚ್ಚಾ, ತುಮೆ ಕರಾನಾ ಆಂ ಆಚರಣೆ ಸುವೈ?’ ಕೈನ ತುಮೊನೆ ಪುಚ್ತಾಮಾ, <verse eid="EXO 12:26" /><verse number="27" style="v" sid="EXO 12:27" />ತುಮೆ ತ್ಯುನೊನೆ, ‘ಯಹೊವಾ ಐಗುಪ್ತವಾಲಾವೊನೆ ಖಲಾಸ ಕರಲ್ಪರ ಐಗುಪ್ತ ದೆಶಮಾ ರ‍್ಹಯಲ ಇಸ್ರಾಯಲನಾ ಘರೊಮಾ ಗಯಾ ಬಗರ ಅಗೊ ದಾಟಿನ ಹಮಾರಾ ಘರವಾಲಾವೊನೆ ವಚಾ಼ಡಲಕ್ಹು ಅಪೆ ಯಹೊವಾನು ಆಂ ಪಸ್ಕ ಸನ್ನ ಕರುಜ಼ ಕೈನ ಕವೊ”’ ಕದ್ಯೊ. ತೆಳಾಮಾ ಮನಕ್ಹೊ ಉಂದಾ ಗುಡ್ಗಾ ಘಾಲಿನ ಯಹೊವಾನೆ ಆರಾದನಾ ಕರ‍್ಯಾ. <verse eid="EXO 12:27" /><verse number="28" style="v" sid="EXO 12:28" />ಇಸ್ರಾಯೆಲೊ ತ್ಯಾಂತಾ ಗೈನ ಯಹೊವಾ ಮೊಶೆ ವರಿ ಆರೊನ ಆಗನ್ಯಾ ಕರಲ ನಿಂಗತಜ಼಼ ಕರ‍್ಯಾ.<verse eid="EXO 12:28" /></para>
  <para style="s">ಪೈಲಾರ ಬಚ್ಚಾ಼ವೊನು ಮರಣ</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29" />ಅರ್ದಿ ರಾತಮಾ ಯಹೊವಾ ಐಗುಪ್ತ ದೆಶನಾ ಸಿಂಹಾಸನಪರ ರ‍್ಹಯಲ ಫರೊಹನನೊ ಪೈಲಾರ ದಿಕ್ರಾತೊ ಜೈಲಮಾ ರ‍್ಹಯಲ ಆಳೊನಾ ಪೈಲಾರ ದಿಕ್ರಾ ಲಕ್ಕಾ, ಐಗುಪ್ತ ದೆಶಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಪೈಲಾರ ಬಚ್ಚಾ಼ವೊನೆ ಖಲಾಸ ಕರಿಪಡ್ಯೊ. ಪಶುವೊನಾ ಪೈಲಾರ ಬಚ್ಚಾ಼ವೊನೆ ಖಲಾಸ ಕರಿಪಡ್ಯೊ. <verse eid="EXO 12:29" /><verse number="30" style="v" sid="EXO 12:30" />ತೆ ರಾತೆ ಫರೊಹನ, ತಿನಾ ಅದಿಕಾರಿಯೊನಾ ವರಿ ಐಗುಪ್ತನಾ ಕ್ಹಾರಾ ಉಟಿನ ದೆಕ್ತಾಮಾ ಮುರ್ದೊ ನೈ ರ‍್ಹಯಲ ಘರ ಯಕ್ಕಬಿ ನ್ಹೊತು. ಐಗುಪ್ತ ದೆಶಮಾ ಮ್ಹೊಟು ಗೊಳಾಟ ಥಯು. <verse eid="EXO 12:30" /><verse number="31" style="v" sid="EXO 12:31" />ಫರೊಹನ ತೆ ರಾತೆ ಮೊಶೆ ವರಿ ಆರೊನನೆ ಬಲೈನ ತ್ಯುನೊನೆ, "ತುಮೆ ಉಟಿನ ಮಾರಾ ಮನಕ್ಹೊನಾ ವಚ್ಮಾತಾ ಗೈಪಡೊ. ತುಮೆ ಮಾಂಗಿಲಿದಲ ತಿಮ್ಮ ಯಹೊವಾನೆ ಆರಾದನಾ ಕರಾನಾಹುತಿ ತುಮೆ ವರಿ ಇಸ್ರಾಯೆಲೊ ಗೈಪಡೊ. <verse eid="EXO 12:31" /><verse number="32" style="v" sid="EXO 12:32" />ತುಮೆ ಮಾಂಗಿಲಿದಲ ನಿಂಗತ ತುಮಾರಾ ಬೈಲೊ, ಬೌಕುಡ, ಬಕ್ರಾನಾ ಹಿಂಡನೆ ಲಿನ ಜಾ಼ವೊ. ತೆನೈಸೊ ಮನೆಬಿ ಆಶಿರ್ವಾದ ಕರೊ” ಕದ್ಯೊ. <verse eid="EXO 12:32" /><verse number="33" style="v" sid="EXO 12:33" />ಐಗುಪ್ತವಾಲಾ, "ಹಮೆ ಕ್ಹಾರಾ ಮರೆಸ” ಕೈಲಿನ ಇಸ್ರಾಯೆಲೊನೆ ತ್ಯುನಾ ದೆಶತಾ ಭೆಗಿನ ವಳಾವಾನೆ ಮನಸ ಕರಿನ ತ್ಯುನೊನೆ ಜ಼ಬರದಸ್ತಿ ಕರ‍್ಯಾ. <verse eid="EXO 12:33" /><verse number="34" style="v" sid="EXO 12:34" />ತಿನಾಹುತಿ ಮನಕ್ಹೊ ಲೊಟನೆ ಕ್ಹಾಟು ಘಾಲಾತಿ ಪೈಲಾಜ ಮಕ್ಹಳಾನಾ ಸಾಮನೊನಾ ಕ್ಹಾತೆ ಲೊಟನಾ ಮುದ್ದಾನೆ ಫಡಕಾಮಾ ಗಾಟ ಭಾಂದಿನ, ತ್ಯುನಾ ಕ್ಹಾಂದಾಪರ ಘಾಲಿಲಿನ ಗೈ ಪಡ್ಯಾ. <verse eid="EXO 12:34" /><verse number="35" style="v" sid="EXO 12:35" />ತಿನಾಹುತಿ ಮನಕ್ಹೊ ತ್ಯುನಾ ಸಾಮನೊಮಾ ಕ್ಹಾಟು ನೈ ರ‍್ಹಯಲ ಲೊಟ ಭರಿನ, ಫಡ್ಕಾಮಾ ಸುತ್ತಿನ ಖಾಂದಾಪರ ಘಲ್ಲಿನ ಗಯಾ. <verse eid="EXO 12:35" /><verse number="36" style="v" sid="EXO 12:36" />ಯಹೊವಾ ತ್ಯುನಾ ಉಪ್ಪರ ಐಗುಪ್ತಮಾ ದಯಾ ಹುಟ್ಸಾಯಲಕ್ಹು ತ್ಯುನೆ ಪುಚ್ಚಲ ಕ್ಹಾರುಜ಼ ಐಗುಪ್ತವಾಲಾ ದಿದ್ಯಾ. ಅಮ್ಮ ಇಸ್ರಾಯೆಲೊ ಐಗುಪ್ತನಾ ಆಸ್ತಿನೆ ಕಾಳಿ ಲಿದ್ಯಾ.<verse eid="EXO 12:36" /></para>
  <para style="s">ಐಗುಪ್ತತಾ ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊ ಜಾ಼ವಾನು</para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37" />ಇಸ್ರಾಯೆಲೊ ರಾಮ್ಸೆಸ್ ಗಾಮತಾ ಗೈನ ಸುಕ್ಕೊತಿನೆ ಆಯಾ . ಬಾಕ್ಡಿಯೊ ಬಚ್ಚಾ ನೈಸೊ ದಾಣ್ಗಾಜ಼ ಕಮ್ಸಿಕಮ್ಮ ಛೆ ಲಾಕ ಮನಕ್ಹೊ ವ್ಹತ್ತಾ. <verse eid="EXO 12:37" /><verse number="38" style="v" sid="EXO 12:38" />ತ್ಯುನಾ ಕ್ಹಾತೆ ಘನಾ ಜ಼ನಾ ಬಿಜಾ಼ ಮನಕ್ಹೊ ಐಪಡ್ಯಾತಾ. ಬೈಲೊ ಬಕ್ರಾನಾ ಹಿಂಡ ಬೌಕುಡೊ ತ್ಯುನಾ ಕ್ಹಾತೆ ಗೈ ಪಡ್ಯಾ. <verse eid="EXO 12:38" /><verse number="39" style="v" sid="EXO 12:39" />ತ್ಯುನೆ ಐಗುಪ್ತ ದೆಶತಾ ಲಾಯಲ ಮಕ್ಹಳಲ ಲೊಟಕ್ಹು ಕ್ಹಾಟು ನೈ ರ‍್ಹಯಲ ರೊಕ್ಲಾ ಕರಲಿದ್ಯಾ. ತ್ಯುನೆ ಐಗುಪ್ತ ದೆಶತಾ ಗಯಲ ದಕ್ಹು ಥೈತಬಿ ಟೈಮ ಮಳಲಕ್ಹು ಲೊಟನಾ ಮುದ್ದಾಮಾ ಕ್ಹಾಟಾನೆ ಕಲಾಯಲ ನ್ಹೊತಾ ವರಿ ಬಿಜಾ಼ ಕಯಾಜ಼ ಅನ್ನನೆ ತಯ್ಯಾರ ಕರಲಿದ್ಯಾ ನ್ಹೊತಾ. <verse eid="EXO 12:39" /><verse number="40" style="v" sid="EXO 12:40" />ಇಸ್ರಾಯೆಲೊ ಐಗುಪ್ತ ದೆಶಮಾ ಚಾರಕ್ಹೊನ ಮೂವತ್ತ ವರಕ್ಹ ತ್ಯಾಜ ವ್ಹತ್ತಾ. <verse eid="EXO 12:40" /><verse number="41" style="v" sid="EXO 12:41" />ಚಾರಕ್ಹೊನ ಮೂವತ್ತ ವರಕ್ಹ ಗಯಲ್ಪರ ತೆಜ಼ ದಿನ್ನಮಾ ಯಹೊವಾನಾ ಕ್ಹಾರಾ ಕುಲನಾ ಮನಕ್ಹೊ ಐಗುಪ್ತ ದೆಶನೆ ಛೊಡಿನ ಗೈ ಪಡ್ಯಾ. <verse eid="EXO 12:41" /><verse number="42" style="v" sid="EXO 12:42" />ಯಹೊವಾ ತೆಜ ರಾತಮಾ ತ್ಯುನೊನೆ ಐಗುಪ್ತ ದೆಶತೊ ಭಾರೊ ಆವಾ ಲಗಾಡಲಹುತಿ ತ್ಯುನೆ ತೆ ರಾತಮಾ ತಿನಾ ಮಹಿಮಾನಿ ಜಾಗರಾಣಿ ಕರ‍್ಯಾ. ಇಸ್ರಾಯೆಲೊ ಕ್ಹಾರಾ ತಲತಲಾಂತರ ಲಕ್ಕಾ ಯಹೊವಾನೆ ಜಾಗರಾಣಿನೆ ಕರಾನಿ ರಾತ ಆಂಜ಼ ವ್ಹೈ.<verse eid="EXO 12:42" /></para>
  <para style="s">ಪಸ್ಕ ಸನ್ನನು ನಿಯಮ</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43" />ಯಹೊವಾ ಮೊಶೆ ವರಿ ಆರೊನನೆ ಕದಲ ಸುವೈ ಕದ್ಯಾಮ, "ಪಸ್ಕ ಸನ್ನನೆ ಕರಾನು ಕಿಮ್ಮ ವ್ಹೈ ಕದ್ಯಾಮ, ಬಿಜೊ಼ ಕುನಬಿ ಯಕ್ಲೊ ತಿಮಾ ಪಸ್ಕ ಸನ್ನನು ಅನ್ನ ಖೌ ನೈ. <verse eid="EXO 12:43" /><verse number="44" style="v" sid="EXO 12:44" />ತೆನೈಸೊ ತುಮೆ ಖರುದಿ ಲಿದಲ ಹರಯಕ್ಕ ಗುಲಾಮ ಸುನ್ನತಿ ಕರೈಲಿದಲ ರ‍್ಹಯೊಮ ಕರ ಸಕಸ. <verse eid="EXO 12:44" /><verse number="45" style="v" sid="EXO 12:45" />ಬಿಜಾ ದೆಶವಾಲಾ, ದಕ್ಹಾ ದಿನ್ನನಾ ಕುಲಿವಾಲಾ ತಿನೆ ಖೌ ನೈ. <verse eid="EXO 12:45" /><verse number="46" style="v" sid="EXO 12:46" />ತ್ಯುನಾ ತ್ಯುನಾ ಘರೊಮಾ ತಿನೆ ಕ್ಹೌ. ತಿಮಾ ದಕ್ಹು ಮಾಕ್ಹ ರ‍್ಹೈತಬಿ ಘರತೊ ಭಾರೊ ಲಿನ ಜೌ಼ನೈ. ತೆ ಪಶುನಾ ಯಕ್ಕ ಹಡಕುಬಿ ತೊಡುನೈ. <verse eid="EXO 12:46" /><verse number="47" style="v" sid="EXO 12:47" />ಇಸ್ರಾಯಲನಾ ಕ್ಹಾರಾ ಸಮೂಹನಾ ಆಂ ಸನ್ನ ಕರು. <verse eid="EXO 12:47" /><verse number="48" style="v" sid="EXO 12:48" />ತುಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ಬಿಜಾ ದೆಶವಾಲೊ ಯಹೊವಾನಾ ಆಂ ಪಸ್ಕ ಸನ್ನನೆ ಆಚರಣೆ ಕರು ಕೈನ ಆಸ ಕರ‍್ಯಾಮ ತೆ, ತಿನೆ ಮಳಲ ದಾಣ್ಗಾ ಕ್ಹಾರಾ ಸುನ್ನತಿ ಕರಲ್ಯು. ತೆ ಥಯಲ್ಪರ ತೆ ಆಂ ಸನ್ನನೆ ಆಚರಣೆ ಕರಾನೆ ಕ್ಹಾಮೊ ಆವಾದೆ. ತ್ಯವೊ ಸ್ವಂತ ದೆಶವಾಲೊ ನಿಂಗತ ರ‍್ಹವಸ. ತೆನೈಸೊ ಸುನ್ನತಿ ನೈ ಕರೈಲಿದಲವಾಲೊ ತೆ ಅನ್ನ ಖೌ ನೈ. <verse eid="EXO 12:48" /><verse number="49" style="v" sid="EXO 12:49" />ಇಸ್ರಾಯೆಲೊನೆಬಿ ಸ್ವಂತ ದೆಶವಾಲಾವೊನೆಬಿ, ತುಮಾರಾಮಾ ರ‍್ಹಯಲ ಬಿಜಾ ದೆಶವಾಲಾವೊನೆ ಯಕ್ಕಜ ನಿಯಮ ರ‍್ಹೌ” ಕದ್ಯೊ. <verse eid="EXO 12:49" /><verse number="50" style="v" sid="EXO 12:50" />ಯಹೊವಾ ಮೊಶೆ ವರಿ ಆರೊನನೆ ಆಗನ್ಯಾ ಕರಲ ನಿಂಗತ ಇಸ್ರಾಯೆಲೊ ಕ್ಹಾರಾ ಕರ‍್ಯಾ. <verse eid="EXO 12:50" /><verse number="51" style="v" sid="EXO 12:51" />ತೆಜ಼ ದಿನ್ನಮಾ ಯಹೊವಾ ಇಸ್ರಾಯೆಲೊನೆ ತ್ಯುನಾ ತ್ಯುನಾ ಕುಲನಾ ಮನಕ್ಹೊನೆ ಐಗುಪ್ತ ದೆಶತೊ ಭಾರೊ ಲಾಯೊ.<verse eid="EXO 12:51" /></para>
  <chapter eid="EXO 12" />
  <chapter number="13" style="c" sid="EXO 13" />
  <para style="s">ಪೈಲಾರ ಬಚ್ಚಾ಼ವೊನು ಸಮರ್ಪಣೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1" />ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="EXO 13:1" /><verse number="2" style="v" sid="EXO 13:2" />"ಇಸ್ರಾಯೆಲೊಮಾ ಹುಟ್ಟಲ ಹರಯಕ್ಕ ಪೈಲಾರ ಗಂಡನೆ ಮಾರಾಹುತಿ ಮ್ಹೆಲು. ಮನಕ್ಹೊಮಾ ರ‍್ಹವಾದೆ, ಪಶುವೊಮಾ ರ‍್ಹವಾದೆ ಹುಟ್ಟಾನು ಪಸ್ಟ ಗರ್ಭನು ಫಲ ಮಾರು ವ್ಹೈ” ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 13:2" /></para>
  <para style="s">ಕ್ಹಾಟು ನೈಸೊ ರೊಕ್ಲಾವೊನು ಸನ್ನ</para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3" />ಮೊಶೆ ಇಸ್ರಾಯೆಲೊನೆ, "ತುಮೆ ದಾಸತ್ವಮಾ ಐಗುಪ್ತ ದೆಶಮಾತೊ ಬಿಡಗಡೆ ಥಯಲ ಆ ದಿನ್ನನೆ ಶೆಂಮಾ ಮ್ಹೆಲ್ಲಿವೊ. ಯಹೊವಾ ತಿನಿ ಮ್ಹೊಟಿ ತಾಕತಕ್ಹು ತುಮೊನೆ ತೆ ಜ಼ಗಾತೊ ಛೊಡಾಯೊಸ. ಆಂ ದಿನ್ನಮಾ ತುಮೆ ಕ್ಹಾಟು ರ‍್ಹಯಲ ಖೌ ನೈ. <verse eid="EXO 13:3" /><verse number="4" style="v" sid="EXO 13:4" />ಚೈತ್ರ ಮಾಸನಾ ಆಂ ದಿನ್ನಮಾ ತುಮೆ ಭಾರಾ ಆಯಲ ರ‍್ಹವೊಸಿ. <verse eid="EXO 13:4" /><verse number="5" style="v" sid="EXO 13:5" />ಯಹೊವಾ ತುಮಾರಾ ಪುರ್ವಿಕೊನೆ ವಾತ ದಿದಲ ನಿಂಗತ, ತುಮೊನೆ ದುದ್ದ ವರಿ ಜೆನ ವ್ಹೈನ ಜಾ಼ವಾನು ದೆಶನೆ ಕದ್ಯಾಮ ಕಾನಾನ್ಯವಾಲಾ, ಹಿತ್ತಿಯವಾಲಾ, ಅಮೊರಿಯವಾಲಾ, ಹಿವ್ವಿವಾಲಾ, ಯೆಬುಸಿಯವಾಲಾ ರ‍್ಹಯಲ ದೆಶನೆ ಬಲೈನ ತೆ ತ್ಯುನೊನೆ ದೆತಾಮಾ ತುಮೆ ಆಂ ಮ್ಹೈನಾಮಾ ಸನ್ನ ಕರು. <verse eid="EXO 13:5" /><verse number="6" style="v" sid="EXO 13:6" />ಕ್ಹಾತ ದಿನ್ನ ತುಮೆ ಕ್ಹಾಟು ನೈ ರ‍್ಹಯಲ ರೊಕ್ಲಾವೊನೆ ಖೌ, ಕ್ಹಾತವಾ ದಿನ್ನಮಾ ಯಹೊವಾನೆ ಮಹಿಮಾ ಕರಾನಾಹುತಿ ಸನ್ನ ಕರು. <verse eid="EXO 13:6" /><verse number="7" style="v" sid="EXO 13:7" />ತೆ ಕ್ಹಾತ ದಿನ್ನಬಿ ತುಮೆ ಕ್ಹಾಟಾ ನೈ ರ‍್ಹಯಲ ರೊಕ್ಲಾವೊನೆ ಖೌ. ತೆನೈಸೊ, ತುಮ್ನೊಮಾ ಕ್ಹಾಟೊ ಲೊಟ ದಿಕ್ಹು ನೈ. ನೈಸೊ ಕ್ಹಾಟೊ ಲೊಟ ತುಮಾರಾ ಬಾಜು಼ಮಾಬಿ ದಿಕ್ಹು ನೈ. <verse eid="EXO 13:7" /><verse number="8" style="v" sid="EXO 13:8" />ತೆ ದಿನ್ನಮಾ ತುಮೆ ತುಮಾರಾ ಬಚ್ಚಾ಼ವೊನೆ ಅಪ್ನಾ ಮನಕ್ಹೊ ಐಗುಪ್ತ ದೆಶತಾ ಫರಿನ ಆಯಲ್ಪರ ಯಹೊವಾ ಅಪ್ನಾಹುತಿ ಕರಲ ಶೆಂ ಕರಲಿವಾನೆ ಆಂ ಸನ್ನ ಕರಾಡಾಸ ಕೈನ ಕೌ. <verse eid="EXO 13:8" /><verse number="9" style="v" sid="EXO 13:9" />ಯಹೊವಾ ತಿನಿ ತಾಕತಕ್ಹು ತುಮೊನೆ ಐಗುಪ್ತ ದೆಶತೊ ಚೊಡಾಯಲಕ್ಹು, ತಿನಾ ನಿಯಮೊನಾಹುತಿ ತುಮೆ ಕೌ. ಆಂ ಆಚರಣೆಬಿ ತುಮಾರಾ ಹತೊಪರ ಗುರತಬಿ ಹಣಿನೆ ಭಾಂದಿಲಿದಲ ಶೆಂನಿ ಪಟ್ಟಿ ನಿಂಗತ ರ‍್ಹೌ. <verse eid="EXO 13:9" /><verse number="10" style="v" sid="EXO 13:10" />ಅಮ್ಮ ರ‍್ಹತಾಮಾ ಹರಯಕ್ಕ ವರಕ್ಹೆ ನಿಯಮನಾ ಕಾಲಮಾ ತುಮೆ ಆಂ ಆಚರಣೆ ಕರು.<verse eid="EXO 13:10" /></para>
  <para style="s">ಪೈಲಾರ ಹುಟ್ಟಲ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11" />ಯಹೊವಾ ತುಮೊನೆ ವರಿ ತುಮಾರಾ ಪುರ್ವಿಕೊನೆ ಪ್ರಮಾಣ ಕರಲ ನಿಂಗತ ಆಂ ಕಾನಾನ ದೆಶನೆ ಆವಾಲಗಾಡಿನ ತೆ ದೆಶನೆ ತುಮೊನೆ ದಿದಲ್ಪರ, <verse eid="EXO 13:11" /><verse number="12" style="v" sid="EXO 13:12" />ತುಮ್ನೊಮಾ ವರಿ ತುಮಾರಾ ಪಶುವೊಮಾ ಪಸ್ಟ ಗರ್ಭನು ಫಲ ಗಂಡನಾ ಪಕ್ಷನೆ ತೆ ಯಹೊವಾನು ಭಾಗ ವ್ಹೈ ಕೈನ ತಿಳದಿಲಿನ ತೆ ತಿನೆ ಸಮರ್ಪಿತ ಕರು. <verse eid="EXO 13:12" /><verse number="13" style="v" sid="EXO 13:13" />ತೆನೈಸೊ ಪಸ್ಟ ಹುಟ್ಟಲ ಗದ್ಡಾನಾ ಬಚ್ಚಾ಼ನಾ ಬದಲಿ ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ನೆ ಛೊಡೈ ಲೆಸಕೊಸಿ. ತಿಮ್ಮಜ಼ ನೈ ಛೊಡಾಯಮ ತಿನಿ ಗರ್ದನ ತೊಡಿನ ಖಲಾಸ ಕರು. ಮನಕ್ಹನಾ ಪೈಲಾ ಗಂಡ ಬಚ್ಚಾ಼ವೊನೆ ಯಹೊವಾನಾ ಹುತಿ ಛೊಡೈಲ್ಯುಜ಼. <verse eid="EXO 13:13" /><verse number="14" style="v" sid="EXO 13:14" />ಅಗಾ ತುಮಾರಾ ಬಚ್ಚಾ಼, ಅನು ಅರ್ಥ ಸುವೈ? ಕೈನ ತುಮೊನೆ ಪುಚ್ತಾ಼ಮಾ ತುಮೆ ತ್ಯುನೊನೆ, ‘ಹಮೊನೆ ದಾಸತ್ವಮಾ ರ‍್ಹಯಲ ಐಗುಪ್ತ ದೆಶತೊ ಯಹೊವಾ ತಿನಾ ಮ್ಹೊಟಿ ತಾಕತಕ್ಹು ಛೊ಼ಡಾಯೊ. <verse eid="EXO 13:14" /><verse number="15" style="v" sid="EXO 13:15" />ಫರೊಹನ ಹಟಾ ಧರಿನ ಹಮೊನೆ ನೈ ಜಾ಼ವಾನೆ ದಿನ ರ‍್ಹತಾಮಾ ಯಹೊವಾ ಐಗುಪ್ತ ದೆಶಮಾ ಮನಕ್ಹೊನಾ ಪೈಲಾರ ಬಚ್ಚಾ಼ನೆ, ಪಶುವೊನಾ ಪೈಲಾರ ಬಚ್ಚಾ಼ವೊನೆ ರ‍್ಹೈತಬಿ ತೆ ದೆಶಮಾ ಪೈಲಾರ ರ‍್ಹಯಲ ಕ್ಹಾರುಜ಼ ಕತ್ರಿ ಪಡ್ಯೊ. ತಿನಾಹುತಿ ಗಂಡ ಥೈನ ಹುಟ್ಟಾನು ಪಸ್ಟ ಗರ್ಭನು ಫಲ ಹಮೆ ಯಹೊವಾನೆ ಸಮರ್ಪಣೆ ಕರಾನು ಮನಕ್ಹೊಕಂತು ರ‍್ಹಯಲ ಪೈಲಾರ ಗರ್ಭಫಲನೆ ರ‍್ಹೈತಬಿ ತಿನಾ ಬದಲಿ ದಿನ ಛೊಡೈಯೆಸ”’ ಕೈನ ಕೌ. <verse eid="EXO 13:15" /><verse number="16" style="v" sid="EXO 13:16" />ಯಹೊವಾ ಖಾಂದಾನಿ ತಾಕತುಕ್ಹು ತುಮೊನೆ ಐಗುಪ್ತ ದೆಶತಾ ಛೊಡಾಯಲ ಸಂಗತಿಯೊನೆ ತು ಶೆಂಮಾ ಮ್ಹೆಲ್ಲಿವಾಹುತಿ ಗುರತ ಥೈನ ತಿನೆ ತುಮಾರಾ ಹತೊನ ಉಪ್ಪರ, ಹಣಿನಾ ಉಪ್ಪರಬಿ ಶೆಂನಿ ಪಟ್ಟಿ ನಿಂಗತ ರ‍್ಹೌಜ಼.<verse eid="EXO 13:16" /></para>
  <para style="s">ಮೆಘ ಸ್ತಂಬ ವರಿ ಅಗ್ನಿ ಸ್ತಂಬ</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17" />ಫರೊಹನ ಇಸ್ರಾಯೆಲೊನೆ ಜಾ಼ವಾನಾಹುತಿ ಅಪ್ಪಣೆ ದಿದಲ್ಪರ, ಪಿಲಿಷ್ಟಿನಾ ದೆಶನಿ ವಾಟ ನಜಿಕ ರ‍್ಹೈತಬಿ ಕ್ಹುದಾ ತೆ ವಾಟಮಾ ತ್ಯುನೊನೆ ಜಾ಼ವಾನೆ ದಿದ್ಯೊ ನೈ. ಕಾಕದ್ಯಾಮ, "ಕ್ಹುದಾ, ಮನಕ್ಹೊ ಯುದ್ದ ದೆಕಿನ ಘಾಬ್ರಾ ಥೈನ ಮನಸ್ಸ ಬದಲಿ ಕರಲಿನ ಐಗುಪ್ತನೆ ಪಾಚಾ಼ ಫರಿನ ಜಾ಼ಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 13:17" /><verse number="18" style="v" sid="EXO 13:18" />ಅಮ್ಮ ರ‍್ಹತಾಮಾ ಯಹೊವಾ ಮನಕ್ಹೊನೆ ಲಾಲ ಸಮುಂದರನಾ ನಜಿಕ ರ‍್ಹಯಲ ಉಸಕನಿ ಜಿಮಿನನೆ ಬಳಸಿಲಿನ ಗಯೆ ನಿಂಗತ ಕರ‍್ಯೊ. ತೆನೈಸೊ ಇಸ್ರಾಯೆಲೊ ಯುದ್ದ ಸನ್ನದ ಥೈನ ಐಗುಪ್ತ ದೆಶನಾ ಮ್ಹೈತಾ ಫರಿನ ಆಯಾ. <verse eid="EXO 13:18" /><verse number="19" style="v" sid="EXO 13:19" />ತೆನೈಸೊ ಯೊಸೆಫ ಇಸ್ರಾಯೆಲೊನೆ, "ಕ್ಹುದಾ ಸಂಶೊವಾಚಿ ತುಮೊನೆ ದೆಕಿಲಿನ ತಿನಾ ವಾಗ್ದಾನೊನೆ ಪುರಾ ಕರಾಲೊ ಥಯಲಹುತಿ ತುಮೆ ಜಾ಼ತಾಮಾ ಮಾರೊ ಮುರ್ದೊ ತುಮಾರಾ ಕ್ಹಾತೆ ಲಿನ ಜೌ಼” ಕೈನ ಕ್ಹರಿಬಿ ಘಲಾಯಲ ಖಮ್ಮ ನಿಂಗತ ಮೊಶೆ ಯೊಸೆಫನಾ ಹಡ್ಕಾ ತಿನಾ ಕ್ಹಾತೆ ಲಿನ ಗಯೊ. <verse eid="EXO 13:19" /><verse number="20" style="v" sid="EXO 13:20" />ತ್ಯುನೆ ಸುಕ್ಕೊತತಾ ಪ್ರಯಾಣ ಕರಿನ ಉಸುಕನಾ ಗಾಮನಾ ಕೊನಾಮಾ ರ‍್ಹಯಲ ಎತಾಮಮಾ ಝುಪ್ಡು ಘಾಲಿನ ರ‍್ಹಯಾ. <verse eid="EXO 13:20" /><verse number="21" style="v" sid="EXO 13:21" />ಯಹೊವಾ ಪಾಟನಾ ಟೈಮಾ ವಾಟ ದೆಕ್ಲಾಡಾನಾಹುತಿ ಮೆಘಸ್ತಂಭಮಾಬಿ ರಾತನಾ ಟೈಮಾ ಉಜಾಲು ದಿವಾನಾಹುತಿ ಅಗ್ನಿಸ್ತಂಭಮಾಬಿ ರ‍್ಹೈನ ತೆ ಚ಼ಲಾಡಾಡೊತೊ. ತೆ ತರಿಕಾಮಾ ತ್ಯುನೆ ರಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರ‍್ಯಾ. <verse eid="EXO 13:21" /><verse number="22" style="v" sid="EXO 13:22" />ಪಾಟನಾ ಟೈಮಮಾ ಮೆಘಸ್ತಂಭ ಥೈನ, ರಾತಮಾ ಟೈಮಮಾ ಅಗ್ನಿಸ್ತಂಭ ಥೈನ ಮನಕ್ಹೊನೆ ಛೊ಼ಡ್ಯಾ ಬಗರ ತ್ಯಾಜ಼ ರ‍್ಹತೊತೊ.<verse eid="EXO 13:22" /></para>
  <chapter eid="EXO 13" />
  <chapter number="14" style="c" sid="EXO 14" />
  <para style="s">ಲಾಲ ಸಮುಂದರ ದಾಟಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 14:1" />ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="EXO 14:1" /><verse number="2" style="v" sid="EXO 14:2" />"ಇಸ್ರಾಯೆಲೊ ಪಾಚಾ ಫರಿನ ಗೈನ ಪಿಹಹಿರೊತನಾ ಪುರ್ವ ದಿಕ್ಕಮಾ ಮಿಗ್ದೊಲಿನೆ ಲಾಲ ಸಮುಂದರನಾ ವಚ್ಮಾ ಬಾಳ್ಚೆಫೊನನೆ ಕ್ಹಾಮಾ ರ‍್ಹೌ ಕೈನ ತ್ಯುನೊನೆ ಕೆ. ತಿನಾ ಕ್ಹಾಮಾ ಸಮುಂದರನಾ ಬಾಜು಼ಮಾಜ಼ ತ್ಯುನೆ ರ‍್ಹೌ. <verse eid="EXO 14:2" /><verse number="3" style="v" sid="EXO 14:3" />ಫರೊಹನ ತೆ ದೆಕಿನ ಇಸ್ರಾಯೆಲೊನಾಹುತಿ, ‘ತ್ಯುನೊನೆ ವಾಟ ಚು಼ಕಿಸ, ಕ್ಹಾರಿ ಬಗಲಬಿ ಉಸಕನಿ ಜಿಮಿನ ತ್ಯುನಾ ಸುತ್ತೆಬಿ ಛೆ’ ಕೈನ ಕೈಲಿವಸ. <verse eid="EXO 14:3" /><verse number="4" style="v" sid="EXO 14:4" />ಮಿ ಫರೊಹನನು ಮನಸ ಕಟಿನ ಕರುಸ. ತಿನಾಹುತಿ ತೆ ತ್ಯುನೊನೆ ಪಾಚೊ಼ ಲಾಗಿನ ಆವಸ. ತೆಳಾಮಾ ಮಿ ಫರೊಹನಮಾಬಿ, ತಿನಾ ಸೈನ್ಯಮಾಬಿ ಮಹಿಮಾ ಕರಲ್ಯುಸ ‘ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ’ ಕೈನ ಐಗುಪ್ತವಾಲಾವೊನೆ ಗ್ವತ್ತ ಥಾವಸ” ಕೈನ ಕದ್ಯೊ. ಯಹೊವಾ ಆಗನ್ಯಾ ಕರಲ ನಿಂಗತ ಇಸ್ರಾಯೆಲೊ ಚಾ಼ಲಿಲಿದ್ಯಾ. <verse eid="EXO 14:4" /><verse number="5" style="v" sid="EXO 14:5" />ಇಸ್ರಾಯೆಲೊ ನ್ಹಾಟಿನ ಗಯಾಸ ಕೈನ ಸುದ್ದಿ ಐಗುಪ್ತನೊ ರಾಜೊ಼ ಥಯಲ ಫರೊಹನನೆ ಗ್ವತ್ತ ಥಯಲ್ಪರ, ತ್ಯುನಾ ವಿಷಯಮಾ ಫರೊಹನ ವರಿ ತಿನಾ ಅದಿಕಾರಿಯೊನಾ ಮನಸಬಿ ತ್ಯುನೊನೆ ವಿರುದ್ದ ಥೈನ ಕಟಿನ ಥಯುತು. ತ್ಯುನೆ, "ಆಂ ಸುವೈ ಹಮೆ ಕರಲ? ಅಪೊನೆ ಆಳೊ ಥೈನ ರ‍್ಹಯಲ ಇಸ್ರಾಯೆಲೊನೆ ಜಾ಼ವಾನೆ ಛೊ಼ಡಿಪಡ್ಯಾತೊ” ಕೈಲಿದ್ಯಾ. <verse eid="EXO 14:5" /><verse number="6" style="v" sid="EXO 14:6" />ತೆಳಾಮಾ ಫರೊಹನ ತಿನಾ ರಥನಿ ತಾಕತ ಸಿದ್ದ ಕರಲಿನ ತಿನಾ ಸೈನಿಕೊನಾ ಕ್ಹಾತೆ ಚಾಲ್ಯೊ. <verse eid="EXO 14:6" /><verse number="7" style="v" sid="EXO 14:7" />ಶ್ರೆಷ್ಟ ಥಯಲ ಛೆ ಕ್ಹೊ ರಥೊನೆ, ಐಗುಪ್ತ ದೆಶನಾ ಕ್ಹಾರಾ ರಥೊನೆ ಲಿನ ಪಾಚೊ಼ ಲಾಗಿನ ಗಯೊ. ತೆ ಕ್ಹಾರಾ ರಥೊಮಾ ಅದಿಕಾರಿಯೊನೆ ಬಲೈಲಿದ್ಯೊ. <verse eid="EXO 14:7" /><verse number="8" style="v" sid="EXO 14:8" />ಯಹೊವಾ ಐಗುಪ್ತ ದೆಶನೊ ರಾಜೊ ಥಯಲ ಫರೊಹನೊ ಮನಸನೆ ಕಟಿನ ಕರಲಕ್ಹು ತೆ ಯುದ್ದನಾ ಸನ್ನದ ಥಯಲ ಇಸ್ರಾಯೆಲೊನೆ ಪಾಚೊ ಲಾಗಿನ ಗಯೊ. <verse eid="EXO 14:8" /><verse number="9" style="v" sid="EXO 14:9" />ಐಗುಪ್ತನಾ ಕದ್ಯಾಮ ಫರೊಹನನಾ ಘೊಡಾ, ರಥೊ, ತಿನೆ ಚ಼ಲಾವಾಲಾ, ಸೈನ್ಯನಾ ಕ್ಹಾರಾ ತ್ಯುನಾ ಪಾಚಾ಼ ಗೈನ ಇಸ್ರಾಯೆಲೊ ಪಿಹಹಿರೊತಿನಾ ನಜಿಕ ಬಾಳ್ಚೆಪೊನಿನಾ ಕ್ಹಾಮಾ‍ ರ‍್ಹಯಲ ಲಾಲ ಸಮುಂದರನಾ ದಂಡಿಪರ ಉತರತಾ ಟೈಮಾ ತ್ಯುನೆ ನಜಿಕ ಆಯಾ. <verse eid="EXO 14:9" /><verse number="10" style="v" sid="EXO 14:10" />ಫರೊಹನ ನಜಿಕ ರ‍್ಹತಾಮಾ ಇಸ್ರಾಯೆಲೊ ಡೊಳಾ ಉಚೈನ ತ್ಯುನಾ ಪಾಚಾ ಆಯಲ ಐಗುಪ್ತವಾಲಾವೊನೆ ದೆಕಿನ, ಘನ್ನಾ ಬುಚ್ಕಿನ ರೊತಾ ಮದತನಾಹುತಿ ಯಹೊವಾನೆ ಮೊರೆ ಮ್ಹೆಲ್ಯಾ. <verse eid="EXO 14:10" /><verse number="11" style="v" sid="EXO 14:11" />ತ್ಯುನೆ ಮೊಶೆನೆ, "ಐಗುಪ್ತ ದೆಶಮಾ ಮಜಾ಼ರೊ ನೈ ರ‍್ಹಯಲಕ್ಹು ಉಸುಕನಾ ಜಿಮಿನಮಾ ಮರಾದೆ ಕೈನ ಹಮೊನೆ ನ್ಹ್ಯಾ ಬಲೈಲಿನ ಆಯೊಸ ಸು? ಕಾ ತು ಹಮೊನೆ ಅಮ್ಮ ಕರಿನ ಐಗುಪ್ತ ದೆಶತೊ ಶಾನೆ ಬಲೈಲಿನ ಆಯೊ? <verse eid="EXO 14:11" /><verse number="12" style="v" sid="EXO 14:12" />ಹಮೆ ಐಗುಪ್ತ ದೆಶಮಾ ರ‍್ಹತಾಮಾಜ಼, ‘ತು ಹಮಾರಾ ಗೊಡವೆನೆ ಔನಕೊ. ಹಮೆ ಐಗುಪ್ತೊನೆ ದಾಸ ಥೈನಜ಼ ರ‍್ಹಯೆಸ’ ಕವಾನು ತುನೆ ಕದ್ಯಾನತ್ತಿ ಸು? ಹಮೆ ಆಂ ಉಸಕನಿ ಜಿಮಿನಮಾ ಮರಾತಿ ಐಗುಪ್ತೊನೆ ದಾಸ ಥೈನ ರ‍್ಹವಾನುಜ಼ ಚೊ಼ಕು ವ್ಹೈ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 14:12" /><verse number="13" style="v" sid="EXO 14:13" />ತಿನಾಹುತಿ ಮೊಶೆ ತೆ ಮನಕ್ಹೊನೆ, "ತುಮೆ ಬುಚ್ಕೊ ನಕೊ. ಗಪ್ಪ ಹುಬ್ರೈನ ಯಹೊವಾ ಆಂ ಟೈಮೆ ತುಮೊನೆ ವಚಾ಼ಡಾನಾ ತರಿಕಾನೆ ದೆಕೊ! ತುಮೆ ಆಂ ಟೈಮಮಾ ದೆಕಾನು ಐಗುಪ್ತೊನೆ ಹಬ್ದಾತಾ ಕೆಳಾಮಾಜ ದೆಕ್ತಾ ನೈ. <verse eid="EXO 14:13" /><verse number="14" style="v" sid="EXO 14:14" />ಯಹೊವಾಜ ತುಮಾರಾಹುತಿ ಯುದ್ದ ಕರಸ. ತುಮೆ ಗಪ್ಪಚುಪ್ಪ ಹುಬ್ರೆವೊ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 14:14" /><verse number="15" style="v" sid="EXO 14:15" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆನೆ ಕದಲ ಸುವೈ ಕದ್ಯಾಮ, "ತು ಮನೆ ಮೊರೆ ಮ್ಹೆಲಾನು ಸುವೈ? ಅಗಾ ಜಾ಼ವೊ ಕೈನ ಇಸ್ರಾಯೆಲೊನೆ ಕೆ. <verse eid="EXO 14:15" /><verse number="16" style="v" sid="EXO 14:16" />ತು ತಾರಾ ಲಾಕ್ಡಿನೆ ಉಚೈನ ಸಮುಂದರಪರ ಹತ್ತ ಉಚೈನ ತಿನೆ ಭಾಗ ಕರ, ತೆಳಾಮಾ ಇಸ್ರಾಯೆಲೊ ಸಮುಂದರನಾ ವಚ್ಮಾ ಕ್ಹುಕ್ಹಾಯಲ ಜಿಮಿನಪರ ಚಾ಼ಲಿನ ಜಾ಼ವಸ. <verse eid="EXO 14:16" /><verse number="17" style="v" sid="EXO 14:17" />ಮಿ ಐಗುಪ್ತವಾಲಾವೊನಾ ಮನಸೊ ಕಠಿನ ಕರುಸ ತಿನಾಹುತಿ ತ್ಯುನೆ ಇವ್ನಾ ಪಾಚಾ಼ ಸಮುಂದರನಾ ಮ್ಹೈ ಜಾ಼ವಸ; ತೆಳಾಮಾ ಮಿ ಫರೊಹನಮಾಬಿ ತಿನಾ ಪುರಾ ಸೈನ್ಯಮಾಬಿ ರಥೊಮಾಬಿ ಘೊಡಾವೊಮಾಬಿ ಪ್ರಸಿದ್ಧಿ ಥೌಸ. <verse eid="EXO 14:17" /><verse number="18" style="v" sid="EXO 14:18" />ಮಿ ಫರೊಹನಮಾಬಿ ತಿನಾ ರಥೊಮಾಬಿ, ಘೊಡಾವೊಮಾಬಿ ಪ್ರಸಿದ್ಧಿ ಥಯಲ್ಪರ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ಐಗುಪ್ತವಾಲಾ ತಿಳದಿಲಿವಸ ಕದ್ಯೊ.<verse eid="EXO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19" />ತೆಳಾಮಾ ಇಸ್ರಾಯೆಲವಾಲಾ ದಂಡನಾ ಅಗೊ ಜಾ಼ತೊ ರ‍್ಹಯಲ ದೆವದುತ ತಿನಿ ಜ಼ಗಾ ಛೊಡಿನ ತ್ಯುನಾ ಪಾಚೊ಼ ಆಯೊ; ತ್ಯುನು ಅಗು ರ‍್ಹಯಲ ಮೆಘಸ್ತಂಬಬಿ ತ್ಯಾಂತು ಐನ ತ್ಯುನಾ ಪಾಚೂ಼ ಹುಬ್ರಯು. <verse eid="EXO 14:19" /><verse number="20" style="v" sid="EXO 14:20" />ತೆ ಮೆಘಸ್ತಂಭಬಿ ಐಗುಪ್ತವಾಲಾವೊನಾ ಪಾಳೆಯನೆ, ಇಸ್ರಾಯೆಲವಾಲಾವೊನಾ ಪಾಳೆನೆಬಿ ವಚ್ಮಾ ಐನ ತೆ ಐಗುಪ್ತವಾಲಾವೊನೆ ಅಂದಾರು ಕರ‍್ಯು ಇಸ್ರಾಯೆಲವಾಲಾವೊನಾ ಹುತಿ ರಾತಮಾಬಿ ಉಜಾಲು ಕರ‍್ಯು; ತೆ ರಾತಕ್ಹಾರಿ ಯಕ್ಲನಾ ನಜಿಕ ಯಕ್ಲಾ ಆಯಾ ನೈ. <verse eid="EXO 14:20" /><verse number="21" style="v" sid="EXO 14:21" />ಮೊಶೆ ಸಮುಂದರನ ಉಪ್ಪರ ಹತ್ತ ಅಗೊ ಕರೆಲ್ಪರ, ಯಹೊವಾ ತೆ ರಾತ ಕ್ಹಾರಿ ಮೂಡಣ ದಿಕ್ಕತು ಜೊ಼ರ ವಾರೊ ಆವಾಲಗಾಡಿನ ಸಮುಂದರನಾ ಪಾನಿನೆ ಯಕ್ಕ ಜ಼ಗಾ ಢಕ್ಲಿನ ತಿನಾ ಥಳಮಾ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ ದಿಕ್ಹಾ ವರಕ್ಹು ಕರ‍್ಯೊ. ಪಾನಿ ಬೆ ಭಾಗ ಥಯು. <verse eid="EXO 14:21" /><verse number="22" style="v" sid="EXO 14:22" />ಇಮ್ಮ ಇಸ್ರಾಯೆಲವಾಲಾ ಸಮುಂದರನಾ ವಚ್ಮಾ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನಪರ ಚಾ಼ಲಿನ ಗಯಾ. ಪಾನಿ ತ್ಯುನಾ ಸಿದಾಬಗಲ ವರಿ ರೊಡ್ಡಾಬಗಲಮಾ ಗೊಡಿನಿಂಗತ ಹುಬ್ರೈ ಪಡ್ಯುತು. <verse eid="EXO 14:22" /><verse number="23" style="v" sid="EXO 14:23" />ಐಗುಪ್ತವಾಲಾ ಕದ್ಯಾಮ ಫರೊಹನನಾ ಘೊಡಾ, ರಥೊ, ರಥೊ ಚ಼ಲಾವಾಲಾ ತ್ಯುನೊನೆ ಪಾಚಾ಼ ಲಾಗಿನ ತ್ಯುನಾ ಪಾಚಾ಼ಜ಼ ಸಮುಂದರನಾ ಮ್ಹೈ ಗಯಾ. <verse eid="EXO 14:23" /><verse number="24" style="v" sid="EXO 14:24" />ಪಾಟನಾ ಟೈಮಾ ಯಹೊವಾ ತೆ ಅಗ್ನಿ ಸ್ತಂಭ ವರಿ ಮೆಘ ಸ್ತಂಭೊಮಾತೊ ಐಗುಪ್ತವಾಲಾವೊನಾ ದಂಡನೆ ದೆಕಿನ ತ್ಯುನೊಮಾ ಗಲಿಬಿಲಿ ಉಂಟ ಕರ‍್ಯೊ. <verse eid="EXO 14:24" /><verse number="25" style="v" sid="EXO 14:25" />ಯಹೊವಾ ತ್ಯುನಾ ರಥೊನಾ ಗಾಲಿಯೊ ಕಾಡಿ ಪಡ್ಯಲಕ್ಹು ಐಗುಪ್ತವಾಲಾ ಘನಾ ಕಸ್ಟಕ್ಹು ರಥೊನೆ ಸಾಗ್ಸಿಲಿನ ಜೌ಼ ಲಾಗ್ಯು. ತೆಳಾಮಾ ಐಗುಪ್ತವಾಲಾ, "ಅಪೆ ಇಸ್ರಾಯೆಲೊನಾ ಕ್ಹಾಮಾ ಹುಬ್ರೆತಾ ನೈ, ನ್ಹಾಟಿನ ಗಯೆ; ಯಹೊವಾ ತ್ಯುನಾಹುತಿ ಅಪೊನೆ ವಿರದ್ದ ಥೈನ ಯುದ್ದ ಕರಾಡೊಸ” ಕೈನ ಕೈಲಿದ್ಯಾ. <verse eid="EXO 14:25" /><verse number="26" style="v" sid="EXO 14:26" />ತೆಕ್ಲಾಮಾಜ಼ ಯಹೊವಾ ಮೊಶೆನೆ, "ಸಮುಂದರನಾ ಉಪ್ಪರ ತಾರಾ ಹತ್ತನೆ ಅಗೊ ಕರ; ತೆಳಾಮಾ ತಿಮಾನು ಪಾನಿ ಪೈಲಾನಿಂಗತ ಐನ ಐಗುಪ್ತವಾಲಾವೊನೆ, ತ್ಯುನಾ ರಥೊನೆ, ರಥೊ ಚ಼ಲಾವಾಲಾವೊನೆ ಡುಬಾವಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 14:26" /><verse number="27" style="v" sid="EXO 14:27" />ತೆಳಾಮಾ ಮೊಶೆ ಸಮಂದರಪ ಹತ್ತ ಅಗೊ ಕರ‍್ಯೊ. ಪಾಟ ಥಾತಾಮಾ ಸಮುಂದರನು ಪಾನಿ ಪೈಲಾ ನಿಂಗತ ಭರಿಗಯು ಐಗುಪ್ತವಾಲಾ ನ್ಹಾಟಿನ ಜಾ಼ತಾಮಾ ತಿನಾ ಕ್ಹಾಮಾಜ ಆಯಾ. ಇಮ್ಮ ಯಹೊವಾ ಐಗುಪ್ತವಾಲಾವೊನೆ ಸಮುಂದರಮಾ ಢಕ್ಲಿ ಪಡ್ಯೊ. <verse eid="EXO 14:27" /><verse number="28" style="v" sid="EXO 14:28" />ಪಾನಿ ಪೈಲಾ ನಿಂಗತ ಐನ ತೆ ರಥೊನೆ, ರಥೊ ಚ಼ಲಾವಾಲಾವೊನೆ, ತ್ಯುನಾ ಪಾಚಾ಼ ಸಮುಂದರನಾ ಮ್ಹೈ ಗಯಲ ಫರೊಹನನಾ ಸೈನ್ಯವಾಲಾ ಕ್ಹಾರಾವೊನೆ ಡುಬೈ ಪಡ್ಯುತು. ತ್ಯುನಾಮಾ ಯಕ್ಲೊಬಿ ಉಗ್ರ್ಯೊ ನೈ. <verse eid="EXO 14:28" /><verse number="29" style="v" sid="EXO 14:29" />ತೆನೈಸೊ ಇಸ್ರಾಯೆಲವಾಲಾ, ಸಮುಂದರನಾ ಮ್ಹೈ ಕ್ಹುಕಿ ಜಿಮಿನಪರ ಚಾಲಿನ ಗಯಾ; ಪಾನಿ ತ್ಯುನಾ ಸಿದಾಬಗಲ ವರಿ ರೊಡ್ಡಾಬಗಲ ಗೊಡಿ ನಿಂಗತ ಹುಬ್ರೈಯುತು. <verse eid="EXO 14:29" /><verse number="30" style="v" sid="EXO 14:30" />ತೆ ದಿನ್ನಮಾ ಯಹೊವಾ ಇಸ್ರಾಯೆಲವಾಲಾವೊನೆ ಐಗುಪ್ತವಾಲಾವೊನಾ ಹತ್ತಮಾತೊ ವಚಾ಼ಡ್ಯೊ. ಐಗುಪ್ತವಾಲಾ ಮರಿನ ಸಮುಂದರನಾ ದಂಡಿಮಾ ಪಡಲ ಇಸ್ರಾಯೆಲವಾಲಾ ದೆಕ್ಯಾ. <verse eid="EXO 14:30" /><verse number="31" style="v" sid="EXO 14:31" />ಯಹೊವಾ ಐಗುಪ್ತವಾಲಾವೊಮಾ ಕರಲ ಆಂ ಮ್ಹೊಟು ಕಾಮ ಇಸ್ರಾಯೆಲವಾಲಾ ದೆಕಿನ ಯಹೊವಾನೆ ಬುಚ್ಕಿ಼ನ ತಿನಾಮಾಬಿ ತಿನೊ ಸೆವಕ ಥಯಲ ಮೊಶೆಪರಬಿ ಬರೊಕ್ಹೊ ಮ್ಹೆಲ್ಯಾ.<verse eid="EXO 14:31" /></para>
  <chapter eid="EXO 14" />
  <chapter number="15" style="c" sid="EXO 15" />
  <para style="s">ಮೊಶೆನು ಗಿದ್ದ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1" />ತೆಳಾಮಾ ಮೊಶೆ ಇಸ್ರಾಯೆಲವಾಲಾ ಯಹೊವಾನೆ ಸ್ತುತಿ ಕರಾನಾಹುತಿ ಆಂ ಗಿದ್ದನೆ ಕದ್ಯಾ: ಯಹೊವಾನೆ ಸ್ತೊತ್ರ ಗಿದ್ದ ಕರಿಯೆ; "ತೆ ಮಹಾ ಜಯ ಶಾಲಿ ಥಯಲವಾಲೊ ವ್ಹೈ; ಘೊಡಾವೊನೆ ವರಿ ರಥೊ ಚ಼ಲಾವಾಲಾವೊನೆ ಸಮುಂದರಪರ ಢಕ್ಲಿನ ನಾಶ ಕರ‍್ಯೊಸ. <verse eid="EXO 15:1" /><verse number="2" style="v" sid="EXO 15:2" />ಮಾರಿ ಶಕ್ತಿ, ಕಿರ್ತನೆಬಿ ಯಾಹುವೆಜ಼ ವ್ಹೈ, ತಿನಾಕ್ಹು ಮನೆ ರಕ್ಷನೆ ಥಯು. ಮಾರೊ ಕ್ಹುದಾ ತೆಜ಼ ವ್ಹೈ, ತಿನೆಜ಼ ಸುತ್ತಿ ಕರುಸ; ಮಾರಾ ಪೂರವಿಕೊನೊ ಕ್ಹುದಾ ತೆಜ಼ ವ್ಹೈ, ತಿನಿ ಮಹಿಮಾನೆ ಪ್ರಕ್ಯಾತಿ ಪಡಸುಸ. <verse eid="EXO 15:2" /><verse number="3" style="v" sid="EXO 15:3" />ಯಹೊವಾ ಯುದ್ದ ವಿರ ವ್ಹೈ; ಯಹೊವಾ ಕೈನ ತಿನು ನಾಮ ವ್ಹೈ.” <verse eid="EXO 15:3" /><verse number="4" style="v" sid="EXO 15:4" />ತೆ ಫರೊಹನನಾ ರಥೊನೆ, ಸೈನಿಕೊನೆ ಸಮುಂದರಮಾ ಢಕ್ಲಿ ಪಡ್ಯೊ. ಫರೊಹನನಾ ಚೊ಼ಕಾ ಅದಿಕಾರಿಯೊನೆ ಲಾಲ ಸಮಂದರಮಾ ಡುಬೈ ಪಡ್ಯೊ. <verse eid="EXO 15:4" /><verse number="5" style="v" sid="EXO 15:5" />ಉಂಡು ರ‍್ಹಯಲ ಸಮುಂದರ ತ್ಯುನೊನೆ ಝಾಕಿ ಪಡ್ಯುತು. ತ್ಯುನೆ ದಗ್ಡಾ ನಿಂಗತ ಸಮುಂದರನಾ ಥಳಮಾ ಡುಬ್ಯಾ. <verse eid="EXO 15:5" /><verse number="6" style="v" sid="EXO 15:6" />"ಯಹೊವಾ ತಾರಾ ಸಿದಾ ಹತ್ತಮಾ ರ‍್ಹಯಲ ತಾಕತ ಕೆಕ್ಲಿಕಿ ಮಹಿಮಾಕ್ಹು ಛೆ; ತಾರಾ ಸಿದಾ ಹತ್ತನಿ ತಾಕತಕ್ಹು ತು ವೈರಿಯೊನೆ ಛೆಟಿನ ಪುಡಿ ಪುಡಿ ಕರಶಿ. <verse eid="EXO 15:6" /><verse number="7" style="v" sid="EXO 15:7" />ತು ಮ್ಹೊಟಿ ಮಹತ್ವ ರ‍್ಹಯಲವಾಲೊ ಥೈನ ತಾರಾ ಕ್ಹಾಮಾ ಹುಬ್ರ್ಯಾವಾಲಾವೊನೆ ನಾಶ ಕರಿ ಪಡ್ಯೊಸ. ತಾರಿ ಶಿಟ್ಟ ಗೈನ ತ್ಯುನೊನೆ ಕ್ಹುಕ್ಹಾಯಲ ಚಾರೊ ನಿಂಗತ ಬಾಳಿನ ಬಸ್ಮ ಕರಿ ಪಡಿಸ. <verse eid="EXO 15:7" /><verse number="8" style="v" sid="EXO 15:8" />ತಾರಾ ನಾಕನಾ ಸ್ವಾಸಕ್ಹು ಸಮಂದರನು ಪಾನಿ ಮಳಿಗಯು; ಪ್ರವಾಹಬಿ ಗೊಡಿ ನಿಂಗತ ಹುಬ್ರಯುತು; ಸಮುಂದರನಾ ಥಳನು ಪಾನಿ ಘಟ್ಟ ಥಯು. <verse eid="EXO 15:8" /><verse number="9" style="v" sid="EXO 15:9" />ದುಶ್ಮನೊ, ‘ಹಮೆ ಇವ್ನೊನೆ ಪಾಚಾ಼ ಲಾಗಿನ ಧರಿಯೆಸ, ತ್ಯುನಾ ಸೊತ್ತನೆ ಅಪಹರಸಿನ ವಾಟಿಲಿಯೆಸ; ಹಮೆ ತಲ್ವಾರ ಧರಿನ; ತಾಕತಕ್ಹು ತ್ಯುನೊನೆ ಕತ್ರಿ ಪಡೆಸ’ ಕೈನ ಬೊಲ್ಲಿವಾಡಾತಾ. <verse eid="EXO 15:9" /><verse number="10" style="v" sid="EXO 15:10" />ತೆನೈಸೊ ತು ವಾರಾನೆ ಫುಕ್ಕಲಪರ, ಸಮಂದ ತ್ಯುನೊನೆ ಘಾಕಿಲಿದ್ಯತು; ತ್ಯುನೆ ಮಹಾ ಸಾಗರನಾ ಮ್ಹೈ ಸಿಸನಿ ಗೊಲಿ ನಿಂಗತ ಡುಬಿಗಯಾ. <verse eid="EXO 15:10" /><verse number="11" style="v" sid="EXO 15:11" />ಎ ಯಹೊವಾ, ಕ್ಹುದಾವೊಮಾ ತುನೆ ಕುನ್ನ ಸಮಾನ ವ್ಹೈ? ತಾರಾ ನಿಂಗತ ಪರಶುದ್ದಮಾ ಮಹಿಮಾ ಹೊಂದಲವಾಲೊ ಕುನ್ನ ಛೆ? ಅದ್ಬುತ ಕಾಮೊನೆ ಕರಲವಾಲೊ ಥಯಲ ಪರಾಕ್ರಮ ಶಾಲಿಬಿ ತುನೆ ಸಮಾನ ಕುನ್ನ ರ‍್ಹವಸ? <verse eid="EXO 15:11" /><verse number="12" style="v" sid="EXO 15:12" />ತು ತಾರೊ ಸಿದಾ ಹತ್ತನೆ ಅಗೊ ಕರಲ್ಪರ, ಜಿಮಿನಬಿ ಮ್ಹೊಡು ಕ್ಹೊಲಿನ ಶತೃವೊನೆ ಗಳಿಗಯುತೊ. <verse eid="EXO 15:12" /><verse number="13" style="v" sid="EXO 15:13" />ತಾರಾ ಒಡಂಬಡಿಕೆನಾ ನಂಬಿಗಸ್ತಮಾ ತು ತಾರಾ ಪ್ರಜೆನೆ ಛೊಡಾಯೊಸತೊ. ತಾರಾ ತಾಕತಕ್ಹು ತ್ಯುನೊನೆ ತು ವಾಸ ಕರಾನಾ ಪರಿಶುದ್ದ ನಿವಾಸನೆ ಚಲಾಯೊಸ. <verse eid="EXO 15:13" /><verse number="14" style="v" sid="EXO 15:14" />ಜನಾಂಗೊ ಆಂ ಐಕಿನ ಕಾಪಸ. ಪಿಲಿಷ್ಟಯಮಾ ರ‍್ಹಯಲವಾಲ ಭಯಬಿತ ಥಾವಸ. <verse eid="EXO 15:14" /><verse number="15" style="v" sid="EXO 15:15" />ಎದ್ಯೊಮಾನಾ ಅದಿಕಾರಿಯೊ ಭುಚ್ಕಸ; ಮೊವಾಬ್ಯರನಾ ಸೈನಿಕೊ ಕಾಪಸ; ಕಾನಾನ್ಯವಾಲಾ ನಿವಾಸಿಯೊ ಕ್ಹಾರಾ ಧೈರ್ಯ ಜವೈಲಿವಸ. <verse eid="EXO 15:15" /><verse number="16" style="v" sid="EXO 15:16" />ಭಯಬಿ, ಬುಚಕಬಿನ, ತ್ಯುನೊನೆ ಉಂಟಥಾವಸ. ತಾರಾ ಕ್ಹಾದಾನಿ ತಾಕತಕ್ಹು ತ್ಯುನೆ ದಗ್ಡಾ ನಿಂಗತ ಸ್ತಬ್ಧ ತಾವಾಸ. ತೆಕ್ಲಾಮಾಜ ಯಹೊವಾ, ಯೆಹೊವನೆ, ತು ವಚಾ಼ಡಲ ತಾರಾ ಪ್ರಜೆವೊ ದಾಡಿನ ಗೈನ ದೆಶನೆ ಸೆರಸ. <verse eid="EXO 15:16" /><verse number="17" style="v" sid="EXO 15:17" />ತು ತ್ಯುನೊನೆ ತಾರಾ ಸ್ವಕಿಯ ದೆಶ ಥಯಲ ಡೊಂಗರನಾ ಉಪ್ಪರ ಲೈನ ಬಲ ಪಡಸುಸ, ಯಹೊವಾ, ತು ಸ್ವಂತ ನಿವಾಸನಾ ಹುತಿ ಭಾಂದಿಲಿದಲ ಜ಼ಗಾಲಕ್ಕಾ ಕರ್ತಾ, ತು ಮಾರಾಹುತಿ ಸಿದ್ದ ಕರಲಿದಲ ಪವಿತ್ರ ಪರ್ವತಲಕ್ಕಾ ತ್ಯುನೊನೆ ಆಯೆಲಿಂಗತ ಕರಶಿ. <verse eid="EXO 15:17" /><verse number="18" style="v" sid="EXO 15:18" />ಯಹೊವಾ ಯುಗಯುಗಾಂತರಮಾ ರಾಜೊ ಥೈನ ಆಳಸ,”<verse eid="EXO 15:18" /></para>
  <para style="s">ಮಿರ್ಯಾಮನು ಗಿದ್ದ</para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19" />ಫರೊಹನನಾ ಘೊಡಾ, ರಥಾವೊ, ರಾಹುತರೊ ಸಮುಂದರನಾ ಮ್ಹೈ ಆಯಲ್ಪರ ಯಹೊವಾ ಸಮುಂದರನಾ ಪಾನಿನೆ ತ್ಯುನಾ ಉಪ್ಪರ ಫರಿನ ಆವಾಲಗಾಡಿನ ಡುಬೈಜ ಪಡ್ಯೊ. ತೆನೈಸೊ ಇಸ್ರಾಯೆಲೊ ರ‍್ಹಯತಬಿ ಸಮುಂದರನಾ ವಚ್ಮಾ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನಪರ ಚಾಲಿನ ಗಯಾ. <verse eid="EXO 15:19" /><verse number="20" style="v" sid="EXO 15:20" />ತೆಳಾಮಾ ಪ್ರವಾದಿ ಥಯಲ ಆರೊನನಿ ಬ್ಹೆನ ಮಿರ್ಯಾಮಳ ಹತ್ಮಾ ತಾಳಾವೊನೆ ಕಾಡಿಲಿದಿ. ಹೆಣ್ಣಮನಕ್ಹೊ ಕ್ಹಾರಾ ಹತೊಮಾ ತಾಳವೊನೆ ಧರಲಿನ ಗಿದ್ದ ಕಾತಾ ನ್ಹಾಚತಾ ತಿನಾ ಪಾಚಾ ಗಯಾ. <verse eid="EXO 15:20" /><verse number="21" style="v" sid="EXO 15:21" />ಮಿರ್ಯಾಮಳ ತ್ಯುನೊನೆ ಅಮ್ಮ ಕದಿ: "ಯಹೊವಾನೆ ಗಿದ್ದ ಕವೊ, ತೆ ಮಹೊನ್ನತ ಥಯಲ ಕ್ಹುದಾ ಥಯಸೊ. ಘೊಡಾವೊನೆ, ರಾಹುತರೊನೆ ಸಮಂದರಮಾ ಡುಬೈನ ನಾಶ ಕರ‍್ಯೊ.”<verse eid="EXO 15:21" /></para>
  <para style="s">ಕಡು ಪಾನಿ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22" />ತೆ ಥಯಲ್ಪರ ಮೊಶೆ ಇಸ್ರಾಯೆಲೊನೆ ಲಾಲ ಸಮುಂದರನಾ ಮೂಲಕ ಥೈನ ಚಲಾಯೊ. ತ್ಯುನೆ ಶುರ ಉಸಕನಿ ಜಿಮಿನಮಾ ತನ್ನ ದಿನ ಪಾನಿ ನೈಸೊ ಪ್ರಮಾಣ ಕರ‍್ಯಾ. ತೆನೈಸೊ ತ್ಯುನೊನೆ ಕಿಜಾಜ ಮಳ್ಯು ನೈ. <verse eid="EXO 15:22" /><verse number="23" style="v" sid="EXO 15:23" />ಪಾಚತಾ ತ್ಯುನೆ ಮಾರಾ ಕವಾನಾ ಜ಼ಗಾಕನ ಆಯಾ. ತೆ ನೈಸೊ ತೆ ಜ಼ಗಾನು ಪಾನಿ ಕಹಿ ಥಯಲಕ್ಹು ತ್ಯುನೊನೆ ತಿನೆ ಪಿವಾನಾಹುತಿ ಥಯಜ ನೈ. ತಿನಾಹುತಿ ತೆ ಜ಼ಗಾನೆ ಮಾರಾ ಕೈನ ನಾಮ ಥಯು. ಮಾರಾ ಕದ್ಯಾಮ ಕಡು ವ್ಹೈ. <verse eid="EXO 15:23" /><verse number="24" style="v" sid="EXO 15:24" />ಮನಕ್ಹೊ ಮೊಶೆನೆ, "ಹಮೆ ಸು ಪಿಯು? ಕೈನ ತಿನೆ ವಿರುದ್ದ ಥೈನ ಗುಣಗುಟ್ಯಾ. <verse eid="EXO 15:24" /><verse number="25" style="v" sid="EXO 15:25" />ಮೊಶೆ ಯಹೊವಾನೆ ಪ್ರಾರ್ಥಾನಾ ಕರ‍್ಯೊ. ತೆಳಾಮಾ ಯಹೊವಾ ತಿನೆ ಯಕ್ಕ ಝಾಡನೆ ದೆಕಾಡ್ಯೊ. ತೆ ತಿನೆ ಪಾನಿಮಾ ಘಾಲಲ್ಪರ, ಪಾನಿ ಗಳು ಥಯು. ತ್ಯಾ ಯಹೊವಾ ಇಸ್ರಾಯೆಲೊನಾ ಹುತಿ ಯಕ್ಕ ನಿಯಮ ಕರಿನ ತ್ಯುನೊನೆ ಪರಿಕ್ಷಾ ಕರ‍್ಯೊ. <verse eid="EXO 15:25" /><verse number="26" style="v" sid="EXO 15:26" />ಯಹೊವಾ ತ್ಯುನೊನೆ, "ತುಮೆ ತುಮರಾ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ವಾತೊನೆ ಶ್ರದ್ದಾಕ್ಹು ಐಕಿನ, ತಿನಾ ನಜರನೆ ಚೊ಼ಕು ರ‍್ಹವಾನು ಕರಿನ, ತಿನಾ ಆಜ್ಞಾನೆ ವಿದೆಯೆ ಥೈನ, ತಿನಾ ಕಟ್ಟಡೊನೆ ಕ್ಹಾರಾ ಅನುಸರಸಿನ ಚಾಲ್ಯಾಮ, ಮಿ ಐಗುಪ್ತೊನೆ ಉಂಟಕರಲ ವ್ಯಾದಿಯೊಮಾ ಯಕ್ಕನೆಬಿ ತುಮೊನೆ ನೈ ಆವಾಲಗಾಡತೊ. ಯಹೊವಾ ಕವಾಲೊ ಮಿಜ಼ ತುಮೊನೆ ಆರ‍್ಯೊಗ್ಯ ದಾಯಕ ವ್ಹೈ, ತುಮೊನೆ ಅರಾಮ ಕರಾಲೊ ಥಯೊಸ ಕೈನ” ಕದ್ಯೊ. <verse eid="EXO 15:26" /><verse number="27" style="v" sid="EXO 15:27" />ತೆ ಥಯಲ್ಪರ ತ್ಯುನೆ ಎಲಿಮಿನೆ ಆಯಾ. ತ್ಯಾ ಬಾರಾ ಪಾನಿನಾ ಕ್ಹಾಡಿಯೊ ಸತ್ತರ ಖಜುರನಾ <note caller="+" style="f"><char style="fr" closed="false">15:27 </char></note>ಝಾಡೊ ವ್ಹತ್ತಾ. ತೆ ಪಾನಿನಾ ಬಾಜು಼ಮಾ ತ್ಯುನೆ ಉತ್ರ್ಯಾ.<verse eid="EXO 15:27" /></para>
  <chapter eid="EXO 15" />
  <chapter number="16" style="c" sid="EXO 16" />
  <para style="s">ಮನ್ನ ವರಿ ಲಾವಕ್ಕಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1" />ಇಸ್ರಾಯಲ ಸಮೂಹನಾ ಕ್ಹಾರಾ ಎಲಿಮೆನತಾ ಪ್ರಯಾಣ ಕರಿನ ತ್ಯುನೆ ಐಗುಪ್ತ ದೆಶತಾ ಬೆವಾ ಮ್ಹೈನಾನಾ ಪಂದ್ರಾವಾ ದಿನಮಾ ಎಲಿಮಿನೆ ಸಿನಾಯ ಡೊಂಗರನೆಬಿ ವಚ್ಮಾ ರ‍್ಹವಾನಾ ಸಿನ ಕವಾನಾ ಉಸಕನಿ ಜಿಮಿನೆ ಆಯಾ. <verse eid="EXO 16:1" /><verse number="2" style="v" sid="EXO 16:2" />ತೆಳಾಮಾ ಇಸ್ರಾಯಲನಾ ಸಮೂಹ ಕ್ಹಾರು ಉಸಕಿನಿ ಜಿಮಿನಮಾ ಮೊಶೆ ವರಿ ಆರೊನನಾ ಉಪ್ಪರ ಗುಣ ಗುಟ್ಯಾ. <verse eid="EXO 16:2" /><verse number="3" style="v" sid="EXO 16:3" />ಇಸ್ರಾಯೆಲೊ ಮೊಶೆ ವರಿ ಆರೊನನೆ, "ಆ ಸಮೂಹನಾ ಕ್ಹಾರು ಭುಕ್ಕಕ್ಹು ಕ್ಹಲಾಸ ಕರು ಕೈನ ತುಮೆ ಹಮೊನೆ ಆ ಉಸಕನಿ ಜಿಮಿನನೆ ಬಲೈಲಿನ ಆಯಾಸ. ಹಮೆ ಐಗುಪ್ತ ದೆಶಮಾ ರ‍್ಹತಾಮಾ ಮಾಕ್ಹನಾ ಸಮೊನೊನಾ ಬಾಜು಼ಮಾ ಬೈಟಿನ ಪೆಟ ಭರಿನ ರೊಕ್ಲೊ ಕ್ಹಾತಾಮಾ ಯಹೊವಾನಾ ಹತ್ತಕ್ಹು ಮರಿ ಜಾ಼ವತ್ತೊ ಕೆಕ್ಲು ಚೊಕು ವ್ಹತ್ತು” ಕದ್ಯಾ. <verse eid="EXO 16:3" /><verse number="4" style="v" sid="EXO 16:4" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆನೆ, "ಮಿ ಹಬಾಳತೊ ತುಮಾರಾಹುತಿ ಅನ್ನನೆ ರಿಚೌಸ. ಮನಕ್ಹೊ ಹರಯಕ್ಕ ದಿನ್ನೆ ಭಾರಾ ಗೈನ ತೆ ದಿನನೆ ಚಾ಼ಯೆ ಥಾಯಲಕ್ಲು ತೆಕ್ಲುಜ಼ ಜಮಾ ಕರಲ್ಯೂ. ಅನಾಕ್ಹು ತ್ಯುನೆ ಮಾರಾ ಆಜ್ಞೆವೊನೆ ಅನುಸರಸಿನ ಚಾ಼ಲಸ ಸು ನೈ ಕೈನ ತಿಳ್ದಿ ಲ್ಯುಸ. <verse eid="EXO 16:4" /><verse number="5" style="v" sid="EXO 16:5" />ಛೆಂವಾ ದಿನಮಾ ತ್ಯುನೆ ಲಾಯಲನೆ ತೆ ಹರಯಕ್ಕ ದಿನಮಾ ಜಮಾ ಕರಲತಿ ದುಪ್ಪಟ ಥಾವಸ ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 16:5" /><verse number="6" style="v" sid="EXO 16:6" />ಮೊಶೆ ವರಿ ಆರೊನಬಿ ಇಸ್ರಾಯೆಲೊನೆಬಿ, "ತುಮೊನೆ ಐಗುಪ್ತ ದೆಶಮಾತೊ ಭಾರೊ ಆವಾ ಕರಲವಾಲೊ ಯಹೊವಾಜ ವ್ಹೈ ಕೈನ ಆಜ ಕ್ಹಾಂಜ಼ನಾ ಟೈಮಾ ತುಮೊನೆ ಗ್ವತ್ತಥಾವಸ. <verse eid="EXO 16:6" /><verse number="7" style="v" sid="EXO 16:7" />ಪಾಟಮಾ ಯಹೊವಾನಾ ಮಹಿಮೆ ತುಮೊನೆ ದಿಕ್ಹಸ, ಕಾ ಕದ್ಯಾಮ ತುಮೆ ಯಹೊವಾನೆ ವಿರೊದ ಥೈನ ಗುಣ ಗುಟ್ಟಲ ತೆ ಐಕ್ಯೊಸ. ಹಮಾರಾ ಉಪ್ಪರ ತುಮೆ ಗುಣಗುಟ್ಟಾನು ಸುವೈ? ಹಮೆ ಕೆಕ್ಲಾ ಚಾ಼ಯೆ ಥಯಲವಾಲಾ ಕೈನ ಕದ್ಯಾ. <verse eid="EXO 16:7" /><verse number="8" style="v" sid="EXO 16:8" />ತೆಳಾಮಾ ಮೊಶೆ "ಯಹೊವಾ ಕ್ಹಾಂಜ಼ನಾ ಟೈಮಾ ಮ್ಹಾಕ, ಪಾಟಮಾ ಚಾ಼ಯೆ ಅಕ್ಲಾ ರೊಕ್ಲಾವೊನೆ ದ್ಯುಸ. ತುಮಾರು ಗುಣಗುಟ್ಟಾನು ಯಹೊವಾನೆ ಐಕೈಯು. ಮಿ ವರಿ ಆರೊನ ಕಕ್ಲಾ ವ್ಹೈ? ತುಮಾರು ಗುಣಗುಟ್ಟಾನು ಯಹೊವಾನಾ ವಿರುದ್ದ ವ್ಹೈ ನೈತೊ ಅಪ್ನಾ ವಿರುದ್ದ ನವೈ” ಕದ್ಯೊ. <verse eid="EXO 16:8" /><verse number="9" style="v" sid="EXO 16:9" />ಮೊಶೆ ಆರೊನನೆ, "ತು ಇಸ್ರಾಯಲನಾ ಸಮಾಜ ಕನ ಗೈನ ತ್ಯುನೊನೆ, ‘ಯಹೊವಾ ತುಮಾರು ಗುಣಗುಟ್ಟಾನು ಐಕೊಸ. ತಿನಾಹುತಿ ತುಮೆ ಕ್ಹಾರಾ ತಿನಾ ಸನ್ನಿದಿನೆ ವಗ್ಗಟ ಥೈನ ಮಳಿನ ಔಕೈನ ಆಜ್ಞಾಕರ”’ ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 16:9" /><verse number="10" style="v" sid="EXO 16:10" />ಆರೊನ ಇಸ್ರಾಯಲನಾ ಕ್ಹಾರಾ ಸಮಾಜನೆ ಆ ವಾತೊನೆ ತಿಳಸತಾ ಟೈಮೆ, ತ್ಯುನೆ ಉಸಕನಿ ಜಿಮಿನಕನ ದೆಕ್ತಾಮಾ, ಮೆಘಮಾ ಯಹೊವಾನು ಮಹಿಮಾ ತ್ಯುನೊನೆ ದಿಕ್ಹ್ಯೊ. <verse eid="EXO 16:10" /><verse number="11" style="v" sid="EXO 16:11" />ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ಬೊಲನ ಕದಲ ಸುವೈ ಕದ್ಯಾಮ, <verse eid="EXO 16:11" /><verse number="12" style="v" sid="EXO 16:12" />ಇಸ್ರಾಯೆಲೊ ಗುಣಗುಟ್ಟಾನು ಮನೆ ಐಕೈಯು. ತು ತ್ಯುನೊನೆ, ‘ತುಮೆ ಕ್ಹಾಂಜಮಾ ಮಾಕ್ಹನೆ, ಪಾಟಮಾ ಚಾ಼ಯೆ ಅಕ್ಲಾ ರೊಕ್ಲಾವೊನೆ ಕ್ಹಾಸಕೊಸಿ. ಇನಾಕ್ಹು ಮಿ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ವ್ಹೈಕೈನ ತುಮೊನೆ ಗ್ವತ್ತಥಾವಸ ಕೈನ ಕೌ”’ ಕವಾನು. <verse eid="EXO 16:12" /><verse number="13" style="v" sid="EXO 16:13" />ಕ್ಹಾಂಜ ಥಾತಾಮಾ ಲಾವಕ್ಕಿಯೊ ಐನ ತ್ಯುನಾ ಪಾಳೆಯನ ಭರಿಗಯಾ. ತೆನೈಸೊ ಹೊತ್ತಾರಮಾ ಇಬ್ಬನ್ನಿ ಪಾಳೆಯೆನಾ ಸುತ್ತೆಬಿ ಪಡಿತಿ. <verse eid="EXO 16:13" /><verse number="14" style="v" sid="EXO 16:14" />ತೆ ಇಬ್ಬನ್ನಿ ಕರಗಲ ಪರ ಉಸಕನಿ ಜಿಮಿನಮಾ ಇಬ್ಬನಿನಾ ಬುಂದೊ ನಿಂಗತ ಸು ಯಕ್ಕ ನ್ಹಾನ್ಹಾ ರವಾ ದಿಕ್ಹಿ. <verse eid="EXO 16:14" /><verse number="15" style="v" sid="EXO 16:15" />ಇಸ್ರಾಯೆಲೊ ತೆ ದೆಕಿನ ಯಕ್ಲಾನೆ ಯಕ್ಲೊ, "ಆ ಸುವೈ? ಕೈನ ಬೊಲಿದ್ಯಾ. ತೆ ಸುವೈ ಕೈನ ತ್ಯುನೊನೆ ತಿಳದ್ಯು ನೈ. ಮೊಶೆ ತ್ಯುನೊನೆ, " ಆ ಯಹೊವಾ ತುಮಾರಾಹುತಿ ಕ್ಹಾವಾನಾಹುತಿ ದಿದಲ ರೊಕ್ಲಾ ಥಯಾಸ. <verse eid="EXO 16:15" /><verse number="16" style="v" sid="EXO 16:16" />ಯಹೊವಾ ಅನಾ ವಿಷಯಮಾ ಆಜ್ಞಾ ಕರಲ ಸುವೈ ಕದ್ಯಾರೆ: ಹರಯಕ್ಲೊ ತಿನಾ ಕುಟಂಬವಾಲಾನಾ ಸಂಖ್ಯಾನಾ ಅನುಸಾರ ಮಾತಾನೆ ತನ್ನ ಸೆರ ನಿಂಗತ ತಿನಾ ಬಿಜಾ಼ವೊನಾ ಹುತಿ ಜಮಾ ಕರಾದೆ. ಹರಯಕ್ಲೊ ತೆ ಕೆಕ್ಲು ಕ್ಹಾವಸತೊ ತೆಕ್ಲು ತುಮೆ ಜಮಾ ಕರಲಿವೊಸಿ” ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 16:17" />ಇಸ್ರಾಯೆಲೊ ತಿಮ್ಮಜ಼ ಕರ‍್ಯಾ. ದಕ್ಹಾಜ಼ನಾ ಹೆಚ್ಚ ದಕ್ಹಾಜ಼ನಾ ಕಮ್ಮ ಜಮಾ ಕರಲಿದ್ಯಾ. <verse eid="EXO 16:17" /><verse number="18" style="v" sid="EXO 16:18" />ತ್ಯುನೆ ತಿನೆ ಶೆರಕ್ಹು ಅಳತಿ ಕರ‍್ಯಾ. ಘನಾ ಜಮಾ ಕರಲವಾಲಾನೆ ಸುಜ ಹೆಚ್ಕಿ ಥಯು ನೈ, ದಕ್ಹಾ ಜಮಾ ಕರಲವಾಲಾನೆ ಸುಜ ಕಮ್ಮ ಥಯು ನೈ. ಹರಯಕ್ಲೊ ತ್ಯುನಾ ಭೊಜನನೆ ಕರೆಟ್ಟ ಥಾವಾ ವರಕ್ಹು ಜಮಾ ಕರಲಿದ್ಯೊತೊ. <verse eid="EXO 16:18" /><verse number="19" style="v" sid="EXO 16:19" />ತೆನೈಸೊ ಮೊಶೆ ತ್ಯುನೊನೆ, "ಅನೆ ಕುನ್ನಜ ವಂತಾ ಲಕ್ಕಾ ಮ್ಹಲ್ಯುಜ ನೈ”ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 16:19" /><verse number="20" style="v" sid="EXO 16:20" />ತೆ ಥಯಲ್ಪರ ತ್ಯುನೆ ಮೊಶೆನಾ ವಾತ ನೈ ಐಕ್ಯಾಮ ತಿಮಾನು ದಕ್ಹುನೆ ಅಗಲ್ಯಾ ದಿನ್ನ ಲಕ್ಕಾ ಮ್ಹೆಲ್ಲಿದ್ಯಾಮ ತಿಮಾ ಕಿಡಾ ಪಡಿನ ಗಂದಬಾಸ ಧರಿನ ಕೆಟ್ಟಿಗಯು. ತೆನೆ ಮೊಶೆ ತ್ಯುನಾ ಉಪ್ಪರ ಸಿಟ್ಟ ಕರ‍್ಯೊ. <verse eid="EXO 16:20" /><verse number="21" style="v" sid="EXO 16:21" />ಮನಕ್ಹೊ ಹರದಿನ್ನೆ ಪಾಟಮಾ ತ್ಯುನಾ ಭೊಜನನೆ ಚಾ಼ಯೆ ಅಕ್ಲು. ಜಮಾ ಕರಲಿದ್ಯಾ. ತಡಕೊ ಹೆಚ್ಚ ಥಾತಾಮಾ ತೆ ಕರಗಿನ ಜಾ಼ತುತು. <verse eid="EXO 16:21" /><verse number="22" style="v" sid="EXO 16:22" />ಛೆವಾ ದಿನೆ ದುಪ್ಪಟ್ಟ ಕ್ಹಾವಾನಾಹುತಿ, ಕದ್ಯಾಮ ಯಕ್ಕ ಯಕ್ಲಾನೆ ಶೆರ ನಿಂಗತ ಇನಿಲಿನ ಭರಲಕ್ಹು ಸಮೂಹನಾ ಅದಿಕಾರಿ ಕ್ಹಾರಾ ಮೊಶೆಕನ ಐನ ಆ ಸಂಗತಿನೆ ತಿಳಸ್ಯಾ. <verse eid="EXO 16:22" /><verse number="23" style="v" sid="EXO 16:23" />ತಿನೆ ತೆ, " ಆ ಯಹೊವಾ ಕದಲ ವಾತ, ‘ವಂತಾ ಯಹೊವಾನೆ ಅರಾಮ ಕರಾನು ಪರಿಶುದ್ದ ಸಬ್ಬತ ದಿನ ಥಯುಸ. ಆ ದಿನಮಾ ಬಾಳಾನು ಬಾಳಿನ ಬೆಯಿಸಾನು ಬೆಸೊ. ಅಮಾ ಉಗ್ರಲಕ್ಹಾರು ವಂತಾ ಲಕ್ಕಾ ಮ್ಹೆಲ್ಲಿಯೊ’” ಕದ್ಯೊ. <verse eid="EXO 16:23" /><verse number="24" style="v" sid="EXO 16:24" />ಮೊಶೆ ಆಜ್ಞಾ ಕರಲನಿಂಗತ ತ್ಯುನೆ ಅಗಲ್ಯಾ ದಿನ್ನ ಲಕ್ಕಾ ತಿನೆ ಮ್ಹೆಲ್ಲಿದ್ಯಾ. ತೆ ನೈಸೊ ತೆ ಕೆಟ್ಟಲ ನ್ಹೊತು, ಕಿಡಾ ಪಡ್ಯಾಬಿ ನೈ. <verse eid="EXO 16:24" /><verse number="25" style="v" sid="EXO 16:25" />ಪಾಚಾತೊ ಮೊಶೆ ತ್ಯುನೊನೆ, "ಆ ಟೈಮಾ ತಿನೆ ಕ್ಹಾವೊ. ಆ ದಿನ್ನೆ ಯಹೊವಾನು ಸಬ್ಬತ ದಿನ ರ‍್ಹಯಲಕ್ಹು ಆ ದಿನ ತೆ ಕ್ಹೆತರಮಾ ದಿಕ್ಹತು ನೈ. <verse eid="EXO 16:25" /><verse number="26" style="v" sid="EXO 16:26" />ಛೆ ದಿನ್ನ ತಿನೆ ಜಮಾ ಕರು. ಕ್ಹಾತವಾ ದಿನ್ನ ಸಬ್ಬತ ದಿನ ರ‍್ಹಯಲಕ್ಹು ತೆ ದೊರಕತು” ನೈ ಕೈನ ಕದ್ಯೊ ತೆ ತಿಮ್ಮಜ಼ ಥಯು. <verse eid="EXO 16:26" /><verse number="27" style="v" sid="EXO 16:27" />ಮನಕ್ಹೊಮಾ ದಕ್ಹಾಜ಼ನಾ ಕ್ಹಾತವಾ ದಿನ್ನಮಾ ತಿನೆ ಜಮಾ ಕರಲಿವಾನಾ ಹುತಿ ಜಾ಼ತಾಮಾ ತ್ಯುನೊನೆ ಸುಜ ಮಳ್ಯು ನೈ. <verse eid="EXO 16:27" /><verse number="28" style="v" sid="EXO 16:28" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆನೆ, " ತುಮೆ ಕಿಜಾ಼ಲಕ್ಕಾ ಮಾರಾ ಆಜ್ಞಾನ್ಯಾವೊನೆ, ಮಿ ಕರಲ ನಿಯಮೊನೆ ನೈ ಅನುಸರಸಿನ ಅಲಕ್ಷ್ಯ ಕರೊಸಿ? <verse eid="EXO 16:28" /><verse number="29" style="v" sid="EXO 16:29" />ದೆಕೊ, ಯಹೊವಾ ತುಮೊನೆ ಸಬ್ಬತ ದಿನನೆ ಆಚರಣೆ ಕರುಕೈನ ಅಪ್ಪಣೆ ದಿದಕ್ಹು ಛೆವಾ ದಿನಮಾ ಬೆ ದಿನನೂ ಅನ್ನನೆ ತುಮೊನೆ ಮಳಾ ವರಕ್ಹು ಅನುಗ್ರಹಶ್ಯೊಸ. ತುಮಾರಾಮಾ ಹರಯಕ್ಲೊ ತ್ಯುನೆ ರ‍್ಹವಾನಾ ಜ಼ಗಾಮಾ ರ‍್ಹೌ. ಕ್ಹಾತವಾ ದಿನಮಾ ಯಕ್ಲೊ ತಿನಿ ಜ಼ಗಾ ಛೊಡಿನ ಭಾರೊ ಜೌ಼ ನೈ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 16:29" /><verse number="30" style="v" sid="EXO 16:30" />ತಿನಾಹುತಿ ಕ್ಹಾತವಾ ದಿನಮಾ ಮನಕ್ಹೊ ಕಾಮ ನೈ ಕರಿನ ಅರಾಮ ಕರ‍್ಯಾ.<verse eid="EXO 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31" />ಇಸ್ರಾಯೆಲೊ ತೆ ಅನ್ನನೆ "ಮನ್ನ” ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯಾ. ತೆ ಧೊಳಿ ಕೊತಮಿರನಾ ಕಾಳ ನಂಗತ ವ್ಹತ್ತು ರುಚಿಮಾ ಜೆನ ತುಪ್ಪ ನಂಗತ ಕರಲ ದೊಶಿ ನಂಗತ ವ್ಹತ್ತು. <verse eid="EXO 16:31" /><verse number="32" style="v" sid="EXO 16:32" />ಮೊಶೆ ಮನಕ್ಹೊನೆ, "ಯಹೊವಾ ಆಜ್ಞಾ ಕರಲ ಆಜ ವ್ಹೈ, ‘ ಮಿ ಐಗುಪ್ತ ದೆಶತೊ ತುಮೊನೆ ಆವಾ ಲಗಾಡಿನ ಉಸಕನಿ ಜಿಮಿನಮಾ ಕ್ಹಾವಾನಾಹುತಿ ದಿದಲ ಅನ್ನನೆ ತುಮಾರಾ ಸಂತಾನವಾ ದೆಕಾನಿಂಗತ ತ್ಯುನಾ ತುಮೆ ಯಕ್ಕ ಶೆರ ಮನ್ನನೆ ಭರಿನ ಸುರಕ್ಷಿತ ಥೈನ ಮ್ಹೆಲ್ಲಿವೊ’” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 16:32" /><verse number="33" style="v" sid="EXO 16:33" />ತಿನಾಹುತಿ ಮೊಶೆ ಆರೊನನೆ, " ತು ಯಕ್ಕ ತಪಾಲೊ ಕಾಡಿಲಿನ, ತಿಮಾ ಯಕ್ಕ ಶೆರ ಅಕ್ಲು ಮನ್ನ ಘಾಲಿನ ತುಮಾರಾ ಸಂತತಿವಾಲಾ ದೆಕಾನಾಹುತಿ ತೆ ಯಹೊವಾನಿ ಸನ್ನಿದಿಮಾ ಮ್ಹೆಲು” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 16:33" /><verse number="34" style="v" sid="EXO 16:34" />ಯಹೊವಾ ಮೊಶೆನೆ ಆಜ್ಞಾ ಕರಲನಿಂಗತ, ಆರೊನಬಿ ಆಜ್ಞಾ ಶಾಸನನಾ ಮಂಜುಶನಾ ಬಾಜು಼ಮಾ ತಿನೆ ಉತಾರ‍್ಯೊ. <verse eid="EXO 16:34" /><verse number="35" style="v" sid="EXO 16:35" />ಇಸ್ರಾಯೆಲೊ ತ್ಯುನೆ ವಾಸ ಕರಲ ಪ್ರದೆಶನೆ ಆಯೆಲಕ್ಕಾ ಕದ್ಯಾಮ ಕಾನಾನ್ ದೆಶನೆ ಐನ ಮುಟ್ಟೆಲಕ್ಕಾ ಚಾಳಕ್ಹ ವರಕ್ಹ ಮನ್ನಜ ಕ್ಹಾದ್ಯಾ. <verse eid="EXO 16:35" /><verse number="36" style="v" sid="EXO 16:36" />ಓಮೆರ್ ಕವಾನು ಎಫಾಮಮಾ ದಕ್ಹವಾನು ಯಕ್ಕ ಪಾಲ ಧರಾ ವರಕ್ಹು ಯಕ್ಕ ಆಳತೆನಾ ಮಾಪನ ಥಯುಸ.<verse eid="EXO 16:36" /></para>
  <chapter eid="EXO 16" />
  <chapter number="17" style="c" sid="EXO 17" />
  <para style="s">ಮ್ಹೊಟಾ ದಗ್ಡಾಮಾತು ಪಾನಿ ಆವಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1" />ತೆ ಥಯಲ್ಪರ ಇಸ್ರಾಯಲನಾ ಸಮೂಹ ಕ್ಹಾರಾ ಯಹೊವಾನಾ ಅಪ್ಪಣೆನಾ ಮೆರೆನೆ " ಸಿನ ಕವಾನಾ ಉಸಕನಿ ಜಿಮಿನತಾ ಗೈನ ಅಗಾ ಪ್ರಯಾಣ ಕರಿನ ರೆಫಿದಿಮಾ ಉತ್ರ್ಯಾ. ತ್ಯಾಬಿ ಮನಕ್ಹೊನಾ ಪಿವಾನಾಹುತಿ ಪಾನಿ ನೊತು. <verse eid="EXO 17:1" /><verse number="2" style="v" sid="EXO 17:2" />ತಿನಾಹುತಿ ಮನಕ್ಹೊ ಮೊಶೆನಾ ಉಪ್ಪರ ಗುಣಗುಟ್ಟತಾ "ಹಮೊನೆ ಪಿವಾನಾಹುತಿ ಪಾನಿ ಲೈನ ದ್ಯು” ಕೈನ ಗದ್ದಲ ಉಚಾವಾನೆ, ಮೊಶೆ ತ್ಯುನೊನೆ, " ಮಾರಾ ಕ್ಹಾತೆ ಕಾ ವಾದ-ವಿವಾದ ಕರೊಸಿ? ಯಹೊವಾನೆ ಕಾ ಪರಿಕ್ಷಾ ಕರೊಸಿ? ಕದ್ಯೊ. <verse eid="EXO 17:2" /><verse number="3" style="v" sid="EXO 17:3" />ತ್ಯಾ ಮನಕ್ಹೊ ಪಾನಿನಾ ತರಕ್ಹು, ಮೊಶೆ ವಿರುದ್ದ ಥೈನ ಗುಣ ಗುಟ್ಟಿನ, " ತು ಹಮೊನೆ, ಹಮಾರಾ ಬಚ್ಚಾ಼ವೊನೆ, ಜಾನವರೊ ಐಗುಪ್ತ ದೆಶತು ಯ್ಹಾ ಬಲೈಲಿನ ಅಮ್ಮ ಪಾನಿ ನೈಸೊ ಮರಾ ವರಕ್ಹಾ ಕರಲ ಕಾವೈ? ಕದ್ಯಾ. <verse eid="EXO 17:3" /><verse number="4" style="v" sid="EXO 17:4" />ತೆಳಾಮಾ ಮೊಶೆ ಯಹೊವಾನೆ ಮೊರೆ ಮ್ಹೆಲ್ಯೊ, " ಆ ಮನಕ್ಹೊನಾ ಹುತಿ ಮಿ ಸು ಕರು? ತ್ಯುನೆ ಮನೆ ದಗ್ಡೊ ನಾಕಿನ ತಿಮ್ಮ ಛೆತೊ” ಕದ್ಯೊ.<verse eid="EXO 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5" />ತಿನಾಹುತಿ ಯಹೊವಾ ಮೊಶೆನೆ, "ತು ನೈಲ ನದಿನೆ ಫೊಡಲ ಲಾಕಡಿನೆ ಹತ್ಮಾ ಧರಲಿನ ಇಸ್ರಾಯಲನಾ ಮ್ಹಟಾವೊಮಾ ದಕ್ಹಾವೊನೆ ಬಲೈಲಿನ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮಾ ಗೈನ, ಮಿ ದೆಕ್ಲಾಡಾನಾ ಜ಼ಗಾನೆ ಜಾ಼. <verse eid="EXO 17:5" /><verse number="6" style="v" sid="EXO 17:6" />ತ್ಯಾ ಸಿನ ರ‍್ಹಯಲ ದಗ್ಡಾನಾ ಉಪ್ಪರ ಮಿಜ಼ ತುನೆ ಎದುರ ಥೈನ ಹುಬ್ರವುಸ. ತು ತೆ ದಗ್ಡೊ ಫೊಡಲ್ಪರ, ಮನಕ್ಹೊ ಪಿವಾನು ಪಾನಿ ಭಾರು ಆವಸ” ಕದ್ಯೊ. ಮೊಶೆ ಇಸ್ರಾಯಲನಾ ಮ್ಹೊಟಾವೊಮಾ ಕ್ಹಾಮೊಜ ತಿಮ್ಮಜ಼ ಕರ‍್ಯೊ. <verse eid="EXO 17:6" /><verse number="7" style="v" sid="EXO 17:7" />ಇಸ್ರಾಯೆಲೊ, " ಯಹೊವಾ ಹಮಾರಾ ವಚ್ಮಾ ಛೆಸು ನೈ? ಕೈನ ಯಹೊವಾನೆ ತ್ಯಾ ಪರಿಕ್ಷಾ ಕರಲಕ್ಹು, ಮೊಶೆ ತೆ ಜ಼ಗಾನೆ ‘ಮಸ್ಸಾ’ ಕವಾನು ತ್ಯುನೆ ಗದ್ದಲ ಕರಲಕ್ಹು ತಿನೆ ‘ಮೆರಿಬಾ’ ಕವಾನು ನಾಮ ಮ್ಹೆಲ್ಯೊ.<verse eid="EXO 17:7" /></para>
  <para style="s">ಅಮಾಲೆಕ್ಯರೊನಾ ಕ್ಹಾತೆ ಯುದ್ದ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8" />ಅಮಾಲಕ್ಯರೊ ರೆಪಿದಿಮಾ ಇಸ್ರಾಯಲನಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರ‍್ಯಾ. <verse eid="EXO 17:8" /><verse number="9" style="v" sid="EXO 17:9" />ತೆಳಾಮಾ ಮೊಶೆ ಯೆಹುಶುವಾನೆ, " ತು ಹಮಾರಾ ಮನಕ್ಹೊಮಾ ದಕ್ಹಾವೊನೆ ಇನಿಲಿನ ಅಮಾಲೆಕ್ಯನಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರು. ಮಿ ವಂತಾ ಕ್ಹುದಾನಿ ಲಾಕಡಿ ಹತ್ಮಾ ಧರಲಿನ ಡೊಂಗನಾ ಉಪ್ಪರ ಹುಬ್ರವುಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 17:9" /><verse number="10" style="v" sid="EXO 17:10" />ಮೊಶೆ ಅಪ್ಪಣೆನಾ ಮರೆನೆ ಯೆಹುಶುವಾ ಅಮಾಲೆಕ್ಯೊನಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರ‍್ಯೊ. ಮೊಶೆ ವರಿ ಆರೊನನ ವರಿ ಹುರನ ಡೊಂಗರಪರ ಚಡಿನ ಗಯಾ. <verse eid="EXO 17:10" /><verse number="11" style="v" sid="EXO 17:11" />ಮೊಶೆ ತಿನಾ ಹತೊನೆ ಉಪ್ಪರ ಉಚಾಯಲಪರ ಇಸ್ರಾಯೆಲೊ ತಾಕತ ಹೊಂದಿಲಿವಸ. ತೆ ತಿನೊ ಹತ್ತ ಉತಾರಲ್ಪರ ಆಮಾಲೆಕ್ಯೊ ತಾಕತ ಹೊಂದಿ ಲಿವಸ. <verse eid="EXO 17:11" /><verse number="12" style="v" sid="EXO 17:12" />ಮೊಶೆನಾ ಹತೊ ವಜ್ಜು ಥಾತಾಮಾ, ಆರೊನ ವರಿ ಹುರನ ಯಕ್ಕ ದಗ್ಡಾನೆ ಲಿನ ಐನ ಮ್ಹೆಲ್ಯಾ. ಮೊಶೆ ತಿನಾ ಉಪ್ಪರ ಬೈಟ್ಯೊ. ಆರೊನ ಯಕ್ಕ ಜ಼ಗಾ ಹುಬ್ರೈನ ವರಿ ಹುರನ ಯಕ್ಕ ಜ಼ಗಾ ಹುಬ್ರೈನ ಮೊಶೆನಾ ಹತೊನೆ ಉಚೈನ ಧರಾನೆ ಸಹಾಯ ಕರ‍್ಯಾ. ಅಮ್ಮಜ ತಿನಾ ಹತೊ ಸುರ‍್ಯೂ ಡುಬೆಲಕ್ಕಾ ಹೆಟಾ ಉತಾರೆ ವಾಚಿಜ ವ್ಹತ್ತಾ. <verse eid="EXO 17:12" /><verse number="13" style="v" sid="EXO 17:13" />ಯೆಹುಶುವಾ ಅಮಾಲೆಕ್ಯೊನೆ ವರಿ ತ್ಯುನಾ ಸೈನಿಕೊನೆ ತಲ್ವಾರಕ್ಹು ಹರಾಡಿ ಪಡ್ಯಾ.<verse eid="EXO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆನೆ, " ಅನೆ ಸ್ಹೆ ಮ್ಹೆಲ್ಲಿವಾ ವರಕ್ಹು ಯಕ್ಕ ಬುಕ್ಕಮಾ ಲಿಕ್ಕ. ತೆ ಯೆಹುಶುವಾನೆ ತಿಳಸಾ. ಕಾ ಕದ್ಯಾಮ ಮಿ ಅಮಾಲೆಕ್ಯರೊ ಸ್ಹೆ ಜಿಮಿನಪರ ಅನಾ ನಂಗತ ಸಂಪೂರ್ಣ ನಾಶ ಕರಿನ ಛೊಡುಸ”ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 17:14" /><verse number="15" style="v" sid="EXO 17:15" />ತೆ ಜ಼ಗಾಮಾ ಮೊಶೆ ಯಜ್ಞ ವೆದಿ ಭಾಂದಾಲಗಾಡಿನ ತಿನೆ "ಯಹೊವಾ ನಿಸ್ಸಿ” ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. <verse eid="EXO 17:15" /><verse number="16" style="v" sid="EXO 17:16" />ಮೊಶೆ , ಆಮಾಲೆಕ್ಯರನಾ ಹತ್ತ ಯಹೊವಾನ ಸಿಂಹಾಸನನೆ ವಿರೊದ ಥೈನ ಉಚಾಯಲಕ್ಹು ಯಹೊವಾನಾ ಸಿಂಹಾಸನೆ ಅಮಾಲೆಕ್ಯರನಾ ಉಪ್ಪರ ಯಹೊವಾನೆ ತಲತಲಾಂತರಮಾ ಯುದ್ದ ರ‍್ಹವಸ ಕದ್ಯೊ.<verse eid="EXO 17:16" /></para>
  <chapter eid="EXO 17" />
  <chapter number="18" style="c" sid="EXO 18" />
  <para style="ms">ಇತ್ರೊನ ಮೊಶೆನೆ ಮಳಾನೆ ಆಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1" />ಕ್ಹುದಾ ಮೊಶೆನೆ ತಿನಾ ಮನಕ್ಹೊ ಥಯಲ ಇಸ್ರಾಯೆಲೊನೆ ಮಹಾ ಉಪಕಾರೊನೆ ಕರಲ, ಯಹೊವಾ ಇಸ್ರಾಯೆಲೊನೆ ಐಗುಪ್ತ ದೆಶತಾ ಬಲೈಲಿನ ಆಯಲ, ವಿದ್ಯಾನ್ಯರ ಆಚಾರನೂ ಮೊಶೆನೊ ಮಾಮೊ ಥಯಲ ಇತ್ರೊವನ ಪುಚ್ಚ್ಯೊ. <verse eid="EXO 18:1" /><verse number="2" style="v" sid="EXO 18:2" />ತೆಳಾಮಾ ಮೊಶೆನೆ ಮಾಮೊ ಥಯಲ ಇತ್ರೊವಕನ ದಿನ ವಳಾಯಲ ಮೊಶೆನಿ ಬೈಕೊ ಥಯಲ ಚಿಪ್ಪೊರಳನೆ, ತಿನಾ ಬೆ ಗಂಡ ಬಚ್ಚಾ಼ವೊನೆ ಬಲೈಲಿನ ಆಯೊ. <verse eid="EXO 18:2" /><verse number="3" style="v" sid="EXO 18:3" />ತೆ ಬಚ್ಚಾವೊಮಾ ಯಕ್ಲಾನೆ "ಗೆರ್ಷೊಮ” ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. ಕಾ ಕದ್ಯಾಮ ಮೊಶೆ, " ಮಿ ಅನ್ಯ ದೆಶಮಾ ಪ್ರವಾಸಿ ಥಯೊಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 18:3" /><verse number="4" style="v" sid="EXO 18:4" />ತಿನಾ ಬಿಜಕ್ಲಾ ದಿಕ್ರಾನೆ ಮೊಶೆಬಿ, " ಮಾರೊ ಬಾನೊ ಕ್ಹುದಾ ಮನೆ ಸಹಾಯ ಥಯಲಕ್ಹು ಮನೆ ಫರೊಹನನಾ ತಲ್ವಾರನೆ ತಪ್ಪಸಿನ ವಚಾ಼ಡ್ಯೊ” ಅಮ್ಮ ಕೈನ, ತೆ ದಿಕ್ರಾನೆ " ಎಲೀಯೆಜರ್” ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯಾ. <verse eid="EXO 18:4" /><verse number="5" style="v" sid="EXO 18:5" />ಮೊಶೆನೊ ಮಾಮೊ ಥಯಲ ಇತ್ರೊವನ ಮೊಶೆನಾ ಬಚ್ಚಾ಼ವೊನೆ, ವರಿ ತಿನಿ ಬೈಕೊನೆ ಬಲೈಲಿನ ಉಸಕನಿ ಜಿಮಿನಮಾ ಕ್ಹುದಾನಾ ಡೊಂಗರನಾ ಬಾಜು಼ ಉತ್ರಲ ಮೊಶೆಕನ ಆಯೊ. <verse eid="EXO 18:5" /><verse number="6" style="v" sid="EXO 18:6" />ತೆ ಮೊಶೆನೆ, ತಾರೊ ಮಾಮೊ ಥಯಲ ಇತ್ರೊವ ಥಯಲ ಮಿ ತಾರಿ ಬೈಕೊನೆ, ತಾರಾ ಬೆ ಬಚ್ಚಾ಼ವೊನೆ ಬಲೈಲಿನ ತುಕನ ಆಯೊಸ” ಅಮ್ಮ ಕೈನ ಮೊಕಲ್ಯೊ. <verse eid="EXO 18:6" /><verse number="7" style="v" sid="EXO 18:7" />ಮೊಶೆ ತಿನೊ ಮಾಮೊ ಥಯಲ ಕ್ಹಾಮೊ ಆವಾನೆ ಗೈನ ತಿನೆ ಔಳಿಲಿನ ಮಟ್ಟಿ ದಿದ್ಯೊ. ತ್ಯುನೆ ಪರಸ್ಪರ ಯೊಗ ಕ್ಷೆಮನೆ ವಿಚಾರ ಕರಲ್ಪರ ಗುಡಾರನಾ ಮ್ಹೈ ಗಯಾ. <verse eid="EXO 18:7" /><verse number="8" style="v" sid="EXO 18:8" />ತೆ ಥಯಲ್ಪರ ಮೊಶೆ ಯಹೊವಾ ಇಸ್ರಾಯಲನಾ ಪರವಾಗಿ ಫರೊಹನನೆ, ಐಗುಪ್ತೊನೆ ಕರಲಕ್ಹಾರು, ವಾಟಮಾ ತುಮೊನೆ ಉಂಟ ಥಯಲ ಕ್ಹಾರಾ ಕಷ್ಟೊನೆ, ಯಹೊವಾ ತೆ ಕಷ್ಟೊಕ್ಹು ತಪ್ಪಸಲ ತಿನಾ ಮಾಮಾನೆ ಕದ್ಯೊ. <verse eid="EXO 18:8" /><verse number="9" style="v" sid="EXO 18:9" />ಯಹೊವಾ ಐಗುಪ್ತೊನಾ ಹತೊಕ್ಹು ಇಸ್ರಾಯೆಲೊನೆ ಛೊಡೈನ ತ್ಯುನೊನೆ ಉಪಕಾರ ಕರಲಕ್ಹು ಇತ್ರೊವನ ಕುಷಿ ಥಯೊ. <verse eid="EXO 18:9" /><verse number="10" style="v" sid="EXO 18:10" />ಇತ್ರೊವನ, "ಐಗುಪ್ತನಾ ಹತೊಮಾತೊ, ಫರೊಹನನಾ ಹತ್ತಕ್ಹುಬಿ ತುಮೊನೆ ಛೊಡಾಲಕ್ಹು ಯಹೊವಾನೆ ಸ್ತೊತ್ರಾ! ಇಸ್ರಾಯೆಲೊನೆ ಗುಲಾಮಗಿರಿಮಾತೊ ವಚಾ಼ಡಲ ಯಹೊವಾನೆ ಸ್ತೊತ್ರ! <verse eid="EXO 18:10" /><verse number="11" style="v" sid="EXO 18:11" />ಯಹೊವಾ ತಿನಾ ಮನಕ್ಹೊನೆ ತ್ಯುನಾ ಹತೊಕ್ಹು ಛೊಡೈನ, ತೆ ಐಗುಪ್ತೊ ಕಯಾ ವಿಷಯಮಾ ಗರ್ವಪಡ್ದಾಸತೊ ತೆ ವಿಷಯಮಾ ತ್ಯುನೊನೆ ಬಗ್ಗಾಯಲಕ್ಹು ಯಹೊವಾ ಕ್ಹಾರಾ ಕ್ಹುದಾವೊತಿ ಮ್ಹೊಟೊ ವೈಕೈನ ಹಮ್ನಾ ತಿಳದಿಲಿದ್ಯೊಸ ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 18:11" /><verse number="12" style="v" sid="EXO 18:12" />ತೆ ನೈಸೊ ಮೊಶೆನೊ ಮಾಮೊ ಥಯಲ ಇತ್ರೊವನ ಕ್ಹುದಾನೆ ಸರ್ವಾಂಗ ಹೊಮ ಯಜ್ಞೊನೆ ಸಮರ್ಪಸ್ಯೊ. ಆರೊನ, ಇಸ್ರಾಯಲನಾ ಮ್ಹೊಟಾವೊನೆ ತಿನಾ ಕ್ಹಾತೆ ಕ್ಹುದಾನಾ ಸನ್ನಿದಿಮಾ ಬೊಜನ ಕಾರಾನಾ ಹುತಿ ಆಯಾ.<verse eid="EXO 18:12" /></para>
  <para style="s">ನ್ಯಾಯಪತಿನೆ ನೆಮ್ಸಲ</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13" />ಅಗಲ್ಯಾ ದಿನ್ನೆ ಮೊಶೆ ಮನಕ್ಹೊನೆ ನ್ಯಾಯಾ ಕರಾನಾಹುತಿ ಬೈಟಲ ಪಾಟತಾ ಕ್ಹಾಂಜ಼ಲಕ್ಕಾ ಮನಕ್ಹೊ ತಿನಾ ಬಾಜು಼ಮಾಜ ಹುಬ್ರಯಾತಾ. <verse eid="EXO 18:13" /><verse number="14" style="v" sid="EXO 18:14" />ಮೊಶೆ ಮನಕ್ಹೊನಾಹುತಿ ಕರಲ ಕ್ಹಾರು ಮಾಮೊ ದಿಕಿನ ತಿನೆ, " ತು ಶ್ಯಾನೆ ಮನಕ್ಹೊನಾಹುತಿ ಅಕ್ಲೊ ಪ್ರಯಾಸ ಕರಾಡೊಸತೊ? ಪಾಟತೊ ರಾತಲಕ್ಕಾ ನ್ಹ್ಯಾಜ ಹುಬ್ರೈನ ತು ಯಕ್ಲೊ ನ್ಯಾಯಾ ಕರಾನೆ ಬೈಟಲ ಕಾವೈ? ಕೈನ ಪುಚ್ಚ್ಯೊ. <verse eid="EXO 18:14" /><verse number="15" style="v" sid="EXO 18:15" />ಮೊಶೆ ತಿನಾ ಮಾಮಾನೆ, "ಎ ಮನಕ್ಹೊ ಕ್ಹುದಾನು ನ್ಯಾಯ ಐಕಾನಾಹುತಿ ಮಕನ ಆವಸ, <verse eid="EXO 18:15" /><verse number="16" style="v" sid="EXO 18:16" />ತಿಮ್ಮಜ಼ ತ್ಯುನಾಮಾ ಲಡೈ ಸು ಥೈತಬಿ ಮಕನ ಆವಸ. ಮಿ ವಿಚಾರ ಕರಿನ ತ್ಯುನೊನೆ ನ್ಯಾಯಾ ಕರಿನ ಕ್ಹುದಾನಾ ಆಜ್ಞಾ ವಿದಿಯೊನೆ ಸಾರುಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 18:16" /><verse number="17" style="v" sid="EXO 18:17" />ತೆ ಐಕಿನ ಮೊಶೆನೊ ಮಾಮೊ ತಿನೆ, " ತು ಕರಾನು ಆ ಕಾರ್ಯ ವಿದಾನ ಚೊಕೊ ನವೈ. <verse eid="EXO 18:17" /><verse number="18" style="v" sid="EXO 18:18" />ಆ ಕಾಮ ಘನ್ನು ಕಷ್ಟ ರ‍್ಹಯಲ ವ್ಹೈ. ತಾರಾ ಯಕ್ಲಾಕ್ಹು ತಿನೆ ನೈ ಚಲಾವಾನೆ ಥಾತು. ತು ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಾನಾ ಆ ಮನಕ್ಹೊ ಕ್ಹರಿಮಾಜ ತ್ರಾಸನೆ ಮ್ಹೈ ಥಾವೊಶಿ. <verse eid="EXO 18:18" /><verse number="19" style="v" sid="EXO 18:19" />ಆ ವಾತನೆ ಐಕ. ಮಿ ತುಮೊನೆ ಯಕ್ಕ ಆಲೊಚನೆ ಕೌಸ ವರಿ ಕ್ಹುದಾ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ ತು ಮನಕ್ಹೊನೆ, ಕ್ಹುದಾನೆ ವಚ್ಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊನಾ ಲಡೈವೊನೆ ಕ್ಹುದಾಕನ ಲೌ. <verse eid="EXO 18:19" /><verse number="20" style="v" sid="EXO 18:20" />ತು ಕ್ಹುದಾನಾ ಆಜ್ಞಾ ವಿದಿಯೊನೆ ಸಾರಿನ, ತ್ಯುನೆ ಚಾಲಾನಿ ವಾಟನೆ, ಕರಾನಾಹುತಿ ಕಾಮೊನೆ ತ್ಯುನೊನೆ ತಿಳಸು. <verse eid="EXO 18:20" /><verse number="21" style="v" sid="EXO 18:21" />ತೆನೈಸೊ ತು ಮನಕ್ಹೊಮಾ ಸಮರ್ಥರೊ, ಭಕ್ತೊ, ನಂಬಿಗಸ್ತೊ, ಲಂಚಮಟನಾ ಥಯಲ ದಾಣ್ಗಾವೊನೆ ಇನಿಲಿನ ತ್ಯುನೊನೆ ಹಜಾ಼ರ ಮನಕ್ಹೊನಾ ಉಪ್ಪರಬಿ, ಕ್ಹೊ ಮನಕ್ಹೊನಾ ಉಪ್ಪರಬಿ, ಐವತ್ತ ಮನಕ್ಹೊನಾ ಉಪ್ಪರಬಿ, ದಕ್ಹ ಮನಕ್ಹೊನಾ ಉಪ್ಪರಬಿ ಅದಿಕಾರಿಯೊ ಕೈನ ನೆಮಸು. <verse eid="EXO 18:21" /><verse number="22" style="v" sid="EXO 18:22" />ತ್ಯುನೆಜ಼ ಕೆಳಮಾಬಿ ಮನಕ್ಹೊನೆ ನ್ಯಾಯಾ ತಿರಸಾದೆ. ತ್ಯುನೆ ಮ್ಹೊಟಾ ಲಡೈಯೊನೆ ತುಕನ ಲಾವಾದೆ. ನ್ಹಾನಾ ಲಡೈಯೊನೆ ತ್ಯನೆಜ ಛೊಡಾವದೆ. ತ್ಯುನೆ ತಾರಾ ಕ್ಹಾತೆ ಆ ವಜನ ಉಚಾವಕ್ಹು ತ್ಯುನೆ ಹಲಕು ಥಾವಸ. <verse eid="EXO 18:22" /><verse number="23" style="v" sid="EXO 18:23" />ಕ್ಹುದಾ ತುನೆ ಅಮ್ಮ ಕರಾನಾಹುತಿ ಅಪ್ಪಣೆ ದಿದ್ಯಾಮ, ತು ಆ ಕಾಮನಾ ಹೊರೆನೆ ನಿರ್ವಸಾನೆ ಸಾದ್ಯ ಥಾವಸ. ಆ ನೈಸೊ ಆ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಸಂತುಷ್ಟ ಥೈನ ತ್ಯುನಾ ತ್ಯುನಾ ಘರೊಯೆ ಜಾ಼ವಸ” ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24" />ಮೊಶೆ ತಿನಾ ಮಾಮಾನಾ ವಾತೆ ಒಪ್ಪಿಲಿನ ತೆ ಕದಲ ನಂಗತ ಕ್ಹಾರುಜ಼ ಕರ‍್ಯೊ. <verse eid="EXO 18:24" /><verse number="25" style="v" sid="EXO 18:25" />ಮೊಶೆ ಇಸ್ರಾಯೆಲೊಮಾ ಸಮರ್ಥವಾಲವೊನೆ ಇನಿಲಿನ ಹಜಾ಼ರ ಮನಕ್ಹೊನಾ ಉಪ್ಪರಬಿ, ಕ್ಹೊ ಮನಕ್ಹೊನಾ ಉಪ್ಪರಬಿ, ಐವತ್ತ ಮನಕ್ಹೊನಾ ಉಪ್ಪರಬಿ, ದಕ್ಹ ಮನಕ್ಹೊನಾ ಉಪ್ಪರಬಿ, ಅದಿಕಾರಿಯೊನೆ ನೆಮಸ್ಯೊ. <verse eid="EXO 18:25" /><verse number="26" style="v" sid="EXO 18:26" />ಔನೆ ಕೆಳಾಮಾಬಿ ಮನಕ್ಹೊನೆ ನ್ಯಾಯಾ ತಿರಸಾಲಾ ಥೈನ ಮ್ಹೊಟಾ ಲಡೈಯವೊನೆ ಮೊಶೆಕನ ಲಾತಾ, ನ್ಹಾನಾ ಲಡೈವೊನೆಬಿ ತ್ಯುನೆಜ಼ ತಿರಸತಾ ಆಯಾ. <verse eid="EXO 18:26" /><verse number="27" style="v" sid="EXO 18:27" />ತೆ ಥಯಲ್ಪರ ಮೊಶೆ ತಿನಾ ಮಾಮಾನೆ ಅಪ್ಪಣೆ ದೆತಾಮಾ, ತೆ ತಿನಾ ಸ್ವಂತ ಗಾಮೆ ಫರಿನ ಗಯೊ.<verse eid="EXO 18:27" /></para>
  <chapter eid="EXO 18" />
  <chapter number="19" style="c" sid="EXO 19" />
  <para style="s">ಸಿನಾಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1" />ಇಸ್ರಾಯೆಲೊ ಐಗುಪ್ತ ದೆಶತಾ ಗೈನ ತನ್ನವಾ ಮ್ಹೈನಾನಾ ತೆಜ಼ ದಿನ್ನಮಾ ಸಿನಾಯಿನಾ ಡೊಂಗರನಿ ಉಸಕನಿ ಜಿಮಿನೆ ಆಯಾ. <verse eid="EXO 19:1" /><verse number="2" style="v" sid="EXO 19:2" />ಇಸ್ರಾಯೆಲೊ ರೆಪೀದಿನೆ ಛೊಡಿನ ಉಸಕನಿ ನಿಮಿನೆ ಐನ ಉಸಕನಿ ಜಿಮಿನಮಾ ಝೊಪಡ್ಯು ಘಾಲ್ಲಿನ ಸಿನಾಯಿ ಡೊಂಗರನೆ ಕ್ಹಾಮಾ ಐನ ಉತ್ರ್ಯಾ. <verse eid="EXO 19:2" /><verse number="3" style="v" sid="EXO 19:3" />ಮೊಶೆ ಡೊಂಗರ ಚಡಿನ ಕ್ಹುದಾನಾ ಸನ್ನಿದಿನೆ ಗಯೊ. ತೆಳಾಮಾ ಯಹೊವಾ ಡೊಂಗರನಾ ಉಪ್ಪರತೊ ಮೊಶೆನೆ ಬಲೈನ ತಿನೆ, " ತು ಯಾಕೊಬನಾ ಘರವಾಲಾ ರ‍್ಹಯಾಮ ಇಸ್ರಾಯೆಲೊನೆ ಆ ವಾತೊನೆ ತಿಳಸೈನ ಕವು. <verse eid="EXO 19:3" /><verse number="4" style="v" sid="EXO 19:4" />‘ಮಿ ಐಗುಪ್ತೊನೆ ಕರಲ ಕ್ಹಾರು, ಘಾರ ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆ ರೆಕ್ಯಾವೊನಾ ಉಪ್ಪರ ಚಡೈಲ್ಯು ಕೈನ ಮಿ ತುಮೊನೆ ಉಚೈಲಿನ ಆ ಜ಼ಗಾನೆ ಆವಾಲಗಾಡೊಸತೊ ತುಮೆ ದೆಕ್ಯಾಸ. <verse eid="EXO 19:4" /><verse number="5" style="v" sid="EXO 19:5" />ತಿನಾಹುತಿ ತುಮೆ ಮಾರಾ ವಾತೊನೆ ಶ್ರದ್ದಾಕ್ಹು ಐಕಿನ, ಮಾರಾ ಒಡಂಬಡಿಕೆನೆ ವಚಾ಼ಡಿ ಲಿದ್ಯಾಮ, ತುಮೆ ಕ್ಹಾರಾ ಜನಾಂಗೊಮಾ ಮನೆ ಸ್ವಕಿಯ ಮನಕ್ಹೊ ಥಾವೊಸಿ. ಕ್ಹಾರಿ ದುನಿಯಾ ಮಾರಿಜ ವ್ಹೈ. <verse eid="EXO 19:5" /><verse number="6" style="v" sid="EXO 19:6" />ತುಮೆ ಮನೆ ಶ್ರೆಷ್ಟ ಯಾಜಕೊ, ಪರಿಶುದ್ದ ಮನಕ್ಹೊನೆ ಥಾವೊಸಿ’ ಕೈನ ತು ಇಸ್ರಾಯಲನೆ ತಿಳಸೌ” ಕದ್ಯೊ. <verse eid="EXO 19:6" /><verse number="7" style="v" sid="EXO 19:7" />ತೆಳಾಮಾ ಮೊಶೆ ಐನ ಮನಕ್ಹನಾ ಮ್ಹೊಟಾವೊನೆ ಒಟ್ಟ ಥೈನ ಸೆರಸ್ಯೊ. ಯಹೊವಾ ಆಜ್ಞಾಕರಲ ಆ ವಾತೊನೆ ತ್ಯುನೊನೆ ತಿಳಸಾ. <verse eid="EXO 19:7" /><verse number="8" style="v" sid="EXO 19:8" />ಮನಕ್ಹೊ ಒಗ್ಗಟ ಥೈನ, "ಯಹೊವಾ ಕದಲನಿಂಗತಜ಼಼ ಕರಿಯೆಸ. ಮೊಶೆ ಯಹೊವಾಕನ ಪಾಚೊ ಫರಿನ ಗೈನ ತ್ಯುನೆ ಕದಲ ವಾತೊನೆ ತಿಕನ ಕದ್ಯೊ <verse eid="EXO 19:8" /><verse number="9" style="v" sid="EXO 19:9" />ಯಹೊವಾ ಮೊಶೆನೆ, " ಹಮ್ನಾ, ಮಿ ತಾರಾ ಕ್ಹಾತೆ ಬೊಲ್ತಾಮಾ, ಮನಕ್ಹೊ ಐಕಿನ ಕೆಳಾಮಾಬಿ ತುನೆ ನಂಬಾ ವರಕ್ಹು ಮಿ ಮ್ಹಾಡಮಾತೊ ತುಕನ ಔಸ” ಕೈನ ಕದ್ಯೊ. ಮೊಶೆ ಮನಕ್ಹೊನಾ ವಾತೊನೆ ಯಹೊವಾ ಕನ ಕದ್ಯೊ. <verse eid="EXO 19:9" /><verse number="10" style="v" sid="EXO 19:10" />ಯಹೊವಾ ಮೊಶೆನೆ ಕದಲ ಸುವೈ ಕದ್ಯಾರೆ, " ತು ಮನಕ್ಹೊಕನ ಗೈನ , ಆ ದಿನ್ನೆ ವರಿ ವಂತಾ ತ್ಯುನೊನೆ ಶುದ್ದ ಕರ. ಮಿ ಆವಾನಾಹುತಿ ತ್ಯುನೊನೆ ಶುದ್ದ ಕರ. ತ್ಯುನೆ ತ್ಯುನು ವಣ್ಣಾ ಧೊಲಿನ, <verse eid="EXO 19:10" /><verse number="11" style="v" sid="EXO 19:11" />ತನ್ನವಾ ದಿನ್ನಮಾ ತ್ಯುನೆ ಶುದ್ದ ಥವು. ತನ್ನವಾ ದಿನ್ನಮಾ ಯಹೊವಾ ಸಮಸ್ತ ಮನಕ್ಹೊನೆ ಪ್ರತ್ಯೆಕ್ಷ ಥೈನ ಸಿನಾಯಿನಾ ಡೊಂಗರಪರ ಉತ್ರನ ಆವಸ. ತುಮೆ ತ್ಯಾ ಮನೆ ದೆಕೊಶಿ. <verse eid="EXO 19:11" /><verse number="12" style="v" sid="EXO 19:12" />ಮನಕ್ಹೊ ಕ್ಹಾಮಾ ಆಯೆವಾಚಿ ತು ಡೊಂಗರನಾ ಸುತ್ತೆಬಿ ಬೆಲಿ ಕರಿನ ಮನಕ್ಹೊನೆ, ‘ಎಚ್ಚರ ಥಾವೊ, ತುಮೆ ಆ ಡೊಂಗರ ಚಡೆವಾಚಿ ತಿನಿ ಬೆಲಿ ಮುಟ್ಟೆವಾಚಿ ಜಾಗ್ರತೆಕ್ಹು ರ‍್ಹೌ. ಡೊಂಗರನೆ ಮುಟ್ಟಲವಾಲಾ ಕ್ಹಾರಾ ಕ್ಹರಿಜ಼ ಮರಿ ಜಾ಼ವಸ. <verse eid="EXO 19:12" /><verse number="13" style="v" sid="EXO 19:13" />ತ್ಯವಾನೆ ಕುನ್ನಜ ಮುಟ್ಟು ನೈ. ಡಗ್ಡೊ ನಾಕಿನ ನೈತೊ ಬಾಣಾ ಛೊಡಿನ ಕ್ಹರಿಜ಼ ತ್ಯವಾನೆ ಕಲಸಕರು. ಮನಕ್ಹ ರ‍್ಹವಾದೆ, ಪಶುವೊ ರ‍್ಹವಾದೆ ಮೂಟ್ಯಾಮ ಮರುಜ. ಸಿಂಗ್ಡಾನಿ ಅವಾಜ ದಿರ್ಘಥೈನ ಐಕ್ತಾಮಾ ತ್ಯುನೆ ಡೊಂಗರನಾ ನಜಿಕ ಔ” ಕೈನ ಕೆ ಕದ್ಯೊ. <verse eid="EXO 19:13" /><verse number="14" style="v" sid="EXO 19:14" />ಮೊಶೆ ಡಂಗರತೊ ಉತ್ರಿನ ಮನಕ್ಹೊ ಕನ ಐನ, ತ್ಯನೊನೆ ಆರಾದನಾ ಕರಾನೆ ತಯ್ಯಾರ ಕರ‍್ಯೊ. ತ್ಯುನೆ ತ್ಯುನಾ ವಣ್ಣಾವೊನೆ ಧ್ಯಲಿನ ಶುದ್ದ ಥಯಾ. <verse eid="EXO 19:14" /><verse number="15" style="v" sid="EXO 19:15" />ತೆಳಾಮಾ ಮೊಶೆ ಮನಕ್ಹೊನೆ, "ತನ್ನವಾ ದಿನಮಾ ಸಿದ್ದ ಥಾವೊ ಅನಾ ವಚ್ಮಾ ಕಯೊಬಿ ದಾಣ್ಗೊ ಬಾಕಡಿನಿ ಕ್ಹಾತೆ ಕ್ಹುರೌ ನೈ” ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16" />ತನ್ನವಾ ದಿನಮಾ ಸುರ‍್ಯೊದಯೊ ಥಾವಾನೆ ತೆ ಡೊಂಗರನಾ ಉಪ್ಪರ ಬಿಜಲಿ, ಮಿಂಚ, ಘನ್ನು ಮ್ಹಾಡ, ಪಿಪಿಯೊನಿ ಮ್ಹೊಟು ಅವಾಜ ಉಂಟಥಾವಾನೆ ಪಾಳೆಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಕಾಪ್ಯಾ. <verse eid="EXO 19:16" /><verse number="17" style="v" sid="EXO 19:17" />ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಹುತಿ ಮೊಶೆ ಮನಕ್ಹೊನೆ ಪಾಳೆಯನಾ ಭಾರಾ ಬಲೈನ ಆತಾಮಾ, ತ್ಯುನೆ ಡೊಂಗರನಾ ಹೆಟಾ ಹುಬ್ರಯಾ. <verse eid="EXO 19:17" /><verse number="18" style="v" sid="EXO 19:18" />ಯಹೊವಾ ಆಗನಾ ಮ್ಹೈ ಸಿನಾಯಿನಾ ಡೊಂಗರನಾ ಉಪ್ಪರ ಉತ್ರಿನ ಆಯೊ. ತಿನಾಹುತಿ ತೆ ಡೊಂಗರ ಕ್ಹಾರು ಧವಾಂಡಾಕ್ಹು ಭಿರಿಗಯು. ತೆ ಧವಾಂಡೊ ಆಗನಾ ಧವಾಂಡಾ ನಿಂಗತ ಉಪ್ಪರ ಗಯೊ. ತೆ ನೈಸೊ ಡೊಂಗರ ಕ್ಹಾರು ಘನ್ನು ಹಲ್ಯು ಥಯು. <verse eid="EXO 19:18" /><verse number="19" style="v" sid="EXO 19:19" />ಪಿಪಿಯೊನಿ ಅವಾಜ ಹೆಚ್ಚ ಥೈನ ಆತಾಮಾ, ಮೊಶೆ ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಬೊಲ್ಯೊ. ತೆಳಾಮಾ ಕ್ಹುದಾ ಉಚ್ಚಿ ಅವಾಜಮಾ ತಿನೆ ಉತ್ತರ ದಿದ್ಯೊ. <verse eid="EXO 19:19" /><verse number="20" style="v" sid="EXO 19:20" />ಯಹೊವಾ ಸಿನಾಯಿನಾ ಡೊಂಗರನಾ ಗೊಪುರನೆ ಉತ್ತಿನ ಆಯೊ. ತೆ ಡೊಂಗರನಾ ತುದಿಯೆ ಆ ಕೈನ ಮೊಶೆನೆ ಬಲಾತಾಮಾ ತೆ ಡೊಂಗರನೆ ಚಡ್ಯೊ. <verse eid="EXO 19:20" /><verse number="21" style="v" sid="EXO 19:21" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆನೆ, "ತು ಉತ್ರಿನ ಗೈನ ಮನಕ್ಹೊನೆ ಎಚ್ಚರ ಕರು. ತ್ಯುನೆ ದೆಕುಸ ಕೈನ ಕದಲ ಆಶೆಕ್ಹು ಬೆಲಿ ದಾಟಿನ ಯಹೊವಾನಾ ಕನ ಆಯಾರೆ ತ್ಯುನಾಮಾ ಘನಾ ಮನಕ್ಹೊ ಮರಿ ಜಾ಼ವಸ. <verse eid="EXO 19:21" /><verse number="22" style="v" sid="EXO 19:22" />ಯಹೊವಾನಾ ಸನ್ನಿದಿನೆ ಆವಾನಾ ಯಾಜಕೊ ತುಮೊನೆ ಶುದ್ದ ಕರಲಿವೊ. ನೈಸೊ ಯಹೊವಾ ಪಕ್ಕನೆ ತ್ಯುನೊನೆ ಕತ್ರಿ ಪಡುಸ” ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 19:23" />ತಿನೆ ಮೊಶೆ ಯಹೊವಾನೆ, " ಮನಕ್ಹೊನೆ ಸಿನಾಯ ಡೊಂಗರನೆ ಚಡಾನೆ ನೈ ಥಾತು. ಕಾ ಕದ್ಯಾಮ ‘ ಡೊಂಗರನಾ ಸುತ್ತೆಬಿ ಬೆಲಿ ಘಾಲಿನ ತಾರಾಹುತಿ ಶುದ್ದಕರ”’ ಕೈನ ಕರ‍್ಯೊಸತೊ. <verse eid="EXO 19:23" /><verse number="24" style="v" sid="EXO 19:24" />ಯಹೊವಾ ಮೊಶೆನೆ, " ತು ಉತ್ರಿನ ಗೈನ ಅರೊನನೆ ತಾರಾ ಕ್ಹಾತೆ ಬಲೈಲಿನ ಉಪ್ಪರ ಆ. ತೆ ನೈಸೊ ಯಾಜಕೊ, ಮನಕ್ಹೊನಿ ತೆ ಬೆಲಿನೆ ದಾಟಿನ ಯಹೊವಾಕನ ಔನೈ. ದಾಟಿನ ಆಯಾರೆ ಮಿ ತ್ಯುನೊನೆ ಗಪ್ಪನೆ ಕತ್ರಿಪಡುಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 19:24" /><verse number="25" style="v" sid="EXO 19:25" />ತೆನೈಸೊ ಮೊಶೆ ಮನಕ್ಹೊಕನ ಉತ್ರಿನ ಗೈನ ಕ್ಹುದಾ ಕದಲ ವಾತೊ ತ್ಯುನೊನೆ ತಿಳಸ್ಯೊ.<verse eid="EXO 19:25" /></para>
  <chapter eid="EXO 19" />
  <chapter number="20" style="c" sid="EXO 20" />
  <para style="s">ದಕ್ಹ ಆಗನ್ಯಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1" />ಕ್ಹುದಾ ಕದಲ ವಾತೊ: <verse eid="EXO 20:1" /><verse number="2" style="v" sid="EXO 20:2" />"ತುಮೆ ಗುಲಾಮೊ ರ‍್ಹಯಲ ಐಗುಪ್ತ ದೆಶಮಾತೊ ತುಮೊನೆ ಭಾರೊ ಲಾಯಲ ಯಹೊವಾ ಕವಾಲೊ ‘ಮಿಜ಼ ತಾರೊ ಕ್ಹುದಾ ವ್ಹೈ.’<verse eid="EXO 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 20:3" />ಮಿ ರ‍್ಹಯಾಮ ತುನೆ ಬಿಜಾ಼ ದೆವಸ್ಥಾನೊ ರ‍್ಹೌ ನೈ. <verse eid="EXO 20:3" /><verse number="4" style="v" sid="EXO 20:4" />ಕಯಾಜ಼ ಮೂರ್ತಿನೆ ಕರಲಿಯು ನೈ. ಹಬಾಳಮಾ ರ‍್ಹೈತಬಿ, ಜಿಮಿನಪರ ರ‍್ಹೈತಬಿ, ಜಿಮಿನಾ ಹೆಟಾ ಪಾನಿಮಾ ರ‍್ಹೈತಬಿ ರ‍್ಹವಾನಾ ಕಿನಾಬಿ ರುಪನೆ ಕರಲ್ಯು ನೈ. <verse eid="EXO 20:4" /><verse number="5" style="v" sid="EXO 20:5" />ತ್ಯುನೊನೆ ಅಡ್ಡ ಪಡುನೈ, ಪೂಜಾ ಕರು ನೈ. ತೆನೈಸೊ ತಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಕವಾಲೊ ಮಿ ಮನೆ ಕರಾನು ಅಕ್ಲು ಗೌರವ ಹಜಿಯಕ್ಲಾನೆ ಚೊಡಿನ ನೈ ದೆತು. ತಿನಾಹುತಿ ಮನೆ ವಿರೊದವಾಲಾನಾ ವಿಷಯಮಾ ಬಾಪೊನೂ ದೊಷ ಫಲನೆ ಬಚ್ಚಾವೊನಾ ಉಪ್ಪರ, ತನ್ನ ಚಾರ ಮಾತಾಲಕ್ಕಾ ಆವಾಲಗಾಡುಸ. <verse eid="EXO 20:5" /><verse number="6" style="v" sid="EXO 20:6" />ತೆನೈಸೊ ಮನೆ ಮಯಾ ಕರಿನ ಮಾರಾ ಆಜ್ಞಾವೊನೆ ಹತೆ ಧರಲಿದ್ಯಾರೆ ಹಜಾ಼ರ ಮಾತಾಲಕ್ಕಾ ಮಯಾ ದೆಕ್ತಾಲಾಡುಸ. <verse eid="EXO 20:6" /><verse number="7" style="v" sid="EXO 20:7" />ತಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ನಾಮನೆ ಅಯೊಗ್ಯ ಕಾಮನಾಹುತಿ. ಉಚೌ ನೈ. ಯಹೊವಾ ತಿನಾ ನಾಮನೆ ಅಯೊಗ್ಯ ಕಾಮನಾ ಹುತಿ ಉಚೈಲ ವಾಲಾನೆ ಶಿಕ್ಷಾ ದಿದೆವಾಚಿ ಛೊಡತೊ ನೈ. <verse eid="EXO 20:7" /><verse number="8" style="v" sid="EXO 20:8" />ಸಬ್ಬತ ದಿನನೆ ಕ್ಹುದಾನೊ ಪರಿಶುದ್ದ ದಿನ ವ್ಹೈ ಕೈನ ಆಚರಣೆನೆ ಕರಾನೆ ಶೆಂಮಾ ಮ್ಹೆಲ್ಯೂ. <verse eid="EXO 20:8" /><verse number="9" style="v" sid="EXO 20:9" />ಛೆ ದಿನ ತು ರಾಬಿನ ತಾರು ಕಾಮ ಕ್ಹಾರು ಕರ. <verse eid="EXO 20:9" /><verse number="10" style="v" sid="EXO 20:10" />ತೆನೈಸೊ ಕ್ಹಾತವಾ ದಿನ್ನ ತಾರು ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಮಿಸ ಥಯಲ ಅರಾಮಾ ಕರಾನು ದಿನ ಥಯೊಸ. ತೆ ದಿನ್ನಮಾ ತು ಕಯುಜ಼ ಕಾಮ ಕರು ನೈ. ತಾರಾ ಗಂಡ ಬಚ್ಚಾ, ತಾರಾ ಹೆಣ್ಣ ಬಚ್ಚಾ, ಗಂಡಾಳ, ಹೆಣ್ಣಾಳ, ಪಶು ಪ್ರಾಣಿಯೊ ತಾರಾ ಗಾಮಾ ರ‍್ಹಯಲ ಅನ್ಯ ಗಾಮವಾಲೊಬಿ ಕಯುಜ಼ ಕಾಮ ಕರು ನೈ. <verse eid="EXO 20:10" /><verse number="11" style="v" sid="EXO 20:11" />ಛೆ ದಿನೊಮಾ ಯಹೊವಾ ಜಿಮಿನ ಹಬಾಳನೆ, ಸಮಂದರನೆ, ತಿನಾಮಾನು ಸಮಸ್ತಬಿ ಕ್ಹಾರು ನಿರ್ಮಾಣ ಕರಿನ ಕ್ಹಾತವಾ ದಿನಮಾ ವಿಶ್ರಾಮ ಲಿದ್ಯೊ. ತಿನಾಹುತಿ ಯಹೊವಾ ಸಬ್ಬತ ದಿನನೆ ತಿನೊ ಪರುಶುದ್ದ ದಿನ ತಾವಾದೆ ಕೈನ ಆಶಿರ್ವಾದ ಕರ‍್ಯೊ. <verse eid="EXO 20:11" /><verse number="12" style="v" sid="EXO 20:12" />"ತಾರಾ ಮಾಬಾಪನೆ ಸನ್ಮಾನ ಕರು, ಸನ್ಮಾ ಕರ‍್ಯಾರೆತಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ತಿನೆ ಅನುಗ್ರಹಿಸಾನಾ ದೆಶಮಾ ತು ಘನ್ನಾ ದಿನ ಜ್ಯೂತೊ ರ‍್ಹಸಿ. <verse eid="EXO 20:12" /><verse number="13" style="v" sid="EXO 20:13" />"ಕಾಲಾಸ ಕರು ನೈ. <verse eid="EXO 20:13" /><verse number="14" style="v" sid="EXO 20:14" />"ವ್ಯಬಿಚಾರ ಕರು ನೈ. <verse eid="EXO 20:14" /><verse number="15" style="v" sid="EXO 20:15" />"ಚೊರಿ ಕರು ನೈ. <verse eid="EXO 20:15" /><verse number="16" style="v" sid="EXO 20:16" />"ತು ಬಿಜಾ ಯಕ್ಲಾನಾ ಉಪ್ಪರ ಸುಳ್ಳ ಸಾಕ್ಷಿ ಕೌ ನೈ. <verse eid="EXO 20:16" /><verse number="17" style="v" sid="EXO 20:17" />"ಬಿಜಾ ಯಕ್ಲಾನೂ ಗರ ದೆಕಿನ ಆಶೆ ಕರು ನೈ. ಬಿಜಾ ಯಕ್ಲಾನಿ ಬೈಕೊ, ಗಂಡಾಳ, ಹೆಣ್ಣಾಳ, ಬೈಲ, ಗದಡು ರ‍್ಹಯಲ ಕಯುಜ಼ ಆಸ ಕರು ನೈ.”<verse eid="EXO 20:17" /></para>
  <para style="s">ಮನಕ್ಹೊನು ಭೆಂ</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18" />ತೆ ಬಿಜಲಿ, ಮಿಂಚ, ಪಿಪಿಯೊನಿ ಅವಾಜ ಐಕಿನ, ವರಿ ಡೊಂಗರತು ಭಾರು ಆವಾನೊ ಧವಾಂಡೊ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ದೆಕಿನ, ಕಾಪ್ತಾ ದುರಜ ಹುಬ್ರಯಾ. <verse eid="EXO 20:18" /><verse number="19" style="v" sid="EXO 20:19" />ತ್ಯುನೆ ಮೊಶೆನೆ, "ತುಜ಼ ಹಮಾರಾ ಕ್ಹಾತೆ ಬೊಲ, ಹಮೆ ಐಕಿಯೆಸ. ತೆನೈಸೊ ಕ್ಹುದಾ ಹಮಾರಾ ಕ್ಹಾತೆ ಬೊಲ್ಯಾಮ ಹಮೆ ಮರಿ ಗಯೆಸ” ಕೈನ ಕದ್ಯಾ. <verse eid="EXO 20:19" /><verse number="20" style="v" sid="EXO 20:20" />ತಿನಾಹುತಿ ಮೊಶೆ ಮನಕ್ಹೊನೆ, "ಬುಚ್ಕೊ ನಕೊ, ಕ್ಹುದಾ ತುಮೊನೆ ಪರಿಕ್ಷಾ ಕರಾನಾಹುತಿ, ತುಮೆ ಪಾಪ ಕರೆವಾಚಿ ತಿನಾ ಉಪ್ಪರಲ್ಯು ಬುಚಕ ತುಮೊನೆ ರ‍್ಹೌ ಕೈನ ಉತ್ರಿನ ಆಯೊಸ,”’ ಕದ್ಯೊ. <verse eid="EXO 20:20" /><verse number="21" style="v" sid="EXO 20:21" />ಮನಕ್ಹೊ ದುರಜ ಹುಬ್ರಯಾತಾ. ಮೊಶೆ ಕ್ಹುದಾ ರ‍್ಹವಾನು ತೆ ಅಂದಾರಾನಾ ಮ್ಹಾಡನಾ ನಜಿಕ ಗಯೊ.<verse eid="EXO 20:21" /></para>
  <para style="s">ಬಲಿನೊ ಕಟ್ಟಾನಾಹುತಿ ನಿಯಮೊ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22" />ಯಹೊವಾ ಮೊಶೆನೆ ಅಮ್ಮ ಕದ್ಯೊ, "ತು ಇಸ್ರಾಯೆಲೊನೆ ಕವಾನು ಸುವೈ ಕದ್ಯಾಮ; ‘ಮಿ ಹಬಾಳತೊ ತುಮಾರಾ ಕ್ಹಾತೆ ಬೊಲೆಲ ತುಮೆ ದೆಕ್ಯಾಸ ತೊ. <verse eid="EXO 20:22" /><verse number="23" style="v" sid="EXO 20:23" />ತಿನಾಹುತಿ ತುಮೆ ಮಾರಾ ಬದಲ ಕ್ಹೊನಾನಾ ವರಿ ರುಪ್ಪಾನಾ ದೆವಸ್ಥಾನೊನೆ ಕರಲ್ಯೂ ನೈ. <verse eid="EXO 20:23" /><verse number="24" style="v" sid="EXO 20:24" />ತುಮೆ ಮಾರಾ ಯಜ್ಙ ವೆದಿನೆ ಮಾತಿಕ್ಹು ಕರು. ತುಮೆ ತಿನಾ ಉಪ್ಪರ ತುಮಾರಾ ಸರ್ವಂಗ ಹೊಮ, ಸಮಾದಾನು ಯಜ್ಞ, ಬೈಲೊ ಬಕ್ರಾನೆ ಸಮರ್ಪೀಸ ಕರು. ಮಿ ಮಾರಾ ನಾಮನೆ ಗೌರವ ಕರಾನು ಕ್ಹಾರಿ ಜ಼ಗಾವೊಮಾಬಿ ತುಮೊಕನ ಐನ ತುಮೊನೆ ಆಶಿರ್ವಾದ ಕರುಸ. <verse eid="EXO 20:24" /><verse number="25" style="v" sid="EXO 20:25" />ತುಮೆ ಮಾರಾಹುತಿ ದಗ್ಡಾಕ್ಹು ಯಜ್ಞ ವೆದಿ ಭಾಂದಾನಿ ರ‍್ಹಯಾಮ, ತೆ ಕೆತ್ತೆಲ ದಗ್ಡಾವೊಕ್ಹು ಭಾಂದು ನೈ. ಕಾ ಕದ್ಯಾಮ ಉಳಿ, ರ‍್ಹಯಲ ಅಕ್ಲು ತಿನಾ ಉಪ್ಪರ ಉಪಯೊಗಸ್ಯಾಮ ತೆ ಅ ಪವಿತ್ರ ಥಾವಸ. <verse eid="EXO 20:25" /><verse number="26" style="v" sid="EXO 20:26" />ತೆನೈಸೊ ಮಾರಿ ಯಜ್ಞವೆದಿನೆ ತುಮಾರಾ ನಗ್ನತೆನಾ ದಿಕ್ಹಾ ನಿಂಗತ ಪೈರಿಯೊ ಬಳಸಿನ ತಿನೆ ಚಡುನೈ”’ ಕೈನ ಆಜ್ಞಾಪಿಸೊ.<verse eid="EXO 20:26" /></para>
  <chapter eid="EXO 20" />
  <chapter number="21" style="c" sid="EXO 21" />
  <para style="s">ಗುಲಾಮೊನೆ ದೆಕಿಲಿವಾನೊ ತರಿಕೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1" />"ಹಮ್ನಾ ಮಿ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಮ್ಹೆಲಾನಾ ನ್ಯಾಯ ವಿದಿಯೊ ಕಯಾ ವ್ಹೈ ಕದ್ಯಾಮ; <verse eid="EXO 21:1" /><verse number="2" style="v" sid="EXO 21:2" />"ತುಮಾರಾ ಕಯೊಬಿ ಇಬ್ರಿಯಮಾ ಯಕ್ಲಾನೆ ದಾಸತ್ವಮಾ ಇಕ್ಕಾತೊ ಲಿದ್ಯಾಮ ತೆ ಇಬ್ರಿಯೊವಾಲೊ ಛೆ ವರಕ್ಹ ದಾಸ ಥಯಲ ಕ್ಹಾತವಾ ವರಕ್ಹಮಾ ಸುಜ ದಿದೆವಾಚಿ ಬಿಡುಗಡೆ ಥೈನ ಜೌ಼. <verse eid="EXO 21:2" /><verse number="3" style="v" sid="EXO 21:3" />ದಾಣ್ಗೊ ಹಿವಾ ನೈ ಥೈನ ಆಯಾಮ ಯಕ್ಲೊಜ ಗೈ ಪಡ್ಯೊ. ಹಿವಾ ಥೈನ ಆಯಾಮ ತಿನಾ ಬೈಕೊನಾ ಕ್ಹಾತೆಜ಼ ಜೌ಼. <verse eid="EXO 21:3" /><verse number="4" style="v" sid="EXO 21:4" />ತಿನೊ ಮಾಲಕ ತಿನೆ ಹಿವಾ ಕರಾಯಲ ಪಮಾಫ ತೆ ಬೈಕೊಮಾ ಗಂಡ ನೈತೊ ಹೆಣ್ಣ ಬಚ್ಚಾ ಹುಟ್ಯಾಮ, ತೆ ಬೈಕೊಬಿ ತಿನಾ ಬಚ್ಚಾಬಿ ಮಾಲಕನಾ ಆಸ್ತಿ ಥಾವಸ. ದಾಸಬಿ ಯಕ್ಲೊಜ ಥೈನ ಗೈ ಪಡ್ಯೊ.”’ <verse eid="EXO 21:4" /><verse number="5" style="v" sid="EXO 21:5" />ತೆನೈಸೊ ದಾಸಬಿ, "ಮಿ ಮಾರಾ ಮಾಲಕನೆ, ಮಾರಾ ಬೈಕೊ ಬಚ್ಚಾ಼ವೊನೆ ಮಾಯಾ ಕರುಸ. ತಿನಾಹುತಿ ಮಿ ಬಿಡುಗಡೆ ಥೈನ ಜಾ಼ವಾನಾಹುತಿ ಮನೆ ಮನಸ ನತ್ತಿ” ಕೈನ ಕರೆಟ್ಟ ಕದ್ಯಾಮ, <verse eid="EXO 21:5" /><verse number="6" style="v" sid="EXO 21:6" />ತಿನೊ ಮಾಲಕ ಕ್ಹುದಾಕನ ಬಲೈಲಿನ ಐನ ಬಾಕಲಕನ ನೈತೊ ಬಾಕಲನಾ ಚೌಕಟ್ಟನಾ ಪಟ್ಟಿಯೊನಾ ಬಾಜು಼ಮಾ ಹುಬ್ರಾಡಿನ ತಿನೊ ಕಾನ ಚೊಟೈನ ಗುರತ ಕರು. ತೆಳಾಮಾ ತೆ ಶಾಶ್ವತ ಥೈನ ತಿನೆ ದಾಸ ರ‍್ಹಯಲ ರ‍್ಹವಸ.<verse eid="EXO 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 21:7" />ಕುನಬಿ ತಿನಾ ದಿಕ್ರಿನೆ ದಾಸಿ ಕರ‍್ಯಾಮ, ದಾಸೊ ಬಿಡುಗಡೆ ಥೈನ ಜಾ಼ವಾನಾ ನಿಂಗತ ತೆ ಬಿಡುಗಡೆ ಥೈನ ಜೌ಼ನೈ. <verse eid="EXO 21:7" /><verse number="8" style="v" sid="EXO 21:8" />ತಿನೆ ಘಟ್ಟ ಕರಲ ಮಾಲಕನೆ ಯಕ್ಕ ಟೈಮ ಪಸಂದ ನೈ ಆಯಾಮ ತಿನೆ ಛೊಡಿನ ಕತ್ರಾನಾ ಹುತಿ ತೆ ಅನುಮತಿ ದ್ಯೂ. ತೆ ದಿದಲ ವಾತೆ ತಪ್ಪಲ ವಾಲೊ ಥಯಲಕ್ಹು ಅನ್ಯ ಮನಕ್ಹೊನೆ ತಿನೆ ಇಕ್ಕಾನು ತಿನೆ ಅದಿಕಾರ ನತ್ತಿ. <verse eid="EXO 21:8" /><verse number="9" style="v" sid="EXO 21:9" />ಯಕ್ಕ ಟೈಮ ತೆ ತಿನಾ ದಿಕ್ರಾನೆ ತಿನೆ ಘಟ್ಟ ಕರ‍್ಯಾಮ ದಿಕ್ರಿ ನಿಂಗತ ತಿನೆ ದೆಕಿಲ್ಯೂ. <verse eid="EXO 21:9" /><verse number="10" style="v" sid="EXO 21:10" />ಮಾಲಕ ಹಿಯಕ್ಲಿನೆ ಹಿವಾ ಥಯಾರೆ ಪಸ್ಟವಾಲಿನೆ ಅನ್ನ, ವಣ್ಣಾ, ದಾಂಪತ್ಯನಾ ಹಕ್ಕನೆ ಕಮ ಕರು ನೈ. <verse eid="EXO 21:10" /><verse number="11" style="v" sid="EXO 21:11" />ಆ ತನ್ನಮಾ ಕಯುಬಿ ನೈ ಕರ‍್ಯಾಮ ತೆ ಸುಜ ದಿದೆವಾಚಿ ಬಿಡುಗಡೆ ಥೈನ ಜಾ಼ಸಕಸ.<verse eid="EXO 21:11" /></para>
  <para style="s">ತ್ರಾಸ ದಿವಾನಾಹುತಿ ನಿಯಮ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12" />ಕುನ್ನಬಿ ಮನಕ್ಹನೆ ಮಾರಿನ ಕಲಸ ಕರಲವಾಲೊನೆ ಮರಣನಿ ಶಿಕ್ಷಾ ದ್ಯು. <verse eid="EXO 21:12" /><verse number="13" style="v" sid="EXO 21:13" />ತೆನೈಸೊ ಕಲಾಸ ಕರುಕೈನ ಸೊಚ ನೈ ರ‍್ಹಯಾಮ ಕ್ಹುದಾನಾ ಸಂಕಲ್ಪಕು ತೆ ಮೌತ ಥಯುಸ ತಬಿ, ತೆ ಕ್ಹಲಾಸ ಕರಲವಾಲೊ ನ್ಹಾಟಿನ ಜೌ಼ ಕೈನ ತಿನೆ ಮಿ ಯಕ್ಕ ಜ಼ಗಾ ನೆಮ್ಸುಸ. <verse eid="EXO 21:13" /><verse number="14" style="v" sid="EXO 21:14" />ತೆನೈಸೊ ಯಕ್ಲೊ ತಿನಾ ನೆರೆಯವಾಲಾನೆ ಕಲಾಸಕರಾನಾ ಉದ್ದೆಶಕ್ಹು ತಿನೆ ಮೊಸಕ್ಹು ಕಲಾಸ ಕರ‍್ಯಾಮ, ತೆ ಮರಾ ವರಕ್ಹೊ ತು ತಿನೆ ಮಾರಾ ಯಜ್ಞ ವೆದಿ ಕಂತೊ ಬಲೈಲಿನ ಗೈನ ಕತ್ರಿಪಡು. <verse eid="EXO 21:14" /><verse number="15" style="v" sid="EXO 21:15" />ಕುನಬಿ ತಿನಾಬಾನೆ ರ‍್ಹೈತಬಿ ತಿನಿಯಾನೆ ರ‍್ಹೈತಬಿ ಮಾರ‍್ಯಾರೆ ಕ್ಹರಿಬಿ ತಿನೆ ಮರಣನಿ ಶಿಕ್ಷಾ ಥೌ. <verse eid="EXO 21:15" /><verse number="16" style="v" sid="EXO 21:16" />ಕುನಬಿ ಯಕ್ಲೊ ಮನಕ್ಹನೆ ಕಿಡನ್ಯಾಪ ಕರಿನ ಗೈನ ಇಕ್ಕ್ಯಾಮ ನೈತೊ ತೆ ಬಂದಮಾ ರ‍್ಹತಾಮಾ ಕಿಡನ್ಯಾಪ ಥಯಲವಾಲೊ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಾಮ ತಿನೆಬಿ ಮರಣನಿ ಶಿಕ್ಷಾ ಥವೊ. <verse eid="EXO 21:16" /><verse number="17" style="v" sid="EXO 21:17" />ಕುನಬಿ ತಿಯಾನೆ ರ‍್ಹೈತಬಿ ತಿಬಾನೆ ರ‍್ಹತಬಿ ಕ್ಹರಾಪಾವಾಲಾನೆ ಮರಣನಿ ಶಿಕ್ಷಾ ಥವೊ. <verse eid="EXO 21:17" /><verse number="18" style="v" sid="EXO 21:18" />ಬೆ ಜ಼ನಾ ಲೈಡೈ ಕಡ್ತಾಮಾ ಯಕ್ಲೊ ಹಜಿಯಕ್ಲೊ ದಗ್ಡಾಕ್ಹು ರ‍್ಹೈತಬಿ, ಮುಷ್ಠಿಕ್ಹು ರ‍್ಹೈಬಿ ಮಾರಾಲಕ್ಹು ಮಾರ ಕ್ಹಾದಲವಾಲೊ ಮರೆವಾಚಿ ದಕ್ಹಾ ದಿನ ವಚ್ಚಾನಾ ಧರಿನ, <verse eid="EXO 21:18" /><verse number="19" style="v" sid="EXO 21:19" />ಪಾಚಾತೊ ತೆ ಉಟಿನ ಲಾಕಡಿ ಧರಲಿನ ಫರಾನೆ ರ‍್ಹಯಾಮ ತಿನೆ ಮಾರಲವಾಲಾನೆ ಶಿಕ್ಷಾ ದ್ಯು ನೈ. ತೆ ನೈಸೊ ಮಾರ ಕ್ಹಾದಲವಾಲೊ ಮನಕ್ಹ ಗುಣ ಹೊಂದಲ ವಾಲಾವೊನೆ ಥಾವಾನೊ ಕ್ಹರ್ಚ ಮಾರಲವಾಲಾನೆ ದ್ಯೂ ವರಿ ತೆ ಪೂರಾ ಚೊಕೊ ಥೌಕೈನ ಕರು. <verse eid="EXO 21:19" /><verse number="20" style="v" sid="EXO 21:20" />ಯಕ್ಲೊ ತಿನಾ ದಾಸ ರ‍್ಹವಾದೆ, ದಾಸಿನೆ ರ‍್ಹವಾದೆ ಲಾಕಡಿಕ್ಹು ಮಾರಿನ ಮರಾ ವರಕ್ಹಾ ಮಾರ‍್ಯಾಮ, ತಿನಾ ನೀಂಗತಜ ಶಿಕ್ಷಾ ಥವೊ. <verse eid="EXO 21:20" /><verse number="21" style="v" sid="EXO 21:21" />ತೆ ದಾಸ ತೆಳಾಮಾಜ಼ ಮರ‍್ಯಾರೆ ಯಕ್ಕ ಬೆ ತನ್ನ ದಿನ ವಾಚ್ಯಾಮ, ಮಾಲಕನೆ ಶಿಕ್ಷಾನೆ ದ್ಯು ನೈ . ಕಾ ಕದ್ಯಾಮ ತೆ ದಾಸ ತಿನೊ ಆಸ್ತಿ ಥಯೊಸ. <verse eid="EXO 21:21" /><verse number="22" style="v" sid="EXO 21:22" />ಮನಕ್ಹೊ ಲಡೆ ಕಡ್ತಾಮಾ ಪೆಟೆ ರ‍್ಹಯಲ ಬಾಕ್ಡಿನೆ ಮಾರ ಲಾಗಲಕ್ಹು ತಿನೆ ಪೆಟ ದುಕ್ಯಾಮ, ತೆ ಬಾಕ್ಡಿನೊ ಮಾಟಿ ಪುಚ್ಚಲ ಅಕ್ಲು ವರಿ ನ್ಯಾಯಾಲಯನಾ ವಿದಿಸನಾ ದಂಡ ಮಾರಲವಾಲಾನೆ ದ್ಯೂ. <verse eid="EXO 21:22" /><verse number="23" style="v" sid="EXO 21:23" />ಬಿಜಾ಼ ಹಾನಿ ಥಯಲ ಪಮಾಫ ಜಿವನೆ ಪ್ರತಿ ಥೈನ ಜ಼ಲಮ ದ್ಯು. <verse eid="EXO 21:23" /><verse number="24" style="v" sid="EXO 21:24" />ಡೊಳಾನೆ ಡೊಳಾ, ದಾತನೆ ದಾತೊ, ಹತ್ತನೆ ಹತ್ತ, ಪಗ್ಗನೆ ಪಗ್ಗ, <verse eid="EXO 21:24" /><verse number="25" style="v" sid="EXO 21:25" />ಬರಿನೆ ಬರಿ, ದುಖನೆ ದುಖ, ಮಾರನೆ ಮಾರ, ಪ್ರತಿ ಥೈನ ದ್ಯೂ. <verse eid="EXO 21:25" /><verse number="26" style="v" sid="EXO 21:26" />ಕುನಬಿ ರ‍್ಹೈತಬಿ ತಿನಾ ನೈತೊ ದಾಸಿನಾ ಡೊಳೊ ಫೊಡಿನ ನಷ್ಟ ಕರ‍್ಯಾಮ ತೆ ಡೊಳಾನೆ ಬದಲ ತ್ಯುನೊನೆ ತೆ ಬಿಡುಗಡೆ ಕರಿನ ವಳೌ. <verse eid="EXO 21:26" /><verse number="27" style="v" sid="EXO 21:27" />ಯಕ್ಲೊ ದಾಸ ರ‍್ಹೈತಬಿ ನೈತೊ ದಾಸಿ ರ‍್ಹೈತಬಿ ದಾತೊ ಪಾಡ್ಯಾಮ ದಾತೊನಾ ಬದಲ ತ್ಯುನೊನೆ ಬಿಡುಗಡೆ ಕರಿನ ವಳೌ.<verse eid="EXO 21:27" /></para>
  <para style="s">ಮಾಲಕೊನಾ ಜಿಮ್ಮೆದಾರಿಯೊ</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28" />ಕಿಯಾಬಿ ಯಕ್ಕ ಬೈಲ ದಾಣ್ಗಾನೆ ರ‍್ಹವಾದೆ, ಬಾಕ್ಡಿನೆ ರ‍್ಹವಾದೆ, ತಿವಿನ ಕತ್ರ್ಯಾಮ ತೆ ಬೈಲನೆ ಕ್ಹರಿಜ಼ ದಗ್ಡೊ ಭಿರಕೈನ ಮಾರು. ತಿನಾ ಮಾಕ್ಹನೆ ಕ್ಹೌ ನೈ. ತೆ ನೈಸೊ ತೆ ಬೈಲನಾ ಮಾಲಕ ನಿರಪರಾದಿ ಥವು. <verse eid="EXO 21:28" /><verse number="29" style="v" sid="EXO 21:29" />ತೆನೈಸೊ ತೆ ಬೈಲ ಪೈಲಾತಿಜ ಹಾಯಸ ಕೈನ ಮಾಲಕನಿ ತಿಳದ್ಯಾಮ ತೆ ತಿನೆ ಭಾಂದಿನ ಘಾಲಲ ಹುತಿ ತೆ ದಾಣ್ಗಾನೆ ರ‍್ಹವಾದೆ, ಬಾಕ್ಡಿನೆ ರ‍್ಹವಾದೆ ಕಲಾಸ ಕರ‍್ಯಾಮ ತೆ ಬೈಲನೆ ದಗ್ಡೊ ನಾಕಿನ ಕ್ಹಲಾಸ ಕರು.ತೆ ನೈಸೊ ತಿನೊ ಮಾಲಕ ಮರಣನಾ ದಂಡನೆ ಗುರಿ ಥಯೊ. <verse eid="EXO 21:29" /><verse number="30" style="v" sid="EXO 21:30" />ತೆ ನೈಸೊ ತೆ ಮಾಲಕನೆ ದೊಕ್ಡಾ ದಿದ್ಯಾಮ ತೆ ತಿನೆ ನೆಮಕ ಥಯಲ ದೊಕ್ಡಾದಿನ ತಿನೊ ಜ಼ಲಮ ವಚಾ಼ಡಿ ಲಿವಾದೆ. <verse eid="EXO 21:30" /><verse number="31" style="v" sid="EXO 21:31" />ತೆ ಬೈಲ ದಿಕ್ರಾನೆ ರ‍್ಹವಾದೆ ನೈತೊ ದಿಕ್ರಿನೆ ರ‍್ಹವಾದೆ ತಿವಿದ್ಯಾಮ ನ್ಯಾಯ ತಿರ್ಪಿನಾ ನಿಂಗತ ತಿನಾ ಮಾಲಕನೆ ಕರು. <verse eid="EXO 21:31" /><verse number="32" style="v" sid="EXO 21:32" />ದಾಸನೆ ರ‍್ಹವಾದೆ ದಾಸಿನೆ ರ‍್ಹವಾದೆ ಬೈಲ ತಿವದ್ಯಾಮ ದಾಸನಾ ನೈತೊ ದಾಸಿನಾ ಮಾಲಕನೆ ಮೂವತ್ತ ರುಪ್ಪಾನಾ ಘಟ್ಟಾ ದ್ಯೂ, ವರಿ ತೆ ಬಯಲನೆ ದಗ್ಡೊ ನಕಿನ ಕಲಾಸ ಕರುಸ. <verse eid="EXO 21:32" /><verse number="33" style="v" sid="EXO 21:33" />ಯಕ್ಲೊ ಕ್ಹಾಡಿ ಕ್ಹಂದ್ಯಾಮ ನೈತೊ ಕ್ಹಂದಿನ ತೆ ನೈ ಝಾಕಿನ ತಿಮಾ ಬೈಲ ರ‍್ಹವಾದೆ, ಗದ್ಡೂ ರ‍್ಹವಾದೆ ತೆ ಕ್ಹಾಡಿಮಾ ಪಡಿನ ಮರ‍್ಯಾರೆ, <verse eid="EXO 21:33" /><verse number="34" style="v" sid="EXO 21:34" />ತೆ ಕ್ಹಾಡಿ ಕ್ಹಂದಲವಾಲೊ ಥಯಲ ನಷ್ಟನೆ ಪ್ರತಿ ಥೈನ ಇಡು ದ್ಯೂ. ಬೈಲನಾ ಮಾಲಕನೆ ತೃಪ್ತಿ ಥಾವಾ ವರಕ್ಹು ಕ್ರಯ ದ್ಯೂ. ಮರಲ ಬೈಲನೆ ತೆಜ಼ ಕಾಡಿ ಲೆಸಕಸ. <verse eid="EXO 21:34" /><verse number="35" style="v" sid="EXO 21:35" />ಯಕ್ಲಾನಿ ಬೈಲ ಹಜಿಯಕ್ಲಾನಿ ಬೈಲನೆ ಹಾಯಿದಿನ ಮಾರ‍್ಯಾರೆ ಜಿವತಿ ರ‍್ಹಯಲ ಬೈಲನೆ ಇಕ್ಕಿನ ತಿನೊ ಕ್ರಯ ದ್ಯೂ. ತೆ ಮರಲ ಬೈಲನೆ ಭಂಬಿ ಜ಼ನಾ ಬರಾಬರ ವಾಟಿ ಲ್ಯು. <verse eid="EXO 21:35" /><verse number="36" style="v" sid="EXO 21:36" />ತೆನೈಸೊ ತೆ ಬೈಲ ಪೈಲಾತಿಬಿ ಹಾಯ್ದಾನಿಂಗತ ಕೈನ ತಿನಾ ಮಾಲಕನೆ ತಿಳದ್ಯು ತಬಿ ತಿನೆ ನಯ ಭಾಂದಲಕ್ಹು ತಿನಾ ಬೈಲನೆ ಪ್ರತಿ ಥೈನ ಬಯಲನೆ ಕ್ಹರಿಜ಼ ಬದಲಿನ ದ್ಯೂ. ತೆ ನೈಸೊ ಮರಲ ಬೈಲನೆ ತೆಜ಼ ಲೆಸಕಸ.<verse eid="EXO 21:36" /></para>
  <chapter eid="EXO 21" />
  <chapter number="22" style="c" sid="EXO 22" />
  <para style="s">ಬದಲಿ ದಿವಾನಾಹುತಿ ನಿಯಮ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1" />ಯಕ್ಲೊ ಬೈಲನೆ ರ‍್ಹವಾದೆ, ಬಕ್ರಾನೆ ರ‍್ಹವಾದೆ ಕಾಳ್ಳಿಲಿನ ಕಾಟ್ಯಾಮ ನೈತೊ ಇಕ್ಕ್ಯಾಮ ತೆ ಯಕ್ಕ ಬೈಲನಾ ಬದಲ ಪಾಂಚ ಬೈಲೊನೆ ದ್ಯು ಯಕ್ಕ ಬಕ್ರಾನಾ ಬದಲಿ ಚಾರ ಬಕ್ರಾ ದ್ಯೂ. <verse eid="EXO 22:1" /><verse number="2" style="v" sid="EXO 22:2" />ಯಕ್ಲೊ ಚ್ವಟ್ಟೊ ಚೊರಿ ಕರ್ತಾಮಾ ಹತೆ ಮಳಲಪರ ತಿನೆ ಕಲಾಸ ಕರ‍್ಯಾಮ ತೆನಿ ನರಹತ್ಯಾ ಮೊಜಿನ ನೈ ದೆತಾ. <verse eid="EXO 22:2" /><verse number="3" style="v" sid="EXO 22:3" />ಸೂರ‍್ಯೊ ಹುಟ್ಟಲಪರ ಯಕ್ಲೊ ಚೊರಿ ಕರಿನ ಮಳ್ತಾಮಾ, ತೆನೆ ಮಾರಿನ ಕ್ಹಲಾಸ ಕರ‍್ಯಾಮ ತೆ ನರಹತ್ಯಾ ವ್ಹೈ ಕೈನ ಮೊಜು. <verse eid="EXO 22:3" /><verse number="4" style="v" sid="EXO 22:4" />ಚೊರಿ ಕರಲ ಬೈಲ ರ‍್ಹವಾದೆ, ಗದ್ಡೂ ರ‍್ಹವಾದೆ, ಬಕ್ರು, ಕಯು ಥೈತಬಿ ಜಿವಕ್ಹು ಚೊರಿ ಕರಲವಾಲಾಕನ ಮಳ್ಯಾರೆ ತೆ ಬೆ ಪಟ್ಟ ಅಕ್ಲು ದ್ಯೂ. <verse eid="EXO 22:4" /><verse number="5" style="v" sid="EXO 22:5" />ಯಕ್ಲೊ ತಿನಾ ಕ್ಹೆತರಮಾ ರ‍್ಹವಾದೆ, ದ್ರಾಕ್ಷಿನಾ ಮಳಾಮಾ ರ‍್ಹವಾದೆ ತಿನಾ ಬೈಲೊನೆ ಚರೈನ, ಹಜಿಯಕ್ಲಾನಾ ಕ್ಹೆತರಮಾ ರ‍್ಹವಾದೆ, ದ್ರಾಕ್ಷಿನಾ ಮಳಾಮಾ ರ‍್ಹವಾದೆ ಚರಾವಾ ನಿಂಗತ ಕರ‍್ಯಾಮ, ತಿನಾ ಖೆತರನಾ ನೈತೊ ದ್ರಾಕ್ಷಿನಾ ಮಳಾಮಾ ಚೊಕೊ ಭಾಗನೆ ತಿನೆ ಇಡ ದ್ಯೂ. <verse eid="EXO 22:5" /><verse number="6" style="v" sid="EXO 22:6" />ಯಕ್ಲೊ ಲಗಾಡಲ ಆಗ ಅಕಸ್ಮಾ ಕಾಟಾವಾನಾ ಝಾಡೊನೆ ಆಗ ಲಾಗಿನ ದವಸನಾ ರಾಶಿಯೊ ರ‍್ಹವಾದೆ, ಬೆಳೆ ರ‍್ಹವಾದೆ, ಕ್ಹೆತರ ರ‍್ಹವಾದೆ, ಬಳಿನ ಗಯಾಮ ಆಗ ಲಗಾಡಲವಾಲೊ ತಿನೆ ಇಡ ದ್ಯೂ. <verse eid="EXO 22:6" /><verse number="7" style="v" sid="EXO 22:7" />ಯಕ್ಲೊ ದೊಕ್ಡಾ ರ‍್ಹವಾದೆ, ಕ್ಹೊನೊ ರ‍್ಹವಾದೆ ವಚಾ಼ಡಾನಾಹುತಿ ಹಜಿಯಕ್ಲಾನೆ ಒಪ್ಸಾಯಲ್ಪರ ತೆ ತಿನಾ ಮನಕ್ಹನಾ ಘರಮಾ ಚೊರಿ ಥಯಲ್ಪರ, ಚೊಟ್ಟೊ ಕ್ಹಾಪಡೊಮ ಬೆ ಪಟ್ಟ ದಂಡ ದ್ಯೂ. <verse eid="EXO 22:7" /><verse number="8" style="v" sid="EXO 22:8" />ಚೊಟ್ಟೊ ನೈ ಮಳ್ಯಾಮ ತೆ ಘರನೊ ಮಾಲಕ ತೆಜ಼ ತೆ ಕ್ಹೊನಾನೆ ಚೊರಿ ಕರ‍್ಯೊಸು ನೈ ಕವಾನು ದೃಡಪಡಸಾನಾಹುತಿ ಕ್ಹುದಾನೆ ಆರಾದನಾ ಕರಾನಿ ಜ಼ಗಾಮಾ ದಿಕ್ಹು. <verse eid="EXO 22:8" /><verse number="9" style="v" sid="EXO 22:9" />ವಂಚನೆ ಥಯು ಕೈನ ಅವಮಾನ ಹುಟ್ಟಲ ಹರಯಕ್ಕ ವಿಷಯಮಾ, ತೆ ಬೈಲ, ಗದ್ಡೂ, ಬಕ್ರು ನೈತೊ ವಣ್ಣಾವೊನಾ ವಿಶಯಮಾ, ಜವೈಲಿದ್ಯಾಮ ಬಿಜಾ಼ ಕಯಾ ವಸ್ತುನಾ ವಿಶಯಮಾ, ಬೆಜ಼ನಾ ತೆ ತ್ಯುನುಜ ವ್ಹೈಕೈನ ಕತಾಮಾ ತೆ ಬೆ ಜ಼ನಾನಾ ವ್ಯಾಜ್ಯ ಕ್ಹುದಾನಾ ಸನ್ನಿದಿನೆ ಔ. ಕ್ಹುದಾಬಿ ಕಿನೆ ದ್ರೊಹಿ ಕೈನ ನಿರ್ಣಯ ಕರ‍್ಯೊಸ ತೊ ತೆ ಬೆ ಪಟ್ಟ ತಿನಾ ನೆರೆವಾಲಾನೆ ದ್ಯೂ. <verse eid="EXO 22:9" /><verse number="10" style="v" sid="EXO 22:10" />ಯಕ್ಲೊ ತಿನಾ ನೆರೆವಾಲಾನೆ ಗದ್ಡೂ ರ‍್ಹವಾದೆ, ಬೈಲ ರ‍್ಹವಾದೆ, ಬಕ್ರು ರ‍್ಹವಾದೆ ಬಿಜಾ಼ ಕಯಾ ರ‍್ಹವಾದೆ ಪಶುನೆ ರ‍್ಹವಾದೆ ವಚಾ಼ಡಾನಾಹುತಿ ದಿದಲ, ತೆ ಮರ‍್ಯಾಮ ನೈತೊ ಡುಕ್ಕ ಥಯಾಮ ನೈತೊ ಕುನಬಿ ತಿಳದ್ಯಾ ನೈಸೊ ಚೊರಿ ಥಯಾಮ, <verse eid="EXO 22:10" /><verse number="11" style="v" sid="EXO 22:11" />ತೆ ಮನಕ್ಹ ತೆಜ಼ ತೆ ಸೊತ್ತನಾ ವಿಷಯಮಾ ಮೊಸ ಕರ‍್ಯೊ ನೈ ಕವಾನಾಹುತಿ ದೃಡಪಡಸಾನಾಹುತಿ ಯಹೊವಾನಾ ಉಪ್ಪರ ಕ್ಹಮ್ಮ ಘಾಲು. ತೆಳಾಮಾ ತೆ ಪಶುನಾ ಒಡೆಯೊ ಕ್ಹರಿನಿ ವ್ಯಾಕ್ಯಾ ನಂಬು. ಕ್ಹಮ್ಮ ಘಾಲಲವಾಲೊ ತಿನೆ ಇಡ ದಿವಾನಾಹುತಿ ಅಗ್ಯತ ನತ್ತಿ. <verse eid="EXO 22:11" /><verse number="12" style="v" sid="EXO 22:12" />ತೆ ನೈಸೊ ತೆ ಪಶು ತಿಕನಂತು ಚೊರಿ ಥಯಾಮಾ ತೆ ಮನಕ್ಹ ತಿನಾ ಮಾಲಕನೆ ಯಕ್ಕ ಥೈನ ಇಡ ದ್ಯೂ. <verse eid="EXO 22:12" /><verse number="13" style="v" sid="EXO 22:13" />ಜಂಗಲನಾ ಪ್ರಾಣಿಯೊ ತೆ ಪಶುವೊನೆ ಕ್ಹಲಾಸ ಕರ‍್ಯಾಮ, ತಿನೊ ಮೂರ್ದಾನೆ ಗುರತ ಥೈನ ದೆಕ್ಲಾಡಾದೆ. ಜಂಗಲನಾ ಪ್ರಾಣಿನೆ ಕಲಾಸ ಕರಲಕ್ಹು ಇಡ ದಿವಾನು ಅಗತ್ಯ ನತ್ತಿ. <verse eid="EXO 22:13" /><verse number="14" style="v" sid="EXO 22:14" />"ಯಕ್ಲೊ ಹಜಿಯಕ್ಲೊ ಪಶುನೆ ದಕ್ಹಾ ಟೈಮ ಭಾಡೆ ಲಿದಲಕ್ಹು ತೆ ಪಶುನೊ ಮಾಲಕ ತಿನಾ ಬಾಜು಼ ನೈ ರ‍್ಹಯಲ ಟೈಮಾ ತಿನೆ ದುಃಖ ಥಯಾಮ ನೈತೊ ಮರ‍್ಯಾಮ ಸಾಲಾ ಲಿದಲವಾಲೊ ಇಡ ದ್ಯೂ. <verse eid="EXO 22:14" /><verse number="15" style="v" sid="EXO 22:15" />ಮಾಲಕ ತಿನಾ ಬಾಜು಼ಮಾ ರ‍್ಹವತ್ತೊ, ತಿನೆ ಇಡ ದಿವಾನು ಅಗತ್ಯ ನತ್ತಿ. ತೆ ಭಾಡೆ ಲಿದಲ ರ‍್ಹಯಾಮಾ ತಿನೆ ಥಯಲ ನಷ್ಟ ಭಾಡಾನಾ ಇಸಾಬಮಾ ಮೊಜು.<verse eid="EXO 22:15" /></para>
  <para style="s">ಸಾಮಾಜಿಕ ನಿಯಮೊ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16" />ಘಟ್ಟ ಥಯಲ್ಪರ ಹೆಣ್ಣನೆ ಯಕ್ಲೊ ಉಸಕ ಜಮಾ ಕರಿನ ಸಂಗ ಮಿಸ್ಯಾಮ ತಿನಾಹುತಿ ಕರೆಟ್ಟ ತೆರನೆ ದಿನ ತಿನೆ ಹಿವಾ ಕರಲ್ಯೂ. <verse eid="EXO 22:16" /><verse number="17" style="v" sid="EXO 22:17" />ತೆನೈಸೊ ತಿನೊ ಬಾಪ ಅನೆ ತಿನೆ ದಿವಾನಾಹುತಿ ನೈ ಒಪ್ಪ್ಯಾಮ ತೆ ಮನಕ್ಹನಾ ತಕ್ಕ ದೊಕ್ಡಾ ತೆರನೆ ದ್ಯೂ. <verse eid="EXO 22:17" /><verse number="18" style="v" sid="EXO 22:18" />ಮಾಟಾಮಂತ್ರಾ ಕರಾಲಿನೆ ಉಗ್ರಾಡುಜ ನೈ <verse eid="EXO 22:18" /><verse number="19" style="v" sid="EXO 22:19" />ಪಶುನೂ ಸಂಗ ಕರಲವಾಲಾನೆ ಮರಣನಿ‍ ಶಿಕ್ಷಾ ಥವು. <verse eid="EXO 22:19" /><verse number="20" style="v" sid="EXO 22:20" />ಯಹೊವಾ ಯಕ್ಲಾನೆಜ ನೈಸೊ ಬಿಜಾ಼ ದೆವಸ್ಥಾನನೆ ಯಜ್ಞ ಕಾರಾಲೊ ಸಂಪೂರ್ಣ ನಾಸ ಥವು. <verse eid="EXO 22:20" /><verse number="21" style="v" sid="EXO 22:21" />"ಪರದೆಶಿವಾಲಾನೆ ಅನ್ಯಾಯ ಕರುನೈ ಉಪದ್ರವ ದ್ಯೂ ನಯ ತುಮೆ ಐಗುಪ್ತ ದೆಶಮಾ ಪರದೆಶಿ ಥಯಾಸ ತೊ? <verse eid="EXO 22:21" /><verse number="22" style="v" sid="EXO 22:22" />ವಿದೆಯೆನೆ ರ‍್ಹವಾದೆ ದಿಕ್ಕ ನಯಸೊ ಬಚ್ಚಾ಼ವೊನೆ ರ‍್ಹವಾದೆ ಕಸ್ಟ ದ್ಯೂ ನೈ. <verse eid="EXO 22:22" /><verse number="23" style="v" sid="EXO 22:23" />ತುಮೆ ಹವಾವೊನೆ ಕಸ್ಟ ದಿದ್ಯಾಮ ತ್ಯುನೆ ಮೊರೆ ಮ್ಹೆಲಸ ತೆ ಮೊರೆನೆ ಮಿ ಕಾನ ದ್ಯೂಸ ಕೈನ ತಿಳದಿ ಲಿವೊ. <verse eid="EXO 22:23" /><verse number="24" style="v" sid="EXO 22:24" />ಮಿ ಸಿಟ್ಟೆ ಉಟಿನ ತುಮಾರಾ ಶತ್ರುವೊನೆ ತಲ್ವಾರಕ್ಹು ಕತ್ರಿ ಪಡುಸ. ತುಮಾರಾ ಬಯಕೊ ವಿದವೆ ಥಾವಸ. ತುಮಾರಾ ಬಚ್ಚಾ ದಿಕ್ಕ ನಯಸೊ ಥಾವಸ. <verse eid="EXO 22:24" /><verse number="25" style="v" sid="EXO 22:25" />ಮಾರಾ ಮನಕ್ಹೊಮಾ ಯಕ್ಲಾ ಗರಿಬನೆ ತು ದೊಕ್ಡಾ ದಿದ್ಯಾರೆ ತಿನೆ ಸಾಲಾ ಲಿವಾಲೊ ನಿಂಗತ ದಿಕ್ಹು ನೈ. ತಿಕಂತೊ ಬಡ್ಡಿ ಪುಚ್ಚು ನೈ. <verse eid="EXO 22:25" /><verse number="26" style="v" sid="EXO 22:26" />ತು ಯಕ್ಲಾನೆ ಕಂಬಳಿ ವತ್ತಿ ಮ್ಹೆಲ್ಲಿದ್ಯಾರೆ ಸುರ್ಯೊ ಡುಬೆಲಕ್ಕಾ ತಿನೆ ಪಾಚೊ ದ್ಯೂ. <verse eid="EXO 22:26" /><verse number="27" style="v" sid="EXO 22:27" />ಕಾ ಕದ್ಯಾಮ ತೆ ತಿನೆ ಯಕ್ಕಜ ಹೊದಿಕೆ ಥಯಿಸ. ತೆಜ಼ ತಿನಾ ಅಂಗನೆ ವಣ್ಣಾ.ತೆ ಬಿಜು಼ ಕಯು ವಳ್ಳಿನ ಕ್ಹುರೌ? ತೆ ಮನೆ ಮೊರೆ ಮ್ಹೆಲ್ಯಾಮ ಮಿ ಕಾನ ದಿನ ಐಕುಸ. ಕಾ ಕದ್ಯಾಮ ಮಿ ದಯಾವಾಲೊ ವ್ಹೈ. <verse eid="EXO 22:27" /><verse number="28" style="v" sid="EXO 22:28" />ಕ್ಹುದಾನೆ ದೊಷ ದ್ಯೂ ನೈ. ತಾರಾ ಮನಕ್ಹೊನಾ ಅದಿಕಾರೊನೆ ಶಾಪ ದ್ಯೂ ನೈ. <verse eid="EXO 22:28" /><verse number="29" style="v" sid="EXO 22:29" />ತುಮಾ ಕಣಕ್ಹು ವರಿ ದ್ರಾಕ್ಷಾ ಲತಕ್ಹು ಮನೆ ಸಲ್ಲಿಸಾನೂ ಸಮರ್ಪಿಸ ಕರಾನೆ ಲೆಟ ಕರು ನೈ. ತಾರಾ ಪಸ್ಟ ಗಂಡ ಬಚ್ಚಾ಼ನೆ ಮನೆ ಸಮರ್ಪಿಸ ಕರು. <verse eid="EXO 22:29" /><verse number="30" style="v" sid="EXO 22:30" />ತಿನಾ ನಿಂಗತಜ಼಼ ತುಮಾರಾ ಬಕ್ರಾ, ಬೈಲೊನಾ ಪಸ್ಟ ಬಚ್ಚಾ಼ವೊನೆ ಸಮರ್ಪಿಸ ಕರು. ಕ್ಹಾತ ದಿನ ಲಕ್ಕಾ ತೆ ಬಚ್ಚು ತಿನಿಯಾನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ. ಆಟವಾ ದಿನಮಾ ತಿನೆ ಮನೆ ಸಮರ್ಪಿಸು. <verse eid="EXO 22:30" /><verse number="31" style="v" sid="EXO 22:31" />ತುಮೆ ಮನೆ ಪರಶುದ್ದ ಮನಕ್ಹೊ ಥೈನ ರ‍್ಹೌ. ತಿನಾಹುತಿ ಜಂಗಲನೂ ಪ್ರಾಣಿ ಕತ್ರಲ ತುಮೆ ಕ್ಹೌ ನೈ, ತೆ ಕುತ್ರಾವೊನೆ ಛೊಡೂ.<verse eid="EXO 22:31" /></para>
  <chapter eid="EXO 22" />
  <chapter number="23" style="c" sid="EXO 23" />
  <para style="s">ನ್ಯಾಯ ವರಿ ಚೊಕಿತನಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1" />ಸುಳ್ಳ ಸುದ್ದಿ ಫೈಲೌನೈ.ದುಷ್ಟೊನಾ ಕ್ಹಾತೆ ಮಳಿನ ಸುಳ್ಳ ಸಾಕ್ಷಿ ಕೌನೈ. <verse eid="EXO 23:1" /><verse number="2" style="v" sid="EXO 23:2" />ದುಸ್ಟ ಕಾಮೊ ಕರಾಲಾ ಘನ್ನಾ ಜ಼ನಾ ಛೆ, ತೆ ರ‍್ಹೈತಬಿ ತುಮೆ ತ್ಯುನಾ ಕ್ಹಾತೆ ಸೆರು ನೈ. ಘನಾ ಜ಼ನಾ ವಾತನೆ ಒಪ್ಪಿನ ನ್ಯಾಯ ಕೆಡಸಾನು ಸಾಕ್ಷಿ ಕವೊ ನೈ. <verse eid="EXO 23:2" /><verse number="3" style="v" sid="EXO 23:3" />ತೆ ನೈಸೊ ಗರಿಬನಾ ಉಪ್ಪರ ಕರುಣೆಕ್ಹು ಪಕ್ಷಪಾತನಾ ತಿರ್ಮಾನ ಕರು ನೈ.<verse eid="EXO 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4" />ತಾರಾ ವೈರಿನಾ ಬೈಲ ರ‍್ಹವಾದೆ, ಗದಡು ರ‍್ಹವಾದೆ ತಪ್ಸಿಲಿನ ಗಯಾಮಾ ತೆ ತುನೆ ಮಳ್ಯಾಮ ತಿನೆ ತಿಕನ ಗೈನ ಒಪ್ಸೂ. <verse eid="EXO 23:4" /><verse number="5" style="v" sid="EXO 23:5" />ತುನೆ ಹಗೆತನ ಕರಾಲಾನಾ ಗದ್ಡಾನಾ ಹೊರೆನಾ ಹೆಟು ಪಡಲ ದೆಕ್ಯಾಮಾ, ತಿನೆ ಉಚಾವಾನೆ ಮನಸ ನೈ ರ‍್ಹೈತಬಿ ತಿ ನೆ ಸಹಾಯ ಕರಿನ ಉಚವೊ. <verse eid="EXO 23:5" /><verse number="6" style="v" sid="EXO 23:6" />"ತುಮಾರಾಮಾ ರ‍್ಹವಾನು ಗರಿಬನಾ ನ್ಯಾಯ ಕೊರಿ ತುಮೊಕನ ಆಯಾಮ ತುಮೆ ಅನ್ಯಾಯ ಫೈಸಲೊ ಕರು ನೈ. <verse eid="EXO 23:6" /><verse number="7" style="v" sid="EXO 23:7" />ಮೊಸನಾ ಕಾಮಕ್ಹು ದುರ ಥಯನ ರ‍್ಹೌ. ಸುಜ ತಪ್ಪ ನೈಸೊವಾಲೊ ನಿತಿವಂತವಾಲೊ ರ‍್ಹವಾನಾ ಮನಕ್ಹನೆ ಮರಾನಾ ಶಿಕ್ಷಾ ದ್ಯೂಜ ನೈ. ತ್ಯವಾ ದುಷ್ಟನೆ ಮಿ ಶಿಕ್ಷಾ ದಿದೆವಾಚಿ ನೈ ಛೊಡತೊ. <verse eid="EXO 23:7" /><verse number="8" style="v" sid="EXO 23:8" />ಲಂಚಾ ಕಾಡಿಲ್ಯೂನೈ, ಲಂಚ ಡೊಳಾವಾಲಾನೆ ಕುಡ್ಡಾ ನಿಂಗತ ಕರುಸ, ಸು ತಪ್ಪ ನೈಸೊವಾಲೊ ಮಾಳಾನಾ ನ್ಯಾಯನಾ ಚುಕೌ. <verse eid="EXO 23:8" /><verse number="9" style="v" sid="EXO 23:9" />ಬಿಜಾ಼ ದೆಶವಾಲಾನೆ ಉಪದ್ರವ ದ್ಯೂ ನೈ. ತುಮೆ ಐಗುಪ್ತ ದೆಶಮಾ ಪರದೆಶಿವಾಲಾ ಥಯಾಸ. ತ್ಯವಾವೊನಾ ಮನಸನಿ ಭಾವ್ನಾನೆ ತಿಳದಲವಾಲಾ ಥಯಾಸ.<verse eid="EXO 23:9" /></para>
  <para style="s">ಕ್ಹಾತವಾ ವರಕ್ಹ ವರಿ ಕ್ಹಾತವಾ ದಿನ್ನನಾಹುತಿ</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10" />ಛೆ ವರಕ್ಹ ತುಮಾರಾ ಕ್ಹೆತರನೆ ಬಿತ್ತಿನ ತಿನಾ ಫಲನೆ ಕಾಡಿಲಿವೊ. <verse eid="EXO 23:10" /><verse number="11" style="v" sid="EXO 23:11" />ತೆ ನೈಸೊ ಕ್ಹಾತವಾ ವರಕ್ಹಮಾ ತೆ ಜಿಮಿನೆ ಉಗ್ರಾಡಾನೆ ಛೊಡಿಪಡು. ತುಮಾರಾ ದೆಶನಾ ಗರಿಬೊ ತಿಮಾ ಹುಟ್ಟಾನು ಕ್ಹಾವಾದೆ. ಉಗ್ರಲ ಕ್ಹಾರು ಜಂಗಲನಾ ಪ್ರಾಣಿಯೊ ಚರಾದೆ. ತುಮಾರೊ ದ್ರಾಕ್ಷಿನೊ ಮಳಾನಾ ವರಿ ತೆಲನಾ ಝಾಡೊನಾ ತೊಪೊನಾ ವಿಷಯಮಾ ಆನಾ ನಿಂಗತಜ಼಼ ಕರು.<verse eid="EXO 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 23:12" />ಅಟ್ವಾಡಾಮಾ ಛೆ ದಿನ ತುಮಾರಾ ಕಾಮೊ ಕರಲಿವೊ ಕ್ಹಾತವಾ ದಿನಮಾ ಕಯುಜ಼ ಕಾಮ ಕರೆವಾಚಿ ರ‍್ಹೌ. ತೆ ಟೈಮಾ ತುಮಾರಾ ಬೈಲೊನೆ ,ಗದ್ಡಾವೊನೆ, ದಾಸ, ದಾಸಿಯೊನೆ, ಬಿಜಾ಼ ದೆಶವಾಲಾ ವಿಶ್ರಾಮ ಲಿದ್ಯಾ. <verse eid="EXO 23:12" /><verse number="13" style="v" sid="EXO 23:13" />ಮಿ ತುಮೊನೆ ಕದಲ ಕ್ಹಾರು ಹುಶಾರಕ್ಹು ಕಾಯ್ದಿಲಿಯು. ಬಿಜಾ಼ ದೆವಸ್ಥಾನೊನೆ ಸೊಚುನೈ, ತೆ ನಾಮೊನೆ ಕೌ ನೈ.<verse eid="EXO 23:13" /></para>
  <para style="s">ತನ್ನ ಮ್ಹೊಟಾ ಸನ್ನೊ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14" />ತುಮೆ ಹರ ವರಕ್ಹೆ ತನ್ನ ಸಲಾ ಮನೆ ಸನ್ನ ಕರು. <verse eid="EXO 23:14" /><verse number="15" style="v" sid="EXO 23:15" />ಕ್ಹಾಟು ನೈ ರ‍್ಹಯಲ ರೊಕ್ಲಾವೊನೆ ಕ್ಹಾವಾನೊ ಸನ್ನ. ಮಿ ತುಮೊನೆ ಕದಲ ನಿಂಗತ ತುಮೆ ಚೈತ್ರ ಅಮಾಸಮಾ ನೆಮಕ ಥಯಲ ಕಾಲಮಾ ಕ್ಹಾತ ದಿನ ಕ್ಹಾಟೊ ರೊಕ್ಲಾವೊನೆ ಕ್ಹೌ. ತೆ ಮ್ಹೈನಾಮಾಜ ಐಗುಪ್ತ ದೆಶತೊ ಆಯಲ ಸ್ಹೆನಾಹುತಿ ಕರುಜ಼. ಹತ್ಮಾ ಕಾಣಿಕೆವಾಚಿ ಕ್ಹಾಲಿ ಹತೆ ಮಾರಾ ಸನ್ನಿದಿನೆ ಕುನ್ನಜ ಔನೈ. <verse eid="EXO 23:15" /><verse number="16" style="v" sid="EXO 23:16" />ತೆ ನೈಸೊ ತುಮೆ ಘಾಲಲ ಕ್ಹೆತರಮಾ ಪೈಲಾ ಫಲನೆ ಆತಾಮಾ ಸಗ್ಗಿನೊ ಸನ್ನ ಕರು. ಕ್ಹೆತರ ಮಳಾನಾ ಫಲನೆ ಜಮಾ ಕರ‍್ತಾಮಾ ಕದ್ಯಾಮ ವರಕ್ಹನಾ ಲಾಸ್ಟಮಾ ಸುಗ್ಗಿನೊ ಸನ್ನ ಕರು. <verse eid="EXO 23:16" /><verse number="17" style="v" sid="EXO 23:17" />ವರಕ್ಹಮಾ ತನ್ನ ಸಲಾ ತುಮಾರಾಮಾ ರ‍್ಹವಾನಾ ದಾಣ್ಗಾ ಕ್ಹಾರಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಾ ಸನ್ನಿದಿನೆ ಮಳಿನ ಔ. <verse eid="EXO 23:17" /><verse number="18" style="v" sid="EXO 23:18" />ಮನೆ ಯಜ್ಞ ಕರ‍್ತಾಮಾ ತೆ ಬಲಿನಾ ಬಚ್ಚಾನಾ ರಗತನಾ ಕ್ಹಾತೆ ಕ್ಹಾಟು ಥಯಲ ಲೊಟನೆ ಸಮರ್ಪಿಸ ಕರು ನೈ. ಮಾರಾ ಸನ್ನಮಾ ತುಮೆ ಮನೆ ಸಮರ್ಪಿಸ ಕರಾನು . ಪಶುನಾ ಮಕ್ಹನೆ ಅಗಲ್ಯಾ ದಿನ್ನ ಲಕ್ಕಾ ಮ್ಹೆಲುಜ ನೈ. <verse eid="EXO 23:18" /><verse number="19" style="v" sid="EXO 23:19" />ತುಮಾರಾ ಬೆಳೆನಾ ಪೈಲಾ ಫಲಮಾ ಘನ್ನು ಶ್ರೆಷ್ಠ ಥಯಲ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ಗುಡಿನೆ ಲಿನ ಔ. ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ನೆ ತಿನಿಯಾನಾ ದುದ್ದಮಾ ಉಕ್ಳೌ ನೈ.<verse eid="EXO 23:19" /></para>
  <para style="s">ವಾಗ್ದಾನ ವರಿ ಮಾರ್ಗದರ್ಶನ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20" />ಹಮ್ನಾ ವಾಟಮಾ ತುಮೊನೆ ವಚಾ಼ಡಾನಾಹುತಿ,ಮಿ ಗ್ವತ್ತ ಕರಲ ಜ಼ಗಾನೆ ತುಮೊನೆ ಬೈಲೈಲಿನ ಆವಾನಾಹುತಿ ದುತನೆ ತುಮಾರಾ ಅಗೊ ವಳಾಯೊಸ. <verse eid="EXO 23:20" /><verse number="21" style="v" sid="EXO 23:21" />ತು ತಿಮಾ ಧ್ಯಾನದಿನ ತಿನಾ ವಾತೆ ವಿದೆಯೆ ಥೌ. ತಿನೆ ದಿಕ್ಕರಶ್ಯಾಮ ತುಮಾರಾ ಅಪರಾದೊನೆ ನೈ ಕ್ಷಮಸತೊ. ಮಾರಾ ನಾಮನಿ ಮಹಿಮಾ ತಿನಾಮಾ ರ‍್ಹವಸ. <verse eid="EXO 23:21" /><verse number="22" style="v" sid="EXO 23:22" />ತುಮೆ ತಿನಾ ವಾತೊನೆ ಮನಸೆ ಐಕಿನ ಮಾರಾ ಆಜ್ಞಾನಾ ಪ್ರಕಾರ ಚಾಲಿ ಲಿದ್ಯಾಮ ಮಿ ತುಮಾರಾ ದುಸ್ಮನೊನೆ ದುಸ್ಮನೊ ನಿಂಗತಜ಼಼, ತುಮೊನೆ ತ್ರಾಸಕರಾಲಾನೆ ತ್ರಾಸ ಕಾರಾ ನಿಂಗತಜ಼಼ ಥವೊಸ. <verse eid="EXO 23:22" /><verse number="23" style="v" sid="EXO 23:23" />ಮಾರೊ ದುತ ತುಮಾರಾ ಕ್ಹಾಮೊ ಗೈನ ಅಮೊರಿಯೊ, ಹಿತ್ತಿಯೊ, ಪೆರಜಿಯೊ, ಕಾನಾನ್ಯರೊ, ಹಿವ್ವಿಯರೊ, ಯೆಬುಸಿಯರೊ, ರ‍್ಹವಾನಾ ದೆಶನೆ ತುಮೊನೆ ಸೆರಸುಸ. ತ್ಯುನೊನೆ ರ‍್ಹೈತಬಿ ಸು ನೈಸೊ ನಿಂಗತಜ಼಼ ಕರಸ. <verse eid="EXO 23:23" /><verse number="24" style="v" sid="EXO 23:24" />ತ್ಯುನಾ ದೆವತೆಯೊ ತುಮೆ ಅಡ್ಡ ಪಡಿನ ಪಗೆಬಿ ಪಡು ನೈ, ತ್ಯುನಾ ಆಚರಣೆನೆ ಕರುಜ ನೈ.ತೆ ಮನಕ್ಹೊನೆ ಸುಜ ನೈಸೊ ಕರಿನ ಮೂರ್ತಿಯೊನಾ ಕ್ಹಂಬಾ ಹಾಳ ಕರು <verse eid="EXO 23:24" /><verse number="25" style="v" sid="EXO 23:25" />ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಯಕ್ಲಾನೆಜ ಆರಾಧನಾ ಕರು. ತೆಳಮಾ ತೆ ತುಮಾರಾ ಅನ್ನ ಪಾನೊನೆ ಆಶಿರ್ವಾದ ದಿವಸ. ತುಮಾರಾಮಾ ರ‍್ಹವಾನಾ ರೊಗೊನೆ ಕಾಡಿ ಪಡುಸ. <verse eid="EXO 23:25" /><verse number="26" style="v" sid="EXO 23:26" />ತುಮಾರಾ ದೆಶ ಗರ್ಬ ಪಾತ ಥಾವಾದೆ, ಬಂಗಾತನ ಥಾವಾದೆ, ರ‍್ಹತುಜ಼ ನೈ. ತುಮೊನೊ ಸಂಪೂರ್ಣ ಥೈನ ಮರಗಿನ ಆಯುಷ್ಯ ದಿದ್ಯೊ.<verse eid="EXO 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 23:27" />ತುಮೆ ಜಾ಼ವಾನಿ ಕ್ಹಾರಿ ಜ಼ಗಾವೊಮಾ ಮಿ ಮನಕ್ಹೊನಾ ಮನಸಮಾ ಬಚಕ ಉಂಟ ಕರಿನ ತ್ಯುನೊನೆ ಕಳವಳ ಕರಿನ, ತುಮಾರಾ ವಿರೊದಿಯೊ ಕ್ಹಾರಾ ನ್ಹಾಟಿನ ಜಾ಼ವಾನಿಂಗತಜ಼಼ ಕರುಸ. <verse eid="EXO 23:27" /><verse number="28" style="v" sid="EXO 23:28" />ತೆ ನೈಸೊ ಕಡಜನಾ ಕಿಡಾ ತುಮೊ ನೆ ಪೈಲಾಜ ವೈಳೈನ ಹಿವ್ವಿಯರೊ, ಕಾನಾನ್ಯರೊ, ಹಿತ್ತಿಯರೊ, ತುಮಾರಾ ಕ್ಹಾಮಾ ಹುಬ್ರೆವಾಚಿ ತೆ ತ್ಯುನೊನೆ ನ್ಹಟಾಡಿ ಪಡುಕೈನ ಕರುಸ. <verse eid="EXO 23:28" /><verse number="29" style="v" sid="EXO 23:29" />ತೆ ಥಯಲ್ಪರ ಮಿ ಯಕ್ಕಜ ವರಕ್ಹಮಾ ತ್ಯುನೊನೆ ಕ್ಹಾರವೊನೆ ತ್ಯಾಂತೊ ಮೊಕಲ್ತೊ ನೈ.ಕಾ ಕದ್ಯಾಮ ದೆಶಮ ಮನಕ್ಹೊ ಕಮ್ಮ ಥಯಲಕ್ಹು ಜಂಗಲನ್ಞೊ ಪ್ರಾಣಿಯೊ ಹೆಚ್ಕಿ ಥೈನ ತುಮೊನೆ ತರಾಸ ಥಯೂಸತೊ. <verse eid="EXO 23:29" /><verse number="30" style="v" sid="EXO 23:30" />ತುಮೆ ಅಬಿವೃದ್ದಿ ಥೈನ ದೆಶಕ್ಹಾರು ಭರೆಲಕ್ಕಾ ತ್ಯುನೊನೆ ದಕ್ಹಾ ದಕ್ಹಾಥೈನ ಮೊಕ್ಲುಸ. <verse eid="EXO 23:30" /><verse number="31" style="v" sid="EXO 23:31" />ಲಾಲ ಸಮಂದರಕ್ಹು ಪಿಲಿಸ್ಟಿನಾ ದೆಶನಾ ನಜಿಕ ರ‍್ಹವಾನು ಸಮಂದರ ಲಕ್ಕಾ ವರಿ ಆ ಜಂಗಲಕ್ಹು ಯೂಪ್ರಿಟಿಸ ಮಹಾ ನದಿಲಕ್ಕಾ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ದೆಶೊನೆ ತುಮಾರಾಹುತಿ ನೆಮ್ಸಿನ ತಿಮಾ ರ‍್ಹವಾನಾ ನಿವಾಸಿಯೊನೆ. ತುಮೊನೆ ಅದಿನ ಪಡಸುಸ. ತುಮೆ ತ್ಯುನೊನೆ ಮೊಕ್ಲಾವೊ. <verse eid="EXO 23:31" /><verse number="32" style="v" sid="EXO 23:32" />ತುಮೆ ತ್ಯುನಾ ಕ್ಹಾತೆ ತ್ಯುನಾ ದೆವತಿಯೊನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ ಕಯುಜ಼ ಬಿಜು಼ ಥಯಲ ಒಡಂಬಡಿಕೆ ಕರಲ್ಯೂ ನೈ. <verse eid="EXO 23:32" /><verse number="33" style="v" sid="EXO 23:33" />ತ್ಯುನೆ ತುಮಾರಾ ದೆಶಮಾ ರ‍ಹೆಲ ರ‍್ಹೌ ನೈ. ರ‍್ಹಯಾಮ ಮನೆ ವಿರುದ್ದ ಥೈನ ತುಮೆ ಪಾಪ ಕರೆವಾಚಿ ತ್ಯುನೆ ಪ್ರೆರಸಸ. ತುಮೆ ತ್ಯುನಾ ದೆವತಿಯೊನೆ ಪೂಜಾ ಕರ‍್ಯಾಮ ತೆ ಪೂಜಾ ತುಮೆ ಉರುಲ ಥಾವಸ.<verse eid="EXO 23:33" /></para>
  <chapter eid="EXO 23" />
  <chapter number="24" style="c" sid="EXO 24" />
  <para style="s">ಒಡಂಬಡಿಕೆನೆ ಲಿಕ್ಕಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1" />ಯಹೊವಾ ಮೊಶೆನೆ, " ತು, ಆರೊನ, ನಾದಾಬ್, ಅಬಿಹು ವರಿ ಮ್ಹೊಟಾವೊಮಾ ಸತ್ತರ ಜ಼ನಾ ಮನಕ್ಹೊ ಆ ಡೊಂಗರ ಚಡಿನ ಯಹೊವಾಕನ ಐನ ದುರ ಹುಬ್ರೈನ ಅಡ್ಡ ಪಡಿನ ಆರಾಧನಾ ಕರು. <verse eid="EXO 24:1" /><verse number="2" style="v" sid="EXO 24:2" />ಮೊಶೆ ಯಕ್ಲೊಜ ಯಹೊವಾಕನ ಔ ನೈತೊ ಬಿಜೊ಼ ಕುನಬಿ ನಜಿಕ ಔ ನೈ.ಉಗ್ರಲ ಮನಕ್ಹೊ ಡೊಂಗರ ಚಡುಜ ನೈ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 24:2" /><verse number="3" style="v" sid="EXO 24:3" />ಮೊಶೆ ಮನಕ್ಹೊಕನ ಐನ ಯಹೊವಾನಾ ಕ್ಹಾರಾ ವಾತೊನೆ ವರಿ ಆಜ್ಞಾವಿದಿಯೊನೆ ತಿಳಸಾನೆ ಮನಕ್ಹೊ ಕ್ಹಾರಾ, "ಯಹೊವಾನಾ ವಾತೊನೆ ಕ್ಹಾರಾ ಅನುಸರಸಿನ ಚಾಲಿಯೆಸ” ಕೈನ ಒಕ್ಕೊರಿಕ್ಹು ಉತ್ತರ ದಿದ್ಯೊ. <verse eid="EXO 24:3" /><verse number="4" style="v" sid="EXO 24:4" />ಮೊಶೆ ಯಹೊವಾನಾ ಆಜ್ಞಾವೊನೆ ಲಿಕ್ಕಿನ ಪಾಟೆ ಉಟಿನ ತೆ ಡಪಮಗರನಾ ಹೆಟಾ ಯಜ್ಞವೆದಿ ಬಾಧಿನ ಇಸ್ರಾಯೆಲೊನಾ ಬಾರಾ ಕುಲೊನೆ ಬಾರಾ ದಗ್ಡಾನಾ ಕ್ಹಂಬಾ ಭಂದೈನ ಇಸ್ರಾಯೆಲೊನಾ ಜಾಂಜಿಮಾನೊನೆ.<verse eid="EXO 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 24:5" />ತುಮೆ ಯಹೊವಾನಾಹುತಿ ಸರ್ವಾಂಗ ಬಹೊಮ ಕರಿನ ಸಮಾದನನಾ ಯಜ್ಞನಾಹುತಿ ಬೈಲೊನೆ ಬಲಿ ದ್ಯೂ ಕೈನ ಅಪ್ಪಣ್ಣೆ ದಿದ್ಯೊ.<verse eid="EXO 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 24:6" />ಪಾಚಾತೊ ಮೊಶೆ ತೆ ರಗತಮಾ ಅರ್ದು ಕಾಡಿಲಿನ ಕುಂಡಾವೊಮಾ ಭರಿನ ಅರ್ದು ಯಜ್ಞವೆದಿಪರ ಮ್ಹೆಲ್ಯೊ. ವರಿ ತೆ ರಗತ ತಿಪರ ಚಿಪಡ್ಯೊ. <verse eid="EXO 24:6" /><verse number="7" style="v" sid="EXO 24:7" />ತೆ ತಯಲ್ಪರ ನಿಬಂದ ಗ್ರಂಥನೆ ಕಾಡಿಲಿನ ಮನಕ್ಹೊನೆ ಐಕು ಆವಾ ವರಕ್ಹು ಓದ್ಯೊ.ತೆ ಐಕಿನ ಯಹೊವಾನಾ ಆಜ್ಞಾನಾ ಕ್ಹಾರಾ ಹಮೆ ಪಾಲ್ಸಿನ ವಿದೆಯೆ ಥಯೆಸ ಕದ್ಯಾ. <verse eid="EXO 24:7" /><verse number="8" style="v" sid="EXO 24:8" />ತೆಳಾಮಾ ಮೊಶೆ ತೆ ರಗತ ಕಾಡಿಲಿನ ಮನಕ್ಹೊನಾ ಉಪ್ಪರ ಚುಪಡಿನ ಹಮ್ನಾ ತೆ ಗ್ರಂಥಮಾ ಕದಲ ಕ್ಹಾರು ಆಜ್ಞಾನಾ ಪ್ರಕಾರ ಯಹೊವಾ ತುಮಾರಾ ಕ್ಹಾತೆ ಕರಲಿದಲ ಒಡಂಬಡಿಕೆನೆ ಗಟ್ಟ ಕರಾನು ರಗತ ಆಜ ವ್ಹೈ. <verse eid="EXO 24:8" /><verse number="9" style="v" sid="EXO 24:9" />ಮೊಶೆ ಆರೊನ್ ನಾದಾಬ್ ಅಬಿಹು ಕವಾನಾ ಇಸ್ರಾಯಲನಾ ಮ್ಹೊಟಾವೊಮಾ ಸತ್ತರ ಜ಼ನಾ ಮನಕ್ಹೊ ಡೊಂಗರನೆ ಚಡ್ಯಾ; <verse eid="EXO 24:9" /><verse number="10" style="v" sid="EXO 24:10" />ತ್ಯುನೊನೆ ಇಸ್ರಾಯೆಲೊನಾ ಕ್ಹುದಾನೆ ದೆಕ್ಯಾ.ಇಂದ್ರ ನಿಲಮಣಿನಾ ಜಿಮಿನಾ ತಿನಾ ಪಾದಪಿಟ ಥಯುತು. <verse eid="EXO 24:10" /><verse number="11" style="v" sid="EXO 24:11" />ತೆ ಇಸ್ರಾಯಲನಾ ತೆ ಮುಕಂಡೊನೆ ಕಯುಜ಼ ಕೆಟ್ಟ ಕರ್ಯೊ ನೈ; ತ್ಯುನೆ ಕ್ಹುದಾನೆ ದೆಕಿನ ಕ್ಹಾವಾ ಪಿವಾನು ಲಿದ್ಯಾ.<verse eid="EXO 24:11" /></para>
  <para style="s">ಮೊಶೆ ಸಿನಾಯ ಡೊಂಗರ ಚಡ್ಯಲ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12" />ಯಹೊವಾ ಮೊಶೆನೆ ತು ಡೊಂಗರ ಚಡಿನ ಐನ ಮಾರಾ ಬಾಜು಼ಮಾಜ ರ‍್ಹೆ; ತು ತೆ ಧರ್ಮೊನಾ ಶಾಸ್ತ್ರೊನೆ ಆಜ್ಞಾವೊನೆ ಮನಕ್ಹೊನೆ ಕೌ ಕೈನ ಮಿ ತೆ ತಿನೆ ಬರದಲ ಶಿಲಾಶಾಸನೊನೆ ತುನೆ ದ್ಯುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 24:12" /><verse number="13" style="v" sid="EXO 24:13" />ಮೊಶೆ ತಿನೊ ಶಿಶ್ಯೊ ಥಯಲ ಯೆಹುಶುವಾನಾ ಕ್ಹಾತೆ ಉಟಿನ ಕ್ಹುದಾನಾ ಡೊಂಗರನಾ ಉಪ್ಪರ ಗಯೊ. <verse eid="EXO 24:13" /><verse number="14" style="v" sid="EXO 24:14" />ಅನೆ ಪೈಲಾ ತೆ ಮ್ಹೊಟಾವೊನೆ "ಮಿ ಫರಿನ ತುಮೊಕನ ಆಯೆಲಕ್ಕಾ ತುಮೆ ಯ್ಹಾಜ ಕಾಯ್ದೊ. ಆರೊನ ವರಿ ಹುರನ ತುಮೊಕನ ರ‍್ಹವಸ. ಕಿನೆಬಿ ವ್ಯಾಜ್ಜನಾ ಪಕ್ಷನೆ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಜಾ಼ವಾದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 24:14" /><verse number="15" style="v" sid="EXO 24:15" />ಮೊಶೆ ಡೊಂಗರ ಚಡ್ಯೊ. ವರಿ ಹಬಾಳನೂ ಮ್ಹಾಡ ಡೊಂಗರನೆ ಝಾಕಿಲಿದ್ಯುತು. <verse eid="EXO 24:15" /><verse number="16" style="v" sid="EXO 24:16" />ಯಹೊವಾನು ಉಜಾಳು ಸಿನಾಯ ಡೊಂಗರನಾ ಉಪ್ಪರ ವ್ಹತ್ತು ವರಿ ತೆ ಹಬಾಳನೂ ಮ್ಹಾಡ ಛೆ ದಿನ್ನ ಲಕ್ಕಾ ಡೊಂಗರನೆ ಝಾಕಿಲಿದ್ಯುತು. ಕ್ಹಾತವಾ ದಿನ್ನಮಾ ಯಹೊವಾ ಹಬಾಳನಾ ಮ್ಹಾಡಮಾತೊ ಮೊಶೆನೆ ವದ್ರಿನ ಬಲಾಯೊ. <verse eid="EXO 24:16" /><verse number="17" style="v" sid="EXO 24:17" />ಯಹೊವಾನೂ ಉಜಾಳು ಡೊಂಗರನಾ ತುದಿಮಾ ಲಾಗಾನಿ ಆಗ ನಿಂಗತ ಇಸ್ರಾಯೆಲೊನೆ ದಿಕ್ಹ್ಯು. <verse eid="EXO 24:17" /><verse number="18" style="v" sid="EXO 24:18" />ಮೊಶೆ ತೆ ಹಬಾಳನಾ ಮ್ಹಾಡಮಾ ಗೈನ ಡೊಂಗರ ಚಡ್ಯೊ. ತೆ ತೆ ಡೊಂಗರಪರ ಚಾಳಕ್ಹ ದಿನ ದಿನ್ನ ರಾತ ತೆ ಡೊಂಗರಪರಜ ವ್ಹತ್ತೊ.<verse eid="EXO 24:18" /></para>
  <chapter eid="EXO 24" />
  <chapter number="25" style="c" sid="EXO 25" />
  <para style="s">ಯಹೊವಾನಿ ಸನ್ನಿದಿ ಗುಡಾರನಿ ಕಾಣಕಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1" />ಯಹೊವಾ ಮೊಶೆನೆ ಕದಲ ಸುವೈ ಕದ್ಯಾರೆ, <verse eid="EXO 25:1" /><verse number="2" style="v" sid="EXO 25:2" />ಇಸ್ರಾಯೆಲೊ ಮಾರಾಹುತಿ ಕಾಣಿಕೆ ಲಿನ ಔ ಕೈನ ತ್ಯುನೊನೆ ಕೆ. ಮನಸೆ ದಿವಾಹುತಿ ತೆ ಕಾಣಿಕೆ ಕಾಡಿಲ್ಯೂ <verse eid="EXO 25:2" /><verse number="3" style="v" sid="EXO 25:3" />ತು ತ್ಯುನಾಕ್ಹು ಕಾಡಿಲಿವಾನಾ ಕಾಣಿಕಿ ಕೈ ವೈ ಕದ್ಯಾಮ ಕ್ಹೊನೂ ರುಪ್ಪೂ ತಾಂಬು ಕವಾನಾ ಲ್ಹೊಡಾವೊ ನಿಲಿ ಧುಮ್ರನಾ ರಗತನಾ ವರ್ಣಮಾನಾ ದೊರಾವೊ ಚೊ <verse eid="EXO 25:3" /><verse number="4" style="v" sid="EXO 25:4" />ನಿಲಿ ದುಮ್ರ ರಗತ ವರ್ಣ ರ‍್ಹಯಲ ದೊರಾ ರೆಶ್ಮಿನಾ ವಣ್ಣಾ ಬಕ್ರಾನಾ ಬಾಲೊನಾ ವಣ್ಣಾ <verse eid="EXO 25:4" /><verse number="5" style="v" sid="EXO 25:5" />ಹದನ ಕರಲ ಲಾಲ ರಂಗನಾ ಬಕ್ರಾನಾ ಬಾಲೊ ಕಡಲ ಡುಕ್ಕುನಾ ಚಮ್ಡು ಜಾಲಿನು ಝಾಡ <verse eid="EXO 25:5" /><verse number="6" style="v" sid="EXO 25:6" />ದಿವ್ವಾನೆ ಚಾಯೆ ಥಯಲ ತೆಲ ಅಭಿಷೆಕನಾ ತೆಲನೆ ವರಿ ಬಾಸನಾ ಉದನೆ ಛಾಯೆ ಥಯಲ ಚೊಕಿ ಬಾಸನಾ ಅತ್ತರ <verse eid="EXO 25:6" /><verse number="7" style="v" sid="EXO 25:7" />ಮಹಾಯಾಜಕ ಕವಚನೆ ಚಾಯೆ ಥಯಲ ಗೊಮೆದಕ ರತ್ನ ಪದಕನಾ ಕೈಚಿಲಾಮಾ ಕೆತ್ತಾನಾ ಬಿಜಾ ಬಿಜಾ ರತ್ನ ಛೆ. <verse eid="EXO 25:7" /><verse number="8" style="v" sid="EXO 25:8" />ಮಿ ತ್ಯುನಾ ವಚ್ಮಾ ರ‍್ಹವಾನಾಹುತಿ ಮನೆ ಯಕ್ಕ ಗುಡಾರ ಭಾಂದು. <verse eid="EXO 25:8" /><verse number="9" style="v" sid="EXO 25:9" />ಮಿ ತ್ಯುನೆ ದೆಕ್ಲಾಡಾನಾ ಮಾದರಿನಾ ತಿನಾ ನಿಂಗತಜ಼಼ ಗುಡಾರನೆ ತಿಮಾ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ಸಮಾನ್ನೊನೆ ಕರೌ.<verse eid="EXO 25:9" /></para>
  <para style="s">ಒಡಂಬಡಿಕೆನಿ ಪಟ್ಟಗಿ</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10" />ತು ಕಾಟಾನ ಝಾಡಕ್ಹು ಯಕ್ಕ ಮಂಜುಷನೆ ಕರೌ.ತೆ ಅಡಿ ಮಾರ ಲಾಂಬು ದೆಡ ಮಾರ ರುಂದ ದೆಡಮಾರ ಉಚ್ಚು ಥಯಲ ರ್ಹೌ. <verse eid="EXO 25:10" /><verse number="11" style="v" sid="EXO 25:11" />ಚೊಕಾ ಕ್ಹೊನಾನಾ ತಗಡೊ ತಿನಾ ಭಾರಾಬಿ ಮ್ಹೈಬಿ ಲಗಾಡು. ತೆನಾ ಉಪ್ಪರ ವರಿ ತಿನಾ ಸುತ್ತೆಬಿ ಕ್ಹೊನಾನಿ ಪಟ್ಟಿಯೊ ಲಗಾಡು. <verse eid="EXO 25:11" /><verse number="12" style="v" sid="EXO 25:12" />ಚಾರ ಕ್ಹೊನಾನಾ ಬಾಂಗ್ಡಿಯೊನೆ ಧವೈನ ತಿನಾ ಚಾರೆ ಮೂಲಾವೊಮಾ ಕದ್ಯಾಮ ಯಕ್ಕಯಕ್ಕ ಜ಼ಗಾವೊಕನ ಬೆಬೆ ಬಾಂಗ್ಡಿಯೊನೆ ಮ್ಹೆಲು <verse eid="EXO 25:12" /><verse number="13" style="v" sid="EXO 25:13" />ತೆ ಮಂಜುಷನೆ ಉಚಾವಾನಾಹುತಿ ತು ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಲಾಕ್ಡಿಯೊ ಕರೈನ ತಿನೆ ಕ್ಹೊನಾನಾ ತಗಡೊ ಲಗಾಡಿನ <verse eid="EXO 25:13" /><verse number="14" style="v" sid="EXO 25:14" />ವರಿ ಮಂಜುಷನಾ ಭಂಬೆ ಜಾ಼ಗಾವೊನಾ ಬಾಂಗ್ಡಿಯೊಮಾ ಸೆರಸು. <verse eid="EXO 25:14" /><verse number="15" style="v" sid="EXO 25:15" />ತೆ ಲಾಕ್ಡಿಯೊನೆ ಮಂಜುಷನಾ ಬಾಂಗ್ಡಿಯೊಮಾತಾ ಕಾಡೆವಾಚಿ ತಿಮಾಜ ಮ್ಹೆಲೆಲ ರ‍್ಹೌ <verse eid="EXO 25:15" /><verse number="16" style="v" sid="EXO 25:16" />ತೆ ಮಂಜುಷಮಾ ಮಿ ತ್ಯುನೆ ದಿವಾನಾ ಆಜ್ಞಾಶಾಸನೆ ಮ್ಹೆಲು. <verse eid="EXO 25:16" /><verse number="17" style="v" sid="EXO 25:17" />ತೆನೈಸೊ ಚೊಕಾ ಕ್ಹೊನಾನಾ ಝಾಕಾನ ಕೃಪಾಸನನೆ ಕರೌ. ತೆ ಅಡಿ ಮಾರ ಲಾಂಬು ದೆಡ ಮಾರ ರುಂದ ಥಯಲ ರ‍್ಹೌ. <verse eid="EXO 25:17" /><verse number="18" style="v" sid="EXO 25:18" />ಕೃಪಾಸನನಾ ಬೆ ಮುಲಾವೊಮಾ ಕೆರುಬಿನಾ ಬೆ ಕ್ಹೊನಾನಾ ಆಕಾರೊನೆ ನಕ್ಷಾನಾ ಕಾಮಕ್ಹು ಕರೌ. <verse eid="EXO 25:18" /><verse number="19" style="v" sid="EXO 25:19" />ಕೃಪಾಸನೆ ಯಕ್ಕಯಕ್ಕ ಕೊನಾಮಾ ಯಕ್ಕಯಕ್ಕ ಕೆರುಬಿಯೊನೆ ಕರೈನ ಕೃಪಾಸನೆ ಜೊಡಸು. <verse eid="EXO 25:19" /><verse number="20" style="v" sid="EXO 25:20" />ತೆ ಕೆರುಬಿನಾ ಉಪ್ಪರ ರೆಕ್ಯಾವೊನೆ ಫೈಲಾಯಾ ನಿಂಗತ ಕೃಪಾಸನ ತಿನಾ ರೆಕ್ಯಾವೊಕ್ಹು ಝಾಕಿಲಿವಾ ವರಕ್ಹು ರ‍್ಹೌ. ತಿನಾ ಮ್ಹೊಡಾವೊ ಆಮನಾ ಸಾಮನಾ ಥೈನ ಕೃಪಾಸನೆ ದೆಕ್ತಾ ರ‍್ಹೌ. <verse eid="EXO 25:20" /><verse number="21" style="v" sid="EXO 25:21" />ತೆ ಕೃಪಾಸನೆ ಮಂಜುಶನಾ ಉಪ್ಪರ ಮ್ಹೆಲು. ಮಿ ತ್ಯುನೆ ದಿವಾನಾ ಆಜ್ಞಾನಾ ಶಾಸನೊನೆ ತೆ ಮಂಜುಷನಾ ಮ್ಹೈ ಮ್ಹೆಲು. <verse eid="EXO 25:21" /><verse number="22" style="v" sid="EXO 25:22" />ತ್ಯಾ ಮಿ ತುನೆ ದರ್ಶನ ದ್ಯುಸ. ಕೃಪಾಸನಾ ಉಪ್ಪರ ಆಜ್ಞಾನಾ ಶಾಸನೊನೆ ಮ್ಹೆಲಲ ಮಂಜುಷನಾ ಉಪ್ಪರ ಬೆ ಕೆರುಬಿಯೊನಾ ವಚ್ಮಾ ಮಿ ರ‍್ಹೈನ ತಾರಾ ಕ್ಹಾತೆ ಬೊಲಿನ ತು ಇಸ್ರಾಯೆಲೊನೆ ಆಜ್ಞಾಕರಾನಾ ಚಾ಼ಯೆ ಥಯಲ ಕ್ಹಾರಾ ಸಂಗತಿಯೊನೆ ತಿಳಸುಸ. <verse eid="EXO 25:22" /><verse number="23" style="v" sid="EXO 25:23" />"ತು ಕಾಟಾನಾ ಝಾಡಕ್ಹು ಯಕ್ಕ ಮೆಜ ಕರೌ. ತೆ ಬೆಮಾರ ಲಾಂಬು ಥೈನಬಿ, ಯಕ್ಕ ಮಾರ ರುಂದ ಥೈನಬಿ, ದೆಡಮಾರ ಉಚ್ಚು ಥೈನಬಿ ರ‍್ಹೌ. <verse eid="EXO 25:23" /><verse number="24" style="v" sid="EXO 25:24" />ತಿನೆ ಚೊಕು ಕ್ಹೊನೂ ತಗಡೊ ಮಾರಿನ, ಸುತ್ತೆಬಿ ಕ್ಹೊನಾನಾ ತೊರಣ ಭಂದೌ. <verse eid="EXO 25:24" /><verse number="25" style="v" sid="EXO 25:25" />ಮೆಜನಾ ಸುತ್ತೆಬಿ ಅಂಗೈ ರುಂದನಾ ಅಡ್ಡ ಪಟ್ಟಿ ಕರೈನ ತಿನೆ ಕ್ಹೊನಾನೂ ತೊರಣ ಭಾಂದು. <verse eid="EXO 25:25" /><verse number="26" style="v" sid="EXO 25:26" />ಚಾರ ಕ್ಹೊನಾನಿಯೊ ಬಾಂಗ್ಡಿಯೊ ಕರೈನ ಚಾರೆ ಪಗೊನೆಬಿ ಘಾಲು.<verse eid="EXO 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 25:27" />ತೆ ಬಾಂಗ್ಡಿಯೊ ಅಡ್ಡ ಪಟ್ಟಿನೆಬಿ ಅಂಟಿ ಲಿದಲ ರ‍್ಹೌ. ಮೆಜನೆ ಉಚಾವಾನಾಹುತಿ ಲಾಕಡಿಯೊನೆ ತಿಮಾ ಸೆರಸು. <verse eid="EXO 25:27" /><verse number="28" style="v" sid="EXO 25:28" />ತೆ ಲಾಕಡಿಯೊ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಕರೈನ ತಿನೆ ಕ್ಹೊನಾನಾ ತಗಡೊ ಘಾಲು. ತಿನಾಕ್ಹು ಮೆಜನೆ ಉಚೌ. <verse eid="EXO 25:28" /><verse number="29" style="v" sid="EXO 25:29" />ಮೆಜನಾ ಉಪ್ಪರ ಮ್ಹೆಲಾನಾ ಹರಿವಾಣೊ, ಧೂಪಾರತಿಯೊ, ಹುಜಿಯೊ, ಪಾನನಾ ದ್ರವ್ಯಯೊ ಎಡಿ ಕರಾನೆ ಚಾ಼ಯೆ ಥಯಲ ಕುಂಡಾವೊ ಚೊಕಾ ಕ್ಹೊನಾಕ್ಹು ಕರೌ. <verse eid="EXO 25:29" /><verse number="30" style="v" sid="EXO 25:30" />ಪರಿಶುದ್ದ ರೊಕ್ಲಾವೊ ಹರದಿನ್ನೆ ತೆ ಮೆಜನಾ ಉಪ್ಪರ ಮಾರಾ ಸಮ್ಮುಕಮಾಜ ಮ್ಹೆಲಲ ರ‍್ಹೌ.<verse eid="EXO 25:30" /></para>
  <para style="s">ದಿಪಸ್ತಂಬ</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31" />ಚೊಕಾ ಕ್ಹೊನಾನಾ ದಿವಾನಾ ಖಂಬಾವೊನೆ ಕರೌ. ತಿನಾ ಹೆಟಲ್ಯಾ ಭಾಗಮಾ ಕಂಬಾವೊನೆ ನಕ್ಷಾನಾ ಕಾಮಕ್ಹು ಕರೌ. ತೆ ದಿವಾನಾ ಬುಡತುಜ಼ ಅಖಂಡ ಥೈನ ಫುಲ್ಲನೊ ಗೊಂಚಲೊ,ಅರಳೆಲ ಫುಲ್ಲೊ ಮೊಗ್ಗವೊ ಅಲಂಕಾರ ಥೈನ ಕೆತ್ತು. <verse eid="EXO 25:31" /><verse number="32" style="v" sid="EXO 25:32" />ಕ್ಹಂಬಾನಾ ಯಕ್ಕ ಯಕ್ಕ ಪಾರ್ಶ್ವಮಾ ತನ್ನ ತನ್ನ ಸಿಂಗ್ಡಾ ನಿಂಗತಜ಼಼ ಛೆ ಸಿಂಗ್ಡಾವೊ ರ‍್ಹೌ. <verse eid="EXO 25:32" /><verse number="33" style="v" sid="EXO 25:33" />ಹರಿಯಕ್ಕ ಟೊಂಗಿಯೊಮಾ ಬಾದಾಮಾನಾ ಫುಲ್ಲೊ ನಿಂಗತ ರ‍್ಹವಾನಾ ತನ್ನ ತನ್ನ ಫುಲ್ಲೊ ಮೊಗ್ಗವೊ ರ‍್ಹೌ. ದಿವಾನಾ ಕ್ಹಂಬಾಕ್ಹು ಆವಾನಾ ತೆ ಟೊಂಗಿಯೊನೆ ತಿಮ್ಮಜ಼ ಕರೌ. <verse eid="EXO 25:33" /><verse number="34" style="v" sid="EXO 25:34" />ದಿವಾನಾ ಸ್ತಂಭನಾ ಕ್ಹಂಬಾಮಾ ಫುಲ್ಲೊನೊ ಗೋಂಚಲೊ, ಫುಲ್ಲೊ, ಮಗ್ಗಿಯೊ ರ‍್ಹವಾನಾ ಬಾದಾಮನಾ ಫುಲ್ಲೊ ನಿಂಗತ ಚಾರ ಫುಲ್ಲೊನಾ ಅಲಂಕಾರೊ ರ‍್ಹೌ. <verse eid="EXO 25:34" /><verse number="35" style="v" sid="EXO 25:35" />ಬೆ ಬೆ ಟೊಂಗಿಯೊ ಕವಲ ಫುಟಲ ಜ಼ಗಾವೊಮಾ ಕ್ಹಾರಾ ಯಕ್ಕ ಯಕ್ಕ ಮೊಗ್ಗ ರ‍್ಹೌ. <verse eid="EXO 25:35" /><verse number="36" style="v" sid="EXO 25:36" />ಫುಲ್ಲೊನಾ ಸಾಮನೊ, ಸಿಂಗ್ಡಾಯೊ ರ‍್ಹೈತಬಿ ದಿಪ ಸ್ತಂಬೊಕ್ಹಾರಾ ಕ್ಹಾತೆಜ಼ ಚೊಕಾ ಕ್ಹೊನಾಕ್ಹು ಕೆತ್ತಾನಾ ಕಾಮಕ್ಹು ಕರೌ. <verse eid="EXO 25:36" /><verse number="37" style="v" sid="EXO 25:37" />ತಿನೆ ಕ್ಹಾತ ಹಣೆತೆಯೊ ಕರೌ. ತೆ ಹಣೆತೆನಾ ಉಜಾಳು ಕ್ಹಾಮಾತು ಪಡು ಕೈನ ತಿನೆ ಲಗಾಡಲ ರ‍್ಹೌ. <verse eid="EXO 25:37" /><verse number="38" style="v" sid="EXO 25:38" />ದಿಪನಾ ಪಿನಕಾಡಾನು ಕಾತರೊ, ಕಟ್ಟ ಕರಲ ಕುಡಿಯೊನೆ ಘಾಲಾನಾ ಕುಂಡಾವೊನೆ ಚೊಕಾ ಕ್ಹೊನಕ್ಹುಜ ಕರೌ. <verse eid="EXO 25:38" /><verse number="39" style="v" sid="EXO 25:39" />ದಿಪಸ್ತಂಬೊ ತಿನಾ ಕ್ಹಾರಾ ಉಪಕರಣೊ ಮುವ್ವತ್ತ ಕಿಲೊ ಚೊಕಾ ಕ್ಹೊನು ಥಯಲ ರ‍್ಹೌ. <verse eid="EXO 25:39" /><verse number="40" style="v" sid="EXO 25:40" />ದೆಕ, ಡೊಂಗರಪರ ಮಿ ತುನೆ ದೆಕ್ಲಾಡಲ ಮಾದರಿಮಾ ಕ್ಹಾರುಜ಼ ಎಚ್ಚರಿಕೆಕ್ಹು ಕರೌ.”<verse eid="EXO 25:40" /></para>
  <chapter eid="EXO 25" />
  <chapter number="26" style="c" sid="EXO 26" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1" />ಮಾರಾ ನಿವಾಸನಾ ಹುತಿ ಯಕ್ಕ ಗುಡಾರನೆ ದಕ್ಹ ಪಡದಾವೊಕ್ಹು ಕರೌ. ತೆ ನಯಥೈನ ಚೊಕಾ ನವಾ ವಣ್ಣಾ ಥಯಲ ರ‍್ಹೌ. ತಿಮಾ ನಿಲಿ , ಜಾ಼ಂಬ್ಳಾನೊ ವರಿ ನಕ್ಕರ ಲಾಲ ವರ್ಣನೊನಾ ದೊರಾಕ್ಹು ಕೆರುಬಿಯೊನೆ ನೆಯ್ಗೆಕ್ಹು ಕಸೂತಿ ಘಲವು. <verse eid="EXO 26:1" /><verse number="2" style="v" sid="EXO 26:2" />ಹರಿಯಕ್ಕ ಫಡ್ಕುಬಿ ಇಕ್ಹಪರಾಟ ಮಾರ ಲಾಂಬುಬಿ ಚಾರ ಮಾರ ರುಂದಬಿ ರ‍್ಹೌ.ಕ್ಹಾರಾ ಪಡದಾವೊ ನಿ ಯಕ್ಕಜ ಅಳತಿ ಥಯಲ ರ‍್ಹೌ <verse eid="EXO 26:2" /><verse number="3" style="v" sid="EXO 26:3" />ಪಾಂಚ ಪಾಂಚ ವಣ್ಣಾವೊನೆ ಯಕ್ಕ ಯಕ್ಕನೆ ಘಡಿಕರು; <verse eid="EXO 26:3" /><verse number="4" style="v" sid="EXO 26:4" />ಆ ಬೆಂಬಿ ಜೊಡಿಮಾ ಯಕ್ಕ ಯಕ್ಕನೆ ಲಾಸ್ಟ ವಣ್ಣಾನಾ ತುದಿಮಾ ನಿಲಿ ದೊರಾಕ್ಹು ಗ್ಹೊಂಡಾ ಕರೌ. <verse eid="EXO 26:4" /><verse number="5" style="v" sid="EXO 26:5" />ತೆ ಗ್ಹೊಂಡಾವೊ ಐವತ್ತತಿಬಿ ಹೆಚ್ಚ ಯಕ್ಕನೆ ಯಕ್ಕ ಕ್ಹಾಮಾಜ ರ್ಹೌ. <verse eid="EXO 26:5" /><verse number="6" style="v" sid="EXO 26:6" />ತೆ ನೈಸೊ ಐವತ್ತ ಕ್ಹೊನಾನಾ ಕೊಂಡಿಯೊ ಕರೈನ ತೆ ವಣ್ಣಾವೊನೆ ಯಕ್ಕನೆ ಯಕ್ಕ ಜಮಾಕರು; ಅಮ್ಮ ಯಕ್ಕಜ ಝೊಪಡು ಥಾವಸ. <verse eid="EXO 26:6" /><verse number="7" style="v" sid="EXO 26:7" />ತೆ ಝೊಪಡಾನಾ ಉಪ್ಪರ ಝಾಕಾನಾಹುತಿ ಬಕ್ರಾನಾ ಬಾಲೊಕ್ಹು ಗ್ಯಾರಾ ತೆ ವಣ್ಣಾವೊನೆ ಕರೌ. <verse eid="EXO 26:7" /><verse number="8" style="v" sid="EXO 26:8" />ಯಕ್ಕ ಯಕ್ಕ ವಣ್ಣಾಬಿ ಮೂವತ್ತ ಮಾರ ಲಾಂಬು ಥೈನಬಿ ಚಾರ ಮಾರ ರುಂದ ಥೈನಬಿ ರ‍್ಹೌ. ಕ್ಹಾರಾ ವಣ್ಣಾವೊ ಯಕ್ಕಜ ಅಳತಿನಾ ಥಯಲ ರ‍್ಹೌ. <verse eid="EXO 26:8" /><verse number="9" style="v" sid="EXO 26:9" />ಪಾಂಚ ವಣ್ಣಾವೊನೆ ಯಕ್ಕ ಥೈನ ಜೊಡಸಿನ ಉಗ್ರಲ ಛೆ ವಣ್ಣಾವೊನೆ ಯಕ್ಕಜ ಥೈನ ಜೊಡಸಿನ ವಣ್ಣಾವೊನೆ ಝೊಪಾಡಾನಾ ಕ್ಹಾಮಲ್ಯಾ ಭಾಗಮಾ ಮಡಸಿನ ಘಾಲು. <verse eid="EXO 26:9" /><verse number="10" style="v" sid="EXO 26:10" />ಅಮ್ಮ ಜೊಡಸಿನ ಸಿಯಲ ವಣ್ಣಾವೊನೆ ಲಾಸ್ಟಮಾ ಐವತ್ತ ಐವತ್ತ ಗ್ಹೊಂಡಾವೊನೆ ಕರ‍್ಹೌ. <verse eid="EXO 26:10" /><verse number="11" style="v" sid="EXO 26:11" />ತಾಂಬಾನಾ ಐವತ್ತ ಕೊಂಡಿಯೊ ಕರೈನ ಗ್ಹೊಂಡಾವೊಮಾ ಅಟ್ಕಾಡಿನ ಕ್ಹಾರುಜ಼ ಮಳಿನ ಯಕ್ಕಜ ಝೊಪಡೊ ಥಾವಾ ವರಕ್ಹು ಜೊಡಸುಸ. <verse eid="EXO 26:11" /><verse number="12" style="v" sid="EXO 26:12" />ಸಿಯೆಲ ವಣ್ಣಾವೊಮಾ ಅರ್ಧಾ ವಣ್ಣಾ ಹೆಚ್ಚ ಥಾವಸ, ತೆ ಹೆಚ್ಚನ ಭಾಗ ಝೊಪಡಾನಾ ಪಾಚಲ್ಯಾ ಭಾಗಮಾ ಕರಿನ ತುಗಾಡಾ ನಿಂಗತ ಛೊಡೂ. <verse eid="EXO 26:12" /><verse number="13" style="v" sid="EXO 26:13" />ಸಿಯಲ ವಣ್ಣಾವೊನಾ ಲಾಂಬಾಮಾ ತ್ಯಾ ಯಕ್ಕ ಮಾರಬಿ, ಯ್ಹಾ ಯಕ್ಕ ಮಾರ ಹೆಚ್ಚ ಥಾವಸ. ತೆ ಮ್ಹೈಬಿ ಝೊಪಡಾಮಾ ಝಾಕಾವರಕ್ಹು. ಯ್ಹಾಬಿ ತ್ಯಾಬಿ ತುಗಾಡು ವರಕ್ಹು ರ‍್ಹೌ. <verse eid="EXO 26:13" /><verse number="14" style="v" sid="EXO 26:14" />ಆ ಯಕ್ಕ ಹೊದಿಕೆನೆ ಸಿವಾನಾ ಹುತಿ ಹದಕರಲ ಲಾಲ ರಂಗನೂ ಟಗರನಾ ಚಾಮ್ಡಾಕ್ಹು ಯಕ್ಕ ಉಪ್ಪರಲಿ ಜ಼ಗಾ ಕಡಲಪ್ರಾಣಿನಾ ಚಾಮ್ಡಾಕ್ಹು ಹಜಿಯಕ್ಕ ಉಪ್ಪರಲಿ ಜ಼ಗಾ ಕರೌ. <verse eid="EXO 26:14" /><verse number="15" style="v" sid="EXO 26:15" />ಝೊಪ್ಡಾನೆ ಚಾ಼ಯೆಥಯಲ ಚೌಕಟೊನೆ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಕರೌ. <verse eid="EXO 26:15" /><verse number="16" style="v" sid="EXO 26:16" />ಹರಿಯಕ್ಕ ಚೌಕಟೊ ದಕ್ಹಮಾರ ಲಾಂಬಾಬಿ ವರಿ ದೆಡಮಾರ ರುಂದ ಥಯಲ ರ‍್ಹೌ. <verse eid="EXO 26:16" /><verse number="17" style="v" sid="EXO 26:17" />ಹರಯಕ್ಕ ಚೌಕಟ ಅಡ್ಡ ಪಟ್ಟಿಕ್ಹು ಜೊಡಸಲ ನಿಲುವು ಪಟ್ಟಿಯೊ ಥಯಲ ರ್ಹೌ. ಝೊಪ್ಡಾನಾ ಕ್ಹಾರಾ ಚೌಕಟೊನೆ ತಿಮ್ಮಜ಼ ಕರೌ. <verse eid="EXO 26:17" /><verse number="18" style="v" sid="EXO 26:18" />ಝೊಪ್ಡಾನಾ ದಕ್ಷಿಣ ದಿಕ್ಕಮಾ ಇಕ್ಹ ಚೌಕಟೊನೆ ಹುಬ್ರಾಡು. <verse eid="EXO 26:18" /><verse number="19" style="v" sid="EXO 26:19" />ಚಾಳಕ್ಹ ರುಪ್ಪಾನಾ ಗದಗಿನಾ ದಗ್ಡಾವೊನೆ ಕರೈನ ತೆ ಇಕ್ಹ ಚೌಕಟೊನಾ ಹೆಟಾ ಮ್ಹೆಲು.ಯಕ್ಕ ಯಕ್ಕ ಚೌಕಟಮಾ ರ‍್ಹವಾನು ಬೆ ಪಟ್ಟಿಯೊನೆ ಯಕ್ಕ ಯಕ್ಕ ಗದಿನೊ ದಗ್ಡೊ ರ‍್ಹೌ. <verse eid="EXO 26:19" /><verse number="20" style="v" sid="EXO 26:20" />ತಿಮ್ಮಜ಼ ಝೊಪ್ಡಾನಾ ಉತ್ತರ ದಿಕ್ಕಮಾಬಿ ಇಕ್ಹ ಚೌಕಟೊ ವರಿ ಹರಯಕ್ಕ ಚೌಕಟನೆ, <verse eid="EXO 26:20" /><verse number="21" style="v" sid="EXO 26:21" />ವರಿ ಹರಯಕ್ಕ ಚೌಕನೆ ಬೆಬೆ ರುಪ್ಪಾನಾ ಗದಗಿನಾ ದಗ್ಡಾ ರ‍್ಹೌ. <verse eid="EXO 26:21" /><verse number="22" style="v" sid="EXO 26:22" />ಝೊಪ್ಡಾನಾ ಪಾಚಲ್ಯಾ ಭಾಗಮಾ ಕದ್ಯಾಮ ಪಶ್ಚಿಮ ದಿಕ್ಕಮಾ ಛೆ ಚೌಕಟೊ ಕರೌ.<verse eid="EXO 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 26:23" />ಝೊಪ್ಡಾನಾ ಪಾಚಲ್ಯಾ ಬೆ ಮೂಲಾವೊನೆ ಬಿಜಾ಼ ಬೆ ಚೌಕಟೊನೆ ಕರೌ. <verse eid="EXO 26:23" /><verse number="24" style="v" sid="EXO 26:24" />ತೆ ಹೆಟಾತುಬಿ ತುದಿಲಕ್ಕಾ ಜೊಡಸಲ ರ‍್ಹೌ. ಉಪ್ಪರಲ್ಯಾ ಭಾಗಮಾ ಯಕ್ಕಜ ಬಾಂಗ್ಡಿನೆ ಜೊಡಸಲ ರ‍್ಹೌ. ತಿಮ್ಮಜ಼ ಬೆ ಮೂಲಾವೊನೆ ಕರೌ. <verse eid="EXO 26:24" /><verse number="25" style="v" sid="EXO 26:25" />ಚೌಕಟೊ ವರಿ ಹರಯಕ್ಕ ಚೌಕಟನೆ ರುಪ್ಪಾನಾ ಗದಗಿನಾ ದಗ್ಡಾವೊನೆ ತಿಮ್ಮಜ಼ ಕ್ಹೊಳಾ ಗದಗಿನಾ ದಗ್ಡಾವೊ ರ‍್ಹೌ. <verse eid="EXO 26:25" /><verse number="26" style="v" sid="EXO 26:26" />ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಅಗುಳಿಯೊನೆ ಕರೌ. ಝೊಪ್ಡಾನಾ ಭಂಬೆಜ಼ಗಾ ಚೌಕಟೊನೆ. <verse eid="EXO 26:26" /><verse number="27" style="v" sid="EXO 26:27" />ತಿನಾ ಪಾಚಾ ಕದ್ಯಾಮ ಪಶ್ಚಿಮಕನ ಚೌಕಟೊನೆ ಪಾಂಚ ಪಾಂಚ ಅಗುಳಿಯೊನೆ ಕರೌ. <verse eid="EXO 26:27" /><verse number="28" style="v" sid="EXO 26:28" />ಚೌಕಟೊನಾ ವಚ್ಮಾ ರ‍್ಹವಾನು ಅಗುಳಿನಾ ಯಕ್ಕ ಕೊನಾತೊ ವರಿಯಕ್ಕ ಕೊನಾಲಕ್ಕಾ ಲಾಗಾ ವರಕ್ಹು ರ‍್ಹೌ. <verse eid="EXO 26:28" /><verse number="29" style="v" sid="EXO 26:29" />ತೆ ಚೌಕಟೊನೆ ಕ್ಹೊನಾನಾ ತಗಡೊ ಲಗಾಡಿನ ತಿಮಾ ತೆ ಅಗುಳಿಯೊನಾ ಹುತಿ ಕ್ಹೊನಾನಾ ಬಾಂಗ್ಡಿಯೊ ಕರೌ. ತೆ ಅಗುಳಿಯೊನೆ ಕ್ಹೊನಾನಾ ತಗಡೊ ಲಗಾಡೂ. <verse eid="EXO 26:29" /><verse number="30" style="v" sid="EXO 26:30" />ಮಿ ಡೊಂಗರಪರ ತುನೆ ದೆಕ್ಲಾಡಲ ತರಿಕಾಮಾ ಝೊಪ್ಡಾನೆ ಕ್ಹೊಲು. <verse eid="EXO 26:30" /><verse number="31" style="v" sid="EXO 26:31" />ನಿಲಿ, ಜಾ಼ಮ್ಳಾನೊ, ಘನ್ನು ಲಾಲ ವರ್ಣೊ ತಿಮ್ಮಜ಼ ನವಾ ಥೈನ ಹೊಸೆಲ ಅಳ್ಳನಾ ಪದರಕ್ಹು ವಣ್ಣಾವೊನೆ ಕರೈನ, ತಿನೆ ಕೆರುಬಿಯೊನಾ ಹುತಿ ಕಾಮಾ ಕೌಶಲ್ಯ ಪೂರ್ಣ ಥೈನ ಕಸೂತಿ ಘಲೌ. <verse eid="EXO 26:31" /><verse number="32" style="v" sid="EXO 26:32" />ಕಾಟಾನಾ ಝಾಡಕ್ಹು ಚಾರ ಕ್ಹಂಬಾವೊನೆ ಕರೈನ, ಕ್ಹೊನಾನಾ ತಗಡೊನೆ ಲಗಾಡಿನ, ಚಾರ ರುಪ್ಪಾನಾ ಗದಗಿನಾ ದಗ್ಡಾವೊನೆ ಉಪ್ಪರ ಮ್ಹೆಲಿನ ಕ್ಹೊನಾನಾ ಕೊಂಡಿಯೊಕ್ಹು ತೆ ಪರದಾನೆ ತೆ ಚಾರೆ ಕ್ಹಂಬಾವೊನೆ ಅಟ್ಕಾಡು. <verse eid="EXO 26:32" /><verse number="33" style="v" sid="EXO 26:33" />ತೆ ಪರದಾವೊನೆ ಕೊಂಡಿಯೊನೆ ಅಟ್ಕಾಡಲಪರ ತಿಮಾ ಆಜ್ಞಾಶಾಸನೊನೆ ಮಂಜುಷನೆ ಮಂಗೈನ ಮ್ಹೆಲು. ತೆ ಪರದಾನಾ ಪವಿತ್ರ ಜಾ಼ಗಾ ವ್ಹೈ ಕೈನ ವರಿ ಮಹಾ ಪವಿತ್ರ ಜ಼ಗಾ ವ್ಹೈಕೈನ ಬಿಜಾ಼ಕರಾನು. <verse eid="EXO 26:33" /><verse number="34" style="v" sid="EXO 26:34" />ಮಹಾ ಪವಿತ್ರ ಜ಼ಗಾಮಾ ಆಜ್ಞಾ ಶಾಸನೊನಾ ಮಂಜುಷನಾ ಉಪ್ಪರ ಸಿಂಹಾಸನೆ ಲೈನ ಮ್ಹೆಲು. <verse eid="EXO 26:34" /><verse number="35" style="v" sid="EXO 26:35" />ಪರದಾನಾ ಭಾರಾ ಮೆಜನಾ ಮೆಜನೆ ಕ್ಹಾಮಾ ಥೈನ ಝೊಪ್ಡಾನಾ ದಕ್ಷಿಣ ದಿಕ್ಕಮಾ ದಿವಾನಾ ಕ್ಹಂಬಾವೊ ಮ್ಹೆಲು. ಮೆಜ ಉತ್ತರ ಭಾಗಮಾ ರ‍್ಹೌ. <verse eid="EXO 26:35" /><verse number="36" style="v" sid="EXO 26:36" />ಝೊಪ್ಡಾನಾ ಬಾಕನೆ ಅಡ್ಡ ಥೈನ ನಯಥೈನ ನವಾ ಚೊಕಾ ವಣ್ಣಾಮಾ ನಿಲಿ, ಜಾ಼ಮ್ಳನೂ, ಘನ್ನು ಲಾಲ ವರ್ಣೊನಾ ದೊರಾಕ್ಹು ಕಸೂತಿ ಘಾಲು. <verse eid="EXO 26:36" /><verse number="37" style="v" sid="EXO 26:37" />ತೆ ವಣ್ಣಾ ತೊಲಾನಾಹುತಿ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಕ್ಹಂಬಾವೊ ಕರೈನ ಕ್ಹೊನಾನಾ ತಗಡೊ ವರಾಡೂ. ತೆನಾ ಕೊಂಡಿಯೊನೆ ಕ್ಹೊನಾಕ್ಹು ಕರಲ ತಿನಾಹುತಿ ಪಾಂಚ ತಾಂಬಾನಾ ಗದಿಗಿನಾಹುತಿ ದಗ್ಡಾವೊನೆ ಕರೌ.<verse eid="EXO 26:37" /></para>
  <chapter eid="EXO 26" />
  <chapter number="27" style="c" sid="EXO 27" />
  <para style="s">ಯಜ್ಞವೆದಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1" />ಯಜ್ಞ ವೆದಿನೆ ಕಾಟಾನಾ ಝಾಡಕ್ಹು ಪಾಂಚ ಮಾರ ಲಾಂಬು ಥಯಲಬಿ, ಪಾಂಚ ಮಾರ ರುಂದ ಥಯಲಬಿ ಚೌಕಬಿ ಕರೌ. ತಿನೂ ಉಚ್ಚೂ ತನ್ನ ಮಾರ ರ‍್ಹೌ. <verse eid="EXO 27:1" /><verse number="2" style="v" sid="EXO 27:2" />ತಿನಾ ಚಾರೆ ಮೂಲಾವೊಮಾ ಚಾರ ಸಿಂಗ್ಡಾವೊನೆ ಕರೌ. ತೆ ಸಿಂಗ್ಡಾವೊ ಯಜ್ಞ ವೆದಿಕ್ಹುಜ ಆಯಲ ರ‍್ಹೌ. ತೆ ಯಜ್ಞ ವೆದಿನೆ ತಾಂಬಾನಾ ತಗಡೊ ವರಾಡೂ. <verse eid="EXO 27:2" /><verse number="3" style="v" sid="EXO 27:3" />ತಿಮಾ ರ‍್ಹವಾನೆ ರಾಕನೆ ಕಾಡಿಲಿವಾನಾಹುತಿ ಥಾಳಾವೊನೆ, ಸಲಕಿಯೊನೆ, ತಪಾಲಾವೊನೆ, ಕಾಟಾನಾ ಚಮಚಾವೊ, ತಿಮ್ಮಜ಼ ಅಗಿಷ್ಟಿಯೊನೆ ಕರೌ. ತೆ ಸಾಮನೊ ಕ್ಹಾರಾ ತಾಂಬಾನಾ ಥಯಲ ರ‍್ಹೌ. <verse eid="EXO 27:3" /><verse number="4" style="v" sid="EXO 27:4" />ಯಜ್ಞ ವೆದಿನೆ ಹತ್ತನಾ ಕಾಮಕ್ಹು ತಾಂಬಾನಾ ಜಾಲರಿನೆ ಕರೌ, ತೆ ಜಾಲರಿನಾ ಚಾರೆ ಮೂಲಾವೊನೆ ತಾಂಬಾನಾ ಬಾಂಗ್ಡಿಯೊ ಘಲೌ. <verse eid="EXO 27:4" /><verse number="5" style="v" sid="EXO 27:5" />ತೆ ಜಾಲರುಕ್ಹು ಯಜ್ಞವೆದಿನಾ ಸುತ್ತೆ ರ‍್ಹವಾನು ಕಟ್ಟಾನೂ ಹೆಟಾಲಕ್ಕಾ ರ‍್ಹೈನ ಯಜ್ಞವೆದಿನಾ ಅಡಿತು ವಚ್ಮಾಲಕ್ಕಾ ರ‍್ಹೌ ನಂಗತ ಘಲೌ. <verse eid="EXO 27:5" /><verse number="6" style="v" sid="EXO 27:6" />ಯಜ್ಞವೆದಿನೆ ಉಚಾವಾನಾ ಲಾಕಡಿಯೊ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಕರೈನ, ತಾಂಬಾನಾ ತಗಡೊನೆ ವರಾಡೂ. <verse eid="EXO 27:6" /><verse number="7" style="v" sid="EXO 27:7" />ತೆ ಲಾಕಡಿಯೊನೆ ತೆ ಬಾಂಗ್ಡಿಯೊಮಾ ಮಾಳಾಯಲ್ಪರ ತೆ ಯಜ್ಞವೆದಿನೆ ಉಚಾವಾನಾಹುತಿ ತಿನಾ ಭಂಬೆ ಜ಼ಗಾ ರ‍್ಹೌ. <verse eid="EXO 27:7" /><verse number="8" style="v" sid="EXO 27:8" />ತೆ ಯಜ್ಞವೆದಿನೆ ಢೊಲ್ಗಾವೊಕ್ಹು ಪಳ್ಳ ಥಯಲ ಪೆಟಿಗೆ ನಿಂಗತ ಕರೌ. ಮಿ ಡೊಂಗರಪರ ತುನೆ ದೆಕ್ಲಾಡಲ ನಿಂಗತ ತಿನೆ ಕರೌ.<verse eid="EXO 27:8" /></para>
  <para style="s">ಯಹೊವಾನಿ ಸನ್ನಿದಿನು ಅಂಗಳಾ</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9" />ಪರುಶುದ್ದ ಝೊಪ್ಡಾನೆ ಅಂಗಳನೆ ಕರೌ. ತೆ ದಕ್ಷಿಣನಾ ಭಾಗನೆ ಅಂಗಳನೆ ವಣ್ಣಾವೊ ರ‍್ಹೌ, ತೆ ವಣ್ಣಾವೊನೆ ನಯ ಥೈನ ನವಾ ಅಳ್ಳಿಕ್ಹು ಪದರಕ್ಹು ವಣ್ಣಾವೊನೆ ಕರೌ. ತೆ ಕ್ಹೊ ಮಾರ ಲಾಂಬಾ ಥಯಲ ರ‍್ಹೌ. <verse eid="EXO 27:9" /><verse number="10" style="v" sid="EXO 27:10" />ತೆ ಜ಼ಗಾಕನ ಇಕ್ಹ ಕ್ಹಂಬಾವೊ. ತಿನೆ ಇಕ್ಹ ತಾಂಬಾನಾ ಗದಿನಾ ದಗ್ಡಾವೊ ರ‍್ಹೌ. ಕ್ಹಂಬಾವೊನೆ ರುಪ್ಪಾನಾ ಕೊಂಡಿಯೊ ಪಟ್ಟಿಯೊ ರ‍್ಹೌ. <verse eid="EXO 27:10" /><verse number="11" style="v" sid="EXO 27:11" />ತೆ ರಿತಿಮಾ ಉತ್ತರಕನಬಿ ಕ್ಹೊಮಾರ ಲಾಂಬಾ ರ‍್ಹಯಲ ವಣ್ಣಾವೊ, ಇಕ್ಹ ಕ್ಹಂಬಾವೊ, ಇಕ್ಹ ತಾಂಬಾನಾ ಗದಿಗಿನಾ ದಗ್ಡಾವೊ ರ‍್ಹೌ ಕ್ಹಂಬಾವೊನಾ ಕೊಂಡಿಯೊ, ಪಟ್ಟಿಯೊ ರುಪ್ಪಾನಾ ಥೈಲ ರ‍್ಹೌ. <verse eid="EXO 27:11" /><verse number="12" style="v" sid="EXO 27:12" />ಪಶ್ಚಿಮಾ ಕನ ಅಂಗಳನಾ ರುಂದಮಾ ಐವತ್ತ ಮಾರ ಲಾಂಬು ಥೈನಬಿ ವಣ್ಣಾವೊ ದಕ್ಹ ಕ್ಹಂಬಾವೊ, ದಕ್ಹ ಗದಿಗೆನಾ ದಗ್ಡಾವೊ ರ‍್ಹೌ. <verse eid="EXO 27:12" /><verse number="13" style="v" sid="EXO 27:13" />ಪೂರ್ವ ದಿಕ್ಕಮಾಬಿ ಅಂಗಳನಾ ರುಂದಮಾ ಐವತ್ತು ಮಾರ ರ‍್ಹೌ. <verse eid="EXO 27:13" /><verse number="14" style="v" sid="EXO 27:14" />ಯಕ್ಕ ಜ಼ಗಾಕನ ಪಂದ್ರಾ ಮಾರ ಲಾಂಬು ರ‍್ಹಯಲ ವಣ್ಣಾ ರ‍್ಹೈನ ತಿನೆ ತನ್ನ ಸ್ತಂಬೊನೆ, ತನ್ನ ಗದಿಗಿನಾ ದಗ್ಡಾವೊ ರ‍್ಹೌ. <verse eid="EXO 27:14" /><verse number="15" style="v" sid="EXO 27:15" />ಹಜಿಯಕ್ಕ ಜ಼ಗಾಕನ ಪಂದ್ರಾ ಮಾರ ಲಾಂಬು ಥಯಲ ವಣ್ಣಾ ರ‍್ಹೈನ ತಿನೆ ತನ್ನ ಸ್ತಂಬೊನೆ, ತನ್ನ ಗದಿಗಿನಾ ದಗ್ಡಾವೊ ರ‍್ಹೌ. <verse eid="EXO 27:15" /><verse number="16" style="v" sid="EXO 27:16" />ಅಂಗಳನಾ ಬಾಕಲಮಾ ಇಕ್ಹಮಾರನಾ ವಣ್ಣಾವೊ ರ‍್ಹೌ ತಿನೆ ನಯ ಥೈನ ಹೊಸೆದ ನವಾ ನೂಲ, ನಿಲಿ, ಜಾ಼ಂಬ್ಳಾನೊ, ಘನ್ನುಲಾಲ ಬಿಜಾ಼ ಬಿಜಾ಼ ದೊರಾಕ್ಹು ಕಸೂತಿ ಕಾಮವಾಲಾವೊಕ್ಹು ಹತ್ತಕ್ಹು ಕರೌ. ಬಾಕಲನೆ ಚಾರ ಕ್ಹಂಬಾವೊ ಚಾರ ಗದಗಿನಾ ದಗ್ಡಾವೊ ರ‍್ಹೌ. <verse eid="EXO 27:16" /><verse number="17" style="v" sid="EXO 27:17" />ಅಂಗಳನಾ ಸುತ್ತೆಬಿ ರ‍್ಹವಾನು ಕ್ಹಾರಾ ಕ್ಹಂಬಾವೊನೆ, ರುಪ್ಪಾನಾ ಪಟ್ಟಿಯೊ, ರುಪ್ಪಾನಾ ಕೊಂಡಿಯೊ, ತಾಂಬಾನಾ ಗದಗಿನಾ ದಗ್ಡಾವೊ ರೌ. <verse eid="EXO 27:17" /><verse number="18" style="v" sid="EXO 27:18" />ಅಂಗಳಬಿ ಕ್ಹೊ ಮಾರ ಲಾಂಬು ಥೈನ ಸುತ್ತೆಬಿ ಐವತ್ತ ಮಾರ ರುಂದ ಥೈನಬಿ ರ‍್ಹೌ. ತಿನಾ ಸುತ್ತೆ ರ‍್ಹವಾನಾ ವಣ್ಣಾಬಿ ನಯ ಥೈನ ನವಾ ಅಳ್ಳಿನಾ ಪದರಕ್ಹು ವಣ್ಣಾವೊಕ್ಹು ಕರಲ ತಿನೆ ಪಾಂಚ ಮಾರ ಉಚ್ಚು ರ‍್ಹೌ. ತಿನೆ ತಾಂಬಾನಾ ಗದಗಿನಾ ದಗ್ಡಾವೊ ರ‍್ಹೌ. <verse eid="EXO 27:18" /><verse number="19" style="v" sid="EXO 27:19" />ಝೊಪ್ಡಾನಾ ಬಿಜಾ಼ಬಿಜಾ಼ ಕಾಮನೆ ಚಾ಼ಯೆ ಥಯಲ ಸಾಮನೊ , ಝೊಪ್ಡಾನಾ ಗುಟವೊ, ಅಂಗಳನಾ ಗುಟೊ, ತಾಂಬಾನಾ ಥಯಲ ರ‍್ಹೌ.<verse eid="EXO 27:19" /></para>
  <para style="s">ದಿವ್ವಾನಿ ಕಾಳಜಿ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20" />ದಿವಾ ಕೆಳಾಮಾಬಿ ಬಳು ನಿಂಗತ ಇಸ್ರಾಯೆಲೊ ಒಲಿವ್ ಝಾಡನಾ ಕಚ್ಚಾವೊನೆ ಕುಟ್ಟಿನ ಚೊಕು ಥಯಲ ಒಲಿವ್ ತೆಲನೆ ಕಾಡಿಲಿನ ಆವಾನಿಂಗತ ತ್ಯುನೊನೆ ಅಪ್ಪಣೆ ದ್ಯೂ. <verse eid="EXO 27:20" /><verse number="21" style="v" sid="EXO 27:21" />ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಝೊಪ್ಡಾಮಾ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನಾ ಅಗಾ ರ‍್ಹವಾನಾ ವಣ್ಣಾನಾ ಭಾರಾ ಆರೊನನೆ, ತಿನಾ ಬಚ್ಚಾ ತೆ ಕ್ಹಾಂಜತು ಪಾಟಲಕ್ಕಾ ಯಹೊವಾನಾ ಸನ್ನಿದಿಮಾ ತೆ ದಿವೊ ಬಳಲ ನಿಂಗತ ಕರೆಟ್ಟ ಲಾಗಲ ರ‍್ಹೌ. ಇಸ್ರಾಯೆಲೊ ತಿನಾ ಕ್ಹಾಂದಾನಾವಾಲಾ ಆ ನಿಯಮನೆ ತಲತಲಾಂತರಲಕ್ಕಾ ಶಾಶ್ವತ ಥೈನ ಕರು.<verse eid="EXO 27:21" /></para>
  <chapter eid="EXO 27" />
  <chapter number="28" style="c" sid="EXO 28" />
  <para style="s">ಯಾಜಕೊನಾ ವಣ್ಣಾವೊನಾಹುತಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1" />ಮನೆ ಯಾಜಕನಿ ಸೆವೆ ಕರಾನಾಹುತಿ ತು ತಾರಾ ಮ್ಹೊಟೊ ಭೈ ಥಯಲ ಆರೊನನೆ, ತಿನಾ ಬಚ್ಚಾ ಥಯಲ ನಾದಾಬ, ಅಬಿಹು, ಎಲ್ಲಾಜಾರ, ಇತಾಮಾರ ಕವಾನಾ ಇಸ್ರಾಯಲತೊ ತುಕನ ಬಲೈಲಿನ ಆ. <verse eid="EXO 28:1" /><verse number="2" style="v" sid="EXO 28:2" />ತಾರಾ ಮ್ಹೊಟೊ ಭೈ ಥಯಲ ಆರೊನನೆ ಮರಯಾದಿ, ಅಲಂಕಾರ ಉಂಟಥವೊಕೈನ ತಿನೆ ದಿಕ್ಷಾ ವಸ್ರ್ತೊನೆ ಪರಶುದ್ದ ಸಾಮ್ನೊನೆ ಕರೌ. <verse eid="EXO 28:2" /><verse number="3" style="v" sid="EXO 28:3" />ಕೆನೆ ಮಿ ಜ್ಞಾನನಾ ವರನೆ ಪರಿಪೂರ್ಣ ಥೈನ ಅನುಗ್ರಹಿಶೊಸ ತ್ಯವಾ ಜ್ಞಾನಿಯೊ ಕ್ಹಾರಾ ಕ್ಹಾತೆ ತು ಬೊಲಿನ ತ್ಯುನಾ ಹತ್ತಕ್ಹು ತೆ ವಸ್ತ್ರೊನೆ ಸಿದ್ದ ಕರು. ಆರೊನನ ತಿನೆ ಘಾಲ್ಲಿಲಿನ ಮಾರಾ ಯಾಜಕ ಥಾವಾನಾಹುತಿ ಪ್ರತಿಷ್ಠ ಥಾವಸ. <verse eid="EXO 28:3" /><verse number="4" style="v" sid="EXO 28:4" />ತ್ಯುನೆ ಕರಾನಾ ಸಾಮನೊ ಕಯಾ ವ್ಹೈ ಕದ್ಯಾಮ; ಛಾತಿ ಪದಕನಿ ಪಿಸಿ, ಎಫೊದ, ನಿಲುವಂಗಿ, ಕೆತ್ತಾನಾ ಕಾಮನಾ ಮೆಲಂಗಿ, ಮೂಂಡಾಸ ವರಿ ನಡಕಟ್ಟ ಆಜವ್ಹೈ. ತಾರೊ ಭ್ಹೈ ಥಯಲ ಆರೊನ ತಿನಾ ಬಚ್ಚಾ ಮಾರಾ ಯಾಜಕಥಾವಾನಾಹುತಿ ತ್ಯುನಾಹುತಿ ಆ ದಿಕ್ಷಾ ವಸ್ತ್ರೊನೆ ಕರೌ. <verse eid="EXO 28:4" /><verse number="5" style="v" sid="EXO 28:5" />ಮನಕ್ಹೊ ಕಾಣಿಕೆ ಥೈನ ದಿವಾನಾ ಕ್ಹೊನಾನೆ, ನಿಲಿ, ಜಾ಼ಮ್ಳಾನು, ಘನ್ನು ಲಾಲ ವರ್ಣೊನಾ ದೊರಾನೆ, ವರಿ ನವಾ ವಣ್ಣಾನೆ ತೆ ಕಾಮನಾಹುತಿ ಉಪಯೊಗ ಕರು. <verse eid="EXO 28:5" /><verse number="6" style="v" sid="EXO 28:6" />ಎಪೊದ ಕವಾನು ಕವಚನೆ ನಯ ಥೈನ ಅಳ್ಳಿನಾ ದೊರಾಕ್ಹು ಕರೈನ ತಿನೆ ಕ್ಹೊನೂ, ನಿಲಿ, ಜಾ಼ಮ್ಳಾನೂ ವರಿ ಘನ್ನು ಲಾಲ ದೊರಾವೊಕ್ಹು ಕಸೂತಿ ಘಾಲಿನ ಅಲಂಕಾರ ಕರು. <verse eid="EXO 28:6" /><verse number="7" style="v" sid="EXO 28:7" />ತೆ ಕವಚನೆ ಕ್ಹಾಂದಾನಾ ಉಪ್ಪರ ಬೆ ಪಟ್ಟಿಯೊನೆ ರ‍್ಹೌ. ತಿನಾ ಭಂಬಿಯೊ ತುದಿಯೊ ಜೊಡಸಲ ರ‍್ಹೌ. <verse eid="EXO 28:7" /><verse number="8" style="v" sid="EXO 28:8" />ಕವಚನ ಉಪ್ಪರ ರ‍್ಹವಾನೂ ಕೆತ್ತಿನಾ ಕಾಮಕ್ಹು ನಡಕಟ್ಟಿ ಎಕ ಥಯಲ ತಿನಾನಿಂಗತ ನಯ ಥೈನ ನವಾ ಅಳ್ಳಿನಾ ದೊರಾಕ್ಹು ಕರಲ ಕ್ಹೊನಾನಾ ದೊರಾಕ್ಹು ನಿಲಿ, ಜಾ಼ಮ್ಳಾನಾ, ಘನ್ನುಲಾಲ ವರ್ಣೊನಾ ದೊರಾವೊಕ್ಹು ಅಲಂಕಾರ ಥಯಲ ರ‍್ಹೌ. <verse eid="EXO 28:8" /><verse number="9" style="v" sid="EXO 28:9" />ವರಿ ತು ಬೆ ಗೊಮೆಧಕ ಅಮೂಲ್ಯ ರತ್ನೊನೆ ಕಾಡಿಲಿನ ತಿಮಾ ಇಸ್ರಾಯಲನಾ ಕುಲನಾ ನಾಮೊನೆ ಕೆತ್ತವು. <verse eid="EXO 28:9" /><verse number="10" style="v" sid="EXO 28:10" />ಯಕ್ಕ ರತ್ನಮಾ ಛೆ ನಾಮೊನೆ ಹಜಿಯಕ್ಕ ರತ್ನಮಾ ಉಗ್ರಲ ಛೆ ನಾಮೊನೆ ತಿನಾತಿನಾ ಜನನಾ ಪ್ರಕಾರ ಕೆತ್ತವು. <verse eid="EXO 28:10" /><verse number="11" style="v" sid="EXO 28:11" />ಮೂದ್ರೆವೊನೆ ಕೆತ್ತಾನಾ ನಿಂಗತ ತೆ ಶಿಲ್ಪಿಯೊಕ್ಹು ಬೆ ರತ್ನಮಾ ಇಸ್ರಾಯಲನಾ ಕುಲನಾ ನಾಮೊನೆ ಕೆತ್ತೈನ, ತಿನೆ ಕ್ಹೊನಾನೆ ತೆ ಮುದ್ರೆನಾ ಉಪ್ಪರ ಮ್ಹೆಲು. <verse eid="EXO 28:11" /><verse number="12" style="v" sid="EXO 28:12" />ತೆ ಬೆ ರತ್ನೊನೆ ಕ್ಹಾಂದಾನಾ ಉಪ್ಪರ ರ‍್ಹಯಲ ಎಪೊದಿನ ಪಟ್ಟಿಯೊಮಾ ಘಲೌ. ತೆ ಇಸ್ರಯಲನಾ ಸ್ಹೆ ರ‍್ಹಯಲ ರತ್ನೊ ಥಾವಸ. ಅರೊನಬಿ ಯಹೊವಾನಾ ಸನ್ನಿದಿಮಾ ಜಾ಼ತಾಟೆಮಾ ಇಸ್ರಾಯೆಲೊನಾ ಕುಲೊನಾ ನಾಮೊನೆ ತಿನಾ ಸ್ಹೆನೆ ಲಾವಾನಾಹುತಿ ತಿನಾ ಭಂಬೆ ಕ್ಹಾಂದಾವೊನಾ ಉಪ್ಪರ ತಿನೆ ಘಾಲ್ಲಿಲಿನ ಜಾ಼ವಸ. <verse eid="EXO 28:12" /><verse number="13" style="v" sid="EXO 28:13" />ತೆ ರತ್ನೊನೆ ಜೊಡಸಾನಾಹುತಿ ಕ್ಹೊನಾನಿ ಸರಿಗೆನೆ ಹೆಣದಿನ ಗುಡೊನೆ ಕರೌ. <verse eid="EXO 28:13" /><verse number="14" style="v" sid="EXO 28:14" />ವರಿ ಹೆಣೆಗೆನಾ ಕಾಮಕ್ಹು ಹುರಿಯೊ ನಿಂಗತ ರ‍್ಹವಾನು ಬೆ ಚೊಕಾ ಕ್ಹೊನಾನಾ ಸರಪಣಿಯೊನೆ ಕರೈನ ರತ್ನೊನಾ ಗುಡೊನೆ ಅಟ್ಕಾಡೂ.<verse eid="EXO 28:14" /></para>
  <para style="s">ಛಾತಿನು ಕವಚ</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15" />ಛಾತಿನಾ ಪದಕನಾ ಕವಚನೆ ಕೆತ್ತಾನಾ ಕಾಮಕ್ಹು ಕರೌ. ತಿನೆ ಎಪೊದ್ ನೆ ಕರೈನ ತಿಮ್ಮಜ಼ ಕ್ಹೊನಾನಾ ದೊರಾಕ್ಹುಬಿ ನಿಲಿ, ಜಾ಼ಮ್ಳಾನೂ, ಘನ್ನು ಲಾಲ ವರ್ಣೊನಾ ದೊರಾವೊಕ್ಹು ನಯ ಥೈನ ನವಾ ಅಳ್ಳಿನಾ ದೊರಾವೊಕ್ಹು ಕರೌ. <verse eid="EXO 28:15" /><verse number="16" style="v" sid="EXO 28:16" />ತೆ ಯಕ್ಕ ಗೆಣುದ್ದ ಥೈನಬಿ ವರಿ ಯಕ್ಕ ಗೆಣಗಲ ಥೈನಬಿ ಬೆ ಪದರಕ್ಹು ಚೌಕ ಥಯಲರ‍್ಹೌ. <verse eid="EXO 28:16" /><verse number="17" style="v" sid="EXO 28:17" />ತಿನಾ ಕ್ಹಾಮಲ್ಯಾ ಭಾಗಮಾ ಚಾರ ಸಾಲ ಥೈನಬಿ ರತ್ನೊನೆ ಹೆಚ್ಚಕರು. ಪೈಲಾ ಸಾಲಮಾ ಮಾಣಿಕ್ಯ, ಪುಷ್ಯರಾಗ ವರಿ ಸ್ಫಟಿಕೊ ರ‍್ಹೌ. <verse eid="EXO 28:17" /><verse number="18" style="v" sid="EXO 28:18" />ಬೆವಾ ಸಾಲಮಾ ಪಚ್ಚೆ, ನಿಲ ರತ್ನ ವರಿ ಹಿರಾವೊ ರ‍್ಹೌ. <verse eid="EXO 28:18" /><verse number="19" style="v" sid="EXO 28:19" />ತನ್ನವಾ ಸಾಲಮಾ ಸುವರ್ಣ ರತ್ನ, ಸುಗಂದಿ ವರಿ ಪದ್ಮಾನಾ ರಾಗೊ ರ‍್ಹೌ. <verse eid="EXO 28:19" /><verse number="20" style="v" sid="EXO 28:20" />ಚಾರವಾ ಸಾಲಮಾ ಪಿತ ರತ್ನ, ಬೆರುಲ್ಲ, ವಡವೊನೆ ಮಣಿಯೊಮಾ ರ‍್ಹೌ. <verse eid="EXO 28:20" /><verse number="21" style="v" sid="EXO 28:21" />ಇಸ್ರಾಯಲನಾ ಕುಲವೊ ಸಂಖ್ಯಾನೆ ಅನುಗುಣ ಥೈನ ಬಾರಾ ರತ್ನವೊ ರ‍್ಹೌ. ಮುದ್ರೆವೊನೆ ಕೆತ್ತಾನಾ ರಿತಿಮಾ ಯಕ್ಕ ಯಕ್ಕ ರತ್ನಮಾ ಯಕ್ಕಯಕ್ಕ ಕುಲನಾ ನಾಮೊನೆ ಕೆತ್ತಾಡೂ. <verse eid="EXO 28:21" /><verse number="22" style="v" sid="EXO 28:22" />ತೆ ನೈಸೊ ತೆ ಪದಕನಾ ಉಪ್ಪರಲ್ಯಾಮಾ ಹುರಿಯೊ ನಿಂಗತ ರ‍್ಹವಾನು ಚೊಕಾ ಕ್ಹೊನಾನಾ ಸರಪಣಿನೆ ಹೆಣಿಗೆನಾ ಕಾಮಕ್ಹು ಕರೌ. <verse eid="EXO 28:22" /><verse number="23" style="v" sid="EXO 28:23" />ಬೆ ಕ್ಹೊನಾನಾ ಕೊಂಡಿಯೊನೆ ಕರೈನ ಛಾತಿನಾ ಪದಕನಾ ಕವಚನಾ ಭಂಬೆ ಮುಲಾವೊಮಾ ಜೊಡಸು. <verse eid="EXO 28:23" /><verse number="24" style="v" sid="EXO 28:24" />ತೆ ಭಂಬೆ ಸರಪಪಣಿಯೊನೆ ಛಾತಿನಾ ಪದಕನಾ ಕವಚನಾ ಮೂಲಾವೊಮಾ ಕೊಂಡಿಯೊನೆ ಅಟ್ಕಾಡು. <verse eid="EXO 28:24" /><verse number="25" style="v" sid="EXO 28:25" />ತೆ ಸರಪಣಿನಾ ಕೊನಾವೊನೆ ಎಪೊದ ಕವಚನಾ ಕ್ಹಾಂದಾನಾ ಪಟ್ಟಿಯೊಮಾ ಬೆ ಕೊಂಡಿಯೊನೆ ಅಟ್ಕಾಡಿನ ಕ್ಹಾಮಾಲ್ಯಾ ಬಾಗಮಾ ರ‍್ಹೌ. <verse eid="EXO 28:25" /><verse number="26" style="v" sid="EXO 28:26" />ತೆ ನೈಸೊ ಬೆ ಕ್ಹೊನಾನಾ ಕೊಂಡಿಯೊನೆ ಕರೈನ ಛಾತಿನಾ ಪದಕನಾ ಮ್ಹೈ ಅಂಚನಾ ಮೂಲಾವೊಮಾ ಕವಚನಾ ಬಾಜು಼ಮಾಜ ಮ್ಹೆಲಾ ಲಗಾಡೂ. <verse eid="EXO 28:26" /><verse number="27" style="v" sid="EXO 28:27" />ವರಿ ಬಿಜಾ಼ ಕ್ಹೊನಾನಾ ಕೊಂಡಿಯೊನೆ ಕರೈನ ಎಪೊದ್ ಕವಚನಾ ಭಂಬೆ ಕ್ಹಾಂದಾನಾ ಕ್ಹಾಮಲ್ಯಾ ಭಾಗಮಾ ಹೆಟಾ ಕವಚನೆ ಜೊಡಲಸಲ ಜ಼ಗಾಮಾ ಬಾಜು಼ ಕಸೂತಿ ಘಾಲಲ ವಚ್ಮಾನಾ ಕಟ್ಟನಾ ಉಪ್ಪರ ಮ್ಹೆಲಲ ರ‍್ಹೌ. <verse eid="EXO 28:27" /><verse number="28" style="v" sid="EXO 28:28" />ಛಾತಿನಾ ಪದಕಬಿ ಕಸೂತಿ ಘಾಲಲ ವಚ್ಮಾನಾ ಕಟ್ಟನಾ ಉಪ್ಪರಬಿ ಬಿಗಿಥಾವಾನಿಂಗತ, ಎಪೊದ್ ಕವಚಕ್ಹು ಕಳಚಿನ ಪಡೆವಾಚಿಬಿ ತಿನಾ ಕೊಂಡಿಯೊನೆ ಎಪೊದ್ ಕವಚನಾ ಕೊಂಡಿಯೊನೆ ನಿಲಿ ದೊರಾಕ್ಹು ಭಂದೌ. <verse eid="EXO 28:28" /><verse number="29" style="v" sid="EXO 28:29" />ನ್ಯಾಯ ತಿರ್ಪನಾ ಛಾತಿನಾ ಉಪ್ಪರ ಇಸ್ರಾಯಲನಾ ಕುಲೊನಾ ನಾಮೊನೆ ಲಿಕ್ಕಲಕ್ಹು ಆರೊನ ಪವಿತ್ರ ಜ಼ಗಾನಾ ಮ್ಹೈ ಜಾ಼ತಾ ಟೈಮ್ಮಾ ತೆ ನಾಮೊನೆ ಸತತಥೈನ ಯಹೊವಾನಾ ಸೆನೆ ಲಾವಾನಾಹುತಿ ತಿನೆ ತಿನಾ ಛಾತಿನಾ ಉಪ್ಪರ ಹಮೆಶ್ಯಾಬಿ ಘಾಲ್ಲುಸ. <verse eid="EXO 28:29" /><verse number="30" style="v" sid="EXO 28:30" />ನ್ಯಾಯ ತಿರ್ಪನೆ ತಿಳಸಾನಾ ಉರಿಮ ವರಿ ತುಮ್ಮಿಮ (ದೆಕಾಡಿನ ದಿದಲ ವರಿ ಕ್ಹರಿ) ತೆ ಛಾತಿನಾ ಪದಕಪರ ಮ್ಹೆಲು. ಆರೊನ ಯಹೊವಾನಿ ಸನ್ನಿದಿನೆ ಜಾ಼ತಾಮಾ ತೆ ತಿನಾ ಛಾತಿನಾ ಉಪ್ಪರ ರ‍್ಹವಸ. ಇಸ್ರಾಯಲನಾ ಮನಕ್ಹೊ ಸು ಕೈದಿಲಿನ ಜೌ಼ ಕದ್ಯಾಮ ನ್ಯಾಯ ತಿರ್ಪನೆ ಆರೊನಾ ಅಮ್ಮ ತಿನಾ ಮನಸನಾ ಉಪ್ಪರ ಯಹೊವಾನಾ ಸನ್ನಿದಿಮಾ ಕೆಳಾಮಾಬಿ ಘಾಲ್ಲಿಲಿದಲ ರ‍್ಹೌ.<verse eid="EXO 28:30" /></para>
  <para style="s">ವಾಜಕೊನಾ ಉಗ್ರಲ ವಣ್ಣಾ</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31" />ಮ್ಹೊಟೊ ಯಾಜಕ ಎಪೊದ ಕವಚನಾ ಕ್ಹಾತೆ ಘಾಲ್ಲಿ ಲಿವಾನು ಉಪ್ಪರಲ್ಯೂ ಅಂಗ್ಡೂ ತು ನಿಲಿ ರಂಗನಾ ಫಡ್ಕಾಕ್ಹು ಕರೌ. <verse eid="EXO 28:31" /><verse number="32" style="v" sid="EXO 28:32" />ಮಾತು ಘಾಲಾನಹುತಿ ತಿಮಾ ಸಂದಿ ರ‍್ಹೌ. ತೆ ಫಾಟೆವಾಚಿ ತೆ ಸಂದಿನಾ ಸುತ್ತೆಬಿ ಸಿನ ತಿನಾಕ್ಹಾತೆ ಯಕ್ಕ ತೆ ಪಟ್ಟಿನೆ ಶ್ಯು. <verse eid="EXO 28:32" /><verse number="33" style="v" sid="EXO 28:33" />ಉಪ್ಪರಲ್ಯಾ ಅಂಗ್ಡಾನಾ ಸುತ್ತೆಬಿ ನಿಲಿ, ಜಾ಼ಮ್ಳಾನೂಕಲರ, ಘನ್ನ ಲಾಲ ವರ್ಣೊನಾ ದೊರಾಕ್ಹು <verse eid="EXO 28:33" /><verse number="34" style="v" sid="EXO 28:34" />ಕ್ಹೊನಾನಿ ಗೆಜ್ಜಿ ಅನಾರಬಿ ಯಕ್ಕನಾ ಉಪ್ಪರ ಯಕ್ಕ ತೆ ಉಪ್ಪರಲ್ಯೂ ಅಂಗ್ಡೂ <verse eid="EXO 28:34" /><verse number="35" style="v" sid="EXO 28:35" />ಆರೊನಬಿ ಯಾಜಕ ಸೆವಾ ಕರ್ತಾ ಟಮ್ಮಾ ತಿನೆ ಘಾಲ್ಲಿಲಿವು. ತೆ ಯಹೊವಾನಾ ಸನ್ನಿದಿನೆ ಪವಿತ್ರ ಜ಼ಗಾನಾ ಮ್ಹೈ ಜಾ಼ತಾಟೈಮಾ ಆತಾಟೈಮಾ ಮರೆವಾಚಿ ತೆ ಗೆಜ್ಜಿನೊ ಆವಾಜ ಐಕೌ. <verse eid="EXO 28:35" /><verse number="36" style="v" sid="EXO 28:36" />ಚೊಕಾ ಕ್ಹೊನಾಕ್ಹು ಯಕ್ಕ ಪಟ್ಟಿನೆ ಕರೈನ ಮುದ್ರೆನೆ ಕೆತ್ತಾನಾ ರಿತಿಮಾ ತಿನಾ ಉಪ್ಪರ "ಯಹೊವಾನೆ ಮಿಸಾನೆ” ಕವಾನಿ ಲಿಪಿನೆ ಕೆತ್ತಾ ಲಗಾಡೂ. <verse eid="EXO 28:36" /><verse number="37" style="v" sid="EXO 28:37" />ತಿನೆ ಮುಂಡಾಸನೆ ಬಿಗದಾನಾಹುತಿ ನಿಲಿ ದೊರಾನೆ ತಿನೆ ಭಂದೌ. ತೆ ಮುಂಡಾಸನಾ ಕ್ಹಾಮಲ್ಯಾ ಭಾಗಮಾ ರ‍್ಹೌ. <verse eid="EXO 28:37" /><verse number="38" style="v" sid="EXO 28:38" />ಇಸ್ರಾಯೆಲೊ ಕಾಣಿಕೆ ಥೈನ ಸಮರ್ಪಿಸಾನಾ ಕ್ಹುದಾನಾ ಕ್ಹಾರಾ ಪವಿತ್ರ ಸಾಮೊನೊನಾ ವಿಷಯಮಾ ದೊಷ ಸುಬಿ ರ‍್ಹೈತಬಿ ಆರೊನಬಿ ತೆ ಪಟ್ಟನೆ ಕೆಳಾಮಾಬಿ ಹಣಿನಾ ಉಪ್ಪರ ಘಾಲ್ಲಿನ ತೆ ದೊಷನಾ ಫಲನೆ ವಹಿಸಿಲಿವಾನಾಹುತಿ ತ್ಯುನೆ ಯಹೊವಾನೆ ಮಚ್ಚಿಕೆ ರ‍್ಹಯಲ ವಾಲಾ ಥಾವಸ. <verse eid="EXO 28:38" /><verse number="39" style="v" sid="EXO 28:39" />ಆರೊನ ಘಾಲ್ಲಿ ಲಿವಾನಾ ಮ್ಹೈನಾ ಅಂಗ್ಡಾನೂ ಅಳ್ಳಿನಾ ದೊರಾಕ್ಹು ಕಾಮ ಕರೈನ ಸಿವಾ ಲಗಾಡು. ತೆ ಮುಂಡಾಸನೆ ಅಳ್ಳಿನಾ ದೊರಾಕ್ಹು ಕರೌ. ತಿನಾ ಕಂಬರನಾ ಕಟ್ಟನೆ ಸಿವಾನಾ ಕಾಮಕ್ಹು ಕರೌ. <verse eid="EXO 28:39" /><verse number="40" style="v" sid="EXO 28:40" />ಆರೊನಾ ಬಚ್ಚಾವೊನಾ ತಕ್ಕ ಮರಯಾದಿನಾಹುತಿ, ಅಲಂಕಾರನಾಹುತಿ ತ್ಯುನೊನೆ ಉಪ್ಪರಲ್ಯು ಅಂಗ್ಡಾನೆ, ಕಂಬರನಾ ಕಟ್ಟನೆ ವರಿ ಮುಂಡಾಸನೊನೆ ಕರೌ. <verse eid="EXO 28:40" /><verse number="41" style="v" sid="EXO 28:41" />ತ್ಯುನೆ ಮನೆ ಯಾಜಕನಿ ಸೆವೆ ಕರಾನಾಹುತಿ ತೆ ವಸ್ರ್ತೊನೊ ತಾರೊ ಮ್ಹೊಟೊ ಭೈ ಥಯಲ ಆರೊನನೆ, ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆ ಘಾಲಿನ ,ತ್ಯುನೊನೆ ಅಬಿಷೆಕ ಕರಿನ, ಸೆವೆನಾಹುತಿ ಪ್ರತಿಷ್ಟ ಕರು. <verse eid="EXO 28:41" /><verse number="42" style="v" sid="EXO 28:42" />ತೆನೈಸೊ ತ್ಯುನಾ ನಗ್ನತೆನೆ ಸೆ ಇಕ್ಹಾರಾನಾಹುತಿ ತ್ಯುನೊನೆ ಕಂಬರತು ಮಾಂಡಿಲಕ್ಕಾ ರ‍್ಹವಾನಾ ನವಾ ಚಡ್ಡಿವೊನೆ ಸಣಬಿನ ದೊರಾಕ್ಹು ಕರೌ. <verse eid="EXO 28:42" /><verse number="43" style="v" sid="EXO 28:43" />ಆರೊನ, ತಿನಾ ಬಚ್ಚಾ ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಝೊಪ್ಡಾನಾ ಮ್ಹೈ ಜಾ಼ತಾ ಟೆಮಾ, ಪವಿತ್ರ ಜ಼ಗಾಮಾ ಸೆವಾ ಕರಾನಾಹುತಿ ಯಜ್ಞವೆದಿನಾ ನಜಿಕ ಆವಾನಾಹುತಿ ತಿನೆ ಘಾಲ್ಲಿಲಿದಲ ರೌ. ನೈಥಯಾಮ ತ್ಯುನೆ ತೆ ಅಪರಾಧನಾ ಫಲನೆ ಅನುಭವ ಕರಿನ ಮರಿತಬಿ. ತಿನೆ ತಿನಾ ಕ್ಹಾಂದಾನಾವಾಲಾನೆಬಿ ಆ ಶಾಶ್ವತ ಥಯಲ ನಿಯಮ ಥಯುಸ.<verse eid="EXO 28:43" /></para>
  <chapter eid="EXO 28" />
  <chapter number="29" style="c" sid="EXO 29" />
  <para style="s">ಯಾಜಕೊನೆ ನೆಮಿಸಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1" />ತ್ಯುನೆ ಮನೆ ಯಾಜಕ ಥಯೆಲಿಂಗತ ತ್ಯುನೊನೆ ನೆಮಕ ಕರಾನೆ ತು ಕರಾನಾ ಕಾಮೊ ಸುವೈ ಕದ್ಯಾಮ; ಯಕ್ಕ ಬೈಲ ವರಿ ಬೈಲನು ಬಚ಼್ಚಾನೆ ಕಯುಜ಼಼ ದೊಶ ನೈಸೊ ಬೆ ಟಗರೊನೆ ಲಿವ್. <verse eid="EXO 29:1" /><verse number="2" style="v" sid="EXO 29:2" />ವರಿ ಕ್ಹಾಟು ನೈಸೊ ರೊಕ್ಲಾ, ತೆಲಮಾ ಮಳಾಯಲ ಕ್ಹಾಟು ನೈಸೊ ಪೊಳಿಯೊ, ತೆಲಮಾ ತಳ್ಯಲ ಕ್ಹಾಟು ನೈಸೊ ಪೊಳಿಯೊ, ಘೌಂನಾ ಲೊಟಕ್ಹು ಕರಾಯಲ ಯಕ್ಕ ಟೊಪ್ಲಿಮಾ ಭರೌ. <verse eid="EXO 29:2" /><verse number="3" style="v" sid="EXO 29:3" />ತೆ ಥಯಲ್ಪರ ತೆ ಟೊಪ್ಲಿನೆ, ಬೈಲನೆ ವರಿ ಬೆ ಟಗರೊನಾ ಕ್ಹಾತೆ ಲೌ. <verse eid="EXO 29:3" /><verse number="4" style="v" sid="EXO 29:4" />ತೆಳಾಮಾ ಆರೊನನೆ ವರಿ ತಿನಾ ಬಚ಼್ಚಾವೊನೆ ದೆವದರ್ಶನನಾ ಗುಡಾರನಾ ಬಾಕಲಕನ ಬಲೈಲಿನ ಐನ ಪಾನಿಮಾ ಅಂಗ ಧವಾ ಲಗಾಡಿನ <verse eid="EXO 29:4" /><verse number="5" style="v" sid="EXO 29:5" />ತೆ ವಣ್ಣಾ ಕದ್ಯಾಮ ಉಪ್ಪರ್ಲು ಅಂಗ್ಡು ಕವಚನಾ ಕ್ಹಾತೆ ಘಾಲಿಲಿವಾನು ಅಂಗ್ಡಾನೆ ಕವಚನಾ ಪಿಶಿನಾ ಪದಕ ಆರೊನನೆ ಘಾಲಿನ ವಿಚಿತ್ರ ಕಂಬರನಿ ಪಟ್ಟಿ ಭಾಂದಿನ <verse eid="EXO 29:5" /><verse number="6" style="v" sid="EXO 29:6" />ತಿನಾ ಮಾತಾನೆ ಮುಂಡಾಸ ಘಲಾಲಗಾಡಿನ, ಮುಂಡಾಸನಾ ಉಪ್ಪರ ಪವಿತ್ರ ಪಟ್ಟೊ ಭಂದೈನ, <verse eid="EXO 29:6" /><verse number="7" style="v" sid="EXO 29:7" />ಅಭಿಷೆಕನು ತೆಲ ತಿನಾ ಉಪ್ಪರ ರಿಚ಼ೈನ ತಿನೆ ಅಭಿಷೆಕ ಕರು. <verse eid="EXO 29:7" /><verse number="8" style="v" sid="EXO 29:8" />ಪಾಚ಼ಲ್ತಾ ತಿನಾ ಬಚ಼್ಚಾವೊನೆ ನಜಿಕ ಬಲೈನ, ತ್ಯುನೊನೆ ಯಪ್ಪರಲ್ಯು ಅಂಗ್ಡಾ ಘಲೈನ <verse eid="EXO 29:8" /><verse number="9" style="v" sid="EXO 29:9" />ಆರೊನನೆಬಿ ತಿನಾ ಬಚ಼್ಚಾವೊನೆಬಿ ನಡುಕಟ್ಟ ಭಂದೈನ ಮುಂಡಾಸೊ ಮ್ಹೆಲು. ತೆ ದಿನ್ನತು ಯಾಜಕತ್ವ ತ್ಯುನೊನೆ ಹಮೆಶಾನು ಹಕ್ಕ ಥೈನ ರ‍್ಹವಸ. ಇಮ್ಮ ಆರೊನ ತಿಮಾ ಬಚ಼್ಚಾ ಯಾಜಕನಾ ಸೆವೆನೆ ನೆಮಸಲವಾಲಾ ಥಾವಸ. <verse eid="EXO 29:9" /><verse number="10" style="v" sid="EXO 29:10" />ಪಾಚ಼ಲ್ತೊ ತು ತೆ ಬೈಲನೆ ದೆವದರ್ಶನನಾ ಗುಡಾರಕನ ಲೈನ, ಆರೊನ ತಿನಾ ಬಚ್ಚಾ಼ ತಿನಾ ಮಾತಾನಾ ಉಪ್ಪರ ತ್ಯುನಾ ಹತೊ ಮ್ಹೆಲಾಲಗಾಡು. <verse eid="EXO 29:10" /><verse number="11" style="v" sid="EXO 29:11" />ಪಾಚ಼ಲ್ಯೊ ತು ತಿನೆ ಯಹೊವಾನಿ ಸನ್ನಿಧಿಮಾ ದೆವದರ್ಶನನಾ ಗುಡಾರನಾ ಬಾಕಲಮಾಜ಼ ಖಲಾಸ ಕರೌ. <verse eid="EXO 29:11" /><verse number="12" style="v" sid="EXO 29:12" />ತೆ ಬೈಲನಾ ರಗತಮಾನು ದಕ್ಹು ಲಿನ ಬೊಟಕ್ಹು ಯಜ್ಞವೆದಿನಾ ಶಿಂಗಡಾವೊನೆ ಲಗಾಡಿನ ಉಗ್ರಲ ಕ್ಹಾರಾ ರಗತನೆ ಯಜ್ಞವೆದಿನಾ ಹೆಟೊ ನಾಕು. <verse eid="EXO 29:12" /><verse number="13" style="v" sid="EXO 29:13" />ತಿನಾ ಮ್ಹೈನಾ ಅಂಗೊ ರ‍್ಹವಾನಾ ಕಲ್ಜು ಬೆ ಕಿಡ್ನಿನೆ ತ್ಯುನಾ ಉಪ್ಪರ ರ‍್ಹವಾನಿ ಚರ್ಬಿನೆ ಲಿನ ಯಜ್ಞವೆದಿನಾ ಉಪ್ಪರ ಹೊಮಾ ಕರು. <verse eid="EXO 29:13" /><verse number="14" style="v" sid="EXO 29:14" />ಬೈಲನಾ ಮಾಕ್ಹನೆ, ಚಾಂಬಡಾನೆ ವರಿ ಅತ್ತೊಡಾ ಪಾಳೆಯನಾ ಭಾರಾ ಆಗಕ್ಹು ಬಾಳಿಪಡು. ಕಾಕದ್ಯಾಮ ಎ ದೊಶಪರಿಹಾರಕ ಯಜ್ಞ ವ್ಹೈ. <verse eid="EXO 29:14" /><verse number="15" style="v" sid="EXO 29:15" />ಪಾಚ಼ಲ್ತೊ ತು ತೆ ಟಗರೊಮಾನು ಯಕ್ಕ ಲಿನ ಆರೊನ ತಿನಾ ಬಚ಼್ಚಾ ತಿನಾ ಮಾತಾನಾ ಉಪ್ಪರ ತ್ಯುನಾ ಹತೊ ಮ್ಹೆಲು. <verse eid="EXO 29:15" /><verse number="16" style="v" sid="EXO 29:16" />ತು ತಿನೆ ಲಿನ ತಿನಾ ರಗತನೆ ಯಜ್ಞವೆದಿನಾ ಚಾರೆ ಬಗಲಬಿ ಚಪಡು. <verse eid="EXO 29:16" /><verse number="17" style="v" sid="EXO 29:17" />ತೆ ಥಯಲ್ಪರ ತು ತೆ ಟಗರನೆ ತುಕ್ಡಾ ಕತ್ರಿನ ತಿನಾ ಅತ್ತೊಡಾವೊನೆ, ಪಗೊನೆ ಧ್ಯಲಿನ ತಿನಾ ತುಕ್ಡಾವೊನೆ, ಮುಂಡಿನೆ ಕ್ಹಾತೆ ಮ್ಹೆಲ್ಯೂ. <verse eid="EXO 29:17" /><verse number="18" style="v" sid="EXO 29:18" />ತೆ ಕ್ಹಾರು ಯಜ್ಞವೆದಿನಾ ಉಪ್ಪರ ಯಹೊವಾನೆ ಭುಂಜಿಲೆ ಬಲಿ ಥೈನ ಮ್ಹೆಲ್ಯೂ. ಆ ಯಹೊವಾನೆ ಚೊಕಿ ಬಾಸನೂ ಹೊಮಾ ಥಯುಸ. <verse eid="EXO 29:18" /><verse number="19" style="v" sid="EXO 29:19" />ತೆ ಥಯಲ್ಪರ ತು ಬೆವಾ ಟಗರನೆ ಕಾಡಿಲಿನ ಆರೊನಬಿ ತಿನಾ ಬಚ್ಚಾ ತಿನಾ ಮಾತಾನಾ ಉಪ್ಪರ ತುಮಾರಾ ಹತೊನೆ ಮ್ಹೆಲ್ಯೂ. <verse eid="EXO 29:19" /><verse number="20" style="v" sid="EXO 29:20" />ತೆ ಥಯಲ್ಪರ ವದಸಿನ ತಿನು ರಗತಮಾ ದಕ್ಹು ಆರೊನಾ ವರಿ ತಿನಾ ಬಚ್ಚಾನಾ ಸಿದಾ ಕಾನನಾ ತುದಿನೆ ಸಿದಾ ಹತ್ತನಾ ಹೆಬ್ಬೊಟನೆ, ಸಿದಾ ಪಗ್ಗನಾ ಹೆಬ್ಬೊಟನೆ ಲಗಾಡಿನ, ಉಗ್ರಲ ರಗತನೆ ಯಜ್ಞವೆದಿನಾ ಸುತ್ತೆಬಿ ಚುಪಡು. <verse eid="EXO 29:20" /><verse number="21" style="v" sid="EXO 29:21" />ತೆ ನೈಸೊ ತು ಯಜ್ಞವೆದಿನ ಉಪ್ಪರ ರ‍್ಹವಾನು ರಗತಮಾಬಿ, ಅಬಿಷೆಕನಾ ತೈಲಮಾಬಿ ದಕ್ಹು ಕಾಡಿಲಿನ ಆರೊನಬಿ ವರಿ ತಿನಾ ಟುವಾಲೊ ತಿನಾ ಬಚ್ಚಾ ವರಿ ತ್ಯುನಾ ಟುವಾಲೊ ಉಪ್ಪರಬಿ ಚೂಪಡು. ಅಮ್ಮಜ ತೆ ವರಿ ತಿನಾ ಬಚ್ಚಾ ತ್ಯುನಾ ಟುವಾಲೊಬಿ ಪರುಶುದ್ದ ಥಾವಸ. <verse eid="EXO 29:21" /><verse number="22" style="v" sid="EXO 29:22" />ಪ್ರತಿಷ್ಠೆನಾಹುತಿ ಸಮರಪಿಸ ಕರಲ ಟಗರ ಥಯಲಕ್ಹು ತಿನಾ ಚರಬಿನೆ ಕದ್ಯಾಮ ಪುಚಡಿನಾ ಚರಬಿನೆ, ಪಿತ್ತಕೊಶನಾ ಉಪ್ಪರಲಿ ಚರಬಿನೆ, ಭಂಬೆ ಮೂತ್ರ ಕೊಶೊನೆ ತಿನಾ ಉಪ್ಪರಲಿ ಚರಬಿನೆ ತಿಮ್ಮಜ಼ ಸಿದಾ ಮಾಂಡಿನೆ, <verse eid="EXO 29:22" /><verse number="23" style="v" sid="EXO 29:23" />ವರಿ ಯಹೊವಾನಾ ಕ್ಹಾಮಾ ಥೈನ ಟೊಪ್ಲಿಮಾ ಮ್ಹೆಲಲ ಕ್ಹಾಟೂ ನೈ ರ‍್ಹಯಲ ಪದಾರ್ಥತೊಮಾ ಯಕ್ಕ ರೊಕ್ಲಾನೆ , ತೆಲನು ರ‍್ಹಯಲ ಯಕ್ಕ ಪೊಳಿನೆ ವರಿ ಯಕ್ಕ ಕನೂಲಾನೆ ಕಾಡಿಲಿನ, <verse eid="EXO 29:23" /><verse number="24" style="v" sid="EXO 29:24" />ತೆ ಕ್ಹಾರು ಆರೊನಾ ವರಿ ತಿನಾ ಬಚ್ಚಾನಾ ಹತ್ಮಾ ದಿನ ಯಹೊವಾನಾ ಸನ್ನಿದಿಮಾ ಯೆಡಿ ಚಡೌ. <verse eid="EXO 29:24" /><verse number="25" style="v" sid="EXO 29:25" />ತೆ ಥಯಲ್ಪರ ತೆ ಕ್ಹಾರು ತ್ಯುನಾ ಹತ್ತಕ್ಹು ಕಾಡಿಲಿನ ಯಜ್ಞವೆದಿನಾ ಉಪ್ಪರ ನಯೆ ಹೊವಾನಾಹುತಿ ಬಾಳು. ತೆ ಯಹೊವಾನೆ ಚೊಕಿ ಬಾಸನಿ ಹೊಮಾ ಥಯುಸ. <verse eid="EXO 29:25" /><verse number="26" style="v" sid="EXO 29:26" />ವರಿ ಆರೊನಬಿ ಪಟ್ಟಾ ಅಭಿಶೆಕನಾಹುತಿ ಪ್ರತಿಷ್ಠ ಕರಲ ಟಗರನಾ ಛಾತಿನಾ ಭಾಗನೆ ಕಾಡಿಲಿನ ತೆ ಯಹೊವಾನಾ ಸನ್ನಿದಿಮಾ ಉತಾರು. ತೆ ತುನೆ ಸಲ್ಲಾನು ಪಾಲ ಥಾವಸ. <verse eid="EXO 29:26" /><verse number="27" style="v" sid="EXO 29:27" />ಆರೊನನೆಬಿ ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆಬಿ ಪ್ರತಿಷ್ಠೆ ಕರ್ತಾಮಾ ಚಡಾಯಲ ಟಗರನಾ ಮಾಕ್ಹಮಾ ಉತಾರಿನ ಛಾತಿನಾ ಭಾಗನೆ ಯಾಜಕನಾ ಭಾಗನೆ ದಿದಲ ಮಾಂಡಿನೆ ಕ್ಹುದಾನು ವ್ಹೈಕೈನ ಬಾವಿಸಿಲ್ಯೂ. <verse eid="EXO 29:27" /><verse number="28" style="v" sid="EXO 29:28" />ಶಾಶ್ವತ ನಿಯಮ ಥಯಲ ಇಸ್ರಾಯೆಲೊ ತಿನೆ ಆರೊನನೆಬಿ ತಿನಾ ಕ್ಹಾಂದಾನಾವಾಲಾನೆಬಿ ದಿವಾನು ವ್ಹೈ. ತೆ ಯಾಜಕೊನೆ ಭಾಗನೆ ಮ್ಹೆಲಲ ಛೆ. ಇಸ್ರಾಯೆಲೊ ಸಮಾಧಾನನಾ ಯಜ್ಞನಾಹುತಿ ಪಶುವೊನೆ ಮ್ಹೆಲಿನ ಯಹೊವಾನೆ ಯೆಡಿ ಕರ್ತಾ ಟೈಮ್ಮಾ ತೆ ಭಾಗೊನೆ ಯಾಜಕೊನಾಹುತಿ ಕಾಡಿನ ಮ್ಹೆಲ್ಯೂ. <verse eid="EXO 29:28" /><verse number="29" style="v" sid="EXO 29:29" />ಆರೊನಾ ಪವಿತ್ರ ಥಯಲ ಯಾಜಕದಿಕ್ಷಾನಾ ಟುವಾಲೊ ತಿನಾ ವರಿ ತಿನಾ ಖಾಂದಾನವಾಲಾನೆ ಉಪಯೊಗ ಥಯು. ತ್ಯುನೆ ತಿಮಾಜ ಮಾರಾಹುತಿ ಅಬಿಷೆಕ ಕರಿನ ಪ್ರತಿಷ್ಠಕರು. <verse eid="EXO 29:29" /><verse number="30" style="v" sid="EXO 29:30" />ತಿನಾ ಬಚ್ಚಾವೊಮಾ ತಿನೆ ಬದಲ ಮಹಾ ಯಾಜಕ ಥಾವಸ ಪವಿತ್ರ ಜ಼ಗಾಮಾ ಕ್ಹುದಾನಿ ಸೆವಾನೆ ಚಲಾಡಾನಾಹುತಿ ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಝೊಪ್ಡಾಮಾ ಪ್ರವೆಸ ಕರಲಕ್ಹು ಕ್ಹಾತ ದಿನ್ನಲಕ್ಕಾ ತೆ ವಣ್ಣಾ ಘಾಲ್ಲಿ ಲಿದಲ ರ‍್ಹೌ. <verse eid="EXO 29:30" /><verse number="31" style="v" sid="EXO 29:31" />ಆರೊನಬಿ ಪ್ರತಿಷ್ಠನಾಹುತಿ ಚಡಾಯಲ ಟಗರನಾ ಮಾಕ್ಹನೆ ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಝೊಪ್ಡಾನಾ ಅಂಗಳಮಾ ಚಡೌ. <verse eid="EXO 29:31" /><verse number="32" style="v" sid="EXO 29:32" />ಆರೊನಬಿ ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆಬಿ ತೆ ಟಗರನಾ ಮಾಕ್ಹನೆ ಟೊಪ್ಲಿಮಾ ರ‍್ಹವಾನು ರೊಕ್ಲಾನೆ ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಝೊಪ್ಡಾನಾ ಬಾಕಲನಾ ಮ್ಹೈ ಕ್ಹೌ. <verse eid="EXO 29:32" /><verse number="33" style="v" sid="EXO 29:33" />ತ್ಯುನೆ ಯಾಜಕೊನಾಹುತಿ ಕರಲ ತ್ಯುನಾ ಪಾಪನಾ ನಿವಾರಣಾಹುತಿ ಎ ಕ್ಹಾರು ಚಡಯಾ. ತಿನಾಹುತಿ ತೆ ಕ್ಹಾರು ಚಡಾಯಲ ಕ್ಹಾಲಿ ತ್ಯುನೆ ಕ್ಹೌ ತೆನೈಸೊ ಬಿಜಾ಼ ಕ್ಹೌ ನೈ; ಕಾ ಕದ್ಯಾಮ ತೆ ಪರುಶುದ್ದ ಥಯಾಸ ವರಿ ನೆಮ್ಸಲ ಥಯಾಸ. <verse eid="EXO 29:33" /><verse number="34" style="v" sid="EXO 29:34" />ಟಗರನು ಮಾಕ್ಹ ತೆ ನೈಸೊ ರೊಕ್ಲಾವೊನೆಬಿ ಅಗಲ್ಯಾ ದಿನ ಪಾಟಲಕ್ಕಾ ಉಗ್ಯ್ರಾಮ ತಿನೆ ಬಾಳಿ ಪಡು. ತುಮೆ ತೆ ರೊಕ್ಲಾನೆ ರ‍್ಹೈತಬಿ ಮಾಕ್ಹನೆ ರ್ಹೈತಬಿ ಕ್ಹೌ ನೈ. ಕಾ ಕದ್ಯಾಮ ಕ್ಹಾಲಿ ತಿನೆ ಕ್ಹಾಸ ಸಂದರ್ಭಮಾ ಕ್ಹಾಸ ತರಿಕಾಮಾ ಕ್ಹೌ. <verse eid="EXO 29:34" /><verse number="35" style="v" sid="EXO 29:35" />ಮಿ ತ್ಯುನೆ ಆಜ್ಞಾ ಕರಲ ಆಕ್ಹಾರು ಆರೊನ ವರಿ ತಿನಾ ಬಚ್ಚಾನಾಹುತಿ ಕರ ತ್ಯುನೊನೆ ಯಾಜಕ ಕೈನ ನೆಮ್ಸಾನೆ ಕಾರ್ಯಕ್ರಮ ಕ್ಹಾತ ದಿನ್ನ ಲಕ್ಕಾ ಚಾಲು. <verse eid="EXO 29:35" /><verse number="36" style="v" sid="EXO 29:36" />ಕ್ಹಾತ ದಿನ ಲಕ್ಕಾ ಹರಯಕ್ಕ ದಿನ್ನೆ ಬೈಲನೆ ಬಲಿ ದಿನ. ಆ ಆರೊನನಾ ವರಿ ತಿನಾ ಬಚ್ಚಾವೊನಾ ಪಾಪ ನಿವಾರಣೆನಾ ಚಡಯಲ ರ‍್ಹವಸ. ತೆ ನೈಸೊ ಯಜ್ಞವೆದಿನೆ ಪರಶುದ್ದ ಕರಾನು ತಿನಾ ಉಪ್ಪರ ದೊಷನಾ ಪರಹಾರ ಯಜ್ಞನೆ ಚಡಾಯಲ ತಿನೆ ಕ್ಹುದಾನಾ ಸೆವೆನಾಹುತಿ ಅಬಿಶೆಕ ಕರು. <verse eid="EXO 29:36" /><verse number="37" style="v" sid="EXO 29:37" />ಅಮ್ಮಜ ಕ್ಹಾತ ದಿನ್ನ ಲಕ್ಕಾ ಯಜ್ಞವೆದಿಕೆನೆ ಶುದ್ದ ಕರಿನ ಪವಿತ್ರ ಕರು. ತೆ ಟೈಮಾ ಯಜ್ಞವೆದಿಕೆಬಿ ಮಹಾ ಪವಿತ್ರ ಥಾವಸ. ಯಜ್ಞವೆದಿಕೆನೆ ಮುಟ್ಟಲ ಕ್ಹಾರು ಪವಿತ್ರ ಥಾವಸ.<verse eid="EXO 29:37" /></para>
  <para style="s">ಹರಯಕ್ಕ ದಿನ್ನನಿ ಬಲಿ</para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38" />ಯಜ್ಞೆದಿನಾ ಉಪ್ಪರ ಹರದಿನ ಬಲಿ ಚಡೌ. ಯಕ್ಕ ವರಕ್ಹನಾ ಬೆ ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ವೊನೆ ತು ಚಡೌ. <verse eid="EXO 29:38" /><verse number="39" style="v" sid="EXO 29:39" />ಪಾಟೆ ಯಕ್ಕ ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ನೆ ವರಿ ಕ್ಹಾಂಜೆ ಹಜಿಯಕ್ಕ ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ನೆ ಚಡೌ. <verse eid="EXO 29:39" /><verse number="40" style="v" sid="EXO 29:40" />ತು ಪೈಲಾನಾ ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ನೆ ಚಡಾತಾಮಾ ತನ್ನ ಸೆರ ಚೊಕಾ ಘೌನಾ ಲೊಟನೆ ಚಡೌ. ಯಕ್ಕ ಶೆರ ಒಲಿವ ತೆಲ ಮಳೈನ ತೆ ಲೊಟನೆ ದೆಡ ಸೆರ ದ್ರಾಕ್ಷಿನಾ ರಕ್ಹನೆ ಘಾಲು. <verse eid="EXO 29:40" /><verse number="41" style="v" sid="EXO 29:41" />ತು ಕ್ಹಾಂಜ಼ನಾ ಟೈಮಾ ಹಜಿಯಕ್ಕ ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ನೆ ಚಡಾತಾಮ ತನ್ನ ಸೆರ ಚೊಕಾ ಘೌನೆ ವರಿ ಅರ್ದಾ ಸೆರ ದ್ರಾಕ್ಷಿನಾ ರಕ್ಹನೆ ಚಡಾ. ಆ ಯಹೊವಾನೆ ಚೊಕೊ ಹೊಮ ಥಾವಸ. <verse eid="EXO 29:41" /><verse number="42" style="v" sid="EXO 29:42" />ತು ಹರ ದಿನ್ನೆ ಆ ಸರ್ವಾಂಗ ಹೊಮನೆ ಚಡಾವಾನಾಹುತಿ ಚಡೌ. ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಝೊಪ್ಡಾನಾ ಬಾಕಲಮಾ ಯಹೊವಾನಾ ಕ್ಹಾಮೊ ಆ ಕರ. ತು ಚಡಾತಾಮಾ ಯಹೊವಾ ಥಯಲ ಮಿ ತ್ಯಾ ತುನೆ ಮಳಿನ ತಾರಾಕ್ಹಾತೆ ಬೊಲುಸ. <verse eid="EXO 29:42" /><verse number="43" style="v" sid="EXO 29:43" />ತೆ ಜ಼ಗಾಮಾ ಮಿ ಇಸ್ರೆಲನೆ ಮಳುಸ. ಮಾರಾ ಪ್ರಬಾವಾಕ್ಹು ತೆ ಜ಼ಗಾ ಪವಿತ್ರ ಥಾವಸ. <verse eid="EXO 29:43" /><verse number="44" style="v" sid="EXO 29:44" />ತೆ ನೈಸೊ ಮಿ ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಝೊಪ್ಡಾನೆ ವರಿ ಯಜ್ಞವೆದಿನೆ ಪವತ್ರ ಕರುಸ. ಆರೊನಬಿ ವರಿ ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆಬಿ ಪವಿತ್ರ ಕರುಸ; ತೆಳಾಮಾ ತ್ಯುನೆ ಯಾಜಕೊನೆ ಮನೆ ಸೆವಾ ಕರಾನೆ ತಾಕತವಾಲಾ ಥಾವಸ. <verse eid="EXO 29:44" /><verse number="45" style="v" sid="EXO 29:45" />ಮಿ ಇಸ್ರಾಯಲನಾ ವಚ್ಮಾ ರ‍್ಹೌಸ ವರಿ ತ್ಯುನೊ ಕ್ಹುದಾ ಥೈನ ರ‍್ಹೌಸ. <verse eid="EXO 29:45" /><verse number="46" style="v" sid="EXO 29:46" />ಮಿ ತ್ಯುನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಥೊಸ ಕೈನ ಮನಕ್ಹೊ ತಿಳ್ದಿಲಿವಸ. ತ್ಯುನಾ ವಚ್ಮಾ ರ‍್ಹವಾನಾಹುತಿ ಇಜಿಪ್ಟ ತ್ಯುನೊನೆ ಬಲೈಲಿನ ಆಯಲವಾಲೊ ಮಿಜ಼ ವ್ಹೈ ಕೈನ ತ್ಯುನೆ ತಿಳ್ದಿಲಿವಸ. ಮಿ ತ್ಯುನಾ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ.<verse eid="EXO 29:46" /></para>
  <chapter eid="EXO 29" />
  <chapter number="30" style="c" sid="EXO 30" />
  <para style="s">ಉದನೆ ಬಾಳಾನು ಬಲಿನೊ ಕಟ್ಟೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1" />ತೆನೈಸೊ ಬಾಸನಾ ತೆಲಕ್ಹು ಕಾಟಾವೊನಾ ಝಾಡನು ಉದನೊ ಧವಾಂಡೊ ದಿವಾನಾಹುತಿ ಯಕ್ಕ ಕಟ್ಟೊ ಭಾಂದ. <verse eid="EXO 30:1" /><verse number="2" style="v" sid="EXO 30:2" />ಯೆ ಕಟ್ಟಾನಾ ಸುತ್ತೆ ಯಕ್ಕ ಮಳಾ ಲಾಂಬಾಮಾ, ಯಕ್ಕ ಮೊಳ ರುಂದ, ಬೆ ಮೊಳಾ ಉಚ್ಚು ರxಹೌ. ತಿನಾ ಚಾರೆ ಮೂಲಾವೊಮಾ ಶಿಂಗ್ಡಾವೊ ರ್ಹೌ. ಆ ಶಿಂಗ್ಡಾ ತೆ ಕಟ್ಟಾನಾ ಭಾಗ ಥೈನ ರ್ಹೌ. <verse eid="EXO 30:2" /><verse number="3" style="v" sid="EXO 30:3" />ಧವಾಂಡಾನಾ ಕಟ್ಟಾನಾ ಉಪ್ಪರಲ್ಯಾ ಭಾಗನೆ ಶಿಂಗ್ಡಾನಾ ತುದಿಯೊನೆ ತಿನಾ ಶಿಂಗ್ಡಾವೊನೆ ಚೊಕಾ ಕ್ಹೊನಾನಾ ತಗಡೊಕ್ಹೊ ಝಾಕು ವರಿ ಸುತ್ತೆಬಿ ಕ್ಹೊನಾನೊ ಕಟ್ಟೊ ಭಂದೌ. <verse eid="EXO 30:3" /><verse number="4" style="v" sid="EXO 30:4" />ಧುವಾಂಡೊನಾ ಕಟ್ಟಾನಾ ಆಜು಼ ಬಾಜು಼ ಥೈಯಲ ಭಂಬೆ ಗೊಡಿಯೊಮಾ ಕಟ್ಟನಾ ಹೆಟಾ ಬೆ ಕ್ಹೊನಾನಾ ಬೆ ಭಾಂಗ್ಡೊಯೊನೆ ಕರೌ. ಧುವಾಂಡಾನಾ ಕಟ್ಟನಾ ಉಚಾವಾನಾ ಲಾಕ್ಡಿಯೊ ಆ ಬಾಂಗ್ಡಿಯೊ ಧರ್ಲಿಲಿದಲ ರ‍್ಹವಸ. <verse eid="EXO 30:4" /><verse number="5" style="v" sid="EXO 30:5" />ಲಾಕ್ಡಿಯೊ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಕರೌ. ಕ್ಹೊನಾನಾ ತಗ್ಡೊಕ್ಹು ತೆ ಲಾಕ್ಡಿಯೊ ವರಾಡು. <verse eid="EXO 30:5" /><verse number="6" style="v" sid="EXO 30:6" />ಚೊಕಾ ಪಡ್ದಾನಾ ( ಒಡಂಬಡಿಕೆನಾ ಪಟ್ಟಗಿನಾ ಸೆುತ್ತೆ ರ‍್ಹಯಲ) ಕ್ಹಾಮಲ್ಯಾ ಬಾಗಮಾ ಧವಾಂಡಾನಾ ಕಟ್ಟಾನಾ ಮ್ಹೆಲ. ಧವಾಂಡಾನಾ ಕಟ್ಟಾನಾ ಒಡಂಬಡಿಕೆನಾ ಪೆಟಗಿನಾ ಕೃಪಾಸನನಾ ಕ್ಹಾಮಲ್ಯಾ ಭಾಗಮಾ ರ‍್ಹವಸ. ಆ ಮಿ ತುನೆ ದಿವಾನಿ ಜ಼ಗಾ ಥಯಿಸ. <verse eid="EXO 30:6" /><verse number="7" style="v" sid="EXO 30:7" />ಆರೊನ ದಿನ್ನೆ ಪಾಟೆ ಕಟ್ಟಾನಾ ಉಪ್ಪರ ಚೊಕು ಬಾಸನು ಉದ ಘಾಲು. ತಿನಾ ದಿವಾವೊನೆ ಕರೆಟ್ಟ ಕರಾನೆ ಆತಾಮಾ ಆ ಕರುಸ. <verse eid="EXO 30:7" /><verse number="8" style="v" sid="EXO 30:8" />ಫರಿನ ಕ್ಹಾಂಜ಼ನಾ ಟೈಮಾ ಉದನೆ ಘಾಲು. ಆ ಕ್ಹಾಂಜ಼ನಾ ಟೈಮೊಮಾ ತೆ ದಿವಾ ಲಗಾಡಾನೊ ಟೈಮ ಥಯಲ ರ‍್ಹವಸ. ಅಮ್ಮಜ ದಿನ್ನೆಬಿ ಯಹೊವಾನಾ ಕ್ಹಾಮೂ ಚೊಕು ರ‍್ಹಯಲ ಉದನೂ ಧೂವಾಂಡೊ ರ‍್ಹವಸ. <verse eid="EXO 30:8" /><verse number="9" style="v" sid="EXO 30:9" />ಆ ಕಟ್ಟಾನೆ ಬಿಜಾ಼ ಧುವಾಂಡಾನಾ ಬಲಿನಾಹುತಿ ರ‍್ಹವಾದೆ ಜಾನವರೊನಿ ಸರವಾಂಗೊ ಹೊಮನೆ ದಿವಾನಾಹುತಿ ರ‍್ಹವಾದೆ ಕಯಾಜ಼ ಅನ್ನ ಪಾನನಾ ಕಯಾಜ಼ ಎಡಿನಾ ಹುತಿ ಉಪಯೊಗ ಕರು ನೈ. <verse eid="EXO 30:9" /><verse number="10" style="v" sid="EXO 30:10" />ಆರೊನ ವರಕ್ಹಾ ಯಕ್ಕೆಮ ಯಹೊವಾನೆ ಚೊಕು ಯಜ್ಞನೆ ಚಡೌ. ಮನಕ್ಹೊನಾ ಪಾಪನ ಪಶ್ಚಾತಾಪನಾ ಹುತಿ ಆರೊನಬಿ ದೊಷನಾ ಪರಿಹಾರನಾಹುತಿ ಯಜ್ಞನಾ ರಗತನೆ ಉಪಯೊಗ ಕರಸ. ಆರೊನ ಆ ಯಜ್ಞವೆದಿಕೆನಾ ಶಿಂಗ್ಡಾವೊಮಾ ಕರಸ. ತೆ ದಿನ್ನೆ ದೊಷಪರಿಹಾರನಾ ದಿನ ವ್ಹೈ ಕೈನ ಕವೈಲಿವಸ. ಯಹೊವಾನೆ ಆ ಅತಿ ಪರಿಶುದ್ದ ಥಯಲ ಚೊಕೊ ದಿನ ಥಯೊಸ.<verse eid="EXO 30:10" /></para>
  <para style="s">ಯಹೊವಾನಿ ಗುಡಾರನಿ ತೆರಗೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11" />ಯಹೊವಾ ಮೊಶೆನೆ ಕದಲ ಸುವೈ ಕದ್ಯಾಮ: <verse eid="EXO 30:11" /><verse number="12" style="v" sid="EXO 30:12" />ಇಸ್ರೆಲನೊ ಲಕ್ಕಾ ಕರಾ. ಅಮ್ಮ ಥೈನ ಕೆಕ್ಲಾ ಜ಼ನಾ ಮನಕ್ಹೊ ರ‍್ಹವಸ ಕೈನ ತು ತಿಳ್ಇಲೆಸಿ. ಹರಸಲಾ ಆ ಕರ್ತಾಮಾ, ಹರಯಕ್ಲೊ ತಿನಾಹುತಿಜ಼ ಯಹೊವಾನೆ ತೆರಿಗೆನೆ ದ್ಯೂ. ತೆಳಾಮಾ ಮನಕ್ಹೊನೆ ಕಯಾಜ಼ ತ್ರಾಸವೊ ಥಾತಾನೈ. <verse eid="EXO 30:12" /><verse number="13" style="v" sid="EXO 30:13" />ಲಕ್ಕಾ ಕರಲ ಹರಯಕ್ಲೊ ಅದಿಕೃತನಾ ಅಳತಿನಾ ನಿಂಗತ ಇಕ್ಹ ‘ಗೆರಾ’ ಅಳತಿನಾ ದೊಕ್ಡಾನಾ ನಿಂಗತ ಅರ್ದು ಶೆಕೆಲ ಕಾಣಿಕೆ ದ್ಯೂ. ಆ ಅರ್ಧಾ ಅಕ್ಲು ಯಹೊವಾನೆ ಪವಿತ್ರ ಕಾಣಿಕೆ ಥಯಲ ರ‍್ಹವಸ. <verse eid="EXO 30:13" /><verse number="14" style="v" sid="EXO 30:14" />ಲೆಕ್ಕಾ ಕರಲವಾಲೊಮಾ ಇಕ್ಹ ವರಕ್ಹವಾಲಾ ತಿನಾತಿ ಹೆಚ್ಕಿ ರ‍್ಹಯಲ ಆ ಕಾಣಿಕೆನೆ ಯಹೊವಾನೆ ದ್ಯೂ. <verse eid="EXO 30:14" /><verse number="15" style="v" sid="EXO 30:15" />ಸವಕಾರ ರ‍್ಹಯಲವಾಲಾ ಅರ್ದಾ ನಂಗತ ಹೆಚ್ಕಿ ದ್ಯಯೂ ನೈ; ಗರಿಬ ಮನಕ್ಹೊ ಅರ್ದಾ ಅಕ್ಲು ಕಮ್ಮ ದ್ಯೂ ನೈ. ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಆ ಕಾಣಿಕೆನೆ ಯಹೊವಾನೆ ದ್ಯೂ. ಆ ತುಮಾರಾ ಜಿವನಾ ರಕ್ಷನೆಯ ತೆರಿಗೆ ಥಯುಸ. <verse eid="EXO 30:15" /><verse number="16" style="v" sid="EXO 30:16" />ಇಸ್ರೆಲಕ್ಹು ಆ ದೊಕ್ಡಾನೆ ಪೂರಾ ಜಮಾ ಕರು. ಕ್ಹುದಾನಾಾ ದರ್ಶನಾ ಝೊಪ್ಡಾನಾ ಸೆವೆನಾಹುತಿ ದೊಗ್ಡಾವೊನೆ ಉಪಯೊಗ ಕರು. ಯಹೊವಾ ತಿನಾ ಮನಕ್ಹೊನೆ ಸ್ಹೆ ಮ್ಹೆಲಾನಾಹುತಿ ಆ ಕಾಳು ಯಕ್ಕ ವಾಟ ಥಯಿಸ. ತ್ಯುನೆ ತ್ಯುನಾ ಜಿವನಾ ರಕ್ಷಣೆನಾಹುತಿ ದೊಕ್ಡಾ ದಿವಾವಾಲಾ.''<verse eid="EXO 30:16" /></para>
  <para style="s">ತಾಂಬಾನಿ ಪರಾತ</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17" />ಯಹೊವಾ ಮೊಶೆನೆ ಕದಲ ಸುವಯ ಕದ್ಯಾಮ: <verse eid="EXO 30:17" /><verse number="18" style="v" sid="EXO 30:18" />ತಾಂಬಾನೊ ಥಾಳೊ ಕರಿನ ತಿನೆ ತಾಂಬಾನಾ ಪಿಟನಾ ಉಪ್ಪರ ಮ್ಹೆಲ. ಕಾಡಿಲಿವಾನಾಹುತಿ ತುಮೆ ಆ ಉಪಯೊಗ ಕರೊಸಿ ಥಾಳಾನೆ ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಝೊಪ್ಡಾನಾ ವರಿ ಯಜ್ಞ ವೆದಿಕೆನಾ ವಚ್ಮಾ ಮ್ಹೆಲ. ಥಾಳಾಮಾ ಪಾನಿನೆ ಭರ. <verse eid="EXO 30:18" /><verse number="19" style="v" sid="EXO 30:19" />ಆರೊನ ವರಿ ತಿನಾ ಗಂಡ ಬಚ್ಚಾ ಆ ಥಾಳಾಮಾ ತುಮಾರಾ ಹತೊ ಪಗೊ ಧ್ಯಲಿಲಿವು. <verse eid="EXO 30:19" /><verse number="20" style="v" sid="EXO 30:20" />ಹರಸಲಾ ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಝೊಪ್ಡಾಮಾ ಜಾ಼ತಾ ಟೆಮಾ ನೈತೊ ಯಹೊವಾನಾಹುತಿ ಸರವಾಂಗ ಹೊಮನೆ ದಿವಾನೆ ಯಜ್ಞವೆದಿನಾ ಕ್ಹಾಮೊ ಆತಾಮಾ ತ್ಯುನೆ ಪಾನಿಕ್ಹು ಧ್ಯಲಿಲಿಯು. ತೆಳಾಮಾ ತ್ಯುನೆ ಮರತಾ ನೈ. <verse eid="EXO 30:20" /><verse number="21" style="v" sid="EXO 30:21" />ತ್ಯುನೆ ತ್ಯುನಾ ಹತೊ ಪಗೊ ಧ್ಯಲಿದ್ಯಾ ಬಗರ ಆಯಾರೆ ತ್ಯುನೆ ಮರಿ ಜಾ಼ವಸ. ಆರೊನನೆ ವರಿ ಕ್ಹಾಂದಾವಾಲಾನೆ ಆ ಶಾಶ್ವತ ಥಯಲ ನಿಯಮ ವ್ಹೈ. ಪಿಳಿಗೆ ಲಕ್ಕಾ ಆರೊನನಾ ಖಾಂದಾನವಾಲಾವೊನೆ ಕ್ಹಾರಾ ಎ ಆಜ್ಞಾ ರ‍್ಹವಸ.''<verse eid="EXO 30:21" /></para>
  <para style="s">ಅಬಿಷೆಕನು ತೆಲ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22" />ತೆ ಥಯಲ್ಪರ ಯೆಹೊವ ಮೊಶೆನೆ ಕದಲ ಸುವೈ ಕದ್ಯಾಮ: <verse eid="EXO 30:22" /><verse number="23" style="v" sid="EXO 30:23" />''ಚೊಕೊಥಯಲ ಬಾಸನೂ ತೆ ಕರಾ. ಛೆ ಕಿಲೊ ಅಕ್ಲು ಚೊಕೊ ರಕ್ತ ಬೊಳ, ತಿನಾ ಅರ್ದಾ ಅಕ್ಲು ಕದ್ಯಾಮ ತನ್ನ ಕಿಲೊ ಅಕ್ಲು ಲೊಂಗ ವರಿ ಚಕ್ಕಿನೆ ಲಿನ ಆ. ತನ್ನ ಕಿಲೊ ಅಕ್ಲು ಚೊಕು ಬಾಸ ರ‍್ಹಯಲ ಬಜೆ, ಛೆ ಕಿಲೊ ಚೊಕಿ ಬಾಸ ರ‍್ಹಯಲ ದಾಲ್ಚಿನಿ, <verse eid="EXO 30:23" /><verse number="24" style="v" sid="EXO 30:24" />ಆ ಕ್ಹಾರು ಅದಿಕೃತ ಅಳತಿನಾ ಮಾಪಕ್ಹು ಅಳತಿ ಕರ. ಛೆ ಕಿಲೊ ಆಲಿವನೂ ತೆಲ ಲಿನ ಆ. <verse eid="EXO 30:24" /><verse number="25" style="v" sid="EXO 30:25" />ಚೊಕಿ ಬಾಸ ರ‍್ಹಯಲ ಪವಿತ್ರ ಅಬಿಷೆಕನಾ ತೆಲನೆ ಕರಾನೆ ತೆ ಕ್ಹಾರು ಮಳಾ. <verse eid="EXO 30:25" /><verse number="26" style="v" sid="EXO 30:26" />ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಝೊಪ್ಡಾನೆ ವರಿ ಒಡಂಬಡಿನಕೆನಾ ಪೆಟ್ಟಿಗಿನೆ ಅಬಿಷೆಕ ಕರಾನೆ ಆ ತೆಲನೆ ಉಪಯೊಗಸ. <verse eid="EXO 30:26" /><verse number="27" style="v" sid="EXO 30:27" />ಆ ತೆಲನೆ ಮೆಜನಾ ಉಪ್ಪರ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಸಾಮ್ನೊನೆಪರ ವರಿ ದಿವೊ, ತಿನಾ ಸಾಮ್ನೊಪರ ಉದನಾ ಧವಾಂಡಾನಾ ಕಟ್ಟಾಪರ, <verse eid="EXO 30:27" /><verse number="28" style="v" sid="EXO 30:28" />ಕ್ಹುದಾನೆ ಆಗನಾ ಮೂಕಾಂತರ ದಿವಾನಾ ಬಲಿನಾ ಉಪ್ಪರ ತೆಲನೆ ರಿಚಾ. ಆ ತೆಲನೆ ಥಾಳಾನಾ ಉಪ್ಪರಬಿ ವರಿ ಥಾಳಾನಾ ಹೆಟಾ ರ್ಹಯಲ ಪಿಟನಾ ಉಪ್ಪರಬಿ ರಿಚಾ. <verse eid="EXO 30:28" /><verse number="29" style="v" sid="EXO 30:29" />ತೆಳಾಮಾ ತು ಆ ಸಾಮ್ನೊನೆ ಕ್ಹಾರಾ ಪವಿತ್ರ ಕರಸಿ. ತೆ ಯಹೊವಾನೆ ಘನೂ ಚೊಕು ಥಯುಸ. ತೆ ಸಾಮ್ನೊನೆ ಸೊಂಕೆಲ ಕ್ಹಾರು ಪವಿತ್ರ ಥಾವಸ. <verse eid="EXO 30:29" /><verse number="30" style="v" sid="EXO 30:30" />ಆರೊನಬಿ ತಿನಾ ಬಚ್ಚಾಬಿ ಆ ತೆಲಕ್ಹು ಅಬಿಷೆಕ ಕರ. ತ್ಯುನೆ ಚೊಕಾ ರಿತಿಮಾ ಮಾರಿ ಸೆವಾ ಕರಸ ಕೈನ ಆ ದೆಕ್ಲಾಡಸ. ತೆಳಾಮಾ ತ್ಯುನೆ ಅಬಿಷೆಕ ಕರಲ ಯಾಜಕೊನಾ ಹುತಿ ಮಾರಿ ಸೆವಾ ಕರಸಕೊಸಿ. <verse eid="EXO 30:30" /><verse number="31" style="v" sid="EXO 30:31" />ಅಬಿಷೆಕನೂ ತೆಲಬಿ ಪವಿತ್ರ ಥಯಲ ವ್ಹೈ ತಿನೆ ಮ ಕೆಳಾಮಾಬಿ ಮನೆ ಯಕ್ಲಾನೆಜ ಉಪಯೊಗ ಕರು ಕೈನ ಇಸ್ರಾಯೆಲೊನೆ ಕೆ. <verse eid="EXO 30:31" /><verse number="32" style="v" sid="EXO 30:32" />ಕುನಬಿ ಅನೆ ಸಾಮನ್ಯ ಥಯಲ ಚೊಕು ಬಾಸನೂ ಥಯಲ ತೆಲ ಥಯಲ ಉಪಯೊಗ ಕರು ನೈ. ಕ್ಹಾಸ ಬಾಸನೂ ತೆಲನೆ ಕರಾನಾ ತರಿಕಾಮಾ ಮಾಮೂಲಿ ಥಯಲ ಬಾಸನೂ ತೆಲನೆ ಕರು ನೈ. ಆ ತೆಲಬಿ ಪವಿತ್ರ ಥಯಲ ವ್ಹೈ. ಆ ತುಮೊನೆ ಘನ್ನು ಕ್ಹಾಸ ಥಯಲ ರ‍್ಹೌ. <verse eid="EXO 30:32" /><verse number="33" style="v" sid="EXO 30:33" />ಕುನಬಿ ಚೊಕಿ ಬಾಸನೂ ತೆಲನೆ ಆ ಪವಿತ್ರ ತೆಲ ನಿಂಗತ ಕರಿನ ಯಾಜಕ ನೈ ರ‍್ಹಯಲ ಯಕ್ಲಾನೆ ತಿನೆ ದಿದ್ಯಾರೆ. ತಿನೆ ತಿನಾ ಜಾ಼ತಾ ಬ್ಹಾರಾ ಕಾಡೂ. <verse eid="EXO 30:33" /><verse number="34" style="v" sid="EXO 30:34" />ಕ್ಹುದಾ ಮೊಶೆ ಸು ಆಗನ್ಯಾ ದಿದ್ಯೊ ಕದ್ಯಾಮ ತು ದುದ್ದ ಗುಗ್ಗುಲ ಗಂದಾನಿ ಛೆಕ್ಕಿ ಕವಾನು ದ್ರವ್ಯನೆವರಿ ಶುದ್ದ ರ‍್ಹಯಲ ಧವಾಂಡೊ ಯಕ್ಕ ಸಮಾ ಲಿನ ಸುವಾಸನೆ ರ‍್ಹಯಲ ಬುಕ್ಕಿರ ರ‍್ಹಯಲನಿಂಗತ <verse eid="EXO 30:34" /><verse number="35" style="v" sid="EXO 30:35" />ಪರಿಮಳ ದ್ರವ್ಯವಾಲಾ ಕರಲನಿಂಗತ ಕಲಾವೊ ಮಿಟ್ಟು ಘಾಲಿನ ಕ್ಹುದಾನಿ ಸೆವೆನೆ ಶುದ್ದ ರ‍್ಹಯಲ ಧುಪ ದ್ರವ್ಯ ಕರೌ. <verse eid="EXO 30:35" /><verse number="36" style="v" sid="EXO 30:36" />ತಿಮಾ ದಕ್ಹು ಪುಡಿ ಕರೈನ ಕ್ಹುದಾನು ದರ್ಶನನಾ ಗುಡಾರಮಾ ಆಜ್ಞಾಶಾಸನ ರ‍್ಹಯಲ ಮಂಜುಸನಾ ಕ್ಹಾಮಾ ಮಿ ತುನೆ ದಿಕ್ಹಾನಾ ಜಗಾಪರ ಮ್ಹೆಲು. <verse eid="EXO 30:36" /><verse number="37" style="v" sid="EXO 30:37" />ತುಮೆ ತೆ ಧುಪ ದ್ರವ್ಯನು ಪದ್ದತನಿಂಗತ ತುಮಾರಾ ಸ್ವಂತ ಉಪಯೊಗನಾ ನಿಂಗತ ದುಪ ದ್ರವ್ಯ ಕರಾವೌಜ಼ ನೈ. ತೆ ಕ್ಹುದಾ ಥಯಲ ಮಾರಾ ಸೆವೆನೆ ಉಪಯೊಗ ಕರಾನು ರ‍್ಹಯಲ ಮಿಸಲ ವ್ಹೈ ಕೈನ ತಿಲದಿಲಿದಲ ರ‍್ಹೌ. <verse eid="EXO 30:37" /><verse number="38" style="v" sid="EXO 30:38" />ಕ್ಹಾಲಿ ಸುವಾಸನೆ ಹುತಿ ಕರಿಲಿವಾಲಾನೆ ತೆವಾನೆ ಖಾಂದಾನಮಾತಾ ಬಹಿಶ್ಕಾರ ಕರು.<verse eid="EXO 30:38" /></para>
  <chapter eid="EXO 30" />
  <chapter number="31" style="c" sid="EXO 31" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1" />ಪಾಚ಼ಲ್ತೊ ಯಹೊವಾ ಮೊಶೆನೆ ಅಮ್ಮ ಕದ್ಯೊ: <verse eid="EXO 31:1" /><verse number="2" style="v" sid="EXO 31:2" />"ಮಿ ಯಹುದ ಕುಲಮಾತೊ ಉರಿಯನೊ ದಿಕ್ರೊ ಥಯಲ ಬೆಚೇಲನೆ ಇನಿಲಿದ್ಯೊಸ. ಉರಿ ಹುರನೊ ದಿಕ್ರೊ ವ್ಹೈ. <verse eid="EXO 31:2" /><verse number="3" style="v" sid="EXO 31:3" />ಮಿ ಬೆಚೆಲನೆ ಕ್ಹುದಾನಿ ಆತ್ಮಾಕ್ಹು ಭರ್xಯೊಸ. ಮಿ ತಿನೆ ಕ್ಹಾರಾ ತರಾನಾ ಕಾಮೊ ಕರಾನೆ ತಾಕತ ಗ್ಯಾನ ದಿದ್ಯೊಸ. <verse eid="EXO 31:3" /><verse number="4" style="v" sid="EXO 31:4" />ಬೆಚೆಲ ಘನ್ನೊ ಚೊಕೊ ಚಿತ್ರಾ ಕಾಡಾಲೊ ಥಯೊಸ. ಕ್ಹೊನು ರುಪ್ಪಾನು ವರಿ ತಾಂಬಾನಾ ಸಾಮನೊ ತೆ ಕರಸ. <verse eid="EXO 31:4" /><verse number="5" style="v" sid="EXO 31:5" />ತೆ ರತ್ನ ಕೆತ್ತಿನ ಚೊಕಾ ಸಾಮನೊ ಕರಸ ವರಿ ಝಾಡನಾ ಕಾಮೊಬಿ ಕರಸ. ತೆ ಕ್ಹಾರಾ ತರನಾ ಕಾಮೊ ಕರಸ. <verse eid="EXO 31:5" /><verse number="6" style="v" sid="EXO 31:6" />ತಿನಾ ಕ್ಹಾತೆ ಕಾಮ ಕರಾನೆ ಮಿ ಒಹೊಲಿಯಾಬನೆ ಇನಿಲಿದ್ಯೊಸ. ಒಹೊಲಿಯಾಬ ದಾನ ಕುಲನೊ ಅಹಿಸಾಮನೊ ದಿಕ್ರೊ ವ್ಹೈ. ಮಿ ತುನೆ ಆಗನ್ಯಾ ದಿದ್ಯಲ ಕ್ಹಾರು ಕರಾನೆ ಬಿಜಾ಼ ಕಾಮವಾಲಾವೊನೆ ತಾಕತ ಗ್ಯಾನ ದಿದ್ಯೊಸ: <verse eid="EXO 31:6" /><verse number="7" style="v" sid="EXO 31:7" />ದೆವದರ್ಶನ ಗುಡಾರ, ಒಡಂಬಡಿಕೆನಿ ಪೆಟಗಿ, ಕೃಪಾಸನ, ಗುಡಾರನಾ ಕ್ಹಾರಾ ಸಾಮನೊ, <verse eid="EXO 31:7" /><verse number="8" style="v" sid="EXO 31:8" />ಟೆಬಲ ವರಿ ತಿನಾ ಉಪ್ಪರಲ್ಯಾ ಸಾಮನೊ, ಚೊಕ್ಕ ಕ್ಹೊನಾನು ದಿಪಸ್ತಂಬ ವರಿ ತಿನಾ ಸಾಮನೊ, <verse eid="EXO 31:8" /><verse number="9" style="v" sid="EXO 31:9" />ಉದನೊ ಧವಾಂಡೊ ದಿವಾನೊ ಕಟ್ಟೊ, ಯಜ್ಞವೆದಿ ವರಿ ತಿನಾ ಸಾಮನೊ, ಗಂಗಾಳ ವರಿ ತಿನು ಪಿಟ. <verse eid="EXO 31:9" /><verse number="10" style="v" sid="EXO 31:10" />ಯಾಜಕ ಥಯಲ ಆರೊನನಾ ಕ್ಹಾರಾ ಕ್ಹಾಸ ವಣ್ಣಾ, ಆರೊನನಾ ದಿಕ್ರಾ ಯಾಜಕೊ ಥೈನ ಸೆವೆ ಕರ್ತಾಮಾ ಘಾಲಿಲಿವಾನಾ ಕ್ಹಾರಾ ವಣ್ಣಾ. <verse eid="EXO 31:10" /><verse number="11" style="v" sid="EXO 31:11" />ಚೊಕಿ ಬಾಸ ರ‍್ಹಯಲ ಅಭಿಶೆಕ ಕರಾನು ತೆಲ ಪವಿತ್ರ ಜ಼ಗಾಮಾ ಉಪಯೊಗ ಕರಾನು ಚೊಕಿ ಬಾಸನು ಉದ. ಎ ಕ್ಹಾರು ಮಿ ತುನೆ ಆಗನ್ಯಾ ಕರಲ ತಿಮ್ಮ ತ್ಯುನೆ ಕರಸ.<verse eid="EXO 31:11" /></para>
  <para style="s">ಸಬ್ಬತ, ಅರಾಮ ಕರಾನು ದಿನ್ನ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12" />ಪಾಚ಼ಲ್ತೊ ಯಹೊವಾ ಮೊಶೆನೆ ಅಮ್ಮ ಕದ್ಯೊ: <verse eid="EXO 31:12" /><verse number="13" style="v" sid="EXO 31:13" />"ಎ ಇಸ್ರಾಯೆಲೊನೆ ಕೆ: ‘ತುಮೆ ಮಾರು ಕ್ಹಾಸ ರ‍್ಹಯಲ ಸಬ್ಬತ ದಿನ್ನ ಚುಕ್ಯಾವಾಚಿ ಕರು. ಯಹೊವಾ ಥಯಲ ಮಿ ತುಮೊನೆ ಮಾರಾ ಕ್ಹಾಸ ಮನಕ್ಹೊ ಕರಲನೆ ತೆ ಗುರುತ ಥಯುಸ. <verse eid="EXO 31:13" /><verse number="14" style="v" sid="EXO 31:14" />"ಸಬ್ಬತ ದಿನ್ನ ಕ್ಹಾಸ ದಿನ್ನ ವ್ಹೈ ಕೈನ ತಿಳ್ದಿಲಿನ ಕರು. ತೆ ದಿನ್ನನೆ ಬಿಜಾ಼ ದಿನ್ನೊ ಲಿಂಗತ ತಿಳ್ದಿಲಿನ ಚಾಲಾಲಾನೆ ಮರಣನಿ ಶಿಕ್ಷಾ ಥೌ. ಸಬ್ಬತ ದಿನ್ನಮಾ ಕುನ್ನತಬಿ ಕಾಮ ಕರ‍್ಯೊಮ ತಿನೆ ಭಾರಾ ಘಾಲು. <verse eid="EXO 31:14" /><verse number="15" style="v" sid="EXO 31:15" />ಕಾಮ ಕರಾನೆ ಹಪ್ತಾಮಾ ಬಿಜಾ಼ ಛೆ ದಿನ್ನೊ ಶೆ. ತೆನೈಸೊ ಕ್ಹಾತಂವಾ ದಿನ್ನ ಅರಾಮ ಕರಾನೊ ಘನ್ನ ಕ್ಹಾಸ ರ‍್ಹಯಲ ದಿನ್ನ ವ್ಹೈ. ಯಹೊವಾನೆ ಸನ್ಮಾನ ಕರಾನೆ ತೆ ಯಕ್ಕ ಕ್ಹಾಸ ದಿನ್ನ ವ್ಹೈ. ಸಬ್ಬತನಾ ಟೈಮಮಾ ಕಾಮ ಕರಾಲೊ ಕಲಾಸ ಥೌ. <verse eid="EXO 31:15" /><verse number="16" style="v" sid="EXO 31:16" />ಇಸ್ರಾಯೆಲೊ ಸಬ್ಬತ ದಿನ್ನ ಶೆಂ ಕರಿನ ತಿನೆ ಕ್ಹಾಸ ದಿನ್ನ ಕರಿಲ್ಯು. ತ್ಯುನೆ ತಿನೆ ಹಮೆಶಾಬಿ ಕರು. ತ್ಯುನೊನೆಬಿ ತ್ಯುನಾ ಸಂತತಿವಾಲಾವೊನೆಬಿ ಎ ಹಮೆಶಾಬಿ ರ‍್ಹವಾನು ಒಡಂಬಡಿಕೆ ವ್ಹೈ. <verse eid="EXO 31:16" /><verse number="17" style="v" sid="EXO 31:17" />ಸಬ್ಬತ ಮನೆಬಿ ವರಿ ಇಸ್ರಾಯೆಲೊನಾ ವಚ್ಮಾ ಹಮೆಶಾಬಿ ರ‍್ಹವಾನು ಸುಚನೆ ಥೈನ ರ‍್ಹವಸ. ಯಹೊವಾ ಛೆ ದಿನ್ನಮಾ ಕಾಮ ಕರಿನ ಹಬಾಳನೆ ಜಿಮಿನನೆ ಕರ‍್ಯೊ. ಕ್ಹಾತಂವಾ ದಿನ್ನಮಾ ಕಾಮ ಕರ‍್ಯಾ ಬಗರ ಅರಾಮ ಕರ‍್ಯೊ.”’ <verse eid="EXO 31:17" /><verse number="18" style="v" sid="EXO 31:18" />ಇಮ್ಮ, ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ಸಿನಾಯ ಡೊಂಗರಮಾ ಬೊಲಾನು ಖರಾಯೊ. ಪಾಚ಼ಲ್ತೊ ಯಹೊವಾ ಒಡಂಬಡಿಕೆ ಲಿಕ್ಕಲ ಬೆ ದಗ್ಡಾನಾ ಹಲಗಿಯೊ ಮೊಶೆನೆ ದಿದ್ಯೊ. ತೆ ಕ್ಹುದಾನಾ ಬೊಟೆ ಲಿಕ್ಕಲ ವ್ಹತ್ತಾ.<verse eid="EXO 31:18" /></para>
  <chapter eid="EXO 31" />
  <chapter number="32" style="c" sid="EXO 32" />
  <para style="s">ಕ್ಹೊನಾನಿ ಬೈಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1" />ಘನ್ನೊ ಟೈಮ ಥಯೊತಬಿ ಮೊಶೆ ಡೊಂಗರ ಪರ್ತೊ ಹೆಟೊ ನೈ ಆಯಲಕ್ಹು ಇಸಾಯೆಲೊ ಆರೊನಕನ ಮಳಿನ ಐನ, "ದೆಕ, ಮೊಶೆ ಅಪೊನೆ ಐಗುಪ್ತತೊ ಭಾರೊ ಲಾಯೊ. ತೆನೈಸೊ ತಿನೆ ಸು ಥಯು ಅಪೊನೆ ಗ್ವತ್ತ ನತ್ತಿ. ತಿನಾಹುತಿ ಹಮೊನೆ ಅಗೊ ಚಲಾವಾನೆ ದಕ್ಹಾ ಕ್ಹುದಾವೊನೆ ಕರಿನ ದೆ” ಕೈನ ಕದ್ಯಾ. <verse eid="EXO 32:1" /><verse number="2" style="v" sid="EXO 32:2" />ಆರೊನ ತ್ಯುನೊನೆ, "ತುಮಾರಾ ಬಾಕ್ಡಿಯೊನಾ ವರಿ ಗಂಡ ಹೆಣ್ಣ ಬಚ್ಚಾವೊಮಾ ರ‍್ಹವಾನಾ ಕ್ಹೊನಾನಾ ಕಾನೊಮಾನಾ ಮನೆ ಲೈನ ದಿವೊ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 32:2" /><verse number="3" style="v" sid="EXO 32:3" />ತಿನಾಹುತಿ ತ್ಯುನೆ ಕ್ಹಾರಾ ತ್ಯುನಾ ಕ್ಹೊನಾನಾ ಕಾನೊಮಾನಾ ಲೈನ ದಿದ್ಯಾ. <verse eid="EXO 32:3" /><verse number="4" style="v" sid="EXO 32:4" />ಆರೊನ ಬೈಲನಿ ಮುರ್ತಿ ತೆ ಕ್ಹೊನಾಕ್ಹು ಕರಾಲಗಾಡ್ಯೊ. ಪಾಚಲ್ತಾ ತ್ಯುನೆ, "ಇಸ್ರಾಯೆಲೊ, ತುಮಾರಾ ಕ್ಹುದಾವೊ ನ್ಹ್ಯಾ ಛೆ! ತುಮೊನೆ ಐಗುಪ್ತತೊ ಬಲೈಲಿನ ಆಯಲ ಕ್ಹುದಾವೊ ಎಜ ವ್ಹೈ” ಕೈನ ಕದ್ಯಾ. <verse eid="EXO 32:4" /><verse number="5" style="v" sid="EXO 32:5" />ಆರೊನ ಎ ಕ್ಹಾರು ದೆಕಿನ, ಬೈಲನಾ ಕ್ಹಾಮೊ ಯಕ್ಕ ಯಜ್ಞವೆದಿ ಭಂದಾಯೊ. ಪಾಚ಼ಲ್ತೊ,</para>
  <para style="p" vid="EXO 32:5">"ವಂತಾ ಯಹೊವಾನೆ ಸನ್ಮಾನ ಕರಾನೆ ಯಕ್ಕ ಕ್ಹಾಸ ಸನ್ನ ರ‍್ಹವಸ” ಕೈನ ಕದ್ಯಾ. <verse eid="EXO 32:5" /><verse number="6" style="v" sid="EXO 32:6" />ಮರ್ನಾ ದಿನ್ನೆ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಜಲ್ದಿ ಉಟಿನ ತ್ಯುನಾ ಪಶುವೊನೆ ಕತ್ರಿನ ಸರ್ವಾಂಗ ಹೊಮಾಬಿ, ಸಮಾಧಾನ ಯಜ್ಞಬಿ ಕರಿನ ಕ್ಹಾವಾ ಪಿವಾನೆ ಬೆಟ್ಯಾ. ಪಾಚಲ್ತಾ ಉಟಿನ ನ್ಹಾಚ್ಯಾ ವರಿ ಮಜಾ ಕರ‍್ಯಾ. <verse eid="EXO 32:6" /><verse number="7" style="v" sid="EXO 32:7" />ತೆಜ಼ ಟೈಮಮಾ ಯಹೊವಾ ಮೊಶೆನೆ, "ಡೊಂಗರ ಪರ್ತೊ ಉತ್ರಿನ ಜಾ಼. ತು ಐಗುಪ್ತತೊ ಬಲೈಲಿನ ಆಯಲ ತಾರಾ ಮನಕ್ಹೊ ಘನ್ನು ಮ್ಹೊಟು ಪಾಪ ಕರ‍್ಯಾಸ ವರಿ ಮಕ್ಹು ದುರ ಥಯಾಸ. <verse eid="EXO 32:7" /><verse number="8" style="v" sid="EXO 32:8" />ಮಿ ತ್ಯುನೊನೆ ಆಗನ್ಯಾ ದಿದಲ ಕ್ಹಾರಾನೆ ಘನ್ನ ಜಲ್ದಿ ಅವಿದೆಯ ಥಯಾಸ. ಕ್ಹೊನು ಕರಗೈನ ತಿಕ್ಹು ಬಸವಣ್ಣಾನೆ ಕರಿಲಿನ ತಿನೆ ಪುಜಾ ಕರ್ತಾ ತಿನೆ ಯಜ್ಞ ಕರಾಡಾಸ ‘ಇಸ್ರಾಯೆಲೊ ತುಮೊನೆ ಐಗುಪ್ತತೊ ಬಲೈಲಿನ ಆಯಲ ಕ್ಹುದಾವೊ ಎಜ ವ್ಹೈ’ ಕೈನ ಮನಕ್ಹೊ ಕವಾಡಾಸ” ಕದ್ಯೊ. <verse eid="EXO 32:8" /><verse number="9" style="v" sid="EXO 32:9" />ಯಹೊವಾ ಮೊಶೆನೆ, "ಮಿ ಎ ಮನಕ್ಹೊನೆ ದೆಕ್ಯೊಸ. ತ್ಯುನೆ ಘನ್ನ ಉಂಬ ಶೆ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ.” <verse eid="EXO 32:9" /><verse number="10" style="v" sid="EXO 32:10" />ತಿನಾಹುತಿ ಮಿ ತ್ಯುನೊನೆ ಶಿಟ್ಟಕ್ಹು ನಾಶ ಕರುಸ. ಮನೆ ಹುಬ್ರಾಡು ನಕೊ. ಪಾಚ಼ಲ್ತೊ ಮಿ ತಾರಾಕ್ಹು ಯಕ್ಕ ಮ್ಹೊಟು ಜನಾಂಗ ಕರುಸ” ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11" />ತೆನೈಸೊ ಮೊಶೆ ತಿನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ, "ಯಹೊವಾ, ತಾರಿ ಶಿಟ್ಟ ತಾರಾ ಮನಕ್ಹೊನೆ ನಾಶ ನಕೊ ಕರಾದೆ. ತಾರಿ ಮ್ಹೊಟಿ ತಾಕತಕ್ಹು ಬಲಾಕ್ಹು ಎ ಮನಕ್ಹೊನೆ ಐಗುಪ್ತತೊ ಭಾರೊ ಲಿನ ಆಯೊತೊ. <verse eid="EXO 32:11" /><verse number="12" style="v" sid="EXO 32:12" />ತೆನೈಸೊ ತು ತಾರಾ ಮನಕ್ಹೊನೆ ನಾಶ ಕರ‍್ಯೊಮ, ಐಗುಪ್ತನಾ, ‘ಯಹೊವಾ ತಿನಾ ಮನಕ್ಹೊನೆ ಕೆಟ್ಟ ಕರಾನಾಹುತಿಜ಼ ಐಗುಪ್ತತೊ ಬಲೈಲಿನ ಗಯೊ. ತೆ ತ್ಯುನೊನೆ ಡೊಂಗರೊಮಾ ಖಲಾಸ ಕರು ಕೈನ ವ್ಹತ್ತೊ; ತಿನಾ ಮನಕ್ಹೊನೆ ಜಿಮಿನ ಪರ್ತೊ ಖಲಾಸ ಕರು ಕೈನ ವ್ಹತ್ತೊ’ ಕೈನ ಕವಸ. ತಿನಾಹುತಿ ತಾರಾ ಮನಕ್ಹೊನಾ ಉಪ್ಪರ ಶಿಟ್ಟ ಥೌ ನಕೊ. ತಾರಿ ಶಿಟ್ಟ ಛೊಡಿಪಡ. ತಾರಾ ಮನಕ್ಹೊನೆ ನಾಶ ಕರು ನಕೊ. <verse eid="EXO 32:12" /><verse number="13" style="v" sid="EXO 32:13" />ತಾರಿ ಸೆವಾ ಕರಲ ಅಬ್ರಹಾಮನೆ, ಇಸಾಕನೆ, ಯಾಕೊಬನೆ, ಇಸ್ರಾಯೆಲೊನೆ ಶೆಂ ಕರಿಲೆ. ತು ತಾರು ನಾಮ ಉಪಯೊಗ ಕರಿನ ತೆ ಮನಕ್ಹೊನೆ ವಾಗ್ದಾನ ಕರ‍್ಯೊತೊ ‘ಮಿ ತಾರಾ ಸಂತತಿವಾಲಾವೊನೆ ಹಬಾಳನಾ ಚಿಕ್ಕಿಯೊನಾ ತೆಕ್ಲು ಕರುಸ. ಮಿ ವಾಗ್ದಾನ ಕರಲ ತಿಮ್ಮ ಎ ಕ್ಹಾರಾ ದೆಶನೆ ತಾರಾ ಸಂತತಿ ಲಕ್ಕಾ ದ್ಯುಸ. ಎ ದೆಶ ಹಮೆಶಾಬಿ ತ್ಯುನುಜ ಥೈನ ರ‍್ಹವಸ’ ಕೈನ ತು ತಾರಾ ನಮಾಪರ ವಾಗ್ದಾನ ಕರ‍್ಯೊತೊತೊ” ಕದ್ಯೊ. <verse eid="EXO 32:13" /><verse number="14" style="v" sid="EXO 32:14" />ತಿನಾಹುತಿ ಯಹೊವಾ ಮನಕ್ಹೊನಾಹುತಿ ಮರ್ಗಾ ಖೈನ ತಿನಾ ಮನಸನೆ ಬದ್ಲಿ ಕರಿ ಲಿದ್ಯೊ; ತೆ ಕದಲ ಕೆಟ್ಟ ಕರ‍್ಯೊ ನೈ; ತಿನಾ ಮನಕ್ಹೊನೆ ನಾಶ ಕರ‍್ಯೊ ನೈ. <verse eid="EXO 32:14" /><verse number="15" style="v" sid="EXO 32:15" />ಪಾಚ಼ಲ್ತೊ ಮೊಶೆ ಡೊಂಗರಪ್xರೊ ಉತ್ರಿನ ಗಯೊ. ಮೊಶೆನಾ ಕ್ಹಾತೆ ಆಗನ್ಯಾ ಶಾಸನನಾ ಬೆ ದಗ್ಡಾನಾ ಹಲಗಿಯೊ ವ್ಹತ್ತಾ. ಎ ಆಗನ್ಯಾ ಶಾಸನನಾ ಆಗಾಬಿ ಪಾಚಾಬಿ ಲಿಕ್ಕಲ ವ್ಹತ್ತು. <verse eid="EXO 32:15" /><verse number="16" style="v" sid="EXO 32:16" />ಯಹೊವಾ ತೆಜ಼ ತೆ ದಗ್ಡಾ ಕರಿನ ತ್ಯುನಾ ಉಪ್ಪರ ಲಿಕ್ಯೊತೊ. <verse eid="EXO 32:16" /><verse number="17" style="v" sid="EXO 32:17" />ಇಸ್ರಾಯೆಲೊನಿ ಗದ್ದಲನೆ ವರಿ ಅಡ್ಡಾನು ಯೆಹೊಶುವಾ ಐಕಿನ ಮೊಶೆನೆ, "ಪಾಳೆಕಂತಾ ಯುದ್ದನಿ ಅವಾಜ ಐಕು ಆವಾಡಿಸ” ಕದ್ಯೊ.<verse eid="EXO 32:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 32:18" />ತಿನಾಹುತಿ ಮೊಶೆ, "ತೆ ಸೈನ್ಯ ಜಿತ್ತಲ ಅವಾಜ ನ್ಹವೈ. ತೆ ಹಾರಕ್ಹು ಅಡ್ಡಾನು ಸೈನ್ನನು ಅವಾಜಬಿ ನ್ಹವೈ. ಮಿ ಐಕಾನು ಗೊಷ್ಟಿನು ಅವಾಜ ವ್ಹೈ” ಕೈನ ಜವಾಬ ದಿದ್ಯೊ. <verse eid="EXO 32:18" /><verse number="19" style="v" sid="EXO 32:19" />ಮೊಶೆ ಪಾಳೆನಾ ನಜಿಕ ಆಯೊ. ತೆ ಕ್ಹೊನಾನು ಬಸವಣ್ಣಾನೆ ಮನಕ್ಹೊ ನ್ಹಾಚಾನು ದೆಕಿನ ಘನ್ನೊ ಶಿಟ್ಟ ಥೈನ ದಗ್ಡಾನಾ ಹಲಗಿಯೊನೆ ಹೆಟೊ ನಾಕಿಪಡ್ಯೊ; ತೆ ಪುಡಿ ಪುಡಿ ಥೈನ ಫುಟಿಗಯಾ. <verse eid="EXO 32:19" /><verse number="20" style="v" sid="EXO 32:20" />ಪಾಚ಼ಲ್ತೊ ಮೊಶೆ ತೆ ಬಸವಣ್ಣಾನಿ ಮುರ್ತಿನೆ ಆಗಮಾ ಕರಗೈನ ತಿನಾ ಕ್ಹೊನಾನೆ ಧುಳ ಲಿಂಗತ ಪಾನಿಮಾ ಘಾಲಿನ ತೆ ಪಾನಿನೆ ಇಸ್ರಾಯೆಲವಾಲಾವೊನೆ ಪಿಲಾಯೊ. <verse eid="EXO 32:20" /><verse number="21" style="v" sid="EXO 32:21" />ಮೊಶೆ ಆರೊನನೆ, "ಎ ಮನಕ್ಹೊ ತುನೆ ಸು ಕರ‍್ಯಾ? ಹವು ಕೆಟ್ಟ ಪಾಪ ಕರೆಲಿಂಗತ ಕಾ ತ್ಯುನೊನೆ ಚಲಾಯೊ? ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 32:21" /><verse number="22" style="v" sid="EXO 32:22" />ಆರೊನ, "ಶಿಟ್ಟ ಥೌ ನಕೊ. ಇವ್ನೆ ಕೆಳಾಮಾಬಿ ಪಾಪ ಕರಾನೆ ತಯ್ಯಾರ ರ‍್ಹವಾನು ತುನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="EXO 32:22" /><verse number="23" style="v" sid="EXO 32:23" />ತ್ಯುನೆ ಮನೆ, ‘ಮೊಶೆ ಹಮೊನೆ ಐಗುಪ್ತತೊ ಭಾರೊ ಚಲಾಯೊ. ತೆನೈಸೊ ತಿನೆ ಸು ಥಯು ಕವಾನು ಹಮೊನೆ ಗ್ವತ್ತ ನತ್ತಿ. ತಿನಾಹುತಿ ಹಮೊನೆ ಅಗೊ ಚಲಾವಾನೆ ಕ್ಹುದಾವೊನೆ ಕರಿನ ದೆ’ ಕೈನ ಪುಚ್ಯಾ. <verse eid="EXO 32:23" /><verse number="24" style="v" sid="EXO 32:24" />ತಿನಾಹುತಿ ಮಿ ತ್ಯುನೊನೆ, "ತುಮೊಮಾ ಕ್ಹೊನಾನಾ ಸಮನೊ ರ‍್ಹಯಾಮ ಮನೆ ದಿವೊ’ ಕೈನ ಕದ್ಯೊ. ತ್ಯುನೆ ಸಾಮನೊ ಮನೆ ಲೈನ ದಿದ್ಯಾ. ಮಿ ತೆ ಆಗಮಾ ಕರಗೈನ ಎ ಬಸವಣ್ಣಾನಿ ಮುರ್ತಿ ಕರಿನ ದಿದ್ಯೊ” ಕೈನ ಉತ್ತರ ದಿದ್ಯೊ. <verse eid="EXO 32:24" /><verse number="25" style="v" sid="EXO 32:25" />ಮನಕ್ಹೊ ವಾಟ ಚುಕಿನ ತ್ಯುನೊನೆ ಪಸಂದ ಆಯೆಲಿಂಗತ ಕರಾನೆ ಆರೊನ ತ್ಯುನೊನೆ ಛೊಡಿಪಡಲ ಮೊಶೆನೆ ಗ್ವತ್ತ ಥಯು. ಮನಕ್ಹೊ ಕ್ರಮಾ ನೈ ರ‍್ಹಯಲ ಖುದ್ದನಿ ಇಚ್ಯಾವೊಕ್ಹು ಚಾಲಾಡಾತಾ; ತ್ಯುನಿ ಮುರ್ಖತನಾ ತ್ಯುನಾ ವಿರೊದಿವಾಲಾವೊನೆ ಉಟಿನ ದಿಕ್ಹಾಡುತು! <verse eid="EXO 32:25" /><verse number="26" style="v" sid="EXO 32:26" />ತಿನಾಹುತಿ ಪಾಳೆನಾ ಬಾಕಲಕನ ಮೊಶೆ ಹುಬ್ರೈನ, "ಯಹೊವಾನಾ ಪಕ್ಷವಾಲಾ ಮಕನ ಔ” ಕೈನ ಕದ್ಯೊ. ಲೆವಿ ಕುಲವಾಲಾ ಕ್ಹಾರಾ ಮೊಶೆಕನ ಆಯಾ. <verse eid="EXO 32:26" /><verse number="27" style="v" sid="EXO 32:27" />ತೆಳಾಮಾ ಮೊಶೆ ತ್ಯುನೊನೆ, "ಇಸ್ರಾಯೆಲನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಕವಾನು ತುಮೊನೆ ಕೌಸ! ತುಮೊಮಾ ಹರಯಕ್ಲೊ ತಲ್ವಾರ ಲಿನ ಪಾಳೆನಾ ಯಕ್ಕ ಮುಲಾತಾ ವರಿಯಕ್ಕ ಮುಲಾ ಲಕ್ಕಾ ಗೈನ ಮನಕ್ಹೊನೆ ಶಿಕ್ಷಾ ದ್ಯು. ತುಮಾರಾ ಭಾಯೊ ಥಯಾತುಬಿ ದೊಸ್ತೊ ಥಯಾತುಬಿ ತೆನಯೊ ಆಜು಼ ಬಾಜು಼ವಾಲಾ ರ‍್ಹಯಾತುಬಿ, ಖಲಾಸ ಕರೊ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 32:27" /><verse number="28" style="v" sid="EXO 32:28" />ಲೆವಿ ಕುಲಾ ಮೊಶೆನಾ ವಾತೆ ವಿದೆಯ ಥಯಾ. ತೆ ದಿನ್ನೆ ಇಸ್ರಾಯೆಲೊಮಾ ಕಮ್ಸಿಕಮ್ಮ ತನ್ನ ಹಜಾ಼ರ ಮನಕ್ಹೊ ಮರ‍್ಯಾ. <verse eid="EXO 32:28" /><verse number="29" style="v" sid="EXO 32:29" />ತೆಳಾಮಾ ಮೊಶೆ ತ್ಯುನೊನೆ, "ಆಜ ತುಮೆ ಯಹೊವಾನೆ ನೆಮ್ಸಲ ಮನಕ್ಹೊ ಥಯಾ; ಕಾಕದ್ಯಾಮ ತುಮೆ ತುಮಾರಾ ಸ್ವಂತ ಗಂಡ ದಿಕ್ರಾನೆಬಿ ಭೈನೆಬಿ ವಿರುದ್ದ ಥಯಾ. ಆಜ ತೆ ತುಮೊನೆ ಆಶಿರ್ವಾದ ಕರ‍್ಯೊಸ” ಕದ್ಯೊ.<verse eid="EXO 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30" />ಮರ್ನಾ ದಿನ್ನ ಮೊಶೆ ಮನಕ್ಹೊನೆ, "ತುಮೆ ಘನ್ನು ಮ್ಹೊಟು ಪಾಪ ಕರ‍್ಯಾಸ. ತೆನೈಸೊ ಹಮ್ನಾ ಮಿ ಯಹೊವಾ ಕನ ಗೈನ, ತೆ ತುಮಾರಾ ಪಾಪೊನೆ ಮಾಫ ಕರಾನಾಹುತಿ ಮಿ ಸುಬಿ ಕರ ಸಕುಸ ಸು ಕೈನ ಪುಚ್ಚುಸ” ಕದ್ಯೊ. <verse eid="EXO 32:30" /><verse number="31" style="v" sid="EXO 32:31" />ತಿನಾಮಲಿಂಗತಜ಼ ಮೊಶೆ ಯಹೊವಾಕನ ಫರಿನ ಗೈನ, "ದಯಾ ಕರಿನ ಐಕ! ಎ ಮನಕ್ಹೊ ಘನ್ನು ಕೆಟ್ಟ ಪಾಪ ಕರ‍್ಯಾಸ. ಕ್ಹೊನಾಕ್ಹು ಮುರ್ತಿ ಕರಿಲಿದ್ಯಾಸ. <verse eid="EXO 32:31" /><verse number="32" style="v" sid="EXO 32:32" />ತ್ಯುನಾ ಎ ಪಾಪನೆ ಮಾಫ ಕರ. ತು ತ್ಯುನೊನೆ ಮಾಫ ನೈ ಕರ‍್ಯೊಮ ತಾರಾ ಜಿವಭಾದ್ಯನಾ ಪಟ್ಟಿಮಾತೊ ಮಾರು ನಾಮ ಉಕ್ಲಿ ಪಡ” ಕೈನ ಪ್ರಾರ್ಥನಾ ಕರ‍್ಯೊ. <verse eid="EXO 32:32" /><verse number="33" style="v" sid="EXO 32:33" />ತೆನೈಸೊ ಯಹೊವಾ ಮೊಶೆನೆ, "ಮನೆ ವಿರುದ್ದ ಥೈನ ಪಾಪ ಕರಾನಾ ಮನಕ್ಹೊನಾ ನಾಮೊ ಯಕ್ಕಜ ಮಾರಾ ಪುಸ್ತಕತು ಉಕ್ಲುಸ. <verse eid="EXO 32:33" /><verse number="34" style="v" sid="EXO 32:34" />ತಿನಾಹುತಿ ಹಮ್ನಾ ಹೆಟೊ ಉತ್ರಿನ ಮಿ ತುನೆ ಕವಾನಿ ಜ಼ಗಾ ಮನಕ್ಹೊನೆ ಚಲಾ. ಮಾರೊ ದುತ ತಾರಾ ಅಗೊ ಗೈನ ತುನೆ ಚಲಾವಸ. ಪಾಪ ಕರಲ ಮನಕ್ಹೊನೆ ಶಿಕ್ಷಾ ದಿವಾನೊ ಟೈಮಾ ಆಯಲ್ಪರ ತ್ಯುನೆ ಶಿಕ್ಷಾ ಹೊಂದಿಲಿವಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 32:34" /><verse number="35" style="v" sid="EXO 32:35" />ತಿನಾಹುತಿ ಯಹೊವಾ ಮನಕ್ಹೊನೆ ಘನ್ನು ಮ್ಹೊಟು ತ್ರಾಸ ಲಾಯೊ. ತ್ಯುನೆ ಆರೊನಕ್ಹು ಕ್ಹೊನಾನಿ ಬೈಲನೆ ಕರಿಲಿದಲಜ ಅನೆ ಕಾರಣ ವ್ಹೈ.<verse eid="EXO 32:35" /></para>
  <chapter eid="EXO 32" />
  <chapter number="33" style="c" sid="EXO 33" />
  <para style="s">ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನೆ ಸಿನಾಯ ಡೊಂಗರ ಛೊಡಿನ ಜಾವೊ ಕೈನ ಯಹೊವಾನಿ ಆಗನ್ಯಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1" />ಪಾಚ಼ಲ್ತೊ ಯಹೊವಾ ಮೊಶೆನೆ, "ತು ವರಿ ಐಗುಪ್ತತೊ ತು ಬಲೈಲಿನ ಆಯಲ ಮನಕ್ಹೊ ಎ ಜ಼ಗಾ ಛೊಡು. ಮಿ ಅಬ್ರಹಾಮನೆ, ಇಸಾಕನೆ ವರಿ ಯಾಕೊಬನೆ ವಾಗ್ದಾನ ಕರಲ ದೆಶೆ ಜಾ಼ವೊ. ಮಿ ತ್ಯುನೊನೆ ‘ತುಮೆ ಥಯಲ್ಪರ ಜಿವ್ಸಾನಾ ತುಮಾರಾ ಸಂತತಿವಾಲಾವೊನೆ ತೆ ದೆಶ ದ್ಯುಸ’ ಕೈನ ಮಿ ತ್ಯುನೊನೆ ವಾಗ್ದಾನ ಕರ‍್ಯೊ. <verse eid="EXO 33:1" /><verse number="2" style="v" sid="EXO 33:2" />ತುಮಾರಾ ಅಗೊ ಜಾ಼ವಾನೆ ಮಿ ಯಕ್ಕ ದುತನೆ ವಳೌಸ. ಕಾನಾನ್ಯವಾಲಾವೊನೆ, ಅಮೊರಿಯವಾಲಾವೊನೆ, ಹಿತ್ತಿಯವಾಲಾವೊನೆ, ಪೆರೆಜಿಯವಾಲಾವೊನೆ, ಹಿವ್ವಿಯವಾಲಾವೊನೆ ವರಿ ಯೆಬುಶಿಯವಾಲಾವೊನೆ ಮಿ ಹರಾಡುಸ. <verse eid="EXO 33:2" /><verse number="3" style="v" sid="EXO 33:3" />ತಿನಾಹುತಿ ದುದ್ದ ವರಿ ಜೆನ ಹರ್ದಾನಾ ತೆ ದೆಶೆ ಜಾ಼ವೊ. ತೆನೈಸೊ ಮಿ ತುಮಾರಾ ಕ್ಹಾತೆ ನೈ ಆತೊ. ತುಮೆ ಮಾರಿ ಆಗನ್ಯಾನೆ ವಿದೆಯ ಥಯಾ ಬಗರ ಮನೆ ಶಿಟ್ಟ ಲಾವೊಶಿ. ಮಿ ತುಮಾರಾ ಕ್ಹಾತೆ ಆಯೊರೆ, ವಾಟಮಾಜ ತುಮೊನೆ ಖಲಾಸ ಕರಿಪಡುಸ” ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 33:4" />ಎ ದುಖನಿ ವಾತ ಐಕಿನ ಮನಕ್ಹೊ ದುಖಿ ಥಯಾ. ತ್ಯುನೊಮಾ ಯಕ್ಲೊಬಿ ತ್ಯುನಾ ಕ್ಹೊನಾನಾ ಸಾಮನೊ ಘಾಲಿಲಿದ್ಯಾ ನೈ. <verse eid="EXO 33:4" /><verse number="5" style="v" sid="EXO 33:5" />ಯಹೊವಾ ಮೊಶೆನೆ, "ಇಸ್ರಾಯೆಲೊನೆ ಅಮ್ಮ ಕೆ: ತುಮೆ ಮಂಡ ಮನಕ್ಹೊ ಥಯಾಸ. ಮಿ ತುಮಾರಾ ಕ್ಹಾತೆ ದಕ್ಹಿಯೆಳ ರ‍್ಹಯೊಮ, ತುಮೊನೆ ಖಲಾಸ ಕರಿಪಡುಸ. ತಿನಾಹುತಿ ತುಮಾರಾ ಕ್ಹಾರಾ ಕ್ಹೊನಾನಾ ಸಾಮನೊ ಕಾಡಿಪಡೊ. ತುಮೆ ಸು ಕರು ಕವಾನು ಮಿ ತಿಳಸುಸ!” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 33:5" /><verse number="6" style="v" sid="EXO 33:6" />ಇಸ್ರಾಯೆಲೊ ಸಿನಾಯ ಡೊಂಗರಪರ ರ‍್ಹತಾಮಾ ಕ್ಹೊನಾನಾ ಸಾಮನೊ ಘಾಲಿ ಲಿವಾನು ಛೊಡಿಪಡ್ಯಾ.<verse eid="EXO 33:6" /></para>
  <para style="s">ಯಹೊವಾನಿ ಸನ್ನಿದಿನು ಗುಡಾರ</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7" />ಮೊಶೆ ಗುಡಾರ ಪಾಳೆಯನಾ ಭಾರೊ ದಕ್ಹೊ ದುರ ಲಿನ ಚಾಲ್ಯೊತೊ. ಮೊಶೆ ತಿನೆ, "ದೆವದರ್ಶನನು ಗುಡಾರ ವ್ಹೈ ಕೈನ ಕದ್ಯೊ. ಯಹೊವಾಕ್ಹು ಉತ್ತರ ಪುಚ್ಚು ಕೈನ ಕದಲ ಮನಕ್ಹ ಪಾಳೆಯನಾ ಭಾರು ರ‍್ಹಯಲ ದೆವದರ್ಶನನಾ ಗುಡಾರೆ ಜಾ಼ವಾಡೊತೊ. <verse eid="EXO 33:7" /><verse number="8" style="v" sid="EXO 33:8" />ಮೊಶೆ ತೆ ಗುಡಾರಮಾ ಜಾ಼ತಾಮಾ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ತಿನೆ ದೆಕ್ತಾತಾ. ಮನಕ್ಹೊ ತ್ಯುನಾ ಘರೊನಾ ಬಾಕಲೊಮಾ ಹುಬ್ರೈನ ಮೊಶೆ ದೆವದರ್ಶನ ಗುಡಾರಮಾ ಗಯೆಲಕ್ಕಾ ತಿನೆ ದೆಕ್ತಾತಾ. <verse eid="EXO 33:8" /><verse number="9" style="v" sid="EXO 33:9" />ಮೊಶೆ ಗುಡಾರಮಾ ಗಯಲ್ಪರ ಉಚ್ಚು ಮೆಘಸ್ತಂಬ ಕೆಳಾಮಾಬಿ ಹೆಟು ಉತರ್ತುತು. ತೆ ಮೆಘಸ್ತಂಬ ಗುಡಾರನಾ ಬಾಕಲಕನ ಹುಬ್ರೆತುತು. ಇಮ್ಮ ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ಬೊಲಾಡೊತೊ. <verse eid="EXO 33:9" /><verse number="10" style="v" sid="EXO 33:10" />ಗುಡಾರನಾ ಬಾಕಲಕನ ಮೆಘಸ್ತಂಬ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ದೆಕಲ ಟೈಮಮಾ, ತ್ಯುನೆ ತ್ಯುನಾ ಸ್ವಂತ ಝೊಪ್ಡಾವೊನಾ ಬಾಕಲೊಕನ ಮುಂಡಿ ಹೆಟಿ ಘಾಲಿನ ಯಹೊವಾನೆ ಆರಾಧನಾ ಕರ್ತಾತಾ. <verse eid="EXO 33:10" /><verse number="11" style="v" sid="EXO 33:11" />ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ಮುಖಾ ಮುಖಿ ಥೈನ ಬೊಲ್ತೊತೊ. ಯಕ್ಲೊ ತಿನಾ ದೊಸ್ತಮಾ ಕ್ಹಾತೆ ಬೊಲೆ ಲಿಂಗತ ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ಬೊಲ್ತೊತೊ. ಯಹೊವಾನಾ ಕ್ಹಾತೆ ಬೊಲ್ಯಲಪರ ಮೊಶೆ ಝೊಪ್ಡಾಮಾ ಫರಿನ ಜಾ಼ತೊತೊ. ನುನನೊ ಜಾಂಜಿಮಾನ ದಿಕ್ರೊ ಥಯಲ ಯೆಹುಶುವಾ ಮೊಶೆನೊ ಸಹಾಯಕ ಥಯೊತೊ. ಮೊಶೆ ಗುಡಾರ ಛೊಡಿನ ಗಯಲ್ಪರ ಯೆಹುಶುವಾ ಗುಡಾರಮಾಜ ರ‍್ಹತೊತೊ.<verse eid="EXO 33:11" /></para>
  <para style="s">ಯಹೊವಾ ತಿನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ರ‍್ಹೌಸ ಕೈನ ವಾಗ್ದಾನ ಕರಲ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12" />ಮೊಶೆ ಯಹೊವಾನೆ, "ಎ ಮನಕ್ಹೊನೆ ಅಗೊ ಚ಼ಲೌ ಕೈನ ತು ಮನೆ ಕದ್ಯೊಸ. ತೆನೈಸೊ ಮಾರಾ ಕ್ಹಾತೆ ಕಿನೆ ವಳಾಶಿ ಕೈನ ತು ಕದ್ಯೊ ನೈ. ತು ಮನೆ, ‘ಮಿ ತುಮೆ ಚೊಕಿ ತರಾ ತಿಳ್ದಿಲಿದ್ಯೊಸ. ಮಿ ತುನೆ ಮೆಚ್ಯೊಸ’ ಕೈನ ಕದ್ಯೊಸ. <verse eid="EXO 33:12" /><verse number="13" style="v" sid="EXO 33:13" />ಮಿ ತುನೆ ಕ್ಹರಿಮಾಜ಼ ಮೆಚ್ಚಿಸಾನೊ ರ‍್ಹೌ ಕದ್ಯಾಮ, ಮಿ ತುನೆ ತಿಳ್ದಿಲಿಯೆ ಲಿಂಗತ ಮಾರಿ ವಾಟ ಮನೆ ಶಿಕ್ಲಾ. ತೆಳಾಮಾ ಮಿ ತುೆ ಕೆಳಾಮಾಬಿ ಮೆಚ್ಚಿಸಾನೆ ಥಾವಸ. ಇವ್ನೆ ಕ್ಹಾರಾ ತಾರಾ ಮನಕ್ಹೊ ವ್ಹೈ ಕೈನ ಶೆಂ ಕರಿಲೆ” ಕೈನ ಮಾಂಗಿಲಿದ್ಯೊ. <verse eid="EXO 33:13" /><verse number="14" style="v" sid="EXO 33:14" />ಯಹೊವಾ, "ಮಿ ತುಮಾರಾ ಕ್ಹಾತೆ ಔಸ. ಮಿಜ಼ ತುಮೊನೆ ವಿಶ್ರಾಂತಿ ದ್ಯುಸ” ಕೈನ ಉತ್ತರ ದಿದ್ಯೊ. <verse eid="EXO 33:14" /><verse number="15" style="v" sid="EXO 33:15" />ತೆಳಾಮಾ ಮೊಶೆ ಯಹೊವಾನೆ, "ತು ಹಮಾರಾ ಕ್ಹಾತೆ ನೈ ಆಯೊಮ, ಎ ಜ಼ಗಾತೊ ಹಮೊನೆ ವಳೌ ನಕೊ. <verse eid="EXO 33:15" /><verse number="16" style="v" sid="EXO 33:16" />ತೆನೈಸೊ ಮನೆಬಿ ಆಂ ಮನಕ್ಹೊನೆಬಿ ತಾರಿ ದಯಾ ಮಳಿಕೈನ ಹಮೆ ತಿಳ್ದಿಲಿವಾನು ಕಿಮ್ಮ? ತು ಹಮಾರಾ ಕ್ಹಾತೆ ಆಯೊಮ, ತೆಳಾಮಾ ಹಮೆ ಎ ಕ್ಹರಿ ತಿಳ್ದಿಲಿಯೆಸ. ತು ಹಮಾರಾ ಕ್ಹಾತೆ ನೈ ಆಯೊಮ, ತೆಳಾಮಾ ಹಮೊನೆಬಿ ದುನಿಯಾಮಾ ರ‍್ಹಯಲ ಬಿಜಾ಼ ಮನಕ್ಹೊನೆಬಿ ಕಯು ವ್ಯತ್ಯಾಸ ನೈ ರ‍್ಹತು” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 33:16" /><verse number="17" style="v" sid="EXO 33:17" />ತೆಳಾಮಾ ಯಹೊವಾ ಮೊಶೆನೆ, "ತು ಮಾಂಗಿಲಿವಾನು ದ್ಯುಸ. ಮಿ ತುನೆ ಮೆಚ್ಯೊಸ ಕೈನ ಎ ಕರುಸ. ಮಿ ತುನೆ ಚೊಕಿ ತರಾ ತಿಳ್ದಿಲಿದ್ಯೊಸ” ಕದ್ಯೊ.<verse eid="EXO 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18" />ಪಾಚ಼ಲ್ತೊ ಮೊಶೆ, "ಹಮ್ನಾ ದಯಾ ಕರಿನ ತಾರಿ ಮಹಿಮಾ ಮನೆ ದೆಕಾಡ” ಕದ್ಯೊ.<verse eid="EXO 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 33:19" />ತೆಳಾಮಾ ಯಹೊವಾ "ಮಾರಾ ನಾಮನಿ ಮಹಿಮಾ ತಾರಾ ಅಗಿ ದಾಟಿನ ಜಾ಼ವಾವರಕ್ಹು ಕರುಸ. ಮಿ ಯಹೊವಾ ವ್ಹೈ. ತುನೆ ಐಕು ಆಯೆಲಿಂಗತ ಮಾರು ನಾಮ ಪ್ರಕಟ ಕರುಸ. ಮಿ ಇನಿಲಿದಲ ಮನಕ್ಹೊನೆ ದಯಾಬಿ ಮಯಾಬಿ ದೆಕಾಡುಸ. <verse eid="EXO 33:19" /><verse number="20" style="v" sid="EXO 33:20" />ಮನೆ ಕುನ್ನಜ ಮುಖಾ ಮುಖಿ ಥೈನ ದೆಕಾನೆ ಸಾದ್ಯ ನತ್ತಿ. ಮನೆ ದೆಕ್ಯಲವಾಲೊ ಕುನ್ನಜ ವಾಚ್ತೊ ನೈ. <verse eid="EXO 33:20" /><verse number="21" style="v" sid="EXO 33:21" />ನ್ಹ್ಯಾ ಯಕ್ಕ ದಗ್ಡೊ ಛೆ. ತು ತೆ ದಗ್ಡಾಪರ ಹುಬ್ರೆ. <verse eid="EXO 33:21" /><verse number="22" style="v" sid="EXO 33:22" />ಮಾರಿ ಮಹಿಮಾ ತೆ ಜ಼ಗಾನಾ ಮುಲಕ ದಾಟಿನ ಜಾ಼ವಸ. ಮಿ ತುನೆ ತೆ ದಗ್ಡಾನಾ ಮ್ಹೊಟಾ ಬಿರುಕಮಾ ರ‍್ಹವಾಲಗಾಡುಸ; ಮಿ ದಾಟಿನ ಜಾ಼ತಾಮಾ ಮಾರ ಹತ್ತಕ್ಹು ತುನೆ ಝಾಕುಸ. <verse eid="EXO 33:22" /><verse number="23" style="v" sid="EXO 33:23" />ಪಾಚ಼ಲ್ತೊ ಮಾರೊ ಹತ್ತ ಕಾಡುಸ. ತೆಳಾಮಾ ತು ಮಾರಿ ಪಿಟ್ಟ ದೆಕಶಿ; ತೆನೈಸೊ ಮಾರು ಮ್ಹೊಡು ತುನೆ ನೈ ದಿಕ್ಹತು” ಕೈನ ಉತ್ತರ ದಿದ್ಯೊ.<verse eid="EXO 33:23" /></para>
  <chapter eid="EXO 33" />
  <chapter number="34" style="c" sid="EXO 34" />
  <para style="s">ವರಿ ಬೆ ದಗ್ಡಾನಾ ಹಲಗಿಯೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1" />ತೆ ಥಯಲ್ಪರ ಯಹೊವಾ ಮೊಶೆನೆ, "ಫುಟಿ ಗಯಲ ಪೈಲಾನಾ ಬೆ ದಗ್ಡಾನಾ ಹಲಗಿಯೊ ನಿಂಗತ ಹಜಿ ಬೆ ದಗ್ಡಾನಾ ಹಲಿಗಿಯೊ ಕರ. ಪೈಲಾನಾ ದಗ್ಡಾವೊಮಾ ಬರದಲ ವಾತೊನೆ ಮಿ ಆಂ ದಗ್ಡಾವೊಪರಬಿ ಬರದುಸ. <verse eid="EXO 34:1" /><verse number="2" style="v" sid="EXO 34:2" />ವಂತಾ ಪಾಟೆ ಸಿನಾಯಿನಾ ಡೊಂಗರ್ಪರ ಚಡಿನ ಆ. ಡೊಂಗರನಾ ಉಪ್ಪರ ಮಾರಾ ಕ್ಹಾಮೊ ಹುಬ್ರೆ. <verse eid="EXO 34:2" /><verse number="3" style="v" sid="EXO 34:3" />ತಾರಾ ಕ್ಹಾತೆ ಕುನಬಿ ಔನೈ. ಡೊಂಗರನಾ ಜ಼ಗಾವೊಮಾ ಕುನಬಿ ದಿಕ್ಹು ನೈ. ತುಮಾರಾ ಪಶುವೊ ರ‍್ಹೈತಬಿ ಬಕ್ರಾನಾ ಬಚ್ಚಾ ರ‍್ಹೈತಬಿ ಡೊಂಗರನಾ ಹೆಟಾ ಚರು ನೈ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 34:3" /><verse number="4" style="v" sid="EXO 34:4" />ತಿನಾಹುತಿ ಮೊಶೆ ಪೈಲಾನಾ ಬೆ ದಗ್ಡಾವೊ ನಿಂಗತ ಹಜಿ ಬೆ ದಗ್ಡಾವೊನಾ ಹಲಗಿಯೊನೆ ಕರ್ಯೊ. ತೆ ಥಯಲ್ಪರ ಅಗಲ್ಯಾ ದಿನ ಪಾಟೆ ಜಲ್ದಿ ಸಿನಾಯಿ ಡೊಂಗರ ಚಡ್ಯೊ. <verse eid="EXO 34:4" /><verse number="5" style="v" sid="EXO 34:5" />ಮೊಶೆ ಡೊಂಗರ ಚಡಿನ ಗಯಲ್ಪರ ಯಹೊವಾನಾ ಮ್ಹಾಡಮಾ ತಿಕನ ಉತ್ರಿನ ಆಯೊ. ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ತ್ಯಾಜ ಹುಬ್ರಯೊ ವರಿ ಮೊಶೆಬಿ ಯಹೊವಾನಾ ಪವಿತ್ರ ನಾಮನೆ ಬಲಾಯೊ. <verse eid="EXO 34:5" /><verse number="6" style="v" sid="EXO 34:6" />ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾಮೊ ಜಾ಼ತಾ ಟೈಮ್ಮಾ, " ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಿ ದಯಾ ಮರಗಾಲೊ ಕ್ಹುದಾ ಥಯೊಸ. ಯಹೊವಾ ಸಿಟ್ಟಮಾ ಆತಾ ಟೈಮಾಬಿ ನಿದಾನ ಥಯೊಸ. ಯಹೊವಾ ಮಯಾ ಕರಾಲೊ ಥಯೊಸ. ಯಹೊವಾನೊ ಬರೊಕ್ಹೊನಾ ಯೊಗ್ಯ ಥಯೊಸ. <verse eid="EXO 34:6" /><verse number="7" style="v" sid="EXO 34:7" />ಯಹೊವಾ ಹಜಾ಼ರೊಸಿ ತಲೆಮಾರ ಲಕ್ಕಾ ತಿನಿ ಮಯಾ ದೆಕ್ಲಾಡಸ. ಮನಕ್ಹೊ ಕರಾನಾ ಪಾಪನೆ ಯಹೊವಾ ಮಾಫ ಕರಸ. ತೆನೈಸೊ ಅಪರಾದಿಯೊನೆ ತ್ಯುನಾ ಅಪರಾಧನೂ ಫಲ ಶಿಕ್ಷಾ ದಿವಾನು ತೆ ಇಕ್ಹರತೊ ನೈ. ವರಿ ತ್ಯುನಾ ಮಾ-ಬಾಪನು ತಪ್ಪ ಬಚ್ಚಾವೊಪರಬಿ ತನ್ನ ಚಾರ ತಲೆಮಾರ ಲಕ್ಕಾ ಆವಾ ನಿಂಗತಬಿ ಕರಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 34:7" /><verse number="8" style="v" sid="EXO 34:8" />ತೆಳಾಮಾಜ಼ ಮೊಶೆ ಜಿಮಿನಪರ ಅಡ್ಡ ಪಡಿನ ಯಹೊವಾನೆ ಆರಾಧನಾ ಕರ್ಯೊ. <verse eid="EXO 34:8" /><verse number="9" style="v" sid="EXO 34:9" />ಮೊಶೆ, " ಯಹೊವಾ, ತಾರಿ ದಯಾ ಮನೆ ಮಳಾನಿ ರ‍್ಹಯಾರೆ, ದಯಾ ಕರಿನ ಮಾರಾಕ್ಹಾತೆ ಆ. ಅವ್ನೊ ಅವಿದೆಯ ಮನಕ್ಹೊ ವ್ಹೈ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. ಮನಕ್ಹೊನೆ ಸ್ವಿಕಾರ ಕರ” ಕೈನ ಮಾಂಗಿಲಿದ್ಯೊ.<verse eid="EXO 34:9" /></para>
  <para style="s">ಒಡಂಬಡಿಕೆ ನವಿಕರಣ</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10" />ತೆಳಾಮಾ ಯಹೊವಾ, ಮಿ ತುಮಾರಾ ಕ್ಹಾತೆ ಎ ಒಡಂಬಡಿಕೆ ಕರಾಡೊಸ. ಭೊಲೊಕಮಾ ಕಿಜಾ಼ಬಿ ರ‍್ಹೈತಬಿ ಕಯಾಬಿ ಜನಾಂಗಮಾ ರ‍್ಹೈತಬಿ ಕೆಳಾಮಾಬಿ ನೈ ಥಯಲ ಮಹಾತ್ಕಾರೊನೆ ಕರುಸ. ಕ್ಹಾರಾ ಮನಕ್ಹೊ ವರಿ ತಾರಾಕ್ಹಾತೆ ರ‍್ಹವಾನು ಮನಕ್ಹೊ ಎ ಕ್ಹಾರು ದೆಕಿನ ಯಹೊವಾ ಥಯಲ ಮಿ ಮಹಾ ಮಹಿಮಾ ಸ್ವರುಪ ವ್ಹೈ ಕೈನ ತಿಳ್ದಿಲಿಸ. <verse eid="EXO 34:10" /><verse number="11" style="v" sid="EXO 34:11" />ಮಿ ಎ ದಿನಮಾ ದಿವಾನಾ ಆಗನ್ಯಾನೆ ವಿದಯೆ ಥಾವೊ. ತುಮಾರಾ ದುಸಮನೊ ಥಯಲ ಅಮೊರಿಯರೊನೆ, ಕಾನಾನ್ಯರೊನೆ, ಹಿತ್ತಿವಾಲಾವೊನೆ, ಪೆರಜಿವಾಲಾವೊನೆ, ಹಿವ್ವಿವಾಲಾವೊನೆ ವರಿ ಯಬುಸಿವಾಲಾವೊನೆ ಮಿ ಭಾರೊ ಘಾಲುಸ. <verse eid="EXO 34:11" /><verse number="12" style="v" sid="EXO 34:12" />ಹುಶಾರ ಥಾವೊ! ತುಮೆ ಜಾ಼ವಾನಾ ದೆಶಮಾ ರ‍್ಹವಾನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಕಯುಜ಼ ಒಪ್ಪಂದ ಕರಲಿವೊ ನಕೊ. ತುಮೆ ತೆ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಕಯುಬಿ ಒಪ್ಪಂದ ಕರಲಿದ್ಯಾರೆ, ತೆ ತುಮೊನೆ ಇದಿ ಆವಾ ವರಕ್ಹೊ ಕರುಸ. <verse eid="EXO 34:12" /><verse number="13" style="v" sid="EXO 34:13" />ತುನಿ ಜ಼ಗಾವೊನೆ ನಾಶ ಕರೊ. ತ್ಯುನೆ ಪೂಜಾ ಕರಾನಾ ದಗ್ಡಾವೊನೆ ಫೊಡಿ ಪಾಡೊ. ತ್ಯುನಾ ಮರ್ತಿಯೊನೆ ಕತ್ರಿ ಪಡೊ. <verse eid="EXO 34:13" /><verse number="14" style="v" sid="EXO 34:14" />ಬಿಜಾ಼ ಕಯಾಜ಼ ಕ್ಹುದಾನೆ ಪೂಜಾ ಕರೊ ನಕೊ. ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ‘ಸ್ವಂತ ಮರಯಾದಿ ವಚಾ಼ಡಿ ಲಿವಾಲೊ’ ಕವಾನು ಮಾರು ನಾಮ ವ್ಹೈ. <verse eid="EXO 34:14" /><verse number="15" style="v" sid="EXO 34:15" />"ಹುಶಾರ ಥಾವೊ, ತೆ ದೆಶಮಾ ರ‍್ಹವಾನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಕಯುಜ಼ ಒಪ್ಪಂದ ಕರಲಿವೊ ನಕೊ ನೈ ಥಯಮಾ ತ್ಯುನ ತ್ಯುನಾ ಕ್ಹುದಾವೊನೆ ಪೂಜಾ ಕರ್ತಾಮಾ ತುಮೆ ತ್ಯುನಅ ಕ್ಹಾತೆ ಸೆರಸಿ ಲಿವೊಸಿ. ತ್ಯುನಾ ಕ್ಹಾತೆ ಸೆರಾನಾ ನಿಂಗತ ತುಮೊನೆ ಸ್ವಾಗತ ಕರಸ; ತ್ಯುನೆ ಯಜ್ಞ ಚಡಾಯಲ ಕ್ಹಾವೊಸಿ. <verse eid="EXO 34:15" /><verse number="16" style="v" sid="EXO 34:16" />ತುಮೆ ತ್ಯುನಿ ದಿಕ್ರಿಯೊಮಾ ದಕ್ಹಾಜ಼ನಾವೊನೆ ತುಮಾರಾ ದಿಕ್ರಾವೊನೆ ಬೈಕೊ ಥಾವಾನಾಹುತಿ ಇನಿಲಿವೊಸಿ. ತ್ಯುನಿ ದಿಕ್ರಿಯೊ ಸುಳ್ಳ ಕ್ಹುದಾವೊನಾ ಬೊದನೆ ಕರಸ. ತುಮಾರಾ ದಿಕ್ರಾವೊನೆ ತ್ಯುನಾ ತೆಜ಼ ಸೆವಾನೆ ಚಲಾವಸ. <verse eid="EXO 34:16" /><verse number="17" style="v" sid="EXO 34:17" />ಮೂರ್ತಿಯೊನೆ ಕರಲಿವೊ ನಕೊ. <verse eid="EXO 34:17" /><verse number="18" style="v" sid="EXO 34:18" />"ಕ್ಹಾಟೂ ನೈ ರ‍್ಹಯಲ ರೊಕ್ಲಾನಾ ಸನ್ನನೆ ಕರೊ. ಮಿ ತುಮೊನೆ ಪೈಲಾ ಆಗನ್ಯಾ ದಿದಲ ನಿಂಗತ ಕ್ಹಾಟು ನೈ ರ‍್ಹಯಲ ರೊಕ್ಲಾನೆ ಕ್ಹಾತ ದಿನ್ನ ಲಕ್ಕಾ ಕ್ಹಾವೊ. ಮಿ ಇನಿಲಿದಲ ಅಬಿಬ ಮಾಸಮಾ ಆಂ ಕರೊ. ಕಾ ಕದ್ಯಾಮ ತೆ ಮ್ಹೈನಾಮಾ ತುಮೆ ಐಗುಪ್ತತಾ ಬಿಡಗಡೆ ಹೊಂದ್ಯಾಸ. <verse eid="EXO 34:18" /><verse number="19" style="v" sid="EXO 34:19" />" ಬಾಕ್ಡಿಯೊಮಾ ಹುಟ್ಟಲ ಪೈಲಾ ಬಚ್ಚು ಕೆಳಾಮಾಬಿ ಮನೆ ಸೆರಲ ವ್ಹೈ. ತುಮಾರಾ ಬೈಲೊ ಬಕ್ರಾಮಾ ಪೈಲಾ ಹುಟ್ಟಲ ಗಂಡ ಬಚ್ಚಾವೊ ಮನೆ ಸೆರಲ ಥಯಾಸ. <verse eid="EXO 34:19" /><verse number="20" style="v" sid="EXO 34:20" />ಪೈಲಾ ರ‍್ಹಯಲ ಗದ್ಡಾನೆ ತುಮೆ ಮ್ಹೆಲ್ಲಿವಾನೆ ಆಸ ಕರ್ಯಾಮ, ತೆಳಾಮಾ ತುಮೆ ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ನೆ ದಿನ ತಿನೆ ಛೊಡಿಲೆ ಸಕೊಸಿ. ತಿನಿ ಗರ್ದನ ತೊಡಿನ ಕಲಾಸ ಕರು.ತುಮೆ ತುಮಾರಾ ಕ್ಹಾರ ಪಸ್ಟ ಗಂಡ ಬಚ್ಚಾ಼ವೊನೆ ಮಕನತಾ ಲ್ಯು.</para>
  <para style="p" vid="EXO 34:20">ಕಯೊಬಿ ವ್ಯಕ್ತಿ ಕಾಣಿಕೆ ನೈಸೊ ಮಾರಾ ಸನ್ನಿದಿನೆ ಔ ನೈ .<verse eid="EXO 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21" />" ತುಮೆ ಅಟ್ವಾಡಾಮಾ ಛೆ ದಿನ ಕಾಮ ಕರೊಸಿ. ತೆ ನೈಸೊ ಕ್ಹಾತವಾ ದಿನಮಾ ತುಮೆ ಅರಾಮ ಕರು. ತುಮೆ ಬಿತ್ತಾನು ವರಿ ಕಾಟಾನಾ ಟೈಮ್ಮಾ ಅರಾಮ ಕರು. <verse eid="EXO 34:21" /><verse number="22" style="v" sid="EXO 34:22" />"ಅಟ್ವಾಡಾನಾ ಸನ್ನೊನೆ ಕರೊ. ಆಂ ಸನ್ನನಾಹುತಿ ಘೌಂ ದಾಳನಾ ಪೈಲಾ ಕಾಳನೆ ಉಪಯೊಗ ಕರೊ ವರಿ ವರಕ್ಹಮಾ ಸುಗ್ಗಿ ಸನ್ನನೆ ಕರೊ. <verse eid="EXO 34:22" /><verse number="23" style="v" sid="EXO 34:23" />"ವರಕ್ಹಮಾ ತನ್ನ ಸಲಾ ತುಮಾರಾ ರ‍್ಹವಾನಾ ದಾಣ್ಗಾ ಕ್ಹಾರಾ, ಇಸ್ರಾಯಲನೊ ಕ್ಹುದಾ ಥಯಲ ಮಾಲಕ ಥಯಲ ಯಹೊವಾನಾ ಸನ್ನಿದಿಮಾ ಸೆರು. <verse eid="EXO 34:23" /><verse number="24" style="v" sid="EXO 34:24" />" ತುಮೆ ದೆಶನಾ ಮ್ಹೈ ಜಾ಼ತಾಮಾ, ಮಿ ತುಮಾರಾ ದುಸ್ಮನೊನೆ ತೆ ದೆಶತೊ ಭಾರೊ ಘಾಲುಸ. ಮಿ ತುಮಾರಾ ಜನಾಂಗ ಜಾಸ್ತಿ ಕರಸ. ತುಮೊನೆ ಹೆಚ್ಚ ಥಯಲ ಜಿಮಿನ ಮಳಸ. ಹರ ವರಕ್ಹೆ ತನ್ನ ಸಲಾ ತುಮೆ ತುಮಾರಾ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ಸನ್ನಿದಿನೆ ಜಾ಼ವೊಸಿ. ತೆ ಟೈಮ್ಮಾ ಕುನಬಿ ತುಮಾರಾತಾ ಜಿಮಿನೆ ಕಾಳ್ಳಿವಾನೆ ಕೊಶಿಸ ನೈ ಕರ್ತಾ.<verse eid="EXO 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25" />"ತುಮೆ ಯಜ್ಞ ಕರ್ತಾಮಾ ತ ಯಜ್ಞನಾ ಪಶುನೆ ರಗತನಾ ಕ್ಹಾತೆ ಕ್ಹಾಟಾ ಲೊಟನೆ ಚಡೌ ನೈ; "ಪಸ್ಕ ಬೊಜನಾ ಮಾಕ್ಹಮಾ ಸುಜ ಅಗಲ್ಯಾ ದಿನ್ನ ಪಾಟಲಕ್ಕಾ ಉಗ್ರಾಡು ನೈ. <verse eid="EXO 34:25" /><verse number="26" style="v" sid="EXO 34:26" />"ತುಮೆ ಕಾಟಾನು ಪೈಲಾ ಫಲ ರ‍್ಹಯಲ ಬೆಳೆಯೊನೆ ಯಹೊವಾನೆ ದಿವೊ. ತಿನೆ ತುಮಾರಾ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ಆಲಯನೆ ಲಾವೊ "ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ನೆ ತಿನಾಯಾನಾ ದುದ್ದಮಾ ಕೆಳಾಮಾಬಿ ಉನ್ನು ಕರು ನೈ.” <verse eid="EXO 34:26" /><verse number="27" style="v" sid="EXO 34:27" />ಪಾಚಾತೊ ಯಹೊವಾ ಮೊಶೆನೆ, " ಮಿ ತುನೆ ಕದಲ ಕ್ಹಾರಾ ಸಂಗತಿಯೊನೆ ಲಕ್ಕ. ತೆ ಸಂಗತಿಯೊ ಮಿ ತಾರಾಕ್ಹಾತೆ ವರಿ ಇಸ್ರಾಯಲನಾ ಕ್ಹಾತೆ ಕರಲ ಒಡಂಬಡಿಕೆ ಥಯಿಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 34:27" /><verse number="28" style="v" sid="EXO 34:28" />ಮೊಶೆ ತ್ಯಾ ಯಹೊವಾನಾ ಕ್ಹಾತೆ ದಿನ ರಾತ ಚಾಳಕ್ಹ ದಿನ ವ್ಹತ್ತೊ. ತೆ ದಿನೊಮಾ ತಿನು ಆಹಾರ ರ‍್ಹೈತಬಿ ಪಾನಿನೆ ರ‍್ಹೈತಬಿ ಕ್ಹಾದ್ಯೊಜ ನೈ. ಒಡಂಬಡಿನಾ ವಾಕ್ಯಾವೊನೆ ಕದ್ಯಾಮ ದಕ್ಹ ಆಗನ್ಯಾವೊನೆ ಬೆ ದಗ್ಡಾನಾ ಹಲಿಗಿಯೊಪರ ಬರದ್ಯೊ.<verse eid="EXO 34:28" /></para>
  <para style="s">ಮೊಶೆ ಸಿನಾಯ ಡೊಂಗರಪರ್ತೊ ಉತ್ರಲ</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 34:29" />ತೆ ಥಯಲ್ಪರ ಮೊಶೆ ಸಿನಾಯ ಡೊಂಗರತೊ ಉತ್ರಿನ ಆಯೊ ಒಡಂಬಡಿಕೆನಾ ವಾಕ್ಯಾ ಲಿಕ್ಕಲ ಬೆ ದಗ್ಡಾನಾ ಹಲಿಗಿಯೊನೆ ತೆ ಧರಲಿದ್ಯೊತೊ. ಯಹೊವಾ ತಿನಾಕ್ಹಾತೆ ಬೊಲಲಕ್ಹು ತಿನೊ ಮ್ಹೊಡು ಮಿಂಚಾಡುತು. ತೆನೈಸೊ ಮೊಶೆನೆ ಆಂ ತಿಳ್ದುನ್ಹೊತು. <verse eid="EXO 34:29" /><verse number="30" style="v" sid="EXO 34:30" />ಮೊಶೆನು ಮ್ಹೊಡು ಮಿಂಚಾನು ಆರೊನಬಿ ಇಸ್ರಾಯೆಲೊ ಕ್ಹಾರಾ ದೆಕ್ಯಾ. ತಿನಾಹುತಿ ತಿಕನ ಜಾ಼ವಾನೆ ತ್ಯುನೆ ಬುಚ್ಕ್ಯಾ. <verse eid="EXO 34:30" /><verse number="31" style="v" sid="EXO 34:31" />ತೆ ನೈಸೊ ಮೊಶೆ ತ್ಯುನೊನೆ ಬಲಾಯೊ. ತಿನಾಹುತಿ ಆರೊನಬಿ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಮೊಶೆ ಕನ ಗಯಾ. ಮೊಶೆ ತ್ಯುನಾಕ್ಹಾತೆ ಬೊಲ್ಯೊ. <verse eid="EXO 34:31" /><verse number="32" style="v" sid="EXO 34:32" />ತೆ ಥಯಲ್ಪರ, ಇಸ್ರಾಯೆಲೊ ಕ್ಹಾರಾ ಮೊಶೆಕನ ಆಯಾ. ಯಹೊವಾ ಸಿನಾಯಿ ಡೊಂಗರಪರ ತಿನೆ ದಿದಲ ಆಗನ್ಯಾವೊನೆ ಮೊಶೆ ತ್ಯುನೊನೆ ದಿದ್ಯೊ. <verse eid="EXO 34:32" /><verse number="33" style="v" sid="EXO 34:33" />ಮೊಶೆ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಿನ ಕ್ಹರಾಯಲ್ಪರ, ತಿನ ಮ್ಹೊಡಾಪರ ಮುಸುಕ ಘಾಲ್ಲಿಲಿದ್ಯೊ. <verse eid="EXO 34:33" /><verse number="34" style="v" sid="EXO 34:34" />ಮೊಶೆ ಯಹೊವಾನಾ ಕ್ಹಾತೆ ಬೊಲಾನೆ ತಿನಾ ಸನ್ನಿದಿನೆ ಗಯಲ ಟೈಮಾ ಮೊಶೆ ಮುಸಕ ಕಾಡಿನ ಮ್ಹೆಲ್ತೊತೊ. ಪಾಚಾತೊ ಮೊಶೆ ಭಾರೊ ಐನ ಯಹೊವಾ ಆಗನ್ಯಾ ಕರಲ ಸಂಗತಿಯೊನೆ ಇಸ್ರಾಯೆಲೊನೆ ತಿಳ್ಸಾತೊತೊ. <verse eid="EXO 34:34" /><verse number="35" style="v" sid="EXO 34:35" />ಮೊಶೆನು ಮ್ಹೊಡು ಮಿಂಚಾನು ಮನಕ್ಹೊ ದೆಕ್ಯಾ. ತಿನಾಹುತಿ ಮೊಶೆ ಅಗಲ್ಯಾ ಟೈಮಾ ಯಹೊವಾನಾ ಕ್ಹಾತೆ ಬೊಲಾನು ಗಯೆಲಕ್ಕಾ ತಿನಾ ಮ್ಹೊಡಾನೆ ಮುಸಕ ಘಾಲ್ಲಿಲಿದಲ ರ‍್ಹವಸ.<verse eid="EXO 34:35" /></para>
  <chapter eid="EXO 34" />
  <chapter number="35" style="c" sid="EXO 35" />
  <para style="s">ಸಬ್ಬತ ದಿನ್ನನಾ ನಿಯಮೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1" />ಮೊಶೆ ಇಸ್ರಾಯಲ ಮನಕ್ಹೊನೆ ಯಕ್ಕ ಜ಼ಗಾಕನ ಕುಡ್ಸಾಯೊ. ಮೊಶೆ ತ್ಯುನೊನೆ, " ತುಮೆ ಅನುಸರಶು ಕೈನ ಯಹೊವಾ ತುಮೊನೆ ಆಗನ್ಯಾ ಕರಲ ಸಂಗತಿಯೊನೆ ಮಿ ಕೌಸ: <verse eid="EXO 35:1" /><verse number="2" style="v" sid="EXO 35:2" />ಕಾಮ ಕರಾನೆ ಛೆ ದಿನೊ ಛೆ. ತೆನೈಸೊ ಕ್ಹಾತವಾ ದಿನ ತುಮೊನೆ ಘನ್ನು ಚೊಕು ಥಯಲ ಅರಾಮ ಕರಾನೊ ದಿನ ಥಾವಸ. ತೆ ಕ್ಹಾಸ ದಿನಮಾ ಅರಾಮ ಕರಾನಾಹುತಿ ತುಮೊ ಯಹೊವಾನೆ ಸನ್ಮಾನ ಕರೊಸಿ. ಕ್ಹಾತವಾ ದಿನಮಾ ಕಾಮ ಕರಾಲೊ ಮನಕ್ಹ ಕ್ಹಲಾಸ ಥವು. <verse eid="EXO 35:2" /><verse number="3" style="v" sid="EXO 35:3" />ತುಮೆ ರ‍್ಹವಾನಾ ಕಯಾ ಜ಼ಗಾಮಾ ವ್ಹೈ ಕವಾನು ಸಬ್ಬತ ದಿನ ವ್ಹೈ ಕೈನ ಆಗನೆ ಲಗಾಡು ನೈ” ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 35:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4" />ಮೊಶೆ ಇಸ್ರಾಯೆಲೊನೆ, "ಯಹೊವಾ ಆಗನ್ಯಾ ಕರಲ ಆಜ ವ್ಹೈ. <verse eid="EXO 35:4" /><verse number="5" style="v" sid="EXO 35:5" />ಯಹೊವಾನಾಹುತಿ ಕಾಣಿಕೆ ಜಮಾಕರೊ. ತುಮಾರೊಮಾ ಹರಯಕ್ಲೊ ತೆ ದಿವಾನು ತಿನಾ ಮನಸಮಾ ತಿರ್ಮಾನ ಕರು. ಪಾಚಾತೊ ತೆ ಕಾಣಿಕೆನೆ ಯಹೊವಾನಾ ಸನ್ನಿದಿನೆ ಲೌ. ಕ್ಹೊನು, ರುಪ್ಪೂ, ತಾಂಬು, <verse eid="EXO 35:5" /><verse number="6" style="v" sid="EXO 35:6" />ನಿಲಿ, ಜಾ಼ಮ್ಳಾನುಕಲರ, ಲಾಲ ದೊರೊ ವರಿ ಕ್ಹಾಸ ಚೊಕಾ ವಣ್ಣಾ, ಬಕ್ರಾನಾ ಬಾಲೊನಾ ವಣ್ಣಾ, <verse eid="EXO 35:6" /><verse number="7" style="v" sid="EXO 35:7" />ಲಾಲ ರಂಗನಾ ಬಕ್ರಾನು ಚಾಮ್ಡು, ಸಮುಂದರನು ಡುಕ್ಕರನು ಚಾಮ್ಡು, ಕಾಟಾನು ಝಾಡ, <verse eid="EXO 35:7" /><verse number="8" style="v" sid="EXO 35:8" />ದಿವಾನೆ ಚಾ಼ಯೆ ಥಯಲ ತೆಲ, ಅಬಿಷಕನು ತೆಲ ವರಿ ಚೊಕಿ ಬಾಸನು ಉದನೆ ತಯಾರ ಕರಾನೆ ಚಾ಼ಯೆ ಥಯಲ ಚೊಕಿ ಬಾಸನಾ ಸಾಮ್ನೊನೆ ಲಾವೊ. <verse eid="EXO 35:8" /><verse number="9" style="v" sid="EXO 35:9" />ಮಹಾ ಯಾಜಕನಾ ಕವಚನೆ ಚಾಯ ಥಯಲ ರತ್ನವೊ ಪಿಶಿನಾ ಪದಕನಾ ಕೆತ್ತಾನಾ ರತ್ನೊ ಛೆ.<verse eid="EXO 35:9" /></para>
  <para style="s">ಯಹೊವಾನಿ ಗುಡಾರನಾ ಲೆಖನೆ</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10" />ತುಮೊಮ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ಗ್ಯಾನಿಯೊ ಐನ ಯಹೊವಾ ಆಗನ್ಯಾ ದಿದಲ ಕ್ಹಾರು ಕರು. <verse eid="EXO 35:10" /><verse number="11" style="v" sid="EXO 35:11" />ತ್ಯುನೆ ಕರಾನಾ ಕಾಮೊ ಕಯಾ ವ್ಹೈ ಕದ್ಯಾಮ ಕ್ಹುದಾನಾ ದರ್ಶನು ಝೊಪ್ಡು, ತಿನಾ ಮೆಲಹೊದಿಕೆ, ತಿನಾ ಕೊಂಡಿಯೊ, ಚೌಕಟ್ಟೊ, ತಿನಾ ಅಡ್ಡ ಪಟ್ಟಿಯೊ, ಕ್ಹಂಬಾ, ಗದಗಿನಾ ದಗ್ಡಾ, <verse eid="EXO 35:11" /><verse number="12" style="v" sid="EXO 35:12" />ಅಜ್ಞಾ ಶಾಸನೊನಾ ಮಂಜುಷ, ತಿನೆ ಉಚಾವಾನಾ ಲಾಕ್ಡಿಯೊ, ಕೃಪಾಸನ, ತಿನೆ ಝಾಕಾನೊ ಪಡ್ದೊ, <verse eid="EXO 35:12" /><verse number="13" style="v" sid="EXO 35:13" />ಟೆಬಲ, ತಿನಾ ಲಕ್ಡಿಯೊ ತಿನಾ ಸಾಮ್ನೊ, ತಿಪರ ಮ್ಹೆಲಾನಾ ಪರಿಶುದ್ದ ರೊಕ್ಲಾ, <verse eid="EXO 35:13" /><verse number="14" style="v" sid="EXO 35:14" />ದಿಪಸ್ತಂಬ, ತಿನಾ ಸಾಮ್ನೊ, ಸಮಯೊ, ದಿವಾನೆ ಚಾ಼ಯೆ ಥಯಲ ತೆಲ, <verse eid="EXO 35:14" /><verse number="15" style="v" sid="EXO 35:15" />ಉದನಾ ಧವಾಂಡಾನೊ ಕಟ್ಟೊ, ತಿನಾ ಲಾಕ್ಡಿಯೊ, ಅಬಿಷೆಕನು ತೆಲ, ಚೊಕ ಬಾಸನು ಉದ, ಝೊಪ್ಡಾನು ಬಾಕಲನೊ ಪಡ್ದೊ, <verse eid="EXO 35:15" /><verse number="16" style="v" sid="EXO 35:16" />ಯಜ್ಞವೆದಿ, ತಿನು ತಾಂಬಾನಿ ಜಾಳಗಿ, ಲಾಕ್ಡಿಯೊ, ಸಾಮ್ನೊ, ಥಾಳೊ, ತಿನು ಪಿಠ, <verse eid="EXO 35:16" /><verse number="17" style="v" sid="EXO 35:17" />ಅಂಗಳನಾ ಪಡ್ದಾ, ಕಂಬಾ, ಗದಗಿನಾ ದಗ್ಡಾ, ಅಂಗಳನಾ ಬಾಕಲನಾ ಪಡ್ದಾ, <verse eid="EXO 35:17" /><verse number="18" style="v" sid="EXO 35:18" />ಝೊಪ್ಡಾನಾ ಗುಟ, ಅಂಗಳನಾ ಗುಟ, ಇವ್ನಾ ರಾಕ್ಹೊ, <verse eid="EXO 35:18" /><verse number="19" style="v" sid="EXO 35:19" />ಪವಿತ್ರ ಜ಼ಗಾನೆ ಸೆವೆನೆ ಚಾ಼ಯೆ ಥಯಲ ಚೊಕಾ ರ‍್ಹಯಲ ದಿಕ್ಷಆ ದಿವಾನಾ ವಣ್ಣಾ ಕದ್ಯಾಮ ಮಹಾ ಯಾಜಕ ಥಯಲ ಆರೊನನೆ ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆ ಚಯೆ ಥಯಲ ಯಾಜಕನಾ ವಣ್ಣಾ ಆಜ ವ್ಹೈ ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 35:19" /></para>
  <para style="s">ಮನಕ್ಹೊ ಲಾಯಲ ತ್ಯುನಾ ಕಾಣಿಕೆ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20" />ಇಸ್ರಾಯಲನಾ ಸಮೂಹನಾ ಕ್ಹಾರಾ ಮೊಶೆನಾ ಕ್ಹಾಮಾತಾ ಗಯಲ್ಪರ <verse eid="EXO 35:20" /><verse number="21" style="v" sid="EXO 35:21" />ಕಿನೆಕಿನೆಬಿ ಮನಸ ಸು ಕದ್ಯು ಕಿನು ಕಿನು ಮನಸ ಸಿದ್ದ ವ್ಹತ್ತು ತ್ಯುನೆ ಕ್ಹಾರಾ ಐನ ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಝೊಪ್ಡಾನಾ ಕಾಮನಾಹುತಿ ತಿನಾ ಪೂರಾ ಸೆವಾನಾಹುತಿ ದಿಕ್ಷಾ ವಣ್ಣಾವೊನಾಹುತಿ ಯಹೊವಾನೆ ಕಾಣಿಕೆ ಲಾಯಾ. <verse eid="EXO 35:21" /><verse number="22" style="v" sid="EXO 35:22" />ಸಿದ್ದ ಥಯಲ ದಾಣ್ಗಾ ಬಾಕ್ಡಿಯೊ ಐನ ಯಹೊವಾನ ಕ್ಹೊನಾನಿ ಕಾಣಿಕೆನೆ ಕದ್ಯಾಮ ಕಡು, ಕಾನಮಾನು, ಇಟ್ಟಿ, ನಕಲೆಸೊ, ಕ್ಹಾರಾ ತರಾನಾ ಕ್ಹೊನಾನಾ ಸಾಮನೊ <verse eid="EXO 35:22" /><verse number="23" style="v" sid="EXO 35:23" />ಕಿನಾಮಾ ನಿಲಿದ್ರುಮ ರಕ್ತ ವರ್ಣಗಳಳ್ಳ ದೊರಾ ಚೊಕಾ ವಣ್ಣಾ ಬಕ್ರಾನಾ ಬಾಲೊನಾ ವಣ್ಣಾ ಹದಕರಲ ಲಾಲ ರಂಗನಾ ಬಕ್ರಾನು ಚಾಮ್ಡು ಡುಕ್ಕರನು ಚಾಮ್ಡು ವ್ಹತ್ತು ತ್ಯುನೆ ತೆಕ್ಹಾರು ಲೈನ ದಿದ್ಯಾ. <verse eid="EXO 35:23" /><verse number="24" style="v" sid="EXO 35:24" />ಕಿಕನ ರುಪ್ಪು ನತ್ತಿ ತಾಂಬು ವ್ಹತ್ತು ತ್ಯುನೆ ತೆ ಕ್ಹಾರು ಲೈನ ಯಹೊವಾನೆ ಒಪ್ಸ್ಯಾ.ಕಿಕನ ಝೊಪ್ಡಾನಾ ಕಮನೆ ಚಾ಼ಯೆ ಥಯಲ ಕಾಟಾನು ಝಾಡ ವ್ಹತ್ತು, ತ್ಯುನೆ ತಿನೆ ಲೈನ ದಿದ್ಯಾ. <verse eid="EXO 35:24" /><verse number="25" style="v" sid="EXO 35:25" />ಶ್ಯಾಣಿಯೊ ರ‍್ಹಯಲ ಬಾಕ್ಡಿಯೊ ತ್ಯುನಾ ಹತೊಕ್ಹು ನಿಲಿ ದುಮ್ರ ಘನ್ನು ಲಾಲ ರ‍್ಹಯಲ ನೂಲನೆ ನಾರಿನ ನೂತ ತೆ ನೂಲನೆ ಲೈನ ದಿದ್ಯಾ. <verse eid="EXO 35:25" /><verse number="26" style="v" sid="EXO 35:26" />ಬಿಜಾ಼ ಗ್ಯಾನ ರ‍್ಹಯಲ ಬಾಕ್ಡಿಯೊ ಬಕ್ರಾನಾ ಬಾಲೊನೆ ಪರೈನ ಲೈನ ದಿದ್ಯಾ. <verse eid="EXO 35:26" /><verse number="27" style="v" sid="EXO 35:27" />ಅದಿಪತಿಯೊ ಮಹಾ ಯಾಜಕನಾ ಕವಚನೆ ಚಾ಼ಯೆ ಥಯಲ ಗೊಮೆದಕ ರತ್ನನಿ ಪಿಶಿನಾ ಪದಕಮಾ ಕೆತ್ತಾನಾ ರತ್ನೊನೆ <verse eid="EXO 35:27" /><verse number="28" style="v" sid="EXO 35:28" />ದಿವಾನೆ ಚಾ಼ಯೆ ಥಯಲ ತೆಲನೆ ಅಬಿಷೆಕ ತೆಲನೆ ವರಿ ಚೊಕಿಬಾಸನು ಉದನೆ ಚಾ಼ಯೆಥಯಲ ಚೊಕಿನಾ ಬಾಸನಾ ದ್ರವ್ಯನೆ ಲೈನ ದಿದ್ಯಾ. <verse eid="EXO 35:28" /><verse number="29" style="v" sid="EXO 35:29" />ಮೊಶೆನಾ ಮೂಲಕ ಯಹೊವಾ ಆಜ್ಞಾಕರಲ ಕ್ಹಾರಾ ಕಾಮೊನಾಹುತಿ ತಿನೆ ಕಾಣಿಕೆ ಲೈನ ದಿನ ಇಸ್ರಾಯಲನಾ ದಾಣ್ಗಾ ಬಾಕ್ಡಿಯೊ ಕ್ಹಾರಾ ಪೂರಾ ಮನಸಕ್ಹೊ ದಿದ್ಯಾ.<verse eid="EXO 35:29" /></para>
  <para style="s">ಯಹೊವಾನಿ ಸನ್ನಿದಿನಾ ಗುಡಾರನು ಕಾಮ ಕರಾಲಾ</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30" />ವರಿ ಮೊಶೆ ಇಸ್ರಾಯಲ ಮನಕ್ಹೊನೆ ಅಮ್ಮ ಕದ್ಯೊ ಚೊಕಿತರಾ ನರಮ ಕಾಮೊನೆ ಕರಾನೆ ಯಹುದನಾ ಕುಲನೂ ಥಯಲ ಹುರನೊ ನಾತ್ನೊ ಉರಿನೊ ದಿಕ್ರೊ ಥಯಲ ಬೆಚಲ ಕವಾನಾ ಯಕ್ಲಾನೆ ಗ್ವತ್ತ ಕರಿನ ನೆಮ್ಸೊ <verse eid="EXO 35:30" /><verse number="31" style="v" sid="EXO 35:31" />ತಿನೆ ದಿವ್ಯಾ ಆತ್ಮಾನೆ ದಿನ ಚಾ಼ಯೆ ಥಯಲ ಗ್ಯಾನನಾ ವಿದ್ಯಾ ವಿವೆಕೊನೆ ಚೊ಼ಕು ರ‍್ಹಯಲ ಶಾಸ್ತ್ರನಿ ಗ್ಯಾನನೆ ದಿದ್ಯೊಸ. <verse eid="EXO 35:31" /><verse number="32" style="v" sid="EXO 35:32" />ಕಹಾರಾ ಶೃಂಗಾರನಾ ಕಾಮೊ ಕರಾನೆ ಕ್ಹೊನು ರುಪ್ಪು ತಾಂಬಾಕ್ಹು ಕಾಮ ಕರಾನಾಹುತಿ <verse eid="EXO 35:32" /><verse number="33" style="v" sid="EXO 35:33" />ರತ್ನ ಕೆತ್ತಾನಾಹುತಿ ಝಾಡಾಮಾ ವಿಚಿತ್ರ ಥಯಲ ಕತ್ತನು ಕಾಮ ಕರಾನಾಹುತಿ ಬಿಜಾ಼ ಥಯಲ ಶೃಂಗಾರ ಥಯಲ ಕಾಮ ಕರಾನಾಹುತಿ ಯಹೊವಾ ಇನಿಲಿದ್ಯೊಸ. <verse eid="EXO 35:33" /><verse number="34" style="v" sid="EXO 35:34" />ತೆನೈಸೊ ಹಜಿಯಕ್ಲಾನೆ ಸಿಕ್ಲೈನ ದಿವಾನಾಹುತಿ ತಿನೆಬಿ ದಾನ ಕುಲನಾ ಅಹಿಸಾಮಕನೊ ದಿಕ್ರೊ ಥಯಲ ಒಹೊಲಿಯಾಬನೆ ತಾಕತ ದಿದ್ಯೊಸ. <verse eid="EXO 35:34" /><verse number="35" style="v" sid="EXO 35:35" />ಕಲೆಗಾರ ಚಮತ್ಕಾರ ಥಯಲ ಕರಾಲಾ, ನಿ ಘನ್ನು ಲಾಲ ರ‍್ಹಯಲ ದೊರಾಕ್ಹು ಚೊಕಾ ವಣ್ಣಾಕ್ಹು ಬುಟೆದಾರಿ ಕಾಮ ಕರಾಲಾ, ಆಜು಼ಬಾಜು಼ವಾಲಾ, ರ‍್ಹೈತಬಿ ಕ್ಹಾರಾ ಕಾಮ ಕರಾಲಾ ಕರಾನಾ ಕಾಮೊನೆ ಕರಾನಾಹುತಿ ಯಹೊವಾ ತ್ಯುನೊನೆ ಗ್ಯಾನ ಪೂರಾಜ ದಿದ್ಯೊಸ.<verse eid="EXO 35:35" /></para>
  <chapter eid="EXO 35" />
  <chapter number="36" style="c" sid="EXO 36" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 36:1" />ಬೆಚಲೆಲನ ಒಹೊಲೀಯಾಬ ಕ್ಹಾರುಜ಼ ಯಹೊವಾ ಅಗನ್ಯಾ ದಿದಲ ನಿಂಗತಜ಼಼ ಕರಸ; ವರಿ ಬಿಜಾ಼ ಗ್ಯಾನಿಯೊ ಕ್ಹಾರಾ, ಕದ್ಯಾಮ ಯಹೊವಾಕ್ಹುಜ ಗ್ಯಾನಾ ವಿವೆಕೊನೆ ಹೊಂದಿಲಿನ ಕ್ಹುದಾನಾ ಮಂದಿರನೆ ಕರಾನಾ ಕಾಮನಾ ಹುತಿ ಪವಿತ್ರ ಗುಡಾರ ಭಾಂದಾನೆ ಚಾ಼ಯೆ ಥಯಲ ಬಿಜಾ಼ಬಿಜಾ಼ ಸಾಮ್ನೊನೆ ಕರಾನೆ ಗ್ಯಾನ ತಿಳ್ದಲವಾಲಾ, ತ್ಯುನಾ ಕ್ಹಾತೆ ಕಾಮ ಕರಸ ಕೈನ ಕದ್ಯೊ.<verse eid="EXO 36:1" /></para>
  <para style="s">ಮನಕ್ಹೊ ಲಾಯಲ ಘನ್ನಿ ಕಾಣಿಕೆ</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2" />ಬೆಚಲೆಲಬಿ ಒಹೊಲಿಯಾಬನೆಬಿ ವರಿ ಕಿನಾ ಕಿನಾ ಮನಸಮಾ ಯಹೊವಾ ಗ್ಯಾನ ಮ್ಹೆಲ್ಯೊತೊ ಕಿನೆಕಿನೆಬಿ ಎ ಕಾಮ ಕರಾನಾಹುತಿ ಮನಸ ನರಮ ತೆ ಗ್ಯಾನಿಯೊ ಕ್ಹಾರಾವೊನೆ ಮೊಶೆ ತಿನಾ ಕ್ಹಾಮೊ ಬಲಾಯೊ. <verse eid="EXO 36:2" /><verse number="3" style="v" sid="EXO 36:3" />ತ್ಯುನೆ ಕ್ಹುದಾನು ಪವಿತ್ರ ಗುಡಾರ ಕರಾನಾ ಕಆಮನೆ ಇಸ್ರಾಯೆಲೊ ಲಾಯಲ ಪೂರಾ ಕಾಣಿಕೆ ಮೊಶೆನೆ ಹತ್ಮಾತು ಕಾಳ್ಳಿದ್ಯಾ. ಇಸ್ರಾಯೆಲೊ ಹರ ದಿನ್ನೆ ಹೊತ್ತಾರೆಮಾ ಮಶೆಕನ ಐನ ಜಾಸ್ತಿ ಕಾಣಿಕೆ ತ್ಯುನಾ ಮನಸಕ್ಹು ದಿವಾಡಾತಾ. <verse eid="EXO 36:3" /><verse number="4" style="v" sid="EXO 36:4" />ತೆಳಾಮಾ ಕ್ಹುದಾನಿ ಮಂದಿರನೆ ಕಾಮ ಕರಾಲಾ ತೆ ಗ್ಯಾನಿಯೊ ಕ್ಹಾರಾ ತ್ಯುನಾ ತ್ಯುನಾ ಕಾಮೊ ಛೊಡಿನ ಮೊಶೆಕನ ಐನ ತಿನೆ <verse eid="EXO 36:4" /><verse number="5" style="v" sid="EXO 36:5" />ಯಹೊವಾ ಆಗನ್ಯಾ ದಿದಲ ಕಾಮನೆ ಚಾ಼ಯೆ ಥಯಲ ಅಕ್ಲುತಿ ಘನ್ನು ಹೆಚ್ಕಿಜ ಲಾವಾಡಾತಾ ಮನಕ್ಹೊ ಕಾಣಿಕೆ ಲಾವಾಡಾಸ ಕೈನ ಕತಾಮಾ ಮೊಶೆ<verse eid="EXO 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 36:6" />ಕ್ಹುದಾನಾ ಮಂದಿರನಾ ಮಾನಾಹುತಿ ಕಯೊ ದಾಣ್ಗೊ ರ‍್ಹೈತಬಿ ಬಾಕ್ಡಿ ರ‍್ಹೈತಬಿ ಹಜಿ ಲಕ್ಕಾ ಕ್ಹಾಮೊ ಕಯುಜ಼ ಸಿದ್ದ ಕರು ನೈ ಕೈನ ಅಪ್ಪಣೆ ಕರಿನ ಪಾಳೆಮಾ ಪ್ರಕಟ ಕರಲ ಮನಕ್ಹೊನಾ ಕಾಣಿಕಿಯೊನೆ ಹುಬ್ರೈಪಡೊ. <verse eid="EXO 36:6" /><verse number="7" style="v" sid="EXO 36:7" />ಕಾಮ ಕರಾನಾಹುತಿ ಬಸ ಥಯೆಲಕ್ಕಾ ಹೆಚ್ಚ ಸಾಮ್ನೊ ವ್ಹತ್ತಾ.<verse eid="EXO 36:7" /></para>
  <para style="s">ಯಹೊವಾನಿ ಸನ್ನಿದಿನು ಗುಡಾರ ಕರಾನು</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8" />ಎ ಕಾಮವಲಾವೊಮಾ ಕ್ಹಾರಾ ಗ್ಯಾನಿಯೊ ನವಾ ನಾರಿನ ವಣ್ಣಾವೊಕ್ಹು ಝೊಪ್ಡು ಕರಿನ ತೆ ದಕ್ಹ ವಣ್ಣಾವೊಮಾ ನಿಲಿ ದುಮ್ರ ರಗತ ನಿಂಗತ ದೊರಾವೊಕ್ಹು ಕೆರುಬಿಯೊನೆ ಚಮ್ಕಾರ ಥೈನ ಕಸೂತಿ ಘಾಲಿನ ಕರ‍್ಯಾ. <verse eid="EXO 36:8" /><verse number="9" style="v" sid="EXO 36:9" />ಹರಯಕ್ಕ ಫಡ್ಕು 28 ಮಾರ ಲಾಂಬಾಮಾಬಿ 4 ಮಾರಬಿ ರುಂದಬಿ ವ್ಹತ್ತು.ಕ್ಹಾರಾ ವಣ್ಣಾ ಯಕ್ಕಜ ಅಳತಿ ಥಯಾತಾ. <verse eid="EXO 36:9" /><verse number="10" style="v" sid="EXO 36:10" />ಪಾಂಚ ಪಾಂಚ ವಣ್ಣಾಬಿ ಯಕ್ಕಜ ಥೈನ ಜೊಡಶ್ಯಾತಾ. <verse eid="EXO 36:10" /><verse number="11" style="v" sid="EXO 36:11" />ಎ ಬೆ ಜೊಡಿಮಾ ಯಕ್ಕಯಕ್ಕನೊ ಕೊನೊ ವಣ್ಣಾನಾ ಉಪ್ಪರ ನಿಲಿ ದೊರಾಕ್ಹು ಘೊಂಡಾನೆ ಕರ‍್ಯಾ; <verse eid="EXO 36:11" /><verse number="12" style="v" sid="EXO 36:12" />ತೆ ಘೊಂಡಾವೊನೆ ಐವತ್ತ ಐವತ್ತನಾ ಉಪ್ಪರ ಯಕ್ಕ ಯಕ್ಕನೆ ಕ್ಹಾಮಾ ಮ್ಹೆಲ್ಯಾ. <verse eid="EXO 36:12" /><verse number="13" style="v" sid="EXO 36:13" />ತೆನೈಸೊ ಐವತ್ತ ಕ್ಹೊನಾನಾ ಕೊಂಡಿಯೊನೆ ಕರಿನ ತೆ ವಣ್ಣಾವೊನೆ ಯಕ್ಕನೆ ಯಕ್ಕ ಜೊಡಸ್ಯಾ; ಅಮ್ಮ ಯಕ್ಕ ಝೊಪ್ಡು ಥಯು.<verse eid="EXO 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 36:14" />ಆ ಝೊಪ್ಡಾನಾ ಉಪ್ಪರ ಝಾಕಾನಾಹುತಿ ಬಕ್ರಾನಾ ಬಾಲೊನು ಗ್ಯಾರಾ ತಿನಾ ಫಡ್ಕಾವೊಕ್ಹು ತೆ ಝೊಪ್ಡಾನಾ ಉಪ್ಪರಲಿ ಗದಿಗಿ ಕರ‍್ಯಾ. <verse eid="EXO 36:14" /><verse number="15" style="v" sid="EXO 36:15" />ಯಕ್ಕಯಕ್ಕ ಪಡ್ಕು ಮೂವತ್ತ ಮೊಳಾ ಲಾಂಬುಬಿ ಚಾರ ಮೊಳಾ ರುಂದಬಿ ವ್ಹತ್ತು; ಕ್ಹಾರಾ ಫಡ್ಕಾ ಯಕ್ಕಜ ಅಳತಿ ಥಯಾತಾ. <verse eid="EXO 36:15" /><verse number="16" style="v" sid="EXO 36:16" />ಪಾಂಚ ಫಡ್ಕಾಬಿ ಯಕ್ಕ ಥೈನ ಜೊಡಸಿನ ಉಗ್ರಲ ಛೆ ಫಡ್ಕಾವೊನೆ ಯಕ್ಕ ಥೈನ ಜೊಡಸ್ಯಾ. <verse eid="EXO 36:16" /><verse number="17" style="v" sid="EXO 36:17" />ಯಕ್ಕ ಯಕ್ಕ ಫಡ್ಕಾನಾ ಲಾಸ್ಟನಾ ಮೂಲಾಮಾ ಐವತ್ತ ಐವತ್ತ ಘೊಂಡಾವೊನಾ ಕರ‍್ಯಾ. <verse eid="EXO 36:17" /><verse number="18" style="v" sid="EXO 36:18" />ಯಕ್ಕಜ ಗುಡಾರ ಥಯಲ ನಿಂಗತ ಪೂರಾ ಮಳಾವಾನಾಹುತಿ ತಾಂಬಾನಾ ಐವತ್ತ ಕೊಂಡಿಯೊ ಕರ‍್ಯಾ. <verse eid="EXO 36:18" /><verse number="19" style="v" sid="EXO 36:19" />ತೆನೈಸೊ ಹದನ ಕರಲ ಬಕ್ರಾನು ಚಾಮ್ಡಾಕ್ಹು ಯಕ್ಕ ಉಪ್ಪರ ವರಾಡಾನು ರಾನ ಡುಕ್ಕುರನಾ ಚಾಮ್ಡಾಕ್ಹು ವರಿಯಕ್ಕ ಉಪ್ಪರ ವರಾಡಾನೆ ಕರ‍್ಯಾ. <verse eid="EXO 36:19" /><verse number="20" style="v" sid="EXO 36:20" />ಝೊಪ್ಡಾನೆ ಚೌಕಟ್ಟೊ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಕರ್ಯಾ. <verse eid="EXO 36:20" /><verse number="21" style="v" sid="EXO 36:21" />ಹರಯಕ್ಕ ಚೌಕಟ ದಕ್ಹ ಮೊಳಾ ಲಾಂಬು ದೆಡ ಮೊಳಾ ರುಂದ ವ್ಹತ್ತು. <verse eid="EXO 36:21" /><verse number="22" style="v" sid="EXO 36:22" />ಹರಯಕ್ಕ ಚೌಕಟಿನಿ ಅಡ್ಡ ಪಟ್ಟಿಕ್ಹು ಜೊಡಸಾಯಲ ಬೆ ಕ್ಹಾಚಾವೊಕ್ಹು ವ್ಹತ್ತು; ಝೊಪ್ಡಾನಾ ಕ್ಹಾರಾ ಚೌಕಟೊನೆ ತಿನಾ ನಿಂಗತಜ಼಼ ಕರ‍್ಯಾ. <verse eid="EXO 36:22" /><verse number="23" style="v" sid="EXO 36:23" />ಝೊಪ್ಡಾನಾ ದಕ್ಷಿಣ ದಿಕ್ಕಮಾ ಇಕ್ಹ ಚೌಕಟೊ ಕರ‍್ಯಾ; <verse eid="EXO 36:23" /><verse number="24" style="v" sid="EXO 36:24" />ಚಾಳಕ್ಹ ರುಪ್ಪಾನಾ ಗದಿಗಿನಾ ದಗ್ಡಾ ಕರಿನ ತೆ ಇಕ್ಹ ಚೌಕಟೊನಾ ಹೆಟಾ ಮ್ಹೆಲ್ಯಾ; ಯಕ್ಕ ಯಕ್ಕ ಚೌಕಟಮಾ ರ‍್ಹಯಲ ಬೆ ಕ್ಹಾಚಾವೊನಾ ಹೆಟು ಯಕ್ಕ ಯಕ್ಕ ಗದಗಿನೊ ದಗ್ಡೊ ಮ್ಹೆಲ್ಯಾ. <verse eid="EXO 36:24" /><verse number="25" style="v" sid="EXO 36:25" />ತಿಮ್ಮಜ಼ ಝೊಪ್ಡಾನಾ ಉತ್ತರ ದಿಕ್ಕಮಾಬಿ ಇಕ್ಹ ಚೌಕಟೊ <verse eid="EXO 36:25" /><verse number="26" style="v" sid="EXO 36:26" />ವರಿ ಹರಯಕ್ಕಚೌಕಟನೆ ಬೆ ಬೆ ಗದಗಿನಾ ದಗ್ಡಾವೊಕನ ಚಾಳಕ್ಹ ರುಪ್ಪಾನಾ ಗದಗಿನಾ ದಗ್ಡಾ ಕರ‍್ಯಾ. <verse eid="EXO 36:26" /><verse number="27" style="v" sid="EXO 36:27" />ಝೊಪ್ಡಾನಾ ಪಾಚಾ ಕದ್ಯಾಮ ಪಶ್ಚಿಮ ದಿಕ್ಕಮಾ ಛೆ ಚೌಕಟೊ ಕರ್ಯಾ. <verse eid="EXO 36:27" /><verse number="28" style="v" sid="EXO 36:28" />ಝೊಪ್ಡಾನಾ ಪಾಚಾ ಬೆ ಮೂಲಾವೊನೆ ಬಿಜಾ಼ ಬೆ ಚೌಕಟೊ ಕರ್ಯಾ <verse eid="EXO 36:28" /><verse number="29" style="v" sid="EXO 36:29" />ತೆ ಹೆಟಾತು ತುದಿಲಕ್ಕಾ ಕದ್ಯಾಮ ಪಸ್ಟನಿ ಬಾಂಗ್ಡಿಲಕ್ಕಾ ಜೊಡಸಲ ವ್ಹತ್ತಾ; ತಿಮ್ಮಜ಼ ಬೆ ಮೂಲಾವೊನೆಬಿ ಕರ‍್ಯಾತಾ. <verse eid="EXO 36:29" /><verse number="30" style="v" sid="EXO 36:30" />ಇಮ್ಮ ಆಟ ಚೌಕಟೊ ವರಿ ಹರಯಕ್ಕ ಚೌಕಟನೆ ಬೆ ಬೆ ರುಪ್ಪನಾ ಗದಗಿನಾ ದಗ್ಡಾ ತೆಕ್ಲಾಬಿ ಕ್ಹೊಳಾ ಗದಗಿನಾ ದಗ್ಡಾ ವ್ಹತ್ತಾ. <verse eid="EXO 36:30" /><verse number="31" style="v" sid="EXO 36:31" />ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಚಲ್ಕಾ ಕರ‍್ಯಾ. <verse eid="EXO 36:31" /><verse number="32" style="v" sid="EXO 36:32" />ಝೊಪ್ಡಾನಾ ಭಂಬಿ ಬನಿ ಚೌಕಟೊನೆಬಿ ತಿನಾ ಪಾಚಾ ಕದ್ಯಾಮ ಪಶ್ಚಿಮ ದಿಕ್ಕನಾ ಚೌಕಟೊನೆಬಿ ಪಾಂಚ ಪಾಂಚ ಅಗಳಿಯೊ ಕರ‍್ಯಾ. <verse eid="EXO 36:32" /><verse number="33" style="v" sid="EXO 36:33" />ಚೌಕಟೊನಾ ವಚ್ಮಾ ರ‍್ಹಯಲ ಅಗಳಿ ಯಕ್ಕ ಮೂಲಾತಿ ವರಿಯಕ್ಕ ಮೂಲಾಲಕ್ಹಾ ಮುಟ್ಟಲ ನಿಂಗತ ಕರ‍್ಯಾತಾ. <verse eid="EXO 36:33" /><verse number="34" style="v" sid="EXO 36:34" />ತೆ ಚೌಕಟೊನೆ ಕ್ಹೊನಾನಾ ತಗಡೊ ಲಾಗಾಡಿನ ತ್ಯುನಾಮಾ ತೆ ಅಗುಳಿಯೊನಾಹುತಿ ಕ್ಹೊನಾನಾ ಬಾಂಗ್ಡಿಯೊ ಕರ‍್ಯಾ. ತೆ ಅಗುಳಿಯೊನೆ ಕ್ಹೊನಾನಾ ತಗಡೊಕ್ಹು ಲಾಗಾಡ್ಯಾ.<verse eid="EXO 36:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35" />ಉಲನನಾ ಫಡ್ಕಾಮಾ ನಿಲಿ ಲಾಲ ಜಾ಼ಮ್ಳನು ಕಲರನಾ ದೊರಾವೊಕ್ಹು ಕೆರುಬಿವಾಲಾವೊನಾ ಯಕ್ಕಪಡ್ದಾಪರ ಡ್ರಾಯಿಂಗ ಪಾಡ್ಯಾ. <verse eid="EXO 36:35" /><verse number="36" style="v" sid="EXO 36:36" />ತಿನೆ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಚಾರ ಕ್ಹಂಬಾ ಕರಿನ ಕ್ಹೊನಾನಾ ತಗಡೊ ಲಗಾಡ್ಯಾ; ತ್ಯುನಾಮಾ ಕ್ಹೊನಾನಿಯೊ ಕೊಂಡಿಯೊ ಕರಿನ ಚಾರ ರುಪ್ಪಾನಾ ಗದಗಿನಾ ದಗ್ಡಾ ಲಗಾಡಿನ ಮ್ಹೆಲ್ಯಾ. <verse eid="EXO 36:36" /><verse number="37" style="v" sid="EXO 36:37" />ಝೊಪ್ಡಾನಾ ಬಾಕಲನೆ ಉಲನನಾ ಫಡ್ಕಾಮಾ ನಿಲಿ ಲಾಲ ಜಾ಼ಮ್ಳನು ಕಲರನಾ ದೊರಾಕ್ಹು ಡ್ರಾಯಿಂಗ ಕಾಡಿನ ಪಡ್ದೊ ಕರ‍್ಯಾ. <verse eid="EXO 36:37" /><verse number="38" style="v" sid="EXO 36:38" />ತೆ ಪಡ್ದೊ ಜೊತ ಪಾಡಾನಾಹುತಿ ಪಾಂಚ ಕ್ಹಂಬಾ ತಿನಾ ಕೊಂಡಿಯೊ ಕರಿನ ತಿನಾ ಸುತ್ತ ಮುತ್ತ<verse eid="EXO 36:38" /></para>
  <chapter eid="EXO 36" />
  <chapter number="37" style="c" sid="EXO 37" />
  <para style="s">ಒಡಂಬಡಿಕೆ ಪೆಟಗಿ ತಯ್ಯಾರ ಕರಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1" />ಬೆಚಲಬಿ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಒಡಂಬಡಿಕೆ ಪೆಟಗಿ. ತೆ ಅಡಿ ಮಾರ ಲಾಂಬು ದೆಡ ಮಾರ ರುಂದಮಾಬಿ ದೆಡ ಮಾರ ಉಚ್ಚುಬಿ ಥಯುತು. <verse eid="EXO 37:1" /><verse number="2" style="v" sid="EXO 37:2" />ಚೊಕಾ ಕ್ಹೊನಾನಾ ತಗಡೊನೆ ತಿನಾ ಭಾರಾಬಿ ಮ್ಹೈಬಿ ವರಾಡ್ಯೊ; ತಿನಾ ಉಪ್ಪರಬಿ ಸುತ್ತೆಬಿ ಕ್ಹೊನಾನು ಮುಕುಟ ಲಗಾಡ್ಯಾ. <verse eid="EXO 37:2" /><verse number="3" style="v" sid="EXO 37:3" />ಚಾರ ಕ್ಹೊನಾನಾ ಬಾಂಗ್ಡಿಯೊನೆ ಧವೈನ ತಿನಾ ಚಾರೆ ಮೂಲಾವೊಮಾ ಕದ್ಯಾಮ ಯಕ್ಕ ಯಕ್ಕ ಜ಼ಗಾಮಾ ಬೆ ಬೆ ಬಾಂಗ್ಡಿಯೊ ಘಾಲ್ಯಾ. <verse eid="EXO 37:3" /><verse number="4" style="v" sid="EXO 37:4" />ವರಿ ಕಾಟಾವೊನಾ ಝಾಡನಾ ಲಾಕ್ಡಿಯೊ ಕರಿನ ತಿನೆ ಕ್ಹೊನಾನಾ ತಗಡೊ ವರಾಡೊ. <verse eid="EXO 37:4" /><verse number="5" style="v" sid="EXO 37:5" />ಒಡಂಬಡಿಕೆ ಪೆಟಗಿ ಭಂಬಿ ಜ಼ಗಾವೊಕನ ರ್್ಹವಾನು ಬಾಂಗ್ಡಿಯೊಮಾ ತಿನೆ ಉಚಾವಾನಾಹುತಿ ಮಳಾಯೊ. <verse eid="EXO 37:5" /><verse number="6" style="v" sid="EXO 37:6" />ತೆ ನೈಸೊ ಚೊಕಾ ಕ್ಹೊನಾಕ್ಹು ತಿನಿ ಬೈಟಾನಿ ಆಸನ ಕರ್ಯೊ ತೆ ಅಡಿ ಮಾರ ಲಾಂಬು ದೆಡಮಾರ ರುಂದಬಿ ವ್ಹತ್ತು. <verse eid="EXO 37:6" /><verse number="7" style="v" sid="EXO 37:7" />ಬೈಟಾನಿ ಆಸನಾ ಭಂಬಿ ಕೊನಾವೊಮಾ ಕೆರುಬಿನಾ ಬೆ ಕ್ಹೊನಾನಾ ಆಕಾರೊನೆ ನಕಾಸಿನಾ ಕಾಮಕ್ಹು ಕರಾಯೊ . <verse eid="EXO 37:7" /><verse number="8" style="v" sid="EXO 37:8" />ಬೈಟಾನಾ ಆಸನಾ ಯಕ್ಕಯಕ್ಕ ಕೊನಾವೊಮಾ ಯಕ್ಕ ಯಕ್ಕ ಕೆರುಬಿಯೊನೆ ಕರಿನ ಬೈಟಾನಿ ಆಸನೆ ಜೊಡ್ಸಾಯಾ. <verse eid="EXO 37:8" /><verse number="9" style="v" sid="EXO 37:9" />ತೆ ಕೆರುಬಿಯೊ ಉಪ್ಪರ ರೆಕ್ಯಾವೊನೆ ಫೈಲಾಯಲ ನಿಂಗತಬಿ ಬೈಟಾನಿ ಆಸನೆ ಝಾಕಾನಿಂಗತಬಿ ವ್ಹತ್ತಾ. ತಿನಾ ಮ್ಹೊಡಾವೊ ಕ್ಹಾಮಾ ಬೈಟಾನಿ ಆಸನೆ ದೆಕಾಡಾತಾ.<verse eid="EXO 37:9" /></para>
  <para style="s">ಯಹೊವಾನೆ ರೊಕ್ಲೊ ಅರ್ಪಿಸಾನಾಹುತಿ ಟೆಬಲ ತಯ್ಯಾರ ಕರಾನು</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10" />ತೆ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಟೆಬಲ ಕರ್ಯೊ ತೆ ಬೆ ಮಾರ ಲಾಂಬು ಯಕ್ಕ ಮಾರ ರುಂದಬಿ ದೆಡಮಾರಬಿ ಉಚ್ಚು ವ್ಹತ್ತು. <verse eid="EXO 37:10" /><verse number="11" style="v" sid="EXO 37:11" />ತಿನೆ ಚೊಕಾ ಕ್ಹೊನಾನಾ ತಗಡೊ ವರಾಡಿನ ಸುತ್ತೆಬಿ ಕ್ಹೊನಾನು ಮುಕುಟೊ ಕರಾಯೊ. <verse eid="EXO 37:11" /><verse number="12" style="v" sid="EXO 37:12" />ಟೆಬಲನಾ ಸುತ್ತೆಬಿ ಅಂಗೈ ರುಂದಮಾ ಅಡ್ಡ ಪಟ್ಟಿಯೊನೆ ಕರಿನ ತಿನೆ ಕ್ಹೊನಾನು ಮುಕುಟ ಬಾಂದ್ಯೊ. <verse eid="EXO 37:12" /><verse number="13" style="v" sid="EXO 37:13" />ಟೆಬಲನೆ ಉಚಾವಾನಾ ಲಕ್ಡಿಯೊನೆ ಮಳಾವಾನಾಹುತಿ ತಿನೆ ಕ್ಹೊನಾನಾ ಬಾಂಗ್ಡಿಯೊನೆ ಧವೈನ ತಿನಾ ಚಾರೆ ಪಗೊಮಾ ಲಗಾಡ್ಯೊ. <verse eid="EXO 37:13" /><verse number="14" style="v" sid="EXO 37:14" />ತೆ ಬಾಂಗ್ಡಿಯೊ ಅಡ್ಡ ಪಟ್ಟಿನೆ ಲಾಗಿನ ವ್ಹತ್ತಾ. <verse eid="EXO 37:14" /><verse number="15" style="v" sid="EXO 37:15" />ಟೆಬಲನೆ ಉಚಾವಾನಾಹುತಿ ಲಾಕ್ಡಿಯೊನೆ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಕರಿನ ತಿನೆ ಕ್ಹೊನಾನಾ ತಗಡೊ ವರಾಡ್ಯೊ. <verse eid="EXO 37:15" /><verse number="16" style="v" sid="EXO 37:16" />ಟೆಬಲನಾ ಉಪ್ಪರ ಮ್ಹೆಲಾನಾ ಸಾಮ್ನೊನೆ ಕದ್ಯಾಮ ಹರಿವಾಣೊ, ಧೂಪಾರ್ತಿಯೊ, ಹುಜೆವೊ, ಪಾನನಾ ದ್ರವ್ಯನೆ ಕರಾನಾಹುತಿ ಚಾ಼ಯೆ ಥಯಲ ಕುಂಡಾವೊನೆ ಆ ಕುಂಡಾವೊನೆ ಚೊಕಾ ಕ್ಹೊನಾಕ್ಹು ಕರ್ಯೊ.<verse eid="EXO 37:16" /></para>
  <para style="s">ದಿವ್ವಾನೊ ಖಂಬೊ ತಯ್ಯಾರ ಕರಾನು</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17" />ವರಿ ಚೊಕಾ ಕ್ಹೊನಾಕ್ಹು ದಿಪಸ್ತಂಬ ಕರ್ಯೊ. ತಿನಾ ಹೆಟಾ ಕ್ಹಂಬಾನೆ ನಕಾಸಿನಾ ಕಾಮಕ್ಹು ಕರ್ಯೊ ತೆ ದಿಪಸ್ಥಂಬ ಕ್ಹಾರಾ ಫುಲ್ಲನಾ ಸಾಮ್ನೊನೆ ನಿಂಗತ ಫುಲ್ಲೊ ನಿಂಗತ ಚೊಕು ಥಯಲ ಕೆತ್ತಾಯಲ ವ್ಹತ್ತು. <verse eid="EXO 37:17" /><verse number="18" style="v" sid="EXO 37:18" />ಕ್ಹಂಬಾನಾ ಯಕ್ಕಯಕ್ಕ ಭಾಗಮಾ ತನ್ನ ತನ್ನ ಟೊಂಗಿಯೊನಾ ನಿಂಗತ ಛೆ ಟೊಂಗಿಯೊ ವ್ಹತ್ತಾ. <verse eid="EXO 37:18" /><verse number="19" style="v" sid="EXO 37:19" />ಹರಿಯಕ್ಕ ಟೊಂಗಿಯೊಮಾ ಬಾದಾಮಾ ಫುಲ್ಲು ನಿಂಗತ ರ‍್ಹವಾನು ತನ್ನ ತನ್ನ ಫುಲ್ಲೊನಾ ನಿಂಗತ ವ್ಹತ್ತು; ಯಕ್ಕ ಯಕ್ಕ ಅಲಂಕಾರನೆ ಯಕ್ಕ ಫುಲ್ಲನೂ ಸಾಮ್ನೊಬಿ ಯಕ್ಕ ಫುಲ್ಲ ವ್ಹತ್ತಾ. ಛೆ ಟೊಂಗಿಯೊನೆ ತಿನಾ ನಿಂಗತಜ಼಼ ಕರ್ಯೊ. <verse eid="EXO 37:19" /><verse number="20" style="v" sid="EXO 37:20" />ದಿಪಸ್ತಂಬಾನಾ ಕಾಡಿಮಾ ಪುಲ್ಲೊನಾ ಸಾಮ್ನೊ ಪುಲ್ಲೊನಾ ಮುಗ್ಗೊ ರ‍್ಹವಾನಾ ಬಾದಾಮನಾ ಪುಲ್ಲೊ ನಿಂಗತ ಚಾರ ಪುಲ್ಲನಾ ಅಲಂಕಾರ ವ್ಹತ್ತಾ. <verse eid="EXO 37:20" /><verse number="21" style="v" sid="EXO 37:21" />ಬೆ ಬೆ ಟೊಂಗಿಯೊ ಕವಲ ಫುಟಲ ಜ಼ಗಾಮಾ ಕ್ಹಾರಾ ಯಕ್ಕ ಯಕ್ಕ ಪುಲ್ಲನಾ ಸಮಾನ ವ್ಹತ್ತು. <verse eid="EXO 37:21" /><verse number="22" style="v" sid="EXO 37:22" />ಪುಲ್ಲೊನ ಸಾಮ್ನೊ ಟೊಂಗಿಯೊ ದಿಪಸ್ತಂಬನೆ ಕ್ಹಾರಾ ಮಳಿನ ಚೊಕಾ ಕ್ಹೊನಾಕ್ಹು ನಕಾಸಿ ಕಾಮಕ್ಹು ಕರ್ಯೊ. <verse eid="EXO 37:22" /><verse number="23" style="v" sid="EXO 37:23" />ತಿನಾ ಕ್ಹಾತ ಹಣತೆನೆ ತಿನಾ ಕಾತರೊನೆ ದಿವಾನಿ ಕುಡಿ ಕಾಡಾನಾ ಕುಂಡಾವೊನೆ ಚೊಕಾ ಕ್ಹೊನಾಕ್ಹು ಕರ್ಯೊ. <verse eid="EXO 37:23" /><verse number="24" style="v" sid="EXO 37:24" />ದಿಪಸ್ತಂಬಬಿ ತಿನಾ ಕ್ಹಾರಾ ಸಾಮ್ನೊ ಮುವ್ವತ್ಪರ ಚಾರ ಕಿಲೊ ಚೊಕು ಕ್ಹೊನು ಥಯುತು.<verse eid="EXO 37:24" /></para>
  <para style="s">ಉದ ಬಾಳಾನೆ ಯಜ್ಞವೆದಿ ತಯ್ಯಾರ ಕರಾನು</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25" />ತೆ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಉದನಾ ಧವಾಂಡಾನೊ ಕಟ್ಟೊ ಕರ್ಯೊ. ತೆ ಯಕ್ಕ ಮಾರ ಲಾಂಬಾಮಾಬಿ ಯಕ್ಕ ಮಾರ ರುಂದಮಾಬಿ ಚಾರೆ ಮುಲಾ ಚೌಕ ವ್ಹತ್ತು. ತಿನೊ ಉಚ್ಚು ಬೆ ಮಾರ ವ್ಹತ್ತು. <verse eid="EXO 37:25" /><verse number="26" style="v" sid="EXO 37:26" />ತಿನಾ ಶಿಂಗ್ಡಾವೊ ತಿನಾ ನಿಂಗತಜ಼಼ ಯಕ್ಕ ಥೈನ ವ್ಹತ್ತಾ. ತಿನು ಉಪ್ಪರಲ್ಯು ಭಾಗ ಚಾರೆ ಕೊನಾವೊನೆ ಶಿಂಗ್ಡಾವೊನೆ ಚೊಕಾ ಕ್ಹೊನಾನಾ ತಗಡೊ ವರಾಡ್ಯಾ. ಸುತ್ತೆಬಿ ಕ್ಹೊನಾನು ಮುಕುಟ ಭಾಂದ್ಯೊ. <verse eid="EXO 37:26" /><verse number="27" style="v" sid="EXO 37:27" />ತಿನೆ ಉಚಾವಾನಾ ಲಾಕ್ಡಿಯೊನೆ ಮಾಳಾವಾನಾಹುತಿ ತೆ ಮುಕುಟನಾ ಹೆಟೊ ವೆದಿನಾ ಭಂಬಿ ಕೊನಾವೊಮಾ ಬೆ ಬೆ ಕ್ಹೊನಾನಾ ಬಾಂಗ್ಡಿಯೊನೆ ಬಿಗ್ದಾ ಲಗಾಡೊ. <verse eid="EXO 37:27" /><verse number="28" style="v" sid="EXO 37:28" />ವೆದಿನೆ ಉಚಾವಾನಾಹುತಿ ಲಾಕ್ಡಿಯೊನೆ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಕರಿನ ತಿನೆ ಕ್ಹೊನಾನಾ ತಗಡೊ ವರಾಡ್ಯೊ.<verse eid="EXO 37:28" /></para>
  <para style="s">ಅಬಿಷೆಕನು ತೆಲ ವರಿ ಉದ ತಯ್ಯಾರ ಕರಾನು</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29" />ತೆನೈಸೊ ತೆ ಕ್ಹುದಾನಾ ಸೆವಾನೆ ನೆಮಕ ಥಯಲ ಪಟ್ಟಾ ಅಭಿಷಕನು ತೆಲನೆ ಪರಿಮಳ ದ್ರವ್ಯ ಉಂಟಥಯಲ ಸ್ವಚ್ಛ ರ‍್ಹಯಲ ಉದನಾ ದ್ರವ್ಯನೆ ಚೊಕಿ ಬಾಸನಾ ದ್ರವ್ಯನೆ ವಿದ್ಯೆಯನಾಹುತಿ ಕರ್ಯೊ.<verse eid="EXO 37:29" /></para>
  <chapter eid="EXO 37" />
  <chapter number="38" style="c" sid="EXO 38" />
  <para style="s">ಯಜ್ಞವೆದಿನೆ ತಯ್ಯಾರ ಕರಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1" />ತೆ ಯಜ್ಞವೆದಿನೆ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಕರ್ಯೊ. ತೆ ಪಾಂಚಮಾರ ಲಾಂಬುಬಿ ಪಾಂಚಮಾರ ರುಂದಮಾಬಿ ಚೌಕ ಥೈನ ವ್ಹತ್ತು; ತಿನು ಉಚ್ಚು ತನ್ನ ಮಾರ ಥಯುತು. <verse eid="EXO 38:1" /><verse number="2" style="v" sid="EXO 38:2" />ತಿನಾ ಚಾರೆ ಮೂಲಾವೊಮಾ ಚಾರ ಶಿಂಗ್ಡಾವೊನೆ ಕರ್ಯೊ; ತೆ ಯಜ್ಞವೆದಿನೆ ಯಕ್ಕ ಥೈನ ವ್ಹತ್ತು. ತೆ ವೆದಿನೆ ತಾಂಬಾನಾ ತಗಡೊ ವರಾಡ್ಯೊ. <verse eid="EXO 38:2" /><verse number="3" style="v" sid="EXO 38:3" />ವೆದಿನಾ ಕ್ಹಾರಾ ಸಾಮ್ನೊ ಕದ್ಯಾಮ ತಿನಾ ಥಾಳಾ, ಸಲಕಿಯೊ, ಕುಂಡಾ, ಕಾಟಾ ನಿಂಗತ ರ‍್ಹಯಲ ಚಮಚಾ, ಅಗಿಷ್ಟೆ, ಆ ಕ್ಹಾರು ತಾಂಬಾಕ್ಹುಜ ಕರ್ಯೊ. <verse eid="EXO 38:3" /><verse number="4" style="v" sid="EXO 38:4" />ವೆದಿನೆ ಸಿವ್ವಾನಾ ಕಾಮಕ್ಹು ತಾಂಬಾನಿ ಜಾಳಗಿ ಕರ್ಯೊ.ತೆ ವೆದಿನಾ ಸುತ್ತೆ ರ‍್ಹಯಲ ವೆದಿನಾ ಬುಡತು ವಚ್ಮಾಲಕ್ಕಾ ರ‍್ಹವಾದೆ ಕೈನ ಘಾಲ್ಯೊ. <verse eid="EXO 38:4" /><verse number="5" style="v" sid="EXO 38:5" />ವೆದಿನೆ ಉಚಾವಾನಾ ಲಾಕ್ಡಿಯೊನೆ ಮಳಾವಾನಾಹುತಿ ಚಾರ ಬಾಂಗ್ಡಿಯೊನೆ ಧವಾಲಗಾಡ್ಯೊ. <verse eid="EXO 38:5" /><verse number="6" style="v" sid="EXO 38:6" />ವೆದಿನೆ ಉಚಾವಾನಾ ಲಾಕ್ಡಿಯೊನೆ ಕಾಟಾವೊನಾ ಝಾಡಕ್ಹು ಕರಿನ ತಾಂಬಾನಾ ತಗಡೊ ವರಾಡಿನ <verse eid="EXO 38:6" /><verse number="7" style="v" sid="EXO 38:7" />ತಿನಾ ಬಾಜು಼ಮಾ ರ‍್ಹವಾನಾ ಬಾಂಗ್ಡಿಯೊಮಾ ಮಾಳಾಯೊ. ತೆ ವೆದಿನೆ ಢೊಲ್ಗಾವೊಕ್ಹು ಪೆಟಕಿ ನಿಂಗತ ಕರ್ಯೊ.<verse eid="EXO 38:7" /></para>
  <para style="s">ತಾಂಬಾನಿ ಮೊಟಿ ಕುಂಡೊ ಕರಾನು</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8" />ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಗುಡಾರನಾ ಬಾಕಲಮಾ ಸೆವಾ ಕರ್ತಾ ರ‍್ಹಯಲ ಬಾಕ್ಡಿಯೊ ದಿದಲ ತಾಂಬಾನಾ ಅರ್ಕಾಕ್ಹು ಥಾಳಾನೆ ತಿನಾ ಪಿಠನೆ ಕರ್ಯೊ.<verse eid="EXO 38:8" /></para>
  <para style="s">ಯಹೊವಾನಿ ಸನ್ನಿದಿಮಾ ಗುಡಾರನು ಆವರಣ</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9" />ಗುಡಾರನಾ ಅಂಗಳನೆ ಕರ್ಯೊ. ತೆ ಅಂಗಳನಾ ತ್ಯಾ ರ‍್ಹಯಲ ತೆರೆ ಹುರಿನಾರಿನಾ ಪಡ್ಕಾವೊಕ್ಹು ಉಂಟ ಥಯಲ ಕ್ಹೊಮಾರ ಲಾಂಬಾ ಥಯಲ ವ್ಹತ್ತಾ. <verse eid="EXO 38:9" /><verse number="10" style="v" sid="EXO 38:10" />ತೆ ಜ಼ಗಾಕನ ಇಕ್ಹ ಕ್ಹಂಬಾವೊ ತಿನೆ ಇಕ್ಹ ತಾಂಬಾನಾ ಗದಗಿನಾ ದಗ್ಡಾ ವ್ಹತ್ತಾ; ಕ್ಹಂಬಾವೊನಾ ಕೊಂಡಿಯೊ ಕಟ್ಟಾವೊ ರುಪ್ಪಾನಾ ವ್ಹೈ. <verse eid="EXO 38:10" /><verse number="11" style="v" sid="EXO 38:11" />ಉತ್ತರಮಾಬಿ ಕ್ಹೊಮಾರ ಲಾಂಬಾ ಥಯಲ ಪಡ್ಕಾ ಇಕ್ಹ ಕ್ಹಂಬಾ ಇಕ್ಹ ತಾಂಬಾನಾ ಗದಗಿನಾ ದಗ್ಡಾ ವ್ಹತ್ತಾ; ಕ್ಹಂಬಾವೊನಾ ಕೊಂಡಿಯೊ ಕಟ್ಟವೊ ತಾಂಬಾನಾ ವ್ಹೈ. <verse eid="EXO 38:11" /><verse number="12" style="v" sid="EXO 38:12" />ಪಶ್ಚಿಮಾ ಐವತ್ತಮಾರ ಉಚ್ಚು ರ‍್ಹಯಲ ಪಡ್ಕು ದಕ್ಹ ಕ್ಹಂಬಾವೊ ದಕ್ಹ ಗದಗಿನಾ ದಗ್ಡಾ ವ್ಹತ್ತಾ; ಕ್ಹಂಬಾವೊನಾ ಕೊಂಡಿಯೊ ಕಟ್ಟವೊ ರುಪ್ಪನಾ ವ್ಹೈ <verse eid="EXO 38:12" /><verse number="13" style="v" sid="EXO 38:13" />ಪೂರ್ವ ದಿಕ್ಕಮಾಬಿ ಅಂಗಳನು ರುಂದ ಐವತ್ತಮಾರ ವ್ಹತ್ತು. <verse eid="EXO 38:13" /><verse number="14" style="v" sid="EXO 38:14" />ತ್ಯಾ ಬಾಕಲನಾ ಭಂಬಿ ಜ಼ಗಾವೊಮಾ ಪಂದ್ರಾ ಮಾರ ಲಾಂಬು ರ‍್ಹಯಲ ಪಡ್ಕು ತಿನೆ <verse eid="EXO 38:14" /><verse number="15" style="v" sid="EXO 38:15" />ತನ್ನ ತನ್ನ ಕ್ಹಂಬಾ ತನ್ನ ತನ್ನ ಗದಗಿನಾ ದಗ್ಡಾ ವ್ಹತ್ತಾ. <verse eid="EXO 38:15" /><verse number="16" style="v" sid="EXO 38:16" />ಅಂಗಳನಾ ಸುತ್ತೆಬಿ ರ‍್ಹಯಲ ಪಡ್ಕಾಕ್ಹಾರಾ ಹುರಿನಾರಿನಾ ವಣ್ಣಾ; <verse eid="EXO 38:16" /><verse number="17" style="v" sid="EXO 38:17" />ಕ್ಹಂಬನಾ ಗದಗಿನಾ ದಗ್ಡಾ ತಾಂಬಾನಾ ವ್ಹೈ; ಕ್ಹಂಬಾನಾ ಕೊಂಡಿಯೊ ಕಟ್ಟೊ ತಾಂಬಾನಾ ವ್ಹೈ; ತಿನಾ ಬೊದಿವೊ ರುಪ್ಪಾನಾ ತಗಡೊಕ್ಹು ವರಾಡ್ಯಾ. ಅಂಗಳನಾ ಕ್ಹಾರಾ ಕ್ಹಂಬಾವೊ ರುಪ್ಪನಾ ಕಟ್ಟೊ ವ್ಹತ್ತಾ. <verse eid="EXO 38:17" /><verse number="18" style="v" sid="EXO 38:18" />ಅಂಗಳನಾ ಬಾಕಲಮಾ ರ‍್ಹಯಲ ಪಡ್ದೊ ಹುರಿನಾರಿನಾ ಪಡ್ಕಾಕ್ಹುಬಿ ನಿಲಿ ಧ್ರುಮ ರಗತನಾ ದೊರಾಕ್ಹು ಬುಟೆದಾರಿ ಕಾಮವಾಲಾವೊನಾ ಹತ್ತಕ್ಹು ತಯ್ಯಾರ ಥಯು. ತಿನು ಉಚ್ಚು ಇಕ್ಹಮಾರ ಥಯುತು. ತಿನು ರುಂದಮಾಬಿ ಅಂಗಳನಾ ಉಗ್ರಲ ಪಡ್ಕಾನಿಂಗತ ಪಾಂಚಮಾರ. <verse eid="EXO 38:18" /><verse number="19" style="v" sid="EXO 38:19" />ಬಾಕಲನೆ ಚಾರ ಕ್ಹಂಬಾವೊ ಚಾರ ತಾಂಬಾನಾ ಗದಗಿನಾ ದಗ್ಡಾ ವ್ಹತ್ತಾ; ಕ್ಹಂಬಾವೊನಿ ಕೊಂಡಿಯೊ ಕಟ್ಟೊ ಬೊದಿಗೆನೆ ವರಾಡಲ ತಗಡೊ ರುಪ್ಪಾನಾ ವ್ಹೈ. <verse eid="EXO 38:19" /><verse number="20" style="v" sid="EXO 38:20" />ಗುಡಾರನಾ ಗುಟೊ ಅಂಗಳನಾ ಗುಟೊ ಕ್ಹಾರಾ ತಾಂಬಾನಾ ವ್ಹೈ.<verse eid="EXO 38:20" /></para>
  <para style="s">ಗುಡಾರ ತಯ್ಯಾರ ಕರಾನೆ ಉಪಯೊಗ ಕರಲ ಲ್ಹೊಡಾ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21" />ಕ್ಹುದಾನಾ ದರ್ಶನಾ ಗುಡಾರನೆ ಕರಾನೆ ಉಪಯೊಗ ಥಯಲ ಸಮ್ನೊನ ಲಕ್ಕಾ ಮೊಶೆನಾ ಆಗನ್ಯಾಹುತಿ ಮ್ಹೊಟೊ ಯಾಜಕ ಥಯಲ ಆರೊನೊ ದಿಕ್ರೊ ಇತಮಾರ ಲೆವಿವಾಲೊವೊಕ್ಹು ಲೆಕ್ಕಾ ಕರಾಲಗಾಡ್ಯೊ. <verse eid="EXO 38:21" /><verse number="22" style="v" sid="EXO 38:22" />ಯಹೊವಾ ಮೊಶೆನೆ ಅಗನ್ಯಕರಲಕ್ಹಾರು ಕರಲವಾಲಾ ಕುನ್ನ ಕುನ್ನ ವ್ಹೈ ಕದ್ಯಾಮ ಯಹುದ ಕುಲನಾ ಹುರನೊ ನಾತ್ನೊ ಉರಿಯನೊ ದಕ್ರೊ ಥಯಲ ಬೆಚಲನ; <verse eid="EXO 38:22" /><verse number="23" style="v" sid="EXO 38:23" />ತಿನಾ ಕ್ಹಾತೆ ದಾನ ಕುಲನೊ ಅಹಿಸಾಮಾಕನೊ ದಿಕ್ರೊ ಥಯಲ ಒಹೊಲಿಯಾಬ ಶೆರ್ಯೊತೊ; ಆ ಚೊಕಿ ವಿದ್ಯಾ ವಾಲೊ ವ್ಹೈ ಅಜಬ ಕಜಬ ಥಯಲ ಕಾಮೊನೆ ಯೊಚನೆ ಕರಅಲೊ ನಾರಿನ ಪಡ್ಕಾಮಾಜ ನಿ ಧ್ರುೂಮ ರಗತ ನಿಂಗತ ನೂಲಕ್ಹು ಬುಟೆದಾರಿ ಕಾಮಕರಾಲೊಬಿ ಥಯೊತೊ. <verse eid="EXO 38:23" /><verse number="24" style="v" sid="EXO 38:24" />ಕ್ಹುದಾನಿ ಮಂದಿರಮಾ ಬಿಜಾ಼ಬಿಜಾ಼ ಕಾಮೊಮಾ ಉಪಯೊಗ ಕರಲ ಕಾಣಿಕೆನಾ ಕ್ಹೊನಾನಾ ಕ್ಹುದಾನಾ ಸೆವೆನೆ ನೆಮಕ ಥಯಲ ಶೆಕೆಲನಾಹುತಿ ಇಕ್ಹಪರ ನೌ ತಲಾಂತ ಕ್ಹಾತಕೊನ ಮೂವತ್ತ ಶೆಕೆಲ. <verse eid="EXO 38:24" /><verse number="25" style="v" sid="EXO 38:25" />ರುಪ್ಪಾನು ಲೆಕ್ಕಾ ಲೆಕ್ಕಾಕರಲವಾಲಾವೊನಾ ಇಕ್ಹ ವರಕ್ಹವಾಲಾ ಹೆಚ್ಕಿ ವೈಸ ರ‍್ಹಯಲವಾಲಾ ರುಪಾಯಿನಾಹುತಿ ಯಕ್ಕ ಯಕ್ಕ ಚಾ಼ಯೆ ಕದ್ಯಾಮ ಅರ್ದಿ ಅರ್ದಿ ರುಪಾಯಿ ಕಪ್ಪನೆ ದಿವಾನು ರ‍್ಹಯಲಕ್ಹು <verse eid="EXO 38:25" /><verse number="26" style="v" sid="EXO 38:26" />ಸಮೂಹಮಾ ಲೆಕ್ಕಾ ಕರಲ ಅಕ್ಲಾ ಛೆಲಾಕ ತನ್ನ ಹಜಾ಼ರ ಪಾಂಚಕ್ಹೊನ ಐವತ್ತ ಮನಕ್ಹೊ ಉಸುಲ ಥಯಲ ಕ್ಹೊ ತಲಾಂತ ಯಕ್ಕಹಜಾ಼ರ ಕ್ಹಾತಕ್ಹೊನ ಸತ್ತರಪಾಂಚ ಶೆಕೆಲ. <verse eid="EXO 38:26" /><verse number="27" style="v" sid="EXO 38:27" />ಕ್ಹುದಾನಾ ಮಂದಿರನಾ ಗದಗಿನಾ ದಗ್ಡಾವೊನೆ ಧವಾವೊಮಾ ಯಕ್ಕ ಯಕ್ಕ ಗದಗಿನಾ ದಗ್ಡಾನೆ ಯಕ್ಕ ಯಕ್ಕ ತಲಾಂತನಾ ನಿಂಗತ ಕ್ಹೊ ತಲಾಂತ ರುಪ್ಪು ವ್ಹೈ. <verse eid="EXO 38:27" /><verse number="28" style="v" sid="EXO 38:28" />ಉಗ್ರಲ ಯಕ್ಕ ಹಜಾ಼ರ ಕ್ಹಾತಕ್ಹೊನಾ ಸತ್ತರ ಪಾಂಚ ತೊಲಾಕ್ಹು ಕ್ಹಂಬಾವೊನೆ ಕೊಂಡಿಯೊನೆ ಕಟ್ಟೊನೆ ಕರಿನ ತಿನಾ ಬೊದಿಗೆನೆ ತಗ್ಡೊ ವರಾಡ್ಯಾ. <verse eid="EXO 38:28" /><verse number="29" style="v" sid="EXO 38:29" />ಮನಕ್ಹೊ ಕಾಣಿಕೆ ದಿದಲ ತಾಂಬಾನೊ ಲೆಕ್ಕೊ ಸತ್ತರ ತಲಾಂತ ಬೆಹಜಾ಼ರ ಚಾರಕ್ಹೊ ಶೆಕೆಲ. <verse eid="EXO 38:29" /><verse number="30" style="v" sid="EXO 38:30" />ಇನಾಕ್ಹು ಕ್ಹುದಾನಿ ದರ್ಶನಿ ಗುಡರನಾ ಬಾಕಲನಾ ಗದಗಿನಾ ದಗ್ಡಾವೊನೆ ತಾಂಬಾನಿ ಯಜ್ಞವೆದಿನೆ ತಿನಾ ತಾಂಬಾನಿ ಜಾಳಗಿನೆ <verse eid="EXO 38:30" /><verse number="31" style="v" sid="EXO 38:31" />ಯಜ್ಞವೆದಿನಾ ಕ್ಹಾರಾ ಸಾಮ್ನೊನೆ ಅಂಗಳನಾ ಸುತ್ತೆ ರ‍್ಹಯಲ ಗದಗಿನಾ ದಗ್ಡಾವೊನೆ ಅಂಗಳನಾ ಬಾಕಲನಾ ಗದಗಿನಾ ದಗ್ಡಾವೊನೆ ಗುಡಾರನಾ ವರಿ ಅಂಗಳನಾ ಕ್ಹಾರಾ ಗುಟೊನೆ ಕರ್ಯೊ.<verse eid="EXO 38:31" /></para>
  <chapter eid="EXO 38" />
  <chapter number="39" style="c" sid="EXO 39" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1" />ಯಹೊವಾ ಮೊಶೆನೆ ಆಗನ್ಯಾ ದಿದಲ ತಿಮ್ಮ ತೆ ನಿಲಿ ಧ್ರುಮ ರಗತನಾನಿಂಗತ ದೊರಾಕ್ಹು ಕ್ಹುದಾನಿ ಮಂದಿರನಾ ಸೆವಾನೆ ಅಲಂಕಾರ ಕರಾನು ಸಾಮನ ಆರೊನನೆ ದಿಕ್ಷಾ ವಸ್ರ್ತ ಕರ್ಯಾ. <verse eid="EXO 39:1" /><verse number="2" style="v" sid="EXO 39:2" />ಮ್ಹೊಟೊ ಯಾಜಕ ಎಪೊದ ಕೈನ ಕವಚನೆ ಹುರಿನಾರಿನಾ ಪಡ್ಕಾಕ್ಹು ಕ್ಹೊನಾನಾ ದೊರಾಕ್ಹುಬಿ ನಿಲಿ ಧೂಮ್ರ ರಗತ ನಂದರ ದೊರಾವೊಕ್ಹುಬಿ ಕರ್ಯೊ. <verse eid="EXO 39:2" /><verse number="3" style="v" sid="EXO 39:3" />ನಿಲಿ ಧೂಮ್ರ ರಗತ ನಂದರ ದೊರಾವೊನಾಕ್ಹಾತೆ ನಾರಿನಾ ಪಡ್ಕಾನಾ ಕ್ಹಾತೆ ವಿಚಿತ್ರ ಥಯಲ ಕಸೂತಿ ಕಾಮವಾಲಾವೊನಾ ಪದ್ದತಿನಾಹುತಿ ಬುಟೆದಾರಿನೂ ಕಾಮ ಕರಾನಾಹುತಿ ಕ್ಹೊನಾನೆ ಫೊಡಿನ ತಗಡೊ ಕರಿನ ನ್ಹಾನ್ಹಾ ಎಳಿಯೊ ನಿಂಗತ ಕತ್ರ್ಯಾ. <verse eid="EXO 39:3" /><verse number="4" style="v" sid="EXO 39:4" />ತೆ ಕವಚನೆ ಕ್ಹಾಂದಾಪರ ಬೆ ಪಟ್ಟಿಯೊನೆ ಕರ್ಯಾ; ತಿನಾ ಭಂಬಿ ಕೊನಾವೊನೆ ಜೊಡ್ಸಾಯಾ. <verse eid="EXO 39:4" /><verse number="5" style="v" sid="EXO 39:5" />ಕವಚನಾ ಉಪ್ಪರ ರ‍್ಹಯಲ ಚೊಕಿ ಕಲಾಕ್ಹು ಕರಲ ಬುಟೆದಾರಿನೊ ಕಂಬರನೊ ಪಟ್ಟೊ ಕವಚನೆ ಮಳಿನ ರ‍್ಹಯಲ ತಿನಾ ನಿಂಗತ ಹುರಿನಾರನಾ ಫಡ್ಕಾಕ್ಹು ಕ್ಹೊನಾನಾ ದೊರಾಕ್ಹು ನಿಲಿ ಜಾ಼ಂಬ್ಳಾನಾ ಕಲರ ಲಾಲ ದೊರಾಕ್ಹು ಥಯಲ ವ್ಹತ್ತು. ಯಹೊವಾ ಮೊಶೆನೆ ಕದಲ ತಿಮ್ಮ ತೆ ಕ್ಹಾರು ಕರ‍್ಯಾ. <verse eid="EXO 39:5" /><verse number="6" style="v" sid="EXO 39:6" />ಮುದ್ರಾ ರತ್ನ ಕೆತ್ತೆ ಲಿಂಗತ ಬೆ ಗೊಮೆದಕ ರತ್ನಮಾ ಇಸ್ರಾಯೆಲನಾ ಬಾರಾ ಕುಲನಾ ನಾಮೊ ಕೆತ್ತಿನ ತೆ ರತ್ನನೆ ಕುಂದಣಮಾ ಭಾಂದ್ಯಾ. <verse eid="EXO 39:6" /><verse number="7" style="v" sid="EXO 39:7" />ತೆ ಭಂಬಿ ರತ್ನ ಇಸ್ರಾಯೆಲೊನಾ ಶೆಂ ರ‍್ಹಯಲ ರತ್ನ ಥಾವಾನಾ ಹುತಿ ತೆ ಕ್ಹಾರಾವೊನೆ ಕವಚನಾ ಖಾಂದಾನಾ ಉಪ್ಪರ ರ‍್ಹಯಲ ಪಟ್ಟಿಯೊಮಾ ಭಾಂದಾ ಲಗಾಡ್ಯೊ. ಯಹೊವಾ ಮೊಶೆನೆ ತಿಮ್ಮ ಆಗನ್ಯಾ ದಿದ್ಯೊತೊ.<verse eid="EXO 39:7" /></para>
  <para style="s">ಛಾತಿನು ಕವಚ ಕರಾನು</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8" />ಕವಚನಾ ನಿಂಗತ ಬುಟೆದಾರನಾ ಕಾಮಕ್ಹು ಕ್ಹೊನಾನಾ ದೊರಾಕ್ಹುಬಿ ನಿಲಿ ಜಾ಼ಂಬ್ಳಾನು ಕಲರ ವರಿ ಲಾಲ ರ‍್ಹಯಲ ದೊರಾಕ್ಹುಬಿ ಹುರಿನಾರನಾ ಫಡ್ಕಾಮಾ ಪಿಶಿನು ಪದಕ ಕರ‍್ಯೊ. <verse eid="EXO 39:8" /><verse number="9" style="v" sid="EXO 39:9" />ತೆ ಚೌಕ ವ್ಹತ್ತು. ತೆ ಪಿಶಿನು ಪದಕ ಬೆ ಪದರನು ವ್ಹತ್ತು; ತೆ ಯಕ್ಕ ಗೆಣ ಲಾಂಬು ಯಕ್ಕ ಗೆಂ ರುಂದ ವ್ಹತ್ತು. <verse eid="EXO 39:9" /><verse number="10" style="v" sid="EXO 39:10" />ತಿನಾ ಕ್ಹಾಮಾ ಚಾರ ಲೈನನಾ ಹುತಿ ರತ್ನ ತಯ್ಯಾರ ಕರ‍್ಯಾ. ಪಸ್ಟನಾ ಲೈನಮಾ ಮಾಣಿಕ್ಯ ಪುಶ್ಪರಾಗ ಸ್ಪಟಿಕ, <verse eid="EXO 39:10" /><verse number="11" style="v" sid="EXO 39:11" />ಬೆವಾ ಲೈನಮಾ ನಿಲಿ, ರತ್ನ, ತ್ಯಾಪಿಯೊ, <verse eid="EXO 39:11" /><verse number="12" style="v" sid="EXO 39:12" />ತನ್ವಾ ಲೈನಮಾ ಸುವರ್ಣ ರತ್ನ ಗೊಮೆದಕ ದುಮ್ರ ಮಣಿಯೊ, <verse eid="EXO 39:12" /><verse number="13" style="v" sid="EXO 39:13" />ಚಾರವಾ ಲೈನಮಾ ಹಿತ ರತ್ನ ಬೆರುಲ್ಲ ವೈಡುರ್ಯ ಕ್ಹೊನಾನಾ ಖಾಚಾವೊಮಾ ಘಾಲ್ಯಲ ವ್ಹತ್ತು. <verse eid="EXO 39:13" /><verse number="14" style="v" sid="EXO 39:14" />ಇಸ್ರಾಯೆಲೊನಾ ಕುಲನಾ ಸಂಕ್ಯಾ ನಿಂಗತ ಬಾರಾ ರತ್ನ ವ್ಹತ್ತಾ; ಮುದ್ರಾ ರತ್ನಮಾ ಕೆತ್ತಾನಾ ತರಿಕಾಮಾ ಯಕ್ಕೆಕ್ಕ ರತ್ನಮಾ ಯಕ್ಕೆಕ್ಕ ಕುಲನು ನಾಮ ಕೆತ್ತಲ ವ್ಹತ್ತು. <verse eid="EXO 39:14" /><verse number="15" style="v" sid="EXO 39:15" />ಪದಕನಾ ಉಪ್ಪರ ಹುರಿಯೊ ನಿಂಗತ ರ‍್ಹವಾನಾ ಕ್ಹೊನಾನಾ ಸರಾವೊನೆ ಹೆಣಗಿನಾ ಕಾಮಕ್ಹು ಕರ‍್ಯಾ. <verse eid="EXO 39:15" /><verse number="16" style="v" sid="EXO 39:16" />ಬೆ ಕ್ಹೊನಾನಾ ಖಾಚಾ ಬೆ ಕ್ಹೊನಾನಾ ಇಟ್ಟಿಯೊ ಕರಿನ ತೆ ಇಟ್ಟಿಯೊನೆ ಪದಕನಾ ಭಂಬಿ ಮುಲಾವೊನೆ ಅಟ್ಕಾಯಾ. <verse eid="EXO 39:16" /><verse number="17" style="v" sid="EXO 39:17" />ಹೆಣಿಗಿನಾ ಕ್ಹಾಮಕ್ಹು ಕರ‍್ಹಯಲ ತೆ ಭಂಬಿ ಕ್ಹೊನಾನಾ ಸರಾವೊನೆ ಪದಕನಾ ಮುಲಾವೊಮಾ ರ‍್ಹವಾನಾ ಇಟ್ಟಯೊನೆ ಅಟ್ಕಾಯಾ. <verse eid="EXO 39:17" /><verse number="18" style="v" sid="EXO 39:18" />ಹೆಣಗಿ ಕಾಮನಾ ತೆ ಸರಾವೊನಾ ಮುಲಾವೊನೆ ಕವಚನಾ ಖಾಂದಾನಾ ಪಟ್ಟಿಯೊಮಾ ರ‍್ಹಯಲ ಬೆ ಖಾಚಾವೊನಾ ಕ್ಹಾಮಾ ಅಟ್ಕಾಯಾ. <verse eid="EXO 39:18" /><verse number="19" style="v" sid="EXO 39:19" />ತೆನೈಸೊ ಬೆ ಕ್ಹೊನಾನಾ ಇಟ್ಟಿಯೊ ಕರಿನ ಪದಕನಾ ಮ್ಹೈನಾ ಮುಲಾವೊಮಾ ಕವಚನಾ ನಜಿಕಜ ಮ್ಹೆಲ್ಯಾ. <verse eid="EXO 39:19" /><verse number="20" style="v" sid="EXO 39:20" />ವರಿ ಬಿಜಾ಼ ಬೆ ಕ್ಹೊನಾನಾ ಇಟ್ಟಿಯೊ ಕರಿನ ಕವಚನಾ ಭಂಬಿ ಖಾದಾವೊನಾ ಪಟ್ಟಿಯೊನಾ ಕ್ಹಾಮಾ, ಕವಚನೆ ಮಳಾಯಲ ಜ಼ಗಾ ಕನ ತೆ ಚೊಕಿ ಕಲಾಕ್ಹು ಕರ‍್ಹಯಲ ಕಂಬರನಾ ಪಟ್ಟಾನಾ ಉಪ್ಪರ ಮ್ಹೆಲ್ಯಾ. <verse eid="EXO 39:20" /><verse number="21" style="v" sid="EXO 39:21" />ಪದಕ ಚೊಕಿ ಕಲಾಕ್ಹು ಕರಲ ಕಂಬರನಾ ಪಟ್ಟಾನಾ ಉಪ್ಪರ ಬಿಗಿ ಥಾಯೆ ನಿಂಗತ ಕವಚತು ಖುಲಿನ ಪಡೆ ನೈಸೊ ತಿನಾ ಇಟ್ಟಿಯೊನೆ ಕವಚನಾ ಇಟ್ಟಿಯೊಕ್ಹು ನಿಲಿ ದೊರಾಕ್ಹು ಭಾಂದ್ಯಾ. ಯಹೊವಾ ಮೊಶೆನೆ ತಿಮ್ಮಜ಼ ಆಗನ್ಯಾ ಕರ‍್ಯೊತೊ.<verse eid="EXO 39:21" /></para>
  <para style="s">ಯಾಜಕೊನಾ ಬಿಜಾ ವಣ್ಣಾ ತಯ್ಯಾರ ಕರಾನು</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22" />ಕವಚನಾ ಕ್ಹಾತೆ ವರಾಡಿನ ರ‍್ಹವಾನಾ ಉಪ್ಪರಲ್ಯಾ ಅಂಗಡಾನೆ ನಿಲಿ ಕಲರನಾ ಫಡ್ಕಾಕ್ಹುಜ ನೆತ ಕಾಮಕ್ಹು ಕರ‍್ಯೊ. <verse eid="EXO 39:22" /><verse number="23" style="v" sid="EXO 39:23" />ಮಾತು ದೆಕಾಡಾನೆ ತಿಮಾ ಭೊಕಾಡೊ ಕರಿನ ತೆ ಫಾಟೆ ನೈಸೊ ಯುದ್ದನಾ ಕವಚನಾ ಕ್ಹಾಮೊ ತೆ ಭೊಕಾಡಾನಾ ಸುತ್ತೆಬಿ ಕಸುತಿ ಘಾಲ್ಯೊ. <verse eid="EXO 39:23" /><verse number="24" style="v" sid="EXO 39:24" />ಉಪ್ಪರಲ್ಯಾ ಅಂಗ್ಡಾನಾ ಸುತ್ತೆ ನಿಲಿ ಜಾ಼ಂಬ್ಳಾನಾ ಕಲರ ವರಿ ಲಾಲ ದೊರಾಕ್ಹು ಅನಾರ ನಿಂಗತ ಚಂಡಾ ಕರ‍್ಯಾ. <verse eid="EXO 39:24" /><verse number="25" style="v" sid="EXO 39:25" />ವರಿ ಚೊಕ್ಕ ಕ್ಹೊನಾಕ್ಹು ಗೆಜ್ಜಿಯೊ ಕರಿನ ಉಪ್ಪರಲ್ಯಾ ಅಂಗ್ಡಾನಾ ತುದಿಮಾ ಅನಾರನಾ ಚಂಡಾವೊನಾ ಕ್ಹಾತೆ ಮ್ಹೆಲ್ಯಾ. <verse eid="EXO 39:25" /><verse number="26" style="v" sid="EXO 39:26" />ಕ್ಹೊನಾನಾ ಗೆಜ್ಜಿಯೊ ಅನಾರನಾ ನಿಂಗತ ರ‍್ಹವಾನಾ ಚಂಡಾ ಯಕ್ಕ ಥಯಲ್ಪರ ಯಕ್ಕ ಕ್ಹುದಾನಾ ಸೆವೆನಾ ಹುತಿ ರ‍್ಹಯಲ ತೆ ಉಪ್ಪರಲ್ಯಾ ಅಂಗ್ಡಾನಾ ತುದಿನಾ ಸುತ್ತೆ ವ್ಹತ್ತಾ. ಯಹೊವಾ ಮೊಶೆನೆ ಆಗನ್ಯಾ ದಿದ್ಯಲ ತಿಮ್ಮಜ಼ ಕರ‍್ಯಾ. <verse eid="EXO 39:26" /><verse number="27" style="v" sid="EXO 39:27" />ಆರೊನನೆಬಿ ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆಬಿ ಬಾರಿಕ ದೊರಾಕ್ಹು ಹೆಣಗಿನಾ ಕಾಮ ನಿಂಗತ ಅಂಗ್ಡಾವೊನೆ <verse eid="EXO 39:27" /><verse number="28" style="v" sid="EXO 39:28" />ದೊರಾವೊಕ್ಹು ಮಹಾ ಯಾಜಕನಾ ಕಿರಿಟನೆ ದೊರಾವೊಕ್ಹು ಅಲಂಕಾರ ಕರ್xಯಲ ಕಿರಿಟೊನೆ ದೊರಾವೊಕ್ಹು ಮ್ಹೈ ಘಾಲ್ಯಾನಾ ವಣ್ಣಾ ಹುರಿನಾರಕ್ಹು <verse eid="EXO 39:28" /><verse number="29" style="v" sid="EXO 39:29" />ನಿಲಿ ಜಾ಼ಂಬ್ಳಾನು ಕಲರ ವರಿ ಲಾಲ ದೊರಾವೊಕ್ಹುಬಿ ಬುಟೆದಾರಿ ಕರಾನಾ ಕಾಮ ನಿಂಗತ ಕಂಬರನೊ ಪಟ್ಟೊ ಕರ‍್ಯಾ.ಯಹೊವಾ ಮೊಶೆನೆ ಆಗನ್ಯಾ ಕರಲ ತಿಮ್ಮಜ಼ ತೆ ಕರ‍್ಯಾ. <verse eid="EXO 39:29" /><verse number="30" style="v" sid="EXO 39:30" />ವರಿ ಚೊಕ್ಕ ಕ್ಹೊನಾಕ್ಹು ಪರಿಶುದ್ದ ಕಿರಿಟ ಥಯಲ ಪಟ್ಟೊ ಕರಿನ ಮುದ್ರೆ ಕೆತ್ತಾನಾ ತರಿಕಾಕ್ಹು ತಿಮಾ ಯಹೊವಾನೆ ಪವಿತ್ರ ವ್ಹೈ ಕವಾನಿ ಲಿಪಿ ಲಿಕ್ಯಾ. <verse eid="EXO 39:30" /><verse number="31" style="v" sid="EXO 39:31" />ತಿನೆ ಕಿರಿಟನೆ ಬಿಗ್ದಾನಾ ಹುತಿ ನಿಲಿ ದೊರೊ ಭಾಂದ್ಯಾ. ಯಹೊವಾ ಮೊಶೆನೆ ಆಗನ್ಯಾ ದಿದ್ಯಲ ನಿಂಗತ ತೆ ಕರ‍್ಯಾ.<verse eid="EXO 39:31" /></para>
  <para style="s">ಕಾಮ ಮುಕ್ತಾಯ</para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32" />ಇನಾ ನಿಂಗತ ದೆವದರ್ಶನು ಗುಡಾರನು ಕ್ಹಾರು ಕಾಮ ಪುರಾ ಥಯು. ಯಹೊವಾ ಮೊಶೆ ಆಗನ್ಯಾ ದಿದ್ಯಲ ತಿಮ್ಮ ತಿನೆ ಇಸ್ರಾಯೆಲೊ ಕರ‍್ಯಾತಾ. <verse eid="EXO 39:32" /><verse number="33" style="v" sid="EXO 39:33" />ತೆಳಾಮಾ ತ್ಯುನೆ ತೆ ಗುಡಾರನೆ ಮೊಶೆನಾ ಕ್ಹಾಮಾ ಲಿನ ಆಯಾ. ಸುವೈ ಕದ್ಯಾಮ- ಝುಪ್ಡಾನೆ ತಿನೆ ಸಂಬಂದ ರ‍್ಹಯಲ ಕ್ಹಾರು ಕದ್ಯಾಮ ತಿನಾ ಕೊಂಡಿಯೊ, ಚೌಕಟ್ಟೊ, ಅಗಳಿಯೊ, ಖಂಬಾ, ಗದ್ದಗಿನಾ ದಗ್ಡಾವೊನೆ ಎ ಕ್ಹಾರಾವೊನೆ; <verse eid="EXO 39:33" /><verse number="34" style="v" sid="EXO 39:34" />ಹದ ಕರ‍್ಹಯಲ ಲಾಲ ಕಲರನಾ ಬಕ್ರಾನಾ ಚಾಂಬ್ಡಾಕ್ಹು ಥಯಲ ಮೆಲಹೊದಿಕೆ, ರಾನಡುಕ್ಕುರನಾ ಚಾಂಬ್ಡಾಕ್ಹು ಥಯಲ ಮೆಲಹೊದಿಕೆ, ಮಹಾ ಪವಿತ್ರ ಜ಼ಗಾನೆ ಝಾಕಾನಾ ಪಡ್ದಾ ಎ ಕ್ಹಾರಾವೊನೆ; <verse eid="EXO 39:34" /><verse number="35" style="v" sid="EXO 39:35" />ಆಗನ್ಯಾ ಶಾಸನನಿ ಪೆಟಗಿ, ತಿನಾ ಲಾಕ್ಡಾ, ಕೃಪಾಸನ ಎ ಕ್ಹಾರಾವೊನೆ; <verse eid="EXO 39:35" /><verse number="36" style="v" sid="EXO 39:36" />ಟೆಬಲ, ತಿನಾ ಕ್ಹಾರಾ ಸಾಮನೊ, ಎಡಿನೊ ರೊಕ್ಲೊ ಎ ಕ್ಹಾರಾವೊನೆ; <verse eid="EXO 39:36" /><verse number="37" style="v" sid="EXO 39:37" />ಚೊಕ್ಕ ಕ್ಹೊನಾನು ದಿವ್ವಾನೊ ಖಂಬೊ, ತಿನಾ ಉಪ್ಪರ ಮ್ಹೆಲಾನಾ ಸಮೈಯ್ಯೊ, ತಿನಾ ಸಾಮನೊ, ದಿವ್ವಾನೆ ಚಾ಼ಯೆ ಥಯಲ ತೆಲ ಎ ಕ್ಹಾರಾವೊನೆ; <verse eid="EXO 39:37" /><verse number="38" style="v" sid="EXO 39:38" />ಕ್ಹೊನಾನಿ ಉದನೊ ಧವಾಂಡೊ ದಿವಾನೊ ಕಟ್ಟೊ, ಅಭಿಶೆಕನು ತೆಲ, ಚೊಕಿ ಬಾಸ ರ‍್ಹಯಲ ಉದ ಎ ಕ್ಹಾರಾವೊನೆ; ಝುಪ್ಡಾನಾ ಬಾಕಲನಾ ಪಡ್ದಾನೆ; <verse eid="EXO 39:38" /><verse number="39" style="v" sid="EXO 39:39" />ತಾಂಬಾನೊ ಬಲಿನೊ ಕಟ್ಟೊ, ತಿನಾ ತಾಂಬಾನಾ ಜಾಳಗಿಯೊ, ತಿನಾ ಲಾಕ್ಡಿಯೊ, ಸಾಮನೊ ಎ ಕ್ಹಾರಾವೊನೆ; ಗಂಗಾಳ, ತಿನು ಪಿಟ ಎ ಕ್ಹಾರಾವೊನೆ; <verse eid="EXO 39:39" /><verse number="40" style="v" sid="EXO 39:40" />ತಿನಾ ಆಂಗಳನಾ ಪಡ್ದಾ, ಖಂಬಾ, ಗದ್ದಗಿನಾ ದಗ್ಡಾ ಎ ಕ್ಹಾರಾವೊನೆ; ಅಂಗಳಾನಾ ಬಾಕಲನೊ ಪಡ್ದೊಬಿ, ತಿನಾ ರಾಕ್ಹೊ, ಗುಟೊ ಎ ಕ್ಹಾರಾವೊನೆ; ದೆವದರ್ಶನನಾ ಗುಡಾರನಾ ಸೆವೆನೆ ಚಾ಼ಯೆ ಥಯಲ ಕ್ಹಾರಾ ಸಾಮನೊ; <verse eid="EXO 39:40" /><verse number="41" style="v" sid="EXO 39:41" />ಪವಿತ್ರ ಜ಼ಗಾಮಾ ಥಾವಾನಿ ಸೆವೆನಾ ಹುತಿ ಚಾ಼ಯೆ ಥಯಲ ಅಲಂಕಾರನಾ ಫಡ್ಕಾ ಕದ್ಯಾಮ ಆರೊನನೆ ಚಾ಼ಯೆ ಥಯಲ ದಿಕ್ಷಾನಾ ಫಡ್ಕಾ ಯಾಜಕ ಸೆವೆ ಕರಾಲಾ ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆ ಚಾ಼ಯೆ ಥಯಲ ಫಡ್ಕಾ ಎ ಕ್ಹಾರಾವೊನೆ ಲಾಯಾ. <verse eid="EXO 39:41" /><verse number="42" style="v" sid="EXO 39:42" />ಯಹೊವಾ ಮೊಶೆನೆ ಆಗನ್ಯಾ ದಿದ್ಯಲ ತಿಮ್ಮಜ಼ ಇಸ್ರಾಯೆಲೊ ತೆ ಕಾಮ ಕ್ಹಾರು ಕರ‍್ಯಾತಾ. <verse eid="EXO 39:42" /><verse number="43" style="v" sid="EXO 39:43" />ತ್ಯುನೆ ಕರ‍್ಹಯಲ ಕಾಮನೆ ಮೊಶೆ ಪರಿಕ್ಷಾ ಕರಿನ ಯಹೊವಾನಿ ಅಪ್ಪಣೆ ನಿಂಗತ ತ್ಯುನೆ ಕ್ಹಾರು ಕರ‍್ಯಾ ಕೈನ ತಿಳ್ದಿಲಿನ ತ್ಯುನೊನೆ ಆಶಿರ್ವಾದ ಕರ‍್ಯೊ.<verse eid="EXO 39:43" /></para>
  <chapter eid="EXO 39" />
  <chapter number="40" style="c" sid="EXO 40" />
  <para style="s">ಯಹೊವಾನಿ ಸನ್ನಿದಿಮಾ ಗುಡಾರ ಹುಬ್ರಾಡಿನ ನೆಮ್ಸಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1" />ಪಾಚ಼ಲ್ತೊ ಯಹೊವಾ ಮೊಶೆನೆ, <verse eid="EXO 40:1" /><verse number="2" style="v" sid="EXO 40:2" />"ಪಸ್ಟಾನಾ ಮ್ಹೈನಾನಾ ಪಸ್ಟನಾ ದಿನ್ನಮಾ ದೆವದರ್ಶನ ಗುಡಾರ ಥಯಲ ಗುಡಾರನೆ ಉಟಾಡಿನ ಹುಬ್ರಾಡ. <verse eid="EXO 40:2" /><verse number="3" style="v" sid="EXO 40:3" />ಗುಡಾರಮಾ ದಕ್ಹ ಆಗನ್ಯಾ ರ‍್ಹಯಲ ಒಡಂಬಡಿನಿ ಪೆಟಗಿ ಮ್ಹೆಲ. ಪೆಟಗಿನೆ ಪಡ್ದಾಕ್ಹು ಝಾಕಾಲಗಾಡ. <verse eid="EXO 40:3" /><verse number="4" style="v" sid="EXO 40:4" />ಪಾಚ಼ಲ್ತೊ ಟೆಬಲನಾ ಮ್ಹೈ ಮಂಗೈನ ಟೆಬಲಪರ ರ‍್ಹವಾನಾ ಸಾಮನೊ ತಿನಾ ಉಪ್ಪರ ಮ್ಹೆಲಾ ಲಗಾಡ. ದಿವ್ವಾನಾ ಖಂಬಾನೆ ಗುಡಾರಮಾ ಮ್ಹೆಲ. ದಿವ್ವಾನಾ ಖಂಬಾಮಾ ಕರೆಟ್ಟ ಜ಼ಗಾವೊಮಾ ಸಮೈಯ್ಯೊ ಮ್ಹೆಲಾಲಗಾಡ. <verse eid="EXO 40:4" /><verse number="5" style="v" sid="EXO 40:5" />ಗುಡಾರಮಾ ಧವಾಂಡೊ ಘಾಲಾನೆ ಕ್ಹೊನಾನಿ ವೆದಿಕೆ ಮ್ಹೆಲ. ವೆದಿಕೆನೆ ಒಡಂಬಡಿಕೆನಾ ಪೆಟಗಿನಾ ಕ್ಹಾಮೊ ಮ್ಹೆಲಾಲಗಾಡ. ಪಾಚ಼ಲ್ತೊ ಗುಡಾರನಾ ಕ್ಹಾಮಲಿ ವಾಟಮಾ ಪಡ್ದೊ ಘಲಾ. <verse eid="EXO 40:5" /><verse number="6" style="v" sid="EXO 40:6" />"ದೆವದರ್ಶನ ಗುಡಾರ ಥಯಲ ಗುಡಾರನಾ ಮ್ಹೈ ಜಾ಼ವಾನಾ ವಾಟನಾ ಕ್ಹಾಮೊ ಬಲಿನೊ ಕಟ್ಟೊ ಮ್ಹೆಲಾಲಗಾಡ. <verse eid="EXO 40:6" /><verse number="7" style="v" sid="EXO 40:7" />ದೆವದರ್ಶನಾ ಗುಡಾರನೆ ವರಿ ಬಲಿನಾ ಕಟ್ಟಾನಾ ವಚ್ಮಾ ಥಾಳೊ ಮ್ಹೆಲಿನ ತಿಮಾ ಪಾನಿ ಭರೌ. <verse eid="EXO 40:7" /><verse number="8" style="v" sid="EXO 40:8" />ಅಂಗಳನಾ ಸುತ್ತೆಬಿ ಆವರಣನೆ ಹುಬ್ರಾಡಿನ ಅಂಗಳನಾ ಬಾಕಲನೆ ಪಡ್ದಾನೆ ಜೊತಾ ಲಗಾಡು.<verse eid="EXO 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 40:9" />ತೆಳಾಮಾ ಅಭಿಷೆಕನಾ ತೆಲನೆ ಲಿನ ಗುಡಾರನೆಬಿ ತಿಮಾ ರ‍್ಹವಾನು ಕ್ಹಾರುಜ಼ ತಿನಾ ಕ್ಹಾರಾ ಸಾಮ್ನೊನೆ ಅಭಿಷೆಕ ಕರು; ತೆಳಾಮಾ ತೆ ಪರಿಶುಧ್ಧ ಥಾವಸ. <verse eid="EXO 40:9" /><verse number="10" style="v" sid="EXO 40:10" />ಬಲಿನಾ ಕಟ್ಟಾನೆ ತಿನಾ ಸಾಮ್ನೊನೆ ಅಭಿಷೆಕ ಕರಿನ ಬಲಿನಾ ಕಟ್ಟಾನೆ ಪ್ರತಿಷ್ಟಿ ಕರು; ತೆ ಬಲಿನೊ ಕಟ್ಟೊ ಚೊಕಿತರಾ ಪರಿಶುದ್ದ ಥಯಲ ರ‍್ಹೌ. <verse eid="EXO 40:10" /><verse number="11" style="v" sid="EXO 40:11" />ಥಾಳಾನೆ ವರಿ ತಿನಾ ಪಿಠನೆ ಅಬಿಷೆಕ ಕರಿನ ಪ್ರತಿಷ್ಟಾ ಕರು.<verse eid="EXO 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 40:12" />ತೆನೈಸೊ ಆರೊನನೆ ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆ ದೆವದರ್ಶನಾ ಗುಡಾರನಾ ಬಾಕಲನಾ ಕ್ಹಾಮೊ ಬಲೈನ ತ್ಯುನೊನೆ ಅಂಗ ಧವಾಲಗಾಡಿನ <verse eid="EXO 40:12" /><verse number="13" style="v" sid="EXO 40:13" />ಆರೊನ ಮನೆ ಯಾಜಕ ಥಾವಸ ಕೈನ ತಿನೆ ತೆ ವಣ್ಣಾ ಘಾಲಿನ ತಿನೆ ಅಭಿಷೆಕ ಕರಿನ ಸರ್ಮಪಣೆ ಕರು. <verse eid="EXO 40:13" /><verse number="14" style="v" sid="EXO 40:14" />ಪಾಚ಼ಲ್ತೊ ತು ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆ ಆವಾಲಗಾಡಿನ ತ್ಯುನೊನೆ ಅಂಗ್ಡಾವೊ ಘಾಲಿನ <verse eid="EXO 40:14" /><verse number="15" style="v" sid="EXO 40:15" />ತ್ಯುನೆ ಮಾರಾಹುತಿ ಯಾಜಕೊ ಥಾವಾನಾಹುತಿ ತಉ ತಿನಾಬಾನೆ ಕಿಮ್ಮ ಅಭಿಷೆಕ ಕರ್ಯೊ ತೊ ತ್ಯುನೊನೆಬಿ ತಿಮ್ಮ ಅಭಿಷೆಕ ಕರು. ಆ ಅಬಿಷೆಕಕ್ಹು ಯಾಜಕತ್ವಬಿ ತ್ಯುನೊನೆಬಿ ತ್ಯುನಾ ಸಂತತಿವಾಲಾವೊನೆಬಿ ಶಾಶ್ವತ ಥಾವಾಸ ಕೈನ ಕದ್ಯೊ. <verse eid="EXO 40:15" /><verse number="16" style="v" sid="EXO 40:16" />ಯಹೊವಾ ಆಗನ್ಯಾ ದಿದಲ ನಿಂಗತಜ಼಼ ಮೊಶೆ ಕ್ಹಾರುಜ಼ ಕರ್ಯೊ.<verse eid="EXO 40:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 40:17" />ಬೆವಾ ವರಕ್ಹನಾ ಪಸ್ಟ ಮ್ಹೈನಾನಾ ಪಸ್ಟ ದಿನ್ನಮಾ ಮೊಶೆ ಗುಡಾರನೆ ಉಚೈನ ಹುಬ್ರಾಡ್ಯೊ. <verse eid="EXO 40:17" /><verse number="18" style="v" sid="EXO 40:18" />ತೆ ಗುಡಾರನೆ ಉಚೈನ ತಿನಾ ಗದಗಿನಾ ದಗ್ಡಾವೊನೆ ಘಾಲಿನ ಚೌಕಟೊ ಹುಬ್ರಾಡಿನ ಅಗಳಿಯೊ ದಿನ ಕ್ಹಂಬಾವೊನೆ ಹುಬ್ರಾಡ್ಯೊ. <verse eid="EXO 40:18" /><verse number="19" style="v" sid="EXO 40:19" />ಗುಡಾರನಾ ಉಪ್ಪರ ಪಡ್ಕು ವೈಚ್ಚೈನ ತೆ ಪಡ್ಕಾನೆ ಉಪ್ಪರಲಿ ಜ಼ಗಾಕನ ಸಿವನ ಘಾಲ್ಯೊ. ಯಹೊವಾ ಆಗನ್ಯಾ ದಿದಲ ನಿಂಗತಜ಼಼ ಮೊಶೆ ತೆ ಕ್ಹಾರುಜ಼ ಕರ್ಯೊ. <verse eid="EXO 40:19" /><verse number="20" style="v" sid="EXO 40:20" />ತೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಜುಷಮಾ ಮ್ಹೆಲಿನ ಮಂಜುಶನೆ ಲಾಕ್ಡಿಯೊ ದಿನ ತಿನಾ ಉಪ್ಪರ ಬೈಟಾನು ಆಸನ ಮ್ಹೆಲಿನ <verse eid="EXO 40:20" /><verse number="21" style="v" sid="EXO 40:21" />ಮಂಜುಷನೆ ಗುಡಾರನಾ ಮ್ಹೈ ಲೈನ ತಿನಾ ಕ್ಹಾಮೊ ಪರ್ದಾ ತುಗ ಘಾಲಿನ ಯಹೊವಾ ಆಗನ್ಯಾ ದಿದಲ ನಿಂಗತಜ಼಼ ಆಜ್ಞಾ ಶಾಸನೊನಾ ಮಂಜುಷನೆ ಗಾಯಬ ಕರ್ಯೊ. <verse eid="EXO 40:21" /><verse number="22" style="v" sid="EXO 40:22" />ತೆನೈಸೊ ಯಹೊವಾ ಆಗನ್ಯಾ ದಿದಲ ನಿಂಗತಜ಼಼ ಮೊಶೆ ದೆವದರ್ಶನಾ ಗುಡಾರನಾ ಮ್ಹೈ ಉತ್ತರಮಾಬಿ ತೆರೆನಾ ಭಾರೊ ಟೆಬಲ ಮ್ಹೆಲಿನ <verse eid="EXO 40:22" /><verse number="23" style="v" sid="EXO 40:23" />ತಿನಾ ಉಪ್ಪರಯಹೊವಾ ಮೊಶೆ ಆಗನ್ಯಾ ದಿದಲ ತಿಮ್ಮ ಯಹೊವಾನಿ ಸನ್ನಿದಿಮಾ ಟೆಬಲಪರ ರೊಕ್ಲಾವೊನೆ ಮ್ಹೆಲ್ಯೊ. <verse eid="EXO 40:23" /><verse number="24" style="v" sid="EXO 40:24" />ವರಿ ತೆ ದಿಪಸ್ತಂಬನೆ ದೆವ ದರ್ಶನಾ ಗುಡಾರನಾ ಮ್ಹೈ ಟೆಬಲನಾ ಕ್ಹಾಮೊ ಗುಡಾರನಾ ದಕ್ಷಿಣಮಾ ಮ್ಹೆಲಿನ <verse eid="EXO 40:24" /><verse number="25" style="v" sid="EXO 40:25" />ಯಹೊವಾ ಆಗನ್ಯಾ ದಿದಲ ನಿಂಗತಜ಼಼ ತಿನಾ ಸಮಯೊನೆ ಯಹೊವಾನಾ ಸನ್ನಿದಿಮಾ ಮ್ಹೆಲ್ಯೊ. <verse eid="EXO 40:25" /><verse number="26" style="v" sid="EXO 40:26" />ವರಿ ಕ್ಹೊನಾನಿ ಉದನೊ ಧುವಾಂಡೊ ದಿವಾನೊ ಕಟ್ಟಾನೆ ದೆವದರ್ಶನಾ ಗುಡಾರಮಾ ಬಾಕಲನಾ ಕ್ಹಾಮಾ ಮ್ಹೆಲಿನ <verse eid="EXO 40:26" /><verse number="27" style="v" sid="EXO 40:27" />ಯಹೊವಾ ಆಗನ್ಯಾ ದಿದಲ ನಿಂಗತ ತಿನಾ ಉಪ್ಪರ ಚೊಕಿ ಬಾಸನು ದ್ರವ್ಯನಾ ಉದನೆ ಘಾಲ್ಯೊ. <verse eid="EXO 40:27" /><verse number="28" style="v" sid="EXO 40:28" />ವರಿ ಮೊಶೆ ಗುಡಾರನಾ ಬಾಕಲನೆ ಪಡ್ದೊ ಘಾಲ್ಯೊ. <verse eid="EXO 40:28" /><verse number="29" style="v" sid="EXO 40:29" />ಯಹೊವಾ ಆಗನ್ಯಾ ದಿದಲ ನಿಂಗತ ದೆವದರ್ಶನಾ ಗುಡಾರನಾ ಬಾಕಲನಾ ಕ್ಹಾಮೊ ಯಜ್ಞವೆದಿ ಮ್ಹೆಲಿನ ತಿನಾ ಉಪ್ಪರ ಸರ್ವಾಂಗ ಹೊಮ ಧಾನ್ಯ ಸಮರ್ಪಣೆನೆ ಕರ್ಯೊ. <verse eid="EXO 40:29" /><verse number="30" style="v" sid="EXO 40:30" />ಮೊಶೆ ದೆವದರ್ಶನಾ ಗುಡಾರನೆಬಿ ಬಲಿನಾ ಕಟ್ಟಾನಾಬಿ ವಚ್ಮಾ ಥಾಳಾನೆ ತ್ಯಾ ಮ್ಹೆಲಿನ ಧ್ಯಲಿ ಲಿವಾನಾಹುತಿ ತಿಮಾ ಪಾನಿ ಭರಾಯೊ. <verse eid="EXO 40:30" /><verse number="31" style="v" sid="EXO 40:31" />ತಿಮಾ ಮೊಶೆ ಆರೊನನ ತಿನಾ ಬಚ್ಚಾ ಹತೊ ಪಗೊ ಧ್ಯಲೆತಾತಾ. <verse eid="EXO 40:31" /><verse number="32" style="v" sid="EXO 40:32" />ಯಹೊವಾ ಆಗನ್ಯಾ ದಿದಲ ನಿಂಗತ ದೆವದರ್ಶನಾ ಗುಡಾರಾನಾ ಮ್ಹೈ ಜಾ಼ತಾ ಟೈಮಾ ಯಜ್ಞವೆದಿನಾ ಸೆವೆನೆಬಿ ಆತಾಮಾ ಹತೊ ಪಗೊನೆ ಧ್ಯಲೆತಾತಾ. <verse eid="EXO 40:32" /><verse number="33" style="v" sid="EXO 40:33" />ಗುಡಾರನೆಬಿ ಯಜ್ಞವೆದಿನಾಬಿ ಸುತ್ತೆಬಿ ಅಂಗಳನಾ ಕ್ಹಂಬಾ ಉಚೈನ ಹುಬ್ರಾಡಿನ ಅಂಗಳನಾ ಬಾಕಲನೆ ಪಡ್ದೊ ಘಾಲ್ಯೊ. ಅಮ್ಮ ಮೊಶೆ ತೆ ಕಾಮ ಕ್ಹಾರು ಮುಗ್ಸಾಯೊ.<verse eid="EXO 40:33" /></para>
  <para style="s">ಯಹೊವಾನಿ ಸನ್ನಿದಿಮಾ ಗುಡಾರನಾ ಉಪ್ಪರ ಮ್ಹಾಡ ಝಾಕಿ ಪಡ್ಯುತು</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34" />ತೆ ಮ್ಹಾಡ ದೆವದರ್ಶನು ಗುಡಾರನೆ ಝಾಕಿಪಡ್ಯುತು; ಯಹೊವಾನೂ ಮಹಿಮಾ ಗುಡಾರಮಾ ಭರಿಗಯುತು. <verse eid="EXO 40:34" /><verse number="35" style="v" sid="EXO 40:35" />ಮ್ಹಾಡ ದೆವದರ್ಶನಾ ಗುಡಾರನಾ ಉಪ್ಪರ ಬಾಜು಼ ರ‍್ಹಯಲಕ್ಹು ಯಹೊವಾನು ಮಹಿಮಾ ಗುಡಾರನಾ ಮ್ಹೈ ಭರಲಕ್ಹು ಮೊಶೆ ಗುಡಾರಮಾ ಗಯೆವಾಚಿಜ ವ್ಹತ್ತೊ. <verse eid="EXO 40:35" /><verse number="36" style="v" sid="EXO 40:36" />ತೆ ಮ್ಹಾಡ ಗುಡಾರನೆ ಛೊಡಿನ ಉಪ್ಪರ ಗಯಲ್ಪರ ಇಸ್ರಾಯೆಲೊ ಕ್ಹಾಮಾ ಪ್ರಯಾಣ ಕರಸ; <verse eid="EXO 40:36" /><verse number="37" style="v" sid="EXO 40:37" />ತೆ ಮ್ಹಾಡ ನೈಜ ಛೊಡ್ತಾಮಾ ತೆ ಛೊಡೆಲಕ್ಕಾ ಪ್ರಯಾಣ ಕರೆವಾಚಿ ರ‍್ಹವಸ. <verse eid="EXO 40:37" /><verse number="38" style="v" sid="EXO 40:38" />ಇಸ್ರಾಯೆಲೊನಾ ಕ್ಹಾರಾ ಪ್ರಯಾಣಮಾಬಿ ತ್ಯುನಾ ಡೊಳಾ ಕ್ಹಾಮೊ ದಿನ್ನನಾ ಟೈಮೆ ಯಹೊವಾನಿ ಮ್ಹಾಡ ಗುಡಾರನಾ ಉಪ್ಪರ ವ್ಹತ್ತು; ರಾತನಾ ಟೈಮಾ ತೆ ಮ್ಹಾಡಮಾ ಆಗ ಲಾಗಲ ರ‍್ಹತಿತಿ.<verse eid="EXO 40:38" /></para>
  <chapter eid="EXO 40" />
</usx>