<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Shikkalgar</book>
  <para style="h">ಕೊಲೆಸ್ಸೆ</para>
  <para style="toc3">ಕೊಲೆಸ್ಸೆ</para>
  <para style="toc2">ಕೊಲೆಸ್ಸೆ</para>
  <para style="toc1">ಕೊಲೆಸ್ಸೆವಾಲಾವೊನೆ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="mt2">ಕೊಲೊಸ್ಸೆಯರಿಗೆ ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ಕೊಲೆಸ್ಸೆವಾಲಾವೊನೆ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">1 ಕೊಲೆಸ್ಸವಾಲಾವೊನೆ ಬರ್ದಾನು ಪತ್ರ ಪೌಲಾ ಬರ್ದಸ. <char style="xt"><ref loc="COL 1:1">1:1</ref></char> ತೆ ಎ ಪತ್ರ ಕ್ರಿಸ್ತ ಹುಟ್ಟೆಲ ಪರ ಘನು 60 ವರಕ್ಹಮ್ಮಾ ಬರ್ದಸ. ತೆ ಟೈಮಾ ತೆ ಘನೊ ರೊಮನಾ ಜೆಲಮ್ಮಾ ವ್ಹತ್ತೊ. ಕೊಲೆಸ್ಸ ಬರ್ದಲ ಪತ್ರ ಎಫೆಸ ಬರ್ದಲ ಪತ್ರ ವರಿ ತಿಮೊಥಿನೆ ಬರ್ದಲ ಪತ್ರ ತೆ ಪತ್ರವೊನೆ ಜೆಲಮ್ಮಾ ಬರ್ದಲ ಪತ್ರ ಕೈನ ಕವಸ. ಕಾಕದ್ಯಾಮ ತೆ ಪತ್ರ ಬರ್ದತ್ತಾಮಾ ತೆ ಜೆಲಮ್ಮಾ ವ್ಹತ್ತೊ. ತೆ ಪತ್ರ ಕೊಲೆಸ್ಸ ಗಾಮವಾಲಾವೊನೆ ಬರ್ದಸ. <char style="xt"><ref loc="COL 2:1">2:1</ref></char> ಮಾ ಕದಲನಿಂಗತ ಕೊಲೆಸ್ಸ ಸಭೆನೆ ಶುರು ಕರ‍್ಯೊ ನೈ,ತೆನೈಸೊ ತಿನಾಹುತಿ ದಕ್ಹಾ ಜವಾಬ್ದರಿಯೊ ವ್ಹಂದಿಲಿದ್ಯೊ. ಎಪಪ್ರೊದಿತ ಕೊಲೆಸ್ಸವಾಲೊ ಥೈನ ರ‍್ಹಯಲಕ್ಹು ತೆ ಸಭೆ ಭಾಂದಾನಾಹುತಿ ಸಾಧ್ಯ ಛೆ. ಪೌಲಾ ಸಭೆಮ್ಮಾ ದಕ್ಹಾ ಸುಳ್ಳ ಬೊದನೆ ಚಾ಼ಲಾಕ್ಹು ಕಾಳಜಿ ಕರಾವಾಲೊ ಥಾವಸ. ತೆ ಪತ್ರಮ್ಮಾ ತೆ ಘನೊ ತೆ ವಿಷಯಮಾ ಬರ್ದಸ. ತ್ಯಾ ಜು಼ನು ವಡಂಬಡಿಕೆ ಯಹುದ್ಯೊ ನಿಯಮನು ವಿಶ್ವಾಸಿಯೊ ಪಾಲನೆ ಕರು ಕೈನ ಖಾಸ ಕರಿನ ಸುನ್ನತಿ ಕರಲಿವಾನು ಕೈನ ವತ್ತಾಯ ಕರಾನು ಯೆಹುದಿಯೊ ವಿಶ್ವಾಸಿಯೊನು ಕವಾನು ಯಕ್ಕ ಗುಂಪ ವ್ಹತ್ತು. ಪೌಲಾ ಸ್ಪಷ್ಟ ವಿಸ್ವಾಸಿಯೊ ಕ್ಹುದಾಕ್ಹು ಸ್ವಿಕಾರ ಕರಾನು ಕ್ರಿಸ್ತನಾ ಹೊರತಾಗಿ ಕುನ ವರಿ ಕೈಯುಜ಼ ಜರುತ್ತ ನತ್ತಿ. ವರಿ ತೆ ಬೊದನೆ ಮನಕ್ಹೊ ಉಪಯೊಗ ಕರು ನೈಸೊ ಕಾರಣಪರ ಹೊಂದಿಲಿನ ಜಾ಼ವಸ ಕೈನ ಬರ್ದಸ. <char style="xt"><ref loc="COL 2:8">2:8</ref></char></para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1) ಕೊಲೆಸ್ಸ ಸಬೆನೆ ವಂದನೆ ಕರತ್ತೊ ಪೌಲಾ ತೆ ಪತ್ರ ಶುರು ಕರಸ. <char style="ior"><ref loc="COL 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2) ಪಾಚ಼ಲ್ತೊ ತೆ ಕ್ರಿಸ್ತನಾ ಶ್ರೆಷ್ಠತೆನಾಹುತಿ ಖಾಸ ಕರಿನ ಕೊಲೆಸ್ಸಮಾ ರ‍್ಹಯಲ ಸುಳ್ಳ ಬೊದನೆನೆ ಪ್ರತಿ ಉತ್ತರ ದಿವಾನಾ ವಿಷಯಮ್ಮಾ ಬರ್ದಸ. <char style="ior"><ref loc="COL 1:3-3:4">1:3—3:4</ref> </char></para>
  <para style="io1">3) ತೆ ಘನ್ನಾ ಪತ್ರಿಯೊ ನಿಂಗತ ಪೌಲಾ ತಿನು ಅರ್ಧಕ್ಹು ಅರ್ಧು ಪತ್ರ ವಿಶ್ವಾಸಿಯೊ ಜಿವ್ನಾಕರು ಕೈನ ಖಾಸ ರ‍್ಹಯಲ ಸುಚನೆ ದಿವಸ. <char style="ior"><ref loc="COL 3:5-4:6">3:5—4:6</ref></char></para>
  <para style="io1">4) ಪೌಲಾ ವಂದನಾ ಕರಾನಾ ಮುಲಕ ವರಿ ತೆ ಪತ್ರ ಬಿಜಾ಼ ಸಬೆಮ್ಮಾ ಜೊ಼ರ ಒದು ಕೈನ ಸುಚನೆ ದೆತೊ ಪೌಲಾ ತೆ ಪತ್ರನಾ ಕ್ಹರಾವಸ. <char style="ior"><ref loc="COL 4:7-18">4:7-18</ref> </char></para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />ಕ್ಹುದಾ ತಿನಾ ಚಿತ್ತಾನಾ ಅನುಸಾರ ಯೆಸುಕ್ರಿಸ್ತನೊ ಅಪೊಸ್ತಲ ಥಯಲ ಪೌಲಾ ವರಿ ಭೈ ಥಯಲ ತಿತಾ ಬರ್ದಲ ಪತ್ರ.<verse eid="COL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2" />ಕೊಲೆಸ್ಸಮಾ ರ‍್ಹಯಲ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ ಕದ್ಯಾಮ ಕ್ರಿಸ್ತಮಾ ಬರೊಕ್ಹೊವಾಲಾ ವರಿ ಪವಿತ್ರ ಥಯಲ ಭಾಯೊ, ಭೆನೊನೆ ಮಿ ಎ ಪತ್ರ ಮಾರೊ ಭಯ ಥಯಲ ತಿಮೊಥಿನಾ ಕ್ಹಾತೆ ಮಳಿನ ಬರ್ದಾಡ್ಯೊಸ.</para>
  <para style="p" vid="COL 1:2">ಮಾರೊ ಬಾ ಥಯಲ ಕ್ಹುದಾಕ್ಹು ತಮೊನೆ ಮರಗಾ,ಶಾಂತಿ ಮಳಾದೆ.<verse eid="COL 1:2" /></para>
  <para style="s">ಸ್ತುತಿ ವರಿ ಪ್ರಾಥನಾ</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />ಹಮೆ ಪ್ರಾರ್ಥನಾ ಕರ್ತಾಮ್ಮಾ ತಮಾರಾ ವಿಷಯಮ್ಮಾ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರ ಕೈಯೆಸ. ಮಾರೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತ ಬಾ ಥಯಲ ಕ್ಹುದಾ <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />ಹಮೆ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರ ಕರಾನೆ ಕಾರಣ ಸುವೈ ಕದ್ಯಾಮ ಕ್ರಿಸ್ತಮಾ ಯೆಸುಮಾ ರ‍್ಹಯಲ ತಮೊನೆ ರ‍್ಹಯಲ ಬರೊಕ್ಹಾನಾ ಹುತಿ, ಕ್ಹುದಾ ಮನಕ್ಹೊ ಪರ ತಮೊನೆ ರ‍್ಹಯಲ ಮಯಾನಾಹುತಿ ಪುಚ್ಯೊಸ. <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />ತಮೊನೆ ನಿರಿಕ್ಷೆ ರ‍್ಹಯಲನಾಹುತಿ ಕ್ರಿಸ್ತನಾ ಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲ್ಯಾ ವರಿ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ ಮಯಾ ಕರ‍್ಯೊ. ತಮೆ ನಿರಿಕ್ಷೆ ಕರಾನು ತಮಾರಾಹುತಿ ಸ್ವರ್ಗಲೊಕಮಾ ತಯಾರ ಕರ‍್ಯಾಸ ಕವಾನು ತಮೊನೆ ತಿಳ್ದಾಸ. ತಮೊನೆ ತಿಳ್ಸಾಯೆಲ ಕ್ಹರಿ ವಾಕ್ಯ ಕದ್ಯಾಮ ಸುವಾರ್ತೆನೆ ತಮೆ ಪುಚತ್ತಾಮ್ಮಾ ತೆ ನಿರಿಕ್ಷೆನಾಹುತಿ ತಿಳದಿಲಿದ್ಯಾಸ. <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />ತಮೆ ಸುವಾರ್ತೆ ಐಕಿ ಕ್ಹುದಾನಿ ಮರಗಾನಿ ಕ್ಹರಿ ತಿಳ್ದಿಲಿದಲಕ್ಹು ಸುವಾರ್ತೆ ತುಮೊಮ್ಮಾ ಘನಿ ಥಾವಾಡಿಸ ವರಿ ಮನಕ್ಹೊನೆ ಆಶಿರ್ವಾದ ಥೈನ ರ‍್ಹೈಯುಸ. ತಿನಾನಿಂಗತಜ಼ ದುನಿಯಾಮಾ ಕ್ಹಾರಿ ಜ಼ಗಾಬಿ ಸುವಾರ್ತೆ ಘನಿ ಥಾವಾಡಿಸ ವರಿ ಆಶಿರ್ವಾದ ಥೈನ ರ‍್ಹವಸ. <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />ತಮೆ ಎಪಫ್ರದಿಕ್ಹು ಕ್ಹುದಾನಿ ವರಗಾ ತಿಳ್ದಿಲಿದ್ಯಾಸ. ತೆ ಹಮಾರಾ ಕ್ಹಾತೆ ಸೆವೆ ಕರಾಡ್ಯೊಸ. ಹಮೆ ತಿನೆ ಮಯಾ ಕರೆಯೆಸ. ತೆ ಹಮಾರಾಹುತಿ ಕ್ರಿಸ್ತನೊ ಬರೊಕ್ಹೊವಾಲೊ ಸೆವಕ ಥಯೊಸ. <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />ಪವಿತ್ರ ಆತ್ಮಾನೆ ಪ್ರೆರಿತ ಥಯಲ ತುಮಾರಿ ಮಯಾನಾ ಹುತಿ ರ‍್ಹಯಲ ವಿಷಯ ಮನೆ ಕೈನ ದಿದಲ ತೆಜ಼ ವ್ಹೈ.<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />ಇಮ್ಮ ರ‍್ಹಯಲ ಹುತಿ ಎ ತುಮಾರಿ ಮಯಾನಾ ಹುತಿ ಹಮೆ ಐಕಲ ದಿಂತಾ ತುಮಾರಾ ಹುತಿ ಇಕ್ಹರ‍್ಯಾವಾಚಿ ತುಮೆ ಕ್ಹಾರಿ ತರಾನಿ ಆತ್ಮಿಕನಿ ವಿಷಯನಾ ಹುತಿ ಗ್ಯಾನಕ್ಹು ಕ್ಹುದಾನಿ ಚಿತ್ತ ತಿಳದಿಲಿವಾನಾಹುತಿ <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />ಕ್ಹುದಾನಿ ಪಸಂಪ ಡೊಳಾ ದಿಕ್ಹಾವರಕ್ಹಾ ತುಮೆ ಚೊ಼ಕಾ ಥಛ ಕೈನ ಕ್ಹಾರಿ ತರಾನಾ ಚ಼ೊಕಾ ಫಲ ದಿವಾಲಾ ಥೌ ಕೈನ ಬೆಳತ್ತಾ ರ‍್ಹೌ ಕೈನ <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />ತಿನಿ ಮಹಿಮಾನಿ ತಾಕತ ನಿಂಗತ ಕ್ಹಾರಿ ತರಾಮಾ ತಾಕತ ಹೊಂದಿನ ಕ್ಹಾರಿ ರಾಕ್ಹು ತಡ್ಇಲಿವಾನು ಶಾಂತಿ ಸಮಾಧನಕ್ಹು ತಡ್ದಿಲ್ಯು ಕೈನ, <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />ಕ್ಹುದಾನಾ ಭಕ್ತೊ ಕ್ಹುದಾನಾ ಉಜಾಲಾಮಾ ರ‍್ಹಯಲ ವಾಟೊ ಲಿವಾನಾ ಹುತಿ ಅಪೊನೆ ಯೊಗ್ಯ ಕರಿನ <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />ಕ್ಹುದಾ ಅಪೊನೆ ಅಂದಕಾರನೊ ಅದಿಕಾರಮತೊ ಛೊಡೈನ ತಿನಾ ಮಯಾನಾ ದಿಕ್ರಾನಾ ರಾಜ್ಯಮಾ ಮಳಾಯೊ. <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />ಎ ದಿಕ್ರಾಮಾ ಅಪ್ನಾ ಪಾಪೊ ಮಾಫಕರಿನ ಅಪೊನೆ ಬಿಡುಗಡೆ ಥೈ.<verse eid="COL 1:14" /></para>
  <para style="s">ಕ್ರಿಸ್ತ ವರಿ ಕಾಮ</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />ಕ್ರಿಸ್ತ ನೈ ದಿಕ್ಹಾನು ಕ್ಹುದಾನು ರೊಪ ವ್ಹೈ. ಕ್ಹಾ ಸೃಷ್ಠಿನೆ ತೆಜ಼ ಮ್ಹೊಟೊ ವ್ಹೈ. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />ಭುಪರ ಲೊಕಮಾ ರ‍್ಹಯಲ ದಿಕ್ಹಾನಿ ನೈ ದಿಕ್ಹಾನು ಕ್ಹಾರುಜ಼ ಸಿಂಹಾಸನ್ನ ರ‍್ಹೈನೆಕಾ ಕ್ಹಾರವೊಪರ ಅದಿಕಾರ ರ‍್ಹೈನೆಕಾ ತಿನಾಕ್ಹುಜ಼ ತಯ್ಯಾರ ಥಯು. ಕ್ಹಾರುಜ಼ ತಿನಾಕ್ಹುಜ಼ ವರಿ ತಿನಾಹುತಿಜ಼ ತಯ್ಯಾರ ಥಯು. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />ತೆ ಕ್ಹಾರಾವೊತಿ ಪೈಲಾಜ಼ ರ‍್ಹಯಲವಾಲೊ ವ್ಹೈ. ತಿಮಾ ಕ್ಹಾರುಜ಼ ಯಕ್ಕ ಥಯುಸ. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />ಸಬೆ ಕವಾನು ಅಂಗನೆ ತೆ ಮಾತು ಥಯೊಸ. ಕ್ಹಾರಾವೊಮಾ ತೆಜ಼ ಪೈಲಾ ವ್ಹೈ. ಮರಲವಾಲಾವೊಮಾತೊ ತೆಜ಼ ಜಿವ್ತೊ ಥೈನ ಉಟಿನ ಆಯಲವಾಲೊ ತೆಜ಼ ವ್ಹೈ. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />ಕಾಕದ್ಯಾಮ ತಿಮಾಜ಼ <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />ವರಿ ತೆ ಶಿಲುಬಿಪರ ಚುವಾಯಲ ರಗತಕ್ಹು ತಿಕ್ಹು ಸಮಾಧಾನ ಹುಟ್ಸಿನ ವರಿ ಭುಪರಲೊಕಪರ ರ‍್ಹಯಲ ಕ್ಹಾರುಜ಼ ತಿನಾ ದಿಕ್ರಾನಾ ಮುಲಕ ಸಮಾಧಾನ ಕರಿಲ್ಯು ಕೈನ ಬಾ ಥಯಲ ಕ್ಹುದಾ ಆಸ ಕರ‍್ಯೊ.<verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />ಎನೈಸೊ ಪೈಲಾನ ಕಾಲ್ಮಾ ರ‍್ಹಯಲ ಬಿಜಾ಼ ಮನಕ್ಹೊ ಕೆಟ್ಟ ಕಾಮೊಕ್ಹು ಮನಸ್ಮಾ ಶಿಟ್ಟ ಮ್ಹೆಲ್ಲಿನ ತಿನಾ ವಿರೊದಿಯೊ ಥಯಾತಾ. <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />ಹಮ್ನಾತೊ ಕ್ಹುದಾ ತುಮೊನೆ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಅಂಗನಾ ಮರಣನಾ ಮುಲಕ ವಪ್ಪಂದ ಕರಿಲಿದ್ಯೊಸ. ಕ್ಹುದಾ ತಿನಿ ಸನ್ನಿಧಿಮಾ ತುಮೊನೆ ಪರಿಶುದ್ಧ ಕರಿನ, ತುಮೊಮಾ ಸುಜ಼ ತಪ್ಪ ನೈಸೊ ಕರಿನ ಹುಬ್ರಾಡು ಕೈನ ಕ್ಹುದಾ ಇಮ್ಮ ಕರ‍್ಯೊ.<verse eid="COL 1:22" /></para>
  <para style="s">ಪೌಲಾ ಸಭೆನಾಹುತಿ ಸೆವೆ</para>
  <para style="p">
    <verse number="23" style="v" sid="COL 1:23" />ಹಬಾಳನಾ ಹೆಟು ರ‍್ಹಯಲ ಕ್ಹಾರಿ ಸೃಷ್ಟಿನೆ ಕದಲ ಸುವಾರ್ತೆಕ್ಹು ಹುಟ್ಟಲ ಆಸಕ್ಹು ಹಲ್ಲು ನೈ ಕೈನ ಬರೊಕ್ಹಾಮಾ ಘಟ್ಟ್ಟ ಹುಬ್ರಯಲ ರ‍್ಹಯಾಮ <verse eid="COL 1:23" /><verse number="24" style="v" sid="COL 1:24" />ಮಿ ಹಮ್ನಾ ತುಮಾರಾ ಹುತಿ ಅನುಭವಿಸ್ತೊ ರ‍್ಹಯಲ ತ್ರಾಸಮಾ ಖುಶಿ ರ‍್ಹೈನ ಕ್ರಿಸ್ತನಾ ತ್ರಾಸಮಾ ಹಜುಸನ ಉಗ್ರಲ ಸಭೆ ಕವಾನಿ ತಿನಾ ಅಂಗನಾ ಹುತಿ <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />ಕ್ಹುದಾನಾ ಮನಸ ನಿಂಗತ ತುಮಾರಾ ಚೊ಼ಕಾನಾ ಹುತಿ ಮಿ ತುಮಾರಿ ಸಭೆನೆ ಸೆವಕ ಥಹಯೊ. <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />ಎ ದಡಿ ರ‍್ಹಯಲ ಕ್ಹರಿನಿ ವಾಕ್ಯಾ ಪಾಚ಼ಲ್ಯಾ ಯುಗತು ಮಾತಾ ಮಾತಾತು ದಡಿನ ವ್ಹತ್ತು. ತೆ ವಾಕ್ಯಾ ಕ್ಹುದಾ ಹಮ್ನಾ ತುಮಾರಾ ಕ್ಹಾಮಾ ಲಾಯೊಸ. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />ಎ ಮರ್ಮಾನಿ ಮಹಿಮಾ ಕೆಕ್ಲು ಛೆ ಕವಾನು ಬಿಜಾ಼ ಮನಕ್ಹೊನೆ ಕವಾನಾ ಹುತಿ ಕ್ಹುದಾ ಮನಸ ಕರ‍್ಯೊ. <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />ಅಪೆ ತಿನೆ ಕತಛೆ, ಕ್ಹಾರಾವೊನೆಬಿ ಗ್ಯಾನ ಕತಾ ವರಿ ಕ್ಹಾರಾವೊನೆ ರ‍್ಹಯಲ ಕ್ಹಾರುಜ಼ ಗ್ಯಾನ ಕತಾ <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />ಮಾರಾಮಾ ಕಾಮಾ ಪುರಾ ಕರಾನು ಕ್ಹುದಾನಿ ತಾಕತಕ್ಹು ಇನಾಹುತಿಜ಼ ರಾಬುಸ.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />ಮಿ ತುಮೊನೆಘನ್ನೊ ಕೊಶಿಶ ಕರಾಡ್ಯೊಸ ಕವಾನು ತುಮೊನೆ ಗ್ವತ್ತ ರ‍್ಹೌ ಕವಾನು ಎನೈಸೊ ವಲೊ ದೆಕಿಮಾ ರ‍್ಹಯವಾಲಾವೊನೆ ವರಿ ಮನೆ ನೈಸೊ ದೆಕಲವಾಲಾವೊನೆ ಮದತ ಕರಾನೆ ಕೊಶಿಶ ಕರಾಡ್ಯೊಸ. <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />ತ್ಯುನೆ ಅಂತರ್ಯಮಾ ಆಸಕ್ತಿವಾಲಾ ಮಯಾಮಾ ಯಕ್ಕ ಥೈನ ರ‍್ಹೌ ಕೈನ <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />ಯೆಸು ಸ್ವಾಮಿಮಾಜ್ ಹರಯಕ ಗ್ಯಾನ ವರಿ ಪುರಾ ಛೆ.<verse eid="COL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4" />ಕುನ್ನಜ ತುಮೊನೆ ಮಯಾನ ವಾತೊಕ್ಹು ಮೊಸ ಕರು ನೈ ಕೈನ ಮಿ ಆ ಕ್ಹಾರು ಕವಾಡೊಸ <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />ಮಿ ತ್ಯಾ ತುಮೊಕೊನ ನೈ ರ‍್ಹೈತಬಿ ಆತ್ಮಾಕ್ಹು ತುಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹೈನ ತುಮೆ ಯಕ್ ತೊರ್ ತರಿಕಾಕ್ಹು ಚಾಲನು ವರಿ ತುಮೆ ಬರೊಕ್ಹಾಮಾ ಘಟ್ಟ್ಟ ಹುಬ್ರಯಲ ದೆಕಿನ ಘನ್ನೊ ಖುಶಿ ಥೌಸ.<verse eid="COL 2:5" /></para>
  <para style="s">ಕ್ಹರಿನೊ ಜ಼ಲಮ ಕ್ರಿಸ್ತಜ಼ ದಿವಸ.</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />ತುಮೆ ಯೆಸು ಸ್ವಾಮಿನೆ ಮಲೈನಿಂಗತ ತಿನೆ ಮ್ಹೈ ಥೈನ ಜಿವಸೊ. <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />ತುಮೆ ತಿಮಾ ಬೆರುರಿನ,ತಿಮಾಜ಼ ಆಗಾ ಬಡತಾ ವರಿ ತುಮೊನೆ ಕದಲ ವಾಕ್ಯಾನಾ ಪ್ರಕಾರ ಬರೊಕ್ಹಾಕ್ಹು ರ‍್ಹೈನ ಕ್ಹುದಾನೆ ಜಾಸ್ತ-ಜಾಸ್ತ ಸ್ತೊತ್ರಾ ಕವೊ.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />ಮೊಸ ಕರಾನಾ ವರಿ ಕಾಮ ನೈಸೊ ಆವಾನಾ ತತ್ವಗ್ಯಾನ ಭೊದನೆಕ್ಹು ತುಮೊನೆ ಕುನ್ನ ತ್ಯುನಾ ಬಸಮಾ ಕರಲಿದ್ಯಾ ವಾಚಿ ಹುಶಾರ ರ‍್ಹವೊ. ಆ ಕ್ಹಾರು ಮನಕ್ಹೊನಿ ಪದ್ಧತ ವರಿ ಲೊಕನಿ ಬೊದನೆನೆ ಸಂಬಂದ ಪಡೆಲ ವ್ಹೈ ಕ್ರಿಸ್ತನೆ ನವೈ. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />ಕ್ಹುದಾನಿ ಹರಯಕ್ಕ ಗುಣಾ ಕ್ರಿಸ್ತಮಾ ಹೊತ್ತು. <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />ತೆ ಹರಯಕ್ಕ ಅದಿಕಾರ ವರಿ ಅದಿಕಾರಿಯೊತಿ ಉಪ್ಪರ ರ‍್ಹಯಲಕ್ಹು ತುಮೆ ತಿನಾಮಾ ರ‍್ಹೈನ ತಿನುಪುರಾ ಹೊಂದಿಲಿದ್ಯಾ. <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />ಕ್ಹುದಾ ತಿಮಾ ಮನಕ್ಹೊನಾ ಹತೆನೈಸೊ ಥಾವಾನು ಖತ್ನಾ ಕರ‍್ಯೊಸ. ಕ್ರಿಸ್ತನಿ ಸುನ್ನತಿ ಶಾರಿರಿಕ ಥಯಲ ಪಾಪ್ನಿಯೊ ಚಾಳಿಯೊ ಕಾಡಿಪಾಡಾನುಜ಼ ವ್ಹೈ. <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />ತುಮೆ ಬಾಪ್ತಿಸ್ಮ ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ಬುರ‍್ಯಾ ವರಿ ತಿನೆ ಮರಲವಾಲಾವೊಮಾತೊ ಉಟಾಡಲ ಕ್ಹುದಾನಿ ತಾಕತಮಾ ಬರಕ್ಹೊ ಮ್ಹೆಲಾನಾ ಮುಲಕ ತಿನಾ ಕ್ಹಾತೆ ತುಮೆ ಉಟಿನ ಆಯಾಸ. <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />ಅಪರಾದ ಕರ‍ಲ ಹುತಿ ವರಿ ಶರಿರನಾಭಾವ ಕ್ಹು ಮರಲವಾಲಾ ಥಯಲ ತುಮೊನೆ ಕ್ಹುದಾ ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ಜಿವ್ತೊ ಕರ‍್ಯೊಸ ವರಿ ತ್ಯುನೆ ಕರಲ ತಪ್ಪ ಕ್ಹಾರಾ ಮಾಫ ಕರ‍್ಯೊಸ. <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />ಅಪೆ ಪುರಾಜ಼ನಾ ಪಾಪಿಯೊ ವ್ಹೈ ಕೈನ ಅಪೊನೆ ದೆಕಾಡಿನ ದಿವಾನು ಆಗ್ಯಾನಾ ರುಪಮಾ ರ‍್ಹಯಲ ಕಾಗಜ್ ಕಾಡಿನ ಶಿಲುವಿಪರ ತೆ ಘಾಲ್ಲಿನ ಅಪೊಪರ ರ‍್ಹಯಲ ತೆ ಕಾಗಜ್ ಕಾಡಿಪಾಡ್ಯೊ. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />ಕ್ಹುದಾ ತಿನೆ ವಿರೊದ ಥಯಲ ಅದಿಕಾರಿಯೊನೆ ವರಿ ತಾಕತೊನೆ ಹರಾಡಿನ ತ್ಯುನೊನೆ ಕಯುಜ ಶಸ್ತ್ರವಾಚಿ ಕರಿನ ಶಿಲವಿನೆ ಜಿತ್ತನಾ ಕ್ಹುಶಿಮಾ ತೆ ಕ್ಹಾರಾವೊನೆ ಪುರಿ ದುನಿಯಾನಾ ಕ್ಹಾಮೊ ಬಂದಿ ಕರಲ ಗುಲಾಮೊ ನಿಂಗತ ಮೆರವಣಗಿ ಕರ‍್ಯೊ.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />ತಿನಾಹುತಿ ಕ್ಹಾವಾಪಿವಾನಾ ಹುತಿ ರ್‍ಹೈನಕಾ ಸನ್ನ್ ಅಮಾಸ ವರಿ ಸಬ್ಬತ ದಿನ್ನನಾ ಹುತಿ ತುಮೆ ತಪ್ಪ ಕರಾಲಾ ವ್ಹೈ ಕೈನ ಕುನ್ನಜ ಫೈಸಲೊ ಕರ‍್ಯಾವಾಚಿ ರ‍್ಹವಾದೆ. <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />ಆ ಕ್ಹಾರು ಖಾಲಿ ಆಗಾ ಥಾವಾನಾ ಕಾಮೊನು ಭೌಲು ಥಯುಸ, ಅನು ಅಸಲಿ ರುಪ ಕ್ರಿಸ್ತಜ ವ್ಹೈ. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />ಮನಸ್ಮಾ ಕಪಟ ಮುಕ್ಕಿಲಿನ ಮಾಂಡ್ಯಾಜ ದಕ್ಹಾಜ಼಼ನಾ ನ್ಹಾನಾ ಥೈನ ಚಾ಼ಲಿನ ಕ್ಹುದಾನಾ ದುತೊನೆ ಆರಾದನಾ ಕರಸ,ವರಿ ಹಮೊನೆ ದರ್ಶನ ಮಳ್ಯುಸ ಕೈನ ಪ್ಹುಗಸ,ಲೊಕನಾ ಗ್ಯಾನಖು ಹಮೆಜ಼ ಮ್ಹೊಟಾ ವ್ಹೈ ಕೈನ ಕವಸ,ತ್ಯುನೊನೆ ತುಮಾರಿ ಜ಼ಗಾ ಕಾಳ್ಳಿವಾನೆ ದಿವೊ ನಕೊ. <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />ಅಮ್ಮ ರ‍್ಹಯಲವಾಲೊ ಕ್ರಿಸ್ತನೆ ಹೊಲ್ಸೆಲ ಭೆಜಾಖು ಸಂಬಂದ ತೊಡಿಲಿದಲ ನಿಂಗತ ವ್ಹೈ, ಕಿಮ್ಮ ಅಪ್ನೊ ಭೆಜೊ ಅಪ್ನಾ ಅಂಗನೆ ನರೊಖು ತಿನೆ ಚಾ಼ಯೆ ಥಯಲ ಬೆಳವಣಗಿ ದಿವಸ ತಿನಾನಿಂಗತ ಕ್ರಿಸ್ತನೆ ಜುಡೆಲವಾಲೊ ತಿನಾನಿಂಗತಜ಼ ಬೆಳ್ದತೊ ಜಾ಼ವಸ.<verse eid="COL 2:19" /></para>
  <para style="s">ಮರಾನು ವರಿ ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾನು</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />ಲೊಕನಿ ಪೈಲಾ ರ‍್ಹೈಯಲ ಬೊದನೆನಾ ಪಾಲೆ ತುಮೆ ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ಮರೆಲ ರ‍್ಹಯಾರೆ, ಹಮ್ನಾತೊಬಿ ಲೊಕನಾ ಮನಕ್ಹೊ ಕರಲ ಆಗ್ಯಾ ವರಿ ಉಪದೆಶ <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />ಆ ದ್ಹರು ನಕೊ, ಅನು ಸ್ವಾದ ದೆಕು ನಕೊ,ತೆ ಮುಟ್ಟು ನಕೊ ಆ ಕ್ಹಾರಾ ವಾತೊನೆ ಅದಿನ ಕಾ ಥಾವೊಶಿ? <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />ಆ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಕರಲ ಆಗ್ನೆ ವರಿ ಬೊದನೆ ಉಪಯೊಗ ಕರಿನ ಹಾಳ ಥಾವಾನಾ ಸಾಮ್ನೊನೆ ಸಂಬಂದ ಪಡೆಲ ವ್ಹೈ. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />ಆ ಕ್ಹಾರಾ ಉಪದೆಶ ಮನಕ್ಹೊ ಕರಲ ಪದ್ದತನಾ ಪ್ರಕಾರ, ಖಾಲಿ ದೆಕಾಡಾನಾ ಹುತಿ ಅಂಗನೆ ಬಗ್ಸಾಡಾನಾ ಹುತಿ ಗ್ಯಾನ ವ್ಹೈ ಕೈನ ದಿಕ್ಹಿನ ಆವಸ ಮಾತ್ರ ತೆ ಅಪ್ನಾಮಾ ರ‍್ಹಯಲ ದುನಿಯಾಮಾ ರ‍್ಹಯಲ ಆಶವೊನೆ ಭಂದಿನ ಘಾಲಾನೆ ನೈ ಆತು ವರಿ ಆ ಕ್ಹಾರು ಶಾನಾ ಕಾಮನು ನತ್ತಿ.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />ತುಮೆ ಕ್ರಿಸ್ತನಾ ಪುನರುತ್ಥಾನಮಾ ಭಾಗಿ ಥಯಾಸ ಕದ್ಯಾಮ ತುಮೆ ಪರಲೊಕನು ಉಪ್ಪರ ರ‍್ಹಯಲ ಹುಡುಕು, ತ್ಯಾ ಕ್ರಿಸ್ತ ಕ್ಹುದಾನಾ ಸಿದಾ ಬಗಲ ಬೈಟ್ಯೊಸ. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />ಭುಲೊಕಮಾ ರ‍್ಹಯಲ ಸಂಗತಿಯೊನಾ ಹುತಿ ನೈ, ಪರಲೊಕಮಾನಾ ಸಮಗತಿಯೊನಾ ಹುತಿ ವಿಚಾರ ಕರೊ. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />ಕಾಕದ್ಯಾಮ ತುಮೆ ಲೊಕನಾ ಪಾಲೆ ಮರಿನ ತುಮಾರೊ ಜು ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ಕ್ಹುದಾಕನ ಛೆ. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />ತುಮಾರೊ ಜುವ ಥೈಯಲ ಕ್ರಿಸ್ತ ಆತಾಖು ತುಮೆಬಿ ತಿನಾ ಕ್ಹಾತೆ ಮಹಿಮೆ ಆವೊಶಿ.<verse eid="COL 3:4" /></para>
  <para style="s">ಪೈಲಾನಿ ಜಿವಿತ ವರಿ ಹಮ್ನಾನಿ</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />ತಿನಾಹುತಿ ತುಮಾರಾಮಾ ರ‍್ಹಯಲ ಲೊಕಿನಿ ಆಸ ಕದ್ಯಾಮ, ಜಾರತ್ವ, <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />ಆ ಪುರಾ ಪಾಪೊನಾ ಹುತಿ ಕ್ಹುದಾನಿ ವಾತ ನೈ ಐಕಾಲಾ ಕ್ಹುದಾನಿ ಶಿಟ್ಟ ಇವ್ನೊಪರ ಆವಸ. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />ತುಮೆಬಿ ಪೈಲಾ ಆ ಕ್ಹಾರು ಕರಾಲಾ ಹೊತ್ತಾ.<verse eid="COL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8" />ಹಮ್ನಾತೊಬಿ ಶಿಟ್ಟ,ಖುಜ್ಜಾನು,ಸೊಕ್ಕ,ಭಿಜಾವೊಪರ ತಪ್ಪ ಘಾಲಾನು ವರಿ ಗಾಲೊ ದಿವಾನು ಛೊಡಿ ಪಡೊ. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />ಯಕ್ಲಾನೆ ಯಕ್ಲೊ ಮಾಂಡ್ಯಾ ಬೊಲೊನಕೊ, ಕಾಕದ್ಯಾಮ ತುಮೆ ಪೈಲಾನಿಯೊ ಪುರಾ ಚಾಳಿಯೊ ಛೊಡಿನ ಕ್ರಿಸ್ತನಾ ಚಾಳಿಯೊ ನಯೊ ಚಾಳಿಯೊ ಹೊಂದಿಲಿದಲ ವಾಲಾ ವ್ಹೈ. <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />ಆ ನೈ ಚಾಳಿ ಅಪೊನೆ ಸೃಷ್ಟಿ ಕರೆಲನಾ ಗ್ಯಾನನಾ ಪ್ರಕಾರ ದಿನ್ನೆ ದಿನ್ನೆ ನೈ ಥಾತಿ ಆವಸ. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />ಆ ಗ್ಯಾನ ಮಾ ಮಿ ಗ್ರಿಕ ವ್ಹೈ ಮಿ ಯಹುದ್ಯನೊ ವ್ಹೈ ಕೈನ ಫರಕ್ ನತ್ತಿ, ಖತ್ನಾ ಕರಿಲಿದಲವಲೊ ಖತ್ನಾ ನೈಕರಿಲಿದನವಾಲೊ ಕೈನ ಸುಜ಼ ಫರಕ ನತ್ತಿ, ಮಾರೊ ಮನಕ್ಹ ವ್ಹೈ ಮಾರೊ ಮನಕ್ಹ ನವೈ, ಆಳ ವ್ಹೈ ಆಳ ನವೈ ಕವಾನು ಸುಜ಼ ಫರಕ ನತ್ತಿ, ತಿನಾಹುತಿ ಕ್ರಿಸ್ತಜ ಕ್ಹಾರು ವ್ಹೈ ವರಿ ಪುರಾವೊಮಾ ರ‍್ಹವಾಲೊ ವ್ಹೈ.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />ತಿನಾಹುತಿ ತುಮೆ ಕ್ಹುದಾ ಡೊಳಮಾ ಪರಿಶುದ್ಧ ವರಿ ಕ್ಹುದಾ ತುಮೊನೆ ಮಯಾ ಕರಲ ಹುತಿ ತುಮೆ ಮರಗಾಲಾ, ದಯಾ ಕರಾಲಾ, ಮಿಜ಼ ನ್ಹಾನೊ ವ್ಹೈ,ವರಿ ಸಾತ್ವಿಕತ್ವ ವರಿ ಪುರಾ ತಾಳಿಲಿನ ಜಾವನಾ ಚೊ಼ಕಾ ಚಾಳಿಯೊ ಘಾಲ್ಲಿವೊ. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />ಯಕ್ಲಾನೆ ಯಕ್ಲೊ ಖಮಾಳಿನ ಗೈನ, ಬಿಜಾ಼ಯಕ್ಲಾಪರ ತಪ್ಪ ಘಾಲಾನಾಹುತಿ ಕಾರಣ್ ತುಮೊನೆ ಮಳ್ಯುತಬಿ, ತ್ಯುನೊಪರ ತಪ್ಪಘಾಲ್ಯಾವಾಚಿ ಮಾಫ ಕರೊ,ಕರ್ತಾ ತುಮೊನೆ ಮಾಫ ಕರೆಲನಿಂಗತ ತುಮೆಬಿ ಮಾಫ ಕರೊ. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />ಆ ಕ್ಹಾರಾವೊತಿಬಿ ಅಪೊನೆ ಪುರಾ ಕರಾನು ಮಯಾಜ್ ತುಮಾರಾಮಾ ಜಾಸ್ತ ರ‍್ಹವಾದೆ. <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />ಕ್ರಿಸ್ತನು ಸಮಾಧಾನ ತುಮಾರಾ ಮನಸ್ಮಾ ಆಳಾದೆ. ಆಜ ಸಮಾಧಾನಮಾ ತುಮೆ ಕ್ಹಾರಾ ಮಳಿನ ರ‍್ಹೌ ಕೈನ ಬಲಾಯೆಲ ಛೆ ತೆನೈಸೊ ಕ್ಹುದಾ ಕರಲ ಉಪಕಾರ ನೆನಸ್ತ ರ‍್ಹವೊ. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />ಕ್ರಿಸ್ತನಿ ವಾಕ್ಯಾ ತುಮಾರಾಮಾ ಸಮೃದ್ಧಿ ಥೈನ ರ‍್ಹವಾದೆ. ಹರಯಕ್ಕ ಗ್ಯಾನಖು ಯಕ್ಲಾನೆ ಯಕ್ಲೊ ಉಪದೆಶ ಕರತಾ ಗ್ಯಾನ ದೆತಾ ರ‍್ಹವೊ. ಕೀರ್ತನೆಖು,ಸ್ತುತಿ ಕರತಾ ವರಿ ಆತ್ಮಿಕನೆ ಸಂಬಂಧ ಪಡೆಲ ಗಿದ್ದೊಖು ತುಮಾರಾ ಮನಸ್ಮಾ ಕ್ಹುದಾನೆ ತೆ ಕರಲ ಉಪಕಾರೊನಾ ಹುತಿ ಖುಶಿ ಥೈನ ಸ್ತೊತ್ರ ಕವೊ. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />ತುಮೆ ತುಮಾರಾ ವಾತೊಖು ರ‍್ಹವಾದೆ,ತುಮಾರಾ ಚಾಳಿಯೊಖು ಸು ಕರಿತೊಬಿ ತೆ ಕ್ಹಾರು ಅಪ್ನೊ ಕರ್ತಾ ಥಯಲ ಯೆಸುನಾ ನಾಮಪರ ಕರೊ ವರಿ ಅಪ್ನೊ ಬಾ ಥಯಲ ಕ್ಹುದಾನೆ ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಸ್ತುತಿ ಕರೊ.<verse eid="COL 3:17" /></para>
  <para style="s">ನಿಯಮೊ</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />ಹೆಣ್ಣ ಮನಕ್ಹೊ, ಕರ್ತಾನೆ ಕರೆಕ್ಟ ಲಾಗೆಲ ನಿಂಗತ ತುಮಾರಾ ಮಾಟಿಯೊನೆ ಅಧಿನ ಥಾವೊ.<verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />ತಿನಾ ನಿಂಗತ ದಾಣ್ಗಾಬಿ, ತುಮಾರಾ ಬಾಕ್ಡಿಯೊನೆ ಮಯಾ ಕರೊ, ತ್ಯುನಾ ಕ್ಹಾತೆ ತುಮಾರೊ ವ್ಯವಾರ ಚ಼ೊಕೊ ರ‍್ಹವಾದೆ.<verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />ಬಚ್ಚಾ಼ವೊ, ಹರಯಕ್ಕ ವಿಷಯಮಾ ತುಮಾರಾ ಮಾ ಬಾಪನೆ ತ್ಯುನೆ ಕದಲ ನಿಂಗತ ಐಕೊ,ಕಾಕದ್ಯಾಮ ಆ ಕ್ಹುದಾನಾ ನಜರಮಾ ಚೊ಼ಕು ವ್ಹೈ.<verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />ಬಾನಿ ಜಾಗಪರ ರ‍್ಹಯಲ ತುಮೆ ತುಮಾರಾ ಬಚ್ಚಾವೊನಾ ತಡೈನ ಮನಸ ದುಃಕ ಕರೊ ನಕೊ.<verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />ಯಕ್ಲಾನಾ ಹೆಟಾ ಕಾಮ ಕರಾಲಾವೊ, ಆ ಲೊಕಮಾ ರ‍್ಹಯಲ ತುಮಾರಾ ಮಾಲಕೊನಿ ಹರಯಕ್ಕ ವಾತ ಐಕಿನ ಜವೊ, ಮನಕ್ಹೊ ತುಮೊನೆ ಚೊ಼ಕಾ ಛೆ ಕೈನ ಕೈಲಿವಾನಾ ಹುತಿ ಖಾಲಿ ತುಮಾರಾ ಮಾಲೊಕೊ ನಾ ಖಾಮಾ ಕಾಮ ಕರ‍್ಯಾ ವಾಚಿ, ಕೆಳಾಮಾಬಿ ದೆಕಾಲಾ ಕರ್ತಾನೆ ಬುಚ್ಕಿನ ನಿಯತ್ತಖು ಕಾಮ ಕರೊ. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />ತುಮೆ ಕಯುಬಿ ಕಾಮ ಕರಿತೊಬಿ ತೆ ಮನಕ್ಹನಾ ಹುತಿ ಕರ‍್ಯಾವಾಚಿ ಕರ್ತಾನಾ ಹುತಿ ಮನಸಖು ಕರೊ. <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />ಕರ್ತಾನಾ ಕ್ಹಾತೆ ಮಳಾನಿ ಫಲ ಮಲಸ ಕೈನ ತಿಲಿದಿಲಿನ ಅಪ್ನೊ ಕರ್ತಾ ಥಯಲ ಕ್ರಿಸ್ತ ಯೆಸುನಾ ವಾಟಮಾ ಚಾ಼ಲೊ. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />ಬೆ ನಂಬರ್ ಧಂದೊ ಕರಾಲೊ ತೆ ಕರಾನಾ ಕಾಮನೆ ತಿನೆ ದಂಡ ಮಲಸ ಅಮಾ ಸುಜ಼ ತೆ ಮ್ಹೊಟೊ ಆ ನ್ಹಾನೊ ಕವಾನು ಸುಜ಼ ನತ್ತಿ.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="s">ಪ್ರಾಥನಾ ಕರ‍್ಯಾಮ ಉತ್ತೆಜನ</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />ಕ್ಹಾರಾ ಮಾಲಕೊ, ಸ್ವರ್ಗಲೊಕಮಾ ತುಮಾರಾ ಉಪ್ಪರ ಯಕ್ ಮಾಲಕ ಶೆ ಕೈನ ತಿಳ್ದಿಲಿನ ತುಮಾರಾ ಆಳೊನಾ ಕ್ಹಾತೆ ತ್ಯುನೊನೆ ಮೊಸ ಕರ‍್ಯಾವಾಚಿ ಕ್ಹರಿಕ್ಹು ರ‍್ಹವೊ.<verse eid="COL 4:1" /></para>
  <para style="s">ಸೂಚನೆ</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />ಪ್ರಾರ್ಥನಾ ತಪ್ಯಾ ಬಗರ ಕರೊ, ಹುಶಾರ ರ‍್ಹೈನ ಕ್ಹುದಾನೆ ತೆ ಕರಲ ಉಪಕಾರ ನೆನಸ್ತಾ ರ‍್ಹವೊ. <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />ಕ್ರಿಸ್ತನಿ ಅಸಲಿ ಅರ್ಥ ಕದ್ಯಾಮ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಹಮೆ ಸುವಾರ್ತಾ ಕವಾನೆ ಕ್ಹುದಾ ಬಾಕಲ ಕಾಡು ಕೈನ ಪ್ರಾರ್ಥನಾ ಕರೊ. ಆ ಸುವಾರ್ತಾನಾ ಹುತಿಜ ಮಿ ಜೆಲಮಾ ಶೆ. <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />ಮಿ ಸುವಾರ್ತನು ಅಸಲಿ ಮತ್ಲಬ ಕಿನೆ ಬುಚ್ಕ್ಯಾ ವಾಚಿ ಕೌ ಕೈನ ಪ್ರಾರ್ಥನಾ ಕರೊ.<verse eid="COL 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5" />ಟೈಮನೆ ಚೊ಼ಕಿತರಾ ಇಸ್ತೆಮಾಲ ಕರಲಿನ ಭಾರಲ್ಯಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಗ್ಯಾನಖು ಚಾ಼ಲಿಲಿನ ಜಾವೊ. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />ತುಮೆ ಬೊಲಾನೊ ತರಿಕೊ ಕೆಳಾಮಾಬಿ ಕೃಪೆನಾ ಕ್ಹಾತೆ,ವರಿ ಮಿಟ್ಟಾನಾ ನಿಂಗತ ಸ್ವಾದ ರ‍್ಹೈನಕಾ, ಅಮ್ಮಜ಼ ತುಮೆ ಕಿನೆ ಕಿಮ್ಮ ಬೊಲು ಕೈನ ತಿಳ್ದಿಲಿವೊ.<verse eid="COL 4:6" /></para>
  <para style="s">ಲಾಸ್ಟನಿಯೊ ವಾತೊ</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />ಮಯಾನೊ ಭೈ ವರಿ ಬರೊಕ್ಹಾನೊ ಲಾಯಕ ರ‍್ಹಯಲ ಸೆವಕ ವರಿ ಕರ್ತಾಮಾ ಆಳ ಥಯಲ ತುಖಿಕ ಮಾರಾ ವಿಷಯಮಾ ತುಮೊನೆ ಪುರಾ ಕವಸ. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />ತುಮೆ ಹಮಾರಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನಾ ಹುತಿ,ತೆ ತುಮಾರಾ ಮನಸ್ಮಾ ಹುಟ್ಸಾವಸ, <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />ತಿನೆ ಬರೊಕ್ಹಾನೆ ಲಾಯಕ ರ‍್ಹಯಲ ವರಿ ಮಯಾನೊ ಭೈ ಥಯಲ ತುಮಾರಾ ಉರಿನನ ಥಯಲ ಓಸಿಮನ ಕ್ಹಾತೆ ವಲಾಯೊಸ. ತ್ಯುನೆ ಹೈ ಥಾವಾನು ಹರ ಯಕ್ಕ ತುಮೊನೆ ಕವಸ.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />ಮಾರಾ ಕ್ಹಾತೆ ಜೆಲಮಾ ರ‍್ಹಯಲ ಅರಿಸ್ತಾರ್ಕನ ವರಿ ಬಾರ್ನಬನ ಭೈಘೊವಾಲೊ ಮಾರ್ಕ ತುಮೊನೆ ನಮಸ್ಕಾರ ಕವಸ. ತೆ ತುಮೊನೆಕನ ಆಯಾರೆ ತಿನೆ ಮಳೈ ಲಿವೊ. ತಿವ್ನಾ ಹುತಿ ತುಮೆ ಆಗ್ಯಾ ಹೊಂದಿಲಿದ್ಯಾಸತೊ. <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />ಯುಸ್ತನ ಕವಾಲೊ ಯೆಸು ತುಮೊನೆ ನಮಸ್ಕಾರ ಕರಸ. ಖತ್ನಾ ಕರಿಲಿದಲವಾಲಾ ಇವ್ನೆಜ ಕ್ಹುದಾನಿ ರಾಜ್ಯ ಭಾಂದಾನೆ ಸಾತ ದಿದಲವಾಲಾ ವ್ಹೈ, ಅವ್ನೊಖು ಮನೆ ಘನ್ನು ಚೊ಼ಕು ಥಯುಸ.<verse eid="COL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12" />ಕ್ರಿಸ್ತ ಯೆಸುನೊ ಆಳ ಥಯಲ ಊರಿನನೊ ಎಪಫ್ರನ ತುಮೊನೆ ನಮಸ್ಕಾರ ಕವಸ, ತುಮೆ ಪ್ರವಿಣ ವರಿ ಕ್ಹುದಾನಿ ಹರಯಕ್ಕ ಚಿತ್ತನೆ ಒಪ್ಪಿಲಿನ ಜೌ ಕೈನ ತುಮಾರಾ ಹುತಿ ಪ್ರಾರ್ಥನಾಮಾ ಲಡೆಸ. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />ಆ ತುಮಾರಾ ಹುತಿಬಿ,ಲವೊದಿಕಮಾ ರ‍್ಹಯಲ ವಾಲಾವೊನ ಹುತಿಬಿ ವರಿ ಹಿರಿಯಾಪೊಲಿಯಮಾ ರ‍್ಹಯಲ ವಾಲಾವೊನಾ ಹುತಿಬಿ ಘನ್ನೊ ಕೊಶಿಶ ಕರಾಡ್ಯೊಸ ಕೈನ ಮಿ ತುಮೊನೆ ಸಾಕ್ಷಿ ಕೌಸ. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />ಮಯಾನೊ ಡಾಕ್ಟರ ಥಯಲ ಲುಕ ವರಿ ಧೆಮನ ತುಮೊನೆ ನಮಸ್ಕಾರ ಕವಸ.<verse eid="COL 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 4:15" />ಲವೊದಿಕಮಾ ರ‍್ಹಯಲ ಭಾಯೊನಾಬಿ ವರಿ ನುಂಪಳಬಿ ವರಿ ತಿನಾ ಘರಮಾ ಮಳಾನಿ ಸಬೆವಾಲಾವೊನೆಬಿ ನಮಸ್ಕಾರ ಕದ್ಯೊಸ ಕೈನ ಕವೊ. <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />ತುಮೆ ಆ ಕಾಗಜ ರ‍್ಹಯಲ ಒದಲಪರ ಲವೊದಿಕನಾ ಸಬೆಮಾಬಿ ಆ ಒದಾ ಲಗಾಡೊ ವರಿ ಮಿ ಲಿಕ್ಕಲ ಆ ಕಾಗಜ ತುಮೆ ಲವೊದಿಕತಾ ಮಂಗೈಲಿನ ಒದಿಲಿವೊ. <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />ಅರ್ಖಿಪ್ಪನೆಬಿ ಕರ್ತಾಖು ಹೊಂದಿಲಿದಲ ಸೆವೆನಾ ವಿಷಯಮಾ ಹುಶಾರಕ್ಹು ರ‍್ಹೈನ ಪುರಾಕರ ಕೈನ ಕವೊ.<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />ಆ ಕ್ಹಾರೊ ಪೌಲ ಥಯಲ ಮಿಜ಼ ಮಾರಾ ಹತೆ ಲಿಕ್ಯೊಸ. ಮಿ ಜೆಲಮಾ ಶೆ ಕವಾನು ತುಮೊನೆ ಶೆ ರ‍್ಹವಾದೆ.</para>
  <para style="p" vid="COL 4:18">ಕೃಪೆ ತುಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>