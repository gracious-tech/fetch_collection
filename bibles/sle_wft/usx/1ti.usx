<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Shikkalgar</book>
  <para style="toc3">1 ತಿಮೊತಿನೆ</para>
  <para style="toc2">1 ತಿಮೊತಿ</para>
  <para style="toc1">ತಿಮೊತಿನೆ ಬರ್ದಲ ಪೈಲಾ ಪತ್ರ</para>
  <para style="mt2">ತಿಮೊಥೆಯನಿಗೆ ಬರೆದ ಮೊದಲನೆಯ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ತಿಮೊತಿನೆ ಬರ್ದಲ ಪೈಲಾ ಪತ್ರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಯಕ್ವಾ ತಿಮೊತಿನು ಪತ್ರ ಅಪೊಸ್ತಲ ಥಯಲ ಪೌಲಾ ತಿನೊ ಶಿಷ್ಯೊ ಥಯಲ ತಿಮೊತಿನೆ ಬರ್ದಲ ವ್ಹೈ. ಯೆಸು ಕ್ರಿಸ್ತ ಹುಟ್ಟಲ ಪರ 62-64 ವರಕ್ಹ ಥಯಲಪರ ಎ ಪತ್ರ ಬರ್ದ್ಯಾಸ. ಎ ಪೌಲಾನು ಲಾಸ್ಟನಾ ಟೈಮಮಾ ಬರ್ದಲ ವ್ಹೈ. ಪೌಲಾ ವರಿ ತಿಮೊತಿನಾ ವಚ್ಮಾ ಚೊ಼ಕು ಸಂಬಂಧ ವ್ಹತ್ತು. ಪೌಲಾ ತಿಮೊತಿನೆ ಕೆಳಾಮಾಬಿ ದಿಕ್ರೊ ಕೈನ ಕತೊತೊ.</para>
  <para style="ip">
    <char style="xt">
      <ref loc="PHP 2:22">ಫಿಲಿಪ್ಪಿ 2:22</ref>;</char> <char style="xt"><ref loc="1TI 1:2">1:2</ref></char> <char style="xt"><ref loc="1TI 1:18">1:18</ref></char> ಎ ಚಾರಮಾ ಯಕ್ಕ ಪತ್ರ ವ್ಹೈ ಪೌಲಾ ಸಭೆನೆ ನೈ ಬರದ್ಯಾವಾಚಿ ಮನಕ್ಹನೆ ಬರ್ದ್ಯೊಸ. ಬಿಜಾ಼ ತನ್ನ ಪತ್ರ ಕಯಾ ವ್ಹೈ ಕದ್ಯಾಮ 2 ತಿಮೊತಿ, ತಿತ, ವರಿ ಫಿಲೊಮಿನಾ ವಿಚಾರೊ ಛೆ. ಸಭೆನಾ ಆರಾದನೆನಾ ಹುತಿ 1 ತಿಮೊಥಿಮಾ ಘನ್ನಾ ಸಲಹೆ ಛೆ <char style="xt"><ref loc="1TI 2:1-15">2:1-15</ref></char> ಸಭೆನಾ ನಾಯಕೊನಾ ಜ಼ರುರತ <char style="xt"><ref loc="1TI 3:1-13">3:1-13</ref></char> ವರಿ ಸುಳ್ಳ ಬೊಧಕೊನಾ ವಿರುದ್ದ ಹುಶಾರಕಿ ವ್ಹೈ <char style="xt"><ref loc="1TI 1:3-11">1:3-11</ref></char> <char style="xt"><ref loc="1TI 4:1-5">4:1-5</ref></char> <char style="xt"><ref loc="1TI 6:2-5">6:2-5</ref></char> ಎ ಕ್ಹಾರು ಪೌಲಾ ಕೈ ತರಾಮಾ ಸಭೆನಾ ವಚ್ಮಾ ತಿಮೊತಿನೆ ಯಕ್ಕ ನಾಯಕ ಥೈನ ಶಿಕ್ಕಲಾವಾಡೊತೊ ಕವಾನು ದೆಕಾಡಸ. 1 ತಿಮೊತಿ ಪತ್ರಮಾ ಕೆಕ್ಲಾಕಿ ನಿಯಮೊ ಎ ಟೈಮನಾ ಆಜು಼ ಬಾಜು಼ನಾ ಸಭೆನಾ ನಾಯಕೊನೆ ಕೈ ತರಾಮಾ ಸೆವೆ ಕರು ಕವಾನೆ ಮದತ ಥಯುಸ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1. ಪೌಲಾ ತಿಮೊತಿನೆ ನಮಸ್ಕಾರ ಕರಾನಾ ಮುಕಾಂತರ ಶುರುವಾತ ಕರಾಡ್ಯೊಸ. <char style="ior"><ref loc="1TI 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. ಪಾಚ಼ಲ್ತೊ ಸುಳ್ಳ ಬೊಧಕೊನಾ ವಿರುದ್ದ ಹುಶಾರಕಿ ದಿವಸ. <char style="ior"><ref loc="1TI 1:3-11">1:3-11</ref></char></para>
  <para style="io1">3. ಯೆಸು ಕ್ರಿಸ್ತನೆ ಕೆಕ್ಲೊ ಆಭಾರಿ ತಯೊಸ ಕೈನ ಪತ್ರನೆ ಅಗೊ ಬಡಾವಸ. <char style="ior"><ref loc="1TI 1:12-19">1:12-19</ref></char></para>
  <para style="io1">4. ಪಾಚ಼ಲ್ತೊ ಆರಾದನಾ ವರಿ ಸಭೆನಾ ನಾಯಕೊನಾ ಹುತಿ ತಿಮೊಥಿನೆ ಸಲಹೆ ದಿವಸ. <char style="ior"><ref loc="1TI 2-3">2—3</ref></char></para>
  <para style="io1">5. ತಿಮೊಥಿನೆ ಪೌಲಾ ಲಾಸ್ಟನಾ ಸಲಹೆ ದೆತೊ ಎ ಪತ್ರನೆ ಪುರಾ ಕರಸ.<char style="ior"><ref loc="1TI 4-6">4—6</ref></char></para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />ಹಮಾರೊ ರಕ್ಷಕ ಥಯಲ ಕ್ಹುದಾ ವರಿ ಯೆಸುಕ್ರಿಸ್ತ ತೆ ಹಮಾರಾ ಕೈದಾನಿ ಆದೆಶಕ್ಹು ಪೌಲಾ ಥಯಲ ಯೆಸುಕ್ರಿಸ್ತನೊ ಅಪೊಸ್ತಲ ಥಯೊ.<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />ತು ಬರೊಕ್ಹೊ ರ‍್ಹಯಲವಾಲೊ ಥಯಲಕ್ಹು ಮನೆ ಕ್ಹರಿನೊ ದಿಕ್ರಾ ನಿಂಗತ ಛೆ.</para>
  <para style="p" vid="1TI 1:2">ಬಾ ಥಯಲ ಕ್ಹುದಾಕ್ಹು ವರಿ ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಕ್ರಿಸ್ತ ಯೆಸುಕ್ಹು ಕೃಪಾ ಮರಗಾ ಶಾಂತಿ ತುನೆ ಮಳಾದೆ.<verse eid="1TI 1:2" /></para>
  <para style="s">ಸುಳ್ಳ ಭೊದಕೊನಾಹುತಿ ಹುಶಾರಕಿ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />ಮಿ ಮಕೆದೊನಿಯೆ ಜಾ಼ತಾಮಾ, ತು ಎಫೆಸಮಾ ರ‍್ಹೆ ಕೈನ ತುಕನ ಮಿ ಮಾಂಗಿಲಿದ್ಯೊತೊ. ಕಾ ಕದ್ಯಾಮ ದಕ್ಹಾ ಜ಼ನಾ ತ್ಯಾ ಸುಳ್ಳ ಸಂಗತಿಯೊ ಉಪದೆಶ ಕರಾಡಾಸ. ತು ತ್ಯುನೊನೆ ಆಗನ್ಯಾ ದಿನ್ನ ಹುಬ್ರಾಡ. <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />ವಿಚಾರ ಕರಲ ಕಾನಿಯೊನೆಬಿ ವರಿ ತುಮಾರಾ ಪಿತೃವೊನು ಖಾಂದಾನನೆ ಧ್ಯಾನ ದ್ಯುನೈ ಕೈನ ತ್ಯುನೊನೆ ಆಗನ್ಯಾ ದೆ. ತೆ ಸಂಗತಿಯೊ ವಾದ-ವಿವಾದ ಲಾವಸ. ತ್ಯವಾಕ್ಹು ಕ್ಹುದಾನಾ ಕಾಮನೆ ಸುಜ಼ ಉಪಯೊಗ ನತ್ತಿ. ಕ್ಹುದಾನು ಕಾಮ ಬರೊಕ್ಹಾಕ್ಹು ಕರು.<verse eid="1TI 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1TI 1:5" />ಮಯಾಜ಼ ತೆ ಆಗ್ನ್ಯಾನಿ ಗುರಿ ವ್ಹೈ. ತೆ ಮಯಾ ಮಳು ಕದ್ಯಾಮ ಮನಕ್ಹೊ ಚೊ಼ಕಾ ಮನಸೆ ರ‍್ಹಯಲವಾಲಾ ರ‍್ಹೌ; ಯೊಗ್ಯ ಥಯಲ ಕಾಮಜ಼ ಕರಾಲಾ ರ‍್ಹೌ; ವರಿ ಕಪಟ ನೈಸೊ ಬರೊಕ್ಹೊ ರ‍್ಹಯಲವಾಲಾ ರ‍್ಹೌ. <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />ದಕ್ಹಾ ಜ಼ನಾ ಎ ಗುರಿ ಚು಼ಕಿನ ನೈಸೊ ಕರಾನಾ ವಿಷಯಮಾ ಬೊಲ್ತಾ ರ‍್ಹವಸ. <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />ತ್ಯುನೆ ಧರಮ ಉಪದೆಶ ಕರಾಲಾ ಥೌಕೈನ ತ್ಯುನು ಆಸವೈ. ತೆನೈಸೊ ತ್ಯುನೆ ಸು ಬೊಲ್ಲಿವಾಡಾಸ ಕವಾನು ತ್ಯುನೊನೆ ತಿಳದ್ಯುನತ್ತಿ. ತ್ಯುನೊನೆ ಕ್ಹರಿಮಾಜ಼ ತಿಳದ್ಯುಸ ಕೈನ ತ್ಯುನೆ ಕವಾನಾ ಸಂಗತಿಯೊನೆ ತ್ಯುನೆ ತಿಳ್ದಿಲೆತಾ ನೈ.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />ಧರಮಶಾಸ್ತ್ರ ಚೊ಼ಕು ವ್ಹೈ. ತೆನೈಸೊ ತಿನೆ ಕ್ಹರಿಕ್ಹು ಪುರಾ ಕರು. <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />ಧರ್ಮಶಾಸ್ತ್ರನೆ ತಯ್ಯಾರ ಕರಲ ಚೊ಼ಕಾವೊನಾ ಹುತಿ ನವೈ ಕೈನ ಅಪೊನೆ ತಿಳದ್ಯುಸ. ತಿನೆ ತಯ್ಯಾರ ಕರಲ ತಿನಾ ವಿರುದ್ದ ಚಾ಼ಲಾಲಾ ವರಿ ತಿನೆ ನೈ ಚಾ಼ಲಿಲಿನ ಜಾ಼ವಾಲಾ ಮನಕ್ಹೊನೆ ವ್ಹೈ. ಕ್ಹುದಾನೆ ವಿರುದ್ದ ಥಯಲ ಮನಕ್ಹೊನೆ ವರಿ ಪಾಪಿಯೊನೆ, ಧರಮ ನೈಕರಾಲಾವೊನೆ ವರಿ ಪರಿಶುದ್ಧ ನೈರ‍್ಹಯಲವಾಲಾವೊನೆ, ಮಾ-ಬಾಪನೆ ಖಲಾಸ ಕರಾಲಾವೊನೆ ವರಿ ಮನಕ್ಹೊನೆ ಖಲಾಸ ಕರಾಲಾವೊನೆ, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />ಲೈಂಗಿಕ ಪಾಪ ಕರಾಲಾವೊನೆ, ಸುಳ್ಳ ಕವಾಲಾವೊನೆ, ದಿದಲ ವಾತೊ ಚುಕಾಲಾ ಮನಕ್ಹೊನೆ, ಕ್ಹುದಾನಿ ಕ್ಹರಿನಿ ಉಪದೆಶನಾ ವಿರುದ್ದ ಥೈನ ಸುಚಾ಼ಯೆ ತೆ ಕರಾಲಾವೊನೆ ತಿನೆ ತಯ್ಯಾರ ಕರ‍್ಯಾಸ. <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />ತೆ ಉಪದೆಶ ಮನಕ್ಹೊನೆ ತಿಳಸಾನಾ ಹುತಿ ಕ್ಹುದಾ ತುನೆ ದಿದಲ ಸುರ್ವಾತೆನು ಯಕ್ಕ ಭಾಗ ಥಯುಸ. ನಸಿಬವಾಲೊ ಥಯಲ ಕ್ಹುದಾ ಕಂತು ಎ ಮಹಿಮಾನಿ ಸುವಾರ್ತೆ ಐಸ.<verse eid="1TI 1:11" /></para>
  <para style="s">ಕ್ಹುದಾನೆ ಸ್ತುತಿ</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತ ಮಪರ ರ‍್ಹಯಲ ಬರೊಕ್ಹಾನಾ ಹುತಿ, ತಿನೆ ಸೆವಾ ಕರಾನೆ ಎ ಕಾಮ ಮನೆ ಮರಗಿನ ದಿದಲ ಹುತಿ ಮಿ ತಿನೆ ಸ್ತುತಿ ಕರುಸ. ತೆ ಮನೆ ತಾಕತ ದಿವಸ. <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />ಪೈಲಾ, ಮಿ ಕ್ರಿಸ್ತನಾ ವಿರೊದ ಬೊಲ್ಯೊತೊ. ತಿನೆ ಮಿ ತ್ರಾಸ ಕರ‍್ಯೊತೊ. ತಿನೆ ದುಖ ಥಾವಾವರಕ್ಹು ಕಾಮೊ ಕರ‍್ಯೊತೊ. ವರಿಬಿ ಮಿ ಸು ಕರಾಡ್ಯೊಸ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನೈರ‍್ಹಯಲ ಹುತಿ ಕ್ಹುದಾ ಮನೆ ಮರಗ್ಯೊ. ಬರೊಕ್ಹೊ ನೈ ರ‍್ಹತಾಮಾ ಮಿ ತೆ ಕ್ಹಾರು ಕರ‍್ಯೊತೊ. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />ತೆನೈಸೊ ಅಪ್ನೊ ಪ್ರಭುನಿ ಪುರಾ ಮರಗಾ ಮನೆ ಮಳಿ. ಯೆಸು ಕ್ರಿಸ್ತಪರ ರ‍್ಹಯಲ ಬರೊಕ್ಹೊ ವರಿ ಮಯಾ ತೆ ಕೃಪಾನಾ ಕ್ಹಾತೆ ಐ.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />ಮಿ ಕವಾನಿಯೊ ಎ ಸಂಗತಿಯೊ ಕ್ಹರಿನಿಯೊಜ಼ ವ್ಹೈ. ತಿನಾಹುತಿ ತುಮೆ ತಿನೆ ಪುರಾ ವಪ್ಪಿಲಿವೊ. ತೆ ಸುವ್ಹೈ ಕದ್ಯಾಮ; ಪಾಪಿಯೊನೆ ವಚಾ಼ಡಾನಾ ಹುತಿ ಯೆಸು ಕ್ರಿಸ್ತ ಎ ಲೊಕಮಾ ದಿಕ್ಹ್ಯೊ. ತೆ ಪಾಪಿಯೊಮಾ ಮಿಜ಼ ಮ್ಹೊಟೊ ವ್ಹೈ. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />ತೆನೈಸೊ ಮನೆ ಮರಗಾ ಮಳಿ. ಯೆಸು ಕ್ರಿಸ್ತ ತಿನೆ ಘನ್ನು ತಡ್ದಿಲಿವಾನು ಮಾರಾಮಾ ದೆಕಾಡಾನಾ ಹುತಿ ಮನೆ ಮರಗಾ ದಿದ್ಯೊ. ಪಾಪಿಯೊಮಾ ಕ್ಹಾರಾತಿ ಮ್ಹೊಟೊ ಥಯಲ ಮನೆ ಕ್ರಿಸ್ತ ತಿನಿ ತಾಳ್ಮೆ ದೆಕಾಡ್ಯೊ. ಹಮೆಶಾನೊ ಜ಼ಲಮನಾ ಹುತಿ ಕ್ರಿಸ್ತಮಾ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಾಲಾ ಮನಕ್ಹೊನೆ ಮಿ ವಳಕ ಥೌ ಕೈನ ತೆ ಮನೆ ಮರಗ್ಯೊ. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />ಹಮೆಶಾ ರಾಜ಼ ಕರಾಲಾ ರಾಜಾ಼ನೆ ಮಹಿಮಾ ವರಿ ಮರ್ಯಾದಿ ರ‍್ಹವಾದೆ. ತಿನಾ ಹತೆ ನೈ ಥಾವಾನು ಕಯುಜ಼ ನತ್ತಿ. ತೆ ದಿಕ್ಹೆ ನೈಸೊ ರ‍್ಹವಸ. ಯಕ್ಲೊಜ಼ ಕ್ಹುದಾ ಥಯಲ ತಿನೆ ಮರ್ಯಾದಿ ವರಿ ಮಹಿಮಾ ಹಮೆಶಾಬಿ ಥಾವಾದೆ. ಆಮೆನ್.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />ತಿಮೊತಿ, ತು ಮಾರೊ ದಿಕ್ರಾ ಮಿ ತುನೆ ಸು ಆಜ್ಞಾ‍ ದ್ಯು ಕದ್ಯಾಮ, ಪೈಲಾ ತಾರಿ ವಿಚಾರಮಾ ತಿಳಸಾಯಲ ಪ್ರವಾದನೆ ನಿಂಗತ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಿನ ಹೊರಾಟ ಕರ. <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />ತಾರಾಮಾ ಬರೊಕ್ಹೊ ಘಟ್ಟ ಥೈನ ರ‍್ಹವಾದೆ, ತುನೆ ಚೊ಼ಕು ಲಾಗಲಜ಼ ಕರ. ದಕ್ಹಾಜ಼಼ನಾ ಇಮ್ಮ ಕರ‍್ಯಾನೈ. ತ್ಯುನೊ ಬರೊಕ್ಹೊ ಕ್ಹಾರೊ ಹಾಳ ಥೈ ಗಯೊ. <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />ಹುಮೆನಾಯ ವರಿ ಅಲೆಕ್ಸಾಂಡ್ರಿಯಾ ತಿಮ ಕರ‍್ಯಾ. ಕ್ಹುದಾನಾ ವಿರೊದ ಬೊಲುನೈ ಕೈನ ತ್ಯುನೆ ತಿಳ್ದಿಲಿವಾನಾ ಹುತಿ ತ್ಯುನೊನೆ ಸೈತಾನಕನ ದಿದ್ಯೊ.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">ಸಭೆನಿ ಪ್ರಾಥನಾ ವರಿ ಆರಾಧನಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />ಕ್ಹಾರಾತಿ ಪೈಲಾ ಮಿ ತುಮೊನೆ ಸು ಕೌಸ ಕದ್ಯಾಮ, ಕ್ಹಾರಾ ಮನಕ್ಹೊನಾ ಹುತಿ ಕ್ಹುದಾನೆ ಧನ್ಯವಾದ ಕರೊ, ತಿನೆ ಸ್ತುತಿ ಕರೊ. <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />ಅಪೊಮಾ ಶಾಂತಿ ಸಮಾಧಾನ ರ‍್ಹವಾದೆ ಕೈನ ಕ್ಹುದಾನೆ ಪುರಾ ಭಕ್ತಿಕ್ಹು ಮರ್ಯಾದಿಕ್ಹು ಆರಾಧನಾ ಕರಾನಾಹುತಿ ಸಾಧ್ಯ ಥಯುಮ ರಾಜಾ಼ವೊನಾಹುತಿ ಅದಿಕಾರಿಯೊನಾಹುತಿ ಕ್ಹುದಾನೆ ಧನ್ಯವಾದ ಕವೊ. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />ಎ ಚೊ಼ಕು ವ್ಹೈ ವರಿ ಅಪ್ನೊ ರಕ್ಷಕ ಥಯಲ ಕ್ಹುದಾನೆ ಎ ಪಸಂದ ವ್ಹೈ.<verse eid="1TI 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TI 2:4" />ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ರಕ್ಷಣೆ ಮಳಾದೆ ಕೈನ, ಕ್ಹರಿ ವಳಕಾದೆ ಕೈನ ತಿನಿ ಆಸ ವ್ಹೈ. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />ಕ್ಹುದಾ ಯಕ್ಲೊಜ಼ ವ್ಹೈ, ಕ್ಹುದಾನಾ ವರಿ ಮನಕ್ಹೊನಾ ವಚ್ಮಾ಼ನೊ ಯಕ್ಲೊಜ಼ ವ್ಹೈ. ಮನಕ್ಹ ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತಜ಼ ವ್ಹೈ. <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />ಯೆಸು ಕ್ಹಾರಾ ಮನಕ್ಹೊನಾ ಜಾ಼ತನಾ ಪಾಪೊನಾ ಹುತಿ ತಿನೆ ತೆ ಒಪ್ಸಿನ ದಿದ್ಯೊ. ಕ್ಹುದಾ ಕ್ಹಾರಾವೊನೆ ರಕ್ಷಣೆ ಮಳಾದೆ ಕೈನ ಕ್ಹುದಾನಿ ಆಸನೆ ತೆ ಕರೆಟ್ಟ ಟೈಮ್ಮಾ ದೆಕಾಡಿನ ದಿದ್ಯೊ. <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />ತಿನಾ ಹುತಿ ಸುವಾರ್ತೆ ಕವಾನಾ ಹುತಿ ಅಪೊಸ್ತಲೊ ಥಾವಾಹುತಿ ಯಹುದ್ಯೊ ನೈರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಸುವಾರ್ತೆ ಕವಾನಾಹುತಿ ಮನೆ ಇನಿಲಿದ್ಯೊ. ಎ ಕ್ಹರಿ ವ್ಹೈ ಎ ವಾತ ಸುಳ್ಳ ನ್ಹವೈ. ಕ್ಹರಿ ವಳಕಾದೆ ಕೈನ ಬರೊಕ್ಹೊ ಕರು ಕೈನ ಮಿ ತ್ಯುನೊನೆ ಸುವಾರ್ತೆ ಕದ್ಯೊ.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />ಕ್ಹಾರಿ ಜ಼ಗಾವೊಪರ ದಾಣ್ಗಾ ಪ್ರಾಥನಾ ಕರು ಕೈನ ಮಾರಿ ಆಸ ವ್ಹೈ. ತ್ಯುನಾ ಪವಿತ್ರ ಹತೊ ಉಪ್ಪರ ಉಚೈನ ಪ್ರಾಥನಾ ಕರಾಲಾ ತ್ಯುನೆ ಪರಿಶುದ್ಧ ಥಾವಾದೆ. ತ್ಯುನೆ ವಾದ ಕರಾಲಾ ವರಿ ಸಿಟ್ಟಕರಾಲಾ ಥೌ ನೈ.<verse eid="1TI 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 2:9" />ಇನಾ ನಿಂಗತಜ಼ ಹೆಣ ಮನಕ್ಹೊ ತ್ಯುನೊನೆ ಚಾ಼ಯೆಥಯಲ ವಣ್ಣಾಜ಼ ತ್ಯುನೆ ಘಾಲ್ಯು ಕೈನ ಮಾರಿ ಆಸ ವ್ಹೈ. ತ್ಯುನಾ ವಣ್ಣಾ ತ್ಯುನೆ ಮರ್ಯಾದಿ ವಾಲಿಯೊ ವ್ಹೈ ಕೈನ ದಿಕ್ಹಾ ವರಕ್ಹಾ ರ‍್ಹೌ. ತ್ಯುನೆ ಚೊ಼ಕಿಯೊ ದಿಕ್ಹಾನೆ ತ್ಯುನಾ ಬಾಲೊ ಭಾಂದಿಲ್ಯು ನೈ; ಕ್ಹೊನು ವರಿ ಮೊಗಾನಾ ವಣ್ಣಾ ಘಾಲ್ಯು ನೈ. <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />ತೆನೈಸೊ ತ್ಯುನೆ ತೆ ಬಾಕಡಿಯೊ ತ್ಯುನೊನೆ ಚೊ಼ಕಾ ಕಾಮೊ ಕರಾನಾ ಹುತಿ ತ್ಯುನಿ ಸುಂದರತಾ ದೆಕಾಡಿಲ್ಯು. ಕ್ಹುದಾನೆ ಆರಾಧನಾ ಕರೆಸ ಕೈನ ಕವಾಲ್ಯೊ ಹೆಣ್ಣ ಮನಕ್ಹೊ ತ್ಯುನೊನೆ ತಯ್ಯಾರ ಕರಲ್ಯು.<verse eid="1TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11" />ಹೆಣ್ಣ ಮನಕ್ಹೊ ಉಪದೆಶ ಐಕು ವರಿ ವಿಧೆಯ ಥಾವಾಹುತಿ ತಯ್ಯಾರ ಥೌ. ಕ್ಹಾರಿ ತರಾಕ್ಹು ತಿನಾಕ್ಹು ತೆ ಒಪ್ಸಿನ ದ್ಯು. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />ತ್ಯುನೆ ದಾಣಗಾವೊನೆ ಉಪದೆಶ ಕರಾನು ರ‍್ಹವಾದೆ ತ್ಯುನಾ ಉಪ್ಪರ ಅದಿಕಾರ ಚ಼ಲಾವಾಹುತಿ ಮಿ ಮೌಕೊ ನೈ ದೆತೊ. ತ್ಯುನೆ ಗಪ್ಪ ರ‍್ಹೌ. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />ಕಾಕದ್ಯಾಮ ಪೈಲಾ ಸೃಷ್ಟಿ ಥಯಲ ಆದಾಮ ವ್ಹೈ. ಪಾಚಾ಼ತಿ ಸೃಷ್ಟಿ ಥಯಲ ಹವ್ವಳ ವ್ಹೈ. <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />ತೆನೈಸೊ ಸೈತಾನಕ್ಹು ಮೊಸಮಾ ಪಡಲ ಆದಾಮ ನ್ಹವೈ. ಹೆಣ್ಣ ಮನಕ್ಹ ಮಳ್ಳ ಥೈನ ಮೊಸನೆ ಬಲಿ ಥೈನ ಪಾಪಮಾ ಪಡಿ. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />ತೆನೈಸೊ ಹೆಣ್ಣ ಮನಕ್ಹ ಬರೊಕ್ಹಾಮಾ, ಮಯಾಮಾ, ಪರಿಶುದ್ಧತೆಮಾ ವರಿ ಪವಿತ್ರತಾಮಾ ಘಟ್ಟ ಥೈನ ರ‍್ಹಯಾಮ ಬಚ್ಚಾ಼ ಜನ್ನತಾಮಾ ರಕ್ಷಣೆ ಮಳಸ.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">ಸಭೆನಾ ಮ್ಹೊಟಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />ಮಿ ಕವಾನಿಯೊ ವಾತೊ ಕ್ಹರಿನಿಯೊಜ಼ ವ್ಹೈ. ತೆ ಸು ವ್ಹೈ ಕದ್ಯಾಮ, ಸಬಾಪಾಲಕ ಥೌಸ ಕೈನ ಕೊಶಿಶ ಕರಾಲೊ ಚೊ಼ಕು ಕಾಮಜ಼ ಕರಾಲೊ ವ್ಹೈ. <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />ತೆ ಸಭೆನಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊನಾ ಕೆಟ್ಟ ವಾತೊಮಾ ಪಡೆನೈಸೊ ಚೊ಼ಕೊ ಥೈನ ರ‍್ಹೌ. ತುನೆ ಯಕ್ಲಿಜ಼ ಬೈಕೊ ರ‍್ಹೌ. ತೆ ಘನ್ನೊ ಗ್ಯಾನಿ ರ‍್ಹೌ; ಮನಕ್ಹೊ ಮರ್ಯಾದಿ ದಿವಾನೆ ಯೊಗ್ಯ ರ‍್ಹೌ <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />ತಿನೆ ಪಿವಾನೆ ಆಸ ರ‍್ಹೌನೈ. ವರಿ ತ್ರಾಸ ಕರಾಲೊ ರ‍್ಹೌನೈ. ತೆ ಶಾಂತಿ ಸಮಾಧಾನವಾಲೊ ರ‍್ಹೌ; ದೊಕ್ಡಾವೊಪರ ಆಸ ರ‍್ಹೌನೈ. <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />ತಿನಾ ಸ್ವಂತ ಖಾಂದಾನವಾಲಾವೊನೆ ಚೊ಼ಕೊ ಚ಼ಲೈ ನಿಂಜಾ಼ವಾಲೊ ರ‍್ಹೌ. ತಿನಾ ಬಚ್ಚಾ಼ ತಿನೆ ಮರ್ಯಾದಿ ದ್ಯು. <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />ತಿನಾ ಸ್ವಂತ ಘರವಾಲಾವೊನೆ ಆಳಾನು ನೈ ಗ್ವತ್ತ ರ‍್ಹಯಲವಾಲೊ ಕ್ಹುದಾನಿ ಸಭೆಮಾ ಆಳಾನೆ ಯೊಗ್ಯ ನತ್ತಿ.<verse eid="1TI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 3:6" />ತೆ ನವೊ ವಿಶ್ವಾಸಿ ರ‍್ಹೌ ನೈ. ನವಾ ವಿಶ್ವಾಸಿನೆ ಸಬೆಪರ ಮ್ಹೊಟೊ ಕರ‍್ಯಾಮ, ತಿನೆ ಸ್ವಕ್ಕ ಆವಸ. ಸೈತಾನ ತಿನಾ ಸ್ವಕ್ಕಕ್ಹು ತಿನೆ ಶಿಕ್ಷಾ ಮಳಲ ನಿಂಗತ ಇನೆಬಿ ಶಿಕ್ಷ್ಯಾ ಮಳಸ. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />ಸಬೆಪರ ಮ್ಹೊಟೊ ರ‍್ಹಯಲವಾಲೊ ಸಭೆಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊಕ್ಹು ಮರ್ಯಾದಿ ಲ್ಯು. ತೆಳಾಮಾ ತೆ ಮನಕ್ಹೊನಾ ಕೆಟ್ಟ ವಾತೊಕ್ಹು ವಾಚಿ಼ನ ರ‍್ಹವಸ. ಸೈತಾನ ಘಾಲಲ ಬಲಿಕ್ಹು ವಾಚಿ಼ನ ರ‍್ಹಸ.<verse eid="1TI 3:7" /></para>
  <para style="s">ಸಭೆನಾ ಸಹಾಯಕೊ</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />ಇನಾ ನಿಂಗತಜ಼ ಸಭೆಮಾ ಚೊ಼ಕಾ ಸೆವಕೊ ಥಯಲವಾಲಾ ತ್ಯುನಿ ನಡತೆಕ್ಹು ಬಿಜಾ಼ವೊಕ್ಹು ಚೊ಼ಕು ಕವೈಲಿವಾನೆ ಯೊಗ್ಯ ವ್ಹೈ. ಮ್ಹೊಡು ದೆಕಿನ ಬೊಲ್ಯಾವಾಚಿ ರ‍್ಹೌ. ತ್ಯುನೆ ದಾರು ಪಿನ ಟೈಮ ಕಾಡಾಲಾ ರ‍್ಹೌ ನೈ. ವರಿ ಬಿಜಾ಼ವೊನೆ ಮೊಸ ಕರಿನ ಸೌಕಾರ ಥಾವಾನೆ ಕರುನೈ. ದೊಕ್ಡಾನಿ ಆಸ ರ‍್ಹೌ ನೈ. <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />ಘನಿ ರ‍್ಹಯಲ ಕ್ಹರಿನೊ ಬರೊಕ್ಹೊ ದಿಕ್ಹಿನ ಆವಾನಿ ಗ್ಯಾನಕ್ಹು ಧರಲಿದೆಲವಾಲಾ ರ‍್ಹೌ. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />ತ್ಯುನೊನೆ ತು ಪೈಲಾ ವಳಕ. ತ್ಯುನೆ ಕೆಟ್ಟ ಕಾಮೊಮಾ ನೈ ರ‍್ಹಯಾಮ ಸೆವೆ ಕರಸ ಕವಸ.<verse eid="1TI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11" />ಇನಾನಿಂಗತಜ಼ ಸಭೆಮಾ ಸೆವೆ ಕರಾಲ್ಯೊ ಹೆಣ ಮನಕ್ಹೊನೆ ಮನಕ್ಹೊ ಮರ್ಯಾದಿ ಲಿವಾನೆ ಯೊಗ್ಯ ರ‍್ಹೌ. ತ್ಯುನೆ ಬಿಜಾ಼ ಮನಕ್ಹೊನಾ ಹುತಿ ಕೆಟ್ಟ ಕವಾಲ್ಯೊ ರ‍್ಹೌನೈ. ತ್ಯುನಾಕ್ಹು ತ್ಯುನೆ ಹತೊಟಿಮಾ ರ‍್ಹೌ. ಕ್ಹಾರಾ ವಿಷಯನಾ ಹುತಿ ಸಮಾಧಾನಕ್ಹು ವರಿ ಬರೊಕ್ಹಾವಾಲಾ ರ‍್ಹೌ.<verse eid="1TI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12" />ಸಭೆಮಾ ಸೆವೆಕರಾಲಾ ಯಕ್ಲಿನೆಜ಼ ಹಿವಾ ಕರಲಿದಲ ರ‍್ಹೌ. ತ್ಯುನೆ ತ್ಯುನಾ ಬಚ್ಚಾ಼ವೊನೆ ವರಿ ಘರವಾಲಾವೊನಾ ಮ್ಹೊಡೆ ಚೊ಼ಕು ಕವೈಲಿವಾಲಾ ರ‍್ಹೌ. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />ಚೊ಼ಕಿ ವಾಟಮಾ ಸೆವೆ ಕರಾಲಾ ಮನಕ್ಹೊ ತ್ಯುನೊನೆ ಚಾ಼ಯೆ ಥಯಲ ಮರ್ಯಾದಿನಿ ಜ಼ಗಾ ಲಿವಸ. ಯೆಸು ಕ್ರಿಸ್ತನಿ ತ್ಯುನೊ ಬರೊಕ್ಹಾನಾ ಹುತಿ ತ್ಯುನೆ ಬರೊಕ್ಹಾ ವಾಲಾ ಘಟ್ಟ ಥೈನ ರ‍್ಹವಸ.<verse eid="1TI 3:13" /></para>
  <para style="s">ಮ್ಹೊಟು ರಹಶ್ಯ</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />ಮಿ ತುಕನ ಭೆಗಿನ ಔಸ ಕೈನ ಬರೊಕ್ಹೊ ಮನೆ ಛೆ. ವರಿಬಿ ಆ ಕ್ಹಾರು ಬರ್ದಾಡ್ಯೊಸ. <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />ಪಾಚ಼ಲ್ತೊ ಮಿ ತುಕನ ಭೆಗಿನ ನೈ ಆಯೊತಬಿ ಕ್ಹುದಾನಾ ಘರಮಾ ಕರಾನಾ ಕಾಮೊ ತುನೆ ಗ್ವತ್ತ ಛೆ. ತೆ ಘರ ಜಿವ್ತೊ ರ‍್ಹಯಲ ಕ್ಹುದಾನು ಸಬೆ ವ್ಹೈ. ತೆ ಕ್ಹರಿನಿ ಫಾಯಾ ವರಿ ಆಸ್ರೊ ವ್ಹೈ. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />ಕ್ಹುದಾನಿ ಭಕ್ತಿನೆ ಆದಾರ ಥಯಲ ಕ್ಹರಿ ವರಿ ಸಂಶೊವಾಚಿ ಅಪ್ನಿ ಆರಾಧನಾನಿ ಜಿವಿತ ದಡಿರ‍್ಹಯಲ ಮ್ಹೊಟಿ ವ್ಹೈ</para>
  <para style="q1" vid="1TI 3:16">ಕ್ರಿಸ್ತ ಮನಕ್ಹನಾ ರುಪಮಾ ಅಪೊನೆ ದಿಕ್ಯೊ.</para>
  <para style="q2" vid="1TI 3:16">ತೆಜ಼ ಕ್ರಿಸ್ತ ವ್ಹೈಕೈನ ಪವಿತ್ರ ಆತ್ಮಾ ದೆಕಾಡಿನ ದಿದಿ.</para>
  <para style="q2" vid="1TI 3:16">ಕ್ಹುದಾನಾ ದುತೊನೆ ತೆ ದಿಕ್ಹ್ಯೊ.</para>
  <para style="q1" vid="1TI 3:16">ತಿನಾ ಹುತಿ ಸುವಾರ್ತೆ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಪ್ರಚಾರ ಕರ‍್ಯೊ.</para>
  <para style="q2" vid="1TI 3:16">ಜಗತ್ಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ತಿಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲ್ಯಾ.</para>
  <para style="q2" vid="1TI 3:16">ತೆ ಮಹಿಮಾನಾ ಕ್ಹಾತೆ ಸ್ವರಗಾಮಾ ಗಯೊ.<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">ಕೆಟ್ಟ ಭೊದಕೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />ತಿನಾಹುತಿ ಅಗಲ್ಯಾ ದಿನೊಮಾ ದಕ್ಹಾ ಮನಕ್ಹೊ ಮೊಸ ಕರಾನು ಆತ್ಮನಾ ವಾತೊಪರ, ಸೈತಾನನಾ ವಾತೊಪರ ಬರೊಕ್ಹೊ ಕರಿನ ಸುಳ್ಳನಾ ಆತ್ಮನಾ ಆಜ್ಞಾ ಐಕಿನ ಪಾಲ್ಸಸ,ವರಿ ಸೈತಾನನಾ ಶಿಕ್ಷಣ ನಿಂಗತ ಚಾ಼ಲಸ. <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />ತೆ ಭೊದನೆ ಸುಳ್ಳ ಬೊಲಾಲಾ ವರಿ ಮೊಸ ಕರಾಲಾ ಮನಕ್ಹೊ ಕಂತು ಆವಸ. ತ್ಯುನೆ ಕ್ಹರಿ ಸುವ್ಹೈ ವರಿ ಕೆಟ್ಟ ಸುವ್ಹೈ ವಳಕ್ಕತಾನೈ. ಉನ್ನು ಥಯಲ ಲ್ಹೊಡಾಕ್ಹು ಬಳಿನ ರಾಕ ಥಯಲ ನಿಂಗತ ತ್ಯುನು ಗ್ಯಾನಬಿ ಹಾಳ ಥೈ ಜಾ಼ವಸ.<verse eid="1TI 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 4:3" />ತೆವಾ ಮನಕ್ಹೊ ಹಿವಾ ಕರಲ್ಯುನೈ ಕೈನ ವರಿ ದಕ್ಹು ಅನಾಜ಼ ಖೌನೈ ಕೈನ ತ್ಯುನೆ ಕವಸ. ತೆನೈಸೊ ಬರೊಕ್ಹೊ ರ‍್ಹಯಲವಾಲಾ ವರಿ ಕ್ಹರಿ ತಿಳದಿಲಿದಲವಾಲಾ ಸ್ತುತಿ ಕರಿನ ತೆ ಅನಾಜ಼ ಖಾವಾದೆ ಕಾಕದ್ಯಾಮ ತೆ ತಯ್ಯಾರ ಕರಲವಾಲೊ ಕ್ಹುದಾಜ಼ ವ್ಹೈ. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />ಕಾ ಕದ್ಯಾಮ ಕ್ಹುದಾ ತೆ ತಯ್ಯಾರ ಕರಲ ಹರಿಯಕ್ಕ ಚೊ಼ಕು ರ‍್ಹವಸ ತಿನೆ ಸ್ತುತಿ ಕರಿನ ಲಿವಾನು ಸುಬಿ ರ‍್ಹೈನೆಕಾ ತಿರಸ್ಕಾರ ಕರುನೈ. <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />ಕಾಕದ್ಯಾಮ ಕ್ಹುದಾನಿ ವಾಕ್ಯಾಕ್ಹು ವರಿ ಪ್ರಾಥನಾ ಕ್ಹು ತೆ ಅನ್ನ ಪವಿತ್ರ ಥಾವಸ.<verse eid="1TI 4:5" /></para>
  <para style="s">ಯೆಸುನೊ ಚೊ಼ಕೊ ಸೆವಕ</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />ತ್ಯಾ ರ‍್ಹಯಲ ಭಾಯೊ ಭೆನೊ ಎ ಕ್ಹಾರು ಕದ್ಯಾಮ, ತು ಕ್ರಿಸ್ತ ಯೆಸುನೊ ಚೊ಼ಕೊ ಸೆವಕ ಥಾಸಿ ಕವಾನು ಬರೊಕ್ಹಾನಿಯೊ ವಾತೊ ವರಿ ಚೊ಼ಕು ಉಪದೆಶ ಕರಿನ ಚಾ಼ಲಲ ಹುತಿ ತಾಕತವಾಲೊ ವ್ಹೈ ಕೈನ ದೆಕಾಡಿನ ದೆಶಿ. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />ಕ್ಹುದಾ ಕ್ಹರಿಕ್ಹು ಮಳಾನಿ ಕಾನಿಯೊ ಮನಕ್ಹೊ ಕವಸ. ತೆ ಕಾನಿಯೊ ಲಿಂಗತ ಚ಼ಾಲು ನಕೊ. ಕ್ಹುದಾನೆ ಕ್ಹರಿಕ್ಹು ಸೆವೆ ಕರಾನು ತುಮಾರಾಕ್ಹು ತುಮೆ ತಿಳ್ದಿಲಿವೊ.<verse eid="1TI 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 4:8" />ಶಾರಿರಿಕ ವ್ಯಾಯಾಮಕ್ಹು ಅಪ್ನೊನೆ ದಕ್ಹಿ ರಿತಿಮಾ ತುಮೊನೆ ಆಸ್ರೊ ಥಾವಸ. ತೆನೈಸೊ ಕ್ಹುದಾನಿ ಸೆವೆ ಕರಾನು ತುಮೊನೆ ಕ್ಹಾರಿ ತರಾ ಆಸ್ರೊ ಥಾವಸ. ಕ್ಹುದಾನಿ ಸೆವೆ ಕ್ಹಾರಾ ಲೊಕಮಾ ಆಶಿರ್ವಾದ ಥೈನ ರ‍್ಹವಸ. ಕಾಕದ್ಯಾಮ ಹಮ್ನಾನೊ ಟೈಮ್ಮ ವರಿ ಆವಾನೊ ಕಾಲಮ್ಮಾ ದಿದೆಲ ವಾಗ್ದಾನ ಮಳೈ ಲಿದ್ಯುಸ. <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />ಎ ಸಂಗತಿಯೊಪರ ಬರೊಕ್ಹೊ ಕರಾನು ಕ್ಹಾರಾಕ್ಹು ಯೊಗ್ಯ ವ್ಹೈ. <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />ತಿನಾಹುತಿ ಅಪೆ ಕಷ್ಟಕ್ಹಾವಾಡಾಸ,ಪ್ರಯಾಸ ಕರಾಡಾಸ,ಕಾಕದ್ಯಾಮ್ಮ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ, ವಿಶೆಷ ಕರಿನ ಬರೊಕ್ಹೊ ಕರಾವಾಲಾವೊನೆ, ರಕ್ಷಕ ಥಯಲ ಜ಼ಲಮ ರ‍್ಹಯಲ ಕ್ಹುದಾನಾ ಉಪ್ಪರ ಹಮೆ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಾಲಾ ಥಯಾಸ.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />ಎ ಕ್ಹಾರಿ ಸಂಗತಿಯೊನೆ ಆಗನ್ಯಾ ಕೈನ ವರಿ ತಿಳಸಾ, <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />ತು ಜಾಂಜಿಮಾನ ರ‍್ಹಯಲ ಹುತಿ ತುಜ಼಼ ಮ್ಹೊಟೊ ವ್ಹೈ ಕೈನ ಕವೈಲಿದ್ಯಾವಾಚಿ ತುನೆ ಹಿನಾವಾನೆ ಕಿನೆಜ಼ ಮೌಕೊ ದ್ಯು ನಕೊ. ವಿಸ್ವಾಶಿಯೊ ಕಿಮ್ಮ ರ‍್ಹೌ ಕೈನ ತುಜ಼಼ ತ್ಯುನೊನೆ ದೆಕಾಡಿನ ದ್ಯು. ತು ಬೊಲಾನು ಚಾ಼ಲಾನು ಮಯಾಮಾ ವರಿ ಬರೊಕ್ಹಾಮಾ ವರಿ ಪರಿಶುದ್ಧ ಜಿವಿತ್ಮಾ ತು ತ್ಯುನೊನೆ ದೆಕಾಡಿನ ದ್ಯು. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />ಕ್ಹುದಾನಿ ವಾಕ್ಯಾ ಮನಕ್ಹೊನೆ ಒದಿನ ಕೈನ ತ್ಯುನೊನೆ ಘಟ್ಟ ಕರಿನ ವರಿ ತ್ಯುನೊನೆ ಭೊದನೆ ಕರಿನ. ಮಿ ಆಯೆಲಕ್ಕಾ ಎ ಕ್ಹಾರು ತು ಕರತೊಜ಼ ರ‍್ಹೌ.<verse eid="1TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 4:14" />ತುಕನ ರ‍್ಹಯಲ ಮರಗಾನಿ ವರಾನೆ ತಿನೆ ಅಲಕ್ಷ ಕರೊ ನಕೊ ತೆ ವರಾ ತುಮಾರಾ ಪ್ರವಾದಿ ಕರಲ ಹತ್ತ ವ್ಹೈ. ವರಿ ಮ್ಹೊಟಾ ಮನಕ್ಹೊಕ್ಹು ತಾರಾ ಉಪ್ಪರ ಹತ್ತ ಮ್ಹೆಲ್ಯಾಸ. <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />ಎ ಕಾಮೊ ಕರತೊಜ಼ ರ‍್ಹೆ. ಎ ಕಾಮೊ ಕರಾನೆಜ಼ ತುಮಾರಿ ಜಿವಿತ ವಪ್ಸಿನ‍ ದ್ಯು. ತೆಳಾಮಾ ತಾರು ಕಾಮ ಅಭಿವೃದ್ದಿ ಥಾವಾನು ಕ್ಹಾರಾ ಮನಕ್ಹೊ ದೆಕಸ. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />ತಾರಿ ಜಿವಿತ್ಮಾ ತಾರಿ ಬೊಧನೆಮಾ ಹುಷಾರಕಿಮಾ ರ‍್ಹೆ. ಚೊ಼ಕಿ ತರಾನಿ ಜಿವ್ನಾ ಕರತೊ ಬೊಧನೆ ಕರತೊ ತೆಳಾಮಾ ತು. ತುನೆ ತಾರಿ ಬೊದನೆ ಐಕಾಲಾವೊನೆ ವಚಾ಼ಡುಸ.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">ವಿಶ್ವಾಸಿಯೊನು ಕರ್ತವ್ಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />ವೈಸ ಥಯಲ ಮನಕ್ಹೊನೆ ಸಿಟ್ಟೆ ಬೊಲ್ಯಾವಾಚಿ ತ್ಯುನೊನೆ ಬಾಪ ವ್ಹೈನ ತಿಳ್ದಿಲಿನ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬೊಲ. ತಿನೆ ಮರ್ಯಾದಿ ದ್ಯು. ಕಾಕದ್ಯಾಮ ತ್ಯುನೆ ಯಕ್ಲಾಜ ಛೆ. <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />ವೈಸ ಥಯಲ ಹೆಣ ಮನಕ್ಹೊನೆ ಮಾ ನಿಂಗತ ಜಾಂಜಿಮಾನ ಹೆಣ ಮನಕ್ಹೊನೆ ಭೆನೊ ನಿಂಗತ ತಿಳದ. ಹಮೆಶಾಬಿ ತ್ಯುನಾ ಕ್ಹಾತೆ ಚೊ಼ಕಿ ತರಾ ಚಾ಼ಲ.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />ಕುನ್ನಜ಼ ನೈ ರ‍್ಹಯಲ ರಾOಡಿ ಹೆಣ ಮನಕ್ಹೊನೆ ರಾಕ. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />ದಿಕ್ಕ ನೈಸೊ ಮಾಟಿ ಮರೆಲವಾಲಿನೆ ಆಸ್ರೊ ಥಾವೊ. ತಿನಾಹುತಿ ರ‍್ಹಯಾಮ, ತ್ಯುನೆ ಮಾ ಬಾಪನೆ ಆಸ್ರೊ ಕರಲ ನಿಂಗತ ತಿವ್ನಾ ಸ್ವಂತ ಖಾಂದಾನನೆ ಮರ್ಯಾದಿ ದ್ಯು. ತ್ಯುನೆ ಇಮ್ಮ ಕರ‍್ಯಾಮ, ಮಾ ಬಾಪನೆ ವರಿ ಬುಡಾ ಬುಡಿನೆ ತ್ಯುನೊನೆ ಉಪಕಾರ ಕರಲ ನಿಂಗತ ಥಾವಸ. ತೆ ಕ್ಹುದಾನೆ ಪಸಂದ ವ್ಹೈ. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />ಯಕ್ಕ ರಾOಡಿ ಹೆಣ ಮನಕ್ಹ ಕ್ಹರಿಮಾಜ಼ ತಿನೆ ಕುನ್ನಜ಼ ಆಸ್ರೊ ನೈಸೊ ಯಕ್ಲಿಜ಼ ರ‍್ಹೈಮ, ತೆಳಾಮಾ ತೆ ತಿನಾ ಆಸ್ರಾನೆ ಕ್ಹುದಾಪರ ಆಸ ಮ್ಹೆಲಸ. ತೆ ಹೆಣ ಮನಕ್ಹ ದಿನ್ನ ರಾತ ಪ್ರಾಥನಾ ಕರಸ. ತೆ ಆಸ್ರೊ ಮಾಂಗಸ.<verse eid="1TI 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 5:6" />ತೆನೈಸೊ ಮಾಟಿ ಮರಲವಾಲಿ ತಿನಾ ಮನಸೆ ಆಯಲ ನಿಂಗತ ಜಿವ್ನಾ ಕರಿಮ ತೆ ಜಿವ್ತಿ ರ‍್ಹೈತಬಿ ಮರಲನಿಂಗತ ವ್ಹೈ. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />ಮನಕ್ಹೊನಾ ಕೆಟ್ಟವಾತೊನೆ ಗುರಿ ಥಾಯೆ ನೈಸೊ ತಿನೆ ರ‍್ಹವಾನು ಶಿಕ್ಲಾ. ತೆಳಾಮಾ ತ್ಯುನೆ ತಿನೆ ಕೆಟ್ಟವಾತೊ ಬೊಲಾನೆ ಥಾತು ನೈ. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />ಕಯೊಬಿ ತಿನಾ ಸ್ವಂತ ಮನಕ್ಹೊನೆ ವರಿ ತಿನಾ ಸ್ವಂತ ಘರವಾಲಾವೊನೆ ನೈ ರಾಕ್ಯೊಮ ತೆ ಕ್ಹರಿಕ್ಹು ಚಾ಼ಲಾಲೊ ನ್ಹವೈ. ತೆ ಬರೊಕ್ಹೊ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹತಿ ಕೆಟ್ಟ ವ್ಹೈ.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />ರಾOಡಿ ಹೆಣ ಮನಕ್ಹೊನಾ ಲಿಸ್ಟಮಾ ಕ್ಹಾಟ ವೈಸ್ ಥಯಲ ರ‍್ಹೌ. ತೆ ತಿನಾ ಮಾಟಿನಾ ಬರೊಕ್ಹೊಮಾ ರ‍್ಹೌ. <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />ತೆ ಚೊ಼ಕಾ ಕಾಮೊ ಕರಸ ಕೈನ ಕವೈಲಿದಲ ರ‍್ಹೌ. ಕದ್ಯಾಮ ತೆ ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆ ರಾಕಿನ, ಆಯಲ ಮನಕ್ಹೊನೆ ಮರ್ಯಾದಿ ದಿದಲ ವಾಲಿ, ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನಾ ಪಗೊ ಧ್ವಯಲವಾಲಿ, ತ್ರಾಸಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಆಸ್ರೊ ಕರಲವಾಲಿ ವರಿ ತಿನಾ ಹತೆ ಥಯಲ ತೆಕ್ಲು ಚೊ಼ಕಾ ಕಾಮೊ ಕರಲವಾಲಿ ರ‍್ಹೌ.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />ವರಿ ಮಾಟಿಮರಲ ಜಾಂಜಿಮಾನ ಹೆಣ ಮನಕ್ಹೊನೆ ತೆ ಲಿಸ್ಟಮಾ ಮಳೌನೈ. ತ್ಯುನೆ ಕ್ರಿಸ್ತನೆ ವಪ್ಪಿಲಿದಲ ರ‍್ಹೈಯೊತಬಿ ತ್ಯುನಾ ಅಂಗನಿ ಆಸನಾ ಹುತಿ ಹಗ್ಲೆಲ್ಲಾ ತಿನೆ ಆಸ ಕರಸ. ಪಾಚಾ಼ತಿಯೊ ತ್ಯುನೆ ಹಿವಾಕರಲಿವಾನೆ ಆಸ ಕರಸ. <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />ತ್ಯುನೆ ದಿದಲ ವಾತ ದಾಟಿನ ಗಯೊಸ ತ್ಯುನೊನೆ ಫೈಸಲೊ ಥಾವಸ. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />ಎನೈಸೊ ತ್ಯುನೆ ಘರೊ-ಘರೊ ಫರತಿಯೊ ತ್ಯುನೊ ಟೈಮ ಕಾಡಾನು ಚ಼ಾಲು ಕರಾನು ಶಿಕ್ಕಸ. ಫಾಲ್ತು ವಾತೊ ಬೊಲತ್ಯೊ ಬಿಜಾ಼ವೊನು ಬೊಲತ್ಯೊ ಟೈಮ ಹಾಳ ಕರಸ ಕವಾನಿಯೊ ನೈಸೊ ವಾತೊ ಕವಸ. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />ತಿನಾಹುತಿ ಜಾಂಜಿಮಾನ ಮಾಟಿ ಮರಲವಾಲಿಯೊ ಹಿವಾ ಕರಲಿನ ಬಚ್ಚಾ಼ ಜ಼ನ್ನಾದೆ ವರಿ ತ್ಯುನಾ ಘರೊ ದೆಕಿಲಿವಾದೆ. ತೆಳಾಮಾ ತ್ಯುನೊನೆ ಕೆಟ್ಟವಾತೊ ಕುನ್ನಜ಼ ಬೊಲತು ನೈ. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />ತೆನೈಸೊ ಹಮ್ನಾಜ಼ ದಕ್ಹಾಜ಼಼ನಾ ತಿವ್ನಿ ವಾಟ ಬದ್ಲಿ ಕರಿನ ಸೈತಾನ್ನಾ ಪಾಚಾ಼ ಚಾ಼ಲಿಯೊಸ.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />ತೆನೈಸೊ ವಿಶ್ವಾಸಿಯೊ ಥಯಲ ಹೆಣ ಮನಕ್ಹೊನಾ ಘರೊಮಾ ರಾಂಡಿಯೊ ರ‍್ಹಯ್ಯೊಮ ತೆ ತ್ಯುನೊನೆ ಜ಼ತ್ತನ ಕರಾದೆ. ತ್ಯುನೊನೆ ದೆಕಿಲಿವಾನು ಜವಾಬ್ದಾರಿಯೊ ಸಬೆನೆ ದ್ಯು ನೈ. ತೆಳಾಮಾ ಕುನ್ನಜ಼ ನೈ ರ‍್ಹಯಲ ರಾOಡಿ ಬಾಕಡಿಯೊನೆ ಅರಾಕಿ ಕರಾನಿ ಸಬೆನೆ ಸಾದ್ಯ ಥಾವಸ.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />ಸಬೆನೆ ಚೊ಼ಕಿತರಾ ಚ಼ಲೈನಿಂಜಾ಼ವಾಲಾ ಮ್ಹೊಟಾ ರ‍್ಹಯಲವಾಲಾ ಮರಯಾದಿನೆ ವರಿ ಬೆ ಪಟ್ಟ ಪಗಾರನೆ ಯೊಗ್ಯ ವ್ಹೈ. ಖಾಸ ಕರಿನ ಉಪದೆಶ ವರಿ ಶಿಕ್ಲಾವಾನು ಕಾಮ ಪುರಾ ಮನಸೆ ಕರ‍್ಯಾಮಾ ಹಮೆಶಾ ತಿಮಾ ರ‍್ಹಯಲವಾಲಾ ಮ್ಹೊಟಿ ಮರ್ಯಾದಿ ದಿವಸ. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />ಕಾಕದ್ಯಾಮ "ಕ್ಹಾಳ ಖುಂದಾನಿ ಬೈಲನು ಮ್ಹೊಡು ಭಾಂದು ನೈ "ಕವಾನು "ರಾಬಾಲಾ ಆಳನೆ ತಿನಿ ಕುಲಿನಾ ತಕ್ಕ ಪಗಾರ ಮಳು "ಕವಾನು ಪವಿತ್ರ ಗ್ರಂಥ ಕವಸ್ತೊ.<verse eid="1TI 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TI 5:19" />ಸಬೆಪರ ಮ್ಹೊಟಾ ರ‍್ಹಯಲ ವಾಲಾವೊನಾಹುತಿ ತಿವ್ನಾ ವಿರುದ್ದ ಕುನಬಿ ಕತು ರ‍್ಹಯುಮ ಬೆ ಜ಼ನಾ ನೈತೊ ತನ್ನ ಜ಼ನಾ ರ‍್ಹಯಾಮಜ಼ ತಿವ್ನಿಯೊ ವಾತೊ ಐಕು ನಕೊ. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />ಪಾಪ ಕರಾಲಾ ಮನಕ್ಹೊನೆ ಸಭೆಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮೊಜ಼ ಬರ್ಬಡ. ತೆಳಾಮಾ ಬಿಜಾ಼ವೊನೆಬಿ ಹುಶಾರಕಿ ಮಳಸ.<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />ತು ವಿಚಾರ ಕರಾತಿ ಪೈಲಾ ತಪ್ಪ ಘಾಲ್ಯಾವಾಚಿ, ಪಕ್ಷಪಾತಕ್ಹು ಸು ಕರ‍್ಯಾವಾಚಿ, ಮಿ ಕದಲ ವಾತೊನಾ ಪ್ರಕಾರ ಚಾ಼ಲು ಕೈನ ಕ್ಹುದಾನಾ ಕ್ಹಾಮಾ, ಕ್ರಿಸ್ತ ಯೆಸುನಾ ಕ್ಹಾಮೊ, ಇನಿಲಿದಲ ದೆವದುತೊನಾ ಕ್ಹಾಮಾ ಕ್ಹರಿ ಕವಸ. <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />ತು ತಾರಾ ಹತೊ ಕಿಪರಬಿ ಮ್ಹೆಲಿನ ತಿನೆ ಸಭಾಪರ ಮ್ಹೊಟೊ ಕರಾತಿ ಅಗ್ದುರ ಮನಸ ದಿನ್ನ ವಿಚಾರ ಕರ. ಬಿಜಾ಼ ಮನಕ್ಹೊನಾ ಪಾಪಮಾ ಪಡೆನೈಸೊ ಶುದ್ಧ ಥೈನ ರ‍್ಹೆ.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />ತಿಮೊತಿ, ತು ಪಾನಿ ಪಿದ್ಯಾವಾಚಿ ದಕ್ಹು ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ಪ್ಯು. ಇನಾಹುತಿ ತು ಖಾದಲ ಅನ್ನ ಪಚನ ಕರಾನಿ ತಾಕತ ಹೆಚ್ಕಿ ಥಾವಸ ವರಿ ಹಗ್ಲೆಲ್ಲಾ ಅರಾಮ ನೈಸೊ ಪಡತೊ ನೈ.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />ದಕ್ಹಾ ಮನಕ್ಹೊ ಕರಲ ಪಾಪೊ ದಿಕ್ಹಿನ ಆವಸ. ತ್ಯುನೊನೆ ಫೈಸಲೊ ಥಾವಸ ಕವಾನು ದೆಕಾಡಿನ ದಿವಸ. ತೆ ದಕ್ಹಾ ಮನಕ್ಹೊ ಕರಲ ಪಾಪೊ ದಕ್ಹಯೆಳ ಪರ ಕಳಸ. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />ತಿಮ್ಮಜ಼ ದಕ್ಹಾ ಚೊ಼ಕಾ ಕಾಮೊ ದಿಕ್ಹಿನ ಆವಸ. ಹಜು಼ನ ದಕ್ಹಾ ಕಾಮೊ ದಿಕ್ಹಿನ ನೈ ಆಯಾ ತಬಿ ತೆ ದಡಿರ‍್ಹತು ನೈ.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />ಗುಲಾಮೊ ತಿನಾ ಮಾಲಕನೆ ಕ್ಹಾರಾಕ್ಹುಜ಼ ಮರ್ಯಾದಿ ದ್ಯು. ತೆಳಾಮಾ ಕ್ಹುದಾನಾ ನಾಮನೆ ವರಿ ಅಪೆ ಕವಾನು ಉಪದೆಶನೆ ಕುನ್ನಜ಼ ಕೆಟ್ಟ ವ್ಹೈ ಕೈನ ಕತಾನೈ. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />ದಕ್ಹಾ ಮನಕ್ಹೊನೆ ಬರೊಕ್ಹೊವಾಲಾ ಮಾಲಕೊ ಛೆ. ತಿನಾಹುತಿ ತೆ ಗುಲಾಮೊ ವರಿ ಮಾಲಕೊಜ಼ ಭಾಯೊ ಥಯಾಸ. ತೆನೈಸೊ ತ್ಯುನೆ ತಿನಾ ಮಾಲಕೊನೆ ಕಮ ಮರ್ಯಾದಿ ದೆಕಾಡು ನೈ ತ್ಯುನಾ ಮಾಲಕನಿ ಸೆವಾ ಹಜು಼ನ ಚೊ಼ಕಿತರಾ ಕರು. ಕಾಕದ್ಯಾಮ ತ್ಯುನೆ ಚೊ಼ಕಾ ಕಾಮೊನಾಹುತಿ ತ್ಯುನೊನೆ ತಿಮ್ಮ ಮ್ಹೆಲ್ಯಾಮ ಬರೊಕ್ಹೊ ರ‍್ಹಯಲವಾಲಾ ವ್ಹೈ ವರಿ ಮಯಾನಾ ದೊಸ್ತೊ ಥೈನ ರ‍್ಹಯಾಸ.</para>
  <para style="p" vid="1TI 6:2">ಎ ಕಾಮೊ ಕರು ಕೈನ ತು ಮನಕ್ಹೊನೆ ಉಪದೆಶ ಕರು ವರಿ ತಿಳಸೌ.<verse eid="1TI 6:2" /></para>
  <para style="s">ಸುಳ್ಳ ಭೊದನೆ ವರಿ ಕ್ಹರಿ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />ದಕ್ಹಾ ಮನಕ್ಹೊ ಸುಳ್ಳ ಸಂಗತಿಯೊ ಕವಸ. ತೆ ಮನಕ್ಹೊ ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸುನಿ ಕ್ಹರಿನಿಯೊ ವಾತೊ ನೈ ವಪ್ಪಿಲೆತಾ. ಕ್ಹುದಾನಿ ಸೆವಾನೆ ಕ್ಹರಿಜ಼ ಕರು ಕವಾನಿ ಉಪದೆಶ ತ್ಯುನೆ ನೈ ಸ್ವಿಕಾರ ಕರತಾ. <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />ಕೆಟ್ಟ ಶಿಕ್ಲಾವಾಲೊ ಗಮಂಡಿಕ್ಹು ಭರಲ ರ‍್ಹವಸ ವರಿ ತಿನೆ ಸುಜ಼ ಕಳತು ನೈ. ತೆ ಕ್ಹಾಲಿ ವಾದ-ವಿವಾದ ಕರಾಮಾ ರ‍್ಹವಸ. ಇಕ್ಹು ಸಂಗಟ, ಲಡೈ, ತ್ರಾಸ ವರಿ ಕೆಟ್ಟ ಸಂಶೊ ಹುಟ್ಟಸ. <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />ಎನೈಸೊ ಕೆಟ್ಟ ಜ಼ನಾವೊಮಾ ವಾದವಿವಾದ ಹುಟ್ಟಸ. ತೆ ಮನಕ್ಹೊ ಕ್ಹರಿನೆ ಛೊಡಲವಾಲಾ ವ್ಹೈ. ಕ್ಹುದಾನಿ ಸೆವಾ ದೊಕಡಾ ಕಮಾವಾನಿ ಯಕ್ಕ ವಾಟ ವ್ಹೈ ಕೈನ ತ್ಯುನಿ ವಿಚಾರ ವ್ಹೈ.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />ಕ್ಹುದಾನಿ ಸೆವಾ ಕರಾಲೊ ತಿಕನ ರ‍್ಹಯಲಮಾ ಖುಶ ರ‍್ಹವಸ, ತೆ ಮ್ಹೊಟೊ ಸೌಕಾರಜ಼ ವ್ಹೈ. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />ಅಪೆ ದುನಿಯಾಮಾ ಆಯಲಪರ ಸುಜ಼ ಲಿನ ಆಯಾ? ಸುಜ಼ ನತ್ತಿ. ಅಪೆ ಮರತಾಮಾ ಸುಜ಼ ಲಿನ ಜಾ಼ತಾ ನೈ? ಸುಜ಼ ನತ್ತಿ. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />ತಿನಾಹುತಿ ಅನ್ನ ವಣ್ಣಾ ರ‍್ಹಯುಮ ಬಸ್ಸ, ಅಪೆ ಖುಶಿ ರ‍್ಹಯೆಸ. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />ತೆನೈಸೊ ಸೌಕಾರ ಥೌಸ ಕವಾಲಾ ತ್ಯುನೊನೆ ತ್ಯುನೆಜ಼ ತ್ರಾಸನೆ ಗುರಿ ಕರಲಿವಸ. ತ್ಯುನೆ ಪಾಕ್ಹೊ ಘಾಲಿದಲವಾಲಾ ಥಯಾಸ. ತ್ಯುನೆ ಕೆಟ್ಟ ಆಸೊಮಾ ಪಡಸ. ತೆ ಮನಕ್ಹೊನೆ ಹಾಳ ಕರಿನ, ವರಿ ಬರಬಾದ ಕರಸ. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />ದೊಕಡಾನಿ ಮಯಾಕ್ಹು ಕ್ಹಾರಾ ತರಾನಾ ಕೆಟ್ಟ ಕಾಮೊ ಹುಟ್ಸಾವಸ. ದಕ್ಹಾ ಜ಼ನಾ ಪಡ್ದಿಲಿವಾನಾ ಹುತಿ ಬರೊಕ್ಹೊ ಜ಼ವೈಲಿದ್ಯಾಸ ವರಿ ಘನ್ನಾ ತ್ರಾಸೊಕ್ಹು ತ್ಯುನು ಮನಸ ಘಟ್ಟ ಥೈ ಗೈಯುಸ.<verse eid="1TI 6:10" /></para>
  <para style="s">ವೈಯಕ್ತಿಕ ಸಲಹೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />ತೆನೈಸೊ ತು ಕ್ಹುದಾನೊ ಮನಕ್ಹ ವ್ಹೈ. ತಿನಾಹುತಿ ಎ ಕ್ಹಾರಾ ಸಂಗತಿಯೊಕ್ಹು ದುರ ರ‍್ಹೆ. ತೆನೈಸೊ ನಿತಿವಂತ, ಭಕ್ತಿನಿ ಸೆವಾ ಬರೊಕ್ಹೊ ಸಮಾಧಾನ ಧೈರ್ಯ ಮಯಾ, ತಾಳ್ಮೆ, ಉದಾರ ಮನಸನೊ ಥೈನ ರ‍್ಹೆ. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />ಬರೊಕ್ಹಾನಾ ಖೆಲಮಾ ತಾರಿ ಚೊ಼ಕಿತನಾಕ್ಹು ನ್ಹಾಟ ಲಿಂಗತ ಛೆ. ನ್ಹಾಟಾನಾ ಖೆಲಮಾ ಝಿತ್ತಾನೆ ತುಕನ ಥಾವಾ ಯಕ್ಲು ಕೊಶಿಶ ಕರ. ಹಮೆಶಾನೊ ಜಿವನ ಪಡದಿಲಿವಾನೆ ಕೊಶಿಶ ಕರ. ತೆ ಪಡದಿಲಿವು ಕೈನ ಬಲೈಲಿದಲವಾಲೊ ವ್ಹೈ. ಕ್ರಿಸ್ತನಾ ಬರೊಕ್ಹಾನಾ ಹುತಿ ಕ್ಹರಿ ತು ಘನ್ನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮೊ ವಪ್ಪಿಲಿವು.<verse eid="1TI 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TI 6:13" />ಪೊಂತ್ಯ ಪಿಲಾತನನಾ ಕ್ಹಾಮೊ ಸಾಕ್ಷಿ ದಿದಲ ಕ್ರಿಸ್ತ ಯೆಸುನಾ ಸನ್ನಿಧಾನಮಾಬಿ ಕ್ಹಾರಿ ಸೃಷ್ಟಿನೆ ಜ಼ಲಮ ದಿದಲವಾಲಾ ಕ್ಹುದಾನಿ ಸನ್ನಿಧಿಮಾಬಿ ಮಿ ತುನೆ ಕವಾನು ಸುವೈ ಕದ್ಯಾಮ, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತ ವರಿ ಆವಾನೊ ಟೈಮಲಕ್ಕಾ ತು ಎ ಕಾಮೊ ತಪ್ಯಾವಾಚಿ಼, ಚು಼ಕ್ಯಾವಾಚಿ ಕರತೊ ರ‍್ಹೆ. <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />ಕ್ಹುದಾ ಕರೆಟ್ಟ ಟೈಮಮಾ ತೆ ಕರಸ. ತೆ ನಸಿಬವಾಲೊ ಯಕ್ಲೊಜ಼ ರಾಜಾ಼ವೊನೊ ರಾಜೊ಼ ಪ್ರಭುವೊನೊ ಪ್ರಭು ಥಯೊಸ. <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />ಮರಣ ನೈಸೊವಾಲೊ ತೆ ಯಕ್ಲೊಜ಼ ವ್ಹೈ. ತೆ ಘನ್ನಾ ಉಜಾಲಾಮಾ ರ‍್ಹವಾಲೊ ರ‍್ಹಯಲಕ್ಹು ತಿನಾ ಕ್ಹಾಮಾ ಮನಕ್ಹೊ ಜಾ಼ವಾನೆ ನೈ ಥಾತು. ತಿನೆ ಹಜು಼ನ ಲಕ್ಕಾ ಕುನ್ನಜ಼ ದೆಕ್ಯು ನತ್ತಿ; ದೆಕಾನೆ ಥಾತುಬಿ ನೈ. ತಿನೆ ಮರಯಾದಿಬಿ ಅದಿಕಾರಬಿ ಹಮೆಶಾ ರ‍್ಹವಾದೆ. ಆಮೆನ್.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />ಆಂ ಲೊಕನಾ ವಿಚಾರಮಾ ಸೌಕಾರ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಎ ಆಗನ್ಯಾ ತಿಳಸಾ. ಗರ್ವ ಕರ‍್ಯಾವಾಚಿ ದೊಕಡಾನಾ ಪಾಚೊ಼ ಪಡ್ಯಾವಾಚಿ ಕ್ಹುದಾಪರ ಆಸ ಮ್ಹೆಲಲವಾಲೊ ಥೈನ ತ್ಯುನೊನೆ ತಿಳಸಾ. ದೊಕಡಾ ಬರೊಕ್ಹೊನಾ ನ್ಹವೈ. ಕ್ಹುದಾತಬಿ ಅಪ್ನಾ ಕ್ಹುಶಿನಾಹುತಿ ಕ್ಹಾರು ಅಪೊನೆ ದಿವಸ. <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />ಚೊ಼ಕಾ ಕಾಮೊ ಕರು ಕೈನ ಸೌಕಾರೊನೆ ತಿಳಸಾ. ಚೊ಼ಕಾ ಕಾಮೊ ಕರಾಮಾಜ಼ ಸೌಕಾರೊ ಥೈನ ರ‍್ಹವೊ ಕೈನ ತ್ಯುನೊನೆ ತಿಳಸಾ. ಉಪಕಾರ ಕರಾಮಾಬಿ ವಾಟಿಲಿವಾಮಾಬಿ ಕ್ಹುಷ ರ‍್ಹವಾನೆ ತ್ಯುನೊನೆ ತಿಳಸಾ. <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />ತೆಳಾಮಾ ತ್ಯುನೆ ಸ್ವರ್ಗಮಾ ಯಕ್ಕ ಗಾಟ್ರು ಭಾಂದಿನ ಮ್ಹೆಲಲ ನಿಂಗತ ಥಾವಸ. ತೆ ಗಾಟ್ರುಜ಼ ತ್ಯುನಿ ಅಗ್ಲಿ ಜಿವನಾನೆ ಘಟ್ಟ ಫಾಯಾ ವ್ಹೈ. ಇಮ್ಮ ತ್ಯುನೆ ಕ್ಹರಿನಿ ಜಿವಿತ ಪಡದಿಲಿವಸ.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />ತಿಮೊತಿ, ತಾರಾ ಹತ್ಮಾ ವಪ್ಸಿನ ದಿದಲ ಚೊ಼ಕಿ ಬೊಧನೆ ಚೊ಼ಕಿತರಾ ವಚಾ಼ಡ. ದುನಿಯಾನಿ ವಿಚಾರನಾ ಕೆಟ್ಟ ಸಂಗತಿಯೊ ಕವಾನಾ ಮನಕ್ಹೊ ಕ್ಹರಿನಾ ವಿರುದ್ದ ವಾದ ಕರಾಲಾ ಮನಕ್ಹೊಕ್ಹು ದುರ ರ‍್ಹೆ. ತ್ಯುನೆ ತಿನೆ ಗ್ಯಾನ ವ್ಹೈ ಕೈನ ಕದ್ಯಾತುಬಿ ತೆ ಕ್ಹರಿನು ಗ್ಯಾನ ನ್ಹವೈ. <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />ದಕ್ಹಾಜ಼಼ನಾ ತ್ಯುನೊನೆ ಗ್ಯಾನ ಛೆ ಕೈನ ಕದ್ಯಾತಬಿ ಕ್ಹರಿನು ಉಪದೆಶ ಛೊಡಲವಾಲಾ ರ‍್ಹವಸ.</para>
  <para style="p" vid="1TI 6:21">ಕ್ಹುದಾನಿ ಮರಗಾ ತುಮಾರಾ ಕ್ಹಾರಾವೊನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>