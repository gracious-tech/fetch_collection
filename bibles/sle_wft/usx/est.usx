<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EST" style="id">- Sikkiligar</book>
  <para style="h">ಎಸ್ತರ</para>
  <para style="toc3">ಎಸ್ತರ</para>
  <para style="toc2">ಎಸ್ತರ</para>
  <para style="toc1">ಎಸ್ತರ ಬುಕ್ಕ</para>
  <para style="mt2">ಎಸ್ತರ ಪುಸ್ತಕ</para>
  <para style="mt1">ಎಸ್ತರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಎಸ್ತರ ಬುಕ್ಕನಿ ವಳಕ ಪರ್ಷಿಯನಾ ಜೆಲ್ಮಾ ರ‍್ಹಯಲ ಕೈದಿಯೊನೆ ಎಸ್ರಾಯೆಲನಾ ಶತ್ರುವೊನಾ ಹತ್ಮಾತಾ ಕಿಮ್ಮ ವಚಾ಼ಡ್ಯೊ ಕವಾನು ದೆಕಾಡಿನೆ ದಿವಸ ತ್ಯುನುನೆ ಹಾಳ ಕರಾನು ವಿಚಾರ ಕರ‍್ಡ್ಯುತು. ಎಸ್ತರ ಕ್ಹುದಾನು ನಾಮ ನೈ ಐಯುತಬಿ ಕ್ಹುದಾ ಛೆ ಕವಾನು ದೆಕಾಡಿನೆ ದಿವಸ. ಇವ್ನೊನೆ ಖಲಾಸ ಕರಾನಿ ಕೊಶಿಶಮಾ ತ್ಯುನೊನೆ ಬಿಡುಗಡೆ ಕರ‍್ಯಾ. ಎಸ್ತರ ಬುಕ್ಕ ಕುನ್ನ ಕರ‍್ಯಾಸ ಕವಾನು ಕಿನೆಜ಼ ಗ್ವತ್ತ ನತ್ತಿ. ಉಪಯೊಗ ಕರಲ ಹಿಬ್ರು ಭಾಷಾನಾ ಪ್ರಕಾರ ಎಸ್ತರ ಪುಸ್ತಕ ಕಮ್ಸಿ ಕಮ್ಮ 400 ವರಕ್ಹಮ ಬರ್ದಲ ಛೆ. ಕೈನ ಘನ್ನಾ ವಿದ್ವಾಂಸದೆಕಾಡಿನೆ ದಿವಸ.</para>
  <para style="ip">ಎಸ್ತರ ಪುಸ್ತಕಮಾ ಕದಲ ಘಟಣೆ ಪುರಿಮ ಕವಾನು ಸನ್ನ ಯಹುದಿಯೊ ಕರಸ. ಶುರು ಧಯು ಹಾಮಾನ ಕವಾಲೊ ಅಮಾಲೆಕ್ಯಯಹುದಿದಯೊನಾ ಮನಕ್ಹೊನೆ ನಶ ಕರಾನೆ ಮಸ್ಲತ ಕರಸ. ಇಸ್ರಾಯಲೊ ವರಿ ಮರಭುಮಿ ಮುಲಕ ಮುಟ್ಟಲ ತಂತೊ ಅಮಾಲೆಕ್ಯೊ ದುಶ್ಮನೊ ಥಯಾತಾ. ಇವ್ನೊನೆ ವಾತ ದಿದ್ಯಾತಾ. (ವಿಮೊಚನಕಾಂಡ 17:8-16). ಹಾಮಾನ ಯಹುದಿಯೊ ಮನಕ್ಹೊನೆ ಹಾಳ ಕರಾನೆ ದೆಕಲ ಅಜ಼ ಟೈಮ್ಮ ವ್ಹೈ. ಯೆಹುದಿನಿ ರ‍್ಹಯಲ ಎಸ್ತರ ಪರ್ಷಿಯಾನಿ ರಾಣಿ ಥೈ. ತ್ಯುನೊ ಸಂಭಂದಿಕ ಮೊರ್ದೆಕೈ ಸಲಹಾನಿಂಗತ ಎಸ್ತರ ಹಾಮಾನ ಕರಲ ವಿಚಾರ ಹುಬ್ರಾಡಾನೆ ಸಾದ್ಯಥಯು. ಯಹುದಿಯೊ ತ್ಯುನಾ ದುಶ್ಮನೊಪರ ಝಿತ್ತಲಪರ (ಎಸ್ತರ 9: 20-22), ಮೊರ್ದೆಕೈ ಕದಿ. ತ್ಯುನೆ ಎ ವಿಜಕರಾನೆ ಇನಾನಿಂಗತ ಯಹುದಿಯೊ ಪುರಿಮ ಕವಾನೊ ಸನ್ನ ಸುರು ಕರ‍್ಯಾ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1. ಅಧ್ಯಾಯ 1 ಮತ್ತು 2 ಎಸ್ತರ ಕಿಮ್ಮ ಪರ್ಷಿನಿ ರಾಣಿ ಥೈ ಕವಾನು ದೆಕಾಡಿನೆ ದಿವಸ.</para>
  <para style="io1">2. ಅಧ್ಯಾಯ 3 ತು 7 ಲಕ್ಕಾ ಹಾಮಾ ಯಹುದಿಯೊನೆ ನಾಷ ಕಿಮ್ಮ ಕರಾನೆ ದೆಕ್ಯೊ ಕವಾನು ದೆಕಾಡಿನೆ ದಿವಸ. ಎ ಕಾನೆ ಗೈನ ತೆ ಕಿಮ್ಮ ಮರ‍್ಯೊ ಕವಾನು ದೆಕಾಡಸ.</para>
  <para style="io1">3. 8 ತು 10 ಅಧ್ಯಾಯಮಾ ಯಹುದಿಯೊ ವರಿ ದುಶ್ಮನೊ ಕಿಮ್ಮ ಸೊಲಶ್ಯಾ ವರಿ ಪುರಿಮ ಸನ್ನ ಚಾಲು ಕರ‍್ಯಾ ಕವಾನು ದೆಕಾಡಿನೆ ದಿವಸ.</para>
  <chapter number="1" style="c" sid="EST 1" />
  <para style="s">ರಾಜೊ಼ ವಷ್ಟಿ ರಾಣಿನೆ ಹೆಟೊ ಉತಾರ‍್ಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 1:1" />ಭಾರತ ದೆಶತಿ ಸುರು ಥೈನ ಕುಶಿನಲಕ್ಕಾ ರ‍್ಹಯಲ ಯಕ್ಹೊನ ಸತ್ತರಪರ ಕ್ಹಾತ ಸಂಸ್ಥಾನೊಪರ ಅದಿಕಾರ ಕರ್ತೊ ರ‍್ಹಯಲ ಅಹಶ್ವರೊಶನನಾ ಟೈಮಮಾ ಥಯಲ ಚರಿತ್ರೆ. <verse eid="EST 1:1" /><verse number="2" style="v" sid="EST 1:2" />ಅಹಶ್ವೆರೊಶನ ರಾಜೊ಼ ಶುಶನ ಕೊಟೆಮಾ ತಿನಿ ರಾಜಸಿಂಹಾಸನ್ಪರ ಬೈಟಿನ ಅದಿಕಾರ ಕರ್ತೊತೊ. <verse eid="EST 1:2" /><verse number="3" style="v" sid="EST 1:3" />ತೆ ತಿನೊ ಅದಿಕಾರ ತನ್ವಾ ವರಕ್ಹಮಾ ತೆ ತಿನಾ ಕ್ಹಾರಾಜ಼ ಸರ್ದಾರೊಮಾ ವರಿ ತ್ಯುನಾ ಪರಿವಾರನಾ ಹುತಿ ಖಾವಾನು ಅನ್ನ ತಯ್ಯಾರ ಕರ‍್ಯೊ. ಪಾರಸಿನಾ ವರಿ ಮೆದ್ಯನಾ ಸೆನಾದಿಪತಿಯೊ, ಮ್ಹೊಟಾ ವರಿ ಸಂಸ್ಥಾನನಾ ಅದಿಕಾರಿಯೊ, ರಾಜಾ಼ನಿ ಸನ್ನಿಧಿಮಾ ಮಳಿನ ಆಯಾ. <verse eid="EST 1:3" /><verse number="4" style="v" sid="EST 1:4" />ತ್ಯುನೆ ಘನ್ನಾ ದಿನ್ನ ಕದ್ಯಾಮ, ಯಕ್ಹೊನ ಐಂಶಿ ದಿನ್ನಲಕ್ಕಾ ತಿನಿ ರಾಜ್ಯನಿ ಸೌಕಾರ ತನಾ ವರಿ ಮಹಿಮಾನಿ ವೈಭವ ತಿನಿ ತಾಕತ ದೆಕಾಡಿನೆ ದಿದ್ಯೊ. <verse eid="EST 1:4" /><verse number="5" style="v" sid="EST 1:5" />ತೆ ಥಯಲ್ಪರ ರಾಜೊ಼ ಶುಶನ ಕೊಟೆಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಮ್ಹೊಟಾವೊನೆ ವರಿ ನ್ಹಾನಾವೊನೆ ರಾಜಾ಼ನಾ ಘರ್ಮಾ ರ‍್ಹಯಲ ಮಳಾನಾ ಅಂಗಳಮಾ ಕ್ಹಾತ ದಿನ್ನಲಕ್ಕಾ ಖಾವಾನು ಅನ್ನ ಕರಾಯೊ. <verse eid="EST 1:5" /><verse number="6" style="v" sid="EST 1:6" />ತೆ ಮಳಾನಿ ಜ಼ಗಾಪರ ಉಲನ್ನಾ ಧೊಳಾ ಪ್ಹಡ್ಕಾವೊಕ್ಹೊ ನಿಲಿ ಪ್ಹಡ್ಕಾ, ಧುಮ್ರನಾನಾರಿನಿ ದೊರಾ ವರಿ ಅಮೃತಶಿಲೆನಾ ದಗ್ಡಾವೊನಾ ಖಂಬಾವೊನೆ ಭಾಂದಲ ರುಪ್ಪಾನಿ ಇಟ್ಟಿಯೊಕ್ಹು ಅಲಂಕಾರ ಕರ‍್ಯಾತಾ. ಜರ್ತಾರ ಕಸುತಿಯೊ ಘಾಲಲ ಖ್ಹುನಾ ರುಪ್ಪಾಕ್ಹು ಕರಲ ಆಸನೊ, ತ್ಯುನೊನೆ ಲಾಲ, ಧೊಳು, ಹಳದಿ ವರಿ ಕಾಳು ರಂಗ ರ‍್ಹಯಲ ಅಮೃತನಿಯೊ ಮೊರ್ತಿಯೊ ದಗ್ಡಾವೊಕ್ಹು ಕರಲ ಜಿಮಿನನಾ ಕಟ್ಟಾವೊಪರ ಮ್ಹೆಲ್ಯಾತಾ. <verse eid="EST 1:6" /><verse number="7" style="v" sid="EST 1:7" />ಕ್ಹೊನಾನಾ ಸಾಮ್ನೊ ಗನ್ನಾ ತರಾನಾ ವ್ಹತಾ. ರಾಜ ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ವರಿ ಅನ್ನ ಖಾವಾನು ರಾಜಾ಼ನೆ ಕಿಮ್ಮ ತಿಮ್ಮಜ಼ ಕ್ಹಾರುಜ಼ ವ್ಹತ್ತು. <verse eid="EST 1:7" /><verse number="8" style="v" sid="EST 1:8" />ಪಿವಾನಾಹುತಿ ಕಿನೆಜ಼ ಜು಼ಲುಮ ಕರು ನೈ, ಕೈನ ರಾಜ಼ಾನಿ ಆಗನ್ಯಾ ವ್ಹತ್ತಿ. ಹರಿ ಯಕ್ಲಾನೆ ತ್ಯುನಾ ಮನಸ ನಿಂಗತ ದ್ಯು ಕೈನ ರಾಜೊ಼ ತಿನಾ ಘರವಾಲಾವೊನೆ ಕದ್ಯೊತೊ. <verse eid="EST 1:8" /><verse number="9" style="v" sid="EST 1:9" />ವಷ್ಟಿ ರಾಣಿ ರಾಜಾ಼ನಾ ಘರಮಾ ಬಾಕ್ಡಿಯೊನೆ ಅನ್ನ ಕರೈತಿ. <verse eid="EST 1:9" /><verse number="10" style="v" sid="EST 1:10" />ಕ್ಹಾತ್ವಾ ದಿನ್ನೆ ರಾಜೊ಼ ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ಪಿನ ಖುಷಿಮಾ ರ‍್ಹತಾಮಾ ಘನ್ನಿ ಖುಬಸುರತ ರ‍್ಹಯಲ ತಿನಿ ರಾಣಿನು ಸುಂದರತಾ ಮನಕ್ಹೊನೆ, ಸರ್ದಾರೊನೆ ದೆಕಾಡು ಕೈನ ಮನಸ ಕರ‍್ಯೊ. ತೆ ತಿನಾ ಸಾನಿದ್ಯನಾ ಸೆವಕೊ ಥಯಲ ಮೆಹೊಮಾನ, ಬಿಜೆತಾ, ಹರ್ಬೊನಾ, ಬಿಗೆತಾ, ಅಬಗೆತಾ, ಜೆತರ, ಕರ್ಕಸ, ಕವಾಲಿಯೊ ಕ್ಹಾತ ಕಂಚೊಕಿಯೊನೆ, <verse eid="EST 1:10" /><verse number="11" style="v" sid="EST 1:11" />"ವಷ್ಟಿ ರಾಣಿ ರಾಜಮುಕುಟ ಘಾಲ್ಲಿನ ರಾಜಾ಼ನಿ ಸನ್ನಿಧಿಮಾ ಆ ಕೈನ ಕವೊ" ಕೈನ ಆಗನ್ಯಾ ದಿದ್ಯೊ. ತೆ ಘನ್ನಿ ಸುಂದರಿ ವ್ಹತಿ. <verse eid="EST 1:11" /><verse number="12" style="v" sid="EST 1:12" />ತೆ ನೈಸೊ ಕಂಚುಕಿಯೊ ಕದಲ ರಾಜಾ಼ನಿ ಆಗನ್ಯಾನೆ ವಷ್ಟಿ ರಾಣಿ, ನೈ ಆತಿ ಕೈನ ಕದಿ. ತಿನಾಹುತಿ ರಾಜೊ಼ ಘನ್ನೊ ಶಿಟ್ಟ ಥಯೊ. <verse eid="EST 1:12" /><verse number="13" style="v" sid="EST 1:13" />ವಿಧಿನಾಯ್ಯ ಗ್ವತ್ತ ರ‍್ಹಯಲ ಕ್ಹಾರಾವೊನಾ ಕ್ಹಾಮಾ ಮಹೆಲನಿ ಸಂಗತಿಯೊ ಮುಕ್ಕಾನಿ ಪದ್ದತ ವ್ಹತಿ. <verse eid="EST 1:13" /><verse number="14" style="v" sid="EST 1:14" />ರಾಜೊ಼ ತೆ ಸ್ಥಾನ್ಪರ ರಾಜಾ಼ನಿ ಸಾನಿದ್ಯಮಾ ಸೆವಕೊ ವರಿ ರಾಜ಼ ಸಭಾನಾ ಮ್ಹೊಟಾ ರ‍್ಹಯಲ ಕರ್ಷೆನಾ, ಶೆತಾರ, ಅದ್ಮಾತ, ತರ್ಷಿಷ, ಮೆರೆಸ, ಮರ್ಸೆನಾ, ಮೆಮೊಕಾನ ಕವಾಲಿಯೊ ಕ್ಹಾತ ಪಾರಸಿಯೊ ವರಿ ಮೆದ್ಯ ದೆಶನಾ ಅದಿಕಾರಿಯೊ ವ್ಹತಾ. <verse eid="EST 1:14" /><verse number="15" style="v" sid="EST 1:15" />ತೆ ಸಮುಯೊಜಿತ ಗ್ಯಾನಿ ಇವ್ನೊನೆ ಕಂಚುಕಿಯೊನಾ ಮುಕಾಂತರ ತಿನೆ ಥಯಲ ರಾಜಾ಼ನಿ ಆಗನ್ಯಾನೆ ಕೈದಿಲಿದ್ಯಾ ಬಗರ ರ‍್ಹಯಲ ವಷ್ಟಿ ರಾಣಿನೆ ನಿಯಮನಾ ಪ್ರಕಾರ ಸು ಕರಾನು ವ್ಹೈ? ಕೈನ ಪುಚ್ಯೊ಼. <verse eid="EST 1:15" /><verse number="16" style="v" sid="EST 1:16" />ತೆಳಾಮಾ ಮೆಮೊಕಾನ ರಾಜಾ಼ನಾ ವರಿ ಸರ್ದಾರೊನಾ ಕ್ಹಾಮೊ, "ವಷ್ಟಿ ರಾಣಿನು ಅಪರಾಧ ರಾಜಾ಼ನಾ ವಿರುದ್ದ ಯಕ್ಕಜ಼ ನ್ಹವೈ. ತಿನಾ ಅದಿಕಾರಿಯೊನೆಬಿ ಅವಮಾನ ಕರಿಸ. <verse eid="EST 1:16" /><verse number="17" style="v" sid="EST 1:17" />ರಾಣಿ ಸು ಕರಿಸ ಕೈನ ಐಕಲ ರಾಜ್ಯನಾ ಕ್ಹಾರಾ ಬಾಕ್ಡಿಯೊನೆ ಗ್ವತ್ತ ಥೈನ ತ್ಯುನಾ ತ್ಯುನಾ ಮಾಟಿಯೊನೆ ತಿರಸ್ಕಾರ ಕರಾನೆ ಕಾರಣ ಥಾವಸ. ತ್ಯುನೆ "ರಾಜೊ಼ ಥಯಲ ಅಹಷ್ವೆರೊಷನ ವಷ್ಟಿ ರಾಣಿನೆ ರಾಜ ಸನ್ನಿಧಿಮಾ ಔ ಕೈನ ಮೊಕಲ್ತಾಮಾ ತೆ ಗೈ ನೈತೊ ಕವಸ. <verse eid="EST 1:17" /><verse number="18" style="v" sid="EST 1:18" />ರಾಣಿ ಕರಲ ಐಕ್ತಾಮಾ ಪಾರಸಿ ವರಿ ಮೆದ್ಯ ಕುಲನಿಯೊ ಬಾಕ್ಡಿಯೊ ಹಮ್ನಾಜ಼ ತೆ ರಾಜಾ಼ನಾ ಕ್ಹಾರಾ ಸರದಾರೊನೆ ಕಸತೊ. ಇಮ್ಮ ಕೆಕ್ಲು ಮಾಟಿ ಬೈಕೊಮಾ ತಿರಸ್ಕಾರ ವರಿ ಶಿಟ್ಟ ಹುಟ್ಟಸ. <verse eid="EST 1:18" /><verse number="19" style="v" sid="EST 1:19" />ರಾಜೊ಼ ವಪ್ಪಾನೊ ರ‍್ಹಯೊಮ ವಷ್ಟಿ ರಾಣಿ ವರಿ ಕೆಳಾಮಾಜ಼ ರಾಜಾ಼ನಿ ಸನ್ನಿಧಿಮಾ ದಿಕ್ಹುಜ಼ ನೈ ಕೈನ ರಾಜ ಆಗನ್ಯಾ ಪ್ರಕಟ ಥೈನ ತೆ ಕೆಳಾಮಾಜ಼ ರದ್ದ ಥೌ ನೈಸೊ ಪಾರಸಿಯೊ ವರಿ ಮೆದ್ಯ ಶಾಸನೊಮಾ ಲಿಖಿತ ರುಪಮಾ ಥಾವಾದೆ; ರಾಜೊ಼ ತಿನಾ ಪಟ್ಟಾನೆ ತಿತಿಬಿ ಜಾಸ್ತಿ ಸುಂದರಿ ರ‍್ಹಯಲ ತಿನೆ ದಿವಾದೆ. <verse eid="EST 1:19" /><verse number="20" style="v" sid="EST 1:20" />ಎ ರಾಜನಿರ್ಣಯ ಘನ್ನು ವಿಸ್ತಾರ ರ‍್ಹಯಲ ತಿನಿ ರಾಜ್ಯಮಾ ಕ್ಹಾರಿ ಬಗಲ ಗ್ವತ್ತ ಥಾತಾಮಾ ಶ್ರೆಷ್ಠೊ, ಕನಿಷ್ಠೊ ಥಯಲ ಕ್ಹಾರಿಯೊ ಬಾಕ್ಡಿಯೊ ತ್ಯುನಾ ತ್ಯುನಾ ಮಾಟಿಯೊನೆ ಮರ್ಯಾದಿ ದಿವಸ" ಕೈನ ಕದ್ಯೊ. <verse eid="EST 1:20" /><verse number="21" style="v" sid="EST 1:21" />ಎ ವಾತ ರಾಜಾ಼ನೆಬಿ, ತಿನಾ ಸರ್ದಾರೊನೆಬಿ ಚೊ಼ಕು ವ್ಹೈ ಕೈನ ದಿಕ್ಹತಾಮಾ ರಾಜೊ಼ ಮೆಮೊಕಾನನಾ ವಾತನಿಂಗತಜ಼಼ ಕರ‍್ಯೊ. <verse eid="EST 1:21" /><verse number="22" style="v" sid="EST 1:22" />ತೆ ಹರಿಯಕ್ಕ ಕುಟುಂಬಮಾ ದಾಣ್ಗೊಜ಼ ಮಾಲಕ ಥೈನ ರ‍್ಹವಸ ವರಿ ತಿನಾಕ್ಹಾತೆ ರ‍್ಹಯಲವಾಲಾ ತಿನಿಯೊ ವಾತೊಜ಼ ಉಪಯೊಗ ಕರು ಕೈನ ಕ್ಹಾರಾ ರಾಜ ಸಂಸ್ಥಾನೊಮಾ ಪತ್ರನಾ ಮುಲಕ ತಿಳಸಾಯೊ. ತೆ ಕಯಾ- ಕಯಾ ಜಾ಼ತನಾ ಮನಕ್ಹೊ ವ್ಹತಾ ತೆ ತೆ ಜಾ಼ತಮಾ ಪತ್ರ ಬರ್ದಾಯೊ.<verse eid="EST 1:22" /></para>
  <chapter eid="EST 1" />
  <chapter number="2" style="c" sid="EST 2" />
  <para style="s">ಎಸ್ತರ ರಾಣಿ ಥಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 2:1" />ಎ ಕ್ಹಾರು ಥಯಲ್ಪರ ರಾಜಾ಼ನಿ ಶಿಟ್ಟ ಛೊಡಿನ ವಷ್ಟಿನೆ, ತೆ ಕರಲ ವರಿ ತಿನಿ ವಿಶಯಮಾ ಕರಲ ಫೈಸಲೊ ಶೆ ಕರ್ಲಿವಾಡ್ಯೊತೊ. <verse eid="EST 2:1" /><verse number="2" style="v" sid="EST 2:2" />ತೆಳಾಮಾ ತಿನಿ ಸೆವೆ ಕರ್ತಾ ರ‍್ಹಯಲ ರಾಜಪರಿವಾರವಾಲಾ ರಾಜಾ಼ನೆ, "ತಾರಾ ಹುತಿ ಸುಂದರ ರ‍್ಹಯಲ ಛೊಕ್ರಿಯೊನೆ ಹುಡ್ಕಾನಾ ಹುತಿ ಹಮೊನೆ ಅಪ್ಪಣೆ ದ್ಯು ಕದ್ಯಾ. <verse eid="EST 2:2" /><verse number="3" style="v" sid="EST 2:3" />ರಾಜೊ಼ ತಿನಿ ರಾಜ್ಯನಾ ಕ್ಹಾರಾ ಸಂಸ್ಥಾನೊಮಾ ಕಾಮ ಕರಾಲಾವೊನೆ ಮೊಕ್ಲು; ತ್ಯುನೆ ಸುಂದರಿ ರ‍್ಹಯಲ ಕ್ಹಾರಿಯೊ ಛೊಕ್ರಿಯೊನೆ ಶುಶನ ಕೊಟೆನಾ ಅಂತಪುರಮಾ ಮಳೈನ, ಅಂತಪುರನಾ ಪಾಲಕ ರಾಜಕಂಚಿಕಿಯೊ ಥಯಲ ಹೆಗೈಯನಾ ವಶಮಾ ದಿವಾದೆ. ತೆ ತ್ಯುನೊನೆ ಕಾಂತಿ ಜಾಸ್ತಿ ಥಾವಾನು ಮಲ್ಲಮ ದ್ರವ್ಯವೊ ವಾಟಾದೆ. <verse eid="EST 2:3" /><verse number="4" style="v" sid="EST 2:4" />ರಾಜೊ಼ ಕೈ ಛೊಕ್ರಿನೆ ಪಸಂದ ಕರಸ ತೆ ಛೊಕ್ರಿ ವಷ್ಟಿನಾ ಬದಲಿ ತೆ ರಾಣಿ ಥಾವಾದೆ" ಕದ್ಯಾ. ರಾಜೊ಼ ತ್ಯುನಾ ವಿಚಾರೊನೆ ಸಮ್ಮತಿ ಕರಿನ ತಿನಾನಿಂಗತಜ಼಼ ಕರ‍್ಯೊ. <verse eid="EST 2:4" /><verse number="5" style="v" sid="EST 2:5" />ಶುಶನ ಕೊಟೆಮಾ ಮೊರ್ದೆಕೈ ಕವಾಲೊ ಯಕ್ಲೊ ಯೆಹುದಿ ಮನಕ್ಹ ರ‍್ಹವಾಡೊತೊ. ಎ ಬೆನ್ಯಾಮಿನನಾ ಕುಲನೊ ಕಿಶನನೊ ಪರನಾತನೊ, ಶಿಮ್ಗಿಯನೊ ನಾತನೊ, ಯಾಯಿರನೊ ದಿಕ್ರೊ ವ್ಹತೊ. <verse eid="EST 2:5" /><verse number="6" style="v" sid="EST 2:6" />ಬಾಬೆಲೊನನೊ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರಕ್ಹು ಯೆಹುದಿ ರಾಜೊ಼ ಥಯಲ ಯೆಹೊಯಾಕಿನನಾ ಕ್ಹಾತೆ ಬಂದಿ ಕರಿನ ನಿಂಗೈಯಲವಾಲಾವೊಮಾ ಎಬಿ ಯಕ್ಲೊ ವ್ಹೈ. <verse eid="EST 2:6" /><verse number="7" style="v" sid="EST 2:7" />ತೆ ಎಸ್ತರ ಕೈನ ನಾಮ ರ‍್ಹಯಲವಾಲಿನೆ ಹದೆಸ್ಸಾ ಕವಾನಾ ತಿನಾ ನ್ಹಾನಾ ಕಾಕಾನಿ ಅನಾಥ ರ‍್ಹಯಲ ದಿಕ್ರಿನೆ ಮಾ ಬಾಪ ಮರಲ ದಿನ್ನತಾ ದಿಕ್ರಿ ವ್ಹೈ ಕೈನ ವಪ್ಪಿಲಿನ ತಿನೆ ರಾಕಾಡ್ಯೊತೊ. ತೆ ಘನ್ನಿ ಸುಂದರಿ ವರಿ ಲಾವಣ್ಯವತಿ ವ್ಹತ್ತಿ. <verse eid="EST 2:7" /><verse number="8" style="v" sid="EST 2:8" />ರಾಜಾ಼ನೊ ಫೈಸಲೊ, ಆಜ್ಞೆ ದಿದಲಲ್ಪರ ಕಾರ್ಯ ನಿರ್ವಾಹಕೊ ಘನ್ನಿಯೊ ಛೊಕ್ರಿಯೊನೆ ಮಳೈನ ಶುಶನ ಕೊಟೆಮಾ ಹೆಗೈನಾ ವಶಮಾ ವಪ್ಸಿನ ದೆತಾಮಾ ಎಸ್ತರ ರಾಜ಼ನಾ ಘರ್ಮಾ ಐನ ಅಂತಪುರ ಪಾಲಕ ಥಯಲ ಹೆಗೈನಾ ಪರಾಂಭರಮಾ ವ್ಹತ್ತಿ. <verse eid="EST 2:8" /><verse number="9" style="v" sid="EST 2:9" />ಹೆಗೈ ತಿನೆ ಪಸಂದ ಕರಿನ ತಿನಿ ಮರ್ಗಾನೆ ಪಾತ್ರ ಥಯಲ ತಿನಾಹುತಿ ತಿನಾ ತಕ್ಕ ಮಲ್ಲಾಮೊ ವರಿ ಅನ್ನ ದಿದ್ಯೊ. ತೆ ತಿನಾಹುತಿ ಕ್ಹಾತ ಸೆವಕಿಯೊನೆ ಇನಿಲಿನ ತಿನೆ ವರಿ ಸೆವಕಿಯೊನೆ ಅಂತಪುರಮಾ ಚೊ಼ಕಿ ಜ಼ಗಾ ಮುಕ್ಯೊತೊ. <verse eid="EST 2:9" /><verse number="10" style="v" sid="EST 2:10" />ಎಸ್ತರ ತೆ ಹೈಜ಼ ಜನಾಂಗವಾಲಿ ವ್ಹೈ ಕೈನ, ಹೈ ಕುಲವಾಲಿ ವ್ಹೈ ಕೈನ ದೆಕಾಡಿನ ದಿದಿ ನೈ. ಮೊರ್ದೆಕೈ ಇಮ್ಮ ಅಪ್ಪಣೆ ದಿದಲ ದೆಕಿನ. <verse eid="EST 2:10" /><verse number="11" style="v" sid="EST 2:11" />ತೆ ತಿನು ಅರಾಮನಾ ಹುತಿ ವರಿ ತೆ ಅಗಿ ಸು ಕರು ಕೈನ ವಿಚಾರ ಕರಾನಾ ಹುತಿ ದಿನ್ನೆಬಿ ಅಂತಹಪುರಮಾ ಪ್ರಾಕಾರನಾ ಕ್ಹಾಮೊ ಪ್ಹರಾಡ್ಯೊತೊ. <verse eid="EST 2:11" /><verse number="12" style="v" sid="EST 2:12" />ಛೊಕ್ರಿಯೊನೆ ಮಲ್ಲಮ ಲಗಾಡಾನು ಪುರಾ ಕರಾನಾ ಹುತಿ ಗಂಧರಸ ಪ್ರಯೊಗಮಾ ಛೆ ಮ್ಹೈನಾ, ಅಮ್ಮತಿಮ್ಮ ಕರಿನ ಬಾರಾ ಮ್ಹೈನಾ ಥಯಾ. ಎ ಟೈಮ ಥಯಲ್ಪರ ರಾಜಾ಼ನಾ ಘರನಾ ನಿಯಮನಾ ನಿಂಗತ ತಿನಾಕ್ಹು ತಿನೆ ತಯ್ಯಾರ ಕರಿಲಿದಲ ಹರಿಯಕ್ಕ ಛೊಕ್ರಿ ಅಹಶ್ಟೆರೊಶ ರಾಜಾ಼ನಾ ಕ್ಹಾಮಾ ಜಾ಼ವಾನು ವ್ಹತ್ತು. <verse eid="EST 2:12" /><verse number="13" style="v" sid="EST 2:13" />ರಾಜಾ಼ನಾ ಕ್ಹಾಮಾ ಜಾ಼ವಾನಿ ಪಾಳಿ ಕಿನಿ ಆವಸ ತೆ ಅಂತಪುರತಿ ರಾಜಾ಼ನಾ ಘರೆ ಲಿನ ಜಾ಼ವಾನಾಹುತಿ ಸು ಪುಚ್ಯಾತಬಿ ದಿವಸ. <verse eid="EST 2:13" /><verse number="14" style="v" sid="EST 2:14" />ತೆ ತ್ಯಾ ಕ್ಹಾಂಜೆ ಗಯಲವಾಲಿ ಮರ್ನಾ ದಿನ್ನೆ ತೆ ಪಾಟೆ ರಾಜಾ಼ನಾ ಬಿಜಿಯೊ ಬೈಕೊನೆ ಪಾಲನೆ ಕರಾಲೊ ಥಯಲ ಶವಷ್ಗರ ಕವಾಲಾನೆ ರಾಜಕಂಚುಕಿನಾ ಹತ್ಮಾ ರ‍್ಹಯಲ ಬೆವಾ ಅಂತಪುರೆ ಆವಸ. ರಾಜೊ಼ ತಿನೆ ಪಸಂದ ಕರಿನ ನಾಮ ಕೈನ ಬಲಾಯೆ ಲಕ್ಕಾ ಯಕ್ಲಿಬಿ ರಾಜಾ಼ಕನ ವರಿ ಪ್ಹರಿನ ಆವಾಜೊ಼ಗು ನ್ಹೊತು. <verse eid="EST 2:14" /><verse number="15" style="v" sid="EST 2:15" />ರಾಜಾ಼ಕನ ಜಾ಼ವಾನೆ ಮೊರ್ದೆಕೈನಿ ದತ್ತ ಪುತ್ರಿ ತಿನೊ ಕಾಕೊ ಥಯಲ ಅಬಿಹೈಲನಿ ದಿಕ್ರಿ ಥಯಲ ಎಸ್ತರೆಳನಿ ಪಾಳಿ ಆತಾಮಾ, ಅಂತಪುರನೊ ಪಾಲಕ ಥಯಲ ಹೆಗೈ ಕವಾಲಿ ರಾಜಕಂಚುಕಿ ನೆಮ್ಸಲನೆಜ಼ ಚೊಡಿನ ತೆ ಬಿಜು಼ ಸುಜ಼ ಪುಚ್ಚಿ ನೈ. ದೆಕಾಲಾ ಕ್ಹಾರುಜ಼ ತಿನೆ ಮೆಚ್ಯಾ. <verse eid="EST 2:15" /><verse number="16" style="v" sid="EST 2:16" />ರಾಜೊ಼ ಥಯಲ ಅಹಷ್ವೆರೊಶನಕನ ತಿನೊ ಅಧಿಕಾರನು ಕ್ಹಾತ್ವಾ ವರಕ್ಹ ದಕ್ಹವಾ ಮ್ಹೈನೊ ಥಯಲ್ಪರ ಪುಶ್ಯಮಾಸಮಾ ತಿನೆ ರಾಜಾ಼ನಾ ಘರ್ಮಾ ಲಾಯಾ. <verse eid="EST 2:16" /><verse number="17" style="v" sid="EST 2:17" />ರಾಜೊ಼ ಕ್ಹಾರಿಯೊಜ಼ ಛೊಕ್ರಿಯೊಮಾ ಎಸ್ತರನೆಜ಼ ಪಸಂದ ಕರ‍್ಯೊ. ಕ್ಹಾರಿಯೊ ಛೊಕ್ರಿಯೊಮಾ ತೆ ತಿನಿ ದಯಾನೆ, ಮಯಾನೆ ಪಾತ್ರ ಥಯಲಹುತಿ ತೆ ರಾಜಮುಕುಟ ತಿನಾ ಮಾತಾಪರ ಮ್ಹೆಲಿನ, ತಿನೆ ವಷ್ಟಿನಾ ಬದಲಿ ರಾಣಿ ಥೈನ ಕರ‍್ಯೊ. <verse eid="EST 2:17" /><verse number="18" style="v" sid="EST 2:18" />ತೆ ತಿನಾ ಕ್ಹಾರಾ ಸರದಾರೊನೆ ವರಿ ಪರಿವಾರವಾಲಾವೊನೆ ಎಸ್ತರನಾಹುತಿ ಖಾವಾನು ಮ್ಹೊಟು ಕರೈನ, ಕ್ಹಾರಾ ಸಂಸ್ಥಾನೊಮಾ ಜೆಲ್ಮಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಛೊಡೈನ ದಾನ ಕರಾಯೊ.<verse eid="EST 2:18" /></para>
  <para style="s">ಮೊರ್ದೆಕೈ ಕೆಟ್ಟ ವಿಚಾರ ಕರಲ</para>
  <para style="p">
    <verse number="19" style="v" sid="EST 2:19" />ಬೆವಾಸಲಾ ಛೊಕ್ರಿಯೊನೆ ಮಳಾತಾಮಾ ಮೊರ್ದಕೈ ರಾಜಾ಼ನಾ ಮಹೆಲನಾ ಮ್ಹೊಟಾ ಬಾಕಲನಾ ಕ್ಹಾಮೊ ಬೈಟ್ಯೊತೊ. <verse eid="EST 2:19" /><verse number="20" style="v" sid="EST 2:20" />ಎಸ್ತರತೊ ಮೊರ್ದೆಕೈ ಪರಾಂಬರಿಕೆನಾ ದಿನ್ನೊಮಾ ರ‍್ಹತಾಮಾ ಕಿಮ್ಮ ತಿಮ್ಮಜ಼ ತೆಳಾಮಾಬಿ ತಿನಿ ಆಜ್ಞೆನೆ ಪಾಲನೆ ಕರಾಲಿ ಥೈನ ಮಿ ಹೈ ಕುಲವಾಲಿ ವ್ಹೈ ಕೈನ, ಹೈ ಜನಾಂಗವಾಲಿ ವ್ಹೈ ಕೈನ ಕಿನೆಜ಼ ದೆಕಾಡಿನ ದಿದಿನೈ. <verse eid="EST 2:20" /><verse number="21" style="v" sid="EST 2:21" />ತೆ ದಿನ್ನೊಮಾ ಮೊರ್ದೆಕೈ ರಾಜಾ಼ನಾ ಮಹೆಲನು ಬಾಕಲ ಕೈದಾಲೊ ಥಯಲ ಬಿಗೆತಾನ ವರಿ ತೆರೆಶ ಕವಾಲ್ಯೊ ಬೆ ಜ಼ನಿಯೊ ರಾಜಕಂಚುಕಿಯೊ ಶಿಟ್ಟ ಥೈನ ರಾಜಾ಼ಪರ ವಿರುದ್ದ ಥೈನ ಮ್ಹೈನಾ ಮ್ಹೈ ವಿಚಾರ ಕರಿಲಿದ್ಯೊತ್ಯೊ. <verse eid="EST 2:21" /><verse number="22" style="v" sid="EST 2:22" />ಎ ಕ್ಹಾರುಜ಼ ಮೊರ್ದೆಕೈನೆ ಗ್ವತ್ತ ಥಾತಾಮಾ ತೆ ಎಸ್ತರ ರಾಣಿಕನ ಕದ್ಯೊ. ತೆ ತಿನು ನಾಮ ರಾಜಾ಼ನೆ ಕೈನ ತೆ ಸಂಗತಿಯೊ ಕದಿ. <verse eid="EST 2:22" /><verse number="23" style="v" sid="EST 2:23" />ವಿಶಯನಾ ಹುತಿ ವಿಚಾರಣೆನಾ ಕವಾನೊ ಟೈಮ ಆತಾಮಾ ತೆ ಕ್ಹರಿಜ಼಼ ವ್ಹೈ ಕೈನ ಗ್ವತ್ತ ಥಯಲಕ್ಹು ತೆ ಭಂಬಿ ಜ಼ನಾವೊನೆ ಪ್ಹಾಸಿನೆ ಘಲಾಯೊ. ತೆ ಸಂಗತಿಯೊ ರಾಜೊ಼ ದಿನ್ನೆ ಬರ್ದಾನಾ ಪುಸ್ತಕಮಾ ದಾಖಲಾ ಥಯು.<verse eid="EST 2:23" /></para>
  <chapter eid="EST 2" />
  <chapter number="3" style="c" sid="EST 3" />
  <para style="s">ಯಹುದಿಯೊನಾ ವಿರುದ್ಧ ಹಾಮಾನನಿ ಪಿಂಗಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 3:1" />ಎ ಥಯಲ್ಪರ ರಾಜೊ಼ ಥಯಲ ಅಹಷ್ಟರೊಷ ಅಗಾಗನಾ ಖಾಂದಾನವಾಲೊ ಹಮ್ಮೆದಾತನೊ ದಿಕ್ರೊ ಥಯಲ ಹಾಮಾನನೆ ಪದವಿ ಹೆಚ್ಕಿ ಕರಿನ, ತಿನೆ ಮ್ಹೊಟಿ ಅದಿಕಾರ ದಿನ, ತಿನಾ ಆಸ್ಥಾನನಾ ಕ್ಹಾರಾ ಸರದಾರೊಮಾ ತಿನೆ ಪಸ್ಟ ಸ್ಥಾನ ದಿದ್ಯೊ. <verse eid="EST 3:1" /><verse number="2" style="v" sid="EST 3:2" />ರಾಜಾ಼ನಾ ಮಹೆಲಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಸೆವಕೊ ಹಾಮಾನನೆ ಉಂದಾ ಗುಡ್ಗಾ ಘಾಲ್ಲಿನ ನಮಸ್ಕಾರ ಕರಾಡಾತಾ; ತೆನೈಸೊ ಮೊರ್ದೆಕೈ ತಿನೆ ಉಂದಾ ಗುಡ್ಗಾ ಘಾಲ್ಲಿನ ನಮಸ್ಕಾರ ಕರ‍್ತೊ ನ್ಹೊತೊ. <verse eid="EST 3:2" /><verse number="3" style="v" sid="EST 3:3" />ಮಹೆಲನಾ ಬಾಕಲ ಕೈದಾಲಾ ಮೊರ್ದೆಕೈನೆ, "ತು ರಾಜಾ಼ನಿ ಆಗನ್ಯಾ ಕಾ ದಾಟಶಿ?” <verse eid="EST 3:3" /><verse number="4" style="v" sid="EST 3:4" />ಕೈನ ದಿನ್ನೆ ತಿನೆ ಹುಶಾರ ಕರ‍್ತಾತಾ. ಮೊರ್ದೆಕೈ ತೆ ಯೆಹುದ್ಯ ವ್ಹೈ ಕವಾನಿ ಹೆಮ್ಮೆ ವರಿ ಮನಕ್ಹನೆ ಉಂದಾ ಗುಡ್ಗಾ ಘಾಲ್ಲಿನ ನಮಸ್ಕಾರ ನೈ ಕರ‍್ತೊ ಕವಾನಿ ತಿನಿ ಹಟಾ ಚಾ಼ಲಸ ಸು ದೆಕೆ ಕೈನ ತ್ಯುನೆ ಹಾಮಾನನೆ ತಿಳ್ಸಾಯಾ.<verse eid="EST 3:4" /></para>
  <para style="s">ಯೆಹುದ್ಯೊನೆ ಖಲಾಸ ಕರು ಕೈನ ರಾಜಾ಼ನಿ ಆಗನ್ಯಾ</para>
  <para style="p">
    <verse number="5" style="v" sid="EST 3:5" />ಮೊರ್ದೆಕೈ ತಿನೆ ಡೊಗ್ಗಿನ ನಮಸ್ಕಾರ ನತ್ತಿ ಕರಾಡೊ ಕವಾನು ತಿಳ್ದಿಲಿದಲ ಹಾಮಾನ ಘನ್ನೊ ಶಿಟ್ಟ ಥಯೊ. <verse eid="EST 3:5" /><verse number="6" style="v" sid="EST 3:6" />ತೆ ಮೊರ್ದೆಕೈನಾ ಯಕ್ಲಾನಾ ಉಪ್ಪರ ಹತ್ತ ಉಚಾಯಮ ಚಾ಼ಲ್ತು ನೈ ಕೈನ, ಎ ಯೆಹುದ್ಯನೊ ವ್ಹೈ ಕೈನ ಐಕಲ್ಪರ ಅಹಷ್ಟೆರೊಷನಾ ರಾಜ್ಯಮಾ ರ‍್ಹಯಲ ಮೊರ್ದೆಕೈನಾ ಕಳಬಳವಾಲಾವೊನೆ ಕದ್ಯಾಮ ಕ್ಹಾರಾ ಯೆಹುದ್ಯವಾಲಾವೊನೆ ಖಲಾಸ ಕರು ಕೈನ ಫೈಸಲೊ ಕರಿಲಿದ್ಯೊ. <verse eid="EST 3:6" /><verse number="7" style="v" sid="EST 3:7" />ರಾಜೊ಼ ಥಯಲ ಅಹಷ್ಟೆರೊಷನಿ ಆಳ್ವಿಕೆನಾ ಬಾರಾವಾ ಮ್ಹೈನೊ ಥಯಲ ಚೈತ್ರಮಾಸಮಾ ಹಾಮಾನನಾ ಕ್ಹಾಮು ಚೊ಼ಕು ಮಾಸ ವರಿ ಚೊ಼ಕು ದಿನ್ನಬಿ ಕಯು ವ್ಹೈ ಕೈನ ತಿಳ್ದಿಲಿವಾನಾ ಹುತಿ "ಪುರ್” ಕದ್ಯಾಮ ಚಿಟಿ ಘಾಲ್ಯಾ. ಚಿಟಿ ಬಾರಾವಾ ಮ್ಹೈನೊ ಥಯಲ ಫಾಲ್ಗುಣಮಾಸನಾ ತೆರಾವಾ ದಿನ್ನೆ ಪಡಿ. <verse eid="EST 3:7" /><verse number="8" style="v" sid="EST 3:8" />ಹಾಮಾನ ರಾಜೊ಼ ಥಯಲ ಅಹಷ್ಟೆರೊಷನೆ, "ತಾರಾ ರಾಜ್ಯನಾ ಕ್ಹಾರಾ ಸಂಸ್ಥಾನನೊಮಾ ಯಕ್ಕ ಜನಾಂಗ ಛೆ; ತೆ ಬಿಜಾ಼ ಜನಾಂಗವಾಲಾವೊನಾ ವಚ್ಮಾ ಫೈಲ್ಯುತಬಿ ಕ್ಹಾರಾವೊತಿ ಬಿಜು಼ಜ಼ ಥೈನ ರ‍್ಹವಸ. ತೆ ಜನಾಂಗೊನಾ ನಿಯಮೊ ಬಿಜಾ಼ ಕ್ಹಾರಾ ಜನಾಂಗೊನಾ ನಿಯಮೊತಿಬಿ ಬಿಜಾ಼ ರ‍್ಹವಸ. ರಾಜಾ಼ನಾ ನಿಯಮೊನೆತೊ ತ್ಯುನೆ ಚಾ಼ಲ್ತಾಜ಼ ನೈ, ರಾಜೊ಼ ತ್ಯುನೊನೆ ಗಪ್ಪಜ಼ ಛೊಡಾನು ಚೊ಼ಕು ನ್ಹವೈ. <verse eid="EST 3:8" /><verse number="9" style="v" sid="EST 3:9" />ರಾಜಾ಼ನಿ ಮರ್ಜಿ ರ‍್ಹೈಮ ತ್ಯುನೊನೆ ಖಲಾಸ ಕರು ಕವಾನಿ ಆಗನ್ಯಾ ಥಾವಾದೆ; ತಿಮ್ಮ ಕರ‍್ಯೊಮ ಮಿ ರಾಜಭಂಡಾರನಾಹುತಿ ದಕ್ಹ ಹಜಾ಼ರ ತಲಾಂತು ( 10 ಹಜಾ಼ರ ರುಪ್ಪಾನಾ ಬಿಲ್ಲಾ ವ್ಯಾಪಾರ ಕರಾಲಾವೊನಾ ಹತ್ಮಾ ದ್ಯುಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EST 3:9" /><verse number="10" style="v" sid="EST 3:10" />ತೆಳಾಮಾ ರಾಜೊ಼ ತಿನಾ ಹತ್ಮಾ ರ‍್ಹಯಲ ಶಿಕ್ಕೊ ರ‍್ಹಯಲ ಇಟ್ಟಿ ಕಾಡಿನ ಅಗಾಗನಾ ಖಾಂದಾನವಾಲಾ ಹಮ್ಮೆದಾತನೊ ದಿಕ್ರೊ ಯೆಹುದ್ಯವಾಲಾವೊನೆ ದ್ವೆಶ ಕರಾಲೊ ಥಯಲ ಹಾಮಾನನೆ ಒಪ್ಸಿನ ದಿದ್ಯೊ. <verse eid="EST 3:10" /><verse number="11" style="v" sid="EST 3:11" />ರಾಜೊ಼ ಹಾಮಾನನೆ ದಿನ, "ತೆ ರುಪ್ಪು ತುಕನಜ಼ ರ‍್ಹವಾದೆ; ತು ತೆ ಮನಕ್ಹೊನೆ ಸು ಚಾ಼ಯೆ ತೆ ಕರಸಕಶಿ” ಕೈನ ಕದ್ಯೊ. <verse eid="EST 3:11" /><verse number="12" style="v" sid="EST 3:12" />ಪಸ್ಟಲ್ಯಾ ಮ್ಹೈನಾನಾ ತೆರಾವಾ ದಿನ್ನಮಾ ರಾಜಲೆಖಕೊ ಮಳಿನ ಔ ಕೈನ ಅಪ್ಪಣೆ ಥಯು. ತ್ಯುನೆ ಹಾಮಾನನಾ ಆಗನ್ಯಾ ನಿಂಗತ ಉಪರಾಜ಼ಾವೊನೆಬಿ, ತೆತೆ ಸಂಸ್ಥಾನೊಮಾ ಅಧಿಕಾರಿಯೊನೆಬಿ, ತೆತೆ ಜನಾಂಗೊನಾ ಅದಿಪತಿಯೊನೆಬಿ ಪತ್ರ ಬರ್ದ್ಯಾ. ತೆತೆ ಸಂಸ್ಥಾನೊನಾ ಲಿಖಾವಟಮಾಬಿ ತೆತೆ ಜನಾಂಗೊನಾ ಭಾಷಾಮಾಬಿ ರ‍್ಹಯಲ ತೆ ಪತ್ರ ರಾಜೊ಼ ಥಯಲ ಅಹಷ್ಟೆರೊಷನಾ ನಾಮಪರ ಲಿಕ್ಯಲ ವ್ಹತ್ತಾ; ತೆ ಕ್ಹಾರಾವೊನೆ ರಾಜಾ಼ನಿ ಇಟ್ಟಿನೊ ಶಿಕ್ಕೊ ಘಾಲ್ಯಾತಾ. <verse eid="EST 3:12" /><verse number="13" style="v" sid="EST 3:13" />ಪತ್ರ ಪೊಸ್ಟಮ್ಯಾನನಾ ಮುಲಕ ಕ್ಹಾರಾ ರಾಜ ಸಂಸ್ಥಾನೊನೆ ವಳಾಯಾ. ತೆ ಕ್ಹಾರಾವೊಮಾ, "ಯಕ್ಕಜ಼ ದಿನ್ಮಾ ಕದ್ಯಾಮ ಬಾರಾವಾ ಮ್ಹೈನೊ ಥಯಲ ಫಾಲ್ಗುಣಮಾಸನಾ ತೆರಾವಾ ದಿನ್ನಮಾ ಪಟ್ಟಾ, ಶಾನಾ, ಬಾಕ್ಡಿಯೊ, ಬಚ್ಚಾ಼ ಕೈನ ದೆಕ್ಯಾಬಗರ ಕ್ಹಾರಾ ಯೆಹುದ್ಯೊನೆ ಖಲಾಸ ಕರೊ, ನಾಶ ಕರೊ, ಜಿಮಿನಪರ ವ್ಹತ್ತಾ ಸು ನೈ ತಿಮ್ಮ ಕರೊ. ತ್ಯುನೊಕನ ರ‍್ಹಯಲ ಕ್ಹಾರು ಕಾಳಿ ಲಿವೊ” ಕೈನ ಲಿಕ್ಕಲ ವ್ಹತ್ತು. <verse eid="EST 3:13" /><verse number="14" style="v" sid="EST 3:14" />ತೆಜ಼ ನೈಸೊ, "ಎ ಪತ್ರನಾ ಯಕ್ಕೆಕ್ಕ ಪೆಪರ ಯಕ್ಕೆಕ ಸಂಸ್ಥಾನಮಾ ರಾಜವಿಧಿ ವ್ಹೈ ಕೈನ ವಳೈನ ಕ್ಹಾರಾ ತೆ ದಿನ್ನಮಾ ತಯ್ಯಾರ ಥಯಲ ನಿಂಗತ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ತಿಳ್ದೆ ನಿಂಗತ ಪ್ರಚಾರ ಕರು” ಕೈನ ಲಿಕ್ಕಲ ವ್ಹತ್ತು. <verse eid="EST 3:14" /><verse number="15" style="v" sid="EST 3:15" />ತೆ ಫೈಸಲೊ ಶುಶನಾ ಮೆಹಲಮಾ ಪ್ರಚಾರ ಥಯಲ ಬರೊಬ್ಬರ ಪೊಸ್ಟಮ್ಯಾನೊ ರಾಜಾ಼ನಿ ಆಗನ್ಯಾ ನಿಂಗತ ಜಲ್ದಿ ಗಯಾ. ರಾಜೊ಼ತಬಿ ಹಾಮಾನನಾ ಕ್ಹಾತೆ ದಾರು ಪಿವಾನೆ ಬೈಟ್ಯೊ. ತ್ಯಾ ಶುಶನಾ ಗಾಮಮಾ ಘಾಲಮೆಲ ಥಯು.<verse eid="EST 3:15" /></para>
  <chapter eid="EST 3" />
  <chapter number="4" style="c" sid="EST 4" />
  <para style="s">ಎಸ್ತರ ಯಹುದಿಯೊನೆ ಮದತ ಕರಾನೆ ವಪ್ಪಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 4:1" />ಮೊರ್ದೆಕೈ ಥಯಲ ಕ್ಹಾರು ಐಕ್ಯಲಪರ ತಿನಾ ವಣ್ಣಾ ಫಾಡಿಲಿನ, ಕೊತ್ಳೊ ಸುತ್ತಿಲಿನ, ರಾಕ ಮಾತಾಪರ ಘಾಲ್ಲಿನ, ಗಾಮನಾ ವಚ್ಮಾ ಜಾ಼ತೊ ಘನ್ನೊ ದುಖಕ್ಹು ರಯೊ. <verse eid="EST 4:1" /><verse number="2" style="v" sid="EST 4:2" />ಕೊತ್ಳೊ ಭಾಂದಿಲಿದಲವಾಲಾ ಮಹೆಲನಾ ಮ್ಹೈ ಜೌ಼ನೈ ಕೈನ ಅಪ್ಪಣೆ ಥೈತಿ. ತಿನಾಹುತಿ ತೆ ಮಹೆಲನಾ ಬಾಕಲನಾ ಕ್ಹಾಮೊ ಆಯೊ. <verse eid="EST 4:2" /><verse number="3" style="v" sid="EST 4:3" />ಕಯಾ-ಕಯಾ ಸಂಸ್ಥಾನೊಮಾ ರಾಜಾ಼ನಿ ಆಗನ್ಯಾ ವರಿ ತಿರ್ಮಾನ ವ್ಹತ್ತು ತ್ಯಾ ಕ್ಹಾರಿ ಜ಼ಗಾ ಯೆಹುದ್ಯೊಮಾ ಘನ್ನು ದುಖ, ಉಪಾಸ, ತ್ರಾಸ ವರಿ ಗೊಳಾಟ ಥಯು. ಘನ್ನಾ ಜ಼ನಾ ಕೊತ್ಳಾ ವಚೈ಼ನ ರಾಕ ಘಾಲ್ಲಿನ ತಿನಾ ಉಪ್ಪರ ಬೆಟ್ಯಾ.<verse eid="EST 4:3" /></para>
  <para style="s">ಎಸ್ತೆರನಿ ಮದದ ಮಾಂಗ್ಯಲ ಮೊರ್ದೆಕೈ</para>
  <para style="p">
    <verse number="4" style="v" sid="EST 4:4" />ಎಸ್ತೆರನಾ ಸೆವಕಿಯೊ ದೆಕಭಾಲ ಕರಾಲ್ಯೊ ರಾಣಿ ಥಯಲ ತಿಕನ ಐನ ಎ ಸುದ್ದಿ ತಿಳ್ಸಾತಾಮಾ ತೆ ಘನ್ನಿ ಕಳವಳ ಥೈನ ಮೊರ್ದೆಕೈನೆ ವಣ್ಣಾ ವಳೈನ, ಕೊತ್ಳೊ ಕಾಡಿಲಿನ, ಆಂ ವಣ್ಣಾ ಘಾಲ್ಲೆ” ಕೆ ಕೈನ ವಳೈ. ತೆನೈಸೊ ತೆ ವಣ್ಣಾ ಲಿದ್ಯೊ ನೈ. <verse eid="EST 4:4" /><verse number="5" style="v" sid="EST 4:5" />ತೆಳಾಮಾ ತೆ ರಾಜಾ಼ಕ್ಹು ತಿನಾ ಸೆವಾನಾಹುತಿ ನೆಮಕ ಕರಲ ಹತಾಕ ಕವಾನಾ ರಾಜ಼ ಕಂಚಕಿನೆ ಬಲೈನ, "ತು ಮೊರ್ದೆಕೈ ಕನ ಗೈನ ಇನೆ ಕಾರಣ ಸು ವ್ಹೈ ಕೈನ ಪುಚ್ಚಿನ ಆ” ಕೈನ ವಳೈ. <verse eid="EST 4:5" /><verse number="6" style="v" sid="EST 4:6" />ಹತಾಕ ಮಹೆಲನಾ ಕ್ಹಾಮೊ ರ‍್ಹವಾನು ಗಾಮನಾ ಅಂಗಳಾ ಕನ ಮೊರ್ದೆಕೈ ಕನ ಗಯೊ. <verse eid="EST 4:6" /><verse number="7" style="v" sid="EST 4:7" />ಮೊರ್ದೆಕೈ ತಿನೆ ಥಯಲ ಕ್ಹಾರು, ಹಾಮಾನ ಯೆಹುದ್ಯೊನೆ ನಾಶ ಕರಾನೆ ರಾಜಭಂಡಾರನೆ ದ್ಯುಸ ಕೈನ ಕದಲ ರುಪ್ಪಾನಾ ದೊಕ್ಡಾ ಅಕ್ಲು ವ್ಹೈ ಕವಾನು ತಿನೆ ಕದ್ಯೊ. <verse eid="EST 4:7" /><verse number="8" style="v" sid="EST 4:8" />ತಿನಾಕ್ಹಾತೆ ತ್ಯುನೊನೆ ಖಲಾಸ ಕರಾನಾಹುತಿ ಶುಶನಮಾ ಥಯಲ ರಾಜಶಾಸನ ಯಕ್ಕ ಕಾಗತ ದಿನ, "ಎ ಎಸ್ತೆರನೆ ದೆಕಾಡಿನ ಕೆ; ವರಿ ತೆ ರಾಜಾ಼ಕನ ಗೈನ ತಿನಿ ಕೃಪಾ ದೆಕಾಡಾನಾಹುತಿ ತಿನಾ ಸನ್ನಿದಿಮಾ ತಿನಾ ಮನಕ್ಹೊನಾಹುತಿ ಮಾಂಗಿಲಿವಾದೆ” ಕೈನ ವಳಾಯೊ. <verse eid="EST 4:8" /><verse number="9" style="v" sid="EST 4:9" />ಹತಾಕ ಫರಿನ ಐನ ಎಸ್ತೆರನೆ ಮೊರ್ದೆಕೈನಾ ವಾತೊ ತಿಳ್ಸಾಯೊ. <verse eid="EST 4:9" /><verse number="10" style="v" sid="EST 4:10" />ಎಸ್ತೆರ ತಿನೆ ವರಿ ಮೊರ್ದೆಕೈಕನ ವಳೈನ, <verse eid="EST 4:10" /><verse number="11" style="v" sid="EST 4:11" />"ರಾಜಾ಼ನೆ ತಿಕನ ಆವಾನೆ ಕದ್ಯೊತೊ ತೆನೈಸೊ ತಿಕನ ಮ್ಹೈನಾ ಪ್ರಕಾರೆ ಜಾ಼ವಾಲಾ ಮರಣ ದಂಡನೆ ಪಾತ್ರ ಥಾವಸ ಕವಾನಿ ಯಕ್ಕಜ಼ ನಿಯಮ ಕ್ಹಾರಾ ಹೆಣ್ಣ ಗಂಡನೆ ಛೆ. ಕಿಕನ ತೆ ತಿನಾ ಸುವರ್ಣ ಲಾಕ್ಡು ವಚಾ಼ವಸ ಕ್ಹಾಲಿ ತ್ಯುನೆ ಜಿವ್ತಾ ರ‍್ಹವಸ ಕವಾನು ರಾಜಾ಼ನಾ ಕ್ಹಾರಾ ಸೆವಕೊನೆ ವರಿ ಸಂಸ್ಥಾನನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಗ್ವತ್ತ ಛೆ. ಮನೆತಬಿ ಮುವತ್ತ ದಿನ್ನತಾ ರಾಜಾ಼ಕನ ಜಾ಼ವಾನೆ ಬಲಾಯಲ ನತ್ತಿ” ಕೈನ ಕದಿ. <verse eid="EST 4:11" /><verse number="12" style="v" sid="EST 4:12" />ಹತಾಕ ಎಸ್ತೆರನಾ ವಾತೊ ಮೊರ್ದೆಕೈನೆ ಕದ್ಯೊ. <verse eid="EST 4:12" /><verse number="13" style="v" sid="EST 4:13" />ತೆ ಎಸ್ತೆರನೆ, "ಕ್ಹಾರಾ ಯೆಹುದ್ಯೊ ನಾಶ ಥಯಾತಬಿ ಮಿ ಯಕ್ಲಿ ರಾಜ಼ ಮಹೆಲಮಾ ರ‍್ಹವಾಕ್ಹು ವಾಚು಼ಸ ಕೈನ ತಿಳ್ದಿಲ್ಯು ನಕೊ. <verse eid="EST 4:13" /><verse number="14" style="v" sid="EST 4:14" />ತು ಹಮ್ನಾ ಗಪ್ಪ ರ‍್ಹೈ ಪಡಿಮ ಬಿಜಿ ಜ಼ಗಾತಿ ಯೆಹುದ್ಯೊನೆ ಸಹಾಯ, ವಿಮೊಚನೆ ಥಾವಸ; ತು ಸುತಬಿ ಮಾರಾ ಬಾನಾ ಘರವಾಲಾವೊನಾ ಕ್ಹಾತೆ ನಾಶ ಥಾಶಿ. ಎನೈಸೊ ತು ಹವಾ ಟೈಮನಾಹುತಿ ಗಾಮೆ ಆಯೊವಸ” ಕೈನ ವಳಾಯೊ. <verse eid="EST 4:14" /><verse number="15" style="v" sid="EST 4:15" />ತೆಳಾಮಾ ಎಸ್ತೆರ ಮೊರ್ದೆಕೈನೆ, "ತು ಗೈನ ಶುಶನಮಾ ಮಳಾನಾ ಯೆಹುದ್ಯೊನೆ ಮಳಾ; <verse eid="EST 4:15" /><verse number="16" style="v" sid="EST 4:16" />ತುಮೆ ಕ್ಹಾರಾ ತನ್ನ ದಿನ್ನ ರಾತ-ಪಾಟ ಅನ್ನ ಪಾನಿ ಛೊಡಿನ ಮಾರಾಹುತಿ ಉಪವಾಸ ಕರೊ; ತಿನಾನಿಂಗತ ಮಿ ಮಾರಿ ಸೆವಕಿನಾ ಕ್ಹಾತೆ ಉಪಾಸ ರ‍್ಹೌಸ. ತೆ ಥಯಲ್ಪರ ಮಿ ನಿಯಮ ದಾಟಿನ ರಾಜಾ಼ಕನ ಜೌ಼ಸ, ಮರಿಮ ಮರುಸ” ಕೈನ ಕದಿ. <verse eid="EST 4:16" /><verse number="17" style="v" sid="EST 4:17" />ಮೊರ್ದೆಕೈ ಪಾಚೊ಼ ಫರಿನ ಎಸ್ತೆರ ಕದಲ ತಿಮ್ಮಜ಼ ಕರ‍್ಯೊ.<verse eid="EST 4:17" /></para>
  <chapter eid="EST 4" />
  <chapter number="5" style="c" sid="EST 5" />
  <para style="s">ಎಸ್ತರಳ ಹಮಾನನೆ ವರಿ ರಾಜಾ಼ನೆ ಖಾವಾನೆ ಬಲಾಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 5:1" />ತನ್ವಾ ದಿನ್ನಮಾ ಎಸ್ತೆರ ರಾಜ಼ವಣ್ಣಾ ಘಾಲ್ಲಿನ ಮಹೆಲನಾ ಮ್ಹೈ ಗೈನ, ರಾಜ಼ಮಂದಿರ ಕ್ಹಾಮಿ ಹುಬ್ರೈ. ರಾಜೊ಼ ತೆ ಮಂದಿರಮಾ ರಾಜ಼ಸಿಂಹಾಸನನಾ ಉಪ್ಪರ ಬಾಕಲನಾ ಕ್ಹಾಮೊ ಬೈಟ್ಯೊತೊ. <verse eid="EST 5:1" /><verse number="2" style="v" sid="EST 5:2" />ತಿನಾ ಪ್ರಕಾರಮಾ ಹುಬ್ರಯಲ ಎಸ್ತೆರ ರಾಣಿನೆ ದೆಕಲ ಬರೊಬ್ಬರ ತಿನಾ ಉಪ್ಪರ ಮರ್ಗಿನ ತಿನಾ ಹತ್ಮಾ ರ‍್ಹಯಲ ಸುವರ್ಣ ಲಾಕ್ಡು ತಿಕನ ಚಾಚ್ಯೊ. ಎಸ್ತೆರ ರಾಜಾ಼ನಾ ನಜಿ಼ಕ ಗೈನ ಲಾಕ್ಡಿನಿ ತುದಿ ಮುಟ್ಟಿ. <verse eid="EST 5:2" /><verse number="3" style="v" sid="EST 5:3" />ತೆಳಾಮಾ ರಾಜೊ಼ ತಿನೆ, "ಎಸ್ತೆರ ರಾಣಿ, ತುನೆ ಸು ಚಾ಼ಯೆ "ತು ಸು ಮಾಂಗಿಲಿವಾನು ಸು ವ್ಹೈ? ಮಾರಿ ಅರ್ಧಿ ರಾಜ್ಯ ಮಾಂಗಿತಬಿ ತುನೆ ದ್ಯುಸ” ಕದ್ಯೊ”. <verse eid="EST 5:3" /><verse number="4" style="v" sid="EST 5:4" />ತೆನಾಹುತಿ ಎಸ್ತೆರ, "ರಾಜ಼ ಮನಸ ಕರ‍್ಯೊಮ ಮಿ ಹಮ್ನಾ ತುಮಾರಾಹುತಿ ತಯ್ಯಾರ ಕರಾಯಲ ಔತಣನೆ ಹಾಮಾನನಾ ಕ್ಹಾತೆ ಆವಾದೆ” ಕೈನ ಕದಿ. <verse eid="EST 5:4" /><verse number="5" style="v" sid="EST 5:5" />ತೆಳಾಮಾಜ಼ ರಾಜೊ಼, "ಎಸ್ತೆರ ಮಾಂಗಿಲಿದ್ಯಲ ಪುರಾ ಕರಾನೆ ಹಮಾನನೆ ಬಲೈಲಿನ ಆವೊ” ಕೈನ ಅಪ್ಪಣೆ ಕರಿನ ಎಸ್ತೆರ ಕರಾಯಲ ಔತಣನೆ ಹಾಮಾನನಾ ಕ್ಹಾತೆ ಗಯೊ. <verse eid="EST 5:5" /><verse number="6" style="v" sid="EST 5:6" />ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ಪಿತಾಮಾ ರಾಜೊ಼ ಫರಿನ ಎಸ್ತೆರನೆ, "ತು ಮಾಂಗಿಲಿವಾನು ಸು ವ್ಹೈ ಕೆ; ತೆ ಪುರಾ ಕರುಸ. ತು ಮಾರಿ ಅರ್ಧಿ ರಾಜ್ಯ ಮಾಂಗಿಲಿದಿತಬಿ ತೆ ತುನೆ ದ್ಯುಸ” ಕದ್ಯೊ. <verse eid="EST 5:6" /><verse number="7" style="v" sid="EST 5:7" />ತಿನಾಹುತಿ ಎಸ್ತೆರ, "ರಾಜೊ಼ ಮಾರಾ ಉಪ್ಪರ ಮರ್ಗಿನ ಮಿ ಮಾಂಗಿಲಿವಾನು ದಿವಾನೆಬಿ ಮಿ ಮಾಂಗಿಲಿದಲ ಪುರಾ ಕರಾನೆಹುತಿ ಮನಸ್ಸ ರ‍್ಹಯಲ ರ‍್ಹಯಮ <verse eid="EST 5:7" /><verse number="8" style="v" sid="EST 5:8" />ಮಿ ತುಮಾರಾಹುತಿ ತಯ್ಯಾರ ಕರಾವಾನು ಔತಣನೆ ವಂತಾಬಿ ಹಾಮಾನನಾ ಕ್ಹಾತೆ ಆವಾದೆ;<verse eid="EST 5:8" /></para>
  <para style="s">ಹಾಮಾನ ಮೊರ್ದೈಕೈನೆ ಮಾರಾನೆ ಮಸ್ಲತ ಕರಲ</para>
  <para style="p">
    <verse number="9" style="v" sid="EST 5:9" />ತೆ ದಿನ್ನ ಹಾಮಾನ ಕ್ಹುಷಿಮಾ ಘರೆ ಜಾ಼ತಾಮಾ ಮೊರ್ದೆಕೈ ತಿನೆ ಭುಚ಼ಕ್ಯಾವಾಚಿ, ತಿನಾ ಕ್ಹಾಮೊ ಉಟ್ಯಾ ಬಗರ ರಾಜ಼ ಮಹೆಲನಾ ಮ್ಹೈನಾ ಬಾಕಲಕನ ಬೈಟಲ ದೆಕಿನ ತಿಪರ ಘನ್ನೊ ಶಿಟ್ಟ ಥಯೊ. <verse eid="EST 5:9" /><verse number="10" style="v" sid="EST 5:10" />ತಿಮ್ಮ ರ‍್ಹೈತಬಿ ತಿನಿ ಶಿಟ್ಟನೆ ಘಟ್ಟ ಧರಿಲಿನ ಘರೆ ಗೈನ ತಿನಾ ಕ್ಹಾರ ದೊಸ್ತೊನೆ ವರಿ ತಿನಿ ಬೈಕೊ ಥಯಲ ಜೆರೆಷನೆ ಬಲಾಯೊ. <verse eid="EST 5:10" /><verse number="11" style="v" sid="EST 5:11" />ತ್ಯುನಾ ಕ್ಹಾಮೊ ತಿನಿ ಕ್ಹಾರಿ ಆಸ್ತಿನೆ, ಬಚ್ಚಾ಼ ರ‍್ಹಯಲ, ರಾಜೊ಼ ತಿನೆ ಸನ್ಮಾನ ಕರಿನ ಕ್ಹಾರಾ ಸರದಾರೊತಿ, ರಾಜನಾ ಸೆವಕೊತಿಬಿ ತಿನೆ ಕ್ಹಾಸ ಸ್ಥಾನ ದಿದ್ಯಲ ಕತೊ, <verse eid="EST 5:11" /><verse number="12" style="v" sid="EST 5:12" />"ಎನೈಸೊ ಎಸ್ತೆರ ರಾಣಿ ತೆ ತಯ್ಯಾರ ಕರಾಯಲ ಔತಣನೆ ರಾಜಾ಼ನಾ ಕ್ಹಾತೆ ಮನೆ ಛೊಡಿನ ಬಿಜಾ಼ ಕಿನೆಜ಼ ಬಲೈನೈ. ವಂತಾಬಿ ರಾಜಾ಼ನಾ ಕ್ಹಾತೆ ಔ ಕೈನ ಮನೆ ಕದಿಸ. <verse eid="EST 5:12" /><verse number="13" style="v" sid="EST 5:13" />ತೆನೈಸೊ ಮೊರ್ದೆಕೈ ಕವಾನಾ ಯೆಹುದ್ಯವಾಲೊ ರಾಜ಼ ಮಹೆಲನಾ ಬಾಕಲಕನ ಮಾರಾ ಡೊಳಾ ಕ್ಹಾಮೊ ಬೈಟಲ ಲಕ್ಕಾ ಎ ಕ್ಹಾರಾವೊಕ್ಹು ಮನೆ ಸಮಾಧಾನ ನೈ ಥಾತು” ಕದ್ಯೊ. <verse eid="EST 5:13" /><verse number="14" style="v" sid="EST 5:14" />ತಿನಾಹುತಿ ತಿನಿ ಬೈಕೊ ಥಯಲ ಜೆರೆಷ ತಿನಾ ಕ್ಹಾರಾ ಕ್ಹಾಸ ರ‍್ಹಯಲವಾಲಾ, "ಐವತ್ತ ಮೊಳಾ ಉಚ್ಚು಼ ಯಕ್ಕ ಖಂಬೊ ತಯ್ಯಾರ ಕರೈನ ವಂತಾ ರಾಜಾ಼ನಾ ಅಪ್ಪಣೆ ಲಿನ ಮೊರ್ದೆಕೈನೆ ತಿಪರ ಘಲೌ; ಪಾಚ಼ಲ್ತೊ ತು ಕ್ಹುಷಿಕ್ಹು ರಾಜಾ಼ನಾ ಕ್ಹಾತೆ ಔತಣನೆ ಜಾ಼ ಸಕಶಿ” ಕೈನ ಕದ್ಯಾ. ಹಾಮಾನ ಎ ವಾತೆ ಮೆಚ್ಚಿನ ಖಂಬೊ ತಯ್ಯಾರ ಕರಾಯೊ.<verse eid="EST 5:14" /></para>
  <chapter eid="EST 5" />
  <chapter number="6" style="c" sid="EST 6" />
  <para style="s">ಮೊರ್ದೆಕೈನೆ ಸನ್ಮಾನ ಕರಲ ರಾಜೊ಼</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 6:1" />ತೆ ರಾತೆ ರಾಜಾ಼ನೆ ನಿಂದರ ಐನೈ; ತಿನಾಹುತಿ ಪೈಲಾನಾ ಘಟನೆ ಥಯಲನಾ ಬುಕ್ಕೊ ಲಿನಾವಾನೆ ಸೆವಕೊನೆ ಅಪ್ಪಣೆ ದಿನ ತಿನೆ ಒದಾಲಗಾಡಾಡೊತೊ. <verse eid="EST 6:1" /><verse number="2" style="v" sid="EST 6:2" />ಅಹಷ್ಟೆರೊಷ ರಾಜಾ಼ನೆ ಖಲಾಸ ಕರು ಕೈನ ಬಾಗಲಕನ ಕೈದಾಲಾ ಬಿಗೆತಾನ ವರಿ ತೆರೆಷ ಕವಾನಾ ಬೆ ರಾಜಕಂಚುಕಿಯೊ ಮ್ಹೈನು ಮ್ಹೈ ಕರಲ ವಿಚಾರನಾ ಸಂಗತಿಯೊ ತೆ ಮೊರ್ದೆಕೈಕ್ಹು ಭಾರು ಆಯಲ ಸಂಗತಿ ವ್ಹೈ ಕೈನ ತಿಮಾ ಲಿಕ್ಕಲ ವ್ಹತ್ತಾ. <verse eid="EST 6:2" /><verse number="3" style="v" sid="EST 6:3" />ತೆಳಾಮಾ ರಾಜೊ಼, "ಇನಾಹುತಿ ಮೊರ್ದೆಕೈನೆ ಕಯು ಸ್ಥಾನಮಾನ ಮಳ್ಯು?” ಕೈನ ಪುಚ್ಚಲ ಟೈಮಮಾ ತಿನಾ ಸೆವಕೊ ಥಯಲ ಪರಿವಾರವಾಲಾ, "ಸು ಮಳ್ಯು ನತ್ತಿ” ಕೈನ ಕದ್ಯಾ. <verse eid="EST 6:3" /><verse number="4" style="v" sid="EST 6:4" />ರಾಜೊ಼, "ಮಹೆಲಮಾ ಕುನ್ನ ಛೆ?” ಕೈನ ಪುಚ್ಯೊ. ತೆಕ್ಲಾಮಾಜ಼ ಹಾಮಾನ ತೆ ತಯ್ಯಾರ ಕರಾಯಲ ಪಾರಸಿನೆ ಮೊರ್ದೆಕೈನೆ ಘಾಲಾನಾಹುತಿ ರಾಜಾ಼ನಿ ಇಜಾಜ಼ತ್ತ ಮಾಂಗಿಲ್ಯು ಕೈನ ಮಹೆಲನಾ ಭಾರಲ್ಯಾ ಮಹೆಲಮಾ ಐನ ಹುಬ್ರಯೊತೊ. <verse eid="EST 6:4" /><verse number="5" style="v" sid="EST 6:5" />ತೆಳಾಮಾ ರಾಜಾ಼ನಾ ಸೆವಕೊ, "ದೆಕ, ಮಹೆಲಮಾ ಹಾಮಾನ ಛೆ” ಕೈನ ಕದ್ಯಾ. ತೆಳಾಮಾ ರಾಜೊ಼, "ತೆ ಮ್ಹೈ ಆವಾದೆ” ಕದ್ಯೊ. <verse eid="EST 6:5" /><verse number="6" style="v" sid="EST 6:6" />ಹಾಮಾನ ಆಯಲ್ಪರ, "ರಾಜೊ಼ ಕಿನೆತಬಿ ಸನ್ಮಾನ ಕರಾನೆ ಮನಸ ರ‍್ಹಯಲ ರ‍್ಹಯಾಮ ತ್ಯವಾನೆ ಸು ಕರು?” ಕೈನ ತಿನೆ ಪುಚ್ಯೊ. <verse eid="EST 6:6" /><verse number="7" style="v" sid="EST 6:7" />ತಿನಾಹುತಿ ಹಾಮಾನ, "ರಾಜೊ಼ ಮನೆ ಛೊಡಿನ ಬಿಜಾ಼ ಕಿನೆಬಿ ಸನ್ಮಾನ ಕರಾನೆ ಮನಸ ಕರ‍್ಯೊಸಸುಕ” ಕೈನ ಕೈಲಿದ್ಯೊ. <verse eid="EST 6:7" /><verse number="8" style="v" sid="EST 6:8" />ತೆ ರಾಜಾ಼ನೆ "ಕಿನೆಬಿ ಸನ್ಮಾನ ಕರಾನೆ ರಾಜಾ಼ನೆ ಮನಸ ರ‍್ಹಯುಮ ತೆ ಘಾಲಿಲಿವಾನಾ ರಾಜಾ಼ನಾ ವಣ್ಣಾ ವರಿ ಸವಾರಿ ಕರಾನೊ ಘೊಡಾನೆ ಲೌ. <verse eid="EST 6:8" /><verse number="9" style="v" sid="EST 6:9" />ತೆ ವಣ್ಣಾ ವರಿ ಘೊಡಾನೆ ಮ್ಹೊಟೊ ರ‍್ಹಯಲ ರಾಜಾ಼ನೆ ಸರದಾರ ರ‍್ಹಯಲ ಯಕ್ಲಾನಾ ಹತ್ಮಾ ದಿನ ರಾಜೊ಼ ಸನ್ಮಾನ ಕರು ಕೈನ ಛೆ ತೆ ದಾಣ್ಗಾನೆ ರಾಜಾ಼ನಾ ವಣ್ಣಾ ಘಲೌ. ತೆ ಥಯಲ್ಪರ ತಿನೆ ತೆ ಘೊಡಾಪರ ಬೆಟಾಡಿನ ಗಾಮನಿ ಒಣಿಯೊಮಾ ಮೆರವಣಗಿ ಕಾಡ್ತಾ ತಿನಾ ಕ್ಹಾಮಾ, ‘ರಾಜೊ಼ ಸನ್ಮಾನ ಕರು ಕವಾಲಾನೆ ಇನಾ ನಿಂಗತಜ಼಼ ವ್ಹೈ’ ಕೈನ ಪ್ರಕಟಣೆ ಕರೌ” ಕೈನ ಕದ್ಯೊ. <verse eid="EST 6:9" /><verse number="10" style="v" sid="EST 6:10" />ತೆಳಾಮಾ ರಾಜೊ಼ ಹಾಮಾನನೆ ತು ಕದಲ ವಣ್ಣಾ ವರಿ ಘೊಡಾನೆ ಭೆಗಿನ ಲೈನ ರಾಜಾ಼ನಾ ಘರನಾ ಬಾಕಲನಾ ಕ್ಹಾಮೊ ಬೈಟಲ ಮೊರ್ದೆಕೈ ಕವಾಲೊ ಯೆಹುದ್ಯನೆ ತಿಮ್ಮಜ಼ ಕರ; ತೆ ಕದಲಮಾ ಕ್ಹಾರು ಯಕ್ಕಬಿ ಛೊಡ್ಯಾವಾಚಿ ಕರು ಕೈನ ಅಪ್ಪಣೆ ದಿದ್ಯೊ. <verse eid="EST 6:10" /><verse number="11" style="v" sid="EST 6:11" />ಹಾಮಾನ ತೆ ವಣ್ಣಾ ವರಿ ಘೊಡೊ ಲೈನ ಮೊರ್ದೆಕೈನೆ ಮಳಿನ ಗಾಮನಿ ಒಣಿಯೊಮಾ ಮೆರವಣಗಿ ಕಡೈನ, ತಿನಾ ಕ್ಹಾಮೊ ರಾಜೊ಼ ಸನ್ಮಾನ ಕರಾನೊ ತರಿಕೊ ಇನಾ ನಿಂಗತಜ಼಼ ವ್ಹೈ” ಕೈನ ಪ್ರಕಟಣೆ ಕರ‍್ಯೊ. <verse eid="EST 6:11" /><verse number="12" style="v" sid="EST 6:12" />ಮೊರ್ದೆಕೈ ಫರಿನ ರಾಜಾ಼ನಾ ಘರನಾ ಬಾಕಲಕನ ಗಯೊ. ಹಾಮಾನತೊ ದುಖಕ್ಹು ಭರಿನ ಮ್ಹೊಡು ಝಾಕಿಲಿನ ಭೆಗಿನಜ಼ ಘರೆ ಗೈನ <verse eid="EST 6:12" /><verse number="13" style="v" sid="EST 6:13" />ತಿನಿ ಬೈಕೊ ಥಯಲ ಜೆರೆಷಕನ ವರಿ ತಿನಾ ಕ್ಹಾರಾ ಬಂದುಬಳಗನಾ ಕ್ಹಾಮೊ ಥಯಲ ಕ್ಹಾರು ಕದ್ಯೊ. ತೆಳಾಮಾ ತಿನಾ ಪಂಡಿತೊ ವರಿ ಬೈಕೊ ತಿನೆ ‘ಕಿನಾ ಕ್ಹಾಮು ತಾರು ಸೊಲ ಥಯು ತೆ ಮನಕ್ಹ ಯೆಹುದ್ಯ ಸಂತಾನವಾಲೊ ರ‍್ಹಯೊಮಜ಼ ತು ಜಿತ್ತತೊಜ಼ ನೈ. ತಿನಾ ಕ್ಹಾಮೊ ಪಡಿನ ತು ಕ್ಹರಿಜ಼಼ ಹಾಳ ಥಾಶಿ’ ಕದ್ಯಾ.<verse eid="EST 6:13" /></para>
  <para style="s">ಹಾಮಾನನೆ ಮರ್ವಾನಿ ಶಿಕ್ಷಾ</para>
  <para style="p">
    <verse number="14" style="v" sid="EST 6:14" />ತ್ಯುನೆ ಹಜುನ ತಿನಾ ಕ್ಹಾತೆ ಬೊಲ್ತಾ ರ‍್ಹತಾಮಾಜ಼ ರಾಜಕಂಚುಕಿಯೊ ಐನ ಎಸ್ತೆರ ಕ್ಹಾವಾನೆ ಅನ್ನ ಕರಲನೆ ಭೆಗಿನ ಔ ಕೈನ ಹಾಮಾನನೆ ಬಲೈಲಿನ ಗಯಾ.<verse eid="EST 6:14" /></para>
  <chapter eid="EST 6" />
  <chapter number="7" style="c" sid="EST 7" />
  <para style="p">
    <verse number="1" style="v" sid="EST 7:1" />ರಾಜೊ಼ ಹಾಮಾನನಾ ಕ್ಹಾತೆ ಎಸ್ತರಳನಾ ಘರೆ ಅನ್ನ ಖಾವಾನಾ ಹುತಿ ಆಯೊ. <verse eid="EST 7:1" /><verse number="2" style="v" sid="EST 7:2" />ತೆ ಎ ಬೆವಾ ದಿನ್ಮಾಬಿ ದ್ರಾಕ್ಷಾರಸ ಪಿತಾಮಾ ರಾಜೊ಼ ಎಸ್ತರಳನೆ, "ಎಸ್ತರಳ ರಾಣಿ, ತಾರಿ ವಿಗನ್ಯಾಪನ ಸು ವೈ ಕೆ; ತೆ ಪುರಾ ಕರುಸ. ತು ಮಾರಿ ರಾಜ್ಯಮಾನೊ ಅರ್ಧೊ ಭಾಗ ಮಾಂಗಿತಬಿ ಮಿ ತುನೆ ದ್ಯುಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="EST 7:2" /><verse number="3" style="v" sid="EST 7:3" />ತೆಳಾಮಾ ಎಸ್ತರಳ ರಾಣಿ, "ರಾಜೊ಼ ಮನೆ ಮರ್ಗಿನ ಧೈರ್ಯ ದಿವಾನೊ ರ‍್ಹಯೊಮ ಮಾರಿ ವಿಜ್ಞಾಪನ ಪ್ರಾಥನಾಮಾ ವಿಚಾರ ಕರಿನ ಮಾರೊ ಜ಼ಲಮ ವರಿ ಮಾರಿ ಜನಾಂಗನೆ ವಚಾ಼ಡು. <verse eid="EST 7:3" /><verse number="4" style="v" sid="EST 7:4" />ಮನಕ್ಹೊ ಹಮೊನೆ ಕತ್ರಿನ ಖಲಾಸ ಕರಿನ, ಹಮಾರಾ ನಾಮೊ ನಿಶಾನೊ ನೈಸೊ ಇಕ್ಕಿಪಾಡ್ಯಾ. ಹಮೊನೆ ಸೆವಕೊ ಸೆವಕಿಯೊ ಥಾವಾನಾಹುತಿ ಗುಲಾಮೊನಿಂಗತ ಇಕ್ಕಲ ರ‍್ಹಯಾಮ ತೆ ತ್ರಾಸನಾ ವಿಷಯಮಾ ರಾಜ಼ನೆ ತ್ರಾಸಮಾ ಘಾಲಾನು ಚೊ಼ಕು ನ್ಹವೈ ಕೈನ ಗಪ್ಪ ರ‍್ಹತಿತಿ” ಕೈನ ಕದಿ. <verse eid="EST 7:4" /><verse number="5" style="v" sid="EST 7:5" />ಅಹಷ್ವೆರೊಶ ರಾಜೊ಼ ಎಸ್ತರ ರಾಣಿನಿ, ಹವಾ ದುಷ್ಕೃತ್ಯಪರ ಮನಸ ಮ್ಹೆಲಲವಾಲು ಕುನ್ನವ್ಹೈ? ತೆ ಕಿಜ್ಗಾ಼ ಛೆ?” ಕೈನ ಪುಚ್ಯೊ. <verse eid="EST 7:5" /><verse number="6" style="v" sid="EST 7:6" />ತೆಳಾಮಾ ತೆ, "ಹಮೊನೆ ತ್ರಾಸ ಕರು ಕೈನ ವರಿ ಹಮಾರೊ ದುಶ್ಮನ ಆ ಕೆಟ್ಟ ಹಾಮಾನಜ಼ ವ್ಹೈ” ಕೈನ ಕದಿ. ಎ ಐಕಿನ ಹಾಮಾನ ರಾಣಿನಾ ಕ್ಹಾಮೊ ಭುಚ್ಕಿ಼ಗಯೊ. <verse eid="EST 7:6" /><verse number="7" style="v" sid="EST 7:7" />ರಾಜೊ಼, ಅಂಗಾರ ಥೈನ ದ್ರಾಕ್ಷಾರಸ ಪಿವಾನು ಛೊಡಿನ ತಿನಾ ಮಹೆಲಮಾ ರ‍್ಹಯಲ ಮಳಾಮಾ ಗಯೊ. ಹಾಮಾನತೊ ರಾಜಾ಼ಕ್ಹು ಮನೆ ಕೆಡ ತಯ್ಯಾರ ಥಯು ಕೈನ ತಿಳ್ದಿನ ಎಸ್ತರಳಕನ್ನ ತಿನೊ ಜ಼ಲಮ ವಚಾ಼ಡ ಕೈನ ಮಾಂಗಿಲೆತೊ ಹುಬ್ರಯೊತೊ. <verse eid="EST 7:7" /><verse number="8" style="v" sid="EST 7:8" />ರಾಜೊ಼ ತಿನಾ ಮಳಾಮಾತೊ ತೆ ದ್ರಾಕ್ಷಾರಕ್ಹ ಪಿವಾನು ಛೊಡಿನ ಗಯಲ ಜ಼ಗಾ ಐನ ಎಸ್ತರಳ ಅರಾಮ ಕರಾನಿ ಜ಼ಗಾಪರ ಹಾಮಾನ ಪಡಲ ದೆಕಿನ, "ಎ ರಾಣಿನಿ ಮರ್ಯಾದಿಜ಼ ಕಾಡು ಕೈನ ವಸೆ ಸು?” ಕದ್ಯೊ. ರಾಜಾ಼ನಾ ಮ್ಹೊಡಾತು ವಾತ ಭಾರಿ ಆತಾಮಾಜ಼ ಸೆವಕೊ ಹಾಮಾನನಾ ಮ್ಹೊಡಾನೆ ಘುಮುಸ ಘಾಲಿನ ಯಳ್ದಿಲಿನ ಗಯಾ.<verse eid="EST 7:8" /></para>
  <para style="s">ಹಾಮಾನನೆ ಫಾಸಿಪರ ಚ಼ಡಾಯಲ</para>
  <para style="p">
    <verse number="9" style="v" sid="EST 7:9" />ತೆಳಾಮಾ ರಾಜಾ಼ನೆ ಸೆವೆ ಕರ್ತಾ ರ‍್ಹಯಲ ಯಕ್ಲೊ ಹರ್ಬೊನ, "ರಾಜಾ಼ನಾ ಜ಼ಲ್ಮನೆ ಸಮಾಚಾರ ಕೈನ ಮೊರ್ದೆಕೈನೆ ಪಾಕ್ಹೊ ಘಾಲಾಹುತಿ ಎ ಐವತ್ತ ಮಾರ ಉಚ್ಚೊ಼ ಖಾಮ ತಯ್ಯಾರ ಕರ್ಯೊಸ. ಕದ್ಯೊ ತೆ ವಾತೆ ರಾಜೊ಼, ತಿಮ್ಮ ರ‍್ಹಯುಮ ಹಾಮಾನನೆ ತಿಪರಜ಼ ಪಾಸಿಪರ ಘಾಲೊ ಕೈನ ಕದ್ಯೊ. <verse eid="EST 7:9" /><verse number="10" style="v" sid="EST 7:10" />ಹಾಮಾನನೆ ಮೊರ್ದೆಕೈನಾ ಹುತಿ ತಯ್ಯಾರ ಕರಲ ಪಾಸಿನಾ ಖಂಬಾಪರಜ಼ ಚ಼ಡಾಯಾ. ಇಮ್ಮ ರಾಜಾ಼ನಿ ಶಿಟ್ಟ ಶಾಂತ ಥೈ.<verse eid="EST 7:10" /></para>
  <chapter eid="EST 7" />
  <chapter number="8" style="c" sid="EST 8" />
  <para style="s">ವಾಚಾ಼ನಾ ಹುತಿ ಯುದ್ದ ಕರಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 8:1" />ತೆ ದಿನ್ನಮಾ ರಾಜೊ಼ ಥಯಲ ಅಹಷ್ವೆರೊಷ ಯಹುದಿಯೊನಾ ವೈರಿ ಥಯಲ ಹಾಮಾನನು ಘರ ಎಸ್ತರ ರಾಣಿನೆ ದಿದ್ಯೊ. ತೆ ಮೂರ್ದೆಕೈನೆಬಿ ತಿನೆಬಿ ರ‍್ಹಯಲ ಸಂಬಂದನೆ ಕದಿ. <verse eid="EST 8:1" /><verse number="2" style="v" sid="EST 8:2" />ತೆಳಾಮಾ ರಾಜೊ಼ ತೆ ಹಾಮನನೆ ದಿದಲ ತಿನೆ ವಚ್ಮಾನಿ ಇಟ್ಟಿನೆ ಮೊರ್ದೆಕೈನೆ ದಿದ್ಯೊ; ಎಸ್ತರಬಿ ಹಾಮನನು ಘರನು ಅಧಿಕಾರ ಕ್ಹಾರು ತಿನೆ ವಪ್ಪಸೈ. <verse eid="EST 8:2" /><verse number="3" style="v" sid="EST 8:3" />ಎಸ್ತರ ವರಿ ರಾಜಾನೆ ಬೊಲಾನಾಹುತಿ ಗೈನ ತಿನಾ ಪಗೊಮಾ ಪಡಿನ ರೊತಿ ಯಹುದ್ಯನಾ ಹಾನಿನಾಹುತಿ ಸೊಚಲ ಕೆಟ್ಟ ವಿಚಾರನೆ, ಆವಾನಾ ತ್ರಾಸೊ ಹುಬ್ರಾಡು” ಕೈನ ಮಾಂಗಿಲಿದಿ. <verse eid="EST 8:3" /><verse number="4" style="v" sid="EST 8:4" />ರಾಜೊ಼ ಸುವರ್ಣ ರಾಜದಂಡ ತಿನಾ ಕ್ಹಾಮೊ ಕರ‍ಲಹುತಿ ತೆ ಉಟಿನ ರಾಜಾ಼ನಾ ಕ್ಹಾಮಿ ಹುಬ್ರೈ. <verse eid="EST 8:4" /><verse number="5" style="v" sid="EST 8:5" />ತೆಳಾಮಾ ಎಸ್ತರ ತಿನೆ, "ರಾಜೊ಼ ಮನೆ ಮರ್ಗಿನ, ಮನೆ ಪಸಂದ ಕರಿನ, ಮಿ ಕವಾನಿಯೊ ಕ್ಹಾರಿಯೊ ವಾತೊ ಚೊ಼ಕಿಯೊ ವ್ಹೈ ಕೈನ ವಪ್ಪಾನೊ ರ‍್ಹಯೊಮ, ರಾಜಾ಼ನಾ ಕ್ಹಾರಿಯೊ ಸಂಸ್ಥಾನೊಮಾ ರ‍್ಹಯಲ ಯಹುದಿಯೊನೆ ಖಲಾಸ ಕರಾನಿ ವಿಶಯಮಾ ಅಗಾಗನ ವಂಶವಾಲೊ, ಹಮ್ಮೆದಾತಾನೊ ದಿಕ್ರೊ ಥಯಲ ಹಾಮಾನನೆ ಬರ್ದಾಯಲ ಪತ್ರನೆ ರದ್ದ ಕರಾವಾನಾ ಹುತಿ ಆಜ್ಞಾಪತ್ರ ಪ್ರಕಟ ಕರು. <verse eid="EST 8:5" /><verse number="6" style="v" sid="EST 8:6" />ಮಾರಾ ಮನಕ್ಹೊನೆ ತ್ರಾಸ ಥಾವಾನು ಮಿ ದೆಕಿನ ಕಿಮ್ಮ ಗಪ್ಪ ರ‍್ಹೌ? ಮಾರಾ ಖಾಂದಾನ ಹಾಳ ಥಾವಾನು ದೆಕಿನ ಕಿಮ್ಮ ಗಪ್ಪ ರ‍್ಹೌ?” ಕೈನ ಮಾಂಗಿಲಿದಿ. <verse eid="EST 8:6" /><verse number="7" style="v" sid="EST 8:7" />ತೆಳಾಮಾ ರಾಜೊ಼ ರಾಣಿ ಎಸ್ತರನೆ ವರಿ ಯೆಹುದ್ದಿ ರ‍್ಹಯಲ ಮೊರ್ದೈಕೈನೆ ಬಿ, "ಹಾಮಾನ ಯೆಹುದ್ದಿಯೊನೆ ವಿರುದ್ದ ಥೈನ ಹತ್ತ ಉಚಾಯಲಹುತಿ ತಿನೆ ಫಾಸಿಪರ ಚ಼ಡಾ, ತಿನೆ ಆಸ್ತಿ ಎಸ್ತರಳನೆ ದಾನ ಕರ‍್ಯೊಸ್ತೊ, ರಾಜಾ಼ನಾ ನಾಮಪರ ಬರ್ದಲ ರಾಜಮುದ್ರೆ ಕಿನೆಜ಼ ರದ್ದ ಕರಾನೆ ಥಾತು ನೈ. <verse eid="EST 8:7" /><verse number="8" style="v" sid="EST 8:8" />ತಿನಾಹುತಿ ಯಹುದ್ದಿಯೊನಾ ವಿಶಯಮಾ ತುಮೊನೆ ಚೊ಼ಕು ದಿಕ್ಹಾನು ರಾಜಾ಼ನಾ ನಾಮಪರ ತುಮೆ ಬರ್ದಾವೊ, ತಿಪರ ರಾಜಾ಼ನು ಶಿಕ್ಕೊ ಮಾರೊ” ಕೈನ ಕದ್ಯೊ. <verse eid="EST 8:8" /><verse number="9" style="v" sid="EST 8:9" />ತೆಳಾಮಾ ರಾಜ಼ಾನಾ ಘರ್ಮಾ ಬರ್ದಾಲಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಬಲಾಯಾ. ತಿವ್ನೆ ಐನ ತನ್ವಾ ಮ್ಹೈನಾಮಾ ರ‍್ಹಯಲ ಜೆಸ್ಠೆ ಮಾಸನಾ ಇಕ್ಹಪರ ತನ್ನ ದಿನ್ಮಾ, ಮೊರ್ದೆಕೈನಾ ಆಗನ್ಯಾ ನಿಂಗತ ಯಹುದಿಯೊನೆ, ಭಾರತತಾ ಕುಶಿನಲಕ್ಕಾ ರ‍್ಹಯಲ ಯಕ್ಹೊನ ಇಕ್ಹಪರ ಕ್ಹಾತ ಸಂಸ್ಥಾನೊನಾ ಉಪರಾಜ಼ಾವೊನೆ, ದೆಶಾದಿಪತಿಯೊನೆ ವರಿ ಅದಿಕಾರಿಯೊನೆ ಪತ್ರ ಬರದ್ಯಾ. ತೆ ಪತ್ರ ತ್ಯುನಾ ತ್ಯುನಾ ಜಾ಼ತಮಾ ವ್ಹತಾ. <verse eid="EST 8:9" /><verse number="10" style="v" sid="EST 8:10" />ಮೊರ್ದೈಕೈ ರಾಜಾ಼ನಾ ನಾಮಪರ ಬರ್ದಲ ತೆ ಪತ್ರನೆ ರಾಜಮುದ್ರೆ ಘಾಲಿನ, ರಾಜಮಹೆಲನಾ ಅಶ್ವಾಲಯಮಾ ಹುಟ್ಟಿನ ಬೆಳದಲ ಘೊಡಾವೊಪರ ಸವಾರಿ ಕರಾಲಾ ಪತ್ರ ದಿವಾಲಾವೊನಾ ಮುಕಾಂತರ ಮೊಕಲ್ಯೊ. <verse eid="EST 8:10" /><verse number="11" style="v" sid="EST 8:11" />ತೆ ಪತ್ರಾಮಾ ರಾಜೊ಼ ಅಹಷ್ವೆರೊಶ ರಾಜಾನಾ ಕ್ಹಾರಿಜ಼ಗಾ ಯಹುದ್ದಿಯೊ ಯಕ್ಕಜ಼ ದಿನ್ಮಾ ಕದ್ಯಾಮ, ಬಾರ್ವಾ ಮ್ಹೈನೊ ಥಯಲ ಫಾಲ್ಗುಣ ಮಾಸಮಾ ತೆರ್ವಾ ದಿನ್ಮಾ ಕ್ಹಾರಾಜ಼ ಮಳು. <verse eid="EST 8:11" /><verse number="12" style="v" sid="EST 8:12" />ತಿವ್ನಾ ಜಲಮನಾ ಹುತಿ ಉಟಿನ ತ್ಯುನಾ ವಿರುದ್ದ ಥೈನ ಉಟಿನ ಆಯುದನಾ ಕ್ಹಾತೆ ಮಳಿನ ಆವಾಲಾ ಕ್ಹಾರಾ ಜನಾಂಗವಾಲಾವೊನೆ, ಸಂಸ್ಥಾನವಾಲಾವೊನೆ ತಿವ್ನಿಯೊ ಬಾಕ್ಡಿಯೊನ ವರಿ ಬಚ್ಚಾ಼ವೊನಾ ಕ್ಹಾತೆಜ಼ ಖಲಾಸ ಕರು. <verse eid="EST 8:12" /><verse number="13" style="v" sid="EST 8:13" />ತಿವ್ನಿ ಆಸ್ತಿ ಹಾಳ ಕರಿಪಾಡು, ಎ ಪತ್ರನಿ ಯಕೆಕ್ಕ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ದ್ಯು. ಎ ದಿನೊಮಾ ತ್ಯುನಿ ಶಿಟ್ಟ ತಿರ್ಶಿಲಿವಾನೆ ತಯ್ಯಾರ ಥೌ. ಕೈನ ಅಪ್ಪಣೆ ದಿದ್ಯೊ. <verse eid="EST 8:13" /><verse number="14" style="v" sid="EST 8:14" />ಆ ರಾಜಾನಿ ಆಗನ್ಯಾ ಶುಶನ ಕೊಟೆಮಾ ಶುರು ಥಾತಾಮಾ ರಾಜ ಮಹಲನಾ ಸವಾರಿನಾ ಘೊಡಾಪರ ಚಡಿನ ಬೈಟಲ ಅಂಚೆವಾಲಾ ರಾಜಾನಾ ಆಗನ್ಯಾಕ್ಹು ಸಿದ್ದ ಥೈನ ಘನ್ನಾ ಜಲ್ದಿ ಗಯಾ. <verse eid="EST 8:14" /><verse number="15" style="v" sid="EST 8:15" />ಮೊರ್ದೆಕೈ ಥೈತಬಿ ನಿಲಿ ಬಿಜಾ ಬಿಜಾ ರಾಜಾನಾ ವಣ್ಣಾ ಘಾಲಿಲಿನ ಕ್ಹೊನಾನಿ ಮ್ಹೊಟಿ ಪಟ್ಟಿ ಮಾತಾನೆ ಭಾಂದಿಲಿನ ಘನ್ನು ಲಾಲ ರ‍್ಹಯಲ ಶಾಲನೆ ವಳ್ಳಿನ ರಾಜಾ ಮಹೆಲತೊ ಗಯೊ ಶುಶನ ಗಾಮಮಾ ಕ್ಹುಶಿನಿ ಆವಾಜ ಐಕೈ. <verse eid="EST 8:15" /><verse number="16" style="v" sid="EST 8:16" />ತ್ಯಾನಾ ಯಹುದ್ಯೊ ಕ್ಹುಶಿನಿ ಪ್ರಬಾವ ಝಿತ್ತಲ ತ್ಯುನೊಪರ ದಿಕ್ಹಾಡ್ಯುತು. <verse eid="EST 8:16" /><verse number="17" style="v" sid="EST 8:17" />ರಾಜಾನಿ ಅನುಮತಿ ಶಾಸನೊ ಕರಲ ಹರಿಯಕ್ಕ ಜ಼ಗಾವೊಮಾಬಿ ಗಾಮೊಮಾಬಿ ರ‍್ಹಯಲ ಯಹುದ್ಯೊನೆ ಚೊಕೊ ದಿನ ಶುರು ಥಯೊ; ತ್ಯುನೆ ಕ್ಹುಶಿಕ್ಹುಬಿ ಉಲ್ಲಾಸಕ್ಹುಬಿ ಭಕ್ಷನೂ ಭೊಜನ ಕರ್ಯಾ. ದೆಶನಾ ಮನಕ್ಹೊಮಾ ಘನ್ನಾ ಜನಾ ಯಹುದ್ಯೊನೆ ಬುಚ್ಕಿನ ತ್ಯುನಾ ಸಂಗನೆ ಸೆರ್xಯಾ.<verse eid="EST 8:17" /></para>
  <chapter eid="EST 8" />
  <chapter number="9" style="c" sid="EST 9" />
  <para style="s">ಯಹುದ್ದಿಯೊಕ್ಹು ದುಶ್ಮನೊನು ಹಾರ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 9:1" />ರಾಜಾ಼ನಿ ಆಗನ್ಯಾನಾ ಫೈಸಲಾವೊನೆ ಪುರಾ ಕರಾನಾ ಪಾಲ್ಗುಣ ಮ್ಹೈನಾನಾ ತೆರ್ವಾ ದಿನ್ನ ಐಯು. ತೆ ದಿನ್ನಮಾ ಯೆಹುದಿಯೊನೆ ಹತೊಟಿಮಾ ಕರಿಲೆಸಕೆಸ ಕೈನ ತ್ಯುನಾ ದುಶ್ಮನೊ ಕೈದಾಡಾತಾ. ತೆನೈಸೊ ತಿನಾ ಬದಲಿ ಯೆಹುದ್ಯೊಜ಼ ತ್ಯುನಾ ದುಶ್ಮನೊನೆ ಹತೊಟಿಮಾ ಕರಿಲಿದ್ಯಾ. <verse eid="EST 9:1" /><verse number="2" style="v" sid="EST 9:2" />ತಿನಾಹುತಿ ರಾಜೊ಼ ಥಯಲ ಅಹಷ್ವೆರೊಶನ ಕ್ಹಾರಿಯೊ ಸಂಸ್ಥಾನೊಮಾ ಕ್ಹಾರಾಜ಼ ಗಾಮೊಮಾ ಯೆಹುದಿಯೊ ತ್ಯುನಾ ಬಗ್ಗೆ ಕೆಟ್ಟ ಕರಲವಾಲಾವೊನೆ ವಿರುದ್ದ ಥೈನ ಹತ್ತ ಉಚಾವಾನೆ ಮಳಿನ ಆತಾಮಾ ಕಿನೆಜ಼ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಹುಬ್ರವಾನೆ ಥಯು ನೈ. <verse eid="EST 9:2" /><verse number="3" style="v" sid="EST 9:3" />ತ್ಯುನೊಕ್ಹು ಕ್ಹಾರಿಜ಼ ಜನಾಂಗನೆ ಭೆ ವಾಟ್ಯು; ಯಕ್ಲುಜ಼ ನೈಸೊ ಮೊರ್ದೆಕೈನಿ ತಾಕತ ಜಾಸ್ತಿ ಥಯಲ ತೆಳಾಮಾ ತಿನಿ ಸುದ್ದಿ ಕ್ಹಾರಿಯೊ ಸಂಸ್ಥಾನೊಮಾ ಪೈಲಿ ಗೈ. <verse eid="EST 9:3" /><verse number="4" style="v" sid="EST 9:4" />ಕ್ಹಾರಿಯೊ ಸಂಸ್ಥಾನೊಮಾ ಉಪರಾಜಾ಼ವೊಮಾ ದೆಶಾದಿಪತಿಯೊಮಾ ವರಿ ಬಿಜಾ಼ ರಾಜಾ಼ವೊಮಾ ತಿನಿಕ್ಹು ಬುಚ್ಕಿನ ಯೆಹುದಿಯೊನ ಮದತ ಕರಾನೆ ಅಗಾ ಆಯಾ. <verse eid="EST 9:4" /><verse number="5" style="v" sid="EST 9:5" />ಇಮ್ಮ ಯೆಹುದಿಯೊ ತ್ಯುನಾ ಕ್ಹಾರಾಜ಼ ದುಶ್ಮನೊನೆ ಹರಾಡಿನ ತಲ್ವಾರುಕ್ಹು ಖಲಾಸ ಕರಿನ ನಾಮೊ ನಿಶಾನೈಸೊ ಕರಿಪಾಡ್ಯಾ. ತ್ಯುನೆ ದುಸ್ಮನೊನೆ ಮನಸ್ಮಾ ಕಿಮ್ಮ ವ್ಹತು ತಿಮ್ಮ ಕರ‍್ಯಾ. <verse eid="EST 9:5" /><verse number="6" style="v" sid="EST 9:6" />ಯಹುದಿಯೊ ಶೊಶೆನ ಕೊಟೆಮಾ ಪಾಂಚ಼ಕ್ಹೊ ಜ಼ನಾವೊನೆ ಖಲಾಸ ಕರ‍್ಯಾ. <verse eid="EST 9:6" /><verse number="7" style="v" sid="EST 9:7" />ಮರಲವಾಲೊವೊಮಾ ದಲ್ಫೊನ, ಅಸ್ಪಾತ, <verse eid="EST 9:7" /><verse number="8" style="v" sid="EST 9:8" />ಪೊರಾತ ಆದಲ್ಯ, ಅರಿದಾತ, <verse eid="EST 9:8" /><verse number="9" style="v" sid="EST 9:9" />ಪರ್ಮಷ್ಟ, ಅರಸೈ, ಅರಿದೈ, ವ್ಯಜಾತ, ಕವಾಲಾ ವ್ಹತಾ. <verse eid="EST 9:9" /><verse number="10" style="v" sid="EST 9:10" />ಇವ್ನೆ ಯಹುದ್ದಿಯೊನೆ ದುಶ್ಮನಿ ಕರ್ತಾ ರ‍್ಹಯಲ ಹಮ್ಮೆದಾತನೊ ದಿಕ್ರೊ ಥಯಲ ಹಾಮಾನ ದಕ್ಹ ದಿಕ್ರಾ. ಇಕ್ಲಾ ಮನ್ಕಹೊನೆ ಖಲಾಸ ಕರ‍್ಯಾ. ಯಹುದ್ದಿಯೊ ಸುಲಿಗೆ ಕರ‍್ಯಾ ನೈ. <verse eid="EST 9:10" /><verse number="11" style="v" sid="EST 9:11" />ತೆ ದಿನ್ನ ಶೊಶನ ಕೊಟೆಮಾ ಮರಲವಾಲಲಾವೊನಿ ಸಂಖ್ಯಾ ರಾಜಾ಼ನೆ ಕದ್ಯಾ. <verse eid="EST 9:11" /><verse number="12" style="v" sid="EST 9:12" />ತೆಳಾಮಾ ರಾಜೊ಼ ಎಸ್ತರ ರಾಣಿನೆ ಯಹುದ್ದಿಯೊ ಶೊಶನ ಕೊಟೆಮಾ ಪಾಂಚ಼ ಕ್ಹೊ ಮನಕ್ಹೊನೆ ಹಾಮಾನನಾ ದಕ್ಹ ದಿಕ್ರಾವೊನೆ ಖಲಾಸ ಕರಿಪಾಡ್ಯಾಸ. ಬಿಜಾ಼ ರಾಜ್ಯ ಸಂಸ್ಥಾನೊಮಾ ಕೆಕ್ಲಾ ಮನಕ್ಹೊ ಮರ‍್ಯಾವಶೆ ತಾರಿ ಮಾಂಗ ವರಿ ಸುಬಿ ವಸೆ ಪುರಾ ಥಾವಸ. ತು ಸುಪಚ್ಚಿತಬಿ ಮಿ ತುನೆ ದ್ಯುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="EST 9:12" /><verse number="13" style="v" sid="EST 9:13" />ತೆ ವಾತೆ ಎಸ್ತರ ರಾಜಾ಼ನೆ ಮನಸ ರ‍್ಹಯುಮ ವ್ಹಂತಾಬಿ ರಾಜಾನಿ ಅಗನ್ಯಾನಿಂಗತ ಹಾಮಾನನಾ ದಕ್ಹೆ ದಿಕ್ರಾವೊನೆ ಫಾಸಿಪರ ಘಾಲಾನೆ ಶುಶನಮಅ ರ‍್ಹಯಲ ಯಹುದ್ದಿಯೊನೆ ಅಪ್ಪಣೆ ಥೌ.ಕೈನ ಮಾಂಗಿಲಿದಿ. <verse eid="EST 9:13" /><verse number="14" style="v" sid="EST 9:14" />ತೆಳಾಮಾ ರಾಜೊ಼ ತಿಮ್ಮ ಕರಾನೆ ಅಪ್ಪಣೆ ದಿದ್ಯೊ. ತೆಳಾಮಾಜ಼ ರಾಯ ಆಗನ್ಯಾ ಹೊರಡಸಾನೆ ವರಿ ಹಾಮಾನನಾ ದಿಕ್ರಾವೊನೆ ಫಾಸಿನೆ ಚ಼ಡಾಯಾ. <verse eid="EST 9:14" /><verse number="15" style="v" sid="EST 9:15" />ಶುಶನನೆ ಯೆದ್ದಿಯೊನೆ ಕ್ಹಾತ್ವಾ ದಿನ್ಮಾ ಮಳಿನೆ ತ್ಯಾ ಬೆಕ್ಹೊ ಮನಕ್ಹೊನೆ ಖಲಾಸ ಕರ‍್ಯಾ. ವರಿ ತ್ಯುನೊಕನು ಸುಜ಼ ಕಾಳ್ಳಿದ್ಯಾ ನೈ. <verse eid="EST 9:15" /><verse number="16" style="v" sid="EST 9:16" />ರಾಜೊ಼ ಥಯಲ ಅಹಷ್ವೆರೊಶನಕನ ತಿನೊ ಅಧಿಕಾರನು ಕ್ಹಾತ್ವಾ ವರಕ್ಹ ದಕ್ಹವಾ ಮ್ಹೈನೊ ಥಯಲ್ಪರ ಪುಶ್ಯ ಮಾಸಮಾ ತಿನೆ ರಾಜಾ಼ನಾ ಘರ್ಮಾ ಬಲೈ ಲಾಯಾ. <verse eid="EST 9:16" /><verse number="17" style="v" sid="EST 9:17" />ರಾಜೊ಼ ಕ್ಹಾರಿಯೊಜ಼ ಛೊಕ್ರಿಯೊಮಾ ಎಸ್ತರನೆಜ಼ ಪಸಂದ ಕರ‍್ಯೊ. ಕ್ಹಾರಿಯೊ ಛೊಕ್ರಿಯೊಮಾ ತೆ ತಿನಿ ದಯಾನೆ, ಮಯಾನೆ ಪಾತ್ರ ಥೈ ಕೈನ ತೆ ರಾಜಮುಕುಟ ತಿನಾ ಮಾತಾಪರ ಮ್ಹೆಲಿನ ತಿನೆ ವಷ್ಟಿನಾ ಬದಲಿ ತಿನೆ ರಾಣಿ ಕರ‍್ಯೊ. <verse eid="EST 9:17" /><verse number="18" style="v" sid="EST 9:18" />ತೆ ಕ್ಹಾರಾ ಸರದಾರೊನೆ ವರಿ ಪರಿವಾರವಾಲಾವೊನೆ ಎಸ್ತರನಾ ಹುತಿ ಖಾವಾನು ಮ್ಹೊಟು ಕರೈನ, ಕ್ಹಾರಿಯೊ ಸಂಸ್ಥಾನೊಮಾ ಜೆಲ್ಮಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಛೊಡೈನ ದಾನಾ ಧರ್ಮ ಕರಾಯೊ. <verse eid="EST 9:18" /><verse number="19" style="v" sid="EST 9:19" />ಬೆವಾಸಲಾ ಛೊಕ್ರಿಯೊನೆ ಮಳಾತಾಮಾ ಮೊರ್ದಕೈ ರಾಜಾನಾ ಮ್ಹೊಟಾ ಬಾಕಲನಾ ಕ್ಹಾಮು ಬೈಟ್ಯೊತೊ. <verse eid="EST 9:19" /><verse number="20" style="v" sid="EST 9:20" />ಎಸ್ತರಳತೊ ಮೊರ್ದೆಕೈ ಪರಾಂಬರಿಕೆನಾ ದಿನೊಮಾ ರ‍್ಹತಾಮಾ ಕಿಮ್ಮ ತಿಮ್ಮಜ಼ ತೆಳಾಮಾಬಿ ತಿನಾ ಆಜ್ಞೆನೆ ಪಾಲನೆ ಕರಾಲಿ ಥೈನ ಮಿ ಹೈ ಕುಲವಾಲಿ ವ್ಹೈ ಕೈನ ಕಿನೆ ದೆಕಾಡಿನೆ ದಿದಿನೈ. <verse eid="EST 9:20" /><verse number="21" style="v" sid="EST 9:21" />ತೆ ದಿನೊಮಾ ಮೊರ್ದೆಕೈ ರಾಜಾ಼ನಾ ಘರನೆ ಬಾಕಲ ಕೈದಾಲೊ ಥಯಲ ಬಿಗೆತಾನ ವರಿ ತೆರೆಶ ಕವಾಲ ಬೆ ಜ಼ನಿಯೊನಾ ಹುತಿ ರಾಜಕಂಚುಕಿಯೊ ಶಿಟ್ಟ ಥೈನ ರಾಜಾ಼ಪರ ವಿರುದ್ದ ಥೈನ ಮ್ಹೈನಾ ಮ್ಹೈ ಪ್ಲ್ಯಾನ ಕರಿಯೊ. <verse eid="EST 9:21" /><verse number="22" style="v" sid="EST 9:22" />ಎ ಕ್ಹಾರುಜ಼ ಮೊರ್ದೆಕೈನೆ ಗ್ವತ್ತ ಥಾತಾಮಾ ತೆ ಎಸ್ತರಳ ರಾಣಿಕನ ಕದ್ಯೊ. ತೆ ತಿನು ನಾಮ ಕೈನ ರಾಜಾ಼ಕನ ಕೈನ ತೆ ಸಂಗತಿಯೊ ಕದಿ. <verse eid="EST 9:22" /><verse number="23" style="v" sid="EST 9:23" />ವಿಶಯನಾ ಹುತಿ ವಿಚಾರಣೆನಾ ಕವಾನೆ ಟೈಮ ಆತಾಮಾ ತೆ ಕ್ಹರಿಜ಼಼ ವ್ಹಯ ಕೈನ ಗ್ವತ್ತ ಥಾತಾಮಾ ತೆ ಭಂಭಿಜ಼ನಾವೊನೆ ಪ್ಹಾಸಿನೆ ಘಲಾಯೊ. ತೆ ಸಂಗತಿಯೊ ರಾಜೊ಼ ದಿನ್ನೆ ಬರ್ದಾನಾ ಪುಸ್ತಕಮಾ ದಾಖಲಾ ಥಯು. <verse eid="EST 9:23" /><verse number="24" style="v" sid="EST 9:24" />ಕ್ಹಾರಾ ಯಹುದಿಯೊನೆ ದ್ವೆಶಕರ್ತೊ ರ‍್ಹಯಲ ಅಗಾಗ ವಂಶವಾಲೊ ಹಮ್ಮೆದಾತನನು ದಿಕ್ರೊ ಥಯಲ ಹಾಮಾನ ಯೆಹುದಿಯೊನೆ ಖಲಾಸ ಕರು ಕೈನ ಫೈಸ್ಲೊ ಕರಿ ಗಲಿಬಿಲಿ ಕರಿನ ಹಾಳಕರಾನಾ ಹುತಿ ಪುರ ಕದ್ಯಾಮ ಘಲಾಯೊತೊ. <verse eid="EST 9:24" /><verse number="25" style="v" sid="EST 9:25" />ಅಕ್ಹಾರು ರಾಜಾ಼ನಾ ಕ್ಹಾಮು ಆತಾಮಾ ತೆ ಅ ಪ್ಲಾನ ತಿನಾ ಮಾತಾರರಜ಼ ಆವಾದೆತಿನೆ ವರಿ ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆ ಫಾಸಿಪರ ಘಾಲು ಕೈನ ಅಪ್ಪಣೆ ದಿನ ಪತ್ರಮಾ ಬರ್ದಾಯೊ. <verse eid="EST 9:25" /><verse number="26" style="v" sid="EST 9:26" />ಆ ಪೊರ ಚಿಟಿ ಕವಾನಾ ಅವಾಜ಼ ಕ್ಹು ತೆ ದಿನೊಮಾ ಪುರಿಮ ಕವಾನು ನಾಮ ಪಡ್ಯು. <verse eid="EST 9:26" /><verse number="27" style="v" sid="EST 9:27" />ಯಹುದಿಯೊ ತೆ ಪತ್ರಮಾ ರ‍್ಹಯಲ ವಾತೊನೆ ತಿನೆ ಸಂಭಂಧ ರ‍್ಹಯಲ ತ್ಯುನೆಜ಼ ಅನುಭವಿಸಲ ವರಿ ತ್ಯುನಾ ಕ್ಹಾತೆ ಥಯಲ ಶೆ ಕರ್ಲಿದ್ಯಾ. <verse eid="EST 9:27" /><verse number="28" style="v" sid="EST 9:28" />ಹರ್ರ ವರಕ್ಹೆ ಅ ಬೆ ದಿನೊಮಾ ತ್ಯುನಾ ಹುತಿ ನಿಯಮನಾ ಪ್ರಕಾರ ಕೆರರಟ್ಟ ಕಾಲಮಾ ಕರು ಕೈನ ತ್ಯುನಾ ಕ್ಹಾತೆ ಮಳಾಲಾ ಎ ದಾಟು ನೈ ಕೈನ ಪದ್ದತ ಥೌ ಕೈನ ಹರ ಹಮೆಶಾ ಕ್ಹಾರಾ ಗೊತ್ರ ಸಂಸ್ಥಾನೊನೆ ಗಾಮಾವಾವೊನೆ ಎ ಪುರಿಮ ಕವಾನು ಸನ್ನ ಯೆಹುದಿಯೊಮಾ ಹುಬ್ರೈಪಡು ನೈ ತಿನಿ ಷೆ ತ್ಯುನಾ ಬಚ್ಚಾ಼ವೊಮಾಬಿ ರ‍್ಹೌ ಕೈನ ವಳಕ ಕರಿಲಿದ್ಯಾ, <verse eid="EST 9:28" /><verse number="29" style="v" sid="EST 9:29" />ಯಕ್ಲುಜ಼ ನೈಸೊ ಅಬಿಹೈಲನಿ ದಿಕ್ರಿ ಥಯಲ ಎಸ್ತರ ರಾಣಿ ಅದಿಕಾರಮಾ ಐ ಪುರಿಮನೆ ಸಂಭಂಫ ರ‍್ಹಯಲ ನಿಯಮನೆ ಘಟ್ಟ ಜರಾನಾ ಹುತಿ ಯೆಹುದಿ ರ‍್ಹಯಲ ಮೊರ್ದಕೈ ಮದತಕ್ಹು ಪತ್ರ ಬರ್ದಿ. <verse eid="EST 9:29" /><verse number="30" style="v" sid="EST 9:30" />ತೆ ಅಹಶ್ವೆರೊಷನ ರಾಜ್ಯನು ಯಕ್ಹೊನಇಕ್ಹಪರ ಕ್ಹಾತ ಸಂಸ್ಥನೊಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಯೆಹುದಿಯೊನೆ ಪತ್ರ ಮೊಕಲ್ಯೊ. <verse eid="EST 9:30" /><verse number="31" style="v" sid="EST 9:31" />ತಿನಿಯೊ ಕ್ಹರಿನಿಯೊ ವಾತೊ ಕ್ಹು ತೆ ಪತ್ರಮಾ ಯೆಹುದಿಯೊ ತ್ಯುನೊಮಾ ವರಿ ತ್ಯುನಾ ಬಚ್ಚಾ಼ವೊಮಾ ಉಪಾಸ ವರಿ ಪ್ರಲಾಪನಾ ದಿನೊಮಾ ಶೆ ಕರಿಲಿವಾನಾ ಹುತಿ ತ್ಯುನೆಜ಼ ಗ್ವತ್ತ ಕರ್ಲಿನ ತಿನಾ ಪ್ರಕಾರ ಪುರಿಮ ದಿನೊ ಮಾರಿ ವರಿ ಯೆಹುದಿ ಥಯಲ ಮೊರ್ದಕೈನಾ ಮನಸ ನಿಂಗತ ಹೆ ವರಕ್ಹೆ ಚು಼ಕ್ಯಾವಾಚಿ ಕರೆಟ್ಟ ಟೈಮ್ಮಾ ಸನ್ನ ಆಚರಣೆ ಕರು ಕೈನ ಬರ್ದಲ ರ‍್ಹೈ. <verse eid="EST 9:31" /><verse number="32" style="v" sid="EST 9:32" />ಎಸ್ತರಳ ತೆ ಅಪ್ಪಣೆ ಪುರಿಮ ಕವಾನು ಸನ್ನ ಸ್ಥಾಪಿತ ಥಯು. ತೆ ಅಪ್ಪಣೆ ಗ್ರಂಥಮಾ ದಾಖಲಾ ಥಯು.<verse eid="EST 9:32" /></para>
  <chapter eid="EST 9" />
  <chapter number="10" style="c" sid="EST 10" />
  <para style="p">
    <verse number="1" style="v" sid="EST 10:1" />ಅಹಷ್ವೆರೊಶ ರಾಜೊ಼ ತಿನಾ ರಾಜ್ಯಮಾ ಸೆರಲ ಕ್ಹಾರಾ ಪ್ರದೆಶನೆ ವರಿ ಸಮುದ್ರ ದ್ವಿಪೊನೆ ಭುಭಾಡೊ ಲಗಾಡ್ಯೊ. <verse eid="EST 10:1" /><verse number="2" style="v" sid="EST 10:2" />ತಿನಿ ತಾಕತ ವರಿ ತಿನಿ ಮ್ಹೊಟಾ ಕಾಮೊ, ತಿನಾ ಅನುಗ್ರಕ್ಹು ಮೊರ್ದೆಕೈನೆ ಮಳಲ ಮ್ಹೊಟುಪನನು ವಿವರೊ ಮೆದ್ಯ ವರಿ ಪಾರಸಿನು ರಾಜ್ಯಕಾಲ ವೃತ್ತಾಂತನಾ ಗ್ರಂಥೊಮಾ ಬರ್ದಲರ‍್ಹವಸ. <verse eid="EST 10:2" /><verse number="3" style="v" sid="EST 10:3" />ಯೆಹುದ್ದಿ ಥಯಲ ಮೊರ್ದೆಕೈತೊ ರಾಜ್ಯಮಾ ರಾಜೊ಼ ಥಯಲ ಅಹೆಷ್ವೆರೊಶನ ಬೆವಾ ಸ್ಥಾನ ವಾಲೊಥಯೊ, ಯೆಹುದ್ದಿಯೊಮಾ ಮರ್ಯಾದಿವಾಲೊ ಥಯಲ, ತಿನಾ ಬಂದುಬಳಗನೆ ಮಯಾನೊ ಥಯೊ, ಸ್ವಂತ ಮನಕ್ಹೊನಾ ಹುತಿ ಚಿಂತಾ ಕರಾಲೊ ವರಿ ಸ್ವಂತ ಖಾಂದಾನವಾಲಾವೊನೆ ಶಾಂತಿನೊ ದುತ ಥಯೊ, ಪ್ರಾಥನಾ ಕರಾಲೊಥಯೊ.<verse eid="EST 10:3" /></para>
  <chapter eid="EST 10" />
</usx>