<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id" />
  <para style="h">ಎಫೆಸ</para>
  <para style="toc3">ಎಫೆಸ</para>
  <para style="toc2">ಎಫೆಸ</para>
  <para style="toc1">ಎಫೆಸವಾಲಾವೊನೆ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="mt2">ಎಫೆಸದವರಿಗೆ ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="mt">1 ಎಫೆಸವಾಲಾವೊನೆ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಎಫೆಸವಾಲಾವೊನೆ ಬರ್ದಲ ಪತ್ರ ಕ್ರಿಸ್ತಕ್ಹು 60 ವರಕ್ಹ ಬರ್ದಲ ವ್ಹೈ. ಕೊಲೆಸ್ಸೆವಾಲಾವೊನೆ ಬರ್ದಲ ಪತ್ರ ಎಜ಼ ಟೈಮ್ಮಾ ಬರ್ದಲ ವ್ಹೈ ಕೈನ ಕವಸ. ಬರ್ದಾಲೊ ತಿನಾಕ್ಹು ತೆ ಅಪೊಸ್ತಲ ಪೌಲಾ ವ್ಹೈಕೈನ ವಳಕ ಪಾಡಿಲಿಸ. (1 ಅದ್ಯಾಯ 1 ವಚನಾ) ಕೊಲಸ್ಸೆಮಾ ರ‍್ಹಯಲ ನಿಂಗತ ವೈಯಕ್ತಿಕ ವಂದನೆ ಎಫೆಸ್ಸೆವಾಲಾವೊನೆ ಬರ್ದಿನ ಪತ್ರಿಕೆಮಾ ದಿಕ್ಹಿನ ಆಯಾವಾಚಿ ರ‍್ಹಯುತಬಿ ಘನ್ನೊ ಅದ್ಯಾಯ ಬರ್ದಲವಾಲಾ ಎ ಪತ್ರ ಪೌಲಾ ಬರ್ದ್ಯೊಸ ಕೈನ ವಪ್ಪಿಲಿವಸ ಇನಾ ಹುತಿ ಎ ಪತ್ರ ತೆ ಪ್ರಾಂತ್ಯಮಾ ಘನ್ನಿಯೊ ಸಭೆನೆ ಫೈಲಾಯಲ ಛೆ. ಪೌಲಾ ಎ ಪತ್ರ ಬರ್ತಾಮಾ ತೆ ಜೆಲ್ಮಾ ವ್ಹತ್ತೊ ಕವಾನುಬಿ ಬರ್ದ್ಯೊಸ. (3. 1 41 ವರಿ 620 ವಚನಾ) ಪೌಲಾ ಎ ಪತ್ರ ಎಫೆಸೆನಾ ಸಭೆನೆ ಮಳಾನೆ ಜಾ಼ತಾಮಾ ತುಕಿಯಾಸನಾ ಮುಲಕ ಮೊಕಲ್ಯೊಸ ( 6 ಅದ್ಯಾಯ 21 ತಿ 22 ವಚನಾ) 1 ಎಫೆಸ್ಸ ಗಾಮ ಯಕ್ಕ ಮ್ಹೊಟು ಗಾಮ ವ್ಹತ್ತು ರೊಮ ಸಾಮ್ರಾಜ್ಯನು ಅಶರ ಎಶ್ಯಾ. ಮೈನರ ಪ್ರಾಂತ್ಯನಿ ರಾಜಧಾನಿ ವ್ಹತಿ. ಎಫೆಸ್ಸೆ ಗಾಮಾ ಗ್ರಿಕ ದಿವಸ್ತಾನ ಅರ್ಥಮಿಸಲ ದೆವಾಲಯ ಥೈನ ಪ್ರಸಿದ್ದ ಥೈತಿ. (ಅಪೊಸ್ತಲ ಕೃತ್ಯ 19 ಅದ್ಯಾಯ 23 ತಿ 31 ವಚಾನಾ ಲಕ್ಕಾ) ಎಫೆಸ ಗಾಮನು ಸಭೆ ಶುರುಥಾತಾಮಾ ಘನ್ನಿ ತಾಕತ ವ್ಹತಿ. ತೆನೈಸೊ ಪಾಚಾ಼ತೊ ಅಂತ್ಯ ಕರಾನು ಟೈಮ ಆಯೊತೊ. (ಪ್ರಕಟಣೆ 2 ಅದ್ಯಾಯ 1 ತಿ 7 ವಚನಾ). 3) ಪೌಲಾ ಬರ್ದಲನಾ ಅರ್ದಾಕ್ಹು ಅರ್ದು ಪತ್ರ ಕ್ಹುದಾ ತಿನಾ ಮನಕ್ಹೊನೆ ಕಿಮ್ಮ ಇನಿಲಿದ್ಯೊ ವರಿ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಮುಲಕ ತ್ಯುನಾ ಪಾಪೊಕ್ಹುಜ಼ ತ್ಯುನೊನೆ ಕಿಮ್ಮ ವಚಾ಼ಡ್ಯೊ ಕವಾನು ತಿಳಸಾವಸ. ತೆ ಸಭೆನೆ ಕ್ರಿಸ್ತನಾ ಅಂಗನೆ ವರಿ ಕ್ರಿಸ್ತನ ತಿನು ಮಾತು ಥಯೊಸ ವರಿ ಕ್ರಿಸ್ತ ಮುಲಾನೊ ದಗ್ಡಾನೆ ಹೊಲ್ಸಸ. ಬೆವಾನಾ ಅರ್ದಾಭಾಗಮಾ ಪೌಲಾ ಕ್ರಿಸ್ತನಿ ಜಿವ್ನಾ ಕಿಮ್ಮ ಜಿವ್ನಾ ಕರು ವಳಕ ಪಾಡಿನೆ ದಿವಸ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io">1 ) ಪೌಲಾ ತಿನು ವಳಕ ಕವಸ ವರಿ ಎಫೆಸೆವಾಲಾವೊನೆ ವಂದನೆ ಕವಸ. <char style="ior"><ref loc="EPH 1:1-2">1:1-2</ref></char></para>
  <para style="io">2 ) ಪಾಚ಼ಲ್ತೊ ತೆ ಕ್ರಿಸ್ತಮಾ ಹುತಿ ಸಭೆ ರ‍್ಹಯಲ ಸಂಭಂದನಾ ಹುತಿ ಕವಸ) <char style="ior"><ref loc="EPH 1:3-3:21">1:3—3:21</ref></char></para>
  <para style="io">3) ಪಾಚ಼ಲ್ತೊ ಪೌಲಾ ವಿಸ್ವಾಶಿಯೊನೆ ಕಿಮ್ಮ ಜಿವ್ನಾ ಕರು ಕವಾನಾ ಹುತಿ ಬರ್ದಸ.</para>
  <para style="ip">4) ಲಾಸ್ಟಮಾ ಪೌಲಾ ದಕ್ಹಿಯೊ ಸಲಹೆ ದಿವಸ.</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />ಕ್ರಿಸ್ತ ಯೆಸುನೊ ಅಪೊಸ್ತಲ ಥಯಲ ಪೌಲಾ ಮಿ ಕ್ಹುದಾನಿ ಆಸನಿಂಗತ ಅಪೊಸ್ತಲ ಥಯೊಸ. ಎಫೆಸ ಗಾಮ್ಮಾ ರ‍್ಹವಾಲಾ ವರಿ ಕ್ರಿಸ್ತ ಯೆಸುಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಲ ಪರಿಶುದ್ಧ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ ಮಿ ಎ ಪತ್ರ ಬರ್ದಾಡ್ಯೊಸ. <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />ಅಪ್ನೊ ಬಾ ಥಯಲ ಕ್ಹುದಾ ವರಿ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತ ತುಮೊನೆ ಮರಗಾ ಶಾಂತಿ ದಿವಾದೆ.<verse eid="EPH 1:2" /></para>
  <para style="s">ಕ್ರಿಸ್ತಮಾ ಆತ್ಮಿಕ ಆಶಿರ್ವಾದ</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನೊ ಕ್ಹುದಾ ಬಾ ಥಯಲವಾಲಾನೆ ಸ್ತೊತ್ರ ಥಾವಾದೆ. ಸ್ವರ್ಗಮಾ ರ‍್ಹವಾನು ಹರ ಯಕ್ಕ ಆಶಿರ್ವಾದ ಕ್ಹುದಾ ಅಪೊನೆ ಕ್ರಿಸ್ತಮಾ ದಿದ್ಯೊಸ. <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />ಜಗತ್ತ ಸೃಷ್ಟಿ ಥಾವಾತಿ ಪೈಲಾಜ಼ ಕ್ಹುದಾ ಅಪೊನೆ ಕ್ರಿಸ್ತಮಾ ಇನಿಲಿದ್ಯೊ. ತಿನಿ ಸನ್ನಿಧಿಮಾ ಅಪೆ ಮಯಾಕ್ಹು ರ‍್ಹೈನ ಪರಿಶುದ್ಧ ನಿರದೊಷಿಯೊ ರ‍್ಹಯಲ ರ‍್ಹೌಕೈನ ತಿನು ಉದ್ದೆಶ ವ್ಹತ್ತು. <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />ಅಪೊಪರ ರ‍್ಹಯಲ ಮಯಾಕ್ಹು ಕ್ರಿಸ್ತ ಯೆಸುನಾ ಮುಲಕ ಅಪೊನೆ ತಿನಾ ಸ್ವಂತ ಬಚ್ಚಾ಼ ಥೈನ ಕರಿಲಿವಾನೆ ತೆ ಪೈಲಾಜ಼ ನಿರಧಾರ ಕರ‍್ಯೊತೊ. ತೆ ತಿನಿ ಚಿತ್ತ ವರಿ ಉದ್ದೆಶ ವ್ಹತ್ತಿ. <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />ಕ್ಹುದಾನಿ ಮರಗಾಕ್ಹು ಥಯಲ ಎ ನಿರಧಾರ ತಿನೆ ಸ್ತೊತ್ರಾ ಥಾವಾನೆ ಕಾರಣ ವ್ಹೈ. ಕ್ಹುದಾ ತೆ ಮರಗಾ ತಿನಾ ಮಯಾನಾ ದಿಕ್ರಾನಾ ಮುಕಾಂತರ ಅಪೊನೆ ಉಪಾರ ಮನಸ್ಸಕ್ಹು ದಿದ್ಯೊಸ. <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />ತಿನಾ ರಗತಕ್ಹು ಅಪೊನೆ ಬಿಡುಗಡೆ ಮಳಿ. ಕ್ಹುದಾನಿ ಮ್ಹೊಟಿ ಮರಗಾಕ್ಹು ಅಪ್ನಾ ಪಾಪೊ ಮಾಫ ಥಯಾ.<verse eid="EPH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 1:8" />ಕ್ಹುದಾ ಅಪೊನೆ ತೆ ಮರಗಾ ಪುರಾಜ಼ ಉದಾರ ಮನಸಕ್ಹು ದೆಕಾಡ್ಯೊ. ಕ್ಹುದಾ ತೆ ದಡೈನ ಮ್ಹೆಲಲ ಪ್ಲಾನ ಅಪೊನೆ ತಿಳಾಸಾನಾ ಮುಕಾಂತರ ಅಪೊನೆ ಪುರಾಜ಼ ಗ್ಯಾನ ತಿಳವಳಿಕಿ ದಿದ್ಯೊ. <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />ಕ್ಹುದಾ ಎ ತಿನಿ ಉದ್ದೆಶಕ್ಹು ಕರ‍್ಯೊ. ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಎ ಪುರಾ ಕರಾನೆ ತೆ ಪ್ಲಾನ ಕರ‍್ಯೊ. <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />ಕಾಲ ಪುರಾ ಥಯಲಪರ ಜಿಮಿನ ವರಿ ಸ್ವರ್ಗಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರುಜ಼ ಕ್ರಿಸ್ತಮಾ ಮಳೈನ ತಿನಿ ಅಧಿನ ಕರು ಕೈನ ಕ್ಹುದಾನಿ ಯೊಜನೆ ವ್ಹತಿ.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />ತೆನೈಸೊ ಅಪೆ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ ಥೈಯೆ ಕೈನ ಕ್ರಿಸ್ತಮಾ ಅಪೊನೆ ಇನಿಲಿದ್ಯಾ. ಅಪೆ ತಿನಾ ಬಚ್ಚಾ಼ ಥೈಯೆಕೈನ ಕ್ಹುದಾ ತಿನಿ ಚಿ಼ತ್ತನಿಂಗತ ಪೈಲಾಜ಼ ಪ್ಲಾನ ಕರ‍್ಯೊತೊ. <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ತಿನಿ ವಿಚಾರ ವರಿ ಆಸನಿಂಗತ ಹರಿಯಕ್ಕ ಕರಾಲೊ ಕ್ಹುದಾಜ಼ ವ್ಹೈ.<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />ಎ ತುಮೊನೆಬಿ ಲಾಗು ಥಾವಸ. ತುಮೆ ಕ್ಹರಿ ಭೊದನೆನಾ ಹುತಿ ಕದ್ಯಾಮ ತುಮಾರಿ ರಕ್ಷಣೆನಾ ಹುತಿ ಸುವಾರ್ತೆನಾ ಹುತಿ ಪುಚ್ತಾ಼ಮಾ ಕ್ರಿಸ್ತಮಾ ಬರೊಕ್ಹೊ ಮ್ಹೆಲೊ. ಕ್ಹುದಾ ತಿನಿ ವಾಗ್ದಾನನಾ ನಿಂಗತ ತುಮೊನೆ ಪವಿತ್ರ ಆತ್ಮಾನೆ ದಿವಾನಾ ಮುಕಾಂತರ ತುಮೊಪರ ತಿನಿ ಖಾಸ ರ‍್ಹಯಲ ಶಿಕ್ಕೊ ಘಾಲ್ಯೊ. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />ಕ್ಹುದಾ ತಿನಾ ಮನಕ್ಹೊ ವಗ್ದಾನ ಕರಲ ಕ್ಹಾರು ಅಪೆ ವ್ಹಂದಿಲಿಯೆಸ ಕವಾನೆ ತೆ ಪವಿತ್ರ ಆತ್ಮಾಜ಼಼ ಕ್ಹಮ ಥೈಸ. ಕ್ಹುದಾ ಕಮೈಲಯಿದಲ ಮನಕ್ಹೊನಿ ಎ ಪುರಾಜ಼ ವಿಮೊಚನೆ ಕರಸ. ಕ್ಹುದಾನಿ ಮಹಿಮಾನೆ ಸ್ತೊತ್ರಾ ಥೌ ಕೈನ ಎ ಕ್ಹಾರಾನು ಉದ್ದೆಶ ಥೈಯುಸ.<verse eid="EPH 1:14" /></para>
  <para style="s">ಪೌಲಾನಿ ಪ್ರಾಥನಾ</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />ಕರ್ತಾ ತಿನಾಹುತಿಜ಼ ಮಾರಿ ಪ್ರಾಥನಾಮಾ ಮಿ ತುಮೊನೆ ಶೆ ಕರಿಲಿನ ತುಮಾರಿ ವಿಷಯಮಾ ಕ್ಹುದಾನೆ ಹಮೆಶಾಬಿ ಸ್ತೊತ್ರ ಕೌಸ ಪ್ರಭು ಥಯಲ ಯೆಸುಮಾ ತುಮೊನೆ ರ‍್ಹಯಲ ಬರೊಕ್ಹಾನಾ ಹುತಿ <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />ವರಿ ಕ್ಹಾರಾ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊಪರ ತುಮೊನೆ ರ‍್ಹಯಲ ಮಯಾನಾ ಹುತಿ ಐಕಲ ದಿನಂತೊಬಿ ಮಿ ತುಮಾರಿ ವಿಷಯಮಾ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರ ಕೌಸ. <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನೆ ಕ್ಹುದಾ ಮಹಿಮಾನೊ ಸ್ವರುಪ ಥಯಲ ಬಾ ಥಯಲವಾಲಾನೆ ಮಿ ಹಮೆಶಾಬಿ ಪ್ರಾಥನಾ ಕರುಸ ಕ್ಹುದಾನಿ ಗ್ಯಾನಕ್ಹು ಕದ್ಯಾಮ ತೆ ತುಮೊನೆ ತಿಳಸಾಯಲ ಗ್ಯಾನಕ್ಹು ತುಮೊನೆ ಗ್ಯಾನಿ ಕರಾನಿ ಆತ್ಮಾ ತೆ ತುಮೊನೆ ದಿವಾದೆ ಕೈನ ಮಿ ಪ್ರಾಥನಾ ಕರುಸ. <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />ತುಮೆ ತುಮಾರಾ ಮನಸ್ಮಾ ಹಜು಼ನ ಹೆಚ್ಕಿ಼ ಗ್ಯಾನ ಆವಾದೆ ಕೈನ ಪ್ರಾಥಾನ ಕರುಸ ಅಪೆ ಕೆಯ್ಯೊ ಆಸ ಹೊಂದಿಲ್ಯು ಕೈನ ಕ್ಹುದಾ ಅಪೊನೆ ಇನಿಲಿದ್ಯೊಸ ಕವಾನು ತೆಳಾಮಾ ತಿಳದಿಲಿವೊಸಿ; ತೆ ತಿನಾ ಪರಿಶುದ್ಧ ಮನಕ್ಹೊನೆ ವಾಗ್ದಾನ ಕರಲ ಆಶಿರ್ವಾದ ಕೆಕ್ಲು ಮ್ಹೊಟು ವ್ಹೈ ಕವಾನು ತಿಳ್ದಿಲಿವೊ. <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />ಬರೊಕ್ಹೊ ಮ್ಹೆಲಾನು ಅಪೊನೆ ಕ್ಹುದಾನಿ ತಾಕತ ಕೆಕ್ಲೊ ಮ್ಹೊಟು ವ್ಹೈ ಕವಾನು ತೆಳಾಮಾ ತುಮೆ ತಿಳದಿಲಿವೊಸಿ. ಕ್ರಿಸ್ತನೆ ಮರಣಮಾತೊ ಜಿವ್ತೊ ಕರಿನ ಉಟಾಡಾನೆ ಕ್ಹುದಾ ಉಪಯೊಗ ಕರಲ ಮ್ಹೊಟಿ ತಾಕತ ತೆಜ಼ ವ್ಹೈ. <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />ಕ್ಹುದಾ ಕ್ರಿಸ್ತನೆ ಸ್ವರಗಾಮಾ ತಿನಾ ಶಿದಾಬಗಲ ಬೈಟಾಡಿಲಿದ್ಯೊ. <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />ಕ್ಹುದಾ ಕ್ರಿಸ್ತನೆ ಕ್ಹಾರಾ ಅದಿಪತಿಯೊತಿಬಿ ಅದಿಕಾರಿಯೊತಿಬಿ ತಾಕತವಾಲಾವೊತಿಬಿ ರಾಜಾ಼ವೊತಿಬಿ ಮ್ಹೊಟೊ ಕರ‍್ಯೊ. ಎ ದುನಿಯಾಮಾ ರ‍್ಹೈನೆಕಾ ಅಗಲ್ಯಾ ದುನಿಯಾಮಾ ರ‍್ಹವಾದೆ ದಿದಲ ಕಯುಬಿ ನಾಮ ರ‍್ಹಯಲವಾಲಾವೊತಿಬಿ ಕ್ರಿಸ್ತ ಮ್ಹೊಟೊ ವ್ಹೈ. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />ಕ್ಹುದಾ ಹರಿ ಯಕ್ಕಪರ ಕ್ರಿಸ್ತನಾ ಅದಿಕಾರಮಾ ದಿದ್ಯೊ. ಸಬೆನಾ ಹುತಿ ಕ್ಹುದಾ ತಿನೆ ಹರಿಯಕ್ಕಪರ ಮ್ಹೊಟೊ ಕರ‍್ಯೊ. <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />ಸಬೆ ಕ್ರಿಸ್ತನು ಅಂಗ ಥಯುಸ. ಸಬೆ ಕ್ರಿಸ್ತಕ್ಹು ಭರಿ ಗೈಯುಸ. ತೆ ಕ್ಹಾರುಜ಼ ಹರಿಯಕ್ಕ ವಿಷಯಮಾ ಪುರಾ ಕರಸ.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">ಮರಣಮಾತೊ ಜಿವ್ನಾಮಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />ಪೈಲಾ ತುಮಾರಿ ಆತ್ಮಿಕ ಜಿವ್ನಾ, ತುಮಾರಾ ಪಾಪೊ ವರಿ ತುಮೆ ಅವಿಧೆಯತೆನಾ ಕಾಮೊಕ್ಹು ಮರಿ ಗಯಾತಾ. <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />ಹೊ, ಪೈಲಾ ತುಮೆ ತೆ ಪಾಪೊಜ಼ ಕರೊಶಿ. ಎ ದುನಿಯಾನಾ ವಾಟೊ ನಿಂಗತ ತುಮೆ ಜಿವ್ನಾ ಕರ‍್ಯಾಸ. ವಾಯು ಮಂಡಲಮಾ ರ‍್ಹವಾನಾ ದುಷ್ಟ ಶಕ್ತಿಯೊನಾ ಅಧಿಪತಿನೆ ತುಮೆ ವಿಧೆಯ ಥಯಾಸ. ಕ್ಹುದಾನೆ ಅವಿಧೆಯ ಥಯಲ ಮನಕ್ಹೊಮಾ ಹಮ್ನಾ ಕಾಮ ಕರಾಲಾಜ಼ ತೆ ಆತ್ಮಾ ವ್ಹೈ. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />ಪೈಲಾ ಅಪೆ ಕ್ಹಾರಾ ತೆ ಮನಕ್ಹೊ ನಿಂಗತ ಜಿವ್ಸಾಡಾತಾ. ಅಂಗನಾ ಅಪ್ನಾ ಆಸೊ ಪುರಾ ಕರಾನೆ ಅಪೆ ಕೊಶಿಶ ಕರಾಡಾತಾ. ಅಪ್ನು ಅಂಗ, ಮನಸ್ಸ ಆಸ ಕರಲ ಕ್ಹಾರು ಅಪೆ ಕರ‍್ಯಾ. ಅಪೆ ದುಷ್ಟ ಮನಕ್ಹೊ ಥಯಾತಾ. ಅಪ್ನಿ ತೆ ಜಿವಿತಕ್ಹು ಅಪೆ ತೆಳಾಮಾಜ಼ ಕ್ಹುದಾನಿ ಶಿಟ್ಟನೆ ಗುರಿ ಥಾವಾನು ವ್ಹತ್ತು. ಅಪೊನೆ ವರಿ ಬಿಜಾ಼ ಮನಕ್ಹೊನೆ ಕಯುಜ಼ ಫರಕಜ಼ ನ್ಹೊತು.<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />ತೆನೈಸೊ ಮರಗಾನೊ ಮಾಲಕ ಥಯಲ ಕ್ಹುದಾ ಅಪೊನೆ ಘನ್ನೊ ಮಯಾ ಕರ‍ಸ ಕೈನ ದೆಕಾಡಿನ ದಿದ್ಯೊಸ <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />ಅಪೆ ಕ್ಹುದಾನೆ ವಿರುದ್ದ ಥೈನ ಕರಲ ಕಾಮೊಕ್ಹು ಆತ್ಮಿಕಮಾ ಮರಲವಾಲಾ ಥಯಾತಾ. ತೆನೈಸೊ ಅಪೊನೆ ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ವಚಾ಼ಡ್ಯೊ. ತುಮೆ ಕ್ಹುದಾನಿ ಕೃಪಾಕ್ಹು ರಕ್ಷಣೆ ವ್ಹಂದಿಲಿದಲವಾಲಾ ಥಯಾಸ. <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />ಕ್ಹುದಾ ಅಪೊನೆ ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ಉಟಾಡಿನ ತಿನಾ ಕ್ಹಾತೆ ಸ್ವರ್ಗಮಾ ಸಿಂಹಾಸನನಾ ಉಪ್ಪರ ಬೈಟಾಡ್ಯೊಸ. ಕ್ರಿಸ್ತ ಯೆಸುಮಾ ರ‍್ಹವಾಲಾ ಅಪ್ನಾ ಹುತಿ ಕ್ಹುದಾ ಎ ಕರ‍್ಯೊ. <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />ಕ್ಹುದಾ ತಿನಾ ಮ್ಹೊಟಿ ಕೃಪಾನೆ ಅಗಲ್ಯಾ ದುನಿಯಾಮಾ ದೆಕಾಡು ಕೈನ ಅಮ ಕರ‍್ಯೊಸ. ಕ್ಹುದಾ ಎ ಕೃಪಾ ತಿನಿ ಮರಗಾಕ್ಹು ಅಪೊನೆ ಕ್ರಿಸ್ತ ಯೆಸುಮಾ ದೆಕಾಡಸ. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />ತಿನಾಹುತಿ ತುಮೆ ಬರೊಕ್ಹಾನಾ ಮುಲಕ ಕ್ಹುದಾನಿ ಕೃಪಾಕ್ಹು ರಕ್ಷಣೆ ವ್ಹಂದಿಲಿದಲವಾಲಾ ಥಯಾಸ. ತೆ ರಕ್ಷಣೆ ತುಮೊಕ್ಹು ಥಯಲ ನ್ಹವ್ಹೈ, ತೆ ಕ್ಹುದಾನು ವರ ವ್ಹೈ. <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />ತುಮೊನೆ ರಕ್ಷಣೆ ಮಳಲ ತುಮಾರಾ ಚೊ಼ಕಾ ಕಾಮೊಕ್ಹು ನ್ಹವೈ. ತಿನಾಹುತಿ ತಿನೆ ತೆಜ಼ ವಚಾ಼ಡಿಲಿದ್ಯೊಸ ಕೈನ ಕುನ್ನಜ಼ ತಾರಿಫ ಕರಿಲಿವಾನೆ ಸಾಧ್ಯ ನತ್ತಿ. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />ಕ್ಹುದಾ ಅಪೊನೆ ಕರಲ ವ್ಹೈ. ಅಪೆ ಚೊ಼ಕಾ ಕಾಮೊ ಕರು ಕೈನ ಕ್ಹುದಾ ಅಪೊನೆ ಕ್ರಿಸ್ತ ಯೆಸುಮಾ ನವಾ ಮನಕ್ಹೊ ಥೈನ ಕರ‍್ಯೊ. ಕ್ಹುದಾ ಅಪ್ನಾ ಹುತಿ ತೆ ಚೊ಼ಕಾ ಕಾಮೊ ಪೈಲಾಜ಼ ವಿಚಾರ ಕರ‍್ಯೊತೊ. ಅಪೆ ತೆ ಚೊ಼ಕ ಕಾಮೊ ಕರ‍್ತಾ ಜಿವ್ನಾ ಕರು ಕೈನ ಕ್ಹುದಾನು ವಿಚಾರ ವ್ಹತ್ತು.<verse eid="EPH 2:10" /></para>
  <para style="s">ಕ್ರಿಸ್ತಮಾ ಕ್ಹಾರಾ ಯಕ್ಕಜ಼ ವ್ಹೈ</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />ತಿನಾಹುತಿ ತುಮೆ ಹುಟ್ಟಲ ತೆಳತಾ ಬಿಜಾ಼ ಮನಕ್ಹೊ ಥಯಾತಾ. ತುಮೊನೆ "ಸುನ್ನತಿ ನೈ ರ‍್ಹಯಲವಾಲಾ" ಕೈನ ಯಹುದ್ಯೊ ಬಲಾವಸ. ತುಮೊನೆ "ಸುನ್ನತಿ ನೈ ರ‍್ಹಯಲವಾಲಾ" ಕೈನ ಬಲಾವಾಲಾ ಯಹುದ್ಯೊ ತ್ಯುನಾ ಹುತಿ "ಸುನ್ನತಿವಾಲಾ" ಕೈನ ಕೈಲಿವಸ. ತ್ಯುನಿ ಸುನ್ನತಿ ಅಂಗಮಾ ಹತೊಕ್ಹು ಕರಲ ರ‍್ಹವಸ. <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />ಪೈಲಾನಾ ಕಾಲ್ಮಾ ತುಮೆ ಕ್ರಿಸ್ತ ನೈಸೊವಾಲಾ ಥಯಾತಾ ಕವಾನು ಶೆ ಕರಿಲಿವೊ. ತುಮೆ ಇಸ್ರೆಲನಾ ಮನಕ್ಹೊ ನ್ಹೊತಾ. ಕ್ಹುದಾ ತಿನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಕರಲ ವಾಗ್ದಾನೊನೆ ಸಂಬಂಧ ರ‍್ಹಯಲ ವಡಂಬಡಿಕೆನೆ ತುಮೆ ವ್ಹಂದಿಲಿದಲ ನ್ಹೊತಾ. ತುಮೊನೆ ಆಸ ನ್ಹೊತಿ ವರಿ ತುಮೆ ಕ್ಹುದಾನೆ ತಿಳ್ದಿಲಿದಲ ನ್ಹೊತಾ. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />ಹೊ, ತುಮೆ ಯಕ್ಕ ಟೈಮಮಾ ಕ್ಹುದಾಕ್ಹು ಘನ್ನಾ ದುರ ವ್ಹತ್ತಾ. ತೆನೈಸೊ ಹಮ್ನಾ ತುಮೆ ಕ್ರಿಸ್ತ ಯೆಸುನಾ ರಗತಕ್ಹು ಕ್ಹುದಾನಾ ನಜ್ದಿಕ ರ‍್ಹಯಲವಾಲಾ ಥಯಾಸ. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />ಕ್ರಿಸ್ತಕ್ಹು ತುಮೊನೆ ಹಮ್ನಾ ಸಮಾದಾನ ಮಳ್ಯುಸ. ಕ್ರಿಸ್ತ ಯಹುದಿಯೊನೆ ಯೆಹುದಿ ನೈಸೊವಾಲಾವೊನೆ ಯಕ್ಕಜ಼ ಜನಾಂಗ ಥೈನ ಕರ‍್ಯೊಸ. ಯಹುದ್ಯೊ ಯಹುದ್ಯೊ ನೈಸೊವಾಲಾ ತ್ಯುನಾ ವಚ್ಮಾ ಯಕ್ಕ ಅಡ್ಡ ಗೊಡಿ ಛೆ ಕೈನ ಬಿಜಾ಼ ಥಯಾತಾ. ತ್ಯುನೆ ಯಕ್ಕನೆ ಯಕ್ಕ ದ್ವೆಶ ಕರ‍್ತಾತಾ. ತೆನೈಸೊ ಕ್ರಿಸ್ತ ತಿನು ಅಂಗಜ಼ ದಿವಾನಾ ಮುಲಕ ದ್ವೆಷ ಕವಾನಿ ಗೊಡಿನೆ ಪಾಡಿ ಪಾಡ್ಯೊ. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />ಯೆಹುದಿಯೊನು ಧರಮಶಾಸ್ತ್ರ ಘನ್ನಾ ಆಗನ್ಯಾ ನಿಯಮೊ ವ್ಹಂದಲ ಛೆ. ತೆನೈಸೊ ಕ್ರಿಸ್ತ ತೆ ಧರಮಶಾಸ್ತ್ರನೆ ಪುರಾ ಕರ‍್ಯೊ. ಯಹುದಿಯೊನೆ ವರಿ ಯೆಹುದಿ ನೈಸೊವಾಲಾವೊನೆ ತಿನಾಮಾ ಯಕ್ಕಜ಼ ಜನಾಂಗ ಕರಿನ ಶಾಂತಿ ಖಾಯಮ ಕರು ಕವಾನುಜ಼ ಕ್ರಿಸ್ತನು ಉದ್ದೆಶ ವ್ಹತ್ತು. <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />ಎ ಭಂಬಿ ಜನಾಂಗೊನಾ ವಚ್ಮಾ ರ‍್ಹಯಲ ದ್ವೆಶ ಕ್ರಿಸ್ತ ಶಿಲುಬಿನಾ ಮುಲಕ ಪುರಾ ಕರ‍್ಯೊ. ಎ ಜನಾಂಗೊ ಯಕ್ಕಜ಼ ಅಂಗ ಥಯಲ್ಪರ ತ್ಯುನೊನೆ ಕ್ಹುದಾ ಕನ ಚ಼ಲೌ ಕವಾನುಜ಼ ಕ್ರಿಸ್ತನು ಆಸ ವ್ಹತ್ತು. ಶಿಲುಬಿ ಪರ ಜ಼ಲಮ ದಿವಾನಾ ಮುಲಕ ಕ್ರಿಸ್ತ ತಿನಿ ಎ ಆಸ ಪುರಾ ಕರ‍್ಯೊ. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />ಕ್ಹುದಾಕ್ಹು ದುರ ಥಯಲ ತುಮೊಕನಬಿ ನಜ್ದಿಕ ರ‍್ಹಯಲವಾಲಾವೊಕನಬಿ ಕ್ರಿಸ್ತ ಐನ ಸಮಾಧಾನನಾ ಹುತಿ ಉಪದೆಶ ಕರ‍್ಯೊ. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />ಹೊ, ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಅಪೆ ಕ್ಹಾರಾ ಯಕ್ಲಾನಾ ಆತ್ಮಾಕ್ಹು ಅಪ್ನೊ ಬಾ ಥಯಲ ಕ್ಹುದಾ ಕನ ಆವಾನೆ ಶಕ್ತ ಥಯಾಸ.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />ತಿನಾಹುತಿ ಯಹುದ್ಯೊ ನೈಸೊವಾಲಾ ಥಯಲ ತುಮೆ ಹಮ್ನಾ ಭಾರಲ್ಯಾ ದೆಶವಾಲಾ ನ್ಹವ್ಹೈ ವರಿ ಬಿಜಾ಼ ಮನಕ್ಹೊ ನ್ಹವ್ಹೈ. ಹಮ್ನಾ ತುಮೆ ಕ್ಹುದಾನಾ ಪರಿಶುದ್ಧ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಮನಕ್ಹೊ ಥಯಾಸ. ತುಮೆ ಕ್ಹುದಾನಾ ಘರದಾನನೆ ಮಳಲವಾಲಾ ಥಯಾಸ. <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />ವಿಶ್ವಾಸಿಯೊ ಥಯಲ ತುಮೆ ಕ್ಹುದಾನು ಸ್ವಂತ ಘರ ಥಯಾಸ. ಅಪೊಸ್ತಲೊ ಪ್ರವಾದಿಯೊ ಕವಾನಿ ಫಾಯಾನಾ ಉಪ್ಪರ ತೆ ಘರ ಭಾಂದಲ ಛೆ. ಕ್ರಿಸ್ತಜ಼ ತೆ ಘರನೊ ಮುಲಾಮಾನೊ ದಗ್ಡೊ ಥಯೊಸ. <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />ಪುರಾ ಘರಜ಼ ಕ್ರಿಸ್ತಮಾ ಯಕ್ಕ ಥೈನ ಛೆ. ಕ್ರಿಸ್ತಜ಼ ತೆ ಬೆಳಸಿನ ಪ್ರಭುಮಾ ಪರಿಶುದ್ಧ ಥಯಲ ದೆವಾಲಯ ಕರಸ. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />ತುಮೆ ಕ್ರಿಸ್ತಮಾ ಬಿಜಾ಼ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ (ಯೆಹುದಿಯೊನಾ ಕ್ಹಾತೆ) ಭಂದಾವಾಡಾಸ. ಕ್ಹುದಾ ತಿನಿ ಆತ್ಮಾನಾ ಮುಲಕ ರ‍್ಹವಾ ವರಕ್ಹು ರ‍್ಹವಾನಿ ಜ಼ಗಾ ಥೈನ ರ‍್ಹವಾಡಾಸ.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">ಯಹುದ್ಯೊ ನೈಸೊವಾಲಾವೊನೆ ಪೌಲಾನಿ ಸೆವೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />ಪೌಲಾ ಕವಾಲೊ ಮಿ ಕ್ರಿಸ್ತ ಯೆಸುನೊ ಸೆರೆ ಆಳ ವ್ಹೈ. ಯಹುದ್ಯೊ ನೈಸೊ ತುಮಾರಾ ಹುತಿ ಮಿ ಸೆರೆ ಆಳ ಥಯೊಸ. <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />ಕ್ಹುದಾ ತಿನಿ ಕೃಪಾನಾ ಮುಲಕ ಮನೆ ಎ ಕಾಮ ದಿದ್ಯೊಸ ಕವಾನು ತುಮೊನೆ ಕ್ಹರಿಬಿ ಗ್ವತ್ತ ಛೆ. ತುಮೊನೆ ಮದತ ಕರಾನೆ ಕ್ಹುದಾ ಎ ಕಾಮ ಮನೆ ದಿದ್ಯೊ. <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />ಕ್ಹುದಾ ತಿನಾ ದಡಿ ರ‍್ಹಯಲ ವಿಚಾರ ಮನೆ ತಿಳಸಾಯೊ ವರಿ ದೆಕಾಡ್ಯೊ. ಇನಾ ಹುತಿ ಮಿ ತೆಳಾಮಾಜ಼ ತುಮೊನೆ ದಕ್ಹು ಬರ್ದ್ಯೊಸ. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />ಮಿ ಬರ್ದಲ ಎ ಸಂಗತಿಯೊ ತುಮೆ ಒದಲ ರ‍್ಹಯಾಮ ಕ್ರಿಸ್ತನು ದಡಿ ರ‍್ಹಯಲ ಕ್ಹರಿನೆ ಮಿ ಕ್ಹರಿಬಿ ತಿಳದಿಲಿದ್ಯೊಸ ಕವಾನು ತುಮೊನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />ಪಾಚ಼ಲ್ಯಾ ಕಾಲಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ತೆ ದಡಿನೆ ರ‍್ಹಯಲ ಕ್ಹರಿನೆ ತೆ ತಿಳಸಾಯೊ ನೈ. ಹಮ್ನಾ ತುಬಿ ಕ್ಹುದಾ ತಿನಿ ಆತ್ಮಾನಾ ಮುಲಕ ತೆ ದಡಿನ ರ‍್ಹಯಲ ಕ್ಹರಿನೆ ತಿನಿ ಪರಿಶುದ್ಧ ಅಪೊಸ್ತಲೊನೆಬಿ ಪ್ರವಾದಿಯೊನೆಬಿ ದೆಕಾಡ್ಯೊಸ. <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />ಎ ತೆ ದಡಿನೆ ರ‍್ಹಯಲ ಕ್ಹರಿ; ಯಹುದ್ಯೊ ನೈಸೊವಾಲಾ ಸುವಾರ್ತೆನಾ ಮುಲಕ ಕ್ರಿಸ್ತ ಯೆಸುಮಾ ರ‍್ಹವಾಲಾ ಥೈನ ಯೆಹುದಿಯೊನಾ ಕ್ಹಾತೆ ಯಕ್ಕಜ಼ ಅಂಗ ರ‍್ಹಯಲವಾಲಾ ವಾಗ್ದಾನಮಾ ಪಾಲ ಲಿವಾಲಾ ಥಯಾಸ.<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />ಕ್ಹುದಾ ದಿದಲ ಖಾಸ ಕೃಪಾ ವರಕ್ಹು ಮಿ ಸುವಾರ್ತೆ ತಿಳಸಾನಾ ಹುತಿ ಸೆವಕ ಥಯೊ. ಕ್ಹುದಾ ತಿನಿ ತಾಕತ ಉಪಯೊಗ ಕರಿನ ಮನೆ ತೆ ಕೃಪಾ ವರ ದಿದ್ಯೊ. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />ಕ್ಹುದಾನಾ ಮನಕ್ಹೊಮಾ ಮಿಜ಼ ನ್ಹಾನೊ ವ್ಹೈ. ಕ್ರಿಸ್ತನಿ ಆಸ್ತಿನಾ ಹುತಿ ರ‍್ಹಯಲ ಸುವಾರ್ತೆನೆ ಮಿ ಯಹುದ್ಯೊ ನೈಸೊವಾಲಾವೊನೆ ತಿಳಸೌ ಕೈನ ಕ್ಹುದಾ ಮನೆ ಕೃಪಾ ವರ ದಿದ್ಯೊ. ತೆ ಆಸ್ತಿ ಪುರಾ ಕಳೈಲಿವಾನೆ ಸಾಧ್ಯ ನತ್ತಿ. <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />ದಡಿನ ರ‍್ಹಯಲ ತಿನಾ ವಿಚಾರೊ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ತಿಳಸೌ ಕವಾನು ಕಾಮ ಕ್ಹುದಾ ಮನೆ ದಿದ್ಯೊ. ಪೈಲಾನಾ ಕಾಲ್ತು ತೆ ಕ್ಹುದಾ ಕನ ದಡಿನ ವ್ಹತ್ತು. ಹರಯಕ್ಕ ಸೃಷ್ಟಿ ಕರಲವಾಲೊ ಕ್ಹುದಾಜ಼ ವ್ಹೈ. <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />ತಿನಾ ಬಿಜಾ಼-ಬಿಜಾ಼ ತರಾನು ಗ್ಯಾನ ಆಕಾಶ ಮಂಡಳಮಾ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ಅದಿಪತಿಯೊನೆ ಅದಿಕಾರಿಯೊನೆ ಹಮ್ನಾ ಸಭೆನಾ ಮುಲಕ ಗ್ವತ್ತ ಥೌ ಕವಾನು ಕ್ಹುದಾನು ಉದ್ದೆಶ ವ್ಹತ್ತು. <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />ಪೈಲಾನಾ ಕಾಲ್ತೊ ಎಜ಼ ಕ್ಹುದಾನು ವಿಚಾರ ವ್ಹತ್ತು. ಕ್ಹುದಾ ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಮುಲಕ ತಿನಿ ವಿಚಾರ ನಿಂಗತ ಕರ‍್ಯೊ. <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />ಅಪೆ ಕ್ರಿಸ್ತಮಾ ರ‍್ಹವಾನಾ ಬರೊಕ್ಹಾನಾ ಮುಲಕ ಕ್ಹುದಾ ಕನ ಸ್ವಾತಂತ್ರ ಕ್ಹು ವರಿ ಭೆವಾಚಿ ಜಾ಼ವಾನೆ ಸಾಧ್ಯ ಥಯು. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಮಿ ತುಮಾರಾ ಹುತಿ ಆವಾನಾ ತ್ರಾಸೊ ದೆಕಿನ ದುಖಿ ಥೈನ ಧೈರ್ಯ ಜ಼ವೈಲಿವೊ ನಕೊ. ಮಾರಾ ತ್ರಾಸೊ ತುಮೊನೆ ಮರ್ಯಾದಿ ಲಾವಸ.<verse eid="EPH 3:13" /></para>
  <para style="s">ಕ್ರಿಸ್ತನಿ ಮಯಾ</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />ತಿನಾಹುತಿ ಬಾನಾ ಕ್ಹಾಮಾ ಉಂದಾ ಗುಡ್ಗಾ ಘಾಲುಸ. <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />ಭುಲೊಕಮಾ ವರಿ ಸ್ವರ್ಗಮಾ ರ‍್ಹವಾನು ಹರಯಕ್ಕ ಘರದಾನು ತಿನಾಕ್ಹು ತಿನು ಕ್ಹರಿ ನಾಮ ವ್ಹಂದಿಲಿವಸ. <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />ಎ ತುಮಾರಾ ಆತ್ಮಾವೊನೆ ಘಟ್ಟ ಥೈನ ರ‍್ಹವಾನೆ ಚಾ಼ಯೆ ಥಯಲ ತಾಕತ ತಿನಿ ಮಹಿಮಾನಾ ಪ್ರಕಾರ ದಿವ್ ಕೈನ ಬಾ ಕನ ಮಾಂಗಿಲ್ಯುಸ. ತೆ ತಿನಿ ಆತ್ಮಾನಾ ಮುಲಕ ತುಮೊನೆ ತೆ ತಾಕತ ದಿವಸ. <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />ತುಮಾರಾ ಬರೊಕ್ಹಾನಾ ಮುಲಕ ಕ್ರಿಸ್ತ ತುಮಾರಾ ಮನಸ್ಸೊಮಾ ರ‍್ಹೌ ಕೈನ ಪ್ರಾಥನಾ ಕರುಸ. ತುಮಾರಿ ಜಿವ್ನಾ ಮಯಾಮಾ ಘಟ್ಟ ಥೈನ ರ‍್ಹೌ ಕೈನ ವರಿ ಮಯಾನಾ ಉಪ್ಪರ ಭಂದೌ ಕೈನ ಮಾಂಗಿಲ್ಯುಸ. <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />ತುಮೆ ವರಿ ಕ್ಹುದಾನಾ ಪರಿಶುದ್ಧ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಕ್ರಿಸ್ತನಿ ಮಯಾನಿ ಮಹತ್ವನೆ ಮತ್ಲಬ ಕರಿಲಿವಾನೆ ಚಾ಼ಯೆ ಥಯಲ ತಾಕತ ವ್ಹಂದಿಲಿದಲವಾಲಾ ಥೌ ಕೈನ ಪ್ರಾಥನಾ ಕರುಸ. ಕ್ರಿಸ್ತನಿ ಮಯಾನು ರುಂದಮಾ ಲಾಂಬಾಮಾ ವರಿ ಉಂಡಾಮಾ ಉಚ್ಚಾಮಾ ತುಮೆ ಅರ್ಥ ಕರಿಲ್ಯು ಕೈನ ಪ್ರಾಥನಾ ಕರುಸ. <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />ಕ್ರಿಸ್ತನಿ ಮಯಾ ಮನಕ್ಹೊ ತಿಳ್ದಿಲಿವಾನೆ ಸಾಧ್ಯ ನತ್ತಿ. ತೆನೈಸೊ ತೆ ಮಯಾನೆ ತುಮೆ ತಿಳ್ದಿಲಿವಾಲಾ ಥೌ ಕೈನ ಪ್ರಾಥನಾ ಕರುಸ. ತೆಳಾಮಾ ತುಮೆ ಕ್ಹುದಾನೆ ಪುರಾ ಮನಸ್ಸಕ್ಹು ಭರಲವಾಲಾ ಥಾವಾನೆ ಸಾಧ್ಯ ಥಾವಸ.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />ಅಪ್ನೊಮಾ ಕಾಮ ಕರಾನು ತಿನಿ ತಾಕತಕ್ಹು ಅಪೆ ಪುಚ್ಚಾತಿಬಿ ವಿಚಾರ ಕರಾತಿಬಿ ಕೆಕ್ಲೊಕಿ ಘನ್ನು ಘನ್ನು ಕ್ಹುದಾ ಕರಸ. <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />ತಿನೆ ಸಭೆಮಾಬಿ ಕ್ರಿಸ್ತ ಯೆಸುಮಾಬಿ ತಲ ತಲಾಂತರಮಾಬಿ ಯುಗ ಯುಗಾಂತರಬಿ ಮಹಿಮಾ ಥಾವಾದೆ. ಆಮೆನ.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">ಯಕ್ಕಜ಼ ಅಂಗ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />ಮಿ ಕ್ಹುದಾನೊ ರ‍್ಹಯಲ ಹುತಿ ಜೈಲಮಾ ಛೆ. ತುಮೆ ಕ್ಹುದಾಕ್ಹು ಬಲಾಯಲವಾಲಾ ವ್ಹೈ. ತಿನಾಹುತಿ ತುಮಾರಾ ಬಲಾಯನಾ ಹುತಿ ತಿನಾನಿಂಗತ ಯೊಗ್ಯ ಥೈನ ಜಿವ್ನಾ ಕರು ಕೈನ ತುಮೊನೆ ಮಾಂಗಿಲ್ಯುಸ. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />ಕೆಳಾಮಾಬಿ ತಗ್ಗಿನ, ವರಿ ತಾಳ್ಮೆಕ್ಹು ರ‍್ಹಯಲವಾಲಾ ಥೈನ ಯಕ್ನೆ ಯಕ್ಕ ಮಯಾಕ್ಹು ತಡ್ದಿಲಿನ ರ‍್ಹವೊ. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />ತುಮೆ ತಿನಾ ಮುಲಕ ಸಮಾದಾನ ಕವಾನಾ ಬಂಧನೊ ಕ್ಹು ಯಕ್ಕ ಥಯಾಸ. ಇನಾ ನಿಂಗತ ರ‍್ಹವಾನೆ ತುಮಾರಾ ಹತೆ ಥಯಲ ತೆಕ್ಲು ಕೊಶಿಶ ಕರೊ. ಸಮಾಧಾನ ತುಮೊನೆ ಕ್ಹಾರಾವೊನೆ ಯಕ್ಕ ಕರಾದೆ. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />ಅಂಗ ಯಕ್ಕಜ಼ ವ್ಹೈ ವರಿ ಪವಿತ್ರ ಆತ್ಮಾಬಿ ಯಕ್ಲೊಜ಼ ವ್ಹೈ. ತುಮೆ ಕ್ಹಾರಾ ಯಕ್ಕಜ಼ ಆಸ ವ್ಹಂದಲ ರ‍್ಹೌ ಕೈನ ಕ್ಹುದಾ ತುಮೊನೆ ಬಲಾಯೊ. <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />ಯಕ್ಲೊಜ಼ ಪ್ರಭು ವ್ಹೈ, ಯಕ್ಕಜ಼ ಬರೊಕ್ಹೊ ವ್ಹೈ, ಯಕ್ಕಜ಼ ಬಾಪ್ತಿಸ್ಮ ವ್ಹೈ. <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />ಕ್ಹಾರಾವೊನೆ ಬಾ ಥಯಲ ಕ್ಹುದಾ ಯಕ್ಲೊಜ಼ ವ್ಹೈ. ತೆ ಕ್ಹಾರುಜ಼ ಅದಿಕಾರಕ್ಹು ಆಳಸ. ತೆ ಕ್ಹಾರಿ ಜ಼ಗಾ ರ‍್ಹವಾಲೊ ವ್ಹೈ ವರಿ ಕ್ಹಾರಾವೊಮಾ ರ‍್ಹವಾಲೊ ವ್ಹೈ.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />ಕ್ರಿಸ್ತ ತುಮೊಮಾ ಹರ ಯಕ್ಲಾವೊನೆ ಖಾಸ ವರಾ ದಿದ್ಯೊಸ. ಹರಯಕ್ಲೊ ಕ್ರಿಸ್ತನಿ ಆಸ ನಿಂಗತ ವರ ವ್ಹಂದಿಲಿದ್ಯೊಸ. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />ತಿನಾಹುತಿಜ಼ ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಇನಾ ನಿಂಗತ ಬರ್ದಲ ಛೆ;</para>
  <para style="q1" vid="EPH 4:8">"ತೆ ಉನ್ನತ ಜ಼ಗಾಪರ ಉಪ್ಪರ ಜಾ಼ತಾಮಾ</para>
  <para style="q2" vid="EPH 4:8">ದುಶ್ಮನೊನೆ ಕೈದಿಯೊ ಕರಿನ ನಿಂಗೈನ</para>
  <para style="q2" vid="EPH 4:8">ಮನಕ್ಹೊನೆ ದಾನ ಧರ್ಮ ಕರ‍್ಯೊ"<verse eid="EPH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 4:9" />"ತೆ ಉನ್ನತ ಜ಼ಗಾಯೆ ಗಯೊ" ಕದ್ಯಾಮ ತೆ ಭುಲೊಕ ಪರ ಉತ್ರಿನ ಐನ, <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />ಜಿಮಿನನಾ ಅಧೊಲೊಕನೆ ಉತ್ರಿನ ಗೈನ, ತ್ಯಾಂತೊ ಹಬಾಳ ದಾಟಿನ ಉನ್ನತ ಜ಼ಗಾಯೆ ಗಯೊ ಮತ್ಲಬ ವ್ಹೈ. ಆಕಾಶ ಮಂಡಲಮಾ ತೆ ರ‍್ಹೌ ಕೈನ ತೆ ತಿಮ್ಮ ಕರ‍್ಯೊ. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />ತೆ ದಕ್ಹಾ ಜ಼ನಾವೊನೆ ಅಪೊಸ್ತಲೊ ಕರಿನ ದಕ್ಹಾ ಜ಼ನಾವೊನೆ ಪ್ರವಾದಿ ಕರಿನ ದಕ್ಹಾ ಜ಼ನಾವೊನೆ ಸುವಾರ್ತೆ ಕವಾಲಾ ಕರಿನ ದಕ್ಹಾ ಜ಼ನಾವೊನೆ ಸಭಾಪಾಲಕ ಕರಿನ ವರಿ ಉಪದೆಶಕ ಕರಿನ ನೆಮಶ್ಯೊ. <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />ಕ್ರಿಸ್ತನಿ ಸೆವಾನಾ ಹುತಿ ಕ್ಹುದಾ ಪರಿಶುದ್ಧ ಮನಕ್ಹೊನೆ ತಯ್ಯಾರ ಕರಾನೆ ತೆ ತ್ಯುನೊನೆ ನೆಮಿಸ್ಯೊ. <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />ತಿನಾಹುತಿ ಅಪೆ ಕ್ಹಾರಾ ಬರೊಕ್ಹಾಕ್ಹು ಕ್ಹುದಾನಾ ದಿಕ್ರಾನಾ ವಿಷಯನಾ ಗ್ಯಾನಕ್ಹು ಯಕ್ಕ ಥಯೆ ಲಕ್ಕಾ ಎ ಸೆವಾ ಅಗು ಬಡು. ಅಪೆ ಪುರಾ ಥಯೆ ಲಕ್ಕಾಕದ್ಯಾಮ ಪುರಾ ಮನಸ್ಸಕ್ಹು ಮುಟ್ಟೆ ಲಕ್ಕಾ ಬೆಳದು. <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />ತಿನಾಹುತಿ ಅಪೆ ಹಮ್ನಾತಾ ಬಚ್ಚಾ಼ ಥೈನ ರ‍್ಹೌ ನೈ. ಸಮುಂದರನಿ ಧಡ್ಕಿಯೊ ಹೈತಿ ಜಾ಼ವಾನಾ ಹಡ್ಗೊ ನಿಂಗತ ಗಲಿ ಬಿಲಿ ಥೌ ನೈ. ಅಪೊನೆ ಮೊಸ ಕರಾನೆ ಮನಕ್ಹೊ ಕವಾನಾ ಕಯಾಜ಼ ನವಾ ಉಪದೆಶೊಕ್ಹು ಅಪೆ ಕಳವಳ ಥೌ ನೈ. ಮನಕ್ಹೊನೆ ಮೊಸ ಕರಿನ ಕೆಟ್ಟ ವಾಟಮಾ ಚ಼ಲೌ ಕವಾನಿ ಉದ್ದೆಶಕ್ಹು ತೆ ಕೆಟ್ಟ ಬೊದಕೊ ಬಿಜಾ಼-ಬಿಜಾ಼ ತರಾನಾ ವಿಚಾರೊ ಕರಸ. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />ಅಪೆತುಬಿ ಕ್ಹರಿನೆ ಮಯಾಕ್ಹು ಕೌ; ಕ್ಹಾರಾ ವಿಷಯಮಾ ಬೆಳ್ದಿನ ಕ್ರಿಸ್ತ ಥಾವಾನೆ ಕೊಶಿಶ ಕರು. ಕ್ರಿಸ್ತ ಮಾತು ಥಯೊಸ ಅಪೆ ಅಂಗ ಥಯಾಸ. <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />ಪುರಾ ಅಂಗಜ಼ ಯೆಸುನೆ ಸಂಬಂಧ ರ‍್ಹಯಲ ವ್ಹೈ. ಅಂಗನು ಯಕೆಕ ಭಾಗ ಯಕ್ಕನೆ ಯಕ್ಕಕ ಮಳಿನ ಛೆ. ಹರಯಕ್ಕ ಅಂಗ ತಿನು ತೆ ಕಾಮ ಕರಾಕ್ಹು ಪುರಾ ಅಂಗಜ಼ ಬೆಳ್ದಿನ ಮಯಾಮಾ ಘಟ್ಟ ಥೈನ ರ‍್ಹವಾನೆ ಸಾಧ್ಯ ಥಾವಸ.<verse eid="EPH 4:16" /></para>
  <para style="s">ಕ್ರಿಸ್ತಮಾ ನವೊ ಜಿವನ</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />ಪ್ರಭುನಾ ಹುತಿ ಮಿ ತುಮೊನೆ ಎ ಕೌಸ ವರಿ ಹುಶಾರಕಿ ದಿವ್ಸ. ಅವಿಶ್ವಾಸಿಯೊ ನಿಂಗತ ಇತ್ತಿ ಉಪ್ಪರ ಜಿವ್ನಾ ಕರೊ ನಕೊ. ತ್ಯುನಾ ವಿಚಾರೊ ಉಪಯೊಗ ನೈಸೊ ಥಯಾಸ. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />ತ್ಯುನೆ ಕಳಿ ಲೆತಾ ನೈ. ವರಿ ತ್ಯುನಾ ಮನಸೊ ಘಟ್ಟ ಕರ್ಲಿದಲ ರ‍್ಹವಸ. ತ್ಯುನೆ ನೈ ಐಕಲಕ್ಹು ತ್ಯುನೊನೆ ಸುಜ಼ ಗ್ವತ್ತ ನತ್ತಿ. ತಿನಾಹುತಿ ಕ್ಹುದಾ ದಿವಾನಿ ಜಿವಿತ ವ್ಹಂದಿಲಿವಾನೆ ತ್ಯುನೊನೆ ಸಾಧ್ಯ ನತ್ತಿ. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />ತ್ಯುನೊನೆ ಸರಮ ನತ್ತಿ. ತ್ಯುನೆ ತ್ಯುನಾ ಜಿವಿತೊ ಕೆಟ್ಟ ಕಾಮೊನೆ ಉಪಯೊಗ ಕರಸ; ವರಿ ತ್ಯುನೊನೆ ರ‍್ಹಯಲ ಘನ್ನಿ ಆಸ, ಕ್ಹಾರಾ ತರಾನಾ ಕೆಟ್ಟ ಕಾಮೊ ಹಜು಼ನ ಘನ್ನು ಕರಾನೆ ಆಸ ಕರಸ.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />ತೆನೈಸೊ ಕ್ರಿಸ್ತನಾ ತುಮೆ ಶಿಕ್ಕಲ ಎ ಕ್ಹಾರು ನ್ಹವ್ಹೈ. <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />ತುಮೆ ತಿನು ವಿಶಯ ಐಕ್ಯಾಸ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ಛೆ. ತುಮೆ ತಿನಾಮಾ ರ‍್ಹವಾಕ್ಹು ಕ್ಹರಿ ಶಿಕ್ಯಾಸ. ಹೊ, ಕ್ಹರಿ ಕವಾನು ಯೆಸುಮಾ ಛೆ. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />ತುಮೆ ತುಮಾರಾ ಪಾಚ಼ಲ್ಯಾ ಕೆಟ್ಟ ಕಾಮೊ ಛೊಡು ಕವಾನು ಕದ್ಯಾಮ ತುಮಾರಿ ಜು಼ನ್ನಿ ಚಾಳಿಯೊ ಛೊಡಿ ಪಾಡು ಕೈನ ಶಿಕ್ಯಾ. ಮನಕ್ಹೊ ತ್ಯುನೆ ಕರು ಕೈನ ಆಸ ಕರಾನಾ ಕೆಟ್ಟ ಕಾಮೊಕ್ಹು ಜುಡಿನ ರ‍್ಹಯಲಕ್ಹು ತೆ ಜು಼ನ್ನಿ ಚಾಳಿಯೊ ದಿನ್ನತಾ ದಿನ್ನೆ ಹಜು಼ನ ಕೆಟ್ಟ ಥಾವಸ. <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />ತೆನೈಸೊ ಅಂತರಂಗಮಾ ನವಾ ಥೈನ ನವಾ ಚಾಳಿಯೊ ವ್ಹಂದಿಲಿವಾ ನಿಂಗತ ತುಮೆ ಶಿಕ್ಯಾಸ. <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />ತೆ ಚಾಳಿಯೊ ಕ್ಹುದಾನಿ ಹೊಲಿಕೆನಾ ಪ್ರಕಾರ ಕ್ಹರಿನಿ ನಿತಿ ರ‍್ಹಯಲ ಪರಿಶುದ್ಧ ರ‍್ಹೈನ ಭಾಂದಲ ಛೆ.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />ತಿನಾಹುತಿ ತುಮೆ ಸುಳ್ಳ ಬೊಲ್ಯಾವಾಚಿ ಯಕನೆ ಯಕ್ಕ ಕೆಳಾಮಾಬಿ ಕ್ಹರಿಜ಼ ಕವೊ. ಕಾಕದ್ಯಾಮ ಅಪೆ ಕ್ಹಾರಾ ಯಕ್ಕಜ಼ ಅಂಗನೆ ಮಳಲ ಭಾಗೊ ವ್ಹೈ. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />ಶಿಟ್ಟ ಥಯಾತುಬಿ ಪಾಪ ಕರೊ ನಕೊ ವರಿ ದಿನ್ನ ಕ್ಹಾರಿ ಶಿಟ್ಟಮಾಜ಼ ರ‍್ಹವೊ ನಕೊ. <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />ತುಮೊಪರ ಝಿತ್ತಾನೆ ಸೈತಾನನೆ ಮೌಕೊ ನಕೊ ದಿವೊ. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />ಚ್ವಟ್ಟೊ ಚೊ಼ರಿ ಕರಾನು ಛೊಡಿನ ತೆಜ಼ ರಾಬಾದೆ; ತೆ ತಿನಾ ಹತೊ ಚೊ಼ಕು ಕರಾನೆ ಉಪಯೊಗ ಕರಾದೆ. ತೆಳಾಮಾ ಗರಿಬೊನೆ ಮದತ ಕರಾನೆ ತಿನೆ ಸಾಧ್ಯ ಥಾವಸ. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />ತುಮಾರಾ ಮ್ಹೊಡಾಕ್ಹು ಕೆಟ್ಟ ವಾತೊ ಔ ನೈ. ಭಕ್ತಿನೆ ಘಟ್ಟ ಕರಾನಾ ಕಾಲನೆ ಕರೆಟ್ಟ ರ‍್ಹಯಲ ವಾತೊ ರ‍್ಹಯಾರೆ ಐಕಾಲಾವೊನಾ ಚೊ಼ಕಾನಾ ಹುತಿ ತೆ ಕವೊ. <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />ಪವಿತ್ರ ಆತ್ಮಾನೆ ದುಖ ಕರೊ ನಕೊ. ತುಮೆ ಕ್ಹುದಾನೆ ಮಳಲವಾಲಾ ವ್ಹೈ ಕವಾನೆ ತೆಜ಼ ಕ್ಹುದಾನು ಪ್ರಮಾಣ ಥಯೊಸ ಕರೆಟ್ಟ ಟೈಮಮಾ ತುಮೊನೆ ಬಿಡುಗಡೆ ಕರುಸ ಕವಾನು ದೆಕಾಡಾನಾ ಹುತಿ ಕ್ಹುದಾ ತುಮೊನೆ ತಿನೆ ದಿದ್ಯೊ. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />ಕ್ಹಾರು ದ್ವೆಶ, ಶಿಟ್ಟ, ಕಳವಳ, ದುಶಣೆ, ಎ ಕ್ಹಾರಾ ತರಾನಾ ಕೆಟ್ಟ ತನಾ ತುಮೊಕ್ಹು ದುರ ಕರೊ. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />ಯಕ್ಕನೆ ಯಕ್ಕ ಮರಗಾ ದೆಕಾಡೊ. ಯಕ್ಕನೆ ಯಕ್ಕ ಮಯಾ ಕರೊ. ಕ್ಹುದಾ ಕ್ರಿಸ್ತಮಾ ತುಮೊನೆ ಮಾಪ ಕರಲ ನಿಂಗತ ತುಮೆ ಯಕ್ಕನೆ ಯಕ್ಕ ಮಾಫ ಕರೊ.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">ಉಜಾಲಾಮಾ ರ‍್ಹವಾಡಾಸ.</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />ತುಮೆ ಕ್ಹುದಾನಾ ಮಯಾನಾ ಬಚ್ಚಾ಼ ವ್ಹೈ; ತಿನಾಹುತಿ ತುಮೆ ತಿನಾ ನಿಂಗತ ರ‍್ಹೌ. <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />ಮಯಾಕ್ಹು ರ‍್ಹವೊ. ಕ್ರಿಸ್ತ ತುಮೊನೆ ಮಯಾ ಕರಲ ನಿಂಗತ ತುಮೆ ಬಿಜಾ಼ವೊನೆ ಮಯಾ ಕರೊ. ಕ್ರಿಸ್ತ ಅಪ್ನಾ ಹುತಿ ತಿನೆ ತೆಜ಼ ಬಾಸನು ತೆಲ ಕಾಣಿಕೆ ಥೈನ ಯಜ್ಞ ಥೈನ ಕ್ಹುದಾನೆ ತೆನೈಸೊ ತಿನೆಜ಼ ದಿದ್ಯೊ.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />ತೆನೈಸೊ ತುಮಾರಾ ವಚ್ಮಾ ಅಂಗನು ಪಾಪ ರ‍್ಹೌ ನೈ. ಕಯಾ ತರಾನು ಕೆಟ್ಟ ರ‍್ಹವಾದೆ ಮಿ ಕವಾನು ರ‍್ಹವಾದೆ ರ‍್ಹೌ ನೈ. ಕಾಕದ್ಯಾಮ ತೆ ಕ್ಹುದಾನಾ ಪರಿಶುದ್ಧ ಮನಕ್ಹೊನೆ ಚಾ಼ಯೆ ಥಯಲ ನ್ಹವ್ಹೈ. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />ತೆನೈಸೊ ತುಮಾರಾ ವಚ್ಮಾ ಕೆಟ್ಟ ವಾತೊ ರ‍್ಹೌ ನೈ. ತುಮೆ ಮುರಖ ತನಾಕ್ಹು ಬೊಲು ನೈ ವರಿ ಕೆಟ್ಟ ಅಕ್ಹಾನಾ ವಾತೊ ಬೊಲು ನೈ. ತೆ ತುಮೊನೆ ಚಾ಼ಯೆ ಥಯಲ ನ್ಹವ್ಹೈ. ತೆನೈಸೊ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರ ಕವಾಲಾ ರ‍್ಹೌ. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />ಎ ತುಮೊನೆ ಚೊ಼ಕಿ ತರಾ ಗ್ವತ್ತ ರ‍್ಹವಾದೆ; ಅಂಗನಾ ಪಾಪೊ ಕರಾಲಾವೊನೆ, ಕೆಟ್ಟ ಕಾಮೊ ಕರಾಲಾವೊನೆ, ಮಿ ಕವಾಲಾವೊನೆ, ಕೆಟ್ಟ ಆಸ ಕರಾಲಾ, ಕ್ರಿಸ್ತನಾ ವರಿ ಕ್ಹುದಾನಾ ರಾಜ್ಯಮಾ ಜ಼ಗಾಜ಼ ನತ್ತಿ. ಮಿ ಕವಾನು ಮುರತಿಯೊನೆ ಆರಾಧನಾ ಕರಲ ನಿಂಗತ ಸೆಮ ಛೆ.<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />ಕ್ಹರಿ ನೈ ರ‍್ಹಯಲ ಸಂಗತಿಯೊ ಕೈನ ತುಮೊನೆ ಮೊಸ ಕರಾನೆ ಕಿನೆಜ಼ ಮೌಕೊ ದಿವೊ ನಕೊ. ತೆ ಸಂಗತಿಯೊನಾ ಮುಲಕ ಕ್ಹುದಾನಿ ಶಿಟ್ಟ ತಿನೆ ವಿಧೆಯ ನೈ ಥಾವಾಲಾ ಮನಕ್ಹೊನಾ ಉಪ್ಪರ ಆವಸ. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />ತಿನಾಹುತಿ ತುಮೆ ತ್ಯವಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ವಾಟೊ ಲಿವಾಲಾ ಥಾವೊ ನಕೊ. <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />ಕಾಕದ್ಯಾಮ ಪಾಚ಼ಲ್ಯಾ ಕಾಲಮಾ ತುಮೆ ಅಂದಾರು ಥಯಾತಾ. ಹಮ್ನಾ ತುಬಿ ತುಮೆ ಪ್ರಭುಮಾ ಪುರಾ ಉಜಾಲು ಥಯಾಸ. ತಿನಾಹುತಿ ಉಜಾಲಾನೆ ಮಳಲ ಬಚ್ಚಾ಼ ನಿಂಗತ ಜಿವ್ನಾ ಕರೊ. <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />ಉಜಾಲಾನು ಫಲ ಚೊ಼ಕಾಮಾಬಿ ನಿತಿಮಾಬಿ ಕ್ಹರಿಮಾಬಿ ದಿಕ್ಹಿನ ಆವಸ. <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />ಪ್ರಭುನೆ ಕಯು ಪಸಂದ ಛೆ ಕವಾನು ತಿಳ್ದಿಲಿವಾನೆ ಕೊಶಿಶ ಕರೊ. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />ಅಂದಾರಾಮಾ ರ‍್ಹವಾನಾ ಮನಕ್ಹೊ ಕರಾನಾ ಕಾಮೊ ಕರೊ ನಕೊ. ತಿಕ್ಹು ಚೊ಼ಕು ಸುಜ಼ ಥಾತು ನೈ. ತೆನೈಸೊ ಅಂದಾರಾಮಾ ಥಾವಾನಾ ಕಾಮೊ ತಪ್ಪ ವ್ಹೈ ಕವಾನು ದೆಕಾಡಾನೆ ಚೊ಼ಕಾ ಕಾಮೊ ಕರೊ. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />ತೆ ಮನಕ್ಹೊ ಗುಪ್ತ ಕಾಮೊನಾ ಹುತಿ ಬೊಲಾನೆಬಿ ಸರಮ ಆವಸ. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />ತೆನೈಸೊ ತೆ ಕಾಮೊ ತಪ್ಪ ವ್ಹೈ ಕೈನ ಅಪೆ ದೆಕಾಡತಾಮಾ ಉಜಾಲಾಕ್ಹು ತೆ ಕಾಮೊ ಚೊ಼ಕಿ ತರಾ ದಿಕ್ಹಸ. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />ಹರಯಕ್ಕಬಿ ಚೊ಼ಕಿ ತರಾ ದೆಕಾಡಾನುಜ಼ ಉಜಾಲು ವ್ಹೈ. ತಿನಾಹುತಿ ಅಮ್ಮ ಬರ್ದಲ ಛೆ;<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />ತಿನಾಹುತಿ ತುಮೆ ಕಿಮ್ಮ ಜಿವ್ನಾ ಕರಾಡಾಸ ಕವಾನಾ ಹುತಿ ಘನ್ನಾ ಹುಶಾರಕ್ಹು ರ‍್ಹವೊ. ಗ್ಯಾನ ನೈಸೊ ಮನಕ್ಹೊ ನಿಂಗತ ಜಿವ್ನಾ ಕರ‍್ಯಾವಾಚಿ ಗ್ಯಾನಿಯೊ ನಿಂಗತ ಜಿವ್ನಾ ಕರೊ. <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />ಎ ದಿನ್ನೊ ಕೆಟ್ಟ ಛೆ. ತಿನಾಹುತಿ ತುಮೊನೆ ರ‍್ಹಯಲ ಹರಯಕ್ಕ ಮೌಕೊ ಚೊ಼ಕು ಕರಾನೆಜ಼ ಉಪಯೊಗ ಕರೊ. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />ತುಮೆ ಪಿಸಾಳಾ ಥಯಾವಾಚಿ ಕ್ಹುದಾನಿ ಚಿತ್ತ ಸು ವ್ಹೈ ಕವಾನು ತಿಳ್ದಿಲಿವೊ.<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />ಪಿನ ನಿಶಾಮಾ ರ‍್ಹವೊ ನಕೊ, ತೆ ಪಾಪನಾ ಕಾಮೊಮಾ ಚ಼ಲಾವಸ, ತೆನೈಸೊ ಕೆಳಾಮಾಬಿ ಪವಿತ್ರ ಆತ್ಮಾಕ್ಹು ಭರಲ ರ‍್ಹವೊ. <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />ಕಿರತನೆಕ್ಹು ಗಿದ್ದೊಕ್ಹು ಆತ್ಮಿಕ ಗಿದ್ದೊಕ್ಹು ಯಕ್ನೆ ಯಕ್ಕ ಬೊಲೊ. ತುಮಾರಾ ಮನಸೊಮಾ ಪ್ರಭುನೆ ಮೆಜಿಕ ವಜಾ಼ಡಿನ ಗಿದ್ದೊ ಕವೊ. <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />ಹರಯಕ್ಕ ವಿಷಯಮಾಬಿ ಬಾ ಥಯಲ ಕ್ಹುದಾನೆ ಅಪ್ನೊ ಪ್ರಭು ಯೆಸು ಕ್ರಿಸ್ತನಾ ನಾಮಪರ ಕೆಳಾಮಾಬಿ ಸ್ತೊತ್ರಾ ಕರೊ.<verse eid="EPH 5:20" /></para>
  <para style="s">ಮಾಟಿಯೊ ವರಿ ಬೈಕೊವೊ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />ತುಮೆ ಯಕ್ಕನೆ ಯಕ್ಕ ಅಧಿನ ಥೈನ ರ‍್ಹೌ. ಕಾಕದ್ಯಾಮ ತುಮೆ ಕ್ರಿಸ್ತಮಾ ಭೆ ಭಕ್ತಿಕ್ಹು ಛೆ. <verse eid="EPH 5:21" /><verse number="22" style="v" sid="EPH 5:22" />ಬಾಕ್ಡಿಯ, ತುಮೆ ಪ್ರಭುನೆ ಮ್ಹೈ ಥೈನ ರ‍್ಹಯಲ ನಿಂಗತ ತುಮಾರಾ ಮಾಟಿಯೊನೆಬಿ ಮ್ಹೈ ಥೈನ ರ‍್ಹವೊ. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />ಕ್ರಿಸ್ತ ಸಭೆನೆ ಮಾತು ರ‍್ಹಯಲ ನಿಂಗತ ಮಾಟಿಬಿ ಬೈಕೊನೆ ಮಾತು ಥಯೊಸ. ಸಭೆ ಕ್ರಿಸ್ತನು ಅಂಗ ವ್ಹೈ. ಕ್ರಿಸ್ತ ತೆ ಅಂಗನೊ ರಕ್ಷಕ ಥಯೊಸ. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />ಸಭೆ ಕ್ರಿಸ್ತನಾ ಅದಿನಮಾ ಛೆ. ತಿನಾ ನಿಂಗತಜ಼ ಬೈಕೊ ಮಾಟಿನಾ ಅದಿನಮಾ ಛೆ. ಹರಯಕ್ಕ ವಿಷಯಮಾ ಬೈಕೊ ತ್ಯುನಾ ಮಾಟಿನೆ ಅದಿನ ಥೈನ ರ‍್ಹೌ.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />ಮಾಟಿಯೊ, ಕ್ರಿಸ್ತ ಸಭೆನೆ ಮಯಾ ಕರಲ ನಿಂಗತ ತುಮೆ ತುಮಾರಿಯೊ ಬೈಕೊನೆ ಮಯಾ ಕರು. <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />ಕ್ರಿಸ್ತ ಸಭೆನೆ ಪರಿಶುದ್ಧ ಕರಾನಾ ಹುತಿ ಜ಼ಲಮ ದಿದ್ಯೊ. ಸುವಾರ್ತೆ ಕವಾನಾ ಮುಲಕ ಪಾನಿಕ್ಹು ಧ್ವಯಿನ ತೆ ಸಭೆನೆ ಪರಿಶುದ್ಧ ಕರ‍್ಯೊ. <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />ಮಹಿಮಾನೆ ತಯ್ಯಾರ ರ‍್ಹಯಲ ಜಾಂಜಿಮಾನ ನಿಂಗತ ರ‍್ಹವಾನಿ ಸಭೆ ತಿನೆ ದಿವ ಕೈನ ತೆ ಜ಼ಲಮ ದಿದ್ಯೊ. ಸಭೆ ದೊಶ ನೈಸೊ ಶುದ್ಧ ರ‍್ಹೌ ಕೈನ ವರಿ ಕೆಟ್ಟತನಾ ರ‍್ಹವಾದೆ ಪಾಪ ರ‍್ಹವಾದೆ ತೆನೈಸೊ ಬಿಜು಼ ಕಯುಜ಼ ತಪ್ಪ ರ‍್ಹವಾದೆ ಸಭೆಮಾ ರ‍್ಹೌ ನೈ ಕೈನ ತೆ ಜ಼ಲಮ ದಿದ್ಯೊ. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />ತಿನಾಹುತಿ ಮಾಟಿಯೊ ತ್ಯುನಾ ಸ್ವಂತ ಅಂಗೊನೆ ಮಯಾ ಕರಲ ನಿಂಗತ ತ್ಯುನಿ ಬೈಕೊನೆ ಮಯಾ ಕರು. ತಿನಿ ಬೈಕೊನೆ ಮಯಾ ಕರಾಲೊ ತಿನೆ ತೆಜ಼ ಮಯಾ ಕರಾಲೊ ಥಯೊಸ. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />ಕಾಕದ್ಯಾಮ ಕುನ್ನಜ಼ ಕೆಳಾಮಾ ತಿನಾ ಅಂಗನೆ ದ್ವೆಷ ನೈ ಕರ‍್ತೊ. ಹರಯಕ್ಲೊ ತಿನಾ ಅಂಗನೆ ಚೊ಼ಕಿ ತರಾ ದೆಕಿಲಿವಸ. ಕ್ರಿಸ್ತ ಸಭೆನಾ ಹುತಿ ಕರಾನುಜ಼ ತೆ ವ್ಹೈ. <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />ಕಾಕದ್ಯಾಮ ಅಪೆ ತಿನಾ ಅಂಗನಾ ಭಾಗೊ ಥಯಾಸ. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಕದಲ ನಿಂಗತ"ತಿನಾಹುತಿ ದಾಣಗೊ ತಿನಾ ಮಾ ಬಾಪನೆ ಛೊಡಿನ ತಿನಿ ಬೈಕೊಮಾ ಮಳಸ ವರಿ ತ್ಯುನೆ ಭಂಬಿ ಜ಼ನಾ ಯಕ್ಕಜ಼ ಅಂಗ ಥಾವಸ" <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />ಮಿ ಕ್ರಿಸ್ತನೆಬಿ ಸಭೆನೆಬಿ ರ‍್ಹಯಲ ಸಂಬಂಧನಾ ಹುತಿ ಬೊಲಾಡೊಸ. ರಹಸ್ಯ ರ‍್ಹಯಲ ಎ ಕ್ಹರಿ ಘನ್ನು ಖಾಸ ರ‍್ಹಯಲ ವ್ಹೈ. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />ತೆನೈಸೊ ತುಮೊಮಾ ಹರಯಕ್ಕ ಮಾಟಿ ತಿನೆ ತೆಜ಼ ಮಯಾ ಕರಲ ನಿಂಗತ ತಿನಿ ಬೈಕೊನೆ ಮಯಾ ಕರು ವರಿ ಬೈಕೊ ತಿನಾ ಮಾಟಿನೆ ಭೆ ಭಕ್ತಿಕ್ಹು ರ‍್ಹೌ.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">ಮಾ ಬಾಪ ವರಿ ಬಚ್ಚಾ಼</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />ಬಚ್ಚಾ಼ವೊ, ಪ್ರಭುನಾ ಚಿತ್ತ ನಿಂಗತ ತುಮಾರಾ ಮಾ ಬಾಪನೆ ವಿಧೆಯ ಥೈನ ರ‍್ಹವೊ. ತೆ ನ್ಯಾಯಬದ್ಧ ರ‍್ಹಯಲ ವ್ಹೈ. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />ಕ್ಹುದಾನಿ ಆಗನ್ಯಾ ಕಯೆ ನಿಂಗತ"ತುಮೆ ತುಮಾರಾ ಮಾ ಬಾಪನೆ ಮರ್ಯಾದಿ ದಿವ ಎ ಪಸ್ಟ ಆಗನ್ಯಾನೆ ಸಂಬಂಧ ಛೆ. <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />ತೆ ವಾಗ್ದಾನ ಅಮ್ಮ ಛೆ; "ತೆಳಾಮಾ ತುಮೊನೆ ಚೊ಼ಕು ಥಾವಸ ವರಿ ತುಮೆ ಜಿಮಿನ ಪರ ಘನ್ನಾ ವರಕ್ಹ ಜಿವ್ತಾ ರ‍್ಹವೊಶಿ"<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />ಬಾಪೊ, ತುಮಾರಾ ಬಚ್ಚಾ಼ವೊನೆ ಶಿಟ್ಟ ಲಾಯಾವಾಚಿ ಪ್ರಭುನಾ ಉಪದೆಶಕ್ಹು ಬಾನಾ ಬಚ್ಚಾ಼ವೊ ನಿಂಗತ ಬೆಳ್ಸಾವೊ.<verse eid="EPH 6:4" /></para>
  <para style="s">ಮಾಲಕೊ ವರಿ ಆಳೊ</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />ಸೆವಕೊ, ತುಮಾರಾ ಭುಲೊಕನಾ ಮಾಲಕೊನೆ ಭೆಕ್ಹು ಮರಯಾದಿಕ್ಹು ವಿಧೆಯ ಥಾವೊ. ತುಮೆ ಕ್ರಿಸ್ತನೆ ವಿಧೆಯ ಥಯೆ ನಿಂಗತ ಯಥಾರಥ ಮನಸಕ್ಹು ವಿಧೆಯ ಥಾವೊ. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />ತ್ಯುನಿ ಮಯಾ ಗಳಸಿಲ್ಯು ಕೈನ ತ್ಯುನೆ ದೆಕ್ತಾಮಾ ಸೆವಾ ಕರ‍್ಯಾವಾಚಿ ತುಮೆ ಕ್ರಿಸ್ತನೆ ವಿಧೆಯ ಥೈನ ರ‍್ಹಯಲ ನಿಂಗತ ತ್ಯುನೊನೆಬಿ ವಿಧೆಯ ಥೈನ ರ‍್ಹೌ. ಕ್ಹುದಾನೆ ಪಸಂದ ರ‍್ಹಯಲ ತುಮೆ ಪುರಾ ಮನಸ್ಸಕ್ಹು ಕರು. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />ತುಮೆ ಕರಾನಾ ಕಾಮೊ ಖುಶಿಕ್ಹು ಕರೊ. ಖಾಲಿ ಮನಕ್ಹೊನಿ ಸೆವಾ ಕರಾಲಾ ನಿಂಗತ ಕರ‍್ಯಾವಾಚಿ ಪ್ರಭುನಿ ಸೆವಾ ಕರಾಲಾ ನಿಂಗತ ಕರೊ. <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />ಚೊ಼ಕು ಕರಾಲಾ ಹರ ಯಕ್ಲಾನೆಬಿ ಕ್ಹುದಾ ಪ್ರತಿ ಫಲ ದಿವಸ ಕವಾನು ಶೆಮಾ ಮ್ಹೆಲಿವೊ. ಹರಯಕ್ಕ ಮನಕ್ಹ ತಿನೊ ಸೆವಕ ಥೈನ ರ‍್ಹವಾದೆ ತೆನೈಸೊ ಸ್ವಾತಂತ್ರ ಥೈನ ರ‍್ಹವಾದೆ ತೆ ಕರಾನಾ ಚೊ಼ಕಾ ಕಾಮೊನೆ ಪ್ರತಿಫಲ ವ್ಹಂದಿಲಿವಸ.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />ಮಾಲಕೊ, ತಿನಾ ನಿಂಗತಜ಼ ತುಮಾರಾ ಸೆವಕೊನೆ ಚೊ಼ಕಾ ಥೈನ ರ‍್ಹವೊ. ತ್ಯುನೊನೆ ಭೆ ಆಯೆ ನಿಂಗತ ಬೊಲೊ ನಕೊ. ತುಮೊನೆಬಿ ತ್ಯುನೊನೆಬಿ ಮಾಲಕ ರ‍್ಹಯಲವಾಲೊ ಸ್ವರ್ಗ ಲೊಕಮಾ ಛೆ ಕವಾನು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. ತೆ ಹರ ಯಕ್ಲಾನೆಬಿ ವಿರುದ್ದ ನೈಸೊ ಫೈಸಲೊ ಕರಸ.<verse eid="EPH 6:9" /></para>
  <para style="s">ಕ್ಹುದಾನಾ ಕ್ಹಾರಾ ಆಯುದೊ ಘಾಲಿವೊ</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />ಲಾಸ್ಟ ವಾತ ಸುವ್ಹೈ ಕದ್ಯಾಮ, ಪ್ರಭುಮಾ ತಿನಿ ಮ್ಹೊಟಿ ತಾಕತಮಾ ಘಟ್ಟ ಥೈನ ರ‍್ಹವೊ. <figure style="fig" alt="Roman soldier" file="lb00196c.tif" size="col" copy="Horace Knowles ©" ref="6:10">ರೊಮನ್ನನೊ ಸೈನಿಕ</figure> <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />ಕ್ಹುದಾನಾ ಕ್ಹಾರಾ ಆಯುದ್ದೊ ಘಾಲಿವೊ. ತೆಳಾಮಾ ಸೈತಾನನಾ ಕುತಂತ್ರನೆ ವಿರುದ್ದ ಥೈನ ಹೊರಾಡಾನೆ ತುಮೊನೆ ಸಾಧ್ಯ ಥಾವಸ. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />ಅಪ್ನಿ ಹೊರಾಟ ಮನಕ್ಹೊನಾ ವಿರುದ್ದ ನ್ಹವ್ಹೈ. ಅಪೆ ಅಂಧಕಾರನಾ ಅದಿಪತಿಯೊನೆ ಅದಿಕಾರಿಯೊನೆ ವರಿ ಎ ಲೊಕನಾ ಅಂದಾರಾನಾ ತಾಕತೊನೆ ಹಬಾಳನಾ ದುಷ್ಟ ತಾಕತೊನೆ ವಿರುದ್ದ ಥೈನ ಹೊರಾಡಾಸ. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />ತಿನಾಹುತಿಜ಼ ತುಮೆ ಕ್ಹುದಾನಾ ಕ್ಹಾರಾ ಆಯುದ್ದೊ ಘಾಲ್ಯು. ತೆಳಾಮಾ ಯುದ್ದನಾ ದಿನ್ನೊಮಾಬಿ ಹೊರಾಟ ಪುರಾ ಕ್ಹರಲ ಪರಬಿ ಘಟ್ಟ ಥೈನ ಹುಬ್ರವಾನೆ ತುಮೊನೆ ಸಾಧ್ಯ ಥಾವಸ.<verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />ತಿನಾಹುತಿ ಕ್ಹರಿನೆ ಭಾಂದಿಲಿನ ನಿತಿ ಕವಾನಾ ಹಿರಾವೊನಿ ಪಟ್ಟಿ ಛಾತಿನೆ ಭಾಂದಿಲಿನ <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />ಸಮಾಧಾನನಿ ಸುವಾರ್ತೆನಾ ಪಾದರಕ್ಷೆ ಘಾಲಿನ ಘಟ್ಟ ಥೈನ ಹುಬ್ರಿವೊ. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />ತೆನೈಸೊ ಬರೊಕ್ಹೊ ಕವಾನಾ ಗುರಾಣಿನೆ ಧರಿಲಿವೊ. ಸೈತಾನನಾ ಆಗನಿಯೊ ಬಾಣೊ ಹುಬ್ರಾಡಾನೆ ತುಮೊನೆ ಇಕ್ಹು ಮದತ ಥಾವಸ. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />ಕ್ಹುದಾನಿ ರಕ್ಷಣೆ ಮಾತಾನು ಕವಚ ನಿಂಗತ ಘಾಲಿವೊ. ಪವಿತ್ರ ಆತ್ಮಾನಿ ತಲ್ವಾರ ಕದ್ಯಾಮ ಕ್ಹುದಾನಿ ವಾಕ್ಯಾ ದಿವೊ. <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />ತುಮೆ ಪವಿತ್ರ ಆತ್ಮಾನಿ ಸಹಾಯಕ್ಹು ಕೆಳಾಮಾಬಿ ಕ್ಹುದಾನೆ ಪ್ರಾಥನಾ ಕರ‍್ತಾ ಕ್ಹಾರಿ ತರಾನಾ ಪ್ರಾಥನಾ ಕರೊ ವರಿ ತುಮೊನೆ ಚಾ಼ಯೆ ಥಯಲ ಹುತಿ ಮಾಂಗಿಲಿವೊ. ಇನಾಹುತಿ ಕೆಳಾಮಾಬಿ ತಯ್ಯಾರ ಥೈನ ರ‍್ಹವೊ. ಪ್ರಾಥನಾ ಛೊಡಿನ ದಿವೊ ನಕೊ. ಕ್ಹುದಾನಾ ಮನಕ್ಹುನಾ ಹುತಿ ಕೆಳಾಮಾಬಿ ಪ್ರಾಥನಾ ಕರೊ. <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />ತೆನೈಸೊ ಮಾರಾ ಹುತಿಬಿ ಪ್ರಾಥನಾ ಕರೊ. ಮಿ ಬೊಲ್ತಾಮಾ ಸುವಾರತೆನಿ ರಹಸ್ಯ ಕ್ಹರಿನೆ ಭೆಂವಾಚಿ ಕವಾನೆ ಚಾ಼ಯೆ ಥಯಲ ವಾತೊ ಕ್ಹುದಾ ಮನೆ ದಿವ್ ಕೈನ ಪ್ರಾಥನಾ ಕರೊ. <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />ಸುವಾರ್ತೆ ತಿಳ್ಸಾವಾನುಜ಼ ಮಾರು ಕಾಮ ವ್ಹೈ. ಹಮ್ನಾ ಜೈಲಮಾಬಿ ಮಿ ತೆ ಕಾಮ ಕರಾಡ್ಯೊಸ. ಮಿ ಕಯಾ ತರಾಮಾ ಕರು ತೆಜ಼ ತರಾಮಾ ಭೆಂವಾಚಿ ಬೊಲಾನೆ ಸಾಧ್ಯ ಥಾಯೆ ನಿಂಗತ ಪ್ರಾಥನಾ ಕರೊ.<verse eid="EPH 6:20" /></para>
  <para style="s">ನಮಸ್ಕಾರ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />ಅಪ್ನೊ ಮಯಾನೊ ಭೈ ಥಯಲ ತುಖಿಕನೆ ತುಮೊಕನ ವಳಾವಾಡೊಸ. ತೆ ಪ್ರಭುನಿ ಸೆವಾಮಾ ಬರೊಕ್ಹಾವಾಲೊ ಸೆವಕ ಥಯೊಸ. ನ್ಹ್ಯಾನಾ ಸಂಗತಿಯೊ ಕ್ಹಾರಿಯೊ ತೆ ತುಮೊನೆ ತಿಳ್ಸಾವಸ. ಮಿ ನ್ಹ್ಯಾ ಗಯೊಸ ವರಿ ಸು ಕರಾಡ್ಯೊಸ ಕವಾನು ತೆಳಾಮಾ ತುಮೊನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />ಹಮಾರಿ ಪರಿಸ್ಥಿತಿ ತುಮೊನೆ ಗ್ವತ್ತ ರ‍್ಹೌ ಕವಾನು ಮಾರು ಆಸ ವ್ಹೈ. ತೆನೈಸೊ ತೆ ತುಮೊನೆ ಪ್ರೊತ್ಸಾಹ ಕರಸ.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />ಬಾ ಥಯಲ ಕ್ಹುದಾಕ್ಹು ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತಕ್ಹು ಬರೊಕ್ಹಾಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಭಾಯೊ ವರಿ ಭೆನೊನೆ ಶಾಂತಿ ಮಯಾ ಮಳಾದೆ. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನೆ ಹಮೆಶಾನಿ ಮಯಾಕ್ಹು ಮಯಾ ಕರಾಲಾ ತುಮೊಪರ ಕ್ಹುದಾನಿ ಕೃಪಾ ಹಮೆಶಾಬಿ ರ‍್ಹವಾದೆ.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>