<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Shikkalgar</book>
  <para style="toc3">3 ಯೊಹಾನ</para>
  <para style="toc2">3 ಯೊಹಾನ</para>
  <para style="toc1">3 ಯೊಹಾನ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="mt2">ಯೊಹಾನನು ಬರೆದ ಮೂರನೆಯ ಪತ್ರಿಕೆ</para>
  <para style="mt1">3 ಯೊಹಾನ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ತನವಾ ಯೊಹಾನ ಪತ್ರಿಕೆ ಕಮ್ಸೆ ಕಮ್ಮ ಕ್ರಿ.ಶ. 85-95 ವಚ್ಮಾ ಬರ್ದಲ ಛೆ. ಆಸ್ಯ ಸಿಮೆಮಾ ರ‍್ಹಯಲ ಎಫೆಸಮಾತೊ ಯೊಹಾನ ಎ ಪತ್ರ ಬರ್ದ್ಯೊಸ. ತ್ಯಾನಿ ಸಭೆ ರ‍್ಹಯಲ ಕೆಟ್ಟ ಅಭಿಮಾನ ವರಿ ದುರಹಂಕಾರನಾ ಹುತಿ ಹುಶಾರಕಿ ಕವಾನಾ ಹುತಿ ಬರ್ದಲ ಛೆ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1. ಸಂಚಾರಿ ಸೆವಕೊನೆ ಅತಿಥಿ ಸತ್ಕಾರ <char style="ior"><ref loc="3JN 1:5-8">1:5-8</ref></char></para>
  <para style="io1">2. ಕೆಟ್ಟ ರ‍್ಹಯಲ ಛೊಡಿನ ಚೊ಼ಕು ಪಾಲನ ಕರೊ <char style="ior"><ref loc="3JN 1:9-15">1:9-15</ref></char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />ಸಭೆಮಾ ಮ್ಹೊಟೊ ಥಯಲ ಮಿ ಕ್ಹರಿಕ್ಹು ಮಯಾ ಕರಲ</para>
  <para style="p" vid="3JN 1:1">ಮಯಾನಾ ಭೈನೆ ಗಾಯನನೆ ಬರ್ದಾನು ಪತ್ರ.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />ಮಯಾನಾ, ತು ತಾರಾ ಆತ್ಮನಾ ವಿಷಯಮಾ ಅಭಿವೃದ್ದಿ ಥಯಲ ನಿಂಗತ, ಕ್ಹಾರಾ ವಿಷಯಮಾ ಅಭಿವೃದ್ದಿ ಹೊಂದಿನ ಚೊ಼ಕೊ ಥೈನ ರ‍್ಹೌ ಕೈನ ಮಿ ಪ್ರಾರ್ಥನಾ ಕರುಸ. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />ಕ್ರಿಸ್ತಮಾ ಭಾಯೊ ಥಯಲ ದಕ್ಹಾ ಜ಼ನಾ ಮಕನ ಐನ,ಜಿವ್ನಾಮಾ ರ್ಹವಾನು ಮನೆ ತಿಳ್ಸಾಯಾ. ತು ಕ್ಹರಿನಾ ವಾಟಮಾ ಚಾ಼ಲಾನು ವ್ಹೈ ಕವಾನು ತ್ಯುನೆ ಮನೆ ಕದ್ಯಾ. ಆಂ ಮನೆ ಘನ್ನಿ ಕ್ಹುಶಿ ದಿದ್ಯು. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />ಮಾರಾ ಬಚ್ಚಾ಼ ಕ್ಹರಿನಿ ವಾಟಮಾ ಚಾ಼ಲ್ಯಾಸ ಕವಾನು ಐಕ್ತಾಮಾ ಮನೆ ಘನಿ ಕ್ಹುಶಿ ಥಾವಸ.<verse eid="3JN 1:4" /></para>
  <para style="s">ಗಾಯನ</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />ಮಾರಾ ಮಯಾನಾ ದೊಸ್ತ, ಕ್ರಿಸ್ತಮಾ ಭಾಯೊ ಥಯಲ ವಾಲಾವೊನೆ ತು ಮದತ ಕರಾನು ಚೊ಼ಕು ವ್ಹೈ. ತುನೆ ಗೊತ್ತ ನೈ ರ್ಹಯಲ ಭೈನೆ ತು ಮದತ ಕರಾಡಪಸ! <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />ತ್ಯುನೆ ರ್xಹವಾನು ಮಯಾನಾಹುತಿ ಆಂ ಭಾಯೊ ಸಭೆನೆ ತಿಳ್ಸಾಯಾತ್ಯುನೆ ತ್ಯುನು ಪ್ರಯಾಣ ಅಗಾ ಶುರು ಕರಾನೆ ಮರಗಿನ ತ್ಯುನೊನೆ ಮದತ ಕರ. ಕ್ಹುದಾನೆ ಮೆಚ್ಚಿಗೆ ಥಾವಾನಾ ರಿತಿಮಾ ತ್ಯುನೊನೆ ಮದತ ಕರ. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />ಆಂ ಭಾಯೊ ಕ್ರಿಸ್ತನಾ ಸೆವೆನಾಹುತಿ ಪ್ರಯಾಣನೆ ಚಾ಼ಲ್ಯಾಸ. ಅ ವಿಸ್ವಾಸಿಯೊಕ್ಹು ತ್ಯುನೆ ಕೈಜ಼ ಮದತ ಲಿದ್ಯಾ ನೈ. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />ತಿನಾಹುತಿ, ಹಮೆ ಆಂ ಭಾಯೊನೆ ಮದತ ಕರು. ಹಮೆ ತ್ಯುನೊನೆ ಮದತ ಕರಲ್ಪರ, ಕ್ಹರಿನಾಹುತಿ ತ್ಯುನೆ ಕರಾನಾ ಕಾಮೊಮಾ ಹಮೆ ಪಾಲ ಥಯೆಸ.<verse eid="3JN 1:8" /></para>
  <para style="s">ದಿಯೊತ್ರೆಫ ವರಿ ದೆಮೆತ್ರಿಯ</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />ಮಿ ಸಭೆನೆ ಯಕ್ಕ ಪತ್ರ ಲಿಕ್ಯೊ. ತೆನೈಸೊ ಹಮೆ ಕವಾನು ದಿಯೊತ್ರೆಫನ ಐಕ್ತೊ ನೈ. ತೆ ತೆಜ಼ ಮಾಲಕ ಥೌ ಕೈನ ಕೆಳಾಮಾಬಿ ಇಚ್ಛಾ ಕರಸ. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />ಮಿ ಆಯಲ್ಪರ, ದಿಯೊತ್ರೆಫನ ಕರಾನಾಹುತಿ ತಿಳಸೌಸ. ತೆ ಹಮಾರಾಹುತಿ ಸುಳ್ಳ ವರಿ ಕೆಟ್ಟ ಸಂಗತಿಯೊನೆ ಕವಸ. ತೆನೈಸೊ ತೆಕ್ಲುಜ಼ ನ್ಹವೈ! ಕ್ರಿಸ್ತ ಸೆವಾ ಕರಾಲಾ ತೆ ಭಾಯೊನೆ ಮದತ ಕರಾನೆ ತೆ ವಪ್ತೊ ನೈ. ತೆ ನೈಸೊ ತೆ ಭಾಯೊನೆ ಮದತ ಕರಾಲಾ ಮನಕ್ಹೊನೆ ತೆ ತಡ್ದಸ. ತೆ ಮನಕ್ಹೊ ತೆ ಸಭೆನೆ ಛೊಡಿನ ಜ಼ವಾ ವರಕ್ಹು ಕರಸ.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />ಮಾರಾ ಮಯಾನಾ ದೊಸ್ತ,ಕೆಟ್ಟನೆ ಕರು ನಕೊ; ಚೊ಼ಕುಜ಼ ಕರ. ಚೊ಼ಕು ಕರಾಲೊ ಕ್ಹುದಾನೆ ಸೆರಾಲೊ ಥಯೊಸ.ತೆನೈಸೊ ಕೆಟ್ಟ ಕರಾಲೊ ಕ್ಹುದಾನೆ ಕೈನ ನೈ ತಿಳದಲವಾಲೊ ಥಯೊಸ.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />ಹಮೆ ಬಿ ತುಮೊನೆ ಆ ವಿಷಯಮಾ ಸಾಕ್ಷಿ ದಿವಾಲಾ ವ್ಹೈ; ಹಮಾರಿ ಸಾಕ್ಷಿ ಕ್ಹರಿ ವ್ಹೈ ಕೈನ ತುನೆ ಗೊತ್ತ ಛೆ.<verse eid="3JN 1:12" /></para>
  <para style="s">ವಂದನಾ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />ಮಿ ಬರ್ದಾನಿಯೊ ಸಂಗತಿಯೊ ಘನಿಯೊ ಛೆ. ತೆನೈಸೊ ಮಶಿಲಿನ ಬರ್ದಾನಾ ಯಕ್ಲಿ ಮಸಿಲಿನ ಬರ್ದಾನೆ ಮನೆ ಮನಸ ನತ್ತಿ. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />ಮಿ ಭೆಗಿನ ಐನ ದೆಕುಸ ಕೈನ ಆಸ ಮ್ಹೆಲುಸ. ತೆಳಾಮಾ ಅಪೆ ಕ್ಹಾಮಾಜ಼ ಬೊಲಿಯೆ.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />ತುನೆ ಸಮಾಧಾನ ರ‍್ಹವಾದೆ. ದೊಸ್ತೊ ತುನೆ ವಂದನೆ ಕರ‍ಸ.</para>
  <para style="p" vid="3JN 1:15">ತ್ಯಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ದೊಸ್ತೊನೆ ವಂದನೆ ಕೆ.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>