<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Shikkalgar</book>
  <para style="toc3">3 ಯೊಹಾನ</para>
  <para style="toc2">3 ಯೊಹಾನ</para>
  <para style="toc1">3 ಯೊಹಾನ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="mt2">ಯೊಹಾನನು ಬರೆದ ಮೂರನೆಯ ಪತ್ರಿಕೆ</para>
  <para style="mt1">3 ಯೊಹಾನ ಬರ್ದಲ ಪತ್ರ</para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>ಸಭೆಮಾ ಮ್ಹೊಟೊ ಥಯಲ ಮಿ ಕ್ಹರಿಕ್ಹು ಮಯಾ ಕರಲ ಮಯಾನಾ ಭೈನೆ ಗಾಯನನೆ ಬರ್ದಾನು ಸುವೈ ಕದ್ಯಾಮ ; <verse eid="3JN 1:1"/><verse number="2" style="v" sid="3JN 1:2"/>ಮಯಾನಾ, ತು ತಾರಾ ಆತ್ಮನಾ ವಿಷಯಮಾ ಅಭಿವೃದ್ದಿ ಥಯಲ ನಿಂಗತ, ಕ್ಹಾರಾ ವಿಷಯಮಾ ಅಭಿವೃದ್ದಿ ಹೊಂದಿನ ಚೊ಼ಕೊ ಥೈನ ರ‍್ಹೌ ಕೈನ ಮಿ ಪ್ರಾರ್ಥನಾ ಕರುಸ. <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>ಭಾಯೊ ತೆಳಾಮಾ-ತೆಳಾಮಾ ಮಕನ ಐನ, ತುಕನ ರ‍್ಹಯಲ ಕ್ಹರಿನಾ ವರಿ ತು ಕ್ಹರಿಕ್ಹು ಚಾ಼ಲಿನ ಜಾ಼ವಾನಾ ಹುತಿ ಮಕನ ಕತಾಮಾ ಮಿ ಖುಶಿ ಥೌಸ. <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>ಮಾರಾ ಬಚ್ಚಾ ಕ್ಹರಿ ಲಿಂಗತ ಚಾ಼ಲಿನ ಜಿವ್ನಾ ಕರಾಡಾಸ ಕೈನ ಐಕಿನ ಥಯಲ ಖುಶಿ ಯಕ್ಲಿ ಬಿಜಿ ಖುಶಿ ನತ್ತಿ.<verse eid="3JN 1:4"/></para>
  <para style="s">ಗಾಯನ</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>ಮಯಾನಾ, ವಳಕ ನೈಸೊ ವಾಲಾ ಭಾಯೊನೆ ತು ಮರ್ಯಾದಿ ದಿವಾನೆ ಬರೊಕ್ಹೊ ಕರಾಲಾನೆ ಯೊಗ್ಯ ಥೈನ ರ‍್ಹಶಿ. <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>ತ್ಯುನೆ ಸಭೆನಾ ಕ್ಹಾಮ್ಮಾ ತು ದೆಕ್ಲಾಡೆಲ ಮಯಾನಾ ಹುತಿ ಸಾಕ್ಷಿ ಕದ್ಯಾ. ತ್ಯುನೊನೆ ತು ಕ್ಹುದಾನಾ ಸೆವಕೊನೆ ಯೊಗ್ಯ ರ‍್ಹಯಲ ತರಿಕಾಮಾಜ ಅಗು ಬಡಾವಾನು ಚೊ಼ಕು ರ‍್ಹವಸ. <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>ಕಾ ಕದ್ಯಾಮ ತ್ಯುನೆ ಕ್ರಿಸ್ತನಾ ನಾಮನೆ ಪ್ರಚಾರ ಕರಾನಾ ಹುತಿ ಚಾ಼ಲ್ಯಾಸ. ಬಿಜಾ ಮನಕ್ಹೊ ಕಂತ್ತಾ ಸುಜ಼ ಲಿವಾಲಾ ನ್ಹೈ. <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>ತಿನಾಹುತಿ, ಹಮೆ ಕ್ಹರಿಜನೆ ಸಹಾಕಾರಿ ಥೈವ ಕೈನ ತೆವಾವೊನೆ ಮಳಲಿವಾನು ಮುಲಾಜಾಮ್ಮಾ ಛೆ.<verse eid="3JN 1:8"/></para>
  <para style="s">ದಿಯೊತ್ರೆಫ ವರಿ ದೆಮೆತ್ರಿಯ</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>ತೆ ನೈಸೊ ಸಭೆಮಾ ಮ್ಹೊಟೊ ಥೈನ ರ‍್ಹೌಸ ಕವಾಲೊ ದಿಯೊತ್ರೆಫನ ಹಮಾರಿಯೊ ವಾತೊ ವಪ್ಪಿಲೆತೊ ನೈ. ತಿನಾಹುತಿ ಮಿ ಆಯೊಮ ತೆ ಕರಾನಾ ಕಾಮೊನಾ ಹುತಿ ಕ್ಹಾರಾವೊನೆ ಶೆ ದಿಲೌಸ. <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>ತೆ ಫಾಲತು ಕಾಮ ಕರಾಲೊ, ಹಮಾರಾ ವಿಷಯಮಾ ಕೆಟ್ಟ ಪ್ರಚಾರ ಕರಾಡ್ಯೊಸ. ಯಕ್ಲುಜ ನೈಸೊ ತೆ ತಿನಾ ಭಾಯೊನಾ ತಿನಾ ಕ್ಹಾತೆ ರ್xಔ ಕವಾಲಾವೊನೆ ಅಡ್ಡ ಕರಿನ ಸಭೆಮಾತೊ ಬಾರೊ ಕಾಡಸ. ಮಯಾನಾ ತು ಕೆಟ್ಟ ಚಾಳಿ ಪಾಲ್ಶಾವಾಚಿ ಚೊ಼ಕಿ ಚಾಳಿಯೊ ಪಾಲಸ. <verse eid="3JN 1:10"/><verse number="11" style="v" sid="3JN 1:11"/>ಚೊ಼ಕು ಕರಾಲೊ ಕ್ಹುದಾಕ್ಹು ಹುಟ್ಟಲವಾಲೊ ವ್ಹೈ. ಕೆಟ್ಟ ಕರಾಲೊ ಕ್ಹುದಾನೆ ದೆಕಲವಾಲೊ ನ್ಹ ವ್ಹೈ. ದೆಮೆತ್ರಿ ಭೊಳೊ ವ್ಹೈ ಕೈನ ಕ್ಹಾರಾವೊನಾ ಕ್ಹಾಮೊಜ಼ ಸಾಕ್ಷಿ ಥಯೊಸ. <verse eid="3JN 1:11"/><verse number="12" style="v" sid="3JN 1:12"/>ಹಮೆ ಬಿ ತುಮೊನೆ ಆ ವಿಷಯಮಾ ಸಾಕ್ಷಿ ದಿವಾಲಾ ವ್ಹೈ; ಹಮಾರಿ ಸಾಕ್ಷಿ ಕ್ಹರಿ ವ್ಹೈ ಕೈನ ತುಮೆ ಗೊತ್ತ ಛೆ.<verse eid="3JN 1:12"/></para>
  <para style="s">ವಂದನಾ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>ಮಿ ಬರ್ದಾನಿಯೊ ಸಂಗತಿಯೊ ಘನಿಯೊ ಛೆ. ತೆ ನೈಸೊ ಮಶಿಲಿನ ಬರ್ದಾನಾ ಯಕ್ಲಿ ಮಸಿಲಿನ ಬರ್ದಾನೆ ಮನೆ ಮನಸ ನತ್ತಿ. <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>ಮಿ ಭೆಗಿನ ಐನ ದೆಕುಸ ಕೈನ ಆಸ ಮ್ಹೆಲುಸ. ತೆಳಾಮಾ ಅಪೆ ಕ್ಹಾಮಾಜ಼ ಬೊಲಿಯೆ. <verse eid="3JN 1:14"/><verse number="15" style="v" sid="3JN 1:15"/>ತುನೆ ಸಮಾಧಾನ ರ‍್ಹವಾದೆ. ದೊಸ್ತೊ ತುನೆ ವಂದನೆ ಕರ‍್ಯಾಸ. ತ್ಯಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ದೊಸ್ತೊನೆ ವಂದನೆ ಕೆ.<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
