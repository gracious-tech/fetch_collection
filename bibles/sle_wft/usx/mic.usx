<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Sikkiligar</book>
  <para style="h">ಮಿಕ</para>
  <para style="toc3">ಮಿಕ</para>
  <para style="toc2">ಮಿಕ</para>
  <para style="toc1">ಮಿಕ ಬುಕ್ಕ</para>
  <para style="mt2">ಮಿಕಾ</para>
  <para style="mt1">ಮಿಕಾ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಎ ಪುಸ್ತಕಮಾ ಮಿಕಾನಿ ಪ್ರವಾದನೆ ಛೆ. ಮಿಕಾ ಯುದಾಯಮಾ ಮೊರೆಶತ್ತ ಕವಾನು ಗಾಮವಾಲೊ ವ್ಹತೊ. <char style="xt"><ref loc="MIC 1:1">1:1</ref> </char>ವರಿ <char style="xt"><ref loc="JER 26:18">ಯೆರೆಮಿಯಾ 26:18</ref></char>. ಎ ಯುದಾಯನೊ ರಾಜಾ಼ ಥಯಲ ಯೊಥಾಮ, ಅಹಾಜ಼ ಹಿಜ್ಕಿಯ ಇವ್ನಾ ಆಳ್ವಿಕೆನಾ ವಕ್ಹತಮಾ ಪ್ರವಾದನೆ ಕರ‍್ಯೊ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಇನೆ ಸೆವೆ ಕಮ್ಸಿ ಕಮ್ಮ ಕ್ರಿಸ್ತ ಪುರ್ವ 750 ಬಿ.ಸಿ. ಮತ್ತು 700 ನಾ ವಚ್ಮಾ಼ ವ್ಹೈ. ಎ ವಕ್ಹತ ಯೆಶಾಯ ವರಿ ಹೊಶೆಯ ಪ್ರವಾದಿಯೊನಾ ವಕ್ಹತನೆ ನಜಿಕ ವ್ಹತು ಎ ಪ್ರವಾದನೆ ಸ್ವಂತ ಮಿಕಾಜ಼ ಬರದ್ಯೊವಸ ನೈತೊ ತಿನಾ ಬಗಲ್ತಾ ತಿನಾ ಶಿಶ್ಯಾ ಬರದ್ಯಾವಸ ಕೈನ ಕವಾನು ಗ್ವತ್ತ ನತ್ತಿ. ಸುಬಿ ರ‍್ಹವಾದೆ ಎ ಪುಸ್ತಕ ಕಮ್ಸೆ ಕಮ್ಮ ಕ್ರಿಸ್ತ ಪುರ್ವ ಕ್ರಿ.ಪೂ. 700 ನಾ ವಚ್ಮಾ಼ ಬರ್ದಲ ವ್ಹೈ. ವರಿ 608 ಕ್ರಿ.ಪೂ. ವಚ್ಮಾ಼ ಬರ್ದಲ ವ್ಹೈ. ಕಾ ಕದ್ಯಾಮ ಯೆರೆಮಿಯಾನಾ ಪುಸ್ತಕಮಾ ಎ ಕದ್ಯಾಸ. ಮಿಕಾನಿ ಪ್ರಾವಾದನೆ ಕ್ಹುದಾನೊ ಫೈಸ್ಲೊ ವರಿ ಛೊಡಾವಾನಾ ವಚ್ಮಾ಼ ಅಗೊ ತ್ಯುನಾಹುತಿ ಬೊಲಸ. ತೆ ಇಸ್ರಾಯೆಲ ವರಿ ಯುದ್ದನೆ ಗರಿಬೊನೆ ಕರಾನು ವರಿ ಜಾಸ್ತಿ ಆಶೆ ಕರಾನು ಅಪವಾದ ಕರಸ.<char style="xt"><ref loc="MIC 2:2">2:2</ref>.</char> ತೆ ವರಿ ತ್ಯುನಾ ಪ್ರಾವಾದನೆ ಭ್ರಷ್ಟವ್ಹತಾ ಕೈನ ಅಪವಾದ ಕರಸ. 2:6 ತಿನಾಹುತಿ ಕ್ಹುದಾ ತ್ಯುನಾ ಗಾಮೊನೆ ನಾಶ ಕರಸ. <char style="xt"><ref loc="MIC 1:6">1:6</ref></char> ವರಿ <char style="xt"><ref loc="MIC 3:12">3:12</ref></char> ವರಿ ತ್ಯುನೊನೆ ಇಸ್ರಯೆಲತಾ ದುರ ವರಿ ಯುದ್ದಕ್ಹುಬಿ ಗುಲಾಮಗಿರಿಮಾತೊ ವಶ ಕರ್ಲಿವಸ. ತೆ ನೈಸೊ ಕ್ಹುದಾ ತಿನು ವಾಗ್ದನಬಿ ಶೆ ಕರಿಲಿವಸ ವರಿ ದಕ್ಹಾ ಬರೊಕ್ಹಾವಾಲಾವೊನೆ ಭಾರೊ ಲಾವಸ.<char style="xt"><ref loc="MIC 4:6">4:6</ref>.</char> ಕ್ಹುದಾ ಬೆತ್ಲೆಹೆಮ್ಮತೊ ಯಕ್ಕ ಮ್ಹೊಟಾ ಮನಕ್ಹನೆ ಯಕ್ಕ ಮಸ್ಸಿಹಾನೆ ಮೊಕ್ಲುಸ ವರಿ ತೆ ಇಸ್ರಾಯೆಲೊಪರ ವರಿ ಕ್ಹಾರಿ ದುನಿಯಾಪರ ಆಳ್ವಿಕೆ ಕರಸ ಕೈನ ವಾಗ್ದಾನ ಕರ‍್ಯೊ. <char style="xt"><ref loc="MIC 5:4">5:4</ref>.</char> ಮಿಕಾನು ಪುಸ್ತಕ ಅಬ್ರಹಾಮ ವರಿ ಯಾಕೊಬನಾ ಕ್ಹಾತೆಕ್ಹುದಾ ಕರಿಲಿದಲ ಒಡಂಬಡಿಕೆನು ವಾಗ್ದಾನ ಶೆ ಕರಿಲೆತೊ ಮಗ್ಸಾವಸ. ಕ್ಹುದಾನಿ ಮಯಾ ವರಿ ಮರ್ಗಾ ತಿನಿ ಶಿಟ್ಟತಿಬಿ ತಾಕವರ ಥೈಸ.ಅಬ್ರಹಾಮ ವರಿ ಯಾಕೊಬನೆ ಕ್ಹುದಾನಿ ಒಡಂಬಡಿಕೆನಿ ಶೆನಾ ಹುತಿ ಮಿಕಾ ಪುಸ್ತಕ ಲಾಸ್ಟ ಥಾವಸ. ಕ್ಹುದಾನಿ ಮಯಾ ವರಿ ಮರ್ಗಾ ತಿನಿ ಶಿಟ್ಟತಿಬಿ ಘನ್ನಿ ತಾಕತ ಥೈಸ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1. ಅಧ್ಯಾಯ<char style="ior"><ref loc="MIC 1">1</ref> </char>ವರಿ<char style="ior"><ref loc="MIC 2">2</ref></char> ಫೈಸ್ಲೊ ವರಿ ಛೊಡಾವಾನು ಪೈಲಾ ವಿಭಾಗಮಾ ಛೆ.</para>
  <para style="io1">2. 3 ತಾ <char style="xt"><ref loc="MIC 5">5</ref></char> ಲಕ್ಕಾ ಅಧ್ಯಾಯಾ ಫೈಸ್ಲೊ ವರಿ ಛೊಡಾವಾನು ಬೆವಾ ವಿಭಾಗಮಾ ಛೆ.</para>
  <para style="io1">3. ಅಧ್ಯಾಯ <char style="xt"><ref loc="MIC 6">6</ref></char> ವರಿ<char style="xt"><ref loc="MIC 7">7</ref></char> ಫೈಸ್ಲೊ ವರಿ ಛೊಡಾವಾನು ತನ್ವಾ ವಿಭಾಗಮಾ ಛೆ.</para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="s">ಸಮಾರ್ಯಾ ವರಿ ಯರುಸಲೆಮನೆ ಅಗು ಥಾವಾನು ನಾಶ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />ಸಮಾರ್ಯಾ ವರಿ ಯೆರುಸೆಲಮನೆ ಥಾವಾನೆ ನಾಶನಾಹುತಿ ಕವಾನು ಯಹೊವಾನಾ ವಾತೊ ಮಿಕಾನೆ ಐಕು ಆಯಾ. ರಾಜೊ಼ ಥಯಲ ಯೊಥಾಮ, ಅಹಾಮ ವರಿ ಹಿಜ್ಕಿಯವಾಲಾವೊನಿ ಆಳ್ವಿಕೆನಾ ಟೈಮಮಾ ಎ ಥಯು. ಇವ್ನೆ ಯಹುದ ರಾಜ್ಯನಾ ರಾಜಾ಼ವೊ ವ್ಹೈ. ಮಿಕ ಮೊರೆಷೆತವಾಲೊ ವ್ಹೈ. ತೆ ಸಮಾರ್ಯ ವರಿ ಯೆರುಸಲೆಮನಾ ವಿಷಯಮಾ ದರ್ಶನ ದೆಕ್ಯೊ.<verse eid="MIC 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />ಕ್ಹಾರಾ ಮನಕ್ಹೊ, ಐಕೊ!</para>
  <para style="q2" vid="MIC 1:2">ಜಿಮಿನಬಿ ತಿಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಜ಼ನಾ ಐಕೊ! ಮಾರೊ ಮಾಲಕ ಥಯಲ ಯಹೊವಾ ತಿನಾ ಪವಿತ್ರ ಆಲಯಮಾತೊ ಆವಸ.</para>
  <para style="q1" vid="MIC 1:2">ತುಮಾರಾ ವಿರುದ್ದ ಸಾಕ್ಷಿ ಥೈನ ತೆ ಆವಸ. <verse eid="MIC 1:2" /><verse number="3" style="v" sid="MIC 1:3" />ಯಹೊವಾ ತಿನಾ ಪರಿಶುದ್ಧ ಜ಼ಗಾತೊ ಹೆಟೊ ಆವಾನು ದೆಕೊ. ತೆ ದುನಿಯಾನಾಮಾ ರ‍್ಹಯಲ ಉಚ್ಚಿ ಜ಼ಗಾಪರ ಚಾ಼ಲಾನೆ ಆವಾಡೊಸ.<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />ಆಗಮಾ ಮೆಣಬತ್ತಿ ಕರ್ಗೆಲಿಂಗತ ಡೊಂಗರೊ ತಿನಾ</para>
  <para style="q2" vid="MIC 1:4">ಪಗೊನಾ ಹೆಟಾ ಕರ್ಗಿ ಜಾ಼ವಸ.</para>
  <para style="q1" vid="MIC 1:4">ಖಾಡಿಯೊ ಜು಼ದಿಯೊ ಥೈನ ಪಾನಿ ಲಿಂಗತ</para>
  <para style="q2" vid="MIC 1:4">ನ್ಹಾನಿಯೊ ವಾಟೊತಾ ಜೊ಼ರ ಹರ್ದಿನ ಜಾ಼ವಸ.<verse eid="MIC 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 1:5" />ಎ ಕ್ಹಾರಾನೆ ಕಾರಣ ಯಾಕೊಬನಾ ಪಗೊಜ಼ ವ್ಹೈ, ಇಸ್ರಾಯೆಲವಾಲಾವೊನಾ ಮೊಸಜ಼ ವ್ಹೈ! ಯಾಕೊಬ ಪಾಪ ಕರಲಕ್ಹು ಕಾರಣ ಸು ವ್ಹೈ? ಸಮಾರ್ಯಜ಼ ಕಾರಣ ವ್ಹೈ. ಯಹುದನು ಉನ್ನತ ಜ಼ಗಾ ಕೈ ವ್ಹೈ? ತೆಜ಼ ಯೆರುಸಲೆಮ ವ್ಹೈ! <verse eid="MIC 1:5" /><verse number="6" style="v" sid="MIC 1:6" />ತಿನಾಹುತಿ ಮಿ ಸಮಾರ್ಯನೆ ದಗ್ಡಾವೊನಿ ರಾಶಿ ಕರುಸ. ತೆ ದ್ರಾಕ್ಷಿಯೊನಿ ಬಳ್ಳಿ ಘಾಲಾನೆ ತಯ್ಯಾರ ಥಾವಸ. ಸಮಾರ್ಯನಾ ಕ್ಹಾರಾ ದಗ್ಡಾವೊನೆ ಖಾಡಿಮಾ ನಾಕಿಪಡುಸ; ತೆಳಾಮಾ ತ್ಯಾ ಖಾಲಿ ಫಾಂಯಾಜ಼ ದಿಕ್ಹಸ. <verse eid="MIC 1:6" /><verse number="7" style="v" sid="MIC 1:7" />ತಿನಾ ಕ್ಹಾರಾ ಮುರ್ತಿಯೊ ಫೊಡಿನ ಪುಡಿ ಥಾವಸ. ತಿನಾ ವ್ಯಬಿಚಾರಿನಾ ದೊಕ್ಡಾ ಆಗಮಾ ಬಳಿ ಜಾ಼ವಸ. ತಿನಾ ಸುಳ್ಳ ಕ್ಹುದಾವೊನಾ ಕ್ಹಾರಾ ಮುರ್ತಿಯೊನೆ ನಾಶ ಕರುಸ. ಕಾಕದ್ಯಾಮ ಸಮಾರ್ಯ ಮನೆ ಬರೊಕ್ಹೊ ನೈ ರ‍್ಹಯಲವಾಲಾ ಥೈನ ಸೌಕಾರ ಥೈ. ಮನೆ ನೈ ಬರೊಕ್ಹೊ ಕರಾಲಾ ಕ್ಹಾರಾ ತಿಕಂತು ತೆ ಕಾಳ್ಳಿವಸ.<verse eid="MIC 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 1:8" />ಅಗಾ ಥಾವಾನಾ ಘಟನೆನಾಹುತಿ ಮಿ ಘನ್ನು ದುಖಿ ಥಯೊಸ. ಮಿ ವಣ್ಣಾ ರ‍್ಹವಾದೆ ಕಾರಮಲಿಯೊ ರ‍್ಹವಾದೆ ಘಾಲ್ಲಿದ್ಯಾವಾಚಿ ಜೌ಼ಸ. ನರಿ ಲಿಂಗತ ರೌಸ, ಉಲ್ಲು ಪಕ್ಷಿ ಲಿಂಗತ ಗೊಳಾಡುಸ. <verse eid="MIC 1:8" /><verse number="9" style="v" sid="MIC 1:9" />ಸಮಾರ್ಯನು ದುಕ್ಕ ಅರಾಮ ಥಾತು ನೈ. ತಿನು ರೊಗ ಯೆಹುದನೆ ಫೈಲ್ಯುಸ. ತೆ ಮಾರಾ ಮನಕ್ಹೊನಾ ಗಾಮತು ಯೆರುಸಲೆಮ ಲಕ್ಕಾ ಫೈಲ್ಯಲ ಛೆ.<verse eid="MIC 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 1:10" />ಇನೆ ಗತ್ತ ಮಾ ತಿಳ್ಸಾವೊ ನಕೊ, ವರಿ ರವೊ ನಕೊ. ಬೆತ ಒಫ್ರದ ಧುಳಮಾ ಉಳ್ಳಾಡೊ, <verse eid="MIC 1:10" /><verse number="11" style="v" sid="MIC 1:11" />ಶಾಫಿರ ಮಾ ರ‍್ಹವಾಲಾ, ಉಗಾಡಾ ಥೈನ ಸರಮಕ್ಹು ಚಾ಼ಲೊ. ಚಾನಾನ್ ಮಾ ರ‍್ಹವಾಲಾ ಭಾರಾ ಆತಾ ನೈ. ಬೆತೆಚೆಲಮಾನಾ ಮನಕ್ಹೊ ರವಸ, ತುಮೊನೆ ತ್ಯುನೆ ದೆತಾ ರ‍್ಹಯಲ ಪ್ರೊತ್ಸಾಹ ಪಾಚಾ಼ ಲಿವಸ. <verse eid="MIC 1:11" /><verse number="12" style="v" sid="MIC 1:12" />ಮಾರೊತ್ ಮಾ ರ‍್ಹವಾಲಾ ಮನಕ್ಹೊ ಕಮ್ಜೊರ ಥಯಾಸ. ತ್ಯುನೆ ಚೊ಼ಕಿ ಸುವಾರ್ತೆನಾಹುತಿ ಕೈದಾಡಾಸ. ಕಾಕದ್ಯಾಮ ಯೆರುಸಲೆಮ ಗಾಮನಾ ಬಾಕಲೊಕನ ಯಹೊವಾಕ್ಹು ಮುಶ್ಕಿಲ ಐಸ. <verse eid="MIC 1:12" /><verse number="13" style="v" sid="MIC 1:13" />ಲಾಕಿಷಮಾ ರ‍್ಹವಾಲಾ, ಜೊ಼ರ ನ್ಹಾಟಾನಾ ಘೊಡಾನೆ ತಾರಿ ರಥೊನೆ ಭಾಂದೊ. ಚಿಯೊನನು ಪಾಪ ಲಾಕಿಷಮಾ ಶುರು ಥಯು. ಕಾಕದ್ಯಾಮ ತು ಇಸ್ರೆಲನು ಪಾಪ ವರಿ ದ್ರೊಹ ಕರ‍್ಯೊಸ. <verse eid="MIC 1:13" /><verse number="14" style="v" sid="MIC 1:14" />ತಿನಾಹುತಿ ಮೊರೆಷತ್ತಮಾ ರ‍್ಹವಾನಾ ಗತ್ತನೆ ನೆ ದಿವಾನಾ ಕಾಣಿಕೆನೆ ದೆ.ಅಕ್ವಿಬಿನಾ ಕುಟುಂಬೊ ಇಸ್ರೆಲ ರಾಜಾ಼ವೊನೆ ಮೊಸ ಥಾವಸ.<verse eid="MIC 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MIC 1:15" />ಮಾರೆಷಮಾ ರ‍್ಹವಾಲಾ ಮನಕ್ಹೊ, ತುಮೊನೆ ವಿರುದ್ದ ಥೈನ ಮಿ ನಾಯಕೊನೆ ಬಲೌಸ. ತೆ ತುಮೊಕನ ರ‍್ಹವಾನಾ ಸಾಮನೊ ಕಿತ್ತಿ ಲಿವಸ. ಇಸ್ರೆಲನಿ ವೈಭವ ಅದುಲ್ಲಾಮಿನೆ ಆವಸ. <verse eid="MIC 1:15" /><verse number="16" style="v" sid="MIC 1:16" />ತಾರಾ ಬಾಲೊ ಬೊಳ್ಸಿಲೆ; ಕಾಕದ್ಯಾಮ ತು ಮಯಾ ಕರಾನಾ ಬಚ್ಚಾ಼ವೊನಾಹುತಿ ತು ರೊಶಿ. ರಣಹದ್ದ ಲಿಂಗತತಾರು ಮಾತು ಟಕ್ಲು ಥಾವಾದೆ. ತಾರಾ ದುಖನೆ ದೆಕಾಡ. ಕಾಕದ್ಯಾಮ ತಾರಾ ಬಚ್ಚಾ಼ತುಕ್ಹು ಉದಾಳಿಲಿವಸ.<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s">ಇಸ್ರಾಯಲನು ಪಾಪ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 2:1" />ಪಾಪ ಕರಾನೆ ವಿಚಾರ ಕರಾಲಾನೆ ಸಂಕಟ ಆವಸ. ಇವ್ನೆ ವಚ್ಚಾನಾಪರ ಪಡಿನ ಪಾಪ ಕರಾನೆ ವಿಚಾರ ಕರಸ. ಪಾಟೆ ಸುರ್ಯೊ ಹುಟ್ತಾಮಾ ತ್ಯುನೆ ವಿಚಾರ ಕರಲ ಪಾಪೊನೆ ಕಾಮ ನಿಂಗತ ಕರಸ ಕಾ? ಕಾಕದ್ಯಾಮ ತ್ಯುನೊನೆ ತ್ಯುನಾ ಇಷ್ಟಾನಿಂಗತ ಚಾ಼ಲಾನೆ ತಾಕತ ಛೆ. <verse eid="MIC 2:1" /><verse number="2" style="v" sid="MIC 2:2" />ತ್ಯುನೊನೆ ಕ್ಹೆತರೊನಾ ಗಾದಿಯೊ ಚಾ಼ಯೆ, ತಿನೆ ತ್ಯುನೆ ಲಿವಸ. ತ್ಯುನೊನೆ ಘರೊ ಚ಼ಾಯೆ, ತಿನೆ ತ್ಯುನೆ ಲಿವಸ. ಯಕ್ಲಾನೆ ಮೊಸ ಕರಿನ ತಿನೆ ಘರನೆ ಕಾಳ್ಳಿವಸ. ಹಜಿಯಕ್ಲಾನೆ ಮೊಸ ಕರಿನ ತಿನಾ ಕ್ಹೆತರನಾ ಗಾದಿಯೊ ಕಾಳ್ಳಿವಸ.<verse eid="MIC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3" />ತಿನಾಹುತಿ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ: ದೆಕೊ, ಮಿ ಆಂ ಕುಟುಂಬನಾ ವಿರುದ್ದ ಕಷ್ಟ ಲಾವಾನೆ ವಿಚಾರ ಕರಾಡೊಸ. ತುನೆ ತು ವಚಾ಼ಡಿ ಲಿವಾನೆ ಸಾದ್ಯ ರ‍್ಹತು ನೈ. ಕೆಟ್ಟ ದಿನೊ ಆವಾನಾಹುತಿ ತುಮೆ ಫುಗ್ಗಾನು ಹುಬ್ರಾಡೊಸಿ. <verse eid="MIC 2:3" /><verse number="4" style="v" sid="MIC 2:4" />ತೆಳಾಮಾ ಮನಕ್ಹೊ ತುಮಾರಾಹುತಿ ಗಿದ್ದ ಕವಸ. ಮನಕ್ಹೊ ಶೊಕ ಗಿದ್ದ ಕವಸ. ಹಮೆ ನಾಶ ಥಯಾ! ಯಹೊವಾ ಹಮಾರಾ ದೆಶ ಲಿನ ಬಿಜಾ಼ ಮನಕ್ಹೊನೆ ದಿದ್ಯೊ. ಹೊ, ತೆ ಅಪ್ನಿ ಜಿಮಿನ ಅಪೊಕಂತಿ ಕಾಳ್ಳಿಲಿದ್ಯೊ, ಹಮಾರಾ ಗಾದಿಯೊನೆ ಅಪ್ನಾ ದುಶ್ಮನೊನಾ ಹತ್ಮಾ ದಿದ್ಯೊ.<verse eid="MIC 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 2:5" />ಹಮ್ನಾ ಅಪೆ ಅಪ್ನಿ ಜಿಮಿನ ಅಳತಿ ಕರಿನ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ ವಾಟಾನೆ ಥಾತು ನೈ.<verse eid="MIC 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 2:6" />ಮನಕ್ಹೊ, ತು ಮನೆ ಕೌ ನಕೊ, ತೆ ಕೆಟ್ಟ ವಿಷಯೊನೆ ಹಮೊನೆ ಕೌ ನಕೊ, ಹಮೊನೆ ಕಯಾಜ ಕೆಟ್ಟ ವಿಷಯೊ ಸೆರತಾ ನೈ ಕೈನ ಕವಸ. <verse eid="MIC 2:6" /><verse number="7" style="v" sid="MIC 2:7" />ತೆನೈಸೊ ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊ, ಮಿ ತುಮೊನೆ ಕೌಜ಼. ತುಮಾರಾ ದುಷ್ಟನಾಹುತಿ ಯಹೊವಾ ತಿನು ತಾಳ್ಮೆ ಜ಼ವೈಲಿದ್ಯೊಸ? ತುಮೆ ಫೈಸಲಾ ತರಿಕಾಮಾ ಜಿವ್ನಾ ಕರ್ತಾ ರ‍್ಹಯಾರೆ ಮಿ ತುಮೊನೆ ಚೊ಼ಕಾ ಸಂಗತಿಯೊ ಕತೊತೊ?<verse eid="MIC 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 2:8" />ತೆನೈಸೊ ಮನೆ ದುಶ್ಮನ ನಿಂಗತ ಉಟಿನ ಹುಬ್ರಯಲ ಮಾರಾ ಮನಕ್ಹೊ, ತುಮೆ ದಾಟಿನ ಜಾ಼ವಾಲಾವೊನಾ ವಣ್ಣಾವೊನೆ ತ್ಯುನಾ ಪಿಟ್ಟಪರ್ತಾ ಕಿತ್ತಿಲಿವೊ. ನಿಭರ್ಯ ಥೈನ ನ್ಹಾಟಾಲಾ ಮನಕ್ಹೊ ಕಂತು ಕೈದಿಯೊ ವ್ಹೈಕೈನ ಛಿಲ್ಲಿ ಲಿವೊಸಿ. <verse eid="MIC 2:8" /><verse number="9" style="v" sid="MIC 2:9" />ಮಾರಾ ಮನಕ್ಹೊ ಬಾಕ್ಡಿಯೊ ಹತ್ಮಾತಾ ಚೊ಼ಕಾ ರ‍್ಹಯಲ ಘರೊನೆ ಕಾಳ್ಳಿಲಿದ್ಯಾಸ; ತ್ಯುನಾ ನ್ಹಾನಾ ಬಚ್ಚಾವೊಕಂತು ಮಾರಿ ಆಸ್ತಿನೆ ಹಮೆಶ್ಯಾನಾಹುತಿ ಕಾಳ್ಳಿಲಿದ್ಯಾಸ. <verse eid="MIC 2:9" /><verse number="10" style="v" sid="MIC 2:10" />ಉಟಿನ ಆಂ ಜ಼ಗಾ ಛೊಡಿನ ಜಾ಼. ಆಂ ತಾರಿ ಅರಾಮ ಕರಾನಿ ಜ಼ಗಾ ನ್ಹವೈ, ಕಾ ಕದ್ಯಾಮ ತು ಇನೆ ಹಾಳ ಕರ್ಯೊಸ. ತು ಇನೆ ಹೊಲಸ ಕರ್ಯೊಸ, ತಿನಾಹುತಿ ಎ ನಾಶ ಥಾವಸ; ಘನಾ ಕೆಟ್ಟ ತರಿಕಾಮಾ ಹಾಳ ಕರಸ. <verse eid="MIC 2:10" /><verse number="11" style="v" sid="MIC 2:11" />ಆಂ ಮನಕ್ಹೊ ಮಾರಾ ವಾತೊ ಐಕಾನೆ ಪಸಂದ ಕರ್ತಾ ನೈ. ತೆನೈಸೊ ಬಿಜ಼ಯಕ್ಲಾನಾ ಸುಳ್ಳ ವಾತೊ ಐಕಾನೆ ಪಸಂದ ಕರಸ. ಸುಳ್ಳ ಪ್ರವಾದಿಯೊ ಐನ , ತುಮೊನೆ ಚೊ಼ಕು ಭವಿಶ್ಯ ಛೆ ಚಾ಼ಯೆಅಕ್ಲು ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ, ದಾರುಬಿ ತುಮೊನೆ ಮಳಸ. ಕೈನ ಕದ್ಯಾರೆ ತ್ಯುನೆ ತಿನೆ ನಂಬಿ ಸಿಕ್ವಾರ ಕರಸ.<verse eid="MIC 2:11" /></para>
  <para style="s">ಇಸ್ರಾಯೆಲನಿ ವಚಾ಼ಡಾನಾ ಹುತಿ ವಾಗ್ದಾನ</para>
  <para style="p">
    <verse number="12" style="v" sid="MIC 2:12" />ಯಾಕೊಬನ ಮನಕ್ಹೊ, ಮಿ ತುಮೊನೆ ಯಕ್ಕಜ ಜ಼ಗಾಜ಼ ಮಳೌಸ. ಇಸ್ರಾಯಲಮಾ ಉಗ್ರಲವಾಲಾವೊನೆ ಯಕ್ಕಜ ಜ಼ಗಾ ಮಳೌಸ. ಹಟ್ಟಿಮಾ ಬಕ್ರಾವೊನೆ ಸೆರಸಾವಾ ನಿಂಗತ, ಚಾ಼ರೊಮಾ ಯಕ್ಕ ಜ಼ಗಾ ಮಳಾವಸ. ತೆಳಾಮಾ ತೆ ಜ಼ಗಾ ಮನಕ್ಹೊನಾ ಗದ್ದಲಕ್ಹು ಭರಿಜಾ಼ವಸ. <verse eid="MIC 2:12" /><verse number="13" style="v" sid="MIC 2:13" />ತೆಳಾಮಾ ಮಾರಾಲೊ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮೊ ಕ್ಹಾಮೊ ಗೈನ ಬಾಕಲೊನೆ ಫೊಡಲ್ಪರ ಮನಕ್ಹೊನಾ ಗಾಮನೆ ಛೊಡಿನ ಜಾ಼ವಸ. ತ್ಯುನೆ ತ್ಯುನಾ ರಾಜಾ಼ನೆ ಕರ್ತಾನೆ ಕಾಯ್ದಿಲಿನ ತ್ಯಾಂತಾ ಜಾ಼ವಸ.<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s">ಇಸ್ರಾಯೆಲನಾ ಶಾನಾವೊನು ಖಂಡನಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />ಐಕೊ, ಯಾಕೊಬನಾ ಮಾಲಕೊ, ಇಸ್ರಾಯಲನಾ ಅಧಿಪತಿಯೊ ಮಾರಿ ವಾತ ಐಕೊ. ನ್ಯಾಯ ಸುವೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ರ್ಹೌ. <verse eid="MIC 3:1" /><verse number="2" style="v" sid="MIC 3:2" />ತುಮೆ ಶಿಷ್ಟತನಾನೆ ದ್ವೆಶ ಕರಿನ ದುಷ್ಟತನಾನೆ ಮಯಾ ಕರೊಸಿ! ತುಮೆ ಮನಕ್ಹೊನಾ ಚಾ಼ಮ್ಡಾನೆ ಛಿಲ್ತಾ ತ್ಯುನಾ ಹಡ್ಕಾಮಾತಾ ಮಾಕ್ಹನೆ ಕಿತ್ತಿ ಲಿವೊಸಿ. <verse eid="MIC 3:2" /><verse number="3" style="v" sid="MIC 3:3" />ತುಮೆ ಮಾರಾ ಮನಕ್ಹೊನಾ ಅಂಗಮಾತಾ ಚಾ಼ಮ್ಡು ಕಾಡಿನ ಹಡ್ಕಾವೊನೆ ತುಕ್ಡಾ ಕರಿನ ತ್ಯುನೊನೆ ನಾಶ ಕರೊಸಿ. ತಪಾಲಾವೊಮಾ ಚ಼ಡಾವಾನೆ ಮಾಕ್ಹ ಕಾಟಿನ ಘಾಲಾನಾನಿಂಗತ ತುಮೆ ತ್ಯುನಾ ಹಡ್ಕಾವೊನೆ ತುಕ್ಡಾ ಕರೊಸಿ. <verse eid="MIC 3:3" /><verse number="4" style="v" sid="MIC 3:4" />ತುಮೆ ಯಹೊವಾನೆ ಪ್ರಾರ್ಥಾನಾ ಕರಸಕೊಸಿ. ತೆನೈಸೊ ತೆ ತುಮೊನೆ ಉತ್ತರ ನೈದೆತೊ. ತುಮಾರಾ ಕೆಟ್ಟ ಪಾಪೊನಾಹುತಿ ತ್ಯುನಾ ಮ್ಹೊಡಾ ಝಾಕಿ ಲಿವಸ.<verse eid="MIC 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5" />ದಕ್ಹಾಜ಼ನಾ ಸುಳ್ಳ ಪ್ರವಾದಿಯೊ ಯಹೊವಾನಾ ಮನಕ್ಹೊನೆ ಸುಳ್ಳನೆ ಕವಸ. ಥ್ಯವಾವೊನಾಹುತಿ ಯಹೊವಾ ಕವಾನು ಸುವೈ ಕದ್ಯಾಮ, ಆಂ ಪ್ರವಾದಿಯೊನಾ ವಾತೊ ತ್ಯುನಾ ಪೆಟೊ ಭರಲಿವಾನೆ ವೈ. ಮನಕ್ಹೊ ತ್ಯುನೊನೆ ಅನ್ನ ದಿದ್ಯಾರೆ ಕ್ಹುಶಿಕ್ಹು ವಾಗ್ದಾನಾ ಕರಸ. ಮನಕ್ಹೊ ತ್ಯುನೊನೆ ಅನ್ನ ನೈ ದಿದ್ಯಾರೆ ಯುದ್ದನು ವಾಗ್ದಾನ ಕರಸ. <verse eid="MIC 3:5" /><verse number="6" style="v" sid="MIC 3:6" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ತುಮೊನೆ ರಾತ ಥಾವಸ. ತುಮೊನೆ ದರ್ಶನೊ ನೈ ಥಾತಾ. ಅಗು ಸು ಚಾ಼ಲಸ ಕವಾನು ತುಮೆ ನೈ ದೆಕ್ತಾ. ತಿನಾಹುತಿ ತುಮೊನೆ ಅಂದಾರಾ ನಿಂಗತ ಛೆ. ಪ್ರವಾದಿಯೊನೆ ಸುರ್ಯೊ ಡುಬಲ ರ‍್ಹವಸ. ತ್ಯುನೊನೆ ಅಗು ಥಾವಾನು ದಿಕ್ಹತು ನೈ. ತಿನಾಹುತಿ ತ್ಯುನೊನೆ ಕ್ಹಾರುಜ಼ ಘನ್ನು ಅಂದಾರು ಥಯುಸ. <verse eid="MIC 3:6" /><verse number="7" style="v" sid="MIC 3:7" />ಕ್ಹುದಾನೆ ದೆಕಲವಾಲಾ ಸರಮಾಯಾಸ. ಭವಿಶ್ಯ ಕವಾಲಾ ನೈ ಸರಮಾಲಾ ಥಯಾಸ. ಕಾ ಕದ್ಯಾಮ ಕ್ಹುದಾಬಿ ತ್ಯುನಾಕ್ಹಾತೆ ಬೊಲಾನು ಹುಬ್ರಾಡಲಕ್ಹು ತ್ಯುನೆ ಸುಜ಼ ಕತಾ ನೈ.<verse eid="MIC 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 3:8" />ಯಹೊವಾನಿ ಆತ್ಮಾ ಮಾರಾಮಾ ಅದಿಕಾರಬಿ ಚೊ಼ಕುತನಾಬಿ ತಾಕತಬಿ ಭರ್ಯೊಸ. ಕಾ ಕದ್ಯಾಮ ಯಾಕೊಬನಾ ದ್ರೊಹ ತಿಳಸಾವಾನೆ ತೆಕ್ಲುಜ಼ ವೈ, ಇಸ್ರಾಯಲನಾ ಪಾಪೊ ತಿನೆ ಕವಾನಾಹುತಿ ತಯಾರ ಥಯಾಸ ” <verse eid="MIC 3:8" /><verse number="9" style="v" sid="MIC 3:9" />ಯಾಕೊಬನಾ ಘರನಾ ಮಾಲಕೊ, ಇಸ್ರಾಲನಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ನ್ಯಾಯನಿ ಜಿವ್ನಾನೆ ತುಮೆ ದ್ವೆಶ ಕರೊಸಿ. ಕರೆಟ್ಟ ವರಿ ತಪ್ಪ ಕರಾಲಾ ಮಾರಾ ವಾತೊ ಐಕೊ.. <verse eid="MIC 3:9" /><verse number="10" style="v" sid="MIC 3:10" />ಮನಕ್ಹೊನೆ ಕಲಾಸ ಕರಿನ ಚಿಯೊನನೆ ಭಾಂದೊಸಿ. ಮನಕ್ಹೊನೆ ಮೊಸ ಕರಿನ ಯರುಸಲೆಮನೆ ಭಾಂದೊಸಿ. <verse eid="MIC 3:10" /><verse number="11" style="v" sid="MIC 3:11" />ಯರುಸಲೆಮನಾ ನ್ಯಾಯಾ ಕರಾಲಾ ಲಂಚಾ ಲಿನ ಅನ್ಯಾಯನಾಹುತಿ ಫೈಸಲೊ ದಿವೊಸಿ. ಮನಕ್ಹೊನೆ ಕವಾತಿ ಪೈಲಾಜ಼ ಯರುಸಲೆಮನಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ದೊಕ್ಡಾನೆ ವಸೂಲಿ ಕರಸ. ಮನಕ್ಹೊ ತ್ಯುನಾ ಭವಿಷ್ಯನಾಹುತಿ ಪುಚ್ಚಾನೆ ಪ್ರವಾದಿಯೊನೆ ಪೈಲಾಜ಼ ದೊಕ್ಡಾ ದಿವಸ. ಪಾಚಲ್ತಾ ತೆ ನಾಯಕೊ, ಯಹೊವಾಪರ ವಜ್ಜು ಘಾಲಿನ ಯಹೊವಾ ಹಮಾರಾಮಾ ಕ್ಹಾತೆ ಛೆ. ತಿನಾಹುತಿ ಹಮೊನೆ ಕೆಟ್ಟ ಸುಜ಼ ಲಾಗತು ನೈ ಕೈನ ಕವಸ.<verse eid="MIC 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MIC 3:12" />ನಾಯಕೊ, ತುಮಾರಾಕ್ಹು ಚಿಯೊನ ನಾಶ ಥಾವಸ. ನೆಗಿಲತು ಹುಟ್ಟಲ ಕ್ಹೆತರತಿ ತೆ ರ‍್ಹವಸ. ಯರುಸಲೆಮ ಹಾಳ ಪಡಿನ ರಾಶಿ ಥಾವಸ. ಆಲಯನು ಡೊಂಗರ ಮ್ಹೊಟು ಡೊಂಗರ ಥಾವಸ. ತಿನಾ ಉಪ್ಪರ ಪೊದೆವೊ ಹುಲುಥೈನ ಬೆಳದಸ.<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s">ಇಸ್ರಾಯಲೊನೆ ಬಿಜಿಯೊ ವಾಗ್ದಾನ</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 4:1" />ಲಾಸ್ಟನಾ ದಿನೊಮಾ ಯಹೊವಾನು</para>
  <para style="q1" vid="MIC 4:1">ಆಲಯನು ಪರ್ವತಬಿ ಕ್ಹಾರಾ ಪರ್ವತೊತಿ</para>
  <para style="q2" vid="MIC 4:1">ಅತ್ಯುನ್ನ ಥಯಲ ರ‍್ಹವಸ.</para>
  <para style="q2" vid="MIC 4:1">ತೆ ಡೊಂಗರೊತಿಬಿ ಉನ್ನತ ಥಯಲ ರ‍್ಹವಸ.</para>
  <para style="q1" vid="MIC 4:1">ತ್ಯಾ ಮನಕ್ಹೊ ಗುಂಪ ಗುಂಪ ಥೈನ ಜಾ಼ವಸ.<verse eid="MIC 4:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 4:2" />ಘನಾ ದೆಶೊತಾ ಮನಕ್ಹೊ ತ್ಯಾ ಜಾ಼ವಸ.</para>
  <para style="q1" vid="MIC 4:2">ಆವೊ, ಅಪೆ ಯಹೊವಾನಾ ಪರ್ವತನೆ ಗಯೆ,</para>
  <para style="q2" vid="MIC 4:2">ಯಾಕೊಬನಾ ಕ್ಹುದಾನಾ ಆಲಯನೆ ಅಪೆ ಗಯೆ.</para>
  <para style="q1" vid="MIC 4:2">ತೆಳಾಮಾ ಅಪೊನೆ ಜಿವ್ನಾನಿ ವಾಟನೆ ಸಿಕ್ಲಾವಸ.</para>
  <para style="q1" vid="MIC 4:2">ವರಿ ಅಪೆ ತಿನೆಜ಼ ಅನುಸರಸಿಯೆಸ ಕೈನ ಕವಸ. ಕ್ಹುದಾನಿ ಉಪದೆಶ , ತಿನಿ ವಾಕ್ಯಾ ಚಿಯೊನ ಡೊಂಗರಪ</para>
  <para style="q2" vid="MIC 4:2">ರ‍್ಹವಾನು ಯರುಸಲೆಮಾ ಶುರು ಥೈನ ಜಗತ್ಮಾ ಪೂರಾ ಫೈಲಸ.<verse eid="MIC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />ತೆಳಾಮಾ ಕ್ಹಾರಾ ಜನಾಂಗೊನೆ</para>
  <para style="q2" vid="MIC 4:3">ಯಹೊವಾಜ಼ ನ್ಯಾಯ ತಿರ್ಪ ಕರಾಲೊ ವ್ಹೈ .</para>
  <para style="q1" vid="MIC 4:3">ದೆಶ ವರಿಯಕ್ಕ ದೆಶ ವಿರುದ್ದ ಥೈನ ಯುದ್ದ ಕರ್ತಾ ನೈ</para>
  <para style="q2" vid="MIC 4:3">ಮನಕ್ಹೊನಾ ಲಡಯೊ ತೆಜ಼ ಹುಬ್ರಾಡಸ. ತೆ ಮನಕ್ಹೊ</para>
  <para style="q1" vid="MIC 4:3">ಯುದ್ದನಾ ಆಯೊದೊನೆ ಉಪಯೊಗ ಕರಾನು ಹುಬ್ರಾಡಸ. ತ್ಯುನಾ ತಲ್ವಾರೊಕ್ಹು ನೆಗಿಲ ಗುಳೊನೆ ತಯಾರ ಕರಸ.</para>
  <para style="q2" vid="MIC 4:3">ಬರ್ಜಿಕ್ಹು ದಾತಡು ತಯಾರ ಕರಸ. ಮನಕ್ಹೊಮಾ ಯುದ್ದ ಥಾವಾನು ಹುಬ್ರಾಡಸ. ಯುದ್ದನೆ ತರಬೆತಿ ಕೆಳಾಮಾಬಿ ಕರು ನೈ.<verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />ಹರಯಕ್ಲೊ ತಿನಾ ದ್ರಾಕ್ಷಿನಾ ಮಳಾನಾ ಛೌಲಿಮಾ ಬೈಟಸ.</para>
  <para style="q2" vid="MIC 4:4">ತ್ಯುನೆ ಅಂಜುರನಾ ಝಾಢನಾ ಹೆಟಾ ವಿಶ್ರಾಂತಿಮಾ ರ‍್ಹವಸ.</para>
  <para style="q2" vid="MIC 4:4">ಕಾಕದ್ಯಾಮ ಸರ್ವಶಕ್ತ ಥಯಲ</para>
  <para style="q1" vid="MIC 4:4">ಯಹೊವಾ ಅಮ್ಮ ಥಾವಸ ಕೈನ ಕವಸ.<verse eid="MIC 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 4:5" />ಬಿಜಾ಼ ದೆಶವಾಲಾ ತ್ಯುನಾ ಕ್ಹುದಾವೊನಾ ನಾಮಪರ ಚಾ಼ಲಸ. ತೆನೈಸೊ ಹಮೆ ರ‍್ಹೈತಬಿ ಹಮರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ನಾಮಪರ ಕೆಳಾಮಾಬಿ ಸ್ಹೆಂ ಕರುಸ.<verse eid="MIC 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 4:6" />ಯಹೊವಾ ಕವಾನು ಸುವೈ ಕದ್ಯಾಮ, ತೆ ದಿನೊಮಾ ಲಂಗ್ಡಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಶಿಕ್ಷಾ ಲಿದಲ ಮನಕ್ಹೊನೆ ಯಕ್ಕಜ಼ ಜ಼ಗಾ ಮಳಾವಾನು ಟೈಮ ಆವಸ. ತೆನೈಸೊ ಮಿ ತಿನೆ ಮಕನ ಆವಾ ಲಗಾಡುಸ. <verse eid="MIC 4:6" /><verse number="7" style="v" sid="MIC 4:7" />ತೆ ಲಂಗ್ಡಾ ನಗರನಾ ಮನಕ್ಹೊ ಅಳಿದ ಉಗ್ರಲ ಮನಕ್ಹೊ ಥಾವಸ. ತೆ ಗಾಮನಾ ಮನಕ್ಹೊನೆ ಜ಼ಬರದಸ್ತಿಕ್ಹು ನ್ಹಟಾಡಾಲಗಾಡ್ಯಾ.ತೆನೈಸೊ ಮಿ ತ್ಯುನೊನೆ ತಾಕತವರ ಥಯಲ ಜನಾಂಗ ನಿಂಗತ ಕರುಸ.ಯಹೊವಾ ತ್ಯುನೊ ರಾಜೊ಼ ಥಾವಸ. ತೆ ಚಿಯೊನ ಪರ್ವತನೆ ಕೆಳಾಮಾಬಿ ಆಳಸ. <verse eid="MIC 4:7" /><verse number="8" style="v" sid="MIC 4:8" />ಹಿಂಡನು ಗುಂಬಜ಼ ತಾರೊ ಟೈಮ ಆವಸ. ಚಿಯೊನಾ ಒಫಲ್ ಡೊಂಗರ, ತುನೆ ಫರಿನ ಅದಿಕಾರ ಮಳಸ. ಹೊ, ಪೈಲಾ ನಿಂಗತ ಯರುಸಲೆಮಾ ರಾಜ್ಯ ರ‍್ಹವಸ.<verse eid="MIC 4:8" /></para>
  <para style="s">ಚಿಯೊನನು ಹಮ್ನಾನು ತ್ರಾಸ ಅಗಲ್ಯು ಜಯ</para>
  <para style="p">
    <verse number="9" style="v" sid="MIC 4:9" />ಕಾ ತು ಜೊ಼ರ ಅಡ್ಡಸಿ? ತು ತಾರಾ ಮಾಲಕನೆ ಜ಼ವೈ ಲಿದಿಸು? ತಾರೊ ರಾಜೊ಼ ತುನೆ ಛೊಡಿನ ಗಯೊಸು? ಆಂ ಕಾರಣಕ್ಹು ತು ಪ್ರಸವ ವೆದನೆನೆ ಅನುಭವಿಸಾನಿ ಬಾಕ್ಡಿ ನಿಂಗತ ಶ್ರಮಾ ಅನುಭವಿಸಾಡಿಸು? <verse eid="MIC 4:9" /><verse number="10" style="v" sid="MIC 4:10" />ಚಿಯೊನಿ ರಾಣಿ, ಪ್ರಸವ ವೆದನೆಮಾ ರ‍್ಹವಾನು ಬಾಕ್ಡಿ ನಿಂಗತ ತು ದುಕ್ಕೆ ಅನುಭವಿಸು. ತು ಯರುಸಲೆಮಾ ಗಾಮನೆ ಛೊಡಿನ ಗೈನ ಕ್ಹೆತರಮಾ ರ‍್ಹಸಿಸು. ಮಿ ಕವಾನು ಸುವೈ ಕದ್ಯಾಮ, ತು ಬಾಬಿಲೊನೆ ಜಾ಼ಸಿ, ತೆನೈಸೊ ತ್ಯಾ ತು ವಚಾ಼ಡಿಲೆಸಿ. ಯಹೊವಾ ತ್ಯಾ ಐನ ತುನೆ ವಚಾ಼ಡಸ. ತಾರಾ ದುಶ್ಮನೊಕ್ಹು ತುನೆ ಛೊಡಾವಸ. <verse eid="MIC 4:10" /><verse number="11" style="v" sid="MIC 4:11" />ಕೆಕ್ಲಾ ಜನಾಂಗೊ ತಾರಾ ವಿರುದ್ದ ಯುದ್ದನೆ ಆಯಾಸ. ತ್ಯಾ ದೆಕೊ ಚಿಯೊನ , ಆವೊ ಆಕ್ರಮಣ ಕರಿಯೆ ಕೈನ ಕದ್ಯಾ. <verse eid="MIC 4:11" /><verse number="12" style="v" sid="MIC 4:12" />ತ್ಯುನೆ ತ್ಯುನು ವಿಚಾರ ಘಾಲಸ. ತೆನೈಸೊ ಯಹೊವಾನು ವಿಚಾರ ಸುವೈ ಕೈನ ತ್ಯುನೊನೆ ಗೊತ್ತ ಥಾತು ನೈ. ಯಹೊವಾ ತಿನಾ ಮನಕ್ಹೊನೆ ಯಕ್ಕ ಕ್ಹಾಸ ಉದ್ದೆಶನಾಹುತಿ ಯ್ಹಾಂ ಲಾಯೊಸ. ತೆ ಮನಕ್ಹೊ ಕಣನೆ ಘಾಲಲ ಗುಂಚ಼ಲಾ ನಿಂಗತ ನಜ್ಜು ಗುಜ್ಜ ಥಾವಸ.<verse eid="MIC 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MIC 4:13" />ಚಿಯೊನಿ ರಾಣಿ ಉಟ ತೆ ಮನಕ್ಹೊನೆ ಪುಡಿ ಕರ! ಮಿ ತುನೆ ತಾಕತವರ ಕರುಸ. ಲ್ಹೊಡಾನಾ ಕ್ಹಂಬಾವೊ ನಿಂಗತ ತಾಂಬಾನಾ ಗೊರಸು ನಿಂಗತ ತುನೆ ಕರುಸ. ಕೆಕ್ಲಾ ಮನಕ್ಹೊನೆ ತು ತುಕ್ಡಾ ತುಕ್ಡಾ ಕರಸಿ. ತ್ಯುನಿ ಆಸ್ತಿ ತು ಯಹೊವಾನೆ ದೆಶಿ ತ್ಯುನು ನಿಕ್ಷೆಪೊನೆ ಕ್ಹಾರಿ ಜಿಮಿನನೆ ಮಾಲಕ ರ‍್ಹಯಲ ಯಹೊವಾನೆ ಚ಼ಡಾಸಿ<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="s">ಇಸ್ರಾಯೆಲನೆ ವಚಾಡಾಲೊ ರಾಜೊ಼</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 5:1" />ತಾಕತವರ ಥಯಲ ನಗರ. ತಾರಾ ಸೈನಿಕೊನೆ ಜ಼ಮ್ಮಾ. ತ್ಯುನೆ ಹಮಾರಾ ಉಪ್ಪರ ದಾಳಿ ಕರಾನೆ ಸುತ್ತೆಬಿ ಆಯಾಸ. ಇಸ್ರಾಯಲನಾ ನಾಯಕನೆ ಗಾಲಪರ ಲಾಕ್ಡಿಕ್ಹು ಮಾರಸ.<verse eid="MIC 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 5:2" />ಎಪ್ರಾತನು ಬೆತ್ಲೆಹೆಮ ತು ಯೆಹುದನಾ ಗಾಮಮಾ ಘನು ನ್ಹಾನು ಗಾಮ ಥಾಸಿ. ತಾರಾಮಾ ರ‍್ಹವಾನು ಕುಟುಂಬ ದಕ್ಹುಜಾ಼ ವ್ಹೈ. ತೆನೈಸೊ ಇಸ್ರಾಯಲನೆ ಆಳಾಲೊ ಮಾರಾಹುತಿ ತಾರಾಕ್ಹು ಹೊರಾಡಸ. ತಿನಿ ಶುರುವಾತ ಪೈಲಾನಾ ಕಾಲತುಜ಼ ಥಯುಸ.<verse eid="MIC 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 5:3" />ಬಾಕ್ಡಿ ತಿನಾ ದಿಕ್ರಾನೆ ಜ಼ನ್ನೆಲಕ್ಕಾ ಯಹೊವಾ ತಿನಾ ಮನಕ್ಹೊನೆ ಕ್ಹಲಾಸ ಕರಿಪಡಸ. ತೆ ಥಯಲ್ಪರ ಉಗ್ರಲ ತಿನಾ ಭಾಯೊ ಇಸ್ರಾಯಲ ಮನಕ್ಹೊಕನ ವಾಪಸ ಆವಸ. <verse eid="MIC 5:3" /><verse number="4" style="v" sid="MIC 5:4" />ತೆಳಾಮಾ ಇಸ್ರಾಯಲನೆ ಕಾಯ್ದಾವಾಲೊ ಯಹೊವಾನಾ ತಾಕತಮಾ ತಿನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ನಾಮಮಾಬಿ ಹುಬ್ರೈನ ತಿನಾ ಹಿಂಡನೆ ಚ಼ರಾವಸ. ತಿನಾ ಮಹತ್ತ ಜಿಮಿನಿ ಕ್ಹಾರಿ ಜ಼ಗಾ ಪ್ರಸರಿನಾಹುತಿ ತ್ಯುನೆ ಸಮಾಧಾನಕ್ಹು ರ‍್ಹವಸ.<verse eid="MIC 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 5:5" />ತೆಳಾಮಾ ಶಾಂತಿ ಥಾವಸ. ಹೊ, ಅಶ್ಶುರನಿ ಸೆನಾ ಅಪ್ನಾ ದೆಶೆ ಐನ ಹಮಾರಾ ಕ್ಹಾಸ ಭಾಂದಲನೆ ಕ್ಹುಂದಿಪಡಸ. ತೆನೈಸೊ ಇಸ್ರಾಯಲನೆ ಕಾಯ್ದಾವಾಲೊ ಕ್ಹಾತ ಬಕ್ರಾ ಚ಼ರಾವಾಲಾವೊನೆ ಆಟ ತಾಕತವರ ನಾಯಕೊನೆ ಇನಸ. <verse eid="MIC 5:5" /><verse number="6" style="v" sid="MIC 5:6" />ತ್ಯುನೆ ತ್ಯುನಾ ತಲ್ವಾರೊನೆ ಉಪಯೊಗ ಕರಿನ ಅಶ್ಶುರವಾಲಾವೊನೆ ಕಾಯ್ದಿಸ. ತ್ಯುನೆ ನಿಮ್ರೊದನ ದೆಶನೆ ಆಳಸ. ಹತ್ಮಾ ತಲ್ವಾರ ಧರಲಿನ ತೆ ಮನಕ್ಹೊನೆ ಆಳಸ. ತೆನೈಸೊ ಇಸ್ರಾಯಲನೊ ರಾಜೊ಼ ಅಶ್ಶುರತೊ ಹಮೊನೆ ವಚಾ಼ಡಸ. ತ್ಯುನೆ ಹಾಮಾರಾ ದೆಶೊಮಾ ಐನ ಹಮಾರಾ ಗಾಮೊನೆ ಕ್ಹುಂದಿನ ಹಾಳ ಕರ್ತಾಮಾ ಹಮೆ ವಾಚಿ಼ಯೆಸ.<verse eid="MIC 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MIC 5:7" />ತೆನೈಸೊ ಜನಾಂಗೊಮಾ ಭಿಕರಾವಾನು ಇಸ್ರಾಯಲನಾ ಅಳದಿನ ಉಗ್ರಸ.ಯಹೊವಾಕ್ಹು ಆವಾನು ಮಂಜ ನಿಂಗತ ರ‍್ಹವಸ. ತೆ ತ್ಯುನೊ ವರಿ ತ್ಯುನಾ ಸಂತತಿವಾಲಾವೊ ಕಾಯ್ದಿತು ನೈ. ತ್ಯುನೆ ಚಾ಼ರಾಪರ ಪಡಲ ಪಾನಿ ನಿಂಗತ ರ‍್ಹವಸ. ತೆ ಪಾನಿ ಕಿನೆಜ಼ ಕಾಯ್ದುತು ನೈ. <verse eid="MIC 5:7" /><verse number="8" style="v" sid="MIC 5:8" />ತೆನೈಸೊ ಜನಾಂಗೊಮಾ ಬಿಕ್ಹಾರಾಯಲ ಯಾಕೊಬನು ವಂಶ ಅಳದಿನ ಉಗ್ರಸ. ರಾನಮಾ ರ‍್ಹವಾನಾ ಜಾನವರೊಮಾ ಸಿಂಹಾಡೊ ಕಿಮ್ಮ ರ‍್ಹವಸ. ತಿಮ್ಮಜ಼ ರ‍್ಹವಸ. ಬಕ್ರಾವೊನಾ ಹಿಂಡನಾ ವಚ್ಮಾ ರ‍್ಹವಾನು ಜಾ಼ಂಜಿಮಾನ ಸಿಂಹಾಡಾ ನಿಂಗತ ರ‍್ಹವಸ.ತೆ ತಿನೆ ಮನಸಾ ನಿಂಗತ ಫರಸ. ತೆ ಯಕ್ಕ ಜಾನವರನೆ ಧರ್ಯಾರೆ ತಿನೆ ಛೊಡಾವಾನೆ ಕ್ಹಿಕ್ಹುಜ಼ ಸಾದ್ಯ ನತ್ತಿ ಮನಕ್ಹೊನು ತಿನಾ ನಿಂಗತ ರ‍್ಹವಸ. <verse eid="MIC 5:8" /><verse number="9" style="v" sid="MIC 5:9" />ತು ತಾರಾ ದುಶ್ಮನೊಪರ ಹತ್ತ ಉಚೈನ ತ್ಯುನೊನೆ ನಾಶ ಕರಸಿ.<verse eid="MIC 5:9" /></para>
  <para style="s">ಇಸ್ರಾಯೆಲನೊ ಮುಢ ಬರೊಕ್ಹೊ ವರಿ ನಾಶ</para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10" />ಯಹೊವಾ ಕವಾನು ಸುವೈ ಕದ್ಯಾರೆ, ತೆ ಟೈಮಾ ತಾರಾ ಘೊಡಾವೊನೆ ಮಿ ಕಾಡಿಪಡಸ. ತಾರಾ ರಥೊನೆ ನಾಶ ಕರುಸ. <verse eid="MIC 5:10" /><verse number="11" style="v" sid="MIC 5:11" />ತಾರಾ ದೆಶಮಾ ರ‍್ಹವಾನಾ ಗಾಮೊನೆ ಹಾಳ ಕರುಸ. ತಾರಾ ಕೊಟೆನೆ ನಾಶ ಕರುಸ. <verse eid="MIC 5:11" /><verse number="12" style="v" sid="MIC 5:12" />ತು ಹಮ್ನಾತೊ ಮಾಟಾ ಮಂತ್ರಾ ನೈ ಕರ್ತೊ. ಭವಿಷ್ಯ ವರಿ ಕಣಿ ಕವಾಲಾ ಮನಕ್ಹೊ ಹಮ್ನಾತಾ ತಾರಾಮಾ ನೈ ರ‍್ಹತಾ. <verse eid="MIC 5:12" /><verse number="13" style="v" sid="MIC 5:13" />ತಾರಾ ವಿಗ್ರಹವೊನೆ ವರಿ ದಗ್ಡಾ ಕ್ಹಂಬಾವೊನೆ ಫೊಡಿನ ನಾಶ ಕರುಸ. ತಾರಾ ಹತೆಕ್ಹು ಕರಲ ಸಾಮ್ನೊನೆ ತು ಪೂಜಾ ಕರ್ತೊ ನೈ. <verse eid="MIC 5:13" /><verse number="14" style="v" sid="MIC 5:14" />ಮಿ ತಾರಾ ಅಶೆರ ಕ್ಹಂಬಾವೊನೆ ಸುಳ್ಳ ಕ್ಹುದಾವೊನೆ ನಾಶ ಕರುಸ. ತಾರಾ ಗಾಮೊನೆ ನಾಶ ಕರುಸ. <verse eid="MIC 5:14" /><verse number="15" style="v" sid="MIC 5:15" />ದಕ್ಹಾ ಜನಾಂಗೊ ಮಾರಾ ವಾತನೆ ಕಾನ ದೆತಾ ನೈ. ತೆಳಾಮಾ ಮಿ ಮಾರಿ ಶಿಟ್ಟನೆ ಲೈನ ತುಮೊನೆ ಕ್ಹಲಾಸ ಕರುಸ.<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s">ಇಸ್ರಾಲವಾಲಾವೊನು ಮನಸಾಂತರ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />ಯಹೊವಾ ಕವಾನು ಐಕೊ: ತಾರಿ ವ್ಯಾಜನೆ ಡೊಂಗರೊನೆ ತಿಳಸಾ. ಡೊಂಗರೊ ತಾರಾ ಗಳೊ ಐಕಾದೆ.<verse eid="MIC 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 6:2" />ಯಹೊವಾನೆ ತಿನಾ ಮನಕ್ಹೊನಾ ವಿರುದ್ದ ವ್ಯಾಜ ಛೆ. ಪರ್ವತೊ ಜಿಮಿನಾ ಅಸ್ತಿವಾರೊ ಯಹೊವಾನಾ ದುರೊನೆ ಐಕೊ. ಇಸ್ರಾಯಲೊನೆ ತಪ್ಪ ಕರಲವಾಲೊ ವ್ಹೈ ಕೈನ ತೆ ಧೃಡ ಕರಸ.<verse eid="MIC 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 6:3" />ಯಹೊವಾ ಕವಾನು ಸುವೈ ಕದ್ಯಾರೆ, ಮಾರಾ ಮನಕ್ಹೊ, ಮಿ ಕರಲ ಸುವೈ ತಿಳಸಾವೊ. ತುಮೊನೆ ವಿರುದ್ದ ಥೈನ ಮಿ ಸುತಬಿ ಕರ್ಯೊಸು? ತುಮೊನೆ ಜಿವ್ಸಾನೆ ಕಷ್ಟ ಸುತಬಿ ಕರ್ಯೊಸು? <verse eid="MIC 6:3" /><verse number="4" style="v" sid="MIC 6:4" />ಮಿ ಕರಲ ಕ್ಹಾರು ತುಮೊನೆ ಕೌಸ, ಮಿ ತುಮೊಕನ ಮೊಶೆ, ಆರೊನ, ವರಿ ಮಿರ್ಯಾಮಳನೆ ವಳಾಯೊತೊ. ಮಿ ಐಗುಪ್ತ ದೆಶತೊ ತುಮೊನೆ ಬಲೈಲಾಯೊ. ಗುಮಾತನಾಕ್ಹು ತುಮೊನೆ ಛೊಡಾಯೊ. <verse eid="MIC 6:4" /><verse number="5" style="v" sid="MIC 6:5" />ಮಾರಾ ಮನಕ್ಹೊ, ಮೊವಾಬ್ಯರನೊ ರಾಜೊ಼ ಥಯಲ ಬಚ್ಚಾನಾ ದುಷ್ಟ ವಿಚಾರೊನೆ ಸ್ಹೆಂ ಕರೊ. ಬೆಯೊರನೊ ದಿಕ್ರೊ ಥಯಲ ಬಿಳಾಮನನಾ ಬಚ್ಚಾನೆ ಸು ಕದ್ಯೊ ಕೈನ ಸ್ಹೆಂ ಕರಲಿವೊ. ಶಿಟ್ಟಿಮತಾ ಗಿಲ್ಗಾಲಿನಾ ಲಕ್ಕಾ ಚಾ಼ಲಲ ಕ್ಹಾರು ತುಮಾರಾ ಸ್ಹೆಂನೆ ಲಾವೊ. ತೆಕ್ಹಾರು ತುಮೆ ಸ್ಹೆಂ ಕರ್ಯಾರೆ ಯಹೊವಾ ನಿತಿವಂತವಾಲೊ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="MIC 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 6:6" />ಮಿ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಸಂದಿಸಾನೆ ಆತಾಮಾ ಸು ಲಿನ ಔ? ಪರಲೊಕನೊ ಕ್ಹುದಾನೆ ಮಿ ಅಡ್ಡ ಪಡಿನ ಸ್ತುತಿ ಕರ್ತಾಮಾ ಸು ಕರು? ಮಿ ಕರ್ತಾಕನ ಆತಾಮಾ ಸರ್ವಾಂಗ ಹೊಮನಾಕ್ಹಾತೆ ಯಕ್ಕ ವರಕ್ಹನು ಬೈಲನಾ ಬಚ್ಚಾನೆ ಲಿನ ಔಸು? <verse eid="MIC 6:6" /><verse number="7" style="v" sid="MIC 6:7" />ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಯಕ್ಕ ಹಜಾ಼ರ ಟಗರೊ ದಕ್ಹ ಹಜಾ಼ರ ಒಲಿವ ತೆಲನಾ ಝರು ಕ್ಹುಶಿ ಥಾವಸು? ಮಿ ಕರಲ ತಪ್ಪನಾ ಪರಿಹಾರನಾಹುತಿ ಮಾರಾ ಪೈಲಾರ ದಿಕ್ರಾನೆ ಚ಼ಡೌಸು? ಮಾರಾ ಅಂಗಕ್ಹು ಆಯಲ ದಿಕ್ರಾನೆ ಮಾರಾ ಪಾಪೊನಾಹುತಿ ಚ಼ಡೌಸು? <verse eid="MIC 6:7" /><verse number="8" style="v" sid="MIC 6:8" />ಮನಕ್ಹ ಚೊ಼ಕುಜ಼ ವ್ಹೈ ಸುಕೈನ ಯಹೊವಾ ತುನೆ ಕದ್ಯೊಸ. ಯಹೊವಾ ತಾರಾಕ್ಹು ಆಪೆಕ್ಷೆ ಕರಾನು ಸುವೈ ಕದ್ಯಾಮ , ಬಿಜಾ಼ವೊನೆ ತು ಅನ್ಯಾಯ ಕರಿತಬಿ. ದಯಾ ವರಿ ನಂಬಿಕೆನೆ ಮಯಾ ಕರ. ದಿನತೆಕ್ಹು ತಾರಾ ಕ್ಹುದಾನೆ ವಿದೆಯ ಥಾ.<verse eid="MIC 6:8" /></para>
  <para style="s">ಯೆರುಸೆಲಿಮನು ಮೊಸ ತಿನಾಹುತಿ ಥಾವನು ನಿರಾಶಾ</para>
  <para style="p">
    <verse number="9" style="v" sid="MIC 6:9" />ಯಹೊವಾನಿ ಅವಾಜ಼ ಗಾಮಮಾ ಜೊ಼ರ ಐಕಾವಸ. ಗ್ಯಾನವಾಲೊ ಯಹೊವಾನಾ ಭುಚಕಿ಼ನ ನಾಮನೆ ಮರ್ಯಾದಿ ದಿವಸ. ತಿನಾಹುತಿ ಶಿಕ್ಷಾ ಬೆತ್ತಕನ ಧ್ಯಾನ ದೆ. ತೆ ಬೆತ್ತನೆ ಧರಲಿದಲವಾಲಾನೆ ಮರ್ಯಾದಿ ದೆ. <verse eid="MIC 6:9" /><verse number="10" style="v" sid="MIC 6:10" />ಕಾಳ್ಳಿನ ಭಂಡಾರನೆ ದುಷ್ಟೊ ಗುಪ್ತ ಕರಸು? ಕೆಟ್ಟ ಮನಕ್ಹೊ ತ್ಯುನಾ ನ್ಹಾನಾ ಅಳತಿಕ್ಹ ಮನಕ್ಹೊ ಹಜಿ಼ ಮೊಸಕರಸು? ಹೊ, ತೆ ಕ್ಹಾರು ಚಾ಼ಲಾಡುಸ. <verse eid="MIC 6:10" /><verse number="11" style="v" sid="MIC 6:11" />ದಕ್ಹಾಜ಼ನಾ ಮೊಸನು ಅಳತಿ ಪ್ರಮಾಣೊಕ್ಹು ಮನಕ್ಹೊ ಮೊಸ ಕರಸ. ಮಿ ತ್ಯುನೊನೆ ಮಾಫ ಕರುಸು? <verse eid="MIC 6:11" /><verse number="12" style="v" sid="MIC 6:12" />ಗಾಮನಾ ಸೌಕಾರೊ ಕ್ರುರ ಥಯಲ ವರಿ ದುಷ್ಟತನಾನಾ ಗಾಮನಾ ರ‍್ಹವಾನಾ ಮನಕ್ಹೊ ಹಜಿ಼ ಸುಳ್ಳ ಕವಸ. ಹೊ, ತೆ ಮನಕ್ಹೊ ತ್ಯುನು ಸುಳ್ಳನೆ ಫೈಲಾವಸ. <verse eid="MIC 6:12" /><verse number="13" style="v" sid="MIC 6:13" />ತಿನಾಹುತಿ ಮಿ ತುಮೊನೆ ಶಿಕ್ಷಾ ದಿವಾನು ಶುರು ಕರ್ಯೊ. ತುಮಾರಾ ಪಾಪೊನಾ ದೆಸೆಕ್ಹು ತುಮೊನೆ ನಾಶ ಕರುಸ. <verse eid="MIC 6:13" /><verse number="14" style="v" sid="MIC 6:14" />ತುಮೆ ಕ್ಹಾವೊಸಿ. ತೆನೈಸೊ ತುಮಾರು ಪೆಟ ನೈ ಭರ್ತು. ತುಮಾರಾ ಭುಕ್ಕ ರ‍್ಹವಸಜ಼. ತುಮೆ ಮನಕ್ಹೊನೆ ಸುರಕ್ಷಿತ ಜ಼ಗಾನೆ ಲಾವಾನೆ ಕೊಶಿಶ ಕರೊಸಿ. ತೆನೈಸೊ ತುಮೆ ವಚಾ಼ಡಲ ಮನಕ್ಹೊನೆ ತಲ್ವಾರನಾ ಧಾರಕ್ಹು ಕಲಾಸ ಕರಿಪಡಸ. ಮನಕ್ಹೊ ತುಮೊನೆ ಧರಸ. <verse eid="MIC 6:14" /><verse number="15" style="v" sid="MIC 6:15" />ತುಮೆ ಬಿಯೊ ಬಿತ್ತೊಸಿ. ತೆನೈಸೊ ಪೈರನೆ ಕಾಟತಾ ನೈ ಆಲಿವ ಹಣ್ಣೊನೆ ಗಾಣಾಮಾ ಘಾಲಿನ ತೆಲ ಕಾಡೊಸಿ. ತೆನೈಸೊ ತುಮೊನೆ ತೆಲ ಮಳತು ನೈ. ತುಮೆ ದ್ರಾಕ್ಷಿಯೊನೆ ಟೊಪ್ಲಿಮಾ ಘಾಲಿನ ಕ್ಹುಂದೊಸಿ, ತೆನೈಸೊ ಪಿವಾನೆ ದ್ರಾಕ್ಷಿನು ರಕ್ಹ ಮಳತು ನೈ. <verse eid="MIC 6:15" /><verse number="16" style="v" sid="MIC 6:16" />ಕಾ ಕದ್ಯಾಮ ತುಮೆ ಒಮ್ರಿನ ರಾಜಾ಼ನಾ ಆಗನ್ಯಾನೆ ಪಾಲಸ್ಯಾಸ. ಅಹಾಬನಾ ಘರವಾಲಾ ಕರಾನಾ ಕೆಟ್ಟ ಕಾಮೊ ತುಮೆ ಕರಾಡಾಸ. ತುಮೆ ತ್ಯುನೆ ಭೊದನೆನೆ ಪಾಲ್ಸಾಡಾಸ. ತಿನಾಹುತಿ ತುಮೆ ನಾಶ ಥಾವಾವರಕ್ಹು ಕರುಸ. ಪಡಲ ತುಮಾರಾ ಒಣಿಯೊನೆ ದೆಕಲ ಮನಕ್ಹೊ ಆಶ್ಚರಕ್ಹು ಸಿಳ್ಳು ಘಾಲಸ. ತೆಳಾಮಾ ಬಿಜಾ ಜನಾಂಗವಾಲಾ ತುಮಾರಾ ಉಪ್ಪರ ಘಾಲಲ ಅವಮಾನನೆ ತುಮೆ ತಡ್ದಿ ಲಿವೊಸಿ.<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s">ಇಸ್ರಾಯೆಲನಿ ನೈತಿಕ ಭ್ರಷ್ಟಾಚಾರ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 7:1" />ಮಿ ಬೆಜಾ಼ರ ಥಯೊಸ. ಕಾ ಕದ್ಯಾಮ ಮಿ ಜ಼ಮಾಕರಲ ಹಣ್ಣೊ ನಿಂಗತ ಛೆ; ಕಾಟಲ ಶೆಖರ ಥಯಲ ದ್ರಾಕ್ಷಿ ನಿಂಗತ ಛೆ. ಕ್ಹಾವಾನೆ ದ್ರಾಕ್ಷಿಯೊ ಸುಜ಼ ಉಗ್ರ್ಯಾ ನೈ. ಮನೆ ಪಸಂದ ರ‍್ಹಯಲ ಫಲನಾ ಕಾಲಮಾ ಶುರುವಾತಮಾ ಆವಾನು ಅಂಜುರನು ಫಲ ಮಳ್ಯುಜ಼ ನೈ. <verse eid="MIC 7:1" /><verse number="2" style="v" sid="MIC 7:2" />ಮಿ ಕವಾನು ಸುವೈ ಕದ್ಯಾಮ ನಂಬಿಗಸ್ತ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಗೈಪಡ್ಯಾ. ತೆ ದೆಶಮಾ ಚೊ಼ಕಾ ಮನಕ್ಹೊ ಕಯಾಜ಼ ಉಗ್ರ್ಯಾ ನೈ. ಹರಯಕ್ಲೊ ಹಜಿಯಕ್ಲಾನೆ ಕಲಾಸ ಕರಾನೆ ಕಾಯ್ದಾಡೊಸ. ಹರಯಕ್ಲೊ ತಿನಾ ಭೈನೆ ಕ್ಹಾಪ್ಡಾವಾನೆ ಕಾಯ್ದಾಡೊಸ. <verse eid="MIC 7:2" /><verse number="3" style="v" sid="MIC 7:3" />ಕೆಟ್ಟ ಕರಾನೆ ಭಂಬಿ ಹತೊಕ್ಹು ಮನಕ್ಹೊ ನಿಪುಣ ಥಯಾಸ. ಅದಿಕಾರಿಯೊ ಲಂಚಾ ಪುಚ್ಚಸ. ಫೈಸಲೊ ಕರಾಲಾ ಅಪ್ನು ತಿರ್ಪ ಕರಾನೆ ದೊಕ್ಡಾ ಪುಚ್ಚಸ. ಮ್ಹೊಟಾ ನಾಯಕೊ ನ್ಯಾಯ ಥಯಲ ವರಿ ಹಿತ ಥಯಲ ಫೈಸಲೊ ನೈ ಕರ್ತಾ. ತ್ಯುನಾ ಇಷ್ಟಾ ನಿಂಗತ ತ್ಯುನೆ ಕರಸ. <verse eid="MIC 7:3" /><verse number="4" style="v" sid="MIC 7:4" />ತ್ಯುನಾಮಾ ಚೊ಼ಕಾಬಿ ಕಾಟಾನಾ ಕಂಟಿಯೊ ನಿಂಗತ ಛೆ. ತ್ಯುನಾಮಾ ರ‍್ಹವಾನಾ ಚೊ಼ಕಾಬಿ ವಾಕಾತಿಕಾ ರ‍್ಹಯಲ ಕಾಟಾವೊನಾ ಕಂಟಿಯೊತಿಬಿ ವಾಕಾ ಥಯಾಸ. ತಾರಾ ಪ್ರವಾದಿಯೊ ಆಂ ದಿನ ಆವಸ ಕೈನ ಕವಾಡಾಸ. ತಾರಾ ಪ್ರವಾದಿಯೊನೊ ದಿನ್ನ ಆಯೊಸ. ಹಮ್ನಾ ತುನೆ ಶಿಕ್ಷಾ ದಿವಸ. ತು ಹಮ್ನಾ ಗಲಿಬಿಲಿನೆ ಮ್ಹೈ ಥಾಸಿ! <verse eid="MIC 7:4" /><verse number="5" style="v" sid="MIC 7:5" />ತಾರಾ ಬಾಜು಼ವಾಲಾನಾ ಉಪ್ಪರ ಭರೊಕ್ಹೊ ಮ್ಹೆಲು ನಕೊ! ತಾರಾ ದೊಸ್ತನಾ ಉಪ್ಪರ ಭರೊಕ್ಹೊ ಮ್ಹೆಲುನಕೊ! ತಾರಿ ಬೈಕೊನಾ ಕ್ಹಾತೆ ತಾರಾ ಮನಸಮಾ ರ‍್ಹವಾನುವಿಚಾರ ಕವು ನಕೊ. <verse eid="MIC 7:5" /><verse number="6" style="v" sid="MIC 7:6" />ಯಕ್ಲಾನೊ ದುಶ್ಮನ ತ್ಯುನಾ ಘರವಾಲಾಜ಼ ಥಾವಸ. ದಿಕ್ರೊ ಬಾಪನೆ ಮರ್ಯಾದಿ ದೆತೊ ನೈ. ದಿಕ್ರಿ ತಿನಿಯಾನಾ ವಿರುದ್ದ ಚಾ಼ಲಸ. ವ್ಹೌವು ಫೈನೆ ವಿರುದ್ದ ಥೈನ ಚಾ಼ಲಸ.<verse eid="MIC 7:6" /></para>
  <para style="s">ಕ್ಹುದಾನಿ ಮರ್ಗಾ</para>
  <para style="p">
    <verse number="7" style="v" sid="MIC 7:7" />ಮಿ ಮದದನಾಹುತಿ ಯಹೊವಾಕನ ದೆಕುಸ. ಕ್ಹುದಾ ರಕ್ಷಣೆನಾಹುತಿ ನಿರಿಕ್ಷಾ ಕರಸ. ಮಾರೊ ಕ್ಹುದಾ ಮನೆ ಕಾನ ದಿವಸ.<verse eid="MIC 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 7:8" />ಮಿ ಪಡ್ಯೊಸ, ತೆನೈಸೊ ದುಶ್ಮನ ಮನೆ ದೆಕಿನ ಅಕ್ಹು ನಕೊ! ಮಿ ವರಿ ಉಟುಸ; ಮಿ ಹಮ್ನಾ ಅಂದಕಾರಮಾ ಬೈಟುಸ. ತೆನೈಸೊ ಯಹೊವಾ ಮನೆ ಉಜಾಲು ಥಾವಸ. <verse eid="MIC 7:8" /><verse number="9" style="v" sid="MIC 7:9" />ಮಿ ಯಹೊವಾನೆ ಪಾಪ ಕರಲಕ್ಹು ತೆ ತಿನಿ ಶಿಟ್ಟ ತಡ್ದಿಲಿವಸ; ಕಾಲನಾ ಕಾಲನೆ ತೆ ತಿನು ವಾಜ್ಯನೆ ಕರಿನ ಮನೆ ನ್ಯಾಯಾ ಕರಸ; ಮನೆ ಉಜಾಲಾನೆ ಲಾವಸ, ತಿನಾ ರಕ್ಷನಾ ಧರಮನೆ ದೆಕುಸ. <verse eid="MIC 7:9" /><verse number="10" style="v" sid="MIC 7:10" />ತಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಕಿಜಾ ಛೆ ಕೈನ ಪಚ್ತಾಮಾ ಜರನಾ ದುಶ್ಮನೊ ಇನೆ ದೆಕ್ತಾಮಾ ಸರಮ ತ್ಯುನೊನೆ ಮ್ಹೈ ಕರಲಿವಸ; ಮಿ ತ್ಯುನೊನೆ ಡೊಳಾಕ್ಹು ದೆಕುಸ.ಹಮ್ನಾಜ಼ ರಸ್ತಾ ಕಸಾ ನಿಂಗತ ಥಾವಸ.<verse eid="MIC 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MIC 7:11" />ಆಹಾ ತಾರಾ ಗೊಡಿಯೊ ಭಾಂದಾನಾ ದಿನೊ ಆವಸ; ತೆ ಆಗನ್ಯಾ ತಾರಾತಿದುರ ಥಾವಸ. <verse eid="MIC 7:11" /><verse number="12" style="v" sid="MIC 7:12" />ತೆಜ಼ ದಿನೊಮಾ ತಾರಾ ಮನಕ್ಹೊ ಅಶ್ಯುರತಾ ಐಗುಪ್ತತಾ ಮಳಿನ ತುಕನ ಆವಸ ಸಮುದ್ರತಾ ಸಮುದ್ರಲಕ್ಕಾ ಡೊಂಗರ್ತಾ ಡೊಂಗರಲಕ್ಕಾ ಐಗುಪ್ತತಾ ಯೊಫ್ರಿಟೆಸ ನದಿಲಕ್ಕಾ ಜುದಾ ಥೈಗಯಲ ತಾರಾ ಮನಕ್ಹೊ ತುಕನ ಮಳಸ. <verse eid="MIC 7:12" /><verse number="13" style="v" sid="MIC 7:13" />ತೆ ನೈಸೊ ತೆಕ್ಲಾಮಾಜ಼ ಎ ದೆಶನಾ ಮನಕ್ಹೊನಾ ಹುತಿ ತ್ಯುನಾ ಕೆಟ್ಟ ಕಾಮೊ ಫಲ ಥೈನ ಹಾಳ ತಯುಸ.<verse eid="MIC 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MIC 7:14" />ಚೊಕಿ ಜಿಮಿನನಾ ವಚ್ಮಾ಼ ರ‍್ಹಯಲ ರಾನಮಾ ಹರಿಕ್ಕನೆ ಲಾಗಾನು ತಾರಾ ಮನಕ್ಹನೆ ತಾರಾ ಸ್ವಾಸ್ಥಮಾ ಹಿಂಡನೆ ತಾರಾ ಹತೊಕ್ಹು ಚ಼ರಾ. ಪುರ್ವಕಾಲನಿಂಗತ ಬಾಶಾನಮಾ ಗಿಲ್ಯಾದಮಾ ಚ಼ರಾದೆ.<verse eid="MIC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MIC 7:15" />ತು ಐಗುಪ್ತ ದೆಶಮಾತೊ ಪಾರ ಥೈನ ಆಯಲ ಕಾಲಮಾ ಮಿ ದೆಕಾಡಲತಿಮ್ಮ ಅದ್ಭುತೊ ದೆಕಾಡುಸ. <verse eid="MIC 7:15" /><verse number="16" style="v" sid="MIC 7:16" />ಜನಾಂಗೊ ದೆಕಿನ ತುಮಾರಿ ಮ್ಹೊಟಿ ತಾಕತನೆ ದೆಕಿನ ಸರ್ಮಾವಸ ಮ್ಹೊಡಾಪರ ಹತ್ತ ಮ್ಹೆಲ್ಲಿವಸ. ತಿವ್ನಾ ಕಾನು ಐಕುಆತಾ ನೈ. <verse eid="MIC 7:16" /><verse number="17" style="v" sid="MIC 7:17" />ಕ್ಹಾಪನಿಂಗತ ಮಾತಿ ಚಾ಼ಟಸ. ಜಿಮನಪರ ಚಾ಼ಲಾನಾ ಕಿಡಾ ಕಾಟು ನಿಂಗತ ತಿವ್ನಾ ದಡಾನಾ ಜ಼ಗಾಪರ ಕಾಪ್ತಾ ತಿ ನ್ಹಾಟಿ ಜಾ಼ವಸ. ಯಹೊವಾ ಕವಾಲೊ ಹಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ತುನೆ ಭುಚ಼ಕತಾ ತುನೆ ವಪ್ಪಿಲಿವಸ.<verse eid="MIC 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MIC 7:18" />ತುನೆ ಕಯೊ ಕ್ಹುದಾ ತುನೆ ಸಮಾನ ವ್ಹೈ? ತು ತಾರಿ ಸ್ವಾಸ್ಥೈಮಾ ಉಗ್ರಲ ಅಪರಾಧ ಮಾಫ ಕರಸ. ತ್ಯುನ ದ್ರೊಹನೆ ದ್ಯಾನ ದಿವಾಲೊ ನ್ಹವೈ. ಹೊ ಅಪ್ನೊ ಕ್ಹುದಾ ಹಮೆಶಾಬಿ ಶಿಟ್ಟ ಥೈನ ರ‍್ಹವಾಲೊ ನ್ಹವೈ . ಮರ್ಗಾನುಜ಼ ತಿನು ಮನಸ ವ್ಹೈ. <verse eid="MIC 7:18" /><verse number="19" style="v" sid="MIC 7:19" />ತೆ ವರಿ ಯಕ್ಕಮ ಮರಗಸ. ಅಪನು ಅಪರಾಧ ಝಾಕಸ. ಕ್ಹುದಾ ತಾರಾ ಮನಕ್ಹೊ ಕರಲ ಪಾಪ ಸುದ್ರಮಾ ನಾಕಿ ಪಾಡಶಿ. <verse eid="MIC 7:19" /><verse number="20" style="v" sid="MIC 7:20" />ತು ಪೈಲಾನಾ ಕಾಲ್ತೊಬಿ ಹಮಾರಾ ಪಿತೃವೊನೆ ಕ್ಹಮ ಘಾಲಲ ತಿಮ್ಮ ಯಾಕೊಬನಾ ಖಾಂದನವಾಲವೊನೆ ಕ್ಹರಿಬಗಲ ರ‍್ಹೈನ ಅಬ್ರಹಾಮನಾ ಖಾಂದಾನವಾಲಾವೊನೆ ಮಯಾ ಬಗಲ ರ‍್ಹೈನ ಚಾ಼ಲಶಿ<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>