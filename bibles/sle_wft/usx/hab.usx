<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Sikkiligar</book>
  <para style="h">ಹಬಕ್ಕುಕ</para>
  <para style="toc3">ಹಬಕ್ಕುಕ</para>
  <para style="toc2">ಹಬಕ್ಕುಕ</para>
  <para style="toc1">ಹಬಕ್ಕುಕ ಬುಕ್ಕ</para>
  <para style="mt2">ಹಬಕ್ಕುಕ</para>
  <para style="mt1">ಹಬಕುಕ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಎ ಪುಸ್ತಕ ಹಬಕ್ಕುಕನೆ ಪ್ರವಾದಿ ವ್ಹೈ ಕೈನ ದೆಕಾಡಿನೆ ದಿವಸ. ಹಬಕ್ಕುಕನು ಪುಸ್ತಕ ಇಸ್ರಾಯೆಲ ವರಿ ಯೆಹುದಯೊನು ರಾಜ್ಯನೆ ಶಿದಾ ಸಂದೆಶ ನೈ ದಿದಲ ಪ್ರವಾದಿಯೊನಾ ಪುಸ್ತಕಮಾ ಬಿಜಿ ತರಾಜ಼ ಛೆ. ಇನಾ ಬದಲ, ಎ ಹಬಕ್ಕುಕನು ಬೆ ದುರೊ ವರಿ ಪ್ರಾಥನಾಬಿ ಛೆ. ಕ್ಹುದಾ ಎ ದುರೊನೆ ಉತ್ತರ ದಿವಸ. ಹಬಕ್ಕುಕ ಯೆರಿಮಿಯಾನಾ ಕಾಲಮಾ ಕ್ಹಾತೆ ರಾಜೊ಼ ಯೊಶಿಯಾ ವರಿ ಯೆಹೊಯಾಕಿಮ ತ್ಯುನೆ ಆಡಳಿತಮಾ ಜಿವ್ತೊ ವ್ಹತೊ ಕೈನ ಗ್ಯಾನಿಯೊ ಬರೊಕ್ಹೊ ಕರ‍್ಯಾಸ. ತೆ ನೈಸೊ ಹಬಕ್ಕುಕನಾ ಪುಸ್ತಕಮಾ ನೈತೊ ಬಿಜಾ಼ ಕಯಾಬಿ ಪವಿತ್ರ ಗ್ರಂಥಮಾ</para>
  <para style="ip">ತೆ ಪವಿತ್ರ ಗ್ರಂಥಮಾ ತೆ ಕಯ ಕಾಲಮಾ ಜಿವ್ತೊ ವ್ಹತೊ ಕವಾನು ಖಾತ್ರಿ ನತ್ತಿ. ಹಬಕುಕ ಪೈಲಾ ಕ್ಹುದಾನಾ ಕ್ಹಾಮೊ ದುರ ಕದ್ಯೊ. ತ್ಯುನೆ ಕರಾನು ಅನ್ಯಾಯ ವರಿ ತ್ರಾಸ ಕರಾನು ದೆಕಾಡ್ಯೊತೊ. ತೆ ನೈಸೊ ಕ್ಹುದಾನೆ ಮದತನಾಹುತಿ ಕರಾನಿ ಪ್ರಾಥನಾನೆ ಜವಾಬ ನೈ ದೆತೊತೊ. ಎ ಕ್ಹಾರು ಯಹುದನಾ ದೆಶಮಾ ಥಯು ವಸೆ. ಇನಾಹುತಿ ಕ್ಹುದಾ ದಿದಲ ಜವಾಬ ವ್ಹೈ. ಮಿ ಬಾಬೆಲೊನವಾಲಾವೊನೆ ಉಟಾಡತೊತೊ ತ್ಯುನೆ ಯಹುದನೆ ನಾಶ ಕರಸ." ಪಾಚಾತಾ ಹಬಕುಕ ವರಿಯಕ್ಕೆಬ ಕ್ಹುದಾಕನ ದುರ ಕದ್ಯೊ. ಕ್ಹುದಾ ಕೆಟ್ಟ ಮನಕ್ಹೊನೆ ಉಪಯೊಗ ಕರಿಲಿನ ದಕ್ಹು ಕೆಟ್ಟ ಕರಲ ಮನಕ್ಹೊನೆ ಶಿಕ್ಷಾ ದಿವಾಡ್ಯೊಸ. ಕೈನ ಇನಾಹುತಿ ಕ್ಹುದಾ ಜಬಾಬಮಾ ಬಾಬೆಲೊನವಾಲಾವೊನೆ ತೆಜ಼ ಹುಬ್ರೈನ ತ್ಯುನೆನೆ ಶಿಕ್ಷಾ ದಿವಸ ಕೈನ ಕದ್ಯೊ.ಲಾಸ್ಟಮಾ ಹಬಕುಕ ಕ್ಹುದಾನೆ ಪ್ರಾಥನಾ ಕರಸ. ಕರುಣಾ ದೆಕಾಡು ಕೈನ ಪ್ರಾಥನಾ ಕರಸ. ಕ್ಹುದಾ ಪಾಚಲ್ಯಾ ದಿನೊಮಾ ಮ್ಹೊಟಾ ಕಾಮೊನಾ ಹುತಿ ಸ್ತುತಿ ಕರಸ.</para>
  <para style="iot">ಸಾರಾಂಶ</para>
  <para style="io1">1 ಅಧ್ಯಾಯ 1:1,4 ಹಬಕುಕನು ಪಸ್ಟಲ್ಯು ದುರು</para>
  <para style="io1">2 ಅಧ್ಯಾಯ 1:5,11 ಕ್ಹುದಾನು ಪೈಲಾನು ಜವಾಬ ಅಧ್ಯಾಯ 1:12,2,1 ಹಬಕುಕನು ಬೆವಾ ದುರ ಅಧ್ಯಾಯ 2:2,20 ಕ್ಹುದಾನು ಬೆವಾ ಜವಾಬ</para>
  <para style="io1">3 ಅದ್ಯಾಯ 3 ಮಾ ಅದ್ಯಾಯಮಾ ಹಬಕುಕನಿ ಪ್ರಾಥನಾ</para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />ಪ್ರವಾದಿ ಥಯಲ ಹಬಕುಕನೆ ಆಯಲ ಕ್ಹುದಾನಿ ವಾತ.<verse eid="HAB 1:1" /></para>
  <para style="s">ಅನ್ಯಾಯನಾ ಹುತಿ ಹಬಕುಕನು ದುರ</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 1:2" />ಯಹೊವಾ ಕ್ಹುದಾ ತಾರಿ ಮದತನಾ ಹುತಿ ಕೆಕ್ಲೊ ಮಾಂಗು ಮಿ ಮಾಂಗಾನು ಕೆಕ್ಲಾ ದಿನ್ನ ನೈ ಐಕ್ತೊ? ತ್ರಾಸ ಥಾವಾಡ್ಯೊಸ ಕೈನ ವದ್ರಾಡ್ಯೊಸ ವರಿಬಿ ತು ವಚಾ಼ಡಾಡ್ಯೊ ನತ್ತಿ. <verse eid="HAB 1:2" /><verse number="3" style="v" sid="HAB 1:3" />ಅನ್ಯಾಯ ಥಾವಾನು ಮಿ ದೆಕಾ ವರಕ್ಹು ಕಾ ಕರಾಡ್ಯೊಸ? ತ್ರಾಸ ಮನೆ ಕಾ ದೆಕಾಡಾಡ್ಯೊಸ? ಹವು ಖತರನಾಕ ಮರಾ ಕ್ಹಾಮುಜ಼ ಛೆ; ಲಡೈಯೊ ಥಾವಾಡಿಯೊಸ. <verse eid="HAB 1:3" /><verse number="4" style="v" sid="HAB 1:4" />ಇಮ್ಮ ರ‍್ಹಯಲ ಹುತಿ ಧರ್ಮೊಪದೆಶ ತಾಕತ ನೈಸೊ ಆವಾನು ಥಯುಸ. ತಿನಾಹುತಿ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ನ್ಯಾಯ ಕರಾನೆ ಥಾವಾಡ್ಯು ನತ್ತಿ. ಕೆಟ್ಟ ಮನಕ್ಹೊ ಚೊ಼ಕಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಝಿತ್ತಾಡ್ಯಾಸ.<verse eid="HAB 1:4" /></para>
  <para style="s">ಯಹೊವಾನು ಉತ್ತರ</para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 1:5" />ಕ್ಹುದಾ ತಿನಾ ಮನಕ್ಹೊನೆ ಅಮ್ಮ ಕದ್ಯೊ. ಮನಕ್ಹೊನಾ ವಚ್ಮಾ಼ ಥಾವಾನು ದೆಕೊ, ಡೊಳೊ ಮ್ಹೆಲೊ ಘಾಬ್ರಾಥಾವೊ; ತುಮಾರಾ ಕಾಲಮಾ ಮಿ ಯಕ್ಕ ಕಾಮ ಕರುಸ, ತುಮೊನೆ ತೆ ತಿಳದ್ಯುತಬಿ ತುಮೆ ಬರೊಕ್ಹೊ ಕರ್ತಾ ನೈ. <verse eid="HAB 1:5" /><verse number="6" style="v" sid="HAB 1:6" />ಮಿ ಬಾಬೆಲೊನವಾಲಾವೊನೆ ಉಟಾಡುಸ. ತ್ಯುನೆ ಘನ್ನಾ ಅಡ್ಮುಟ್ಟ ಮನಕ್ಹೊ ವ್ಹೈ. ತ್ಯುನೆ ಬಿಜಾವೊನಿ ಆಸ್ತಿ ತ್ಯುನಾ ವಶಮಾ ಕರಿಲಿವಾನಾ ಹುತಿ ಕ್ಹಾರಿ ದುನಿಯಾ ಫರಸ. <verse eid="HAB 1:6" /><verse number="7" style="v" sid="HAB 1:7" />ತ್ಯುನೆ ಘನ್ನಾ ಖತರನಾಕ ವರಿ ಘನ್ನಾ ಕೆಟ್ಟ ಮನಕ್ಹೊ ವ್ಹೈ. ತ್ಯುನಾಕ್ಹು ತ್ಯುನೆಜ಼ ಕಾನುನ ರ‍್ಹವಸ. ತ್ಯುನಾಕ್ಹು ತ್ಯುನೆ ಮ್ಹೊಟಾ ಕವೈಲಿವಸ.<verse eid="HAB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HAB 1:8" />ತ್ಯುನಾ ಘೊಡಾ ಚಿರತೆತಿ ಘನ್ನಾ ಘಟ್ಟ ವ್ಹೈ. ತ್ಯುನೆ ನರಿಯೊತಿಬಿ ಹುಷಾರ ರ‍್ಹವಸ. ಘೊಡಾಪರ ಬೈಟಲವಾಲಾ ಘೊಡಾವೊನೆ ನ್ಹಚಾ಼ಡಸ ತ್ಯುನೆ ದುರತಾ ಪಿಟೆಲಾಗಿನ ಆವಸ. ತ್ಯುನೆ ಹದ್ದನಾ ನಿಂಗತ ಉಡಿನ ಆವಸ.<verse eid="HAB 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HAB 1:9" />ತ್ಯುನೆ ತ್ರಾಸ ಕೈನಜ಼ ಕರಾನೆ ಆವಸ; ತ್ಯುನೆ ಗುಂಪ ಉಸುಕನಿ ಜಿಮಿನಮಾ ಆವಸ. ಲೆಕ್ಕೊವಾಚಿ ಬಂದಿ ಕರಿಲಿವಸ. <verse eid="HAB 1:9" /><verse number="10" style="v" sid="HAB 1:10" />ತ್ಯುನೆ ಬಿಜಾ಼ ರಾಜಾವೊನೆ ಕದ್ರಾವಸ. ಮ್ಹೊಟಾ ಮನಕ್ಹೊನೆ ಕದ್ರಾವಸ. ಕೊಟೆನ ಪಾಡಿನ ಮಾತಿನಿ ಘುಂಪಾ ಕರಸ. <verse eid="HAB 1:10" /><verse number="11" style="v" sid="HAB 1:11" />ತೆಳಾಮಾಜ಼ ತುಫಾನನಾ ನಿಂಗತ ಬಿಸ್ತಾ ಗೈಪಡಸ. ತೆ ಮನಕ್ಹೊ ತ್ಯುನಿ ತಾಕತನೆಜ಼ ಆರಾಧನಾ ಕರಸ.<verse eid="HAB 1:11" /></para>
  <para style="s">ಹಬಕುಕ ಕ್ಹುದಾಕನ ವರಿ ಯಕ್ಕೆಬ ದುರ ದಿವಸ</para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 1:12" />ತೆಳಾಮಾ ಹಬಕುಕ ಕದ್ಯೊ, ಯಹೊವಾ ಕ್ಹುದಾ ತು ಅನಾದಿಕಾಲತೊ ಆಯಲವಾಲೊ ನ್ಹವೈಸು? ತು ಮಾರೊ ಪವಿತ್ರ ಕ್ಹುದಾ ತು ಹಮೆಶಾಬಿ ರ‍್ಹವಾಲೊ ಕ್ಹುದಾ ವ್ಹೈ. ಎ ಯಹೊವಾ ಫೈಸಲೊ ಕರಾನಾಹುತಿ ತು ತ್ಯುನೊನೆ ನೆಮಶ್ಯೊಸ ಮಾರಾ ಕ್ಹುದಾ ತು ಶಿಕ್ಷಾ ದಿವಾನಾಹುತಿವ ತ್ಯುನೊನೆ ಅಧಿಕಾರ ದಿದ್ಯೊಸ. ತುಜ಼ ಹಮೊನೆ ಆಸ್ರೊ ವ್ಹೈ. <verse eid="HAB 1:12" /><verse number="13" style="v" sid="HAB 1:13" />ಕೆಟ್ಟಜ಼ ನೈಸೊ ದೆಕಾಲಾ ಪವಿತ್ರ ಕ್ಹುದಾ ಕೆಟ್ಟ ಮನಕ್ಹನೆ ನೈ ಛೊಡಾಲಾ ಕೆಟ್ಟ ಮನಕ್ಹ ಚೊ಼ಕಾ ಮನಕ್ಹನೆ ತ್ರಾಸ ಕರ್ತಾಮಾ ತು ಕಾ ಗಪ್ಪ ಛೆ?<verse eid="HAB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HAB 1:14" />ಆಳಾವಾಲನಿಂಗತ ಮನಕ್ಹೊನಿ ಪರಿಸ್ಥಿತಿ ಕಿಡಾ ಕಾಟುನು ಸ್ತಿತಿನೆ ಕಾ ಲಾಯೊಸ, ಮನಕ್ಹೊನೆ ಸಮುದ್ರನಿಯೊ ಮಚ್ಲಿಯೊನಾ ಸಮಾನ ಕರ‍್ಯೊಸ. <verse eid="HAB 1:14" /><verse number="15" style="v" sid="HAB 1:15" />ತೆ ಬಾಬೆಲೊನವಾಲಾ ಮನಕ್ಹೊನೆ ಗಲ್ಲಕ್ಹು ಉಚೈನ, ತಿನಾ ಬಲಿಯೊಕ್ಹು ಧರಿನ ತ್ಯುನೊನೆ ಮಳಾವಸ. ತೆಳಾಮಾ ತ್ಯುನೆ ಘನ್ನಾ ಖುಶಿ ಥಾವಸ. <verse eid="HAB 1:15" /><verse number="16" style="v" sid="HAB 1:16" />ತಿನಾಹುತಿ ತ್ಯುನಾ ಬಲಿನೆ ಬಲಿ ದಿನ, ತ್ಯುನಾ ಬಲಿನೆ ಉದನೊ ಧವಾಂಡೊ ದಿವಸ ಕಾ ಕದ್ಯಾಮ ತ್ಯುನೆ ಖಾವಾನು ಅನ್ನ ಸ್ವಾದ ಥಾವಸ. ವರಿ ತೆ ಐಶೊ ಅರಾಮನಿ ಜಿವ್ನಾ ಕರಸ.<verse eid="HAB 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HAB 1:17" />ಇಮ್ಮ ರ‍್ಹಯಲಹುತಿ ತ್ಯುನೆ ಹಮೆಶಾಬಿ ಬಲಿಯೊ ವಚೈ಼ನ ಮರ್ಗಾ ನೈಸೊ ದೆಶೊನೆ ನಾಶ ಕರ್ತಾ ತೆ ರ‍್ಹೌಸು.?<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="s">ಹಬಕುಕನೆ ಕ್ಹುದಾನು ಜವಾಬ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 2:1" />ಮಿ ಕೈದಾಲೊ ಥೈನ ಹುಬ್ರೌಸ. ಮಿ ತ್ಯಾ ಮಾರಿ ಜ಼ಗಾ ಲ್ಯುಸ ವರಿ ಕೈದುಸ ತ್ಯಾ ಮಿ ದೆಕುಸ ಯಹೊವಾ ಕ್ಹುದಾ ಸು ಕವಸ.<verse eid="HAB 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2" />ತೆಳಾಮಾ ಮನೆ ಯಹೊವಾ ಕ್ಹುದಾ ಜವಾಬ ದಿದ್ಯೊ ಪ್ರಕಟಣೆ ಬರದ ಕೈನ ಕದ್ಯೊ. ತೆ ಒದಾಲೊ ಭೆಗಿನೆಜ ಒದು ತೆ ಫಳಿಪರ ಬರದ. <verse eid="HAB 2:2" /><verse number="3" style="v" sid="HAB 2:3" />ಎ ಸಂದೆಶ ಅಗೊ ಆವಾನು ರ‍್ಹಯಲ ಖಾಸ ದಿನೊನಾ ಹುತಿ ವ್ಹೈ. ಎ ಸಂದೆಶ ಅಂತ್ಯನಾ ದಿನೊನಾ ಹುತಿ ವ್ಹೈ ವರಿ ಎ ಕ್ಹರಿ ಥಾವಸ. ಅಮ್ಮ ಲಾಗಸ ಎ ದಿನ್ನ ಆತೊಜ಼ ನೈ. ವರಿಬಿ ತೆ ದಿನೊನಾ ಹುತಿ ಸಮಾಧಾನಕ್ಹು ಕೈದೊ ವರಿ ತೆ ದಿನೊ ಆವಸ ವರಿ ತಡಾ ಥಾತು ನೈ. <verse eid="HAB 2:3" /><verse number="4" style="v" sid="HAB 2:4" />ದೆಕೊ, ಕೆಟ್ಟ ಮನಕ್ಹನು ಆತ್ಮಾ ಪುಗ್ಯುಸ, ಯಕ್ಕಜ಼ ಮನಸನೊ ನ್ಹವೈ; ಕ್ಹರಿನೊ ಮನಕ್ಹ ತಿನಿ ಕ್ಹರಿಕ್ಹುಜ಼ ವಾಚ಼ಸ.<verse eid="HAB 2:4" /></para>
  <para style="s">ಕೆಟ್ಟ ಮನಕ್ಹೊನೆ ಥಾವಾನು ತ್ರಾಸ</para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 2:5" />ದ್ರಾಕ್ಷಿಯೊನ ರ‍ಕ್ಹ ತಿನೆ ಮೊಸ ಕರಸ. ತಿನೆ ನಿಶಾ ಥೈನ ತಿನೆ ಸಮಾಧಾನ ಮಳ್ತುಜ಼ ನೈ. ಪಾತಾಳಮಾ ತಿನಿ ಆಸ ಮ್ಹೊಟಿಕರಿಲಿವಸ. ಮೌತನಿಂಗತ ಛೆ, ತೃಪ್ತ ರ‍್ಹತೊ ನೈ ಕ್ಹಾರಾ ದೆಶೊನೆ ತಿನಾಹುತಿ ಮಳಾವಸ. ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ತಿನಾ ಆಳೊ ಕರಿಲಿವಸ. <verse eid="HAB 2:5" /><verse number="6" style="v" sid="HAB 2:6" />ಕ್ಹರಿಮಾಜ಼ ತೆ ಮನಕ್ಹೊ ತಿನೆ ಹಿನಾವಸ. ವರಿ ತೆ ಚೊ಼ರಿಕರಿಲಿದಲನ ಕ್ಹಾರುಜ಼ ಜ಼ಬರದಸ್ತಿನಿ ವಾಟಕ್ಹು ಸೌಕಾರ ಥಯಲವಾಲಾನೆ ತಾರಿ ಗತಿ ಮಿ ಸು ಕೌ?. ಎ ಕೆಕ್ಲಾ ದಿನ್ನಲಕ್ಕಾ ಅಗು ಬಡಸ.<verse eid="HAB 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HAB 2:7" />ತಾರಾ ಸಾಲಾವಾಲಾ ಕ್ಷಣಮಾಜ಼ ತಾರಾ ಕ್ಹಾಮಾ ಹುಬ್ರವಸ ತ್ಯುನೆ ಹುಶಾರ ಥೈನ ತುನೆ ಭುಚ್ಕಾ಼ಡಸ. ತೆಳಾಮಾ ತು ತ್ಯುನಾ ಹತೆ ಸುಲಗೆ ಥಾಶಿ. <verse eid="HAB 2:7" /><verse number="8" style="v" sid="HAB 2:8" />ಕಾ ಕದ್ಯಾಮ ತು ಘನ್ನಾ ದೆಶೊನೆ ಲುಟಿ ಕರ‍್ಯೊಸ. ತ್ಯುನು ರಗತ ಚು಼ವಾಯೊಸ, ತ್ಯುನಾ ದೆಶೊನೆ ವರಿ ಮನಕ್ಹೊನೆ ತ್ರಾಸ ದಿದ್ಯೊಸ, ತಿನಾಹುತಿ ತ್ಯುನೆ ತೆ ಮನಕ್ಹೊ ತಾರಾ ಕ್ಹಾತೆ ಕರಸ. ಕರಲಹುತಿ ತೆ ಮನಕ್ಹೊ ತುನೆ ಲುಟಿ ಕರಸ. ಕಾ ಕದ್ಯಾಮ ತು ಮನಕ್ಹೊನು ರಗತ ಚು಼ವಾಯೊಸ. ದೆಶೊಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರುಜ಼ ನಾಶ ಕರ‍್ಯೊಸ.<verse eid="HAB 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HAB 2:9" />ಅನ್ಯಾಯಕ್ಹು ತಿನಾ ಘರೊ ಭಾಂದಿಲಿವಾಲಾನೆ, ತಿನು ಗುಡ ಉಪ್ಪರ ಮ್ಹೆಲಿಲಿವಾಲಾನೆ ನಾಶನಾ ಹತಮಾತು ಚು಼ಕೈಲಿವಾಲಾನೆ ತ್ರಾಸ! <verse eid="HAB 2:9" /><verse number="10" style="v" sid="HAB 2:10" />ತು ಘನ್ನಾ ಮನಕ್ಹೊನೆ ನಾಶ ಕರಲಹುತಿ ತಾರಾ ಖಾಂದಾನನೆ ಕೆಟ್ಟ ನಾಮ ಲಾಯಲನಿಂಗತ ಥಯು. ತಾರಾಕ್ಹು ತುನೆಜ಼ ಕೆಟ್ಟ ಕರಿಲಿದ್ಯೊ. <verse eid="HAB 2:10" /><verse number="11" style="v" sid="HAB 2:11" />ತಾರಾ ಘರನಾ ದಗಡಾ ತಾರಾ ವಿರುದ್ದ ವದ್ರಸ. ತಿನಿ ಛತ್ತ ತಿನೆ ಪ್ರತಿ ಧ್ವನಿ ಕರಸ.<verse eid="HAB 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 2:12" />ಗಾಮ ಮನಕ್ಹೊನು ರಗತ ಚು಼ವೈನ ಬಾಂದಿನ, ಗಾಮ ಅನ್ಯಾಯಕ್ಹು ತಯ್ಯಾರ ಕಾರಾಲಾನೆ ತ್ರಾಸ! <verse eid="HAB 2:12" /><verse number="13" style="v" sid="HAB 2:13" />ಮನಕ್ಹೊನಿ ಮ್ಹೈನತ ಆಗನೆ ಬೊಂದೊ ಥಾವಸ. ಖಾಂದಾನನಿ ಮ್ಹೈನತ ಬೆಕ್ಕಾರ ಗೈ. ಎ ಯಹೊವಾ ಕ್ಹುದಾನಿ ಚಿತ್ತ ವ್ಹೈ. <verse eid="HAB 2:13" /><verse number="14" style="v" sid="HAB 2:14" />ಸಮುದ್ರಮಾ ಪಾನಿ ಭರಲನಿಂಗತ ದುನಿಯಾಮಾ ಕ್ಹುದಾನಿ ಮಹಿಮಾ ವರಿ ತಿಳವಳಿಕೆ ಬಗಲ ಫೈಲಸ.<verse eid="HAB 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HAB 2:15" />ತಾರಿ ಶಿಟ್ಟ ದ್ರಾಕ್ಷಿಯೊನಾ ರಕ್ಹಮಾ ಕಲೈನ ಬಾಜು಼ವಾಲಾನೆ ಪಿಲೈನ, ತ್ಯುನೊನೆ ಭೊಗಳೊ ದೆಕೊ ಕೈನ ತ್ಯುನೊನೆ ನಿಶಾಕರಲವಾಲಾ ಅಯ್ಯೊ ತಾರಿ ಗತಿ ಮಿ ಸು ಕೌ! <verse eid="HAB 2:15" /><verse number="16" style="v" sid="HAB 2:16" />ಮಹಿಮಾನಿ ಬದಲ ತಾರಾಮಾ ಸರಮುಂದೊ ಥಯೊಸ. ಹಮ್ನಾ ತಾರಿ ಪಾಳಿ, ಪಿನ ಭೊಗಳೊ ಥಾ, ಯಹೊವಾ ಕ್ಹುದಾನಾ ಶಿದಾ ಹತ್ಮಾನೊ ತಾಂಬಿಯೊ ತಾರಾ ಬಗಲ ಕರಿಲೆ ತಾರಿ ಘನತೆ ಮರಿಯಾದಿ ಝಾಕಸ. <verse eid="HAB 2:16" /><verse number="17" style="v" sid="HAB 2:17" />ತು ಮನಕ್ಹೊನು ರಗತ ಚು಼ವೈನ ದೆಶನಾ ಕ್ಹಾರ ಮನಕ್ಹೊನೆ ತ್ರಾಸ ಕರಲ ಹುತಿ ಲೆಬೊನನೆ ತ್ರಾಸ ಥಯಲ ತುಬಿ ಪಡಸಿ, ಜಾನವರೊ ನಾಶ ಥಾವಾನು ತುನೆ ಭುಚ್ಕಾ಼ಡಸ.<verse eid="HAB 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HAB 2:18" />ಮನಕ್ಹ ತಯ್ಯಾರ ಕರಲ ಮೊರ್ತಿಕ್ಹು ಸು ಉಪಯೊಗ ವ್ಹೈ? ಸುಳ ಬೊಲಾಲಿ ಮೊರ್ತಿಯೊನಿ ಕಿಮ್ಮತ ಸು ಛೆ? <verse eid="HAB 2:18" /><verse number="19" style="v" sid="HAB 2:19" />ಧಿಕ್ಕಾರ ಛೆ ತೆ ಮನಕ್ಹನೆ ಮೊರ್ತಿನೆ ಕವಸ, ಯ ಕ್ಹುದಾ ಜಾ಼ಗ ಉಟ್ಟ!<verse eid="HAB 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HAB 2:20" />ತೆ ನೈಸೊ ಯಹೊವಾ ತಿನಾ ಪವಿತ್ರ ಮಂದಿರಮಾ ಛೆ. ತಿನಾಕ್ಹಾಮಿ ದುನಿಯಾ ಕ್ಹಾರಿಜ಼ ಗಪ್ಪ ರ‍್ಹವಾದೆ.<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s">ಹಬಕುಕನಿ ಪ್ರಾಥನಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1" />ಯೆಹೊವಾ, ಐಕ್ಯೊಸ ತಾರಿ ವೈಭವ</para>
  <para style="q1" vid="HAB 3:1">ಅಜ಼ಬಥಯೊ ಐಕಿ ತಾರಾ ಮ್ಹೊಟ ಕಾಮೊ<verse eid="HAB 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2" />ಫರಿನ ಕರ ಹಮಾರಾ ವಕ್ಹತಮಾ ತೆ ಕ್ಹಾರು</para>
  <para style="q1" vid="HAB 3:2">ದೆಕಾಡಿನೆ ದೆ ಹಮ್ನಾಜ಼ ತೆ ಕ್ಹಾರು.</para>
  <para style="q2" vid="HAB 3:2">ಘನ್ನೊ ಶಿಟ್ಟ ಥಯೊತಬಿ ಇಕ್ಹುರು ನಕೊ ಮರ್ಗಾ<verse eid="HAB 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3" />ಆವಾಡ್ಯೊಸ ಕ್ಹುದಾ, ತೆಮಾನ ಬಗಲ್ತೊ!</para>
  <para style="q2" vid="HAB 3:3">ತೆ ಪವಿತ್ರ ಪಾರಾನ ಪರ್ವತೊ!</para>
  <para style="q1" vid="HAB 3:3">ಫೈಲಸ ತಿನು ಪ್ರಭಾವ ಆಕಾಶಮಂಡಲಮಾ</para>
  <para style="q2" vid="HAB 3:3">ಭರಿಜಾ಼ವಸ ತಿನಿ ಮಹಿಮಾ ಭುಂಡಲ ಕ್ಹಾರು<verse eid="HAB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4" />ಸುರ್ಯಾ ನಿಂಗತ ಛೆ ತಿನು ಚಮಕನು ಮೆರ್ದಾನು</para>
  <para style="q2" vid="HAB 3:4">ಕಿರಣೊ ಭಾರಿಯೊ ಆವಾಡಿಯೊ ತಿನಾ ಹತ್ಮಾತಿಯೊ</para>
  <para style="q2" vid="HAB 3:4">ಝಕಾಯುಸ ತ್ಯಾಜ಼ ತಿನಿ ಶಕ್ತಿ ಸಾಮರ್ಥ.<verse eid="HAB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5" />ಚಾ಼ಲಿಯೊಸ ವ್ಯಾದಿಯೊ ತಿನಾ ಕ್ಹಾಮಿಯೊ</para>
  <para style="q2" vid="HAB 3:5">ಆವಾಡ್ಯುಸ ಮೌತ ತಿನಾ ಪಾಚು಼.<verse eid="HAB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6" />ಕಾಪಸ ಜಿಮಿನ ತೆ ಹುಬ್ರಯೊಮ</para>
  <para style="q2" vid="HAB 3:6">ಉದ್ರಿ ಜಾ಼ವಸ ದುನಿಯಾ ತೆ ದೆಕ್ತಾಮಾ,</para>
  <para style="q1" vid="HAB 3:6">ಚಿರೈ ಜಾ಼ವಸ ಪೈಲಾನಾ ಡೊಂಗ್ರೊ .</para>
  <para style="q2" vid="HAB 3:6">ಕತ್ರೈನ ಪಡಿಜಾ಼ವಸ ಸನಾತನನಿಯೊ ಗಿರಿಯೊ</para>
  <para style="q2" vid="HAB 3:6">ಪೈಲಾನಿಂಗತಜ಼ ರ‍್ಹವಸ ತೆ ಆವಾನು.<verse eid="HAB 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7" />ದೆಕೊ, ತಳಮಳ ಥಯುಸ ಕುಶಾನನಾ ಝುಪ್ಡಾ,</para>
  <para style="q2" vid="HAB 3:7">ಕಾಪಾಡ್ಯಾಸ ಮಿದ್ಯಾನಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಝುಪ್ಡಾ<verse eid="HAB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8" />ಮ್ಹಾಡೊಪರ ತು ಆಯೊ ಕಾ?</para>
  <para style="q2" vid="HAB 3:8">ಝಿತ್ತಾನಾ ಘೊಡಾವೊಪರ ಬೈಟಿನ ಆಯೊ ಕಾ?</para>
  <para style="q1" vid="HAB 3:8">ಯೆಹೊವಾ, ತುನೆ ಘನ್ನಿ ಶಿಟ್ಟ ಛೆಸು ನದಿಯೊಪರ</para>
  <para style="q2" vid="HAB 3:8">ಶಿಟ್ಟ ಸಿಡುಕ ಛೆಸು ಹೊಂಡೊಪರ</para>
  <para style="q2" vid="HAB 3:8">ಘನ್ನೊ ಶಿಟ್ಟ ಛೆಸು ಸಮುದ್ರಪರ<verse eid="HAB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9" />ಕಾಡಿನ ಮ್ಹೆಲ್ಯೊ ಬಿಲ್ಲು ಬಾಣೊ ಖಾಂದಾಪರ್ತೊ</para>
  <para style="q2" vid="HAB 3:9">ಮಾರ್‍ಯೊ ಬಾಣೊ ತಿಮಾತಿಯೊ</para>
  <para style="q1" vid="HAB 3:9">ಚಿರಿಪಾಡ್ಯೊಸ ಜಿಮಿನ ನದಿಯೊಕ್ಹು .<verse eid="HAB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 3:10" />ಕಾಪಸ ಡೊಂಗ್ರೊ ತುನೆ ದೆಕಿನ ;</para>
  <para style="q2" vid="HAB 3:10">ಹರ್ದಸ ಆಗಸತು ಪ್ರವಾಹ;</para>
  <para style="q1" vid="HAB 3:10">ಹತ್ತ ಉಚೈನ ಅವಾಜ ಕರಸ ಸಮುದ್ರೊ.<verse eid="HAB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11" />ಉಡಿನ ನ್ಹಾಟಸ ತಾರಿಯೊ ಬಾಣೊ ಉಜಾಲಕ್ಹು</para>
  <para style="q2" vid="HAB 3:11">ಚಮ್ಕಸ ತಾರಿ ಚಮಕಕ್ಹು.</para>
  <para style="q1" vid="HAB 3:11">ಸುರ್ಯೊ ಚ಼ಂದಪ್ಪಾ ದಡಸ ಗುಡಮಾ<verse eid="HAB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12" />ಜಿಮಿನಪರ ಹೈದಿನ ಜಾ಼ಸಿ ಘನ್ನಿ ಶಿಟ್ಟಕ್ಹು</para>
  <para style="q1" vid="HAB 3:12">ದೆಶೊನೆ ಖುಂದಿಪಾಡುಸ ಅರ್ಬಾಟಕ್ಹು<verse eid="HAB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13" />ಚಾಲ್ಯೊಸ ತು ತಾರಾ ಮನಕ್ಹೊನೆ ರಕ್ಷಣೆ,</para>
  <para style="q2" vid="HAB 3:13">ತಾರಾ ಹತೆ ಅಭಿಶೆಕ ಥಯಲವಾಲಾನೆ ವಚಾ಼ಡಾನಾ ಹುತಿ;</para>
  <para style="q1" vid="HAB 3:13">ಬಡೈಪಾಡ್ಯೊಸ ಮನಕ್ಹನ ಟೌಕಾನೆ</para>
  <para style="q2" vid="HAB 3:13">ಜಿಮನನಾ ಸಮಾ ಕರಿಪಾಡ್ಯೊಸ ತಿನಾ ಗರನೆ. ಸೆಲಾ<verse eid="HAB 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14" />ಗಳುಸ ದಡಿನ ದಿಕ್ಕ ನೈಸೊವಾಲಾನೆ ದಾಬಿನ ಫುಗ್ಗಾಲಾವೊನೆ</para>
  <para style="q2" vid="HAB 3:14">ಕೈನ ಕವಾಲಾ ಮನೆ ಝುದೊ ಕರುಕೈನ ಮಪರ</para>
  <para style="q2" vid="HAB 3:14">ತುಫಾನ ನಿಂಗತ ಪಡಿನ ತ್ಯುನಾ ಆಯುದೊಕ್ಹುಜ಼ ಮಾರ‍್ಯೊ.<verse eid="HAB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15" />ತಾರಾ ಘೊಡಾ ಛಡಲವಾಲಾವೊ ಥೈನ ತು ಬುರುಗ ರ‍್ಹಯಲ ಸಮುದ್ರ ಖುಂದತೊ</para>
  <para style="q2" vid="HAB 3:15">ಮ್ಹೊಟಾ ಪಾನಿಪರ ಚಾ಼ಲ್ತೊ ಗಯೊಸ.<verse eid="HAB 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16" />ಎ ಐಕಿನ ತಳಮಳ ಥಯು ಮಾರು ಪೆಟ</para>
  <para style="q2" vid="HAB 3:16">ಹಲ್ಯಾ ತೆ ಅವಾಜ ಕ್ಹು ಮಾರಾ ಹೊಟೊ</para>
  <para style="q1" vid="HAB 3:16">ಕ್ಹಡಲ ನಿಂಗತ ತಯಾ ಮಾರಾ ಹಡ್ಕಾ</para>
  <para style="q2" vid="HAB 3:16">ಹುಬ್ರಯಲ ಜ಼ಗಾಜ಼ ಕಾಪ್ಯಾ ಮಾರಾ ಪೊಗೊ</para>
  <para style="q1" vid="HAB 3:16">ತ್ರಾಸ ಐಜ಼ಪಡಸ ಮನೆ ಘೆರೊ ಘಾಲಲ</para>
  <para style="q2" vid="HAB 3:16">ಕೈದಿ ರ‍್ಹೌಸ ಮಿ ತಡ್ದಿಲಿನ ತ್ಯಾಲಕ್ಕಾ.<verse eid="HAB 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17" />ಅಂಜುರನು ಝಾಡ ಚಿಗರ‍್ಯಾವಾಚಿ ರ‍್ಹೈತಬಿ</para>
  <para style="q2" vid="HAB 3:17">ದ್ರಾಕ್ಷಿಯೊನ ಬಳ್ಳಿಮಾ ಪಲ್ಲ ನೈ ದಿಕ್ಹ್ಯುತಬಿ</para>
  <para style="q1" vid="HAB 3:17">ತೆಲಾನಾ ಜಾಡೊ ಉತ್ಪತ್ತಿ ಸುಜ಼ ನೈ ರ‍್ಹಯುತಬಿ</para>
  <para style="q2" vid="HAB 3:17">ಖೆತರೊಮಾ ಕಯುಜ ಅನಾಜ ನಯ ಹುಟ್ಯುತಬಿ</para>
  <para style="q1" vid="HAB 3:17">ಬಕ್ರಾನಿಯೊ ಹಟ್ಟಿಯೊ ಖಾಲಿ ರ‍್ಹಯುತಬಿ</para>
  <para style="q2" vid="HAB 3:17">ಢೊರನಿಯೊ ಹಟ್ಟಿಯೊ ಖಾಲಿರ‍್ಹಯುತಬಿ<verse eid="HAB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18" />ಕ್ಹುಶಿಕ್ಹು ರ‍್ಹೌಸ ಯೆಹೊವಾಮಾ</para>
  <para style="q1" vid="HAB 3:18">ಕ್ಹುಶಿಕ್ಹು ರ‍್ಹೌಸ ಮಾರಾ ಉದ್ದಾರ ಕರಾನಾ ಕ್ಹುದಾಮಾ<verse eid="HAB 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19" />ಯಹೊವಾ ಕ್ಹುದಾ ದಿವಸ ಮನೆ ತಡ್ದಾನು</para>
  <para style="q2" vid="HAB 3:19">ಹುಶಾರ ಕರಸ ತೆ ಮಾರಾ ಪಗೊ ಚಿಗ್ರಿನಿಂಗತ</para>
  <para style="q2" vid="HAB 3:19">ಕರಸ ಡೊಂಗರೊನೆ ಮಿ ನ್ಹಾಟಾ ನಿಂಗತ<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>