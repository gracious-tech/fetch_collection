<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="RUT" style="id">- Sikkiligar</book>
  <para style="h">ರುತ</para>
  <para style="toc3">ರುತ</para>
  <para style="toc2">ರುತ</para>
  <para style="toc1">ರುತ ಬುಕ್ಕ</para>
  <para style="mt2">ರುತ</para>
  <para style="mt1">ರುತ</para>
  <para style="iot">ವಳಕ</para>
  <para style="ip">ಇಸ್ರೆಯಲನಾ ನ್ಯಾಯಸ್ತಾಪಕನಾ ಕಾಲಮಾ ಇಸ್ರಾಯೆಲನಾ ಖಾಂದಾನಮಾ ಥಯಲ ಯಕ್ಕ ಅದ್ಭುತ ಕಾಮನಾ ಹುತಿ ರುತ ಪುಸ್ತಕಮಾ ದೆಕಾಡಸ. ಎ ಖಾಂದಾನಮಾ ಮಾ ನವೊಮಿ , ತಿನಾ ಮಾಟಿನೆ ವರಿ ತಿನಾ ಬೆ ಬಚ್ಚಾವೊನೆ ಮೊವಾಬ ಕವಾನಾ ಬಿಜಾ಼ ದೆಶಮಾ ರ‍್ಹತಾಮಾ ತ್ಯಾ ತ್ಯನು ಮೌತ ಥಾತಾಮಾ ಯಕ್ಕ ಮ್ಹೊಟೊ ದುರಂತ ಅನುಭವಿಸಸ. ತೆ ನೈಸೊ ಪಾಚಾತಿ ನವೊಮಿ ವ್ಹೌವೊ ರ‍್ಹಯಲಮಾನಿ ಯಕ್ಲಿನೆ ಮೊವ್ಯಬ ದೆಶವಾಲಿ ರ‍್ಹಯಲ ರುತ ಇಸ್ರಾಯೆಲೆ ಫರಿನ ಗೈನ ತಿನು ಕ್ಹಾತ ದ್ಯುಸ ಕೈನ ಬರೊಕ್ಹೊ ದಿಲಾತಾಮಾ ಆಶಿರ್ವಾದ ಹೊಂದಿಲಿವಸ. ಪಾಚಾ಼ತೊ ಬುವಜನ ಕವಾಲೊ ತಿವ್ನಾ ಖಾಂದಾನವಾಲೊ ತ್ಯುನೊನೆ ರಾಕಸ. ವರಿ ರುತನೆ ಹಿವಾ ಕರಿಲಿವಾಹುತಿ ವಪ್ಪಿಲಿಸ ರುತ ವರಿ ನವೊಮಿ ಆಶಿರ್ವಾದ ಹೊಂದಿಲಿವಸ. ನ್ಯಾಯಸ್ಥಾಪಕೊನೊ ವಕ್ಹತ ಕೆಟ್ಟ ವ್ಹತೊ ವರಿ ಘನ್ನಾ ಇಸ್ರಾಯೆಲೊ ಕಾನುನನೆ ಕಿಮ್ಮತ ದಿದ್ಯಾವಾಚಿ ಜಿವ್ನಾ ಕರಡ್ಯಾತಾ. ತೆ ನೈಸೊ ನವೊಮಿ, ರುತ ವರಿ ಬೊವಜ ಕ್ಹುದಾನಾ ನಿಯಮೊ ಪಾಲ್ಸಾನಾಹುತಿ ದೆಕಾಡಿನೆ ದೆತಾತಾ. ರುತ ಪುಸ್ತಕ ಕುನ್ನ ಬರದ್ಯುಸ ಕವಾನು ಗ್ವತ್ತ ನತ್ತಿ. ತಿನಿ ತಾರಿಕಬಿ ಗ್ವತ್ತ ನತ್ತಿ. ತೆ ನೈಸೊ ದಕ್ಹಾಜ಼ನಾ ಎ ಇಸ್ರೆಲ ದೆಶ ಭ್ರಷ್ಟ ಪಾಚಾ಼ತಾ ಇಪಯೊಗ ಕರಲ ಹಿಬ್ರು ಭಾಶಾ ಪ್ರಕಾರ ಬರ್ದಲ ಛೆ ಕೈನ ವಿಚಾರ ಕರಸ. ಇಸ್ರೆಲ ನೈತೊ ರುತ ದಾವಿದ ರಾಜಾನಿ ಪರ ಬುಡಿ ಥಯಲ ಕವಾನು ವ್ಹೈ. ಇನೊ ಮತ್ಲಬ ವ್ಹೈ ಎ ಯೆಸುನಿ ಪುರ್ವಜ ವ್ಹೈ. ಕ್ಹುದಾನೆ ಸೆರಲ ವ್ಹೈ ಕವಾನು ಅಪೆ ಕಯಾ ಖಾಂದಾನವಾಲಾ ವ್ಹೈ ಕವಾನು ಯಕ್ಕಜ಼ ಮನಸ್ಪರ ಆಧಾರ ಛೆ ಕವಾನು ದೆಕಾಡಿನೆ ದಿವಸ.</para>
  <para style="iot">ಭಾಗೊ</para>
  <para style="io1">1 ಅಧ್ಯಾಯ 1 ಮಾ ನವೊಮಿ ಕುಟುಂಬ ವರಿ ತ್ಯುನೆ ಅನುಭವಿಸಲ ದುರಂತ ವರಿ ಪಾಚಾ಼ತಿ ನವೊಮಿ ವರಿ ರುತ ಇಸ್ರೆಯಲ ಫರಿನ ಆಯಾಸ ಕವಾನು ದೆಕಾಡಿನೆ ದಿವಸ.</para>
  <para style="io1">2 ಅಧ್ಯಾಯ 2 ಮಾ ರುತ ತಿನಾ ಖೆತರಮಾ ಅನಾಜ಼ ಕಾಟತಾಮಾ ಬುವಜನ ತಿನೆ ಕಿಮ್ಮ ಮಳ್ಯೊ ಅಪೆ ದಕಿಯೆಸ.</para>
  <para style="io1">3 ಅಧ್ಯಾಯ 3 ಮಾ ಪಾಚಾತೊ ಬುವಜನ ತಿಮ್ಮ ಕರಾನೆ ವಪ್ಪಸ ಬುವಜನ ತ್ಯುನೊ ಸಂದಿರ‍್ಹಯಲ ಹುತಿ ರುತನೆ ಹಿವಾಕರಿಲಿವಾನು ವರಿ ತ್ಯುನೊನೆ ದೆಕಾರಣಕಿ ಕರಿಲಿವಾನಾಹುತಿ ಪುಚತಾಮಾ ವರಿ ರುತನೆ ಕಿಮ್ಮ ಮೊಕಲಿ ಕವಾನು ದೆಕಾಡಿನೆ ದಿವಸ.</para>
  <para style="io1">4 ಅಧ್ಯಾಯ 4 ಮಾ ಬುವಜನ ನವೊಮಿ ಮರಲ ಮಾಟಿನಿ ಆಸ್ತಿ ಕಿಮ್ಮ ಇಕ್ಕಾತೊ ಲಿದ್ಯೊ ರುತನೆ ಕಿಮ್ಮ ಹಿವಾ ಕರಿಲಿದ್ಯೊ ಕವಾನು ದೆಕಾಡಿನೆ ದಿವಸ.</para>
  <chapter number="1" style="c" sid="RUT 1" />
  <para style="s">ಎಲಿಮೆಕನು ಕುಟುಂಬ ಮೊವ್ಯಾಬ ದೆಶೆ ಗಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 1:1" />ಪೈಸಲೊ ಕರಲಾವೊನಾ ಕಾಲಮಾ ಆಳತಾಮಾ ದೆಶಮಾ ಬರಗಾಲ ಆಯಲಹುತಿ ಯೆಹುದಾ ಪ್ರಾಂತ್ಯನೊ ಬೆತ್ಲೆಹೆಮವಾಲೊ ಯಕಲೊ ತಿನಿ ಬೈಕೊ, ಬೆ ದಿಕ್ರಾವೊನಾ ಕ್ಹಾತೆ ಮೊವಾಬ್ಯ ದೆಶಮಾ ರ‍್ಹೌ ಕೈನ ಗಯೊ. <verse eid="RUT 1:1" /><verse number="2" style="v" sid="RUT 1:2" />ತೆ ಮನಕ್ಹನೆ ಎಲಿಮೆಲಕ ಕೈನ ತಿನಿ ಬೈಕೊನೆ ನೊವೊಮಿ ಕೈನ ಬೆ ಬಚ್ಚಾ಼ ವ್ಹತಾ. ಮಹ್ಲೊನ, ಕಿಲ್ಯೊನ. ಕೈನ ನಾಮ ವ್ಹೈ. ಯೆಹೊದಾ ದೆಶನ ಮಳಲ ಎಫ್ರಾತಮಾ ರ‍್ಹಯಲ ಬೆತ್ಲೆಹೆಮವಾಲಾ ರ‍್ಹಯಲ ಇವ್ನೆ ಐನ ಮೊವ್ಯಾಬ ದೆಶಮಾ ಪ್ರವಾಸವಾಲಾ ರ‍್ಹಯಾ. <verse eid="RUT 1:2" /><verse number="3" style="v" sid="RUT 1:3" />ತೆಳಾಮಾ ನೊವೊಮಿನೊ ಮಾಟಿ ರ‍್ಹಯಲ ಎಲಿಮೆಲಕ ಮರ‍್ಯೊ. ತೆ ಭಂಬಿ ಪಟ್ಟಾವೊನಾ ಕ್ಹಾತೆ ವಾಚಿತಿ, <verse eid="RUT 1:3" /><verse number="4" style="v" sid="RUT 1:4" />ಎ ಬಚ್ಚಾ಼ ಒರ್ಫಾ, ರುತ ನಾಮ ಕವಾಲಿಯೊ ಮೊವ್ಯಾಬ್ಯನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಹಿವಾ ಕರಿಲಿನ ತ್ಯಾ ಕಮ್ಸಿ ಕಮ್ಮ ದಕ್ಹ ವರಕ್ಹ ಲಕ್ಕಾ ತ್ಯಾಜ಼ ವ್ಹತಾ. <verse eid="RUT 1:4" /><verse number="5" style="v" sid="RUT 1:5" />ತ್ಯುನೆ ತ್ಯಾ ರ‍್ಹತಾಮ ನವೊಮಿನಾ ಭಂಬಭಿ ಪಟ್ಟಾ ಮರಿಗಯಾ ಇಮ್ಮ ತೆ ಬಾಕ್ಡಿ ಮಾಟಿನೆ ಭಂಬಿ ಬಚ್ಚಾವೊನಿ ಜೈವೈಲಿನ ಯಕ್ಲಿಜ಼ ಥೈಗೈ.<verse eid="RUT 1:5" /></para>
  <para style="s">ನವೊಮಿ ವರಿ ರುತ ಬೆತ್ಲೆಹೆಮೆ ವಾಪಾಸ ಆಯಲ</para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 1:6" />ಯಹೊವಾ ತಿನಾ ಮನಕ್ಹೊನೆ ಆಶಿರ್ವಾದ ದಿನ ಅನಾಜ಼ ದಿದ್ಯೊಸ ಕೈನ ಸುದ್ದಿ ಐಕಿನ ನೊವೊಮಿ ಮೊವ್ಯಾಬ್ಯ ದೆಶತಿ ತಿನಾ ಸ್ವಂತ ದೆಶೆ ಜೌ಼ ಕೈನ ವ್ಹೌವೊನಾ ಕ್ಹಾತೆ ಜಾ಼ತಾಮಾ, <verse eid="RUT 1:6" /><verse number="7" style="v" sid="RUT 1:7" />ತೆ ತಿನಿಯೊ ವ್ಹೌವಾನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ಜ಼ಗಾತಿ ಯಹುದಾ ದೆಶೆ ಜಾ಼ವಾನಿ ವಾಟಮಾ ನವೊಮಿ ತ್ಯುನೊನೆ, <verse eid="RUT 1:7" /><verse number="8" style="v" sid="RUT 1:8" />"ತುಮಾರಾ ತುಮಾರಾ ಮಾ ಪಾಪನಾ ಘರೆ ಜಾ಼ವೊ; ತುಮೆ ಮಾರಾ ಮರಲ ದಿಕ್ರಾವೊನೆ ಮಯಾ ಕರಲನಿಂಗತ ಯಹೊವಾ ತುಮೊನೆ ಮಯಾ ಕರಿನ ತುಮೊನೆ ಮರ್ಗಾದೆ. <verse eid="RUT 1:8" /><verse number="9" style="v" sid="RUT 1:9" />ತುಮೆ ಭಂಬಿಜ಼ನಿಯೊ</para>
  <para style="p" vid="RUT 1:9">ಹಿವಾಕರಿಲಿನ ಮಾಟಿನಾ ಘರ್ಮಾ ಸುಖಾಮಾ ರ‍್ಹವಾ ವರಕ್ಹು ಯಹೊವಾ ಆಶೊರ್ವಾದ ದಿವಾದೆ ಕೈನ ಮಟ್ಟಿಲಿದಿ. ತೆಳಾಮಾ ತ್ಯುನೆ ಘನ್ನಿಯೊ ರ್ವಯ್ಯೊ. <verse eid="RUT 1:9" /><verse number="10" style="v" sid="RUT 1:10" />ತೆಳಾಮಾ ತ್ಯುನೆ ಹಮೆ ತಾರಾ ಕ್ಹಾತೆ ಅಪ್ನಾ ಮನಕ್ಹೊಕನಜ಼ ಐಯೆಸ ಕದಿಯೊ.<verse eid="RUT 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="RUT 1:11" />ತೆಳಾಮಾ ನವೊಮಿ ತ್ಯುನೊನೆ ಮಾರಿ ದಿಕ್ರಿಯೊ, ತುಮೆ ಮಾರಾ ಕ್ಹಾತೆ ಆವಾನು ಕಾ? ಪಾಚಿಯೊ ಫರಿನ ಗೈಪಡೊ, ತುಮೊನೆ ಮಾಟಿಯೊ ದಿವಾನೆ ಮಾರಾ ಬಚ್ಚಾ಼ ನತ್ತಿ. <verse eid="RUT 1:11" /><verse number="12" style="v" sid="RUT 1:12" />ಬಿಜೆಕ್ಲಾನೆ ಹಿವಾ ಕರಿಲಿವಾನೆಬಿ ಮಿ ಜಾಂಜಿಮಾನ ನತ್ತಿ. ತಿನಾಹುತಿ ಮಾರಿಯೊ ದಿಕ್ರಿಯೊ ತುಮೆ ಪಾಚಾ಼ ಫರಿನ ಜಾವೊ, ವರಿಬಿ ಹಿವಾ ಕರಿಲಿನ ಬಚ್ಚಾ಼ ಜ಼ನ್ನಿಮಿ, <verse eid="RUT 1:12" /><verse number="13" style="v" sid="RUT 1:13" />ತ್ಯುನೆ ಮ್ಹೊಟಾ ಥಾಯೆಲಕ್ಕಾ ಕೈದೊಶಿಸು? ತ್ಯಾಲಕ್ಕಾ ಮಾಟಿಯೊ ನೈಸೊ ರ‍್ಹವೊಶಿಸು? ಮಾರಿ ದಿಕ್ರಿಯೊ ತಿಮ್ಮ ಕರೊ ನಕೊ; ಕಾಕದ್ಯಾಮ ಯೆಹೊವಾನೊ ಹತ್ತ ಮಾರಾ ವಿರುದ್ದ ರ‍್ಹಯಲ ಹುತಿ ಮಿ ತುಮಾರಾ ಹುತಿ ಘನ್ನಿ ದುಖ ಪಡ್ದುಸ ಕದಿ.<verse eid="RUT 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 1:14" />ತೆಳಾಮಾ ತ್ಯುನೆ ವರಿ ಘನ್ನಿಯೊ ರ್ವಯ್ಯೊ. ತೆಳಾಮಾ ಒರ್ಫ ಫೈನೆ ಮಟ್ಟಿಲಿನ ಗೈ, ರುತತೊ ಫೈನೆ ಛೊಡಿನೆ ಗೈನೈ. <verse eid="RUT 1:14" /><verse number="15" style="v" sid="RUT 1:15" />ತೆಳಾಮಾ ನೊವೊಮಿ ರುತನೆ ದೆಕ ತಾರಿ ದೆರಾಣಿ ಫರಿನ ತ್ಯುನಾ ಮನಕ್ಹೊಕನ ವರಿ ತ್ಯುನಾ ದಿವಸ್ತಾನೊಕನ ಜಾ಼ವಸ. ತುಬಿ ತಿನಾನಿಂಗತಜ಼ ತುಮಾರಾ ಮನಕ್ಹೊಕನ ಜಾ಼ ಕದಿ.<verse eid="RUT 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="RUT 1:16" />ತೆಳಾಮಾ ರುತ ತುನೆ ಛೊಡಿನ ಜೌ಼ ಕೈನ ಮನೆ ಜಬರದಸ್ತಿ ಕರು ನಕೊ. ತು ಕಿಜ್ಗಾ ಗೈತಬಿ ಮಿ ತ್ಯಾ ಔಸ ತು ರ‍್ಹಯಲ ಜ಼ಗಾ ಮಿಬಿ ರ‍್ಹೌಸ; ತಾರಾ ಮನಕ್ಹೊಜ಼ ಮಾರಾ ಮನಕ್ಹೊ ವ್ಹೈ; ತಾರೊ ಕ್ಹುದಾ ಮಾರೊ ಕ್ಹುದಾ ವ್ಹೈ. <verse eid="RUT 1:16" /><verse number="17" style="v" sid="RUT 1:17" />ತು ಮರಾನಿ ಜ಼ಗಾ ಮಿಬಿ ತ್ಯಾಜ ಮರುಸ. ತ್ಯಾಜ಼ ಮಾರಿ ಮಜಾ಼ರ ಥೌ. ಮೌತಕ್ಹು ತುಕ್ಹು ದುರ ಥೈಮ ಯಹೊವಾ ಮನೆ ಕೆಕ್ಲಿಬಿ ಶಿಕ್ಷಾ ದಿವಾದೆ.<verse eid="RUT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="RUT 1:18" />ತೆ ತಿನಾ ಕ್ಹಾತೆ ಆವಾನೆ ಘಟ್ಟ ಥೈಗೈಸ ಕೈನ ನವೊಮಿನೆ ಗ್ವತ್ತ ಥೈನ ಗಪ್ಪಜ಼ ರ‍್ಹೈ.<verse eid="RUT 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="RUT 1:19" />ವರಿ ತ್ಯುನೆ ತ್ಯಾಂತಿಯೊ ಬೆತ್ಲೆಹೆಮೆ ಐನ ಗಾಮ್ಮಾ ಆತಾಮಾ ತ್ಯಾ ತ್ಯಾನಿಯೊ ಬಾಕ್ಡಿಯೊ ಘಾಬ್ರಿಯೊ ಥೈನ ನವೊಮಿ ವ್ಹೈ ಕೈನ ವಳಕಿನೆ ತಿನೆ ಬೊಲಾಡಿಯೊತಿಯೊ<verse eid="RUT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="RUT 1:20" />ತೆಳಾಮಾ ತೆ ತ್ಯುನೊನೆ ಮನೆ ನವೊಮಿ ಕೈನ ಬಲಾವೊನಕೊ; ಯೆಹೊವಾ ಮನೆ ಘನ್ನೊ ದುಖ ಕರ‍್ಯೊಸ, ಮನೆ "<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">ಮಾರಾ ಕವಾನಿ ಶಬ್ದನೊ ಮತ್ಲಬ ಕಡು</char></note>ಮಾರಾ" ಕೈನ ಬಲಾವೊ. <verse eid="RUT 1:20" /><verse number="21" style="v" sid="RUT 1:21" />ಮಿ ಕ್ಹಾರು ಕ್ಹಾರುಜ಼ ರ‍್ಹಯಲವಾಲಿ ಥೈನ ಗೈತಿ; ಸರ್ವ ಶಕ್ತ ಯಹೊವಾ ಮನೆ ಗತಿಗೆಡಿ ಕೈನ ಆವಾವರಕ್ಹು ಕರ‍್ಯೊಸ. ಯಹೊವಾ ಮಾರಾ ವಿರುದ್ದ ಸಾಕ್ಷಿ ಕದ್ಯೊಸ. ಯಹೊವಾ ಮನೆ ತ್ರಾಸ ದಿದ್ಯೊಸ. ತಿನಾಹುತಿ ತುಮೆ ಮನೆ ನವೊಮಿ ಕೈನ ಬಲಾವಾನು ಕಾ?<verse eid="RUT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="RUT 1:22" />ಇಮ್ಮ ನವೊಮಿ ಮೊವಾಬ್ಯ ವಾಲಿ ಥಯಲ ತಿನಿ ವ್ಹೌ ರುತನಾ ಕ್ಹಾತೆ ಬೆತ್ಲೆಹೆಮೆ ಐ ತೆಳಾಮಾ ಜವೆ ಘೌನು ಸುಗ್ಗಿ ಸುರು ಥೈತಿ.<verse eid="RUT 1:22" /></para>
  <chapter eid="RUT 1" />
  <chapter number="2" style="c" sid="RUT 2" />
  <para style="s">ರುತ ಬುವಜನನಾ ಖೆತರಮಾ ಕಾಮ ಕರಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 2:1" />ನವೊಮಿನೊ ಮಾಟಿನಾ ಎಲೆಮೆಕನಾ ಖಾಂದಾನಮಾ ಘನ್ನೊ ಸೌಕಾರ ರ‍್ಹಯಲ ಬೊವಜ ಕವಾಲೊ ಯಕ್ಲೊ ವ್ಹತೊ. <verse eid="RUT 2:1" /><verse number="2" style="v" sid="RUT 2:2" />ಯಕ್ಕ ದಿನ್ನ ಮೊವ್ಯಾಬ್ಯನಿ ರ‍್ಹಯಲ ರುತ ನವೊಮಿನೆ ಮಿ ಗೈನ</para>
  <para style="p" vid="RUT 2:2">ಕುನ್ನ ಮನೆ ಮರ್ಗಸ ತಿನಾ ಖೆತರಮಾ ಕಾಮ ಕರಿನ ಔಸ ಕೈನ ಕದಿ ತಿನಾಹುತಿ ತೆ ಮಾರಿ ದಿಕ್ರಿ ಗೈನಾ ಕದಿ.<verse eid="RUT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="RUT 2:3" />ಎಲಿಮೆಕನ ಒಸವಾಲೊ ರ‍್ಹಯಲ ಬೊವಜನಾ ಖೆತರ್ಮಾ ಕಾಮ ಕರಾಲಾವೊನಾ ಕ್ಹಾತೆ ಕಾಟಾನೆ ಗೈ.<verse eid="RUT 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="RUT 2:4" />ತೆಳಾಮಾ ಬೊವಜ ಬೆತ್ಲೆಹೆಮತಾ ಖೆತರಮಾ ಐನ ಕಾಟಾಲಾವೊನೆ ಯಹೊವಾ ತುಮಾರ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ ಕದ್ಯೊ. ತಿವ್ನೆ ಯಹೊವಾ ತುನೆ ಆಶಿರ್ವಾದ ದಿವಾದೆ ಕದ್ಯಾ.<verse eid="RUT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 2:5" />ಬೊವಜ ಕಾಟಾಲಾವೊಪರ ಮ್ಹೊಟೊ ಮುಕಾದಮನೆ ರ‍್ಹಯಲವಾಲಾನೆ ಬಲೈನ ಆ ಛೊಕ್ರಿ ಕುನ್ನ ವ್ಹೈ ಕೈನ ಪುಚ್ಯೊ.<verse eid="RUT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 2:6" />ತೆಳಾಮಾ ತೆ ನವೊಮಿನಾ ಕ್ಹಾತೆ ಆಯಲ ಮೊವ್ಯಬ್ಯನಿ ಬಾಕಡಿ ವ್ಹೈ ಕದ್ಯೊ. <verse eid="RUT 2:6" /><verse number="7" style="v" sid="RUT 2:7" />ತೆ ಕಾಟಾಲಾವೊನಾ ಪಾಚಾ಼ತಿ ಸಿವೊಡೊನೆ ವಚ್ಮಾತಿಕಾಡಾನೆ ಅಪ್ಪಣೆ ಥೌ ಕೈನ ಕೈಲಿದಿ. ತೆ ಪಾಟೆ ಆಯಲವಾಲಿ ಹಜು಼ನಬಿ ನ್ಹ್ಯಾಜ ಛೆ ಹಮ್ನಾ ದಕ್ಹಿಯೆಳ ಅರಾಮ ಕರಾಡಿಸ ಕದ್ಯೊ. <verse eid="RUT 2:7" /><verse number="8" style="v" sid="RUT 2:8" />ತೆಳಾಮಾ ಬೊಜನ ರುತನೆ ಮಾರಿ ದಿಕ್ರಿ, ಐಕ, ಮಾರು ಖೆತರ ಛೊಡಿನ ಬಿಜಾ಼ವೊನಾ ಖೆತರಮಾ ಜೌ಼ ನಕೊ ಮಾರಿಯೊ ಹೆಣ್ಣ ಆಳೊನಾ ಕ್ಹಾತೆ ರ‍್ಹೈ. <verse eid="RUT 2:8" /><verse number="9" style="v" sid="RUT 2:9" />ಮಾರಾ ಆಳೊ ಕಾಟಾನಾ ಹುತಿ ಕಯಾ ಖೆತರೆ ಜಾ಼ವಸ ತೆ ಖೆತರೆ ತುಬಿ ಜಾ಼ ತುನೆ ಕುನ್ನಜ಼ ಮುಟ್ಟು ನೈ ಕೈನ ಮಾರಾ ಗಂಡ ಆಳೊನೆ ಅಪ್ಪಣೆ ದಿದ್ಯೊಸ. ತುನೆ ತರಕ್ಹ ಲಾಗಿಮ ಮಾರ ಸೆವಕೊ ತುನೆ ಪಾನಿ ಲೈನ ಪಾನಿ ಭರಲಮಾ ತು ಗೈನ ಪಾನಿ ಪಿ ಕದ್ಯೊ.<verse eid="RUT 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="RUT 2:10" />ರುತ ತಿನೆ ಪಗೆ ಪಡಿ ಬಿಜಾ಼ ದೆಶವಾಲಿ ರ‍್ಹಯಲ ಮನೆ ಅಕ್ಲಿ ದಯಾ ಮಯಾ ಕಾ? ಕತಾಮಾ<verse eid="RUT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="RUT 2:11" />ಬೊವಜ ತಾರೊ ಮಾಟಿ ಮರಲ್ಪರ ತು ತಾರಿ ಫೈನಾ ಕ್ಹಾತೆ ಮಯಾ ಕರಿನ ಮಾ ಬಾಪನೆ ಸ್ವಂತ ದೆಶ ಛೊಡಿನ ತು ನ್ಹ್ಯಾಲಕ್ಕಾ ಗ್ವತ್ತ ನೈಸೊ ಮನಕ್ಹೊಕನ ಐಸ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="RUT 2:11" /><verse number="12" style="v" sid="RUT 2:12" />ತು ಕರಲ ಉಪಕಾರನೆ ಬದಲಿ ಯಹೊವಾ ತುನೆ ಉಪಕಾರ ಕರಾದೆ; ತು ಕಿನಾ ರೆಕ್ಯಾವೊಮಾ ಝಾಕಿಲಿವಾನೆ ಆಯಿಸ ಇಸ್ರಾಯೆಲನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ತುನೆ ಆಸ್ರೊ ವರಿ ಪ್ರತಿಫಲ ದಿವಾದೆ ಕದ್ಯೊ.<verse eid="RUT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="RUT 2:13" />ತೆಳಾಮಾ ತೆ ಮಾಲಕ ದಾಸಿ ಥಯಲವಾಲಿನೆ ಮನೆ ಮರಗ್ಯೊ. ಮಿ ತಾರಾ ದಾಸಿ ವ್ಹೈ ಕೈನ ಕವೈ ಲಿವಾವರಕ್ಹಿಬಿ ಯೊಗ್ಯ ನೈ ರ‍್ಹೈ ತಬಿ ಮನ ಮರ್ಗಿನ ಮಯಾಕ್ಹು ಬೊಲಾಡ್ಯೊಸ ಕದ್ಯೊ.<verse eid="RUT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 2:14" />ಕಾವಾನೊ ವಕ್ಹತ ಥಾತಾಮಾ ತೆನೆ ಬಲೈನ ರೊಕ್ಲೊ ಭಾಗಿನ ಖಾಟೊ ರಕ್ಹಮಾ ದುಬೈನ ಖಾ ಕೈನ ಬಲೌ ಕತಾಮಾ ತೆ ಕಾಟಾಲಾವೊನಾ ಕ್ಹಾತೆ ಬೈಟಿತಿ. ಎ ನೈಸೊ ತೆ ತಿನೆ ಬಳಲ ತೆನೆ ದಿದ್ಯೊ. ತೆ ಪೆಟ ಭರಿನ ಖೈನ ವರಿ ತಿಕನ ಉಗ್ರಲ ರ‍್ಹೈ. <verse eid="RUT 2:14" /><verse number="15" style="v" sid="RUT 2:15" />ತೆ ಥಯಲ್ಪರ ಫರಿನ ಕಾಮ ಕರಾನೆ ಉಟ್ತಾಮಾ ಬೊವಜ ತಿನಾ ಸೆವಕೊನೆ ಭೆಗಿನ ಕಾಮ ಕರಾಡಿ ನತ್ತಿ ಕೈನ ತಿನೆ ಶಿಟ್ಟ ಕರೊ ನಕೊ. <verse eid="RUT 2:15" /><verse number="16" style="v" sid="RUT 2:16" />ಭಾರಾವೊಮಾತು ತೆನೆ ಕಿತ್ತಿನ ಹೆಟೊ ಪಾಡೊ; ತೆ ಪಡಲನೆ ಮಳಾವಾದೆ. ತಿನೆ ಭುಚ್ಕಾಡೊ ನಕೊ ಕದ್ಯೊ.<verse eid="RUT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="RUT 2:17" />ರುತ ಕ್ಹಾಂಜಲಕ್ಕಾ ಕಾಟಿನ ಮಳಾಯಲ ಬಡಾತಾಮಾ ಕಮ್ಸೆ ಕಮ್ಮ ಚಾರ ಪೈಲಿ ಘೌ ಮಳ್ಯಾ. <verse eid="RUT 2:17" /><verse number="18" style="v" sid="RUT 2:18" />ರುತ ತೆ ಘೌ ಉಚೈನ ತಿನಿ ಫೈಕನ ಲೈನ ದೆಕಾಡಿ ವರಿ ತೆ ಖೈನ ಉಗ್ರಲ ಅನ್ನ ಲೈನ ದಿದಿ, <verse eid="RUT 2:18" /><verse number="19" style="v" sid="RUT 2:19" />ತಿನಿ ಫೈ, ತು ಕಿನಾ ಖೆತರಮಾ ಕಾಮ ಕರಾಡಿತಿ? ಕಿಜಾ ಕಾಮ ಕರಾಡಿತಿ? ತುನೆ ಮರ್ಗಲವಾಲಾನೆ ಚೊ಼ಕು ಥಾವಾದೆ ಕತಾಮಾ ರುತ ಮಿ ಕಿನಾ ಖೆತರಮಾ ಕಾಮ ಕರಾಡಿತಿ ತಿನು ನಾಮ ಬೊವಜ ವ್ಹೈ ಕೈನ ಕದಿ.<verse eid="RUT 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="RUT 2:20" />ತೆಳಾಮಾ ನವೊಮಿ, ರುತನೆ ಮರಲವಾಲಾವೊನೆ ಜಿವ್ತಾರ‍್ಹಯಲವಾಲಾವೊನೆ ಮರ್ಗಾಲಾನೆ ಯಹೊವಾಕ್ಹು ತಿನಿ ಆಶಿರ್ವಾದ ಥಾವಾದೆ ಕೈನ ತೆ ಮನಕ್ಹ ಅಪ್ನೊ ಸಂಭಂದಿಕಮಾನೊ ಯಕ್ಲೊ ವ್ಹೈ ಕೈನ ರುತ ಕನ ಕದಿ.<verse eid="RUT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="RUT 2:21" />ತೆಳಾಮಾ ಮೊವಾಬ್ಯನಿ ಥಯಲ ರುತ ಎ ನೈಸೊ ತೆ ಮನಕ್ಹೊ ಸುಗ್ಗಿ ಮುಗ್ದೆಲಕ್ಕಾ ಮಾರಾ ಆಲೊನಾ ಕ್ಹಾತೆಜ಼ ಕಾಮ ಕರ ಕೈನ ಕದ್ಯೊಸ ಕದಿ.<verse eid="RUT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="RUT 2:22" />ನವೊಮಿ ತಿನೆ ವ್ಹೌನೆ ಮಾರಿ ದಿಕ್ರಿ, ತು ತಿನಿಯೊ ಹೆಣ್ಣ ಆಳೊನಾ ಕ್ಹಾತೆಜ಼ ಜಾ಼ವಾನು ಚೊ಼ಕ ವ್ಹೈ ಕೈನ ಕದಿ. ಬಿಜಾ಼ವೊನಾ ಖೆತರಮಾ ಜಾ಼ವತ್ತೊ ತುನೆ ಸುಬಿ ತ್ರಾಸ ಥಾತುತು. <verse eid="RUT 2:22" /><verse number="23" style="v" sid="RUT 2:23" />ತಿನಾ ನಿಂಗತಜ಼ ಫೈನಾ ಘರ್ಮಾಜ಼ ರ‍್ಹೈನ ಜವೈ ಘೌ ವರಿ ಘೌನಿ ಸುಗ್ಗಿ ಮುಗ್ದೆಲಕ್ಕಾ ಬೊವಜನನಾ ಹೆಣ್ಣ ಆಳೊನಾ ಕ್ಹಾತೆಜ಼ ತೆನಿಯೊ ಇನಾಡಿತಿ.<verse eid="RUT 2:23" /></para>
  <chapter eid="RUT 2" />
  <chapter number="3" style="c" sid="RUT 3" />
  <para style="s">ರುತನೆ ಮಾಟಿ ಮಳಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 3:1" />ಯಕ್ಕ ಸಲಾ ನೊವೊಮಿ ವ್ಹೌನೆ "ಮಾರಿ ದಿಕ್ರಿ ತು ಗ್ರಹಿಣಿ ಥೈನ ಸುಖಾಮಾ ರ‍್ಹವಾನು ಮಿ ಕೊಶಿಶ ಕರು ನೈ. <verse eid="RUT 3:1" /><verse number="2" style="v" sid="RUT 3:2" />ತು ಕಯಾನಾ ಹೆಣ್ಣ ಆಳನಾ ಕ್ಹಾತೆ ಕಾಮ ಕರಿಸಿ? ತೆ ಭೊವಜನ ಹಮಾರಿ ಸಂಭಂದಿಕ ಥೈನ ರ‍್ಹವಸ್ತೊ! ತೆ ಆಜ಼ನಿ ರಾತಮಾ ಕಣಮಾ ಜವೆನು ಘೌ ತುರಸ್ತೊ. <verse eid="RUT 3:2" /><verse number="3" style="v" sid="RUT 3:3" />ತು ಅಂಗ ಧ್ವನಿ ತೆಲ ಲಗಾಡಿಲಿನ ಚೊ಼ಕಾ ವಣ್ಣಾ ಫೆರಿಲಿನ ತ್ಯಾ ಜಾ. ತೆ ಅನ್ನಪಾನಿ ಲಿಯೆಲಕ್ಕಾ ತು ದಡಿ ರ‍್ಹೈನ, <verse eid="RUT 3:3" /><verse number="4" style="v" sid="RUT 3:4" />ತೆ ಕ್ಹುರವಾನಿ ಜ಼ಗಾ ವಳಕ ಕರಿನ ಗೈನ ತಿನಾ ಪಗೊಪರ ವಡಿಲಿದಲ ಜಾಡಿ ಸರಕೈನ ತಿನಾ ಪಗೊಕನ ಕ್ಹುರೆ; ಪಾಚಾ಼ತು ತು ಕರುಕವಾನು ತುನೆ ತೆ ಕವಸ" ಕದಿ.<verse eid="RUT 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 3:5" />ತೆವಾತೆ ರುತ ತಿನೆ ಫೈ ತು ಕಿಮ್ಮ ಕಸಿ ತಿಮ್ಮಜ಼ ಕರುಸ” ಕದಿ.<verse eid="RUT 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 3:6" />ತೆಳಾಮಾ ತೆ ಕಣಮಾ ಗೈನ ತಿನಿ ಫೈ ಕದಲ ತಿಮ್ಮ ಕರಿ. <verse eid="RUT 3:6" /><verse number="7" style="v" sid="RUT 3:7" />ಬೊವಜ ಅನ್ನ ಪಾನಿ ಖೈನ ಕ್ಹುಶಿಕ್ಹು ಅನಾಜ಼ನಿ ಢಿಗನಾ ಬಾಜು಼ಮಾ ಕ್ಹುರಲ್ಪರ ತೆ ದಡಿನ ಐನ ತಿನಾ ಪಗೊಪರ ವಡಿಲಿದಲ ಝಾಡಿ ಸರಕೈನ ತ್ಯಾಜ಼ ಕ್ಹುರೈ. <verse eid="RUT 3:7" /><verse number="8" style="v" sid="RUT 3:8" />ಅರ್ದಿರಾತಮಾ ತೆ ದಾಣಗೊ ಉಟಿನ ದೆಕ್ತಾಮಾ ತಿನಾ ಪಗೊಮಾ ಕ್ಹುರಯಲ ಬಾಕ್ಡಿನೆ ದೆಕಿನ ಅಜಬ ಥಯೊ. <verse eid="RUT 3:8" /><verse number="9" style="v" sid="RUT 3:9" />ತೆಳಾಮಾ ತೆ ತಿನೆ ಕುನ್ನ ವ್ಹೈ ಕೈನ ಪುಚ್ತಾ಼ಮಾ</para>
  <para style="p" vid="RUT 3:9">ತೆಳಾಮ ತೆ ಮಿ ತಾರಿ ದಾಸಿ ಥಯಲ ರುತ ವ್ಹೈ ತು ಹಮೊನೆ ನಜಿಕೊನೊ ಸಂಭಂದಿ ರ‍್ಹಯಲಹುತಿ ತು ವಡಿಲಿದಲ ಜಾಡಿ ಮಪರ ವರಾಡ ಕದಿ.<verse eid="RUT 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="RUT 3:10" />ತೆಳಾಮಾ ತೆ ಮಾರಿ ದಿಕ್ರಿ ಯಹೊವಾಕ್ಹು ತುನೆ ಆಶಿರ್ವಾದ ಥಾವಾದೆ; ತು ಗರಿಬೊನೆ ವರಿ ಸೌಕರೊನಾ ಜಾಂಜಿಮಾನೊನೆ ದೆಕಿನ ಗೈ ನೈ ಹಮ್ನಾ ತು ಭಕ್ತಿಮಾ ಪೈಲಾತಿ ಖಾಸ ದಿಕ್ಹ್ಯು. <verse eid="RUT 3:10" /><verse number="11" style="v" sid="RUT 3:11" />ದಿಕ್ರಿ ಹಮ್ನಾ ಭುಚ಼ಕು ನಕೊ ತು ಮರ್ಯಾದಿ ವಾಲಿ ವ್ಹೈ ಕೈನ ಗಾಮ್ಮಾ ಗ್ವತ್ತ ಛೆ. ತಿನಾಹುತಿ ಕದಲ ಕ್ಹಾರುಜ಼ ಕರುಸ. <verse eid="RUT 3:11" /><verse number="12" style="v" sid="RUT 3:12" />ಮಿ ನಜಿಕನೊ ಬಂದು ವ್ಹೈ ಕವಾನು ಕ್ಹರಿ ವ್ಹೈ, ವರಿಬಿ ಮತ್ತಿಬಿ ತುನೆ ನಜಿಕ ಥಾವಾಲೊ ಯಕ್ಲೊ ಛೆ. <verse eid="RUT 3:12" /><verse number="13" style="v" sid="RUT 3:13" />ಆಜ಼ ರಾತೆ ನ್ಹ್ಯಾಜ಼ ರ‍್ಹೆ; ವ್ಹಂತಾ ತೆ ತಾರಿ ಜವಾಬ್ದಾರಿ ಲಿದ್ಯೊಮ ಚೊ಼ಕು ವ್ಹೈ; ನೈತೊ ಯಹೊವಾನಾ ಕ್ಹಮ ಮಿಜ಼ ತೆ ಕರುಸ. ಪಾಟ ಥಾಯೆಲಕ್ಕಾ ನ್ಹ್ಯಾಜ಼ ಕ್ಹುರೆ ಕೈನ ಕದ್ಯೊ.<verse eid="RUT 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 3:14" />ತೆ ತೆಳಕ್ಕಾ ತಿನಾ ಪಗೊಮಾಜ಼ ಕ್ಹುರೈತಿ, "ಯಕ್ಕ ಬಾಕಡಿ ಕಣನೆ ಐತಿ ಕವಾನು ಕಿನೆಜ಼ ಗ್ವತ್ತ ಥೌ ನೈ. ತೆ ಕದಲ ಹುತಿ ವಳಕಬಿ ಲಾಗು ನೈಸೊ ಯಕ್ಲು ಅಂದಾರು ರ‍್ಹತಾಮಾಜ಼ ತೆ ಉಟಿ. <verse eid="RUT 3:14" /><verse number="15" style="v" sid="RUT 3:15" />ತೆಳಾಮಾ ತೆ ತಿನೆ ತಾರಿ ಘುಂಗಡಿ ವಚ್ಚಾ಼ ಕತಾಮಾ ತೆ ವಚ್ಚಾ಼ತಾಮಾ ಕಮ್ಸೆ ಕಮ್ಮ ತಿಮಾ ತನ್ನ ಪೈಲಿ ಜವೆ ಘೌ ಘಾಲಿನ ಉಚಾಯೊ. ತೆ ಗಾಮಮಾ ಗೈ , <verse eid="RUT 3:15" /><verse number="16" style="v" sid="RUT 3:16" />ತೆ ತಿನಿ ಫೈಕನ ಆತಾಮಾ ತಿನಿ ಫೈ ಮಾರಿ ದಿಕ್ರಿ ತು ಗಯಲ ಕಾಮ ಸು ಥಯು</para>
  <para style="p" vid="RUT 3:16">ಕತಾಮಾ ತೆ ತ್ಯಾ ಥಯಲ ಕ್ಹಾರುಜ಼ ಕದಿ <verse eid="RUT 3:16" /><verse number="17" style="v" sid="RUT 3:17" />ತು ಖಾಲಿ ಹತೆ ತಾರಿ ಫೈಕನ ಜೌ ನೈ ಕೈನ ಕಮ್ಸೆ ಕಮ್ಮ ಪೈಲಿ ತನ್ನ ಪೈಲಿ ಜವೆ ಘೌ ದಿದ್ಯೊಸ ಕದಿ.<verse eid="RUT 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="RUT 3:18" />ತಿನಿ ಫೈ ಮಾರಿ ದಿಕ್ರಿ ಎ ಕಾಮ ಕಿಮ್ಮ ಥಾಸ ಕೈನ ಗ್ವತ್ತ ಥಾಯೆಲಕ್ಕಾ ಗಪ್ಪ ರ‍್ಹೆ; ಇ ವಕ್ಹತಮಾ ತಿನೆ ತೆ ಕಾಮ ಪುರಾ ಕರೆಲಕ್ಕಾ ಗಪ್ಪ ರ‍್ಹತೊ ನೈ ಕದಿ<verse eid="RUT 3:18" /></para>
  <chapter eid="RUT 3" />
  <chapter number="4" style="c" sid="RUT 4" />
  <para style="s">ಬುವಜನ ರುತನೆ ಹಿವಾ ಕರಿಲಿದಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 4:1" />ಬೊವಜ ಗೈನ ಗಾಮನಾ ಬಾಕಲಕನ್ನ ಬೈಟ್ಯೊ. ತೆ ಕದಲ ನಜಿಕನೊ ಬಂಧು ತೆ ವಾಟಮಾ ಜಾ಼ವಾಲಾನೆ ದೆಕಿನ ತಿನೆ ಎ ಬಾ ನ್ಹ್ಯಾ ಮಕನ ಐನ ಬೈಟ ಕೈನ ಬಲಾತಾಮಾ ತೆ ತಿಕನ ಐನ ಬೈಟ್ಯೊ. <verse eid="RUT 4:1" /><verse number="2" style="v" sid="RUT 4:2" />ತೆಳಾಮಾ ತ್ಯಾನಾ ದಕ್ಹ ಶಾನಾವೊನೆ ಬಲೈಲಾತಾಮಾ ತ್ಯುನೆ ತ್ಯಾ ಐನ ಬ್ಯೆಟ್ಯಾ. <verse eid="RUT 4:2" /><verse number="3" style="v" sid="RUT 4:3" />ತೆಳಾಮಾ ಬೊವಾಜ ತೆ ಬಂಧುನೆ ಮೊವ್ಯಾಬ್ಯ ದೆಶತಿ ವಾಪಾಸ ಫರಿನ ಆಯಲ ನವೊಮಿ ಎಲಿಮೆಕನ ಪಾಲನು ಆಯಲ ಖೆತರ ಇಕ್ಕಿಪಾಡುಕೈನ ಕವಾಡಿಸ. ಮಿ ತುಕನ ಸು ಕೌಸ ಕೈನ ಕದ್ಯಾಮ, <verse eid="RUT 4:3" /><verse number="4" style="v" sid="RUT 4:4" />ತು ತೆ ಖೆತರ ಇಕ್ಕಾತೊ ಲಿವಾನೊ ರ‍್ಹಯಲ ಎ ಶಾನಾವೊನಾ ಕ್ಹಾಮೊ ಲೆ. ನೈತೊ ಮನೆ ಕೆ ಮನೆ ಗ್ವತ್ತ ಥೌ</para>
  <para style="p" vid="RUT 4:4">ವರಿ ಎ ಖೆತರ ತು ನೈ ಲಿದ್ಯೊಮ ಮಿಜ಼ ಎ ಖೆತರ ಲ್ಯುಸ ಕೈನ ಕದ್ಯೊ ಅಪೊನೆ ಛೊಡಿನ ಬಿಜು ಕುನ್ನಜ ತೆ ಖೆತರ ಲಿವಾನೆ ಹಕ್ಕ ನತ್ತಿ.<verse eid="RUT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 4:5" />ತೆಳಾಮಾ ಬುವಜನ ತು ನವೊಮಿತು ತೆ ಖತರ ಲಿವಾನಾ ದಿನ್ನಮಾ ಖೆತರನೊ ಖಾತೊ ತಿನೊ ಮರಲ ದಿಕ್ರಾನಾ ನಾಮೆ ಉಗ್ರವಾನಿಂಗತ ತಿನಿ ಬೈಕೊನೆ ಮೊವಬ್ಯನಿ ಬಾಕಡಿ ಥಯಲ ರುತನೆ ಹಿವಾ ಕರಿಲ್ಯು ಕೈನ ಕತಾಮಾ<verse eid="RUT 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 4:6" />ತೆ ಬಂದು ತಿಮ್ಮ ರ‍್ಹಯುಮ ತೆ ಲಿನ ಮಿ ಮಾರಿ ಆಸ್ತಿ ಹಾಳ ಕರಿಲೆತೊ ನೈ. ತೆ ವಾಟೊ ತುಜ಼ ಲೆ ಮಾರಾ ಹತೆ ಥಾತು ನೈ ಕದ್ಯೊ. <verse eid="RUT 4:6" /><verse number="7" style="v" sid="RUT 4:7" />ಕಯುಬು ಯಕ್ಕ ಸಾಮನ ಲೆತಾಮಾ ವರಿ ದೆತಾಮಾ ತೆ ವಾತ ಖಾತ್ರಿ ಕೈನ ಕರ್ಲೆತಾಮಾ ಇಸ್ರಾಯೆಲನಾ ಪೈಲಾನಾ ಕಾಲಮಾತೊ ಕೈ ಪದ್ದತ ವ್ಹೈ ಕದ್ಯಾಮ ಲಿವಾಲೊ ವರಿ ದಿವಾಲೊ ತಿನಾ ಪಗಮಾನಿಯೊ ಕಾರ್ಮಲಿಯೊ ದಿವಸ; ಇಮ್ಮ ಕರ‍್ಯಾಮ ವಾತ ದಿದಲನಿಂಗತ ವ್ಹೈ ಕದ್ಯಾ. <verse eid="RUT 4:7" /><verse number="8" style="v" sid="RUT 4:8" />ತಿಮ್ಮಜ಼ ತೆ ಸಂಭಂದಿಕ್ಕ ಬುವಜನನೆ ತುಜ಼ ಲಿಪಾಡ ಕೈ ತಿನಿಯೊ ಕಾರ್ಮಲಿಯೊ ಕಾಡಿನ ದಿದ್ಯೊ. <verse eid="RUT 4:8" /><verse number="9" style="v" sid="RUT 4:9" />ತೆಳಾಮಾ ಬುವಜನ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಮಿ ಎಲಿಮೆಕ, ಕಿಲ್ಯೊನ, ಮಹ್ಲೊನನಾ ನಾಮೆ ರ‍್ಹಯಲ ಕ್ಹಾರು ನವೊಮಿಕಂತು ಲಿದ್ಯೊಸ ಕವಾನಿಕ್ಹು ತುಮೆಜ಼ ಸಾಕ್ಷಿ ವ್ಹೈ. <verse eid="RUT 4:9" /><verse number="10" style="v" sid="RUT 4:10" />ಖೆತರ ಖಾತೊ ಮರಿಗಯಲ ಮಹ್ಲೊನ ನಾಮಪರ ಹುಬ್ರೈನ ತ್ಯುನಾ ಬಂದುವೊಮಾ ಗಾಮ್ಮಾಬಿ ತಿನು ಸಂತಾನ ಉಗ್ರವಾ ವರಕ್ಹು ಮೊವ್ಯಾಬ್ಯವಾಲಿ ಬೈಕೊ ಥಯಲ ರುತನೆ ಹಿವಾ ಕರಿಲಿದ್ಯೊಸ ಕವಾನು ತುಮೆಜ಼ ಸಾಕ್ಷಿ ವ್ಹೈ.<verse eid="RUT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="RUT 4:11" />ತೆಳಾಮಾ ತೆ ವಾತೆ ತ್ಯಾ ಬೈಟಲ ಶಾನಾ ಹೊ, ಹಮೆಜ಼ ಸಾಕ್ಷಿ ವ್ಹೈ. ಯಹೊವಾ ಇಸ್ರಾಯೆಲ ಘರ ಭಾಂದಲ ರಾಹೆಲಿಲಿಯಾ ಕವಾಲಿ ಬಾಕಡಿಯೊನು ತುಮೆ ಕಿಮ್ಮ ಕವೊಶಿ ತಿಮ್ಮ ತಾರಾ ಘರೆ ಐಯೆಸ. ಎ ಬಾಕಡಿ ಅಬಿವೃದ್ದಿ ಥಾವಾದೆ ಎಫ್ರಾತಮಾ ಚೊ಼ಕಾ ಕಾಮೊ ಕರ ಬೆತ್ಲೆಹೆಮಮಾ ಘನ್ನೊ ಸೌಕಾರ ಥಾ. <verse eid="RUT 4:11" /><verse number="12" style="v" sid="RUT 4:12" />ಯಹೊವಾ ತೆ ಬಾಕಡಿನಾ ಮ್ಹೊಡಾತು ತುನೆ ದಿವಾನು ಸಂತಾನಕ್ಹು ತಾರು ಘರ ಯಹೊದಾನೆ ತಾಮಾರಾ ಕ್ಹು ಹುಟ್ಟಲ ಪೆರೆಚನನಾ ಘರನೆ ಸರಿಸಮಾನ ಥಾವಾದೆ.<verse eid="RUT 4:12" /></para>
  <para style="s">ಬೊವಜ ವರಿ ತಿನಿ ಸಂತತಿ</para>
  <para style="p">
    <verse number="13" style="v" sid="RUT 4:13" />ಬೊವಜ ರುತನೆ ಬೈಕೊ ವ್ಹೈ ಕೈನ ವಪ್ಪಿಲೆತಾಮಾ ತೆಳಮಾ ಯಹೊವಾನಿ ಆಶಿರ್ವಾದಕ್ಹು ಪೆಟೆ ರ‍್ಹೈನ ಪಟ್ಟೊ ಜ಼ನ್ನಿ. <verse eid="RUT 4:13" /><verse number="14" style="v" sid="RUT 4:14" />ತೆಳಾಮಾ ತೆ ಬಾಕಡಿಯೊ ನವೊಮಿ ಇ ವಕ್ಹತಮಾ ತುನೆ ಭಾದ್ಯಸ್ಥ ಥಾವಾಲಾನೆ ದಿದಲ ಯಹೊವಾನಿ ಮಹಿಮಾ ಥಾವಾದೆ. ಎ ದಿಕ್ರೊ ಇಸ್ರಾಯಲನು ನಾಮ ಥಾವಾದೆ. <verse eid="RUT 4:14" /><verse number="15" style="v" sid="RUT 4:15" />ಎ ತಾರು ನಾಮ ಉಚ್ಚು಼ ಲಾವಸ ವೈಸ ಥಯಲ್ಪರ ತುನೆ ರಾಕಸ ತುನೆ ಘನ್ನೊ ಮಯಾ ಕರ್ತೊ ಕ್ಹಾತ ಪಟಾವೊತಿ ತುನೆ ಉತ್ತಮ ರ‍್ಹಯಲ ತಾರಿ ವ್ಹೌ ಇನೆ ಜ಼ನ್ನಿಸ್ತೊ. ಕದಿಯೊ. <verse eid="RUT 4:15" /><verse number="16" style="v" sid="RUT 4:16" />ನವೊಮಿ ತೆ ಬಚ್ಚಾನೆ ಖೊಳಾಮಾ ಲಿನ ರಾಕಾಡಿತಿ.<verse eid="RUT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="RUT 4:17" />ಆಜೊ ಬಾಜುವಾಲಿಯೊ ನವೊಮಿ ಯಕ್ಕ ಪಟ್ಟೊ ಹುಟ್ಟ್ಯೊಸ ಕೈನ ತಿನು ನಾಮ ಒಬದ್ಯ ಕೈನ ಮ್ಹೆಲ್ಯಾ,ಎಜ</para>
  <para style="p" vid="RUT 4:17">ಒಬದ್ಯ ಇಶಾಯನನೊ ಬಾ ವ್ಹೈ. ಇಶಾಯನನೊ ದಿಕ್ರೊ ದಾವಿದ ವ್ಹೈ.<verse eid="RUT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="RUT 4:18" />ಪೆರೆಚನನು ಖಾಂದಾನ, ಪೆರೆಚನನೆ ಹೆಚ್ರೊನನೆ ಪಡದ್ಯೊ. <verse eid="RUT 4:18" /><verse number="19" style="v" sid="RUT 4:19" />ಹೆಚ್ರೊನ ರಾಮನ್ನೆ ಪಡದ್ಯೊ, ರಾಮನ್ನ ಅಮ್ಮಿನಾದಾಬನೆ ಪಡದ್ಯೊ, <verse eid="RUT 4:19" /><verse number="20" style="v" sid="RUT 4:20" />ಅಮ್ಮಿನಾದಾಬ ನಹೊಶನನೆ ಪಡದ್ಯೊ, ನಹೊಶನ ಸಲ್ಮೊನನೆ ಪಡದ್ಯೊ, <verse eid="RUT 4:20" /><verse number="21" style="v" sid="RUT 4:21" />ಸಲ್ಮೊನನ ಬೊವಜನೆ ಪಡದ್ಯೊಬೊವಜ ಒಬೆದನನೆ ಪಡದ್ಯೊ. <verse eid="RUT 4:21" /><verse number="22" style="v" sid="RUT 4:22" />ಒಬೆದನ ಇಶಯನನೆ ಪಡದ್ಯೊ, ಇಶಯನ ದಾವಿದನೆ ಪಡದ್ಯೊ.<verse eid="RUT 4:22" /></para>
  <chapter eid="RUT 4" />
</usx>