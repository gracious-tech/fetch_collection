<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Shikkligar</book>
  <para style="h">ಒಬದ್ಯ</para>
  <para style="toc1">ಒಬದ್ಯನು ಪುಸ್ತಕ</para>
  <para style="toc2">ಒಬದ್ಯ</para>
  <para style="toc3">ಒಬ</para>
  <para style="mt1">ಒಬದ್ಯನು ಪ್ರವಾದನನು ಪುಸ್ತಕ</para>
  <para style="mt2">ಓಬದ್ಯನು ಬರೆದ ಪ್ರವಾದನೆಯ ಪುಸ್ತಕ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಎ ಪುಸ್ತಕಮಾ ಒಬದ್ಯನು ಪ್ರವಾದನೆ ಛೆ. ಒಬದ್ಯನು ಸಂದೆಶ ಇಸಾವನಾ ಸಂತಾನೊ ಥಯಲ ಎದೊನನಾ ಮನಕ್ಹೊನಾ ವಿರುದ್ದ ಪೈಸಲೊ ಘೊಶಣೆ ಕರಸ. ಒಬದ್ಯನೊ ಪುಸ್ತಕ ಕೆಳಾಮಾ ಬರದ್ಯಾಸ ಕವಾನು ಪಂಡಿತೊ ನಿಖರಮಾ ಗ್ವತ್ತ ನತ್ತಿ. ಎ ಬಾಬೆಲೊನ ಯೆರುಸೆಲಿಮನೆ ಆಕ್ರಮ ಕರಲ ವಕ್ಹತ ಕದಲ ವಸೆ. ಕದ್ಯಾಮ ತೆ ವಕ್ಹತಮಾ ಎದೊಮವಾಲಾ ಎಸ್ರಾಯೆಲನೆ ಮದತ ಕರ‍್ಯಾ ನೈ. ಎ ಕ್ಹರಿ ರ‍್ಹಯುಮ, ಕ್ರಿ.ಪು ಛೆಕ್ಹೊನಾ ಸುತ್ತೆ ಮುತ್ತೆ ಬರ್ದಲ ವಸ. ಒಬದ್ಯ ಪೈಲಾ ಎದೊಮನಾ ವಿರುದ್ದ ಫೈಸಲೊ ಘೊಶಣೆ ಕರಸ, ತೆ ನೈಸೊ ಪಂದ್ರಾ ವಾ ವಚನಮಾ ಕ್ಹಾರಿ ದೆಶೊಪರ ಉಪ್ಪರ ಎ ಫಸಲೊ ತಿರ್ಪ ಕರಸ. ಲಾಸ್ಟಮಾ, ಒಬದ್ಯ ಯಕ್ಕಸಲಾ ಇಸ್ರಾಯಲನಾ ಬಂದಿ ಥಯಲ ವರಿ ಐನ ತ್ಯುನಿ ಜಿಮಿನನೆ ಪಡ್ದಿಲಿವಸ ಕೈನ ಕವಸ.</para>
  <para style="iot">ರುಪರೆಖಾ</para>
  <para style="io1">1.<char style="ior"><ref loc="OBA 1:1">1</ref> </char>ವಾತಿ 14 ವಾ ವಚನೊಮಾ ಎದೊಮನಾ ಉಪ್ಪರ ಫೈಸಲೊ ಕರಸ.</para>
  <para style="io1">2. <char style="ior"><ref loc="OBA 1:15">15</ref></char> ತಿ 21 ವಾ ವಚನಲಕ್ಕಾ ಕ್ಹಾರಿ ಜನಾಂಗೊನು ತ್ಯುನಾ ಸ್ವಕ್ಕನಾ ಹುತಿ ಪಯಸಲೊ ಪಡ್ದಿಲಿವಾನು ವರಿ ಇಸ್ರಾಯೆಲೊ ಬಂದಿತೊ ಪರಿನ ಐನ ತ್ಯುನಿ ಜಿಮಿನ ಸ್ವಾಧಿನ ಕರಿಲಿವಸ ತೆಕ್ಲುಜ಼ ನೈಸೊ ಎದೊಮ ಜನಾಂಗೊಪರ ರಾಜ಼ ಕರಾನೆ ಸುರು ಕರಸ ಕೈನ ಕವಸ.</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />ಒಬದ್ಯ ದೆಕಲ ದರ್ಶನ, ಎದೊಮ ದೆಶನಾ ಹುತಿ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ.</para>
  <para style="s" vid="OBA 1:1">ಯಹೊವಾ ಎದೊಮನೆ ಶಿಕ್ಷಾ ದಿವಾನು</para>
  <para style="q1" vid="OBA 1:1">ಯಹೊವಾನಾ ಮುಕಾಂತರ ಆಯಲ ಸುದ್ದಿ ಹಮೆ ಐಕ್ಯಾಸ.</para>
  <para style="q2" vid="OBA 1:1">ತೆ ದುತನಾ ಮುಲಕ ಮನಕ್ಹೊನೆ ಇಮ್ಮ ಕೈನ ಮೊಕಲ್ಯೊಸ.</para>
  <para style="q2" vid="OBA 1:1">"ಜಾವೊ, ಎದೊಮನಾ ಉಪ್ಪರ ಯುದ್ಧ ಕರಾನೆ ಗಯ್ಯೆ!"<verse eid="OBA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />"ಎದೊಮ ದೆಕ, ದೆಶೊಮಾ ತುನೆ</para>
  <para style="q2" vid="OBA 1:2">ಘನ್ನೊ ನ್ಹಾನೊ ಕರುಸ.</para>
  <para style="q2" vid="OBA 1:2">ತು ಠುಕ್ರೈಲಿವಾನೆ ಗುರಿ ಥಾಶಿ.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />ತಾರು ದುರಹಂಕಾರ ತುನೆಜ಼ ಮೊಸ ಕರ‍್ಯುಸ.’</para>
  <para style="q1" vid="OBA 1:3">ಮ್ಹೊಟಿ ಜ಼ಗಾಪರ ರ‍್ಹವಾಡ್ಯೊಸ;</para>
  <para style="q2" vid="OBA 1:3">ದಗ್ಡಾವೊನಾ ಬಿರುಕಮಾ ಅರಾಮಾ ಛೆ;</para>
  <para style="q1" vid="OBA 1:3">ಮನೆ ಜಿಮಿನ್ಪರ ಉತಾರಾಲು</para>
  <para style="q2" vid="OBA 1:3">ಕುನ್ನ ವ್ಹೈ?” ಕೈಲಿವಾಡ್ಯೊಸು,<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />"ತು ಹದ್ದನಾ ಯಕಲು ಉಪ್ಪರ ಉಡಾಡ್ಯೊತಬಿ</para>
  <para style="q2" vid="OBA 1:4">ಚಿಕ್ಕಿಯೊನಾ ಗುಂಪಮಾ ರ‍್ಹಯೊತಬಿ</para>
  <para style="q2" vid="OBA 1:4">ತ್ಯಾಂತೊಬಿ ತುನೆ ಉತಾರುಸ,”</para>
  <para style="q1" vid="OBA 1:4">ತೆ ವಾತೆ ಯಹೊವಾ ತಿನೆ ಕವಸ.<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />ತುಕನ ಚ್ವಟ್ಟಾ ರ‍್ಹವಾದೆ, ರಾತೆ</para>
  <para style="q2" vid="OBA 1:5">ಲುಟಿ ಕರಾಲಾ ರ‍್ಹವಾದೆ</para>
  <para style="q1" vid="OBA 1:5">ಆಯಾಮ ತ್ಯುನೆ ಚಾ಼ಯೆ</para>
  <para style="q2" vid="OBA 1:5">ಥಯಲ ತೆಕ್ಲು ಯಕ್ಕಜ಼</para>
  <para style="q1" vid="OBA 1:5">ಲಿನ ಜಾ಼ತಾತಾ ನೈ?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />ತೆನೈಸೊ ಎಸಾವನಿ ಕ್ಹಾರಿ ಆಸ್ತಿ ಪುರಾಜ಼ ಲುಟಿ ಥೈಸ.<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />ತಾರಾ ದೊಸ್ತೊನಿ ಗುಂಪವಾಲಾ</para>
  <para style="q2" vid="OBA 1:7">ತುನೆ ಪಿಟ್ಟ ಲಾಗ್ಯಾಸ.</para>
  <para style="q1" vid="OBA 1:7">ತುನೆ ತಡಿಪಾರಮಾ ಢಕ್ಲಿಪಾಡ್ಯಾಸ.</para>
  <para style="q2" vid="OBA 1:7">ತಾರಾ ಲಾಗ್ತಾ ಭೊಕ್ತಾ ತುನೆಜ಼ ಮೊಸೆ ಹರಾಡ್ಯಾಸ.</para>
  <para style="q2" vid="OBA 1:7">ತಾರು ಅನ್ನ ಖಾದಲವಾಲಾ ಫರಿನ ತುನೆ ಗ್ವತ್ತವಾಚಿ ಪಾಕ್ಹು ಘಾಲಾಡ್ಯಾಸ.<verse eid="OBA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />ಯಹೊವಾ ಅಮ್ಮ ಕವಸ.</para>
  <para style="q2" vid="OBA 1:8">"ತೆ ದಿನ್ನಮಾ ಎದೊಮನಾ ಗ್ಯಾನಿಯೊನೆ ಎಸಾವನಾ</para>
  <para style="q2" vid="OBA 1:8">ಡೊಂಗರ್ನಾ ಶಾಣ್ಯಾವೊನೆ ಮಿ ನಾಶ ಕರ‍್ಯಾವಾಚಿ ರ‍್ಹೌಸು?<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />ತೆಮಾನ ಗಾಮ ತಾರಾ ಶುರೊ ಘಾಬ್ರಾಥಾವಸ;</para>
  <para style="q2" vid="OBA 1:9">ಎಸಾವನಿ ಪ್ರಾಂತ್ಯಮಾ ಕ್ಹಾರಾ ಖಲಾಸ ಥಾವಸ.<verse eid="OBA 1:9" /></para>
  <para style="s">ಎದೊಮನು ಶಿಕ್ಷಾನೆ ಕಾರಣ</para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />"ತಾರೊ ಭೈ ರ‍್ಹಯಲ ಯಾಕೊಬನಾ</para>
  <para style="q2" vid="OBA 1:10">ವಿರುದ್ದ ಕರಲ ತ್ರಾಸನಾ ಕಾಮೊನಾ ಹುತಿ</para>
  <para style="q2" vid="OBA 1:10">ಹಮೆಶಾನಾ ನಾಶನೆ ಪಡಸಿ.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />ತಾರಾ ನ್ಹಾನಾ ಭೈನು ಆಸ್ತಿ ಚೊ಼ರಿಕರಲ ದಿನಮಾ</para>
  <para style="q2" vid="OBA 1:11">ತು ಗಪ್ಪಜ಼ ದೆಕ್ತೊ ಹುಬ್ರಯೊತೊ.</para>
  <para style="q1" vid="OBA 1:11">ಬಿಜಾ಼ ಮನಕ್ಹೊ ತಿನಾ ಗಾಮನಾ ಮ್ಹೈ ಗೈನ,</para>
  <para style="q2" vid="OBA 1:11">ಯೆರುಸೆಲಿಮನಾ ಆಸ್ತಿನಾ ಹುತಿ ಚಿಟಿ ಘಾಲಲ ದಿನತು</para>
  <para style="q2" vid="OBA 1:11">ತು ತ್ಯುನಾ ನಿಂಗತಜ಼ ವ್ಹತೊ.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />ತಾರಾ ನ್ಹಾನಾ ಭೈನು ಕೆಟ್ಟ ವಕ್ಹತಮಾ,</para>
  <para style="q2" vid="OBA 1:12">ತಿನಾ ತ್ರಾಸನಾ ದಿನೊಮಾ</para>
  <para style="q1" vid="OBA 1:12">ತು ಗಪ್ಪಜ಼ ದೆಕ್ತೊ ಹುಬ್ರವಾನು ನ್ಹೊತು.</para>
  <para style="q2" vid="OBA 1:12">ಯೆಹುದಿಯೊನಾ ವಿನಾಶಮಾ</para>
  <para style="q1" vid="OBA 1:12">ಖುಶಿಕ್ಹು ರ‍್ಹವಾನು ನ್ಹೊತು.</para>
  <para style="q2" vid="OBA 1:12">ತ್ಯುನಾ ತ್ರಾಸಮಾ ತು ಫುಗ್ಗಾನು ನ್ಹೊತು.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />ಮಾರಾ ಮನಕ್ಹೊನಾ ತ್ರಾಸೊಮಾ</para>
  <para style="q2" vid="OBA 1:13">ತು ತ್ಯುನಾ ಗಾಮನಾ</para>
  <para style="q2" vid="OBA 1:13">ಬಾಕಲೊಮಾ ಜಾ಼ವಾನು ನ್ಹೊತು.</para>
  <para style="q2" vid="OBA 1:13">ತ್ಯುನಿ ಆಸ್ತಿನೆ ಹತ್ತ ಘಾಲಾನು ಮ್ಹೊತು.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />ಚುಕೈಲಿನ ನ್ಹಾಟಿ ಜಾ಼ತಾ ರ‍್ಹಯಲವಾಲವೊನೆ</para>
  <para style="q2" vid="OBA 1:14">ಖಲಾಸ ಕರಾನಾಹುತಿ ತ್ಯುನೊನೆ ಮಳಾನಿ ಕತ್ರಿಮಾ ಹುಬ್ರಾವಾನು ನ್ಹೊತು.</para>
  <para style="q1" vid="OBA 1:14">ಚುಕೈಲಿವಾನಿ ತ್ರಾಸನಾ ಪರಿಸ್ಥಿತಿಮಾ</para>
  <para style="q2" vid="OBA 1:14">ಶತ್ರುನಾ ಹತಮಾ ವಪ್ಸಾನು ನ್ಹೊತು.<verse eid="OBA 1:14" /></para>
  <para style="s">ಕ್ಹುದಾ ದೆಶೊನೆ ಫೈಸಲೊ ಕರಾನು</para>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />"ಕ್ಹಾರಾ ದೆಶೊನೆ ಯಹೊವಾನೊ</para>
  <para style="q2" vid="OBA 1:15">ದಿನ್ನ ನಜಿಕ ಛೆ.</para>
  <para style="q1" vid="OBA 1:15">ತು ಕರಲಜ಼ ತುನೆಬಿ ಕರಾವಸ.</para>
  <para style="q2" vid="OBA 1:15">ತಾರಾ ಕೆಟ್ಟ ಕಾಮೊ</para>
  <para style="q2" vid="OBA 1:15">ತಾರಾ ಮಾತಾಪರ ಆವಸ.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />ಮನಕ್ಹೊ, ಪವಿತ್ರ ಡೊಂಗರನಾ</para>
  <para style="q2" vid="OBA 1:16">ಉಪ್ಪರ ಮಾರಿ ದಂಡನೆ ಕಹಿಪಾನ-ಕಹಿಪಾನ ಕರ‍್ಯಾ.</para>
  <para style="q1" vid="OBA 1:16">ಕ್ಹಾರಾ ದೆಶವಾಲಾ ಕಹಿಪಾನ ಕರಸ.</para>
  <para style="q2" vid="OBA 1:16">ಹೊ, ಹಗ್ಲೆಲ್ಲಾ ಪಿನ ಝೊಲಾಮಾರಸ.</para>
  <para style="q2" vid="OBA 1:16">ಅಂತ್ಯಮಾ ತೆ ನಾಶ ಥಾವಸ.<verse eid="OBA 1:16" /></para>
  <para style="s">ಇಸ್ರಾಯೆಲನಿ ಝಿತ</para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />"ತೆನೈಸೊ ಸಿಯೊನ ಡೊಂಗರನಾ ಉಪ್ಪರ ಘನಾಜ಼ನಾ ರ‍್ಹವಸ.</para>
  <para style="q2" vid="OBA 1:17">ತೆ ಡೊಂಗರ ಪವಿತ್ರ ಜ಼ಗಾ ಕೈನ ಕವೈಲಿವಸ.</para>
  <para style="q1" vid="OBA 1:17">ಯಾಕೊಬನಾ ಸಂತತಿವಾಲಾ</para>
  <para style="q2" vid="OBA 1:17">ತ್ಯುನಿ ಸ್ವಂತ ಆಸ್ತಿ ಫರಿನ ಅನುಭವಿಸಸ.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />ಯಾಕೊಬನಾ ವಂಶ ಆಗನಿಂಗತ ವರಿ</para>
  <para style="q2" vid="OBA 1:18">ಯೊಸೆಫನಾ ವಂಶವಾಲಾ ಜ್ವಾಲಾನಿಂಗತ.</para>
  <para style="q2" vid="OBA 1:18">ಇವ್ನೆ ಭಂಬಿಜ಼ನಾ ಮಳಿನ ಕೊಂಡೊ ರ‍್ಹಯಲ ಎಸಾವನಾ ವಂಶವಾಲಾವೊನೆ ಧಗ ಧಗ ಆಗಮಾ ಬಾಳಿನ ರಾಕ ಕರಸ.</para>
  <para style="q2" vid="OBA 1:18">ಎಸಾವನಾ ವಂಶಮಾ ಕುನ್ನಜ಼ ಉಗರ್ತು ನೈ. ಎ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="OBA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />ತೆಳಾಮಾ ನೆಗವವಾಲಾ ರ‍್ಹಯಲವಾಲಾ ಎಸಾವನಾ ಡೊಂಗರನೆ ತಾಬಾಮಾ ಕರಿಲಿವಸ.</para>
  <para style="q2" vid="OBA 1:19">ಶೆಫೆಲ್ಹಾ ತ್ಯಾ ಸಿಮೆವಾಲಾ ಫಿಲಿಷ್ಟಿನೆ ಎಫ್ರಾಯಿಮನಿ ಜಿಮಿನನೆ</para>
  <para style="q1" vid="OBA 1:19">ಸಮಾರ್ಯಾನಿ ಜಿಮಿನನೆ ತಾಬಾಮಾ ಕರಿಲಿವಸ.</para>
  <para style="q2" vid="OBA 1:19">ಬೆನ್ಯಾಮಿನವಾಲಾ ಗಿಲ್ಯಾದನೆ ತಾಬಾಮಾ ಕರಿಲಿವಸ.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />ತಾಬಾಮಾ ಥೈನ ಗಯಲ ಇಸ್ರಾಯೆಲನಾ ಸೈನಿಕೊ</para>
  <para style="q2" vid="OBA 1:20">ಕಾನಾನ ದೆಶ ಚಾರೆಪತಲಕ್ಕಾ ತ್ಯುನು ಕರಿಲಿಸ.</para>
  <para style="q1" vid="OBA 1:20">ಶೆಫಾರಮಾ ಆಳೊನು ಗುಂಪ ಯೆರುಸೆಲಿಮವಾಲಾ ನೆಗೆವ</para>
  <para style="q2" vid="OBA 1:20">ಪ್ರಾಂತ್ಯಮಾ ರ‍್ಹಯಲ ಗಾಮೊನೆ ತಾಬಾಮಾ ಕರಿಲಿವಸ.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />ಛೊಡಾವಾಲಾ ಎಸಾವನೊ ಡೊಂಗರ ಆಳಾನಾಹುತಿ</para>
  <para style="q2" vid="OBA 1:21">ಸಿಯ್ಯೊನ ಡೊಂಗರ ಚ಼ಡಸ.</para>
  <para style="q1" vid="OBA 1:21">ತೆಳಾಮಾ ರಾಜ್ಯ ಯಹೊವಾನು ಥೈನ ರ‍್ಹವಸ.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>