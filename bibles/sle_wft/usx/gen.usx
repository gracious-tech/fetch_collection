<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Shikkalgar</book>
  <para style="h">ಆದಿಕಾಂಡ</para>
  <para style="toc3">ಆದಿಕಾಂಡ</para>
  <para style="toc2">ಆದಿ</para>
  <para style="toc1">ಆದಿಕಾಂಡ ಬುಕ್ಕ</para>
  <para style="mt2">ಆದಿಕಾಂಡ</para>
  <para style="mt1">ಆದಿಕಾಂಡ</para>
  <para style="is">ವಳಕ</para>
  <para style="ip">ಆದಿ ಕದ್ಯಾಮ ಪೈಲಾ ನೈತೊ ಮುಲ. ಎ ದುನಿಯಾನು ವರಿ ಎ ಮನಕ್ಹೊನು ಕಯು ವ್ಹೈ? ತೆ ಪೈಲಾ ಥಯಲ ಕಿಮ್ಮ ವ್ಹೈ? ಎ ದುನಿಯಾಮಾ ಅಪೆ ಅನುಭವಿಸಾನು ತ್ರಾಸ ಮರಣೊ, ದುಕ್ಕೊ ಕಿಮ್ಮ ಮಾತು ಉಚಯಾ? ಎ ಕ್ಹಾರು ಪುಸ್ತೊಕೊಮಾ ರ‍್ಹಯಲ ವಿಶಯ ವ್ಹೈ.</para>
  <para style="ip">ಎ ದುನಿಯಾ ವರಿ ಇಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಮುಲ ಕಾರಣ ರ‍್ಹಯಲವಾಲೊ ಕ್ಹುದಾಜ಼ ವ್ಹೈ. ತಿನೆ ಕ್ಹಹುದಾನೆ ಆದಿತಾ ರ‍್ಹಯಲ ಸಂಭಂದ ಮನಕ್ಹ ಕರಾನಾ ಪಾಪೊಕ್ಹು ಛುಟಿಗಯು. ವರಿಬಿ ಕ್ಹುದಾನಿ ಮರಗಾ ತೆಕ್ಲಾಪರಜ಼ ಹುಬರಯು ನೈ.</para>
  <para style="iot">ಪರಿವಿಡಿ</para>
  <para style="io1">ಹಬಾಳ ಜಿಮಿನ ವರಿ ಮನಕ್ಹನಿ ಸೃಷ್ಟಿ <char style="ior"><ref loc="GEN 1:1-2:25">1:1—2:25</ref></char></para>
  <para style="io1">ಪಾಪ ವರಿ ಪಶ್ಚಾತಾಪನು ಶುರು <char style="ior"><ref loc="GEN 3:1-24">3:1-24</ref></char></para>
  <para style="io1">ಆದಾಮತಾ ನೊಹಾಲಕ್ಕಾ <char style="ior"><ref loc="GEN 4:1-5:32">4:1—5:32</ref></char></para>
  <para style="io1">ನೊಹಾ ವರಿ ಪ್ರಳಯ <char style="ior"><ref loc="GEN 6:1-10:32">6:1—10:32</ref></char></para>
  <para style="io1">ಬಾಬೆಲ ಗೊಪುರ <char style="ior"><ref loc="GEN 11:1-9">11:1-9</ref></char></para>
  <para style="io1">ಶೆಮತಿ ಅಬ್ರಹಾಮಲಕ್ಕಾ<char style="ior"><ref loc="GEN 11:10-32">11:10-32</ref></char></para>
  <para style="io1">ಮಹರಾಷ ಅಬ್ರಹಾಮ, ಇಸಾಕ ವರಿ ಯಾಕೊಬ <char style="ior"><ref loc="GEN 12:1-35:28">12:1—35:28</ref></char></para>
  <para style="io1">ಎಸಾವನಿ ಸಂತತಿ<char style="ior"><ref loc="GEN 36:1-42">36:1-42</ref></char></para>
  <para style="io1">ಜೊಶಫ ವರಿ ಎಸಾವನಿ ಸಂತತಿ <char style="ior"><ref loc="GEN 37:1-45:28">37:1—45:28</ref></char></para>
  <para style="io1">ಇಜಿಪ್ಟಿನಮಾ ಇಸ್ರಾಯಲೊ <char style="ior"><ref loc="GEN 46:1-50:26">46:1—50:26</ref></char></para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />ಶುರುವಾತಮಾ ಕ್ಹುದಾ ಹಬಾಳ ವರಿ ಜಿಮಿನ ತಯ್ಯಾರ ಕರ‍್ಯೊ. <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />ತೆಳಾಮಾ ಜಿಮಿನಪರ ಪದ್ದತ ಪ್ರಕಾರ ಸುಜ಼ ನ್ಹೊತು, ಕ್ಹಾರಿ ಬಗಲ ಅಂದಾರು ವ್ಹತ್ತು ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಪಾನಿಪರ ಪ್ಹರಾಡಿತಿ. <verse eid="GEN 1:2" /><verse number="3" style="v" sid="GEN 1:3" />ತೆಳಾಮಾ ಕ್ಹುದಾ, ಉಜಾಲು ಥಾವಾದೆ ಕೈನ ಕತಾಮಾ ಉಜಾಲು ಥಯು. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />ಕ್ಹುದಾನಾ ಡೊಳೆ ತೆ ಉಜಾಲು ಚೊ಼ಕು ದಿಕ್ಹ್ಯು. ತೆಳಾಮಾ ತೆ ಉಜಾಲಾನೆ ವರಿ ಅಂದಾರನೆ ಜು಼ದು ಜು಼ದು ಕರ‍್ಯೊ. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />ವರಿ ತೆ ಉಜಾಲಾನೆ ದಿನ್ನ ಕೈನ ಅಂದಾರಾನೆ ರಾತ” ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. ಇಮ್ಮ ಕ್ಹಾಂಜ಼ ಥೈನ ಪಾಟ ಥೈನ ಎಜ಼ ಪಸ್ಟ ದಿನ್ನ ಥಯು. <verse eid="GEN 1:5" /><verse number="6" style="v" sid="GEN 1:6" />ಪಾಚಲ್ತೊ ಕ್ಹುದಾ ಪಾನಿನಾ ವಚ್ಮಾ ಮ್ಹೊಟು ಗುಮ್ಮಟ (ಡೊಂಗರ) ಥಾವಾದೆ ತೆ ಹೆಟು ರ‍್ಹಯಲ ವರಿ ಉಪ್ಪರ ರ‍್ಹಯಲ ಪಾನಿನೆ ಬಿಜು಼ ಬಿಜ಼ು ಕರಾದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />ಕ್ಹುದಾ ಮ್ಹೊಟು ಗುಮ್ಮಟ ಕರಿನ ತಿನಾ ಹೆಟು ರ‍್ಹಯಲ ಪಾನಿನೆ ವರಿ ಉಪ್ಪರ ರ‍್ಹಯಲ ಪಾನಿಕ್ಹು ಜು಼ದು-ಜು಼ದು ಕರ‍್ಯೊ. ತೆ ತಿಮ್ಮಜ಼ ಥಯು. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />ಕ್ಹುದಾ ತೆ ಮ್ಹೊಟು ಗುಮ್ಮಟ ಹಬಾಳ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. ಅಮ್ಮಜ಼ ಕ್ಹಾಂಜ಼ ಥೈನ ಪಾಟ ಥೈನ ಬೆವಾ ದಿನ್ನ ವ್ಹೈ. <verse eid="GEN 1:8" /><verse number="9" style="v" sid="GEN 1:9" />ತೆಳಾಮಾ ಕ್ಹುದಾ, ಹಬಾಳನಾ ಹೆಟು ರ‍್ಹಯಲ ಪಾನಿನೆ ಯಕ್ಕ ಜ಼ಗಾ ಮಳಾದೆ ವರಿ ಕ್ಹುಕ್ಹಿ ಜ಼ಗಾ ದಿಕ್ಹಾದೆ ಕೈನ ಕದ್ಯೊ; ತೆ ತಿಮ್ಮಜ಼ ಥಯು. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />ಕ್ಹುದಾ ಕ್ಹುಕ್ಹಿ ಜ಼ಗಾನೆ ಜಿ಼ಮಿನ” ಕೈನ ಯಕ್ಕ ಜ಼ಗಾ ಮಳಲ ಪಾನಿನೆ ಸಮುಂದರ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. ತೆ ತಿನೆ ಚೊ಼ಕು ವ್ಹೈ ಕೈನಜ಼ ದೆಕ್ಯೊ. <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />ತೆ ಥಯಲ್ಪರ ಕ್ಹುದಾ, ಜಿ಼ಮಿನ ಚ಼ಾರೊ, ನ್ಹಾನಾ ಝಾಡೊ, ಬಿಯ್ಯಾ ಛೊಡಾನಾ ತರಕಾರಿನಾ ಝಾಡೊ ವರಿ ಬಿಯ್ಯಾ ರ‍್ಹಯಲ ಫಲ್ಲನಾ ಝಾಡೊ ತ್ಯುನಾ ತ್ಯುನಾ ಜ಼ಾತನಾ ಅನುಸಾರ ಬೆಳಸಾದೆ” ಕೈನ ಕದ್ಯೊ. ತೆ ತಿಮಜ಼ ಥೈಯು. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />ಜಿಮಿನ ಪರ ಚ಼ಾರೊ ವರಿ ನ್ಹಾನಾ ಝಾಡೊ ಹುಟ್ಯಾ ಕ್ಹಾರಾ ತರಾನಾ ಬಿಯ್ಯಾ ರ‍್ಹಯಲ ತರಕಾರಿನಾ ಝಾಡೊ ಬೆಳದ್ಯಾ; ವರಿ ಕ್ಹಾರಾ ತರಾನಾ ಬಿಯ್ಯಾ ರ‍್ಹಯಲ ಫಲೊನಾ ಝಾಡೊ ದಿಕ್ಹ್ಯಾ. ಕ್ಹುದಾ ತೆ ಚೊ಼ಕು ವ್ಹೈ ಕೈನ ದೆಕ್ಯೊ. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />ಅಮ್ಮಜ಼ ಕ್ಹಾಂಜ಼ ಥೈನ ಪಾಟ ಥೈ ತೆ ತನವಾ ದಿನ್ನ ಥಯು.<verse eid="GEN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />ತೆಳಾಮಾ ಕ್ಹುದಾ, ಹಬಾಳಮಾ ಉಜಾಲು ಥಾವಾದೆ ಕೈನ ಕದ್ಯೊ; ತೆ ದಿನ್ನ ರಾತನೆ ಜು಼ದು ಜು಼ದು ಕರಾದೆ; ತೆನೈಸೊ ತೆ ದಿನ್ನೊನೆ ವರಿ ವರಕ್ಹನೆ, ಕಾಲನೆ ವಳಕ ಥೈನ ದೆಕಾಡಾದೆ; <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />ವರಿ ಜಿಮಿನ ಪರ ಉಜಾಲು ದಿವಾನಾಹುತಿ ತೆ ಹಬಾಳಮಾ ದಿವ್ವಾ ನಿಂಗತ ದಿಕ್ಹಾದೆ ಕೈನ ಕದ್ಯೊ, ತೆ ತಿಮ್ಮಜ಼ ಥೈಯು. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />ಇಮ್ಮ ಕ್ಹುದಾ ಸುರ್ಯೊ ವರಿ ಚಂದಪ್ಪಾನೆ ಸೃಷ್ಟಿ ಕರ‍್ಯೊ. ಸುರ್ಯಾನೆ ದಿನ್ನ ಆಳಾನಾಹುತಿ ವರಿ ಚಂದಪ್ಪಾನೆ ರಾತ ಆಳಾನಾಹುತಿ ವರಿ ಚಿಕ್ಕಿಯೊನೆಬಿ ಸೃಷ್ಟಿ ಕರ‍್ಯೊ. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />ತೆ ಜಿಮಿನಪರ ಉಜಾಲು ದಿವಾನಾಹುತಿ ಹಬಾಳಮಾ ಮ್ಹೆಲಿನ, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />ದಿನ್ನ ರಾತ ಆಳಾನಾ ಹುತಿ ಉಜಾಲಾನೆ ವರಿ ಅಂದಾರಾನೆ ಜು಼ದು ಜು಼ದು ಕರಾನಾ ಹುತಿ ತಿನೆ ಕರ‍್ಯೊ. ತೆ ತಿನೆ ಚೊ಼ಕುಜ಼ ವ್ಹೈ ಕೈನ ದೆಕ್ಯೊ.<verse eid="GEN 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 1:19" />ಅಮ್ಮ ಕ್ಹಾಂಜ಼ ಥೈನ ಪಾಟ ಥೈನ‍ ಚಾರವಾ ದಿನ್ನ ಥಯೊ. <verse eid="GEN 1:19" /><verse number="20" style="v" sid="GEN 1:20" />ತೆಳಾಮಾ ಕ್ಹುದಾ ಕ್ಹಾರಾ ತರಾನಾ ಜಿವಜಂತೊ ಪಾನಿಮಾ ಭರಾದೆ; ಪಕ್ಷಿಯೊ ಹಬಾಳಮಾ ಭರಾದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />ಅಮ್ಮ ಕ್ಹುದಾ ಖಾಸ ಪ್ರಾಣಿಯೊನೆ ಪಾನಿಮಾ ಭರೆಲ ತರಾ ತರಾನಾ ಜಿವಿಯೊ ರಕ್ಯಾ ರ‍್ಹಯಲ ತರಾ ತರಾನಾ ಪಕ್ಷಿಯೊ, ತ್ಯುನಾ ಜಾತನಾ ಅನುಸಾರ ಸೃಷ್ಟಿ ಕರ‍್ಯೊ. ತೆ ತಿನೆ ಚೊಕುಜ಼ ವ್ಹೈ ಕೈನ ದೆಕ್ಯೊ. <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />ತೆನೈಸೊ ಕ್ಹುದಾ, ತ್ಯುನೊನೆ ತುಮೆ ಘನ್ನಾ ಥೈನ ಜಾಸ್ತ ಥಾವೊ. ಪಾನಿಮಾನಾ ಪ್ರಾಣಿಯೊನಿ ಸಂತತಿ ಜಾಸ್ತ ಥೈನ ಸಮುಂದರ ಭರಾದೆ; ಪಕ್ಷಿಯೊನೆ ತುಮಾರಿ ಸಂಕ್ಯಾ ಜಾಸ್ತ ಥಾವಾದೆ ಕೈನ ಆಶಿರ್ವಾದ ಕರ‍್ಯೊ. <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />ಅಮ್ಮ ಕ್ಹಾಂಜ಼ ಥೈನ ಪಾಟ ಥೈ ಎಜ಼ ಪಾಂಚ಼ವಾ ದಿನ ಥಯು.<verse eid="GEN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />ವರಿ ಕ್ಹುದಾ, ಜಿಮಿನಮಾತಾ ಕ್ಹಾರಿ ತರಾನಾ ಜಿವ ಜಂತು ಹುಟ್ಟಾದೆ; ನ್ಹಾನಾ ಮ್ಹೊಟಾ ರಾಕಾನಾ ಜಾನವರೊ, ಜಂಗ್ಲಿ ಜಾನವರೊ ಹುಟ್ಟಾದೆ ಕದ್ಯೊ”. ತೆ ತಿಮ್ಮಜ಼ ಥಯು. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />ಕ್ಹುದಾ ಎ ಕ್ಹಾರಿ ತರಾನಾ ಜಾನವರೊನೆ ಸೃಷ್ಟಿ ಕರ‍್ಯೊ. ತೆ ತಿನೆ ಚೊಕುಜ಼ ವ್ಹೈ ಕೈನ ದೆಕ್ಯೊ. <verse eid="GEN 1:25" /><verse number="26" style="v" sid="GEN 1:26" />ತೆಳಾಮಾ ಕ್ಹುದಾ, ಅಪ್ನಾ ಸ್ವರುಪಮಾ ತ್ಯುನಾ ಹೊಲಿಕೆ ಥಯಲ ಮನಕ್ಹೊನೆ ಕರಿಯೆ ಕೈಲಿನ. ತ್ಯುನೆ ಸಮುಂದರಮ್ಮಾ ರ‍್ಹಯಲ ಮಚ಼ಲಿಯೊಪರ ಹಬಾಳಮ್ಮಾ ಉಡಾನಾ ಪಕ್ಷಿಯೊಪರ ಜಾನವರೊಪರ ಜಿಮಿನಪರ ಚ಼ಾಲಾನಾ ಜಿವಜ಼ಂತುಪರ ಕ್ಹಾರಾ ಜಿಮಿನಪರ ಅದಿಕಾರ ಕರಾದೆ”.<verse eid="GEN 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27" />ಅಮ್ಮ ಕ್ಹುದಾ ಮನಕ್ಹನೆ ತಿನಾ ಸ್ವರುಪಮಾ ಸೃಷ್ಟಿ ಕರ‍್ಯೊ; ವರಿ ತಿನಾ ಸ್ವರುಪಮಾ ತ್ಯುನೊನೆ ದಾಣಗೊ ಬಾಕಡಿ ಕೈನ ಸೃಷ್ಟಿ ಕರ‍್ಯೊ.<verse eid="GEN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 1:28" />ತೆನೈಸೊ ಕ್ಹುದಾ ತ್ಯುನೊನೆ ಆರ್ಶಿವಾದ ದಿನ, ತಮೆ ಘನ್ನಾ ಸಂತಾನ ಥೈನ ಬೆಳದೊ; ಜಿಮಿನಪರ ಭರಿನ ತಿನೆ ಅದಿಕಾರಮಾ ಲಿವೊ; ಸಮುಂದರನಾ ಮಚ಼ಲಿಯೊಪರ ಹಬಾಳನಾ ಪಕ್ಷಿಯೊಪರ ಜಿಮಿನಪರ ಚ಼ಾಲಾನಾ ಕ್ಹಾರಾ ಜಾನವರೊಪರ ಅದಿಕಾರ ಕರಾದೆ ಕದ್ಯೊ. <verse eid="GEN 1:28" /><verse number="29" style="v" sid="GEN 1:29" />ವರಿ ಕ್ಹುದಾ, ಹಮ್ನಾ ಕ್ಹಾರಾ ತರಾನಾ ತರಕಾರಿನಾ ಝಾಡೊ ಫಲ ದಿವಾನಾ ಬಿಯ್ಯಾನಾ ಝಾಡೊ ತುಮೊನೆ ಕ್ಹಾವಾನಾ ಹುತಿ ದಿದ್ಯೊಸ. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />ತೆನೈಸೊ ಜಿಮಿನಪರ ಚ಼ಾಲಾನಾ ಜಾನವರೊ ಹಬಾಳಮ್ಮಾ ಉಡಾನಾ ಪಕ್ಷಿಯೊ ಜಿಮಿನಪರ ಚ಼ಾಲಾನಾ ಜಿವಜಂತು ಕವಾನಾ ಜಾನವರೊನೆ ಕ್ಹಾರಾ ಚ಼ಾರೊ ಭಾಜಿ ಪಾಲೊ ಖಾವಾನಾಹುತಿ ದಿದ್ಯೊಸ” ಕೈನ ಕದ್ಯೊ. ತೆ ತಿಮ್ಮಜ಼ ಥೈಯು. <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />ಕ್ಹುದಾ ತೆ ಸೃಷ್ಟಿ ಕರಲ ಕ್ಹಾರು ದೆಕಲಕ್ಹು ತೆ ಘನ್ನು ಚ಼ೊಕು ದಿಕ್ಹ್ಯು. ಕ್ಹಾಂಜ಼ ಥೈನ ಪಾಟ ಥೈ ಛೆವಾ ದಿನ ಥಯೊ.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />ಅಮ್ಮ ಜಿಮಿನ ಹಬಾಳ ತಿಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರು ಸೃಷ್ಟಿ ಥಯು. <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" />ಕ್ಹುದಾ ತಿನು ಸೃಷ್ಟಿನು ಕಾಮ ಕ್ಹರೈಲಿನ ಕ್ಹಾತ್ವಾ ದಿನ್ಮಾ ಅರಾಮ ಕರ‍್ಯೊ. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />ಕ್ಹುದಾ ತಿನು ಸೃಷ್ಟಿನು ಕಾಮ ಕ್ಹರೈನ ತೆ ಕ್ಹಾತ್ವಾ ದಿನ್ನೆ ಅರಾಮ ಕರಲಕ್ಹು ತೆ ದಿನ್ನನೆ ಪರಿಶುದ್ದ ದಿನ್ನ ಥಾವಾದೆ ಕೈನ ಆರ್ಶಿವಾದ ಕರ‍್ಯೊ. <verse eid="GEN 2:3" /><verse number="4" style="v" sid="GEN 2:4" />ಎಜ಼ ಜಿಮಿನ ಹಬಾಳ ಕರಲ ಚರಿತ್ರೆ ವ್ಹೈ, ಯಹೊವಾ ಕ್ಹುದಾ ಜಿಮಿನ ಹಬಾಳ ಕರಲಪರ,<verse eid="GEN 2:4" /></para>
  <para style="s">ಎದೆನನೊ ಮಳೊ</para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 2:5" />ತೆಳಾಮಾ ಜಿಮಿನ್ಪರ ಕಯಾಜ಼ ಝಾಡೊ ಜಿಮಿನಪರ ನ್ಹೊತಾ, ಕಯಾಜ಼ ತರಾನಾ ಝಾಡೊ ನ್ಹೊತಾ. ಕಾಕದ್ಯಾಮ ಯಹೊವಾ ಕ್ಹುದಾ ಜಿಮಿನಪರ ಪಾನಿ ಲಾಯೊ ನ್ಹೊತೊ; ಜಿಮಿನನು ಕಾಮ ಕರಾನಾಹುತಿ ಮನಕ್ಹ ನ್ಹೊತೊ. <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />ತೆನೈಸೊ ಜಿಮಿನಮಾತಿ ಶಲಿ ಐನ ಕ್ಹಾರಿ ಜಿಮಿನ ಪರ ಭಿಂಜಾ಼ವಾಡಿತಿ. <verse eid="GEN 2:6" /><verse number="7" style="v" sid="GEN 2:7" />ತೆನೈಸೊ ಯಹೊವಾ ಕ್ಹುದಾ ಜಿಮಿನ್ನಿ ಮಾತಿ ಲಿನ ಮನಕ್ಹನೆ ಸೃಷ್ಟಿ ಕರಿನ ತಿನಾ ನಾಕಮ್ಮಾ ಜ಼ಲಮನೊ ವಾರೊ ಫುಕ್ಯೊ; ತೆಳಾಮಾ ಜಿವ್ತೊ ಮನಕ್ಹ ಥಯೊ. <verse eid="GEN 2:7" /><verse number="8" style="v" sid="GEN 2:8" />ತೆನೈಸೊ ಯಹೊವಾ ಕ್ಹುದಾ ಪುರ್ವ ದಿಕ್ಮಾ ರ‍್ಹಯಲ ಎದೆನ ಸಿಮೆಮಾ ಯಕ್ಕ ಮಳೊ ಕರಿನ ತೆ ಕರಲ ಮನಕ್ಹನೆ ತ್ಯಾ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />ವರಿ ಯಹೊವಾ ಕ್ಹುದಾ ದೆಕಾನೆ ಚ಼ೊಕು ವರಿ ಖಾವಾನೆ ಸ್ವಾದ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ತರಾನಾ ಝಾಡೊ ತೆ ಜಿಮಿನ್ಮಾ ಹುಟ್ಟಾನಾನಿಂಗತ ಕರ‍್ಯೊ. ತೆನೈಸೊ ತೆ ಮಳಾನಾ ವಚ್ಮಾ಼ ಜ಼ಲಮ ದಿವಾನು ಝಾಡ ವರಿ ಚ಼ೊಕು ಕೆಟ್ಟ ಅರು ಹುಟ್ಸಾನು ಜ಼ಾಡ ಬೆಳಸಾಯೊ. <verse eid="GEN 2:9" /><verse number="10" style="v" sid="GEN 2:10" />ಎದೆನ ಮಳಾಮಾ ಯಕ್ಕ ನದಿ ಹುಟ್ಟಿನ ತೆ ಮಳಾನೆ ಭಿಂಜ಼ಾಯೆ ನಿಂಗತ ಕರ‍್ಯೊ. ತೆ ತ್ಯಾ ಲಾಸ್ಟಮಾ ಫುಟಿನ ಚಾರ ಭಾಗ ಥಯುತು. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />ಯಕ್ವಾ ನದಿನು ನಾಮ ಪಿಶೊನ ವ್ಹೈ; ತೆ ಕ್ಹೊನು ಮಳಾನು ಹವಿಲ ದೆಶನೆ ಕ್ಹಾರು ಸುತ್ತತುತು. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />ತೆ ದೆಶನು ಕ್ಹೊನು ಘನು ಖಾಸ ವ್ಹೈ ತ್ಯಾ ಬದಲೊಖನ ಧುಪ ಗೊಮೆದಿಕ ರತ್ನ ಮಳಸ. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />ಬೆವಾ ನದಿನು ನಾಮ ಗಿಹೊನ; ತೆ ಕುಷ ದೆಶನೆ ಸುತ್ತಸ. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />ತನವಾ ನದಿನು ನಾಮ ಟೈಗ್ರಿಸ ವ್ಹೈ; ತೆ ಅಶ್ಯುರ ದೆಶನಾ ಪುರ್ವ ದಿಕ್ಕೆ ವೈನ ಜ಼ಾತುತು. ಚಾರವಾನು ಯುಫ್ರೆಟಿಸ ನದಿ ವ್ಹೈ. <verse eid="GEN 2:14" /><verse number="15" style="v" sid="GEN 2:15" />ಯಹೊವಾ ಕ್ಹುದಾ ತೆ ಮನಕ್ಹನೆ ಬಲೈಲಿನ ಎದೆನ ಮಳಾನು ಕಾಮ ಕರಾನಾಹುತಿ ಕೈದಾನಾಹುತಿ ತ್ಯಾ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />ತೆನೈಸೊ ಯಹೊವಾ ಕ್ಹುದಾ ತೆ ಮನಕ್ಹನೆ ತು ಮಳಾಮಾ ರ‍್ಹಯೆಲ ಕ್ಹಾರಾ ಝಾಡೊನಾ ಫಲ ಲೆಕ್ಕೊ ವಾಚಿ ಕ್ಹಾ ಸಕಶಿ; <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />ತೆನೈಸೊ ಚೊಕು ವರಿ ಕೆಟ್ಟ ಅರು ಹುಟ್ಸಾನು ಝಾಡನು ಫಲ ಕ್ಹೌ ನೈ ಕೈನ ಕದ್ಯೊ; ಕ್ಹಾದಲ ದಿನ್ನೆ ಮರಿ ಜ಼ಾಶಿ ಕದ್ಯೊ. <verse eid="GEN 2:17" /><verse number="18" style="v" sid="GEN 2:18" />ವರಿ ಯಹೊವಾ ಕ್ಹುದಾ ಮನಕ್ಹ ಯಕ್ಲೊ ರ‍್ಹವಾನು ಚೊಕು ನ್ಹೈವೈ; ತಿನೆ ವ್ಹಂದಾಣಿಕೆ ಥವಾನು ಸೃಷ್ಟಿ ಕರುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 2:18" /><verse number="19" style="v" sid="GEN 2:19" />ತೆಳಾಮಾ ತೆ ಕ್ಹಾರಾ ಜಾನ್ವರೊ ಹಬಾಳನಾ ಪಕ್ಷಿಯೊನೆ ಮಾತಿಕ್ಹು ಕರಲ ತೆ ಕ್ಹಾರಾವೊನೆ ತೆ ಮನಕ್ಹ ಸು ಸು ನಾಮ ಮ್ಹೆಲಸ ಕೈನ ತಿನಾ ಕ್ಹಾಮೊ ಲೈನ ಹುಬ್ರಾಡ್ಯೊ ಮನಕ್ಹ ಯಕ್ಕ ಯಕ್ಕ ಜಾನ್ವರನೆ ಸು ಸು ನಾಮ ಮ್ಹೆಲ್ಯೊ ತೆಜ಼ ನಾಮ ಥಯು. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />ಅಮ್ಮ ತೆ ಮನಕ್ಹ ಕ್ಹಾರಾ ಪಶುವೊನೆ, ಹಬಾಳನಾ ಪಕ್ಷಿಯೊನೆ, ಜಂಗಲನಾ ಜಾನ್ವರೊನೆ ನಾಮ ಮ್ಹೆಲ್ಯೊ. ತೆನೈಸೊ ತೆ ಮನಕ್ಹನೆ ಕರೆಕ್ಟ ವ್ಹಂದಾನಿ ಸಾತಿದಾರ ಮಳ್ಯು ನೈ. <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಯಹೊವಾ ಕ್ಹುದಾ ತೆ ಮನಕ್ಹನೆ ಘನ್ನಿ ನಿಂದರ ದಿನ ತಿನಾ ಪಾಕ್ಹಳಿನು ಹಡ್ಕು ಲಿನ ತೆ ಜ಼ಗಾನೆ ಮಾಕ್ಹಕ್ಹು ಝಾಕ್ಯೊ. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />ತೆ ಮನಕ್ಹಕ್ಹು ಲಿದಲ ಹಡ್ಕಾಕ್ಹು ಬಾಕಡಿನೆ ಕರಿನ ತಿನಾ ಕ್ಹಾಮೊ ಲಾಯೊ. <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" />ತೆ ತಿನೆ ದೆಕಿನ ಹಮ್ನಾ ಕರೆಟ್ಟ ಶೆಂ; ತೆ ಮಾರಾ ಹಡ್ಕಾಮಾತು ಆಯೆಲ ಹಡ್ಕು ವ್ಹೈ ಮಾರಾ ಮಾಕ್ಹ ಮಾತು ಆಯೆಲ ಮಾಕ್ಹ ಥೈಸ ತೆ ಮನಕ್ಹಕ್ಹು ಆಯಲಹುತಿ ಬಾಕಡಿ ಕವೈಲಿವಸ ಕದ್ಯೊ. <verse eid="GEN 2:23" /><verse number="24" style="v" sid="GEN 2:24" />ತೆ ಕಾರಣ ಹುತಿ ಮನಕ್ಹ ತಿನಾ ಮಾ ಬಾಪನೆ ಛೊಡಿನ ತಿನಿ ಬೈಕೊನೆ ಮಳೈಲಿವಸ; ತ್ಯುನೆ ಭಂಬಿ ಜ಼ನಾ ಯಕ್ಕಜ಼ ಅಂಗ ಥಾವಸ. <verse eid="GEN 2:24" /><verse number="25" style="v" sid="GEN 2:25" />ತೆ ಮನಕ್ಹ ವರಿ ತಿನಿ ಬೈಕೊ ಭೊಂಗಳಾ ರ‍್ಹಯಾತಬಿ ಸರಮ್ಯಾ ನೈ.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">ಮನಕ್ಹ ವಾತನೆ ದಾಟಿನ ಗಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ತಯ್ಯಾರ ಕರಲ ಕ್ಹಾರಾ ಪ್ರಾಣಿಯೊಮಾ ಕ್ಹಾಪ ಘನ್ನು ಹುಶಾರ ವ್ಹತ್ತು. ಕ್ಹಾಪ ಬಾಕ್ಡಿ ಕನ ಐನ ತಿನೆ, ಯಾ, ಎ ಮಳಾಮಾ ರ‍್ಹಯಲ ಕಯಾ ಝಾಡನು ಫಲ ತುಮೆ ಖೌ ನೈ ಕೈನ ಕ್ಹುದಾ ತುಮೊನೆ ಅಪ್ಪಣೆ ಕರಲ ಕ್ಹರಿಜ಼಼ ವ್ಹೈ ಸು?” ಕೈನ ಪುಚ್ತಾ಼ಮಾ. <verse eid="GEN 3:1" /><verse number="2" style="v" sid="GEN 3:2" />ತೆ ಬಾಕ್ಡಿ ಕ್ಹಾಪನೆ, ಮಳಾಮಾ ರ‍್ಹಯಲ ಝಾಡಮಾನಾ ಫಲ್ಲೊ ಹಮೆ ಖಾ ಸಕಿಯೆಸ, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />ತೆನೈಸೊ ತೆ ಮಳಾನಾ ವಚ್ಮಾ಼ ರ‍್ಹಯಲ ಝಾಡನು ಫಲ್ಲ ನೈ ಖಾ ಸಕ್ತಾ, ತೆ ಝಾಡನು ಫಲ್ಲ ಮುಟ್ಟು ಬಿ ನೈ ಖೌ ಬಿ ನೈ, ಖಾದ್ಯಾಮ ತುಮೆ ಮರೊಶಿ ಕೈನ ಕ್ಹುದಾ ಹಮೊನೆ ಕದ್ಯೊಸ” ಕದಿ. <verse eid="GEN 3:3" /><verse number="4" style="v" sid="GEN 3:4" />ತಿನಾಹುತಿ ಕ್ಹಾಪ ಬಾಕ್ಡಿನೆ ಕದ್ಯೊ, 'ಕ್ಹರಿಮಾಜ಼ ತುಮೆ ಮರ್ತಾ ನೈ. <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />ತುಮೆ ಎ ಝಾಡಮಾನು ಫಲ್ಲ ಖಾದಲ ಬರೊಬ್ಬರ ತುಮಾರಾ ಡೊಳಾ ಖುಲ್ಲಾ ಥಾವಸ, ತುಮೆ ಕ್ಹುದಾ ನಿಂಗತ ಥೈನ ಚೊ಼ಕಾನು ವರಿ ಕೆಟ್ಟನು ಅರು ತಿಳ್ದಿಲಿವೊಶಿ, ಎ ಕ್ಹಾರು ಕ್ಹುದಾನೆ ಗ್ವತ್ತ ಛೆ” ಕೈನ ಕದ್ಯು. <verse eid="GEN 3:5" /><verse number="6" style="v" sid="GEN 3:6" />ತೆಳಾಮಾ ತೆ ಬಾಕಡಿ ತೆ ಝಾಡನಾ ಫಲ್ಲೊ ಖಾವಾನೆ ಬೆ ಚೊ಼ಕು ಛೆ, ದೆಕಾನೆ ಬಿ ಚಂದ ಛೆ, ಗ್ಯಾನ ಆವಾನೆ ಬಿ ಛೆ ಕೈನ ತಿಳದಿಲಿನ ತೆ ಯಕ್ಕ ಫಲ್ಲ ತೊಡಿನ ಖಾದಿ ವರಿ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ಮಾಟಿನೆ ಬಿ ದೆತಾಮಾ, ತೆಬಿ ಖಾದ್ಯೊ. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />ತೆ ಫಲ್ಲ ಖಾದಲ ಬರೊಬ್ಬರ ತ್ಯುನಾ ಡೊಳಾ ಖುಲ್ಯಾ ತ್ಯುನೊನೆ ತ್ಯುನೆ ಭೊಂಗ್ಳಾ ಛೆ ಕೈನ ಅರು ಹುಟ್ಟಲಕ್ಹು ತ್ಯುನೆ ಅಂಜುರನಾ ಝಾಡೊನಾ ಪಾಲೊ ತೊಡಿಲಿನ ತೆ ಪರೈನ ಅಂಗನೆ ಸುತ್ತಿಲಿದ್ಯಾ. <verse eid="GEN 3:7" /><verse number="8" style="v" sid="GEN 3:8" />ತೆ ದಿನ್ನೆ ಯಹೊವಾ ಕ್ಹುದಾ ಕ್ಹಾಂಜ಼ನಿ ತಂಪ ವಾರಾಮಾ, ಮಳಾಮಾ ಪ್ಹರ್ತಾಮಾ ತೆ ದಾಣಗೊ ವರಿ ಬಾಕ್ಡಿ ತಿನೊ ಅವಾಜ಼ ಐಕಿನ ತಿನೆ ದಿಕ್ಹು ನೈ ಕೈನ ಮಳಾಮಾ ರ‍್ಹಯಲ ಝಾಡೊನಾ ವಚ್ಮಾ ದಡಿ ರ‍್ಹಯಾ. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />ತೆನೈಸೊ ಯಹೊವಾ ಕ್ಹುದಾ ತೆ ಮನಕ್ಹನೆ ವದ್ರಿನ , ತು ಕಿಜ್ಗಾ ಛೆ?” ಕೈನ ಪುಚ್ಯೊ. <verse eid="GEN 3:9" /><verse number="10" style="v" sid="GEN 3:10" />ತೆ ವಾತೆ ತೆ; 'ತು ಮಳಾಮಾ ಆವಾನು ಅವಾಜ಼ ಮಿ ಐಕಿನ, ಮಿ ಭೊಂಗ್ಳೊ ಛೆ ಕೈನ ತುನೆ ಭುಚಿ಼ಕಿನ ದಡಿ ರ‍್ಹಯೊಸ” ಕೈನ ಉತ್ತರ ದಿದ್ಯೊ. <verse eid="GEN 3:10" /><verse number="11" style="v" sid="GEN 3:11" />ತೆ ವಾತೆ ಕ್ಹುದಾ, 'ತು ಭೊಂಗ್ಳೊ ಛೆ ಕೈನ ಕದಲವಾಲೊ ಕುನ್ನ ವ್ಹೈ? ಮಿ ತುನೆ ನಕೊ ಖೌ ಕೈನ ಕದಲ ಪ್ಹಲ್ಲ ಖಾದ್ಯೊಸ ಸು?” ಕೈನ ಪುಚ್ಯೊ. <verse eid="GEN 3:11" /><verse number="12" style="v" sid="GEN 3:12" />ತೆ ವಾತೆ ತೆ ಮನಕ್ಹ, ಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಾನೆ ತು ದಿದಲ ಎ ಬಾಕ್ಡಿ, ತೆ ಝಾಡನು ಫಲ್ಲ ಮನೆ ದಿದಿ, ಮಿ ತೆ ಫಲ್ಲ ಖಾದ್ಯೊ” ಕೈನ ಉತ್ತರ ದಿದ್ಯೊ. <verse eid="GEN 3:12" /><verse number="13" style="v" sid="GEN 3:13" />ಯಹೊವಾ ಕ್ಹುದಾ ತೆ ಬಾಕ್ಡಿನೆ, 'ತು ಎ ಸು ಕರಿ?” ಕೈನ ಪುಚ್ತಾ಼ಮಾ, ತೆ ಬಾಕ್ಡಿ, 'ಕ್ಹಾಪ ಮನೆ ಮೊಸ ಕರ‍್ಯು ವರಿ ಮಿ ಖಾದಿ” ಕೈ ಕದಿ.<verse eid="GEN 3:13" /></para>
  <para style="s">ಕ್ಹುದಾನೊ ಫೈಸಲೊ</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />ಯಹೊವಾ ಕ್ಹುದಾ ಕ್ಹಾಪನೆ; 'ಇನಾಹುತಿ ತು ಎ ಕಾಮ ಕರಲ ಹುತಿ ಶಿಕ್ಷಾ ಥಾವಸ. ಕ್ಹಾರಾ ಜಾನವರೊಮಾ ಶ್ರಾಪ ಹೊಂದಲವಾಲೊ ಥಾಶಿ. ತು ಪೆಟಕ್ಹುಜ಼ ಚಾ಼ಲಶಿ. ತು ತಾರಿ ಜಿವನಭರ ಧುಳಜ಼ ಖಾಶಿ. <verse eid="GEN 3:14" /><verse number="15" style="v" sid="GEN 3:15" />ತುನೆ ವರಿ ಆ ಬಾಕ್ಡಿನಾ ಬಚ್ಚಾ಼ನಾ ವಚ್ಮಾ಼ ಶೆಡತನಾ ಮುಕ್ಕುಸ. ಇನಿ ಸಂತತಿ ತಾರು ಮಾತು ಛೆಟಸ. ವರಿ ತು ತಿನಿ ಸಂತತಿನಾ ಪಗ್ನಿ ಎಡಿನೆ ಕಡ್ಡಶಿ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 3:15" /><verse number="16" style="v" sid="GEN 3:16" />ವರಿ ತೆ ಬಾಕ್ಡಿನೆ, 'ಮಿ, ತು ಪೆಟೆ ರ‍್ಹತಾಮಾ ಘನ್ನು ತ್ರಾಸ ದ್ಯುಸ ತು ತ್ರಾಸ ಕ್ಹುಜ಼ ಬಚ್ಚಾ಼ ಜ಼ನ್ಸಿ, ಮಾಟಿಪರ ತುನೆ ಆಸ ರ‍್ಹಯಲ ಕ್ಹು, ತು ತಿನಾ ಅದಿನಮಾ ರ‍್ಹಶಿ" ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 3:16" /><verse number="17" style="v" sid="GEN 3:17" />ತೆ ಥಯಲ್ಪರ ತೆ ದಾಣಗಾನೆ, 'ಖೌ ನೈ ಕೈನ ಮಿ ತುನೆ ಕದಲ ಝಾಡನು ಫಲ್ಲ ತಾರಿ ಬೈಕೊನಿ ವಾತ ಐಕಿನ ಖಾದಲ ಹುತಿ, ತಾರಾ ಹುತಿ ಜಿಮಿನ್ನೆಬಿ ಶ್ರಾಪ ಮಳ್ಯು, ತಾರಿ ಪುರಾಜ಼ ಜಿವನ ತ್ರಾಸ ಖೈನ ಘಾಮ ಚು಼ವೈನ ರಾಬಿನ ಜಿಮಿನ್ಮಾ ಹುಟ್ಟಾನುಜ಼ ಖೌ”. <verse eid="GEN 3:17" /><verse number="18" style="v" sid="GEN 3:18" />ತೆ ಜಿಮಿನ್ಮಾ ಕಾಟಾವೊನಾ ಝಾಡೊ ಘನ್ನಾ ಬೆಳ್ದಸ, ಖೆತರಮಾನಿ ಬೆಳೆಜ಼ ತುನೆ ಅನ್ನ ಥಾವಸ. <verse eid="GEN 3:18" /><verse number="19" style="v" sid="GEN 3:19" />ತು ಮಾತಿಕ್ಹು ಕರಲ ಹುತಿ ವರಿಬಿ ಫರಿನ ಮಾತಿಮಾ ಮಳೆಲಕ್ಕಾ ಘಾಮ ಚು಼ವಾತೊ ತುನೆ ಚಾ಼ಯೆ ಥಯಲ ಅನಾಜ಼ ಗಳಸು. ತುನೆ ಮಾತಿಮಾತೊ ಕಾಡಲ ಹುತಿ ತು ಮಾತಿಜ಼ ವ್ಹೈ, ವರಿ ಫರಿನ ಮಾತಿಮಾಜ಼ ಮಳಲವಾಲೊ ಥಾಶಿ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 3:19" /><verse number="20" style="v" sid="GEN 3:20" />ತೆ ಆದಾಮ ತಿನಿ ಬೈಕೊನು ನಾಮ 'ಹವ್ವಾ” ಕೈನ ಮ್ಹೆಲ್ಯೊ. ತಿನಾ ಹುತಿಜ಼ ಜಿವ್ತಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ತೆಜ಼ ಮುಲ ಮಾತೆ ಥೈಸ. <verse eid="GEN 3:20" /><verse number="21" style="v" sid="GEN 3:21" />ಯಹೊವಾ ಕ್ಹುದಾ ಆದಾಮನೆ ಬಿ ತಿನಿ ಬೈಕೊನೆ ಬಿ ಜಾನವರೊನಾ ಚಾ಼ಮ್ಡಾನಾ ವಣ್ಣಾ ಕರಿನ ಫೆರಾಡ್ಯೊ. <verse eid="GEN 3:21" /><verse number="22" style="v" sid="GEN 3:22" />ಯಹೊವಾ ಕ್ಹುದಾ, 'ತೆ ಮನಕ್ಹಮಾ ಚೊ಼ಕಾನು ಕೆಟ್ಟನು ಫರಕ ವಳಕಿನ ಅಪೊಮಾನೊ ಯಕ್ಲೊ ಥಯೊತೊ, ಇನಾಹುತಿ ಎ ಹತ್ತ ಫೈಲೈನ ತೆ ಜ಼ಲಮನಾ ಝಾಡನು ಫಲ್ಲ ಬಿ ಖೈನ ಹಮೆಶಾ ಜಿವ್ತೊ ರ‍್ಹವಾಲೊ ಥೌ ನೈ” ಕೈನ ಆಜ್ಞಾ ದಿದ್ಯೊ. <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />ತಿನಾ ಹುತಿ ಯಹೊವಾ ತಿನೆ ತಯ್ಯಾರ ಕರಲ ಜಿಮಿನಮಾಜ಼ ಖೆತ್ತಬಾಡಿ ಕರಾನಾ ಹುತಿ ತಿನೆ ಎದೆನ ಮಳಾಮಾತೊ ಭಾರೊ ವಳಯೊಸ. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />ಅಮ್ಮ ತೆ ಮನಕ್ಹನೆ ಭಾರೊ ಘಾಲಿನ, ಜ಼ಲಮನಾ ಝಾಡನೆ ಜಾ಼ವಾನಿ ವಾಟ ಕೈದಾನಾ ಹುತಿ, ಎದೆನ ಮಳಾನಾ ಪುರ್ವ ದಿಕ್ಕ ಬಗಲ ಕೆರೊಬಿವಾಲಾವೊನೆ, ಕ್ಹಾರಿ ಬಗಲ ಧಗಧಗ ಲಾಗಲ ಆಗನಿ ತಲ್ವಾರ ಮಳಾನಾ ಸುತ್ತೆ ಮುಕ್ಯೊ.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">ಕಾಯಿನ ವರಿ ಹೆಬಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />ಆದಾಮ ತಿನಿ ಬೈಕೊ ಥಯಲ ಹವ್ವಾನಾ ಕ್ಹಾತೆ ಮಳತಾಮಾ ತೆ ಪೆಟೆ ರ‍್ಹೈನ ದಿಕ್ರಾನೆ ಜ಼ನ್ನಿನ, 'ಯಹೊವಾನಿ ಮದತಕ್ಹು ಪಟ್ಟಾನೆ ಪಡ್ದಿಲಿದಿಸ” ಕೈನ ಕದಿ.ತಿನಾ ಹುತಿ ತೆ ಕಾಯಿನ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />ತೆ ಥಯಲ್ಪರ ಹೆಬಲ ಕವಾನಾ ವರಿ ಯಕ್ಕ ದಿಕ್ರಾನೆ ಜ಼ನ್ನಿ. ಹೆಬಲ ಬಕ್ರಾ ಚ಼ರಾವಾಲೊ ಥಯೊ; ಕಾಯಿನ ಖೆತಬಾಡಿ ಕರಾಲೊ ಥಯೊ. <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />ದಕ್ಹಾ ದಿನ್ನ ಥಯಲ್ಪರ ಕಾಯಿನ ಖೆತರಮಾ ಬೆಳದಲ ಬೆಳಿಮಾಜ಼ ದಕ್ಹಿ ಬೆಳಿ ಲೈನ ಯಹೊವಾನೆ ಕಾಣಿಕೆ ದಿವಾನೆ ಲಾಯೊ. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />ಹೆಬಲ ತಿನಾ ನಿಂಗತಜ಼಼ ಬಕ್ರಾವೊನಾ ಹಿಂಡಮಾನು ಪೈಲಾ ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ನೆ ಲೈನ ತಿನೆ ಕತ್ರಿನ ಚೊ಼ಕು ರ‍್ಹಯಲ ಭಾಗ ಲಿನ ಹೊಮಾ ಕರ‍್ಯೊ, ಯಹೊವಾ ಹೆಬಲ ಚ಼ಡಾಯಲ ಕಾಣಿಕಿನೆ ಪಸಂದ ಕರ‍್ಯೊ. <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />ತೆನೈಸೊ ಕಾಯಿನನಿ ದಿದಲ ಕಾಣಿಕಿನೆ ಯಹೊವಾ ಪಸಂದ ಕರ‍್ಯೊ ನೈ. ತಿನಾಹುತಿ ಕಾಯಿನ ಘನ್ನೊ ಶಿಟ್ಟ ಥಯೊ, ತಿನು ಮ್ಹೊಡು ಶಿಟ್ಟಕ್ಹು ಮ್ಹೊಡು ಉತ್ರಿಗಯು. <verse eid="GEN 4:5" /><verse number="6" style="v" sid="GEN 4:6" />ತೆಳಾಮಾ ಯಹೊವಾ ಕಾಯಿನನೆ, 'ತು ಶಿಟ್ಟ ಕಾ ಥಯೊಸ? ತಾರು ಮ್ಹೊಡು ಶಿಟ್ಟಕ್ಹು ಕಾ ಉತ್ರಿಗಯುಸ? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />ತು ಚೊ಼ಕು ಕಾಮ ಕರತ್ತೊ ತಾರಿ ಕಾಣಿಕಿನೆ ಸ್ವಿಕಾರ ಕರ‍್ತೊತೊ. ಪಾಪ ಕವಾನು ತುನೆ ಧರಾನಾ ಹುತಿ ಬಾಕಲಮಾಜ಼ ಹುಬ್ರಯುಸ, ತೆ ತುನೆ ತಿನಾ ಹತಮಾ ಮ್ಹೆಲ್ಲಿವಸ. ತೆನೈಸೊ ತು ತಿನೆ ತಾರಾ ಹತಮಾ ಮುಕ್ಕಿಲ್ಯು” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 4:7" /><verse number="8" style="v" sid="GEN 4:8" />ತೆ ಥಯಲ್ಪರ ಕಾಯಿನ ತಿನಾ ನ್ಹಾನಾ ಭೈನೆ, 'ಖೆತರೆ ಗೈಯೆ ಆ ಕೈನ ಬಲಾಯೊ. ಖೆತರೆ ಆತಾಮಾ ಕಾಯಿನ ತಿನಾ ನ್ಹಾನಾ ಭೈನೆ ಖಲಾಸ ಕರಿಪಾಡ್ಯೊ. <verse eid="GEN 4:8" /><verse number="9" style="v" sid="GEN 4:9" />ಯಹೊವಾ ಕಾಯಿನನೆ, 'ತಾರೊ ನ್ಹಾನೊ ಭೈ ಕಿಜ್ಗಾ಼ ಛೆ? ಕೈನ ಪುಚ್ತಾ಼ಮಾ ತೆ, 'ಮನೆ ಗ್ವತ್ತ ನತ್ತಿ, ಮಾರಾ ಭೈನೆ ಮಿ ಕೈದಾಲೊ ವ್ಹೈಸು?” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 4:9" /><verse number="10" style="v" sid="GEN 4:10" />ತೆ ವಾತೆ ಯಹೊವಾ, 'ತು ಸು ಕರ‍್ಯೊಸ? ತಾರಾ ಭೈನು ರಗತ ಜಿಮಿನಮಾತು ಮನೆ ವದ್ರಾಡುಸ. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />ತು ತಾರಾ ಹತ್ತಕ್ಹು ಚು಼ವಾಯಲ, ತಾರಾ ಭೈನಾ ರಗತ ಕ್ಹು ಭಿಂಜಾ಼ಯಲ ಎ ಜಿಮಿನ ತಿನು ರಗತ ಪಿದಿಸ ತಿನಾಹುತಿ ತೆ ಜಿಮಿನಪರ ಖೆತಿಬಾಡಿ ನೈ ಕರಾನು ಶ್ರಾಪ ತುನೆ ಐಯು. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />ತು ಎ ಜಿಮಿನ್ಮಾ ವ್ಯವಸಾಯ ಕರ‍್ಯೊತಬಿ, ತುನೆ ತೆ ಜಿಮಿನ ಫಲ್ಲ ದೆತಿ ನೈ. ತು ಭುಲೊಕಮಾ ಭಟ್ಕಾಲೊ ಥಾಸಿ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 4:12" /><verse number="13" style="v" sid="GEN 4:13" />ತೆಳಾಮಾ ಕಾಯಿನ ಯಹೊವಾನೆ, 'ಎ ಶಿಕ್ಷಾ ಮನೆ ಘನ್ನಿ ಕಟಿನ ಥೈ. ತಿನೆ ತಡ್ದಿಲಿವಾನೆ ಮನೆ ನೈ ಥಾತು. <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />ದೆಕ, ತು ಹಮ್ನಾಜ಼ ಮನೆ ಸ್ವಂತ ದೆಶತೊ ನ್ಹಟಾಡಿಪಾಡ್ಯೊಸ್ತೊ! ತಾರಿ ನಜ಼ರಮಾತೊ ಕಾಡಿಪಾಡ್ಯೊಸ. ತಿನಾಹುತಿ ಮಿ ಜಿಮಿನಪರ ಭಟ್ಕಾಲೊ ಥೈನ ದೆಶಭ್ರಶ್ಟ ಥೌ ಲಾಗ್ಯು; ಎನೈಸೊ ಮನೆ ದೆಕಲವಾಲಾ ಮನೆ ಖಲಾಸ ಕರಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 4:14" /><verse number="15" style="v" sid="GEN 4:15" />ತಿನಾಹುತಿ ಯಹೊವಾ ಉತ್ತರ ದಿದ್ಯೊ, ನೈ, ಕುನ್ನಬಿ ತುನೆ ಖಲಾಸ ಕರ‍್ಯಾಮ ತಿನಿ ಶೆಡನಾ ಹುತಿ ಕ್ಹಾತ ಪಟ್ಟ ಹಾನಿ ಥಾವಸ ಕೈನ, ಕಾಯಿನನೆ ದೆಕಲವಾಲಾ ತಿನೆ ಖಲಾಸ ಕರೆನೈಸೊ ತಿನೆ ದೆಕಿನ ಗಪ್ಪಜ಼ ಜಾ಼ವಾ ವರಕ್ಹು ತಿನಾ ಉಪ್ಪರ ವಳಕ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />ಕಾಯಿನ ಯಹೊವಾನಿ ಸನ್ನಿದಿಮಾತೊ ಗೈನ ಎದೆನನಾ ಪುರ್ವ ದಿಕ್ಕೆ ರ‍್ಹಯಲ ಫರಾನಿ ಜ಼ಗಾ ರ‍್ಹವಾನು ಶುರು ಕರ‍್ಯೊ.<verse eid="GEN 4:16" /></para>
  <para style="s">ಕಾಯಿನನಿ ಸಂತತಿ</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />ಕಾಯಿನ ತಿನಿ ಬೈಕೊ ನೆ ಕುಡ್ತಾಮಾ ತೆ ಪೆಟೆ ರ‍್ಹೈನ ದಿಕ್ರಾನೆ ಜ಼ನ್ನಿ. ತಿನು ನಾಮ ಹನೊಕ ವ್ಹೈ. ಯಕ್ಲುಜ಼ ನೈಸೊ ಯಕ್ಕ ಗಾಮ ಭಾಂದಿನ ತೆ ಗಾಮನೆ ತಿನಾ ದಿಕ್ರಾನು ನಾಮ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />ಹನೊಕನೆ ಇರಾದ ಕವಾನಾ ನಾಮನೊ ದಿಕ್ರೊ ಹುಟ್ಯೊ. ಇರಾದನೆ ಮೆಹುಯಾಯೆಲ ದಿಕ್ರೊ ವ್ಹೈ. ಮೆಹುಯಾಯೆಲನೊ ದಿಕ್ರೊ ಮೆತುಶಾಯೆಲ ವ್ಹೈ. ಮೆತುಶಾಯೆಲನೊ ದಿಕ್ರೊ ಲೆಮೆಕ ವ್ಹೈ. <verse eid="GEN 4:18" /><verse number="19" style="v" sid="GEN 4:19" />ಲೆಮೆಕ ಆದಾ ವರಿ ಚಿಲ್ಲಾ ಕವಾಲಿಯೊ ಬೆ ಬಾಕ್ಡಿಯೊನೆ ಕರ್ಲಿದ್ಯೊ. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />ಆದಾಳ ಯುಬಾಲನೆ ಜ಼ನ್ನಿ; ತೆ ಢೊರೊ ರಾಕಾಲಾವೊನೆ ವರಿ ಗುಡಾರಮಾ ರ‍್ಹಯವಾಲಾವೊನೆ ಮೊಲ ಪುರಶ ಎಜ಼ ವ್ಹೈ. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />ತಿನಾ ನ್ಹಾನಾ ಭೈನು ನಾಮ ಯುಬಾಲ ವ್ಹೈ. ಎ ಪಾಂಯೊ ವಜಾ಼ಡಾಲಾವೊಮಾ ಎಜ಼ ಮುಲ ಪುರುಶ ವ್ಹೈ. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />ಚಿಲ್ಲಾ ಕವಾಲಿ ತುಬಲ ಕಾಯಿನನೆ ಜ಼ನ್ನಿ; ತೆ ಕುಲುಮೆ ಕರಿ ಲ್ಹೊಡಾನು ವರಿ ತಾಂಬಾನು ಸಾಮನೊ ಕರಾಲೊ ಥಯೊ. ತುಬಲ ಕಾಯಿನನಿ ಭೆನನು ನಾಮ ನಯಮಾ ವ್ಹೈ. <verse eid="GEN 4:22" /><verse number="23" style="v" sid="GEN 4:23" />ಲೆಮಕ ತಿನಿಯೊ ಬೈಕೊನೆ ಅಮ್ಮ ಕದ್ಯೊ ಆದಾ, ಚಿಲ್ಲಾ, ಮಾರಿ ವಾತ ಐಕೊ, ಲೆಮಕನಿ ಬಾಕ್ಡಿಯೊ, ಮನೆ ದುಕ್ಕ ಕರಲ ಯಕ್ಕ ಮನಕ್ಹನೆ ಖಲಾಸ ಕರ‍್ಯೊ; ಮನೆ ಮಾರಲ ಯಕ್ಕ ಜಾಂಜಿಮಾನನೆ ಖಲಾಸ ಕರ‍್ಯೊ. <verse eid="GEN 4:23" /><verse number="24" style="v" sid="GEN 4:24" />ಕಾಯಿನನೆ ಖಲಾಸ ಕರಲವಾಲಾನೆ ಕ್ಹಾತ ಪಟ್ಟ ಯಕ್ಲು ದಂಡ ಆವಾನು ರ‍್ಹಯುಮ ಮನೆ ಮಾರಾಲಾನೆ ಸತ್ತರಪರ ಕ್ಹಾತ ಯಕ್ಲು ಥಾವಸ ನೈ.<verse eid="GEN 4:24" /></para>
  <para style="s">ಸೆತ ವರಿ ಎನೊಶ</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />ಆದಾಮ ತಿನಿ ಬೈಕೊನೆ ಫರಿನೆ ವರಿ ಕುಡ್ತಾಮಾ ತೆ ಪಟ್ಟೊ ಹುಟ್ಯೊ. ಕಾಯಿನನೆ ಖಲಾಸ ಕರಲ ಹೆಬಲನಾ ಬದಲಿ ಮನೆ ಕ್ಹುದಾ ಬಿಜೊ಼ ದಿಕ್ರೊ ದಿದ್ಯೊ ಕೈನ ತೆ ಪಟ್ಟಾನೆ ಸೆತ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />ತೆ ಥಯಲ್ಪರ ಸೆತಬಿ ಪಟ್ಟಾನೆ ಪಡ್ದಿನ ತಿನು ನಾಮ ಎನೊಶ ಕೈನ ಮ್ಹೆಲ್ಯೊ; ಮನಕ್ಹೊ ತೆಳಾಮಾ 'ಯಹೊವಾನಾ” ನಾಮಪರ ಆರಾಧನಾ ಕರಾನು ಶುರು ಕರ‍್ಯಾ.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">ಆದಾಮನಿ ಸಂತತಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />ಆದಾಮನಾ ಖಾಂದಾನನಿ ವಳಕ ಕ್ಹುದಾ ಸೃಷ್ಟಿಕಾಲಮಾ ಮನಕ್ಹನೆ ತಿನಾ ರುಪ ನಿಂಗತಜ಼಼ ತಯ್ಯಾರ ಕರ‍್ಯೊ. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />ತ್ಯುನೊನೆ ಗಂಡ ಹೆಣ್ಣ ಕರಿನ ತಯ್ಯಾರ ಕರ‍್ಯೊ. ಎನೈಸೊ ತೆಜ಼ ದಿನ್ಮಾ ತ್ಯುನೊನೆ ಆಶಿರ್ವಾದ ದಿನ ತ್ಯುನೊನೆ ಮನಕ್ಹ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 5:2" /><verse number="3" style="v" sid="GEN 5:3" />ಆದಾಮ ಯಕ್ಹೊನ ಮುವತ್ತ ವರಕ್ಹನೊ ಥಾತಾಮಾ ತಿನಾ ರುಪಮಾ ಪಟ್ಟಾನೆ ಪಡದ್ಯೊ ತಿನೆ ಸೆತ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />ಸೆತ ಹುಟ್ಟಲಪರ ಆದಾಮ ಗಂಡ ಹೆಣ್ಣ ಪಚ್ಚಾ಼ವೊನೆ ಪಡ್ದಿನ 800 ವರಕ್ಹ ಜಿವ್ತೊ ವ್ಹತ್ತೊ. ಹಜು಼ನ ತಿನಾ ಬಚ್ಚಾ಼ ವ್ಹತ್ತಾ. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />ತೆ 930 ವರಕ್ಹಲಕ್ಕಾ ಜಿವ್ತೊ ರ‍್ಹೈನ ಮರ‍್ಯೊ. <verse eid="GEN 5:5" /><verse number="6" style="v" sid="GEN 5:6" />ಸೆತ 105 ವರಕ್ಹ ರ‍್ಹತಾಮಾ ಎನೊಶನೆ ಪಡದ್ಯೊ. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />ಎನೊಶ ಹುಟ್ಟಲಪರ ಸೆತ ಗಂಡ ಹೆಣ್ಣ ಬಚ್ಚಾ಼ವೊನೆ ಪಡ್ದಿನ 807 ವರಕ್ಹ ಜಿವ್ತೊ ವ್ಹತ್ತೊ. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />ತೆ 912 ವರಕ್ಹ ಜಿವ್ತೊ ರ‍್ಹೈನ ಮರ‍್ಯೊ. <verse eid="GEN 5:8" /><verse number="9" style="v" sid="GEN 5:9" />ಎನೊಶ 90 ವರಕ್ಹನೊ ಥಾತಾಮಾ ಕೆನಾನೆ ಪಡದ್ಯೊ. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />ಕೆನಾನ ಹುಟ್ಟಲಪರ ಎನೊಶ ಗಂಡ ಹೆಣ್ಣ ಬಚ್ಚಾ಼ವೊನೆ ಪಡ್ದಿನ 815 ಜಿವ್ತೊ ವ್ಹತ್ತೊ. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />ತೆ 905 ಜಿವ್ತೊ ರ‍್ಹೈನ ಮರ‍್ಯೊ. <verse eid="GEN 5:11" /><verse number="12" style="v" sid="GEN 5:12" />ಕೆನಾನ 70 ವರಕ್ಹನೊ ಥಾತಾಮಾ ಮಹಲೆಲನೆ ಪಡದ್ಯೊ. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />ಮಹಲೆಲ ಹುಟ್ಟಲಪರ ಕೆನಾನ ಗಂಡ ಹೆಣ್ಣ ಬಚ್ಚಾ಼ವೊನೆ ಪಡದಿನ 840 ವರಕ್ಹ ಜಿವ್ತೊ ವ್ಹತ್ತೊ. ವರಿ ತಿನೆ ಹಜು಼ನ ಬಚ್ಚಾ಼ ವ್ಹತ್ತಾ. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />ತೆ 910 ವರಕ್ಹ ಜಿವ್ತೊ ರ‍್ಹೈನ ಮರ‍್ಯೊ. <verse eid="GEN 5:14" /><verse number="15" style="v" sid="GEN 5:15" />ಮಹಲಲೆಲ 65 ವರಕ್ಹಮಾ ಯೆರೆದನನೆ ಪಡದ್ಯೊ. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />ಯೆರೆದನ ಹುಟ್ಟಲಪರ ಮಹೆಲೆಲ ಪಟ್ಟೊ ಚೊ಼ಕ್ರಿ ಪಡದಿನ 830 ವರಕ್ಹ ಜಿವ್ತೊ ವ್ಹತ್ತೊ. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />ತೆ ವಟ್ಟಜ಼ 895 ವರಕ್ಹ ಜಿವ್ತೊ ರ‍್ಹೈನ ಮರ‍್ಯೊ. <verse eid="GEN 5:17" /><verse number="18" style="v" sid="GEN 5:18" />ಯೆರೆದನ 162 ವರಕ್ಹನೊ ರ‍್ಹತಾಮಾ ಹನೊಕನೆ ಪಡದ್ಯೊ. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />ಹನೊಕ ಹುಟ್ಟಲಪರ ಯೆರೆದನ 800 ವರಕ್ಹ ಜಿವ್ತೊ ವ್ಹತ್ತೊ. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />ತಿನೆ ಹಜು಼ನ ಬಚ್ಚಾ಼ ವ್ಹತ್ತಾ. <verse eid="GEN 5:20" /><verse number="21" style="v" sid="GEN 5:21" />ಹನೊಕ 65 ವರಕ್ಹನೊ ರ‍್ಹತಾಮಾ ಮೆತೊಶೆಲನೆ ಪಡದ್ಯೊ. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />ಮೆತುಶೆಲಹನ ಹುಟ್ಟಲಪರ ಹನೊಕ ಗಂಡ ಹೆಣ್ಣ ಬೆ ಬಚ್ಚಾ಼ವೊನೆ ಪಡದಿನ ಕ್ಹುದಾನಿ ಅನ್ಯುನ್ಯೆತೆಮಾ 300 ವರಕ್ಹ ಜಿವ್ತೊ ವ್ಹತ್ತೊ. ವರಿ ತಿನೆ ಹಜು಼ನ ಬಚ್ಚಾ ವ್ಹತ್ತಾ. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />ತೆ ಜಿವ್ತೊ ರ‍್ಹಯಲ 365 ವರಕ್ಹ ವ್ಹೈ. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />ಹನೊಕ ಕ್ಹುದಾಮಾ ಅನ್ಯುನ್ಯೆತೆಮಾ ಚಾ಼ಲ್ತೊ ರ‍್ಹತಾಮಾ ಕ್ಹುದಾ ತಿನೆ ಬಲಾಯೊ. ತೆ ಗಾಯಬ ಥಯೊ. ತಿನಾಹುತಿ ತೆ ದಿಕ್ಹ್ಯಾವಾಚಿ ವ್ಹತ್ತೊ. <verse eid="GEN 5:24" /><verse number="25" style="v" sid="GEN 5:25" />ಮೆತುಶೆಲನ 187 ವರಕ್ಹನೊ ರ‍್ಹತಾಮಾ ಲೆಮೆಕನೆ ಪಡದ್ಯೊ. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />ಲೆಮೆಕ ಹುಟ್ಟಲಪರ ಮೆತುಶೆಲಹನ ಗಂಡ ಹೆಣ್ಣ ಬಚ್ಚಾ಼ವೊನೆ ಪಡದಿನ 782 ವರಕ್ಹ ಜಿವ್ತೊ ವ್ಹತ್ತೊ. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />ತೆ ವಟ್ಟಜ಼ 969 ವರಕ್ಹ ಜಿವ್ತೊ ರ‍್ಹೈನ ಮರ‍್ಯೊ. ವರಿ ತಿನೆ ಹಜು಼ನ ಬಚ್ಚಾ಼ ವ್ಹತ್ತಾ. <verse eid="GEN 5:27" /><verse number="28" style="v" sid="GEN 5:28" />ಲೆಮೆಕ 182 ವರಕ್ಹನೊ ರ‍್ಹತಾಮಾ ಯಕ್ಕ ಪಟ್ಟಾನೆ ಪಡದ್ಯೊ. <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />'ಯಹೊವಾ ಶ್ರಾಪ ದಿದಲ ಜಿಮಿನಕ್ಹು ಥಾವಾನು ತ್ರಾಸ ಖೈನ ಎ ದಿಕ್ರೊ ಅಪೊನೆ ತ್ರಾಸಮಾತೊ ಭಾರೊ ಕಾಡಿನ ಶಾಂತಿ ದಿವಸ” ಕೈನ ತಿನೆ 'ನೊಹಾ” ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />ನೊಹಾ ಹುಟ್ಟಲಪರ ಲೆಮೆಕ ಗಂಡ ಹೆಣ್ಣ ಬೆ ಬಚ್ಚಾ಼ವೊನೆ ಪಡದಿನ 595 ವರಕ್ಹ ಜಿವ್ತೊ ವ್ಹತ್ತೊ. ತಿನೆ ಹಜು಼ನ ಬಚ್ಚಾ಼ ವ್ಹತ್ತಾ. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />ತೆ ವಟ್ಟಜ಼ 777 ವರಕ್ಹ ಜಿವ್ತೊ ರ‍್ಹೈನ ಮರ‍್ಯೊ. <verse eid="GEN 5:31" /><verse number="32" style="v" sid="GEN 5:32" />ನೊಹ 500 ವರಕ್ಹನೊ ಥಾತಾಮಾ ಶೆಮ, ಹಾಮ, ಯೆಫೆತ ಕವಾಲಾ ತನ್ನ ಬಚ್ಚಾ಼ವೊನೆ ಪಡದ್ಯೊ.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">ನೊಹಾನಿ ಚರಿತ್ರ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />ಮನಕ್ಹನಿ ಜಾ಼ತ ದುನಿಯಾಪರ ಫೈಲಲ ನಿಂಗತ ತ್ಯುನೊನೆ ಛೊಕ್ರಿಯೊ ಹುಟ್ಟಿಯೊ. <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />ಎ ಮನಕ್ಹನಿಯೊ ದಿಕ್ರಿಯೊನಿ ಸುಂದರ್ತಾ ದೆಕಿನ ಕ್ಹುದಾನಾ ಗಂಡ ಪಟ್ಟಾ ತ್ಯುನಾ ಮನಸೆ ಆಯಲವಾಲಿಯೊನೆ ಹಿವಾ ಕರ್ಲಿದ್ಯಾ. <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />ತೆಳಾಮಾ ಯಹೊವಾ, 'ಮಾರಿ ಆತ್ಮಾ ಮನಕ್ಹೊಮಾ ಹಮೆಶಾಬಿ ಮಿ ರ‍್ಹವಾನೆ ದೆತೊ ನೈ. ತ್ಯುನೆ ಕ್ಹಾಲಿ ಅಂಗ ವ್ಹೈ, ತ್ಯುನೆ ಮರಾಲಾಜ಼ ವ್ಹೈ. ತ್ಯುನಿ ವೈಸ ಕ್ಹಾಲಿ 120 ವರಕ್ಹ ರ‍್ಹವಾದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 6:3" /><verse number="4" style="v" sid="GEN 6:4" />ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ ಮನಕ್ಹೊನಾ ದಿಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ಕುಡತಾಮಾ ಬಚ್ಚಾ಼ ಹುಟ್ಯಾ. ತೆ ಕಾಲತಾ ತೆ ಥಯಲ ಪರಬಿ ದುನಿಯಾಮಾ ಮ್ಹೊಟಾ ಅಂಗವಾಲಾ ವ್ಹತ್ತಾ. ಇವ್ನೆಜ಼ ಪುರ್ವ ಕಾಲಮಾ ಘನ್ನಾ ಪ್ರಸಿದ್ದ ತಾಕತವರೊ, ನಾಯಕೊ ನಾಮವಾಲಾ ಥಯಾತಾ. <verse eid="GEN 6:4" /><verse number="5" style="v" sid="GEN 6:5" />ದುನಿಯಾಮಾನಾ ಮನಕ್ಹೊನು ಕೆಟ್ಟತನಾ ಜಾಸ್ತಿ ಥಾತುಜ಼ ವ್ಹತ್ತು. ತ್ಯುನೆ ತ್ಯುನಾ ಮನಸ್ಸಮಾ ವಿಚಾರೊ ಕರಾನು ಕೆಳಾಮಾಬಿ ಕೆಟ್ಟ ವಿಚಾರೊಜ಼ ಕರಾನು ಯಹೊವಾ ದೆಕ್ಯೊ. <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />ಎ ದೆಕಿನ ಕ್ಹುದಾ ಮನಕ್ಹನೆ ತಯ್ಯಾರ ಕರಲ ಹುತಿ ತಿನಾ ಮನಸನೆ ಘನ್ನು ದುಖ ಥಯು. <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />ತೆಳಾಮಾ ತೆ, 'ಮಿ ತಯ್ಯಾರ ಕರಲ ಮನಕ್ಹೊನೆ ದುನಿಯಾಮಾತೊ ನಾಮೊ ನಿಶಾನ ನೈಸೊ ಕರಿ ಪಾಡುಸ, ತ್ಯುನಾ ಕ್ಹಾತೆ ಪಶು ಪಕ್ಷಿಯೊನೆ, ಜಿಮಿನಪರ ಫರಾನಾ ಕಿಡಾ ಕಾಟುನೆಬಿ ನೈಸೊ ಕರಿಪಾಡುಸ. ತ್ಯುನೊನೆ ತಯ್ಯಾರ ಕರಲಹುತಿ ಮಾರು ಮನಸ ದುಖ ಥಾವಾಡುಸ. <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />ತೆನೈಸೊ ಕ್ಹುದಾ ನೊಹಾನಾ ವಿಶಯಮಾ ಖುಶಿ ಥಯೊ.<verse eid="GEN 6:8" /></para>
  <para style="s">ನೊಹಾ</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />ನೊಹಾನಿ ಚರಿತ್ರೆ ವ್ಹೈ: ನೊಹಾ ಕ್ಹರಿಕ್ಹು ರ‍್ಹವಾಲೊ ವ್ಹತ್ತೊ, ತೆ ಕಾಲನಾ ಮನಕ್ಹೊಮಾ ತೆ ನಿರ್ದೊಶಿ ವ್ಹತ್ತೊ. ತೆ ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಅನ್ಯುನ್ಯ ರ‍್ಹೈನ ಚಾ಼ಲಿಲಿನ ಜಾ಼ತೊತೊ. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />ತಿನೆ ಶೆಮ, ಹಾಮ, ಯೆಫೆತ ಕವಾಲಾ ತನ್ನ ದಿಕ್ರಾ ವ್ಹತ್ತಾ. <verse eid="GEN 6:10" /><verse number="11" style="v" sid="GEN 6:11" />ತೆಳಾಮಾ ದುನಿಯಾ ಕ್ಹುದಾನಿ ನಜ಼ರಮಾ ಕೆಟ್ಟಿತಿ. ವರಿ ತ್ರಾಸಕ್ಹು ಭರ‍್ಯುತು. <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />ಕ್ಹುದಾ ದುನಿಯಾನಾ ಕೆಕ್ಲಾ ಕೆಟ್ಟ ಥೈ ಗೈಸ ಕೈನ ದೆಕ್ತಾಮಾ, ಕಾಕದ್ಯಾಮ ದುನಿಯಾಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಮನಕ್ಹೊನಾ ವಾಟೊ ಕೆಟ್ಟತನಾಕ್ಹು ಭರ‍್ಯಾಸ. <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />ತೆಳಾಮಾ ಕ್ಹುದಾ ನೊಹಾನೆ, 'ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಕ್ಹಾರುಜ಼ ಹಾಳ ಕರಿಪಾಡುಸ ಕೈನ ಮಿ ಫೈಸ್ಲೊ ಕರ‍್ಯೊಸ. ಕಾಕದ್ಯಾಮ ಇವ್ನಾಕ್ಹು ದುನಿಯಾ ಹಿಂಸೆಕ್ಹು ಭರಿ ಗಯುಸ. ಮಿ ಕ್ಹರಿಮಾಜ಼ ತ್ಯುನೊನೆಬಿ ದುನಿಯಾಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರುಜ಼ ನಾಶ ಕರುಸ. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />ತು ಚೊ಼ಕಾ ಝಾಡಕ್ಹು ತಾರಾಹುತಿ ಯಕ್ಕ ಹಡಗೊ ಕರಿಲೆ, ತಿಮಾ ಘನ್ನಾ ಕ್ಹೊಲಿಯೊ ರ‍್ಹವಾದೆ, ತಿನಾ ಮ್ಹೈಬಿ ಭಾರೊಬಿ ಡಾಂಬರ ಲಗಾಡ. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />ತೆ ಅಮ್ಮ ಕರ, ತೆ ಹಡಗೊ ಲಾಂಬಾಮಾ 450 ಪುಟ ರುಂದಮಾ, 75 ಪುಟ ಉಚ್ಚಾ಼ಮಾ 45 ಪುಟ <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />ತಿನಾ ಛತ್ತನಾ ಹೆಟು 18 ಇಂಚ಼ ಖುಲ್ಲಾ ರ‍್ಹವಾದೆ. ತಿನಾ ಬಾಜು಼ಮಾ ಬಾಕಲ ರ‍್ಹವಾದೆ; <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />ಮಿ ತುನೆ ಕವಾಡೊಸ ಕಳಿಲೆ ಮಿ ಜಿಮಿನ್ಪರ ಕ್ಹಾರವೊತಿ ಮ್ಹೊಟು ಪಾನಿನು ತುಫಾನ ಲೌಸ ಹಬಾಳನಾ ಹೆಟಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾವೊನೆ ಮಾರಿಪಡುಸ ಜಿಮಿನ್ಪರ ಹರಯಕ್ಕ ನಾಶ ಥಾವಸ. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />ಮಿ ತಾರಾ ಕ್ಹಾತೆ ಯಕ್ಕ ವಡಂಬಡಿಕೆ ಕರಲ್ಯುಸ ತೆ ಸುವೈ ಕದ್ಯಾಮ ತು ತಾರಿ ಬೈಕೊ ಗಂಡ ಬಚ್ಚಾ ವರಿ ವ್ಹೌವೊನೆಲಿನ ಹಡಗಾಮಾ ಜಾ. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />ತೆನೈಸೊ ತು, ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಹರಯಕ್ಕ ಜಿವಿನಾ ಜೊಡಿ ಯಕ್ಕ ಗಂಡ ಯಕ್ಕ ಹೆಣ್ಣ ಕೈನ ಹಡಗಾಮಾ ಬಲೈಲೆ ತಾರಾ ಕ್ಹಾತೆ ತ್ಯುನೊನೆ ಬಿ ವಚಾ಼ಡುಸ. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಹರಯಕ್ಕ ಜಾತನಿ ಪಕ್ಷಿಯೊಮಾ ಯಕ್ಕ ಹೆಣ್ಣ ಯಕ್ಕ ಗಂಡ ಹರಯಕ್ಕ ಜಾನವರೊಮಾ ಯಕ್ಕ ಹೆಣ್ಣ ಯಕ್ಕ ಗಂಡ ವರಿ ಹರಯಕ್ಕ ಜಿವ ಜಂತು ತಿನು ಜಲಮ ವಚಾ಼ಡ ಲಿವಾನಾ ಹುತಿ ತಾರಾ ಕ್ಹಾತೆ ಆವಾದೆ. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />ಜಿಮಿನ್ಪರ ಮಳಾನು ಹರಯಕ್ಕ ಜಿವ ಜಂತು ಕ್ಹಾವಾನು ವರಿ ತಾರಾಹುತಿಬಿ ಹಡಗಾಮಾ ಭರಲೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 6:21" /><verse number="22" style="v" sid="GEN 6:22" />ಕ್ಹುದಾ ಕದಲ ನಿಂಗತ ಕ್ಹಾರು ನೊಹಾ ಕರೊ<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">ಜಲ ಪ್ರಳಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />ತೆ ಕ್ಹಾರು ಥಯಲ್ಪರ ಕ್ಹುದಾ ನೊಹಾನೆ, ಹಮ್ನಾ ರ‍್ಹವಾನಿ ಸಂತತಿಮಾ ತು ಯಕ್ಲೊಜ ನಿತಿವಂತ ಶೆ. ತಿನಾಹುತಿ ತಾರಾ ಘರವಾಲಾವೊನೆ ಲಿನ ಹಡಗಾನಾ ಮ್ಹೈ ಜಾ. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />ಕ್ಹಾರಾ ತರಾನಾ ಶುದ್ದ ಪ್ರಾಣಿಯೊಮಾ ಕ್ಹಾತ ಕ್ಹಾತ ಜೊಡಿ (ಕ್ಹಾತ ಗಂಡ ಕ್ಹಾತ ಹೆಣ್ಣ ) ಲೆ. ವರಿ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಅಶುದ್ದ ಪ್ರಾಣಿಯೊಮಾ ಯಕ್ಕ ಯಕ್ಕ ಜೊಡಿ (ಯಕ್ಕ ಹೆಣ್ಣ ಯಕ್ಕ ಗಂಡ)ಲೆ. <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />ಹರಯಕ್ಕ ಪಕ್ಷಿಯೊಮಾ ಕ್ಹಾತ ಕ್ಹಾತ ಜೊಡಿ (ಕ್ಹಾತ ಗಂಡ ಕ್ಹಾತ ಹೆಣ್ಣ) ಲೆ. ಜಿಮಿನಪರ ಇವ್ನಿ ಸಂತತಿ ಬೆಳದಾನಾ ಹುತಿ ತು ಇಮ್ಮ ಕರ. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />ಹಮ್ನಾತಾ ಕ್ಹಾತ ದಿನ ಥಯಲ್ಪರ ಮಿ ಘನ್ನೊ ಜೊರೆ ಜಿಮಿನಪರ ಪಾನಿ ಆವಾಲಗಾಡುಸ ಆ ಪಾನಿ ಚಾಳಕ್ಹ ದಿನ್ನ ರಾತ ಆತು ರ‍್ಹಯಲ ರ‍್ಹವಸ ಮಿ ಕರಲ ಹರಯಕ್ಕ ಜಿವ ಜಂತು ಜಿಮಿನ ಪರ್ತೊ ನಾಶ ಕರುಸ. <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />ಯಹೊವಾ ಕದಲ ತಿಮ್ಮ ನೊಹಾ ಪುರಾ ಕರ‍್ಯೊ. <verse eid="GEN 7:5" /><verse number="6" style="v" sid="GEN 7:6" />ಜಿಮಿನ ಪರ ಪಾನಿ ಆತಾ ಟೈಮಾ ನೊಹಾನಿ ವೈಸ ಛೆಕ್ಹೊ ವರಕ್ಹ ವ್ಹತ್ತಿ. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />ತೆಳಾಮಾ ಪಾನಿಕ್ಹು ವಾಚಾನಾಹುತಿ ನೊಹಾ ತಿನಿ ಬೈಕೊ ಬಚ್ಚಾ ವರಿ ವ್ಹೌವೊನಾ ಕ್ಹಾತೆ ಹಡಗಾಮಾ ಗಯೊ. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />ಕ್ಹಾರಾ ಶುದ್ದ ಅಶುದ್ದ ಜಾನವರೊ ವರಿ ಪಕ್ಷಿಯೊ, ಜಿಮಿನ್ಪರ ಫರಾನಾ ಜಾನವರೊ, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />ನೊಹಾನಾ ಕ್ಹಾತೆ ಹಡಗಾಮಾ ಗಯಾ ಕ್ಹುದಾ ಕದಲನಿಂಗತಜ಼ ಹರಯಕ್ಕ ಜಾನವರೊಮಾ ಗಂಡ ಹೆಣ್ಣ ಜೊ಼ಡಿ-ಜೊ಼ಡಿ ಹಡಗಾಮಾ ಗಯಾ. <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />ಕ್ಹಾತ ದಿನ ಥಯಲ್ಪರ ಪಾನಿನು ತುಫಾನ. <verse eid="GEN 7:10" /><verse number="11" style="v" sid="GEN 7:11" />ಬೆವಾ ಮ್ಹೈನೊ ಕ್ಹತ್ರಾವಾ ದಿನ್ನೆ ಪುರಾ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಸಮುಂದರಮಾನಾ ಶಲಿಯೊ ಫುಟ್ಯಾ. ಹಬಾಳನಾ ಬಾಕಲೊ ಖುಲ್ಯಾ, <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />ಹಬಾಳ ಪ್ಹುಟ್ಯುಸ ಕೌ ತಿಮ್ಮ ಚಾಳಕ್ಹ ದಿನ ರಾತಮಾಬಿ ಪಾನಿ ಆತು ಗಯು. <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />ತೆ ದಿನಮಾ ನೊಹಾ ವರಿ ತಿನಿ ಬೈಕೊ ತಿನಾ ಬಚ್ಚಾ ಶೆಮ ಹಾಮ ಯೆಫೆತ ವರಿ ಇವನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಹಡಗಾಮಾ ಗಯಾ. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಹರಯಕ್ಕ ಜಾನವರ ವರಿ ಪಶು ವರಿ ಹರಯಕ್ಕ ಜಾತನಾ ಕಿಡಾ ಹರಯಕ್ಕ ಜಾ಼ತನ್ಯೊ ಪಕ್ಷಿ ಹಡಗಾಮಾ ಗಯಾ. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />ವರಿ ಉಸುಲ ಲಿವಾನಿ ಹರಯಕ್ಕ ಜಿವಿ ತಿನಿ ತಿನಿ ಜಾತನಾ ನಿಂಗತ ಜೊಡಿ ಜೊಡಿ ವ್ಹತ್ತಾ. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />ಕ್ಹುದಾ ಕದಲನಿಂಗತ ಆ ಪುರಾ ಜಿವಿ ಹಡಗಾನಾ ಮ್ಹೈ ಗಯಾ ತೆಳಾಮಾ ಯಹೊವಾ ಹಡಗಾನು ಬಾಕಲ ಝಾಕಿ ಪಾಡ್ಯೊ. <verse eid="GEN 7:16" /><verse number="17" style="v" sid="GEN 7:17" />ಜಿಮಿನ್ಪರ ಪಾನಿನು ತುಫಾನ ಚಾಳಕ್ಹ ದಿನ ಲಕ್ಕಾ ವ್ಹತ್ತು. ಪಾನಿ ಚಡತು ಚಡತು ಹಡಗೊ ಉಪ್ಪರ ಆತು ಗಯು. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />ಪಾನಿ ವರಿ ಕಿಮ್ಮ ಕಿಮ್ಮ ಚಡತು ಚಾಲ್ಯುತು ತಿಮ್ಮ ತಿಮ್ಮ ಹಡಗೊ ಉಪ್ಪರ ಚಡತು ಚಾಲ್ಯೊತೊ. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />ಪಾನಿ ಘನ್ನು ಜೊರ ಆಯಲ ಹುತಿ ಮ್ಹೊಟಾ ಮ್ಹೊಟಾ ಡೊಂಗರೊ ಡುಬಿಗಯಾತಾ. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />ಡೊಂಗರೊಬಿ ಪಾನಿಕ್ಹು ಝಕೈ ಗಯಾತಾ ಪಾನಿ ಕಿಮ್ಮ ವ್ಹತ್ತು ಕದ್ಯಾಮ ಡೊಂಗರೊ ಡುಬಿನ ಡೊಂಗರೊತಿ ಇಕ್ಹಪರ ಪಾಂಚ಼ ಪುಟ ಉಪ್ಪರ ವ್ಹತ್ತು. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಹರಯಕ್ಕ ಜಾನವರ ಮರಿಗಯುತು ಕ್ಹಾರಾ ದಾಣ್ಗಾ ವರಿ ಹೆಣ್ಣ ಮನಕ್ಹೊ ಮರಿಗಯಾ ಹರಯಕ್ಕ ಪಕ್ಷಿ ಪಶು ಜಾನವರ ವರಿ ಹರಯಕ್ಕ ಕಿಡಾಮರಿಗಯಾ. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />ಜಿಮಿನಪರ ರ‍್ಹಯಲ ಉಸುಲ ಲಿವಾನು ಹರಿಯಕ್ಲಾ ಮರಿ ಗಯಾ. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />ಅಮ್ಮ ಕ್ಹುದಾ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಹರಯಕ್ಕ ಜಿವ ನಾಶ ಕರಿಪಾಡ್ಯೊ ಹರಯಕ್ಕ ಮನಕ್ಹನೆ ನಾಶಕರಿಪಾಡ್ಯೊ ಹರಯಕ್ಕ ಜಿವ ಹರಯಕ್ಕ ಕಿಡಾ ವರಿ ಪಕ್ಷಿಯೊ ನಾಶಥಯಾ ಕುನ್ನ ವಾಚ್ಯು ಕದ್ಯಾಮ ನೊಹಾನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ತ್ಯುನಾ ಘರವಾಲಾ ವರಿ ತ್ಯುನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ಜಿವ ಜಂತು ಪಕ್ಷಿಯೊ ಕಿಡಾ ಹರಯಕ್ಕ ವಾಚ್ಯಾ. <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />ದೆಡಕ್ಹೊ ದಿನ ಲಕ್ಕಾ ಜಿಮಿನ ಪುರಾ ಪಾನಿಕ್ಹೊ ಝಕೈ ಗೈತಿ.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">ಜಲ ಪ್ರಳಯನು ಅಂತ್ಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />ವರಿ ಕ್ಹುದಾ ನೊಹಾನೆ ವರಿ ಹಡಗಾಮಾನಾ ಕ್ಹಾರಾ ಜಾನವರೊನೆ ಇಕ್ಹರ್ಯೊ ನೈ . ತೆ ವಾರೊ ಅಯೆ ನಿಂಗತ ಕರ‍್ಯೊ ಇಮ್ಮ ಪಾನಿ ಉತರಾನು ಶುರು ಥಯು. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />ಹಬಾಳಮಾನು ಆವಾನು ಪಾನಿ ಹುಬ್ರಯು ಹಬಾಳ ಆವಾನು ಪಾನಿ, ಜಿಮಿನಮಾತಿ ಶಲಿಯೊಮಾತು ಆವಾನು ಪಾನಿ ಹುಬ್ರಯು. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />ಇಮ್ಮ ಯಕ್ಹೊನ ಯವ್ವತ್ತ ದಿನ್ನ ಥಯಲ್ಪರ ಕಮ್ಮ ಥಾತು ಐಯು. <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />ಕ್ಹಾತವಾ ಮ್ಹೈನಾನಾ ಕ್ಹತ್ರಂವಾ ದಿನ್ನೆ ಹಡಗೊ ಅರಾರತ ಕವಾನಾ ಗಾಮನಾ ಡೊಂಗರ ಪರ ಐನ ಹುಬ್ರಯು. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />ಕಿಮ್ಮ ಕಿಮ್ಮ ಪಾನಿ ಕಮ್ಮ ಥಾತು ಐಯು ದಕ್ಹವಾ ಮ್ಹೈನಾನೊ ಯಕ್ವಾ ದಿನ್ನೆ ಕ್ಹಾರಾ ಡೊಂಗರೊನಾ ತುದಿಯೊ ದಿಕ್ಹಾಡಾತಾ. <verse eid="GEN 8:5" /><verse number="6" style="v" sid="GEN 8:6" />ಚಾಳಕ್ಹ ದಿನ ಥಯಲ್ಪರ ನೊಹಾ ಹಡಗಾನಿ ಖಿಡಕಿ ಕಾಡಿನ ದೆಕ್ಯೊ. <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />ನೊಹಾ ಯಕ್ಕ ಕೌಳಾನೆ ಭಾರೊ ಛೊಡ್ಯೊ ಜಿಮಿನ್ಪರ ಪಾನಿ ರ‍್ಹಯಲ ವರಾಯೆಲಕ್ಕಾ ತೆ ಕೌಳೊ ಆವಾ ಜಾ಼ವಾನು ಕರಾಡುತು. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />ತಿನಾಹುತಿ ಜಿಮಿನಪರ ರ‍್ಹಯಲ ಪಾನಿ ಕಮ್ಮ ಥಯು ಸು ನೈ ಕೈನ ದೆಕಾನು ಹುತಿ ನೊಹಾ ಯಕ್ಕ ಕ್ಹಬುತರನೆ ಭಾರೊ ಛೊಡ್ಯೊ. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />ತೆನೈಸೊ ಪಾನಿ ಹಜು಼ನ ಕಮ್ಮ ಥಯು ನ್ಹೊತು, ತಿನಾಹುತಿ ಕ್ಹಬುತರನೆ ಉತರಾನೆ ಕಿಜಾ಼ಜ಼ ಜ಼ಗಾ ಮಳಿ ನೈ. ತಿನಾಹುತಿ ತೆ ಕ್ಹಬುತರ ಉಡತು ಹಡಗಾಮಾ ಐಯು ವರಿ ನೊಹಾ ತಿನೆ ಹತ್ತ್ ಅಗೊ ಕರಿನ ತಿನೆ ಧರಿನ ಹಡಗಾಮಾ ಛೊಡಸ. <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />ಕ್ಹಾತ ದಿನ ಥಯಲ್ಪರ ನೊಹಾ ವರಿ ಕ್ಹಬುತರನೆ ಭಾರೊ ಛೊಡ್ಯೊ. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />ತೆ ದಿನ ಕ್ಹಾಂಜೆ ತೆ ಕ್ಹಬುತರ ನೊಹಾಕನ ಫರಿನ ಐಯು ತಿನಾ ಚೊಂಚಮಾ ಆಲಿವ ಝಾಡುನು ಪಾನ ವ್ಹತ್ತು ತೆ ದೆಕಿನ ನೊಹಾ ಜಿಮಿನ ವರೈಸ ಕೈನ ಕಳಿಲಿದ್ಯೊ. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />ವರಿ ಕ್ಹಾತ ದಿನ ಥಯಲ್ಪರ ನೊಹಾ ವರಿ ಕ್ಹಬುತರನೆ ಛೊಡ್ಯೊ ಮಾತ್ರ ಆ ಟೈಮಾ ತೆ ಕ್ಹಬುತರ ವಾಪಸ ಐಯುಜ ನೈ. <verse eid="GEN 8:12" /><verse number="13" style="v" sid="GEN 8:13" />ತಿನಾಹುತಿ ನೊಹಾ ಹಡಗಾನು ಬಾಕಲ ಕಾಡಿನ ಹೈಬಿ ತಿಬಿ ದೆಕ್ಯೊ ಜಿಮಿನ ವರಾವಾಡಿತಿ ತೆ ದಿನ ಯಕ್ವಾ ವರಕ್ಹನೊ ಯಕ್ವಾ ದಿನ ವ್ಹತ್ತೊ ತೆಳಾಮಾ ನೊಹಾನೆ 601 ವೈಸ ವ್ಹತ್ತಿ. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />ಬೆವಾ ಮ್ಹೈನಾನಾ ಇಕ್ಹಪರ ಕ್ಹಾತವಾ ದಿನ್ನೆ ಜಿಮಿನ ಪುರಾ ವರೈ ಗೈತಿ <verse eid="GEN 8:14" /><verse number="15" style="v" sid="GEN 8:15" />ತೆಳಾಮಾ ಕ್ಹುದಾ ನೊಹಾನೆ <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />ತು ತಾರಿ ಬೈಕೊ ತಾರಾ ಬಚ್ಚಾ ತಾರಾ ವ್ಹೌವೊ ಹಡಗಾಮಾತಾ ಭಾರಾ ಆವೊ. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ಹರಿಯಕ್ಕ ಜಾನವರ ಪಕ್ಷಿಯೊ ವರಿ ಹರಯಕ್ಕ ಕಿಡು ಕಾಟು ಹರಿಯಕ್ಕ ಜುವ ಭಾರು ಆವಾದೆ ತಾರು ಸಂತಾನ ಬಡತು ಜಾ಼ವಾದೆ ಜಿಮಿನ್ಪರ ತ್ಯುನೆ ಪುರಾ ಫೈಲಾದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 8:17" /><verse number="18" style="v" sid="GEN 8:18" />ತಿನಾಹುತಿ ನೊಹಾ ತಿನಿ ಬೈಕೊ ಬಚ್ಚಾ ವರಿ ವ್ಹೌವೊನಾ ಕ್ಹಾತೆ ಹಡಗಾಮಾತೊ ಭಾರೊ ಆಯೊ. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />ತಿನಾ ಪಾಚಾ಼ ಪಾಚಾ಼ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ಹರಯಕ್ಕ ಜಾನವರ ಕಿಡು ಕಾಟು ತ್ಯುನಾ ತ್ಯುನಾ ಜಾ಼ತನಾ ಗುಂಪನಾ ಪ್ರಕಾರ ಪಕ್ಷಿಯೊ ಭಾರಾ ಆಯಾ.<verse eid="GEN 8:19" /></para>
  <para style="s">ನೊಹಾ ದಿದಲ ಬಲಿ</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />ತಿನಾಕ್ಹು ತೆ ನೊಹಾ ಯಹೊವಾನಾ ಹುತಿ ಯಕ್ಕ ಬಲಿನೊ ಕಟ್ಟೊ ಭಾಂದಿನ ಶುದ್ದ ರ‍್ಹಯಲ ದಕ್ಹಾ ಪಶು ಪಕ್ಷಿ ಲಿನ ಕ್ಹುದಾನೆ ಬಲಿನಾ ಕಟ್ಟಾಪರ ಹೊಮ ಕರೊ <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />ತೆ ಬಲಿನಿ ಚೊ಼ಕಿ ಬಾಸ ಕ್ಹುದಾನೆ ಮೆಚ್ಚಿಕೆ ಥೈ. ತೆಳಾಮಾ ಕ್ಹುದಾ ತಿನಾಮಾ ಅಮ್ಮ ಕೈಲಿದ್ಯೊ: ಇತ್ತಿ ಉಪ್ಪರ ಮಿ ಮನಕ್ಹೊನೆ ಶಿಕ್ಷಾ ದಿವಾನಾ ಹುತಿ ಜಿಮಿನೆ ಕ್ಹರಾಪ ನೈ ದೆತೊ. ತೆ ಮನಕ್ಹೊನಾ ವಿಚಾರೊ ನ್ಹಾನಪಂತಾಜ಼ ಕೆಟ್ಟ ವ್ಹೈ. ತಿನಾಹುತಿ ಮಿ ಬಿಜಿಯಕ್ಕ ಸಲಾ ಜಿಮಿನಪರ ರ‍್ಹಯಲ ಹರಯಕ್ಕ ಜಲಮನೆ ನಾಶ ನೈ ಕರತೊ. <verse eid="GEN 8:21" /><verse number="22" style="v" sid="GEN 8:22" />ಜಿಮಿನ ರ‍್ಹಯಲಕ್ಕಾ ಬಿತ್ತಾನೊ-ಕಾಟಾನೊ ದಿನ ರ‍್ಹವಸ ಕೆಳಾಮಾಬಿ ರ‍್ಹವಸ ಥಂಡ-ತಡಕೊ ರ‍್ಹವಸ ಥಂಡನೊ ಕಾಲ-ಪಾನಿನೊ ಕಾಲ ವರಿ ದಿನ್ನ-ರಾತ ಕೆಳಾಮಾಬಿ ರ‍್ಹವಸ ಕೈನ ಕದ್ಯೊ.<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">ನೊಹಾನಾ ಕ್ಹಾತೆ ಕ್ಹುದಾನಿ ಒಡಂಬಡಿಕೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />ಕ್ಹುದಾ ನೊಹಾನೆ ತಿನಾ ಬಚ್ಚಾವೊನೆ ಆಶಿರವಾದ ಕರಿನ ತ್ಯುನೊನೆ, ಘನ್ನಾ ಬಚ್ಚಾವೊನೆ ಜನ್ನಿನ ಜಿಮಿನ್ಪರ ಜಾಸ್ತ ಥಾವೊ. ವರಿ ಕ್ಹಾರಿ ದುನಿಯಾಮಾ ಭರಿ ಜ಼ಾವೊ. <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಹರಯಕ್ಕ ಜಾನವರ, ಹಬಾಳಮಾ ಉಡಾನಾ ಹರಯಕ್ಕ ಪಕ್ಷಿಯೊ, ಜಿಮಿನ್ಪರ ಫರಾನಾ ಹರಯಕ್ಕ ಕಿಡು ವರಿ ಸಮಂದರಮಾ ರ‍್ಹವಾನಾ ಹರಯಕ್ಕ ಮಚಲ್ಯೊ ತುಮೊನೆ ಬುಚ್ಕಿನ ರ‍್ಹವಸ ತೆ ಕ್ಹಾರಾವೊನೆ ಮಾಲಕ ಕರ‍್ಯೊಸ. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />ಜಿಮಿನಪರ ಫರಾನಾ ಕ್ಹಾರಾ ಪೈಲಾ ತುಮೊನೆ ಕ್ಹಾವಾನಾಹುತಿ ಜಾಡೊ ದಿದ್ಯೊ. ಹಮನಾ ತುಮೊನೆ ಕ್ಹಾವಾನಾಹುತಿ ಜಾನವರ ದಿದ್ಯೊಸ. ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಕ್ಹಾರುಜ ತುಮಾರಾಹುತಿ ದಿದ್ಯೊಸ. <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />ಮಿ ತುಮೊನೆ ಸು ಶೆ ಕರುಸ ಕದ್ಯಾಮ ರಗತಕ್ಹು ಮಳಲ ಮಾಕ್ಹ ಕ್ಹಾವೊ ನಕೊ. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />ಕುನ್ನಬಿ ತುಮೊನೆ ಕಲಾಸ ಕರ‍್ಯಾರೆ ಮಿ ತಿನು ಜುವ ಕಾಡಿ ಪಡುಸ. ಕೈಬಿ ಜಾನವರ ಮನಕ್ಹನೆ ಕಲಾಸ ಕರ‍್ಯಾರೆ ಮಿ ತೆ ಜಾನವರನೊ ಜ಼ಲಮ ಕಾಡಿಪಡುಸ <verse eid="GEN 9:5" /><verse number="6" style="v" sid="GEN 9:6" />ಕ್ಹುದಾ ಮನಕ್ಹನೆ ತಿನಾ ಪ್ಲ್ಯಾನ ನಿಂಗತ ತಯಾರ ಕರೊ. ತಿನಾಹುತಿ ಕುನ್ನಬಿ ಮನಕ್ಹನು ರಗತ ಚುವಾವಸ ತಿನು ರಗತ ಮನಕ್ಹಜ ಚುವಾವಸ <verse eid="GEN 9:6" /><verse number="7" style="v" sid="GEN 9:7" />ತುಮೆ ಅಭಿವೃಧ್ದಿಥೈನ ಜಿಮಿನ್ಪರ ಪುರಾ ಭರಿಜಾವೊ ಕೈನ ಕದ್ಯೊ.<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />ನೊಹಾ ತುನೆ ತಾರಾ ಬಚ್ಚಾವೊನೆ ಘನ್ನಾ ಬಚ್ಚಾ ಹುಟ್ಟಾದೆ. <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />ಪಾಚಾ಼ತೊ ಕ್ಹುದಾ ನೊಹಾನೆಬಿ ತಿನಾ ಬಚ್ಚಾವೊನೆ ಮಿ ತುಮೊನೆ ವರಿ ಅಗಾ ಜಿವಿಸಾನೆ ತುಮಾರಾ ಮನಕ್ಹೊನೆ ವಾಗ್ದಾನ ಕರುಸ. <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />ಹಡಗಾಮಾತಾ ಆಯೆಲ ಕ್ಹಾರಾ ಪಕ್ಷಿಯೊ ಕ್ಹಾರಾ ಪಶುವೊ ವರಿ ಪ್ರಾಣಿಯೊನೆ ಮಿ ವಾಗ್ದಾನ ಕರುಸ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಜಿವಿನೆ ವಾಗ್ದಾನ ಕರುಸ. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />ಮಿ ತುಮೊನೆ ಕರಾನು ವಾಗ್ದಾನ ಸುವೈ ಕದ್ಯಾಮ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಜಿವಿಯೊ ಪಾನಿನಾನ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಜಿವಿಯೊನೆ ಹಜಿಯಕ್ಕಮ ನಾಶ ನೈಕರತೊ.ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 9:11" /><verse number="12" style="v" sid="GEN 9:12" />ತೆನೈಸೊ ಕ್ಹುದಾ ಮಾರಾ ವಾಗ್ದಾನೆ ಸಾಕ್ಷಿಥೈನ ಮಿ ತುಮೊನೆ ಯಕ್ಕ ಗುರುತ ದ್ಯುಸ. ಮಿ ತುಮಾರಾ ಕ್ಹಾತೆ ವರಿ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಹರಿಯಕ್ಕ ಜಿವಿನಾ ಕ್ಹಾತೆ ವಡಂಬಡಿಕೆ ಕರಿಲಿವಾನು ಆ ಗುರುತ ದಿಕ್ಹಸ. ಆ ಗುರುತ ಕೆಳಾಮಾಬಿ ರ‍್ಹವಸ. <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />ಮಿ ಮ್ಹಾಡೊಮಾ ಮ್ಹೆಲೆಲ ಕಾಮನಬಿಲ್ಲ ಮನೆ ಜಿಮಿನೆ ಥಯಲ ವಡಂಬಡಿಕೆ ಗುರುತಥಾವಸ. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />ಮಿ ಮ್ಹಾಡನೆ ಜಿಮಿನ್ಪರ ಕವಿಸುವಾಗ ಮ್ಹಾಡಮಾ ಕಾಮನಬಿಲ್ಲ ದೆಕೊಸಿ. <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />ಮಿ ಆ ಕಾಮನಬಿಲ್ಲ ದೆಕತಾಮಾ ಮನೆಬಿ ತುಮೊನೆ ವರಿ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಜಿವಿಯೊನೆ ಥಯಲ ವಡಂಬಡಿಕೆ ಸೆ ಕರಲ್ಯುಸ ಪಾನಿನು ತುಫಾನ ಕೆಳಾಮಾಜ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಕ್ಹಾರಾಬ ಜಿವಿಯೊನೆ ನಾಶನೈಕರತೊ ಕವಾನು ಆ ವಡಂಬಡಿಕೆ. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />ಮಿ ಮ್ಹಾಡೊಮಾ ರ‍್ಹಯಲ ಕಾಮನಬಿಲ್ಲನೆ ದೆಕತಾಮಾ ಶಾಶ್ವತಥಯಲ ಆ ವಡಂಬಡಿಕೆ ಸೆ ಕರಲ್ಯುಸ ಮನೆಬಿ ವರಿ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಹರಿಯಕ್ಕ ಜಿವಿಯೊನೆ ಥಯಲ ವಡಂಬಡಿಕೆ ಸೆ ಕರಲ್ಯುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 9:16" /><verse number="17" style="v" sid="GEN 9:17" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ನೊಹಾನೆ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಜಿವಿಯೊನಾ ಕ್ಹಾತೆ ಮಿ ಕರಿಲಿದಲ ವಡಂಬಡಿಕೆನೆ ಆ ಕಾಮನಬಿಲ್ಲ ಗುರುತ ಥಾವಸ ಕೈನ ಕದ್ಯೊ.<verse eid="GEN 9:17" /></para>
  <para style="s">ನೊಹಾ ವರಿ ತಿನಾ ಬಚ್ಚಾ಼</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />ನೊಹಾನಾ ಗಂಡ ಬಚ್ಚಾ ನೊಹಾನಾ ಕ್ಹಾತೆ ಹಡಗಾಮಾತಾ ಭಾರಾ ಆಯಾ.ತ್ಯುನಾ ನಾಮೊ ಶೆಮ, ಹಾಮ,ವರಿ ಯೆಫೆತ (ಹಾಮ ಕಾನಾನನೊ ಬಾ ವ್ಹೈ.) <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />ಆ ತನ್ನ ಜ಼ನಾ ಗಂಡ ಬಚ್ಚಾ ವ್ಹೈ. ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಅವನೆಜ ಮೂಲ ದಾಣ್ಗಾ ವ್ಹೈ. <verse eid="GEN 9:19" /><verse number="20" style="v" sid="GEN 9:20" />ನೊಹಾ ರೈತ ಥಯೊ ತೆ ಯಕ್ಕ ದ್ರಾಕ್ಷಿನೊ ಬಗಿಚೊ ಕರ‍್ಯೊ. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />ಯಕ್ಕಮ ತೆ ದ್ರಾಕ್ಷನೊ ರಕ್ಹ ಪಿನ ನಶಾ ಥಯಲಕ್ಹು ತಿನಾ ಗುಡಾರಮಾ ಭೊಂಗಳೊ ಕ್ಹುರಯೊ. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />ಕಾನಾನನೊ ಬಾ ಥಯಲ ಹಾಮ ತಿನಬಾ ಭೊಂಗಳೊ ಕ್ಹುರಯೆಲ ದೆಕಿನ ಗುಡಾರನಾ ಭಾರಾ ರ‍್ಹಯಲ ತಿನಾ ಭಾಯೊನೆ ತಿಳಸ್ಯೊ. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />ತೆಳಾಮಾ ಶೆಮ್ ವರಿ ಯೆಫೆತ ಯಕ್ಕ ಝಾಡಿ ತ್ಯುನಾ ಪಿಟ್ಟಪರ ಘಾಲಿನ ಮ್ಹೊಡು ಪಾಚೊ ಫರೈಲಿನ ಗುಡಾರಮಾ ಐನ ಅಪನಾ ಬಾನೆ ವರಾಡ್ಯಾ ತ್ಯುನೆ ತಿನು ಉಗಾಡು ಅಂಗ ದೆಕ್ಯಾ ನೈ. <verse eid="GEN 9:23" /><verse number="24" style="v" sid="GEN 9:24" />ಪಾಚಾ಼ತೊ ನೊಹಾ ಹುಶಾರ ಥಯೊ ನ್ಹಾನೊ ದಿಕ್ರೊ ಹಾಮ ಸು ಕರ‍್ಯೊ ಕೈನ ತಿನೆ ತಿಳದ್ಯು. <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />ತಿನಾಹುತಿ ನೊಹಾ ಕಾನಾನ ತಿನಾ ಭಾಯೊನೆ ಕಿಳನಾ ಗುಲಾಮೊ ಥಾವೊ'‘ಕೈನ ಕ್ಹರಾಪ ದಿದ್ಯೊ. <verse eid="GEN 9:25" /><verse number="26" style="v" sid="GEN 9:26" />ತೆನೈಸೊ ನೊಹಾ ಶೆಮನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಸ್ತೊತ್ರ ಥಾವಾದೆ ಕಾನಾನ ಶೆಮನೊ ಗುಲಾಮ ಥಾವಾದೆ. <verse eid="GEN 9:26" /><verse number="27" style="v" sid="GEN 9:27" />ಕ್ಹುದಾ ಯೆಫೆತನೆ ಹೆಚ್ಕಿ ಜಿಮಿನ ದಿವಾದೆ. ಶೆಮನಾ ಗುಡಾರೊಮಾ ಕ್ಹುದಾ ವಾಸಕರಾದೆ ವರಿ ಕಾನಾನಬಿ ತ್ಯುನೊನೆ ಗುಲಾಮ ಥಾವಾದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 9:27" /><verse number="28" style="v" sid="GEN 9:28" />ಪಾನಿನು ತುಫಾನ ಥಯಲ್ಪರ ನೊಹಾ ತನಕ್ಹೊನಐವತ್ತ ವರಕ್ಹ ಜುತೊ ವ್ಹತ್ತೊ. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />ನೊಹಾ ಒಟ್ಟಜ ನೌಕ್ಹೊನ ಐವತ್ತ ವರಕ್ಹ ಜುತೊ ರ‍್ಹೈನ ಮರ‍್ಯೊ.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">ನೊಹಾನಾ ಬಚ್ಚಾ಼ವೊನಿ ಸಂತತಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />ನೊಹಾನಾ ದಿಕ್ರಾ ಶೆಮ ಹಾಮ ವರಿ ಯೆಫೆತ ಪಾನಿನು ತುಫಾನ ಹುಬ್ರಯಲ್ಪರ ಆ ತನ್ನೆ ದಿಕ್ರಾವೊನೆ ದಿಕ್ರಾ ಹುಟ್ಯಾ. ಶೆಮ ಹಾಮ ಯೆಫೆತನೆ ಹುಟ್ಟಲ ದಿಕ್ರಾ; <verse eid="GEN 10:1" /><verse number="2" style="v" sid="GEN 10:2" />ಯಫೆತನೆ ಹುಟ್ಟಲ ದಿಕ್ರಾ ಕುನ್ನ ಕುನ್ನ ವ್ಹೈ ಕದ್ಯಾಮ ಗೊಮೆರ, ಮಾಗೊಗ, ಮಾದ್ಯ, ಯಾವಾನ, ತುಬಲ, ಮೆಷೆಕ್ ವರಿ ತಿರಾಸ <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />ಗೊಮೆರನೆ ಹುಟ್ಟಲ ದಿಕ್ರಾ ಅಷ್ಕೆನಸ, ರಿಫತ ವರಿ ತೊಗರ್ಮ. <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />ಯಾವಾನನೆ ಹುಟ್ಟಲ ದಿಕ್ರಾ ಎಲಿಷಾ, ತಾರ್ಷಿಸ, ಕಿತ್ತಿಮ ವರಿ ದೊದಾನಿಮ. <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />ಸಮುದ್ರನಾ ಬಗಲ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ಪುರಾ ಯೆಫೆನಾ ಘರದಾನಾನಾ ವ್ಹೈ ತಿನಾ ಹರಯಕ್ಕ ದಿಕ್ರಾ ಕನ ತ್ಯುನಿ ಕ್ಹುದನಿ ಜಿಮಿನ (ಜ಼ಗಾ) ವ್ಹತ್ತಿ ತ್ಯುನು ಘರದಾನು ತಿಮ್ಮ ಬಡತು ಗೈನ ತ್ಯುನಾಮಾಜ ಘನ್ನಾ ಘರದಾನಾ ಥಯಾ.ಹರಯಕ್ಕ ಘರದಾನಾನೆ ತ್ಯುನಿ ಕ್ಹುದನಿ ಕವಾನಿ ಜಾತ ವ್ಹತ್ತಿ <verse eid="GEN 10:5" /><verse number="6" style="v" sid="GEN 10:6" />ಹಾಮನಾ ದಿಕ್ರಾ ಕುನ್ನ-ಕುನ್ನ ವ್ಹೈ ಕದ್ಯಾಮ ಕುಷ, ಮಿಚ್ರಯಿಮ, ಪುತ ವರಿ ಕಾನಾನ. <verse eid="GEN 10:6" /><verse number="7" style="v" sid="GEN 10:7" />ಕುಷನಾ ದಿಕ್ರಾ ಸೆಬಾ, ಹವಿಲ, ಸಬ್ತಾ, ರಗ್ಮ ವರಿ ಸಬ್ತಕಾ. ರಗ್ಮನಾ ದಿಕ್ರಾ ಶೆಬಾ ವರಿ ದೆದಾನ. <verse eid="GEN 10:7" /><verse number="8" style="v" sid="GEN 10:8" />ಕುಷನೆ ನಿಮ್ರೊದ ಕವಾಲೊ ದಿಕ್ರೊ ವ್ಹತೊ ನಿಮ್ರೊದ ಘನ್ನೊ ತಾಕತ್ವರ ವ್ಹತೊ ವರಿ ತೆ ಆ ಜಿಮಿನ್ಪರ ತೆ ಪೈಲಾನೊ ಘನ್ನೊ ತಾಕತವರ ಥಯೊ. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />ಯೆಹೊವನಾ ಕ್ಹಾಮೊ ತೆ ಘನ್ನೊ ಚುರುಕ ಶಿಕಾರಿ ವ್ಹತ್ತೊ. ತಿನಾಹುತಿ ಮನಕ್ಹೊ ಬಿಜಾ಼ವೊನೆ ಸುಬಿ ಕೌ ಕದ್ಯಾಮ ತಿನೆ ಮಳೈನ ಕವಸ ‘ ದೆಕ ಐಲೊ ನಿಮ್ರೊದನಾ ನಿಂಗತ ಯಹೊವಾನಾ ಕ್ಹಾಮೊ ಘನ್ನೊ ಚುರುಕ ಶಿಕಾರಿ ವ್ಹೈ’ <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />ನಿಮ್ರೊದನು ದರ್ಬಾರ ಶಿರಾನ ದೆಶಮಾ ರ‍್ಹಯಲ ಬಾಬಿಲೊನಮಾ ಯೆರೆಕಮಾ ಅಕ್ಕದ ವರಿ ಕಲ್ನೆ ಕವಾನಾ ಗಾಮೊಮಾ ಶುರು ಥಯು. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />ನಿಮ್ರೊದ ಅಶ್ಯುರನೆಬಿ ಗಯೊ. ಅಶ್ಯುರಮಾ ನಿನೆವೆ, ರೆಹೊಬೊತಿರ, ಕೆಲಹ ವರಿ ರೆಸೆನ್ ಕವಾನಾ ಗಾಮೊ ಭಾಂದ್ಯೊ. <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />ರೆಸೆನ ಕವಾನು ಗಾಮ ನಿನೆವೆನಾಬಿ ಮ್ಹೊಟು ಗಾಮ ರ‍್ಹಯಲ ಕೆಲಹನಾ ವಚ್ಮಾ ಶೆ. <verse eid="GEN 10:12" /><verse number="13" style="v" sid="GEN 10:13" />ಮಿಚ್ರಿಯಿಮ ಲುದ, ಅನಾಮ, ಲೆಹಾಬ, ನಪ್ತಹ, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />ಪತ್ರುಸ, ಕಸ್ಲುಹ್ಯ ವರಿ ಕಪ್ತೊರ್ಯನೊ ಬಾ ವ್ಹೈ. ಕಸ್ಲುಹ್ಯವಾಲಾ ಪಿಲಿಷ್ಟಿವಾಲಾವೊನಾ ಪಿತೃ ವ್ಹೈ. <verse eid="GEN 10:14" /><verse number="15" style="v" sid="GEN 10:15" />ಕಾನಾನ ಸಿದೊನನೊ ಬಾ ವ್ಹೈ. ಕಾನಾನನೊ ಪೈಲಾವಾ ದಿಕ್ರೊಜ ಸಿದೊನ ವ್ಹೈ. ಆ ಸಿದೊನ ಹಿತ್ತಿಯೊನೊ ಮೂಲ ಪಿತೃ ವ್ಹೈ <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />ಕಾನಾನ ಯೆಬುಸಿಯೊನೆ, ಅಮ್ಮೊರಿಯೊನೆ, ಗಿರ್ಗಾಷಿಯೊನೆ, ಹಿವ್ವಿಯೊ, ಅರ್ಕಿಯೊನೆ, ಸಿನಿಯೊನೆ, ಅರ್ವಾದಿಯೊನೆ, ಚೆಮಾರಿಯೊನೆ ವರಿ ಹಮಾತಿಯೊನೆ ಮೂಲಪುರುಷ ವ್ಹೈ. <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />ಕಾನಾನನಾ ಘರವಾಲಾ ಪುರಾ ಜಗತನಾ ಹರಯಕ್ಕ ಜ಼ಗಾವೊಮಾ ಫಲಿ ಗಯಾತಾ <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />ಕಾನಾನಿ ಸಿಮಾ ಸಿದೊನತಿ ಉಆತ್ತರನಾ ಬಗಲ ಗೆರಾರಿನಾ ದಕ್ಷಿಣತಕಾ, <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />ಗಾಜಾತಿ ಧರಿನ ಪುರ್ವನಾ ಸೊದೊಮಗೊಮೊರ ಗಾಮಲಕಾ, ಅದ್ಮಾ ವರಿ ಚೆನೊಯಿಮತಿ ಧರಿನ ಲೆಷಾನಾಲಕಾ ಫೈಲಿತಿ. <verse eid="GEN 10:19" /><verse number="20" style="v" sid="GEN 10:20" />ತ್ಯುನೆ ಕ್ಹಾರಾ ಹಾಮನಾ ಘರದಾನಾನಾ ವ್ಹೈ. ತೆ ಘರದಾನಾನಾ ಮನಕ್ಹೊ ಹರಯಕ್ಕಲಾ ತ್ಯುನುಜ ಕವಾನು ತ್ಯುನೊನೆ ಗಾಮ ವ್ಹತ್ತು ವರಿ ಕ್ಹಾರಾವೊನೆ ತ್ಯುನಿಜ ಕವಾನಿ ಯಕ ಜಾತ ವ್ಹತ್ತಿ. ತ್ಯುನೆ ತ್ಯುನುಜ ಕವಾನು ಯಕ ಯಕ ಖಾಂದಾನ ಥಯಾ <verse eid="GEN 10:20" /><verse number="21" style="v" sid="GEN 10:21" />ಶೆಮ ಯೆಫೆತನೊ ಮ್ಹೊಟೊ ಭೈ ವ್ಹೈ. ಶೆಮನಾ ಖಾಂದಾನಮಾ ಎಬರಬಿ ಯಕ್ಲೊ ವ್ಹೈ ಎಬರ ಹಿಬ್ರುನೊ ಮುಲ ಪಿತೃ ವ್ಹೈ <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />ಶೆಮನಾ ದಿಕ್ರಾ ಎಲಾಮ್, ಅಶ್ಶು, ಅರ್ಪಕ್ಷದ್, ಲುದ್ ವರಿ ಅರಾಮ್ ವ್ಹೈ. <verse eid="GEN 10:22" /><verse number="23" style="v" sid="GEN 10:23" />ಅರಾಮನಾ ದಿಕ್ರಾ ಉಸ್, ಹುಲ್, ಗೆತೆರ್ ವರಿ ಮಷ್ ವ್ಹೈ. <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />ಅರ್ಪಕ್ಷದ ಶೆಲಹನೊ ಬಾ ವ್ಹೈ, ಶೆಲಹ ಎಬರನೊ ಬಾ ವ್ಹೈ. <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />ಎಬರನೆ ಬೆ ದಿಕ್ರಾ ವ್ಹತ್ತಾ. ತಿನೊ ಪೈಲಾವಾ ದಿಕ್ರೊ ಹುಟ್ಟತಾಮಾ ಪುರಾ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಖಾಂದಾನೊ ಬಿಜಾ಼ ಬಿಜಾ಼ ಥಯಲಕ್ಹು ತಿನೆ ಫೆಲೆಗ್ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯಾ, ತಿನಾ ಬೆವಾ ದಿಕ್ರಾನು ನಾಮ ಯೊಕ್ತಾನ ವ್ಹೈ <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />ಯೊಕ್ತಾನಾ ದಿಕ್ರಾ ಅಲ್ಮೊದಾದ್, ಶೆಲೆಪ್, ಹಚರ್ಮಾವೆತ್ ವರಿ ಯೆರಹ, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />ಹದೊರಾಮ, ಉಜಾಲ್, ದಿಕ್ಲಾ. <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />ಓಬಾಲ್, ಅಬಿಮಯೆಲ್, ಶೆಬಾ, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />ಓಫಿರ್, ಹವಿಲ ವರಿ ಯೊಬಾಬ್. <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />ಅವ್ನೆ ಕ್ಹಾರಾ ಮೆಶಾ ಸಿಮಾತಾ ಧರಿನ ಪುರ್ವನಾ ಡೊಂಗರನಾ ಜ಼ಗಾ ವ್ಹತ್ತಾ, ಸೆಫಾರನೆ ಜಾವಾನಿ ವಾಟ್ಮಾ ಮೆಶಾನು ಸಿಮಾ ವ್ಹತ್ತು. <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />ಅವ್ನೆ ಕ್ಹಾರಾ ಶೆಮನಾ ಘರದಾನಾನಾ ವ್ಹೈ. ಅವ್ನೆ ಕ್ಹಾರಾ ಜ಼ನಾ ತ್ಯುನು ಘರದಾನಾನಾ ವರಿ ತ್ಯುನಿ ಜಾತನಾ, ತ್ಯುನಾ ತ್ಯುನಾ ದೆಶನಾ ತ್ಯುನು ಖಾಂದಾನಾ ನಿಂಗತ ಫೈಲ್ಯಾ. <verse eid="GEN 10:31" /><verse number="32" style="v" sid="GEN 10:32" />ನೊಹನಾ ದಿಕ್ರಾವೊಕ್ಹು ಹುಟ್ಟಲ ಖಾಂದಾನ ವ್ಹೈ ಆ.ತ್ಯುನೆ ತ್ಯುನಾ ಘರದಾನಾ ಪ್ರಕಾರ ಫೈಲ್ಯಾ. ಪಾನಿನು ತುಫಾನ ಹುಬ್ರಯಲ್ಪರ ಜಿಮಿನ ಪುರಾ ಫೈಲಲ ಆಜ ಖಾಂದಾನನಾ ವ್ಹೈ.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">ತಾರು ಮಾರು ಥಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />ಪಾನಿನು ತುಫಾನ ಥಯಲ್ಪರ ಜಿಮಿನನಾ ಕ್ಹಾರಿ ಜ಼ಗಾ ಮನಕ್ಹೊ ಪುರಾ ಯಕ್ಕ ಜಾತಮಾ ಬೊಲತಾತಾ. ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಯಕ್ಕ ಜಾತನಾ ವಾತೊ ಬೊಲತಾತಾ. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />ಮನಕ್ಹೊ ಪುರ್ವ ದಿಕ್ಕೆ ಐನ ಸಿನಾರ ಕವಾನಾ ಗಾಮಾ ತ್ಯಾ ಜ಼ಗಾ ದೆಕಿನ ತ್ಯಾಜ ರ‍್ಹಯಾ <verse eid="GEN 11:2" /><verse number="3" style="v" sid="GEN 11:3" />ಯಕ್ಲಾನೆ ಯಕ್ಲೊ ಬೊಲ್ಲೆತಾ ಆವೊ ಮಳಿನ ಚೊ಼ಕಾ ಇಟಂಗಿಯೊ ಕರಿಯೆ ಕೈನ ಫೈಸಲೊ ಕರ‍್ಯಾ ಇಮ್ಮ ತ್ಯುನೆ ಘರೊ ಭಾಂದಾನಾ ಹುತಿ ದಗ್ಡಾ ಲಿದ್ಯಾ ಬಗರ ಇಟಂಗಿಯೊ, ಚು಼ನ್ನಾನಾ ಬದಲಿ ಡಾಂಬರ ಉಪಯೊಗ ಕರ‍್ಯಾ. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />ತಿನಾಹುತಿ ತ್ಯುನೆ ಹಮೆ ಅಪೊನೆ ಯಕ್ಕ ಗಾಮನೆ ಹಬಾಳ ಮುಟ್ಟಾನು ಡೊಂಗರ ಭಾಂದ್ಯಾರೆ ಅಪೆ ಪ್ರಸಿದ್ದಿ ಥೈಯೆಸ ತೆಳಾಮಾ ಅಪೆ ಜಿಮಿನ್ಪರ ಬಿಜಾ಼ ಬಿಜಾ಼ ಥೈನ ಯಕ್ಕ ಜ಼ಗಾಪರ ರ‍್ಹವಾನೆ ಸಾದ್ಯಥಾವಸ ಕೈನ ಬೊಲಿದ್ಯಾ. <verse eid="GEN 11:4" /><verse number="5" style="v" sid="GEN 11:5" />ಕ್ಹುದಾ ಗಾಮನೆ ವರಿ ಡೊಂಗನೆ ದೆಕಾನೆ ಉತ್ರಿನ ಆಯೊ. ಮನಕ್ಹೊ ತೆ ಕ್ಹಾರು ಭಾಂದೆಲ ದೆಕಿನ <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />ಕ್ಹುದಾ ಆ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಯಕ್ಕಜ಼ ಜಾತ ಬೊಲಾನಾಹುತಿ ಘನ್ನಾಜ಼ನಾ ಮಳ್ಯಾಸ. ಪೈಲಾತಾಜ ಹವಾ ಕಾರಯೊ ಕರಾಡಾಸ ಐನೆ ಅಗಾ ಸುಬಿ ಚಾ಼ಯೆ ಥಯಾಮ ಕರಾನೆ ಶಕ್ತಿವಾಲಾ ಥಾವಸ. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />ತಿನಾಹುತಿ ಹಮೆ ಹೆಟಾ ಗೈನ ತ್ಯುನಿ ಜಾತ ತಾರು ಮಾರು ಕರೆ ತಳಾಮಾ ತ್ಯುನೆ ಯಕ್ಕಲಾನೆ ಯಕ್ಕಲೊ ನೈ ಕಳೈಲೆತಾ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 11:7" /><verse number="8" style="v" sid="GEN 11:8" />ಲಾಸ್ಟಮಾ ಕ್ಹುದಾ ಮನಕ್ಹೊನೆ ಜಿಮಿನ್ಪರ ಬಿಖರೈಪಾಡ್ಯೊ.ತಿನಾಹುತಿ ತೆ ಗಾಮನೆ ಭಾಂದಿನ ಪುರಾ ಕರಾನೆ ಸಾದ್ಯ ಥೈ ನೈ. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />ಕ್ಹುದಾ ಕ್ಹಾರಾ ಲೊಕನಿ ಜಾತ ತಾರು ಮಾರು ಕರಲ ತೆ ಜ಼ಗಾಪರ ತಿನಾಹುತಿ ತೆ ಜ಼ಗಾನೆ ಬಾಬೆಲ ಕೈನ ನಾಮ ಐಯು.ಅಮ್ಮ ಕ್ಹುದಾ ಮನಕ್ಹೊನೆ ತೆ ಜ಼ಗಾಕಂತೊ ಜಿಮಿನ್ಪರ ಭಿಕ್ಹರೈಪಾಡ್ಯೊ.<verse eid="GEN 11:9" /></para>
  <para style="s">ಶೆಮನು ಖಾಂದಾನ</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />ಆಶೆಮನಾ ಕ್ಹಾಂದಾನು ಇತಿಹಾಸ ವ್ಹೈ. ಪಾನಿನು ತುಫಾನ ಥೈನ ಬೆ ವರಕ್ಹ ಥಯಲ್ಪರ ಶೆಮ ಕ್ಹೊ ವರಕ್ಹನೊ ರ‍್ಹತಾಮಾ ಅರ್ಪಕ್ಷದ ಕೈನ ದಿಕ್ರೊ ಹುಟ್ಟ್ಯೊ. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />ತೆ ಥಯಲ್ಪರ ಶೆಮ ಪಾಂಚಕ್ಹೊ ವರಕ್ಹ ವಾಚ್ಯೊ.ತೆ ಗಂಡ ವರಿ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ಪಡದ್ಯೊ. <verse eid="GEN 11:11" /><verse number="12" style="v" sid="GEN 11:12" />ಅರ್ಪಕ್ಷದ 35 ವರಕ್ಹನೊ ರ‍್ಹತಾಮಾ ಶೆಲಹ ಕೈನ ದಿಕ್ರೊ ಹುಟ್ಟ್ಯೊ. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />ಶೆಲಹ ಹುಟ್ಟಲ್ಪರ ಅರ್ಪಕ್ಷದ 403 ವರಕ್ಹ ವಾಚ್ಯೊ. ತೆ ಟೈಮಾ ತಿನೆ ಗಂಡ ವರಿ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ಪಡದ್ಯೊ. <verse eid="GEN 11:13" /><verse number="14" style="v" sid="GEN 11:14" />ಶಲಹ 30 ವರಕ್ಹನೊ ರ‍್ಹತಾಮಾ ಎಬರ ಕೈನ ದಿಕ್ರೊ ಹುಟ್ಟ್ಯೊ. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />ಎಬರ ಹುಟ್ಟಲ್ಪರ ಶೆಲಹ 403 ವರಕ್ಹ ವಾಚ್ಯೊತೊ.ತೆ ದಿನೊಮಾ ತೆ ಗಂಡ ವರಿ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ಪಡದ್ಯೊ. <verse eid="GEN 11:15" /><verse number="16" style="v" sid="GEN 11:16" />ಎಬರ 34 ವರಕ್ಹನೊ ರ‍್ಹತಾಮಾ ಪೆಲೆಗ ಕೈನ ದಿಕ್ರೊ ಹುಟ್ಟ್ಯೊ. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />ಪೆಲೆಗ ಹುಟ್ಟಲ್ಪರ ಎಬರ 430 ತಿ ಹೆಚ್ಕಿ ವರಕ್ಹ ವಾಚ್ಯೊತೊ.ತೆ ಟೈಮಾ ತಿನೆ ಬಿಜಾ಼ ಗಂಡ ವರಿ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ಪಡದ್ಯೊ. <verse eid="GEN 11:17" /><verse number="18" style="v" sid="GEN 11:18" />ಪೆಲೆಗ 30 ವರಕ್ಹನೆ ರ‍್ಹತಾಮಾ ರೆಗುವ ಕೈನ ದಿಕ್ರೊ ಹುಟ್ಟ್ಯೊ. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />ರೆಗುವ ಹಟ್ಟಲ್ಪರ ಪೆಲೆಗ 209 ವರಕ್ಹ ವಾಚ್ಯೊತೊ ತೆ ಟೈಮಾ ತಿನೆ ಬಿಜ ಗಂಡ ವರಿ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ಪಡದ್ಯೊ. <verse eid="GEN 11:19" /><verse number="20" style="v" sid="GEN 11:20" />ರೆಗುವ 32 ವರಕ್ಹನೊ ರ‍್ಹತಾಮಾ ಸೆರುಗ ಕೈನ ದಿಕ್ರೊ ಹುಟ್ಟ್ಯೊ. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />ಸೆರುಗಹುಟ್ಟಲ್ಪರ ರೆಗುವ 207 ವರಕ್ಹ ವಾಚ್ಯೊತೊ.ತೆ ಟೈಮಾ ತಿನೆ ಗಂಡ ವರಿ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ಪಡದ್ಯೊ. <verse eid="GEN 11:21" /><verse number="22" style="v" sid="GEN 11:22" />ಸೆರುಗ 30 ವರಕ್ಹನೊ ರ‍್ಹತಾಮಾ ನಾಹೊರ ಕೈನ ದಿಕ್ರೊ ಹುಟ್ಟ್ಯೊ. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />ನಾಹೊರ ಹುಟ್ಟಲ್ಪರ ಸೆರುಗ 200 ವರಕ್ಹ ವಾಚ್ಯೊತೊ. ತೆ ಟೈಮಾ ತಿನಾ ಬಿಜಾ಼ ಗಂಡ ವರಿ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ಪಡದ್ಯೊ. <verse eid="GEN 11:23" /><verse number="24" style="v" sid="GEN 11:24" />ನಾಹೊರ 29 ವರಕ್ಹನೊ ರ‍್ಹತಾಮಾ ತೆರಹ ಕೈನ ದಿಕ್ರೊ ಹುಟ್ಟ್ಯೊ. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />ತೆರಹ ಹುಟ್ಟಲ್ಪರ ನಾಹೊರ 119 ವರಕ್ಹ ವಾಚ್ಯೊತೊ.ತೆ ಟೈಮಾ ತೆ ಬಿಜಾ಼ ಗಂಡ ವರಿ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ಪಡದ್ಯೊ. <verse eid="GEN 11:25" /><verse number="26" style="v" sid="GEN 11:26" />ತೆರಹ 70 ವರಕ್ಹನೊ ರ‍್ಹತಾಮಾ ಅಬ್ರಾಮ ನಾಹೊರ ವರಿ ಹಾರಾನ ಕೈನ ದಿಕ್ರಾವೊನೆ ಪಡದ್ಯೊ.<verse eid="GEN 11:26" /></para>
  <para style="s">ಅಬ್ರಹಾಮನಿ ಚರಿತ್ರೆ</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />ತೆರಹಾನು ಕ್ಹಾಂದಾನು ಇತಿಹಾಸ ವ್ಹೈ.ತೆರಹ ಅಬ್ರಾಮ ನಾಹೊರ ವರಿ ಹಾರಾನ ತ್ಯುನೊ ಬಾ ವ್ಹೈ.ಹಾರಾನ ಲೊಟನ ಬಾ ವ್ಹೈ <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />ಹಾರಾನ ಬಾಬಿಲೊನಿ ತಿನಿ ಸ್ವಂತ ಜ಼ಗಾ ವ್ಹತ್ತಿ ಉರ ಕೈನ ಗಾಮಾ ಮರಿಗಯೊ. ಹಾರಾನ ಮರತಾಮಾ ತಿನೊ ಬಾ ಹಜು಼ನಬಿ ಜ್ಯುತೊ ವ್ಹತ್ತೊ. <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />ಅಬ್ರಾಮ ವರಿ ನಾಹೊರ ಹಿವಾ ಕರಲಿದ್ಯಾ ಅಬ್ರಾಮನಿ ಬೈಕೊನೊ ನಾಮ ಸಾರಯಳ ವ್ಹೈ. ನಾಹೊರನಿ ಬೈಕೊನೊ ನಾಮ ಮಿಲ್ಕಾ ವ್ಹೈ. ಆ ಹಾರಾನನಿ ದಿಕ್ರಿ ವ್ಹೈ ಹಾರಾನ ಮಿಲ್ಕಾ ವರಿ ಇಸ್ಕ ಕವಾಲಾನೊ ಬಾ ವ್ಹೈ. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />ಸಾರಯಳನೆ ಬಚ್ಚಾ ನ್ಹೊತಾ ಕಾಕದ್ಯಾಮ ತೆ ಬಂಜೆ ಥಯಿತಿ. <verse eid="GEN 11:30" /><verse number="31" style="v" sid="GEN 11:31" />ತೆರಹಾ ತಿನಾ ಕ್ಹಾಂದಾನೆ ಬಲೈಲಿನ ಬಾಬಿಲೊನ ಉರ ಕವಾನು ಸ್ವಂತ ಗಾಮ ಛೊಡಿನ ಗೈನ ಕಾನಾನ ನೆ ಪ್ರಯಾಣ ಕರ‍್ಯಾ ತೆರಹಾನೊ ದಿಕ್ರೊ ಥಯಲ ಅಬ್ರಾಮ ತಿನೊ ನಾತನೊ ಹಾರಾನೆಬಿ ದಿಕ್ರೊ ಥಯಲ ಲೊಟಾನೆಬಿ ವರಿ ಮಾರಿ ವ್ಹೌ ಅಬ್ರಾಮನಿ ಬೈಕೊ ತಯಲ ಸಾರಯಳನೆ ಬಲೈಲಿನ ಹಾರಾನ ಗಾಮೆ ಗೈನ ತ್ಯಾ ರ‍್ಹವಾನೆ ಫೈಸಲೊ ಕರ‍್ಯಾ. <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />ತೆರಹಾ 205 ವರಕ್ಹ ವಾಚಿನ ಹಾರಾನ ಗಾಮಾಜ ಮರಿ ಗಯೊ.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">ಕ್ಹುದಾ ಅಬ್ರಾಮನೆ ಬಲಾಯೆಲ</para>
  <para style="m">
    <verse number="1" style="v" sid="GEN 12:1" />ಯಹೊವಾ ಅಬ್ರಾಮನೆ ತಾರು ದೆಶ ವರಿ ತಾರಾ ಮನಕ್ಹೊನೆ ಛೊಡಿನ ಜಾ಼ ತಾರಾ ಬಾನು ಖಾಂದಾನಾ ಛೊಡಿನ ಮಿ ದೆಕಾಡಾನಾ ಗಾಮೆ ಜಾ಼ <verse eid="GEN 12:1" /><verse number="2" style="v" sid="GEN 12:2" />ಮಿ ತಾರು ಮ್ಹೊಟು ದೆಶ ಕರುಸ, ತುನೆ ಆಶಿರ್ವಾದ ಕರುಸ, ತಾರು ನಾಮ ಮ್ಹೊಟು ಕರುಸ, ತು ಆಶಿರ್ವಾದ ಥೈನ ರ‍್ಹಶಿ. <verse eid="GEN 12:2" /><verse number="3" style="v" sid="GEN 12:3" />ತುನೆ ಆಶಿರ್ವಾದ ಕರಾವಾಲಾವೊನೆ ಆಶಿರ್ವಾದ ಕರುಸ, ತುನೆ ಕೆಟ್ಟ ನಜ಼ರಕ್ಹು ದೆಕಲವಾಲಾನೆ ಮಿ ಶ್ರಾಪ ದ್ಯುಸ. ತಾರಾಕ್ಹು ಭುಲೊಕಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಖಾಂದಾನವಾಲಾವೊನೆ ಮಿ ಆಶಿರ್ವಾದ ದ್ಯುಸ ಕದ್ಯೊ. <verse eid="GEN 12:3" /><verse number="4" style="v" sid="GEN 12:4" />ತಿನಾಹುತಿ ಅಬ್ರಾಮನ ಕ್ಹುದಾನೆ ವಿಧೆಯ ಥಯೊ. ತೆ ಹಾರಾನ ಗಾಮ ಛೊಡಿನ ಗಯೊ. ತಿನಾಕ್ಹಾತೆ ಲೊಟಾಬಿ ಗಯೊ.ತೆಳಾಮಾ ಅಬ್ರಾಮನೆ 75 ವರಕ್ಹ ವೈಸ ಥೈತಿ. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />ಅಬ್ರಾಮನ ಹಾರಾನ ಗಾಮ ಛೊಡಿನ ಯಕ್ಲೊ ಗಯೊ ನೈ. ಅಬ್ರಾಮನ ತಿನಿ ಬೈಕೊ ಥಯಲ ಸಾರಯಳನೆ ತಿನಾ ನ್ಹಾನಾ ಭೈನೊ ದಿಕ್ರೊ ಥಯಲ ಲೊಟನೆ ತಿನಾ ಕ್ಹಾತೆ ಬಲೈಲಿನ ಗಯೊ. ಹಾರಾನ ಗಾಮೆ ಹಮೊನೆ ರ‍್ಹಯಲ ಆಸ್ತಿ ತ್ಯುನೆ ಲಿನ ಗಯಾ. ಅಬ್ರಾಮನೆ ಹಾರಾನ ಗಾಮ್ಮಾ ಹೊಂದೆಲ ಸೆವಕೊ ತಿನಾ ಕ್ಹಾತೆ ಗಯಾ. ಅಬ್ರಾಮನ ವರಿ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲವಾಲಾ ಹಾರಾನ ಗಾಮ ಛೊಡಿನ ಕಾನಾನ ಗಾಮೆ ಪ್ರಯಾಣ ಕರ್‍ಯಾ <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />ಅಬ್ರಾಮನ ಕಾನಾನ ಗಾಮ್ಮಾ ಪ್ರಯಾಣ ಅಗು ಚ಼ಲಾಯೊ ತೆ ಶೆಕೆಮ ಕವಾನಿ ಜ಼ಗಾ ಗೈನ ತ್ಯಾ ಮೊರೆ ಕವಾನು ಮ್ಹೊಟು ಝಾಡ ರ‍್ಹಯಲ ಜ಼ಗಾಲಕ್ಕಾ ಆಯೊ. ತೆ ಕಾಲಮಾ ಕಾನಾನ್ಯ ಗಮ್ಮಾ ವ್ಹತ್ತಾ. <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />ಕ್ಹುದಾ ಅಬ್ರಾಮನೆ ದಿಕ್ಹಿನ ತಾರಾ ಖಾಂದಾನೆ ಆ ಗಾಮ ದ್ಯುಸ ಕೈನ ಕದ್ಯೊ. ತೆ ಜ಼ಗಾಪರ ಕ್ಹುದಾ ಅಬ್ರಾಮನೆ ದಿಕ್ಹ್ಯೊ ತಿನಾಹುತಿ ಅಬ್ರಾಮನ ಕ್ಹುದಾನೆ ಹುತಿ ತ್ಯಾ ಯಕ್ಕ ಬಲಿನೊ ಕಟ್ಟೊ ಭಾಂದ್ಯೊ. <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />ಪಾಚಾ಼ತೊ ಅಬ್ರಾಮನ ತೆ ಜ಼ಗಾಕಂತೊ ಗೈನ ಬೆತೆಲಿನೆ ಪುರ್ವಮಾ ರ‍್ಹಯಲ ಡೊಂಗರೊ ಕನ ಪ್ರಯಾಣ ಕರೊ.ತ್ಯಾ ಅಬ್ರಾಮನ ತಿನಾ ಗುಡಾರೊಮಾ ಘಾಲ್ಯೊ ಪಶ್ಚಿಮಕನ ಬೆತಲ ಕೈನ ಗಾಮ ವ್ಹತ್ತು ಪುರ್ವಮಾ ಆಯಿ ಕೈನ ಗಾಮ ವ್ಹತ್ತು. ತೆ ಜ಼ಗಾಪರ ತೆ ಕ್ಹುದಾನೆ ಯಕ್ಕ ಬಲಿನೊ ಕಟ್ಟೊ ಭಾಂದಿನ ತೆ ಯಹೊವಾನೆ ಆರಾದನಾ ಕರ‍್ಯೊ.<verse eid="GEN 12:8" /></para>
  <para style="s">ಅಬ್ರಾಮ ಇಜಿಪ್ತಮಾ ಆಯಲ</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 12:9" />ವರಿ ತೆ ಪ್ರಯಾಣ ಅಗೊ ಚ಼ಲಾಯೊ ನೆಗೆವ ಜ಼ಗಾಕನ ಗಯೊ. <verse eid="GEN 12:9" /><verse number="10" style="v" sid="GEN 12:10" />ತೆ ಟೈಮ್ಮಾ ಭುಮಿಪರ ಬರ್ಗಾಲ ವ್ಹತ್ತು, ಅಬ್ರಾಮ ರ‍್ಹವಾನಾಹುತಿ ಇಜಿಪ್ಟೆ ಗಯೊ. ಕಾ ಕದ್ಯಾಮ ತ್ಯಾ ಘನ್ನು ಮ್ಹೊಟು ಬರ್ಗಾಲ ವ್ಹತು. <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />ತಿನಿ ಬೈಕೊ ಸಾರಯಳ ರುಪವತಿ ರ‍್ಹಯಲ ಅಬ್ರಾಮನೆ ಗೊತ್ತ ವ್ಹತ್ತು. ತಿನಾಹುತಿ ಇಜಿಪ್ಟೆ ಜಾವಾತಿ ಪೈಲಾಜ ಅಬ್ರಾಮನೆ ಸಾರಯಳನೆ, '‘ತು ರುಪವತಿ ವ್ಹೈ ಕೈನ ಮನೆ ಗೊತ್ತ ಛೆ. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />ಇಜಿಪ್ಟನಾ ದಾಣ್ಗಾ ತುನೆ ದೆಕಿನ ಆ ಇನಿ ಬೈಕೊ ವ್ಹೈ ಕೈನ ತಿಳದ್ಯು ತುನೆ ಪಡದಾನಾ ಹುತಿ ಮನೆ ಖಲಾಸ ಕರಿನ ತುನೆ ಜಿವಂತ ಛೊಡಸ. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />ತಿನಾಹುತಿ ತು ಮನೆ ಭೆನ ಥೌ ಕೈನ ಮನಕ್ಹೊ ಕನ ಕೆ ತೆಳಾಮಾ ತ್ಯುನೆ ಮನೆ ತಾರೊ ಭೈ ವ್ಹೈ ಕೈನ ಐಕ್ಯಾ ಮನೆ ನೈ ಮಾರತಾ ಮಪರ ದಯಾ ಕರಸ .ಅಮ್ಮತು ಮಾರಾ ಪ್ರಾಣ ವಚಾ಼ಡಿ; ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 12:13" /><verse number="14" style="v" sid="GEN 12:14" />ಲಾಸ್ಟಮಾ ಅಬ್ರಾಮ ಇಜಿಪ್ಟೆ ಗಯೊ. ಇಜಿಪ್ಟನಾ ದಾಣ್ಗಾ ಸಾರಯಳನೆ ದಿಕಿನ ಆ ಘನ್ನಿ ರುಪವತಿ ಕದ್ಯಾ. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />ಇಜಿಪ್ಟನಾ ದಕ್ಹಾ ನಾಯಕೊಬಿ ತಿನೆ ದೆಕ್ಯಾ.ತ್ಯುನೆ ಫರೊಹನ ಕನ ಗೈನ ತಿನು ಅಮ್ಮೊಘ ಸುಂದರತಾ ಬಗ್ಗೆ ತಿಳಶ್ಯಾ. ವರಿ ತೆ ನಾಯಕೊ ಸಾರಯಳ ಫರೊಹನಕನ ಲಿನ ಗಯಾ. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />ಅಬ್ರಾಮ ಸಾರಳನೊ ಭೈ ವ್ಹೈ ಕೈನ ಫರೊಹನ ಅಬ್ರಾಮನೆ ಮರಗ್ಯೊ. ಫರೊಹನ ಅಬ್ರಾಮನೆ ಬೈಲೊ ಬಕ್ರಾ ವರಿ ಗದಡಾ ದಿದ್ಯೊ. ವರಿ ಅಬ್ರಾಮನೆ ದಾಸ ದಾಸಿಯೊ ವರಿ ಹುಂಟೊ ದಿದ್ಯೊ. <verse eid="GEN 12:16" /><verse number="17" style="v" sid="GEN 12:17" />ಫರೊಹನ ಅಬ್ರಾಮನೆ ಬೈಕೊನೆ ಲಿದಲಕ್ಹು ಕ್ಹುದಾ ಫರೊಹನನೆ ತಿನಾ ಘರವಾಲಾವೊನೆ ಮ್ಹೊಟೊ ರೊಗ ಆವಾಲಗಾಡ್ಯೊ. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />ತೆಳಾಮಾ ಫರೊಹನ ಅಬ್ರಾಮನೆ ಬಲೈನ ತು ಮನೆ ಘನ್ನು ಕೆಟ್ಟ ಕರ‍್ಯೊಸ ಸಾರಯಳ ತಾರಿ ಬೈಕೊ ವ್ಹೈ ಕೈನ ಪೈಲಾ ಕಾ ಕದ್ಯೊ ನೈ? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />ಆ ತಾರಿ ಭೆನ ವ್ಹೈ ಕೈನ ಕಾ ಕದ್ಯೊ? ತು ಅಮ್ಮ ಕದಲಕ್ಹು ಮಿ ತಿನೆ ಮಾರಿ ಬೈಕೊ ಥಾವಾನಾಹುತಿ ಲಿದ್ಯೊ.ತಿನಾಹುತಿ ಹಮ್ನಾ ಮಿ ತಾರಿ ಬೈಕೊನೆ ವರಿ ತುನೆ ದ್ಯುಸ ಕದ್ಯೊ.ತು ಇನೆ ಬೈಲೈಲಿನ ತಾರಾ ಕ್ಹಾತೆ ಗೈಪಡ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />ಪಾಚಲ್ತೊ ಫರೊಹನ ತಿನಾ ಮನಕ್ಹೊನೆ ಅಬ್ರಾಮನನೆ ಇಜಿಪ್ಟತಾ ವಳೈ ಕೈನ ಸೆ ಕರಲಿದ್ಯಾ ತಿನಾಹುತಿ ಅಬ್ರಾಮನ ವರಿ ತಿನಿ ಬೈಕೊ ತೆ ಜ಼ಗಾ ಛೊಡಿನ ಗಯಾ ತ್ಯುನೆ ತ್ಯುನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ಲಿನ ಗಯಾ.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">ಅಬ್ರಾಮ ವರಿ ಲೊಟಾ ಬಿಜಾ಼ ಥಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />ಅಬ್ರಾಮ ಇಜಿಪ್ಟತೊ ಗಯೊ, ಅಬ್ರಾಮ ತಿನಿ ಬೈಕೊನೆ ಲಿನ ತಿಕನ ರ‍್ಹಯಲ ಕ್ಹಾರು ಲಿನ ನೆಗೆವಕಂತೊ ಪ್ರಯಾಣ ಕರ‍್ಯೊ. ಲೊಟಾಬಿ ತ್ಯುನಾ ಕ್ಹಾತೆ ಗಯೊ. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />ತೆಳಾಮ ಅಬ್ರಾಮ ಘನ್ನೊ ಸೌಕಾರ ಥಯೊತೊ ತಿನೆ ಬಕ್ರಾ ಬೊಕುಡೊ, ಢ್ಹೊರೊ ವ್ಹತ್ತಾ. ಘನ್ನು ಕ್ಹೊನು ರುಪ್ಪು ವ್ಹತ್ತು. <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />ಅಬ್ರಾಮನ ತಿನು ಪ್ರಯಾಣ ಅಗು ಚ಼ಲಾಯೊ ನೆಗೆವ ಗಾಮ ಛೊಡಿನ ಬೆತೆಲಿ ಗಾಮೆ ಪಾಚೊ಼ ಫರಿನ ಗಯೊ. ತೆ ಬೆತೆಲ ಗಾಮ ವರಿ ಆಯಿ ಗಾಮನಾ ವಚ್ಮಾ ರ‍್ಹಯಲ ಜ಼ಗಾಕನ ಗಯೊ. ಅಬ್ರಾಮ ವರಿ ತಿನು ಕುಟುಂಬ ಉತ್ರೆಲ ಜ಼ಗಾ ಎಜ಼ ವ್ಹೈ. <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />ಅಬ್ರಾಮ ಬಲಿನೊ ಕಟ್ಟೊ ಭಾಂದೆಲ ಜ಼ಗಾ ವ್ಹೈ. ಅಬ್ರಾಮ ಕ್ಹುದಾನೆ ಆರಾಧನಾ ಕರಲ ಜ಼ಗಾ ಎಜ಼ ವ್ಹೈ. <verse eid="GEN 13:4" /><verse number="5" style="v" sid="GEN 13:5" />ಆ ಕಾಲಮಾ ಲೊಟಾಬಿ ಅಬ್ರಾಮನಾ ಕ್ಹಾತೆ ಪ್ರಯಾಣ ಕರಾಡೊತೊ. ಲೊಟಾನೆ ಬಿ ಬಕ್ರಾ ವರಿ ಢ್ಹೊರೊನು ಹಿಂಡ ವರಿ ಗುಡಾರೊ ವ್ಹತ್ತಾ. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />ಅಬ್ರಾಮನೆ ಲೊಟಾನೆ ಘನ್ನಾ ಬಕ್ರಾ, ಬೈಲೊ, ಢ್ಹೊರೊ ರ‍್ಹಯಲಕ್ಹು ತ್ಯುನೊನೆ ರಾಕಾನೆ ತೆ ಜ಼ಗಾ ಬಸ್ಸ ಥೈ ನೈ. <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />ಅಬ್ರಾಮ ಹಿಂಡ ಕಾಯಿದಾವಾಲಾವೊನೆ ವರಿ ಲೊಟಾಬಿ ಹಿಂಡ ಕಾಯಿದಾವಾಲಾವೊನೆ ವಾದ ಕರಾನು ಚಾಲು ಕರ‍್ಯಾ ತೆ ಟೈಮ್ಮಾ ಕಾನಾನನಾ ವರಿ ಪೆರಿಜಿವಾಲಾ ತೆ ಜ಼ಗಾಪರ ವ್ಹತ್ತಾ. <verse eid="GEN 13:7" /><verse number="8" style="v" sid="GEN 13:8" />ತಿನಾಹುತಿ ಅಬ್ರಾಮ ಲೊಟಾನೆ ತುನೆ ಮನೆ ಕಯುಜ಼ ವಾಗ್ವಾದ ರ‍್ಹೌ ನೈ. ತಾರಾ ಮನಕ್ಹೊ ಮಾರಾ ಮನಕ್ಹೊ ವಾಗ್ವದ ಕರು ನೈ, ಅಪೆ ಕ್ಹಾರಾ ಯಕ್ಕಜ಼ ಖಾಂದಾನವಾಲಾ ಥಯಾಸ. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />ಅಪೆ ಜ಼ುದಾ ಥಯೆ ತುನೆ ಚಾ಼ಯೆ ಥಯಲ ತೆಕ್ಲಿ ಜ಼ಗಾ ಇನಿಲೆ ತು ರ‍್ವಡ್ಡಾ ಬಗಲ ಜಾವಾಲೊ ರ‍್ಹಯೊಮ ಮಿ ಸಿದಾ ಬಗಲ ಜೌಸ. ತು ಸಿದಾ ಬಗಲ ಜಾವಾಲೊ ರ‍್ಹಯೊಮ ಮಿ ರ‍್ವಡ್ಡಾ ಬಗಲ ಜೌಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 13:9" /><verse number="10" style="v" sid="GEN 13:10" />ಲೊಟಾ ಡೊಳೊ ಉಚೈನ ದೆಕ್ತಾಮಾ ಜೊರ್ಡನ ಕಣಿವೆ ದಿಕ್ಹಿ. ತ್ಯಾ ಚಾ಼ಯೆ ಥಯಲ ಅಕ್ಲು ಪಾನಿ ಲೊಟಾ ದೆಕ್ಯೊ. ತೆ ಟೈಮ್ಮಾ ಸೊದೊಮ ವರಿ ಗೊಮೊರ ಗಾಮೊ ಕ್ಹುದಾಕ್ಹು ನಾಶ ಥಯಾ ನ್ಹೊತಾ. ತೆ ಟೈಮ್ಮಾ ಜೊರ್ಡನ ಕಣವಿ ಚೊಗರ ಮಟಾ ಕ್ಹುದಾನೊ ಮಳೊ ನಿಂಗತ ಬಿ ವ್ಹತ್ತು. ವರಿ ಇಜಿಪ್ಟ ನಿಂಗತ ಬಿ ವ್ಹತ್ತು. <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />ತಿನಾಹುತಿ ಲೊಟಾ ಜೊರ್ಡನ ಕಣವಿ ಇನಿ ಲಿದ್ಯೊ. ತ್ಯುನೆ ಭಂಬಿ ಜ಼ನಾ ಜ಼ುದಾ ಥಯಾ ಲೊಟಾ ಪುರ್ವ ಕನ ಪ್ರಯಾಣ ಕರ‍್ಯೊ. <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />ಅಬ್ರಾಮ ಕಾನಾನ ದೆಶಮಾ ರ‍್ಹಯೊ. ಲೊಟಾ ಬಿ ಕಣಿವಿ ರ‍್ಹಯಲ ಗಾಮೊನಾ ನಜಿಕ ಖುಲ್ಲಾ ಜ಼ಗಮಾ ವ್ಹತ್ತೊ, ದಕ್ಷಿಣ್ಮಾ ರ‍್ಹಯಲ ಸೊದೊಮವಾಲಾವೊನೆ ಗುಡಾರೊ ಭಾಂದಿನ ದಿನ ಜ಼ಗಾ ಕರಿಲಿದ್ಯೊ. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />ಸೊದೊಮ ಗಾಮನಾ ಮನಕ್ಹೊ ಘನ್ನಾ ಕೆಟ್ಟ ವ್ಹತ್ತಾ. ತ್ಯುನೆ ಕೆಳಾಮಾಬಿ ಕ್ಹುದಾನೆ ವಿರುದ್ದ ಪಾಪ ಕರತಾತಾ<verse eid="GEN 13:13" /></para>
  <para style="s">ಅಬ್ರಾಮ ವರಿ ಹೆಬ್ರೊನನೆ ಜಾ಼ವಾನು</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />ಲೊಟಾ ಬಿ ಗಯಲ್ಪರ ಕ್ಹುದಾ ಅಬ್ರಾಮನೆ ಡೊಳಾ ಉಚೈನ ಸುತ್ತೆ ದೆಕ ಉತ್ತರ ದಕ್ಷಿಣ ಕನ ವರಿ ಪುರ್ವ ಪಶ್ಚಿಮ ಕನ ದೆಕ. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />ತು ದೆಕಾನು ಆ ದೆಶ ತುನೆ ವರಿ ತಾರಾ ಅಗಾ ಜಿವಸಾನಾ ತಾರಾ ಸಂತತಿಯೊನೆ ದ್ಯುಸ ಇಮ್ಮ ಕೆಳಾಮಾಬಿ ತಾರು ಥಯಲ ರ‍್ಹವಸ. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />ಮಿ ತಾರಾ ಮನಕ್ಹೊನೆ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಧೂಳನಾ ಅಕ್ಲು ಹೆಚ್ಕಿ ಕರುಸ. ಕುನ್ನಬಿ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಧೂಳನೆ ಹಿಸಾಬ ಕರ‍್ಯಾಮ ತಾರಿ ಸಂತತಿನಿ ಸಂಖ್ಯಾ ಇನಾ ಅಕ್ಲಿ ರ‍್ಹವಸ. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />ತಿನಾಹುತಿ ಜಾ಼ ತಾರಾ ಜಿಮಿನ್ಪರ ಕ್ಹಾರಿ ಬಗಲ ಫರ ಲಾಂಬಾಮಾ ರುಂದಮಾ ಫರ, ಕಾ ಕದ್ಯಾಮ ಮಿ ತೆ ತುನೆ ದ್ಯುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 13:17" /><verse number="18" style="v" sid="GEN 13:18" />ತಿನಾಹುತಿ ಅಬ್ರಾಮ ತಿನಾ ಗುಡಾರೊ ಕಿತ್ತೈನ ಮ್ಹೊಟಾ ಝಾಡೊ ರ‍್ಹಯಲ ಮಮ್ರೆಯನಾ ನಜಿಕ ಗೈನ ರ‍್ಹವಾನು ಚಾಲು ಕರ‍್ಯೊ. ತೆ ಹೆಬ್ರೊನ ಗಾಮನಾ ನಜಿಕ ವ್ಹತ್ತು. ತೆ ಜ಼ಗಾಪರ ಅಬ್ರಾಮ ಕ್ಹುದಾನೆ ಆರಾಧನಾ ಕರು ಕೈನ ಬಲಿನೊ ಕಟ್ಟೊ ಭಾಂದ್ಯೊ.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">ಅಬ್ರಾಮ ಲೊಟಾನೆ ಛೊಡಾಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />ತೆ ದಿನೊಮಾ ಅಮ್ರಾಫೆಲನ ಶಿನಾರನೊ ರಾಜೊ಼ ವ್ಹತ್ತೊ, ಅರಿಯೊಕ ಕ್ಹಾರಾ ಗಾಮೊನೊ ರಾಜೊ಼ ವ್ಹತ್ತೊ, ಕೆದೊರ್ಲಗೊಮರ ಎಲಾಮಿನೊ ರಾಜೊ಼ ವ್ಹತ್ತೊ. ತಿದ್ಗಾಲಗೊಯಿಮದನೊ ರಾಜೊ಼ ವ್ಹತ್ತೊ. <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />ಆ ರಾಜಾ ಕ್ಹಾರಾ ಸೊದೊಮಿನಾ ರಾಜೊ಼ ಥಯಲ ಬೆರಗನಿನೆ ಗೊಮೊರ ನೊ ರಾಜೊ಼ ಥಯಲ ಬಿರ್ಶಗನೆ ಅದ್ಮಾಹದನೊ ರಾಜೊ಼ ಥಯಲ ಶಿನಾಬನೆ ಚೆಬೊಯಿಮಿನೊ ರಾಜೊ಼ ಥಯಲ ಶೆಮೆಬರನೆಬಿ ಚೊಗರ ಕೈನ ಬೆಲಗಿನ ರಾಜಾನೆಬಿ ವಿರುದ್ದ ಥಯಾ. <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />ಆ ರಾಜಾ ಕ್ಹಾರಾ ಸಿದ್ದಿಮ್ ಕಣವಿಮಾ ತ್ಯುನಾ ಸೈನ್ಯಾವೊನೆ ಕ್ಹಾತೆ ಸೆರಶಾ.(ಸಿದ್ದಿಮ ಕಣವಿ ಹಮ್ನಾ ಮಿಟ್ಟಾನು ಸಮುಂದರ ಥಯುಸ). <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />ಆ ಕ್ಹಾರಾ ರಾಜಾ ಕೆದೊರ್ಲಗೊಮರನಾ ಅಧಿನಮಾ ಬಾರಾ ವರಕ್ಹ ವ್ಹತ್ತಾ. ಕಾಕದ್ಯಾಮ ತೆರಾವಾ ವರಕ್ಹಮಾ ತ್ಯುನೆ ಕ್ಹಾರಾ ತಿನೆ ವಿರೊಧ ಥಯಾ. <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />ತಿನಾಹುತಿ ಚೌದವಾ ವರಕ್ಹಮಾ ರಾಜೊ಼ ಥಯಲ ಕೆದೊರ್ಲಗೊಮರ ವರಿ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ರಾಜಾವೊ ತ್ಯುನಾ ವಿರುಧ್ಧ ಥೈನ ಯುದ್ದ ಕರಾನೆ ಆಯಾ. ಕೆದೊರ್ಲಗೊಮರ ವರಿ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ರಾಜಾಬಿ ಅಷ್ಟರೊತ್ ಕರ್ನಯಿಮಾ ರ‍್ಹಯಲ ರೆಫಾಯನೊ ಹಾಮಿನಮಾ ರ‍್ಹಯಲ ಜುಜ್ಯರನೊ ಶಾವೆಕೆರ್ಯಾತಯಿಮಾ ರ‍್ಹಯಲ ಎಮಿಯರೊನೆ ಸೊಲಶಾ. <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />ತೆನೈಸೊ ತ್ಯುನೆ ಹೊರಿಯರೊನೆ ಡೊಂಗರನಾ ಸಿಮೆತಾ ಉಸುಕನಿ ಜಿಮಿನ ನಜಿಕ ರ‍್ಹಯಲ ಎಲ್ಪಾರಾನಿನ ಲಕ್ಕಾ ಪಾಚಾ಼ ಮ್ಹೆಲ್ಯಾ. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />ತೆ ಥಯಲ್ಪರ ಕೆದೊರ್ಲಗೊಮರ ರಾಜೊ಼ ಉತ್ತರಕನ ಫರಿನ ಕಾದೆಶ್ ಕವಾನು ಎನ್ಮಿಷ್ಪಾಟಿಯೆ ಐನ ಕ್ಹರಾ ಅಮ್ಮಾಲೆಕ್ಯರೊನೆ ಹಾರಾಡ್ಯೊ.ತೆನೈಸೊ ತೆ ಹಚಚೊನ್ ತಾಮರಿಮಾ ಜ್ಯುತಾ ರ‍್ಹಯಲ ಅಮ್ಮೊರಿಯೊನೆ ಹಾರಾಡ್ಯೊ. <verse eid="GEN 14:7" /><verse number="8" style="v" sid="GEN 14:8" />ತೆ ದಿನೊಮಾ ಸೊದೊಮಿನನೊ ರಾಜೊ಼ ಗೊಮೊರನೊ ರಾಜೊ಼ ಅದ್ಮಾಹದನೊ ರಾಜೊ಼ ಚೆಬೊಯಿಮಿನನೊ ರಾಜೊ಼ ಬೆಲಗದ, ಕದ್ಯಾಮ ಚೊಗರನೊ ರಾಜೊ಼ ಕ್ಹಾತೆ ಮಳಿನ ಶತ್ರುವೊನಾ ವಿರುದ್ದ ಥೈನ ದಂಡೆ ಉಚೈಲಿನ ಸಿದ್ದಿಮ್ ಕಣವಿನೆ ಗಯಾ <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />ತ್ಯುನೆ ಎಲಾಮಿನೊ ರಾಜೊ಼ ಕೆದೊರ್ಲಗೊಮರನೆಬಿ ಗೊಯಿಮದ ರಾಜೊ಼ ತಿದ್ಗಾಲನೆಬಿ ಶಿನಾರನೊ ರಾಜೊ಼ ಅಮ್ಮ್ರಾಫೆಲನೆಬಿ, ಕ್ಹಾರಾ ಗಾಮೊನಾ ರಾಜೊ಼ ಅರಿಯೊಕನೆಬಿ ವಿರುದ್ದ ಥೈನ ಹೊರಾಡ್ಯಾ.ಅಮ್ಮಜ ಚಾರ ಜ಼ನಾ ರಜಾ ಪಾಂಚ ಜ಼ನಾ ರಾಜಾವೊನಾ ವಿರುದ್ದ ಥೈನ ಹೊರಾಡ್ಯಾ. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />ಸಿದ್ದಿಮ್ ಕಣವಿಮಾ ಕಲ್ಲರಗಿನ ಡಾಂಬರನಿ ಖಾಡಿಮಾ ಘನ್ನಾ ವ್ಹತ್ತಾ. ಸೊದೊಮ ವರಿ ಗೊಮೊರೊನಾ ರಾಜಾ ವರಿ ತ್ಯುನಿ ಸೈನ್ಯವೊ ನ್ಹಾಟಿನ ಜಾ಼ತಾಮಾ ಆ ಖಾಡಿಮಾ ಪಡಿ ಗಯಾ. ಉಗರಲವಾಲಾ ಡೊಂಗರೊನೆ ನ್ಹಾಟಿ ಗಯಾ. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />ಝಿತ್ತಲವಾಲಾ ಸೊದೊಮ ವರಿ ಗೊಮರನಾ ಮನಕ್ಹೊ ಹೊಂದೆಲ ಕ್ಹಾರಾ ಸಾಮನೊ ಲಿನ ಗಯಾ ತ್ಯುನೆ ಕ್ಹಾರಾವೊನೊ ಅನ್ನ ವಣ್ಣಾ ಲಿನ ಗಯಾ. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />ಅಬ್ರಾಮನೊ ಭೈ ಥಯಲ ಲೊಟಾಬಿ ಸೊದೊಮ್ ಗಾಮಾ ವ್ಹತ್ತೊ.ಶತ್ರುವೊ ತಿನೆ ಧರೆಲ ತಿಕನ ರ‍್ಹಯಲ ಕ್ಹಾರು ಕಾಳಿಲಿನ ಗಯಾ. <verse eid="GEN 14:12" /><verse number="13" style="v" sid="GEN 14:13" />ಚುಕೈಲಿನ ಯಕ್ಲೊ ಇಬ್ರಿಯನೊ ಅಬ್ರಾಮಕನ ಥಯಲ ವಿಷಯನಾಹುತಿ ತಿಳಷ್ಯೊ. ಅಬ್ರಾಮ ಅಮ್ಮೊರಿಯ ಥಯಲ ಮಮ್ರೆಯನಾ ತೊಪಕನ ವ್ಹತ್ತೊ. ಮಮ್ರೆ, ಎಷ್ಕೊಲ ವರಿ ಆನೆರ ಯಕ್ಲಾನೆ ಯಕ್ಲೊಮದತ ಕರಾನೆ ಒಪ್ಪಂದ ಕರಲಿದ್ಯಾ ತೆನೈಸೊ ಅಬ್ರಾಮನೆ ಮದತಕರಾನಾ ಹುತಿ ಯಕ್ಕ ಒಪ್ಪಂದ ಕರೆಟ್ಟ ಕರ‍್ಯಾತಾ. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />ಲೊಟಾ ಜೆಲ್ಮಾ ರ‍್ಹಯಲ ಅಬ್ರಾಮನೆ ತಿಳದ್ಯು.ತಿನಾಹುತಿ ಅಬ್ರಾಮ ತಿನಾ ಘರಮಾ ಹುಟ್ಟಲ ಗಂಡ ಆಳೊನೆ ಯಕ್ಕ ಜ಼ಗಾ ಮಳಾಯೊ. ತ್ಯುನಾಮಾ 318 ಮನಕ್ಹೊತರಬೆತಿ ಹೊಂದೆಲ ಸೈನಿಕೊ ವ್ಹತ್ತಾ. ಅಬ್ರಾಮನ ತಿನಾಕ್ಹಾತೆ ಗೈನ ಶತ್ರುವೊನೆ ದಾನ ಗಾಮಲಕ್ಕಾಬಿ ಪಾಚೊ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />ತೆ ರಾತೆ ತೆ ವರಿ ತಿನಾ ಸೆವಕೊ ಹಠಾತ್ತನ ಶತ್ರುವೊನೆ ಸೊಲಸ್ಯಾ. ದಮಸ್ಕನೆ ಉತ್ತರಮಾ ರ‍್ಹಯಲ ಹೊಬಾದ ಅಕ್ಲಾ ದುರ ಮ್ಹೆಲ್ಯಾ. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />ಪಾಚಾತಾ ಶತ್ರುವೊ ಅಪಹರಿಸಿದ್ದ ಕ್ಹಾರಾ ಸಾಮನೊನೆ ವರಿ ಲೊಟಾನಿ ಆಸ್ತಿ ಅಬ್ರಾಮ ಲಿನ ಲೊಟಾನಾ ಕ್ಹಾತೆ ಆಯೊ.ತೆನೈಸೊ ಜೆಲಮಾ ಧರೆವಾಲಾ ಬಾಕ್ಡಿಯೊ ವರಿ ಮನಕ್ಹೊನೆ ಪಾಚೊ ಬಲೈಲಿನ ಆಯೊ. <verse eid="GEN 14:16" /><verse number="17" style="v" sid="GEN 14:17" />ತೆಳಾಮಾ ಅಬ್ರಾಮ ಕೆದೊರ್ಲಗೊಮರನೆ ವರಿ ತಿನಾಕ್ಹಾತೆ ರ‍್ಹಯಲ ರಾಜಾವೊನೆ ಹಾರಾಡೆಲ್ಪರ ತಿನಾ ಘರೆ ಗಯೊ.ತೆಳಾಮಾ ಸೊದೊಮಿನೊ ರಾಜೊ಼ ಅಬ್ರಾಮನ ಮಳಾನೆ ಶಾವ ಎ ಕಣವಿಯೆ ಗಯೊ ಹಮ್ನಾ ಅನೆ ರಾಜಾನಿ ಕಣವಿ ಕೈನ ಬಲಾವಸ.)<verse eid="GEN 14:17" /></para>
  <para style="s">ಮೆಲ್ಕಿಜೆದಕ ಅಬ್ರಾಮನೆ ಆಶಿರ್ವಾದ ದಿದಲ</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 14:18" />ಸಾಲೆಮಿನೊ ರಾಜೊ಼ ರ‍್ಹಯಲ ಮೆಲ್ಕಿಚೆದೆಕಬಿ ಅಬ್ರಾಮನೆ ಮಳಾನೆ ಗಯೊ. ಮಹೊನ್ನತ ಥಯಲ ಕ್ಹುದಾನೊ ಯಾಜಕ ಥಯಲ ತೆ ರೊಕ್ಲೊ ದ್ರಾಕ್ಷಾ ರಕ್ಹ ಕಾಡಿನಲಿನ ಐನ <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />ಅಬ್ರಾಮನೆ ಅಮ್ಮ ಆಶಿರ್ವಾದ ಕರ‍್ಯೊ; ಅಬ್ರಾಮ ಮಹೊನ್ನತ ಥಯಲ ಕ್ಹುದಾ ತುನೆ ಆಶಿರ್ವಾದ ಕರಾದೆ. ಹಬಾಳನೆ ಜಿಮಿನೆ ಸೃಷ್ಟಿ ಕರಲ ತೆಜ಼ ವ್ಹೈ. <verse eid="GEN 14:19" /><verse number="20" style="v" sid="GEN 14:20" />ತಾರೊ ಶತ್ರುವೊನೆ ಸೊಲಸಾ ನೆ ತುನೆ ಮದತ ಕರಲ ಮಹೊನ್ನತ ಥಯಲ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಥಾವಾಂದೆ'‘ ಅಬ್ರಾಮ ಯುದ್ದ ಲಾಯೆಲ ಕ್ಹಾರಾ ಸಾಮನೊಮಾ ದಕ್ಹವಾನು ಯಕ್ಕ ಭಾಗ ಮೆಲ್ಕೀಚೆದೆಕನೆ ದಿದ್ಯೊ. <verse eid="GEN 14:20" /><verse number="21" style="v" sid="GEN 14:21" />ತೆ ಥಯಲ್ಪರ ಸೊದೊಮಿನೊ ರಾಜೊ಼ ಅಬ್ರಾಮನೆ ,ಆ ಸಾಮನೊ ಕ್ಹಾರಾ ತುಜ ಮ್ಹೆಲ್ಲೆ. ತು ವಶಮಾ ಕರಿಲಿದಲ ಮಾರಾ ಮನಕ್ಹೊ ಯಕ್ಕಜ಼ ಮನೆ ದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 14:21" /><verse number="22" style="v" sid="GEN 14:22" />ತಿನಾಹುತಿ ಅಬ್ರಾಮ ತಿನೆ ಹಬಾಳ ಜಿಮಿನ ನೆ ಸೃಷ್ಟಿ ಕರಲ ಮಹೊನ್ನತ ಥಯಲ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಘಮ್ಮ ಘಾಲಿನ ಕವಾನು ಸುವೈ ಕದ್ಯಾಮ , <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />ತಾರು ಥಯಲ ಸುಜ಼ ಮಿ ಮ್ಹೆಲ್ಲೆತೊ ನೈ; ತೆ ದೊರೊ ರೈತೊಬಿ ಚಪಲೊ ರೈತೊಬಿ ಮಿ ನೈ ಮ್ಹೆಲ್ಲೆತೊ. ಮಿ ಅಬ್ರಾಮನೆ ಸೌಕಾರ ಕರ‍್ಯೊ.ಕೈನ ತು ಕವಾನು ಮನೆ ನಕೊ. <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />ಮಾರಾ ಯೌವನಸ್ಥೊ ಕ್ಹಾದೆಲ ಅನ್ನ ಹೊರತು ಬಿಜು ಸುಜ಼ ನೈ ಸ್ವಿಕಾರ ನೈ ಕರತೊ.ತಿನಾಹುತಿ ಬಿಜಾ಼ ಮನಕ್ಹೊನೆ ತ್ಯುನು ಪಾಲ ದೆ. ಅಪೆ ಯುದ್ದಮಾ ಝಿತ್ತಲ ಸಾಮನೊ ಲೆ ಆನೆರ, ಎಷ್ಕೊಲ ವರಿ ಮಮ್ರೆಯವಾಲಾವೊನೆ ತ್ಯುನು ಪಾಲ ದೆ. ತೆ ಮನಕ್ಹೊ ಯುದ್ದಮಾ ಮನೆ ಮದೆತ ಕರ‍್ಯಾ ಕೈನ ಕದ್ಯೊ.<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">ಅಬ್ರಾಮನಿ ಸಂತತಿನೆ ಕ್ಹುದಾ ಕರಲ ವಾಗ್ದಾನ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />ಆ ಸಂಗತಿಯೊ ಥಯಲ್ಪರ ಅಬ್ರಾಮನೆ ದರ್ಶನಮಾ ಯಹೊವಾನು ಸಂದೆಶ ಐಯು.ಕ್ಹುದಾ ತಿನೆ,ಅಬ್ರಾಮ ಬುಚ್ಕುನಕೊ; ಮಿಜ಼ ತುನೆ ಗುರಾಣಿ ಥಯೊಸ.ಮಿ ತುನೆ ಮ್ಹೊಟ್ಟು ಪ್ರತಿಫಲ ದ್ಯುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 15:1" /><verse number="2" style="v" sid="GEN 15:2" />ತಿನಾಕ್ಹು ಅಬ್ರಾಮ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ,ತು ಮನೆ ಸುಬಿ ದಿದ್ಯಾರೆ ಮನೆ ಕ್ಹುಶಿ ನೈ ಥಾತಿ ಕಾಕದ್ಯಾಮ ಮನೆ ದಿಕ್ರೊ ನತ್ತಿ. ತಿನಾಹುತಿ ಮಿ ಮರಲ್ಪರ ಮಾರಿ ಆಸ್ತಿ ಕ್ಹಾರಿ ಮಾರೊ ಸೆವಕ ಥಯಲ ದಮಸ್ಕನೊ ಎಲೀಯೆಜರನಾ ಪಾಲೆ ಥಾವಸ'' ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />ವರಿ ಅಬ್ರಾಮ ತು ಮನೆ ದಿಕ್ರಾನೆ ನತ್ತಿ ದಿದ್ಯೊ.ತಿನಾಹುತಿ ಮಾರಾ ಘರಮಾ ಹುಟ್ಟಲ ಸೆವಕ ಯಕ್ಲೊ ಮಾರು ರ‍್ಹಯಲ ಕ್ಹಾರು ಪಡ್ದಿಲಿವಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 15:3" /><verse number="4" style="v" sid="GEN 15:4" />ತೆಳಾಮ ಯಹೊವಾ ಅಬ್ರಾಮನೆ ತಾರಿ ಆಸ್ತಿಕ್ಹಾರಿ ಪಡ್ದಿಲಿವಾಲೊ ತಾರೊ ಸೆವಕ ನವ್ಹೈ.ತುಜ ದಿಕ್ರಾನೆ ಪಡ್ದಿಲೆಸಿ;ತಾರೊ ದಿಕ್ರೊಜ ತಾರಾ ಆಸ್ತಿಕ್ಹಾರಿ ಪಡದಸ'’ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />ತೆ ಥಯಲ್ಪರ ಕ್ಹುದಾ ಅಬ್ರಾಮನೆ ಭಾರೊ ಲಿನ ಐನ ತಿನೆ, ಹಬಾಳಕನ ಡೊಳೊ ಉಚೈನ ಚಿಕ್ಕಿಯೊನೆ ದೆಕ ತು ಹಿಸಾಬ ನೈಕರತೊ ತೆಕ್ಲಾ ಚಿಕ್ಕಿಯೊ ಛೆ.ಅಗಲ್ಯಾ ದಿನೊಮಾ ತಾರು ಕ್ಹಾಂದಾನ ತೆಜ಼ ರಿತಿಮಾ ರ‍್ಹವಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 15:5" /><verse number="6" style="v" sid="GEN 15:6" />ಅಬ್ರಾಮ ಯಹೊವಾನೆ ನಂಬ್ಯೊ.ತೆ ನಂಬಿಕೆನಾ ನಿಮಿತ್ತ ಯಹೊವಾ ಅಬ್ರಾಮನೆ ನಿತಿವಂತವಾಲೊ ವ್ಹೈ ಕೈನ ತಿನೆ ವಪ್ಪಿಲಿದ್ಯೊ. <verse eid="GEN 15:6" /><verse number="7" style="v" sid="GEN 15:7" />ತೆ ಅಬ್ರಾಮನೆ '‘ಯಹೊವಾ ಥಯಲ ಮಿ ತುನೆ ಕಲ್ದಿಯರ ಉರ್ ಗಾಮತೊ ಬಲಾವಾಲಗಾಡ್ಯೊ.ತುನೆ ಆ ದೆಶ ದ್ಯುಕೈನ ತು ಆ ದೆಶ ಹೊಂದಿಲ್ಯು ಕೈನ ಮಿ ತುನೆ ಬಲಾವಾಲಗಾಡ್ಯೊ'’ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 15:7" /><verse number="8" style="v" sid="GEN 15:8" />ತಿನಾಕ್ಹು ಅಬ್ರಾಮ, ಯಹೊವಾ, ಮಾರಾ ಒಡೆಯಾ,ಮನೆ ಆ ದೆಶ ಮಳಸ ಕೈನ ಖಚಿತ ಕರಲಿವಾನು ಕಿಮ್ಮ ವ್ಹೈ?'‘ ಕೈನ ಪುಚ್ಯೊ. <verse eid="GEN 15:8" /><verse number="9" style="v" sid="GEN 15:9" />ಕ್ಹುದಾ ಅಬ್ರಾಮನೆ ಹಮೆ ಯಕ್ಕ ವಡಂಬಡಿಕೆ ಕರಲಿಯೆ ತನ್ನ ವರಕ್ಹನು ಯಕ್ಕ ಬೈಲ ತನ್ನ ವರಕ್ಹನು ಯಕ್ಕ ಬಕ್ರು ವರಿ ತನ್ನ ವರಕ್ಹನು ಯಕ್ಕ ಟಗರನೆ ಲಿನ ಆ. ತೆನೈಸೊ ಯಕ್ಕ ಬಗಲ್ಯು ಯಕ್ಕ ಕ್ಹಬುತರ ಲಿನ ಆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 15:9" /><verse number="10" style="v" sid="GEN 15:10" />ಅಬ್ರಾಮ ಕ್ಹುದಾನಾ ವಾಸ್ತರ ತೆ ಕ್ಹಾರು ಲಿನ ಆಯೊ ಅಬ್ರಾಮ ತೆ ಕ್ಹಾರು ಕತ್ರಿನ ಬೆ ಬೆ ತುಕ್ಡಾ ಕರ‍್ಯೊ. ಪಾಚಲ್ತೊ ಅಬ್ರಾಮ ತುಕ್ಡಾನೆ ತುಕ್ಡೊ ಕ್ಹಾಮೊ ಮ್ಹೆಲ್ಯೊ. ಅಬ್ರಾಮ ಪಕ್ಷಿಯೊನೆ ಮಾತ್ರ ಬೆ ತುಕ್ಡಾ ಕರ‍್ಯೊ ನೈ. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />ದಕ್ಹೊ ಟೈಮ ಥಯಲ್ಪರ ಮ್ಹೊಟಾ ಪಕ್ಷಿಯೊ ತೆ ಜಾನವರನು ಮಾಕ್ಹ ಕ್ಹಾವಾನೆ ಉಡಿನ ಆಯಾ. ಅಬ್ರಾಮ ತ್ಯುನೊನೆ ನ್ಹಟಾಡಿಪಾಡ್ಯೊ. <verse eid="GEN 15:11" /><verse number="12" style="v" sid="GEN 15:12" />ಕ್ಹಾಂಜ ಥೈ,ಸುರ್ಯೊ ಡುಬಿಲ್ಪರ ಅಬ್ರಾಮನೆ ಘನ್ನಿ ನಿಂದರ ಐ.ತೆ ನಿಂದರಮಾ ರ‍್ಹತಾಮಾ ಘನ್ನು ಖತರನಾಕ ಅಂದಾರು ಥೈಯು. <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />ತೆಳಾಮಾ ಯಹೊವಾ ಅಬ್ರಾಮನೆ ತುನೆ ಆ ವಿಷಯ ತಿಳ್ದೆಲ ರ‍್ಹೌ.ತಾರಾ ಕ್ಹಾಂದಾನ ವಾಲಾ ಪರದೆಶಿ ಥೈನ ತ್ಯುನು ನೈರ‍್ಹಯೆಲ ದೆಶಮಾ ರ‍್ಹವಸ ತ್ಯಾನಾ ಮನಕ್ಹೊ ತ್ಯುನೊನೆ ಗುಲಾಮೊ ಕರಲಿವಸ ತ್ಯಾ ತುನೆ ಚಾರಕ್ಹೊ ವರಕ್ಹ ಲಕ್ಕಾ ಭಾಧೆಪಡದಸ. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />ತೆನೈಸೊ ಚಾರಕ್ಹೊ ವರಕ್ಹ ಥಯಲ್ಪರ ದೊರೆತನ ಕರಲ ಆ ದೆಶನೆ ಮಿ ದಂಡ ದ್ಯುಸ; ತಾರಾ ಮನಕ್ಹೊ ದೆಶನೆ ಛೊಡಿನ ಜಾ಼ವಸ.ತಾರಾ ಮನಕ್ಹೊ ತೆ ಛೊಡ್ತಾಮಾ ತ್ಯುನಾ ಕ್ಹಾತೆ ಸಂಪತ್ತ ಲಿನ ಜಾ಼ವಸ. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />ತು ಘನ್ನೊಗಡಿಯೊ ಥಯೆ ಲಕ್ಕಾ ರೈನ ಸಮಾಧಾನಕ್ಹೊ ಮರಸಿ; ತುನೆ ತಾರಾ ಕ್ಹಾಂದಾನಾವಾಲಾವೊನಾ ಕ್ಹಾತೆ ಮಜಾರ ಕರಸ. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />ಚಾರ ತಲೆಮಾರ ಥಯಲ್ಪರ ತಾರಾ ಮನಕ್ಹೊ ಆ ಗಾಮೆನೆ ಪಾಚಾ಼ ಫರಸ. ತೆ ಕಾಲಮಾ ತಾರಾ ಮನಕ್ಹೊ ಅಮ್ಮೊರಿಯೆನೆ ಹರಾಡಸ. ಯ್ಹಾ ರ‍್ಹವಾನಾ ಅಮ್ಮೊರಿಯೊ ತಾರಾ ಮನಕ್ಹೊನಾ ಮೂಲಕ ಮಿಜ಼ ಶಿಕ್ಷಾದ್ಯುಸ. ಆ ಅಗಾ ಚಾಲಾನಾ ಸಂಗತಿ ಕಾಕದ್ಯಾಮ ತೆ ಟೈಮಾ ಅಮ್ಮೊರಿಯೊ ಹೈ ಶಿಕ್ಷಾ ಅನುಭವ ಕರಾ ಅಕ್ಲಾ ಕೆಟ್ಟ ನತ್ತಿ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 15:16" /><verse number="17" style="v" sid="GEN 15:17" />ಸುರ್ಯೊ ಡುಬೆಲ್ಪರ ಘನ್ನು ಅಂದಾರು ಥಯು.ಕತ್ರಿನ ಘಾಲೆಲ ಹರಯಕ್ಕ ಜಾನವರ ಅಂಗ ಬೆ ತುಕ್ಡಾ ಹಜುಬಿ ಜಿಮಿನ್ಪರ ವ್ಹತ್ತಾ.ತೆ ಟೈಮಾ ಅಚಾನಕ ಧವಾಂಡೊ ವರಿ ಆಗಕ್ಹು ಮಳೆಲ ದಿವಿಟಿಗೆ ಆ ತುಕ್ಡಾನಾ ವಚ್ಮಾತು ಐನ ಗಯು. <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />ತಿನಾಹುತಿ ಯಹೊವಾ ಯಕ್ಕ ವಾಗ್ದಾನ ಕರಿನ ಅಬ್ರಾಮನಾ ಕ್ಹಾತೆ ಯಕ್ಕ ವಡಂಬಡಿಕೆ ಕರಲಿದ್ಯೊ.ಯಹೊವಾ ತಿನೆ, ಮಿ ತಾರಾ ಕ್ಹಾಂದಾನವಾಲಾವೊನೆ ಆ ಗಾಮ ದ್ಯುಸ ಮಿ ತ್ಯುನೊನೆ ಇಜಿಪ್ಟ ನದಿತೊ ಯೂಫ್ರೆಟಿಸ ಮಹಾನದಿ ಲಕ್ಕಾ ರ‍್ಹವಾನು ಗಾಮ ನೆ ದ್ಯುಸ. <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />ಆ ಕೆನಿಯರ, ಕೆನಿಜೀಯರ, ಕದ್ಮೊನಿಯರ, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />ಹಿತ್ತಿಯರ, ಪೆರಿಜೀಯರ, ರೆಷಾಯರ, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />ಅಮ್ಮೊರಿಯರ,ಕಾನಾನ್ಯರ, ಗಿರ್ಗಾಷಿಯರ ವರಿ ಯೆಬುಸಿಯರ ಗಾಮ'‘ ಕೈನ ಕದ್ಯೊ.<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">ಹಾಗರಳ ವರಿ ಇಸ್ಮಾಯಿಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />ಸಾರಳ ಅಬ್ರಾಮನಿ ಬೈಕೊ. ತಿನೆ ಬಚ್ಚಾನ್ಹೊತಾ. ಸಾರಳನೆ ಇಜಿಪ್ಟನಿ ಯಕ್ಕ ಸೆವಕ ವ್ಹತ್ತಿ. ತಿನು ನಾಮ ಹಾಗರಳ. <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />ಸಾರಳ ಅಬ್ರಾಮನೆ ಯಹೊವಾ ಮನೆ ಬಚ್ಚಾ ಪಡದಾನೊ ಅವಕಾಶ ದಿದ್ಯೊನತ್ತಿ.ತಿನಾಹುತಿ ಮಾರಿ ಸೆವಕ ಥಯಲ ಹಾಗರಳ ಕನ ಜಾ ತಿನಾಮಾ ಹುಟ್ಟಲ ಬಚ್ಚಾನೆ ಮಾರು ಬಚ್ಚು಼ ವ್ಹೈಕೈನ ಸ್ವಿಕಾರಕರುಸ'' ಕೈನ ಕ.ಅಬ್ರಾಮ ತಿನಿ ಬೈಕೊ ಥಯಲ ಸಾರಳನೆ ವಿಧೆಯ ಥಯೊ. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />ಅಬ್ರಾಮ ಕಾನಾನೆ ಐನ ದಕ್ಹ ವರಕ್ಹ ಥಯಲ್ಪರ ಸಾರಳ ತಿನೊ ಮಾಟಿ ಥಯಲ ಅಬ್ರಾಮನೆ ಹಾಗರಳನೆ ದಿದಿ.ಹಾಗರಳ ತೆ ಇಜಿಪ್ಟನಿ ಸೆವಕಿ ವ್ಹತ್ತಿ. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />ಹಾಗರಳ ಅಬ್ರಾಮಕ್ಹು ಪೆಟೆ ರ‍್ಹತಾಮಾ ತಿನಿ ಮಾಲಕನಿ ಥಯಲ ಸಾರಳನೆ ಮೊಜಿಸ.. <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />ತೆಳಾಮ ಸಾರಳ ಅಬ್ರಾಮನೆ ಮಾರಾ ಸಂಕಟನೆ ತುಜ ಕಾರಣಾ ವ್ಹೈ, ಮಿ ತಿನೆ ತುನೆ ದಿದಿತಿ. ಹಮ್ನಾ ತೆ ಪೆಟೆ ಛೆ ವರಿ ಮನೆ ಲಾಸ್ಟೆಮೊಜಿಸ.ಯಹೊವಾ ಮನೆ ತುನೆ ನ್ಯಾಯಾ ಕರಾಂದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 16:5" /><verse number="6" style="v" sid="GEN 16:6" />ತೆಳಾಮಾ ಅಬ್ರಾಮ ಸಾರಳನೆ ತು ಹಾಗರಳ ಮಾಲಕನಿ.ತು ತೆನೆ ಸುಬಿ ಚಾ಼ಯೆ ಥಯಲ ಕರಸಕ್ಸಿ'’ ಕೈನ ಕದ್ಯೊ. ತಿನಾಹುತಿ ಸಾರಳ ಹಾಗರಳನೆ. ತೆಳಾಮಾ ಹಾಗರಳ ನ್ಹಾಟಿನ ಗೈ. <verse eid="GEN 16:6" /><verse number="7" style="v" sid="GEN 16:7" />ಕ್ಹುದಾನೊ ದುತ ಹಾಗರಳನೆ ಉಸುಕ ಗಾಮ ಒರತೆ ಯಕ್ಕನಾ ಕ್ಹಾಮೊ ದೆಕ್ಯೊ. ತೆ ಒರತೆ ಶುರಿ ಗಾಮೆ ಜಾವಾನಾ ವಾಟಕನ ವ್ಹತ್ತೊ. <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />ದೆವದುತ ತೆನೆ ಹಾಗರ ತು ಸಾರಳನೆ ಸೆವಕಿ ರೈತಬಿ ಯ್ಹಾ ಕಾ ಛೆpppppp? ತು ಕಿಜಾ ಚಾಲಿಸ ?ಕೈನ ಪುಚ್ಯೊ. ಮಿ ಮಾರಿ ಯಜಮಾನಿ ಥಯಲ ಸಾರಳಕಂತಿ ನ್ಹಾಟಿನ ಚಾಲಿಸ ಕೈನ ಕದಿ. <verse eid="GEN 16:8" /><verse number="9" style="v" sid="GEN 16:9" />ತೆ ವಾತೆ ಯಹೊವಾ ತು ತಾರಾ ಮಾಲಕಕನ ಪ್ಹರಿನ ಗೈನ ತಿನೆ ಅಧಿನ ಥೈನ ಚಾ಼ಲ. <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />ಯಕ್ಲುಜ಼ ನೈಸೊ ಯಹೊವಾನು ದುತ ತಿನೆ ತುನೆ ಘನ್ನಾ ಬಚ್ಚಾ಼ ತಿಮ ಕರುಸ ತಾರು ಸಂತಾನನೆ ಹಿಸಾಬಾವಾಚಿ ಕರುಸ.ಕದ್ಯೊ. <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />ಯಹೊವಾನು ದುತ ತಿನೆ ತು ಪೆಟೆ ಛೆ ಪಟ್ಟೊ ಹುಟ್ಟಸ ಯಹೊವಾ ತಾರು ತ್ರಾಸನು ಅವಾಜ಼ ಐಕಲಹುತಿ ತೆ ಪಟ್ಟಾನು ನಾಮ ಇಸ್ಮಾಯಿಲ ಕೈನ ನಾಮ ಮ್ಹೆಲು. <verse eid="GEN 16:11" /><verse number="12" style="v" sid="GEN 16:12" />ತೆ ಮನಕ್ಹ ರಾನ್ಮಾನು ಗದ್ಡಾ ನಿಂಗತ ರ‍್ಹವಸ. ತೆ ಕ್ಹಾರಾವೊಪರ ಹತ್ತ ಉಚಾವಸ. ತಿನಾನಿಂಗತಜ಼಼ ತಿಪರ ಮನಕ್ಹೊ ಹತ್ತ ಉಚಾವಸ.ತಿನಾ ಭಾಯೊನಾ ವಿರುದ್ದ ಥೈನ ರ‍್ಹವಸ. ಕೈನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 16:12" /><verse number="13" style="v" sid="GEN 16:13" />ತೆ ಥಯಲ್ಪರ ತೆ ತಿನಾ ಕ್ಹಾತೆ ಬೊಲಲ ಯಹೊವಾನೆ ತು ಮನ ಎದೆಕಾನೊ ದೆಕಾನೊ ಕ್ಹುದಾ ವ್ಹೈ. ಕೈನ ನಾಮ ಮ್ಹೆಲಿ ಕಾ ಕದ್ಯಾಮ ಮನೆ ದೆಕಾಲೊ ನ್ಹಾಜ಼ ದೆಕಾಲಿ ಥೈ ಕೈಲಿದಿ <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />ತಿನಾ ಹುತಿ ತ್ಯಾ ರ‍್ಹಯಲ ಇರನೆ ಬೆರ ಲಹೈರೊಯಿ ಕೈನ ನಾಮ ಪಡ್ಯು.ತೆ ಕಾದೆಶಿನೆ ಬೆರೆದನೆ ಮಳಲ ವಚ್ಮಾ಼ ಛೆ. <verse eid="GEN 16:14" /><verse number="15" style="v" sid="GEN 16:15" />ಹಾಗರಳ ಅಬ್ರಾಮ ಕ್ಹು ಯಕ್ಕ ಪಟ್ಟು ಜ಼ನ್ನಿ. ಅಬ್ರಾಮ ತಿನು ನಾಮ ಇಸ್ಮಾಯಿಲ ಕೈನ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />ಹಾಗರಳ ಇಸ್ಮಾಯಿಲನೆ ಜನತಾಮಾ ಅಬ್ರಾಮನೆ 86 ವರಕ್ಹನು ವ್ಹತೊ.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">ಖತ್ನಾ ಒಡಂಬಡಿಕೆನಿ ವಳಕ ವ್ಹೈ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />ಅಬ್ರಾಮನ 99 ವರಕ್ಹನೊ ಥಯಲ್ಪರ ಯಹೊವಾ ತಿನೆ ದರ್ಶನ ದಿನ ಕದ್ಯೊ . ಮಿ ಸರ್ವ ಶಕ್ತ ಥಯಲ ಕ್ಹುದಾ; ಮಾರಾ ಕ್ಹಾಮೊ ಕಯುಜ಼ ದೊಶ ನೈಸೊವಾಲೊ ಥೈನ ಚಾ಼ಲ. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />ಮಿ ತಾರಾ ಕ್ಹಾತೆ ವಡಂಬಡಿಕೆ ಕರಿಲ್ಯುಸ; ಘನಿಯೊ ಸಂತತಿಯೊ ಮಿ ತುನೆ ದ್ಯುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 17:2" /><verse number="3" style="v" sid="GEN 17:3" />ಅಬ್ರಾಮ ತಿನೆ ಪಗೆ ಪಡ್ತಾಮಾ ತಿನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />ಮಿ ತಾರಾ ಕ್ಹಾತೆ ಯಕ್ಕ ಒಡಂಡಿಕೆ ಕರಿಲ್ಯುಸ; ತೆ ಸು ವ್ಹೈ ಕದ್ಯಾಮ ತು ಘನ್ನಾ ಜ಼ನಾಂಗನೆ ಮುಲ ಪುರುಷ ಥೈನ ರ‍್ಹಸಿ, <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />ಇತ್ತಿ ಉಪ್ಪರ ತುನೆ ಅಬ್ರಾಮ ಕೈನ ನಾಮ ರ‍್ಹತು ನೈ. ತುನೆ ಘನ್ನಿಯೊ ಜ಼ನಾಂಗೊನೆ ಮುಲ ಪಿತೃಕೈನ ನೆಮ್ಸಲ ಹುತಿ ತುನೆ ಹಬ್ದಾತು ತುನೆ ಅಬ್ರಹಾಮ ಕೈನ ನಾಮ ರ‍್ಹವಸ. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />ತುನೆ ಘನ್ನಾ ಬಚ್ಚಾ಼ ದ್ಯುಸ. ತಾರಾಕ್ಹು ಘನಿಯೊ ಜ಼ನಾಂಗೊ ಹುಟ್ಟಸ ವರಿ ತಿಮಾ ರಾಜಾ಼ಬಿ ಘನ್ನಾ ರ‍್ಹವಸ. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />ಮಿ ತುನೆ ವರಿ ತಾರಿ ಸಂತಾನನೆಬಿ ಕ್ಹುದಾ ಥೈನ ರ‍್ಹೌಸ ತಾರಾಹುತಿ ತಾರಿ ಸಂತತಿನೆ ಮಾತಾ ಮಾತೊವೊ ಲಕ್ಕಾ ತಾರಾ ಕ್ಹಾತೆ ಕರಲಿದಲ ವಡಂಬಡಿಕೆ ಘಟ್ಟಕರುಸ. <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />ತು ಬಿಜಾ಼ ದೆಶವಾಲೊ ಥೈನ ರ‍್ಹಯಲ ಕಾನಾನ ದೆಶ ಪುರಾ ತುನೆ ತಾರಾ ಬಚ್ಚಾ಼ವೊನೆ ಹಮೆಶಾಬಿ ಸುಜ಼ ತ್ರಾಸ ನೈಸೊ ಮುಕ್ಕಿನ ತ್ಯುನೊ ಕ್ಹುದಾ ಥೈನ ರ‍್ಹೌಸ’ ಕದ್ಯೊ. <verse eid="GEN 17:8" /><verse number="9" style="v" sid="GEN 17:9" />ಯಕ್ಲುಜ಼ ನೈಸೊ ಕ್ಹುದಾ ಅಬ್ರಹಾಮನೆ, 'ತುತೊ ಮಾರಾ ಕ್ಹಾತೆ ವಡಂಬಡಿಕೆ ಕರಿಲಿದಲ ವಚಾ಼ಡಿಲಿನ ಜೌ಼. ತು ಯಕ್ಲೊಜ಼ ನೈಸೊ ತಾರಾ ಬಚ್ಚಾ಼ಬಿ ವರಿ ತಾರಿ ಸಂತತಿಬಿ ಹಮೆಶಾಬಿ ಆ ಕ್ಹಾರು ಕೈದಿಲಿನ ಜ಼ೌ. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />ತು ತಾರಿ ಸಂತತಿ ಕೈದಿಲಿನ ಜಾ಼ವಾನು ವಡಂಬಡಿಕೆ ಕಯು ವ್ಹೈ ಕದ್ಯಾಮ, ತಾರಿ ಸಂತತಿಮಾ ರ‍್ಹಯಲ ತೆಕ್ಲಾಬಿ ದಾಣಗಾಬಿ ಖತ್ನಾ ಕರೈಲ್ಯುಜ಼. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />ತೆಜ಼ ಮನೆಬಿ ತುಮೊನೆಬಿ ತಾರಾ ಕ್ಹಾತೆ ಕರಿಲಿದಲ ಒಡಂಬಕೆನಿ ವಳಕ ವ್ಹೈ. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />ಅಗಲ್ಯಾ ಕ್ಹಾರಾ ತಲತಲಾಂತರನೆ ಆವಾಲಾ ಹರಿಯಕ್ಲಾ ಗಂಡ ಪಟ್ಟಾನೆ ಆಟ ದಿನ್ನ ಥಯಲ್ಪರ ಖತ್ನಾ ಕರೌ ಗರ್ಮಾ ಹುಟ್ಟಲ ರ‍್ಹೈನೆಕಾ ತಾರಿ ಸಂತತಿಮಾ ವರಿ ಬಿಜಾ಼ ಬಚ್ಚಾ಼ ರ‍್ಹೈನೆಕಾ ಬಿಜಾ಼ವೊಕ್ಹು ಕಿಮ್ಮತ ದಿನ ಲಿದಲ ರ‍್ಹೈನೆಕಾ. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />ಇಮ್ಮ ಹರಿಯಕ್ಲಾನೆಬಿ ಖತ್ನಾ ಥೌ. ಮಿ ತರಾ ಕ್ಹಾತೆ ಕರಿಲಿದಲ ಒಡಂಬಡಿಕೆ ಶಾಶವತ ರಹೆಲ ವ್ಹೈ ಕವಾನೆ ಆ ಖತ್ನಾಜ ದೈಹಿಕ ಗುರುತ ವ್ಹೈ. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />ಖತ್ನಾ ನೈ ಥಯಲ ದಾಣಗೊ ಮಾರಿ ಒಡಂಬಡಿಕೆನೆ ವಿದೆಯ ನೈ ತಯೆಲ ಕರಣ ಕ್ಹು ತಿನೆ ಜಾತ ಮಾತಾ ಭಾರಾ ಘಾಲು” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 17:14" /><verse number="15" style="v" sid="GEN 17:15" />ಕ್ಹುದಾ ಅಬ್ರಹಾಮನೆ, 'ತಾರಿ ಬೈಕೊ ಥಯಲ, ಸಾರಯಳನೆ ಮಿ ಯಕ್ಕ ನಾಮ ದ್ಯುಸ. ತಿನು ನವು ಸಾರಾ. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />ಮಿ ತಿನೆ ಆಶಿರ್ವಾದ ಕರಿನ ತಿನೆ ಯಕ ದಿಕ್ರೊ ದಿವುಸ; ತುಜ಼ ತಿನೊ ಬಾಪ ವ್ಹೈ. ಘನಾ ಜ಼ನಾಂಗೊನೆ ರಾಜಾ಼ವೊನೆ ತೆ ಮೂಲಮಾತೆ ಥೈನ ರವಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 17:16" /><verse number="17" style="v" sid="GEN 17:17" />ಅಬ್ರಹಾಮ ಕ್ಹುದಾನೆ ಅಡಪಡಿನ ನಮಸ್ಕರ ಕರ್ಯೊ. ತೆನೈಸೊ ತೆ ಮನಸಮಾಜ ಅಕ್ಹತೊ, 'ಮನೆ ಕ್ಹೊ ವರಕ್ಹ ಥಯಲ ಹುತಿ ದಿಕ್ರಾನೆ ಪಡದಿಲಿವಾನೆ ಮನೆಬಿ ಸಾದ್ಯ ನತ್ತಿ. ಸಾರಳನೆ ನೌವ್ವದ ವರಕ್ಹ ಥಯಲ ಹುತಿ ದಿಕ್ರಾನೆ ಪಡದಿಲಿವಾನಾ ಹುತಿ ತಿನೆಬಿ ಸಾಧ್ಯ ನತ್ತಿ” ಕೈಲಿದ್ಯೊ. <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />ಪಾಚಾ಼ತೊ ಅಬ್ರಹಾಮ ಕ್ಹುದಾನೆ,'ಇಷ್ಮಾಯೆಲ ತಾರಿ ಆಶಿರ್ವಾದ ಹೊಂದಿಲಿನ ಜಿವ್ತೊ ರ‍್ಹೈ ನೈಕಾ ಕೈನ ಪುಚ್ಯೊ. <verse eid="GEN 17:18" /><verse number="19" style="v" sid="GEN 17:19" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ತಿನೆ 'ನೈ! ತಾರಿ ಬೈಕೊ ಥಯಲ ಸಾರಳನೆ ಯಕ ದಿಕ್ರೊ ಹುಟ್ಟಸ. ತು ತಿನೆ, 'ಇಸಾಕ” ಕೈನ ನಾಮ ಮ್ಹೆಲು. ಮಿ ಯಕ್ಕ ಒಡಂಬಡಿಕೆ ತಿನಾಕ್ಹಾತೆ ಕರಿಲ್ಯುಸ. ತೆ ಒಡಂಬಡಿಕೆ ತಿನಾ ಕ್ಹಾರಾ ಸಂತತಿವಾಲಾವೊಮಾಬಿ ಹಮೆಶಾ ರವಸ. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />'ತು ಇಷ್ಮಾಯೆಲನಾ ಹುತ್ತಿ ಕರಲ ಬಿನ್ನಹ ಐಕ್ಯೊಸ ಮಿ ತಿನೆ ಆಶಿರ್ವಾದ ಕರುಸ. ತೆ ಘನ್ನಾ ಬಚ್ಚಾವೊನೊ ಬಾಪ ಥಾವಸ. ಬಾರಾ ಮ್ಹೊಟಾ ನಾಯಕೊನೆ ತೆ ಬಾಪ ಥಾವಸ. ತಿನಿ ಸಂತತಿ ಮ್ಹೊಟಿ ಜ಼ನಾಂಗ ಥಾವಸ. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />ತೆನೈಸೊ ಮಿ ಮಾರಿ ಒಡಂಬಡಿಕೆ ಇಸಾಕನಾ ಕ್ಹಾತೆ ಕರಿಲ್ಯುಸ. ಸಾರಳನೆ ಹುಟ್ಟಾನೊ ದಿಕ್ರೊಜ ಇಸಾಕ ವ್ಹೈ. ಅಗಲ್ಯಾ ವರಕ್ಹಮಾ ಎಜ ಟೈಮಮಾ ಇಸಾಕ ಹುಟ್ಟಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />ಕ್ಹುದಾ ಅಬ್ರಹಾಮನಾ ಕ್ಹಾತೆ ಬೊಲಾನು ಕ್ಹರಾಯಲ್ಪರ ತಿಕಂತೊ ಉಪ್ಪರ ಗೈಪಡೊ. <verse eid="GEN 17:22" /><verse number="23" style="v" sid="GEN 17:23" />ತೆಜ಼ ದಿನ್ನಮಾ ಅಬ್ರಹಾಮ ಇಷಮಾಯೆಲನೆಬಿ ತಿನಾ ಘರ್ಮಾ ರಯಲ ಆಳೊನೆ ಹುಟ್ಟಲ ಗಂಡ ಬಚ್ಚಾವೊನೆಬಿ ಭಾರಲ್ಯಾ ದೆಶತಾ ದೊಕಡೆ ಲಿನ ಆಯಲ ಆಳೊನೆಬಿ ಕ್ಹುದಾ ಕದಲ ತಿಮ್ಮಜ಼ ಖತ್ನಾ ಕರಾಯೊ. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />ಅಬ್ರಹಾಮ ಖತ್ನಾ ಕರೈಲಿದಲ್ಪರ ನೌವ್ವದಪರ ನೌ ವರಕ್ಹನೊ ವ್ಹತ್ತೊ. <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />ಇಷ್ಮಾಯೆಲನೆ ಖತ್ನಾ ಥಯಲ್ಪರ ತೆರಾ ವರಕ್ಹ ಥಯಾತಾ. <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />ಅಬ್ರಹಾಮನೆಬಿ ಇಸ್ಮಾಯಿಲನೆ ಯಕ್ಕಜ಼ ದಿನ್ನಮಾ ಖತ್ನಾ ಥೈತಿ. <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />ಅಬ್ರಹಾಮನಾ ಘರ್ಮಾ ರಯಲ ಕ್ಹಾರಾ ದಾಣಗಾವೊನೆ ಕದ್ಯಾಮ ತಿನಾ ಘರ್ಮಾ ಹುಟ್ಟಲ ಕ್ಹಾರಾ ಅಳೊನೆ ವರಿ ತೆ ದೊಕಡೆ ಲಿನ ಆಯಲ ಕ್ಹಾರಾ ಆಳೊನೆ ಖತ್ನಾ ಥೈ.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">ಅಬ್ರಹಾಮನೆ ಕ್ಹುದಾ ದಿದಲ ವಾಗ್ದಾನ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />ಯಹೊವಾ ಅಬ್ರಹಾಮನೆ ಮಮ್ರೆನಾ ಓಕ ಝಾಡೊಕನ ದಿಕ್ಹ್ಯೊ. ದಿನ್ನನಾ ಘನ್ನೊ ತಡ್ಕೊ ಪಡಾನಾ ಟೈಮಮಾ ಅಬ್ರಹಾಮ ತಿನಾ ಗುಡಾರನಾ ವ್ಹಚ್ಚಲಕನ ಬೈಟ್ಯೊತೊ. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />ತೆಳಾಮಾ ತೆ ಮಾತು ಉಚೈನ ದೆಕತಾಮಾ ತ್ಯಾ ತನ್ನ ಜ಼ನಾ ಹುಬ್ರಯಲ ದೆಕ್ಯೊ. ತಿವನೊನೆ ದೆಕಲ ಬರೊಬರ ತಿವನೊನೆ ಮಳಾನೆ ನ್ಹಾಟಿನ ಗೈನ ಅಡ್ಡಪಡಿನ ತಿವನೊನೆ, <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />'ಸ್ವಾಮಿಯೊ, ತುಮಾರೊ ಸೆವಕ ಥಯಲ ಮಾರಾ ಕ್ಹಾತೆ ದಕ್ಹಿಯೆಳ ರವೊ. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />ತುಮಾರಾ ಪಗೊ ಧವಾನಾ ಹುತ್ತಿ ಪಾನಿ ಲೈನ ದ್ಯುಸ. ತುಮೆ ಝಾಡೊನಾ ಹೆಟಾ ಅರಾಮ ಕರೊ. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />ಮಿ ತುಮೊನೆ ಅನ್ನ ಲೈನ ದ್ಯುಸ. ತುಮೆ ಚಾ಼ಯೆ ತೆಕ್ಲು ಅನ್ನ ಖಾದಲ್ಪರ ತುಮಾರಿ ಪ್ರಯಾಣ ಅಗಾ ಜಾ಼ಸಕೊಶಿ.” ಕೈನ ಕದ್ಯೊ. ತೆ ತನ್ನೆ ದಾಣಗಾ, 'ಹು, ತು ಕದಲ ತಿಮ್ಮಜ಼ ಕರ” ಕದ್ಯಾ. <verse eid="GEN 18:5" /><verse number="6" style="v" sid="GEN 18:6" />ಅಬ್ರಹಾಮ ಗುಡಾರೆ ಭೆಗಿನ ಗೈನ ಸಾರಳನೆ, 22 ಮಾಪ್ಟಾ ಯಕ್ಲು ಘೌಂನೊ ಲೊಟ ಭೆಗಿನ ಮಕ್ಹಳ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 18:6" /><verse number="7" style="v" sid="GEN 18:7" />ಪಾಚಲ್ತೊ ತೆ ತಿನಾ ಜಾನ್ವರೊ ರ‍್ಹಯಲ ಜ಼ಗಾಯೆ ನ್ಹಾಟಿನ ಗೈನ ಚೊ಼ಕು ರ‍್ಹಯಲ ಬೈಲನಾ ಬಚ್ಚಾ಼ನೆ ಲಿನ ಆಳನೆ ದಿನ, 'ಭೆಗಿನ ಬೈಲನಾ ಬಚ್ಚಾ಼ನೆ ಕತ್ರಿನ, ಖಾವಾನೆ ತಯ್ಯಾರ ಕರ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />ಅಬ್ರಹಾಮ ತೆ ತನ್ನೆ ಜ಼ನಾವೊನೆ ಮಾಕ್ಹನು ಅನ್ನ ವರಿ ಮಸರ ವಾಡ್ಯೊ. ತೆ ತನ್ನೆ ಜ಼ನಾ ಅನ್ನ ಖಾತಾಮಾ ಅಬ್ರಹಾಮ ತಿವ್ನಾ ನಜಿಕ ಝಾಡನಾ ಹೆಟೊ ಹುಬ್ರಯೊತೊ. <verse eid="GEN 18:8" /><verse number="9" style="v" sid="GEN 18:9" />ತೆ ದಾಣ್ಗಾ ಅಬ್ರಹಾಮನೆ, 'ತಾರಿ ಬೈಕೊ ಥಯಲ ಸಾರಳ ಕಿಜಾ಼ ಛೆ?” ಕೈನ ಪುಚ್ಯಾ. ಅಬ್ರಹಾಮ ತಿವ್ನೊನೆ, 'ತೆ ಗುಡಾರಮಾ ಛೆ” ಕದ್ಯೊ. <verse eid="GEN 18:9" /><verse number="10" style="v" sid="GEN 18:10" />ತೆಳಾಮಾ ತ್ಯುನೊಮಾನೊ ಯಕ್ಲೊ, 'ಮಿ ವರಿ ಅಗಲ್ಯಾ ವರಕ್ಹ ಎಜ಼ ಟೈಮ್ಮಾ ಔಸ. ತೆ ಟೈಮಮಾ ತಾರಿ ಬೈಕೊ ಥಯಲ ಸಾರಳನೆ ಯಕ ದಿಕ್ರೊ ರಹವಸ” ಕೈನ ಕದ್ಯೊ. ಸಾರಲ ಗುಡಾರಮಾ ರೈನ ಎ ಕ್ಹಾರು ಐಕಾಡಿತಿ. ತಿನೆ ಎ ಸಂಗತಿಯೊ ಐಕಿ. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />ಅಬ್ರಹಾಮ ವರಿ ಸಾರಳ ಘನ್ನಾ ಗಡಿಯಾ ಡೊಕ್ಹಲಿ ಥಯಾತಾ. ಸಾರಳನೆ ಬಚ್ಚಾ ಹುಟ್ಟಾನು ಟೈಮ ಥೈನ ಗಯೊತೊ. <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />ತಿನಾಹುತಿ ಸಾರಳನೆ ಬರೊಕ್ಹೊ ಕರಾನೆ ಥಯೂ ನೈ. ತೆ ತಿನಾ ಮನಸ್ಮಾ, 'ಹಮ್ನಾಜ಼ ಮಾರಿ ವೈಸ ಥೈ ಗೈಸ ಹಮೆ ಶಾರಿರಿಕ ಸಂಭಂದ ಕರಾನೆ ಥಾವಸ್ಸು?; ಮಾರಾ ಮಾಟಿನೆಬಿ ವೈಸ ಥೈ ಗೈಸ” ಕೈನ ಕೈಲಿದಿ. <verse eid="GEN 18:12" /><verse number="13" style="v" sid="GEN 18:13" />ತೆಳಾಮಾ ಯಹೊವಾ ಅಬ್ರಹಾಮನೆ, 'ಮಿ ಕವಾನು ಸಾರಳ ಬರೊಕ್ಹೊ ಕರಾಡಿ ನತ್ತಿ. ತೆ ಅಕ್ಹ್ತಿ ತಿನಾ ಮನಸ್ಮಾ, ‘ಮನೆ ಬಚ್ಚಾ ನೈ ಥಾವಾ ಯಕ್ಲಿ ವೈಸ ಥೈ ಗೈಸ’ ಕೈನ ಶಾನೆ ಕದಿ? <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />ಯಹೊವಾನೆ ಅಸಾದ್ಯ ರ‍್ಹಯಲ ಛೆ ಸು? ಮಿ ವರಿ ಅಗಲ್ಯಾ ವರಕ್ಹಮಾ ಎಜ಼ ಟೈಮ್ಮಾ ಔಸ. ತೆಳಾಮಾ ತಾರಿ ಬೈಕೊ ಥಯಲ ಸಾರಳನೆ ಯಕ್ಕ ದಿಕ್ರೊ ರ‍್ಹವಸಜ಼” ಕದ್ಯೊ. <verse eid="GEN 18:14" /><verse number="15" style="v" sid="GEN 18:15" />ತೆನೈಸೊ ಸಾರಳ ಭುಚ್ಕಿನ, 'ಮಿ ಅಕ್ಹಿ ನತ್ತಿ” ಕದಿ. ತಿನಾಹುತಿ ಯಹೊವಾ, 'ನ್ಹವೈ, ತು ಅಕ್ಹಲ ಕ್ಹರಿಜ಼಼ ವ್ಹೈ!” ಕದ್ಯೊ.<verse eid="GEN 18:15" /></para>
  <para style="s">ಸೊದೊಮನಾ ಹುತಿ ಅಬ್ರಹಾಮ ಮಾಂಗಿಲಿವಾನು</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />ಪಾಚಲ್ತಾ ತೆ ದಾಣಗಾ ಜಾ಼ವಾನೆ ಉಟಿನ ಹುಬ್ರಯಾ. ತ್ಯುನೆ ಸೊದೊಮ ಕನ ಡೊಳಾ ಉಚೈನ ದೆಕಿನ ತ್ಯಾ ಜಾ಼ವಾನೆ ಶುರುಕರ‍್ಯಾ. ತ್ಯುನೊನೆ ವಳಾವಾನೆ ಅಬ್ರಹಾಮ ತ್ಯುನಾ ಕ್ಹಾತೆ ದಕ್ಹೊ ದುರ ಗಯೊ. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />ಯಹೊವಾ ತಿನಾಮಾ ಇಮ್ಮ ಕೈಲಿದ್ಯೊ: 'ಮಿ ಹಮ್ನಾ ಕರಾನು ಕಾಮ ಅಬ್ರಹಾಮನೆ ಕೌ ಸು? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />ಅಬ್ರಹಾಮಕ್ಹು ತಾಕತವರ ಮ್ಹೊಟಿ ಜ಼ನಾಂಗ ಹುಟ್ಟಸ; ತಿನಾ ಮುಲಕ ಎ ಲೊಕನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಶಿರ್ವಾದ ಹೊಂದಿಲಿವಸ. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />ಮಿ ತಿನಾ ಕ್ಹಾತೆ ಖಾಸ ಒಡಂಬಡಿಕೆ ಕರಿಲಿದ್ಯೊಸ. ತೆ ತಿನಾ ಬಚ್ಚಾವೊನೆಬಿ ಸಂತತಿವಾಲಾವೊನೆಬಿ ಮನೆ ವಿಧೆಯ ಥಾಯೆ ನಿಂಗತ ವರಿ ನ್ಯಾಯ ನಿತಿಕ್ಹು ಜಿವ್ನಾ ಕರೆ ನಿಂಗತ ಆಗನ್ಯಾ ಕರು ಕೈನ ಮಿ ತಿನಾ ಕ್ಹಾತೆ ಒಡಂಬಡಿಕೆ ಕರಿಲಿದ್ಯೊ. ತ್ಯುನೆ ಇಮ್ಮ ಜಿವ್ನಾ ಕರ‍್ತಾಮ, ಮಾರಾ ವಾಗ್ದಾನೊ ಕ್ಹಾರಾ ಪುರಾ ಕರುಸ.” <verse eid="GEN 18:19" /><verse number="20" style="v" sid="GEN 18:20" />ತೆನೈಸೊ ಯಹೊವಾ, 'ಸೊದೊಮ ವರಿ ಗೊಮೊರನಾ ಮನಕ್ಹೊ ಘನ್ನಾ ರವಾನು ವರಿ ದುಖ ಖಾವಾನು ಘನ್ನು ಜಾಸ್ತ ಥಯುಸ. ತೆ ಗಾಮನಾ ಮನಕ್ಹೊನು ಪಾಪ ಘನ್ನು ಜಾಸ್ತ ಥಯುಸ, <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />ತ್ಯುನು ಅಡ್ಡಾನು ಮನೆ ಐಕು ಐಸ ತಿನಾಹುತಿ ಮಿ ಹೆಟೊ ಉತ್ರಿನ ತ್ಯಾ ಗೈನ ಮಿ ಐಕಲ ಕ್ಹರಿಜ಼ ವ್ಹೈ ಸು ಕೈನ ಪರಿಕ್ಷಾ ಕರುಸ” ಕದ್ಯೊ. <verse eid="GEN 18:21" /><verse number="22" style="v" sid="GEN 18:22" />ತಿನಾಹುತಿ ತೆ ದಾಣಗಾ ಸೊದೊಮ ಕನ ಜಾ಼ವಾನು ಶುರು ಕರ‍್ಯಾ. ತೆನೈಸೊ ಅಬ್ರಹಾಮ ಯಹೊವಾನಾ ಕ್ಹಾಮೊ ಹುಬ್ರಯೊತೊ. <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />ಅಬ್ರಹಾಮ ಯಹೊವಾನಾ ನಜಿಕ ಐನ, 'ಯಹೊವಾ, ತು ಕೆಟ್ಟ ಮನಕ್ಹೊನೆ ನಾಶ ಕರ‍್ತಾಮಾ ನಿತಿವಂತವಾಲಾವೊನೆ ಬಿ ನಾಶ ಕರು ಕೈನ ಕರ‍್ಯೊಸ ಸು? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />ಯಕ್ಕೆಳೆ ತೆ ಗಾಮಮಾ ಐವ್ವತ್ತ ಜ಼ನಾ ನಿತಿವಂತವಾಲಾ ರ‍್ಹಯಾಮ ಸು ಕರ್ಶಿ? ತು ತೆ ಗಾಮನೆ ನಾಶ ಕರ್ಶಿ ಸು? ಕ್ಹರಿಬಿ ನೈ! ತ್ಯಾ ರ‍್ಹವಾನಾ ಐವ್ವತ್ತ ಜ಼ನಾ ನಿತಿವಂತವಾಲಾವೊನಾ ಹುತಿ ತು ತೆ ಗಾಮನೆ ವಚಾ಼ಡಶಿ? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />ಕ್ಹರಿಮಾಜ಼ ತು ತೆ ಗಾಮನೆ ನಾಶ ನೈ ಕರ್ತೊ. ಕೆಟ್ಟ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಖಲಾಸ ಕರಾನಾ ಹುತಿ ತು ನಿತಿವಂತವಾಲಾವೊನೆ ಖಲಾಸ ನೈ ಕರ್ತೊ. ಯಕ್ಕೆಳೆ ತು ಖಲಾಸ ಕರ್ಯೊಮ, ಚೊ಼ಕಾ ಕೆಟ್ಟ ಯಕ್ಕಜ಼ ಥಾವಸ. ತ್ಯುನೆ ಭಂಬಿ ಜ಼ನಾ ಶಿಕ್ಷಾನೆ ಗುರಿ ಥಾವಸ. ತು ದುನಿಯಾಮಾ ರ‍್ಹಯಲವಾಲಾ ಕ್ಹಾರಾವೊನೆ ನ್ಯಾಯಾದಿಪತಿ ಥಯೊಸ ನೈ?. ತು ನ್ಯಾಯ ರ‍್ಹಯಲಜ ಕರ್ಶಿ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 18:25" /><verse number="26" style="v" sid="GEN 18:26" />ಪಾಚಲ್ತೊ ಯಹೊವಾ, 'ಸೊದೊಮಮಾ ಐವ್ವತ್ತ ಜ಼ನಾ ನಿತಿವಂತವಾಲಾವೊನೆ ದೆಕ್ಯೊಮ, ಮಿ ಪುರಾ ಗಾಮನೆ ವಚಾ಼ಡುಸ” ಕದ್ಯೊ. <verse eid="GEN 18:26" /><verse number="27" style="v" sid="GEN 18:27" />ತೆಳಾಮಾ ಅಬ್ರಹಾಮ ಯಹೊವಾನೆ, 'ತುನೆ ಮಾರಾಕ್ಹು ಹೊಲಿಸಿ ಲಿದ್ಯಾಮ, ಮಿ ಕ್ಹಾಲಿ ಮಾತಿ ವರಿ ರಾಕ ವ್ಹೈ. ತೆನೈಸೊ ಎ ಸವಾಲ ಪುಚ್ಚಾ಼ನೆ ಮನೆ ಮೌಕೊ ದೆ. <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />ಯಕ್ಕೆಳೆ ಪಾಂಚ಼ ಜ಼ನಾ ಕಮ್ಮ ಥಯಾರೆ ಚಾಳಕ್ಹಪರ ಪಾಂಚ಼ ಜ಼ನಾ ಕ್ಹಾಲಿ ನಿತಿವಮತವಾಲಾ ರ‍್ಹಯಾಮ ತೆ ಗಾಮನೆ ನಾಶ ಕರ್ಶಿ ಸು?” ಕೈನ ಪುಚ್ಚೊ. ತಿನಾಹುತಿ ಯಹೊವಾ ತಿನೆ, 'ಮಿ ಚಾಳಕ್ಹಪರ ಪಾಂಚ ಜ಼ನಾ ನಿತಿವಂತವಾಲಾವೊನೆ ದೆಕ್ಯೊಮ ತೆ ಗಾಮನೆ ನಾಶ ನೈ ಕರ್ತೊ” ಕಯನ ಕದ್ಯೊ. <verse eid="GEN 18:28" /><verse number="29" style="v" sid="GEN 18:29" />ವರಿ ಅಬ್ರಹಾಮ ಕ್ಹುದಾನೆ, 'ಕ್ಹಾಲಿ ಚಾಳಕ್ಹ ಜ಼ನಾ ನಿತಿವಂತವಾಲಾವೊನೆ ದೆಕ್ಯೊಮ, ತು ತೆ ಗಾಮನೆ ನಾಶ ಕರ್ಶಿ ಸು?” ಕೈನ ಪುಚ್ಯೊ. ಯಹೊವಾ ತಿನೆ, 'ಚಾಳಕ್ಹ ಜ಼ನಾ ನಿತಿವಂತವಾಲಾವೊನೆ ದೆಕ್ಯೊಮ ಮಿ ತೆ ಗಾಮನೆ ನಾಶ ನೈ ಕರ್ತೊ” ಕೈನ ಕದ್ಯೊ <verse eid="GEN 18:29" /><verse number="30" style="v" sid="GEN 18:30" />ಪಾಚಲ್ತೊ ಅಬ್ರಹಾಮ, 'ಪ್ರಭು, ಮಪರ ಶಿಟ್ಟ ಥೌ ನಕೊ. ಎ ಸವಾಲ ಪುಚ್ಚು಼ಸ ತೆ ಗಾಮಮಾ ಕ್ಹಾಲಿ ಮುವ್ವತ್ತ ಜ಼ನಾ ನಿತಿವಂತವಾಲಾ ರ‍್ಹಯಮ ತು ತೆ ಗಾಮನೆ ನಾಶ ಕರ್ಶಿ ಸು?” ಕೈನ ಪುಚ್ಯೊ. ಯಹೊವಾ ತಿನೆ, 'ತ್ಯಾ ಮುವ್ವತ್ತ ಜ಼ನಾ ನಿತಿವಂತವಾಲಾ ರ‍್ಹಯಾಮ ಮಿ ತೆ ಗಾನೆ ನಾಶ ನೈ ಕರ್ತೊ” ಕದ್ಯೊ. <verse eid="GEN 18:30" /><verse number="31" style="v" sid="GEN 18:31" />ಪಾಚಾ಼ತೊ ಅಬ್ರಹಾಮ, 'ಮಾರೊ ಯಹೊವಾ ಸುಜ಼ ತಿಳ್ದಿಲ್ಯು ನೈ. ಮಿ ವರಿ ಯಕ್ಕ ಸವಾಲ ಪುಚ್ಚು಼ಸ. ತ್ಯಾ ಇಕ್ಹ ಜ಼ನಾ ನಿತಿವಂತವಾಲಾ ರ‍್ಹಯಮ ಸು ಕರ್ಶಿ?” ಕೈನ ಪುಚ್ಯೊ. ಯಹೊವಾ ತಿನೆ, 'ತ್ಯಾ ಇಕ್ಹ ಜ಼ನಾ ನಿತಿವಂತವಾಲಾ ರ‍್ಹಯಮ ತೆ ಗಾಮನೆ ಮಿ ನಾಶ ನೈ ಕರ್ತೊ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 18:31" /><verse number="32" style="v" sid="GEN 18:32" />ಪಾಚ಼ಲ್ತೊ ಅಬ್ರಹಾಮ, 'ಯಹೊವಾ, ದಯಾ ಕರಿನ ಮಪರ ಶಿಟ್ಟ ಥೌ ನಕೊ. ಎ ಯಕ್ಕ ಸಲಾ ಕ್ಹಾಲಿ ಸವಾಲ ಪುಚ್ಚುಸ. ದಕ್ಹ ಜ಼ನಾ ನಿತಿವಂತವಾಲಾವೊನೆ ದೆಕ್ಯೊಮ ಸು ಕರ್ಶಿ?” ಕೈನ ಪುಚ್ಯೊ. ಯಹೊವಾ ತಿನೆ, 'ಮಿ ತೆ ಗಾಮಮಾ ದಕ್ಹ ಜ಼ನಾ ನಿತಿವಂತವಾಲಾವೊನೆ ದೆಕ್ಯೊಮ, ತಿನೆ ನಾಶ ನೈ ಕರ್ತೊ” ಕದ್ಯೊ. <verse eid="GEN 18:32" /><verse number="33" style="v" sid="GEN 18:33" />ಯಹೊವಾ ಅಬ್ರಹಾಮನಾ ಕ್ಹಾತೆ ಬೊಲಾನು ಕ್ಹರಾಯಲ್ಪರ ತ್ಯಾಂತೊ ಗೈಪಡ್ಯೊ. ಅಬ್ರಹಾಮಬಿ ತಿನಾ ಘರೆ ವಾಪಸ ಗಯೊ.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">ಸೊದೊಮೊ ಗೊಮೊರನು ಪಾಪ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />ತೆ ದೆವದುತೊ ಕ್ಹಾಂಜ಼ನಾ ಟೈಮ್ಮಾ ಸೊದೊಮೆ ಆತಾಮಾ ಲೊಟ ಕವಾನೊ ಯಕ್ಕ ಮನಕ್ಹ ಗಾಮ್ನಾ ಬಾಕಲನಾ ಕ್ಹಾಮೊಜ಼ ಬೈಟ್ಯೊತೊ. ತೆ ತ್ಯುನೊನೆ ದೆಕ್ತಾಮಾ ಉಟಿನ ಹುಬ್ರೈನ ತ್ಯುನೊನೆ ಮಳಾನೆ ಗೈನ ಡ್ವಗ್ಗಿನ ನಮಸ್ಕಾರ ಕರ‍್ಯೊ. <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />ಲೊಯಾ ತ್ಯುನೊನೆ, 'ಸ್ವಾಮಿಯೊ ಮರ್ಗಿನ ಮರಾ ಘರೆ ಆವೊ ಮಿ ತುಮೊನೆ ಖಾವಾನೆ ದ್ಯುಸ ತುಮಾರಾ ಹತೊ ಪಗೊ ಧ್ವಯಿನ ಆಜ಼ನಾ ರಾತೆ ಮಾರಾ ಘರ್ಮಾ ರ‍್ಹವೊ. ವ್ಹಂತಾ ತುಮಾರು ಪ್ರಯಾಣ ಅಗಾ ಚ಼ಲಾವೊ ಕೈನ ಕದ್ಯೊ. ದೆವದುತೊ ಒಣಿಮಾ ಆಜ಼ನಿ ರಾತ ಕಾಡಿಯೆಸ. <verse eid="GEN 19:2" /><verse number="3" style="v" sid="GEN 19:3" />ತೆ ನೈಸೊ ಲೊಟಾ ತಿನಾ ಘರೆ ಔಜ಼ ಕೈನ ಕದಲ ಹುತಿ ತ್ಯುನೆ ತಿನಾ ಘರೆ ಗಯಾ. ಲೊಟಾ ತ್ಯುನಾ ಹುತಿ ಖಾಟೊ ನೈಸೊ ರೊಕ್ಲೊ ಬಳೈನ ಅನ್ನ ಕರಾಯೊ. ದೆವದುತೊ ತೆ ಅನ್ನ ಖಾದ್ಯಾ. <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />ತೆ ರಾತೆ ಕ್ಹುರಾವಾತಿ ಅಗ್ದುರ ಸೊದೊಮೊನಾ ಕ್ಹಾರಾ ಡಾಣಗಾ ವರಿ ಗಡಿಯಾ ಐನ ಲೊಟಾನಾ ಘರ್ನಾ ಸುತ್ತೆ ಹುಬ್ರೈನ ಲೊಟನೆ <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />ತಾರಾ ಘರೆ ಆಯಲ ತೆ ಭಂಭಿ ದಾಣಗಾ ಕಿಜ್ಗಾ ಛೆ?. ತ್ಯುನೊನೆ ಭಾರೊ ಮೊಕಲ ಹಮೆ ತ್ಯುನೊನೆ ಸಂಭೊಗ ಕರು ಅಡ್ಡಿನ ಕದ್ಯಾ. <verse eid="GEN 19:5" /><verse number="6" style="v" sid="GEN 19:6" />ಲೊಟಾ ಭಾರೊ ಐನ ಬಾಕಲನೆ ಚಾ಼ವಿ ಘಾಲ್ಯೊ. <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />ತೆ ದಾಣಗಾವೊನೆ ಮಾರಾ ಭಾಯೊ ಮಿ ತುಮೊಕನ ಮಾಂಗಿವಾಡೊಸ. ಮರ್ಗಿನ ಎ ಕೆಟ್ಟ ಕಾಮ ಕರೊ ನಕೊ. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />ದೆಕೊ ಮನೆ ಬೆ ದಿಕ್ರಿಯೊ ಛೆ. ತ್ಯುನೆ ಕೆಳಾಮಾಜ಼ ಬಿಜಾ಼ ದಾಣಗಾವೊನಾ ಕ್ಹಾತೆ ಕ್ಹುರೈಯೊ ನತ್ತಿ. ತುಮಾರು ಮನಸ ರ‍್ಹಯುಮ ತ್ಯುನೊನೆ ಭಾರೊ ಲೌಸ ತುಮೆ ತ್ಯುನೊನೆ ಸುಬಿ ಕರೊ. ತೆನೈಸೊ ಆ ದಾಣಗಾವೊನೆ ಸುಜ಼ ಕರೊ ನಕೊ. ಇವ್ನೆ ಮಾರಾ ಘರೆ ಆಯಾಸ. ಇವ್ನೊನೆ ವಚಾ಼ಡಾನು ಮಾರು ಧರಮ ವ್ಹೈ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 19:8" /><verse number="9" style="v" sid="GEN 19:9" />ಘರ್ನಾ ಸುತ್ತೆ ಹುಬ್ರಯಲ ದಾಣಗಾ ತಿನೆ ವಾಟ ಛೊಡ ಕೈನ ವದರ‍್ಯಾ ತೆ ಥಯಲ್ಪರ ತ್ಯುನೊಮಾ ಎ ಲೊಟಾ ಅಪ್ನಾ ಗಾಮೆ ಪ್ರವಾಸಿಯೊ ಥೈನ ಆಯಲ ಹಮ್ನಾ ಹಮೊನೆ ನ್ಯಾಯ ಕೈನ ದಿವಾಡೊಸ ಕೈನ ಕದ್ಯಾ. ತೆ ಥಯಲ್ಪರ ಲೊಟನೆ ತ್ಯುನೆ ಹಮೆ ತೆ ದಾಣಗಾವೊನೆ ಕರಾತಿ ಬಿ ಕೆಟ್ಟ ತಾರಾ ಕ್ಹಾತೆ ಕರಿಯೆಸ ಕೈನ ವದ್ರಿನ ಕೈನ ಲೊಟನಾ ನಜಿಕ ಐನ ಬಾಕಲ ಭಾಗಾನೆ ತಯ್ಯಾರ ಥಯಾ. <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />ವರಿ ತೆ ಘರ್ಮಾ ರ‍್ಹಯಲ ಭಂಬಿ ದಾಣಗಾ ಬಾಕಲ ಕಾಡಿನ ಲೊಟನೆ ಘರ್ಮಾ ಜ಼ಗ್ಗಿಲಿನ ಬಾಕಲ ಝಾಕ್ಯಾ. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />ತೆ ಭಂಬಿ ದಾಣಗಾ ಭಾರಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ದಾಣಗಾವೊನೆ ಕುಡ್ಡಾ ಕರಲ ಹುತಿ ತ್ಯುನೆ ಬಾಕಲನೆ ದುಂಡ್ಯಾವಾಚಿ ಗೈಪಡ್ಯಾ.<verse eid="GEN 19:11" /></para>
  <para style="s">ಸೊದೊಮತೊ ಲೊಟಾ ವಾಚಿ಼ನ ಜಾ಼ವಾನು</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />ತೆ ಭಂಬಿ ದಾಣಗಾ ಲೊಟನೆ ತಾರಾ ಕುಟುಂಬನಾ ಬಿಜಾ಼ ಕುನಬಿ ಎ ಗಾಮ್ಮಾ ಛೆ ಸು?. ತುನೆ ಜ಼ಮೈ ರ‍್ಹವಾದೆ ಗಂಡ ಬಚ್ಚಾ಼ ಹೆಣ್ಣ ಬಚ್ಚಾ಼ ರ‍್ಹವಾದೆ ನ್ಹ್ಯಾ ಛೆ ಸು? ತಾರಾ ಕುಟುಂಬನಾ ಕುನಬಿ ಎ ಗಾಮ್ಮಾ ರ‍್ಹಯಾಮ ಹಮ್ನಾಜ಼ ನ್ಹ್ಯಾಂತಾ ಜಾ಼ವಾನೆ ಕೆ. <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />ಹಮೆ ಎ ಗಾಮ್ನೆ ನಾಶ ಕರಿಪಾಡಿಯೆಸ. ಎ ಗಾಮನು ದುಷ್ಠತನಾ ಯಹೊವಾ ದೆಕ್ಯೊಸ. ತಿನಾಹುತಿ ಎ ನಾಶ ಕರಾನೆ ತೆಜ಼ ಹಮ್ನೊನೆ ವಳಾಯೊಸ ಕದ್ಯಾ. <verse eid="GEN 19:13" /><verse number="14" style="v" sid="GEN 19:14" />ತಿನಾಹುತಿ ಲೊಟಾ ಭಾರೊಗೈನ ತ್ಯುನೊನೆ ತಿನಾ ದಿಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ನಾತ್ರು ಥಯಲ ಜ಼ಮೈಯೊನಾ ಕ್ಹಾತೆ ಬೊಲ್ಲಿನ ಭೆಂಬಿ ಜ಼ನಾ ಎ ಗಾಮ್ಮ ಛೊಡಿನ ಜಾ಼ವೊ ಯಹೊವಾ ಎ ಗಾಮ್ಮ ಹಾಳಕರಸ ಕೈನ ಕದ್ಯೊ. ಲೊಟಾನಿ ಎ ವಾತ ತ್ಯುನೊನೆ ಮಸ್ಕರಿ ಲಾಗಿ. <verse eid="GEN 19:14" /><verse number="15" style="v" sid="GEN 19:15" />ಸುರ್ಯೊ ಹುಟ್ಟಾತಿ ಪೈಲಾಜ಼ ಲೊಟನೆ ಜಾ಼ವಾನಾ ಹುತಿ ದೆವದುತೊ ಜ಼ಬರದಸ್ತಿ ಕರ‍್ಯಾ. ಎ ಗಾಮ ನಾಶಕರಿಪಡಸ. ತಿನಾಹುತಿ ತಾರಿ ಬೈಕೊನೆ ಭಂದಿ ದಿಕ್ರಿಯೊನೆ ಬಲೈಲಿನ ನ್ಹ್ಯಾಂತೊ ನ್ಹಾಟಿ ಜಾ಼, ತು ತೆಳಾಮಾ ಎ ಗಾಮನಾ ಕ್ಹಾತೆ ತುನೆ ಸುಜ಼ ನಾಶ ಥಾತೊ ನೈ ಕದ್ಯಾ. <verse eid="GEN 19:15" /><verse number="16" style="v" sid="GEN 19:16" />ತೆ ವರಿಬಿ ಲೊಟಾ ಗಲಿಬಿಲಿ ಥೈನ ತಡಾ ಕರಲ ಹುತಿ ಎ ಭಂಬಿ ದಾಣಗಾ ಲೊಟಾನೆ ತಿನಿ ಬೈಕೊನೆ ತಿನಾ ದಿಕ್ರಿಯೊನೆ ಹತೊ ಧರಿನ ಗಾಮ್ನಾ ಭಾರಾ ಚೊ಼ಕಿ ತರಾ ಲೈನ ಛೊಡ್ಯಾ. ಇಮ ಯಹೊವಾ ಲೊಟಾನೆ ವರಿ ತಿನಾ ಕುಟುಂಬನೆ ಮರ್ಗಾ ದೆಕಾಡ್ಯೊ. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />ತ್ಯುನೆ ಗಾಮ್ತಾ ಭಾರಾ ಆಯಲ್ಪರ ತೆ ದಾಣಗಾವೊಮಾನೊ ಯಕ್ಲೊ ಹಮ್ನಾ ತುಮೆ ನ್ಹಾಟಿ ಜಾ಼ವೊ ತುಮಾರೊ ಜ಼ಲಮ ವಚಾ಼ಡಿಲಿವೊ. ತುಮೆ ಪಾಚಾ಼ ಫರಿನ ದೆಕೊ ನಕೊ. ಕಜಾ಼ಬಿ ಖಣಿಯೊನಾ ಜ಼ಗಾಪರ ಹುಬ್ರವೊ ನಕೊ. ಚು಼ಕೈನ ಡೊಂಗ್ರೊಪರ ನ್ಹಾಟಿ ಜಾ಼ವೊ ನೈತೊ ಎ ಗಾಮನಾ ಕ್ಹಾತೆ ತುಮೆಬಿ ನಾಶ ಥೈ ಜಾ಼ವೊಸಿ. <verse eid="GEN 19:17" /><verse number="18" style="v" sid="GEN 19:18" />ತೆನೈಸೊ ಲೊಟಾ ತೆ ದಾಣಗಾವೊನೆ ಸ್ವಾಮಿಯೊ ಮರ್ಗಿನ ಹಮೊನೆ ದುರಲಕ್ಕಾ ನ್ಹಾಟಿನ ಜಾ಼ವೊ ಕವೊ ನಕೊ. <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />ತುಮಾರೊ ಸೆವಕ ಥಯಲ ಮನೆ ಮರ್ಗಿನ ಮನೆ ವಚಾ಼ಡ್ಯಾಸ. ತೆನೈಸೊ ಮಿ ದೊಂಗ್ರೊಲಕ್ಕಾ ನ್ಹಾಟಿಜಾ಼ತೊ ನೈ ಮಿ ಹಲ್ಲು ಜಾ಼ವಾಕ್ಹು ಕಯುಬಿ ನಾಶ ಮನೆ ಥೈನ ಮರಿ ಜೌ಼ಸ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />ದೆಕೊ ತ್ಯಾ ನ್ಹಾನು ಗಾಮ ಛೆ. ತೆ ಗಾಮೆ ಜಾ಼ವಾನೆ ಅಪ್ಪಣೆ ದಿವೊಮ. ಮಿ ತ್ಯಾ ನ್ಹಾಟಿನ ಗೈನ ಮಾರೊ ಜ಼ಲಮ ವಚಾ಼ಡಿಲ್ಯುಸ ಕದ್ಯೊ. <verse eid="GEN 19:20" /><verse number="21" style="v" sid="GEN 19:21" />ತೆ ದಾಣಗೊ ಲೊಟಾನೆ ತ್ಯಾ ತುನೆ ಜಾ಼ವಾನೆ ಮಿ ಅಪ್ಪಣೆ ದಿದ್ಯೊಸ. ಮಿ ತೆ ಗಾಮನೆ ನಾಶ ನೈ ಕರ‍್ತೊ. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />ವರಿ, ತು ತ್ಯಾ ಭೆಗಿನ ನ್ಹಾಟಿನ ಜಾ಼ ತು ತೆ ಗಾಮ ಮುಟ್ಟೆಲಕ್ಕಾ ಮಿ ಸೊದೊಮ ಗಾಮನೆ ನಾಶ ಕರ‍್ತೊ ನೈ ಕದ್ಯೊ. ತಿನಾಹುತಿ ತೆ ಗಾಮನೆ ಚೊಗೊರ ಕೈನ ನಾಮ ಪಡ್ಯು ಕಾ ಕದ್ಯಾಮ ತೆ ನ್ಹಾನು ಗಾಮ ವ್ಹತು.<verse eid="GEN 19:22" /></para>
  <para style="s">ಸೊದೊಮ ವರಿ ಗೊಮೊರನು ನಾಶ</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />ಸುರ್ಯೊ ಹುಟ್ಟಾತಿಜ಼ ಪೈಲಾ ಲೊಟಾ ಚೊಗೊರ ಕವಾನಾ ಗಾಮನೆ ಮುಟ್ಯೊ. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />ತೆಳಾಮಾ ಯಹೊವಾ ಸೊದೊಮ ವರಿ ಗೊಮೊರ ಗಾಮೊಪರ ಸ್ವರ್ಗಮಾತೊ ಆಗನು ಪಾನಿ ಅವಾ ಲಗಾಡ್ಯೊ. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />ಇಮ ಯಹೊವಾ ತೆ ಭಂಬಿ ಗಾಮೊನಾ ಸುತ್ತೆ ರ‍್ಹಯಲ ಗಾಮೊ ಗಾಮ್ಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ವರಿ ಬೆಳೆನೆ ಹಾಳ ಕರಿಪಡ್ಯೊ. <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />ತ್ಯುನೆ ನ್ಹಾಟಿನ ಜಾ಼ತಾಮಾ ಲೊಟಾನಿ ಬೈಕೊ ಪಾಚಿ ಫರಿನ ಗಾಮ್ನೆ ದೆಕಿ ತೆಳಾಮಾಜ಼ ತೆ ಮಿಟ್ಟಾನೊ ಖಂಬೊ ಥೈ ಗೈ. <verse eid="GEN 19:26" /><verse number="27" style="v" sid="GEN 19:27" />ಬಿಜಾ ದಿನ್ನೆ ಪಾಟೆ ನಸ್ಕೆ ಅಬ್ರಹಾಮ ಉಟ್ಟಿನ ತೆ ಯಹೊವಾನಾ ಕ್ಹಾಮೊ ಹುಬ್ರಯಲ ಜ಼಼ಗಾ ಪರ ಗಯೊ. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />ಅಬ್ರಹಾಮ ಸೊದೊಮ ವರಿ ಗೊಮೊರ ಗಾಮೊನಾ ಸುತ್ತೆ ದೆಕ್ತಾಮಾ ತೆ ಗಾಮ್ನೊ ಧವಾಂಡೊ ಉಪ್ಪರ ಆವಾನೊ ದೆಕ್ಯೊ ಧಗ ಧಗ ಲಾಗಲ ಆಗ್ಮಾತೊ ಆವಾನೊ ಧವಾಂಡೊ ದಿಕ್ಹ್ಯೊ. <verse eid="GEN 19:28" /><verse number="29" style="v" sid="GEN 19:29" />ಕ್ಹುದಾ ತೆ ಗಾಮ ನಾಶ ಕರ‍್ಯೊತುಬಿ ಅಬ್ರಹಾಮನೆ ಶೆಂ ಕರಿನ ಲೊಟಾನೊ ಜ಼ಲಮ ವಚಾ಼ಡ್ಯೊ. ಯಹೊವಾ ಇಮ್ಮ ತೆ ಗಾಮೊನೆ ವರಿ ಲೊಟಾ ರ‍್ಹಯಲ ಗಾಮನೆ ಬಿ ನಾಶ ಕರ‍್ಯೊ.<verse eid="GEN 19:29" /></para>
  <para style="s">ಮೊವಾಬ್ಯರೊ, ಅಮ್ಮೊನಿಯರೊ ಲೊಟಾಕ್ಹು ಹುಟ್ಟಲ</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />ಚೊಗರ ಗಾಮಮಾ ರ‍್ಹವಾನೆ ಲೊಟಾನೆ ಭೆಂ ವಾಟ್ಯು. ತಿನಾಹುತಿ ತೆ ವರಿ ತಿನಿಯೊ ದಿಕ್ರಿಯೊ ಡೊಂಗರಪರ ರ‍್ಹಯಲ ಗಾಮೆ ಗೈನ ಗುಹೆಮಾ ರ‍್ಹವಾನೆ ಶುರು ಕರ‍್ಯಾ. <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />ಯಕ್ಕ ದಿನ್ನ ತಿನಿ ಮ್ಹೊಟಿ ದಿಕ್ರಿ ತಿನಿ ನ್ಹಾನಿ ಭೆನ್ನೆ ಭುಲೊಕಮಾ ಕ್ಹಾರಾ ಛೊಕ್ರಿಯೊ ಡಾಣಗಾ ಹಿವಾ ಕರಿಲಿವಸ, ತೆನೈಸೊ ಅಪೆ ಹಿವಾಕರಿಲಿವಾನೆ ಕಯೊಜ಼ ದಾಣಗೊ ನತ್ತಿ. ಅಪ್ನಾ ಬಾನೆ ಬಿ ವೈಸ ಥೈಸ. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />ತೆನೈಸೊ ಅಪೆ ಬಚ್ಚಾವೊನೆ ಅಪ್ನಾ ಬಾ ಕ್ಹುಜ಼ ಪಡ್ದಿಲಿಯೆ ತೆಳಾಮಾ ಅಪ್ನು ಕುಟಂಬ ಖಲಾಸ ಥಾತು ನೈ. ಅಪ್ನಾ ಬಾನೆ ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ಪಿಲೈನ ನಿಶಾ ಕರೈನ ತಿನಾ ಕ್ಹಾತೆ ಕ್ಹುರೈನ ಅಪ್ನಾ ಬಾನಾ ವಂಶನೆ ವಚಾ಼ಡಿನ ಮ್ಹೆಲಿಯೆ ಕೈನ ಕದಿ. <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />ತೆ ರಾತೆ ತ್ಯುನೆ ತಿನಾ ಬಾನೆ ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ಪಿಲೈನ ನಿಶಾ ಕರೈಯ್ಯೊ ಪಾಚಾಲ್ತಿ ಮ್ಹೊಟಿ ದಿಕ್ರಿ ತಿನಾ ಬಾನಾ ವಚ್ಚಾನಾಮಾ ಗೈನ ತಿನಾ ಕ್ಹಾತೆ ಕ್ಹುರೈ ಲೊಟಾ ನಿಶಾಮಾ ರ‍್ಹಯಲಕ್ಹು ತಿನಿ ದಿಕ್ರಿ ತಿನಾ ಕ್ಹಾತೆ ಕ್ಹುರಯಲ ತಿನೆ ಗ್ವತ್ತ ಥಯು ನೈ. <verse eid="GEN 19:33" /><verse number="34" style="v" sid="GEN 19:34" />ಮರ್ನಾ ದಿನ್ನೆ ಮ್ಹೊಟಿ ದಿಕ್ರಿ ತಿನಿ ನ್ಹಾನಿ ಭೆನ್ನೆ ಕಾಲ ರಾತೆ ಮಿ ಬಾನಾ ಕ್ಹಾತೆ ಕ್ಹುರೈ ಆಜ಼ನಾ ರಾತೆಬಿ ತಿನೆ ದ್ರಾಕ್ಷಾರಸ ಪಿಲೈನ ನಿಶಾ ಕರೈಯೆ ತೆಳಾಮಾ ತು ತಿನಾ ವಚ್ಚಾ಼ನಾಮಾ ಗೈನ ತಿನಾ ಕ್ಹಾತೆ ಕ್ಹುರೆಸಕ್ಷಿ ಹಮ್ನಾ ಅಪೆ ಅಪ್ನಾ ಬಾನಾ ವಂಶನೆ ವಚಾ಼ಡಿಲಿಯೆಸ ಕದಿ. <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />ತೆ ರಾತೆ ತಿನಾ ಬಾನೆ ದ್ರಾಕ್ಷಾರಸ ಪಿಲೈನ ನಿಶಾ ಕರೈಯೊ ತೆಳಾಮಾ ತಿನಿ ನ್ಹಾನಿ ದಿಕ್ರಿ ತಿನಾ ವಚ್ಚಾನಾಮಾ ಗೈನ ತಿನಾ ಕ್ಹಾತೆ ಕ್ಹುರೈ. ತೆ ಕ್ಹುರಯಲ ಲೊಟಾನೆ ಗ್ವತ್ತ ಥಯು ನೈ. <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />ಇಮ ಲೊಟಾನಿಯೊ ಭಂಬಿ ದಿಕ್ರಿಯೊ ತಿನಾ ಬಾ ಕ್ಹುಜ಼ ಪೆಟೆ ರ‍್ಹೈಯೊ. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />ಮ್ಹೊಟಿ ದಿಕ್ರಿ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿ ತಿನೆ ಮೊವಾಬ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ ಹಮ್ನಾ ಜಿವ್ತಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಮೊವಾಬ್ಯೊನೆ ಮೊವಾಬಜ಼ ಮುಲ ಪುರುಶ ವ್ಹೈ. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />ನ್ಹಾನಿ ದಿಕ್ರಿಬಿ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿ ತೆ ತಿನು ನಾಮ ಬೆನಮ್ಮಿ ಕೈನ ಮ್ಹೆಲಿ ಹಮ್ನಾ ಜಿವ್ತಾರ‍್ಹಯಲ ಅಮ್ಮೊನಿವಾಲಾವೊನೆ ಬೆನಮ್ಮಿಜ಼ ಮುಲ ಪುರುಷ ವ್ಹೈ.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">ಅಬ್ರಹಾಮ ವರಿ ಅಭಿಮೆಲೆಕ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />ಅಬ್ರಹಾಮ ತ್ಯಾಂತೊ ಐನ ಕಾನಾನ ದೆಶನಾ ದಕ್ಷಿಣ ಸಿಮೆನೆ ಜಾ಼ತಾ ಜಾ಼ತಾ ಕಾದೆಶಿನಾ ಶುರಿನಾ ವಚ್ಮಾ ರ‍್ಹೈನ ವರಿ ದಕ್ಹಾ ದಿನ್ನ ಗೆರಾರಿಮಾ ಬಿ ರ‍್ಹಯೊತೊ. <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />ತೆ ತಿನಿ ಬೈಕೊ ಥಯಲ ಸಾರಳನೆ ಭೆನ ವ್ಹೈ ಕೈನ ಕೈಲಿದಲಕ್ಹು ಗೆರಾರನೊ ರಾಜೊ಼ ಅಭಿಮೆಲೆಕ ತಿನೆ ಬಲೈನ ತಿನಾ ಘರಮಾ ಮ್ಹೆಲಿದ್ಯೊ. <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />ತೆನೈಸೊ ತೆ ರಾತೆ ಕ್ಹುದಾ ಅಭಿಮೆಲೆಕನಾ ಕ್ಹಪನಮಾ ಐನ, 'ತು ತೆ ಬಾಕಡಿನೆ ಮಳೈಲಿದಲಕ್ಹು ಮರಿಜ಼ಾಶಿ; ತೆ ಬಿಜೆ಼ಕಲಾ ಡಣಗಾನಿ ಬೈಕೊ ವ್ಹೈ” ಕದ್ಯೊ. <verse eid="GEN 20:3" /><verse number="4" style="v" sid="GEN 20:4" />ಅಬಿಮೆಲೆಕ ತಿನೆ ಸಂಗಮಿಸ್ಯೊ ನ್ಹೊತೊ. ತೆ, 'ಕರ್ತಾ, ನಿತಿವಂತ ರ‍್ಹಯೆಲ ಮನಕ್ಹೊನೆ ನಾಶ ಕರಶಿ ಸು? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />ತೆ ಮನಕ್ಹ ಆ ಮನೆ ನ್ಹಾನಿ ಬ್ಹೆನ ಥೌ ಕೈನ ಕದ್ಯೊ. ಆ ಬಿ ತೆ ಮನೆ ಮ್ಹೊಟೊ ಬ್ಹೈ ಥೌ ಕೈನ ಕದಿ. ಮಿ ಯಥಾರ್ಥ ಮನಸಕ್ಹು ಬಿ, ಶುದ್ಧ ಹತ್ತ ಕ್ಹು ಬಿ ಅಮ್ಮ ಕರ‍್ಯೊಸ” ಕದ್ಯೊ. <verse eid="GEN 20:5" /><verse number="6" style="v" sid="GEN 20:6" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ತಿನಾ ಕ್ಹಪನ್ಮಾ , 'ತು, ಆ ಯಥಾರ್ಥ ಮನಸಕ್ಹು ಕರ‍್ಯೊಸ ಕವಾನು ಮನೆ ಗ್ವತ ಛೆ; ತಿನಾಹುತಿ ತು ಮನೆ ವಿರುದ್ಧ ಥೈನ ಪಾಪ ಕರು ನೈ ಕೈನ ಮಿ ತುನೆ ಹುಬ್ರಾಡಿನ ತಿನೆ ಮುಟ್ಟಾನೆ ದಿದ್ಯೊ ನೈ. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />ಅಮ್ಮ ರ‍್ಹಯೆಲ ಕ್ಹು ತೆ ಮನಕ್ಹನಿ ಬೈಕೊನೆ ತಿನೆ ವಪ್ಸಿಪಡ. ತೆ ಪ್ರವಾದಿ, ತಾರಾ ಹುತಿ ಮಕನ ತೆ ಪ್ರಾಥನಾ ಕರಸ ವರಿ ತು ಜಿವ್ತೊ ರ‍್ಹಶಿ. ತಿನೆ ನೈ ವಪ್ಪಸ್ಯೊಮ ತು ವರಿ ತಾರಾ ಕ್ಹಾರಾ ಜ಼ನಾ ಮರಣ ಹೊಂದೊಶಿ ವರಿ ಆ ಥಾವಸಜ ಕೈನ ತಿಳದಿಲೆ” ಕೈನ ಕ್ಹಪನಮಾ ಕದ್ಯೊ. <verse eid="GEN 20:7" /><verse number="8" style="v" sid="GEN 20:8" />ಪಾಟೆ ಅಬಿಮೆಲೆಕ ತಿನಾ ಕ್ಹಾರಾ ಕಾಮ ಕರಾಲಾವೊನೆ ಕುಡಸಿನ ಎ ಕ್ಹಾರಾ ಸಂಗತಿಯೊ ತಿಳಸಾತಾಮಾ ತ್ಯುನೆ ಘನ್ನಾ ಬುಚಕ್ಯಾ. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />ಅಬಿಮೆಲೆಕ ಅಬ್ರಹಾಮನೆ ಬಲೈನ, 'ತು ಹಮೊನೆ ಕರಲ ಸು ವೈ? ಮಿ ಕಯೊ ಪಾಪ ಕರಲಕ್ಹು ತು ಮನೆ ವರಿ ಮಾರಾ ರಾಜ್ಯನೆ ಮಹಾಪಾತ ಲಕುನ್ ಮ್ಹೈ ಘಾಲ್ಯೊಸ? ತು ನೈ ಕರಾನಾ ಕರಾನೆ ಮಿ ತುನೆ ಸು ಕರ‍್ಯೊತೊ” ಕೈನ, <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />'ತು ಕಯಾ ಉದ್ದೆಶಕ್ಹು ಆ ಕಾರ್ಯ ಕರ‍್ಯೊ” ಕೈನ ಅಬಿಮೆಲೆಕ ಅಬ್ರಹಾಮನೆ ಪುಚ್ಯೊ. <verse eid="GEN 20:10" /><verse number="11" style="v" sid="GEN 20:11" />ತೆಳಾಮಾ ಅಬ್ರಹಾಮ, 'ಎ ಜ಼ಗಾನಾ ಕ್ಹುದಾನ ಭ್ಹೆ ಭಕ್ತಿಮಾ ನೈ ರ‍್ಹೈನ ಮಾರಿ ಬೈಕೊನಾ ನಿಮತ್ತಕ್ಹು ಮನೆ ಖಲಾಸ ಕರಸ ಕೈನ ಸೊಚ್ಯೊತೊ. <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />ತೆನೈಸೊ ತೆ ಕ್ಹರಿಮಾಜ ಮಾರಿ ನ್ಹಾನಿ ಬ್ಹೆನ ವ್ಹೈ, ಮಾರಾ ಬಾನಿಜ ದಿಕ್ರಿ ವ್ಹೈ; ತೆನೈಸೊ ಮಾರಿ ಯಾನಿ ದಿಕ್ರಿ ನೈ ರ‍್ಹಯಲಕ್ಹು ಮನೆ ಬೈಕೊ ಥೈಸ. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />ಮಿ ಕ್ಹುದಾನಿ ಚಿತ್ತಕ್ಹುಜ ಬಾನಾ ಘರನೆ ಚೊಡಿನ ದೆಶಾಂತರೊನೆ ಜಾವಾನಾಹುತಿ ಜಾ಼ತಾಮಾ ಮಿ ತಿನೆ, 'ಹಮೆರ ಜಾವಾನಾ ಕ್ಹಾರಾ ಜಗವೊಮಾ ಮನೆ ತಾರಾಕ್ಹು ಯಕ್ಕ ಮರ್ಗಾ ಥೌ. ತೆ, ಸು ವ್ಹೈ ಕದ್ಯಾಮ ತು ಮನೆ ಮ್ಹೊಟೊ ಬ್ಹೈ ವ್ಹೈ ಕೈನ ಕೌ’ ಕೈನ ತಿಳಸಾಯೊ” ಕದ್ಯೊ. <verse eid="GEN 20:13" /><verse number="14" style="v" sid="GEN 20:14" />ತೆಳಾಮಾ ಅಬಿಮೆಲೆಕ ಅಬ್ರಹಾಮನೆ ಬೈಲೊ-ಬಕ್ರಿಯೊನೆ ದಾಸ-ದಾಸಿಯೊನೆ ದಿನ, ತಿನಿ ಬೈಕೊ ಥಯಲ ಸಾರಳನೆ ತಿನೆ ವಪ್ಸಿನ, <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />'ದೆಕ, ಆ ಮಾರು ದೆಶ; ಇಮಾ ತುನೆ ಪಸಂದ ರ‍್ಹಯಲ ಜ಼ಗಾ ತು ರ‍್ಹೆಸಕಶಿ” ಕೈನ ಅಬಿಮೆಲೆಕ ಕದ್ಯೊ. <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />ತೆನೈಸೊ ತೆ ಸಾರಳನೆ, 'ತಾರ ಮ್ಹೊಟಾ ಬ್ಹೈನೆ ಯಕ್ಕ ಹಜಾ಼ರ ರುಪ್ಪಾನಾ ಬಿಲ್ಲಾ ದಿದ್ಯೊಸ; ಥಯಲ ಕ್ಹಾರಾ ಸಂಗತಿಯೊ ಶೆಂ ಕರಿಲಿದ್ಯಾವಾಚಿ ಆ ಪ್ರಾಯಶ್ಚಿತ ರ‍್ಹವಾದೆ; ತು ಮಾನಸಿಕ ವೈ ಕೈನ ಇಕ್ಹು ಕ್ಹಾರ ತಿಳ್ದಿಲಿವಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 20:16" /><verse number="17" style="v" sid="GEN 20:17" />ತೆ ಥಯಲ್ಪರ ಅಬ್ರಹಾಮ ಕ್ಹುದಾಕನ ಮಾಂಗಿಲಿದಲಕ್ಹು ಅಬಿಮೆಲೆಕನೆ, ತಿನಿ ಬೈಕೊನೆ ವರಿ ತಿನಾ ದಾಸಿಯೊನೆ ವಾಸ ಕರಲಕ್ಹು ತ್ಯುನೊನೆ ಬಚ್ಚಾ ಥಯಾ. <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />ಅಬ್ರಹಾಮನಿ ಬೈಕೊ ಥಯಲ ಸಾರಳಕ್ಹು ಯಹೊವಾ ಅಬಿಮೆಲೆಕನಾ ಘರಮಾ ರ‍್ಹಯೆಲ ಕ್ಹಾರಾ ಬಾಕಡಿಯೊನೆ ಗ್ವಡವಾಲಿಯೊ ಕರ‍್ಯೊ.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">ಇಸಾಕನು ಜನನ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />ಯಹೊವಾ ತೆ ದಿದಲ ವಾಗ್ದಾನಾ ಪ್ರಕಾರಜ಼ ಇಕ್ಹರ‍್ಯಾವಾಚಿ ಸಾರಾಳನೆ ಮರ್ಗಿನ ತಿನೆ ದಿದಲವಾತ ಪುರಾ ಕರ‍್ಯೊ. <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />ಸಾರಳ ಗಡಿಯೊ ಥಯಲ ಅಬ್ರಹಾಮಕ್ಹು ಪೆಟೆ ರ‍್ಹೈನ ಯಕ್ಕ ಪಟ್ಟೊ ಜ಼ನ್ನಿ. ಕ್ಹುದಾ ವಾಗ್ದನದಿದಲ ತಿಮ್ಮಜ಼ ಇ ಕ್ಹಾರು ಕರೆಟ್ಟ ಟೈಮ್ಮಜ಼ ಥಯು. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />ಅಬ್ರಹಾಮ ಸಾರಳಮಾ ತಿನಾಕ್ಹು ಹುಟ್ಟಲ ಬಚ್ಚಾನೆ ಇಸಾಕ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />ಇಸಾಕನೆ ಆಟ ಮ್ಹೈನಾ ಥಾತಾಮಾ ಕ್ಹುದಾನಿ ವಾತನಿಂಗತ ಅಬ್ರಹಾಮ ತಿನೆ ಖತ್ನಾ ಕರಾಯೊ. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />ಅಬ್ರಹಾಮನೆ ಕ್ಹೊ ವರಕ್ಹನೊ ಥಾತಾಮಾ ತಿನೊ ದಿಕ್ರೊ ಇಸಾಕ ಹುಟ್ಯೊ. <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />ಸಾರಳ ಕ್ಹುದಾ ಮಿ ಅಕ್ಹಾ ವರಕ್ಹು ಕರ‍್ಯೊಸ. ಎ ಐಕಲವಾಲಾ ಮಾರಾ ಕ್ಹಾತೆ ಅಕ್ಹಸ. <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />ಅಬ್ರಹಾಮ ಸಾರಳಮಾ ದಿಕ್ರೊ ಹುಟ್ಟಸ ಕೈನ ಕುನ್ನಜ಼ ವಿಚಾರ ಕರ‍್ಯುನ್ಹೊತು. ಅಬ್ರಹಾಮ ಗಡಿಯೊ ಥಯೊತಬಿ ಹಮ್ನಾ ಮಿ ತಿನೊ ಪಟ್ಟೊ ದಿದಿಸ ಕದಿ. <verse eid="GEN 21:7" /><verse number="8" style="v" sid="GEN 21:8" />ಇಸಾಕ ಮ್ಹೊಟೊ ಥೈನ ಅನ್ನ ಖಾವಾ ಯಕ್ಲೊ ಮ್ಹೊಟೊ ಥಯೊ ತೆಳಾಮಾ ಅಬ್ರಹಾಮ ಮ್ಹೊಟು ಖಾವಾನು ಕರ‍್ಯೊ.<verse eid="GEN 21:8" /></para>
  <para style="s">ಹಾಗರಳನೆ ವರಿ ಇಸ್ಮಾಯಿಲನೆ ಭಾರಾ ಕಾಡಾನು</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />ಪೈಲಾ ಇಜಿಪ್ತನಿ ಸೆವಕಿ ಥಯಲ ಹಾಗರಳ ಯಕ್ಕ ದಿಕ್ರೊ ಹುಟ್ಯೊತೊ ತಿನೆಬಿ ಅಬ್ರಹಾಮ ಬಾ ಥಯೊತೊ. ವರಿಬಿ ತೆ ಪೈಲಾನಾ ದಿಕ್ರಾನೆ ಇಸಾಕನೆ ತ್ರಾಸ ದಿವಾನೆ ಸಾರಳ ದೆಕೆ. <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />ತಿನಾಹುತಿ ಸಾರಳ ಅಬ್ರಹಾಮನೆ ತೆ ಸೆವಕಿನೆ ತಿನಾ ದಿಕ್ರಾನೆ ಮೊಕ್ಲಿಪಾಡ ಅಪೆ ಮರಲ್ಪರ ಕ್ಹಾರಿ ಆಸ್ತಿ ಅಪ್ನೊ ದಿಕ್ರೊ ಇಸಾಕನೆ ಮಳಾದೆ. ಅಪ್ನಿ ಆಸ್ತಿಮಾ ಇಸಾಕನಾ ವಾಟಾಮಾ ತಿನೆ ವಾಟೊ ದಿವಾನೆ ಮನೆ ಮನಸ ನತ್ತಿ ಕೈನ ಕದಿ. <verse eid="GEN 21:10" /><verse number="11" style="v" sid="GEN 21:11" />ಅಬ್ರಹಾಮನೆ ಘನ್ನು ದುಖ ಥಯು ತೆ ತಿನಾ ದಿಕ್ರೊ ಇಸ್ಮಾಯಿನಾ ಹುತಿ ಚಿಂತಾ ಕರಾಡ್ಯೊತೊ. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />ತೆನೈಸೊ ಕ್ಹುದಾ ಅಬ್ರಹಾಮನೆ ತೆ ಪಟ್ಟಾನಾ ಹುತ ವರಿ ಸೆವಕಿನಾ ಹುತಿ ಚಿಂತಾ ಕರು ನಕೊ ಸಾರಳನು ಮನಸ ಕಿಮ ಛೆ ತಿಮ್ಮಜ಼ ಕರ. ಇಸಾಕ ಯಕ್ಲೊಜ಼ ಆಸ್ತಿನೆ ವಾರಸದಾರ ಥಾವಾದೆ. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />ವರಿಬಿ ತಾರಿ ಸೆವಕಿನಾ ದಿಕ್ರಾನೆಬಿ ಮಿ ಆಶಿರ್ವಾ ದ್ಯುಸ. ತೆ ತಾರೊ ದಿಕ್ರೊ ರ‍್ಹಯಲ ಹುತಿ ತಿನಾಕ್ಹುಬಿ ಮ್ಹೊಟು ಜ಼ನಾಂಗ ಕರುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 21:13" /><verse number="14" style="v" sid="GEN 21:14" />ಮರ್ನಾ ದಿನ್ನೆ ಪಾಟೆ ಅಬ್ರಹಾನ ದಕ್ಹು ಅನ್ನ ವರಿ ದಕ್ಹು ಪಾನಿ ಲಿನ ಹಾಗರಳನೆ ದಿದ್ಯೊ. ಹಾಗರಲ ತೆಲಿನ ದಿನಾ ಬಚ್ಚಾನೆ ಲಿನ ತ್ಯಾಂತಿ ಗೈಪಡಿ ಹಾಗರಳ ತೆ ಜ಼ಗಾ ಛೊಡಿನ ಬೆರಶೆಬನೆ ಉಸುಕನಿ ಜ಼ಗಾ ಭಟ್ಕಾಡಿತಿ. <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />ದಕ್ಹೊ ಟೈಮ ಥಯಲ್ಪರ ತಿಕನ ರ‍್ಹಯಲ ಪಾನಿ ಖಲಾಸ ಥಯೊ. ಪಿವಾನಾ ಹುತಿ ಸುಜ಼ ನ್ಹೊತು. ತಿನಾಹುತಿ ಹಾಗರಳ ತಿನಾ ದಿಕ್ರಾನೆ ಝಾಡನಿ ಛವ್ಲಿನಾ ಹೆಟಿ ಕ್ಹುರಾಡಿ. <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />ಹಾಗರಳ ದಕ್ಹಿ ದುರ ಚಾ಼ಲ್ತಿ ಗೈನ ಬೈಟಿನ ತಿನೊ ದಿಕ್ರೊ ಮರಾನು ನೈ ದಕಾನೆ ಥಯಲಹುತಿ ರವಾನು ಸುರು ಕರಿ. <verse eid="GEN 21:16" /><verse number="17" style="v" sid="GEN 21:17" />ಬಚ್ಚು಼ ರ‍ವಾನು ಕ್ಹುದಾ ಐಕು ಆಯು ತೆಳಾಮಾ ದೆವದುತ ಹಬಾಳತೊ ಐನ ತಿನೆ ಬಲೈನ ಹಾಗರಳ ತುನೆ ಸು ಥಯು ತು ಭುಚ್ಕು಼ ನಕೊ ಬಚ್ಚಾನು ರವಾನು ಯಹೊವಾ ಐಕ್ಯೊಸ. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />ಗೈನ ಬಚ್ಚಾ಼ನೆ ಉಚೈಲೆ ತಿನಾಕ್ಹು ಮ್ಹೊಟು ಜ಼ನಾಂಗ ಕರುಸ ಕದ್ಯೊ. <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />ತೆ ಥಯಲ್ಪರ ಕ್ಹುದಾ ಹಾಗರಳನೆ ಯಕ್ಕ ಇರ ದಿಕ್ಹಾ ವರಕ್ಹಿ ಕರ‍್ಯೊ. ಹಾಗರಳ ಇರೆ ಗೈನ ತಿನಿ ತಿತ್ತಿಮಾ ಪಾನಿ ಭರಿ ಲೈನ ಐನ ಬಚ್ಚಾ಼ನೆ ಪಿಲೈ <verse eid="GEN 21:19" /><verse number="20" style="v" sid="GEN 21:20" />ಕ್ಹುದಾ ತೆ ಬಚ್ಚಾ಼ನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ಹುತಿ ತೆ ಬಚ್ಚು಼ ಬೆಳ್ದಿನ ಮ್ಹೊಟೊ ಥಯೊ. ರಾನ್ಮಾ ಜಿವ್ನಾ ಕರಿನ ಚತುರ ಬಿಲ್ಲು ಬಾಣವಾಲೊ ಥಯೊ. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />ತೆ ಪಾರಾರನಾ ರಾನ್ಮಾ ರ‍್ಹಯೊ. ತಿನಿ ಯಾ ಐಗುಪ್ತ ದೆಶತಿ ಯಕ್ಕ ಜಾಂಜಿಮಾನ ಛೊಕ್ರಿನೆ ಲೈನ ತಿನಾ ಕ್ಹಾತೆ ಹಿವಾ ಕರಿ.<verse eid="GEN 21:21" /></para>
  <para style="s">ಅಬ್ರಹಾಮ ವರಿ ಅಬಿಮೆಲಕನು ವಪ್ಪಂದ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />ತೆ ಕಾಲಮಾ ಅಬಿಮೆಲೆಕ ಸೆನಾದಿಪತಿ ಥಯಲ ಫಿಕೊಲೊನಾ ಕ್ಹಾತೆ ಅಬ್ರಹಾಮನೆ, 'ತು ಕರಾನಾ ಕ್ಹಾರಾ ಕಾಮೊಮಾ ಕ್ಹುದಾ ತಾರಾ ಕ್ಹಾತೆ ಛೆ. <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />ತಿನಾಹುತಿ ತು ಮನೆ ಬಿ ಮಾರಾ ಬಚ್ಚಾವೊನೆ ಮರಿ ಸಂತತಿನೆ ಅನ್ಯಾಯ ಕರ‍್ಯಾವಾಚಿ ಮಿ ತುನೆ ಚೊಕು ಕರನಿಂಗತಜ಼಼ ಮನೆ ಬಿ ತು ಆ ರ‍್ಹಯಲ ದೆಶನೆ ಬಿ ಚೊ಼ಕು ಕರುಸ ಕೈನ ಕ್ಹುದಾನಾ ಉಪ್ಪರ ಕ್ಹಮ್ಮ ಘಾಲು ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 21:23" /><verse number="24" style="v" sid="GEN 21:24" />ತಿನಾಹುತಿ ಅಬ್ರಹಾಮ 'ತಿಮ್ಮಜ” ಕ್ಹಮ್ಮ ಘಾಲುಸ ಕದ್ಯೊ. <verse eid="GEN 21:24" /><verse number="25" style="v" sid="GEN 21:25" />ಅಬಿಮೆಲೆಕನಾ ಆಳೊ ಐನ ಇರನೆ ಜ಼ಬರದಸ್ತಿ ಕರಿನ ಸ್ವಾದಿನ ಕರಲಿದಲಕ್ಹು ಅಬ್ರಹಾಮ ಅಬಿಮೆಲೆಕನಾ ಉಪ್ಪರ ತಪ್ಪ ಘಾಲಾನಾ ಹುತಿ. <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />ಅಬಿಮೆಲೆಕ, 'ಆ ಕಾಮ ಕರಲವಾಲಾ ಕುನ್ನ ವ್ಹೈ ಮನೆ ಗ್ವತ ನತ್ತಿ; ತು ಮನೆ ತಿಳಸಾಯೊ ಬಿ ನೈ ವರಿ ಹಜಿ಼ ಮಟಾ ಬಿ ಮಿ ಆ ಸಂಗತಿಯೊನೆ ಐಕ್ಯೊ ಬಿ ನತ್ತಿ” ಕದ್ಯೊ. <verse eid="GEN 21:26" /><verse number="27" style="v" sid="GEN 21:27" />ತಿ ಥಯಲ್ಪರ ಅಬ್ರಹಾಮ ಬೈಲೊ-ಬಕ್ರಿಯೊನೆ ಅಬಿಮೆಲೆಕನೆ ದಾನ ಕರ‍್ಯೊ. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />ಪಾಚ಼ಲ್ತೊ ಅಬ್ರಹಾಮ ಹಿಂಡನಾ ಕ್ಹಾತ ಹೆಣ್ಣ ಬಕ್ರಿಯೊನ ಬಚ್ಚಾವೊನೆ ಪ್ರತ್ಯೆಕಮಾ ಹುಬ್ರಾಡಲಕ್ಹು, <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />ಅಬಿಮೆಲೆಕ ಅಬ್ರಹಾಮನೆ 'ತು ಎ ಕ್ಹಾತ ಹೆಣ್ಣ ಬಕ್ರಿಯೊನಾ ಬಚ್ಚಾ಼ವೊನೆ ಪ್ರತ್ಯೆಕಮಾ ಹುಬ್ರಾಡಲ ಕಾರಣ ಸು ವ್ಹೈ?” ಕೈನ ಪುಚ್ಯೊ. <verse eid="GEN 21:29" /><verse number="30" style="v" sid="GEN 21:30" />ತಿನಾಹುತಿ ಅಬ್ರಹಾಮ, ಎ ಇರನೆ ಖಂದಾಯಲವಾಲೊ ಮಿಜ಼ ವ್ಹೈ ಕೈನ ಕವಾನೆ ತು ಎ ಕ್ಹಾತ ಹೆಣ್ಣ ಬಕ್ರಿಯೊನ ಬಚ್ಚಾ಼ವೊನೆ ಮಾರಾ ಹತಮಾತೊ ಕಾಳ್ಯು” ಕೈನ, ತ್ಯುನೆ ಭಂಬಿಜ಼ನಾ ಒಡಂಬಡಿಕೆ ಕರಲಿದ್ಯಾ. <verse eid="GEN 21:30" /><verse number="31" style="v" sid="GEN 21:31" />ತ್ಯುನೆ ಭಂಬಿಜ಼ನಾ ತ್ಯಾ ಕ್ಹಮ್ಮ ಘಾಲಲ ಕ್ಹು ತೆ ಜ಼ಗಾನೆ 'ಬೆರ್ಷೆಬ” ಕವಾನು ನಮ ಪಡ್ಯು. <verse eid="GEN 21:31" /><verse number="32" style="v" sid="GEN 21:32" />ಬೆರ್ಷೆಬಮಾ ತ್ಯುನೆ ಒಡಂಬಡಿಕೆ ಕರಲಿದಲ ಥಯಲ್ಪರ ಅಬಿಮೆಲೆಕ ತಿನೆ ಸೆನಾದಿಪತಿ ಥಯಲ ಫಿಕೊಲ ಫಿಲಿಷ್ಟಿಯರೊನಾ ದೆಶೆ ಪಾಚೊ಼ ಫರಿನ ಗೈಪಡ್ಯಾ. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />ಅಬ್ರಹಾಮ ಬೆರ್ಷೆಬಮಾ ತಮರಿಸ್ಕನು ಝಾಡ ಘಾಲಿನ ತ್ಯಾ ಹಮೆಶಾಬಿ ರ‍್ಹವಾನು ಯಹೊವಾನು ನಾಮ ಕೈನ ಆರಾಧನಾ ಕರ‍್ಯೊ. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />ಅಬ್ರಹಾಮ ಫಿಲಿಷ್ಟಿಯೊನಾ ದೆಶಮಾ ಘನ್ನಾ ದಿನ್ನ ಲಕ್ಕಾ ವ್ಹತೊ.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">ಅಬ್ರಹಾಮ ಇಸಾಕನೆ ಬಲಿ ದಿವಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />ಎ ಕ್ಹಾರಾ ಸಂಗತಿಯೊ ಥಯಲ್ಪರ ಖುದ್ದ ಅಬ್ರಹಾಮನಿ ಪರಿಕ್ಷಾ ಕರ‍್ಯೊ. <verse eid="GEN 22:1" /><verse number="2" style="v" sid="GEN 22:2" />ಕಿಮ್ಮ ಕದ್ಯಾಮ ತೆ ತಿನೆ, 'ಅಬ್ರಹಾಮ” ಕೈನ ಬಲಾತಾಮಾ ತೆ, 'ದೆಕ, ನ್ಹ್ಯಾ ಛೆ" ಕದ್ಯೊ. ತೆಳಾಮಾ ತೆ, 'ತುನೆ ಮಯಾನೊ ರ‍್ಹಯಲ ಯಕ್ಲೊಜ ದಿಕ್ರೊ ಥಯಲ ಇಸಾಕನೆ ಬಲೈಲಿನ ಮೊರಿಯ ದೆಶನೆ ಗೈನ ತ್ಯಾ ತಿನೆ ಮಿ ಕವಾನಾ ಯಕ್ಕ ಡೊಂಗರಪರ ಸರ್ವಾಂಗ ಹೊಮ ಕರಿನ ಅರ್ಪಣೆ ಕರುಸ” ಕದ್ಯೊ. <verse eid="GEN 22:2" /><verse number="3" style="v" sid="GEN 22:3" />ತಿನಾ ನಿಂಗತಜ಼ ಪಾಟೆಜ಼ ಉಟಿನ ಗದ್ಡಾಪರ ಲಾಕ್ಡಾನೊ ಭಾರೊ ಭಾಂದಿನ ಇಸಾಕನೆ ತಿನಾಕ್ಹಾತೆ ವರಿ ಬೆ ಆಳೊನೆ ತ್ಯುನಾ ಕ್ಹಾತೆ ಲಿನ ತೆ ಥಯಲ್ಪರ ಕ್ಹುದಾ ಕದಲ ಜ಼ಗಾಪರ ಚಾ಼ಲ್ಯಾ. <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />ತ್ಯುನೆ ತನ್ನ ದಿನ್ನಲಕ್ಕಾ ಪ್ರಯಾಣ ಕರ್‍ಯಾ ಅಬ್ರಹಾಮ ದೆಕ್ತಾಮಾ ತ್ಯುನೆ ಜಾ಼ವಾನಿ ಜ಼ಗಾ ನಕ್ಕರ ದುರ ದಿಕ್ಹಿ. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />ತೆ ಥಯಲ್ಪರ ತಿನಾ ಆಳೊನೆ ತುಮೆ ನ್ಹ್ಯಾಜ಼ ಗದ್ಡಾನಾ ಕ್ಹಾತೆ ರ‍್ಹವೊ ಮಿ ಮಾರೊ ದಿಕ್ರೊ ತೆ ಜ಼ಗಾಪರ ಗೈನ ಕ್ಹುದಾನಿ ಆರಾಧನಾ ಕರಿನ ಐಯೆಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 22:5" /><verse number="6" style="v" sid="GEN 22:6" />ಅಬ್ರಹಾಮ ಬಾಳಾನಾಹುತಿ ಲಾಕ್ಡಾಲಿನ ತಿನಾ ದಿಕ್ರಾನಾ ಖಂದಾಪರ ಘಾಲ್ಯೊ. ಅಬ್ರಹಾಮ ಮ್ಹೊಟೊ ಚಾ಼ಕು ವರಿ ಆಗ ಲಿನ ತ್ಯುನೆ ಭಂಬಿಜ಼ನಾ ಆರಾಧನಾ ಕರಾನಾಹುತಿ ತೆ ಜ಼ಗಾನೆ ಚಾ಼ಲ್ಯಾ. <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />ಇಸಾಕ ತಿನಾ ಬಾ ಅಬ್ರಹಾಮನೆ ಬಾ ಕೈ ಬಲಾಯೊ ಅಬ್ರಹಾಮ ಸು ವೈ ದಿಕ್ರಾ? ಕೈನ ಪುಚ್ಯೊ. ಇಸಾಕ ಲಾಕ್ಡಾವರಿ ಆಗ ಮನೆ ದಿಕ್ಹಾಡಿಸ ವರಿಬಿ ಬಲಿ ದಿವಾನಾ ದಿವಾನಿ ಬಕ್ರಾನು ಬಚ್ಚು಼ ಕಿಜಾ಼ ಛೆ? ಕೈ ಪುಚ್ಯೊ. <verse eid="GEN 22:7" /><verse number="8" style="v" sid="GEN 22:8" />ಅಬ್ರಹಾಮ ಬಲಿ ದಿವಾನ ಬಕ್ರಾನು ಬಚ್ಚು಼ ಕ್ಹುದಾಜ಼ ದಿವಸ. ಕೈನ ಕದ್ಯೊ. ಇಮ ಅಬ್ರಹಾಮ ವರಿ ತಿನೊ ದಿಕ್ರೊ ತ್ಯಾ ಗಯಾ. <verse eid="GEN 22:8" /><verse number="9" style="v" sid="GEN 22:9" />ತೆ ಜ಼ಗಾಪರ ಐನ ತ್ಯಾ ಅಬ್ರಹಾಮ ಯಕ್ಕ ಬಲಿನೊ ಕಟ್ಟೊ ಭಾಂದಿನ ತಿಪರ ಲಾಕ್ಡಾ ವಟ್ಯೊ. ತಿಪರ ತಿನಾ ದಿಕ್ರಾನಾ ಪಗೊ ಹತೊ ಭಾಂದಿನ ತೆ ಲಾಕ್ಡವೊಪರ ತಿನೆ ಕ್ಹುರಾಡ್ಯೊ <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />ತೆಳಾಮಾ ತಿನಾ ದಿಕ್ರಾನೆ ಬಲಿದಿವಾನಾ ಹುತಿ ಚಾ಼ಕು ಉಪ್ಪರ ಉಚಾತಾಮಾ <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />ಯಹೊವಾನು ದುತ ಸ್ವರಗತೊ ಅಬ್ರಹಾಮ-ಅಬ್ರಹಾಮ ಕೈನ ವದರ‍್ಯೊ. ಅಬ್ರಹಾಮ ಒ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 22:11" /><verse number="12" style="v" sid="GEN 22:12" />ಯಹೊವಾನು ದುತ ತಾರಾ ದಿಕ್ರಾನೆ ಕತ್ರು ನಕೊ ತಿನೆ ದುಖ ಕರು ನಕೊ ತು ಮಾರಾಹುತಿ ತಾರಾ ರ‍್ಹಯಲ ಯಕ್ಕಜ಼ ದಿಕ್ರಾನೆ ಬಲಿ ದಿವಾನೆಬಿ ಅಗೊ ಪಾಚೊ಼ ಕರ‍್ಯೊ ನೈ. ತಿನಾಹುತಿ ಕ್ಹುದಾಮಾ ಭೆ ವರಿ ಭಕ್ತಿವಾಲೊ ವ್ಹೈ ಕೈನ ದಿಕ್ಹ್ಯೊಸ. <verse eid="GEN 22:12" /><verse number="13" style="v" sid="GEN 22:13" />ಅಬ್ರಹಾಮ ಡೊಳಾ ಉಚೈನ ದೆಕ್ತಾಮಾ ಯಕ್ಕ ಟಗರ ದಿಕ್ಹ್ಯು ತಿನಾ ಶಿಂಗ್ಡಾ ಯಕ್ಕ ಕಂಟಿಮಾ ಕ್ಹಾಪಡ್ಯಾತಾ ತೆಳಾಮಾ ತೆ ಟಗರನೆ ಜಗ್ಗಿಲೈನ ತಿನಾ ದಿಕ್ರಾನಾ ಬದಲಿ ತೆ ಟಗರನೆ ಕ್ಹುದಾನೆ ಬಲಿ ದಿದ್ಯೊ. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />ತೆಳಾಮಾತೊಜ಼ ತೆ ಜ಼ಗಾನೆ ಯಹೊವಾ ಯೆರೆ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. ಹುಜ಼ುನಬಿ ಮನಕ್ಹೊ ಯಹೊವಾ ಡೊಂಗರ್ಪರ ದಿವಸ ಕೈನ ಹಜ಼ನಬಿ ಕವಸ. <verse eid="GEN 22:14" /><verse number="15" style="v" sid="GEN 22:15" />ಯಹೊವಾನು ದುತ ಸ್ವರ್ಗತೊ ವರಿ ಯಕ್ಕೆಮ ಅಬ್ರಹಾಮನೆ ವದ್ರಿನ <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />ತು ಮಾರಾ ಹುತಿ ಬಲಿ ದಿವಾನೆ ತಯ್ಯಾರ ಥಯೊತೊ ತಿನಾಹುತಿ ಮಿ ತಾರಾ ಕ್ಹಾತೆ ವಾಗ್ದಾನ ಕರುಸ. <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />ಮಿ ತುನೆ ಕ್ಹರಿಮಾಜ಼ ಆಶಿರ್ವಾದ ದ್ಯುಸ ತಾರು ಸಂತಾನ ಜಾಸ್ತಿ ಕರುಸ. ತಾರಿ ಸಂತತಿ ಹಬಾಳಮಾನಿಯೊ ಚಿಕ್ಕಿಯೊ ಯಕ್ಲಿಲಿಯೊ ಸಮುದ್ರನಿ ದಂಡಿಮಾ ರ‍್ಹಯಲ ಉಸುಕ ಯಕ್ಲು ಲೆಕ್ಕೊ ನೈಸೊ ಯಕ್ಲು ಕರುಸ. ತ್ಯುನೆ ದುಶ್ಮನೊನಾ ಗಾಮೊ ತ್ಯುನಾ ಅದಿಕಾರಮಾ ಕರ್ಲಿವಸ. <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />ತು ಮನೆ ವಿದೆಯ ಥಯಲ ಹುತಿ ತಾರಿ ಸಂತಿಯೊನಾ ಮುಲಕ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಹರಿಯಕ್ಕ ಜನಾಂಗ ಆಶಿರ್ವಾದ ವ್ಹಂದಿಲಿವಸ. <verse eid="GEN 22:18" /><verse number="19" style="v" sid="GEN 22:19" />ತೆ ಥಯಲ್ಪರ ಅಬ್ರಹಾಮ ತಿನಾ ಆಳೊಕನ ಫರಿನ ಆಯೊ ತ್ಯುನೆ ಕ್ಹಾರಾ ಬೆರ್ಷೆಬೆ ಫರಿನ ಚಾ಼ಲ್ಯಾ. ತೆಳಾಮಾ ಅಬ್ರಹಾಮ ತ್ಯಾಜ಼ ರ‍್ಹಯೊ.<verse eid="GEN 22:19" /></para>
  <para style="s">ನಾಹೊರನಿ ಸಂತತಿ</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />ಎ ಕ್ಹಾರೊ ಥಯಲ್ಪರ ಅಬ್ರಹಾಮನೆ ಯಕ್ಕ ಸುದ್ದಿ ಐ ತೆ ಸುದ್ದಿ ಅಮ ವ್ಹತಿ ತಾರೊ ನ್ಹಾನು ಭೈ ನಾಹೊರ ವರಿ ತಿನಿ ಬೈಕೊನೆ ಮಿಲ್ಕಾ ಕವಾಲಿನೆ ತ್ಯುನೊನೆ ಬಚ್ಚಾ಼ ಥಯಾ. <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />ಪಸ್ಟಲ್ಯೊ ದಿಕ್ರಾನು ನಾಮ ಉಜ಼ ಇನೊ ನ್ಹಾನೊ ಭೈ ಬುಜ಼ ತನ್ವಾನೊ ನಾಮ ಕೆಮುವೆಲ, ಆರಾಮನೊ ಬಾ ವ್ಹೈ. <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />ಇವ್ನೆ ನೈಸೊ ಕೆಸೆದ ಹಜೊ ಪಿಲ್ದಾಶ ಇದ್ಲಾಫ ಬೆತುವೆಲ ಕವಾಲಾಬಿ ಛೆ. <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />ಬೆತೊವೆಲ ರೆಬೆಕ್ಕನೊ ಬಾ ವ್ಹೈ. ಮಿಲ್ಕಾ ಎ ಆಟ ಜ಼ನಾವೊನಿ ಮಾ ವ್ಹೈ. ನಾಹೊರ ತ್ಯುನೊ ಬಾ ವ್ಹೈ. ನಾಹೊರ ಅಬ್ರಹಾಮನೊ ಭೈ ವ್ಹೈ. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />ಎವ್ನೆ ನೈಸೊ ನಾಹೊರನೆ ತಿನಿ ಬೈಕೊ ರುಮ ಕವಾಲಿನೆ ಚಾರ ಪಟ್ಟ ವ್ಹತಾ. ತ್ಯುನೆ ಕುನ್ನ ವ್ಹೈ ಕದ್ಯಾಮ ಟೆಬಹ, ಗಹಮ, ತಹಶ, ಮಾಕಾ, ಕವಾಲಾ ವ್ಹೈ.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">ಸಾರಾಳನು ಮರಣ ವರಿ ಮಜಾ಼ರ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />ಸಾರಳ ಯಕ್ಹೊನ ಇಕ್ಹಪರಯಕ್ಕ ವರಕ್ಹ ಜ್ಯುತಿ ವ್ಹತಿ. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />ಸಾರಳ ಕಾನಾನ ದೆಶಮಾ ರ‍್ಹಯಲ ಹೆಬ್ರೊನ ಕವಾನಾ ಕಿರ್ಯತರ್ಬಮಾ ಮರಿ. ಅಬ್ರಹಾಮ ಐನ ತಿನಾ ಹುತಿ ಗೊಳಾಡಿನ ಡೊಳಾಮಾನು ಪಾನಿ ಕಾಡ್ಯೊ. <verse eid="GEN 23:2" /><verse number="3" style="v" sid="GEN 23:3" />ತೆಳಾಮಾ ತಿನಾ ಮುರ್ದಾಕಂತೊ ಅಬ್ರಹಾಮ ಉಟಿ ಹಿತ್ತಿವಾಲಾವೊಕನ ಗೈನ ತ್ಯುನೊನೆ, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />ಮಿ ತುಮೊಮಾ ಬಿಜಾ಼ ದೆಶವಾಲೊ ವ್ಹೈ, ಪ್ರವಾಸಿ ವ್ಹೈ. ಹಮ್ನಾ ಮರಲ ಮಾರಿ ಬೈಕೊನೆ ಸಮಾದಿನಾಹುತಿ ದಕ್ಹಿ ಜಿಮಿನ ಮನೆ ಸ್ವಂತ ದಿವೊ” ಕೈನ ಮಾಂಗಿಲಿದ್ಯೊ. <verse eid="GEN 23:4" /><verse number="5" style="v" sid="GEN 23:5" />ಹಿತ್ತಿವಾಲಾ ಅಬ್ರಹಾಮನೆ ಅಮ ಕದ್ಯಾ, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />'ಸ್ವಾಮಿ ಹಮಾರಿ ವಾತ ಐಕ. ತು ಹಮೊನೆ ಮ್ಹೊಟೊ ಪ್ರಭು ಥಯೊಸ ಯಕ್ಕಜ಼ ವ್ಹೈ. ಮರಲವಾಲಿ ತಾರಿ ಬೈಕೊನು ಅಂಗ ಹಮೊಮಾ ರ‍್ಹಯಲ ಘನ್ನಿ ಚೊ಼ಕಿ ರ‍್ಹಯಲ ಸಮಾದಿಮಾ ಮುಕ್ಕ ಸಕ್ಷಿ. ತಾರಿ ಬೈಕೊನು ಅಂಗ ಮುಕ್ಕಾನಾ ಹುತಿ ಹಮಾರಾಮಾ ಕುನ್ನಜ಼ ಮಜ಼ಾರ ದಿವಾನೆ ಸರಕತು ನೈ” ಕೈನ ಕತಾಮಾ <verse eid="GEN 23:6" /><verse number="7" style="v" sid="GEN 23:7" />ಅಬ್ರಹಾಮ ಉಟಿನ ಹಿತ್ತಿವಾಲಾವೊನೆ ನಮಸ್ಕಾರ ಕರ‍್ಯೊ. <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />ತೆ ತ್ಯುನಾ ಕ್ಹಾತೆ ವರಿ ಬೊಲಿನ 'ಮಿ ತುಮೊಕನ ಮಾರಿ ಬೈಕೊನೊ ಅಂಗ ಸಮಾದಿಕರಾನೆ ತುಮೊನೆ ವಪ್ಪಿಗೆ ಥಯುಮ ಮುಕನ ತುಮೊನೆ ಯಕ್ಕ ವಿದ್ಯಾಪನೆ ಛೆ. ತುಮೆ ಜೊ಼ಹರನಾ ದಿಕ್ರೊ ಎಫ್ರೊನನ ಕ್ಹಾತೆ ಮಾರಾಹುತಿ ಬೊಲಿನ, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />ತಿನಿ ಜಿಮಿನ್ಮಾ ರ‍್ಹಯಲ ಮಕ್ಪೆಲ ಮನೆ ದಿಲಾವೊ ಕೈನ ಕೈಲಿದ್ಯೊ. ಮನೆ ತೆ ಸಮಾದಿಕಾರಾನೆ ಸ್ವಂತ ಜ಼ಗಾ ಕರಿನ ದಿದ್ಯೊಮ ತಿನಿ ಕಿಮ್ಮತ ತುಮಾರಾ ಕ್ಹಾಮೊಜ಼ ತಿನೆ ದ್ಯುಸ” ಕದ್ಯೊ. <verse eid="GEN 23:9" /><verse number="10" style="v" sid="GEN 23:10" />ಎಫ್ರೊನನ ತೆ ಹಿತ್ತಿವಾಲಾವೊಮಾಜ಼ ಬೈಟ್ಯೊತೊ. ಇಮ ಕತಾಮಾ ಹಿತ್ತಿವಾಲೊ ಥಯಲ ಎಫ್ರೊನನ ತ್ಯುನಾ ಕ್ಹಾಮೊಜ಼ ಉಟಿನ ಅಬ್ರಹಾಮನೆ <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />'ತಿಮ ನ್ಹವೈ ಸ್ವಾಮಿ, ಮಾರಿ ವಾತ ಐಕ. ತೆ ಜಿಮಿನ್ಮಾ ರ‍್ಹಯಲ ಸಮಾದಿ ತುನೆ ದಾನಮಾ ದ್ಯುಸ ಮಾರಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮೊಜ಼ ದ್ಯುಸ. ಮರಲವಾಲಿ ತಾರಿ ಬೈಕೊನೆ ತಿಮಾಜ಼ ಸಮಾದಿ ಕರಸಕ್ಷಿ” <verse eid="GEN 23:11" /><verse number="12" style="v" sid="GEN 23:12" />ಕೈನ ಕತಾಮಾ ಅಬ್ರಹಾಮ ತೆ ದೆಶನಾ ಮನಕ್ಹೊನೆ ನಮಸ್ಕಾರ ಕರಿನ ತ್ಯುನಾ ಕ್ಹಾಮೊಜ಼ <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />ಅಬ್ರಹಾಮ ತ್ಯುನಾ ಕ್ಹಾಮೊಜ಼ ಎಫ್ರೊನನೆ ತೆ ಜ಼ಗಾನಿ ಕೆಕ್ಲಿ ಕಿಮ್ಮತ ಛೆ ತೆಕ್ಲಿ ಮಿ ದ್ಯುಸ ತೆ ತೆ ಕಿಮ್ಮತ ಲಿವಾನೊ ರ‍್ಹಯೊಮ ಮಾರಿ ಬೈಕೊನೆ ತ್ಯಾ ಸಮಾದಿ ಕರುಸ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 23:13" /><verse number="14" style="v" sid="GEN 23:14" />ಎಫ್ರೊನ ಅಬ್ರಹಾಮನೆ <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />ಸ್ವಾಮಿ ಮಾರಿ ವಾತ ಐಕ ತೆ ಜ಼ಗಾನಿ ಕಿಮ್ಮತ ಚಾರಕ್ಹೊ ರುಪ್ಪಾನಾ ಬಿಲ್ಲಾ ವ್ಹೈ. ವರಿಬಿ ತುನೆ ರ‍್ಹೈನೆಕಾ ಮನೆ ರ‍್ಹೈನೆಕಾ ತೆ ಚಾರಕ್ಹೊ ಜಾಸ್ತಿ ನ್ಹವೈ.ಜ಼ಗಾಲಿನ ತಾರಿ ಬೈಕೊನೆ ಸಮಾದಿ ಕರ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 23:15" /><verse number="16" style="v" sid="GEN 23:16" />ಅಬ್ರಹಾಮ ಎಫ್ರೊನನಿ ವಾತ ಐಕ್ಯೊ ಅಬ್ರಹಾಮ ತೆ ಜ಼ಗಾನಾಹುತಿ ಎಫ್ರೊನನೆ ಚಾರಕ್ಹೊ ರುಪ್ಪಾನಾ ಬಿಲ್ಲಾ ತ್ಯುನಾ ಕ್ಹಾಮೊಜ಼ ಮೊಜಿನ ದಿದ್ಯೊ. <verse eid="GEN 23:16" /><verse number="17" style="v" sid="GEN 23:17" />ಎ ಜಿಮಿನ ಮಮ್ರೆನ್ನೆ ಪುರ್ವಮಾ ರ‍್ಹಯಲ ಮೆಕ್ಪೆಲಮಾ ವ್ಹತು.ಅಬ್ರಹಾಮ ತೆ ಜಿಮಿನ್ನೆ ತ್ಯಾ ರ‍್ಹಯಲ ಗವಿನೆ ವರಿ ಝಾಡೊನೆ ಮಾಲಕ ಥಯೊ. <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />ಎಫ್ರೊನನೆ ಅಬ್ರಹಾಮನೆ ಥಯಲ ವಪ್ಪಂದನೆ ಗಾಮ್ನಾ ಕ್ಹಾರಾಜ಼ನಾ ಸಾಕ್ಷಿ ಥಯಾ. <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />ಪಾಚಾ಼ತೊ ತಿನಿ ಬೈಕೊನೆ ಸಾರಳನೆ ಮಮ್ರನೆ ನಜಿ಼ಕ ರ‍್ಹಯಲ ಜಿಮಿನಮಾ ಸಮಾದಿ ಕರ‍್ಯೊ. ತೆ ಕಾನಾನ ದೆಶನಾ ಕ್ಹಾಮು ವ್ಹತು. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />ಅಬ್ರಹಾಮ ತೆ ಜಿಮಿನನೆ ವರಿ ತಿನಾ ರ‍್ಹಯಲ ಗವಿನೆ ಹಿತ್ತಿಯವಾಲಾವೊಕ್ಹು ಇಕ್ಕಾತೊ ಲಿದ್ಯೊತೊ. ತೆ ತಿನಿ ಆಸ್ತಿ ಥೈ ತೆ ಜ಼ಗಾನೆ ಸಮಾದಿನಿ ಜ಼ಗಾ ಕರ‍್ಯೊ.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">ಇಸಾಕ ವರಿ ರೆಬೆಕ್ಕ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />ಅಬ್ರಹಾಮ ಗಡಿಯೊ ಥಯೊತೊ. ಯಹೊವಾ ತಿನೆ ಘನಾ ವಿಷಯಮಾ ಅಭಿವೃದ್ದಿ ಕರ‍್ಯೊತೊ. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />ಅಮ್ಮ ರ‍್ಹತಾಮಾ ತಿನೆ ರ‍್ಹಯಲ ಆಸ್ತಿನಾ ಉಪ್ಪರ ಆಳ ಕರಾಲಾ ಮ್ಹೊಟ್ಟ ಸೆವಕನೆ ಅಬ್ರಹಾಮ, 'ತು ಮಾರಾ ಮಾಂಡಿನಾ ಹೆಟೊ ಹತ್ತ ಮ್ಹೆಲ ಕದ್ಯೊ. <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />ತೆ ಥಯಲ್ಪರ ಯಹೊವಾನಿ ಕ್ಹಮ ಮಿ ಜಿವ್ತೊ ರ‍್ಹಯಲ ಆ ಕಾನಾನ್ಯ ವಾಲಾವೊಮಾತೊ ಮಾರೊ ದಿಕ್ರೊ ಥಯಲ ಇಸಾಕನೆ ಯಕ್ಕ ಛೊಕ್ರಿ ಲೈನ ಹಿವಾ ಕರ‍್ಯಾವಾಚಿ, <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />ಮಾರಾ ದೆಶನಾ, ಮಾರಾ ಸಂಭದಿಕರೊಮಾನಿ ಯಕ್ಕ ಛೊಕ್ರಿನೆ ಲೈನ ಹಿವಾ ಕರುಸ ಕೈನ ಪರಲೊಕನೊ ವರಿ ಭುಲೊಕನೊ ಬಾ ಥಯಲ ಯಹೊವಾನಾ ಉಪ್ಪರ ಕ್ಹಮ ಘಾಲು” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 24:4" /><verse number="5" style="v" sid="GEN 24:5" />ತಿನಾಹುತಿ ತೆ ಸೆವಕ, 'ಯಕ್ಕ ಟೈಮ ಮಾರಾ ಕ್ಹಾತೆ ಆ ದೆಶನೆ ಆವಾನೆ ತೆ ಛೊಕ್ರಿನೆ ಮನಸ ನೈ ರ‍್ಹಯಲ ರ‍್ಹಯುಮ, ತು ಛೊಡಿನ ಆಯಲ ತೆ ದೆಶನೆ ಮಿ ತಾರಾ ದಿಕ್ರಾನೆ ತ್ಯಾ ಬಲೈಲಿನ ಜೌ಼ ಸು?” ಕೈನ ಪುಚ್ಯೊ. <verse eid="GEN 24:5" /><verse number="6" style="v" sid="GEN 24:6" />ಅಬ್ರಹಾಮ ತಿನೆ, 'ತ್ಯಾ ಮಾರಾ ದಿಕ್ರಾನೆ ಕೆಳಾಮಾಜ಼ ಬಲೈಲಿನ ಜೌ಼ ನೈ. <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />ಮಾರಾ ಬಾನಾ ಘರ್ತೊಬಿ ಮಿ ಹುಟ್ಟಲ ಘರ್ತೊಬಿ ಮನೆ ಬಲೈ ಲೈನ, ‘ತಾರಿ ಸಂತತಿನೆ ಆ ದೆಶ ದ್ಯುಸ’ ಕೈನ ಕ್ಹಮ ಘಾಲಿನ ಕದಲ ಪರಲೊಕನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ತಾರಾ ಕ್ಹಾಮೊ ತಿನಾ ದುತನೆ ವಳೈನ, ತು ತ್ಯಾಂತೊ ಮಾರಾ ದಿಕ್ರಾನಾ ಹುತಿ ಛೊಕ್ರಿ ಲಿನ ಆಯೆನಿಂಗತ ಅನುಕುಲ ಕರಿನದಿವಸ. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />ತಾರಾ ಪಾಚಿ ಆವಾನೆ ತೆ ಛೊಕ್ರಿನೆ ಮನಸ ನೈ ರ‍್ಹಯುಮ ಮಿ ಘಲಾಯಲ ಕ್ಹಮಕ್ಹು ತು ಬಿಡುಗಡೆ ಹೊಂದಿಲಿವೊಶಿ. ತೆನೈಸೊ ಮಾರಾ ದಿಕ್ರಾನೆ ತ್ಯಾ ಲಿನ ಜೌ ನೈ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />ತೆಳಾಮಾ ತೆ ಸೆವಕ ತಿನೊ ದಣಿ ಥಯಲ ಅಬ್ರಹಾನಾ ಮಾಂಡಿನಾ ಹೆಟೊ ಹತ್ತ ಮ್ಹೆಲಿನ ತೆ ಕದನಿಂಗತಜ಼಼ ಕ್ಹಮ ಘಾಲ್ಯೊ. <verse eid="GEN 24:9" /><verse number="10" style="v" sid="GEN 24:10" />ತೆ ಥಯಲ್ಪರ ತೆ ಸೆವೆಕ ತಿನಾ ಮಾಲಕನ್ನ ರ‍್ಹಯಲ ಹುಂಟುಮಾ ದಕ್ಹ ಹುಂಟೊನೆ ತಯ್ಯಾರ ಕರ್ಲಿನ, ತಿನಾ ಮಾಲಕಕಂತಾ ಕ್ಹೊನಾನು ಸಾಮನಲಿನ ಚಾ಼ಲ್ಯೊ ಅರಾಮ ಸಿಮೆನೆ ಮಳಲ ನಾಹೊರ ರ‍್ಹಯಲ ಗಾಮ್ನೆ ಮುಟ್ಯೊ. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />ಕ್ಹಾಂಜ಼ನಾ ಟೈಮ್ಮಾ ಕ್ಹಾರಿಯೊ ಬಾಕಡಿಯೊ ಪಾನಿ ಭರ್ಲಿವಾನೆ ಜ಼ಾತಾಮಾ ತೆ ಗಾಮನಿ ಇರಕನ ತಿನಾ ಹುಂಟೊನೆ ಕ್ಹುರಾಡಿನ, <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />'ಮಾರು ಮಾಲಕ ಥಯಲ ಅಬ್ರಹಾಮನಾ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ, ಮಿ ಕಯಾ ಕಾಮೆ ಆಯೊಸ ತೆ ಕಾಮ ತು ಥಾವಾ ವರಕ್ಹು ಕರಿನ ಮಾರೊ ಮಾಲಕ ಥಯಲ ಅಬ್ರಹಾಮನೆ ಮರಗ ಕೈನ ತುಕನ ಮಾಂಗಿಲ್ಯುಸ. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />ದೆಕ, ಪಾನಿ ರ‍್ಹಯಲ ಜ಼ಗಾ ಹುಬ್ರಯೊಸ; ಎ ಗಾಮನಿಯೊ ಜಾಂಜಿಮಾನ ಛೊಕ್ರಿಯೊ ಪಾನಿ ಭರಾಹುತಿ ಆವಾಡಿಯೊಸ. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />ಮಿ ಕೈ ಛೊಕ್ರಿನೆ, ತು ಮರ್ಗಿನ ತಾರೊ ಘಡೊ ಉತಾರಿನ ಮನೆ ಪಿವಾನಾಹುತಿ ಪಾನಿ ದೆ ಕೈನ ಕತಾಮಾ ತು ಪಾನಿ ಪಿ ಸಕ್ಷಿ ವರಿ ತಾರಾ ಹುಂಟೊನೆಬಿ ಪಾನಿ ದ್ಯುಸ. ಕವಸ್ತೊ, ತೆಜ಼ ತಾರೊ ದಾಸ ಥಯಲ ಇಸಾಕನೆ ತುಜ಼ ನೆಮ್ಸಲ ಛೊಕ್ರಿ ಥೌ. ಮಾರಾ ಮಾಲಕಪರ ತಾರಿ ಮರ್ಗಾ ಛೆ ಕೈನ ಕವಾನು ಇನಿಕ್ಹು ಮನೆ ಗ್ವತ್ತ ಥೌ. <verse eid="GEN 24:14" /><verse number="15" style="v" sid="GEN 24:15" />ತೆ ಇಮ ಕೈಲೆತಾಮಾಜ಼ ಅಬ್ರಹಾಮನೊ ನ್ಹಾನೊ ಭೈ ಥಯಲ ನಾಹೊರನಿ ಬೈಕೊನಿ ಮಿಲ್ಕಾನೊ ದಿಕ್ರಾನಿ ಬೆತೊವೆಲನೆ ಹುಟ್ಟಲ ರೆಬೆಕ್ಕಳ ಖಾಂದಾಪರ ಘಡೊ ಮ್ಹೆಲ್ಲಿನ ಗಾಮ್ತಿ ಭಾರಿ ಆಯಲ ದೆಕ್ಯೊ. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />ತೆ ಛೊಕ್ರಿ ಘನ್ನಿ ಸುಂದರ ವರಿ ಜಾಂಜಿಮಾನ ವ್ಹತಿ. ತೆ ಕಯಾಜ಼ ದಾಣಗಾನಾ ಕ್ಹಾತೆ ಶಾರಿರಿಕ ಸಂಭಂಧ ಕರಿ ನ್ಹೊತಿ. <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />ತೆ ಇರಕನ ಗೈನ ಘಡಾಮಾ ಪಾನಿ ಭರ್ಲಿನ ಉಪ್ಪರ ಆತಾಮಾ ತೆ ಸೆವಕ ನ್ಹಾಟ್ತೊ ತಿನಾ ಕ್ಹಾಮೊ ಐನ 'ಯಾ ಮನೆ ಮರ್ಗಿ ತಾರಾ ಘಡಾಮಾ ಲಾಯಲ ಪಾನಿಮಾ ಮನೆ ಪಿವಾನಾ ಹುತಿ ದಕ್ಹು ದಕ್ಹು ಪಾನಿ ದೆ. ಕತಾಮಾ ತೆ, <verse eid="GEN 24:17" /><verse number="18" style="v" sid="GEN 24:18" />ತೆಳಾಮಾಜ಼ ಘಡೊ ಉತಾರಿನೆ 'ಪಾನಿ ಪಿ ಬಾ ಕೈನ ಪಿವಾನೆ ದಿದಿ. <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />ಪಾನಿ ದಿದಲಪರ, 'ತಾರಾ ಹುಂಟೊನೆಬಿ ಪಾನಿ ಪಿವಾನಾ ಯಕ್ಲು ಮಿ ಭರಿಲೈನ ದ್ಯುಸ” ಕೈನ, <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />ಘಡಾಮಾ ರ‍್ಹಯಲ ಪಾನಿ ತೊಟ್ಟಿಮಾ ರಿಚೈ಼ನ ವರಿ ಪಾನಿಲಾವಾನಾಹುತಿ ಇರೆ ಗೈ. ಹುಂಟೊ ಪಿವಾನಾ ಯಕ್ಲು ಪಾನಿ ಲೈನ ಘಾಲಿ. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />ತೆಕ್ಲಾಮಾಜ಼ ತೆ ಸೆವಕ ಸುಜ಼ ಬೊಲ್ಯಾವಾಚಿ ತಿನೆ ಯಕ್ಕಜ಼ ಸಂವಾ ದೆಕ್ತೊ,ಯಹೊವಾ ತೆ ಆಯಲ ಕಾಮ ಸಫಲ ಥೈಸು ನತ್ತಿ ಕವಾನು ತಿಳದಿಲಿವಾಹುತಿ ಕೈದಾಡ್ಯೊತೊ. <verse eid="GEN 24:21" /><verse number="22" style="v" sid="GEN 24:22" />ಹುಂಟೊ ಪಾನಿ ಪಿದಲಪರ ತೆ ಸೆವಕ ತಿನೆ ಅರ್ದೊ ತೊಲಾನಿ ಕ್ಹೊನಾನಿ ಯಕ್ಕ ಪ್ಹುಲ್ಲಿ, ವರಿ ದಕ್ಹ ತೊಲಾನಿಯೊ ಕ್ಹೊನಾನಾ ಬೆ ಕಡಾ ದಿನ, 'ತು ಕಿನಿ ದಿಕ್ರಿ ವ್ಹೈ? ಮರ್ಗಿನ ಮನೆ ಕೆ. <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />ತಾರಾ ಬಾನಾ ಘರ್ಮಾ ಮನೆ ರ‍್ಹವಾನೆ ಜ಼ಗಾ ಛೆ ಸು?” ಕೈನ ಪುಚ್ತಾ಼ಮಾ, <verse eid="GEN 24:23" /><verse number="24" style="v" sid="GEN 24:24" />ತೆ ತಿನೆ 'ಮಿ ನಾಹೊರನೆ ಮಿಲ್ಕಾನೆ ಹುಟ್ಟಲ ಬೆತೊವೆಲನಿ ದಿಕ್ರಿ ವ್ಹೈ. ಕೈನ ಕದಿ. <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />ಎ ನೈಸೊ ತಿನೆ, 'ಚಾ಼ರೊ ಘನ್ನು ಛೆ ವರಿ ತುನೆ ರ‍್ಹವಾನಾ ಹುತಿ ಜ಼ಗಾಬಿ ಛೆ” ಕದಿ. <verse eid="GEN 24:25" /><verse number="26" style="v" sid="GEN 24:26" />ತೆ ಸೆವಕ ಎ ಕ್ಹಾರು ಐಕಿನ ಅಡ್ಡ ಪಡಿನ ಯಹೊವಾನೆ ನಮಸ್ಕಾರ ಕರ‍್ಯೊ. <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />'ಮಾರಾ ಮಾಲಕನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಸ್ತೊತ್ರಾ ಥಾವಾದೆ. ಮಾರಾ ಮಾಲಕನಾ ಖಾಂದಾನನಾ ಘರೆಜ಼ ಶಿದಾ ಬಲೈಲಾಯೊಸ” ಕದ್ಯೊ. <verse eid="GEN 24:27" /><verse number="28" style="v" sid="GEN 24:28" />ತೆ ಛೊಕ್ರಿ ನ್ಹಾಟಿನ ಗೈನ ಥಯಲ ಕ್ಹಾರಿ ಸಂಗತಿ ತಿನಿ ಯಾ ಕನ ವರಿ ಘರ್ಮಾ ಕ್ಹಾರಾವೊಕನ ಕದಿ. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />ರೆಬೆಕ್ಕನೆ ಲಾಬಾ ಕವಾಲೊ ಭೈ ವ್ಹತೊ.ತೆ ಇರಕನ ರ‍್ಹಯಲ ಹುಂಟೊಕನ ಹುಬ್ರಯಲ ತೆ ಮನಕ್ಹನ ನ್ಹಾಟಿನೆ ಆಯೊ. <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />ತಿನಿ ನ್ಹಾನಿ ಭೆನ್ಕನ ರ‍್ಹಯಲ ಪ್ಹುಲ್ಲಿ ದೆಕಿನ, ತೆ ಮನಕ್ಹ ಮಾರಾ ಕ್ಹಾತೆ ಕಿಮ ಬೊಲ್ಯೊಸ ಕೈನ ರೆಬೆಕ್ಕಾ ಕದಲ ಐಕಿನ, ಇರಕನ ಹುಬ್ರಯಲ ತೆ ಮನಕ್ಹಕನ ಆಯೊ. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />ತಿನೆ, 'ಯಹೊವಾನು ಆಶಿರ್ವಾದ ಹೊಂದಲವಾಲಾ, ಮ್ಹೈ ಆ; ಕಾ ಭಾರೊ ಹುಬ್ರಯೊ? ತಾರಾ ಹುತಿಬಿ ವರಿ ಹುಂಟೊನಾಹುತಿ ಚಾ಼ಯೆಥಯಲ ಯಕ್ಲಿ ಜ಼ಗಾ ಕರ‍್ಯೊಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 24:31" /><verse number="32" style="v" sid="GEN 24:32" />ತೆ ಮನಕ್ಹ ಘರ್ಮಾ ಆತಾ ಲಾಬಾನ ಭಾರಾ ರ‍್ಹಕಾಡಿನೆ ತ್ಯುನೊನೆ ಖಾವಾನಾಹುತಿ ಚಾ಼ರೊ ದಿಲೈನ ತೆ ಮನಕ್ಹನೆ ವರಿ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲವಾಲೊವೊನೆ ಪಗೊ ಧವಾಹುತಿ ಪಾನಿ ದಿದ್ಯೊ. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />ತ್ಯುನೊನೆ ಖಾವಾನಾ ಹುತಿ ಅನ್ನ ಖಾವಾನೆ ಘಾಲ್ತಾಮಾ, 'ಮಿ ಆಯಲ ಕಾಮನಾ ಹುತಿ ಮಿ ತುಮೊಕನ ಕಯೆ ಲಕ್ಕಾ ಮಿ ಅನ್ನ ಖಾತೊ ನೈ” ಕತಾಮಾ ಲಾಬಾನ ಕೆ ಕದ್ಯೊ. <verse eid="GEN 24:33" /><verse number="34" style="v" sid="GEN 24:34" />ತೆಳಾಮಾ ತೆ ಮಿ ಅಬ್ರಹಾಮನೊ ಸೆವಕ ವ್ಹೈ. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />ಯಹೊವಾ ಮಾರಾ ಮಾಲಕನೆ ಘನ್ನೊ ಸೌಕಾರ ಕರ‍್ಯೊಸ. ತಿಕನ ಬಕ್ರಾ ಢೊರೊ, ಕ್ಹೊನು ರುಪ್ಪು ಆಳೊ ಹುಂಟೊ ಗದ್ಡಾ ದಿದ್ಯೊಸ. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />ಮಾರಾ ಮಾಲಕನಿ ಬೈಕೊ ಥಯಲ ಸಾರಳಾನೆ ವೈಸ ಥಯಲ್ಪರ ತಿನಾಹುತಿ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿ; ತೆ ದಿಕ್ರಾನೆ ಮಾರಾ ಮಾಲಕಕನ ರ‍್ಹಯಲ ಕ್ಹಾರುಜ಼ ತಿನೆ ದಿದ್ಯೊಸ. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />ಯಕ್ಲುಜ಼ ನೈಸೊ ಮಾರೊ ಮಾಲಕ ಪ್ರಯಾಣ ಕರೈನ, 'ಮಿ ರ‍್ಹಯಲ ಕಾನಾನ ದೆಶವಾಲಾವೊಕ್ಹು ಮಾರಾ ದಿಕ್ರಾನೆ ಛೊಕ್ರಿ ಲಿದ್ಯಾವಾಚಿ, <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />ಇನಾ ಬದಲಿ ಮಾರಾ ಬಾನಾ ಘರೆ ಮಾರಾ ಘರ್ದಾನಾವಾಲಾವೊಕನ ಗೈನ ತ್ಯುನೊಕಂತಿ ಛೊಕ್ರಿ ಲಿನ ಔ ಕೈನ ಮನೆ ಮೊಕಲ್ಯೊಸ. <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />ಮಿ ಮಾರಾ ಮಾಲಕನೆ, 'ಯಕ್ಕ ಟೈಮ್ಮ ಮಾರಾಪಾಚಿ಼ ತೆ ಛೊಕ್ರಿನೆ ಮನಸ ನೈ ರ‍್ಹಯುಮ ಮನೆ ಕದಿಮ <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />ತೆ ಮನೆ 'ಮಿ ಆರಾಧನಾ ಕರ್ತೊ ಆಯಲ ಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ತೆ ಯಹೊವಾ ತಿನಾ ದುತೊನೆ ತಾರಾ ಕ್ಹಾತೆ ಮೊಕ್ಲಿನ ತು ಮಾರಾ ಖಾಂದಾನವಾಲಾ ರ‍್ಹಯಲ ಮಾರಾ ದಿಕ್ರಾನೆ ಛೊಕ್ರಿಲಿವಾನಾ ಹುತಿ ಮದತ ಕರಸ. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />ತೆ ಥಯಲ್ಪರ ಮಿ ಕರಾಯಲ ಪ್ರಯಾಣಕ್ಹು ತು ಜಾ಼ತಾಮಾ ತು ಬಿಡುಗಡೆ ಛೆ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 24:41" /><verse number="42" style="v" sid="GEN 24:42" />ಮಿ ಎ ಟೈಮ್ಮಾ ಎ ಗಾಮ್ನಿ ಇರಕನ ಆತಾಮಾ, ಮಾರಾ ಮಾಲಕನೊ ಅಬ್ರಹಾಮನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾಜ಼, ಪಾನಿನಿ ಇರಕನ ಕ್ಹಾಲಿ ಹುಬ್ರಯೊತೊ; ತು ಮಾರಾ ಪ್ರಯಾಣ ಸಫಲ ಕರಾನೊ ರ‍್ಹಯೊಮ <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />ಪಾನಿನಾ ಹುತಿ ಆವಾನಿ ಕೈ ಛೊಕ್ರಿನೆ, ತು ಮರ್ಗಿನ ತಾರಾ ಘಡಾಮಾನು ದಕ್ಹು ಪಾನಿ ಪಿವಾನಾ ದೆ ಯಾ, ಕೈನ ಪುಚ್ತಾ಼ಮಾ ತೆ, <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />ಪಿ ಬಾ ವರಿ ತಾರಾ ಹುಂಟೊನೆಬಿ ಪಾನಿ ಲೈನೆ ದ್ಯುಸ. ಕವಸ ತೆಜ಼ ಛೊಕ್ರಿ ಯಹೊವಾಕ್ಹು ಇನಿಲಿದಲ ಮಾರಾ ಮಾಲಕನಾ ದಿಕ್ರಾನೆ ನೆಮ್ಸಲ ಛೊಕ್ರಿ ಥಾವಾದೆ. ಕೈನ <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />ಮಿ ಮಾರಾ ಮನಸ್ಮಾ ಕೈಲೆತಾಮಾಜ಼, ರೆಬೆಕ್ಕ ಖಾಂದಾಪರ ಘಡೊಲಿನ ಆವಾನು ಮಿ ದೆಕ್ಯೊ. ತೆ ಇರಮಾ ಉತ್ರಿನ ಪಾನಿಲಿನ ಆತಾಮಾ ಮಿ ತಿನೆ, ಮನೆ ಪಿವಾನಾಹುತಿ ಪಾನಿ ದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />ತೆಳಾಮಾಜ಼ ತೆ ಮನೆ ಪಾನಿ ಪಿವಾನೆ ದಿದಿ ವರಿ ಹುಂಟೊನೆಬಿ ಪಾನಿ ದಿದಿ. <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />ತು ಕಿನಿ ದಿಕ್ರಿ ವ್ಹೈ ಕೈನ ಮಿ ಪುಚ್ತಾ಼ಮಾ ತೆ ಮಿ ನಾಹೊರನೆ ಮಿಲ್ಕಾನನೆ ಹುಟ್ಟಲ ಬೆತೊವೆಲನಿ ದಿಕ್ರಿ ವ್ಹೈ ಕೈನ ಕದಿ. <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />ತೆಳಾಮಾ ಮಿ ತಿನೆ ನಾಕಮಾ ಘಾಲ್ಲಿವಾನಾಹುತಿ ಪ್ಹುಲ್ಲಿ ವರಿ ತಿನೆ ಹತಮಾ ಘಾಲ್ಲಿವಾನಾ ಹುತಿ ಕಡಾ ದಿನ ಮಾರೊ ಮಾಲಕ ಥಯಲ ಅಬ್ರಹಾಮನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ನಮಸ್ಕಾರ ಕರಿನ ತೆ ಮಾರೊ ಮಾಲಕ ಥಯಲ ಅಬ್ರಹಾಮನೆ ದಿಕ್ರಾನಾ ಹುತಿ ತಿನಾ ಭೈನಿ ಲಿವಾನಾಹುತಿ ಮನೆ ಕ್ಹರಿನಿ ವಾಟ್ಮಾ ಬಲೈಲಾಯಲ ಹುತಿ ತಿನೆ ಕೊಂಡಾಡ್ಯೊ. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />ಇಮ ರ‍್ಹತಾಮಾ ಮಾರಾ ಮಲಕನೆ ಮಯಾಕ್ಹು ಬರೊಕ್ಹಾಕ್ಹು ಚಾ಼ಲಾನಾ ಹುತಿ ಒಪ್ಯಾಮ ಮನೆ ಕವೊ. ನೈತೊ ನೈ ಕವೊ, ಮಿ ತೆಳಾಮಾ ಸಿದಾ ಹತೆ ನೈ ತೊ ಡಾವಾ ಬಗಲ ಮಿ ಅಗೊ ಜ಼ೌಸ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 24:49" /><verse number="50" style="v" sid="GEN 24:50" />ತೆ ವಾತೆ ಲಾಬಾನ, ಬೆತೊವೆಲ 'ಕ್ಹಾರೊ ಯಹೊವಾಕ್ಹುಜ಼ ಥಯು; ಹಮೆತೊ ಹೊ ಕೈನವರಿ ನೈಕೈನ ಕತಾ ನೈ. ರೆಬೆಕ್ಕನೆ ತಾರಾ ಹತ್ಮಾ ವಪ್ಸಿನೆ ದಿಯೆಸ. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />ಬಲೈಲಿನ ಜಾ಼ ಸಕ್ಷಿ.ಯಹೊವಾ ಕದಲ ತಿಮ್ಮಜ಼ ರೆಬೆಕ್ಕ ತಾರಾ ಮಾಲಕನಾ ದಿಕ್ರಾನೆಜ಼ ಬೈಕೊ ಥಾವಾದೆ. ಕದ್ಯಾ. <verse eid="GEN 24:51" /><verse number="52" style="v" sid="GEN 24:52" />ಅಬ್ರಹಾಮನೊ ಸೆವಕ ತ್ಯುಯೊ ವಾತೊ ಐಕ್ತಾಮಾ ಯಹೊವಾನೆ ಮನಸ್ಕಾರ ಕರ‍್ಯೊ. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />ತೆ ತೆ ಲಾಯಲ ಕ್ಹೊನು ರುಪ್ಪು ವಣ್ಣಾ ಲಿನ ರೆಬೆಕ್ಕನೆ ದಿದ್ಯೊ. ತಿನಾ ಭೈನೆ ತಿನಿ ಯಾನೆ ಬಿ ಮೊಗಾನು ಸಾಮನ ದಿದ್ಯೊ. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />ತೆ ಥಯಲ್ಪರ ತಿನಾ ಕ್ಹಾತೆ ಆಯಲ ಸೆವಕೊನೆಬಿ ಉಪಚಾರ ಮುಗ್ಸಿನ ಕ್ಹಾರಿ ರಾತ ತ್ಯಾಜ಼ ರ‍್ಹೈನ ಪಾಟೆ ಉಟಿನ ತಿನಾ ಮಾಲಕ ಕನ ಜಾ಼ವಾನೆ ಅಪ್ಪಣೆ ದೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 24:54" /><verse number="55" style="v" sid="GEN 24:55" />ರೆಬಕ್ಕನೊ ಭೈ, ತಿನಿ ಯಾ ತಿನೆ ಛೊಕ್ರಿತೊ ಹಜು಼ನ ದಕ್ಹ ದಿನ್ನ ತಬಿ ಹಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ ಪಾಚಾ಼ತಿ ತೆ ಜಾ಼ ಸಕಸ ಕೈನ ಕದ್ಯಾ. <verse eid="GEN 24:55" /><verse number="56" style="v" sid="GEN 24:56" />ತೆ ತ್ಯುನೊನೆ ಯಹೊವಾ ಮಾರು ಪ್ರಯಾಣ ಸಫಲ ಕರ‍್ಯೊಸ. ತಿನಾಹುತಿ ಮನೆ ತರಬೊನಕೊ ಮಾರಾ ಮಾಲಕಕನ ಮನೆ ಅಪ್ಪಣೆ ಥಾವಾದೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 24:56" /><verse number="57" style="v" sid="GEN 24:57" />ಹಮೆ ಛೊಕ್ರಿನೆ ಬಲೈನ ತಿನಿ ಅಬಿಪ್ರಾಯ ತಿಳದಿಲಿಯೆಸ ಕದ್ಯಾ. <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />ತೆ ನೈಸೊ ರೆಬರಕ್ಕನೆ ಬಲೈನ ' ಯಾ ಆ ಮನಕ್ಹನಾ ಕ್ಹಾತೆ ತು ಜಾ಼ಶಿಸು? ಕೈನ ಪುಚ್ಯಾ. ತೆಳಾಮಾ ತೆ ಜೌ಼ಸ ಕದಿ. <verse eid="GEN 24:58" /><verse number="59" style="v" sid="GEN 24:59" />ತೆಳಾಮಾ ತ್ಯುನೆ ತಿನಿ ಭೆನ ಥಯಲ ರೆಬೆಕ್ಕನೆ ತಿನಿ ದಾಸಿಯೊನೆ ಬಲೈಲ ಅಬ್ರಹಾಮನಾ ಮಕ್ಹನಾ ಕ್ಹಾತೆ ಮೊಕಲ್ಯಾ. <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />ವರಿ ರೆಬೆಕ್ಕಳನೆ ಭೆನ ತಾರಾಕ್ಹು ಹಜಾ಼ರ ದಕ್ಹ ಹಜಾ಼ರ ಸಂತಾನ ಥಾವಾದೆ ತಾರಿ ಸಂತಾನ ತ್ಯುನಾ ದುಶ್ಮನೊನೆ ಹರಾವಾದೆ ಕೈನ ಕದ್ಯಾ. <verse eid="GEN 24:60" /><verse number="61" style="v" sid="GEN 24:61" />ರೆಬೆಕ್ಕಳ ವರಿ ತಿನಿ ದಾಸಿಯೊ ಹುಂಟಪರ ಚ಼ಡಿನ ಜಾ಼ತಾಮಾ ಅಬ್ರಹಾಮನೊ ಸೆವಕ ತ್ಯುನಾ ಪಾಚೊ಼ ಗಯೊ. ಇನಾನಿಂಗತ ರೆಬೆಕ್ಕನೆ ಬಲೈಲಿನ ಗಯಾ. <verse eid="GEN 24:61" /><verse number="62" style="v" sid="GEN 24:62" />ಯಕ್ಲಾಮಾಜ಼ ಇಸಾಕ ಬೆರ ಲಹೈರೊಹಿ ಕವಾನಿ ಇರಕನ ಆಯೊತೊ ತೆ ಕಾನಾನ ದೆಶನಿ ದಕ್ಷಿಣ ಸಿಮೆಮಾ ವ್ಹತೊ. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />ಇಸಾಕ ಕ್ಹಾಂಜ಼ನಾ ಟೈಮ್ಮಾ ಧ್ಯಾನ ಕರಾಹುತಿ ಖುಲ್ಲಾ ರ‍್ಹಯಲ ಜ಼಼ಗಾಕನ ಗಯೊ. ತ್ಯಾ ತೆ ದೆಕ್ತಾಮಾ ಹುಂಟೊ ಆವಾನು ದೆಕ್ಯೊ. <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />ರೆಬೆಕ್ಕಳ ಇಸಾಕನೆ ದೆಕಿನ ಹುಂಟಪರ್ತಿ ಹೆಟಿ ಉತ್ರಿ. <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />ತೆ ರೆಬೆಕ್ಕಳ ತೆ ಸೆವಕನೆ ಅಪ್ನಾ ಕ್ಹಾಮೊ ರಾನ್ಮಾ ಚಾ಼ಲ್ತೊ ಆವಾಲೊ ಐಲೊ ಮನಕ್ಹೊ ಕುನ್ನ ವ್ಹೈ.? ಕೈನ ಪುಚ್ಚಿ. ತೆಜ಼ ಮಾರೊ ಮಾಲಕನೊ ದಿಕ್ರೊ ವ್ಹೈ ಕೈನ ಕತಾಮಾ ತೆ ಘುಮುಸ ಘಾಲ್ಲಿದಿ. <verse eid="GEN 24:65" /><verse number="66" style="v" sid="GEN 24:66" />ತೆ ಸೆವಕ ತೆ ಕರಲ ಕ್ಹಾರುಜ಼ ಇಸಾಕನೆ ಕತಾಮಾ ತಿನೆ ತಿನಿ ಯಾ ರ‍್ಹಯಲ ಸಾರಾಳನಿ ಗುಡಾರೆ ಬಲೈಲಿನ ಗಯೊ. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />ಇನಾನಿಂಗತ ಇಸಾಕ ರೆಬೆಕ್ಕಳ ಹಿವಾ ಕರ್ಲಿನ ಮಳ್ಯಾ ತೆ ತಿನಿ ಬೈಕೊ ಥೈ ತೆ ತಿನೆ ಮಯಾ ಕರಿನ ತಿನಿ ಯಾ ಮರಲ ದುಖ ಕದ್ಯೊ ವರಿ ಇಕ್ಹರ‍್ಯೊ.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">ಅಬ್ರಹಾಮನಿ ಬಿಜೆಕ ಸಂತತಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />ಅಬ್ರಹಾಮ ಕೆಟೊರ ಕವಾಲಿ ವರಿ ಯಕ್ಲಿನೆ ಹಿವಾ ಕರಿಲಿದ್ಯೊ. <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />ತೆ ಅಬ್ರಹಾಮನೆ ಜಿಮ್ರಾನ, ಯೊಕ್ಷಾನ, ಮೆದಾನ, ಇಷ್ಬಾಕ, ಶುಹಾ ಇವ್ನೊನೆ ಜ಼ನ್ನಿ. <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />ಯೊಕ್ಷಾನ ಶೆಬಾ, ದೆದಾನ ಕವಾಲಾವೊನೆ ಪಡದ್ಯೊ. ಅಶ್ಮೊರ್ಯರ, ಲೆಟುಶ್ಯರೊ,ಲೆಯುಮ್ಯರ ದೆದಾನಕ್ಹು ಹುಟ್ಯಾ. <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />ಗೆಫಾ, ಗೆಫರ, ಹನೊಕ, ಅಬಿದಾ, ಎಲ್ದಾಯಾ ಕವಾಲಾ ಮಿದ್ಯಾನಕ್ಹು ಹುಟ್ಯಾ. ಇವ್ನೆ ಕ್ಹಾರಾ ಕೆಟೊರನಿ ಸಂತತಿ ವ್ಹೈ. <verse eid="GEN 25:4" /><verse number="5" style="v" sid="GEN 25:5" />ಅಬ್ರಹಾಮ ತಿನಿ ಆಸ್ತಿ ಕ್ಹಾರಿ ಇಸಾಕನೆ ದಿದ್ಯೊ. <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />ಅಬ್ರಹಾಮ ತಿನಿಯೊ ಬಿಜಿಯೊ ಬಾಕ್ಡಿಯೊನಾ ಬಚ್ಚಾ಼ವೊನೆ ಆಸ್ತಿ ದಾನ ಕರ‍್ಯೊ ವರಿ ತೆ ಜಿವ್ತೊ ರ‍್ಹತಾಸ್ತಾಜ಼ ತ್ಯುನೊನೆ ಇಸಾಕಕಂತೊ ಪುರ್ವ ದಿಕ್ಕಮಾ ರ‍್ಹಯಲ ಕೆದೆಮ ದೆಶನೆ ಮೊಕಲ್ಯೊ.<verse eid="GEN 25:6" /></para>
  <para style="s">ಅಬ್ರಹಾಮನು ಮರಣ</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />ಅಬ್ರಹಾಮ ಯಕ್ಹೊನ ಸತ್ತರ್ಪರ ಪಾಂಚ ವರಕ್ಹ ಜಿವ್ತೊ ವ್ಹತೊ. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />ಅಬ್ರಹಾಮ ತಿನಿ ವೈಸ ಪುರಾ ಥೈನ ಗಡಿಯೊ ಥೈನ ಮರಿನ ತ್ಯುನಾ ಪಿತೃಯೊಕನ ಗೈನ ಮಳ್ಯೊ. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />ತಿನಾ ದಿಕ್ರಾ ಥಯಲ ಇಸಾಕ ಇಷ್ಮಾಯೆಲ ಹಿತ್ತಿಯ ಥಯಲ ಚೊಹರನೊ ದಿಕ್ರೊ ಎಫ್ರನೆಣಿ ಜಮಿನಮಾ ರ‍್ಹಯಲ ಮಕ್ಪೆಲನ ಗವಿಮಾ ತಿನೆ ಸಮಾದಿ ಕರ‍್ಯಾ. ತೆ ಮಮ್ರೆಯ ತೊಪನಿ ಪುರ್ವ ದಿಕ್ಕಮಾ ಛೆ. <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />ಅಬ್ರಹಾಮ ತೆ ಜಿಮಿನ ಹಿತ್ತಿಯವಾಲಾವೊಕಂತಿ ಇಕ್ಕಾತಿ ಲಿದ್ಯೊತೊ ತಿನಾಜ಼ ಅಬ್ರಹಾಮನಿ ಬೈಕೊ ಸಾರಾಳನೆ ವರಿ ತಿನೆ ಸಮಾದಿ ಥೈ. <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />ಅಬ್ರಹಾ ಮರಲ್ಪರ ಕ್ಹುದಾನಿ ಮರ್ಗಾ ತಿನೊ ದಿಕ್ರೊ ಥಯಲ ಇಸಾಕನೆಬಿ ಮಳಿ.ಇಸಾಕ ಬೆರ ಲಹೈರೊಹಿ ಕನ ವ್ಹತೊ.<verse eid="GEN 25:11" /></para>
  <para style="s">ಇಸ್ಮಾಯಿಲನು ಘರ್ದಾನು</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />ಅಬ್ರಹಾಮ ಸಾರಳಾ ಐಗುಪ್ತನಿ ದಾಸಿ ಥಯಲ ಹಾಗರಳನೆ ಹುಟ್ಟಲ ಇಷ್ಮಾಯೆಲನಿ ಕುಟುಂಬನಿ ಚರಿತ್ರ. <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />ಇಷ್ಮಾಯಿಲನಾ ಬಚ್ಚಾ಼ವೊನೆ ಇನಾಕ್ಹು ಹುಟ್ಟಲ ಕುಟುಂಬನಾ ನಾಮೊ ಕಯಾ ವ್ಹೈ ಕದ್ಯಾಮ; ಪೈಲಾ ಹುಟ್ಟಲ ನೆಬಾಯೊತ, ಪಾಚಾ಼ತೊ ಕೆದಾರ ಅದ್ಬೆಯೆಲ ಮಿಬ್ಸಾಮ, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />ಮಿಷ್ಮಾ ದುಮಾ ಮಸ್ಸಾಸಂತಾನವಾಲಾ ಇವ್ನೆಜ಼ ವ್ಹೈ.ಇವ್ನಾ ಕುಲವಾಲಾ <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />ಹದದ, ತೆಮಾ ಯಟುರ ನಾಫಿಷ ಕೆದ್ಮಾ ಕವಾಲಾ <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />ತ್ಯುನಾ ಖಾಂದಾನನಾ ಗಾಮೊಮಾ ಪಾಳೆಮಾ ರ‍್ಹಯಲ ಇಷ್ಮಾಯಿಲ ಸಂತಾನವಾಲಾ ಇವ್ನೆಜ಼ ವ್ಹೈ.ಇವ್ನಾ ಕುಲವಾಲಾ ಸಂಖೆನಿಂಗತ ಬಾರಾ ಜ಼ನಾ ಅರಸರಿಕರಸ. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />ಇಷ್ಮಾಯಿಲ ಯಕ್ಹೊನ ಮುವತ್ತಪರ ಕ್ಹಾತ ವರಕ್ಹ ಜಿವ್ತೊ ವ್ಹತೊ. ಪಾಚಾ಼ತೊ ತೆ ಮರ‍್ಯೊ. ತ್ಯುನಾ ಪಿತೃವೊಕನ ಮಳ್ಯೊ. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />ಇಷ್ಮಾಯಿಲೊ ಹವಿಲತೊಐಗುಪ್ತ ದೆಶಮುಡಲಮಾ ರ‍್ಹಯಲ ಅಶ್ಯುನಿ ವಾಟ್ಮಾ ರ‍್ಹಯಲ ಶುರಿನ ಲಕ್ಕಾ ವಾಸ ಕರ‍್ಯಾ. ಇಮ ತ್ಯುನೊನೆ ತ್ಯುನಾ ಸಂಭದಿಕೊನೆ ರ‍್ಹವಾನೆ ಜ಼ಗಾ ಮಳಿ.<verse eid="GEN 25:18" /></para>
  <para style="s">ಎಸಾವ ವರಿ ಯಾಕೊಬ ಹುಟ್ಟಲ</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />ಅಬ್ರಹಾಮನಾ ದಿಕ್ರೊ ಥಯಲ ಇಸಾಕನಿ ಚರಿತ್ರೆ. <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />ಅಬ್ರಹಾಮ ಇಸಾಕನೆ ಪಡದ್ಯೊ. ಇಸಾಕ ಚಾ಼ಳಕ್ಹವರಕ್ಹೊನಾ ರ‍್ಹತಾಮಾ ಅರ್ಯಾಮನೊ ಥಯಲ ಬೆತೊವೆಲನಿ ದಿಕ್ರಿ ಅರಾಮ್ಯ ಥಯಲ ಲಾಬಾನನಿ ನ್ಹಾನಿ ದಿಕ್ರಿನ ಥಯಲ ರೆಬೆಕ್ಕನೆ ಪದ್ದನ ಅರಾಮ್ತೊ ಬಲೈನ ಬೈಕೊ ಕೈನ ಕರ್ಲಿದ್ಯೊ. <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />ತೆ ಗ್ವಡ್ಡ ರ‍್ಹಯಲಹುತಿ ಇಸಾಕ ತಿನಾಹುತಿ . ಯಹೊವಾಕನ ಪ್ರಾಥನಾ ಕರಿನ ಮಾಂಗಿಲಿದಲ ಕ್ಹು ರೆಬೆಕ್ಕ ಪೆಟೆ ರ‍್ಹೈ. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />ತಿನಾ ಪೆಟಮಾ ಬಚ್ಚಾ಼ ವದ್ಯಾಡಾಕ್ಹು ತೆ, ಇಮ ಥಯುಮ ಮಿ ಕಿಮ ಜಿವ್ತಿ ರ‍್ಹೌ. ಕೈನ ಇನಾಹುತಿ ಯಹೊವಾನಿ ಸನ್ನಿದಿಮಾ ವಿಚಾರ ಕರಾಹುತಿ ಗೈ. <verse eid="GEN 25:22" /><verse number="23" style="v" sid="GEN 25:23" />ಯಹೊವಾ ತಿನೆ,</para>
  <para style="q1" vid="GEN 25:23">'ತಾರಾ ಪೆಟಮಾ ಬೆಜ಼ನಾಂಗೊ ಛೆ; ಎ ಬೆ ಜ಼ನಾಂಗ ಹುಟ್ತಾಮಾಜ಼ ಭಿನ್ನ ಥೈನ ರ‍್ಹವಸ. ತ್ಯುನೊಮಾ ಯಕ್ತಿ ಯಕ್ಕ ತಾಕತವರ ರ‍್ಹವಸ. ಮ್ಹೊಟೊ ನ್ಹಾನಾನಿ ಸೆವೆ ಕರಸ”. ಕದ್ಯೊ.<verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />ತಿನೆ ದಿನೊ ಭರಿನ ಜ಼ನ್ನಿ. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />ಪೈಲಾ ಹುಟ್ಟಲ ಲಾಲ ವರಿ ಅಂಗ ಭರಿನ ಬಾಲೊ ವ್ಹತಾ ತಿನೆ ಎಸಾವ, ಕೈನ ನ್‍ಮ ಮ್ಹೆಲ್ಯಾ. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />ಬೆವಾ ಬಚ್ಚು಼ ಎಸಾವನಿ ಪಗನಿ ಎಡಿ ಧರಲಿನ ಹುಟ್ಟಲ ಹುತಿ ತಿನೆ ಯಾಕೊಬ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯಾ. ತ್ಯುನೆ ಹುಟ್ತಾಮಾ ಇಸಾಕನೆ ಕ್ಹಾಟ ವರಕ್ಹ ವ್ಹತಿ.<verse eid="GEN 25:26" /></para>
  <para style="s">ಎಸಾವ ತಿನು ಪೈಲಾರತನಾನು ಹಕ್ಕ ಇಕ್ಕಾನು</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />ತೆ ಭಂಬಿ ಪಟ್ಟಾ ಮ್ಹೊಟಾ ಥಾತಾಮಾ ತ್ಯುನೊಮಾ ಎಸಾವ ಶಿಕಾರ ಕರಾಮಾ ಶಾಣ್ಯೊ ಥಯೊತೆ ರಾನ್ಮಾ ರ‍್ಹವಾಲೊ ಥಯೊ. ಯಾಕೊಬ ಶಾಂತ ಮನಕ್ಹ ಥೈನ ಗುಡಾರೊಮಾ ರ‍್ಹವಾಡೊ. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />ಶಿಕಾರ ಕರಲ ಮಾಕ್ಹ ಘನು ಪಸಂಧ ರ‍್ಹಯಲಹುತಿ ತೆ ಎಸಾವನೆ ಘನ್ನೊ ಮಯಾ ಕರ‍್ಯೊ. ರೆಬೆಕ್ಕಾ ಯಾಕೊಬನೆ ಮಯಾ ಕರಾಡಿ. <verse eid="GEN 25:28" /><verse number="29" style="v" sid="GEN 25:29" />ಯಕ್ಕದಿನ್ನ ಯಾಕೊಬ ಅನ್ನ ಕರ್ತಾಮಾ ಎಸಾವ ರಾನತೊ ದಣದಿನ ಐನ ತಿನೆ, ಮಿ ಘನ್ನೊ ದಣದಿನ ಆಯೊಸ. <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />ಐಲು ಲಾಲ ರ‍್ಹಯಲ ಪದಾರ್ಥ ಹಮ್ನಾಜ಼ ಮನೆ ಖಾವಾನಾ ಹುತಿ ದೆ. ಕದ್ಯೊ. ಎ ಸಂಗತಿಕ್ಹು ಎಸಾವನೆ ಎದೊಮ ಕೈನ ನಾಮ ಪಡ್ಯು. <verse eid="GEN 25:30" /><verse number="31" style="v" sid="GEN 25:31" />ಯಾಕೊಬ ತಿನೆ ತುನೆ ಪೈಲಾರ ಕವಾನು ರ‍್ಹಯಲ ಮನೆ ಇಕ್ಕಿಪಾಡ ಕತಾಮಾ,<verse eid="GEN 25:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="GEN 25:32" />ಎಸಾವ ಕದ್ಯೊ ಥಯು ಕದ್ಯೊ ಮಾರಾ ಹೆವಾ ಮರಾಲಾನೆ ಪೈಲಾರ ಕವಾನು ಸುಜ಼ ಉಪಯೊಗ ನತ್ತಿ. ಕದ್ಯೊ.<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />ತೆಳಾಮಾ ಯಕೊಬ ಪೈಲಾ ಪ್ರಯಾಣ ಕರು ಕತಾಮಾ ಎಸಾವ ಪ್ರಯಾಣ ಕರಿನ ತಿನೆ ರ‍್ಹಯಲ ಪೈಲಾರ ಕವಾನು ಹಕ್ಕ ತಿನೆ ದಿಪಾಡ್ಯೊ. <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />ತೆಳಾಮಾ ಯಾಕೊಬ ಎಸಾವನೆ ರೊಕ್ಲೊ ಅಲಸಂದಾನಿ ಗುಗ್ಗರಿನು ಕ್ವಡ್ಡು ಕೊಡಾನ ದಿದ್ಯೊ. ಎಸಾವ ಖೈನ ವರಿ ಪಿನ ಗೈಪಡ್ಯೊ. ಇಮ್ಮ ತಿನೆ ರ‍್ಹಯಲ ಪೈಲಾರ ಕವಾನು ಹಕ್ಕನೆ ತಾತ್ಸಾರ ಕರಿಪಾಡ್ಯೊ.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">ಗೆರಾರಮಾ ಇಸಾಕ ರ‍್ಹಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />ಅಬ್ರಹಾಮನಾ ಕಾಲಮಾ ಆಯಲ ಬರ್ಗಾಲ ಯಕ್ಕಜ಼ ನೈಸೊ ಬಿಜೆಕ ಬರ್ಗಾಲ ಕಾನಾನ ದೆಶಮಾ ಪಡ್ಯು. ತೆಳಾಮಾ ಇಸಾಕ ಫಿಲಿಷ್ಟಿನೊ ರಾಜೊ಼ ಥಯಲ ಅಬಿಮೆಲಕಕನ ಗೆರಾರಿಯೆ ಗಯೊ. <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />ತ್ಯಾ ಯಹೊವಾ ಇಸಾಕನೆ ದರ್ಶನ ದಿನ ತು ಐಗುಪ್ತ ದೆಶನೆ ಉತ್ರಿನ ಜೌ಼ ನಕೊ ಮಿ ಕವಾನಾ ದೆಶ ಗೈನ ತ್ಯಾ ಜಿವ್ನಾ ಕರು. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />ತು ಎ ದೆಶಮಾ ರ್ಪವಾಸಿ ಥೈನ ರ‍್ಹೌ. ಮಿ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹೈನತುನೆ ಅಭಿವೃದ್ದಿ ಕರಿನ ತುನೆ ತಾರಿ ಸಂತತಿನೆ ಎ ಪ್ರದೆಶ ಕ್ಹಾರು ದಿಪಾಡುಸ. ಇಮ ತಾರಾ ಮಾ ಬಾಪನೆ ಕರಲ ವಾಗ್ದಾನನೆ ಪುರಾ ಕರುಸ. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />ತಾರಿ ಸಂತತಿಯೊನೆ ಹಬಾಳಮಾ ರ‍್ಹಯಲ ಚಿಕ್ಕಿಯೊ ನಿಂಗತ ಹುಟ್ಸೌಸ. ತಾರಿ ಸಂತತಿನೆ ಎ ಪ್ರದೆಶ ದಿಪಾಡುಸ. ತಾರಿ ಸಂತತಿನಾ ಮುಲಕ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲ ಕ್ಹಾರಿ ಜ಼ನಾಂಗನೆ ಆಶಿರ್ವಾದ ಮಳಸ. <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />ಕಾ ಕದ್ಯಾಮ ಅಬ್ರಹಾಮ ಮಾರಿ ವಾತನೆ ವಿಧೆಯ ಥೈನ ಮಾರಿಯೊ ನಿಯೊಮೊನೆ ಪ್ರಕಾರಜ಼ ಚಾ಼ಲಿಲಿನ ಗಯೊ. <verse eid="GEN 26:5" /><verse number="6" style="v" sid="GEN 26:6" />ಇಸಾಕ ಗೆರಾರಿಮಾ ವ್ಹತೊ. <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" />ತೆ ಗಾಮನಾ ಮನಕ್ಹೊ ತಿನೆ ಬೈಕೊನೆ ದೆಕಿನ ತಿನೆ ಪುಚ್ತಾ಼ಮಾ ತೆ ರೆಬೆಕ್ಕಳ ಸುಂದರ ರ‍್ಹಯಲಹುತಿ ತೆ ಜ಼ಗಾನಾ ಮನಕ್ಹೊ ಇನಾಹುತಿ ಮನೆ ಖಲಾಸ ಕರಸ ಕೈನ ತೆ ತಿನಿ ಬೈಕೊ ವ್ಹೈ ಕೈನ ಕವಾನೆ ಭುಚ಼ಕಿನ ಎ ಮಾರಿ ನ್ಹಾನಿ ಭೆನ ವ್ಹೈ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 26:7" /><verse number="8" style="v" sid="GEN 26:8" />ತೆ ತೆ ಜ಼ಗಾಪರ ಘನ್ನಾ ದಿನ್ನ ರ‍್ಹಯಲ್ಪರ ಯಕ್ಕ ದಿನ್ನ ಫಿಲಿಷ್ಟಿನೊ ರಾಜು಼ ರ‍್ಹಯಲ ಅಬಿಮೆಲಕ ಖಿಡಕಿಮಾತೊ ದೆಕ್ತಾಮಾ ಇಸಾಕ ತಿನಿ ಬೈಕೊ ರೆಬೆಕ್ಕಳನಾ ಕ್ಹಾತೆ ಮಯಾ ಕರಾನು ದೆಕ್ಯೊ. <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />ತೆಳಾಮಾ ಅಬಿಮೆಲಕ ಇಸಾಕನೆ ಬಲೈನ ಆ ಬಾಕ್ಡಿ ತಾರಿ ಬೈಕೊ ವ್ಹೈ ತೆ ತಾರಿ ಬೈಕೊ ವ್ಹೈ ಕೈನ ಕಾ ಕದ್ಯೊ? ಕೈನ ಪುಚ್ಯೊ. ಇಸಾಕ ತಿನೆ ತು ತಿನೆ ಲಿವಾನಹುತಿ ಮನೆ ಖಲಾಸ ಕರಿಪಾಡ್ಸಿ ಕೈನ ಇನಾನಿಂಗತ ಕದ್ಯೊ . <verse eid="GEN 26:9" /><verse number="10" style="v" sid="GEN 26:10" />ಅಬಿಮೆಲಕ ತಿನೆ ತು ಹಮೊನೆ ಕೆಟ್ಟ ಕರ‍್ಯೊ ಹಮೊಮಾ ರ‍್ಹಯಲ ದಾಣ್ಗಾವೊಮಾ ತಾರಿ ಬೈಕೊನಾ ಕ್ಹಾತೆ ಕ್ಹುರವಾನಾಹುತಿ ತುಜ಼ ವಾಟ ಕರಿನೆ ದಿದ್ಯೊಸ. ತೆ ಕ್ಹಾರು ಥಾವತ್ತೊ ಮ್ಹೊಟು ಅಪರಾಧ ಥಾತುತು ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 26:10" /><verse number="11" style="v" sid="GEN 26:11" />ತೆಳಾಮಾ ಅಬಿಮೆಲಕ ತಿನಾ ಪ್ರಾಜಾನೆ ಆ ಮನಕ್ಹ ಇನಿ ಬೈಕೊನೆ ಸುಜ಼ ಕೆಟ್ಟ ಕರು ನೈ ಕೈನ ಇವ್ನೊನೆ ಕೆಟ್ಟ ಕರಾಲಾವೊನೆ ಖಲಾಸ ಕರೈಪಾಡುಸ ಕೈನ ಕದ್ಯೊ.<verse eid="GEN 26:11" /></para>
  <para style="s">ಪಿಲಿಷ್ಟಿಯೊ ಇಸಾಕನೆ ವಳಾಯಲ</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />ಇಸಾಕ ತೆ ಪ್ರದೆಶ ಬಿಯ್ಯಾ ಬಿತ್ಯು ತೆ ತಿನೆ ತೆಜ಼ ವರಕ್ಹಮಾ ಮ್ಹೊಟಿ ಸುಗ್ಗಿ ಥೈ. ಯೆತಿನೆ ಘನ್ನೊ ಆಶಿರ್ವಾದ ದಿದ್ಯೊ. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />ತಿನಿ ಸೌಕಾರತನಾ ಜಾಸ್ತಿ ಥಾತಿ-ಥಾತಿ ತೆ ಘನ್ನೊ ಸೌಕಾರ ಥಯೊ. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />ತಿನೆ ಢೊರೊ ಬಕ್ರಾ ವರಿ ಪ್ರಾಣಿಯೊನು ಹಿಂಡ ವ್ಹತು. ಯಕ್ಲುಜ಼ ನೈಸೊ ತಿನೆ ಘನ್ನಾ ಸೆವಕೊ ವ್ಹತಾ ಎ ಕ್ಹಾರು ಫಿಲಿಷ್ಟಿವಾಲಾ ದೆಕಿನ ತಿನಾಹುತಿ ಸಂಗಟ ಘಾಲ್ಲಿವಾಡ್ಯಾತಾ. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />ತಿನಾಹುತಿ ಘನ್ನಾ ವರಕ್ಹ ಪಾಚೊ಼ ಅಬ್ರಹಾಮ ವರಿ ತಿನಾ ಸೆವಕೊ ಕಾಡಲ ಇರನೆ ಫಿಲಿಷ್ಟಿವಾಲಾ ತಿಮಾ ಮಾತಿ ಘಲಿನ ಝಾಕಿಪಾಡ್ಯಾ. <verse eid="GEN 26:15" /><verse number="16" style="v" sid="GEN 26:16" />ಅಬಿಮೆಲೆಕ ಇಸಾಕನೆ ಮಾರು ದೆಶ ಛೊಡಿನ ಗೈಪಡ ಕಾ ಕದ್ಯಾಮ ಮಾರಾತಿಬಿ ತು ಘನ್ನೊ ತಾಕವರ ಥಯೊಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 26:16" /><verse number="17" style="v" sid="GEN 26:17" />ತಿನಾಹುತಿ ಇಸಾಕ ತ್ಯಾಂತೊ ಗೈನ ಗೆರಾರಿನಾ ನ್ಹಾನಾ ವಕ್ಳಾನಾ ಬಾಜು಼ಮಾ ರ‍್ಹವಾನೆ ಜ಼ಗಾ ಕರಿಲಿದ್ಯೊ. ಇಸಾಕ ತ್ಯಾ ರ‍್ಹಯೊ. ಇತ್ತಿ ಪೈಲಾ ಘನ್ನಾ ವರಕ್ಹ ಪಾಚಾ಼ ಅಬ್ರಹಾಮ ಘನ್ನಿಯೊ ಇರೊ ಖಂದಾಯೊತೊ ಅಬ್ರಹಾಮ ಮರಲ್ಪರ ಫಿಲಷ್ಟಿಯೊ ತೆ ಇರೊ ಝಾಕಿ ಪಾಡ್ಯಾ. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />ಇಸಾಕ ತೆ ಇರೊ ವರಿ ಕಡೈನ ತಿನೊ ಬಾಪ ದಿದಲಜ಼ ನಾಮೊ ದಿದ್ಯೊ. <verse eid="GEN 26:18" /><verse number="19" style="v" sid="GEN 26:19" />ಇಸಾಕನಾ ಸೆವಕೊ ನ್ಹಾನಾ ವಕಳಾನಾ ನಜಿ಼ಕ ಐನ ಇರ ಖಂದ್ಯಾ ತೆ ತೆ ಇರಮಾ ಪಾನಿ ನಿಕ್ಹಳ್ಯು. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />ತೆ ನೈಸೊ ಗೆರಾರಿನಾ ಕಣಿವೆಮಾ ಢೊರೊ ವರಿ ಬಕ್ರಾ ಕೈದಾಲಾ ಮನಕ್ಹೊ ಇಸಾಕನಾ ಸೆವಕೊನಾ ಕ್ಹಾತೆ ತಕ್ರಾರ ಕರಿನ ಎ ಪಾನಿ ಹಮಾರು ವ್ಹೈ ಕೈನ ಕದ್ಯಾ. ತಿನಾಹುತಿ ಇಸಾಕ ತೆ ಇರನೆ ಎಸೆಕ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />ತೆ ಥಯಲ್ಪರ ಇಸಾಕನಾ ಸೆವಕೊ ವರಿ ಯಕ್ಕ ಇರ ಖಂದ್ಯಾ ತೆಳಾಮಾ ತ್ಯಾನಾ ಮನಕ್ಹೊ ಇರನಾ ಹುತಿ ತಕ್ರಾರ ಕರ‍್ಯಾ. ತಿನಾಹುತಿ ಇಸಾಕ ತೆ ಇರನೆ ಸಿಟ್ನಾ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />ಇಸಾಕ ತ್ಯಾಂತೊ ಗೈನ ವರಿ ಯಕ್ಕ ಇರ ಖಂದಾಯೊ. ತೆ ಇರನಾ ಹುತಿ ತಕ್ರಾರ ಕರಾನೆ ಕುನ್ನಜ಼ ಐಯುನೈ. ತಿನಾಹುತಿ ಇಸಾಕ ಹಮ್ನಾ ಯಹೊವಾ ಅಪ್ನಾಹುತಿ ಯಕ್ಕ ಜ಼ಗಾ ದೆಕಾಡಿನೆ ದಿದ್ಯೊಸ. ಅಪೆ ಎ ಜ಼ಗಾಪರ ಅಭಿವೃದ್ದಿ ಥೈಯೆಸ ಕೈನ ತೆ ಇರನೆ ರೆಹೊಬೊತ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 26:22" /><verse number="23" style="v" sid="GEN 26:23" />ಇಸಾಕ ತೆ ಜ಼ಗಾ ಕಂತೊ ಬೆರಷೆಬನೆ ಗಯೊ. <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />ತೆ ರಾತೆ ಇಸಾಕನೆ ಕ್ಹುದಾ ದಿಕ್ಹಿನ ಮಿ ತಾರಾ ಬಾ ಥಯಲ ಅಬ್ರಹನೊ ಕ್ಹುದಾ ವ್ಹೈ. ಭುಚ್ಕು ನಕೊ ಮಿ ತಾರಾ ಕ್ಹಾತೆ ಛೆ. ಮಿ ತುನೆ ಆಶಿರ್ವಾದ ದ್ಯುಸ ಮಿ ತಾರಾ ಕುಟುಂಬನೆ ಉನ್ನತ ಸ್ಥಿಮಾ ಲೌಸ. ಮಾರೊ ಸೆವಕ ಥಯಲ ಅಬ್ರಹಾಮನಾ ಹುತಿ ಎ ಕ್ಹಾರು ಕರುಸ.ಕೈನ ಕದ್ಯೊ <verse eid="GEN 26:24" /><verse number="25" style="v" sid="GEN 26:25" />ತಿನಾಹುತಿ ತೆ ಜ಼ಗಾಪರ ಇಸಾಕ ಬಲಿನೊ ಕಟ್ಟೊ ಭಾಂದಿನ ಯಹೊವಾನೆ ಆರಾಧನಾ ಕರ‍್ಯೊ.ಇಸಾಕ ತೆ ಜ಼ಗಾಪರ ಪಾಳೆ ಕರಿಲಿದ್ಯೊ.ತಿನಾ ಸೆವೆಕೊ ಯಕ್ಕ ಇರ ಖಂದ್ಯಾ.<verse eid="GEN 26:25" /></para>
  <para style="s">ಇಸಾಕ ವರಿ ಅಬಿಮೆಲಕನಾ ವಚ್ಮಾ ವಪ್ಪಂದ</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />ಅಬಿಮೆಲಕ ಇಸಾಕನೆ ದೆಕಾನಾಹುತಿ ಗೆರಾರಿತೊ ಆಯೊ. ಅಬಿಮೆಲೆಕ ಸಲಹೆ ದಿವಾಲೊ ಅಹುಜ್ಜತನ ವರಿ ಸೆನಾದಿಪತಿ ಥಯಲ ಫಿಕೊಲನನೆ ತಿನಾ ಕ್ಹಾತೆ ಬಲೈಲಾಯೊತೊ. <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />ಇಸಾಕ ತಿನೆ ಮನೆ ದೆಕಾನಾಹುತಿ ಆಯೊಸ ಕಾ? ಪೈಲಾ ತು ಮಾರಾ ಕ್ಹಾತೆ ದೊಸ್ತ ನಿಂಗತ ನ್ಹೊತೊ ವರಿ ತಾರು ದೆಶ ಛೊಡಿನೆ ಜಾ಼ವಾನಾ ಹುತಿ ತು ಜ಼ಬರದಸ್ತಿ ಕರ‍್ಯೊತೊ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 26:27" /><verse number="28" style="v" sid="GEN 26:28" />ತ್ಯುನೆ ತಿನೆ ತಾರಾ ಕ್ಹಾತೆ ಯಹೊವಾ ಛೆ ಕೈನ ಹಮ್ನಾ ಹಮೊನೆ ಗ್ವತ್ತ ಥೈಯು. <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />ಅಪೆ ಯಕ್ಕ ವಪ್ಪಂದ ಕರಿಲ್ಯು ಕೈನ ಹಮಾರಿ ವಿಚಾರ ವ್ಹೈ. ತು ಹಮೊನೆ ಯಕ್ಕ ಕ್ಹಮ ಘಾಲು ಕೈನ ಛೆ. <verse eid="GEN 26:29" /><verse number="30" style="v" sid="GEN 26:30" />ತಿನಾಹುತಿ ಇಸಾಕ ತ್ಯುನಾಹುತಿ ಯಕ್ಕ ಮ್ಹೊಟು ಖಾವಾನು ಕರಾಯೊ. ತ್ಯುನೆ ಕ್ಹಾರಾ ಚೊಕಿತರಾ ಅನ್ನ ಖಾದ್ಯಾ. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />ಮರ್ನಾ ದಿನ್ನಾ ಪಾಟೆ ತ್ಯುನೆ ಯಕ್ನಾ ಯಕ್ಕ ಕ್ಹಮ ಘಾಲಿನ ಸಮಾಧಾನುಕ್ಹು ಗಯಾ. <verse eid="GEN 26:31" /><verse number="32" style="v" sid="GEN 26:32" />ತೆ ದಿನ್ಮಾ ಇಸಾಕನಾ ಸೆವಕೊ ಐನ ತ್ಯುನೆ ಖಂದಲ ಇರನಾ ಹುತಿ ಕತಾಮ ತ್ಯಾ ಹಮೊನೆ ಪಾನಿ ಮಳ್ಯುಸ ಕೈನ ಕದ್ಯಾ.<verse eid="GEN 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 26:33" />ತಿನಾಹುತಿ ಇಸಾಕ ತೆ ಇರನೆ ಸಿಬಾ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ ತೆ ದಿನ್ನತಾಜ಼ ತೆ ಗಾಮನೆ ಬೆರ್ಷೆಬ ಕೈನ ಕವಸ.<verse eid="GEN 26:33" /></para>
  <para style="s">ಎಸಾವನಾ ಬಾಕ್ಡಿಯೊ</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />ಎಸಾವಾನೆ ಚಾ಼ಳಕ್ಹ ವರಕ್ಹ ಥಾತಾಮಾ ಹಿತ್ತಿಯೊಮಾನಾ ಬೆ ಜ಼ನಿಯೊನೆ ಹಿವಾ ಕರ್ಲಿದ್ಯೊ. ಯಕ್ಲಿ ಬೆರಿನಿ ದಿಕ್ರಿ ಥಯಲ ಯೆಹುದಿತಳನೆ ವರಿ ಯಕ್ಲಿ ಎಲೊನನಿ ದಿಕ್ರಿ ಥಯಲ ಬಾಶೆಮತನೆ, ಹಿವಾ ಕರಿಲಿದ್ಯೊ. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />ಎ ಹಿವಾವೊಕ್ಹು ಇಸಾಕ ವರಿ ರೆಬೆಕ್ಕನಾ ಮನಸನೆ ಘನ್ನು ದುಖ ಥಯು.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">ಇಸಾಕನೆ ಆಶಿರ್ವಾದ ದಿದಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />ಇಸಾಕ ಲಾಸ್ಟಮ್ಮಾ ಡೊಳಾ ನೈ ದಿಕ್ಹೆ ಅಕ್ಲಾ ಮೊಬ್ಬ ಥಯಲಕ್ಹು ತೆ ತಿನೊ ಮ್ಹೊಟೊ ದಿಕ್ರೊ ಥಯಲ ಎಸಾವನೆ ಬಲೈನ ದಿಕ್ರಾ ಕತಾಮಾ ಎಸಾವ ದೆಕ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕದ್ಯೊ. <verse eid="GEN 27:1" /><verse number="2" style="v" sid="GEN 27:2" />ಇಸಾಕ ತಿನೆ ಮಿ ಗಡಿಯೊ ಥಯೊಸ ಕೆಳಾಮಾ ಮರುಸ ಕವಾನು ಗ್ವತ ನತ್ತಿ. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />ತಿನಾ ಹುತಿ ತು ಬಿಲ್ಲು ಬಾಣಾ ವರಿ ಕ್ಹಾರ ಆಯುಧೊ ಲಿನ. <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />ರಾನ್ಮಾ ಗೈನ ಶಿಕಾರ ಕರಿನ ಶಿಕಾರ ಕರಲ ಮಾಕ್ಹ ಕ್ಹು ಮನೆ ಪಸಂದ ರ‍್ಹಯಲ ಚೊ಼ಕು ಅನ್ನ ಕರೈನ ಮನೆ ಖಾವನೆ ತಯ್ಯಾರ ಕರ, ಮನೆ ಮೌತ ಆವಾತಿ ಪೈಲಾ ಮಿ ತೆ ಖೈನ ತುನೆ ಆಶಿರ್ವಾದ ಕರುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 27:4" /><verse number="5" style="v" sid="GEN 27:5" />ಇಸಾಕ ತಿನೊ ದಿಕ್ರೊ ಥಯಲ ಎಸಾವನೆ ಕದಲ ವಾತ ರೆಬೆಕ್ಕನ ಕಾನೆ ಪಡಿ. <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />ಎಸಾವ ಶಿಕಾರ ಕರಾನೆ ರಾನ್ಮಾ ಗಯೆಲ ಟೆಮ್ಮಾ ರೆಬೆಕ್ಕ ತಿನೊ ದಿಕ್ರೊ ಥಯಲ ಯಾಕೊಬನೆ ತಾರೊ ಬಾ ತಾರೊ ಭೈ ಥಯಲ ಎಸಾವನೆ. <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />ತು ಗೈನ ಶಿಕಾರ ಕರಿನ ಶಿಕಾರ ಕರಲ ಮಾಕ್ಹಕ್ಹು ಮಾರಾ ಖಾವನಾ ಹುತಿ ಚೊ಼ಕಾ ಅನ್ನೊ ಕರೈನ ಮನೆ ಖಾವನೆ ಸಿದ್ದ ಕರ ಮನೆ ಮೌತ ಆವಾತಿ ಪೈಲಾ ಮಿ ತುನೆ ಯಹೊವಾನಾ ಸನ್ನಿಧಿಮಾ ಆಶಿರ್ವಾದ ಕರುಸ ಕೈನ ಕವಾನು ಐಕ್ಯೊಸ. <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />ತಿನಾ ಹುತಿ ದಿಕ್ರಾ ತು ಮಾರಿ ವಾತನೆ ಕಾನದಿನ ಐಕಿನ ಮಾರಿ ಅಪ್ಪಣೆ ನಿಂಗತಜ಼಼ ಕರ. <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />ಬಕ್ರಾವೊನ ಹಿಂಡಮಾ ಗೈನ ಬೆ ಚೊ಼ಕಾ ರ‍್ಹಯೆಲ ಬಕ್ರಾವೊನ ಬಚ್ಚಾ಼ವೊನೆ ಬೆಗಿನ ಲಿನ ಆ ತಿವ್ನಾಕ್ಹು ತಾರಾ ಬಾನೆ ಪಸಂದ ರ‍್ಹಯೆಲ ಛೊಕು ಅನ್ನ ಮಿಜ಼ ತಯಾರ ಕರುಸ. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />ತು ತೆ ಅನ್ನ ತಿನಾ ಕ್ಹಮೊ ಗೈನ ಖಾವಾನೆ ಘಾಲಿನ ದ್ಯು ಅಮ್ಮ ಕರ‍್ಯಾಮ ತೆ ಮರಾತಿ ಪೈಲಾ ತುನೆಜ಼ ಆಶಿರ್ವಾದ ಕರಸ ಕದಿ. <verse eid="GEN 27:10" /><verse number="11" style="v" sid="GEN 27:11" />ತಿನಾಹುತಿ ಯಾಕೊಬ ತಿನಿ ಯಾ ರೆಬೆಕ್ಕನೆ ಮಾರೊ ಮ್ಹೊಟೊ ಬೈ ಥಯಲ ಎಸಾವ ಅಂಗ ಭರಿನ ಬಾಲೊ ಹೊಂದಿ ಲಿದ್ಯೊಸ. ಮಿ ನರಮ ಚಾ಼ಮ್ಡು ರ‍್ಹಯಲವಾಲೊ ವ್ಹೈ. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />ತೆನೈಸೊ ಬಾ ಮನೆ ಮುಟ್ಟಿನ ದೆಕ್ಯೊಮ ಮಿ ತಿನೆ ಮೊಸ ಕರಲವಾಲೊ ವ್ಹೈ ಕೈನ ದಿಕ್ಹಿನ ಆಯೊಮ ಅಶಿರ್ವಾದತಿಬಿ ಕ್ಹರಾಪ ಹೊಂದಿಲ್ಯುಸ ಕದ್ಯೊ. <verse eid="GEN 27:12" /><verse number="13" style="v" sid="GEN 27:13" />ತಿನಿ ಯಾ ತಿನೆ ದಿಕ್ರಾ ತೆ ತುನೆ ಕ್ಹರಾಪ ದಿದ್ಯೊಮ ತೆ ಕ್ಹರಾಪ ಮನೆ ರ‍್ಹವಾದೆ, ತು ಮಾರಿ ವಾತ ಐಕಿನ ಬಕ್ರಾವೊನಾ ಬಚ್ಚಾ಼ವೊನೆ ಲಿನ ಆ ಕೈನ ಕದಿ. <verse eid="GEN 27:13" /><verse number="14" style="v" sid="GEN 27:14" />ತೆಳಾಮಾ ಯಾಕೊಬ ಗೈನ ಬಕ್ರಾವೊನಾ ಬಚ್ಚಾ಼ವೊನೆ ಲೈನ ತಿನಿ ಯಾ ನೆ ದಿದ್ಯೊ.ರೆಬೆಕ್ಕ ತಿನಾ ಬಾನೆ ಪಸಂದ ರ‍್ಹಯೆಲ ಸ್ವಾದ ಅನ್ನ ತಯ್ಯಾರ ಕರಿ. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />ಪಾಚಲ್ತಿ ರೆಬೆಕ್ಕ ತಿನಾ ಘರ್ಮಾ ರ‍್ಹಯಲ ತಿನಾ ಮ್ಹೊಟೊ ದಿಕ್ರೊ ಥಯಲ ಎಸಾವನಾ ಶ್ರೆಷ್ಠ ವಣ್ಣಾ ಲಿನ, ತಿನೊ ನ್ಹಾನೊ ದಿಕ್ರೊ ಥಯಲ ಯಾಕೊಬನೆ ಘಾಲಿ. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />ತೆ ಬಕ್ರಾವೊನಾ ಬಚ್ಚಾ಼ವೊನಾ ಚಾಮಡಾನೆ ತಿನಾ ಹತೊನೆ ಬಿ ನುಣುಪ ಥಯಲ ಗರ್ದನನೆ ಬಿ ಸುತ್ತಿ. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />ತೆ ಥಯಲ್ಪರ ತೆ ಸಿದ್ಧ ಕರಲ ಚೊ಼ಕು ಅನ್ನ ವರಿ ರೊಟ್ಲಾ ತಿನೊ ದಿಕ್ರೊ ಥಯಲ ಅಬ್ರಹಾಮನಾ ಹತ್ಮಾ ದಿದಿ. <verse eid="GEN 27:17" /><verse number="18" style="v" sid="GEN 27:18" />ತೆ ತಿನಾ ಬಾ ಕನ ಗೈನ 'ಬಾ” ಕೈನ ಬಲಾತಾಮಾ, ತಿನೊ ಬಾ, ಸು ವ್ಹೈ ದಿಕ್ರಾ ತು ಕುನ ವ್ಹೈ? ಕೈನ ಪುಚ್ಯೊ. <verse eid="GEN 27:18" /><verse number="19" style="v" sid="GEN 27:19" />ಯಾಕೊಬ ತಿನೆ ಮಿ ತಾರೊ ಮ್ಹೊಟೊ ದಿಕ್ರೊ ಥಯಕಲ ಎಸಾವ ವ್ಹೈ ತಾರಿ ಅಪ್ಪಣೆ ದಿದಲಜ಼ ಅನ್ನ ತಯ್ಯಾರ ಕರಿನ ಲಾಯೊಸ ಉಟಿನ ಬೈಟಿನ ಮಿ ಲಾಯೆಲ ಶಿಕಾರನು ಮಾಕ್ಹನು ಅನ್ನ ಖೈನ ಮನೆ ಆಶಿರ್ವಾದ ಕರ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 27:19" /><verse number="20" style="v" sid="GEN 27:20" />ಇಸಾಕ ಸು ದಿಕ್ರಾ ಅಕ್ಲಾ ಭೆಗಿನ ಶಿಕಾರ ಕಿಮ ಮಳ್ಯು ಕೈನ ಪುಚ಼ತಾಮಾ ತೆ ತಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ತೆ ಮರಾ ಕ್ಹಾಮೊಜ಼ ಆಯೆನಿಂಗತ ಕರ‍್ಯೊ ಕದ್ಯೊ. <verse eid="GEN 27:20" /><verse number="21" style="v" sid="GEN 27:21" />ಪಾಚಾ಼ತೊ ಇಸಾಕ ಯಾಕೊಬನೆ ಮಕನ ಆ ಮಿ ಮಾರಾ; ದಿಕ್ರಾನೆ ಮುಟ್ಟಿನ ಗ್ವತ್ತ ಕರಿಲ್ಯುಸ. ಮಿ ತುನೆ ಮುಟ್ಯುಮ ತು ಕ್ಹರಿಮಾಜ಼ ಮಾರೊ ದಿಕ್ರೊ ಎಸಾವಜ಼ ವ್ಹೈಸು ಕೈನ ತಿಳದಿಲ್ಯುಸ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 27:21" /><verse number="22" style="v" sid="GEN 27:22" />ತಿನಾಹುತಿ ಯಾಕೊಬ ತಿನೊ ಬಾಕನ ಇಸಾಕಕನ ಗಯೊ.ಇಸಾಕ ತಿನೆ ಮುಟ್ಟಿನ ತಾರೊ ಗಳೊ ಯಾಕೊಬನೊ ಗಳೊ ನಿಂಗತ ಛೆ. ತೆನೈಸೊ ತಾರಾ ಹತೊ ಯೆಸವಾನಾ ಹತೊ ನಿಂಗತ ಬಾಲೊಕ್ಹು ಭರಲ ಛೆ. <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />ತೆ ಯಾಕೊಬ ವ್ಹೈ ಕೈನ ಇಸಾಕನೆ ಗ್ವತ್ತ ಥಯು ನೈ. ಕಾ ಕದ್ಯಾಮ ತಿನಾ ಹತೊ ಇಸಾಕನಾ ಹತೊಪರ ರ‍್ಹಯಲ ಬಾಲೊ ನಿಂಗತ ವ್ಹತಾ. ತಿನಾಹುತಿ ಇಸಾಕ ಯಾಕೊಬನೆ ಆಶಿರ್ವಾದ ಕರ‍್ಯೊ. <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />ಇಸಾಕ ತಿನಿ ತು ಕ್ಹರಿಮಾಜ಼ ಮಾರೊ ದಿಕ್ರೊ ವ್ಹೈ ಸು? ಕೈನ ಪುಚ್ಯೊ ತಿನಾಹುತಿ ಯಾಕೊಬ ಮಿಜ಼ ವ್ಹೈ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 27:24" /><verse number="25" style="v" sid="GEN 27:25" />ತೆಳಾಮಾ ಇಸಾಕ ಅನ್ನಲಿನ ಆಮಿ ಅನ್ನ ಖೈನ ತುನೆ ಆಶಿರ್ವಾದ ದ್ಯುಸ.ಕೈನ ಕದ್ಯೊ. ತಿನಾನಿಂಗತ ಯಾಕೊನ ತಿನೆ ಅನ್ನ ಲೈನ ದಿದ್ಯೊ ತೆ ಖೈನ ದ್ರಾಕ್ಷಿನೊ ರಕ್ಹ ಪಿದ್ಯೊ. <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />ಪಾಚಾ಼ತಾ ಇಸಾಕ ತಿನೆ ಮಕನ ಐನ ಮನೆ ಮಟ್ಟಿ ದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 27:26" /><verse number="27" style="v" sid="GEN 27:27" />ತಿನಾನಿಂಗತ ಯಾಕೊಬ ತಿಕನ ಗೈನ ತಿನೆ ಗಳೆ ಮಳ್ಯೊ. ಇಸಾಕ ತಿನಾ ವಣ್ಣಾವೊನಿ ಬಾಸ ದೆಕಿನ ತಿನೆ ಆಶಿರ್ವಾದ ದಿದ್ಯೊ. ಆಹಾ ಮಾರಾ ದಿಕ್ರಾನಿ ಬಾಸ ಯಹೊವಾ ಆಶಿರ್ವಾದ ದಿದಲ ಖೆತರನಿ ಬಾಸ ನಿಂಗತ ಛೆ. <verse eid="GEN 27:27" /><verse number="28" style="v" sid="GEN 27:28" />ಕ್ಹುದಾ ತುನೆ ಹಬಾಳನು ಬರಪ ಘನ್ನಿ ಜಿಮಿನ ದಿನ ಅನಾಜ಼, ದ್ರಾಕ್ಷಾ ರಕ್ಹ ಘನ್ನು ದಿವಾದೆ. <verse eid="GEN 27:28" /><verse number="29" style="v" sid="GEN 27:29" />ಮನಕ್ಹೊ ತುನೆ ಆರಾಧನಾ ಕರಾದೆ, ಜ಼ನಾಂಗೊ ತುನೆ ಅಧಿನ ಥಾವಾದೆ, ತಾರಾ ಭಾಯೊಪರ ತುಜ಼ ರಾಜ಼ ಕರ, ತಾರಿ ಯಾನಾ ಬಚ್ಚಾ಼ ತುನೆ ಅಡ್ಡ ಪಡಾದೆ, ತುನೆ ಕ್ಹರಾಪಲ ವಾಲಾನೆ ಕ್ಹರಾಪ ಲಾಗಾದೆ, ತುನೆ ಆಶಿರ್ವಾದ ದಿವಾಲಾನೆ ತಿನೆ ಆಶಿರ್ವಾದ ಮಳಾದೆ, ಕದ್ಯೊ.<verse eid="GEN 27:29" /></para>
  <para style="s">ಇಸಾಕನಾ ಆಶಿರ್ವಾದನಾ ಹುತಿ ಎಸಾವನಿ ಪ್ರಾಥನಾ</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />ಇಸಾಕ ಯಾಕೊಬನೆ ಆಶಿರ್ವಾದ ದಿದಲ್ಪರ ಯಾಕೊಬ ತಿನಾ ಬಾಕಂತೊ ಗಯಲ ಬರಬ್ಬರ ಎಸಾವ ಶಿಕಾರ ಕರಿನ ಆಯೊ. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />ಎಸಾವ ತಿನಾ ಬಾನಾ ಪಸಂದ ರ‍್ಹಯಲ ತಿಮ್ಮಜ಼ ಖಾಸ ರ‍್ಹಯಲ ಅನ್ನ ತಯ್ಯಾರ ಕರಿನ ತಿನಾ ಬಾಕನ ಲಿನ ಗಯೊ. ತೆ ತಿನಾ ಬಾನೆ ಬಾ ಉಟ್ಟ ತಾರಾಹುತಿ ತಾರು ದಿಕ್ರೊ ಶಿಕಾರ ಕರಿನ ಮಾಕ್ಹ ಖೈನ ಮನೆ ಆಶಿರ್ವಾದ ದೆ ಕದ್ಯೊ. <verse eid="GEN 27:31" /><verse number="32" style="v" sid="GEN 27:32" />ತಿನೊ ಬಾ ಇಸಾಕ ತು ಕುನ್ನ ವ್ಹೈ? ಕೈನ ತೆ ಪುಚ್ತಾ಼ಮಾ ತೆ ಮಿ ತಾರೊ ಮ್ಹೊಟೊ ದಿಕ್ರೊ ಎಸಾವ ವ್ಹೈ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 27:32" /><verse number="33" style="v" sid="GEN 27:33" />ತೆಳಾಮಾ ಇಸಾಕ ಘನ್ನೊ ಭುಚ್ಕಿನ ಕಾಪ್ತೊ ತಿನೆ ತು ಆವಾತಿ ಪೈಲಾಜ಼ ಅನ್ನ ತಯ್ಯಾರ ಕರಿನ ದಿದಲ ಕುನ್ನ ವ್ಹೈ? ಮಿ ತೆ ಕ್ಹಾರು ಖೈನ ತಿನೆ ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ. ಹಮ್ನಾ ಮಿ ದಿದಲ ಆಶಿರ್ವಾದ ವಾಪಸ ಲಿವಾನೆ ಥಾತು ನೈ. <verse eid="GEN 27:33" /><verse number="34" style="v" sid="GEN 27:34" />ಎಸಾವ ತಿನಾ ಬಾನಾ ವಾತೊ ಐಕಿನ ಘನ್ನೊ ದುಖಿ ಥಯೊ ವರಿ ಘನ್ನೊ ರೊತೊ ಎ ಬಾ ಮನೆ ಬಿ ಆಶಿರ್ವಾದ ದೆ ಕೈನ ಕತಾಮಾ ಇಸಾಕ ತಿನೆ, <verse eid="GEN 27:34" /><verse number="35" style="v" sid="GEN 27:35" />ತಾರೊ ನ್ಹಾನೊ ಭೈ ಐನ ಮನೆ ಮೊಸ ಕರಿನ ತುನೆ ಮಳಾನೊ ಆಶಿರ್ವಾದ ತೆ ಪಡ್ದಿಲಿನ ಗಯೊ. <verse eid="GEN 27:35" /><verse number="36" style="v" sid="GEN 27:36" />ತೆ ವಾತೆ ಎಸಾವ, ಯಾಕೊಬ ಕವಾನು ನಾಮ ತಿನೆ ಮಳಲ ನ್ಯಾಯ ನ್ಹವೈಸು? ಬೆ ಸಲಾ ಮನೆ ಮೊಸ ಕರ‍್ಯೊಸ, ಪೈಲಾ ಮಾರೊ ಪೈಲಾರತನಾನೊ ಹಕ್ಕ ಬಿ ಕಾಳಿಲಿದ್ಯೊ; ಹಮ್ನಾ ಐನ ಮನೆ ಮಳಾನೊ ಆಶಿರ್ವಾದ ತೆ ಕಾಳ್ಳಿದ್ಯೊಸ, ಕೈನ. ತಿನಾ ಬಾನೆ ಮಾರಾಹುತಿ ತುಕನ ಮನೆ ದಿವಾನಾ ಹುತಿ ಆಶಿರ್ವಾದಜ಼ ನತ್ತಿ ಸು? ಕೈನ ಪುಚ್ತಾ಼ಮಾ <verse eid="GEN 27:36" /><verse number="37" style="v" sid="GEN 27:37" />ಇಸಾಕ ಮಾರಾ ದಿಕ್ರಾ ತಿನೆ ತುಪರ ಮಾಲಕ ಕೈನ ನೆಮಶ್ಯೊಸ ತಿನಾ ಭಾಯೊನೆ ತಿನಾ ಸೆವಕೊ ಕರಿನ ದಿದ್ಯೊಸ. ಅನಾಜ಼ ದ್ರಾಕ್ಷಾ ರಕ್ಹ ತಿನೆ ರಾಕಾನಾ ಹುತಿ ದಿದ್ಯೊಸ ದೆಕ. ಇಮ ರ‍್ಹತಾಮಾ ಮಿ ತಾರಾಹುತಿ ಸು ಕರು ಕದ್ಯೊ. <verse eid="GEN 27:37" /><verse number="38" style="v" sid="GEN 27:38" />ಎಸಾವ ತಿನೆ ಎ ಮಾರಾ ಬಾ ತುಕನ ತೆ ಯಕ್ಕಜ಼ ಆಶಿರ್ವಾದ ವ್ಹತು ಸು? ಬಾ ಮನೆಬಿ ಆಶಿರ್ವಾದ ದ್ಯು. <verse eid="GEN 27:38" /><verse number="39" style="v" sid="GEN 27:39" />ಕೈನ ಕತೊ ರೊತೊ ತಿನೊ ಬಾ ಇಸಾಕ ಸಾರವುಳ್ಳ ಜಿಮಿನ ಹಬಾಳಮಾತು ಪಡಾನು ಠಾರ ರ‍್ಹವಾನಿ ಜ಼ಗಾ ತಾರು ನಿವಾಸ ರ‍್ಹವಸ. <verse eid="GEN 27:39" /><verse number="40" style="v" sid="GEN 27:40" />ತು ಚಾಕಾಕ್ಹು ಜಿವ್ನಾ ಕರ್ಸಿ ತಾರಾ ನ್ಹಾನಾ ಭೈನೆ ಸೆವಕ ಥೈನ ರ‍್ಹಸಿ ವರಿಬಿ ತು ತಾಳಮೆ ಮಿರ್ತಾಮಾ ತುಪರ ಗಾಲಲ ವಜ್ಜು಼ ನಾಕಿ ಪಾಡಸಿ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 27:40" /><verse number="41" style="v" sid="GEN 27:41" />ಬಾ ಯಾಕೊಬನೆ ಕರಲ ಆಶಿರ್ವಾದಕ್ಹು ಎಸಾವನ ಯಾಕೊಬನೆ ಕದರೈನ ತಿನಾ ಮನಸ್ಮಾ ಬಾನಾ ಹುತಿ ತ್ರಾಸ ಖಾವಾನು ಟೈಮ ನಜಿಕ ಆಯೊ ತೆಳಾಮಾ ಮಾರೊ ನ್ಹಾನೊ ಭೈ ಥಯಲ ಯಾಕೊಬನೆ ಖಲಾಸ ಕರುಸ ಕೈನ ಕೈಲಿದ್ಯೊ. <verse eid="GEN 27:41" /><verse number="42" style="v" sid="GEN 27:42" />ಮ್ಹೊಟೊ ದಿಕ್ರೊ ಥಯಲ ಎಸಾವ ಕದಲ ವಾತ ರೆಬೆಕ್ಕನೆ ಗ್ವತ್ತ ಥಾತಾಮಾ ತೆ ತಿನೊ ನ್ಹಾನೊ ದಿಕ್ರೊ ಥಯಲ ಯಾಕೊಬನೆ ಬಲೈನ ತಿನೆ ದೆಕ ತಾರೊ ಮ್ಹೊಟೊ ಭೈ ಥಯಲ ಎಸಾವ ತುನೆ ಖಲಾಸು ಕರುಸ ಕೈನ ವಿಚಾರ ಕರಲ ತಿನು ಸಂಗಟ ಇಜ್ಜೈ ಲಿವಸ. <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />ತಿನಾಹುತಿ ಎ ಮಾರಾ ದಿಕ್ರಾ ಮಾರಿ ವಾತ ಐಕ ತು ಉಟಿನ ಹಾರನ ಗಾಮ್ಮಾ ರ‍್ಹಯಲ ಮಾರೊ ಭೈ ಥಯಲ ಲಾಬಾನಕನ ನ್ಹಾಟಿನ ಗೈನ ದಕ್ಹಾ ದಿನ್ನ <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />ಕದ್ಯಾಮ ತಾರಾ ಭೈನಿ ಶಿಟ್ಟ ಗಯೆಲಕ್ಕಾ ತಿಕನ ರ‍್ಹೆ <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />ತಾರೊ ಭೈ ತು ಕರಲ ಇಕ್ಹರಿನ ತಿನಿ ಉತ್ರಲಪರ ಮಿ ತುನೆ ಬಲೈಲ್ಯುಸ ಮಿ ಯಕ್ಕಜ಼ ದಿನ್ಮಾ ಜೈ಼ವೈ ಲಿವಾನೆ ಶಾನೆ ಜೈ ಲ್ಯು? <verse eid="GEN 27:45" /><verse number="46" style="v" sid="GEN 27:46" />ರೆಬೆಕ್ಕ ಇಸಾಕನೆ ಇತ್ತಿಯವಾಲಾ ಥಯಲ ಬಾಕ್ಡಿಯೊಮಾನಾಹುತಿ ಮನೆ ಬೆಜ್ಜಾರ ಥಯು. ಯಾಕೊಬ ಎ ದೆಶವಾಲಾಮಾನಿ ಛೊಕ್ರಿನೆ ಇನಿಲಿನ ಹೈ ಹಿತ್ತಿನಿ ಬಾಕ್ಡಿನೆ ಹಿವಾ ಕರಿಲಿದ್ಯೊಮ ಮಿ ಜಿವ್ತಿ ರ‍್ಹವಾನು ಸು ಉಪಯೊಗ ಸು ಛೆ?<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="s">ಯಾಕೊಬ ಲಾಬಾನಕನ ಜಾ಼ವಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />ತೆಳಾಮ ಇಸಾಕ ಯಾಕೊಬನೆ ಬಲೈನ ಆಶಿರ್ವಾದ ಕರಿನ ತಿನೆ ಆಜ್ಞಾಪಿಸಿಸೆಲ ಸು ವ್ಹೈ ಕದ್ಯಾಮ ತು ಕಾನಾನ್ಯನಿ ಹೆಣ್ಣನೆ ಹಿವಾ ಕರಿಲ್ಯು ನೈ. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />ಪದ್ದನ ಅರಾಮ ದೆಶಮಾ ರ‍್ಹಯಲ ತಾರಿ ಯಾ ನೊ ಬಾ ಥಯಲ ಬೆತೊಲೊಮನಾ ಘರೆ ಗೈಪಡ. ತ್ಯಾ ತಾರಿ ಯಾನೊ ಭೈ ಥಯಲ ಲಾಬಾನನಾ ದಿಕ್ರಿಯೊಮಾ ಯಕ್ಲಿನೆ ಹಿವಾ ಕರಿಲೆ. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />ಸರ್ವಶಕ್ತ ಥಯಲ ತುನೆ ಆಶಿರ್ವಾದ ಕರಿನ ತುನೆ ಘನ್ನಾ ಸಂತತಿಯೊನೆ ದಿನ ತಾರಾಕ್ಹು ಘನ್ನಾ ಜ಼ನಾಂಗೊ ಹುಟ್ಟೆ ನಿಂಗತ ತುನೆ ದಿವಾದೆ. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />ಕ್ಹುದಾ ಅಬ್ರಹಾಮನೆ ದಿದಲ ಆಶಿರ್ವಾದ ತುನೆಬಿ ತಾರಾ ಸಂತತಿನೆಬಿ ದಿವಾದೆ ಕ್ಹುದಾ ಅಬ್ರಹಾಮನೆ ವಾಗ್ದಾನ ಕರಲ ನಿಂಗತಜ಼಼ ತು ಹಮ್ನಾ ಪ್ರವಾಸಿ ಥಯಲ ದೆಶನೆ ತುಜ಼ ಹೊಂದಲ ನಿಂಗತ ಕ್ಹುದಾ ತುನೆ ಆಶಿರ್ವಾದ ಕರಿನ ತುನೆಬಿ ತಾರಾ ಸಂತತಿವಾಲಾವೊನೆ ದಿವಾದೆ ಕದ್ಯೊ. <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />ಇಸಾಕ ಯಾಕೊಬನೆ ವಳಾಯೆಲ್ಪರ ತೆ ಪದ್ದನ್‍ ಆರಾಮಮಾ ರ‍್ಹಯಲ ಯಾಕೊಬನಿ ವರಿ ಎಸಾವನಿ ಯಾ ಥಯಲ ರೆಬೆಕ್ಕಳನೊ ಮ್ಹೊಟೊ ಭೈ ಆರಾಮನೊ ರ‍್ಹಯಲ ಬೆತುವೆಲನೊ ದಿಕ್ರೊ ಥಯಲ ಲಾಬಾನ ಕನ ಗಯೊ. <verse eid="GEN 28:5" /><verse number="6" style="v" sid="GEN 28:6" />ಇಸಾಕ ಯಾಕೊಬನೆ ಆಶಿರ್ವಾದಸಿನ ಪದ್ದನ್ ಅರಾಮಮಾ ಚೊ಼ಕರಿ ದ್ಹುಂಡಿನ ಹಿವಾ ಕರಿಲಿವಾನೆ ಮೊಕಲ್ಯೊ, ತೆ ಯಾಕೊಬನೆ ಆಶಿರ್ವಾದ ಕರತಾಳೆ ತಿನೆ ತು ಕಾನಾನ್ಯನಿ ಚೊ಼ಕರಿನೆ ಲಿವು ನೈ ಕೈನ ಅಪ್ಪಣೆ ದಿದಲ ಎಸಾವ ದೆಕ್ಯೊತೊ. <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />ಯಾಕೊಬ ತಿನಾ ಮಾ-ಬಾಪನಾ ವಾತೊನೆ ವಿದೆಯ ಥೈನ ಪದ್ದನ್‍ ಅರಾಮನೆ ಗಯೊ. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />ಕಾನಾನ್ಯನಾ ಹೆಣ್ಣಬಚ್ಚಾ ತಿನೊ ಬಾ ಥಯಲ ಇಸಾಕನೆ ಪಸಂದ ನತ್ತಿ ಕೈನ ಎಸಾವ ತಿಳದಿಲಿದ್ಯೊ. <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />ಎಸಾವ ಇಷ್ಮಾಯೆಲನಾ ಕ್ಹಾಮೊ ಗೈನ ಅಬ್ರಹಾಮನೊ ದಿಕ್ರೊ ಇಷ್ಮಾಯೆಲನಿ ದಿಕ್ರಿ ನೆಬಾಯೊತನಿ ನ್ಹನಿ ಭಎನ ಥಯಲ ಮಹಲತನೆ ಹಿವಾ ಕರಿಲಿದ್ಯೊ.<verse eid="GEN 28:9" /></para>
  <para style="s">ಯಾಕೊಬನು ಕ್ಹಪನ</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />ತೆಳಮಾ ಯಾಕೊಬ ಹಾರಾನನೆ ಜೌ ಕೈನ ಬೆರ್ಷೆಬತೊ ಗಯೊ. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />ತೆ ಪ್ರಯಾಣ ವಾಲೊ ಥೈನ ಜಾ಼ತಾಮಾ ಟೈಮ ಥಯಲಕ್ಹು ತೆ ರಾತೆ ತ್ಯಾಜ ಹುಬ್ರಯೊ. ತೆ ತ್ಯಾ ರ‍್ಹಯಲ ದಗ್ಡಾವೊಮಾನೊ ಯಕ್ಕ ದಗ್ಡೊ ಲಿನ ಮಾತಾನಾ ಮ್ಹೆಲಿನ ತೆ ಜ಼ಗಾಮಾ ಕ್ಹುರಾಯೊ. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />ತೆ ರಾತೆ ತೆ ಯಕ್ಕ ಕ್ಹಪನ ದೆಕ್ಯೊ ತೆ ಕ್ಹಪನಮಾ ಯಕ್ಕ ಇಚ್ಚಣಗಿ ಭುಮಿಪರ ಹುಬ್ರೈತಿ ತಿನಿ ತುದಿ ಹಬಾಳನೆ ಮುಟ್ಟಿತಿ ತಿನಾ ಉಪ್ಪರ ಕ್ಹುದಾನಾ ದುತೊ ಚಡಾನು ಉತರಾನು ಕರಾಡಾತಾ. <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />ತೆನೈಸೊ ಕ್ಹುದಾ ತಿನಾ ಉಪ್ಪರ ಹುಬ್ರೈನ ತಾರೊ ಬಾ ಥಯಲ ಅಬ್ರಹಾಮನೊ ಕ್ಹುದಾ ಇಸಾಕನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಮಿಜ಼ ವ್ಹೈ ತು ಕ್ಹುರಯಲ ಭುಮಿನೆ ತುನೆ ವರಿ ತಾರಿ ಸಂತತಿನೆ ಬಿ ದ್ಯುಸ. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />ತಾರಿ ಸಂತತಿ ಭುಮಿನನಿ ಬಾರಿಕ ದಗ್ಡಾ ಯಕ್ಲಾ ಲೆಕ್ಕೊ ನೈಸೊ ಥಾವಸ ತು ಪುರ್ವ ಪಶ್ಚಿಮ ದಕ್ಷಿಣ ಉತ್ತರ ದಿಕ್ಕೊನೆ ಫೈಲಶಿ. ತಾರಾಕ್ಹು ತರಾ ಸಂತತಿಕ್ಹು ಭುಮಿನಾ ಕ್ಹಾರಾ ಖಾಂದಾನವಾಲಾ ಆಶಿರ್ವಾದ ಹೊದಸ. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />ದೆಕ ಮಿ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹೈನ ತು ಜಾವಾನಾ ಹರಯಕ್ಕ ಜ಼ಗಾಮಾ ಬಿ ತುನೆ ವಚಾ಼ಡಿನ ವರಿ ಆ ದೆಶನೆ ಬಲೈ ಲೌಸ ಕಾ ಕದ್ಯಾಮ ಮಿ ತುನೆ ಕದಲ ಕ್ಹಾರು ಕರ‍್ಯಾವಚಿ ಮಿ ತುನೆ ಚ್ಹೊಡತೊ ನೈ ಕದ್ಯೊ. <verse eid="GEN 28:15" /><verse number="16" style="v" sid="GEN 28:16" />ಯಾಕೊಬ ನಿಂದರತೊ ಉಟಿನ ಕ್ಹರಿಮಾಜ಼ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಆ ಜ಼ಗಾಮಾ ಛೆ ಆ ಮನೆ ಗ್ವತ ಥಯು ನೈ ಕದ್ಯೊ. <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />ತೆ ಭುಚಕಲವಲೊ ಥೈನ ಎ ಜ಼ಗಾ ಪವಿತ್ರ ಥಯಲ ಛೆ ಆ ಕ್ಹುದಾನು ಘರಜ಼ ವ್ಹೈ ತೆ ಛೊಡಿನ ಬಿಜು಼ ಸುಜ಼ ನ್ಹವೈ ಆ ಪರಲೊಕನು ಬಾಕಲ ವ್ಹೈ ಕದ್ಯೊ. <verse eid="GEN 28:17" /><verse number="18" style="v" sid="GEN 28:18" />ಯಾಕೊಬ ಪಾಟೆ ಉಟಿನ ತೆ ಮಾತಾನಾ ಹೆಟೊ ಮೊಟಲು ಕರಿನ ಮ್ಹೆಲಿದಲ ದಗಡೊ ಲಿನ ತಿನೆ ಖಂಬೊ ಕರಿನ ಹುಬ್ರಾಡಿನ ತಿನಾ ಉಪ್ಪರ ತೆಲ ರಿಚಾ಼ಯೊ. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />ತೆನೈಸೊ ತೆ ಜ಼ಗಾನೆ ಬೆತೆಲ್ ಕವಾನು ನಾಮ ಮ್ಹೆಲ್ಯೊ ತಿತ್ತಿ ಪ್ಯಲಾ ತೆ ಗಾಮನೆ ಲುಜ಼ ಕವಾನು ನಾಮ ವ್ಹತ್ತು. <verse eid="GEN 28:19" /><verse number="20" style="v" sid="GEN 28:20" />ಯಾಕೊಬ ತ್ಯಾ ಕ್ಹಮ ಘಾಲಿನ ಕ್ಹುದಾ ಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹೈನ ಮಿ ಜ಼ಾವಾನಾ ಆ ವಾಟಮಾ ಮನೆ ವಚಾ಼ಡಿನ ಖಾವಾನೆ ಅನ್ನ ಬಿ ಘಾಲಿವಾನೆ ವಣ್ಣಾ ಬಿ ಮನೆ ದಿನ. <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />ಫರಿನ ಮನೆ ಮಾರಾ ಬಾನಾ ಘರೆ ಮನೆ ಚೊ಼ಕಿತರಾ ವಚಾ಼ಡಿ ಬಲೈಲಾಯೊ ಕದ್ಯಾಮ ಯಹೊವಾಜ ಮನೆ ಕ್ಹುದಾ ಥಾವಸ. <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />ಎ ನೈಸೊ ಮಿ ಖಂಬೊ ಕರಿನ ಹುಬ್ರಾಡಾಲ ಆ ದಗಡೊ ಕ್ಹುದಾನು ಘರ ಥಾವಸ ತೆಳಾಮಾ ತು ಮನೆ ದಿವಾನಾ ಕ್ಹಾರಾಮಾ ದಕ್ಮಾ ಯಕ್ಕ ಭಾಗ ತುನೆ ಮಿ ದ್ಯುಸ ಕ್ಹರಿಮಾಜ಼ ದ್ಯುಸ ಕೈನ ಮಾಂಗಿಲಿದ್ಯೊ.<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">ಯಾಕೊಬ ಲಾಬಾನನಾ ಘರೆ ಆಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />ತೆಳಾಮಾ ಯಾಕೊಬ ತಿನು ಪ್ರಯಾಣ ಅಗೊ ಬಡಾಯೊ ತೆ ಪುರ್ವ ದಿಕ್ಮಾ ರ‍್ಹಯಲ ಸಿಮೆಯೆ ಗಯೊ. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />ಯಾಕೊಬ ದೆಕ್ತಾಮಾ ಖೆತರಮಾ ಯಕ್ಕ ಇರ ದಿಕ್ಹಿ ಇರನಾ ನಜಿಕ ತನ್ನ ಬಕ್ರಾವೊನು ಗುಂಪ ಕ್ಹುರಾಯಾತಾ ಬಕ್ರಾವೊನೆ ತೆಜ಼ ಇರನು ಪಾನಿ ಪಿಲಾತಾತಾ ಇರನೆ ಮ್ಹೊಟೊ ದಗ್ಡೊ ಝಾಕಲ ವ್ಹತು. <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />ಬಕ್ರಾ ಕ್ಹಾರಾ ಮಳಲಪರ ಕುರಬುರ‍್ಯಾ ಇರಪರ ರ‍್ಹಯಲ ದಗ್ಡೊ ಕಾಡತಾತಾ. ತೆಳಾಮಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಪಾನಿ ಪಿತಾತಾ. ಬಕ್ರಾ ಪಾನಿ ಪಿದಲ್ಪರ ವರಿ ತೆ ದಗ್ಡೊ ಝಾಕ್ತಾತಾ. <verse eid="GEN 29:3" /><verse number="4" style="v" sid="GEN 29:4" />ಯಾಕೊಬನೆ ತ್ಯಾ ರ‍್ಹಯಲ ಕುರಬುರ‍್ಯಾವೊನೆ 'ಭಾಯೊ ತುಮೆ ಕಿಜಾ಼ನಾ ವ್ಹೈ? ಪುಚ್ಯಾ ತ್ಯುನೆ ಹಮೆ ಹಾರಾನಾವಾಲಾ ವ್ಹೈ” ಕೈನ ಕದ್ಯಾ. <verse eid="GEN 29:4" /><verse number="5" style="v" sid="GEN 29:5" />ಪಾಚಾ಼ತೊ ಯಾಕೊಬ ತ್ಯುನೊನೆ ನಾಹೊರನಾ ನಾತ್ನೊ ಥಯಲ ಲಾಬಾನ ತುಮೊನೆ ಗ್ವತ್ತ ಛೆಸು? ಕೈನ ಪುಚ್ಚಲಹುತಿ ತೆ ಹಮೊನೆ ಗ್ವತ್ತ ಛೆ ಕದ್ಯಾ. <verse eid="GEN 29:5" /><verse number="6" style="v" sid="GEN 29:6" />ಯಾಕೊಬ ತ್ಯುನೊನೆ ತೆ ಅರಾಮ ಛೆ ಸು? ಕೈನ ಪುಚ್ಯೊ. ತ್ಯುನೆ ತಿನೆ ತೆ ಅರಾಮ ಛೆ ಕದ್ಯಾ. ದೆಕ ಬಕ್ರಾವೊನಾ ಕ್ಹಾತೆ ಆವಾಲಿಜ಼ ತಿನಿ ದಿಕ್ರಿ ರಾಹೆಳ ವ್ಹೈ. ಕೈನ ಕದ್ಯಾ. <verse eid="GEN 29:6" /><verse number="7" style="v" sid="GEN 29:7" />ಯಾಕೊಬ ತ್ಯುನೊನೆ ಹಜು಼ ಘನ್ನೊ ವಕ್ಹತ ಛೆ, ಬಕ್ರಾವೊನೆ ಪಾನಿ ಪಿಲೈನ ವರಿ ಚ಼ರೈನ ಆವೊ ಕತಾಮಾ ತ್ಯುನೆ <verse eid="GEN 29:7" /><verse number="8" style="v" sid="GEN 29:8" />ತೆ ಕುರಬುರ‍್ಯಾ ಬಕ್ರಾವೊನಾ ಗುಂಪನೆ ಕ್ಹಾರಾ ಬಕ್ರಾ ಮಳೆಲಕ್ಕಾ ತ್ಯುನೊನೆ ಹಮೆ ಇರಪರ ರ‍್ಹಯೆಲ ದಗ್ಡಾನೆ ಕಾಡಿ ಬಕ್ರಾವೊನೆ ಪಿಲಾ ಸಕತ್ಆ ನೈ. ತ್ಯುನೆ ಕ್ಹಾರಾ ಮಳಲ್ಪರ ಪಾನಿ ಪಿಲೈಯೆಸ. <verse eid="GEN 29:8" /><verse number="9" style="v" sid="GEN 29:9" />ತೆ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬೊಲ್ತಾಮಾ ರಾಹೆಳ ತಿನಾ ಬಾನಾ ಬಕ್ರಾವೊನಾ ಕ್ಹಾತೆ ಐ ತೆ ತ್ಯುನೊನೆ ಚ಼ರಾತಿತಿ. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />ರಾಹೆಳ ಲಾಬಾನನಿ ದಿಕ್ರಿ ವ್ಹೈ ಲಾಬಾನ ಯಕಾಬೊನಿ ಯಾ ಥಯಲ ರೆಬಕ್ಕನೊ ಮ್ಹೊಟೊ ಭೈ ವ್ಹೈ.ಯಾಕೊಬ ರಾಹೆಲನೆ ದೆಕ್ತಾಮಾ ಇರಪರ ರ‍್ಹಯೆಲ ದಗ್ಡೊ ಸರಕಾಯಾ ತಿನಿ ಮಾ ನೊ ಭೈ ಥಯಲ ಲಾಬಾನನಾ ಬಕ್ರಾವೊನೆ ಪಾನಿ ದಿದ್ಯಾ. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />ಯಾಕೊಬ ರಾಹೆಲನೆ ಮಟ್ಟಿಲಿನ ಘನ್ನೊ ಜೊ಼ರ ರೊತೊ ತಿನೆ. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />ಮಿ ತಾರಾ ಬಾನೊ ಭತ್ರಿಜೊ಼ ರೆಬೆಕ್ಕಳನೊ ದಿಕ್ರೊ ವ್ಹೈ ಕೈನ ತಿಳಸಾಯೊ ತೆಳಾಮಾ ರಾಹೆಲ ನ್ಹಾಟಿನ ಗೈನ ತೆ ವಾತ ತಿನಾ ಬಾನೆ ಕದಿ. <verse eid="GEN 29:12" /><verse number="13" style="v" sid="GEN 29:13" />ಲಾಬಾನ ತಿನಿ ಭ್ಹೆನ್ನೊ ದಿಕ್ರೊ ಥಯಲ ಯಾಕೊಬ ಆಯೆಲ ಪೈಲಾಜ಼ ಆಯೆಲ ಐಕಿನ ತಿನೆ ದೆಕಾನಾ ಹುತಿ ನ್ಹಾಟಿನ ಐನ ತಿನೆ ಮಟ್ಟಿಲಿನ ತಿನಾ ಘರೆ ಬಲೈಲಾಯೊ. <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />ಯಾಕೊಬ ಲಾಬಾನನೆ ಕ್ಹಾರಾ ಸಂಗತಿಯೊ ತಿಳಸಾತಾಮಾ ಲಾಬಾನ ತಿನೆ ಕ್ಹರಿಮಾಜ಼ ತು ಮಾರಾ ರಗತನೊ ಸಂಭಂಧಿ ಥಯೊಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 29:14" /><verse number="15" style="v" sid="GEN 29:15" />ತೆ ಯಕ್ಕ ಮಹಿನಾ ಲಕ್ಕಾ ಲಾಬಾನಕನಜ಼ ವ್ಹತ್ತೊ. ತೆ ಥಯಲ್ಪರ ಲಾಬಾನ ಯಾಕೊಬನೆ ತು ಮಾರೊ ಸಂಬಂದಿ ವ್ಹೈ ಕೈನ ಸುಕನೊಜ಼ ಸೆವಾ ಕರಾನು ನ್ಯಾಯ ವೈಸು? ತಾರಾ ಕಾಮನಾ ಹುತಿ ಮಿ ತುನೆ ಸು ದ್ಯು? ಕೈನ ಪುಚ್ಯೊ. <verse eid="GEN 29:15" /><verse number="16" style="v" sid="GEN 29:16" />ಲಾಬಾನನೆ ಬೆ ಛೊಕ್ರಿಯೊ ವ್ಹತಿಯೊ ಮ್ಹೊಟಿನು ನಾಮ ಲೆಯಾ ನ್ಹಾನಿನು ನಾಮ ರಾಹೆಲ. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />ಲೆಯಾ ಕವಾಲಿನಾ ಡೊಳಾ ಶಿದಾ ದಿಕ್ಹತಾ ನ್ಹೊತಾ ತೆನೈಸೊ ರಾಹೆಲ ಘನ್ನಿ ಚೊ಼ಕಿ ಸುಂದರ ವ್ಹತ್ತಿ. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />ಯಾಕೊಬ ರಾಹೆಲನೆ ಪ್ಯಾರ ಕರಿನ ತಾರಿ ನ್ಹಾನಿ ದಿಕ್ರಿ ಥಯಲ ರಾಹೆಲನಾ ಹುತಿ ಕ್ಹಾತ ವರಕ್ಹ ಸೆವಾ ಕರುಸ ಕೈನ ಕತಾಮಾ, <verse eid="GEN 29:18" /><verse number="19" style="v" sid="GEN 29:19" />ಲಾಬಾನ ತಿನೆ ಬಿಜ಼ಾನೆ ದಿವಾತಿ ತುನೆಜ಼ ದಿವಾನು ಚೊ಼ಕು ವ್ಹೈ ತಿನಾ ಹುತಿ ತು ಮಾರಾ ಕ್ಹಾತೆ ಜಿವನಾ ಕರತೊ ರ‍್ಹೆ ಕದ್ಯೊ. <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />ಇನಾ ನಿಂಗತ ಯಾಕೊಬ ರಾಹೆಲನಾ ಹುತಿ ಕ್ಹಾತ ವರಕ್ಹ ಸೆವಾ ಕರ‍್ಯೊ ತೆ ತಿನೆ ಘನ್ನೊ ಮಯಾ ಕರಲ ಹುತಿ ತೆ ತಿನೆ ದಕ್ಹಾಜ಼ ದಿನ ವ್ಹೈ ಕೈನ ದಿಕ್ಹ್ಯು. <verse eid="GEN 29:20" /><verse number="21" style="v" sid="GEN 29:21" />ಪಾಚ಼ಲ್ತೊ ಯಾಕೊಬ ಲಾಬಾನನೆ ಮನೆ ದಿದಲ ಟೈಮ ಪುರಾ ಥಯು ರಾಹೆಲನಾ ಕ್ಹಾತೆ ಮನೆ ಹಿವಾ ಕರಿನ ಮಾರಾ ಹತಮಾ ದೆ ಕೈನ ಪುಚ್ಯೊ. <verse eid="GEN 29:21" /><verse number="22" style="v" sid="GEN 29:22" />ತೆಳಾಮಾ ಲಾಬಾನ ತೆ ಜ಼ಗಾನಾ ಕ್ಹಾರಾ ಜ಼ನಾವೊನೆ ಬಲೈನ ಕ್ಹಾವಾನು ಕರಾಯೊ. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />ಕ್ಹಾಂಜ಼ನಾ ವಕ್ಹತಮಾ ತಿನಿ ಮ್ಹೊಟಿ ದಿಕ್ರಿ ಥಯಲ ಲೆಯಳನೆ ಯಾಕೊಬನೆ ಒಪಸಿನ ದಿದ್ಯೊ. ತೆ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹಯೊ. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />ಲಾಬಾನ ತಿನಿ ದಿಕ್ರಿ ಥಯಲ ಲೆಯಳನೆ ಜಿಲ್ಪಾ ಕವಾಲಿ ಯಕ್ಕ ದಾಸಿನೆ ದಿದ್ಯೊ. <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />ಪಾಟೆ ತೆ ಲೆಯಲ ವ್ಹೈ ಕೈನ ಯಾಕೊಬನೆ ಗ್ವತ್ತ ಥಾತಾಮಾ ತೆ ಲಾಬಾನನೆ ಆ ಸು ವೈ ತು ಮಾರಾ ಕ್ಹಾತೆ ಕರಲ? ರಾಹೆಲನಾ ಹುತಿ ತುನೆ ಸೆವಾ ಕರ‍್ಯೊಸ್ತೊ ಕಾ ಮನೆ ಮೊಸ ಕರ‍್ಯೊ ಕೈನ ಪುಚ಼ಲಕ್ಹು. <verse eid="GEN 29:25" /><verse number="26" style="v" sid="GEN 29:26" />ಲಾಬಾನ ಮ್ಹೊಟಿ ದಿಕ್ರಿತಿ ಪೈಲಾ ನ್ಹಾನಿ ದಿಕ್ರಿನೆ ಹಿವಾ ಕರಿನ ದಿವಾನು ಹಮಾರಾ ದೆಶನಿ ಪದ್ದತ ನ್ಹವೈ. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />ತಿನಾ ಹಿವಾನು ಯಕ್ಕ ಹಫತೊ ಪುರಾ ಕರತೆ ಥಯಲ್ಪರ ಮಾರಿ ನ್ಹಾನಿ ದಿಕ್ರಿನೆ ತುನೆ ದ್ಯುಸ. ಅನಾ ಹುತಿ ತು ಹಜುನ ಕ್ಹಾತ ವರಕ್ಹ ಸೆವಾ ಕರ ಕದ್ಯೊ. <verse eid="GEN 29:27" /><verse number="28" style="v" sid="GEN 29:28" />ಯಾಕೊಬ ತೆ ವಾತೆ ಒಪ್ಪಿನ ಮ್ಹೊಟಿನಾ ಹಿವಾನೊ ಯಕ್ಕ ಹಪ್ತಾಪರ. ತೆಳಾಮಾ ಲಾಬಾನ ತಿನಿ ದಿಕ್ರಿ ಥಯಲ ರಾಹೆಲನೆ ಯಾಕೊಬನೆ ಹಿವಾ ಕರಿನ ದಿದ್ಯೊ. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />ಲಾಬಾನ ತಿನಿ ದಿಕ್ರಿ ಥಯಲ ರಾಹೆಲನೆ ಬಿಲ್ಹಾ ಕವಾಲಿ ದಾಸಿನೆಬಿ ದಿದ್ಯೊ. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />ಯಾಕೊಬ ರಾಹೆಲನಾ ಕ್ಹತೆ ಕುಡ್ಯೊ ತಿನೆ ಲೆಯಳತಿಬಿ ಘನ್ನೊ ಪ್ಯಾರ ಕರ‍್ಯೊ. ತಿನಾ ಹುತಿ ಲಾಬಾನ ಕನ್ನ ವರಿ ಕ್ಹಾತ ವರಕ್ಹ ಸೆವೆ ಕರ‍್ಯೊ.<verse eid="GEN 29:30" /></para>
  <para style="s">ಯಾಕೊಬನೆ ಹುಟ್ಟಲ ಬಚ್ಚಾ಼</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />ಲೆಯಳ ಯಾಕೊಬನೆ ಶೆಂ ನತ್ತಿ ಆವಾಡಿ ಕೈನ ಯಹೊವಾನೆ ದೆಕಿನ ತೆ ಪೆಟೆ ರ‍್ಹಯನಿಂಗತ ತಿನೆ ಆಶಿರ್ವಾದ ಕರ‍್ಯೊ. ತೆನೈಸೊ ರಾಹೆಲ ಗ್ವಡ್ಡ ವ್ಹತ್ತಿ. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />ಲೆಯಳ ಪೆಟೆ ರ‍್ಹೈನ ಪಟ್ಟೊ ಜ಼ನ್ನಿನ ಯಹೊವಾ ಮಾರು ದುಖ ದೆಕ್ಯೊಸ, ಇತ್ತಿ ಉಪ್ಪರ ಮಾರೊ ಮಾಟಿ ಮಯಾ ಕರಸ ಕೈನ ತಿನು ನಾಮ ರುಬೆನ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 29:32" /><verse number="33" style="v" sid="GEN 29:33" />ತೆ ವರಿ ಪೆಟೆ ರ‍್ಹೈನ ಬಿಜೆ಼ಕ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿಮಿ ಮಾಟಿಕ್ಹೊ ಅಲಕ್ಷಾನೆ ಗುರಿ ಥೈಸ ಕೈನ ಯಹೊವಾನೆ ಗ್ವತ್ತ ಥಯುಸ ಕೈನ ಎ ದಿಕ್ರಾನೆ ದಿದ್ಯೊಸ ಕೈನ ತಿನೆ ಸಿಮೆಯೊನ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 29:33" /><verse number="34" style="v" sid="GEN 29:34" />ವರಿ ತೆ ಪೆಟೆ ರ‍್ಹೈನ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿ ಹಮ್ನಾತೊಬಿ ಹಮೆ ಮಾಟಿ ಬೈಕೊ ಯಕ್ಕ ಥೈಯೆಸ ಕೈನ . ತಿನಿ ಮಿ ತನ್ನ ಪಟ್ಟಾ ಜ಼ನ್ನಿತೊ ಕೈನ ತಿನೆ ಲೆವಿ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 29:34" /><verse number="35" style="v" sid="GEN 29:35" />ವರಿ ತೆ ಪೆಟೆ ರ‍್ಹೈನ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿ ಹಮ್ನಾ ಯೆಹೊವನೆ ಉಪಕಾರ ಸ್ತುತಿ ಕರುಸ ಕೈನ ತಿನೆ ಯೆಹುದಾ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ ತೆ ಥಯಲ್ಪರ ತಿನೆ ಬಚ್ಚಾ಼ ಥಾವಾನು ಹುಬ್ರಯು.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />ರಾಹೆಳ ತೆ ಯಾಕೊಬನೆ ಬಚ್ಚಾ ಜ಼ನ್ನಿನ ನೈ ದಿವಾಕ್ಹು ತೆ ದೆಕಿನ ತಿನಿ ಮ್ಹೊಟಿ ಭೆನ್ನಾ ಉಪ್ಪರ ಸಂಗಟ ಘಾಲಿನ ಯಾಕೊಬನೆ ಮನೆ ಬಚ್ಚಾ ದೆ ನೈತೊ ಮಿ ಮರಿ ಜೌ಼ಸ ಕೈನ ಕದಿ. <verse eid="GEN 30:1" /><verse number="2" style="v" sid="GEN 30:2" />ಯಾಕೊಬ ರಾಹೆಳನಾ ಉಪ್ಪರ ಶಿಟ್ಟ ಥೈನ ಕ್ಹುದಾ ತುನೆ ಬಚ್ಚಾ ನೈ ಥಯಲ ದಾಕ್ಹಲ ಕರ‍್ಯೊಸ ಕದ್ಯಾಮ ಮಿ ಕಿಮ ತುನೆ ಬಚ್ಚಾ ದೆ ಸಕುಸ ಕದ್ಯೊ. <verse eid="GEN 30:2" /><verse number="3" style="v" sid="GEN 30:3" />ತಿನಾಹುತಿ ತೆ ಮಾರಿ ದಾಸಿ ಥಯಲ ಬಿಲ್ಹಾ ಛೆ ತಿನಾ ಕ್ಹಾತೆ ಕ್ಹುರೆ ತೆ ಪೆಟೆ ರ‍್ಹೈಮ ತೆ ಬಚ್ಚಾ಼ನೆ ಮಾರಾ ಕ್ಹೊಳಾಮಾ ಘಾಲಾದೆ ತೆಳಮ ಮನೆ ಬಿ ಬಚ್ಚಾ ಶೆ ಕೈನ. <verse eid="GEN 30:3" /><verse number="4" style="v" sid="GEN 30:4" />ತಿನಿ ದಾಸಿ ಥಯಲ ಬಿಲ್ಹಳನೆ ಬೈಕೊ ಥಾವಾನೆ ಒಪ್ಸಿನ ದಿದಿ. <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />ಯಾಕೊಬ ತಿನಾ ಕ್ಹಾತೆ ಕ್ಹುರಯಲಕ್ಹು ತೆ ಪೆಟೆ ರ‍್ಹೈನ ಪಟ್ಟೊ ಜ಼ನ್ನಲ್ಪರ. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />ರಾಹೆಳ ಕ್ಹುದಾ ಹಮ್ನಾ ಮಕನ ನ್ಯಾಯ ಕರಾಯೊಸ ತೆ ಮಾರಿ ಪ್ರಾಥನಾ ಐಕಿನ ಮನೆ ಯಕ್ಕ ದಿಕ್ರೊ ದಿದ್ಯೊಸ ಕೈನ ತೆ ಪಟ್ಟಾನೆ ದಾನ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 30:6" /><verse number="7" style="v" sid="GEN 30:7" />ರಾಹೆಳನಿ ದಾಸಿ ಥಯಲ ಬಿಲ್ಹಳ ವರಿ ಪೆಟೆ ರ‍್ಹೈನ ಯಾಕೊಬನೆ ಬೆವಾ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿನ ದಿದಿ. <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />ರಾಹೆಳ ಮಾರಿ ಮ್ಹೊಟಿ ಭೆನ್ನಾ ಕ್ಹಾತೆ ಲಡೈ ಕಾಡಿನ ಜಿತ್ತಿಸ ಕೈನ ತೆ ಪಟ್ಟಾನೆ ನಫ್ತಾಲಿ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 30:8" /><verse number="9" style="v" sid="GEN 30:9" />ಲೆಯಳ ತಿನೆ ಬಚ್ಚಾ ನತ್ತಿ ಥಾವಾಡಾ ಕೈನ ದೆಕಿನ ತಿನಿ ದಾಸಿ ಥಯಲ ಜಿಲ್ಪಳನೆ ಯಾಕೊಬನಿ ಬೈಕೊ ಥಾವಾನೆ ಒಪ್ಸಿನ ದಿದಿ. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />ಲೆಯಳನಿ ದಾಸಿ ಥಯಲ ಜಿಲ್ಪಳ ಯಾಕೊಬನೆ ಪಟ್ಟೊ ಜ಼ನ್ನಿನ ದಿದಲಕ್ಹು. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />ಲೆಯಳ ಮನೆ ಚೊ಼ಕು ಥಯು ಕೈನ ತೆ ಪಟ್ಟಾನೆ ಗಾದ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 30:11" /><verse number="12" style="v" sid="GEN 30:12" />ಲೆಯಳನಿ ದಾಸಿ ಥಯಲ ಜಿಲ್ಪಳ ಯಾಕೊಬನೆ ವರಿ ಯಕ್ಕ ಪಟ್ಟಾನೆ ಜ಼ನ್ನತಾಮಾ. <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />ಲೆಯಳ ಮಿ ಧನ್ಯ ಥೈ ಕ್ಹಾರಾ ಬಾಕ್ಡಿಯೊ ಮನೆ ಧನ್ಯ ವ್ಹೈ ಕೈನ ಕವಸ ಕೈನ ತೆ ಪಟ್ಟಾನೆ ಅಶೆರ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 30:13" /><verse number="14" style="v" sid="GEN 30:14" />ಘೌನಾ ಸುಗ್ಗಿ ಕಾಲಮಾ ರುಬೆನ ರಾನ್ಮಾ ಗಯೆಲ ಟೈಮಮಾ ಕಾಮಜನಕ ಝಾಡನಾ ಫಲೊ ದೆಕಿನ ತಿನೆ ಯಾ ಥಯಲ ಲೆಯಳನೆ ಲೈನ ದೆತಾಮಾ ರಾಹೆಳ ತಿನೆ ತಾರೊ ದಿಕ್ರೊ ಲಾಯೆಲ ಕಾಮಜನಕ ಫಲೊಮಾ ಮನೆಬಿ ದಕ್ಹಾ ಫಲೊ ದೆ ಕೈನ ಪುಚ್ಚಿ಼. <verse eid="GEN 30:14" /><verse number="15" style="v" sid="GEN 30:15" />ತಿನಾಹುತಿ ಲೆಯಳ ತು ಮಾರಾ ಮಾಟಿನೆ ಕಾಳಿದಲ ತುನೆ ಬಸ ನತ್ತಿ ಥಯು ಸು? ಹಮ್ನಾ ಮಾರೊ ದಿಕ್ರೊ ಲಾಯೆಲ ಕಾಮಜಕನಾ ಫಲೊ ಬಿ ಮಕಂತಿ ಕಾಳ್ಳಿವಾನೆ ದೆಕಾಡಿಸ ಸು? ಕೈನ ಕತಾಳೆ ರಾಹೆಳ ಚೊ಼ಕು ವ್ಹೈ ತು ಮನೆ ತಾರೊ ದಿಕ್ರೊ ಲಾಯೆಲ ಫಲೊ ಮನೆ ದಿದಿಮ ಆಜ಼ ರಾತೆ ತು ಮಾರಾ ಮಾಟಿನಾ ಕ್ಹಾತೆ ಕ್ಹುರೆಸಕಸಿ ಕದಿ. <verse eid="GEN 30:15" /><verse number="16" style="v" sid="GEN 30:16" />ಕ್ಹಾಂಜ಼ನಾ ವಕ್ಹತಮಾ ಯಾಕೊಬ ರಾನ್ಮಾತೊ ಆತಾಳೆ ಲೆಯಳ ತಿನಾ ಕ್ಹಾಮಿ ಗೈನ ತು ಮಾರಾ ಕ್ಹಾತೆ ಕ್ಹುರೌ ಮಿ ಮಾರೊ ದಿಕ್ರೊ ಲಾಯೆಲ ಕಾಮಜಕನಾ ಫಲೊ ದಿನ ತುನೆ ಇಕ್ಕಾತಿ ಲಿದಿಸ ಕದಿ ತೆ ರಾತೆ ತೆ ತಿನಾ ಕ್ಹಾತೆ ಕ್ಹುರಾಯೊ. <verse eid="GEN 30:16" /><verse number="17" style="v" sid="GEN 30:17" />ಕ್ಹುದಾ ಲೆಯಳನಿ ಪ್ರಾಥನಾ ಐಕ್ಯೊ. ತೆ ಪೆಟೆ ರ‍್ಹೈನ ಯಾಕೊಬನೆ ಪಾಂಚ಼ವಾ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿ. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />ಲೆಯಳ ಮಾರಿ ದಾಸಿನೆ ಮಾರಾ ಮಾಟಿನಾ ಹತಮಾ ದಿದಲಕ್ಹು ಕ್ಹುದಾ ಮನೆ ಪ್ರತಿ ಫಲ ಕೈನ ತೆ ಪಟ್ಟಾನೆ ಇಸ್ಸಾಕಾರ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 30:18" /><verse number="19" style="v" sid="GEN 30:19" />ಲೆಯಳ ವರಿ ಪೆಟೆ ರ‍್ಹೈ ಯಾಕೊಬನೆ ಛೆವಾ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿನ ದಿದಿ. <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />ಲೆಯಳ ಕ್ಹುದಾ ಮನೆ ಚೊ಼ಕು ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ ಮೆ ಮಾರಾ ಮಾಟಿನೆ ಛೆವಾ ಪಟ್ಟಾ ಜ಼ನ್ನಿನ ದಿದಿಲಕ್ಹು ತೆ ಮಾರಾ ಕ್ಹಾತೆಜ಼ ಜಿವ್ನಾ ಕರಸ ಕೈನ ತೆ ಪಟ್ಟಾನೆ ಜೆಬುಲೊನ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 30:20" /><verse number="21" style="v" sid="GEN 30:21" />ತೆ ಥಯಲ್ಪರ ತೆ ಯಕ್ಕ ಚೊ಼ಕ್ರಿ ಜ಼ನ್ನಿನ ತಿನೆ ದಿನಾ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 30:21" /><verse number="22" style="v" sid="GEN 30:22" />ಪಾಚಲ್ತೊ ಕ್ಹುದಾ ರಾಹೆಳನೆ ಶೆ ಕರಿನ ತಿನಿ ಪ್ರಾಥನಾ ಐಕಿನ ತಿನೆ ಬಚ್ಚಾ ಥಾವಾ ವರಕ್ಹು ಕರ‍್ಯೊ. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />ತೆ ಪೆಟೆ ರ‍್ಹೈನ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿನ, ಕ್ಹುದಾ ಮಪರ ರ‍್ಹಯಲ ಕಲಂಕ ಕಾಡಿಪಾಡ್ಯೊ. <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />ತೆ ನೈ ತೆ ಯೆಹೊವ ಮನೆ ವರಿ ಯಕ್ಕ ಪಟ್ಟೊ ದಿದ್ಯೊಸ. ಕೈನ ತಿನು ನಾಮ ಯೊಸೆಫ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ.<verse eid="GEN 30:24" /></para>
  <para style="s">ಯಾಕೊಬ ವರಿ ಲಾಬಾನ ಕರಿಲಿದಲ ಒಪ್ಪಂದ</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />ಯೊಸೆಫ ಹುಟ್ಟಲ್ಪರ ಯಾಕೊಬ ಲಾಬಾನನೆ ಮಿ ಹಮ್ನಾ ಮಾರಾ ಸ್ವಂತ ಗರೆ ಜಾ಼ವಾನೆ ಅನುಮತಿ ದೆ, <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />ಮಾರಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಬಚ್ಚಾ಼ವೊನೆ ಮನೆ ದೆ ಮಿ ತಾರಿ ಸೆವೆ ಕರಿನ ತ್ಯುನೊನೆ ಗಳಸಿ ಲಿದ್ಯೊಸ. ಮಿ ತುನೆ ಚೊ಼ಕಿ ಸೆವೆ ಕರ‍್ಯೊಸ ಕವಾನು ತುನೆ ಗ್ವತ್ತ ಛೆ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 30:26" /><verse number="27" style="v" sid="GEN 30:27" />ಲಾಬಾನ ತಿನೆ ಮಿ ಕವಾನು ಐಕ ಯಹೊವಾ ತಾರಿಕ್ಹು ಮನ ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />ಕೆ ಮಿ ತುನೆ ಕೆಕ್ಲೊ ಪಗಾರ ದ್ಯು? ತು ಕದಲ ತೆಕ್ಲು ದ್ಯುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 30:28" /><verse number="29" style="v" sid="GEN 30:29" />ಯಾಕೊಬ ಮಿ ತಾರಾ ಹುತಿ ತ್ರಾಸ ಖೈನ ಕಾಮ ಕರ‍್ಯೊಸ ಕವಾನು ತುನೆ ಗ್ವತ್ತ ಛೆ. ಮಿ ತಾರಾ ಬಕ್ರಾವೊನೆ ದೆಕ್ರಾಣಕಿ ಕರಲ ಹುತಿ ತೆ ಜಾಸ್ತಿ ಥಯಾಸ. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />ಮಿ ಆತಾಮಾ ಬಕ್ರಾ ದಕ್ಹಾಜ಼ ವ್ಹತಾ. ಹಮ್ನಾತೊ ತುಕನ ಘನ್ನಾ ಬಕ್ರಾ ಛೆ. ಮಿ ತಾರಾಹುತಿ ಕರಲ ಕ್ಹಾರಾನೆ ಯಹೊವಾ ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ. ಮಿ ಖುದ್ದನಾ ಹುತಿ ಕಾಮ ಕರಾನು ಟೈಮ ಛೆ ಮಾರಾ ಸ್ವಂತ ಘರೆ ಜಾ಼ವಾನೆ ಟೈಮ ಛೆ ಕದ್ಯೊ. <verse eid="GEN 30:30" /><verse number="31" style="v" sid="GEN 30:31" />ಲಾಬಾನ ತಿಮ ರ‍್ಹಯೊಮ ಮಿ ತುನೆ ಸು ದ್ಯು ಕೆ ಕೈನ ಪುಚ್ಯೊ. ಯಾಕೊಬ ತು ಮನೆ ಸುಜ಼ ದ್ಯು ನಕೊ ತು ಮಾರಾಹುತಿ ಯಕ್ಕ ಕಾಮ ಕರ‍್ಯೊಮ ಬಸ್ಸ, ಪ್ಹರಿನ ಮಿ ತಾರಾ ಬಕ್ರಾವೊನೆ ರಾಕುಸ. <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />ತೆ ಸುವೈ ಕದ್ಯಾಮ ಹಮ್ನಾಜ಼ ಮಿ ತಾರಾ ಬಕ್ರಾವೊನಾ ಗುಂಪಮಾ ಗೈನ ಬಕ್ರಾವೊಮಾ ಚಿಕ್ಕಿಯೊ ವರಿ ಮಚ್ಚ ರ‍್ಹಯಲ ಬಕ್ರಾವೊಮಾ ಕಾಳಾ ರ‍್ಹಯಲ ಬಕ್ರಿಯೊಮಾ ಚಿಕ್ಕಿಯೊ ವರಿ ಮಚ್ಚ ರ‍್ಹಯಲ ಜು಼ದಾ ಕರುಸ ತೆ ಮಾರೊ ಪಗಾರ ವ್ಹೈ. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />ಇಮ್ಮ ರ‍್ಹಯಮ ಅಗಲ್ಯಾ ದಿನೊಮಾ ಮಾರಾ ಪಗಾರಾನಾ ಹುತಿ ತುಕನ ಆತಾಮಾ ಮಿ ರ‍್ಹಯಲ ಕ್ಹರಿಕ್ಹು ಮನೆ ಸಾಕ್ಷಿ ಥಾವಸ. ಬಕ್ರಿಯೊಮಾ ಚಿಕ್ಕಿಯೊ ವರಿ ಮಚ್ಚ ರ‍್ಹಯಲ ರ‍್ಹಯುಮ ಬಕ್ರಾಮಾ ಕಾಳಾ ನೈಸೊ ಮಕನ ಮಳ್ಯಾಮ ತೆ ಚೊ಼ರಿ ಕರ‍್ಯೊಸ ಕೈನ ಕೌ ನೈ ಕದ್ಯೊ. <verse eid="GEN 30:33" /><verse number="34" style="v" sid="GEN 30:34" />ತೆ ವಾತೆ ಲಾಬಾನ ಮಿ ತೆ ವಾತೆ ಮಿ ವಪ್ಪಿಲಿದ್ಯೊಸ ತು ಕದಲ ತಿಮ್ಮಜ಼ ಅಪೆ ಕರಿಯೆ ಕದ್ಯೊ. <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />ತೆ ದಿನೆ ಲಾಬಾನ ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಬಕ್ರಿಯೊನಾ ಬಚ್ಚಾ ವರಿ ಬಕ್ರಿಯೊ ಕಾಳಾ ಬಕ್ರಾ ಜು಼ದಾ-ಜು಼ದಾ ಕರ‍್ಯೊ. ಲಾಬಾನ ತಿನಾ ಪಟ್ಟಾವೊನೆ ತೆ ಬಕ್ರಾವೊನೆ ದೆಕ್ರಾಣಕಿ ಕರಾನೆ ಕದ್ಯೊ. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />ತಿನಾಹುತಿ ತಿನಾ ಪಟ್ಟಾ ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬಿಜೆಕ ಜ಼ಗಾಕನ ಗಯಾ ತ್ಯುನೆ ತನ್ನ ದಿನ್ನ ಲಕ್ಕಾ ಪ್ರಯಾಣ ಕರ‍್ಯಾ ಯಾಕೊಬ ತ್ಯಾ ರ‍್ಹೈನ ಉಗ್ರಲ ಕ್ಹಾರಾವೊನೆ ದೆಕ್ರಾಣಕಿ ಕರಾನು ಶುರು ಕರ‍್ಯೊ. <verse eid="GEN 30:36" /><verse number="37" style="v" sid="GEN 30:37" />ತಿನಾಹುತಿ ಯಾಕೊಬ ಚಿನಾರ ಬಾದಾಮಿ ಅರ್ಮೊನ ಕವಾನು ಝಾಡೊನಿ ಜ಼ಗಾ ಕಚ್ಚಿಯೊ ಲಾಕ್ಡಿಯೊ ಕೆತ್ತಿನ ಧೊಳಿಯೊ ಕರಿನ. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />ಯಾಕೊಬ ತೆ ಠೊಂಗಿಯೊನೆ ಬಕ್ರಾ ಪಾನಿ ಪಿವಾನಿ ಜ಼಼ಗಾ ಮ್ಹೆಲ್ಯೊ. ಜಾ಼ನವರೊ ಪಾನಿ ಪಿವಾನೆ ಆತಾಮಾ ತೆ ಜ಼ಗಾಕನ ಸಂಗಮ ಕರ್ತಾತಾ. <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />ಬಕ್ರಿಯೊ ತೆ ಠೊಂಗಿಯೊನ ಕ್ಹಾಮಿಯೊ ಸಂಗಮ ಕರ್ತಾಮಾ ತ್ಯುನೊಮಾ ಹುಟ್ಟಲ ಕ್ಹಾರಾ ಬಚ್ಚಾ಼ ಚಿಕ್ಕಿಯೊ ವರಿ ಮಚ್ಚಿಯೊ ರ‍್ಹಯಲ ವರಿ ಕಾಳಾ ರಂಗನಾ ವ್ಹತಾ. <verse eid="GEN 30:39" /><verse number="40" style="v" sid="GEN 30:40" />ಯಾಕೊಬ ತೆ ಬಕ್ರಾವೊನಾ ಬಚ್ಚಾ಼ವೊನೆ ಲಾಬಾನಾ ಹಿಂಡಮಾ ಮಳಾಯಾವಾಚಿ ತಿನಾ ವ್ಹೈ ಕೈನ ಜು಼ದಾ ಕರ‍್ಯೊ ವರಿ ಲಾಬಾನನಾ ಬಕ್ರಾವೊನಾ ಮ್ಹೊಡಾ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತೆ ಬಕ್ರಾ ವರಿ ಕಾಳಾ ರ‍್ಹಯಲ ಬಕ್ರಾವೊ ಬಗಲ ಪ್ಹರಾಯೊ. <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />ವರಿ ಘಟ್ಟಮುಟ್ಟ ರ‍್ಹಯಲ ಬಕ್ರಾ ಸಂಗಮ ಕರ್ತಾಮಾ ತೆ ಲಾಕ್ಡಿಯೊನೆ ದೆಕ್ತಾ ಸಂಗಮ ಕರಾತೆ ಕೈನ ಯಾಕೊಬ ಟೊಪ್ಲಿಯೊಮಾ ಲಾಕ್ಡಿಯೊ ಮುಕ್ಯೊ. ವರಿಬಿ ತೆ ಬಕ್ರಾ ವರಿ ಬಕ್ರಿಯೊ ಬಲಹಿನ ರ‍್ಹತಾಮಾ ಲಾಕ್ಡಿಯೊ ಟೊಪ್ಲಿಯೊಮಾ ಮುಕ್ತೊ ನ್ಹೊತೊ. <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />ಇಮ ಬಲಹಿನ ರ‍್ಹಯಲ ಗುಂಪ ಲಾಬಾನನಾ ಪಾಲ್ಮಾ ಆಯಾ. ಘಟ್ಟಮುಟ್ಟ ರ‍್ಹಯಲ ಯಾಕೊಬನಾ ಪಾಲೆ ಆಯಾ. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />ಇನಾನಿಂಗತ ಯಾಕೊಬ ಘನ್ನೊ ಸೌಕಾರ ಥಯೊ.ತಿನೆ ಬಕ್ರಾವೊನು ಹಿಂಡ ಆಳೊ ಹುಂಟೊ ಗದ್ಡಾ ಘನ್ನು ವ್ಹತು.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />ಹಮಾರಾ ಬಾನಿ ಕ್ಹಾರಿ ಆಸ್ತಿ ಯಾಕೊಬನಾ ಪಾಲಿ ಥೈ, ಹಮಾರಾ ಬಾನಿ ಆಸ್ತಿಕ್ಹುಜ಼ ತೆ ತೆಕ್ಲೊ ಸೌಕಾರತನಾ ಮಳಿ ಲಾಬಾನನಾ ಬಚ್ಚಾಜ ಕೈಲಿವಾನು ವಾತೊ ಯಾಕೊಬ ಐಕ್ಯೊ. <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />ತೆಜ಼ ನೈಸೊ ಯಾಕೊಬ ಲಾಬಾನನು ಮ್ಹೊಡು ದೆಕ್ತಾಮಾ ಪೈಲಾನಿಂಗತ ದಿಕ್ಹ್ಯು ನೈ. <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />ವರಿ ಯಹೊವಾ ಯಾಕೊಬನೆ ತು ತಾರಾ ಬಾನಾ ದೆಶನೆ ತಾರಾ ಬಂದುವೊಕನಬಿ ಫರಿನ ಜಾ಼ ಮಿ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹೌಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 31:3" /><verse number="4" style="v" sid="GEN 31:4" />ಅಮ್ಮ ರ‍್ಹಲಕ್ಹು ಯಾಕೊಬ ರಾಹೆಳನೆ ಲೆಯಳನೆ ತಿನಾ ಬಕ್ರಾ-ಬಕ್ರಿಯೊನು ಹಿಂಡನೆ ಚರಾವಾನಾ ರಾನ್ಮಾ ಬಲೈನ. <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />ತಿವ್ನೊನೆ ಕದಲ ಸುವೈ ಕದ್ಯಾಮ ತಾರಾ ಬಾನು ಮ್ಹೊಡು ಮಾರಾ ವಿಷಯಮಾ ಪೈಲಾ ನಿಂಗತ ನತ್ತಿ ಕೈನ ದಿಕ್ಹ್ಯುಸ ತಿಮ್ಮ ರ‍್ಹಯುತಬಿ ಮಾರಾ ಬಾನೊ ಕ್ಹುದಾ ಮಾರಾಕ್ಹಾತೆ ಛೆ . <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />ಮಿ ತುಮಾರಾ ಬಾನಿ ಸೆವಾ ಪುರಾ ಮನಸಕ್ಹು ಕರ‍್ಯೊಸ. ತೆ ಕ್ಹಾರು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />ವರಿಬಿ ತುಮಾರೊ ಬಾ ಮನೆಮೊಸ ಕರಿನ ಮಾರೊ ಪಗಾರ ದಖಾಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. ಮನೆ ಕ್ಹುದಾ ತಿನಾಹತಿ ಮೊಸ ಕರಾನೆ ಥಯು ನೈ. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />ತುಮಾರೊ ಬಾ ಮನೆ, ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಬಕ್ರಾ ತುನೆ ಪಗಾರ ರ‍್ಹಯವಾದೆ ಕೈನ ತೆ ಕತಾಮಾ ಕ್ಹಾರಾಜ಼ ಹಿಂಡ ಚಿಕ್ಕಿಯೊನಾ ಥಯಾ.ತೆ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತಾರೊ ಪಗಾರ ಥೈನ ರ‍್ಹವಾದೆ ಕೈನ ಕತಾಮಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಘೆರಿಯೊನಾ ವ್ಹತಾ. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />ಇಮ್ಮ ಕ್ಹುದಾ ತುಮಾರಾ ಬಾನಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ವರಿ ಜಾನವರೊ ತಕಂತೊ ಕಾಡಿನ ಮನೆ ದಿದ್ಯೊ. <verse eid="GEN 31:9" /><verse number="10" style="v" sid="GEN 31:10" />ಬಕ್ರಾ ಪೆಟ್ಟ ರ‍್ಹತಾಮಾ ಮಿ ಕ್ಹಪನಮಾ ದೆಕ್ತಾಮಾ ಬ್ಕಾವೊನಾ ಕ್ಹಾತೆ ಸಂಗಮ ಕರ್ತಾಮಾ ಬಕ್ರಿಯೊ ಕ್ಹಾರಿಯೊ ಘೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ ಮಚ್ಚೆ ಥೈನ ದಿಕ್ಹಿಯೊ. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />ತೆ ಕ್ಹಪನಮಾ ದೆವದುತ, ಯಾಕೊಬ ಕೈನ ಬಲಾತಾ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />ತೆ ಮನೆ, ಲಾಬಾನ ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ಬಕ್ರಾ ಸಂಗಮ ಕರಾಲಾ ಬ್ಕರಾವೊನೆ ದೆಕೊ ಗೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ, ಮಚ್ಚನಿ ವ್ಹತಿಯೊ. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />ತಾರಾ ಖಂಬಾನೆ ಅಭಿಶೆಕ ಕರಿನ ಮನೆ ಕ್ಹಮ್ಮ ಕರಲ ಬೆತೆಲನೊ ಕ್ಹುದಾ ಮಿಜ಼ ವ್ಹೈ ಹಮ್ನಾ ತು ಉಟಿನ ಆ ದೆಶನೆ ಛೊಡಿನ ತು ಹುಟ್ಟಲ ದೆಶನೆ ಬಿ ವರಿ ತಾರಾ ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 31:13" /><verse number="14" style="v" sid="GEN 31:14" />ಯಾಕೊಬ ಎ ವಾತೊ ಕದಲ್ಪರ ರಾಹೆಳ ವರಿ ಲೆಯಳ ಹಮಾರಾ ಬಾನಾ ಘರ‍್ಮಾ ಹಮ್ನಾ ಹಮೊನೆ ಸು ಪಾಲ ಛೆ? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />ತೆ ಹನೊನೆ ಬಿಜಾ಼ ವ್ಹೈ ಕೈನ ದೆಕಸ್ತೊ ತೆ ಹಮೊನೆ ಇಕ್ಕಿನ ಹಮೊಕ್ಹು ಮಳಲ ರೊಕ್ಕಾ ತೆ ಯಕ್ಲೊ ಗಳಿಗಯೊಸ್ತೊ. <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಅಪ್ನಾ ಬಾ ಕಂತೊ ಕಾಳಿದಲ ಆಸ್ತಿ ಪುರಾ ಹಮೊನೆ ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ ಕವಸ ತಿಮ್ಮಜ಼ ಕರ ಕೈನ ಉತ್ತರ ದಿದ್ಯಾ. <verse eid="GEN 31:16" /><verse number="17" style="v" sid="GEN 31:17" />ತೆಳಾಮಾ ಯಾಕೊಬ ತಿನಾ ಬಚ್ಚಾವೊನೆ ವರಿ ತಿನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಹುಂಟಪರ ಚ಼ಡಾಯೊ. <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />ತೆ ಗಳಸಲ ಕ್ಹಾರಿ ಆಸ್ತಿ ಪದ್ದನ ಅರಾಮ ದೆಶಮಾ ಗಳಸಲ ಕ್ಹಾರಾ ಜಾನವರನೆ ಲಿನ ಕಾನಾನ ದೆಶೆ ತಿನಾ ಬಾ ಥಯಲ ಇಸಾಕಕನ ಚಾಲ್ಯಾ. <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />ತೆಳಾಮಾ ಲಾಬಾನ ತಿನಾಬಕ್ರಾನಾ ಬಾಲೊ ಕತ್ರಾನಾ ಹುತಿ ಗಯೊತೊ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ರಾಹೆಲ ತಿನಾ ಬಾನಾ ಘರ್ಮಾ ರ‍್ಹಯಲ ಮೊರ್ತಿಯೊ ಚೊ಼ರಿ ಕರ್ಲಿದಿ. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />ತೆನೈಸೊ ಯಾಕೊಬ ಅರಾಮ್ಯನೊ ಲಾಬಾನನೆ ತಿಳಸಾಯಾ ವಾಚಿ ತಿನೆ ಮೊಸ ಕರಿನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />ಅಮ್ಮ ತೆ ತಿನಿ ಆಸ್ತಿ ಪುರಾ ಲಿನ ಯುಫ್ರೆಟಿಸ ಮ್ಹೊಟಿ ನದಿನೆ ದಾಟಿನ ಗಿಲ್ಯಾದ ಕವಾನಾ ಡೊಂಗರನಿ ವಾಟ ಧರಿನ.<verse eid="GEN 31:21" /></para>
  <para style="s">ಲಾಬಾನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗಯಲ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />ಯಾಕೊಬ ಫರಿನ ಗಯೆಲ ತನ್ನ ದಿನ್ನ ಥಯಲ್ಪರ ಲಾಬಾನನೆ ಗ್ವತ ಥಾತಾಮಾ. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />ತೆನೈಸೊ ತೆ ರಾತೆ ಕ್ಹುದಾ ಅರಾಮ್ಯನೊ ಥಯಲ ಲಾಬಾನನಾ ಕ್ಹಪನಮಾ ಐನ ತು ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಚೊ಼ಕು ಕೆಟ್ಟ ಬೊಲ್ಯಾ ಬಗರ ಹುಶಾರಕಿಕ್ಹು ರ‍್ಹೆ ಕದ್ಯೊ. <verse eid="GEN 31:24" /><verse number="25" style="v" sid="GEN 31:25" />ತೆ ಥಯಲ್ಪರ ಲಾಬಾನ ಯಾಕೊಬನೆ ಮಳಲ್ಪರ ಯಾಕೊಬ ಡೊಂಗರ‍್ಮಾ ತಿನು ಝುಪಡು ಘಾಲಿದ್ಯೊತೊ ಲಾಬಾನಬಿ ತಿನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ತೆಜ಼ ಗಿಲ್ಯಾದ ಡೊಂಗರ‍ಮಾ ಝುಪಡು ಘಾಲಿದ್ಯೊ. <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />ಲಾಬಾನ ಯಾಕೊಬನೆ ಆ ಸು ವ್ಹೈ ತು ಕರಲ? ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ಯುದ್ಧಮಾ ಧರಿನ ಲಾಯೆನಿಂಗತ ಲಿನ ಮನೆ ಕದ್ಯಾವಾಚಿ ತ್ಯಾಂತೊ ಐಪಡ್ಯೊಸ್ತೊ. <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />ಕಾ ಮನೆ ಮೊಸ ಕರಿನ ಚೊ಼ರಿ ಕರಲನಿಂಗತ ಐಪಡ್ಯೊ? ಮಿ ಕ್ಹುಶಿಕ್ಹು ತುನೆ ಗಿದ್ದೊ, ನ್ಹಾಚಾಲಾ ವರಿ ಘನ್ನ ತರಾನಾ ವಾದ್ಯೊನಾ ಕ್ಹಾತೆ ತುನೆ ವಳಾತೊತೊ. <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />ತೆನೈಸೊ ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ವರಿ ಮಾರಾ ನಾತ್ನಾ-ನಾತ್ನಿಯೊನೆ ಬಿ ಗಳೆ ಮಳನೆ ನೈ ಥಯಲನಿಂಗತ ಕರ‍್ಯೊಸ ತು ಕರಲ ಪಿಸಾಳಾನು ಕಾಮ ವ್ಹೈ. <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />ತುಮೊನೆ ಕೆಟ್ಟ ಕರಾನೆ ಮಕನ ತಾಕತ ಶೆ ತೆನೈಸೊ ಕಾಲನಾ ರಾತೆ ತಾರಾ ಬಾನೊ ಕ್ಹುದಾ ಯಾಕೊಬನೆ ಚೊಕು ರ‍್ಹವಾದೆ ಕೆಟ್ಟ ರ‍್ಹವಾದೆ ಬೊಲು ಕದ್ಯಾವಾಚಿ ತಿಮ್ಮಜ಼ ಹುಶಾರಕ್ಹು ರ‍್ಹೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />ತೆನೈಸೊ ತುನೆ ತಾರಾ ಬಾನಾ ಘರೆ ಜಾ಼ವಾನಿ ಘನ್ನಿ ಆಸ ರ‍್ಹಯಲಕ್ಹು ತು ಜೌ಼ ಲಾಗ್ಯು ತೆನೈಸೊ ತು ಮಾರಾ ದೆವಸ್ಥಾನೊನೆ ಕಾ ಚೊ಼ರಿ ಕರ‍್ಯೊ? ಕೈನ ಪುಚ್ಯೊ಼. <verse eid="GEN 31:30" /><verse number="31" style="v" sid="GEN 31:31" />ತಿನಾಹುತಿ ಯಾಕೊಬ ಲಾಬಾನನೆ ತು ತಾರಾ ದಿಕ್ರಿಯೊನೆ ಜ಼ಬರದಸ್ತಿಕ್ಹು ಮಕಂತೊ ಕಾಳೆಶಿ ಕೈನ ಭುಚ್ಕಿನ ಐಪಡ್ಯೊ. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />ತಾರಾ ದೆವಸ್ಥಾನೊ ಕಿಕನ ಮಳಸ ತ್ಯುನೆ ಮರಾದೆ. ಮಾರಾ ಸಂಭಂದಿಕರೊನಾ ಕ್ಹಾಮೊಜ಼ ಮಾರಿ ಆಸ್ತಿನೆ ಮೊಜ಼ ಸಕ್ಸಿ. ತಿಮಾ ಸುಬಿ ತಾರು ಮಳ್ಯುಮ ತೆ ತು ಲೆ ಕೈನ ಕದ್ಯೊ. ರಾಹೆಳ ತೆ ದೆವಸ್ಥಾನೊನೆ ಚೊ಼ರಿ ಕರಲ ಯಾಕೊಬನೆ ಗ್ವತ ನ್ಹೊತು. <verse eid="GEN 31:32" /><verse number="33" style="v" sid="GEN 31:33" />ಲಾಬಾನ ಯಾಕೊಬನಾ ಝುಪ್ಡಾಮಾಬಿ, ಲೆಯಳನಾ ಝುಪ್ಡಾಮಾಬಿ, ತೆ ಭಂಬಿ ದಾಸಿಯೊನಾ ಝುಪ್ಡಾವೊಮಾಬಿ ಹುಡಕ್ಯೊ. ತೆನೈಸೊ ತಿನೆ ಸುಜ಼ ಮಳ್ಯು ನೈ. ಲೆಯಳನು ಝುಪ್ಡು ಛೊಡಿನ ರಾಹೆಳನಾ ಝುಪ್ಡಾನೆ ಆಯೊ. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />ರಾಹೆಳ ತೆ ಮುರತಿಯೊನೆ ಲಿನ ಉಂಟನಾ ಚಾಮ್ಡಾನಾ ಕೈಚಿಲಾಮಾ ಘಾಲಿನ ತಿವ್ಯುನಾ ಉಪ್ಪರ ಬೆಟಿತಿ. ಲಾಬಾನ ಝುಪ್ಡಾಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರು ಸಾಮನ ದೆಕ್ಯೊತಬಿ ತಿನೆ ದಿಕ್ಹ್ಯಾ ನೈ. <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />ರಾಹೆಳ ತಿನಾ ಬಾನೆ, 'ಬಾ ಮಿ ತಾರಾ ಕ್ಹಾಮಿ ಉಟಿನ ನೈ ಹುಬ್ರೈರೆ ಶಿಟ್ಟ ಥವು ನಕೊ, ಮಿ ಭಾರಿ ಥೈಸ” ಕೈನ ಕದಿ. ತಿ ಚೊ಼ಕಿತರಾ ಹುಡಕ್ಯೊತಬಿ ತೆ ಮುರತಿಯೊ ನೈ ಮಳಲಕ್ಹು ಫರಿನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 31:35" /><verse number="36" style="v" sid="GEN 31:36" />ತೆಳಾಮಾ ಯಾಕೊಬ ಘನ್ನೊ ಶಿಟ್ಟ ಥೈನ ಲಾಬಾನನೆ ಜೊ಼ರ ವದರಿನ, 'ತು ಅಕ್ಲೊ ಘಾಬ್ರೊ ಥೈನ ಮಾರಾ ಪಾಚೊ಼ ಲಾಗಿನ ಆವಾ ವರಕ್ಹು ಮಿ ಸು ತಪ್ಪ ಕರ‍್ಯೊಸ? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />ಮಾರಾ ಸಾಮನಮಾ ಪುರಾ ತು ಧುಂಡಾ ಅಕಲು ಮಿ ಸು ತಪ್ಪ ಕರ‍್ಯೊತೊ? ತಾರು ಸ್ವಂತ ಮಾರಾಮಾ ಸು ಬಿ ಮಳ್ಯು ಸು? ಮಾರಾ ಸಂಬಂದಿಕರೊನಾ ಕ್ಹಾಮೊ ಬಿ ತಾರಾ ಸಂಬಂದಿಕರೊನಾ ಕ್ಹಾಮೊ ಬಿ ತೆ ಲೈನ ಮ್ಹೆಲ. ಇವುನೆಜ಼ ಅಪೆ ಭ್ಹಂಬಿ ಜ಼ನಾವೊನು ನ್ಯಾಯ ಕರಾದೆ. <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />ಮಿ ತಾರಾ ಕ್ಹಾತೆ ಇಕ್ಹ ವರಕ್ಹ ವ್ಹತ್ತೊ. ತಾರಾ ಹಿಂಡೊನಾ ಹೆಣ್ಣ ಬಕರಿಯೊನಾ ಬಚ್ಚಾವೊನೆ ಖಲಾಸ ಕರಿ ಪಾಡ್ಯೊ ನೈ. ತಾರಾ ಹಿಂಡನಾ ಟಗರೊನೆ ಮಿ ಸು ಖೈ ಪಾಡ್ಯೊ ನೈ. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />ರಾನ್ಮಾನಾ ಜಾನ್ವರೊ ಖಲಾಸ ಕರಲ ಬಕ್ರಿಯೊ, ಬಕ್ರಾನೆ ತಾರಾ ವಾಟಾಮಾ ಘಾಲ್ಯಾವಾಚಿ ಮಿಜ಼ ಕ್ಹಾರು ಹಾಳ ಥಯಲ ಉಚೈಲಿದ್ಯೊ. ರಾತ್ಮಾಬಿ, ದಿನ್ಮಾಬಿ ಜ಼ವೈ ಗಯೆಲನೊ ಲೆಕ್ಕೊ ಮಕಂತೊ ತು ಲಿದ್ಯೊ. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />ದಿನ್ಮಾ ತಡಕಾಕ್ಹು ಕ್ಹಾಂಜ಼ನಿ ಥಂಡಮಾ ತ್ರಾಸ ಖಾದ್ಯೊ. ಕ್ಹುರವಾನೆಬಿ ಮೌಕೊ ಮಳ್ಯೊ ನೈ, ಮಾರಿ ಪರಿಸ್ಥಿತಿ ಇಮ ವ್ಹತಿ. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />ಇಕ್ಹ ವರಕ್ಹ ತಾರಾ ಘರ್ಮಾ ವ್ಹತೊ. ತಾರಿಯೊ ಭಂಬಿ ದಿಕ್ರಿಯೊನಾ ಹುತಿ 14 ವರಕ್ಹ ತಾರಾ ಬಕ್ರಾವೊನಾ ಹುತಿ 7 ವರಕ್ಹ ಸೆವೆ ಕರ‍್ಯೊ. ತಬಿಬಿ ಮಾರೊ ಪಗಾರ ದಕ್ಹ ಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />ಮಾರೊ ಬಾ ಥಯಲ ಕ್ಹುದಾ ಅಬ್ರಹಾಮನೊ ಕ್ಹುದಾ ಇಸಾಕನಿ ಭಯಾ ಭಕ್ತಿ ಕ್ಹು ವಪ್ಪಿಲಿದಲ ಕ್ಹುದಾ ಮಾರಾ ಕ್ಹಾತೆ ನೈ ರ‍್ಹವತ್ತೊ. ಕ್ಹರಿಮಾಜ಼ ಮನೆ ತು ಖಾಲಿ ಹತೆಜ಼ ಮೊಕ್ಲಿಪಾಡ್ತೊತೊ ಕ್ಹುದಾ ಮಾರೊ ಕಷ್ಟ ಮಿ ಖಾದಲ ಪ್ರಯಾಸ ಗ್ವತ್ತ ರ‍್ಹಯಲ ಹುತಿ ಕಾಲ ರಾತೆ ತುನೆ ಭುಚ್ಕಾಡ್ಯೊ.ಕದ್ಯೊ.<verse eid="GEN 31:42" /></para>
  <para style="s">ಯಾಕೊಬ ವರಿ ಲಾಬಾನನಾ ವಚ್ಮಾ಼ ಒಪ್ಪಂದ</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />ಲಾಬಾನ ಯಾಕೊಬನೆ ಎ ಚೊಕ್ರಿಯೊ ಮಾರಿಯೊ ದಿಕ್ರಿಯೊ ವ್ಹೈ. ತ್ಯುನಾ ಬಚ್ಚಾ ಮಾರಾ ರ‍್ಹಯಲ ವ್ಹೈ. ತೆ ಜಾನವರೊ ತೆ ಮಾರಾ ವ್ಹೈ. ತು ದೆಕಾನು ನ್ಹ್ಯಾನು ಹರಿಯಕ್ಕ ಮಾರು ವ್ಹೈ. ತೆ ನೈಸೊ ಮಾರಿಯೊ ದಿಕ್ರಯೊನೆ ರ‍್ಹೈನೆಕಾ ತ್ಯುನಾ ಬಚ್ಚಾ಼ವೊನೆ ರ‍್ಹೈನೆಕಾ ಲಿವಾನೆ ಸಾದೈನತ್ತಿ. <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />ತಿನಾಹುತಿ ತಾರಾ ಕ್ಹಾತೆ ಯಕ್ಕ ವಪಂದ ಕರಲಿವಾನೆ ತಯ್ಯಾರ ಛೆ. ಅಪ್ನಾ ವಪ್ಪಂದನೆ ಸಾಕ್ಷಿನಾಹುತಿ ಮ್ಹೊಟೊ ದಗ್ಡೊಲಿನ ಖಾಮ ನಿಂಗತ ಹುಬ್ರಾಡಿಯೆ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 31:44" /><verse number="45" style="v" sid="GEN 31:45" />ತಿನಾನಿಂಗತಜ಼಼ ಯಾಕೊಬ ಸಾಕ್ಷಿನೆ <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />ತೆ ತ್ಯುನಾ ಮನಕ್ಹೊನೆ ಹಜು಼ನಾ ದಕ್ಹಾ ದಗ್ಡಾ ಲೈನ ಘುಂಪೊ ಕರೊ ಕೈನ ಕದ್ಯೊ ತ್ಯುನೆ ತೆ ಕದಲ ತಿಮ್ಮಜ಼ ಕರ‍್ಯಾ ವರಿ ತ್ಯುನೆ ತ್ಯಾಜ಼ ಬೈಟಿನ ಖಾದ್ಯಾ. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />ಲಾಬಾನ ತೆ ದಗ್ಡಾನಾ ಘುಂಪಾನೆ ಯಗರಸಾಹದುತ ಕೈನ ಗಲೆದ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />ತೆಳಾಮಾ ಲಾಬಾನಹಮ್ನಾ ತುನೆಬಿ ಮನೆ ಥಯಲ ವಪ್ಪಂದನೆ ಆ ಘುಂಪೊಜ಼ ಸಾಕ್ಷಿ ವ್ಹೈ. ಕೈನ ಕದಲ ಹುತಿ ತಿನೆ ಗೆಲೆದ ಕೈನ ನಾಮ ಪಡ್ಯು. <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />ತೆನೈಸೊ ತೆ ಅಪೆ ಯಕ್ನಾ ಯಕ್ಕ ದುರ ರ‍್ಹತಾಮಾ ಯಹೊವಾಜ಼ ಅಪೊನೆ ದೆಕಿಲಿವಾದೆ ಕೈನ ಕದಲ ಹುತಿ ತಿನೆ ಮಿಚ್ಪಾ ಕೈನ ನಾಮ ಪಡ್ಯು. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />ವರಿ ಲಾಬಾನ ತು ಮಾರಿ ಯೊ ಭಮಬಿ ದಿಕ್ರಿಯೊನೆ ತ್ರಾಸ ದಿದ್ಯೊಮ ಬಿಜಿಯೊನೆ ಕಿನೆಬಿ ತು ಹಿವಾ ಕರ್ಲಿದ್ಯೊಮ ಕುನಬಿ ವಿಚಾರ ಕರಾಲಾ ರ‍್ಹಯಾಮ ಕ್ಹುದಾಜ಼ ಅಪ್ನಿ ವಪ್ಪಂದನೆ ಸಾಕ್ಷಿ ವ್ಹೈ ಕದ್ಯೊ. <verse eid="GEN 31:50" /><verse number="51" style="v" sid="GEN 31:51" />ಎ ನಯಸೊ ಲಾಬಾನ ಯಾಕೊಬನೆ ತುನೆಬಿ ಮನೆಬಿ ವಚ್ಮಾ಼ ಮಿ ಹುಬ್ರಾಡಲ ಖಾಮ ದೆಕ ಅ ಘುಂಪಾನೆ ದೆಕ. <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />ಮಿ ಕೆಟ್ಟ ಕರಾನಾಹುತಿ ಎ ಘುಂಪೊ, ದಾಟಿನ ತುಕನ ಆತೊ ನೈ ತಿನಾನಿಂಗತಜ಼಼ ತುಬಿ ಎಘುಂಪಾನೆ ವರಿ ಖಾಮನೆ ದಾಟಿನ ಔ ನೈ. ಇನಾಹುತಿ ಎಜ಼ ಸಾಕ್ಷಿ ವ್ಹೈ. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />ಅಬ್ರಹಾಮನೊ ಕ್ಹುದಾ ನಾಹೊರನೊ ಕ್ಹುದಾ ತ್ಯುನೊ ಬಾನೊ ಕ್ಹುದಾ ತುನೆಬಿ ವರಿ ಮನೆಬಿ ಫೈಸ್ಲೊ ಕರಾದೆ ಕದ್ಯೊ.ತಿನಾ ನಿಂಗತಜ಼಼ ಯಾಕೊಬ ತಿನೊ ಬಾ ಥಯಲ ಇಸಾಕ ಭಯ ಭಕ್ತಿಕ್ಹು ಆರಾಧನಾ ಕರಾನಾ ಕ್ಹುದಾಪರ ಕ್ಹಮ್ಮ ಘಾಲ. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />ಯಾಕೊಬ ತೆ ಡೊಂಗರಪರ ಯಗ್ನ್ಯಾ ಕರಿನ ತಿನಾ ಬಂದುವೊನೆ ಅನ್ನ ಖಾವಾನು ಹುತಿ ಬಲೈನ ತ್ಯುನೆ ಅನ್ನ ಖೈನ ತ್ಯಾಜ಼ ರಾತ ಕಾಡ್ಯಾ. <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />ಪಾಟೆ ಲಾಬಾನ ಉಟಿನ ತಿನಿಯೊ ದಿಕ್ರಿಯೊನೆ . ವರಿ ನಾತನಾವೊನೆ ಮಯಾ ಕರಿನ ತ್ಯುನೊನೆ ಆಶಿರ್ವಾದ ದಿನ ತಿನಾ ಘರೆ ಗೈಪಡ್ಯೊ.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">ಯಾಕೊಬ ಎಸಾವನೆ ಮಳಾನಿ ತಯ್ಯಾರಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />ಯಾಕೊಬ ಪ್ರಯಾಣ ಕರತಾಮಾ ದೆವದುತೊ ತಿನಾ ಕ್ಹಾಮಾ ಆಯಾ. <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />ಯಾಕೊಬ ತ್ಯುನೊನೆ ದೆಕ್ತಾಮಾ ಎ ಕ್ಹುದಾನು ಝುಪ್ಡು ವ್ಹೈ ಕೈನ ತೆ ಜ಼ಗಾನೆ 'ಮಹನಯಿಮ” ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯಾ. <verse eid="GEN 32:2" /><verse number="3" style="v" sid="GEN 32:3" />ತೆ ಥಯಲ್ಪರ ಯಾಕೊಬ ತಿತ್ತಿಬಿ ಪೈಲಾ ಎದ್ಯೊಮವಾಲಾವೊನು ಪ್ರದೆಶ ರ‍್ಹಯಲ ಸೆಯಿರ ಗಾಮೆ ತಿನೊ ಮ್ಹೊಟೊ ಭೈ ಥಯಲ ಯೆಸಾವಕನ ತಿನಾ ಸೆವಕೊನೆ ಮೊಕಲ್ಯೊ. <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />ಮೊಕಲ್ತಾಮಾ ತ್ಯುನೊನೆ ಅಮ್ಮ ಕೆ ಕದ್ಯೊ ತುಮೆ ಮಾರೊ ಪ್ರಭು ಥಯಲ ಎಸಾವಕನ ಗೈನ ತಿನೆ ತಾರೊ ಸೆವಕ ಥಯಲ ಯಾಕೊಬ ಯಕ್ಲಾ ದಿನ್ನ ಲಾಬಾನಕನ ವ್ಹತೊ. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />ಮನೆ ಘನ್ನಾ ಢೊರೊ ಗದ್ಡಾ ಬಕ್ರಿಯೊ ಬಕ್ರಾ ವರಿ ಸೆವಕೊಬಿ ಛೆ ಸ್ವಾಮಿ ತುಮೆ ಮಾರಾ ಉಪ್ಪರ ಕೃಪಾ ಕರೊ ಕೈನ ಮಾಂಗಿಲಿವಾಡ್ಯೊಸ. <verse eid="GEN 32:5" /><verse number="6" style="v" sid="GEN 32:6" />ಸಂದೆಶ ಕವಾಲಾ ಯಾಕೊಬಕನ ಪ್ಹರಿನ ಐನ ಹಮೆ ತಾರಾ ಭೈ ಥಯಲ ಎಸಾವಕನ ಗೈನ ಆಯಾಸ, ತೆ 400 ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ತುಕನ ಆವಾಡೊಸ. ಕೈನ ಕತಾಮಾ. <verse eid="GEN 32:6" /><verse number="7" style="v" sid="GEN 32:7" />ಎ ಕ್ಹಾರು ಐಕಿನ ಯಾಕೊಬನೆ ಘನ್ನು ಭೆ ವಾಟ್ಯು ವರಿ ಚಿಂತಾ ಕರಾಡೊತೊ. ತೆ ತಿಕನ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ವರಿ ಜಾನವರೊನೆ ಬೆ ಭಾಗ ಕರ‍್ಯೊ. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />ವರಿ ತೆ ವಿಚಾರ ಕರ‍್ಯೊ ಎಸಾವ ಐನ ಗುಂಪಪರ ಯುದ್ದ ಕರ‍್ಯೊಮ ಬಿಜೆಕ ಗುಂಪ ಚು಼ಕೈಲಿನ ಜಾ಼ವಸ ಕೈಲಿದ್ಯೊ. <verse eid="GEN 32:8" /><verse number="9" style="v" sid="GEN 32:9" />ತೆನೈಸೊ ಯಾಕೊಬ ಕ್ಹುದಾನೆ ಪ್ರಾಥನಾ ಕರಿನ ಯಹೊವಾ ಮಾರಾ ಬುಡೊ ಥಯಲ ಅಬ್ರಹಾಮನಾ ಕ್ಹುದಾ, ಮಾರೊ ಬಾ ಥಯಲ ಎಸಾಕನಾ ಕ್ಹುದಾ ಮಾರಾ ಸ್ವಂತ ದೆಶೆ ಮಾರಾ ಬಂದುವೊಕನ ಜಾ಼ವಾನೆ ಮನೆ ಅಪ್ಪಣೆದಿನ ತುನೆ ಚೊ಼ಕುಜ಼ ಕರುಸ ಕೈನ ಮನೆ ವಾತ ದಿದಲ ಯಹೊವಾ, <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />ತು ತಾರೊ ದಾಸ ಥಯಲ ಮಪರ ಕೆಕ್ಲೊ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಿನ ತಾರಿ ವಾತ ಪುರಾ ಕರ‍್ಯೊಸ್ತೊ. ಮಿ ತಿನೆ ಕ್ಹಾಲಿ ಅಯೊಗ್ಯ ವ್ಹೈ. ಮಿ ಪೈಲಾ ಎ ಯೊರ್ದನ ನದಿ ದಾಟತಾಮಾ ಮಕನ ಯಕ್ಕ ಲಾಕ್ಡಿಜ಼ ವ್ಹತಿ. ಹಮ್ನಾ ಮಿ ಬೆ ಗುಂಪನೊ ಮಾಲಕ ಥಯೊಸ. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />ತುನೆ ಮಿ ಪ್ರಾಥನಾ ಕರುಸ ಮಾರೊ ಭೈ ಥಯಲ ಎಸಾವ ಐನ ಮನೆ ವರಿ ಮಾರಾ ಬಚ್ಚಾ಼ವೊನೆ ತ್ಯುನಿಯೊ ಮಾವೊನೆ ಖಲಾಸ ಕರಸ ಕೈನ ಮನೆ ಭೆ ಛೆ. ತಿನಾ ಹತ್ಮಾ ಕ್ಹಾಪಡೆ ನೈಸೊ ಕರ ಕೈನ ತುಕನ ಮಾಂಗಿಲ್ಯುಸ. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />ಖರಿಮಾಜ಼ ತುನೆ ಚೊ಼ಕು ಕರಿನ ತಾರಿ ಸಂತತಿನೆ ಸಮುದ್ರನಾ ಉಸುಕನಿಂಗತ ಲೆಕ್ಕೊವಾಚಿ ಅಭಿವೃದ್ದಿ ಕರುಸ ಕೈನ ತು ಮನೆ ಕದ್ಯೊತೊ ತೊ’" ಕದ್ಯೊ. <verse eid="GEN 32:12" /><verse number="13" style="v" sid="GEN 32:13" />ಯಾಕೊಬ ತೆ ರಾತೆ ತ್ಯಾಜ಼ ವ್ಹತೊ. ತೆ ಲಾಯಲ ತೆಕ್ಲಾಮಾನು ದಕ್ಹು ತಿನಾ ಭೈನೆ ಎಸಾವನೆ ಕಾಣಿಕೆ ಕರಿನ ಲಿದ್ಯೊ. <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />200 ಬಕ್ರಿಯೊ 20 ಬಕ್ರಾ 20 ಟಗರೊನಾ ಕ್ಹಾತೆ ದುದ್ದ ಪಿವಾಲಾ, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />30 ಹೆಣ್ಣ ಹುಂಟೊ ವರಿ ತ್ಯುನಾ ಬಚ್ಚಾ 40 ಬೈಲೊ 10 ಹೊರಿಯೊ 20 ಹೆಣ್ಣ ಗದ್ಡಾ 10 ಗಂಡ ಗದ್ಡಾ ಎ ಕ್ಹಾರು ಲಿದ್ಯೊ. <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />ಇವ್ಯನೊನೆ ಯಕ್ಕ ಯಕ್ಕ ಗುಂಪ ಕರಿನ ಯಕ್ಕ ಯಕ್ಕ ಗುಂಪ ತಿನಾ ಸೆವಕೊಕನ ವಪ್ಸಿನ ತುಮೆ ಮುತ್ತಿ ಅಗಾ ಜಾ಼ವೊ ವರಿ ಹರಿಯಕ್ಕ ಹಿಂಡ ತಾ ನಕ್ಕರ ದುರ ದುರ ರ‍್ಹವೊ ಕದ್ಯೊ. <verse eid="GEN 32:16" /><verse number="17" style="v" sid="GEN 32:17" />ಪೈಲಾನಾ ಹಿಂಡನಾ ಉಪ್ಪರ ರ‍್ಹಯಲವಾಲಾನೆ ಮಾರೊ ಭೈ ಎಸಾವನೆ ತಾರಾ ಕ್ಹಾಮೊ ಐನ ತು ಕಿನೊ ಸೆವಕ ವ್ಹೈ? ಕಿಜ್ಗಾ಼ ಚಾ಼ಲ್ಯೊಸ? ತಾರಾ ಕ್ಹಾಮು ರ‍್ಹಯಲ ಎ ಕ್ಹಾರು ಕಿನು ವ್ಹೈ? ಕೈನ ಪುಚ್ಯೊಮ. <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />ತೆಳಾಮ ತು ತೆ ಕ್ಹಾರು ತುಮಾರೊ ಸೆವಕ ಥಯಲ ಯಾಕೊಬನು ವ್ಹೈ ತಿನೊ ಪ್ರಭು ಥಯಲ ಕ್ಹಾರು ಕಾಣಿಕೆ ವ್ಹೈ ಕೈನ ಮೊಕಲ್ಯೊಸ. ತೆ ಹಮಾರಾ ಪಾಚೊ಼ ಆವಾಡೊಸ. ಕೈನ ಉತ್ತರ ದ್ಯು ಕೈನ ಕವಾನು ಅಪ್ಪಣೆ ದಿದ್ಯೊ. <verse eid="GEN 32:18" /><verse number="19" style="v" sid="GEN 32:19" />ತಿಮ್ಮಜ಼ ಬೆವಾ ವಾಲಾನಾ ತನ್ವಾ ವಾಲಾನಾ ಗುಂಪನಾ ಪಾಚೊ಼ ಗಯಲ ಕ್ಹಾರಾವೊನೆ ತುಮೆ ಎಸಾವನೆ ದೆಕ್ತಾಮಾ ಇನಾನಿಂಗತಜ಼಼ ಕೌ. ತಾರೊ ಸೆವಕ ಥಯಲ ಯಾಕೊಬ ಹಮಾರಾ ಪಾಚೊ಼ ಆವಾಡೊಸ. ಕವೊ ಕೈನ ಅಪ್ಪಣೆ ದಿದ್ಯೊ. <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />ಯಾಕೊಬ ತಿನಾಮಜ಼ ಮಾರಾ ಕ್ಹಾಮೊ ಜ಼ಾವಾನು ಎ ಕಾಣಿಕೆಕ್ಹು ಎಸಾವನೆ ಸಮಾಧಾನ ಕರುಸ ತಿಪರ ತಿನೆ ಮಳತಾಮಾ ಮನೆ ಮಯಾಕ್ಹು ಮಳಸ? ಕೈಲಿದ್ಯೊ. <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />ತಿಮ್ಮ ತೆ ಕಾಣಿಕೆ ತಿನಾ ಕ್ಹಾಮಾತಿ ಗೈ. ತೆ ತೆ ರಾತೆ ತಿನಾ ಝುಪ್ಡಾಮಾ ರ‍್ಹಯೊ.<verse eid="GEN 32:21" /></para>
  <para style="s">ಯಾಕೊಬನಿ ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಕುಸ್ತಿ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />ತೆ ರಾತೆ ತೆ ತಿನಾ ಭಂಬಿ ಬೈಕೊವೊನೆ, ಭಂಬಿ ದಾಸಿಯೊನೆ ವರಿ ತಿನಾ ಗ್ಯಾರಾ ಬಚ್ಚಾವೊನೆಬಿ ಬಲೈಲಿನ ಯಬ್ಬೊಕ ನದಿ ದಾಟ್ಯೊ. <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />ತ್ಯುನೊನೆ, ವರಿ ತಿನಿ ಆಸ್ತಿ ಪುರಾ ದಟಾಯಲ್ಪರ <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />ಯಾಕೊಬ ಯಕ್ಲೊ ಥೈನ ಪಾಚೊ಼ ಹುಬ್ರಲಕ್ಹು ಕಯೊ ಯಕ್ಕ ದಾಣಗೊ ಐನ ತಿನಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರಾಡೊತೊ ತೆ ದಾಣಗೊ ಪಾಟ ಥಯಲಕ್ಕಾ ತಿನಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರ‍್ಯೊ. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />ತೆ ದಾಣಗೊ ನೈ ಜಿತ್ತಾನು ತೆ ದೆಕಿನ ಯಾಕೊಬನಾ ಮಾಂಡಿನಿ ನರ್ರ ಮುಟ್ಟಲಕ್ಹು ಯಾಕೊಬ ತಿನಾ ಕ್ಹಾತೆ ಲಡತಾಮಾ ತಿನಾ ಪಗನಿ ನರ‍್ರ ಸರ‍್ಕಿ. <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />ತೆ ದಾಣಗೊ, 'ಮನೆ ಚೊಡ, ಪಾಟ ಥಾವಾಡಿಸ” ಕತಾಮಾ, ಯಾಕೊಬ, 'ತು ಮನೆ ಆಶಿರ್ವಾದ ಕರೆಲಕ್ಕುನ ಮಿ ತುನೆ ಚೊಡತೊ ನೈ” ಕದ್ಯೊ. <verse eid="GEN 32:26" /><verse number="27" style="v" sid="GEN 32:27" />ತೆ ದಾಣಗೊ, 'ತಾರು ನಾಮ ಸು ವ್ಹೈ?” ಕೈನ ಪುಚಲ ಕ್ಹು ತೆ, 'ಯಾಕೊಬ” ಕತಾಮಾ, <verse eid="GEN 32:27" /><verse number="28" style="v" sid="GEN 32:28" />ತೆ ಯಾಕೊಬನೆ, 'ಇನಾ ಉಪ್ಪರ ತು ಯಾಕೊಬ ಕೈನ ಕವೈಲೆತೊ ನೈ; ತು ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಬಿ, ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆಬಿ ಯುದ್ದ ಕರಿನ ಜಿತ್ತಲವಾಲೊ ಥಯಲಕ್ಹು ತುನೆ ‘ಇಸ್ರಾಯೆಲ’ ಕೈನ ನಾಮ ಥಾವಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 32:28" /><verse number="29" style="v" sid="GEN 32:29" />ಯಾಕೊಬ, 'ತು ತಾರು ನಾಮ ಮನೆ ಕೌ” ಕೈನ ತಿನೆ ಪುಚ಼ಲಕ್ಹು ತೆ, 'ಮಾರು ನಾಮ ಕಾ ಪುಚ್ಚಶಿ?” ಕೈನ ತಿನೆ ತ್ಯಜ಼ ಆಶಿರ್ವಾದ ಕರ‍್ಯೊ. <verse eid="GEN 32:29" /><verse number="30" style="v" sid="GEN 32:30" />ತೆಳಾಮಾ ಯಾಕೊಬ, 'ಮಿ ಕ್ಹುದಾನೆ ಪ್ರತ್ಯಕ್ಷ ಥಯಲ ದೆಕ್ಯೊಸ್ತೊ; ರ‍್ಹೈತಬಿ ಮಾರು ಜ್ಯು ವಾಚ್ಯುಸ್ತೊ” ಕರಿನ ಕೈನ ತೆ ಜ಼ಗಾನೆ ಪೆನಿಯೆಲ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ, <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />ತೆ, ಪೆನುವೆಲನೆ ದಾಟತಾಮಾ ಸುರ್ಯೊ ಹುಟ್ಯೊ. ತೆನೈಸೊ ಯಾಕೊಬ ಮಾಂಡಿನಾ ದುಕ್ಕ ಕ್ಹು ಲಂಗಡ್ತೊ ಚಾಲ್ಯೊ. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />ತಿನಾಹುತಿ ತೆ ದಾಣಗೊ ಯಾಕೊಬನಿ ಮಾಂಡಿನಿ ನರ್ರ ಮುಟ್ಟಲಕ್ಹು ಇಸ್ರಾಯೆಲೊ ಹಜುನಬಿ ಮಾಂಡಿನಿ ನರ್ರ ನೈ ಖಾತಾ.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">ಯಾಕೊಬ ಎಸಾವನೆ ಮಳಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />ಯಾಕೊಬ ಡೊಳಾ ಉಚೈನ ದೆಕತಾಮಾ, ಎಸಾವ 400 ಜ಼ನಾವೊನಾ ಕ್ಹಾತೆ ಆವಾನು ದೆಕ್ಯೊ. ತೆಳಾಮಾ ತೆ ಲೆಯಳನೆಬಿ ರಾಹೆಳನೆಬಿ ಭಂಬೆ ದಾಸಿಯೊನೆಬಿ ತ್ಯುನಾ ತ್ಯುನಾ ಬಚ್ಚಾವೊನೆ ಒಪ್ಸಿನ ತ್ಯುನೊನೆ ಬಿಜಾ ಬಿಜಾ ಕರಿನ <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />ಕ್ಹಾಮೊ ದಾಸಿಯೊನೆಬಿ ತ್ಯುನಾ ಬಚ್ಚಾವೊನೆ ತ್ಯುನಾ ಪಾಚೊ಼ ಲೆಯಳನನೆ ವರಿ ತಿನಾ ಬಚ್ಚಾವೊನೆ ಲಾಸ್ಟೆ ರಾಹೆಳನೆ ವರಿ ಯೊಸೆಫನೆ ಹುಬ್ರಾಡ್ಯೊ. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />ತೆಜ಼ ತ್ಯುನಾ ಕ್ಹಾಮೊ ಗೈನ ತಿನೊ ಮ್ಹೊಟೊ ಭೈ ಕ್ಹಾಮೊ ಆತಾಮಾ ಕ್ಹಾತ ಸಲಾ ಜಿಮಿನ ಮಟ್ಟಾ ಮಾತು ಜು಼ಕೈನ ನಮಸ್ಕಾರ ಕರ‍್ಯೊ. <verse eid="GEN 33:3" /><verse number="4" style="v" sid="GEN 33:4" />ತೆಳಾಮಾ ಯೆಸಾವ ತಿನೆ ಮಳಾನೆ ಕೈ ಕ್ಹಾಮೊ ನ್ಹಾಟಿನ ಐನ ತಿನೆ ಗಳೆ ಮಳಿನ ಮಟ್ಟಿ ದಿದ್ಯೊ. ತ್ಯುನೆ ಭಂಬಿ ಜ಼ನಾ ರೊಯಾ. <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />ತೆ ಥಯಲ್ಪರ ಎಸಾವ ಡೊಳಾ ಉಚೈನ ತೆ ಬಾಕಡಿಯೊನೆ ಬಚ್ಚಾವೊನೆ ದೆಕಿನ, 'ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ಕುನ ವ್ಹೈ?” ಕೈನ ಪುಚ್ಚತಾಮಾ ಯಾಕೊಬ ತಿನೆ, 'ಕ್ಹುದಾ ತಾರಾ ಸೆವಕನೆ ಕೃಪಾಕ್ಹು ದಿದಲ ಬಚ್ಚಾ ಇವನೆಜ಼ ವ್ಹೈ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 33:5" /><verse number="6" style="v" sid="GEN 33:6" />ತೆಳಾಮಾ ತಿನಾ ಭಂಬೆ ದಾಸಿಯೊ ತ್ಯುನಾ ಬಚ್ಚಾವೊನೆ ಬಲೈಲಿನ ಕ್ಹಾಮಾ ಐನ ಅಡ್ಡ ಪಡ್ಯಾ. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />ಪಾಚಲ್ತಿ ಲೆಯಳ ತಿನಾ ಬಚ್ಚಾವೊನಾ ಕ್ಹಾತೆ ಐನ ಅಡ್ಡ ಪಡಿ. ಲಾಸ್ಟೆ ಯೊಸೆಫ ವರಿ ರಾಹೆಳ ಐನ ಅಡ್ಡ ಪಡ್ಯಾ. <verse eid="GEN 33:7" /><verse number="8" style="v" sid="GEN 33:8" />ಎಸಾವ, 'ಮಿ ವಾಟ್ಮಾ ದೆಕಲ ತೆ ಜಾನವರೊ ಶಾನೆ?” ಕೈನ ಪುಚ಼ತಾಮಾ ಯಾಕೊಬ, 'ಸ್ವಾಮಿಯೊನಿ ದಯಾ ಮನೆ ಚಾ಼ಯೆ ಕೈನ ಮಿ ತುಮೊನೆ ತೆ ದಿನ ವಳಾಯೊ” ಕದ್ಯೊ. <verse eid="GEN 33:8" /><verse number="9" style="v" sid="GEN 33:9" />ಎಸಾವ ತಿನೆ ಎ ಮಾರಾ ನ್ಹಾನಾ ಭೈ, ಮನೆ ಚಾ಼ಯೆ ಥಯಲ ಅಕ್ಲಿ ಆಸ್ತಿ ಛೆ, ತಾರು ತುನೆ ರ‍್ಹವಾದೆ” ಕವಾಕ್ಹು <verse eid="GEN 33:9" /><verse number="10" style="v" sid="GEN 33:10" />ಯಾಕೊಬ, 'ತಿಮ್ಮ ನೈ, ತುನೆ ಮಾರಾ ಉಪ್ಪರ ದಯಾ ರ‍್ಹಯಾಮ, ಮಿ ದಿವಾನಿ ಕಾಣಿಕೆ ಲಿವು. ತುನೆ ದೆಕಲಕ್ಹು ಕ್ಹುದಾನೆ ದೆಕೆನಿಂಗತ ಥಯು,ಮನೆ ಮಯಾಕ್ಹುಜ಼ ಮಳೈ ಲಿದಲಜ಼ ಘನ್ನಿ ಚೊ಼ಕಿ ಸಂಗತಿ ಥೈಸ. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />ಕ್ಹುದಾ ಮನೆ ಕೃಪಾ ಕರಲಕ್ಹು ಮನೆ ಸಮೃದ್ಧಿ ಉಂಟ ಥಯು. ತಿನಾ ಹುತಿ ಮಿ ದಿವಾನು ಕಾಣಿಕೆ ತು ದಯಾ ಮ್ಹೆಲಿನ ಲಿವು” ತಿಮ್ಮ ಕೈನ ಎಸಾವನೆ ಜ಼ಬರದಸ್ತಿ ಕರಲಕ್ಹು ತೆ ತೆ ಕಾಣಿಕೆ ಲಿದ್ಯೊ. <verse eid="GEN 33:11" /><verse number="12" style="v" sid="GEN 33:12" />ಪಾಚಲ್ತೊ ಎಸಾವ, 'ಅಪೆ ಪ್ರಯಾಣ ಅಗಾ ಬಡೈಯೆ. ಮಿ ಕ್ಹಾಮೊ ಜೌ಼ಸ ಕೈನ” ಕದ್ಯೊ. <verse eid="GEN 33:12" /><verse number="13" style="v" sid="GEN 33:13" />ತಿನಾಹುತಿ ಯಾಕೊಬ, 'ಮಾರಾ ಬಚ್ಚಾ ಜಾಂಜಿಮಾನ ಅರಾಮ ನೈಸೊ ಛೆ ತೆನೈಸೊ ಅರಾಮ ನೈಸೊ ಬೈಲೊ ಬಕ್ರಾ ಮಕನ ರ‍್ಹಯಲ ಪ್ರಭುನೆ ತಿಳದ್ಯುಸ. ಯಕ್ಕ ದಿನ್ನ ಜಾಸ್ತ ತ್ಯುನೊನೆ ಚಲಾಯಾರೆ ಬಕ್ರಾವೊನಾ ಕ್ಹಾರಾ ಹಿಂಡೊ ಮರಿ ಜಾ಼ವಸ. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />ತುಮೆ ದಯಾ ಮ್ಹೆಲಿನ ಸೆವಕತಿ ಪೈಲಾ ಜಾ಼ ಸಕೊಶಿ ಮಿ ಮಾರಾ ಕ್ಹಾಮಾ ರ‍್ಹಯಲ ಬಕ್ರಾ ಬಕ್ರಿಯೊ ಚಾ಼ಲಾನಿ ವರಿ ಬಚ್ಚಾವೊನಿ ಶಕ್ತಿ ನಾ ಕ್ಹಾತೆಜ಼ ಹಲ್ಲು ಹಲ್ಲು ಚಾ಼ಲ್ತೊ ಮಾರಾ ಪ್ರಭುನಿ ಸಿಮೆ ಥಯಲ ಸೆಯಿರನೆ ಔಸ” ಕದ್ಯೊ. <verse eid="GEN 33:14" /><verse number="15" style="v" sid="GEN 33:15" />ಎಸಾವ, 'ಮಾರಾ ಆಳೊಮಾ ದಕ್ಹಾ ಜ಼ನಾವೊನೆ ತಾರಾ ಕ್ಹಾತೆ ಚ಼ೊಡಿನ ಜೌ಼ಸ” ಕತಾಮಾ ಯಾಕೊಬ, 'ತ್ಯುನಿ ಸು ಜರುರತ ಛೆ? ಮಾಲಕ, ತುಮಾರಿ ದಯಾ ಮಾರಾ ಉಪ್ಪರ ರ‍್ಹೈಮ ಬಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 33:15" /><verse number="16" style="v" sid="GEN 33:16" />ಅಮ್ಮ ಎಸಾವ ತೆ ದಿನ್ನೆಜ಼ ಸೆಯಿರನೆ ಗೈಪಡ್ಯೊ. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />ಯಾಕೊಬ ಪ್ರಯಾಣ ಕರಿನ ಸುಕ್ಕೊತನೆ ಆಯೊ. ತ್ಯಾ ತಿನಾ ಹುತಿ ಘರ ವರಿ ಬೈಲೊನಾ ಹುತಿ ಜ಼ೊಪಡು ಬಂದಾಯೊ.ತಿನಾ ಹುತಿ ತೆ ಜ಼ಗಾನೆ 'ಸುಕ್ಕೊತ” ಕೈನ ನಾಮ ಥಯು. <verse eid="GEN 33:17" /><verse number="18" style="v" sid="GEN 33:18" />ಯಾಕೊಬ ಪದ್ದನ ಅರಾಮತೊ ಐನ, ಕಾನಾನ ದೆಶನಾ ಶೆಕೆಮ ಗಾಮೆ ಚೊ಼ಕಿತರಾ ಆಯೊ. ತೆ ಗಾಮಕನ್ನ ತಿನಾ ಗುಡಾರೊ ಘಲೈಲಿದ್ಯೊ. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />ತೆ ತಿನಾ ಗುಡಾರೊ ಘಲಾಯಲ್ಪರ ಜ಼ಗಾನೆ ಹಮೊರನಾ ಬಚ್ಚಾವೊನೆ ಕ್ಹೊ ಬಿಲ್ಲಾ ದಿನ ತ್ಯುನೊಕಂತೊ ಲಿದ್ಯೊ. ಹಮೊರ ಶೆಕೆಮನೊ ಬಾ ವ್ಹೈ. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />ತ್ಯಾ ಯಾಕೊಬ ಯಹೊವಾನೆ ಬಲಿನೊ ಕಟ್ಟೊ ಭಂದಾಯೊ ತಿನೆ 'ಎಲ ಎಲೊಹೆ ಇಸ್ರಾಯೆಲ” ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ.<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">ದಿನಾ ವರಿ ಶೆಕಮವಾಲಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />ಯಾಕೊಬನೆ ಲೆಯಳಮಾ ಹುಟ್ಟಲ ದಿಕ್ರಿ ಥಯಲ ದಿನಳ ಯಕ್ಕ ದಿನ್ನ ತೆ ದೆಶನಾ ಬಾಕ್ಡಿಯೊನೆ ಮಳಾನೆ ಐ. <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />ದೆಶಾದಿಪತಿ ಥಯಲ ಹಿವ್ವಿಯನೊ ಥಯಲ ಹಮೊರನೊ ದಿಕ್ರೊ ಶೆಕೆಮ ತಿನೆ ದೆಕಿನ ಲಿಂಗೈನ ಮಾನಭಂಗ ಕರಲಕ್ಹು. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />ತಿನು ಮನಸ ಯಾಕೊಬನಿ ದಿಕ್ರಿ ಥಯಲ ದಿನಳನಾ ಉಪ್ಪರಜ಼ ವ್ಹತ್ತು. ತೆ ಛೊಕರಿನೆ ಪ್ಯಾರ ಕರಿನ ತಿನಾ ಕ್ಹಾತೆ ಮನಸ ಮಳ್ಳ ಕರಾನಾ ವಾತೊ ಬೊಲ್ಯೊ. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />ಶೆಕೆಮ ತಿನೊ ಬಾ ಥಯಲ ಹಮೊರನೆ, 'ತು ಆ ಛೊಕರಿನೆ ಮನೆ ಹಿವಾ ಕರು” ಕೈನ ಮಾಂಗಿಲಿದ್ಯೊ. <verse eid="GEN 34:4" /><verse number="5" style="v" sid="GEN 34:5" />ಯಾಕೊಬ ತಿನಿ ದಿಕ್ರಿ ದಿನಳನೆ ಶೆಕೆಮತು ಮಾನಭಂಗ ಥಯಲ ಐಕಲಪರ ತಿನಾ ದಿಕ್ರಾ ರಾನ್ಮಾ ಬೈಲೊನೊ ಕೈದಾಡಾತಾ. ತ್ಯುನೆ ಆಯೆಲಕ್ಕುನ ತೆ ಗಪ್ಪಜ಼ ವ್ಹತ್ತೊ. <verse eid="GEN 34:5" /><verse number="6" style="v" sid="GEN 34:6" />ತೆಕ್ಲಮಾಜ಼ ಶೆಕೆಮನೊ ಬಾ ಥಯಲ ಹಮೊರ ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಬೊಲಾನೆ ಆಯೊ. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />ಯಾಕೊಬನಾ ದಿಕ್ರಾ ಆಯೆಲ್ಪರ ಘಾಬ್ರಾ ಥೈನ ಘನ್ನಾ ಶಿಟ್ಟ ಥಯಾ. ಶತಕೆಮ ಯಾಕೊಬನಿ ದಿಕ್ರಿನೆ ಮಾನಭಂಗ ಕರಿನ ಇಸ್ರಾಯೆಲರೊಮಾ ಘನ್ನಿ ಕೆಟ್ಟ ಮರ್ಯಾದಿ ಜಾ಼ವಾನು ಕಾಮ ಕರ‍್ಯೊಸ. <verse eid="GEN 34:7" /><verse number="8" style="v" sid="GEN 34:8" />ಹಮೊರ ತ್ಯುನೊನೆ, 'ಮಾರೊ ದಿಕ್ರೊ ಥಯಲ ಶೆಕೆಮ ತುಮಾರಿ ಛೊಕ್ರಿನೆ ಆಸಕ್ಹು ಮೊಹ ಕರ್ಯೊಸ, ತಿನೆ ತಿನಾ ಕ್ಹಾತೆ ಹಿವಾ ಕರಿನ ದ್ಯು ಕೈನ ತುಮೊನೆ ಮಾಂಗಿಲ್ಯುಸ. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />ಎನೈಸೊ ತುಮೆ ಹಮೊಮಾಜ಼ ರ‍್ಹೈನ ತುಮಾರಾ ದಿಕ್ರಿಯೊನೆ ಹಮೊನೆ ದೆತಾ ಹಮಾರಾ ದಿಕ್ರಿಯೊನೆ ತುಮೆ ಲೆತಾ ಹಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವೊ. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />ದೆಶ ಪುರಾ ತುಮಾರಾ ಕ್ಹಾಮು ಛೆ ತ್ಯಾ ರ‍್ಹೈನ ವ್ಯಾಪಾರ ಕರಿನ, ಆಸ್ತಿ ಕಮೈಲೆ ಸಕಿಯೆಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 34:10" /><verse number="11" style="v" sid="GEN 34:11" />ಪಾಚಲ್ತೊ ಶೆಕೆಮ ತೆ ಛೊಕರಿನಾ ಬಾನೆಬಿ ವರಿ ಮ್ಹೊಟಾ ಭಾಯೊನೆ, 'ತುಮಾರಿ ದಯಾ ಮಪರ ರ‍್ಹವಾದೆ, ತುಮೆ ಕದಲ ಅಕ್ಲು ದ್ಯುಸ. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />ತುಮೆ ಕದಲಕ್ಕುನ್ನ ದಹೆಜ಼ ಕಾಣಿಕೆ ಛೊಕ್ರಿನಾ ಹುತಿ ದ್ಯುಸ. ಲೆಕಿನ ತೆ ಛೊಕ್ರಿನೆ ಮನೆ ಬೈಕೊ ಕರಿನ ದಿವೊ” ಕದ್ಯೊ. <verse eid="GEN 34:12" /><verse number="13" style="v" sid="GEN 34:13" />ಶೆಕೆಮ ತ್ಯುನಿ ನ್ಹಾನಿ ಭೆನ ಥಯಲ ದಿನಳನೆ ಮಾನಭಂಗ ಕರಲಕ್ಹು ಯಾಕೊಬನಾ ದಿಕ್ರಾ ತಿನೊ ಬಾ ಥಯಲ ಹಮೊರನೆ ಫರಿನ ಉತ್ತರ ದಿದ್ಯಾ. <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />ತಿನಾ ಹುತಿ ತಿನಾ ಭಾಯೊ ತಿನೆ, 'ತು ಹಮಾರಿ ಭೆನ್ನೆ ಹಿವಾ ಕರಿಲಿವಾನೆ ಹಮೆ ತುನೆ ಮೊಕೊ ನೈ ದೆಸಕತಾ; ಕಾ ಕದ್ಯಮ ತುನೆ ಹಜುನ ಖತ್ನಾ ನತ್ತಿ ಥೈ. ಹಮಾರಿ ಭೆನ ತುನೆ ಹಿವಾ ಕರಿಲಿವಾನು ತಪ್ಪ ಥಾವಸ. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />ಲೆಕಿನ ತು ವರಿ ತಾರಾ ಗಾಮ್ನಾ ಕ್ಹಾರಾ ದಣಗಾ ಹಮಾರಾ ದಾಕ್ಹಲ ಖತ್ನಾ ಕರೈಲಿದ್ಯಾರೆ ತು ಹಮಾರಿ ಭೆನ್ನೆ ಹಿವಾ ಕರಲೆ ಸಕಶಿ. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />ಪಾಚಲ್ತಾ ತುಮಾರಾ ಪಟ್ಟಾ ಹಮಾರಾ ಛೊಕರಿಯೊನೆ ಹಿವಾ ಕರಲೆ ಸಕಸ ವರಿ ಹಮಾರಾ ಪಟ್ಟಾ ತುಮಾರ ಛೊಕರಿಯೊನೆ ಹಿವಾ ಕರಲೆ ಸಕೆಸ. ತೆಳಾಮ ಅಪೆ ಯಕ್ಕಜ ಜನಾಂಗ ಥೈಯೆಸ. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />ತೆನೈಸೊ ತುಮೆ ಖತ್ನಾ ನೈ ಕರೈಲಿದ್ಯಾರೆ ಹಮೆ ದಿನಳನೆ ಬಲೈ ಲಿಂಗೈಯೆಸ” ಕೈನ ಕದ್ಯಾ. <verse eid="GEN 34:17" /><verse number="18" style="v" sid="GEN 34:18" />ತ್ಯುನೆ ಕದಲ ಹಮೊರನೆ ಬಿ ಶೆನೆಮನೆ ಬಿ ಚೊಕು ವ್ಹೈ ಕೈನ ಲಾಗ್ಯು. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />ದಿನಳನಾ ಮ್ಹೊಟಾ ಭಾಯೊ ಕದಲ ಕರಾನೆ ಶೆಕೆಮ ಖುಶಿಕ್ಹು ಒಪ್ಪಿಲಿದ್ಯೊ. ಶೆಕೆಮನೆ ತ್ಯುನಾ ಕುಟುಂಭಮಾ ಖಾಸ ವ್ಹತೊ. <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />ಹಮೊರ ವರಿ ಶೆಕೆಮ ತ್ಯುನಾ ಗಾಮ್ನಾ ಸಬೆನಾ ಜ಼ಗಾಕನ ಗಯಾ. ತ್ಯುನೆ ಗಾಮ್ನಾ ದಾಣಗಾವೊನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />'ಎ ಇಸ್ರಾಯಲರೊನೆ ಅಪ್ನಾ ದೊಸ್ತೊ ಥೈನ ರ‍್ಹವಾನು ಇಷ್ಟಾ ಛೆ; ಇವನೆ ಅಪ್ನಾ ದೆಶಮಾ ರ‍್ಹೈನ ಅಪ್ನಾ ಕ್ಆತೆ ಸಮಾಧಾನಕ್ಹು ರ‍್ಹವಾನು ಹಮೊನೆ ಬಿ ಇಷ್ಟಾ ಛೆ; ಅಪೊನೆ ಚಾಯೆ ಥಯಲ ಅಕ್ಲಿ ಜ಼ಗಾ ಅಪ್ನೊಕನ ಛೆ. ಹಮೆ ತ್ಯುನಾ ಛೊಕ್ರಿಯೊನೆ ಹಿವಾ ಕರಿಲಿವನೆ ಅಪ್ನಾ ಛೊಕರಿಯೊನೆ ತ್ಯುನೊನೆ ಹಿವಾ ಕರಿನ ದಿವಾನೆ ಬಿ ಹಮೆ ಖಶಿ ಥೈಯೆಸೆ. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />ತೆನೈಸೊ ಅಪೆ ಕರಾನು ಯಕ್ಕಜ ಯಕ್ಕ ಕಾಮ ಸು ವ್ಹೈ ಕದ್ಯಾಮ, ಇಸ್ರಾಯೆಲರೊನಾ ನಿಂಗತಜ಼ ಅಪ್ನಾ ಕ್ಹಾರಾ ದಾಣಗಾ ಖತ್ನಾ ಕರೈಲ್ಯು. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />ಅಪೆ ಇಮ್ಮ ಕರ‍್ಯಾಮ, ತ್ಯುನಾ ಕ್ಹಾರಾ ಬೈಲೊ ಬಕ್ರಿಯೊತಿಬಿ ಜಾನ್ವರೊತಿಬಿ ಸೌಕಾರೊ ಥೈಯೆಸ. ಅಪೆ ಆಂ ಒಪ್ಪಂದ ತ್ಯುನಾ ಕ್ಹಾತೆ ಕರಿಲಿದ್ಯಾಮ ತ್ಯನೆ ಅಪ್ನಾ ಕ್ಹಾತೆ ನ್ಹ್ಯಾಜ ವಾಸ ಕರಸ” ಕೈನ ಕದ್ಯಾ. <verse eid="GEN 34:23" /><verse number="24" style="v" sid="GEN 34:24" />ಸಬೆನಿ ಜ಼ಗಾಮಾ ರ‍್ಹಯಲ ಜ್ಹಾರಾ ದಾಣಗಾ ಹಮೊರನಾ ವರಿ ಶೆಕೆಮನಾ ವಾತೊನೆ ಒಪ್ಪಿಲಿದ್ಯಾ. ಪಾಚಲ್ತಾ ಕ್ಹಾರಾ ದಾಣಗಾ ಖತ್ನಾ ಕರೈಲಿದ್ಯಾ. <verse eid="GEN 34:24" /><verse number="25" style="v" sid="GEN 34:25" />ತನ್ವಾ ದಿನ್ನ ಥಯೊತಬಿ ಖತ್ನಾ ಕರೈಲಿದಲ ದಾಣಗಾ ಹಜುಬಿ ದುಕ್ಕಮಾ ವ್ಹತ್ತಾ. ಎ ಟೈಮಮಾ ದಾಣಗಾ ತಾಕತ ನೈಸೊವಾಲಾ ರೈಸ ಕೈನ ಯಾಕೊಬನಾ ಬೆ ದಿಕ್ರಾ ಥಯಲ ಸಿಮೆಯೊನ ವರಿ ಲೆವಿನೆ ಗ್ವತ್ತ ವ್ಹತ್ತು. ತಿನಾಹುತಿ ತ್ಯುನೆ ತಲ್ವಾರೊ ಲಿನ ಗೈನ ತ್ಯಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ದಾಣಗಾವೊನೆ ಖಲಾಸ ಕರಿಪಾಡ್ಯಾ. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />ದಿನಳನಾ ಮ್ಹೊಟಾ ಭಾಯೊ ಥಯಲ ಸಿಮೆಯೊನ ವರಿ ಲೆವಿಯ ಹಮೊರನೆ ವರಿ ತಿನೊ ದಿಕ್ರೊ ಥಯಲ ಶೆಕೆಮನೆ ಖಲಾಸ ಕರಿನ ದಿನಳನೆ ಶೆಕೆಮನಾ ಘರ್ತಾ ಬಲೈಲಾಯಾ. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />ಯಾಕೊಬನಾ ದಿಕ್ರಾ ಗಾಮ್ಮಾ ಗೈನ ತ್ಯಾ ರ‍್ಹಯಲ ಹರಿಯಕ್ಕ ಲಿದ್ಯಾ. ತ್ಯುನಿ ಭೆನ್ನಿ ಶೆಕೆಮ ಮರ್ಯಾದಿ ಕಾಡಲಕ್ಹು ತ್ಯುನೆ ಹಜುನಬಿ ಸಿಟ್ಟಮಾಜ಼ ವ್ಹತ್ತಾ. <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />ಅಮ್ಮ ದಿನಳನಾ ಮ್ಹೊಟಾ ಭಾಯೊ ತ್ಯುನಾ ಬೈಲೊ ಬಕ್ರಿಯೊನೆ ಗದ್ಡಾವೊನೆ ಗಾಮ್ಮಾ ರ‍್ಹಯಲ ವರಿ ಖೆತರೊಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಿ ಆಸ್ತಿ ಲಿದ್ಯಾ. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />ತ್ಯುನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಬಚ್ಚಾ಼ವೊನೆ ಧರಿನ ಘರೊಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರು ಕಾಳಿದ್ಯಾ. <verse eid="GEN 34:29" /><verse number="30" style="v" sid="GEN 34:30" />ತೆನೈಸೊ ಯಾಕೊಬ ಸಿಮೆಯೊನನೆ ವರಿ ಲೆವಿನೆ, 'ತುಮೆ ಮನಿ ಅಪಾಯನೆ ಗುರಿ ಕರ್‍ಯಾಸ. ಎ ದೆಶಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಕಾನಾನ್ಯರೊ ವರಿ ಪರಿಜಿಯರೊ ಮನೆ ದ್ವೆಷ ಕರಿನ ಇರೊದ ಥಾವಸ. ಮನೆ ರ‍್ಹಯಲ ಮನಕ್ಹ ದಕ್ಹಾ ಜನಾ ವ್ಹೈ. ಎ ದೆಶಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಯಕ್ಕ ಥೈನ ಮಳಿನ ಮನೆ ವಿರೊದ ಥೈನ ಹೊರಾಡ್ಯಾಮ ಮಿ ವರಿ ಮಾರಾ ಮನಕ್ಹೊ ಪುರಾ ನಾಶ ಥೈಯೆಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 34:30" /><verse number="31" style="v" sid="GEN 34:31" />ಲೆಕಿನ ದಿನಳನಾ ಮ್ಹೊಟಾ ಭಾಯೊ, 'ಹಮಾರಿ ಭೆನ್ನೆ ತೆ ಮನಕ್ಹೊ ಸುಳಿ ದಾಕ್ಹಲ ಉಪಯೊಗ ಕರಾದೆ ಹಮೆ ಛೊಡಿಯೆ ಸು? ನೈ, ಹಮಾಎಇ ಭೆನ್ನೆ ತ್ಯುನೆ ಕರಲ ತಪ್ಪ ವ್ಹೈ” ಕೈನ ಕದ್ಯಾ.<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">ಕ್ಹುದಾ ಬೆತೆಲಮಾ ಯಾಕೊಬನೆ ಆಶಿರ್ವಾದ ದಿದಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />ಕ್ಹುದಾ ಯಾಕೊಬನೆ, 'ತು ಬೆತೆಲ ಗಾಮೆ ಗೈನ ತ್ಯಜ ವಾಸಸ ವರಿ ಆರಾಧನೆ ಕರಾನಾ ಹುತಿ ಯಕ್ಕ ಬಲಿ ದಿವಾನೊ ಕಟ್ಟೊ ಭಾಂದಾ ಲಗಾಡ. ತು ತಾರೊ ಭೈ ಥಯಲ ಎಸಾವ ಕಂತೊ ನ್ಹಾಟಿನ ಜಾ಼ತಾಮಾ ಕ್ಹುದಾ ಥಯಲ ‘ಎಲ’ ತುನೆ ತ್ಯಾ ದಿಕ್ಹ್ಯೊ ನೈ ಸು! ತಿನೆ ಆರಾಧನಾನಾ ಹುತಿ ತ್ಯಾ ಬಲಿನೊ ಕಟ್ಟೊ ಭಾಂದಾ ಲಗಾಡ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 35:1" /><verse number="2" style="v" sid="GEN 35:2" />ತಿನಾಹುತಿ ಯಾಕೊಬ ತಿನಾ ಕುಟುಮಬವಾಲಾವೊನೆಬಿ ತಿನಾ ಕ್ಹಾರಾ ಸೆವಕರೊನೆಬಿ, 'ತುಮೊಕನ ರ‍್ಹಯಲ ಜಾಡನಾ ವರಿ ಲ್ಹೊಡಾನಾ ಕ್ಹಾ ಬಿಜಾ ದೆವಸ್ಥಾನೊನೆ ನಾಶ ಕರೊ. ತುಮೊನೆ ಶುಧ್ಧ ಕರಿಲಿನ ಶುಧ್ಧ ರ‍್ಹಯಲ ವಣ್ಣಾ ಘಾಲಿವೊ. <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />ಅಪೆ ನ್ಹ್ಯಾಂತಾ ಗೈನ ಬೆತೆಲನೆ ಗೈಯೆ; ಮಿ ಕಷ್ಟಮಾ ರ‍್ಹಯಲ ಟೈಮಮಾ ಮದತ ಕರಲ ಕ್ಹುದಾನಾ ಹುತಿ ಯಕ್ಕ ಬಲಿನೊ ಕಟ್ಟೊ ತ್ಯಾ ಭಂದೌಸ. ಮಿ ಗಯೆಲ ತ್ಯಕ್ಲಿ ಜ಼ಗಾ ತೆ ಕ್ಹುದಾ ಮಾರಾ ಕ್ಹಾತೆ ವ್ಹತ್ತೊ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />ತಿನಾಹುತಿ ತ್ಯುನೆ ತ್ಯುನೊಕ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಬಿಜಾ ದೆವಸ್ಥಾನೊನೆ ವರಿ ತ್ಯುನಾ ಕಾನೊಮಾ ರ‍್ಹಯಲ ಜುಮ್ಕಾ ಯಾಕೊಬನೆ ದಿದ್ಯಾ. ಯಾಕೊಬ ತೆ ಕ್ಹಾರು ಶೆಕೆಮ ಗಾಮಕನ ನಜಿಕ ರ‍್ಹಯಲ ಎಲಾ<note caller="+" style="f"><char style="fr" closed="false">35:4 </char><char style="fq" closed="false">ಎಲಾ </char></note> ಝಾಡನಾ ಬುಡಮಾ ಬುರಿನ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />ಯಾಕೊಬ ವರಿ ತಿನ ದಿಕ್ರಾ ತೆ ಜ಼ಗಾತಾ ಚಾಲ್ಯಾ. ತೆ ಪ್ರದೆಶಮಾ ರ್ಹಹಯಲ ಮನಕ್ಹೊ ಪಾಚಾ ಲಾಗಿನ ಖಲಾಸ ಕರು ಕೈನ ವ್ಹತ್ತಾ. ಲೆಕಿನ ತ್ಯುನೆ ಭುಚ್ಕಿನ ಯಾಕೊಬನಾ ಪಾಚಾ ಗಯಾ ನೈ. <verse eid="GEN 35:5" /><verse number="6" style="v" sid="GEN 35:6" />ಯಾಕೊಬ ವರಿ ತಿನಾ ಮನಕ್ಹೊ ಲುಜಿನೆ ಗಯಾ. ಹಮ್ನಾ ಲುಜನೆ ‘ಬೆತೆಲ’ ಕೈನ ಬಲಾವಸ. ತೆ ಕಾನಾನ ದೆಶಮಾ ಛೆ. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />ಯಾಕೊಬ ತ್ಯಾ ಐನ ಬಲಿನೊ ಕಟ್ಟೊ ಭಂದಾಯೊ. ಯಾಕೊಬ ತಿನಾ ಮ್ಹೊಟಾ ಭೈ ಕಂತೊ ನ್ಹಾಟಿನ ಜಾ಼ತಾಮಾ ಕ್ಹುದಾ ತಿನೆ ಪೈಲಾ ದಿಕ್ಹಲಜ಼ ತೆ ಜ಼ಗಾಮಾ ವ್ಹೈ. ತಿನಾಹುತಿ ಯಾಕೊಬ ತೆ ಜ಼ಗಾನೆ ‘ಎಲ ಬೆತೆಲ’ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. <verse eid="GEN 35:7" /><verse number="8" style="v" sid="GEN 35:8" />ರೆಬೆಕಳನಿ ದಾಸಿ ಥಯಲ ದೆಬೊರಳ ತ್ಯಾ ಮರಿ ಗೈ. ತಿನಾಹುತಿ ತ್ಯುನೆ ತಿನೆ ಬೆತೆಲಕನ್ನ ರ‍್ಹಯಲ ಎಲಾಝಾಡನಾ ಬುಡಮಾ ಸಮಾದಿ ಕರ‍್ಯಾ.ತೆ ಜ಼ಗಾನೆ 'ಅಲೊನ ಬಾಕೊತ” ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯಾ.<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />ಯಾಕೊಬ ಪದ್ದನ ಅರಾಮತೊ ಫರಿನ ಆಯೆಲ್ಪರ, ಕ್ಹುದಾ ತಿನೆ ವರಿ ದಿಕ್ಹಿನ ತಿನೆ ಆಶಿರ್ವಾದ ಕರ‍್ಯೊ. <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />ಕ್ಹುದಾ ಯಾಕೊಬನೆ, 'ತಾರು ನಾಮ ಯಾಕೊಬ ವ್ಹೈ. ಲೆಕಿನ ಮಿ ತೆ ನಾಮನೆ ಬದಲುಸ. ಇನಾ ಉಪ್ಪರ ತು ಯಾಕೊಬ ಕೈನ ಕವೈಲೆತೊ ನೈ. ತಾರು ನೌ ನಾಮ ‘ಇಸ್ರಾಯೆಲ’ ಕರಿನ ಕೈನ ತಿನೆ ‘ಇಸ್ರಾಯೆಲ’ ಕೀನ ನಾಮ ಮ್ಹಲ್ಯೊ. <verse eid="GEN 35:10" /><verse number="11" style="v" sid="GEN 35:11" />ಕ್ಹುದಾ ತಿನೆ, 'ಮಿಜ ಸರ್ವಶಕ್ತ ಥಯಲ ಕ್ಹುದಾ ವ್ಹೈ. ತು ಘನ್ನಾ ಬಚ್ಚಾವೊನೆ ಪಡ್ದಿನ ಮ್ಹೊಟು ಜನಾಂಗ ಥೈನ ಬ್ಯಳದಶಿ. ಘನ್ನಾ ಜನಾಂಗೊ ರಾಜಾವೊ ತಾರಮಾತ ಆವಸ. <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />ಮಿ ಅಬ್ರಹಾನೆ ಬಿ ಇಸಾಕನೆ ಬಿ ಖಾಸ ರ‍್ಹಯಲ ದೆಶ ದಿದ್ಯೊಸ. ಹಮ್ನಾ ಮಿ ತೆ ದೆಶ ತುನೆ ದ್ಯುಸ. ಮಿ ತೆ ದೆಶನೆ ತಾರಿ ಅಗ್ಲಿ ಸಂತತಿವಾಲವೊ ಮಟ್ಟಾ ಬಿ ದ್ಯುಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />ಪಾಚ಼ಲ್ತೊ ಕ್ಹುದಾ ತೆ ಜ಼ಗಾತೊ ಗೈಪಡ್ಯೊ. <verse eid="GEN 35:13" /><verse number="14" style="v" sid="GEN 35:14" />ಯಾಕೊಬ ಎ ಜ಼ಗಾಮಾ ಶೆ ದಿಲಾವಾನಾ ಹುತಿ ಯಕ್ಕ ದಗಡಾನೆ ಹುಬ್ರಾಡಿನ ತಿನಾ ಉಪರ ದ್ರಾಕ್ಷಾ ರ‍್ಹಕ್ಹ ವರಿ ತೆಲ ರಿಚಾಯೊ. ಎ ಯಕ್ಕ ಖಾಸ ರ‍್ಹಯಲ ಜ಼ಗಾ ವ್ಹೈ. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />ಕಾ ಕದ್ಯಾಮ ತ್ಯಾ ಯಾಕೊಬನೆ ಕ್ಹುದಾ ಬೊಲ್ಯೊ. ಯಾಕೊಬ ತೆ ಜ಼ಗಾನೆ 'ಬೆತೆಲ” ಕೈನ ನಾಮ ಮ್ಹಲ್ಯೊ.<verse eid="GEN 35:15" /></para>
  <para style="s">ರಾಹೆಳನು ಮರಣ</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />ಯಾಕೊಬ ವರಿ ತಿನಾ ಮನಕ್ಹೊ ಬೆತೆಲತಾ ಗೈನ ಎಫ್ರಾತ ಗಾಮೆ ಆವಾತಿ ದಕ್ಹಿ ದುರ ಪೈಲಾ ರಾಹೆಳನೆ ಜನ್ನಾನು ತ್ರಾಸನೊ ದಿನ್ನ ನಜಿಕ ಐಯುತು. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />ಲೆಕಿನ ರಾಹೆಳ ಎಸಲಾ ಜ಼ಂತಾಮಾ ಘನ್ನು ತ್ರಾಸ ಖೌ ಲಗ್ಯು. ತಿನೆ ಘನ್ನು ದುಕ್ಕ ವ್ಹತ್ತು. ರಾಹೆಳನಿ ಬುಡಿ ಎ ದೆಕಿನ, ತಿನೆ, 'ರಾಹೆಳ, ಬುಚ್ಕುನಕೊ. ತು ವರಿ ಯಕ್ಕ ದಿಕ್ರಾನೆ ಜನ್ನಾಡಿಸ” ಕೈನ ಕದಿ. <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />ರಾಹೆಳ ದಿಕ್ರಾನೆ ಜ಼ಂತ್ತಾಮಾ ಮರಿ ಗೈ; ಮರಾತಿ ಪೈಲಾ, ರಾಹೆಳ ತೆ ಬಚ್ಚಾನೆ ಬೆನೊನಿ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. ಲೆಕಿನ ಯಾಕೊಬ ತಿನೆ ಬೆನ್ಯಾಮಿನ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ. ತಿಮ್ಮ ರಾಹೆಳ ಮರಿ ಗೈ. <verse eid="GEN 35:18" /><verse number="19" style="v" sid="GEN 35:19" />ರಾಹೆಳನೆ ಬೆತ್ಲೆಹೆಮ ಕವಾನಾ ಎಫ್ರಾತನೆ ಜಾವಾನಿ ವಾಟ್ಮಾಜ ಮಜಾರ ಕರ‍್ಯಾ. <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />ಯಾಕೊಬ ರಾಹೆಳನಾ ಮಜಾರಪರ ಖಾಸ ರ‍್ಹಯಲ ಯಕ್ಕ ದಗಡೊ ಮ್ಹೆಲಯೊ. ಹಜುನಬಿ ತೆ ದಗಡೊ ತ್ಯಾಜ಼ ಛೆ. <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />ಪಾಚಲ್ತೊ ಇಸ್ರಾಯೆಲ ಪ್ರಯಾಣ ಅಗೊ ಬಡೈನ 'ಮಿಗ್ದಲ ಎದರ” ನಾ ಡೊಂಗರಕನ ದಕ್ಷಿಣಮಾ ತಿನಾ ಗುಡಾರೊ ಘಲಾಯೊ. <verse eid="GEN 35:21" /><verse number="22" style="v" sid="GEN 35:22" />ಇಸ್ರಾಯೆಲ ದಕ್ಹಾ ದಿನ್ನಾ ತ್ಯಾ ರ‍್ಹಯೊ. ತೆ ತ್ಯಾ ರ‍್ಹತಾಮಾ ರೊಬೆನ ಇಸ್ರಾಯೆಲನಿ ದಾಸಿ ಥಯಲ ಬಿಲ್ಹಳನಾ ಕ್ಹಾತೆ ಕ್ಹುರಯೊ. ಇಸ್ರಾಯೆಲ ಇನಾ ಹುತಿ ಐಕಲ್ಪರ ಘನ್ನೊ ಶಿಟ್ಟ ಥಯೊ. ಯಾಕೊಬನೆ ಬಾರಾ ದಿಕ್ರಾ ವ್ಹತಾ.<verse eid="GEN 35:22" /></para>
  <para style="s">ಯಾಕೊಬನಾ ದಿಕ್ರಾ</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 35:23" />ಲೆಯಳನಾ ದಿಕ್ರಾ: ಯಾಕೊಬನೊ ಮ್ಹೊಟೊ ದಿಕ್ರೊ ಥಯಲ ರೊಬೆನ, ಸಿಮೆಯೊನ, ಲೆವಿ, ಯೆಹುದ, ಇಸ್ಸಾಕಾರ ವರಿ ಜೆಬುಲೊನ. <verse eid="GEN 35:23" /><verse number="24" style="v" sid="GEN 35:24" />ರಾಹೆಳನಾ ದಿಕ್ರಾ: ಯೊಸೆಫ ವರಿ ಬೆನ್ಯಾಮಿನ. <verse eid="GEN 35:24" /><verse number="25" style="v" sid="GEN 35:25" />ಬಿಲ್ಹಳ ರಾಹೆಳನಿ ದಾಸಿ ವ್ಹೈ. ಬಿಲ್ಹಳನಾ ದಿಕ್ರಾ: ದಾನ ವರಿ ನಫ್ತಾಲಿನ. <verse eid="GEN 35:25" /><verse number="26" style="v" sid="GEN 35:26" />ಜಿಲ್ಪಳ ಲೆಯಳನಿ ದಾಸಿ ವ್ಹೈ, ಜಿಲ್ಪಳನಾ ದಿಕ್ರಾ: ಗಾದ ವರಿ ಆಶೆರ. ಇವನೆ ಕ್ಹಾರಾ ಯಾಕೊಬನೆ ಪದ್ದನ ಅರಾಮಮಾ ಹುಟ್ಟಲ ದಿಕ್ರಾ ವ್ಹೈ.<verse eid="GEN 35:26" /></para>
  <para style="s">ಯಾಕೊಬನು ಮರಣ</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />ಯಾಕೊಬ ತಿನೊ ಬಾ ಥಯಲ ಇಸಾಕ ಕನ್ನ ಹೆಬ್ರೊನಕವಾನಾ ಕಿರ್ಯತರ್ಬಮಾ ರ‍್ಹಯಲ ಮಮ್ರೆನೆ ಆಯೊ. ಅಬ್ರಹಾಮ ವರಿ ಇಸಾಕ ವಾಸ ಥಯಲ ನ್ಯಜ ವ್ಹೈ. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />ಇಸಾಕ ಯಕ್ಹೊನ ಐಂಶಿ ವರಕ್ಹ ಲಕ್ಕಾ ಜಿವಿಶ್ಯೊ. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />ತೆ ಥಯಲ್ಪರ ಇಸಾಕ ದಿನೊ ಭರಲ ಗಡಿಯೊ ಥಯಲ್ಕಕ ಜಿವಸಿನ ಮರ್xಯೊ. ತಿನಾ ದಿಕ್ರಾ ಥಯಲ ಎಸಾವ ವರಿ ಯಾಕೊಬ ತ್ಯುನಾ ಬುಡಾನೆ ಮಜಾರ ಕರಲ ಜ಼ಗಾಜ ತ್ಯುನಾ ಬಾನಿ ಮಜಾರ ಕರ‍್ಯಾ.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">ಎಸಾವನಾ ಖಾಂದಾನ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />ಎದೊಮ ಕವಾನು ಎಸಾವನಿ ಖಾಂದಾನ ಎ ವ್ಹೈ: <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />ಎಸಾವ ಕಾನಾನ್ಯರೊನಾ ಛೊಕ್ರಿಯೊನೆ ಹಿವಾ ಕರಿಲಿದ್ಯೊ. ತ್ಯುನೆ ಕುನ್ನ ವ್ಹೈ ಕದ್ಯಾಮ, ಹಿತ್ತಿಯನೊ ಥಯಲ ಎಲೊನನಿ ದಿಕ್ರಿ ಥಯಲ ಆದಾ, ಹಿವ್ವಿಯೊನೊ ಥಯಲ ಸಿಬಿಯೊನನಿ ದಿಕ್ರಿ ಥಯಲ ಅನಾಹಳನಿ ದಿಕ್ರಿ ಥಯಲ ಒಹೊಲಿಬಾಮಳನೆ, <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />ವರಿ ಇಷ್ಮಾಯರಲನಿ ದಿಕ್ರಿ ಥಯಲ ನೆಬಾಯೊತನಿ ನ್ಹಾನಿ ಭೆನ ಥಯಲ ಬಾಸೆಮತ ಇವ್ಯುನೊನೆ ಹಿವಾ ಕರಿಲಿದ್ಯೊತೊ. <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />ಆದಾಳ ಎಸಾವನೆ ಎಲಿಫಜನೆ ಜ಼ನ್ನಿ. ಬಾಸೆಮತ ರೆಗುವೆಲನೆ ಜ಼ನ್ನಿ. <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />ಒಹೊಲಿಬಾಮ ಯೆಗೊಷನೆ ಯಳಾಮನೆ, ಕೊರಹನನೆ ಜ಼ನ್ನಿ. ಕಾನಾನ ದೆಶಮಾ ಎಸಾವನೆ ಹುಟ್ಟಲ ಬಚ್ಚಾ ಇವ್ಯುನೆಜ಼ ವ್ಹೈ. <verse eid="GEN 36:5" /><verse number="6" style="v" sid="GEN 36:6" />ತೆ ಥಯಲ್ಪರ ಎಸಾವ ತಿನಾ ಬಾಕ್ಡಿಯೊನೆ, ದಿಕ್ರಾವೊನೆ, ತಿನಾ ಘರೆ ಮಳಲ ಕ್ಹಾರಾ ಸೆವಕರೊನೆ, ತಿನೆ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಪಶುಪ್ರಾಣಿಯೊನಾ ಹಿಂಡೊನೆ ಕಾನಾನ ದೆಶಮಾ ಕಮಾಯಲ ಆಸ್ತಿ ಪುರಾ ಲಿನ ತಿನೊ ನ್ಹಾನೊ ಭೈ ಥಯಲ ಯಾಕೊಬ ಕಂತೊ ಬಿಜ಼ಾ ದೆಶೆ ಗೈಪಡ್ಯೊ. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />ತ್ಯುನಿ ಆಸ್ತಿ ಜಾಸ್ತಿ ರ‍್ಹಯಲಕ್ಹು ತ್ಯುನೆ ಭಂಬೆ ಜ಼ನಾ ಯಕ್ಕಜ಼ ಜ಼ಗಾಮಾ ರ‍್ಹವಾನೆ ಸಾದ್ಯ ನ್ಹೊತು. ತ್ಯುನೆ ಪಶು ಪ್ರಾಣಿಯೊ ಘನ್ನಾ ರ‍್ಹಯಲಕ್ಹು ತ್ಯುನೆ ಪ್ರವಾಸ ಥಯಲ ದೆಶ ತ್ಯುನೊನೆ ಬಸ ಥಯುಜ಼ ನೈ. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />ಇಮ್ಮ ಎಸಾವ ಸೆಯಿರ ಡೊಂಗರನಾ ಸಿಮೆನೆ ಗೈನ ತ್ಯಾಜ಼ ರ್ಹೈ ಗಯೊತೊ. ಎಸಾವ ಕದ್ಯಾಮ ಎದೊಮ ವ್ಹೈ. <verse eid="GEN 36:8" /><verse number="9" style="v" sid="GEN 36:9" />ಸೆಯಿರ ಡೊಂಗರನಾಸಿಮೆಮಾ ರ್ಹಹಯಲ ಎದೊಮ್ಯರೊನೊ ಮುಲ ಪುರುಶ ಥಯಲ ಎಸಾವನಾ ವಂಶನಿ ಚರಿತ್ರೆ: <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />ಎಸಾವನಾ ಬಚ್ಚಾವೊನಾ ನಾಮೊ ಕಯಾ ವ್ಹೈ ಕದ್ಯಾಮ: ಎಲಿಫಜನ, ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಆದಾ ಕವಾಲಿನೊ ದಿಕ್ರೊ ವ್ಹೈ. ರೆಗುವೆಲ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಬಾಸೆಮತನೊ ದಿಕ್ರೊ ವ್ಹೈ. <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />ಎಲಿಫಜನಾ ಬಚ್ಚಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ತೆಮಾನ, ಓಮಾರ, ಚೆಫೊ, ಗತಾಮ, ಕೆನೆಜ, <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />ತಿಮ್ನ ಕವಾಲಿ ಎಸಾವನೊ ದಿಕ್ರೊ ಥಯಲ ಎಲಿಫಜನೆ ಫಸ್ಟನಿ ಬೈಕೊ ಥೈತಿ ತೆ ತಿನೆ ಅಮಾಲೆಕನೆ ಜ಼ನ್ನಿ.ಇವ್ಯುನೆಜ಼ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಆದಾ ಕವಾಲಿನಾ ಬಚ್ಚಾ ವ್ಹೈ. <verse eid="GEN 36:12" /><verse number="13" style="v" sid="GEN 36:13" />ರೆಗುವೆಲನಾ ದಿಕ್ರಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ನಹತ, ಜೆರಹ, ಶಮ್ಮಾ ಮಿಜ್ಜಾ ಇವ್ಯುನೆ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಬಾಸೆಮತನಾ ದಿಕ್ರಾ ವ್ಹೈ. <verse eid="GEN 36:13" /><verse number="14" style="v" sid="GEN 36:14" />ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಸಿಬಿಯೊನನಿ ದಿಕ್ರಿ ಥಯಲ ಒಹೊಲಿಬಾಮನಾ ಬಚ್ಚಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ಯೆಗೊಷವಂಶಸ್ಥೊನೆ, ಯಳಾಮ ಕೊರಹ ಇವ್ಯುನೊನೆ ಜ಼ನ್ನಿ. <verse eid="GEN 36:14" /><verse number="15" style="v" sid="GEN 36:15" />ಎಸಾವನಾ ದಿಕ್ರಾವೊನಾ ಕುಲಪತಿಯೊ ಕುನ್ನ ವಹೈ ಕದ್ಯಾಮ: ಎಸಾವನೊ ಮ್ಹೊಟೊ ದಿಕ್ರೊ ಥಯಲ ಎಲಿಫಜರತಾ ಹುಟ್ಟಲವಾಲಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ತೆಮಾನ, ಓಮಾರ, ಚೆಫೊ, ಕೆನೆಜ, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />ಕೊರಹ, ಗತಾಮ, ಅಮಾಲೆಕ, ಇವ್ಯುನೆಜ಼ ಎ ಕುಲಪತಿಯೊ ವ್ಹೈ ಎದೊಮ್ಯರೊನಾ ದೆಶಮಾ ರ‍್ಹಯಲ ಎಲಿಫಜರತಾ ಆಯೆಲವಾಲಾ ವ್ಹೈ. ಇವ್ಯುನೆ ಆದಾಳನಾ ನಾತ್ನಾ ವ್ಹೈ. <verse eid="GEN 36:16" /><verse number="17" style="v" sid="GEN 36:17" />ಎಸಾವನೊ ದಿಕ್ರೊ ಥಯಲ ರೆಗುವೆಲನೆ ಹುಟ್ಟಲವಾಲಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ನಹತ, ಜೆರಹ, ಶಮ್ಮಾ, ಮಿಜ್ಜಾ ಕವಾನಾ ಕುಲಪತಿಯೊ ಹುಟ್ಟ್ಯಾ. ಇವ್ಯುನೆ ಎದೊಮ್ಯರೊನಾ ದೆಶಮಾ ರ‍್ಹಯಲ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಬಾಸೆಮತನೆ ಹುಟ್ಟಲ ನಾತ್ನಾ ವ್ಹೈ. <verse eid="GEN 36:17" /><verse number="18" style="v" sid="GEN 36:18" />ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಒಹೊಲಿಬಾಮನಿ ದಿಕ್ರಿ ಥಯಲ ಅನಾಳನಿ ಸಂತಾನನಾ ಕುಲಪತಿಯೊ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ಯೆಗೊಷ, ಯಳಾಮ, ವರಿ ಕೊರಹ. ಇವ್ಯುನೆಜ಼ ಅನಾಹನಿ ದಿಕ್ರಿ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಒಹೊಲಿಬಾಮನಾ ಸಂತಾನವಾಲಾ ವ್ಹೈ. <verse eid="GEN 36:18" /><verse number="19" style="v" sid="GEN 36:19" />ಎದೊಮ ಕವೈಲಿವಾಲೊ ಎಸಾವತಾ ಹುಟ್ಟಲವಾಲಲಾ ಖಾಂದಾನೆ ಇವ್ಯುನೆಜ಼ ಕುಲಪತಿಯೊ ವ್ಹೈ. <verse eid="GEN 36:19" /><verse number="20" style="v" sid="GEN 36:20" />ಲೆಯಳ ಕ್ಹುದಾ ಮನೆ ಚೊ಼ಕು ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ ಮೆ ಮಾರಾ ಮಾಟಿನೆ ಛೆವಾ ಪಟ್ಟಾ ಜ಼ನ್ನಿನ ದಿದಿಲಕ್ಹು ತೆ ಮಾರಾ ಕ್ಹಾತೆಜ಼ ಜಿವ್ನಾ ಕರಸ ಕೈನ ತೆ ಪಟ್ಟಾನೆ ಜೆಬುಲೊನ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />ತೆ ಥಯಲ್ಪರ ತೆ ಯಕ್ಕ ಚೊ಼ಕ್ರಿ ಜ಼ನ್ನಿನ ತಿನೆ ದಿನಾ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 36:21" /><verse number="22" style="v" sid="GEN 36:22" />ಪಾಚಲ್ತೊ ಕ್ಹುದಾ ರಾಹೆಳನೆ ಶೆ ಕರಿನ ತಿನಿ ಪ್ರಾಥನಾ ಐಕಿನ ತಿನೆ ಬಚ್ಚಾ ಥಾವಾ ವರಕ್ಹು ಕರ‍್ಯೊ. <verse eid="GEN 36:22" /><verse number="23" style="v" sid="GEN 36:23" />ತೆ ಪೆಟೆ ರ‍್ಹೈನ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿನ, ಕ್ಹುದಾ ಮಪರ ರ‍್ಹಯಲ ಕಲಂಕ ಕಾಡಿಪಾಡ್ಯೊ. <verse eid="GEN 36:23" /><verse number="24" style="v" sid="GEN 36:24" />ತೆ ನೈ ತೆ ಯೆಹೊವ ಮನೆ ವರಿ ಯಕ್ಕ ಪಟ್ಟೊ ದಿದ್ಯೊಸ. ಕೈನ ತಿನು ನಾಮ ಯೊಸೆಫ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ.<verse eid="GEN 36:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 36:25" />ಯೊಸೆಫ ಹುಟ್ಟಲ್ಪರ ಯಾಕೊಬ ಲಾಬಾನನೆ ಮಿ ಹಮ್ನಾ ಮಾರಾ ಸ್ವಂತ ಗರೆ ಜಾ಼ವಾನೆ ಅನುಮತಿ ದೆ, <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />ಮಾರಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಬಚ್ಚಾ಼ವೊನೆ ಮನೆ ದೆ ಮಿ ತಾರಿ ಸೆವೆ ಕರಿನ ತ್ಯುನೊನೆ ಗಳಸಿ ಲಿದ್ಯೊಸ. ಮಿ ತುನೆ ಚೊ಼ಕಿ ಸೆವೆ ಕರ‍್ಯೊಸ ಕವಾನು ತುನೆ ಗ್ವತ್ತ ಛೆ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 36:26" /><verse number="27" style="v" sid="GEN 36:27" />ಲಾಬಾನ ತಿನೆ ಮಿ ಕವಾನು ಐಕ ಯಹೊವಾ ತಾರಿಕ್ಹು ಮನ ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 36:27" /><verse number="28" style="v" sid="GEN 36:28" />ಕೆ ಮಿ ತುನೆ ಕೆಕ್ಲೊ ಪಗಾರ ದ್ಯು? ತು ಕದಲ ತೆಕ್ಲು ದ್ಯುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 36:28" /><verse number="29" style="v" sid="GEN 36:29" />ಯಾಕೊಬ ಮಿ ತಾರಾ ಹುತಿ ತ್ರಾಸ ಖೈನ ಕಾಮ ಕರ‍್ಯೊಸ ಕವಾನು ತುನೆ ಗ್ವತ್ತ ಛೆ. ಮಿ ತಾರಾ ಬಕ್ರಾವೊನೆ ದೆಕ್ರಾಣಕಿ ಕರಲ ಹುತಿ ತೆ ಜಾಸ್ತಿ ಥಯಾಸ. <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />ಮಿ ಆತಾಮಾ ಬಕ್ರಾ ದಕ್ಹಾಜ಼ ವ್ಹತಾ. ಹಮ್ನಾತೊ ತುಕನ ಘನ್ನಾ ಬಕ್ರಾ ಛೆ. ಮಿ ತಾರಾಹುತಿ ಕರಲ ಕ್ಹಾರಾನೆ ಯಹೊವಾ ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ. ಮಿ ಖುದ್ದನಾ ಹುತಿ ಕಾಮ ಕರಾನು ಟೈಮ ಛೆ ಮಾರಾ ಸ್ವಂತ ಘರೆ ಜಾ಼ವಾನೆ ಟೈಮ ಛೆ ಕದ್ಯೊ. <verse eid="GEN 36:30" /><verse number="31" style="v" sid="GEN 36:31" />ಲಾಬಾನ ತಿಮ ರ‍್ಹಯೊಮ ಮಿ ತುನೆ ಸು ದ್ಯು ಕೆ ಕೈನ ಪುಚ್ಯೊ. ಯಾಕೊಬ ತು ಮನೆ ಸುಜ಼ ದ್ಯು ನಕೊ ತು ಮಾರಾಹುತಿ ಯಕ್ಕ ಕಾಮ ಕರ‍್ಯೊಮ ಬಸ್ಸ, ಪ್ಹರಿನ ಮಿ ತಾರಾ ಬಕ್ರಾವೊನೆ ರಾಕುಸ. <verse eid="GEN 36:31" /><verse number="32" style="v" sid="GEN 36:32" />ತೆ ಸುವೈ ಕದ್ಯಾಮ ಹಮ್ನಾಜ಼ ಮಿ ತಾರಾ ಬಕ್ರಾವೊನಾ ಗುಂಪಮಾ ಗೈನ ಬಕ್ರಾವೊಮಾ ಚಿಕ್ಕಿಯೊ ವರಿ ಮಚ್ಚ ರ‍್ಹಯಲ ಬಕ್ರಾವೊಮಾ ಕಾಳಾ ರ‍್ಹಯಲ ಬಕ್ರಿಯೊಮಾ ಚಿಕ್ಕಿಯೊ ವರಿ ಮಚ್ಚ ರ‍್ಹಯಲ ಜು಼ದಾ ಕರುಸ ತೆ ಮಾರೊ ಪಗಾರ ವ್ಹೈ. <verse eid="GEN 36:32" /><verse number="33" style="v" sid="GEN 36:33" />ಇಮ್ಮ ರ‍್ಹಯಮ ಅಗಲ್ಯಾ ದಿನೊಮಾ ಮಾರಾ ಪಗಾರಾನಾ ಹುತಿ ತುಕನ ಆತಾಮಾ ಮಿ ರ‍್ಹಯಲ ಕ್ಹರಿಕ್ಹು ಮನೆ ಸಾಕ್ಷಿ ಥಾವಸ. ಬಕ್ರಿಯೊಮಾ ಚಿಕ್ಕಿಯೊ ವರಿ ಮಚ್ಚ ರ‍್ಹಯಲ ರ‍್ಹಯುಮ ಬಕ್ರಾಮಾ ಕಾಳಾ ನೈಸೊ ಮಕನ ಮಳ್ಯಾಮ ತೆ ಚೊ಼ರಿ ಕರ‍್ಯೊಸ ಕೈನ ಕೌ ನೈ ಕದ್ಯೊ. <verse eid="GEN 36:33" /><verse number="34" style="v" sid="GEN 36:34" />ತೆ ವಾತೆ ಲಾಬಾನ ಮಿ ತೆ ವಾತೆ ಮಿ ವಪ್ಪಿಲಿದ್ಯೊಸ ತು ಕದಲ ತಿಮ್ಮಜ಼ ಅಪೆ ಕರಿಯೆ ಕದ್ಯೊ. <verse eid="GEN 36:34" /><verse number="35" style="v" sid="GEN 36:35" />ತೆ ದಿನೆ ಲಾಬಾನ ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಬಕ್ರಿಯೊನಾ ಬಚ್ಚಾ ವರಿ ಬಕ್ರಿಯೊ ಕಾಳಾ ಬಕ್ರಾ ಜು಼ದಾ-ಜು಼ದಾ ಕರ‍್ಯೊ. ಲಾಬಾನ ತಿನಾ ಪಟ್ಟಾವೊನೆ ತೆ ಬಕ್ರಾವೊನೆ ದೆಕ್ರಾಣಕಿ ಕರಾನೆ ಕದ್ಯೊ. <verse eid="GEN 36:35" /><verse number="36" style="v" sid="GEN 36:36" />ತಿನಾಹುತಿ ತಿನಾ ಪಟ್ಟಾ ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬಿಜೆಕ ಜ಼ಗಾಕನ ಗಯಾ ತ್ಯುನೆ ತನ್ನ ದಿನ್ನ ಲಕ್ಕಾ ಪ್ರಯಾಣ ಕರ‍್ಯಾ ಯಾಕೊಬ ತ್ಯಾ ರ‍್ಹೈನ ಉಗ್ರಲ ಕ್ಹಾರಾವೊನೆ ದೆಕ್ರಾಣಕಿ ಕರಾನು ಶುರು ಕರ‍್ಯೊ. <verse eid="GEN 36:36" /><verse number="37" style="v" sid="GEN 36:37" />ತಿನಾಹುತಿ ಯಾಕೊಬ ಚಿನಾರ ಬಾದಾಮಿ ಅರ್ಮೊನ ಕವಾನು ಝಾಡೊನಿ ಜ಼ಗಾ ಕಚ್ಚಿಯೊ ಲಾಕ್ಡಿಯೊ ಕೆತ್ತಿನ ಧೊಳಿಯೊ ಕರಿನ. <verse eid="GEN 36:37" /><verse number="38" style="v" sid="GEN 36:38" />ಯಾಕೊಬ ತೆ ಠೊಂಗಿಯೊನೆ ಬಕ್ರಾ ಪಾನಿ ಪಿವಾನಿ ಜ಼಼ಗಾ ಮ್ಹೆಲ್ಯೊ. ಜಾ಼ನವರೊ ಪಾನಿ ಪಿವಾನೆ ಆತಾಮಾ ತೆ ಜ಼ಗಾಕನ ಸಂಗಮ ಕರ್ತಾತಾ. <verse eid="GEN 36:38" /><verse number="39" style="v" sid="GEN 36:39" />ಬಕ್ರಿಯೊ ತೆ ಠೊಂಗಿಯೊನ ಕ್ಹಾಮಿಯೊ ಸಂಗಮ ಕರ್ತಾಮಾ ತ್ಯುನೊಮಾ ಹುಟ್ಟಲ ಕ್ಹಾರಾ ಬಚ್ಚಾ಼ ಚಿಕ್ಕಿಯೊ ವರಿ ಮಚ್ಚಿಯೊ ರ‍್ಹಯಲ ವರಿ ಕಾಳಾ ರಂಗನಾ ವ್ಹತಾ. <verse eid="GEN 36:39" /><verse number="40" style="v" sid="GEN 36:40" />ಯಾಕೊಬ ತೆ ಬಕ್ರಾವೊನಾ ಬಚ್ಚಾ಼ವೊನೆ ಲಾಬಾನಾ ಹಿಂಡಮಾ ಮಳಾಯಾವಾಚಿ ತಿನಾ ವ್ಹೈ ಕೈನ ಜು಼ದಾ ಕರ‍್ಯೊ ವರಿ ಲಾಬಾನನಾ ಬಕ್ರಾವೊನಾ ಮ್ಹೊಡಾ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತೆ ಬಕ್ರಾ ವರಿ ಕಾಳಾ ರ‍್ಹಯಲ ಬಕ್ರಾವೊ ಬಗಲ ಪ್ಹರಾಯೊ. <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />ಲಕ್ಕಾ ಪ್ರಯಾಣ ಕರ‍್ಯಾ ಯಾಕೊಬ ತ್ಯಾ ರ‍್ಹೈನ ಉಗ್ರಲ ಕ್ಹಾರಾವೊನೆ ದೆಕ್ರಾಣಕಿ ಕರಾನು ಶುರು ಕರ‍್ಯೊ <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />ಚ್ಚ ರ‍್ಹಯಲ ಜು಼ದಾ ಕರುಸ ತೆ ಮಾರೊ ಪಗಾರ ವ್ಹೈ. <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />ಮಿ ತಾರಾ ಬಕ್ರಾವೊನಾ ಗುಂಪಮಾ ಗೈನ ಬಕ್ರಾವೊಮಾ ಚಿಕ್ಕಿಯೊ ವರಿ<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />ಯಾಕೊಬತಿನಾ ಬಾನು ಪ್ರವಾಸ ರ‍್ಹಯಲ ಕಾನಾ ದೆಶಮಾ ಜಿವ್ನಾ ಕರಾಡ್ಯೊತೊ. <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />ಯಾಕೊಬನಿ ಕುಟುಂಬನಿ ಚರಿತ್ರ ಆ ವ್ಹೈ. ಯೊಸೆಫ 17 ವರಕ್ಹೊನೆ ಜಾಂಜಿಮಾನ ವ್ಹತೊ. ಬಕ್ರಾ ರಾಜುನು ತಿನು ಕಾಮ ವ್ಹತು. ತಿನಾ ಮ್ಹೊಟಾ ಭಾಯೊನಾ ಕ್ಹಾತೆ ಕದ್ಯಾಮ ಬಿಲ್ಹಾ ವರಿ ಜಿಲ್ಫಾ ತ್ಯುನೆ ಮಲ ಮಾನಾ ಕ್ಹಾತೆ ಯೊಸಫ ಬಕ್ರಾ ಚರಾತೊತೊ ತ್ಯುನೆ ಕುನಬಿ ಕೆಟ್ಟ ಕರ‍್ಯಾಮ ಯೊಸೆಫ ತಿನಾ ಬಾ ಕನ ಕತೊತೊ. <verse eid="GEN 37:2" /><verse number="3" style="v" sid="GEN 37:3" />ಇಸ್ರಾಯೆಲ ಘನ್ನೊ ಗಡಿಯೊ ಥಯಲ ಟೈಮ್ಮಾ ಯೊಸೆಫ ಹುಟ್ಟಲ ಹುತಿ ಇಸ್ರಾಯೆಲ ತಿನಾ ಬಿಜಾ಼ ದಿಕ್ರಾವೊತಿಬಿ ಜಾ಼ಸ್ತಿ ಯೊಸೆಫನೆ ಮಯಾ ಕರ‍್ಯೊ. ಯಾಕೊಬ ತಿನಾ ದಿಕ್ರಾನೆ ಚೊ಼ಕು ರ‍್ಹಯಲ ಮ್ಹೊಟು ಅಂಗ್ಡು ಕರಿನೆ ದಿದ್ಯೊತೊ. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />ತ್ಯುನಾ ಬಾನೆ ಯೊಸೆಫರ ಘನ್ನಿ ಮಯಾ ರ‍್ಹಯಲ ದೆಕಲ ಯೊಸೆಪನೆ ದ್ವೆಶ ಕರಾನು ಸುರು ಕರ‍್ಯಾ ತಿನಾ ಕ್ಹಾತೆ ಸಿದಾ ಬೊಲ್ತಾ ನ್ಹೊತಾ.<verse eid="GEN 37:4" /></para>
  <para style="s">ಯೊಸೆಫನಾ ಕ್ಹಪ್ನೊ</para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />ಯಕ್ಕ ದಿನ್ನ ಯೊಸೆಫ ಖಾಸ ರ‍್ಹಯಲ ಕ್ಹಪನ ದೆಕ್ಯೊ. ಯೊಸೆಫ ದೆಕಲ ಕ್ಹಪನ ತಿನಾ ಮ್ಹೊಟಾ ಭಾಯೊನೆ ಕತಾಮಾ ತ್ಯುನೆ ತಿನೆ ವರಿ ಜಾಸ್ತಿ ದ್ವೆಶ ಕರ‍್ಯಾ. <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />ಯೊಸೆಫ ತ್ಯುನೊನೆ ಮನೆ ಯಕ್ಕ ಕ್ಹಪನ ಪಡ್ಯುಸ, ತೆ ಮಿ ತುಮೊನೆ ಕೌಸ. <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />ಅಪೆ ಕ್ಹಾರಾ ಖೆತರಮಾ ಘೌನಾ ಭಾರಾ ಭಾಂದಾಡ್ಯಾತಾ ತೆಳಾಮಾ ಮಾರೊ ಭಾರೊ ಉಟಿನ ಹುಬ್ರೈನ ಮಾರಾ ಭಾರಾನಾ ಸುತ್ತೆ ತುಮಾರಾ ಕ್ಹಾರಾ ಭಾರಾ ಉಟಿನ ಮಾರಾ ಭಾರಾನೆ ಅಡ್ಡ ಪಡ್ಯಾ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 37:7" /><verse number="8" style="v" sid="GEN 37:8" />ತ್ಯುನಾ ಭಾಯೊ ತು ರಾಜೊ಼ ಥೈನ ಹಮೊನೆ ಆಳಸಿ ಕೈನ ಅರ್ಥ ವ್ಹೈ ಕೈನ ತಾರಿ ವಿಚಾರ ವ್ಹೈ ಸು? ಕೈನ ಪ್ರಶ್ನೆ ಕರಿನ ತೆ ಕ್ಹಪನನಾ ಹುತಿ ತ್ಯುನೆ ತಿನೆ ವರಿ ಘನ್ನಾ ದ್ವೆಶ ಕರ‍್ಯಾ. <verse eid="GEN 37:8" /><verse number="9" style="v" sid="GEN 37:9" />ತೆ ಥಯಲ್ಪರ ಯೊಸೆಫನೆ ಬಿಜೆಕ ಕ್ಹಪನ ಪಡ್ಯು ಎ ಕ್ಹಪನನಾ ಹುತಿ ತಿನಾ ಭಾಯೊಕನ ಕದ್ಯೊ. ಯೊಸೆಫ ತ್ಯುನೊನೆ ಮನೆ ಬಜೆಕ ಕ್ಹಪನ ಪಡ್ಯು ಸುರ‍್ಯೊ ಚ಼ಂದಪ್ಪಾ ವರಿ 11 ಚಿಕ್ಕಿಯೊ ಮನೆ ಅಡ್ಡ ಪಡಾನು ಮನೆ ದಿಕ್ಹ್ಯು ಕೈನ ಕದ್ಯೊ, <verse eid="GEN 37:9" /><verse number="10" style="v" sid="GEN 37:10" />ಯೊಸೆಫ ಎ ಕ್ಹಪನನಾ ಹುತಿ ತಿನಾ ಬಾಕನ ಬಿ ಕದ್ಯೊ. ವರಿ ತಿನೊ ಬಾ ತಿನೆ ಭುಚ್ಕಾಡಿನೆ ಎ ಕೆವು ಕ್ಹಪನ ವ್ಹೈ? ಮಿ ತಾರಿ ಯಾಬಿ ವರಿ ತಾರಾ ಭಾಯೊ ತುನೆ ಅಡ್ಡ ಪಡಿಯೆಸ ಕೈನ ಬರೊಕ್ಹೊ ಕರ್ಸಿ ಸು? ಕೈನ ಪುಚ್ಯೊ. <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />ಯೊಸೆಫನಾ ಭಾಯೊನೆ ತಿಪರ ಸಂಗಟ ವರಿ ನಕ್ಕರ ಜಾಸ್ತಿ ಥೈ ತೆ ನೈಸೊ ಯೊಸೆಫನನೊ ಬಾ ತೆ ಕ್ಹಪನೊನಾ ಹುತಿ ಘಾಬ್ರೊ ಥೈನ ವಿಚಾರ ಕರಾಮಾ ಪಡಿ ಗಯೊ. <verse eid="GEN 37:11" /><verse number="12" style="v" sid="GEN 37:12" />ಯಕ್ಕ ದಿನ್ನ ಯೊಸೆಫನಾ ಭಾಯೊ ತ್ಯುನಾ ಬಾನಾ ಬಕ್ರಾ ಕೈದಾನಾ ಹುತಿ ಶೆಕೆಮನೆ ಗಯಾ. <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />ಇಸ್ರಾಯೆಲ ಯೊಸೆಫನೆ ಶೆಕೆಮನೆ ಜಾ಼ ತಾರಾ ಭಾಯೊ ಮಾರಾ ಬಕ್ರಾವೊನೆ ಚ಼ರಾವಾಡಾಸ. ಕೈನ ಕದ್ಯೊ ಯೊಸೆಫ ಥಯು ಜೌ಼ಸ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 37:13" /><verse number="14" style="v" sid="GEN 37:14" />ಇಸ್ರಾಯೆಲ ತಾರಾ ಭಾಯೊನೆ ವರಿ ಬಕ್ರಾವೊನು ಕಿಮ ಛೆ ಕೈನ ಪುಚ್ಹಿನ ಐನ ಮನೆ ಕೆ. ಕೈನ ತಿನೆ ಹೆಬ್ರೊನನಿ ಕಣಿತೊ ಶೆಕೆಮ್ನೆ ವಳಾಯೊ. <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />ಶೆಕೆಮ್ನೆ ವಾಟ ತಪ್ಪಿನ ಖೆತ್ರೊಮಾ ಭಟಕ್ತೊ ರ‍್ಹತಾಮಾ ತಿನೆ ದೆಕಲ ಯಕ್ಲೊ ಸು ಹುಡ್ಕಾಡ್ಯೊಸ? ಕೈ ಪುಚ್ಯೊ. <verse eid="GEN 37:15" /><verse number="16" style="v" sid="GEN 37:16" />ಯೊಸೆಫ ಮಾರಾ ಭಾಯೊನೆ ಹುಡ್ಕಾಡ್ಯೊಸ.ತಿವ್ನೆ ಬಕ್ರಾ ಕಿಜಾ಼ ಚ಼ರಾವಾಡ್ಯಾಸ ಕೈನ ಪುಚ್ಯೊ. <verse eid="GEN 37:16" /><verse number="17" style="v" sid="GEN 37:17" />ತಿನಾಹುತಿ ತೆ, ತ್ಯುನೆ ನ್ಹ್ಯಾಂತಾ ಗೈಪಡ್ಯಾ. ದೊತಾನನೆ ಗೈಯೆ ಕೈನ ತ್ಯುನೆ ಬೊಲ್ಲಿವಾನು ಮಿ ಐಕ್ಯೊ. ಕೈನ ಕದ್ಯೊ. ತಿನಾಹುತಿ ಯೊಸೆಫ ತ್ಯುನೊನೆ ಹುಡಕ್ತೊ ಗೈನ ತ್ಯುನೊನೆ ದೊತಾನಮಾ ದೆಕ್ಯೊ. <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />ಯೊಸೆಫನೆ ದುರ್ತಾ ದೆಕಿನ ತಿನಾ ಭಾಯೊ ತಿನೆ ಖಲಾಸ ಕರಾನೆ ವಿಚಾರ ಕರ‍್ಯಾ. <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />ತ್ಯುನೆ ಯಕ್ನಾ ಯಕ್ಕ ದೆಕೊ ಐಲೊ ಕ್ಹಪ್ನೊ ದೆಕಾಲೊ ಯೊಸೆಫ ಆವಾಡ್ಯೊಸ. <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />ತಿನೆ ಖಲಾಸರಾನೆ ಎಜ಼ ಕರೆಟ್ಟ ಟೈಮ ವ್ಹೈ. ತಿನೆ ಖಲಾಸ ಕರಿನ ಪಾನಿ ನೈಸೊ ಇರಮಾ ನಾಕಿನ ಕ್ರುರ ರ‍್ಹಯಲ ಜಾ಼ನ್ವರ ಯಕ್ಕ ತಿನೆ ಖೈಪಾಡ್ಯುಸ ಕೈನ ಅಪ್ನಾ ಬಾಮೆ ಕೈಯೆ ತೆಳಾಮಾ ತಿನಾ ಕ್ಹಪ್ನೊ ಕ್ಹಾರಾ ಕಿಮ ಖರಿ ಥಾವಸ ಕೈನ ದೆಕಿಯೆ ಕೈನ ಬೊಲ್ಲಿದ್ಯಾ. <verse eid="GEN 37:20" /><verse number="21" style="v" sid="GEN 37:21" />ತೆ ಥಯಲ್ಪರ ತೆ ಯಕ್ಕ ಚೊ಼ಕ್ರಿ ಜ಼ನ್ನಿನ ತಿನೆ ದಿನಾ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />ಪಾಚಲ್ತೊ ಕ್ಹುದಾ ರಾಹೆಳನೆ ಶೆ ಕರಿನ ತಿನಿ ಪ್ರಾಥನಾ ಐಕಿನ ತಿನೆ ಬಚ್ಚಾ ಥಾವಾ ವರಕ್ಹು ಕರ‍್ಯೊ. <verse eid="GEN 37:22" /><verse number="23" style="v" sid="GEN 37:23" />ತೆ ಪೆಟೆ ರ‍್ಹೈನ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿನ, ಕ್ಹುದಾ ಮಪರ ರ‍್ಹಯಲ ಕಲಂಕ ಕಾಡಿಪಾಡ್ಯೊ. <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />ತೆ ನೈ ತೆ ಯಹೊವಾ ಮನೆ ವರಿ ಯಕ್ಕ ಪಟ್ಟೊ ದಿದ್ಯೊಸ. ಕೈನ ತಿನು ನಾಮ ಯೊಸೆಫ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ.<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />ಯೊಸೆಫ ಹುಟ್ಟಲ್ಪರ ಯಾಕೊಬ ಲಾಬಾನನೆ ಮಿ ಹಮ್ನಾ ಮಾರಾ ಸ್ವಂತ ಗರೆ ಜಾ಼ವಾನೆ ಅನುಮತಿ ದೆ, <verse eid="GEN 37:25" /><verse number="26" style="v" sid="GEN 37:26" />ಮಾರಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಬಚ್ಚಾ಼ವೊನೆ ಮನೆ ದೆ ಮಿ ತಾರಿ ಸೆವೆ ಕರಿನ ತ್ಯುನೊನೆ ಗಳಸಿ ಲಿದ್ಯೊಸ. ಮಿ ತುನೆ ಚೊ಼ಕಿ ಸೆವೆ ಕರ‍್ಯೊಸ ಕವಾನು ತುನೆ ಗ್ವತ್ತ ಛೆ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />ಲಾಬಾನ ತಿನೆ ಮಿ ಕವಾನು ಐಕ ಯಹೊವಾ ತಾರಿಕ್ಹು ಮನ ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />ಕೆ ಮಿ ತುನೆ ಕೆಕ್ಲೊ ಪಗಾರ ದ್ಯು? ತು ಕದಲ ತೆಕ್ಲು ದ್ಯುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 37:28" /><verse number="29" style="v" sid="GEN 37:29" />ಯಾಕೊಬ ಮಿ ತಾರಾ ಹುತಿ ತ್ರಾಸ ಖೈನ ಕಾಮ ಕರ‍್ಯೊಸ ಕವಾನು ತುನೆ ಗ್ವತ್ತ ಛೆ. ಮಿ ತಾರಾ ಬಕ್ರಾವೊನೆ ದೆಕ್ರಾಣಕಿ ಕರಲ ಹುತಿ ತೆ ಜಾಸ್ತಿ ಥಯಾಸ. <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />ಮಿ ಆತಾಮಾ ಬಕ್ರಾ ದಕ್ಹಾಜ಼ ವ್ಹತಾ. ಹಮ್ನಾತೊ ತುಕನ ಘನ್ನಾ ಬಕ್ರಾ ಛೆ. ಮಿ ತಾರಾಹುತಿ ಕರಲ ಕ್ಹಾರಾನೆ ಯಹೊವಾ ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ. ಮಿ ಖುದ್ದನಾ ಹುತಿ ಕಾಮ ಕರಾನು ಟೈಮ ಛೆ ಮಾರಾ ಸ್ವಂತ ಘರೆ ಜಾ಼ವಾನೆ ಟೈಮ ಛೆ ಕದ್ಯೊ. <verse eid="GEN 37:30" /><verse number="31" style="v" sid="GEN 37:31" />ಲಾಬಾನ ತಿಮ ರ‍್ಹಯೊಮ ಮಿ ತುನೆ ಸು ದ್ಯು ಕೆ ಕೈನ ಪುಚ್ಯೊ. ಯಾಕೊಬ ತು ಮನೆ ಸುಜ಼ ದ್ಯು ನಕೊ ತು ಮಾರಾಹುತಿ ಯಕ್ಕ ಕಾಮ ಕರ‍್ಯೊಮ ಬಸ್ಸ, ಪ್ಹರಿನ ಮಿ ತಾರಾ ಬಕ್ರಾವೊನೆ ರಾಕುಸ. <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />ತೆ ಸುವೈ ಕದ್ಯಾಮ ಹಮ್ನಾಜ಼ ಮಿ ತಾರಾ ಬಕ್ರಾವೊನಾ ಗುಂಪಮಾ ಗೈನ ಬಕ್ರಾವೊಮಾ ಚಿಕ್ಕಿಯೊ ವರಿ ಮಚ್ಚ ರ‍್ಹಯಲ ಬಕ್ರಾವೊಮಾ ಕಾಳಾ ರ‍್ಹಯಲ ಬಕ್ರಿಯೊಮಾ ಚಿಕ್ಕಿಯೊ ವರಿ ಮಚ್ಚ ರ‍್ಹಯಲ ಜು಼ದಾ ಕರುಸ ತೆ ಮಾರೊ ಪಗಾರ ವ್ಹೈ. <verse eid="GEN 37:32" /><verse number="33" style="v" sid="GEN 37:33" />ಇಮ್ಮ ರ‍್ಹಯಮ ಅಗಲ್ಯಾ ದಿನೊಮಾ ಮಾರಾ ಪಗಾರಾನಾ ಹುತಿ ತುಕನ ಆತಾಮಾ ಮಿ ರ‍್ಹಯಲ ಕ್ಹರಿಕ್ಹು ಮನೆ ಸಾಕ್ಷಿ ಥಾವಸ. ಬಕ್ರಿಯೊಮಾ ಚಿಕ್ಕಿಯೊ ವರಿ ಮಚ್ಚ ರ‍್ಹಯಲ ರ‍್ಹಯುಮ ಬಕ್ರಾಮಾ ಕಾಳಾ ನೈಸೊ ಮಕನ ಮಳ್ಯಾಮ ತೆ ಚೊ಼ರಿ ಕರ‍್ಯೊಸ ಕೈನ ಕೌ ನೈ ಕದ್ಯೊ. <verse eid="GEN 37:33" /><verse number="34" style="v" sid="GEN 37:34" />ತೆ ವಾತೆ ಲಾಬಾನ ಮಿ ತೆ ವಾತೆ ಮಿ ವಪ್ಪಿಲಿದ್ಯೊಸ ತು ಕದಲ ತಿಮ್ಮಜ಼ ಅಪೆ ಕರಿಯೆ ಕದ್ಯೊ. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />ತೆ ದಿನೆ ಲಾಬಾನ ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಬಕ್ರಿಯೊನಾ ಬಚ್ಚಾ ವರಿ ಬಕ್ರಿಯೊ ಕಾಳಾ ಬಕ್ರಾ ಜು಼ದಾ-ಜು಼ದಾ ಕರ‍್ಯೊ. ಲಾಬಾನ ತಿನಾ ಪಟ್ಟಾವೊನೆ ತೆ ಬಕ್ರಾವೊನೆ ದೆಕ್ರಾಣಕಿ ಕರಾನೆ ಕದ್ಯೊ. <verse eid="GEN 37:35" /><verse number="36" style="v" sid="GEN 37:36" />ತಿನಾಹುತಿ ತಿನಾ ಪಟ್ಟಾ ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬಿಜೆಕ ಜ಼ಗಾಕನ ಗಯಾ ತ್ಯುನೆ ತನ್ನ ದಿನ್ನ ಲಕ್ಕಾ ಪ್ರಯಾಣ ಕರ‍್ಯಾ ಯಾಕೊಬ ತ್ಯಾ ರ‍್ಹೈನ ಉಗ್ರಲ ಕ್ಹಾರಾವೊನೆ ದೆಕ್ರಾಣಕಿ ಕರಾನು ಶುರು ಕರ‍್ಯೊ.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">ಯೆಹುದಾ ವರಿ ತಾಮಾರ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />ಯಾಕೊಬತಿನಾ ಬಾನು ಪ್ರವಾಸ ರ‍್ಹಯಲ ಕಾನಾ ದೆಶಮಾ ಜಿವ್ನಾ ಕರಾಡ್ಯೊತೊ. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />ಯಾಕೊಬನಿ ಕುಟುಂಬನಿ ಚರಿತ್ರ ಆ ವ್ಹೈ. ಯೊಸೆಫ 17 ವರಕ್ಹೊನೆ ಜಾಂಜಿಮಾನ ವ್ಹತೊ. ಬಕ್ರಾ ರಾಜುನು ತಿನು ಕಾಮ ವ್ಹತು. ತಿನಾ ಮ್ಹೊಟಾ ಭಾಯೊನಾ ಕ್ಹಾತೆ ಕದ್ಯಾಮ ಬಿಲ್ಹಾ ವರಿ ಜಿಲ್ಫಾ ತ್ಯುನೆ ಮಲ ಮಾನಾ ಕ್ಹಾತೆ ಯೊಸಫ ಬಕ್ರಾ ಚರಾತೊತೊ ತ್ಯುನೆ ಕುನಬಿ ಕೆಟ್ಟ ಕರ‍್ಯಾಮ ಯೊಸೆಫ ತಿನಾ ಬಾ ಕನ ಕತೊತೊ. ಇಸ್ರಾಯೆಲ ಘನ್ನೊ ಗಡಿಯೊ ಥಯಲ ಟೈಮ್ಮಾ ಯೊಸೆಫ ಹುಟ್ಟಲ ಹುತಿ ಇಸ್ರಾಯೆಲ ತಿನಾ ಬಿಜಾ಼ ದಿಕ್ರಾವೊತಿಬಿ ಜಾ಼ಸ್ತಿ ಯೊಸೆಫನೆ ಮಯಾ ಕರ‍್ಯೊ. ಯಾಕೊಬ ತಿನಾ ದಿಕ್ರಾನೆ ಚೊ಼ಕು ರ‍್ಹಯಲ ಮ್ಹೊಟು ಅಂಗ್ಡು ಕರಿನೆ ದಿದ್ಯೊತೊ. <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />ವರಿ ಇಷ್ಮಾಯರಲನಿ ದಿಕ್ರಿ ಥಯಲ ನೆಬಾಯೊತನಿ ನ್ಹಾನಿ ಭೆನ ಥಯಲ ಬಾಸೆಮತ ಇವ್ಯುನೊನೆ ಹಿವಾ ಕರಿಲಿದ್ಯೊತೊ. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />ಆದಾಳ ಎಸಾವನೆ ಎಲಿಫಜನೆ ಜ಼ನ್ನಿ. ಬಾಸೆಮತ ರೆಗುವೆಲನೆ ಜ಼ನ್ನಿ. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />ಒಹೊಲಿಬಾಮ ಯೆಗೊಷನೆ ಯಳಾಮನೆ, ಕೊರಹನನೆ ಜ಼ನ್ನಿ. ಕಾನಾನ ದೆಶಮಾ ಎಸಾವನೆ ಹುಟ್ಟಲ ಬಚ್ಚಾ ಇವ್ಯುನೆಜ಼ ವ್ಹೈ. <verse eid="GEN 38:5" /><verse number="6" style="v" sid="GEN 38:6" />ತೆ ಥಯಲ್ಪರ ಎಸಾವ ತಿನಾ ಬಾಕ್ಡಿಯೊನೆ, ದಿಕ್ರಾವೊನೆ, ತಿನಾ ಘರೆ ಮಳಲ ಕ್ಹಾರಾ ಸೆವಕರೊನೆ, ತಿನೆ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಪಶುಪ್ರಾಣಿಯೊನಾ ಹಿಂಡೊನೆ ಕಾನಾನ ದೆಶಮಾ ಕಮಾಯಲ ಆಸ್ತಿ ಪುರಾ ಲಿನ ತಿನೊ ನ್ಹಾನೊ ಭೈ ಥಯಲ ಯಾಕೊಬ ಕಂತೊ ಬಿಜ಼ಾ ದೆಶೆ ಗೈಪಡ್ಯೊ. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />ತ್ಯುನಿ ಆಸ್ತಿ ಜಾಸ್ತಿ ರ‍್ಹಯಲಕ್ಹು ತ್ಯುನೆ ಭಂಬೆ ಜ಼ನಾ ಯಕ್ಕಜ಼ ಜ಼ಗಾಮಾ ರ‍್ಹವಾನೆ ಸಾದ್ಯ ನ್ಹೊತು. ತ್ಯುನೆ ಪಶು ಪ್ರಾಣಿಯೊ ಘನ್ನಾ ರ‍್ಹಯಲಕ್ಹು ತ್ಯುನೆ ಪ್ರವಾಸ ಥಯಲ ದೆಶ ತ್ಯುನೊನೆ ಬಸ ಥಯುಜ಼ ನೈ. <verse eid="GEN 38:7" /><verse number="8" style="v" sid="GEN 38:8" />ಇಮ್ಮ ಎಸಾವ ಸೆಯಿರ ಡೊಂಗರನಾ ಸಿಮೆನೆ ಗೈನ ತ್ಯಾಜ಼ ರ್ಹೈ ಗಯೊತೊ. ಎಸಾವ ಕದ್ಯಾಮ ಎದೊಮ ವ್ಹೈ. <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />ಸೆಯಿರ ಡೊಂಗರನಾಸಿಮೆಮಾ ರ್ಹಹಯಲ ಎದೊಮ್ಯರೊನೊ ಮುಲ ಪುರುಶ ಥಯಲ ಎಸಾವನಾ ವಂಶನಿ ಚರಿತ್ರೆ: <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />ಎಸಾವನಾ ಬಚ್ಚಾವೊನಾ ನಾಮೊ ಕಯಾ ವ್ಹೈ ಕದ್ಯಾಮ: ಎಲಿಫಜನ, ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಆದಾ ಕವಾಲಿನೊ ದಿಕ್ರೊ ವ್ಹೈ. ರೆಗುವೆಲ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಬಾಸೆಮತನೊ ದಿಕ್ರೊ ವ್ಹೈ. <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />ಎಲಿಫಜನಾ ಬಚ್ಚಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ತೆಮಾನ, ಓಮಾರ, ಚೆಫೊ, ಗತಾಮ, ಕೆನೆಜ, <verse eid="GEN 38:11" /><verse number="12" style="v" sid="GEN 38:12" />ತಿಮ್ನ ಕವಾಲಿ ಎಸಾವನೊ ದಿಕ್ರೊ ಥಯಲ ಎಲಿಫಜನೆ ಫಸ್ಟನಿ ಬೈಕೊ ಥೈತಿ ತೆ ತಿನೆ ಅಮಾಲೆಕನೆ ಜ಼ನ್ನಿ.ಇವ್ಯುನೆಜ಼ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಆದಾ ಕವಾಲಿನಾ ಬಚ್ಚಾ ವ್ಹೈ. <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />ರೆಗುವೆಲನಾ ದಿಕ್ರಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ನಹತ, ಜೆರಹ, ಶಮ್ಮಾ ಮಿಜ್ಜಾ ಇವ್ಯುನೆ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಬಾಸೆಮತನಾ ದಿಕ್ರಾ ವ್ಹೈ. <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಸಿಬಿಯೊನನಿ ದಿಕ್ರಿ ಥಯಲ ಒಹೊಲಿಬಾಮನಾ ಬಚ್ಚಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ಯೆಗೊಷವಂಶಸ್ಥೊನೆ, ಯಳಾಮ ಕೊರಹ ಇವ್ಯುನೊನೆ ಜ಼ನ್ನಿ. <verse eid="GEN 38:14" /><verse number="15" style="v" sid="GEN 38:15" />ಎಸಾವನಾ ದಿಕ್ರಾವೊನಾ ಕುಲಪತಿಯೊ ಕುನ್ನ ವಹೈ ಕದ್ಯಾಮ: ಎಸಾವನೊ ಮ್ಹೊಟೊ ದಿಕ್ರೊ ಥಯಲ ಎಲಿಫಜರತಾ ಹುಟ್ಟಲವಾಲಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ತೆಮಾನ, ಓಮಾರ, ಚೆಫೊ, ಕೆನೆಜ, <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />ಕೊರಹ, ಗತಾಮ, ಅಮಾಲೆಕ, ಇವ್ಯುನೆಜ಼ ಎ ಕುಲಪತಿಯೊ ವ್ಹೈ ಎದೊಮ್ಯರೊನಾ ದೆಶಮಾ ರ‍್ಹಯಲ ಎಲಿಫಜರತಾ ಆಯೆಲವಾಲಾ ವ್ಹೈ. ಇವ್ಯುನೆ ಆದಾಳನಾ ನಾತ್ನಾ ವ್ಹೈ. <verse eid="GEN 38:16" /><verse number="17" style="v" sid="GEN 38:17" />ಎಸಾವನೊ ದಿಕ್ರೊ ಥಯಲ ರೆಗುವೆಲನೆ ಹುಟ್ಟಲವಾಲಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ನಹತ, ಜೆರಹ, ಶಮ್ಮಾ, ಮಿಜ್ಜಾ ಕವಾನಾ ಕುಲಪತಿಯೊ ಹುಟ್ಟ್ಯಾ. ಇವ್ಯುನೆ ಎದೊಮ್ಯರೊನಾ ದೆಶಮಾ ರ‍್ಹಯಲ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಬಾಸೆಮತನೆ ಹುಟ್ಟಲ ನಾತ್ನಾ ವ್ಹೈ. <verse eid="GEN 38:17" /><verse number="18" style="v" sid="GEN 38:18" />ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಒಹೊಲಿಬಾಮನಿ ದಿಕ್ರಿ ಥಯಲ ಅನಾಳನಿ ಸಂತಾನನಾ ಕುಲಪತಿಯೊ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ಯೆಗೊಷ, ಯಳಾಮ, ವರಿ ಕೊರಹ. ಇವ್ಯುನೆಜ಼ ಅನಾಹನಿ ದಿಕ್ರಿ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಒಹೊಲಿಬಾಮನಾ ಸಂತಾನವಾಲಾ ವ್ಹೈ. <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />ಎದೊಮ ಕವೈಲಿವಾಲೊ ಎಸಾವತಾ ಹುಟ್ಟಲವಾಲಲಾ ಖಾಂದಾನೆ ಇವ್ಯುನೆಜ಼ ಕುಲಪತಿಯೊ ವ್ಹೈ. <verse eid="GEN 38:19" /><verse number="20" style="v" sid="GEN 38:20" />ಲೆಯಳ ಕ್ಹುದಾ ಮನೆ ಚೊ಼ಕು ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ ಮೆ ಮಾರಾ ಮಾಟಿನೆ ಛೆವಾ ಪಟ್ಟಾ ಜ಼ನ್ನಿನ ದಿದಿಲಕ್ಹು ತೆ ಮಾರಾ ಕ್ಹಾತೆಜ಼ ಜಿವ್ನಾ ಕರಸ ಕೈನ ತೆ ಪಟ್ಟಾನೆ ಜೆಬುಲೊನ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />ತೆ ಥಯಲ್ಪರ ತೆ ಯಕ್ಕ ಚೊ಼ಕ್ರಿ ಜ಼ನ್ನಿನ ತಿನೆ ದಿನಾ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 38:21" /><verse number="22" style="v" sid="GEN 38:22" />ಪಾಚಲ್ತೊ ಕ್ಹುದಾ ರಾಹೆಳನೆ ಶೆ ಕರಿನ ತಿನಿ ಪ್ರಾಥನಾ ಐಕಿನ ತಿನೆ ಬಚ್ಚಾ ಥಾವಾ ವರಕ್ಹು ಕರ‍್ಯೊ. <verse eid="GEN 38:22" /><verse number="23" style="v" sid="GEN 38:23" />ತೆ ಪೆಟೆ ರ‍್ಹೈನ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿನ, ಕ್ಹುದಾ ಮಪರ ರ‍್ಹಯಲ ಕಲಂಕ ಕಾಡಿಪಾಡ್ಯೊ. <verse eid="GEN 38:23" /><verse number="24" style="v" sid="GEN 38:24" />ತೆ ನೈ ತೆ ಯೆಹೊವ ಮನೆ ವರಿ ಯಕ್ಕ ಪಟ್ಟೊ ದಿದ್ಯೊಸ. ಕೈನ ತಿನು ನಾಮ ಯೊಸೆಫ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ.<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />ಯೊಸೆಫ ಹುಟ್ಟಲ್ಪರ ಯಾಕೊಬ ಲಾಬಾನನೆ ಮಿ ಹಮ್ನಾ ಮಾರಾ ಸ್ವಂತ ಗರೆ ಜಾ಼ವಾನೆ ಅನುಮತಿ ದೆ, <verse eid="GEN 38:25" /><verse number="26" style="v" sid="GEN 38:26" />ಮಾರಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಬಚ್ಚಾ಼ವೊನೆ ಮನೆ ದೆ ಮಿ ತಾರಿ ಸೆವೆ ಕರಿನ ತ್ಯುನೊನೆ ಗಳಸಿ ಲಿದ್ಯೊಸ. ಮಿ ತುನೆ ಚೊ಼ಕಿ ಸೆವೆ ಕರ‍್ಯೊಸ ಕವಾನು ತುನೆ ಗ್ವತ್ತ ಛೆ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 38:26" /><verse number="27" style="v" sid="GEN 38:27" />ಲಾಬಾನ ತಿನೆ ಮಿ ಕವಾನು ಐಕ ಯಹೊವಾ ತಾರಿಕ್ಹು ಮನ ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />ಕೆ ಮಿ ತುನೆ ಕೆಕ್ಲೊ ಪಗಾರ ದ್ಯು? ತು ಕದಲ ತೆಕ್ಲು ದ್ಯುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />ಯಾಕೊಬ ಮಿ ತಾರಾ ಹುತಿ ತ್ರಾಸ ಖೈನ ಕಾಮ ಕರ‍್ಯೊಸ ಕವಾನು ತುನೆ ಗ್ವತ್ತ ಛೆ. ಮಿ ತಾರಾ ಬಕ್ರಾವೊನೆ ದೆಕ್ರಾಣಕಿ ಕರಲ ಹುತಿ ತೆ ಜಾಸ್ತಿ ಥಯಾಸ. <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />ಮಿ ಆತಾಮಾ ಬಕ್ರಾ ದಕ್ಹಾಜ಼ ವ್ಹತಾ. ಹಮ್ನಾತೊ ತುಕನ ಘನ್ನಾ ಬಕ್ರಾ ಛೆ. ಮಿ ತಾರಾಹುತಿ ಕರಲ ಕ್ಹಾರಾನೆ ಯಹೊವಾ ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ. ಮಿ ಖುದ್ದನಾ ಹುತಿ ಕಾಮ ಕರಾನು ಟೈಮ ಛೆ ಮಾರಾ ಸ್ವಂತ ಘರೆ ಜಾ಼ವಾನೆ ಟೈಮ ಛೆ ಕದ್ಯೊ.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">ಯೊಸೆಫನಿ ವರಿ ಫೊಟಿಪರನಿ ಬೈಕೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />ತ್ಯುನಿ ಆಸ್ತಿ ಜಾಸ್ತಿ ರ‍್ಹಯಲಕ್ಹು ತ್ಯುನೆ ಭಂಬೆ ಜ಼ನಾ ಯಕ್ಕಜ಼ ಜ಼ಗಾಮಾ ರ‍್ಹವಾನೆ ಸಾದ್ಯ ನ್ಹೊತು. ತ್ಯುನೆ ಪಶು ಪ್ರಾಣಿಯೊ ಘನ್ನಾ ರ‍್ಹಯಲಕ <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" />ಮ್ನ ಕವಾಲಿ ಎಸಾವನೊ ದಿಕ್ರೊ ಥಯಲ ಎಲಿಫಜನೆ ಫಸ್ಟನಿ ಬೈಕೊ ಥೈತಿ ತೆ ತಿನೆ <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />ವರಿ ಇಷ್ಮಾಯರಲನಿ ದಿಕ್ರಿ ಥಯಲ ನೆಬಾಯೊತನಿ ನ್ಹಾನಿ ಭೆನ ಥಯಲ ಬಾಸೆಮತ ಇವ್ಯುನೊನೆ ಹಿವಾ ಕರಿಲಿದ್ಯೊತೊ. <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />ಆದಾಳ ಎಸಾವನೆ ಎಲಿಫಜನೆ ಜ಼ನ್ನಿ. ಬಾಸೆಮತ ರೆಗುವೆಲನೆ ಜ಼ನ್ನಿ. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />ಒಹೊಲಿಬಾಮ ಯೆಗೊಷನೆ ಯಳಾಮನೆ, ಕೊರಹನನೆ ಜ಼ನ್ನಿ. ಕಾನಾನ ದೆಶಮಾ ಎಸಾವನೆ ಹುಟ್ಟಲ ಬಚ್ಚಾ ಇವ್ಯುನೆಜ಼ ವ್ಹೈ. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />ತೆ ಥಯಲ್ಪರ ಎಸಾವ ತಿನಾ ಬಾಕ್ಡಿಯೊನೆ, ದಿಕ್ರಾವೊನೆ, ತಿನಾ ಘರೆ ಮಳಲ ಕ್ಹಾರಾ ಸೆವಕರೊನೆ, ತಿನೆ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಪಶುಪ್ರಾಣಿಯೊನಾ ಹಿಂಡೊನೆ ಕಾನಾನ ದೆಶಮಾ ಕಮಾಯಲ ಆಸ್ತಿ ಪುರಾ ಲಿನ ತಿನೊ ನ್ಹಾನೊ ಭೈ ಥಯಲ ಯಾಕೊಬ ಕಂತೊ ಬಿಜ಼ಾ ದೆಶೆ ಗೈಪಡ್ಯೊ. <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />ತ್ಯುನಿ ಆಸ್ತಿ ಜಾಸ್ತಿ ರ‍್ಹಯಲಕ್ಹು ತ್ಯುನೆ ಭಂಬೆ ಜ಼ನಾ ಯಕ್ಕಜ಼ ಜ಼ಗಾಮಾ ರ‍್ಹವಾನೆ ಸಾದ್ಯ ನ್ಹೊತು. ತ್ಯುನೆ ಪಶು ಪ್ರಾಣಿಯೊ ಘನ್ನಾ ರ‍್ಹಯಲಕ್ಹು ತ್ಯುನೆ ಪ್ರವಾಸ ಥಯಲ ದೆಶ ತ್ಯುನೊನೆ ಬಸ ಥಯುಜ಼ ನೈ. <verse eid="GEN 39:7" /><verse number="8" style="v" sid="GEN 39:8" />ಇಮ್ಮ ಎಸಾವ ಸೆಯಿರ ಡೊಂಗರನಾ ಸಿಮೆನೆ ಗೈನ ತ್ಯಾಜ಼ ರ್ಹೈ ಗಯೊತೊ. ಎಸಾವ ಕದ್ಯಾಮ ಎದೊಮ ವ್ಹೈ. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />ಸೆಯಿರ ಡೊಂಗರನಾಸಿಮೆಮಾ ರ್ಹಹಯಲ ಎದೊಮ್ಯರೊನೊ ಮುಲ ಪುರುಶ ಥಯಲ ಎಸಾವನಾ ವಂಶನಿ ಚರಿತ್ರೆ: <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />ಎಸಾವನಾ ಬಚ್ಚಾವೊನಾ ನಾಮೊ ಕಯಾ ವ್ಹೈ ಕದ್ಯಾಮ: ಎಲಿಫಜನ, ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಆದಾ ಕವಾಲಿನೊ ದಿಕ್ರೊ ವ್ಹೈ. ರೆಗುವೆಲ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಬಾಸೆಮತನೊ ದಿಕ್ರೊ ವ್ಹೈ. <verse eid="GEN 39:10" /><verse number="11" style="v" sid="GEN 39:11" />ಎಲಿಫಜನಾ ಬಚ್ಚಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ತೆಮಾನ, ಓಮಾರ, ಚೆಫೊ, ಗತಾಮ, ಕೆನೆಜ, <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />ತಿಮ್ನ ಕವಾಲಿ ಎಸಾವನೊ ದಿಕ್ರೊ ಥಯಲ ಎಲಿಫಜನೆ ಫಸ್ಟನಿ ಬೈಕೊ ಥೈತಿ ತೆ ತಿನೆ ಅಮಾಲೆಕನೆ ಜ಼ನ್ನಿ.ಇವ್ಯುನೆಜ಼ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಆದಾ ಕವಾಲಿನಾ ಬಚ್ಚಾ ವ್ಹೈ. <verse eid="GEN 39:12" /><verse number="13" style="v" sid="GEN 39:13" />ರೆಗುವೆಲನಾ ದಿಕ್ರಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ನಹತ, ಜೆರಹ, ಶಮ್ಮಾ ಮಿಜ್ಜಾ ಇವ್ಯುನೆ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಬಾಸೆಮತನಾ ದಿಕ್ರಾ ವ್ಹೈ. <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಸಿಬಿಯೊನನಿ ದಿಕ್ರಿ ಥಯಲ ಒಹೊಲಿಬಾಮನಾ ಬಚ್ಚಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ಯೆಗೊಷವಂಶಸ್ಥೊನೆ, ಯಳಾಮ ಕೊರಹ ಇವ್ಯುನೊನೆ ಜ಼ನ್ನಿ. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />ಎಸಾವನಾ ದಿಕ್ರಾವೊನಾ ಕುಲಪತಿಯೊ ಕುನ್ನ ವಹೈ ಕದ್ಯಾಮ: ಎಸಾವನೊ ಮ್ಹೊಟೊ ದಿಕ್ರೊ ಥಯಲ ಎಲಿಫಜರತಾ ಹುಟ್ಟಲವಾಲಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ತೆಮಾನ, ಓಮಾರ, ಚೆಫೊ, ಕೆನೆಜ, <verse eid="GEN 39:15" /><verse number="16" style="v" sid="GEN 39:16" />ಕೊರಹ, ಗತಾಮ, ಅಮಾಲೆಕ, ಇವ್ಯುನೆಜ಼ ಎ ಕುಲಪತಿಯೊ ವ್ಹೈ ಎದೊಮ್ಯರೊನಾ ದೆಶಮಾ ರ‍್ಹಯಲ ಎಲಿಫಜರತಾ ಆಯೆಲವಾಲಾ ವ್ಹೈ. ಇವ್ಯುನೆ ಆದಾಳನಾ ನಾತ್ನಾ ವ್ಹೈ. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />ಎಸಾವನೊ ದಿಕ್ರೊ ಥಯಲ ರೆಗುವೆಲನೆ ಹುಟ್ಟಲವಾಲಾ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ನಹತ, ಜೆರಹ, ಶಮ್ಮಾ, ಮಿಜ್ಜಾ ಕವಾನಾ ಕುಲಪತಿಯೊ ಹುಟ್ಟ್ಯಾ. ಇವ್ಯುನೆ ಎದೊಮ್ಯರೊನಾ ದೆಶಮಾ ರ‍್ಹಯಲ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಬಾಸೆಮತನೆ ಹುಟ್ಟಲ ನಾತ್ನಾ ವ್ಹೈ. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಒಹೊಲಿಬಾಮನಿ ದಿಕ್ರಿ ಥಯಲ ಅನಾಳನಿ ಸಂತಾನನಾ ಕುಲಪತಿಯೊ ಕುನ ವ್ಹೈ ಕದ್ಯಾಮ: ಯೆಗೊಷ, ಯಳಾಮ, ವರಿ ಕೊರಹ. ಇವ್ಯುನೆಜ಼ ಅನಾಹನಿ ದಿಕ್ರಿ ಎಸಾವನಿ ಬೈಕೊ ಥಯಲ ಒಹೊಲಿಬಾಮನಾ ಸಂತಾನವಾಲಾ ವ್ಹೈ. <verse eid="GEN 39:18" /><verse number="19" style="v" sid="GEN 39:19" />ಎದೊಮ ಕವೈಲಿವಾಲೊ ಎಸಾವತಾ ಹುಟ್ಟಲವಾಲಲಾ ಖಾಂದಾನೆ ಇವ್ಯುನೆಜ಼ ಕುಲಪತಿಯೊ ವ್ಹೈ. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />ಲೆಯಳ ಕ್ಹುದಾ ಮನೆ ಚೊ಼ಕು ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ ಮೆ ಮಾರಾ ಮಾಟಿನೆ ಛೆವಾ ಪಟ್ಟಾ ಜ಼ನ್ನಿನ ದಿದಿಲಕ್ಹು ತೆ ಮಾರಾ ಕ್ಹಾತೆಜ಼ ಜಿವ್ನಾ ಕರಸ ಕೈನ ತೆ ಪಟ್ಟಾನೆ ಜೆಬುಲೊನ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />ತೆ ಥಯಲ್ಪರ ತೆ ಯಕ್ಕ ಚೊ಼ಕ್ರಿ ಜ಼ನ್ನಿನ ತಿನೆ ದಿನಾ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />ಪಾಚಲ್ತೊ ಕ್ಹುದಾ ರಾಹೆಳನೆ ಶೆ ಕರಿನ ತಿನಿ ಪ್ರಾಥನಾ ಐಕಿನ ತಿನೆ ಬಚ್ಚಾ ಥಾವಾ ವರಕ್ಹು ಕರ‍್ಯೊ. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />ತೆ ಪೆಟೆ ರ‍್ಹೈನ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿನ, ಕ್ಹುದಾ ಮಪರ ರ‍್ಹಯಲ ಕಲಂಕ ಕಾಡಿಪಾಡ್ಯೊ.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">ಯೊಸೆಫನಾ ಕ್ಹಪನನು ಅರ್ಥ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />ಯಾಕೊಬ ಡೊಳಾ ಉಚೈನ ದೆಕತಾಮಾ, ಎಸಾವ 400 ಜ಼ನಾವೊನಾ ಕ್ಹಾತೆ ಆವಾನು ದೆಕ್ಯೊ. ತೆಳಾಮಾ ತೆ ಲೆಯಳನೆಬಿ ರಾಹೆಳನೆಬಿ ಭಂಬೆ ದಾಸಿಯೊನೆಬಿ ತ್ಯುನಾ ತ್ಯುನಾ ಬಚ್ಚಾವೊನೆ ಒಪ್ಸಿನ ತ್ಯುನೊನೆ ಬಿಜಾ ಬಿಜಾ ಕರಿನ <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />ಕ್ಹಾಮೊ ದಾಸಿಯೊನೆಬಿ ತ್ಯುನಾ ಬಚ್ಚಾವೊನೆ ತ್ಯುನಾ ಪಾಚೊ಼ ಲೆಯಳನನೆ ವರಿ ತಿನಾ ಬಚ್ಚಾವೊನೆ ಲಾಸ್ಟೆ ರಾಹೆಳನೆ ವರಿ ಯೊಸೆಫನೆ ಹುಬ್ರಾಡ್ಯೊ. <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />ತೆಜ಼ ತ್ಯುನಾ ಕ್ಹಾಮೊ ಗೈನ ತಿನೊ ಮ್ಹೊಟೊ ಭೈ ಕ್ಹಾಮೊ ಆತಾಮಾ ಕ್ಹಾತ ಸಲಾ ಜಿಮಿನ ಮಟ್ಟಾ ಮಾತು ಜು಼ಕೈನ ನಮಸ್ಕಾರ ಕರ‍್ಯೊ. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />ತೆಳಾಮಾ ಯೆಸಾವ ತಿನೆ ಮಳಾನೆ ಕೈ ಕ್ಹಾಮೊ ನ್ಹಾಟಿನ ಐನ ತಿನೆ ಗಳೆ ಮಳಿನ ಮಟ್ಟಿ ದಿದ್ಯೊ. ತ್ಯುನೆ ಭಂಬಿ ಜ಼ನಾ ರೊಯಾ. <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />ತೆ ಥಯಲ್ಪರ ಎಸಾವ ಡೊಳಾ ಉಚೈನ ತೆ ಬಾಕಡಿಯೊನೆ ಬಚ್ಚಾವೊನೆ ದೆಕಿನ, ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ಕುನ ವ್ಹೈ?” ಕೈನ ಪುಚ್ಚತಾಮಾ ಯಾಕೊಬ ತಿನೆ, 'ಕ್ಹುದಾ ತಾರಾ ಸೆವಕನೆ ಕೃಪಾಕ್ಹು ದಿದಲ ಬಚ್ಚಾ ಇವನೆಜ಼ ವ್ಹೈ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />ತೆಳಾಮಾ ತಿನಾ ಭಂಬೆ ದಾಸಿಯೊ ತ್ಯುನಾ ಬಚ್ಚಾವೊನೆ ಬಲೈಲಿನ ಕ್ಹಾಮಾ ಐನ ಅಡ್ಡ ಪಡ್ಯಾ. <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />ಪಾಚಲ್ತಿ ಲೆಯಳ ತಿನಾ ಬಚ್ಚಾವೊನಾ ಕ್ಹಾತೆ ಐನ ಅಡ್ಡ ಪಡಿ. ಲಾಸ್ಟೆ ಯೊಸೆಫ ವರಿ ರಾಹೆಳ ಐನ ಅಡ್ಡ ಪಡ್ಯಾ. <verse eid="GEN 40:7" /><verse number="8" style="v" sid="GEN 40:8" />ಎಸಾವ, 'ಮಿ ವಾಟ್ಮಾ ದೆಕಲ ತೆ ಜಾನವರೊ ಶಾನೆ?” ಕೈನ ಪುಚ಼ತಾಮಾ ಯಾಕೊಬ, 'ಸ್ವಾಮಿಯೊನಿ ದಯಾ ಮನೆ ಚಾ಼ಯೆ ಕೈನ ಮಿ ತುಮೊನೆ ತೆ ದಿನ ವಳಾಯೊ” ಕದ್ಯೊ. <verse eid="GEN 40:8" /><verse number="9" style="v" sid="GEN 40:9" />ಎಸಾವ ತಿನೆ, ' ಎ ಮಾರಾ ನ್ಹಾನಾ ಭೈ, ಮನೆ ಚಾ಼ಯೆ ಥಯಲ ಅಕ್ಲಿ ಆಸ್ತಿ ಛೆ, ತಾರು ತುನೆ ರ‍್ಹವಾದೆ” ಕವಾಕ್ಹು <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />ಯಾಕೊಬ, 'ತಿಮ್ಮ ನೈ, ತುನೆ ಮಾರಾ ಉಪ್ಪರ ದಯಾ ರ‍್ಹಯಾಮ, ಮಿ ದಿವಾನಿ ಕಾಣಿಕೆ ಲಿವು. ತುನೆ ದೆಕಲಕ್ಹು ಕ್ಹುದಾನೆ ದೆಕೆನಿಂಗತ ಥಯು,ಮನೆ ಮಯಾಕ್ಹುಜ಼ ಮಳೈ ಲಿದಲಜ಼ ಘನ್ನಿ ಚೊ಼ಕಿ ಸಂಗತಿ ಥೈಸ. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />ಕ್ಹುದಾ ಮನೆ ಕೃಪಾ ಕರಲಕ್ಹು ಮನೆ ಸಮೃದ್ಧಿ ಉಂಟ ಥಯು. ತಿನಾ ಹುತಿ ಮಿ ದಿವಾನು ಕಾಣಿಕೆ ತು ದಯಾ ಮ್ಹೆಲಿನ ಲಿವು” ತಿಮ್ಮ ಕೈನ ಎಸಾವನೆ ಜ಼ಬರದಸ್ತಿ ಕರಲಕ್ಹು ತೆ ತೆ ಕಾಣಿಕೆ ಲಿದ್ಯೊ. <verse eid="GEN 40:11" /><verse number="12" style="v" sid="GEN 40:12" />ಪಾಚಲ್ತೊ ಎಸಾವ, 'ಅಪೆ ಪ್ರಯಾಣ ಅಗಾ ಬಡೈಯೆ. ಮಿ ಕ್ಹಾಮೊ ಜೌ಼ಸ ಕೈನ” ಕದ್ಯೊ. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />ತಿನಾಹುತಿ ಯಾಕೊಬ, 'ಮಾರಾ ಬಚ್ಚಾ ಜಾಂಜಿಮಾನ ಅರಾಮ ನೈಸೊ ಛೆ ತೆನೈಸೊ ಅರಾಮ ನೈಸೊ ಬೈಲೊ ಬಕ್ರಾ ಮಕನ ರ‍್ಹಯಲ ಪ್ರಭುನೆ ತಿಳದ್ಯುಸ. ಯಕ್ಕ ದಿನ್ನ ಜಾಸ್ತ ತ್ಯುನೊನೆ ಚಲಾಯಾರೆ ಬಕ್ರಾವೊನಾ ಕ್ಹಾರಾ ಹಿಂಡೊ ಮರಿ ಜಾ಼ವಸ. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />ತುಮೆ ದಯಾ ಮ್ಹೆಲಿನ ಸೆವಕತಿ ಪೈಲಾ ಜಾ಼ ಸಕೊಶಿ ಮಿ ಮಾರಾ ಕ್ಹಾಮಾ ರ‍್ಹಯಲ ಬಕ್ರಾ ಬಕ್ರಿಯೊ ಚಾ಼ಲಾನಿ ವರಿ ಬಚ್ಚಾವೊನಿ ಶಕ್ತಿ ನಾ ಕ್ಹಾತೆಜ಼ ಹಲ್ಲು ಹಲ್ಲು ಚಾ಼ಲ್ತೊ ಮಾರಾ ಪ್ರಭುನಿ ಸಿಮೆ ಥಯಲ ಸೆಯಿರನೆ ಔಸ” ಕದ್ಯೊ. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />ಎಸಾವ, 'ಮಾರಾ ಆಳೊಮಾ ದಕ್ಹಾ ಜ಼ನಾವೊನೆ ತಾರಾ ಕ್ಹಾತೆ ಚ಼ೊಡಿನ ಜೌ಼ಸ” ಕತಾಮಾ ಯಾಕೊಬ, 'ತ್ಯುನಿ ಸು ಜರುರತ ಛೆ? ಮಾಲಕ, ತುಮಾರಿ ದಯಾ ಮಾರಾ ಉಪ್ಪರ ರ‍್ಹೈಮ ಬಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 40:15" /><verse number="16" style="v" sid="GEN 40:16" />ಅಮ್ಮ ಎಸಾವ ತೆ ದಿನ್ನೆಜ಼ ಸೆಯಿರನೆ ಗೈಪಡ್ಯೊ. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />ಯಾಕೊಬ ಪ್ರಯಾಣ ಕರಿನ ಸುಕ್ಕೊತನೆ ಆಯೊ. ತ್ಯಾ ತಿನಾ ಹುತಿ ಘರ ವರಿ ಬೈಲೊನಾ ಹುತಿ ಜ಼ೊಪಡು ಬಂದಾಯೊ.ತಿನಾ ಹುತಿ ತೆ ಜ಼ಗಾನೆ 'ಸುಕ್ಕೊತ” ಕೈನ ನಾಮ ಥಯು. <verse eid="GEN 40:17" /><verse number="18" style="v" sid="GEN 40:18" />ಯಾಕೊಬ ಪದ್ದನ ಅರಾಮತೊ ಐನ, ಕಾನಾನ ದೆಶನಾ ಶೆಕೆಮ ಗಾಮೆ ಚೊ಼ಕಿತರಾ ಆಯೊ. ತೆ ಗಾಮಕನ್ನ ತಿನಾ ಗುಡಾರೊ ಘಲೈಲಿದ್ಯೊ. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />ತೆ ತಿನಾ ಗುಡಾರೊ ಘಲಾಯಲ್ಪರ ಜ಼ಗಾನೆ ಹಮೊರನಾ ಬಚ್ಚಾವೊನೆ ಕ್ಹೊ ಬಿಲ್ಲಾ ದಿನ ತ್ಯುನೊಕಂತೊ ಲಿದ್ಯೊ. ಹಮೊರ ಶೆಕೆಮನೊ ಬಾ ವ್ಹೈ. <verse eid="GEN 40:19" /><verse number="20" style="v" sid="GEN 40:20" />ಲೆಯಳ ಕ್ಹುದಾ ಮನೆ ಚೊ಼ಕು ಆಶಿರ್ವಾದ ದಿದ್ಯೊಸ ಮೆ ಮಾರಾ ಮಾಟಿನೆ ಛೆವಾ ಪಟ್ಟಾ ಜ಼ನ್ನಿನ ದಿದಿಲಕ್ಹು ತೆ ಮಾರಾ ಕ್ಹಾತೆಜ಼ ಜಿವ್ನಾ ಕರಸ ಕೈನ ತೆ ಪಟ್ಟಾನೆ ಜೆಬುಲೊನ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />ತೆ ಥಯಲ್ಪರ ತೆ ಯಕ್ಕ ಚೊ಼ಕ್ರಿ ಜ಼ನ್ನಿನ ತಿನೆ ದಿನಾ ಕೈನ ನಾಮ ಮ್ಹೆಲಿ. <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />ಪಾಚಲ್ತೊ ಕ್ಹುದಾ ರಾಹೆಳನೆ ಶೆ ಕರಿನ ತಿನಿ ಪ್ರಾಥನಾ ಐಕಿನ ತಿನೆ ಬಚ್ಚಾ ಥಾವಾ ವರಕ್ಹು ಕರ‍್ಯೊ. <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />ತೆ ಪೆಟೆ ರ‍್ಹೈನ ಪಟ್ಟಾನೆ ಜ಼ನ್ನಿನ, ಕ್ಹುದಾ ಮಪರ ರ‍್ಹಯಲ ಕಲಂಕ ಕಾಡಿಪಾಡ್ಯೊ.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">ಯೊಸೆಫ ಫರೊಹನನಾ ಕ್ಹಪನನು ಅರ್ಥ ಕದಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />ಹಮಾರಾ ಬಾನಿ ಕ್ಹಾರಿ ಆಸ್ತಿ ಯಾಕೊಬನಾ ಪಾಲಿ ಥೈ, ಹಮಾರಾ ಬಾನಿ ಆಸ್ತಿಕ್ಹುಜ಼ ತೆ ತೆಕ್ಲೊ ಸೌಕಾರತನಾ ಮಳಿ ಲಾಬಾನನಾ ಬಚ್ಚಾಜ ಕೈಲಿವಾನು ವಾತೊ ಯಾಕೊಬ ಐಕ್ಯೊ. <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />ತೆಜ಼ ನೈಸೊ ಯಾಕೊಬ ಲಾಬಾನನು ಮ್ಹೊಡು ದೆಕ್ತಾಮಾ ಪೈಲಾನಿಂಗತ ದಿಕ್ಹ್ಯು ನೈ. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />ವರಿ ಯಹೊವಾ ಯಾಕೊಬನೆ ತು ತಾರಾ ಬಾನಾ ದೆಶನೆ ತಾರಾ ಬಂದುವೊಕನಬಿ ಫರಿನ ಜಾ಼ ಮಿ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹೌಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />ಅಮ್ಮ ರ‍್ಹಲಕ್ಹು ಯಾಕೊಬ ರಾಹೆಳನೆ ಲೆಯಳನೆ ತಿನಾ ಬಕ್ರಾ-ಬಕ್ರಿಯೊನು ಹಿಂಡನೆ ಚರಾವಾನಾ ರಾನ್ಮಾ ಬಲೈನ. <verse eid="GEN 41:4" /><verse number="5" style="v" sid="GEN 41:5" />ತಿವ್ನೊನೆ ಕದಲ ಸುವೈ ಕದ್ಯಾಮ ತಾರಾ ಬಾನು ಮ್ಹೊಡು ಮಾರಾ ವಿಷಯಮಾ ಪೈಲಾ ನಿಂಗತ ನತ್ತಿ ಕೈನ ದಿಕ್ಹ್ಯುಸ ತಿಮ್ಮ ರ‍್ಹಯುತಬಿ ಮಾರಾ ಬಾನೊ ಕ್ಹುದಾ ಮಾರಾಕ್ಹಾತೆ ಛೆ . <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />ಮಿ ತುಮಾರಾ ಬಾನಿ ಸೆವಾ ಪುರಾ ಮನಸಕ್ಹು ಕರ‍್ಯೊಸ. ತೆ ಕ್ಹಾರು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />ವರಿಬಿ ತುಮಾರೊ ಬಾ ಮನೆಮೊಸ ಕರಿನ ಮಾರೊ ಪಗಾರ ದಖಾಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. ಮನೆ ಕ್ಹುದಾ ತಿನಾಹತಿ ಮೊಸ ಕರಾನೆ ಥಯು ನೈ. <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" />ತುಮಾರೊ ಬಾ ಮನೆ, ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಬಕ್ರಾ ತುನೆ ಪಗಾರ ರ‍್ಹಯವಾದೆ ಕೈನ ತೆ ಕತಾಮಾ ಕ್ಹಾರಾಜ಼ ಹಿಂಡ ಚಿಕ್ಕಿಯೊನಾ ಥಯಾ.ತೆ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತಾರೊ ಪಗಾರ ಥೈನ ರ‍್ಹವಾದೆ ಕೈನ ಕತಾಮಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಘೆರಿಯೊನಾ ವ್ಹತಾ. <verse eid="GEN 41:8" /><verse number="9" style="v" sid="GEN 41:9" />ಇಮ್ಮ ಕ್ಹುದಾ ತುಮಾರಾ ಬಾನಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ವರಿ ಜಾನವರೊ ತಕಂತೊ ಕಾಡಿನ ಮನೆ ದಿದ್ಯೊ. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />ಬಕ್ರಾ ಪೆಟ್ಟ ರ‍್ಹತಾಮಾ ಮಿ ಕ್ಹಪನಮಾ ದೆಕ್ತಾಮಾ ಬ್ಕಾವೊನಾ ಕ್ಹಾತೆ ಸಂಗಮ ಕರ್ತಾಮಾ ಬಕ್ರಿಯೊ ಕ್ಹಾರಿಯೊ ಘೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ ಮಚ್ಚೆ ಥೈನ ದಿಕ್ಹಿಯೊ. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />ತೆ ಕ್ಹಪನಮಾ ದೆವದುತ, ಯಾಕೊಬ ಕೈನ ಬಲಾತಾ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />ತೆ ಮನೆ, ಲಾಬಾನ ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ಬಕ್ರಾ ಸಂಗಮ ಕರಾಲಾ ಬ್ಕರಾವೊನೆ ದೆಕೊ ಗೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ, ಮಚ್ಚನಿ ವ್ಹತಿಯೊ. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />ತಾರಾ ಖಂಬಾನೆ ಅಭಿಶೆಕ ಕರಿನ ಮನೆ ಕ್ಹಮ್ಮ ಕರಲ ಬೆತೆಲನೊ ಕ್ಹುದಾ ಮಿಜ಼ ವ್ಹೈ ಹಮ್ನಾ ತು ಉಟಿನ ಆ ದೆಶನೆ ಛೊಡಿನ ತು ಹುಟ್ಟಲ ದೆಶನೆ ಬಿ ವರಿ ತಾರಾ ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 41:13" /><verse number="14" style="v" sid="GEN 41:14" />ಯಾಕೊಬ ಎ ವಾತೊ ಕದಲ್ಪರ ರಾಹೆಳ ವರಿ ಲೆಯಳ ಹಮಾರಾ ಬಾನಾ ಘರ‍್ಮಾ ಹಮ್ನಾ ಹಮೊನೆ ಸು ಪಾಲ ಛೆ? <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />ತೆ ಹನೊನೆ ಬಿಜಾ಼ ವ್ಹೈ ಕೈನ ದೆಕಸ್ತೊ ತೆ ಹಮೊನೆ ಇಕ್ಕಿನ ಹಮೊಕ್ಹು ಮಳಲ ರೊಕ್ಕಾ ತೆ ಯಕ್ಲೊ ಗಳಿಗಯೊಸ್ತೊ. <verse eid="GEN 41:15" /><verse number="16" style="v" sid="GEN 41:16" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಅಪ್ನಾ ಬಾ ಕಂತೊ ಕಾಳಿದಲ ಆಸ್ತಿ ಪುರಾ ಹಮೊನೆ ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ ಕವಸ ತಿಮ್ಮಜ಼ ಕರ ಕೈನ ಉತ್ತರ ದಿದ್ಯಾ. <verse eid="GEN 41:16" /><verse number="17" style="v" sid="GEN 41:17" />ತೆಳಾಮಾ ಯಾಕೊಬ ತಿನಾ ಬಚ್ಚಾವೊನೆ ವರಿ ತಿನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಹುಂಟಪರ ಚ಼ಡಾಯೊ. <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />ತೆ ಗಳಸಲ ಕ್ಹಾರಿ ಆಸ್ತಿ ಪದ್ದನ ಅರಾಮ ದೆಶಮಾ ಗಳಸಲ ಕ್ಹಾರಾ ಜಾನವರನೆ ಲಿನ ಕಾನಾನ ದೆಶೆ ತಿನಾ ಬಾ ಥಯಲ ಇಸಾಕಕನ ಚಾಲ್ಯಾ. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />ತೆಳಾಮಾ ಲಾಬಾನ ತಿನಾಬಕ್ರಾನಾ ಬಾಲೊ ಕತ್ರಾನಾ ಹುತಿ ಗಯೊತೊ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ರಾಹೆಲ ತಿನಾ ಬಾನಾ ಘರ್ಮಾ ರ‍್ಹಯಲ ಮೊರ್ತಿಯೊ ಚೊ಼ರಿ ಕರ್ಲಿದಿ. <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />ತೆನೈಸೊ ಯಾಕೊಬ ಅರಾಮ್ಯನೊ ಲಾಬಾನನೆ ತಿಳಸಾಯಾ ವಾಚಿ ತಿನೆ ಮೊಸ ಕರಿನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />ಅಮ್ಮ ತೆ ತಿನಿ ಆಸ್ತಿ ಪುರಾ ಲಿನ ಯುಫ್ರೆಟಿಸ ಮ್ಹೊಟಿ ನದಿನೆ ದಾಟಿನ ಗಿಲ್ಯಾದ ಕವಾನಾ ಡೊಂಗರನಿ ವಾಟ ಧರಿನ. <verse eid="GEN 41:21" /><verse number="22" style="v" sid="GEN 41:22" />ಯಾಕೊಬ ಫರಿನ ಗಯೆಲ ತನ್ನ ದಿನ್ನ ಥಯಲ್ಪರ ಲಾಬಾನನೆ ಗ್ವತ ಥಾತಾಮಾ. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />ತೆನೈಸೊ ತೆ ರಾತೆ ಕ್ಹುದಾ ಅರಾಮ್ಯನೊ ಥಯಲ ಲಾಬಾನನಾ ಕ್ಹಪನಮಾ ಐನ ತು ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಚೊ಼ಕು ಕೆಟ್ಟ ಬೊಲ್ಯಾ ಬಗರ ಹುಶಾರಕಿಕ್ಹು ರ‍್ಹೆ ಕದ್ಯೊ. <verse eid="GEN 41:24" /><verse number="25" style="v" sid="GEN 41:25" />ತೆ ಥಯಲ್ಪರ ಲಾಬಾನ ಯಾಕೊಬನೆ ಮಳಲ್ಪರ ಯಾಕೊಬ ಡೊಂಗರ‍್ಮಾ ತಿನು ಝುಪಡು ಘಾಲಿದ್ಯೊತೊ ಲಾಬಾನಬಿ ತಿನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ತೆಜ಼ ಗಿಲ್ಯಾದ ಡೊಂಗರ‍ಮಾ ಝುಪಡು ಘಾಲಿದ್ಯೊ. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />ಲಾಬಾನ ಯಾಕೊಬನೆ ಆ ಸು ವ್ಹೈ ತು ಕರಲ? ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ಯುದ್ಧಮಾ ಧರಿನ ಲಾಯೆನಿಂಗತ ಲಿನ ಮನೆ ಕದ್ಯಾವಾಚಿ ತ್ಯಾಂತೊ ಐಪಡ್ಯೊಸ್ತೊ. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />ಕಾ ಮನೆ ಮೊಸ ಕರಿನ ಚೊ಼ರಿ ಕರಲನಿಂಗತ ಐಪಡ್ಯೊ? ಮಿ ಕ್ಹುಶಿಕ್ಹು ತುನೆ ಗಿದ್ದೊ, ನ್ಹಾಚಾಲಾ ವರಿ ಘನ್ನ ತರಾನಾ ವಾದ್ಯೊನಾ ಕ್ಹಾತೆ ತುನೆ ವಳಾತೊತೊ. <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />ತೆನೈಸೊ ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ವರಿ ಮಾರಾ ನಾತ್ನಾ-ನಾತ್ನಿಯೊನೆ ಬಿ ಗಳೆ ಮಳನೆ ನೈ ಥಯಲನಿಂಗತ ಕರ‍್ಯೊಸ ತು ಕರಲ ಪಿಸಾಳಾನು ಕಾಮ ವ್ಹೈ. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />ತುಮೊನೆ ಕೆಟ್ಟ ಕರಾನೆ ಮಕನ ತಾಕತ ಶೆ ತೆನೈಸೊ ಕಾಲನಾ ರಾತೆ ತಾರಾ ಬಾನೊ ಕ್ಹುದಾ ಯಾಕೊಬನೆ ಚೊಕು ರ‍್ಹವಾದೆ ಕೆಟ್ಟ ರ‍್ಹವಾದೆ ಬೊಲು ಕದ್ಯಾವಾಚಿ ತಿಮ್ಮಜ಼ ಹುಶಾರಕ್ಹು ರ‍್ಹೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />ತೆನೈಸೊ ತುನೆ ತಾರಾ ಬಾನಾ ಘರೆ ಜಾ಼ವಾನಿ ಘನ್ನಿ ಆಸ ರ‍್ಹಯಲಕ್ಹು ತು ಜೌ಼ ಲಾಗ್ಯು ತೆನೈಸೊ ತು ಮಾರಾ ದೆವಸ್ಥಾನೊನೆ ಕಾ ಚೊ಼ರಿ ಕರ‍್ಯೊ? ಕೈನ ಪುಚ್ಯೊ಼. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />ತಿನಾಹುತಿ ಯಾಕೊಬ ಲಾಬಾನನೆ ತು ತಾರಾ ದಿಕ್ರಿಯೊನೆ ಜ಼ಬರದಸ್ತಿಕ್ಹು ಮಕಂತೊ ಕಾಳೆಶಿ ಕೈನ ಭುಚ್ಕಿನ ಐಪಡ್ಯೊ. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />ತಾರಾ ದೆವಸ್ಥಾನೊ ಕಿಕನ ಮಳಸ ತ್ಯುನೆ ಮರಾದೆ. ಮಾರಾ ಸಂಭಂದಿಕರೊನಾ ಕ್ಹಾಮೊಜ಼ ಮಾರಿ ಆಸ್ತಿನೆ ಮೊಜ಼ ಸಕ್ಸಿ. ತಿಮಾ ಸುಬಿ ತಾರು ಮಳ್ಯುಮ ತೆ ತು ಲೆ ಕೈನ ಕದ್ಯೊ. ರಾಹೆಳ ತೆ ದೆವಸ್ಥಾನೊನೆ ಚೊ಼ರಿ ಕರಲ ಯಾಕೊಬನೆ ಗ್ವತ ನ್ಹೊತು. <verse eid="GEN 41:32" /><verse number="33" style="v" sid="GEN 41:33" />ಲಾಬಾನ ಯಾಕೊಬನಾ ಝುಪ್ಡಾಮಾಬಿ, ಲೆಯಳನಾ ಝುಪ್ಡಾಮಾಬಿ, ತೆ ಭಂಬಿ ದಾಸಿಯೊನಾ ಝುಪ್ಡಾವೊಮಾಬಿ ಹುಡಕ್ಯೊ. ತೆನೈಸೊ ತಿನೆ ಸುಜ಼ ಮಳ್ಯು ನೈ. ಲೆಯಳನು ಝುಪ್ಡು ಛೊಡಿನ ರಾಹೆಳನಾ ಝುಪ್ಡಾನೆ ಆಯೊ. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />ರಾಹೆಳ ತೆ ಮುರತಿಯೊನೆ ಲಿನ ಉಂಟನಾ ಚಾಮ್ಡಾನಾ ಕೈಚಿಲಾಮಾ ಘಾಲಿನ ತಿವ್ಯುನಾ ಉಪ್ಪರ ಬೆಟಿತಿ. ಲಾಬಾನ ಝುಪ್ಡಾಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರು ಸಾಮನ ದೆಕ್ಯೊತಬಿ ತಿನೆ ದಿಕ್ಹ್ಯಾ ನೈ. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />ರಾಹೆಳ ತಿನಾ ಬಾನೆ, 'ಬಾ ಮಿ ತಾರಾ ಕ್ಹಾಮಿ ಉಟಿನ ನೈ ಹುಬ್ರೈರೆ ಶಿಟ್ಟ ಥವು ನಕೊ, ಮಿ ಭಾರಿ ಥೈಸ” ಕೈನ ಕದಿ. ತಿ ಚೊ಼ಕಿತರಾ ಹುಡಕ್ಯೊತಬಿ ತೆ ಮುರತಿಯೊ ನೈ ಮಳಲಕ್ಹು ಫರಿನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />ತೆಳಾಮಾ ಯಾಕೊಬ ಘನ್ನೊ ಶಿಟ್ಟ ಥೈನ ಲಾಬಾನನೆ ಜೊ಼ರ ವದರಿನ, 'ತು ಅಕ್ಲೊ ಘಾಬ್ರೊ ಥೈನ ಮಾರಾ ಪಾಚೊ಼ ಲಾಗಿನ ಆವಾ ವರಕ್ಹು ಮಿ ಸು ತಪ್ಪ ಕರ‍್ಯೊಸ?<verse eid="GEN 41:36" /></para>
  <para style="s">ಯೊಸೆಫನೆ ಇಜಿಪ್ಟ್ನೊ ರಾಜಪಾಲ ಕರಲ</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />ಮಾರಾ ಸಾಮನಮಾ ಪುರಾ ತು ಧುಂಡಾ ಅಕಲು ಮಿ ಸು ತಪ್ಪ ಕರ‍್ಯೊತೊ? ತಾರು ಸ್ವಂತ ಮಾರಾಮಾ ಸು ಬಿ ಮಳ್ಯು ಸು? ಮಾರಾ ಸಂಬಂದಿಕರೊನಾ ಕ್ಹಾಮೊ ಬಿ ತಾರಾ ಸಂಬಂದಿಕರೊನಾ ಕ್ಹಾಮೊ ಬಿ ತೆ ಲೈನ ಮ್ಹೆಲ. ಇವುನೆಜ಼ ಅಪೆ ಭ್ಹಂಬಿ ಜ಼ನಾವೊನು ನ್ಯಾಯ ಕರಾದೆ. <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />ಮಿ ತಾರಾ ಕ್ಹಾತೆ ಇಕ್ಹ ವರಕ್ಹ ವ್ಹತ್ತೊ. ತಾರಾ ಹಿಂಡೊನಾ ಹೆಣ್ಣ ಬಕರಿಯೊನಾ ಬಚ್ಚಾವೊನೆ ಖಲಾಸ ಕರಿ ಪಾಡ್ಯೊ ನೈ. ತಾರಾ ಹಿಂಡನಾ ಟಗರೊನೆ ಮಿ ಸು ಖೈ ಪಾಡ್ಯೊ ನೈ. <verse eid="GEN 41:38" /><verse number="39" style="v" sid="GEN 41:39" />ರಾನ್ಮಾನಾ ಜಾನ್ವರೊ ಖಲಾಸ ಕರಲ ಬಕ್ರಿಯೊ, ಬಕ್ರಾನೆ ತಾರಾ ವಾಟಾಮಾ ಘಾಲ್ಯಾವಾಚಿ ಮಿಜ಼ ಕ್ಹಾರು ಹಾಳ ಥಯಲ ಉಚೈಲಿದ್ಯೊ. ರಾತ್ಮಾಬಿ, ದಿನ್ಮಾಬಿ ಜ಼ವೈ ಗಯೆಲನೊ ಲೆಕ್ಕೊ ಮಕಂತೊ ತು ಲಿದ್ಯೊ. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />ದಿನ್ಮಾ ತಡಕಾಕ್ಹು ಕ್ಹಾಂಜ಼ನಿ ಥಂಡಮಾ ತ್ರಾಸ ಖಾದ್ಯೊ. ಕ್ಹುರವಾನೆಬಿ ಮೌಕೊ ಮಳ್ಯೊ ನೈ, ಮಾರಿ ಪರಿಸ್ಥಿತಿ ಇಮ ವ್ಹತಿ. <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" />ಇಕ್ಹ ವರಕ್ಹ ತಾರಾ ಘರ್ಮಾ ವ್ಹತೊ. ತಾರಿಯೊ ಭಂಬಿ ದಿಕ್ರಿಯೊನಾ ಹುತಿ 14 ವರಕ್ಹ ತಾರಾ ಬಕ್ರಾವೊನಾ ಹುತಿ 7 ವರಕ್ಹ ಸೆವೆ ಕರ‍್ಯೊ. ತಬಿಬಿ ಮಾರೊ ಪಗಾರ ದಕ್ಹ ಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />ಮಾರೊ ಬಾ ಥಯಲ ಕ್ಹುದಾ ಅಬ್ರಹಾಮನೊ ಕ್ಹುದಾ ಇಸಾಕನಿ ಭಯಾ ಭಕ್ತಿ ಕ್ಹು ವಪ್ಪಿಲಿದಲ ಕ್ಹುದಾ ಮಾರಾ ಕ್ಹಾತೆ ನೈ ರ‍್ಹವತ್ತೊ. ಕ್ಹರಿಮಾಜ಼ ಮನೆ ತು ಖಾಲಿ ಹತೆಜ಼ ಮೊಕ್ಲಿಪಾಡ್ತೊತೊ ಕ್ಹುದಾ ಮಾರೊ ಕಷ್ಟ ಮಿ ಖಾದಲ ಪ್ರಯಾಸ ಗ್ವತ್ತ ರ‍್ಹಯಲ ಹುತಿ ಕಾಲ ರಾತೆ ತುನೆ ಭುಚ್ಕಾಡ್ಯೊ.ಕದ್ಯೊ. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />ಲಾಬಾನ ಯಾಕೊಬನೆ ಎ ಚೊಕ್ರಿಯೊ ಮಾರಿಯೊ ದಿಕ್ರಿಯೊ ವ್ಹೈ. ತ್ಯುನಾ ಬಚ್ಚಾ ಮಾರಾ ರ‍್ಹಯಲ ವ್ಹೈ. ತೆ ಜಾನವರೊ ತೆ ಮಾರಾ ವ್ಹೈ. ತು ದೆಕಾನು ನ್ಹ್ಯಾನು ಹರಿಯಕ್ಕ ಮಾರು ವ್ಹೈ. ತೆ ನೈಸೊ ಮಾರಿಯೊ ದಿಕ್ರಯೊನೆ ರ‍್ಹೈನೆಕಾ ತ್ಯುನಾ ಬಚ್ಚಾ಼ವೊನೆ ರ‍್ಹೈನೆಕಾ ಲಿವಾನೆ ಸಾದೈನತ್ತಿ. <verse eid="GEN 41:43" /><verse number="44" style="v" sid="GEN 41:44" />ತಿನಾಹುತಿ ತಾರಾ ಕ್ಹಾತೆ ಯಕ್ಕ ವಪಂದ ಕರಲಿವಾನೆ ತಯ್ಯಾರ ಛೆ. ಅಪ್ನಾ ವಪ್ಪಂದನೆ ಸಾಕ್ಷಿನಾಹುತಿ ಮ್ಹೊಟೊ ದಗ್ಡೊಲಿನ ಖಾಮ ನಿಂಗತ ಹುಬ್ರಾಡಿಯೆ. ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />ತಿನಾನಿಂಗತಜ಼಼ ಯಾಕೊಬ ಸಾಕ್ಷಿನೆ <verse eid="GEN 41:45" /><verse number="46" style="v" sid="GEN 41:46" />ತೆ ತ್ಯುನಾ ಮನಕ್ಹೊನೆ ಹಜು಼ನಾ ದಕ್ಹಾ ದಗ್ಡಾ ಲೈನ ಘುಂಪೊ ಕರೊ ಕೈನ ಕದ್ಯೊ ತ್ಯುನೆ ತೆ ಕದಲ ತಿಮ್ಮಜ಼ ಕರ‍್ಯಾ ವರಿ <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />ಸುಭಿಕ್ಷವಾದ ಎಳು ವರ್ಷಗಳಲ್ಲಿ ಭುಮಿಯು ಹೆರಳವಾಗಿ ಫಲಕೊಟ್ಟಿತು. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />ಐಗುಪ್ತದೆಶದಲ್ಲಿ ಸುಭಿಕ್ಷವಾದ ಆ ಎಳು ವರ್ಷಗಳ ಬೆಳೆಯನ್ನು ಯೊಸೆಫನು ಕುಡಿಸಿ ಪಟ್ಟಣಗಳಲ್ಲಿ ಶೆಖರಿಸಿ ಇಡುವ ವ್ಯವಸ್ಥೆಮಾಡಿದನು. ಒಂದೊಂದು ಪಟ್ಟಣದ ಸುತ್ತಲು ಹೊಲಗಳ ಬೆಳೆಯನ್ನು ಆಯಾ ಪಟ್ಟಣದಲ್ಲಿಯೆ ಶೆಖರಿಸಿದ್ದನು. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />ಯೊಸೆಫನು ದವಸಧಾನ್ಯವನ್ನು ಸಮುದ್ರ ತಿರದ ಮರಳಿನಂತೆ ರಾಶಿರಾಶಿಯಾಗಿ ಶೆಖರಿಸಿ ಲೆಕ್ಕ ಮಾಡುವುದನ್ನು ಬಿಟ್ಟುಬಿಟ್ಟನು. ಅದನ್ನು ಲೆಕ್ಕ ಮಾಡುವುದಕ್ಕೆ ಆಗದ ಯಿತು. <verse eid="GEN 41:49" /><verse number="50" style="v" sid="GEN 41:50" />ಬರಗಾಲ ಬರುವುದಕ್ಕಿಂತ ಮೊದಲು ಫನಿಗೆ ಇಬ್ಬರು ಗಂಡು ಮಕ್ಕಳು ಹುಟ್ಟಿದರು. ಇವರು ಒನ ಪಟ್ಟಣದ ಯಾಜಕನಾದ ಪೊಟಿಫೆರನ ಮಗಳಾದ ಆಸನತ ಎಂಬಾಕೆಯಲ್ಲಿ ಹುಟ್ಟಿದರು. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />ಚೊಚ್ಚಲು ಮಗನು ಹುಟ್ಟಿದಾಗ ಫನು, 'ನಾನು ನನ್ನ ಎಲ್ಲಾ ಕಷ್ಟವನ್ನು, ತಂದೆಯ ಮನೆಯವರನ್ನೂ ಮರೆತುಬಿಡುವಂತೆ ವರು ಮಾಡಿದನು” ಎಂದು ಹಳಿ ಅವನಿಗೆ 'ಮನಸ್ಸೆ” ಎಂದು ಹೆಸರಿಟ್ಟನು. <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />ಎರಡನೆಯ ಮಗನು ಹುಟ್ಟಿದಾಗ, 'ನನಗೆ ಸಂಕಟ ಬಂದ ಶದಲ್ಲೆ ದವರು ಅಭಿವೃದ್ಧಿಯನ್ನು ದಯಪಾಲಿಸಿದ್ದಾನೆ” ಎಂದು ಹಳಿ ಆ ಮಗನಿಗೆ 'ಎಫ್ರಾಯಿಮ” ಎಂದು ಹೆಸರಿಟ್ಟನು.<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />ಐಗುಪ್ತ ದಶದಲ್ಲಿ ಸುಭಿಕ್ಷದ ಳು ವರ್ಷಗಳು ಮುಗಿದ ತರುವಾಯ <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />ಯೊಸೆಫನು ಹೆಳಿದ ಪ್ರಕಾರ ಕ್ಷಾಮದ ಳು ವರ್ಷಗಳು ಪ್ರಾರಂಭವಾಯಿತು. ಬರವು ಸುತ್ತಲಿರುವ ಎಲ್ಲಾ ದೆಶಗಳಲ್ಲಿಯೂ ಹಬ್ಬಿತು. ಐಗುಪ್ತ ದಶದಲ್ಲಿ ಮಾತ್ರ ಆಹಾರವಿತ್ತು. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />ಐಗುಪ್ತ ದಶದಲ್ಲಿ ಬರ ಬಂದಾಗ ಪ್ರಜೆಗಳು ಆಹಾರ ಬಕೆಂದು ಫರೊಹನಿಗೆ ಮೊರೆಯಿಟ್ಟರು. ಅವನು ಅವರಿಗೆ, 'ಯಫನ ಬಳಿಗೆ ಹಗಿರಿ, ಅವನು ಹಳಿದಂತೆ ಮಾಡಿರಿ” ಎಂದು ಹೆಳಿದನು.<verse eid="GEN 41:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56" />ಬರವು ಭುಮಿಯ ಮೆಲೆಲ್ಲಾ ಹರಡಿಕೊಂಡಿದಾಗ ಫನು ಕಣಜಗಳನ್ನೆಲ್ಲಾ ತೆಗೆದು ಐಗುಪ್ತರಿಗೆ ಧಾನ್ಯವನ್ನು ಮಾರಿದನು. ಐಗುಪ್ತ ದಶದಲ್ಲಿ ಬರವು ಬಹುರವಾಗಿತ್ತು. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />ಇದಲ್ಲದೆ ಭುಮಿಯಲ್ಲೆಲ್ಲಾ ಬರವು ಬಹುರವಾಗಿದುದರಿಂದ ಎಲ್ಲಾ ಶದವ ಧಾನ್ಯವನ್ನು ಕೊಂಡುಕೊಳ್ಳುವುದಕ್ಕಾಗಿ ಐಗುಪ್ತಕ್ಕೆ ಫನ ಬಳಿಗೆ ಬಂದರು.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">ಯೊಸೆಫನಾ ಭಾಯೊ ಅನಾಜ಼ ಲಿವಾನೆ ಇಜಿಪ್ಟ್ನೆ ಗಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />ಹಮಾರಾ ಬಾನಿ ಕ್ಹಾರಿ ಆಸ್ತಿ ಯಾಕೊಬನಾ ಪಾಲಿ ಥೈ, ಹಮಾರಾ ಬಾನಿ ಆಸ್ತಿಕ್ಹುಜ಼ ತೆ ತೆಕ್ಲೊ ಸೌಕಾರತನಾ ಮಳಿ ಲಾಬಾನನಾ ಬಚ್ಚಾಜ ಕೈಲಿವಾನು ವಾತೊ ಯಾಕೊಬ ಐಕ್ಯೊ. <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />ತೆಜ಼ ನೈಸೊ ಯಾಕೊಬ ಲಾಬಾನನು ಮ್ಹೊಡು ದೆಕ್ತಾಮಾ ಪೈಲಾನಿಂಗತ ದಿಕ್ಹ್ಯು ನೈ. <verse eid="GEN 42:2" /><verse number="3" style="v" sid="GEN 42:3" />ವರಿ ಯಹೊವಾ ಯಾಕೊಬನೆ ತು ತಾರಾ ಬಾನಾ ದೆಶನೆ ತಾರಾ ಬಂದುವೊಕನಬಿ ಫರಿನ ಜಾ಼ ಮಿ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹೌಸ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />ಅಮ್ಮ ರ‍್ಹಲಕ್ಹು ಯಾಕೊಬ ರಾಹೆಳನೆ ಲೆಯಳನೆ ತಿನಾ ಬಕ್ರಾ-ಬಕ್ರಿಯೊನು ಹಿಂಡನೆ ಚರಾವಾನಾ ರಾನ್ಮಾ ಬಲೈನ. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />ತಿವ್ನೊನೆ ಕದಲ ಸುವೈ ಕದ್ಯಾಮ ತಾರಾ ಬಾನು ಮ್ಹೊಡು ಮಾರಾ ವಿಷಯಮಾ ಪೈಲಾ ನಿಂಗತ ನತ್ತಿ ಕೈನ ದಿಕ್ಹ್ಯುಸ ತಿಮ್ಮ ರ‍್ಹಯುತಬಿ ಮಾರಾ ಬಾನೊ ಕ್ಹುದಾ ಮಾರಾಕ್ಹಾತೆ ಛೆ . <verse eid="GEN 42:5" /><verse number="6" style="v" sid="GEN 42:6" />ಮಿ ತುಮಾರಾ ಬಾನಿ ಸೆವಾ ಪುರಾ ಮನಸಕ್ಹು ಕರ‍್ಯೊಸ. ತೆ ಕ್ಹಾರು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />ವರಿಬಿ ತುಮಾರೊ ಬಾ ಮನೆಮೊಸ ಕರಿನ ಮಾರೊ ಪಗಾರ ದಖಾಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. ಮನೆ ಕ್ಹುದಾ ತಿನಾಹತಿ ಮೊಸ ಕರಾನೆ ಥಯು ನೈ. <verse eid="GEN 42:7" /><verse number="8" style="v" sid="GEN 42:8" />ತುಮಾರೊ ಬಾ ಮನೆ, ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಬಕ್ರಾ ತುನೆ ಪಗಾರ ರ‍್ಹಯವಾದೆ ಕೈನ ತೆ ಕತಾಮಾ ಕ್ಹಾರಾಜ಼ ಹಿಂಡ ಚಿಕ್ಕಿಯೊನಾ ಥಯಾ.ತೆ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತಾರೊ ಪಗಾರ ಥೈನ ರ‍್ಹವಾದೆ ಕೈನ ಕತಾಮಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಘೆರಿಯೊನಾ ವ್ಹತಾ. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />ಇಮ್ಮ ಕ್ಹುದಾ ತುಮಾರಾ ಬಾನಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ವರಿ ಜಾನವರೊ ತಕಂತೊ ಕಾಡಿನ ಮನೆ ದಿದ್ಯೊ. <verse eid="GEN 42:9" /><verse number="10" style="v" sid="GEN 42:10" />ಬಕ್ರಾ ಪೆಟ್ಟ ರ‍್ಹತಾಮಾ ಮಿ ಕ್ಹಪನಮಾ ದೆಕ್ತಾಮಾ ಬ್ಕಾವೊನಾ ಕ್ಹಾತೆ ಸಂಗಮ ಕರ್ತಾಮಾ ಬಕ್ರಿಯೊ ಕ್ಹಾರಿಯೊ ಘೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ ಮಚ್ಚೆ ಥೈನ ದಿಕ್ಹಿಯೊ. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />ತೆ ಕ್ಹಪನಮಾ ದೆವದುತ, ಯಾಕೊಬ ಕೈನ ಬಲಾತಾ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 42:11" /><verse number="12" style="v" sid="GEN 42:12" />ತೆ ಮನೆ, ಲಾಬಾನ ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ಬಕ್ರಾ ಸಂಗಮ ಕರಾಲಾ ಬ್ಕರಾವೊನೆ ದೆಕೊ ಗೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ, ಮಚ್ಚನಿ ವ್ಹತಿಯೊ. <verse eid="GEN 42:12" /><verse number="13" style="v" sid="GEN 42:13" />ತಾರಾ ಖಂಬಾನೆ ಅಭಿಶೆಕ ಕರಿನ ಮನೆ ಕ್ಹಮ್ಮ ಕರಲ ಬೆತೆಲನೊ ಕ್ಹುದಾ ಮಿಜ಼ ವ್ಹೈ ಹಮ್ನಾ ತು ಉಟಿನ ಆ ದೆಶನೆ ಛೊಡಿನ ತು ಹುಟ್ಟಲ ದೆಶನೆ ಬಿ ವರಿ ತಾರಾ ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 42:13" /><verse number="14" style="v" sid="GEN 42:14" />ಯಾಕೊಬ ಎ ವಾತೊ ಕದಲ್ಪರ ರಾಹೆಳ ವರಿ ಲೆಯಳ ಹಮಾರಾ ಬಾನಾ ಘರ‍್ಮಾ ಹಮ್ನಾ ಹಮೊನೆ ಸು ಪಾಲ ಛೆ? <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />ತೆ ಹನೊನೆ ಬಿಜಾ಼ ವ್ಹೈ ಕೈನ ದೆಕಸ್ತೊ ತೆ ಹಮೊನೆ ಇಕ್ಕಿನ ಹಮೊಕ್ಹು ಮಳಲ ರೊಕ್ಕಾ ತೆ ಯಕ್ಲೊ ಗಳಿಗಯೊಸ್ತೊ. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಅಪ್ನಾ ಬಾ ಕಂತೊ ಕಾಳಿದಲ ಆಸ್ತಿ ಪುರಾ ಹಮೊನೆ ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ ಕವಸ ತಿಮ್ಮಜ಼ ಕರ ಕೈನ ಉತ್ತರ ದಿದ್ಯಾ. <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />ತೆಳಾಮಾ ಯಾಕೊಬ ತಿನಾ ಬಚ್ಚಾವೊನೆ ವರಿ ತಿನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಹುಂಟಪರ ಚ಼ಡಾಯೊ. <verse eid="GEN 42:17" /><verse number="18" style="v" sid="GEN 42:18" />ತೆ ಗಳಸಲ ಕ್ಹಾರಿ ಆಸ್ತಿ ಪದ್ದನ ಅರಾಮ ದೆಶಮಾ ಗಳಸಲ ಕ್ಹಾರಾ ಜಾನವರನೆ ಲಿನ ಕಾನಾನ ದೆಶೆ ತಿನಾ ಬಾ ಥಯಲ ಇಸಾಕಕನ ಚಾಲ್ಯಾ. <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />ತೆಳಾಮಾ ಲಾಬಾನ ತಿನಾಬಕ್ರಾನಾ ಬಾಲೊ ಕತ್ರಾನಾ ಹುತಿ ಗಯೊತೊ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ರಾಹೆಲ ತಿನಾ ಬಾನಾ ಘರ್ಮಾ ರ‍್ಹಯಲ ಮೊರ್ತಿಯೊ ಚೊ಼ರಿ ಕರ್ಲಿದಿ. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />ತೆನೈಸೊ ಯಾಕೊಬ ಅರಾಮ್ಯನೊ ಲಾಬಾನನೆ ತಿಳಸಾಯಾ ವಾಚಿ ತಿನೆ ಮೊಸ ಕರಿನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />ಅಮ್ಮ ತೆ ತಿನಿ ಆಸ್ತಿ ಪುರಾ ಲಿನ ಯುಫ್ರೆಟಿಸ ಮ್ಹೊಟಿ ನದಿನೆ ದಾಟಿನ ಗಿಲ್ಯಾದ ಕವಾನಾ ಡೊಂಗರನಿ ವಾಟ ಧರಿನ. <verse eid="GEN 42:21" /><verse number="22" style="v" sid="GEN 42:22" />ಯಾಕೊಬ ಫರಿನ ಗಯೆಲ ತನ್ನ ದಿನ್ನ ಥಯಲ್ಪರ ಲಾಬಾನನೆ ಗ್ವತ ಥಾತಾಮಾ. <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />ತೆನೈಸೊ ತೆ ರಾತೆ ಕ್ಹುದಾ ಅರಾಮ್ಯನೊ ಥಯಲ ಲಾಬಾನನಾ ಕ್ಹಪನಮಾ ಐನ ತು ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಚೊ಼ಕು ಕೆಟ್ಟ ಬೊಲ್ಯಾ ಬಗರ ಹುಶಾರಕಿಕ್ಹು ರ‍್ಹೆ ಕದ್ಯೊ. <verse eid="GEN 42:24" /><verse number="25" style="v" sid="GEN 42:25" />ತೆ ಥಯಲ್ಪರ ಲಾಬಾನ ಯಾಕೊಬನೆ ಮಳಲ್ಪರ ಯಾಕೊಬ ಡೊಂಗರ‍್ಮಾ ತಿನು ಝುಪಡು ಘಾಲಿದ್ಯೊತೊ ಲಾಬಾನಬಿ ತಿನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ತೆಜ಼ ಗಿಲ್ಯಾದ ಡೊಂಗರ‍ಮಾ ಝುಪಡು ಘಾಲಿದ್ಯೊ. <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />ಲಾಬಾನ ಯಾಕೊಬನೆ ಆ ಸು ವ್ಹೈ ತು ಕರಲ? ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ಯುದ್ಧಮಾ ಧರಿನ ಲಾಯೆನಿಂಗತ ಲಿನ ಮನೆ ಕದ್ಯಾವಾಚಿ ತ್ಯಾಂತೊ ಐಪಡ್ಯೊಸ್ತೊ. <verse eid="GEN 42:26" /><verse number="27" style="v" sid="GEN 42:27" />ಕಾ ಮನೆ ಮೊಸ ಕರಿನ ಚೊ಼ರಿ ಕರಲನಿಂಗತ ಐಪಡ್ಯೊ? ಮಿ ಕ್ಹುಶಿಕ್ಹು ತುನೆ ಗಿದ್ದೊ, ನ್ಹಾಚಾಲಾ ವರಿ ಘನ್ನ ತರಾನಾ ವಾದ್ಯೊನಾ ಕ್ಹಾತೆ ತುನೆ ವಳಾತೊತೊ. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />ತೆನೈಸೊ ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ವರಿ ಮಾರಾ ನಾತ್ನಾ-ನಾತ್ನಿಯೊನೆ ಬಿ ಗಳೆ ಮಳನೆ ನೈ ಥಯಲನಿಂಗತ ಕರ‍್ಯೊಸ ತು ಕರಲ ಪಿಸಾಳಾನು ಕಾಮ ವ್ಹೈ. <verse eid="GEN 42:28" /><verse number="29" style="v" sid="GEN 42:29" />ತುಮೊನೆ ಕೆಟ್ಟ ಕರಾನೆ ಮಕನ ತಾಕತ ಶೆ ತೆನೈಸೊ ಕಾಲನಾ ರಾತೆ ತಾರಾ ಬಾನೊ ಕ್ಹುದಾ ಯಾಕೊಬನೆ ಚೊಕು ರ‍್ಹವಾದೆ ಕೆಟ್ಟ ರ‍್ಹವಾದೆ ಬೊಲು ಕದ್ಯಾವಾಚಿ ತಿಮ್ಮಜ಼ ಹುಶಾರಕ್ಹು ರ‍್ಹೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />ತೆನೈಸೊ ತುನೆ ತಾರಾ ಬಾನಾ ಘರೆ ಜಾ಼ವಾನಿ ಘನ್ನಿ ಆಸ ರ‍್ಹಯಲಕ್ಹು ತು ಜೌ಼ ಲಾಗ್ಯು ತೆನೈಸೊ ತು ಮಾರಾ ದೆವಸ್ಥಾನೊನೆ ಕಾ ಚೊ಼ರಿ ಕರ‍್ಯೊ? ಕೈನ ಪುಚ್ಯೊ಼. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />ತಿನಾಹುತಿ ಯಾಕೊಬ ಲಾಬಾನನೆ ತು ತಾರಾ ದಿಕ್ರಿಯೊನೆ ಜ಼ಬರದಸ್ತಿಕ್ಹು ಮಕಂತೊ ಕಾಳೆಶಿ ಕೈನ ಭುಚ್ಕಿನ ಐಪಡ್ಯೊ. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />ತಾರಾ ದೆವಸ್ಥಾನೊ ಕಿಕನ ಮಳಸ ತ್ಯುನೆ ಮರಾದೆ. ಮಾರಾ ಸಂಭಂದಿಕರೊನಾ ಕ್ಹಾಮೊಜ಼ ಮಾರಿ ಆಸ್ತಿನೆ ಮೊಜ಼ ಸಕ್ಸಿ. ತಿಮಾ ಸುಬಿ ತಾರು ಮಳ್ಯುಮ ತೆ ತು ಲೆ ಕೈನ ಕದ್ಯೊ. ರಾಹೆಳ ತೆ ದೆವಸ್ಥಾನೊನೆ ಚೊ಼ರಿ ಕರಲ ಯಾಕೊಬನೆ ಗ್ವತ ನ್ಹೊತು. <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />ಲಾಬಾನ ಯಾಕೊಬನಾ ಝುಪ್ಡಾಮಾಬಿ, ಲೆಯಳನಾ ಝುಪ್ಡಾಮಾಬಿ, ತೆ ಭಂಬಿ ದಾಸಿಯೊನಾ ಝುಪ್ಡಾವೊಮಾಬಿ ಹುಡಕ್ಯೊ. ತೆನೈಸೊ ತಿನೆ ಸುಜ಼ ಮಳ್ಯು ನೈ. ಲೆಯಳನು ಝುಪ್ಡು ಛೊಡಿನ ರಾಹೆಳನಾ ಝುಪ್ಡಾನೆ ಆಯೊ. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />ರಾಹೆಳ ತೆ ಮುರತಿಯೊನೆ ಲಿನ ಉಂಟನಾ ಚಾಮ್ಡಾನಾ ಕೈಚಿಲಾಮಾ ಘಾಲಿನ ತಿವ್ಯುನಾ ಉಪ್ಪರ ಬೆಟಿತಿ. ಲಾಬಾನ ಝುಪ್ಡಾಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರು ಸಾಮನ ದೆಕ್ಯೊತಬಿ ತಿನೆ ದಿಕ್ಹ್ಯಾ ನೈ. <verse eid="GEN 42:34" /><verse number="35" style="v" sid="GEN 42:35" />ರಾಹೆಳ ತಿನಾ ಬಾನೆ, 'ಬಾ ಮಿ ತಾರಾ ಕ್ಹಾಮಿ ಉಟಿನ ನೈ ಹುಬ್ರೈರೆ ಶಿಟ್ಟ ಥವು ನಕೊ, ಮಿ ಭಾರಿ ಥೈಸ” ಕೈನ ಕದಿ. ತಿ ಚೊ಼ಕಿತರಾ ಹುಡಕ್ಯೊತಬಿ ತೆ ಮುರತಿಯೊ ನೈ ಮಳಲಕ್ಹು ಫರಿನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />ತೆಳಾಮಾ ಯಾಕೊಬ ಘನ್ನೊ ಶಿಟ್ಟ ಥೈನ ಲಾಬಾನನೆ ಜೊ಼ರ ವದರಿನ, 'ತು ಅಕ್ಲೊ ಘಾಬ್ರೊ ಥೈನ ಮಾರಾ ಪಾಚೊ಼ ಲಾಗಿನ ಆವಾ ವರಕ್ಹು ಮಿ ಸು ತಪ್ಪ ಕರ‍್ಯೊಸ? <verse eid="GEN 42:36" /><verse number="37" style="v" sid="GEN 42:37" />ಮಾರಾ ಸಾಮನಮಾ ಪುರಾ ತು ಧುಂಡಾ ಅಕಲು ಮಿ ಸು ತಪ್ಪ ಕರ‍್ಯೊತೊ? ತಾರು ಸ್ವಂತ ಮಾರಾಮಾ ಸು ಬಿ ಮಳ್ಯು ಸು? ಮಾರಾ ಸಂಬಂದಿಕರೊನಾ ಕ್ಹಾಮೊ ಬಿ ತಾರಾ ಸಂಬಂದಿಕರೊನಾ ಕ್ಹಾಮೊ ಬಿ ತೆ ಲೈನ ಮ್ಹೆಲ. ಇವುನೆಜ಼ ಅಪೆ ಭ್ಹಂಬಿ ಜ಼ನಾವೊನು ನ್ಯಾಯ ಕರಾದೆ. <verse eid="GEN 42:37" /><verse number="38" style="v" sid="GEN 42:38" />ಮಿ ತಾರಾ ಕ್ಹಾತೆ ಇಕ್ಹ ವರಕ್ಹ ವ್ಹತ್ತೊ. ತಾರಾ ಹಿಂಡೊನಾ ಹೆಣ್ಣ ಬಕರಿಯೊನಾ ಬಚ್ಚಾವೊನೆ ಖಲಾಸ ಕರಿ ಪಾಡ್ಯೊ ನೈ. ತಾರಾ ಹಿಂಡನಾ ಟಗರೊನೆ ಮಿ ಸು ಖೈ ಪಾಡ್ಯೊ ನೈ.<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />ತೆ ದೆಶಮಾ ಆವಾನು ಘನ್ನು ಕೆಟ್ಟ ವ್ಹತ್ತು. <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />ತ್ಯುನೆ ಐಗುಪ್ತ ದೆಶತಾ ಲಾಯಲದವಸ ಕ್ಹರಲಪರ ತಿನಾಬಾಬಿ ತುಮೆ ಫರಿನ ಗೈನ ಹಜಿ ದಕ್ಹು ಧಾನ್ಯ ಲಿನ ಆವೊ ಕದ್ಯೊ. <verse eid="GEN 43:2" /><verse number="3" style="v" sid="GEN 43:3" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ ಬಲೈಲಿನ ನೈತೊ ಮಾರು ಮ್ಹೊಡುಬಿ ದೆಕ್ಯು ನೈ ಕೈನ ಕ್ಹರಿಜ಼ ಕದ್ಯೊಸ ತೊ. <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />ತು ಮಾರಾ ನ್ಹಾನಾ ಭೈನೆ ಹಮಾರಾ ಕ್ಹಾತೆ ವಳಾಯಾರೆ ಹಮೆ ಗೈನ ತುನೆ ಧಾನ್ಯ ಲಿನ ಐಯೆಸ; <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ <verse eid="GEN 43:5" /><verse number="6" style="v" sid="GEN 43:6" />ಮಿ ತುಮಾರಾ ಬಾನಿ ಸೆವಾ ಪುರಾ ಮನಸಕ್ಹು ಕರ‍್ಯೊಸ. ತೆ ಕ್ಹಾರು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 43:6" /><verse number="7" style="v" sid="GEN 43:7" />ವರಿಬಿ ತುಮಾರೊ ಬಾ ಮನೆಮೊಸ ಕರಿನ ಮಾರೊ ಪಗಾರ ದಖಾಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. ಮನೆ ಕ್ಹುದಾ ತಿನಾಹತಿ ಮೊಸ ಕರಾನೆ ಥಯು ನೈ. <verse eid="GEN 43:7" /><verse number="8" style="v" sid="GEN 43:8" />ತುಮಾರೊ ಬಾ ಮನೆ, ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಬಕ್ರಾ ತುನೆ ಪಗಾರ ರ‍್ಹಯವಾದೆ ಕೈನ ತೆ ಕತಾಮಾ ಕ್ಹಾರಾಜ಼ ಹಿಂಡ ಚಿಕ್ಕಿಯೊನಾ ಥಯಾ.ತೆ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತಾರೊ ಪಗಾರ ಥೈನ ರ‍್ಹವಾದೆ ಕೈನ ಕತಾಮಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಘೆರಿಯೊನಾ ವ್ಹತಾ. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />ಇಮ್ಮ ಕ್ಹುದಾ ತುಮಾರಾ ಬಾನಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ವರಿ ಜಾನವರೊ ತಕಂತೊ ಕಾಡಿನ ಮನೆ ದಿದ್ಯೊ. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />ಬಕ್ರಾ ಪೆಟ್ಟ ರ‍್ಹತಾಮಾ ಮಿ ಕ್ಹಪನಮಾ ದೆಕ್ತಾಮಾ ಬ್ಕಾವೊನಾ ಕ್ಹಾತೆ ಸಂಗಮ ಕರ್ತಾಮಾ ಬಕ್ರಿಯೊ ಕ್ಹಾರಿಯೊ ಘೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ ಮಚ್ಚೆ ಥೈನ ದಿಕ್ಹಿಯೊ. <verse eid="GEN 43:10" /><verse number="11" style="v" sid="GEN 43:11" />ತೆ ಕ್ಹಪನಮಾ ದೆವದುತ, ಯಾಕೊಬ ಕೈನ ಬಲಾತಾ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />ತೆ ಮನೆ, ಲಾಬಾನ ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ಬಕ್ರಾ ಸಂಗಮ ಕರಾಲಾ ಬ್ಕರಾವೊನೆ ದೆಕೊ ಗೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ, ಮಚ್ಚನಿ ವ್ಹತಿಯೊ. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />ತಾರಾ ಖಂಬಾನೆ ಅಭಿಶೆಕ ಕರಿನ ಮನೆ ಕ್ಹಮ್ಮ ಕರಲ ಬೆತೆಲನೊ ಕ್ಹುದಾ ಮಿಜ಼ ವ್ಹೈ ಹಮ್ನಾ ತು ಉಟಿನ ಆ ದೆಶನೆ ಛೊಡಿನ ತು ಹುಟ್ಟಲ ದೆಶನೆ ಬಿ ವರಿ ತಾರಾ ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />ಯಾಕೊಬ ಎ ವಾತೊ ಕದಲ್ಪರ ರಾಹೆಳ ವರಿ ಲೆಯಳ ಹಮಾರಾ ಬಾನಾ ಘರ‍್ಮಾ ಹಮ್ನಾ ಹಮೊನೆ ಸು ಪಾಲ ಛೆ? <verse eid="GEN 43:14" /><verse number="15" style="v" sid="GEN 43:15" />ತೆ ಹನೊನೆ ಬಿಜಾ಼ ವ್ಹೈ ಕೈನ ದೆಕಸ್ತೊ ತೆ ಹಮೊನೆ ಇಕ್ಕಿನ ಹಮೊಕ್ಹು ಮಳಲ ರೊಕ್ಕಾ ತೆ ಯಕ್ಲೊ ಗಳಿಗಯೊಸ್ತೊ. <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ <verse eid="GEN 43:18" /><verse number="19" style="v" sid="GEN 43:19" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಅಪ್ನಾ ಬಾ ಕಂತೊ ಕಾಳಿದಲ ಆಸ್ತಿ ಪುರಾ ಹಮೊನೆ ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ ಕವಸ ತಿಮ್ಮಜ಼ ಕರ ಕೈನ ಉತ್ತರ ದಿದ್ಯಾ. <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />ಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />ಕ್ಹಾತೆ ತೆಜ಼ ಗಿಲ್ಯಾದ ಡೊಂಗರ‍ಮಾ ಝುಪಡು ಘಾಲಿದ್ಯೊ. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 43:22" /><verse number="23" style="v" sid="GEN 43:23" />ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ <verse eid="GEN 43:23" /><verse number="24" style="v" sid="GEN 43:24" />ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />ತೆ ಥಯಲ್ಪರ ಲಾಬಾನ ಯಾಕೊಬನೆ ಮಳಲ್ಪರ ಯಾಕೊಬ ಡೊಂಗರ‍್ಮಾ ತಿನು ಝುಪಡು ಘಾಲಿದ್ಯೊತೊ ಲಾಬಾನಬಿ ತಿನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ತೆಜ಼ ಗಿಲ್ಯಾದ ಡೊಂಗರ‍ಮಾ ಝುಪಡು ಘಾಲಿದ್ಯೊ. <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />ಲಾಬಾನ ಯಾಕೊಬನೆ ಆ ಸು ವ್ಹೈ ತು ಕರಲ? ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ಯುದ್ಧಮಾ ಧರಿನ ಲಾಯೆನಿಂಗತ ಲಿನ ಮನೆ ಕದ್ಯಾವಾಚಿ ತ್ಯಾಂತೊ ಐಪಡ್ಯೊಸ್ತೊ. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />ಕಾ ಮನೆ ಮೊಸ ಕರಿನ ಚೊ಼ರಿ ಕರಲನಿಂಗತ ಐಪಡ್ಯೊ? ಮಿ ಕ್ಹುಶಿಕ್ಹು ತುನೆ ಗಿದ್ದೊ, ನ್ಹಾಚಾಲಾ ವರಿ ಘನ್ನ ತರಾನಾ ವಾದ್ಯೊನಾ ಕ್ಹಾತೆ ತುನೆ ವಳಾತೊತೊ. <verse eid="GEN 43:27" /><verse number="28" style="v" sid="GEN 43:28" />ತೆನೈಸೊ ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ವರಿ ಮಾರಾ ನಾತ್ನಾ-ನಾತ್ನಿಯೊನೆ ಬಿ ಗಳೆ ಮಳನೆ ನೈ ಥಯಲನಿಂಗತ ಕರ‍್ಯೊಸ ತು ಕರಲ ಪಿಸಾಳಾನು ಕಾಮ ವ್ಹೈ. <verse eid="GEN 43:28" /><verse number="29" style="v" sid="GEN 43:29" />ತುಮೊನೆ ಕೆಟ್ಟ ಕರಾನೆ ಮಕನ ತಾಕತ ಶೆ ತೆನೈಸೊ ಕಾಲನಾ ರಾತೆ ತಾರಾ ಬಾನೊ ಕ್ಹುದಾ ಯಾಕೊಬನೆ ಚೊಕು ರ‍್ಹವಾದೆ ಕೆಟ್ಟ ರ‍್ಹವಾದೆ ಬೊಲು ಕದ್ಯಾವಾಚಿ ತಿಮ್ಮಜ಼ ಹುಶಾರಕ್ಹು ರ‍್ಹೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />ತೆನೈಸೊ ತುನೆ ತಾರಾ ಬಾನಾ ಘರೆ ಜಾ಼ವಾನಿ ಘನ್ನಿ ಆಸ ರ‍್ಹಯಲಕ್ಹು ತು ಜೌ಼ ಲಾಗ್ಯು ತೆನೈಸೊ ತು ಮಾರಾ ದೆವಸ್ಥಾನೊನೆ ಕಾ ಚೊ಼ ವರಿಬಿ ತುಮಾರೊ ಬಾ ಮನೆಮೊಸ ಕರಿನ ಮಾರೊ ಪಗಾರ ದಖಾಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. ಮನೆ ಕ್ಹುದಾ ತಿನಾಹತಿ ಮೊಸ ಕರಾನೆ ಥಯು ನೈ. ತಾರಾ ಖಂಬಾನೆ ಅಭಿಶೆಕ ಕರಿನ ಮನೆ ಕ್ಹಮ್ಮ ಕರಲ ಬೆತೆಲನೊ ಕ್ಹುದಾ ಮಿಜ಼ ವ್ಹೈ ಹಮ್ನಾ ತು ಉಟಿನ ಆ ದೆಶನೆ ಛೊಡಿನ ತು ಹುಟ್ಟಲ ದೆಶನೆ ಬಿ ವರಿ ತಾರಾ ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. ಚೊ಼ರಿ ಕರ್ಲಿದಿ. ಅಮ್ಮ ತೆ ತಿನಿ ಆಸ್ತಿ ಪುರಾ ಲಿನ ಯುಫ್ರೆಟಿಸ ಮ್ಹೊಟಿ ನದಿನೆ ದಾಟಿನ ಗಿಲ್ಯಾದ ಕವಾನಾ ಡೊಂಗರನಿ ವಾಟ ಧರಿನ. <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />ತಿನಾಹುತಿ ಯಾಕೊಬ ಲಾಬಾನನೆ ತು ತಾರಾ ದಿಕ್ರಿಯೊನೆ ಜ಼ಬರದಸ್ತಿಕ್ಹು ಮಕಂತೊ ಕಾಳೆಶಿ ಕೈನ ಭುಚ್ಕಿನ ಐಪಡ್ಯೊ. <verse eid="GEN 43:31" /><verse number="32" style="v" sid="GEN 43:32" />ತಾರಾ ದೆವಸ್ಥಾನೊ ಕಿಕನ ಮಳಸ ತ್ಯುನೆ ಮರಾದೆ. ಮಾರಾ ಸಂಭಂದಿಕರೊನಾ ಕ್ಹಾಮೊಜ಼ ಮಾರಿ ಆಸ್ತಿನೆ ಮೊಜ಼ ಸಕ್ಸಿ. ತಿಮಾ ಸುಬಿ ತಾರು ಮಳ್ಯುಮ ತೆ ತು ಲೆ ಕೈನ ಕದ್ಯೊ. ರಾಹೆಳ ತೆ ದೆವಸ್ಥಾನೊನೆ ಚೊ಼ರಿ ಕರಲ ಯಾಕೊಬನೆ ಗ್ವತ ನ್ಹೊತು. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />ಲಾಬಾನ ಯಾಕೊಬನಾ ಝುಪ್ಡಾಮಾಬಿ, ಲೆಯಳನಾ ಝುಪ್ಡಾಮಾಬಿ, ತೆ ಭಂಬಿ ದಾಸಿಯೊನಾ ಝುಪ್ಡಾವೊಮಾಬಿ ಹುಡಕ್ಯೊ. ತೆನೈಸೊ ತಿನೆ ಸುಜ಼ ಮಳ್ಯು ನೈ. ಲೆಯಳನು ಝುಪ್ಡು ಛೊಡಿನ ರಾಹೆಳನಾ ಝುಪ್ಡಾನೆ ಆಯೊ. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />ರಾಹೆಳ ತೆ ಮುರತಿಯೊನೆ ಲಿನ ಉಂಟನಾ ಚಾಮ್ಡಾನಾ ಕೈಚಿಲಾಮಾ ಘಾಲಿನ ತಿವ್ಯುನಾ ಉಪ್ಪರ ಬೆಟಿತಿ. ಲಾಬಾನ ಝುಪ್ಡಾಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರು ಸಾಮನ<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />ತೆ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತಾರೊ ಪಗಾರ ಥೈನ ರ‍್ಹವಾದೆ ಕೈನ ಕತಾಮಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಘೆರಿಯೊನಾ ವ್ಹತಾ. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />ತೆ ಕ್ಹಪನಮಾ ದೆವದುತ, ಯಾಕೊಬ ಕೈನ ಬಲಾತಾ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 44:2" /><verse number="3" style="v" sid="GEN 44:3" />ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />ತೆ ಕ್ಹಪನಮಾ ದೆವದುತ, ಯಾಕೊಬ ಕೈನ ಬಲಾತಾ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 44:5" /><verse number="6" style="v" sid="GEN 44:6" />ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />ವರಿಬಿ ತುಮಾರೊ ಬಾ ಮನೆಮೊಸ ಕರಿನ ಮಾರೊ ಪಗಾರ ದಖಾಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. ಮನೆ ಕ್ಹುದಾ ತಿನಾಹತಿ ಮೊಸ ಕರಾನೆ ಥಯು ನೈ. <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />ತುಮಾರೊ ಬಾ ಮನೆ, ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಬಕ್ರಾ ತುನೆ ಪಗಾರ ರ‍್ಹಯವಾದೆ ಕೈನ ತೆ ಕತಾಮಾ ಕ್ಹಾರಾಜ಼ ಹಿಂಡ ಚಿಕ್ಕಿಯೊನಾ ಥಯಾ.ತೆ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತಾರೊ ಪಗಾರ ಥೈನ ರ‍್ಹವಾದೆ ಕೈನ ಕತಾಮಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಘೆರಿಯೊನಾ ವ್ಹತಾ. <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />ಇಮ್ಮ ಕ್ಹುದಾ ತುಮಾರಾ ಬಾನಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ವರಿ ಜಾನವರೊ ತಕಂತೊ ಕಾಡಿನ ಮನೆ ದಿದ್ಯೊ. <verse eid="GEN 44:9" /><verse number="10" style="v" sid="GEN 44:10" />ಬಕ್ರಾ ಪೆಟ್ಟ ರ‍್ಹತಾಮಾ ಮಿ ಕ್ಹಪನಮಾ ದೆಕ್ತಾಮಾ ಬ್ಕಾವೊನಾ ಕ್ಹಾತೆ ಸಂಗಮ ಕರ್ತಾಮಾ ಬಕ್ರಿಯೊ ಕ್ಹಾರಿಯೊ ಘೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ ಮಚ್ಚೆ ಥೈನ ದಿಕ್ಹಿಯೊ. <verse eid="GEN 44:10" /><verse number="11" style="v" sid="GEN 44:11" />ತೆ ಕ್ಹಪನಮಾ ದೆವದುತ, ಯಾಕೊಬ ಕೈನ ಬಲಾತಾ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />ತೆ ಮನೆ, ಲಾಬಾನ ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ಬಕ್ರಾ ಸಂಗಮ ಕರಾಲಾ ಬ್ಕರಾವೊನೆ ದೆಕೊ ಗೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ, ಮಚ್ಚನಿ ವ್ಹತಿಯೊ. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />ತಾರಾ ಖಂಬಾನೆ ಅಭಿಶೆಕ ಕರಿನ ಮನೆ ಕ್ಹಮ್ಮ ಕರಲ ಬೆತೆಲನೊ ಕ್ಹುದಾ ಮಿಜ಼ ವ್ಹೈ ಹಮ್ನಾ ತು ಉಟಿನ ಆ ದೆಶನೆ ಛೊಡಿನ ತು ಹುಟ್ಟಲ ದೆಶನೆ ಬಿ ವರಿ ತಾರಾ ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 44:13" /><verse number="14" style="v" sid="GEN 44:14" />ಯಾಕೊಬ ಎ ವಾತೊ ಕದಲ್ಪರ ರಾಹೆಳ ವರಿ ಲೆಯಳ ಹಮಾರಾ ಬಾನಾ ಘರ‍್ಮಾ ಹಮ್ನಾ ಹಮೊನೆ ಸು ಪಾಲ ಛೆ? <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />ತೆ ಹನೊನೆ ಬಿಜಾ಼ ವ್ಹೈ ಕೈನ ದೆಕಸ್ತೊ ತೆ ಹಮೊನೆ ಇಕ್ಕಿನ ಹಮೊಕ್ಹು ಮಳಲ ರೊಕ್ಕಾ ತೆ ಯಕ್ಲೊ ಗಳಿಗಯೊಸ್ತೊ. <verse eid="GEN 44:15" /><verse number="16" style="v" sid="GEN 44:16" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಅಪ್ನಾ ಬಾ ಕಂತೊ ಕಾಳಿದಲ ಆಸ್ತಿ ಪುರಾ ಹಮೊನೆ ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ ಕವಸ ತಿಮ್ಮಜ಼ ಕರ ಕೈನ ಉತ್ತರ ದಿದ್ಯಾ. <verse eid="GEN 44:16" /><verse number="17" style="v" sid="GEN 44:17" />ತೆಳಾಮಾ ಯಾಕೊಬ ತಿನಾ ಬಚ್ಚಾವೊನೆ ವರಿ ತಿನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಹುಂಟಪರ ಚ಼ಡಾಯೊ. <verse eid="GEN 44:17" /><verse number="18" style="v" sid="GEN 44:18" />ತೆ ಗಳಸಲ ಕ್ಹಾರಿ ಆಸ್ತಿ ಪದ್ದನ ಅರಾಮ ದೆಶಮಾ ಗಳಸಲ ಕ್ಹಾರಾ ಜಾನವರನೆ ಲಿನ ಕಾನಾನ ದೆಶೆ ತಿನಾ ಬಾ ಥಯಲ ಇಸಾಕಕನ ಚಾಲ್ಯಾ. <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />ತೆಳಾಮಾ ಲಾಬಾನ ತಿನಾಬಕ್ರಾನಾ ಬಾಲೊ ಕತ್ರಾನಾ ಹುತಿ ಗಯೊತೊ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ರಾಹೆಲ ತಿನಾ ಬಾನಾ ಘರ್ಮಾ ರ‍್ಹಯಲ ಮೊರ್ತಿಯೊ ಚೊ಼ರಿ ಕರ್ಲಿದಿ. <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />ತೆನೈಸೊ ಯಾಕೊಬ ಅರಾಮ್ಯನೊ ಲಾಬಾನನೆ ತಿಳಸಾಯಾ ವಾಚಿ ತಿನೆ ಮೊಸ ಕರಿನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />ಅಮ್ಮ ತೆ ತಿನಿ ಆಸ್ತಿ ಪುರಾ ಲಿನ ಯುಫ್ರೆಟಿಸ ಮ್ಹೊಟಿ ನದಿನೆ ದಾಟಿನ ಗಿಲ್ಯಾದ ಕವಾನಾ ಡೊಂಗರನಿ ವಾಟ ಧರಿನ. <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />ಯಾಕೊಬ ಫರಿನ ಗಯೆಲ ತನ್ನ ದಿನ್ನ ಥಯಲ್ಪರ ಲಾಬಾನನೆ ಗ್ವತ ಥಾತಾಮಾ. <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />ತೆನೈಸೊ ತೆ ರಾತೆ ಕ್ಹುದಾ ಅರಾಮ್ಯನೊ ಥಯಲ ಲಾಬಾನನಾ ಕ್ಹಪನಮಾ ಐನ ತು ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಚೊ಼ಕು ಕೆಟ್ಟ ಬೊಲ್ಯಾ ಬಗರ ಹುಶಾರಕಿಕ್ಹು ರ‍್ಹೆ ಕದ್ಯೊ. <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />ತೆ ಥಯಲ್ಪರ ಲಾಬಾನ ಯಾಕೊಬನೆ ಮಳಲ್ಪರ ಯಾಕೊಬ ಡೊಂಗರ‍್ಮಾ ತಿನು ಝುಪಡು ಘಾಲಿದ್ಯೊತೊ ಲಾಬಾನಬಿ ತಿನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ತೆಜ಼ ಗಿಲ್ಯಾದ ಡೊಂಗರ‍ಮಾ ಝುಪಡು ಘಾಲಿದ್ಯೊ. <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />ಲಾಬಾನ ಯಾಕೊಬನೆ ಆ ಸು ವ್ಹೈ ತು ಕರಲ? ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ಯುದ್ಧಮಾ ಧರಿನ ಲಾಯೆನಿಂಗತ ಲಿನ ಮನೆ ಕದ್ಯಾವಾಚಿ ತ್ಯಾಂತೊ ಐಪಡ್ಯೊಸ್ತೊ. <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />ಕಾ ಮನೆ ಮೊಸ ಕರಿನ ಚೊ಼ರಿ ಕರಲನಿಂಗತ ಐಪಡ್ಯೊ? ಮಿ ಕ್ಹುಶಿಕ್ಹು ತುನೆ ಗಿದ್ದೊ, ನ್ಹಾಚಾಲಾ ವರಿ ಘನ್ನ ತರಾನಾ ವಾದ್ಯೊನಾ ಕ್ಹಾತೆ ತುನೆ ವಳಾತೊತೊ. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />ತೆನೈಸೊ ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ವರಿ ಮಾರಾ ನಾತ್ನಾ-ನಾತ್ನಿಯೊನೆ ಬಿ ಗಳೆ ಮಳನೆ ನೈ ಥಯಲನಿಂಗತ ಕರ‍್ಯೊಸ ತು ಕರಲ ಪಿಸಾಳಾನು ಕಾಮ ವ್ಹೈ. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />ತುಮೊನೆ ಕೆಟ್ಟ ಕರಾನೆ ಮಕನ ತಾಕತ ಶೆ ತೆನೈಸೊ ಕಾಲನಾ ರಾತೆ ತಾರಾ ಬಾನೊ ಕ್ಹುದಾ ಯಾಕೊಬನೆ ಚೊಕು ರ‍್ಹವಾದೆ ಕೆಟ್ಟ ರ‍್ಹವಾದೆ ಬೊಲು ಕದ್ಯಾವಾಚಿ ತಿಮ್ಮಜ಼ ಹುಶಾರಕ್ಹು ರ‍್ಹೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 44:29" /><verse number="30" style="v" sid="GEN 44:30" />ತೆನೈಸೊ ತುನೆ ತಾರಾ ಬಾನಾ ಘರೆ ಜಾ಼ವಾನಿ ಘನ್ನಿ ಆಸ ರ‍್ಹಯಲಕ್ಹು ತು ಜೌ಼ ಲಾಗ್ಯು ತೆನೈಸೊ ತು ಮಾರಾ ದೆವಸ್ಥಾನೊನೆ ಕಾ ಚೊ಼ರಿ ಕರ‍್ಯೊ? ಕೈನ ಪುಚ್ಯೊ಼. <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />ತಿನಾಹುತಿ ಯಾಕೊಬ ಲಾಬಾನನೆ ತು ತಾರಾ ದಿಕ್ರಿಯೊನೆ ಜ಼ಬರದಸ್ತಿಕ್ಹು ಮಕಂತೊ ಕಾಳೆಶಿ ಕೈನ ಭುಚ್ಕಿನ ಐಪಡ್ಯೊ. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />ತಾರಾ ದೆವಸ್ಥಾನೊ ಕಿಕನ ಮಳಸ ತ್ಯುನೆ ಮರಾದೆ. ಮಾರಾ ಸಂಭಂದಿಕರೊನಾ ಕ್ಹಾಮೊಜ಼ ಮಾರಿ ಆಸ್ತಿನೆ ಮೊಜ಼ ಸಕ್ಸಿ. ತಿಮಾ ಸುಬಿ ತಾರು ಮಳ್ಯುಮ ತೆ ತು ಲೆ ಕೈನ ಕದ್ಯೊ. ರಾಹೆಳ ತೆ ದೆವಸ್ಥಾನೊನೆ ಚೊ಼ರಿ ಕರಲ ಯಾಕೊಬನೆ ಗ್ವತ ನ್ಹೊತು. <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />ಲಾಬಾನ ಯಾಕೊಬನಾ ಝುಪ್ಡಾಮಾಬಿ, ಲೆಯಳನಾ ಝುಪ್ಡಾಮಾಬಿ, ತೆ ಭಂಬಿ ದಾಸಿಯೊನಾ ಝುಪ್ಡಾವೊಮಾಬಿ ಹುಡಕ್ಯೊ. ತೆನೈಸೊ ತಿನೆ ಸುಜ಼ ಮಳ್ಯು ನೈ. ಲೆಯಳನು ಝುಪ್ಡು ಛೊಡಿನ ರಾಹೆಳನಾ ಝುಪ್ಡಾನೆ ಆಯೊ. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />ರಾಹೆಳ ತೆ ಮುರತಿಯೊನೆ ಲಿನ ಉಂಟನಾ ಚಾಮ್ಡಾನಾ ಕೈಚಿಲಾಮಾ ಘಾಲಿನ ತಿವ್ಯುನಾ ಉಪ್ಪರ ಬೆಟಿತಿ. ಲಾಬಾನ ಝುಪ್ಡಾಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರು ಸಾಮನ<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />ತೆ ದೆಶಮಾ ಆವಾನು ಘನ್ನು ಕೆಟ್ಟ ವ್ಹತ್ತು. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />ತ್ಯುನೆ ಐಗುಪ್ತ ದೆಶತಾ ಲಾಯಲದವಸ ಕ್ಹರಲಪರ ತಿನಾಬಾಬಿ ತುಮೆ ಫರಿನ ಗೈನ ಹಜಿ ದಕ್ಹು ಧಾನ್ಯ ಲಿನ ಆವೊ ಕದ್ಯೊ. <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ ಬಲೈಲಿನ ನೈತೊ ಮಾರು ಮ್ಹೊಡುಬಿ ದೆಕ್ಯು ನೈ ಕೈನ ಕ್ಹರಿಜ಼ ಕದ್ಯೊಸ ತೊ. <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />ತು ಮಾರಾ ನ್ಹಾನಾ ಭೈನೆ ಹಮಾರಾ ಕ್ಹಾತೆ ವಳಾಯಾರೆ ಹಮೆ ಗೈನ ತುನೆ ಧಾನ್ಯ ಲಿನ ಐಯೆಸ; <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />ಮಿ ತುಮಾರಾ ಬಾನಿ ಸೆವಾ ಪುರಾ ಮನಸಕ್ಹು ಕರ‍್ಯೊಸ. ತೆ ಕ್ಹಾರು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />ವರಿಬಿ ತುಮಾರೊ ಬಾ ಮನೆಮೊಸ ಕರಿನ ಮಾರೊ ಪಗಾರ ದಖಾಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. ಮನೆ ಕ್ಹುದಾ ತಿನಾಹತಿ ಮೊಸ ಕರಾನೆ ಥಯು ನೈ. <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />ತುಮಾರೊ ಬಾ ಮನೆ, ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಬಕ್ರಾ ತುನೆ ಪಗಾರ ರ‍್ಹಯವಾದೆ ಕೈನ ತೆ ಕತಾಮಾ ಕ್ಹಾರಾಜ಼ ಹಿಂಡ ಚಿಕ್ಕಿಯೊನಾ ಥಯಾ.ತೆ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತಾರೊ ಪಗಾರ ಥೈನ ರ‍್ಹವಾದೆ ಕೈನ ಕತಾಮಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಘೆರಿಯೊನಾ ವ್ಹತಾ. <verse eid="GEN 45:8" /><verse number="9" style="v" sid="GEN 45:9" />ಇಮ್ಮ ಕ್ಹುದಾ ತುಮಾರಾ ಬಾನಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ವರಿ ಜಾನವರೊ ತಕಂತೊ ಕಾಡಿನ ಮನೆ ದಿದ್ಯೊ. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />ಬಕ್ರಾ ಪೆಟ್ಟ ರ‍್ಹತಾಮಾ ಮಿ ಕ್ಹಪನಮಾ ದೆಕ್ತಾಮಾ ಬ್ಕಾವೊನಾ ಕ್ಹಾತೆ ಸಂಗಮ ಕರ್ತಾಮಾ ಬಕ್ರಿಯೊ ಕ್ಹಾರಿಯೊ ಘೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ ಮಚ್ಚೆ ಥೈನ ದಿಕ್ಹಿಯೊ. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />ತೆ ಕ್ಹಪನಮಾ ದೆವದುತ, ಯಾಕೊಬ ಕೈನ ಬಲಾತಾ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 45:11" /><verse number="12" style="v" sid="GEN 45:12" />ತೆ ಮನೆ, ಲಾಬಾನ ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ಬಕ್ರಾ ಸಂಗಮ ಕರಾಲಾ ಬ್ಕರಾವೊನೆ ದೆಕೊ ಗೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ, ಮಚ್ಚನಿ ವ್ಹತಿಯೊ. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />ತಾರಾ ಖಂಬಾನೆ ಅಭಿಶೆಕ ಕರಿನ ಮನೆ ಕ್ಹಮ್ಮ ಕರಲ ಬೆತೆಲನೊ ಕ್ಹುದಾ ಮಿಜ಼ ವ್ಹೈ ಹಮ್ನಾ ತು ಉಟಿನ ಆ ದೆಶನೆ ಛೊಡಿನ ತು ಹುಟ್ಟಲ ದೆಶನೆ ಬಿ ವರಿ ತಾರಾ ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 45:13" /><verse number="14" style="v" sid="GEN 45:14" />ಯಾಕೊಬ ಎ ವಾತೊ ಕದಲ್ಪರ ರಾಹೆಳ ವರಿ ಲೆಯಳ ಹಮಾರಾ ಬಾನಾ ಘರ‍್ಮಾ ಹಮ್ನಾ ಹಮೊನೆ ಸು ಪಾಲ ಛೆ? <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />ತೆ ಹನೊನೆ ಬಿಜಾ಼ ವ್ಹೈ ಕೈನ ದೆಕಸ್ತೊ ತೆ ಹಮೊನೆ ಇಕ್ಕಿನ ಹಮೊಕ್ಹು ಮಳಲ ರೊಕ್ಕಾ ತೆ ಯಕ್ಲೊ ಗಳಿಗಯೊಸ್ತೊ. <verse eid="GEN 45:15" /><verse number="16" style="v" sid="GEN 45:16" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಅಪ್ನಾ ಬಾ ಕಂತೊ ಕಾಳಿದಲ ಆಸ್ತಿ ಪುರಾ ಹಮೊನೆ ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ ಕವಸ ತಿಮ್ಮಜ಼ ಕರ ಕೈನ ಉತ್ತರ ದಿದ್ಯಾ. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />ತೆಳಾಮಾ ಯಾಕೊಬ ತಿನಾ ಬಚ್ಚಾವೊನೆ ವರಿ ತಿನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಹುಂಟಪರ ಚ಼ಡಾಯೊ. <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />ತೆ ಗಳಸಲ ಕ್ಹಾರಿ ಆಸ್ತಿ ಪದ್ದನ ಅರಾಮ ದೆಶಮಾ ಗಳಸಲ ಕ್ಹಾರಾ ಜಾನವರನೆ ಲಿನ ಕಾನಾನ ದೆಶೆ ತಿನಾ ಬಾ ಥಯಲ ಇಸಾಕಕನ ಚಾಲ್ಯಾ. <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />ತೆಳಾಮಾ ಲಾಬಾನ ತಿನಾಬಕ್ರಾನಾ ಬಾಲೊ ಕತ್ರಾನಾ ಹುತಿ ಗಯೊತೊ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ರಾಹೆಲ ತಿನಾ ಬಾನಾ ಘರ್ಮಾ ರ‍್ಹಯಲ ಮೊರ್ತಿಯೊ ಚೊ಼ರಿ ಕರ್ಲಿದಿ. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />ತೆನೈಸೊ ಯಾಕೊಬ ಅರಾಮ್ಯನೊ ಲಾಬಾನನೆ ತಿಳಸಾಯಾ ವಾಚಿ ತಿನೆ ಮೊಸ ಕರಿನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 45:20" /><verse number="21" style="v" sid="GEN 45:21" />ಅಮ್ಮ ತೆ ತಿನಿ ಆಸ್ತಿ ಪುರಾ ಲಿನ ಯುಫ್ರೆಟಿಸ ಮ್ಹೊಟಿ ನದಿನೆ ದಾಟಿನ ಗಿಲ್ಯಾದ ಕವಾನಾ ಡೊಂಗರನಿ ವಾಟ ಧರಿನ. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />ಯಾಕೊಬ ಫರಿನ ಗಯೆಲ ತನ್ನ ದಿನ್ನ ಥಯಲ್ಪರ ಲಾಬಾನನೆ ಗ್ವತ ಥಾತಾಮಾ. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />ತೆನೈಸೊ ತೆ ರಾತೆ ಕ್ಹುದಾ ಅರಾಮ್ಯನೊ ಥಯಲ ಲಾಬಾನನಾ ಕ್ಹಪನಮಾ ಐನ ತು ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಚೊ಼ಕು ಕೆಟ್ಟ ಬೊಲ್ಯಾ ಬಗರ ಹುಶಾರಕಿಕ್ಹು ರ‍್ಹೆ ಕದ್ಯೊ. <verse eid="GEN 45:24" /><verse number="25" style="v" sid="GEN 45:25" />ತೆ ಥಯಲ್ಪರ ಲಾಬಾನ ಯಾಕೊಬನೆ ಮಳಲ್ಪರ ಯಾಕೊಬ ಡೊಂಗರ‍್ಮಾ ತಿನು ಝುಪಡು ಘಾಲಿದ್ಯೊತೊ ಲಾಬಾನಬಿ ತಿನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ತೆಜ಼ ಗಿಲ್ಯಾದ ಡೊಂಗರ‍ಮಾ ಝುಪಡು ಘಾಲಿದ್ಯೊ. <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />ಲಾಬಾನ ಯಾಕೊಬನೆ ಆ ಸು ವ್ಹೈ ತು ಕರಲ? ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ಯುದ್ಧಮಾ ಧರಿನ ಲಾಯೆನಿಂಗತ ಲಿನ ಮನೆ ಕದ್ಯಾವಾಚಿ ತ್ಯಾಂತೊ ಐಪಡ್ಯೊಸ್ತೊ. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />ಕಾ ಮನೆ ಮೊಸ ಕರಿನ ಚೊ಼ರಿ ಕರಲನಿಂಗತ ಐಪಡ್ಯೊ? ಮಿ ಕ್ಹುಶಿಕ್ಹು ತುನೆ ಗಿದ್ದೊ, ನ್ಹಾಚಾಲಾ ವರಿ ಘನ್ನ ತರಾನಾ ವಾದ್ಯೊನಾ ಕ್ಹಾತೆ ತುನೆ ವಳಾತೊತೊ. <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />ತೆನೈಸೊ ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ವರಿ ಮಾರಾ ನಾತ್ನಾ-ನಾತ್ನಿಯೊನೆ ಬಿ ಗಳೆ ಮಳನೆ ನೈ ಥಯಲನಿಂಗತ ಕರ‍್ಯೊಸ ತು ಕರಲ ಪಿಸಾಳಾನು ಕಾಮ ವ್ಹೈ.<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />ತೆ ದೆಶಮಾ ಆವಾನು ಘನ್ನು ಕೆಟ್ಟ ವ್ಹತ್ತು. <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />ತ್ಯುನೆ ಐಗುಪ್ತ ದೆಶತಾ ಲಾಯಲದವಸ ಕ್ಹರಲಪರ ತಿನಾಬಾಬಿ ತುಮೆ ಫರಿನ ಗೈನ ಹಜಿ ದಕ್ಹು ಧಾನ್ಯ ಲಿನ ಆವೊ ಕದ್ಯೊ. <verse eid="GEN 46:2" /><verse number="3" style="v" sid="GEN 46:3" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ ಬಲೈಲಿನ ನೈತೊ ಮಾರು ಮ್ಹೊಡುಬಿ ದೆಕ್ಯು ನೈ ಕೈನ ಕ್ಹರಿಜ಼ ಕದ್ಯೊಸ ತೊ. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />ತು ಮಾರಾ ನ್ಹಾನಾ ಭೈನೆ ಹಮಾರಾ ಕ್ಹಾತೆ ವಳಾಯಾರೆ ಹಮೆ ಗೈನ ತುನೆ ಧಾನ್ಯ ಲಿನ ಐಯೆಸ; <verse eid="GEN 46:4" /><verse number="5" style="v" sid="GEN 46:5" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />ಮಿ ತುಮಾರಾ ಬಾನಿ ಸೆವಾ ಪುರಾ ಮನಸಕ್ಹು ಕರ‍್ಯೊಸ. ತೆ ಕ್ಹಾರು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />ವರಿಬಿ ತುಮಾರೊ ಬಾ ಮನೆಮೊಸ ಕರಿನ ಮಾರೊ ಪಗಾರ ದಖಾಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. ಮನೆ ಕ್ಹುದಾ ತಿನಾಹತಿ ಮೊಸ ಕರಾನೆ ಥಯು ನೈ. <verse eid="GEN 46:7" /><verse number="8" style="v" sid="GEN 46:8" />ತುಮಾರೊ ಬಾ ಮನೆ, ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಬಕ್ರಾ ತುನೆ ಪಗಾರ ರ‍್ಹಯವಾದೆ ಕೈನ ತೆ ಕತಾಮಾ ಕ್ಹಾರಾಜ಼ ಹಿಂಡ ಚಿಕ್ಕಿಯೊನಾ ಥಯಾ.ತೆ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತಾರೊ ಪಗಾರ ಥೈನ ರ‍್ಹವಾದೆ ಕೈನ ಕತಾಮಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಘೆರಿಯೊನಾ ವ್ಹತಾ. <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />ಇಮ್ಮ ಕ್ಹುದಾ ತುಮಾರಾ ಬಾನಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ವರಿ ಜಾನವರೊ ತಕಂತೊ ಕಾಡಿನ ಮನೆ ದಿದ್ಯೊ. <verse eid="GEN 46:9" /><verse number="10" style="v" sid="GEN 46:10" />ಬಕ್ರಾ ಪೆಟ್ಟ ರ‍್ಹತಾಮಾ ಮಿ ಕ್ಹಪನಮಾ ದೆಕ್ತಾಮಾ ಬ್ಕಾವೊನಾ ಕ್ಹಾತೆ ಸಂಗಮ ಕರ್ತಾಮಾ ಬಕ್ರಿಯೊ ಕ್ಹಾರಿಯೊ ಘೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ ಮಚ್ಚೆ ಥೈನ ದಿಕ್ಹಿಯೊ. <verse eid="GEN 46:10" /><verse number="11" style="v" sid="GEN 46:11" />ತೆ ಕ್ಹಪನಮಾ ದೆವದುತ, ಯಾಕೊಬ ಕೈನ ಬಲಾತಾ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 46:11" /><verse number="12" style="v" sid="GEN 46:12" />ತೆ ಮನೆ, ಲಾಬಾನ ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ಬಕ್ರಾ ಸಂಗಮ ಕರಾಲಾ ಬ್ಕರಾವೊನೆ ದೆಕೊ ಗೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ, ಮಚ್ಚನಿ ವ್ಹತಿಯೊ. <verse eid="GEN 46:12" /><verse number="13" style="v" sid="GEN 46:13" />ತಾರಾ ಖಂಬಾನೆ ಅಭಿಶೆಕ ಕರಿನ ಮನೆ ಕ್ಹಮ್ಮ ಕರಲ ಬೆತೆಲನೊ ಕ್ಹುದಾ ಮಿಜ಼ ವ್ಹೈ ಹಮ್ನಾ ತು ಉಟಿನ ಆ ದೆಶನೆ ಛೊಡಿನ ತು ಹುಟ್ಟಲ ದೆಶನೆ ಬಿ ವರಿ ತಾರಾ ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 46:13" /><verse number="14" style="v" sid="GEN 46:14" />ಯಾಕೊಬ ಎ ವಾತೊ ಕದಲ್ಪರ ರಾಹೆಳ ವರಿ ಲೆಯಳ ಹಮಾರಾ ಬಾನಾ ಘರ‍್ಮಾ ಹಮ್ನಾ ಹಮೊನೆ ಸು ಪಾಲ ಛೆ? <verse eid="GEN 46:14" /><verse number="15" style="v" sid="GEN 46:15" />ತೆ ಹನೊನೆ ಬಿಜಾ಼ ವ್ಹೈ ಕೈನ ದೆಕಸ್ತೊ ತೆ ಹಮೊನೆ ಇಕ್ಕಿನ ಹಮೊಕ್ಹು ಮಳಲ ರೊಕ್ಕಾ ತೆ ಯಕ್ಲೊ ಗಳಿಗಯೊಸ್ತೊ. <verse eid="GEN 46:15" /><verse number="16" style="v" sid="GEN 46:16" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಅಪ್ನಾ ಬಾ ಕಂತೊ ಕಾಳಿದಲ ಆಸ್ತಿ ಪುರಾ ಹಮೊನೆ ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ ಕವಸ ತಿಮ್ಮಜ಼ ಕರ ಕೈನ ಉತ್ತರ ದಿದ್ಯಾ. <verse eid="GEN 46:16" /><verse number="17" style="v" sid="GEN 46:17" />ತೆಳಾಮಾ ಯಾಕೊಬ ತಿನಾ ಬಚ್ಚಾವೊನೆ ವರಿ ತಿನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಹುಂಟಪರ ಚ಼ಡಾಯೊ. <verse eid="GEN 46:17" /><verse number="18" style="v" sid="GEN 46:18" />ತೆ ಗಳಸಲ ಕ್ಹಾರಿ ಆಸ್ತಿ ಪದ್ದನ ಅರಾಮ ದೆಶಮಾ ಗಳಸಲ ಕ್ಹಾರಾ ಜಾನವರನೆ ಲಿನ ಕಾನಾನ ದೆಶೆ ತಿನಾ ಬಾ ಥಯಲ ಇಸಾಕಕನ ಚಾಲ್ಯಾ. <verse eid="GEN 46:18" /><verse number="19" style="v" sid="GEN 46:19" />ತೆಳಾಮಾ ಲಾಬಾನ ತಿನಾಬಕ್ರಾನಾ ಬಾಲೊ ಕತ್ರಾನಾ ಹುತಿ ಗಯೊತೊ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ರಾಹೆಲ ತಿನಾ ಬಾನಾ ಘರ್ಮಾ ರ‍್ಹಯಲ ಮೊರ್ತಿಯೊ ಚೊ಼ರಿ ಕರ್ಲಿದಿ. <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />ತೆನೈಸೊ ಯಾಕೊಬ ಅರಾಮ್ಯನೊ ಲಾಬಾನನೆ ತಿಳಸಾಯಾ ವಾಚಿ ತಿನೆ ಮೊಸ ಕರಿನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />ಅಮ್ಮ ತೆ ತಿನಿ ಆಸ್ತಿ ಪುರಾ ಲಿನ ಯುಫ್ರೆಟಿಸ ಮ್ಹೊಟಿ ನದಿನೆ ದಾಟಿನ ಗಿಲ್ಯಾದ ಕವಾನಾ ಡೊಂಗರನಿ ವಾಟ ಧರಿನ. <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />ಯಾಕೊಬ ಫರಿನ ಗಯೆಲ ತನ್ನ ದಿನ್ನ ಥಯಲ್ಪರ ಲಾಬಾನನೆ ಗ್ವತ ಥಾತಾಮಾ. <verse eid="GEN 46:22" /><verse number="23" style="v" sid="GEN 46:23" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />ತೆನೈಸೊ ತೆ ರಾತೆ ಕ್ಹುದಾ ಅರಾಮ್ಯನೊ ಥಯಲ ಲಾಬಾನನಾ ಕ್ಹಪನಮಾ ಐನ ತು ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಚೊ಼ಕು ಕೆಟ್ಟ ಬೊಲ್ಯಾ ಬಗರ ಹುಶಾರಕಿಕ್ಹು ರ‍್ಹೆ ಕದ್ಯೊ. <verse eid="GEN 46:24" /><verse number="25" style="v" sid="GEN 46:25" />ತೆ ಥಯಲ್ಪರ ಲಾಬಾನ ಯಾಕೊಬನೆ ಮಳಲ್ಪರ ಯಾಕೊಬ ಡೊಂಗರ‍್ಮಾ ತಿನು ಝುಪಡು ಘಾಲಿದ್ಯೊತೊ ಲಾಬಾನಬಿ ತಿನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ತೆಜ಼ ಗಿಲ್ಯಾದ ಡೊಂಗರ‍ಮಾ ಝುಪಡು ಘಾಲಿದ್ಯೊ. <verse eid="GEN 46:25" /><verse number="26" style="v" sid="GEN 46:26" />ಲಾಬಾನ ಯಾಕೊಬನೆ ಆ ಸು ವ್ಹೈ ತು ಕರಲ? ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ಯುದ್ಧಮಾ ಧರಿನ ಲಾಯೆನಿಂಗತ ಲಿನ ಮನೆ ಕದ್ಯಾವಾಚಿ ತ್ಯಾಂತೊ ಐಪಡ್ಯೊಸ್ತೊ. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />ಕಾ ಮನೆ ಮೊಸ ಕರಿನ ಚೊ಼ರಿ ಕರಲನಿಂಗತ ಐಪಡ್ಯೊ? ಮಿ ಕ್ಹುಶಿಕ್ಹು ತುನೆ ಗಿದ್ದೊ, ನ್ಹಾಚಾಲಾ ವರಿ ಘನ್ನ ತರಾನಾ ವಾದ್ಯೊನಾ ಕ್ಹಾತೆ ತುನೆ ವಳಾತೊತೊ. <verse eid="GEN 46:27" /><verse number="28" style="v" sid="GEN 46:28" />ತೆನೈಸೊ ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ವರಿ ಮಾರಾ ನಾತ್ನಾ-ನಾತ್ನಿಯೊನೆ ಬಿ ಗಳೆ ಮಳನೆ ನೈ ಥಯಲನಿಂಗತ ಕರ‍್ಯೊಸ ತು ಕರಲ ಪಿಸಾಳಾನು ಕಾಮ ವ್ಹೈ. <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />ತೆನೈಸೊ ತೆ ರಾತೆ ಕ್ಹುದಾ ಅರಾಮ್ಯನೊ ಥಯಲ ಲಾಬಾನನಾ ಕ್ಹಪನಮಾ ಐನ ತು ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಚೊ಼ಕು ಕೆಟ್ಟ <verse eid="GEN 46:30" /><verse number="31" style="v" sid="GEN 46:31" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />ಬೊಲ್ಯಾ ಬಗರ ಹುಶಾರಕಿಕ್ಹು ರ‍್ಹೆ ಕದ್ಯೊ. <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />ಲಾಬಾನನೆ ತಿಳಸಾಯಾ ವಾಚಿ ತಿನೆ ಮೊಸ ಕರಿನ ಗೈಪಡ್ಯೊ.<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />ತೆ ದೆಶಮಾ ಆವಾನು ಘನ್ನು ಕೆಟ್ಟ ವ್ಹತ್ತು. <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />ತ್ಯುನೆ ಐಗುಪ್ತ ದೆಶತಾ ಲಾಯಲದವಸ ಕ್ಹರಲಪರ ತಿನಾಬಾಬಿ ತುಮೆ ಫರಿನ ಗೈನ ಹಜಿ ದಕ್ಹು ಧಾನ್ಯ ಲಿನ ಆವೊ ಕದ್ಯೊ. <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ ಬಲೈಲಿನ ನೈತೊ ಮಾರು ಮ್ಹೊಡುಬಿ ದೆಕ್ಯು ನೈ ಕೈನ ಕ್ಹರಿಜ಼ ಕದ್ಯೊಸ ತೊ. <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />ತು ಮಾರಾ ನ್ಹಾನಾ ಭೈನೆ ಹಮಾರಾ ಕ್ಹಾತೆ ವಳಾಯಾರೆ ಹಮೆ ಗೈನ ತುನೆ ಧಾನ್ಯ ಲಿನ ಐಯೆಸ; <verse eid="GEN 47:4" /><verse number="5" style="v" sid="GEN 47:5" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />ಮಿ ತುಮಾರಾ ಬಾನಿ ಸೆವಾ ಪುರಾ ಮನಸಕ್ಹು ಕರ‍್ಯೊಸ. ತೆ ಕ್ಹಾರು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 47:6" /><verse number="7" style="v" sid="GEN 47:7" />ವರಿಬಿ ತುಮಾರೊ ಬಾ ಮನೆಮೊಸ ಕರಿನ ಮಾರೊ ಪಗಾರ ದಖಾಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. ಮನೆ ಕ್ಹುದಾ ತಿನಾಹತಿ ಮೊಸ ಕರಾನೆ ಥಯು ನೈ. <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />ತುಮಾರೊ ಬಾ ಮನೆ, ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಬಕ್ರಾ ತುನೆ ಪಗಾರ ರ‍್ಹಯವಾದೆ ಕೈನ ತೆ ಕತಾಮಾ ಕ್ಹಾರಾಜ಼ ಹಿಂಡ ಚಿಕ್ಕಿಯೊನಾ ಥಯಾ.ತೆ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತಾರೊ ಪಗಾರ ಥೈನ ರ‍್ಹವಾದೆ ಕೈನ ಕತಾಮಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಘೆರಿಯೊನಾ ವ್ಹತಾ. <verse eid="GEN 47:8" /><verse number="9" style="v" sid="GEN 47:9" />ಇಮ್ಮ ಕ್ಹುದಾ ತುಮಾರಾ ಬಾನಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ವರಿ ಜಾನವರೊ ತಕಂತೊ ಕಾಡಿನ ಮನೆ ದಿದ್ಯೊ. <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />ಬಕ್ರಾ ಪೆಟ್ಟ ರ‍್ಹತಾಮಾ ಮಿ ಕ್ಹಪನಮಾ ದೆಕ್ತಾಮಾ ಬ್ಕಾವೊನಾ ಕ್ಹಾತೆ ಸಂಗಮ ಕರ್ತಾಮಾ ಬಕ್ರಿಯೊ ಕ್ಹಾರಿಯೊ ಘೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ ಮಚ್ಚೆ ಥೈನ ದಿಕ್ಹಿಯೊ. <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />ತೆ ಕ್ಹಪನಮಾ ದೆವದುತ, ಯಾಕೊಬ ಕೈನ ಬಲಾತಾ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />ತೆ ಮನೆ, ಲಾಬಾನ ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ಬಕ್ರಾ ಸಂಗಮ ಕರಾಲಾ ಬ್ಕರಾವೊನೆ ದೆಕೊ ಗೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ, ಮಚ್ಚನಿ ವ್ಹತಿಯೊ. <verse eid="GEN 47:12" /><verse number="13" style="v" sid="GEN 47:13" />ತಾರಾ ಖಂಬಾನೆ ಅಭಿಶೆಕ ಕರಿನ ಮನೆ ಕ್ಹಮ್ಮ ಕರಲ ಬೆತೆಲನೊ ಕ್ಹುದಾ ಮಿಜ಼ ವ್ಹೈ ಹಮ್ನಾ ತು ಉಟಿನ ಆ ದೆಶನೆ ಛೊಡಿನ ತು ಹುಟ್ಟಲ ದೆಶನೆ ಬಿ ವರಿ ತಾರಾ ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />ಯಾಕೊಬ ಎ ವಾತೊ ಕದಲ್ಪರ ರಾಹೆಳ ವರಿ ಲೆಯಳ ಹಮಾರಾ ಬಾನಾ ಘರ‍್ಮಾ ಹಮ್ನಾ ಹಮೊನೆ ಸು ಪಾಲ ಛೆ? <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />ತೆ ಹನೊನೆ ಬಿಜಾ಼ ವ್ಹೈ ಕೈನ ದೆಕಸ್ತೊ ತೆ ಹಮೊನೆ ಇಕ್ಕಿನ ಹಮೊಕ್ಹು ಮಳಲ ರೊಕ್ಕಾ ತೆ ಯಕ್ಲೊ ಗಳಿಗಯೊಸ್ತೊ. <verse eid="GEN 47:15" /><verse number="16" style="v" sid="GEN 47:16" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಅಪ್ನಾ ಬಾ ಕಂತೊ ಕಾಳಿದಲ ಆಸ್ತಿ ಪುರಾ ಹಮೊನೆ ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ ಕವಸ ತಿಮ್ಮಜ಼ ಕರ ಕೈನ ಉತ್ತರ ದಿದ್ಯಾ. <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />ತೆಳಾಮಾ ಯಾಕೊಬ ತಿನಾ ಬಚ್ಚಾವೊನೆ ವರಿ ತಿನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಹುಂಟಪರ ಚ಼ಡಾಯೊ. <verse eid="GEN 47:17" /><verse number="18" style="v" sid="GEN 47:18" />ತೆ ಗಳಸಲ ಕ್ಹಾರಿ ಆಸ್ತಿ ಪದ್ದನ ಅರಾಮ ದೆಶಮಾ ಗಳಸಲ ಕ್ಹಾರಾ ಜಾನವರನೆ ಲಿನ ಕಾನಾನ ದೆಶೆ ತಿನಾ ಬಾ ಥಯಲ ಇಸಾಕಕನ ಚಾಲ್ಯಾ. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />ತೆಳಾಮಾ ಲಾಬಾನ ತಿನಾಬಕ್ರಾನಾ ಬಾಲೊ ಕತ್ರಾನಾ ಹುತಿ ಗಯೊತೊ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ರಾಹೆಲ ತಿನಾ ಬಾನಾ ಘರ್ಮಾ ರ‍್ಹಯಲ ಮೊರ್ತಿಯೊ ಚೊ಼ರಿ ಕರ್ಲಿದಿ. <verse eid="GEN 47:19" /><verse number="20" style="v" sid="GEN 47:20" />ತೆನೈಸೊ ಯಾಕೊಬ ಅರಾಮ್ಯನೊ ಲಾಬಾನನೆ ತಿಳಸಾಯಾ ವಾಚಿ ತಿನೆ ಮೊಸ ಕರಿನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />ಅಮ್ಮ ತೆ ತಿನಿ ಆಸ್ತಿ ಪುರಾ ಲಿನ ಯುಫ್ರೆಟಿಸ ಮ್ಹೊಟಿ ನದಿನೆ ದಾಟಿನ ಗಿಲ್ಯಾದ ಕವಾನಾ ಡೊಂಗರನಿ ವಾಟ ಧರಿನ. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />ಯಾಕೊಬ ಫರಿನ ಗಯೆಲ ತನ್ನ ದಿನ್ನ ಥಯಲ್ಪರ ಲಾಬಾನನೆ ಗ್ವತ ಥಾತಾಮಾ. <verse eid="GEN 47:22" /><verse number="23" style="v" sid="GEN 47:23" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />ತೆನೈಸೊ ತೆ ರಾತೆ ಕ್ಹುದಾ ಅರಾಮ್ಯನೊ ಥಯಲ ಲಾಬಾನನಾ ಕ್ಹಪನಮಾ ಐನ ತು ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಚೊ಼ಕು ಕೆಟ್ಟ ಬೊಲ್ಯಾ ಬಗರ ಹುಶಾರಕಿಕ್ಹು ರ‍್ಹೆ ಕದ್ಯೊ. <verse eid="GEN 47:24" /><verse number="25" style="v" sid="GEN 47:25" />ತೆ ಥಯಲ್ಪರ ಲಾಬಾನ ಯಾಕೊಬನೆ ಮಳಲ್ಪರ ಯಾಕೊಬ ಡೊಂಗರ‍್ಮಾ ತಿನು ಝುಪಡು ಘಾಲಿದ್ಯೊತೊ ಲಾಬಾನಬಿ ತಿನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ತೆಜ಼ ಗಿಲ್ಯಾದ ಡೊಂಗರ‍ಮಾ ಝುಪಡು ಘಾಲಿದ್ಯೊ. <verse eid="GEN 47:25" /><verse number="26" style="v" sid="GEN 47:26" />ಲಾಬಾನ ಯಾಕೊಬನೆ ಆ ಸು ವ್ಹೈ ತು ಕರಲ? ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ಯುದ್ಧಮಾ ಧರಿನ ಲಾಯೆನಿಂಗತ ಲಿನ ಮನೆ ಕದ್ಯಾವಾಚಿ ತ್ಯಾಂತೊ ಐಪಡ್ಯೊಸ್ತೊ. <verse eid="GEN 47:26" /><verse number="27" style="v" sid="GEN 47:27" />ಕಾ ಮನೆ ಮೊಸ ಕರಿನ ಚೊ಼ರಿ ಕರಲನಿಂಗತ ಐಪಡ್ಯೊ? ಮಿ ಕ್ಹುಶಿಕ್ಹು ತುನೆ ಗಿದ್ದೊ, ನ್ಹಾಚಾಲಾ ವರಿ ಘನ್ನ ತರಾನಾ ವಾದ್ಯೊನಾ ಕ್ಹಾತೆ ತುನೆ ವಳಾತೊತೊ. <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />ತೆನೈಸೊ ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ವರಿ ಮಾರಾ ನಾತ್ನಾ-ನಾತ್ನಿಯೊನೆ ಬಿ ಗಳೆ ಮಳನೆ ನೈ ಥಯಲನಿಂಗತ ಕರ‍್ಯೊಸ ತು ಕರಲ ಪಿಸಾಳಾನು ಕಾಮ ವ್ಹೈ. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />ತುಮೊನೆ ಕೆಟ್ಟ ಕರಾನೆ ಮಕನ ತಾಕತ ಶೆ ತೆನೈಸೊ ಕಾಲನಾ ರಾತೆ ತಾರಾ ಬಾನೊ ಕ್ಹುದಾ ಯಾಕೊಬನೆ ಚೊಕು ರ‍್ಹವಾದೆ ಕೆಟ್ಟ ರ‍್ಹವಾದೆ ಬೊಲು ಕದ್ಯಾವಾಚಿ ತಿಮ್ಮಜ಼ ಹುಶಾರಕ್ಹು ರ‍್ಹೆ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />ತೆನೈಸೊ ತುನೆ ತಾರಾ ಬಾನಾ ಘರೆ ಜಾ಼ವಾನಿ ಘನ್ನಿ ಆಸ ರ‍್ಹಯಲಕ್ಹು ತು ಜೌ಼ ಲಾಗ್ಯು ತೆನೈಸೊ ತು ಮಾರಾ ದೆವಸ್ಥಾನೊನೆ ಕಾ ಚೊ಼ರಿ ಕರ‍್ಯೊ? ಕೈನ ಪುಚ್ಯೊ಼. <verse eid="GEN 47:30" /><verse number="31" style="v" sid="GEN 47:31" />ತಿನಾಹುತಿ ಯಾಕೊಬ ಲಾಬಾನನೆ ತು ತಾರಾ ದಿಕ್ರಿಯೊನೆ ಜ಼ಬರದಸ್ತಿಕ್ಹು ಮಕಂತೊ ಕಾಳೆಶಿ ಕೈನ ಭುಚ್ಕಿನ ಐಪಡ್ಯೊ.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />ತೆ ದೆಶಮಾ ಆವಾನು ಘನ್ನು ಕೆಟ್ಟ ವ್ಹತ್ತು. <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />ತ್ಯುನೆ ಐಗುಪ್ತ ದೆಶತಾ ಲಾಯಲದವಸ ಕ್ಹರಲಪರ ತಿನಾಬಾಬಿ ತುಮೆ ಫರಿನ ಗೈನ ಹಜಿ ದಕ್ಹು ಧಾನ್ಯ ಲಿನ ಆವೊ ಕದ್ಯೊ. <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ ಬಲೈಲಿನ ನೈತೊ ಮಾರು ಮ್ಹೊಡುಬಿ ದೆಕ್ಯು ನೈ ಕೈನ ಕ್ಹರಿಜ಼ ಕದ್ಯೊಸ ತೊ. <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />ತು ಮಾರಾ ನ್ಹಾನಾ ಭೈನೆ ಹಮಾರಾ ಕ್ಹಾತೆ ವಳಾಯಾರೆ ಹಮೆ ಗೈನ ತುನೆ ಧಾನ್ಯ ಲಿನ ಐಯೆಸ; <verse eid="GEN 48:4" /><verse number="5" style="v" sid="GEN 48:5" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />ಮಿ ತುಮಾರಾ ಬಾನಿ ಸೆವಾ ಪುರಾ ಮನಸಕ್ಹು ಕರ‍್ಯೊಸ. ತೆ ಕ್ಹಾರು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />ವರಿಬಿ ತುಮಾರೊ ಬಾ ಮನೆಮೊಸ ಕರಿನ ಮಾರೊ ಪಗಾರ ದಖಾಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. ಮನೆ ಕ್ಹುದಾ ತಿನಾಹತಿ ಮೊಸ ಕರಾನೆ ಥಯು ನೈ. <verse eid="GEN 48:7" /><verse number="8" style="v" sid="GEN 48:8" />ತುಮಾರೊ ಬಾ ಮನೆ, ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಬಕ್ರಾ ತುನೆ ಪಗಾರ ರ‍್ಹಯವಾದೆ ಕೈನ ತೆ ಕತಾಮಾ ಕ್ಹಾರಾಜ಼ ಹಿಂಡ ಚಿಕ್ಕಿಯೊನಾ ಥಯಾ.ತೆ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತಾರೊ ಪಗಾರ ಥೈನ ರ‍್ಹವಾದೆ ಕೈನ ಕತಾಮಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಘೆರಿಯೊನಾ ವ್ಹತಾ. <verse eid="GEN 48:8" /><verse number="9" style="v" sid="GEN 48:9" />ಇಮ್ಮ ಕ್ಹುದಾ ತುಮಾರಾ ಬಾನಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ವರಿ ಜಾನವರೊ ತಕಂತೊ ಕಾಡಿನ ಮನೆ ದಿದ್ಯೊ. <verse eid="GEN 48:9" /><verse number="10" style="v" sid="GEN 48:10" />ಬಕ್ರಾ ಪೆಟ್ಟ ರ‍್ಹತಾಮಾ ಮಿ ಕ್ಹಪನಮಾ ದೆಕ್ತಾಮಾ ಬ್ಕಾವೊನಾ ಕ್ಹಾತೆ ಸಂಗಮ ಕರ್ತಾಮಾ ಬಕ್ರಿಯೊ ಕ್ಹಾರಿಯೊ ಘೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ ಮಚ್ಚೆ ಥೈನ ದಿಕ್ಹಿಯೊ. <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />ತೆ ಕ್ಹಪನಮಾ ದೆವದುತ, ಯಾಕೊಬ ಕೈನ ಬಲಾತಾ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 48:11" /><verse number="12" style="v" sid="GEN 48:12" />ತೆ ಮನೆ, ಲಾಬಾನ ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ಬಕ್ರಾ ಸಂಗಮ ಕರಾಲಾ ಬ್ಕರಾವೊನೆ ದೆಕೊ ಗೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ, ಮಚ್ಚನಿ ವ್ಹತಿಯೊ. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />ತಾರಾ ಖಂಬಾನೆ ಅಭಿಶೆಕ ಕರಿನ ಮನೆ ಕ್ಹಮ್ಮ ಕರಲ ಬೆತೆಲನೊ ಕ್ಹುದಾ ಮಿಜ಼ ವ್ಹೈ ಹಮ್ನಾ ತು ಉಟಿನ ಆ ದೆಶನೆ ಛೊಡಿನ ತು ಹುಟ್ಟಲ ದೆಶನೆ ಬಿ ವರಿ ತಾರಾ ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />ಯಾಕೊಬ ಎ ವಾತೊ ಕದಲ್ಪರ ರಾಹೆಳ ವರಿ ಲೆಯಳ ಹಮಾರಾ ಬಾನಾ ಘರ‍್ಮಾ ಹಮ್ನಾ ಹಮೊನೆ ಸು ಪಾಲ ಛೆ? <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />ತೆ ಹನೊನೆ ಬಿಜಾ಼ ವ್ಹೈ ಕೈನ ದೆಕಸ್ತೊ ತೆ ಹಮೊನೆ ಇಕ್ಕಿನ ಹಮೊಕ್ಹು ಮಳಲ ರೊಕ್ಕಾ ತೆ ಯಕ್ಲೊ ಗಳಿಗಯೊಸ್ತೊ. <verse eid="GEN 48:15" /><verse number="16" style="v" sid="GEN 48:16" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಅಪ್ನಾ ಬಾ ಕಂತೊ ಕಾಳಿದಲ ಆಸ್ತಿ ಪುರಾ ಹಮೊನೆ ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ ಕವಸ ತಿಮ್ಮಜ಼ ಕರ ಕೈನ ಉತ್ತರ ದಿದ್ಯಾ. <verse eid="GEN 48:16" /><verse number="17" style="v" sid="GEN 48:17" />ತೆಳಾಮಾ ಯಾಕೊಬ ತಿನಾ ಬಚ್ಚಾವೊನೆ ವರಿ ತಿನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಹುಂಟಪರ ಚ಼ಡಾಯೊ. <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />ತೆ ಗಳಸಲ ಕ್ಹಾರಿ ಆಸ್ತಿ ಪದ್ದನ ಅರಾಮ ದೆಶಮಾ ಗಳಸಲ ಕ್ಹಾರಾ ಜಾನವರನೆ ಲಿನ ಕಾನಾನ ದೆಶೆ ತಿನಾ ಬಾ ಥಯಲ ಇಸಾಕಕನ ಚಾಲ್ಯಾ. <verse eid="GEN 48:18" /><verse number="19" style="v" sid="GEN 48:19" />ತೆಳಾಮಾ ಲಾಬಾನ ತಿನಾಬಕ್ರಾನಾ ಬಾಲೊ ಕತ್ರಾನಾ ಹುತಿ ಗಯೊತೊ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ರಾಹೆಲ ತಿನಾ ಬಾನಾ ಘರ್ಮಾ ರ‍್ಹಯಲ ಮೊರ್ತಿಯೊ ಚೊ಼ರಿ ಕರ್ಲಿದಿ. <verse eid="GEN 48:19" /><verse number="20" style="v" sid="GEN 48:20" />ತೆನೈಸೊ ಯಾಕೊಬ ಅರಾಮ್ಯನೊ ಲಾಬಾನನೆ ತಿಳಸಾಯಾ ವಾಚಿ ತಿನೆ ಮೊಸ ಕರಿನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 48:20" /><verse number="21" style="v" sid="GEN 48:21" />ಅಮ್ಮ ತೆ ತಿನಿ ಆಸ್ತಿ ಪುರಾ ಲಿನ ಯುಫ್ರೆಟಿಸ ಮ್ಹೊಟಿ ನದಿನೆ ದಾಟಿನ ಗಿಲ್ಯಾದ ಕವಾನಾ ಡೊಂಗರನಿ ವಾಟ ಧರಿನ. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />ಯಾಕೊಬ ಫರಿನ ಗಯೆಲ ತನ್ನ ದಿನ್ನ ಥಯಲ್ಪರ ಲಾಬಾನನೆ ಗ್ವತ ಥಾತಾಮಾ.<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />ತೆ ದೆಶಮಾ ಆವಾನು ಘನ್ನು ಕೆಟ್ಟ ವ್ಹತ್ತು. <verse eid="GEN 49:1" /><verse number="2" style="v" sid="GEN 49:2" />ತ್ಯುನೆ ಐಗುಪ್ತ ದೆಶತಾ ಲಾಯಲದವಸ ಕ್ಹರಲಪರ ತಿನಾಬಾಬಿ ತುಮೆ ಫರಿನ ಗೈನ ಹಜಿ ದಕ್ಹು ಧಾನ್ಯ ಲಿನ ಆವೊ ಕದ್ಯೊ. <verse eid="GEN 49:2" /><verse number="3" style="v" sid="GEN 49:3" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ ಬಲೈಲಿನ ನೈತೊ ಮಾರು ಮ್ಹೊಡುಬಿ ದೆಕ್ಯು ನೈ ಕೈನ ಕ್ಹರಿಜ಼ ಕದ್ಯೊಸ ತೊ. <verse eid="GEN 49:3" /><verse number="4" style="v" sid="GEN 49:4" />ತು ಮಾರಾ ನ್ಹಾನಾ ಭೈನೆ ಹಮಾರಾ ಕ್ಹಾತೆ ವಳಾಯಾರೆ ಹಮೆ ಗೈನ ತುನೆ ಧಾನ್ಯ ಲಿನ ಐಯೆಸ; <verse eid="GEN 49:4" /><verse number="5" style="v" sid="GEN 49:5" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ <verse eid="GEN 49:5" /><verse number="6" style="v" sid="GEN 49:6" />ಮಿ ತುಮಾರಾ ಬಾನಿ ಸೆವಾ ಪುರಾ ಮನಸಕ್ಹು ಕರ‍್ಯೊಸ. ತೆ ಕ್ಹಾರು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 49:6" /><verse number="7" style="v" sid="GEN 49:7" />ವರಿಬಿ ತುಮಾರೊ ಬಾ ಮನೆಮೊಸ ಕರಿನ ಮಾರೊ ಪಗಾರ ದಖಾಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. ಮನೆ ಕ್ಹುದಾ ತಿನಾಹತಿ ಮೊಸ ಕರಾನೆ ಥಯು ನೈ. <verse eid="GEN 49:7" /><verse number="8" style="v" sid="GEN 49:8" />ತುಮಾರೊ ಬಾ ಮನೆ, ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಬಕ್ರಾ ತುನೆ ಪಗಾರ ರ‍್ಹಯವಾದೆ ಕೈನ ತೆ ಕತಾಮಾ ಕ್ಹಾರಾಜ಼ ಹಿಂಡ ಚಿಕ್ಕಿಯೊನಾ ಥಯಾ.ತೆ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತಾರೊ ಪಗಾರ ಥೈನ ರ‍್ಹವಾದೆ ಕೈನ ಕತಾಮಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಘೆರಿಯೊನಾ ವ್ಹತಾ. <verse eid="GEN 49:8" /><verse number="9" style="v" sid="GEN 49:9" />ಇಮ್ಮ ಕ್ಹುದಾ ತುಮಾರಾ ಬಾನಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ವರಿ ಜಾನವರೊ ತಕಂತೊ ಕಾಡಿನ ಮನೆ ದಿದ್ಯೊ. <verse eid="GEN 49:9" /><verse number="10" style="v" sid="GEN 49:10" />ಬಕ್ರಾ ಪೆಟ್ಟ ರ‍್ಹತಾಮಾ ಮಿ ಕ್ಹಪನಮಾ ದೆಕ್ತಾಮಾ ಬ್ಕಾವೊನಾ ಕ್ಹಾತೆ ಸಂಗಮ ಕರ್ತಾಮಾ ಬಕ್ರಿಯೊ ಕ್ಹಾರಿಯೊ ಘೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ ಮಚ್ಚೆ ಥೈನ ದಿಕ್ಹಿಯೊ. <verse eid="GEN 49:10" /><verse number="11" style="v" sid="GEN 49:11" />ತೆ ಕ್ಹಪನಮಾ ದೆವದುತ, ಯಾಕೊಬ ಕೈನ ಬಲಾತಾ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 49:11" /><verse number="12" style="v" sid="GEN 49:12" />ತೆ ಮನೆ, ಲಾಬಾನ ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ಬಕ್ರಾ ಸಂಗಮ ಕರಾಲಾ ಬ್ಕರಾವೊನೆ ದೆಕೊ ಗೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ, ಮಚ್ಚನಿ ವ್ಹತಿಯೊ. <verse eid="GEN 49:12" /><verse number="13" style="v" sid="GEN 49:13" />ತಾರಾ ಖಂಬಾನೆ ಅಭಿಶೆಕ ಕರಿನ ಮನೆ ಕ್ಹಮ್ಮ ಕರಲ ಬೆತೆಲನೊ ಕ್ಹುದಾ ಮಿಜ಼ ವ್ಹೈ ಹಮ್ನಾ ತು ಉಟಿನ ಆ ದೆಶನೆ ಛೊಡಿನ ತು ಹುಟ್ಟಲ ದೆಶನೆ ಬಿ ವರಿ ತಾರಾ ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 49:13" /><verse number="14" style="v" sid="GEN 49:14" />ಯಾಕೊಬ ಎ ವಾತೊ ಕದಲ್ಪರ ರಾಹೆಳ ವರಿ ಲೆಯಳ ಹಮಾರಾ ಬಾನಾ ಘರ‍್ಮಾ ಹಮ್ನಾ ಹಮೊನೆ ಸು ಪಾಲ ಛೆ? <verse eid="GEN 49:14" /><verse number="15" style="v" sid="GEN 49:15" />ತೆ ಹನೊನೆ ಬಿಜಾ಼ ವ್ಹೈ ಕೈನ ದೆಕಸ್ತೊ ತೆ ಹಮೊನೆ ಇಕ್ಕಿನ ಹಮೊಕ್ಹು ಮಳಲ ರೊಕ್ಕಾ ತೆ ಯಕ್ಲೊ ಗಳಿಗಯೊಸ್ತೊ. <verse eid="GEN 49:15" /><verse number="16" style="v" sid="GEN 49:16" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಅಪ್ನಾ ಬಾ ಕಂತೊ ಕಾಳಿದಲ ಆಸ್ತಿ ಪುರಾ ಹಮೊನೆ ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ ಕವಸ ತಿಮ್ಮಜ಼ ಕರ ಕೈನ ಉತ್ತರ ದಿದ್ಯಾ. <verse eid="GEN 49:16" /><verse number="17" style="v" sid="GEN 49:17" />ತೆಳಾಮಾ ಯಾಕೊಬ ತಿನಾ ಬಚ್ಚಾವೊನೆ ವರಿ ತಿನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಹುಂಟಪರ ಚ಼ಡಾಯೊ. <verse eid="GEN 49:17" /><verse number="18" style="v" sid="GEN 49:18" />ತೆ ಗಳಸಲ ಕ್ಹಾರಿ ಆಸ್ತಿ ಪದ್ದನ ಅರಾಮ ದೆಶಮಾ ಗಳಸಲ ಕ್ಹಾರಾ ಜಾನವರನೆ ಲಿನ ಕಾನಾನ ದೆಶೆ ತಿನಾ ಬಾ ಥಯಲ ಇಸಾಕಕನ ಚಾಲ್ಯಾ. <verse eid="GEN 49:18" /><verse number="19" style="v" sid="GEN 49:19" />ತೆಳಾಮಾ ಲಾಬಾನ ತಿನಾಬಕ್ರಾನಾ ಬಾಲೊ ಕತ್ರಾನಾ ಹುತಿ ಗಯೊತೊ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ರಾಹೆಲ ತಿನಾ ಬಾನಾ ಘರ್ಮಾ ರ‍್ಹಯಲ ಮೊರ್ತಿಯೊ ಚೊ಼ರಿ ಕರ್ಲಿದಿ. <verse eid="GEN 49:19" /><verse number="20" style="v" sid="GEN 49:20" />ತೆನೈಸೊ ಯಾಕೊಬ ಅರಾಮ್ಯನೊ ಲಾಬಾನನೆ ತಿಳಸಾಯಾ ವಾಚಿ ತಿನೆ ಮೊಸ ಕರಿನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 49:20" /><verse number="21" style="v" sid="GEN 49:21" />ಅಮ್ಮ ತೆ ತಿನಿ ಆಸ್ತಿ ಪುರಾ ಲಿನ ಯುಫ್ರೆಟಿಸ ಮ್ಹೊಟಿ ನದಿನೆ ದಾಟಿನ ಗಿಲ್ಯಾದ ಕವಾನಾ ಡೊಂಗರನಿ ವಾಟ ಧರಿನ. <verse eid="GEN 49:21" /><verse number="22" style="v" sid="GEN 49:22" />ಯಾಕೊಬ ಫರಿನ ಗಯೆಲ ತನ್ನ ದಿನ್ನ ಥಯಲ್ಪರ ಲಾಬಾನನೆ ಗ್ವತ ಥಾತಾಮಾ. <verse eid="GEN 49:22" /><verse number="23" style="v" sid="GEN 49:23" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 49:23" /><verse number="24" style="v" sid="GEN 49:24" />ತೆನೈಸೊ ತೆ ರಾತೆ ಕ್ಹುದಾ ಅರಾಮ್ಯನೊ ಥಯಲ ಲಾಬಾನನಾ ಕ್ಹಪನಮಾ ಐನ ತು ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಚೊ಼ಕು ಕೆಟ್ಟ ಬೊಲ್ಯಾ ಬಗರ ಹುಶಾರಕಿಕ್ಹು ರ‍್ಹೆ ಕದ್ಯೊ. <verse eid="GEN 49:24" /><verse number="25" style="v" sid="GEN 49:25" />ತೆ ಥಯಲ್ಪರ ಲಾಬಾನ ಯಾಕೊಬನೆ ಮಳಲ್ಪರ ಯಾಕೊಬ ಡೊಂಗರ‍್ಮಾ ತಿನು ಝುಪಡು ಘಾಲಿದ್ಯೊತೊ ಲಾಬಾನಬಿ ತಿನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ತೆಜ಼ ಗಿಲ್ಯಾದ ಡೊಂಗರ‍ಮಾ ಝುಪಡು ಘಾಲಿದ್ಯೊ. <verse eid="GEN 49:25" /><verse number="26" style="v" sid="GEN 49:26" />ಲಾಬಾನ ಯಾಕೊಬನೆ ಆ ಸು ವ್ಹೈ ತು ಕರಲ? ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ಯುದ್ಧಮಾ ಧರಿನ ಲಾಯೆನಿಂಗತ ಲಿನ ಮನೆ ಕದ್ಯಾವಾಚಿ ತ್ಯಾಂತೊ ಐಪಡ್ಯೊಸ್ತೊ. <verse eid="GEN 49:26" /><verse number="27" style="v" sid="GEN 49:27" />ಕಾ ಮನೆ ಮೊಸ ಕರಿನ ಚೊ಼ರಿ ಕರಲನಿಂಗತ ಐಪಡ್ಯೊ? ಮಿ ಕ್ಹುಶಿಕ್ಹು ತುನೆ ಗಿದ್ದೊ, ನ್ಹಾಚಾಲಾ ವರಿ ಘನ್ನ ತರಾನಾ ವಾದ್ಯೊನಾ ಕ್ಹಾತೆ ತುನೆ ವಳಾತೊತೊ. <verse eid="GEN 49:27" /><verse number="28" style="v" sid="GEN 49:28" />ತೆನೈಸೊ ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ವರಿ ಮಾರಾ ನಾತ್ನಾ-ನಾತ್ನಿಯೊನೆ ಬಿ ಗಳೆ ಮಳನೆ ನೈ ಥಯಲನಿಂಗತ ಕರ‍್ಯೊಸ ತು ಕರಲ ಪಿಸಾಳಾನು ಕಾಮ ವ್ಹೈ. <verse eid="GEN 49:28" /><verse number="29" style="v" sid="GEN 49:29" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />ತೆನೈಸೊ ತೆ ರಾತೆ ಕ್ಹುದಾ ಅರಾಮ್ಯನೊ ಥಯಲ ಲಾಬಾನನಾ ಕ್ಹಪನಮಾ ಐನ ತು ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಚೊ಼ಕು ಕೆಟ್ಟ <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 49:32" /><verse number="33" style="v" sid="GEN 49:33" />ಬೊಲ್ಯಾ ಬಗರ ಹುಶಾರಕಿಕ್ಹು ರ‍್ಹೆ ಕದ್ಯೊ.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />ತೆ ದೆಶಮಾ ಆವಾನು ಘನ್ನು ಕೆಟ್ಟ ವ್ಹತ್ತು. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />ತ್ಯುನೆ ಐಗುಪ್ತ ದೆಶತಾ ಲಾಯಲದವಸ ಕ್ಹರಲಪರ ತಿನಾಬಾಬಿ ತುಮೆ ಫರಿನ ಗೈನ ಹಜಿ ದಕ್ಹು ಧಾನ್ಯ ಲಿನ ಆವೊ ಕದ್ಯೊ. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ ಬಲೈಲಿನ ನೈತೊ ಮಾರು ಮ್ಹೊಡುಬಿ ದೆಕ್ಯು ನೈ ಕೈನ ಕ್ಹರಿಜ಼ ಕದ್ಯೊಸ ತೊ. <verse eid="GEN 50:3" /><verse number="4" style="v" sid="GEN 50:4" />ತು ಮಾರಾ ನ್ಹಾನಾ ಭೈನೆ ಹಮಾರಾ ಕ್ಹಾತೆ ವಳಾಯಾರೆ ಹಮೆ ಗೈನ ತುನೆ ಧಾನ್ಯ ಲಿನ ಐಯೆಸ; <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />ತಿನೆ ಯೆಹುದಾ ತೆ ಮನಕ್ಹ ಮನೆ ತಾರಾ ಭೈನೆ <verse eid="GEN 50:5" /><verse number="6" style="v" sid="GEN 50:6" />ಮಿ ತುಮಾರಾ ಬಾನಿ ಸೆವಾ ಪುರಾ ಮನಸಕ್ಹು ಕರ‍್ಯೊಸ. ತೆ ಕ್ಹಾರು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="GEN 50:6" /><verse number="7" style="v" sid="GEN 50:7" />ವರಿಬಿ ತುಮಾರೊ ಬಾ ಮನೆಮೊಸ ಕರಿನ ಮಾರೊ ಪಗಾರ ದಖಾಸಲಾ ಬದಲಿ ಕರ‍್ಯೊ. ಮನೆ ಕ್ಹುದಾ ತಿನಾಹತಿ ಮೊಸ ಕರಾನೆ ಥಯು ನೈ. <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />ತುಮಾರೊ ಬಾ ಮನೆ, ಚಿಕ್ಕಿಯೊ ರ‍್ಹಯಲ ಬಕ್ರಾ ತುನೆ ಪಗಾರ ರ‍್ಹಯವಾದೆ ಕೈನ ತೆ ಕತಾಮಾ ಕ್ಹಾರಾಜ಼ ಹಿಂಡ ಚಿಕ್ಕಿಯೊನಾ ಥಯಾ.ತೆ ಘೆರಿಯೊ ರ‍್ಹಯಲ ತಾರೊ ಪಗಾರ ಥೈನ ರ‍್ಹವಾದೆ ಕೈನ ಕತಾಮಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಘೆರಿಯೊನಾ ವ್ಹತಾ. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />ಇಮ್ಮ ಕ್ಹುದಾ ತುಮಾರಾ ಬಾನಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ವರಿ ಜಾನವರೊ ತಕಂತೊ ಕಾಡಿನ ಮನೆ ದಿದ್ಯೊ. <verse eid="GEN 50:9" /><verse number="10" style="v" sid="GEN 50:10" />ಬಕ್ರಾ ಪೆಟ್ಟ ರ‍್ಹತಾಮಾ ಮಿ ಕ್ಹಪನಮಾ ದೆಕ್ತಾಮಾ ಬ್ಕಾವೊನಾ ಕ್ಹಾತೆ ಸಂಗಮ ಕರ್ತಾಮಾ ಬಕ್ರಿಯೊ ಕ್ಹಾರಿಯೊ ಘೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ ಮಚ್ಚೆ ಥೈನ ದಿಕ್ಹಿಯೊ. <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />ತೆ ಕ್ಹಪನಮಾ ದೆವದುತ, ಯಾಕೊಬ ಕೈನ ಬಲಾತಾ ಮಿ ನ್ಹ್ಯಾ ಛೆ ಕೈನ ಕತಾಮಾ <verse eid="GEN 50:11" /><verse number="12" style="v" sid="GEN 50:12" />ತೆ ಮನೆ, ಲಾಬಾನ ತಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿಲಿದಲ ತರಿಕೊ ಮಿ ದೆಕ್ಯೊಸ, ತಿನಾಹುತಿ ಡೊಳೊ ಉಚೈನ ಬಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ಬಕ್ರಾ ಸಂಗಮ ಕರಾಲಾ ಬ್ಕರಾವೊನೆ ದೆಕೊ ಗೆರಿಯೊ, ಚಿಕ್ಕಿಯೊ, ಮಚ್ಚನಿ ವ್ಹತಿಯೊ. <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />ತಾರಾ ಖಂಬಾನೆ ಅಭಿಶೆಕ ಕರಿನ ಮನೆ ಕ್ಹಮ್ಮ ಕರಲ ಬೆತೆಲನೊ ಕ್ಹುದಾ ಮಿಜ಼ ವ್ಹೈ ಹಮ್ನಾ ತು ಉಟಿನ ಆ ದೆಶನೆ ಛೊಡಿನ ತು ಹುಟ್ಟಲ ದೆಶನೆ ಬಿ ವರಿ ತಾರಾ ಕ್ಹಾಂದಾನ ಕನ ಫರಿನ ಜಾ಼ ಕೈನ ಕದ್ಯೊ. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />ಯಾಕೊಬ ಎ ವಾತೊ ಕದಲ್ಪರ ರಾಹೆಳ ವರಿ ಲೆಯಳ ಹಮಾರಾ ಬಾನಾ ಘರ‍್ಮಾ ಹಮ್ನಾ ಹಮೊನೆ ಸು ಪಾಲ ಛೆ? <verse eid="GEN 50:14" /><verse number="15" style="v" sid="GEN 50:15" />ತೆ ಹನೊನೆ ಬಿಜಾ಼ ವ್ಹೈ ಕೈನ ದೆಕಸ್ತೊ ತೆ ಹಮೊನೆ ಇಕ್ಕಿನ ಹಮೊಕ್ಹು ಮಳಲ ರೊಕ್ಕಾ ತೆ ಯಕ್ಲೊ ಗಳಿಗಯೊಸ್ತೊ. <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಅಪ್ನಾ ಬಾ ಕಂತೊ ಕಾಳಿದಲ ಆಸ್ತಿ ಪುರಾ ಹಮೊನೆ ಬಿ ವರಿ ಹಮಾರಾ ಬಚ್ಚಾವೊನೆ ಬಿ ದಿದ್ಯೊಸ್ತೊ ಕ್ಹುದಾ ಕಿಮ ಕವಸ ತಿಮ್ಮಜ಼ ಕರ ಕೈನ ಉತ್ತರ ದಿದ್ಯಾ. <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />ತೆಳಾಮಾ ಯಾಕೊಬ ತಿನಾ ಬಚ್ಚಾವೊನೆ ವರಿ ತಿನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಹುಂಟಪರ ಚ಼ಡಾಯೊ. <verse eid="GEN 50:17" /><verse number="18" style="v" sid="GEN 50:18" />ತೆ ಗಳಸಲ ಕ್ಹಾರಿ ಆಸ್ತಿ ಪದ್ದನ ಅರಾಮ ದೆಶಮಾ ಗಳಸಲ ಕ್ಹಾರಾ ಜಾನವರನೆ ಲಿನ ಕಾನಾನ ದೆಶೆ ತಿನಾ ಬಾ ಥಯಲ ಇಸಾಕಕನ ಚಾಲ್ಯಾ. <verse eid="GEN 50:18" /><verse number="19" style="v" sid="GEN 50:19" />ತೆಳಾಮಾ ಲಾಬಾನ ತಿನಾಬಕ್ರಾನಾ ಬಾಲೊ ಕತ್ರಾನಾ ಹುತಿ ಗಯೊತೊ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ರಾಹೆಲ ತಿನಾ ಬಾನಾ ಘರ್ಮಾ ರ‍್ಹಯಲ ಮೊರ್ತಿಯೊ ಚೊ಼ರಿ ಕರ್ಲಿದಿ. <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />ತೆನೈಸೊ ಯಾಕೊಬ ಅರಾಮ್ಯನೊ ಲಾಬಾನನೆ ತಿಳಸಾಯಾ ವಾಚಿ ತಿನೆ ಮೊಸ ಕರಿನ ಗೈಪಡ್ಯೊ. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />ಅಮ್ಮ ತೆ ತಿನಿ ಆಸ್ತಿ ಪುರಾ ಲಿನ ಯುಫ್ರೆಟಿಸ ಮ್ಹೊಟಿ ನದಿನೆ ದಾಟಿನ ಗಿಲ್ಯಾದ ಕವಾನಾ ಡೊಂಗರನಿ ವಾಟ ಧರಿನ. <verse eid="GEN 50:21" /><verse number="22" style="v" sid="GEN 50:22" />ಯಾಕೊಬ ಫರಿನ ಗಯೆಲ ತನ್ನ ದಿನ್ನ ಥಯಲ್ಪರ ಲಾಬಾನನೆ ಗ್ವತ ಥಾತಾಮಾ. <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />ತೆ ತಿನಾ ಸಂಬಧಿಕೊನೆ ಮಳೈನ ಕ್ಹಾತ ದಿನ್ನ ಪ್ರಯಾಣ ಕರಿನ ಯಾಕೊಬನಾ ಪಾಚೊ಼ ಗೈನ ಗಿಲ್ಯಾದ ಡೊಂಗರನಾ ಗಾಮ್ಮಾ ತಿನೆ ಮಳ್ಯೊ. <verse eid="GEN 50:23" /><verse number="24" style="v" sid="GEN 50:24" />ತೆನೈಸೊ ತೆ ರಾತೆ ಕ್ಹುದಾ ಅರಾಮ್ಯನೊ ಥಯಲ ಲಾಬಾನನಾ ಕ್ಹಪನಮಾ ಐನ ತು ಯಾಕೊಬನಾ ಕ್ಹಾತೆ ಚೊ಼ಕು ಕೆಟ್ಟ ಬೊಲ್ಯಾ ಬಗರ ಹುಶಾರಕಿಕ್ಹು ರ‍್ಹೆ ಕದ್ಯೊ. <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />ತೆ ಥಯಲ್ಪರ ಲಾಬಾನ ಯಾಕೊಬನೆ ಮಳಲ್ಪರ ಯಾಕೊಬ ಡೊಂಗರ‍್ಮಾ ತಿನು ಝುಪಡು ಘಾಲಿದ್ಯೊತೊ ಲಾಬಾನಬಿ ತಿನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ತೆಜ಼ ಗಿಲ್ಯಾದ ಡೊಂಗರ‍ಮಾ ಝುಪಡು ಘಾಲಿದ್ಯೊ. <verse eid="GEN 50:25" /><verse number="26" style="v" sid="GEN 50:26" />ಲಾಬಾನ ಯಾಕೊಬನೆ ಆ ಸು ವ್ಹೈ ತು ಕರಲ? ತು ಮಾರಾ ದಿಕ್ರಿಯೊನೆ ಯುದ್ಧಮಾ ಧರಿನ ಲಾಯೆನಿಂಗತ ಲಿನ ಮನೆ ಕದ್ಯಾವಾಚಿ ತ್ಯಾಂತೊ ಐಪಡ್ಯೊಸ್ತೊ.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>