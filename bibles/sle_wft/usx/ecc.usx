<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Sikkiligar</book>
  <para style="h">ಪ್ರಸಂಗಿ</para>
  <para style="toc3">ಪ್ರಸಂಗಿ</para>
  <para style="toc1">ಪ್ರಸಂಗಿ ಬುಕ್ಕ ಪ್ರಸಂಗಿನು</para>
  <para style="mt1">ಪ್ರಸಂಗಿ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಪ್ರಸಂಗಿ ಪುಸ್ತಕ ಜಿವನನಿ ಗ್ಯಾನ ಹುತಿ ಶಿಕ್ಲಾವಸ ಹಿಬ್ರುಮಾ ಎ ಪುಸ್ತಕ ಶಿರೊನಾಮ ಇನೊ ಮತ್ಲಬ ಸುವು ಕದ್ಯಾಮ ಮನಕ್ಹೊನೆ ಮಳಾವಾನು ಘನ್ನಾ ಅದ್ಯಾಯನ ಕರಾಲಾ ಉಪದೆಶ ಪುಸ್ತಕ ಲಿಕ್ಕಲವಾಲೊ ರಾಜೊ಼ ಸಲೊಮೊನ ವ್ಹೈ ಕೈನ ಬರೊಕ್ಹೊ ಕರಸ. ತೆ ನೈಸೊ ಎ ಹಜು಼ನ ದಕ್ಹಾನಾ ಬರೊಕ್ಹೊ ಕರ್ತಾ ನೈ. ತೆನೈಸೊ ಎ ಪುಸ್ತಕ ಬರ್ದಲ ರ‍್ಹವತ್ತೊ ಕಮ್ಸಿ ಕಮ್ಮ ಕ್ರಿಸ್ತ ಪುರ್ವ 970-931 ಕ್ರಿಸ್ತ ಪುರ್ವ ವಕ್ಹತಮಾ ಬರ್ದಲ ವಸ, ಎ ವಕ್ಹತಮಾ ತೆ ಜಿವ್ತೊ ವ್ಹತೊ.ಹುಜು಼ನ ಉಗ್ರಲ ಅದ್ಯಾಯನ ಕರಲವಾಲಾ ಎ ವರಿ ಬಿಜು಼ ಬರದ್ಯಾವಸ ಕೈನ ಬರೊಕ್ಹೊ ಕರಸ. ಕಾ ಕದ್ಯಾಮ ಎ ಕಾಲಮಾ ಉಪಯೊಗ ಕರಲ ಭಾಶೆ ಯಕ್ಕ ರಾಜಾ಼ ನಿಂಗತ ಛೆ. ವರಿ ಯಕ್ಕ ಸೆವಕ ನಿಂಗತ ಛೆ. (ಪ್ರಸಂಗಿ 5:8-9) ತೆ ಅದ್ಯಾಯನ ಕರಾಲಾ ಪ್ರಸಂಗಿನು ಪುಸ್ತಕ ಸಲೊಮೊನನಾ ಘನ್ನಾ ಕಾಲ್ಪರ ಬರ್ದ್ಯಾಸ ಕೈನ ವಿಚಾರ ಕರಸ. ತೆ ಕಾಲ ಕದ್ಯಾಮ ಕ್ರಿಸ್ತ ಪುರ್ವ 400 ಮತ್ತು 200 ಕ್ರಿಸ್ತ ಪುರ್ವ ನಾ ವಚ್ಮಾ಼ .</para>
  <para style="ip">ಪ್ರಸಂಗಿ ಕ್ಹಾರುಜ಼ ಯಕ್ಕಜ಼ ಉಸು ನಿಂಗತ ಗಪಕ್ನೆ ಗಾಯಬ ಥೈನ ಜಾ಼ವಾನು ಕವಾನಾ ಮುಲಕ ಶುರು ಥಾವಸ 1:2 ಇನೊ ಮತ್ಲಬ ಸುವೈ ಕದ್ಯಾಮ ಅಪ್ನಾ ಜಿವನನಾ ಕಾಮೊ ತಾತ್ಕಾಜ಼ ವ್ಹೈ ವರಿ ಕಳೈಲಿವಾನು ತ್ರಾಸ ಛೆ ಇಮಾನು ಘನ್ನಿಯೊ ಸಂಗತಿ ದಕ್ಹಾ ವಕ್ತಮಾ ಇಕ್ಹ್ರಾಯೊಸಿಮಾನಿಯೊ ಘನ್ನಿಯೊ ಸಂಗತಿಯೊ ಅಪ್ನಾ ಹತ್ಮಾ ನೈ ರ‍್ಹತಿಯೊ ಜಿವನ ರ‍್ಹಯಲ ತಮ್ಮಜ಼ ವಪ್ಪಿಲಿವಾನೆ ವರಿ ರ‍್ಹಯಲಮಾಜ಼ ಕ್ಹುಶಿಕ್ಹು ರ‍್ಹವಾನು ಚೊ಼ಕು ವ್ಹೈ. 9:9. ಜಿನವನನಿ ತ್ರಾಸೊ ವರಿ ಕ್ಹುಶಿ ಕ್ಹುದಾನೆ ಭುಚ್ಕಾಲಾ ವರಿ ತಿನಿ ಅಗನ್ಯಾ ಪಾಲಿಸಾನಾ ಹುತಿ ಕತಾ ಪುಸ್ತಕ ಖಲಾಸ ಥಾವಸ 12:13. ತೆ ಘನ್ನಿ ಖಾಸ ವಿಶಯ ವ್ಹೈ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1. ಪ್ರಸಂಗಿ 1 ನೆ ಅಧ್ಯಾಯಮಾ 1 ತು 11 ನೆ ವಚನಾ ಪುಸ್ತಕಮಾ ಬರ್ದಲವಾವೊನೆ ವರಿ ತ್ಯುನಾ ದಕ್ಹಾ ಜಿವ್ನಾ ಅನುಭವಿಸಾನು ವಳಕೈನ ದಿವಸ.</para>
  <para style="io1">2. ಅಧ್ಯಾಯ 1:12 ತಿ 6:9 ಲಕ್ಕಾ ಜಿವನನು ಮತ್ಲಬ ಚರ್ಚಾಕರಸ.</para>
  <para style="io1">3. ಅಧ್ಯಾಯ 6:10 ತು 12:8 ಮಾಸ್ತಾರೊನೆ ಸಲಹೆಯ ದಿವಸ.</para>
  <para style="io1">4. ಲಾಸ್ಟಮಾ , ಅಧ್ಯಾಯ 12 ವಚನತು 9 ತು 14 ಲಕ್ಕಾ ಜಿವಣು ಕ್ಹಾರುಜ಼ ಉದ್ದೆಶ ಕ್ಹುದಾನೆ ಭುಚ್ಕಾನು ವರಿ ಆಗನ್ಯಾನೆ ಪಾಲನಾ ಕರಾನು ಕೈನ ಕವಾನಾ ಮುಲಕ ಪುಸ್ತಕಮಾ ಮುಕ್ತಾಯಾ ಥಾವಸ.</para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s">ಜಿಂದಗಿ ವ್ಯರ್ಥ ವ್ಹೈ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />ಎ ಯೆರುಸಲೆಮಮಾ ರಾಜೊ಼ ಥಯಲ ‘ದಾವಿದನೊ’ ದಿಕ್ರೊ ಥಯಲ ಪ್ರಸಂಗಿ ‘ಶಿಕ್ಲಾವಾನಾ’ ವಾತೊ ವ್ಹೈ. <verse eid="ECC 1:1" /><verse number="2" style="v" sid="ECC 1:2" />ಪ್ರಸಂಗಿ ಅಮ್ಮ ಕವಸ "ವ್ಯರ್ಥಜ಼ ವ್ಯರ್ಥ ವ್ಹೈ, ಪುರಾಜ಼ ವ್ಯರ್ಥ ವ್ಹೈ, ಕ್ಹಾರುಜ಼ ವ್ಯರ್ಥ ವ್ಹೈ. <verse eid="ECC 1:2" /><verse number="3" style="v" sid="ECC 1:3" />ಮನಕ್ಹ ಎ ಲೊಕಮಾ ಕರಾನು ಕ್ಹಾರು ಪ್ರಯಾಸಕ್ಹು ತಿನೆ ಸು ಲಾಭ ಛೆ? <verse eid="ECC 1:3" /><verse number="4" style="v" sid="ECC 1:4" />ಯಕ್ಕ ಸಂತತಿ ನಾಶ ಥಾವಸ, ವರಿಯಕ್ಕ ಸಂತತಿ ಆವಸ. ತೆನೈಸೊ ಜಿಮಿನತಬಿ ಶಾಶ್ವತ ಥೈನ ಹುಬ್ರ್ಯವಸ. <verse eid="ECC 1:4" /><verse number="5" style="v" sid="ECC 1:5" />ಸುರ್ಯೊ ಹುಟ್ಟಸ, ಸುರ್ಯೊ ಡುಬಸ, ತೆ ಜಾ಼ವಾನಿ ಜ಼ಗಾನೆ ಭೆಗಿನ ಫರಿನ ವರಿ ಜಾ಼ವಸ. <verse eid="ECC 1:5" /><verse number="6" style="v" sid="ECC 1:6" />ವಾರೊ ದಕ್ಷಿಣ ದಿಕ್ಕೆ ಛುಟಸ. ಉತ್ತರ ದಿಕ್ಕೆ ಫರಸ. ತೆ ಸುತ್ತತು ಗೈನ, ವಾರೊ ಸುತ್ತಾನಾ ಪ್ರಕಾರ ಫರಿನ ಆವಸ. <verse eid="ECC 1:6" /><verse number="7" style="v" sid="ECC 1:7" />ಕ್ಹಾರಾ ನದಿಯೊ ಹರದಿನ ಸಮಂದರ ಜಾ಼ವಸ. ತಿಮ್ಮ ರ‍್ಹಯುತಬಿ ಸಮಂದರ ಭರ್ತು ನೈ. ನದಿಯೊ ಕಿಜಾ಼ತ್ಯೊ ಹರದಿನ ಐಯ್ಯೊಸ ತೆಜ಼ ಜ಼ಗಾಯೆ ಫರಿನ ಜಾ಼ವಸ. . <verse eid="ECC 1:7" /><verse number="8" style="v" sid="ECC 1:8" />ಕ್ಹಾರಾ ಕಾಮೊ ಪ್ರಯಾಸಕ್ಹು ಭರ‍್ಯಲ ಛೆ. ತಿನೆ ಮನಕ್ಹ ಕೆ ನೈ ಸಕ್ತೊ. ದೆಕಾಕ್ಹು ಡೊಳಾ ತೃಪ್ತಿ ನೈ ಥಾತಾ, ಐಕಾಕ್ಹು ಕಾನೊ ಥಕ್ತಾ ನೈ. <verse eid="ECC 1:8" /><verse number="9" style="v" sid="ECC 1:9" />ರ‍್ಹಯಲಜ಼ ರ‍್ಹವಸ, ಥಯಲಜ಼ ಥಾವಸ. ದುನಿಯಾನಾ ನವು ರ‍್ಹಯಲ ಕಯುಜ಼ ನತ್ತಿ. <verse eid="ECC 1:9" /><verse number="10" style="v" sid="ECC 1:10" />‘ದೆಕ, ಎ ನವು ವ್ಹೈ’ ಕೈನ ವಿಷಯಮಾತಬಿ ಕೆಸಕಸ ಸು? ಅಪೊತಿ ಪೈಲಾ ರ‍್ಹಯಲ ವ್ಹೈ, ಪೈಲಾನಾ ಕಾಲತುಬಿ ರ‍್ಹಯಲಜ಼ ವ್ಹೈ. <verse eid="ECC 1:10" /><verse number="11" style="v" sid="ECC 1:11" />ಪೈಲಾನಾ ಕಾಲಮಾ ಥಯಲ ಸಂಗತಿಯೊನಿ ಶೆಂ ಹಮ್ನಾನಾ ಮನಕ್ಹೊನೆ ನತ್ತಿ. ಅಗಲ್ಯಾ ಕಾಲಮಾ ಥಾವಾನಾ ಸಂಗತಿಯೊನಿ ಶೆಂ ಅಗಲ್ಯಾ ಕಾಲನ ಮನಕ್ಹೊನೆ ರ‍್ಹತು ನೈ.” ತೆ ಕವಾಲಾ ಕುನ್ನಜ಼ ರ‍್ಹತು ನೈ.<verse eid="ECC 1:11" /></para>
  <para style="s">ಪ್ರಸಂಗಿನು ಅನುಭವ</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />ಪ್ರಸಂಗಿ ಥಯಲ ಮಿ ಯೆರುಸಲೆಮಮಾ ಇಸ್ರಾಯೆಲೊನೆ ರಾಜೊ಼ ಥೈನ ವ್ಹತ್ತೊ. <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />ಹಬಾಳನಾ ಹೆಟಾ ಥಾವಾನಾ ಕ್ಹಾರಾ ಕಾಮೊ ಗ್ಯಾನಕ್ಹು ವಿಚಾರ ಕರಿನ ಪರಿಕ್ಷಾ ಕರಾನಾಹುತಿ ಮಾರು ಮನಸ ಮ್ಹೆಲ್ಯೊ. ಕ್ಹುದಾ ಮನಕ್ಹೊನಾ ಉಪ್ಪರ ನೆಮಿಸಲ ಕ್ಹಾರಾ ಕಾಮೊ ಘನ್ನಾ ಪ್ರಯಾಸನಾ ವ್ಹೈ.<verse eid="ECC 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 1:14" />ಲೊಕಮಾ ಥಾವಾನಾ ಕ್ಹಾರಾ ಕಾಮೊ ದೆಕ್ಯೊಸ. ಆಹಾ, ವಾರಾನಾ ಪಾಚಾ಼ ಲಾಗೆ ಲಿಂಗತ ಕ್ಹಾರುಜ಼ ವ್ಯರ್ಥ ವ್ಹೈ. <verse eid="ECC 1:14" /><verse number="15" style="v" sid="ECC 1:15" />ಅಡುತಿಡು ರ‍್ಹಯಲನೆ ಶಿದಾ ಕರಾನೆ ಥಾತು ನೈ! ನೈ ರ‍್ಹಯಲನೆ ಲೆಕ್ಕೊ ಕರಾನೆ ಅಸಾದ್ಯ ವ್ಹೈ!<verse eid="ECC 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16" />ಮಿ ಮಾರಾ ಮನಸಮಾ ವಿಚಾರ ಕರ‍್ತೊ, "ದೆಕ, ಮಾರಾತಿ ಪೈಲಾ ಯೆರುಸಲೆಮನೆ ಆಳ್ಯಲ ಕ್ಹಾರಾವೊತಿ ಜಾಸ್ತ ಗ್ಯಾನ ಪಡ್ದಿಲಿದ್ಯೊಸ. ಮಾರು ಮನಸ ಗ್ಯಾನನೆ, ತಿಳವಳಿಕೆನೆ ಕ್ಹಾಸ ಹೊಂದಿಲದ್ಯುಸ” ಕೈನ ಕೈಲಿದ್ಯೊ. <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />ತೆಳಾಮಾ ಗ್ಯಾನನೆ, ಪಿಸಾಳಾಪನ್ನನೆ, ಗ್ಯಾನ ನೈ ರ‍್ಹಯಲನೆ ತಿಳ್ದಿಲಿವಾನೆ ಮಿ ಮನಸ ಮ್ಹೆಲ್ಯೊ. ಎಬಿ ವಾರಾನೆ ಪಾಚಾ಼ ಲಾಗೆ ಲಿಂಗತ ಕ್ಹಾರುಜ಼ ವ್ಯರ್ಥ ವ್ಹೈ ಕೈನ ಮಿ ತಿಳ್ದಿಲಿದ್ಯೊ. <verse eid="ECC 1:17" /><verse number="18" style="v" sid="ECC 1:18" />ಕಾಕದ್ಯಾಮ ಘನ್ನಿ ಗ್ಯಾನ ರ‍್ಹಯಲ ಜ಼ಗಾ ಘನ್ನಿ ಚಿಂತಾ ರ‍್ಹವಸ. ಘನ್ನಿ ಗ್ಯಾನ ಪಡ್ದಿಲಿವಾಲಾನೆ ಮನಸೆ ದುಕ್ಕ ಥಾವಸ.<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />ಮಿ ಮನಸಮಾ, "ಹಮ್ನಾ ಆ, ಮಿ ತುನೆ ಕ್ಹುಶಿನಾ ಮುಲಕ ಪರಿಕ್ಷಾ ಕರುಸ. ಸುಖಾ ಅನುಭವಿಸ” ಕೈಲಿದ್ಯೊ. ಆಹಾ! ತೆನೈಸೊ ಎಬಿ ವ್ಯರ್ಥಜ಼ ವ್ಹೈ ಕೈನ ಮಿ ತಿಳ್ದಿಲಿದ್ಯೊ. <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />"ಅಕ್ಹಾನು ಪಿಸಾಳುಪನ್ನ ವ್ಹೈ, ಕ್ಹುಶಿಕ್ಹು ಸು ಸಾದನೆ ಕರುಸ?” ತಿಳ್ದಿಲಿದ್ಯೊ. <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />ಹಬಾಳನಾ ಹೆಟು ಮನಕ್ಹೊನಿ ಕಮ್ಮ ಆಯುಶಮಾ ಸು ಕರಾನು ಚೊ಼ಕು ವ್ಹೈ ಕೈನ ಮಿ ತಿಳ್ದಿಲಿವಾನಾಹುತಿ, ಮಾರು ಮನಸ ಗ್ಯಾನಕ್ಹು ರ‍್ಹತಾಮಾಜ಼ ಅಂಗನೆ ದ್ರಾಕ್ಷಿಯೊನಾ ರಕ್ಹಕ್ಹು ಕ್ಹುಶಿಮಾ ಮ್ಹೆಲಾನೆಬಿ, ಗ್ಯಾನ ನೈಸೊ ರ‍್ಹಯಲನೆ ಆದಾರ ಥೈನ ರ‍್ಹವಾನೆ ಮನಸಮಾ ವಿಚಾರ ಕರಿಲಿದ್ಯೊ. <verse eid="ECC 2:3" /><verse number="4" style="v" sid="ECC 2:4" />ಮಿ ಮ್ಹೊಟಾ ಕಾಮೊ ಕರ‍್ಯೊ. ಘರೊ ಭಾಂದಿಲಿದ್ಯೊ ವರಿ ದ್ರಾಕ್ಷಿಯೊನಾ ಮಳಾ ಘಾಲ್ಯೊ. <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />ಮಳಾವೊನೆ ವರಿ ಗಾರ್ಡನೊ ಕರೈನ; ತಿಮಾ ಕ್ಹಾರಾ ತರಾನಾ ಬಿಜಾ಼ ಬಿಜಾ಼ ಫಲನಾ ಝಾಡೊ ಘಾಲ್ಯೊ. <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />ಬೆಳದಾನಾ ಝಾಡೊನಾ ಬೆರೊನೆ ಪಾನಿ ಘಾಲಾನೆ ಖಾಡಿಯೊ ಖಂದಾಯೊ. <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />ಗಂಡ ವರಿ ಹೆಣ್ಣಾಳೊನೆ ಲಿದ್ಯೊ; ಮಾರಾ ಮಹಲಮಾ ಇವ್ನಾಕ್ಹು ಗುಲಾಮೊ ಹುಟ್ಯಾ. ತೆನೈಸೊ ಯೆರುಸಲೆಮಮಾ ಪೈಲಾ ರ‍್ಹಯಲವಾಲಾವೊತಿಬಿ ಮಿ ಘನ್ನೊ ಆಸ್ತಿವಾಲೊ ಥೈನ ಬೈಲೊ ಬಕ್ರಾವೊನಾ ಮಂದೆ ವ್ಹಂದಿಲಿದ್ಯೊ. <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />ಮಿ ಕ್ಹೊನು ರುಪ್ಪು ರಾಜಾ಼ವೊನಾ ವರಿ ಪ್ರಾಂತ್ಯನಾ ತೆರಿಗೆ ಜ಼ಮಾ ಕರಿಲಿದ್ಯೊ. ಗಾಯಕ, ಗಾಯಕಿಯೊನೆ ವರಿ ಮನಕ್ಹೊನೆ ಭೊಗ್ಯ ಥಯಲ ಘನ್ನಿಯೊ ಬಾಕ್ಡಿಯೊನೆ ಸಂಪಾದಿಸಿ ಲಿದ್ಯೊ. <verse eid="ECC 2:8" /><verse number="9" style="v" sid="ECC 2:9" />ಇಮ್ಮ ಯೆರುಸಲೆಮಮಾ ಪೈಲಾ ರ‍್ಹಯಲವಾವೊತಿಬಿ ಜಾಸ್ತ ಅಭಿವೃದ್ದಿ ಥೈನ ಮ್ಹೊಟೊ ಥಯೊ. ತೆನೈಸೊ ಮಾರಿ ಗ್ಯಾನ ಮಾರಾಮಾ ಜ಼ಮಾ ಥೈತಿ. <verse eid="ECC 2:9" /><verse number="10" style="v" sid="ECC 2:10" />ಮಾರಾ ಡೊಳಾ ಆಸ ಕರಲ ಕ್ಹಾರು, ತಿನೆ ಮಿ ದಿದ್ಯಾ ಬಗರ ರ‍್ಹಯೊ ನೈ. ಕಯುಬಿ ಕ್ಹುಶಿ ಅನುಭವಿಸಾನೆ ಮಾರಾ ಮನಸನೆ ಹುಬ್ರಾಡ್ಯೊ ನೈ. ಕಾಕದ್ಯಾಮ ಮಾರು ಮನಸ ಮಿ ಕರಾನಾ ಕಾಮೊಮಾ ಕ್ಹುಶಿ ಥಾತುತು. ಮಾರಾ ಪ್ರಯಾಸಕ್ಹು ಮನೆ ಮಳಲ ಫಲ ಎಜ಼ ವ್ಹೈ. <verse eid="ECC 2:10" /><verse number="11" style="v" sid="ECC 2:11" />ತೆಳಾಮಾ ಮಾರಾ ಹತ್ತಕ್ಹು ಕರಲ ಕ್ಹಾರಾ ಕಾಮೊನೆ, ಮಿ ಕರಲ ಪ್ರಯಾಸೊನೆ ಲಕ್ಷಾ ದಿನ ಪರಿಕ್ಷಾ ಕರ‍್ಯೊ, ಆಹಾ, ವಾರಾನೆ ಪಾಚಾ಼ ಲಾಗೆ ಲಿಂಗತಜ಼ ಕ್ಹಾರು ವ್ಯರ್ಥ ಥಯು. ದುನಿಯಾಮಾ ಕಯುಜ಼ ಲಾಭ ದಿಕ್ಹ್ಯು ನೈ. <verse eid="ECC 2:11" /><verse number="12" style="v" sid="ECC 2:12" />ಗ್ಯಾನನೆ ದೆಕಾನಾಹುತಿ ಫರ‍್ಯೊ, ಮರಳತನಾ ಗ್ಯಾನ ನೈಸೊ ರ‍್ಹವಾನು ದೆಕಾನಾಹುತಿ ಫರ‍್ಯೊ. ರಾಜಾ಼ನಿ ಕೊಶಿಶಜ಼ ಇಮ್ಮ ಥಯಲ್ಪರ ಬಿಜೆಕ್ಲಾಕಂತು ಸು ಥಾಸ? ಥಯಲಜ಼ ಥಾವಸ ಕೈನ ತಿಳ್ದಿಲಿದ್ಯೊ. <verse eid="ECC 2:12" /><verse number="13" style="v" sid="ECC 2:13" />ಗ್ಯಾನ ಪಿಸಾಳುಪನ್ನತಿಬಿ ಕ್ಹಾಸ ವ್ಹೈ ಕೈನ ಉಜಾಲು ಅಂದಾರಾತಿ ಕ್ಹಾಸ ವ್ಹೈ ಕೈನ ಗ್ವತ್ತ ಥಯು. <verse eid="ECC 2:13" /><verse number="14" style="v" sid="ECC 2:14" />ಗ್ಯಾನಿನಾ ಡೊಳಾ ತಿನಾ ಮಾತಾಮಾ ರ‍್ಹವಸ ಪಿಸಾಳೊ ಅಂದಾರಾಮಾ ಚಾ಼ಲಸ. ಇವ್ನೆ ಭಂಬಿ ಜ಼ನಾವೊನೆ ಯಕ್ಕಜ಼ ಗತಿ ವ್ಹೈ ಕೈನ ಮನೆ ದಿಕ್ಹಿನ ಐಯು. <verse eid="ECC 2:14" /><verse number="15" style="v" sid="ECC 2:15" />ತೆಳಾಮಾ ಮಿ ಮಾರಾ ಮನಸಮಾ, "ಪಿಸಾಳಾನೆ ಥಾವಾನಿ ಗತಿ, ಮನೆಬಿ ಥಾವಸ. ಮಾರಿ ಜಾಸ್ತ ಗ್ಯಾನಕ್ಹು ಫೈದೊ ಸುಛೆ?” ಎ ವ್ಯರ್ಥಜ಼ ವ್ಹೈ ಕೈನ ಮಾರಾ ಮನಸಮಾ ತಿಳ್ದಿಲಿದ್ಯೊ. <verse eid="ECC 2:15" /><verse number="16" style="v" sid="ECC 2:16" />ಕಾಕದ್ಯಾಮ ಪಿಸಾಳೊ ಕಿಮ್ಮ ತಿಮ್ಮಜ಼ ಗ್ಯಾನಿಬಿ ಘನ್ನಾ ದಿನ್ನೊ ಲಕ್ಕಾ ಇಕ್ಹರಿ ಪಡಸ. ಹಮ್ನಾನಾ ಮನಕ್ಹೊ ಅಗಲ್ಯಾ ಕಾಲ ಮಟಾ ಇಕ್ಹರಿ ಪಡಸ. ಆಹಾ! ಪಿಸಾಳಾ ನಿಂಗತ ಗ್ಯಾನಿಬಿ ಮರಸ. <verse eid="ECC 2:16" /><verse number="17" style="v" sid="ECC 2:17" />ಲೊಕ ವ್ಯವಹಾರ ಕೆಟ್ಟ ವ್ಹೈ ಕೈನ ಮನೆ ದಿಕ್ಹಿನ ಆಯಲಕ್ಹು ಜಿಂದಗಿಜ಼ ಅಸೈ ಥೈನ ದಿಕ್ಹಿ. ವಾರಾನೆ ಪಾಚಾ಼ ಲಾಗೆ ಲಿಂಗತಜ಼ ಕ್ಹಾರು ವ್ಯರ್ಥ ವ್ಹೈ. <verse eid="ECC 2:17" /><verse number="18" style="v" sid="ECC 2:18" />ಮಾರಿ ಪ್ರಯಾಸನು ಫಲ ಅಗಲ್ಯಾನೆ ಛೊಡಿನ ದ್ಯು ಕೈನ ಮಿ ಲೊಕಮಾ ಕರಲ ಪ್ರಯಾಸನಾಹುತಿ ಬೆಜಾರ ಥಯೊ. <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />ತೆ ಗ್ಯಾನಿ ವ್ಹೈ ಸು ನೈತೊ ಪಿಸಾಳೊ ವ್ಹೈ ಕೈನ ಕಿನೆ ಗ್ವತ್ತ ಛೆ? ಕಯೊ ರ‍್ಹಯೊತಬಿ ಮಿ ಲೊಕಮಾ ಕಿಮಾ ಗ್ಯಾನನೆ, ಪ್ರಯಾಸನೆ ಖರ್ಚ ಕರ‍್ಯೊಸ ತಿನಾ ಉಪ್ಪರ ರಾಜ಼ ಕರುಸ. ಎ ವ್ಯರ್ಥಜ಼ ವ್ಹೈ. <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಮಿ ಲೊಕಮಾ ಪ್ರಯಾಸ ಕರಲ ಕಾಮನಾ ವಿಷಯಮಾ ಬೆಜಾರನೆ ಮ್ಹೈ ಥಯೊ.<verse eid="ECC 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 2:21" />ಯಕ್ಲೊ ತಿನಾ ಗ್ಯಾನಕ್ಹು, ತಿನಿ ತಿಳಿವಳಕಿಕ್ಹು ತಿನು ಕಾಮಾ ಕರಿನ ತೆ ಕಾಮಮಾ ಮ್ಹೈನತ್ತ ಕರಾಲಾನೆ ತಿನೆ ಆವಾನು ಪ್ರತಿಫಲ ಛೊಡುಲಾಗ್ಯು. ಎಬಿ ವ್ಯರ್ಥ ವ್ಹೈ, ಖಾಲಿ ಅನ್ಯಾಯ ವ್ಹೈ. <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />ಲೊಕಮಾ ಮನಕ್ಹ ಪುರಾ ಮನಸಕ್ಹು ಕರಾನಾ ಪ್ರಯಾಸಕ್ಹು ತಿನೆ ಮಳಾನು ಲಾಭ ಸುವೈ? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />ತಿನಾ ಕ್ಹಾರಾ ದಿನ್ನೊ ಚಿಂತಾ ವ್ಹೈ. ತಿನು ಕಾಮ ಕ್ಹಾರು ತ್ರಾಸಜ಼ ವ್ಹೈ. ರಾತೆಬಿ ತಿನಾ ಮನಸನೆ ಅರಾಮ ನತ್ತಿ. ಎಬಿ ವ್ಯರ್ಥಜ಼ ವ್ಹೈ. <verse eid="ECC 2:23" /><verse number="24" style="v" sid="ECC 2:24" />ಅನ್ನ ಪಾನನೆ ಲಿನ ತಿನಾ ಪ್ರಯಾಸಮಾ ಸುಖಾ ಅನುಭವಿಸಾತಿಬಿ ಮನಕ್ಹನೆ ತಿತ್ತಿ ಮ್ಹೊಟು ಸು ನತ್ತಿ. ಎ ಕ್ಹುದಾಕ್ಹು ಥಯು ಕವಾನು ಗೊತ್ತ ಥಯು. <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />ಕ್ಹುದಾ ಬಗರ ಕುನಬಿ ಭೊಜನ ಕರಿನ ಸುಖಾ ಅನುಭವಸಾನು ಕಿಮ್ಮ ವ್ಹೈ? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />ಕ್ಹುದಾ ತೆ ಮೆಚ್ಚಲವಾಲಾನೆ ಗ್ಯಾನ, ತಿಳುವಳಿಕೆ, ಸಂತೊಷ ದಿವಸ. ತೆನೈಸೊ ಕ್ಹುದಾನಾ ನಜರಮಾ ಚೊ಼ಕಾ ಮನಕ್ಹನೆ ದಿವಾನಾಹುತಿ ಜ಼ಮಾ ಕರಿನ ದಿವಾನಾಹುತಿ ಪಾಪಿನೆ ರ‍್ಹೈತಬಿ ಪ್ರಯಾಸ ದಿವಸ. ಎ ವಾರನೆ ಪಾಚಾ಼ ಮ್ಹೆಲಲ ತಿಮ್ಮಜ಼ ವ್ಯರ್ಥ ವ್ಹೈ.<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s">ಹರಯಕ್ಕನೆ ಟೈಮ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1" />ಹರಿಯಕ್ಕ ಕಾಮನೆ ಯಕ್ಕ ಟೈಮ ಛೆ, ಜಿಮಿನಪರ ಚಾ಼ಲಾನಾ ಹರಿಯಕ್ಕ ಕಾಮನೆ ಯಕ್ಕ ಟೈಮ ಛೆ. <verse eid="ECC 3:1" /><verse number="2" style="v" sid="ECC 3:2" />ಹುಟ್ಟಾನು ಟೈಮ, ಮರಾನೊ ಟೈಮ, ಝಾಡೊ ಘಾಲಾನೊ ಟೈಮ, ಘಾಲಲ ಕ್ಹಾರು ಕಿತ್ತಾನೊ ಟೈಮ, <verse eid="ECC 3:2" /><verse number="3" style="v" sid="ECC 3:3" />ಖಲಾಸ ಕರಾನೊ ಟೈಮ, ಸ್ವಸ್ತ ಕರಾನೊ ಟೈಮ, ಪಾಡಾನೊ ಟೈಮ, ಭಾಂದಿನ ಉಟಾಡಾನೊ ಟೈಮ, <verse eid="ECC 3:3" /><verse number="4" style="v" sid="ECC 3:4" />ರವಾನೊ ಟೈಮ, ಅಕ್ಹಾನೊ ಟೈಮ, ಅಟಾವಾನೊ ಟೈಮ, ನ್ಹಾಚಾ಼ನೊ ಟೈಮ, <verse eid="ECC 3:4" /><verse number="5" style="v" sid="ECC 3:5" />ದಗ್ಡಾ ಭಿರ್ಕಾವಾನೊ ಟೈಮ, ದಗ್ಡಾ ಜ಼ಮಾಕರಾನೊ ಟೈಮ, ಔಳಿಲಿವಾನೊ ಟೈಮ, ಔಳಿ ನೈ ಲಿವಾನೊ ಟೈಮ, <verse eid="ECC 3:5" /><verse number="6" style="v" sid="ECC 3:6" />ಕಮಾವಾನೊ ಟೈಮ, ಜ಼ವೈಲಿವಾನೊ ಟೈಮ, ವಚಾ಼ಡಾನೊ ಟೈಮ, ನಾಕಾನೊ ಟೈಮ, <verse eid="ECC 3:6" /><verse number="7" style="v" sid="ECC 3:7" />ಫಾಟಾನೊ ಟೈಮ, ಶಿವಾನೊ ಟೈಮ, ಗಪ್ಪ ರ‍್ಹವಾನೊ ಟೈಮ, ಬೊಲಾನೊ ಟೈಮ, <verse eid="ECC 3:7" /><verse number="8" style="v" sid="ECC 3:8" />ಮಯಾ ಕರಾನೊ ಟೈಮ, ದ್ವೆಶ ಕರಾನೊ ಟೈಮ, ಯುದ್ದನೊ ಟೈಮ, ಸಮಾಧಾನನೊ ಟೈಮ, <verse eid="ECC 3:8" /><verse number="9" style="v" sid="ECC 3:9" />ರಾಬಾಲಾನೆ ತಿನಾ ಮ್ಹೈನತಕ್ಹು ಸು ಫೈದೊ ವ್ಹೈ? <verse eid="ECC 3:9" /><verse number="10" style="v" sid="ECC 3:10" />ಮನಕ್ಹನೆ ಫರಜ಼ ವ್ಹೈ ಕೈನ ಕ್ಹುದಾ ನೆಮ್ಸಲ ಮ್ಹೈನತ ದೆಕ್ಯೊಸ. <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />ಯಕ್ಕೆಕ ಸಾಮನನೆ ಟೈಮನಾ ತಕ್ಕ ಚೊ಼ಕೊ ಕರ‍್ಯೊಸ. ತೆನೈಸೊ ಮನಕ್ಹೊನಾ ಮನಸಮಾ ಹಮೆಶಾನು ವಿಚಾರ ಮ್ಹೆಲ್ಯೊಸ. ತೆನೈಸೊ ಕ್ಹುದಾ ಚ಼ಲಾವಾನು ಕಾಮನೆ ತ್ಯುನೆ ವಿಚಾರ ಕರೆವಾಚಿ ಕರ‍್ಯೊಸ. <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />ಮನಕ್ಹೊ ತಿನಾ ಜಿವಮಾನಮಾ ಕ್ಹುಸಿಕ್ಹು ಸುಖಾನೆ ಅನುಬವಿಸಾತಿ ಹಜಿ ತ್ಯುನೊನೆ ತಿತ್ತಿ ಉಪ್ಪರ ನತ್ತಿ ಕೈನ ಮಿ ವಿಚಾರ ಕರ‍್ಯೊಸ. <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />ತೆನೈಸೊ ಹರಯಕ್ಲೊ ಕ್ಹಾವಾ ಪಿವಾನು ಲಿನ ತಿನಾ ಹರಯಕ್ಕ ಪ್ರಯಾಸಮಾ ಸುಖಾ ಅನುಭವ ಕರಾನೆ ಕ್ಹುದಾನಿ ಮರ್ಗಾ ವ್ಹೈ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="ECC 3:13" /><verse number="14" style="v" sid="ECC 3:14" />ಕ್ಹುದಾನು ಕಾಮ ಹಮೆಶ್ಯಾನು ವ್ಹೈ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. ತಿನೆ ಸುಬಿ ಸೆರಸತ್ತಾ ನೈ. ತಿನಾಕ್ಹು ಸುಬಿ ಕಾಡ ಸಕ್ತಾ ನೈ. ಕ್ಹುದಾನಾ ಎ ನಿಯಮನೆ ಮನಕ್ಹೊ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಭೆಂ ವರಿ ಭಕ್ತಿಮಾ ರ‍್ಹೌ ಕವಾನು ಕಾರಣ ವ್ಹೈ. <verse eid="ECC 3:14" /><verse number="15" style="v" sid="ECC 3:15" />ಹಮ್ನಾ ರ‍್ಹಯಲ ಪಾಚು಼ ವ್ಹತ್ತು; ಅಗಲ್ಯು ಹಮ್ನಾಬಿ ಛೆ. ಹಾಳ ಥಯಲ ಕ್ಹುದಾ ಫರಿನ ಲಾವಸ.<verse eid="ECC 3:15" /></para>
  <para style="s">ದುನಿಯಾಮಾ ಅನ್ಯಾಯ</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />ತೆನೈಸೊ ಮಿ ಲೊಕಮಾ ದೆಕಿನ ಫೈಸಲಾನಾ ಜ಼ಗಾಮಾ ಧರಮನಾ ಜ಼ಗಾಮಾ ಅಧರಮ ರ‍್ಹವಾನು ದೆಕ್ಯೊ. <verse eid="ECC 3:16" /><verse number="17" style="v" sid="ECC 3:17" />ತೆಳಾಮಾ ಮಿ ಮನಸಮಾ, "ಕ್ಹುದಾ ನಿತಿವಂತವಾಲಾನೆ, ಅನಿತಿವಂತವಾಲಾನೆ ಫೈಸಲೊ ಕರಸ. ತೆ ಫೈಸಲಾನಾ ತರಿಕಾವೊನೆ, ಕ್ಹಾರಾ ಕಾಮೊನೆ ಯಕ್ಕ ಟೈಮ ಛೆ” ಕೈನ ಕೈಲಿದ್ಯೊ. <verse eid="ECC 3:17" /><verse number="18" style="v" sid="ECC 3:18" />ಮಿ ಮಾರಾ ಮನಸಮಾ ಅಮ್ಮ ವಿಚಾರ ಕರ‍್ಯೊ, "ಕ್ಹುದಾ ಮನಕ್ಹೊನೆ ಪರಿಕ್ಷಾ ಕರಿನ, ತ್ಯುನೆ ಜಾನವರೊನಾ ಸಮಾನ ವ್ಹೈಕೈನ ಕವಾನು ದೆಕ್ಲಾಡಸ.” <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />ಮನಕ್ಹನಿ ಪರಸ್ಥಿತಿ ಪಶುನಿ ಗತಿ ಯಕ್ಕಜ಼ ವ್ಹೈ. ಪಶುನೆ ಮೌತ ಅವಾನಾ ತಿಮ್ಮ ಮನಕ್ಹನೆಬಿ ಆವಸ, ಕ್ಹಾರಾವೊನೆ ಜ಼ಲಮ ಯಕ್ಕಜ಼ ವ್ಹೈ. ಮನಕ್ಹ ಪಶುತಿಬಿ ಶ್ರೆಷ್ಟ ನವೈ. ಕ್ಹಾರುಜ಼ ವ್ಯರ್ಥ ವ್ಹೈ. <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />ಕ್ಹಾರಾ ಪ್ರಾಣಿಯೊ ಯಕ್ಕ ಜ಼ಗಾಕನ ಜಾ಼ವಸ. ಕ್ಹಾರುಜ಼ ಮಾತಿಕ್ಹು ಥಯಲ ವ್ಹೈ. ಕ್ಹಾರುಜ಼ ಮಾತಿಮಾ ವರಿ ಜಾ಼ವಸ. <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />ಮನಕ್ಹನಿ ಆತ್ಮಾ ಉಪ್ಪರ ಜಾ಼ವಸ, ಪಶುನಿ ಆತ್ಮಾ ಹೆಟಿ ಉತ್ರಿನ ಜಿಮಿನನಾ ಹೆಟಿ ಜಾ಼ವಸ ಕೈನ ಕಿನೆ ಗ್ವತ್ತ ಛೆ? <verse eid="ECC 3:21" /><verse number="22" style="v" sid="ECC 3:22" />ಅಮ್ಮ ಮಿ ವಿಚಾರ ಕರಿನ ಮನಕ್ಹ ತಿನಾ ಕಾಮೊಮಾ ಕ್ಹುಸಿ ಥಾವಾತಿ ತಿನೆ ಸುಜ ಉಪ್ಪರ ನತ್ತಿ. ಎಜ಼ ತಿನು ಪಾಲ ವ್ಹೈ ಕೈನ ವಿಚಾರ ಕರ‍್ಯೊ. ಜಿವಮಾನನಾ ಥಯಲ್ಪರ ಸಂಬವಿಸಾನು ದೆಕಾನಾಹುತಿ ಮನಕ್ಹನೆ ವರಿ ಕುನ್ನ ಆವಾ ಲಗಾಡಸ?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />ತೆ ಥಯಲ್ಪರ ವರಿ ದೆಕಿನ ದುನಿಯಾಮಾ ತ್ರಾಸ ಥಾವಾನು ದೆಕ್ಯೊ. ಆಹಾ! ತ್ರಾಸ ಖಾವಾಲಾನು ಡೊಳಾಮಾನು ಪಾನಿ ದೆಕೊ. ತ್ಯುನೊನೆ ಸಮಾಧಾನ ಕರಾಲು ಕುನ್ನಜ಼ ನತ್ತಿ. ತ್ಯುನೊನೆ ತ್ರಾಸ ಕರಾಲಾವೊನಿ ಘನ್ನಿ ತಾಕತ ಛೆ. ತ್ರಾಸ ಖಾವಾಲಾವೊನೆ ಸಮಾಧಾನ ಕರಾಲು ಕುನ್ನಜ಼ ನತ್ತಿ. <verse eid="ECC 4:1" /><verse number="2" style="v" sid="ECC 4:2" />ಎ ಕ್ಹಾರು ದೆಕಿನ ಹಜು಼ನ ಜಿವ್ತಾ ಥೈನ ಜಿವ್ತಾ ರ‍್ಹವಾಲಾವೊತಿಬಿ ಮರಲವಾಲಾಜ಼ ಚೊ಼ಕಾ ವ್ಹೈ ಕೈನ ಹೊಗಳ್ಯೊ. <verse eid="ECC 4:2" /><verse number="3" style="v" sid="ECC 4:3" />ಹೊ, ಎ ಭಂಬಿ ಜ಼ನಾವೊತಿ ಹಜ಼ುನ ಹುಟ್ತು ನೈ, ಲೊಕಮಾ ಥಾವಾನಾ ಅಧರ್ಮನೆ ದೆಕ್ಯಾ ಬಗರ ರ‍್ಹವಾನು ಚೊ಼ಕು ವ್ಹೈ ಕೈನ ತಿಳ್ದಿಲಿದ್ಯೊ. <verse eid="ECC 4:3" /><verse number="4" style="v" sid="ECC 4:4" />ತೆಳಾಮಾ ಕ್ಹಾರಿ ಪ್ರಯಾಸನೆ, ಕರಾನಾ ಕ್ಹಾರಾ ಕಾಮೊನೆ ದೆಕಿನ ಎ ಯಕ್ಕನೆ ಯಕ್ಕ ಶಿಟ್ಟನೆ ಮೌಕೊ ವ್ಹೈ ಕೈನ ತಿಳ್ದಿಲಿದ್ಯೊ. ಎ ವಾರಾನೆ ಪಾಚಾ಼ ಲಾಗೆ ಲಿಂಗತ ವ್ಯರ್ಥಜ಼ ವ್ಹೈ. <verse eid="ECC 4:4" /><verse number="5" style="v" sid="ECC 4:5" />ಪಿಸಾಳೊ ತಿನಾ ಹತೊ ಝಾಕಿಲಿನ ಕಯುಜ಼ ಕಾಮ ಕರ‍್ಯಾವಾಚಿ, ತಿನೆ ತೆಜ ನಾಶ ಕರಿಲಿವಸ. <verse eid="ECC 4:5" /><verse number="6" style="v" sid="ECC 4:6" />ವಾರಾನೆ ಪಾಚಾ಼ ಲಾಗೆ ಲಿಂಗತ ಮ್ಹೈನತಕ್ಹು ಭರ‍್ಯಲ ಭಂಬಿ ಹತೊಕ್ಹು ಕರಲ ಕಾಮತಿಬಿ ಸಮಾದಾನ ಥೈನ ಯಕ್ಕಜ಼ ಹತ್ತಕ್ಹು ಕರಲ ಕಾಮಜ಼ ಚೊ಼ಕು ವ್ಹೈ. <verse eid="ECC 4:6" /><verse number="7" style="v" sid="ECC 4:7" />ತೆಳಾಮಾ ಮಿ ಲೊಕಮಾ ವರಿಯಕ್ಕ ವ್ಯರ್ಥ ವಿಶಯನೆ ದೆಕ್ಯೊ. <verse eid="ECC 4:7" /><verse number="8" style="v" sid="ECC 4:8" />ವಂಟಕ್ಯೊ ರ‍್ಹಯಲ ಯಕ್ಕ ಮನಕ್ಹ ಛೆ. ತಿನೆ ಭಾಯೊ ನತ್ತಿ, ಬಚ್ಚಾ ನತ್ತಿ. ತೆನೈಸೊ ತಿನಾ ಮ್ಹೈನತನೆ ಅಂತ್ಯ ನತ್ತಿ, ಆಸ್ತಿಕ್ಹು ತಿನಾ ಡೊಳಾನೆ ತೃಪ್ತಿ ನತ್ತಿ. ತೆ, "ಮಿ ಸುಖಾ ಛೊಡಿನ ಕಿನಾಹುತಿ ಮ್ಹೈನತ ಕರಾಡೊಸ ಮಿ ಕಾ ಕ್ಹುಶಿನೆ ಜವೈ ಲಿವಾಡೊಸ?” ಕೈಲಿವಸ. ಎಬಿ ವ್ಯರ್ಥಜ಼ ವ್ಹೈ. ಕ್ಹಾಲಿ ಮ್ಹೈನತನು ಕಾಮ ವ್ಹೈ. <verse eid="ECC 4:8" /><verse number="9" style="v" sid="ECC 4:9" />ಯಕ್ಲಾತಿ ಬೆ ಜ಼ನಾ ಕಾಮ ಕರಾನು ಚೊ಼ಕು ವ್ಹೈ. ತ್ಯುನಿ ಮ್ಹೈನತನೆ ಚೊ಼ಕೊ ಫೈದೊ ಗಳಶಿಲೆ ಸಕಸ. <verse eid="ECC 4:9" /><verse number="10" style="v" sid="ECC 4:10" />ಯಕ್ಲೊ ಪಡ್ಯಾಮ, ಬಿಜೆಕ್ಲೊ ತಿನಾ ದೊಸ್ತನೆ ಉಪ್ಪರ ಉಟಾಡಸ. ವಂಟಕ್ಯೊ ರ‍್ಹಯಲವಾಲೊ ಯಕ್ಲೊ ಪಡ್ಯಾಮ, ತಿನೆ ಉಪ್ಪರ ಉಟಾಡಾನೆ ಕುನ್ನಜ಼ ನತ್ತಿ, ತಿನಿ ಗತಿ ಘನ್ನಿ ಕೆಟ್ಟ ವ್ಹೈ. <verse eid="ECC 4:10" /><verse number="11" style="v" sid="ECC 4:11" />ವರಿ ಬೆ ಜ಼ನಾ ಕ್ಹಾತೆ ಕ್ಹುರಯಮ ತ್ಯುನೊನೆ ಕೌ ಲಾಗಸ, ತೆನೈಸೊ ಯಕ್ಲೊ ಕಿಮ್ಮ ಕೌಮಾ ರ‍್ಹವಾನೆ ಥಾವಸ? <verse eid="ECC 4:11" /><verse number="12" style="v" sid="ECC 4:12" />ಯಕ್ಲಾನೆ ಬಿಜೆಕ್ಲೊ ಝಿತ್ತ ಸಕಸ, ತೆನೈಸೊ ಝಿತ್ತಲವಾಲಾನೆ ಬೆ ಜ಼ನಾ ತಿನೆ ವಿರುದ್ದ ಥೈನ ಹುಬ್ರೆ ಸಕಸ. ತನ್ನ ಹುರಿನಾ ರಾಕ್ಹೊ ಭೆಗಿನ ತುಟತಾ ನೈ. <verse eid="ECC 4:12" /><verse number="13" style="v" sid="ECC 4:13" />ಹುಶಾರ್ಕಿನಾ ವಾತನೆ ಕಾನ ದಿನ ನೈ ಐಕಾಲೊ ಗಡಿಯೊ, ಪಿಸಾಳೊಥಯಲ ರಾಜಾ಼ತಿ ಗ್ಯಾನ ರ‍್ಹಯಲ ಗರಿಬ ಜಾಂಜಿಮಾನ ಚೊ಼ಕೊ ವ್ಹೈ. <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />ಹೆವೊ ಯಕ್ಕ ಜಾಂಜಿಮಾನ ರಾಜೊ಼ ಥಾವಾನೆ ಜೈಲತೊ ಆಯಲ ರ‍್ಹೌ ನೈತೊ ತಿನಾ ರಾಜ್ಯಮಾ ಗರಿಬ ಪ್ರಜೆ ಥೈನ ಹುಟ್ಟಲ ರ‍್ಹವಸ. <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />ಸುರ್ಯಾನಾ ಹೆಟಾ ಜಿವ್ತಾ ರ‍್ಹೈನ ವರಿ ಚಾ಼ಲ್ಯಲವಾಲಾ ಕ್ಹಾರಾ ರಾಜಾ಼ನಾ ಉತ್ತರಾದಿಕಾರಿ ಥಯಲ ಜಾಂಜಿಮಾನನಾ ತರಫ ಥಾವಾನು ಮಿ ದೆಕ್ಯೊಸ. <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />ಇನಾ ಅದಿಕಾರಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ಘನ್ನಾ ಛೆ. ತಿನು ಅದಿಕಾರ ಥಯಲ್ಪರ ಇನಾಮಾ ಕ್ಹುಶಿ ರ‍್ಹತಾ ನೈ. ಎಬಿ ವಾರಾನೆ ಪಾಚಾ಼ ಲಾಗೆ ಲಿಂಗತ ವ್ಯರ್ಥ ವ್ಹೈ.<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s">ದುಡ್ಕಿನ ಕ್ಹಮ್ಮ ಘಾಲು ನಕೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />ಗುಡಿಯೆ ಜಾ಼ತಾಮಾ ತಾರಾ ಹೆಜ್ಜಿಯೊನೆ ದೆಕ. ಪಿಸಾಳಾವೊನಿ ಬಲಿತಿಬಿ ಸನ್ನಿದಿನೆ ಐನ ಕಾನ ದಿನ ಐಕಾನು ಚೊ಼ಕು ವ್ಹೈ. ತ್ಯುನೆ ತಪ್ಪ ಕರಾಡಾಸ ಕವಾನು ಪಿಸಾಳಾವೊನೆ ಗ್ವತ್ತಜ಼ ನತ್ತಿ.<verse eid="ECC 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 5:2" />ತಾರಾ ಮ್ಹೊಡಾಕ್ಹು ದುಡಕು ನಕೊ ವರಿ ಕ್ಹುದಾನಾ ಕ್ಹಾಮೊ ಬೊಲಾನೆ ತಾರಾ ಮನಸಮಾ ಗಡಬಡ ಕರು ನಕೊ. ಕ್ಹುದಾ ಪರಲೊಕಮಾ ಛೆ. ತು ಜಿಮಿನಪರ ಛೆ, ತಿನಾಹುತಿ ತಾರಾ ವಾತೊ ಕಮ್ಮ ರ‍್ಹವಾದೆ. <verse eid="ECC 5:2" /><verse number="3" style="v" sid="ECC 5:3" />ಘನ್ನಿ ಚಿಂತಾಕ್ಹು ಕೆಟ್ಟ ಕ್ಹಪನೊ ಆವಸ ವರಿ ಪಿಸಾಳಾನು ಆವಾಜ಼ ಘನ್ನಾ ವಾತೊಕ್ಹು ಭರಲ ರ‍್ಹವಸ. <verse eid="ECC 5:3" /><verse number="4" style="v" sid="ECC 5:4" />ತು ಕ್ಹುದಾನೆ ಹರಿಕೆ ಕರ‍್ಯೊಮ ತಿನೆ ಪುರಾ ಕರಾನೆ ಲೆಟ ಕರು ನಕೊ. ಪಿಸಾಳಾವೊಮಾ ಕ್ಹುದಾನೆ ಕ್ಹುಶಿ ನತ್ತಿ. ತು ಪ್ರಮಾಣ ಕರಲ ಪುರಾ ಕರ. <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />ತು ಹರಕೆ ಕರಲನೆ ಪುರಾ ಕರ‍್ಯಾವಾಚಿ ರ‍್ಹವಾತಿ ಹರಿಕೆ ಕರ‍್ಯಾ ಬಗರ ರ‍್ಹವಾನುಜ಼ ಚೊ಼ಕು ವ್ಹೈ. <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />ತಾರು ಮ್ಹೊಡು ತುನೆ ಪಾಪಮಾ ಘಾಲ್ಯಾ ಬಗರ ದೆಕಿಲೆ. "ಎ ತಪ್ಪಕ್ಹು ಥಯು” ಕೈನ ದುತನಾ ಕ್ಹಾಮೊ ಕೌ ನಕೊ. ಕ್ಹುದಾ ತಾರಿ ವಾತಪರ ಶಿಟ್ಟ ಥೈನ ತಾರಾ ಕಾಮೊನೆ ಕಾ ಹಾಳ ಕರು? <verse eid="ECC 5:6" /><verse number="7" style="v" sid="ECC 5:7" />ಘನ್ನ ಕ್ಹಪನೊಕ್ಹು, ವ್ಯರ್ಥ ವಿಶಯಕ್ಹು, ಘನ್ನಾ ವಾತೊಕ್ಹುಬಿ ವ್ಯರ್ಥಜ಼ ವ್ಹೈ. ತುತಬಿ ಕ್ಹುದಾನಿ ಭಯಭಕ್ತಿ ರ‍್ಹಯಲವಾಲೊ ಥೈನ ರ‍್ಹೆ.<verse eid="ECC 5:7" /></para>
  <para style="s">ಜಿಂದಗಿಜ಼ ವ್ಯರ್ಥ ವ್ಹೈ</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />ಸಂಸ್ಥಾನಮಾ ಗರಿಬೊನಾ ತ್ರಾಸನೆ, ನಿತಿನ್ಯಾಯನಾ ನಾಶನೆ ತು ದೆಕ್ಯೊಮ ಘಾಬ್ರೊ ಥೌ ನಕೊ. ಕಾಕದ್ಯಾಮ ಯಕ್ಕ ಅದಿಕಾರಿನಾ ಉಪ್ಪರ ಬಿಜೆಕ್ಲೊ ರ‍್ಹವಸ. ತೆ ಭಂಬಿ ಜ಼ನಾವೊನಾ ಉಪ್ಪರ ಜಾಸ್ತ ಅದಿಕಾರವಾಲೊ ರ‍್ಹವಸ. <verse eid="ECC 5:8" /><verse number="9" style="v" sid="ECC 5:9" />ಜಿಮಿನಕ್ಹು ಕ್ಹಾರಾವೊನೆ ಫೈದೊ ಛೆ ವರಿ ಖೆತರೊಕ್ಹು ರಾಜಾ಼ನೆ ಫೈದೊ ಥಾವಸ. <verse eid="ECC 5:9" /><verse number="10" style="v" sid="ECC 5:10" />ದೊಕ್ಡಾನೆ ಆಸ ಕರಾಲಾನೆ ಕೆಕ್ಲಾ ದೊಕ್ಡಾಕ್ಹುಬಿ ತೃಪ್ತಿ ನೈ ಥಾತಿ ವರಿ ಆಸ್ತಿಪರ ಆಸ ರ‍್ಹಯಲವಾಲಾನೆ ಪಗಾರ ಕಕ್ಲೊ ರ‍್ಹಯೊತಬಿ ಬಸ್ಸ ನೈ ಥಾತು. ಎಬಿ ವ್ಯರ್ಥಜ಼ ವ್ಹೈ. <verse eid="ECC 5:10" /><verse number="11" style="v" sid="ECC 5:11" />ಆಸ್ತಿ ಜಾಸ್ತ ಥಯಮ ಅನುಬವಿಸಾಲಾವೊನಿ ಸಂಕ್ಯಾ ಹೆಚ್ಚ ಥಾವಸ. ತಿನೆ ಡೊಳಾಕ್ಹು ದೆಕಾನು ಛೊಡಿನ ಮಾಲಕನೆ ಬಿಜು಼ ಸುಜ಼ ಫೈದೊ ನತ್ತಿ. <verse eid="ECC 5:11" /><verse number="12" style="v" sid="ECC 5:12" />ರಾಬಾಲೊ ದಕ್ಹುಜ಼ ಖಾವಾದೆ ಘನ್ನುಜ಼ ಖಾವಾದೆ, ಸಮಾದಾನಕ್ಹು ನಿಂದರ ಕರಸ. ತೆನೈಸೊ ಸೌಕಾರ ರ‍್ಹಯಲವಾಲಾನಿ ಆಸ್ತಿ ತಿನೆ ನಿಂದರ ಕರಾನೆ ದೆತಿ ನೈ. <verse eid="ECC 5:12" /><verse number="13" style="v" sid="ECC 5:13" />ಸುರ್ಯಾನಾ ಹೆಟು ಮಿ ವರಿಯಕ್ಕ ತ್ರಾಸ ದೆಕ್ಯೊ. ಮಾಲಕ ತಿನಿ ಆಸ್ತಿನೆ ವಾಚಾ಼ಡಾನಾಹುತಿಜ಼ ಕೊರಗತೊ ರ‍್ಹವಸ. <verse eid="ECC 5:13" /><verse number="14" style="v" sid="ECC 5:14" />ತೆ ಆಸ್ತಿ ವ್ಯರ್ಥ ಮ್ಹೈನತಕ್ಹು ಹಾಳ ಥಾವಸ. ತಿನೆ ದಿಕ್ರೊ ರ‍್ಹಯಮ ತೆ ದಿಕ್ರಾನಾಹುತಿ ತಿನಾ ಹತ್ಮಾ ಸುಜ಼ ನೈ ರ‍್ಹತು. <verse eid="ECC 5:14" /><verse number="15" style="v" sid="ECC 5:15" />ಮಾನಾ ಪೆಟತೊ ಕಿಮ್ಮ ಆಯೊಸ ತಿಮ್ಮಜ಼ ಸುಜ಼ ನೈ ರ‍್ಹಯಲವಾಲೊ ಥೈನ ಹಾಳ ಥೈನ ಜಾ಼ವಸ. ತೆ ಮ್ಹೈನತ ಕರ‍್ಯೊತಬಿ, ತಿನಾ ಹತ್ಮಾ ಸುಜ಼ ಲಿನ ಜಾ಼ತೊ ನೈ. <verse eid="ECC 5:15" /><verse number="16" style="v" sid="ECC 5:16" />. ಮನಕ್ಹ ಕಿಮ್ಮ ಆಯೊತೊ ತಿಮ್ಮಜ಼ ಜಾ಼ವಸ. ವಾರಾನಾಹುತಿ ಕರಲ ಮ್ಹೈನತಕ್ಹು ತಿನೆ ಫೈದೊ ಸು ವ್ಹೈ ಎಬಿ ವ್ಯರ್ಥಜ಼ ವ್ಹೈ? <verse eid="ECC 5:16" /><verse number="17" style="v" sid="ECC 5:17" />ತಿನಿ ಪುರಾ ಜಿಂದಗಿಮಾಜ಼ ಅಂದಾರು ರ‍್ಹವಸ. ತಿನಾ ರೊಗನಾ ಕ್ಹಾತೆ ತಿನೆ ಘನ್ನು ಶಿಟ್ಟ ತ್ರಾಸ ರ‍್ಹವಸ. <verse eid="ECC 5:17" /><verse number="18" style="v" sid="ECC 5:18" />ದೆಕ, ಮಿ ದೆಕಲ ಎಜ಼ ವ್ಹೈ. ಕ್ಹುದಾ ಯಕ್ಲಾನೆ ದಿದಲ ಜಿಂದಗಿನಾ ಕ್ಹಾರಾ ದಿನ್ನೊಮಾ ತೆ ಅನ್ನ ಪಾನಿ ಲಿನ ತೆ ಲೊಕಮಾ ಕರಾನಿ ಮ್ಹೈನತಮಾಬಿ ಸುಖಾ ಅನುಭವಿಸಸ. ಎ ತಿನೆ ಪ್ರಿ, ಚೊ಼ಕು ಥಯಲ ವ್ಹೈ. ಎಜ಼ ಮನಕ್ಹನು ಪಾಲನು ವ್ಹೈ. <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />ಹರಯಕ್ಕ ಮನಕ್ಹನೆ ಕ್ಹುದಾ ಆಸ್ತಿ ದಿನ, ತಿನೆ ಅನುಭವಿಸಿನ, ಪಾಲೆ ಆಯಲ ಲಿನ ತಿನಾ ಮ್ಹೈನತಮಾ ಕ್ಹುಶಿ ಥಾವಾನೆ ತಾಕತ ದಿದಲ ರ‍್ಹಯಮ ತೆ ತಿನೆ ಮಳಲ ಕ್ಹುದಾನು ಬಹುಮಾನ ವ್ಹೈ. <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />ಹೆವೊ ತಿನಿ ಪುರಾ ಜಿಂದಗಿನಾ ದಿನ್ನೊನೆ ಘನ್ನೊ ಮಾತು ನೈ ಕೆಡಶಿ ಲೆತೊ. ತೆ ತಿನಾ ಮನಸನಾ ಕ್ಹುಶಿನಾ ಘುಂಗಮಾ ರ‍್ಹಯಲ ನಿಂಗತ ಕ್ಹುದಾ ಕರ‍್ಯೊಸ.<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />ಆಂ ಲೊಕಮಾ ಮನಕ್ಹೊನೆ ಘನ್ನು ಅನ್ಯಾಯ ಥಾವಾನು ದೆಕ್ಯೊ. <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />ತೆ ಸುವೈ ಕದ್ಯಾಮ ಕ್ಹುದಾ ಯಕ್ಲಾನೆ ಕಯಾ ಪಸಂದಕ್ಹು ಕಯುಜ ಕೊರೆತೆ ನೈಸೊ ಧನ ದೌಲತ ವರಿ ಘನತೆ ದಿವಸ. ತೆನೈಸೊ ತಿನೆ ಅನುಭವಿಸಾನೆ ಕ್ಹುದಾ ತಿನೆ ತಾಕತ ದಿದ್ಯೊ ನೈ. ತೆ ವರಿಯಕ್ಲೊ ಅನುಭವಸಸ ಎಬಿ ವ್ಯರ್ಥ ವೈ ಕೆಟ್ಟ ಥಯುಸ. <verse eid="ECC 6:2" /><verse number="3" style="v" sid="ECC 6:3" />ಕ್ಹೊ ಬಚ್ಚಾವೊನೆ ಪಡ್ದಿನ ಗಡಿಯೊ ಥಯೆಲಕ್ಕಾ ಘನ್ನಾ ವರಕ್ಹ ಜ್ಯುತೊ ರ‍್ಹಯಲವಾಲಾನೆ ಸಂತೃಪ್ತಿ, ಅಂತೈಕ್ರಿರೆ ನೈ ರ‍್ಹಯಾಮ, ತಿನಾತಿ ಹುಟ್ತಾಮಾ ಮರಿ ಗಯಲ ಬಚ್ಚು಼ ಕೆಕ್ಲುಕಿ ಚೊ಼ಕು ವ್ಹೈ ಕೈನ ವಿಚಾರ ಕರ‍್ಯೊ. <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />ಎ ವ್ಯರ್ಥ ಥೈನ ಆವಸ. ಅಂದಾರಾಮಾ ಜ಼ವೈ ಜ಼ಾವಸ. ಅಂಧಕಾರಬಿ ತಿನಾ ನಾಮೆನೆ ಝಕೈನ ರ‍್ಹವಸ. <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />ತೆ ಸೂರ್ಯಾನೆ ದೆಕ್ಯು ನತ್ತಿ. ತಿನೆ ತಿಳುವಳಿಕೆ ನತ್ತಿ. ರ‍್ಹೈತಬಿ ತಿನಾತಿಬಿ ತಿನಿ ಶಾಂತಿಜ಼ ಹೆಚ಼್ಚ ವ್ಹೈ <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />ಬೆ ಹಜಾ಼ರ ವರಕ್ಹ ತೆ ಜ಼್ಯುತೊ ರ‍್ಹೈತಬಿ ತೆ ತಿನಿ ಆಸ್ತಿನೆ ಅನುಭವಿಶ್ಯೊ ನೈ. ಕ್ಹಾರಾಜ಼ನಾ ಯಕ್ಕಜ ಜ಼ಗಾಕನ ಜಾ಼ವಸ್ತೊ. <verse eid="ECC 6:6" /><verse number="7" style="v" sid="ECC 6:7" />ಮನಕ್ಹ ಪಡ್ದಾನು ಕಸ್ಟಕ್ಹಾರು ತಿನಾ ಪೆಟನಾಹುತಿ ವ್ಹೈ, ರ‍್ಹೈತಬಿ ತಿನೆ ತೃಪ್ತಿ ನತ್ತಿ. <verse eid="ECC 6:7" /><verse number="8" style="v" sid="ECC 6:8" />ಪಿಸಾಳಾತಿಬಿ ಜ್ಞಾನಿನೆ ಹೆಚ್ಚ ಫೈದೊ ಸು ಛೆ? ಮನಕ್ಹೊನಾ ಕ್ಹಾಮಾ ಚ಼ೊಕಿತರಾ ಚಾಲಾನೆ ನೈ ತಿಳದಲವಾಲಾ ಗರಿಬನೆ ಸು ಫೈದೊ ವ್ಹೈ? <verse eid="ECC 6:8" /><verse number="9" style="v" sid="ECC 6:9" />ಬಿಜು಼-ಬಿಜು಼ ಆಸಕರಾತಿ ಡೊಳಾನಾ ಕ್ಹಾಮು ರ‍್ಹಯಲ ಅನುಭವಿಸಾನು ಚೊ಼ಕು ವ್ಹೈ. ಎಬಿ ವಾರಾನೆ ಪಾಚಾ಼ ಲಾಗಲ ನಿಂಗತ ವ್ಯರ್ಥ ವ್ಹೈ. <verse eid="ECC 6:9" /><verse number="10" style="v" sid="ECC 6:10" />ಮನಕ್ಹ ಕೆವೊ ರ‍್ಹೈತಬಿ ಪೈಲಾ ತಿನೆ ದಿದಲ ನಾಮಕ್ಹು ತೆ ಮಾತಿನೊ ವ್ಹೈ ಕೈನ ಗ್ವತ್ತ ಥಯುಸ. ತಿನಾತಿಬಿ ಹೆಚ್ಕಿ ತಾಕತವಾಲಾನಾ ಕ್ಹಾತೆ ವಾದ-ವಿವಾದ ಕರಾನೆ ಥಾತು ನೈ. <verse eid="ECC 6:10" /><verse number="11" style="v" sid="ECC 6:11" />ವಾತೊ ಹೆಚ಼್ಚ ಥಯಲ ತೆಕ್ಲು ಪರಿಣಾಮ ಕಮ್ಮ ವ್ಹೈ, ತಿನಾಕ್ಹು ಮನಕ್ಹನೆ ಸು ಫೈದೊ ವ್ಹೈ? <verse eid="ECC 6:11" /><verse number="12" style="v" sid="ECC 6:12" />ಛೌಲಿ ನಿಂಗತ ವ್ಯರ್ಥ ಥೈನ ಜಾವಾನಾ ಮನಕ್ಹನಾ ಜಿಂದಗಿಮಾ ದಿನ್ನೊ ಕ್ಹಾರಾ ತಿನೆ ಕಯು ಉಪ್ಪರ ವ್ಹೈ ಕೈನ ಕಿನೆ ಗೊತ್ತ ವ್ಹೈ? ತೆ ಮರಲ್ಪರ ಆಲೊಕಮಾ ಸು ಥಾವಸ ಕೈನ ತೆ ಕಿಕ್ಹು ತಿಳದಿಲಿದ್ಯೊ?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s">ಜಿಂದಗಿನಾಹುತಿ ವಿಚಾರೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 7:1" />ಬಾಸನಾ ತೆಲತಿಬಿ ನಾಮಜ಼ ಚೊ಼ಕು ವ್ಹೈ, ವರಿ ಹುಟ್ಟಾನಾ ದಿನತಿಬಿ ಮರಾನೊ ದಿನ್ನಜ಼ ಉಪ್ಪರ ವ್ಹೈ. <verse eid="ECC 7:1" /><verse number="2" style="v" sid="ECC 7:2" />ಹಿವಾನಾ ಘರತಿಬಿ ರವಾ ಧವಾನಾ ಘರೆ ಜಾವಾನು ಚೊ಼ಕು ವ್ಹೈ. ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಲಾಸ್ಟಮಾ ಎಜ಼ ಗತಿ ವ್ಹೈ, ಜುತ್ಯು ರ‍್ಹಯಲ ಮನಕ್ಹ ಆಂ ದೆಕಿನ ತಿನಾ ಮನಸಮಾ ವಿಚಾರ ಕರಸ. <verse eid="ECC 7:2" /><verse number="3" style="v" sid="ECC 7:3" />ಅಕ್ಹಾತಿಬಿ ದುಕ್ಕಜ ಚೊ಼ಕೊ ವ್ಹೈ, ಮ್ಹೊಡು ಚು಼ಮ್ಮಾಯಲತಿಬಿ ಮನಸಜ಼ ಉಪ್ಪರ ವ್ಹೈ. <verse eid="ECC 7:3" /><verse number="4" style="v" sid="ECC 7:4" />ದುಖನು ಘರ ಗ್ಯಾನಿಯೊನಿ ಮನಸನಿ ಜ಼ಗಾ ವ್ಹೈ, ಕ್ಹುಶಿನು ಘರ ಪಿಸಾಳಾವೊನಿ ಮನಸ್ಸನಿ ಜ಼ಗಾ ವ್ಹೈ. <verse eid="ECC 7:4" /><verse number="5" style="v" sid="ECC 7:5" />ಪಿಸಾಳಾವೊನಾ ಗಿದ್ದತಿಬಿ ಗ್ಯಾನಿಯೊ ಬುಚ್ಕಾಡಾನು ಐಕಾನು ಚೊಕು ವ್ಹೈ. <verse eid="ECC 7:5" /><verse number="6" style="v" sid="ECC 7:6" />ಪಿಸಾಳಾವೊನು ಅಖ್ನು ಗಾಡಿಗಿನಾ ಹೆಟಿ ಲಾಗಲ ಕಾಟಾನಾ ಚಟ್ಟಪಟ್ಟ ಅವಾಜ ನಂಗತಜ ವ್ಹೈ. ಎಬಿ ವ್ಯರ್ಥ ವ್ಹೈ. <verse eid="ECC 7:6" /><verse number="7" style="v" sid="ECC 7:7" />ದಬ್ಬಾಳಿಕೆಬಿ ಗ್ಯಾನಿನಿ ಮುರ್ಖ ಕರಸ, ಲಂಚಾ಼ ಮನಸನೆ ಕೆಡಸಸ. <verse eid="ECC 7:7" /><verse number="8" style="v" sid="ECC 7:8" />ಆದಿತಿಬಿ ಅಂತ್ಯಜ಼ ಚೊ಼ಕು ವ್ಹೈ; ಅಹಂಕಾರತಿಬಿ ತಾಳ್ಮೆವಾಲೊ ಚೊ಼ಕೊ ವ್ಹೈ. <verse eid="ECC 7:8" /><verse number="9" style="v" sid="ECC 7:9" />ತುಮಾರು ಮನಸ ಶಿಟ್ಟ ನೈ ಆವಾವರಕ್ಹು ಕರಾದೆ, ಶಿಟ್ಟನೆ ಪಿಸಾಳಾವೊನಿ ಛಾತಿಜ಼ ಚೊ಼ಕು ವ್ಹೈ. <verse eid="ECC 7:9" /><verse number="10" style="v" sid="ECC 7:10" />ಪಾಚ಼ಲ್ಯೊ ಕಾಲ ಆಂ ಕಾಲತಿಬಿ ಉಪ್ಪರ ರ‍್ಹಯಲ ತಿನೆ ಕಾರಣ ಸುಜ಼ ಕವು ನಕೊ. ತು ಎ ವಿಶಯಮಾ ವಿಚಾ಼ರ ಕರಾನು ಗ್ಯಾನಿಯೊನು ಸವಾಲ ನವ್ಹೈ. <verse eid="ECC 7:10" /><verse number="11" style="v" sid="ECC 7:11" />ಗ್ಯಾನಬಿ ಆಸ್ತಿತಿ ಪ್ರಯೊಜನ ವ್ಹೈ. ಹಾಂ ಜ಼್ಯುತಾ ರ‍್ಹಯಲವಾಲಾವೊ ತೆ ಆಸ್ತಿ ಘನ್ನು ಫೈದೊ ಥಯುಸ. <verse eid="ECC 7:11" /><verse number="12" style="v" sid="ECC 7:12" />ದೊಕ್ಡಾ ಕಿಮ್ಮ ವ್ಹೈ ತಿಮ್ಮಜ಼ ಗ್ಯಾನಬಿ ಆಶ್ರಯ ವ್ಹೈ. ಗ್ಯಾನನೆ ಕ್ಹಾಸ ರ‍್ಹಯಲ ಸುವೈ ಕದ್ಯಾಮ ತಿನೆ ಹೊಂದಿಲಿದಲವಾಲನೆ ತೆ ಜಿವದಾಯಕ ಚೊ಼ಕು ವ್ಹೈ. <verse eid="ECC 7:12" /><verse number="13" style="v" sid="ECC 7:13" />ಕ್ಹುದಾನು ಕಾಮ ದೆಕ; ತೆ ವಾಕು ಕರಲ ಸಿದಾ ಕರಾನೆ ಕಿಕ್ಹು ಥಾಸ? <verse eid="ECC 7:13" /><verse number="14" style="v" sid="ECC 7:14" />ಸುಖಾನಾ ದಿನೊಮಾ ಸುಖಾಕ್ಹು ರ‍್ಹೆ, ದುಖನಾ ದಿನೊಮಾ ವಿಚಾ಼ರ ಕರ; ಮನಕ್ಹ ತಿನೊ ಕಾಲ ಥಯಲ್ಪರ ಸಂಬವಿಸಾನು ಕಯುಜ ಲಿದ್ಯಾವಾಚಿ಼, ಕ್ಹುದಾ ಎಕ್ಹಾರು ಯಕ್ಕನಾ ಉಪ್ಪರ ಯಕ್ಕ ಆವಾಲಗಾಡಸ. <verse eid="ECC 7:14" /><verse number="15" style="v" sid="ECC 7:15" />ಮಾರಾ ಜಿವನಮಾ ದೆಕ್ಯೊಸ ನಿತಿವಾಲೊ ತಿನಾ ನಿತಿಮಾ ಹಾಳ ಥಾವಾಸ. ದುಷ್ಟಬಿ ತಿನಾ ದುಷ್ಟತನಮಾ ಘನ್ನಾ ದಿನ ಜ್ಯು಼ತೊ ರ‍್ಹವಸ. ಎ ಕ್ಹಾರು ವ್ಯರ್ಥ ಥಯಲ . <verse eid="ECC 7:15" /><verse number="16" style="v" sid="ECC 7:16" />ತು ಘನೊ ನಿತಿವಾಲೊ ಥೌನಕೊ, ತಾರಾ ನಜ಼ರಮಾ ತು ಗ್ಯಾನಿ ಥವು ನಕೊ. ತುನೆ ತುಜ಼ ನಾಸನೆ ಕಾ ಗುರಿ ಕರಲೆಸಿ? <verse eid="ECC 7:16" /><verse number="17" style="v" sid="ECC 7:17" />ತು ಘನೊ ದುಷ್ಟ ಥೌ ನಕೊ ನೈತೊ ಮುರ್ಖ ಥೌ ನಕೊ, ತಾರೊ ವಕ್ಹತ ಆವಾತಿ ಪೈಲಾಜ಼ ಕಾ ಮರಣ ಹೊಂದಸಿ? <verse eid="ECC 7:17" /><verse number="18" style="v" sid="ECC 7:18" />ತು ಆಂ ಧರಲಿವಾನು ಚೊ಼ಕು ವ್ಹೈ, ತಿನಾಕ್ಹು ಹತ್ತನೆ ಪಾಚೊ಼ ಕಾಡು ನಕೊ. ಕ್ಹುದಾನೆ ಬುಚ್ಕಾಲೊ ತೆ ಕ್ಹಾರಾವೊಕ್ಹು ಪಾರ ಥಾವಸ. <verse eid="ECC 7:18" /><verse number="19" style="v" sid="ECC 7:19" />ದಕ್ಹ ಜನಾ ಅಧಿಕಾರಿಯೊಕ್ಹು ಗಾಮನೆ ಥಾವಾನಿ ತಾಕತತಿಬಿ ಗ್ಯಾನಿನೆ ಗ್ಯಾನಕ್ಹು ಥಾವಾನಿ ತಾಕತಜ಼ ಹೆಚ಼್ಚ ವ್ಹೈ. <verse eid="ECC 7:19" /><verse number="20" style="v" sid="ECC 7:20" />ಪಾಪ ಕರೆವಾಚಿ಼ ನ್ಯಾಯಾ ಕರಾಲಾ ಕ್ಹರಿನಾ ದಾಣ್ಗಾ ಲೊಕಮಾ ನತ್ತಿಜ಼ ನತ್ತಿ. <verse eid="ECC 7:20" /><verse number="21" style="v" sid="ECC 7:21" />ಮನಕ್ಹೊ ಕವಾನಾ ವಾತೊಕ್ಹಾರಾ ಧ್ಯಾನನೆ ಲೌ ನಕೊ, ತಾರೊ ಆಳ ತುನೆ ಶಾರ್ಪ ದಿವಾನು ಕಾನೆ ಪಡ್ಯು. <verse eid="ECC 7:21" /><verse number="22" style="v" sid="ECC 7:22" />ತುಬಿ ಘನಿ ಸಲಾ ಬಿಜಾವೊನೊ ಶಾರ್ಪ ದಿದ್ಯೊಸ ಕವಾನೆ ತಾರು ಮನಸಜ಼ ಸಾಕ್ಷಿ ವ್ಹೈ. <verse eid="ECC 7:22" /><verse number="23" style="v" sid="ECC 7:23" />ಎ ಕ್ಹಾರು ಗ್ಯಾನಕ್ಹು ಪರಿಕ್ಷಾ ಕರ‍್ಯೊ. "ಮಿ ಗ್ಯಾನಿ ಥೌಸ” ಕೈಲಿದ್ಯೊ. ತೆನೈಸೊ ತೆ ಮಾರಾಕ್ಹು ದುರ ಥಯು. <verse eid="ECC 7:23" /><verse number="24" style="v" sid="ECC 7:24" />ಗ್ಯಾನಬಿ ಘನು ದುರಬಿ ಅಗಾಧಮಾಬಿ ಛೆ. ತಿನೆ ಕುನ್ನ ಪಡ್ದಿಲಿದ್ಯಾಸ? <verse eid="ECC 7:24" /><verse number="25" style="v" sid="ECC 7:25" />ಮಿ ಫರಿನ ಗ್ಯಾನೆ ವರಿ ಮೂಲ ತತ್ವನೆ ಧುಂಡಿನ, ವಿಚಾ಼ರ ಕರಿನ ಲಿವಾನಾಹುತಿ ಅನಿತಿ ಮುರ್ಖಬಿ ಅ ಗ್ಯಾನ ಪಿಸಾಳು ವ್ಹೈ ಕೈನ ತಿಳದಿಲಿವಾನಾಹುತಿ ಮನಸ ಮ್ಹೆಲ್ಯೊ. <verse eid="ECC 7:25" /><verse number="26" style="v" sid="ECC 7:26" />ತೆಳಾಮಾ ಮರಣತಿಬಿ ಹೆಚ಼್ಚ ಸುದ್ದಿ ದಿಕ್ಹಿನ ಐ. ಕಯು ವೈ ಕದ್ಯಾಮ ಕೆಟ್ಟ ಹೆಂಗಸ. ತಿನು ಮನಸ ಉರಲೊ, ಬಲಿಯೊ, ತಿನಾ ಭಾಂವಾ ಸಂಕೊಲಿಯ, ಕ್ಹುದಾ ಚೊ಼ಕೊ ವ್ಹೈ ತಿನಾಕ್ಹು ತಪ್ಪಸೈ ಲಿವಾಲೊ. ತೆ ನೈಸೊ ಪಾಪಿಬಿ ತಿನಾ ಹತೆ ಮಳಸ. <verse eid="ECC 7:26" /><verse number="27" style="v" sid="ECC 7:27" />ಪ್ರಸಂಗಿ ಅಮ್ಮ ಕವಸ, " ದೆಕ, ಮಿ ಆಂ ಹುಡ್ಕಿನ ಪಡ್ದಿಲಿದ್ಯೊಸ” ಹಜಿಯಕ್ಕ ಸಂಶೊದನೆನೆ ಕೆಕ್ಲೊ ಚ಼ಲಾಯೊ ತಬಿ ಉತ್ತರ ಮಳ್ಯು ನೈ. <verse eid="ECC 7:27" /><verse number="28" style="v" sid="ECC 7:28" />ಹಜಾ಼ರ ದಾಣ್ಗಾವೊಮಾ ಯಕ್ಲಾ ಯೊಗ್ಯನೆ ದೆಕ್ಯಾವಸ, ತೆನೈಸೊ ಹಜಾ಼ರ ಹೆಣ್ಣ ಮನಕ್ಹೊಮಾ ಯೊಗ್ಯ ಯಕ್ಲಿನೆಬಿ ದೆಕ್ಯಾನತ್ತಿ. <verse eid="ECC 7:28" /><verse number="29" style="v" sid="ECC 7:29" />ಕ್ಹುದಾ ಮನಕ್ಹೊನೆ ಸತ್ಯವಂತ ಕರಿನ ಸೃಷ್ಟಿ ಕರ‍್ಯೊ. ತ್ಯುನೆತಬಿ ಘನಾ ಕಾಮೊ ವಿಚಾ಼ರ ಕರ‍್ಯಾಸ. ಎ ಕ್ಹಾರು ಮಿಜ಼ ದೆಕ್ಯೊಸ.<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="pi">
    <verse number="1" style="v" sid="ECC 8:1" />ಗ್ಯಾನಿ ಲಿಂಗತ ರ‍್ಹವಾಲೊ ಕುನ್ನ ವ್ಹೈ? ವಿಶಯನೆ ತಿಳಸೈನ ಕವಾಲೊ ಕುನ್ನ ವ್ಹೈ? ಗ್ಯಾನಕ್ಹು ಯಕ್ಲಾನು ಮ್ಹೊಡು ಉಜಾ಼ಳು ಹೊಂದಿಲಿವಸ, ಒರಟ ಮ್ಹೊಡು ಬದಲಿ ಥಾವಸ.<verse eid="ECC 8:1" /></para>
  <para style="s">ರಾಜಾ಼ನಿ ಆಗನ್ಯಾ ಪುರಾ ಕರ</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />ಕ್ಹುದಾನಾ ಉಪ್ಪರ ಘಾಲಲ ಖಮ್ಮನಾ ನಿಮಿತ್ತ ರಾಜಾ಼ನಾ ಆಗನ್ಯಾ ಐಕಿಲಿನ ಜೌ಼ಕೈನ ಮಾರು ಭೊದನೆ ವ್ಹೈ. <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />ರಾಜಾ಼ನಿ ಸನ್ನಿದಿಮಾತೊ ಭಾರೊ ಕಾಡಾನೆ ಅಗೊಪಾಚೊ ಕರು ನಕೊ. ದ್ರೊಹನೆ ಸೆರು ನಕೊ. ತಿನಾ ಇಚ್ಛಾನಾ ನಿಂಗತ ಕರಸಕಸ. <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />ರಾಜಾ಼ನಿ ವಾತಮಾ ಅಧಿಕಾರ ಛೆ "ತು ಸು ಕರಾಡೊಸ?” ಕೈನ ಕುನ್ನ ಪುಚ್ಚಸಕಸ. <verse eid="ECC 8:4" /><verse number="5" style="v" sid="ECC 8:5" />ರಾಜಾ಼ನಿ ಆಗನ್ಯಾ ಐಕಾಲೊ ಕಷ್ಟನೆ ಅನುಭವ ಕರ್ತೊ ನೈ. ಕಾಕದ್ಯಾಮ ನ್ಯಾಯ ವಿಚಾರಣೆ ಛೆ ಕವಾನು ಗ್ಯಾನಿನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="ECC 8:5" /><verse number="6" style="v" sid="ECC 8:6" />ಹರಯಕ್ಕ ಕಾರ್ಯನೆ ಯಕ್ಕ ಕಾಲ ವರಿ ಯಕ್ಕ ತಿರ್ಪ ರ‍್ಹವಸಜ಼, ಮನಕ್ಹ ಪಡ್ದಾನಾ ತ್ರಾಸ ತಿನೆ ಭಯಂಕರ ಥಯಾಸ. <verse eid="ECC 8:6" /><verse number="7" style="v" sid="ECC 8:7" />ಅಗು ಸು ಥಾವಸ ಕೆನೆಜ಼ ಗೊತ್ತ ನತ್ತಿ . ಅಗು ಥಾವಾನು ತಿನೆ ಕವಾಲು ಕುನ್ನ ವ್ಹೈ? <verse eid="ECC 8:7" /><verse number="8" style="v" sid="ECC 8:8" />ವಾರಾನೆ ತಡ್ದಾನೆ ಶಕ್ತಿ ಕಿಮ್ಮ ಕಿನೆಜ಼ ನತ್ತಿ, ತಿಮ್ಮಜ಼ ತಾರೊ ಮರಾನೊ ದಿನ ತಡ್ದಾನೆ ತಾಕತ ಕಿನೆಜ಼ ನತ್ತಿ. ಯುದ್ದನಾ ಕಾಲಮಾ ಕಿಮ್ಮ ಟೈಮ ಮಳತು ನೈತೊ, ತಿಮ್ಮಜ ದುಷ್ಟನೆ ದುಷ್ಟತನಾಕ್ಹು ಬಿಡುಗಡೆ ನತ್ತಿ.<verse eid="ECC 8:8" /></para>
  <para style="s">ಕೆಟ್ಟ ಮನಕ್ಹ ವರಿ ಚೊ಼ಕೊ ಮನಕ್ಹ</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9" />ಮಿ ಆಂ ಕ್ಹಾರು ದೆಕಿನ, ಆಂ ಲೊಕಮಾ ಹರಯಕ್ಕ ಥಾವಾನಾ ಕಾರ್ಯಾವೊನೆ ಪರಿಕ್ಷಾ ಕರ‍್ಯೊಸ. ಯಕ್ಕ ಮನಕ್ಹ ಹಜಿಯಕ್ಲಾನಾ ಉಪ್ಪರ ಅದಿಕಾರ ಚಲೈನ ತಿನೆ ಹಾನಿ ಕರಾನೊ ಕಾಲ ಎಜ಼ ವ್ಹೈ. <verse eid="ECC 8:9" /><verse number="10" style="v" sid="ECC 8:10" />ತೆನೈಸೊ ಕೆಟ್ಟ ಮನಕ್ಹನೆ ಮಾತಿ ಥಾವಾನು ದೆಕ್ಯೊ. ತ್ಯುನೆ ಸುಖಾಕ್ಹು ರ‍್ಹವಸ. ಧಾರ್ಮಿಕೊ ಪರಿಶುದ್ದ ಜ಼ಗಾತಾ ಜೌ಼ ಲಾಗ್ಯೂ. ಗಾಮ್ಮಾ ತ್ಯುನಿ ಸ್ಹೆಂ ನೈಸೊ ಥೈಗಯಿ. ಎ ವ್ಯರ್ಥ ವ್ಹೈ. <verse eid="ECC 8:10" /><verse number="11" style="v" sid="ECC 8:11" />ಅಪರಾದನೆ ದಿದಲ ದಂಡಬಿ ಥಯಲ ಕಾರಣ ಅಪರಾಧ ಕರು ಕೈನ ವಿಚಾ಼ರಬಿ ಮನಕ್ಹನಾ ಮನಸಮಾ ಭರಿನ ಪಡಸ. <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />ಯಕ್ಲೊ ಪಾಪಿಬಿ ಕ್ಹೊ ಸಲಾ ಅಪರಾದ ಕರ‍್ಯೊತಬಿ ವಾಚಿನ ರ‍್ಹೆ ಸಕಸ, ತ್ಯುನೆ ಸು ಕವಾಡಾಸ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ಛೆ; ತುಮೆ ಕ್ಹುದಾನೆ ವಿಧೆಯ ಥಯಾರೆ ಕ್ಹಾರು ಚೊ಼ಕೊಜ಼ ಥಾವಸ. <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />ತೆನೈಸೊ ದುಷ್ಟನೆ ಚೊ಼ಕು ಥಾತು ನೈ. ಛೌಲಿ ನಿಂಗತ ರ‍್ಹವಾನಾ ತಿನಾ ದಿನ್ನೊ ಹೆಚ಼್ಚ ಥಾತಾ ನೈ. ಕಾಕದ್ಯಾಮ ತೆ ಕ್ಹುದಾನೆ ವಿಧೆಯ ಥಾತೊ ನೈ.” <verse eid="ECC 8:13" /><verse number="14" style="v" sid="ECC 8:14" />ತೆನೈಸೊ ಲೊಕಮಾ ಥಾವಾನು ಯಕ್ಕ ವ್ಯರ್ಥ ಛೆ. ದುಷ್ಟನಾ ನಡತೆನೆ ತಿನಾತಕ್ಕ ಗತಿ ಚೊಕಾನೆ ಥಾವಸ. ಚೊಕಾನಾ ನಡತೆನೆ ತಕ್ಕ ಗತಿ ದುಷ್ಟೊನೆಬಿ ಥಾವಸ. ಎ ವ್ಯರ್ಥ ವ್ಹೈ ಕೈನ ಮಿ ಕದ್ಯೊ. <verse eid="ECC 8:14" /><verse number="15" style="v" sid="ECC 8:15" />ತಿನಾಹುತಿ ಮಿ ಕ್ಹುಶಿನೆ ಕದ್ಯೊ. ಕಾಕದ್ಯಾಮ ಮನಕ್ಹನೆ ಲೊಕಮಾ ಪಿವಾನು , ಕ್ಹಾವಾನು, ಕ್ಹುಶಿ ಕರಸ ನೈತೊ ಬಿಜು ಸುಜ಼ ಚೊ಼ಕು ನವೈ. ಲೊಕಮಾ ಕ್ಹುದಾ ತಿನೆ ದಿದಲ ದಿನೊಮಾ ತೆ ಪಡ್ದಾನಾ ಪ್ರಯಾಸಮಾ ಕ್ಹುಶಿಜ಼ ಸೆರಲ ರ‍್ಹವಸ. <verse eid="ECC 8:15" /><verse number="16" style="v" sid="ECC 8:16" />ಮಿ ಮಾರಾ ಮನಸಮಾ ಗ್ಯಾನನೆ ಪಡ್ದಾನೆ, ಲೊಕಮಾ ಚಾಲಾನಾ ತಿಳದಿಲಿವಾನೆ ಕೊಶಿಸ ಕರ್ತಾಮಾ, ಮಿ ದೆಕಲ ಸಂಗತಿ ಸುವೈ ಕದ್ಯಾಮ, " ಯಕ್ಲೊ ದಿನರಾತ ಡೊಳಾವೊನೆ ನಿಂದರವಾಚಿ ಹುಶಾರ ರ‍್ಹವಸ, <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />ಕ್ಹುದಾನಾ ಕ್ಹಾರಾ ಕಾಮೊನೆ ವರಿ ಲೊಕಮಾ ಕರಾನಾ ಕಾಮೊನೆ ಮನಕ್ಹ ಹೊಂದಿಲಿವಾನೆ ಸಾಧ್ಯ ಥಾತು ನೈ. ಮನಕ್ಹ ತಿನೆ ಹುಡ್ಕಾನಾಹುತಿ ಕೆಕ್ಲೊ ಕೊಶಿಶ ಕರಿತಬಿ ತಿನೆ ಪಡ್ದಿಲೆತೊ ನೈ. ಹಾಂ, ಗ್ಯಾನಿ ತಿನೆ ಪಡ್ದಿಲಿವಾನೆ ವಿಚಾರ ಕರ‍್ಯೊತಬಿ ತೆ ತಿನೆ ಪಡ್ದಿಲೆತೊ ನೈ.”<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />ಎ ಕ್ಹಾರುಜ಼ ಮಾರಾ ಮನಸಮಾ ವಿಚಾರ ಕರಲಿನ ಯಕ್ಕಜ಼ ಫೈಸ್ಲಾನೆ ಆಯೊ. ತೆ ಸುವೈ ಕದ್ಯಾಮ ನಿತಿವಂತನಾ ವರಿ ಗ್ಯಾನಿಯೊನಾ ಕಾಮೊ ಕ್ಹುದಾನಾ ಹತ್ಮಾ ಛೆ. ಕಯೊಜ಼ ಮನಕ್ಹ ತಿನಾ ಕ್ಹಾಮು ರ‍್ಹವಾನು ಮಯಾನೆ ನೈತೊ ದ್ವೆಷನೆ ಗೊತ್ತ ಕರಲಿವಾನೆ ಥಾತು ನೈ. <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />ಕ್ಹಾರುಜ಼ ಕ್ಹಾರಾವೊನೆ ಯಕ್ಕಜ಼ ತರಾ ಥಾವಸ. ನಿತಿವಂತನೆ ವರಿ ದುಷ್ಟನೆ, ಚೊಕಾ ರ‍್ಹಯಲವಾಲಾನೆ ವರಿ ಕೆಟ್ಟ ರ‍್ಹಯಲವಾಲಾನೆ, ಶುದ್ದವಾಲಾನೆ ವರಿ ಅಶುದ್ದವಾಲಾನೆ, ಬಲಿ ಚ಼ಡಾವಾಲಾನೆ ವರಿ ಚ಼ಡಾಯಲವಾನೆ ಯಕ್ಕಜ಼ ಗತಿ ಥಾವಸ. ಚೊ಼ಕೊ ಕಿಮ್ಮ ತಿಮ್ಮಜ಼ ಪಾಪಿಜ಼ ರ‍್ಹವಸ. ಕಮ್ಮ ಘಾಲಾಲೊ ಕಿಮ್ಮ ತಿಮ್ಮಜ಼ ಕಮ್ಮನೆ ಬುಚ್ಕಾಲೊ ರ‍್ಹವಸ. <verse eid="ECC 9:2" /><verse number="3" style="v" sid="ECC 9:3" />ಎ ಲೊಕಮಾ ಥಾವಾನು ಕ್ಹಾರಾ ಸಂಗತಿಯೊನೆ ಕೆಟ್ಟ ಫಲ ಛೆ ವರಿ ಕ್ಹಾರಾವೊನೆ ಯಕ್ಕಜ಼ ಗತಿ ಥಾವಸ. ತೆನೈಸೊ ಮನಕ್ಹೊನಾ ಮನಸೊಮಾ ಕೆಟ್ಟಜ಼ ಭರ‍್ಯುಸ. ತ್ಯುನೆ ಜ್ಯುತಾ ರ‍್ಹಯೆಲಕ್ಕಾ ಪಿಸಾಳು ತ್ಯುನಾ ಮನಸೊನೆ ಧರಲ ರ‍್ಹವಸ. ತೆ ಥಯಲ್ಪರ ತ್ಯುನೆ ಭೆಗಿನ ಮರಸ. <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />ತೆನೈಸೊ ಜ್ಯುತಾ ರ‍್ಹಯಲ ಗುಂಪಮಾ ಸೆರಲವಾಲಾನೆ ನಿರಿಕ್ಷೆ ರ‍್ಹವಸ. ಮರಲ ಸಿಂಹಾಡಾತಿಬಿ ಜ್ಯುತು ರ‍್ಹಯಲ ಕುತ್ರುಜ಼ ಚೊ಼ಕು ವ್ಹೈ. <verse eid="ECC 9:4" /><verse number="5" style="v" sid="ECC 9:5" />ಯಕ್ಕೆಳೆ ಜ್ಯುತಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಮರಿಯೆಸಕೈನ ಗೊತ್ತ ಛೆ ಮರಲವಾಲಾವೊನೆ ಕಯುಜ಼ ತಿಳವಳಿಕೆ ನತ್ತಿ. ತ್ಯುನೆ ಅಭ್ದಾತು ಪ್ರತಿಫಲ ನತ್ತಿ. ತ್ಯುನೊನೆ ಗ್ಯಾನ ನತ್ತಿ. <verse eid="ECC 9:5" /><verse number="6" style="v" sid="ECC 9:6" />ತ್ಯುನೆ ಮರಲ್ಪರ ತ್ಯುನಿ ಮಯಾಬಿ, ವರಿ ಹಗೆಬಿ, ವ್ಹಚ್ಚಿ಼ಗಿಟ್ಟಿ ಅಳದಿನ ಜಾ಼ವಸ. ಲೊಕಮಾ ಥಾವಾನಾ ಕಯಾಜ಼ ಕಾಮಮಾಬಿ ತ್ಯುನೊನೆ ಹಜಿ಼ಯಕ್ಕ ಪಾಲ ನತ್ತಿ. <verse eid="ECC 9:6" /><verse number="7" style="v" sid="ECC 9:7" />ಜಾ಼ ತಾರಾ ಅನ್ನನೆ ಕ್ಹುಶಿಕ್ಹು ಕ್ಹಾ. ತಾರು ದ್ರಾಕ್ಷಿನು ರಕ್ಹ ಚೊ಼ಕಾ ಕ್ಹುಶಿಕ್ಹು ಪಿ. ಕ್ಹುದಾ ತಾರಾ ಕಾಮೊನೆ ಹಮ್ನಾ ಒಪ್ಪಿಲಿವಸ. <verse eid="ECC 9:7" /><verse number="8" style="v" sid="ECC 9:8" />ತಾರಾ ವಣ್ಣಾ ಕೆಳಾಮಾಬಿ ಧೊಳಾಜ಼ ರ‍್ಹವಾದೆ. ತಾರಾ ಮಾತಾನೆ ತೆಲನು ಅಭಿಶೆಕ ರ‍್ಹವಾದೆ. <verse eid="ECC 9:8" /><verse number="9" style="v" sid="ECC 9:9" />ಲೊಕಮಾ ಕ್ಹುದಾ ತುನೆ ನೆಮ್ಸಲ ವ್ಯರ್ಥ ಜಿವಮಾನನಾ ವ್ಯರ್ಥ ದಿನೊಕ್ಹಾರಾ ತಾರಿ ಮಯಾನಿ ಬೈಕೊನಾ ಕ್ಹಾತೆ ಸುಕಾಕ್ಹು ವಾಚ಼. ತಾರಾ ಬಾಳೊಮಾಬಿ, ತು ಲೊಕಮಾ ಪಡ್ದಾನೆ ಕೊಶಿಸಮಾಬಿ ಎಜ಼ ತಾರು ಪಾಲ ಥಯುಸ <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />ತಾರಾ ಹತೆ ಮಳಲ ಕಾಮನೆ ತಾರಾ ಪೂರಾ ತಾಕತಕ್ಹು ಕರ. ಕಾ ಕದ್ಯಾಮ ತು ಸೆರಾನಿ ಸಮಾಧಿಮಾ ಕಯುಜ಼ ಕಾಮಬಿ, ಯುಕ್ತಿಬಿ, ತಿಳವಳಿಕಿಬಿ, ಗ್ಯಾನಬಿ ರ‍್ಹತು ನೈ. <verse eid="ECC 9:10" /><verse number="11" style="v" sid="ECC 9:11" />ಮಿ ಲೊಕಮಾ ವರಿ ದೆಕ್ತಾಮಾ ಕ್ಹಿಲಾಡಿಯೊನಿ ನ್ಹಾಟಾಮಾ ಜಿ಼ತ್ತ ನತ್ತಿ. ಬಲಿಷ್ಠೊನೆ ಯುದ್ದಮಾ ಜಯಾ ನತ್ತಿ. ಗ್ಯಾನಿಯೊನೆ ಅನ್ನ ಮಳತು ನೈ. ಶ್ಯಾಣ್ಯಾವೊನೆ ಆಸ್ತಿ ಮಳತಿಜ಼ ನೈ ಪ್ರವಿಣನೆ ದಯಾ ಮಳತಿ ನೈ. ಕಾಲಬಿ, ಗತಿಬಿ ಕ್ಹಾರಾವೊನೆ ಗೊತ್ತ ಥಾವಸ. <verse eid="ECC 9:11" /><verse number="12" style="v" sid="ECC 9:12" />ಮನಕ್ಹಬಿ ತಿನಾ ಟೈಮ ಗತಿ ತಿಳದೆವಾಚಿ. ಮಚ಼್ಲಿ಼ಯೊ ಕೆಟ್ಟ ಬಲಿನೆಬಿ, ಪಕ್ಷಿಯೊ ಉರುಲಮಾ ಕ್ಹಾಪ್ಡಾ ನಿಂಗತ ಮನಕ್ಹೊ ಜಾನವರೊ ನಿಂಗತ ತ್ಯುನಾ ಉಪ್ಪರ ಗಪ್ಪನಾ ಪಡಾನಾ ತ್ರಾಸನಾ ಟೈಮನೆ ಕ್ಹಾಪ್ಡಿ ಜಾ಼ವಸ.<verse eid="ECC 9:12" /></para>
  <para style="s">ಗ್ಯಾನನಾಹುತಿ ವರಿ ಪಿಸಾಳಾವೊನಿಯೊ ವಿಚಾರೊ</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />ಮಿ ಲೊಕಮಾ ಗ್ಯಾನನೆ ಆಂ ತರಾ ದೆಕ್ಯೊ. ತೆ ಮ್ಹೊಟು ವ್ಹೈ ಕೈನ ಮನೆ ಗೊತ್ತ ಥಯು. <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />ಹಮ್ನಾ, ಯಕ್ಕ ನ್ಹಾನು ಗಾಮ ತಿಮಾ ದಕ್ಹಾ ಮನಕ್ಹೊ ವ್ಹತ್ತಾ. ಯಕ್ಲೊ ಮ್ಹೊಟೊ ರಾಜ಼ೊ ತಿನೆ ವಿರುದ್ದ ಥೈನ ಘೆರೊ ಘಾಲಿನ ತ್ಯಾ ಮ್ಹೊಟಾ ಕ್ಹಂಬಾವೊನೆ ಘಾಲ್ಯೊ <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />ತೆಳಾಮಾ ತ್ಯಾ ರ‍್ಹಯಲವಾಲಾ ತ್ಯುನಾಮಾ ಯಕ್ಕ ಗರಿಬ ಗ್ಯಾನಿನೆ ದೆಕ್ಯಾ. ತೆ ತಿನಾ ಗ್ಯಾನಕ್ಹು ತೆ ಗಾಮನೆ ವಚಾ಼ಡ್ಯೊ. ತನೈಸೊ ತೆ ಗರಿಬ ಗ್ಯಾನಿನೆ ಕುನ್ನಜ಼ ಸೆಂ ಕರ‍್ಯು ನೈ. <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />ಮಿ ಆಂ ದೆಕಿನ ತಾಕತಿಬಿ ಗ್ಯಾನಜ಼ ಕ್ಹಾಸ ವ್ಹೈ, ತೆನೈಸೊ ಮನಕ್ಹೊ ಗರಿನಾ ಗ್ಯಾನನೆ ತಾತ್ಸಾರ ಕರಿನ ತಿನಾ ವಾತೊನೆ ಧ್ಯಾನ ದೆತಾ ನೈ ಕೈನ ಕೈಲಿದ್ಯೊ. <verse eid="ECC 9:16" /><verse number="17" style="v" sid="ECC 9:17" />ಪಿಸಾಲಾವೊನೆ ಆಳಾಲಾನಾ ಆವಾಜ಼ತಿಬಿ ಗ್ಯಾನಿನಾ ಹಲ್ಲು ಬೊಲಾನಾ ವಾತೊ ಕಾನೆ ಐಕಾವಸ. <verse eid="ECC 9:17" /><verse number="18" style="v" sid="ECC 9:18" />ಯುದ್ದನಾ ಆಯುಧೊತಿಬಿ ಗ್ಯಾನಜ಼ ಚೊ಼ಕು ವ್ಹೈ. ತೆನೈಸೊ ಯಕ್ಕ ಪಾಪಿ ಘನ್ನು ಚೊ಼ಕು ಹಾಳಕರಸ.<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 10:1" />ಮರಲ ಮಾಕ್ಹಿಯೊಕ್ಹು ಗಂದಾನು ತೆಲ ಕ್ಹಡಿನ ಬಾಸ ಆವಸ. ತಿಮ್ಮಜ಼ ದಕ್ಹು ಪಿಸಾಳುಪನ ಗ್ಯಾನನೆ ವರಿ ಘನತೆನೆ ಕೆಡಸಸ. <verse eid="ECC 10:1" /><verse number="2" style="v" sid="ECC 10:2" />ಗ್ಯಾನಿನೆ ಬುದ್ದಿ ತಿನಾ ಸಿದಾ ಬಗಲ ರ‍್ಹವಸ. ಅ ಗ್ಯಾನಿನಿ ಬುದ್ದಿ ತಿನಾ ರೊಡ್ಡಾ ಬಗಲ ರ‍್ಹವಸ. <verse eid="ECC 10:2" /><verse number="3" style="v" sid="ECC 10:3" />ತೆ ನೈಸೊ ಪಿಸಾಳೊ ಬುದ್ದಿ ತಪ್ಪಿನ ಫರಾನಾ ವಾಟಮಾ ತಿನು ಪಿಸಾಳುಪನ ಕ್ಹಾರಾವೊನೆ ದೆಕಾಡಸ. <verse eid="ECC 10:3" /><verse number="4" style="v" sid="ECC 10:4" />ಸೌಕಾರ ತಾರಾ ಉಪ್ಪರ ಸಿಟ್ಟ ಥಯಾರೆ ಕಾಮನೆ ಛೊಡು ನಕೊ. ತಾಳ್ಮೆ ಮ್ಹೊಟಿ ಸಿಟ್ಟನೆ ಝಕಾಡಸ. <verse eid="ECC 10:4" /><verse number="5" style="v" sid="ECC 10:5" />ಲೊಕಮಾ ಯಕ್ಕ ಸಂಕಟ ದೆಕ್ಯೊಸ. ತೆ ಆಳಾವಾಲಾನಾ ಮ್ಹೊಡಾತು ಆವಾನು ನಿಂಗತ ದಿಕ್ಹಸ. <verse eid="ECC 10:5" /><verse number="6" style="v" sid="ECC 10:6" />ಪಿಸಾಳಾವೊನೆ ಮ್ಹೊಟಿ ಪದವಿ ಮಳಸ. ಪದವಿ ರ‍್ಹಯಲವಾಲೊ ಕೆಟ್ಟ ಸ್ಥಿತಿಮಾ ರ‍್ಹವಸ. <verse eid="ECC 10:6" /><verse number="7" style="v" sid="ECC 10:7" />ಆಳೊ ಘೊಡಾನಿ ಸವಾರಿ ಕರಾನು ಪ್ರಬು ಜಿಮಿನ್ಪರ ಚಾ಼ಲಾನು ದೆಕ್ಯೊಸ. <verse eid="ECC 10:7" /><verse number="8" style="v" sid="ECC 10:8" />ಖಾಡಿ ಕ್ಹಂದಾಲೊ ತೆಜ಼ ತಿಮಾ ಪಡಸ, ಗೊಡಿ ಫೊಡಾಲಾನೆ, ಕ್ಹಾಪ ಕಡ್ಡಸ. <verse eid="ECC 10:8" /><verse number="9" style="v" sid="ECC 10:9" />ದಗ್ಡಾಕ್ಹು ಕಾಮ ಕರಾಲಾನೆ ದಗ್ಡಾಕ್ಹು ಮಾರ ಬೆಟಸ. ಯಕ್ಕೆಳೆ ಲಾಕ್ಡಾ ಕತ್ರಾಲಾನೆ ಲಾಕ್ಡಾಕ್ಹುಜ಼ ಮಾರ ಬೈಟಸ. <verse eid="ECC 10:9" /><verse number="10" style="v" sid="ECC 10:10" />ಮಂಡ ಕೊಡ್ಲಿನು ಮ್ಹೊಡು ಚ಼ುಪ ನೈ ಕರ‍್ಯಾರೆ ತೆ ಹೆಚ್ಚ ತಾಕತನೆ ಉಪಯೊಗ ಕರು. ಕಾಮಪುರಾ ಥಾವಾನೆ ಗ್ಯಾನಜ಼ ಮದತ ವ್ಹೈ. <verse eid="ECC 10:10" /><verse number="11" style="v" sid="ECC 10:11" />ಕ್ಹಾಪನೆ ಮಳ್ಳಕರಾಲಾನೆ ಕ್ಹಾಪ ಕಡ್ಯಾರೆ, ಕ್ಹಾಪ ಮಳ್ಳಕರಾಲಾನೆ ಸುಜ಼ ಫೈದೊ ನತ್ತಿ. <verse eid="ECC 10:11" /><verse number="12" style="v" sid="ECC 10:12" />ಗ್ಯಾನಿನಿ ವಾತ ಚೊ಼ಕು ವ್ಹೈ ಅ ಗ್ಯಾನಿನು ಮ್ಹೊಡು ತಿನೆಜ಼ ಗಳಿಜಾ಼ವಸ. <verse eid="ECC 10:12" /><verse number="13" style="v" sid="ECC 10:13" />ಅ ಗ್ಯಾನಿನಾ ವಾತೊ ಶುರವಾತಮಾ ಚೊಕಾವ್ಹೈ, ಲಾಸ್ಟಮಾ ತ್ರಾಸನಾ ಉಸುಕ ವ್ಹೈ. <verse eid="ECC 10:13" /><verse number="14" style="v" sid="ECC 10:14" />ಮನಕ್ಹನಾ ಕ್ಹಾಮು ಥಾವಾನು ತಿಳದ್ಯೊಸ. ತೆ ಟೈಮ ಥಯಲ್ಪರ ಅಮ್ಮಜ಼ ಥಾವಸ ಕೈನ ಕಿನಾಕ್ಹು ತಿಳ್ದಿಲಿವಸ? ಅ ಗ್ಯಾನಿನಾ ವಾತೊ ಘನ್ನಾ.<verse eid="ECC 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 10:15" />ಗಾಮನಿ ವಾಟ ನೈ ಗೊತ್ತ ರ‍್ಹಯಲವಾಲಾನೆ ಪಿಸಾಳಾ ತಿಳ್ಸಾಯಲ್ಪರ, ಕರಾನಿ ಕೊಶಿಸಕ್ಹು ವ್ಯರ್ಥಜ಼ ವ್ಹೈ. <verse eid="ECC 10:15" /><verse number="16" style="v" sid="ECC 10:16" />ದೆಶನೊ ರಾಜ಼ೊ ಜಾಂನಜಿಮಾನ ಥಯಾರೆ ಪ್ರಬುವೊ ಕ್ಹಾರಾ ಕ್ಹಾವಾನೆ ಬೈಟ್ಯಾರೆ ತುನೆ ಕೆಟ್ಟ ನಶಿಬ ವ್ಹೈ! <verse eid="ECC 10:16" /><verse number="17" style="v" sid="ECC 10:17" />ರಾಜೊ಼ ಅಂಗ ರಾಕು ನೈ ರ‍್ಹೈನ ತಿನಾ ಸ್ವಂತ ಫೈಸಲಾ ಲಿವಾಲೊ ಥೈನ ತಿನು ಅದಿಕಾರಿಯೊ ಕರೆಟ್ಟ ಟೈಮಮಾ ಕ್ಹಾವಾನೆ ಬೆಟಾಲಾ ರ‍್ಹಯಾಮ ತುನೆ ಕಕ್ಲುಕಿ ಚೊ಼ಕು ವ್ಹೈ <verse eid="ECC 10:17" /><verse number="18" style="v" sid="ECC 10:18" />ಕುನ್ನತಬಿ ತಿನಾ ಘರನಿ ಛತ್ತ ಸಿದಾ ಕರಾನೆ ಘನ್ನೊ ಅಂಗರಾಕು ಥಯಾರೆ. ತಿನಾಹುತಿ ಘರ ಚ಼ುವಸ. <verse eid="ECC 10:18" /><verse number="19" style="v" sid="ECC 10:19" />ಅಕ್ಹಾನಾಹುತಿ ಕ್ಹೌ, ದ್ರಾಕ್ಷಿನಾ ರಕ್ಹಕ್ಹು ಜಿವನನೆ ಕ್ಹುಸಿ ವ್ಹೈ, ದೊಕ್ಡಾ ಕ್ಹಾರುಜ಼ ದಿವಸ <verse eid="ECC 10:19" /><verse number="20" style="v" sid="ECC 10:20" />ಮನಸಮಾಜ಼ಬಿ ರಾಜ಼ಾನೆ ದೊಷ ದ್ಯು ನಕೊ.ಕ್ಹುರವಾನಿ ಕ್ಹೊಲಿಮಾಬಿ ಸೌಕಾರನೆ ಗಾಳೊ ದ್ಯು ನಕೊ. ಹಬಾಳನಾ ಪಕ್ಷಿಯೊ ತೆ ಅವಾಜ಼ನೆ ಮುಟ್ಟಸಾವಸ; ಪಕ್ಷಿಬಿ ತೆ ವಿಷಯನೆ ತಿಳಸಾವಸ<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s">ಗ್ಯಾನಿ ಮನಕ್ಹ ಸು ಕರಸ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 11:1" />ತಾರಾ ದೊಕ್ಡಾ ಭಾರ್ಲ್ಯಾ ದೆಶನಾ ಉಪ್ಪರ ವ್ಯಾಪಾರನೆ ಘಾಲ ಘನ್ನಾ ದಿನ್ನ ಥಯಲ್ಪರ ತೆ ತುನೆ ಬಡ್ಡಿನಾ ಕ್ಹಾತೆ ತುನೆ ಮಳಸ. <verse eid="ECC 11:1" /><verse number="2" style="v" sid="ECC 11:2" />ತಾರಾ ದೊಕ್ಡಾ ಕ್ಹಾತ ನೈತೊ ಆಟ ಜ಼ಗಾವೊಮಾ ಘಾಲ. ಕಾಕದ್ಯಾಮ ಕೆಳಾಮಾ ಕಿಮ್ಮ ಕೆಟ್ಟ ಟೈಮ ಆವಸ ಕವಾನು ತುನೆ ಗ್ವತ್ತ ಥಾತು ನೈ. <verse eid="ECC 11:2" /><verse number="3" style="v" sid="ECC 11:3" />ಪಾನಿ ಭರಲ ಮ್ಹಾಡ ತಿನಾಕ್ಹು ತೆಜ಼ ಜಿಮಿನ್ಪರ ಪಡಸ,ಝಾಡ ಉತ್ತರ ದಿಕ್ಕೆ ರ‍್ಹವಾದೆ, ದಕ್ಷಿಣ ದಿಕ್ಕೆ ರ‍್ಹವಾದೆ ಪಡ್ಯಾಮ ಪಡಲ ಜ಼ಗಾಜ಼ ರ‍್ಹವಸ. <verse eid="ECC 11:3" /><verse number="4" style="v" sid="ECC 11:4" />ವಾರಾನೆಜ಼ ದೆಕ್ತೊ ರ‍್ಹವಾಲೊ ಬಿಯಾ ಬಿತ್ತತೊ ನೈ, ಮ್ಹಾಡನೆ ದೆಕ್ತೊ ರ‍್ಹವಾಲೊ ಪೈನೆ ಕಾಟ್ತೊ ನೈ. <verse eid="ECC 11:4" /><verse number="5" style="v" sid="ECC 11:5" />ಉಸುಲನಿ ವಾಟನೆ ಪೆಟೆ ರ‍್ಹಯಲ ಬಾಕ್ಡಿನಾ ಪೆಟಮಾ ಹಡ್ಕಾ ಬೆಳ್ದಾನಾ ತರಿಕಾನೆ, ತು ಕಿಮ್ಮ ತಿಳದತೊ ನೈ ತಿಮ್ಮಜ಼ ಸರ್ವಶಕ್ತ ಥಯಲ ಕ್ಹುದಾನು ಕಾಮ ತಿಳದಿಲೆತಾ ನೈ. <verse eid="ECC 11:5" /><verse number="6" style="v" sid="ECC 11:6" />ಪಾಟೆ ಬಿಯಾನೆ ಬಿತ್ತ; ಕ್ಹಾಂಜ಼ಲಕ್ಕಾ ತಾರೊ ಹತ್ತ ಪಾಚೊ ಕಾಡು ನಕೊ, ಆಂ ಸಫಲ ಥಾವಸತೊ ನೈತೊ ತೆ ಸಫಲಥಾವಸ, ನೈತೊ ಯಕ್ಕಳೆ ಭಂಭಿ ಚೊಕಾ ಥಾವಸತೊ ತುನೆ ತಿಳದಸ. <verse eid="ECC 11:6" /><verse number="7" style="v" sid="ECC 11:7" />ಕ್ಹರಿಮಾಜ಼ ಉಜಾಲು ಚೊ಼ಕುಬಿ, ವರಿ ಸುರ್ಯಾನೆ ದೆಕಾನು ಡೊಳಾನೆ ಚೊ಼ಕು ರ‍್ಹವಸ. <verse eid="ECC 11:7" /><verse number="8" style="v" sid="ECC 11:8" />ಘನಾ ವರ‍ಕ್ಹ ಜ್ಯುತೊ ರ‍್ಹಯಲವಾಲೊ ತೆ ಕ್ಹಾರಾವೊನಿ ಕ್ಹುಶಿ ಥಾವಾದೆ, ತೆನೈಸೊ ಅಂದಕಾರನಾ ದಿನೊನೆ ಸ್ಹೆಂನೆ ಲಾವಾದೆ, ಕಾಕದ್ಯಾಮ ತೆ ಘನ್ನಾ ರ‍್ಹಯಲ ರ‍್ಹವಸ. ಅಗು ಥಾವಾನು ಕ್ಹಾರುಜ಼ ವ್ಯರ್ಥ ವ್ಹೈ.<verse eid="ECC 11:8" /></para>
  <para style="s">ಜಾಂಜಿಮಾನೊನೆ ಚೊ಼ಕಾ ವಿಚಾರೊ</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9" />ಜಾಂಜಿಮಾನ, ಜಾಂಜಿಮಾನ ರ‍್ಹತಾಮಾ ಕ್ಹುಶಿಕ್ಹು ರ‍್ಹೆ,ಜಾಂಜಿಮಾನನಾ ದಿನ್ನೊಮಾ ತುನೆ ತಾರು ಮನಸ ಕ್ಹುಶಿ ಕರಾದೆ. ಮನಸನೆ ಆಯಲ ತಿಮ್ಮ, ಡೊಳಾನೆ ಚೊ಼ಕು ಲಾಗಲ ತಿಮ್ಮ ಚಾ಼ಲಿಲೆ. ತೆನೈಸೊ ಆಂ ಕ್ಹಾರಿ ವಿಷಯಮಾ ಕ್ಹುದಾ ತುನೆ ನ್ಯಾಯ ವಿಚಾ಼ರನಾ ಫೈಸ್ಲಾನೆ ಗುರಿ ಕರಸ. <verse eid="ECC 11:9" /><verse number="10" style="v" sid="ECC 11:10" />ತಾರಾ ಮನಸಮಾ ದುಖನಾಹುತಿ ಚಿಂತಾ ಕರು ನಕೊ, ತು ಘನ್ನಾ ದಿನ್ನ ಲಕ್ಕಾ ಅಮ್ಮಜ಼ ಜಾಂಜಿಮಾನ ಥೈನ ರ‍್ಹತೊ ನೈ.<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1" />ತ್ರಾಸನಾ ದಿನೊ ಆವಾತಿ ಪೈಲಾಜ಼, " ಇಮಾ ಮನೆ ಕ್ಹುಶಿ ನತ್ತಿ” ಕೈನ, ತು ಕವಾನಾ ವರಕ್ಹೊ ನಜಿಕ ಆವಾತಿ ಪೈಲಾಜ಼, ಜಾಂಜಿಮಾನ ರ‍್ಹತಾಮಾಜ಼ ತಾರಾ ಸೃಷ್ಟಿ ಕರ್ತಾನೆ ಸ್ಹೆಂ ಕರ. <verse eid="ECC 12:1" /><verse number="2" style="v" sid="ECC 12:2" />ಸುರ್ಯೊ, ಚಂದಪ್ಪಾ ವರಿ ಚಿಕ್ಕಿಯೊ ಅಂದಾರು ಥಾವಾತಿ ಪೈಲಾಜ಼, ಪಾನಿನಾ ಮ್ಹಾಡೊ ಫರಿನ ಆವಸ. <verse eid="ECC 12:2" /><verse number="3" style="v" sid="ECC 12:3" />ತಾಕತವರ ಥಯಲ ತಾರಾ ಪಗೊ ವಾಕಾ ಥಾವಸ, ದಾತೊ ಉದರಿನ ಚಾ಼ವಾನು ಕಾಮ ಹುಬ್ರೈ ಜಾ಼ವಸ. ಕಿಂಡಕಿಯೊ ನಿಂಗತ ರ‍್ಹಯಲ ಡೊಳಾ ಮಂಕ ಥಾವಸ. <verse eid="ECC 12:3" /><verse number="4" style="v" sid="ECC 12:4" />ಕಾನೊ ಕ್ಯುಡಾ ಥೈನ ಒಣಿಯೊನಿ ಅವಾಜ಼ ಐಕು ಆತು ನೈ. ವಾಟಾನು ಅವಾಜ಼ ಬಾರಿಕ ಥೈನ ಚುಮ್ಣಿನಿ ಅವಾಜ಼ ನಿಂಗತ ನ್ಹಾನು ಥಾವಸ ವರಿ ವಾಟಾಲಾವೊನಾ ಗಿದ್ದ ಬಾರಿಕ ಥೈ ಜಾ಼ವಸ. <verse eid="ECC 12:4" /><verse number="5" style="v" sid="ECC 12:5" />ತೆನೈಸೊ ತೆ ದಿನೊಮಾ ಮನಕ್ಹನೆ ದಿನ್ನೆನೆ ದೆಕ್ಯಾರೆ ಭೆಂ, ವರಿ ವಾಟಮಾ ತ್ರಾಸ ವ್ಹೈ, ಬಾದಾಮನು ಝಾಢ ಫುಲ್ಲೊ ಲಿಂಗತ ಮಾತಾನಾ ಬಾಲೊ ಧೊಳಾ ಥಾವಸ, ಚಿಡ್ಡೊಬಿ ವಜ್ಜೊ ಥಯಲ ರ‍್ಹವಸ, ಆಸ ಕುಂದಸ. ಮನಕ್ಹ ತಿನಾ ಹಮೆಶಾ ರ‍್ಹವಾನೆ ಜ಼ಗಾಯೆ ಜಾ಼ವಸ, ಗೊಳಾಟವಾಲಾ ಬಿದಿಮಾ ಫರಸ. <verse eid="ECC 12:5" /><verse number="6" style="v" sid="ECC 12:6" />ಇನಾ ಉಪ್ಪರ ರುಪ್ಪಾನಿ ಸರಾಬಿ ಕಿತ್ತಯಿ ಜಾ಼ವಸ, ಕ್ಹೊನಾನೊ ಕುಂಡೊ ಚ಼ಪ್ಟೈ ಜಾ಼ವಸ, ಹಂಡ್ಲುಬಿ ಬುಗ್ಗೆನಾ ಕ್ಹಾಮು ಫುಟಿಜಾ಼ವಸ, ಇರನಿ ರಾಟಿ ತುಟಿ ಜಾ಼ವಸ, <verse eid="ECC 12:6" /><verse number="7" style="v" sid="ECC 12:7" />ಮಾತಿ ಜಿಮಿನೆ ಮಳಿನ ರ‍್ಹಯಲ ನಿಂಗತ ಥಾವಸ, ಆತ್ಮಾ ತಿನೆ ದಯಾ ಕರಲ ಕ್ಹುದಾಕನ ಸೆರಸ. <verse eid="ECC 12:7" /><verse number="8" style="v" sid="ECC 12:8" />"ವ್ಯರ್ಥಜ಼ ವ್ಯರ್ಥ ವ್ಹೈ, ಪೂರಾಜ಼ ವ್ಯರ್ಥ” ಕೈನ ಪ್ರಸಂಗಿ ಕವಸ.<verse eid="ECC 12:8" /></para>
  <para style="s">ಲಾಸ್ಟನಾ ವಾತೊ</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />ಪ್ರಸಂಗಿ ಗ್ಯಾನಿ ರ‍್ಹಯಲಕ್ಹು, ಮನಕ್ಹೊನೆ ತಿಳವಳಿಕೆ ಕತೊ ಆಯೊ, ಘನ್ನಾ ಗ್ಯಾನಿಯೊನೆ ದ್ಯಾನ ಕರಿನ ಪರಿಕ್ಷಾ ಕರಿನ ಚೊ಼ಕು ಕರ್ಯೊ. <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />ತೆನೈಸೊ ಪ್ರಸಂಗಿನಾ ಯಥಾರ್ಥ ನಡತೆಕ್ಹು ಕರಲ ಒಪ್ಪಲ ಕ್ಹರಿನಾ ವಾತೊನೆ ಹುಡಕಿನ ಇನಿಲಿನ ಬರ್ದ್ಯೊ. <verse eid="ECC 12:10" /><verse number="11" style="v" sid="ECC 12:11" />ಗ್ಯಾನಿಯೊನಾ ವಾತೊ ಕಾಟಾನಿಯೊ ಕಂಟಿಯೊ, ಚೊಕಾ ವಾಕ್ಯಾವೊ ಬಿಗಿ ಥೈನ ಮಾರಲ ಮೂಳಾವೊ ಎಬೆ ಯಕ್ಲಾಜ಼ ಕುರಬಾಕ್ಹು ದಿವಾ ಲಗಾಡಾಸ. <verse eid="ECC 12:11" /><verse number="12" style="v" sid="ECC 12:12" />ಮಾರಾ ದಿಕ್ರಾ, ತೆನೈಸೊ ಉಗ್ರಲಮಾ ಹುಶಾರಕ್ಹು ರ‍್ಹೆ. ಘನಾ ಬುಕ್ಕೊನಾ ರಚನೆನೆ ಮಿತಿನತ್ತಿ. ಅತಿ ವ್ಯಾಸಾಂಗ ಅಂಗನೆ ಚೊ಼ಕುವ್ಹೈ. <verse eid="ECC 12:12" /><verse number="13" style="v" sid="ECC 12:13" />ವಿಷಯ ಮುಗ್ದ್ಯುಸ ಕ್ಹಾರುಜ ಐಕಿನ ಕ್ಹರ‍್ಯು, ಕ್ಹುದಾನೆ ಬುಚ್ಕಿನ ತಿನಾ ಆಗನ್ಯಾನೆ ಚಾ಼ಲಿಲಿನ, ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಕರ್ತವೆ ವ್ಹೈ. <verse eid="ECC 12:13" /><verse number="14" style="v" sid="ECC 12:14" />ಚೊ಼ಕು ಥಾವಾದೆ ನೈತೊ ಕೆಟ್ಟ ಥಾವಾದೆ, ಘನಾ ರಹಸ್ಯ ಸಂಗತಿಯೊನೆ ಹುತಿ , ನ್ಯಾಯನಾ ವಿಚಾ಼ರನೆ ಕ್ಹುದಾ ಹರಯಕ್ಕನೆ ನ್ಯಾಯ ತಿರ್ಪನೆ ಲಾವಸ.<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>