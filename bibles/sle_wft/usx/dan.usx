<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="DAN" style="id">- Sikkiligar</book>
  <para style="h">ದಾನಿಯಲ</para>
  <para style="toc3">ದಾನಿಯಲ</para>
  <para style="toc2">ದಾನಿಯಲ</para>
  <para style="toc1">ದಾನಿಯಲ ಪ್ರವಾದಿನು ಬುಕ್ಕ</para>
  <para style="mt1">ದಾನಿಯಲ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಎ ದಾನಿಯಲ ಪುಸ್ತಕ ಇಸ್ರಾಯೆಲೊನಾ ಮನಕ್ಹೊ ಬಾಬೆಲೊನಮಾ ಗುಮಾಮೊ ರ‍್ಹಯಲ ವಕ್ಹತಮಾ ಪ್ರವಾದಿ ದಾನಿಯಲನೆ ಥಯಲ ದರ್ಶನ ಜಿವ್ನಾನಾಹುತಿ ಕವಸ. ಎ ದಾನಿಯಲ ವರಿ ತಿನಾ ದೊಸ್ತೊನಾಹುತಿ ಬರೊಕ್ಹೊನಾ ಹುತಿ ವರಿ ದುನಿಯಾಮಾನಾ ದೆಶೊನಾ ಪ್ರವಾದನೆನಾ ಹುತಿ ಕವಸ. ಎ ಪುಸ್ತಕ ಕ್ರಿಸ್ತ ಪುರ್ವ 605 ಸುಮಾರು 535 ನು ವಕ್ಹತಮಾ ಥಯಲ ವ್ಹೈ. (ಕವರ ಕರಸ) ಎ ವಕ್ಹತಮಾ ದಾನಿಯಲ ಬಾಬೆಲೊನನು ಚಾರ ಬಿಜಾ಼ ಬಿಜಾ಼ ರಾಜಾ಼ವೊನಾಹುತಿ ವಕ್ಹತಮಾ ಸೆವೆ ಕರ‍್ಯೊಸ. ಸಾಂಪ್ರದಾಯಕನಿಂಗತ ದೆಕಾನು ರ‍್ಹಯುಮ ಎ ಪುಸ್ತಕ ದಾನಿಯಲಜ಼ ಬಾಬೆಲೊನಾ ವಕ್ಹತಮಾ ಬರದ್ಯೊಸ, ತೆ ನೈಸೊ ಘನ್ನಾ ಆಧುನಿಕ ವಿದ್ವಾಂಸೊ ಎ ಪುಸ್ತಕ ಪಾಚಾ಼ತಾ ಇಸ್ರಾಯೆಲಮಾಕ್ರಿಸ್ತಪುರ್ವ 2 ವಾ ವಕ್ಹತಮಾ ಶ ತಮಾನಮ ಬರ್ದಲ ವ್ಹೈಕೈನ ಕವಸ. ಹಜು಼ನ ದಕ್ಹಾಜ಼ನಾ ಪುಸ್ತಕೊನಾ ದಕ್ಹಾ ಭಾಗೊ ಬುಜಾ಼ ಬಿಜಾ಼ ವಕ್ಹಮಾ ಬರದಲ ವ್ಹೈ ಕೈನ ಬರೊಕ್ಹೊ ಕರಸ.</para>
  <para style="ip">ದಾನಿಯಲನು ಪುಸ್ತಕ ಗುಲಾಮೊ ಥೈನ ರ‍್ಹಯಲವಾಲಾ ಇಸ್ರಯೆಲೊನೆ, ವರಿ ಅಗಲಿ ಪಿಳಿಗೆನೆ ಕಥಿನ ವಕ್ಹತ ಆತಾಮಾ ಯಕ್ಕ ಬರೊಕ್ಹೊ ದಿವಾನಾ ಹುತಿ ಬರ್ದಲ ವ್ಹೈ. ಕ್ಹುದಾ ದನಿಯಲನಿ ಜಿವನಮಾ ಥಯಲ ಘಟಣೆನಾಹುತಿ ವರಿ ಭವಿಶ್ಯಮಾ ಥಾವಾನಿಯೊ ಪ್ರವಾದೆನೆ ಬೆವಾ ಘಟಣೆ ಮುಕಾಂತರ ರಾಜಾ಼ ವರಿ ದೆಶೊಪರ ತಿನಿ ತಾಕತ ದೆಕಾಡಿನೆ ದಿವಸ. ಸತ್ಯವೆದನಮಾ ಎ ನವು ಒಡಂಬಡಿಕೆಮಾ ಕ್ಹುದಾನಿ ರಾಜ್ಯನಾ ಹುತಿ ತಿಳದಾನೆ ಮದತ ಕರಸ. ಪೈಲಾ ಮಸಿಹಾನಾಹುತಿ ದಾನಿಯಲ 7, 13: 14 ಮಾ ಮಸ್ಸಿಹಾನಾ ಹುತಿ ಕದಲ ಛೆ. ದಾನಿಯಲನಾ ದರ್ಶನೊ ಯೆಸುನಾ ಮುಲಕ ಅಂತ್ಯಕಾಲನಿ ವಿಶಯನಾ ಹುತಿ ವರಿ (ಮತ್ತಾಯ 18.15, ಮಾರ್ಕ 13.14) ಯೊಹಾನನು ಪ್ರಕಟಣೆನಾ ಹುತಿ ಕದಲ ಛೆ ಬರದ್ಯಾಸ ಕೈನ ಕವಸ. ದಾನಿಯಲ ಯೆರೆಮಿಯಾನು ಪ್ರಾವಾದನೆ ವಿಚಾರಣೆ ಕರಸ.(ದಾನಿಯಲ 9 ಅದ್ಯಾಯ 1 ತಿ 3 ವಚನಾ)</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1. 1 ತಾ 4 ನೆ ಅಧ್ಯಾಯ ನೆಬುಕನೆಚ ಆಳ್ವಿಕೆನಾ ವಕ್ಹತಮಾ ಬಾಬೆಲೊನಮಾ ದಾನಿಯಲ ವರಿ ತಿನಾ ದೊಸ್ತೊನಾಹುತಿ ಕವಸ.</para>
  <para style="io1">2. ಅಧ್ಯಾಯ 5 ದಾನಿಯಲ ರಾಜೊ಼ ಬೆಲ್ಶಚ್ಚರನ ದರ್ಶನನು ಮತ್ಲಬ ಕವಸ.</para>
  <para style="io1">3. ಅಧ್ಯಾಯ 6 ಡೆರಿಯಸ್ ಆಳ್ವಿಕೆಮಾ ಸಿಂಯ್ಯಾನಿ ಗವಿಮಾ ದಾನಿಯಲನ ಹುತಿ ಕವಸ..</para>
  <para style="io1">4. ಅಧ್ಯಾಯೊ 7-12 ಭವಿಷ್ಯನಿ ಘಟನೆನಾ ಹುತಿ ಸಂಭಂಧನಿಂಗತ ಕ್ಹುದಾಕ್ಹು ದಾನಿಯಲನೆ ಭಾರಾಕಾಡಾನು ಛೆ. ಎ. ಅಧ್ಯಾಯೊಮಾ 7-8 ಮಾ ದಾನಿಯಲನಾ ಭವಿಶ್ಯನಾಹುತಿ ಬೆ ದರ್ಷನೊ ವರಿ ತ್ಯುನಾ ವ್ಯಾಕ್ಯಾನನಾ ಹುತಿ ಕವಸ. ಬಿ. ಅಧ್ಯಾಯ 9 ಮಾ ದಾನಿಯಲ ತಿನಾ ಮನಕ್ಹೊನಾಹುತಿ ಪ್ರಾಥನಾ ಕರಸ ವರಿ ದೆವದುತ ಗ್ಯಾಬ್ರಯಲಕ್ಹು ಜವಾಬ ದಿವಸ. ಸಿ. ಅಧ್ಯಾಯಾ 10-12 ಮಾ ಗೇಬ್ರಿಯಲ್ ಲಾಸ್ಟನಾ ವಕ್ಹತೊನೆ ಮ್ಹೈ ರ‍್ಹಯಲ ಭವಿಶ್ಯೊನಾ ಘಟ್ನಾವೊನೆ ದೆಕಾಡಿನೆ ದಿವಸ.</para>
  <chapter number="1" style="c" sid="DAN 1" />
  <para style="s">ನೆಬುಕದ್ನೆಚ್ಚರ ರಾಜಾ಼ನಾ ನ್ಯಾಯಾಲಯನಾ ಕ್ಹಾಮಾ ಜಾಂಜಿಮಾನೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1" />ಶನೆಬುಕದ್ನೆಚ್ಚರ ಬಾಬೆಲೊನನೊ ರಾಜೊ಼ ಥಯೊತೊ. ನೆಬುಕದ್ನೆಚ್ಚರ ಯೆರುಸಲೆಮನೆ ಆಯೊ. ನೆಬುಕದ್ನೆಚ್ಚರ ತಿನಾ ಸೆನಾನಾ ಕ್ಹಾತೆ ಯೆರುಸಲೆಮನೆ ಮುತ್ತಿಗೆ ಘಾಲ್ಯೊ. ಯೆಹುದನೊ ರಾಜೊ಼ ಥಯಲ ಯೆಹೊಯಾಕಿಮನಾ ಅದಿಕಾರನಾ ತನ್ವಾ ವರಕ್ಹಮಾ ಎ ಘಟನಾ ಥೈ. <verse eid="DAN 1:1" /><verse number="2" style="v" sid="DAN 1:2" />ನೆಬುಕದ್ನೆಚ್ಚರ ಯೆಹುದನೊ ರಾಜೊ಼ ಥಯಲ ಯೆಹೊಯಾಕಿಮನೆ ಹರಾಡೆ ಲಿಂಗತ ಯಹೊವಾ ಕರ‍್ಯೊ. ತೆ ಆಲಯನಾ ಸಾಮನೊನೆ ಸಿನಾರ ದೆಶೆ ಲಿನ ಗಯೊ. ತೆ ಸಾಮನೊನೆ ತೆ ತಿನಾ ಮುರ್ತಿಯೊನಿ ಆಲಯಮಾ ಮ್ಹೆಲ್ಯೊ. <verse eid="DAN 1:2" /><verse number="3" style="v" sid="DAN 1:3" />ತೆಳಾಮಾ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಅಶ್ಪನಜನೆ ಆದೆಶ ದಿದ್ಯೊ. ಅಶ್ಪೆನಜ ರಾಜಾ಼ನಿ ಸೆವಾಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಕಂಚುಕಿಯೊನೆ ಮ್ಹೊಟೊ ವ್ಹತ್ತೊ. ರಾಜೊ಼ ದಕ್ಹಾ ಜನಾ ಇಸ್ರಾಯೆಲೊನೆ ತಿನಾ ಮಹೆಲಮಾ ಮ್ಹೆಲು ಕೈನ ಅಶ್ಪೆನಜನೆ ಕದ್ಯೊ. ನೆಬುಕದ್ನೆಚ್ಚರ ಇಸ್ರಾಯೆಲನಾ ರಾಜವಂಶಿವಾಲಿಯೊನೆ ವರಿ ಕ್ಹಾಸ ಘರ್ದಾನವಾಲಾವೊನೆ ತಿನಾ ಮಹೆಲಮಾ ಮ್ಹೆಲು ಕೈನ ಆಸ ಕರ‍್ಯೊ. <verse eid="DAN 1:3" /><verse number="4" style="v" sid="DAN 1:4" />ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಘಟ್ಟಮುಟ್ಟ ರ‍್ಹಯಲವಾಲಾ ಅಂಗೊಮಾ ಸುಜ ಕಮ್ಮ ನೈಸೊವಾಲಾ ಕ್ಹುಬಸುರತ ರ‍್ಹಯಲವಾಲಾ ಶಾಣ್ಯಾ ರ‍್ಹಯಲವಾಲಾ ಅಕ್ಷರೊನು ಗ್ಯಾನ ರ‍್ಹಯಲವಾಲಾ ಜಾಂಜಿಮಾನೊನೆ ತಿನಾ ಸನ್ನಿಧಿನಾ ಸೆವೆನಾ ಹುತಿ ಇನಿಲಿನ ತ್ಯುನೊನೆ ಕಸ್ದಿಯ ಬಾಷಾನಿ ಲಿಕ್ಹಾವಟ ಶಿಕಲೌ ಕೈನ ಆಗನ್ಯಾ ದಿದ್ಯೊ. <verse eid="DAN 1:4" /><verse number="5" style="v" sid="DAN 1:5" />ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ದಿನ್ನೆ ತೆ ಶಾಣ್ಯಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ತೆ ಖಾವಾನು ಅನ್ನ ವರಿ ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ದೆತೊತೊ. ತ್ಯುನೊನೆ ತಿನಾ ಸೆವಕೊ ಕರಿಲಿವಾನಾ ಉದ್ದೆಶಕ್ಹು ತನ್ನ ವರಕ್ಹನಿ ತರಬೆತಿ ದಿವ ಕೈನ ಅಗನ್ಯಾ ದಿದ್ಯೊ. ತನ್ನ ವರಕ್ಹ ಥಯಲ್ಪರ ತ್ಯುನೆ ರಾಜಾ಼ನಾ ಕ್ಹಾಮಾ ಹಾಜರ ಥಾವಾನು ವ್ಹತ್ತು. <verse eid="DAN 1:5" /><verse number="6" style="v" sid="DAN 1:6" />ತೆ ಶಾಣ್ಯಾವೊಮಾ ಯೆಹುದ ಕುಲನಾ ದಾನಿಯಲ, ಹನನ್ಯ, ಮಿಶಾಯೆಲ, ಅಜರ್ಯ ಕವಾಲಾ ಯೆಹುದಿವಾಲಾ ವ್ಹತ್ತಾ. <verse eid="DAN 1:6" /><verse number="7" style="v" sid="DAN 1:7" />ಹಿಜ಼ಡಾವೊಮಾನೊ ಮ್ಹೊಟೊ ತೆ ಯೆಹುದ್ಯನಾ ಶಾಣ್ಯಾವೊನೆ ಬಾಬಿಲೊನನಾ ನಾಮೊ ಮ್ಹೆಲ್ಯೊ. ದಾನಿಯಲನೆ ಬೆಲ್ತೆಶಚ್ಚರ ಕೈನ, ಹನನ್ಯನೆ ಶದ್ರಕ, ಮಿಶಾಯೆಲನೆ ಮೆಶಕ ವರಿ ಅಜರ್ಯನೆ ಅಬೆದ್ನೆಗೊ ಕೈನ ನವಾ ನಾಮೊ ಮ್ಹೆಲ್ಯೊ. <verse eid="DAN 1:7" /><verse number="8" style="v" sid="DAN 1:8" />ತೆನೈಸೊ ದಾನಿಯಲ ರಾಜಾ಼ನೆ ಸಲಹಾ ದಿವಾಲೊ ಅನ್ನನೆ ವರಿ ಪಿವಾನೆ ರ‍್ಹಯಲನೆ ನಿರ್ಧಾರ ಕರ‍್ಯೊ. ತಿಕ್ಹು ಕ್ಹುದ್ದನೆ ಅಶುದ್ದ ಕರಿಲಿವಾನೆ ದಾನಿಯಲನೆ ಪಸಂದ ನ್ಹೊತು ತಿನಾಹುತಿ ಇನಾ ಲಿಂಗತ ಕ್ಹುದ್ದನೆ ಅಶುದ್ದ ಕರಿಲಿದ್ಯಾ ಬಗರ ರ‍್ಹವಾನೆ ಅಶ್ಪೆನಜಕನ ಮಾಂಗಿಲಿದ್ಯೊ. <verse eid="DAN 1:8" /><verse number="9" style="v" sid="DAN 1:9" />ಕ್ಹುದಾ ಕಂಚುಕಿಯನಾ ಮ್ಹೊಟಾನಾ ಮನಸಮಾ ದಾನಿಯಲನಾ ಉಪ್ಪರ ಮರ್ಗಾ ದಯಾ ಹುಟ್ಸಾಯೊ. <verse eid="DAN 1:9" /><verse number="10" style="v" sid="DAN 1:10" />ತೆನೈಸೊ ಅಶ್ಪೆನಜ ದಾನಿಯಲನೆ, ‘ಮಿ ಮಾರಾ ಮಾಲಕ ಥಯಲ ರಾಜಾ಼ನೆ ಭುಚ್ಕುಸ. ಎ ಅನ್ನ ವರಿ ಪಿವಾನು ಕ್ಹಾರು ತುನೆ ದ್ಯು ಕೈನ ರಾಜೊ಼ ಅಪ್ಪಣೆ ದಿದ್ಯೊಸ. ತು ಎ ಅನ್ನ ನೈ ಲಿದ್ಯೊಮ ತಾಕತ ನೈಸೊ ಥೈನಬಿ ಅರಾಮ ನೈಸೊ ಥೈನಬಿ ದಿಕ್ಹಶಿ. ತು ತಾರಾ ವಾರ್ಗಿನಾ ಬಿಜಾ ಶಾಣ್ಯಾವೊತಿಬಿ ಕಮಜೊರ ಥೈನ ದಿಕ್ಹಶಿ. ರಾಜೊ಼ ಎ ದೆಕಿನ ಮಾರಾ ಉಪ್ಪರ ಶಿಟ್ಟ ಥೈನ ಮಾರಿ ಗರ್ದನಜ ಕಾಟಾ ಲಗಾಡಿ ಪಡಸ. ತಿನೆ ತುಜ ಕಾರಣ ಥಾಶಿ” ಕದ್ಯೊ. <verse eid="DAN 1:10" /><verse number="11" style="v" sid="DAN 1:11" />ತೆಳಾಮಾ ದಾನಿಯಲ ತಿನೆ ಕೈದಾಲಾವೊನಾ ಕ್ಹಾತೆ ಬೊಲಿಲಿದ್ಯೊ. ಅಶ್ಪೆನಜ ಕೈದಾಲಾವೊನೆ ದಾನಿಯಲ, ಹನನ್ಯ, ಮಿಶಾಯೆಲ, ಅಜರ್ಯ ಇವ್ನಾ ಉಪ್ಪರ ಡೊಳಾ ಮ್ಹೆಲೊ ಕೈನ ಆಗನ್ಯಾ ದಿದ್ಯೊ. <verse eid="DAN 1:11" /><verse number="12" style="v" sid="DAN 1:12" />ದಾನಿಯಲ ಕೈದಾಲಾವೊನೆ, ‘ದಯಾ ಕರಿನ ದಕ್ಹ ದಿನ್ನ ಲಕ್ಕಾ ಹಮೊನೆ ಪರಿಕ್ಷಾ ಕರೊ. ಖಾವಾನೆ ತರಕಾರಿ, ಪಿವಾನೆ ಪಾನಿ, ಎ ಛೊಡಿನ ಹಮೊನೆ ಸುಜ಼ ದಿವೊ ನಕೊ. <verse eid="DAN 1:12" /><verse number="13" style="v" sid="DAN 1:13" />ಪಾಚ಼ಲ್ತಾ ದಕ್ಹ ದಿನ್ನ ಥಯಲ್ಪರ ಹಮೊನೆ ರಾಜಾ಼ನು ಅನ್ನ ವರಿ ಪಿವಾನು ಲಿವಾಲಾ ಶಾಣ್ಯಾವೊನಾ ಕ್ಹಾತೆ ಹೊಲಿಕಿ ಕರಿನ ದೆಕೊ. ಕುನ್ನ ಜಾಸ್ತ ಘಟ್ಟಮುಟ್ಟ ದಿಕ್ಹಸ ಕವಾನು ತುಮೆಜ಼ ಪರಿಕ್ಷಾ ಕರಿನ ದೆಕೊ. ಪಾಚಲ್ತಾ ಹಮಾರಾ ವಿಶಯಮಾ ತುಮೆಜ಼ ಫೈಸಲೊ ಕರೊ. ಹಮೆ ತುಮಾರಾ ಸೆವಕೊ ಥಯಾಸ” ಕೈನ ಮಾಂಗಿಲಿದ್ಯೊ. <verse eid="DAN 1:13" /><verse number="14" style="v" sid="DAN 1:14" />ಕೈದಾಲೊ ದಾನಿಯಲ, ಹನನ್ಯ, ಮಿಶಾಯೆಲ, ಅಜರ್ಯ ಇವ್ನೊನೆ ದಕ್ಹ ದಿನ್ನ ಲಕ್ಕಾ ಪರಿಕ್ಷಾ ಕರಾನೆ ಒಪ್ಪಿಲಿದ್ಯೊ. <verse eid="DAN 1:14" /><verse number="15" style="v" sid="DAN 1:15" />ದಕ್ಹ ದಿನ್ನ ಥಯಲ್ಪರ ದಾನಿಯಲ ವರಿ ತಿನಾ ದೊಸ್ತೊ ರಾಜಾ಼ನು ಅನ್ನ ಖೈನ ರ‍್ಹಯಲವಾಲಾ ಬಿಜಾ಼ ಕ್ಹಾರಾ ಶಾಣ್ಯಾವೊತಿಬಿ ಘಟ್ಟಮುಟ್ಟ ದಿಕ್ಹ್ಯಾ. <verse eid="DAN 1:15" /><verse number="16" style="v" sid="DAN 1:16" />ತಿನಾಹುತಿ ಕೈದಾಲೊ ರಾಜಾ಼ನು ಕ್ಹಾಸ ಅನ್ನ ವರಿ ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ಲಿನ ತಿನಾ ಬದಲ ತ್ಯುನೊನೆ ತರಕಾರಿ ದಿವಾನು ಶುರು ಕರ‍್ಯೊ. <verse eid="DAN 1:16" /><verse number="17" style="v" sid="DAN 1:17" />ಕ್ಹುದಾ ತೆ ಚಾ಼ರೆ ಜಾಂಜಿಮಾನೊನೆ ಘನ್ನಾ ಶಾಸ್ತ್ರೊ, ವಿಜ್ಞಾನ ಶಿಕಾನು ಗ್ಯಾನ ದಿದ್ಯೊ. ದಾನಿಯಲ ಪುರಾ ಕ್ಹಪನೊ ದಿವ್ಯ ದರ್ಶನೊ ತಿಳ್ದಿಲಿವಾಲೊ ಥಯೊತೊ. <verse eid="DAN 1:17" /><verse number="18" style="v" sid="DAN 1:18" />ಕ್ಹಾರಾ ಶಾಣ್ಯಾ ತನ್ನ ವರಕ್ಹ ತರಬೆತಿ ಲಿವ ಕೈನ ರಾಜೊ಼ ಕದ್ಯೊತೊ. ತೆ ಟೈಮ ಕ್ಹರಲ್ಪರ ಅಶ್ಪೆನಜ ತೆ ಕ್ಹಾರಾ ಶಾಣ್ಯಾವೊನೆ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರನಾ ಕ್ಹಾಮೊ ಬಲಾಯೊ. <verse eid="DAN 1:18" /><verse number="19" style="v" sid="DAN 1:19" />ರಾಜೊ಼ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬೊಲ್ತಾಮಾ ರಾಜಾ಼ನೆ ದಾನಿಯಲ, ಹನನ್ಯ, ಮಿಶಾಯೆಲ, ಅಜರ್ಯ ಇವ್ನಾಯೆಕ್ಲಾ ಯೊಗ್ಯ ಥಯಲವಾಲಾ ತೆ ಕ್ಹಾರಾ ಜಾಂಜಿಮಾನೊಮಾ ಬಿಜಾ಼ ಕುನ್ನಜ಼ ದಿಕ್ಹಿನ ಆಯಾ ನೈ. ತಿನಾಹುತಿ ತೆ ಚಾರೆ ಜ಼ನಾ ಜಾಂಜಿಮಾನೊ ರಾಜಾ಼ನಾ ಸನ್ನಿದಿನಾ ಸೆವಕೊ ಥಯಾ. <verse eid="DAN 1:19" /><verse number="20" style="v" sid="DAN 1:20" />ರಾಜೊ಼ ಕ್ಹಾಸ ರ‍್ಹಯಲ ವಿಶಯೊನಾಹುತಿ ತ್ಯುನೊನೆ ಪುಚ್ಚಲ ಟೈಮಮಾ ತ್ಯುನೆ ಘನ್ನಿ ಹುಶಾರಕಿಕ್ಹು, ಗ್ಯಾನ ದೆಕಾಡ್ಯಾ. ತ್ಯುನೆ ಪುರಾ ದೆಶನಾ ಕ್ಹಾರಾ ಜೊಯಿಸತೊಬಿ ಮಂತ್ರವಾದಿಯೊತಿಬಿ ದಕ್ಹಯಕ್ಲಾ ಶಾಣ್ಯಾ ಛೆ ಕವಾನು ರಾಜೊ಼ ತಿಳ್ದಿಲಿದ್ಯೊ. <verse eid="DAN 1:20" /><verse number="21" style="v" sid="DAN 1:21" />ದಾನಿಯಲ ರಾಜೊ಼ ಥಯಲ ಕೊರೆಶ ಆಳ್ವಿಕೆನಿ ಪಸ್ಟ ವರಕ್ಹಲಕ್ಕಾ ರಾಜಾ಼ನಿ ಸನ್ನಿದಿನೊ ಸೆವಕ ಥೈನ ವ್ಹತ್ತೊ.<verse eid="DAN 1:21" /></para>
  <chapter eid="DAN 1" />
  <chapter number="2" style="c" sid="DAN 2" />
  <para style="s">ನೆಬುಕದ್ನೆಚ್ಚರನು ಕ್ಹಪನ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1" />ನೆಬುಕದ್ನೆಚ್ಚರ ತಿನಿ ಆಳ್ವಿಕೆನಾ ಬೆಂವಾ ವರಕ್ಹಮಾ ಕ್ಹಪನ ದೆಕ್ಯೊ. ತೆ ಕ್ಹಪನ ತಿನೆ ಘಾಬ್ರಾ ಕರಿ ಪಡ್ಯಾ ವರಿ ತಿನೆ ನಿಂದರ ಆಯೆ ನೈಸೊ ಕರ‍್ಯಾ. <verse eid="DAN 2:1" /><verse number="2" style="v" sid="DAN 2:2" />ತೆಳಾಮಾ ರಾಜೊ಼ ತಿನಾ ಕ್ಹಾರಾ ಶ್ಯಾಣ್ಯಾವೊನೆ ಬಲಾಯೊ ತ್ಯುನೆ ಮಾಟಾ ಮಂತ್ರಕ್ಹು, ಜ್ಯೊತಿಶ್ಯ ಶಾಸ್ತ್ರನಾ ಸಹಾಯಕ್ಹು ರಾಜಾ಼ನಾ ಕ್ಹಪನನು ಮತ್ಲಬ ಭವಿಶ್ಯಮಾ ಥಾವಾನು ತಿಳ್ದಿಲಿವಾನೆ ಕೊಶಿಶ ಕರ‍್ಯಾ. ರಾಜೊ಼ ತೆ ದೆಕಲ ಕ್ಹಪನನು ಮತ್ಲಬ ತಿಳ್ದಿಲಿವ ಕೈನ ರ‍್ಹಯಲಕ್ಹು ತ್ಯುನೆ ಮ್ಹೈ ಐನ ರಾಜಾ಼ನಾ ಕ್ಹಾಮಾ ಹುಬ್ರಯಾ. <verse eid="DAN 2:2" /><verse number="3" style="v" sid="DAN 2:3" />ತೆಳಾಮಾ ರಾಜೊ಼ ತ್ಯುನೊನೆ, ‘ಮಿ ಯಕ್ಕ ಕ್ಹಪನ ದೆಕ್ಯೊ. ತೆ ಮನೆ ಕ್ಹಾವಾಡುಸ. ತೆ ಕ್ಹಪನನು ಮತ್ಲಬ ಸು ವ್ಹೈ ಕವಾನು ಮಿ ತಿಳ್ದಿಲಿವ ಕೈನ ಛೆ” ಕದ್ಯೊ. <verse eid="DAN 2:3" /><verse number="4" style="v" sid="DAN 2:4" />ತೆಳಾಮಾ ತ್ಯುನೆ ಅರಮೆಯಿಕ ಬಾಷಾಮಾ, ‘ರಾಜಾ಼ ಅಮರ ಥೈನ ರ‍್ಹೆ. ಹಮೆ ತಾರಾ ಸೆವಕೊ ವ್ಹೈ. ದಯಾಕರಿನ ಹಮೊನೆ ತಾರು ಕ್ಹಪನ ಕೆ. ಹಮೆ ತಿನು ಮತ್ಲಬ ಕಯ್ಯೆಸ” ಕೈನ ಉತ್ತರ ದಿದ್ಯಾ. <verse eid="DAN 2:4" /><verse number="5" style="v" sid="DAN 2:5" />ತೆಳಾಮಾ ರಾಜೊ಼ ತ್ಯುನೊನೆ, ‘ತಿಮ್ಮ ನೈ, ತುಮೆ ಮನೆ ಮಾರು ಕ್ಹಪನ ತಿನು ಮತ್ಲಬ ಕೌ. ನೈ ಕದ್ಯಾಮ ಮಿ ತುಮೊನೆ ತುಂಡ ತುಂಡ ಕರಿನ ಕಾಟಾನೆ ಆಗನ್ಯಾ ದಿವ್ಸ. ತುಮಾರಾ ಘರೊ ಪಾಡಿನ ಮಾತಿ ಕರು ಕೈನ ಆಗನ್ಯಾ ದಿವ್ಸ. <verse eid="DAN 2:5" /><verse number="6" style="v" sid="DAN 2:6" />ತೆನೈಸೊ ತುಮೆ ಮನೆ ಮಾರು ಕ್ಹಪನ ತಿನು ಮತ್ಲಬ ತಿಳ್ಸಾಯಮ ಕಾಣಿಕೆ ಬಹುಮಾನೊ ದಿವ್ಸ ವರಿ ಮ್ಹೊಟ್ಟಿ ಸನ್ಮಾನ ಕರುಸ. ಹಮ್ನಾ ತುಮೆ ಮನೆ ಕ್ಹಪನನು ಮತ್ಲಬ ಕವೊ” ಕದ್ಯೊ. <verse eid="DAN 2:6" /><verse number="7" style="v" sid="DAN 2:7" />ತೆಳಾಮಾ ತೆ ಪಂಡಿತೊ ರಾಜಾ಼ನೆ, ‘ದಯಾಕರಿನ ತು ಕ್ಹಪನನಾ ಹುತಿ ಕೆ. ಹಮೆ ತಿನು ಮತ್ಲಬ ಕಯೆಸ” ಕದ್ಯಾ. <verse eid="DAN 2:7" /><verse number="8" style="v" sid="DAN 2:8" />ತಿನಾಹುತಿ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ, ‘ತುಮೆ ಘನ್ನೊ ಟೈಮ ಚಾಯೆ ಕೈನ ಕೊಶಿಶ ಕರಾಡಾಸ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ಛೆ. ಮಿ ಕದಲ ತುಮೊನೆ ಕರೆಟ್ಟ ಗ್ವತ್ತ ಥಯುಸ. <verse eid="DAN 2:8" /><verse number="9" style="v" sid="DAN 2:9" />ತುಮೆ ಮನೆ ಮಾರಾ ಕ್ಹಪನನಾಹುತಿ ನೈ ಕದ್ಯಾಮ ತುಮೊನೆ ಯಕ್ಕಜ಼ ಶಿಕ್ಷಾ ಥಾವಸ ಕೈನ ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. ತುಮೆ ಕ್ಹಾರಾ ಮನೆ ಸುಳ್ಳ ಕೌ ಕೈನ ಫೈಸಲೊ ಕರಿ ಲಿದ್ಯಾಸ. ತುಮೆ ಟೈಮ ಬದ್ಲಿ ಥಾವಸ ಕೈನ ಆಸ ಕರಾಡಾಸ. ಹಮ್ನಾ ಮಾರು ಕ್ಹಪನ ತಿಳ್ಸಾವೊ. ತುಮೆ ಕ್ಹಪನ ತಿಳ್ಸಾಯಮ ತಿನು ಕ್ಹರಿನು ಮತ್ಲಬ ಕೆಸಕೊಶಿ” ಕೈನ ತ್ಯುನೊನೆ ಉತ್ತರ ದಿದ್ಯೊ. <verse eid="DAN 2:9" /><verse number="10" style="v" sid="DAN 2:10" />ತೆಳಾಮಾ ಪಂಡಿತೊ, ‘ಮಹಾಪ್ರಭು ಪುಚ್ಚಾನು ಕವಾಲಾ ಎ ಜಗತ್ಮಾ ಕುನ್ನಜ ನತ್ತಿ. ಇತ್ತಿ ಪೈಲಾ ಕಯೊಜ಼ ರಾಜೊ಼ ತಿನಿ ಆಸ್ತಾನನಾ ಪಂಡಿತೊನೆ ಮಂತ್ರವಾದಿಯೊನೆ ಹವು ಸವಾಲ ಪುಚ್ಚಾ ನತ್ತಿ. ಕ್ಹಾರತಿ ಮ್ಹೊಟೊ ವರಿ ತಾಕತವರ ರಾಜೊ಼ ತಿನಾ ಪಂಡಿತೊನೆ ರ‍್ಹವಾದೆ ಜೊಯಿಸರೊನೆ ರ‍್ಹವಾದೆ ಹವು ಪುಚ್ಚಾ ನೈ. <verse eid="DAN 2:10" /><verse number="11" style="v" sid="DAN 2:11" />ರಾಜೊ಼ ಪುಚ್ಚಾನು ವಿಶಯ ಘನ್ನು ಕಟಿನ ಛೆ. ದೆವಸ್ಥಾನೊ ಯಕ್ಕಜ ರಾಜಾ಼ನಾ ಕ್ಹಪನನು ಮತ್ಲಬ ಕವಾನೆ ಸಾದ್ಯ ಛೆ. ತೆನೈಸೊ ದೆವಸ್ಥಾನೊ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ರ‍್ಹತಾ ನೈ” ಕದ್ಯಾ. <verse eid="DAN 2:11" /><verse number="12" style="v" sid="DAN 2:12" />ಎ ಐಕಿನ ರಾಜೊ಼ ಘನ್ನೊ ಶಿಟ್ಟ ಥೈನ ಬಾಬಿಲೊನನಾ ಕ್ಹಾರಾ ವಿದ್ವಾಂಸೊನೆ ಕ್ಹಲಾಸ ಕರು ಕೈನ ಆಗನ್ಯಾ ದಿದ್ಯೊ. <verse eid="DAN 2:12" /><verse number="13" style="v" sid="DAN 2:13" />ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರನಿ ಆಗನ್ಯಾ ಪುರಾ ಕರು ಲಾಗ್ಯು. ಕ್ಹಾರಾ ವಿದ್ವಾಂಸೊನೆ ಕ್ಹಲಾಸ ಕರು ಲಾಗ್ಯು. ದಾನಿಯಲ ವರಿ ತಿನಾ ದೊಸ್ತೊನೆ ಹುಡಕಿನ ತ್ಯುನೊನೆ ಕ್ಹಲಾಸ ಕರಾನಾಹುತಿ ರಾಜಾ಼ನಾ ವಳೌ ಲಾಗ್ಯು.<verse eid="DAN 2:13" /></para>
  <para style="s">ಕ್ಹುದಾ ದಾನಿಯಲನೆ ಕ್ಹಪನನು ಮತ್ಲಬ ದೆಕಾಡ್ಯೊ</para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14" />ಅರ್ಯೊಕ ರಾಜಾ಼ನಾ ಅಂಗ ರಕ್ಷಕನೊ ದಳವಾಯಿ ಥಯೊತೊ. ತೆ ಬಾಬಿಲೊನನಾ ವಿದ್ವಾಂಸೊನೆ ಕ್ಹಲಾಸ ಕರಾನೆ ಚಾಲ್ಯೊತೊ. ತೆನೈಸೊ ದಾನಿಯಲ ತಿನಾ ಕ್ಹಾತೆ ಬೊಲ್ಯೊ. ದಾನಿಯಲ ತಿನಾ ಕ್ಹಾತೆ ಘನ್ನಾ ನರಮೆ ಬೊಲ್ಯೊ. <verse eid="DAN 2:14" /><verse number="15" style="v" sid="DAN 2:15" />ದಾನಿಯಲ ಅರ್ಯೊಕನೆ, ‘ರಾಜೊ಼ ತ್ಯವಿ ಕಟಿನ ಶಿಕ್ಷಾ ಕಾ ಆಗನ್ಯಾ ದಿದ್ಯೊ? ಕೈನ ಪುಚ್ಯೊ. ತೆಳಾಮಾ ಅರ್ಯೊಕ ರಾಜಾ಼ನಾ ಕ್ಹಪನನೆ ಸಂಬದ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ವಿಶಯ ತಿಳ್ಸಾಯೊ. <verse eid="DAN 2:15" /><verse number="16" style="v" sid="DAN 2:16" />ತೆಳಾಮಾ ದಾನಿಯಲ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಕನ ಗೈನ ತಿನೆ ದಕ್ಹೊ ಟೈಮ ದಿದ್ಯೊಮ ತೆ ರಾಜಾ಼ನು ಕ್ಹಪನ ತಿನು ಮತ್ಲಬ ಕೌಸ ಕೈನ ಕದ್ಯೊ. <verse eid="DAN 2:16" /><verse number="17" style="v" sid="DAN 2:17" />ತೆಳಾಮಾ ದಾನಿಯಲ ಘರೆ ಗೈನ ತಿನೊ ದೊಸ್ತ ಥಯಲ ಹನನ್ಯ, ಮಿಶಾಯೆಲ ವರಿ ಅಜರ್ಯ ಇವ್ನೊನೆ ಎ ವಿಶಯ ತಿಳ್ಸಾಯೊ. <verse eid="DAN 2:17" /><verse number="18" style="v" sid="DAN 2:18" />ಪರಲೊಕನೊ ಕ್ಹುದಾ ತಿನೆ ಸಹಾಯ ಕರು ಕೈನ ಕೃಪಾ ದೆಕಾಡು ಕೈನ ಪ್ರಾಥನಾ ಕರು ಕೈನ ದಾನಿಯಲ ತ್ಯುನೊನೆ ಮಾಂಗಿಲಿದ್ಯೊ. ದಾನಿಯಲ ವರಿ ತಿನಾ ದೊಸ್ತೊ ಮರಣ ದಂಡಣೆಕ್ಹು ಪಾರ ಥೌ ಕದ್ಯಾಮ ಕ್ಹಪನನು ಮತ್ಲಬ ಕವಾನುಜ ವ್ಹತ್ತು. <verse eid="DAN 2:18" /><verse number="19" style="v" sid="DAN 2:19" />ತೆ ದಿನ್ನೆ ರಾತೆ ದಾನಿಯಲನೆ ಕ್ಹುದಾನಿ ದರ್ಶನ ಥಯು. ತೆಳಾಮಾ ದಾನಿಯಲ ಪರಲೊಕನಾ ಕ್ಹುದಾನೆ ಇಮ್ಮ ಸ್ತುತಿ ಕರ‍್ಯೊ. <verse eid="DAN 2:19" /><verse number="20" style="v" sid="DAN 2:20" />‘ಕ್ಹುದಾನು ನಾಮ ಹಮೆಶಾಬಿ ವರಿ ಯುಗ ಯುಗಂತರ ಸ್ತುತಿ ಕರೊ. ಗ್ಯಾನ ತಾಕತ ತಿನಾಜ ವ್ಹೈ. <verse eid="DAN 2:20" /><verse number="21" style="v" sid="DAN 2:21" />ತೆ ಕಾಲ ಸಮಯನೆ ಬದ್ಲಿ ಕರಸ. ತೆ ರಾಜಾ಼ವೊನೆ ಬದ್ಲಿ ಕರಸ. ತೆ ರಾಜಾ಼ವೊನೆ ಅದಿಕಾರ ದಿವಸ. ತೆ ತ್ಯುನಿ ಅದಿಕಾರ ಕಾಳಿಲಿವಾಲೊ ವ್ಹೈ. ಮನಕ್ಹೊನೆ ಗ್ಯಾನ ದಿನ ಗ್ಯಾನಿಯೊ ಕರಾಲೊ ತೆಜ ವ್ಹೈ. ಮನಕ್ಹೊನೆ ವಿವೆಕ ದಿನ ವಿವೆಕಿಯೊ ಕರಾಲೊ ತೆಜ ವ್ಹೈ. <verse eid="DAN 2:21" /><verse number="22" style="v" sid="DAN 2:22" />ಮ್ಹೈ ದಡಿ ರ‍್ಹಯಲ ರಾಜ಼ ತಿಳ್ದಿಲಿವಾಲೊ ತೆಜ಼ ವ್ಹೈ. ಉಜಾಲು ತಿನಾ ಕ್ಹಾತೆ ಛೆ. ತಿನಾಹುತಿ ಅಂದಾರಾಮಾ ರ‍್ಹಯಲ ತಿನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="DAN 2:22" /><verse number="23" style="v" sid="DAN 2:23" />ಮಾರಾ ಪುರ್ವಿಕರೊನಾ ಕ್ಹುದಾ, ತುನೆ ಸ್ತುತಿ ಕರುಸ. ತು ಮನೆ ಗ್ಯಾನ ತಾಕತ ದಿದ್ಯೊಸ. ಮಿ ಐಕಲ ದಿದ್ಯೊಸ. ರಾಜಾ಼ನಾ ಕ್ಹಪನನೆ ತಿಳ್ಸಾಯೊಸ”.<verse eid="DAN 2:23" /></para>
  <para style="s">ದಾನಿಯಲ ರಾಜಾ಼ನು ಕ್ಹಪನ ವರಿ ತಿನು ಮತ್ಲಬ ಕದ್ಯಲ</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24" />ಪಾಚಾಲ್ತೊ ದಾನಿಯಲ ಅರ್ಯೊಕ ಕನ ಗಯೊ. ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಬಾಬಿಲೊನನಾ ಶಾಣ್ಯಾವೊನೆ ಕ್ಹಲಾಸ ಕರಾನೆ ಅರ್ಯೊಕನೆ ಇನಿಲಿದ್ಯೊ. ದಾನಿಯಲ ಅರ್ಯೊಕನೆ, ‘ಬಾಬಿಲೊನನಾ ಶಾಣ್ಯಾವೊನೆ ಕ್ಹಲಾಸ ಕರು ನಕೊ. ಮನೆ ರಾಜಾ಼ ಕನ ಬಲೈ ಲಿನ ಜಾ. ಮಿ ತಿನೆ ತಿನಾ ಕ್ಹಪನ ವರಿ ತಿನು ಮತ್ಲಬ ಕೌಸ” ಕದ್ಯೊ. <verse eid="DAN 2:24" /><verse number="25" style="v" sid="DAN 2:25" />ತೆಳಾಮಾಜ಼ ಅರ್ಯೊಕ ದಾನಿಯಲನೆ ರಾಜಾ಼ ಕನ ಬಲೈ ಲಿನ ಗಯೊ. ಅರ್ಯೊಕ ರಾಜಾ಼ನೆ, ‘ಯೆಹುದತೊ ಕೈದಿ ಕರಿಲಿನ ಲಾಯಲವಾಲಾವೊಮಾ ರಾಜಾ಼ನು ಕ್ಹಪನ ವರಿ ತಿನು ಮತ್ಲಬ ಕವಾಲಾ ಯಕ್ಲಾನೆ ಮಿ ಕಂಡ ಧರ‍್ಯೊಸ. ತೆ ರಾಜಾ಼ನು ಕ್ಹಪನ ವರಿ ತಿನು ಮತ್ಲಬ ಕವಸ” ಕದ್ಯೊ. <verse eid="DAN 2:25" /><verse number="26" style="v" sid="DAN 2:26" />ರಾಜೊ಼ ದಾನಿಯಲನೆ ಬೆಲ್ತೆಶಚ್ಚರನೆ ‘ತು ಮಾರಾ ಕ್ಹಪನನೆ ತಿನು ಮತ್ಲಬನೆ ಕೆ ಸಕಶಿ ಸು?” ಕೈನ ಪುಚ್ಯೊ. <verse eid="DAN 2:26" /><verse number="27" style="v" sid="DAN 2:27" />ತೆಳಾಮಾ ದಾನಿಯಲ, ‘ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ, ಕಯೊ ವಿದ್ವಾಂಸ ರ‍್ಹವಾದೆ ಮಾಟಾ ಕರಾಲೊ ರ‍್ಹವಾದೆ ಜೊಯಿಸೊ ರ‍್ಹವಾದೆ ಶಕುನ ಕವಾಲಾ ರ‍್ಹವಾದೆ ರಾಜೊ಼ ಥಯಲ ತುನೆ ರಹಸ್ಯ ರ‍್ಹಯಲ ಕವಾನೆ ಥಯು ನೈ. <verse eid="DAN 2:27" /><verse number="28" style="v" sid="DAN 2:28" />ತೆನೈಸೊ ಪರಲೊಕಮಾ ಯಹೊವಾ ಕವಾಲೊ ಛೆ. ತೆ ರಹಸ್ಯ ರ‍್ಹಯಲ ಕವಸ. ಭವಿಶ್ಯಮಾ ಥಾವಾನು ರಾಜೊ಼ ಥಯಲ ತುನೆ ಯಹೊವಾ ತಿಳ್ಸಾಯೊಸ. ಎಜ ತು ದೆಕಲ ಕ್ಹಪನ ವ್ಹೈ, ತು ವಚ್ಚಾನಾನಾ ಉಪ್ಪರ ಕ್ಹುರಯಲ ಟೈಮಮಾ ದೆಕಲ ಸಂಗತಿಯೊ ಎ ವ್ಹೈ: <verse eid="DAN 2:28" /><verse number="29" style="v" sid="DAN 2:29" />ರಾಜಾ಼, ತು ತಾರಾ ವಚ್ಚಾನಾಮಾ ಕ್ಹುರಯೊತೊ. ಭವಿಶ್ಯಮಾ ಥಾವಾನಾ ಹುತಿ ವಿಚಾರ ಕರಾಡೊತೊ. ಕ್ಹುದಾ ಮನಕ್ಹೊನೆ ರಹಸ್ಯ ತಿಳ್ಸಾವಸ. ಭವಿಶ್ಯಮಾ ಥಾವಾನು ತೆಜ ತುನೆ ದೆಕಾಡ್ಯೊಸ. <verse eid="DAN 2:29" /><verse number="30" style="v" sid="DAN 2:30" />ಕ್ಹುದಾ ರಹಸ್ಯ ಮನೆಬಿ ತಿಳ್ಸಾಯೊಸ! ಕ್ಹುದಾ ಮನೆ ತಿಳ್ಸಾಯಲ ಮಿ ಬಿಜಾವೊತಿ ಜಾಸ್ತ ಗ್ಯಾನ ರ‍್ಹಯಲವಾಲೊ ವ್ಹೈ ಕೈನ ನ್ಹವೈ. ತೆನೈಸೊ ರಾಜೊ಼ ಥಯಲ ತುನೆ ಇನು ಮತ್ಲಬ ತಿಳ್ದಾದೆ ಕವಾನಾ ಉದ್ದೆಶಕ್ಹು ಕ್ಹುದಾ ಮನೆ ತಿಳ್ಸಾಯೊಸ. ಇನಾಹುತಿ ತಾರಾ ಮನಸನಿ ವಿಚಾರೊನಾ ವಿಶಯ ತುನೆ ಕಳಿನ ಆವಸ. <verse eid="DAN 2:30" /><verse number="31" style="v" sid="DAN 2:31" />‘ರಾಜಾ಼, ತಾರಾ ಕ್ಹಪನಮಾ ತಾರಾ ಕ್ಹಾಮು ಯಕ್ಕ ಮ್ಹೊಟಿ ಮುರ್ತಿ ದೆಕ್ಯೊ. ತೆ ಘನ್ನ ಮ್ಹೊಟುಬಿ ಚಮ್ಕಾನುಬಿ ಪ್ರಭಾವಕ್ಹುಬಿ ವತ್ತು. ದೆಕ್ಯಲವಾಲಾ ಘಾಬ್ರಾ ಥೈನ ಡೊಳಾ ಫರಾಯಲ ಲಿಂಗತ ವ್ಹತ್ತು. <verse eid="DAN 2:31" /><verse number="32" style="v" sid="DAN 2:32" />ತೆ ಮುರ್ತಿನು ಮಾತು ಚೊಕ್ಕ ಕ್ಹೊನಾಕ್ಹು ಕರಲ ವ್ಹತ್ತು. ತಿನಿ ಛಾತಿ ವರಿ ರಟ್ಟಾ ರುಪ್ಪಾಕ್ಹು ಕರಲ ವ್ಹತ್ತು. ತೆ ಮುರ್ತಿನು ಪೆಟ, ಕಂಬರ ವರಿ ಮಾಂಡಿಯೊ ತಾಂಬಾಕ್ಹು ಕರಲ ವ್ಹತ್ತು . <verse eid="DAN 2:32" /><verse number="33" style="v" sid="DAN 2:33" />ಪಗೊ ಲ್ಹೊಡಾಕ್ಹು ಕರಲ ವ್ಹತ್ತಾ. ತೆ ಮುರ್ತಿನಾ ತಳವಾ ಲ್ಹೊಡು ವರಿ ಯರಿ ಮಾತಿಕ್ಹು ಕರಲ ವ್ಹತ್ತು. <verse eid="DAN 2:33" /><verse number="34" style="v" sid="DAN 2:34" />ತು ತೆ ಮುರ್ತಿನೆ ದೆಕ್ತಾಮಾ ತುನೆ ಯಕ್ಕ ಮ್ಹೊಟೊ ದಗ್ಡೊ ದಿಕ್ಹ್ಯೊ. ತೆ ಮ್ಹೊಟೊ ದಗ್ಡೊ ತಿನಾಕ್ಹು ತೆ ಡ್ಹಿಲ್ಲು ಥಯು; ಕುನ್ನಜ ತಿನೆ ಫೊಡ್ಯೊ ನೈ. ಪಾಚಲ್ತು ತೆ ಮ್ಹೊಟೊ ದಗ್ಡೊ ತೆ ಮುರ್ತಿನಾ ಲ್ಹೊಡಾನು ವರಿ ಮಾತಿನಾ ಪಗೊನೆ ಲಾಗ್ಯು. ತೆ ಮ್ಹೊಟೊ ದಗ್ಡೊ ಮುರ್ತಿನಾ ಪಗೊನೆ ಫೊಡಿನ ಫುಡಿ ಫುಡಿ ಕರ‍್ಯು. <verse eid="DAN 2:34" /><verse number="35" style="v" sid="DAN 2:35" />ಪಾಚಲ್ತು ಲ್ಹೊಡು, ಮಾತಿ, ಪಿತ್ತೊಳ, ರುಪ್ಪು, ಕ್ಹೊನು, ಕ್ಹಾರು ಯಕ್ಕಜ ಟೈಮಮಾ ಫುಟಿನ ಚುರ ಚುರ ಥಯು. ತೆ ತುಕ್ಡಾ ಕ್ಹಾರಾ ಝಳಾನಾ ದಿನ್ನಮಾ ಕೊಂಡಾ ಲಿಂಗತ ಥಯಾ. ವಾರೊ ತೆ ತುಕ್ಡಾವೊನೆ ಉರಾಡಿ ಲಿನ ಗಯು. ತ್ಯಾ ಸುಜ ಉಗ್ರ್ಯು ನೈ. ಪೈಲಾ ತ್ಯಾ ಯಕ್ಕ ಮುರ್ತಿ ವ್ಹತ್ತಿ ಕೈನ ಕುನ್ನಜ ಕವಾ ವರಕ್ಹು ನ್ಹೊತು. ಪಾಚಲ್ತು ತೆ ಮುರ್ತಿನೆ ಲಾಗ್ಯಲ ಮ್ಹೊಟೊ ದಗ್ಡೊ ಯಕ್ಕ ಮ್ಹೊಟು ಡೊಂಗರ ಥೈನ ಪುರಾ ಭುಮಂಡಲ ಫೈಲಿ ಗಯು. <verse eid="DAN 2:35" /><verse number="36" style="v" sid="DAN 2:36" />ಕ್ಹಪನ ಎಜ಼ ವ್ಹೈ; ಇನು ಅರ್ಥ ರಾಜಾ಼ನಾ ಸನ್ನಿದಿಮಾ ಕೌಸ. <verse eid="DAN 2:36" /><verse number="37" style="v" sid="DAN 2:37" />ರಾಜಾ಼, ತು ರಾಜಾ಼ವೊನಾ ರಾಜೊ಼ ವ್ಹೈ, ಪರಲೊಕವನೊ ಕ್ಹುದಾ ತುನೆ ರಾಜ್ಯನಿ ತಾಕತ ಪರಾಕ್ರಮ ವೈಭವ ದಿದ್ಯೊಸ; <verse eid="DAN 2:37" /><verse number="38" style="v" sid="DAN 2:38" />ಮನಕ್ಹೊ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ಗಾಮೊಮಾ ಹಬಾಳನಾ ಪಕ್ಷಿಯೊನೆ ಜಿಮಿನಾ ಜಿವಜಂತುವೊನೆ ತುನೆ ಒಪ್ಸಿನ ತು ತೆ ಕ್ಹಾರಾವೊನೆ ಆಳೆಲಿಂಗತ ಕರ‍್ಯೊಸ. ತುಜ಼ ತೆ ಕ್ಹೊನಾನು ಮಾತು ವ್ಹೈ. <verse eid="DAN 2:38" /><verse number="39" style="v" sid="DAN 2:39" />ತಾರಾ ದಿನೊ ಥಯಲ್ಪರ ಧೊಳು ರ‍್ಹಯಲ ಬಿಜೆಕ ರಾಜ್ಯ ಹುಟ್ಟಸ. ತೆ ಥಯಲ್ಪರ ಬಿಜೆಕ ರಾಜ್ಯ ತಾಂಬಾನು ರ‍್ಹವಸ ತಲೆದುರಿ ಭುಮಂಡಲ್ಪರ ರಾಜ಼ ಕರಸ. <verse eid="DAN 2:39" /><verse number="40" style="v" sid="DAN 2:40" />ಚಾರವಾ ರಾಜ್ಯ ಲ್ಹೊಡಾ ಲಿಂಗತ ಘಟ್ಟ; ಲ್ಹೊಡು ಕ್ಹಾರಾ ಸಾಮನೊನೆ ಪುಡಿ ಪುಡಿ ಕರಿನ ತೊಡಿಪಡಸ; ಕ್ಹಾರು ನಾಶ ಕರಾನು ಲ್ಹೊಡಾ ಲಿಂಗತ ತೆ ಪುಡಿ ಪುಡಿ ಕರಸ. <verse eid="DAN 2:40" /><verse number="41" style="v" sid="DAN 2:41" />ಪಗೊನೆ ವರಿ ಬೊಟೊಮಾ ಯಕ್ಕ ಭಾಗ ಕುಂಬಾರನಾ ಮಾತಿಮಾ ಯಕ್ಕ ಭಾಗ ಲ್ಹೊಡು ಥಯಲನೆ ತು ದೆಕಲ ಪ್ರಕಾರ ತೆ ರಾಜ್ಯ ಬಿಜು಼-ಬಿಜು಼ ರ‍್ಹವಸ; ಜೆಡಿಮಾತಿನಾ ಕ್ಹಾತೆ ಲ್ಹೊಡು ಮಳೆಲಿಂಗತ ತು ದೆಕಲ ಲಿಂಗತ ತೆ ರಾಜ್ಯಮಾ ಲ್ಹೊಡಾನಿ ತಾಕತ ರ‍್ಹವಸ. <verse eid="DAN 2:41" /><verse number="42" style="v" sid="DAN 2:42" />ಪಗ್ಗನಾ ಬೊಟೊನು ಯಕ್ಕ ಭಾಗ ಲ್ಹೊಡಾನು ಯಕ್ಕ ಭಾಗ ಮಾತಿ ರ‍್ಹಯಲ ತಿಮ್ಮ ತೆ ರಾಜ್ಯನು ಯಕ್ಕ ಭಾಗ ಘಟ್ಟ ಯಕ್ಕ ಭಾಗ ಬಲಹಿನ ರ‍್ಹವಸ. <verse eid="DAN 2:42" /><verse number="43" style="v" sid="DAN 2:43" />ಲ್ಹೊಡು ಜೆಡಿಮಾತಿನಾ ಕ್ಹಾತೆ ಮಳಲ ರ‍್ಹಯಲ ತು ದೆಕಲ ಲಿಂಗತ ತೆ ರಾಜ್ಯನಾ ಅಂಶ ಸಂತತಿ ಸಂಬಂಧಕ್ಹು ಮಳಸ; ತಿನಾಹುತಿ ಲ್ಹೊಡು ಮಾತಿನಾ ಕ್ಹಾತೆ ಕಿಮ್ಮ ಕಲಾತು ನೈ ತಿಮ್ಮ ತೆ ಯಕ್ಕನೆ ಯಕ್ಕ ವ್ಹಂದತು ನೈ. <verse eid="DAN 2:43" /><verse number="44" style="v" sid="DAN 2:44" />ತೆ ರಾಜಾ಼ವೊನಾ ಟೈಮಮಾ ಪರಲೊಕನೊ ಕ್ಹುದಾ ಯಕ್ಕ ರಾಜ್ಯ ಸ್ಥಾಪನಾ ಕರಸ; ತೆ ಕೆಳಾಮಾಜ಼ ನಾಶ ನೈ ಥಾತು, ತಿನಿ ತಾಕತ ಬಿಜಾ಼ ಜನಾಂಗನೆ ನೈ ಜಾ಼ತಿ, ತೆ ಕ್ಹಾರಾ ರಾಜ್ಯನೆ ನಾಶ ಕರಿನ ಹಮೆಶಾನು ರಾಜ್ಯ ಥೈನ ಹುಬ್ರವಸ. <verse eid="DAN 2:44" /><verse number="45" style="v" sid="DAN 2:45" />ಡೊಂಗರಮಾತು ಯಕ್ಕ ಗೊಲ ದಗಡೊ ಹತ್ತನೈಸೊ ಫುಟಿನ ಲ್ಹೊಡು ತಾಂಬು ಮಾತಿ ರುಪ್ಪು ಕ್ಹೊನಾವೊನೆ ಪುಡಿ ಪುಡಿ ಕರಲ ತಾರಾ ಡೊಳೆ ಬಿತ್ತತು ನೈ; ಇನಾಕ್ಹು ಪರಲೊಕನೊ ಕ್ಹುದಾ ಅಗಾ ಥಾವಾನಾ ವಿಶಯ ರಾಜಾ಼ನೆ ತಿಳ್ಸಾಯೊಸ; ಕ್ಹಪನ ಕ್ಹರಿಜ಼ ವ್ಹೈ, ತಿನು ಅರ್ಥಬಿ ಬರೊಕ್ಹೊ ಕರಾವರ್ಕ್ಹು ಛೆ ಕೈನ ಕದ್ಯೊ.<verse eid="DAN 2:45" /></para>
  <para style="s">ರಾಜೊ಼ ದಾನಿಯಲನೆ ಬಹುಮಾನ ದಿದಲ</para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46" />ತೆಳಾಮಾ ರಾಜ಼ೊ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ದಾನಿಯಲನೆ ಅಡ್ಡ ಪಡಿನ ನೆ ಬಲಿನೆ ಕರಿನ ಉದ ಘಾಲು ಕೈನ ಆಗನ್ಯಾ ದಿದ್ಯೊ. <verse eid="DAN 2:46" /><verse number="47" style="v" sid="DAN 2:47" />ತಿನಾಹುತಿ ತು ಎ ರಾಜ಼ನೆ ಭಾರೊ ಲಾವಾನೆ ಸಮರ್ಥ ಥಯಲಕ್ಹು ತುಮಾರೊ ಕ್ಹುದಾ ದೆವಾದಿದೆವ ರಾಜಾ಼ವೊನೊ ಮಾಲಕ ದಡಿರ‍್ಹಯಲನೆ ಭಾರೊ ಕಾಡಾಲೊ ಥಯೊಸ ಕವಾನು ಕ್ಹರಿಜ಼ ವ್ಹೈ ಕೈನ ಕದ್ಯೊ. <verse eid="DAN 2:47" /><verse number="48" style="v" sid="DAN 2:48" />ಪಾಚ಼ಲ್ತೊ ರಾಜೊ಼ ದಾನಿಯಲನೆ ಅದಿಕಾರ ದಿನ ತಿನೆ ಅಮುಲ್ಯ ಮೊಗಾ ರ‍್ಹಯಲ ಬಹುಮಾನೊ ದಿನ ಬಾಬಿಲನಾ ಕ್ಹಾರಾ ಸಂಸ್ಥಾನೊನೆ ದಿನ ಬಾಬೆಲನಾ ವಿದ್ವಾಂಸೊನಾ ಕ್ಹಾರಾ ಶಾನಾವೊಪರ ತಿನೆ ಶಾನೊ ಥೈನ ಕರ‍್ಯೊ. <verse eid="DAN 2:48" /><verse number="49" style="v" sid="DAN 2:49" />ದಾನಿಯಲ ಮಾಂಗಿಲಿವಾಕ್ಹು ರಾಜೊ಼ ಶದ್ರಕ ಮೆಶಕ ಅಬೆದ್ನಗೊ ಕಾವಾಲಾವೊನೆ ಬಾಬೆಲ ಸಂಸ್ಥಾನನಾ ಕಾಮೊ ತ್ಯುನೊನೆ ದಿದ್ಯೊ; ದಾನಿಯಲ ರಾಜ಼ಮಹಲಮಾ ಹುಬ್ರಯೊ.<verse eid="DAN 2:49" /></para>
  <chapter eid="DAN 2" />
  <chapter number="3" style="c" sid="DAN 3" />
  <para style="s">ನೆಬುಕದ್ನೆಚರ ಹರಯಕ್ಲಾನೆ ಕ್ಹೊನಾನಿ ಮೂರ್ತಿನೆ ಆರಾಧನಾ ಕರಾನೆ ಆಗನ್ಯಾ ದಿದಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1" />ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ತೆರಾ ಮಾರ ಉಚ್ಚು, ತನ್ನ ಮಾರ ರುಂದ ರ‍್ಹಯಲ ಯಕ್ಕ ಕ್ಹೊನಾನಿ ಮುರ್ತಿ ಕರೈನ ಬಾಬೆಲ ರಾಜ್ವಾ಼ಡ ದುರಾ ಕವಾನಾ ಅಂಗಳಾಮಾ ಹುಬ್ರಾಡ್ಯೊತೊ. <verse eid="DAN 3:1" /><verse number="2" style="v" sid="DAN 3:2" />ತೆಳಾಮಾ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ತೆ ಹುಬ್ರಾಡಲ ಮುರ್ತಿನಾ ಉದ್ಘಾಟನೆನೆ ನ್ಹಾನಾ ರಾಜಾ಼ವೊನೆ, ನಾಯಕೊನೆ, ದೆಶಾದಿಪತಿಯೊನೆ, ಮಂತ್ರಿಯೊನೆ, ಕೊಶಾಧ್ಯಕ್ಷವೊನೆ, ನ್ಯಾಯಾಧಿಪತಿಯೊನೆ ವರಿ ಉಗ್ರಲ ಕ್ಹಾರಾ ಅದಿಕಾರಿಯೊನೆ ಬಲಾಯೊ. <verse eid="DAN 3:2" /><verse number="3" style="v" sid="DAN 3:3" />ತೆ ನ್ಹಾನಾ ರಾಜಾ಼, ನಾಯಕೊ, ದೆಶಾದಿಪತಿಯೊ, ಮಂತ್ರಿಯೊ, ಕೊಶಾಧ್ಯಕ್ಷ ಕ್ಹಾರಾ ಜ಼ನಾ ಐನ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಹುಬ್ರಾಡಲ ಮುರ್ತಿನಾ ಕ್ಹಾಮಾ ಹುಬ್ರಯಾ. <verse eid="DAN 3:3" /><verse number="4" style="v" sid="DAN 3:4" />ತೆಳಾಮಾ ಕವಾಲೊ ಜೊ಼ರ ವದ್ರಿನ, ‘ಬಿಜಾ಼-ಬಿಜಾ಼ ಜನಾಂಗವಾಲಾ, ಕುಲವಾಲಾ, ಭಾಷಾವಾಲಾವೊ ತುಮೊನೆ ರಾಜಾ಼ನಿ ಆಗನ್ಯಾ ಥೈಸ. <verse eid="DAN 3:4" /><verse number="5" style="v" sid="DAN 3:5" />ತುಮೆ ತುತ್ತುರಿ, ಕಿನ್ನರಿ, ತಂಬುರಿ, ಕೊಳಲ, ವಿಣಾ, ವಾಲಗಾ ಬಿಜಾ಼ ಕ್ಹಾರಾವೊನು ಅವಾಜ಼ ಐಕಲ ಬರೊಬ್ಬರ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚರ ಹುಬ್ರಾಡಲ ಮೂರ್ತಿನಾ ಕ್ಹಾಮಾ ಮಾತು ಡೊಗೈನ ಆರಾದನಾ ಕರು. <verse eid="DAN 3:5" /><verse number="6" style="v" sid="DAN 3:6" />ಕುನ್ನ ಮಾತು ಡೊಗ್ಗೈನ ಆರಾದನಾ ನೈ ಕರ್ತಾತೊ ತ್ಯುನೊನೆ ತೆಲಾಮಾಜ಼ ಧಗಧಗ ಬಳನಿ ಆಗಮಾ ನಾಕಿ ಪಡಸ. <verse eid="DAN 3:6" /><verse number="7" style="v" sid="DAN 3:7" />ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಕ್ಹಾಟ ಮಾರ ಉಚ್ಚು ಛೆ ಮಾರ ರುಂದ ರ‍್ಹಯಲ ಯಕ್ಕ ಕ್ಹೊನಾನಿ ಮುರ್ತಿ ಕರೈನ ಬಾಬೆಲ ಸಂಸ್ಥಾನನು ದುರಾ ಕವಾನಾ ಅಂಗಳಾಮಾ ಹುಬ್ರಾಡ್ಯೊತೊ.<verse eid="DAN 3:7" /></para>
  <para style="s">ದಾನಿಯಲ ತನ್ನ ಸಾತಿದಾರೊ ಅ ವಿದೆಯತೆನು ಆರೊಪನೆ ಹೊಂದಲ</para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 3:8" />ತ್ಯುನೆ ಕ್ಹಾರಾ ಜ಼ನಾ ಐನ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಹುಬ್ರಾಡಲ ಮುರ್ತಿನಾ ಕ್ಹಾಮಾ ಹುಬ್ರಯಾ. <verse eid="DAN 3:8" /><verse number="9" style="v" sid="DAN 3:9" />ತಿನಿ ಆಳ್ವಿಕೆನಾ ಬೆಂವಾ ವರಕ್ಹಮಾ ನೆಬುಕದ್ನೆಚ್ಚರ ದಕ್ಹಾ ಕ್ಹಪನೊ ದೆಕ್ಯೊ. ತೆ ಕ್ಹಪನೊ ತಿನೆ ಘಾಬ್ರಾ ಕರಿ ಪಡ್ಯಾ ವರಿ ತಿನೆ ನಿಂದರ ಆಯೆ ನೈಸೊ ಕರ‍್ಯಾ. <verse eid="DAN 3:9" /><verse number="10" style="v" sid="DAN 3:10" />ನೆಬುಕದ್ನೆಚರ ಬಾಬೆಲೊನನೊ ರಾಜೊ಼ ಥಯೊತೊ. ನೆಬುಕದ್ನೆಚರ ಯೆರುಸಲೆಮನೆ ಆಯೊ. ನೆಬುಕದ್ನೆಚರ ತಿನಾ ಸೆನಾನಾ ಕ್ಹಾತೆ ಯೆರುಸಲೆಮನೆ ಮುತ್ತಿಗೆ ಘಾಲ್ಯೊ. ಯೆಹುದನೊ ರಾಜೊ಼ ಥಯಲ ಯೆಹೊಯಾಕಿಮನಾ ಅದಿಕಾರನಾ ತನ್ವಾ ವರಕ್ಹಮಾ ಎ ಘಟನಾ ಥೈ. <verse eid="DAN 3:10" /><verse number="11" style="v" sid="DAN 3:11" />ತ್ಯುನೆ ಕ್ಹಾರಾ ಜ಼ನಾ ಐನ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಹುಬ್ರಾಡಲ ಮುರ್ತಿನಾ ಕ್ಹಾಮಾ ಹುಬ್ರಯಾ ಮಾತು ಡ್ವಗ್ಗೈನ ಆರಾಧಾನಾ ಕರು. <verse eid="DAN 3:11" /><verse number="12" style="v" sid="DAN 3:12" />ತಿನಿ ಆಳ್ವಿಕೆನಾ ಬೆಂವಾ ವರಕ್ಹಮಾ ನೆಬುಕದ್ನೆಚ್ಚರ ದಕ್ಹಾ ಕ್ಹಪನೊ ದೆಕ್ಯೊ. ತೆ ಕ್ಹಪನೊ ತಿನೆ ಘಾಬ್ರಾ ಕರಿ ಪಡ್ಯಾ ವರಿ ತಿನೆ ನಿಂದರ ಆಯೆ ನೈಸೊ ಕರ‍್ಯಾ. <verse eid="DAN 3:12" /><verse number="13" style="v" sid="DAN 3:13" />ನೆಬುಕದ್ನೆಚರ ಬಾಬೆಲೊನನೊ ರಾಜೊ಼ ಥಯೊತೊ. ನೆಬುಕದ್ನೆಚರ ಯೆರುಸಲೆಮನೆ ಆಯೊ. ನೆಬುಕದ್ನೆಚರ ತಿನಾ ಸೆನಾನಾ ಕ್ಹಾತೆ ಯೆರುಸಲೆಮನೆ ಮುತ್ತಿಗೆ ಘಾಲ್ಯೊ. ಯೆಹುದನೊ ರಾಜೊ಼ ಯೆಹೊಯಾಕಿಮನಾ ಅದಿಕಾರನಾ ತನ್ವಾ ವರಕ್ಹಮಾ ಎ ಘಟನಾ ಥೈ. <verse eid="DAN 3:13" /><verse number="14" style="v" sid="DAN 3:14" />ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಕ್ಹಾಟ ಮಾರ ಉಚ್ಚು ಛೆ ಮಾರ ರುಂದ ರ‍್ಹಯಲ ಯಕ್ಕ ಕ್ಹೊನಾನಿ ಮುರ್ತಿ ಕರೈನ ಬಾಬೆಲ ಸಂಸ್ಥಾನನು ದುರಾ ಕವಾನಾ ಅಂಗಳಾಮಾ ಹುಬ್ರಾಡ್ಯೊತೊ. <verse eid="DAN 3:14" /><verse number="15" style="v" sid="DAN 3:15" />ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಕ್ಹಾಟ ಮಾರ ಉಚ್ಚು ಛೆ ಮಾರ ರುಂದ ರ‍್ಹಯಲ ಯಕ್ಕ ಕ್ಹೊನಾನಿ ಮುರ್ತಿ ಕರೈನ ಬಾಬೆಲ ಸಂಸ್ಥಾನನು ದುರಾ ಕವಾನಾ ಅಂಗಳಾಮಾ ಹುಬ್ರಾಡ್ಯೊತೊ. <verse eid="DAN 3:15" /><verse number="16" style="v" sid="DAN 3:16" />ತ್ಯುನೆ ಕ್ಹಾರಾ ಜ಼ನಾ ಆರಾಧನಾ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಹುಬ್ರಾಡಲ ಮುರ್ತಿನಾ ಕ್ಹಾಮಾ ಹುಬ್ರಯಾ. <verse eid="DAN 3:16" /><verse number="17" style="v" sid="DAN 3:17" />ತೆಳಾಮಾ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ತೆ ಹುಬ್ರಾಡಲ ಮುರ್ತಿನಾ ಉದ್ಘಾಟನೆನೆ ನ್ಹಾನಾ ರಾಜಾ಼ವೊನೆ, ನಾಯಕೊನೆ, ದೆಶಾದಿಪತಿಯೊನೆ, ಮಂತ್ರಿಯೊನೆ, ಕೊಶಾಧ್ಯಕ್ಷವೊನೆ, ನ್ಯಾಯಾಧಿಪತಿಯೊನೆ ವರಿ ಉಗ್ರಲ ಕ್ಹಾರಾ ಅದಿಕಾರಿಯೊನೆ ಬಲಾಯೊ. <verse eid="DAN 3:17" /><verse number="18" style="v" sid="DAN 3:18" />ತೆಳಾಮಾ ಕಿಮ್ಮ ರಾಜೊ಼ ಥಯಲ ನೆಬುರಾಧನಾ ಕದ್ನೆಚ್ಚರ ತೆ ಹುಬ್ರಾಡಲ ಮುರ್ತಿನಾ ಉದ್ಘಾಟನೆನೆ ನ್ಹಾನಾ ರಾಜಾ಼ವೊನೆ, ನಾಯಕೊನೆ, ದೆಶಾದಿಪತಿಯೊನೆ, ಮಂತ್ರಿಯೊನೆ, ಕೊಶಾಧ್ಯಕ್ಷವೊನೆ, ನ್ಯಾಯಾಧಿಪತಿಯೊನೆ ವರಿ ಉಗ್ರಲ ಕ್ಹಾರಾ ಅದಿಕಾರಿಯೊನೆ ಬಲಾಯೊ.<verse eid="DAN 3:18" /></para>
  <para style="s1">ದಾನಿಯಲ ವರಿ ತಿನಾ ಸಾತಿದಾರೊನೆ ಮರಾನಿ ಶಿಕ್ಷಾ ದಿದಲ</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19" />ತೆಳಾಮಾ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ, ‘ತಿಮ್ಮ ನೈ, ತುಮೆ ಮನೆ ಮಾರು ಕ್ಹಪನ ತಿನು ಮತ್ಲಬ ಕೌ. ನೈ ಕದ್ಯಾಮ ಮಿ ತುಮಾರಾ ಅಂಗನೆ ತುಂಡ ತುಂಡ ಕರಿನ ಕಾಟಾನೆ ಆಗನ್ಯಾ ದಿವ್ಸ. ತುಮಾರಾ ಘರೊ ಪಾಡಿನ ಮಾತಿ ಕರು ಕೈನ ಆಗನ್ಯಾ ದಿವ್ಸ. <verse eid="DAN 3:19" /><verse number="20" style="v" sid="DAN 3:20" />ತೆಳಾಮಾ ರಾಜೊ಼ ತ್ಯುನೊನೆ ‘ಮಿ ಯಕ್ಕ ಕ್ಹಪನ ದೆಕ್ಯೊ. ತೆ ಮನೆ ಕ್ಹಾವಾಡುಸ. ತೆ ಕ್ಹಪನನು ಮತ್ಲಬ ಸು ವ್ಹೈ ಕವಾನು ಮಿ ತಿಳ್ದಿಲಿಗೊ ಕೈನ ಛೆ” ಕದ್ಯೊ. <verse eid="DAN 3:20" /><verse number="21" style="v" sid="DAN 3:21" />ತೆಳೆ ತೆ ಕಸ್ದಿಯರೊ ಅರಮೆಯಿಕ ಬಾಷಾಮಾ, ‘ರಾಜಾ಼ ಅಮರ ಥೈನ ರ‍್ಹೆ. ಹಮೆ ತಾರಾ ಸೆವಕೊ ವ್ಹೈ. ದಯಾಕರಿನ ಹಮೊನೆ ತಾರು ಕ್ಹಪನ ಕೆ. ಹಮೆ ತಿನು ಮತ್ಲಬ ಕಯ್ಯೆಸ” ಕೈನ ಉತ್ತರ ದಿದ್ಯಾ.ಘಾಲಿಲಿದಲ ವಣ್ಣಾನಾ ಕ್ಹಮಾತಾಜ಼ದಿದ್ಯೊ <verse eid="DAN 3:21" /><verse number="22" style="v" sid="DAN 3:22" />ತಿನಿ ಆಳ್ವಿಕೆನಾ ಬೆಂವಾ ವರಕ್ಹಮಾ ನೆಬುಕದ್ನೆಚ್ಚರ ದಕ್ಹಾ ಕ್ಹಪನೊ ದೆಕ್ಯೊ. ತೆ ಕ್ಹಪನೊ ತಿನೆ ಘಾಬ್ರಾ ಕರಿ ಪಡ್ಯಾ ವರಿ ತಿನೆ ನಿಂದರ ಆಯೆ ನೈಸೊ ಕರ‍್ಯಾ. <verse eid="DAN 3:22" /><verse number="23" style="v" sid="DAN 3:23" />ತೆಳಾಮಾ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ತೆ ಹುಬ್ರಾಡಲ ಮುರ್ತಿನಾ ಉದ್ಘಾಟನೆನೆ ನ್ಹಾನಾ ರಾಜಾ಼ವೊನೆ, ನಾಯಕೊನೆ, ದೆಶಾದಿಪತಿಯೊನೆ, ಮಂತ್ರಿಯೊನೆ, ಕೊಶಾಧ್ಯಕ್ಷವೊನೆ, ನ್ಯಾಯಾಧಿಪತಿಯೊನೆ ವರಿ ಉಗ್ರಲ ಕ್ಹಾರಾ ಅದಿಕಾರಿಯೊನೆ ಬಲಾಯೊ <verse eid="DAN 3:23" /><verse number="24" style="v" sid="DAN 3:24" />ನೆಬುಕದ್ನೆಚರ ಬಾಬೆಲೊನನೊ ರಾಜೊ಼ ಥಯೊತೊ. ನೆಬುಕದ್ನೆಚರ ಯೆರುಸಲೆಮನೆ ಆಯೊ. ನೆಬುಕದ್ನೆಚರ ತಿನಾ ಸೆನಾನಾ ಕ್ಹಾತೆ ಯೆರುಸಲೆಮನೆ ಮುತ್ತಿಗೆ ಘಾಲ್ಯೊ. ಯೆಹುದನೊ ರಾಜೊ಼ ಥಯಲ ಯೆಹೊಯಾಕಿಮನಾ ಅದಿಕಾರನಾ ತನ್ವಾ ವರಕ್ಹಮಾ ಎ ಘಟನಾ ಥೈ. <verse eid="DAN 3:24" /><verse number="25" style="v" sid="DAN 3:25" />ತ್ಯುನೆ ಕ್ಹಾರಾ ಜ಼ನಾ ಐನ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಹುಬ್ರಾಡಲ ಮುರ್ತಿನಾ ಕ್ಹಾಮಾ ಹುಬ್ರಯಾ.<verse eid="DAN 3:25" /></para>
  <para style="s">ತನ್ನ ದಾಣ್ಗಾವೊನೆ ಬಿಡುಗಡೆ ಕರಲ ವರಿ ಹೆಚ್ಚ ಅದಿಕಾರ ದಿವಸ</para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26" />ತೆಳಾಮಾ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ತೆ ಹುಬ್ರಾಡಲ ಮುರ್ತಿನಾ ಉದ್ಘಾಟನೆನೆ ನ್ಹಾನಾ ರಾಜಾ಼ವೊನೆ, ನಾಯಕೊನೆ, ದೆಶಾದಿಪತಿಯೊನೆ, ಮಂತ್ರಿಯೊನೆ, ಕೊಶಾಧ್ಯಕ್ಷವೊನೆ, ನ್ಯಾಯಾಧಿಪತಿಯೊನೆ ವರಿ ಉಗ್ರಲ ಕ್ಹಾರಾ ಅದಿಕಾರಿಯೊನೆ ಬಲಾಯೊ. <verse eid="DAN 3:26" /><verse number="27" style="v" sid="DAN 3:27" />ಮಾರಾ ಪುರ್ವಿಕರೊನಾ ಕ್ಹುದಾ, ತುನೆ ಸ್ತುತಿ ಕರಿಯೆಸ. ತು ಮನೆ ಗ್ಯಾನ ತಾಕತ ದಿದ್ಯೊಸ. ಮಿ ಐಕಲ ದಿದ್ಯೊಸ. ರಾಜಾ಼ನಾ ಕ್ಹಪನನೆ ತಿಲ್ಸಾಯೊಸ.” <verse eid="DAN 3:27" /><verse number="28" style="v" sid="DAN 3:28" />ದಾನಿಯಲ ಮಾಂಗಿಲಿವಾಕ್ಹು ರಾಜೊ಼ ಶದ್ರಕ್ ಮೆಶಕ್ ಅಬೆದ್ನಗೊ ಕಾವಾಲಾವೊನೆ ಬಾಬೆಲ ಸಂಸ್ಥಾನನಾ ಕಾಮೊ ತ್ಯುನೊನೆ ದಿದ್ಯೊ; ನಾಶ ದಾನಿಯಲ ರಾಜ಼ಮಹಲಮಾ ಹುಬ್ರಯೊ. <verse eid="DAN 3:28" /><verse number="29" style="v" sid="DAN 3:29" />ಕ್ಹಾರಾ ಜನಾಂಗನಾ ಕುಲ ಭಾಷಾವಾಲಾವೊಮಾ ಕುನ್ನತಬಿ ಶದ್ರಕ್ ಮೆಶಕ್ ಅಬೆದ್ನಗೊ ಕವಾಲಾವೊನಾ ಕ್ಹುದಾನಾ ವಿಶಯಮಾ ನೈ ತ್ಯಾಂತಾ ವಾತೊ ಬೊಲ್ಯಾಮ ತ್ಯುನೊನೆ ತುಕ್ಡಾ ತುಕ್ಡಾ ಕತ್ರಿನ ತ್ಯುನಾ ಘರೊನೆ ಉಕ್ಡೊ ಕರು ಕವಾನಿ ಆಗನ್ಯಾ ಕರುಸ; ಇಮ್ಮ ಉದ್ದಾರ ಕರಾನೆ ತಾಕತವರ ಥಯಲ ಬಿಜಾ಼ ಕಯಾ ಕ್ಹುದಾನೆ ನತ್ತಿತೊ ಕೈನ ಕದ್ಯೊ. <verse eid="DAN 3:29" /><verse number="30" style="v" sid="DAN 3:30" />ಪಾಚ಼ಲ್ತೊ ರಾಜೊ಼ ಶದ್ರಕ ಮೆಶಕ ಅಬೆದ್ನಗೊ ಕವಾಲಾವೊನೆ ಬಾಬೆಲನಾ ಸಂಸ್ಥಾನಮಾ ಮ್ಹೊಟಿ ಪದವಿನೆ ಲಾಯೊ.<verse eid="DAN 3:30" /></para>
  <chapter eid="DAN 3" />
  <chapter number="4" style="c" sid="DAN 4" />
  <para style="s">ನೆಬುದಕ್ನೆಚರನು ಬೆವಾ ಕ್ಹಪನ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 4:1" />ದುನಿಯಾಮಾ ರ‍್ಹಾವಾಲಾ ಕ್ಹಾರಾ ಜನಾಂಗ ಖಾಂದಾನವಾಲಾ ಜಾ಼ತವಾಲಾವೊನೆ ನೆಬುದೆಕನೆಚರ ಪ್ರಕಟಣೆ <verse eid="DAN 4:1" /><verse number="2" style="v" sid="DAN 4:2" />ತುಮೊನೆ ಸುಖಾ ಜಾಸ್ತ ಥಾವಾದೆ! ಪರಾತ್ಪರ ಥಯಲ ಕ್ಹುದಾ ಮಾರಿ ವಿಶಯಮಾ ಚ಼ಲಾಯಲ ಮಹತ್ತೊನೆ ಅದ್ಬುತೊನೆ ಪ್ರಚಾರ ಕರು ಕವಾನು ಮನೆ ಮನಸ ಛೆ. <verse eid="DAN 4:2" /><verse number="3" style="v" sid="DAN 4:3" />ತಿನಾ ಮಹತ್ತೊ ಘನ್ನಾ ಮ್ಹೊಟಾ ವ್ಹೈ! ತಿನಾ ಅದ್ಬುತೊ ಘನ್ನಾ ಖಾಸ ವ್ಹೈ! ತಿನಿ ರಾಜ್ಯ ಹಮೆಶಾನಿ ರಾಜ್ಯ ವ್ಹೈ, ತಿನಿ ಆಳ್ವಿಕೆ ತಲತಲಾಂತರ ಲಕ್ಕಾ ಹುಬ್ರ್ಯವಸ. <verse eid="DAN 4:3" /><verse number="4" style="v" sid="DAN 4:4" />ನೆಬುಕದ್ಬೆಚ್ಚರ ಥಯಲ ಮಿ ಆಲಯಮಾ ಅರಾಮ ವ್ಹತ್ತೊ, ಹೊ ಮಾರಾ ಮಹೆಲಮಾ ಮಸ್ತ ವ್ಹತ್ತೊ. <verse eid="DAN 4:4" /><verse number="5" style="v" sid="DAN 4:5" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಮನೆ ಭುಚ್ಕಾ಼ಡಾನು ಯಕ್ಕ ಕ್ಹಪನ ಪಡ್ಯು; ವಚ್ಚಾ಼ನಾಮಾ ಮನೆ ಆಯಲ ವಿಚಾರೊ ಮಾರಾ ಮನಸನೆ ಪಡಲ ಕ್ಹಪನೊ ಮನೆ ಕಳವಳ ಕರ‍್ಯಾ. <verse eid="DAN 4:5" /><verse number="6" style="v" sid="DAN 4:6" />ತಿನಾಹುತಿ ಕ್ಹಪನನು ಮತ್ಲಬ ಕವಾನೆ ಬಾಬೆಲನಾ ಕ್ಹಾರಾ ವಿದ್ವಾಂಸೊನೆ ಬಲಾವಾನೆ ಆಗನ್ಯಾ ದಿದ್ಯೊ. <verse eid="DAN 4:6" /><verse number="7" style="v" sid="DAN 4:7" />ಜೊಯಿಸರೊ, ಮಾಟಾ ಮಂತ್ರಾ ಕರಾಲಾ, ಪಂದಿತೊ, ಶಕುನಾ ಕವಾಲಾ, ಇವ್ನೆ ಕ್ಹಾಮಾ ಆಯಲ್ಪರ ಮಿ ಆಂ ಕ್ಹಪನ ಕತಾಮಾ ತ್ಯುನೆ ಅನು ಮತ್ಲಬ ಕದ್ಯಾ ಬಗರ ಗಯಾ. <verse eid="DAN 4:7" /><verse number="8" style="v" sid="DAN 4:8" />ಮಾರಾ ಕ್ಹುದಾನು ನಾಮ ಮಳಲ ಬೆಲ್ತೆಶಚ್ಚರ ಕೈನ ಅಡ್ಡನಾಮ ಮ್ಹೆಲ್ಲಿದಲವಾಲೊ ಪರಿಶುದ್ದ ಕ್ಹುದಾವೊನಿ ಆತ್ಮಾ ರ‍್ಹಯಲವಾಲೊ ಥಯಲ ದಾನಿಯಲ ಕ್ಹಾರಾವೊತಿ ಲಾಸ್ಟ ಮಾರಿ ಸನ್ನಿದಿನೆ ಆತಾಕ್ಹು ಮಿ ಮಾರು ಕ್ಹಪನ ಅಮ್ಮ ತಿಳಸಾಯೊ- <verse eid="DAN 4:8" /><verse number="9" style="v" sid="DAN 4:9" />ಬೆಲ್ತೆಶಚ್ಚರ, ಜೊಯಿಸರೊಮಾ ಕ್ಹಾಸ ರ‍್ಹಯಲವಾಲಾ, ಪರಿಶುದ್ದ ಕ್ಹುದಾವೊನಿ ಆತ್ಮಾ ತಾರಾಮಾ ಛೆ ಕೈನ ತಿಳದ್ಯೊಸ, ಕೈ ರಹಸ್ಯ ತುನೆ ಡದಿನ ರ‍್ಹಯು ನತ್ತಿ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. ತಿನಾಹುತಿ ಮಿ ದೆಕಲ ಕ್ಹಪನನೆ ತಿನು ಮತ್ಲಬ ಮನೆ ತಿಳ್ಸಾ. <verse eid="DAN 4:9" /><verse number="10" style="v" sid="DAN 4:10" />ಮಿ ವಚ್ಚಾ಼ನಾಮಾ ಕ್ಹುರಯಲ ಟೈಮಮಾ ಮಾರಾ ಮನಸನೆ ಪಡಲ ಕ್ಹಪನೊ ಎಜ಼ ವ್ಹೈ- ದೆಕ, ದುನಿಯಾನಾ ವಚ್ಮಾ ಘನ್ನು ಉಚ್ಚು಼ ರ‍್ಹಯಲ ಯಕ್ಕ ಝಾಡ ದೆಕ್ಯೊ. <verse eid="DAN 4:10" /><verse number="11" style="v" sid="DAN 4:11" />ತೆ ಝಾಡ ಬೆಳ್ದಿನ ತಾಕತವರ ಥಯುತು. ತಿನಿ ತುದಿ ಹಬಾಳನೆ ಮುಟ್ಯುತು. ತೆ ದುನಿಯಾನಾ ಲಾಸ್ಟ ಲಕ್ಕಾತುಬಿ ದಿಕ್ಹತುತು. <verse eid="DAN 4:11" /><verse number="12" style="v" sid="DAN 4:12" />ತಿನಾ ಪಾಲೊ ಚೊ಼ಕಾ, ಫಲ್ಲೊ ಘನಾ ತಿನಾಕ್ಹು ಕ್ಹಾರಾವೊನೆ ಅನ್ನ, ಛೌಲಿ ವರಿ ಬುಜಂತುವೊನೆ ಆಸರೊ, ಠೊಂಗಿಯೊ ಹಬಾಳನಾ ಪಕ್ಷಿಯೊನೆ ಆಸರೊ, ತೆ ಕ್ಹಾರಾ ಜಿವಿಯೊನೆಬಿ ಜ಼ಲಮ ವ್ಹೈ. <verse eid="DAN 4:12" /><verse number="13" style="v" sid="DAN 4:13" />ಮಿ ವಚ್ಚಾ಼ನಾಮಾ ಕ್ಹುರಯಲ ಟೈಮಮಾ ಮಾರಾ ಮನಸನೆ ಪಡಲ ಕ್ಹಪನಮಾ ಅನಿಮಿಷ ಥಯಲ ದೆವದುತ ಹಬಾಳತೊ ಉತ್ರಲ ದೆಕ್ಯೊ. ಜೊ಼ರ ವದ್ರಿನ- <verse eid="DAN 4:13" /><verse number="14" style="v" sid="DAN 4:14" />ಝಾಡನೆ ಕಾಟೊ, ಠೊಂಗಿಯೊನೆ ಕಾಟೊ, ಪಾಲೊನೆ ಕಿತ್ತೊ, ಫಲ್ಲೊನೆ ನಾಕೊ; ಜಾನವರೊ ಛೌಲಿನೆ ಛೊಡಿ ಪಡಾದೆ, ಪಕ್ಷಿಯೊ ಠೊಂಗಿಯೊನೆ ಛೊಡಿನ ಜಾ಼ವಾದೆ! <verse eid="DAN 4:14" /><verse number="15" style="v" sid="DAN 4:15" />ತೆನೈಸೊ ಬುಡನ ಬೆರನೆ ಜಿಮಿನಮಾ ಛೊಡೊ ಲ್ಹೊಡಾನಾ ತಾಂಬಾನಾ ಪಟ್ಟಿಯೊ ತಿನೆ ಭಾಂದೊ; ರಾನನೊ ಚಾ಼ರೊ ತಿನಾ ಸುತ್ತೆ ಬೆಳದಾದೆ, ಹಬಾಳನಿ ಠಾರ ತಿನೆ ಭಿಂಜಾ಼ವಾದೆ, ಜಿಮಿನನೊ ಚಾ಼ರೊ ಜಾನವರೊನೆ ಗತಿ ಥಯಲ ತಿಮ್ಮ ತಿನೆ ಗತಿ ಥಾವಾದೆ; <verse eid="DAN 4:15" /><verse number="16" style="v" sid="DAN 4:16" />ತಿನೆ ಮನಕ್ಹನು ಮನಸ ಗೈನ ಜಾನವರನು ಮನಸ ಆವಾದೆ; ಇಮ್ಮ ತಿನೆ ಕ್ಹಾತ ವರಕ್ಹ ಥಾವಾದೆ. <verse eid="DAN 4:16" /><verse number="17" style="v" sid="DAN 4:17" />ಎ ಅನಿಮಿಷನೊ ಫೈಸಲೊ ವ್ಹೈ, ಕ್ಹುದಾನು ತಿರ್ಪ ವ್ಹೈ; ಪರಾತ್ಪರ ಕ್ಹುದಾ ಮನಕ್ಹೊನಾ ರಾಜ್ಯಮಾ ರಾಜೊ಼ ಥೈನ ತಿನಿ ಆಳ್ವಿಕೆನೆ ತಿನೆ ಚಾ಼ಯೆ ಥಯಲವಾಲಾವೊನೆ ವಪ್ಸಿನ ಕಮ್ಮ ರ‍್ಹಯಲವಾಲಾವೊನೆ ತಿನಾ ಉಪ್ಪರ ನೆಮಕ ಕರಸ ಕವಾನು ಜಿವ್ತಾ ರ‍್ಹವಾನೆಲಾವೊನೆ ತಿಳ್ದಿನ ಔ ಕೈನಜ಼ ಎ ಫೈಸಲೊ ಥಯೊ ಕೈನ ಕದ್ಯೊ. <verse eid="DAN 4:17" /><verse number="18" style="v" sid="DAN 4:18" />ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಕವಾಲೊ ಮಿ ಎ ಕ್ಹಪನ ದೆಕ್ಯೊ; ಬೆಲ್ತೆಶಚ್ಚರ, ಮಾರಾ ರಾಜ್ಯನಾ ಕ್ಹಾರಾ ವಿದ್ವಾಂಸೊಮಾ ಕುನ್ನಜ಼ ತಿನು ಮತ್ಲಬ ಕೆ ನೈ ಸಕ್ತಾ; ಮಿ ತಿನು ಮತ್ಲಬ ತಿಳ್ಸಾ; ಪರಿಶುದ್ದ ಕ್ಹುದಾವೊನಿ ಆತ್ಮಾ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲಕ್ಹು ತು ಕವಾಲೊ ವ್ಹೈ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ.<verse eid="DAN 4:18" /></para>
  <para style="s">ದಾನಿಯಲ ಕ್ಹಪನನು ಮತ್ಲಬ ಕವಾನು</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 4:19" />ಬೆಲ್ತೆಶಚ್ಚರ ಕವಾನೊ ಅಡ್ಡ ನಾಮನೊ ದಾನಿಯಲ ತಿನಾ ಗ್ಯಾನನೆ ದಿಕ್ಹಿನ ಆಯಲಕ್ಹು ಘಾಬ್ರೊ ಥೈನ ದಕ್ಹಿಯೆಳ ಗಪ್ಪಚುಪ್ಪ ಥಯೊ. ರಾಜೊ಼ ಎ ದೆಕಿನ ಬೆಲ್ತೆಶಚ್ಚರ ಮಾರು ಕ್ಹಪನ ರ್ಹವಾದೆ ತಿನು ಮತ್ಲಬ ರ್ಹವಾದೆ ತುನೆ ಭುಚ್ಕಾಡ್ಯಾ ಬಗರ ರ್ಹವಾದೆ ಕೈನ ಕತಾಮಾ ಬೆಲ್ತೆಶಚ್ಚರ ಮಾರಾ ಮಾಲಕ, ತೆ ಕ್ಹಪನ ತಾರಾ ದುಶ್ಮನೊನೆ ಆವಾದೆ, ತಿನು ಮತ್ಲಬ ತಾರಾ ವಿರೊದಿಯೊನಾ ಅನುಭವನೆ ಆವಾದೆ! <verse eid="DAN 4:19" /><verse number="20" style="v" sid="DAN 4:20" />ಕಯು ಝಾಡ ಬೆಳದಿನ ತಾಕತವರ ಥೈನ ಹಬಾಳನಾ ತುದಿನೆ ಲಾಗತು ಪರಾ ದುನಿಯಾವಾಲಾವೊನೆ ದಿಕ್ಹತು <verse eid="DAN 4:20" /><verse number="21" style="v" sid="DAN 4:21" />ಚೊ಼ಕಾ ಪಾಲೊ ಘನ್ನಾ ಫಲೊ ದೆತು ಕ್ಹರಾವೊನೆ ಅನ್ನ ದೆತು ತಿನಿ ಛೌಲಿನೆ ಜಾನ್ವರೊ ಆಸರೊ ಕರಿನ ತಿನಾ ಠೊಂಗಿಯೊನೆ ಹಬಾಳನಾ ಪಕ್ಷಿಯೊನೆ ಆಸರೊ ಕರತು ಕ್ಹಪನಮಾ ತುನೆ ದಿಕ್ಯುತೊ ತೆ ಝಾಡ ತುಜ಼ ವ್ಹೈ; <verse eid="DAN 4:21" /><verse number="22" style="v" sid="DAN 4:22" />ರಾಜಾ಼ ತು ಬೆಳದಿನ ತಾಕತವರ ಥಯೊಸ, ತಾರಿ ಮಹಿಮಾ ಬೆಳ್ದಿನ ಹಬಾಳನೆ ಮುಟ್ಟಿಸ, ತಾರಿ ಆಳ್ವಿಕೆ ದುನಿಯಾನಾ ಲಾಸ್ಟ ಲಕ್ಕಾ ಫೈಲಿಸ. <verse eid="DAN 4:22" /><verse number="23" style="v" sid="DAN 4:23" />ಅನಿಮಿಷ ಥಯಲ ದೆವದುತ ಹಬಾಳತೊ ಉತ್ರಿನ- ಝಾಡನೆ ಕತ್ರಿನ ಹಾಳ ಕರೊ; ತೆನೈಸೊ ತಿನಾ ಬುಡನೆ ಜಿಮಿನಮಾ ಛೊಡಿನ ಲ್ಹೊಡಾ ತಾಂಬಾನಾ ಪಟ್ಟಿಯೊ ತಿನೆ ಭಾಂದೊ, ರಾನನೊ ಚಾ಼ರೊ ತಿನಾ ಸುತ್ತ ಬೆಳದಾದೆ, ಹಬಾಳನು ಠಾರ ತಿನೆ ಭಿಂಜಾ಼ವಾದೆ, ತಿನೆ ಕ್ಹಾತ ವರಕ್ಹ ಥಯೆಲಕ್ಕಾ ರಾನನಾ ಜಾನವರೊನೆ ಆವಾನಿ ಗತಿ ತಿನೆಬಿ ಆವಾದೆ ಕೈನ ಕವಾನು ರಾಜೊ಼ ಥಯಲ ತು ದೆಕ್ಯೊಸ; <verse eid="DAN 4:23" /><verse number="24" style="v" sid="DAN 4:24" />ರಾಜಾ಼, ಇನು ಮತ್ಲಬ ಸು ವ್ಹೈ ಕದ್ಯಾಮ, ಮಾರಾ ಮಾಲಕ ಥಯಲ ರಾಜಾ಼ನೆ ಥಾವಾನಿ ಪರಾತ್ಪರ ಥಯಲ ಕ್ಹುದಾನಿ ಫೈಸಲೊ ಇಮ್ಮ ಛೆ- <verse eid="DAN 4:24" /><verse number="25" style="v" sid="DAN 4:25" />ತು ಮನಕ್ಹೊತೊ ದುರ ಥೈನ ರಾನನಾ ಜಾನವರೊನಾ ಕ್ಹಾತೆ ರ‍್ಹಶಿ, ಬೈಲೊ ನಿಂಗತ ಚಾ಼ರೊ ಚ಼ರಾನುಜ಼ ತುನೆ ಗತಿ ಥಾವಸ, ಹಬಾಳನಿ ಠಾರ ತುನೆ ಭಿಂಜಾವಸ; ಪರಾತ್ಪರ ಥಯಲ ಕ್ಹುದಾ ಮನಕ್ಹೊನಾ ರಾಜ್ಯಮಾ ರಾಜೊ಼ ಥೈನ ತಿನೆ ಚಾ಼ಯೆ ಥಯಲವಾಲಾವೊನೆ ವಪ್ಸಸ ಕವಾನು ತುನೆ ತಿಳ್ದೆ ಲಕ್ಕಾ ಕ್ಹಾತ ವರಕ್ಹ ತುನೆ ಇಮ್ಮಜ಼ ಜಾ಼ವಸ. <verse eid="DAN 4:25" /><verse number="26" style="v" sid="DAN 4:26" />ಝಾಡನಾ ಬುಡನೆ ಛೊಡೊ ಕೈನ ಅಪ್ಪಣೆ ಥಯುತೊ; ಇನು ಮತ್ಲಬ ಸು ವ್ಹೈ ಕದ್ಯಾಮ ಪರಲೊಕನೆ ಸರ್ವಾದಿಕಾರ ಛೆ ಕವಾನು ತು ತಿಳ್ದಿಲಿದಲ್ಪರ ತಾರಿ ರಾಜ್ಯ ತುನೆ ಉಗ್ರಸ ಕವಾನುಜ಼ ವ್ಹೈ. <verse eid="DAN 4:26" /><verse number="27" style="v" sid="DAN 4:27" />ತಿನಾಹುತಿ ರಾಜಾ಼, ಎ ಮಾರಿ ಗ್ಯಾನನಿ ವಾತೊ ತುನೆ ವಪ್ಪಿಗೆ ಥಾವಾದೆ- ತು ನಿತಿ ಕರಿನ ತಾರಾ ಪಾಪೊನೆ ನಾಶ ಕರ, ಗರಿಬೊನೆ ಕರುಣಾ ದೆಕಾಡಿನ ತಾರಾ ಅಪರಾದೊನೆ ನಾಶ ಕರ; ಇನಾಕ್ಹು ತಾರಿ ನೆಮ್ಮದಿನು ಟೈಮ ಜಾಸ್ತ ಥಾಸ ಕೈನ ಕದ್ಯೊ. <verse eid="DAN 4:27" /><verse number="28" style="v" sid="DAN 4:28" />ಎ ಕ್ಹಾರು ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರನಾ ಅನುಭವನೆ ಐಯು. <verse eid="DAN 4:28" /><verse number="29" style="v" sid="DAN 4:29" />ಬಾರಾ ಮ್ಹೈನಾ ಥಯಲ್ಪರ ತೆ ಬಾಬೆಲನಾ ಮಹೆಲನಾ ಉಪ್ಪರ ಫರ್ತೊ- <verse eid="DAN 4:29" /><verse number="30" style="v" sid="DAN 4:30" />ಮಾರಿ ಮಹಿಮಾ ಮಶುರ ಥಾಯೆ ನಿಂಗತ ಮಾರಿ ತಾಕತಕ್ಹು ರಾಜೊ಼ ರ‍್ಹವಾನೆನಾಹುತಿ ಮಿ ಭಂದಾಯಲ ವ್ಹೈ ದೆಕೊ, ಮ್ಹೊಟು ಗಾಮ ಥಯಲ ಎ ಬಾಬೆಲ ವ್ಹೈ ಕೈನ ಅಹಂಕಾರ ಕರ‍್ಯೊ. <verse eid="DAN 4:30" /><verse number="31" style="v" sid="DAN 4:31" />ಎ ವಾತ ರಾಜಾ಼ನಾ ಮ್ಹೊಡಾತು ಆತಾಮಾ- ರಾಜಾ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ, ತುನೆ ಥಯಲ ಕ್ಹುದಾನಿ ವಾತ ಐಕ; <verse eid="DAN 4:31" /><verse number="32" style="v" sid="DAN 4:32" />ರಾಜ್ಯ ತಾರಾಕ್ಹು ಛುಟಿನ ಗಯುಸ, ತು ಮನಕ್ಹೊಮಾತೊ ಜು಼ದೊ ಥೈನ ರಾನನಾ ಜಾನವರೊನಾ ಕ್ಹಾತೆ ರ‍್ಹಶಿ, ಬೈಲೊ ನಿಂಗತ ಚಾ಼ರೊ ಚ಼ರಾನುಜ಼ ತಾರಿ ಗತಿ ಥಾವಸ; ಪರಾತ್ಪರ ಥಯಲ ಕ್ಹುದಾ ಮನಕ್ಹೊನಾ ರಾಜ್ಯಮಾ ರಾಜೊ಼ ಥೈನ ತಿನೆ ಚಾ಼ಯೆ ಥಯಲವಾಲಾವೊನೆ ವಪ್ಸಸ ಕವಾನು ತುನೆ ತಿಳ್ದೆ ಲಕ್ಕಾ ಕ್ಹಾತ ವರಕ್ಹ ತುನೆ ಇಮ್ಮಜ಼ ಜಾ಼ವಸ ಕೈನ ಹಬಾಳತಿ ಸುದ್ದಿ ಥಯು. <verse eid="DAN 4:32" /><verse number="33" style="v" sid="DAN 4:33" />ಎ ವಾತ ನೆಬುಕದ್ನೆಚ್ಚರಮಾ ತೆಳಾಮಾಜ಼ ಪುರಾ ಥಯು;ತೆ ಮನಕ್ಹೊಮಾತೊ ಜು಼ದೊ ಥೈನ ಬೈಲೊ ನಿಂಗತ ಚಾ಼ರೊ ಚ಼ರತೊ ಹಬಾಳನಿ ಠಾರಕ್ಹು ಭಿಂಜಾತೊ ವ್ಹತ್ತೊ; ತಿನಾ ಬಾಲೊ ಘಾರೊನಿ ಗರಿ ನಿಂಗತಬಿ ತಿನಾ ನಕ್ಕೊ ಪಕ್ಷಿನಾ ನಕ್ಕೊ ನಿಂಗತ ಬೆಳದ್ಯಾ.<verse eid="DAN 4:33" /></para>
  <para style="s">ನೆಬುದಕನೆಚರ ಕ್ಹು ಕ್ಹುದಾನಿ ಸ್ತುತಿ</para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 4:34" />ತೆ ಟೈಮ ಥಯಲ್ಪರ ನೆಬುಕದ್ನಚ್ಚರ ಥಯಲ ಮಿ ಹಬಾಳಕನ ದೆಕ್ತಾಮಾ ಮಾರಿ ಗ್ಯಾನ ಫರಿನ ಮನೆ ಮಳಿ. ತೆಳಾಮಾ ಮಿ ಪರಾತ್ಪರ ಥಯಲ ಕ್ಹುದಾನೆ ಸ್ತುತಿ ಕರಿನ ಹಮೆಶಾ ಜ್ಯುತಾ ರ್ಹವಾಲಾನೆ ಸ್ತೊತ್ರಾ ಕರ್ಯೊ; ತಿನಿ ಆಳ್ವಿಕೆ ಹಮೆಶಾನಿ ವ್ಹೈ, ತಿನಿ ರಾಜ್ಯ ತಲತಲಾಂತರ ಲಕ್ಕಾ ಹುಬ್ರ್ಯವಸ; <verse eid="DAN 4:34" /><verse number="35" style="v" sid="DAN 4:35" />ಭುಮಿಪರ ರ‍್ಹವಾನೆಲಾ ಕ್ಹಾರಾ (ತಿನಾ ನಜ಼ರಮಾ) ಸುಜ಼ ನೈಸೊವಾಲಾ ನಿಂಗತ ಛೆ, ಪರಲೊಕ ಸೈನ್ಯವಾಲಾವೊಮಾಬಿ ಭುಲೊಕವಾಲಾವೊಮಾಬಿ ತಿನಾ ಪಸಂದ ನಿಂಗತ ಚಾ಼ಲಸ; ಕುನ್ನ ತಿನಾ ಹತ್ತನೆ ಪಾಚಾ಼ ನೈ ಢಕಲ ಸಕ್ತಾ, ತು ಸು ಕರ್ಶಿ ಕೈನ ಕುನ್ನ ಪುಚ್ಚ ನೈ ಸಕ್ತು. <verse eid="DAN 4:35" /><verse number="36" style="v" sid="DAN 4:36" />ತೆಜ಼ ಟೈಮಮಾ ಮಾರಿ ಗ್ಯಾನ ಮಾರಾ ಪಾಲೆ ಥೈ; ಮಾರಿ ಪ್ರಭಾವ ಮಹಿಮಾ ಮನೆ ಫರಿನ ಮಳಿನ ಮಾರಿ ರಾಜ್ಯನಿ ಕಿರ್ತಿ ದಿಕ್ಹಿನ ಐ; ಮಾರಾ ಮಂತ್ರಿಯೊ ಅದಿಪತಿಯೊ ಮನೆ ಕ್ಹುಶ ಕರ‍್ಯಾ; ಮಾರಾ ರಾಜ್ಯಮಾ ರಾಜೊ಼ ಥೈನ ಮಿ ರ‍್ಹಯೊ; ಮಾರಿ ಮಹಿಮಾ ಹಜು಼ನ ಘನ್ನಿ ಥೈ. <verse eid="DAN 4:36" /><verse number="37" style="v" sid="DAN 4:37" />ಹಮ್ನಾ ನೆಬುಕದ್ನೆಚ್ಚರ ಥಯಲ ಮಿ ಪರಲೊಕನಾ ರಾಜಾ಼ನೆ ಹೊಗಳಿನ ಸ್ತುತಿ ಕರಿನ ಮಹಿಮಾ ಕರುಸ; ತಿನಾ ಕ್ಹಾರಾ ಕಾಮೊ ಸತ್ಯ ವ್ಹೈ, ತಿನಾ ಕ್ಹಾರಾ ವಾಟೊ ನ್ಯಾಯನಾ ವ್ಹೈ; ಸೊಕ್ಕಕ್ಹು ರ‍್ಹವಾನೆಲಾವೊನೆ ಡೊಗ್ಗಾಡ ಸಕಸ.<verse eid="DAN 4:37" /></para>
  <chapter eid="DAN 4" />
  <chapter number="5" style="c" sid="DAN 5" />
  <para style="s">ಬೆಲ್ತೆಚ್ಚರನು ಕ್ಹಾವಾನು ಕುಟ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1" />ರಾಜೊ಼ ಥಯಲ ಬೆಲ್ತೆಚ್ಚರ ತಿನಾ ರಾಜ್ಯನಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊಮಾ ಹಜಾ಼ರ ಜ಼ನಾವೊನೆ ಕ್ಹಾವಾನು ಕರೈನ ತೆ ಹಜಾ಼ರ ಜ಼ನಾವೊನಾ ಡೊಳಾನಾ ಕ್ಹಾಮೊ ತೆಬಿ ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ಪಿದ್ಯೊ. <verse eid="DAN 5:1" /><verse number="2" style="v" sid="DAN 5:2" />ತಿನೆ ಪಿತೊ ಯೆರುಸಲೆಮನಾ ದೆವಾಲಯಮಾತೊ ತಿನೊ ಬಾ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ಉಚೈಲಿನ ಆಯಲ ರುಪ್ಪಾನಾ ವರಿ ಕ್ಹೊನಾನಾ ತಾಂಬಿಯಾ ವಾಟ್ಕಾವೊಮಾ ತೆಬಿ ತಿನಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ತಿನಿ ಬಾಕ್ಡಿಯೊ ವರಿ ಉಪ ಬಾಕ್ಡಿಯೊನಾ ಕ್ಹಾತೆ ಪಿವಾನಾಹುತಿ ತೆ ಕ್ಹಾರು ಲಿನ ಆವಾನೆ ಆಗನ್ಯಾ ದಿದ್ಯೊ. <verse eid="DAN 5:2" /><verse number="3" style="v" sid="DAN 5:3" />ತೆಳಾಮಾಜ಼ ಯೆರುಸಲೆಮನಿ ದೆವಾಲಯನಾ ವಚ್ಮಾನಿ ಗುಡಿಮಾತಾ ಚೊ಼ರಿ ಕರಲ ಕ್ಹೊನಾನಾ ಸಾಮನೊನೆ ಲಾವಾನೆ ರಾಜೊ಼ ತಿನಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ತಿನಿ ಬೈಕೊ ವರಿ ಉಪ ಪತ್ನಿಯೊ ತೆ ವಾಟ್ಕಾವೊಮಾ ವರಿ ಕುಂಡಾವೊಮಾ ಪಿದ್ಯಾ. <verse eid="DAN 5:3" /><verse number="4" style="v" sid="DAN 5:4" />ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ಪಿನ ಕ್ಹೊನು ರುಪ್ಪು ತಾಂಬು ಲ್ಹೊಡು ಝಾಡೊ ದಗ್ಡಾವೊನಾ ದೆವಸ್ಥಾನೊನೆ ಪುಜಾ ಕರ್ತಾಮಾ, <verse eid="DAN 5:4" /><verse number="5" style="v" sid="DAN 5:5" />ತೆಳಾಮಾಜ಼ ಯಕ್ಲಾನಾ ಹತ್ತನಾ ಬೊಟೊ ಐನ ದಿವ್ವಾನಾ ಕ್ಹಾಮನಾ ಕ್ಹಾಮಾ ಚು಼ನ್ನೊ ಮಾರಲ ಗೊಡಿಪರ ಲಿಕ್ತೊ ರ‍್ಹಯಲತ್ತನೆ ರಾಜೊ಼ ದೆಕ್ಯೊ. <verse eid="DAN 5:5" /><verse number="6" style="v" sid="DAN 5:6" />ತೆಳಾಮಾ ತಿನು ಮ್ಹೊಡು ಚು಼ಮೈ ಗಯುತು, ಮನಸ್ಸ ಕಳವಳ ಥಯುತು, ಕಂಬರನಾ ಹಡ್ಕಾ ಢಿಲ್ಲಾ ಥಯಾ, ಗುಡ್ಗಾ ಕಾಪಾಡಾತಾ. <verse eid="DAN 5:6" /><verse number="7" style="v" sid="DAN 5:7" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ರಾಜೊ಼ ಜೊ಼ರ ಅಡ್ಡಿನ ಮಾಟಾ ಮಂತ್ರ ಕರಾಲಾನೆ ಬಲೈನ ಬಾಬೆಲನಾ ತೆ ವಿದ್ವಾಂಸೊನೆ ಕಯೊ ಎ ಲಿಕ್ಹಾವಟನೆ ಒದಿನ ಇನು ಮತ್ಲಬ ಮನೆ ಕವಾಲಾನೆ ತಿನೆ ಮಿ ಘನ್ನ ಕಿಮ್ಮತನಾ ವಣ್ಣಾ ಘಲೈನ ತಿನಾ ಗಳಾಮಾ ಕ್ಹೊನಾನಿ ಚೈನ ಘಲೈನ ತಿನೆ ರಾಜ್ಯನಾ ತನ್ನ ಕ್ಹಾಸ ಅದಿಕಾರಿಯೊಮಾ ತಿನೆ ಯಕ್ಲಾನೆ ಕ್ಹಾಸ ಅದಿಕಾರಿ ಕರುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="DAN 5:7" /><verse number="8" style="v" sid="DAN 5:8" />ತೆ ಆಸ್ಥಾನನಾ ಕ್ಹಾರಾ ವಿದ್ವಾಂಸೊ ಐನ ದೆಕ್ಯಾ. ವರಿಬಿ ತೆ ಲಿಕ್ಕಲ ಕ್ಹಾರು ಒದಾನೆ ತಿನು ಮತ್ಲಬ ರಾಜಾ಼ನೆ ಕವಾನೆ ಕಿನೆಜ಼ ಥಯು ನೈ. <verse eid="DAN 5:8" /><verse number="9" style="v" sid="DAN 5:9" />ತೆಳಾಮಾ ರಾಜೊ಼ ಥಯಲ ಬೆಲ್ಶಚ್ಚರ ಘನ್ನೊ ಘಾಬ್ರೊ ಥೈನ ತಿನು ಮ್ಹೊಡು ಚುಮೈ ಗಯುತು, ತಿನಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ಮಬ್ಬ ಥೈಗಯಾ. <verse eid="DAN 5:9" /><verse number="10" style="v" sid="DAN 5:10" />ರಾಜೊ಼ ವರಿ ತಿನಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ಕದಲ ವಾತೊ ರಾಣಿ ಐಕ್ತಾಮಾ ಅನ್ನ ಕರಾನಿ ಕ್ಹೊಲಿ ಐನ ರಾಜಾ಼, ಹಮೆಶಾ ಜಿವ್ತೊ ರ‍್ಹೆ, ತಾರು ಮನಸ್ಸ ಕಳವಳ ಥೌ ನೈ, ತಾರು ಮ್ಹೊಡು ಚುಮೈ ಜೌನೈ. <verse eid="DAN 5:10" /><verse number="11" style="v" sid="DAN 5:11" />ಪರಿಶುದ್ದ ಕ್ಹುದಾವೊನಾ ಆತ್ಮಾವೊ ರ‍್ಹಯಲ ಯಕ್ಲೊ ತಾರಿ ರಾಜ್ಯಮಾ ಛೆ; ಕ್ಹುದಾನಾ ಗ್ಯಾನನೆ ಸರಿ ಸಮಾನ ರ‍್ಹಯಲ ಗ್ಯಾನ, ವಿವೆಕ ವರಿ ಗ್ಯಾನನು ಉಜಾಲು ತಾರಾ ಬಾಪನಾ ಕಾಲತುಬಿ ತಿಮಾ ದಿಕ್ಹಿನ ಐಯುಸ;ತಾರು ಬಾಪ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ತಿನೆ ಜೊಯಿಷ್ಯೊಪರ ಮಂತ್ರವಾದಿಯೊಪರ ಪಂಡಿತೊಪರ ಸಕಣಾ ಕವಾಲಾವೊಪರ ತಿನೆ ಮ್ಹೊಟೊ ಕರಿನ ಮ್ಹೆಲ್ಯೊತೊ; <verse eid="DAN 5:11" /><verse number="12" style="v" sid="DAN 5:12" />ಹೊ, ಬೆಲ್ಶಚ್ಚರ ಕವಾಲೊ ರಾಜಾ಼ಕ್ಹು ಬಿಜು಼ ನಾಮ ವ್ಹಂದಿಲಿದಲ ಎ ದಾನಿಯಲಮಾ ಘನ್ನಿ ಮ್ಹೊಟಿ ಗ್ಯಾನ, ವಿವೆಕ ಕ್ಹಪನೊನು ಮತ್ಲಬ ಕವಾನು ಶಾಣೆತನಾ ಒಡಪೊ ಛೊಡೈನ ಕವಾನು ಜಾದು ಗುಂಚಾ಼ಳೊನಾ ಗಾಟೊ ಕ್ಹೊಲಾನೆ ಶಾಣೆತನಾ ತಿಮಾ ದಿಕ್ಹಿನ ಆಯಲಹುತಿಜ಼ ತಿನೆ ತಿನಾಹುತಿಜ಼ ನೆಮ್ಶೊತೊ. ಹಮ್ನಾ ತೆ ದಾನಿಯಲನೆ ಬಲಾಯಾಮ ತೆ ಗೊಡಿಪರ ಬರ್ದಲ ತಿಳ್ಸಾವಸ.<verse eid="DAN 5:12" /></para>
  <para style="s">ದಾನಿಯಲ ಲಿಕ್ಹಾವಟನೆ ತಿಳ್ಸಾಯಲ</para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13" />ತೆಳಾಮಾ ದಾನಿಯಲನೆ ಬಲಾತಾಮಾ ವರಿ ರಾಜೊ಼ ತಿನೆ ರಾಜೊ಼ ಥಯಲ ಮಾರೊ ಬಾ ಯಹುದತೊ ಕೈದಿಯೊ ಕರಿನ ಲಾಯಲ ಯಹುದ್ಯೊನೊ ದಾನಿಯಲ ಕವಾಲೊ ತುಜ಼ ವ್ಹೈ ಸು? <verse eid="DAN 5:13" /><verse number="14" style="v" sid="DAN 5:14" />ಕ್ಹುದಾವೊನಿ ಆತ್ಮಾ ತಾರಾಮಾ ರ‍್ಹೈನ ಘನ್ನು ಗ್ಯಾನಬಿ ವಿವೆಕಬಿ ಗ್ಯಾನನು ಉಜಾಲುಬಿ ತುನೆ ಛೆ ಕೈನ ಮಿ ಐಕ್ಯೊಸ. <verse eid="DAN 5:14" /><verse number="15" style="v" sid="DAN 5:15" />ಹಮ್ನಾ ಆಂ ಲಿಕ್ಹಾವಟ ಒದಿನ ಇನು ಮತ್ಲಬ ಮನೆ ತಿಳ್ಸಾವಾನಾಹುತಿ ವಿದ್ವಾಂಸೊನೆ ಮಂತ್ರವಾದಿಯೊನೆ ಕ್ಹಾಮೊ ಬಲೈಲಿನ ಆತಾಮಾ ತ್ಯುನೆ ಇನು ಮತ್ಲಬ ಇವ್ನೊನೆ ಕವಾನೆ ಥಯಾ ಬಗರ ಗಯಾ. <verse eid="DAN 5:15" /><verse number="16" style="v" sid="DAN 5:16" />ತುತೊ ಗುಡಾರ್ಥ ಕೈನ ಗುಂಚಾ಼ಲಾನಾ ಗಾಟೊ ಕ್ಹೊಲಾಲೊ ಥಯೊಸ ಕವಾನಿ ವಾತ ಮಕನ ಐಸ; ಎ ಲಿಕ್ಹಾವಟನೆ ಒದಿನ ಇನು ಮತ್ಲಬ ಮನೆ ತಿಳ್ಸಾವಾನೆ ತುಕ್ಹು ಥಯುಮ ಮಿ ತುನೆ ಹಮ್ನಾ ಘನ್ನಾ ಕಿಮ್ಮತನಾ ವಣ್ಣಾ ಘಾಲಿನ ತಾರಾ ಗಳಾಮಾ ಕ್ಹೊನಾನಿ ಚೈನ ಘಾಲಾ ಲಗಾಡಿನ ತುನೆ ರಾಜ್ಯನಾ ತನ್ನ ಕ್ಹಾಸ ಅದಿಕಾರಿಯೊಮಾ ಯಕ್ಲೊ ಕರುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="DAN 5:16" /><verse number="17" style="v" sid="DAN 5:17" />ತೆಳಾಮಾ ದಾನಿಯಲ ಸನ್ನಿದಿಮಾ ತು ದಿವಾನು ತುಕನಜ಼ ರ‍್ಹವಾನೆದೆ, ತಾರಾ ಬಹುಮಾನೊ ಬಿಜಾ಼ನೆ ಥಾವಾದೆ; ತೆನೈಸೊ ಮಿ ಎ ಲಿಕ್ಹಾವಟನೆ ಒದಿನ ಇನು ಮತ್ಲಬ ರಾಜಾ಼ನೆ ಕೌಸ. <verse eid="DAN 5:17" /><verse number="18" style="v" sid="DAN 5:18" />ರಾಜಾ಼, ಸರ್ವಶಕ್ತ ಕ್ಹುದಾ ತಾರೊ ಬಾಪ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರನೆ ಎ ರಾಜ್ಯನು ಮಹತ್ವ ಮಾನ ವರಿ ಸನ್ಮಾನೊ ದಿದ್ಯೊ; <verse eid="DAN 5:18" /><verse number="19" style="v" sid="DAN 5:19" />ಎ ಕ್ಹಾಸ ವರಾಕ್ಹು ಕ್ಹಾರಾ ಜನಾಂಗ ಕುಲ ಭಾಷಾವಾಲಾ ತಿನಾ ಕ್ಹಾಮಾ ಭುಚ್ಕಿನ ಕಾಪ್ಯಾ; ಚಾ಼ಯೆ ಥಯಲವಾಲಾವೊನೆ ಕ್ಹಲಾಸ ಕರಾ ಲಗಾಡ್ಯೊ, ಚಾ಼ಯೆ ಥಯಲವಾಲಾವೊನೆ ವಚಾ಼ಡ್ಯೊ, ಮನಸೆ ಆಯಲವಾಲಾವೊನೆ ಚ಼ಡಾಯೊ, ಮನಸೆ ಆಯಲವಾಲಾವೊನೆ ಉತಾರ‍್ಯೊ. <verse eid="DAN 5:19" /><verse number="20" style="v" sid="DAN 5:20" />ಇಮ್ಮ ತಿನು ಮನಸ ಮಸ್ತಿಕ್ಹು ತಿನು ಸ್ವಭಾವ ಜಡ ಥೈನ ತಿನೆ ಸೊಕ್ಕ ಆಯಲಕ್ಹು ತಿನೆ ರಾಜಾ಼ನಾ ಸಿಂಹಾಸನ ಪರ್ತೊ ಢಕ್ಲಿನ ಮನಕ್ಹ ಕಾಡಿ ಪಡ್ಯೊ; <verse eid="DAN 5:20" /><verse number="21" style="v" sid="DAN 5:21" />ತೆ ಮನಕ್ಹೊನಾ ವಚ್ಮಾ಼ತೊ ಭಾರೊ ಕಡಾಯಲವಾಲೊ ವ್ಹೈ, ತಿನು ಗ್ಯಾನ ಜಂಗ್ಲಿ ಜಾನವರ ಲಿಂಗತ ಥಯು, ರಾನನಾ ಗದಡಾವೊನಾ ಕ್ಹಾತೆ ರ‍್ಹಯೊ; ಸರ್ವಶಕ್ತ ಥಯಲ ಕ್ಹುದಾ ಮನಕ್ಹೊನಾ ರಾಜ್ಯಮಾ ರಾಜೊ಼ ಥೈನ ತ್ಯುನಾ ಉಪ್ಪರ ತಿನೆ ಚಾ಼ಯೆ ಥಯಲವಾಲಾವೊನೆ ನೆಮಕ ಕರಸ ಕವಾನು ತಿನೆ ಗ್ವತ್ತ ಥಾಯೆ ಲಕ್ಕಾ ಬೈಲೊ ಲಿಂಗತ ಚಾ಼ರೊ ಚ಼ರಾನು ತಿನಿ ಗತಿ ಥೈ, ಹಬಾಳನಿ ಠಾರ ತಿನಾ ಅಂಗನೆ ಭಿಂಜಾತುತು. <verse eid="DAN 5:21" /><verse number="22" style="v" sid="DAN 5:22" />ಬೆಲ್ಶಚ್ಚರ, ತಿನೊ ದಿಕ್ರೊ ಥಯಲ ತು ಎ ಕ್ಹಾರು ತಿಳ್ದಿ ಲಿದ್ಯೊತಬಿ ತಾರಾ ಮನಸ್ಸನೆ ತಗ್ಸಿ ಲಿದ್ಯೊ ನೈ; <verse eid="DAN 5:22" /><verse number="23" style="v" sid="DAN 5:23" />ಪರಲೊಕನಾ ಮಾಲಕನೆ ವಿರುದ್ದ ಥೈನ ತುನೆ ತುಜ಼ ಜಾಸ್ತ ಕರಿ ಲಿದ್ಯೊ; ತಿನಾ ಆಲಯನಾ ಸಾಮನೊನೆ ಸನ್ನಿದಿನೆ ಲಾಯಾತೊ; ತು ತಾರಾ ರಾಜ್ಯನಾ ಮ್ಹೊಟಾವೊನಾ ವರಿ ತಾರಾ ಬಾಕ್ಡಿಯೊನಾ ವರಿ ಸುಳಿಯೊನಾ ಕ್ಹಾತೆ ತೆ ಕ್ಹಾರಾವೊಮಾ ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ಪಿನ ಗ್ಯಾನ ಡೊಳಾ ಕಾನೊ ನೈ ರ‍್ಹಯಲ ಕ್ಹೊನು ರುಪ್ಪು ತಾಂಬು ಲ್ಹೊಡು ಝಾಡ ದಗ್ಡಾವೊನಾ ದೆವಸ್ಥಾನೊನೆ ಸ್ತುತಿ ಕರ‍್ಯೊಸ; ತೆನೈಸೊ ತಾರೊ ಜ಼ಲಮ ಕಿನಾ ಹತ್ತಮಾ ಛೆ ತಾರಿ ಪರಿಸ್ಥಿತಿ ಕಿನಾ ಅದಿನಮಾ ಛೆ ತೆ ಕ್ಹುದಾನೆ ಮಹಿಮಾ ಕರ‍್ಯೊಜ಼ ನೈ; <verse eid="DAN 5:23" /><verse number="24" style="v" sid="DAN 5:24" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ತೆ ಹತ್ತ ಕ್ಹುದಾನಿ ಸನ್ನಿದಿತೊ ಐನ ಎ ಲಿಕ್ಹಾವಟನೆ ಲಿಕ್ಯು. <verse eid="DAN 5:24" /><verse number="25" style="v" sid="DAN 5:25" />ಲಿಕ್ಕಲ ಲಿಕ್ಹಾವಟ ಎಜ಼ ವ್ಹೈ ಮೆನೆ, ಮೆನೆ, ತೆಕೆಲ, ಉಫರ್ಸಿನ. <verse eid="DAN 5:25" /><verse number="26" style="v" sid="DAN 5:26" />ಇನು ಮತ್ಲಬ ಇಮ್ಮ ಛೆ ಮೆನೆ ಕದ್ಯಾಮ ಕ್ಹುದಾ ತಾರಿ ಆಳ್ವಿಕೆನೊ ಟೈಮ ಹಿಸಾಬ ಕರಿನ ಕ್ಹರಾಯೊಸ; <verse eid="DAN 5:26" /><verse number="27" style="v" sid="DAN 5:27" />ತೆಕೆಲ ಕದ್ಯಾಮ ತು ತಕ್ಕಡಿಮಾ ತೊಲೈನ ಕಮ್ಮ ಛೆ ಕೈನ ದಿಕ್ಹಿನ ಆಯೊಸ; <verse eid="DAN 5:27" /><verse number="28" style="v" sid="DAN 5:28" />ಉಫರ್ಸಿನ ಕದ್ಯಾಮ ತಾರಿ ರಾಜ್ಯ ಬಿಜಿ಼ ಥೈನ ಮೆದ್ಯವಾಲಾವೊನೆಬಿ ಪಾರಸಿವಾಲಾವೊನೆಬಿ ದಿದಲ ಛೆ ಕೈನ ಅರಿಕೆ ಕರ‍್ಯೊ. <verse eid="DAN 5:28" /><verse number="29" style="v" sid="DAN 5:29" />ತೆಳಾಮಾ ಬೆಲ್ಶಚ್ಚರ ಆಗನ್ಯಾ ದೆತಾಮಾ ದಾನಿಯಲನೆ ಘನ್ನಾ ಕಿಮ್ಮತನಾ ವಣ್ಣಾ ಘಾಲಿನ ತಿನಾ ಗಳಾಮಾ ಕ್ಹೊನಾನಿ ಚೈನ ಘಾಲಿನ ಎ ರಾಜ್ಯನಾ ತನ್ನ ಕ್ಹಾಸ ಅದಿಕಾರಿಯೊಮಾ ಯಕ್ಲೊ ಥಯೊ ಕೈನ ಕದ್ಯೊ. <verse eid="DAN 5:29" /><verse number="30" style="v" sid="DAN 5:30" />ತೆಜ಼ ರಾತೆ ಕಸ್ದಿಯನೊ ರಾಜೊ಼ ಥಯಲ ಬೆಲ್ಶಚ್ಚರ ಕ್ಹಲಾಸ ಕರಾ ಲಗಾಡ್ಯಾ. <verse eid="DAN 5:30" /><verse number="31" style="v" sid="DAN 5:31" />ಮೆದ್ಯೆಯನೊ ದಾರ್ಯಾವೆಷ ರಾಜ್ಯನೆ ಲಿದ್ಯೊ. ತಿನಿ ವೈಸ ಕಮ್ಸಿ ಕಮ್ಮ ಕ್ಹಾಟಪರ ಬೆ ವ್ಹತ್ತಿ.<verse eid="DAN 5:31" /></para>
  <chapter eid="DAN 5" />
  <chapter number="6" style="c" sid="DAN 6" />
  <para style="s">ದಾನಿಯಲ ಸಿಂಯ್ಯಾಡಾನಿ ಗವಿಮಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1" />ದಾರ್ಯಾವೆಷ ತಿನಿ ರಾಜ್ಯ ಭಾರ ಪುರಾ ಕರಾನಾಹುತಿ ರಾಜ್ಯನಾ ತೆ ತೆ ಭಾಗೊಪರ ಯಕ್ಹೊನೆ ಇಕ್ಹ ಜ಼ನಾ ದೆಶಾದಿಪತಿಯೊನೆ ನೆಮ್ಶೊ. <verse eid="DAN 6:1" /><verse number="2" style="v" sid="DAN 6:2" />ರಾಜಾ಼ನೆ ನುಕ್ಸಾನ ಥಾಯೆ ನೈಸೊ ತೆ ದೆಶಾದಿಪತಿಯೊನಾ ಉಪ್ಪರ ತ್ಯುನೊಕ್ಹು ಹಿಸಾಬ ಲಿವಾಲಾ ತನ್ನ ಕ್ಹಾಸ ಅದಿಕಾರಿಯೊನೆ ನೆಮ್ಸು ಕೈನ ಇರಾದೊ ಕರಿ ಲಿದ್ಯೊ; ತೆ ಕ್ಹಾರ ಅದಿಕಾರಿಯೊಮಾ ದಾನಿಯಲಬಿ ಯಕ್ಲೊ ವ್ಹೈ. <verse eid="DAN 6:2" /><verse number="3" style="v" sid="DAN 6:3" />ಎ ದಾನಿಯಲಮಾ ಘನ್ನಿ ಗ್ಯಾನ ರ‍್ಹಯಲಕ್ಹು ತಿನಾ ಉಗ್ರಲ ಬಿಜಾ಼ ಅದಿಕಾರಿಯೊತಿಬಿ ದೆಶಾದಿಪತಿಯೊತಿಬಿ ಘನ್ನೊ ಯೊಗ್ಯ ಮನಕ್ಹ ವ್ಹೈ ಕೈನ ಕವೈ ಲಿದ್ಯೊತೊ; ತಿನೆ ರಾಜೊ಼ ಪುರಾ ರಾಜ್ಯನಾ ಉಪ್ಪರ ನೆಮಕ ಕರಾನೆ ವಿಚಾರ ಕರ‍್ಯೊ. <verse eid="DAN 6:3" /><verse number="4" style="v" sid="DAN 6:4" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಕ್ಹಾಸ ಅದಿಕಾರಿಯೊಬಿ ದೆಶಾದಿಪತಿಯೊಬಿ ರಾಜ್ಯ ಭಾರನಾಹುತಿ ದಾನಿಯಲನಾ ಉಪ್ಪರ ತಪ್ಪ ಘಾಲಾನೆ ಟೈಮ ದೆಕಾಡಾತಾ; ತೆನೈಸೊ ತಪ್ಪಮಾ ಘಾಲಾನೊ ಕಯೊ ಟೈಮಜ಼ ಕಯೊ ತಪ್ಪಜ಼ ದೆಕ್ಯಾ ಬಗರ ಥಯು; ತೆ ಬರೊಕ್ಹಾವಾಲೊ ಥಯೊತೊ, ತಿನಾಮಾ ಅಲಸ ರ‍್ಹವಾನೆದೆ, ಮೊಸ ರ‍್ಹವಾನೆದೆ ಮಳ್ಯು ನೈ. <verse eid="DAN 6:4" /><verse number="5" style="v" sid="DAN 6:5" />ತೆಳಾಮಾ ಮನಕ್ಹೊ ದಾನಿಯಲ್ಪರ ತಪ್ಪ ಘಾಲಾನಾ ಹುತಿ ಎ ಕ್ಹುದಾನಾ ಧರ್ಮನಾ ಮುಲಕ ಯಕ್ಕಜ಼ಮಾ ವರಿ ಶಾಮಾಜ಼ ಮನೆ ಮೌಕೊ ಮಳತೊ ನೈ. <verse eid="DAN 6:5" /><verse number="6" style="v" sid="DAN 6:6" />ಇಮ್ಮ ಕಾಸ ಅದಿಕಾರಿಯೊ ದೆಶಾದಿಪತಿಯೊ ರಾಜಾ಼ನಾ ಕ್ಹಾಮಾ ಮಳಿನ ಐನ ತಿನೆ ರಾಜಾ಼ ದಾರಯಾವೆಶ, ಹಮೆಶಾಬಿ ಜಿವ್ತೊ ರ‍್ಹೆ! <verse eid="DAN 6:6" /><verse number="7" style="v" sid="DAN 6:7" />ಕಯೊಬಿ ಮುವತ್ತ ದಿನ್ನಲಕ್ಕಾ ರಾಜೊ಼ ಥಯಲ ತುನೆ ಯಕ್ಕಜ಼ ಛೊಡಿನ ಬಿಜಾ಼ ಕಯಾಜ಼ ದಿವಸ್ತಾನನೆ ಮನಕ್ಹನಿ ರ‍್ಹವಾದೆ ಮಾಂಗಿಲಿದ್ಯಾಮ ತಿನೆ ಸಿಂಯ್ಯಾನಿ ಗವಿಯೊಮಾ ಘಾಲು ಕೈನ ರಾಜ್ಯನಿ ಆಗನ್ಯಾನಿಂಗತ ಕರು ಕೈನ <verse eid="DAN 6:7" /><verse number="8" style="v" sid="DAN 6:8" />ರಾಜಾ಼ ತು ಹಮ್ನಾ ಆ ನಿಯಮೊ ಎ ಬದ್ಲಿ ಥೌ ನೈಸೊ ಮಿದ್ಯೆ ವರಿ ಪಾರ್ಸಿವಾಲಾ ಫೈಸಲಾನಾ ವರಕ್ಹು ಬಿಜು ಥಾಯೆ ನೈಸೊ ಫೈಸಲೊ ಕರಿನ ತು ಲಿಕ್ಕಲನೆ ಸೈ ಕರ ಕದ್ಯೊ. <verse eid="DAN 6:8" /><verse number="9" style="v" sid="DAN 6:9" />ತಿನಾಹುತಿ ದಾರ್ವೆಷ ಲಿಕ್ಕಲನೆ ತಿನಾ ಪೈಸಲಾನೆ ಸೈ ಕರ್ಯೊ. <verse eid="DAN 6:9" /><verse number="10" style="v" sid="DAN 6:10" />ತು ಲಿಕ್ಕಲನೆ ಕೆಳಾಮಾ ಸೈ ಕರ್ಯೊಸ ಕೈನ ದಾನಿಯಲನೆ ಗೊತ್ತ ಥಯುತು ತೆಳಾಮಾ ತಿನಾ ಘರೆ ಗಯೊ ತಿನಾ ಘರನಿ ಖಿಡಕಿಯೊ ಯರುಸಲೆಮನಾ ಕ್ಹಾಮಾಜ ಕ್ಹುಲ್ಲಾ ವ್ಹತ್ತಯೊ ತೆ ಪೈಲಾ ಕರ್ತೊ ರ‍್ಹಯಲ ನಿಂಗತ ಯಕ್ಕ ದಿನಮಾ ತನ್ನಸಲಾ ಗುಡ್ಗಾ ನೆಟಿನ ಕ್ಹುದಾನಿ ಸನ್ನಿದಿಮಾ ಪ್ರಾಥನಾ ಸ್ತೊತ್ರಾ ಕರ್ತೊತೊ. <verse eid="DAN 6:10" /><verse number="11" style="v" sid="DAN 6:11" />ತೆ ಥಯಲ್ಪರ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಕುಡಿನ ದಾನಿಯಲ ಕ್ಹುದಾನಿ ಸನ್ನಿದಿಮಾ ಪ್ರಾಥನಾ ಕರಾನು ದೆಕ್ಯಾ <verse eid="DAN 6:11" /><verse number="12" style="v" sid="DAN 6:12" />ತೆಳಾಮಾ ತ್ಯುನೆ ರಾಜಾ಼ಕನ ಐನ ತಿನಿ ಆಗನ್ಯಾನಾಹುತಿ ಬೊಲ್ತಾ ಎ ರಾಜಾ಼ ಕುನಬಿ ಮೂವತ್ತ ದಿನಲಕ್ಕಾ ತುನೆ ಛೊಡಿನ ಬಿಜಾ ಕಯಾಜ಼ ಕ್ಹುದಾನೆ ಮನಕ್ಹೊನೆ ರ‍್ಹವಾದೆ ಆರಾದನಾ ಕರಾಲಾ ಸಿಂಹಾನಿ ಗವಿಮಾ ಘಲೌಕೈನ ಫೈಸಲಾನೆ ತು ಸೈ ಕರ್ಯೊ ನತ್ತಿಸು ಕದ್ಯಾ ತೆ ವಾತೆ ರಾಜೊ಼ ಮಿಥಿಯೊ ಪಾರ್ಸಿಯೊ ನೈ ಬದಲ ನಿಂಗತ ನ್ಯಾಯ ಪ್ರಮಾಣ ನಿಂಗತ ಕ್ಹರಿಜ಼ ವ್ಹೈ ಕದ್ಯೊ. <verse eid="DAN 6:12" /><verse number="13" style="v" sid="DAN 6:13" />ತೆಳಾಮಾ ತ್ಯುನೆ ತೆ ವಾತೆ ರಾಜಾ಼ನಾ ಕ್ಹಾಮಾ ಯಹುದಿನಾ ಬಚ್ಚಾವೊನೆ ಧರಿ ಲಾಯಲಮಾ ಯಕ್ಲೊ ಥಯಲ ತೆ ದಾನಿಯಲ ರಾಜೊ಼ ಥಯಲ ತುನೆತಬಿ ವರಿ ತು ಲಿಕ್ಕಲ ಸೈನೆ ಧ್ಯಾನ ದಿದ್ಯಾವಾಚಿ ದಿನ್ನೆ ತನ್ನಸಲಾ ಪ್ರಾಥನಾ ಕರಾಡೊಸ. <verse eid="DAN 6:13" /><verse number="14" style="v" sid="DAN 6:14" />ರಾಜೊ಼ ಎವಾತೊ ಕೆಳಾಮಾ ಐಕ್ಯೊ ತಿನಾಕ್ಹು ತೆಜ ಬೆಜಾರ ಥೈನ ಕ್ಹಾಂಜ಼ ಥೈಯೆಲಕ್ಕಾ ಎ ಕ್ಹಾರು ಇಕ್ಹರು ಕೈನ ಕೊಶಿಸ ಕರ್ಯೊ <verse eid="DAN 6:14" /><verse number="15" style="v" sid="DAN 6:15" />ತೆಳಾಮಾ ತೆ ಮನಕ್ಹೊ ಮಳಿನ ರಾಜಾ಼ಕನ ಐನ ಎ ರಾಜಾ಼ ತುದಿದಲ ಫೈಸಲೊ ಅಗನ್ಯಾಬದ್ಲಿ ಥೌನೈಕೈನ ಮಿದ್ಯೆವಾಲಾ ವರಿ ಪಾರ್ಸಿಯೊ ತು ಲಿಕ್ಕಲಮಾ ಛೆಕೈನ ತುನೆ ಗೊತ್ತ ರ‍್ಹವಾದೆ <verse eid="DAN 6:15" /><verse number="16" style="v" sid="DAN 6:16" />ತೆಳಾಮಾ ತೆ ಮನಕ್ಹೊ ಮಳಿನ ರಾಜಾ಼ಕನ ಐನ ಎ ರಾಜಾ಼ ತುದಿದಲ ಫೈಸಲೊ ಅಗನ್ಯಾಬದ್ಲಿ ಥೌನೈಕೈನ ಮಿದ್ಯೆವಾಲಾ ವರಿ ಪಾರ್ಸಿಯೊ ತು ಲಿಕ್ಕಲಮಾ ಛೆಕೈನ ತುನೆ ಗೊತ್ತ ರ‍್ಹವಾದೆ <verse eid="DAN 6:16" /><verse number="17" style="v" sid="DAN 6:17" />ತೆಳಾಮಾ ತ್ಯುನೆ ರಾಜಾ಼ಕನ ಐನ ತಿನಿ ಆಗನ್ಯಾನಾಹುತಿ ಬೊಲ್ತಾ ಎ ರಾಜಾ಼ ಕುನಬಿ ಮೂವತ್ತ ದಿನಲಕ್ಕಾ ತುನೆ ಛೊಡಿನ ಬಿಜಾ ಕಯಾಜ಼ ಕ್ಹುದಾನೆ ಮನಕ್ಹೊನೆ ರ‍್ಹವಾದೆ ಆರಾದನಾ <verse eid="DAN 6:17" /><verse number="18" style="v" sid="DAN 6:18" />ರಾಜೊ಼ ಎವಾತೊ ಕೆಳಾಮಾ ಐಕ್ಯೊ ತಿನಾಕ್ಹು ತೆಜ ಬೆಜಾರ ಥೈನ ಕ್ಹಾಂಜ಼ ಥೈಯೆಲಕ್ಕಾ ಎ ಕ್ಹಾರು ಇಕ್ಹರು ಕೈನ ಕೊಶಿಸ ಕರ್ಯೊ <verse eid="DAN 6:18" /><verse number="19" style="v" sid="DAN 6:19" />ಜೊ಼ ಎವಾತೊ ಕೆಳಾಮಾ ಐಕ್ಯೊ ತಿನಾಕ್ಹು ತೆಜ ಬೆಜಾರ ಥೈನ ಕ್ಹಾಂಜ಼ ಥೈ <verse eid="DAN 6:19" /><verse number="20" style="v" sid="DAN 6:20" />ತೆಳಾಮಾ ತೆ ಮನಕ್ಹೊ ಮಳಿನ ರಾಜಾ಼ಕನ ಐನ ಎ ರಾಜಾ಼ ತುದಿದಲ ಫೈಸಲೊ ಅಗನ್ಯಾಬದ್ಲಿ ಥೌನೈಕೈನ ಮಿದ್ಯೆವಾಲಾ ವರಿ ಪಾರ್ಸಿಯೊ ತು ಲಿಕ್ಕಲಮಾ ಛೆಕೈನ ತುನೆ ಗೊತ್ತ ರ‍್ಹವಾದೆ <verse eid="DAN 6:20" /><verse number="21" style="v" sid="DAN 6:21" />ತೆಳಾಮಾ ತೆ ಮನಕ್ಹೊ ಮಳಿನ ರಾಜಾ಼ಕನ ಐನ ಎ ರಾಜಾ಼ ತುದಿದಲ ಫೈಸಲೊ ಅಗನ್ಯಾಬದ್ಲಿ ಥೌನೈಕೈನ ಮಿದ್ಯೆವಾಲಾ ವರಿ ಪಾರ್ಸಿಯೊ ತು ಲಿಕ್ಕಲಮಾ ಛೆಕೈನ ತುನೆ ಗೊತ್ತ ರ‍್ಹವಾದೆ <verse eid="DAN 6:21" /><verse number="22" style="v" sid="DAN 6:22" />ಮಾರೊ ಕ್ಹುದಾ ತಿನಾ ದುತನೆ ಮೊಕ್ಲಿನ, ಸಿಂಯ್ಯಾನಾ ಮ್ಹೊಡಾ ಭಾಂದ್ಯೊ. ತ್ಯಹುನೊಕ್ಹು ಸುಜ ಹಾನಿ ಥಯು ನೈ ಕಾ ಕದ್ಯಾಮ ತೆ ಕ್ಹುದಾನಿ ನಜರಮಾ ನಿರ್ಮಲ ವ್ಹತೊ ರಾಜೊ಼ ರ‍್ಹಯಲ ತುನೆ ಮಿ ಕಯುಜ ಮೊಸ ನತ್ತಿ ಕರ‍್ಯೊ ಕದ್ಯೊ. <verse eid="DAN 6:22" /><verse number="23" style="v" sid="DAN 6:23" />ರಾಜೊ಼ ಎ ಐಕಿನ ಘನ್ನೊ ಖುಶಿಥಯೊ ಎ ಐಕಿನ ದಾನಿಯಲನೆ ಗವಿಮಾತೊ ಉಪ್ಪರ ಉಚೈನ ಲಾವೊ ಕದ್ಯೊ. ತೆ ಕ್ಹುದಾಪರ ಘನ್ನೊ ಘಟ್ಟ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಲ ಹುತಿ ತಿನೆ ಸುಜ ಹಾನಿ ಥಯೊ ನ್ಹೊತು. <verse eid="DAN 6:23" /><verse number="24" style="v" sid="DAN 6:24" />ತೆ ಥಯಲ್ಪರ ರಾಜೊ಼ ಆಗನ್ಯಾ ದೆತಾಮಾ ದಾನಿಯಲ್ಪರ ಸುಳ್ಳ ಆಪಾದನೆ ಘಾಲಲವಾಲೊವೊನೆ ತ್ಯುನಾ ಘರ್ನಾ ಪುರಾ ಮನಕ್ಹೊನೆ ಸಿಂಯ್ಯಾನಿ ಗವಿಯೊಮಾ ಗಾಲಿಪಾಡ್ಯಾ. ತ್ಯುನೆ ಗವಿಮಾ ಪಡ್ತಾಮಾ ತ್ಯುನಾ ಉಪ್ಪರ ಸಿಂಯ್ಯಾ ಪಡಿನ ತ್ಯುನೊನೆ ಖೈಪಾಡ್ಯಾ. <verse eid="DAN 6:24" /><verse number="25" style="v" sid="DAN 6:25" />ಎ ಥಯಲ್ಪರ ದಾರ್ಯಾವೆಷನಿ ಜಗಾಪರ ರ‍್ಹವಾನೆಲಾ ಕ್ಹಾರಾ ದೆಶನಾ ಕುಲಾ ಭಾಶಾವಾಲಾವೊನೆ ಎ ಪ್ರಸಿದ್ದ ಪತ್ರ ಬರ್ದಾ ಲಗಾಡ್ಯೊ; ತುಮೊನೆ ಜಾಸ್ತಿ ಸುಖಾ ಶಾಂತಿ ಮಳಾದೆ!” <verse eid="DAN 6:25" /><verse number="26" style="v" sid="DAN 6:26" />ಮಾರಾ ರಾಜ್ಯನಾ ಮನಕ್ಹೊನೆ ಮಿ ಅಗನ್ಯಾ ದಿವಾನು ಸುವೈ ಕದ್ಯಾಮ ತುಮೆ ಕ್ಹಾರಾ ದಾನಿಯಲನಾ ಕ್ಹುದಾನಾ ಕ್ಹಾಮಾ ಭಯಭಕ್ತಿಮಾ ರ‍್ಹೌ ಕಾ ಕದ್ಯಾಮ ತೆಜ ಜಿವಸ್ವರುಪ ಥಯಲ ಸನಾತನನೊ ಕ್ಹುದಾ ವ್ಹೈ! ತಿನು ರಾಜ್ಯ ಕೆಳಾಮಾಜ ನುಚ್ಚಾತು ನೈ ತಿನಿ ಆಳ್ವಿಕೆ ಹಮೆಶಾಬಿ ರ‍್ಹವಸ. <verse eid="DAN 6:26" /><verse number="27" style="v" sid="DAN 6:27" />ತೆ ಉದ್ದಾರ ಕರಾಲೊ ವ್ಹೈ, ವಚಾಡಾಲೊ ವ್ಹೈ, ಭುಮಿ ಆಕಾಶಮಾ ಅದ್ಭುತ ಕರಾಲೊ ವ್ಹೈ! ತೆಜ ದಾನಿಯಲನೆ ಸಿಂಯ್ಯಾವೊನಾ ಮ್ಹೊಡಾವೊಮಾತೊ ವಚಾಡಲವಾಲೊ ವ್ಹೈ! <verse eid="DAN 6:27" /><verse number="28" style="v" sid="DAN 6:28" />ಇಮ್ಮ ಎ ದಾನಿಯಲ ದಾರ್ಯಾವೆಶನಿ ಆಳ್ವಿಕೆಮಾ ಪರ್ಷಿವಾಲೊ ಥಯಲ ಸೈರೆಶನ ಆಳ್ವಿಕೆಮಾ ಪ್ರವರ್ಧಕರ್ತೊ ಜಿವ್ನಾ ಕರ‍್ಯೊತೊ.<verse eid="DAN 6:28" /></para>
  <chapter eid="DAN 6" />
  <chapter number="7" style="c" sid="DAN 7" />
  <para style="s">ದಾನಿಯಲ ಚಾರ ಜಾ಼ನವರೊನೆ ದೆಕಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1" />ಪೈಲಾ ಮನೆ ದಿಕ್ಹಲ ಕ್ಹಪನ ನೈಸೊ ರಾಜೊ಼ ಥಯಲ ಬೆಲ್ಶಚ್ಚರನಾ ಆಳ್ವಿಕೆನಾ ತನ್ವಾ ವರಕ್ಹಮಾ ವರಿ ಯಕ್ಕ ಕ್ಹಪನ ದಾನಿಯಲ ಥಯಲ ಮನೆ ಪಡ್ಯು. <verse eid="DAN 7:1" /><verse number="2" style="v" sid="DAN 7:2" />ಮಿ ದೆಕಲ ಕ್ಹಪನಮಾ ಎಲಾಮ ಸಂಸ್ಥನನಾ ಶುಷನ ಕೊಟೆಮಾ ವ್ಹತ್ತೊ; ಕ್ಹಪನಮಾ ಉಲಾ ಕಾಲುವೆನಾ ದಂಡಿನಾ ಉಪ್ಪರ ಹುಬ್ರಯಲ ನಿಂಗತ ದಿಕ್ಯು. <verse eid="DAN 7:2" /><verse number="3" style="v" sid="DAN 7:3" />ಮಿ ಡೊಳಾ ಉಚೈನ ದೆಕ್ತಾಮಾ, ಬೆ ಶಿಂಗ್ಡಾವೊನು ಯಕ್ಕ ಟಗರ ಕಾಲುವೆನಾ ಬಾಜು಼ಮಾ ಹುಬ್ರಯುತು; ತಿನಾ ಬೆ ಶಿಂಗ್ಡಾ ಲಾಂಬಾ ರ‍್ಹಯಾತಬಿ ಯಕ್ಕತಿ ಯಕ್ಕ ಮ್ಹೊಟಾ ವ್ಹೈ, ತೆ ಮ್ಹೊಟು ಶಿಂಗ್ಡು ನ್ಹಾನು ಶಿಂಗ್ಡು ಹುಟ್ಟಿನ ಆಯಲ್ಪರ ಹುಟ್ಟಿನ ಆಯಲ ವ್ಹೈ. <verse eid="DAN 7:3" /><verse number="4" style="v" sid="DAN 7:4" />ಮಿ ದೆಕ್ತೊ ರ‍್ಹತಾಮಾ ತೆ ಟಗರ ಪಚ್ಚಿಮ ದಿಕ್ಕೆಬಿ, ಉತ್ತರ ದಿಕ್ಕೆಬಿ, ದಕ್ಷಿಣ ದಿಕ್ಕೆಬಿ ಫರಾಡುತು; ಕಯುಜ಼ ಜಿವಜಂತ ತಿನಾ ಕ್ಹಾಮು ಹುಬ್ರಯು ನೈ; ತಿನಾ ಹತ್ತತು ಛೊಡೈ ಲಿವಾನೆ ಕಯಾಜ಼ ಜಾನವರನೆ ತಾಕತ ನ್ಹೊತು; ತೆ ಮನಸ ಆಯಲ ತಿಮ್ಮ ಚಾ಼ಲಿನ ತಿನೆ ತೆ ಹೆಚ್ಚ ಕರಿ ಲಿದ್ಯು. <verse eid="DAN 7:4" /><verse number="5" style="v" sid="DAN 7:5" />ಮಿ ದೆಕ್ತಾಮಾ, ಯಕ್ಕ ಬಕ್ರು ಪಚ್ಚಿಮ ದಿಕ್ಕತು ಭುಮಂಡಲ ಕ್ಹಾರು ದಾಟಿನ ಜಿಮಿನನೆ ಮುಟ್ಯಾ ಬಗರ ನ್ಹಾಟಿನ ಐಯು; ತಿನಾ ಡೊಳಾನಾ ವಚ್ಮಾ ಕ್ಹಾಸ ರ‍್ಹಯಲ ಯಕ್ಕ ಶಿಂಗ್ಡೊ ವ್ಹತ್ತೊ. <verse eid="DAN 7:5" /><verse number="6" style="v" sid="DAN 7:6" />ಮಿ ಕಾಲುವೆನಾ ಬಾಜು಼ಮಾ ದೆಕಲ ಬೆ ಶಿಂಗ್ಡಾ ರ‍್ಹಯಲ ಟಗರಕನ ತೆ ಬಕ್ರು ಐಯು. ತಾಕತಕ್ಹು ಫುಗ್ಗಿನ ಶಿಟ್ಟ ಥೈನ ತಿನಾ ಉಪ್ಪರ ಪಡು ಕೈನ ನ್ಹಾಟ್ಯು. <verse eid="DAN 7:6" /><verse number="7" style="v" sid="DAN 7:7" />ತೆ ಮಾರಾ ಕ್ಹಪನಮಾ ಟಗರಕನ ಗೈನ ತಿನಾ ಉಪ್ಪರ ಶಿಟ್ಟಕ್ಹು ಬಳತು ತಿನೆ ಮಾರಿನ ತಿನಾ ಬೆ ಶಿಂಗ್ಡಾವೊನೆ ತೊಡಿ ಪಡ್ಯು; ತಿನಾ ಕ್ಹಾಮು ಹುಬ್ರ್ಯವಾನೆ ಟಗರನೆ ತಾಕತ ನ್ಹೊತಿ; ತೆ ಟಗರನೆ ಜಿಮಿನಪರ ಪಾಡಿನ ಕ್ಹುಂದ್ಯು; ಟಗರನೆ ತಿನಾ ಹತ್ತಕ್ಹು ಛೊಡಾವಾನೆ ಕಯುಜ಼ ಜಾನವರ ನ್ಹೊತು; <verse eid="DAN 7:7" /><verse number="8" style="v" sid="DAN 7:8" />ತೆ ಬಕ್ರು ತಿನೆ ತೆಜ಼ ಘನ್ನ ಹೆಚ್ಕಿ ಕರಿ ಲಿದ್ಯು, ತೆನೈಸೊ ತೆ ಅದಿಕಾರಮಾ ಆತಾಮಾಜ಼ ತಿನು ಮ್ಹೊಟೊ ಶಿಂಗ್ಡೊ ತುಟಿ ಗಯು; ತಿನಾ ಜ಼ಗಾಪರ ಚಾರ ಅದ್ಬುತ ರ‍್ಹಯಲ ಶಿಂಗ್ಡಾ ಚಾರೆ ದಿಕ್ಕೆ ಫೈಲ್ಯಾ.<verse eid="DAN 7:8" /></para>
  <para style="s">ಹಮೆಶ್ಯಾ ಜಿವ್ತೊ ರ‍್ಹವಾನು ದರ್ಶನ</para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 7:9" />ತಿನಾಮಾ ಯಕ್ಕಮಾ ಯಕ್ಕ ನ್ಹಾನೊ ಶಿಂಗ್ಡೊ ಹುಟ್ಟಿನ ಘನ್ನಾ ಮ್ಹೊಟಾ ಥೈನ ಬೆಳದಿನ ದಕ್ಷಿಣ ದಿಕ್ಕೆಬಿ ಪುರ್ವ ದಿಕ್ಕಮಾಬಿ ಚೊ಼ಕಾ ದೆಶಮಾಬಿ ತಾಕತವರ ಥಯು. <verse eid="DAN 7:9" /><verse number="10" style="v" sid="DAN 7:10" />ತೆ ಚಿಕ್ಕಿಯೊನಾ ಗುಂಪನಾ ಉಪ್ಪರ ಹತ್ತ ಕರಾವರ್ಕ್ಹು ಜಾಸ್ತ ಥಯನ ತೆ ಗುಂಗನಾ ದಕ್ಹಾ ಚಿಕ್ಕಿಯೊನೆ ಜಿಮಿನಪರ ನಶ ಕರಿನ ಕ್ಹುಂದಿ ಪಡ್ಯು. <verse eid="DAN 7:10" /><verse number="11" style="v" sid="DAN 7:11" />ಎನೈಸೊ ತೆ ಗುಂಪನಾ ಅದಿಪತಿನೆ ಕ್ಹಾಮು ಹುಬ್ರ್ಯವಾರ್ಕ್ಹು ಫುಗ್ಗಿನ ಹಮೆಶಾನು ಹೊಮ ತಿನೆ ಥಯಾ ಬಗರ ಕರಿನ <verse eid="DAN 7:11" /><verse number="12" style="v" sid="DAN 7:12" />ತಿನು ಪವಿತ್ರ ಜ಼ಗಾನೆ ನಾಶ ಕರಿನ ಹಮೆಶಾನು ಹೊಮಾ ಹುಬ್ರಾಡಾನೆ ಕೆಟ್ಟತನಾಕ್ಹು ಯಕ್ಕ ಸೈನ್ಯನೆ ಹುಬ್ರಾಡಿನ ಸತ್ಯ ಧರ್ಮನೆ ಜಿಮಿನಪರ ಢಕ್ಲಿನ ತಿನಾ ಪಸಂದನೆ ಪುರಾ ಕರಿಲೆತು ಮ್ಹೊಟು ಥಾತು ಐಯು. <verse eid="DAN 7:12" /><verse number="13" style="v" sid="DAN 7:13" />ತೆಳಾಮಾ ಯಕ್ಕ ದೆವದುತ ಬೊಲಾನು ಐಕ್ಯೊ; ಬೊಲಾಲಾನೆ ವರಿಯಕ್ಕ ದೆವದುತ ಬೊಲಿನ- ಹಮೆಶಾನು ಹೊಮಾ ಹುಬ್ರಡಾನು, ಭಯಾನಕ ಥಯಲ ಕ್ಹುದಾನೆ ದ್ರೊಹ ಕರಾನು, ಪವಿತ್ರ ಆಲಯನೆ ಕ್ಹುದಾನಾ ಭಕ್ತೊನಾ ಗುಂಪನೆ ಕ್ಹುಂದಾನು ಕವಾನು ಕ್ಹಪನನಾ ಕಾಮೊ ಕಕ್ಲಾ ದಿನ್ನ ಥಾವಸ ಕೈನ ಸವಾಲ ಕರಾಕ್ಹು <verse eid="DAN 7:13" /><verse number="14" style="v" sid="DAN 7:14" />ತೆ ತಿನೆ - ದಿನ್ನ ರಾತನಾಹುತಿ ಬೆ ಹಜಾ಼ರ ತನ್ನ ಕ್ಹೊ ಲಕ್ಕಾ ಚಾ಼ಲಸ; ಪಾಚ಼ಲ್ತು ಪವಿತ್ರ ಆಯಲನೆ ವರಿ ನ್ಯಾಯ ಸ್ಥಾಪನೆ ಥಾವಸ ಕೈನ ಕದ್ಯೊ.<verse eid="DAN 7:14" /></para>
  <para style="s">ಕ್ಹಪನಮಾ ಆಯಲ ದರ್ಶನೆ ತಿಳ್ಸಾಯಲ</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15" />ದಾನಿಯಲ ಥಯಲ ಮಿ ಕ್ಹಪನನೆ ದೆಕಿನ ತಿನೆ ತಿಳ್ದಿಲಿವಾನೆ ಕೊಶಿಶ ಕರ್ತಾಮಾ, ನೈ ದಿಕ್ಹಾನು ಮನಕ್ಹ ಯಕ್ಕ ಮಾರಾ ಕ್ಹಾಮೊ ಹುಬ್ರಯೊತೊ. <verse eid="DAN 7:15" /><verse number="16" style="v" sid="DAN 7:16" />ತೆಳಾಮಾ ಗಬ್ರಿಯಲ, ಕ್ಹಪನನು ಮತ್ಲಬ ಅನೆ ತಿಳ್ಸಾ ಕೈನ ಮನಕ್ಹನಿ ಅವಾಜ಼ ನಿಂಗತ ಯಕ್ಕ ಅವಾಜ಼ ಊಲಾ ಕಾಲುವೆನಾ ದಂಡಿನಾ ವಚ್ಮಾ ಮನೆ ಐಕು ಐಯು. <verse eid="DAN 7:16" /><verse number="17" style="v" sid="DAN 7:17" />ತಿನಾ ನಿಂಗತ ತೆ ಮಕನ ಆಯೊ; ತೆ ಆತಾಮಾ ಮಿ ಭೆಂಕ್ಹು ಘಾಬ್ರೊ ಥೈನ ಅಡ್ಡ ಪಡ್ಯೊ; ಮನೆ ತೆ- ಮನಕ್ಹನಾ ದಿಕ್ರಾ,ಆಂ ತುನೆ ಶೆಂ <verse eid="DAN 7:17" /><verse number="18" style="v" sid="DAN 7:18" />ತೆನೈಸೊ ರಾಜ್ಯ ಸರ್ವಶಕ್ತ ಥಯಲ ಕ್ಹುದಾನಾ ಭಕ್ತೊನೆ ಮಳಾನು ತೆ ತ್ಯುನೊನೆ ಹಮೆಶಾಬಿ ಅನಭವ ಕರಸ. <verse eid="DAN 7:18" /><verse number="19" style="v" sid="DAN 7:19" />ತೆಳಾಮಾ ಮಿ ಚಾರವಾ ಜಾನವರನಾಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ಮನಸ ಕರ್ಯೊ. ತೆ ಬಿಜಾ ಜಾನವರೊತಿ ಬಿಜುಜ ವ್ಹತ್ತು. ಎ ಘನ್ನು ಖತರನಾಕ ವ್ಹತ್ತು ತಿನಾ ಲ್ಹೊಡಾನಾ ದಾತೊ ಕ್ಹಾರುಜ಼ ತುಕ್ಡಾ ತುಕ್ಡಾ ಕರಸ. ಉಗ್ರಲಕ್ಹಾರು ಕ್ಹುಂದಿನ ಛೆಟಿ ಪಡಸ. <verse eid="DAN 7:19" /><verse number="20" style="v" sid="DAN 7:20" />ತಿನಾ ಮಾತಾಪರ ರ‍್ಹಯಲ ದಕ್ಹ ಶಿಂಗ್ಡಾ ವರಿ ಉಪ್ಪರ ಆವಾನು ತನ್ನ ಶಿಂಗ್ಡಾ ವ್ಹತ್ತಾ. ತಿನೆ ಡೊಳಾ ವರಿ ಮ್ಹೊಡು ವ್ಹತ್ತು. ವರಿ ಸೊಕ್ಕ ಕರಲಿವಾಡುತು. ತೆ ಪೈಲಾನಾ ಜಾನವರತಿಬಿ ಘನು ಖತರನಾಕ ವ್ಹತ್ತು. <verse eid="DAN 7:20" /><verse number="21" style="v" sid="DAN 7:21" />ಮಿ ದೆಕ್ತಾಮಾ ತೆ ಶಿಂಗ್ಡು ಕ್ಹುದಾನಾ ಭಕ್ತೊನೆ ಯುದ್ದ ಕರಿನ ತ್ಯುನೊನೆ ಬಂದಿ ಕರಲಿದ್ಯುತು. <verse eid="DAN 7:21" /><verse number="22" style="v" sid="DAN 7:22" />ತೆಳಾಮಾ ಹಮೆಶಾಬಿ ಜ್ಯುತೊ ರ‍್ಹವಾಲೊ ಥೈನ ಯಕ್ಲೊ ಆಯೊ.ಸರ್ವಶಕ್ತ ಥಯಲ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನಾಹುತಿ ನ್ಯಾಯ ತಿರ್ಪ ಹೊರಡಿಸ್ಯೊ. ತೆಳಾಮಾ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊ ವಪಸೈನ ದಿದ್ಯೊ. <verse eid="DAN 7:22" /><verse number="23" style="v" sid="DAN 7:23" />ತೆಳಾಮಾ ತೆ ಚಾರವಾ ಜಾನರನಾಹುತಿ ಕೌ ಕದ್ಯಾಮ ದುನಿಯಾಪರ ಚಾರವಾ ಹುಕುಮನು ರಾಜ್ಯ ಆವಸ.ಎ ಉಗ್ರಲ ಕ್ಹಾರಾ ರಾಜ್ಯಾವೊತಿ ಬಿಜು಼ಜ಼ ರ‍್ಹವಸ ತೆ ಪೂರಾ ದುನಿಯಾನೆ ನಾಶ ಕರಸ. ತೆ ಕ್ಹುಂದಿನ ಪುಡಿಪುಡಿ ಕರಸ. <verse eid="DAN 7:23" /><verse number="24" style="v" sid="DAN 7:24" />ದಕ್ಹಾ ಶಿಂಗ್ಡಾ ಕದ್ಯಾರೆ ಆಂ ರಾಜ್ಯಾವೊಮಾ ದಕ್ಹಾ ರಾಜಾ಼ ಉಟಸ.ವರಿ ತೆ ಥಯಲ್ಪರ ಹಜಿಯಕ್ಲೊ ಆವಸ.ತೆ ರಾಜೊ಼ ತೆ ಉಗ್ರಲ ರಾಜಾ಼ವೊತಿ ಬಿಜ಼ೊಜ಼ ಥಯಲ ರ‍್ಹವಸ. ತೆ ತನ್ನ ರಾಜಾ಼ವೊನೆ ಹರಾಡಸ. <verse eid="DAN 7:24" /><verse number="25" style="v" sid="DAN 7:25" />ತೆ ಘನೊ ಉನ್ನತ ರ‍್ಹಯಲವಾಲಾನಾ ವಿರುದ್ದ ಬೊಲಸ. ವರಿ ತಿನಾ ಮನಕ್ಹೊನೆ ಭಾರೊ ಢಕ್ಲಸ. ಟೈಮ ವರಿ ನಿಯಮೊ ಬದ್ಲಿ ಕರಾನೆ ವಿಚಾರ ಕರಸ.ತೆ ತಿನಾ ಹತ್ಮಾ ದಿವಾ ವರಕ್ಹು ಥಾವಸ. ಯಕ್ಕ ಕಾಲ ಅರ್ದೊಕಾಲ ವರಿ ಕಾಲೊ ತ್ಯಾಲಕ್ಕಾ ತ್ಯುನೆ ಕ್ಹುದಾನೆ ದಿವಸ. <verse eid="DAN 7:25" /><verse number="26" style="v" sid="DAN 7:26" />ತೆಳಾಮಾ ಪರಲೊಕನಾ ಫೈಸಲಾನಾ ಸಭೆಮಾ ಫೈಸನಾಹುತಿ ಬೈಟಸ. ವರಿ ತಿನಿ ರ‍್ಹಯಲ ಅದಿಕಾರ ಕಾಳ್ಳಿವಸ. ಘನ್ನಿ ಕಿಳತನಾಕ್ಹು ನಾಶ ಕರಸ <verse eid="DAN 7:26" /><verse number="27" style="v" sid="DAN 7:27" />ಇಮ್ಮ ರಾಜ್ಯಭಾರ ವರಿ ಮ್ಹೊಟಿತನಾ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನಾ ಹತ್ಮಾ ವಪಸೈನ ದಿವಸ. ತಿನು ರಾಜ್ಯನು ಆಡಳಿತ ಅಂತ್ಯಜ಼ ರ‍್ಹತು ನೈ. ವರಿ ಕ್ಹಾರಾ ಆಡಳಿತೊ ತಿನೆ ವಿದೆಯೆ ಥೈನ ಸೆವೆ ಕರಸ. <verse eid="DAN 7:27" /><verse number="28" style="v" sid="DAN 7:28" />ಆಂ ಎ ವಿಶಮಾ ಲಾಸ್ಟ ವ್ಹೈ. ದಾನಿಯಲ ಥಯಲ ಮಿ ಘನೊ ಕಾಪಾ ವರಕ್ಹೊ ಕರಸ ಮಾರೊ ಕಲರ ಬದ್ಲಿ ಥಯೊ ತೆನೈಸೊ ತೆ ವಿಶಯ ಮಾರಾ ಮನಸಮಾ ಮ್ಹೆಲ್ಲಿದ್ಯೊ. ಬೆಲ್ಸಚ್ಚರ ಆಳ್ವಿಕಾನಾ ತನವಾ ವರಕ್ಹಮಾ ಬಿಜೆಕ ಕ್ಹಪನ ದೆಕ್ಯೊ.<verse eid="DAN 7:28" /></para>
  <chapter eid="DAN 7" />
  <chapter number="8" style="c" sid="DAN 8" />
  <para style="s">ದಾನಿಯಲನಾ ದರ್ಶನಮಾ ಟಗರ ವರಿ ಬಕ್ರು</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1" />ಪೈಲಾ ಮನೆ ದಿಕ್ಹಲ ಕ್ಹಪನ ನೈಸೊ ರಾಜೊ಼ ಥಯಲ ಬೆಲ್ಶಚ್ಚರನಾ ಆಳ್ವಿಕೆನಾ ತನ್ವಾ ವರಕ್ಹಮಾ ವರಿ ಯಕ್ಕ ದರ್ಶನ ದಾನಿಯಲ ಥಯಲ ಮನೆ ಪಡ್ಯು. <verse eid="DAN 8:1" /><verse number="2" style="v" sid="DAN 8:2" />ಮಿ ದೆಕಲ ಕ್ಹಪನಮಾ ಎಲಾಮ ಸಂಸ್ಥನನಾ ಶುಷನ ಕೊಟೆಮಾ ವ್ಹತ್ತೊ; ಕ್ಹಪನಮಾ ಒಲಾ ಕಾಲುವೆನಾ ದಂಡಿನಾ ಉಪ್ಪರ ಹುಬ್ರಯಲ ನಿಂಗತ ದಿಕ್ಯು. <verse eid="DAN 8:2" /><verse number="3" style="v" sid="DAN 8:3" />ಮಿ ಡೊಳಾ ಉಚೈನ ದೆಕ್ತಾಮಾ, ಬೆ ಶಿಂಗ್ಡಾವೊನು ಯಕ್ಕ ಟಗರ ಕಾಲುವೆನಾ ಬಾಜು಼ಮಾ ಹುಬ್ರಯುತು; ತಿನಾ ಬೆ ಶಿಂಗ್ಡಾ ಲಾಂಬಾ ರ‍್ಹಯಾತಬಿ ಯಕ್ಕತಿ ಯಕ್ಕ ಮ್ಹೊಟಾ ವ್ಹೈ, ತೆ ಮ್ಹೊಟು ಶಿಂಗ್ಡು ನ್ಹಾನು ಶಿಂಗ್ಡು ಹುಟ್ಟಿನ ಆಯಲ್ಪರ ಹುಟ್ಟಿನ ಆಯಲ ವ್ಹೈ. <verse eid="DAN 8:3" /><verse number="4" style="v" sid="DAN 8:4" />ಮಿ ದೆಕ್ತೊ ರ‍್ಹತಾಮಾ ತೆ ಟಗರ ಪಚ್ಚಿಮ ದಿಕ್ಕೆಬಿ, ಉತ್ತರ ದಿಕ್ಕೆಬಿ, ದಕ್ಷಿಣ ದಿಕ್ಕೆಬಿ ಫರಾಡುತು; ಕಯುಜ಼ ಜಾನವರೊ ತಿನಾ ಕ್ಹಾಮು ಹುಬ್ರಯು ನೈ; ತಿನಾ ಹತ್ತತು ಛೊಡೈ ಲಿವಾನೆ ಕಯಾಜ಼ ಜಾನವರನೆ ತಾಕತ ನ್ಹೊತು; ತೆ ಮನಸ ಆಯಲ ತಿಮ್ಮ ಚಾ಼ಲಿನ ತಿನೆ ತೆ ಹೆಚ್ಚ ಕರಿ ಲಿದ್ಯು. <verse eid="DAN 8:4" /><verse number="5" style="v" sid="DAN 8:5" />ಮಿ ದೆಕ್ತಾಮಾ, ಯಕ್ಕ ಬಕ್ರು ಪಚ್ಚಿಮ ದಿಕ್ಕತು ಭುಮಂಡಲ ಕ್ಹಾರು ದಾಟಿನ ಜಿಮಿನನೆ ಮುಟ್ಯಾ ಬಗರ ನ್ಹಾಟಿನ ಐಯು; ತಿನಾ ಡೊಳಾನಾ ವಚ್ಮಾ ಕ್ಹಾಸ ರ‍್ಹಯಲ ಯಕ್ಕ ಶಿಂಗ್ಡೊ ವ್ಹತ್ತೊ. <verse eid="DAN 8:5" /><verse number="6" style="v" sid="DAN 8:6" />ಮಿ ಕಾಲುವೆನಾ ಬಾಜು಼ಮಾ ದೆಕಲ ಬೆ ಶಿಂಗ್ಡಾ ರ‍್ಹಯಲ ಟಗರಕನ ತೆ ಬಕ್ರು ಐಯು. ತಾಕತಕ್ಹು ಫುಗ್ಗಿನ ಶಿಟ್ಟ ಥೈನ ತಿನಾ ಉಪ್ಪರ ಪಡು ಕೈನ ನ್ಹಾಟ್ಯು. <verse eid="DAN 8:6" /><verse number="7" style="v" sid="DAN 8:7" />ತೆ ಮಾರಾ ಕ್ಹಪನಮಾ ಟಗರಕನ ಗೈನ ತಿನಾ ಉಪ್ಪರ ಶಿಟ್ಟಕ್ಹು ಬಳತು ತಿನೆ ಮಾರಿನ ತಿನಾ ಬೆ ಶಿಂಗ್ಡಾವೊನೆ ತೊಡಿ ಪಡ್ಯು; ತಿನಾ ಕ್ಹಾಮು ಹುಬ್ರ್ಯವಾನೆ ಟಗರನೆ ತಾಕತ ನ್ಹೊತಿ; ತೆ ಟಗರನೆ ಜಿಮಿನಪರ ಪಾಡಿನ ಕ್ಹುಂದ್ಯು; ಟಗರನೆ ತಿನಾ ಹತ್ತಕ್ಹು ಛೊಡಾವಾನೆ ಕುನ್ನಜ಼ ನ್ಹೊತು; <verse eid="DAN 8:7" /><verse number="8" style="v" sid="DAN 8:8" />ತೆ ಬಕ್ರು ತಿನೆ ತೆಜ಼ ಘನ್ನ ಹೆಚ್ಕಿ ಕರಿ ಲಿದ್ಯು, ತೆನೈಸೊ ತೆ ಅದಿಕಾರಮಾ ಆತಾಮಾಜ಼ ತಿನು ಮ್ಹೊಟೊ ಶಿಂಗ್ಡೊ ತುಟಿ ಗಯು; ತಿನಾ ಜ಼ಗಾಪರ ಚಾರ ಅದ್ಬುತ ರ‍್ಹಯಲ ಶಿಂಗ್ಡಾ ಚಾರೆ ದಿಕ್ಕೆ ಫೈಲ್ಯಾ. <verse eid="DAN 8:8" /><verse number="9" style="v" sid="DAN 8:9" />ತಿನಾಮಾ ಯಕ್ಕಮಾ ಯಕ್ಕ ನ್ಹಾನೊ ಶಿಂಗ್ಡೊ ಹುಟ್ಟಿನ ಘನ್ನಾ ಮ್ಹೊಟಾ ಥೈನ ಬೆಳದಿನ ದಕ್ಷಿಣ ದಿಕ್ಕೆಬಿ ಪುರ್ವ ದಿಕ್ಕಮಾಬಿ ಚೊ಼ಕಾ ದೆಶಮಾಬಿ ತಾಕತವರ ಥಯು. <verse eid="DAN 8:9" /><verse number="10" style="v" sid="DAN 8:10" />ತೆ ಚಿಕ್ಕಿಯೊನಾ ಗುಂಪನಾ ಉಪ್ಪರ ಹತ್ತ ಕರಾವರ್ಕ್ಹು ಜಾಸ್ತ ಥಯನ ತೆ ಗುಂಗನಾ ದಕ್ಹಾ ಚಿಕ್ಕಿಯೊನೆ ಜಿಮಿನಪರ ನಶ ಕರಿನ ಕ್ಹುಂದಿ ಪಡ್ಯು. <verse eid="DAN 8:10" /><verse number="11" style="v" sid="DAN 8:11" />ಎನೈಸೊ ತೆ ಗುಂಪನಾ ಅದಿಪತಿನೆ ಕ್ಹಾಮು ಹುಬ್ರ್ಯವಾರ್ಕ್ಹು ಫುಗ್ಗಿನ ಹಮೆಶಾನು ಹೊಮ ತಿನೆ ಥಯಾ ಬಗರ ಕರಿನ <verse eid="DAN 8:11" /><verse number="12" style="v" sid="DAN 8:12" />ತಿನು ಪವಿತ್ರ ಜ಼ಗಾನೆ ನಾಶ ಕರಿನ ಹಮೆಶಾನು ಹೊಮಾ ಹುಬ್ರಾಡಾನೆ ಕೆಟ್ಟತನಾಕ್ಹು ಯಕ್ಕ ಸೈನ್ಯನೆ ಹುಬ್ರಾಡಿನ ಸತ್ಯ ನಿತಿನೆ ಜಿಮಿನಪರ ಢಕ್ಲಿನ ತಿನಾ ಪಸಂದನೆ ಪುರಾ ಕರಿಲೆತು ಮ್ಹೊಟು ಥಾತು ಐಯು. <verse eid="DAN 8:12" /><verse number="13" style="v" sid="DAN 8:13" />ತೆಳಾಮಾ ಯಕ್ಕ ದೆವದುತ ಬೊಲಾನು ಐಕ್ಯೊ; ಬೊಲಾಲಾನೆ ವರಿಯಕ್ಕ ದೆವದುತ ಬೊಲಿನ- ಹಮೆಶಾನು ಹೊಮಾ ಹುಬ್ರಡಾನು, ಭಯಾನಕ ಥಯಲ ಕ್ಹುದಾನೆ ದ್ರೊಹ ಕರಾನು, ಪವಿತ್ರ ಆಲಯನೆ ಕ್ಹುದಾನಾ ಭಕ್ತೊನಾ ಗುಂಪನೆ ಕ್ಹುಂದಾನು ಕವಾನು ಕ್ಹಪನನಾ ಕಾಮೊ ಕಕ್ಲಾ ದಿನ್ನ ಥಾವಸ ಕೈನ ಸವಾಲ ಕರಾಕ್ಹು <verse eid="DAN 8:13" /><verse number="14" style="v" sid="DAN 8:14" />ತೆ ತಿನೆ - ದಿನ್ನ ರಾತನಾಹುತಿ ಬೆ ಹಜಾ಼ರ ತನ್ನ ಕ್ಹೊ ಲಕ್ಕಾ ಚಾ಼ಲಸ; ಪಾಚ಼ಲ್ತು ಪವಿತ್ರ ಆಯಲಮಾ ಬಲಿ ದಿವಾನು ಥಾತು ನೈ. ವರಿ ನ್ಯಾಯ ಸ್ಥಾಪನೆ ಥಾವಸ ಕೈನ ಕದ್ಯೊ.<verse eid="DAN 8:14" /></para>
  <para style="s">ಗ್ಯಾಬ್ರಿಯೆಲ ದುತ ದರ್ಶನ ತಿಳಸಾಯಲ</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15" />ತೆಳಾಮಾ ದಾನಿಯಲ ಥಯಲ ಮಿ ಕ್ಹಪನನೆ ದೆಕಿನ ತಿನೆ ತಿಳ್ದಿಲಿವಾನೆ ಕೊಶಿಶ ಕರ್ತಾಮಾ, ನೈ ದಿಕ್ಹಾನು ಮನಕ್ಹ ಯಕ್ಕ ಮಾರಾ ಕ್ಹಾಮೊ ಹುಬ್ರಯೊತೊ. <verse eid="DAN 8:15" /><verse number="16" style="v" sid="DAN 8:16" />ತೆಳಾಮಾ ಗಬ್ರಿಯಲ, ದರ್ಶನ ಮತ್ಲಬ ಅನೆ ತಿಳ್ಸಾ ಕೈನ ಮನಕ್ಹನಿ ಅವಾಜ಼ ನಿಂಗತ ಯಕ್ಕ ಅವಾಜ಼ ಉಲಾ ನದಿನಿ ದಂಡಿನಾ ವಚ್ಮಾ ಮನೆ ಐಕು ಐಯು. <verse eid="DAN 8:16" /><verse number="17" style="v" sid="DAN 8:17" />ತಿನಾ ನಿಂಗತ ತೆ ಮಕನ ಆಯೊ; ತೆ ಆತಾಮಾ ಮಿ ಭೆಂಕ್ಹು ಘಾಬ್ರೊ ಥೈನ ಡಬ್ಬ ಪಡ್ಯೊ; ಮನೆ ತೆ- ಮನಕ್ಹನಾ ದಿಕ್ರಾ,ಆಂ ತುನೆ ಶೆಂ ರ‍್ಹವಾದೆ, ಆಂ ಅಂತ್ಯಕಾಲಮಾ ಥಾವಾನು ಕ್ಹಪನ ವ್ಹೈ ಕೈನ ಕದ್ಯೊ. <verse eid="DAN 8:17" /><verse number="18" style="v" sid="DAN 8:18" />ತೆ ಮಾರಾ ಕ್ಹಾತೆ ಬೊಲ್ತೊ ರ‍್ಹತಾಮಾ ಮಿ ಬೆವೊಸ ಥೈನ ತಿನಾ ಪಗೊಪರ ಪಡ್ಯೊ. ತೆಳಾಮಾ ತೆ ಮನೆ ಮುಟ್ಟಿನ ಹುಬ್ರಾಡಿನ ಮನೆ- <verse eid="DAN 8:18" /><verse number="19" style="v" sid="DAN 8:19" />ದೆಕ, ಕ್ಹುದಾ ತಿನಿ ಶಿಟ್ಟನೆ ಪುರಾ ಕರಾನಾ ಅಗಲ್ಯಾ ಕಾಲಮಾ ಥಾವಾನು ತುನೆ ಕೌಸ; ತೆ ನಾಶ ಥಾವಾನಾ ಅಂತ್ಯ ಕಾಲನು ವ್ಹೈ. <verse eid="DAN 8:19" /><verse number="20" style="v" sid="DAN 8:20" />ತು ದೆಕಲ ಬೆ ಶಿಂಗ್ಡಾವೊನು ಟಗರ ಮೆದ್ಯನಿ ವರಿ ಪಾರಸಿವಾಲಾವೊನಿ ರಾಜ್ಯ ವ್ಹೈ. <verse eid="DAN 8:20" /><verse number="21" style="v" sid="DAN 8:21" />ತೆ ಬಕ್ರು ಗ್ರಿಕ ರಾಜ್ಯ ವ್ಹೈ, ತಿನಾ ಡೊಳಾನಾ ವಚ್ಮಾನು ಮ್ಹೊಟು ಶಿಂಗ್ಡೊ ತೆ ರಾಜ್ಯನು ಪಸ್ಟ ರಾಜೊ಼ ವ್ಹೈ. <verse eid="DAN 8:21" /><verse number="22" style="v" sid="DAN 8:22" />ತೆ ಶಿಂಗ್ಡೊ ತುಟಲ್ಪರ ತಿನಿ ಜ಼ಗಾಪರ ಚಾರ ಶಿಂಗ್ಡಾ ಉಟಲ ವಿಶಯ ಸು ವ್ಹೈ ಕದ್ಯಾಮ ತೆ ಜನಾಂಗಮಾತಾ ಚಾರ ರಾಜ್ಯ ಉಟಸ; ತನೈಸೊ ಪಸ್ಟನಾ ರಾಜಾ಼ನೆ ರ‍್ಹಯಲ ತೆಕ್ಲಿ ತಾಕತಬಿ ತ್ಯುನೊನೆ ನೈ ರ‍್ಹತಿ. <verse eid="DAN 8:22" /><verse number="23" style="v" sid="DAN 8:23" />ತೆ ರಾಜ್ಯವೊನಾ ಲಾಸ್ಟನಾ ಟೈಮಮಾ, ಅನಿತಿವಾವಾನು ಪುರಾ ಥಯಲ್ಪರ ಕಠಿನ ಮ್ಹೊಡಾವಾಲೊ ವಚನಾನು ಮ್ಹೈನು ಅರ್ಥ ತಿಳ್ದಿಲಿವಾಲೊ ಶಾಣೊ ರ‍್ಹಯಲ ಯಕ್ಕ ರಾಜೊ಼ ಉಟಿನ ಹುಬ್ರ್ಯವಸ. <verse eid="DAN 8:23" /><verse number="24" style="v" sid="DAN 8:24" />ತೆ ತಾಕತವರ ಥಾವಸ ತೆನೈಸೊ ತಾಕತಕ್ಹು ನ್ಹವೈ; ಘನ್ನೊ ಹಾಳ ಕರಿನ ಉಪ್ಪರ ಐನ ತಿನು ಪಂಸಂದನೆ ಪುರಾ ಕರಿಲಿವಸ. <verse eid="DAN 8:24" /><verse number="25" style="v" sid="DAN 8:25" />ಗ್ಯಾನಕ್ಹುಜ಼ ತಿನು ಮೊಸ ತಯ್ಯಾರ ಕರಿನ ಮನಸಮಾ ಫುಗ್ಗಿನ ನೆಮ್ಮದಿಕ್ಹು ರ‍್ಹವಾನೆಲಾ ಘನ್ನಾ ಮನಕ್ಹೊನೆ ನಾಶ ಕರಿನ ರಾಜಕುಮಾರೊನಾ ರಾಜ ಕುಮಾರ ವಿರುದ್ದ ಥೈನ ಉಟಸ. ಆಹಾ, ಕಿನು ಹತ್ತ ಲಾಗ್ಯಾ ಬಗರ ಹಾಳ ಥಾವಸ. <verse eid="DAN 8:25" /><verse number="26" style="v" sid="DAN 8:26" />ದರ್ಶನ ತಿಳ್ಸಾಯಲ ದಿನ್ನ ರಾತನಾ ವಿಶಯ ಕ್ಹರಿಜ಼ ವ್ಹೈ. ತೆನೈಸೊ ತೆ ಕ್ಹಪನ ಜ಼ಕೈನ ರ‍್ಹವಾನೆದೆ; ತೆ ಘನ್ನು ದುರನಾ ಕಾಲನು ವ್ಹೈ ಕೈನ ಕದ್ಯೊ. <verse eid="DAN 8:26" /><verse number="27" style="v" sid="DAN 8:27" />ತೆಳಾಮಾ ದಾನಿಯಲ ಥಯಲ ಮಿ ಡೊಗ್ಗಿನ ದಕ್ಹಾ ದಿನ್ನ ಅರಾಮ ನೈಸೊ ಪಡ್ಯೊ; ಪಾಚ಼ಲ್ತೊ ಉಟಿನ ರಾಜ್ಯನು ಕಾಮ ಕರ‍್ಯೊ; ತೆ ಕ್ಹಪನನೆ ಭುಚ್ಕಿನ ಘಾಬ್ರೊ ಥಯೊ; ತೆ ಕಿನೆಜ಼ ಗ್ವತ್ತ ಥಯು ನೈ.<verse eid="DAN 8:27" /></para>
  <chapter eid="DAN 8" />
  <chapter number="9" style="c" sid="DAN 9" />
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1" />ಅಹಶ್ವೆರೊಷನೊ ದಿಕ್ರೊ ಮೆದ್ಯೆಯ ವಂಶನೊ ಕಸ್ದಿಯನಾ ರಾಜ್ಯನಿ ಅದಿಕಾರ ರ‍್ಹಯಲವಾಲೊ ಥಯಲ ದಾರ್ಯಾವೆಶನಾ ಆಳ್ವಿಕೆನಾ ಪಸ್ಟ ವಕ್ಹಮಾ <verse eid="DAN 9:1" /><verse number="2" style="v" sid="DAN 9:2" />ದಾನಿಯಲ ಥಯಲ ಮಿ ಶಾಸ್ತ್ರನೆ ಪರಿಕ್ಷಾ ಕರಿನ ಯಹೊವಾ ಪ್ರವಾದಿ ಥಯಲ ಯೆರೆಮಿಯನೆ ದಿದಲ ವಾಕ್ಯಾ ನಿಂಗತ ಯೆರುಸಲೆಮ ಹಾಳ ಥೈನ ಪಡಾನಾ ಪುರಾ ಕಾಲನಾ ವರಕ್ಹೊನಾ ಲಕ್ಕೊ ಸತ್ತರ ವ್ಹೈ ಕೈನ ತಿಳ್ದಿಲಿನ <verse eid="DAN 9:2" /><verse number="3" style="v" sid="DAN 9:3" />ಉಪಾಸ ರ‍್ಹೈನ ಕೊತ್ಳೊ ಸುತ್ತಿ ಲಿನ ರಾಕ ಲಗಾಡಿ ಲಿನ ಕರ್ತಾ ಥಯಲ ಕ್ಹುದಾಕನ ಮ್ಹೊಡು ಉಚೈನ ಪ್ರಾಥನಾ ಮಾಂಗಿಲೆತೊ ರ‍್ಹಯೊ. <verse eid="DAN 9:3" /><verse number="4" style="v" sid="DAN 9:4" />ಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಇಮ್ಮ ಪಾಪನಿ ಅರಿಕೆ ಕರಿನ ಮಾಂಗಿಲಿದ್ಯೊ- ಎ ಕ್ಹುದಾ, ಮಹೊನ್ನತ ಭಯಂಕರ ಥಯಲ ಕ್ಹುದಾ, ತುನೆ ಮಯಾ ಕರಿನ ತಾರಿ ಆಗನ್ಯಾವೊನೆ ಚಾ಼ಲಿಲಿನ ಜಾ಼ವಾಲಾವೊನೆ ಕರಲ ಕೃಪಾನಾ ವಾಗ್ದಾನೊನೆ ಪುರಾ ಕರಾಲಾ, <verse eid="DAN 9:4" /><verse number="5" style="v" sid="DAN 9:5" />ಹಮೆ ಪಾಪೊ ಅಪರಾದೊ ಕರಿನ ಕೆಟ್ಟ ಥೈನ ರ‍್ಹೈನ ತುನೆ ಫರಿನ ತಾರಿ ಆಗನ್ಯಾವೊನೆ ಛೊಡಿನ <verse eid="DAN 9:5" /><verse number="6" style="v" sid="DAN 9:6" />ಹಮಾರಾ ರಾಜಾ಼, ಮ್ಹೊಟಾ ಮನಕ್ಹೊ, ಶಾನಾ, ಸಾಮಾನ್ಯ ಮನಕ್ಹೊ, ಇವ್ನೊನೆ ಕ್ಹಾರಾವೊನೆ ತಾರಾ ನಾಮನಾ ಉಪ್ಪರ ಕದಲ ತಾರಾ ಸೆವಕೊ ಥಯಲ ಪ್ರವಾದಿಯೊಕನ ಕಾನ ದಿದ್ಯಾ ನೈ. <verse eid="DAN 9:6" /><verse number="7" style="v" sid="DAN 9:7" />ಕರ್ತಾ, ತು ಧರ್ಮ ಸ್ವರುಪ ವ್ಹೈ, ಹಮೆ ಸರಮನೆ ಗುರಿ ಥಯಲವಾಲಾ ವ್ಹೈ; ಹೊ, ಹಮ್ನಾಜ಼ ಯಹುದಿಯೊ ಯೆರುಸಲೆಮಮಾ ರ‍್ಹವಾನೆಲಾ ತುನೆ ವಿರುದ್ದ ಥೈನ ಕರಲ ದ್ರೊಹನಾ ಮುಲಕ ತುಕ್ಹು ದೆಶ ದೆಶನೆ ನ್ಹಟಾಡಲವಾಲಾ ಥೈನ ದುರಬಿ ನಜಿಕಬಿ ಚದರಿ ಗಯಲ ಕ್ಹಾರಾ ಇಸ್ರಾಯೆಲೊ ಸರಮನೆ ಗುರಿ ಥಯಾಸ. <verse eid="DAN 9:7" /><verse number="8" style="v" sid="DAN 9:8" />ಕರ್ತಾ, ತುನೆ ವಿರುದ್ದ ಥಯಲ ಪಾಪ ಕರ್xಯಲಕ್ಹು ಹಮೆ ಹಮಾರಾ ರಾಜಾ಼ವೊ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ಶಾನಾ ಸರಮನೆ ಗುರಿ ಥಯಾಸ. <verse eid="DAN 9:8" /><verse number="9" style="v" sid="DAN 9:9" />ಕರ್ತಾ ಥಯಲ ಅಪ್ನೊ ಕ್ಹುದಾ ಕರುಣಾ ಕರಾಲೊ ಕ್ಷಮಾ ಕರಾಲೊ ಥಯೊಸ; ಅಪೆ ತಿನೆ ಉಲ್ಟಾ ಫರ್xಯಾಸತೊ; <verse eid="DAN 9:9" /><verse number="10" style="v" sid="DAN 9:10" />ಕರ್ತಾ ಥಯಲ ಅಪ್ನಾ ಕ್ಹುದಾನಿ ವಾತನೆ ಐಕ್ಯಾ ನೈ, ತಿನಾ ಸೆವಕೊ ಥಯಲ ಪ್ರವಾದಿಯೊನಾ ಮುಲಕ ಅಪೊನೆ ತಿಳ್ಸಾಯಲ ಧರ್ಮನಿ ವಾಟಮಾ ಚಾ಼ಲ್ಯಾ ನೈ. <verse eid="DAN 9:10" /><verse number="11" style="v" sid="DAN 9:11" />ಕ್ಹಾರಾ ಇಸ್ರಾಯೆಲೊ ತಾರಿ ನಿಯಮನಾ ಪ್ರಮಾಣನೆ ದಾಟಿನ ತಾರಿ ವಾತನೆ ಐಕ್ಯಾ ಬಗರ ದಡಿನ ರ‍್ಹಯಾ; ತಿನಾಹುತಿ ತಾರಿ ಶಾಪನಾ ಕೆಡೊ ಕ್ಹುದಾನೊ ಸೆವಕ ಥಯಲ ಮೊಶೆನಾ ಧರ್ಮ ಶಾಸ್ತ್ರಮಾ ತು ಕ್ಹಮ್ಮ ಘಾಲಿನ ಕದಲ ತ್ರಾಸೊ ಹಮಾರಾ ಉಪ್ಪರ ಆಯಾಸ; ಹಮೆ ಕ್ಹುದಾನೆ ದ್ರೊಹ ಕರಲವಾಲಾ ವ್ಹೈ. <verse eid="DAN 9:11" /><verse number="12" style="v" sid="DAN 9:12" />(ಆಹಾ, ಅಪ್ನೊ ಕ್ಹುದಾ) ಅಪ್ನಾ ಉಪ್ಪರ ಮ್ಹೊಟಾ ತ್ರಾಸನೆ ಆವಾ ಲಗಾಡಿನ ಹಮೊನೆ ಆಳಾನಾ ಅದಿಪತಿಯೊನಾಹುತಿ ಎಚ್ಚರಿಕೆ ದಿನ ಕದಲ ವಾತೊನೆ ಪುರಾ ಕರ‍್ಯೊಸ; ಯೆರುಸಲೆಮನೆ ಥಯಲ ತ್ರಾಸ ಭುಲೊಕಮಾ ಕಿಜಾ಼ಜ಼ ಕೆಳಾಮಾಜ಼ ಥಯು ನೈತೊ. <verse eid="DAN 9:12" /><verse number="13" style="v" sid="DAN 9:13" />ಮೊಶೆನಾ ಧರ್ಮ ಶಾಸ್ತ್ರಮಾ ಬರ್ದಲ ನಿಂಗತಜ಼ ಎ ತ್ರಾಸೊ ಕ್ಹಾರಾ ಹಮಾರಾ ಉಪ್ಪರ ಆಯಾಸ; ತೆನೈಸೊ ಹಮೆ ಹಮಾರಾ ಕೆಟ್ಟ ವಾಟೊ ಛೊಡಿನ ತಾರಾ ಸತ್ಯ ಉಪದೆಶನೆ ತಿಳ್ದಿಲಿನ ಚಾ಼ಲಾವರ್ಕ್ಹು ಅಪ್ನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಕವಾಲಾ ತಾರಿ ಮರ್ಗಾನೆ ಮಾಂಗಿಲಿದ್ಯಾ ನೈ. <verse eid="DAN 9:13" /><verse number="14" style="v" sid="DAN 9:14" />ತಿನಾಹುತಿ ಯಹೊವಾ ತೆ ತ್ರಾಸನೆ ದೆಕಿಲಿನ ಅಪ್ನಾ ಉಪ್ಪರ ಆವಾಲಗಾಡ್ಯೊಸ; ಅಪ್ನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ತೆ ಕರಾನಾ ಕ್ಹಾರಾ ಕಾಮೊಮಾ ಧರ್ಮ ಸ್ವರುಪಿ ವ್ಹೈ; ಅಪೆ ತಿನಿ ವಾತ ಐಕ್ಯಾ ನೈ. <verse eid="DAN 9:14" /><verse number="15" style="v" sid="DAN 9:15" />ಕರ್ತಾ, ಹಮಾರಾ ಕ್ಹುದಾ, ಘನ್ನಿ ತಾಕತನೆ ದೆಕಾಡಿನ ತಾರಾ ಮನಕ್ಹೊನೆ ಐಗುಪ್ತ ದೆಶತೊ ಪಾರ ಕರಿನ ಆಜ಼ ಲಕ್ಕಾ ಮಶುರ ಥಯಲ ನಾಮನೆ ವ್ಹಂದಿಲಿದಲವಾಲೊ ವ್ಹೈ, ಹ್ನಾ ತಾರಿ ಚಿತ್ತ ಪುರಾ ಕರ. ಹಮೆ ಪಾಪ ಕರಿನ ಕೆಟ್ಟ ಥೈನ ಚಾ಼ಲಿಲಿನ ಗಯಾಸ. <verse eid="DAN 9:15" /><verse number="16" style="v" sid="DAN 9:16" />ಕರ್ತಾ, ತಾರಾ ಪುರಾ ಧರ್ಮನಾ ಕಾಮೊ ನಿಂಗತ ತಾರು ಗಾಮ ತಾರು ಪವಿತ್ರ ಡೊಂಗರ ಥಯಲ ಯೆರುಸಲೆಮನಾ ಉಪ್ಪರ ರ‍್ಹಯಲ ತಾರಿ ಶಿಟ್ಟನೆ, ತಾರಿ ಶಿಟ್ಟನಿ ಆಗನೆ ದಯಾ ಕರಿನ ಛೊಡಿಪಡ; ಹಮಾರಾ ವರಿ ಹಮಾರಾ ಪಿತೃವೊನಾ ಪಾಪ ಅಪರಾದೊನಾಹುತಿ ಯೆರುಸಲೆಮಬಿ ತಾರಾ ಮನಕ್ಹೊಬಿ ಆಜು಼ ಬಾಜು಼ನಾ ಕ್ಹಾರಾ ಅವಮಾನನೆ ಗುರಿ ಥಯಾಸತೊ. <verse eid="DAN 9:16" /><verse number="17" style="v" sid="DAN 9:17" />ಹಮಾರೊ ಕ್ಹುದಾ, ತಾರಾ ಸೆವಕನಿ ಪ್ರಾಥನಾವೊನೆ ಹಮ್ನಾ ಐಕ; ಹಾಳ ಥಯಲ ತಾರಿ ಪವಿತ್ರ ಆಯಲನೆ ಕರ್ತಾ ಥಯಲ ತಾರಾ ನಾಮನಾಹುತಿ ಕ್ಹುಶಿನಾ ಮ್ಹೊಡಾಕ್ಹು ದೆಕ. <verse eid="DAN 9:17" /><verse number="18" style="v" sid="DAN 9:18" />ಮಾರಾ ಕ್ಹುದಾ, ಕಾನ ದಿನ ಐಕ, ಡೊಳಾ ಕಾಡಿನ ಹಮಾರಾ ಹಾಳ ಪಡಿಗಯಲ ಜ಼ಗಾವೊನೆ ತಾರು ನಾಮ ರ‍್ಹಯಲ ಗಾಮನೆ ದೆಕ; ಹಮೆ ಸಧರ್ಮಿಯೊ ನಿಂಗತ ನ್ಹವೈ ತಾರಿ ಮ್ಹೊಟಿ ಕೃಪಾನೆ ನಂಬಿನ ಎ ಪ್ರಾಥನಾವೊನೆ ತಾರಾ ಕ್ಹಾಮಾ ಅರಿಕೆ ಕರಾಡಾಸ. <verse eid="DAN 9:18" /><verse number="19" style="v" sid="DAN 9:19" />ಕರ್ತಾ, ಐಕ! ಸ್ವಾಮಿ, ಕ್ಷಮಾ ಕರ! ಸ್ವಾಮಿ, ಐಕ, ಕಾಮ ಪುರಾ ಕರ! ತಡಾ ನಕೊ ಕರು! ಮಾರಾ ಕ್ಹುದಾ, ತಾರಾ ಮನಕ್ಹೊಬಿ ಗಾಮಬಿ ತಾರಾ ನಾಮನಾ ರ‍್ಹಯಲಕ್ಹು ತಾರು ನಾಮ ವಚಾ಼ಡಿಲೆ! <verse eid="DAN 9:19" /><verse number="20" style="v" sid="DAN 9:20" />ಮಿ ಮ್ಹೊಡು ಕ್ಹೊಲಿನ ಮಾಂಗಿಲಿನ ಮಾರಾ ಮನಕ್ಹೊ ಥಯಲ ಇಸ್ರಾಯೆಲೊನಾ ಪಾಪೊನೆ ಅರಿಕೆ ಕರ್ತೊ ಮಾರಾ ಕ್ಹುದಾನಾ ಪವಿತ್ರ ಡೊಂಗರನಾ ವಿಷಯಮಾ ಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾಕನ ಮಾಂಗಿಲಿನ ಪ್ರಾಥನಾ ಕರ್ತಾಮಾ <verse eid="DAN 9:20" /><verse number="21" style="v" sid="DAN 9:21" />ಪೈಲಾ ಮಾರಾ ದರ್ಶನ ದೆಕಲ ಗಬ್ರಿಯೆಲ ಕವಾನಾ ಮನಕ್ಹ ಅಸುರುಸುರ ಥೈನ ಉಡಿನ ಐನ ಪಾಟೆ ಕ್ಹಾಂಜೆ ಚ಼ಡಾವಾನಿ ನೈವೆದ್ಯ ಟೈಮಮಾ ಮನೆಬಿ ಮಳಿನ <verse eid="DAN 9:21" /><verse number="22" style="v" sid="DAN 9:22" />ಮಾರಾ ಕ್ಹಾತೆ ಇಮ್ಮ ಬೊಲಿನ ಉಪದೆಶ ಕರ‍್ಯೊ; ದಾನಿಯಲ, ತುನೆ ಗ್ಯಾನನಿ ಬೊದನೆ ಕರಾನಾಹುತಿ ಹಮ್ನಾ ಆಯೊಸ; <verse eid="DAN 9:22" /><verse number="23" style="v" sid="DAN 9:23" />ತು ಪೈಲಾಜ಼ ಮಾಂಗಿಲಿದಲ ಟೈಮಮಾ ಕ್ಹುದಾನಿ ಅಪ್ಪಣೆ ಥೈ; ತೆ ತುನೆ ಕವಾನೆ ನ್ಹ್ಯಾ ಆಯೊಸ; ತು (ಕ್ಹುದಾನೆ) ಘನ್ನೊ ಮಯಾನೊ ವ್ಹೈ; ಎ ಕ್ಹುದಾನಿ ವಾಣಿನೆ ವಿಚಾರ ಕರ, ಎ ದರ್ಶನನೆ ತಿಳ್ದಿಲೆ. <verse eid="DAN 9:23" /><verse number="24" style="v" sid="DAN 9:24" />ಅಧರ್ಮನೆ ಖಲಾಸ ಕರಸ, ಪಾಪೊನೆ ತಿರ್ಸಾವಸ, ಅಪರಾದೊನೆ ನಿವಾರಣೆ ಕರಸ, ಸನಾತನ ಧರ್ಮನೆ ಸ್ಥಾಪನೆ ಕರಾನು, ಕ್ಹಪನನೆ ಪ್ರವಾದಿನಾ ವಾತನೆ ಇಕ್ಕೊ ಮಾರಿನ ಯಥಾರ್ಥ ಕರಸ, ಘನ್ನು ಪರಿಶುದ್ದ ರ‍್ಹಯಲನೆ ಅಬಿಷೆಕ ಕರಸ, ಎ ಕ್ಹಾರು ಪುರಾ ಥಾವಾನೆ ಪೈಲಾ ತಾರಾ ಮನಕ್ಹೊನೆಬಿ ಮಾರಾ ಪರಿಶುದ್ದ ಗಾಮನೆಬಿ ಸತ್ತರ ಅಟ್ವಾಡಾ ಥೌ ಕೈನ ನಿರ್ಧಾರ ಥಯುಸ. <verse eid="DAN 9:24" /><verse number="25" style="v" sid="DAN 9:25" />ಎ ತಿಳ್ದಿಲಿನ ಶೆಂ ಮ್ಹೆಲ್ಲೆ; ಯೆರುಸಲೆಮ ಯಕ್ಕ ವಿಚಾರನಾ ರುಪಮಾ ಭಾಂಧಾವಾದೆ ಕವಾನಿ ಕ್ಹುದಾನಿ ವಾತ ಆಯಲ ತೆಳತು ಅಬಿಷಕ ಥಯಲ ಪ್ರಭು ಆಯೆ ಲಕ್ಕಾ ಕ್ಹಾತ ಹಪ್ತಾ ಥೌ! ತೆ ವರಿ ಭಂದೈನ ಕ್ಹಾಟಪರ ಬೆ ಹಪ್ತಾ ರ‍್ಹವಸ; ತಿನಾಹುತಿ ಚೌಕಬಿ ಕಂದಕಬಿ ರ‍್ಹವಸ; ತೆ ಟೈಮ ಘನ್ನೊ ತ್ರಾಸನೊ ಟೈಮ ವ್ಹೈ. <verse eid="DAN 9:25" /><verse number="26" style="v" sid="DAN 9:26" />ಕ್ಹಾಟ್ಪರ ಬೆ ಹಪ್ತಾ ಥಯಲ್ಪರ ಅಬಿಶೆಕ ಥಯಲವಾಲೊ ಯಕ್ಲೊ ಮೌತನೆ ಗುರಿ ಥಾವಸ; ತಿನೆ ಸುಜ಼ ರ‍್ಹತು ನೈ; ವ್ಹಕ್ಕಾನಾ ಪ್ರಭುನಾ ಮನಕ್ಹೊನಾ ಗಾಮೊನೆ ಪವಿತ್ರ ಆಲಯನೆ ಹಾಳ ಕರಸ; ಭರಿನ ಫುಟಾನು ತುಫಾನ ಗಾಮೊನೆ ನಾಶ ಕರಸ; ಅಂತ್ಯಕಾಲ ಲಕ್ಕಾ ಯುದ್ದೊ ಥಾವಸ, ಕ್ಹರಿ ಬಿ ನಾಶ ಥಾವಸ . <verse eid="DAN 9:26" /><verse number="27" style="v" sid="DAN 9:27" />ತೆ ಪ್ರಭು ಯಕ್ಕ ಹಪ್ತಾ ಲಕ್ಕ ಘನ್ನಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಘ್ಟ ರ‍್ಹಯಲ ಒಡಂಬಡಿಕೆ ಕರಿ ಲಿವಸ, ಅರ್ದೊ ಹಪ್ತೊ ಬಲಿನಾ ನೈವೆದ್ಯೊನೆ ಹುಬ್ರಾಡಸ; ಅಸೈ ರ‍್ಹಯಲನೆ ವಾಹನ ಕರಿ ಲಿನ ಯಕ್ಕ ನಾಶ ಕರಾಲೊ ಉಡಿನ ಐನ ಕ್ಹರಿಬಿ ತಿನೆ ತುಫಾನ ಡುಬಾಡೆ ಲಕ್ಕಾ ಹಾಳ ಕರಸ.<verse eid="DAN 9:27" /></para>
  <chapter eid="DAN 9" />
  <chapter number="10" style="c" sid="DAN 10" />
  <para style="s">ದೆವದುತನು ದರ್ಶನ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1" />ಪಾರಶಿನೊ ರಾಜೊ಼ ಥಯಲ ಕೊರೆಷನನಿ ಆಳ್ವಿಕೆನಾ ತನ್ವಾ ವರಕ್ಹಮಾ ದಾನಿಯಲನೆ ಯಕ್ಕ ಸಂಗತಿ ಐ; ಘನ್ನಿ ತ್ರಾಸನಿ ತೆ ಸಂಗತಿ ಕ್ಹರಿ ವ್ಹೈ. ತೆ ದೆಕಲ ಕ್ಹಪನನಾ ಹುತಿ ತೆ ಸಂಗತಿ ಝಾಕಿನ ಮ್ಹೆಲ್ಯೊ. <verse eid="DAN 10:1" /><verse number="2" style="v" sid="DAN 10:2" />ತೆ ಕಾಲಮಾ ದಾನಿಯಲ ಥಯಲ ಮಿ ತನ್ನ ಹಪ್ತಾ ರೊತೊ ರ‍್ಹೌಸ. <verse eid="DAN 10:2" /><verse number="3" style="v" sid="DAN 10:3" />ತನ್ನ ಹಪ್ತಾ ಮುಗದೆಲಕ್ಕಾ ಸ್ವಾದ ರ‍್ಹಯಲ ಅನ್ನ ಖಾದ್ಯೊ ನೈ, ಮಾಕ್ಹ ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ಮಾರಾ ಮ್ಹೊಡಾಮಾ ಘಾಲ್ಲಿದ್ಯೊ ನೈ, ತೆಲ ಲಗಾಡಿಲಿದ್ಯೊ ನೈ. <verse eid="DAN 10:3" /><verse number="4" style="v" sid="DAN 10:4" />ಪಸ್ಟಲ್ಯಾ ಮ್ಹೈನಾನಾ ಇಕ್ಹಪರ ಚಾರರ್ವಾ ದಿನ್ಮಾ ಮಿ ಹಿದ್ದಿಕೆ ಕವಾನಿ ಮ್ಹೊಟಿ ನದಿನಾ ದಂಡಿ ಹುಬರೈನ <verse eid="DAN 10:4" /><verse number="5" style="v" sid="DAN 10:5" />ಡೊಳೊ ಉಚೈನ ದೆಕ್ತಾಮಾ, ಚೊ಼ಕಾ ವಣ್ಣಾ ಘಾಲ್ಲಿನ ಉಫಜಿನನಿ ಕ್ಹೊನಾನಿ ಪಟ್ಟಿ ಬಿಗ್ದಿಲಿನ ಯಕ್ಕ ದಾಣಗೊ ಮನೆ ದಿಕ್ಹ್ಯೊ; <verse eid="DAN 10:5" /><verse number="6" style="v" sid="DAN 10:6" />ತಿನು ಅಂಗ ಪಿತರತ್ನ ನಿಂಗತ ಮಿಂಚಾ಼ಡ್ಯುತು, ತಿನು ಮ್ಹೊಡು ಮಿಂಚಾ಼ಡ್ಯುತು ತಿನಾ ಡೊಳಾ ಘನ್ನಾ ಮಿಂಚಾ಼ಡ್ಯಾತಾ ತಿನಾ ಪಗೊ ತಿಕ್ಕಲ ತಾಂಬಾನಾ ನಿಂಗತ ಮಿಂಚಾ಼ಡ್ಯಾತಾ. ತೆ ಬೊಲಾನು ಅವಾಜ಼ ಘನ್ನು ಜ಼ೊರ ವ್ಹತು. <verse eid="DAN 10:6" /><verse number="7" style="v" sid="DAN 10:7" />ದಾನಿಯಲ ಥಯಲ ಮಿ ಯಕ್ಲೊಜ಼ ತೆ ದರ್ಶನ ದೆಕ್ಯೊ. ವರಿ ಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲವಾಲಾ ತೆ ದೆಕ್ಯಾ ನೈ. ವರಿಬಿ ತ್ಯುನೆ ಘನ್ನಾ ಕಾಪತಾ ನ್ಹಾಟಿನ ಗೈನ ದಡಿರ‍್ಹಯಾ. <verse eid="DAN 10:7" /><verse number="8" style="v" sid="DAN 10:8" />ಮಿ ಯಕಾಕಿಜ಼ ತೆ ಮ್ಹೊಟು ದರ್ಶನ ದೆಕಿನ ಮಾರಾಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಿ ತಾಕತ ಜ಼ವೈಲಿದ್ಯೊ. <verse eid="DAN 10:8" /><verse number="9" style="v" sid="DAN 10:9" />ತೆಕ್ಲು ಥಯುತಬಿ ತೆ ಬೊಲಾನು ಮನೆ ಐಕು ಆವಾಡ್ಯುತು; ತೆ ಬೊಲಾನಿಯೊ ವಾತೊ ಮಾರಾ ಕಾನೆ ಪಡತಾಮಾ ಮಿ ಮೊಕಾನಿಂಗತ ಥೈನ ಅಡ್ಡಪಡ್ಯೊ. <verse eid="DAN 10:9" /><verse number="10" style="v" sid="DAN 10:10" />ಅಹಾ ಮಪರ ಹತ್ತ ಮುಕ್ಕಲನಿಂಗತ ಥಯು ಮಿ ಕಾಪ್ತೊ ಗುಡ್ಗಾವೊಪರ ಬೈಟಿನ ಹತೊಪರ ಹುಬರವಾ ವರಕ್ಹು ಥಯು. <verse eid="DAN 10:10" /><verse number="11" style="v" sid="DAN 10:11" />ತೆಳಾಮಾ ಮನೆ ತೆ ದಾನಿಯಲ ಘನ್ನಾ ಮಯಾನಾ ಮಿ ಕವಾನಿಯೊ ವಾತೊ ಕಾನ ದೆ; ಹಮ್ನಾ ತುಕನ ಮೊಕಲ್ಯೊಸ ಕದ್ಯೊ; ತೆಳಾಮಾ ಮಿ ಕಾಪ್ತೊ ಹುಬರಯೊ. <verse eid="DAN 10:11" /><verse number="12" style="v" sid="DAN 10:12" />ತೆಳಾಮಾ ಮನೆ ತೆ ದಾನಿಯಲ ಭುಚ್ಕು಼ನಕೊ ತು ಕ್ಹುದಾನಿ ಚಿತ್ತ ಕರಾನಾಹುತಿ ತು ಕ್ಹುದಾನಾ ಕ್ಹಾಮೊ ತಗ್ಗಿಸಿಲಿವಾನೆ ಮನಸ ಮ್ಹೆಲಲ ಪಸ್ಟಲ್ಯಾ ದಿನಮಾ ತು ಮಾಂಗಿಲಿವಾನು ಕ್ಹುದಾಕನ ಮುಟ್ಯುಸ. <verse eid="DAN 10:12" /><verse number="13" style="v" sid="DAN 10:13" />ಪಾರಸಿ ರಾಜ್ಯನೊ ದಿವ್ಯಪಾಲಕ ಥಯಲ ಇಕ್ಹಪರ ಯಕ್ಕ ದಿನ್ನ ಮನೆ ತರ್ಬಾನೆ ದೆಕ ಪ್ರಧಾನ ದೆವದುತೊಮಾ ಯಕ್ಲೊ ಮಿಕಾಯಿಲ ಮನೆ ಮದತ ಕರಾನೆ ಆಯೊ; ತ್ಯಾ ಪಾರಸಿನಾ ರಾಜಾ಼ನಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರಿನ <verse eid="DAN 10:13" /><verse number="14" style="v" sid="DAN 10:14" />ವಾಚ಼ಲ ಅಂತ್ಯಕಾಲಮ ತಾರಾ ಮನಕ್ಹೊನೆ ಥಾವಾನಿ ಗತಿ ತುನೆ ಕವಾನಾಹುತಿ ಆಯೊ; ತೆ ಕಾಲನಿ ಸಂಗತಿಯೊ ಕವಾನಾಹುತಿ ಅಗು ಥಾವಾನು ದರ್ಶನ ಛೆ ಕೈನ ಕದ್ಯೊ. <verse eid="DAN 10:14" /><verse number="15" style="v" sid="DAN 10:15" />ತೆ ಎ ವಾತೊ ಕದಲಬರೊಬ್ಬರ ಮ್ಹೊಡು ಹೆಟು ಕರಿನ ಸುಜ಼ ಬೊಲ್ಯೊ ನೈ. <verse eid="DAN 10:15" /><verse number="16" style="v" sid="DAN 10:16" />ದೆಕ ಮನಕ್ಹನಾ ದಿಕ್ರಾ ನಿಂಗತಮಕನ ಐನ ಯಕ್ಲೊ ಮಾರಾ ಹೊಟೊ ಮುಟ್ತಾಮಾ ಮಿ ಮ್ಹೊಡು ಖೊಲಿನ ಮಾರಾ ಕ್ಹಾಮಾ ಹುಬರಯಲವಾಲಾನೆ ಮಾರಾ ಮಾಲಕ ಎ ದರ್ಶನಕ್ಹು ತ್ರಾಸೊ ಮನೆ ಆಯಾಸ. ತಾಕತ ನೈಸೊ ಥೈಗಯೊ. <verse eid="DAN 10:16" /><verse number="17" style="v" sid="DAN 10:17" />ಮಾರಾ ಮಾಲಕ ಸೆವಕ ಥಯಲ ಮಾರಾವರಕ್ಹಾನೆ ಮಾರಾಮಾಕಲ ಥಯಲ ತಾರಾಕ್ಹಾತೆ ಕಿಮ್ಮ ಬೊಲು? ಹಮ್ನಾತೊ ಮಾರಿ ತಾಕತ ಜ಼ವೈಲಿದ್ಯೊಸ. ಮಾರಾಮಾ ಉಸಲಜ಼ ನತ್ತಿ ಕದ್ಯೊ. <verse eid="DAN 10:17" /><verse number="18" style="v" sid="DAN 10:18" />ವರಿ ತೆ ಮನೆ ಮುಟ್ಟಿನ ತಾಕತ ದಿದ್ಯೊ. <verse eid="DAN 10:18" /><verse number="19" style="v" sid="DAN 10:19" />ತೆ ಥಲಯ್ಪರ ತೆ ಮನಕ್ಹ ಮನೆ ಘನ್ನಾ ಮಯಾನಾ ಭುಚ್ಕು಼ ನಕೊ; ತುನೆ ಸಮಾಧಾನ ರ‍್ಹವಾದೆ, ಧೈರ್ಯ ರ‍್ಹವಾದೆ ಕೈನ ಕದ್ಯೊ. ತೆ ಎ ವಾತ ಕದಲಬರೊಬ್ಬರ ಮಿ ಧೈರ್ಯಕ್ಹು ರ‍್ಹೈನ ಮಾರಾ ಮಾಲಕ ಕೆ ಮನೆ ಧೈರ್ಯದಿದ್ಯೊ ಕೈನ ಕತಾಮಾ ತೆ ಮನೆ ಅಮ್ಮ ಕದ್ಯೊ. <verse eid="DAN 10:19" /><verse number="20" style="v" sid="DAN 10:20" />ಮಿ ತುಕನ ಶಾನಾಹುತಿ ಆಯೊಸ ಕೈನ ತುನೆ ಗ್ವತ್ತ ನತ್ತಿಸು? ಹಮ್ನಾ ಮಿ ಪಾರಸಿಯೊನಾ ರಕ್ಷಕೊನಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರಾನೆ ಜೌ಼. ತೆ ಯುದ್ದ ಮುಗ್ದಲ್ಪರ ಆಹಾ, ಗ್ರಿಕ ರಾಜ್ಯನೊ ರಕ್ಷಕ ಮಾರಾಕ್ಹಾಮೊ ಯುದ್ದ ಕರಾನೆ ಆವಸ. <verse eid="DAN 10:20" /><verse number="21" style="v" sid="DAN 10:21" />ವರಿಬಿ ಕ್ಹರಿನಿ ಶಾಸನಮಾ ಬರ್ದಲ ತೆ ಮಿ ಕೌಸ. ಎ ಭಂಬಿಜ಼ನಾವೊನಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರ್ತಾಮ ತುಮಾರೊ ಪಾಲಕ ಥಯಲ ಮಿಕಾಯಲ ಯಕ್ಕಜ಼ನೆ ಛೊಡಿನ ಮನೆ ಸಾತಿದಾರ ನತ್ತಿ.<verse eid="DAN 10:21" /></para>
  <chapter eid="DAN 10" />
  <chapter number="11" style="c" sid="DAN 11" />
  <para style="s">ದಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 11:1" />ಮೆದ್ಯ ಥಯಲ ದಾರ್ಯಾವೆಷ ಆಳ್ವಿಕೆನಾ ಪೈಲಾನಾ ವರಕ್ಹಮಾ ಮಿಜ಼ ಮಿಕಾಯೆಲನೆ ಸಾತ ದಿನ ಆಸ್ರೊ ಥೈನ ಹುಬ್ರಯೊ. <verse eid="DAN 11:1" /><verse number="2" style="v" sid="DAN 11:2" />ಮಿ ಹಮ್ನಾ ಕ್ಹರಿ ರ‍್ಹಯಲ ಕ್ಹಾರುಜ಼ ತುನೆ ಕೌಸ</para>
  <para style="s" vid="DAN 11:2">ಇಜಿಪ್ತ ವರಿ ಸಿರಿಯಾ ರಾಜ್ಯ</para>
  <para style="p" vid="DAN 11:2">ದೆಕೊ ಪಾರಿಶಿ ದೆಶಮಾ ಹುಜ಼ುನ ತನ್ನ ರಾಜಾ಼ ಉಟಸ ಚಾರವಾವಾಲೊ ತ್ಯುನೊತಿಬಿ ಘನೊ ಸೌಕಾರ ರ‍್ಹಯಲ ರ್ಹವಸ. ತೆ ತಿನಿ ಸೌಕಾರ ತನಾನಿ ತಾಕತಕ್ಹು ಗ್ರಿಕ ರಾಜ್ಯಮಾ ವಿರುದ್ದ ಥೈನ ಕ್ಹಾರಾವೊನೆ ಉಟಾಡಸ. <verse eid="DAN 11:2" /><verse number="3" style="v" sid="DAN 11:3" />ತೆಳಾಮಾ ತಾಕತವರ ಯಕ್ಲೊ ರಾಜೊ಼ ಉಟಿನ ಮ್ಹೊಟಿ ಅದಿಕಾರಕ್ಹು ರಾಜ ಕರಿನ ತಿನಾ ಚಿತ್ತ ಪ್ರಕಾರ ಚಾ಼ಲಸ. <verse eid="DAN 11:3" /><verse number="4" style="v" sid="DAN 11:4" />ತೆ ಮಾತು ಉಚಾಯಲ್ಪರ ತಿನಿ ಯಕ್ಕ ರಾಜ್ಯ ಭಗೈ ಜಾ಼ವಸ. ಹಬಾಳನಾ ಚಾರೆ ಬಗಲ ಜು಼ದು ಥೈ ಜಾ಼ವಸ. ತಿನಾ ಪಿಳಗಿನೆ ಮಳತಿ ನೈ. ತಿನಿ ರಾಜ್ಯ ಕಿತ್ತಿನ ಬಿಜಾ಼ವೊನೆ ವಾಟಸ. <verse eid="DAN 11:4" /><verse number="5" style="v" sid="DAN 11:5" />ದಕ್ಷಿಣ ಬಗಲನೊ ರಾಜೊ಼ ಘನೊ ತಾಕತವರ ರ‍್ಹವಸ ತಿನಿ ಆಸ್ತಾನಮಾ ರ‍್ಹಯಲ ಯಕ್ಲೊ ಘನೊ ತಾಕತವರ ರ‍್ಹವಸ. ತಿನಿ ಮ್ಹೊಟಿ ಆಳ್ವಿಕೆ ಥಾವಸ <verse eid="DAN 11:5" /><verse number="6" style="v" sid="DAN 11:6" />ವರಕ್ಹೊನಾ ಲಾಸ್ಟಮಾ ತ್ಯುನೆ ಯಕ್ನಾ ಯಕ್ಕ ಥಾವಸ ಕಿಮ್ಮ ಕದ್ಯಾಮ ದಕ್ಷಿಣಮಾ ರ‍್ಹಯಲ ರ‍್ಜಾ಼ನಿ ದಿಕ್ರಿ ಉತ್ತರಮಾ ರ‍್ಹಯಲ ರಾಜಾ಼ಕನ ಐನ ವಪಂದ ಕರಿಲಿವಸ ವರಿಬಿ ತಾಕತ ವಚಾ಼ಡಿಲೆತಿ ನೈ ತೆ ತಿನಾ ಹತೊ ಹುಬ್ರೆತು ನೈ ತೆ ತಿನೆ ಬಲೈನ ಲಾಯಲವಾಲಾ ತಿನೆ ಪಡ್ದಿಲಿದಲವಾಲೊ ತೆ ಕಾಲಮಾ ತಿನೆ ತಾಕತವರ ಕರಲವಾಲೊ ವಾಚ್ತೊ಼ ನೈ. <verse eid="DAN 11:6" /><verse number="7" style="v" sid="DAN 11:7" />ತೆಳಾಮಾ ತಿನಿ ಬೆರನಿ ಚಿಗರಕ್ಹು ಉಟಿನ ತಿನಿ ಜಗಾಪರ ಹುಬ್ರೈನ ಸೈನ್ಯನಾಕ್ಹಾತೆ ಐನ ಉತ್ತರ ರಾಜಾ಼ನಾ ರಾಜವಾಡಮಾ ಐನ ತಾಕತವರ ಥಾವಸ <verse eid="DAN 11:7" /><verse number="8" style="v" sid="DAN 11:8" />ತ್ಯುನಾ ಕ್ಹುದಾವೊನೆ ತ್ಯುನಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊನೆ ಕ್ಹೊನಾನು ರುಪ್ಪಾನು ಸಾಮ್ನೊ ಕಾಡಿಲಿನ ಐಗುಪ್ತ ದೆಶೆ ಐನ ಉತ್ತರನಾ ದೆಶನಾ ರಾಜಾ಼ನಾ ಉಸಾಬರಿನೆ ಜಾ಼ತಾ ನೈ. <verse eid="DAN 11:8" /><verse number="9" style="v" sid="DAN 11:9" />ಇಮ್ಮ ದಕ್ಷಿಣನೊ ರಾಜೊ಼ ತಿನಾ ರಾಜ್ಯನೆ ಐನ ಸ್ವಂತ ದೆಶೆ ಫರಿನ ಜಾ಼ವಸ. <verse eid="DAN 11:9" /><verse number="10" style="v" sid="DAN 11:10" />ತೆ ಥಯಲ್ಪರ ತಿನಾ ದಿಕ್ರಾ ತಯಾರ ಥೈನ ಮ್ಹೊಟು ಗುಂಪ ಕುಡ್ಸಸ. ತ್ಯುನೊಮಾ ಯಕ್ಲೊ ಐನ ತಿಮಾ ಪ್ರಳಯ ನಿಂಗತ ದಾಟಿನ ಜಾ಼ವಸ ವರಿ ತೆಜ಼ ತಯಾರ ಥೈನ ಕೊಟೆನೆ ಝಿತ್ತಸ. <verse eid="DAN 11:10" /><verse number="11" style="v" sid="DAN 11:11" />ತೆಳಾಮಾ ದಕ್ಷಣನೊ ರಾಜೊ಼ ಸಿಟ್ಟಥೈನ ಗೈನ ತಿನಾಕ್ಹಾತೆ ಕದ್ಯಾಮ ಉತ್ತರನಾ ರಾಜಾ಼ನಾಕ್ಹಾತೆ ಯುದ್ದ ಕರಸ. ತೆ ಮ್ಹೊಟಿ ಸೆನಾ ಕರಿನ ಹುಬ್ರಾಡಸ ವರಿಬಿ ಮ್ಹೊಟು ಸಮೂಹ ಇನೆ ದಿವಸ. <verse eid="DAN 11:11" /><verse number="12" style="v" sid="DAN 11:12" />ತೆ ಸಮೂಹ ತಿನೆ ಕಾಡಲ್ಪರ ತಿನು ಮನಸ ಸ್ವಕ್ಕಕ್ಹು ಭರಸ ಲಾಕೊಸಿ ಸೈನಿಕೊನೆ ಮಾರ್ಯಾತಬಿ ತೆ ತಾಕತವರ ಥಾತೊ ನೈ. <verse eid="DAN 11:12" /><verse number="13" style="v" sid="DAN 11:13" />ಉತ್ತರನೊ ರಾಜೊ಼ ವರಿ ಫರಿನ ಪೈಲಾತಿಬಿ ಮ್ಹೊಟು ಮನಕ್ಹೊನು ಗುಂಪ ಹುಬ್ರಾಡಿನ ದಕ್ಹಾ ವರಕ್ಹ ಥಯಲ್ಪರ ಮ್ಹೊಟಾ ಸೈನ್ಯನಾ ಕ್ಹಾತೆ ಆಯುದೊನಾ ಕ್ಹಾತೆ ವರಿ ಕ್ಹರಿಜಾ಼ವಸ <verse eid="DAN 11:13" /><verse number="14" style="v" sid="DAN 11:14" />ತೆಜ಼ ಕಾಲಮಾ ದಕ್ಷಿಣ ರಾಜಾ಼ನಾ ವಿರುದ್ದ ಥೈನ ಹುಬ್ರಿವಸ ನೈತೊ ತಾರಾ ಮನಕ್ಹೊಮಾ ಚೊಟ್ಟಾ ತೆ ದರ್ಶನ ಸ್ಥಾಪನೆ ಕರುಕೈನ ತ್ಯುನಾಕ್ಹು ತ್ಯುನೆಜ಼ ದಂಗೊ ಉಟಾಡಿಲಿವಸ ವರಿಬಿ ತ್ಯುನೆ ಪಡಿಜಾ಼ವಸ <verse eid="DAN 11:14" /><verse number="15" style="v" sid="DAN 11:15" />ವರಿ ಉತ್ತರನೊ ರಾಜಪರ ಮುತ್ತಿಗೆ ಘಾಲಿನ ಕೊಟೆ ರ‍್ಹಯಲ ಗಾಮೊ ವಶಮಾ ಕರಿಲಿವಸ ದಕ್ಷಣನೊ ರಾಜೊ಼ ತಾಕತವರ ರ‍್ಹೈತಬಿ ತೆ ಇನಿಲಿನ ಮನಕ್ಹೊಬಿ ಹುಬ್ರಾವಾನೆಬಿ ತಾಕತ ರ‍್ಹತಿ ನೈ. <verse eid="DAN 11:15" /><verse number="16" style="v" sid="DAN 11:16" />ತೆನೈಸೊ ತಿನಾ ಕ್ಹಾಮೊ ಆವಾಲೊ ತಿನಾ ಮನಸಮಾ ಆಯಲ ತಿಮ್ಮ ಕರಸ ಕುನ್ನಜ ತಿನಾ ಕ್ಹಾಮು ಹುಬ್ರೆತು ನೈ. ತೆ ಚೊ಼ಕಾ ದೆಶಮಾ ರ‍್ಹವಸ.ತೆ ಕ್ಹಾರು ತಿನಾ ಹತ್ತಕ್ಹು ನಾಶ ಥಾವಸ. <verse eid="DAN 11:16" /><verse number="17" style="v" sid="DAN 11:17" />ತೆ ತಿನಿ ರಾಜ್ಯನಿ ಕ್ಹಾರಿ ತಾಕತನಾ ಕ್ಹಾತೆ ಗೈನ ತಿನಾ ಕ್ಹಾಮೊ ಆವಸ ಕ್ಹರಿಕ್ಹು ರ‍್ಹಯಲವಾಲಾ ತಿನಾಕ್ಹಾತೆ ರ‍್ಹವಸ ಇಮ್ಮ ತೆ ಕರಸ ವರಿ ಛೊಕ್ರಿನೆ ಕೆಡಸಾನಾಹುತಿ ತಿನೆ ದಿವಸ ತೆನೈಸೊ ತೆ ತಿನಾ ಕೆಟ್ಟ ಹುಬ್ರೆತು ನೈ. <verse eid="DAN 11:17" /><verse number="18" style="v" sid="DAN 11:18" />ಎ ಥಯಲ್ಪರ ತೆ ತಿನು ಮ್ಹೊಡು ದಿವಾ ಬಗಲ ಫರೈನ ಘನಾ ಜನಾವೊನೆ ವಶಮಾ ಕರಿಲಿವಸ ತೆನೈಸೊ ಯಕ್ಲೊ ಅದಿಪತಿ ಕ್ಹುದ್ದನಾಹುತಿ ತಿನೆ ಕದ್ರಾವಸ ತೆ ನಿಂದಾಕ್ಹು ತಿನಾಪರ ಘಾಲಿದೆವಾಚಿ ತಿಪರಜ಼ ಘಾಲಿಪಡಸ. <verse eid="DAN 11:18" /><verse number="19" style="v" sid="DAN 11:19" />ತೆಳಾಮಾ ತೆ ತಿನಾ ಕ್ಹುದ್ದನಾ ದೆಶನಾ ಕ್ಹಾಮೊ ಮ್ಹೊಡು ಫರೈನ ವರಿ ತೆ ಪಡಿನ ದಿಕ್ಹಿನ ಆತೊ ನೈ. <verse eid="DAN 11:19" /><verse number="20" style="v" sid="DAN 11:20" />ತೆಳಾಮಾ ತಿನಾ ಬದಲ ಚೊ಼ಕು ರಾಜ್ಯಮಾ ಆಕ್ರಮಣ ಕರಿನ ತೆ ಜ಼ಗಾಪರ ಹುಬ್ರೆವಸ ವರಿ ತೆ ದಕ್ಹಾ ದಿನೊ ಥಯಲ್ಪರ ತೆ ನಾಶ ಥಾವಸ. <verse eid="DAN 11:20" /><verse number="21" style="v" sid="DAN 11:21" />ತಿನಿ ಜ಼ಗಾಪರ ಯಕ್ಲೊ ಕೆಟ್ಟ ಮನಕ್ಹ ಹುಬ್ರೆವಸ ತಿನಿ ರಾಜ಼ವಾಡನೆ ಮರ್ಯಾದಿ ದೆತಾ ನೈ ತೆ ತಿನಿ ಮಯಾಕ್ಹು ತೆ ರಾಜ್ಯನೆ ಝಿತ್ತಿ ಲಿವಸ. <verse eid="DAN 11:21" /><verse number="22" style="v" sid="DAN 11:22" />ಪ್ರವಾಹ ನಿಂಗತ ರ‍್ಹಯಲ ತೆ ಚಕ್ರಾ ಮ್ಹೊಟು ವಡಂಬಡಿಕೆನು ಮ್ಹೊಟೊ ತಿನಿ ಜ಼ೊರತನಾಮಾ ರಬಸ ಅಟ್ಕಿನ ಭಗೈಜಾ಼ವಸ <verse eid="DAN 11:22" /><verse number="23" style="v" sid="DAN 11:23" />ತಿನಾಕ್ಹತೆ ಸಮಾಧಾನ ಕರಿಲಿದಲ್ಪರ ಕಪಟ್ಯೊ ಥೈನ ಚಾ಼ಲಸ ದಕ್ಹಾಮನಕ್ಹೊನಾ ಮದತಕ್ಹು ಉಪ್ಪರ ಉಟಸ. <verse eid="DAN 11:23" /><verse number="24" style="v" sid="DAN 11:24" />ತಿನೆ ಸಮಾಧಾನಿ ಸಂಸ್ಥಾನಮಾ ಫಲ ದಿವಾನಾ ದೆಶ್ಯೊಮಾ ಹೊಕ್ಕಿನ ಬಾಪ ಬುಡಾ ನೈಸೊ ಕರಲ ಕಾಮ ಕರಸ. ಕಾಳ್ಳಿವಾನು ಮೊಸ ಕರಿನ ಕಾಳ್ಳಿದಲ ಲುಟಿ ಲಿದಲ ಕ್ಹಾರುಜ಼ ತ್ಯುನೊಮಾ ನಾಕಿ ಪಡಸ ಹೊ ಕೊಟೆಮಾ ಧರಾನು ಕುತಂತ್ರ ದಡಿ ರ‍್ಹಯೆ ಕಾಲಲಕ್ಕಾ ದೆಕಾಡಿನ ದಿವಸ. <verse eid="DAN 11:24" /><verse number="25" style="v" sid="DAN 11:25" />ತೆ ದಕ್ಷಿಣನಾ ರಾಜಾ಼ನೆ ವಿರೊದ ಥೈನ ತಿನಿ ತಾಕತಕ್ಹು ಧೈರ್ಯಕ್ಹು ಮ್ಹೊಟಿ ಸೈನ್ಯನಾಕ್ಹಾತೆ ಉಟಿನ ಆವಸ. ವರಿಬಿ ತ್ಯುನೆ ಹುಬ್ರೆವಾಚಿ ಗೈಪಡಸ ಕಾಕದ್ಯಾಮ ಮ್ಹೈನಾ ಮ್ಹೈ ಫಸಲೊ ಕರಲ ರ‍್ಹವಸ. <verse eid="DAN 11:25" /><verse number="26" style="v" sid="DAN 11:26" />ಹೊ, ತ್ಯುನೆ ರಾಜ಼ವಾಡಾಮಾ ಅನ್ನನು ಅರ್ದು ಭಾಗ ಕ್ಹಾದಲವಾಲಾಜ಼ ತ್ಯುನೊನೆ ನಾಶ ಕರಸ ತ್ಯುನಿ ಸೈನ್ಯ ಭರಲ ರ‍್ಹವಸ ವರಿ ದಕ್ಹಾಜ಼ನಾ ಕ್ಹಲಾಸ ಥಾವಸ. <verse eid="DAN 11:26" /><verse number="27" style="v" sid="DAN 11:27" />ಎ ಭಂಬಿ ರಾಜಾ಼ವೊನಾ ಮನಸಮಾ ಕೆಟ್ಟ ಕರಾನುಜ಼ ರ‍್ಹಯಲ ರ‍್ಹವಸ ಯಕ್ಕಜ಼ ಟೆಬಲ್ಪರ ಬೈಟಿನ ಸುಳ್ಳ ಬೊಲಾಲಾ ರ‍್ಹವಸ ವರಿ ತ್ಯುನೊನೆ ಅನುಕುಲ ಥಾತು ನೈ, ತೆ ಕಿಮ್ಮೆಬಿ ಕದಲ ಟೈಮಾಜ಼ ಅಂತ್ಯ ಥಾವಸ. <verse eid="DAN 11:27" /><verse number="28" style="v" sid="DAN 11:28" />ತೆ ತೆಳಾಮಾ ಮ್ಹೊಟಿ ಸೌಕಾರತನಾನಾ ಕ್ಹಾತೆ ಸ್ವಂತ ದೆಶೆ ಫರಿನ ಆವಸ. ತಿನು ಮನಸ ಚೊ಼ಕಾ ಕಾಮೊನೆ ಪವಿತ್ರ ವಡಂಬಡಿಕೆನಾ ವಿರುದ್ದ ಥಯಲ ರ‍್ಹವಸ ತೆ ಇಮ್ಮ ತಿನಾ ಕಾಮೊ ಕರಿನ ಸ್ವಂತ ದೆಶೆ ಫರಿನ ಆವಸ. <verse eid="DAN 11:28" /><verse number="29" style="v" sid="DAN 11:29" />ತೆನೈಸೊ ಕರೆಟ್ಟ ಟೈಮಾ ತೆ ದಕ್ಷಿಣ ಬಗಲ ಫರಿನ ಆವಸ. <verse eid="DAN 11:29" /><verse number="30" style="v" sid="DAN 11:30" />ತೆನೈಸೊ ಪೈಲಾ ಥಯಲ ಬೆವಾಸಲಾ ಥಾತು ನೈ ಕಿತ್ತಿಮಿನಿ ಹಡ್ಗಾ ತಿನಾ ವಿರುದ್ದ ಥೈನ ಆವಸ. ತಿನಾಹುತಿ ತೆ ಹಮೆಶ್ಯಾಬಿ ಪರಿಶುದ್ದ ವಡಂಬಡಿಕೆನೆ ವಿರುದ್ದ ಥೈನ ತೆ ಶಿಟ್ಟಮಾ ಇಮ್ಮ ಕರ್ತೊ ರ‍್ಹವಸ ವರಿ ವಡಂಬಡಿಕೆ ಛೊಡಲವಾಲಾನಾಕ್ಹಾತೆ ಚೊ಼ಕೊ ರ‍್ಹವಸ <verse eid="DAN 11:30" /><verse number="31" style="v" sid="DAN 11:31" />ತಿನಿ ಜ಼ಮಾ ಕರಲ ಸೈನ್ಯ ಆಶ್ರಯನು ದುರ್ಗ ಥಯಲ ಪವಿತ್ರ ಆಲಯನೆ ಹೊಲಸ ಕರಿನ ಹಮೆಶ್ಯಾನು ಬಲಿ ಛೊಡಿನ ಹಾಳ ಕರಾನಾ ಕೆಟ್ಟ ಸಾಮ್ನೊ ಮ್ಹೆಲಸ. <verse eid="DAN 11:31" /><verse number="32" style="v" sid="DAN 11:32" />ವಡಂಬಡಿಕೆನೆ ವಿರುದ್ದ ಥೈನ ಕೆಟ್ಟಥೈನ ಚಾ಼ಲಾವಾಲಾವೊನೆ ಕಾಮನಿ ನೈಸೊ ವಾತೊ ಬೊಲಿನ ಕೆಡ್ಸಸ. ತೆನೈಸೊ ತಿನಾ ಕ್ಹುದಾವೊನೆ ವಳಕಾಲಾ ಮನಕ್ಹೊ ಘಟ್ಟ ಥೈನ ರ‍್ಹವಸ. <verse eid="DAN 11:32" /><verse number="33" style="v" sid="DAN 11:33" />ಮನಕ್ಹೊಮಾ ಗ್ಯಾನಿಯೊ ರ‍್ಹಯಲವಾಲಾ ಘನಾ ಜ಼ನಾವೊನೆ ಬೊದನೆ ಕರಸ. <verse eid="DAN 11:33" /><verse number="34" style="v" sid="DAN 11:34" />ತ್ಯುನೆ ಪಡ್ತಾಮಾ ತ್ಯುನೊನೆ ದಕ್ಹಿ ಮದತ ಮಳಸ. ದಕ್ಹಾಜ಼ನಾ ಮೊಸನಿ ವಾತೊಕ್ಹು ತ್ಯುನಾಕ್ಹಾತೆ ರ‍್ಹವಸ. <verse eid="DAN 11:34" /><verse number="35" style="v" sid="DAN 11:35" />ತೆನೈಸೊ ಅಂತ್ಯ ಕಾಲಲಕ್ಕಾ ತ್ಯುನೊನೆ ಪರಿಕ್ಷಾ ಕರಾನಾಹುತಿ ಶುದ್ದ ಕರಾನಾಹುತಿ ಹಸಾ ಕರಾನಾಹುತಿ ದಕ್ಹಾ ಗ್ಯಾನಿಯೊ ಪಡಿ ಜಾ಼ವಸ. ಎ ಅಂತ್ಯ ಥೈನ ರ‍್ಹವಸ. <verse eid="DAN 11:35" /><verse number="36" style="v" sid="DAN 11:36" />ರಾಜೊ಼ ತಿನಾ ಮನಸಮಾ ಆಯಲ ತಿಮ್ಮ ಕರಸ. ತಿನಾಕ್ಹು ತೆ ಹೆಚ್ಕಿ ಕರೈಲಿನ ತಿನೆ ಕ್ಹಾರಾ ಕ್ಹುದಾವೊತಿ ಮ್ಹೊಟೊ ವ್ಹೈ ಕೈನ ಕರಲಿನ ಕ್ಹುದಾನಾ ವಿರುದ್ದ ಘಾಬ್ರಾ ಥಾವಾನಾ ಸಂಗತಿಯೊ ಬೊಲಿನ ಶಿಟ್ಟ ಫರೆಲಕ್ಕಾ <verse eid="DAN 11:36" /><verse number="37" style="v" sid="DAN 11:37" />ತೆ ತಿನಾ ಪಿತೃವೊನಾ ಕ್ಹುದಾನೆ ರ‍್ಹವಾದೆ ಬಾಕ್ಡಿಯೊನು ಕ್ಹುದಾವೊನೆ ರ‍್ಹವಾದೆ ಧ್ಯಾನ ದೆತೊ ನೈ ಕಯಾಜ಼ ಕ್ಹುದಾನೆ ಧ್ಯಾನ ದೆತೊ ನೈ ತೆ ಕ್ಹಾರಾವೊತಿ ಮ್ಹೊಟೊ ವ್ಹೈ ಕೈನ ಕೈಲಿವಸ. <verse eid="DAN 11:37" /><verse number="38" style="v" sid="DAN 11:38" />ತೆನೈಸೊ ತೆ ತಿನಿ ಜ಼ಗಾಪರ ಕ್ಹುದಾನಿ ತಾಕತ ತಿನಾ ಪಿತೃವೊ ನೈ ವಳಕಲ ಕ್ಹುದಾವೊನೆ ಮರ್ಯಾದಿ ದಿವಸ. ಕ್ಹೊನಾಕ್ಹು ರುಪ್ಪಾಕ್ಹು ಚೊ಼ಕಾ ದಗ್ಡಾವೊಕ್ಹು ಚೊ಼ಕು ರ‍್ಹಯಲನೆ ಯಕ್ಕಜ಼ ಮರ್ಯಾದಿ ದಿವಸ. <verse eid="DAN 11:38" /><verse number="39" style="v" sid="DAN 11:39" />ಇಮ್ಮ ಬಿಜಾ಼ ಕ್ಹುದಾನಿ ಮದತಕ್ಹು ಘನ್ನಿ ತಾಕತ ರ‍್ಹಯಲ ಕೊಟೆನೆ ಆಕ್ರಮಣ ಕರಸ ತೆಕಿನೆ ಮರ್ಗಸ ತಿನೆ ಮರ್ಯಾದಿ ದಿವಸ ಘನ್ನಾ ಮನಕ್ಹೊನೆ ಆಳತಿನೆ ದಿವಸ. <verse eid="DAN 11:39" /><verse number="40" style="v" sid="DAN 11:40" />ಅಂತ್ಯ ಕಾಲಮಾ ದಕ್ಷಿಣೊ ರಾಜೊ಼ ತಿಪರ ಪಡಸ. ಉತ್ತರನೊ ರಾಜೊ಼ ರಥೊನಾಕ್ಹಾತೆ ಸವಾರೊನಾಕ್ಹಾತೆ ಹಡ್ಗಾವೊನಾ ಕ್ಹಾತೆ ತುಫಾನನಾ ವಾರಾ ನಿಂಗತ ತಿನಾ ವಿರೊದ ಥೈನ ತ್ಯುನೊನೆ ನಾಶ ಕರಿ ಪಡಸ. <verse eid="DAN 11:40" /><verse number="41" style="v" sid="DAN 11:41" />ತೆನೈಸೊ ಚೊ಼ಕಾ ರ‍್ಹಯಲ ದೆಶ್ಯೊಮಾ ಹೊಕ್ಕಿನ ತ್ಯುನೊನೆ ಹಾಳ ಕರಿ ಪಡಸ. ತೆನೈಸೊ ಎದೊಮು, ಮೊವಾಬು, ಅಮೊನನಾ ಬಚ್ಚಾವೊಮಾ ಮ್ಹೊಟಾ ತಿನಾ ಹತೆ ಚು಼ಕೈ ಲಿವಸ <verse eid="DAN 11:41" /><verse number="42" style="v" sid="DAN 11:42" />ತೆ ದೆಶೊನಾ ಉಪ್ಪರ ತಿನಾ ಹತೊ ಅಗೊ ಕರಸ. ಐಗುಪ್ತ ದೆಶ ನೈ ಚು಼ಕೈಲೆತು. <verse eid="DAN 11:42" /><verse number="43" style="v" sid="DAN 11:43" />ಕ್ಹೊನು ರುಪ್ಪು ಭೊಕ್ಕಸೊಪರ ವರಿ ಕ್ಹಾರಾ ಮೊಗಾನಾ ಸಾಮ್ನೊಪರ ತಿನೆ ಅದಿಕಾರ ರ‍್ಹವಸ.ಲುಬ್ಯರು ಐಥೊಪ್ಯೊ ತಿನಾ ಪಾಚಾ ಆವಸ. <verse eid="DAN 11:43" /><verse number="44" style="v" sid="DAN 11:44" />ಮೂಡಣತಾ ಉತ್ತರತಾ ಆವಾನಿಯೊ ಸುದ್ದಿಯೊ ತಿನೆ ಬುಚ್ಕಾಡಸ ತಿನಾಹುತಿ ತೆ ಘನೊ ಶಿಟ್ಟ ಥೈನ ತ್ಯುನೊನೆ ಕ್ಹಲಾಸ ಕರಾನೆ ಜಾ಼ವಸ. <verse eid="DAN 11:44" /><verse number="45" style="v" sid="DAN 11:45" />ತೆ ತಿನು ರಾಜ಼ವಾಡಾನು ಗುಡಾರೊ ಸಮಂದರ ವರಿ ಚೊ಼ಕಾ ಡೊಂಗರನಾ ವಚ್ಮಾ಼ ರಾಜ್ವಾ಼ಡಾ ನಿಂಗತ ರ‍್ಹಯಲ ಝುಪ್ಡು ಭಾಂದಸ ವರಿಬಿ ತಿನು ಅಂತ್ಯ ಥಾವಸ ಕುನ್ನಜ಼ ತಿನೆ ಮದತ ಕರ್ತು ನೈ.<verse eid="DAN 11:45" /></para>
  <chapter eid="DAN 11" />
  <chapter number="12" style="c" sid="DAN 12" />
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1" />ತಾರಾ ಮನಕ್ಹೊನೊ ಪಕ್ಷ ಧರಿಲಿದಲ ಮಹಾಪಾಲಕ ಥಯಲ ಮಿಕಾಯೆಲ ತೆ ಕಾಲಮಾ ಉಟಸ ಪೈಲಾತಿ ಪೈಲಾ ಜನಾಂಗ ಹುಟ್ಟಲ ದಿನತಾಬಿ ತಯಾಲಕ್ಕಾ ಥಾವಾನಿ ತ್ರಾಸ ಥಾವಸ; ತೆಳಾಮಾ ತಾರಾ ಮನಕ್ಹೊಮಾ ಕಯಾ ನಾಮೊ ಸುರಳಿಮಾ ರ‍್ಹವಸತೊ ತ್ಯುನೆ ಕ್ಹಾರಾಜ಼ ವಾಚ಼ಸ. <verse eid="DAN 12:1" /><verse number="2" style="v" sid="DAN 12:2" />ಧುಳನಿ ಜಿಮಿನ್ಮಾ ಘನ್ನಿ ನಿಂದರ ಕರಾಲಾವೊಮಾ ಘನ್ನಾ ಜ಼ನಾ ಉಟಿನ ದಕ್ಹಾಜ಼ನಾ ಹಮೆಶಾನೊ ಜ಼ಲಮ ಹೊಂದಿನ ದಕ್ಹಾಜ಼ನಾ ಹಮೆಶಾ ಠುಕ್ರಾವಾನು ಅನುಭವಿಸಸ. <verse eid="DAN 12:2" /><verse number="3" style="v" sid="DAN 12:3" />ಗ್ಯಾನಿಯೊ ಘನ್ನು ಉಜಾಲು ರ‍್ಹಯಲ ಹಬಾಳನಿಂಗತ ಮಿಂಚ಼ಸ ಘನಾ ಜ಼ನಾವೊನೆ ನಿತಿವಂತವಾಲಾ ಕರಸ. ಹಮೆಶಾಬಿ ಚಿಕ್ಕಿಯೊನಾ ನಿಂಗತ ಮಿಂಚ಼ಸ. <verse eid="DAN 12:3" /><verse number="4" style="v" sid="DAN 12:4" />ದಾನಿಯಲ, ತು ಎ ವಾತೊ ಝಾಕಿನ ಮ್ಹೆಲ, ತೆ ಬರ್ದಾನಾ ಗ್ರಂಥೊನೆ ಚಾವಿ ಘಾಲ, ಲಾಸ್ಟಲಕ್ಕಾ ಝಕೈನ ರ‍್ಹವಾದೆ; ಘನ್ನಾ ಮನಕ್ಹೊ ಹೈತಿ-ಹೈತಿ ಫರಸ, ತಿಳಿವಳಕಿ ಘನ್ನಿ ಥಾಸಕಸ. <verse eid="DAN 12:4" /><verse number="5" style="v" sid="DAN 12:5" />ತೆಳಾಮಾಜ಼ ‘ದಾನಿಯಲ ಥಯಲ ಮಿ ವರಿ ಬೆಜ಼ನಾವೊನೆ ದೆಕ್ಯೊ; ತ್ಯುನೊಮಾತು ಯಕ್ಲೊ ನದ್ದಿನಿ ದಂಡಿಪರ, ಬಿಜೆಕ್ಲೊ ಹಜಿಯಕ್ಕ ದಂಡಿಪರ ಹುಬರಯೊತೊ. <verse eid="DAN 12:5" /><verse number="6" style="v" sid="DAN 12:6" />ಇವ್ನಾನೊಮಾನೊ ಯಕ್ಲೊ ಎ ಕಾಮ ಪುರಾ ಥಾವಾನೆ ಕೆಕ್ಲೊ ಟೈಮ ಥಾವಸ ಕೈನ ನದ್ದಿನಾಮಾ ನಾರು ಮಡಿನಾ ವಣ್ಣಾ ಘಾಲ್ಲಿನ ಪಾನಿಯೊಪರ ಹುಬ್ರಯಲ ದಾಣಗಾನೆ ಎ ಕ್ಹಾರು ಕೆಳಾಮಾ ಥಾವಸ? ಕೈನ ಪುಚ್ತಾ಼ಮಾ. <verse eid="DAN 12:6" /><verse number="7" style="v" sid="DAN 12:7" />ತೆ ದಾಣಗೊ ಭಂಬಿ ಹತೊ ಉಚೈನ ಹಬಾಳನೆ ದೆಕಾಡಿನ ಹಮೆಶಾಬಿ ರ‍್ಹವಾಲೊ ಹಮೆಶಾಬಿ ಜ್ಯುತೊ ರ‍್ಹವಾಲಾನಿ ಕ್ಹಮ, ಯಕ್ಕಕಾಲ ಅರ್ಧುಕಾಲ ಕ್ಹಾರು ಕಾಲ ಜೌ಼; ಕ್ಹುದಾನಾ ಮನಕ್ಹೊಪರ ತ್ರಾಸೊನಿ ತಾಕತ ಭಗಾಯ್ಪರ ಎ ಕ್ಹಾರುಜ಼ ಪುರಾ ಥಾವಸ. ಕವಾನು ಮನೆ ಐಕು ಆವಾವರಕ್ಹು ಕದ್ಯೊ. <verse eid="DAN 12:7" /><verse number="8" style="v" sid="DAN 12:8" />ತೆ ಕದಲ ಮನೆ ಐಕು ಆಯುತಬಿ ತೆ ಮನೆ ಕಳ್ಯು ನೈ; ತೆಳಮಾ ಮಿ ಮಾರಾ ಮಾಲಕ ಎಕಾಮೊನಾ ಮರಿಣಾಮ ಸು ವೈ ಕೈನ ಪುಚ್ತಾ಼ಮಾ <verse eid="DAN 12:8" /><verse number="9" style="v" sid="DAN 12:9" />ತೆ ದಾನಿಯಲ ಎ ವಾತೊ ಅಂತ್ಯಕಾಲಲಕ್ಕಾ ಝಾಕಿನ ಶಿಕ್ಕೊ ಮಾರಿನ ಜಾ಼. <verse eid="DAN 12:9" /><verse number="10" style="v" sid="DAN 12:10" />ಘನ್ನಾ ಜ಼ನಾ ತ್ಯುನಾಕ್ಹು ತ್ಯುನೆಜ಼ ಶುದ್ದಕರಿಲಿನ ಹಸಾ ಕರಿಲಿನ ಶುದ್ದಥಾವಸ; ದುಷ್ಟೊ ದುಷ್ಟೊಮಾ ತೆ ಕಿನೆಜ಼ ಗ್ವತ್ತ ಥಾತು ನೈ. ಗ್ಯಾನಿಯೊನೆ ಯಕ್ಕಜ಼ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="DAN 12:10" /><verse number="11" style="v" sid="DAN 12:11" />ಹಮೆಶಾನು ಹೊಮಾ ಕರಿನ ಹಾಳಕರಾನು ಹಸೈ ಸಾಮನ ಮುಕ್ಕಲ್ಪರ ಥಯಲ್ಪರ ಯಕ್ಕ ಹಜಾ಼ರ ಬೆಕ್ಹೊನ ನವ್ವದ ದಿನೊ ಥೌ. <verse eid="DAN 12:11" /><verse number="12" style="v" sid="DAN 12:12" />ಕೈದಿಲಿನ ಯಕ್ಕ ಹಜಾ಼ರ ತನಕ್ಹೊನೆ ಮುವತೈದದಿನೊನಾ ಲಾಸ್ಟಲಕ್ಕಾ ಕೈದಿನ ವರಿ ತಡ್ದಿಲಿವಾಲೊ ಧನೈ ವ್ಹೈ. <verse eid="DAN 12:12" /><verse number="13" style="v" sid="DAN 12:13" />ತು ಗೈನ ಲಾಸ್ಟಲಕ್ಕಾ ರ‍್ಹೆ; ತು ಘನ್ನಿ ನಿಂದರಮಾ ರ‍್ಹೈನ ದುನಿಯಾ ಮುಗ್ದೆಲಕ್ಕಾ ಉಟಿನ ತು ಥಾವಾನು ತುನೆ ಮಳಾನಿ ಜ಼ಗಾಪರ ಹುಬರೆಸಿ ಕದ್ಯೊ.<verse eid="DAN 12:13" /></para>
  <chapter eid="DAN 12" />
</usx>