<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Shikilagar</book>
  <para style="h">1 ಪೆತ್ರಾ</para>
  <para style="toc3">1 ಪೆತ್ರಾ</para>
  <para style="toc2">1 ಪೆತ್ರಾ</para>
  <para style="toc1">1 ಪೆತ್ರಾ ಬರ್ದಲ ಪೈಲಾ ಪತ್ರ</para>
  <para style="mt2">ಪೆತ್ರಾನು ಬರೆದ ಮೊದಲನೆಯ ಪತ್ರಿಕೆ</para>
  <para style="mt1">1 ಪೆತ್ರಾ ಬರ್ದಲ ಪೈಲಾ ಪತ್ರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಪೆತ್ರಾ ಬರ್ದಲ ಪೈಲಾ ಪತ್ರ ಅಪೊಸ್ತಲ ಥಯಲ ಪೆತ್ರಾ ಲಿಕ್ಯೊಸ. ಪೆತ್ರಾ ಆಂ ಪತ್ರ ಬರದತಾಕ್ಹು ಕುನ್ನ ವ್ಹೈ ವರಿ ಕಿನೆ ಲಿಕ್ಕಾಡೊಸ ಕೈನ ಕವಸ. ತೆ ಆ ಪತ್ರ ವಳಕ ನೈಸೊ ವಾಲಾವೊನೆ ಕೈನ ತೆ ಲಿಕ್ಕಾನು ಕ್ಹಾರಾ ಕ್ರಿಸ್ತ ವಿಸ್ವಾಸಿಯೊನೆ ಬರ್ದ್ಯೊಸ. <char style="xt"><ref loc="1PE 1:11-2:11">1:11-17—2:11</ref></char> ತೆ ತಿನು ಪತ್ರ ಕುನ್ನ ಓದಸ ತ್ಯುನೊನೆ ಘನ್ನಿ ಸಲಾ ಅಮ್ಮ ಲಿಕ್ಯೊಸ ಕಾಕದ್ಯಾಮ ತ್ಯುನೊನೆ ಬಿಜಾ಼-ಬಿಜಾ಼ ದೆಶೊಮಾ ಫೈಲಿ ಗಯಾತಾ. ಕಾಕದ್ಯಾಮ ಆ ಪತ್ರ ಪೌಲಾ ಎಫೆಸನಾ ಸಬೆವಾಲಾವೊನೆ ಬರ್ದಲ ಪತ್ರಾನಾ ನಿಂಗತ ಘನ್ನಾ ವಿಷಯ ಅಮಾ ಛೆ. ಘನ್ನಾ ಮನಕ್ಹೊ ಪತ್ರಾ ಬರ್ದಲ ಪೈಲಾ ಪತ್ರ ಎಫೆಸ ಸಭೆನೆ ಬರ್ದಲ ಪತ್ರ ಥಯಲ್ಪರ ಕದ್ಯಾಮ ಕ್ರಿಸ್ತ ಹುಟಲ್ಪರ ಜಾಸ್ತ ಕಮ್ಮ ಕದ್ಯಾಮ 65 ವರಕ್ಹ ಮಾ ಬರ್ದ್ಯಾಸ ಕೈನ ಬರೊಕ್ಹೊ ಕರಸ ಪೆತ್ರಾ ಆ ಪತ್ರ ತೆ ಬಾಬಿಲೊನ ಕವಾನಾ ರೊಮಾ ಗಾಮಮಾ ಬರ್ದ್ಯೊಸ. ಪೆತ್ರಾ ತುಮೊನೆ ಪ್ರೊತ್ಸಾಹ ಕರಾನೆ ವರಿ ಆ ಕ್ಹರಿನು ಕ್ಹುದಾನಾ ಕೃಪಾ ಕೈನ ಸಾಕ್ಷಿ ದಿವಾನೆ ವ್ಹೈ ಕೈನ ಕವಾನಾ ಮುಲಕ ತೆ ಲಿಕ್ಕಲ ಪತ್ರನು ಉದ್ದೆಶ ದೆಕಾಡಿನ ದಿವಸ</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1) ಪೆತ್ರಾ ತೆ ಕುನ್ನ ವ್ಹೈ ವರಿ ತೆ ಕಿನಾಹುತಿ ಆ ಪತ್ರ ಬರ್ದಾಡ್ಯೊಸ ಕೈನ ಕವಸ <char style="ior"><ref loc="1PE 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2) ವರಿ ತೆ ತಿಮ್ಮ ಮಳಿನ ರ‍್ಹವಾನಾ ಹುತಿ ವರಿ ರಕ್ಷಣೆನಾ ಹುತಿ ಕ್ಹುದಾನೆ ಧನ್ಯವಾದ ಕರಸ <char style="ior"><ref loc="1PE 1:3-2:10">1:3—2:10</ref></char></para>
  <para style="io1">3) ತೆ ಥಯಲ್ಪರ ಆ ಲೊಕಮಾ ವಿಶ್ವಾಸಿಯೊ ಕಿಮ್ಮ ರ‍್ಹೌ ವರಿ ಅಪ್ನಾ ಸಂಬದೊನಾ ವಿಷಯಮಾ ಕದ್ಯಾಮ ಮ್ಹೊಟಿ ಬೈಕೊ ಕಾಮವಾಲೊ ಮಾಲಕನಾ ವಿಷಯಮಾ ಕವಸ <char style="ior"><ref loc="1PE 2:11-4:11">2:11—4:11</ref></char></para>
  <para style="io1">4) ತೆ ಥಯಲ್ಪರ ಪೆತ್ರಾ ಕಷ್ಟ ಆತಾಮಾ ಕಿಮ್ಮ ತಡದಿಲಿನ ರ‍್ಹವೊ ಕೈನ ಕವಸ <char style="ior"><ref loc="1PE 4:12">4:12</ref></char> <char style="ior"><ref loc="1PE 5:11">5:11</ref></char>)</para>
  <para style="io1">5) ತೆಳಾಮಾ ತೆ ತಿನು ಪತ್ರ ಕ್ಹರಾವಸ <char style="ior"><ref loc="1PE 5:12">5:12</ref></char></para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />ಯೆಸು ಕ್ರಿಸ್ತನೊ ಅಪೊಸ್ತಲ ಥಯಲ ಪೆತ್ರಾ, ಪೊಂತ ಗಲಾತ್ಯ, ಕಪ್ಪದೊಕ್ಯ, ಎಶ್ಯಾ, ಬಿಥುನಿ ಕವಾನಾ ಭಾರಲ್ಯಾ ಗಾಮೊಮಾ ಜು಼ದಾ ಥೈಗಯಲ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ ಬರ್ದಾನು ಪತ್ರ. <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />ಕ್ಹುದಾ ತುಮೊನೆ ಪರಿಶುದ್ಧ ಕರಾನಾಹುತಿ ಘನ್ನಾ ದಿನ್ನ ಪಾಚೊ಼ ವಿಚಾರ ಕರಲಿದ್ಯೊತೊ. ತುಮೊನೆ ಪರಿಶುದ್ದ ಕರಾನೆ ಪರಿಶುದ್ದ ಆತ್ಮಾನೆ ತುಮೆ ಯೆಸು ಕ್ರಿಸ್ತನಾ ರಗತಕ್ಹು ಪರಿಶುದ್ದ ಥೈನ ತಿನೆ ವಿಧೆಯ ಥೌ ಕೈನ ಕ್ಹುದಾನಿ ವಿಚಾರ ವ್ಹತಿ. ಮರ್ಗಾ ವರಿ ಶಾಂತಿ ತುಮೊನೆ ಜಾಸ್ತಿ ಥಾವಾದೆ.<verse eid="1PE 1:2" /></para>
  <para style="s">ಜಿವ್ತಿ ನಿರಿಕ್ಷೆ</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಬಾ ಥಯಲ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ. ಕ್ಹುದಾ ಮ್ಹೊಟೊ ಮರಗಾವಾಲೊ ವ್ಹೈ. ತೆ ತಿನಿ ಮರಗಾಕ್ಹು ಅಪೊನೆ ನವು ಜ಼ಲಮ ದಿದ್ಯೊಸ. ಮರಲವಾಲಾವೊಮಾತೊ ಉಟಿನ ಆಯಲ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಮುಕಾಂತರ ತೆ ಅಪೊನೆ ವಾಚಾ಼ನೊ ಜ಼ಲಮ ದೆಕಾಡಿನ ದಿವಸ. <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />ಕ್ಹುದಾ ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆ ದಿವಾನಾ ಆಶಿರ್ವಾದಮಾ ಆಸ ಛೆ. ತೆ ತುಮಾರಾಹುತಿ ಪರಲೊಕಮಾ ಮುಕ್ಯಲ ಛೆ. ತೆ ಹಾಳ ನೈ ಥಾತು ವರಿ ನಾಶ ಥಾತು ನೈ. ತಿನಿ ಸುಂದರ್ತಾ ಜವೈಲೆತು ನೈ. <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />ಕ್ಹುದಾನಿ ತಾಕತ ತುಮಾರಾ ಬರೊಕ್ಹಾನಾಹುತಿ ಕೈದಸ. ತುಮೊನೆ ರಕ್ಷಣೆ ಥಾಯೆ ಲಕ್ಕಾ ತುಮೊನೆ ಚೊ಼ಕಿತರಾ ಮುಕ್ಕಸ. ತಯ್ಯಾರ ರ‍್ಹಯಲ ಲಾಸ್ಟನಾ ದಿನ್ಮಾ ತುಮೊನೆ ಮಳಸ.<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />ಎ ತುಮೊನೆ ಘನ್ನಿ ಖುಶಿ ದಿವಸ. ತೆನೈಸೊ ತುಮೊನೆ ದಕ್ಹಾ ದಿನ್ನ ಘನ್ನಿತರಾನಿಯೊ ತ್ರಾಸೊ ಆವಸ ವರಿ ತೆ ತುಮೊನೆ ಘನ್ನು ದುಖ ದಿವಸ. <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />ತುಮಾರೊ ಬರೊಕ್ಹೊ ಘನ್ನೊ ಶುದ್ಧ ಛೆ ಕೈನ ದೆಕಾಡಾನಾಹುತಿ ತೆ ತ್ರಾಸ ಆವಸ. ತುಮಾರೊ ಬರೊಕ್ಹೊ ಚೊ಼ಕಾ ಕ್ಹೊನಾತಿ ಘನ್ನು ಮೊಗು ವ್ಹೈ. ಕ್ಹೊನು ಹಾಳ ಥೈ ಜಾ಼ವಸ ರ‍್ಹೈತಬಿ ತಿನೆ ಆಗಮಾ ಕರಗೈನ ತಿನೆ ಸುಂದರತಾ ದೆಕಾಡಸ. ಯೆಸು ಕ್ರಿಸ್ತ ಅಪೊನೆ ದಿಖ್ತಾಮಾ, ತುಮಾರೊ ಬರೊಕ್ಹೊ ತುಮೊನೆ ಮರ್ಯಾದಿ ದಿಲಾವಸ. <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />ತುಮೆ ಕ್ರಿಸ್ತನೆ ನೈ ದೆಕ್ಯಾತಬಿ ತುಮೆ ತಿನೆ ಮಯಾ ಕರೊಶಿ. ಹಮ್ನಾ ತುಮೆ ತಿನೆ ನೈ ದೆಕ್ಯಾತಬಿ ತಿಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲ್ಯಾಸ. ತುಮೊಮಾ ನೈ ಕವಾನಾ ಅಕ್ಲಿ ಖುಶಿ ಛೆ. ತೆ ಖುಶಿ ಪ್ರಭಾವಕ್ಹು ಛೆ. <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />ಯಾಕೆಂದರೆ ತುಮರಾ ಬರೊಕ್ಹೊನಾಹುತಿ ತುಮಾರಾ ಬರೊಕ್ಹಾನೆ ಯಕ್ಕ ಗುರಿ ಛೆ. ತುಮಾರಿ ಆತ್ಮಾ ವಚಾ಼ಡು ಕವಾನಿ ತೆ ಗುರಿ ವ್ಹೈ. ತುಮಾರಿ ಗುರಿ ಥಯಲ ರಕ್ಷಣೆ ಹೊಂದಿಲಿವೊಶಿ.<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />ಪ್ರವಾದಿ ಎ ರಕ್ಷಣೆನಾಹುತಿ ಚೊ಼ಕಿ ತರಾ ಹುಡ್ಕಿನ ಪರಿಕ್ಷಾ ಕರಾನೆ ಕೊಶಿಶ ಕರ‍್ಯಾ. ತುಮೊನೆ ಅಗಿ ಮಳಾನಿ ಮರಗಾನಾಹುತಿ ತ್ಯುನೆ ಬೊಲ್ಯಾ. <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />ಕ್ರಿಸ್ತನಿ ಆತ್ಮಾ ತ್ಯುನೊಕನ ವ್ಹತಿ. ತೆ ಆತ್ಮಾ ಕ್ರಿಸ್ತನೆ ಥಾವಾನಿ ಕಷ್ಟ ವರಿ ತೆ ಥಯಲಪರ ತಿನೆ ಥಾವಾನಿ ಮಹಿಮಾನಾಹುತಿ ಕತಿತಿ. ತೆ ಪ್ರವಾದಿಯೊ ಆತ್ಮಾ ದೆಕಾಡಾನು ತಿಳ್ದಿಲಿವಾನೆ ಕೊಶಿಶಿ ಕರತಾತಾ. ತೆ ಕ್ಹಾರು ಕೆಳಾಮಾ ಥಾವಸ ವರಿ ತೆ ಟೈಮಮಾ ಜಗತ್ತ ಕಿಮ್ಮ ರ‍್ಹವಸ ಕೈನ ತಿಳ್ದಿಲಿವಾನೆ ಕೊಶಿಶ ಕರ‍್ಯಾತಾ. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />ತೆ ಪ್ರವಾದಿಯೊ ಕರಲ ಸೆವಾ ತುಮಾರಾಹುತಿ ನೈಸೊ ತಿವ್ನಾಹುತಿ ನ್ಹವೈ. ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಥಯು. ಹಮ್ನಾ ತುಮೆ ಐಕಲ ಸಂಗತಿಯೊ ತ್ಯುನೆ ಕತಾಮಾ ತ್ಯುನೆ ತುಮಾರಿ ಸೆವೆ ಕರಾಡಾತಾ. ಸ್ವರ್ಗಾತಾ ಮೊಕ್ಲಲ ಪವಿತ್ರ ಆತ್ಮಾನಾ ಆಸ್ರಾಕ್ಹು ಸುವಾರ್ತೆ ಕದಲವಾಲಾಜ಼ ಎ ಸಂಗತಿಯೊ ಕದ್ಯಾ. ತ್ಯುನೊನೆ ತಿಳಸಲ ಸಂಗತಿಯೊನಾಹುತಿ ತಿಳದಿಲಿವಾನೆ ದೆವ ದುತೊ ಕೈದಾಡಾಸ.<verse eid="1PE 1:12" /></para>
  <para style="s">ಪರಿಶುದ್ದ ಜಿವಿತನೆ ಬಲಾವಾನು</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />ತಿನಾಹುತಿ ತುಮೆ ತುಮಾರು ಮನಸ ಸೆವೆನಾಹುತಿ ತಯ್ಯಾರ ಕರಿಲಿವೊ. ತೆನೈಸೊ ತುಮೊನೆ ತುಮಾರಿ ಹತೊಟಿಮಾ ಮ್ಹೆಲ್ಲಿವೊ. ಯೆಸು ಕ್ರಿಸ್ತ ಅಪೊನೆ ದಿಕ್ಹಾನಾ ಟೈಮಮಾ ತುಮೊನೆ ಮಳಾನಿ ಮರಗಾ ವರಿ ಮಳಾನಿ ವರಾಪರ ತುಮಾರಿ ಆಸ ಪುರಾ ರ‍್ಹೌ. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />ತುಮೆ ಪೈಲಾ ಎ ಸಂಗತಿಯೊನಾಹುತಿ ನೈ ತಿಳದಿಲಿದಲಕ್ಹು, ತುಮೆ ತುಮಾರಾ ಮನಸೆ ಆಯಲ ತಿಮ್ಮಜ಼ ಕೆಟ್ಟ ಕಾಮೊ ಕರ‍್ಯಾ. ಹಮ್ನಾ ತುಮೆ ವಿಧೆಯ ಥಯಲ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ ವ್ಹೈ. ತಿನಾಹುತಿ ತುಮೆ ಪೈಲಾ ಜಿವ್ನಾ ಕರಲ ತಿಮ್ಮಜ಼ ಹಮ್ನಾ ಕರೊ ನಕೊ. <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />ಕ್ಹುದಾ ಪರಿಶುದ್ಧ ರ‍್ಹಯಲಹುತಿ ತುಮೆ ಬೊಲಾನು ವರಿ ರ‍್ಹವಾನೊ ತರಿಕೊ ಶುದ್ಧ ರ‍್ಹವಾದೆ. ತುಮೊನೆ ಬಲಾಯಲವಾಲೊ ಕ್ಹುದಾಜ಼ ವ್ಹೈ. <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />"ಮಿ ಪರಿಶುದ್ಧ ರ‍್ಹಯಲಕ್ಹು ತುಮೆಬಿ ಪರಿಶುದ್ಧ ಥೈನ ರ‍್ಹೌ" ಕವಾನು ಪವಿತ್ರ ಗ್ರಂಥ ಕವಸ.<verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />ತುಮೆ ಕ್ಹುದಾಕನ ಪ್ರಾಥನಾ ಕರತಾಮಾ ತಿನೆ ಬಾ ಕೈನ ಬಲಾವೊಶಿ. ಕ್ಹುದಾ ಹರಯಕ್ಲಾವೊನೆ ತ್ಯುನಾ-ತ್ಯುನಾ ಕಾಮೊನಿಂಗತ ಪೈಸ್ಲೊ ಕರಸ. ತುಮೆ ಎ ದುನಿಯಾಮಾ ರ‍್ಹವಾಲಾ ವ್ಹೈ ಕೈನ ಕ್ಹುದಾನೆ ಭುಚಿ಼ಕಿನ ಜಿ಼ವ್ಸೊ. <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />ಪೈಲಾ ತುಮೆ ತುಮಾರಾ ಮನಸೆ ಆಯಲ ತಿಮ್ಮ ಜಿವ್ನಾ ಕರ‍್ಯಾತಾ ಕರತಾ ವ್ಹತ್ತಾ ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. ತುಮೊತಿ ಪೈಲಾ ಜಿವ್ನಾ ಕರಲವಾಲಾ ತ್ಯುನೊಕ್ಹು ತುಮೆ ಶಿಕ್ಯಾ. ತಿನಾಹುತಿ ತುಮೊನೆ ಬಿಡುಗಡೆ ಥಾವಾನು ಹಾಳಥಾವಾನು ಕ್ಹೊನಾ ರುಪ್ಪಕ್ಹು ನ್ಹವೈ. <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />ಪುರಾ ಅಂಗಥಯಲ ವರಿ ಪರಿಶುದ್ಧ ಥಯಲ ಬಕ್ರಾನು ಬಚ್ಚು಼ಥಯಲ ಯೆಸುನಾ ರಗತಕ್ಹು ತುಮೊನೆ ಮುಕ್ತಿ ಮಳಿ. <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />ಎ ಜಗತ್ತ ತಯ್ಯಾರ ಥಾವಾತಿ ಅಗ್ದುರಜ಼ ಯೆಸು ಇನೈಲಿದ್ಯೊ. ತೆನೈಸೊ ಎ ಜಗತ ಅಂತ್ಯ ಥಾವಾನಾ ಟೈಮಮಾ ತುಮೊನೆ ದಿಕ್ಹ್ಯೊ. <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />ತುಮೆ ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಕ್ಹುದಾನೆ ವಳಕ್ಯಾ. ಕ್ಹುದಾ ಕ್ರಿಸ್ತನೆ ಮರಲವಾಲಾವೊಮಾತೊ ಜಿವ್ತೊ ಕರಿನ ಉಟಾಡ್ಯೊ. ಪಾಚ಼ಲ್ತೊ ಕ್ಹುದಾ ತಿನೆ ತಾಕತ ದಿದ್ಯೊ. ತಿನಾಹುತಿ ತುಮಾರೊ ಬರೊಕ್ಹೊ ವರಿ ಆಸ ಕ್ಹುದಾಪರ ರ‍್ಹವಾದೆ.<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />ತುಮೆ ಕ್ಹರಿನೆ ವಿಧೆಯ ಥಾವಾನಾ ಮುಲಕ ತುಮೊನೆ ಪರಿಶುದ್ಧ ಕರಲಿದ್ಯಾ. ಹಮ್ನಾ ತುಮೆ ತುಮಾರಾ ಭಾಯೊ ಭೆನೊನೆ ಕ್ಹರಿಮಾಜ಼ ಮಯಾ ಕರಾಲಾ ಥಯಾಸ. ತಿನಾಹುತಿ ಯಕ್ಲಾಪರ ಯಕ್ಲೊ ಮನಸೆ ಮಯಾ ಕರೊ. <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />ತುಮೆ ನವು ಜ಼ಲಮ ಲಿನ ಹುಟ್ಟಲ ನಿಂಗತ ವ್ಹೈ. ಎ ನವೊ ಜ಼ಲಮ ಹಾಳ ಥಾವಾನಾ ಜ಼ಲಮಕ್ಹು ನತ್ತಿ ಲಿದ್ಯಾ. ತೆ ಜ಼ಲಮ ಹಾಳ ನೈ ಥಾವಾನು ಜ಼ಲಮಕ್ಹು ಲಿದ್ಯಾಸ. ಜ಼ಲಮ ರ‍್ಹಯಲ ಹಮೆಶಾ ರ‍್ಹವಾನಾ ಕ್ಹುದಾನಿಯೊ ವಾತೊಕ್ಹು ತುಮೆ ನವೊ ಜ಼ಲಮ ಲಿದ್ಯಾಸ. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />ಕ್ಹುದಾನು ಗ್ರಂಥ ಸು ಕವಸ ಕದ್ಯಾಮ</para>
  <para style="q1" vid="1PE 1:24">ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಚಾ಼ರಾ ನಿಂಗತ ಛೆ.</para>
  <para style="q2" vid="1PE 1:24">ತ್ಯುನೆ ಕರಾನು ಕ್ಹಾರು ಶೊಕ ಚಾ಼ರಾನಾ ಪ್ಹುಲ್ಲೊ ನಿಂಗತ ಛೆ.</para>
  <para style="q1" vid="1PE 1:24">ಚಾ಼ರೊ ವರೈಜಾ಼ವಸ.</para>
  <para style="q2" vid="1PE 1:24">ಪ್ಹುಲ್ಲೊ ಉದ್ರಿ ಜಾ಼ವಸ.<verse eid="1PE 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1PE 1:25" />ತೆನೈಸೊ ಕ್ಹುದಾನಿಯೊ ವಾತೊ ಹಮೆಶಾ ಜಿವ್ತಿಯೊ ರ‍್ಹವಸ. ತೆ ವಾತೊ ಸುವೈ ಕದ್ಯಾಮ ತುಮೊನೆ ಕದಲ ಸುವಾರ್ತಾನಿ ವಾಕ್ಯ ವ್ಹೈ. ಯೆಶಾಯ 40:6-8<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">ಜಿವ್ತೊ ದಗಡೊ ವರಿ ಪವಿತ್ರ ಜನಾಂಗ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />ತಿನಾಹುತಿ ಬಿಜಾ಼ ಮನಕ್ಹೊನೆ ಕೆಟ್ಟ ಕರೊ ನಕೊ. ಸುಳ್ಳ ಬೊಲೊ ನಕೊ, ಮೊಸಕರೊ ನಕೊ, ಸಂಗಟ ಘಾಲ್ಲಿವೊನಕೊ, ಮನಕ್ಹೊನಾಹುತಿ ಕೆಟ್ಟ ವಾತೊ ಬೊಲೊ ನಕೊ. ಎ ಕ್ಹಾರು ತುಮಾರಿ ಜಿವಿತಮಾತಾ ಭಾರಾ ಘಾಲೊ. <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />ಹಮ್ನಾ ಹುಟ್ಟಲ ಬಚ್ಚಾ಼ವೊ ನಿಂಗತ ರ‍್ಹವೊ. ತುಮಾರಿ ಆತ್ಮಾ ಜ಼ತ್ತನ ಕರಲ ನಿಂಗತ ಶುದ್ಧ ದುದ್ದನೆ (ಕ್ಹುದಾನಿಯೊ ವಾತೊ) ಆಸ ಕರೊ. ತುಮೆ ತೆ ಪಿದ್ಯಾಮ ಬೆಳ್ದಿನ ರಕ್ಷಣೆ ವ್ಹಂದೊಶಿ. <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />ತುಮೆ ಹಮ್ನಾಜ಼ ಕ್ಹುದಾನಿ ಚೊ಼ಕಿತನಾನೆ ಸವಾದ ದೆಕ್ಯಾಸ.<verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />ಪ್ರಭು ಥಯಲ ಯೆಸುನೆ ಜ಼ಲಮ ರ‍್ಹಯಲ "ದಗ್ಡೊ ವ್ಹೈ" ಎ ಜಗತ್ನಾ ಮನಕ್ಹೊ ತ್ಯುನೊನೆ ತೆ "ದಗ್ಡೊ" ನಕೊ ಕೈನ ಫೈಸಲೊ ಕರ‍್ಯಾ. ತೆನೈಸೊ ತೆ ಕ್ಹುದಾ ಇನಿಲಿದಲ "ದಗ್ಡೊ" ವ್ಹೈ ತೆ ಕ್ಹುದಾನಿ ನಜ಼ರಮಾ ಚೊ಼ಕೊ ವ್ಹೈ. ತಿನಾಹುತಿ ತಿನಾ ನಜಿಕ ಆವೊ. <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />ತುಮೆಬಿ ಜ಼ಲಮ ರ‍್ಹಯಲ ದಗ್ಡಾ ವ್ಹೈ. ಆತ್ಮಾನೆ ಸಂಬಂದ ಥಯಲ ದೆವಾಲಯ ಥಾವಾಹುತಿ ತುಮೆಜ಼ ತಯ್ಯಾರ ಥಾವಾಡಾಸ; ಕ್ಹುದಾಕ್ಹು ಒಪ್ಪಿಲಿದ್ಯಲ ಆತ್ಮಿಕ ಬಲಿಯೊ ಯೆಸು ಕ್ರಿಸ್ತಕ್ಹು ಕ್ಹುದಾನೆ ದಿವಾನಾ ಪವಿತ್ರ ಯಾಜಕೊ ಥಯಾಸ. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />ಪವಿತ್ರ ಗ್ರಂಥ ಸು ಕವಸ ಕದ್ಯಾಮ</para>
  <para style="q1" vid="1PE 2:6">"ಮಿ ಚೊ಼ಕು ರ‍್ಹಯಲ ಮುಲಾಮಾ ಪಡ್ಯಲ ದಗ್ಡಾನೆ ಇನಿಲಿದ್ಯೊಸ.</para>
  <para style="q2" vid="1PE 2:6">ಮಿ ತೆ ದಗಡಾನೆ ಚಿಯೊನಮಾ ಮ್ಹೆಲ್ಯೊಸ;</para>
  <para style="q2" vid="1PE 2:6">ತುನೆ ಬರೊಕ್ಹೊ ಕರಾಲೊ ಕೆಳಾಮಾಬಿ ನಿರಾಸ ನೈ ಥಾತೊ" ಯೆಶಾಯ 28:16<verse eid="1PE 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 2:7" />ಬರೊಕ್ಹೊ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ತುಮೊನೆ ತೆ ದಗ್ಡೊ (ಯೆಸು) ಘನ್ನೊ ಮೊಗಾನೊ ವ್ಹೈ.</para>
  <para style="q1" vid="1PE 2:7">ತೆನೈಸೊ ನೈ ಬರೊಕ್ಹೊ ಕರಾಲಾ ಮನಕ್ಹೊನೆ ತೆ ಅಮ ಕದ್ಯೊಸ;</para>
  <para style="q2" vid="1PE 2:7">"ಭಾಂದಾವಾಲಾ ನಕೊ ಕೈನ ಛೊಡಲ ದಗ್ಡೊಜ಼ ಮುಲಾನೊ ದಗ್ಡೊ ಥಯೊ" ಕಿರ್ತನೆ. 118:22<verse eid="1PE 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 2:8" />ನೈ ಬರೊಕ್ಹೊ ಕರಾಲಾವೊನೆ ತೆ; "ಮನಕ್ಹೊನೆ ಟೆಕ್ಹ ಲಾಗಾನೊ ದಗ್ಡೊ ಮನಕ್ಹೊನೆ ಪಾಡಾನೊ ದಗ್ಡೊ ಥಯೊಸ" ಯೆಶಾಯ 8:14 ಕ್ಹುದಾನಿ ವಾತ ನೈ ಐಕಾಕ್ಹು ಮನಕ್ಹೊ ಟೆಕ್ಹ ಲಗಾಡ್ಲಿನ್ ಪಡಸ. ತೆ ಮನಕ್ಹೊನೆ ಇಮ್ಮ ಥೌ ಕೈನ ಕ್ಹುದಾನಿ ವಿಚಾ಼ರ ವ್ಹತ್ತಿ. <verse eid="1PE 2:8" /><verse number="9" style="v" sid="1PE 2:9" />ತುಮೆತುಬಿ ಕ್ಹುದಾ ಇನಿಲಿದ್ಯಲ ಜನಾಂಗ ರಾಜಾ಼ನಾ ಖಾಂದಾನನಾ ಯಾಜಕೊ ನೆಮಿಸಲ ಮನಕ್ಹೊ ಕ್ಹುದಾನಾ ಸ್ವಂತ ಮನಕ್ಹೊ ಥಯಾಸ. ಕ್ಹುದಾ ತೆ ಕರ‍ಲ ಘನ್ನಾ ಘಾಬ್ರಾಥಾವಾನಾ ಸಂಗತಿಯೊ ತಿಳಸಾನೆ ತುಮೊನೆ ಅಂದಾರಾಕ್ಹು (ಪಾಪಕ್ಹು) ತಿನಿ ಅದ್ಭುತ ಥಯಲ ಉಜಾ಼ಲಾಮಾ ಬಲೈನ ಲಾಯೊ. <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />ಯಕ್ಕ ಕಾಲಮಾ, ತುಮೆ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊ ನ್ಹೊತಾ ತೆನೈಸೊ ಹಮ್ನಾ ತುಮೆ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊ ಥಯಾಸ. ಪೈಲಾ ತುಮೊನೆ ಮರಗಾ ಮಳಿ ನ್ಹೊತಿ. ತೆನೈಸೊ ಹಮ್ನಾ ತುಮೊನೆ ಕ್ಹುದಾನಿ ಮರಗಾ ಮಳಿಸ.<verse eid="1PE 2:10" /></para>
  <para style="s">ಕ್ಹುದಾನಾ ಆಳೊ</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />ಮಯಾನಾ ದೊಸ್ತೊ, ತುಮೆ ಎ ದುನಿಯಾಮಾ ಫರಾಲಾ ವರಿ ಬಿಜಾ಼ ಗಾಮವಾಲಾ ನಿಂಗತ ಛೆ. ತಿನಾಹುತಿ ತುಮಾರಾ ಅಂಗೊನೆ ಪಸಂದ ರ‍್ಹಯಲ ಕೆಟ್ಟ ಸಂಗತಿಯೊಕ್ಹು ದುರ ರ‍್ಹವೊ. ಎ ತುಮಾರಾ ಜ಼ಲಮನಾ ಆತ್ಮಾನೆ ವಿರುದ್ದ ಥೈನ ಲಡಸ. <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />ಬರೊಕ್ಹೊ ನೈಸೊ ಮನಕ್ಹೊ ಸುತ್ತೆ ಮುತ್ತೆ ಛೆ. ತುಮೆ ತಪ್ಪ ಕರಾಡಾಸ ಕೈನ ತ್ಯುನೆ ಕಸ. ತಿನಾಹುತಿ ಚೊ಼ಕಾ ಥೈನ ರ‍್ಹವೊ. ತುಮೆ ಕರಾನಾ ಚೊ಼ಕಾ ಕಾಮೊ ತ್ಯುನೆ ದೆಕಸ ವರಿ ಕ್ಹುದಾ ಆವಾನಾ ದಿನ್ನೆ ತಿನೆ ಸ್ತುತಿ ಕರಸ.<verse eid="1PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />ಎ ಜಗತ್ನಾ ಅದಿಕಾರಿಯೊನೆ ವಿಧೆಯ ಥೈನ ರ‍್ಹವೊ. ಪ್ರಭುನಾಹುತಿ ಎ ಕ್ಹಾರು ಕರೊ. ಕ್ಹಾರು ಅದಿಕಾರ ರ‍್ಹಯಲ ರಾಜಾ಼ನೆ ವಿಧೆಯ ಥಾವೊ. <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />ರಾಜೊ಼ ಮೊಕ್ಲಾನಾ ಅದಿಕಾರಿಯೊನೆ ವಿಧೆಯ ಥಾವೊ. ತಪ್ಪ ಕರಾಲಾವೊನೆ ಶಿಕ್ಷಾ ದಿವಾನೆ ಚೊ಼ಕು ಕರಾಲಾವೊನೆ ಚೊ಼ಕಾ ವ್ಹೈ ಕೈನ ಕವಾನಾಹುತಿ ತ್ಯುನೊನೆ ವಳಾಯೊಸ.<verse eid="1PE 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1PE 2:15" />ತುಮೆ ಚೊ಼ಕು ಕರತಾಮಾ ತುಮಾರಾಹುತಿ ಕೆಟ್ಟ ವಾತೊ ಬೊಲಾಲಾವೊನೆ ಥಾತು ನೈ. ಕ್ಹುದಾನಿ ಮರ್ಜಿ ಎಜ಼ ವ್ಹೈ. <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />ಸ್ವತಂತ್ರ ಮಳಲವಾಲಾವೊನಿಂಗತ ಜಿವ್ನಾ ಕರೊ. ತೆನೈಸೊ ತುಮೆ ಕರಾನಾ ಕೆಟ್ಟ ಕಾಮೊ ಝಾಕಾನೆ ತೆ ಸ್ವತಂತ್ರ ಉಪಯೊಗ ಕರೊ ನಕೊ. ತುಮೆ ಕ್ಹುದಾನಿ ಸೆವೆ ಕರತಾ ಜಿವ್ತಾ ರ‍್ಹವೊ. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಮರ್ಯಾದಿ ದಿವೊ. ಕ್ಹುದಾನಾ ಘರವಾಲಾ ಭಾಯೊನೆ ಭೆನೊನೆ ಮಯಾಕರೊ. ಕ್ಹುದಾಕ್ಹು ಭುಚ಼ಕೊ ವರಿ ರಾಜಾ಼ನೆ ಮರ್ಯಾದಿ ದಿವೊ.<verse eid="1PE 2:17" /></para>
  <para style="s">ಕ್ರಿಸ್ತನಿ ಶ್ರಮಾನಿ ಉದಾಹರಣೆ</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />ಸೆವೆ ಕರಾಲಾವೊ, ತುಮಾರಾ ಮಾಲಕೊನೆ ರ‍್ಹಯಲ ಅದಿಕಾರ ತುಮೆ ವಪ್ಪಿಲಿವೊ. ಎ ಕ್ಹಾರು ತುಮೆ ಘನ್ನಿ ಮರಯಾದಿಕ್ಹು ಕರೊ. ಚೊ಼ಕಾ ರ‍್ಹಯಲ ವರಿ ಮರಗಾಲಾ ಮಾಲಕೊನೆ ತುಮೆ ವಿಧೆಯ ಥೌ ವರಿ ಕೆಟ್ಟ ರ‍್ಹಯಲ ಮಾಲಕೊನೆಬಿ ವಿಧೆಯ ಥೈನ ರ‍್ಹೌ. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />ಯಕ್ಲಾನೆ ಅನ್ಯಾಯಾ ಥಾತಿ ರ‍್ಹೈಮ ಕ್ಹುದಾನಾಹುತಿ ತಡ್ದಿಲಿನ ಗಯೊಮ ಕ್ಹುದಾ ತಿನೆ ಮೆಚ್ಚಸ.<verse eid="1PE 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1PE 2:20" />ತೆನೈಸೊ ತುಮೆ ತಪ್ಪ ಕರಿನ ಮಾರ ಖಾದ್ಯಾಮ ತುಮೊನೆ ಸು ಫೈದೊ? ತೆನೈಸೊ ಚೊ಼ಕು ಕರಿನ ತುಮೆ ಮಾರಾ ಖಾದ್ಯಾಮ ತೆ ಕ್ಹುದಾನಾ ಕ್ಹಾಮು ಚೊ಼ಕು ವ್ಹೈ. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />ಇನಾಹುತಿ ತುಮೊನೆ ಬಲಾಯಾಸ. ತುಮೊನೆ ರ‍್ಹವಾನೊ ತರಿಕೊ ಯೆಸು ಕ್ರಿಸ್ತಜ಼ ವ್ಹೈ. ತೆ ಕರಲ ನಿಂಗತಜ಼ ತುಮೆ ಕರೊ. ತುಮೊನೆ ತ್ರಾಸ ಆತಾಮಾ ತಡ್ದಿಲಿನ ರ‍್ಹೌ. ಕಾಕದ್ಯಾಮ ಕ್ರಿಸ್ತಬಿ ತ್ರಾಸ ಖಾದ್ಯೊ. <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />"ತೆ ಕಯುಜ಼ ಪಾಪ ಕರ‍್ಯೊ ನೈ. ತಿನಾ ಮ್ಹೊಡಾಮಾತಿ ಕೈಜ಼ ಸುಳ್ಳ ವಾತ ಐ ನೈ" <char style="rq"><ref loc="ISA 53:9">ಯೆಶಾಯ 53:9</ref></char><verse eid="1PE 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1PE 2:23" />ಮನಕ್ಹೊ ಕ್ರಿಸ್ತನೆ ಗಾಳೊ ದಿದ್ಯಾತಬಿ ತ್ಯುನೊನೆ ತೆ ಗಾಳೊ ದಿದ್ಯೊ ನೈ. ತೆ ತ್ರಾಸ ಖಾದ್ಯೊತಬಿ ಮನಕ್ಹೊನೆ ಭುಚ್ಕಾ಼ಡ್ಯೊ ನೈ. ತೆ ತಿನು ಕಾಮ ಕ್ಹುದಾಪರ ಛೊಡ್ಯೊ. ಕ್ಹರಿನೊ ಫೈಸಲೊ ಕರಾಲೊ ಕ್ಹುದಾ ಯಕ್ಲೊಜ಼ ವ್ಹೈ. <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />ಕ್ರಿಸ್ತ ಅಪ್ನಾ ಪಾಪೊ ತಿನಾ ಅಂಗಪರ ಉಚೈಲಿನ ಶಿಲುಬಿಪರ ಚ಼ಡ್ಯೊ. ಅಪೆ ಪಾಪನಾಹುತಿ ಜಿವ್ತಾ ರ‍್ಹಯಾವಾಚಿ಼. ಕ್ಹರಿಕ್ಹು ಜಿವ್ತಾ ರ‍್ಹೌ ಕೈನ ಮನಸ ವ್ಹತ್ತು. ತಿನಾ (ಕ್ರಿಸ್ತನಾ) ದುಕ್ಕೊಕ್ಹು ತುಮೊನೆ ಅರಾಮ ಥಯು. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />ತುಮೆ ವಾಟ ಚು಼ಕಲ ಬಕ್ರಾವೊ ನಿಂಗತ ಛೆ. ವರಿಬಿ ತುಮಾರೊ ಕುರುಬುರ‍್ಯಾಕನ ಕದ್ಯಾಮ ತುಮಾರಿ ಆತ್ಮಾನೆ ವಚಾ಼ಡಾಲಾಕನ ಫರಿನ ಆಯಾಸ.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">ಮಾಟಿ ಬೈಕೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />ಹೆಣ ಮನಕ್ಹೊ, ಇನಾನಿಂಗತಜ಼ ತುಮಾರಾ ಮಾಟಿಯೊನೆ ಅಧಿನ ಥೈನ ರ‍್ಹವೊ. ತ್ಯುನೊಮಾ ದಕ್ಹಾಜ಼಼ನಾ ಕ್ಹುದಾನಿ ವಾಕ್ಯಾನೆ ಅವಿಧೆಯ ರ‍್ಹಯಾತಬಿ <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />ತುಮೆ ಕ್ಹುದಾನಿ ಭಯ ಭಕ್ತಿಮಾ ರ‍್ಹೈನ ಸುಜ಼ ಕಳಂಕ ನೈಸೊ ಜಿವ್ನಾ ಕರಾನು ತುಮೊನೆ ದೆಕಿನ ಕ್ಹುದಾನಿ ವಾಕ್ಯಾ ನೈ ಗ್ವತ್ತ ರ‍್ಹಯುತಬಿ ಕ್ಹುದಾನಿ ವಾಕ್ಯಾಪರ ತುಮೆ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಲ ದೆಕಿನ ತುಮೆ ರ‍್ಹವಾನು ದೆಕಿನ ತ್ಯುನೆ ಶಿಕ್ಕಸ. <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />ಮಾತಾನಾ ಬಾಲೊ ಚೊ಼ಕಿ ತರಾ ವಳ್ಳಿವಾನು ರ‍್ಹೈನೆಕಾ ಕ್ಹೊನಾನು ಸಾಮನ ಚೊ಼ಕಾ ವಣ್ಣಾ ರ‍್ಹೈನೆಕಾ ತುಮಾರಿ ಸುಂದರ್ತಾನೆ ತೆ ಸಾಮನ ಖಾಸ ಥೈನ ರ‍್ಹೌ<verse eid="1PE 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 3:4" />ತುಮೆ ರ‍್ಹವಾನೊ ತರಿಕೊ ಶಾಂತಿ ಸಮಾದಾನ ಥಯಲ ತುಮಾರಾ ಮ್ಹೈ ಚೊ಼ಕು ದಿಕ್ಹಾನು ರ‍್ಹೌ. ತೆ ಸುಂದರತಾ ಹಾಳಥಾತಿ ನೈ. ತೆ ಕ್ಹುದಾನೆ ಘನ್ನು ಮೊಗು ವ್ಹೈ. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />ಘನ್ನಾ ದಿನ್ನಪಾಚಾ಼ ಜಿವ್ತಾ ರ‍್ಹಯಲವಾಲಾ ಕ್ಹುದಾನಿ ವಾಟಮಾ ಚಾ಼ಲಿನ ಪರಿಶುದ್ಧ ಥಯಲ ಹೆಣ ಮನಕ್ಹೊ ಇನಾನಿಂಗತಜ಼ ತಯ್ಯಾರ ಥೈನ ತ್ಯುನೆ ತಿವ್ನಾ ಮಾಟಿಯೊನೆ ಅಧಿನ ಥಯೊತ್ಯೊ. <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />ಮಿ ಸಾರಾಳ ನಿಂಗತ ರ‍್ಹಯಲ ಹೆಣ ಮನಕ್ಹೊನಾಹುತಿ ಕವಾಡೊಸ. ತೆ ತಿನಾ ಮಾಟಿ ರ‍್ಹಯಲ ಅಬ್ರಹಾಮನೆ ವಿಧೆಯ ಥೈನ ವ್ಹತ್ತಿ, ತಿನೆ ತೆ ಮಾರೊ ಮಾಲಕ ಕೈನ ಕತಿತಿ. ಹೆಣ ಮನಕ್ಹೊ ಥಯಲ ತುಮೆ ಭುಚ಼ಕ್ಯಾವಾಚಿ ಕೆಳಾಮಾಬಿ ಚೊ಼ಕು ರ‍್ಹಯಲಜ಼ ಕರಿಯೊಮ, ತುಮೆ ಸಾರಳನಾ ಕ್ಹರಿನಾ ಬಚ್ಚಾ಼ ಥಾವೊಸಿ.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />ದಾಣ್ಗಾವೊ, ಇನಾನಿಂಗತಜ಼ ತುಮೆ ತುಮಾರಿ ಬೈಕೊವೊನೆ ಕಳೈಲಿನ ತ್ಯುನಾ ಕ್ಹಾತೆ ಜಿವ್ನಾ ಕರು. ತುಮೆ ತುಮಾರಿ ಬೈಕೊವೊನೆ ಮರ್ಯಾದಿ ದ್ಯು. ತ್ಯುನೆ ತುಮೊತಿ ತಾಕತ ಕಮ್ಮ ರ‍್ಹಯಲವಾಲಿಯೊ ವ್ಹೈ. ತೆನೈಸೊ ಕ್ಹುದಾ ತುಮೊನೆ ದಿವಾನೊ ಆಶಿರ್ವಾದಜ಼ ಕದ್ಯಾಮ ಕ್ಹರಿನೊ ಜ಼ಲಮ ದಿವಾನು ಮರಗಾ ತುಮಾರಿ ಬೈಕೊವೊನೆಬಿ ದಿವಸ. ತುಮೆ ಅಮ್ಮ ಜಿವ್ನಾ ಕರತಾ ರ‍್ಹಯಾಮ ಪ್ರಾಥನಾ ಕರಾನೆ ತುಮೊನೆ ಅಡು ಥಾತು ನೈ.<verse eid="1PE 3:7" /></para>
  <para style="s">ನಿತಿನಾಹುತಿ ಅನುಭೊಸಾನು ತ್ರಾಸ</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />ತಿನಾಹುತಿ ತುಮೆ ಕ್ಹಾರಾಜ಼ನಾ ಮಳಿನ ಶಾಂತಿಕ್ಹು ರ‍್ಹವೊ. ಯಕ್ನೆ ಯಕ್ಕ ಕಳೈಲಿವಾನು ಕೊಶಿಶ ಕರೊ. ಯಕ್ನೆ ಯಕ್ಕ ಭಾಯೊ ನಿಂಗತ ಮಯಾ ಕರು. ಮರಗಾ ದೆಕಾಡಾಲಾ ವರಿ ಸಮಾದಾನ ರ‍್ಹಯಲವಾಲಾ ಥೌ. <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />ಕೆಟ್ಟ ಕರಲವಾಲಾವೊನೆ ಕೆಟ್ಟ ಕರ‍್ಯಾವಾಚಿ, ಮನಸ ದುಖ ಕರಲವಾನಲಾವೊನೆ ಮನಸ ದುಖ ಕರ‍್ಯಾವಚಿ, ತ್ಯುನೊನೆ ಆಶಿರ್ವಾದ ಕರ ಕೈನ ಕ್ಹುದಾಕನ ಮಾಂಗಿಲಿವೊ ಕಾಕದ್ಯಾಮ ಆಶಿರ್ವಾದ ವ್ಹಂದಿಲಿವಾನೆ ತುಮೆ ಬಲೈಲಿದಲವಾಲಾ ಥಯಾಸ. <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />ಕ್ಹುದಾನು ಬುಕ್ಕ ಸು ಕವಸ ಕದ್ಯಾಮ"</para>
  <para style="q1" vid="1PE 3:10">ಎ ಜಿವಿತ್ಮಾ ಖುಶಿ ರ‍್ಹತಾ ಚೊ಼ಕಾ ದಿನ್ನೊ ಆಸ ಕರಾಲಾ ಕೆಟ್ಟ ವಾತೊ ನೈ ಕವಾಲಾ ಥಾವೊ. ಸುಳ್ಳ ಬೊಲೊ ನಕೊ.<verse eid="1PE 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 3:11" />ತೆ ಕೆಟ್ಟ ಕರ‍್ಯಾವಾಚಿ ಚೊ಼ಕುಜ಼ ಕರೆನಕಾ. ತೆ ಸಮಾದಾನ ಮಳಾನು ದೆಕ್ತೊ ತಿನಾಹುತಿ ತೆ ಮಳಾದೆ ಕೈನ ಕೊಶಿಶ ಕರಾದೆ. <verse eid="1PE 3:11" /><verse number="12" style="v" sid="1PE 3:12" />ಕ್ಹರಿಕ್ಹು ರ‍್ಹಯಲವಾಲಾವೊನಾ ಪ್ರಭು ಕೈದಸ. ತ್ಯುನಿ ಪ್ರಾಥನಾ ಐಕಸ. ತೆನೈಸೊ ಕೆಟ್ಟ ಕರಾಲಾ ಮನಕ್ಹೊನೆ ಪ್ರಭು ವಿರೊದ ಕರಸ. <char style="rq"><ref loc="PSA 34:12-16">ಕಿರ್ತನೆ 34:12-16</ref></char><verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />ತುಮೆ ಕೆಳಾಮಾಬಿ ಚೊ಼ಕೊಜ಼ ಕರಾನು ಕೊಶಿಶ ಕರತಾ ರ‍್ಹಯಾಮ, ಕುನ್ನಜ಼ ತುಮೊನೆ ಕೆಟ್ಟ ನೈ ಕರತು. <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />ತೆನೈಸೊ ಚೊ಼ಕು ಕರತಾಮಾ ತುಮೆ ತ್ರಾಸ ಖಾ ಸಕೊಶಿ. ತೆನೈಸೊ "ತುಮೊನೆ ತ್ರಾಸಮಾ ಘಾಲಾನಾ ಮನಕ್ಹೊನೆ ಭುಚ಼ಕೊ ನಕೊ ವರಿ ಚಿಂತಾ ಕರೊ ನಕೊ" <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />ತ್ಯುನಾ ಧಮ್ಕಿಯೊನೆ ಭುಚ಼ಕ್ಯಾ ಬಗರ ತುಮಾರಾ ಮನಸೊಮಾ ಕ್ರಿಸ್ತಜ಼ ಪ್ರಭು ಥೈನ ರ‍್ಹವಾದೆ. ತುಮೊಮಾ ಯಕ್ಕ ಆಸನೆ ಸು ಆದಾರ ಛೆ ಕೈನ ತುಮೊನೆ ಪುಚ್ಚಾ಼ಲಾ ಹರಿಯಕ್ಲಾನೆ ಜವಾಬ ದಿವಾನೆ ಕೆಳಾಮಾಬಿ ತಯಾರ ಥೈನ ರ‍್ಹವೊ. ತೆನೈಸೊ ಸಾತ್ವಿಕತೆಕ್ಹು ಮರಯಾದಿಕ್ಹು ತ್ಯುನೊನೆ ಜವಾಬ ದಿವೊ.<verse eid="1PE 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1PE 3:16" />ತೆನೈಸೊ ಸಾತ್ವಿಕತೆಕ್ಹು ಮರ್ಯಾದಿಕ್ಹು ತ್ಯುನೊನೆ ಜವಾಬ ದಿವೊ. ತುಮೆ ಕರಾನು ಚೊ಼ಕು ವ್ಹೈ ಕದ್ಯಾಮ ತುಮೊನೆ ಕೆಳಾಮಾಬಿ ತಿಳ್ದಾದಾದೆ ತೆಳಾಮಾ ತುಮೆ ಕ್ರಿಸ್ತಮಾ ಚೊ಼ಕಾ ಥೈನ ಜಿವ್ನಾ ಕರಾನು ದೆಕಿನ ತುಮಾರಾಹುತಿ ಕೆಟ್ಟ ಬೊಲಾಲಾ ತ್ಯುನೆ ಕದಲ ಕೆಟ್ಟ ಕಾಮೊನಾಹುತಿ ಸರಮಾವಸ. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />ಕೆಟ್ಟ ರ‍್ಹಯಲ ಕರಿನ ತ್ರಾಸ ಖಾವಾತಿ ಚೊ಼ಕು ಕರಿನ ತ್ರಾಸ ಖಾವಾನು ಚೊ಼ಕು ವ್ಹೈ. ಹೊ ತೆ ಕ್ಹುದಾನಿ ಆಸ ರ‍್ಹೈಮ ತೆಜ಼ ಚೊ಼ಕು ವ್ಹೈ. <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />ತುಮಾರಾ ಪಾಪೊನಾಹುತಿ ಕ್ರಿಸ್ತ ಯಕ್ಕಸಲಾ ತ್ರಾಸ ಖೈನ ಮರ‍್ಯೊ ಕ್ಹರಿಕ್ಹು ರ‍್ಹಯಲ ತೆ ಅಪರಾದಿಯೊನಾಹುತಿ ಜ಼ಲಮ ದಿದ್ಯೊ. ತುಮೊನೆ ಕ್ಹಾರಾವೊನೆ ಕ್ಹುದಾಕನ ಚ಼ಲಾವಾನಾಹುತಿ ತೆ ತಿಮ್ಮ ಕರ‍್ಯೊ. ತಿನೊ ಅಂಗ ಖಲಾಸ ಕರಾಯಾ. ತೆನೈಸೊ ತೆ ಆತ್ಮಾನಿ ಸಂಬಧಮಾ ಜಿವ್ತೊ ಥಯೊ.<verse eid="1PE 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 3:19" />ಪಾಚ಼ಲ್ತೊ ತೆ ಆತ್ಮಾನಾ ರುಪಮಾ ಗೈನ ಜೆಲಮಾ ರ‍್ಹಯಲ ಆತ್ಮಾವೊನೆ ಕ್ಹುದಾನಿ ವಾತ ಕದ್ಯೊ. <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />ಘನ್ನಾ ದಿನ್ನ ಪಾಚಾ಼ ನೊಹಾನಾ ದಿನೊಮಾ ಕ್ಹುದಾನೆ ಅವಿದೆಯ ಥಯಲವಾಲಾಜ಼ ತ್ಯುನೆ ನೊಹಾ ಹಡ್ಗೊ ಭಾಂದತಾಮಾ ಕ್ಹುದಾ ಸಮಾದಾನಕ್ಹು ಕೈದಾಡೊತೊ. ದಕ್ಹಾ ಜ಼ನಾ ಕದ್ಯಾಮ ಕ್ಹಾಲಿ ಆಟ್ ಜ಼ನಾ ತೆ ಹಡಗಾಮಾ ಪಾನಿಕ್ಹು ವಾಚ್ಯಾ. <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />ತೆ ಪಾನಿ ಹಮ್ನಾ ತುಮೊನೆ ವಚಾ಼ಡಾನು ರ‍್ಹಯಲ ತೆ ಬಾಪ್ತಿಸ್ಮಾ ರ‍್ಹಯಲ ನಿಂಗತ ಛೆ. ಬಾಪ್ತಿಸ್ಮ ಅಂಗನಿ ರಾಡಿ ಧ್ವಯಲ ನಿಂಗತ ನ್ಹವೈ. ತೆ ಚೊ಼ಕಿ ಮನಸ ಸಾಕ್ಷಿ ಚಾ಼ಯೆ ಕೈನ ಮಾಂಗಿಲಿದಲ ನಿಂಗತ ಛೆ. ಯೆಸು ಕ್ರಿಸ್ತ ಮರಣಕ್ಹು ಉಟಿನ ಆಯಲಕ್ಹು ತೆ ತುಮೊನೆ ವಚಾ಼ಡಸ. <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />ಹಮ್ನಾ ಯೆಸು ಸ್ವರಗೆ ಗಯೊಸ ತೆ ಕ್ಹುದಾನಾ ಬಾಜು಼ಮಾ ಛೆ. ತೆ ಕ್ಹುದಾನಾ ದುತೊನೆ ಅದಿಕಾರಿಯೊನೆ ತಾಕತನೆ ಆಳಾಡ್ಯೊಸ.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">ಜಿವಿತ ಬದಲಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />ಕ್ರಿಸ್ತ ಮನಕ್ಹನು ಅಂಗ ಲಿದಲ ಟೈಮಮಾ ತ್ರಾಸ ಅನುಭವಿಶೊ. ತಿನಾಹುತಿ ಕ್ರಿಸ್ತಮಾ ರ‍್ಹಯಲ ಮನಸ ತುಮೆ ವ್ಹಂದಲಿನ ತುಮಾರಾಕ್ಹು ತುಮೆ ತಾಕತ ಭರಲಿವೊ. ಅಂಗಕ್ಹು ತ್ರಾಸ ಖಾದಲ ಮನಕ್ಹ ಪಾಕ್ಹು ಮುಕ್ತ ಥಯೊಸ. <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />ತಿನಾಹುತಿ ಎ ಜಗತ್ಮಾ ಮನಕ್ಹೊನಿ ಮರ್ಜಿ ಲಿಂಗತ ಕೆಟ್ಟ ಕಾಮೊ ಕರ‍್ಯಾವಾಚಿ, ಕ್ಹುದಾನಿ ಮರ್ಜಿ ಲಿಂಗತ ಕಾಮೊ ಕರತಾ ಜಿವ್ನಾ ಕರತಾ ತುಮಾರಾಕ್ಹು ತುಮೆ ತಾಕತ ಭರಲಿವೊ.<verse eid="1PE 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 4:3" />ಪೈಲಾ ಬರೊಕ್ಹೊ ನೈಸೊ ಮನಕ್ಹೊ ಕರಾನಾ ಕಾಮೊ ಕರತಾ ಘನ್ನು ಟೈಮ ಹಾಳ ಕರ‍್ಯಾ. ತುಮೆ ಲೈಂಗಿಕ ಪಾಪೊ ಕರಾಡಾಸ. ತುಮೊನೆ ಚೊ಼ಕುಲಾಗಲ ಕಾಮೊ ಕರಾಡಾಸ; ಪಿದೊಡಾ ಥಯಾಸ, ಕ್ರುರಿಯೊ ಥಯಾಸ, ಹಸೈ ರ‍್ಹಯಲ ನೈಸೊಕರಾನಾ ವರಿ ಮತ್ಲಬನಾ ಕಾಮೊ ವರಿ ಪಿವಾ ಖಾವಾನು ಚ಼ಲಾವಡ್ಯಾಸ. ಮೊರ್ತಿಯೊನೆ ಆರಾಧನಾ ಕರಾಡಾತಾ. <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />ತುಮೆ ಅಸೈ ರ‍್ಹಯಲ ವರಿ ನೈಸೊ ಕರಾನಾ ಕಾಮೊ ನೈಕಾರುನು ದೆಕಿನ ಬರೊಕ್ಹೊ ನೈಸೊವಾಲಾ ತುಮಾರಾಹುತಿ ಘಾಬ್ರಾಥಾವಸ. ತಿನಾಹುತಿಜ಼ ತ್ಯುನೆ ತುಮೊನೆ ಕೆಟ್ಟ ವಾತೊ ಕವಸ.<verse eid="1PE 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 4:5" />ತೆನೈಸೊ ಬರೊಕ್ಹೊ ನೈಸೊವಾಲಾ ತ್ಯುನೆ ಕರಾನಾ ಕಾಮೊನಾಹುತಿ ತ್ಯುನೆಜ಼ ಕೌ ಲಾಗಸ. ಮರಿಗಯಲ ಮನ್ಹೊನೆ ವರಿ ಜಿವ್ತಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಫೈಸ್ಲೊ ಕರಾನೆ ತಯ್ಯಾರ ರ‍್ಹಯಲ ಕ್ರಿಸ್ತನೆ ತ್ಯುನೆ ತಿನೆ ವಿಚಾರಣೆ ದ್ಯು. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />ಮರಿಗಯಲ ಮನಕ್ಹೊನೆ ಸುವಾರ್ತೆ ಕವಾಲಗಾಡ್ಯಾ. ತ್ಯುನೆ ಅಂಗನಾ ಸಂಬಂಧಕ್ಹು ಮರನಿ ಶಿಕ್ಷಾ ಮಳಿತಬಿ ಆತ್ಮಾನಾ ಸಂಬಂಧಮಾ ಕ್ಹುದಾ ನಿಂಗತ ಜಿವ್ತಾ ರ‍್ಹೌಕೈನಜ಼ ಉಪದೆಶ ಕವಾಲಗಾಡ್ಯಾ.<verse eid="1PE 4:6" /></para>
  <para style="s">ಕ್ಹುದಾನಾ ವರಾವೊನೆ ಚೊ಼ಕೊ ಚಲಾವಾಲೊ</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />ಕ್ಹಾರಾ ಕಾಮೊನೆ ಮುಗ್ಸಾನೊ ಟೈಮ ನಜಿ಼ಕ ಆಯೊಸ. ತುಮೆ ಗ್ಯಾನವಾಲಾ ಥೈನ ತುಮಾರಾಕ್ಹು ತುಮೆ ತುಮೊನೆ ಹತೊಟಿಮಾ ಮ್ಹೆಲ್ಲಿವೊ. ತುಮೊನೆ ಪ್ರಾಥನಾ ಕರಾನೆ ಎ ತುಮೊನೆ ಸಹಾಯಾ ಕರಸ. <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />ತುಮೆ ಯಕ್ಲಾನೆ ಯಕ್ಲೊ ಹಮೆಶಾಬಿ ಮಯಾ ಕರಾನು ಘನ್ನು ಖಾಸ ವ್ಹೈ. ಮಯಾ ಘನ್ನಾ ಪಾಪೊನೆ ಝಾಕಿಪಾಡಸ. <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />ಗುಣ ಗುಟ್ಯಾವಾಚಿ಼ ಮಕ್ಹೊನೆ ಅತಿಥಿಸತ್ಕಾರ ಕರೊ.<verse eid="1PE 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 4:10" />ತುಮೊಮಾ ಹರಿ ಯಕ್ಲೊ ಕ್ಹುದಾ ಕಂತೊ ಆತ್ಮಿಕನಿ ವರಾ ಪಡ್ದಿಲಿದ್ಯೊಸ. ಕ್ಹುದಾ ತುಮೊನೆ ಘನ್ನಿ ತರಾಮಾ ತಿನಿ ಕೃಪಾಕ್ಹು ದಿದ್ಯೊಸ. ತುಮೆ ಕ್ಹುದಾನಿ ವರಾ ಉಪಯೊಗ ಜವಾಬ್ದಾರಿವಾಲಾ ಥೈನ ಸೆವಕೊ ಥಯಾಸ ತಿನಾಹುತಿ ಚೊ಼ಕಾ ಸೆವಕೊ ಥಾವೊ. ಯಕ್ನಾ ಯಕ್ಕ ಸೆವೆ ಕರಾನೆ ತುಮೊನೆ ದಿದಲ ವರಾ ಉಪಯೊಗ ಕರೊ. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />ಭೊದನೆ ಕವಾಲೊ ಕ್ಹುದಾನಿಯೊ ವಾತೊಜ಼ ಕವಾದೆ. ಸೆವೆ ಕರಾಲೊ ಕ್ಹುದಾ ದಿದಲ ತಾಕತಕ್ಹುಜ಼ ಸೆವೆ ಕರಾದೆ. ತುಮೆ ಇಮ್ಮ ಕರ‍್ಯಾಮ. ತುಮೆ ಕರಾನು ಹರಿಯಕ್ಕಮಾ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಕ್ಹುದಾನೆ ಸ್ತುತಿ ಥಾವಸ. ಅದಿಕಾರ ವರಿ ಮಹಿಮಾ ಯುಗೊ ಯುಗೊಮಾ ತಿನೆಜ಼ ಮಳಲ ವ್ಹೈ. ಆಮೆನ್.<verse eid="1PE 4:11" /></para>
  <para style="s">ಕ್ರೈಸ್ತ ಥೈನ ಅನುಭವಿಸಾನು ತ್ರಾಸ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />ಮಾರಾ ಮಯಾನ ದೊಸ್ತೊ, ತುಮೆ ಹಮ್ನಾ ಅನುಭವಿಸಾನಾ ಕಷ್ಟನಾಹುತಿ ಘಾಬ್ರಾ ಥಾವೊನಕೊ. ತೆ ತುಮಾರೊ ಬರೊಕ್ಹೊ ಪರಿಕ್ಷಾ ಕರಾನಾಹುತಿ ಆವಸ. ಘನ್ನೊ ತ್ರಾಸ ಆವಸ ಕೈನ ತುಮೆ ವಿಚಾರ ಕರೊನಕೊ. <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />ತೆನೈಸೊ ತುಮೆ ಕ್ರಿಸ್ತನೊ ತ್ರಾಸ ವಾಟಿಲಿವಾಡಾಸ ಕೈನ ತುಮೆ ಖುಶಿಕ್ಹು ರ‍್ಹವೊ. ಕ್ರಿಸ್ತ ತಿನಿ ಮಹಿಮಾ ದೆಕಾಡಾನಾಹುತಿ ತುಮೆ ಖುಶಿ ಕರೊಶಿ.<verse eid="1PE 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 4:14" />ತುಮೆ ಕ್ರಿಸ್ತಮಾ ರ‍್ಹಯಲಕ್ಹು ತುಮಾರಾಹುತಿ ಮನಕ್ಹೊ ಕೆಟ್ಟ ಬೊಲ್ಯಾಮ ತುಮೆ ಭಾಗ್ಯವಂತವಾಲಾ ವ್ಹೈ. ಘನ್ನು ಉಜಾಲಾನು ಆತ್ಮಾ ತುಮೊಮಾ ಛೆ. ತೆ ಕ್ಹುದಾನಿ ಆತ್ಮಾ ವ್ಹೈ. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />ತುಮೆ ಕೆಟ್ಟ ಮನಕ್ಹೊ ಥೌ ನೈ. ಮನಕ್ಹೊನೆ ಖಲಾಸ ಕರಾಲಾ ಥೌ ನೈ, ಚ್ವಟ್ಟಾ ಥೌ ನೈ, ವರಿ ಬಿಜಾ಼ವೊನೆ ತ್ರಾಸ ಕರು ನೈ. ಹೆವು ಕರಾಲಾ ತ್ರಾಸಮಾ ಪಡಸ. <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />ತುಮೆ ಕ್ರೈಸ್ತರೊ ಥಯಲಕ್ಹು ತ್ರಾಸ ಖಾದ್ಯಾಮ, ಸರಮಕ್ಹು ರ‍್ಹೌನೈ. ತೆ ( ಕ್ರೈಸ್ತ ) ನಾಮನಾಹುತಿ ತುಮೆ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಕರೊ.<verse eid="1PE 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17" />ತುಮಾರೊ ಫೈಸಲಾನೊ ದಿನ್ನ ಆಯೊಸ. ತೆ ಕ್ಹುದಾನಾ ಘರತು ಶುರು ಥಾವಸ. ತುಮೊಮಾಜ಼ ತೆ ಶುರು ಥಯುಮ, ಕ್ಹುದಾನಿ ಸುವಾರ್ತಾನೆ ವಿಧೆಯ ನೈ ಥಾವಾನಾ ಮನಕ್ಹೊನೆ ಸು ಥಾಸ? <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />"ಕ್ಹರಿಕ್ಹು ರ‍್ಹಯಲವಾಲೊ</para>
  <para style="q1" vid="1PE 4:18">ರಕ್ಷಣೆ ವ್ಹಂದಾನೆ ಕಷ್ಟ ಥಯುಮ,</para>
  <para style="q2" vid="1PE 4:18">ಭಕ್ತಿಮಾ ಕಮ್ಮ ರ‍್ಹಯಲವಾಲೊ ವರಿ ಪಾಪಿನಿ ಗತಿ ಸುವೈ? <char style="rq"><ref loc="PRO 11:31">ಜ್ಞಾನೊಕ್ತಿ 11:31</ref></char><verse eid="1PE 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19" />ತಿನಾಹುತಿ ಕ್ಹುದಾನಿ ಆಸ ನಿಂಗತ ತ್ರಾಸ ಕ್ಹಾವಾಲಾ ತ್ಯುನೆ ಜ಼ಲಮನಿ ಆತ್ಮಾ ತಿನೆ ವಪ್ಸಿನ ದ್ಯು. ತ್ಯುನೊನೆ ತಯ್ಯಾರ ಕರಲವಾಲೊ ಕ್ಹುದಾಜ಼ ವ್ಹೈ. ತಿನಾಹುತಿ ತ್ಯುನೆ ತಿನಾಮಾ ಬರೊಕ್ಹೊ ಮ್ಹೆಲು. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ತ್ಯುನೆ ಚೊ಼ಕುಜ಼ ಕರತಾಜ಼ ರ‍್ಹೌ.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನು ಹಿಂಡ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />ತುಮಾರಿ ಸಬೆಮಾ ಮ್ಹೊಟಾ ರ‍್ಹಯಲವಾಲಾವೊನಾ ಮಿ ದಕ್ಹಿಯೊ ವಾತೊ ಕೌ ಕೈನ ಛೆ. ಮಿ ಯಕ್ಲೊ ಮ್ಹೊಟೊ ಥಯೊಸ. ಮಿ ಕ್ರಿಸ್ತನೆ ತ್ರಾಸ ದಿವಾನು ಡೊಳೆ ದೆಕ್ಯೊಸ. ಹಮೊನೆ ದಿಕ್ಹಾನಾ ಟೈಮಮಾ ಮಿ ತಿಮಾ ಭಾಗಿದಾರ ಥಯೊಸ. <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />ತುಮೆ ಸಬೆನಾ ಜವಾಬದಾರಿಲಿದಲವಾಲಾ ಸಬೆನೆ ರಾಕು ಕೈನ ಮಿ ಮಾಂಗಿಲ್ಯುಸ. ತ್ಯುನೆ ಕ್ಹುದಾನಾ ಹಿಂಡ ವ್ಹೈ. ತುಮೆ ತೆ ಹಿಂಡನೆ ಕೈದೊ. ಕಾಕದ್ಯಾಮ ತೆ ತುಮಾರಿ ಆಸ ವ್ಹೈ. ತೆ ವಜ್ಜು಼ ಜ಼ಬರದಸ್ತಿಕ್ಹು ಉಚಾಯಲ ವಜ್ಜು಼ ನ್ಹವೈ. ಕ್ಹುದಾ ತೆಜ಼ ಆಸ ಕರಸ; ತುಮೆ ತೆ ಹಿಂಡನೆ ಕೈದಾನು ದೊಕ್ಡಾನಾಹುತಿ ನ್ಹವೈ, ಕ್ಹುದಾನಿ ಸೆವೆ ಕರಾನು ತುಮೊನೆ ರ‍್ಹಯಲ ಕ್ಹುಶಿನಾಹುತಿ ವ್ಹೈ. <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />ತುಮೆ ಜವಾಬ್ದಾರಿ ರ‍್ಹಯಲವಾಲಾ ತೆ ಹಿಂಡಪರ ಜ಼ಬರದಸ್ತಿ ಕರೊ ನಕೊ. ತುಮೆ ತ್ಯುನೊನೆ ಚೊ಼ಕಿ ಸಾಕ್ಷಿ ಥಾವೊ. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />ಮ್ಹೊಟೊ ಕುರಬುರ‍್ಯೊ (ಕ್ರಿಸ್ತ) ದಿಕ್ಹತಾಮಾ, ತುಮೊನೆ ಮಾತಾಪರ ಕಿರಿಟ ಮಳಸ. ಮ್ಹೊಟಿ ತಾಕತಮಾ ರ‍್ಹಯಲ ತೆ ಕಿರಿಟ ತಿನಿ ಕಳಾ ಜ಼ವೈಲಿತಿಜ಼ ನೈ.<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />ಜಾಂಜಿಮಾನೊ ಮಿ ತುಮೊನೆ ದಕ್ಹಿಯೊವಾತೊ ಕೌ ಕೈನ ಛೆ. ತುಮೆ ಮ್ಹೊಟಾವೊನೆ ಅಧಿನ ಥೈನ ರ‍್ಹವೊ. ತುಮೆ ಯಕ್ನಾ ಯಕ್ಕ ಮಯಾಕ್ಹು ಚಾ಼ಲಿಲಿವೊ. ಕ್ಹುದಾ ಸ್ವಕ್ಕ ರ‍್ಹಯಲವಾಲಾವೊನಾ ವಿರುದ್ದ ವ್ಹೈ. ತೆ ತಗ್ಗಿನ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಮರಗಾ ದೆಕಾಡಸ" <char style="rq"><ref loc="PRO 3:34">ಜ್ಞಾನೊಕ್ತಿ 3:34</ref></char> <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" />ತಿನಾಹುತಿ ಕ್ಹುದಾನಾ ಹತೊನಾ ತಾಕತನಾ ಹೆಟಾ ರ‍್ಹಯಲವಾಲಾ ತಗ್ಗಿನ ರ‍್ಹವೊ. ಚೊ಼ಕೊ ದಿನ್ನ ಆಯಲಪರ ತುಮೊನೆ ಉಪ್ಪರ ಉಚಾವಸ. <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />ತೆ ತುಮೊನೆ ರಾಕಲಕ್ಹು ತುಮಾರಿ ಚಿಂತಾ ತಿನೆ ವಪ್ಸಿನ ದಿವೊ.<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />ಯಕ್ಕಜ಼ ಮನಸವಾಲಾ ರ‍್ಹವೊ ವರಿ ಹುಶಾರ ಥೈನ ರ‍್ಹವೊ. ಸೈತಾನ ತುಮಾರೊ ದುಶ್ಮನ ವ್ಹೈ. ತೆ ವದ್ರಾನಾ ಶಿಯ್ಯಾ ನಿಂಗತ ಕಿನೆ ಖೌ ಕೈನ ಹುಡಕ್ತೊ ರ‍್ಹವಸ ತೆ ಮನಕ್ಹೊನೆ ಹುಡ್ಕಾಡೊಸ. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />ತುಮಾರಾ ಬರೊಕ್ಹಾಮಾ ಘಟ್ಟರ‍್ಹೈನ ತಿನೆ ದೆಕೊ. ಕಾಕದ್ಯಾಮ ಜಗತ್ಮಾ ರ‍್ಹಯಲ ತುಮಾರಾ ಭಾಯೊ ಭೆನೊ ತುಮೊನೆ ರ‍್ಹಯಲ ತ್ರಾಸ ಖಾವಾಡಾಸ ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />ಹೊ, ತುಮೆ ದಕ್ಹಾಜ಼಼ ದಿನ್ನ ತ್ರಾಸ ಖಾವೊಸಿ, ತೆ ಥಯಲಪರ ಕ್ಹುದಾ ಕ್ಹಾರು ಕರೆಟ್ಟ ಕರಸ. ತೆ ತುಮೊನೆ ತಾಕತ ದಿವಸ. ತುಮೆ ಹೆಟಾ ಪಡೆನೈಸೊ ತೆ ತುಮೊನೆ ಆಸ್ರೊ ಥೈನ ರ‍್ಹವಸ. ಕ್ಹಾರಾವೊನೆ ಮರಗಾ ದೆಕಾಡಾಲೊ ಕ್ಹುದಾ ತೆಜ಼ ವ್ಹೈ. ತಿನಾ ತಾಕತಮಾ ಪಾಲ ಲಿವಾನೆ ಕ್ರಿಸ್ತಜ಼ ತುಮೊನೆ ಬಲಾಯೊ. ತೆ ತಾಕತ ಹಮೆಶಾ ರ‍್ಹಯಲ ವ್ಹೈ. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />ಕ್ಹಾರೊ ಅದಿಕಾರ ತಿನೊಜ಼ ವ್ಹೈ. ಆಮೆನ್.<verse eid="1PE 5:11" /></para>
  <para style="s">ಲಾಸ್ಟನಿಯೊ ವಂದನೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />ಮಿ ಆಂ ನ್ಹಾನು ಪತ್ರ ಸಿಲ್ವಾನನಾ ಆಸ್ರಾಕ್ಹು ಬರ್ದ್ಯೊ. ತೆ ಕ್ರಿಸ್ತಮಾ ರ‍್ಹೈನ ಬರೊಕ್ಹಾವಾಲೊ ಭೈ ವ್ಹೈ ಕವಾನು ತುನೆ ಗ್ವತ್ತ ಛೆ. ಮಿ ತುನೆ ಪೊಕ್ಹಾಲಾವಾನೆ ವರಿ ಅಗೊ ಬಡಾನೆ ಎ ಪತ್ರ ಬರ್ದ್ಯೊಸ. ಎಜ಼ ಕ್ಹುದಾನಿ ಕ್ಹರಿನಿ ಮರಗಾ ಕವಾನು ತುಮೊನೆ ಕೌ ಕೈನಜ಼ ಮಾರಿ ಆಸ ವ್ಹತಿ. ತೆ ಮರಗಾಮಾ ಘಟ್ಟ ಥೈ ರ‍್ಹವೊ.<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />ಬಾಬಿಲೊನಮಾ ರ‍್ಹಯಲ ಸಭೆವಾಲಾ ತುಮೊನೆ ನಮಸ್ಕಾರ ಕದ್ಯಾಸ. ತುಮೊನೆ ಇನಿಲಿದಲ ನಿಂಗತಜ಼ ತೆ ಮನಕ್ಹೊನೆ ಇನಿಲಿದ್ಯಾಸ. ಕ್ರಿಸ್ತಮಾ ಮಾರೊ ದಿಕ್ರೊ ಥಯಲ ಮಾರ್ಕ ತುಮೊನೆ ನಮಸ್ಕಾರ ಕದ್ಯೊಸ. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />ತುಮೆ ಮಳಲ ಟೈಮಮಾ ಯಕ್ನಾ ಯಕ್ಕ ಮಯಾಕ್ಹು ಮಟ್ಟಿ ದಿವೊ. ಕ್ರಿಸ್ತಮಾ ರ‍್ಹಯಲ ತುಮೊನೆ ಕ್ಹಾರಾವೊನೆ ಸಮಾಧಾನ ಥಾವಾದೆ.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>