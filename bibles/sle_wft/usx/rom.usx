<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Shikkalgar</book>
  <para style="h">ರೊಮಾಪುರ</para>
  <para style="toc3">ರೊಮ</para>
  <para style="toc2">ರೊಮಾಪುರ</para>
  <para style="toc1">ರೊಮಾಪುರವಾಲಾವೊನೆ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="mt2">ರೊಮಾಪುರದವರಿಗೆ ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ರೊಮ ಗಾಮವಾಲಾವೊನೆ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ರೊಮಾಪುರನು ಪುಸ್ತಕ ಅಪೊಸ್ತಲ ಥಯಲ ಪೌಲಾ ಬರ್ದಲ ವಸೆ. ಎ ಪುಸ್ತಕ ಯೆಸು ಕ್ರಿಸ್ತ ಹುಟ್ಟಲ್ಪರ 54-58 ವರಕ್ಹನಾ ವಚ್ಮಾ಼ ಬರ್ದಲ ಪೌಲಾ ರೊಮಾಪುರೆ ಗಯೊ ನ್ಹೊತೊ. ತಿನಾಹುತಿ ಎ ಬುಕ್ಕನಾ ಮುಕಾಂತರ ರೊಮಾಮ ರ‍್ಹಯಲ ಕ್ರಿಸ್ತವಾಲಾವೊನೆ ಸಲಹೆ ದಿವಾನಾ ಹುತಿ ಎ ಪತ್ರ ಬರ್ದ್ಯೊ. ಯೆಹುದಿಯೊನೆ ವರಿ ಯೆಹುದಿ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಎ ಪತ್ರ ಕೊರಿಂಥ ಗಾಮ್ತೊ ಬರ್ದ್ಯೊ. ತೆ ಟೈಮ್ಮಾ ತೆ ತ್ಯಾ ವ್ಹತ್ತೊ. ಪೌಲಾ ಕಾ ಬರ್ದ್ಯೊಸ ಕದ್ಯಾಮ ಕ್ಹಾರಾ ದೆಶವಾಲಾ ಯೆಸುಪರ ಬರೊಕ್ಹೊ ಕರಾನಾಹುತಿ ವರಿ ಪಾಲ್ಸಿನ ಜೌ಼ ಕೈನ <char style="xt"><ref loc="ROM 16:26">16:26</ref> </char></para>
  <para style="ip">ರೊಮಾಪುರ ಪತ್ರ ಕ್ಹಾರಾ ಕ್ರೈಸ್ತರೊನೆ ಘನ್ನು ಖಾಸ ವ್ಹೈ. ಎ ಕ್ಹಾರಿ ಜ಼ಗಾವೊಪರ ವರಿ ಕ್ಹಾರಾ ಟೈಮಾ ಕಾಕದ್ಯಾಮ ಪೌಲಾ ಚೊ಼ಕು ವರಿ ಸ್ಪ‍ಷ್ಟ ಥೈನ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಮುಕಾಂತರ ರಕ್ಷಣೆ ಕವಾನು ಪಡ್ದಿಲಿಯೆಸ ಕೈ ಸ್ಪಷ್ಟ ಕ್ಹರಿ ರ‍್ಹಯಲ ಕದ್ಯೊ. ಪೌಲನೆ ಯೆಸು ಕ್ರಿಸ್ತ ಸುವಾರ್ತೆ ಹಳೆ ಒಡಂಡಿಕೆನೆ ಮಳಾಯಲ ಛೆ. ಕೆಕ್ಲಾ ಕೆ ಶಾಣ್ಯಾ ಮನಕ್ಹೊ ಎ ಪತ್ರಮಾ ಖಾಸ ರ‍್ಹಯಲ ವಾಕ್ಯಾ <char style="xt"><ref loc="ROM 1:16">1:16</ref></char> ಕೈನ ಕವಸ. ಎ ವಾಕ್ಯಾ ಅಮ ಕವಸ ಸುವಾರ್ತೆನಾ ಹುತಿ ಮಿ ಸರಮತೊ ನೈ ತೆ ಸುವಾರ್ತೆ ಕ್ಹುದಾನಿ ತಾಕತ ವ್ಹೈ. ಪೈಲಾ ಯೆಹುದಿಯೊನೆ ಪಾಚಾ಼ತಾ ಗ್ರಿಕವಾಲಾವೊನೆ. ವ್ಹೈ ಕೈನ ಬರೊಕ್ಹೊ ಕರಾಲಾವೊನೆ ರಕ್ಷಣೆ ಕರಾ ವರಕ್ಹು ವ್ಹೈ. ಪೈಲಾನಿ ಭಾಗ ರೊಮ <char style="xt"><ref loc="ROM 1:12">1:12</ref></char> ರ‍್ಹಯಲ ದೈವ ಶಾಸ್ತ್ರ ವ್ಹೈ. ಬೆವಾ ಭಾಗಮಾ (13-15) ಕ್ರೈಸ್ತನು ಜಿವ್ನಾ ಕರಾನಾ ಹುತಿ ಚಾ಼ಯೆ ಥಯಲ ಸಲಹೆ ದಿದ್ಯೊ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1 ಪೌಲಾ ಪತ್ರ ಬರದತಾಮಾ ಪೈಲಾ ವಳಕ ಕರಸ. ವರಿ ಕಿನೆ ಬರ್ದ್ಯೊಸ. ಕವಾನು ದೆಕಾಡಿನ ದಿವಸ.</para>
  <para style="io1">2 ತೆ ಥಯಲ್ಪರ ಮಾನವ ಕುಲ ನು ಸಂತತಿನೆ ವರಿ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಮುಕಾಂತರ ರಕ್ಷಣೆ ಸಾದ್ಯ ಛೆ ಕೈನ ಕವಾನು ದೆಕಾಡಿನ ದಿವಸ. <char style="ior"><ref loc="ROM 1:16-11:36">1:16—11:36</ref></char></para>
  <para style="io1">3 ತೆ ಥಯಲ್ಪರ ಕ್ರೈಸ್ತನಿ ಜಿವ್ನಾ ಕರಾನಾ ಹುತಿ ಚಾ಼ಯೆ ಥಯಲ ಪ್ರಯೊಜಕ ಸಲಹೆ ದಿವಸ. <char style="ior"><ref loc="ROM 12:1-15:13">12:1—15:13</ref></char></para>
  <para style="io1">4 ತೆ ರೊಮಮಾ ರ‍್ಹಯಲ ಸಭೆನಾ ಮನಕ್ಹೊನೆ ವಂದನೆ ಕರತಾ ಎ ಪುಸ್ತಕ ಪುರಾ ಕರಸ. <char style="ior"><ref loc="ROM 16">16</ref></char></para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />ಯೆಸು ಕ್ರಿಸ್ತನೊ ಸೆವಕ ಥಯಲ ಪೌಲಾ ಬರ್ದಾನು ಪತ್ರ. ಕ್ಹುದಾ ಮನೆ ಅಪೊಸ್ತಲ ಥಾವಾನಾಹುತಿ ಬಲಾಯೊ. ಕ್ಹುದಾನಿ ಸುವಾರ್ತೆ ಕ್ಹಾರಾ ಮನಕ್ಹೊಕನ ಕವಾನಾಹುತಿ ಮನೆ ಇನಿಲಿದ್ಯೊ.<verse eid="ROM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 1:2" />ಕ್ಹುದಾ ತಿನಾ ಮನಕ್ಹೊಕನ ಎ ಸುವಾರ್ತೆ ದಿವಾನಾಹುತಿ ಘನ್ನಾ ದಿನ್ನ ಪಾಚೊ಼ಜ಼ ವಾತ ದಿದಲ ತಿಮ್ಮ ತಿನಾ ಪ್ರವಾದಿಯೊನಾ ಮುಲಕ ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಬರ್ದಲ ಛೆ. <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನಾಹುತಿಜ಼ ತೆ ಸುವಾರ್ತೆ ವ್ಹೈ. ಮನಕ್ಹ ಥೈನ ತೆ ದಾವಿದನಾ ಖಾಂದಾನಮಾ ಹುಟ್ಯೊ. <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />ತೆನೈಸೊ ಯೆಸು ಪವಿತ್ರ ಆತ್ಮಾನಾ ಮುಲಕ ಮ್ಹೊಟಿ ತಾಕತನಾ ಕ್ಹಾತೆ ಮರಲವಾಲಾವೊಮಾತೊ ಜಿವ್ತೊ ಥೈನ ಉಟಿನ ತೆಜ಼ ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ವ್ಹೈ ಕೈನ ದೆಕಾಡಿನ ದಿದ್ಯೊ. <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />ಕ್ಹುದಾ ತಿನಾ ಮುಲಕ ಮನೆ ಕ್ರಿಸ್ತನಾಹುತಿ ಅಪೊಸ್ತಲ ಥಾವಾನೆ ನಸಿಬ ದಿದ್ಯೊ. ಕ್ಹಾರಾ ದೆಶನಾ ಮನಕ್ಹೊನೆ ತಿನಾ ಬರೊಕ್ಹಾಮಾ ಲೌ ಕೈನ ಕ್ಹುದಾ ಮನೆ ಎ ಭಾಗ್ಯ ದಿದ್ಯೊ. <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />ರೊಮಮಾ ರ‍್ಹಯಲವಾಲಾ ತುಮೊನೆಬಿ ಕ್ರಿಸ್ತನಾ ಥಾವಾನಾಹುತಿ ಕ್ಹುದಾ ಬಲಾಯಲವಾಲಾ ವ್ಹೈ.<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />ರೊಮಮಾ ರ‍್ಹಯಲವಾಲಾ ಕ್ಹುದಾನಾ ಸ್ವಂತ ಮನಕ್ಹೊ ಥಾವಾನಾಹುತಿ ಕ್ಹುದಾಜ಼ ಬಲಾಯಲವಾಲಾ ಥಯಲ ತುಮೊನೆ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಎ ಪತ್ರ ಬರ್ದಾಡೊಸ. ತುಮೆ ಕ್ಹುದಾನೆ ಮಯಾನಾ ಮನಕ್ಹೊ ಥಯಾಸ.</para>
  <para style="p" vid="ROM 1:7">ಅಪ್ನೊ ಬಾ ಥಯಲ ಕ್ಹುದಾಕ್ಹು ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತಕ್ಹು ತುಮೊನೆ ಕೃಪಾ ವರಿ ಶಾಂತಿ ಮಳಾದೆ.<verse eid="ROM 1:7" /></para>
  <para style="s">ಧನ್ಯವಾದನಾಹುತಿ ಪ್ರಾಥನಾ ಕರಲ</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />ಪೈಲಾ, ಮಿ ತುಮಾರಾಹುತಿ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಮಾರಾ ಕ್ಹುದಾನೆ ಧನ್ಯವಾದ ಕೌಸ. ಕಾಕದ್ಯಾಮ ತುಮಾರೊ ಬರೊಕ್ಹೊ ಕ್ಹಾರಿ ಜಗತಮಾ ಫೈಲಿ ಗಯೊಸ. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />ಕ್ಹುದಾ ತಿನಿ ಸೆವೆ ತಿನಾ ದಿಕ್ರಾನಾಹುತಿ ಸುವಾರ್ತೆನು ಉಪದೆಶ ಕರತೊ ಮಿ ಮಾರಾ ಮನಸೆ ತಿನಿ ಸೆವಾ ಕರಾಡೊಸ. ಇನೆ ಕ್ಹುದಾಜ಼ ಸಾಕ್ಷಿ ವ್ಹೈ. ಕಾಕದ್ಯಾಮ ಮಿ ಪ್ರಾಥನಾ ಕರತಾಮಾ ತುಮೊನೆ ಹಮೆಶಾಬಿ ಶೆಂ ಕರುಸ. <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />ಮಾರಿ ಪ್ರಾಥನಾಮಾ ಹಮೆಶಾಬಿ ಸು ಮಾಂಗಿಲ್ಯುಸ ಕದ್ಯಾಮ ಕ್ಹುದಾನಿ ಮರ್ಜಿ ನಿಂಗತ ತುಮೊಕನ ಕಿಮ್ಮೆಬಿ ಆವಾನೆ ಥಾವಾದೆ. <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />ಮಿ ತುಮೊನೆ ದೆಕಾನೆ, ತುಮೊನೆ ಆತ್ಮಿಕನಾ ಆಶಿರ್ವಾದೊ ವಾಟಿ ಲಿವಾನೆ ವರಿ ತುಮೊನೆ ಘಟ್ಟ ಕರಾನೆ ಮಾರು ಘನ್ನು ಮನಸ ಛೆ. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />ಕದ್ಯಾಮ ಅಪೊಮಾ ರ‍್ಹಯಲ ಬರೊಕ್ಹಾಕ್ಹು ಅಪೆ ಯಕ್ನಾ ಯಕ್ಕ ಮದದ ಕರು ಕೈನ ಮಾರಿ ಆಸ ವ್ಹೈ.<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />ಭಾಯೊ ಭೆನೊ, ಮಿ ತುಮೊಕನ ಆವಾನೆ ಘನ್ನಿ ಸಲಾ ಕೊಶಿಶ ಕರ‍್ಯೊಸ ಕವಾನು ತುಮೊನೆ ಗ್ವತ್ತ ರ‍್ಹವಾದೆ. ತೆನೈಸೊ ಮನೆ ತುಮೊಕನ ಆವಾನೆ ದಕ್ಹಿಯೊ ವಾತೊ ತಡ್ದಿಯೊ. ಮಿ ವಿಚಾರ ಕರುಸ ಕಿಮ್ಮ ಯಹುದ್ಯೊ ನೈರ‍್ಹಯಲ ಮನಕ್ಹೊಕನ ಫಲ ಮಳ್ಯುಸ ತಿನಾ ನಿಂಗತ ತುಮೊಕ್ಹೊ ಮನೆ ಫಲ ಮಳು ಕೈನ ಮಾರಿ ಆಸ ವ್ಹೈ. <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />ಮನೆ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಕದ್ಯಾಮ ಗ್ರಿಕವಾಲಾ ವರಿ ಗ್ರಿಕ ನೈಸೊವಾಲಾ ಮನಕ್ಹೊನೆ, ವರಿ ಗ್ಯಾನಿಯೊನೆ ವರಿ ಗ್ಯಾನ ನೈಸೊವಾಲಾವೊನೆ ಸುವಾರ್ತೆ ಕವಾನು ಭಾರ ಛೆ. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />ತಿನಾಹುತಿ ರೊಮಮಾ ರ‍್ಹಯಲ ತುಮೊನೆ ಸುವಾರ್ತೆ ಕವಾನೆ ಮನೆ ಘನ್ನಿ ಆಸ ಛೆ.<verse eid="ROM 1:15" /></para>
  <para style="s">ಸುವಾರ್ತೆನಿ ತಾಕತ</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />ಮಿ ಸುವಾರ್ತೆನಾಹುತಿ ಆತ್ಮ ವಿಸ್ವಾಸಕ್ಹು ಛೆ. ಬರೊಕ್ಹೊ ಮ್ಹೆಲಲ ಹರ ಯಕ್ಲಾನಾ ರಕ್ಷಣೆನಾಹುತಿ ಕದ್ಯಾಮ ಪೈಲಾ, ಯಹುದಿಯೊನೆ ಪಾಚಾ಼ತಾ ಯೆಹುದಿ ನೈಸೊವಾಲಾವೊನೆ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಲವಾಲಾವೊನೆ ರಕ್ಷಣೆ ಕ್ಹುದಾನಿ ತಾಕತ ಥೈಸ. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />ಕಾಕದ್ಯಾಮ ಸುವಾರ್ತೆ ಎ ದೆಕಾಡಿನ ದಿವಸ ಕ್ಹುದಾ ಮನಕ್ಹನೆ ತಿನಾ ಕ್ಹಾತೆ ನಿತಿವಂತ ಥೈನ ಇಮ್ಮ ಕರಸ ಎ ಪೈಲಾತು ಲಾಸ್ಟ ಲಕ್ಕಾ ಬರೊಕ್ಹಾಕ್ಹು ಥಾವಸ. ಇನಾ ನಿಂಗತ ಪವಿತ್ರ ಗ್ರಂಥ ಕವಸ; "ಕಯೊ ಮನಕ್ಹ ಕ್ಹುದಾನಾ ಕ್ಹಾಮೊ ತಿನಾಕ್ಹು ತಿನೆಜ಼ ನಿತಿವಂತ ಕರಿಲಿವಸ ತೆ ಬರೊಕ್ಹಾಕ್ಹು ಜಿವ್ನಾ ಕರಸ"<verse eid="ROM 1:17" /></para>
  <para style="s">ಮನಕ್ಹನು ಅರು</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />ಕ್ಹುದಾನಿ ಶಿಟ್ಟ ಸ್ವರ್ಗತಿ ದಿಕ್ಹಿನ ಆವಸ. ಮನಕ್ಹೊ ಕ್ಹುದಾನಾ ವಿರುದ್ದ ಕರಾನಾ ಕೆಟ್ಟ ಕಾಮೊ ವರಿ ದುಶಕೃತ್ಯನಾಹುತಿ ಕ್ಹುದಾ ಶಿಟ್ಟ ಥಯೊಸ. ತ್ಯುನೊನೆ ಕ್ಹರಿ ಸುವೈ ಕವಾನು ಗ್ವತ್ತ ಥಯುಸ, ತೆನೈಸೊ ತ್ಯುನಾ ಕೆಟ್ಟ ಕಾಮೊಜ಼ ಕ್ಹರಿ ಕವಾನು ಝಾಕಿ ಪಡಸ. <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />ಕ್ಹುದಾ ತ್ಯುನೊನೆ ಶಿಕ್ಷಾ ದಿವಸ. ಕಾಕದ್ಯಾಮ ಕ್ಹುದಾನಾಹುತಿ ತಿಳದಿಲಿವಾನು ಹರಿಯಕ್ಕ ತ್ಯುನೊನೆ ಆಸಾನ ಛೆ. ಕ್ಹುದಾಜ಼ ತೆ ಆಸಾನ ಕರ‍್ಯೊಸ. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />ಮನಕ್ಹೊ ಕ್ಹುದಾನಿ ಹಮೆಶಾನಿ ತಾಕತನೆ ತಿನಿ ಮಹಿಮಾ ರ‍್ಹೈನೆಕಾ ದೆಕತಾ ನೈ. ತೆನೈಸೊ ಜಗತನಿ ಶುರುತಾಬಿ ತೆ ಸಂಗತಿಯೊ ಮನಕ್ಹೊನೆ ಆಸಾನ ತರಿಕಾಕ್ಹು ಗ್ವತ್ತ ಥಾವಸ. ಕ್ಹುದಾ ಕರಲ ಸೃಷ್ಟಿಮಾ ತೆ ಸಂಗತಿಯೊ ದಿಕ್ಹಿನ ಆವಸ. ತಿನಾಹುತಿ ಮನಕ್ಹೊ ಕರಾನಾ ಕೆಟ್ಟ ಕಾಮೊನೆ ನೆವಾ ಕವಾನೆ ಸಾದ್ಯ ನತ್ತಿ. <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" />ಕಾಕದ್ಯಾಮ ತ್ಯುನೆ ಕ್ಹುದಾನೆ ತಿಳದಿಲಿದ್ಯಾತಬಿ ಕ್ಹುದಾನೆ ಮೆಚ್ಚಶ್ಯಾ ನೈ, ತಿನೆ ಕೃತಜ್ಞತಾ ಸ್ತುತಿ ಕರ‍್ಯಾ ನೈ. ಮನಕ್ಹೊನಿಯೊ ವಿಚಾರೊ ಸುಜ಼ ಫೈದೊ ಥಯ್ಯೊ ನೈ. ಸು ನೈ ಕಳಲ ತ್ಯುನಾ ಮನಸೊ ಅಂದಾರಾಕ್ಹು ಭರಿಗಯಾ. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />ತ್ಯುನಾಕ್ಹು ತ್ಯುನೊನೆ ಗ್ಯಾನಿಯೊ ವ್ಹೈ ಕೈನ ಕೈಲಿನ ಪಿಸಾಳಾ ಥಯಾಸ. <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />ಹಮೆಶಾಬಿ ರ‍್ಹವಾನಿ ಕ್ಹುದಾನಿ ಆರಾಧನಾ ಕಾರಾನು ತ್ಯುನೆ ಛೊಡಿನ ದಿನ ಹಾಳ ಥಾವಾನಾ ಮನಕ್ಹೊನಾ ನಿಂಗತ ರ‍್ಹಯಲ, ಪಕ್ಷಿಯೊ ನಿಂಗತ ರ‍್ಹಯಲ, ಜಾನವರೊ ನಿಂಗತ ವರಿ ಕ್ಹಾಪೊ ನಿಂಗತ ರ‍್ಹಯಲ ಮೊರತಿಯೊ ಕರಲಿನ ತ್ಯುನೊನೆ ಆರಾಧನಾ ಕರಸ.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />ಕ್ಹುದಾ ತ್ಯುನಾ ಮನಸೆ ಕರಾನಾ ಕೆಟ್ಟ ಕಾಮೊನೆ ತ್ಯುನೊನೆಜ಼ ವಪ್ಸಿನ ದಿದ್ಯೊ. ವರಿ ತ್ಯುನೊ ತ್ಯುನೊಮಾಜ಼ ಸರಮಾವಾನಾ ಕಾಮೊ ಕರಸ. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />ತ್ಯುನೆ ಕ್ಹುದಾನಿ ಕ್ಹರಿನೆ ಸುಳ್ಳಮಾ ಬದಲಿ ಕರ‍್ಯಾ. ತ್ಯುನೆ ತಯ್ಯಾರ ಕರಲ ಸಾಮನನೆ ಪುಜಾ ಕರ‍್ಯಾ. ತೆನೈಸೊ ಎ ಕ್ಹಾರು ತಯ್ಯಾರ ಕರಲ ಕ್ಹುದಾನೆ ತ್ಯುನೆ ಆರಾಧನಾ ಕರಾನು ಛೊಡಿ ಪಡ್ಯಾ; ತೆ ಕ್ಹುದಾನೆ ಹಮೆಶಾಬಿ ಸ್ತುತಿ ಥಾವಾದೆ. ಆಮೆನ.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />ತ್ಯುನೆ ಇಮ್ಮ ಕರಲಹುತಿಜ಼, ಕ್ಹುದಾ ತ್ಯುನೊನೆ ಸರಮಾವಾನಾ ಕಾಮಮಾಜ಼ ಛೊಡಿನ ದಿದ್ಯೊ. ತ್ಯುನೆ ಬಾಕ್ಡಿಯೊ ದಾಣಗಾವೊನಾ ಕ್ಹಾತೆ ಮಳಿನ ಕರಾನಾ ಲೈಂಗಿಕ ಕಾಮೊನೆ ಹುಬ್ರಾಡಿನ, ತ್ಯುನೊ ತ್ಯುನೊಮಾಜ಼ ಸಂಭಂಧ ಮ್ಹೆಲ್ಲಿದಿಯೊ. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />ತಿನಾ ನಿಂಗತಜ಼, ದಾಣ್ಗಾ ಬಾಕ್ಡಿಯೊನಾ ಕ್ಹಾತೆ ಕರಾನು ಮಾಮುಲಿ ಲೈಂಗಿಕ ಕಾಮೊಮಾ ಹುಬ್ರಾಡಿನ ಉದ್ರೆಕ ಥೈನ ತ್ಯುನೊ ತ್ಯುನೊಮಾಜ಼ ಸಂಭಂಧ ಮ್ಹೆಲ್ಲಿದ್ಯಾ. ದಾಣ್ಗಾ ತ್ಯುನೊ ತ್ಯುನೊಮಾಜ಼ ಸರಮಾವಾನಾ ಕಾಮೊ ಕರ‍್ಯಾ. ತ್ಯುನಿ ಕೆಟ್ಟ ನಡೆತೆಕ್ಹು ತಿನಾ ತಕ್ಕ ದಂಡ ತ್ಯುನಾ ಅಂಗನೆ ಆವಾ ವರಕ್ಹು ಕರಲಿದ್ಯಾ.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />ಕ್ಹುದಾನು ಕ್ಹರಿನು ಗ್ಯಾನ ಹೊಂದಿಲಿವಾನೆ ವಪ್ಪಿಲಿದ್ಯಾ ನೈ ತ್ಯುನೊನೆ ಕ್ಹುದಾ ತ ತ್ಯುನಾ ಅಯೊಗ್ಯ ಮನಸನೆ ವಪ್ಸಿನ ದಿದ್ಯೊ. ತಿನಾಹುತಿ ತ್ಯುನೆ ನೈಸೊ ಕರಾನಾ ಕಾಮೊ ಕರಸ. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />ತ್ಯುನೊಮಾ ಹರಿ ಯಕ್ಕ ತರಾನಾ ಪಾಪೊ, ದುಷ್ಟತನಾ, ಸ್ವಾರ್ಥ, ಶಿಟ್ಟ, ಸಂಗಟ ಘಾಲ್ಲಿವಾನು, ಖಲಾಸ ಕರಾನು ಲಡೈ ಕಾಡಾನು, ಸುಳ್ಳ ಬೊಲಾನು ವರಿ ಕೆಟ್ಟ ವಿಚಾರೊ ಎ ಕ್ಹಾರು ಭರಿ ಗಯುಸ. ಯಕ್ಲಾಪರ ಯಕ್ಲೊ ಚಾ಼ಡಿ ಕವಸ; <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />ಯಕ್ಕನೆ ಯಕ್ಕ ಕೆಟ್ಟ ವಾತೊ ಬೊಲಸ. ಕ್ಹುದಾನೆ ದ್ವೆಷ ಕರಸ. ತ್ಯುನೆ ಸ್ವಕ್ಕವಾಲಾ ಥೈನ ಅಹಂಕಾರಿಯೊ ಥೈನ ವರಿ ತ್ಯುನಾಕ್ಹು ತ್ಯುನೆ ಮಿ ವ್ಹೈ ಕೈನ ಕವೈಲಿವಾಲಾ ಥಯಲ ರ‍್ಹವಸ. ತ್ಯುನೆ ಕೆಟ್ಟ ವಾತೊ ಬೊಲಾನೆ ಘನಿಯೊ ವಾಟೊ ಹುಡ್ಕಸ. ಮಾ ಬಾಪನೆ ಅವಿಧೆಯ ಥೈನ ಪಿಸಾಳಾ ಥಯಾಸ. <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />ತ್ಯುನೆ ದಿದಲ ವಾತ ಪುರಾ ನೈ ಕರಾಲಾ ಬಿಜಾ಼ವೊನೆ ಮರಗಾ ದೆಕಾಡಾಲಾ ಥಾತಾ ನೈ. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />ಹೆವಾವೊನೆ ಮರವಾನಿ ಶಿಕ್ಷಾ ಮಳು ಕೈನ ಧರಮಶಾಸ್ತ್ರ ಕವಸ ಕವಾನು ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಛೆ. ತಿಮ್ಮ ರ‍್ಹಯುತಬಿ ಹವಾ ಕಾಮೊ ಕರ‍್ತಾಜ಼ ರ‍್ಹವಸ. ವರಿ ಹವಾ ಕಾಮೊ ಕರಾನಾ ಮನಕ್ಹೊನೆ ಪ್ರೊತ್ಸಾಹಾ ಕರಸ.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">ಕ್ಹುದಾನೊ ಫೈಸಲೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />"ಬಿಜಾ಼ ಮನಕ್ಹೊನೆ ಫೈಸಲೊ ಕರಿಯೆಸ" ಕೈನ ತುಮಾರಿ ವಿಷಯಮಾ ವಿಚಾರ ಕರೊ ನಕೊ. ಕಾಕದ್ಯಾಮ ತುಮೆಬಿ ಪಾಪ ಕರಿನ ಅಪರಾದಿಯೊ ಥಯಾಸ. ತುಮೆ ತೆ ಮನಕ್ಹೊನೆ ಫೈಸಲೊ ಕರೊಶಿ. ತೆನೈಸೊ ತೆಜ಼ ಕಾಮೊ ತುಮೆ ಕರೊಶಿ. ತಿನಾಹುತಿ ತುಮೆ ತ್ಯುನೊನೆ ಫೈಸಲೊ ಕರತಾಮಾ, ಕ್ಹರಿಮಾಜ಼ ತುಮೊನೆಜ಼ ಫೈಸಲೊ ಕರಿಲಿವಾಲಾ ಥಾವೊಸಿ. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />ಅಪರಾದ ಕರಾಲಾ ಮನಕ್ಹೊನೆ ಕ್ಹುದಾ ಫೈಸಲೊ ಕರಸ. ತಿನೊ ಫೈಸಲೊ ಕ್ಹರಿನೊ ವ್ಹೈ ಕೈನ ಅಪೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />ತೆ ಅಪರಾದೊ ಕರಾಲಾ ಮನಕ್ಹೊನೆ ತುಮೆಬಿ ಫೈಸಲೊ ಕರೊಶಿ. ತೆನೈಸೊ ತುಮೆಜ಼ ತೆ ಅಪರಾದೊ ಕರೊಶಿ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಕ್ಹುದಾನಿ ನ್ಯಾಯಕ್ಹು ಚು಼ಕೈಲಿವಾನೆ ಸಾದ್ಯ ನತ್ತಿ ಕೈನ ತುಮೊನೆ ಕ್ಹರಿಬಿ ಗ್ವತ್ತ ಛೆ. <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />ಕ್ಹುದಾ ತುಮಾರಿ ವಿಷಯಮಾ ಘನ್ನೊ ಮರಗಾಲೊ ಥಯೊಸ; ತಡ್ದಿಲಿವಾಲೊ ವ್ಹೈ. ತುಮೆ ಬದಲಿ ಥೌ ಕೈನ ಕ್ಹುದಾ ತುಮಾರಾಹುತಿ ಕೈದಾಡೊಸ. ವರಿಬಿ ತುಮೆ ತಿನಿ ಮರಗಾನಾಹುತಿ ವಿಚಾರ ಕರತಾ ನೈ. ತುಮೆ ತುಮಾರಾ ಮನಸೊ ಜಿವ್ನಾ ಬದಲಿ ಕರಲಿವಾನೆ ಥಾವಸ ಕೈನ ಕ್ಹುದಾನಿ ಮರಗಾನೆ ತಿಳ್ದಿಲಿದ್ಯಾವಾಚಿ ಛೆ. <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />ತೆನೈಸೊ ತುಮೆ ಘಟ್ಟ ಮನಸನಾ ವರಿ ಮಂಡ ಚಾಳಿನಾ ಥಯಾಸ. ತಿನಾಹುತಿ ತುಮೊನೆ ಆವಾನು ರ‍್ಹಯಲ ಶಿಕ್ಷಾ ತುಮೆ ಹೆಚ್ಕಿ-ಹೆಚ್ಕಿ ಕರಲಿವಾಡಾಸ. ಕ್ಹುದಾ ತಿನಿ ಶಿಟ್ಟ ದೆಕಾಡಾನಾ ಟೈಮಮಾ ತುಮೊನೆ ತೆ ಶಿಕ್ಷಾ ಥಾವಾಸ. ತೆ ದಿನ್ನಮಾ ಕ್ಹುದಾನಿ ನ್ಯಾಯನಿ ಫೈಸಲೊ ಮನಕ್ಹೊ ದೆಕಸ. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />ಕಾಕದ್ಯಾಮ ಕ್ಹುದಾ ಹರಿ ಯಕ್ಲಾನೆ ತ್ಯುನೆ-ತ್ಯುನೆ ಕರಲ ಕಾಮೊನಾ ತಕ್ಕ ಪ್ರತಿ ಫಲ ದಿವಸ. <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />ದಕ್ಹಾ ಮನಕ್ಹೊ ಮಹಿಮಾನಾಹುತಿ, ಮರಯಾದಿನಾಹುತಿ ವರಿ ತ್ಯುನು ಹಮೆಶಾನು ಜ಼ಲಮ ರ‍್ಹೌ ಕೈನ ಕೆಳಾಮಾಬಿ ಚೊ಼ಕಾ ಕಾಮೊ ಕರತಾ ಜಿವ್ನಾ ಕರಸ. ಕ್ಹುದಾ ತೆ ಮನಕ್ಹೊನೆ ಹಮೆಶಾನೊ ಜ಼ಲಮ ದಿವಸ. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />ತೆನೈಸೊ ಉಗ್ರಲ ಮನಕ್ಹೊ ಸ್ವಾರಥಿಯೊ ಥೈನ, ಕ್ಹರಿಪರ ಚಾ಼ಲ್ಯಾವಾಚಿ ಕೆಟ್ಟ ಕಾಮೊಪರ ಚಾ಼ಲಾಲಾ ಥಯಾಸ. ತ್ಯುನೊಪರ ಕ್ಹುದಾನಿ ಶಿಟ್ಟ ವರಿ ರುದ್ರ ಅವತಾರ ಆವಸ. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />ಕೆಟ್ಟಜ಼ ಕರಾಲಾ ಹರಿ ಯಕ್ಲಾನೆ ಕದ್ಯಾಮ ಪೈಲಾ ಯಹುದಿಯೊನೆ, ಪಾಚಾ಼ತು ಯಹುದ್ಯೊ ನೈಸೊವಾಲಾವೊನೆ ಕಷ್ಟ ತ್ರಾಸೊ ದಿವಸ. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />ತೆನೈಸೊ ಚೊ಼ಕುಜ಼ ಕರಾಲಾ ಹರಿ ಯಕ್ಲಾನೆ ಕದ್ಯಾಮ ಪೈಲಾ ಯಹುದಿಯೊನೆ, ಪಾಚ಼ಲ್ತಾ ಯಹುದ್ಯೊ ನೈಸೊವಾಲಾವೊನೆ ಕ್ಹುದಾ ಮಹಿಮಾ, ಮರ್ಯಾದಿ ವರಿ ಶಾಂತಿ ದಿವಸ. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />ಕ್ಹುದಾ ಕಿನು ಸೈಡ ಲಿದ್ಯಾವಾಚಿ ಕ್ಹಾರಾವೊನೆ ಯಕ್ಕಜ಼ ತರಾ ಫೈಸಲೊ ಕರಸ.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />ಯೆಹುದಿ ನೈಸೊ ಮನಕ್ಹೊಕನ ಮೊಶೆನಾ ನಿಯಮೊ ನತ್ತಿ. ತೆ ಮನಕ್ಹೊ ಧರಮಶಾಸ್ತ್ರ ಗ್ವತ್ತ ನೈಸೊ ಪಾಪ ಕರಸ. ಯಹುದ್ಯೊಕನ ಧರಮಶಾಸ್ತ್ರ ಛೆ ತ್ಯುನೆಬಿ ಪಾಪ ಕರಸ ವರಿ ತ್ಯುನೊ ನ್ಯಾಯನೊ ಫೈಸಲೊ ಧರಮಶಾಸ್ತ್ರನಾ ನಿಯಮ ಪ್ರಕಾರ ಫೈಸಲೊ ಥಾವಸ. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />ಧರಮಶಾಸ್ತ್ರನೆ ಐಕಲಕ್ಹು ಮನಕ್ಹೊ ಕ್ಹುದಾನಿ ನಜ಼ರಮಾ ನಿತಿವಂತವಾಲಾ ಥಾತಾ ನೈ. ತೆನೈಸೊ ಧರಮಶಾಸ್ತ್ರ ಕವಾನಿ ಹರಿ ಯಕ್ಕ ವಾತನೆ ವಿಧೆಯ ಥಾವಾಲಾ ಮನಕ್ಹೊನೆ ಧರಮಶಾಸ್ತ್ರ ನಿತಿವಂತವಾಲಾ ಕರಸ. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲವಾಲಾ ಧರಮಶಾಸ್ತ್ರ ಹೊಂದ್ಯಾ ನತ್ತಿ. ತೆನೈಸೊ ತ್ಯುನೆ ಧರಮಶಾಸ್ತ್ರನಾ ನಿಂಗತ ಚಾ಼ಲಿನ ಜಾ಼ವತ್ತೊ, ತ್ಯುನೊನೆ ಧರಮಶಾಸ್ತ್ರನಿ ಜ಼ರುರತ್ತಜ಼ ನ್ಹೊತಿ. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />ತ್ಯುನಿ ಮನಸ್ಸನಾ ನಿಯಮೊ ನಿಂಗತ ಕಯು ಕರೆಟ್ಟ ವ್ಹೈ, ಕಯು ತಪ್ಪ ವ್ಹೈ, ಕವಾನು ತ್ಯುನೆ ತ್ಯುನಾ ನಡತೆಕ್ಹು ದೆಕಾಡಿನ ದಿವಸ. ಎ ಕ್ಹರಿ ವ್ಹೈ ಕೈನ ತ್ಯುನಾ ಮನಸನಿ ಸಾಕ್ಷಿಕ್ಹು ದೆಕಾಡಿನ ದಿವಸ. ತ್ಯುನಿ ತೈಜ಼ ಗ್ಯಾನಕ್ಹು ತ್ಯುನೊನೆ ದೊಶಿ ವ್ಹೈ ಕೈನ ನೈತೊ ನಿರದೊಶಿ ವ್ಹೈ ಕೈನ ಫೈಸಲೊ ಕರಸ. <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />ಮನಕ್ಹೊನಾ ಮನಸಮಾ ದಡಿ ರ‍್ಹಯಲ ಸಂಗತಿಯೊನೆ ಕ್ಹುದಾ ಫೈಸಲೊ ಕರಾನಾ ದಿನ್ನೆ ಎ ಕ್ಹಾರು ಥಾವಸ. ಕ್ಹುದಾ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಮನಕ್ಹೊನೆ ಫೈಸಲೊ ಕರಸ ಕವಾನು ಸುವಾರ್ತೆ ಕೈನ ದಿವಸ. ಮಿ ಮನಕ್ಹೊನೆ ಕವಾನು ತೆಜ಼ ಸುವಾರ್ತೆ ವ್ಹೈ.<verse eid="ROM 2:16" /></para>
  <para style="s">ಯಹುದ್ಯೊ ವರಿ ನಿಯಮೊ</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />"ಮಿ ಯಹುದ್ಯನೊ ವ್ಹೈ" ಕೈನ ಕೈಲಿವಾನು ತಾರಿ ವಿಷಯ ಸುತೊ ವ್ಹೈ? ಧರಮಶಾಸ್ತ್ರಮಾ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಿನ ಕ್ಹುದಾನಾ ನಜಿಕ ರ‍್ಹವಾನಾಹುತಿ ತು ಖುಶಿ ಥಾಶಿ. <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />ಕ್ಹುದಾನಿ ಚಿತ್ತ ನಿಂಗತ ರ‍್ಹಯಲ ಕಾಮೊ ಧರಮಶಾಸ್ತ್ರಕ್ಹು ಶಿಕ್ಕಲಹುತಿ ತು ಕೈಲೆಶಿ. <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />ಚೊ಼ಕಿ ರ‍್ಹಯಲ ವಾಟ ನೈ ಗ್ವತ್ತ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ವಾಟ ದೆಕಾಡಾಲೊ ಅಂದಾರಾಮಾ ರ‍್ಹವಾಲಾ ಮನಕ್ಹೊನೆ ಉಜಾಲು ಥೈನ ರ‍್ಹೌ ಕೈನ ತಾರಾಹುತಿ ವಿಚಾರ ಕರಲಿದ್ಯೊಸ. <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />ಮಡ್ಡ ರ‍್ಹಯಲವಾಲಾವೊನೆ ವಾಟ ದೆಕಾಡಾಲೊ ನಿಂಗತ ವಳಕ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಮಾಸ್ತರ ನಿಂಗತ ವ್ಹೈ ಕೈನ ತಾರಾಮಾ ಧರಮಶಾಸ್ತ್ರನು ಪುರಾ ಗ್ಯಾನ ವರಿ ಕ್ಹರಿ ಗ್ವತ್ತ ಛೆ ಕೈನ ತು ಕೈಲಿದ್ಯೊಸ. <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />ತು ಬಿಜಾ಼ವೊನೆ ಶಿಕ್ಲಾಶಿ. ಇಮ್ಮ ರ‍್ಹಯುಮ ತು ತುನೆಜ಼ ಕಾ ಶಿಕ್ಲೈಲೆತೊ ನೈ? ಚೊ಼ರಿ ಕರು ನೈ ಕೈನ ತು ಮನಕ್ಹೊನೆ ಕಶಿ, ತೆನೈಸೊ ತುಜ಼಼ ಚೊ಼ರಿ ಕರಶಿ. <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />ಮನಕ್ಹೊ ವ್ಯಭಿಚಾರ ಕರು ನೈ ಕೈನ ತುಜ಼಼ ಕಶಿ, ತೆನೈಸೊ ತುಜ಼಼ ತೆ ವ್ಯಭಿಚಾರ ನೈ ಕರ‍್ತೊ ಸು? ತು ಮೊರತಿಯೊನೆ ದ್ವೆಷ ಕರಶಿ, ತೆನೈಸೊ ತುಜ಼಼ ತೆ ಕ್ಹಾರು ಚೊ಼ರಿ ಕರ‍್ತೊ ನೈ ಸು? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />ತು ಕ್ಹುದಾನಾ ಧರಮಶಾಸ್ತ್ರನಾಹುತಿ ಘಮಂಡ ಕರಶಿ. ತೆನೈಸೊ ತು ಧರಮಶಾಸ್ತ್ರನೆ ದಾಟಿನ ಕ್ಹುದಾನೆ ಮರ್ಯಾದಿ ಕಾಡ್ತೊ ನೈ ಸು? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />"ಯಹುದ್ಯೊ ಥಯಲ ತಮಾರಾಹುತಿ ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ಕ್ಹುದಾನಾ ನಾಮನೆ ವಿರುದ್ದ ಥೈನ ಬೊಲಸ" ಕೈನ ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಬರ್ದಲ ಛೆ.<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />ತು ಧರಮಶಾಸ್ತ್ರ ನಿಂಗತ ಚಾ಼ಲ್ಯೊ ಕದ್ಯಾಮ ತು ಕರಿಲಿದಲ ಸುನ್ನತಿನೆ ಮತ್ಲಬ ಛೆ. ತೆನೈಸೊ ತು ಧರಮಶಾಸ್ತ್ರನೆ ದಾಟಿನ ಗಯೊಮ ತುನೆ ಸುನ್ನತಿ ನತ್ತಿ ಥೈ ಕೈನ ವ್ಹೈ. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಸುನ್ನತಿ ಥೈ ನತ್ತಿ, ತೆನೈಸೊ ಧರಮಶಾಸ್ತ್ರ ಕವಾನು ತ್ಯುನೆ ಕರತಾ ರ‍್ಹಯಾಮ, ತ್ಯುನೆ ಕ್ಹುದಾನಿ ನಜ಼ರಮಾ ಸುನ್ನತಿ ಕರೈಲಿದಲ ನಿಂಗತ ನ್ಹವೈ ಸು? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />ಯಹುದ್ಯೊ ರ‍್ಹಯಲವಾಲಾ ತುಮೊನೆ ಬರ್ದಲ ಧರಮಶಾಸ್ತ್ರ ಛೆ ವರಿ ಸುನ್ನಿತಿ ಥೈಸ. ತೆನೈಸೊ ತುಮೆ ಧರಮಶಾಸ್ತ್ರನೆ ದಾಟಿನ ಚಾ಼ಲೊಶಿ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ಅಂಗಮಾ ಸುನ್ನಿತಿ ನೈ ಥಯಲ ರ‍್ಹೈತಬಿ ಧರಮಶಾಸ್ತ್ರನೆ ವಿಧೆಯ ಥಾವಾಲಾ ಮನಕ್ಹೊ ತುಮೊನೆ ಅಪರಾದಿ ವ್ಹೈ ಕೈನ ದೆಕಾಡಿನ ದಿವಸ. <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />ಎ ಕ್ಹಾಲಿ ಭಾರಲ್ಯಾ ಅಂಗಮಾ ಯಹುದಿ ಥೈನ ರ‍್ಹವಾಲೊ ಯಹುದಿ ನ್ಹವೈ. ಕ್ಹಾಲಿ ಅಂಗನಿ ಭಾರಲಿ ಸುನ್ನತಿ ಕ್ಹರಿನಿ ಸುನ್ನತಿ ನ್ಹವೈ. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />ಮನಸಮಾ ಯಹುದಿ ರ‍್ಹಯಲವಾಲೊಜ಼ ಕ್ಹರಿನೊ ಯಹುದಿ ವ್ಹೈ. ಮನಸಮಾ ಥಯಲ ಸುನ್ನತಿ ಕ್ಹರಿನಿ ಸುನ್ನತಿ ವ್ಹೈ. ಎ ಸುನ್ನತಿ ಥಯಲ ಕ್ಹುದಾನಿ ಆತ್ಮಾಕ್ಹುಜ಼ ಥಯಲ ವ್ಹೈ ತೆನೈಸೊ ಬರ್ದಲ ಧರಮಶಾಸ್ತ್ರಕ್ಹು ನ್ಹವೈ. ಕ್ಹುದಾನಿ ಆತ್ಮಾಕ್ಹು ಮನಸಮಾ ಸುನ್ನತಿ ಥಯಲ ಮನಕ್ಹ ವ್ಹೈ ಕೈನ ಕವೈಲಿವಾನು ಕ್ಹುದಾಕ್ಹು ವ್ಹೈ ತೆನೈಸೊ ಮನಕ್ಹೊಕ್ಹು ನ್ಹವೈ.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />ಇಮ್ಮ ರ‍್ಹಯುಮ ಯಹುದಿ ಥೈನ ರ‍್ಹವಾನು ಫೈದೊ ಸುವೈ? ಸುನ್ನತಿ ಕರೈಲಿದಲವಾಲಾವೊಮಾ ಸುಬಿ ಫೈದೊ ಛೆಸು? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />ಹೊ, ಯಹುದಿಯೊನೆ ಘನ್ನಾ ತರಾನು ಖಾಸ ಕವಾನು ಛೆ. ಕ್ಹಾರಾವೊತಿ ಘನ್ನು ಖಾಸ ಸು ವ್ಹೈ ಕದ್ಯಾಮ, ಕ್ಹುದಾ ಯೆಹುದಿಯೊಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಿನ ತಿನು ವಾಕ್ಯಾ ತ್ಯುನೊನೆ ದಿದ್ಯೊ. <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />ದಕ್ಹಾ ಯೆಹುದಿಯೊನಾ ಮನಕ್ಹೊ ಕ್ಹುದಾನೊ ಬರೊಕ್ಹೊ ಮ್ಹೆಲ್ಲಿದ್ಯಾನೈತೊ ಸು ಥಯು? ಇನು ಮತ್ಲಬ ಕ್ಹುದಾ ಬರೊಕ್ಹೊ ನೈಸೊ ರ‍್ಹವಸ ಸು? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />ನೈ! ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಸುಳ್ಳ ರ‍್ಹಯಾತಬಿ ಕ್ಹುದಾ ಕ್ಹರಿಕ್ಹು ರ‍್ಹವಾಲೊ ವ್ಹೈ. ಪವಿತ್ರ ಗ್ರಂಥ ಇಮ್ಮ ಕವಸ.</para>
  <para style="q1" vid="ROM 3:4">ತಾರಿಯೊ ವಾತೊಮಾ ತು ಕ್ಹರಿನೊ ಫೈಸಲೊ ಕರಾಲೊ ವ್ಹೈ ಕೈನ ದೆಕಾಡಿನ ದ್ಯು.</para>
  <para style="q2" vid="ROM 3:4">ತುನೆ ಫೈಸಲೊ ಥಾತಾಮಾ ತು ಝಿತ್ತು. <char style="rq"><ref loc="PSA 51:4">ಕಿರ್ತನೆ 51:4</ref></char><verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />ಕ್ಹುದಾ ಕ್ಹರಿಕ್ಹು ರ‍್ಹವಾಲೊ ವ್ಹೈ ಕೈನ ಅಪೆ ಹಗ್ಲೆಲ್ಲಾ ಕರಾನಾ ತಪ್ಪೊ ದೆಕಾಡಿನ ದಿವಸ. ಇಮ್ಮ ರ‍್ಹಯೊತಬಿ ಕ್ಹುದಾ ಅಪೊನೆ ಶಿಕ್ಷಾ ದೆತಾಮಾ, ತೆ ಅನ್ಯಾಯ ಕರಾಡೊಸ ಕೈನ ಅಪೆ ಕವಾನೆ ಥಾವಸ್ಸು? ಕ್ಹುದಾ ತಿನಿ ಶಿಟ್ಟ ಅಪೊಪರ ಲೈನ ಅನ್ಯಾಯ ಕರಸು? <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />ಕ್ಹರಿಜ಼ ನೈ! ಕ್ಹುದಾ ಅಪೊನೆ ಶಿಕ್ಷಾ ನೈ ದಿವತ್ತೊ, ಕ್ಹುದಾ ಜಗತನೆ ಫೈಸಲೊ ಕರಾನೆ ಥಾತು ನೈ.<verse eid="ROM 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7" />"ಮಿ ಕವಾನು ಸುಳ್ಳ ರ‍್ಹಯಲ ಕ್ಹುದಾನೆ ಕ್ಹರಿಮಾಜ಼ ಮಹಿಮಾ ಥಾವಸ. ಇಮ್ಮ ರ‍್ಹಯುಮ ಮನೆ "ಪಾಪಿ" ವ್ಹೈ ಕೈನ ಫೈಸಲೊ ಥಾವಾನು ಕಾ? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />ಚೊ಼ಕು ಥಾವಾನಾಹುತಿ ಅಪೆ ಕೆಟ್ಟ ಕರಿಯೆ ಕೈನ ಕವಾಕ್ಹು ತಿನೆ ಸುಜ಼ ಫರಕ ನತ್ತಿ. ಘನ್ನಾ ಮನಕ್ಹೊ ಹಮೊನೆ ನಾಮ-ಬೊಟ ಮ್ಹೆಲಸ ವರಿ ಹಮೆ ತ್ಯಯ್ಯೊ ಸಂಗತಿಯೊ ಕಯೆಸ ಕೈನ ಕವಸ. ತೆ ಮನಕ್ಹೊ ತಪ್ಪ ಕರಾಲಾ ಥಯಾಸ. ತ್ಯುನೊನೆ ಶಿಕ್ಷಾ ಥೌ.<verse eid="ROM 3:8" /></para>
  <para style="s">ಕುನ್ನಜ ನಿತಿವಂತವಾಲಾ ನತ್ತಿ</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ಹಮೆ ಲಾಸ್ಟಮಾ ಸು ಕೈಯೆ? ಯಹುದ್ಯೊ ಥಯಲ ಅಪೆ ಬಿಜಾ಼ವೊತಿ ಚೊ಼ಕಾ ವ್ಹೈ ಸು? ನ್ಹವೈ! ಯಹುದಿಯೊನೆ ಯಹುದ್ಯೊ ನೈಸೊವಾಲಾ ಪಾಪಮಾ ಛೆ ಕೈನ ತೆಳಾಮಾಜ಼ ದೆಕಾಡಿನ ದಿದ್ಯೊಸ.<verse eid="ROM 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 3:10" />ಪವಿತ್ರ ಗ್ರಂಥ ಅಮ್ಮ ಕವಸ" ನಿತಿವಂತವಾಲೊ ಕುನ್ನಜ಼ ನತ್ತಿ. ಯಕ್ಲೊಬಿ ನತ್ತಿ<verse eid="ROM 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11" />ಯಕ್ಲೊಬಿ ಶಾಣ್ಯೊ ನತ್ತಿ.</para>
  <para style="q2" vid="ROM 3:11">ಕ್ಹುದಾನಿ ಆರಾಧನಾ ಕರಾಲು ಕುನ್ನಜ಼ ನತ್ತಿ.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಕ್ಹುದಾ ಕಂತಾ ಫರಿ ಗಯಾಸ.</para>
  <para style="q2" vid="ROM 3:12">ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಉಪಯೊಗ ನೈಸೊ ಥಯಾಸ.</para>
  <para style="q2" vid="ROM 3:12">ಚೊ಼ಕು ಕರಾಲೊ ಯಕ್ಲೊಬಿ ನತ್ತಿ. ನತ್ತಿಜ಼ ನತ್ತಿ. <char style="rq"><ref loc="PSA 14:1-3">ಕಿರ್ತನೆ 14:1-3</ref></char><verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />"ತ್ಯುನಾ ವಾತೊ ಖುಲ್ಲಾ ಥಯಲ ಮಜಾ಼ರ ನಿಂಗತ ಛೆ.</para>
  <para style="q2" vid="ROM 3:13">ತ್ಯುನೆ ಸುಳ್ಳ ಬೊಲಾನೆ ತ್ಯುನಿ ಜಿಬ್ಬ ಉಪಯೊಗ ಕರಸ"</para>
  <para style="q2" vid="ROM 3:13">"ತ್ಯುನೆ ಕವಾನಾ ಸಂಗತಿಯೊ ಜ಼ಹರ ರ‍್ಹಯಲ ಕ್ಹಾಪೊನಿಂಗತ ಛೆ. <char style="rq"><ref loc="PSA 140:3">ಕಿರ್ತನೆ 140:3</ref></char><verse eid="ROM 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14" />"ತ್ಯುನಾ ಮ್ಹೊಡಾ ಕ್ಹರಾಪಾಕ್ಹು ವರಿ ಇಸಾಕ್ಹು ಭರಿ ಗಯಾಸ"<verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />"ದುಖ ದಿವಾನೆ ವರಿ ಖಲಾಸ ಕರಾನೆ ತ್ಯುನೆ ಕೆಳಾಮಾಬಿ ತಯ್ಯಾರ ಛೆ.<verse eid="ROM 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16" />ತ್ಯುನೆ ಗಯಲ ಕ್ಹಾರಿ ಜ಼ಗಾ ತ್ರಾಸೊ ವರಿ ಬರಬಾದಿ ಲಾವಸ.<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />ತ್ಯುನೆ ಶಾಂತನಿ ವಾಟ ತಿಳ್ದಿಲಿದ್ಯಾ ನತ್ತಿ" <char style="rq"><ref loc="ISA 59:7-8">ಯೆಶಾಯ 59:7-8</ref></char><verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />"ತ್ಯುನಾ ನಜ಼ರಮಾ ಕ್ಹುದಾನೊ ಭೆಂ ನತ್ತಿ" <char style="rq"><ref loc="PSA 36:1">ಕಿರ್ತನೆ 36:1</ref></char><verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />ಹಮೊನೆ ಹಮ್ನಾ ಗ್ವತ್ತ ಛೆ ನಿಯೊಮೊಮಾ ಸು ಕದ್ಯಾಸ. ಎ ನಿಯಮೊನಾ ಅದಿನಮಾ ಕುನ ಛೆ ತಿನೆ ತ್ಯುನೊನೆ ಧರಮಶಾಸ್ತ್ರನೆ ಅದಿನ ಥೈನ ರ‍್ಹವಾಲಾ ತ್ಯುನಾ ವಿಷಯಮಾ ಧರಮಶಾಸ್ತ್ರ ಎ ಸಂಗತಿಯೊ ಕವಾಡುಸ. ಇನಾಹುತಿ ಹರಯಕ್ಕ ಮ್ಹೊಡು ಭಂದೈನ ವರಿ ಕ್ಹಾರಿ ಜಗತ್ತ ಕ್ಹುದಾನಿ ನ್ಯಾಯನಾ ಫೈಸ್ಲಾನೆ ಯೊಗ್ಯ ವ್ಹೈ ಕೈನ ದಿಕ್ಹಸ. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />ಕಾಕದ್ಯಾಮ ಧರಮಶಾಸ್ತ್ರ ನಿಂಗತ ಚಾ಼ಲಾನಾ ಮುಕಾಂತರ ಕಯೊಜ಼ ಮನಕ್ಹ ಕ್ಹುದಾನಿ ನಜ಼ರಮಾ ನಿತಿವಂತವಾಲಾ ಥಾವಾನೆ ಕಿನೆಜ಼ ಸಾದ್ಯ ನತ್ತಿ. ಧರಮಶಾಸ್ತ್ರ ಅಪೆ ಕರಲ ಪಾಪೊ ದೆಕಾಡಿನ ದಿವಸ.<verse eid="ROM 3:20" /></para>
  <para style="s">ಅಪೆ ಕಿಮ್ಮ ಕ್ಹುದಾನಾ ಕ್ಹಾಮಾ ಧರಮಿ ಥೈನ ರ‍್ಹಯೆಸ</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />ತೆನೈಸೊ ಹಮ್ನಾ ಕ್ಹುದಾ ಧರಮಶಾಸ್ತ್ರ ನೈಸೊಜ಼ ಮನಕ್ಹೊನೆ ಕ್ಹುದಾ ನಿತಿವಂತವಾಲಾ ಥಾವಾಹುತಿ ವಾಟ ದೆಕಾಡಿನ ದಿದ್ಯೊಸ. ಎನೈಸೊ ಎ ವಾತನಿ ಸಾಕ್ಷಿ ಮೊಶೆನು ಧರಮಶಾಸ್ತ್ರ ವರಿ ಪ್ರವಾದಿಯೊ ದಿದ್ಯಾಸ. <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />ಬರೊಕ್ಹಾನಾ ಮುಲಕ ಕದ್ಯಾಮ ಯೆಸು ಕ್ರಿಸ್ತಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಾಲಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಕ್ಹುದಾ ನಿತಿವಂತವಾಲಾ ಕರಸ. ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಯಕ್ಕಜ಼ ವ್ಹೈ. <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />ವರಿಬಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಪಾಪ ಕರಿನ ಕ್ಹುದಾನಿ ಮಹಿಮಾ ದೆಕ್ಯಾವಾಚಿ ಛೆ. <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />ತೆನೈಸೊ ಯೆಸು ಕ್ರಿಸ್ತನ ಬಿಡುಗಡೆನಾ ಮುಕಾಂತರ ಕ್ಹುದಾನಿ ಫ್ರಿ ಗಿಫ್ಟನಿ ವರಾ ಮರಗಾಕ್ಹು ತಿನಾ ಕ್ಹಾಮಾ ನಿತಿವಂತವಾಲಾ ವ್ಹೈ ಕೈನ ಫೈಸಲೊ ಥಯೊಸ. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />ಕ್ಹುದಾ ಬರೊಕ್ಹಾನಾ ಮುಕಾಂತರ ಮನಕ್ಹೊನಾ ಪಾಪೊನೆ ಮಾಫ ಕರಾನಿ ವಾಟ ದೆಕಾಡ್ಯೊಸ. ತೆ ವಾಟ ಯೆಸು ಕ್ರಿಸ್ತ ವ್ಹೈ. ಕ್ಹುದಾ ಯೆಸುನಾ ರಗತನಾ ಮುಲಕ ಪಾಪ ಮಾಫ ಕರಸ. ಕ್ಹುದಾ ಕರಾನು ಕ್ಹಾರುಜ಼ ಚೊ಼ಕೊಜ಼ ವ್ಹೈ. ವರಿ ಕ್ಹರಿಕ್ಹು ರ‍್ಹವಸ ಕವಾನು ಎ ದೆಕಾಡಿನ ದಿವಸ. ಕ್ಹುದಾ ಪಾಚ಼ಲ್ಯಾ ಕಾಲಮಾ ತಡ್ದಿಲಿವಾನು ಮನಕ್ಹೊನಾ ಪಾಪನೆ ದಂಡದಿದ್ಯಾವಾಚಿ ಜಾ಼ತಾಮಾ ತೆಳಾಮಾಬಿ ಕ್ಹುದಾ ನಿತಿವಂತವಾಲೊ ವ್ಹತ್ತೊ. <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />ಇಮ್ಮ ಕ್ಹುದಾ ತೆಜ಼ ನಿತಿವಂತವಾಲೊ ವ್ಹೈ ಕೈನ ವರಿ ಯೆಸುಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಲ ಕಯೊಬಿ ರ‍್ಹೈನೆಕಾ ನಿತಿವಂತವಾಲೊ ಥಾವಸ ಕೈನ ದೆಕಾಡಿನ ದಿದ್ಯೊಸ.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />ತೆನೈಸೊ ಅಪೆ ಕಯಾ ವಿಷಯನಾಹುತಿ ಮ್ಹೊಟುಪನ ಕರಸಕೆಸ ಕಯುಜ಼ ನ್ಹವ್ಹೈ! ವರಿ ತಿನೆ ಕಾರಣ ಸುವ್ಹೈ? ಅಪೆ ಧರಮಶಾಸ್ತ್ರ ನಿಂಗತ ಚಾ಼ಲಾನು ತಿನು ಕಾರಣ ವ್ಹೈಸು? ನ್ಹವೈ! ತೆನೈಸೊ ಅಪೆ ಕಿಪರ ಬರೊಕ್ಹೊ ಕರೆಸ ತೆ ಅಪ್ನು ಮ್ಹೊಟಾಪನನೆ ಕಾರಣ ಥಯುಸ. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />ಲಾಸ್ಟಮಾ ಮಿ ಅಮ್ಮ ಕೌಸ ಕಯೊಬಿ ಧರಮಶಾಸ್ತ್ರನಾ ಕಾಮೊಕ್ಹು ನೈ ತೆನೈಸೊ ಬರೊಕ್ಹಾಕ್ಹುಜ಼ ತೆ ನಿತಿವಂತ ವ್ಹೈ ಕೈನ ಕವೈಲಿವಸ. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />ಕ್ಹುದಾ ಯಹುದ್ಯೊನೊ ಕ್ಹುದಾ ಯಕ್ಕಜ಼ ವ್ಹೈ ಸು? ತೆ ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೊಬಿ ಕ್ಹುದಾ ನ್ಹವೈ ಸು? ಹೊ, ತೆ ಯೆಹುದಿಯೊ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೊಬಿ ಕ್ಹುದಾ ವ್ಹೈ. <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />ತೆ ಖತ್ನಾ ಕರಿಲಿದಲವಾಲಾವೊನೆ ನಿತಿವಂತವಾಲಾ ವ್ಹೈ ಕೈನ ಫೈಸಲೊ ಕರಾನು ತ್ಯುನೊ ಬರಕ್ಹೊಜ಼ ಆಧಾರ ವ್ಹೈ. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ಬರೊಕ್ಹಾನಿ ವಾಟಮಾ ಚಾ಼ಲಾನಾ ಮುಕಾಂತರ ಅಪೆ ಧರಮಶಾಸ್ತ್ರನೆ ವಪ್ಪಿಲೆತಾ ನೈ ಸು? ನೈ! ನ್ಹವೈ ಕ್ಹರಿಜ಼ ನ್ಹವೈ! ತೆನೈಸೊ ಅಪೆ ಧರಮಶಾಸ್ತ್ರಮಾ ಹಜು಼ನ ಘನ್ನಿ ತಾಕತಕ್ಹು ಘಟ್ಟ ಥೈನ ರ‍್ಹವಾಡಾಸ.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">ಅಬ್ರಹಾಮನಿ ಉದಾಹರಣೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />ತಿಮ್ಮ ರ‍್ಹಯುಮ, ಅಪ್ನೊ ಪಿತೃಥಯಲ ಅಬ್ರಹಾಮನಾ ಹುತಿ ಅಪೆ ಸು ಕಯ್ಯೆ? ತೆ ಬರೊಕ್ಹಾನಾಹುತಿ ಸು ಶಿಕ್ಯೊ? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />ತೆನೈಸೊ ತೆ ಕರಾನಾ ಕಾಮೊಕ್ಹು ನಿತಿವಂತವಾಲೊ ವ್ಹೈ ಕೈನ ಕವೈಲಿವಾನೆ ಕಾರಣ ರ‍್ಹತುತು. ವರಿಬಿ ಅಬ್ರಹಾಮ ಕ್ಹುದಾನಾ ಕ್ಹಾಮೊ ಮಿ ವ್ಹೈ ಕೈನ ಕವಾನೆ ಥಯು ನೈ. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />"ಅಬ್ರಹಾಮ ಕ್ಹುದಾನೆ ನಂಬ್ಯೊ. ಕ್ಹುದಾ ಅಬ್ರಹಾಮನೊ ಬರೊಕ್ಹಾನಾಹುತಿ ತೆ ನಿತಿವಂತವಾಲೊ ವ್ಹೈ ಕ್ಹುದಾ ಸ್ವಿಕಾರ ಕರ‍್ಯೊ" ಕೈನ ಪವಿತ್ರ ಗ್ರಂಥ ಕವಸ. <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />ರಾಬಾಲಾನೆ ಮಳಾನೊ ಪಗಾರ ಮಳು ಗಿಫ್ಟ ನ್ಹವೈ. ತೆ ತಿನೆ ಮಳಾನೊ ಹಕ್ಕ ವ್ಹೈ, <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />ತೆನೈಸೊ ಯಕ್ಲೊ ತೆ ಕರಾನಾ ಕಾಮಪರ ಬರೊಕ್ಹೊ ಕರಾತಿ ಕ್ಹುದಾಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಸ. ಕ್ಹುದಾ ಕೆಟ್ಟ ರ‍್ಹಯಲವಾಲಾನೆ ಧರಮಿ ಕರಾಲೊ ಕ್ಹುದಾ ವ್ಹೈ. ತೆ ಕ್ಹುದಾಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಲ ಎ ಬರೊಕ್ಹೊ ತಿನೆ ಕ್ಹುದಾನಿ ನಜ಼ರಮಾ ನಿತಿವಂತ ವ್ಹೈ ಕೈನ ದೆಕಾಡಿನ ದಿವಸ. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />ಕ್ಹುದಾ ಯಕ್ಲಾನು ಚೊ಼ಕು ಕಾಮ ದೆಕ್ಯಾವಾಚಿ ತೆ ನಿತಿವಂತವಾಲೊ ವ್ಹೈ ಕೈನ ವಪ್ಪಿಲಿದ್ಯೊಮ ಕ್ಹರಿಮಾ ತೆ ಮನಕ್ಹ ನಸಿಬವಾಲೊ ವ್ಹೈ ಕೈನ ದಾವಿದಬಿ ಕವಸ.<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />"ಕಿನು ತಪ್ಪ ಮಾಫ ಥೈ ಗಯುಸ ಕಿನಾ ತಪ್ಪೊ ಝಕೈ ಗಯಾಸ.</para>
  <para style="q2" vid="ROM 4:7">ತೆ ಕ್ಹರಿಮಾಜ಼ ನಶಿಬವಾಲೊ ವ್ಹೈ!<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />ಕ್ಹುದಾ ಕಿನು ತಪ್ಪ ಶೆಂ ನೈ ಕರತೊ ತೆ ಕ್ಹರಿಮಾಜ಼ ನಸಿಬವಾಲೊ ವ್ಹೈ.<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />ಎ ನಸಿಬ ಖತ್ನಾ ಕರೈಲಿದಲವಾಲಾ ಯಹುದಿಯೊನೆ ಯಕ್ಕಜ಼ ವ್ಹೈಸು? ನೈತೊ ಖತ್ನಾ ನೈ ಕರೈಲಿದವಾಲಾವೊನೆ (ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊ) ಇವ್ನೊ ನಸಿಬ ವ್ಹೈಸು? ಕ್ಹುದಾ ಅಬ್ರಹಾಮನೊ ಬರೊಕ್ಹೊ ವಪ್ಪಿಲಿದ್ಯೊಸ ಕೈನ ತೆಳಾಮಾಜ಼ ಕದ್ಯಾಸ. ತೆ ಬರೊಕ್ಹೊ ತಿನೆ ನಿತಿವಂತವಾಲೊ ಕರ‍್ಯು. <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />ವರಿಬಿ ಎ ಕೆಳಾಮಾ ಥಯು? ಕ್ಹುದಾ ಅಬ್ರಹಾಮನೆ ವಪ್ಪಿಲಿದಲ ತಿನೆ ಸುನ್ನತಿ ಥಾವಾತಿ ಅಗ್ದುರಜ಼ ವ್ಹೈಸು ಸುನ್ನತಿ ಥಯಲ್ಪರ ವ್ಹೈ? ಕ್ಹುದಾ ತಿನೆ ವಪ್ಪಿಲಿದಲ ಸುನ್ನತಿ ಥಾವಾತಿ ಅಗ್ದುರಜ಼ ವ್ಹೈ. <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />ಕ್ಹುದಾ ತಿನೆ ವಪ್ಪಿಲಿದ್ಯೊಸ ಕೈನ ದೆಕಾಡಾನಾಹುತಿ ಅಬ್ರಹಾಮ ಪಾಚಾ಼ತೊ ಸುನ್ನತಿ ಕರೈಲಿದ್ಯೊ. ಅಬ್ರಹಾಮ ಸುನ್ನತಿ ಕರೈಲಿವಾತಿ ಅಗ್ದುರಜ಼ ಬರೊಕ್ಹಾನಾ ಮುಲಕ ನಿತಿವಂತವಾಲೊ ವ್ಹತ್ತೊ. ತಿನಾಹುತಿ ಅಬ್ರಹಾಮ ಕ್ಹುದಾನೆ ಬರೊಕ್ಹೊ ಕರಾಲಾ ಕ್ಹಾರಾವೊನೆ ಆತ್ಮಿಕ ಬಾ ಥಯೊಸ ವರಿ ತ್ಯುನೆ ಸುನ್ನತಿ ನೈ ಕರೈಲಿನತ ಬಿ ತ್ಯುನೊಕ್ಹು ನ್ಯಾಯಮಾ ಸ್ವಿಕಾರ ಕರೈಲಿದಲವಾಲಾ ವ್ಹೈ. <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />ತೆನೈಸೊ ಸುನ್ನತಿ ಕರೈಲಿದಲ ಮನಕ್ಹೊನೆಬಿ ಅಬ್ರಹಾಮ ಮುಲ ಪಿತೃ ಥಯೊಸ. ತೆನೈಸೊ ತೆ ತ್ಯುನೊನೆ ಮುಲ ಪಿತೃ ಥಯಲ ತ್ಯುನೆ ಕರೈಲಿದಲ ಸುನ್ನತಿಕ್ಹು ನ್ಹವೈ. ಅಪ್ನೊ ಮುಲ ಪಿತೃ ಥಯಲ ಅಬ್ರಹಾಮ ಸುನ್ನತಿ ಕರೈಲಿವಾತಿ ಅಗ್ದುರಜ಼ ತೆ ಕಿಮ್ಮ ಬರೊಕ್ಹಾಮಾ ವ್ಹತ್ತೊ ತಿನಾ ನಿಂಗತಜ಼ ರ‍್ಹಯಲವಾಲಾವೊನೆ ತೆ ಮುಲ ಪಿತೃ ಥಯೊಸ.<verse eid="ROM 4:12" /></para>
  <para style="s">ಬರೊಕ್ಹಾನಾ ಮುಲಕ ಕ್ಹುದಾನು ವಾಗ್ದಾನ ಸ್ವಿಕಾರ ಕರಸ.</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />ಅಬ್ರಹಾಮನೆಬಿ ತಿನಾ ಸಂತತಿನೆಬಿ ದುನಿಯಾಜ಼ ದ್ಯುಸ ಕೈನ ಕ್ಹುದಾ ವಾಗ್ದಾನ ದಿದ್ಯೊ. ತೆನೈಸೊ ಅಬ್ರಹಾಮ ಎ ವಾಗ್ದಾನ ಮಳು ಕದ್ಯಾಮ ಧರಮಶಾಸ್ತ್ರಮಾ ರ‍್ಹಯಲ ತಿಮ್ಮ ಚಾ಼ಲಲಕ್ಹು ನ್ಹವೈ. ಅಬ್ರಹಾಮ ನಿತಿವಂತ ಥೈನ ಬರೊಕ್ಹೊ ಕರಲಕ್ಹು ಎ ವಾಗ್ದಾನ ವ್ಹಂದಿಲಿದ್ಯೊ. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ಕ್ಹುದಾ ದಿವಾನಿಯೊ ವಾಗ್ದಾನೊ ಧರಮಶಾಸ್ತಮಾ ರ‍್ಹಯಲ ತಿಮ್ಮ ಚಾ಼ಲಾಲಾವೊನೆ ದಿವಾನೆ ರ‍್ಹವತ್ತೊ, ಬರೊಕ್ಹೊ ಸುಜ಼ ಉಪಯೊಗ ನ್ಹೊತೊ. ತೆನೈಸೊ ಅಬ್ರಹಾಮನೆ ಕ್ಹುದಾ ದಿದಲ ವಾತ ಸುಜ಼ ಉಪಯೊಗ ನ್ಹೊತಿ. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />ಧರಮಶಾಸ್ತ್ರನೆ ವಿಧೆಯ ಥಯಾವಾಚಿ ರ‍್ಹತಾಮಾ, ಧರಮಶಾಸ್ತ್ರ ಕ್ಹುದಾನೆ ಶಿಟ್ಟಲಾವಾ ವರಕ್ಹು ಥಾತುತು. ವರಿಬಿ ಧರಮಶಾಸ್ತ್ರನಾ ರ‍್ಹವತ್ತೊ ಅವಿಧೆಯ ಥಾವಾನೆ ಸುಜ಼ ರ‍್ಹತು ನೈ.<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />ತಿನಾಹುತಿ ಮನಕ್ಹೊ ಬರೊಕ್ಹೊನಾ ಮುಲಕ ವಾಗ್ದಾನ ಹೊಂದಿಲಿವಸ. ವಾತೊ ಫ್ರಿಮಾ ಮಳು ಕೈನ ವರಿ ಗಿಫ್ಟ ರ‍್ಹೌ ಕೈನ ಇಮ್ಮ ಥಯು. ವಾಗ್ದಾನ ಫ್ರಿನಿ ಗಿಫ್ಟ ರ‍್ಹಯ್ಯೊಮ, ಅಬ್ರಹಾಮನಾ ಮನಕ್ಹೊ ತೆ ವಾತೊ ಹೊಂದಿಲಿವಸ. ಎ ವಾಗ್ದಾನ ಮೊಶೆನಾ ಧರಮಶಾಸ್ತ್ರನೆ ಅಧಿನ ಥೈನ ಜಿವ್ನಾ ಕರತಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಯಕ್ಕಜ಼ ನ್ಹವೈ, ಅಬ್ರಹಾಮ ನಿಂಗತ ಬರೊಕ್ಹಾಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಮನಕ್ಹೊನಾಹುತಿ ವ್ಹೈ. ಅಬ್ರಹಾಮ ಅಪೊನೆ ಕ್ಹಾರಾವೊನೆ ಮುಲ ಪಿತೃ ಥಯೊಸ. <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />ಮಿ ತುನೆ ಘನ್ನಿ ಜನಾಂಗನಾ ಮನಕ್ಹೊನೆ ಬಾ ಥಾವಾ ವರಕ್ಹು ಕರ‍್ಯೊಸ” ಕೈನ ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಬರ್ದಲ ಛೆ. ಎ ಕ್ಹುದಾನಿ ಸನ್ನಿದಿಮಾ ಕ್ಹರಿ ವ್ಹೈ. ಮರಲವಾಲಾವೊನೆ ಜ಼ಲಮ ದಿವಾನು ಹಜು಼ನಬಿ ನೈ ಥಯಲ ಕಾಮೊ ಕರಾಲಾ ಕ್ಹುದಾನೆ ಅಬ್ರಹಾಮ ನಂಬ್ಯೊ. <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />ಅಬ್ರಹಾಮನೆ ಬಚ್ಚಾ಼ ಥಾವಾನೆ ವಾಟಜ಼ ನ್ಹೊತಿ. ತಿಮ್ಮ ರ‍್ಹಯುತಬಿ ತೆ ಕ್ಹುದಾಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲ್ಯೊ ವರಿಬಿ ತೆ ಆಸ ಮ್ಹೆಲಲಕ್ಹು ತೆ ಘನ್ನಿ ಜ಼ನಾಂಗನೆ ಬಾ ಥಯೊ. ಕ್ಹುದಾ ತಿನೆ "ತು ಘನ್ನಿ ಜ಼ನಾಂಗನೆ ಪಡ್ದಿಲೆಶಿ" ಕೈನ ಕದಲ ಪುರಾ ಥಯು. <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />ಅಬ್ರಹಾಮನೆ ಕಮ್ಸಿ ಕಮ ಕ್ಹೊ ವೈಸ ಥಯಲಕ್ಹು ತಿನು ಅಂಗಬಿ ತಾಕತ ನೈಸೊ ಥೈ ಗಯುತು. ತಿನಾಹುತಿ ತಿನೆ ಬಚ್ಚಾ಼ ಥಾವಾನೆ ಸಾದ್ಯ ನ್ಹೊತು. ತೆನೈಸೊ ಸಾರಳನೆಬಿ ಬಚ್ಚಾ಼ ಥಾವಾ ವರಕ್ಹು ನ್ಹೊತು. ಅಬ್ರಹಾಮ ಇನಾಹುತಿ ವಿಚಾರ ಕರ‍್ಯೊ. ತಿಮ್ಮ ರ‍್ಹಯುತಬಿ ಕ್ಹುದಾಪರ ರ‍್ಹಯಲ ತಿನೊ ಬರೊಕ್ಹೊ ಕಮ ಥಯೊ ನೈ. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />ಕ್ಹುದಾ ದಿದಲ ವಾಗ್ದಾನಪರ ತೆ ಸಂಶೊ ಕರ‍್ಯೊ ನೈ ವರಿ ತಿನಾ ಬರೊಕ್ಹೊನೆ ಕಮ್ಮ ಥಾವಾನೆ ದಿದ್ಯೊ ನೈ. ತಿನೊ ಬರೊಕ್ಹೊಜ಼ ತಿನೆ ಘಟ್ಟ ಕರ‍್ಯು ವರಿ ತೆ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಕದ್ಯೊ. <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />ಕ್ಹುದಾ ದಿದಲ ವಾಗ್ದಾನ ಪುರಾ ಕರಸ ಕೈನ ಅಬ್ರಹಾಮ ನಂಬ್ಯೊತೊ. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />ತಿನಾಹುತಿ "ಕ್ಹುದಾ ಅಬ್ರಹಾಮನಾ ಬರೊಕ್ಹೊನಾಕ್ಹು ತಿನೆ ನಿತಿವಂತವಾಲಾ ವ್ಹೈ ಕೈನ ಕ್ಹುದಾ ವಪ್ಪಿಲಿದ್ಯೊ" <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />"ನಿತಿವಂತ" ಕವಾನಿ ಎ ವಾತ ಅಬ್ರಹಾಮನೆ ಯಕ್ಕಜ಼ ನ್ಹವೈ. <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />ತೆ ಅಪ್ನಾಹುತಿಬಿ ಬರ್ದಲ ವ್ಹೈ. ಅಪೆ ಬರೊಕ್ಹೊ ಕರಿಯೆಸ. ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನೆ ಮರಲವಾಲಾವೊಮಾತೊ ಜಿವ್ತೊ ಕರಿನ ಉಟಾಡಲವಾಲಾನೆ ಅಪೆ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಿಯೆಸ. <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />ಅಪ್ನಾ ಪಾಪೊನಾಹುತಿ ಯೆಸುನೆ ಮರಾನೆ ದಿದ್ಯಾ. ಅಪೊನೆ ನಿತಿವಂತವಾಲಾ ಕರಾನಾಹುತಿ ತಿನೆ ಮರಲವಾಲಾವೊಮಾತೊ ವರಿ ಜಿವ್ತೊ ಕರಿನ ಉಟಾಡ್ಯೊ.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಚೊ಼ಕು</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ಅಪೆ ಬರೊಕ್ಹಾಕ್ಹು ನಿತಿವಂತವಾಲಾ ಥಯಾಸ. ತಿನಾಹುತಿ ಅಪ್ನೊ ಪ್ರಬು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಅಪೆ ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಸಮಾಧಾನಕ್ಹು ಛೆ. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />ಹಮ್ನಾ ಅಪೆ ಕ್ಹುಶಿ ಕರತಾ ರ‍್ಹಯಲ ಕ್ಹುದಾನಿ ಮರಗಾಕ್ಹು ಕ್ರಿಸ್ತಜ಼ ಅಪೊನೆ ಅಪ್ನಾ ಬರೊಕ್ಹಾನಾ ಮುಲಕ ಲಾಯೊಸ. ಕ್ಹುದಾನಿ ಮಹಿಮಾ ಹೊಂದಿಲಿಯೆಸ ಕವಾನು ಆಸ ಅಪೊನೆ ರ‍್ಹಯಲಕ್ಹು ಅಪೆ ಬರೊಕ್ಹಾನಿ ಘಮಂಡಿಕ್ಹು ಛೆ. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />ತೆನೈಸೊ ಅಪನಾ ತ್ರಾಸೊಮಾಬಿ ಖುಶಿಕ್ಹು ಛೆ. ಕಾಕದ್ಯಾಮ ಎ ತ್ರಾಸೊ ಅಪೊನೆ ಹೆಚ್ಕಿ಼ ತಡ್ದಿಲಿವಾನು ಶಿಕ್ಲಾವಸ. <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />ತಡ್ದಿಲಿವಾಕ್ಹು ಅಪೊಮಾ ಚೊ಼ಕಾ ಸ್ವಭಾವ ಹುಟ್ಟಸ. ಚೊ಼ಕಾ ಸ್ವಭಾವಕ್ಹು ಬರೊಕ್ಹೊ ಹುಟ್ಟಸ. <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />ಎ ಆಸ ಅಪೊನೆ ಕೆಳಾಮಾಜ಼ ನಿರಾಶ ಕರತು ನೈ. ಕಾಕದ್ಯಾಮ ಕ್ಹುದಾ ಅಪೊನೆ ದಿದಲ ಗಿಫ್ಟ ಪವಿತ್ರ ಆತ್ಮಾನಾ ಮುಲಕ ತಿನಿ ಮಯಾ ಘನ್ನಿ ದೆಕಾಡ್ಯೊಸ.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />ಅಪೆ ಆಸ ನೈಸೊವಾಲಾ ರ‍್ಹತಾಮಾ, ಕ್ಹುದಾ ಇನಿಲಿದಲ ಟೈಮಮಾ ಕ್ರಿಸ್ತ ಅಪ್ನಾ ಕೆಟ್ಟ ರ‍್ಹಯಲವಾಲಾವೊನಾ ಹುತಿ ಮರ‍್ಯೊ. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />ನಿತಿವಂತವಾಲಾನೊ ಜ಼ಲಮ ವಚಾ಼ಡಾನಾಹುತಿ ಯಕ್ಲೊ ಜ಼ಲಮ ದಿವಾನು ಅಪರುಪ ವ್ಹೈ. ಕ್ಹರಿಮಾಜ಼ ಚೊ಼ಕೊ ರ‍್ಹಯಲವಾಲೊ ಯಕ್ಲಾನಾಹುತಿ ಜ಼ಲಮ ದಿವಾನೆ ಯಕ್ಲೊ ತಯ್ಯಾರ ಥಾಸ. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />ತೆನೈಸೊ ಅಪೆ ಪಾಪಿಯೊ ರ‍್ಹತಾಮಾಜ಼ ಕ್ರಿಸ್ತ ಪಾಪಿಯೊನಾಹುತಿ ಜ಼ಲಮ ದಿದ್ಯೊ. ಇನಾಹುತಿ ಕ್ಹುದಾ ಅಪೊಪರ ರ‍್ಹಯಲ ಘನ್ನಿ ಮಯಾ ಇಮ್ಮ ಅಪೊನೆ ದೆಕಾಡಿನ ದಿವಸ. <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />ಅಪೆ ಕ್ರಿಸ್ತನಾ ರಗತನಾ ಮುಲಕ ಕ್ಹುದಾನಿ ನಜ಼ರಮಾ ನಿತಿವಂತವಾಲಾ ಥಯಾಸ. ತಿನಾಹುತಿ ತಿನಾ ಮುಲಕ ಕ್ಹುದಾನಿ ಶಿಟ್ಟಕ್ಹು ವಾಚಿಯೆಸ. <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />ಕಾಕದ್ಯಾಮ ಅಪೆ ಕ್ಹುದಾನಾ ವಿರೊಧಿಯೊ ರ‍್ಹತಾಮಾಜ಼ ಕ್ಹುದಾ ತಿನಾ ದಿಕ್ರಾನಾ ಮರಣನಾ ಮುಲಕ ಅಪೊನೆ ತಿನಾ ದೊಸ್ತೊ ಕರಲಿದ್ಯೊಸ. ಹಮ್ನಾ ಅಪೆ ಕ್ಹುದಾನಾ ದೊಸ್ತೊ ಥಯಲಕ್ಹು ಕ್ಹುದಾ ತಿನಾ ದಿಕ್ರಾನಾ ಜ಼ಲಮನಾ ಮುಲಕ ಅಪೊನೆ ವಚಾ಼ಡಾನು ಹೆಚ್ಕಿ ದೆಕಾಡಿನ ದಿವಸ. <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />ಅಕ್ಲುಜ಼ ನೈಸೊ, ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಅಪೆ ಕ್ಹುದಾಮಾ ಕ್ಹುಶಿಕ್ಹು ರ‍್ಹೈಯೆಸ. ಹಮ್ನಾ ಅಪೆ ತಿಕ್ಹುಜ಼ ಕ್ಹುದಾನಾ ದೊಸ್ತೊ ಥಯಾಸ.<verse eid="ROM 5:11" /></para>
  <para style="s">ಆದಾಮ ವರಿ ಕ್ರಿಸ್ತ</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />ಯಕ್ಕ ಮನಕ್ಹ ಆದಾಮ ಕರಲ ಕಾಮೊಕ್ಹು ಪಾಪ ಕ್ಹಾರಿ ಜಗತ್ನೆಜ಼ ಐಯು. ತಿನಾಹುತಿ ತೆ ಪಾಪಜ಼ ಮರಣ ಕವಾನು ಐಯು. ತಿನಾಹುತಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಮರುಜ಼; ಕಾಕದ್ಯಾಮ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಪಾಪ ಕರ‍್ಯಾಸ. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />ಮೊಶೆನಾ ಧರಮಶಾಸ್ತ್ರತಿ ಅಗ್ದುರಜ಼ ಜಗತ್ಮಾ ಪಾಪ ವ್ಹತ್ತು. ತೆನೈಸೊ ಧರಮಶಾಸ್ತ್ರ ನೈ ರ‍್ಹವತ್ತೊ, ಕಿನುಜ಼ ಪಾಪ ಮೊಜಾ಼ನೆ ಥಾತು ನ್ಹೊತು. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />ತೆನೈಸೊ ಆದಾಮಾನಾ ಕಾಲತೊ ಮೊಶೆನಾ ಕಾಲ ಲಕ್ಕಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಮರಾನು ಥೈಯು. ಆದಾಮ ಪಾಪ ಕರಲಹುತಿ ಮರ‍್ಯೊ. ಕ್ಹುದಾನಿ ವಾತ ದಾಟಿನ ಗಯಲ ತೆ ಪಾಪ ವ್ಹೈ. ವರಿಬಿ ಆದಾಮ ಕರಲ ಪಾಪ ನಿಂಗತ ಮ್ಹೊಟು ಪಾಪ ನೈ ಕರಲವಾಲಾಬಿ ಮರವಾನೆಜ಼ ಥಯು.</para>
  <para style="p" vid="ROM 5:14">ಆದಾಮ ಅಗಲ್ಯಾ ಲೊಕಮಾ ಆವಾನೊ ರ‍್ಹಯಲ ಯಕ್ಲಾನೆ (ಕ್ರಿಸ್ತನೆ) ವಳಕ ಥಯೊತೊ. <verse eid="ROM 5:14" /><verse number="15" style="v" sid="ROM 5:15" />ತೆನೈಸೊ ಕ್ಹುದಾ ಗಿಫ್ಟ ನಿಂಗತ ದಿದಲ ಆದಾಮನಾ ಪಾಪ ನಿಂಗತ ನತ್ತಿ. ತೆ ಯಕ್ಲೊ ಪಾಪ ಕರಲಹುತಿ ಘನ್ನಾ ಮನಕ್ಹೊ ಮರ‍್ಯಾ. ತೆನೈಸೊ ಕ್ಹುದಾನಿ ಮರಗಾ ಮನಕ್ಹೊನೆ ಮಳಲ ತಿತ್ತಿಬಿ ಮ್ಹೊಟಿ ವ್ಹೈ. ಯೆಸು ಕ್ರಿಸ್ತ ಕವಾಲಾ ಯಕ್ಕ ದಾಣ್ಗಾನಾ ಕೃಪಾನಾ ಮುಲಕ ಕ್ಹುದಾ ದಿವಾನೊ ಫ್ರಿನೊ ಜ಼ಲಮ ಘನ್ನಾ ಮನಕ್ಹೊ ಹೊಂದಿಲಿದ್ಯಾ. <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />ಆದಾಮ ಯಕ್ಕ ಸಲಾ ಪಾಪ ಕರಲಹುತಿ ತಿನೆ ಅಪರಾದಿ ವ್ಹೈ ಕೈನ ಫೈಸಲೊ ಥಯೊ. ಕ್ಹುದಾ ದಿವಾನು ಫ್ರಿನು ಗಿಫ್ಟ ತಿನಾ ವಿರೊಧ ವ್ಹೈ. ಘನ್ನಾ ಮನಕ್ಹೊ ಪಾಪ ಕರಲಹುತಿ ಕ್ಹುದಾನಾ ಘನ್ನಾ ಫ್ರಿನಾ ಗಿಫ್ಟ ಆಯಾತಾ. ತೆ ಫ್ರಿನು ಗಿಫ್ಟ ಘನ್ನಾ ಮನಕ್ಹೊನೆ ನಿತಿವಂತವಾಲಾ ಕರ‍ಸ. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />ಯಕ್ಲೊ ಪಾಪ ಕರ‍್ಯೊ, ತೆ ಯಕ್ಲಾನಾಹುತಿ ಕ್ಹಾರಾ ಜ಼ನಾವೊಪರ ಮರಣ ಕವಾನು ರಾಜ಼ ಕರ‍್ಯು. ತೆನೈಸೊ ದಕ್ಹಾ ಮನಕ್ಹೊ ಕ್ಹುದಾನಿ ಘನ್ನಿ ಮರಗಾಕ್ಹು ವರಿ ನಿತಿವಂತವಾಲಾ ಕರಾನಿ ತಿನಿ ಮ್ಹೊಟಿ ಗಿಫ್ಟನೆ ಸ್ವಿಕಾರ ಕರಸ. ಕ್ಹರಿಮಾಜ಼ ತ್ಯುನೆ ಯೆಸು ಕ್ರಿಸ್ತ ದಾಣ್ಗಾನಾ ಮುಲಕ, ಕ್ಹರಿನೊ ಜ಼ಲಮ ಹೊಂದಿಲಿವಸ ವರಿ ರಾಜ಼ ಕರಸ.<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />ಇಮ್ಮ ರ‍್ಹೈನಬಿ ಆದಾಮನು ಯಕ್ಕ ಪಾಪ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಮರವಾನೊ ಫೈಸಲೊ ಆಯೊ. ತೆನೈಸೊ ತಿನಾ ನಿಂಗತಜ಼, ಕ್ರಿಸ್ತ ಕರಲ ಯಕ್ಕ ಚೊ಼ಕು ಕಾಮ, ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ನಿತಿವಂತವಾಲಾ ಕರಸ. ವರಿ ತೆ ಮನಕ್ಹೊನೆ ಕ್ಹರಿನೊ ಜ಼ಲಮ ಲಾವಸ. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />ಯಕ್ಲೊ ಕ್ಹುದಾನಿ ವಾತ ದಾಟಿನ ಗಯಲಹುತಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಪಾಪಿ ಥಯಾ. ತೆನೈಸೊ ಯಕ್ಲೊ ಕ್ಹುದಾನಿ ವಾತ ಪುರಾ ಕರಲಹುತಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ನಿತಿವಂತವಾಲಾ ಥಾವಸ.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />ಧರಮಶಾಸ್ತ್ರ ಆಯಲಹುತಿ ಮನಕ್ಹೊನಾ ಘನ್ನಾ ಪಾಪೊ ಹೆಚ್ಕಿ಼ ದಿಕ್ಹಿನ ಆಯಾ. ತೆನೈಸೊ ಮನಕ್ಹೊ ಘನ್ನಾ ಪಾಪೊ ಕರಲ ಟೈಮಮಾ, ಕ್ಹುದಾ ತ್ಯುನೊನೆ ಹೆಚ್ಕಿ಼ ಮರಗಾ ದೆಕಾಡ್ಯೊ. <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />ಯಕ್ಕ ಕಾಲಮಾ ಪಾಪ ಮರಣನಾ ಮುಲಕ ಅಪ್ನೊಪರ ರಾಜ಼ ಕರ‍್ಯು. ತೆನೈಸೊ ಕ್ಹುದಾ ಮನಕ್ಹೊನೆ ನಿತಿವಂತವಾಲಾ ಕರು ಕೈನ ತಿನಿ ಘನ್ನಿ ಮರಗಾ ದೆಕಾಡ್ಯೊ. ಎ ಮರಗಾ ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಅಪೊನೆ ಹಮೆಶಾನೊ ಜ಼ಲಮ ಲಾವಸ.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">ಪಾಪನಾ ಪಾಲೆ ಮರಲವಾಲಾ ತೆನೈಸೊ ಕ್ರಿಸ್ತಮಾ ಜಿವ್ತಾ ರ‍್ಹಯಲವಾಲಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />ತಿಮ್ಮ ರ‍್ಹಯಾಮ ತುಮಾರಿ ವಿಚಾರ ಸು ವ್ಹೈ? ಕ್ಹುದಾ ಅಪೊನೆ ಘನ್ನಿ ಮರಗಾ ದೆಕಾಡಸ ಕೈನ ಅಪೆ ಹಜು಼ನ ಪಾಪ ಕರತಾ ರ‍್ಹೌ ಸು? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />ಕ್ಹರಿಜ಼ ನೈ! ಅಪೆ ಅಪ್ನಾ ಪಾಚ಼ಲ್ಯಾ ಪಾಪನಿ ಜಿವ್ನಾನಾ ಪಾಲೆ ಮರಿ ಗಯಾಸ. ತಿಮ್ಮ ರ‍್ಹಯಾಮ, ಅಪೆ ಪಾಪಮಾಜ಼ ಜಿವ್ನಾ ಕರಾನು ಕಿಮ್ಮ ಸಾದ್ಯ ಛೆ? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />ಅಪೆ ಬಾಪ್ತಿಸ್ಮ ಕರಲೆತಾಮಾ, ಕ್ರಿಸ್ತಮಾ ಪಾಲ ಲಿವಾಲಾ ಥಯಾ ಕವಾನು ತುಮೆ ಇಕ್ಹರಿ ಪಡ್ಯಾ ಸು? ಅಪ್ನಿ ಬಾಪ್ತಿಸ್ಮಕ್ಹು ತಿನಾ ಮರಣಮಾ ಪಾಲ ಲಿವಾಲಾ ಥಯಾ. <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />ತಿಮ್ಮ ರ‍್ಹತಾಮಾ, ಅಪೆ ಬಾಪ್ತಿಸ್ಮ ಕರಲೆತಾಮಾ, ಅಪೊನೆ ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ಸಮಾದಿ ಥೈ ವರಿ ಅಪೆ ತಿನಾ ಮರಣಮಾ ಪಾಲ ಲಿವಾಲಾ ಥಯಾ. ಅಪೆ ಜಿವ್ತಾ ಥೈನ ಉಟಿನ ನಯಿ ಜಿವ್ನಾ ಕರು ಕೈನ ಅಪೊನೆ ಕ್ರಿಸ್ತ ಕ್ಹಾತೆ ಸಮಾದಿ ಥೈ. ಕ್ರಿಸ್ತ ಬಾನಿ ಅದ್ಬುತ ಕರಾನಿ ತಾಕತಕ್ಹು ಮರ‍ಲವಾಲಾವೊಮಾತೊ ಜು಼ವ್ತೊ ಥೈನ ಆಯಲ ನಿಂಗತ ಅಪೆಬಿ ಜಿವ್ತಾ ಥೈನ ಆಯಾಸ.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />ಕಿಮ್ಮ ಅಪೆ ಕ್ರಿಸ್ತ ಮರಣನಾ ಪಾಲ ಥಯಾಸ ತಿಮ್ಮಜ಼ ತೆ ಜಿವ್ತೊ ಥೈನ ಆಯಲ ನಿಂಗತ ಅಪೆಬಿ ಜಿವ್ತಾ ಥೈನ ಆಯಲ ತಿನಾ ಪಾಲಮಾ ಮಳ್ಯಾ. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />ಅಪ್ನಿ ಜು಼ನ್ನಿ ಜಿವಿತ ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ಶಿಲುಬಿಪರ ಮರಿ ಗೈಸ ಕವಾನು ಅಪೊನೆ ಗ್ವತ್ತ ಛೆ. ಅಪ್ನಿ ಪಾಪನಿ ಚಾಳಿಕ್ಹು ಅಪೊಪರ ಕಯೊ ಅದಿಕಾರ ರ‍್ಹೌ ನೈ ಕೈನ ಅಪೆ ಅಗಾ ಪಾಪನಾ ಗುಲಾಮೊ ಥೈನ ರ‍್ಹೌ ನೈ ಕೈನ ಇಮ್ಮ ಥಯು. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />ಪಾಪನಾ ಪಾಲೆ ಮರಲವಾಲೊ ಪಾಪನಾ ಹತ್ಮಾತೊ ಛೊಡೈಲಿದ್ಯೊಸ. <verse eid="ROM 6:7" /><verse number="8" style="v" sid="ROM 6:8" />ಅಪೆ ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ಮರಿ ಗಯಾ, ವರಿ ಅಪ್ನೊ ಬರೊಕ್ಹೊ ತಿನಾ ಕ್ಹಾತೆ ಜಿವ್ತೊ ಕರಸ ಕವಾನು ಕ್ಹರಿಜ಼ ಛೆ. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />ಕ್ರಿಸ್ತ ಮರಲವಾಲಾವೊಮಾತೊ ಜಿವ್ತೊ ಥೈನ ಉಟಿನ ಆಯೊ. ತೆ ವರಿ ಮರಾನೆ ಕೆಳಾಮಾಜ಼ ಸಾದ್ಯ ನತ್ತಿ ಕವಾನು ಅಪೊನೆ ಗ್ವತ್ತ ಛೆ. ಹಮ್ನಾ ಮರಣನೆ ತಿಪರ ಕಯೊ ಅದಿಕಾರ ನತ್ತಿ. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />ಹೊ, ಕ್ರಿಸ್ತನೆ ಹಬ್ದಾ ಪಾಪನಿ ತಾಕತ ಸೊಲ್ಸಾನೆ ಸಾದ್ಯ ನತ್ತಿ. ಹಮ್ನಾ ತಿಮಾ ನಯಿ ಜಿವ್ನಾ ಛೆ. ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಜಿವ್ತಾ ರ‍್ಹವಾನು ತೆಜ಼ ನಯಿ ಜಿವಿತ ವ್ಹೈ. <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />ತಿನಾ ನಿಂಗತಜ಼ ತುಮೆಬಿ ತುಮೊನೆ ಪಾಪನಿ ತಾಕತನಾ ಪಾಲೆ ಮರ‍್ಯಾಸ ಕೈನ ವರಿ ಪಾಪನಿ ಅದಿಕಾರಮಾ ನಕೊ ಚಾ಼ಲೊ ಕ್ರಿಸ್ತ ಯೆಸುನಾ ಮುಕಾಂತರ ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಜಿವ್ನಾ ಕರಿಯೆಸ ಕೈನ ತಿಳ್ದಿಲಿವೊ.<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />ತೆನೈಸೊ ಪಾಪ ತುಮಾರಾ ಮರಾನಾ ಅಂಗಮಾ ಇತ್ತಿ ಉಪ್ಪರ ಅದಿಕಾರ ಕರು ನೈ, ತಿನಾಹುತಿ ತುಮೆ ತುಮಾರಾ ಸ್ವಾಭಾವಿಕ ಸ್ವಭಾವನಾ ಆಸೊ ಪುರಾ ಕರು. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />ತುಮಾರು ಅಂಗನಾ ಭಾಗನೆ ಪಾಪನಿ ಸೆವೆ ಕರಾನೆ ವಪ್ಸಿನ ದಿವೊನಕೊ. ತುಮಾರು ಅಂಗ ಪಾಪನೆ ವಪ್ಸಿನ ಕೆಟ್ಟ ಕಾಮನೆ ಚ಼ಲಾವಾನು ಚಿ಼ಜ ಕರಿಲಿವೊ ನಕೊ. ತಿನಾ ಬದ್ಲಿ ಮರಿನ ಹಮ್ನಾ ಜಿವ್ತೊ ಥೈನ ಉಟಿನ ಆಯಲ ನಿಂಗತ ತುಮೊನೆ ಕ್ಹುದಾನೆ ವಪ್ಸಿನ ದಿಪಾಡೊ. ಚೊ಼ಕಾ ಕಾಮೊ ಕರಾನೆ ತುಮಾರು ಅಂಗ ಸಾಮನ ಥೈನ ಕ್ಹುದಾನೆ ವಪ್ಸಿನ ದಿವೊ. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />ಪಾಪ ತುಮಾರೊ ಮಾಲಕ ಥೈನ ರ‍್ಹತೊ ನೈ. ಕಾಕದ್ಯಾಮ ತುಮೆ ಧರಮಶಾಸ್ತ್ರನೆ ಅದಿನ ನ್ಹವೈ ತೆನೈಸೊ ಹಮ್ನಾ ತುಮೆ ಮರಗಾಮಾ ಜಿವ್ನಾ ಕರಾಲಾ ವ್ಹೈ.<verse eid="ROM 6:14" /></para>
  <para style="s">ನಿತಿನಾ ಗುಲಾಮೊ</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಹಮೆ ಸು ಕರಿಯೆ? ಅಪೆ ಧರಮಶಾಸ್ತ್ರನೆ ಅದಿನಮಾ ರ‍್ಹಯಾವಾಚಿ಼ ಕ್ಹುದಾನಿ ಮರಗಾನಿ ಅದಿನಮಾ ರ‍್ಹಯಲಹುತಿ ಪಾಪ ಕರುಸು? ಕ್ಹರಿಜ಼ ನೈ! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />ತುಮೆ ಕಿನೆತುಬಿ ತಿನಾ ಆಗನ್ಯಾ ಪಾಲ್ಸಾನೆ ವಪ್ಸಿನ ದಿವೊಶಿ. ತೆ ತುಮೊನೆ ಮಾಲಕ ಥಾವಸ ವರಿ ತುಮೆ ತಿನೆ ಗುಲಾಮೊ ಥಾವೊಶಿ. ತಿನಾಹುತಿ ತುಮೆ ಪಾಪನೆ ಗುಲಾಮೊ ಥಾವೊಶಿ ತಿನು ಪರಿಣಾಮ ಮೌತ ಥಯುಸ. ತೆನೈಸೊ ವಿಧೆಯತೆನೆ ಗುಲಾಮೊ ಥಾವಾನು ತೆ ತುಮೊನೆ ಕ್ಹುದಾನಿ ಸನ್ನಿಧಿಮಾ ನಿತಿವಂತವಾಲಾ ಕೈನ ಫೈಸಲೊ ಕರಸ. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />ಪಾಚ಼ಲ್ಯಾ ದಿನೊಮಾ ತುಮೆ ಪಾಪೊನೆ ಗುಲಾಮೊ ವ್ಹತ್ತಾ. ಪಾಪ ತುಮೊನೆ ತಿನಾ ಹತೊಟಿಮಾ ಧರಲಿದ್ಯುತು. ತುಮೊನೆ ಕದಲ ವಿಷಯನೆ ತುಮೆ ಕ್ಹಾರಿ ತರಾಮಾ ವಿದೆಯ ಥಯಲಕ್ಹು ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಥಾವಾದೆ. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />ತುಮೆ ಪಾಪಕ್ಹು ಬಿಡುಗಡೆ ಥಯಾಸ. ಹಮ್ನಾ ತುಮೆ ನಿತಿನೆ ಗುಲಾಮೊ ಥಯಾಸ. <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />ಮನಕ್ಹೊನೆ ಕಳಲ ಉದಾಹರಣೆ ಮುಲಕ ಮಿ ಎ ತುಮೊನೆ ಕವಾಡೊಸ. ಪಾಚ಼ಲ್ಯಾ ಕಾಲಮಾ ತುಮೆ ತುಮಾರಾ ಅಂಗಕ್ಹು ಪಾಪನೆ ಕೆಟ್ಟ ಕಾಮೊನೆ ವರಿ ದುಷ್ಟ ಕಾಮೊನೆ ಗುಲಾಮ ನಿಂಗತ ವಪ್ಸಿನ ದಿದ್ಯಾತಾ ತಿನಾ ನಿಂಗತಜ಼ ಹಮ್ನಾ ತುಮಾರಾ ಅಂಗೊನಾ ಭಾಗನೆ ಪವಿತ್ರ ಆತ್ಮಾನೆ ವಪ್ಸಿನ ದಿದ್ಯಾಸ.<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />ತೆಳಾಮಾ ತುಮೆ ಪಾಪೊನೆ ಗುಲಾಮೊ ವ್ಹತ್ತಾ ವರಿ ನಿತಿನೆ ಹತೊಟಿಮಾ ಪಡ್ಯಾ ನ್ಹೊತಾ. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />ತುಮೆ ಹಮ್ನಾ ಸರಮಾವಾನಾ ಕಾಮೊ ಕರೆ ನೈಸೊ ತುಮೆ ಸು ಪಡ್ದಿಲಿದ್ಯಾಸ? ತೆ ಕಾಮೊನು ಪರಿಣಾಮ ಮೌತ ವ್ಹೈ! <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />ತೆನೈಸೊ ಹಮ್ನಾ ತುಮೆ ಪಾಪಕ್ಹು ಬಿಡುಗಡೆ ಥೈನ ಕ್ಹುದಾನಾ ಗುಲಾಮೊ ಥಯಾಸ. ಇನಾಹುತಿ ತುಮೊನೆ ಪರಶುದ್ದ ಜಿವನ ಹಮೆಶಾನು ಜ಼ಲಮ ಮಳಸ. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />ಕಾಕದ್ಯಾಮ ಪಾಪನಿ ಪಗಾರ ಮರಣ ವ್ಹೈ. ತೆನೈಸೊ ಕ್ಹುದಾ ಫ್ರಿ ದಿವಾನು ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಕ್ರಿಸ್ತ ಯೆಸುಮಾ ರ‍್ಹಯಲ ಹಮೆಶಾನೊ ಜ಼ಲಮ ವ್ಹೈ.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">ಹಿವಾನಾ ಹುತಿ ಯಕ್ಕ ವಿವರಣೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />ಭಾಯೊ ಭೆನೊ, ತುಮೆ ಕ್ಹಾರಾ ಮೊಶೆನು ಧರಮಶಾಸ್ತ್ರನೆ ತಿಳ್ದಿಲಿವೊಶಿ. ಯಕ್ಕ ಮನಕ್ಹ ಜಿವ್ತೊ ರ‍್ಹತಾಮಾಜ಼ ಧರಮಶಾಸ್ತ್ರ ತೆ ಮನಕ್ಹನೆ ರಾಜ಼ ಕರಸ ಕವಾನು ತುಮೊನೆ ಗ್ವತ್ತ ನತ್ತಿ ಸು? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />ಮಿ ತುಮೊನೆ ಯಕ್ಕ ಉದಾಹರಣೆ ಕೌಸ ಮಾಟಿ ಜಿವ್ತೊ ರ‍್ಹಯೆ ಲಕ್ಕಾ ಬೈಕೊ ಕಾನುನನಾ ಪ್ರಕಾರ ತಿನಾ ಹತ್ಮಾ ರ‍್ಹೌ. ತೆನೈಸೊ ತಿನೊ ಮಾಟಿ ಮರ‍್ಯೊಮ, ಹಿವಾನು ಕಾನುನ ನತ್ತಿ ತೆ ಛುಟಲ ನಿಂಗತ ವ್ಹೈ. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />ತೆನೈಸೊ ತಿನೊ ಮಾಟಿ ಜಿವ್ತೊ ರ‍್ಹತಾಮಾಜ಼ ಬಿಜೆ಼ಕ್ಲಾನೆ ಹಿವಾ ಕರಲಿದಿಮ ತೆ ವ್ಯಭಿಚಾರ ಕವಾನಾ ಪಾಪಮಾ ಪಡಲ ನಿಂಗತ ವ್ಹೈ ಕೈನ ಧರಮಶಾಸ್ತ್ರ ಕವಸ. ತೆನೈಸೊ ತಿನೊ ಮಾಟಿ ಮರ‍್ಯೊಮ ತೆ ಹಿವಾನಾ ಬಂದನಮಾತಿ ಛುಟಿ ಗೈಸ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ತಿನೊ ಮಾಟಿ ಮರ‍ಲ್ಪರ ಬಿಜೆ಼ಕ್ಲಾನೆ ಹಿವಾ ಕರಲಿದಿಮ ತೆ ವ್ಯಭಿಚಾರ ಕವಾನಾ ಅಪರಾದನೆ ಗುರಿ ನೈ ಥಾತಿ. <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />ಮಾರಾ ಭಾಯೊ ಭೆನೊ, ಇನಾನಿಂಗತಜ಼ ತುಮಾರಾ ಜು಼ನ್ನಿಯೊ ಚಾಳಿಯೊ ಮರಿ ಗಯ್ಯೊ; ತುಮೆ ಕ್ರಿಸ್ತನಾ ಅಂಗನಾ ಮುಲಕ ಧರಮಶಾಸ್ತ್ರಕ್ಹು ಬಿಡುಗಡೆ ಥಯಾಸ. ಹಮ್ನಾ ತುಮೆ, ಮರಲ ಮನಕ್ಹೊಮಾತಾ ಜಿವ್ತಾ ಥೈನ ಉಟಿನ ಆಯಲವಾಲಾನೆ ಮಳಲವಾಲಾ ಥಯಾಸ. ಅಪೆ ಕ್ಹುದಾನಾಹುತಿ ಫಲ ದಿವಾನೆ ಕ್ರಿಸ್ತನೆ ಮಳಲವಾಲಾ ಥಯಾಸ. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />ಅಪ್ನಿ ಮಾನವ ಸ್ವಭಾನಾ ನಿಂಗತ ಅಪೆ ಜಿವನಾ ರ‍್ಹತಾಮಾ, ಧರಮಶಾಸ್ತ್ರಕ್ಹು ಹುಟ್ಟಲ ಪಾಪನಾ ಆಸೊ ಅಪ್ನಾ ಅಂಗೊಮಾ ಕಾಮ ಕರಾಡಾಸ, ವರಿ ಅಪೆ ಎ ಕ್ಹಾರು ಮರೆ ಲಕ್ಕಾ ಕರೆಸ. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />ತೆನೈಸೊ ಹಮ್ನಾ ಅಪೊನೆ ಧರಮಶಾಸ್ತ್ರಕ್ಹು ಬಿಡುಗಡೆ ಮಳ್ಯುಸ. ಕಾಕದ್ಯಾಮ ಕಯಾ ಧರಮಶಾಸ್ತ್ರಮಾ ಭಾಂದ್ಯಾತಾ ಅಪೆ ತಿನಾಹುತಿ ಮರ‍್ಯಾಸ ಜು಼ನ್ನಾ ಅಕ್ಷರೊಕ್ಹು ನ್ಹವೈ ಆತ್ಮಾನಿ ನಯಿ ತರಾಮಾ ಅಪೆ ಕ್ಹುದಾನಿ ಸೆವೆ ಕರೆಸ.<verse eid="ROM 7:6" /></para>
  <para style="s">ಪಾಪ ವರಿ ಧರಮಶಾಸ್ತ್ರ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />ಪಾಪ ವರಿ ಧರಮಶಾಸ್ತ್ರ ಎ ಭಂಬಿ ಯಕ್ಕಜ಼ ವ್ಹೈ ಕೈನ ಮಿ ಕವಾಡೊಸ ಕೈನ ತುಮೆ ತಿಳದಿಲಕ್ಹು ತೆನೈಸೊ ತೆ ಕ್ಹರಿ ನ್ಹವೈ. ಪಾಪ ಕದ್ಯಾಮ ಸು ವ್ಹೈ ಕವಾನು ಶಿಕ್ಕಾನೆ ಧರಮಶಾಸ್ತ್ರ ಯಕ್ಕಜ಼ ಮನೆ ಯಕ್ಕಜ಼ ಯಕ್ಕ ವಾಟ ಥೈಸ. ಧರಮಶಾಸ್ತ್ರ ನೈ ರ‍್ಹವತ್ತೊ, ಕೆಟ್ಟ ಆಸ ಸುವೈ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ಥಾತು ನ್ಹೊತು. ಬಿಜ಼ಾವೊನಾ ಸಾಮ್ನೊನೆ ತುಮೆ ಆಸ ಕರು ನೈ" ಕೈನ ಧರಮಶಾಸ್ತ್ರ ಕದಲಕ್ಹುಜ಼ ತೆ ಮನೆ ಗ್ವತ್ತ ಥಯು. <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />ತೆನೈಸೊ ಪಾಪ ತೆ ಆಗನ್ಯಾನೆ ಉಪಯೊಗ ಕರಿನ ಮಾರಾಮಾ ಹರಯಕ್ಕ ತರಾನಾ ಕೆಟ್ಟ ಆಸೊನೆ ಶೆಂ ದಿಲೈಯು. ತಿನಾಹುತಿ ತೆ ಆಜ್ಞಾಕ್ಹು ಪಾಪ ಮಾರಾ ಕ್ಹಾಮು ಐಯು. ತೆನೈಸೊ ಧರಮಶಾಸ್ತ್ರ ನೈ ರ‍್ಹವತ್ತೊ, ಪಾಪ ಕವಾನು ರ‍್ಹತುಜ಼಼ ನ್ಹೊತು. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />ಮಿ ಧರಮಶಾಸ್ತ್ರನೆ ತಿಳ್ದಿಲಿವಾತಿ ಪೈಲಾ ಧರಮಶಾಸ್ತ್ರ ನೈ ರ‍್ಹಯಲವಾಲೊ ಥೈನ ಜಿವ್ತೊ ವ್ಹತ್ತೊ. ತೆನೈಸೊ ಧರಮಶಾಸ್ತ್ರನಿ ಆಜ್ಞಾ ಮಕನ ಆತಾಮಾ, ಪಾಪ ಜಿವ್ತು ಥಯು. <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />ಮಿ ಪಾಪನಾಹುತಿ ಆತ್ಮಿಕಮಾ ಮರಿ ಗಯೊ. ಜ಼ಲಮ ದಿವಾನಿ ಆಜ್ಞಾಜ಼ ಮನೆ ಮೌತ ಲೈ. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />ಪಾಪ ತೆ ಆಗನ್ಯಾನೆ ಉಪಯೊಗ ಕರಿನ ಮನೆ ಮೊಸ ಕರಿನ, ಮಾರಾಮಾ ಆತ್ಮಿಕ ಮೌತ ಲಯು.<verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಧರಮಶಾಸ್ತ್ರ ಪವಿತ್ರ ವ್ಹೈ. ಆಗನ್ಯಾ ಪವಿತ್ರ ಫೈಸಲೊ ಚೊ಼ಕು ವ್ಹೈ. <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />ತಿಮ್ಮ ರ‍್ಹಯುಮ, ಚೊ಼ಕೊಜ಼ ಮನೆ ಮೌತ ಲಯುಸ ಕೈನ ಮತ್ಲಬ ವೈಸು? ಕ್ಹರಿಜ಼ ನ್ಹವೈ! ತೆನೈಸೊ ಪಾಪ ಚೊ಼ಕೊಜ಼ ಉಪಯೊಗ ಕರಿನ ಮನೆ ಮೌತ ಲಯು. ಇನಾಹುತಿ, ಮಿ ಪಾಪನು ಅಸ್ಲಿ ರುಪ ದೆಕಾವರಕ್ಹು ಥಯು. ಪಾಪ ಘನ್ನು ಕೆಟ್ಟ ವ್ಹೈ ಕೈನ ಆಜ್ಞಾಕ್ಹು ಗ್ವತ್ತ ಥಯು.<verse eid="ROM 7:13" /></para>
  <para style="s">ಮನಕ್ಹೊಮಾ ಗಲಿಬಿಲಿ</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />ಧರಮಶಾಸ್ತ್ರ ಆತ್ಮಿಕ ರ‍್ಹಯಲ ವ್ಹೈ ಕೈನ ಅಪೊನೆ ಗ್ವತ್ತ ಛೆ. ತೆನೈಸೊ ಮಿ ಶಾರಿರಿಕ ಮನಕ್ಹ ವ್ಹೈ. ಮಿ ಪಾಪನೆ ಇಕ್ಕಲ ಗುಲಾಮ ವೈ ಕೈನ ಪಾಪ ಮಪರ ರಾಜ಼ ಕರಾಡುಸ. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />ಮಿ ಕರಾನಾ ಕಾಮೊ ಮನೆ ಗ್ವತ್ತ ಥಾತು ನೈ. ಮಿ ಕಯಾ ಚೊ಼ಕಾ ಕಾಮೊ ಕರು ಕೈನ ಆಸ ಕರುಸ ತೆ ಕಾಮೊ ಕರ‍್ಯಾವಾಚಿ ಮಿ ನೈ ಶೆರಾನಾ ಕೆಟ್ಟ ಕಾಮೊಜ಼ ಕರುಸ. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />ಮಿ ಕರಾನಾ ಕೆಟ್ಟ ಕಾಮೊ ಕರಾನೆ ಮನೆ ನೈ ಮನಸ ರ‍್ಹೈತುಬಿ, ಧರಮಶಾಸ್ತ್ರ ಚೊ಼ಕು ವ್ಹೈ ಕೈನ ಮಿ ವಪ್ಪಿಲಿದಲ ನಿಂಗತ ಥಯು. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಎ ಕೆಟ್ಟ ಕಾಮೊ ಕರಾಲೊ ಕ್ಹರಿಮಾಜ಼ ಮಿ ನ್ಹವೈ. ಮಾರಾಮಾ ರ‍್ಹಯಲ ಪಾಪಜ಼ ವ್ಹೈ ಎ ಕೆಟ್ಟ ಕಾಮೊ ಕರಸ. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />ಹೊ, ಮಾರಾಮಾ ಕದ್ಯಾಮ ಮಾರಾ ಮಾನವ ಸ್ವಭಾವನಿಯೊ ಚಾಳಿಯೊಮಾ ಚೊ಼ಕು ಸುಜ಼ ನತ್ತಿ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. ಚೊ಼ಕಾ ಕಾಮೊ ಕರಾನೆ ಮನೆ ಮನಸ ರ‍್ಹೈತುಬಿ ತೆ ಕರಾನೆ ಮನೆ ಥಾತು ನೈ. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />ಮಿ ಕರಾನೆ ಆಸ ಕರಲ ಚೊ಼ಕಾ ಕಾಮೊ ಕರಾನೆ ಮನಸ ಕರುಸ ತೆನೈಸೊ ಮಿ ನೈ ಕರಾನಾ ತೆ ಕೆಟ್ಟ ಕಾಮೊಜ಼ ಕರುಸ. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ಮಿ ತೆ ನೈ ಕರಾನಾ ಕಾಮೊ ಮಿ ಕರ‍್ಯೊಮ, ತೆ ಕರಾಲೊ ಕ್ಹರಿಬಿ ಮಿ ನ್ಹವೈ. ಮಾರಾಮಾ ರ‍್ಹಯಲ ಪಾಪಜ಼ ತೆ ಕೆಟ್ಟ ಕಾಮೊ ಕರಸ.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ಮಿ ಎ ನಿಯಮ ಶಿಕ್ಯೊಸ; ಮಿ ಚೊ಼ಕು ಕರಾನೆ ಜಾ಼ತಾಮಾ, ಕೆಟ್ಟ ಮಾರಾಮಾ ರ‍್ಹವಸ. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />ಮಾರಾ ಅಂತರಂಗಮಾ ಕ್ಹುದಾನಿ ನಿಯಮನಾ ವಿಷಯಮಾ ಮಿ ಖುಶಿ ಥೌಸ. <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />ತೆನೈಸೊ ಮಿ ಮಾರಾ ಅಂಗಮಾ ಬಿಜು಼ ನಿಯಮ ಕಾಮ ಕರಾನು ಮಿ ದೆಕುಸ. ಮಾರು ಅಂತರಂಗ ವಪ್ಪಿಲಿವಾನಾ ನಿಯಮನೆ ವಿರುದ್ದ ಥೈನ ತೆ ನಿಯಮ ಹೊರಾಡಸ. ಮಾರಾ ಅಂಗಮಾ ಕಾಮ ಕರಾನಾ ತೆ ಬಿಜು಼ ನಿಯಮಜ಼ ಪಾಪನು ನಿಯಮ ಭಾಂದಸ. ತೆ ನಿಯಮ ಮನೆ ಪಾಪನು ಗುಲಾಮ ಕರಸ. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />ಮಿ ಕೆಕ್ಲೊ ಕೆಟ್ಟ ನಸಿಬವಾಲೊ ವ್ಹೈ. ಮನೆ ಮೌತ ಲಾವಾನಾ ಎ ಅಂಗಕ್ಹು ಮನೆ ವಚಾ಼ಡಾಲು ಕುನ್ನ ವ್ಹೈ? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />ಕ್ಹುದಾ ಮನೆ ವಚಾ಼ಡಸ! ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಕ್ರಿಸ್ತ ಯೆಸುನಾ ಮುಲಕ ತೆ ದಿವಾನಿ ರಕ್ಷಣೆನಾಹುತಿ ತಿನೆ ಸ್ತೊತ್ರ ಥಾವಾದೆ!</para>
  <para style="p" vid="ROM 7:25">ತಿನಾಹುತಿ ಮಾರಾ ಅಂತರಂಗಮಾ ಮಿ ಕ್ಹುದಾನಿ ನಿಯಮನೆ ಗುಲಾಮ ಥಯೊಸ. ತೆನೈಸೊ ಮಾರಾ ಮಾನವ ಸ್ವಭಾವನಿಯೊ ಚಾಳಿಯೊಮಾ ಮಿ ಪಾಪನಾ ನಿಯಮೊನೆ ಗುಲಾಮ ಥಯೊಸ.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">ಪವಿತ್ರಾತ್ಮನಿ ಅಧಿನಮಾನಿ ಜಿವನ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />ತಿನಾಹುತಿ ಹಮ್ನಾ ಕ್ರಿಸ್ತ ಯೆಸುಮಾ ರ‍್ಹವಾಲಾ ಮನಕ್ಹೊನೆ ಅಪರಾದಿಯೊ ವ್ಹೈ ಕೈನ ಫೈಸಲೊ ನೈ ಥಾತೊ. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />ಕಾಕದ್ಯಾಮ ಯೆಸು ಕ್ರಿಸ್ತಮಾ ಜ಼ಲಮ ದಿವಾನಿ ಆತ್ಮಾನಿ ಛೆ ಮನೆ ಮೌತನೆ ಲಿನ ಜಾ಼ವಾನಾ ಪಾಪನಾ ನಿಯಮಕ್ಹು ಮನೆ ಸ್ವತಂತ್ರ ಕರ‍್ಯುಸ. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />ಧರಮಶಾಸ್ತ್ರ ತಾಕತ ನೈಸೊ ವ್ಹತ್ತು. ಕಾಕದ್ಯಾಮ ಅಪ್ನಾ ಮಾನವ ಸ್ವಭಾವನಿಯೊ ಚಾಳಿಯೊಜ಼ ತಿನೆ ತಾಕತ ನೈಸೊ ಕರ‍್ಯು. ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ಧರಮಶಾಸ್ತ್ರ ನೈ ಕರಾನು ಕ್ಹುದಾ ಕರ‍್ಯೊ. ಕ್ಹುದಾ ತಿನಾ ಸ್ವಂತ ದಿಕ್ರಾನೆಜ಼ ಪಾಪನಾ ಚಾಳಿಯೊನಾ ಮನಕ್ಹನಾ ಚಾಳಿಯೊಮಾ ಪಾಪನೆ ಪ್ರಾಯಶ್ಚಿತ ಥೈನ ವಳೈನ ದಿದ್ಯೊ. ತಿನಾಹುತಿ ಕ್ಹುದಾ ಪಾಪನೆ ಮೌತನೊ ಫೈಸಲೊ ದಿವಾನೆ ಮನಕ್ಹನಾ ಚಾಳಿಯೊನೆ ಉಪಯೊಗ ಕರ‍್ಯೊ. <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />ಹಮ್ನಾ ಅಪ್ನಾ ಚಾಳಿಯೊ ನಿಂಗತ ಜಿವ್ನಾ ಕರ‍್ಯಾವಾಚಿ ಪವಿತ್ರ ಆತ್ಮಾ ಕದಲ ನಿಂಗತ ಜಿವ್ನಾ ಕರಾಲಾ ಅಪೊಮಾ ಧರಮಶಾಸ್ತ್ರನಾ ನಿಯಮೊ ಥೌ ಕೈನ ಕ್ಹುದಾ ಇಮ್ಮ ಕರ‍್ಯೊ. <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />ತ್ಯುನಾ ಮನಕ್ಹೊ ಶಾರಿರಿಕನಿಯೊ ಚಾಳಿಯೊ ನಿಂಗತ ಜಿವ್ನಾ ಕರಾಲಾ ಮನಕ್ಹೊ ತ್ಯುನಾ ಮನಕ್ಹೊನಾ ಸ್ವಭಾವನಿಯೊ ಚಾಳಿಯೊ ಸಂಗತಿಯೊನಾ ಹುತಿ ಯಕ್ಕಜ಼ ವಿಚಾರ ಕರಸ. ತೆನೈಸೊ ಆತ್ಮಾ ಕದಲ ನಿಂಗತ ಜಿವ್ನಾ ಕರಾಲಾ ಮನಕ್ಹೊ ತ್ಯುನಾಕ್ಹು ಆತ್ಮಾ ಆಸ ಕರಾನಾ ಕಾಮೊನಾ ಹುತಿ ವಿಚಾರ ಕರಸ. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />ಯಕ್ಲಾನಿ ವಿಚಾರ ತಿನಾ ಪಾಪನಾ ಸ್ವಭಾವ ನಿಂಗತ ರ‍್ಹಯುಮ ತಿನೆ ಆತ್ಮಿಕ ಮೌತ ಥಾವಸ. ತೆನೈಸೊ ಯಕ್ಲಾನಿ ವಿಚಾರ ಪವಿತ್ರ ಆತ್ಮಾನಾ ಹತ್ಮಾ ರ‍್ಹಯಲ ರ‍್ಹಯುಮ, ತಿನಾಮಾ ಜ಼ಲಮ ಸಮಾದಾನ ರ‍್ಹವಸ. <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />ಕಾಕದ್ಯಾಮ ಯಕ್ಲಾನಿ ವಿಚಾರ ತಿನಿ ಪಾಪನಿ ಚಾಳಿನಾ ಹತ್ಮಾ ರ‍್ಹಯಲ ರ‍್ಹಯುಮ, ತೆ ಕ್ಹುದಾನೆ ವಿರೊದ ಥಯೊಸ. ತೆ ಕ್ಹುದಾನಿ ನಿಯಮನೆ ವಿಧೆಯ ಥಾತೊ ನೈ, ವಿಧೆಯ ಥಾವಾನೆ ಸಾದ್ಯಾಜ಼ ನತ್ತಿ. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />ತ್ಯುನಾ ಪಾಪನಾ ಚಾಳಿಯೊ ನಿಂಗತ ರ‍್ಹವಾಲಾ ತೆ ಮನಕ್ಹೊ ಕ್ಹುದಾನೆ ಮೆಚ್ಚಸಾನೆ ಸಾದ್ಯಾಜ಼ ನತ್ತಿ.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />ತೆನೈಸೊ ತುಮೆ ತುಮಾರಾ ಪಾಪೊನಾ ಸ್ವಭಾವ ನಿಂಗತ ನತ್ತಿ. ಕ್ಹುದಾನಿ ಆತ್ಮಾ ತುಮೊಮಾ ಕ್ಹರಿಬಿ ರ‍್ಹಯಲ ರ‍್ಹಯುಮ, ತುಮೆ ಆತ್ಮಾನಾ ಹತ್ಮಾ ಛೆ. ಕಿನಾಮಾಬಿ ಕ್ರಿಸ್ತನಿ ಆತ್ಮಾ ನೈ ರ‍್ಹಯುಮ, ತೆ ಕ್ರಿಸ್ತಮಾ ರ‍್ಹಯಲವಾಲೊ ನ್ಹವೈ. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />ತೆನೈಸೊ ಕ್ರಿಸ್ತ ತುಮೊಮಾ ರ‍್ಹಯೊಮ, ಆತ್ಮಾ ತುಮಾರಿ ಜಿವಿತ ಥಯುತು, ಕಾಕದ್ಯಾಮ ತುಮಾರಾ ಅಂಗೊ ಪಾಪಕ್ಹು ಮರ‍್ಯಾತುಬಿ ತುಮೆ ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಛೆ. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />ಯೆಸುನೆ ಮೌತಕ್ಹು ಉಟಾಡಲ ಕ್ಹುದಾನಿ ಆತ್ಮಾ ತುಮೊಮಾ ರ‍್ಹಯಮ, ಕ್ರಿಸ್ತನೆ ಮೌತಕ್ಹು ಉಟಾಡಲವಾಲೊ ತುಮಾರಿ ಆತ್ಮಾ ಕಂತೊ ತುಮಾರಾ ಮರಲ ಅಂಗೊನೆ ಜ಼ಲಮ ದಿವಸ.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />ತಿನಾಹುತಿ ಮಾರಾ ಭಾಯೊ, ಭೆನೊ, ಅಪೊನೆ ಯೊಗ್ಯತಾ ಛೆ, ತೆನೈಸೊ ಅಪ್ನಿ ಮಾನವ ಸ್ವಭಾವ ಅಪೊನೆ ಪಸಂದ ಆಯಲ ನಿಂಗತ ಜಿವ್ಸಾನೆ ಸಾಧ್ಯ ನತ್ತಿ. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />ತುಮಾರಿ ಪಾಪ್ನಿ ಸ್ವಭಾವ ಛಾಳಿಯೊ ಆಸ ಕರಾನಿಯೊ ಕೆಟ್ಟ ಕಾಮೊ ಕರಾನಾಹುತಿ ತುಮೆ ತುಮಾರಿ ಜಿವಿತ ಉಪಯೊಗ ಕರ‍್ಯಾಮ, ತುಮೆ ಆತ್ಮಿಕಮಾ ಮರೊಸಿ. ತೆನೈಸೊ ತುಮೆ ತುಮಾರಿ ಅಂಗನಾ ಮುಕಾಂತರ ಕರಾನಾ ಕೆಟ್ಟ ಕಾಮೊ ಪವಿತ್ರ ಆತ್ಮಾನಿ ಸಹಾಯಾಕ್ಹು ಹುಬ್ರಾಡ್ಯಾಮ ಜಿವ್ತಾ ರ‍್ಹವೊಶಿ ಸು?. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />ಕುನ್ನ ತ್ಯುನೊನೆ ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಚ಼ಲಾವಾನೆ ವಪ್ಸಿನ ದಿವಸ. ತ್ಯುನೆಜ಼ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ ಥಯಾಸ. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />ಅಪೆ ಹೊಂದಿಲಿದಲ ಆತ್ಮಾ ವರಿ ಅಪೊನೆ ಗುಲಾಮೊ ಕರ‍್ತೊ ನೈ ವರಿ ಅಪೊಮಾ ಬೆ ಹುಟ್ಸಾತೊ ನೈ. ಅಪೆ ಹೊಂದಲಿದಲ ಪವಿತ್ರ ಆತ್ಮಾ ಅಪೊನೆ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ನಿಂಗತ ಕರಸ. ಎ ಆತ್ಮಾನಾ ಮುಲಕ ಅಪೆ ಕ್ಹುದಾನೆ ಬಾ ಕೈನ ಬಲೈಯೆಸ. <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />ಅಪೆ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ ಥಯಾಸ ಕೈನ ಪವಿತ್ರ ಆತ್ಮಾಜ಼಼ ಅಪ್ನಾ ಆತ್ಮಾಮಾ ಸಾಕ್ಷಿ ದಿವಸ. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />ಅಪೆ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ ಥಯಾಮ, ಹೊ ಕ್ಹುದಾನೆ ವಾರಸ್ದಾರ ಥಯಾಸ. ವರಿ ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ಛೆ, ಇಮ್ಮ ಥಯುಮ, ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ಅಪೆ ವಾರಸ್ದಾರ ಥಯಾಸ. ತಿನಿ ಮಹಿಮಾಮಾ ವಾಟೊಲಿವಾ ವ್ಹೈ.<verse eid="ROM 8:17" /></para>
  <para style="s">ಅಗಿ ಆವಾನಿ ಮಹಿಮಾ</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />ಮನೆ ಕಳಲ ತೆಕ್ಲು ಹಮ್ನಾ ಅಪೆ ತ್ರಾಸೊಮಾ ತಡ್ದಿಲಿವಾಡಾಸ. ವರಿಬಿ ಅಪೊನೆ ಅಗು ದಿವಾನು ಮಹಿಮಾನೆ ಎ ಕಸ್ಟ ತ್ರಾಸೊ ಹೊಲಶ್ಯಾಮ ಎ ಮೊಜಾ಼ನೆ ಥಾತೊ ನೈ. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />ಕ್ಹುದಾ ತಿನಾ ಬಚ್ಚಾ಼ವೊನೆ ದೆಕಾಡಾನಾ ದಿನೊಮಾ ಕ್ಹುದಾನಿ ಕ್ಹಾರಿ ಸೃಷ್ಟಿ ಉತ್ಸಾಹಕ್ಹು ಆಸ ಕರಾಡುಸ. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />ಕ್ಹಾರಿ ಸೃಷ್ಟಿಜ಼ ನಿರಾಶನೆ ಮ್ಹೈ ಥೈನ ಛೆ. ಇಮ್ಮ ಥಯಲ ತಿನಿ ಸ್ವಂತ ಉದ್ದೆಶಕ್ಹು ವರಿ ಮನಸಕ್ಹು ನ್ಹವೈ, ಕ್ಹುದಾನಿ ಮನಸಕ್ಹುಜ಼ ವ್ಹೈ ವರಿ ಇಮ್ಮ ಥೌ ಕೈನ ಕ್ಹುದಾನಿ ಆಸ ವ್ಹತ್ತಿ. ತಿನಾಹುತಿ ಸೃಷ್ಟಿ ಹಜು಼ನಬಿ ಆಸ ಕರಾಡಿಸ. <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />ಕ್ಹಾರಿ ಸೃಷ್ಟಿ ನಾಶಕ್ಹು ಬಿಡುಗಡೆ ಥೈನ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ವೊನೆ ಸ್ವತಂತ್ರ ಮಹಿಮಾ ಹೊಂದಿಲಿವಸ ಕವಾನು ವ್ಹೈ. <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />ಕ್ಹಾರಿ ಸೃಷ್ಟಿ ಜ಼ನ್ನಾನಿ ಬಾಣತಿ ತ್ರಾಸ ಖಾತಿ ರ‍್ಹಯಲ ಹೆಣ ಮನಕ್ಹ ನಿಂಗತ ದುಖಕ್ಹು ನೆಳ್ತಿ ಹಜು಼ನ ಲಕ್ಕಾ ಕೈದಾಡಿಸ ಕವಾನು ಅಪೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />ಸೃಷ್ಟಿ ಯಕ್ಕಜ಼ ನೈ, ಅಪೆಬಿ ಅಪ್ನೊಮಾ ದುಖಕ್ಹು ನೆಳ್ತಾ ಕೈದಾಡಾಸ. ಕ್ಹುದಾನಿ ವಾತನಿ ಪೈಲಾನೊ ಭಾಗ ಥಯಲ ಕ್ಹುದಾನಿ ಆತ್ಮಾನೆ ಅಪೆ ಹೊಂದಿಲಿದ್ಯಾಸ. ಅಪೊನೆ ತಿನಾ ಸ್ವಂತ ಬಚ್ಚಾ಼ ಥೈನ ಕರಿಲಿವಾನೆ ಕ್ಹುದಾ ಕರತೊ ರ‍್ಹಯಲ ಕಾಮ ಪುರಾ ಥಾವಾನುಜ಼ ಕದ್ಯಾಮ, ಅಪ್ನಾ ಅಂಗನೆ ಥಾವಾನೆ ಬಿಡುಗಡೆನೆಜ಼ ಅಪೆ ಕೈದಾಡಾಸ. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />ಅಪೆ ರಕ್ಷಣೆ ಹೊಂದಿಲಿದ್ಯಾಸ ವರಿ ಅಪೊನೆ ಹಜು಼ನಬಿ ತೆ ಆಸ ಛೆ. ಅಪೆ ಶಾನಾಹುತಿ ಕೈದಾಡಾಸ ತೆ ದೆಕಾಲಾ ರ‍್ಹಯಾಮ, ತೆ ಕ್ಹರಿನಿ ಆಸ ನ್ಹವ್ಹೈ. ಮನಕ್ಹೊ ತ್ಯುನೆ ಹಮ್ನಾ ಹೊಂದಿಲಿದಲ ಕೈಜ಼ ಆಸ ಕರಸಕೆಸ ಸು? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />ತೆನೈಸೊ ಅಪೆ ಹಜು಼ನಬಿ ನೈ ಹೊಂದಿಲಿದಲ ರ‍್ಹಯಲ ಆಸ ಕರತಾ ತಡ್ದಿಲಿನ ತಿನಾಹುತಿ ಕೈದಾಡಾಸ.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />ತಿನಾ ನಿಂಗತಜ಼ ಅಪೊಮಾ ತಾಕತ ಕಮ ರ‍್ಹಯಲಕ್ಹು ಅಪ್ನಿ ಕಮ್ಮ ತಾಕತಮಾ ಪವಿತ್ರ ಆತ್ಮಾ ಅಪೊನೆ ಸಹಾಯಾ ಕರಸ. ಅಪೆ ಕಿಮ್ಮ ಪ್ರಾಥನಾ ಕರು ವರಿ ಶಾನಾಹುತಿ ಪ್ರಾಥನಾ ಕರು ಕವಾನು ಅಪೊನೆ ಗ್ವತ್ತ ನತ್ತಿ. ತೆನೈಸೊ ಪವಿತ್ರ ಆತ್ಮಾ ತೆ ಅಪ್ನಾಹುತಿ ಕ್ಹುದಾನೆ ಕವಾನೆ ಥಾಯೆ ನೈಸೊ ಮನಸೆ ಮಾಂಗಿಲಿವಸ. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />ಅಂತರಂಗ ದೆಕಾಲಾ ಕ್ಹುದಾನೆ ಪವಿತ್ರ ಆತ್ಮಾನೆ ಮನಸಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರುಜ಼ ಗ್ವತ್ತ ಛೆ, ಕಾಕದ್ಯಾಮ ಕ್ಹುದಾನಿ ಚಿತ್ತ ನಿಂಗತಜ಼ ಪವಿತ್ರ ಆತ್ಮಾ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನಾಹುತಿ ಕ್ಹುದಾಕನ ಮಾಂಗಿಲಿವಸ. <verse eid="ROM 8:27" /><verse number="28" style="v" sid="ROM 8:28" />ಕ್ಹುದಾ ತಿನೆ ಮಯಾ ಕರಾಲಾವೊನಾಹುತಿ ಚೊ಼ಕಾಕ್ಹು ಹರಿ ಯಕ್ಕ ಕಾಮ ಆಸಾನ ಕರಸ ಕೈನ ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. ತೆ ಮನಕ್ಹೊನೆ ಕ್ಹುದಾಜ಼ ಇನಿಲಿದ್ಯೊಸ, ಕಾಕದ್ಯಾಮ ತೆ ತಿನು ಉದ್ದೆಶ ವ್ಹತ್ತು. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />ಕ್ಹುದಾ ಪೈಲಾತೊಜ಼ ತೆ ಭಾಯೊನೆ ಇನಿಲಿದ್ಯೊತೊ ವರಿ ತೆ ಮನಕ್ಹೊ ಇನಾ ದಿಕ್ರಾನಾ ನಿಂಗತ ರ‍್ಹೌ ಕೈನ ಫೈಸಲೊ ಕರ‍್ಯೊ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ಬರೊಕ್ಹಾಮಾ ರ‍್ಹಯಲವಾಲಾವೊಮಾ ತಿನೊ ದಿಕ್ರೊಜ಼ ಮ್ಹೊಟೊ ವ್ಹೈ. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಕಿನೆ ತೆ ಬಲಾವಸ ತಿನೆ ಇನಿಲಿದ್ಯೊಸ ವರಿ ತ್ಯುನೊನೆ ತೆ ನಿತಿವಂತ ಥೈನ ಕರಸ ವರಿ ಮಹಿಮಾಮಾಬಿ ಬಲೈಲಿವಸ.<verse eid="ROM 8:30" /></para>
  <para style="s">ಕ್ರಿಸ್ತ ಯೆಸುಮಾ ಕ್ಹುದಾನಿ ಮಯಾ</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಇನಾಹುತಿ ಅಪೆ ಸು ಕಯ್ಯೆ? ಕ್ಹುದಾ ಅಪ್ನಾ ಕ್ಹಾತೆ ರ‍್ಹತಾಮಾ, ಅಪೊನೆ ವಿರುದ್ದ ಕರಾಲಾ ಕುನ್ನ ವ್ಹೈ. <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />ಕ್ಹುದಾ ತಿನಾ ಸ್ವಂತ ದಿಕ್ರಾನೆ ವಚಾ಼ಡಿ ಲಿದ್ಯಾವಾಚಿ ಅಪೊನೆ ಕ್ಹಾರಾವೊನಾಹುತಿ ವಪ್ಸಿನ ದಿದ್ಯೊ. ತಿನಾಹುತಿ ಹಮ್ನಾ, ಕ್ಹುದಾ ಯೆಸುನಾ ಕ್ಹಾತೆ ಅಪೊನೆ ಕ್ಹಾರುಜ಼ ಕ್ಹರಿಬಿ ದಿದ್ಯಾವಾಚಿ ರ‍್ಹವಸ ಸು? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />ಕ್ಹುದಾ ಇನಿಲಿದಲ ಮನಕ್ಹೊನಾ ಉಪ್ಪರ ಕುನ್ನಜ಼ ದೊಷ ನೈ ಘಾಲಸಕ್ತಾ? ತ್ಯುನೊನೆ ದೊಷಿ ನ್ಹವೈ ಕೈನ ಕ್ಹುದಾಜ಼ ಫೈಸಲೊ ಕರ‍್ಯೊಸ. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />ಕ್ಹುದಾನಾ ಮನಕ್ಹೊ ದೊಷಿ ವ್ಹೈ ಕೈನ ಕವಾಲಾ ಕುನ್ನ ವ್ಹೈ? ಕ್ರಿಸ್ತ ಯೆಸು ಅಪ್ನಾಹುತಿ ಜ಼ಲಮ ದಿದ್ಯೊ. ತೆಕ್ಲುಜ಼ ನ್ಹವ್ಹೈ, ತೆ ಮರಲವಾಲಾವೊಮಾತೊ ಜಿವ್ತೊ ಥೈನ ಉಟಿನ ಆಯೊ. ಹಮ್ನಾ ತೆ ಕ್ಹುದಾನಾ ಸಿದಾ ಬಗಲ ಶೆ ವರಿ ಅಪ್ನಾಹುತಿ ಕ್ಹುದಾಕನ ಮಾಂಗಿಲಿವಾಡೊಸ. <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />ತಿಮ್ಮ ರ‍್ಹಯಮ ಕ್ರಿಸ್ತನಿ ಮಯಾಕ್ಹು ಅಪೊನೆ ಜು಼ದಾ ಕರಾಲಾ ಕುನ್ ವ್ಹೈ? ತ್ರಾಸೊ ತೆನೈಸೊ ಕಷ್ಟ ತೆನೈಸೊ ಕಿರಿಕಿರಿ ತೆನೈಸೊ ಭುಕ್ಕಕು ರ‍್ಹವಾನು ತೆನೈಸೊ ಗರಿಬಿ ತೆನೈಸೊ ಮುಸಿಬತ ತೆನೈಸೊ ಮೌತನು ತ್ರಾಸ ಛೆಸು? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />ಕ್ಹುದಾ,</para>
  <para style="q1" vid="ROM 8:36">ತಾರಾಹುತಿ ಹಮೆ ದಿನ್ನಾ ಮೌತನೆ ಗುರಿ ಥಯಾಸ;</para>
  <para style="q2" vid="ROM 8:36">ಮನಕ್ಹೊ ಹಮೊನೆ ಕಾಟಾನಾ ಬಕ್ರಿಯೊ ನಿಂಗತ ಅಪ್ನಾ ಕ್ಹಾತೆ ಥಾವಾಡುಸ. <char style="rq"><ref loc="PSA 44:22">ಕಿರ್ತನೆ 44:22</ref></char><verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />ತೆನೈಸೊ ಅಪೊನೆ ಮಯಾ ಕರಲವಾಲಾಕ್ಹುಜ಼ ಎ ಕ್ಹಾರಿ ವಿಷಯಮಾ ಜಯಾ ಛೆ. <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />ಕಯುಜ಼ ತಿನಿ ಮಯಾಕ್ಹು ಅಪೊನೆ ಜು಼ದು ಕರಾನೆ ಸಾಧ್ಯ ನತ್ತಿ ಕೈನ ಮಿ ತುಮೊನೆ ಕ್ಹರಿಜ಼ ಕೌಸ; ಮೌತ ನೈತೊ ಜ಼ಲಮ ನೈತೊ, ದೆವದುತೊ ನೈತೊ ಬಿಜಾ಼ ಸ್ವರ್ಗನಾ ಅದಿಕಾರಿಯೊ ನೈತೊ ಕ್ಹಾರಾ ಅದಿಕಾರಿಯೊ ನೈತೊ ಹಮ್ನಾ ನೈತೊ ಭವಿಷ್ಯ, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />ಮಹತ್ವನಿ ಸಂಗತಿಯೊ ರ‍್ಹೈನೆಕಾ, ಉಪ್ಪರ‍ಲ್ಯು ಲೊಕ ರ‍್ಹೈನೆಕಾ ಲೊಕ ರ‍್ಹೈನೆಕಾ ಬಿಜು಼ ಕಯುಬಿ ಸೃಷ್ಟಿ ರ‍್ಹೈನೆಕಾ ಅಪೊನೆ ಅಪ್ನೊ ಕರ್ತ ಥಯಲ ಕ್ರಿಸ್ತ ಯೆಸುಮಾ ದಿಕ್ಹಿನ ಆಯಲ ಕ್ಹುದಾನಿ ಮಯಾಕ್ಹು ದುರ ಕರಾನೆ ಥಾತುಜ಼಼ ನೈ ಕೈನ ಕ್ಹರಿಮಾಜ಼ ಮನೆ ಗ್ವತ ಛೆ.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">ಕ್ಹುದಾ ವರಿ ತಿನಾ ಮನಕ್ಹೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />ಮಿ ಕ್ರಿಸ್ತಮಾ ಛೆ ವರಿ ತುಮೊನೆ ಕ್ಹರಿಜ಼ ಕವಾಡೊಸ. ಮಿ ಸುಳ್ಳ ನೈ ಬೊಲ್ತೊ. ಮಾರಿಯೊ ವಿಚಾರೊ ಪವಿತ್ರ ಆತ್ಮಾನಿ ಅದಿಕಾರಮಾ ಛೆ. ಎಜ಼ ಅನೆ ಸಾಕ್ಷಿ ವ್ಹೈ. <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />ಮನೆ ಘನ್ನು ದುಖ ಛೆ; ಹಮೆಶಾಬಿ ಮನಸಮಾ ಕಷ್ಟ ಛೆ. <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />ಮಾರಾ ಮನಕ್ಹೊನೆ, ಮಾರು ಮಾಕ್ಹ ವರಿ ರಗತ! ತ್ಯುನಾಕ್ಹು ಮಿ ಕ್ಹುದಾನಾ ಶ್ರಾಪನೆ ಮ್ಹೈ ಥಯೊಸ ವರಿ ಕ್ರಿಸ್ತಕ್ಹು ಜು಼ದೊ ಥಯೊ ಕೈನ ಮಿ ಆಸ ಕರುಸ. ತ್ಯುನೆ ಮಾರಾ ಭಾಯೊ ಭೆನೊ ಥಯಾಸ; ಇಹಲೊಕನಾ ಕುಟುಂಬ ಥಯಾಸ. ತ್ಯುನೊನೆ ಮದತ ಕರಾನೆ ಕ್ರಿಸ್ತನೆ ಛೊಡಿನ ಶ್ರಾಪ ಲಿವಾನೆ ತಯ್ಯಾರ ಛೆ. <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />ತ್ಯುನೆ ಇಸ್ರೆಲನಾ ಮನಕ್ಹೊ ವ್ಹೈ. ತ್ಯುನೆ ಕ್ಹುದಾ ಇನಿಲಿದಲ ಬಚ್ಚಾ಼ ವ್ಹೈ. ತ್ಯುನೆ ಕ್ಹುದಾನಿ ಮಹಿಮಾ ವರಿ ಕ್ಹುದಾ ತ್ಯುನಾ ಕ್ಹಾತೆ ಕರಲ ವಡಂಬಡಿಕೆ ಹೊಂದಿಲಿವಸ. ಕ್ಹುದಾ ತ್ಯುನೊನೆ ಮೊಶೆನಾ ಧರಮಶಾಸ್ತ್ರನಿ ಚೊ಼ಕಿ ಆರಾಧನೆ ತಿನಿ ವಾಗ್ದಾನ ದಿದ್ಯೊ. <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />ತ್ಯುನೆ ಅಪ್ನಾ ಪಿತೃವೊನಾ ಸಂತಾನೊನೆ ಮಳಲವಾಲಾ ಥಯಾಸ; ಕ್ರಿಸ್ತ ಮನಕ್ಹನು ಅಂಗ ಲಿನ ಇವ್ನಾ ಖಾಂದಾನಮಾ ಹುಟ್ಯೊ. ಕ್ರಿಸ್ತ ಕ್ಹಾರಾನೆಬಿ ಮಾಲಕ ಥಯೊಸ. ಕ್ಹಾರಾವೊಪರ ಅದಿಕಾರ ಕರಾಲಾ ಕ್ಹುದಾನೆ ಹಮೆಶಾಬಿ ಸ್ತೊತ್ರಾ ಥಾವಾದೆ! ಆಮೆನ್.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />ಹೊ, ಮಿ ಯೆಹುದಿಯೊನಾ ವಿಷಯಮಾ ದುಖಿ ಥೌಸ. ಕ್ಹುದಾ ತಿನಿ ವಾಗ್ದಾನ ಪುರಾ ಕರಾನೆ ಥಯು ನತ್ತಿ ಕೈನ ಮಿ ಕವಾಡೊ ನತ್ತಿ. ಕಾಕದ್ಯಾಮ ಇಸ್ರಾಯೆಲ ಖಾಂದಾನಮಾ ಹುಟ್ಟಲವಾಲಾ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊ ನ್ಹವೈ. <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />ತೆನೈಸೊ ಅಬ್ರಹಾಮನಾ ಮನಕ್ಹೊ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊ ನ್ಹವೈ ಕ್ಹುದಾ ಅಬ್ರಹಾಮನೆ ಅಮ್ಮ ಕದ್ಯೊ ಮಿ ವಾಗ್ದಾನ ಕರಲ "ಇಸಾಕಕ್ಹು ಆವಾಲಾ ಬಚ್ಚಾ಼ ತ್ಯುನೆ ಯಕ್ಕಜ಼ ತಾರಾ ಮನಕ್ಹೊ ವ್ಹೈ. <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />ಇನು ಮತ್ಲಬ ಸುವ್ಹೈ ಕದ್ಯಾಮ, ಅಂಗಕ್ಹು ಹುಟ್ಟಲವಾಲಾ ಮನಕ್ಹೊ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ ನ್ಹವೈ. ವಾಗ್ದಾನನಾ ಪ್ರಕಾರ ಹುಟ್ಟಲವಾಲಾಜ಼ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ (ಕ್ಹರಿನಾ ಬಚ್ಚಾ಼) ಥಯಾಸ. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />ಕ್ಹುದಾ ತಿನೆ, ಕರೆಟ್ಟ ಟೈಮಮಾ ಮಿ ವರಿ ಔಸ" ತೆಳಾಮಾ ಸಾರಳನೆ ಯಕ್ಕ ದಿಕ್ರೊ ರ‍್ಹವಸ ಕವಾನಿ ವಾಗ್ದಾನ ಕರ‍್ಯೊತೊ.<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />ತೆಕ್ಲುಜ಼ ನೈಸೊ, ರೆಬೆಕ್ಕಳನೆಬಿ ಬೆ ಪಟ್ಟಾ ವ್ಹತ್ತಾ. ತ್ಯುನೊನೆ ಭಂಬಿ ಜ಼ನಾವೊನೆಬಿ ಯಕ್ಕಲೊಜ಼ ಬಾ ವ್ಹೈ. ತೆಜ಼ ಅಪ್ನೊ ಪಿತೃ ಥಯಲ ಇಸಾಕ ವ್ಹೈ. <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />ತೆನೈಸೊ ತೆ ಭಂಬಿ ಪಟ್ಟಾ ಹುಟ್ಟಾತಿ ಪೈಲಾಜ಼, ಕ್ಹುದಾ ರೆಬೆಕ್ಕಳನೆ "ಮ್ಹೊಟೊ ರ‍್ಹಯಲವಾಲೊ ನ್ಹಾನಾ ರ‍್ಹಯಲವಾನೆ ಸೆವೆ ಕರಸ" ಕದ್ಯೊ. ತೆ ಪಟ್ಟಾ ಕಯುಜ಼ ಕೆಟ್ಟ ರ‍್ಹವಾದೆ ಚೊ಼ಕು ರ‍್ಹವಾದೆ ಕರಾತಿ ಪೈಲಾಜ಼ ಎ ಕ್ಹಾರು ಥಯು. ಕ್ಹುದಾ ತೆ ಪಟ್ಟಾನೆ ತಿನಾ ಸ್ವಂತ ವಿಚಾರಕ್ಹು ಇನಿಲಿದಲಹುತಿ ತೆ ಪಟ್ಟಾ ಹುಟ್ಟಾತಿ ಪೈಲಾಜ಼ ಇಮ್ಮ ಕದ್ಯೊ. <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />ಕ್ಹುದಾ ತಿನೆ ಇನಿಲಿದಲಹುತಿ ತಿನೆಜ಼ ಬಲೌ ಕೈನ ವ್ಹತ್ತೊ. ತೆನೈಸೊ ತೆ ಪಟ್ಟಾವೊನಾ ಕಯಾಜ಼ ಕಾಮೊಪರ ಆಧಾರ‍ ನ್ಹೊತು. <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />ತಿನಾಹುತಿಜ಼ "ಮಿ ಯಾಕೊಬನೆ ಮಯಾ ಕರ‍್ಯೊ. ತೆನೈಸೊ ಎಸಾವನೆ ದ್ವೆಶ ಕರ‍್ಯೊ" ಕೈನ ಪವಿತ್ರ ಗ್ರಂಥ ಕವಸ.<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />ಇಮ್ಮ ರ‍್ಹಯುಮ, ಅಪೆ ಕ್ಹುದಾನೆ ಅನ್ಯಾಯ ಕರಾಲೊ ವ್ಹೈ ಕೈನ ಕೆ ಸಕೆಸ ಸು? ಕೆಳಾಮಾಬಿ, ನ್ಹವೈ. <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />ಕ್ಹುದಾ ಮೊಶೆನೆ "ಮಿ ಕಿನೆ ಕರುಣಾ ದೆಕಾಡು ಕೌಸ ತಿನೆ ಕರುಣಾ ದೆಕಾಡುಸ. ಮಿ ಕಿನೆ ಮರಗಾ ದೆಕಾಡು ಕೌಸ ತ್ಯುನೊನೆ ಮರಗಾ ದೆಕಾಡುಸ" ಕೈನ ಕದ್ಯೊಸ. <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />ತಿನಾಹುತಿ ಕ್ಹಾರು ಮನಕ್ಹ ಥಯಲ ಅಪೆ ಸು ಕರೆಸ ನೈತೊ ಅಪೊನೆ ಸು ಚಾ಼ಯೆ ಕವಾನಾ ಉಪ್ಪರ ನತ್ತಿ. ತೆನೈಸೊ ಕ್ಹಾಲಿ ಕ್ಹುದಾ ಮರ್ಗಾಕ್ಹು ಛೆ. ತಿನೆ ಇನಿಲಿವಾನಾ ಮನಕ್ಹೊ ಸು ಕರು ಕವಸ ತೆನೈಸೊ ಸು ಕರಾನೆ ಕೊಶಿಶ ಕರಸ ಕವಾನಾ ಉಪ್ಪರ ಆದಾರ ನತ್ತಿ ಥಯು. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಕ್ಹುದಾ ಇಜಿಪ್ತನಾ ರಾಜಾ಼ನೆ "ಮಿ ತುಮೊನೆ ಮಾರಿ ತಾಕತ ದೆಕಾಡು ಕೈನ ಜಗತಮಾ ಕ್ಹಾರಿ ಜ಼ಗಾ ಮಾರು ನಾಮ ಲೌ ಕೈನ ಮಿ ತುನೆ ರಾಜೊ಼ ಥೈನ ಕರ‍್ಯೊ" ಕೈನ ಕದ್ಯೊಸ. <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ತೆ ಕಿನೆ ಕರುಣಾ ದೆಕಾಡು ಕವಸ ತ್ಯುನೊನೆ ಕರುಣಾ ದೆಕಾಡಸ. ಕ್ಹುದಾ ಕಿನೆ ಮಂಡ ಕರು ಕೈನ ಕವಸ ತ್ಯುನೊನೆ ಮಂಡ ಕರಸ.<verse eid="ROM 9:18" /></para>
  <para style="s">ಕ್ಹುದಾನಿ ಶಿಟ್ಟ ವರಿ ಮರಗಾ</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />ಅಪೊಮಾ ಯಕ್ಲೊ ಕುನ್ನತಬಿ ಮನೆ "ಇಮ್ಮ ರ‍್ಹಯಮ, ಕುನ್ನಬಿ ತಪ್ಪಮಾ ಛೆ ಕೈನ ಕ್ಹುದಾ ಹುಡಕಾನು ಕಿಮ್ಮ ವ್ಹೈ? ಕ್ಹುದಾನಿ ಚಿತ್ತನೆ ಅಡ್ಡ ಕರಾಲಾ ಕುನ್ ವ್ಹೈ? <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />ತೆನೈಸೊ ಎ ಮನಕ್ಹ ಕ್ಹುದಾನೆ ಇಮ್ಮ ಪುಚ್ಚಾ಼ಲೊ ತು ಕುನ್ನ ವ್ಹೈ. ಗಾಡಗಿ ತಿನೆ ತಯ್ಯಾರ ಕರಲವಾಲಾನೆ "ತು ಮನೆ ಇಮ್ಮ ತಯ್ಯಾರ ಕಾ ಕರ‍್ಯೊ" ಕೈನ ಪುಚ಼್ಚಲ ಛೆಸು? <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />ಕ್ಹಾರು ಥಯಲ್ಪರ, ಗಾಡಗಿಯೊ ತಯ್ಯಾರ ಕರಾಲೊ ಮನಕ್ಹ ತೆ ಮಾತಿನೆ ಉಪಯೊಗ ಕರಾನು ಹಕ್ಕ ವ್ಹಂದಿಲಿದಲ ರ‍್ಹವಸ, ವರಿ ಯಕ್ಕಜ಼ ಮಾತಿಕ್ಹು ಬೆ ಗಾಡಗಿ ತಯ್ಯಾರ ಕರಾನೆ, ಖಾಸ ಮೌಕಾಮಾ ಯಕ್ಕ ವರಿ ದಿನ್ನೆ ಉಪಯೊಗ ಕರಾನೆ ವರಿಯಕ್ಕ ತಯ್ಯಾರ ಕರಸ.<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />ಕ್ಹುದಾ ಕರಲಬಿ ಅಮ್ಮಜ಼ ವ್ಹೈ. ತೆ ತಿನಿ ಶಿಟ್ಟ ದೆಕಾಡಿನ, ತಿನಿ ತಾಕತ ಮನಕ್ಹೊನೆ ದೆಕ್ಲಾಡಿನ ದ್ಯು ಕೈನ ವ್ಹತ್ತೊ. ವರಿಬಿ ತೆ ತಿನಿ ಶಿಟ್ಟನೆ ಗುರಿ ಥೈನ ಹಾಳ ಥಾವಾನಾ ಮನಕ್ಹೊನೆ ಘನ್ನಿ ಸಮಾದಾನಕ್ಹು ತಡ್ದಿಲಿದ್ಯೊ. <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />ಕ್ಹುದಾ ತಿನಿ ಮ್ಹೊಟಿ ಮಹಿಮಾ ದೆಕಾಡು ಕೈನ ಸಮಾದಾನಕ್ಹು ಕೈದಾಡೊತೊ. ತಿನಿ ಕರುಣಾ ಹೊಂದಿಲಿವಾನಾ ಮನಕ್ಹೊನೆ ಕ್ಹುದಾ ತೆ ಮಹಿಮಾ ದ್ಯು ಕೈನ ವ್ಹತ್ತೊ. ತಿನಿ ಮಹಿಮಾ ಹೊಂದಿಲ್ಯು ಕೈನ ಕ್ಹುದಾ ತೆ ಮನಕ್ಹೊನೆ ತಯ್ಯಾರ ಕರ‍್ಯೊ. <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />ಅಪೆಜ಼ ತೆ ಮನಕ್ಹೊ ವ್ಹೈ. ಕ್ಹುದಾ ಬಲಾಯಲ ಮನಕ್ಹೊ ಅಪೆಜ಼ ವ್ಹೈ. ಕ್ಹುದಾ ಅಪೊನೆ ಯಹುದ್ಯೊವಾಲಾವೊಮಾತೊ ವರಿ ಯಹುದ್ಯೊ ನೈಸೊವಾಲಾವೊಮಾತೊ ಬಲಾಯೊ. <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />ಪವಿತ್ರ ಗ್ರಂಥನಾ ಹೊಶೆಯನನಾ ಪುಸ್ತಕಮಾ ಇಮ್ಮ ಬರ್ದಲ ಛೆ;</para>
  <para style="q1" vid="ROM 9:25">"ಮಾರಾ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ</para>
  <para style="q2" vid="ROM 9:25">ಮಾರಾ ಮನಕ್ಹೊ ವ್ಹೈ ಕೈನ ಕೌಸ.</para>
  <para style="q1" vid="ROM 9:25">ಮನೆ ಮಯಾ ನೈ ರ‍್ಹಯಲವಾಲಾವೊನೆ</para>
  <para style="q2" vid="ROM 9:25">ಮನೆ ಮಯಾ ರ‍್ಹಯಲವಾಲಾ ವ್ಹೈ ಕೈನ ಕೌಸ" ಹೊಶೆಯ 2:23<verse eid="ROM 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26" />ವರಿ "ಕಯಾ ಜ಼ಗಾಪರ ತುಮೆ ಮಾರಾ ಮನಕ್ಹೊ ನ್ಹವೈ ಕೈನ ಕದ್ಯೊತೊತೊ ತೆಜ಼ ಜ಼ಗಾಪರ</para>
  <para style="q2" vid="ROM 9:26">ತ್ಯುನೊನೆ ಜಿವ್ತೊ ರ‍್ಹಯಲ ಕ್ಹುದಾನಾ ಬಚ಼್ಚಾ ವ್ಹೈ ಕೈನ ಬಲಾವಸ" ಹೊಶೆಯ 1:10<verse eid="ROM 9:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27" />ಎನೈಸೊ ಯೆಶಾಯ ಇಸ್ರೆಲನಾಹುತಿ ಅಡ್ಡಿನ ಕದ್ಯೊಸ; "ಸಮುಂದರನಿ ದಂಡಿನಾ ಉಸುಕ ನಿಂಗತ ಇಸ್ರೆಲವಾಲಾ ಮೊಜಾ಼ನೆ ನೈ ಆಯೆ ನಿಂಗತ ಥಾವಸ. ತೆನೈಸೊ ತೆ ಮನಕ್ಹೊಮಾ ಖಾಲಿ ದಕ್ಹಾ ಜ಼಼ನಾ ರಕ್ಷಣೆ ಹೊಂದಿಲಿದವಾಲಾ ವ್ಹೈ. <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />ಹೊ, ಪ್ರಭು ಜಿ಼ಮಿನ್ಪರ ತಿನಿ ವಾತ ಕ್ಷಣಮಾ ಪುರಾ ಕರಿಪಾಡಸ" ಯೆಶಾಯ 10:22-23 <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />ಯೆಶಾಯ ಕದಲ ಸುವೈ ಕದ್ಯಾಮ; "ಪ್ರಭು ಸರ್ವಶಕ್ತ ಥಯೊಸ. ಪ್ರಭು ತಿನಾ ಮನಕ್ಹೊಮಾ ದಕ್ಹಾ ಜ಼ನಾವೊನೆ ಅಪ್ನಾಹುತಿ ವಚಾ಼ಡ್ಯೊಸ. ತೆ ಇಮ್ಮ ನೈ ಕರತೊ, ಹಮ್ನಾ ಅಪೆ ಸೊದೊಮ ನಿಂಗತ ಗೊಮುರ ನಿಂಗತ ರ‍್ಹತಾತಾ" ಯೆಶಾಯ 1:9.<verse eid="ROM 9:29" /></para>
  <para style="s">ಇಸ್ರಾಯಲ ವರಿ ಸುವಾರ್ತೆ</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />ಇನು ಮತ್ಲಬ ಸುವೈ ಕದ್ಯಾಮ, ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲವಾಲಾ ನಿತಿವಂತವಾಲಾ ಥಾವಾನೆ ಕೊಶಿಶ ಕರತಾ ನ್ಹೊತಾ. ತೆನೈಸೊ ತ್ಯುನೊನೆ ನಿತಿವಂತವಾಲಾ ಥೈನ ಕರ‍್ಯೊ. ತ್ಯುನೆ ಬರೊಕ್ಹಾಕ್ಹು ನಿತಿವಂತವಾಲಾ ಥಯಾ. <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ, ಧರ್ಮ ಶಾಸ್ತ್ರನಾನಿಂಗತ ಚಾ಼ಲಿಲಿನ ಜಾ಼ವಾನಾನಿಂಗತ ನಿತಿವಂತವಾಲಾ ಥಾವಾನೆ ಕೊಶಿಶ ಕರ‍್ಯಾತುಬಿ ತ್ಯುನೆ ಥಯಾ ನೈ. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />ಕಾಕದ್ಯಾಮ ಕಾಮೊಕ್ಹು ನಿತಿವಂತವಾಲಾ ಥಾವಾನೆ ತ್ಯುನೆ ಕೊಶಿಶ ಕರ‍್ಯಾ ತೆನೈಸೊ ಬರೊಕ್ಹಾನೆ ಆದಾರ ಕರಿಲಿದ್ಯಾ ನೈ. ಮನಕ್ಹೊನೆ ಪಾಡಾನೆ ದೆಕಾನಾ ದಗ್ಡಾಪರ ತ್ಯುನೆ ಟೆಕ್ಹ ಲಾಗಿನ ಪಡ್ಯಾ. <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />ಪವಿತ್ರ ಗ್ರಂಥ ತೆ ದಗ್ಡಾನಾಹುತಿ ಇಮ್ಮ ಕದ್ಯುಸ;</para>
  <para style="q1" vid="ROM 9:33">"ಅದೆಕ, ಮಿ ಶಿಯೊನಮಾ ಪಾಡಾನೆ ಯಕ್ಕ ದಗ್ಡೊ ಮ್ಹೆಲುಸ.</para>
  <para style="q2" vid="ROM 9:33">ಎ ದಗ್ಡಾಕ್ಹು ಮನಕ್ಹೊ ಪಡಸ.</para>
  <para style="q2" vid="ROM 9:33">ತೆನೈಸೊ ತೆ ದಗ್ಡಾಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಾಲೊ</para>
  <para style="q1" vid="ROM 9:33">ಕೆಳಾಮಾಬಿ ತಿನಿ ಆಸ ಭಂಗ ನೈ ಥಾತಿ" ಯೆಶಾಯ 8:14; 28:16<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />ಭಾಯೊ ಭೆನೊ, ಮಾರಾ ಸ್ವಂತ ಮನಕ್ಹೊ ರಕ್ಷಣೆ ಹೊಂದಿಲ್ಯು ಕೈನ ಮಾರಿ ಘನ್ನಿ ಮ್ಹೊಟಿ ಆಸ ಛೆ. ಮಿ ಕ್ಹುದಾಕನ ತಿನಾಹುತಿ ಪ್ರಾಥನಾ ಕರಾಡೊಸ. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />ತ್ಯುನೊನೆ ಘನ್ನಿ ಕ್ಹುದಾಪರ ಭಕ್ತಿ ಛೆ ಮಿ ತಿನಾಹುತಿ ಸಾಕ್ಷಿ ದ್ಯುಸ. ಕ್ಹರಿಜ಼ ಕೌಸ ತಿನಾಹುತಿ ತ್ಯುನೆ ಭಕ್ತಿ ಕ್ಹರಿನಿ ಗ್ಯಾನಪರ ಆದಾರ ಥಯಾ ನತ್ತಿ. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />ನಿತಿವಂತ ಕರಾನು ಕ್ಹುದಾನಿ ವಾಟ ತ್ಯುನೆ ನೈ ತಿಳದಿಲಿದಲಹುತಿ ತ್ಯುನಿ ಸ್ವಂತ ವಾಟನಾ ಮುಲಕ ತ್ಯುನೊನೆಜ಼ ನಿತಿವಂತೊ ಥೈನ ಕರಲಿವಾನೆ ಕೊಶಿಶ ಕರ‍್ಯಾ. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />ತಿನಾಮಾ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಾಲೊ ಹರಯಕ್ಲೊ ನಿತಿನೊ ಫೈಸಲೊ ಹೊಂದಿಲಿವಸ ಕೈನ ಕ್ರಿಸ್ತ ಧರಮಶಾಸ್ತ್ರ ಪುರಾ ಕರ‍್ಯೊ.<verse eid="ROM 10:4" /></para>
  <para style="s">ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ರಕ್ಷಣೆ</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />ಧರಮಶಾಸ್ತ್ರಕ್ಹು ಥಾವಾನಾ ನಿತಿನಾಹುತಿ "ಧರಮಶಾಸ್ತ್ರನೆ ಚಾ಼ಲಿಲಿನ ಜಾ಼ವಾನಾ ಮುಲಕ ಜ಼ಲಮ ಪಡ್ದಿಲ್ಯು ಕೈನ ಕವಾಲೊ, ಧರಮಶಾಸ್ತ್ರ ಕವಾನಾ ಕಾಮೊ ಕರುಜ಼" ಎ ಮೊಶೆ ಕದ್ಯೊಸ. <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />ತೆನೈಸೊ ಬರೊಕ್ಹಾನಾ ಮುಲಕ ನಿತಿನಾ ಫೈಸಲಾನೆ ಹೊಂದಿಲಿವಾನಾಹುತಿ (ಕ್ರಿಸ್ತನೆ ಹೆಟಾ ಬಲೈಲಿನ ಆತಾಮಾ) ಕುನ್ನ ಪರಲೊಕನೆ ನೈ ಜಾ಼ತೊ? ಕೈನ ರ‍್ಹವಾದೆ (ಕ್ರಿಸ್ತನೆ ಮರಲವಾಲಾವೊಮಾತೊ ಉಟಾಡಿನ ಲಾವಾಕ್ಹು) <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />"ಕುನ ಪಾತಾಳನೆ ನೈ ಜಾ಼ತು ಕೈನ ರ‍್ಹವಾದೆ ಕವೊ ನಕೊ" ಕೈನ ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಕವಸ. <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />ಕ್ಹುದಾನಿ ವಾಕ್ಯಾ ತುಮಾರಿ ಕ್ಹಾಮಿಜ಼ ಛೆ; ತೆ ತಾರಾ ಮ್ಹೊಡಾಮಾ ತಾರಾ ಮನಸಮಾಬಿ ಛೆ ಕವಸ. ತೆ ವಾಕ್ಯಾ ಅಪೆ ಕವಾನು ಬರೊಕ್ಹಾನಿ ವಿಷಯಮಾನಿ ವಾಕ್ಯಾ ವ್ಹೈ. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />ತೆ ಸುವೈ ಕದ್ಯಾಮ ತು ಯೆಸುನೆಜ಼ ಕರ್ತ ವ್ಹೈ ಕೈನ ಮ್ಹೊಡಾಕ್ಹು ಕೈನ ಕ್ಹುದಾ ತಿನೆ ಮರಲವಾಲಾವೊಮಾತೊ ಉಟಾಡ್ಯೊಸ ಕೈನ ಮನಸಕ್ಹು ಬರೊಕ್ಹೊ ಮುಕ್ಯಾಮ ತುನೆ ರಕ್ಷಣೆ ಥಾವಸ ಕೈನ ವ್ಹೈ. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />ಮನಸಕ್ಹು ಬರೊಕ್ಹೊ ಕರ‍್ಯಾಮ ನಿತಿ ಮಳಸ. ಮ್ಹೊಡಾಕ್ಹು ಕದ್ಯಾಮ ರಕ್ಷಣೆ ಥಾವಸ. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />ತಿನಾ ಉಪ್ಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಲವಾಲೊ ಕಯೊಬಿ ನಿರಾಶ ಥಾತೊ ನೈ ಕೈನ ಶಾಸ್ತ್ರ ಕವಸ್ತೊ. <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />ಆಂ ವಿಷಯಮಾ ಯೆಹುದಿವಾಲಾನೆಬಿ ವರಿ ಗ್ರಿಕವಾಲಾನೆಬಿ ಜಾಸ್ತ ಕಮ್ಮ ಸು ನತ್ತಿ. ಕ್ಹಾರಾವೊನೆಬಿ ಯಕ್ಲೊಜ಼ ಪ್ರಭು ವ್ಹೈ; ತೆ ತಿನು ನಾಮ ಕವಾಲಾವೊನೆ ಘನ್ನೊ ಆಶಿರ್ವಾದ ದಿವಸ. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />ಅಮ್ಮ ಪವಿತ್ರ ಗ್ರಂಥ ಕದಲ ತಿಮ್ಮ ಕರ್ತನು ನಾಮ ಕವಾಲಾವೊನೆ ರಕ್ಷಣೆ ಮಳಸ ಕೈನ ಬರ್ದಲ ಛೆ.<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />ತೆನೈಸೊ ತುಮೆ ಕಿಪರ ಬರೊಕ್ಹೊ ನತ್ತಿ ಕರ‍್ಯಾ ತಿನು ನಾಮ ಕವಾನೆ ಕಿಮ್ಮ ಥಾವಸ? ತಿನಿ ವಾಕ್ಯಾ ನೈ ಐಕ್ಯಾಮ ತಿಪರ ಬರೊಕ್ಹೊ ಮುಕ್ಕಾನು ಕಿಮ್ಮ? ಕವಾಲೊ ನೈ ರ‍್ಹಯಾರೆ ಐಕಾನು ಕಿಮ್ಮ? ಕವಾಲಾನೆ ಕವಾನೆ ಮೊಕಲ್ಯಾ ಬಗರ ತೆ ಕವಸ ಕಿಮ್ಮ? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />ಚೊ಼ಕಿ ಸುವಾರ್ತೆ ಕವಾಲಾವೊನಾ ಪಗೊ ಕೆಕ್ಲಾಕಿ ಚೊ಼ಕಾ ಶೆ ಕೈನ ಬರ್ದಲ ಛೆ. ತಿಮ್ಮ ರ‍್ಹಯುತಬಿ ಚೊ಼ಕಿಯೊ ವಾತೊ ಕ್ಹಾರಾ ಜ಼ನಾ ಐಕ್ತಾ ನೈ. <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" />ಆಂ ವಿಷಯಮಾ ಯೆಶಾಯ- <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />ತಿಮ್ಮ ರ‍್ಹತಾಮಾ ಚೊ಼ಕಿ ಸುವಾರ್ತೆ ಐಕಾಕ್ಹು ಬರೊಕ್ಹೊ ಆವಸ. ವರಿ ವಾಕ್ಯಾ ಯೆಸುನಾಹುತಿ ತೆ ಸುವಾರ್ತೆ ಐಕಾಕ್ಹು ವರಿ ಕ್ರಿಸ್ತನಿ ವಾಕ್ಯಾ ಐಕಾಕ್ಹು ಸಂದೆಶ ಆವಸ.<verse eid="ROM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18" />ತಿಮ್ಮ ರ‍್ಹಯುತಬಿ ತ್ಯುನೊನೆ ಐಕು ಐಯು ನೈ ಕೈನ ಪುಚ್ಯೊ. ಐಕು ಆಯಲ ಕ್ಹರಿಜ಼ ವ್ಹೈ.</para>
  <para style="q1" vid="ROM 10:18">ಕವಾಲಾವೊನಿ ಆವಾಜ಼ ಜಿಮಿನ ಪುರಾ ಐಕೈಸ,</para>
  <para style="q2" vid="ROM 10:18">ತಿವ್ನಾ ವಾತೊ ಜಗತ್ನಾ ಲಾಸ್ಟಲಕಾಬಿ ಫೈಲ್ಯಾಸ.<verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />ತೆನೈಸೊ ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊ ತೆ ಸುವಾರ್ತೆ ತಿಳದಿಲಿದ್ಯಾ ನೈಸು ಕೈನ ವರಿ ಮಿ ಪುಚ್ಚು಼ಸ.</para>
  <para style="q1" vid="ROM 10:19">ಹೊ, ಆಂ ವಿಷಯಮಾ- ಮಾರಿ ಜನಾಂಗ ನೈ ರ‍್ಹಯಲವಾಲಾವೊಕ್ಹು</para>
  <para style="q2" vid="ROM 10:19">ತುಮೊಮಾ ಹೊಚ್ಚಿಗಿಟ್ಟಿ ಹುಟಸೌಸ;</para>
  <para style="q1" vid="ROM 10:19">ಗ್ಯಾನ ನೈಸೊವಾಲಾವೊಕ್ಹು</para>
  <para style="q2" vid="ROM 10:19">ತುಮೊನೆ ಶಿಟ್ಟ ಹುಟಸೌಸ ಕೈನ ಪೈಲಾಜ಼ ಮೊಶೆ ಕವಸ.<verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />ತೆನೈಸೊ ಯೆಶಾಯ ಧೈರ್ಯಕ್ಹು ಬೊಲ್ಯೊ-</para>
  <para style="q1" vid="ROM 10:20">ಮನೆ ನೈ ಹುಡ್ಕಲವಾಲಾವೊನೆ ಮಳ್ಯೊ,</para>
  <para style="q2" vid="ROM 10:20">ಮಾರಿ ವಿಷಯಮಾ ವಿಚಾರ ಕರಲವಾಲಾವೊನಾ ಕ್ಹಾಮೊ ಆಯೊ ಕೈನ ಕದ್ಯೊ.<verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />ತೆನೈಸೊ ಕ್ಹುದಾ ಅಮ್ಮ ಕವಸ ತೆ ಇಸ್ರಾಯೆಲವಾಲಾವೊನಾ ವಿಷಯಮಾ- ಮಾರಿ ವಾತನೆ ಅವಿಧೆಯ ಥೈನ ಫರಿನ ಬೊಲಲ ಮನಕ್ಹೊನೆ ಮಿ ದಿನ್ನ ಕ್ಹಾರಿ ಹತ್ತ ಕರಿನ ಬಲಾಯೊ ಕೈನ ಕವಸ.<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">ಕ್ಹುದಾ ಇಸ್ರಾಯಲನಾ ಮನಕ್ಹೊಪರ ಮರ್ಗಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />ತಿಮ್ಮ ರ‍್ಹಯುಮ ಕ್ಹುದಾ ತಿನಾ ಮನಕ್ಹೊನೆ ನಕೊ ಕೈನ ಢಕ್ಲಿ ಪಾಡಸ ಸು ಕೈನ ಪುಚ್ಚು಼ಸ. ಕೆಳಾಮಾಬಿ ನೈ. ಮಿಬಿ ಇಸ್ರೆಲೊನೆ, ಅಬ್ರಹಾಮನಾ ಸಂತತಿನೆ, ಬೆನ್ಯಾಮಿಯ ಖಾಂದಾನವಾಲೊ ಥಯೊಸ್ತೊ. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />ಕ್ಹುದಾ ತೆ ಅಗೊ ಥೈನ ತಿನಾ ಮನಕ್ಹೊ ಥಾವಾನೆ ಗ್ವತ್ತ ಕರಿಲಿದಲ ಮನಕ್ಹೊನೆ ಢಕ್ಲಿ ಪಾಡ್ಯೊ ನೈ. ಎಲೀಯಾನಿ ಜವ್ನಾನಾಹುತಿ ಪವಿತ್ರ ಗ್ರಂಥ ಕವಾನಿ ವಾತ ತುಮೊನೆ ಗ್ವತ್ತ ನೈ ಥಾತು ಸು? ತೆ ಕ್ಹುದಾನಾ ಕ್ಹಾಮೊ- <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />ಕರ್ತ "ತ್ಯುನೆ ತಾರಾ ಪ್ರವಾದಿಯೊನೆ ಖಲಾಸ ಕರ‍್ಯಾಸ, ತಾರಾ ಬಲಿ ದಿವಾನಿ ಜ಼ಗಾ ಪ್ಹೊಡಿ ಪಾಡ್ಯಾಸ, ಮಿ ಯಕ್ಲೊಜ಼ ಉಗರ್ಯೊಸ, ಹಮ್ನಾ ಮನಕ್ಹೊ ಮಾರು ಜ಼ಲಮ ಕಾಡು ಕೈನ ಕರ‍್ಯಾಸ" <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />ಕೈನ ಇಸ್ರೆಲೊನಾ ಉಪ್ಪರ ತಪ್ಪ ಕದಲಕ್ಹು ಕ್ಹುದಾನು ಜವಾಬ ಸು ವ್ಹೈ ಕದ್ಯಾಮ ಬಾಳನಿ ಮುರತಿನೆ ಆರಾಧನಾ ನೈ ಕರಲ ಕ್ಹಾತ ಹಜಾ಼ರ ದಾಣ್ಗಾವೊನೆ ಮಾರಾಹುತಿ ವಚಾ಼ಡಿಲಿದ್ಯೊಸ. <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />ತಿನಾನಿಂಗತ ಹಮ್ನಾನಾ ಕಾಲಮಾಬಿ ಕ್ಹುದಾನಿ ಕೃಪಾಕ್ಹು ಇನಿಲಿದಲವಾಲಾ ದಕ್ಹಾ ಜ಼ನಾ ಛೆ. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />ಕ್ಹುದಾನಿ ಕೃಪಾಕ್ಹು ಇನಿಲಿದಲವಾಲೊ ಕದಲ್ಪರ ಪುಣ್ಯನಾ ಕಾಮೊನಾಹುತಿ ಇನಿಲಿದಲ ನ್ಹವೈ ತೆಕ್ಲುಜ಼; ತಿಮ್ಮ ನೈಸೊ ಪಕ್ಷನೆ ಕೃಪಾನೆ ಹಜು಼ನಬಿ ಕೃಪಾ ನೈ ಕವಾನೆ ಥಾತು</para>
  <para style="p" vid="ROM 11:6">. <verse eid="ROM 11:6" /><verse number="7" style="v" sid="ROM 11:7" />ಇನಾಕ್ಹು ತಿಳದಿಲಿವಾನು ಸುವೈ? ಇಸ್ರೆಲೊ ಹುಡ್ಕಲ ತ್ಯುನೊನೆ ಮಳ್ಯು ನೈ, ತ್ಯುನೊಮಾ ಇನಿಲಿದಲವಾಲಾವೊನೆ ಮಳ್ಯು. ಬಿಜಾ಼-ಜ಼ನಾ ಪಿಸಾಳಾ ಥಯಾ. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />ಕ್ಹುದಾ ತ್ಯುನೊನೆ ವಜ್ಜು಼ ಕದ್ಯಾಮ ನೈ ದಿಕ್ಹಾನಾ ಡೊಳಾ ನೈ ಐಕಾನಾ ಕಾನೊ ದಿದ್ಯೊ; ಎ ವಜ್ಜು಼ ಆಜ಼ ಲಕ್ಕಾಬಿ ತಿಮ್ಮಜ಼ ಛೆ ಕೈನ ಬರ್ದಲ ತಿಮ್ಮ ತ್ಯುನೊನೆ ಥಯು. <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />ಎನೈಸೊ-</para>
  <para style="q1" vid="ROM 11:9">ತ್ಯುನು ಅನ್ನಜ಼ ತ್ಯುನೊನೆ</para>
  <para style="q2" vid="ROM 11:9">ಪಾಖೊ ಸುಜ಼ ಅಡು ಆಯೆ ನೈಸೊ ಶಿಕ್ಷಾ ಥಾವಾದೆ.<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />ತ್ಯುನಾ ಡೊಳಾ ಮಬ್ಬ ಥೈನ ದಿಖ್ಯಾವಾಚಿ ಥಾವಾದೆ;</para>
  <para style="q2" vid="ROM 11:10">ತ್ಯುನಿ ಕಂಬರೊ ಕೆಳಾಮಾಬಿ ಡುಗಾ ಥಾವಾ ವರಕ್ಹು ಕರ ಕೈನ ದಾವಿದ ಕವಸ.<verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />ತಿಮ್ಮ ರ‍್ಹಯುಮ ತ್ಯುನೆ ಪಡಿನ ಜಾ಼ಯೆ ನಿಂಗತ ಪಡ್ಯಮ ಸುವೈ ಕೈನ ಪುಚ್ಚು಼ಸ. ತಿಮ್ಮ ಕೆಳಾಮಾಬಿ ಕೌ ನೈ. ತ್ಯುನೆ ಪಡಿಗಯಲಕ್ಹು ಕ್ರಿಸ್ತಕ್ಹು ಥಾವಾನಿ ರಕ್ಷಣೆ ಬಿಜಾ಼ ಮನಕ್ಹೊನೆ ಮಳಿ. ಇನಾಕ್ಹು ಕ್ಹುದಾ ತ್ಯುನಾಮಾ ಅಸೈ ಹುಟ್ಸಾವಸ. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />ಯಹುದ್ಯೊನಾ ಅಪರಾದ ಜಗತ್ನೆ ಘನ್ನಾ ಆಶಿರ್ವಾದೊ ತ್ಯುನಾ ಸೊಲನೆ ಯಹುದಿಯೊ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಘನ್ನಾ ಆಶಿರ್ವಾದೊ ಆವಾನೆ ಕಾರಣ ಥಯು. ಕ್ಹುದಾನಿ ಚಿತ್ತನಾ ನಿಂಗತ ಯೆಹುದಿಯೊ ನೈಸೊವಾಲಾವೊನೆ ಬದಲಿ ಥಾತಾಮಾ ದುನಿಯಾ ವರಿ ಜಾಸ್ತಿ ಆಶಿರ್ವಾದೊ ವ್ಹಂದಾನು ಕ್ಹರಿ ವ್ಹೈ ನೈ?<verse eid="ROM 11:12" /></para>
  <para style="s">ಬಿಜಾ಼ ಮನಕ್ಹೊನೆ ರಕ್ಷಣೆ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />ಹಮ್ನಾ ಮಿ ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಾಡೊಸ. ಮಿ ತ್ಯುನೊನೆ ಅಪೊಸ್ತಲ ಥಯೊಸ. ತಿನಾಹುತಿ ಮಿ ಆಂ ಕಾಮ ಮಾರಾ ಹತೆ ಥಯಲ ತೆಕ್ಲು ಚೊ಼ಕಿ ತರಾ ಕರುಸ. <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />ಮಿ ಮಾರಾ ಸ್ವಂತ ಮನಕ್ಹೊಮಾ ಅಸೈ ಕರಿನ ತ್ಯುನೊಮಾ ದಕ್ಹಾ ಜ಼಼ನಾತುಬಿ ರಕ್ಷಣೆ ಹೊಂದಿಲಿವಾ ವರಕ್ಹು ಕರುಸ ಕೈನ ಆಸ ಮನೆ ಛೆ. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />ಯಹುದಿ ಮನಕ್ಹೊನೆ ಇನ್ಕಾರಲಕ್ಹು ದುನಿಯಾ ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಸಂಧಾನ ಥಾವಾನೆ ಸಾದ್ಯ ಛೆ. ಕದ್ಯಾಮ ತ್ಯುನೆ ಮಳೈಲಿದಲಪರ ಹಜು಼ನ ಸು ಥಾಸ? ಮರಲವಾಲಾ ಜಿವ್ತಾ ಥೈನ ಉಟಿನ ಆಯಲ ನಿಂಗತ ಥಾವಸು ನೈ?<verse eid="ROM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16" />ರೊಕ್ಲಾನು ಪಸ್ಟಲ್ಯೊ ತುಕ್ಡೊ ಕ್ಹುದಾನೆ ಚ಼ಡಾಯಲ ಟೈಮಮಾ, ಪುರಾ ರೊಕ್ಲೊಜ಼ ಕ್ಹುದಾನೊ ಥಯೊ. ಝಾಡನಾ ಬೆರನೆಜ಼ ಕ್ಹುದಾನೆ ದಿದ್ಯಾಮ ಪುರಾ ಝಾಡಜ಼ ಕ್ಹುದಾನು ಥಯು. <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />ಎ, ಆಲಿವ ತೆಲನಾ ಝಾಡೊನಿಯೊ ಠೊಂಗಿಯೊ ತುಟಲ್ಪರ ರಾನ್ಮಾ ರ‍್ಹಯಲ ಆಲಿವ ಝಾಡನಿ ಯಕ್ಕ ಠೊಂಗಿ ಪೈಲಾ ರ‍್ಹಯಲ ಆಲಿವ ಝಾಡನೆ ಮಳಲ ನಿಂಗತ ಛೆ. ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ತುಮೆ ರಾನ್ಮಾ ರ‍್ಹಯಲ ಝಾಡನಿಯೊ ಠೊಂಗಿಯೊ ನಿಂಗತ ಛೆ. ತೆನೈಸೊ ಹಮ್ನಾ ತುಮೆ ಪೈಲಾನಾ ಝಾಡನಾ ತಾಕತನೆ ಜ಼ಲಮಮಾ ವಾಟೊ ಲಿವಾಲಾ ಥಯಾಸ. <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />ತಿನಾಹುತಿ ತುಟಿ ಗಯೆಲ ತೆ ಠೊಂಗಿಯೊನೆ ಇನ್ಕಾರೊ ನಕೊ. ತ್ಯುನೊನೆ ಇನ್ಕಾರಾನೆ ತುನೆ ಕಯುಜ಼ ಕಾರಣ ನತ್ತಿ. ಕಾಕದ್ಯಾಮ ತುಮೆ ಬೆರನೆ ಜ಼ಲಮ ದೆತಾ ನೈ. ಬೆರ ತುಮೊನೆ ಜ಼ಲಮ ದಿವಸ.<verse eid="ROM 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19" />ಅಪೆ ತೆ ಝಾಡನೆ ಠೊಂಗಿಯೊನೆ ಮಳಿ ಕೈನ ತೆ ಠೊಂಗಿಯೊ ತುಟಿಯೊ ಕೈನ ತುಮೆ ಕೆ ಸಕೊಸಿ. <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />ತೆ ಕ್ಹರಿ ವ್ಹೈ. ತೆ ಠೊಂಗಿಯೊ ತುಟಿಯೊ. ತಿನೆ ಬರೊಕ್ಹೊ ನೈ ಕರಲ ಕಾರಣ ವ್ಹೈ. ತುಮೆ ತೆ ಝಾಡನು ಯಕ್ಕ ಭಾಗ ಥಯಲ ತುಮಾರಾ ಬರೊಕ್ಹಾಕ್ಹುಜ಼ ವ್ಹೈ. ತಿನಾಹುತಿ ಸ್ವಕ್ಕ ಕರು ನಕೊ, ಭುಚಿ಼ಕಿನ ರ‍್ಹೆ. <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />ಕ್ಹುದಾ ಪೈಲಾಜ಼ ಹುಟ್ಟಲ ಠೊಂಗಿಯೊನೆ ನೈ ವಚಾ಼ಡಲ್ಪರ ತುಮೆ ಬರೊಕ್ಹೊ ನೈ ಕರ‍್ಯಾಮ ತೆ ತುನೆ ವಚ಼ಾಡಸ ಸು? <verse eid="ROM 11:21" /><verse number="22" style="v" sid="ROM 11:22" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಮರಗಾಲೊ ವ್ಹೈ ಘನ್ನೊ ಕಠೊರಬಿ ವ್ಹೈ ಕವಾನೊ ವಳಕ. ಕ್ಹುದಾ ತಿನಾ ಪಾಚಾ಼ ನೈ ಆವಾಲಾ ಮನಕ್ಹೊನೆ ಶಿಕ್ಷಾ ದಿವಸ. ತೆನೈಸೊ ತು ಕ್ಹುದಾನಿ ಮರಗಾಮಾ ರ‍್ಹಯೊಮ, ಕ್ಹುದಾ ತುನೆ ಮರಗಾಲೊ ರ‍್ಹವಸ. ನೈತೊ, ತುನೆ ಝಾಡತೊ ಕತ್ರಿನ ನಾಕಿ ಪಾಡಸ. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊ ತಿವ್ನಾ ಬರೊಕ್ಹೊ ನೈ ಛೊಡ್ಯಾಮ ಮಿ ತ್ಯುನೊನೆ ಭಾಂದುಸ, ಕ್ಹುದಾ ತ್ಯುನೊನೆ ವರಿ ತೆ ಝಾಡನೆ ಜೊಡ್ಸಸ. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />ರಾನ್ಮಾನಿಯೊ ಠೊಂಗಿಯೊನೆ ಚೊ಼ಕಾ ಝಾಡನಾ ಠೊಂಗಿಯೊ ಥಾವಾನೆ ಆಸಾನ ನ್ಹವೈ. ವರಿಬಿ ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ತುಮೆ ರಾನ್ಮಾ ರ‍್ಹಯಲ ಒಲಿವ ಝಾಡನಾ ಕತ್ರಲ ಠೊಂಗಿಯೊ ರ‍್ಹಯಲ ಚೊ಼ಕಿಯೊ ಆಲಿವ ಝಾಡನೆ ರಾಕ್ಹ ಭಾಂದಲ ನಿಂಗತ ಛೆ. ಯಹುದ್ಯೊ ಚೊ಼ಕಾ ರ‍್ಹಯಲ ಆಲಿವ ಝಾಡನೆ ಬೆಳದಲ ಠೊಂಗಿಯೊ. ತಿನಾಹುತಿ ತ್ಯುನೆ ತ್ಯುನಾ ಸ್ವಂತ ಝಾಡನೆ ವರಿ ಮಳಾನು ಕ್ಹರಿಬಿ ಸಾದ್ಯ ಛೆ. ಕ್ಹುದಾನೆ ಕೆಕಲು ಆಸಾನ ವ್ಹೈ.<verse eid="ROM 11:24" /></para>
  <para style="s">ಕ್ಹಾರಾವೊಪರ ಕ್ಹುದಾನಿ ಮರಗಾ</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />ಭಾಯೊ, ಭೆನೊ ತುಮೊನೆ ತುಮಾರಾಕ್ಹು ತುಮೆಜ಼ ಶಾಣ್ಯಾ ವ್ಹೈ ಕೈನ ಕವೈಲಿದ್ಯಾವಾಚಿ ಹಜು಼ನ ಲಕ್ಕಾಬಿ ದಡಿ ರ‍್ಹಯಲ ಕ್ಹರಿ ತುಮೊನೆ ಕೌಸ. ತೆ ಸುವೈ ಕದ್ಯಾಮ ಇಸ್ರಾಯೆಲನಾ ದಕ್ಹಾ ಮನಕ್ಹೊ ಮಡ್ಡ ಥಯಾತಬಿ ತೆನೈಸೊ ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ಕ್ಹುದಾಕನ ಆತಾಮಾ ತ್ಯುನೊನೆ ಮಡ್ಡ ರ‍್ಹಯಲ ಗೈಪಡಸ. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />ಇಮ್ಮ ಕ್ಹಾರಾ ಇಸ್ರಾಯೆಲೊ ರಕ್ಷಣೆ ಹೊಂದಿಲಿವಸ. ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಅಮ್ಮ ಬರ್ದ್ಯಾಸ;</para>
  <para style="q1" vid="ROM 11:26">"ಸಿಯೊನತೊ ರಕ್ಷಕ ಆವಸ;</para>
  <para style="q2" vid="ROM 11:26">ತೆ ಯಾಕೊಬನಾ ಕುಟುಂಬಮಾತೊ ಕ್ಹಾರು ಕೆಟ್ಟತನಾ ಕಾಡಿಪಡಸ.<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />ಮಿ ತೆ ಮನಕ್ಹೊನಾ ಪಾಪೊ ಪರಿಹಾರ ಕರತಾಮಾ</para>
  <para style="q2" vid="ROM 11:27">ತ್ಯುನಾ ಕ್ಹಾತೆ ಎ ವಡಂಬಡಿಕೆ ಕರುಸ.<verse eid="ROM 11:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ROM 11:28" />ಯಹುದ್ಯೊ ಸುವಾರ್ತೆ ಒಪ್ಪಿಲಿದ್ಯಾ ನೈ. ತಿನಾಹುತಿ ತ್ಯುನೆ ಕ್ಹುದಾನಾ ವಿರೊಧಿ ಥಯಾಸ. ಯಹುದಿ ನೈಸೊ ಮನಕ್ಹೊನೆ ಮದತ ಥೌ ಕೈನ ಎ ಥಯು. ತೆನೈಸೊ ಯಹುದ್ಯೊ ಹಜ಼ುನ ಕ್ಹುದಾತಿ ಇನಿಲಿದಲ ಮನಕ್ಹೊ ಥಯಾಸ. ತಿನಾಹುತಿ ತೆ ಪಿತೃವೊನಾ ಕ್ಹಾತೆ ಕರಲ ವಡಂಬಡಿಕೆನಾ ಮುಲಕ ತ್ಯುನೊನೆ ಮಯಾ ಕರಸ. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />ಕ್ಹುದಾ ವರಾ ದಿದಲ ಹುತಿಬಿ ಮನಕ್ಹೊನೆ ಬಲಾಯಲಹುತಿ ಪಶ್ಚಾತಾಪ ಪಡಾಲೊ ನ್ಹವ್ಹೈ. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />ಯಕ್ಕ ಟೈಮಮಾ ಯೆಹುದಿಯೊ ನೈ ರ‍್ಹಯಲ ತಿನೆ ವಿಧೆಯ ಥೈನ ನ್ಹೊತಾ. ಹಮ್ನಾತುಬಿ ತುಮೆ ಮರಗಾ ಹೊಂದಿಲಿದ್ಯಾಸ. ಕಾಕದ್ಯಾಮ ತ್ಯುನೆ (ಯಹುದ್ಯೊ) ತಿನೆ ವಿಧೆಯ ಥಯಾ ನೈ. <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />ಕ್ಹುದಾ ತುಮೊನೆ ಮರಗಾ ದೆಕಾಡಲಹುತಿ ಹಮ್ನಾ ಯಹುದ್ಯೊ ವಿಧೆಯ ಥಾತಾ ನೈ. ತೆನೈಸೊ ತ್ಯುನೆಬಿ ಕ್ಹುದಾ ಕಂತಾ ಮರಗಾ ಹೊಂದಿಲ್ಯು ಕೈನ ಇಮ್ಮ ಥಯು. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />ಕಾಕದ್ಯಾಮ ಕ್ಹಾರಾ ಜ಼ನಾ ಕ್ಹುದಾನೆ ವಿಧೆಯ ಥಯಾ ನೈ. ಕ್ಹುದಾ ಕ್ಹಾರಾವೊನೆ ಮರಗಾ ದೆಕಾಡು ಕೈನ ಕ್ಹಾರಾವೊನೆ ಮಳೈನ ಅವಿಧೆಯ ಕ್ಹು ಭಾಂದ್ಯೊಸ.<verse eid="ROM 11:32" /></para>
  <para style="s">ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಥಾವಾದೆ</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />ಹೊ, ಕ್ಹುದಾನಿ ಆಸ್ತಿ ವರಿ ಘನ್ನಿ ಛೆ! ಕ್ಹುದಾನಿ ಗ್ಯಾನ ಘನ್ನಿ ಛೆ. ಕ್ಹುದಾ ಫೈಸಲೊ ಕರಾನಾ ಸಂಗತಿಯೊನೆ ಕುನ್ನಜ಼ ತಿಳ್ಸಾತುನೈ ಕ್ಹುದಾನೊ ಫೈಸಲೊ ದೆಕಾಡಾಲು ಕುನ? ತಿನಾ ವಾಟೊ ತಿಳದಿಲಿವಾನು ಕುನ್ನ? <verse eid="ROM 11:33" /><verse number="34" style="v" sid="ROM 11:34" />ಪವಿತ್ರ ಗ್ರಂಥ ಕದಲ ನಿಂಗತ;</para>
  <para style="q1" vid="ROM 11:34">ಪ್ರಭುನು ಮನಸ ಕುನ್ನ ತಿಳ್ದಿಲಿದ್ಯುಸ?</para>
  <para style="q2" vid="ROM 11:34">ಕ್ಹುದಾನೆ ಕುನ್ನ ಸಲಹೆ ದಿವಾನೆ ಥಾವಸ? ಯೆಶಾಯ 40:13<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />ಪೈಲಾ ಕ್ಹುದಾನೆ ಕುನ್ನ ಸು ದಿದ್ಯಾಸ?</para>
  <para style="q2" vid="ROM 11:35">ಕ್ಹುದಾ ಕಿನೆಜ಼಼ ಸಾಲಾ ದಿವಾಲೊ ನ್ಹವ್ಹೈ" ಯೊಬ 41:11<verse eid="ROM 11:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ROM 11:36" />ಹೊ, ಕ್ಹುದಾ ಕ್ಹಾರುಜ಼ ಸೃಷ್ಟಿ ಕರ‍್ಯೊ. ಕ್ಹಾರು ಕ್ಹುದಾನಾ ಮುಲಕ ಕ್ಹುದಾನಾ ಹುತಿಜ಼ ವ್ಹೈ. ಕ್ಹುದಾನೆ ಹಮೆಶಾಬಿ ಮಹಿಮಾ ಥಾವಾದೆ! ಆಮೆನ್.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">ಕ್ಹುದಾನಿ ಸೆವಾಮಾ ಜಿವ್ನಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />ತಿನಾಹುತಿ ಭಾಯೊ, ಭೆನೊ, ಕ್ಹುದಾ ಘನ್ನೊ ಮರಗಾಲೊ ವ್ಹೈ ತುಮೊನೆ ಶೆಂ ಕರಲಿನ ತುಮೊಕನ ಸು ಮಾಂಗಿಲ್ಯುಸ ಕದ್ಯಾಮ, ತುಮೊನೆಜ಼ ಕ್ಹುದಾನೆ ಒಪ್ಸಿನ, ಮೆಚ್ಚಿಗೆ ರ‍್ಹಯಲ ಖುದ್ದನೆ ಒಪ್ಸಿನ ದಿವೊ. ಎಜ಼ ತುಮೆ ಕರಾನಿ ಕ್ಹರಿನಿ ಆರಾಧನಾ ವ್ಹೈ. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />ಎ ದುನಿಯಾ ರ‍್ಹಯಲನಿಂಗತ ನೈ ರ‍್ಹಯಾವಾಚಿ ಮನಸ ಬದ್ಲಿ ಕರಲಿನ ನವು ಮನಸ ಕರಲಿನ ರ‍್ಹವೊ. ತೆಳಾಮಾ ತುಮೆ ಕ್ಹುದಾನಿ ಚಿತ್ತನಾ ನಿಂಗತ ಕಯು ಚೊ಼ಕು ವ್ಹೈ, ಕಯು ಕೆಟ್ಟ ವ್ಹೈ ಕವಾನು ತಿಳ್ದಿಲಿವೊಸಿ.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />ಕ್ಹುದಾ ಮನೆ ಖಾಸ ಯಕ್ಕ ವರಾ ದಿದ್ಯೊಸ. ತಿನಾಹುತಿಜ಼, ತುಮೊಮಾ ರ‍್ಹಯಲ ಹರ ಯಕ್ಕಲಾವೊನೆ ಎ ಸಂಗತಿಯೊ ತಿಳ್ಸಾವಾಡೊಸ. ತುಮೆ ತುಮಾರಾ ಔಕಾತತಿಬಿ ಘನ್ನು ತುಮಾರಾ ವಿಷಯಮಾ ತಿಳ್ದಿಲಿವೊ ನಕೊ. ತುಮೆ ತುಮಾರಿ ವಿಷಯಮಾ ಸು ತಿಳ್ದಿಲಿದ್ಯಾತಬಿ ತೆ ವಿಚಾರ ತುಮಾರಿ ಔಕಾತನೆ ಕರೆಟ್ಟ ರ‍್ಹೌ. ಕ್ಹುದಾ ತುಮೊನೆ ಕೆಕ್ಲೊ ಬರೊಕ್ಹೊ ದಿದ್ಯೊಸ ತೆ ಬರೊಕ್ಹಾ ನಿಂಗತಜ಼ ತುಮಾರಿ ವಿಷಯಮಾ ತಿಳ್ದಿಲಿವೊ. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />ಹರ ಯಕ್ಕಲಾವೊನೆ ಯಕ್ಕ ಅಂಗ ಛೆ. ತೆ ಅಂಗನೆ ಘನ್ನಾ ಭಾಗೊ ಛೆ. ತೆ ಭಾಗೊ ಯಕ್ಕಜ಼ ಕಾಮ ನೈ ಕರ‍್ತಾ. <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />ಇಮ್ಮ ಅಪೆ ಘನ್ನಾ ಜ಼ನಾ ರ‍್ಹಯಾತಬಿ ಕ್ರಿಸ್ತಮಾ ಅಪೆ ಕ್ಹಾರಾ ಯಕ್ಕಜ಼ ಅಂಗ ವ್ಹೈ. ಅಪೆ ತೆ ಅಂಗನಾ ಬಿಜಾ಼ ಬಿಜಾ಼ ಭಾಗೊ ಥಯಾಸ. ತೆ ಅಂಗನು ಹರ ಯಕ್ಕ ಭಾಗ ಬಿಜಾ಼ ಭಾಗೊನೆ ಮಳ್ಯುಸ. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />ಅಪೆ ಕ್ಹಾರಾ ಬಿಜಾ಼-ಬಿಜಾ಼ ವರಾ ಹೊಂದಿಲಿದ್ಯಾಸ. ಕ್ಹುದಾ ಅಪೊನೆ ದಿದಲ ಕೃಪಾಕ್ಹು ಹರಯಕ್ಕ ವರಾ ಆಯುಸ. ಪ್ರವಾದನೆ ಕರಾನಿ ವರಾ ವ್ಹಂದಲವಾಲೊ ತಿನೆ ರ‍್ಹವಾನಾ ಬರೊಕ್ಹಾನಾ ಕ್ಹಾತೆ ತೆ ವರಾನೆ ಉಪಯೊಗ ಕರು. <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />ಸೆವಾ ಕರಾನಿ ವರಾ ಹೊಂದಿಲಿದಲವಾಲೊ ಸೆವಾ ಕರಾದೆ. ಶಿಕ್ಲಾವಾನಿ ವರಾ ಹೊಂದಿಲಿದಲ ವಾಲೊ ಶಿಕ್ಲಾವಾದೆ. <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />ಪ್ರೊತ್ಸಾಹ ಕರಾನಿ ವರಾ ಹೊಂದಿಲಿದಲವಾಲೊ ಬಿಜಾ಼ವೊನೆ ಪ್ರೊತ್ಸಾಹ ಕರಾದೆ. ವಾಟಿಲಿವಾನೊ ವರಾ ಹೊಂದಿಲಿದಲವಾಲೊ ವರಾ ಹೊಂದಿಲಿದಲವಾಲೊ ಮ್ಹೊಟಾ ಮನಸೆ ದಿವಾದೆ. ಅದಿಕಾರನಿ ವರಾ ಹೊಂದಿಲಿದಲವಾಲೊ ಅದಿಕಾರಮಾ ರ‍್ಹತಾಮಾ ಮ್ಹೈನತ ಕರಿನ ರಾಬು. ಮರಗಾನು ವರಾ ಹೊಂದಿಲಿದಲವಾಲೊ ಖುಶಿಕ್ಹು ತೆ ಕರಾದೆ.<verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />ತುಮಾರಿ ಮಯಾ ಕಪಟವಾಚಿ ರ‍್ಹವಾದೆ. ಕೆಟ್ಟ ಕಾಮೊನೆ ದ್ವೆಶ ಕರೊ. ಚೊ಼ಕಾ ಕಾಮೊ ಯಕ್ಕಜ಼ ಕರೊ. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />ಕ್ರಿಸ್ತನಾ ಬರೊಕ್ಹಾಮಾ ಭಾಯೊ ಭೆನೊ ನಿಂಗತ ರ‍್ಹೈನ ಯಕ್ನೆ ಯಕ್ಕ ಮಯಾ ಕರೊ. ತುಮೆ ತುಮಾರಾಹುತಿ ಆಸ ಕರಾನಿ ಮರ್ಯಾದಿತಿಬಿ ಘನ್ನಿ ಮರ್ಯಾದಿ ತುಮಾರಾ ಭಾಯೊ ಭೆನೊನೆ ದಿವೊ. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />ತುಮೆ ಪ್ರಭುನಾಹುತಿ ಸೆವಾ ಕರಾನೆ ಜ಼ರುರತ ರ‍್ಹಯಲ ಟೈಮಮಾ ಮೈಗಳ ಥೈನ ರ‍್ಹವೊ ನಕೊ. ಆತ್ಮಿಕನಿ ಖುಶಿಕ್ಹು ತಿನಿ ಸೆವಾ ಕರೊ. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />ತುಮೊನೆ ನಿರಿಕ್ಷೆ ರ‍್ಹವಾಕ್ಹು ಖುಶಿ ರ‍್ಹವೊ. ತುಮೊನೆ ತ್ರಾಸ ರ‍್ಹತಾಮಾ ತಡ್ದಿಲಿನ ರ‍್ಹವೊ. ಕ್ಹಾರಾ ಟೈಮಮಾ ಪ್ರಾಥನಾ ಕರೊ. <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />ಕಮಿಮಾ ರ‍್ಹಯಲ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ ಮದತ ಕರೊ. ಅತಿಥಿ ಸತ್ಕಾರ ಕರೈಲಿವಾಲಾವೊನೆ ಹುಡಕೊ, ತುಮಾರಾ ಘರೊನೆ ಬಲಾವೊ.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />ತುಮೊನೆ ಕೆಟ್ಟ ಕರಾಲಾವೊನೆ ಕ್ಹರಾಪ್ಯಾವಾಚಿ ತ್ಯುನಾಹುತಿ ಪ್ರಭುಕನ ಆಶಿರ್ವಾದ ಮಾಂಗೊ. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />ಖುಶಿ ಥಾವಾಲಾವೊನಾ ಕ್ಹಾತೆ ಖುಶಿ ಥಾವೊ. ದುಖ ಥಾವಾಲಾವೊನಾ ಕ್ಹಾತೆ ದುಖಿ ಥಾವೊ. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />ತುಮೆ ಯಕ್ಕನೆ ಯಕ್ಕ ಸಮಾಧಾನಕ್ಹು ಮಳಿನ ರ‍್ಹವೊ. ಸೊಕ್ಕ ಕರೊ ನಕೊ. ತೆನೈಸೊ ದಿನಕ್ಹು ತೆ ಕಾಮೊ ಕರೊ. ಸಮಾಜಮಾ ಕಿನೆ ನೈ ಚಾ಼ಯೆ ಥಯಲವಾಲಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ದೊಸ್ತಿ ಕರಿನ ರ‍್ಹವಾನೆ ಆಸ ಕರೊ. ತುಮೊನೆ ತುಮೆಜ಼, ಶಾಣ್ಯಾ ವ್ಹೈ ಕೈನ ತಿಳ್ದಿಲಿವೊ ನಕೊ.<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />ಕುನತಬಿ ತುಮೊನೆ ಕೆಟ್ಟ ಕರ‍್ಯೊಮ, ತಿನಾ ನಿಂಗತ ತಿನೆ ಕೆಟ್ಟ ಕರೊ ನಕೊ. ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಚೊ಼ಕು ವ್ಹೈ ಕೈನ ವಿಚಾರ ಕರಾನಾ ಕಾಮೊ ಕರಾನೆ ಕೊಶಿಶ ಕರೊ. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />ಕ್ಹಾರಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಶಾಂತಕ್ಹು ರ‍್ಹವಾನೆ ತುಮೊನೆ ಥಾಯೆ ತೆಕ್ಲು ಕೊಶಿಶ ಕರೊ. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />ಮಾರಾ ಮಯಾನ ದೊಸ್ತೊ, ತುಮೊನೆ ಕೆಟ್ಟ ಕರಾನಾ ಮನಕ್ಹೊನೆ ಬದಲೊ ಲಿವಾನೆ ಕೊಶಿಶ ಕರೊ ನಕೊ. ತೆನೈಸೊ ಕ್ಹುದಾನಾ ಶಿಟ್ಟನೆ ವಪ್ಸಿನ ದಿವೊ. ಮಿಜ಼ ಶಿಕ್ಷಾ ದಿವಾಲೊ ವ್ಹೈ. ಮಿಜ಼ ಮನಕ್ಹೊನೆ ಬದ್ಲೊಲಿವಾಲೊ ವ್ಹೈ ವರಿ ಮಿಜ಼ ಪ್ರತಿ ಫಲ ದಿವಾಲೊ ವ್ಹೈ ಕೈನ ಪ್ರಭು ಕವಸ" ಕೈನ ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಬರ್ದಲ ಛೆ. <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />ತೆನೈಸೊ ಪವಿತ್ರ ಗ್ರಂಥ ಅಮ್ಮ ಕವಸ. ತುಮಾರೊ ದುಷ್ಮನ ಭುಕ್ಕೊ ಥಯೊಮ, ತಿನೆ ಖಾವಾನೆ ಅನ್ನ ದಿವೊ. ತುಮಾರೊ ದುಶ್ಮನ ಪಾನಿನೊ ತರಕ್ಹೊ ಥಯೊಮ, ತಿನೆ ಪಿವಾನೆ ಪಾನಿ ದಿವೊ. ತುಮೆ ಅಮ ಕರ‍್ಯಾಮ, ತಿನೆ ಸರಮವಾಟಸ" <char style="rq"><ref loc="PRO 25:21-22">ಜ್ಞಾನೊಕ್ತಿ 25:21-22</ref></char> <verse eid="ROM 12:20" /><verse number="21" style="v" sid="ROM 12:21" />ಕೆಟ್ಟತನಾ ತುಮೊನೆ ಹಾರಾ ಲಗಾಡಾನೆ ಮೌಕೊ ದಿದ್ಯಾವಾಚಿ ಚೊ಼ಕು ಕರ‍್ತಾಜ಼ ಕೆಟ್ಟನೆ ಹಾರಾ ಲಗಾಡೊ.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">ಅಧಿಕಾರಿಯೊನೆ ವಿಧೆಯ ಥಾವೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />ತುಮೆ ಕ್ಹಾರಾ ಅದಿಕಾರಿಯೊನೆ ವಿದೆಯ ಥೈನ ರ‍್ಹೌ. ಕಾಕದ್ಯಾಮ ಕ್ಹುದಾನಿ ಅನುಮತಿ ನೈಸೊ ಕುನ್ನಜ಼ ಅದಿಕಾರಿ ಥಾತೊ ನೈ. ಹರಿ ಯಕ್ಕ ಅದಿಕಾರಿನೆ ಅದಿಕಾರ ದಿದಲ ಕ್ಹುದಾಜ಼ ವ್ಹೈ. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />ತಿನಾಹುತಿ ಅಧಿಕಾರಿಯೊನೆ ವಿರೊದ ಥಯಲ ಮನಕ್ಹ ಕ್ಹರಿಮಾಜ಼ ಕ್ಹುದಾನಿ ಆಗ್ನಾನೆ ವಿರೊದ ವ್ಹೈ. ಅಧಿಕಾರಿಯೊನೆ ವಿರೊದ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ತಿನಾಕ್ಹು ತಿನೆಜ಼ ಶಿಕ್ಷಾ ಲಿದಲ ನಿಂಗತ ವ್ಹೈ. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />ಚೊ಼ಕು ಕರಾಲಾ ಮನಕ್ಹೊನೆ ಅದಿಕಾರಿಯೊನೊ ಭೆಂ ರ‍್ಹತೊ ನೈ. ವರಿಬಿ ಕೆಟ್ಟ ಕರಾಲಾ ಮನಕ್ಹೊನೆ ಅದಿಕಾರಿಯೊನೊ ಭೆಂ ರ‍್ಹವಸ. ತುಮೆ ಅದಿಕಾರಿಯೊನೆ ಭೆಂ ನೈ ರ‍್ಹಯಲವಾಲಾ ರ‍್ಹೌ ಕೈನ ಆಸ ಕರೊಶಿಸು? ತಿಮ್ಮ ರ‍್ಹಯುಮ ತುಮೆ ಚೊ಼ಕಾ ಕಾಮೊ ಕರೊ. ತೆಳಾಮಾ ಅದಿಕಾರಿಯೊ ತುಮೊನೆ ನೆಣಸಸ. <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />ಕಾಕದ್ಯಾಮ ಅದಿಕಾರಿಯೊ ತುಮಾರಾ ಚೊ಼ಕಾನಾಹುತಿಜ಼ ನೆಮ್ಸಲ ಕ್ಹುದಾನೊ ಸೆವಕ ವ್ಹೈ. ತೆನೈಸೊ ತುಮೆ ಕೆಟ್ಟಜ಼ ಕರ‍್ಯಾಮ ಭುಚ್ಕುಜ಼. ತುಮೊನೆ ಶಿಕ್ಷಾ ದಿವಾನೆ ತಿನೆ ಅದಿಕಾರ ಛೆ. ತೆ ಅದಿಕಾರ ಉಪಯೊಗ ಕರಸ. ಅದಿಕಾರಿ ಕೆಟ್ಟ ರ‍್ಹಯಲ ಕರಾಲಾ ಮನಕ್ಹೊನೆ ಶಿಕ್ಷಾ ದಿವಾನಾಹುತಿ ನೆಮ್ಸಲ ಕ್ಹುದಾನೊ ಸೆವಕ ಥಯೊಸ. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />ತಿನಾಹುತಿ ತುಮೆ ಅಧಿಕಾರಿನೆ ವಿಧೆಯ ಥೌ ತುಮೆ ಶಿಕ್ಷಾನೆ ಗುರಿ ಥಾವೊಶಿ ಕವಾನಾ ಕಾರಣಕ್ಹು ನೈಸೊ, ತುಮಾರಿ ಮನಸನಿ ಸಾಕ್ಷಿಕ್ಹು ತುಮೆ ತ್ಯುನೊನೆ ವಿಧೆಯ ಥೌ.<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />ಎ ಕಾರಣಕ್ಹು ತುಮೆ ಭು ಭಾಡೊಬಿ ದಿವೊಸಿ. ತೆ ಅದಿಕಾರಿಯೊ ಕ್ಹುದಾನಾಹುತಿ ಕಾಮ ಕರಾಲಾ ಥಯಾಸ. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ತುಮೆ ಕಿನೆ-ಕಿನೆ ಸು-ಸು ದ್ಯು ತೆ ಕ್ಹಾರು ತ್ಯುನೊನೆ ದಿವೊ. ಕಯೊ ಭಾಡೊ ರ‍್ಹವಾದೆ ದಿವಾನು ರ‍್ಹಯುಮ ತೆ ದಿಪಾಡೊ. ಕಿನೆ ಮರ್ಯಾದಿ ದ್ಯು ತ್ಯುನೊನೆ ಮರ್ಯಾದಿ ದಿವೊ ಕಿನೆ ಇಜ್ಜತ ದ್ಯು ತಿನೆ ಇಜ್ಜತ ದಿವೊ.<verse eid="ROM 13:7" /></para>
  <para style="s">ಯಕ್ನಾ ಯಕ್ಕ ಕರ್ತವ್ಯ</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />ಮನಕ್ಹೊನಿ ಕೈ ವಿಷಯಮಾಜ಼ ಸಾಲಾಮಾ ರ‍್ಹವೊನಕೊ. ತೆನೈಸೊ ಯಕ್ಲಾನೆ ಯಕ್ಲೊ ಮಯಾ ಕರು ಕವಾನು ವಿಷಯಮಾ ಯಕ್ಕಜ಼ ಸಾಲಾವಾಲಾ ಥಯಾಸ. ಬಿಜಾ಼ ಮನಕ್ಹೊನೆ ಮಯಾ ಕರಾಲೊ ಮನಕ್ಹ ಇಡಿ ಧರಮಶಾಸ್ತ್ರನೆ ವಿಧೆಯ ಥಯೊಸ. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />ಕಾಕದ್ಯಾಮ "ವ್ಯಭಿಚಾರ ಕರು ನೈ, ಖಲಾಸ ಕರುನೈ, ಚೊ಼ರಿ ಕರು ನೈ, ಬಿಜಾ಼ವೊನು ಸಾಮನ್ನೆ ಆಸ ಕರು ನೈ" ಕೈನ ಧರಮಶಾಸ್ತ್ರ ಕವಸ. ಎ ಆಗನ್ಯಾ ಪೈಲಾ ಉಗ್ರಲ ಕ್ಹಾರಿಯೊ ಆಗನ್ಯಾ "ತುನೆ ತು ಮಯಾ ಕರಲನಿಂಗತ ಬಾಜು಼ವಾಲಾ ಮನಕ್ಹೊನೆ ಮಯಾ ಕರ" ಕವಾನು ಯಕ್ಕಜ಼ ಆಗನ್ಯಾಮಾ ದಡಿ ರ‍್ಹಯುಸ. <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />ಮಯಾ ಬಿಜಾ಼ ಮನಕ್ಹೊನೆ ಕೆಟ್ಟ ಕರತು ನೈ. ತಿನಾಹುತಿ ಮಯಾ ಕರಾನೆಬಿ ಕ್ಹಾರಿ ಆಗನ್ಯಾವೊನೆ ವಿಧೆಯ ಥಾವಾನೆ ಸುಜ಼ ಫರಕ ನತ್ತಿ.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />ಹಮೆ ಕರೆಟ್ಟ ಟೈಮಮಾ ಜಿವ್ನಾ ಕರತಾ ರ‍್ಹಯಲಕ್ಹು ಎ ಕ್ಹಾರು ಕವಾಡೊಸ ಕವಾನು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. ಹೊ, ತುಮೆ ಹುಷಾರ ರ‍್ಹವಾನು ಟೈಮ ಎ ವ್ಹೈ. ಅಪೆ ವಿಶ್ವಾಸಿಯೊ ಥಯಲ ಟೈಮ್ತಾಬಿ ಹಮ್ನಾ ಅಪ್ನಿ ರಕ್ಷಣೆ ನಜಿಕ ಛೆ. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />ರಾತ ಕ್ಹಾರಿ ಮುಗ್ದಿ ಗೈಸ. ದಿನ್ನ ನಜಿಕ ಅಯೊಸ. ತಿನಾಹುತಿ ರಾತನಾ ಕರಾನಾ ಕಾಮೊ ಕರಾನು ಛೊಡಿನ ದಿನ್ಮಾ ಕರಾನಾ ಕಾಮೊ ಕರಾನೆ ತುಮೆ ಆಯುಧೊ ಘಾಲ್ಲಿನ ಯುದ್ದನೆ ತಯ್ಯಾರ ಥಾವೊ. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />ದಿನ್ಮಾ ರ‍್ಹವಾನಾ ಮನಕ್ಹೊ ನಿಂಗತ ಚೊ಼ಕಿತರಾ ಜಿವ್ನಾ ಕರಿಯೆ. ಕೆಟ್ಟ ರ‍್ಹಯಲ ವರಿ ವ್ಯರ್ಥ ರ‍್ಹಯಲ ಔತಣೊ ಅಪೆ ತಯ್ಯಾರ ಕರು ನೈ; ಪಿನ ನಿಶಾಮಾ ರ‍್ಹೌ ನೈ; ಅಪೆ ಲೈಂಗಿಕ ಪಾಪೊ ರ‍್ಹೈನೆಕಾ ವರಿ ಸರಮಾವಾನಾ ಕಾಮೊ ಕಯಾಜ಼ ಕರು ನೈ. ವಾದ ವಿವಾದ ರ‍್ಹೈನೆಕಾ ವರಿ ಲಡೈ ಲಗಾಡು ನೈ; ವರಿ ಸಂಗಟ ಘಾಲ್ಯು ನೈ. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />ತೆನೈಸೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನೆ ಆಯುದ್ಧ ನಿಂಗತ ಭಾಂದಿಲ್ಯು, ತುಮಾರು ಪಾಪನು ಸ್ವಭಾವೊ ಕಿಮ್ಮ ತೃಪ್ತ ಕರಿಲಿಯೆ ಕೈನ ಕೆಟ್ಟ ಕಾಮೊ ಕರಿಯೆ ಕವಾನು ಆಸ ಕಿಮ್ಮ ಪುರಾ ಕರಿಯೆ ಕೈನ ವಿಚಾರ ಕರಾನು ಬಂದ ಕರೊ.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">ಬಿಜಾ಼ವೊನೊ ಫೈಸಲೊ ಕರೊ ನಕೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />ಬರೊಕ್ಹಾಮಾ ಕಮ್ಜೊ಼ರ ರ‍್ಹಯಲ ಮನಕ್ಹನೆ ತುಮಾರಾ ಕ್ಹಾತೆ ಮಳೈ ಲಿವೊ ತಿವ್ನಾ ಸ್ವಂತ ವಿಷಯಮಾ ತಿನಾ ಕ್ಹಾತೆ ವಾಗ್ವಾದ ಕರೊ ನಕೊ. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />ಯಕ್ಲೊ ಕೈ ತರಾನಿ ಅನ್ನ ಖೌ ಕೈನ ವಿಚಾರ ಕರಸ. ತೆನೈಸೊ ಬರೊಕ್ಹಾಮಾ ಬಲಹಿನ ರ‍್ಹಯಲ ಮನಕ್ಹ ತೆ ತರಕಾರಿಯೊ ಯಕ್ಕಜ಼ ಖೌ ಕೈನ ವಿಚಾರ ಕರಸ. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />ಕೈ ತರಾನು ಅನ್ನ ಖೌ ಕೈನ ಬರೊಕ್ಹೊ ಕರಾನೊ ಮನಕ್ಹ ತರಕಾರಿ ಯಕ್ಕಜ಼ ಖಾವಾಲಾ ಮನಕ್ಹನೊ ಫೈಸಲೊ ಕರು ನೈ. ತಿನಾನಿಂಗತಜ಼ ತರಕಾರಿಯೊ ಯಕ್ಕಜ಼ ಖಾವಾಲೊ ಮನಕ್ಹ ಕ್ಹಾರು ತರಾನು ಅನ್ನ ಖಾವಾಲಾ ಮನಕ್ಹನೆ ತಪ್ಪ ಕರ‍್ಯೊಸ ಕೈನ ಫೈಸಲೊ ಕರು ನೈ. ಕ್ಹುದಾ ತೆ ಮನಕ್ಹನೆ ವಪ್ಪಿಲಿದ್ಯೊಸ. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />ತು ಬಿಜೆ಼ಕ್ಲಾ ಮನಕ್ಹನಾ ಸೆವಕನೆ ಫೈಸಲೊ ಕರಾಲೊ ತು ಕುನ ವ್ಹೈ? ತೆ ಕರತೊ ರ‍್ಹಯಲ ಚೊ಼ಕು ವ್ಹೈಸು ನೈತೊ ಕೆಟ್ಟ ವ್ಹೈಸು ಕವಾನು ತಿನೊ ಸ್ವಂತ ಮಾಲಕಜ಼ ಫೈಸಲೊ ಕರಸ. ವರಿ ತ್ಯುನೆ ಕರೆಟ್ಟಜ಼ ರ‍್ಹವಸ, ಕಾಕದ್ಯಾಮ ಪ್ರಭು ತ್ಯುನೊನೆ ಸಫಲ ಕರಾನೆ ಶಕ್ತ ಥಯೊಸ.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />ಯಕ್ಲೊ ಯಕ್ಕ ದಿನ್ನನೆ ಕ್ಹಾರಾ ದಿನ್ನೊತಿಬಿ ಘನ್ನೊ ಖಾಸ ವ್ಹೈ ಕೈನ ಬರೊಕ್ಹೊ ಕರ ಸಕಸ. ವರಿಬಿ ಬಿಜೆಕ್ಲೊ ಕ್ಹಾರಾ ಯಕ್ಕಜ಼ ದಿನ್ನೊ ವ್ಹೈ ಕೈನ ಬರೊಕ್ಹೊ ಕರಸ. ಹರಿ ಯಕ್ಕ ಮನಕ್ಹ ತಿನಾ ಸ್ವಂತ ಮನಸ್ಮಾ ರ‍್ಹಯಲ ತಿನಿ ಸ್ವಂತ ಬರೊಕ್ಹಾನಾಹುತಿ ಫೈಸಲೊ ಕರಿನ ರ‍್ಹೌ. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />ಕಯೊ ಮನಕ್ಹ ಬಿಜಾ಼ ದಿನ್ನೊತಿ ಯಕ್ಕ ದಿನ್ನ ಖಾಸ ವ್ಹೈ ಕೈನ ವಿಚಾರ ಕರಾಲೊ ಮನಕ್ಹ ಪ್ರಭುನೆ ಸನ್ಮಾನ ದಿವಾನಾಹುತಿ ಕರಾಲೊ ಥಯೊಸ. ತಿನಾ ನಿಂಗತಜ಼ ಕ್ಹಾರಿ ತರಾಕ್ಹು ಅನ್ನ ಖಾವಾಲೊ ಮನಕ್ಹ ಪ್ರಭುನೆ ಸನ್ಮಾನ ದಿವಾನೆ ತೆ ಕ್ಹಾರು ಖಾವಸ. ಹೊ, ತೆ ತೆ ಅನ್ನನಾ ಹುತಿ ಕ್ಹುದಾನೆ ಸ್ತುತಿ ಕರಸ. ವರಿ ಕುನ ತರಕಾರಿಯೊ ಖಾವಸತೆಬಿ ಪ್ರಭುನೆ ಸನ್ಮಾನ ದಿವಾನೆಜ಼ ತಿಮ್ಮ ಕರಸ. ತೆಬಿ ಕ್ಹುದಾನೆ ಸ್ತುತಿ ಕರಾಲೊ ಥಯೊಸ. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />ಅಪ್ನೊಮಾ ಕುನ್ನಬಿ ಅಪ್ನಾಹುತಿ ಜಿವ್ನಾ ನೈ ಕರ‍್ತಾ ವರಿ ಅಪೆ ಅಪ್ನಾ ಹುತಿಜ಼ ನೈ ಮರ‍್ತಾ. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />ಅಪೆ ಜಿವ್ತಾ ರ‍್ಹವಾನು ರ‍್ಹಯುಮ, ಪ್ರಭುನಾ ಹುತಿಜ಼ ಜಿವ್ತಾ ರ‍್ಹಯೆಸ; ಮರವಾನು ರ‍್ಹಯುಮ ಪ್ರಭುನಾ ಹುತಿಜ಼ ವ್ಹೈ. ತಿನಾಹುತಿ ಅಪೆ ಜಿವ್ತಾ ರ‍್ಹವಾನು ವರಿ ಮರಾನು ರ‍್ಹಯುಮ ಪ್ರಭುನಾಜ಼ ಹುತಿ ವ್ಹೈ. <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />ತಿನಾಹುತಿ ವರಿ ಜಿವ್ನಾ ಕರಾನೆ ಕ್ರಿಸ್ತ ಮರಿನ ಮಜಾ಼ರೊಮಾತೊ ಜಿವ್ತೊ ಥೈ ಆಯೊ. ಮರಿಗಯಲ ಮನಕ್ಹೊನೆ ವರಿ ಜಿವ್ತಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊನಾಹುತಿ ತೆ ಪ್ರಭು ವ್ಹೈ ಕೈನ ದೆಕಾಡಿನ ದಿದ್ಯೊ. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ಕ್ರಿಸ್ತಮಾ ತಾರೊ ಭೈನೆ ತು ಕೆಟ್ಟ ವ್ಹೈ ಕವಾನು ಕಾ? ತು ತಾರಾ ಭೈತಿಬಿ ಚೊ಼ಕೊ ಛೆ ಕೈನ ಕೈಲಿವಾನು ಕಾ? ಅಪೆ ಕ್ಹಾರಾ ಕ್ಹುದಾನಾ ಕ್ಹಾಮಾ ಹುಬ್ರೈಯೆಸ. ತೆಳಾಮಾ ತೆ ಅಪೊನೆ ಫೈಸಲೊ ಕರಸ. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />ಹೊ, ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಇಮ್ಮ ಬರ್ದ್ಯಾಸ;</para>
  <para style="q1" vid="ROM 14:11">ಕ್ಹರಿಮಾಜ಼ ಮಿ ಜ್ಯುತೊ ಕ್ಹುದಾ, ಪ್ರಬು ಕವಸ.</para>
  <para style="q2" vid="ROM 14:11">ಹರಿ ಯಕ್ಲೊ ಮನೆ ಪಗೆ ಪಡಸ.</para>
  <para style="q2" vid="ROM 14:11">ಹರಿ ಯಕ್ಲೊ ಮನೆ ಕ್ಹುದಾ ವ್ಹೈ ಕೈನ ಕವಸ. <char style="rq"><ref loc="ISA 45:23">ಯೆಶಾಯ 45:23</ref></char><verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />ತಿನಾಹುತಿ ಅಪ್ನೊಮಾ ಹರಿ ಯಕ್ಲೊ ತ್ಯುನಿ-ತ್ಯುನಿ ಜಿವಿತನಾ ಹುತಿ ಕ್ಹುದಾಕನ ಲೆಕ್ಕೊ ದ್ಯು.<verse eid="ROM 14:12" /></para>
  <para style="s">ಬಿಜಾ಼ವೊನಾ ಪಾಪೊನೆ ತುಮೆ ಕಾರಣ ಥಾವೊ ನಕೊ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />ತಿನಾಹುತಿ, ಅಪೆ ಯಕ್ನಾ ಯಕ್ಕ ಫೈಸಲೊ ಕರಾನು ಛೊಡಿಪಾಡು. ಅಪ್ನಾ ಭೈಯೊನೆ ವರಿ ಭೆನೊನೆ ರ‍್ಹೈನೆಕಾ ಕಮ್ಜೊ಼ರ ಕರಾನು ವರಿ ಪಾಪ ಕರಾನೆ ಕಯುಜ಼ ನೈ ಕರಾನೆ ಅಪೆ ಫೈಸಲೊ ಕರು. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />ಮಿ ಪ್ರಭು ಥಯಲ ಯೆಸುಮಾ ಛೆ. ಕಯುಬಿ ಅನ್ನ ಪದಾರ್ಥನೆ ರ‍್ಹೈನೆಕಾ ಖಾವಾನು ತಪ್ಪ ನ್ಹವೈ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. ಯಕ್ಲೊ ಕಯುಬಿ ಅನ್ನ ಖಾವಾನು ತಪ್ಪ ವ್ಹೈ ಕೈನ ನಂಬ್ಯಾಮ, ತೆ ಅನ್ನ ತಿನೆ ಅಶುದ್ಧಥಾವಸ. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />ತು ಖಾವಾನಿ ಅನ್ನಕ್ಹು ತಾರಾ ಭೈನಾ ಬರೊಕ್ಹೊನೆ ತು ತ್ರಾಸ ಕರತೊ ರ‍್ಹಯೊಮ, ತು ಮಯಾ ಕರಾನಿ ವಾಟ್ಮಾ ಕ್ಹರಿಮಾಜ಼ ಚಾ಼ಲಾಡೊ ನತ್ತಿ. ಯಕ್ಲೊ ಕಯುಬಿ ಖಾವಾನಾ ಅನ್ನನೆ ತಪ್ಪ ವ್ಹೈ ಕೈನ ಕೈ ಲಿದ್ಯೊಮ, ತು ತೆ ಅನ್ನನೆ ಖಾದ್ಯೊಮ ತಿನೊ ಬರೊಕ್ಹೊ ಪಡಿ ಜಾ಼ವಸ. ತಿನಾಹುತಿ ತು ತಿಮ್ಮ ಕರು ನೈ. ಕ್ರಿಸ್ತ ತೆ ಮನಕ್ಹನಾಹುತಿ ಮರ‍್ಯೊ. <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />ತು ಕಯೊ ಚೊ಼ಕು ವ್ಹೈ ವಿಚಾರ ಕರ‍ಶಿಸು ತೆ ಬಿಜಾ಼ವೊನೆ ಕೆಟ್ಟ ವ್ಹೈ ಕೈನ ಕೈಲಿವಾನೆ ದ್ಯು ನಕೊ. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />ತೆನೈಸೊ ಕ್ಹುದಾನಿ ರಾಜ್ಯಮಾ ಖಾವಾನು ರ‍್ಹೈನೆಕಾ ಪಿವಾನು ರ‍್ಹೈನೆಕಾ ಖಾಸ ನ್ಹವೈ. ನಿತಿ ಸಮಾಧಾನ ಪವಿತ್ರ ಆತ್ಮಾನು ಥಾವಾನಿ ಖುಶಿ ತ್ಯಾ ಖಾಸ ವ್ಹೈ. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />ಎ ತರಾಮಾ ಕ್ರಿಸ್ತನಿ ಸೆವೆ ಕರಾಲೊ ಕ್ಹುದಾನೆ ಖುಶಿ ಕರಾಲೊ ವ್ಹೈ. ಮನಕ್ಹೊ ತಿನೆ ಮಳೈ ಲಿವಸ.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />ತಿನಾಹುತಿ ಸಮಾದಾನ ಕರಾನಾ ಕಾಮೊ ಅಪ್ನಾ ಹತೆ ಥಾವಾನು ತೆಕ್ಲು ಕೊಶಿಶ ಕರಿಯೆ. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />ಕ್ಹುದಾನು ಕಾಮ ಅನ್ನನಾಹುತಿ ಹಾಳ ಕರಾನೆ ದಿವೊ ನಕೊ. ಕ್ಹಾರು ಖಾವಾನು ಅನ್ನ ಚೊ಼ಕುಜ಼ ವ್ಹೈ. ವರಿ ಖಾವಾನೆ ಯೊಗೈ ವ್ಹೈ. ತೆನೈಸೊ ಯಕ್ಲೊ ತೆ ಖಾವಾನು ಅನ್ನನಾ ಮುಲಕ ಬಿಜಕ್ಲಾನೆ ಪಾಪಮಾ ಪಾಡಾನು ರ‍್ಹಯುಮ, ತೆ ಅನ್ನ ಖಾವಾನು ತಪ್ಪ ವ್ಹೈ. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />ತು ಮಾಕ್ಹ ಖಾವಾನು ವರಿ ದ್ರಾಕ್ಷಾರಸ ಪಿವಾನು, ದ್ರಾಕ್ಷಾರಸ ಪಿದ್ಯಾವಾಚಿ ರ‍್ಹವಾನು ಚೊ಼ಕು ವ್ಹೈ. ಬರೊಕ್ಹಾ ರ‍್ಹಯಲ ತಾರಾ ಭೈನೆ ರ‍್ಹೈನೆಕಾ ಭೆನನೆ ರ‍್ಹೈನೆಕಾ ಪಾಪಮಾ ಪಾಡ್ಯಾವಾಚಿ ರ‍್ಹವಾನು ಚೊ಼ಕು ವ್ಹೈ. <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />ಎ ಸಂಗತಿಯೊನಾಹುತಿ ತುನೆ ರ‍್ಹಯಲ ವಿಶ್ವಾಸ ತುನೆ ವರಿ ಕ್ಹುದಾನೆ ಯಕ್ಕಜ಼ ಗ್ವತ್ತ ರ‍್ಹವಾದೆ. ತಿನೆ ಚೊ಼ಕು ವ್ಹೈ ಕೈನ ತಿಳದಲ ಕಾಮೊ ತೆ ದೊಶಿ ಥೌಸ ಕೈನ ಸಂಶೊ ನೈಸೊ ಕರಾಲೊ ನಶಿಬವಾಲೊ ವ್ಹೈ. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />ತೆನೈಸೊ ಯಕ್ಲೊ ತೆ ಖಾವಾನು ಅನ್ನ ದೊಶ ನತ್ತಿ ಕೈನ ಸಂಶೊ ಮ್ಹೆಲ್ಲಿನ ಖಾದ್ಯೊಮ, ತಿನಾಕ್ಹು ತಿನೆಜ಼ ತಪ್ಪ ಕರಾಲೊ ವ್ಹೈ ಕೈನ ಕವೈ ಲಿವಸ ಕಾಕದ್ಯಾಮ ತೆ ದೊಶ ನತ್ತಿ ಕವಾನೊ ಬರೊಕ್ಹೊ ತಿಕನ ನತ್ತಿ. ಬರೊಕ್ಹೊನಾ ಆದಾರ ನತ್ತಿ ಕೈನ ಕರಾನುಜ಼ ಪಾಪ ವ್ಹೈ.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s">ಬಾಜು಼ವಾಲಾವೊನಾಹುತಿ ಚೊ಼ಕು ಸೊಚ಼</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />ತಿನಾಹುತಿ ಬರೊಕ್ಹಾಮಾ ಕಮ್ಮ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಕಮ್ಜೊ಼ರ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಅಪೆ ತಡ್ದಿಲ್ಯು. ಅಪೆ ಕ್ಹಾಲಿ ಅಪ್ನು ಯಕ್ಕಜಚೊ಼ಕು ದೆಕಿಲ್ಯು ನೈ. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />ಅಪ್ನೊಮಾ ಹರಿ ಯಕ್ಲೊ ತಿನಾ ಆಜು಼ ಬಾಜು಼ವಾಲಾವೊನಾ ಚೊ಼ಕಾನಾಹುತಿ ಬಯಸ್ತಾ ರ‍್ಹೌ. ಬರೊಕ್ಹಾಮಾ ಕಮ್ಮ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಹೆಚ್ಕಿ಼ ಬರೊಕ್ಹಾಮಾ ಘಟ್ಟ ರ‍್ಹವಾನೆ ಮದದ ಕರು. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />ಕಾಕದ್ಯಾಮ ಕ್ರಿಸ್ತಬಿ ತಿನಾ ಜ಼ಲಮಮಾ ತಿನಿ ಜಿವಿತನಾಹುತಿ ವಿಚಾರ ಕರ‍್ಯೊ ನೈ" ತುನೆ ಮರ್ಯಾದಿ ಕಾಡಲ ಮನಕ್ಹೊ ಮನೆ ಬಿ ಮರ್ಯಾದಿ ಕಾಡ್ಯಾ" ಕವಾನಾಹುತಿ ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಬರ್ದಲ ಛೆ. <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />ಪಾಚ಼ಲ್ಯಾ ದಿನೊಮಾ ಬರ್ದಲ ಹರಿ ಯಕ್ಕ ಅಪ್ನಾಹುತಿಜ಼ ಬರ್ದಲ ಛೆ. ಅಪೆ ಕೈದಾಲಾ ರ‍್ಹೌ ಕೈನ ಎ ಸಂಗತಿಯೊ ಬರ್ದಲ ಛೆ. ಪವಿತ್ರ ಗ್ರಂಥ ಅಪೊನೆ ದಿವಾನೆ ತಡ್ದಿಲಿವಾನು ವರಿ ಕೈದಾನು ಎ ಉತ್ಸಾಹ ಆವಸ. <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />ತಡ್ದಿಲಿವಾನು ವರಿ ಉತ್ಸಾಹ ಕ್ಹುದಾಜ಼ ದಿದಲ ರ‍್ಹವಸ. ಕ್ರಿಸ್ತ ಯೆಸು ಆಸ ಕರಲ ವಾಟ ತುಮೆ ಕ್ಹಾರಾ ವಪ್ಪಿಲ್ಯು. ಕ್ಹುದಾ ತುಮೊನೆ ಮದದ ಕರಾದೆ. <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />ಇಮ್ಮ ಕ್ಹಾರಾ ತುಮೆ ಯಕ್ಕಜ಼ ಮನಸಕ್ಹು ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನೊ ಬಾ ಥಯಲ ಕ್ಹುದಾನಿ ಮಹಿಮಾ ಕರೊಶಿ.<verse eid="ROM 15:6" /></para>
  <para style="s">ಬಿಜಾ಼ ಮನಕ್ಹೊನೆ ಸುವಾರ್ತೆ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />ಕ್ರಿಸ್ತ ತುಮೊನೆ ಮಳೈ ಲಿದ್ಯೊ. ತಿನಾಹುತಿ ತುಮೆ ಯಕ್ನಾ ಯಕ್ಕ ಮಳೈಲ್ಯು ಎ ಕ್ಹುದಾನೆ ಮಹಿಮಾ ಕರಾಲ ನಿಂಗತ ಥಾವಸ. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />ಕ್ಹುದಾ ಅಪ್ನಾ ಪಿತೃವೊನೆ ದಿದಲ ವಾತ ಕ್ಹರಿನಿಯೊ ವ್ಹೈ ಕೈನ ದೆಕಾಡಾನಾಹುತಿ ಕ್ಹುದಾ ತೆ ವಾತೊ ಪುರಾ ಕರಸ ಕೈನ ಕವಾನು ದೆಕಾಡಾನಾಹುತಿ <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />ಕ್ಹುದಾ ತ್ಯುನೊನೆ ದೆಕಾಡಾನಿ ಮರಗಾನಾಹುತಿ ಕ್ಹಾರಾ ಯೆಹುದಿಯೊ ತಿನೆ ಮಹಿಮಾ ಕರಾದೆ ಕೈನ ಕ್ರಿಸ್ತ ಯಹುದ್ಯೊನೊ ಸೆವಕ ಥಯೊ. ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಇಮ್ಮ ಬರ್ದ್ಯಾಸ;</para>
  <para style="q1" vid="ROM 15:9">"ತಿನಾಹುತಿ ಯಹುದ್ಯೊ ನೈಸೊವಾಲಾವೊನಾ ವಚ್ಮಾ಼ ಮಿ ತುನೆ ಸ್ತುತಿ ಕರುಸ.</para>
  <para style="q2" vid="ROM 15:9">ಮಿ ತಾರು ನಾಮ ಉಚ್ಚು಼ ಕರುಸ" <char style="rq"><ref loc="PSA 18:49">ಕಿರ್ತನೆ 18:49</ref></char><verse eid="ROM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />ಎನೈಸೊ ಪವಿತ್ರ ಗ್ರಂಥ ಅಮ್ಮ ಕವಸ;</para>
  <para style="q1" vid="ROM 15:10">"ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ತುಮೆ ಕ್ಹುದಾನಾ ಖಾಸ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ತುಮೆ ಮಳಿನ ಖುಶಿ ಥಾವೊ!<verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />ಬಿಜೆಕ ಜ಼ಗಾ ಪವಿತ್ರ ಗ್ರಂಥ ಅಮ್ಮ ಕವಸ;</para>
  <para style="q1" vid="ROM 15:11">"ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲವಾಲಾ ತುಮೆ ಕ್ಹಾರಾ ಪ್ರಭುನೆ ಸ್ತುತಿ ಕರೊ.</para>
  <para style="q2" vid="ROM 15:11">ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಪ್ರಭುನೆ ಸ್ತೊತ್ರಾ ಕವಾದೆ.<verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />ವರಿ ಯೆಶಾಯಾ ಅಮ್ಮ ಕದ್ಯೊಸ;</para>
  <para style="q1" vid="ROM 15:12">ಇಷಯನ್ನಾ ಖಾಂದಾನಮಾ ಯಕ್ಕ ಮನಕ್ಹ ಆವಸ.</para>
  <para style="q2" vid="ROM 15:12">ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಆಳಾನೆ ಆವಸ.</para>
  <para style="q2" vid="ROM 15:12">ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ತಿಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಸ. <char style="rq"><ref loc="ISA 11:10">ಯೆಶಾಯ 11:10</ref></char><verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />ಆಸ ದಿವಾಲೊ ಕ್ಹುದಾ ಬರೊಕ್ಹಾಕ್ಹು ಥಾವಾನಿ ಖುಶಿ ಸಮಾಧಾನ ಪುರಾ ದಿವಾದೆ ಕೈನ ತೆಳಾಮಾ ಪವಿತ್ರ ಆತ್ಮಾನಿ ತಾಕತಕ್ಹು ತುಮೊಮಾ ಭರಾದೆ.<verse eid="ROM 15:13" /></para>
  <para style="s">ಪೌಲಾ ಆವಾನಾಹುತಿ ಪ್ರಾಥನಾ ಕರೊ ಕೈನ ಕದಲ</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />ಮಾರಾ ಭಾಯೊ ಭೆನೊ, ತುಮೊಮಾ ಚೊ಼ಕೊಜ಼ ಭರ‍್ಯುಸ ಕೈನ ಮನೆ ಕ್ಹರಿಮಾಜ಼ ಗ್ವತ್ತ ಛೆ. ಚಾ಼ಯೆ ಥಯಲ ಕ್ಹಾರುಜ಼ ಗ್ಯಾನ ತುಮೊನೆ ಛೆ ಕೈನ ವರಿ ಯಕ್ನಾ ಯಕ್ಕ ಸಲಹೆ ದಿವೊಶಿ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />ತುಮೆ ಶೆಂ ಮ್ಹೆಲ್ಲಿವೊ ಕೈನ ಮಿ ಆಸ ಕರಲ ದಕ್ಹಿಯೊ ಸಂಗತಿಯೊ ತುಮೊನೆ ಧೈರ್ಯ ಕರಿನ ಬರ್ದ್ಯೊಸ. ಯೆಸು ಕ್ರಿಸ್ತನೊ ಸೆವಕ ವ್ಹೈ ಕೈನ ಖಾಸ ರ‍್ಹಯಲ ವರಾ ಮನೆ ಕ್ಹುದಾ ದಿದಲಕ್ಹು ಮಿ ಇಮ್ಮ ಬರ್ದ್ಯೊಸ. <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />ಯಹುದಿ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊ ಪವಿತ್ರ ಆತ್ಮಾನಾ ಮುಲಕ ಪವಿತ್ರ ಥಯಾ. ಮನಕ್ಹೊನೆ ಮದದ ಕರಾನಾಹುತಿ ಕ್ಹುದಾ ಮನೆ ಯಾಜಕನಿ ಸೆವಾ ವ್ಹೈ ಕೈನ ಕರಿಲಿದ್ಯೊ. ಕ್ಹುದಾನಿ ಸುವಾರ್ತೆ ಕೈನ ಉಪದೆಶ ಕರಿನ ಮಿ ತಿನೆ ಸೆವಕ ಥಾವಾ ವರಕ್ಹು ಕರ‍್ಯೊ. ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಕ್ಹುದಾಕನ ಔ ಕೈನ ಮಿ ಸೆವೆ ಕರಾ ವರಕ್ಹು ಥಯೊ. <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />ತಿನಾಹುತಿ ಕ್ರಿಸ್ತ ಯೆಸುನೆ ಮಿ ಕ್ಹುದಾನಾಹುತಿ ಕರಾನಾ ಕಾಮೊನಾಹುತಿ ಮಿ ಹೆಮ್ಮೆ ಕರುಸ. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />ಮಿ ಮಾರಾ ಸ್ವಂತ ಕಾಮೊನಾಹುತಿ ಬೊಲ್ತೊ ನೈ. ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ತಿನೆ ವಿಧೆಯ ಕರಿಲಿವಾನಾಹುತಿ ಕ್ರಿಸ್ತ ಮಾರಾ ಮುಕಾಂತರ ವಾತೊಕ್ಹು ಕರಲ ಕಾಮೊ ಕೈಲ್ಯುಸ. <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />ಅದ್ಭುತ ಕಾಮೊ ಕರಾನಿ ತಾಕತ ವರಿ ಮ್ಹೊಟಾ ಕಾಮೊ ದೆಕಲಕ್ಹು ಕ್ಹುದಾನಿ ಆತ್ಮಾನಿ ತಾಕತಕ್ಹುಜ಼ ಮಾರು ಕಾಮ ಪುರಾ ಕರ‍್ಯೊ. ಮಿ ಜೆರುಸೆಲಿಮತೊ ಇಲ್ಲುರಿನೆ ಪ್ರಾಂತ್ಯ ಲಕ್ಕಾ ಕ್ರಿಸ್ತನಿ ಸುವಾರ್ತೆ ಕೈನ, ಮಿ ತೆ ಕರ್ತವ್ಯ ಪುರಾ ಕರ‍್ಯೊ. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />ಕ್ರಿಸ್ತನಾಹುತಿ ಮನಕ್ಹೊ ನೈ ಐಕಲ ಜ಼ಗಾವೊಪರ ಮಿ ಸುವಾರ್ತೆ ಕವಾನೆ ಹಮೆಶಾ ಆಸ ಕರುಸ. ಕಾಕದ್ಯಾಮ ಯಕ್ಲೊ ಶುರು ಕರಲ ಕಾಮಪರ ಮಿ ತೆ ಕಾಮ ಕರಾನೆ ಮನಸ ನತ್ತಿ. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />ತೆನೈಸೊ ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಎಬಿ ಬರ್ದ್ಯಾಸ.</para>
  <para style="q1" vid="ROM 15:21">ತಿನಾಹುತಿ ನೈ ಕೈಳೈ ಲಿದಲ ಮನಕ್ಹೊ ತಿನೆ ದೆಕಸ.</para>
  <para style="q2" vid="ROM 15:21">ತಿನಾಹುತಿ ನೈ ಐಕಲ ಮನಕ್ಹೊ ತಿನೆ ತಿಳ್ದಿಲಿವಸ. <char style="rq"><ref loc="ISA 52:15">ಯೆಶಾಯ 52:15</ref></char><verse eid="ROM 15:21" /></para>
  <para style="s">ಪೌಲಾ ರೊಮನೆ ಆವಾನೆ ಕರಲ ವಿಚಾರ</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />ಇನಾಹುತಿಜ಼, ತುಮೊಕನ ಮನೆ ಆವಾನೆ ಘನ್ನಿ ಸಲಾ ಅಡ್ಚನ ಥಯು. <verse eid="ROM 15:22" /><verse number="23" style="v" sid="ROM 15:23" />ತೆನೈಸೊ ಎ ಪ್ರಾಂತ್ಯಮಾ ಕರಾನಿ ಸೆವೆ ಮಿ ಕರಿನ ಮುಗಶ್ಯೊ. ವರಿ ಘನ್ನಾ ವರಕ್ಹತೊ ಮಿ ತುಮೊಕನ ಔ ಕೈನ ಕೈಲಿದ್ಯೊತೊ. <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />ತಿನಾಹುತಿ ಮಿ ಸ್ಪೆನ ದೆಶೆ ಜಾ಼ತಾಮಾ ತುಮೊನೆ ಮಳುಸ, ದಕ್ಹಿಯೆಳ ತುಮಾರಾ ಕ್ಹಾತೆ ಖುಶಿಕ್ಹು ರ‍್ಹೌಸ ಕವಾನು ಆಸ ಮನೆ ಛೆ. ಪಾಚಾ಼ತಾ ತುಮೆ ಮಾರಾ ಪ್ರಯಾಣನೆ ಆಸ್ರೊ ಕರೊಶಿ ಕೈನ ಆಸ ಕರುಸ. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />ಮಿ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ ಸೆವಾ ಕರಾನಾಹುತಿ ಜೆರುಸಲೆಮೆ ಚಾ಼ಲ್ಯೊಸ. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />ಕಾಕದ್ಯಾಮ ಯೆರುಸೆಲಮಾ ರ‍್ಹವಾನಾ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊಮಾ ಗರಿಬೊನಾಹುತಿ ದೊಕಡಾನಾಹುತಿ ಮದತ ಕರೊ ಕೈನ ಮೆಕೆದೊನಿ ವರಿ ಅಖಾಯನಾ ಮನಕ್ಹೊ ಆಸ ಕರ‍್ಯಾಸ. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />ಮೆಕೆದೊನಿಯಾ ವರಿ ಅಖಾಯಮಾ ರ‍್ಹಯಲ ವಿಸ್ವಾಸಿಯೊ ತ್ಯಾನಾ ಗರಿಬ ಮನಕ್ಹೊನೆ ಕ್ಹುಶಿಕ್ಹು ದೊಕ್ಡಾವೊಕ್ಹು ಸಹಾಯಾ ಕರ‍್ಯಾಸ. ಮೆಕೆದೊನಿಮಾನಾ ವರಿ ಅಖಾಯಮಾನಾ ವಿಶ್ವಾಸಿಯೊ ತ್ಯುನಾ ಮನಸೆಜ಼ ಎ ಕಾಮೊ ಕರ‍್ಯಾ. ತೆ ತ್ಯುನು ಕರ್ತವ್ಯ ವ್ಹೈ. ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ತ್ಯುನೆ ಆತ್ಮಿಕಮಾ ರ‍್ಹಯಲ ಆಶಿರ್ವಾದೊನೆ ಪಾಲ ಹೊಂದಿಲಿದಲಹುತಿ ತ್ಯುನೆ ತ್ಯುನೊಕನ ರ‍್ಹಯಲ ದಿನ್ನಮಾ ತ್ಯುನೆ ತೆ ಆಶಿರ್ವಾದೊ ಹೊಂದಿಲಿದ್ಯಾಸ. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />ಯೆರುಸೆಲೆಮಮಾ ರ‍್ಹಯಲ ಗರಿಬ ಮನಕ್ಹೊನೆ ದಿವಾನಾ ದೊಕ್ಡಾ ಎ ಕ್ಹಾರಾ ದೊಕ್ಡಾ ತ್ಯುನೊನೆ ದಿದಲ್ಪರ ಮಿ ಸ್ಪೆನೆ ಔಸ. ಮಿ ಸ್ಪೆನೆ ಆತಾಮಾ ರೊಮಮಾ ರ‍್ಹೈನ ಮಿ ತುಮೊನೆ ಕೈನ ಮೊಕ್ಲುಸ. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />ಮಿ ತುಮೊಕನ ಆತಾಮಾ ಕ್ರಿಸ್ತನಾ ಘನ್ನಾ ಆಶಿರ್ವಾದ ಲೌಸ ಕೈನ ಮನೆ ಆಸ ಛೆ.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />ಭಾಯೊ ಭೆನೊ, ತುಮೆ ಮಾರಾಹುತಿ ಪ್ರಾಥನಾ ಕರಾನಾ ಮುಲಕ ಮಾರಿ ಸೆವೆನೆ ಸಹಾಯ ಕರು ಕೈನ ಮಿ ತುಮೊಕನ ಮಾಂಗಿಲ್ಯುಸ. ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನಿ ವರಿ ಪವಿತ್ರ ಆತ್ಮಾ ದಿವಾನಿ ಮಯಾಕ್ಹು ಪ್ರಾಥನಾ ಕರೊ. ಜುದೆಯಮಾ ರ‍್ಹಯಲ ಅವಿಶ್ವಾಸಿಯೊನಾ ಹತೆ ಮಿ ಚು಼ಕೈಲಿವಾನೆ ತುಮೆ ಪ್ರಾಥನಾ ಕರೊ. ವರಿ ಮಿ ಲಿನಂಜಾ಼ವಾನಾ ದೊಕ್ಡಾ ವರಿ ತೆ ದೊಕ್ಡಾ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ವೊನೆ ಮನಸೆ ಔ ಕೈನ ಪ್ರಾಥನಾ ಕರೊ. <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />ತೆ ಥಯಲ್ಪರ, ಕ್ಹುದಾನಿ ಚಿತ್ತ ರ‍್ಹೈಮ ಮಿ ತುಮೊಕನ ಔಸ. <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />ಮಿ ತುಮಾರಾ ಕ್ಹಾತೆ ಶಾಂತಿಯೆ ವರಿ ಕ್ಹುಶಿಕ್ಹು ರ‍್ಹೌಸ. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />ಶಾಂತಿ ದಿವಾಲೊ ಕ್ಹುದಾ ತುಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ. ಆಮೆನ್.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="ms">ಖುದ್ದನಿ ವಂದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />ಕ್ರಿಸ್ತಮಾ ರ‍್ಹೈನ ಅಪನಿ ಭೆನ ಥಯಲ ಪೊಯಿಬೆನೆ ಮಿ ತುಮೊನೆ ತಿನಾಹುತಿ ಕವಾನೆ ಆಸ ಕರುಸ. ತೆ ಕೆಂಕ್ರೆ ಗಾಮನಿ ಸಭೆನೆ ಖಾಸ ಮದದ ಕರಿಸ. <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />ತುಮೆ ತಿನೆ ಪ್ರಭುನಾ ನಾಮಪರ ಮಳೈಲ್ಯು ಕೈನ ಮಿ ತುಮೊಕನ ಕೈಲ್ಯುಸ. ತಿನೆ ಚಾ಼ಯೆ ಥಯಲನೆ ಮದದ ಕರೊ. ತೆ ಮನೆ ಘನ್ನಿ ಮದದ ಕರಿಸ. ತೆನೈಸೊ ಬಿಜಾ಼ ಮನಕ್ಹೊನೆಬಿ ಮದದ ಕರಿಸ.<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />ಪ್ರಿಸ್ಕಿಲ್ಲನೆ ಅಕ್ವಿಲನೆ ಮಾರಿ ವಂದನಾ ಕವೊ. ತ್ಯುನೆ ಕ್ರಿಸ್ತ ಯೆಸುಮಾ ಮಾರಾ ಕ್ಹಾತೆ ಸೆವೆ ಕರಾಡಾಸ. <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />ತ್ಯುನೆ ಮಾರೊ ಜ಼ಲಮ ವಚಾ಼ಡಾನಾಹುತಿ ತ್ಯುನೊ ಜ಼ಲಮ ದಿವಾನೆ ತಯ್ಯಾರ ಥಯಾತಾ. ಮಿ ತ್ಯುನೊನೆ ಅಭಾರಿ ಥಯೊಸ. ಮನೆ ಯಕ್ಕಜ಼ ನೈಸೊ ಯಹುದ್ಯೊ ನೈ ರ‍್ಹಯಲ ಸಭೆವಾಲಾ ತ್ಯುನೊನೆ ಆಭಾರಿ ತಯಾಸ. <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />ತೆನೈಸೊ ತ್ಯುನಾ ಘರೊಮಾ ಮಳಾಲಾ ಮನಕ್ಹೊನೆಬಿ ಮಾರಿ ವಂದನಾ ಕವೊ.</para>
  <para style="p" vid="ROM 16:5">ಮಾರೊ ಮಯಾನೊ ಥಯಲ ದೊಸ್ತ ಎಪೈನೆತನೆ ಮಾರಿ ವಂದನಾ ಕವೊ. ಎಶ್ಯಾ ದೆಶಮಾ ಯೆಸು ಸ್ವಾಮಿನೆ ನಂಬಲವಾಲಾ ಕದ್ಯಾಮ ತೆಜ಼ ಪೈಲಾ ವ್ಹೈ. <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />ಮರಿಯಳನೆ ಮಾರಿ ವಂದನಾ ಕವೊ. ತೆ ತುಮಾರಾಹುತಿ ಘನ್ನಿ ಕಷ್ಟಮಾ ಕಾಮ ಕರಿಸ. <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />ಆಂದ್ರೊನಿಕನೆ ವರಿ ಯುನ್ಯನೆ ಮಾರಿ ವಂದನಾ ಕವೊ. ತ್ಯುನೆ ಮಾರಾ ಕಳಬಳ ವ್ಹೈ. ತೆನೈಸೊ ತ್ಯುನೆ ಮಾರಾ ಕ್ಹಾತೆ ಜೆಲಮಾ ವ್ಹತ್ತಾ. ಅಪೊಸ್ತಲೊನೆ ತ್ಯುನೆ ವಳಕ ವ್ಹತ್ತಾ. ತ್ಯುನೆ ಪೈಲಾಜ಼ ಕ್ರಿಸ್ತನಾ ವಿಸ್ವಾಸಿಯೊ ವ್ಹೈ.<verse eid="ROM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8" />ಪ್ರಭುಮಾ ರ‍್ಹಯಲ ಮಾರಾ ಮಯಾನಾ ದೊಸ್ತನೆ ಅಂಪ್ಲಿಯಾತನೆಬಿ ಮಾರಿ ವಂದನಾ ಕವೊ. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />ಉರ್ಬಾನನೆಬಿ ಮಾರಿ ವಂದನಾ ಕವೊ. ತೆ ಕ್ರಿಸ್ತನಾಹುತಿ ಮಾರಾ ಕ್ಹಾತೆ ಸೆವೆ ಕರ್ತೊತೊ. ಮಾರೊ ಮಯಾನೊ ದೊಸ್ತ ಥಯಲ ಸ್ತಾಖುನೆಬಿ ಮಾರಿ ವಂದನಾ ಕವೊ. <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />ಅಪೆಲ್ಲನೆಬಿ ಮಾರಿ ವಂದನಾ ಕವೊ. ತೆ ಕ್ಹರಿಮಾಜ಼ ಕ್ರಿಸ್ತನೆ ಮಯಾ ಕರಸ ಕೈನ ಮೆಚ್ಚಿಕೆನೆ ಪಾತ್ರ ಥೈನ ದೆಕಾಡಿನ ದಿದ್ಯೊಸ. ಕರಕರಿನೆ ದೆಕ್ಯಾತಾ. ಅರಿಸ್ತೊಬುಲನಾ ಕುಟುಂಬಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಮಾರು ವಂದನಾ ಕವೊ. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />ಮಾರಾ ಸಂಬದಿಕೊ ಥಯಲ ಹೆರೊಡಿಯೊನನೆ ಪ್ರಭುನೆ ಮಳ್ಯಲವಾಲೊ ನಾರ್ಕಿಸ್ಸನಾ ಕುಟುಂಬವಾಲಾ ಕ್ಹಾರಾವೊನೆ ಮಾರು ನಮಸ್ಕಾರ ಕವೊ.<verse eid="ROM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12" />ತ್ರುಫೈನಳನೆ ತ್ರುಫೊಸಳನೆಬಿ ಮಾರು ನಮಸ್ಕಾರ ಕವೊ. ತ್ಯುನೆ ಪ್ರಭುನಾಹುತಿ ಘನ್ನು ತ್ರಾಸ ಖೈನ ಸೆವಾ ಕರ‍್ಯಾಸ. ಮಾರಿ ಮಯಾನಿ ಭೆನ ಥಯಲ ಪೆರಸಿಸಳನೆ ಮಾರು ನಮಸ್ಕಾರ ಕವೊ. ತೆಬಿ ಪ್ರಭುನಾಹುತಿ ಘನ್ನಿ ತ್ರಾಸ ಖೈನ ಸೆವಾ ಕರಾಡಾಸ. <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />ವರಿ ರುಫನೆ ಮಾರು ನಮಸ್ಕಾರ ಕವೊ. ತೆ ಪ್ರಭುನಿ ಸೆವಾಮಾ ಖಾಸ ಮನಕ್ಹ ವ್ಹೈ. ತಿನಿ ಯಾನೆಬಿ ಮಾರು ನಮಸ್ಕಾರ ಕವೊ. ತೆ ಮನೆ ಸ್ವಂತ ದಿಕ್ರಾ ನಿಂಗತ ದೆಕಿಲಿದಿಸ. <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />ಅಸುಂಕ್ರಿತನೆ ಪ್ಲೆಗೊನನೆಬಿ ಹೆರ್ಮೆಯನೆಬಿ ಪತ್ರೊಬನೆಬಿ ಹೆರ್ಮಾನನೆಬಿ ವರಿ ತ್ಯುನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾಲಾ ಕ್ಹಾರಾ ಕ್ರಿಸ್ತ ಭಾಯೊನೆಬಿ ಮಾರಿ ವಂದನೆ <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />ಫಿಲೊಲೊಗನೆ ಯುಲ್ಯಳನೆಬಿ ನೆರ್ಯನೆಬಿ ತಿನಿ ಭೆನನೆಬಿ ವರಿ ಒಲುಂಪನೆಬಿ ವರಿ ತ್ಯುನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾಲಾ ಕ್ಹಾರಾ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ ಮಾರು ನಮಸ್ಕಾರ.<verse eid="ROM 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 16:16" />ತುಮೆ ಯಕ್ಕನೆ ಯಕ್ಕ ಮಳ್ತಾಮಾ ಪವಿತ್ರ ರ‍್ಹಯಲ ನಮಸ್ಕಾರ ಕರೊ. ಕ್ರಿಸ್ತನಾ ಸಭೆವಾಲಾ ಕ್ಹಾರಾ ತುಮೊನೆ ನಮಸ್ಕಾರ ಕರಸ.<verse eid="ROM 16:16" /></para>
  <para style="s">ಲಾಸ್ಟನಾ ವಾತೊ</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />ಭಾಯೊ ಭೆನೊ, ತುಮೊಮಾ ತಪ್ಪ ಹುಟ್ಸಾವಾನಾ ಮನಕ್ಹೊನಾ ವಿಷಯಮಾ ತುಮೆ ಘನ್ನಾ ಹುಶಾರಕ್ಹು ರ‍್ಹೌ ಕೈನ ಮಿ ತುಮೊಕನ ಮಾಂಗಿಲ್ಯುಸ. ಬಿಜಾ಼ವೊನಾ ಬರೊಕ್ಹೊನೆ ಕೆಡ್ಸಾಲಾವೊನಾಹುತಿ ತುಮೆ ಘನ್ನಾ ಹುಶಾರಕ್ಹು ರ‍್ಹವೊ. ತುಮೆ ಶಿಕ್ಯಲ ಉಪದೆಶನೆ ತ್ಯುನೆ ವಿರುದ್ದ ಥಯಾಸ. ತುಮೆ ತ್ಯುನೊಕ್ಹು ದುರ ರ‍್ಹವೊ ಕೈನ ವರಿ ಮಿ ತುಮೊಕನ ಮಾಂಗಿಲ್ಯುಸ. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />ಕಾಕದ್ಯಾಮ ತ್ಯವಾ ಸಂಗತಿಯೊ ಕರಲ ಮನಕ್ಹೊ ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಕ್ರಿಸ್ತನಿ ಸೆವಾ ಕರಾಡಾ ನತ್ತಿ. ತ್ಯುನೆ ಖಾಲಿ ತ್ಯುನೆ ಪೆಟನಾಹುತಿ ಕರಾಡಾಸ. ಕೆಟ್ಟನಾಹುತಿ ನೈ ತಿಳದ್ಯಲ ಮನಕ್ಹೊನಾ ಮನಸೊನೆ ಮೊಸ ಕರಾನೆ ತ್ಯುನೆ ಚೊ಼ಕಾ ಮಯಾನಾ ವಾತೊ ಬೊಲಸ ವರಿ ಮ್ಹೊಡಾನೆ ಪಸಂದ ಆವಾನಾ ವಾತೊ ಬೊಲಸ. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />ತುಮಾರಿ ವಿಧೆಯ ಕ್ಹಾರಾ ವಿಶ್ವಾಸಿಯೊನೆ ತಿಳದಲ ಛೆ. ತಿನಾಹುತಿ ತುಮಾರಾ ವಿಷಯಮಾ ಮಿ ಘನ್ನೊ ಖುಶಿ ಥೌಸ. ತೆನೈಸೊ ಚೊ಼ಕಿಯೊ ಸಂಗತಿಯೊನಾಹುತಿ ತುಮೆ ಶಾಣ್ಯಾ ಥೈನ ರ‍್ಹೌ ಕೈನ ವರಿ ಕೆಟ್ಟ ಸಂಗತಿಯೊನಾಹುತಿ ಸುಜ಼ ಗ್ವತ್ತ ನೈ ರ‍್ಹಯಲವಾಲಾ ರ‍್ಹೌ ಕೈನ ಮಿ ಆಸ ಕರುಸ. <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />ವರಿ ಶಾಂತಿ ದಿವಾಲೊ ಕ್ಹುದಾ ಜ಼ಲ್ದಿಜ಼ ಸೈತಾನನೆ ಹರಾಡಿನ, ತಿನೆ ತುಮಾರಾ ಪಗನಾ ಹೆಟೊ ಘಾಲಸ.</para>
  <para style="p" vid="ROM 16:20">ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸುನಿ ಕೃಪಾ ತುಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />ವರಿ ಮಾರಾ ಕ್ಹಾತೆ ಕಾಮ ಕರಾಲೊ ಥಯಲ ತಿಮೊಥೆಯನೆ ವರಿ ಮಾರಾ ಸಂಬಂದಿಕ ಥಯಲ ಲುಕ್ಯ, ಯಾಸೊನ ವರಿ ಸೊಸಿಪತ್ರ ತುಮೊನೆ ನಮಸ್ಕಾರ ಕದ್ಯಾಸ.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />ಪೌಲಾ ಕವಾನಿ ಸಂಗತಿಯೊನೆ ಬರ್ದಾಲೊ ತೆರ್ತ್ಯೆಯ ಕವಾಲೊ ಮಿಬಿ ತುಮೊನೆ ಪ್ರಭುಮಾ ನಮಸ್ಕಾರ ಕರುಸ.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />ಗಾಯನ ಮನೆ ಅಥಿತಿ ಸತ್ಕಾರ ಕರಾಡೊಸ. ತೆನೈಸೊ ಸಭಾ ಕುಟನಾಹುತಿ ತಿನಾ ಘರನೆ ಉಪಯೊಗ ಕರಾಡಾಸ. ತೆಬಿ ತುಮೊನೆ ನಮಸ್ಕಾರ ಕವಾಡೊಸ. ಎ ಗಾಮನೊ ಇಸಾಬ ಮ್ಹೆಲ್ಯಾಲೊ ಎರಸ್ತ ವರಿ ಅಪ್ನೊ ಬರೊಕ್ಹೊಮಾ ರ‍್ಹಯಲ ಭೈ ಕ್ವರ್ತಬಿ ತುಮೊನೆ ನಮಸ್ಕಾರ ಕವಾಡಾಸ. <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನಿ ಕೃಪಾ ಮಳಾದೆ. ಆಮೆನ್<verse eid="ROM 16:24" /></para>
  <para style="s">ಸ್ತುತಿನಿ ಲಾಸ್ಟನಿ ಪ್ರಾಥನಾ</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />ಕ್ಹುದಾನೆ ಮಹಿಮಾ ಥಾವಾದೆ. ತುಮೊನೆ ಬರೊಕ್ಹಾಮಾ ತಾಕತ ದಿವಾಲೊ ಕ್ಹುದಾ ಯಕ್ಲೊಜ಼ ವ್ಹೈ. ಮಿ ಉಪದೆಶ ಕರಾನಿ ಸುವಾರ್ತೆನಾ ಮುಲಕ ಹಮೆಶಾ ರ‍್ಹವಾಲೊ ಕ್ಹುದಾ ತುಮೊನೆ ತಾಕತವಾಲಾ ಕರಸ. ಮಿ ಯೆಸು ಕ್ರಿಸ್ತನಾಹುತಿ ಮನಕ್ಹೊನೆ ತಿಳಸಾವಾನುಜ಼ ತೆ ಸುವಾರ್ತೆ ಕ್ಹುದಾ ತಿಳಸಾಯಲ ತೆ ಸುವಾರ್ತೆ ರಹಸ್ಯ ರ‍್ಹಯಲ ಕ್ಹರಿಜ಼ ವ್ಹತ್ತು ವರಿ ಪೈಲಾತುಬಿ ಝಕೈ ಗೈತು. <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />ತೆನೈಸೊ ರಹಸ್ಯ ರ‍್ಹಯಲ ತೆ ಸತ್ಯನೆ ಹಮ್ನಾ ತುಮೊನೆ ದೆಕಾಡ್ಯಾಸ. ವರಿ ತೆ ಸತ್ಯ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ತಿಳಸಾಯಲ ಛೆ. ಕ್ಹುದಾ ಆಜ್ಞಾ ಕರಲ ಎಜ಼ ವ್ಹೈ. ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಬರೊಕ್ಹೊ ಕರಿನ ಕ್ಹುದಾನೆ ವಿಧೆಯ ಥೌ ಕೈನ ರಹಸ್ಯ ರ‍್ಹಯಲ ಎ ಸತ್ಯನೆ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ತಿಳಸಾಯಲ ಛೆ. ಕ್ಹುದಾ ಹರ ಹಮೆಶಾ ಜಿವ್ತೊ ರ‍್ಹವಸ.<verse eid="ROM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27" />ಯಕ್ಲೊಜ಼ ಗ್ಯಾನಿ ಥಯಲ ಕ್ಹುದಾನೆ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಕೆಳಾಮಾಬಿ ಮಹಿಮಾ ಥಾವಾದೆ. ಆಮೆನ್.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>