<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Shikkalgar</book>
  <para style="h">2 ಯೊಹಾನ</para>
  <para style="toc3">2 ಯೊಹಾನ</para>
  <para style="toc2">2 ಯೊಹಾನ</para>
  <para style="toc1">2 ಯೊಹಾನ ಬರ್ದಲ ಬೆವಾ ಪತ್ರ</para>
  <para style="mt2">2 ಯೊಹಾನನು</para>
  <para style="mt1">2 ಯೊಹಾನ ಬರ್ದಲ ಬೆವಾ ಪತ್ರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಯೊಹಾನ ಬರ್ದೆಲ ಬೆವಾ ಪತ್ರಿಕೆಮಾ ಅಪೊಸ್ತಲ ಯೊಹಾನ ಯೆಸು ಸ್ವಾಮಿ ಹುಟ್ಟಲ್ಪರ 50-100 ವರಕ್ಹನಾ ವಚ್ಮಾ ಬರ್ದ್ಯೊಸ. ಯೊಹಾನ ಆ ಪತ್ರಿಕೆ ತೆಜ಼ ಬರ್ದ್ಯೊಸ ಕೈನ ದೆಕಾಡಿನ ನತ್ತಿ ದಿದ್ಯೊ, ತೆ ಸು ದೆಕಾಡಿನ ದಿವಸ ಕದ್ಯಾಮ ತೆ ಯಕ್ಕ ಶ್ಯಾಣ್ಯೊ ವ್ಹೈ ಕೈನ <char style="xt"><ref loc="2JN 1:2">1:2</ref></char> ಯೊಹಾನನಿ ಬೆವಾ ಪತ್ರಿಕೆಮಾ ಜಾಸ್ತಿ ಯೊಹಾನನ ಸುವಾರ್ತಾಮಾ ರ‍್ಹಯಲಜ಼ ದಿಕ್ಹಿನ ಆವಸ, ಅಪೆ ಯಕ್ಲಾನೆ ಯಕ್ಲೊ ಮಯಾ ಕರು ಕೈನ ವರಿ ಯೆಸು ಸ್ವಾಮಿ ತೆ ಆಗ್ಯಾ ದಿದಲ ಲಿಂಗತಜ ಚಾಲ್ತೊತೊ ಕೈನ ಕವಸ. <char style="xt"><ref loc="2JN 1:5-6">1:5-6</ref></char> ಯೊಹಾನ ಬರ್ದಲ ಸುವಾರ್ತಾನು ಬುಕ್ಕ ವರಿ ಯೊಹಾನ ಬರ್ದಲ ಯಕ್ವಾ ಬೆವಾ ವರಿ ತನವಾ ಪತ್ರಿಕೆ ಯೊಹಾನೆ ಎಫೆಸಮಾ ರ‍್ಹತಾಮಾ ಬರ್ದ್ಯೊಸ ಕೈನ ಕ್ಹಾರಾಜ಼ನಾ ಬರೊಕ್ಹೊ ಕರಸ.</para>
  <para style="ip">ಯೊಹಾನ ಆ ಪತ್ರಿಕೆ ಯಕ್ಕ ಇನಿಲಿದಲ ಬಾಕ್ಡಿ ವರಿ ತಿನಾ ಬಚ್ಚಾವೊನಾ ಹುತಿ ಲಿಕ್ಯೊಸ ಕೈನ ಕವಸ ಕಾಕದ್ಯಾಮ ತೆ ಹೈ ಸಬೆನೆ ಯಕ್ಕ ಬಾಕ್ಡಿನೆ ಹೊಲ್ಸೊಸ ಸಬೆ ತಪ್ಪ ಭೊದನೆಕ್ಹು ವರಿ ತೆ ತಪ್ಪ ಭೊದನೆ ಕರಾಲಾವೊಕ್ಹು ಹುಶಾರ ರ‍್ಹೌ ವರಿ ತ್ಯುನೆ ಬರೊಕ್ಹಾಮಾ ಆಗಾ ಬಡು ಕೈನ ಲಿಕ್ಯೊಸ.</para>
  <para style="iot">ವಳಕ</para>
  <para style="io1">1) ಯೊಹಾನ ಆ ಪತ್ರಿಕೆ ಒದಾಲವೊನೆ ನಮಸ್ಕಾರ ಕತೊ ವರಿ ಆ ಪತ್ರಿಕೆ ಕಿನಾ ಶಾನಾ ಹುತಿ ಲಿಕ್ಯೊಸ ಕೈನ ಕವಸ. <char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref></char></para>
  <para style="io1">2) ತಿಮ್ಮ ಬೊಲತೊ ಬೊಲತೊಜ ಕ್ಹಾರವೊತಿ ಮ್ಹೊಟಿ ವರಿ ಘನ್ನಿ ಜರುರಿ ರ‍್ಹಯಲ ಆಗ್ಯಾ ತ್ಯುನೊನೆ ಶೆ ದಿಲಾವಸ<char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref></char></para>
  <para style="io1">3) ತೆ ಥಯಲ್ಪರ ತೆ ತಪ್ಪ ಭೊದನೆ ಕರಾಲಾ ವರಿ ತಪ್ಪ ಭೊದನೆನಾ ಹುತಿ ಹುಶಾರ ರ‍್ಹವೊ ಕೈನ ಕವಸ.</para>
  <para style="io1">4) ವರಿ ಯೊಹಾನ ತಿನಿ ಸಭೆನೆ ವರಿ ತಿನಾ ಸಬೆವಾಲಾವೊನೆ ನಮಸ್ಕಾರ ಕರಿನ ಆ ಪತ್ರಿಕೆ ಖರಾವಸ<char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref></char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>ಸಭೆಮಾ ಮ್ಹೊಟೊ ಥಯಲ ಮಿ ಯಾವೊನೆ ವರಿ ತ್ಯುನಾ ಬಚಾವೊನೆ ಬರ್ದಾನು ಸುವೈ ಕದ್ಯಾಮ; ಅಪ್ನೊಮಾ ರ‍್ಹಯಲ ವರಿ ಅಪ್ನಾ ಕ್ಹಾತೆ ಕೆಳಾಮಾಬಿ ಹಮೆಶಾಬಿ ಅಪ್ನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾನು ಕ್ಹರಿನಾ ಹುತಿ ಮಿ ತುಮೊನೆ ಕ್ಹರಿಕ್ಹು ಮಯಾ ಕರುಸ; ಮಿ ಯಕ್ಕಜ಼ ನೈ ಮಾರಾ ಕ್ಹಾತೆ ಕ್ಹರಿ ಸು ವ್ಹೈ ಕೈನ ತಿಳಿದಿಲಿದಲ ಕ್ಹಾರಾಜ಼ನಾ ತುಮೊನೆ ಮಯಾ ಕರಸ. <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>ಹಮಾರಾ ರಹೆಲ ವರಿ ಹರ ಯಕ್ಕ ವತ್ಕ ರ‍್ಹವಾಹು ಕ್ಹರಿನಾಹುತಿ, ಮಿ ತಮನೊನೆ ಕ್ಹರಿಜ ಮಯಾ ಕರುಸ. ಮಿ ನೈಸೊ ಕ್ಹರಿನೆ ಕುನ ಮಯಾ ಕರಸ ತಮನೊನೆ ಬಿ ಮಯಾ ಕರಸ. <verse eid="2JN 1:2"/><verse number="3" style="v" sid="2JN 1:3"/>ಬಾ ಥಯಲ ಕ್ಹುದಾಕ್ಹು, ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತಕ್ಹು, ಕೃಪೆ, ಮರಗಾ, ಶಾಂತಿ, ಕ್ಹರಿ, ಮಯಾ ಹರ ಯಕ್ಕ ವಕ್ಹತ ಅಪ್ನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ.<verse eid="2JN 1:3"/></para>
  <para style="s">ಕ್ರಿಸ್ತ ಕದಲ ಲಿಂಗತ ಚಾ಼ಲಾನು</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>ಬಾ ಕ್ಹು ಹಮೆ ಹೊಂದಿಲಿದೆಲ ಆಜ್ಞಾಕ್ಹು, ಪ್ರಕಾರ ತಮಾರಾ ಬಚಾವೊಮಾ ದಕ್ಹಜ಼ನಾ ಕ್ಹರಿನಾಜ ಥೈನ ಚಾ಼ಲಾನು ದೆಕಿನ ಮಿ ಘನೊ ಖುಶಿ ಥಯೊ. <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>ಮಾರಿ ಮಾವೊ, ಮಿ ತಮನೊನೆ ನಯಾ ಆಜ್ಞಾ ಬರದೆವಾಚಿ ಪೈಲಾತೊಜ ಹಮನೊನೆ ರ‍ಹೆಲ ಆಜ್ಞಾ ತಮನೊನೆ ಬರ್ದಾಲೊ ಥೈನ; ಅಪೆ ಯಕ್ಕನೆ ಯಕ್ಕ ಮಯಾ ಕರಾಲಾ ಥೈನ ಕೈನ ತಮನೊನೆ ಕನ ಮಾಂಗಿಲ್ಯುಸ. <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>ಕ್ಹುದಾನಿ ಆಗನ್ಯಾನೆ ಕಾಯಿದಿಲಿನ ವಿಧೆಯತೆ ಥೈವಾನುಜ ಮಯಾ ವ್ಹೈ. ಮಾಯಾ ಚಾಲಾವಾಲಾ ವ್ಹೈ ಕೈನ ತಮೆ ಪೈಲಾತಾ ಪುಚೆಲ ಆಜ್ಞಾ ಥೈಸು. <verse eid="2JN 1:6"/><verse number="7" style="v" sid="2JN 1:7"/>ಕಾಕದ್ಯಾಮ ಯೆಸುಕ್ರಿಸ್ತ ಮನಕ್ಹ ಥೈನ ಆಯೊ ಕವಾನು ಒಪೆವಾಚಿ ರಹೆಲ ದಕ್ಹಜ಼ನಾ ಮೊಸ ಕರಾವಾಲಾ ದುನಿಯಾಮ್ಮಾ ಆಯಾತ್ತಾ. ಹವಾಜ ಯೆಸುನೆ ಒಪೆವಾಚಿ ಮೊಸ ಕರಾವಾಲಾ ಕ್ರಿಸ್ತನಾ ವಿರೊದಿಯೊ ಥಯಾಸ. <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>ತಮೆ ಮ್ಹೈನತ ಕರಿನ ಕರಲ ಜುವೈಲೆವಾಚಿ ಪುರ್ಣ ಪ್ರತಿಫಲ ಹೊಂದಿಲಿವಾನಾ ಹುತಿ ಹುಶಾ ರ‍್ಹೈ. <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>ಕ್ರಿಸ್ತನ ಉಪದೆಶಮಾ ನೈ ಘಟ ರ‍್ಹಯೆಲವಾಲಾವೊನೆ ತಿನೆ ದಾಟಿ ಜಾ಼ವಾಲಾವೊನೆ ತ್ಯುನಾ ಕ್ಹಾತೆ ಕ್ಹುದಾ ರ‍್ಹತೊ ನೈ. ತೆ ಉಪದೆಶಮಾ ಘಟ ರಹವಾಲಾವೊನಾ ಕ್ಹಾತೆ ಬಾ ಬಿ ರ‍್ಹವಸ ವರಿ ದಿಕ್ರೊ ಬಿ ರ‍್ಹವಸ. <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>ತೆ ಉಪದೆಶ ದಾಟಿ ಜಾ಼ವಾ ವಾಲಾ ಕುನಬಿ ತಮನೊ ಕನ ಆಯಾಮ್ಮಾ ತಿನೆ ಘರಾ ನಕೊ ಲ್ಯು ಕೈನ ತಿನೆ ಚೊ಼ಕು ಥಾವಾದೆ ಕೈನ ಕೌನೈ. <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>ಕಾಕದ್ಯಾಮ್ಮ ತಿನೆ ಚೊ಼ಕು ಥಾಂವಾದೆ ಕೈನ ಕವಾನು ತೆ ಕಟ್ಟಕಾಮೊಮ್ಮಾ ವಾಟೊ ಲಿವಾಲೊ ಥೈವಸ.<verse eid="2JN 1:11"/></para>
  <para style="s">ಲಾಸ್ಟನಾ ವಾತೊ</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>ತುಮೊನೆ ಬರ್ದಾನಾ ಹುತಿ ಮನೆ ಘನಿಯೊ ವಿಷಯೊ ರ‍್ಹೈತಬಿ ತಿನೆ ಮನಸಕ್ಹು ಕಾಗತಪರ ಬರ್ದಿನ ತಿಳಸಾನಾ ಹುತಿ ಮನೆ ಮನಸ ನತ್ತಿ. ತಿನಾಹುತಿ ಮಿ ತುಮಾರಾ ಕ್ಹಾಜ ಬೊಲು ಕೈ ಮನಸ ಛೆ. ತೆಳಾಮಾ ತುಮಾರು ಕ್ಹುಶಿ ಪರಿಪುರ್ಣ ಥಾವಸ. <verse eid="2JN 1:12"/><verse number="13" style="v" sid="2JN 1:13"/>ತಾರಿಯೊ ಭೆನೊನಾ ಬಚ್ಚಾ ತುನೆ ವಂದನೆ ಕವಾಡ್ಯಾಸ.<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
