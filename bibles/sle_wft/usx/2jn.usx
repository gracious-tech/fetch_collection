<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Shikkalgar</book>
  <para style="h">2 ಯೊಹಾನ</para>
  <para style="toc3">2 ಯೊಹಾನ</para>
  <para style="toc2">2 ಯೊಹಾನ</para>
  <para style="toc1">2 ಯೊಹಾನ ಬರ್ದಲ ಬೆವಾ ಪತ್ರ</para>
  <para style="mt2">2 ಯೊಹಾನನು</para>
  <para style="mt1">2 ಯೊಹಾನ ಬರ್ದಲ ಬೆವಾ ಪತ್ರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಯೊಹಾನ ಬರ್ದೆಲ ಬೆವಾ ಪತ್ರಿಕೆಮಾ ಅಪೊಸ್ತಲ ಯೊಹಾನ ಯೆಸು ಸ್ವಾಮಿ ಹುಟ್ಟಲ್ಪರ 50-100 ವರಕ್ಹನಾ ವಚ್ಮಾ ಬರ್ದ್ಯೊಸ. ಯೊಹಾನ ಆ ಪತ್ರಿಕೆ ತೆಜ಼ ಬರ್ದ್ಯೊಸ ಕೈನ ದೆಕಾಡಿನ ನತ್ತಿ ದಿದ್ಯೊ, ತೆ ಸು ದೆಕಾಡಿನ ದಿವಸ ಕದ್ಯಾಮ ತೆ ಯಕ್ಕ ಶ್ಯಾಣ್ಯೊ ವ್ಹೈ ಕೈನ <char style="xt"><ref loc="2JN 1:2">1:2</ref></char> ಯೊಹಾನನಿ ಬೆವಾ ಪತ್ರಿಕೆಮಾ ಜಾಸ್ತಿ ಯೊಹಾನನ ಸುವಾರ್ತಾಮಾ ರ‍್ಹಯಲಜ಼ ದಿಕ್ಹಿನ ಆವಸ, ಅಪೆ ಯಕ್ಲಾನೆ ಯಕ್ಲೊ ಮಯಾ ಕರು ಕೈನ ವರಿ ಯೆಸು ಸ್ವಾಮಿ ತೆ ಆಗ್ಯಾ ದಿದಲ ನಿಂಗತಜ ಚಾಲ್ತೊತೊ ಕೈನ ಕವಸ. <char style="xt"><ref loc="2JN 1:5-6">1:5-6</ref></char> ಯೊಹಾನ ಬರ್ದಲ ಸುವಾರ್ತಾನು ಬುಕ್ಕ ವರಿ ಯೊಹಾನ ಬರ್ದಲ ಯಕ್ವಾ ಬೆವಾ ವರಿ ತನವಾ ಪತ್ರಿಕೆ ಯೊಹಾನೆ ಎಫೆಸಮಾ ರ‍್ಹತಾಮಾ ಬರ್ದ್ಯೊಸ ಕೈನ ಕ್ಹಾರಾಜ಼ನಾ ಬರೊಕ್ಹೊ ಕರಸ.</para>
  <para style="ip">ಯೊಹಾನ ಆ ಪತ್ರಿಕೆ ಯಕ್ಕ ಇನಿಲಿದಲ ಬಾಕ್ಡಿ ವರಿ ತಿನಾ ಬಚ್ಚಾ಼ವೊನಾ ಹುತಿ ಲಿಕ್ಯೊಸ ಕೈನ ಕವಸ ಕಾಕದ್ಯಾಮ ತೆ ಹೈ ಸಬೆನೆ ಯಕ್ಕ ಬಾಕ್ಡಿನೆ ಹೊಲ್ಸೊಸ ಸಬೆ ತಪ್ಪ ಭೊದನೆಕ್ಹು ವರಿ ತೆ ತಪ್ಪ ಭೊದನೆ ಕರಾಲಾವೊಕ್ಹು ಹುಶಾರ ರ‍್ಹೌ ವರಿ ತ್ಯುನೆ ಬರೊಕ್ಹಾಮಾ ಆಗಾ ಬಡು ಕೈನ ಲಿಕ್ಯೊಸ.</para>
  <para style="iot">ವಳಕ</para>
  <para style="io1">1) ಯೊಹಾನ ಆ ಪತ್ರಿಕೆ ಒದಾಲವೊನೆ ನಮಸ್ಕಾರ ಕತೊ ವರಿ ಆ ಪತ್ರಿಕೆ ಕಿನಾ ಶಾನಾ ಹುತಿ ಲಿಕ್ಯೊಸ ಕೈನ ಕವಸ. <char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref></char></para>
  <para style="io1">2) ತಿಮ್ಮ ಬೊಲತೊ ಬೊಲತೊಜ ಕ್ಹಾರವೊತಿ ಮ್ಹೊಟಿ ವರಿ ಘನ್ನಿ ಜರುರಿ ರ‍್ಹಯಲ ಆಗ್ಯಾ ತ್ಯುನೊನೆ ಶೆ ದಿಲಾವಸ<char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref></char></para>
  <para style="io1">3) ತೆ ಥಯಲ್ಪರ ತೆ ತಪ್ಪ ಭೊದನೆ ಕರಾಲಾ ವರಿ ತಪ್ಪ ಭೊದನೆನಾ ಹುತಿ ಹುಶಾರ ರ‍್ಹವೊ ಕೈನ ಕವಸ.</para>
  <para style="io1">4) ವರಿ ಯೊಹಾನ ತಿನಿ ಸಭೆನೆ ವರಿ ತಿನಾ ಸಬೆವಾಲಾವೊನೆ ನಮಸ್ಕಾರ ಕರಿನ ಆ ಪತ್ರಿಕೆ ಖರಾವಸ<char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref></char></para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />ಸಭೆಮಾ ಮ್ಹೊಟೊ ಥಯಲ ಮಿ ಯಾವೊನೆ ವರಿ ತಿನಾ ಬಚ್ಚಾವೊನೆ ಬರ್ದಾನು ಸುವೈ ಕದ್ಯಾಮ; ಅಪ್ನೊಮಾ ರ‍್ಹಯಲ ವರಿ ಅಪ್ನಾ ಕ್ಹಾತೆ ಕೆಳಾಮಾಬಿ ಹಮೆಶಾಬಿ ಅಪ್ನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾನು ಕ್ಹರಿನಾ ಹುತಿ ಮಿ ತುಮೊನೆ ಕ್ಹರಿಕ್ಹು ಮಯಾ ಕರುಸ;</para>
  <para style="p" vid="2JN 1:1">ಮಿ ಯಕ್ಕಜ಼ ನೈ ಮಾರಾ ಕ್ಹಾತೆ ಕ್ಹರಿ ಸು ವ್ಹೈ ಕೈನ ತಿಳಿದಿಲಿದಲ ಕ್ಹಾರಾಜ಼ನಾ ತುಮೊನೆ ಮಯಾ ಕರಸ. <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />ಹಮಾರಾ ರ್ಹಯಲ ವರಿ ಕ್ಹರಿನಾಹುತಿ, ಹಮೆ ತುಮೊನೆ ಕ್ಹರಿಜ ಮಯಾ ಕರುಸ. ಆಂ ಕ್ಹರಿಜ಼ ಹಮಾರಾಮಾ ಕೆಳಾಮಾಬಿ ರ್xಹವಸ.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />ಬಾ ಥಯಲ ಕ್ಹುದಾಕ್ಹು, ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತಕ್ಹು, ಕೃಪೆ, ಮರಗಾ, ಶಾಂತಿ, ಕ್ಹರಿ, ಮಯಾ ಹರಯಕ್ಕ ವಕ್ಹತ ಅಪ್ನಾ ಕ್ಹಾತೆ ರ್ಹವಸ.<verse eid="2JN 1:3" /></para>
  <para style="s">ಕ್ರಿಸ್ತ ಕದಲ ನಿಂಗತ ಚಾ಼ಲಾನು</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />ತುಮಾರಾ ಬಚ್ಚಾವೊಮಾ ದಕ್ಹಾಜ಼ನಾನಾ ಬಗ್ಗೆ ಮಿ ಐಕ್ತಾಮಾ ಘನಿ ಕ್ಹುಶಿ ಥಯಿ. ಬಾ ಥಯಲ ಕ್ಹುದಾ ಹಮೊನೆ ಅಗನ್ಯಾ ದಿದಲ ಕ್ಹರಿನಾ ವಾಟೊನೆ ತ್ಯುನೆ ಚಾ಼ಲ್ತಾಮಾಜ಼ ಮನೆ ಕ್ಹುಶಿ ಥಯಿ. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />ಮಾರಿ ಮಾವೊ, ಮಿ ತುಮೊನೆ ನಯಾ ಆಜ್ಞಾ ಬರದೆವಾಚಿ ಪೈಲಾತೊಜ ಹಮನೊನೆ ರ‍ಹೆಲ ಆಜ್ಞಾ ತುಮೊನೆ ಬರ್ದಾಲೊ ಥೈನ; ಅಪೆ ಯಕ್ಕನೆ ಯಕ್ಕ ಮಯಾ ಕರಾಲಾ ಥಯೆ ಕೈನ ತುಮೊಕನ ಮಾಂಗಿಲ್ಯುಸ. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />ಕ್ಹುದಾನಿ ಆಗನ್ಯಾನೆ ಕಾಯಿದಿಲಿನ ವಿಧೆಯತೆ ಥಾವಾನುಜ಼ ಮಯಾ ವ್ಹೈ. ಮಾಯಾ ಚಾಲಾವಾಲಾ ವ್ಹೈ ಕೈನ ತುಮೆ ಪೈಲಾತಾ ಪುಚ್ಚಲ ಆಜ್ಞಾ ಥೈಸ.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />ಕಾಕದ್ಯಾಮ ಯೆಸುಕ್ರಿಸ್ತ ಮನಕ್ಹ ಥೈನ ಆಯೊ ಕವಾನು ಒಪ್ಪೆವಾಚಿ ರಹೆಲ ದಕ್ಹಜ಼ನಾ ಮೊಸ ಕರಾವಾಲಾ ದುನಿಯಾಮಾ ಆಯಾತಾ. ಹವಾಜ಼ ಯೆಸುನೆ ಒಪ್ಪೆವಾಚಿ ಮೊಸ ಕರಾಲಾ ಕ್ರಿಸ್ತನಾ ವಿರೊದಿಯೊ ಥಯಾಸ. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />ತುಮೆ ಕೊಶಿಶ ಕರಿನ ಕರಲ ಕ್ಹಾರು ಜವೈಲೆವಾಚಿ ಪುರಾ ಪ್ರತಿಫಲ ಹೊಂದಿಲಿವಾನಾಹುತಿ ಹುಶಾರಕಿ ರ್ಹೆ.<verse eid="2JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9" />ಕ್ರಿಸ್ತನ ಉಪದೆಶಮಾ ನೈ ಘಟ್ಟ ರ‍್ಹಯಲವಾಲಾವೊನೆ ತಿನೆ ದಾಟಿ ಜಾ಼ವಾಲಾವೊನೆ ತ್ಯುನಾ ಕ್ಹಾತೆ ಕ್ಹುದಾ ರ‍್ಹತೊ ನೈ. ತೆ ಉಪದೆಶಮಾ ಘಟ್ಟ ರ್ಹಯಲ ವಾಲಾವೊನಾಕ್ಹಾತೆ ಬಾಬಿ ರ‍್ಹವಸ ವರಿ ದಿಕ್ರೊಬಿ ರ‍್ಹವಸ. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />ಆಂ ಉಪದೆಶನೆ ನೈ ವಪ್ಪಾಲೊ ಕಯೊಬಿ ತುಮಾರಾ ಕ್ಹಾತೆ ಆಯಾರೆ ತಿನೆ ಘರಮಾ ಸೆರಸಿ ಲಿವೊ ನಕೊ, ತಿನೆ ಚೊ಼ಕು ಥಾವಾದೆ ಕೈನ ಕವೊ ನಕೊ. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />ಕಾ ಕದ್ಯಾಮ ತಿನೆ ಚೊ಼ಕು ಥಾವಾದೆ ಕೈನ ಕವಾನು ತೆ ಕೆಟ್ಟ ಕಾಮೊಮಾ ವಾಟೊ ಲಿವಾಲೊ ಥಾವಸ.<verse eid="2JN 1:11" /></para>
  <para style="s">ಲಾಸ್ಟನಾ ವಾತೊ</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />ತುಮೊನೆ ಬರ್ದಾನಾ ಹುತಿ ಮನೆ ಘನಿಯೊ ವಿಷಯೊ ರ‍್ಹೈತಬಿ ತಿನೆ ಮನಸಕ್ಹು ಕಾಗತಪರ ಬರ್ದಿನ ತಿಳಸಾವಾನಾಹುತಿ ಮನೆ ಮನಸ ನತ್ತಿ. ತಿನಾಹುತಿ ಮಿ ತುಮಾರಾ ಕ್ಹಾತೆಜ಼ ಬೊಲು ಕೈನ ಮನಸ ಛೆ. ತೆಳಾಮಾ ತುಮಾರು ಕ್ಹುಶಿ ಪರಿಪುರ್ಣ ಥಾವಸ.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />ತಾರಾ ಭೆನೊನಾ ಬಚ್ಚಾ಼ ತುನೆ ವಂದನೆ ಕವಾಡಾಸ.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>