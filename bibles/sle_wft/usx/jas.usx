<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Shikkalgar</book>
  <para style="h">ಯಾಕೊಬ</para>
  <para style="toc3">ಯಾಕೊಬ</para>
  <para style="toc2">ಯಾಕೊಬ</para>
  <para style="toc1">ಯಾಕೊಬ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="mt2">ಯಾಕೊಬನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ಯಾಕೊಬ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಯಾಕೊಬ ಬಿಜಾ಼ಬಿ ಪತ್ರಿಕೆ ಬರ್ದಲ ಛೆ 1:1 ಎ ಯೆರುಸೆಲೆಮನಾ ಸಭೆಮಾ ಮ್ಹೊಟೊ ನಾಯಕ ಥಯೊಸ ಯೆಸುನೊ ಭೈ ಥಯತೊ. ಕ್ರಿಸ್ತನೆ ಘನ್ನಾ ನ್ಹಾನಾ ಭಾಯೊ ವ್ಹತಾ ಇಮಾನು ಯಕೊಬಬಿ ವ್ಹತೊ. ತ್ಯುನೊಮಾ ಎ ಯಕ್ಲಜ಼ ಮ್ಹೊಟೊ ವಸ ಕಾ ಕದ್ಯಾಮ ಮತ್ತಾ 13:55 ಮಾ ಪಟ್ಟಿಮಾ ಎಜ಼ ಪೈಲಾ ವ್ಹತೊ. ಎ ಪೈಲಾ ಯೆಸುನೆ ಬರಕ್ಹೊ ಕರ್ತೊ ನ್ಹೊತೊ ಎ ತಿನೆ ಸವಾಲ ಘಾಲ್ಯೊತೊ ತೆ ವರಿ ತಿನಾ ತಿನಾ ಕಾಮೊನೆ ತಪ್ಪ ವಿಚಾರ ಕರ‍್ಯೊತೊ. (ಯೊಹಾ 7:2-5) ತೆ ಥಯಲ್ಪರ ತೆ ಸಭೆಮಾ ಖಾಸ ತೆಜ಼ ಥಯೊ. ಕ್ರಿಸ್ತ ಪುನರುತ್ಥಾನ ಥಾತಾಮಾ ಇನಿಲಿದಲ ಮನಕ್ಹಮಾ ಎಬಿ ಯಕ್ಲೊ ವ್ಹತೊ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1. ಕ್ಹರಿನಿ ಕ್ಹುದಾನಿ ಭಕ್ತಿನಾ ಹುತಿ ಯಾಕೊಬ <char style="ior"><ref loc="JAS 1:1-27">1:1-27</ref> </char></para>
  <para style="io1">2. ಕ್ಹರಿನೊ ಬರೊಕ್ಹೊನು ಚೊ಼ಕಾ ಕಾಮೊ ದೆಕಾಡಿನೆ ದಿವಸ <char style="ior"><ref loc="JAS 2:1-3:12">2:1—3:12</ref> </char></para>
  <para style="io1">3. ಕ್ಹರಿನು ಗ್ಯಾನ ಕ್ಹುದಾತುಜ಼ ಆವಸ <char style="ior"><ref loc="JAS 3:13-5:20">3:13—5:20</ref> </char></para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s">ಕಷ್ಟನಾ ಹುತಿ ವರಿ ಕೆಟ್ಟ ಪ್ರೆರಣೆನಾ ಹುತಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />ಕ್ಹುದಾನೆಬಿ ವರಿ ಯೆಸು ಕ್ರಿಸ್ತನೆಬಿ ದಾಸ ಥಯಲ ಯಾಕೊಬ ಬಿಜಾ಼ ದೆಶಮಾ ಫೈಲಿಗಯಲ</para>
  <para style="p" vid="JAS 1:1">ಇಸ್ರಾಯೆಲೊನಾ ಬಾರಾ ಖಾಂದಾನವಾಲಾವೊನೆ ಬರ್ದಾನು ಸು ವ್ಹೈ ಕದ್ಯಾಮ, ತುಮೊನೆ ಚೊ಼ಕು ಥಾವಾದೆ.<verse eid="JAS 1:1" /></para>
  <para style="s">ಬರೊಕ್ಹೊ ವರಿ ಗ್ಯಾನ</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />ಮಾರ ಭಾಯೊ ಭೆನೊ, ತುಮೆ ಬಿಜಾ಼-ಬಿಜಾ಼ ತರಾನಾ ಕಷ್ಟ ಖಾತಾಮಾ ತೆ ಕ್ಹಾರು ಚೊ಼ಕುಜ಼ ವ್ಹೈ ಕೈನ ತಿಳಿದಿಲಿವೊ. <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />ಕಾಕದ್ಯಾಮ ತುಮಾರಾ ಬರೊಕ್ಹಾನೆ ಥಾವಾನಿ ಪರಿಕ್ಷಾ ತುಮೊಮಾ ತಾಳ್ಮೆ ಹುಟ್ಸಾವಸ ಕೈನ ತುಮೆ ತಿಳಿದಿಲಿವೊ. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />ತೆ ತಾಳ್ಮೆ ತುಮೊಮಾ ಪುರಾ ಥಾವಾದೆ, ತೆಳಾಮಾ ತುಮೆ ಪುರಾ ಚೊ಼ಕಿಯೊ ಚಾಳಿಯೊವಾಲಾ, ಪುರಾ, ಕಿಮಾಜ಼ ಸು ಕಮ್ಮ ನೈಸೊವಾಲಾ ಥಾವೊಶಿ.<verse eid="JAS 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 1:5" />ತುಮೊಮಾ ಕಿನೆಬಿ ಗ್ಯಾನ ಕಮ್ಮ ರ‍್ಹಯುಮ ತೆ ಕ್ಹುದಾಕನ ಮಾಂಗಿಲಿವಾದೆ, ತೆ ತ್ಯುನೊನೆ ಮಳಸ. ಕಾಕದ್ಯಾಮ ಕ್ಹುದಾ ಹಟಕ್ಯಾ ಬಗರ ಕ್ಹಾರಾವೊನೆ ಉದಾರ ಮನಸಕ್ಹು ದಿವಾಲೊ ಥಯೊಸ. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />ತೆನೈಸೊ ಕ್ಹುದಾಕನ ಮಾಂಗಾಲೊ ನಕ್ಕರಬಿ ಸಂಶೊ ಕರ‍್ಯಾ ಬಗರ ಬರೊಕ್ಹಾಕ್ಹು ಮಾಂಗಾದೆ. ಸಂಶೊ ಕರಾಲೊ ವಾರಾಕ್ಹು ಹೈತಿ ಜಾ಼ವಾನಾ ಸಮುಂದರನಾ ಧಡ್ಕಿಯೊ ನಿಂಗತ ವ್ಹೈ. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />ಅಮ್ಮ ಸಂಶೊ ಕರಾಲೊ ತೆ ಕರ್ತಾಕನ ಮಾಂಗಿಲಿದಲ ಮಳಸ ಕೈನ ವಿಚಾರ ಕರ‍್ಯಾ ಬಗರ ರ‍್ಹವಾದೆ. <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />ಕಾಕದ್ಯಾಮ ತೆ ಬೆ ಮನಸವಾಲೊ ವ್ಹೈ, ಯಕ್ಕ ಜ಼ಗಾ ಹುಬ್ರಾವಾಲೊ ನ್ಹವೈ.<verse eid="JAS 1:8" /></para>
  <para style="s">ಗರಿಬಿ ವರಿ ದೌಲತ</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />ಘನ್ನಿ ಕೆಟ್ಟ ಸ್ಥಿತಿಮಾ ರ‍್ಹಯಲವಾಲೊ ಭೈ ತೆ ಯಕ್ಕ ಚೊ಼ಕಾ ಸ್ಥಾನಮಾ ಹುಬ್ರಯೊಸ (ಉಪ್ಪರ ಆಯೊಸ) ಕೈನ ಖುಶಿ ಥಾವಾದೆ. <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />ಸೌಕಾರ ರ‍್ಹಯಲವಾಲೊ ಭೈ ತೆ ಹೆಟೊ ಆಯೊಸ ಕೈನ ಖುಶಿ ಥಾವಾದೆ; ಕಾಕದ್ಯಾಮ ಸೌಕಾರ ರ‍್ಹಯಲವಾಲೊ ಚಾ಼ರಾನು ಫುಲ್ಲ ವರಾಯಲ ನಿಂಗತ ವರೈ ಜಾ಼ವಸ. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />ಸುರ್ಯೊ ಆಯಲ್ಪರ ಕಿಮ್ಮ ತಿನಾ ತಡಕಾಕ್ಹು ಝಾಡ ವರೈ ಜಾ಼ವಸ, ಕಿಮ್ಮ ಫುಲ್ಲ ಝಡೈನ ತಿನಿ ಕ್ಹುಬಸುರತಿ ಹಾಳ ಥಾವಸ; ತಿನಾ ನಿಂಗತಜ ಸೌಕಾರ ಕರಾನಾ ಕ್ಹಾರಾ ಕೊಶಿಶೊಮಾ ಹಾರಿಜಾ಼ವಸ.<verse eid="JAS 1:11" /></para>
  <para style="s">ಪರಿಕ್ಷಾ ವರಿ ಶೊದನೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />ಕುನ್ನ ಕಷ್ಟ ತಡ್ದಿಲಿವಸ ಕ್ಹಾವಸ ತೆ ಆಶಿರ್ವಾದ ವ್ಹಂದಿಲಿದಲವಾಲೊ ವ್ಹೈ. ತೆ ಪರಿಕ್ಷಾಮಾತೊ ಭಾರೊ ಆಯಲ್ಪರ ಕರ್ತಾ ತಿನೆ ಮಯಾ ಕರಲವಾಲಾವೊನೆ ಕದಲ ನಿಂಗತಜ಼ ಹಮೆಶಾನು ಜ಼ಲಮನು ಕಿರಿಟ ವ್ಹಂದಿಲಿವಸ. <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />ಕುನ್ನಬಿ ಶೊದನೆಮಾ ಪಡ್ತಾಮಾ ತೆ ಪರಿಕ್ಷಾ ಕ್ಹುದಾಕಂತಿ ಐಸ ಕೈನ ಕೌ ನೈ. ಕಾಕದ್ಯಾಮ ಕ್ಹುದಾ ಕಿನೆಬಿ ಕೆಟ್ಟ ಕರಾನೆ ಕತೊ ನೈ. ವರಿ ತೆ ಕಿನೆಜ಼ ಪಾಪ ಕರಾನೆ ಕೈನ ಪರಿಕ್ಷಾ ಕರತೊ ನೈ. <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />ತೆನೈಸೊ ಹರಯಕ್ಲೊ ತಿನಾ ಕ್ಹುದನಾ ಆಸೊಮಾ ಡುಬಿನ ಮೊಸ ಥೈನ ಪರಿಕ್ಷಾಮಾ ಪಡಸ. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />ತೆ ಆಸೊ ಪುರಾ ಪಾಪ ಕರಾನೆ ಲಿನ ಜಾ಼ವಸ. ತೆ ಪಾಪೊ ಜಾಸ್ತ ಥಾತಾ ಮರಣನೆ ಲಿಂಜಾ಼ವಸ.<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />ಮಾರಾ ಮಯಾನಾ ಭಾಯೊ ಭೆನೊ, ಮೊಸಮಾ ಪಡೊ ನಕೊ. <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />ಎ ಕ್ಹಾರಾ ಚೊ಼ಕಾ ವರಾ ವರಿ ಸುಜ಼ ಕಮ್ಮ ನೈ ರ‍್ಹಯಲ ವರಾ ಉಪ್ಪರತಾ ಆಯಲ ವ್ಹೈ, ತೆ ಕ್ಹಾರಾ ಚೊ಼ಕಾ ಕಾಮೊನೆ ಕಾರಣ ಥಯಲ ಕ್ಹುದಾ ಕಂತಾ ಆವಸ. ತೆ ಭೌಲಾ ನಿಂಗತ ಬದಲಿ ಥಾವಾಲೊ ನವೈ, ಕೈನ ಫರಿ ಜಾ಼ವಾಲೊಬಿ ನವೈ. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />ಕ್ಹುದಾ ತಿನಾ ಚೊ಼ಕಾ ಚಿತ್ತನಾ ನಿಂಗತ ಕ್ಹರಿನಾ ವಾಕ್ಯಾಕ್ಹು ಅಪ್ನೊಮಾ ಜ಼ಲಮ ದಿದಲಹುತಿ ತೆ ಕರಲ ಹರಯಕ್ಕ ಚಿಜ಼ಮಾ ಅಪೆಜ಼ ಪೈಲಾ ಫಲ ಥಯಾ.<verse eid="JAS 1:18" /></para>
  <para style="s">ಕ್ಹುದಾನಿ ವಾಕ್ಯಾ ಐಕಿನ ತಿನಾ ನಿಂಗತ ಚಾಲಾನೊ ತರಿಕೊ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />ಮಾರಾ ಮಯಾನಾ ಭಾಯೊ ಭೆನೊ, ತುಮೆ ಆಂ ವಾತ ಚೊ಼ಕಿತರಾ ತಿಳ್ದಿಲಿವೊ, ಹರಯಕ್ಲೊ ಕಾನದಿನ ಐಕಾಮಾ ಚುರುಕ ರ‍್ಹವಾದೆ, ಬೊಲಾಮಾ ರ‍್ಹೈನಕಾ ಶಿಟ್ಟ ಕರಾಮಾ ರ‍್ಹೈನಕಾ ತಾಳ್ಮೆಕ್ಹು ವರಿ ನಿದಾನ ರ‍್ಹವಾದೆ. <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />ಕಾಕದ್ಯಾಮ ಮನಕ್ಹ ಶಿಟ್ಟಮಾ ರ‍್ಹತಾಮಾ ಕ್ಹುದಾ ಕವಾನಾ ಚೊ಼ಕಾ ಕಾಮೊ ಕರಾನೆ ಥಾತುಜ಼಼ ನೈ. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />ತಿನಾಹುತಿ ಕ್ಹಾರಾ ಕೆಟ್ಟ ಕಾಮೊ ರ‍್ಹೈನಕಾ ಕ್ಹಾರಾ ಮೊಸನಾ ಕಾಮೊ ರ‍್ಹೈನಕಾ ಛೊಡಿನ ಅಪ್ನಾ ಮನಸೊಮಾ ಬೆರ ಘಾಲಲ ಕ್ಹುದಾನಿ ವಾಕ್ಯ ಘನ್ನಾ ಚೊ಼ಕಾ ಮನಸಕ್ಹು ವಪ್ಪಿಲಿವೊ. ತೆ ತುಮಾರಾ ಆತ್ಮಾವೊನೆ ವಚಾ಼ಡಾಯಕ್ಲಿ ತಾಕತವರ ಛೆ.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />ಕ್ಹುದಾನಿ ವಾಕ್ಯನಾ ನಿಂಗತ ಚಾ಼ಲಾಲಾ ಥೈನ ರ‍್ಹವೊ, ತೆ ಕ್ಹಾಲಿ ಐಕಾಲಾ ಯಕ್ಕಜ಼ ರ‍್ಹೈನ ತುಮೊನೆ ತುಮೆಜ಼ ಮೊಸ ಕರಲಿವೊ ನಕೊ. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />ಕುನ್ನಬಿ ವಾಕ್ಯಾ ಕ್ಹಾಲಿ ಐಕಾಲೊ ರ‍್ಹೈನ ತಿನಾ ನಿಂಗತ ನೈ ಚಾ಼ಲ್ಯೊಮ ತೆ ತಿನು ಮ್ಹೊಡು ಅರಕ್ಹಾಮಾ ದೆಕಾಲಾ ಮನಕ್ಹನಾ ನಿಂಗತ ವ್ಹೈ. <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />ಕಾಕದ್ಯಾಮ ತೆ ತಿನೆ ದೆಕಿನಬಿ ಪಾಚ಼ಲ್ತೊ ತೆ ಕಿಮ್ಮ ಶೆ ಕೈನ ತೆಳಾಮಾಜ಼ ಇಕ್ಹರಿ ಪಡಸ. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />ತೆನೈಸೊ ಅಪೊನೆ ಬಿಡುಗಡೆ ಕರಾನಿ ವಾಕ್ಯಾನೆ ಧ್ಯಾನದಿನ ಒದಿನ, ಶೆಂ ಕರಿಲಿನ ತಿನಾ ನಿಂಗತ ಚಾ಼ಲಾಲೊ, ವಾಕ್ಯಾ ಐಕಿನ ಇಕ್ಹರ‍್ಯಾ ಬಗರ ತಿನಾ ನಿಂಗತ ಚಾ಼ಲ್ತೊ ತಿನಿ ನಡತೆಕ್ಹು, ವರಿ ತಿನಾ ಕಾಮೊಕ್ಹು ಧನ್ಯ ಥಾವಸ.<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />ತಿನೆ ತೆ ಚೊ಼ಕೊ ಭಕ್ತ ವ್ಹೈ ಕೈನ ಕವೈಲಿವಾಲೊ ಕಯೊಬಿ ತಿನಿ ಜಿಬ್ಬ ತಿನಾ ಹತೊಟಿಮಾ ಮುಕ್ಕಿಲಿದ್ಯಾ ಬಗರ ತಿನಾ ಮನಸನೆ ಮೊಸ ಕರಲೆತೊ ರ‍್ಹಯಾಮ ತಿನಿ ಭಕ್ತಿ ಶಾನಾ ಕಾಮನಿ ನವೈ. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />ಕಸ್ಟಮಾ ರ‍್ಹಯಲ ಕುನ್ನಜ಼ ನೈಸೊವಾಲಾವೊನೆ, ರಾಂಡಿ ಬಾಕ್ಡಿಯೊನೆ ಧೈರ್ಯ ದಿನ ತಿನೆ ಆಂ ದುನಿಯಾಮಾ ಕಯುಜ಼ ದಾಗ ಲಾಗ್ಯಾ ಬಗರ ದೆಕಿಲಿವಾನುಜ಼ ಅಪ್ನೊ ಬಾ ಥಯಲ ಕ್ಹುದಾನಾ ಸನ್ನಿದಿಮಾ ಶುದ್ಧ, ಚೊ಼ಕಿ ರ‍್ಹಯಲ ಭಕ್ತಿ ವ್ಹೈ.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">ಭೆದ ಭಾವನಾಹುತಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />ಮಾರ ಭಾಯೊ ಭೆನೊ, ಮಹಿಮಾ ರ‍್ಹಯಲ ಅಪ್ನೊ ಕರ್ತಾ ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಉಪ್ಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಲವಾಲಾ ತುಮೆ ಯಕ್ಲಾನೆ ಹೆಟಾ ಯಕ್ಲಾನೆ ಉಪ್ಪರ ದೆಕಾಲಾ ರ‍್ಹೌ ನೈ. <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />ಕಿಮ್ಮ ಕದ್ಯಾಮ ಯಕ್ಲೊ ಮನಕ್ಹ ಕ್ಹೊನಾನಿ ಇಟ್ಟಿಯೊ ವರಿ ಚೊ಼ಕಾ ರ‍್ಹಯಲ ವಣ್ಣಾ ಘಾಲ್ಲಿನ ತುಮಾರಾ ಸಬೆಮಾ ಆತಾಮಾ ವರಿ ಯಕ್ಕ ಗರಿಬ ಮನಕ್ಹ ಚೊ಼ಕಾ ನೈ ರ‍್ಹಯಲ ವಣ್ಣಾ ಘಾಲ್ಲಿನ ಆತಾಮಾ, <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />ತುಮೆ ಚೊ಼ಕಾ ದಿಕ್ಹಾನಾ ವಣ್ಣಾ ಘಾಲ್ಲಿದಲವಾಲಾನೆ ಮರ್ಯಾದಿಕ್ಹು ದೆಕಿನ ತಿನೆ - ಆ ಉಪ್ಪರ ಬೈಟಾ ವರಿ ಗರಿಬನೆ ದೆಕಿನ ತು ತ್ಯಾ ಬೈಟ, ನೈತೊ ಹೆಟೊ ಬೈಟ ಕೈನ ಕದ್ಯಾಮ, <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />ತುಮೆ ತುಮಾರಾ ತುಮಾರಾಮಾಜ಼ ಭೆದ ಭಾವ ಕರಾಲಾ ಥೈನ, ಯಕ್ಲಾನೆ ಅಮ್ಮ ಯಕ್ಲಾನೆ ತಿಮ್ಮ ಕೈನ ವಿಚಾರ ಕರಾಲಾ ಥಾವೊಶಿ ಸು ನೈ?<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />ಮಾರಾ ಮಯಾನಾ ಭಾಯೊ ಭೆನೊ, ಐಕೊ ಕ್ಹುದಾ ಆಂ ದುನಿಯಾಮಾ ರ‍್ಹಯಲ ಗರಿಬೊನೆ ಬರೊಕ್ಹಾಮಾ ಸೌಕಾರ ವರಿ ತಿನೆ ಮಯಾ ಕರಾಲಾವಾಲಾವೊನೆ ತೆ ಕದಲ ತಿಮ್ಮ ತಿನಾ ರಾಜ್ಯಮಾ ಕೆಳಾಮಾಬಿ ರ‍್ಹವಾನೆ ಇನಿಲಿದ್ಯೊಸ ಸು ನೈ? <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />ತುಮೆತೊ ಗರಿಬೊನೆ ಮರ್ಯಾದಿ ನೈಸೊ ಕರ‍್ಯಾ. ತುಮೊನೆ ತ್ರಾಸ ಕರಿನ ಫೈಸಲೊ ಕರಾನಿ ಜ಼ಗಾ ಎಳದಿನ ಲಿನ ಜ಼ಾವಾಲಾ ಸೌಕಾರೊ ನ್ಹವೈ ಸು? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />ತುಮೊನೆ ಬಲಾಯಲ ತೆ ಕ್ಹಾರವೊತಿ ಉಪ್ಪರ ರ‍್ಹಯಲ ನಾಮನೆ ಕ್ಹರಾಪಾಲಾ ನವೈ ಸು?<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />ರ‍್ಹೈತಬಿ ಪವಿತ್ರ ಗ್ರಂಥಮಾ ರ‍್ಹಯಲ ನಿಂಗತ ತಾರಾ ಬಾಜು಼ ಘರವಾಲಾನೆ ತು ತುನೆ ಕಿಮ್ಮ ಮಯಾ ಕರಶಿ ತಿನಾ ನಿಂಗತ ಮಯಾ ಕರು ಕೈನ ಕವಾನಿ ಮ್ಹೊಟಿ ಆಗ್ಯಾನಾ ನಿಂಗತ ಚಾ಼ಲ್ಯಾರೆ, ತುಮೆ ಚೊ಼ಕು ಕರಾಲಾ ಥಾವೊಶಿ. <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />ತೆನೈಸೊ ತುಮೆ ಆಂ ಛೊಡಿನ ಯಕ್ಲಾನೆ ಉಪ್ಪರ ಯಕ್ಲಾನೆ ಹೆಟಾ ದೆಕ್ಯಾಮ ಪಾಪ ಕರಾಲಾ ಥೈನ ವರಿ ತುಮೆ ಅಪರಾದಿ ವ್ಹೈ ಕೈನ ಪವಿತ್ರ ಗ್ರಂಥನಾ ನಿಂಗತ ತುಮೊನೆ ಫೈಸಲೊ ಥಾವಸ.<verse eid="JAS 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 2:10" />ಕಾಕದ್ಯಾಮ ಯಕ್ಲೊ ಪವಿತ್ರ ಗ್ರಂಥಮಾ ರ‍್ಹಯಲ ಪುರಾ ಚಾ಼ಲಿನ ಗೈನ ಕ್ಹಾಲಿ ಯಕ್ಕಮಾ ಚು಼ಕ್ಯೊಮ ತೆ ಕ್ಹಾರಾ ವಿಶಯಮಾ ಅಪರಾದಿ ಥಾವಸ. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />ಕಾಕದ್ಯಾಮ ವ್ಯಬಿಚಾರ ಕರು ನೈ ಕೈನ ಕದಲವಾಲೊಜ಼ ಯಕ್ಲಾನೆ ಖಲಾಸ ಕರು ನೈ ಕೈನಬಿ ಕದ್ಯೊಸ. ತಿನಾಹುತಿ ತು ವ್ಯಬಿಚಾರ ಕರ‍್ಯಾ ಬಗರ ರ‍್ಹೈತಬಿ ಯಕ್ಲಾನೆ ಖಲಾಸ ಕರಲ ರ‍್ಹಯಾರೆ ಪವಿತ್ರ ಗ್ರಂಥನಾ ವಿರುದ್ದ ಗಯಲ ನಿಂಗತ ವ್ಹೈ. <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />ತುಮೆ ಅಪೊನೆ ವಚಾ಼ಡಾನಾ ಪವಿತ್ರ ಗ್ರಂಥನಾ ನಿಂಗತ ಫೈಸಲೊ ವ್ಹಂದಿಲಿವಾಲಾವೊನೆ ತ್ಯುನಾ ನಿಂಗತಜ಼ ಬೊಲೊ ವರಿ ವಿಧೆಯ ಥಾವೊ. <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />ಕಾಕದ್ಯಾಮ ಮರಗಾ ನೈ ದೆಕಾಡಾಲಾನೆ ಫೈಸಲಾನಾ ದಿನ್ನೆ ಮರಗಾ ನೈ ದೆಕಾಡತಾ. ಮರಗಾ ನ್ಯಾಯ ಫೈಸಲಾನಾ ದಿನ್ನನಾ ಉಪ್ಪರ ಝಿತ್ತಸ.<verse eid="JAS 2:13" /></para>
  <para style="s">ಬರೊಕ್ಹೊ ಯಕ್ಕಜ಼ ನೈ ಚಾ಼ಲ್ತೊ ತಿನಾ ನಿಂಗತ ಚಾಲು ಕವಾನಿ ಬೊದನೆ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />ಮಾರಾ ಭಾಯೊ ಭೆನೊ, ಯಕ್ಲೊ ತಿನೆ ಬರೊಕ್ಹೊ ಛೆ ಕೈನ ತಿನಾ ನಿಂಗತ ತಿಮಾ ಕ್ರಿಯೆ ನೈ ರ‍್ಹಯಾರೆ ಸು ಉಪಯೊಗ ವ್ಹೈ? ತೆ ಬರೊಕ್ಹೊ ತಿನೆ ವಚಾ಼ಡಸ ಸು? <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />ತುಮೊಮಾ ಯಕ್ಲಾ ಭೈನೆ ನೈತೊ ಯಕ್ಲಿ ಭೆನನೆ ಘಾಲ್ಯಾನೆ ವಣ್ಣಾ ವರಿ ತೆ ದಿನ್ನನು ಅನ್ನ ಚಾ಼ಯೆ ಥಯಲ ವಕ್ಹತಮಾ, <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />ತುಮೊಮಾನೊ ಯಕ್ಲೊ ತಿನೆ ತೆ ಕ್ಹಾರು ದಿದ್ಯಾ ಬಗರ ಸಮಾಧಾನಕ್ಹು ಜಾ಼ವೊ, ಆಗ ಶೆಕಿಲಿವೊ, ಪೆಟ ಭರಿನ ಕ್ಹಾವೊ ಕೈನ ಕದ್ಯಾಮ ಸು ಉಪಯೊಗ ವ್ಹೈ? <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />ತಿನಾ ನಿಂಗತ ಕ್ರಿಯೆ ನೈಸೊ ಬರೊಕ್ಹೊ ಮರಲ ನಿಂಗತಜ಼ ವ್ಹೈ.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />ರ‍್ಹೈತಬಿ ಯಕ್ಲೊ; ತುನೆ ಬರೊಕ್ಹೊ ಛೆ ವರಿ ಮಾರಾಮಾ ಕ್ರಿಯೆ ಛೆ ತು ತಾರಾಮಾ ಕ್ರಿಯೆ ನೈಸೊ ಬರೊಕ್ಹೊ ದೆಕಾಡ. ಮಿ ಮಾರಾ ಕ್ರಿಯೆಕ್ಹು ಬರೊಕ್ಹೊ ದೆಕಾಡುಸ ಕೈನ ಕತೊ ನೈ ಸು? <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />ಕ್ಹುದಾ ಯಕ್ಲೊಜ಼ ವ್ಹೈ ಕೈನ ತು ಬರೊಕ್ಹೊ ಕರಶಿ ಸು? ತು ಬರೊಕ್ಹೊ ಕರಲ ಕರೆಟ್ಟ ವ್ಹೈ. ತೆನೈಸೊ ಭುತ್ಡಾಬಿ ತಿನಾ ನಿಂಗತಜ಼ ತಿಳ್ದಿನ ಬುಚ್ಕಿನ ಕಾಪಸ.<verse eid="JAS 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 2:20" />ಗ್ಯಾನ ನೈಸೊವಾಲಾ, ಕ್ರಿಯೆ ನೈಸೊ ಬರೊಕ್ಹೊ ಶಾನಾಜ಼ ಕಾಮೆ ಆತೊ ನೈ ಕೈನ ತುನೆ ಸಾಬಿತ ಕರು ಸು? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />ಅಪ್ನೊ ಪಿತೃ ಥಯಲ ಅಬ್ರಹಾಮ ತಿನೊ ದಿಕ್ರೊ ಥಯಲ ಇಸಾಕನೆ ಬಲಿ ದೆತಾಮಾ ಕ್ಹರಿಕ್ಹು ರ‍್ಹಯಲವಾಲೊ ವ್ಹೈ ಕೈನ ಕೈಲಿದಲ ತಿನಾ ಕ್ರಿಯೆಕ್ಹುಜ಼ ವ್ಹೈ ಸು ನೈ? <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />ತಿನೊ ಬರೊಕ್ಹೊ ಕ್ರಿಯೆಕ್ಹುಜ಼ ಕಾಮ ಕರ‍್ಯುತು ವರಿ ತಿನಾ ಕ್ರಿಯೆಕ್ಹುಜ಼ ತಿನಾ ಬರೊಕ್ಹಾನು ಉದ್ದೆಶ ಪುರಾ ಥಯು ಕೈನ ದೆಕೆಸತೊ. <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />ಅಬ್ರಹಾಮ ಕ್ಹುದಾಪರ ಬರೊಕ್ಹೊ ಕರ‍್ಯೊ, ತೆ ಬರೊಕ್ಹೊಜ಼ ತಿನಾ ಹಿಸಾಬಮಾ ನಿತಿ ವ್ಹೈ ಕೈನ ಕವೈಲಿವಾ ವರಕ್ಹು ಛೆ ಕವಾನು ಪವಿತ್ರ ಗ್ರOಥಮಾ ಬರ್ದಲ ತಿಮ್ಮ ಪುರಾ ಥಯು. ತಿನಾಹುತಿ ಅಬ್ರಹಾಮ ಕ್ಹುದಾನೊ ದೊಸ್ತ ವ್ಹೈ ಕೈಲಿದ್ಯೊ. <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />ತಿನಾಹುತಿ ಮನಕ್ಹ ತೆ ಚಾ಼ಲಾಕ್ಹು, ತಿನಾ ಕಾಮೊಕ್ಹು ಚೊ಼ಕೊ ವ್ಹೈ ಕೈನ ಕವೈಲಿವಸ. ಕ್ಹಾಲಿ ಬರೊಕ್ಹಾಕ್ಹು ಯಕ್ಕಜ಼ ನ್ಹವೈ ಕೈನ ದೆಕೊಶಿ.<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />ತಿನಾ ನಿಂಗತಜ಼ ಕೆಟ್ಟ ಕಾಮೊ ಕರಾಲಿ ರಾಹಾಬ ಕ್ಹಬಿರಿಯೊನೆ ತಿನಾ ಘರ್ಮಾ ಬಲೈಲಿನ ಮ್ಹೆಲಿನ, ತ್ಯುನೊನೆ ಬಿಜಾ಼ ವಾಟತಿ ವಳೈನ ತಿನಾ ತೆ ಕಾಮೊಕ್ಹುಜ಼ ಚೊ಼ಕಿ ವ್ಹೈ ಕೈನ, ತಿನೆ ಫೈಸಲೊ ಥಯೊ ನ್ಹೊತೊ ಸು?<verse eid="JAS 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26" />ಆತ್ಮಾ ನೈಸೊ ಕಿಮ್ಮ ಅಂಗ ಮರ‍್ಯುಸ ತಿನಾ ನಿಂಗತ ಕ್ರಿಯೆ ನೈಸೊ ಬರೊಕ್ಹೊ ಮರಲ ನಿಂಗತ ವ್ಹೈ.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">ಜಿಬ್ಬ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />ಮಾರಾ ಭಾಯೊ ಭೆನೊ, ಭೊದಕ ಥಯಲ ಹಮೊನೆ ಘನ್ನು ಖತರನಾಕ ಫೈಸಲೊ ಥಾವಸ ಕೈನ ತುಮೆ ತಿಳ್ದಿಲಿನ ಘನ್ನಾ ಜ಼ನಾ ಬೊದಕ ಥಾವೊ ನಕೊ. <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />ಅಪೆ ಕ್ಹಾರಾ ಜ಼ನಾ ಘನ್ನಾ ವಿಶಯಮಾ ತಪ್ಪ ಕರಾಲಾ ಥಯಾಸ. ಯಕ್ಲೊ ವಾತಮಾ ತಪ್ಪ ಕರ‍್ಯಾವಾಚಿ ನೈ ಚಾ಼ಲ್ಯೊಮ ತೆ ಕ್ಹಾರಿ ತರಾಮಾ ಚೊ಼ಕೊ ರ‍್ಹಯಲವಾಲೊ ತಿನಿ ಪುರಾ ಅಂಗನೆ ಹತೊಟಿಮಾ ಮುಕ್ಕಿಲಿವಾನೆ ಯೊಗ್ಯ ಥಯೊಸ. <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />ಘೊಡಾ ಅಪ್ನಿ ಇಚ್ಛಾ ನಿಂಗತ ಚಾ಼ಲಾನೆ ತ್ಯುನಾ ಮ್ಹೊಡಾನೆ ಲಗಾಮ ಘಾಲೆಸ. ತೆಳಾಮಾ ತ್ಯುನಾ ಪುರಾ ಅಂಗನೆ ಅಪೊನೆ ಚಾ಼ಯೆ ಥಯಲ ಜ಼ಗಾಯೆ ಫರಾವಾನೆ ಥಾವಸ. <figure style="fig" alt="Rider on a horse" file="lb00035c.tif" size="col" copy="Horace Knowles ©" ref="3:3">ಘೊಡಾನಿ ಸವಾರಿ</figure><verse eid="JAS 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 3:4" />ಹಡಗಾನೆಬಿ ದೆಕೊ. ತೆ ಘನ್ನಾ ಮ್ಹೊಟಾ ರ‍್ಹಯಾತಬಿ ಜೊ಼ರ ವಾರಾಕ್ಹು ವಾಟ ಚು಼ಕಸ. ರ‍್ಹೈತಬಿ ಹಡಗಾನೆ ಚ಼ಲಾವಾಲೊ ಘನ್ನಿ ನ್ಹಾನಿ ಚುಕ್ಕಾಣಿಕ್ಹು ತೆ ಜಾ಼ವಾನಿ ಜ಼ಗಾಕನ ಫರಾವಸ. <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />ತಿನಾ ನಿಂಗತಜ಼ ಜಿಬ್ಬಬಿ ಅಪನು ಶರಿರಮಾನು ನ್ಹಾನು ಅಂಗ ರ‍್ಹೈತಬಿ ಘನ್ನಾ ಮ್ಹೊಟಾ ವಾತೊ ಬೊಲಸ,</para>
  <para style="p" vid="JAS 3:5">ಮಿಜ಼ ವ್ಹೈ ಕೈನ ಕವಸ. ಆಗನಿ ನ್ಹಾನಿ ಚಿಣಕಿ ಮ್ಹೊಟಾ ರಾನನೆ ಬಾಳಸ. <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />ಜಿಬ್ಬಬಿ ಆಗಜ಼ ವ್ಹೈ. ಜಿಬ್ಬ ಧರಮ ನೈ ರ‍್ಹಯಲ ಲೊಕನಾ ನಿಂಗತ ಅಪ್ನಾ ಅಂಗೊನಾ ವಚ್ಮಾ಼ ಮ್ಹೆಲಲ ಛೆ. ತೆ ಪುರಾ ಅಂಗನೆ ಹಾಳ ಕರಸ. ತೆಜ಼ ನರಕ ಕವಾನಿ ಆಗ ಲಗಾಡಿಲೆತಿ ಪುರಾ ಜಿಂದಗಿನೆ ಆಗ ಲಗಾಡಸ. <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />ಜಂಗಲಿ ಜಾನವರೊ, ಪಕ್ಷಿಯೊ, ಫರಾನಾ ಕಿಡಾ ವರಿ ಮಚ್ಲಿಯೊನೆ ಅಪೆ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ತರಾನಾ ಜಾನವರೊನೆ ಹತೊಟಿಮಾ ಕರ‍್ಯಾಸ ವರಿ ಕರ ಸಕೆಸ.<verse eid="JAS 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 3:8" />ತೆನೈಸೊ ಜಿಬ್ಬನೆ ಕಯೊ ಮನಕ್ಹ ಹತೊಟಿಮಾ ನೈ ಲಾತೊ. ತೆ ಗಪ್ಪ ನೈ ರ‍್ಹವಾನು ಕೆಟ್ಟ ಅಂಗ ಥಯುಸ. ತೆ ಮರಣನಾ ಜಹೆರಕ್ಹು ಭರ‍್ಯುಸ. <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />ತೆಜ಼ ಜಿಬ್ಬಕ್ಹು ಅಪ್ನೊ ಪ್ರಭು ವರಿ ಬಾನೆ ಕೊಂಡಾಡೆಸ, ತಿನಾಹುತಿಜ಼ ಕ್ಹುದಾನಾ ನಿಂಗತ ಸೃಷ್ಟಿ ಕರಲ ಮನಕ್ಹೊನೆ ಅಪೆ ಕ್ಹರಾಪೆಸ. <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />ತೆಜ಼ ಮ್ಹೊಡಾಕ್ಹು ಸ್ತುತಿ ವರಿ ಕ್ಹರಾಪ ಭಂಬಿ ಆವಸ. ಮಾರಾ ಭಾಯೊ ಭೆನೊ, ಇಮ್ಮ ಥೌ ನೈ. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />ಯಕ್ಕಜ಼ ಇರಮಾತಾ ಗಳು ಪಾನಿ ವರಿ ಕಡು ಪಾನಿ ಭಂಬಿ ಆ ಸಕಸ ಸು. <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />ಮಾರಾ ಭಾಯೊ ವರಿ ಭೆನೊ, ಉಂಬ್ರೊನು ಝಾಡ ಆಲಿವ ತೆಲನಾ ಝಾಡೊನು ಫಲೊ ದಿವಸ ಸು? ದ್ರಾಕ್ಷಿಯೊನು ಝಾಡ ಉಂಬ್ರೊನಾ ಫಲೊ ದಿವಸ ಸು? ತಿಮ್ಮಜ಼ ಮಿಟ್ಟಾನಾ ಪಾನಿನಾ ಇರಮಾತು ಗಳು ಪಾನಿ ಆತು ನೈ.<verse eid="JAS 3:12" /></para>
  <para style="s">ಕ್ಹರಿನು ಗ್ಯಾನ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />ಅಪ್ನಾಮಾ ಶಾಣ್ಯೊ ವರಿ ಗ್ಯಾನಿ ಕುನ್ನ ವ್ಹೈ? ಕುನ್ನಬಿ ರ‍್ಹಯಾಮ ತೆ ತಿನಾ ಚಾಳಿಯೊಕ್ಹು ದೆಕಾಡಾದೆ. ಸಮಾದಾನ ಶಾಂತಿಕ್ಹು ನ್ಹಾನೊ ಥೈನ ಜಾ಼ವಾನುಜ಼ ಶಾಣ್ಯಾನಿ ಚಾಳಿ ವ್ಹೈ. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />ತಿನಾಹುತಿ ತುಮಾರಾ ಮನಸೊಮಾ ಮತ್ಸರ, ಸ್ವಾರ್ಥ, ತುಮಾರಾಜ಼ ಹುತಿ ವಿಚಾರೊ ಭರಲಿದ್ಯಾರೆ ತುಮೊನೆ ತುಮೆ ಶ್ಯಾನಾ ವ್ಹೈ ಕವೊ ನಕೊ, ಕ್ಹರಿನೆ ವಿರುದ ರ‍್ಹಯಲ ಸುಳ್ಳ ಬೊಲಿನ ಹೊಗಳಿ ಲಿವೊ ನಕೊ. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />ತೆ ತುಮೊಕಂತು ಆಯಲ ಗ್ಯಾನ ನ್ಹವೈ. ತೆ ಲೊಕನೆ ಸಂಬಂದ ರ‍್ಹಯಲ ವ್ಹೈ, ಲೌಕಿಕ ರ‍್ಹಯಲ ವ್ಹೈ, ಭುತ್ಡಾವೊನೆ ಸಂಬಂದ ರ‍್ಹಯಲ ವ್ಹೈ.<verse eid="JAS 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 3:16" />ಮತ್ಸರ, ಸ್ವಾರ್ಥ ರ‍್ಹವಾನಿ ಜ಼ಗಾ ಲಡೈಯ್ಯೊ, ವರಿ ಘನ್ನಾ ತರಾನಾ ಕೆಟ್ಟ ಕಾಮೊ ರ‍್ಹವಸ. <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />ತೆನೈಸೊ ಉಪ್ಪರತಿ ಆವಾನಿ ಗ್ಯಾನ ಪೈಲಾ ಪರಿಶುದ್ದ ರ‍್ಹಯಲ ವ್ಹೈ ವರಿ ಸಮಾಧಾನ ರ‍್ಹಯಲ ವ್ಹೈ, ವಿನಯ ರ‍್ಹಯಲ ವ್ಹೈ, ವಿದೆಯತೆಕ್ಹು ರ‍್ಹಯಲ ವ್ಹೈ, ಮರ್ಗಾ ವರಿ ಚೊ಼ಕಾ ಫಲೊಕ್ಹು ಭರಲ ವ್ಹೈ, ಬೆದ ಭಾವ ನೈ ರ‍್ಹಯಲ ವ್ಹೈ, ಇಮಾಂದಾರಿಕ್ಹು ರ‍್ಹಯಲ ವ್ಹೈ ಕೈನ ಕ್ಹುಶಿಕ್ಹು ವಪ್ಪಿಲಿವಾನು ಥಯುಸ. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />ಸಮಾದಾನ ಕರಾಲಾ ಸಮಾದಾನ ಕವಾನಾ ಬಿಯ್ಯಾನೆ ಬಿತ್ತಿನ ನಿತಿ ಕವಾನು ಫಲ ಕಾಟಸ.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">ಲಡೈಕೊರ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />ತುಮೊಮಾ ಲಡೈಯ್ಯೊ, ಕಿತ್ತಾನು ಕಿಜಾ಼ಂತು ಆವಸ? ತುಮಾರಾ ಇಂದ್ರಿಯೊಕ್ಹು ಆವಾನು ಹೊರಾಡಾನಾ ವಿಚಾರೊಕ್ಹು ಘನ್ನಿ ಆಸಕ್ಹು ಆವಸ. <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />ತುಮೆ ಆಸ ಕರಲ ಪಡ್ದಿಲಿದ್ಯಾ ನತ್ತಿ. ತುಮೆ ಖಲಾಸ ಕರ‍್ಯಾತಬಿ, ಸಂಗಟ ಘಾಲಿಲಿದ್ಯಾತಬಿ ಆಸ ಕರಲ ಲಿದ್ಯಾವಾಚಿ ಛೆ; ತುಮೆ ಕಿತ್ತಾ - ಕಿತ್ತ ಕರೊಶಿ, ಲಡೈ ಕರೊಶಿ. ತೆನೈಸೊ ತುಮೆ ಕ್ಹುದಾಕನ ನೈ ಮಾಂಗಿಲಿದಲಕ್ಹು ತುಮೊನೆ ಸುಜ಼ ಲಿವಾನೆ ಥಾವಾಡು ನತ್ತಿ.<verse eid="JAS 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JAS 4:3" />ತುಮೆ ಮಾಂಗಿಲಿದ್ಯಾತಬಿ ಮಾಂಗಿಲಿದಲ ತುಮಾರಾ ದುನಿಯಾಮಾನಿ ಆಸನಾಹುತಿ ಕೆಟ್ಟ ಉಪಯೊಗ ಕರಿಲ್ಯು ಕವಾನಿ ಕೆಟ್ಟ ಉದ್ದೆಶಕ್ಹು ಮಾಂಗಿಲಿವಾನಾಹುತಿ ತುಮೊನೆ ಮಳಾಡು ನತ್ತಿ. <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />ವ್ಯಭಿಚಾರಿಯೊ, ಎ ದುನಿಯಾನಿ ದೊಸ್ತಿ ಕ್ಹುದಾನೆ ದುಶ್ಮನ ವ್ಹೈ ಕವಾನು ತುಮೊನೆ ಗ್ವತ್ತ ನತ್ತಿ ಸು? ತಿನಾಹುತಿ ದುನಿಯಾನೆ ದೊಸ್ತ ಥೈನ ರ‍್ಹೌಸ ಕವಾಲೊ ತಿನೆ ಕ್ಹುದಾನೊ ವಿರೊದಿ ಥೈನ ಕರಿಲಿವಸ. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />ಕ್ಹುದಾ ಅಪೊಮಾ ಮ್ಹೆಲಾನಿ ಪವಿತ್ರ ಆತ್ಮಾ ಅಭಿಮಾನ ಆಸನಾ ಕ್ಹಾತೆ ಅಪ್ನಾಹುತಿ ಆಸ ಕರಸ ಕವಾನಿ ವಾತ ಸುಳ್ಳ ವ್ಹೈ ಕೈನ ಪವಿತ್ರ ಗ್ರಂಥ ಕವಸ ಕೈನ ತಿಳ್ದಿಲಿವೊ ನಕೊ. <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />ತೆ ಅಪೊನೆ ಘನ್ನಿ ಕೃಪಾ ದಿವಸ. ತಿನಾಹುತಿ, ಕ್ಹುದಾ ಅಹಂಕಾರಿಯೊನೆ ವಿರುದ್ದ ಥಯೊಸ, ದಿನ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಕೃಪಾ ದಿವಸ ಕೈನ ಧರಮಶಾಸ್ತ್ರ ಕವಸ.<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಕ್ಹುದಾನೆ ಅದಿನ ಥೈನ ರ‍್ಹೈನ ಸೈತಾನನೆ ಭುಚ್ಕಾಡೊ, ತೆಳಾಮಾ ತೆ ತುಮೊನೆ ಛೊಡಿನ ನ್ಹಾಟಿ ಜಾ಼ವಸ. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />ಕ್ಹುದಾನಾ ನಜಿಕ ಆವೊ, ತೆಳಾಮಾ ತೆ ತುಮಾರಾ ನಜಿಕ ಆವಸ. ಪಾಪಿಯೊ, ತುಮಾರಾ ಹತೊ ಶುದ್ದ ಕರಿಲಿವೊ; ಬೆ ಮನಸೊ ರ‍್ಹಯಲವಾಲಾ, ತುಮಾರಾ ಮನಸೊ ಚೊ಼ಕಾ ಕರಿಲಿವೊ. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />ದುಖ ಥಾವೊ, ಗೊಳಾಡೊ, ಡೊಳಾಮಾನು ಪಾನಿ ಕಾಡೊ; ತುಮಾರು ಅಕ್ಹಾನು ಛೊಡಿನ ಪ್ರಭುನಿ ಕೃಪಾನಾಹುತಿ ಗೊಳಾಡಿನ ಮಾಂಗಿಲಿವೊ. ತುಮಾರಿ ಲೌಕಿಕ ಕ್ಹುಶಿನೆ ಛೊಡಿನ ಪ್ರಭುನೆ ಪಡ್ದಿಲಿವಾನು ಕೊಶಿಶ ಕರೊ. <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />ಪ್ರಭುನಾ ಕ್ಹಾಮಾ ತುಮೊನೆ ತುಮೆ ತಗಸಿಲಿವೊ; ತೆ ತುಮೊನೆ ಉಪ್ಪರ ಉಚಾವಸ.<verse eid="JAS 4:10" /></para>
  <para style="s">ಮಿ ಕೈನ ಕವೈಲಿವಾನಾಹುತಿ ಹುಶಾರಕಿ</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />ಭಾಯೊ ವರಿ ಭೆನೊ, ಯಕ್ಕನೆ ಯಕ್ಕ ದುಖ ಕರೊ ನಕೊ. ಕುನ್ನತುಬಿ ತಿನಾ ಭೈನೆ ದುಖ ಕರ‍್ಯಾಮ ನೈತೊ ತಿನಾ ಭೈನಾ ವಿಷಯನಾಹುತಿ ತಿರ್ಪ ಕರ‍್ಯೊಮ ತೆ ಧರಮಶಾಸ್ತ್ರನೆ ದುಖ ಕರಿನ ಧರಮಶಾಸ್ತ್ರನಾ ವಿಷಯಮಾ ತಿರ್ಪ ಕರಲ ನಿಂಗತ ಥಾವಸ. ತೆನೈಸೊ ತು ಧರಮಶಾಸ್ತ್ರನಾ ವಿಷಯಮಾ ತಿರ್ಪ ಕರ‍್ಯೊಮ ತು ನ್ಯಾಯಾದಿಪತಿ ವ್ಹೈ ಕೈನ ಕವೈಲೆಶಿ. ತೆನೈಸೊ ತಿನೆ ಚಾ಼ಲಿನ ಜಾ಼ವಾಲೊ ಥಾತೊ ನೈ. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />ಧರಮಶಾಸ್ತ್ರ ದಿದಲ ನ್ಯಾಯಾದಿಪತಿ ಯಕ್ಕಜ಼ ವ್ಹೈ; ತೆಜ಼ ವಚಾ಼ಡಾನೆಬಿ ವರಿ ನಾಶ ಕರಾನೆಬಿ ತಾಕತವಾಲೊ ವ್ಹೈ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ ತಾರಾ ಬಾಜು಼ನಾ ಮನಕ್ಹನಾ ವಿಷಯಮಾ ತಿರ್ಪ ಕರಾನೆ ತು ಕುನ್ನ ವ್ಹೈ?<verse eid="JAS 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />ಹಮ್ನಾ ನೈತೊ ವಂತಾ ಅಪೆ ಹೆವಾ ಗಾಮೆ ಗೈನ ತ್ಯಾ ಯಕ್ಕ ವರಕ್ಹ ರ‍್ಹೈನ ವ್ಯಾಪಾರ ಕರಿನ ಫೈದೊ ಕರಿಲಿಯೆಸ ಕವಾಲಾ ಐಕೊ. <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />ವಂತಾ ಸು ಥಾವಸ ಕವಾನು ತುಮೊನೆ ಗ್ವತ್ತ ನತ್ತಿ. ತುಮಾರಿ ಜಿವ್ನಾ ಕೆವಿ ವ್ಹೈ? ತುಮೆ ದಕ್ಹಿಯೆಳ ದಿಕ್ಹಿನ ಪಾಚ಼ಲ್ತಾ ನೈ ದಿಕ್ಹಾನಿ ಠಾರ ನಿಂಗತ ಥಯಾಸ. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />ತಿನಾಹುತಿ ತುಮೆ ತ್ಯವಾ ವಾತೊ ಛೊಡಿನ ಕ್ಹುದಾನಿ ಚಿತ್ತ ರ‍್ಹಯುಮ ಅಪೆ ಜಿವ್ತಾ ರ‍್ಹೈನ ಎ ಕಾಮ ರ‍್ಹವಾದೆ ತೆ ಕಾಮ ರ‍್ಹವಾದೆ ಕರ ಸಕೆಸ ಕೈನ ಕೌ. <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />ತೆನೈಸೊ ತುಮೆ ತುಮಾರಾ ಅಹಂಕಾರಕ್ಹು ತುಮಾರಾಹುತಿ ಹೊಗಳಿ ಲಿವಾಡಾಸ. ತ್ಯವಿ ಹೊಗಳಕಿ ಕ್ಹಾರಿ ಕ್ಹುದಾನಾ ಕ್ಹಾಮಿ ಕೆಟ್ಟಜ಼ ವ್ಹೈ. <figure style="fig" alt="Customer, merchant with his wares" file="hk00172c.tif" size="col" copy="Horace Knowles ©" ref="4:13">ವ್ಯಾಪಾರ ಕರಾಲೊ ವರಿ ಲಿವಾಲೊ ವರಿ ತಿನಾ ಸಾಮನೊ.</figure><verse eid="JAS 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17" />ಇಮ್ಮ ರ‍್ಹಯಲಕ್ಹು ಚೊ಼ಕು ಕರು ಕವಾನು ಗ್ವತ್ತ ರ‍್ಹಯುತಬಿ ತೆ ನೈ ಕರಾಲೊ ಪಾಪ ಕರಾಲೊ ಥಯೊಸ.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">ಸೌಕಾರೊನಾ ನಡತೆಕ್ಹು ಹುಶಾರ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />ಸೌಕಾರೊ, ತುಮೊನೆ ಆವಾನಾ ತ್ರಾಸೊನಾಹುತಿ ರವೊ, ಗೊಳಾಡೊ. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />ತುಮಾರಿ ಆಸ್ತಿ, ದೌಲತ ನಾಶ ಥೈಸ. ತುಮಾರಾ ವಣ್ಣಾವೊನೆ ನುಶಿ ಲಾಗಿಸ. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />ತುಮಾರು ಕ್ಹೊನು, ರುಪ್ಪು ಜಂಗ ಲಾಗಿನ ಮಾತಿನೆ ಸಂವಾ ಥಯುಸ. ತ್ಯುನು ಜಂಗ ತುಮೊನೆ ವಿರುದ್ದ ಸಾಕ್ಷಿ ಥೈನ, ಆಗ ನಿಂಗತ ತುಮಾರಾ ಮಾಕ್ಹನೆ ಬಾಳಿ ಪಡಸ. ಅಂತ್ಯ ಕಾಲ ಅಯುತುಬಿ ಆಸ್ತಿ ಜ಼ಮಾ ಕರಿಲಿನ ಮ್ಹೆಲಿ ಲಿದ್ಯಾಸ.<verse eid="JAS 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 5:4" />ದೆಕೊ, ತುಮಾರಾ ಖೆತರೊಮಾ ಕಾಮ ಕರಲವಾಲಾವೊನೆ ಹಮಾಲಿ ದಿದ್ಯಾಬಗರ ಮೊಸ ಕರ‍್ಯಾಸ. ತೆ ಹಮಾಲಿನು ಅವಾಜ಼ ವರಿ ಕಾಮ ಕರಲವಾಲಾವೊನು ಅವಾಜ಼ ಸ್ವರ್ಗನಾ ಸೈನ್ಯನೊ ಸೆನಾದಿಶ್ವರ ಥಯಲ ಕರ್ತಾನಾ ಕಾನೊಪರ ಗೈನ ಮುಟ್ಟಿಸ. <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />ಭುಲೊಕಮಾ ತುಮೆ ಸುಖಾ ಕ್ಹಾವಾನಾಹುತಿ ತುಮೊನೆ ಪಸಂದ ಆಯಲ ತಿಮ್ಮ ಜಿವ್ನಾ ಕರಾಡಾಸ; <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />ತುಮೆ ಚೊ಼ಕಾ ಮನಕ್ಹೊನೆ ಶಿಕ್ಷಾ ದಿದ್ಯಾಸ. ತ್ಯುನೆ ತುಮೊನೆ ವಿರುದ ನೈ ರ‍್ಹಯಾತಬಿ ತ್ಯುನೊನೆ ಕ್ಹಲಾಸ ಕರ‍್ಯಾ.<verse eid="JAS 5:6" /></para>
  <para style="s">ತ್ರಾಸ ಖಾವಾಲಾ ಕ್ರೈಸ್ತರೊನೆ ಪ್ರೊತ್ಸಾಹ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />ಭಾಯೊ ಭೆನೊ, ತಾಳ್ಮೆಕ್ಹು ರ‍್ಹವೊ, ಪ್ರಭು ಥಯಲ ಯೆಸು ಆವಸ. ತಿನಾಹುತಿ ತ್ಯಾ ಲಕ್ಕಾ ತಾಳ್ಮೆಕ್ಹು ರ‍್ಹವೊ. ತಿನಿ ಅಮುಲ್ಯ ಕಿಮ್ಮತ ಜಿಮಿನತಿ ಆಯೆಲಕ್ಕಾ ರೈತ ತಾಳ್ಮೆಕ್ಹು ಕೈದಸ. ಪಸ್ಟನು ವರಿ ಲಾಸ್ಟನು ಪಾನಿ ತಿನಾ ಫಸಲನಾ ಉಪ್ಪರ ಪಡೆಲಕ್ಕಾ ರೈತ ತಾಳ್ಮೆಕ್ಹು ಕೈದಲ ರ‍್ಹವಸ. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />ತುಮೆ ತಾಳ್ಮೆಕ್ಹು ರ‍್ಹೌ. ತುಮಾರಿ ನಿರಿಕ್ಷೆ ಛೊಡೊ ನಕೊ. ಪ್ರಭು ಯೆಸು ಜಲ್ದಿ ಆವಾನೊ ಛೆ.<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />ಭಾಯೊ ಭೆನೊ, ಯಕ್ಕನಾ ಉಪ್ಪರ ಯಕ್ಲಾ ತಪ್ಪ ಕವೊ ನಕೊ. ತುಮೆ ತಪ್ಪ ಕವಾನು ನೈ ಹುಬ್ರಾಡ್ಯಮ ದೊಶಿಯೊ ಕೈನ ತುಮೊನೆ ತಿರ್ಪ ಕರಸ. ಫೈಸಲೊ ಕರಾಲೊ ಆವಾನೆ ತಯ್ಯಾರ ಥಯೊಸ. <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />ಭಾಯೊ ಭೆನೊ, ಪ್ರಭುನಿ ವಿಷಯಮಾ ಕದಲ ಪ್ರವಾದಿಯೊ ತುಮೊನೆ ಮಾದರಿ ಥೈನ ರ‍್ಹವಾದೆ. ತ್ಯುನೆ ಘನ್ನಾ ತರಾನಾ ತ್ರಾಸೊ ಖಾದ್ಯಾತಬಿ ತಾಳ್ಮೆಕ್ಹು ವ್ಹತ್ತು. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />ತಡ್ದಿಲಿನ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಧನ್ಯ ವೈ ಕೈನ ಕಯೆಸ ನೈ. ಯೊಬನಿ ತಾಳ್ಮೆನಾಹುತಿ ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. ಯೊಬ ಕ್ಹಾರಾ ತರಾನಾ ತ್ರಾಸೊ ಖಾದಲ್ಪರ ಪ್ರಭು ತಿನೆ ಮದದ ಕರ‍್ಯೊ. ಪ್ರಭು ಮರಗಾಲೊ ವರಿ ದಯಾ ದೆಕಾಡಾಲೊ ವ್ಹೈ ಕೈನ ಎ ದೆಕಾಡಸ.<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />ಮಾರಾ ಭಾಯೊ ಭೆನೊ, ತುಮೆ ವಾಗ್ದಾನ ಕರತಾಮಾ ಕ್ಹಮ್ಮ ಘಾಲೊ ನಕೊ. ಎ ಘನ್ನು ಕ್ಹಾಸ ವ್ಹೈ. ತುಮೆ ಕದಲ ವಾತ ಪುರಾ ಕರಾನೆ ಪರಲೊಕನಾ, ಭುಲೊಕನಾ ವರಿ ಬಿಜಾ಼ ಕಯಾ ನಾಮನೆ ಉಪಯೊಗ ಕರೊ ನಕೊ. ವ್ಹೈ ಕದ್ಯಾಮ, ವ್ಹೈ” ಕವೊ. ನೈ ಕದ್ಯಾಮ ನೈ” ಕವೊ. ತುಮೆ ಇಮ್ಮ ಕರ‍್ಯಾಮ, ತುಮೊನೆ ದೊಶಿ ಕೈನ ತಿರ್ಪ ನೈ ಥಾತು.<verse eid="JAS 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />ತುಮೊಮಾ ತ್ರಾಸನೆ ಮ್ಹೈ ಥಯಲವಾಲೊ ಪ್ರಾಥನಾ ಕರು. ತುಮೊಮಾ ಕ್ಹುಶಿಕ್ಹು ರ‍್ಹವಾಲೊ ಗಿದ್ದೊ ಕೌ. <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />ತುಮೊಮಾ ಅರಾಮ ನೈಸೊವಾಲೊ ತೆ ಸಭೆಮಾ ಮ್ಹೊಟಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಬಲೌ. ಮ್ಹೊಟಾ ತಿನೆ ತೆಲ ಲಗಾಡಿನ, ಕರ್ತಾನಾ ನಾಮಪರ ತಿನಾಹುತಿ ಪ್ರಾಥನಾ ಕರು.<verse eid="JAS 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JAS 5:15" />ಬರೊಕ್ಹಾಕ್ಹು ಕರಲ ಪ್ರಾಥನಾ ರೊಗಿನೆ ಅರಾಮ ಕರಸ. ಕರ್ತಾ ತಿನೆ ವಚಾ಼ಡಸ. ಯಕ್ಕೆಳೆ, ತೆ ಮನಕ್ಹ ಪಾಪ ಕರ‍್ಯೊಮ, ಕ್ಹುದಾ ತೆ ಕ್ಹಾರಾ ಪಾಪೊನೆ ಮಾಫ ಕರಸ. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />ತುಮೆ ಕರಲ ತಪ್ಪೊ ಯಕ್ನೆ ಯಕ್ಕ ಕೆಳಾಮಾಬಿ ಕತಾ ರ‍್ಹವೊ. ಪಾಚ಼ಲ್ತಾ ಯಕ್ನಾಹುತಿ ಯಕ್ಲಾ ಪ್ರಾಥನಾ ಕರೊ. ತುಮೆ ಇಮ್ಮ ಕರ‍್ಯಾಮ, ಕ್ಹುದಾ ತುಮೊನೆ ಬಿಡುಗಡೆ ಕರಸ. ನಿತಿವಂತ ಘನ್ನಿ ಆಸಕ್ತಿಕ್ಹು ಕರಲ ಪ್ರಾಥನಾ ತಾಕತ ರ‍್ಹಯಲ ವ್ಹೈ. <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />ಎಲಿಯಬಿ ಅಪ್ನಾ ನಿಂಗತ ಯಕ್ಕ ಮನಕ್ಹ ವ್ಹತ್ತೊ. ಪಾನಿ ಔನೈ ಕೈನ ತೆ ಪ್ರಾಥನಾ ಕರಲ ಟೈಮಮಾ ಕ್ಹಡಾತನ್ನ ವರಕ್ಹಲಕ್ಕಾ ತೆ ಗಾಮಮಾ ಪಾನಿಜ಼ ಐಯು ನೈ! <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />ಪಾಚ಼ಲ್ತೊ ಎಲಿಯಾ ಪಾನಿ ಔ ಕೈನ ಪ್ರಾಥನಾ ಕರಲ್ಪರ ಹಬಾಳಮಾತು ಪಾನಿ ಐನ ಜಿಮಿನಮಾ ವರಿ ಬೆಳೆ ಐ.<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />ಮಾರ ಭಾಯೊ ಭೆನೊ, ತುಮೊಮಾ ಯಕ್ಲೊ ಕ್ಹರಿಕ್ಹು ದುರ ಥೈನ ಫರತೊ ರ‍್ಹಯೊಮ, ಬಿಜೆಕ್ಲೊ ತಿನೆ ಮದದ ಕರಿನ ತಿನೆ ಕ್ಹರಿಮಾ ಚ಼ಲೌ. <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />ಇನೆ ಶೆಂಮಾ ಮ್ಹೆಲ್ಲಿವೊ; ಯಕ್ಕ ಪಾಪಿನೆ ಕೆಟ್ಟ ವಾಟಮಾತೊ ಚೊ಼ಕಿ ವಾಟಮಾ ಚ಼ಲಾವಾಲೊ ತೆ ಪಾಪಿನಾ ಆತ್ಮಾನೆ ಮರಣಕ್ಹು ಪಾರ ಕರಲವಾಲೊ ಘನ್ನಾ ಪಾಪೊನೆ ಮಾಫಿ ಮಳೆನಿಂಗತ ಕರಲವಾಲೊ ಥಾವಸ.<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>