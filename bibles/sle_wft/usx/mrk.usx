<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Shikilagar</book>
  <para style="h">ಮಾರ್ಕ</para>
  <para style="toc3">ಮಾರ್ಕ</para>
  <para style="toc2">ಮಾರ್ಕ</para>
  <para style="toc1">ಮಾರ್ಕ ಬರ್ದಲ ಯೆಸುನಿ ಸುವಾರ್ತಾ</para>
  <para style="mt2">ಮಾರ್ಕನು ಬರೆದ ಯೆಸುವಿನ ಸುವಾರ್ತೆ</para>
  <para style="mt1">ಮಾರ್ಕ ಬರ್ದಲ ಯೆಸುನಿ ಸುವಾರ್ತಾ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಮಾರ್ಕನಾ ಪ್ರಕಾರ ಎ ಸುವಾರ್ತೆ ಆಂ ವಾತೊಕ್ಹು ಶುರು ಥಾವಸ. ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಸುನಾ ಹುತಿ ಚೊ಼ಕಿಯೊ ವಾತೊ ಯೆಸು ಕಾಮ ಕರಾಲೊ ವರಿ ಅದಿಕಾರ ರ‍್ಹಯಲವಾಲೊ ಮನಕ್ಹ ವ್ಹೈ ಕೈನ ದೆಕಾಡಿನ ದಿದ್ಯೊಸ. ತಿನೊ ಅದಿಕಾರ ತೆ ಕರಾನಿ ಭೊದನೆಮಾ ಕೆಟ್ಟ ಆತ್ಮಾವೊಪರ ತಿನಿ ತಾಕತ ವರಿ ಮನಕ್ಹನು ಪಾಪ ಮಾಫ ಕರಾನು ದಿಕ್ಹಿನ ಆವಸ. ಯೆಸು ಮನಕ್ಹನೊ ದಿಕ್ರೊ ವ್ಹೈ ಕೈನ ವರಿ ಮನಕ್ಹೊನೆ ಪಾಪತೊ ಛೊಡಾವಾನೆ ತಿನೊ ಜ಼ಲಮ ದಿವಾನಾ ಹುತಿ ಆಯೊಸ ಕೈನ ಕದ್ಯೊಸ.</para>
  <para style="ip">ಮಾರ್ಕ ಯೆಸುನಿ ಸಾಮ್ಯ, ಯೆಸುನಿ ವಾಕ್ಯಾ ವರಿ ತೆ ಕರಲ ಕ್ಹಾರು ದೆಕಾಡಿನ ದಿದ್ಯೊಸ. ಬಾಪ್ತಿಸ್ಮಾ ದಿಲಾವಾಲೊ ಯೊಹಾನ ಬಾಪ್ತಿಸ್ಮ ವರಿ ಶೊದನೆನಾ ಹುತಿ ಯಕ್ಕ ನ್ಹಾನಿ ಪಿಠಿಕೆಲಿನ ಬರ್ದಲವಾಲೊ ತೆಳಾಮಾಜ಼ ಯೆಸುನಿ ಅರಾಮ ಕರಾನಿ ಸೆವಾ ವರಿ ಭೊದನೆ ಕರಾನೆ ಜಾ಼ವಸ, ಟೈಮ ಥಯಲ ತಿಮ್ಮ ಯೆಸುನಾ ಪಾಚಾ಼ ಆವಾಲಾ ಯೆಸುನೆ ಜಾಸ್ತಿ ಕಳೈ ಲಿವಸ. ತೆನೈಸೊ ಯೆಸುನಾ ವಿರೊದಿಯೊ ತಿನೆ ಹೆಚ್ಕಿ ವಿರೊದ ಕರಸ. ಲಾಸ್ಟನಾ ಅದ್ಯಾಯಮಾ ಯೆಸು ದುನಿಯಾನಿ ಜಿವಿತನಾ ಹುತಿ ಲಾಸ್ಟನಾ ದಿನ್ನೊ ತಿನಾ ಮಾಫಿ, ಮರಣ ವರಿ ಪುನರುತ್ಥಾನನಾ ಹುತಿ ಕವಸ.</para>
  <para style="ip">ಎ ಸುರ್ವಾತೆನಾ ವಾಕ್ಯಾಮಾ ಬರ್ದಲ ನಿಂಗತ ಅಂತ್ಯಮಾ ಮಾರ್ಕ ನೈಸೊ ಬಿಜು಼ ಕುನ್ನ ಯಕ್ಕ ಬರ್ದಲ ರ‍್ಹವಸ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1 ಯೆಸುನಿ ಸುವಾರ್ತೆ ಶುರು ಥಾವಾನು <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref> </char></para>
  <para style="io1">2 ಗಲಿಲಾಯಾಮಾ ಯೆಸುನು ಕಾಮ <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref> </char></para>
  <para style="io1">3 ಗಲಿಲಾಯಾತಾ ಯೆರುಸೆಲಿಮಲಕ್ಕಾ <char style="ior"><ref loc="MRK 10:1-12:44">10:1—12:44</ref> </char></para>
  <para style="io1">4 ಯೆರುಸೆಲಿಮಾನಾ ನಜಿಕ ವರಿ ಯೆರುಸೆಲಿಮನಾ ಆಟ ದಿನ್ನ <char style="ior"><ref loc="MRK 13:1-15:47">13:1—15:47</ref> </char></para>
  <para style="io1">5 ಯೆಸು ಪುನರುತ್ಥಾನ ಥಾವಾನು <char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref> </char></para>
  <para style="io1">6 ಜಿವ್ತೊ ಥೈನ ಯೆಸು ಮನಕ್ಹೊನೆ ದಿಕ್ಹಾನು ವರಿ ಯೆಸು ಸ್ವರ್ಗೆ ಜಾ಼ವಾನು <char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref> </char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s1">ಬಾಪ್ತಿಸ್ಮ ದಿಲಾವಾಲೊ ಯೊಹಾನನಿ ಸುದ್ದಿ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ಮತ್ತಾಯ 3:1-12</ref>; <ref loc="LUK 3:1-9">ಲುಕ 3:1-9</ref>,<ref loc="LUK 3:15-17">15-17</ref>; <ref loc="JHN 1:19-28">ಯೊಹಾನ 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ಯೆಸು ಕ್ರಿಸ್ತನಿ ಸುವಾರ್ತೆ (ಚೊ಼ಕಿಯೊ ವಾತೊ) ಶುರು. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />ಪ್ರವಾದಿ ಥಯಲ ಯೆಶಾಯ ಬುಕ್ಮಾ ಬರ್ದಲ ನಿಂಗತ ಕ್ಹುದಾ ಕದಲ ಅಮ್ಮ ವ್ಹೈ.</para>
  <para style="q1" vid="MRK 1:2">ಹಮ್ನಾ ಮಿ ಮಾರಿಯೊ ವಾತೊ ಕವಾಲಾನೆ ತಾರಾ ಕ್ಹಾಮೊ ಮೊಕ್ಲುಸ.</para>
  <para style="q2" vid="MRK 1:2">ತು ಜಾ಼ವಾನಿ ವಾಟ ತೆ ಚೊ಼ಕಿ ಕರಸ.'<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />ಕರ್ತಾನಿ ವಾಟ ತಯ್ಯಾರ ಕರೊ;</para>
  <para style="q1" vid="MRK 1:3">ತಿನಿ ಜಾ಼ವಾನಿ ಯಕ್ಕ ವಾಟ ಚೊ಼ಕಿ ಕರೊ;</para>
  <para style="q2" vid="MRK 1:3">ರಾನ್ಮಾ ವದ್ರಾಲಾನು ಅವಾಜ಼ ಐಕು ಆವಾಡುಸ.<verse eid="MRK 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4" />ಯೊಹಾನ ಐನ ಮನಕ್ಹೊನೆ, ತುಮೆ ಪಾಪ ಪರಿಹಾರನಾಹುತಿ ಕ್ಹುದಾಕನ ಫರಿನ ಬಾಪ್ತಿಸ್ಮ ಕರೈಲಿವೊ. ತೆಳಾಮಾ ಕ್ಹುದಾ ತುಮಾರು ಪಾಪ ಮಾಫ ಕರಸ" ಕತೊ ಮನಕ್ಹೊನೆ ಬಾಪ್ತಿಸ್ಮ ಕರಾತೊ ವ್ಹತ್ತೊ. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />ತೆಳಾಮಾ ಯುದಾಯತಾ ವರಿ ಯೆರುಸಲೆಮಾತಾಬಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಯೊಹಾನಕನ ಐನ ತ್ಯುನೆ ತ್ಯುನಾ ಪಾಪನೆ ಪಶ್ಚಾತಾಪ ಕರ್ಲಿನ ಯೊರ್ದನ ನದಿಮಾ ತಿನಾ ಹತೆ ಬಾಪ್ತಿಸ್ಮ ಕರೈಲಿವಾಡಾತಾ. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />ಆಂ ಯೊಹಾನ ಹುಂಟನಾ ಬಾಲೊನಾ ವಣ್ಣಾ ಘಾಲ್ಲಿನ, ಕಂಬರನೆ ಯಕ್ಕ ಚಾ಼ಂಬಡಾನಿ ಪಟ್ಟಿ ಭಾಂದಿಲೆತೊತೊ; ಫಿರಕಾ ವರಿ ರಾನ್ಮಾನು ಜೆನ ತಿನು ಅನ್ನ ವ್ಹತ್ತು. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />ತೆ ಮನಕ್ಹೊನೆ ಕದ್ಯೊ, ಮಾರಾ ಪಾಚೊ಼ ಆವಾಲೊ, ತೆ ಮಾರಾತಿಬಿ ಘನ್ನಿ ತಾಕತವಾಲೊ ವ್ಹೈ, ತಿನಿಯೊ ಚಪ್ಪಲನಿಯೊ ದೊರಿಯೊ ಡೊಗ್ಗಿನ ಛೊಡಾನೆಬಿ ಮಿ ಲಾಯಕ ನತ್ತಿ. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />ಮಿ ತುಮೊನೆ ಪಾನಿಕ್ಹು ಬಾಪ್ತಿಸ್ಮ ಕರಾಯೊಸ. ತೆ ತುಮೊನೆ ಪವಿತ್ರ ಆತ್ಮಾಕ್ಹು ಬಾಪ್ತಿಸ್ಮ ಕರಾವಸ ಕೈನ ಕದ್ಯೊ.<verse eid="MRK 1:8" /></para>
  <para style="s1">ಯೆಸು ಬಾಪ್ತಿಸ್ಮ ಕರೈಲಿದಲ</para>
  <para style="r">(<ref loc="MAT 3:3-17">ಮತ್ತಾಯ 3:3-17</ref>; <ref loc="LUK 3:21-22">ಲುಕ 3:21-22</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />ತೆ ದಿನ್ನಮಾ ಯೆಸು ಗಲಿಲಾಯ ಗಾಮನೆ ಮಳಲ ನಜ಼ರೆತ ಕವಾನಾ ಗಾಮತೊ ಐನ. ಯೊರ್ದನ ನದಿಮಾ ಯೊಹಾನ ರ‍್ಹಯಲ ಜ಼ಗಾ ಐನ, ತಿನಾ ಹತೆ ಬಾಪ್ತಿಸ್ಮ ಕರೈಲಿದ್ಯೊ. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />ಬಾಪ್ತಿಸ್ಮ ಕರೈಲಿದಲ ಬರೊಬ್ಬರ ತೆ ಪಾನಿಮಾತೊ ಉಪ್ಪರ ಆತಾಮಾ ಸ್ವರ್ಗ ಕ್ಹುಲ್ಲಾ ಥೈನ, ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಕ್ಹಬುತರ ನಿಂಗತ ತಿಪರ ಉತರಾನು ದೆಕ್ಯೊ. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />ತೆಳಾಮಾ, ತು ಮಯಾನೊ ಥಯಲ ಮಾರೊ ದಿಕ್ರೊ ವ್ಹೈ. ತುನೆ ಮಿ ಮೆಚ್ಯೊಸ ಕೈನ ಸ್ವರ್ಗಮಾತು ಅವಾಜ಼ ಐಯು.<verse eid="MRK 1:11" /></para>
  <para style="s1">ಯೆಸುನಿ ಶೊಧನೆ</para>
  <para style="r">(<ref loc="MAT 4:1-13">ಮತ್ತಾಯ 4:1-13</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />ತೆಳಾಮಾಜ಼ ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಯೆಸುನೆ ರಾನ್ಮಾ ಚ಼ಲೈ. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />ತೆ ಚಾ಼ಳಕ್ಹ ದಿನ್ನ ಕುನ್ನಜ಼ ರ‍್ಹವಾನೆ ಥಾಯೆ ನೈಸೊ ಜ಼ಗಾ ಜಾನ್ವರೊನಾ ಕ್ಹಾತೆ ರ‍್ಹೈನ, ಸೈತಾನ ಯೆಸುನೆ ಶೊದನೆಮಾ ಪಾಡಾನೆ ದೆಕ್ಯೊ. ತಿನಾ ಹತೆ ಥಯು ನೈ. ವರಿ ಕ್ಹುದಾನಾ ದುತೊ ಐನ ತಿನಿ ಸೆವಾ ಕರ‍್ಯಾ.<verse eid="MRK 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />ಪಾಚ಼ಲ್ತಾ ಯೊಹಾನನೆ ಜೆಲಮಾ ಘಾಲಲ್ಪರ, ಯೆಸು ಗಲಿಲಾಯ ಗಾಮೆ ಐನ ಮನಕ್ಹೊನೆ ಸುವಾರ್ತೆ ಕವಾನು ಚಾ಼ಲು ಕರ‍್ಯೊ. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />ತೆ ದಿನ್ನೊ ಪುರಾ ಥಯಾ ಕ್ಹುದಾನಿ ರಾಜ್ಯ ನಜಿ಼ಕ ಐ. ತುಮಾರಾ ಪಾಪನೆ ಪಶ್ಚಾತಾಪ ಪಡಿನ ಕ್ಹುದಾ ಬಗಲ ಫರಿನ ಸುವಾರ್ತೆ (ಸುವಾರ್ತೆ ಕದ್ಯಾಮ ಕ್ಹುದಾನಿಯೊ ವಾತೊ) ನಂಬೊ ಕೈನ ಕ್ಹುದಾನಿಯೊ ಚೊ಼ಕಿಯೊ ವಾತೊ ಕತೊ ಗಯೊ.<verse eid="MRK 1:15" /></para>
  <para style="s1">ಯೆಸು ಪೈಲಾ ಶಿಷ್ಯಾವೊನೆ ಇನಿಲಿದ್ಯೊ</para>
  <para style="r">(<ref loc="MAT 4:14-15">ಮತ್ತಾಯ 4:14-15</ref>; <ref loc="LUK 5:1-11">ಲುಕ 5:1-11</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ತೆ ಗಲಿಲಾಯ ಸಮುಂದರಕನ ಜಾ಼ತಾ ಟೈಮಮಾ ಸಿಮೊನ ವರಿ ಸಿಮೊನನೊ ನ್ಹಾನೊ ಭೈ ರ‍್ಹಯಲ ಅಂದ್ರೆಯಾನೆ ಸಮುಂದರಮಾ ಬಲಿ ನಾಕಾನು ದೆಕ್ಯೊ. ತ್ಯುನೆ ಬೆಸ್ತರೊ ವ್ಹತ್ತಾ. (ಕದ್ಯಾಮ ಮಚ಼್ಲಿ಼ಯೊ ಧರಾಲಾ) <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />ಯೆಸು ತ್ಯುನೊನೆ, ಮಾರಾಪಾಚಾ಼ ಆವೊ ಮಿ ತುಮೊನೆ ಮನಕ್ಹೊನೆ ಕ್ಹುದಾನಾ ರಾಜ್ಯಮಾ ಲಾವಾಲಾ ನಿಂಗತ ಕರುಸ” ಕದ್ಯೊ. <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />ತೆಳಾಮಾಜ಼ ತ್ಯುನೆ ಬಲಿಯೊ ಛೊಡಿನ ತಿನಾ ಪಾಚಾ಼ ಗಯಾ.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />ಹಜು಼ನ ದಕ್ಹಾ ದುರ ಗೈನ ಜೆಬೆದಾಯನೊ ದಿಕ್ರೊ ಯಾಕೊಬನೆ ತಿನೊ ನ್ಹಾನೊ ಭೈ ಥಯಲ ಯೊಹಾನ ಕವಾಲಾನೆ ದೆಕ್ಯೊ. ತ್ಯುನೆ ಹಡಗಾವೊಮಾ ಬೈಟಿನ ಬಲಿಯೊ ಸಿದಾ ಕರಾಡಾತಾ. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />ಜೆಬೆದಾಯನೆ ಕುಲಿ ಆಳೊನಾ ಕ್ಹಾತೆ ಹಡಗಾಮಾ ಚೊ಼ಡಿನ ತಿನಾ ಪಾಚಾ಼ ಗಯಾ.<verse eid="MRK 1:20" /></para>
  <para style="s1">ಕೆಟ್ಟ ಆತ್ಮಾ ಧರವಾಲಾನೆ ಅರಾಮ ಕರಲ</para>
  <para style="r">(<ref loc="LUK 4:31-37">ಲುಕ 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />ಪಾಚ಼ಲ್ತಾ ತ್ಯುನೆ ಕಪೆನೌರ್ಮಿ ಕವಾನಾ ಗಾಮೆ ಐನ ಮುಟ್ಟ್ಯಾ. ತೆಳಾಮಾ ಸಬ್ಬತ ದಿನ್ನಮಾ ಯೆಸು ಸಭಾಮಂದಿರಮಾ ಗೈನ ಉಪದೆಶ ಕರ‍್ಯೊ. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />ಮನಕ್ಹೊ ತೆ ಉಪದೆಶ ಕರಾನು ದೆಕಿನ ಘನ್ನಾ ಘಾಬ್ರಾಥಯಾ. ಕಾಕದ್ಯಾಮ ತೆ ಶಾಸ್ತ್ರಿಯೊನಿಂಗತ ಉಪದೆಶ ಕರ‍್ಯಾವಾಚಿ ಅದಿಕಾರ ರ‍್ಹಯಲವಾಲಾ ನಿಂಗತ ತ್ಯುನೊನೆ ಉಪದೆಶ ಕರಾಡೊತೊ. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />ತೆಳಾಮಾ ತ್ಯುನಾ ಸಭಾಮಂದಿರಮಾ ಕೆಟ್ಟ ಆತ್ಮಾ ಧರಲ ಯಕ್ಕ ದಾಣಗೊ ಐನ ವದರ‍್ಯೊ. <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />ತೆ ಕೆಟ್ಟ ಆತ್ಮಾ , ನಜ಼ರೆತನಾ ಯೆಸು ಹಮಾರಿ ಉಸಾಬರಿ ತುನೆ ಕಾ? ಹಮೊನೆ ನಾಶ (ಹಾಳ) ಕರಾನೆ ಆಯೊ ಸು? ತುನೆ ವಳಕ್ಯಾಸ; ತು ಕ್ಹುದಾ ವಳಾಯಲ ಪರಿಶುದ್ಧ ವ್ಹೈ ಕೈನ ಹಮೊನೆ ಗ್ವತ್ತ ಛೆ ಕೈನ ವದ್ರಿನ ಕದ್ಯೊ.<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />ಯೆಸು ತಿನೆ, ಭುಚ್ಕಾ಼ಡಿನ ಗಪ ರ‍್ಹೆ ಅನಾಮಾತೊ ಭಾರೊ ಜಾ಼ ಕತಾಮಾ, <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />ತೆ ಕೆಟ್ಟ ಆತ್ಮಾ ತಿನೆ ವದ್ಯಾಡಸಿನ ಘಾಬ್ರು ಥೈನ ಛೊಡಿನ ವದ್ರಿನ ಗಯು.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />ತಿನಾಹುತಿ ಕ್ಹಾರಾ ಜ಼ನಾ ಘಾಬ್ರಾ ಥೈನ, ಆಂ ಸುವೈ? ನವು ಉಪದೆಶ. ಆಂ ಅದಿಕಾರಕ್ಹು ಕೆಟ್ಟ ಆತ್ಮಾವೊನೆಬಿ ಆಗನ್ಯಾ ದಿವಸ ತ್ಯುನೆ ತಿನಿ ವಾತ ಐಕಸ” ಕೈನ ತ್ಯುನೊ-ತ್ಯುನೊಮಾಜ಼ ವಿಚಾರ ಕರಲಿದ್ಯಾ. <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />ತೆಳಾಮಾ ತಿನಿ ಸುದ್ದಿ ಗಲಿಲಾಯ ಪ್ರಾಂತ್ಯಮಾ ಫೈಲಿ ಗೈ.<verse eid="MRK 1:28" /></para>
  <para style="s1">ಘನ್ನಾ ಜ಼ನಾ ಅರಾಮ ಥಯಲ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ಮತ್ತಾಯ 8:14-17</ref>; <ref loc="LUK 4:38-41">ಲುಕ 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />ತೆ ಥಯಲ್ಪರ ಯೆಸು ವರಿ ತಿನಾ ಶಿಷ್ಯಾ ಸಭಾಮಂದಿರಮಾತಾ ಗೈನ ಯಾಕೊಬ ಯೊಹಾನನಾ ಕ್ಹಾತೆ ಸಿಮೊನ ಅಂದ್ರೆಯನಾ ಘರೆ ಆಯಾ. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />ತ್ಯಾ ಸಿಮೊನನಿ ಪ್ಹೈ ತೌ ಐನ ಕ್ಹುರೈತಿ ತ್ಯುನೆ ತೆಳಾಮಾಜ಼ ಯೆಸುಕನ ಕದ್ಯಾ. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />ತೆ ನಜಿಕ ಐನ ತಿನೊ ಹತ್ತ ಧರಿನ ಉಟಾಡತಾಮಾ ತಿನೆ ತೌ ರ‍್ಹಯಲ ಗೈ ಪಾಡ್ಯೊ. ತೆ ತ್ಯುನೊನೆ ಉಪಚಾರ ಕರಿ.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />ಕ್ಹಾಂಜ಼ ಥೈನ ದಿನ್ನ ಡುಬ್ತಾಮಾ ಮನಕ್ಹೊ ಅರಾಮ ನೈಸೊವಾಲಾವೊನೆ ಕೆಟ್ಟ ಆತ್ಮಾ ಧರಲವಾಲಾವೊನೆ ತಿಕನ ಲಾಯಾ. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />ಗಾಮವಾಲಾ ಸಿಮೊನನಾ ಘರನಾ ಬಾಕಲನಾ ಕ್ಹಾಮಾ ಗುಂಪ ಥೈನ ವ್ಹತ್ತಾ. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />ತೆ ಬಿಜಾ಼-ಬಿಜಾ಼ ರೊಗೊ ರ‍್ಹಯಲವಾಲಾ ಘನ್ನಾ ಮನಕ್ಹೊನೆ ಅರಾಮ ಕರಿನ ಘನ್ನಿಯೊ ಕೆಟ್ಟ ಆತ್ಮಾವೊನೆ ಛೊಡೈನ ವರಿ ತೆ ಕುನ್ನ ವ್ಹೈ ಕೈನ ಕೆಟ್ಟ ಆತ್ಮಾವೊನೆ ಗ್ವತ್ತ ರ‍್ಹಯಲಕ್ಹು ತ್ಯುನೊನೆ ಬೊಲಾನೆ ದಿದ್ಯೊ ನೈ.<verse eid="MRK 1:34" /></para>
  <para style="s1">ಯೆಸು ಕ್ಹುದಾನಿಯೊ ವಾತೊ ಕತೊ ಗಲಿಲಾಯಮಾ ಫರಲ</para>
  <para style="r">(<ref loc="LUK 4:42-44">ಲುಕ 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />ದಿನ್ನ ನಿಕ್ಹಳಾತಿ ಅಗ್ದುರಜ಼ ತೆ ಉಟಿನ ಕುನ್ನಜ಼ ನೈಸೊ ಜ಼ಗಾ ಗೈನ ಕ್ಹುದಾನೆ ಪ್ರಾಥನಾ ಕರಾಡೊತೊ. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />ಸಿಮೊನ ವರಿ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲವಾಲಾ ತಿನೆ ಹುಡಕ್ತಾ ಆಯಾ. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />ತಿನೆ ದೆಕಲ ಬರೊಬ್ಬರ ಕ್ಹಾರಾಜ಼ನಾ ತುನೆ ಹುಡಕಾಡಾಸ ಕದ್ಯಾ.<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />ಯೆಸು ತ್ಯುನೊನೆ ಅಪೆ ನಜಿಕ ರ‍್ಹಯಲ ಬಿಜಾ಼ ಗಾಮೆ ಗಯ್ಯೆ ತ್ಯಾಬಿ ಮಿ ಸುವಾರ್ತೆ ಕೌ; ಇನಾಹುತಿ ಮಿ ಐಪಡ್ಯೊ ಕದ್ಯೊ. <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />ಪಾಚ಼ಲ್ತೊ ಗಲಿಲಾಯ ಪ್ರಾಂತ್ಯಮಾ ಕ್ಹಾರಿ ಜ಼ಗಾ ಗೈನ ತ್ಯುನಿಯೊ ಸಭಾ ಮಂದಿರೊಮಾ ಗೈನ ಸುವಾರ್ತೆ ಕತೊ ಕೆಟ್ಟ ಆತ್ಮಾ ಛೊಡಾತೊ ವ್ಹತ್ತೊ.<verse eid="MRK 1:39" /></para>
  <para style="s1">ಯೆಸು ಯಕ್ಕ ಕುಷ್ಠ ರೊಗಿನೆ ಅರಾಮ ಕರಲ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ಮತ್ತಾಯ 8:1-4</ref>; <ref loc="LUK 5:12-16">ಲುಕ 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />ಯಕ್ಕ ಕುಷ್ಟ ರೊಗಿ ಯೆಸುಕನ ಐನ ತಿನಾ ಕ್ಹಾಮೊ ಉಂದಾ ಗುಡಗಾ ಘಾಲ್ಲಿನ ಬೈಟಿನ ತುನೆ ಮನಸ ರ‍್ಹಯುಮ ಮನೆ ಶುದ್ಧ ಕರಶಿ (ಅರಾಮ ಕರಶಿ) ಕೈನ ಮಾಂಗಿಲೆತಾಮಾ,<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />ಯೆಸು ತಿನೆ ಮರಗಿನ ಹತ್ತ ದಿನ ಮುಟ್ಟಿನ, ಮನೆ ಮನಸ ಛೆ ಶುದ್ಧ ಥಾ” ಕದ್ಯೊ. <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />ತೆಳಾಮಾಜ಼ ತಿನೊ ಕುಷ್ಟರೊಗ ಗೈನ ತೆ ಶುದ್ಧ ಥಯೊ.<verse eid="MRK 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43" />ತೆಳಾಮಾ ಯೆಸು ತಿನಾ ಕ್ಹಾತೆ ಬೊಲಿನ ವಳಾಯೊ. <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />ಸು ಕೈನ ವಳಾಯೊ ಕದ್ಯಾಮ, ಯೆಸು ತಿನೆ, ಕಿನೆಜ಼಼ ಸು ಕೌ ನಕೊ ದೆಕ ತು ಗೈನ ಯಾಜಕನೆ ತಾರು ಅಂಗ ದೆಕಾಡ ಮೊಶೆ ಕದಲ ಪದ್ದತ ಕರಿನ ತಾರು ಶುದ್ಧವಿಚಾರ ಪುರಾ ಕರ. ತೆ ಮನಕ್ಹೊನೆ ಸಾಕ್ಷಿ ಥಾವಾದೆ ಕೈನ ಕ್ಹರಿಕ್ಹು ಕೈನ ತಿನೆ ವಳೈಪಡ್ಯೊ. <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />ವರಿಬಿ ತೆ ಗೈನ ತಿನಾ ಕ್ಹಾತೆ ಥಯಲ ಅದ್ಭುತ ಕರಲ ಸುದ್ದಿ ಘನ್ನೊ ಫೈಲಾಯೊ ಯೆಸುನೆ ಕಯಾಜ಼ ಗಾಮಮಾ ಖುಲ್ಲಾ ಜಾ಼ವಾನೆ ಥಯು ನೈ. ವರಿ ಕುನ್ನಜ಼ ನೈಸೊ ರ‍್ಹಯಲ ಜ಼ಗಾಪರ ವ್ಹತ್ತೊ. ವರಿ ಮನಕ್ಹೊ ಚ಼್ಯಾರೆ ಬಗಲತಾ ತಿಕನ ಆವಾಡಾತಾ.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s1">ಯೆಸು ಲಕ್ವೊ ಮಾರಲವಾಲಾನೆ ಅರಾಮ ಕರಲ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ಮತ್ತಾಯ 9:1-8</ref>; <ref loc="LUK 5:17-26">ಲುಕ 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />ದಕ್ಹಾ ದಿನ್ನೊ ಥಯಲ್ಪರ ಯೆಸು ಕಪೆನೌರ್ಮಿ ಗಾಮೆ ಫರಿನ ಆಯೊ. ತೆ ಘರಮಾ (ಘರ ಕದ್ಯಾಮ ತೆ ರ‍್ಹಯಲ ಗಾಮ) ಆಯೊಸ ಕೈನ ಮನಕ್ಹೊನೆ ಸುದ್ದಿ ಗೊತ್ತ ಥೈ. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />ಮನಕ್ಹೊ ಮಳಿನ ಆಯಲಕ್ಹು ಘರನಾ ಬಾಕಲನಾ ಭಾರಿಬಿ ಜ಼ಗಾನ್ಹೊತಿ ಯೆಸು ತ್ಯುನೊನೆ ಉಪದೆಶ ಕರಾಡೊತೊ. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />ತೆಕ್ಲಾಮಾಜ಼಼ ಯಕ್ಕ ಲಕ್ವೊ ಮಾರಲವಾಲಾನೆ ಚ಼್ಯಾರ ಜ಼ನಾ ಉಚೈಲಿನ ತ್ಯಾ ಲಾಯಾ. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />ಮನಕ್ಹೊ ಗುಂಪ ಥೈನ ಹುಬ್ರಯಲಕ್ಹು ತ್ಯುನೆ ತಿಕನ ನಜಿಕ ಆವಾನೆ ಥಾಯೆ ನೈಸೊಕ್ಹು ತೆ ರ‍್ಹಯಲ ಘರನಾ ಉಪ್ಪರಲಿ ಛತ್ತ ಕಾಡಿನ ಜ಼ಗಾ ಕರಿನ ಲಕ್ವೊ ಮಾರಲ ರೊಗಿ ಕ್ಹುರಯಲ ವಚ್ಚಾ಼ನಾನಾ ಕ್ಹಾತೆ ಉತಾರ‍್ಯಾ. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />ಯೆಸು ತಿವ್ನೊ ಬರೊಕ್ಹೊ ದೆಕಿನ ತೆ ಲಕ್ವೊ ಮಾರಲವಾಲಾನೆ ದಿಕ್ರಾ ತಾರು ಪಾಪ ಮಾಫ ಥಯುಸ ಕದ್ಯೊ.<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />ತೆಳಾಮಾ ಶಾಸ್ತ್ರಿಯೊಮಾನಾ ದಕ್ಹಾ ಜ಼಼ನಾ ತ್ಯಾಜ಼ ಬೈಟ್ಯಾತಾ <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />ಆಂ ಇಮ್ಮ ಕಾ ಬೊಲಾಡೊಸ? ಎ ಕ್ಹುದಾನಾ ವಿರುದ್ದ ವ್ಹೈ. ಕ್ಹುದಾನೆ ಯಕ್ಲಾನೆಜ಼ ಛೊಡಿನ ಬಿಜು಼ ಕುನ್ನ ಪಾಪ ಮಾಫ ಕರಸ? ಕೈನ ತ್ಯುನಾ-ತ್ಯುನಾ ಮನಸಮಾ ಕೈಲಿದ್ಯಾ.<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />ತ್ಯುನೆ ಇಮ್ಮ ಕೈಲಿವಾನು ತೆಳಾಮಾಜ಼ ಯೆಸು ತಿಳದಿಲಿದ್ಯೊ. ಯೆಸು ತ್ಯುನೊನೆ-ತುಮೆ ತುಮಾರಾ ಮನಸಮಾ ಇಮ್ಮ ಕಾ ತಿಳದಿಲಿವಾಡಾಸ? ಕಯು ಆಸಾನ (ಚೊ಼ಕು) ವ್ಹೈ. <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />ತಾರು ಪಾಪ ಮಾಫ ಥೈ ಗಯುಸ ಕವಾನು ಸು? ಉಟಿನ ತಾರಾ ವಚ್ಚಾ಼ನಾಲಿನ ಚಾ಼ಲ ಕವಾನು ವ್ಹೈ? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />ವರಿಬಿ ಪಾಪ ಮಾಫ ಕರಾನೆ ಮನಕ್ಹನಾ ದಿಕ್ರಾನೆ ಭ್ಹುಲೊಕಮಾ (ದುನಿಯಾಮಾ) ಅದಿಕಾರ ಛೆ ಕವಾನು ತಿಳದಿಲಿವೊ ಕದ್ಯೊ. ಲಕ್ವೊ ಮಾರಲವಾಲಾನೆ ದೆಕಿನ, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />ಉಟಿನ ತಾರು ವಚ್ಚಾ಼ನು ಉಚೈನ ಘರೆ ಜಾ಼ ಕೈನ ತುನೆ ಕೌಸ ಕದ್ಯೊ. <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />ತೆ ಉಟಲ ಬರೊಬ್ಬರ ತೆ ವಚ್ಚಾ಼ನು ಲಿನ ಕ್ಹಾರಾವೊನಾ ಕ್ಹಾಮಾತೊ ಗೈ ಪಡ್ಯೊ. ತಿನಾಹುತಿ ಕ್ಹಾರಾಜ಼ನಾ ಘಾಬ್ರಾಥೈನ - ಹಜು಼ನಲಕ್ಕಾ ಹಮೆ ಹೌ ಕೆಳಾಮಾಜ಼ ದೆಕ್ಯಾನತ್ತಿ ಕತಾ ಕ್ಹುದಾನೆ ನೆಣಸ್ತಾ ಗಯಾ.<verse eid="MRK 2:12" /></para>
  <para style="s1">ಯೆಸು ಲೆವಿನೆ ಬಲಾಯಲ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ಮತ್ತಾಯ 9:9-13</ref>; <ref loc="LUK 5:27-32">ಲುಕ 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />ಯೆಸು ತ್ಯಾಂತೊ ಫರಿನ ಸಮುಂದರಕನ ಗಯೊ ಮನಕ್ಹೊನು ಗುಂಪ ತಿಕನ ಆತಾಮಾ ಯೆಸು ತ್ಯುನೊನೆ ಕ್ಹುದಾನಿಯೊ ವಾತೊ ಶಿಕ್ಲಾಯೊ. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />ತೆ ತ್ಯಾಂತೊ ಜಾ಼ತಾಮಾ ಭು ಭಾಡಾನಾಹುತಿ ಬೈಟಲ ಅಲ್ಫಾಯನನೊ ದಿಕ್ರೊ ಲೆವಿನೆ ದೆಕಿನ ಮಾರಾ ಪಾಚೊ಼ ಆ ಕೈನ ಬಲಾತಾಮಾ ತೆ ಉಟಿನ ತಿನಾಪಾಚೊ಼ ಗಯೊ.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />ತೆ ಥಯಲ್ಪರ ಲೆವಿನಾ ಘರಮಾ ಕ್ಹಾವಾನಾಹುತಿ ಯೆಸು ಬೈಟ್ಯೊ ಮ್ಹೊಟು ಗುಂಪ ಯೆಸುನಾ ಪಾಚು಼ ಐಯು ತಿಮಾ ಭು ಭಾಡಾವಾಲಾ ಪಾಪಿಯೊಬಿ ಗಯಾ, ವರಿ ಘನ್ನಾ ಜ಼ನಾ ಯೆಸು ವರಿ ತಿನಾ ಶಿಷ್ಯಾವೊನಾ ಕ್ಹಾತೆ ಕುಡ್ಯಾ <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />ತೆವಾ ಘನ್ನಾ ಮನಕ್ಹೊ ವ್ಹತ್ತಾ. ಫರಿಸಾಯರೊ ಥಯಲ ಶಾಸ್ತ್ರಿಯೊಬಿ ಐನ. ಯೆಸು ಪಾಪಿಯೊನಾ ಕ್ಹಾತೆ ವರಿ ಭು ಭಾಡಾವಾಲಾವೊನಾ ಕ್ಹಾತೆ ಖಾವಾನು ದೆಕಿನ ತಿನಾ ಶಿಷ್ಯಾವೊಕನ ಕದ್ಯಾ ಆಂ ಪಾಪಿಯೊನಾ ಕ್ಹಾತೆ ಅನ್ನ ಖಾವಾಡೊಸ್ತೊ ಕದ್ಯಾ.<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />ಯೆಸು ತೆ ಐಕಿನ ಜವಾಬ ದಿದ್ಯೊ ಚೊ಼ಕಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಡಾಕ್ಟರನಿ ಜ಼ರುರತ ನತ್ತಿ; ರೊಗಿಯೊನೆ ಡಾಕ್ಟರನಿ ಜ಼ರುರತ ಛೆ. ಮಿ ಚೊ಼ಕಾವೊನಾಹುತಿ ನತ್ತಿ ಆಯೊ ಪಾಪಿಯೊನಾಹುತಿ ಆಯೊಸ.<verse eid="MRK 2:17" /></para>
  <para style="s1">ಉಪಾಸನಾಹುತಿ ಸವಾಲ</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />ಯಕ್ಕ ಸಲಾ ಯೊಹಾನನಾ ಶಿಷ್ಯಾ ವರಿ ಫರಿಸಾಯರೊ ಉಪಾಸ ವ್ಹತ್ತಾ. ತ್ಯುನೆ ಯೆಸುಕನ ಐನ, ಯೊಹಾನನಾ ಶಿಷ್ಯಾ ವರಿ ಫರಿಸಾಯರೊ ಉಪಾಸ ಕರಾಡಾಸ್ತೊ? ತಾರಾ ಶಿಷ್ಯಾ ಉಪಾಸ ಕಾ ಕರತಾ ನೈ?<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />ಕೈನ ಪುಚ್ತಾಮಾ ಯೆಸು ತ್ಯುನೊನೆ ಹಿವಾಮಾ ಆಯಲ ಮನಕ್ಹೊ ತಿವ್ನಾ ಕ್ಹಾತೆ ನೌರೊ ರ‍್ಹತಾಸ್ತಾ ಉಪಾಸ ಕರು ಸು ಕರತಾ ನೈ! ಹಿವಾಮಾ ನೌರೊ ತಿವ್ನಾ ಕ್ಹಾತೆ ರ‍್ಹಯೆ ಲಕ್ಕಾ ಉಪಾಸ ಕರು ನೈ <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />ವರಿ ನೌರೊ ತಿವ್ನೊಕಂತೊ ಜಾ಼ವಾನೊ ಟೈಮ ಆವಸ ತೆ ಟೈಮಮಾ ತ್ಯುನೆ ಉಪಾಸ ಕರಸ.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />ಕುನ್ನಜ಼ ನವಾ ವಣ್ಣಾವೊನೊ ತುಕಡೊ ಜು಼ನ್ನಾ ವಣ್ಣಾನೆ ಲಗಾಡ್ತೊ ನೈ ಲಗಾಡ್ಯಾಮ ತೆ ನೌ ಪ್ಹಡಕು ಜು಼ನ್ನಾ ಪ್ಹಡಕಾನೆ ಕುಜೈ಼ಪಾಡಸ ಫಾಟಾನು ಹೆಚ್ಕಿ ಥಾವಸ. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />ಎನೈಸೊ ಕುನ್ನಬಿ ಜು಼ನ್ನಾ ಚಾ಼ಮ್ಡಾನಿ ಕೈಚಿಲಾಮಾ ನೌ ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ಕುನ್ನಜ಼ ಘಾಲಿನ ನೈ ಮ್ಹೆಲ್ತು. ಕಾಕದ್ಯಾಮ ಮುಕ್ಯಾಮ ತೆ ದ್ರಾಕ್ಷಿನು ರಕ್ಹ ತೆ ಕೈಚಿಲಾವೊನೆ ಫಾಡಿನ ಹೆಟು ಪಡಿನ ಕೆಟ್ಟಿ ಜಾ಼ವಸ. ವರಿ ನೌ ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ನಯ್ಯೊ ಕೈಚಿಲಾವೊಮಾಜ಼ ಘಾಲಿನ ಮುಕ್ಕು ಕದ್ಯೊ. <figure style="fig" alt="Wineskin bag" file="lb00145c.tif" size="col" copy="Horace Knowles ©" ref="2:22">ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ಭರಿನ ಮುಕ್ಕಾನಾ ಚಾಂಬ್ಡಾನಾ ಕೈಚಿಲಾ</figure><verse eid="MRK 2:22" /></para>
  <para style="s1">ಸಬ್ಬತ ದಿನ್ನನಾಹುತಿ ಪುಚ಼ಲ</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />ಯೆಸು ಸಬ್ಬತ ದಿನ್ನಮಾ ಖೆತ್ರೊಮಾತೊ ಜಾ಼ತಾ ಟೈಮಮಾ ಯೆಸುನಾ ಶಿಷ್ಯಾ ಜಾ಼ತಾ-ಜಾ಼ತಾ ಮಕ್ಕಾ (ಬುಟ್ಟಾ) ಭಾಗಿಲೆತಾ ವ್ಹತ್ತಾ. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />ಫರಿಸಾಯರೊ ತಿನೆ ದೆಕಿನ ಇವ್ನೆ ಸಬ್ಬತ ದಿನಮಾ ನೈಸೊ ಕರಾನು ಕಾಮ ಕಾ ಕರಾಡಾಸ ಕೈನ ಪುಚ್ಯಾ.<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />ಯೆಸು ತ್ಯುನೊನೆ ದಾವಿದ ವರಿ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲವಾಲಾವೊನೆ ತ್ಯುನೊನೆ ಸುಜ಼ ನೈಸೊ ಭುಕ್ಕಾ ಥಯಲ ಟೈಮಾ ಸು ಕರ‍್ಯೊ ಕೈನ ತುಮೆ ಒದ್ಯಾನತ್ತಿ ಸು? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />ತೆ ಖಾಸ ಯಾಜಕ ಥಯಲ ಅಬಿಯ್ಯಾತರನ ಕಾಲಮಾ ದಾವಿದ ಕ್ಹುದಾನಾ ಘರಮಾ ಗೈನ, ಪದ್ದತ ನಿಂಗತ ಯಾಜಕನೆ ಛೊಡಿನ ಬಿಜು಼ ಕುನ್ನಜ಼ ಖೌ ನೈ ಕೈನ ಮೊಶೆನು ಧರಮ ಶಾಸ್ತ್ರ ಕವಸ್ತೊ. ಕ್ಹುದಾನೆ ಚ಼ಡಾಯಲ ರೊಕ್ಲೊ ತೆ ಖೈನ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲವಾಲಾವೊನೆ ದಿದ್ಯೊತೊ ಕದ್ಯೊ.<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />ವರಿ ಯೆಸು ಕದಲ ಸಬ್ಬತ ದಿನ್ನ ಮನಕ್ಹೊನಾಹುತಿ ಆಯೊಸ ತೆನೈಸೊ ಮನಕ್ಹೊ ಸಬ್ಬತನಾಹುತಿ ನತ್ತಿ ಆಯಾ. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಮನಕ್ಹನೊ ದಿಕ್ರೊ ಸಬ್ಬತ ದಿನ್ನಪರ‍ ಮಾಲಕ ಥಯೊಸ ಕೈನ ಕದ್ಯೊ.<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s1">ಹತ್ತ ಕುಕ್ಹೈ ಗಯಲ ಯಕ್ಕ ಮನಕ್ಹ</para>
  <para style="r">(<ref loc="MAT 12:9-14">ಮತ್ತಾಯ 12:9-14</ref>; <ref loc="LUK 6:6-11">ಲುಕ 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />ಬಿಜೆಕ ಟೈಮಮಾ ಯೆಸು ಸಭಾಮಂದಿರಮಾ ಜಾ಼ತಾಮಾ ತ್ಯಾ ಹತ್ತ ಕುಕ್ಹೈ ಗಯಲ ಯಕ್ಲೊ ವ್ಹತ್ತೊ. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />ತ್ಯುನೆ ದಕ್ಹಾ ಜ಼ನಾ ಯೆಸುಪರ ತಪ್ಪ ಕಿಮ್ಮ ಘಾಲಿಯೆ ಕೈನ ವಿಚಾರ ಕರಲೆತಾ ಸಬ್ಬತ ದಿನ್ನಮಾ ತಿನೆ ಅರಾಮ ಕರು ಸು ಕೈನ ತಿನೆ ವ್ಹಂಚಘಾಲ್ತಾ (ಸೊಚ಼ತಾ) ದೆಕಾಡಾತಾ. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />ಯೆಸು ಹತ್ತ ಕುಕ್ಹೈ ಗಯಲವಾಲಾನೆ ಉಟಿನ ವಚ಼ಮಾ ಆ ಕೈನ ಕದ್ಯೊ.<verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />ಸಬ್ಬತ ದಿನ್ನಮಾ ಸು ಕರಾನು ನ್ಯಾಯ ವ್ಹೈ? ಕೆಟ್ಟ ಸು ಚೊ಼ಕು ಕರಾನು. ಜ಼ಲಮ ವಚಾ಼ಡಾನು ಚೊ಼ಕು ವ್ಹೈಸು? ಜ಼ಲಮ ಕಾಡಾನು ಚೊ಼ಕು ವ್ಹೈ? ಕೈನ ಕತಾಮಾ ತ್ಯುನೆ ಗಪ್ಪಜ಼ ವ್ಹತ್ತಾ.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />ತೆಳಾಮಾ ತ್ಯುನಾ ಮನಸೊ ದಗಡಾ ಥಯಲ ದೆಕಿನ ಯೆಸು ದುಖಿ ಥಯೊ ವರಿ ತೆ ಶಿಟ್ಟಥೈನ ಸುತ್ತೆ ತ್ಯುನೊನೆ ದೆಕಿನ ಹತ್ತ ಕುಕ್ಹಾಯಲ ಮನಕ್ಹನೆ ತಾರೊ ಹತ್ತ ಅಗೊ ಕರ ಕೈನ ಕದ್ಯೊ. ತೆ ಹತ್ತ ಅಗೊ ಕರ‍್ಯೊ ಹತ್ತ ಅರಾಮ ಥಯು. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />ಫರಿಸಾಯರೊ ಭಾರಾಗಯಲ ಬರೊಬ್ಬರ ಹೆರೊದ್ಯನಾ ಗುಂಪನಾ ಕ್ಹಾತೆ ಮಳಿನ ಯೆಸುನೆ ಕೈ ಉಪಾಯಕ್ಹು ಖಲಾಸ ಕರಿಯೆ ಕೈನ ತಿನಾ ವಿರುದ್ದ ವಿಚಾರ ಕರ‍್ಯಾ.<verse eid="MRK 3:6" /></para>
  <para style="s1">ಸಮುಂದರನಿ ದಂಡಿಪರ ಮನಕ್ಹೊನು ಗುಂಪ</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />ತೆ ಥಯಲ್ಪರ ಯೆಸು ತಿನಾ ಶಿಷ್ಯಾವೊನಾ ಕ್ಹಾತೆ ತೆ ಜ಼ಗಾ ಛೊಡಿನ ಸಮುಂದರನಾ ನಜಿಕ ಗಯೊ. ಗಲಿಲಾಯ ಗಾಮತಾ ಘನ್ನಾ ಮನಕ್ಹೊ ತಿನಾ ಪಾಚಾ಼ ಗಯಾ. <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />ಎನೈಸೊ ಯೆಸು ಹವಾ-ಹವಾ ಕಾಮೊ ಕರಸ ಕೈನ ಐಕಿನ ಗಲಿಲಾಯ ಪ್ರಾಂತ್ಯ ಯುದಾಯಾ ಪ್ರಾಂತ್ಯಮಾತಾಬಿ ಯೆರುಸಲೆಮಾತಾಬಿ ಇದೊಮಾಯಾ ಪ್ರಾಂತ್ಯಮಾತಾಬಿ ಯೊರ್ದನ ನದಿನಾ ಬಾಜು಼ಮಾತಾಬಿ ತೊರ ಸಿದೊನ ಗಾಮತಾಬಿ ಗಾಮನಾ ಸುತ್ತೆ ರ‍್ಹಯಲವಾಲಾ ಯೆಸುಕನ ಆಯಾ. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />ಮನಕ್ಹೊ ಗುಂಪ ಥಯಲಕ್ಹು ತಿಪರ ಪಡಿ ಜಾ಼ವಸ ಕೈನ ಯೆಸು ಯಕ್ಕ ನ್ಹಾನೊ ಹಡಗೊ ತಯ್ಯಾರ ಕರಲಿವೊ ಕೈನ ತಿನಾ ಶಿಷ್ಯಾವೊನೆ ಕದ್ಯೊ. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />ಕಾಕದ್ಯಾಮ ಯೆಸು ಘನ್ನಾ ರೊಗಿಯೊನೆ ಅರಾಮ ಕರಲಹುತಿ ರೊಗಮಾ ರ‍್ಹಯಲವಾಲಾನೆ ಘನ್ನಾ ಮನಕ್ಹೊನೆ ತಿನೆ ಮುಟ್ಟಾನಾ ಹುತಿ ತಿನೆ ಢಕ್ಲಾಡಾತಾ. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />ವರಿ ಕೆಟ್ಟ ಆತ್ಮಾ ಧರಲ ಮನಕ್ಹೊ ಯೆಸುನೆ ದೆಕಲ ಬರೊಬ್ಬರ ತಿನಾ ಪಗೊಮಾ ಪಡಿಜಾ಼ತಾತಾ ತು ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ವ್ಹೈ ಕೈನ ವದರತಾತಾ. <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />ವರಿ ತಿಮ್ಮ ರ‍್ಹಯುತಬಿ ಕೆಟ್ಟ ಆತ್ಮಾವೊನೆ ಮಿ ಹವೊಜ಼ ವ್ಹೈ ಕೈನ ಕಿನೆಜ಼಼ ಕೌ ನೈ ಕೈನ ತಾಕಿತ ಕರಿನ ಕವಾಡೊತೊ.<verse eid="MRK 3:12" /></para>
  <para style="s1">ಯೆಸು ಬಾರಾ ಅಪೊಸ್ತಲೊನೆ ಇನಿಲಿದಲ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ಮತ್ತಾಯ 10:1-4</ref>; <ref loc="LUK 6:12-16">ಲುಕ 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />ತೆ ಥಯಲ್ಪರ ಯೆಸು ಡೊಂಗರಪರ ಚ಼ಡಿನ ತಿನೆ ಚಾ಼ಯೆಥಯಲವಾಲಾವೊನೆ ತಿಕನ ಬಲಾಯೊ. ತ್ಯುನೆ ತಿಕನ ಆಯಾ. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />ಯೆಸು ತಿನೆ ಚಾ಼ಯೆ ಥಯಲ ಬಾರಾ ಜ಼ನಾವೊನೆ ಇನಿಲಿನ ತ್ಯುನೊನೆ ಅಪೊಸ್ತಲೊ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ ತ್ಯುನೊನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ ಮಿ ತುಮೊನೆ ಇನಿಲಿದಲ ವ್ಹೈ ತುಮೆ ಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹೌ ಕೈನ, ವರಿ ತುಮೆ ಗೈನ ಕ್ಹುದಾನಿಯೊ ವಾತೊ ಕವಾನಾಹುತಿ ಮೊಕ್ಲುಸ, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />ಇನಾನಿಂಗತ ತ್ಯುನೊನೆ ಕೆಟ್ಟ ಆತ್ಮಾ ಛೊಡಾವಾನಿ ಅದಿಕಾರ ಮಳಸ.<verse eid="MRK 3:15" /></para>
  <para style="li4">
    <verse number="16" style="v" sid="MRK 3:16" />ಯೆಸು ಇನಿಲಿದಲ ಬಾರಾ ಜ಼ನಾ ಅಪೊಸ್ತಲೊನಾ ನಾಮೊ ಅಮ್ಮ ಛೆ.</para>
  <para style="li1" vid="MRK 3:16">ಸಿಮೊನ (ಪೆತ್ರಾ) ಸಿಮೊನ ಕವಾಲಾನೆ ಪೆತ್ರಾ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ.<verse eid="MRK 3:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="MRK 3:17" />ಜ಼ೆಬೆದಾಯನೊ ದಿಕ್ರೊ ಥಯಲ ಯಾಕೊಬನೆ ವರಿ ಯಾಕೊಬನೊ ನ್ಹಾನೊ ಬೈ ಯೊಹಾನ. ಯೆಸು ತ್ಯುನೊನೆ ಬೊವನೆರಗಸ ನಾಮ ಮ್ಹೆಲ್ಯೊ ಕದ್ಯಾಮ ಬಿಜ್ಲಿನಾ ಬಚ್ಚಾ಼ ಕೈನ ನಾಮ ಮ್ಹೆಲ್ಯೊ ಉಗ್ರಲ ಕುನ್ನ ವ್ಹೈ ಕದ್ಯಾಮ,<verse eid="MRK 3:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="MRK 3:18" />ಅಂದ್ರೆಯಾ</para>
  <para style="li1" vid="MRK 3:18">ಫಿಲಿಪ್ಪ</para>
  <para style="li1" vid="MRK 3:18">ಬಾರ್ತೊಲೊಮಾಯಾ</para>
  <para style="li1" vid="MRK 3:18">ಮತ್ತಾಯ</para>
  <para style="li1" vid="MRK 3:18">ತೊಮ</para>
  <para style="li1" vid="MRK 3:18">ಅಲ್ಫಾಯನೊ ದಿಕ್ರೊ ಥಯಲ ಯಾಕೊಬ</para>
  <para style="li1" vid="MRK 3:18">ತದ್ದಾಯಾ</para>
  <para style="li1" vid="MRK 3:18">ದೆಶನೊ ಅಭಿಮಾನಿ ಕೈನ ನಾಮ ಪಡಲ ಸಿಮೊನ.<verse eid="MRK 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="MRK 3:19" />ವರಿ ಯೆಸುನೆ ಧರಿನ ದಿದಲ ಇಸ್ಕರಿಯುತ ಯುದ ಇವ್ನೆ ವ್ಹೈ.<verse eid="MRK 3:19" /></para>
  <para style="s1">ಯೆಸು ವರಿ ಬೆಲ್ಜೆಬೊಲ</para>
  <para style="r">(<ref loc="MAT 12:22-32">ಮತ್ತಾಯ 12:22-32</ref>; <ref loc="LUK 11:14-23">ಲುಕ 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />ಯೆಸು ಘರಮಾ ಜಾ಼ತಾಮಾ ಮನಕ್ಹೊನು ಮ್ಹೊಟು ಗುಂಪ‍ ಆತಾಮಾ ಯೆಸುನೆ ವರಿ ತಿನಾ ಶಿಷ್ಯಾವೊನೆಬಿ ಖಾವಾನೆ ಟೈಮ ಮಳ್ಯೊ ನೈ. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />ಎ ಐಕಿನ ತಿನಾ ಕಳ ಬಳ ಯೆಸುನೆ ಘರೆ ಲಾವಾನಾಹುತಿ ಧರಾನೆ ಗಯಾ. ಕಾಕದ್ಯಾಮ ಮನಕ್ಹೊ ತಿನೆ ಪಿಸಾಳೊ ಥೈಗಯೊಸ ಕವಾಡಾತಾ.<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />ಎನೈಸೊ ಯೆರುಸಲೆಮತಾ ಆಯಲ ಶಾಸ್ತ್ರಿಯೊ ತಿನೆ, ಬೆಲ್ಜೆಬೊಲ ತಿಮಾ ಛೆ, ತೆ ಕೆಟ್ಟ ಆತ್ಮಾವೊನೊ ಮಾಲಕ ತಿನಿ ತಾಕತಕ್ಹು ಕೆಟ್ಟ ಆತ್ಮಾವೊನೆ ಛೊಡಾವಸ” ಕದ್ಯಾ.<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />ಯೆಸು ತ್ಯುನೊನೆ ನಜಿ಼ಕ ಬಲೈನ, ತ್ಯುನೊನೆ ಸಾಮ್ಯ ರುಪಮಾ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ, ಸೈತಾನ ಕೆಟ್ಟ ಆತ್ಮಾನೆ ಕಿಮ್ಮ ನ್ಹಟಾಡಸ?” <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />ಯಕ್ಕ ರಾಜ್ಯಮಾ ತಿಮಾ ಭೆದಹುಟ್ಯುಮ, ತೆ ರಾಜ್ಯ ಉಗರತು ನೈ. ತೆ ರಾಜ್ಯ ಬೆ ಭಾಗ ಥೈ ಜಾ಼ವಾಸ. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />ಯಕ್ಕ ಘರಮಾ ಭೆದಹುಟ್ಯುಮ, ತೆ ಘರ ಬೆ ಭಾಗ ಥಾವಸ. ಕಯಾ ಘರಮಾ ಮನಕ್ಹೊ ಲಡೈ ಕರಸ ತೆ ಘರ ಹುಬ್ರೆತು ನೈ. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />ತಿನಾನಿಂಗತಜ಼ ಸೈತಾನನಾ ರಾಜ್ಯಮಾ ಭೆದಹುಟ್ಯುಮ, ಭಾಗ ಥೈ ಜಾ಼ವಸ. ಎ ಘನ್ನಾ ದಿನ್ನ ಉಗರತು ನೈ ವರಿ ತ್ಯುನೆ ನಾಶ (ಹಾಳ) ಥೈ ಜಾ಼ವಸ. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />ಎನೈಸೊ ಯಕ್ಲೊ ತಾಕತವಾಲಾನಾ ಘರಮಾ ವ್ಹಕ್ಕಿನ ಪೈಲಾ ತಿನೆ ಭಾಂದ್ಯಾವಾಚಿ ತಿನಿ ಆಸ್ತಿ ಚೊ಼ರಿ ಕರಾನೆ ಥಾತು ನೈ. ಪೈಲಾ ತಿನೆ ಭಾಂದಿಲಿದಲಪರ ತಿನು ಘರ ಲುಟಿ ಕರಾನೆ ಥಾವಸ. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />ತೆ ತ್ಯುನೊನೆ ಮಿ ತುಮೊನೆ ಕ್ಹರಿಜ಼ ಸು ಕೌಸ ಕದ್ಯಾಮ, ಮನಕ್ಹೊ ಕರಾನಾ ಪುರಾ ಪಾಪೊನೆ ವರಿ ಕ್ಹಾರಾ ಪಾಪೊಕ್ಹುಬಿ ಮಾಫಿ ಮಳಸ. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />ತೆನೈಸೊ ಪವಿತ್ರ ಆತ್ಮಾನೆ ದೊಶದಿವಾಲಾನೆ ಕೆಳಾಮಾಜ಼ ಮಾಫಿ ನೈ ಮಳ್ತಿ. ತೆ ಹಮೆಶಾಬಿ ಪಾಪನೊ ಅಪರಾದಿ ಥಾವಸ ಕೈನ ಯೆಸು ಕದ್ಯೊ.<verse eid="MRK 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30" />ಕಾಕದ್ಯಾಮ ಮನಕ್ಹೊ ಇನೆ ಕೆಟ್ಟ ಆತ್ಮಾ ಧರ‍್ಯುಸ ಕದ್ಯಾತಾ.<verse eid="MRK 3:30" /></para>
  <para style="s1">ಯೆಸುನಿ ಮಾ ವರಿ ಭಾಯೊ</para>
  <para style="r">(<ref loc="MAT 12:46-50">ಮತ್ತಾಯ 12:46-50</ref>; <ref loc="LUK 8:19-21">ಲುಕ 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />ಮನಕ್ಹೊ ತಿನಾ ಸುತ್ತೆ ಬೈಟತಾಮಾ ತಿನಿ ಯಾಬಿ ಭಾಯೊಬಿ ಐನ ಭಾರಾ ಹುಬ್ರೈನ ಯಕ್ಲಾನೆ ಬಲಾವಾನೆ ಮೊಕ್ಕಲ್ಯಾ. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />ತೆ ಮನಕ್ಹ ತಿನೆ ತಾರಿ ಯಾ ತಾರಾ ಭಾಯೊ ವರಿ ಭೆನೊ ತುನೆ ಹುಡಕ್ತಾ ಐನ ಭಾರಾ ಹುಬ್ರಾಯಾಸ ದೆಕ ಕೈನ ಕದ್ಯೊ.<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />ತಿನಾಹುತಿ ಯೆಸು, ಮಾರಿ ಯಾ ಮಾರಾ ಭಾಯೊ ಕುನ್ನ ವ್ಹೈ? ಕೈನ ಪುಚ್ಯೊ.<verse eid="MRK 3:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34" />ಪಾಚ಼ಲ್ತೊ ಯೆಸು, ತಿನಾ ಸುತ್ತೆ ಬೈಟಲವಾಲಾವೊನೆ ದೆಕಿನ ಅವ್ನೆಜ಼ ಮಾರಿ ಯಾ ವರಿ ಮಾರಾ ಭಾಯೊ ವ್ಹೈ. <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />ಕ್ಹುದಾನಿ ಚಿ಼ತ್ತನಿಂಗತ ಚಾ಼ಲಾಲಾ ಮಾರಿ ಯಾ ವರಿ ಮಾರಾ ಭಾಯೊ ಭೆನೊ ವ್ಹೈ ಕೈನ ಕದ್ಯೊ.<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s1">ಬಿತ್ತಾಲಾನಿ ಸಾಮ್ಯ</para>
  <para style="r">(<ref loc="MAT 13:1-9">ಮತ್ತಾಯ 13:1-9</ref>; <ref loc="LUK 8:4-8">ಲುಕ 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />ಯೆಸು ಫರಿನ ಸಮುಂದರನಿ ದಂಡಿಕನ ಉಪದೆಶ ಕರತೊ ವ್ಹತ್ತೊ ಘನ್ನಾ ಜ಼ನಾ ತಿಕನ ಮಳಿನ ಆಯಲಕ್ಹು ತೆ ಸಮುಂದರಮಾ ರ‍್ಹಯಲ ಹಡಗಾಮಾ ಚ಼ಡಿನ ಬೈಟ್ಯೊ. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />ತೆ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಸಮುಂದರನಿ ಬಾಜು಼ನಿ ಜ಼ಗಾಪರ ಹುಬ್ರಯಾತಾ ತೆಳಾಮಾ ತೆ ತ್ಯುನೊನೆ ತ್ಯುನಾ ಕ್ಹಾಮೊಜ಼ ತಿವ್ನಾಹುತಿ ಸಾಮ್ಯಲಿನ ಉಪದೆಶ ಕರ‍್ಯೊ. ತೆ ಉಪದೆಶ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ. <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />ಧ್ಯಾನ ದಿನ್ನ ಐಕೊ, ಬಿತ್ತಾಲೊ ಬಿತ್ತಾನೆ ತಿನಾ ಖೆತರಮಾ ಗಯೊ. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />ತಿಮ್ಮ ತೆ ಬಿಯ್ಯಾ ಬಿತತಾಮಾ ದಕ್ಹಾ ಬಿಯ್ಯಾ ವಾಟಪರ ಪಡ್ಯಾ. ಪಕ್ಷಿಯೊ ಐನ ತೆ ಬಿಯ್ಯಾ ಖೈಪಾಡಿಯೊ. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />ಬಿಜಾ಼ ದಕ್ಹಾ ಬಿಯ್ಯಾ ಮಾತಿ ಕಮ ರ‍್ಹಯಲ ದಗ್ಡಾವೊಪರ ಪಡ್ಯಾ. ವರಿ ಮಾತಿ ಕಮ ರ‍್ಹಯಲಕ್ಹು ತೆ ಭೆಗಿನ ಬೆಳದ್ಯಾ. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />ವರಿ ತಡಕೊ ತಿವ್ನೊಪರ ಪಡ್ತಾಮಾ ಬೆಳದಾತಿ ಅಗ್ದುರಜ಼ ಕುಕ್ಹೈ ಗಯಾ. ಕಾಕದ್ಯಾಮ ತ್ಯುನಿಯೊ ಬೆರ ಘಟ್ಟ ನ್ಹೊತಿಯೊ. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />ತೆ ಬಿಯ್ಯಾ ದಕ್ಹಾ ಬೆಳದ್ಯಾ ಕಾಟಾವೊನಿಯೊ ಕಂಠಿಯೊ ತ್ಯುನೊನೆ ಝಾಕಿಪಾಡ್ಯಾ ತೆ ಬಿಯ್ಯಾ ಫಲ ದಿದ್ಯಾನೈ. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />ಹಜು಼ನ ದಕ್ಹಾ ಬಿಯ್ಯಾ ಚೊ಼ಕಿ ಜಿಮಿನ್ಪರ ಪಡ್ಯಾ ತೆ ಬೆಳದಿನ ಮುವತ್ತ ಯಕ್ಲಾ ಯಕ್ಕ ಕ್ಹಾಟ ಯಕ್ಲಾ ಕ್ಹೊ ಯಕಲಾ ಫಲದಿದ್ಯಾ.<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />ವರಿ ಯೆಸು ಇಮ್ಮ ಕದ್ಯೊ ಕಾನೊ ರ‍್ಹಯವಾಲಾ ಧ್ಯಾನ ದಿನ್ನ ಐಕಾದೆ ಕದ್ಯೊ.<verse eid="MRK 4:9" /></para>
  <para style="s1">ಕಾನಿನಿ ಉದ್ದೆಶ</para>
  <para style="r">(<ref loc="MAT 13:10-17">ಮತ್ತಾಯ 13:10-17</ref>; <ref loc="LUK 8:9-10">ಲುಕ 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />ತೆಳಾಮಾ ಯೆಸು ಯಕ್ಲೊ ರ‍್ಹತಾಮಾ ತಿಕನ ರ‍್ಹಯಲ ಬಾರಾ ಶಿಷ್ಯಾವೊನಾ ಕ್ಹಾತೆ ಬಿಜಾ಼ ದಕ್ಹಾ ಜ಼ನಾ ತೆ ಸಾಮ್ಯನಾಹುತಿ ಹಮೊನೆ ತಿಳಸಿನ ದೆ ಕೈನ ಮಾಂಗಿಲಿದ್ಯಾ. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />ಯೆಸು ತ್ಯುನೊನೆ ಕ್ಹುದಾನಿ ರಾಜ್ಯನು ಗುಟ್ಟ ತುಮ್ನೊನೆ ದಿದ್ಯೊಸ ; ಭಾರಲ್ಯಾವೊನೆ ಸಾಮ್ಯ ನಿಂಗತ ಕವಸ. <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />ತಿನಾಹುತಿ</para>
  <para style="q1" vid="MRK 4:12">ತ್ಯುನಾ ಡೊಳಾ ರ‍್ಹೈತಬಿ ದೆಕತಾ ನೈ.</para>
  <para style="q2" vid="MRK 4:12">ಕಾನೊ ರ‍್ಹೈನ ಐಕ್ಯಾತಬಿ ತ್ಯುನೆ ತಿಳದಿಲೆತಾನೈ</para>
  <para style="q1" vid="MRK 4:12">ತಿಮ್ಮ ದೆಕಿನ ಐಕಿನ ತಿಳದಿಲಿದ್ಯಾಮ. ತ್ಯುನೆ ಕ್ಹುದಾಕನ ಫರಿನ ಕರಲ ಪಾಪನೆ ಕೈಲಿನ ಮಾಫಿ ವ್ಹಂದಸ.<verse eid="MRK 4:12" /></para>
  <para style="s1">ಯೆಸು ಬಿತ್ತಾಲಾನಿ ಸಾಮ್ಯ ಕದಲ</para>
  <para style="r">(<ref loc="MAT 13:18-23">ಮತ್ತಾಯ 13:18-23</ref>; <ref loc="LUK 8:11-15">ಲುಕ 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />ತೆಳಾಮಾ ಯೆಸು ತ್ಯುನೊನೆ ಪುಚ್ಯೊ ತೆಜ಼ ವಾತ ತುಮೊನೆ ನೈ ಗ್ವತ್ತ ಥೈಯುಮ? ಬಿಜಿ಼ ಕೈ ವಾತ ತುಮೊನೆ ಕಿಮ್ಮ ಗ್ವತ್ತ ಥಾವಸ? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />ತೆ ಬಿತ್ತಾಲೊ ಕ್ಹುದಾನಿಯೊ ವಾತೊ ಕವಾನಾ ಬಿಯ್ಯಾ ಬಿತ್ತಸ. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />ದಕ್ಹಾ ಜ಼ನಾ ವಾಟಪರ ಪಡಲ ಬಿಯ್ಯಾ ನಿಂಗತ ರ‍್ಹವಸ ಕ್ಹುದಾನಿ ವಾತೊ ಐಕಲ ಬರೊಬ್ಬರ ಸೈತಾನ ಐನ ತ್ಯುನಾಮಾ ರ‍್ಹಯಲ ಕ್ಹುದಾನಿ ವಾತೊ ಕಾಳ್ಳಿನ ಗೈ ಪಡಸ. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />ದಕ್ಹಾ ಜ಼ನಾ ದಗ್ಡಾಪರ ಪಡಲ ಬಿಯ್ಯಾ ನಿಂಗತ ರ‍್ಹವಸ. ತಿಮ್ಮ ತೆ ಮನಕ್ಹೊ ಕ್ಹುದಾನಿಯೊ ವಾತೊ ಐಕಲ ಬರೊಬ್ಬರ ಖುಶಿಕ್ಹು ರ‍್ಹವಸ. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />ತಿವ್ನೊಮಾ ಬೆರ ಘಟ್ಟನೈ ರ‍್ಹಯಲಕ್ಹು ಇವ್ನೆ ದಕ್ಹಾ ಟೈಮಾ ರ‍್ಹೈನ ಪಾಚಾ಼ತಾ ಕ್ಹುದಾನಿಯೊ ವಾತೊನಾಹುತಿ ತ್ರಾಸ ಉರಸಾವಾನು ಐಯುಮ ಛೊಡಿಪಾಡಸ. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />ಹಜು಼ನ ದಕ್ಹಾ ಜ಼ನಾ ಕಾಟಾನಿಯೊ ಕಂಟಿಯೊಮಾ ಪಡಲ ಬಿಯ್ಯಾ ನಿಂಗತ ರ‍್ಹವಸ. ಎ ಮನಕ್ಹೊ ಹವಾವೈ ಕ್ಹುದಾನಿಯೊ ವಾತೊ ಐಕಸ <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />ವರಿ ತ್ಯುನಿ ಜಿವ್ನಾನಾಹುತಿ ಚಿಂತಾ ಕರಸ, ದೊಕಡಾವೊಪರ ಆಸ, ವರಿ ಆಸ್ತಿನಿ ಆಸಮಾ ತೆ ಕ್ಹುದಾನಿಯೊ ವಾತೊನೆ ದಾಬಿಪಾಡಸ ತೆ ಫಲ ದೆತಾ ನೈ.<verse eid="MRK 4:19" /></para>
  <para style="s1">ಹಂಡ್ಲಾನಾ ಹೆಟೊ ದಿವ್ವೊ</para>
  <para style="r">(<ref loc="LUK 8:16-18">ಲುಕ 8:16-18</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 4:20" />ವರಿ ದಕ್ಹಾ ಜ಼ನಾ ಕ್ಹುದಾನಿಯೊ ವಾತೊ ಐಕಿನ ಕೈದಿಲಿನ ಮುವತ್ತ ಯಕ್ಲಾ ಕ್ಹಾಟ ಯಕ್ಲಾ ಕ್ಹೊ ಯಕ್ಲಾ ಫಲದಿವಾಲಾ ಥಾವಸ. ಇವ್ನೆಜ಼ ಚೊ಼ಕಿ ಜಿಮಿನ್ಪರ ಪಡಲ ಬಿಯ್ಯಾ ನಿಂಗತ ರ‍್ಹವಸ.<verse eid="MRK 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />ಯೆಸು ತ್ಯುನೊನೆ ಕದ್ಯೊ ದಿವ್ವೊ ಲೈನ ಹಂಡ್ಲಾನಾ ನೈತೊ ಪಲಂಗನಾ ಹೆಟಾ ಮುಕ್ಕೊಶಿ ಸು? ನೈ ಮ್ಹೆಲ್ತಾ, ಉಜಾಲು ಪಡಾನಾಹುತಿ ಉಪ್ಪರಲಿ ಜ಼ಗಾಜ಼ ಮ್ಹೆಲಸ್ತೊ. <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />ಸು ದಡಲ ರ‍್ಹವಸ ತಿನೆ ಕ್ಹಾರಾವೊನಾ ಕ್ಹಾಮೊ ಲಾವಸ ವರಿ ಸು ಝಾಕ್ಯಾಸ ತೆ ಖುಲ್ಲಾ ಥಾವಸ. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />ಐಕಾನೆ ಕಾನೊ ರ‍್ಹಯಲವಾಲಾ ಐಕಾದೆ. ಎಬಿ ತ್ಯುನೊನೆ ಕದ್ಯೊ ಧ್ಯಾನ ದಿವೊ.<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />ತುಮೆ ಕಯಾ ಪದ್ದತಿಕ್ಹು ಬಿಜಾ಼ವೊನೊ ಫೈಸಲೊ ಕರೊಶಿ ತೆಜ಼ ಪದ್ದತಕ್ಹು ಕ್ಹುದಾ ತುಮಾರೊ ಫೈಸಲೊ ಕರಸ ವರಿಬಿ ತಿತ್ತಿಬಿ ಘನ್ನು ಥಾವಸ. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />ಕುನ್ನ ಮಾರಾ ಉಪದೆಶನೆ ಕಾನ ದಿನ ಐಕಸ ತ್ಯುನೊನೆ ಬೆ ಅಕ್ಲು ಹೆಚ್ಕಿ ಗ್ವತ್ತ ಥಾವಸ ಕುನ್ನ ಕಾನ ದಿನ ನೈ ಐಕ್ತು ತ್ಯುನೊಕಂತು ರ‍್ಹಯಲಬಿ ಕಾಳ್ಳಿಪಾಡಸ.<verse eid="MRK 4:25" /></para>
  <para style="s1">ಬೆಳ್ದಾನಾ ಬಿಯ್ಯಾನಿ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />ವರಿ ಯೆಸು ಕದ್ಯೊ, ಕ್ಹುದಾನೊ ರಾಜ್ಯ ಇನಾನಿಂಗತ ಛೆ ಯಕ್ಕ ಮನಕ್ಹ ಬಿಯ್ಯಾ ಜಿಮಿನಮಾ ಘಾಲಿನ. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />ರಾತೆ ತೆ ಕ್ಹುರೈನ ಪಾಟೆ ಉಟ್ತಾಮಾ ತೆ ಬಿಯ್ಯೊ. ಮಡಿಕಿ ಫುಟಿನ ಬೆಳದಸ ವರಿಬಿ ತೆ ಬೆಳದಾನು ತಿನೆ ಗ್ವತ್ತ ನೈ ಥಾತು. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />ಮಾತಿ ಝಾಡನೆ ಬೆಳದಾನಾಹುತಿ ವರಿ ಫಲ ದಿವಾನೆ ಸಹಾರೊ ಕರಸ. ಪೈಲಾ ಬಿಯ್ಯು ತೆ ಫುಟಸ ಪಾಚ಼ಲ್ತೊ ತೆ ಬುಟ್ಟು ಥಾವಸ ವರಿ ತಿನು ಪುರಾ ಬುಡ ಕಾಳೊ ಥೈ ಜಾ಼ವಸ. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />ಕೆಳಾಮಾ ಬಿಯ್ಯೊ ಪಾಕಸ ತೆಳಾಮಾ ಮನಕ್ಹೊ ದಾತಡೆ ಕಾಟಸ ಕಾಕದ್ಯಾಮ ಕಾಟಾನೊ ಟೈಮ ಐ ಜಾ಼ವಸ.<verse eid="MRK 4:29" /></para>
  <para style="s1">ಸಾಸವಿ ಬಿಯ್ಯಾನಿ ಸಾಮ್ಯ</para>
  <para style="r">(<ref loc="MAT 13:31-32">ಮತ್ತಾಯ 13:31-32</ref>,<ref loc="MAT 13:34-35">34-35</ref>; <ref loc="LUK 13:18-19">ಲುಕ 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />ಹಜು಼ನ ತೆ ಕದಲ ಕ್ಹುದಾನಿ ಯಕ್ಕ ರಾಜ್ಯ ಕಿನೆ ಹೊಲ್ಸಿಯೆ? ವರಿ ಯೆಸು ಪುಚ್ಯೊ ಎ ತಿಳಸಾನೆ ಕಯು ಸಾಮ್ಯ ಉಪಯೊಗ ಕರಿಯೆ? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />ತೆ ತಿಮ್ಮಶೆ ಯಕ್ಲೊ ಸಾಸವಿನೊ ಬಿಯ್ಯೊ ಲಿವಸ. ತೆ ದುನಿಯಾಮಾ ಕ್ಹಾರಾವೊತಿ ನ್ಹಾನೊ ರ‍್ಹವಸ ತೆ ಜಿಮಿನ್ಪರ ನ್ಹಾನು ಝಾಡಥಾವಸ. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />ತೆ ಬಿತ್ತಲಪರ ತೆ ಬೆಳದಿನ ಕ್ಹಾರಾ ಭಾಜಿ ಪಾಲೊನಾ ಝಾಡೊತಿಬಿ ತೆ ಮ್ಹೊಟಾ-ಮ್ಹೊಟಾ ಠೊಂಗಿಯೊ ಛೊಡಿನ ಹಬಾಳಮಾ ಉಡಾನಿಯೊ ಪಕ್ಷಿಯೊ ತಿನಿಯೊ ಠೊಂಗಿಯೊನಿ ಛವ್ಲಿಮಾ ಮಾಚೊ಼ ಕರಲಿವಸ.<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />ಯೆಸು ತ್ಯುನೊನೆ ಇಮ್ಮ ಘನಿಯೊ ತರಾನಿಯೊ ವಾತೊಮಾ ಮನಕ್ಹೊ ತಿಳದಿಲಿವಾದೆ ಕೈನ ಕ್ಹುದಾನಿ ವಾತೊ ಕತೊತೊ. ಕಾನಿ ನೈಸೊ ಸುಜ಼ ತ್ಯುನೊನೆ ಕತೊ ನ್ಹೊತೊ ಕಾಕದ್ಯಾಮ ತ್ಯುನೆ ತಿಳದಿಲಿವಾದೆ ಕೈನ ಕತೊತೊ. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />ಯೆಸು ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲ್ತಾಮಾ ಸಾಮ್ಯಲಿನ ಕತೊತೊ. ತೆನೈತೊ ಯೆಸು ಯಕ್ಲೊ ರ‍್ಹತಾಮಾ ತಿನಾ ಶಿಷ್ಯಾವೊನೆ ಕ್ಹಾರು ಫೊಡಿನ ಕತೊತೊ.<verse eid="MRK 4:34" /></para>
  <para style="s1">ಯೆಸು ತುಫಾನ ಶಾಂತ ಕರಲ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ಮತ್ತಾಯ 8:23-27</ref>; <ref loc="LUK 8:22-25">ಲುಕ 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />ತೆ ದಿನ್ನೆ ಕ್ಹಾಂಜ಼ ಥಾತಾಮಾ ಯೆಸು ತಿನಾ ಶಿಷ್ಯಾವೊನೆ ಸಮುಂದರನಿ ಬಿಜಿ ದಂಡಿಯೆ ಗಯ್ಯೆ ಕದ್ಯೊ. <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />ತ್ಯುನೆ ಮನಕ್ಹೊನು ಗುಂಪ ಛೊಡಿನ ಗಯಾ ಶಿಷ್ಯಾ ಹಡಗಾಮಾ ಗಯಾ ಕಾಕದ್ಯಾಮ ತೆಳಾಮಾಜ಼ ಯೆಸು ತಿಮಾ ಬೈಟ್ಯೊತೊ ವರಿ ತಿನೆ ತ್ಯುನೆ ಬಲೈ ಲಿಂಗಯಾ ಬಿಜಾ಼ ಹಡಗಾಬಿ ತ್ಯಾ ವ್ಹತ್ತಾ. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />ತ್ಯುನೆ ಜಾ಼ತಾಮಾ ಯಕಾಕಿಜ಼ ತುಫಾನನೊ ಝೊರ ವಾರೊ ಆತಾಮಾ ಧಡಕಿಯೊ ಉಟಿಯೊ ಹಡಾಗಾನೆ ಲಾಗಿನ ತಿಮಾ ಪಾನಿ ಭರಾಡುತು. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />ಯೆಸು ಹಡಗಾಮಾ ಪಾಚೊ಼ ಮಟ್ಲು ಘಾಲ್ಲಿನ ಧಡ ನಿಂದರ ಕರಾಡೊತೊ. ತ್ಯುನೆ ಯೆಸುನೆ ಗುರು ಉಟ ಅಪೆ ಮರಿಗಿಯೆಸ? ತುನೆ ಚಿಂತಾ ನತ್ತಿ ಸು ಕೈನ ಪುಚ್ಯಾ.<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />ಯೆಸು ಉಟಿನ ತುಫಾನನೆ ಬರಬಡ್ಯೊ ವರಿ ಧಡಕಿಯೊನೆ ಗಪರ‍್ಹೆ ಶಾಂತ ಥಾ ಕೈನ ಕತಾಮಾ ತೆ ತುಫಾನ ಹುಬ್ರೈಪಡ್ಯು ಕ್ಹಾರು ಶಾಂತಥಯು.<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />ತೆಳಾಮಾ ಯೆಸು ತಿನಾ ಶಿಷ್ಯಾವೊನೆ ತುಮೆ ಕಾ ಇಮ್ಮ ಭುಚ್ಕೊ಼ಸಿ? ತುಮೊನೆ ಹಜು಼ನಬಿ ಬರೊಕ್ಹೊ ನತ್ತಿ ಸು ಕದ್ಯೊ?<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />ಶಿಷ್ಯಾ ಘನ್ನಾ ಭುಚ಼ಕಿನ ಆಂ ಮನಕ್ಹ ಕುನ್ನ ವ್ಹೈ? ವಾರೊಬಿ ವರಿ ಸಮುಂದರನಿಯೊ ಧಡಕಿಯೊಬಿ ಇನಿ ವಾತ ಐಕಸ್ತೊ ಕೈನ ತ್ಯುನೆ ಯಕೆಕ್ಲಾಜ಼ ಬೊಲ್ಲಿದ್ಯಾ.<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s1">ಯೆಸು ಕೆಟ್ಟ ಆತ್ಮಾ ಧರಲವಾಲಾನೆ ಅರಾಮ ಕರಲ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ಮತ್ತಾಯ 8:28-34</ref>; <ref loc="LUK 8:26-39">ಲುಕ 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />ಪಾಚಾ಼ತಾ ತ್ಯುನೆ ಸಮುಂದರನಿ ಬಿಜಿ ದಂಡಿಯೆ ರ‍್ಹಯಲ ಗೆರೆಸಿನೆರ ಪ್ರಾಂತ್ಯನೆ ಮುಟ್ಯಾ. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />ಯೆಸು ಹಡಗಾಮಾತೊ ಉತ್ರಿನ ಆಯಲ ಬರೊಬ್ಬರ ಕೆಟ್ಟ ಆತ್ಮಾ ಧರಲ ಯಕ್ಕ ದಾಣಗೊ ಮಜಾ಼ರೊನಿ ಗವಿಮಾತೊ ಯೆಸುನಾ ಕ್ಹಾಮೊ ಆಯೊ. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />ತೆ ಮಜಾ಼ರೊನಿಯೊ ಗವಿಯೊಮಾ ರ‍್ಹತೊತೊ ತಿನೆ ಭಾಂದಿನ ಘಾಲಾನೆ ಕಿನೆಜ಼಼ ಥಾತುನ್ಹೊತು. ತಿನೆ ಬೆಡಿಯೊಕ್ಹು ಭಾಂದ್ಯಾತಬಿ ಉಪಯೊಗ ಥಾತುನ್ಹೊತು. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />ಮನಕ್ಹೊ ಘನ್ನಿಸಲಾ ತಿನಾ ಹತೊ ಪಗೊ ಬೆಡಿಯೊಕ್ಹು (ಚೈನೊಕ್ಹು) ಭಾಂದ್ಯಾತಬಿ ವರಿಬಿ ತೆ ತೊಡಿಲಿನ ನಾಕಿಪಾಡತೊತೊ. ತಿನೆ ವರಿ ಕುನ್ನಜ಼ ಬೆಡಿಯೊ ಘಾಲಾನೆ ವರಿ ತಿನೆ ಹತೊಟಿಮಾ ಲಾವಾನೆ ಕುನ್ನಜ಼ ನ್ಹೊತು. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />ತೆ ದಿನ್ನ ರಾತ ಮಜಾರೊಮಾ ಗವಿಯೊಮಾ ರ‍್ಹತೊತೊ. ಡೊಂಗ್ರೊಮಾ ವದರತೊ ತಿನೊ ಅಂಗ ತೆಜ಼ ದಗ್ಡೆ ಛೆಟಿಲೆತೊತೊ.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />ತೆ ಯೆಸುನೆ ದುರತೊ ದೆಕಿನ ನ್ಹಾಟತೊ ಐನ ತಿನೆ ಉಂದೊ ಪಡಿನ ಝೊರ ವದ್ರಿನ <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />ಯೆಸು ಕ್ಹಾರಾವೊತಿ ಉಪ್ಪರ ರ‍್ಹಯಲ ಕ್ಹುದಾನಾ ದಿಕ್ರಾ ಮಾರಾ ಕ್ಹಾತೆ ಸು ಕರಶಿ? ಕ್ಹುದಾನಾಹುತಿ ತುಕನ ಮಾಂಗುಸ ಮನೆ ಶಿಕ್ಷಾ ನಕೊ ದ್ಯು <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />(ಕಾಕದ್ಯಾಮ ಎ ಕೆಟ್ಟ ಆತ್ಮಾ ಅನೆ ಛೊಡಿನ ಜಾ಼ ಕೈನ ಯೆಸು ಕದ್ಯೊ).<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />ವರಿ ಯೆಸು ತಿನೆ ತಾರು ನಾಮ ಸುವೈ ಕೈನ ಪುಚ಼ತಾಮಾ</para>
  <para style="p" vid="MRK 5:9">ತೆ ಮನಕ್ಹ ಕದ್ಯೊ ಮಾರು ನಾಮ ಗುಂಪ ವ್ಹೈ ಕಾಕದ್ಯಾಮ ಹಮೆ ಘನ್ನಾ ಕೆಟ್ಟ ಆತ್ಮಾವೊ ಛೆ ಕದ್ಯೊ. <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />ತ್ಯುನೆ ಯೆಸುಕನ ಹಮೊನೆ ಆಂ ಗಾಮಮಾತೊ ಮೊಕ್ಲು ನಕೊ ಕೈನ ಯೆಸುಕನ ಘನ್ನಾ ಮಾಂಗಿಲಿದ್ಯಾ.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />ತ್ಯಾಜ಼ ಡೊಂಗರಪರ ಯಕ್ಕ ಢುಕ್ಕುರೊನು ಮ್ಹೊಟು ಗುಂಪ ಚ಼ರಾಡುತು. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />ತೆ ಕೆಟ್ಟ ಆತ್ಮಾವೊ ಯೆಸುನೆ ಐಲಾ ಢುಕ್ಕುರೊಮಾ ಜಾ಼ವಾನೆ ಹಮೊನೆ ವಳಾ ಕೈನ ಮಾಂಗಿಲಿದ್ಯಾ. <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />ಯೆಸು ಥಯು ಜಾ಼ವೊ ಕೈನ ಕದ್ಯೊ. ತೆ ಕೆಟ್ಟ ಆತ್ಮಾವೊ ಮನಕ್ಹನಾ ಅಂಗಮಾತಾ ಭಾರಾ ಐನ ಢುಕ್ಕುರೊಮಾ ಗಯಾ. ತೆ ಢುಕ್ಕುರೊನು ಗುಂಪ ನ್ಹಾಟಿನ ಗೈನ ಡೊಂಗರಪರತಾ ಸಮುಂದರಮಾ ಪಡಿನ ಡುಬಿ ಗಯಾ. ಕಮ್ಮ ಜಾಸ್ತ ಬೆ ಹಜಾ಼ರ ಢುಕ್ಕುರೊ ವ್ಹತ್ತಾ.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />ತ್ಯುನೊನೆ ಚ಼ರಾವಾಲಾ ನ್ಹಾಟಿನ ಗೈನ ತೆ ಸುದ್ದಿ ಗಾಮಮಾ ವರಿ ಖೆತ್ರೊಮಾ ತಿಳಸಾತಾಮಾ ಮನಕ್ಹೊ ಸು ಥಯುಸ ಕೈನ ದೆಕಾನೆ ಚಾ಼ಲ್ಯಾ. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />ತ್ಯುನೆ ಯೆಸುಕನ ಆತಾಮಾ. ತೆ ಕೆಟ್ಟ ಆತ್ಮಾವೊ ಛೊಡಿನ ಗಯಲ ದಾಣಗಾನೆ ದೆಕಿನ ಬಾಜು಼ಮಾ ವಣ್ಣಾಘಾಲ್ಲಿನ ಚೊ಼ಕೊ ಥೈನ ಬೈಟಲ ದೆಕಿನ ಭುಚ಼ಕ್ಯಾ <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />ಎ ದೆಕಲವಾಲಾ ಕೆಟ್ಟ ಆತ್ಮಾವೊ ಧರಲವಾಲಾ ಮನಕ್ಹನಾ ಕ್ಹಾತೆ ಥಯಲ ವರಿ ಢುಕ್ಕುರೊನಾ ಕ್ಹಾತೆ ಥಯಲ ಮನಕ್ಹೊನೆ ತಿಳಶ್ಯಾ. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />ತ್ಯುನೆ ಗಾಮ ಛೊಡಿನ ಜಾ಼ ಕೈನ ಯೆಸುನೆ ಮಾಂಗಿಲಿದ್ಯಾ.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />ಯೆಸು ಹಡ್ಗೊ ಚ಼ಡತಾಮಾ ತೆ ಕೆಟ್ಟ ಆತ್ಮಾವೊ ಧರಿನ ಛೊಡಲವಾಲೊ ಮಿ ತಾರಾ ಕ್ಹಾತೆ ಔಸ ಕೈನ ತಿಕನ ಮಾಂಗಿಲಿದ್ಯೊ. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />ತೆ ತಿನೆ ರ‍್ಹವಾನೆ ದಿದ್ಯಾವಾಚಿ ತು ತಾರಾ ಘರೆ ತಾರಾ ಮನಕ್ಹೊಕನ ಜಾ಼ ಗೈನ ಸ್ವಾಮಿ ತುನೆ ಮರಗಿನ ತುನೆ ಕೆವು ಉಪಕಾರ ಕರ‍್ಯೊಸ ತೆ ವದ್ರಿನ ಕೆ. <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />ತೆ ಗೈನ ಯೆಸು ತಿನೆ ಕರಲ ಉಪಕಾರ ದಕ್ಹೆ ಗಾಮೊಮಾ ಕವಾನು ಶುರು ಕರ‍್ಯೊ ಐಕಿನ ಕ್ಹಾರಾ ಜ಼ನಾ ಘಾಬ್ರಾಥಯಾ.<verse eid="MRK 5:20" /></para>
  <para style="s1">ಯಾಯಿರನಿ ದಿಕ್ರಿ ವರಿ ಹೆಣ ಮನಕ್ಹ ಯೆಸುನಾ ವಣ್ಣಾ ಮುಟ್ಟಲ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ಮತ್ತಾಯ 9:18-26</ref>; <ref loc="LUK 8:40-56">ಲುಕ 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />ಯೆಸು ಫರಿನ ಹಡಗಾಮಾ ಸಮುಂದರನಿ ಬಿಜಿ ದಂಡಿಯೆ ಆತಾಮಾ ಮನಕ್ಹೊನು ಘನ್ನು ಗುಂಪ ತಿನಾ ಸುತ್ತೆ ಆಯಾ. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />ತೆಳಾಮಾ ಸಬಾಮಂದಿರಪರ ಅದಿಕಾರಿ ರ‍್ಹಯಲವಾಲೊ ಯಕ್ಲೊ ಯಾಯಿರಕವಾಲೊ ಐನ ಯೆಸುನೆ ದೆಕಿನ ತಿನಾ ಪಗೊಪರ ಪಡಿನ. <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />ಮಾರಿ ಮಯಾನಿ ನ್ಹಾನಿ ದಿಕ್ರಿ ಹಮ್ನಾ ತಿನೆ ಅರಾಮ ನತ್ತಿ (ತೆ ಮರಾ ವರಕ್ಹಿ ಥೈಸ) ತು ಐನ ತಿಪರ ಹತ್ತ ಮ್ಹೆಲ ಕೈನ ಮಾಂಗಿಲಿದ್ಯೊ. ತೆ ಅರಾಮ ಥಾವಸ ವರಿ ವಾಚಿ಼ ಜಾ಼ವಸ. <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />ಯೆಸು ತಿನಾ ಕ್ಹಾತೆ ಗಯೊ ವರಿ</para>
  <para style="p" vid="MRK 5:24">ಘನ್ನಾ ಮನಕ್ಹೊ ತಿನೆ ಢಕಲ್ತಾ ತಿನಾ ಪಾಚಾ಼ ಗಯಾ. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />ತೆಳಾಮಾ ಬಾರಾ ವರಕ್ಹತಿ ರಗತ ಕುಸುಮು ರೊಗಮಾ ಘನ್ನು ತ್ರಾಸ ಕ್ಹಾತಿ ಯಕ್ಕ ಹೆಣ ಮನಕ್ಹ ತ್ಯಾ ವ್ಹತ್ತಿ. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />ತೆ ಘನ್ನಿಸಲಾ ಡಾಕ್ಟರೊಕನ ಗೈತಬಿ ಸುಜ಼ ಅರಾಮ ಥಯು ನೈ ಘನ್ನಿ ಕಷ್ಟ ಖೈನ. ಹತ್ಮಾ ರ‍್ಹಯಲ ದೊಕ್ಡಾ ಜ಼ವೈಲಿದಿತಿ. ವರಿ ರೊಗ ಹೆಚ್ಕಿ ಥಾತೊಜ಼ ವ್ಹತ್ತೊ. ವರಿ ಸುಜ಼ ಅರಾಮ ಥಯು ನ್ಹೊತು. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />ತೆ ಹೆಣ ಮನಕ್ಹ ಯೆಸುನಿ ಸುದ್ದಿ ಐಕಿನ. ತೆ ಗುಂಪಮಾ ತಿನಾ ಪಾಚಿ ಗೈ. ವರಿ ತಿನಾ ವಣ್ಣಾ ಧರಿ. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />ತೆ ವಿಚಾರ ಸು ಕರಲಿದಿತಿ ಕದ್ಯಾಮ ಮಿ ತಿನಾ ವಣ್ಣಾ ಮುಟ್ಟಿಮ ಬಸ ಅರಾಮ ಥೈ ಜ಼ೌಸ ಕೈನ ತಿನಾಮಾ ಕೈಲಿದಿತಿ. <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />ಗುಂಪನಾ ಪಾಚಾ಼ತಿ ಐನ ತಿನಾ ವಣ್ಣಾ ಮುಟ್ಟಿ. ಮುಟ್ಟಲ ಬರೊಬ್ಬರ ತಿನು ರಗತ ಜಾ಼ವಾನು ಹುಬ್ರೈ ಪಡ್ಯು. ಮನೆ ಕದ್ರಾವಾನೊ ರೊಗ ಗೈನ ಮಿ ಅರಾಮ ಥೈ ಕೈನ ತಿನಾಮಾ ತೆ ತಿಳದಿಲಿದಿ.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />ತೆಳಾಮಾಜ಼ ಯೆಸು ಮಾರಮಾತಿ ತಾಕತ ಚಾ಼ಲಿಸ ಕೈನ ತಿನಾಮಾಜ಼ ತಿಳದಿಲಿನ ಗುಂಪಮಾ ಪಾಚೊ಼ ಫರಿನ ಮಾರಾ ವಣ್ಣಾ ಕುನ್ನ ಮುಟ್ಯು? ಕೈನ ಪುಚ಼ತಾಮಾ<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />ತಿನಾ ಶಿಷ್ಯಾ ತಿನೆ ಮನಕ್ಹೊ ತುನೆ ಢಕ್ಲಾನು ದೆಕಿನ ಮನೆ ಕುನ್ನ ಮುಟ್ಯು ಕೈನ ಪುಚ್ಚಾಡ್ಯೊಸ? ಕದ್ಯಾ.<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />ಯೆಸು ಸುತ್ತೆ ದೆಕಿನ ಎ ಕಾಮ ಕುನ್ನ ಕರ‍್ಯುಸ ಕೈನ ದೆಕ್ತಾಮಾ ತೆಕ್ಲಾಮಾಜ಼಼ <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />ತೆ ಹೆಣ ಮನಕ್ಹ ತಿನೆ ಥಯಲ ದೆಕಿನ ಭುಚ಼ಕಿನ ಕಾಪತಿ ತಿಕನ ಐನ ಪಗೊಪರ ಅಡ್ಡ ಪಡಿನ ರ‍್ಹಯಲ ವಿಚಾರ ಕ್ಹರಿ ಕದಿ. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />ಯೆಸು ತಿನೆ ಮಾರಿ ದಿಕ್ರಿ ತಾರೊ ಬರೊಕ್ಹೊ ತುನೆ ಅರಾಮ ಕರ‍್ಯೊಸ ಸಮಾಧಾನೆ ಜಾ಼ ತುನೆ ಕದ್ರಾಯಲ ರೊಗ ಗೈನ ತುನೆ ಅರಾಮ ಥಯುಸ ಕದ್ಯೊ.<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />ಯೆಸು ಹಜು಼ನ ಬೊಲ್ತಾಮಾಜ಼ ಅದಿಕಾರಿ ಥಯಲ ಯಾಯಿರನಾ ಘರತೊ ಯಕ್ಲೊ ಐನ ತಾರಿ ದಿಕ್ರಿ ಮರಿ ಗೈಸ. ಹಮ್ನಾ ಕಾ ಗುರುನೆ ತರಾಸ ಕರಾಡೊಸ ಕದ್ಯೊ.<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />ತ್ಯುನೆ ಕದಲ ವಾತೊ ಯೆಸು ಧ್ಯಾನ ದಿದ್ಯಾ ವಾಚಿ಼ ತಿನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ. ಭುಚ಼ಕು ನಕೊ ಬರೊಕ್ಹೊ ರ‍್ಹವಾದೆ ಕದ್ಯೊ.<verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />ವರಿ ಯೆಸು ಪೆತ್ರಾ ಯಾಕೊಬನೆ ಯಾಕೊಬನೊ ನ್ಹಾನೊ ಭೈ ಯೊಹಾನ ಇವ್ನೊನೆ ಛೊಡಿನ ಕಿನೆಜ಼಼ ತಿಕನ ಆವಾನೆ ದಿದ್ಯೊ ನೈ <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />ತ್ಯುನೆ ಯಾಯಿರನಾ ಘರೆ ಆತಾಮಾ ದಕ್ಹಾಜ಼಼ನಾ ಘನ್ನಾ ಗದ್ದಲ ಕರತಾ ರವಾಡಾತಾ ಯೆಸು ತೆ ದೆಕ್ಯೊ. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />ಯೆಸು ಮ್ಹೈ ಗೈನ ತುಮೆ ಗದ್ದಲ ಕರಾನು ಕಾ? ರವಾನು ಕಾ? ಛೊಕ್ರಿ ಮರಿನತ್ತಿ <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />ನಿಂದರ ಕರಾಡಿಸ ಕತಾಮಾ ತ್ಯುನೆ ಯೆಸುನೆ ದೆಕಿನ ಕದ್ರೈನ ಅಕ್ಹ್ಯಾ.</para>
  <para style="p" vid="MRK 5:40">ವರಿ ಯೆಸು ಕ್ಹಾರಾಜ಼ನಾವೊನೆ ಭಾರೊ ಮೊಕ್ಲಿನ ತೆ ಛೊಕ್ರಿನಾ ಮಾ ಬಾಪನೆ ತಿವ್ನಾ ಕ್ಹಾತೆ ತನ್ನ ಶಿಷ್ಯಾವೊನೆಲಿನ ಛೊಕ್ರಿ ರ‍್ಹಯಲ ಜ಼ಗಾ ಬಲೈ ನಿಂಗೈನ, <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />ತಿನೊ ಹತ್ತ ಧರಿನ ತಲಿಥಾ ಕೊಮ ಕದ್ಯೊ. ತಿಮ್ಮ ಕದ್ಯಾಮ ನ್ಹಾನಿ ಛೊಕ್ರಿ ಮಿ ಕವಾಡೊಸ ತು ಉಟ. <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />ತೆಳಾಮಾಜ಼ ತೆ ಛೊಕ್ರಿ ಉಟಿನ ಚಾ಼ಲಾಡಿ. (ತೆ ಬಾರಾ ವರಕ್ಹನಿ ವ್ಹತ್ತಿ) ತ್ಯುನೆ ಘನ್ನಾ ಘಾಬ್ರಾಥಯಾ. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />ತೆಳಾಮಾಜ಼ ಯೆಸು ತ್ಯುನೊನೆ ಆಂ ಕಿನೆಜ಼಼ ಗ್ವತ್ತ ಥೌನೈ ಕೈನ ತಾಕಿತ ಕವಾಡೊಸ ಕದ್ಯೊ. ತೆ ಛೊಕ್ರಿನೆ ಖಾವಾನೆ ದಿವೊ ಕದ್ಯೊ.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s1">ಯೆಸುನೆ ನಜ಼ರೆತಮಾತಾ ತಿನೆ ಇನ್ಕಾರ (ಇನ್ಕಾರ) ಕರಲ</para>
  <para style="r">(<ref loc="MAT 13:53-58">ಮತ್ತಾಯ 13:53-58</ref>; <ref loc="LUK 4:16-30">ಲುಕ 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />ಯೆಸು ತೆ ಜ಼ಗಾ ಛೊಡಿನ ತ್ಯಾಂತೊ ತಿನಾ ಸ್ವಂತ ಗಾಮೆ ಆಯೊ ಶಿಷ್ಯಾಬಿ ತಿನಾ ಪಾಚಾ಼ ಆಯಾ. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />ಸಬ್ಬತ (ಐತ್ವಾರ) ದಿನ್ನ ಆತಾಮಾ ಯೆಸು ಸಭಾಮಂದಿರಮಾ ಗೈನ ಉಪದೆಶ ಕರಾನು (ಕ್ಹುದಾನಿಯೊ ಚೊ಼ಕಿಯೊ ವಾತೊ ಕವಾನು) ಶುರು ಕರ‍್ಯೊ ಘನ್ನಾ ಮನಕ್ಹೊ ತ್ಯಾ ವ್ಹತ್ತಾ ಕ್ಹಾರಾಜ಼ನಾ ತಿನಿಯೊ ವಾತೊ ಐಕಿನ ಘಾಬ್ರಾಥಯಾ.</para>
  <para style="p" vid="MRK 6:2">ಇನೆ ಎ ವಾತೊ ಕಿಜ಼್ಗಾಂತಿಯೊ ಆಯೊಸ? ಇನೆ ಎ ಕ್ಹಾರು ಗ್ಯಾನ ಕಿಜ್ಗಾಂತು ಮಳ್ಯುಸ? ಎ ಕಿಮ್ಮ ಅದ್ಭುತ ಕರಾಡೊಸ. <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />ಎ ಬಡಗ್ಯಾನು ಕಾಮ ಕರಾಲೊ ನ್ಹವೈಸು? ಎ ಮರಿಯಳನೊ ದಿಕ್ರೊ ನ್ಹವೈಸು ಯಾಕೊಬ ಯೊಸೆಫ ಯುದ ವರಿ ಸಿಮೊನನೊ ಮ್ಹೊಟೊ ಭೈ ನ್ಹವೈಸು? ಇನಿಯೊ ಭೆನೊ ನ್ಹ್ಯಾಜ಼ ಅಪೊಕನ ನತ್ತಿಸು? ಇನಾಹುತಿ ತ್ಯುನೆ ಯೆಸುನೆ ಇನ್ಕಾರ‍್ಯಾ.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />ಯೆಸು ತ್ಯುನೊನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ, ಪ್ರವಾದಿನೆ ಬಿಜಿ ಜ಼ಗಾ ಮರ್ಯಾದಿ ಛೆ ತೆನೈಸೊ ತಿನಾ ಸ್ವಂತ ಗಾಮಮಾ ಸ್ವಂತ ಮನಕ್ಹೊಮಾ ಸ್ವಂತ ಘರಮಾ ತ್ಯಾ ಯಕ್ಕಜ಼ ಮರ್ಯಾದಿ ನತ್ತಿ ಕದ್ಯೊ. <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />ತೆ ತ್ಯಾ ದಕ್ಹಾಜ಼಼ನಾ ರೊಗ ರ‍್ಹಯಲವಾಲಾವೊಪರ ಹತ್ತ ಮ್ಹೆಲಿನ ಅರಾಮ ಕರ‍್ಯೊ ತೆ ಛೊಡಿನ ಬಿಜು಼ ಕಯುಜ಼ ಮ್ಹೊಟು ಕಾಮ ಕರಾನೆ ಥಯುನೈ ಕಾಕದ್ಯಾಮ ತ್ಯುನೊಮಾ ಬರೊಕ್ಹೊ ನ್ಹೊತೊ. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />ಮನಕ್ಹೊಮಾ ಬರೊಕ್ಹೊ ನೈ ರ‍್ಹಯಲ ದೆಕಿನ ತಿನೆ ಘನ್ನು ಅಜಪ ಲಾಗ್ಯು.</para>
  <para style="s1" vid="MRK 6:6">ಯೆಸು ಬಾರಾ ಜ಼ನಾ ಶಿಷ್ಯಾವೊನೆ ಮೊಕ್ಲಲ</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">ಮತ್ತಾಯ 10:5-15</ref>; <ref loc="LUK 9:1-6">ಲುಕ 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">ತೆಳಾಮಾ ಯೆಸು ಗಾಮಮಾ ಐನ ವರಿ ಶಿಕ್ಲಾವಾಡೊತೊ. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />ಪಾಚ಼ಲ್ತೊ ಯೆಸು ಸುತ್ಲ್ಯಾ ಗಾಮೊಪರ ಫರಿನ ಉಪದೆಶ ಕರತೊ ಆಯೊ. ವರಿ ಬಾರಾ ಜ಼ನಾ ಶಿಷ್ಯಾವೊನೆ ತಿಕನ ಬಲೈನ ತ್ಯುನೊನೆ ಬೆ-ಬೆ ಜ಼ನಾವೊನೆ ಮೊಕಲ್ತಾಮಾ ವರಿ ತ್ಯುನೊನೆ ಕೆಟ್ಟ ಆತ್ಮಾವೊಪರ ಅದಿಕಾರ ದಿದ್ಯೊ.<verse eid="MRK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 6:8" />ತೆಳಾಮಾ ತ್ಯುನೊನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ. ಲಾಕ್ಡಿ ಛೊಡಿನ ವಾಟಮಾ ಬಿಜು಼ ಸುಜ಼ ಲಿಂಜಾವೊನಕೊ. ಭುತಿ ನಕೊ ಗಾಮೆ ಲಿಂಜಾ಼ವಾನಿಯೊ ಚಾ಼ಂಬಡಾನಿ ಪಟ್ಟಿನಿ ಪಿಶಿಯೊ ನಕೊ ಪಿಶಿಮಾ ದೊಕ್ಡಾ ನಕೊ. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />ಚ಼ಪ್ಲೊ ಘಾಲ್ಲಿವೊ ಬೆ ಅಂಗ್ಡಾ ಲಿವೊ ನಕೊ ಕದ್ಯೊ. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />ಎನೈಸೊ ಯೆಸು ತ್ಯುನೊನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ -ತುಮೊನೆ ಕಯಾ ಘರಮಾ ಬಲೈ ಲಿವಸ ತೆ ಜ಼ಗಾ ಛೊಡಿನ ಜಾ಼ಯೆಲಕ್ಕಾ ತ್ಯಾಜ಼ ರ‍್ಹವೊ. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />ತುಮೆ ಯಕ್ಕ ಗಾಮಮಾ ಆತಾಮಾ ತ್ಯಾ ತುಮೊನೆ ಮನಕ್ಹೊ ಒಪ್ಪಿನೈಲಿದ್ಯಾಮ ಎನೈಸೊ ಮನಕ್ಹೊ ತುಮಾರಿಯೊ ವಾತೊ ನೈ ಐಕ್ಯಾಮ ತುಮಾರಾ ಪಗೊನು ಧುಳ್ಳ ತ್ಯಾಜ಼ ಝಾಡಿಸಿಲಿವೊ ತೆ ತ್ಯುನೊನೆ ಯಕ್ಕ ಸಾಕ್ಷಿ ಥೈನ ರ‍್ಹವಾದೆ.<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />ತ್ಯುನೆ ಗೈನ ಮನಕ್ಹೊನೆ ಪಾಪೊ ಕರಾನು ಛೊಡಿಪಾಡೊ ಕೈನ ಕವಾಡಾತಾ. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />ತ್ಯುನೆ ಘನ್ನಾ ಕೆಟ್ಟ ಆತ್ಮಾವೊನೆ ಛೊಡಾಯಾ ವರಿ ಘನ್ನಾ ರೊಗಿಯೊನೆ ಒಲಿವ ತೆಲ ಮಾತಾಪರ ಲಗಾಡಿನ ಪ್ರಾಥನಾ ಕರತಾಮಾ ತ್ಯುನೊನೆ ಅರಾಮ ಥಯು.<verse eid="MRK 6:13" /></para>
  <para style="s1">ಬಾಪ್ತಿಸ್ಮ ದಿಲಾವಾಲಾನಿ ಯೊಹಾನನು ಮರಣ</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />ತೆಳಾಮಾ ರಾಜೊ಼ ಥಯಲ ಹೆರೊದ. ಯೆಸುನಿ ಸುದ್ದಿ ಐಕಿನ ಕಾಕದ್ಯಾಮ ತಿನು ನಾಮ ಘನ್ನು ಫೈಲಿಗಯುತು. ವರಿ ಮನಕ್ಹೊ ತಿನಾಹುತಿ-ಬಾಪ್ತಿಸ್ಮ ದಿಲಾವಾಲೊ ಥಯಲ ಯೊಹಾನಜ಼ ಫರಿನ ವಾಚಿ಼ನ ಆಯೊಸ. ತಿನಾಹುತಿ ಮ್ಹೊಟಾ-ಮ್ಹೊಟಾ ಕಾಮೊ ಕರಾನಿ ತಾಕತ ತಿನಾಮಾ ಛೆ ಕೈನ ಕವಾಡಾತಾ.<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />ವರಿ ದಕ್ಹಾ ಜ಼ನಾ ಎ ಪ್ರವಾದಿ ಥಯಲ ಎಲಿಯಾ ವ್ಹೈ ಕೈನ ಕತಾತಾ</para>
  <para style="p" vid="MRK 6:15">ವರಿ ದಕ್ಹಾಜ಼಼ನಾ ಎ ಪಾಚ಼ಲ್ಯಾ ರ‍್ಹಯಲ ಪ್ರವಾದಿಯೊಮಾನೊ ಯಕ್ಲೊ ನಿಂಗತ ಛೆ.<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />ತೆಳಾಮಾ ಹೆರೊದ ರಾಜೊ಼ ತಿನಿ ಸುದ್ದಿ ಐಕಿನ - ಬಾಪ್ತಿಸ್ಮ ದಿಲಾವಾಲೊ ಯೊಹಾನ ವ್ಹೈಸು ಮಿ ಗರದನ ಕತ್ರಲ ಯೊಹಾನ ವಾಚಿ಼ನ ಆಯೊಸು ಕದ್ಯೊ!<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />ಯೊಹಾನನೆ ಧರಿಲಾವಾನೆ ತಿನಾ ಸೈನಿಕೊನೆ ಹೆರೊದ್ಯಜ಼ ಕದ್ಯೊತೊ ತೆಳಾಮಾ ತ್ಯುನೆ ಯೊಹಾನನೆ ಜೆಲಮಾ ಘಾಲ್ಯಾ ಕಾಕದ್ಯಾಮ ಹೆರೊದ ತೆ ಮುಕ್ಕಿಲಿದಲ ಹೆರೊದ್ಯಳನಾಹುತಿ ಯೊಹಾನನೆ ಧರಿಲೈನ ಜೆಲಮಾ ಭಾಂದಿನ ಘಾಲ್ಯೊತೊ. ತೆ ಹೆರೊದ್ಯಳ ಹೆರೊದನಾ ಮ್ಹೊಟೊ ಭೈ ಫಿಲಿಪ್ಪನಿ ಬೈಕೊ ವ್ಹತ್ತಿ <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />ಯೊಹಾನ ಹೆರೊದನೆ ಹಗ್ಲೆಲ್ಲಾ ಕತೊತೊ ತಾರಾ ಭೈನಿ ಬೈಕೊನೆ ಹಿವಾ ಕರಿಲಿವಾನು ಚೊ಼ಕು ನ್ಹವೈ ಕೈನ ಕತೊತೊ. <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />ತಿನಾಹುತಿ ಹೆರೊದ್ಯಳ ತಿನಾ ಉಪ್ಪರ ಶಿಟ್ಟ ಮ್ಹೆಲ್ಲಿನ ತಿನೆ ಖಲಾಸ ಕರೌಕೈನ ವಿಚಾರ ಕರಿತಬಿ ಹೆರೊದನಾಹುತಿ ತಿನಾ ಹತೆ ಥಯುನೈ. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />ಹೆರೊದ ಯೊಹಾನ ಕ್ಹುದಾನೊ ಭೆಂ ರ‍್ಹಯಲವಾಲೊ ವರಿ ಪರಿಶುದ್ಧ ವ್ಹೈ ಕೈನ ತಿಳ್ದಿನ ತಿಕ್ಹು ಭುಚ಼ಕಿನ ತಿನೆ ಸು ಥಾವುನೈ ಕೈನ ಮುಕ್ಯೊತೊ ಎನೈಸೊ ಯೊಹಾನ ಕವಾನು ತಿನೆ ಐಕ್ತಾಮಾ ಮನಸೆ ಘನ್ನು ಗಲಿಬಿಲಿ ಥಯುತಬಿ ತಿನಿಯೊ ವಾತೊ ಧ್ಯಾನ ದಿನ್ನ ಐಕ್ತೊತೊ.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಯಕ್ಕ ದಿನ್ನ ತಿನೆ ಅನುಕುಲ ದಿನ್ನ ಆಯೊ. ಕಿಮ್ಮ ಕದ್ಯಾಮ ಹೆರೊದನಾ ಹುಟ್ಟಲ ದಿನಮಾ ತೆಳಾಮಾ ತೆ ಪ್ರಭುವೊನೆ ಸೆನಾಧಿಪತಿನೆ ಗಲಿಲಾಯ ಪ್ರಾಂತ್ಯನಾ ಶಾನಾವೊನೆ ಖಾವಾನೆ ಕರತಾಮಾ. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />ಹೆರೊದಳನಿ ದಿಕ್ರಿ ಮ್ಹೈ ಐನ ನ್ಹಾಚಿ಼ನ ಹೆರೊದನಾ ಕ್ಹಾತೆ ಸಾಲಮಾ ಕ್ಹಾವಾನೆ ಬೈಟಲವಾಲಾವೊನೆ ಖುಶಿ ಕರಿ.</para>
  <para style="p" vid="MRK 6:22">ರಾಜೊ಼ ತೆ ಛೊಕ್ರಿನೆ ಸು ಚಾ಼ಯೆ? ಮಾಂಗ ಸು ಮಾOಗಶಿ ದ್ಯುಸ. <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />ತು ಮಕನ ಸು ಮಾಂಗಿಲೆಶಿ ಮಾಂಗ ಕದ್ಯೊ. ಮಾರಾ ರಾಜ್ಯಮಾನೊ ಅರಧೊವಾಟೊ ಮಾಂಗಿತಬಿ ಮಿ ತುನೆ ದ್ಯುಸ ಕೈನ ಕ್ಹಮ ಘಾಲಿನ ಕದ್ಯೊ.<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />ತೆಳಾಮಾ ತೆ ಛೊಕ್ರಿ ಭಾರಿ ಗೈನ ಮಿ ಸು ಮಾಂಗಿಲ್ಯು? ಕೈನ ತಿನಿ ಯಾನೆ ಪುಚ಼ತಾಮಾ</para>
  <para style="p" vid="MRK 6:24">ತೆ ತಿನೆ ಬಾಪ್ತಿಸ್ಮ ದಿಲಾವಾಲೊ ಥಯಲ ಯೊಹಾನನು ಮಾತು ಮಾಂಗಿಲೆ ಕದಿ.<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />ತೆಳಾಮಾಜ಼ ತೆ ರಾಜಾ಼ ಕನ ಭರನೆ ಐನ ಹಮ್ನಾಜ಼ ಬಾಪ್ತಿಸ್ಮ ದಿಲಾವಾಲೊ ಥಯಲ ಯೊಹಾನನು ಮಾತು ಪರಾತ್ಮಾ ಮನೆ ಲೈನ ದ್ಯು ಕೈನ ಮಾರಿ ಆಸ ವ್ಹೈ ಕದಿ.<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />ತೆ ವಾತೆ ರಾಜಾ಼ನೆ ಘನ್ನು ದುಖಥಯ್ಯು ತೆ ಕ್ಹಾರಾವೊನಾ ಕ್ಹಾಮೊ ಕದಲ ತಿನೆ ಇನ್ಕಾರ ಕರಾನೆ ಥಯು ನೈ. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />ತಿನಾಹುತಿ ರಾಜೊ಼ ಸೈನಿಕೊಮಾನಾ ಯಕ್ಲಾನೆ ಬಲೈನ ತು ಗೈನ ಯೊಹಾನನಿ ಗರದನ ಕತ್ರಿನ ಲೈನ ದೆ ಕೈನ ಅಪ್ಪಣೆ ದಿನ್ನ ಮೊಕಲ್ಯೊ. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />ತೆ ಜೆಲಮಾ ಗೈನ ಯೊಹಾನನಿ ಗರದನ ಕತ್ರಿನ ಪರಾತ್ಮಾ ಮ್ಹೆಲಿನ ತೆ ಛೊಕ್ರಿನೆ ಲೈನ ದಿದ್ಯೊ. ತೆ ಛೊಕ್ರಿ ಗೈನ ತಿನಿ ಯಾನಾ ಹತ್ಮಾ ದಿದಿ. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />ಯೊಹಾನನಾ ಶಿಷ್ಯಾ ಎ ಕ್ಹಾರು ಐಕ್ತಾಮಾ ತ್ಯುನೆ ಐನ ತಿನೊ ಮುರದೊ ಉಚೈನ ಲಿನಗೈನ ಮಜಾ಼ರಮಾ ಮ್ಹೆಲ್ಯಾ.<verse eid="MRK 6:29" /></para>
  <para style="s1">ಯೆಸು ಮನಕ್ಹೊನಾ ಗುOಪನೆ ಅನ್ನ ಖಲಾಯಲ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ಮತ್ತಾಯ 14:13-21</ref>; <ref loc="LUK 9:10-17">ಲುಕ 9:10-17</ref>; <ref loc="JHN 6:1-14">ಯೊಹಾನ 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />ಅಪೊಸ್ತಲೊ ಮಳಿನ ಯೆಸುಕನ ಐನ ತ್ಯುನೆ ತೆ ಕದಲ ಕ್ಹಾರು ಕರಿನ ಕರಲ ಕ್ಹಾರು ಉಪದೆಶ ತಿಕನ ತಿಳಶ್ಯಾ. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />ಯೆಸು ತ್ಯುನೊನೆ ಆವೊ ಅಪೆ ಕುನ್ನ ನೈಸೊ ಜ಼ಗಾ ಗೈನ ಅರಾಮ ಕರಿಯೆ ಕದ್ಯೊ. ಕಾಕದ್ಯಾಮ ಘನ್ನಾ ಮನಕ್ಹೊ ಆವಾನು ಜಾ಼ವಾನು ಕರಾಡಾತಾ ತ್ಯುನೊನೆ ಕ್ಹಾವಾನೆಬಿ ಟೈಮ ನ್ಹೊತೊ.<verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />ತಿನಾಹುತಿ ತೆಳಾಮಾ ತ್ಯುನೆ ಹಡಗಾಮಾ ಗೈನ ಕುನ್ನ ನೈಸೊ ತ್ಯುನೆ ಯಕ್ಲಾಜ಼ ರ‍್ಹವಾನಿ ಜ಼ಗಾ ಗಯಾ. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />ತ್ಯುನೆ ಜಾ಼ವಾನು ಘನ್ನಾ ಮನಕ್ಹೊ ದೆಕಿನ ತ್ಯುನೊನೆ ವಳಕಿನ ಕ್ಹಾರಾ ಗಾಮೊತಾ ಮನಕ್ಹೊ ಚಾ಼ಲ್ತಾ ನ್ಹಾಟ್ತಾ ಯೆಸು ವರಿ ತಿನಾ ಶಿಷ್ಯಾವೊತಿ ಅಗ್ದುರ ತೆ ಜ಼ಗಾಪರ ಆಯಾ. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />ತೆಳಾಮಾ ಯೆಸು ಹಡಗಾಮಾತೊ ಉತ್ರಿನ ಮನಕ್ಹೊನಾ ಗುಂಪನೆ ದೆಕಿನ ಇವ್ನೆ ಕುರಬುರ‍್ಯೊ ನೈಸೊ ಬಕ್ರಾವೊನಿಂಗತ ಛೆ ಕೈನ ಘನ್ನೊ ಮರಗಿನ ತ್ಯುನೊನೆ ಕ್ಹುದಾನಿಯೊ ವಾತೊ ಕವಾಡೊತೊ.<verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />ತೆಕ್ಲಾಮಾಜ಼಼ ಕ್ಹಾಂಜ಼ ಥಯಲಕ್ಹು ಯೆಸುನಾ ಶಿಷ್ಯಾ ತಿಕನ ಐನ ಆಂ ಕುನ್ನ ನೈಸೊ ಜ಼ಗಾ ವ್ಹೈ ಟೈಮ ಥಯೊಸ. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />ಎ ಮನಕ್ಹೊನೆ ಅಪ್ಪಣೆ ದೆ ಇವ್ನೆ ಆಜು಼ ಬಾಜ಼ುನಾ ಗಾಮೆ ಗೈನ ತ್ಯುನೆ ಖಾವಾನೆ ಸುಬಿ ಕರಲಿವಾದೆ.<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />ತೆ ವಾತೆ ಯೆಸು "ತುಮೆಜ಼ ಇವ್ನೊನೆ ಖಾವಾನೆ ಅನ್ನ ದಿವೊ ಕದ್ಯೊ.</para>
  <para style="p" vid="MRK 6:37">ತೆ ವಾತೆ ತ್ಯುನೆ-ಹಮೆ ಗೈನ ಬೆಕ್ಹೊ ರುಪ್ಪಾನಾ ಬಿಲ್ಲಾಮಾ ಇವ್ನೊನೆ ರೊಕ್ಲಾ ಲೈನ ಕ್ಹಾವಾನೆ ದಿಯೆಸು?<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />ಕೈನ ಪುಚ಼ತಾಮಾ ಯೆಸು -ತುಮೊಕನ ಕೆಕ್ಲಾ ರೊಕ್ಲಾ ಛೆ? ಕೈನ ದೆಕಿನ ಆವೊ ಕದ್ಯೊ.</para>
  <para style="p" vid="MRK 6:38">ತ್ಯುನೆ ದೆಕಿನ ಐನ ಪಾಂಚ಼ ರೊಕ್ಲಾ ಬೆ ಮಚ್ಲಿ಼ಯೊ ಛೆ ಕದ್ಯಾ.<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />ತೆಳಾಮಾ ಯೆಸು ತ್ಯುನೊನೆ ಹಸರ ಚಾ಼ರಾಪರ ಜಿಮಿನ್ಪರ ಬೈಟೊ ಕೈನ ಅಪ್ಪಣೆ ದೆತಾಮಾ. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />ಇನಾಹುತಿ ಮನಕ್ಹೊ ಕ್ಹೊ ಯಕ್ಲಾ ಐವತ್ತ ಯಕ್ಲಾ ಗುಂಪ ಥೈನ ಬೈಟ್ಯಾ. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />ತೆಳಾಮಾ ಯೆಸು ತೆ ಪಾಂಚ಼ ರೊಕ್ಲಾ ಬೆ ಮಚ್ಲಿ಼ಯೊಲಿನ ಹಬಾಳನೆ ದೆಕಿನ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಕೈನ ತೆ ರೊಕ್ಲಾ ಭಾಗಿನ ತುಮೆ ಮನಕ್ಹೊನೆ ವಾಟೊ ಕೈನ ಶಿಷ್ಯಾವೊನಾ ಹತ್ಮಾ ದಿನ್ನ ತೆ ಬೆ ಮಚ್ಲಿ಼ಯೊ ಕ್ಹಾರಾವೊನೆ ವಾಟಾಲಗಾಡ್ಯೊ. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />ತ್ಯುನೆ ಕ್ಹಾರಾ ಪೆಟ ಭರೆಲಕ್ಕಾ ಖಾದ್ಯಾ. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />ಶಿಷ್ಯಾ ಉಗ್ರಲ ರೊಕ್ಲಾನಾ ತುಕಡಾ ಮಚ್ಲಿ಼ಯೊನಾ ತುಕಡಾ ಮಳಾತಾಮಾ ಬಾರಾ ಟೊಪ್ಲಿಯೊ ಭರಿಯೊ. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />ಖಾದಲವಾಲಾವೊಮಾನಾ ಪಾಂಚ಼ ಹಜಾ಼ರ ದಾಣ್ಗಾ ವ್ಹತ್ತಾ.<verse eid="MRK 6:44" /></para>
  <para style="s1">ಯೆಸು ಸಮುಂದರಪರ ಚಾ಼ಲಲ</para>
  <para style="r">(<ref loc="MAT 14:22-33">ಮತ್ತಾಯ 14:22-33</ref>; <ref loc="JHN 6:15-21">ಯೊಹಾನ 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />ಎ ಥಯಲ್ಪರ ಯೆಸು ತಿನಾ ಶಿಷ್ಯಾವೊನೆ ಮಿ ಆಂ ಮನಕ್ಹೊನಾ ಗುಂಪನೆ ಮೊಕ್ಲಾತಿ ಅಗ್ದುರ ತುಮೆ ಹಡ್ಗೊ ಚ಼ಡಿನ ಅಗಾ ಸಮುಂದರನಿ ಬಿಜಿ ದಂಡಿಯೆ ಬೆತ್ಸಾಯಿ ಕವಾನಾ ಗಾಮೆ ಜಾ಼ವೊ ಕೈನ ಜು಼ಲಮೆ ಮೊಕಲ್ಯೊ <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />ಯೆಸು ಮನಕ್ಹೊನೆ ಅಪ್ಪಣೆ ದಿದಲ್ಪರ ಪ್ರಾಥನಾ ಕರಾನೆ ಡೊಂಗರಪರ ಗಯೊ.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />ಕ್ಹಾಂಜ಼ ಥಯಲ್ಪರ ಹಡ್ಗೊ ಸಮುಂದರನಾ ವಚ಼ಮಾ ವ್ಹತ್ತೊ. ತೆಳಾಮಾ ಯೆಸು ಯಕ್ಲೊಜ಼ ದOಡಿಪರ ವ್ಹತ್ತೊ. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />ಹಡಗೊ ಸಮುಂದರನಾ ಉಪ್ಪರ ದುರ ರ‍್ಹಯಲ ಶಿಶ್ಯಾ ತಿನೆ ದಂಡಿಯೆ ಲಿಂಜಾ಼ವಾನೆ ಘನ್ನಾ ತರಾಸ ಖಾವಾನು ಯೆಸು ದೆಕ್ಯೊ. ವಾರೊ ತ್ಯುನೊನೆ ಢಕ್ಲಾಡೊತೊ. ಪಾಟೆ ತನ್ನತೊ ಛೆ ವಾಜಾ಼ನಾ ಟೈಮಮಾ, ಯೆಸು ಪಾನಿನಾ ಉಪ್ಪರ ಚಾ಼ಲ್ತೊ ಹಡಗಾನಾ ನಜಿಕ ಐನ ತ್ಯುನೊನೆ ದಾಟಿನ ಜಾ಼ವಾಮಾ ವ್ಹತ್ತೊ. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />ಸಮುಂದರಪರ ಚಾ಼ಲಾನು ದೆಕಿನ ತ್ಯುನೆ ಭುತ್ಡು ವ್ಹೈ ಕೈನ ತಿಳ್ದಿನ ವದ್ರ್ಯಾ. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />ತ್ಯುನೆ ಕ್ಹಾರಾಜ಼ನಾ ತಿನೆ ದೆಕಿನ ಭುಚ಼ಕಿನ ಘಾಬ್ರಾಥಯಾ.</para>
  <para style="p" vid="MRK 6:50">ತೆಳಾಮಾಜ಼ ತೆ ತ್ಯುನೊನೆ ಬೊಲಿನ ತ್ಯುನೊನೆ ಧೈರ್ಯಕ್ಹು ರ‍್ಹವೊ ಮಿ ವ್ಹೈ ಭುಚ್ಕೊ಼ ನಕೊ ಕದ್ಯೊ. <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />ತೆಳಾಮಾಜ಼ ಯೆಸು ಹಡಗಾಮಾ ಚ಼ಡಿನ ತ್ಯುನೊಕನ ಆಯಲಪರ ವಾರೊ ಹುಬ್ರೈಪಾಡ್ಯೊ. ತೆಳಾಮಾ ಶಿಷ್ಯಾ ತ್ಯುನೊ ತ್ಯುನೊಮಾಜ಼ ಘನ್ನಾ ಘಾಬ್ರಾಥಯಾ. <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />ಕಾಕದ್ಯಾಮ ಪಾOಚ಼ ಹಜಾ಼ರ ಮನಕ್ಹೊನೆ ಅನ್ನ ಖಲಾಯಲ ತ್ಯುನೆ ತಿಳದ್ಯಾ ನ್ಹೊತಾ. ತಿಕ್ಹುನೆ ತ್ಯುನೆ ತೆ ಮ್ಹೊಟು ಕಾಮ ತಿಳದಿಲಿದ್ಯಾ ನೈ.<verse eid="MRK 6:52" /></para>
  <para style="s1">ಗೆನೆಜರೆತಮಾ ಯೆಸು ರೊಗಿಯೊನೆ ಅರಾಮ ಕರಲ</para>
  <para style="r">(<ref loc="MAT 14:34-36">ಮತ್ತಾಯ 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />ತ್ಯುನೆ ಸಮುಂದರ ದಾಟಿನ ಗೆನೆಜರೆತ ಕವಾನಾ ದೆಶನಿ ದಂಡಿಯೆ ಮುಟ್ಟಿನ ಹಡ್ಗೊ ಭಾಂದ್ಯಾ <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />ತ್ಯುನೆ ಹಡಗಾಮಾತಾ ಉತ್ರಲ ಬರೊಬ್ಬರ ಮನಕ್ಹೊ ಯೆಸುನೆ ವಳಕಿನ. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />ತೆ ಪ್ರಾOತ್ಯಮಾತಾ ನ್ಹಾಟ್ತಾ ಅಂಗಮಾ ಅರಾಮ ನೈಸೊವಾಲಾವೊನೆ ಬೊರಿಯ್ಯಾಪರ ಘಾಲ್ಲಿನ ತೆ ಕಿಜ್ಗಾ-ಕಿಜ್ಗಾ ಛೆ ಕೈನ ಪುಚಿ಼ನ ತ್ಯಾ-ತ್ಯಾ ನಿಂಜಾ಼ತಾತಾ. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />ವರಿ ಯೆಸು ಕ್ಹಾರಿ ಜ಼ಗಾ ಗಯೊ ಖೆಡಾವೊಪರ ವರಿ ಗಾಮಮಾ ನೈತೊ ಖೆತ್ರೊನೆ ತ್ಯಾ ಮನಕ್ಹೊ ಅಂಗಮಾ ಅರಾಮ ನೈಸೊವಾಲಾವೊನೆ ಬಾಜ಼ರೊನಾ ವಚ್ಮಾ಼ ಲಾತಾತಾ. ವರಿ ಯೆಸುಕನ ತಿನಾ ವಣ್ಣಾವೊನಾ ಗೊಂಡಾವೊನೆ ಮುಟ್ಟೌ ಕೈನ ತಿಕನ ಮಾಂಗಿಲಿದ್ಯಾ. ತಿನೆ ಮುಟ್ಟಲವಾಲಾ ಅರಾಮ ಥಯಾ.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s1">ಮ್ಹೊಟಾ ಮನಕ್ಹೊತಿ ಆಯಲ ಪದ್ದತಿ</para>
  <para style="r">(<ref loc="MAT 15:1-20">ಮತ್ತಾಯ 15:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />ಎ ಥಯಲ್ಪರ ಯೆರುಸಲೆಮ್ತಾ ಆಯಲ ಫರಿಸಾಯರೊಮಾನಾ ದಕ್ಹಾ ಜ಼ನಾ ಶಾಸ್ತ್ರಿಯೊ ಮಳಿನ ಯೆಸುನಾ ಸುತ್ತೆ ಆಯಾ. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />ವರಿ ಯೆಸುನಾ ಶಿಷ್ಯಾ ತಿವ್ನಿ ಪದ್ದತಿನಿOಗತ ಹತ್ತ ಧ್ವಯಾವಾಚಿ ಅನ್ನ ಖಾವಾನು ದೆಕ್ಯಾ ಕಾಕದ್ಯಾಮ ತ್ಯುನಿ ಪದ್ದತ ನಿಂಗತ ಖಾವಾತಿ ಅಗ್ದುರ ಹತ್ತ ಧ್ವಯಾನ್ಹೊತಾ. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />(ಕಾಕದ್ಯಾಮ ಫರಿಸಾಯರೊ ವರಿ ಯೆಹುದಿ ತ್ಯುನೊನೆ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ಶಿಕ್ಲಾಯಲ ಪದ್ದತ ತಿವ್ನಾ ಹತೊ ಚೊ಼ಕಿ ತರಾ ಧ್ವಲಿದ್ಯಾವಾಚಿ ಖಾತಾನ್ಹೊತಾ. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />ತಿನಾನಿOಗತ ಬಾಜ಼ರಮಾತಾ ಖಾವಾನು ಸುಬಿಲಾಯಮ ಧ್ವಯಾವಾಚಿ ಖಾತಾನ್ಹೊತಾ ಎ ಯಕ್ಕ ತರಾನಿ ಪದ್ದತ ತ್ಯುನೆ ಘನ್ನಿ ತರಾನಿಯೊ ಪದ್ದತೊ ಕರತಾತಾ ಎನೈಸೊ ತ್ಯುನೊಮಾ ತಾಂಬಿಯಾ ವಾಟಕಾ ತಪಾಲೊ. ಬೆಳಗಿನ ಧವಾನು ವಚ್ಚಾ಼ನಾ ಧೊತಾತಾ ಹಜು಼ನ ಘನಿಯೊ ಶುದ್ಧಾಚಾರ (ಪದ್ದತ) ಕರತಾತಾ.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />ಇನಾಹುತಿ ಫರಿಸಾಯೊರೊ ಶಾಸ್ತ್ರಿಯೊ ಯೆಸುನೆ ಪುಚ್ಯಾ ತಾರಾ ಶಿಷ್ಯಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊತಿ ಆಯಲ ಪದ್ದತಿ ನಿಂಗತ ಕಾ ನೈ ಚಾ಼ಲ್ತಾ? ರಾಡಿ ಹತೊಕ್ಹು ಅನ್ನ ಕಾ ಖಾವಸ?<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />ಯೆಸು ಜ಼ವಾಬ ದಿದ್ಯೊ ಕಪಟಿಯೊ ಥಯಲ ತುಮಾರಾಹುತಿ ಯೆಶಾಯಾ ಬರ್ದಲ ಕೆಕ್ಲೊ ಕರೆಟ್ಟ ಛೆ! ತುಮೆ ಮ್ಹೈ ಯಕ್ಕ ಭಾರಾ ಯಕ್ಕ ತೆ ತಿಮ್ಮ ಬರ್ದಲ, ಕ್ಹುದಾ ಕದ್ಯೊ.</para>
  <para style="q1" vid="MRK 7:6">ಎ ಮನಕ್ಹೊ ಕ್ಹಾಲಿ ವಾತೊಕ್ಹು ಮನೆ ಮರ್ಯಾದಿ ದಿವಸ</para>
  <para style="q2" vid="MRK 7:6">ವರಿಬಿ ತ್ಯುನು ಮನಸ ಮಕ್ಹು ಘನ್ನು ದುರ ಛೆ.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />ಇವ್ನೆ ಮಾರಿ ಆರಾಧನಾ ಕರಾನು ಸುಜ಼ ಉಪಯೊಗ ನತ್ತಿ.</para>
  <para style="q2" vid="MRK 7:7">ಕಾಕದ್ಯಾಮ ತ್ಯುನೆ ಕ್ಹುದಾನಿ ಪದ್ದತ ಛೊಡಿನ ತ್ಯುನಾ ನಿಯಮೊ ಉಪದೆಶ ಕರಸ.<verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />ತುಮೆ ಕ್ಹುದಾನಿಯೊ ಪದ್ದತ ಛೊಡಿನ ಮನಕ್ಹೊನಿ ಪದ್ದತ ಕರೊಶಿ.<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />ಯೆಸು ತ್ಯುನೊನೆ ಕದ್ಯೊ ತುಮೆ ತುಮಾರಾ ಗ್ಯಾನ ಉಪಯೊಗ ಕರಲಿನ ಕ್ಹುದಾನಿ ಪದ್ದತಿ ದುರ ಕರಾಡಾಸ ವರಿ ತುಮಾರಿಯೊ ಪದ್ದತಿಯೊ ಮನಕ್ಹೊನೆ ಕರೊ ಕೈನ ಶಿಕ್ಕಲಾವಾಡ್ಯಾಸ. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />ಮೊಶೆ ಸು ಕದ್ಯೊಸ ಕದ್ಯಾಮ ಯಾ. ಬಾಪನೆ ಮರ್ಯಾದಿ ದ್ಯು ವರಿ ಕೈನ ಬಾಪನೆ ರ‍್ಹ್ಯೆನೆಕಾ ಯಾನೆ ರ‍್ಹ್ಯೆನೆಕಾ ಕ್ಹರಾಪಾಲಾನೆ ಮರವಾನಿ ಶಿಕ್ಷಾ ಥಾವು ; <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />ತಿಮ್ಮಜ ತುಮೆ ಕವಾನು ಸುವೈ ಕದ್ಯಾಮ, ಯಕ್ಲೊ ತಿನಾ ಯಾ ಬಾಪನೆ, ದಿವಾನು ಮಿ ಕ್ಹುದಾನೆ ದಿದ್ಯೊಸ ಕವೊ ಕೈನ ಶಿಕ್ಲಾಯಾಸ್ತೊ( ತಿನು ಮತ್ಲಬ ತೆ ಕ್ಹುದಾನು ವ್ಹೈ). <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />ತೆ ತಿನಾ ಯಾ ಬಾಪನೆ ಆಸ್ರೊ ನೈ ಕರ‍್ಯೊ ಸುಜ಼ ತರಾಸ ನತ್ತಿ ಇಮ್ಮ ಕವೊಸಿತೊ. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />ಇಮ್ಮ ತುಮೆ ಶಿಕ್ಲಾತಾ ಆಯಲ ಪದ್ದತಿಕ್ಹು. ಕ್ಹುದಾನಿಯೊ ವಾತೊನಿ ತಾಕತ ಇಕ್ಹರಿ ಪಾಡೊಶಿ. ವರಿ ಇಮ್ಮಜ಼ ಹವಾ ಕಾಮೊ ಕೆಕ್ಲಾ ಕರೊಶಿ ಕದ್ಯೊ.<verse eid="MRK 7:13" /></para>
  <para style="s1">ಯಕ್ಕ ಮನಕ್ಹನೆ ಹೊಲಸ ಕರಾನು ಕಾಮ</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />ತೆ ಥಯಲ್ಪರ ಯೆಸು ಮನಕ್ಹೊನಾ ಗುಂಪನೆ ತಿಕನ ಬಲೈನ ತ್ಯುನೊನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ ಕ್ಹಾರಿಯೊ ಮಾರಿಯೊ ವಾತೊ ಕಾನ ದಿನ್ನ ಐಕೊ ವರಿ ತಿಳದಿಲಿವೊ. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />ಭಾರಾತು ಮನಕ್ಹೊನಾ ಮ್ಹೈ ಗೈನ ತ್ಯುನೊನೆ ಹೊಲಸ ಕರಾನು ಯಕ್ಕ ಬಿ ನತ್ತಿ; <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />ತೆನೈಸೊ ಮನಕ್ಹೊಮಾತು ಜಾ಼ವಾನು ತಿನೆಜ ಹೊಲಸ ಕರಸ.<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />ತೆ ಥಯಲ್ಪರ ಯೆಸು ಮನಕ್ಹೊನೆ ಛೊಡಿನ ಘರಮಾ ಜಾ಼ತಾಮಾ ತಿನಾ ಶಿಷ್ಯಾತಿನೆ ತೆ ವಾತನೊ ಮತ್ಲಬ ಸುವೈ ಕೈನ ಪುಚ಼ತಾಮಾ ತೆ ತ್ಯುನೊನೆ. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />ಯೆಸು ಶಿಷ್ಯಾವೊನೆ ಕದ್ಯೊ. ತುಮೊನೆ ತೆಕ್ಕಲಿಬಿ ಗ್ಯಾನ ನತ್ತಿಸು? ತುಮೊನೆ ಗೊತ್ತ ಥಾತು ನೈಸು ಯಕ್ಕ ಮನಕ್ಹನಾ ಮ್ಹೈಜಾ಼ವಾನು ಕ್ಹರಿಮಾಜ಼ ತಿನೆ ಹೊಲಸ ನೈ ಕರತು. ತೆವೊ ಸುಜ಼ ನತ್ತಿ ಭಾರಾತು ಮನಕ್ಹೊನಾ ಮ್ಹೈ ಜಾ಼ವಾನು. <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />ಕಾಕದ್ಯಾಮ ತೆ ಮನಸ್ಮಾ ಗಯಾವಾಚಿ ಪೆಟಮಾ ಗೈನ ಪಾಚಾ಼ತು ಭಾರು ಜಾ಼ವಸ (ಯೆಸು ಎ ಕೈನ ಖಾವಾನು ಕ್ಹಾರುಬಿ ಚ಼ೊಕು ವ್ಹೈ ಕದ್ಯೊ)<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />ಯೆಸು ವರಿ -ಮನಕ್ಹೊನಾ ಮ್ಹೈತು ಜಾ಼ವಾನುಜ಼ ಮನಕ್ಹೊನೆ ಹೊಲಸ ಕರಸ. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />ಯಕ್ಕ ಮನಕ್ಹನಾ ಮ್ಹೈತು ಕದ್ಯಾಮ ಮನಕ್ಹೊನಾ ಮನಸ ಮಾತು. ಜಾ಼ವಾನು ಕೈ ವ್ಹೈ ಕದ್ಯಾಮ ತೆ ತಿನೆ ಕೆಟ್ಟ ಕಾಮೊಮಾ ಚ಼ಲಾವಸ ತೆ ಕೈಯು ವ್ಹೈ ಕದ್ಯಾಮ ವೈಭಿಚಾರ ಕಾಮೊ ಚೊ಼ಟ್ಟಿತನಾ ಖಲಾಸ ಕರಾನು. <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />ಸುಳಿತನಾ ಹಾದರತನಾ ದೊಕಡಾವೊಪರ ಆಸ ಕೆಡತನಾ ಮೊಸ ಸಂಗಟ ಘಾಲ್ಲಿವಾನು ಗಾಳೊ ದಿವಾನು ಸೊಕ್ಕಕ ಸುಳ್ಳ ಬೊಲಾನು. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />ಎ ಕ್ಹಾರಿಯೊ ಕೆಟ ವಿಚಾರೊ ಮನಕ್ಹೊನಾ ಮ್ಹೈತು ಗೈನ ತೆ ಮನಕ್ಹನೆ ಹೊಲಸ ಕರಸ ಕದ್ಯೊ.<verse eid="MRK 7:23" /></para>
  <para style="s1">ಹೆಣ ಮನಕ್ಹನೊ ಬರೊಕ್ಹೊ</para>
  <para style="r">(<ref loc="MAT 15:21-28">ಮತ್ತಾಯ 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />ಯೆಸು ತ್ಯಾಂತೊ ಉಟಿನ ಜಾ಼ತೊ ತೊರ ಕವಾನಾ ಗಾಮ್ನಾ ನಜಿ಼ಕ ರ‍್ಹಯಲ ಪ್ರದೆಶೆ ಗಯೊ. ಗೈನ ಯಕ್ಕ ಘರಮಾ ಗಯೊ ತೆ ಕಿನೆಜ಼಼ ಗೊತ್ತ ಥಾವುನೈ ಕೈಲಿದ್ಯೊ. ತೆನೈಸೊ ತೆ ಝಕೈನ ರ‍್ಹವಾನೆ ಥಯೊ ನೈ <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />ತೆಳಾಮಾಜ಼ ಯಕ್ಕ ಹೆಣ ಮನಕ್ಹ ತಿನಿ ದಿಕ್ರಿನಾ ಅOಗಮಾ ಕೆಟ್ಟ ಆತ್ಮಾ ವ್ಹತ್ತಿ ಯೆಸು ತ್ಯಾ ಛೆ ಕೈನ ಸುದ್ದಿ ಐಕಿನ ತಿನಾ ಪಗೊಮಾ ಐನ ಪಡಿ. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />ತೆ ಹೆಣ ಮನಕ್ಹ ಬಿಜಿ ಜಾ಼ತನಿ ವ್ಹತ್ತಿ ತೆ ಶಿರಿಯ್ಯಾ ಪೊಯಿನಿಕ್ಕಯ ಪ್ರಾOತ್ಯ ಮಾ ಹುಟ್ಟಿತಿ ತೆ ಯಹುದ್ಯೊನಿ ಜಾ಼ತನಿ ನ್ಹೊತಿ. ತೆ ತಿನಿ ದಿಕ್ರಿನು ಕೆಟ್ಟ ಆತ್ಮಾ ಛೊಡಾ ಕೈನ ಯೆಸುಕನ ಮಾಂಗಿಲೆತಾಮಾ.<verse eid="MRK 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27" />ಯೆಸು ತಿನೆ- ಬಚ್ಚಾ಼ವೊನೆ ಪೈಲಾ ತೃಪ್ತ ಥಾವಾದೆ; ಬಚ಼್ಚಾಖಾವಾನೊ ರೊಕ್ಲೊ ಕಾಳ್ಳಿನ ಕುತ್ರಾವೊನಾ ಬಚ್ಚಾ಼ವೊನೆ ಘಾಲಾನು ಚೊ಼ಕು ವ್ಹೈಸು ಕದ್ಯೊ.<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />ತೆ ವಾತೆ ತೆ -ಸ್ವಾಮಿ ಆ ವಾತ ಕ್ಹರಿ ವ್ಹೈ ಟೆಬಲನಾ ಹೆಟಾ ರ‍್ಹಯಲ ಕುತ್ರಾವೊನಾ ಬಚ್ಚಾ಼ ಮನಕ್ಹನಾ ಬಚ್ಚಾ಼ನಾ ಹತಮಾತಾ ಪಡಲ ರೊಕ್ಲಾನಾ ತುಕಡಾ ಖಾವಸ್ತೊ ಕೈನ ಜ಼ವಾಬ ದೆತಾಮಾ.<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />ಯೆಸು ತಿನಿ ವಾತೆ ತಿನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ ತಾರಿ ದಿಕ್ರಿನೆ ಕೆಟ್ಟ ಆತ್ಮಾ ಛೊಡಿಪಾಡ್ಯುಸ ಜಾ಼ ಕದ್ಯೊ.<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />ತೆ ತಿನಾ ಘರೆ ಗೈನ ದೆಕ್ತಾಮಾ ತೆ ಛೊಕ್ರಿ ವಚ್ಚಾ಼ನಾಮಾ ಅರಾಮ ಕ್ಹುರೈತಿ ವರಿ ತಿನೆ ಕೆಟ್ಟ ಆತ್ಮಾ ಛೊಡಿನ ಗೈ ಪಡಿತಿ.<verse eid="MRK 7:30" /></para>
  <para style="s1">ಯೆಸು ಮುಕಾನೆ ಕಿವುಡಾನೆ ಅರಾಮ ಕರಲ</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />ತೆ ಥಯಲ್ಪರ ಯೆಸು ತೊರ ಗಾಮ ಛೊಡಿನ ಸಿದೊನ ಗಾಮ ಪರತೊ ದೆಕಪೊಲಿ ಗಲಿಲಾಯ ಸಮುಂದರಕನ ರ‍್ಹಯಲ 10 ಗಾಮೊ ದಾಟಿನ ಚಾ಼ಲ್ಯೊತೊ. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />ತೆಳಾಮಾ ದಕ್ಹಾಜ಼಼ನಾ ತ್ವದಲಿನ ಬೊಲಾನಾ ಯಕ್ಕ ಕ್ಯುಡಾನೆ -ಯೆಸುಕನ ಬಲೈ ಲೈನ ಇಪರ ತು ಹತ್ತ ಮ್ಹೆಲ ಕೈನ ಮಾಂಗಿಲಿದ್ಯಾ.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />ಯೆಸು ತಿನೆ ಮನಕ್ಹೊನಾ ಗುಂಪಮಾತೊ ಯಕ್ಕ ಬಗಲ ಬಲೈ ಲಿನ ಗೈನ ತಿನಾ ಬೊಟೊ ತಿನಾ ಕಾನೊಮಾ ಮುಕ್ಕಿನ ಥುಕ್ಕಿನ ತಿನಿ ಜಿಬ್ಬ ಮುಟ್ಯೊ. ಹಬಾಳನೆ ದೆಕಿನ ಉಸುಲ ಛೊಡಿನ ತಿನೆ <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />ಎಪ್ಫಥಾ ಕೈನ ಕದ್ಯೊ. ತೆ ವಾತನೊ ಮತ್ಲಬ ವ್ಹೈ ಖುಲ್ಲಾಥಾವಾದೆ ಕೈನ. <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />ಕತಾಮಾ ತೆಳಾಮಾಜ಼ ತಿನಾ ಕಾನೊ ಖುಲ್ಲಾಥಯಾ ತಿನಿ ಜಿಬ್ಬಬಿ ಖುಲ್ಲಾ ಥೈ ತೆ ತರಾಸನೈಸೊ ಬೊಲ್ಯೊ.<verse eid="MRK 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36" />ತೆಳಾಮಾ ಯೆಸು ಕಿನೆಜ಼಼ ಎ ತಿಳಸುನಕೊ ಕೈನ ತಾಕಿತ ಕರ‍್ಯೊ ವರಿ ಕೆಕ್ಲೊ ಕದ್ಯೊತಬಿ ವರಿ ಘನ್ನಾ ಮನಕ್ಹೊಕನ ಕದ್ಯೊ. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />ಎ ಐಕಲವಾಲಾ ಕ್ಹಾರಾಜ಼ನಾ ಘನ್ನಾ ಘಾಬ್ರಾಥೈನ ಕ್ಹಾರು ಚೊ಼ಕು ಕರ‍್ಯೊಸ ಕಿವ್ಡಾ ರ‍್ಹಯಲವಾಲಾನೆ ಐಕಾ ವರಕ್ಹು ಕರಸ. ಮುಕಾ ರ‍್ಹಯಲವಾಲಾನೆ ಬೊಲಾ ವರಕ್ಹು ಕರಸ ಕೈನ ತಿಳದಿಲಿದ್ಯಾ.<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s1">ಯೆಸು ಚಾರ ಹಜಾ಼ರ ಮನಕ್ಹೊನೆ ಅನ್ನ ಖಲಾಯಲ</para>
  <para style="r">(<ref loc="MAT 15:32-39">ಮತ್ತಾಯ 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />ತೆ ದಿನಮಾ ಮನಕ್ಹೊ,ಫರಿನ ಗುಂಪ ಥೈನ ಕುಡಿನ ಆತಾಮಾ ತ್ಯುನೊನೆ ಖಾವಾನೆ ಸು ನೈಸೊ ಯೆಸು ತಿನಾ ಶಿಷ್ಯಾವೊನೆ ನಜಿ಼ಕ ಬಲೈನ ವರಿ ಕದ್ಯೊ. <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />ಆ ಮನಕ್ಹೊನೆ ದೆಕಿನ ಮರಗಾ ಐಸ. ಯುನೆ ಮಕನ ಐನ ತನ ದಿನ್ನ ಥಯಾಸ. ಇವ್ನೊನೆ ಖಾವಾನೆ ಸುಜ಼ ನತ್ತಿ. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />ಇವ್ನೊನೆ ಭುಕ್ಕಕಾವೊನೆಜ಼ ಘರೆ ಮೊಕ್ಕಲಿಪಾಡ್ಯಾಮ ವಾಟಮಾ ಚಕ್ಕರ ಐನ ಪಡಿಜಾ಼ವಸ ಇವ್ನೊಮಾ ದಕ್ಹಾಜ಼಼ನಾ ದುರತಾ ಆಯಾಸತೊ.<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />ತಿನಾ ಶಿಷ್ಯಾ ಕದ್ಯಾ ಕುನ್ನಜ಼ ನೈಸೊ ಜ಼ಗಾಮಾ ರೊಕ್ಲಾ ಕಿಜ಼್ಗಾಂತಾ ಲೈನ ಯುನು ಪೆಟ ಭರಾಯ್ಯೆ? ಕದ್ಯಾ.<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />ಯೆಸು ತ್ಯುನೊನೆ ಪುಚ್ಯೊ ತುಮೊಕನ ಕೆಕ್ಲಾ ರೊಕ್ಲಾ ಛೆ ಕೈನ ತ್ಯುನೊನೆ ಪುಚ಼ಲಕ್ಹು ತಿವ್ನೆ</para>
  <para style="p" vid="MRK 8:5">ಕ್ಹಾತ ಛೆ ಕದ್ಯಾ.<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />ತೆಳಾಮಾ ಯೆಸು ತೆ ಮನಕ್ಹೊನಾ ಗುಂಪನೆ ಜಿಮಿನ್ಪರ ಬೈಟೊ ಕೈನ ಅಪ್ಪಣೆ ದಿನ್ನ ತೆ ಕ್ಹಾತ ರೊಕ್ಲಾ ಲಿನ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಕೈನ ರೊಕ್ಲಾ ಭಾಗಿನ ತಿನಾ ಶಿಷ್ಯಾಯೊನಾ ಹತ್ಮಾ ವಾಟಾಹುತಿ ದಿದ್ಯೊ. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />ತ್ಯುನೆ ತೆ ಗುಂಪಮಾ ರ‍್ಹಯಲವಾಲಾವೊನಾ ವಾಟಿನ ದಿದ್ಯಾ. ಎನೈಸೊ ತಿವ್ನೊಮಾ ದಕ್ಹಿಯೊ ನ್ಹಾನಿಯೊ ಮಚ್ಲಿ಼ಯೊ ವ್ಹತ್ತಿಯೊ ಯೆಸು ಲಿನ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಕೈನ ತ್ಯುನೊನೆ ವಾಟಾನೆ ದಿದ್ಯೊ. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />ತ್ಯುನೆ ಪೆಟ ಭರೆಲಕ್ಕಾ ಖೈನ ಉಗ್ರಲ ತುಕಡಾ ರೊಕ್ಲಾ ಮಳಾತಾಮಾ ಕ್ಹಾತ ಟೊಪ್ಲಿಯೊ ಥಯ್ಯೊ. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />ಖಾದಲವಾಲಾ ಕಮ ಜಾಸ್ತ ಚಾರ ಹಜಾ಼ರ ಮನಕ್ಹೊ ವ್ಹತ್ತಾ ಪಾಚ಼ಲ್ತೊ ಮನಕ್ಹೊನೆ ಮೊಕ್ಕಲಿಪಾಡ್ಯೊ. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />ಯೆಸು ತ್ಯುನೊನೆ ಮೊಕ್ಕಲಿಪಾಡಲ್ಪರ ತೆಳಾಮಾಜ಼ ತಿನಾ ಶಿಷ್ಯಾವೊನೆ ಲಿನ ಹಡ್ಗೊ ಚ಼ಡಿನ. ದಲ್ಮುಥ ಗಾಮೆ ಗಯಾ..<verse eid="MRK 8:10" /></para>
  <para style="s1">ಫರಿಸಾಯರೊ(ಪದ್ದತ ಶಿಕ್ಲಾವಾನಾ) ಅದ್ಬುತ ಕರ ಕದಲ</para>
  <para style="r">(<ref loc="MAT 16:1-4">ಮತ್ತಾಯ 16:1-4</ref>; <ref loc="LUK 11:16-29">ಲುಕ 11:16-29</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />ತೆಳಾಮಾ ಫರಿಸಾಯರೊ ಐನ ಯೆಸುನಾ ಕ್ಹಾತೆ ತಕ್ಕರಾರ ಕರತಾ. ತಿನೆ ಪರಿಕ್ಷಾ ಲಿವಾನಾಹುತಿ ವರಿ ಕ್ಹಾಪಡಾವಾಹುತಿ - ತು ಕ್ಹುದಾಕಂತೊ ಆಯಲ ರ‍್ಹಯೊಮ ಹಬಾಳಮಾ ಯಕ್ಕ ಅಗ್ದಿ ಮ್ಹೊಟು ಕಾಮ ಕರಿನ ದೆಕಾಡ ಕದ್ಯಾ. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />ತಿಕನ ಪುಚ್ತಾಮಾ ಯೆಸು ತಿನಿ ಆತ್ಮಾಮಾ ದುಕ ಕರಲಿನ ಉಸುಲ ಛೊಡ್ಯೊ ಎ ಮನಕ್ಹೊ ಅಗ್ದಿ ಮ್ಹೊಟು ಕಾಮ ಕಾ ಹುಡುಕಾನು ಕಾ? ಮಿ ತುಮೊನೆ ಕ್ಹರಿಜ಼ ಕೌಸ, ಮನಕ್ಹೊನೆ ಅಗ್ದಿ ಮ್ಹೊಟು ಕಾಮ ಕರಿನ ಸಾಕ್ಷಿ ನೈ ದೆಕಾಡತೊ. <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />ಕೈನ ತೆ ತ್ಯುವ್ನೊನೆ ಛೊಡಿನ ಹಡಾಗಾಮಾ ಚ಼ಡಿನ ಬಿಜಿ಼ ದಂಡಿಯೆ ಗಯೊ.<verse eid="MRK 8:13" /></para>
  <para style="s1">ಫರಿಸಾಯರೊ ಹೆರೊದ ವರಿ ಖಾಟೊ ಲೊಟನಿ</para>
  <para style="r">(<ref loc="MAT 16:5-12">ಮತ್ತಾಯ 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />ಶಿಷ್ಯಾ ಹಡಗಾಮಾ ಜಾ಼ತಾಮಾ ರೊಕ್ಲಾವೊನಿ ಭುತಿ ಭಾಂದಿಲಿವಾನು ಇಕ್ಹರ‍್ಯಾತಾ ಹಡಗಾಮಾ ತ್ಯುನೊನೆ ಯಕಜ಼ ರೊಕ್ಲೊ ವ್ಹತ್ತೊ ಬಿಜು಼ ಸುಜ಼ ನ್ಹೊತು. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />ಯೆಸು ತ್ಯುನೊನೆ. ಫರಿಸಾಯರೊ ವರಿ ಹೆರೊದನಾ ಖಾಟೊ ಲೊಟನಾ ವಾಸ್ತರ ಹುಶಾರ. ದೆಕಿ ಲಿವೊ ಕೈನ ಖರಿಮಾಜ಼಼ ತ್ಯುನೊನೆ ಕತಾಮಾ ತ್ಯುನೆ<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />ಅಪ್ನೊಕನ ರೊಕ್ಲಾ ನತ್ತಿ ಕೈನ ತೆ ಇಮ್ಮ ಬೊಲ್ಯೊ ಕೈನ ಶಿಷ್ಯಾ ತಿವ್ನೊಮಾಜ಼ ಬೊಲ್ಲಿವಾಡ್ಯಾತಾ.<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />ಯೆಸು ತೆ ತಿಳದಿಲಿನ ರೊಕ್ಲಾ ನತ್ತಿ ಕೈನ ಬೊಲ್ಲಿವಾನು ಕಾ? ತುಮೆ ಹಜು಼ನ ತಿಳದಿಲಿದ್ಯಾನತ್ತಿಸು? ತಿಳವಳಕಿ ನತ್ತಿ ಐ ಸು? ತುಮಾರಾ ಮನಸ್ಮಾ ತಿಳದ್ಯಾ ನತ್ತಿಸು? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />ಡೊಳಾ ರೈನ ಬಿ ದಿಕ್ಹ್ತು ನೈಸು? ಕಾನೊ ರೈನ ಬಿ ಐಕ್ತಾ ನೈಸು? ತುಮೊನೆ ಶೆ ನತ್ತಿಸು? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />ಮಿ ಪಾಂಚ಼ ರೊಕ್ಲಾ ಭಾಗಿನ ಪಾಂಚ಼ ಹಜಾ಼ರ ಮನಕ್ಹೊನೆ ವಾಟಾನೆ ದಿದಲಮಾ ಉಗ್ರಲ ತುಕಡಾ ಕೆಕ್ಲಾ ಭರ‍್ಯಾ ಕೈನ ಪುಚ಼ತಾಮಾ ತ್ಯುನೆ</para>
  <para style="p" vid="MRK 8:19">ಬಾರಾ ಟೊಪ್ಲಿಯೊ ಕದ್ಯಾ.<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />ವರಿ ಕ್ಹಾತ ರೊಕ್ಲಾ ಚಾರ ಹಜಾ಼ರ ಮನಕ್ಹೊನೆ ವಾಟಲಮಾ ಉಗ್ರಲ ಕೆಕ್ಕಲೆಯೊ ಟೊಪ್ಲಿಯೊ ಭರ‍್ಯಾ ಕೈನ ಪುಚ಼ತಾಮಾ</para>
  <para style="p" vid="MRK 8:20">ತ್ಯುನೆ ಕ್ಹಾತ ಟೊಪ್ಲಿಯೊ ಕದ್ಯಾ.<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />ತೆಳಾಮಾ ಯೆಸು ತ್ಯುನೊನೆ- ತುಮೊನೆ ಹಜು಼ನ ತಿಳವಳಕಿ ಐ ನತ್ತಿಸು? ಕೈನ ಪುಚ್ಯೊ.<verse eid="MRK 8:21" /></para>
  <para style="s1">ಯೆಸು ಕುಡ್ಡಾನೆ ಡೊಳಾ ದಿದಲ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />ವರಿ ತ್ಯುನೆ ಬೆತ್ಸಾಯಿ ಗಾಮೆ ಆಯಾ. ತ್ಯಾ ಮನಕ್ಹೊ ಯಕ್ಕ ಕುಡ್ಡಾನೆ ಯೆಸುಕನ ಬಲೈ ಲೈನ ಅನೆ ಮುಟ್ಟ ಕೈನ ತಿಕನ ಮಾಂಗಿಲಿದ್ಯಾ. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />ಯೆಸು ತೆ ಕುಡ್ಡಾನೊ ಹತ್ತ ಧರಿನ ಗಾಮ್ನಾ ಭಾರೊ ನಿಂಗೈನ ತಿನಾ ಡೊಳಾಪರ ಥುಕ್ಕಕಿನ ತಿಪರ ಹತ್ತ ಮ್ಹೆಲಿನ-ತುನೆ ಸುಬಿ ದಿಕ್ಹಾಡ್ಯುಸು? ಕೈನ ತಿನೆ ಪುಚ್ಯೊ.<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />ತೆ ಮಾತು ಉಚೈನ ದೆಕಿನ ಮನೆ ಮನಕ್ಹೊ ದಿಕ್ಹಾಡ್ಯಾಸ; ತ್ಯುನೆ ಝಾಡೊ ನಿಂಗತ ದಿಕ್ಹ್ಯಾತಬಿ ಫರವಾಡ್ಯಾಸ ಕದ್ಯೊ.<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />ತೆಳಾಮಾ ಯೆಸು ತಿನಾ ಡೊಳಾಪರ ಫರಿನ ಹತ್ತ ಮ್ಹೆಲ್ತಾಮಾ ;ತೆ ಡೊಳಾ ಖೊಲಿನ ದೆಕ್ತಾಮಾ ತೆ ಅರಾಮ ಥಯೊತೊ. ಕ್ಹಾರು ಚೊ಼ಕಿ ತರಾ ದಿಕ್ಹಾಡ್ಯುತು <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />ತೆಳಾಮ ಯೆಸು ತಿನೆ ತು ಎ ಗಾಮ್ನಾ ಮ್ಹೈ ಜಾ಼ವುನಕೊ ಕೈನ ತೆ ತಿನಾ ಘರೆ ಮೊಕ್ಕಲಿಪಾಡ್ಯೊ.<verse eid="MRK 8:26" /></para>
  <para style="s1">ಪೆತ್ರಾ ಯೆಸುನೆ ಕ್ರಿಸ್ತ ವ್ಹೈ ಕೈನ ಕದಲ</para>
  <para style="r">(<ref loc="MAT 16:13-20">ಮತ್ತಾಯ 16:13-20</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />ಯೆಸು ತಿನಾ ಶಿಷ್ಯಾ ಫಿಲಿಪ್ಪನ ಕೈಸರೆಯ ಕವಾನಾ ಗಾಮೆ ಮಳಲ ಗಾಮೊಯೆ ಚಾ಼ಲ್ಯಾತಾ ವಾಟಮಾ ಯೆಸು -ಮನಕ್ಹೊ ಮನೆ ಕುನ್ನ ವ್ಹೈ ಕೈನ ಕವಸ. ಕೈನ ಶಿಷ್ಯಾವೊನೆ ಪುಚ಼ತಾಮಾ. ತ್ಯುನೆ<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />ತುನೆ ದಕ್ಹಾಜ಼಼ನಾ ಬಾಪ್ತಿಸ್ಮ ದಿಲಾವಾಲೊ ಯೊಹಾನ ವ್ಹೈ ಕವಸ ; ದಕ್ಹಾಜ಼಼ನಾ ಎಲಿಯಾ ಕವಸ;ಹಜು಼ನ ದಕ್ಹಾಜ಼಼ನಾ ಪ್ರವಾದಿಮಾನೊ ಯಕ್ಲೊ ವ್ಹೈ ಕವಸ;<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />ಯೆಸು ತ್ಯುನೊನೆ ವರಿ ತುಮೆ ಮನೆ ಕುನ್ನ ವ್ಹೈ ಕವೊಸಿ? ಕೈನ ಪುಚ಼ತಾಮಾ ತಿಮಾನೊ</para>
  <para style="p" vid="MRK 8:29">ಪೆತ್ರಾ ತು ಕ್ರಿಸ್ತ ವ್ಹೈ ಕದ್ಯೊ.<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />ತೆ ವಾತೆ ಯೆಸು ಮಾರಾ ಹುತಿ ಕಿನೆಜ಼಼ ಕೌ ನಕೊ ಕದ್ಯೊ.<verse eid="MRK 8:30" /></para>
  <para style="s1">ಯೆಸು ತೆ ಮರವಾನು ತಿನೆ ಕಷ್ಟ ಆವಾನು ತಿಳಸಲ</para>
  <para style="r">(<ref loc="MAT 16:21-28">ಮತ್ತಾಯ 16:21-28</ref>; <ref loc="LUK 9:22-27">ಲುಕ 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />ಎನೈಸೊ ಮನಕ್ಹನೊ ದಿಕ್ರೊ ಘನ್ನು ಕಷ್ಟ ಖೈನ ಮ್ಹೊಟಾ ಮನಕ್ಹೊನಾ ಹತೆ ಖಾಸ ಯಾಜಕನಾ ಹತೆ ಶಾಸ್ತ್ರಿಯೊನಾಹತೆ ಇನ್ಕಾರಿನ ಮಾರಾ ಲಗಾಡಿಪಾಡಸ. ಮರಿನ ತನ ದಿನ್ಪರ‍ ವಾಚಿ಼ನ ಆವಾನು ಛೆ ಕೈನ ಉಪದೆಶ ಕವಾನು ಶುರು ಕರ‍್ಯೊ. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />ತೆ ತೆಳಾಮಾ ಯೆಸು ಎ ವಾತೊ ಝಾಕಿನ ಮ್ಹೆಲ್ಯಾ ವಾಚಿ಼ ಕದ್ಯೊ. ತೆಳಾಮಾ ಪೆತ್ರಾ ತಿನೊ ಹತ್ತ ಧರಿನ ತಿನೆ ಗದರಸಾನೆ ಚ಼ಾಲು ಕರ‍್ಯೊ.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />ತೆಳಾಮಾ ಯೆಸು ಶಿಷ್ಯಾವೊನೆ ಪಾಚೊ಼ ಫರಿನ ದೆಕಿನ ಪೆತ್ರಾನೆ ಸೈತಾನ. ಮಾರಾ ಕ್ಹಾಮೊ ಹುಬ್ರೌ ನಕೊ. ಜಾ಼. ತಾರಿ ವಿಚಾರ ವ್ಹೈ ಕ್ಹುದಾಕಂತು ಆಯಲ ವಿಚಾರ ನ್ಹವೈ ಕೈನ ಗದರಶೊ.<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />ತೆ ಥಯಲ್ಪರ ತಿನಾ ಶಿಷ್ಯಾವೊನಾವರಿ ಮನಕ್ಹೊನಾ ಗುಂಪನೆ ಬಲೈನ ತ್ಯುನೊನೆ ಸುಕದ್ಯೊ ಕದ್ಯಾಮ ಕಿನೆಬಿ ರ‍್ಹವಾದೆ ಮಾರಾ ಪಾಚಾ಼ ಆವಾನು ಮನಸ ರ‍್ಹಯುಮ ತಿನೆ ತೆ ಇಕ್ಹರಿನ ತಿನಿ ಶಿಲುವಿ ಉಚೈಲಿನ ಮಾರಾ ಪಾಚೊ಼ ಆವಾದೆ. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />ಕಯೊಬಿ ತಿನೊ ಜ಼ಲಮ ತೆ ವಚಾ಼ಡಿಲಿವಾನೆ ಕರತೊ ರ‍್ಹಯೊಮ. ತಿನೊ ಜ಼ಲಮ ತೆ ಜ಼ವೈ ಲಿವಸ. ನೈತೊ ತಿನೊ ಜ಼ಲಮ ಮಾರಾಹುತಿ ಸುವಾರ್ತೆನಾ ಹುತಿ ಜ಼ವಾಲಿದ್ಯೊಮ ತಿನೊ ಜ಼ಲಮ ತೆ ವಚಾ಼ಡಿಲಿವಸ. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />ಯಕ್ಕ ಮನಕ್ಹ ದುನಿಯಾಮಾ ಸುಬಿ ಗಳಶ್ಯೊಮ ತಿನೊ ಜ಼ಲಮ ಗೈ ಪಾಡ್ಯೊಮ ತಿನೆ ಸು ಫೈದೊ ಕದ್ಯಾಮ ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾನೊ ಹಮೆಶಾನೊ ಜ಼ಲಮ ಜ಼ವೈಲಿದ್ಯೊಮ ತಿನೆ ಸು ಫೈದೊ ವ್ಹೈ? ಸುಜ಼ ನ್ಹವೈ <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />ಯಕ್ಲೊ ತಿನಾ ಜ಼ಲಮನೆ ಸು ಮುಕ್ಕಿಲಿವಾನು ಛೆ. <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />ಕ್ಹುದಾನೊ ಭೆ ನೈಸೊವಾಲಾ ಎ ಪಾಪಿ ದಿನೊಮಾ ಮಾರಾ ಹುತಿ ಮಾರಿಯೊ ವಾತೊಕ್ಹು ಕುನ್ನ ಸರಮಸ ತಿನೆ ಮನಕ್ಹನೊ ದಿಕ್ರೊ ತೆ ತಿನಾ ಬಾಪ್ನಿ ಮಹಿಮಾನಾ ಕ್ಹಾತೆ ಪರಿಶುದ್ಧ ದುತೊನಾ ಕ್ಹಾತೆ ಆತಾಮಾ ತಿನಾ ಹುತಿ. ತೆ ಸರಮಸ ಕದ್ಯೊ.<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />ವರಿ ಕತೊ ರ‍್ಹತಾಮಾ ಅಮ್ಮ ಕದ್ಯೊ ತುಮೊನೆ ಕ್ಹರಿ ಕೌಸ. ನ್ಹ್ಯಾ ರ‍್ಹಯಲ ವಾಲಾಮಾನಾ ದಕ್ಹಾ ಜ಼ನಾ ಕ್ಹುದಾನಿ ತಾಕತನಿ ಅದಿಕಾರಕ್ಹು ರಾಜ್ಯ ಆವಾನು ದೆಕೆಲಕ್ಕಕಾ ತ್ಯುನೆ ಮರತಾನೈ. ಕದ್ಯೊ.<verse eid="MRK 9:1" /></para>
  <para style="s1">ಯೆಸುನು ಉಜಾಲಾನೊ ರುಪ ಹೊಂದಲ</para>
  <para style="r">(<ref loc="MAT 17:1-13">ಮತ್ತಾಯ 17:1-13</ref>; <ref loc="LUK 9:28-36">ಲುಕ 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />ವರಿ. ಛೆ. ದಿನ್ನ ಥಯಲ್ಪರ ಯೆಸು ಪೆತ್ರಾ ಯಾಕೊಬ ಯೊಹಾನ ತ್ಯುನೊನೆಜ಼ ಜು಼ದೊ ಬಲೈ ಲಿಂಗೈನ ಉಚ್ಚಾರ‍್ಹಯಲ ಡೊಂಗರಪರ ಗಯಾ ತೆಳಾಮಾ ತ್ಯುನಾ ಡೊಳಾಕ್ಹಾಮೊ ಯೆಸುನೊ ರುಪ ಬಿಜೊ಼ಥಯೊ <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />ತಿನಾ ಧೊಳಾ ವಣ್ಣಾ ಘನ್ನಾ ಮಿಂಚಾ಼ಡ್ಯಾತಾ ಜಿಮಿನ್ಪರ ರ‍್ಹಯಲವಾಲಾ ಕುನ್ನಜ಼ ಯಕ್ಲು ಹಸಾ ಧೊತಾ ನೈ ತೆಕ್ಲಾ ಧೊಳಾ ವ್ಹತ್ತಾ. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />ತೆಳಾಮಾ ಎಲಿಯಾ, ಮೊಶೆ, ಯೆಸುನಾ, ಕ್ಹಾತೆ ಬೊಲಾನು ತನ್ನೆ ಶಿಷ್ಯಾ ದೆಕ್ಯಾ.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />ತೆಳಾಮಾ ಪೆತ್ರಾ ಯೆಸುನೆ-ಗುರು ಅಪೆ ನ್ಹ್ಯಾಜ಼ ರ‍್ಹವಾನು ಚೊ಼ಕು ವ್ಹೈ ತನ ಝುಪ್ಡಾ ಭಾಂದಿಯೆ. ತುನೆ ಯಕ್ಕ ಮೊಶೆನೆ ಯಕ್ಕ ಎಲಿಯಾನೆ ಯಕ್ಕ ಇಮ್ಮ ಕದ್ಯೊ. <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />ಸು ಕವೊ ಕೈನ ತಿಳದ್ಯಾವಾಚಿ ಇಮ್ಮ ಬೊಲ್ಯೊ. ತ್ಯುನೆ ಘನ್ನಾ ಭುಚ್ಕಿ಼ ಗಯಾತಾ.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />ತೆಕ್ಲಾಮಾಜ಼಼ ಮ್ಹಾಡ ತ್ಯುನಾ ಉಪ್ಪರ ಐನ ಹುಬ್ರಯು. ತೆ ಮ್ಹಾಡಮಾತು ಎ ಮಾರೊ ಮಯಾನೊ ಥಯಲ ದಿಕ್ರೊ ವ್ಹೈ ಇನಿ ವಾತ ಐಕೊ ಕೈನ ಹಬಾಳಮಾತೊ ಬೊಲಲ ಅವಾಜ಼ ಐಯು.<verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />ತೆಳಾಮಾಜ಼ ತ್ಯುನೆ ಸುತ್ತೆ ದೆಕ್ತಾಮಾ ತ್ಯುನಾ ಕ್ಹಾತೆ ಯೆಸುನೆ ಛೊಡಿನ ಬಿಜು಼ ಕುನ್ನಜ಼ ದಿಕ್ಹ್ಯು ನೈ.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />ತ್ಯುನೆ ತೆ ಡೊಂಗರಪರತಾ. ಉತ್ರಿನ ಆತಾಮಾ ಯೆಸು ತ್ಯುನೊನೆ - ತುಮೆ ಎ ದೆಕಲ ಮನಕ್ಹನೊ ದಿಕ್ರೊ ಮರಿನ ಜುತೊ ಥೈನ ಉಟಿನ ಆಯೆಲಕ್ಕಾ ಕಿನೆಜ಼಼ ಕವೊನಕೊ ಕದ್ಯೊ. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />ತ್ಯುನೆ ತಿನಿ ವಾತ ಐಕ್ಯಾ. ತೆ ವಾತ ಧರಿನ ಮರಿನ ಜುತೊ ಥಾವಸ ಕದ್ಯಾಮ ಸುವೈ? ಕೈನ ತ್ಯುನೊಮಾಜ಼ ಬೊಲ್ಲಿದ್ಯಾ.<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />ಎನೈಸೊ ತ್ಯುನೆ ಎಲಿಯಾ ಪೈಲಾ ಆವಾನು ಛೆ ಕೈನ ಶಾಸ್ತ್ರಿಯೊ ಕವಸ್ತೊ. ಎ ಕಿಮ್ಮ? ಕೈನ ಯೆಸುನೆ ಪುಚ಼ತಾಮಾ ಯೆಸು.<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />ತೆ ಕದ್ಯೊ ಎಲಿಯಾ ಪೈಲಾ ಐನ ತಯ್ಯಾರ ಕರಸ ಕ್ಹರಿ ವ್ಹೈ ವರಿ ಮನಕ್ಹನಾ ದಿಕ್ರಾನಾ ಹುತಿ ತೆ ಘನ್ನೊ ಕಷ್ಟ ಖೈನ ಇನ್ಕಾರ ಥಾವಸ ಕೈನ. ಬರ್ದಲ ಛೆ ಎ ಕಿಮ್ಮ? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />ತೆನೈಸೊ ಮಿ ತುಮೊನೆ ಸು ಕೌಸ ಕದ್ಯಾಮ-ಎಲಿಯಾ ಆಯೊ ವರಿ ತಿನಿ ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಪೈಲಾಜ಼ ಬರ್ದಲ ಛೆ. ತಿಮ್ಮಜ ಮನಕ್ಹೊ ತ್ಯುನಾ ಮನಸ್ಮಾ ಕೆಟ ಆಯಲ ತಿಮ್ಮಜ಼ ತ್ಯುನೆ ಕರಿಪಾಡ್ಯಾ ಕದ್ಯೊ.<verse eid="MRK 9:13" /></para>
  <para style="s1">ಯೆಸು ಕೆಟ್ಟ ಆತ್ಮಾ ಧರಲವಾಲಾ ಪಟ್ಟಾನೆ ಅರಾಮ ಕರಲ</para>
  <para style="r">(<ref loc="MAT 17:14-20">ಮತ್ತಾಯ 17:14-20</ref>; <ref loc="LUK 9:37-43">ಲುಕ 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />ಎ ಥಯಲ್ಪರ ತ್ಯುನೆ ತಿನಾ ಉಗ್ರಲ ಶಿಷ್ಯಾವೊಕನ ಐನ ತಿವ್ನಾ ಸುತ್ತೆ ರ‍್ಹಯಲ ಮನಕ್ಹೊನು ಮ್ಹೊಟು ಗುಂಪ ತಿವ್ನಾ ಕ್ಹಾತೆ ಶಾಸ್ತ್ರಿಯೊ ತಕ್ಕರಾರ ಕರಾನು ದೆಕ್ಯಾ. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />ತೆಳಾಮಾಜ಼ ಗುಂಪಮಾ ರ‍್ಹಯಲವಾಲಾ ಯೆಸುನೆ ದೆಕಿನ ಘನ್ನಾ ಘಾಬ್ರಾಥೈನ ತಿಕನ ನ್ಹಾಟಿನ ಐನ ತಿನೆ ಹತ್ ಜೊ಼ಡ್ಯಾ.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />ಯೆಸು ಶಿಷ್ಯಾವೊನೆ ಪುಚ್ಯೊ? ಇವ್ನಾ ಕ್ಹಾತೆ ಸು ತಕ್ಕರಾರ ಕರಾಡಾಸ.<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />ಕೈನ ಪುಚ಼ಲ ಹುತಿ ತೆ ಗುಂಪಮಾನೊ ಯಕ್ಲೊ ಎ ಗುರು ಮಾರಾ ದಿಕ್ರಾನೆ ತುಕನ ಬಲೈ ಲಾಯೊಸ ಕಾಕದ್ಯಾಮ ಇನಾಮಾ ಭುತ್ಡು ಛೆ; ಎ ಬೊಲ್ತೊ ನೈ <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />ತೆ ಕಿಜ್ಗಾ಼ಬಿ ತಿಪರ ಐನ ತಿನೆ ಪಾಡಿಪಾಡಸ; ತೆಳಾಮಾ ತಿನಾ ಮ್ಹೊಡಾಮಾತು ಬುರುಕ ಚು಼ವಾವಸ. ವರಿ ಕಟ-ಕಟ ದಾತೊ ಖಾತೊ ಶಡ್ದೈ ಜಾ಼ವಸ ತೆ ಛೊಡಾಕೈನ ತಾರಾ ಶಿಷ್ಯಾವೊಕನ ಕೈಲಿದ್ಯೊ. ತಿವ್ನಾ ಹತೆ ಥಯ್ಯೊನೈ. ಕದ್ಯೊ.<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />ತಿನಾಹುತಿ ಯೆಸು ತಿನಾಶಿಷ್ಯಾವೊನೆ -ಎ ಬರೊಕ್ಹೊ ನೈಸೊವಾಲಾವೊ? ಮಿ ಹಜು಼ನ ಕೆಕ್ಲಾ ದಿನ್ನ ತುಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹೌ? ಹಜು಼ನ ಕೆಕ್ಲಾ ದಿನ್ನ ತುಮೊನೆ ತಡ್ದಿಲಿವ? ತೆ ಪಟ್ಟಾನೆ ಲಿನ ಮಕನ ಆವೊ.<verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />ಕತಾಮಾ ತೆ ಪಟ್ಟಾನೆ ಲಿನ ಯೆಸುಕನ ಆಯಾ ತಿನೆ ದೆಕಲ ಬರೊಬ್ಬರ ತೆ ಪಟ್ಟಾನೆ ಭುತ್ಡು ಘನ್ನು ವದ್ಯಾಡಸಿನ ತೆ ಜಿಮಿನ್ಪರ ಪಡಿನ ಮ್ಹೊಡಾಮಾನು ಬುರುಕ ಚು಼ವಾತೊ ಉಳ್ಯಾಡಶು.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />ಯೆಸು ತಿನಾ ಬಾನೆ ಇನೆ ಇಮ್ಮ ಥೈನ ಕೆಕ್ಲಾ ದಿನ್ನ ಥಯಾ. ಕೈನ ಪುಚ್ತಾ಼ಮಾ ಇನೆ</para>
  <para style="p" vid="MRK 9:21">ನ್ಹಾನೊ ರ‍್ಹತಮಾ ಇಮ್ಮ ಥಯುಸ ಕದ್ಯೊ. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />ವರಿ ಇನೆ ತೆ ಕೆಟ ಆತ್ಮಾ ಮಾರಿಪಾಡು ಕೈನ ಆಗಮಾ ಪಾನಿಮಾ ಪಾಡಿಪಾಡ್ಯುಸ. ತಾರಾ ಹತೆ ಥಾವಾನುರ‍್ಹಯುಮ ಮನೆ ಮರಗಿನ ಹಮ್ನೊನೆ ಸಹಾಯಾ ಕರಕೈನ ಕೈಲಿದ್ಯೊ.<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />ಯೆಸು ಎ ಸಾದ್ಯ ಛೆ ತಿನೆ ತಾರಾ ಹತೆ ಸುಬಿ ಥಾವಾನು ರ‍್ಹಯುಮ ಕಸಿಸು? ನಂಬಾಲಾವೊನೆ ಕ್ಹಾರುಜ಼ ಥಾವಸ ಕದ್ಯೊ.<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />ತೆಳಾಮಾಜ಼ ತೆ ಪಟ್ಟಾನೊ ಬಾ ಮಿ ಬರೊಕ್ಹೊ ಕರುಸ ಬರೊಕ್ಹೊ ಕಮ ಥಯೊತಬಿ ಸಹಾಯಾ ಕರ ದುಖಿ ಥೈನ ವದ್ರಿನ ಕದ್ಯೊ.<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />ತೆಳಾಮಾ ಯೆಸು ಮನಕ್ಹೊನು ಗುಂಪನೆ ನ್ಹಾಟಿನ ಆವಾನು ದೆಕಿನ ತೆ ಭುತ್ಡಾನೆ ಭುಚ್ಕಾ಼ಡಿನ ಎ ಕಿವುಡು ವರಿ ಮುಕಾ ಭುತ್ಡಾ ಪಟ್ಟಾನೆ ಛೊಡಿನ ಜಾ಼; ಇತ್ತಿ ಉಪ್ಪರ ಧರು ನಕೊ ಕೈನ ಮಿ ತುನೆ ಅಪ್ಪಣೆ ದ್ಯುಸ ಕದ್ಯೊ.<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />ತೆಳಾಮಾ ತೆ ಕೆಟ್ಟ ಆತ್ಮಾ ಪಟ್ಟಾನೆ ಘಾಬ್ರುಕರಿನ ವದ್ಯಾಡಸಿನ ಛೊಡಿನ ಗಯು. ತೆ ಪಟ್ಟೊ ಮರಲನಿಂಗತ ಪಡಲ ದೆಕಿನ ಮನಕ್ಹೊ-ಮರಿಗಯೊಸ ಕದ್ಯಾ. <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />ಯೆಸು ತೆ ಪಟ್ಟಾನೆ ಹತ್ ಧರಿನ ಉಟಾಡತಾಮಾ ತೆಳಾಮಾಜ಼ ಉಟಿನ ಹುಬ್ರಯೊ.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />ಯೆಸು ಘರೆ ಆತಾಮಾ ತಿನಾ ಶಿಷ್ಯಾ-ತೆ ಕೆಟ ಆತ್ಮಾನೆ ಛೊಡಾವಾನೆ ಹಮೊನೆ ಕಾ ಥಯ್ಯುನೈ ಕೈನ ಯಕ್ಲೊ ರ‍್ಹತಾಮಾ ಪುಚ಼ತಾಮಾ ಯೆಸು<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />ಎ ಜಾ಼ತ ಪ್ರಾಥನಾ ನೈಸೊ ವರಿ ಶಾಕ್ಹುಜ಼ ಜಾ಼ತಾನೈ ಕೈನ ತ್ಯುನೊನೆ ಕದ್ಯೊ.<verse eid="MRK 9:29" /></para>
  <para style="s1">ಯೆಸು ಬಿಜೆಕಸಲಾ ತಿನು ಮರಾನು ಕದಲ</para>
  <para style="r">(<ref loc="MAT 17:22-23">ಮತ್ತಾಯ 17:22-23</ref>; <ref loc="LUK 9:43-45">ಲುಕ 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />ಯೆಸು ವರಿ ತಿನಾ ಶಿಷ್ಯಾ ತ್ಯಾಂತಾ ಜಾ಼ತಾ ಗಲಿಲಾಯ ಗಾಮಪರತಾ. ಚಾ಼ಲ್ಯಾತಾ ತೆ ಮನಕ್ಹೊನೆ ಗ್ವತ್ತ ಥಾವುನೈ ಕೈನ ತಿನೆ ಮನಸ ವ್ಹತ್ತು. <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />ಕಾಕದ್ಯಾಮ ತೆ ತಿನಾ ಶಿಷ್ಯಾವೊನೆ ಉಪದೆಶ ಕರತೊ-ಮನಕ್ಹನಾ ದಿಕ್ರಾನೆ ಮನಕ್ಹೊನಾ ಹತ್ಮಾ ದಿಪಾಡಸ. ತ್ಯುನೆ ತಿನೆ ಖಲಾಸ ಕರಿಪಾಡಸ ವರಿಬಿ. ಖಲಾಸ ಕರಲ ತನ ದಿನ್ಪರ‍ ವರಿ ತೆ ಜಿವ್ತೊ ಥೈನ ಉಟಿನ ಆವಸ ಕೈನ ಕವಾಡೊತೊ. <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />ವರಿ ತೆ ವಾತೊ ತ್ಯುನೊನೆ ತಿಳದ್ಯಾನೈ ಮತ್ಲಬ ತಿಳದ್ಯು ನೈ ವರಿ ತ್ಯುನೆ ತಿನೆ ತೆ ವಾತನೊ ಮತ್ಲಬ ಪುಚ್ಚಾ಼ನೆ ಭುಚ಼್ಕ್ಕಯಾ.<verse eid="MRK 9:32" /></para>
  <para style="s1">ಕುನ್ನ ಮ್ಹೊಟು ವ್ಹೈ</para>
  <para style="r">(<ref loc="MAT 18:1-5">ಮತ್ತಾಯ 18:1-5</ref>; <ref loc="LUK 9:46-48">ಲುಕ 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />ವರಿ ಯೆಸು ವರಿ ತಿನಾ ಶಿಷ್ಯಾ ಕಪೆನೌರ್ಮಿಯೆ ಆಯಾ. ತೆ ತ್ಯಾ ತ್ಯುನೆ ಘರಮಾ ರ‍್ಹತಾಮಾ-ತುಮೆ ವಾಟಮಾ ರ‍್ಹತಾಮಾ ಸು ಬೊಲ್ಲಿವಾಡ್ಯಾತಾ ಕೈನ ತಿನಾ ಶಿಷ್ಯಾವೊನೆ ಪುಚ಼ತಾಮಾ. <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />ತ್ಯುನೆ ಗಪ್ಪಜ಼ ವ್ಹತ್ತಾ ಕಾಕದ್ಯಾಮ ತ್ಯುನೆ ವಾಟಮಾ ತ್ಯುನೊಮಾಜ಼ ಕುನ್ನ ಮ್ಹೊಟೊ ವ್ಹೈ ಕೈನ ಬೊಲ್ಲಿವಾಡ್ಯಾತಾ.<verse eid="MRK 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35" />ತೆ ಬೈಟಿನ ತಿನಾ ಬಾರಾ ಶಿಷ್ಯಾವೊನೆ ಬಲೈನ ತ್ಯುನೊನೆ ತುಮೊಮಾ ಕುನ್ನ ಅಗೊ ಥಾವಾನ ಕರಸ ತೆ ಕ್ಹಾರಾವೊತಿ ಪಾಚೊ಼ ರ‍್ಹವಾದೆ ತೆ ಕ್ಹಾರಾವೊನೊ ಆಳ ಥೌ ಕೈನ.<verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />ಯಕ್ಕ ನ್ಹಾನಾ ಬಚ್ಚಾ಼ನೆ ಲಿನ ತ್ಯುನಾ ವಚ಼ಮಾ ಹುಬ್ರಾಡಿನ ತಿನೆ ಗಳೆ ಮಳೈಲಿನ. ತ್ಯುನೊನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />ಕುನ್ನಬಿ ಮಾರಾ ನಾಮಪರ ಹವಾ ಬಚ್ಚಾ಼ವೊಮಾನಾ ಯಕ್ಲಾನೆಬಿ ಮಳೈ ಲಿದ್ಯಾಮ ತ್ಯುನೆ ಮನೆ ಮಳೈ ಲಿದಲ ನಿಂಗತ ವ್ಹೈ ; ವರಿ ಕುನ್ನಬಿ ಮನೆ ಮಳೈ ಲಿದ್ಯಾಮ ಮನೆ ನ್ಹವೈ. ಮನೆ ಮೊಕ್ಕಲಲ ವಾಲಾನೆ ಮಳೈ ಲಿದಲ ನಿಂಗತ ವ್ಹೈ ಕದ್ಯೊ.<verse eid="MRK 9:37" /></para>
  <para style="s1">ಅಪ್ನೊನೆ ವೈರಿ ನೈಸೊವಾಲೊ ಅಪ್ನೊ ವ್ಹೈ</para>
  <para style="r">(<ref loc="LUK 9:49-50">ಲುಕ 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />ಯೊಹಾನ ಯೆಸುನೆ ಭೊದಕ ಕುನ್ನಬಿ ಯಕ್ಲೊ ತಾರಾ ನಾಮಪರ ಕೆಟ್ಟ ಆತ್ಮಾ ಛೊಡಾವಾನು ಹಮೆ ದೆಕಿನ ತೆ ಹಮೊಮಾನೊ ನೈ ರ‍್ಹಯಲ ಕ್ಹು ತಿನೆ ಹಮೆ ಅಡ್ಡಿ ಕರ‍್ಯಾಸ ಕೈನ ಕದ್ಯೊ. ಕತಾಮಾ ಯೆಸು<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />ತಿನೆ ಅಡ್ಡಿಕರೊನಕೊ; ಮಾರಾ ನಾಮಪರ ಅದ್ಭುತ ಕರಿನ ಯಕದುಮ ಮಾರಾಹುತಿ ಕೆಟ ಬೊಲ್ತೊ ನೈ. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />ಅಪೊನೆ ವಿರೊಧ ನೈಸೊ ವಾಲೊ ತೆ ಅಪ್ನೊಜ಼ ವ್ಹೈ, <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />ತುಮೆ ಕ್ರಿಸ್ತನಾ ವ್ಹೈ ಕೈನ ತಿಳ್ದಿನ ತುಮೊನೆ ಕುನ್ನಬಿ ಯಕ್ಕ ತಾಂಬಿಯೊ ಪಾನಿ ಪಿವಾನೆ ದಿದ್ಯೊಮ ತಿನೆ ಆವಾನೊ ಪ್ರತಿಫಲ ತಿನೆ ಕ್ಹರಿಮಾಜ಼ ತಪ್ತೊನೈ. ಕೈನ ತುಮೊನೆ ಖರಿಮಾಜ ಕೌಸ.<verse eid="MRK 9:41" /></para>
  <para style="s1">ಪಾಪ ಕರಾನಾ ಹುತಿ ಎಚ಼್ಚರ</para>
  <para style="r">(<ref loc="MAT 18:6-9">ಮತ್ತಾಯ 18:6-9</ref>; <ref loc="LUK 17:1-2">ಲುಕ 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />ಮನೆ ನಂಬಲವಾಲಾವೊಮಾನೊ ಎ ನ್ಹಾನಾವೊಮಾನೊ ಯಕ್ಲಾನೆಬಿ ಮಪರಲ್ಯೊ ಬರೊಕ್ಹೊ ನೈಸೊ ಕರ‍್ಯೊಮ ತೆವಾನೆ ಗಳಾಮಾ ಮ್ಹೊಟೊ ದಗ್ಡೊ ಭಾಂದಿನ ಸಮುಂದರಮಾ ನಾಕಾನು‍ ಚೊ಼ಕು ವ್ಹೈ. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />ಎನೈಸೊ ತಾರೊ ಹತ್ತ ತಾರೊ ಬರೊಕ್ಹೊ ನೈಸೊ ಕರಾನೊ ರಹ್ಯೊಮ ತೆ ಹತ್ ಕತ್ರಿನ ನಾಕಿಪಾಡ ಬೆ ಹತೊ ರ‍್ಹೈನ ನರಕನಿ ನೈ ಇಜ್ಜಾ಼ವಾನಿ ಆಗಮಾ ಜಾ಼ವಾತಿಬಿ ಯಕ್ಕ ಹತ್ತ ನೈಸೊ ಕ್ಹುದಾಕನ ರ‍್ಹವಾನೊ ಹಮೆಶಾನೊ ಜ಼ಲಮ ವ್ಹಂದಾನೊ ಚೊ಼ಕು ವ್ಹೈ. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />ದಕ್ಹಾ ಗ್ರಿಕ ಪುಸ್ತಕೊಮಾ 44 ನಿ ವಚನಾ ಛೆ, ತೆ 48 ನಿ ವಚನ ನಿಂಗತಜ಼ ಛೆ.<note caller="+" style="f"><char style="fr" closed="false">9:44 </char><char style="ft" closed="false">ದಕ್ಹಾ ಮುಲ ಪುಸ್ತಕೊಮಾ 44 ವಚನಾ ಛೆ, ತೆ ಸು ವ್ಹೈ ಕದ್ಯಾಮ ತ್ಯುನೊನೆ ಖಾವಾನಾ ಕಿಡಾ ಮರತಾಜ಼ ನೈ ವರಿ ತ್ಯುನೊನೆ ಬಾಳಾನಿ ಆಗ ಇಜ್ಜಾ಼ತ್ತಿಜ಼ ನೈ 48 ವಚನಾ ದೆಕೊ </char></note> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />ವರಿ ತಾರೊ ಪಗ ತಾರೊ ಬರೊಕ್ಹೊ ನೈಸೊ ಕರಾನೆ ರ‍್ಹಯೊಮ ತಿನೆ ಕತ್ರಿಪಾಡ ತೆ ಪಗ ಕತ್ರಿನ ನಾಕಿಪಾಡ ಬೆ ಪಗೊ ರ‍್ಹೈನ ನರಕನಿ ನೈ ಇಜ್ಜಾ಼ವಾನಿ ಆಗಮಾ ಜಾ಼ವಾತಿಬಿ ಯಕ್ಕ ಪಗ ನೈಸೊ ಕ್ಹುದಾಕನ ರ‍್ಹವಾನೊ ಹಮೆಶಾನೊ ಜ಼ಲಮ ವ್ಹಂದಾನೊ ಚೊ಼ಕು ವ್ಹೈ <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />ದಕ್ಹಾ ಗ್ರಿಕ ಪುಸ್ತಕೊಮಾ 46 ನಿ ವಚನಾ ಛೆ, ತೆ 48 ನಿ ವಚನ ನಿಂಗತಜ಼ ಛೆ. <note caller="+" style="f"><char style="fr" closed="false">9:46 </char><char style="ft" closed="false">ದಕ್ಹಾ ಮುಲ ಪುಸ್ತಕೊಮಾ 46 ವಚನಾ ಛೆ, ತೆ ಸು ವ್ಹೈ ಕದ್ಯಾಮ ತ್ಯುನೊನೆ ಖಾವಾನಾ ಕಿಡಾ ಮರತಾಜ಼ ನೈ ವರಿ ತ್ಯುನೊನೆ ಬಾಳಾನಿ ಆಗ ಇಜ್ಜಾ಼ತ್ತಿಜ಼ ನೈ 48 ವಚನಾ ದೆಕೊ. </char></note> <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />ತಾರೊ ಡೊಳೊ ತಾರೊ ಬರೊಕ್ಹೊ ನೈಸೊ ಕರಾನೆ ರ‍್ಹಯೊಮ ತಿನೆ ಕಿತ್ತಿನ ನಾಕಿಪಾಡ ಬೆ ಡೊಳಾ ರ‍್ಹೈನ ನರಕಮಾ ಘಲಾಯಿಲಿವಾತಿಬಿ ಯಕ್ಕ ಡೊಳಾಕ್ಹು ಕ್ಹುದಾನಿ ರಾಜ್ಯಮಾ ರ‍್ಹವಾನು ತುನೆ ಕೆಕ್ಲು ಚೊ಼ಕು ವ್ಹೈ. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />ನರಕಮಾ</para>
  <para style="q1" vid="MRK 9:48">ತ್ಯುನೊನೆ ಕಡ್ಡಾನಾ ಕಿಡಾ ಮರತಾನೈ.</para>
  <para style="q2" vid="MRK 9:48">ತ್ಯುನೊನೆ ಬಾಳಾನಿ ಆಗ ಇಜ್ಜಾ಼ತಿ ನೈ<verse eid="MRK 9:48" /></para>
  <para style="m">
    <verse number="49" style="v" sid="MRK 9:49" />ಬಲಿನೆ ಮಿಟ್ಟು ಶುದ್ಧ ಕರಸ ತಿಮ್ಮಜ಼ ಹರಿ ಯಕ್ಲಾನೆ ಆಗಕ್ಹು ಶುದ್ಧ ಕರಸ.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />ಮಿಟ್ಟು ಚೊ಼ಕು ವ್ಹೈ; ಮಿಟ್ಟಾನಿಜ಼ ಸವಾದ ಗೈ ಪಡ್ಯುಮ ತಿನೆ ಶಾಕ್ಹು ಮಿಟ್ಟು ಕರೊಶಿ? ತುಮೊಮಾ ಮಿಟ್ಟಾ ನಿOಗತ ದೊಸ್ತಿ ರ‍್ಹವಾದೆ. ಯಕ್ಕಲಾಪರ ಯಕ್ಲೊ ಸಮಾಧಾನೆ ರ‍್ಹವೊ.<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s1">ಬೈಕೊನೆ ಛೊಡಿ ಪಾಡಾನಾ ಹುತಿ</para>
  <para style="r">(<ref loc="MAT 19:1-12">ಮತ್ತಾಯ 19:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />ಯೆಸು ತ್ಯಾಂತೊ ಉಟಿನ ಯೊರ್ದನ ನದಿನಾ ಬಿಜಿ಼ ದಂಡಿಯೆ ರ‍್ಹಯಲ ಯೊದಾಯಾ ಪ್ರಾಂತ್ಯ ಗಯೊ. ತ್ಯಾ ಮನಕ್ಹೊ ಫರಿನ ಗುಂಪ-ಗುಂಪ ಥೈನ ತಿಕನ ಆತಾಮಾ ಯೆಸು ತ್ಯುನೊನೆ ಪದ್ದತ ನಿಂಗತ ಕ್ಹುದಾನಿಯೊ ವಾತೊ ಕವಾಡೊತೊ.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />ತೆಳಾಮಾ ಫರಿಸಾಯರೊ ಕುಡಿನ ಐನ ಯೆಸುನೆ ಪರಿಕ್ಷಾ ಲಿವುಕೈನ ವಿಚಾರ ಕರಿನ ಆಯಾತಾ-ಯಕ್ಲೊ ತಿನಿ ಬೈಕೊನೆ ಛೊಡಿಪಾಡಾನು ಧರಮ ವ್ಹೈಸು ಕೈನ ಪುಚ್ಯೊ.<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />ತೆ ವಾತೆ ಯೆಸು - ಮೊಶೆ ತುಮೊನೆ ಸು ಆಗನ್ಯೆ ದಿದ್ಯೊಸ ಕತಾಮಾ<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />ತ್ಯುನೆ ತ್ಯಾಗ ಪತ್ರ ಬರ್ದಿನ ದಿನ್ನ ತಿನಿ ಬೈಕೊನೆ ಛೊಡಿಪಾಡ ಕೈನ ಮೊಶೆ ಅಪ್ಪಣೆ ದಿದ್ಯೊಸ ಕದ್ಯಾ.<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />ತೆಳಾಮಾ ಯೆಸು ತ್ಯುನೊನೆ ತಮಾರಿ ಮಂಡತನಾ ದೆಕಿನ ಮೊಶೆ ತೆ ಆಗನ್ಯಾ ಬರ್ದಿನ ಮ್ಹೆಲಿನ ಗಯೊಸ. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />ವರಿ ಕ್ಹುದಾ ಸೃಷ್ಟಿತೊಬಿ ಮನಕ್ಹೊನೆ ದಾಣಗೊ ಹೆಣ ಮನಕ್ಹ ಕರ‍್ಯೊಸ ಇನಾಹುತಿ ಧರಮ ಶಾಸ್ತ್ರ ಕವಸ್ತೊ. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />ದಾಣಗೊ ತಿನಾ ಯಾ ಬಾ ನೆ ಛೊಡಿನ ತಿನಿ ಬೈಕೊನಾ ಕ್ಹಾತೆ ಮಳಿನ ತ್ಯುನೆ ಭಂಬಿಜ಼ನಾ ಮಳಿನ ಯಕ್ಕ ಅಂಗ ಥಾವಸಕೈನ ಬರ್ದಲ ಛೆ. <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />ಇಮ್ಮ ರ‍್ಹಯಲ ತ್ಯುನೆ ಬೆಜ಼ನಾ ನ್ಹವೈ. ಯಕ್ಕ ಅಂಗ ಥಯಾಸ. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಕರಲ ಜೊ಼ಡಿ ಮನಕ್ಹೊ ದುರ ಕರುಜ಼ ನೈ. ಕದ್ಯೊ.<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />ಘರಮಾ ತಿನಾ ಶಿಷ್ಯಾ ಯೆಸುನೆ ತಿನಾಹುತಿ ಫರಿನ ಪುಚ಼ತಾಮಾ ತೆ ತ್ಯುನೊನೆ <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />ತಿನಿ ಬೈಕೊನೆ ಛೊಡಿನ ಬಿಜೆಕ್ಕಲಿನೆ ಹಿವಾ ಕರಲಿವಾಲೊ. ತಿನಿ ಬೈಕೊನೆ ದ್ರೊಹಿಥೈನ ವ್ಯಭಿಚಾರಕರಾಲೊ ಥಾವಸ. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />ತಿನಾನಿOಗತ ಬೈಕೊ ಮಾಟಿನೆ ಛೊಡಿನ ಬಿಜೆಕ್ಕಲಾನ ಹಿವಾ ಕರಲಿದಿಮ ತೆ ವ್ಯಭಿಚಾರ ಕರಾಲಿ ವ್ಹೈ ಕದ್ಯೊ.<verse eid="MRK 10:12" /></para>
  <para style="s1">ಯೆಸು ನ್ಹಾನಾ ಬಚ್ಚಾ಼ವೊನೆ ಆಶಿರ್ವಾದ ದಿದಲ</para>
  <para style="r">(<ref loc="MAT 19:13-17">ಮತ್ತಾಯ 19:13-17</ref>; <ref loc="LUK 18:15-17">ಲುಕ 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />ತೆ ಥಯಲ್ಪರ ದಕ್ಹಾಜ಼಼ನಾ ತಿವ್ನಾ ನ್ಹಾನಾ ಬಚ್ಚಾ಼ವೊನೆ ಯೆಸುನಾ ಹತೆ ಮುಟ್ಟಾವು ಕೈನ ತಿಕನ ಲಾತಾಮಾ ತಿನಾ ಶಿಷ್ಯಾ ತ್ಯುನೊನೆ ಭುಚ್ಕಾ಼ಡ್ಯಾ. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />ತೆ ಯೆಸು ದೆಕಿನ ಶಿಟ್ಟಥೈನ ತಿನಾ ಶಿಷ್ಯಾವೊನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ -ಬಚ್ಚಾ಼ವೊನೆ ಮಕನ ಆವಾನೆ ದಿವೊ ತ್ಯುನೊನೆ ಅಡ್ಡಿ ಕರೊ ನಕೊ. ಕ್ಹುದಾನಿ ರಾಜ್ಯ ಇವ್ನಾ ವರಕ್ಹಾವೊನೆ ವ್ಹೈ <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />ತುಮೊನೆ ಕ್ಹರಿಜ಼ ಕೌಸ ಕುನ್ನ ಬಚ್ಚಾ಼ನಾ ಮನಸ ನಿಂಗತ ಕ್ಹುದಾನಿ ರಾಜ್ಯ ಕುನ್ನ ವಪ್ಪಿಲೆತಾ ನೈ. ತೆ ತಿಮಾ ಮಳತೊಜ಼ ನೈ. <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />ತಿಮ್ಮ ಕೈನ ಬಚ್ಚಾ಼ವೊನೆ ಅವಳಿಲಿನ ಯಕೆಕ್ಕಲಾವೊಪರ ಹತ್ ಮ್ಹೆಲಿನ ಆಶಿರ್ವಾದ ದಿದ್ಯೊ.<verse eid="MRK 10:16" /></para>
  <para style="s1">ಯೆಸು ದೊಕಡಾವೊನಾ ಹುತಿ ಥಾವಾನು ಕೆಟ್ಟ ದೆಕಾಡಲ</para>
  <para style="r">(<ref loc="MAT 19:16-30">ಮತ್ತಾಯ 19:16-30</ref>; <ref loc="LUK 18:18-30">ಲುಕ 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />ಯೆಸು ವಾಟ ಧರಿನ ಜಾ಼ತಾಮಾ ಯಕ್ಲೊ ನ್ಹಾಟತೊ ತಿನಾ ಕ್ಹಾಮೊ ಐನ ಉಂದಾಗುಡಗಾ ಘಾಲ್ಲಿನ ಚೊ಼ಕಾ ಭೊದಕ ಮನೆ ಹಮೆಶಾನೊ ಜ಼ಲಮ ಮಳು ಕದ್ಯಾಮ ಮಿ ಸುಕರು ಕೈನ ಯೆಸುನೆ ಪುಚ಼ತಾಮಾ,<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />ಯೆಸು ತಿನೆ ಮಿ ಚೊ಼ಕೊ ವ್ಹೈ ಕೈನ ಕಾ ಕವಾಡ್ಯೊಸ? ಕ್ಹುದಾನೆ ಛೊಡಿನ ಬಿಜು಼ ಕುನ್ನಜ಼ ಚೊ಼ಕು ನ್ಹವೈ. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />ತುನೆ ಆ ಗೊತ್ತ ಛೆ ಸು ನರಹತ್ಯಾ ಕರುನೈ; ವ್ಯಭಿಚಾರ ಕರುನೈ ;ಚೊ಼ರಿಕರು ನೈ; ಸುಳ್ಳ ಸಾಕ್ಷಿ ಕವೊನೈ; ಮೊಸ ಕರುನೈ ತಾರಾ ಯಾ ಬಾನೆ ಮರ್ಯಾದಿ ದ್ಯು. ಕವಾನಿಯೊ ಕ್ಹುದಾನಿಯೊ ಆಗನ್ಯಾ ತುನೆ ಗೊತ್ತ ಛೆ ಕೈನ ಕದ್ಯೊ.<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />ತೆ ಯೆಸುನೆ - ಭೊದಕ ಮಿ ನ್ಹಾನೊ ರ‍್ಹತಾಮಾತೊ ಬಿ ಎ ಕ್ಹಾರು ಚೊ಼ಕಿತರಾ ಕರತೊ ಆಯೊಸ. ಕೈನ ಕತಾಮಾ<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />ಯೆಸು ತಿನೆ ಯಕ್ಕ ಸಂವಾ ದೆಕಿನ ಮಯಾ ಕರಿನ ತಿನೆ ತುನೆ ಯಕ್ಕ ಕಮ ಥಯುಸ ಜಾ಼ ತು ಗಳಸಲ ತೆಕ್ಲು ಇಕ್ಕಿನ ಗರಿಬೊನೆ ವಾಟ ಸ್ವರ್ಗಮಾ ತು ಸೌಕಾರ ರ‍್ಹಸಿ ತು ಮಾರಾ ಪಾಚೊ಼ ಆ ಕದ್ಯೊ.<verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />ತೆ ಘನ್ನೊ ಸೌಕಾರ ರ‍್ಹಯಲ ಹುತಿ ಎ ವಾತೆ ತೆ ಮ್ಹೊಡು ಉತಾರಲಿನ ದುಖಕ್ಹು ಗೈ ಪಾಡ್ಯೊ.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />ತೆಳಾಮಾ ಯೆಸು ಸುತ್ತೆ ದೆಕಿನ ತಿನಾ ಶಿಷ್ಯಾವೊನೆ ಸೌಕಾರ ರ‍್ಹಯಲ ವಾಲೊ ಕ್ಹುದಾನಿ ರಾಜ್ಯಮಾ ಆವಾನು ಘನ್ನು ಕಷ್ಟ ಛೆ ಕದ್ಯೊ.<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />ಶಿಷ್ಯಾ ತಿನಿ ವಾತ ಐಕಿನ ಘಾಬ್ರಾಥಯಾ. ಯೆಸು ಫರಿನೆ ತ್ಯುನೊನೆ-ಮಾರಾ ಬಚ್ಚಾ಼ವೊ,ಕ್ಹುದಾನಿ ರಾಜ್ಯಮಾ ಮಳಾನು ಕೆಕ್ಲು ಕಷ್ಟ ವ್ಹೈ. ಕದ್ಯೊ.<verse eid="MRK 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 10:25" />ಸೌಕಾರ ರ‍್ಹಯಲ ವಾಲೊ ಕ್ಹುದಾನಿ ರಾಜ್ಯಮಾ ಸೆರಾನು ಕೆಕ್ಲೊ ಕಷ್ಟ ವ್ಹೈ ಕದ್ಯಾಮ ಹುಂಟ ಕ್ಹೊಯಿನಾ ಡೊಳಾಮಾತು ಜಾ಼ವಾನು ಆಸಾನ ವ್ಹೈ ಕದ್ಯೊ.<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />ಎ ವಾತೆ ತ್ಯುನೆ ವರಿ ಘಾಬ್ರಾಥೈನ. ಇಮ್ಮ ರಹ್ಯುಮ ಕಿನೆ ರಕ್ಷಣೆ ಥಾವಸ. <figure style="fig" alt="Merchant leading a camel outside a city wall and gate" file="hk00041c.tif" size="col" copy="Horace Knowles ©" ref="10:25">ಗಾಮಮಾ ಉಂಟನಾ ಕ್ಹಾತೆ ಜಾ಼ವಾನೊ ವ್ಯಾಪಾರಿ</figure><verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />ಕೈನ ತ್ಯುನೊ ತ್ಯುನೊಮಾಜ಼ ಕೈಲಿವಾನು ದೆಕಿನ ಯೆಸು ತ್ಯುನೊನೆ ದೆಕಿನ ಎ ಮನಕ್ಹೊನೆ ಅಸಾದ್ಯ ವ್ಹೈ; ಕ್ಹುದಾನೆ ಅಸಾದ್ಯ ನ್ಹವೈ ಕ್ಹುದಾನೆ ಕ್ಹಾರು ಸಾದ್ಯ ವ್ಹೈ.<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />ಪೆತ್ರಾ ಬೊಲ್ಯೊ- ದೆಕ ಹಮೆ ಕ್ಹಾರುಜ಼ ಛೊಡಿನ ತಾರಾ ಪಾಚಾ಼ ಆವಾಡ್ಯಾಸ. ಕೈನ ಕವಾನು ಚ಼ಾಲು ಕರು ಕವಾಕ್ಹುಜ಼.<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />ಯೆಸು. ಮಿ ತುಮೊನೆ ಕ್ಹರಿಮಾಜ಼ ಕೌಸ ಕುನ್ನಬಿ ಮಾರಾಹುತಿ ಸುವಾರ್ತೆನಾ ಹುತಿ ಘರನೆ ರ‍್ಹವಾದೆ ಭೈ ಭೆನ ಯಾ ಬಾಪನೆ ಬಚ್ಚಾ಼ವೊನೆ ಜಿಮಿನ್ನೆ ಛೊಡಿನ. <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />ಛೊಡಲವಾಲಾನೆ ತಿನೆ ಹಮ್ನಾನಾ ಕಾಲಮಾ ಘರ, ಭಾಯೊ, ಭೆನೊ, ಯಾ, ಬಚ್ಚಾ಼, ಜಿಮಿನ ಎ ಕ್ಹಾರು ತ್ರಾಸನಾ ಕ್ಹಾತೆ ಕ್ಹಾರು ಮಳಸ. ವರಿ ಅಗಲ್ಯಾ ಜಗತಮಾ (ದುನಿಯಾ) ಕ್ಹುದಾಕನ ರ‍್ಹವಾನೊ ಹಮೆಶಾನೊ ಜ಼ಲಮ ಮಳಸ <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />ಘನ್ನಾ ಮನಕ್ಹೊ. ಪಾಚಾ಼ರ‍್ಹಯಲವಾಲಾ ಅಗಾ ಥಾವಸ ಅಗಾ ರ‍್ಹಯಲವಾಲಾ ಪಾಚಾ಼ಥಾವಸ ಇಮ್ಮ ಕದ್ಯೊ.<verse eid="MRK 10:31" /></para>
  <para style="s1">ಯೆಸು ತೆ ಮರಾನು ತನವಾ ಸಲಾ ತಿಳಸಾಯಲ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ಮತ್ತಾಯ 20:17-19</ref>; <ref loc="LUK 18:31-34">ಲುಕ 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />ಯೆಸು ವರಿ ತಿನಾ ಶಿಷ್ಯಾ ಯೆರುಸಲೆಮಿನಿ ವಾಟ ಧರಿನಜಾ಼ತಾಮಾ ಯೆಸು ಅಗೊ-ಅಗೊ ಚಾ಼ಲ್ಯೊತೊ. ತಿನಾ ಪಾಚಾ಼ ರಹೆಲ ಶಿಷ್ಯಾ ಗಲಿಬಿಲಿ ಥಯಾ ತಿವ್ನಾ ಕ್ಹಾತೆ ಆವಾಲಾ ಮನಕ್ಹೊ ಭುಚ಼್ಕಾ ವರಕ್ಹಾ ಥಯಾ. ತೆಳಾಮಾ ತೆ ತಿನಾ ಬಾರಾ ಶಿಷ್ಯಾವೊನೆ ಬಲೈನ ಫರಿನ ತಿನಾ ಕ್ಹಾತೆ ಅಗು ಥಾವಾನು ಕತೊರ‍್ಹತಾಮಾ ತ್ಯುನೊನೆ ಕತಾಮಾ <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />ದೆಕೊ ಅಪೆ ಯೆರುಸಲೆಮೆ ಚಾ಼ಲ್ಯಾಸ ವರಿ ಮನಕ್ಹನಾ ದಿಕ್ರಾನೆ ಖಾಸ ಯಾಜಕೊ ವರಿ ಶಾಸ್ತ್ರಿಯೊನಾ ಹತ್ಮಾ ಧರಿನ ದಿವಸ. ವರಿ ತ್ಯುನೆ ತಿನೆ ತಿಪರ ತಪ್ಪ ಘಾಲಿನ ಮರವಾನಿ ಶಿಕ್ಕಷಾದಿವಸ ಬಿಜಾ಼ ಮನಕ್ಹೊನಾ ಹತ್ಮಾ ದಿವಸ. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />ಇವ್ನೆ ತಿನೆ ಕದ್ರಾವಸ ತಿಪರ ಥುಕ್ಕಕಸ ತ್ಯುನೆ ತಿನೆ ಬಾರಕೊಲಕ್ಹು ಮಾರಸ ವರಿ ಖಲಾಸ ಕರಿಪಾಡಸ ತೆ ತನ ದಿನ್ನ ಥಯಲ್ಪರ ಜುತೊಥೈನ ಉಟಿನ ಆವಸ. ಕದ್ಯೊ.<verse eid="MRK 10:34" /></para>
  <para style="s1">ಯಾಕೊಬ ವರಿ ಯೊಹಾನ ಪುಚ಼ಲ</para>
  <para style="r">(<ref loc="MAT 20:20-28">ಮತ್ತಾಯ 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />ತೆಳಾಮಾ ಜೆಬೆದಾಯನಾ ದಿಕ್ರಾ ಯಾಕೊಬ ಯೊಹಾನ. ಯೆಸುಕನ ಐನ ತಿನೆ ಗುರು ಹಮೆ ಯಕ್ಕ ಮಾಂಗಿಯೆಸ. ತೆ ಹಮಾರಾ ಹುತಿ ಪುರಾಕರು ಕದ್ಯಾ. ಯೆಸು ತ್ಯುನೊನೆ -<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />ತುಮೊನೆ ಸು ಪುರಾಕರು ಕೈನ ಕತಾಮಾ.<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />ತು ಮಹಿಮಾನಾ ರಾಜ್ಯ ಸಿಂಹಾಸನಿ ಪದವಿಪರ ಬೈಟತಾಮಾ ಹಮೊಮಾ ಯಕ್ಲಾನೆ ಸಿದಾಹತೆ ಯಕ್ಲಾನೆ ಡಾವಾ ಹತ್ ಬಗಲ ಹಮೊನೆ ಬೈಟಾನೆ ದೆ ಕದ್ಯಾ.<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />ತೆಳಾಮಾ ಯೆಸು ತ್ಯುನೊನೆ-ತುಮೆ ಸು ಪುಚಾ಼ಡ್ಯಾಸ ತುಮೊನೆ ಗೊತ್ತನತ್ತಿ. ಮಿ ಪಾನಿ ಪಿವಾನಾ ತ್ರಾಸನಾ ತಾಂಬಿಯಾಮಾ ತುಮೊನೆ ಪಿವಾನೆ ಥಾವಸು? ಮನೆ ಥಾವಾನು ಬಾಪ್ತಿಸ್ಮ ತುಮೊನೆ ಕರೈಲಿವಾನೆ ಥಾವಸು. ಕೈನ ಪುಚ್ತಾ಼ಮಾ.<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />ತ್ಯುನೆ-ಥಾವಸ ಕದ್ಯಾ ತೆಳಾಮಾ</para>
  <para style="p" vid="MRK 10:39">ಯೆಸು ತ್ಯುನೊನೆ ಮಿ ಪಿವಾನಾ ತಾಂಬಿಯಾಮಾ ತುಮೆ ಪಿವೊಸಿ. ಮನೆ ಥಾವಾನು ಬಾಪ್ತಿಸ್ಮ ತುಮೊನೆ ಥಾವಸ. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />ವರಿಬಿ ಮಾರಾ ಆಜು಼ ಬಾಜು಼ಮಾ ಬೈಟಾನು ಅದಿಕಾರ ದಿವಾನು ಮಾರಾ ಹತ್ಮಾ ನತ್ತಿ. ಕ್ಹುದಾಜ಼ ದಿವಸ ತೆ ಕಿನಾಹುತಿ ತೆ ತಯ್ಯಾರ ಥೈಸ ತೆ ತಿನೆಜ ಮಳಸ ಕದ್ಯೊ.<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />ಉಗ್ರಲ ದಕ್ಹೆ ಶಿಷ್ಯಾ ಎ ಐಕಿನ ಯಾಕೊಬ ಯೊಹಾನ ಪರ ಶಿಟ್ಟಥಯಾ. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />ಯೆಸು ಕ್ಹಾರಾವೊನೆ ನಜಿಕ ಬಲೈನ ತ್ಯುನೊನೆ ಯೆಹುದಿ ನಾಯಕೊನೆ ಕ್ಹಾರು ಅದಿಕಾರ ದಿದ್ಯಾಸ ಎ ಕ್ಹಾರು ಅದಿಕಾರ ಬಿಜಾ಼ ಮನಕ್ಹೊಪರ ರಾಜ಼ ಕರುಸ ಕವಾಲಾ ತ್ಯುನೊಪರ ಅಹಂಕಾರಕ್ಹು ರಾಜ಼ ಕರಸ. ವರಿ ತ್ಯುನೊಮಾ ಮ್ಹೊಟೊ ಜ಼ಬರದಸ್ತಿಕ್ಹು ರಾಜ಼ ಚ಼ಲಾವಸ. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />ತುಮೊಮಾ ತಿಮ್ಮ ರ‍್ಹೌ ನೈ ತುಮೊಮಾ ಮ್ಹೊಟೊ ಥೌಸ ಕವಾಲೊರ‍್ಹಯೊಮ ತೆ ತಮಾರೊ ಸೆವಕ ಥೌ; <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />ವರಿ ತುಮೊಮಾ ಪೈಲಾ ಥೌಸಕವಾಲೊ ಕ್ಹಾರಾವೊನೊ ಆಳ ಥೌ. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />ಮನಕ್ಹನೊ ದಿಕ್ರೊಬಿ ಸೆವಾ ಕರೈಲಿವಾನೆ ನತ್ತಿ ಆಯೊ. ಸೆವಾ ಕರಾನೆ. ವರಿ ತೆ ಜ಼ಲಮ ದಿನ್ನ ಘನ್ನಾಜ಼ನಾವೊನೆ ಛೊಡಾವಾನೆ ಆಯೊಸ ಕದ್ಯೊ.<verse eid="MRK 10:45" /></para>
  <para style="s1">ಯೆಸು ಬಾರತಿಲೊಮಾಯಾ ಕವಾಲಾ ಕುಡ್ಡಾನೆ ಅರಾಮ ಕರಲ</para>
  <para style="r">(<ref loc="MAT 20:29-34">ಮತ್ತಾಯ 20:29-34</ref>; <ref loc="LUK 18:35-43">ಲುಕ 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />ತ್ಯುನೆ ಯೆರಿಕೊವಿಯೆ ಆಯಾ ಯೆಸು ತಿನಾ ಶಿಷ್ಯಾ ಮನಕ್ಹೊನು ಗುಂಪ ತೆ ಗಾಮತಾ ಜಾ಼ತಾಮಾ ತಿಮಾಯನೊ ದಿಕ್ರೊ ಬಾರ್ತಿಮಾಯಾ ತೆ ಕುಡ್ಡೊ ಮಾOಗಾನೆ ವಾಟನಾ ಬಾಜು಼ಮಾ ಬೈಟ್ಯೊತೊ. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />ತೆ ಕುಡ್ಡೊ ಭಿಕ ಮಾಂಗಾಲೊ ವ್ಹತ್ತೊ. ಎ ವಾಟಪರ ಜಾ಼ವಾನೊ ನಜ಼ರೆತನೊ ಯೆಸು ವ್ಹೈ ಕೈನ ಐಕಿನ ದಾವಿದನಾ ದಿಕ್ರಾ ಯೆಸು. ಮನೆ ಮರಗ ಕೈನ ವದ್ರಾನು ಚಾಲುಕರ‍್ಯೊ.<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />ಘನ್ನಾಜ಼ನಾ ತಿನೆ ಗಪ ರ‍್ಹೆ ವರಿ ತೆ ದಾವಿದನಾ ದಿಕ್ರಾ ಮನೆ ಮರಗ ಕೈನ ವರಿ ಜೊ಼ರ ವದರ‍್ಯೊ.<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />ತೆಳಾಮಾ ಯೆಸು ಹುಬ್ರೈನ ತಿನೆ ಬಲೈ ಲಾವೊ ಕದ್ಯೊ.</para>
  <para style="p" vid="MRK 10:49">ತೆಳಾಮಾ ಮನಕ್ಹೊ ತೆ ಕುಡ್ಡಾನೆ ಬಲೈನ ಖುಶಿ ಕರ ಉಟ. ತುನೆ ಬಲಾವಾಡ್ಯೊಸ ಕದ್ಯಾ. <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />ತೆ ತಿಪರ ವಳ್ಳಿದಲ ಪ್ಹಡಕು ನಾಕಿನ ಗಪ್ನೆ ಉಟಿನ ಯೆಸುಕನ ಆಯೊ.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />ಯೆಸು ತಿನೆ ಮಿ ತುನೆ ಸುಕರು ಕೈನ ಆಸ ಛೆ. ಕೈನ ಪುಚ್ತಾ಼ಮಾ.</para>
  <para style="p" vid="MRK 10:51">ತೆ ಕುಡ್ಡೊ ಮನೆ ಡೊಳಾ ದಿಕ್ಹಾವರಕ್ಹಾ ಕರ ಗುರು ಕದ್ಯೊ.<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />ಯೆಸು ತಿನೆ - ಜಾ಼ ತಾರೊ ಬರೊಕ್ಹೊ ತುನೆ ಅರಾಮ ಕರ‍್ಯೊಸ ಕದ್ಯೊ. ತೆಳಾಮಾಜ಼ ತಿನಾ ಡೊಳಾ ಆಯಾ. ತೆ ವಾಟಮಾ ತಿನಾ ಪಾಚೊ಼ಗಯೊ.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s1">ಯೆಸು ರಾಜಾ಼ ನಿಂಗತ ಯೆರುಸೆಲೆಮಾ ಗಯಲ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ಮತ್ತಾಯ 21:1-11</ref>; <ref loc="LUK 19:28-40">ಲುಕ 19:28-40</ref>; <ref loc="JHN 12:12-19">ಯೊಹಾನ 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />ತ್ಯುನೆ ಯೆರುಸಲೆಮ್ನಾ ನಜಿಕ ರ‍್ಹಯಲ ಬೆತ್ಪ ವರಿ ಬೆಥಾನ್ಯ ಐನ ತೆಲನಾ ಝಾಡನಾ ಡೊಂಗರೊಕನ ಗಯಾ ಯೆಸು ತಿನಾ ಶಿಷ್ಯಾವೊಮಾನಾ ಬೆಜ಼ನಾವೊನೆ ಬಲೈನ ತಿನಾ ಅಗೊ ಮೊಕಲ್ಯೊ <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />ತ್ಯುನೊನೆ ಅಮ್ಮ ಕೈನ ಮೊಕ್ಕಲ್ಯೊತುಮಾರಾ ಕ್ಹಾಮು ರ‍್ಹಯಲ ಗಾಮೆ ಜಾವೊ ; ತ್ಯಾ ಭಾಂದಲ ಕುನ್ನಜ಼ ನೈ ಚ಼ಡಲ ಯಕ್ಕ ಗದಡಾನು ಬಚ್ಚು಼ ತುಮೆ ದೆಕೊಸಿ ; ತಿನೆ ಛೊಡಿನ ನ್ಹ್ಯಾ. ಧರಿನ ಲಿನಾವೊ. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />ತುಮೊನೆ ಕುನ್ನಬಿ ಪುಚ್ಯುಮ ಮಾಲಕನೆ ಎ ಚಾ಼ಯೆಥೈಯುಸ ವರಿ ತೆಳಾನ ತೆಳಾಮಾಜ಼ ತಿನೆ ಫರಿನ ಮೊಕ್ಲಸ-<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />ತೆ ಶಿಷ್ಯಾ ಗೈನ ಗಾಮ್ನಾ ವಾಟೆ ರ‍್ಹಯಲ ಘರನಾ ಬಾಕಲ್ನಾ ಕ್ಹಾಮು ಗದಡಾನಾ ಬಚ್ಚಾ಼ನೆ ಭಾಂದಲ ದೆಕಿನ ಪಾಚಾ಼ತಾ ತ್ಯುನೆ ತಿನೆ ಛೊಡತಾಮಾ. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />ತ್ಯಾ ಹುಬ್ರಯಲ ದಕ್ಹಾ ಜ಼ನಾ ದೆಕಿನ - ಆ ಬಚ್ಚಾ಼ನೆ ಛೊಡಿನ ತುಮೆ ಸು ಕರೊಶಿ? <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />ಕೈನ ಪುಚ್ತಾಮಾ ತ್ಯುನೆ ಯೆಸು ಕದಲತಿಮ್ಮ ತ್ಯುನೆ ಕತಾಮಾ ತೆ ಮನಕ್ಹೊ ಲಿನ ಜಾ಼ವಾನೆ ದಿದ್ಯಾ. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />ಶಿಷ್ಯಾ ತೆ ಬಚ್ಚಾ಼ನೆ ಯೆಸುಕನ ಲೈನ ತಿವ್ನಾ ವಣ್ಣಾ ತಿಪರ ಘಾಲ್ತಾಮಾ ಯೆಸು ತಿಪರ ಚ಼ಡಿನ ಬೈಟ್ಯೊ. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />ತೆಳಾಮಾ ಘನ್ನಾಜ಼ನಾ ತಿವ್ನಾ ವಣ್ಣಾ ಕಾಡಿನ ವಾಟಪರ ವಚ್ಚಾ಼ಯಾ ವರಿ ದಕ್ಹಾಜ಼಼ನಾ ತ್ಯುನಾ ಮಳಾಮಾತಾ ಗರಿಯೊ ಕತ್ರಿನ ಲೈನ ವಾಟಪರ ವಚ್ಚಾ಼ಯಾ. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />ಯೆಸುನಾ ಅಗಾ ಪಾಚಾ಼ ಜಾ಼ವಾಲಾ</para>
  <para style="q1" vid="MRK 11:9">ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ.</para>
  <para style="q1" vid="MRK 11:9">ಕರ್ತಾನಾ ನಾಮಪರ ಆವಾಲಾನೆ ಆಶಿರ್ವಾದ<verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />ಹಮಾರೊ ಬಾ ಥಯಲ ದಾವಿದನಾ ರಾಜ್ಯನೆ ಕ್ಹುದಾ ಆಶಿರ್ವಾದ ದಿವಾದೆ ತೆ ರಾಜ್ಯ ಆವಾಡ್ಯೊಸ ಸ್ವರ್ಗಮಾ ರ‍್ಹಯಲ</para>
  <para style="q1" vid="MRK 11:10">ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಕೈನ ಜ಼ೊರ ವದ್ರ್ಯಾ.<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />ತೆಳಾಮಾ ಯೆಸು ಯೆರುಸಲೆಮ ಗೈನ ದೆವಾಲಯಮಾ ಗೈನ ಸುತ್ತೆ ಕ್ಹಾರು ದೆಕಿನ ತೆಕ್ಲಾಮಾಜ಼಼ ಕ್ಹಾಂಜ಼ ಥೈಗಯಲಹುತಿ ಬಾರಾ ಶಿಷ್ಯಾವೊನೆ ಬಲೈನೆ ಬೆಥಾನ್ಯ ಗೈ ಪಾಡ್ಯೊ.<verse eid="MRK 11:11" /></para>
  <para style="s1">ಉOಬ್ರೊನಾ ಝಾಡನೆ ಯೆಸು ಶಾಪ ದಿದಲ</para>
  <para style="r">(<ref loc="MAT 21:18-19">ಮತ್ತಾಯ 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />ಮರನಾದಿನೆ ತ್ಯುನೆ ಬೆಥಾನ್ಯ ಛೊಡಿನ ಆತಾಮಾ ಯೆಸು ಭುಕ್ಕೊ ಥಯೊತೊ. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />ವರಿ ಪಾಲೊ ಛೊಡಲ ಉOಬ್ರೊನು ಝಾಡ ದುರ ರ‍್ಹಯಲ ದೆಕ್ಯೊ. ತಿಮಾ ತಿನೆ ಖಾವಾನೆ ಸುಬಿ ಮಳಸ ಕೈನ ತಿನಾ ನಜಿಕ ಗಯೊ. ತಿನಾ ನಜಿ಼ಕ ಆತಾಮಾ ತಿಮಾ ಪಾಲೊ ಛೊಡಿನ ಬಿಜು಼ ಸುಜ಼ ದಿಖ್ಯ್ಹನೈ ತೆಳಾಮಾ ಉOಬ್ರೊನಾ ಫಲನೊ ದಿನ್ನ ನ್ಹೊತೊ. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />ತೆಳಾಮಾ ಯೆಸು ತೆ ಝಾಡನೆ - ಇತ್ತಿ ಉಪ್ಪರ ಯಕ್ಲೊಬಿ ತುಕನ ಫಲ ಹಮೆಶಾಬಿ ಖೌ ನೈಸೊ ಥಾವಾದೆ. ಕದ್ಯೊ. ತಿನಾ ಶಿಷ್ಯಾ ತೆ ವಾತ ಐಕ್ಯಾ.<verse eid="MRK 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />ತ್ಯುನೆ ಯೆರುಸಲೆಮೆ ಆತಾಮಾ ಯೆಸು ದೆವಾಲಯಮಾ ಗೈನ ತಿಮಾ ವ್ಯಾಪಾರ ಕರಾಲಾವೊನೆ ಲಿವಾಲಾವೊನೆ ದೊಕಡಾ ಬದ್ಲಿ ಕರಾವಾಲಾವೊನೆ ಮೊಕ್ಕಲಿಪಾಡಾನು ಶುರು ಕರ‍್ಯೊ ತಿವ್ನಾ ಟೆಬ್ಲೊ ಕ್ಹಬುತರನಿಯ್ಯೊ ಕುರಚಿಯೊ. ಪಾಡಿಪಾಡ್ಯೊ. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />ಯಕ್ಲಾನೆಬಿ ಸಾಮಾನಲಿನ ದೆವಾಲಯಮಾ ನಿಂಜಾ಼ವಾನೆ ದಿದ್ಯೊನೈ. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />ವರಿ ತೆ ಕ್ಹುದಾನಿಯೊ ವಾತೊ ಕೈನ- ಮಾರಿ ಆಲಯ ಕ್ಹಾರಿ ಜ಼ನಾಂಗನೆ ಪ್ರಾಥನಾನು ಘರ ವ್ಹೈ ಕೈನ ಕವೈಲಿವಸ ಕೈನ ಬರ್ದಲ ಛೆ ತೊ? ತುಮೆ ತೆ ಜ಼ಗಾನೆ ಚ್ವಟ್ಟಾವೊನು ಘರ ಕರಿಪಾಡ್ಯಾಸ ಕದ್ಯೊ.<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />ತೆ ವಾತ ಖಾಸ ಯಾಜಕ ವರಿ ಶಾಸ್ತ್ರಿಯೊ ಐಕಿನ ಯೆಸುನೆ ಕೈ ಉಪಾಯಕ್ಹು ಖಲಾಸಕರಿಯೆ ಕೈನ ಟೈಮ ದೆಕಾಡಾತಾ; ಕಾಕದ್ಯಾಮ ಮನಕ್ಹೊ ತಿನಿಯೊ ವಾತೊ ಐಕಿನ ಘನ್ನಾ ಘಾಬ್ರಾಥೈನ ವರಿ ತಿಕ್ಹು ಭುಚ಼್ಕಾಡ್ಯಾತಾ.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />ತೆ ದಿನ್ನಾ ಕ್ಹಾಂಜೆ ಯೆಸು ತಿನಾ ಶಿಷ್ಯಾ ಗಾಮ ಛೊಡಿನ ಭಾರಾ ಗಯಾ.<verse eid="MRK 11:19" /></para>
  <para style="s1">ಉಂಬ್ರೊನು ಝಾಡಕ್ಹು ಶಿಕ್ಕಾನು</para>
  <para style="r">(<ref loc="MAT 21:20-22">ಮತ್ತಾಯ 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />ಪಾಟೆ ತ್ಯುನೆ ಆತಾಮಾ ತೆ ಉಂಬ್ರೊನು ಝಾಡ ಬುಡತುಜ಼಼ ಕುಕ್ಹೈಗಯಲ ದೆಕ್ಯಾ. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />ತೆಳಾಮಾ ಪೆತ್ರಾ ಪಾಚು಼ ಥಯಲ ನೆಣಸಿನ ಯೆಸುನೆ - ಗುರು ದೆಕ ತು ಶ್ರಾಪ ದಿದಲ ಉOಬ್ರೊನು ಝಾಡ ಕುಕ್ಹೈ ಗಯುಸ ಕತಾಮಾ.<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />ಯೆಸು ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ ತುಮಾರೊ ಬರೊಕ್ಹೊ ಕ್ಹುದಾಪರ ರ‍್ಹವಾದೆ. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />ತುಮೊನೆ ಕ್ಹರಿಮಾಜ಼ ಕೌಸ, ಕಯೊಬಿ ರ‍್ಹವಾದೆ ಆ ಡೊಂಗರನೆ ತು ಕಿತ್ತೈನ ಸಮುಂದರಮಾ ಪಡ ಕೈನ ತಿನಾ ಮನಸ್ಮಾ ಸಂಶೊ ಕರ‍್ಯಾವಾಚಿ ತೆ ಕೈಲಿದಲ ಥಾವಸ ಕೈನ ಬರೊಕ್ಹೊ ಮ್ಹೆಲ್ಲಿದ್ಯೊಮ ತೆ ಕದಲ ತಿಮ್ಮ ಥಾವಸ. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />ತೆ ಕಾರಣಕ್ಹು ತುಮೆ ಪ್ರಾಥನಾಮಾ ಸು ಮಾಂಗಿಲಿವೊಸಿ ತೆ ಕ್ಹಾರು ಮಳ್ಯುಸ ಕೈನ ಬರೊಕ್ಹೊ ಮ್ಹೆಲ್ಯಾಮ ತೆ ಕ್ಹಾರು ತುಮೊನೆ ಮಳಸ ಕೈನ ತುಮೊನೆ ಕೌಸ. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />ಎನೈಸೊ ತುಮೆ ಹುಬ್ರೈನ ಪ್ರಾಥನಾ ಕರತಾಮಾ ಕಿಪರಬಿ ತುಮೆ ವಿರೊಧ ರ‍್ಹಯಾಮ ತುಮೆ ತಿನೆ ಮಾಫಕರೊ; ಮಾಫ ಕರ‍್ಯಾಮ ಸ್ವರ್ಗಮಾ ರ‍್ಹಯಲ ತುಮಾರೊ ಬಾ ತುಮಾರಾ ತಪ್ಪೊನೆ ಮಾಫಕರಸ ಇಮ್ಮ ಕದ್ಯೊ. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />ತೆನೈಸೊ ತುಮೆ ಬಿಜಾ಼ವೊನೆ ಮಾಫ ನೈ ಕರ‍್ಯಾಮ, ಪರಲೊಕಮಾ ರ‍್ಹವಾಲೊ ತುಮಾರೊ ಬಾಬಿ ತುಮಾರಾ ತಪ್ಪೊ ಮಾಫ ನೈ ಕರ್ತೊ.<verse eid="MRK 11:26" /></para>
  <para style="s1">ಯೆಸುನಾ ಅದಿಕಾರನಾ ಹುತಿ ಪುಚ಼ಲ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ಮತ್ತಾಯ 21:23-27</ref>; <ref loc="LUK 20:1-8">ಲುಕ 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />ತ್ಯುನೆ ಫರಿನ ಯೆರುಸಲೆಮೆ ಆತಾಮಾ ಯೆಸು ದೆವಾಲಯಮಾ ಫರತಾಮಾ ಖಾಸ ಯಾಜಕೊ ಶಾಸ್ತ್ರಿಯೊ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ಯೆಸುಕನ ಐನ - <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />ತು ಎಕ್ಹಾರು ಕೈ ಅದಿಕಾರಕ್ಹು ಕರಶಿ? ಯೆ ಕ್ಹಾರು ಕರಾನೆ ತುನೆ ಕುನ್ನ ಅದಿಕಾರದಿದ್ಯುಸ ಕೈ ತಿನೆ ಪುಚ್ಯಾ.<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />ಯೆಸು ತ್ಯುನೊನೆ - ಮಿ ತುಮೊನೆ ಯಕ್ಕ ವಾತ ಪುಚ಼್ಚುಸ,ಮನೆ ತುಮೆ ಜವಾಬ ದಿದ್ಯಾಮ ಮಿಬಿ ತುಮೊನೆ ಕಯಾ ಅದಿಕಾರಕ್ಹು ಯೆ ಕರಾಡ್ಯೊಸ ಕೌಸ. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />ಬಾಪ್ತಿಸ್ಮ ಕರಾವಾನೊ ಅದಿಕಾರ ಯೊಹಾನನೆ ಕ್ಹುದಾಕಂತೊ ಆಯೊಸು? ಮನಕ್ಹೊಕಂತೊ ಆಯೊಸ? ಜವಾಬ ದಿವೊ ಕದ್ಯೊ.<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />ತೆಳಾಮಾ ತ್ಯುನೆ - ಕ್ಹುದಾಕಂತೊ ಆಯೊಸ ಕದ್ಯಾಮ ತುಮೆ ತಿನೆ ಕಾ ನಂಬ್ಯಾನತ್ತಿ ಕೈಪಡಸ್ತೊ; ಮನಕ್ಹತಿ ಆಯುಸ ಕದ್ಯಾಮ ಸು ಥಾವಸ ಕೈನ ತಿವ್ನೊ ತಿವ್ನೊಮಾಜ಼ ಬೊಲ್ಲಿವಾಡ್ಯಾತಾ. <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />ಯೊಹಾನ ಪ್ರವಾದಿ ವ್ಹೈ ಕೈನ ಸುಜ಼ ಸಂಶಯವಾಚಿ ಮನಕ್ಹೊನೆ ಗೊತ್ತ ವ್ಹತ್ತು ಇವ್ನೊನೆ ಮನಕ್ಹೊನು ಭುಚ಼್ಕ ವ್ಹತ್ತೊ.<verse eid="MRK 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ -ಹಮೊನೆ ಗ್ವತ್ತ ನತ್ತಿ ಕೈನ ಯೆಸುನೆ ಜವಾಬ ದಿದ್ಯಾ.</para>
  <para style="p" vid="MRK 11:33">ತೆಳಾಮಾ ಯೆಸು ತ್ಯುನೊನೆ ಮಿ ಕೈ ಅದಿಕಾರಕ್ಹು ಎ ಕ್ಹಾರು ಕರುಸ ಕೈನ ನೈಕತೊ.<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s1">ದ್ರಾಕ್ಷಿಯೊನಾ ಮಳಾವೊನಾ ಹುತಿ ಸಾಮ್ಯ.</para>
  <para style="r">(<ref loc="MAT 21:33-46">ಮತ್ತಾಯ 21:33-46</ref>; <ref loc="LUK 20:9-19">ಲುಕ 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />ತೆಳಾಮಾ ಯೆಸು ತಿವ್ನಾ ಕ್ಹಾತೆ ಯಕ್ಕ ಸಾಮ್ಯ ಲಿನ ಕವಾಡೊತೊ. ಯಕ್ಕ ಮನಕ್ಹ ಯಕ್ಕ ದ್ರಾಕ್ಷಿನೊ ಮಳೊ ಕರಿನ ಸುತ್ತೆ ಬೆಲಿ ಘಾಲಿನ ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹ ಕಾಡಾಹುತಿ ಯಕ್ಕ ಖಾಡಿನಿಂಗತ ಕರಿನ ಕೈದಾಲಾನೆ ಯಕ್ಕ ಝುಪ್ಡು ಭಾಂದಿನ ತೆ ಮಾಲಕ ದ್ರಾಕ್ಷಿಯೊನೊ ಮಳೊ ದಕ್ಹಾ ರೈತರೊನೆ ಗುತ್ತಿಗೆ ದಿನ್ನ ಗಾಮೊಪರ ಗಯೊ. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />ತೆ ಥಯಲ್ಪರ ದ್ರಾಕ್ಷಿಯೊನೊ ಸಿಜ಼ನನೊ ಟೈಮ ಆತಾಮಾ ದ್ರಾಕ್ಷಿಯೊನೊ ಮಳಾನೊ ವಾಟೊ ಪುಚ್ಚಾ಼ನೆ ರೈತರೊಕನ ತೆ ಮಾಲಕ ತಿನಾ ಯಕ್ಕ ಆಳನೆ ತಿವ್ನೊಕನ ಮೊಕಲ್ಯೊ. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />ತ್ಯುನೆ ತಿನೆ ಧರಿನ ಮಾರಿನ ಸುಜ಼ ದಿದ್ಯಾವಾಚಿ ಖಾಲಿ ಹತೆ ಮೊಕ್ಕಲಿಪಾಡ್ಯಾ. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />ತೆ ಮಾಲಕ ಫರಿನ ವರಿ ಯಕ್ಲಾ ಆಳನೆ ಮೊಕಲ್ತಾಮಾ ತೆ ರೈತರೊ ತಿನೆ ಮಾತಾ ಮಾತಾಪರ ಮಾರಿನ ಮರ್ಯಾದಿ ಕಾಡ್ಯಾ. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />ತೆ ಥಯಲ್ಪರ ಮಳಾನೊ ಮಾಲಕ ವರಿ ಯಕ್ಲಾನೆ ಮೊಕಲ್ತಾಮಾ ತಿನೆಬಿ ಖಲಾಸ ಕರಿಪಾಡ್ಯಾ. ಹಜು಼ನ ದಕ್ಹಾ ಜ಼ನಾವೊನೆ ಮೊಕಲ್ತಾಮಾ ತಿಮಾನಾ ದಕ್ಹಾ ಜ಼ನಾವೊನೆ ಮಾರಿನ ದಕ್ಹಾ ಜ಼ನಾವೊನೆ ಕತ್ರಿನ ನಾಕಿಪಾಡ್ಯಾ<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />ತಿನೆ ಹಜು಼ನ ಯಕ್ಲೊ ವ್ಹತ್ತೊ. ಕುನ್ನ ವ್ಹೈ ಕದ್ಯಾಮ ತಿನೊ ಮಯಾನೊ ದಿಕ್ರೊ ಮಾರಾ ದಿಕ್ರಾನೆತಬಿ ಮೊಕಲ್ಯೊಮ ತಿನೆ ಮರ್ಯಾದಿ ದೆಸಕೈನ ಮಾಲಕನಾ ತರಪತೊ ಲಾಸ್ಟಮಾ ತಿನೆ ತ್ಯುನೊಕನ ಮೊಕ್ಕಲತಾಮಾ ತೆನೈಸೊ ತೆ ರೈತರೊ<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />ತೆಜ಼ ವಾರಿಸದಾರ ವ್ಹೈ ಕೈನ. ಮಾಲಕನಾ ದಿಕ್ರಾನೆ ಖಲಾಸ ಕರಿಪಾಡಿಯೆ ತೆಳಾಮಾ ಎ ಪುರಾ ಅಪ್ನೊನೆ ಥೈಜಾ಼ವಸ. ಕೈನ ರೈತರೊ ಯಕ್ಲಾನಾ ಕ್ಹಾತೆ ಯಕ್ಲಾ ಬೊಲ್ಲಿವಾಡ್ಯಾತಾ. <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />ತಿನೆ ಧರಿನ ಖಲಾಸ ಕರಿನ ತಿನು ಅOಗ ದ್ರಾಕ್ಷಿನಾ ಮಳಾನಾ ಭಾರಾ ನಾಕಿಪಡ್ಯಾ.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />ಯೆಸು ಪುಚ್ಯೊ ತಿಮ್ಮ ಥಯುಮ ದ್ರಾಕ್ಷಿನೊ ಮಳಾನೊ ಮಾಲಕ ಸುಕರೆ? ತೆ ಯಕ್ಕ ರೈತರೊನೆ ಖಲಾಸಕರಿನ ಬಿಜಾ಼ ರೈತರೊನೆ ವಪ್ಸಿನ ದಿವಸ. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />ತುಮೆ ಗ್ರOಥಮಾ ಒದ್ಯಾವಸೆತೊ</para>
  <para style="q1" vid="MRK 12:10">ಘರ ಭಾಂದಾಲಾವೊನೆ ನಕೊ ಚಾ಼ಯೆ ಕೈನ ಭಿರಕಾಯಲ</para>
  <para style="q2" vid="MRK 12:10">ದಗ್ಡೊಜ಼ ಚಾ಼ಯೆಥಯಲ ಮುಲಾನೊ ದಗ್ಡೊ ಥಯೊ.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />ಎ ಕರ್ತಾನಾ ಹತೆ ಥಯು;</para>
  <para style="q2" vid="MRK 12:11">ಹಮೊನೆ ಆಶ್ಚರ್ಯನಿಂಗತ ದಿಕ್ಹಸ ನೈ.<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />ಎ ಸಾಮ್ಯ ಅಪ್ನಾಹುತಿ ಕದ್ಯೊ ಕೈನ ತ್ಯುನೆ ತಿಳದಿಲಿನ ತಿನೆ ಧರಾಹುತಿ ಯೆಹುದಿಯೊನಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ಟೈಮ ದೆಕಾಡಾತಾ ವರಿ ಮನಕ್ಹೊನೆ ಭುಚ಼ಕಿನ ತಿನೆ ಛೊಡಿನ ಗಯಾ.<verse eid="MRK 12:12" /></para>
  <para style="s1">ಭು ಭಾಡಾನಾಹುತಿ ಹುತಿ ಪುಚ಼ಲ</para>
  <para style="r">(<ref loc="MAT 22:15-22">ಮತ್ತಾಯ 22:15-22</ref>; <ref loc="LUK 20:20-26">ಲುಕ 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />ತೆ ಥಯಲ್ಪರ ಯೆಸುನೆ ವಾತೊಮಾ ತಪ್ಪ ಧರುಕೈನ ಫರಿಸಾಯರೊ ವರಿ ಹೆರೊದ್ಯೆ ಗುOಪ ಮಾನಾ ದಕ್ಹಾ ಜ಼ನಾವೊನೆ ಯೆಸುಕನ ಮೊಕ್ಕಲ್ಯಾ. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />ಇವ್ನೆ ಐನ ಭೊದಕ, ತು ಕ್ಹರಿನೊಜ಼ ವ್ಹೈ. ಕಿನೆಜ಼಼ ಭುಚ಼ಕಾಲೊ ನ್ಹವೈ; ತು ಮನಕ್ಹೊನಾ ಮ್ಹೊಡಾ ದೆಕ್ಯಾವಾಚಿ ಬೊಲಾಲೊ ವ್ಹೈ ವರಿ ಕ್ಹುದಾನಿ ವಾಟ ಕ್ಹರಿಮಾಜ಼ ದೆಕಾಡಾಲೊ ವ್ಹೈ ಕೈನ ಹಮೆ ತಿಳದಿಲಿದ್ಯಾಸ ರೊಮನನಾ ಚಕ್ರವರ್ತಿನೆ ಅಪೆ ಭುಭಾಡೊ ದಿವಾನು ಅಪ್ನಾ ನಿಯಮನಾ ವಿರುದ್ದ ವ್ಹೈ ಅಪೆ ದ್ಯುಸು ನೈ. <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />ಯೆಸು ತಿವ್ನು ಕಪಟ ತಿಳ್ದಿನ - ಮನೆ ಕಾ ಪರಿಕ್ಷಾ ಕರಾಡಾಸ?</para>
  <para style="p" vid="MRK 12:15">ಮನೆ ರುಪ್ಪಾನೊ ಯಕ್ಕ ಬಿಲ್ಲೊ ಲೈನ ದೆಕಾಡೊ ಕತಾಮಾ ತ್ಯುನೆ ಲಾಯಾ. <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />ತೆಳಾಮಾ ತೆ ಆ ಬಿಲ್ಲಾಪರ ರ‍್ಹಯಲ ಮ್ಹೊಡು ವರಿ ನಾಮ ಕಿನು ವ್ಹೈ ಕೈನ ಪುಚ್ತಾಮಾ</para>
  <para style="p" vid="MRK 12:16">ತ್ಯುನೆ ಚಕ್ರವರ್ತಿನೆ ವ್ಹೈ ಕದ್ಯಾ.<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />ಯೆಸು ತ್ಯುನೊನೆ ಥೈಯು, ಚ಼ಕ್ರವರ್ತಿನು ರ‍್ಹಯಲ ಚ಼ಕ್ರವರ್ತಿನೆ ದಿವೊ. ಕ್ಹುದಾನು ರ‍್ಹಯಲ ಕ್ಹುದಾನೆ ದಿವೊ ಕದ್ಯೊ.</para>
  <para style="p" vid="MRK 12:17">ತ್ಯುನೆ ತಿನಿ ವಿಚಾರ ದೆಕಿನ ಘನ್ನಾ ಘಾಬ್ರಾಥಯಾ.<verse eid="MRK 12:17" /></para>
  <para style="s1">ಪುನರುತ್ಥಾನನಾ ಹುತಿ ಪುಚ಼ಲ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ಮತ್ತಾಯ 22:23-33</ref>; <ref loc="LUK 20:27-40">ಲುಕ 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />ತೆ ಥಯಲ್ಪರ ಪುನರುತ್ಥಾನ ನತ್ತಿ ಕವಾಲಾ ಸದ್ದುಕಾಯರೊ ಯೆಸುಕನ ಐನ ಪುಚ್ಯಾ. <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />ಇವ್ನೆ ಯೆಸುಕನ ಐನ ಪ್ರಶ್ನೆ ಸು ಪುಚ್ಚಾಕದ್ಯಾಮ ಭೊದಕ ಮೊಶೆನಾ ನಿಯಮನಾ ಹುತಿ, ಯಕ್ಕ ಮನಕ್ಹ ಬಚ್ಚಾ಼ ನೈಸೊ ಬೈಕೊನೆ ಛೊಡಿನ ಮರಿಗಯೊಮ ತಿನೊ ನ್ಹಾನೊ ಭೈ ತೆ ರಾOಡಿನೆ ಹಿವಾ ಕರಲಿನ ತಿನಾ ಮ್ಹೊಟಾ ಭೈನಾ ನಾಮೆ ಬಚ್ಚಾ಼ಹುಟ್ಸಾನು ಛೆ ಕೈನ ಹಮೊನೆ ಮೊಶೆ ಬರ್ದಿನ ಮ್ಹೆಲ್ಯೊಸ್ತೊ. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />ಕ್ಹಾತ ಭಾಯೊ ವ್ಹತ್ತಾ. ಪಸ್ಟ ರ‍್ಹಯಲವಾಲೊ ಹಿವಾ ಕರಲಿನ ಬಚ್ಚಾ಼ ನೈಸೊ ಮರಿಗಯೊ. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />ಬೆವಾವಾಲೊ ತೆ ಹೆಣ ಮನಕ್ಹನೆ ಹಿವಾ ಕರಲಿನ ಬಚ್ಚಾ಼ ನೈಸೊ ಮರಿಗಯೊ. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />ತಿನಾನಿಂಗತಜ಼ ತನವಾವಾಲೊ ಬಿ ಇನಾನಿಂಗತಜ಼ ಕ್ಹಾತೆ ಜ಼ನಾ ಬಚ್ಚಾ಼ ನೈಸೊ ಮರಿ ಗೈ ಪಡ್ಯಾ. ಲಾಸ್ಟಮಾ ತೆ ಹೆಣ ಮನಕ್ಹ ಮರಿ ಗೈ. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />ಪುನರುತ್ಥಾನಮಾ ತೆ ಕಿನಿ ಬೈಕೊ ಥೈನ ರ‍್ಹ್ಯೆ? ತಿನೆ ಕ್ಹಾತೆ ಜ಼ನಾ ಹಿವಾ ಕರಲಿದ್ಯಾಸ್ತೊ ಕದ್ಯಾ.<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />ಯೆಸು ತ್ಯುನೊನೆ, ತುಮೆ ಕಾ ತಪ್ಪಮಾ ಛೆ ವರಿ ತುಮೆ ಕಾ ತಪ್ಪ ವಿಚಾರಮಾ ಛೆ ಕಾಕದ್ಯಾಮ. ಕ್ಹುದಾನಿ ತಾಕತನೆ ರ‍್ಹವಾದೆ ಪವಿತ್ರ ಗ್ರಂಥನೆ ರ‍್ಹವಾದೆ ತಿಳದಿಲಿದ್ಯಾ ನತ್ತಿ <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />ಮರಲವಾಲಾ ವಾಚಿ಼ನ ಉಟಲಪರ ಹಿವಾ ಕರಲೆತಾ ನೈ, ಕರಿನ ದೆತಾಬಿ ನೈ ; ಸ್ವರ್ಗಲೊಕಮಾ ದೆವ ದುತೊ ನಿಂಗತ ರ‍್ಹವಸ. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />ತೆನೈಸೊ ಮರಲವಾಲಾ ಜಿವ್ತಾ ಥಾವಸ ಕವಾನಾ ಹುತಿ ಕೌ ಕದ್ಯಾಮ -ಮಿ ಅಬ್ರಹಾಮನೊ ಕ್ಹುದಾ ಇಸಾಕನೊ ಕ್ಹುದಾ ಯಾಕೊಬ್ನೊ ಕ್ಹುದಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ಆಗ ಲಾಗಲ ಕಾಟಾನಾ ಝಾಡಮಾತೊ ಬೊಲಲ ಮೊಶೆನಾ ಗ್ರಂಥಮಾ ಅದ್ಯಾಯಮಾ ರ‍್ಹಯಲ ಯಕ್ಕ ಸಂಗತಿ ಒದ್ಯಾನತ್ತಿ ಸು? <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />ತೆ ಜಿವ್ತಾ ರ‍್ಹಯಲ ವಾಲಾವೊನೆ ಕ್ಹುದಾ ಥಯೊಸ ವರಿ ಕ್ಹುದಾನೆ ನಂಬಿನ ಮರಲವಾಲಾವೊನೆ ಕ್ಹುದಾ ವ್ಹೈ ವರಿ ಕ್ಹುದಾನೆ ನಂಬ್ಯಾವಾಚಿ ಮರಲವಾವೊನೊ ಕ್ಹುದಾ ನ್ಹವೈ. ತುಮೆ ಧರಲಿದಲ ಪದ್ದತ ಘನ್ನು ತಪ್ಪ ಛೆ ಕದ್ಯೊ.<verse eid="MRK 12:27" /></para>
  <para style="s1">ಮ್ಹೊಟಿ ಆಗನ್ಯಾ</para>
  <para style="r">(<ref loc="MAT 22:34-40">ಮತ್ತಾಯ 22:34-40</ref>; <ref loc="LUK 10:25-28">ಲುಕ 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />ಶಾಸ್ತ್ರಿಯೊಮಾನೊ ಯಕ್ಲೊ ತಿವ್ನಿ ತಕ್ಕರಾರ ಐಕಿನ ಯೆಸು ಚೊ಼ಕು ಜವಾಬ ದಿದ್ಯೊ ಕೈನ ತಿಳ್ದಿನ ತಿಕನ ಐನ -ಕ್ಹಾರಿ ಆಗನ್ಯಾಮಾ ಪೈಲಾ ರ‍್ಹಯಲಮ್ಹೊಟಿ ಆಗನ್ಯಾ ಕೈ ವ್ಹೈ? ಕೈನ ತಿನೆ ಪುಚ಼ತಾಮಾ<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />ಯೆಸು ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊ ಐಕೊ ಹಮಾರೊ ಕರತಾ ಥಯಲ ಕ್ಹುದಾ ಯಕ್ಕಲೊಜ ಕರತಾ ವ್ಹೈ <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />ತಾರೊ ಕರತಾ ಥಯಲ ಕ್ಹುದಾನೆ ಪುರಾ ಮನಸೆ ಪುರಾ ಜ಼ಲಮಕ್ಹು ಪುರಾ ಗ್ಯಾನಕ್ಹು ಪುರಾ ತಾಕತಕ್ಹು ಮಯಾ ಕರು ಕವಾನಿ ಪೈಲಾ ಆಗನ್ಯಾ ; <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />ತಾರಾ ಆಜು಼ ಬಾಜು಼ವಾಲನೆ ತಾರಾನಿಂಗತಜ಼ ಮಯಾ ಕರು ಕೈನ ಕವಾನಿ ವಾತ ಬೆವಾ ಆಗನ್ಯಾ ವ್ಹೈ ;ಎ ಬೆತಿ ಮ್ಹೊಟಿ ಬಿಜಿ ಆಗನ್ಯಾ ಕೈಜ಼ ನತ್ತಿ. ಕದ್ಯೊ.<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />ತೆಳಾಮಾ ತೆ ಶಾಸ್ತ್ರಿ ಯೆಸುನೆ -ಭೊದಕ ಚೊ಼ಕು ಕದ್ಯೊ. ಯಕ್ಲೊ ಛೆ, ಕರತಾ ಥಯಲ ಕ್ಹುದಾ ಛೆ ತಿನೆ ಛೊಡಿನ ಬಿಜೊ಼, ಕ್ಹುದಾ ನತ್ತಿ. ತು ಕದಲ ಕ್ಹರಿಜ಼ ವ್ಹೈ <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />ತಿನೆ ಪುರಾ ಮನಸಕ್ಹು ಪುರಾ ಗ್ಯಾನಕ್ಹು ಪುರಾ ತಾಕತಕ್ಹು ಮಯಾಕರಾನು ವರಿ ತಿನಾಕ್ಹು ತಿನೆ ಮಯಾಕರಲಿವಾನು ತಿನಾ ಆಜು಼ ಬಾಜುನಾವೊನೆ ಮಯಾಕರಾನು ಎ ಭಂಬಿ ಕ್ಹಾರಾ ಹೊಮಾತಿಬಿ ಕ್ಹಾರಾ ಜಾನ್ವರೊನಿ ಬಲಿತಿಬಿ ತೆ ಹೆಚ್ಕಿ ವ್ಹೈ ಕದ್ಯೊ.<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />ತೆ ತಿನಿ ಗ್ಯಾನಕ್ಹು ಜವಾಬ ದಿದ್ಯೊ. ಯೆಸು ದೆಕಿನ - ತು ಕ್ಹುದಾನಾ ರಾಜ್ಯನೆ ದುರ ಥಯಲವಾಲೊ ನ್ಹವೈ ಕದ್ಯೊ. ತೆ ಥಯಲ್ಪರ ಯೆಸುನೆ ಪ್ರಶ್ನೆ ಕರಾನೆ ಕಿನೆಜ಼಼ ಧೈರಯ ನ್ಹೊತಿ.<verse eid="MRK 12:34" /></para>
  <para style="s1">ಮಸ್ಸಿಹಾ ಹುತಿ ಪ್ರಶ್ನೆ</para>
  <para style="r">(<ref loc="MAT 22:41-46">ಮತ್ತಾಯ 22:41-46</ref>; <ref loc="LUK 20:41-44">ಲುಕ 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />ಯೆಸು ದೆವಾಲಯಮಾ ಉಪದೆಶ ಕರತಾಮಾ ತೆ ಪ್ರಶ್ನೆಕರಿನ - ಶಾಸ್ತ್ರಿಯೊ ಆವಾನೊ ರ‍್ಹಯಲ ಕ್ರಿಸ್ತನೆ ದಾವಿದನಿ ಸಂತತಿ ವ್ಹೈ ಕೈನ ಕವಸ್ತೊ, ತೆ ಕಿಮ್ಮಥಾವಸ? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />ದಾವಿದ ಪವಿತ್ರ ಆತ್ಮಾಕ್ಹು ಭರಿನ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ</para>
  <para style="q1" vid="MRK 12:36">ಮಾರೊ ಕರ್ತಾ ಥಯಲ ಕರ್ತಾನೆ.</para>
  <para style="q2" vid="MRK 12:36">ಮಿ ತಾರಾ ವಿರೊಧಿಯೊನೆ</para>
  <para style="q1" vid="MRK 12:36">ತಾರಾ ಪಗಮಾ ಘಾಲೆಲಕ್ಕಾ</para>
  <para style="q2" vid="MRK 12:36">ಮಾರಾ ಕ್ಹಾತೆ ಮಾರಾ ಸಿದಾಹತ ಬಗಲ ಬೈಟ. ಕಿರ್ತನೆ<verse eid="MRK 12:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="MRK 12:37" />ದಾವಿದಜ಼ ತಿನೆ ಕರ್ತಾ ವ್ಹೈ ಕೈನ ಕದಲ್ಪರ ಮಸ್ಸಿಹಾ,</para>
  <para style="p" vid="MRK 12:37">ತಿನಿಜ಼ ಸಂತತಿ ಕಿಮ್ಮ ಥಾವಸ ಕೈನ ಪುಚ್ಯಾ.<verse eid="MRK 12:37" /></para>
  <para style="s1">ಯೆಸು ಶಾಸ್ತ್ರಿಯೊನಾ ಹುತಿ ಹುಶಾರ ರ‍್ಹೌ ಕದಲ</para>
  <para style="r">(<ref loc="LUK 20:45-47">ಲುಕ 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />ಮನಕ್ಹೊನು ಮ್ಹೊಟು ಗುಂಪ ಯೆಸುನಿಯೊ ವಾತೊ ಖುಶಿಕ್ಹು ಐಕಾಡ್ಯಾತಾ ತೆ ಉಪದೆಶ ಸುಕರ‍್ಯೊ ಕದ್ಯಾಮ -ಶಾಸ್ತ್ರಿಯೊನಾ ಹುತಿ ಹುಶಾರ ರಹೊ ತ್ಯುನೆ ಮ್ಹೊಟಾವಣ್ಣಾ ಘಾಲ್ಲಿನ ಫರಾನು ವಾನಿಯಾ, ರಸ್ತಾವೊಪರ ಮರಯಾದಿಕ್ಹು ನಮಸ್ಕಾರ ಕರೈಲ್ಯು ಕೈನ ಕೈಲೆತಾತಾ, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />ಸಭಾಮಂದಿರಮಾ ಖಾಸ ಜ಼ಗಾ ಖಾವಾನೆ ಪೈಲಾಸ್ಥಾನ ದಿವಾಮಾ ಇವ್ನು ಮನಸ ಘನ್ನುರ‍್ಹವಸ <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />ರಾOಡಿಯೊ ಹೆಣ ಮನಕ್ಹೊನಾ ಘರಮಾ ವ್ಹಕ್ಕಕಿನ ತಿವ್ನಿ ಆಸ್ತಿ ಕಾಳ್ಳೆತಾ ಘನಿಯೆಳ ಲಕ್ಕಾ ಪ್ರಾಥನಾ ಕರಾಲಾ ಥೈನ ಇವ್ನೆ ಮ್ಹೊಟಿ ಶಿಕ್ಷಾನೆ ಗುರಿ ಥಾವಸ ಕದ್ಯೊ.<verse eid="MRK 12:40" /></para>
  <para style="s1">ರಾOಡಿ ಬಾಕ್ಡಿನಿ ಕಾಣಕಿ</para>
  <para style="r">(<ref loc="LUK 21:1-4">ಲುಕ 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />ಯೆಸು ಐನ ಬೊಕ್ಕಕಸನಾ ಕ್ಹಾಮೊ ಬೈಟಿನ ಮನಕ್ಹೊ ಕಾಣಿಕೆನಿ ಪೆಟಗಿಮಾ ದೊಕ್ಡಾ ಘಾಲಾನು ದೆಕಾಡ್ಯೊತೊ ಘನ್ನಾ ಸೌಕಾರ ರ‍್ಹಯಲ ಮನಕ್ಹೊ <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />ಘನ್ನು-ಘನ್ನು ಘಾಲತಾಮಾ ಯಕ್ಲಿ ರಾOಡಿ ಹೆಣ ಮನಕ್ಹ ಐನ ಬೆ ತಾಂಬಾನಾ ಬಿಲ್ಲಾ ಘಾಲಿ. ತಿನಿ ಕಿಮ್ಮತ ಯಕ್ಕ ಅಣಾ ವ್ಹೈ.<verse eid="MRK 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43" />ತೆಳಾಮಾ ಯೆಸು ತಿನಾ ಶಿಷ್ಯಾವೊನೆ ನಜಿಕ ಬಲೈನ - ದೆಕೊ ತುಮೊನೆ ಕ್ಹರಿಜ಼ ಕೌಸ. ಕಾಣಿಕಿನಿ ಪೆಟ್ಕಿಮಾ ಘಾಲಲವಾಲಾವೊತಿಬಿ ಆ ರಾOಡಿ ಹೆಣ ಮನಕ್ಹ ಘಾಲಲ ಘನ್ನು ವ್ಹೈ. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />ಕಿಮ್ಮ ಕದ್ಯಾಮ ತ್ಯುನೊನೆ ಬಸ ಥೈನ ಉಗ್ರಲ ಘಾಲ್ಯಾಸ ;ಎ ಹೆಣ ಮನಕ್ಹ ತೆಕ್ಕಲಿ ಗರಿಬನಿ ಸ್ತಿತಿಮಾ ತಿಕನ ರ‍್ಹಯಲ ತೆಕ್ಕಲುಬಿ ಘಾಲಿಪಾಡಿಸ ಕದ್ಯೊ. ತೆ ಗರಿಬನಿ ರ‍್ಹೈತಬಿ ತಿಕನ್ನು ರ‍್ಹಯಲ ತೆಕ್ಲು ಘಾಲಿ.<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s1">ಯೆಸು ಯೆರುಸೆಲೆಮನಾ ದೆವಾಲಯನಾ ನಾಶನಾ ಹುತಿ ಕದಲ</para>
  <para style="r">(<ref loc="MAT 24:1-2">ಮತ್ತಾಯ 24:1-2</ref>; <ref loc="LUK 21:5-6">ಲುಕ 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />ಯೆಸು ದೆವಾಲಯ ಛೊಡಿನ ಜಾ಼ತಾಮಾ ತಿನಾ ಶಿಷ್ಯಾವೊಮಾನೊ ಯಕ್ಲೊ ತಿನೆ ಗುರು. ದೆಕ ಕೆವಾ ಮಂಗಾಳಾವೊಕ್ಹು ಭಾಂದಲ ಛೆ, ಕಿಮ್ಮ ಭಾಂದ್ಯಾಸ ಕದ್ಯೊ.<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />ಯೆಸು ಕದ್ಯೊ ಎ ಚೊ಼ಕಾ ಭಾಂದಲ ದೆಕಾಡ್ಯೊಸು? ನ್ಹ್ಯಾ ಮಂಗಾಳಾವೊಪರ ಮಂಗಾಳೊ ಉಗ್ರತೊ ನೈ; ಕ್ಹಾರು ಪಾಡಾಲಗಾಡಸ ಕದ್ಯೊ.<verse eid="MRK 13:2" /></para>
  <para style="s1">ಕಷ್ಟ ವರಿ ತ್ರಾಸ</para>
  <para style="r">(<ref loc="MAT 24:3-14">ಮತ್ತಾಯ 24:3-14</ref>; <ref loc="LUK 21:7-19">ಲುಕ 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />ಪಾಚ಼ಲ್ತೊ ಯೆಸು ಒಲಿವ. ಕವಾನಾ ತೆಲನಾ ಝಾಡನಾ ಡೊಂಗರಪರ ದೆವಾಲಯನಾ ಕ್ಹಾಮೊ ಬೈಟಲ ಟೈಮಾ ಪೆತ್ರಾ ಯಾಕೊಬ ಯೊಹಾನನಾ ಅಂದ್ರೆಯ ಗ್ವತ್ತವಾಚಿ ಆಯಾ. <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />ಇವ್ನೆ ಎ ಕೆಳಾಮಾ ಥಾವಸ ಕೆ? ಎ ಕ್ಹಾರು ಥಾವಾನು ವಳಕ ಸುವೈ? ಹಮೊನೆ ಕೆ ಕೈನ ಯೆಸುನೆ ಪುಚ಼ತಾಮಾ<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />ಯೆಸು ತ್ಯುನೊನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ - ಕುನ್ನಬಿ ತುಮೊನೆ ಮೊಸಕರಸ ಹುಶಾರಮಾ ರ‍್ಹವೊ. ದೆಕೊ <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />ಘನ್ನಾ ಜ಼ನಾ ಐನ ಮಾರಾ ನಾಮಪರ -ಮಿ ಕ್ರಿಸ್ತ ವ್ಹೈ ಮಿ ಕ್ರಿಸ್ತ ವ್ಹೈ ಕೈನ ಕೆಕ್ಲಾಕಿ ಜ಼ನಾವೊನೆ ಮೊಸಕರಸ. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />ಎನೈಸೊ ಯುದ್ದೊಥಾವಸ ಯುದ್ದೊನಿ ಅವಾಜ಼ ಐಕೊಸಿ ಯುದ್ದೊ ಥಾವಸ ಕೈನ ಸುದ್ದಿಯೊ ತುಮೆ ಐಕ್ತಾಮಾ ಭುಚ಼ಕೊ ನಕೊ. ತಿಮ್ಮಥಾವಾನು ಛೆ ಥೈಯುತಬಿ ತೆ ಲಾಸ್ಟನೊ ದಿನ್ನ ನ್ಹವೈ. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />ಮನಕ್ಹೊನಾ ವಿರುದ್ದ ಮನಕ್ಹೊ ರಾಜ್ಯನಾ ವಿರುದ್ದ ರಾಜ್ಯ ಉಟಸ ; ವರಿ ಭುಕಂಪೊ ತ್ಯಾ-ತ್ಯಾ ಥಾವಸ ;ಬರಗಾಲ ಆವಸ ಕಷ್ಟ ತ್ರಾಸ ಶುರುಥಾವಸ ಆ ಕ್ಹಾರು ಹೆಣ ಮನಕ್ಹ ಜ಼Oತಾರಮಾ ಕೆಕ್ಲೊ ತ್ರಾಸ ಥಾವಸ ತೆಕ್ಲು ತ್ರಾಸ ಥಾವಸ.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />ವರಿ ತುಮಾರಾ ಹುತಿ ತುಮೆ ದೆಕಿಲಿವೊ. ತುಮೊನೆ ಧರಿನ ತುಮೊನೆ ಸಭಾಮಂದಿರಮಾ ಯಳ್ದಿನ ಲಿನಜಾ಼ವಸ ತುಮೊನೆ ಮಾರಸ ಮಾರಾಹುತಿ ತುಮೊನೆ ಮ್ಹೊಟಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮಾ ರಾಜಾ಼ವೊನಾ ಕ್ಹಾಮಾ ಸಾಕ್ಷಿನಾಹುತಿ ಹುಬ್ರಾಡಸ ಇಮ್ಮ ತ್ಯುನೊನೆ ಸುವಾರ್ತೆ ಸಾಕ್ಷಿ ಥಾವಸ <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />ಪೈಲಾ ಕ್ಹಾರಿ ಜ಼ನಾಂಗನೆ ಸುವಾರ್ತೆ ಕದಲ ರ‍್ಹೌ ತೆಳಾಮಾ ಲಾಸ್ಟನೊ ದಿನ್ನ ಆವಸ <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />ತುಮೊನೆ ಫೈಸಲೊ ಕರಾನಿ ಜ಼ಗಾ ಧರಿಲಿನಗೈನ ದೆತಾಮಾ ಸು ಕೌ ಕೈನ ಅಗ್ದುರಜ಼ ತುಮೆ ಚಿಂತಾ ನಕೊ ಕರೊ ತೆ ಟೈಮಾ ತುಮೊನೆ ತಿಳಸಾವಾನಿಯೊ ವಾತೊಜ಼ ಬೊಲೊ ; ಬೊಲಾಲಾ ತುಮೆ ನ್ಹವೈ ತುಮೊನೆ ಪವಿತ್ರ ಆತ್ಮಾ ಬೊಲಾ ಲಗಾಡಸ.<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />ಎನೈಸೊ ಮ್ಹೊಟೊ ಭೈ ನ್ಹಾನಾ ಭೈನೆ. ಬಾಪ ದಿಕ್ರಾನೆ ಮರಾನೆ ವಪ್ಸಸ. ಬಚ್ಚಾ಼ ಜ಼ನ್ನಲ ವಾಲಾವೊಪರ ಫರಿನ ಪಡಸ ತ್ಯುನೊನೆ ಖಲಾಸ ಕರಾವಸ. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />ವರಿ ಮಾರಾ ನಾಮಪರ ತುಮೊನೆ ಕದ್ರಾವಸ. ತಿಮ್ಮ ಥಯಲ್ಪರಬಿ ಕುನ್ನ-ಕುನ್ನ ಲಾಸ್ಟಲಕ್ಕಕಾ ತಡ್ದಿಲಿವಾಲಾನೆ ರಕ್ಷಣೆ ಮಳಸ.<verse eid="MRK 13:13" /></para>
  <para style="s1">ಹಸೈ ಸಾಮನ</para>
  <para style="r">(<ref loc="MAT 24:15-28">ಮತ್ತಾಯ 24:15-28</ref>; <ref loc="LUK 21:20-24">ಲುಕ 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />ಎನೈಸೊ ಹಾಳ ಕರಾನು ಹಸೈ ಯಕ್ಕ ಕೆಟ್ಟ ಸಾಮನ ದೆವಾಲಯಮಾ ನೈಸೊ ಹುಬ್ರವಾನಿ ಜ಼ಗಾ ಹುಬ್ರಯಲ ತುಮೆ ದೆಕಾನಾ ಟೈಮಾ (ಎ ಒದಾಲೊ ತಿಳದಿಲಿವಾದೆ). ಯುದಾಯಮಾ ರ‍್ಹಯಲ ಡೊಂಗರಪರ ನ್ಹಾಟಿ ಜಾ಼ವಾದೆ. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />ಘರನಾ ಉಪ್ಪರ ರ‍್ಹಯಲ ವಾಲೊ ತಿನಾ ಘರಮಾ ಹೆಟೊ ಉತ್ರಿನ ಮ್ಹೈ ಜೌ಼ ನೈಸೊ ತಿನಾ ಘರಮಾ ಮ್ಹೈ ಗೈನ ಸುಜ಼ ಲಿಂಜೌ ನೈಸೊ, <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />ಖೆತರಮಾ ರ‍್ಹಯಲವಾಲೊ ಯಕ್ಲೊ ತಿನೆ ವಳ್ಳಿವಾನೆ ಜಾಡಿನಾ ಹುತಿ ಘರೆ ಜೌ಼ ನೈಸೊ, <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />ವರಿ ತೆ ದಿನೊಮಾ ಪೆಟೆರ‍್ಹಯಲವಾಲಿಯೊನೆ ಧೈಧಾವಾಲಾ ಬಚ್ಚಾ಼ವೊನೆ ಯಾವೊನೆ ತ್ಯುನೊನೆ ಥಾವಾನೊ ಕಷ್ಟ ಮಿ ಸು ಕೌ. <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />ತೆ ದಿನೊಮಾ ಸಂಕಟನಾ ದಿನೊ ರ‍್ಹಯಲ ಹುತಿ ಎ ಕ್ಹಾರು ಥಂಡನಾ ದಿನಮಾ ವರಿ ಪಾನಿನಾದಿನಮಾ ಥೌನೈ ಕೈನ ತುಮೆ ಪ್ರಾಥನಾ ಕರೊ ; <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />ತೆವು ಸಂಕಟ ಕ್ಹುದಾನಿ ಸೃಷ್ಟಿನಾ ದಿನೊತಿಬಿ ಹಜು಼ನಲಕ್ಕಕಾಬಿ ತೆವಾ ದಿನೊ ಆಯಾ ನತ್ತಿ. ಹವಾ ಕೆಟ ದಿನೊ ಕ್ಹುದಾ ಕರಲ ಸೃಷ್ಟಿತೊಬಿ ದಿನೊತಿಬಿ ಆಜ಼ಲಕ್ಕಾ ಥಯಾನತ್ತಿ ಅಗಾ ಥಾತಾ ನೈ<verse eid="MRK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 13:20" />ತೆನೈಸೊ ಕ್ಹುದಾ ತೆ ದಿನೊ ಕಮ ನೈ ಕರಲ ರ‍್ಹವತ್ತೊ ಕುನ್ನಜ಼ ಉಗರತು ನೈ ತೆ ಇನಿಲಿದಲವಾಲಾವೊನಾ ಹುತಿ ತೆ ದಿನೊ ಕಮ ಕರ‍್ಯೊಸ. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />ದೆಕೊ ಕುನ್ನಬಿ ತುಮೊನೆ - ಮಸ್ಸಿಹಾ ನ್ಯಾಛೆ ದೆಕೊ ಮಸ್ಸಿಹಾ ತ್ಯಾ ಛೆ ಕೈನ ಕದ್ಯಾಮ ನಂಬೊನಕೊ ; <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />ಸುಳ್ಳ ಮಸ್ಸಿಹಾ ವರಿ ಸುಳ್ಳ ಪ್ರವಾದಿಯೊ ಉಟಿನ. ಸಾದ್ಯಥಯೊಮ ಕ್ಹುದಾ ಇನಿಲಿದಲವಾಲಾವೊನೆ ಮೊಸಕರಾಹುತಿ ಘಾಬ್ರಾಥಾವಾನು ಕಾಮ ಅದ್ಭುತ ಕಾಮ ಕರಿನ ದೆಕಾಡಸ. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />ತುಮೆ ಹುಶಾರ ರ‍್ಹವೊ;ತುಮೊನೆ ಕ್ಹಾರುಜ಼ ಅಗು ಕೈಪಾಡ್ಯೊಸ.<verse eid="MRK 13:23" /></para>
  <para style="s1">ಮನಕ್ಹನೊ ದಿಕ್ರೊ ಆವಾನು</para>
  <para style="r">(<ref loc="MAT 24:29-31">ಮತ್ತಾಯ 24:29-31</ref>; <ref loc="LUK 21:25-28">ಲುಕ 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />ಎನೈಸೊ ಸಂಕಟನಾ ದಿನೊ ಥಯಲ್ಪರ</para>
  <para style="q1" vid="MRK 13:24">ಸುರ್ಯೊ ಕಾಳೊ ಥೈಝಾವಸ;</para>
  <para style="q2" vid="MRK 13:24">ಚ಼ಂದಪ್ಪಾ ಉಜಾಲು ದಿದ್ಯಾವಾಚಿ ರ‍್ಹಸ.<verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />ಚಿಕ್ಕಿಯೊ ಹಬಾಳಮಾತಿಯೊ ಪಡಸ;</para>
  <para style="q2" vid="MRK 13:25">ಹಬಾಳಮಾ ರ‍್ಹಯಲ ಶಕ್ತಿಯೊ ಹಲ್ಲಸ ;<verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />ತೆಳಾಮಾ ಮನಕ್ಹನೊ ದಿಕ್ರೊ ಘನ್ನಿ ತಾಕತಕ್ಹು ಘನ್ನಿ ಮಹಿಮಾಕ್ಹು ಹಬಾಳಮಾತೊ ಆವಾನು ದಿಕ್ಹಸ. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />ವರಿ ತೆ ತಿನಾ ದುತೊನೆ ಜಿಮಿನ್ಪರ ಕ್ಹಾರಿಬಗಲ ಮೊಕ್ಲಿನ ತೆ ಇನಿಲಿದಲ ವಾಲಾವೊನೆ ಮಳೈನಿ ವರಿ ಸ್ವರ್ಗಮಾ ರ‍್ಹಯಲ ವಾಲಾವೊನೆ ಮಳಾವಸ.<verse eid="MRK 13:27" /></para>
  <para style="s1">ಉಂಬ್ರೊನಾ ಝಾಡನೆ ದೆಕಿನ ಸಿಕ್ಕಲ</para>
  <para style="r">(<ref loc="MAT 24:32-35">ಮತ್ತಾಯ 24:32-35</ref>; <ref loc="LUK 21:29-33">ಲುಕ 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />ಉOಬ್ರೊನು ಝಾಡನಿ ದ್ರಷ್ಟಾಂತಕ್ಹು ಗ್ಯಾನ ಸಿಕ್ಕೊ ತಿನಿಯೊ ಠೊಂಗಿಯೊ ಹಜು಼ನ ಕುಳಿಯೊ ರ‍್ಹಯಲ ಹುತಿ ಪಾಲೊ ಛೊಡತಾಮಾ ತಡಕಾನೊ ದಿನ್ನ ನಜಿಕ ಆಯೊಸ ಕೈನ ತಿಳದಿಲಿವೊಸಿ ನೈ. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />ತಿಮ್ಮಜ಼ ಎ ಕ್ಹಾರು ಥಾವಾನು ತುಮೆ ದೆಕ್ತಾಮಾ ತೆ ಟೈಮ ನಜಿಕ ಛೆ, ಬಾಕಲಮಾಜ಼ ಛೆ ಕೈನ ತಿಳದೊ. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />ಶೆ ಮ್ಹೆಲ್ಲಿವೊ ಎ ಕಾಲನಾ ದಕ್ಹಾ ಮನಕ್ಹೊ ಎಕ್ಹಾರು ಕ್ಹರಿಮಾಜ಼ ಥಾಯೆಲಕ್ಕಾ ಮರತಾಜ಼ ನೈ. ತುಮೊನೆ ಕ್ಹರಿಮಾಜ಼ ಕೌಸ. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />ಜಿಮಿನ ಹಬಾಳ ನೈಸೊ ಥೈ ಜಾ಼ವಸ. ವರಿ ಮಾರಿಯೊ ವಾತೊ ಕೆಳಾಮಾಜ಼ ನುಚಾ಼ಯಿಜಾ಼ತಿಯೊ ನೈ.<verse eid="MRK 13:31" /></para>
  <para style="s1">ತೆ ದಿನ್ನ ತೆ ಟೈಮ ಕಿನೆಜ಼಼ ಗೊತ್ತನತ್ತಿ</para>
  <para style="r">(<ref loc="MAT 24:36-44">ಮತ್ತಾಯ 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />ತೆ ದಿನೊನಾ ಹುತಿ ವರಿ ತೆ ಟೈಮನಾ ಹುತಿ ಕೆಳಾಮಾ ಆವಸ ಕೈನ ಸ್ವರ್ಗಲೊಕಮಾ ರ‍್ಹಯಲ ದುತೊನೆಬಿ ಗೊತ್ತನತ್ತಿ ದಿಕ್ರಾನೆಬಿ ಗೊತ್ತನತ್ತಿ ಮಾರಾ ಬಾನೆ ಯಕ್ಕಜ಼ ಗ್ವತ್ತ ಛೆ. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />ಹುಶಾರ ರ‍್ಹವೊ ಕೈದಿನ ರ‍್ಹವೊ ತೆ ಕಾಲ ಕೆಳಾಮಾ ಆವಸ ತುಮೊನೆ ಗೊತ ನತ್ತಿ. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />ಎ ಕಿಮ್ಮ ವ್ಹೈ ಕದ್ಯಾಮ ಯಕ್ಲೊ ಮನಕ್ಹ ತಿನು ಘರ ಛೊಡಿನ ಬಿಜಾ಼ ದೆಶೆ ಜಾ಼ತಾಮಾ ಘರ್ನಿ ಜವಾಬ್ದಾರಿ ತಿನಾ ಆಳೊನಾ ಹತ್ಮಾ ದಿನ್ನ ಜಾ಼ತಾಮಾ ಯಕೆಕ್ಕಲಾನೆ ತಿನಾ ಕಾಮನಿ ಜವಾಬ್ದಾರಿ ನೆಮ್ಸಿನ ಬಾಕಲ ಕೈದಾಲಾನೆ ಬಲೈನ - ತು ಇವ್ನೊಪರ ತಾರಿ ನಜ಼ರ ರ‍್ಹವಾದೆ ಕೈನ ಮಿ ತುನೆ ಆಗನ್ಯೆ ದ್ಯುಸ.<verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />ಘರನೊ ಮಾಲಕ ಕ್ಹಾಂಜ಼ನಾ ಟೈಮಾ ಅರದಿ ರಾತ ನಾಟೈಮಾ ನೈತೊ ಪಾಟ ಥಾವಾತಿ ಅಗ್ದುರ ನೈತೊ ಸುರ್ಯೊ ಉಟಲಪರ ಪಾಟನಾ ಟೈಮಾ ಘರನೊ ಮಾಲಕ ಆವಾನು ತುಮೊನೆ ಗೊತನೈ ರ‍್ಹಯಲ ಹುತಿ ಹುಶಾರಮಾ ರ‍್ಹವೊ; <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />ತೆ ಯಕಾಕಿಜ಼ ಐನ ತುಮೆ ಕ್ಹುರೈ ಪಡ್ಯಾಸ ಕೈನ ದೆಕಾನೊ ವ್ಹೈ. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />ಮಿ ತುಮೊನೆ ಕದಲಜ಼ ಕ್ಹಾರಾವೊನೆ ಕೌಸ, ಹುಶಾರ ಥೈನ ರ‍್ಹವೊ.<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s1">ಯೆಸುನೆ ಖಲಾಸ ಕರಾನೆ ವಿಚಾರ ಕರಲ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ಮತ್ತಾಯ 26:1-5</ref>; <ref loc="LUK 22:1-2">ಲುಕ 22:1-2</ref>; <ref loc="JHN 11:45-53">ಯೊಹಾನ 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />ಪಸ್ಕಾನೊ ಸನ್ನ ವರಿ ಖಾಟು ನೈಸೊ ರೊಕ್ಲಾನೊ ಸನ್ನ ಆವಾನೊ ಹಜು಼ನ ಬೆ ದಿನ್ನ ರ‍್ಹತಾಮಾ ಖಾಸ ಯಾಜಕೊ ಶಾಸ್ತ್ರಿಯೊ ಯೆಸುನೆ ಉಪಾಯಕ್ಹು ಕಿನೆ ಗೊತ್ತವಾಚಿ ಧರಿನ ಖಲಾಸ ಕರಿಪಾಡಿಯೆ ಕೈನ ವಾಟ ದೆಕಾಡಾತಾ. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />ಕಾಕದ್ಯಾಮ - ಸನ್ನಮಾ ಧರುನೈ ಕೈನ, ಅಪ್ನಾ ಮನಕ್ಹೊಮಾ ಗದ್ದಲ ಥಾವಸ ಕೈನ ತ್ಯುನೆ ಬೊಲ್ಲಿದ್ಯಾ.<verse eid="MRK 14:2" /></para>
  <para style="s1">ಯೆಸುನೆ ಬೆಥಾನ್ಯಮಾ ಅಭಿಶೆಕ</para>
  <para style="r">(<ref loc="MAT 26:6-13">ಮತ್ತಾಯ 26:6-13</ref>; <ref loc="JHN 12:1-8">ಯೊಹಾನ 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />ತೆ ಬೆಥಾನ್ಯಮಾ ಯಕ್ಕ ಕಾಲಮಾ ಮ್ಹೊಟೊ ಕುಷ್ಟರೊಗಿ ಥಯಲ ಸಿಮೊನನಾ ಘರಮಾ ಯೆಸು ಖಾವಾನೆ ಬೈಟಲ ಟೈಮಮಾ ಯಕ್ಕ ಹೆಣ ಮನಕ್ಹ ಘನ್ನು ಮೊಗಾನು ಬಾಸನು ತೆಲನಿ ಭರಣಿ ಲೈನ ತೆ ಖುಲ್ಲಾ ಕರಿನ ಯೆಸುನಾ ಮಾತಾಪರ ರಿಚೈ.<verse eid="MRK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4" />ತ್ಯಾ ರ‍್ಹಯಲ ದಕ್ಹಾಜ಼಼ನಾ ಸಿಟ್ಟಥೈನ - ಆ ಮೊಗು ತೆಲ ಹಾಳ ಕಾ ಕರಿ ಕೈನ ಯಕ್ನಾ ಯಕ್ಕ ಬೊಲ್ಲಿದ್ಯಾ? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />ತೆ ತೆಲ ತನಕ್ಹೊ ರುಪ್ಪಾನಾ ಬಿಲ್ಲಾಮಾ ಇಕ್ಕಿನ ತೆ ದೊಕಡಾ ಗರಿಬೊನೆ ದಿವಾನೆಥಾತುತು ಕೈನ ತಿನೆ ಛಿ ಕದ್ಯಾ.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />ಯೆಸು ಗಪರ‍್ಹವೊ ಅನೆ ಛೊಡೊ ಅನೆ ಕಾ ತ್ರಾಸ ಕರಾಡಾಸ? ಆ ಮನೆ ಘನ್ನು ಚೊ಼ಕು ಕಾಮ ಕರಿಸ. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />ಗರಿಬೊ ಕೆಳಾಮಾಬಿ ತುಮೊಕನಜ಼ ರ‍್ಹವಸ ;ತುಮೊನೆ ಮನಸ ಆಯಲಟೈಮಾ ತ್ಯುನೊನೆ ಆಸ್ರೊ ಕರೊಶಿ ಮಿ ಹಮೆಶಾ ತಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹತೊನೈ. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />ಆ ಹೆಣ ಮನಕ್ಹ ತಿನಾ ಹತೆ ಥಯಲ ತೆಕ್ಲು ಕರಿಸ ಆ ಹೆಣ ಮನಕ್ಹ ಮಿ ಮರಾತಿ ಅಗ್ದುರಜ಼ ಮಾರಾ ಅOಗ ಪರ ತೆಲ ಘಾಲಿಸ. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />ತುಮೊನೆ ಕ್ಹರಿಜ಼ ಕೌಸ ಸುವಾರ್ತೆ ಕ್ಹಾರಿ ದುನಿಯಾಮಾ ಕಿಜ್ಗಾ಼-ಕಿಜ್ಗಾ಼ ಕವಸ ಆ ಹೆಣ ಮನಕ್ಹ ಕರಲ ಅನಿ ಶೆನಾ ಹುತಿ ತ್ಯಾ-ತ್ಯಾ ಕವಸ ಕದ್ಯೊ. <figure style="fig" alt="Jars with spikenard" file="hk00117c.tif" size="col" copy="Horace Knowles ©" ref="14:3">ಬಾಸನಾ ತೆಲನಿಯೊ ಭರಣಿಯೊ</figure><verse eid="MRK 14:9" /></para>
  <para style="s1">ಯೆಸುನೆ ಧರೈನ ದ್ಯುಸ ಕೈನ ಯುದ ವಪ್ಪಿಲಿದಲ</para>
  <para style="r">(<ref loc="MAT 26:14-16">ಮತ್ತಾಯ 26:14-16</ref>; <ref loc="LUK 22:3-6">ಲುಕ 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />ತೆ ಥಯಲ್ಪರ ಬಾರಾ ಶಿಷ್ಯಾವೊಮಾನೊ ಯಕ್ಲೊ ಇಸ್ಕರಿಯುತ ಯುದ ಯೆಸುನೆ ಖಾಸ ಯಾಜಕೊಕನ ಧರೈನ ದ್ಯುಸ ಕೈನ ತ್ಯುನೊಕನ ಗಯೊ. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />ತ್ಯುನೆ ತೆ ವಾತ ಐಕಿನ ಖುಶಿ ಥೈನ - ತುನೆ ದೊಕಡಾ ದಿಯೆಸ ಕೈನ ವಾತ ದಿದ್ಯಾ. ಇಸ್ಕರಿಯುತ ಯುದ ಯೆಸುನೆ ಧರೈನ ದಿವಾನೊ ಚೊ಼ಕೊ ಟೈಮ ದೆಕಾಡ್ಯೊತೊ.<verse eid="MRK 14:11" /></para>
  <para style="s1">ಯೆಸು ತಿನಾ ಶಿಷ್ಯಾವೊನಾ ಕ್ಹಾತೆ ಫಸ್ಕಾಮಾ ಅನ್ನ ಖಾದಲ</para>
  <para style="r">(<ref loc="MAT 26:17-25">ಮತ್ತಾಯ 26:17-25</ref>; <ref loc="LUK 22:7-14">ಲುಕ 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">ಯೊಹಾನ 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />ಖಾಟೊ ನೈಸೊ ರೊಕ್ಲಾನೊ ಪಸ್ಟಲ್ಯಾ ದಿನಮಾ ಪಸ್ಕ ಸನ್ನಾ ದಿನಮಾ ಬಕ್ರಾನಾ ಬಚ್ಚಾ಼ನೆ ಕಾಟಾನಾ ದಿನಮಾ,ತಿನಾ ಶಿಷ್ಯಾ- ಯೆಸುಕನ ಐನ ತುನೆ ಪಸ್ಕ ಸನ್ನನು ಖಾವಾನೆ ಹಮೆ ಕಿಜಾ಼ ಗೈನ ತಯ್ಯಾರ ಕರಿಯೆ ಕೈನ ತಿನೆ ಪುಚ಼ತಾಮಾ<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />ಯೆಸು ತಿನಾ ಶಿಷ್ಯಾವೊಮಾನಾ ಬೆ ಜ಼ನಾವೊನೆ ಬಲೈನ ತ್ಯುನೊನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ - ತುಮೆ ಗಾಮ್ಮಾ ಜಾವೊ ತ್ಯಾ ಯಕ್ಲೊ ಮನಕ್ಹ ಭರಲಪಾನಿನೊ ಘಡೊಲಿನ ತುಮಾರಾ ಕ್ಹಾಮೊ ಆವಸ ;ತುಮೆ ತಿನಾ ಪಾಚಾ಼ ಜಾ಼ವೊ. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />ತೆ ಕಯಾ ಘರೆ ಜಾ಼ವಸ ತೆ ಘರನಾ ಮಾಲಕನೆ - ಹಮಾರೊ ಭೊದಕ ತಿನಾ ಶಿಷ್ಯಾವೊನಾ ಕ್ಹಾತೆ ಪಸ್ಕಾ ಸನ್ನನು ಅನ್ನ ಖಾವಾನಾ ಹುತಿ ಅನ್ನ ಘಾಲಾನಿ ಜ಼ಗಾ ಕಿಜ್ಗಾ಼ ಶೆ ಕೈನ ಪುಚಾ಼ಡ್ಯೊಸ ಕವೊ. <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />ತೆ ಚಾ಼ಯೆಥಯಲ ಸಾಮನ ತಯ್ಯಾರ ಕರಿನ ಮ್ಹೊಟು ರ‍್ಹಯಲ ಮ್ಹಾಡಿಪರ ರ‍್ಹಯಲ ಖೊಲಿ ತುಮೊನೆ ದೆಕಾಡಸ ; ತ್ಯಾ ಆಪೊನೆ ತಯ್ಯಾರ ಕರೊ ಕೈನ ತ್ಯುನೊನೆ ವಳೈಪಾಡ್ಯೊ.<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />ತಿನಾ ಶಿಷ್ಯಾ ತ್ಯಾಂತಾ ಗಾಮ್ಮಾ ಗೈನ ಯೆಸು ಕದಲತಿಮ್ಮ ತಯ್ಯಾರ ರ‍್ಹಯಲ ದೆಕಿನ ತ್ಯುನೆ ಪಸ್ಕ ಅನ್ನ ತಯ್ಯಾರ ಕರ‍್ಯಾ.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />ಕ್ಹಾಂಜ ಥಾತಾಮಾ ಯೆಸು ತಿನಾ ಬಾರಾ ಶಿಷ್ಯಾವೊನಾ ಕ್ಹಾತೆ ಆಯೊ <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />ತ್ಯುನೆ ಬೈಟಿನ ಖಾತಾಮಾ ಯೆಸು - ತುಮೊಮಾನೊ ಯಕ್ಲೊ ಮನೆ ಧರೈನ ದಿವಸ, ತೆ ಮಾರಾ ಕ್ಹಾತೆ ಖಾವಾಲೊಜ಼ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಕ್ಹರಿಮಾಜ಼ ಕೌಸ ಕದ್ಯೊ.<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />ತೆಳಾಮಾ ತಿನಾ ಶಿಷ್ಯಾ ದುಖಿಥೈನ - ತೆಳಾಮಾ ತ್ಯುನೆ ಮಿ ನ್ಹವೈತೊ? ಮಿ ನ್ಹವೈತೊ? ಕೈನ ತಿನೆ ಕೈಲಿವಾಡ್ಯಾತಾ.<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />ಯೆಸು ತ್ಯುನೊನೆ - ತೆ ಮಾರಾ ಬಾರಾಜ಼ನಾವೊಮಾನೊ ಯಕ್ಲೊ ವ್ಹೈ ಮಾರಾ ಕ್ಹಾತೆ ತಿನೊ ರೊಕ್ಲೊ ಡುಬೈನ ಖಾವಾಲೊ ವ್ಹೈ, <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />ಮನಕ್ಹನೊ ದಿಕ್ರೊ ಗೈ ಪಡಸ ಕ್ಹರಿ ; ತಿನಾ ಹುತಿ ಪವಿತ್ರ ಗ್ರOಥಮಾ ಬರ್ದಲ ಛೆ ವರಿ ತೆ ಮರುಜ಼. ತೆ ವರಿ ಕಯೊಬಿ ಮನಕ್ಹನಾ ದಿಕ್ರಾನೆ ಧರೈನ ದಿವಾಲಾನಿ ಗತಿ ಮಿ ಸು ಕೌ. ತೆ ಮನಕ್ಹ ನೈ ಹುಟ್ಟತ್ತೊ ತಿನೆ ಕೆಕ್ಲುಕಿ ಚೊ಼ಕು ಥಾತುತು ಕೈನ ಕದ್ಯೊ.<verse eid="MRK 14:21" /></para>
  <para style="s1">ಕರ್ತಾನು ಭೊಜನ</para>
  <para style="r">(<ref loc="MAT 26:26-30">ಮತ್ತಾಯ 26:26-30</ref>; <ref loc="LUK 22:14-20">ಲುಕ 22:14-20</ref>; <ref loc="1CO 11:23-25">1 ಕೊರಿಂಥ 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />ತ್ಯುನೆ ಖಾವಾನೆ ಬೈಟತಾಮಾ ಯೆಸು ರೊಕ್ಲಾನೊ ತುಕಡೊ ಲಿನ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಕೈನ ಶಿಷ್ಯಾವೊನೆ ಭಾಗಿನ ದಿನ್ನ ಆ ಮಾರು ಅಂಗ ವ್ಹೈ ಕದ್ಯೊ.<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />ತೆಳಾಮಾ ಯಕ್ಕ ತಾಂಬಿಯೊ ಲಿನ ಸ್ತೊತ್ರಾ ಕರಿನ ಶಿಷ್ಯಾವೊನೆ ದಿದ್ಯೊ ತ್ಯುನೆ ತೆಕ್ಲಾ ಜ಼ನಾ ತಿಮಾ ಪಿದ್ಯಾ.<verse eid="MRK 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24" />ವರಿ ಯೆಸು ಶಿಷ್ಯಾವೊನೆ -ಆ ಮಾರು ರಗ್ತ ವ್ಹೈ, ಕ್ಹುದಾ ತಿನಾ ಮನಕ್ಹೊನೆ ಕ್ಹಾತೆ ವಾತದಿದಲ ರಗತ ವ್ಹೈ ಆ ಘನ್ನಾ ಜ಼ನಾವೊನಾ ಹುತಿ ಚುವಾಯಲ ರಗ್ತ ವ್ಹೈ, <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />ಮಿ ತುಮೊನೆ ಕ್ಹರಿಜ಼ ಕೌಸ ಕ್ಹುದಾನಿ ರಾಜ್ಯಮಾ ನೌ ದ್ರಾಕ್ಷಿಯೊನು ವೈನ(ರಖ) ಪಿಯೆಲಕ್ಕಾ ಆ ದ್ರಾಕ್ಷಿಯೊನು ವೈನ (ರಕ್ಹ) ಪಿತೊಜ಼ ನೈ ಕದ್ಯೊ.<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />ಪಾಚಾ಼ತಾ ತ್ಯುನೆ ಸ್ತೊತ್ರ ಕತಾ ಗಿದ್ದೊ ಕತಾ ತೆಲನಾ ಝಾಡನಾ ಡೊಂಗರಪರ ಗಯಾ.<verse eid="MRK 14:26" /></para>
  <para style="s1">ಪೆತ್ರಾ ಯೆಸುನೆ ಕುನ್ನ ವ್ಹೈ ಕೈನ ಗ್ವತ್ತ ನತ್ತಿ ಕೈನ ಕವಸ ಕೈನ ಯೆಸು ಕದಲ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ಮತ್ತಾಯ 26:31-35</ref>; <ref loc="LUK 22:31-34">ಲುಕ 22:31-34</ref>; <ref loc="JHN 13:36-38">ಯೊಹಾನ 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />ತೆಳಮಾ ಯೆಸು ತ್ಯುನೊನೆ - ತುಮೆ ಕ್ಹಾರಾ ಮನೆ ಛೊಡಿನ ನ್ಹಾಟಿ ಜಾವೊಸಿ. ಕಾಕದ್ಯಾಮ</para>
  <para style="q1" vid="MRK 14:27">ಕುರುಬುರ‍್ಯಾನೆ ಕ್ಹುದಾ ಖಲಾಸ ಕರಸ,</para>
  <para style="q2" vid="MRK 14:27">ಬಕ್ರಾ ಜವೈಜಾ಼ವಸ ಕೈನ ಪವಿತ್ರ ಗ್ರOಥಮಾ ಬರ್ದಲ ಛೆ ತೊ.<verse eid="MRK 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />ಇಮ್ಮ ಥಯೊತಬಿ ಮಿ ಜುತೊ ಥೈನ ಉಟಿನ ಆಯಲಪರ ತುಮಾರಾತಿ ಅಗ್ದುರ ಗಲಿಲಾಯನೆ ಜೌ಼ಸ ಕದ್ಯೊ.<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />ಪೆತ್ರಾ ಯೆಸುನೆ - ಕ್ಹಾರಾ ತುನೆ ಛೊಡಿನ ಗಯಾತಬಿ ಮಿ ತುನೆ ಛೊಡಿನ ಜಾ಼ತೊನೈ.<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />ಯೆಸು. ಪೆತ್ರಾನೆ "ತುನೆ ಕ್ಹರಿಜ಼ ಕೌಸ, ಆಜ಼ನಾ ರಾತೆಜ಼ ಕುಕಡೊ ಬೆ ಸಲಾ ಬಾಂಗದಿವಾತಿ(ಅಡ್ಡಾತಿ) ಅಗ್ದುರಜ಼ ತು ಮಾರಾ ಹುತಿ ಮನೆ ಗೊತನತ್ತಿ ಕೈನ ತನ ಸಲಾ ಕಸಿ "ಕದ್ಯೊ.<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />ತೆ ವಾತೆ ಪೆತ್ರಾ ಥಯುತಬಿ ತಾರಾ ಕ್ಹಾತೆ ಮರ‍್ಯೊತಬಿ ಕೆಳಾಮಾಜ಼ ತು ಮನೆ ಗ್ವತ್ತ ನತ್ತಿ ಕೈನ ಕತೊಜ಼ ನೈ ಕದ್ಯೊ. ತಿನಾ ನಿಂಗತಜ಼ ಉಗ್ರಲ ಶಿಷ್ಯಾಬಿ ಕದ್ಯಾ.<verse eid="MRK 14:31" /></para>
  <para style="s1">ಗೆತ್ಸೆಮನೆ ಕವಾನಾ ಮಳಾಮಾ ಯೆಸುನಿ ಪ್ರಾಥನಾ</para>
  <para style="r">(<ref loc="MAT 26:36-46">ಮತ್ತಾಯ 26:36-46</ref>; <ref loc="LUK 22:39-46">ಲುಕ 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />ತೆ ಥಯಲ್ಪರ ತ್ಯುನೆ ಗೆತ್ಸೆಮನೆ ಕವಾನಾ ಮಳಾಮಾ ಆಯಾ. ಯೆಸು ತಿನಾ ಶಿಷ್ಯಾವೊನೆ ನ್ಹ್ಯಾ ಬೈಟೊ ಮಿ ಪ್ರಾಥನಾ ಕರಿನ <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />ಔಸ ಕೈನ ಪೆತ್ರಾ ಯಾಕೊಬ ಯೊಹಾನನೆ ತಿನಾ ಕ್ಹಾತೆ ಬಲೈ ಲಿಂಗೈನ ಮನಸೆ ಬೆಜ್ಜಾರ ಕರಲಿನ. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />ತೆ ತ್ಯುನೊನೆ ಕದ್ಯೊ ಮಾರಾ ಮನಸ್ಮಾ ಘನ್ನು ದುಖ ಛೆ ತೆ ಮನೆ ಮಾರು ಮನಸ ಫುಟಿ ಜಾ಼ವಾ ನಿಂಗತ ಥಯುಸ ತುಮೆ ನ್ಹ್ಯಾಜ಼ ರ‍್ಹೈನ ಹುಶಾರ ರ‍್ಹವೊ<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />ತೆ ದಕ್ಹೊ ದುರ ಗೈನ ಜಿಮಿನ್ಪರ ಪಡಿನ ಪ್ರಾಥನಾ ಕರತೊ ಸಾದ್ಯ ಥಯೊಮ ಮಿ ಮರಾನಿ ಸ್ತಿತಿಮಾತೊ ವರಿ ಆ ಕಷ್ಟನಾ ಟೈಮಮಾತೊ ಮನೆ ಛೊಡಾ ಕದ್ಯೊ. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />ತೆ ಪ್ರಾಥನಾ ಕರತೊ ಬಾ ಮಾರಾ ಬಾ. ತುನೆ ಕ್ಹಾರು ಸಾದ್ಯ ಛೆ. ಆ ತ್ರಾಸ್ನೊ ತಾಂಬಿಯೊ ಮಕ್ಹು ದುರ ಕರ ವರಿ ಮಾರಿ ಚಿ಼ತ್ತನಿಂಗತ ಥೌ ನೈಸೊ ತಾರಿ ಚಿ಼ತ್ತನಿಂಗತ ಥಾವಾದೆ ಕದ್ಯೊ.<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />ಯೆಸು ವರಿ ಐನ ತಿನಾ ತನ್ನೆ ಶಿಷ್ಯಾ ಕ್ಹುರಯಲ ದೆಕಿನ ಪೆತ್ರಾನೆ ಕದ್ಯೊ ಸಿಮೊನನ ತುಮೆ, ಕ್ಹುರೈ ಪಡ್ಯಾಸು? ಯಕ್ಕ ತಾಸ ತುಮೆ ಜಾ಼ಗಾ ರ‍್ಹತಾ ನೈ ಸು? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />ಯೆಸು ತ್ಯುನೊನೆ ಕದ್ಯೊ. ಶೊಧನೆಮಾ ಪಡೆನೈಸೊ ಹುಶಾರ ರ‍್ಹೈನ ಪ್ರಾಥನಾ ಕರೊ; ಆತ್ಮಾ ತಯ್ಯಾರ ಛೆ ಕ್ಹರಿ ವರಿ ;ಅOಗಮಾ ತಾಕತ ನತ್ತಿ ಕದ್ಯೊ.<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />ತೆ ಥಯಲ್ಪರ ವರಿ ಯೆಸು ದುರ ಗೈನ ಫರಿನ ತೆಜ಼ ವಾತೊ ಕತೊ ಪ್ರಾಥನಾ ಕರ‍್ಯೊ. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />ಯೆಸು ಫರಿನ ಆತಾಮಾ ಶಿಷ್ಯಾ ವರಿ ಕ್ಹುರಯಲ ದೆಕ್ಯೊ ; ತ್ಯುನಾ ಡೊಳಾ ಖೊಲಾನೆ ಥಾವಾಡ್ಯು ನ್ಹೊತು ವರಿ ತ್ಯುನೆ ಯೆಸುನೆ ಸು ಕೌ ಕೈನ ತಿಳದ್ಯುನೈ.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />ತೆ ತನವಾ ಸಲಾ ಗೈನ ಆತಾಮಾ ತ್ಯುನೊನೆ ಯೆಸು ಕದ್ಯೊ - ತುಮೆ ಹಜು಼ನ ಅರಾಮ ಕ್ಹುರಯಾಸ ಸು ; ಬಸ; ತೆ ಟೈಮ ಆಯೊ ದೆಕೊ ಪಾಪಿಯೊನಾ ಅದಿಕಾರಮಾ ಮನಕ್ಹನಾ ದಿಕ್ರಾನೆ ಧರೈದಿವಸ. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />ಉಟೊ ಅಪೆ ಗಯ್ಯೆ; ಮನೆ ಧರೈನ ದಿವಾಲೊ ನಜಿ಼ಕಾಯೊಸ ದೆಕೊ ಕದ್ಯೊ.<verse eid="MRK 14:42" /></para>
  <para style="s1">ಯೆಸುನೆ ಧರಲ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ಮತ್ತಾಯ 26:47-56</ref>; <ref loc="LUK 22:47-53">ಲುಕ 22:47-53</ref>; <ref loc="JHN 18:3-12">ಯೊಹಾನ 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />ತೆ ಹಜು಼ನ ತೆ ಬೊಲ್ತೊರ‍್ಹತಾಮಾಜ಼ ಬಾರಾ ಜ಼ನಾ ಶಿಷ್ಯಾವೊಮಾನೊ ಯಕ್ಲೊ ಯುದ ಆಯೊ ತಿನಾ ಕ್ಹಾತೆ ಮನಕ್ಹೊನು ಗುಂಪ ತ್ಯುನಾ ಹತೊಮಾ ಚಾ಼ಕಾ ಛ್ಯುರಿಯೊ ಧರ್ಲಿನ ಆಯಾ. ಖಾಸ ಯಾಜಕೊ ಶಾಸ್ತ್ರಿಯೊ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ತಿವನೊನೆ ವಳಾಯಾತಾ.<verse eid="MRK 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44" />ಎನೈಸೊ ತಿನೆ ಧರೈನ ದಿವಾಲೊ ತ್ಯುನೊನೆ ಮಿ ಕಿನೆ ಮಯಾಕರಿನ ಮಟ್ಟಿಲ್ಯುಸ ತೆಜ಼ ಯೆಸು ವ್ಹೈ ತಿನೆಜ಼ ತುಮೆ ಧರ್ಲಿನ ಭಾಂದಿನ ಹುಶಾರಕ್ಹು ಕೈದಾತಾ ಬಲೈನ ಲಿನಜಾ಼ವೊ ಇಮ್ಮ ಪೈಲಾಜ಼ ಕದ್ಯೊತೊ. <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />ತ್ಯಾ ಆಯಲ ಬರೊಬ್ಬರ ತೆ ಯೆಸುಕನ ಯುದ ಐನ ಗುರು ಕೈನ ಮಟ್ಟಿಲಿದ್ಯೊ. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />ತ್ಯುನೆ ಐನ ಯೆಸುನೆ ಘಟ್ಟ ಭಾಂದಿನ ಧರಲಿದ್ಯಾ. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />ವರಿ ಯೆಸುಕನ ನಜಿ಼ಕಮಾ ಹುಬ್ರಯಲವಾಲಾವೊಮಾನೊ ಯಕ್ಲೊ ತಿನು ತಲ್ವಾರ ಕಾಡಿನ ಖಾಸ ಯಾಜಕನಾ ಆಳನೊ ಕಾನ ಕತ್ರಿಪಾಡ್ಯೊ.<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />ತ್ಯುನೆ ಯೆಸುನೆ ಧರ್ತಾಮಾ ಯೆಸು ತ್ಯುನೊನೆ ಮಿ ಸು ಚ್ವಟ್ಟೊ ವ್ಹೈ ತುಮೆ ಚಾ಼ಕಾ ಛ್ಯುರಿಯೊ ಲಾಯಾಸು? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />ಮಿ ದಿನ್ನೆಬಿ ದೆವಾಲಯಮಾ ತುಮಾರಾ ಕ್ಹಾಮೊ ಭೊದನೆ ಕರತಾಮಾ ಮನೆ ತುಮೆ ಧರಯಾನೈ. ವರಿ ಗ್ರಂಥನಾ ವಚನೊಮಾ ರ‍್ಹಯಲ ಪುರಾ ಥಾವಾಹುತಿ ಎ ಕ್ಹಾರು ಥಯುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />ತೆಳಾಮಾ ತಿನಾ ಕ್ಹಾರಾಶಿಷ್ಯಾ ತಿನೆ ಛೊಡಿನ ನ್ಹಾಟಿಗಯಾ.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />ತ್ಯಾ ಯಕ್ಲೊ ಜಾಂಜಿಮಾನ ಅಂಗಪರ ಶಾಲ ಘಾಲ್ಲಿನ ಯೆಸುನಾ ಪಾಚೊ಼ ಆವಾಡ್ಯೊತೊ ತ್ಯುನೆ ತಿನೆ ದೆಕಿನ ಧರಾನೆ ಆತಾಮಾ. <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />ತೆ ವಣ್ಣಾ ಛೊಡಿನ ತೆ ಉಗಾಡೊ ನ್ಹಾಟಿಗಯೊ.<verse eid="MRK 14:52" /></para>
  <para style="s1">ಯಹುದ್ಯೊನಾ ಕ್ಹಾಮೊ ಯೆಸು</para>
  <para style="r">(<ref loc="MAT 26:57-68">ಮತ್ತಾಯ 26:57-68</ref>; <ref loc="LUK 22:54-55">ಲುಕ 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">ಯೊಹಾನ 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />ತೆಕ್ಲಾಮಾಜ಼಼ ತ್ಯುನೆ ಯೆಸುನೆ ಲಿನ ಮಾಹಾಯಾಜಕನಾ ಘರೆ ಗಯಾ. ತಿಕನ ತೆ ಘರಮಾ ಖಾಸ ಯಾಜಕೊ ಶಾಸ್ತ್ರಿಯೊ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ಇವ್ನೆ ಕ್ಹಾರಾ ಮಳ್ಯಾ. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />ವರಿ ಪೆತ್ರಾ ದುರತೊ ತಿವ್ನಾ ಪಾಚೊ಼-ಪಾಚೊ಼ ಗೈನ ಖಾಸ ಯಾಜಕನಾ ಘರನಾ ಅಂಗಳಾಮಾ ಆಯಾ ಸಿಪಾಯಿಯೊನಾ ಕ್ಹಾತೆ ಆಗಕನ ಬೈಟಿನ ಅಂಗ ಶೆಕಿಲಿವಾಡ್ಯೊತೊ.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />ತೆಳಾಮಾ ಖಾಸ ಯಾಜಕೊ ಸಭೆಮಾ ಮ್ಹೊಟಾ ರ‍್ಹಯಲ ವಾಲಾ ಯೆಸುನೆ ಖಲಾಸ ಕರುಕೈನ ಸಾಕ್ಷಿ ಹುಡಕ್ಯಾ. ವರಿ ತ್ಯುನೊನೆ ಕಯುಜ಼ ತಪ್ಪ ಕ್ಹಾಪಡ್ಯೊ ನೈ. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />ಘನ್ನಾ ಜ಼ನಾ ಐನ ಯೆಸುಪರ ಸುಳ್ಳಸಾಕ್ಕಷಿ ಕದ್ಯಾ. ತೆ ಸುಳ್ಳ ಸಾಕ್ಕಷಿಯೊ ಕ್ಹರಿ ಥಯ್ಯೊನೈ.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />ತೆಳಮಾ ತಿಪರ ದಕ್ಹಾ ಜ಼ನಾ ಸುಳ್ಳ ಸಾಕ್ಕಷಿಯೊ ಕವಾನೆ ಹುಬ್ರಯಾ. <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />ಎ ಕದ್ಯೊ. ಮನಕ್ಹೊ ಹತೆ ಭಾಂದಲ ದೆವಾಲಯ ಮಿ ಪಾಡಿನ ವರಿ ತನ ದಿನ್ನ ಥಯಲ್ಪರ ಮನಕ್ಹೊ ನೈ ಭಾಂದಲ ಮಿ ಭಾಂದುಸ ಎ ಕದ್ಯೊತೊ ಹಮೆ ಐಕ್ಯಾಸ ತ್ಯುನೆ ತಿಪರ ಸುಳ್ಳ ಸಾಕ್ಷಿ ಕವಾಡಾತಾ. <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />ತಿಮ್ಮ ಕದ್ಯಾತಬಿ ತ್ಯುನಿ ಸಾಕ್ಷಿ ಹೊಂದಾಣಕಿ ಥೈ ನೈ.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />ತೆಳಾಮಾ ಖಾಸ ಯಾಜಕ ವಚ಼ಮಾ ಉಟಿನ ಹುಬ್ರೈನ - ತು ಸುಜ಼ ಜವಾಬ ದೆತೊನೈ ಸು? ಇವ್ನೆ ತುಪರ ತಪ್ಪ ಚ಼ಡಾವಾನು ಸುವೈ? ಯೆಸುನೆ ಪ್ರಶ್ನೆ ಪುಚ಼ತಾಮಾ. <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />ವರಿ ತೆ ಗಪರ‍್ಹೈನ ಸುಜ಼ ಕದ್ಯೊ ನೈ.</para>
  <para style="p" vid="MRK 14:61">ಫರಿನ ಖಾಸ ಯಾಜಕ - ಮಸ್ಸಿಹಾ ತುಜ಼಼ ವ್ಹೈಸು? ಸ್ತೊತ್ರಾನೆ ಯೊಗ್ಯ ಥಯಲವಾಲನೊ ದಿಕ್ರೊ ತುಜ಼಼ ವ್ಹೆಸು?<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />ಕೈನ ತಿನೆ ಪುಚ಼ತಾಮಾ ಯೆಸು ಹೊ ಮಿಜ಼ ವ್ಹೈ, ಎನೈಸೊ ಮನಕ್ಹನೊ ದಿಕ್ರೊ ಸರವಶಕ್ಕತನಾ ಬಾಜು಼ಮಾ ಬೈಟಾನೊ. ವರಿ ಕ್ಹುದಾ ರ‍್ಹಯಲ ಸ್ವರ್ಗಮಾತೊ ಉಜಾಲಾನಾ ಕ್ಹಾತೆ ತೆ ಆವಾನು ತುಮೆ ದೆಕೊಸಿ ಕದ್ಯೊ.<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />ಎ ಐಕಿನ ಖಾಸ ಯಾಜಕ ತಿನಾ ವಣ್ಣಾ ಫಾಡಿಲಿನ ಹಮ್ನಾ ಹಮೊನೆ ಇತ್ತಿ ಉಪ್ಪರ ಸಾಕ್ಷಿ ನಕೊ. <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />ಎ ಕ್ಹುದಾನಾ ವಿರುದ್ದ ಕದಲ ವಾತ ತುಮೆ ಕ್ಹಾರಾ ಐಕ್ಯಾಸು ನೈ ತುಮಾರಿ ವಿಚಾರ ಸುವೈ ತ್ಯುನೆ ತಿನೆ ವಿರುದ್ದ ಥೈನ ಎ ತಪ್ಪ ಕರಲವಾಲೊ ವ್ಹೈ -</para>
  <para style="p" vid="MRK 14:64">ಇನೆ ಮರಾನಿ ಶಿಕ್ಷಾ ದಿಯ್ಯೆ ಕದ್ಯಾ. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />ತೆ ಥಯಲ್ಪರ ದಕ್ಹಾ ಜ಼ನಾ ಸಿಪಾಯಿಯೊ ತಿಪರ ಥುಕ್ಕಿನ ತಿನು ಮ್ಹೊಡು ಪ್ಹಡಕಾಕ್ಹು ಝಾಕಿನ ತಿನೆ ಮಾರ‍್ಯಾ ಹಮ್ನಾ ತುನೆ ಕುನ್ನ ಮಾರ‍್ಯೊ ಕೆ ಕವಾಡಾತಾ. ವರಿ ತಿನೆ ಕೈದಾಲಾ ತಿನಾ ಗಾಲೊಪರ ಮಾರತಾ ತಿವ್ನಾ ಹತೊಟಿಮಾ ಲಿದ್ಯಾ.<verse eid="MRK 14:65" /></para>
  <para style="s1">ಪೆತ್ರಾ ಯೆಸುನೆ ಇನ್ಕಾರ ಕರಲ</para>
  <para style="r">(<ref loc="MAT 26:69-75">ಮತ್ತಾಯ 26:69-75</ref>; <ref loc="LUK 22:56-62">ಲುಕ 22:56-62</ref>; <ref loc="JHN 18:15-18">ಯೊಹಾನ 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />ಪೆತ್ರಾ ತ್ಯಾ ಅಂಗಳಾಮಾ ರ‍್ಹತಾಮಾ ಖಾಸ ಯಾಜಕನಿ ದಾಸಿಮಾನಿ ಯಕ್ಕಲಿ ಐ. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />ತೆ ಪೆತ್ರಾ ಆಗಕ್ಹು ಅಂಗ ಶೆಕಿಲಿವಾನು ದೆಕಿನ</para>
  <para style="p" vid="MRK 14:67">"ತುಬಿ ನಜ಼ರೆತನಾ ಯೆಸುನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ವಾಲೊ ವ್ಹೈ "ಕದಿ.<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />ತೆ ಮಿ ನ್ಹವೈ ತು ಸು ಕವಾಡಿಸ ಮನೆ ಗೊತ್ತ ನತ್ತಿ ಕೈನ ತೆ ಯೆಸುನೆ ಇನ್ಕಾರ ಕರಿನ ಅಂಗಳಾ ಮಾತೊ ಭಾರೊ ಐಪಾಡ್ಯೊ. ತೆಳಾಮಾ ಕುಕಡೊ ಬಾಂಗದಿದ್ಯೊ.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />ತ್ಯಾ ತೆ ದಾಸಿ ತಿನೆ ದೆಕಿನ ತ್ಯಾ ರ‍್ಹಯಲ ವಾಲಾವೊನೆ ತ್ಯುನೊಮಾನೊ ಎಬಿ ಯಕ್ಲೊ ವ್ಹೈ ಕತಾಮಾ. <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />ವರಿ ಪೆತ್ರಾ ಫರಿನ ಇನ್ಕಾರ ಕರ‍್ಯೊ ಮಿ ನ್ಹವೈ ಕದ್ಯೊ.</para>
  <para style="p" vid="MRK 14:70">ದಕ್ಹಿಯಳಪರ ತ್ಯಾ ಹುಬ್ರಯಲವಾಲಾ ಪೆತ್ರಾನೆ ಕ್ಹರಿಮಾಜ಼ ತು ತ್ಯುನೊಮಾನೊ ಯಕ್ಲೊ ವ್ಹೈ; ತು ಗಲಿಲಾಯವಾಲೊ ವ್ಹೈ ಕೈನ ವರಿ ಫರಿನ ಕದ್ಯಾ.<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />ವರಿ ಪೆತ್ರಾ-ತುಮೆ ಕವಾನು ಮನಕ್ಹ ಮನೆ ಗೊತ್ತ ನತ್ತಿ ಕೈನ ತಿನಾಕ್ಹು ತೆ ಕ್ಹರಾಪಿಲೆತೊ ಕ್ಹುದಾನಾ ಕ್ಹಮ ಘಾಲಾನು ಶುರುಕರ‍್ಯೊ. ತೆಕ್ಲಾಮಾಜ಼಼ ಕುಕಡೊ ಬಾಂಗ ದಿದ್ಯೊ.<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />ತೆಳಾಮಾ ಬೆ ಸಲಾ ಕುಕಡೊ ಬಾOಗ ದಿದ್ಯೊತೊ ಪೆತ್ರಾ ಐಕ್ಯೊ ಯೆಸು ತಿನೆ ಕದಲ ವಾತ ತೆ ಶೆ ಕರಿನ ಕುಕಡೊ ಬೆ ಸಲಾ ಬಾಂಗದಿವಾತಿ ಅಗ್ದುರ ತನ ಸಲಾ ಮಾರಾ ಹುತಿ ತು ಮನೆ ಗೊತ್ತ ನತ್ತಿ ಕೈನ ಕಸಿಕದಲ ತೆ ವಿಚಾರಮಾ ಉಂದಾ ಗುಡ್ಗಾ ಘಾಲ್ಲಿನ ರ‍್ವಯ್ಯೊ.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s1">ಯೆಸುನೆ ಪಿಲಾತನಾ ಕ್ಹಾಮಾ ಲಾಯಲ</para>
  <para style="r">(<ref loc="MAT 27:1-2">ಮತ್ತಾಯ 27:1-2</ref>; <ref loc="MAT 11:14">11:14</ref>; <ref loc="LUK 23:1-5">ಲುಕ 23:1-5</ref>; <ref loc="JHN 18:28-38">ಯೊಹಾನ 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />ಪಾಟ ಥಯಲ ಬರೊಬ್ಬರ ಖಾಸ ಯಾಜಕೊ ಗಡಬಡಮಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ಶಾಸ್ತ್ರಿಯೊ ಮ್ಹೊಟಾ ಸಭೆವಾಲಾ ಯಕ್ನಾ ಯಕ್ಕ ಮಳಿನ ತ್ಯುನೆ ವಿಚಾರ ಕರಿಲಿದಲ ತಿಮ್ಮ ಪ್ರಕಾರ ಕರ‍್ಯಾ. ತ್ಯುನೆ ಯೆಸುನೆ ಬೆಡಿಯೊಕ್ಹು ಭಾಂದಿನ ಧರ್ಲಿನ ಗೈನ ಪಿಲಾತನಕನ ದಿದ್ಯಾ.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />ಪಿಲಾತನ ತಿನೆ ತು ಯಹುದ್ಯೊನೊ ರಾಜೊ಼ ವ್ಹೈ ಕೈನ ಪುಚ಼ತಾಮಾ ಯೆಸು</para>
  <para style="p" vid="MRK 15:2">ತುಜ಼಼ ಕದ್ಯೊತೊ ಕೈನ ಜ಼ವಾಬ ದಿದ್ಯೊ.<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />ಖಾಸ ಯಾಜಕೊ ತಿಪರ ಘನ್ನಾ ಸುಳ್ಳ ತಪ್ಪ ಚ಼ಡಾವಾಡ್ಯಾತಾ. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />ತಿನಾಹುತಿ ಪಿಲಾತನ ವರಿಯಕಸಲಾ ತು ಸುಜ಼ ಜವಾಬ ದೆತೊ ನೈಸು? ಇವ್ನೆ ತುಪರ ಕೆಕ್ಲಾ ಅಪವಾದ ಘಾಲಾಡ್ಯಾಸ ದೆಕ ಕವಾಡೊತೊ. ತೆಕ್ಲು ಥಯು ತಬಿ<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />ಯೆಸು ಸುಜ಼ ಜವಾಬ ದಿದ್ಯೊನೈ ತೆ ದೆಕಿನ ಪಿಲಾತನ ಘನ್ನೊ ಘಾಬ್ರೊಥಯೊ.<verse eid="MRK 15:5" /></para>
  <para style="s1">ಯೆಸುನೆ ಮರಾನಿ ಶಿಕ್ಷಾದಿದಲ</para>
  <para style="r">(<ref loc="MAT 27:15-26">ಮತ್ತಾಯ 27:15-26</ref>; <ref loc="LUK 23:13-25">ಲುಕ 23:13-25</ref>; <ref loc="JHN 18:39">ಯೊಹಾನ 18:39</ref>; <ref loc="JHN 19:16">19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />ಹರಿ ಯಕ್ಕ ಫಸ್ಕಾನಾ ಸನ್ಮಾ ರಾಜ್ಯಪಾಲ ಥಯಲ ಪಿಲಾತನ ಮನಕ್ಹೊ ಮಾಂಗಲ ತೆ ಕೈದಿನೆ ಛೊಡಾನಿ ಪದ್ದತ ವ್ಹತ್ತಿ. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />ತೆಳಾಮಾ ಬರಬ್ಬ ಕವಾಲೊ ಯಕ್ಕ ಕೈದಿ ವ್ಹತ್ತೊ ತೆ ಲಡೈಕರಾಲಾವೊನಾ ಕ್ಹಾತೆ ಮಳಿನ ಮನಕ್ಹೊನೆ ಖಲಾಸ ಕರ‍್ಯೊತೊ ತಿನೆ ಧರಿನ ಜೆಲಮಾ ಘಾಲ್ಯಾತಾ. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />ಮನಕ್ಹೊ ಪಿಲಾತನಕನ ಗೈನ ತು ಹಮಾರಾಹುತಿ ಕರತೊ ಆಯಲ ಪದ್ದತ ಕರ ಕೈನ ಪುಚ್ಯಾ.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />ಪಿಲಾತನ ತ್ಯುನೊನೆ ಪುಚ್ಯೊ ಮಿ ಯಹುದ್ಯನಾ ರಾಜಾ಼ನೆ ತಮಾರಾಹುತಿ ಛೊಡುಕೈನ ತುಮಾರಿ ಆಸ ಛೆ ಸು. <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />ಖಾಸ ಯಾಜಕೊಮಾ ಸOಗಟ ಹೆಚ್ಕಿ ಥಯಲ ಹುತಿ ಯೆಸುನೆ ಧರಿನ ದಿದ್ಯಾತಾ ಕೈನ ಪಿಲಾತನೆ ಗೊತ್ತ ವ್ಹತ್ತು. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />ತಿತಾ ಖಾಸ ಯಾಜಕೊ - ಬರಬ್ಬನೆ ಛೊಡಕೈನ ಮನಕ್ಹೊನೆ ಪಿಲಾತನಕನ ಮಾಂಗಿಲಿವೊಕೈನ ಶಿಕ್ಕಲಾವಾಡ್ಯಾತಾ.<verse eid="MRK 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12" />ತಿನಾಹುತಿ ಪಿಲಾತನ ಫರಿನ ತ್ಯುನೊನೆ - ತಿಮ್ಮ ರ‍್ಹಯುಮ ತುಮೆ ಕವಾನಾ ಯೆಹುದಿನಾ ರಾಜಾ಼ನೆ ಮಿ ಸು ಕರುಕೈನ ಪುಚ಼ತಾಮಾ ತ್ಯುನೆ<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />ತಿನೆ ಶಿಲುವಿಪರ ಚ಼ಡಾಕೈನ ವದ್ರ್ಯಾ.<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />ವರಿ ಆ ಸು ಕೆಟ್ಟ ಕರ‍್ಯೊಸ ಪಿಲಾತನ ಕದ್ಯೊ</para>
  <para style="p" vid="MRK 15:14">ವರಿ ತ್ಯುನೆ ಅನೆ ಶಿಲುವಿಪರ ಚ಼ಡಾ ಕೈನ ವರಿ ಜೊ಼ರವದರ‍್ಯಾ.<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />ತೆಳಾಮಾ ಪಿಲಾತನ ಮನಕ್ಹೊನು ಮನಸ ಸಮಾದಾನ ಕರಾಹುತಿ ಬರಬ್ಬನೆ ಛೊಡಿನ ಯೆಸುನೆ ಬಾರಕೊಲಕ್ಹು ಮಾರಖಲೈನ ಶಿಲುವಿಪರ ಚ಼ಡಾವಾನಾ ಹುತಿ ವಪ್ಸಿನ ದಿದ್ಯೊ.<verse eid="MRK 15:15" /></para>
  <para style="s1">ಯೆಸುನೆ ಸೈನಿಕೊ ಕದ್ರಾಯಲ</para>
  <para style="r">(<ref loc="MAT 27:27-31">ಮತ್ತಾಯ 27:27-31</ref>; <ref loc="JHN 19:2-3">ಯೊಹಾನ 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />ಸೈನಿಕೊ ಯೆಸುನೆ ಪಿಲಾತನ ರಾಜಾ಼ನಾ ಘರ್ಮಾತಾ ಅಂಗಳಾಮಾ ಲೈನ ತ್ಯುನಾ ಬಿಜಾ಼ ಸೈನಿಕೊನೆ ಮಳೈನ <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />ಯೆಸುನೆ ಘನ್ನಾ ಲಾಲ ರಾಜಾ಼ನಾ ವಣ್ಣಾ ಘಾಲಿನ ಕಾಟಾವೊನು ಕಿರಿಟ ಕರಿನ ತಿನಾ ಮಾತಾ ಪರ ಮುಕ್ಕಯಾ. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />ಯೆಹುದಿನಾ ರಾಜಾ಼ ತು ಘನ್ನಾ ದಿನ್ನ ಜುತೊ ರ‍್ಹೆ ಕೈನ ನಮಸ್ಕಾರ ಕರಿನ ಪಗೆ ಪಡ್ಯಾ. <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />ವರಿ ಲಾಕಡಿ ತಿನಾ ಮಾತಾಪರ ಮಾರಿನ ತಿಪರ ಥುಕ್ಕಕಿನ ತಿನಾ ಕ್ಹಾಮಾ ಉಂದಾಗುಡಗಾಘಾಲ್ಲಿನ ಡಬ್ಬ ಪಡ್ಯಾ. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />ಇಮ್ಮ ತಿನೆ ಕದ್ರಾಯಲ್ಪರ ತಿಪರಲ್ಯಾ ಘನ್ನಾ ಲಾಲ ರಾಜಾ಼ನಾ ವಣ್ಣಾ ಕಾಡಿನ ತಿನಾ ವಣ್ಣಾತಿನೆ ಘಾಲಿನ ತಿನೆ ಶಿಲುವಿಪರ ಚ಼ಡಾವಾನೆ ಲಿನಗಯಾ.<verse eid="MRK 15:20" /></para>
  <para style="s1">ಯೆಸುನೆ ಶಿಲುವಿಪರ ಚ಼ಡಾಯಲ</para>
  <para style="r">(<ref loc="MAT 27:32-44">ಮತ್ತಾಯ 27:32-44</ref>; <ref loc="LUK 23:26-43">ಲುಕ 23:26-43</ref>; <ref loc="JHN 19:17-27">ಯೊಹಾನ 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />ತೆಳಾಮಾ ಖೆತರನಿ ವಾಟಮಾತಾ ಜಾ಼ತಾಮಾ ತೆಜ಼ ವಾಟಮಾತೊ ಯಕ್ಕ ದಾಣಗೊ ಆವಾಡ್ಯೊತೊ ಯೆಸುನಿ ಶಿಲುವಿ ಉಚೈಲೆ ಕೈನ ತಿನೆ ಜ಼ಬರದಸ್ತಿ ಕರ‍್ಯಾ ತೆ ಕುನ್ನ ವ್ಹೈ ಕದ್ಯಾಮ ಅಲೆಕ್ಸಾಂಡರ ವರಿ ರುಫಸನೊ ಬಾ ಥಯಲ ಸಿಮೊನ ಕವಾಲೊ ಕುರೆನ ಗಾಮವಾಲೊ ವ್ಹೈ. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />ಪಾಚಾ಼ತಾ ತ್ಯುನೆ ಗೊಲ್ಗೊತಾ ಕವಾನಾ ಜ಼ಗಾಪರ ತಿನೆ ಲಿನ ಆಯಾ. ಗೊಲ್ಗೊಥಾ ಕದ್ಯಾಮ ಕಪಾಲ ಕವಾನಿ ಜ಼ಗಾ ವ್ಹೈ. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />ತ್ಯಾ ತಿನೆ ರಗ್ತಬೊಳ ಮಳಾಯಲ ದ್ರಾಕ್ಷಿನೊ ವೈನ(ರಖ) ದಿದ್ಯಾ. ವರಿ ತೆ ಲಿದ್ಯೊ ನೈ. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />ಪಾಚಾ಼ತಾ ಯೆಸುನೆ ತ್ಯುನೆ ಶಿಲುವಿಪರ ಚ಼ಡೈನ ತಿನಾ ವಣ್ಣಾವೊನೆ ಕಿನೆ-ಕಿನೆ ಸು-ಸು ಆವಸ ಕೈನ ತ್ಯುನೆ ಚಿ಼ಟಿಯೊ ಘಾಲಿನ ವಾಟಿಲಿದ್ಯಾ.<verse eid="MRK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25" />ಯೆಸುನೆ ಶಿಲುವಿಪರ ಘಾಲ್ತಾಮಾ ಪಾಟ್ನಾ ನೌ ವಾಜಾ಼ತಾ. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />ತಿಪರ ಚ಼ಡಾಯಲ ತಪ್ಪ ಸು ವ್ಹೈ ಕದ್ಯಾಮ-ಎ ಯಹುದ್ಯನೊ ರಾಜೊ಼ ವ್ಹೈ ಕೈನ ಮಾತಾನಿ ಜ಼ಗಾ ಶಿಲುವಿಪರ ಬರ್ದಿನ ಲಗಾಡ್ಯಾತಾ.<verse eid="MRK 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 15:27" />ಇನಾ ಕ್ಹಾತೆ ಬೆ ಜ಼ನಾ ಚೊ಼ಟ್ಟಾವೊನೆ ಲೈನ ಯಕ್ಲಾನೆ ಸಿದಾ ಬಗಲ ಯಕ್ಲಾನೆ ಡಾವಾ ಬಗಲ ತಿನಾ ಕ್ಹಾತೆ ಶಿಲುವಿಪರ ಘಾಲ್ಯಾತಾ. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />ದಕ್ಹಾ ಮುಲ ಪ್ರತಿಮಾ ಎ ವಚನಾ ಛೆ ಪವಿತ್ರ ಗ್ರಂಥ ಕವಸ <note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">ದಕ್ಹಾ ಮುಲ ಪ್ರತಿಮಾ ಎ ವಚನಾ ಛೆ ಪವಿತ್ರ ಗ್ರಂಥ ಕವಸ ತೆ ಚ್ವಟ್ಟಾವೊನು ದುಖ ವಾಟಿಲಿದ್ಯೊ</char></note> <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />ತ್ಯಾಂತಾ ಜಾ಼ವಾಲಾ ಮಾತು ಹಲೈನ ಯೆಸುನೆ ದೆಕಿನ ಆಹಾ ತು ದೆವಾಲಯ ಪಾಡಿನ ತನ ದಿನಮಾ ಭಾಂದಾಲಾ, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />ಶಿಲುವಿಪರತೊ ಉತ್ರಿನ ತಾರೊ ಜ಼ಲಮ ತು ವಚಾ಼ಡಿಲೆ ಕೈನ ತಿನೆ ಹಿನಾವಾಡ್ಯಾತಾ. <verse eid="MRK 15:30" /><verse number="31" style="v" sid="MRK 15:31" />ತೆಜ಼ ಟೈಮಮಾ ಖಾಸ ಯಾಜಕೊ ಶಾಸ್ತ್ರಿಯೊ ತೆ ಬಿಜಾ಼ವೊನೆ ವಚಾ಼ಡಾಲೊ ವ್ಹೈ; ತಿನೆ ತೆ ವಚಾ಼ಡಿ ಲೆತೊನೈ. <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />ಇಸ್ರಾಯೆಲನೊ ರಾಜೊ಼ ಥಯಲ ಎ ಮಸ್ಸಿಹಾ ಹಮ್ನಾ ಶಿಲುವಿಪರತೊ ಉತ್ರಿನ ಆವಾದೆ. ಉತ್ರಿನ ಆಯೊಮ ಹಮೆ ಬಿ ದೆಕಿನ ಬರೊಕ್ಹೊ ಕರಿಯೆಸ ಕೈನ ತ್ಯುನೊಮಾಜ಼ ಕದ್ರೈನ ತ್ಯುನೆ ಬೊಲ್ಲಿವಾಡ್ಯಾತಾ. ತಿನಾ ಕ್ಹಾತೆ ಶಿಲುವಿಪರ ರ‍್ಹಯಲವಾಲಾ ತಿನೆ ಕದ್ರಾವಾಡ್ಯಾತಾ.<verse eid="MRK 15:32" /></para>
  <para style="s1">ಯೆಸು ಮರಲ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ಮತ್ತಾಯ 27:45-56</ref>; <ref loc="LUK 23:44-49">ಲುಕ 23:44-49</ref>; <ref loc="JHN 19:28-30">ಯೊಹಾನ 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />ದುಪಾರನಾ ಬಾರಾ ವಾಸ್ತಾ ದೆಶಪರ ಅಂದಾರು ಥೈ ಗಯು ತೆ ಅOದಾರು ತನ ತಾಸ ವ್ಹತ್ತು. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />ದುಪಾರೆ ತನ ವಾಸ್ತಾ ಯೆಸು ಎಲೊಹಿ-ಎಲೊಹಿ ಲಮಾ ಸಬಕ್ತಾನಿ, ತಿಮ್ಮ ಕದ್ಯಾಮ ಕ್ಹುದಾ ಮಾರಾ ಕ್ಹುದಾ ಕಾ ಮಾರೊ ಹತ ಛೊಡ್ಯೊ ಕೈನ ಜೊ಼ರ ವದರ‍್ಯೊ.<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />ನಜಿಕ ಹಬ್ರಯಲ ದಕ್ಹಾ ಜ಼ನಾವೊಮಾನಾ ತೆ ಐಕಿನ ಹಮ್ನಾ ತೆ ಎಲಿಯಾನೆ ಬೊಲಾಡೊಸ ಕದ್ಯಾ.<verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />ತೆಳಾಮಾ ಯಕ್ಲೊ ನ್ಹಾಟಿ ಗೈನ ಸ್ಪಂಜಮಾ ಘನ್ನು ಸಸ್ತು ರ‍್ಹಯಲ ವೈನ ಭರಿನ ಲಾಕ್ಕಡಿನೆ ಭಾಂದಿನ ಯೆಸುನಾ ಹೊಟೊನೆ ಲಗಾಡ್ಯೊ. ಛೊಡೊ ಇನೆ ಶಿಲುವಿ ಪರತೊ ಉತಾರಾನೆ ಎಲಿಯಾ ಆಸ ಸು ದೆಕಿಯೆ ಕದ್ಯೊ.<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />ವರಿ ಯೆಸು ಜೊ಼ರ ವದ್ರಿನ ಜ಼ಲಮ ಛೊಡ್ಯೊ.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />ತೆಳಾಮಾ ದೆವಾಲಯಮಾ ರಹೆಲ ಪಡದೊ ಉಪ್ಪರತೊ ಹೆಟೊಲಕ್ಕಾ ಬೆ ತುಕ್ಡಾ ಥಯೊ. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />ತೆ ಇಮ್ಮ ಜ಼ಲಮ ಛೊಡಲ ದೆಕಿನ ತ್ಯಾ ಹುಬ್ರಯಲಮಾನಾ ಶತಾದಿಪತಿ ದೆಕಿನ ಕ್ಹರಿಮಾಜ಼ ಆ ಮನಕ್ಹ ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ವ್ಹೈ ಕದ್ಯೊ.<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />ತ್ಯಾ ದಕ್ಹಿಯೊ ಹೆಣ ಮನಕ್ಹೊಬಿ ದುರತಿಯೊ ದೆಕಾಡಿಯೊತ್ಯೊ ತಿಮಾನಿಯೊ, ತೆ ಮಗ್ದಲನಿ ಮರಿಯಳ, ನ್ಹಾನಾ ಯಾಕೊಬ ವರಿ ಯೊಸೆಫನಿ ಯಾ ಮರಿಯಳ ವರಿ ಸಲೊಮಿ ತ್ಯಾ ವ್ಹತ್ತಿಯೊ. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />ಇವ್ನೆ ಯೆಸು ಗಲಿಲಾಯಮಾ ರ‍್ಹತಾಮಾ ಯೆಸುನಾ ಪಾಚಿ಼ಯೊ ಐನ ತಿನೆ ಮದತ ಕರಿಯೊತ್ಯೊ ವರಿ ತಿನಾ ಪಾಚಿ಼ಯೊ ಆವಾಲಿಯೊ ಘನ್ನಿಯೊ ಜನಿಯೊ ಹೆಣ ಮನಕ್ಹೊ ಯೆರುಸಲೆಮೆ ಐಯೊತ್ಯೊ.<verse eid="MRK 15:41" /></para>
  <para style="s1">ಯೆಸುನಿ ಮಜಾ಼ರ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ಮತ್ತಾಯ 27:57-61</ref>; <ref loc="LUK 23:50-56">ಲುಕ 23:50-56</ref>; <ref loc="JHN 19:38-42">ಯೊಹಾನ 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v" sid="MRK 15:42-43" />ತೆಳಾಮಾಜ಼ ಕ್ಹಾಂಜ಼ ಥೈ ಗೈತಿ ತೆಳಾಮಾ ಅರಿಮಥಾಯ ಯೊಸೆಫ ಕವಾಲೊ ತ್ಯಾ ಆಯೊ ತೆ ಯಹುದ್ಯೊನೊ ಸಭಾಪರ ಮ್ಹೊಟೊ ವ್ಹತ್ತೊ ವರಿ ಕ್ಹುದಾನಿ ರಾಜ್ಯ ಆವಾನು ತೆ ಕೈದಾಡ್ಯೊತೊ ತೆಳಾಮ ಸಬ್ಬತನೊ ಪಾಚ಼ಲ್ಯೊ ದಿನ್ನ (ವರಿ ಸನ್ನ ತಯ್ಯಾರ ಕರಾನೊ ದಿನ್ನ ವ್ಹತ್ತೊ) ಪಿಲಾತನ ರಾಜ್ಯಪಾಲಕನ ಧೈರ್ಯಕ್ಹು ಐನ ಯೆಸುನು ಮರಲ ಅಂಗ ದೆ ಕೈನ ಮಾಂಗ್ಯೊ. <verse eid="MRK 15:42-43" /><verse number="44" style="v" sid="MRK 15:44" />ಪಿಲಾತನ ರಾಜ್ಯಪಾಲ ಯೆಸು ತೆಕ್ಕಲೊ ಭೆಗಿನ ಮರ‍್ಯೊಸು ಕೈನ ಘಾಬ್ರೊಥೈನ ಶತಾದಿಪತಿನೆ ಬಲೈನ ಯೆಸು ಭೆಗಿನ ಮರ‍್ಯೊಸು ಕೈನ ತಿನೆ ಪುಚ಼್ಚಿನ <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />ಯೆಸು ಮರಲ ಶತಾದಿಪತಿಕ್ಹು ತಿಳ್ದಿನ ಮರಲ ಅಂಗ ಯೊಸೆಫನೆ ದಿಲಾಯೊ. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />ಯೊಸೆಫ ಘನ್ನು ಮೊಗು ಪ್ಹಡಕು ಇಕ್ಕಾತೊ ಲಾಯಲ ತಿನೆ ವಾಟಮಾ ಉತಾರಿನ ತಿಮಾ ತಿನೆ ಸುತ್ತಿನ ದಗ್ಡಾಮಾ ಕಾಡಲ ಮಜಾ಼ರಮಾ ಮುಕ್ಕಕಿನ ಮಜಾ಼ರನು ಬಾಕಲ ಮ್ಹೊಟೊ ದಗ್ಡೊ ಉಳ್ಸಿನ ಝಾಕ್ಕಯೊ. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />ಮಗ್ದಲನಿ ಮರಿಯಳ ಯೊಸೆಫನಿ ಯಾ ಯೆಸುನಿ ಯಾ ಮರಿಯಳ ಎ ಕ್ಹಾರು ದೆಕಾಡಿಯೊತ್ಯೊ ತಿಕ್ಹು ಯೆಸುನಿ ಮಜಾ಼ರನಿ ಜ಼ಗಾ ತ್ಯುನೊನೆ ಗೊತ್ತ ಥೈತು.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s1">ಯೆಸು ಮರಿನ ಜುತೊ ಥಯಲ</para>
  <para style="r">(<ref loc="MAT 28:1-8">ಮತ್ತಾಯ 28:1-8</ref>; <ref loc="LUK 24:1-12">ಲುಕ 24:1-12</ref>; <ref loc="JHN 20:1-10">ಯೊಹಾನ 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />ಸಬ್ಬತ ದಿನ್ನ ಥಯಲ್ಪರ, ಮಗ್ದಲನಿ ಮರಿಯಳ. ಯಾಕೊಬನಿ ಯಾ ಮರಿಯಳ ವರಿ ಸಲೊಮಿ ಯೆಸುನಾ ಅಂಗೆ ಲಗಾಡಾನಾ ಹುತಿ ಬಾಸನು ತೆಲ ಇಕ್ಕಾತಿಯೊ ಲಯ್ಯೊ. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />ಐತ್ವಾರ ದಿನ್ನ ನಸ್ಕೆ ಸುರ‍್ಯೊ ಉಟ್ತಾಮಾ ತ್ಯುನೆ ಮಜಾ಼ರಕನ ಚಾ಼ಲಿಯೊತ್ಯೊ. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />ವಾಟಮಾ ಜಾ಼ತಾಮಾ ಮಜಾ಼ರನೆ ಝಾಕಲ ದಗ್ಡೊ ಮ್ಹೊಟೊರ‍್ಹಯಲ ಹುತಿ ತ್ಯುನೆ ದಗ್ಡೊ ಅಪ್ನಾಹುತಿ ಕುನ್ನ ಸರಕಾಸ? ಕೈನ ತ್ಯುನೊಮಾ ಬೊಲ್ಲಿವಾಡಿಯೊತ್ಯೊ.<verse eid="MRK 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ತ್ಯುನೆ ಮಾತು ಉಚೈನ ದೆಕಿನ ತೆ ದಗ್ಡೊ ಸರಕಾಯಲ ದೆಕಿನ. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />ತ್ಯುನೆ ಮಜಾ಼ರಮಾ ಗೈನ ದೆಕ್ತಾಮಾ ತ್ಯಾ ಯಕ್ಲೊ ಜಾಂಜಿಮಾನ ದಾಣಗೊ ಧೊಳಾ ವಣ್ಣಾ ಘಾಲ್ಲಿನ ಶಿದಾ ಬಗಲ ಬೈಟಲ ದೆಕಿನ ತ್ಯುನೆ ಘಾಬ್ರಿಯೊ ಥಯ್ಯೊ.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />ತೆ ತ್ಯುನೊನೆ ತುಮೆ ಘಾಬ್ರಿಯೊ ಥಾವೊ ನಕೊ ಶಿಲುವಿಪರ ಚ಼ಡಾಯಲ ನಜ಼ರೆತನಾ ಯೆಸುನೆ ಹುಡಕಾಡಿಯೊಸ ಮನೆ ಗೊತ ಛೆ ತೆ ಜಿವ್ತೊ ಥೈನ ಉಟ್ಯೊಸ; ತೆ ನ್ಹ್ಯಾ ನತ್ತಿ ತಿನೆ ಮುಕ್ಕಕಲ ಜ಼ಗಾ ಎಜ಼ ವ್ಹೈ ದೆಕೊ. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />ತುಮೆ ಗೈನ ಎ ಸುದ್ದಿ ತಿನಾ ಶಿಷ್ಯಾವೊಕನ ವರಿ ಪೆತ್ರಾನೆ ತೆ ತುಮೊನೆ ಕದಲತಿಮ್ಮ ತುಮಾರಾತಿ ಅಗೊ ಗಲಿಲಾಯನೆ ಜಾ಼ವಸ. ತ್ಯಾ ತುಮೆ ತಿನೆ ದೆಕೊಸಿ ಕೈನ ಕವೊ ಕದ್ಯೊ,<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />ತ್ಯುನೆ ಘಾಬ್ರಿಯೊ ಥೈನ ಭುಚ಼ಕಿನ ಕಾಪ್ತಿಯೊ ಮಝಾರಕಂತಿಯೊ ನ್ಹಾಟಿಗಯ್ಯೊ. ತ್ಯುನೆ ಭುಚ಼್ಕಲ ಹುತಿ ಕಿಕನಜ಼ ಸುಜ಼ ಕದಿಯೊ ನೈ.<verse eid="MRK 16:8" /></para>
  <para style="s1">ಯೆಸು ಮಗ್ದಲನಿ ಮರಿಯಳನೆ ದಿಕ್ಹಲ</para>
  <para style="r">(<ref loc="MAT 28:9-10">ಮತ್ತಾಯ 28:9-10</ref>; <ref loc="JHN 20:11-18">ಯೊಹಾನ 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />(ಹಪ್ತಾನಾ ಪಸ್ಟಲ್ಯಾ (ಐತ್ವಾರ) ದಿನಮಾ ಪಾಟೆ ಯೆಸು ಮರಿನ ಜಿವ್ತೊ ಥೈನ ಉಟಲಪರ ಮಗ್ದಲನಿ ಮರಿಯಳನೆ ಪೈಲಾ ದಿಕ್ಹ್ಯೊ. ತೆ ಕುನ್ನ ವ್ಹೈ ಕದ್ಯಾಮ ತಿನೆ ತೆ ಕ್ಹಾತ ಕೆಟ್ಟ ಆತ್ಮಾ ಛೊಡಾಯೊತೊ. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />ತೆ ದಿಕ್ಹಲ ಪೈಲಾ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲವಾಲಾವೊನಾ ತಿಳಸಿ ತ್ಯುನೆ ದುಖಪಡ್ದಿನ ರೊತಾ ಬೈಟ್ಯಾತಾ. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />ತೆ ಜಿವ್ತೊ ಛೆ ಮನೆ ದಿಕ್ಹ್ಯೊಸ ಕದಲ ಐಕಿನ ತ್ಯುನೆ ಬರೊಕ್ಹೊ ಕರ‍್ಯಾ ನೈ.<verse eid="MRK 16:11" /></para>
  <para style="s1">ಯೆಸು ಬೆ ಶಿಷ್ಯಾವೊನೆ ದಿಕ್ಹಲ</para>
  <para style="r">(<ref loc="LUK 24:13-35">ಲುಕ 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />ಎ ಥಯಲ್ಪರ ಶಿಷ್ಯಾವೊಮಾನಾ ಬೆ ಜ಼ನಾ ಯಕ್ಕ ಗಾಮೆ ಚಾ಼ಲತಾ ಜಾ಼ತಾಮಾ ಯೆಸು ತ್ಯುನೊನೆ ತೆ ವಳಕ ಲಾಗುನೈಸೊ ಬಿಜಾ಼ ಯಕ್ಕ ರುಪಮಾ ದಿಕ್ಹ್ಯೊ. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />ತ್ಯುನೆ ಗೈನ ವರಿ ಫರಿನ ಐನ ಉಗ್ರಲವಾಲಾವೊನೆ ತಿಳಶ್ಯಾ. ವರಿಬಿ ತ್ಯುನೆ ಬರೊಕ್ಹೊ ಕರ‍್ಯಾ ನೈ.<verse eid="MRK 16:13" /></para>
  <para style="s1">ಯೆಸು ಗ್ಯಾರಾ ಜ಼ನಾವೊನೆ ದಿಕ್ಹಲ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ಮತ್ತಾಯ 28:16-20</ref>; <ref loc="LUK 24:36-49">ಲುಕ 24:36-49</ref>; <ref loc="JHN 20:19-23">ಯೊಹಾನ 20:19-23</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />ಲಾಸ್ಟೆ ತ್ಯುನೆ ಗ್ಯಾರಾ ಜ಼ನಾ ಶಿಷ್ಯಾ ಖಾವಾನೆ ಬೈಟಲ ಟೈಮಮಾ ತ್ಯುನೊನೆ ತೆ ದಿಖ್ಯೊ. ತೆ ಜಿವ್ತೊ ಥೈನ ಉಟಲ ದಿಕ್ಹಲ ವಾಲಾವೊನಿ ವಾತಪರ ನೈ ಬರೊಕ್ಹೊ ಕರಲಕ್ಹು ತ್ಯುನಿ ಯಕ್ಕ ಅಪನಂಬಿಕಿಕ್ಹು ತ್ಯುನಾ ಘಟ್ಟ ಥಯಲ ಮನಸೊನೆ ಭುಚ್ಕಾ಼ಡ್ಯೊ.<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />ಪಾಚ಼ಲ್ತೊ ತೆ ತ್ಯುನೊನೆ ತುಮೆ ಗೈನ ದುನಿಯಾಮಾ ಕ್ಹಾರಿ ಜ಼ಗಾ ಕ್ಹಾರಿ ಜಾ಼ತನಾ ಮನಕ್ಹೊನೆ ಸುವಾರ್ತೆ ಸಾರೊ. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />ಕುನ್ನ ಬರೊಕ್ಹೊ ಕರಿನ ಬಾಪ್ತಿಸ್ಮ ಕರೈಲಿವಾಲಾನೆ ರಕ್ಷಣೆ ಮಳಸ ಬರೊಕ್ಹೊ ನೈ ಕರಲ ವಾಲಾನೆ ಶಿಕ್ಷಾನೆ ಗುರಿ ಥಾವಸ. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />ಎನೈಸೊ ಬರೊಕ್ಹೊ ಕರಲ ವಾಲಾನಾ ಹತೆ ಅದ್ಭುತ ಕರಾನು ಅದಿಕಾರ ದಿವಸ; ಮಾರು ನಾಮ ಕೈನ ಕೆಟ್ಟ ಆತ್ಮಾ ಛೊಡಾವಸ ಅಜಪನಿಯೊ ವಾತೊ ಬೊಲಸ. <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />ತ್ಯುನೆ ಕ್ಹಾಪೊ ಉಚಾವಸ ವರಿ ಮರಾನು ವಕ್ಹಡ ಪಿದ್ಯಾತಬಿ ಸುಜ಼ ಕೆಟ್ಟ ಥಾತು ನೈ ತ್ಯುನೆ ರೊಗಿಯೊಪರ ಹತ್ತ ಮ್ಹೆಲ್ಯಾಮ ತೆ ರೊಗಿಯೊ ಅರಾಮ ಥಾವಸ ಕದ್ಯೊ.<verse eid="MRK 16:18" /></para>
  <para style="s1">ಯೆಸು ಸ್ವರ್ಗಮಾ ಗಯಲ</para>
  <para style="r">(<ref loc="LUK 24:50-53">ಲುಕ 24:50-53</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />ಯೆಸು ಸ್ವಾಮಿ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬೊಲಲಪರ ತಿನೆ ಸ್ವರ್ಗಮಾ ಕ್ಹುದಾಲಿನ ಗೈಪಡ್ಯೊ ತೆಳಾಮಾಜ಼ ಯೆಸು ಕ್ಹುದಾನಾ ಶಿದಾ ಹತ ಬಗಲ ಬೈಟ್ಯೊ. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />ಶಿಷ್ಯಾ ಕ್ಹಾರಿ ಜ಼ಗಾ ಗೈನ ತೆ ವಾತೊ ಕತಾ ಗಯಾ;ವರಿ ಕರತಾ ತ್ಯುನಾ ಕ್ಹಾತೆ ರ‍್ಹೈನ ಮ್ಹೊಟಾ-ಮ್ಹೊಟಾ ಕಾಮೊ ಅದ್ಭುತ ಕರತೊ ತಿನಾ ಹುತಿ ತ್ಯುನೆ ಕವಾನಿ ಸುವಾರ್ತೆ ಘಟ್ಟ ಕರತೊ ವ್ಹತ್ತೊ)<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>