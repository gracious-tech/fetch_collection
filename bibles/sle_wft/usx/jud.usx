<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Shikkalgar</book>
  <para style="h">ಯುದ</para>
  <para style="toc3">ಯುದ</para>
  <para style="toc2">ಯುದ</para>
  <para style="toc1">ಯುದ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="mt2">ಯುದನು ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ಯುದ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಯುದ ಬರ್ದಲ ಪತ್ರಿಕೆ ಯುದ ಕವಾಲೊ ಮನಕ್ಹ ಬರ್ದಲ ವ್ಹೈ. ಯುದ ತಿನಾಕ್ಹು ತಿನೆ ಯೆಸುನೊ ಭೈ ಥಯಲ ಯಾಕೊಬ ತಿನೊ ಭೈ ವ್ಹೈ ಕೈನ ಕವೈಲಿವಸ. ತಿನಾಹುತಿ ತೆ ಯೆಸುನೊ ಭೈ ವ್ಹೈ ಕೈನ ಬರೊಕ್ಹೊ ಕರ್ಲಿವಸ. (ಕೈ ಅದ್ಯಾಯ ವ್ಹೈ ಕದ್ಯಾಮ 1) ಆ ಪತ್ರ ಕ್ಹರಿ ವ್ಹೈ ಕೈನ ಸಭೆನೆ ಬರ್ದಲ ವ್ಹೈ. ಕೈನ ಕವಾನು ದೆಕಾಡಿನೆ ದಿವಸ ತೆನೈಸೊ ವರಿ ಜು಼ನ್ನಾ ವಡಂಬಡಿಕೆಮಾನಿ ದಕ್ಹಿಯೊ ಸಂಗತಿಯೊ ಎ ಪತ್ರಮಾ ದೆಕ್ತಾಮಾ ಖಾಸ ಒದಾಲೊ ಯಹುದ್ಯೊ ವ್ಹೈ. ಕವಾನು ವರಿಬಿ ಯುದ ಎ ಪತ್ರ ಕ್ಹಾರಾವೊನೊ ಬಾ ಥಯಲ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ ವರಿ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಹುತಿ ಮನಕ್ಹೊನೆ ಬರ್ದಲ ವ್ಹೈ. <char style="xt"><ref loc="JUD 1:1">ಯುದ 1</ref></char> ಎ ಪತ್ರ ಘನ್ನಿಸಲಾ ಕ್ರಿಸ್ತ ಹುಟ್ಟಪ್ಲರ 60 ವರಕ್ಹಮಾ ಬರ್ದಲ ವ್ಹೈ. ಎ ಪತ್ರ ಬರ್ದಾನು ತಿನು ಉದ್ದೆಶ ಸುಳ್ಳ ಭೊದೊಕೊನಾ ಹುತಿ ತಪ್ಪ ವಾಟೆ ಜೌ಼ನೈ ಕೈನ ಕವಾನಾ ಹುತಿ ಕ್ಹಾರಾ ಬರೊಕ್ಹಾಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಹುಶಾರ ಕರಾನಾ ಹುತಿ ವ್ಹೈ. <char style="xt"><ref loc="JUD 1:4">ಯುದ 1:4</ref></char> ತಿನಾ ವಾತೊಕ್ಹು ತಾಕತ ದಿವಾನಾ ಹುತಿ ಜು಼ನ್ನ ವಡಂಡೆಕೆಮಾ ಥಯಲ ಉಪಯೊಗ ಕರಸ. ಎ ಪತ್ರ ಪೆತ್ರಾಮಾ ರ‍್ಹಯಲ ನಿಂಗತ ರ‍್ಹಯಲ ಸುಳ್ಳ ಭೊದೊಕಾನಾ ಹುತಿ ಹುಶಾರ ದೆವದುತೊ ವರಿ ಸೊದೊಮ ವರಿ ಗೊಮೊರ ಗಾಮೊನಾ ಹುತಿ ಎ ಕ್ಹಾರೊ ಮಳಲ ಹುತಿ ಘನ್ನಿಯೊ ವಿಶಯ ಎ ಪತ್ರಮಾ ದೆಕಿಯೆಸ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1). ಯುದತಿನಾ ಒದಾಲಾವೊನೆ ದೆಕಾಡಿನ ದಿವಸ. <char style="ior"><ref loc="JUD 1:2">1:2</ref></char></para>
  <para style="io1">2) ತೆ ಥಯಲ್ಪರ ತೆ ಸುಳ್ಳ ಭೊದೊಕಾನಾ ವಿರುದ್ದ ತ್ಯುನೊನೆ ಹುಶಾರಕಿ ಕವಾನಾ ಹುತಿ ಬರ್ದಾನು ಕಾರಣ ಕವಸ. <char style="ior"><ref loc="JUD 1:5">1:5</ref> </char></para>
  <para style="io1">3) ತೆ ಥಯಲ್ಪರ ಜುನ್ನು ವಡಂಬಡಿಕೆಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊನಾ ಹುತಿ ಥಯಲ ಉದಾಹರಣೆ ದಿವಸ. <char style="ior"><ref loc="JUD 1:2-6">1:2—1:6</ref></char></para>
  <para style="io1">4) ತೆ ಥಯಲ್ಪರ ತೆ ಎ ಹುಶಾರನಾ ಹುತಿ ತ್ಯುನೆ ಪ್ರತಿಕ್ರಿಯೆ ಸು ಛೆ ಕವಾನು ಕವಸ. (1 17 23). 5) ಲಾಸ್ಟಮಾ ಕ್ಹುದಾನೆ ಸ್ತುತಿ ಕತೊ ತಿನು ಪತ್ರ ಕೊನೆ ಕರಸ. <char style="ior"><ref loc="JUD 1:24">1:24</ref>,<ref loc="JUD 1:25">25</ref></char></para>
  <chapter number="1" style="c" sid="JUD 1" />
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1" />ಯೆಸು ಕ್ರಿಸ್ತನೊ ಸೆವಕ, ಯಾಕೊಬನೊ ಭೈ ಥಯಲ ಯುದ ಬಲಾಯಲವಾಲಾವೊನೆ,</para>
  <para style="p" vid="JUD 1:1">ಬಾ ಥಯಲ ಕ್ಹುದಾನೆ ಮಯಾನಾ ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತಮಾ ಚೊ಼ಕಿತರಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಬರ್ದಾನು ಸುವೈ ಕದ್ಯಾಮ,<verse eid="JUD 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2" />ತುಮೊನೆ ಮರ್ಗಾ, ಶಾಂತಿ, ವರಿ ಮಯಾ ಜಾಸ್ತಿ ಥಾವಾದೆ.<verse eid="JUD 1:2" /></para>
  <para style="s">ಕೆಟ್ಟ ವಾಟಮಾ ಲಿನಜಾ಼ವಾನಾ ಭೊದಕೊ</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3" />ಮಯಾನಾ ದೊಸ್ತೊ, ಅಪೊನೆ ಚೊ಼ಕು ರ‍್ಹಯಲ ರಕ್ಷಣೆನಾ ವಿಷಯಮಾ ತುಮೊನೆ ಆವಾನೆ ಪುರಾ ಆಸಕ್ತಿಕ್ಹು ಕೊಶಿಸ ಕರ್ತಾಮಾ, ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ ಶಾಶ್ವತ ಥಯಲ ನಿಂಗತ ಯಕ್ಕಜ಼ ಸಲಾ ವಪ್ಸಾಯಲ ನಂಬಿಕೆನೆ ವಚಾಡಿಲಿವಾನಾಹುತಿ, ತುಮೆ ಹೊರಾಡು ಕೈನ ಹುಶಾರಕಿ ಬರ್ದಾನು ಮನೆ ಜ಼ರುರಿ ವ್ಹೈ ಕೈನ ಮನೆ ದಿಕ್ಹ್ಯು. <verse eid="JUD 1:3" /><verse number="4" style="v" sid="JUD 1:4" />ಕಾಕದ್ಯಾಮ ಭಕ್ತಿ ನೈ ರ‍್ಹಯಲವಾಲಾ, ಹಮಾರಾ ಕ್ಹುದಾನಿ ಕೃಪಾನೆ ನ್ಯಾವಾ ಕರಲಿನ ಅಸ್ಸಯಿನಾ ಕಾಮೊ ಕರಸ, ಹಮಾರೊ ಯಕ್ಲೊಜ಼ ಮಾಲಕ ಕರ್ತಾ ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನೆ ನೈ ಸ್ವಿಕಾರ ಕರಾಲಾ ದಕ್ಹಾ ಮನಕ್ಹೊ ದಡಿನ ಸಭೆನಾ ಮ್ಹೈ ಹೊಕ್ಯಾಸ. ಇವ್ನೊನೆ ಶಿಕ್ಷಾ ದಿವಾನಾಹುತಿ ಪೈಲಾಜ಼ ನೆಮ್ಸಲವಾಲಾ ಥಯಾಸ ಕೈನ ಬರ್ದಲ ಛೆ.<verse eid="JUD 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5" />ತುಮೆ ಕ್ಹಾರುಜ಼ ಪೈಲಾ ತಿಳದಲವಾಲಾ ರ‍್ಹೈತಬಿ, ಮಿ ಅಗಲ್ಯಾ ದಕ್ಹಾ ಸಂಗತಿಯೊನೆ ತುಮಾರಾ ಶೆಂನೆ ಲೌಕೈನ ಆಸ ಕರುಸ. ತೆ ಕಯಾ ವ್ಹೈ ಕದ್ಯಾಮ, ಕರ್ತಾ ತಿನಾ ಗುಂಪನೆ ಐಗುಪ್ತ ದೆಶಮಾತೊ ವಚಾ಼ಡ್ಯೊ, ತೆ ಥಯಲ್ಪರ ತಿಮಾನಾ ನೈ ನಂಬಲವಾಲಾವೊನೆ ನಾಶಕರ‍್ಯೊ. <verse eid="JUD 1:5" /><verse number="6" style="v" sid="JUD 1:6" />ಅಪ್ನೊ ಅದಿಕಾರನಿ ಜ಼ಗಾ ನೈ ವಚ಼ಾಡಿ ಲಿದ್ಯಾಮ, ಅಪ್ನಿ ಸ್ವಂತ ರ‍್ಹವಾನಿ ಜ಼ಗಾನೆ ಛೊಡಿನ ದೆವದುತೊನೆ ಕ್ಹುದಾ ಹಮೆಶಾನಾ ಬೆಡಿಯೊ ಘಾಲಿನ ಮ್ಹೊಟಾ ದಿನ್ನಮಾ ತಿರ್ಪನಾಹುತಿ ತ್ಯುನೊನೆ ಅಂದಾರಾಮಾ ಮ್ಹೆಲ್ಯೊಸ.<verse eid="JUD 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JUD 1:7" />ಸೊದೊಮ ವರಿ ಗೊಮೊರ ಗಾಮೊಲಕ್ಕಾ, ತಿನಾ ಸುತ್ತೆನಾ ಗಾಮೊಲಕ್ಕಾ ತೆ ದುತನಿಂಗತ ಚಾ಼ಲಿಲಿನ ತ್ಯುನೊನೆ ಜಾರತ್ವನೆ ವಪಸೈನ, ಅ ಸ್ವಭಾವಿಕ ಥಯಲ ಕಾಮೊನೆ ಪಾಲ್ಸಕ್ಹು ತ್ಯುನೆ ಹಮೆಶಾನಿ ಆಗಮಾನಿ ಶಿಕ್ಷಾನೆ ಅನುಬವಿಸ್ತಾ ಕೆಟ್ಟ ವಾಟೊನೆ ಥಾವಾನು ಕೆಟ್ಟ ಗತಿನೆ ಉದಾಹರಣೆ ಮ್ಹೆಲ್ಯಾಸ.<verse eid="JUD 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8" />ತುಮಾರಿ ಸಭೆಮಾ ಆವಾಲಾ ಮನಕ್ಹೊನೆ ಇನಾನಿಂಗತಜ಼ ಥಾವಸ. ತ್ಯುನಾ ಕ್ಹಪ್ನೊಜ಼ ತ್ಯುನೊನೆ ವಾಟ ಥಾವಸ. ತ್ಯುನಾ ಪಾಪೊಕ್ಹುಜ಼ ತ್ಯುನೊನೆಜ಼ ವ್ಹಲಸ ಕರ್ಲಿವಸ. ತ್ಯುನೆ ಪ್ರಭುನೊ ಅದಿಕಾರನೆ ತಿರಸ್ಕಾರ ಕರ್ಲಿವಸ. ತಾಕತವರ ರ‍್ಹಯಲ ದೆವದುತೊನಾ ವಿರುದ್ದ ಕೆಟ್ಟ ವಾತೊ ಬೊಲಸ. <verse eid="JUD 1:8" /><verse number="9" style="v" sid="JUD 1:9" />ಮ್ಹೊಟೊ ದೆವದುತ ರ‍್ಹಯಲ ಮಿಕಾಯಲಜ಼ ಖುದ್ದ ಇಮ್ಮ ಕರ‍್ಯೊ ನೈ. ಮೊಶೆನು ಮರಲ ಅಂಗ ಕಿನೆ ಮಳು ಕೈನ ಮಿಕಾಯೆಲ ಸೈತಾನನಾ ಹುತಿ ದೊಷಣೆ ಕರ‍್ಯಾವಾಚಿ" ಪ್ರಭುಜ಼ ತುನೆ ಶಿಕ್ಷಾ ದಿವಸ "ಕೈನ ಕದ್ಯೊ.<verse eid="JUD 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JUD 1:10" />ತೆನೈಸೊ ಎ ಮನಕ್ಹೊ ನೈ ಕಳಲನೆ ಟಿಕಾ ಕರಸ. ತ್ಯುನೊನೆ ದಕ್ಹುಜ಼ ಗ್ವತ್ತ ಥಾವಸ. ತೆನೈಸೊ ಗ್ಯಾನ ನೈಸೊ ಪ್ರಾಣಿಯೊ ನಿಂಗತ ಸಹಜ಼ ಪ್ರವೃತ್ತಿಕ್ಹು ಕಳೈಲಿವಸ ಯಕ್ಕಜ಼ ಮನಸಕ್ಹು ಕಳೈಲೆತಾ ನೈ. ಎಜ಼ ತ್ಯುನೊನೆ ನಾಶ ಕರಸ. <verse eid="JUD 1:10" /><verse number="11" style="v" sid="JUD 1:11" />ತ್ಯುನೊನೆ ಕೆಟ್ಟ ಪರಸ್ತಿಥಿ ಆವಸ. ಎ ಮನಕ್ಹೊ ಕಾಯಿನ ಚಾ಼ಲಲ ವಾಟ್ಮಾಜ಼ ಚಾ಼ಲಸ. ತ್ಯುನೆ ಆಸ್ತಿ ಗಳ್ಸಾನಾ ಹುತಿ ಬಿಳಾಮನನಿ ವಾಟ್ಮಾ ಚಾ಼ಲಾನೆ ತ್ಯುನಾಕ್ಹು ತ್ಯುನೊನೆ ವಪ್ಸಿನ ದಿದ್ಯಾಸ. ಕೊರಹನ ಕರಲನಿಂಗತಜ಼ ಕ್ಹುದಾನಾ ವಿರುದ್ದ ಹೊರಾಡ್ಯಾಡ್ಯಾಸ. ತ್ಯುನೆ ಕ್ಹಾರಾ ಕೊರಹನಿಂಗತ ಹಾಳಥಾವಸ. <verse eid="JUD 1:11" /><verse number="12" style="v" sid="JUD 1:12" />ತುಮಾರಾ ಅನ್ಯುನೆತೆನಾ ಭೊಜನಮಾ ಎ ಮನಕ್ಹೊ ಡುಬಿ ಗಯಲ ದಗ್ಡಾವೊನಿಂಗತ ಛೆ. ತ್ಯುನೆ ಭೆ ನೈಸೊ ತುಮಾರಾ ಕ್ಹಾತೆ ಕವಾಡ್ಯಾಸ. ತ್ಯುನೆ ಖುದ್ದನಾ ಹುತಿಜ಼ ಚಿಂತಾ ಕರಾಲಾ ಕುರಬುರ‍್ಯಾ ಥಯಾಸ. ತ್ಯುನೆ ಪಾನಿ ನೈಸೊ ಮ್ಹಾಡನಿಂಗತ ಥಯಾಸ. ವಾರೊ ತೆ ಮ್ಹಾಡನೆ ತಿನಾ ಕ್ಹಾತೆ ಲಿನ ಗೈಪಡಸ. ತ್ಯುನೆ ಕಯಾ ಟೈಮ್ಮಾ ಫಲ ದ್ಯು ತೆ ಕಾಲಮಾ ಫಲ ದಿದ್ಯಾವಾಚಿ ಬೆರ ಕ್ಹಾತೆಜ಼ ಕಿತ್ತೈನ ಆಯಲ ಝಾಡೊನಿಂಗತ ಛೆ. <verse eid="JUD 1:12" /><verse number="13" style="v" sid="JUD 1:13" />ಇವ್ನೆ ಸಮುಂದರಮಾ ರ‍್ಹಯಲ ಧಡ್ಕಿಯೊ ನಿಂಗತ ಛೆ. ಎ ಧಡ್ಕಿಮಾತು ಆವಾನು ಬುರುಕ ನಿಂಗತ ಇವ್ನೆ ಸರಮ ನೈಸೊ ಕಾಮೊ ಕರಾಡಾಸ. ಎ ಮನಕ್ಹೊ ಹಬಾಳಮಾ ಫರಾನಿಯೊ ಚಿಕ್ಕಿಯೊ ನಿಂಗತ ಛೆ. ತ್ಯುನಾಹುತಿ ಹಮಾಶಾಬಿ ಅಂದಾರಾ ರ‍್ಹವಾನಿ ಜ಼ಗಾಮಾಜ಼ ಕಾಯ್ದಾ ಲಗಾಡಸ.<verse eid="JUD 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14" />ಆದಾಮತೊ ಕ್ಹಾತ್ವಾ ಮಾತಾನೊ ರ‍್ಹಯಲ ಹನೊಕ ಎ ಮನಕ್ಹೊನಾ ಹುತಿ ಅಮ್ಮ ಕದ್ಯೊಸ; "ದೆಕೊ, ಲಾಕೊಶಿ ತಿನಾ ಪರಿಶುದ್ಧ ದುತೊನಾ ಕ್ಹಾತೆ ಆವಾಡ್ಯೊಸ. <verse eid="JUD 1:14" /><verse number="15" style="v" sid="JUD 1:15" />ಪ್ರಭು ಹರಿಯಕ್ಲಾನೆ ಫೈಸಲೊ ಕರಸ. ಭಕ್ತಿಮಾ ಕಮಿ ರ‍್ಹಯಲವಾಲಾ ತಿನಾ ವಿರುದ್ದ ಕರಲ ಕ್ಹಾರಾ ಕೆಟ್ಟ ಕಾಮೊ ವರಿ ಪಾಪಿಯೊ ತಿನಾ ವಿರುದ್ದ ಬೊಲಲ ಕ್ಹಾರಿ ವಾತೊ ಖಂಡ್ಸಾನೆ ತೆ ಆವಾಡ್ಯೊಸ.<verse eid="JUD 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16" />ಎ ದುರ್ಭೊದಕೊ ಗುಣ ಗುಟ್ಟಾಲಾ ತಪ್ಪ ಹುಡ್ಕಾಲಾ ಕೆಟ್ಟ ಆಸಮಾ ಪಡಲವಾಲಾ ಮಿ ವ್ಹೈ ಕೈನ ಕವಾಲಾ ಮ್ಹೊಡು ದೆಕಿನ ಬೊಲಾಲಾ ಥಯಾಸ.<verse eid="JUD 1:16" /></para>
  <para style="s">ಹುಶಾರಕ್ಹು ರ‍್ಹವೊ ಕೈನ ಎಚ್ಚರಕಿ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17" />ಮಯಾನಾ ದೊಸ್ತೊ, ಅಪ್ನಾ ಪ್ರಭು ಯೆಸು ಕ್ರಿಸ್ತನಾ ಅಪೊಸ್ತಲೊ ಪೈಲಾ ಸು ಕದ್ಯಾತಾ ಕೈನ ಶೆಂ ಕರಿಲಿವೊ. <verse eid="JUD 1:17" /><verse number="18" style="v" sid="JUD 1:18" />ಅಪೊಸ್ತಲೊ ತುಮೊನೆ, ಅಂತ್ಯಕಾಲಮಾ ಕ್ಹುದಾನಾ ಹುತಿ ಅಕ್ಹಾಲಾ ಮನಕ್ಹೊ ರ‍್ಹವಸ ಕೈನ ಕದ್ಯಾ ಎ ಮನಕ್ಹೊ ತ್ಯುನಾ ಮನಸೆ ಆಯಲ ತಿಮ್ಮಜ಼ ವರಿ ಕ್ಹುದಾನಾ ವಿರುದ್ದ ರ‍್ಹಯಲ ಕರಾಲಾ ಥಯಾಸ. <verse eid="JUD 1:18" /><verse number="19" style="v" sid="JUD 1:19" />ಎ ಮನಕ್ಹೊ ತುಮೊಮಾ ಭೆದ ಹುಟ್ಸಾವಸ. ಎ ಮನಕ್ಹೊ ತ್ಯುನಿಯೊ ಪಾಪನಿಯೊ ಚಾಳಿಯೊ ನಿಂಗತ ಯಕ್ಕಜ಼ ಕರಸ. ತ್ಯುನೊಮಾ ಪವಿತ್ರ ಆತ್ಮಾ ನತ್ತಿ. <verse eid="JUD 1:19" /><verse number="20" style="v" sid="JUD 1:20" />ತೆನೈಸೊ ಮಯಾನಾ ಭಾಯೊ, ತುಮೊಮಾ ರ‍್ಹಯಲ ಪರಿಶುದ್ದ ಬರೊಕ್ಹಾನಾ ಮುಲಕ ಪವಿತ್ರ ಆತ್ಮಾ ಭರಿತ ಥೈನ ಪ್ರಾಥನಾ ಕರೊ. <verse eid="JUD 1:20" /><verse number="21" style="v" sid="JUD 1:21" />ಹಮೆಶಾನಾ ಜ಼ಲಮನಾ ಹುತಿ ಅಪ್ನೊ ಕರ್ತಾ ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನಿ ಮರ್ಗಾ ಕ್ಹಾಮಾ ದೆಕ್ತಾ ರ್ಹವೊಸಿ.<verse eid="JUD 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22" />ಶಕ್ಕ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಮರ್ಗೊ. <verse eid="JUD 1:22" /><verse number="23" style="v" sid="JUD 1:23" />ಬಿಜಾ಼ ಮನಕ್ಹೊನೆ ವಚಾ಼ಡೊ. ತೆ ಮನಕ್ಹೊನೆ ಆಗಮಾತಾ ಭಾರಾ ಲಾವೊ. ತುಮೆ ದಕ್ಹಾ ಮನಕ್ಹೊನೆ ಮರ್ಗಾ ದೆಕಡತಾಮಾ ಹುಷಾರಕ್ಹು ಪಾಪೊಕ್ಹು ರಾಡಿ ಥಯಲ ತ್ಯುನಾ ವಣ್ಣಾವೊನೆಬಿ ದುಶ್ಮನಿ ಕರೊ.<verse eid="JUD 1:23" /></para>
  <para style="s">ಲಾಸ್ಟನು ಆಶಿರ್ವಾದ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24" />ತೆ ತಾಕತವರ ಥಯೊಸ. ತುಮೆ ಪಡೆನೈಸೊ ತೆ ತುಮೊನೆ ಮದದತ ಕರಸ. ತೆ ತುಮೊಮಾ ಸುಜ಼ ತಪ್ಪ ನೈಸೊ ಕರಿನ ತಿನಿ ಮಹಿಮಾನಿ ಸನ್ನಿಧಿಮಾ ಲಾವಾನೆ ತುಮೊನೆ ಘನ್ನಿ ಮ್ಹೊಟಿ ಖುಶಿ ದಿವಾನೆ ಶಕ್ತ ಥಯೊಸ. <verse eid="JUD 1:24" /><verse number="25" style="v" sid="JUD 1:25" />ತೆಜ಼ ಯಕ್ಲೊ ಕ್ಹುದಾ ವ್ಹೈ. ಅಪೊನೆ ವಚಾ಼ಡಾಲೊ ವ್ಹೈ. ಆದಿಮಾ ರ‍್ಹಯಲ ನಿಂಗತಜ಼ ಹಮ್ನಾಬಿ ವರಿ ಅಗೊಬಿ ಹಮೆಶಾಬಿ ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಮುಲಕ ತಿನೆ ಪ್ರಭಾವ, ಮಹತ್ವ, ಆಧಿಪತ್ಯ ವರಿ ಅದಿಕಾರೊ ರ‍್ಹವಾದೆ. ಆಮೆನ.<verse eid="JUD 1:25" /></para>
  <chapter eid="JUD 1" />
</usx>