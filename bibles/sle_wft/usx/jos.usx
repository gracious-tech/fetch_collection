<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOS" style="id">- Sikkiligar</book>
  <para style="h">ಯೆಹುಶು</para>
  <para style="toc3">ಯೆಹುಶುವ</para>
  <para style="toc2">ಯೆಹುಶು</para>
  <para style="toc1">ಯೆಹುಶುವ ಬುಕ್ಕ</para>
  <para style="mt2">ಯೆಹುಶವ</para>
  <para style="mt1">ಯೆಹುಶವ</para>
  <chapter number="1" style="c" sid="JOS 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 1:1" />ಮೊಶೆ ಯಹೊವಾನೊ ಸೆವಕ ವ್ಹತ್ತೊ. ನುನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹೊಶುವಾ ಮೊಶೆನೊ ಸಹಾಯಕ ವ್ಹತ್ತೊ. ಮೊಶೆ ಮರಲ್ಪರ ಯಹೊವಾ ಯೆಹೊಶುವಾನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="JOS 1:1" /><verse number="2" style="v" sid="JOS 1:2" />ಮಾರೊ ಸೆವಕ ಥಯಲ ಮೊಶೆ ಮರಿಗಯೊ. ಹಮ್ನಾ ತು ಉಟ ವರಿ ಎ ಮನಕ್ಹೊ ಯೊರ್ದನ ನದಿ ದಾಟಿನ ಜೌ. ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊ ಥಯಲ ತುಮೊನೆ ಮಿ ದಿವಾನಾ ದೆಶೆ ತುಮೆ ಜೌ. <verse eid="JOS 1:2" /><verse number="3" style="v" sid="JOS 1:3" />ಮಿ ತೆ ದೆಶನೆ ತುಮೊನೆ ದಿವ್ಸ ಕೈನ ಮೊಶೆನೆ ವಾಗ್ದಾನ ಕರ‍್ಯೊಸ. ತಿನಾಹುತಿ ತುಮೆ ಪಗೊ ಮ್ಹೆಲಾನಿ ಕ್ಹಾರಿ ಜ಼ಗಾ ತುಮೊನೆ ದಿವ್ಸ. <verse eid="JOS 1:3" /><verse number="4" style="v" sid="JOS 1:4" />ರಾನ ವರಿ ಲೆಬನೊನ ಡೊಂಗರ ಎ ಕ್ಹಾರು ಮಳಿನ ಯುಫ್ರೆಟಿಸ ಮ್ಹೊಟ್ಟಿ ನದಿ ಲಕ್ಕಾ ಹಿತ್ತಿವಾಲಾವೊನಿ ಕ್ಹಾರಿ ಜ಼ಗಾ ತುಮಾರು ಥಾವಸ. ತುಮಾರಿ ಜ಼ಗಾ ಪಶ್ಚಿಮಾ ರ‍್ಹಯಲ ಎಡಿಟರೆನಿಯನ ಸಮುಂದರ ಲಕ್ಕಾ ಫೈಲಸ. <verse eid="JOS 1:4" /><verse number="5" style="v" sid="JOS 1:5" />ಮಿ ಮೊಶೆನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ಲಿಂಗತ ತಾರಾ ಕ್ಹಾತೆಬಿ ರ‍್ಹೌಸ. ತಾರಿ ಜಿಂದಗಿ ಭರಿನ ಕುನ್ನಜ ತಾರಾ ಕ್ಹಾತೆ ಲಡೈ ನೈ ಕಾಡ್ತು. ಮಿ ತಾರೊ ಹತ್ತ ನೈ ಛೊಡತೊ; ಢಕಲಿ ಪಡ್ತೊ ನೈ” ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 1:5" /><verse number="6" style="v" sid="JOS 1:6" />ಯೆಹೊಶುವಾ, ತು ಘಟ್ಟ ಥೈನ ರ‍್ಹೌ; ಧೈರ್ಯವಂತ ಥೈನ ರ‍್ಹೌ; ಎ ಮನಕ್ಹೊ ತ್ಯುನು ದೆಶ ಪಡ್ದಿಲಿವಾನೆ ತು ತ್ಯುನೊನೆ ಅಗೊ ಥೈನ ಚಲೌ. ಮಿ ಇವ್ನೊನೆ ಎ ಜ಼ಗಾ ದಿವ್ಸ ಕೈನ ಇವ್ನಾ ಪುರ್ವಿಕರೊನೆ ಪ್ರಮಾಣ ಕರ‍್ಯೊಸ. <verse eid="JOS 1:6" /><verse number="7" style="v" sid="JOS 1:7" />ತೆನೈಸೊ ತು ಬಿಜಿ ಯಕ್ಕ ವಿಶಯಮಾಬಿ ಘಟ್ಟ ಥೈನ ರ‍್ಹೌ; ಧೈರ್ಯವಂತ ಥೈನ ರ‍್ಹೌ. ಮಾರೊ ಸೆವಕ ಥೈನ ರ‍್ಹಯಲ ಮೊಶೆ ತುನೆ ದಿದಲ ಆಗನ್ಯಾವೊನೆ ತು ಕ್ಹರಿಜ಼ ಪಾಲಸು. ತಿನು ಕ್ಹಾರು ಧರ್ಮೊಪದೆಶ ನಕ್ಕರಬಿ ಬುಕ್ಯಾ ಬಗರ ಚಾಲಿಲಿನ ಗಯಲ ರ‍್ಹಯಮ ತು ಕರಾನಾ ಕ್ಹಾರಾ ಕಾಮೊಮಾ ತುನೆ ಕ್ಹರಿಬಿ ಜಯ ಮಳಸ. <verse eid="JOS 1:7" /><verse number="8" style="v" sid="JOS 1:8" />ತೆ ಧರಮಶಾಸ್ತ್ರಮಾ ಬರ್ದಲ ವಿಶಯೊ ಕೆಳಾಮಾಬಿ ಶೆಂ ಮ್ಹೆಲ. ದಿನ್ನ ರಾತ ತೆ ಧರಮಶಾಸ್ತ್ರನೆ ಧ್ಯಾನ ಕರ. ತೆಳಾಮಾ ತಿಮಾ ಬರ್ದಲ ವಿಶಯೊನೆ ತು ಕ್ಹರಿಮಾಬಿ ವಿದೆಯ ಥೈನ ರ‍್ಹಶಿ. ತು ಇಮ್ಮ ಕರ್xಯೊಮ ತು ಕರಾನಾ ಹರಯಕ್ಕ ಕಾಮಮಾ ತು ಶಾಣ್ಯೊ ಥಾಶಿ ವರಿ ಜಯಶಾಲಿ ಥೈನ ರ‍್ಹಶಿ. <verse eid="JOS 1:8" /><verse number="9" style="v" sid="JOS 1:9" />ಶೆಂ ಮ್ಹೆಲ, ತು ಘಟ್ಟ ಥೈನ ರ‍್ಹೌ ಕೈನಬಿ ಧೈರ್ಯವಾಲೊ ಥೈನ ರ‍್ಹೌ ಕೈನಬಿ ಮಿ ತುನೆ ಆಗನ್ಯಾ ದಿವ್ಸ. ತಿನಾಹುತಿ ಭುಚ್ಕು ನಕೊ, ಕಾಕದ್ಯಾಮ ತು ಗಯಲ ಕ್ಹಾರಿ ಜ಼ಗಾ ತಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾಜ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಸ” ಕೈನ ಕದ್ಯೊ.<verse eid="JOS 1:9" /></para>
  <para style="s">ಯೆಹುಶವಾ ಮನಕ್ಹೊನೆ ಅದೆಶ ದಿದಲ</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 1:10" />ತೆಳಾಮಾ ಯೆಹುಶುವಾ ಮನಕ್ಹೊನಾ ಅದಿಪತಿನೆ, <verse eid="JOS 1:10" /><verse number="11" style="v" sid="JOS 1:11" />ತುಮೆ ಪಾಳೆಯನಾ ಕ್ಹಾರಿ ಬಗಲ ಗೈನ ಮನಕ್ಹೊನೆ ತಯ್ಯಾರ ಥೈನ ರ‍್ಹವಾನೆ ದಿಳ್ಸಾವೊ; ದಕ್ಹು ಅನ್ನ ತಯ್ಯಾರ ಕರಿಲಿವಾನೆ ಕವೊ. ಹಜ್ಜುನ ತನ್ನ ದಿನ್ನಮಾ ಅಪೆ ಆಂಯೊರ್ದನ ನದಿ ದಾಟಿನ ಗಯೆಸ. ಮಿ ಗೈನ ಯಹೊವಾ ಥಯಲ ಅಪ್ನೊ ಕ್ಹುದಾ ಅಪೊನೆ ದಿವಾನಾ ದೆಶನೆ ವಶ ಕರಿಲಿಯೆಸ ಕವೊ” ಕೈನ ಆಗನ್ಯಾ ದಿದ್ಯೊ. <verse eid="JOS 1:11" /><verse number="12" style="v" sid="JOS 1:12" />ಪಾಚಲ್ತೊ ಯೆಹುಶುವಾ ರುಬೆನ್ಯವಾಲಾವೊನಾ, ಗಾದ್ಯಾವಾಲಾವೊನಾ ವರಿ ಮನಸ್ಸೆ ಖಾಂದಾನನಾ ಅರ್ದಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಿಲಿನ ತ್ಯುನೊನೆ, <verse eid="JOS 1:12" /><verse number="13" style="v" sid="JOS 1:13" />ಯಹೊವಾನೊ ಸೆವಕ ಥಯಲ ಮೊಶೆ ತುಮೊನೆ ಕದಲ ಶೆಂ ಕರಿಲಿವೊ. ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಅರಾಮ ಕರಾನಾ ಹುತಿ ಯಕ್ಕ ದೆಶ ತುಮೊನೆ ದಿವ್ಸ ಕೈನ ವಾಗ್ದಾನ ಕರ್xಯೊತೊ. <verse eid="JOS 1:13" /><verse number="14" style="v" sid="JOS 1:14" />ಯಹೊವಾ ಯೆಳಕ್ಕಾ ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವನಿ ಜ಼ಗಾ ತುಮೊನೆ ದಿದ್ಯೊಸ. ತುಮಾರಾ ಬಾಕಡಿಯೊ, ಬಚ್ಚಾ ವರಿ ತುಮಾರಾ ಜಾನ್ವಾರೊ ಜ಼ಗಾಮಾಜ ರ‍್ಹೆ ಸಕಸ. ತೆನೈಸೊ ತುಮಾರಾ ಸೈನಿಕೊ ತುಮಾರಾ ಭಾಯೊನಾ ಕ್ಹಾತೆ ಯೊರ್ದನ ನದಿ ದಾಟು. ತುಮೆ ಯುದ್ದನೆ ತಯ್ಯಾರ ಥೈನ ತುಮಾರಾ ಭಾಯೊನೆ ತುನು ದೆಶ ಪಡ್ದಿಲಿವಾಮಾ ಸಹಾಯ ಕರು. <verse eid="JOS 1:14" /><verse number="15" style="v" sid="JOS 1:15" />ಯಹೊವಾ ತುಮಾರಾ ಅರಾಮನಾ ಹುತಿ ಯಕ್ಕ ಜ಼ಗಾ ದಿದ್ಯೊಸ. ಯಹೊವಾ ತುಮಾರಾ ಭಾಯೊನಾ ಹುತಿಬಿ ಯಕ್ಕ ಜ಼ಗಾ ದಿವಸ. ತೆನೈಸೊ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ತ್ಯುನೊನೆ ದಿವಾನಾ ದೆಶೆ ತ್ಯುನೆ ಪಡ್ದಿಲಿಯೆ ಲಕ್ಕಾ ತುಮೆ ತುಮಾರಾ ಭಾಯೊನೆ ಸಹಾಯ ಕರು. ಪಾಚಲ್ತಾ ತುಮೆ ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವ ದಿಕ್ಕಮಾ ರ‍್ಹಯಲ ತುಮಾರಾ ದೆಶೆ ಜಾ ಸಕೊಶಿ. ಯಹೊವಾನೊ ಸೆವಕ ಥಯಲ ಮೊಶೆ ತುಮೊನೆ ದಿದಲ ದೆಶೆ ತೆಜ ವ್ಹೈ” ಕದ್ಯೊ. <verse eid="JOS 1:15" /><verse number="16" style="v" sid="JOS 1:16" />ತೆಳಾಮಾ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ, ತು ಆಗನ್ಯಾ ದಿದಲ ಕ್ಹಾರು ಹಮೆ ಕರಿಯೆಸ; ತು ಹಮೊನೆ ವಳಾಯಲ ಕ್ಹಾರಿ ಜ಼ಗಾಯೆ ಗಯೆಸ. <verse eid="JOS 1:16" /><verse number="17" style="v" sid="JOS 1:17" />ಹಮೆ ಮೊಶೆನಾ ಆಗನ್ಯಾ ಕ್ಹಾರಾ ಚಾಲಿಲಿನ ಗಯಾ. ತಿನಾ ನಿಂಗತ ತಾರಿ ಆಗನ್ಯಾವೊನೆಬಿ ಚಾಲಿಲಿನ ಗಯೆಸ.ತಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ತಿಮ್ಮ ತಾರಾ ಕ್ಹಾತೆಬಿ ರ‍್ಹವಾದೆ. <verse eid="JOS 1:17" /><verse number="18" style="v" sid="JOS 1:18" />ಕುನ್ನತಬಿ ತಾರಿ ಆಗನ್ಯಾವೊನೆ ಇನ್ಕಾರ್ಯಮ ತೆನೈಸೊ ಕುನ್ನತಿಬಿ ತುನೆ ವಿರೊದ ಕರ‍್ಯಾಮ ತಿನೆ ಕ್ಹಲಾಸ ಕರಿಯೆಸ. ತು ಕ್ಹಾಲಿ ಘಟ್ಟ ಥೈನ ರ‍್ಹೆ; ಧೈರ್ಯವಾಲೊ ಥೈನ ರ‍್ಹೆ” ಕೈನ ಕದ್ಯಾ.<verse eid="JOS 1:18" /></para>
  <chapter eid="JOS 1" />
  <chapter number="2" style="c" sid="JOS 2" />
  <para style="s">ಯೆರಿಕುವೆನೆ ಜಾಸುಸುನೆ ಮೊಕ್ಲಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 2:1" />ನುನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ ಗಾಮನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ವಳಾಯೊ. ಎ ಮನಕ್ಹೊನೆ ಯೆಹುಶುವಾ ವಳಾಯಲ ಸಂಗತಿ ಬಿಜು ಕಿನೆಜ ಗ್ವತ್ತ ನ್ಹೊತು. ಗೈನ ತೆ ಯೆರಿಕೊ ಗಾಮನೆ ಘನ್ನ ಸುಕ್ಷ್ಮಕ್ಹು ದೆಕೊ” ಕೈನ ಯೆಹುಶುವಾ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಕದ್ಯೊ. ತೆ ಭಂಬಿ ಜನಾ ಯೆರಿಕೊ ಗಾಮೆ ಗೈನ ಯಕ್ಕ ವ್ಯಶ್ಯಾನಾ ಘರಮಾ ರ‍್ಹಯಾ. ತೆ ಬಾಕಡಿನು ನಾಮ ‘ರಾಹಾಬ.’ <verse eid="JOS 2:1" /><verse number="2" style="v" sid="JOS 2:2" />ತೆಳಾಮಾ ಕುನ್ನ ಯಕ್ಕ ಯೆರಿಕೊ ಗಾಮನಾ ರಾಜಾನೆ, ಕಾಲ ರಾತೆ ಇಸ್ರಾಯೆಲನಾ ದಕ್ಹಾ ಜನಾ ಅಪ್ನಾ ದೆಶಾ ಕಮಜೊರಿಯೊನೆ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 2:2" /><verse number="3" style="v" sid="JOS 2:3" />ತೆಳಾಮಾ ಯೆರಿಕೊ ಗಾಮನೊ ರಾಜೊ ರಾಹಾಬನೆ, ತಾರಾ ಘರೆ ಐನ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಝಾಕಿನ ಮ್ಹೆಲು ನಕೊ. ತ್ಯುನೊನೆ ಭಾರಿ ಬಲೈ ಲಿನ ಆ. ತ್ಯುನೆ ಅಪ್ನಾ ದೆಶನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಮೊಕ್ಲೊ. <verse eid="JOS 2:3" /><verse number="4" style="v" sid="JOS 2:4" />ರಾಹಾಬ ಎ ಭಂಬಿ ಜನಾವೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. ತೆನೈಸೊ ತೆ ಪುಚ್ಚಾನೆ ಆಯಲವಾಲಾವೊನೆ, ಬೆ ಮನಕ್ಹೊ ನ್ಹ್ಯಾ ಆಯಾತಾ, ತೆನೈಸೊ ತ್ಯುನೆ ಕಿಜಾಂತಾ ಆಯಾತಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನ್ಹೊತು. <verse eid="JOS 2:4" /><verse number="5" style="v" sid="JOS 2:5" />ಖಾಂಜೆ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಾನು ಟೈಮ ಥಾತಾಮಾ ತ್ಯುನೆ ಗೈಪಡ್ಯಾ. ತ್ಯುನೆ ಕಿಜಾ ಗಯಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನತ್ತಿ. ತೆನೈಸೊ ತುಮೆ ಜಲ್ದಿ ಗಯಮ ತ್ಯುನೊನೆ ಧರ ಸಕೊಶಿ” ಕದಿ. <verse eid="JOS 2:5" /><verse number="6" style="v" sid="JOS 2:6" />ತೆನೈಸೊ ತೆ ಕ್ಹರಿಮಾಜ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಛತ್ತನಾ ಉಪ್ಪರ ಬಲೈ ಲಿನ ಗೈನ ವಟ್ಟಲ ಚಾರಾಮಾ ತ್ಯುನೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. <verse eid="JOS 2:6" /><verse number="7" style="v" sid="JOS 2:7" />ರಾಜಾನಾ ಭಟ್ಟೊ ಗಾಮನಾ ಭಾರಾ ಗೈನ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಿನ ಇಸ್ರೆಲತಾ ಆಯಲ ತೆ ಭಂಬಿ ಜನಾವೊನೆ ಹುಡಕಿನ ಗಯಾ. ತ್ಯುನೆ ಯೊರ್ದನ ನದಿ ಲಕ್ಕಾ ಗೈನ ಮನಕ್ಹೊ ನದ ದಾಟಾನಾ ಕ್ಹಾಟರಾ ಜ಼ಗಾವೊಮಾ ಹುಡಕ್ಯಾ. <verse eid="JOS 2:7" /><verse number="8" style="v" sid="JOS 2:8" />ತೆ ಭಂಬಿ ಗುಡಾಚಾರಿಯೊ ತ್ಯಾಜ ಕ್ಹುರ್xಯಾವಾನೆ ತಯ್ಯಾರಿ ಕರಿಲಿದ್ಯಾತಾ. ತೆನೈಸೊ ರಾಹಾಬ ಛತ್ತನಾ ಉಪ್ಪರ ಗೈನ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="JOS 2:8" /><verse number="9" style="v" sid="JOS 2:9" />''ಯಹೊವಾ ಎ ದೆಶನೆ ತುಮಾರಾ ಮನಕ್ಹೊನೆ ದಿದ್ಯೊಸ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. ತುಮಾರಿ ವಿಶಯ ಐಕಿನ ಹಮೊನೆ ಭೆಂ ಹುಟ್ಯುಸ. ಎ ದೆಶಮಾ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ತುಮೊಕ್ಹು ಭುಚ್ಕಿನ ಛೆ. <verse eid="JOS 2:9" /><verse number="10" style="v" sid="JOS 2:10" />ಯಹೊವಾ ತುಮೊನೆ ಸಹಾಯ ಕರಲ ತರಿಕಾನಾ ಹುತಿ ಹಮೆ ಐಕಿನ ಭುಚ್ಚಕ್ಯಾಸ. ತುಮೆ ಇಜಿಪ್ಟತಾ ಭಾರಾ ಆಯಲ್ಪರ ತೆ ಲಾಲ ಸಮುಂದರನಾ ಪಾನಿನೆ ಕ್ಹುಕ್ಹಾಯಲ ಹಮೆ ಐಕ್ಯಾಸ. ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವ ದಿಕ್ಕಮಾ ರ‍್ಹಯಲ ಸಿಹೊನ ವರಿ ಒಗ್ ಕವಾನಾ ಅಮೊರಿಯನಾ ಬೆ ಜನಾ ರಾಜಾವೊನೆ ತುಮೆ ಕಿಮ್ಮ ನಾಶ ಕರ್‍ಯಾಸ ಕವಾನು ಐಕ್ಯಾಸ. <verse eid="JOS 2:10" /><verse number="11" style="v" sid="JOS 2:11" />ಎ ಕ್ಹಾರಾವೊನಾಹುತಿ ಐಕಿನ ಹಮೊನೆ ಘನ್ನು ಭೆಂ ಐಯುಸ; ಹಮೊಮಾ ಕಿನೆಜ ತುಮಾರಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರಾನೆ ಧೈರ್ಯ ನತ್ತಿ. ಕಾಕದ್ಯಾಮ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ, ಭುಪರಲೊಕನೆ ಆಳಾಲೊ ಥಯೊಸ. <verse eid="JOS 2:11" /><verse number="12" style="v" sid="JOS 2:12" />ಹಮ್ನಾ ತುಮೆ ಹಮೊನೆ ಯಕ್ಕ ಪ್ರಮಾಣ ಕರು. ಮಿ ತುಮೊನೆ ದಯಾ ದೆಕಾಡಿನ ಸಹಾಯ ಕರಿ. ತಿನಾಹುತಿ ತುಮೆಬಿ ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ದಯಾ ದೆಕಾಡೊಶಿ ಕೈನ ಯಕ್ಕ ವಳಕ ದಿವೊ. <verse eid="JOS 2:12" /><verse number="13" style="v" sid="JOS 2:13" />ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಕದ್ಯಾಮ ಮಾರಾ ಮಾ ಬಾಪನೆ, ಭಾಯೊ ಭೆನೊನೆ ವರಿ ತ್ಯುನಾ ಕ್ಹಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಜಿವ್ತಾ ಛೊಡಾನೆ ಪ್ರಮಾಣ ಕರೊ” ಕೈನ ಮಾಂಗಿಲಿದಿ. <verse eid="JOS 2:13" /><verse number="14" style="v" sid="JOS 2:14" />ತಿನಾಹುತಿ ತ್ಯುನೆ, 'ಹಮಾರು ಜಲಮ ದಿನಬಿ ತುಮಾರು ಜಲಮ ವಚಾ಼ಡೆಸ. ತೆನೈಸೊ ತುಮೆ ಎ ಕಿನೆಜ ಕವೊ ನಕೊ. ಯಹೊವಾ ಎ ದೆಶ ಹಮೊನೆ ದಿದಲ್ಪರ ಹಮೆ ತುಮೊನೆ ದಯಾ ದೆಕಾಡೆಸ. ತುಮೆ ಹಮೊನೆ ಬರೊಕ್ಹೊ ಕರ ಸಕೊಶಿ” ಕದ್ಯಾ. <verse eid="JOS 2:14" /><verse number="15" style="v" sid="JOS 2:15" />ರಾಹಾಬನಾ ಘರನೆ ಗಾಮನಿ ಗೊಡಿಯೆ ಲಾಗಿನ ಭಾಂದ್ಯಾತಾ <verse eid="JOS 2:15" /><verse number="16" style="v" sid="JOS 2:16" />ತುಮೆ ಪಾಚಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಮಳಲ ನಂಗತ ತೆ ಪರ್ವತನೆ ನ್ಹಾಟಿನ ಜಾವೊ ತ್ಯಾ ತನ್ನ ದಿನ ದಡಿನ ರೈನ ತ್ಯುನೆ ಗಯಲ್ಪರ ತುಮಾರಿ ವಾಟ ಧರಿನ ಜಾವೊ ಕೈನ ಕದಿ. <verse eid="JOS 2:16" /><verse number="17" style="v" sid="JOS 2:17" />ವರಿ ತ್ಯುನೆ ಹಮೆ ಕದಲ ವಾತನಿಂಗತ ತು ಚಾಲೆಲ ರ‍್ಹಯಾಮ ತು ಹಮಾರಾ ಕರಲ ಪ್ರಮಾಣಖ್ಹು ಬಿಡುಗಡೆ ಥಯೊತೊ. <verse eid="JOS 2:17" /><verse number="18" style="v" sid="JOS 2:18" />ವರಿ ಹಮೆ ಆ ಗಾಮಾ ರ‍್ಹತಾಮಾ ತು ಹಮೊನೆ ಉತಾರೆಲ ಕಿಡಕಿನೆ ಲಾಲ ದೊರೊ ಭಾಂದೊ ಕದ್ಯೊ ವರಿ ತಾರಾ ಮಾಬಾಪನೆ ಭಾಯೊನೆ ಕ್ಹಾರಾ ಸಂಬದಿಕಿಯೊನೆ ತಾರಾ ಘರಮಾ ಬಲೆಲಿದಲ ರ‍್ಹವೊ. <verse eid="JOS 2:18" /><verse number="19" style="v" sid="JOS 2:19" />ತ್ಯುನಾಮಾ ಕಯೊಬಿ ಘರ ಛೊಡಿನ ರೊಡೆ ಆಯೊರೆ ರಗತನು ಪಾಪ ವ್ಹೈ ತ್ಯುನಾ ಮಾತಾನಾ ಉಪ್ಪರ ನಿರ್ದೊಸಿಯೊ ಕೈನ ರ‍್ಹವಸ. ವರಿ ತಾರಾಖ್ಹಾತೆ ಘರಮಾ ರ‍್ಹಯಲವಾಲಾ ಉಪ್ಪರ ಹತ್ತ ಘಾಲ್ಯಾಮ ತೆ ರಗತನು ಪಾಪ ವ್ಹೈ ಅಪ್ನಾ ಮಾತಾನಾ ಉಪ್ಪರ ರ‍್ಹವಸ; <verse eid="JOS 2:19" /><verse number="20" style="v" sid="JOS 2:20" />ತೆ ನೈಸೊ ತು ಹಮಾರಾ ಸಂಗತಿಯೊನೆ ಭಾರಾ ಆವಾನಾಹುತಿ ಹಮೊಖ್ಹು ಕರಲ ಪ್ರಮಾಣಖ್ಹು ಬಿಡುಗಡೆ ಥಾವಸ ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 2:20" /><verse number="21" style="v" sid="JOS 2:21" />ತಿನಾಹುತಿ ತೆ ತುಮಾರಾ ವಾತನಿಂಗತ ಥಾವಾದೆ ಕೈನ ತ್ಯುನೊನೆ ವಳೈ; ತ್ಯುನೆ ಗಯಲ್ಪರ ತೆ ಲಾಲ ದೊರೊ ಕಿಡಕಿನೆ ಭಾಂದಿ. <verse eid="JOS 2:21" /><verse number="22" style="v" sid="JOS 2:22" />ತ್ಯುನೆ ತೆ ಪರ್ವತೆ ಗೈನ ಪಿಟ್ಟ ಲಗಾಡಿನ ಪಾಚಾ ರ‍್ಹೆಲಕ್ಕಾ ತನ್ನ ದಿನ ತ್ಯಾಜ ವ್ಹತ್ತಾ. ಪಿಟ್ಟ ಲಗಾಡಿನ ತ್ಯುನೆ ತ್ಯುನೊನೆ ವಾಟನಾ ಯುದ್ದನೆ ಹುಡಕಿನ ದೆಕಿನ ಗೈಪಡ್ಯಾ. <verse eid="JOS 2:22" /><verse number="23" style="v" sid="JOS 2:23" />ತೆಳಾಮ ತ್ಯುನೆ ಬೆಜನಾ ಡೊಂಗರಪರ್ತಾ ಉತ್ರಿನ ತಳು ದಾಟಿನ ನೂನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹುಶುವಾ ಕನ ಐನ ತ್ಯುನೊನೆ ಅನಸಾಯಲ ತಿಳಶ್ಯಾ. <verse eid="JOS 2:23" /><verse number="24" style="v" sid="JOS 2:24" />ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು ಹಮೊನೆ ದಿದ್ಯೊಸ; ತಿನಾ ನಿವಾಸಿಯೊ ಕ್ಹಾರಾ ಹಮಾರಾ ನಿಮಿತ್ತ ಕಂಗಟ್ಟನಿ ಗಯಾಸ ಕೈನ ತಿಳಶ್ಯಾ.<verse eid="JOS 2:24" /></para>
  <chapter eid="JOS 2" />
  <chapter number="3" style="c" sid="JOS 3" />
  <para style="s">ಇಸ್ರೆಲನಾ ಮನಕ್ಹೊ ಯೊರ್ದನ ನದಿ ದಾಟಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 3:1" />ಯೆಹೊಶುವಾ ಪಾಟೆ ಉಟ್ಯೊ; ತೆ ಇಸ್ರಾಯಲೊ ಕ್ಹಾರಾ ಶಿಟ್ಟಿಮ ಛೊಡಿನ ಯೊರ್ದನನೆ ಐನ ತೆ ದಾಟಾತಿ ಪೈಲಾಜ ತ್ಯಾ ಉತ್ರ್ಯಾ. <verse eid="JOS 3:1" /><verse number="2" style="v" sid="JOS 3:2" />ತನ್ನ ದಿನಪರ ಜನಾದಿಪತಿಯೊ ಪಾಳೆನಾ ಕ್ಹಾರಾ ಜ಼ಗಾಯೆ ಗೈನ ಮನಕ್ಹೊನೆ <verse eid="JOS 3:2" /><verse number="3" style="v" sid="JOS 3:3" />ಯಾಜಕ ರ‍್ಹಯೆಲ ಲೆವಿಯೊ ತುಮಾರೊ ಕ್ಹುದಾ ರ‍್ಹಯೆಲ ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷ ಉಚೈಲಿದಲ ದೆಕೆಲ್ಪರ ತುಮೆ ತುಮಾರಿ ಜ಼ಗಾ ಛೊಡಿನ ತಿನಾ ಪಾಚಾ ಜಾವೊ. <verse eid="JOS 3:3" /><verse number="4" style="v" sid="JOS 3:4" />ತೆಳಾಮಾ ತುಮೊನೆ ವರಿ ಮಂಜುಷನೆ ಬೆ ಹಜಾರ ಉಂಡು ದುರ ರ‍್ಹವೊ; ಕ್ಹಾಮಾ ಜೌನೈ.ಅಮ್ಮಜ ತುಮೆ ಗಯಲ ವಾಟ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ; ತೆ ವಾಟಮಾ ತುಮೆ ಪೈಲಾಜ ಕಾ ಆಯಾ ನೈ ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 3:4" /><verse number="5" style="v" sid="JOS 3:5" />ತೆ ನೈಸೊ ಯೆಹೊಶುವಾ ಮನಕ್ಹೊನೆ ತುಮೊನೆ ಶುದ್ದ ಕರಲಿವೊ; ಯಹೊವಾ ವಂತಾ ತುಮಾರಾ ವಚ್ಮಾ ಅಬ್ದುತವೊ ಕರಸ ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 3:5" /><verse number="6" style="v" sid="JOS 3:6" />ವರಿ ಯಾಜಕೊನೆ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚೈಲಿನ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮಾ ಚಾಲಿನ ತಳು ದಾಟೊ ಕೈನ ಆಜ್ಞೆಕರಿನ ತ್ಯುನೆ ತೆ ಮಂಜುಷನೆ ಉಚೈಲಿನ ತ್ಯುನಾ ಕ್ಹಾಮಾತಾ ಗಯಾ. <verse eid="JOS 3:6" /><verse number="7" style="v" sid="JOS 3:7" />ತೆಳಾಮಾ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಮಿ ಹಮ್ನಾತೊಜ ತುನೆ ಕ್ಹಾರಾ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾಮೊ ಘನಪಡಸುಸ; ಮಿ ಮೊಶೆನಾ ಕ್ಹಾತೆ ರ‍್ಹಯೆಲ ನಿಂಗತ ತಾರಾ ಕ್ಹಾತೆಬಿ ರ‍್ಹವೊಸ ಕೈನ ತ್ಯುನೆನೆ ಗೊತ್ತ ಥಾವಾಸ. <verse eid="JOS 3:7" /><verse number="8" style="v" sid="JOS 3:8" />ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕರೊ ಯೊರ್ದನ ತಳಾನಾ ಅಂಚೆನೆ ಆಯಲ್ಪರ ತ್ಯಾಜ ಹುಬ್ರೆ ಕೈನ ಆಜ್ಞಾಕರಿನ ಕದ್ಯೊ. <verse eid="JOS 3:8" /><verse number="9" style="v" sid="JOS 3:9" />ತೆಳಾಮಾ ಯೆಹುಶುವಾ ಇಸ್ರಾಯಲೊನೆ ನ್ಯಾ ಐನ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ವಾತೊ ಐಕೊ ಕೈನ <verse eid="JOS 3:9" /><verse number="10" style="v" sid="JOS 3:10" />ಚೈತನ್ಯ ಸ್ವರುಪ ಥಯಲ ಕ್ಹುದಾ ತುಮಾರಾ ವಚ್ಮಾ ರ‍್ಹವಸ ಕೈನ ತೆ ಕಾನಾನ್ಯರೊ, ಹಿತ್ತಿಯರೊ, ಹಿವ್ವಿಯರೊ, ಪೆರಿಜೀಯರೊ, ಗಿರ್ಗಾಷಿಯರೊ,ಅಮೊರಿಯರೊ, ಯೆಬುಸಿಯರೊ, ಆ ಕ್ಹಾರಾವೊನೆ ತುಮಾರಾ ಕ್ಹಾಮಾ ಚುಕೆವಾಚಿ ಭಾರಾ ಗಯೆವಾಚಿ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ ಕಿಮ ಕದ್ಯಾರೆ <verse eid="JOS 3:10" /><verse number="11" style="v" sid="JOS 3:11" />ಸರ್ವ ಲೊಕನಾ ಒಡೆಯಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ತುಮಾರಾ ಕ್ಹಾಮಾ ಗೈನ ಯೊರ್ದನಮಾ ಉತ್ರಾನು. <verse eid="JOS 3:11" /><verse number="12" style="v" sid="JOS 3:12" />ತುಮೆ ಥೈತಬಿ ಇಸ್ರಾಯೆಲ ಜಾತಾ ಜಾತೆ ಯಕ್ಲಾ ನಿಂಗತ ಬಾರಾ ಜನಾವೊನೆ ಇನಿಲಿವೊ. <verse eid="JOS 3:12" /><verse number="13" style="v" sid="JOS 3:13" />ಸರ್ವಲೊಕನಾ ಒಡೆಯಾ ಥಯಲ ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚೈಲಿವಾಲಾ ಯಾಜಕೊ ತ್ಯುನಾ ಪಗೊನೆ ಯೊರ್ದಾನಾ ತಳಾನಾ ಪಾನಿಮಾ ಮ್ಹೆಲ್ತಾಮಾ ಉಪ್ಪರತು ಆವಾನು ಪಾನಿ ಕ್ಹಾಮು ಗಯೆವಾಚಿ ತ್ಯಾಜ ರಾಶಿ ಥೈನ ಹುಬ್ರೆಯೊಸ ಕೈನ ತಿಳಸ್ಯೊ. <verse eid="JOS 3:13" /><verse number="14" style="v" sid="JOS 3:14" />ಮನಕ್ಹೊ ಯೊರ್ದಾನ ತಳು ದಾಟಾನಾಹುತಿ ತ್ಯುನಾ ಡೆರೊ ಕಿತ್ತಿಲಿನ ಗೈ ಪಡ್ಯಾ.ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ತ್ಯುನಾ ಕ್ಹಾಮಾ ವ್ಹತ್ತಾ. <verse eid="JOS 3:14" /><verse number="15" style="v" sid="JOS 3:15" />ಮಂಜುಷ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನೆ ಐನ ಪಾನಿಮಾ ತ್ಯುನಾ ಪಗೊನೆ ಅದ್ದುತಲೆ ಸುಗ್ಗಿನಾ ದಿನೊಮಾ ದಡಮಿರಿ ವ್ಹೈನ ಜಾವಾನು ಯೊರ್ದನ ತಳಾನು ಪಾನಿ ಹುಬ್ರೈ ಗಯು. <verse eid="JOS 3:15" /><verse number="16" style="v" sid="JOS 3:16" />ಉಪ್ಪರತು ಆವಾನು ಪಾನಿ ಘನ್ನು ದುರ ರ‍್ಹಯಲ ಚಾರೆತಾನಿನಾ ಕ್ಹಾಮು ರ‍್ಹವಾನು ಆದಾಮನಾ ಗಾಮಲಕ್ಕಾ ರಾಶಿ ಥೈನ ಹುಬ್ರಯುತು.ಹೆಟು ರ‍್ಹಯಲ ಪಾನಿ ಅರಾಬಾ ಕ್ಹಾಡಿಮಾ ರ‍್ಹವಾನು ಲವಣ ಸಮಂದರನೆ ವ್ಹೈನ ಗಯು. ಮನಕ್ಹೊ ಯರಿಕೊನಾ ಕ್ಹಾಮಾ ತಳು ದಾಟ್ಯಾ. <verse eid="JOS 3:16" /><verse number="17" style="v" sid="JOS 3:17" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ ಹುಬ್ರೈಯಾತಾ. ತೆಕ್ಲಾಮಾಜ ಇಸ್ರಾಯಲೊ ಕ್ಹಾರಾ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ ಚಾಲಿನ ಗಯಾ.ತೆ ಪ್ರಕಾರ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಯೊರ್ದನನೆ ಹಿಂಗೆ ಗಯಾ.<verse eid="JOS 3:17" /></para>
  <chapter eid="JOS 3" />
  <chapter number="4" style="c" sid="JOS 4" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 4:1" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಯೊರ್ದನನಾ ದಾಟಿನ ಗಯಲ್ಪರ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ <verse eid="JOS 4:1" /><verse number="2" style="v" sid="JOS 4:2" />ಯೊರ್ದನನಾ ವಚ್ಮಾ ಯಾಜಕರೊ ಹುಬ್ರೆಲ ಜ಼ಗಾಕಂತಾ ಬಾರಾ ದಗ್ಡಾ ಉಚೈನ <verse eid="JOS 4:2" /><verse number="3" style="v" sid="JOS 4:3" />ತೆ ದಗ್ಡಾವೊನೆ ತುಮಾರಾ ಕ್ಹಾತೆ ಆ ಜ಼ಗಾಕನ ಲೈನ ತುಮೆ ಆ ರಾತೆ ಉತ್ರಾನಿ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡೊ ಕೈನ ಆಜ್ಞಾಕರು ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 4:3" /><verse number="4" style="v" sid="JOS 4:4" />ತೆಳಾಮಾ ಯೆಹುಶುವಾ ತೆ ಇಸ್ರಾಯಲಮಾತೊ ಕುಲತಾ ಯಕ್ಲಾ ನಿಂಗತ ಇನಿಲಿದಲ ಬಾರಾ ಜನಾ ಮನಕ್ಹೊನೆ ಬಲೈನ ತ್ಯುನೊನೆ <verse eid="JOS 4:4" /><verse number="5" style="v" sid="JOS 4:5" />ತುಮೆ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಪೈಲಾಜ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಗೈನ ಇಸ್ರಾಯೆಲ ಕುಲನಾ ನಂಬರನೆ ಕರೆಟ್ಟ ಥೌ ಕೈನ ಹರಯಕ್ಲೊ ಯಕ್ಕ ಯಕ್ಕ ದಗ್ಡೊ ಕ್ಹಾಂದಾಪರ ಉಚೈಲಿನ ಆವೊ. <verse eid="JOS 4:5" /><verse number="6" style="v" sid="JOS 4:6" />ತೆ ತುಮಾರಾ ವಚ್ಮಾ ವಳಕ ಥಾವಸ ಅಗಲ್ಯಾ ಕಾಲಮಾ ತುಮಾರಾ ಬಚ್ಚಾ ತೆ ದಗ್ಡಾ ಸು ಸುಚಿತ ಕರಸ ತುಮೊನೆ ಪುಚ್ಚ್ತಾಮಾ ತುಮೆ ತ್ಯುನೊನೆ <verse eid="JOS 4:6" /><verse number="7" style="v" sid="JOS 4:7" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನಾ ಯೊರ್ದನ ದಾಟತಾಮಾ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈಪಡ್ಯುತು ಕೈನ ಕವೊ.ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈ ಪಡ್ಯುತು ಕೈನ ಆ ದಗ್ಡಾ ಇಸ್ರಾಯಲೊನೆ ಕೆಳಾಮಾಬಿ ಸಾಕ್ಷಿ ಥಾವಸ ಕದ್ಯೊ. <verse eid="JOS 4:7" /><verse number="8" style="v" sid="JOS 4:8" />ಇಸ್ರಾಯಲೊ ಯೆಹೊಶುವಾ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಕರ‍್ಯಾ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಕದಲ ನಿಂಗತ ತ್ಯುನೆ ಇಸ್ರಾಯಲನಾ ಕುಲ ನಂಬರನಾ ನಿಂಗತ ಯೊರ್ದನನಾ ವಚ್ಮಾತಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಉಚೈನ ತ್ಯುನೆ ಉತ್ರಾನ ಜ಼ಗಾಕನ ಲೈನ ತ್ಯಾ ಹುಬ್ರಾಡ್ಯಾ. <verse eid="JOS 4:8" /><verse number="9" style="v" sid="JOS 4:9" />ತೆ ನೈಸೊ ಯೆಹುಶುವಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಲಿನ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊ ಹುಬ್ರೈಯಲ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡ್ಯಾ.ತೆ ಹಮ್ನಾತಾ ತ್ಯಾಜ ರ‍್ಹವಸ. <verse eid="JOS 4:9" /><verse number="10" style="v" sid="JOS 4:10" />ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಯೆಹುಶುವಾ ಮನಕ್ಹೊನೆ ತಿಳಸಲ ಯಹೊವಾನಾ ಅಪ್ಪಣೆ ಕ್ಹಾರಾ ತ್ಯುನೆ ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಹುಬ್ರೈಯಾ.ಮನಕ್ಹೊ ಭೆಗಿನ ತಳು ದಾಟ್ಯಾ. <verse eid="JOS 4:10" /><verse number="11" style="v" sid="JOS 4:11" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ತ್ಯಾ ಗಯಲ್ಪರ ಯಾಜಕೊ ಯಹೊವಾನಾ ಮಂಜುಷ ಕ್ಹರಿ ಥೈನ ದಾಟಿನ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮಾ ಗಯಾ. <verse eid="JOS 4:11" /><verse number="12" style="v" sid="JOS 4:12" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಯುದ್ಧ ಸಿದ್ಧ ಥೈನ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾಮಾತಾ ಗೈನ ತಳು ದಾಟಿಪಡ್ಯಾ. <verse eid="JOS 4:12" /><verse number="13" style="v" sid="JOS 4:13" />ತ್ಯುನೆ ಸುಮಾರ ಚಾಳಕ್ಹ ಹಜಾರ ಭಟ ಥೈನ ಯುದ್ಧ ಕರಾನಾಹುತಿ ಯಹೊವಾನಾ ಕ್ಹಾಮಾ ಯರಿಕೊನಾ ಬೈಲನೆ ಆಯಾ. <verse eid="JOS 4:13" /><verse number="14" style="v" sid="JOS 4:14" />ತೆ ದಿನ್ನೆ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾರಾ ನಜರಮಾ ಘನ ಪಡಸಲಕ್ಹು ಮೊಶೆಮಾ ಕಿಮ್ಮ ತಿಮ್ಮಜ ಅನಾಮಾಬಿ ಇನಾ ಜಿವಕ್ಹು ದಿನಕ್ಹಾರೊ ಭಯ ಭಕ್ತಿವಾಲಾ ವ್ಹತ್ತಾ. <verse eid="JOS 4:14" /><verse number="15" style="v" sid="JOS 4:15" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 4:15" /><verse number="16" style="v" sid="JOS 4:16" />ಯೊರ್ದನತಾ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕವಾನೆ <verse eid="JOS 4:16" /><verse number="17" style="v" sid="JOS 4:17" />ತೆ ತೆ ಯಾಜಕೊನೆ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕದ್ಯೊ. <verse eid="JOS 4:17" /><verse number="18" style="v" sid="JOS 4:18" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ಯೊರ್ದನತಾ ಉಪ್ಪರ ಐನ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ ತ್ಯುನಾ ಪಗೊ ಮ್ಹೆಲೆಲ್ಪರ ಪಾನಿ ಪೈಲಾತುಜ ಐನ ಯೊರ್ದನನು ತಳು ಭರಿನ ವ್ಹೈನ ಚಾಲ್ಯುತು. <verse eid="JOS 4:18" /><verse number="19" style="v" sid="JOS 4:19" />ಮನಕ್ಹೊ ಯಕವಾ ಮ್ಹೈನಾನಾ ದಕ್ಹವಾ ದಿನಮಾ ಯೊರ್ದನ ದಾಟಿನ ಯೆರಿಕೊನಾ ಪೂರ್ವ ಪ್ರಾಂತ್ಯಮಾ ರ‍್ಹವಾನು ಗಿಲ್ಗಾಲ ಕವಾನಾ ಗಾಮಾ ಉತ್ರ್ಯಾ. <verse eid="JOS 4:19" /><verse number="20" style="v" sid="JOS 4:20" />ಯೆಹುಶುವಾ ಯೊರ್ದನತೊ ಲಿನ ಆಯಲ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಗಿಲ್ಗಾಲಮಾ ಹುಬ್ರಾಡಿನ ಇಸ್ರಾಯಲೊನೆ <verse eid="JOS 4:20" /><verse number="21" style="v" sid="JOS 4:21" />ಅಗಲ್ಯಾ ಕಾಲಮಾ ತುಮಾರಾ ಬಚ್ಚಾ ಆ ದಗ್ಡಾವೊನೆ ಕಾ ಹುಬ್ರಾಡ್ಯಾಸ ಕದ್ಯಾಮ ತುಮೊನೆ ಪುಚ್ಯಾಮ ತುಮೆ ತ್ಯುನೊನೆ <verse eid="JOS 4:21" /><verse number="22" style="v" sid="JOS 4:22" />ಇಸ್ರಾಯಲೊ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ ಥಯಲ ಆ ಯೊರ್ದನ ದಾಟಿನ ಆಯಲಕ್ಹು ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 4:22" /><verse number="23" style="v" sid="JOS 4:23" />ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ ನಂಗತ ಹಮ್ನಾ ಅಪೊನಾ ಕ್ಹಾಮಾ ಆ ಯೊರ್ದನೆ ಬತ್ತಿನ ತುಮೊನೆ ದಟಾಡ್ಯೊಸ. <verse eid="JOS 4:23" /><verse number="24" style="v" sid="JOS 4:24" />ಇನಾಹುತಿ ಭುಲೊಕನಾ ಕ್ಹಾರಾ ಯಹೊವಾನಾ ಹಸ್ತ ಪರಾಕ್ರಮ ವ್ಹೈಕೈನ ತಿಳ್ದಿಲಿವಸ ತುಮಾರಾ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಕೆಳಾಮಾಬಿ ಬುಚ್ಕಾಲಾ ವ್ಹೈ ಕದ್ಯೊ.<verse eid="JOS 4:24" /></para>
  <chapter eid="JOS 4" />
  <chapter number="5" style="c" sid="JOS 5" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 5:1" />ಯೊರ್ದನನಾ ಪಶ್ಚಿಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಅಮೊರಿನಾ ರಾಜಾ ಸಮಂದರನಾ ಬಾಜು಼ಮಾ ರ‍್ಹಯಲ ಸರ್ವ ಕಾನಾನನಾ ರಾಜಾವೊ ಯಹೊವಾನಾ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾಮಾ ಯೊರ್ದನೆ ಬತ್ತಿನ ತ್ಯುನೊನೆ ದಟಾಡ್ಯೊಸ ಕೈನ ಪುಚ್ತಾಮಾ ತ್ಯುನಿ ಛಾತಿ ಫುಟಿಗಯಿ. ಇಸ್ರಾಯೆಲನಾ ನಿಮಿತ್ತಕ್ಹು ತ್ಯುನೊನೆ ಧೈರ್ಯ ನೈಸೊ ಥಯು.<verse eid="JOS 5:1" /></para>
  <para style="s">ಗಿಲ್ಗಾನಮಾ ಖತ್ನಾ</para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 5:2" />ತೆ ಟೈಮಾ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ <verse eid="JOS 5:2" /><verse number="3" style="v" sid="JOS 5:3" />ತು ದಗ್ಡಾವೊನಾ ಚಾಕುವೊ ಕರಲಿನ ಇಸ್ರಾಯೆಲಮಾ ಫರಿನ ಕ್ಹತ್ನಾ ಕರು ಕೈನ ಕವಾನು ತೆ ದಗ್ಡಾವೊನಾ ಚಾಕುವೊ ಕರಲಿನ ಕ್ಹತ್ನಾ ಡೊಂಗರಪರ ಇಸ್ರಾಯಲೊನೆ ಖತ್ನಾ ಕರ‍್ಯೊ. <verse eid="JOS 5:3" /><verse number="4" style="v" sid="JOS 5:4" />ಯೆಹುಶುವಾ ಖತ್ನಾ ಕರಲ ಕಾರಣ ಸುವೈ ಕದ್ಯಾಮ ಐಗುಪ್ತತಾ ಆಯಲ ದಾಣ್ಗಾಮಾ ಯುದ್ಧವಿರೊ ಕ್ಹಾರಾ ತೆ ದೆಶ ಛೊಡಲ್ಪರ ಜಂಗಲಮಾ ಮರಿಗಯಾ.ತ್ಯಾತಾ ಆಯಲ ಮನಕ್ಹೊನೆ ಕ್ಹಾರಾ ಖತ್ನಾ ಕರಲ ವ್ಹತ್ತು. <verse eid="JOS 5:4" /><verse number="5" style="v" sid="JOS 5:5" />ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಭಾರಾ ಆಯಲ ಮನಕ್ಹೊನೆ ಖತ್ನಾ ಥಯುತು. ಐಗುಪ್ತತಾ ಜಂಗಲನಾ ಹುಟ್ಟಲವಾವೊನೆ ಖತ್ನಾ ಥಯು ನ್ಹೊತು. <verse eid="JOS 5:5" /><verse number="6" style="v" sid="JOS 5:6" />ಐಗುಪ್ತತಾ ಆಯಲ ಇಸ್ರಾಯಲೊ ಯಹೊವಾನಿ ವಾತ ನೈ ಐಕಲಕ್ಹು ತ್ಯುನೆ ತ್ಯುನಾ ಭಟೊಕ್ಹಾರಾ ಸಂಹಾರ ಥಾಯೆಲಕ್ಕಾ ಚಾಳಕ್ಹ ವರಕ್ಹ ಜಂಗಲಮಾಜಾ ಮರಿಗಯಾ. ಯಹೊವಾ ತೆ ತ್ಯುನಾ ಪಿತೃವೊನೆ ವಾಗ್ದಾನ ಕರಲ ದುದ್ದ ವರಿ ಜೇನ ವ್ಹೈನ ಜಾವಾನು ದೆಶಮಾ ತ್ಯುನೊನೆ ಚು಼ವಾತೊ ನೈಕೈನ ಕ್ಹಮ ಘಾಲ್ಯೊ. <verse eid="JOS 5:6" /><verse number="7" style="v" sid="JOS 5:7" />ತ್ಯುನೊನೆ ಯಕ್ಕಥೈನ ಹುಟ್ಟಲ ತ್ಯುನಾ ಬಚ್ಚಾವೊನೆ ಯೆಹುಶುವಾ ಖತ್ನಾ ಕರ‍್ಯೊ.ವಾಟಮಾ ತ್ಯುನೊನೆ ಖತ್ನಾ ನೈಕರಲಕ್ಹು ತ್ಯುನೆ ಖತ್ನಾ ನೈಕರಲವಾಲಾ ವ್ಹತ್ತಾ. <verse eid="JOS 5:7" /><verse number="8" style="v" sid="JOS 5:8" />ಕ್ಹಾರಾ ಜನಾಂಗವಾಲಾ ಖತ್ನಾ ಥಯಲ್ಪರ ತ್ಯುನೆ ರ್‍ಹಯೆಲಕ್ಕಾ ತ್ಯುನಾ ತ್ಯುನಾ ಜ಼ಗಾವೊಮಾ ಪಾಳೆಯಮಾ ವ್ಹತ್ತಾ. <verse eid="JOS 5:8" /><verse number="9" style="v" sid="JOS 5:9" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಮಿ ಐಗುಪ್ತನಾ ನಿಂದೆನೆ ಆ ಟೈಮಾ ತುಮಾರಾಕ್ಹು ನಿವಾರಿನ ಕರಕ್ಹು ಕದಲಕ್ಹು ತೆ ಜ಼ಗಾನೆ ಹಮ್ನಾಲಕ್ಕಾ ಗಿಲ್ಗಾಲ ಕೈನ ನಾಮ ರ‍್ಹವಸ. <verse eid="JOS 5:9" /><verse number="10" style="v" sid="JOS 5:10" />ಇಸ್ರಾಯಲೊ ಗಿಲ್ಗಾಲಮಾ ಉತ್ರಲ್ಪರ ಪೈಲಾನಾ ಮ್ಹನಾನಾ ಚೌದವಾ ದಿನೆ ಕ್ಹಾಂಜೆ ಯೆರಿಕೊನಾ ಬೈಲಮಾ ಪಸ್ಕ ಸನ್ನನೆ ಕರಿನ ಅಗಲ್ಯಾ ದಿನತಾ ಧಾನ್ಯನೆ ಕ್ಹಾವಾನೆ ಉಪಯೊಗ ಕರ‍್ಯಾ. <verse eid="JOS 5:10" /><verse number="11" style="v" sid="JOS 5:11" />ಕಿಮ್ಮ ಕದ್ಯಾರೆ ತೆಜ ದಿನಮಾ ತ್ಯುನೆ ಕ್ಹಾಟು ನೈರ‍್ಹಯಲ ರೊಕ್ಲಾವೊನೆ ಬಾಳಲ ತುದಿಯೊನೆ ಕ್ಹಾದ್ಯಾ. <verse eid="JOS 5:11" /><verse number="12" style="v" sid="JOS 5:12" />ತೆ ದೆಶನಾ ಹುಟ್ಟಲ ವಳಿನೆ ಕ್ಹಾದಲ್ಪರ ಅಗಲ್ಯಾ ದಿನ್ನೆ ಮನ್ನ ಹುಬ್ರಗಯು.ತೆ ತ್ಯುನೊನೆ ಫರಿನ ಮಳ್ಯೂಜ ನೈ. ಇಸ್ರಾಯಲೊ ತೆ ವರಕ್ಹಮಾ ಕ್ಹಾರಾ ಕಾನಾನ ದೆಶನಾ ಉತ್ಪನನೊನೆ ಅನುಭವ ಕರಾಡಾತಾ.<verse eid="JOS 5:12" /></para>
  <para style="s">ಯೆಹುಶವಾ ವರಿ ತಲ್ವಾರ ಧರಿಲಿದಲ ಯಕ್ಕ ಮನಕ್ಹ</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 5:13" />ಯೆಹುಶುವಾ ಯೆರಿಕೊನಾ ಕ್ಹಾಮಾ ರ‍್ಹತಾಮಾ ಯಕ್ಕಾನ ಯಕ್ಕ ದಿನೆ ಡೊಳೊ ಉಚೈನ ದೆಕ್ತಾಮಾ ಯಕ್ಲೊ ಮನಕ್ಹ ಹಿರಲ ಗದ್ಡಾನೆ ಹತ್ಮಾ ಧರಿನ ತಿನಾ ಕ್ಹಾಮು ಹುಬ್ರಯಲ ದೆಕ್ಯೊ. ತೆ ತಿಕನ ಗೈನ ತು ಹಮಾರೊ ವ್ಹೈ ನೈತೊ ಶತ್ರುವೊನೊ ವ್ಹೈ ಕೈನ ಪುಚ್ತಾಮಾ ತೆ ಮನಕ್ಹ <verse eid="JOS 5:13" /><verse number="14" style="v" sid="JOS 5:14" />ಮಿ ಥ್ಯವೊ ನವೈ; ಯಹೊವಾನಾ ಸೆನಾಪತಿ ಹಮ್ನಾಜ ಆಯೊಸ ಕದ್ಯೊ.ತೆಳಾಮಾ ಯೆಹುಶುವಾ ತಿನೆ ಸಾಷ್ಟಾಂಗ ನಮಸ್ಕಾರ ಕರಿನ ಸ್ವಾಮಿಯೊ ತಿನಾ ಸೆವಕನೆ ಸು ಆಜ್ಞಾಕರು ಕದ್ಯೊಸ ಯಹೊವಾನಾ ಸೆನಾಪತಿ <verse eid="JOS 5:14" /><verse number="15" style="v" sid="JOS 5:15" />ತಾರಾ ಪಗೊತಾ ಚಪ್ಲೊ ಕಾಡಿಪಡ ತು ಹುಬ್ರಯಲ ಜ಼ಗಾ ಪರಿಶುದ್ಧ ವ್ಹೈ ಕೈನ ಯೆಹುಶುವಾನೆ ಕದ್ಯೊ.ತೆ ತಿಮ್ಮಜ ಕರ‍್ಯೊ.<verse eid="JOS 5:15" /></para>
  <chapter eid="JOS 5" />
  <chapter number="6" style="c" sid="JOS 6" />
  <para style="s">ಯೆರಿಕೊ ಪಡಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 6:1" />ಯೆರಿಕೊನಾ ಇಸ್ರಾಯಲೊನೆ ಬುಚ್ಕಿನ ತ್ಯುನಾ ಗಾಮನಾ ಬಾಕಲೊನೆ ಘಟ್ಟ ಘಾಲಿಪಡ್ಯಾ.ಕುನ್ನಜ ಮ್ಹೈ ಗಯಾ ನೈ ಭಾರಾ ಆಯಾನೈ <verse eid="JOS 6:1" /><verse number="2" style="v" sid="JOS 6:2" />ತೆಳಾಮಾ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ದೆಕ ಮಿ ಯೆರಿಕೊನೆ ತೆನಾ ರಾಜಾವೊನೆ ಯುದ್ದ ವಿರೊನೆ ತಾರಾ ಹತೆ ಒಪ್ಪಶೊಸ. <verse eid="JOS 6:2" /><verse number="3" style="v" sid="JOS 6:3" />ತುಮಾರಾ ಭಟ್ಟೊಕ್ಹಾರಾ ಛೆ ದಿನಲಕ್ಕಾ ಯಕ್ಕಸಲಾ ಗಾಮನೆ ಫರು. <verse eid="JOS 6:3" /><verse number="4" style="v" sid="JOS 6:4" />ಕ್ಹಾತ ಜನಾ ಯಾಜಕೊ ಶಿಂಗ್ಡಾವೊನೆ ಧರಲಿನ ಮಂಜುಷನಾ ಕ್ಹಾಮಾ ಚಾಲಾಂದೆ. ಕ್ಹಾತವಾ ದಿನ್ನೆ ತುಮೆ ಗಾಮನೆ ಕ್ಹಾತಸಲಾ ಸುತ್ತೊ; <verse eid="JOS 6:4" /><verse number="5" style="v" sid="JOS 6:5" />ಯಾಜಕೊ ಶಿಂಗ್ಡಾವೊನೆ ಫುಕ್ಯು. ತ್ಯುನೆ ಧಿರ್ಘ ಥೈನ ಫುಕ್ಕಾನೆ ಶಿಂಗ್ಡಾನೆ ಅವಾಜ ಐಕ್ತಾಮಾ ತುಮೆ ಕ್ಹಾರಾ ಮಹತ್ತ ಥೈನ ಆರ್ಭಟೊ ತೆಳಾಮಾ ಗಾಮನಿ ಗೊಡಿ ತೆಜ ಪಡಿಜಾ಼ವಸ ಹರಯಕ್ಲೊ ಸಿದಾ ಮ್ಹೈ ಜಾಸಕಸ ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 6:5" /><verse number="6" style="v" sid="JOS 6:6" />ತೆಳಾಮಾ ನೂನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹುಶುವಾ ಯಾಜಕೊನೆ ಬಲೈನ ತ್ಯುನೊನೆ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚೈಲಿನ ಜಾವೊ ಕ್ಹಾತ ಜನಾ ಯಾಜಕೊ ಶಿಂಗ್ಡಾವೊನೆ ಧರಲಿನ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಕ್ಹಾಮಾ ಜಾವಾದೆ ಕದ್ಯೊ. <verse eid="JOS 6:6" /><verse number="7" style="v" sid="JOS 6:7" />ವರಿ ತೆ ಮನಕ್ಹೊನೆ ಗೈನ ಗಾಮನೆ ಫರ‍್ಯೊ. ಯುದ್ಧ ಸನ್ನದ ಕ್ಹಾರಾ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಕ್ಹಾಮಾ ಜಾವಾದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 6:7" /><verse number="8" style="v" sid="JOS 6:8" />ಯೆಹುಶುವಶಾ ಆಜ್ಞಾಕರಲ ನಿಂಗತ ಕ್ಹಾತ ಜನಾ ಯಾಜಕೊ ಶಿಂಗ್ಡಾವೊನೆ ಧರಲಿನ ಫುಕತ್ತಾ ಯಹೊವಾನಾ ಕ್ಹಾಮಾ ಚಾಲ್ಯಾ. ಯಹೊವಾನಾ ಮಂಜುಷ ತ್ಯುನಾ ಪಾಚು ಗಯು. <verse eid="JOS 6:8" /><verse number="9" style="v" sid="JOS 6:9" />ಯುದ್ಧ ಸನ್ನದ ಥಯಲವಾಲಾ ಶಿಂಗ್ಡಾವೊನೆ ಫುಕತ್ತಾ ಯಾಜಕೊನಾ ಕ್ಹಾಮಾ ವ್ಹತ್ತಾ. ಪಾಚ಼ಲ್ಯೊ ದಳ ಮಂಜುಷನಾ ಪಾಚು ವ್ಹತ್ತು.ಶಿಂಗ್ಡಾವೊನೆ ಫುಕತಾ ಚಾ಼ಲ್ಯಾತಾ. <verse eid="JOS 6:9" /><verse number="10" style="v" sid="JOS 6:10" />ಯೆಹುಶುವಾ ಮನಕ್ಹೊನೆ ತುಮೆ ಹಮ್ನಾ ಆರ್ಬಟ ನೈ ಕರು; ತುಮಾರಿ ಅವಾಜ ಐಕುಕೈನ ತುಮಾರಾ ಮ್ಹೊಡಾಕ್ಹು ಯಕ್ಕ ವಾತ ತಬಿ ಔಕೈನ ಆರ್ಭಟೊ ಕೈನ ಮಿ ಕವಾನಾ ದಿನಮಾ ಮಾತ್ರ ಆರ್ಭಟೊ ಕೈನ ಆಜ್ಞೆ ಕರ‍್ಯೊ. <verse eid="JOS 6:10" /><verse number="11" style="v" sid="JOS 6:11" />ತೆ ಯಹೊವಾನಾ ಮಂಜುಷನೆ ಯಕ್ಕ ಸಲಾ ಗಾಮನೆ ಸುತ್ತಲ್ಪರ ತ್ಯುನೆ ಫರಿನ ಪಾಳೆಯೆ ಐನ ರಾತ ಕಾಟ್ಯಾ. <verse eid="JOS 6:11" /><verse number="12" style="v" sid="JOS 6:12" />ಯೆಹುಶುವಾ ಪಾಟೆ ಉಟ್ಯೊ.ಯಾಜಕೊ ಯಹೊವಾನಾ ಮಂಜುಷನೆ ಉಚೈಲಿನ ಚಾಲ್ಯಾ. <verse eid="JOS 6:12" /><verse number="13" style="v" sid="JOS 6:13" />ಕ್ಹಾತಜನಾ ಯಾಜಕೊ ಶಿಂಗ್ಡಾವಿನೆ ಫುಕತಾ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಕ್ಹಾಮಾ ಚಾಲ್ಯಾ. ಯುದ್ಧ ಸನ್ನದೊ ತ್ಯುನಾ ಕ್ಹಾಮಾ ವ್ಹತ್ತಾ; ಪಾಚಲ್ಯು ದಳ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಪಾಚು ವ್ಹತ್ತು. ಶಿಂಗ್ಡಾವೊನೆ ಫುಕ್ತಾಜಾ ಚಾ಼ಲ್ಯಾತಾ. <verse eid="JOS 6:13" /><verse number="14" style="v" sid="JOS 6:14" />ಅಮ್ಮಜ ಬೆವಾ ದಿನಮಾ ಗಾಮನೆ ಸುತ್ತಿನ ಪಾಳೆನೆ ಪಾಚಾ ಫರ್xಯಾ. ಛೆ ದಿನಲಕ್ಕಾಬಿ ಅಮ್ಮಜ ಕರ‍್ಯಾ. <verse eid="JOS 6:14" /><verse number="15" style="v" sid="JOS 6:15" />ಕ್ಹಾತವಾ ದಿನಮಾ ತುನೆ ಸರ್ಯೊಹುಟ್ಟಾತಿ ಪೈಲಾಜ ಉಟಿನ ತೆಜ ಕ್ರಮಮಾ ಗಾಮನೆ ಕ್ಹಾತಸಲಾ ಸುತ್ಯಾ.ತೆ ದಿನಮಾ ಯಕ್ಕಜ ತೆ ಕ್ಹಾತ ಸಲಾ ಸುತ್ಯಾ. <verse eid="JOS 6:15" /><verse number="16" style="v" sid="JOS 6:16" />ಕ್ಹಾತವಾ ಸಲಾ ಸುತ್ತತಾಮಾ ಯಾಜಕೊ ಶಿಂಗ್ಡಾವೊನೆ ಫುಕ್ಕಾನೆ ಯೆಹುಶುವಾ ಮನಕ್ಹೊನೆ ಆರ್ಭಟೊ ಯಹೊವಾ ತುಮೊನೆ ಆ ಗಾಮನೆ ದಿದ್ಯೊಸ. <verse eid="JOS 6:16" /><verse number="17" style="v" sid="JOS 6:17" />ಆ ಅಮಾರ‍್ಹವಾನು ಕ್ಹಾರು ಕೆವಲ ಯಹೊವಾನಾ ಸೊತ್ತ ಕೈನ ತಿಳದೊ. ರಾಂಡಿ ಥಯಲ ರಾಹಬಳ ತಿನಾ ಕ್ಹಾತೆ ಘರಮಾ ರ‍್ಹಯೆಲವಾಲಾ ಕ್ಹಾರಾ ಉಗ್ರಾಂದೆ ಮಿ ವಳಾಯಲ ದುತನೊ ತೆ ದಡೈನ ಮ್ಹೆಲಿಸತೊ. <verse eid="JOS 6:17" /><verse number="18" style="v" sid="JOS 6:18" />ತುಮೆ ಥಯಾತಬಿ ಯಹೊವಾನೆ ಮಿಸ ಥಯಲ ಸಾಮನೊನಾ ವಿಷಯಮಾ ಹುಶಾರಕ್ಹು ರ‍್ಹೌ.ತುಮೆ ತಿಮಾ ಕಿನೆಬಿ ಇನಿಲಿದ್ಯಾಮ ಇಸ್ರಾಯೆಲನಾ ಪಾಳೆನಾ ಶಾಪನೆ ಗುರಿಥೈನ ಕೆಟ್ಟಸ. <verse eid="JOS 6:18" /><verse number="19" style="v" sid="JOS 6:19" />ಬೈಲ ವರಿ ಬಕ್ರಾ ವರಿ ಗದ್ಡಾವೊನೆ ನಿಶ್ಶೆಯ ಥೈನ ಕ್ವತಾಕ್ಹು ಕತ್ರಿಪಡ್ಯಾ <verse eid="JOS 6:19" /><verse number="20" style="v" sid="JOS 6:20" />ತೆಳಾಮಾ ಮನಕ್ಹೊ ಆರ್ಬಟ ಶಿಂಗ್ಡಾವೊನೆ ಅವಾಜ ಐ. ಮನಕ್ಹೊ ಶಿಂಗ್ಡಾವೊನಿ ಅವಾಜ ಐಕಿನ ಮಹತ್ತ ಥೈನ ಆರ್ಭಟ ಕರ್ತಾಮಾ ಗಾಮನಿ ಗೊಡಿ ತಿನಿ ತೆಜ ಪಡಿಗಯಿ. ಹರಯಕ್ಲೊ ಸಿದಾಜ ಗಾಮಾ ಗೈ ಪಡ್ಯಾ.ತೆ ತ್ಯುನೊನೆ ಸ್ವಾಧಿನ ಥಯು. <verse eid="JOS 6:20" /><verse number="21" style="v" sid="JOS 6:21" />ತುನೆ ಗಾಮ್ಮಾ ರ‍್ಹಯಲ ದಾಣ್ಗಾವೊನೆ ಬಾಕ್ಡಿಯೊನೆ ಪಟ್ಟಾವೊನೆ ಗಡಿಯಾವೊನೆ ಬೈಲ ವರಿ ಬಕ್ರಾ ವರಿ ಗದ್ಡಾವೊನೆ ನಿಶ್ಶೆಯ ಥೈನ ಕ್ವತಾಕ್ಹು ಕತ್ರಿಪಡ್ಯಾ. <verse eid="JOS 6:21" /><verse number="22" style="v" sid="JOS 6:22" />ಯೆಹುಶುವಾ ದೆಶನೆ ಗಯಲ ದೆಕಲ ಬೆ ಮನಕ್ಹೊನೆ ತುಮೆ ತೆ ರಾಂಡಿನಾ ಘರೆ ಜಾವೊ ತಿನೆ ಪ್ರಮಾಣ ಕರಲನಂಗತ ತಿನೆ ತಿಕನ ರ‍್ಹವಾನು ಕ್ಹಾರು ಭಾರಾ ಲಿನ ಆವೊ <verse eid="JOS 6:22" /><verse number="23" style="v" sid="JOS 6:23" />ಕೈನ ಕವಾನು ತೆ ಜಾಂಜಿಮಾನ ಗೈನ ರಾಹಾಬಳನೆ ತಿನಾ ಮಾಬಾಪನೆ ಭಾಯೊನೆ ತಿನೆ ರ‍್ಹವಾನು ಕ್ಹಾರು ತಿನಾ ಕುಟುಂಬನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಲೈನ ಇಸ್ಆಯಲನಾ ಪಾಳೆನಾ ನಜಿಕ ಮ್ಹೆಲ್ಯಾ. <verse eid="JOS 6:23" /><verse number="24" style="v" sid="JOS 6:24" />ಇಸ್ರಾಯಲೊ ಗಾಮನೆ ತಿಮಾ ರ‍್ಹವಾನುಕ್ಹಾರು ಆಗಕ್ಹು ಬಾಳ್ಯಾ.ತೆ ನೈಸೊ ಕ್ಹೊನಾನೆ ವರಿ ರುಪ್ಪಾನೆ ತಾಂಬಾನಾ ವರಿ ಲ್ಹೊಡಾನಾ ಸಾಮನೊನೆ ಯಹೊವಾನಾ ಆಲಯನಾ ಭಂಡಾನೆ ದಿದ್ಯಾ. <verse eid="JOS 6:24" /><verse number="25" style="v" sid="JOS 6:25" />ರಾಂಡಿ ಥಯಲ ರಾಹಾಬಳ ಯೆರಿಕೊ ಗಾಮನೆ ಫರಿನ ದೆಕಾನಾಹುತಿ ಆಯಲ ಯೆಹುಶುವಾನಾ ದುತೊನೆ ದಡಾಯಲಕ್ಹು ತೆ ತಿನೆ ತಿನಾಬಾನಾ ಘರವಾಲಾವೊನೆ ತಿನೆ ರ‍್ಹವಾನು ಕ್ಹಾರು ವಚಾ಼ಡ್ಯೊ.ತೆ ಹಮ್ನಾಲಕ್ಕಾ ಇಸ್ರಾಯಲೊಮಾ ಛೆ. <verse eid="JOS 6:25" /><verse number="26" style="v" sid="JOS 6:26" />ತೆಜ ಟೈಮಾ ಯೆಹುಶುವಾ ಇಸ್ರಾಯಲೊಕ್ಹು ಪ್ರಮಾಣ ಕರಲ ತ್ಯುನೊನೆ ಆ ಯೆರಿಕೊ ಗಾಮನೆ ಭಾಂದಾನಾಹುತಿ ಹತ ಲಗಾಡಾನೊ ಮನಕ್ಹ ಯಹೊವಾನಾ ನಜರಮಾ ಶಾಪಗ್ರಸ್ತಥೌ. ಥ್ಯವೊ ತಿನೆ ಅಸ್ತಿವಾರ ಗ್ಹಾಲ್ತಾಮಾ ತಿನಾ ಮ್ಹೊಟಾ ದಿಕ್ರಾನೆ ಬಾಕಲೊಮ್ಹೆಲ್ತಾಮಾ ನ್ಹಾನಾ ದಿಕ್ರಾನೆ ಜವೈಲಿವಾದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 6:26" /><verse number="27" style="v" sid="JOS 6:27" />ಯಹೊವಾ ಯೆಹುಶುವಾನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲಕ್ಹು ತೆ ದೆಶಮಾ ಕ್ಹಾರಾ ಪಡ್ದಿಲಿದ್ಯೊ.<verse eid="JOS 6:27" /></para>
  <chapter eid="JOS 6" />
  <chapter number="7" style="c" sid="JOS 7" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 7:1" />ನುನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ ಗಾಮನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ವಳಾಯೊ. ಎ ಮನಕ್ಹೊನೆ ಯೆಹುಶುವಾ ವಳಾಯಲ ಸಂಗತಿ ಬಿಜು ಕಿನೆಜ ಗ್ವತ್ತ ನ್ಹೊತು ''ಗೈನ ತೆ ಯೆರಿಕೊ ಗಾಮನೆ ಘನ್ನ ಸುಕ್ಷ್ಮಕ್ಹು ದೆಕೊ” ಕೈನ ಯೆಹುಶುವಾ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಕದ್ಯೊ. ತೆ ಭಂಬಿ ಜನಾ ಯೆರಿಕೊ ಗಾಮೆ ಗೈನ ಯಕ್ಕ ವ್ಯಶ್ಯಾನಾ ಘರಮಾ ರ‍್ಹಯಾ. ತೆ ಬಾಕಡಿನು ನಾಮ ‘ರಾಹಾಬ.’ <verse eid="JOS 7:1" /><verse number="2" style="v" sid="JOS 7:2" />ಯೆಹುಶುವಾ ಮನಕ್ಹೊನೆ ಬಲೈನ ತುಮೆ ಗಟ್ಟಾ ಚಡಿನ ಬೆತಲಿನಾ ಪೂರ್ವನೆ ಬೆತಾವೆನಾ ನಜಿಕಮಾಜ ಆಯಿ ಕವಾನಾ ಗಾಮಾನೆ ಸಂಚರಿಸಿನ ದೆಕ್ಯೊ ಕೈನ ತ್ಯುನೊನೆ ಯೆರಿಕೊತಾ ವಳಾಯಾ. ತ್ಯುನೆ ಗೈನ ಆಯಿ ಕವಾನಾ ಗಾಮಾನೆ ಸಂಚರಿನ ದೆಕಿನ <verse eid="JOS 7:2" /><verse number="3" style="v" sid="JOS 7:3" />ಪಾಚಾ ಫರಿನ ಐನ ಯೆಹುಶುವಾನೆ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಜಾವಾನು ಜ಼ರುರತ ನತ್ತಿ.ಬೆ ನೈತೊ ತನ್ನ ಹಜಾರ ಮನಕ್ಹೊ ಗಯಾಮ ಬಸ. ಗಾಮನೆ ಜಿತ್ತಸಕಸ ಕ್ಹಾರಾವೊನೆ ವಳೈನ ಕಾ ದಣದಾನು? ತ್ಯುನೆ ದಕ್ಹಾಜನಾ ಮಾತ್ರ ರ‍್ಹವಸ ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 7:3" /><verse number="4" style="v" sid="JOS 7:4" />ತಿನಾ ನಿಂಗತ ತನ್ನ ಹಜಾರ ಮನಕ್ಹೊ ಗಯಾ. ತ್ಯುನೆ ಆಯಿ ಕವಾನಾ ಗಾಮಾನಾ ಮನಕ್ಹೊನ ಕ್ಹಾಮಾತಾ ನ್ಹಾಟಿನ ಔ ಲಾಗ್ಯು. <verse eid="JOS 7:4" /><verse number="5" style="v" sid="JOS 7:5" />ಆಯಿ ಕವಾನಾ ಗಾಮವಾಲಾ ತ್ಯುನೊನೆ ಗಾಮನಾ ಬಾಕಲತಾ ಕಲ್ಲುಗಣಿಲಕ್ಕಾ ಪಾಚಾ ಮ್ಹೆಲಲ ಇಳಿ ಜಿಮಿನಮಾ ತ್ಯುನೊನೆ ಹರಾಡಿನ ಸುಮಾರ ಮುವತ್ತಪರ ಛೆ ಮನಕ್ಹೊನೆ ಹತ ಕರ‍್ಯಾ. ಇನಾಕ್ಹು ಇಸ್ರಾಯಲನಿ ಧರ್ಯ ಕರಗಿನ ಪಾನಿಥಯು. <verse eid="JOS 7:5" /><verse number="6" style="v" sid="JOS 7:6" />ತೆಳಾಮಾ ಯೆಹುಸುವಾ ಇಸ್ರಾಯಲನಾ ಮ್ಹೊಟಾ ತ್ಯುನಾ ವಣ್ಣಾ ಫಾಡಿಲಿನ ಮಾತಾಪರ ರಾಕ ಘಾಲ್ಲಿನ ಕ್ಹಾಂಜಲಕ್ಕಾ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಕ್ಹಾಮಾ ಐನ ಪಡಿಗಯಾ. ವರಿ ಯೆಹುಶುವಾ <verse eid="JOS 7:6" /><verse number="7" style="v" sid="JOS 7:7" />ಅಯ್ಯೊ ಕರ್ತಾ, ಯಹೊವಾ, ತು ಆ ಮನಕ್ಹೊನೆ ಯೊರ್ದನನು ನದಿ ಕಾ ದಟಾಡ್ಯೊ? ಹಮೊನೆ ಅಮೊರಿನಾ ಹತೊಮಾ ದಿನ ನಾಶಕರು ಕೈನ ಛೆ? ಹಮೆ ಅಕ್ಲುಜ ಬಸ ಕೈನ ಯೊರ್ದನ ತಳಾನಾ ಹಿಂಗೆಜ ರ‍್ಹಯಾಮಾ ಕೆಕ್ಲು ಚೊಕೊ ವ್ಹತ್ತು. <verse eid="JOS 7:7" /><verse number="8" style="v" sid="JOS 7:8" />ಕರ್ತಾ ಇಸ್ರಾಯಲೊ ಶತ್ರುವೊನೆ ಪಿಟ್ಟ ದೆಕಲಾಡ್ಯಾಸತೊ. ಹಜಿ ಸು ಕೌ? <verse eid="JOS 7:8" /><verse number="9" style="v" sid="JOS 7:9" />ಕಾನಾನ್ಯೊ ದೆಶನಾ ಬಿಜಾ ಕ್ಹಾರಾ ನಿವಾಸಿಯೊ ಆ ಐಕಿನ ಹಮೊನೆ ಸುತ್ತಿಲಿನ ಭುಲೊಕಮಾ ಅಪ್ನಾ ನಾಮೊ ಉಗ್ರಾಲಿಂಗತ ಕರಸ.ತಾರಾ ಮಹಾನಾಮನಾ ಹುತಿ ಸು ಕರಸಿ ಕದ್ಯೊ. <verse eid="JOS 7:9" /><verse number="10" style="v" sid="JOS 7:10" />ತೆಳಾಮಾ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಕದಲ ಸುವೈಕದಾಮ ಉಟ ತು ಆ ಪ್ರಕಾರ ಬೊರಲಪಡಲ ಕಾವೈ? <verse eid="JOS 7:10" /><verse number="11" style="v" sid="JOS 7:11" />ಇಸ್ರಾಯೆಲ ಮಾರಾ ವಾತಮಿರಿನ ಪಾಪಿಯೊ ಥಯಾಸ. ಉಪಯೊಗ ಕರಾನಾ ಸಮನೊ ಲಿನ ಚೊಟ್ಟಾಥೈನ ತ್ಯುನಾ ಸಾಮನೊಮಾ ದಡಲಿನ ವಂಚಕ ಥಯಾಸ. <verse eid="JOS 7:11" /><verse number="12" style="v" sid="JOS 7:12" />ತಿನಾಹುತಿ ಇಸ್ರಾಯಲೊ ಶತ್ರುವೊನಾ ಕ್ಹಾಮಾ ಹುಬ್ರಯ ನೈಸೊ ತ್ಯುನೊನೆ ಪಟ್ಟ ದೆಕಲಾಡಸ.ತ್ಯುನೆ ಪಾಪಕರಲವಾಲಾ ಶಾಪ ಕಾರಣ ಥಯಲ ತುಮಾರಾ ವಚ್ಮಾತೊ ಕಾಡೆಲಕ್ಕಾ ಮಿ ತುಮಾರಾ ಕ್ಹಾತೆ ನೈಆತೊ. <verse eid="JOS 7:12" /><verse number="13" style="v" sid="JOS 7:13" />ಉಟಿನ ಮನಕ್ಹೊನೆ ಶುದ್ದಕರ. ತು ತ್ಯುನೊನೆ ಇಸ್ರಾಯಲೊ ವಂತಾನಾಹುತಿ ಶುದ್ದ ಕರಲಿವೊ; ತುಮಾರಾ ವಚ್ಮಾ ಶಾಪನೆ ಕಾರಣ ಥಯಲಕ್ಹು. ತುಮೆ ತೆ ಕಾಡೆಲಕ್ಕಾ ಶತ್ರುವೊನಾ ಕ್ಹಾಮಾ ಹುಬ್ರೆತಾ ನೈ ಕೈನ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಕವಸ. <verse eid="JOS 7:13" /><verse number="14" style="v" sid="JOS 7:14" />ವಂತಾ ಪಾಟೆ ತುಮೆ ಗುಂಪ ಗುಂಪಥೈನ ಮಕನ ಆವೊ. ಯಹೊವಾ ಕಯಾ ಗುಂಪನೆ ಧರಸ ತೆ ಗುಂಪ ಗೊತ್ರ ಗೊತ್ರ ಥೈನ ಕಯಾ ಗೊತ್ರಾನೆ ಧರಸ ತೆ ಗೊತ್ರಾ ಕುಟುಂಬ ಕುಟುಂಬ ಥೈನ ಕಯಾ ಕುಟುಂಬನೆ ಧರಸ ತೆ ಕುಟುಂಬವಾಲಾ ಯಕ ಯಕ್ಲಾ ಥೈನ ಔ. <verse eid="JOS 7:14" /><verse number="15" style="v" sid="JOS 7:15" />ಕುನ್ನ ಉಪಯೊಗ ಕರಾನಾ ಸಾಮನೊನಾ ಕ್ಹಾತೆ ಧರೆಲವಾಲಾವೊನೆ ತೆ ಕ್ಹುದಾನಿ ವಾತ ದಾಟಿನ ಇಸ್ರಾಯಲ ಮನಕ್ಹೊಮಾ ಗ್ಯಾನ ನೈಸೊ ಕಾಮ ಕರಲಕ್ಹು ತಿನು ಕ್ಹಾರು ಆಸ್ತಿನಾ ಕ್ಹಾತೆ ತಿನೆ ಬಾಳು ಕೈನ ಕದಲ ಛೆ. <verse eid="JOS 7:15" /><verse number="16" style="v" sid="JOS 7:16" />ಯೆಹುಶುವಾ ಪಾಟೆ ಉಟಿನ ಇಸ್ರಾಯೆಲ ಗುಂಪ ಗುಂಪನೆ ಯಕ್ಕ ಯಕ್ಕ ಥೈನ ಛೊಡಾನೆ ಯೆಹುದ್ಯ ಗುಂಪನೆ ಧರ್ಯಾತಾ. <verse eid="JOS 7:16" /><verse number="17" style="v" sid="JOS 7:17" />ತಿನಾ ಗೊತ್ರನಾ ಬಲಾತಾಮಾ ಜೆರಹನಾ ಗೊತ್ರನೆ ಧರ್ಯಾತಾ. ತೆ ಗೊತ್ರಾ ಕುಟುಂಬುವೊನೆ ಬಲಾತಾಮಾ ಜಬ್ದಿನಾ ಕುಟುಂಬನೆ ಧರ್ಯಾತಾ. <verse eid="JOS 7:17" /><verse number="18" style="v" sid="JOS 7:18" />ತೆ ಕುಟಂಬನಾ ದಾಣ್ಗಾವೊನೆ ಬಲಾತಾಮಾ ಯೆಹುದ ಗುಂಪನೊ ಜೆರಹನಾ ಗೊತ್ರವಾಲೊ ಜಬ್ದಿನಾ ಕುಟಂಬನೊ ಕರ್ಮಿನೊ ದಿಕ್ರೊ ಥಯಲ ಆಕಾನನೆ ಧರ್ಯಾತಾ. <verse eid="JOS 7:18" /><verse number="19" style="v" sid="JOS 7:19" />ತೆಳಾಮ ಯೆಹುಶುವಾ ಆಕಾನನೆ ಮಾರ ದಿಕ್ರಾ ತು ಇಸ್ರಾಯಲನಾ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಘನಪಡಸೊ ತಿನೆ ಸ್ತೊತ್ರ ಕರ‍್ಯೊ. ತು ಕರಲ ಮನೆ ಕೆ, ಸುಜ ಝಾಕು ನಕೊ ಕದ್ಯೊ. <verse eid="JOS 7:19" /><verse number="20" style="v" sid="JOS 7:20" />ಆಕಾನನ ಯೆಹುಶುವಾನೆ ಮಿ ಕೊಳ್ಳೆಮಾ ಶಿನಾರ ದೆಶನಾ ಯಕ್ಕ ಚೊಕೊ ಥಯಲ ನಿಲ ವಂಗಿನೆ ಬೆಕ್ಹೊರಪ್ಯಾನು ತೊಲನು ರುಪ್ಪಾನೆ ಐವತ್ತರುಪ್ಯಾನು ಕ್ಹೊನಾನೊ ಘಟ್ಟೊ ದಿಕಿನ ತಿನೆ ಆಶಕ್ಹು ಕಾಳ್ಳದ್ಯಾ. ತಿನೆ ಮಾರಾ ಗುಡಾರನಾ ವಚ್ಮಾ ಕ್ಹಾಡಿಮಾ ಮ್ಹೆಲ್ಯೊಸ; ರುಪ್ಪು ಅಂಗ್ಡಾನಾ ಹೆಟು ರ‍್ಹವಸ. <verse eid="JOS 7:20" /><verse number="21" style="v" sid="JOS 7:21" />ಮಿ ಕ್ಹರಿಜ಼ ಹೌ ಕರಿನ ಇಸ್ರಾಯೆಲನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ವಿರುದ್ದ ಥೈನ ಪಾಪ ಕರ‍್ಯೊಸ ಕೈನ ಉತ್ತರ ದಿದ್ಯೊ. <verse eid="JOS 7:21" /><verse number="22" style="v" sid="JOS 7:22" />ತೆಳಾಮಾ ಯೆಹುಶುವಾ ಆಳೊನೆ ಮೊಕಲೈನ ತ್ಯುನೆ ನ್ಹಾಟಿನ ಗೈನ ದೆಕಿನ ತೆ ನಿಲ ವಂಗಿನಾ ಗುಡಾರಮಾ ಕ್ಹಾಡಿಮಾ ವ್ಹತ್ತು. ರುಪ್ಪು ತಿನಾ ಹೆಟು ವ್ಹತ್ತು. <verse eid="JOS 7:22" /><verse number="23" style="v" sid="JOS 7:23" />ತ್ಯುನೆ ತೆ ಸಮ್ನೊನೆ ಗುಡಾರಮಾತಾ ಲಿನ ಯೆಹುಶುವಾ ಕ್ಹಾರಾ ಇಸ್ರಾಯಲೊ ರ‍್ಹಯಲ ಜ಼ಗಾ ಐನ ಯಹೊವಾನಾ ಕ್ಹಾಮಾ ಮ್ಹೆಲ್ಯಾ. <verse eid="JOS 7:23" /><verse number="24" style="v" sid="JOS 7:24" />ವರಿ ಯೆಹುಶುವಾ ಕ್ಹಾರಾ ಇಸ್ರಾಯಲೊ ಜೆರಹನೊ ದಿಕ್ರೊ ಥಯಲ ಆಕಾನನೆ ತೆ ರುಪ್ಪು, ನಿಲವಂಗಿ ಕ್ಹೊನಾನೊ ಘಟ್ಟೊ ತಿನಾ ಗಂಡ ಹೆಣ್ಣ ಬಚ್ಚಾ ಬೈಲೊನಾ ಬಚ್ಚಾ, ಗದ್ಡಾವೊ ಬಕ್ರಾ ವರಿ ಬಕ್ರಿಯೊ,ಗುಡಾರನೆ ಆ ಕ್ಹಾರಾವೊನೆ ಸಹಿತ ಥೈನ ಧರಿನ ಆಕೊರಿನಾ ಕ್ಹಾಡಿನೆ ಲಿನ ಗಯಾ. <verse eid="JOS 7:24" /><verse number="25" style="v" sid="JOS 7:25" />ತ್ಯಾ ಯೆಹುಶುವಾ ತಿನೆ ತು ಹಮೊನೆ ಆಪತ್ತನೆ ಗುರಿ ಥಯಲ ಕಾವ್ಹೈ.ಆ ಟೈಮಾ ಯಹೊವಾ ತುಮಾರಾ ಉಪ್ಪರ ಆಪತ್ತ ಆವಾ ವರಕ್ಹು ಕರುಸ ಕೈನ ಕದಲ್ಪರ ಇಸ್ರಾಯೆಲೊ ಕ್ಹಾರಾ ತಿನೆ ದಗ್ಡೊ ಭಿರಕೈನ ಮಾರ್xಯಾ.ತಿನೆ ರ‍್ಹಯೆಲ ಕ್ಹಾರು ದಗ್ಡೊ ಭಿರಕೈನ ಆಗಕ್ಹು ಬಾಳಿ ಪಡ್ಯಾ. <verse eid="JOS 7:25" /><verse number="26" style="v" sid="JOS 7:26" />ತಿನಾಪರ ದಗ್ಡಾನೆ ಯಕ್ಕ ಮ್ಹೊಟು ಕುಪ್ಪೆನೆ ಘಾಲಿಪಡ್ಯಾ. ತೆ ಹಮ್ನಾಲಕ್ಕಾ ಛೆ. ತೆಳಾಮಾ ಯಹೊವಾನಾ ರೊಷ ಅಗ್ನಿ ದಡಿರ‍್ಹಯು.ಆ ಸಂಗತಿಯೊನೆ ದೆಸೆಕ್ಹು ತೆ ಜ಼ಗಾನೆ ಹಮ್ನಾಲಕ್ಕಾ ಆಕೊರಿನಾ ಗ್ಹಾಡಿ ಕೈನ ನಾಮ ರ‍್ಹವಸ.<verse eid="JOS 7:26" /></para>
  <chapter eid="JOS 7" />
  <chapter number="8" style="c" sid="JOS 8" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 8:1" />ಯೆರಿಕೊನಾ ಇಸ್ರಾಯಲೊನೆ ಬುಚ್ಕಿನ ತ್ಯುನಾ ಗಾಮನಾ ಬಾಕಲೊನೆ ಘಟ್ಟ ಘಾಲಿಪಡ್ಯಾ.ಕುನ್ನಜ ಮ್ಹೈ ಗಯಾ ನೈ ಭಾರಾ ಆಯಾನೈ <verse eid="JOS 8:1" /><verse number="2" style="v" sid="JOS 8:2" />ತೆಳಾಮಾ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ದೆಕ ಮಿ ಯೆರಿಕೊನೆ ತೆನಾ ರಾಜಾವೊನೆ ಯುದ್ದ ವಿರೊನೆ ತಾರಾ ಹತೆ ಒಪ್ಪಶೊಸ. <verse eid="JOS 8:2" /><verse number="3" style="v" sid="JOS 8:3" />ತುಮಾರಾ ಭಟ್ಟೊಕ್ಹಾರಾ ಛೆ ದಿನಲಕ್ಕಾ ಯಕ್ಕಸಲಾ ಗಾಮನೆ ಫರು. <verse eid="JOS 8:3" /><verse number="4" style="v" sid="JOS 8:4" />ಕ್ಹಾತ ಜನಾ ಯಾಜಕೊ ಶಿಂಗ್ಡಾವೊನೆ ಧರಲಿನ ಮಂಜುಷನಾ ಕ್ಹಾಮಾ ಚಾಲಾಂದೆ. ಕ್ಹಾತವಾ ದಿನ್ನೆ ತುಮೆ ಗಾಮನೆ ಕ್ಹಾತಸಲಾ ಸುತ್ತೊ; <verse eid="JOS 8:4" /><verse number="5" style="v" sid="JOS 8:5" />ಯಾಜಕೊ ಶಿಂಗ್ಡಾವೊನೆ ಫುಕ್ಯು. ತ್ಯುನೆ ಧಿರ್ಘ ಥೈನ ಫುಕ್ಕಾನೆ ಶಿಂಗ್ಡಾನೆ ಅವಾಜ ಐಕ್ತಾಮಾ ತುಮೆ ಕ್ಹಾರಾ ಮಹತ್ತ ಥೈನ ಆರ್ಭಟೊ ತೆಳಾಮಾ ಗಾಮನಿ ಗೊಡಿ ತೆಜ ಪಡಿಜಾ಼ವಸ ಹರಯಕ್ಲೊ ಸಿದಾ ಮ್ಹೈ ಜಾಸಕಸ ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 8:5" /><verse number="6" style="v" sid="JOS 8:6" />ತೆಳಾಮಾ ನೂನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹುಶುವಾ ಯಾಜಕೊನೆ ಬಲೈನ ತ್ಯುನೊನೆ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚೈಲಿನ ಜಾವೊ ಕ್ಹಾತ ಜನಾ ಯಾಜಕೊ ಶಿಂಗ್ಡಾವೊನೆ ಧರಲಿನ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಕ್ಹಾಮಾ ಜಾವಾದೆ ಕದ್ಯೊ. <verse eid="JOS 8:6" /><verse number="7" style="v" sid="JOS 8:7" />ವರಿ ತೆ ಮನಕ್ಹೊನೆ ಗೈನ ಗಾಮನೆ ಫರ‍್ಯೊ. ಯುದ್ಧ ಸನ್ನದ ಕ್ಹಾರಾ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಕ್ಹಾಮಾ ಜಾವಾದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 8:7" /><verse number="8" style="v" sid="JOS 8:8" />ಯೆಹುಶುವಶಾ ಆಜ್ಞಾಕರಲ ನಿಂಗತ ಕ್ಹಾತ ಜನಾ ಯಾಜಕೊ ಶಿಂಗ್ಡಾವೊನೆ ಧರಲಿನ ಫುಕತ್ತಾ ಯಹೊವಾನಾ ಕ್ಹಾಮಾ ಚಾಲ್ಯಾ. ಯಹೊವಾನಾ ಮಂಜುಷ ತ್ಯುನಾ ಪಾಚು ಗಯು. <verse eid="JOS 8:8" /><verse number="9" style="v" sid="JOS 8:9" />ಯುದ್ಧ ಸನ್ನದ ಥಯಲವಾಲಾ ಶಿಂಗ್ಡಾವೊನೆ ಫುಕತ್ತಾ ಯಾಜಕೊನಾ ಕ್ಹಾಮಾ ವ್ಹತ್ತಾ. ಪಾಚ಼ಲ್ಯೊ ದಳ ಮಂಜುಷನಾ ಪಾಚು ವ್ಹತ್ತು.ಶಿಂಗ್ಡಾವೊನೆ ಫುಕತಾ ಚಾ಼ಲ್ಯಾತಾ. <verse eid="JOS 8:9" /><verse number="10" style="v" sid="JOS 8:10" />ಯೆಹುಶುವಾ ಮನಕ್ಹೊನೆ ತುಮೆ ಹಮ್ನಾ ಆರ್ಬಟ ನೈ ಕರು; ತುಮಾರಿ ಅವಾಜ ಐಕುಕೈನ ತುಮಾರಾ ಮ್ಹೊಡಾಕ್ಹು ಯಕ್ಕ ವಾತ ತಬಿ ಔಕೈನ ಆರ್ಭಟೊ ಕೈನ ಮಿ ಕವಾನಾ ದಿನಮಾ ಮಾತ್ರ ಆರ್ಭಟೊ ಕೈನ ಆಜ್ಞೆ ಕರ‍್ಯೊ. <verse eid="JOS 8:10" /><verse number="11" style="v" sid="JOS 8:11" />ತೆ ಯಹೊವಾನಾ ಮಂಜುಷನೆ ಯಕ್ಕ ಸಲಾ ಗಾಮನೆ ಸುತ್ತಲ್ಪರ ತ್ಯುನೆ ಫರಿನ ಪಾಳೆಯೆ ಐನ ರಾತ ಕಾಟ್ಯಾ. <verse eid="JOS 8:11" /><verse number="12" style="v" sid="JOS 8:12" />ಯೆಹುಶುವಾ ಪಾಟೆ ಉಟ್ಯೊ.ಯಾಜಕೊ ಯಹೊವಾನಾ ಮಂಜುಷನೆ ಉಚೈಲಿನ ಚಾಲ್ಯಾ. <verse eid="JOS 8:12" /><verse number="13" style="v" sid="JOS 8:13" />ಕ್ಹಾತಜನಾ ಯಾಜಕೊ ಶಿಂಗ್ಡಾವಿನೆ ಫುಕತಾ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಕ್ಹಾಮಾ ಚಾಲ್ಯಾ. ಯುದ್ಧ ಸನ್ನದೊ ತ್ಯುನಾ ಕ್ಹಾಮಾ ವ್ಹತ್ತಾ; ಪಾಚಲ್ಯು ದಳ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಪಾಚು ವ್ಹತ್ತು. ಶಿಂಗ್ಡಾವೊನೆ ಫುಕ್ತಾಜಾ ಚಾ಼ಲ್ಯಾತಾ. <verse eid="JOS 8:13" /><verse number="14" style="v" sid="JOS 8:14" />ಅಮ್ಮಜ ಬೆವಾ ದಿನಮಾ ಗಾಮನೆ ಸುತ್ತಿನ ಪಾಳೆನೆ ಪಾಚಾ ಫರ್xಯಾ. ಛೆ ದಿನಲಕ್ಕಾಬಿ ಅಮ್ಮಜ ಕರ‍್ಯಾ. <verse eid="JOS 8:14" /><verse number="15" style="v" sid="JOS 8:15" />ಕ್ಹಾತವಾ ದಿನಮಾ ತುನೆ ಸರ್ಯೊಹುಟ್ಟಾತಿ ಪೈಲಾಜ ಉಟಿನ ತೆಜ ಕ್ರಮಮಾ ಗಾಮನೆ ಕ್ಹಾತಸಲಾ ಸುತ್ಯಾ.ತೆ ದಿನಮಾ ಯಕ್ಕಜ ತೆ ಕ್ಹಾತ ಸಲಾ ಸುತ್ಯಾ. <verse eid="JOS 8:15" /><verse number="16" style="v" sid="JOS 8:16" />ಕ್ಹಾತವಾ ಸಲಾ ಸುತ್ತತಾಮಾ ಯಾಜಕೊ ಶಿಂಗ್ಡಾವೊನೆ ಫುಕ್ಕಾನೆ ಯೆಹುಶುವಾ ಮನಕ್ಹೊನೆ ಆರ್ಭಟೊ ಯಹೊವಾ ತುಮೊನೆ ಆ ಗಾಮನೆ ದಿದ್ಯೊಸ. <verse eid="JOS 8:16" /><verse number="17" style="v" sid="JOS 8:17" />ಆ ಅಮಾರ‍್ಹವಾನು ಕ್ಹಾರು ಕೆವಲ ಯಹೊವಾನಾ ಸೊತ್ತ ಕೈನ ತಿಳದೊ. ರಾಂಡಿ ಥಯಲ ರಾಹಬಳ ತಿನಾ ಕ್ಹಾತೆ ಘರಮಾ ರ‍್ಹಯೆಲವಾಲಾ ಕ್ಹಾರಾ ಉಗ್ರಾಂದೆ ಮಿ ವಳಾಯಲ ದುತನೊ ತೆ ದಡೈನ ಮ್ಹೆಲಿಸತೊ. <verse eid="JOS 8:17" /><verse number="18" style="v" sid="JOS 8:18" />ತುಮೆ ಥಯಾತಬಿ ಯಹೊವಾನೆ ಮಿಸ ಥಯಲ ಸಾಮನೊನಾ ವಿಷಯಮಾ ಹುಶಾರಕ್ಹು ರ‍್ಹೌ.ತುಮೆ ತಿಮಾ ಕಿನೆಬಿ ಇನಿಲಿದ್ಯಾಮ ಇಸ್ರಾಯೆಲನಾ ಪಾಳೆನಾ ಶಾಪನೆ ಗುರಿಥೈನ ಕೆಟ್ಟಸ. <verse eid="JOS 8:18" /><verse number="19" style="v" sid="JOS 8:19" />ಕ್ಹಾರಾ ಕ್ಹೊನೂ ರುಪ್ಪೂ ತಾಂಬು ಲ್ಹೊಡಾವೊನಾ ಸಾಮ್ನೊ ಯಹೊವಾನಾ ಮಿಸ ಥಯಲ ತಿನಾ ಭಂಡಾರನೆ ಮಳಲವ್ಹೈ ಕದ್ಯೊ. <verse eid="JOS 8:19" /><verse number="20" style="v" sid="JOS 8:20" />ತೆಳಾಮಾ ಮನಕ್ಹೊ ಆರ್ಬಟ ಶಿಂಗ್ಡಾವೊನೆ ಅವಾಜ ಐ. ಮನಕ್ಹೊ ಶಿಂಗ್ಡಾವೊನಿ ಅವಾಜ ಐಕಿನ ಮಹತ್ತ ಥೈನ ಆರ್ಭಟ ಕರ್ತಾಮಾ ಗಾಮನಿ ಗೊಡಿ ತಿನಿ ತೆಜ ಪಡಿಗಯಿ. ಹರಯಕ್ಲೊ ಸಿದಾಜ ಗಾಮಾ ಗೈ ಪಡ್ಯಾ.ತೆ ತ್ಯುನೊನೆ ಸ್ವಾಧಿನ ಥಯು. <verse eid="JOS 8:20" /><verse number="21" style="v" sid="JOS 8:21" />ತುನೆ ಗಾಮ್ಮಾ ರ‍್ಹಯಲ ದಾಣ್ಗಾವೊನೆ ಬಾಕ್ಡಿಯೊನೆ ಪಟ್ಟಾವೊನೆ ಗಡಿಯಾವೊನೆ ಬೈಲ ವರಿ ಬಕ್ರಾ ವರಿ ಗದ್ಡಾವೊನೆ ನಿಶ್ಶೆಯ ಥೈನ ಕ್ವತಾಕ್ಹು ಕತ್ರಿಪಡ್ಯಾ. <verse eid="JOS 8:21" /><verse number="22" style="v" sid="JOS 8:22" />ಯೆಹುಶುವಾ ದೆಶನೆ ಗಯಲ ದೆಕಲ ಬೆ ಮನಕ್ಹೊನೆ ತುಮೆ ತೆ ರಾಂಡಿನಾ ಘರೆ ಜಾವೊ ತಿನೆ ಪ್ರಮಾಣ ಕರಲನಂಗತ ತಿನೆ ತಿಕನ ರ‍್ಹವಾನು ಕ್ಹಾರು ಭಾರಾ ಲಿನ ಆವೊ <verse eid="JOS 8:22" /><verse number="23" style="v" sid="JOS 8:23" />ಕವಾನು ತೆ ಜಾಂಜಿಮಾನ ಗೈನ ರಾಹಾಬಳನೆ ತಿನಾ ಮಾಬಾಪನೆ ಭಾಯೊನೆ ತಿನೆ ರ‍್ಹವಾನು ಕ್ಹಾರು ತಿನಾ ಕುಟುಂಬನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಲೈನ ಇಸ್ಆಯಲನಾ ಪಾಳೆನಾ ಭಾರಾ ಮ್ಹೆಲ್ಯಾ. <verse eid="JOS 8:23" /><verse number="24" style="v" sid="JOS 8:24" />ಇಸ್ರಾಯಲೊ ಗಾಮನೆ ತಿಮಾ ರ್ಹವಾನುಕ್ಹಾರು ಆಗಕ್ಹು ಬಾಳ್ಯಾ.ತೆ ನೈಸೊ ಕ್ಹೊನಾನೆ ವರಿ ರುಪ್ಪಾನೆ ತಾಂಬಾನಾ ವರಿ ಲ್ಹೊಡಾನಾ ಸಾಮನೊನೆ ಯಹೊವಾನಾ ಆಲಯನಾ ಭಂಡಾನೆ ದಿದ್ಯಾ. <verse eid="JOS 8:24" /><verse number="25" style="v" sid="JOS 8:25" />ರಾಂಡಿ ಥಯಲ ರಾಹಾಬಳ ಯೆರಿಕೊ ಗಾಮನೆ ಫರಿನ ದೆಕಾನಾಹುತಿ ಆಯಲ ಯೆಹುಶುವಾನಾ ದುತೊನೆ ದಡಾಯಲಕ್ಹು ತೆ ತಿನೆ ತಿನಾಬಾನಾ ಘರವಾಲಾವೊನೆ ತಿನೆ ರ‍್ಹವಾನು ಕ್ಹಾರು ವಚಾ಼ಡ್ಯೊ.ತೆ ಹಮ್ನಾಲಕ್ಕಾ ಇಸ್ರಾಯಲೊಮಾ ವ್ಹತ್ತಿ. <verse eid="JOS 8:25" /><verse number="26" style="v" sid="JOS 8:26" />ತೆಜ ಟೈಮಾ ಯೆಹುಶುವಾ ಇಸ್ರಾಯಲೊಕ್ಹು ಪ್ರಮಾಣ ಕರಲ ತ್ಯುನೊನೆ ಆ ಯೆರಿಕೊ ಗಾಮನೆ ಭಾಂದಾನಾಹುತಿ ಹತ ಲಗಾಡಾನೊ ಮನಕ್ಹ ಯಹೊವಾನಾ ನಜರಮಾ ಶಾಪಗ್ರಸ್ತಥೌ. ಥ್ಯವೊ ತಿನೆ ಅಸ್ತಿವಾರ ಗ್ಹಾಲ್ತಾಮಾ ತಿನಾ ಮ್ಹೊಟಾ ದಿಕ್ರಾನೆ ಬಾಕಲೊಮ್ಹೆಲ್ತಾಮಾ ನ್ಹಾನಾ ದಿಕ್ರಾನೆ ಜವೈಲಿವಾದೆ ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 8:26" /><verse number="27" style="v" sid="JOS 8:27" />ಯಹೊವಾ ಯೆಹುಶುವಾನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲಕ್ಹು ತೆ ದೆಶಮಾ ಕ್ಹಾರಾ ಪಡ್ದಿಲಿದ್ಯೊ. <verse eid="JOS 8:27" /><verse number="28" style="v" sid="JOS 8:28" />ಯೆಹುಶುವಾ ಆಯಿ ಕವಾನಾ ಗಾಮನೆ ಬಾಳಿನ ತೆ ಕಯಾಜ ಕಾಲಮಾ ಫರಿನ ನೈ ಭಾಂದಾನು ಹಾಳಕರ್ಯೊ. ತೆ ಹಮ್ನಾಲಕ್ಕಾ ತಿಮ್ಮಜ ಛೆ. <verse eid="JOS 8:28" /><verse number="29" style="v" sid="JOS 8:29" />ಆಯಿ ಕವಾನಾ ಗಾಮನಾ ರಾಜಾನೆ ಕ್ಹಾಂಜಲಕ್ಕಾ ಝಾಡನೆ ಪಾಕ್ಹೊ ಘಾಲಿನ ಸೂರ್ಯೊ ಡುಬಲಪರ ತಿನಾ ಮುರ್ದಾನೆ ಹೆಟಾ ಉತಾರಿನ ತೆ ಗಾಮನಾ ಬಾಕಲಮಾ ಘಾಲಿನ ತಿನಾ ಉಪ್ಪರ ಮ್ಹೊಟು ಮಜಾರ ಭಂದಾಯೊ.ತೆ ಹಮ್ನಾಲಕ್ಕಾ ತಿಮ್ಮಜ ಛೆ. <verse eid="JOS 8:29" /><verse number="30" style="v" sid="JOS 8:30" />ಕ್ಹುದಾನೊ ಸೆವಕ ಥಯಲ ಮೊಶೆ ಇಸ್ರಾಯಲ ಮನಕ್ಹೊನೆ ಕದಲ ತಿಮ್ಮ ಮೊಶೆ ಧರ್ಮಶಾಸ್ತ್ರಮಾ ಬರದಲ ನಿಂಗತ ಯೆಹುಶುವಾ ತೆ ಟೈಮಾ ಇಸ್ರಾಯಲನೊ ಕ್ಹುದಾ ಥಯೆಲ ಯಹೊವಾನೆ ಎಬಾಲ ಡೊಂಗರಪರ ಉಳಿ ತೆ ಕ್ಹಾರಾ ಉಪಯೊಗ ಕರೆವಾಚಿ ಹುಟ್ಟಲ ದಗ್ಡಾವೊಕ್ಹು ಯಕ್ಕ ಯಜ್ಞವೆದಿ ಭಾಂದ್ಯೊ. <verse eid="JOS 8:30" /><verse number="31" style="v" sid="JOS 8:31" />ಮನಕ್ಹೊ ತಿನಾ ಉಪ್ಪರ ಯಹೊವಾನೆ ಸರ್ವಾಂಗ ಹೊಮ ಕರಿನ ಸಮಾದಾನ ಯಜ್ಞಾವೊ ಬಲಿದಾನ ದಿದ್ಯಾ. <verse eid="JOS 8:31" /><verse number="32" style="v" sid="JOS 8:32" />ಯೆಹುಶುವಾ ತ್ಯಾ ರಹೆಲ ದಗ್ಡಾವೊನಾ ಉಪ್ಪರ ಮನಕ್ಹೊನಾ ಪಕ್ಷಮಾ ಮೊಶೆನಾ ಧರ್ಮಶಾಸ್ತ್ರನಿ ಯಕ್ಕ ಪತ್ರ ಲಿಕ್ಯೊ. <verse eid="JOS 8:32" /><verse number="33" style="v" sid="JOS 8:33" />ಕ್ಹಾರಾ ಇಸ್ರಾಯಲೊ ಕದ್ಯಾಮ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ಅಧಿಕಾರಿಯೊ ನ್ಯಾಯದಿ ಪತಿಯೊ ಬಿಜಾ ದೆಶವಾಲಾ ಭಾರಲ್ಯಾ ದೆಶವಾಲಾ ಯಹೊವಾನಾ ಒಡಂಬಡಿನಾ ಮಂಜುಷನಾ ಆಜು಼ ಬಾಜು಼ ತೆ ಉಚೈಲಿದಲ ಲೆವಿ ಮನಕ್ಹೊ ಯಾಜಕೊನಾ ಕ್ಹಾಮಾ ಸಾಮನಾ ಥೈನ ಹುಬ್ರಯಾ <verse eid="JOS 8:33" /><verse number="34" style="v" sid="JOS 8:34" />ಗೆರ್ಜಿಮ ಡೊಂಗರಕನ ದಕ್ಹಾ ಮನಕ್ಹೊ ಎಬಾಲ ಡೊಂಗರಕನ ದಕ್ಹಾ ಮನಕ್ಹೊ ಯಹೊವಾನಾ ಸೆವಕ ಥಯಲ ಮೊಶೆ ಪೈಲಾಜ ಕದಲ ತಿಮ್ಮ ಆಶಿರ್ವಾದ ಲಿವಾನಾ ಹುತಿ ಹುಬ್ರಯಾ. ಪಾಚಳತೊ ಯಹುಶುವಾ ಧರ್ಮಶಾಸ್ತ್ರನಾ ಆಶಿರ್ವಾದ ಶಾಪ ವಾಕ್ಯಾವೊ ತೆ ಗ್ರಂಥಮಾ ರಹೆಲ ತಿಮ್ಮ ಓದ್ಯೊ. <verse eid="JOS 8:34" /><verse number="35" style="v" sid="JOS 8:35" />ಮೊಶೆ ಕದಲೆ ತಿಮಾ ಯಕ್ಕಬಿ ಛೊಡೆವಾಚಿ ಬಾಕ್ಡಿಯೊನೆಬಿ ನ್ಹಾನಾ ಬಚ್ಚಾವೊನೆಬಿ ತ್ಯುನಾ ರಹೆಲ ಬಿಜಾ ದೆಶವಾಲಾವೊನೆ ಐಕಾವಾ ವರಕ್ಹು ಕ್ಹಾರಾ ಸಮಾಜವಾಲೊನಾ ಕ್ಹಾಮೊ ಓದ್ಯೊ.<verse eid="JOS 8:35" /></para>
  <chapter eid="JOS 8" />
  <chapter number="9" style="c" sid="JOS 9" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 9:1" />ಯೊರ್ದನಾ ತಳಾನಾ ತ್ಯಾ ಡೊಂಗರನಾ ಉಪ್ಪರಲ್ಯು ಗಾಮ ಇಳಕಲನು ಗಾಮ ಲೆಬುನಿನಾ ಕ್ಹಾಮು ರ‍್ಹವಾನು ಮಹಾ ಸಾಗರನು ದಂಡಿ ಗಾಮ ಅಮಾ ರ‍್ಹಯಲ ಅಮೊರಿನಾ ಹಿತ್ತಿನಾ ಕಾನನಾ ಪೆರಿಜಿನಾ ಹಿವ್ವಿನಾ ಯೆಬುಸಿನಾ ರಾಜಾ ಚಾಲಲ ಸಂಗತಿಯೊ ಐಕಿನ <verse eid="JOS 9:1" /><verse number="2" style="v" sid="JOS 9:2" />ಯಕ್ಕಜ ಮನಸಕ್ಹು ಯೆಹುಶುವಾನೆ ಇಸ್ರಾಯಲೊನೆಬಿ ವಿರೊಧ ಥೈನ ಯುದ್ದ ಕರಾನಾ ಹುತಿ ಕುಡ್ಯಾ. <verse eid="JOS 9:2" /><verse number="3" style="v" sid="JOS 9:3" />ಯೆರಿಕೊವಾಲಾವೊನೆ ಆಯಿ ಕವಾನಾ ಗಾಮವಾಲಾವೊನೆ ಯೆಹುಶುವಾ ಬಲಿ ದಿದಲ ಸುದ್ದಿ ಗಿಬ್ಯೊನಿನಾ ನಿವಾಸಿಯೊ ಐಕಿನ ತ್ಯುನೆ ಯಕ್ಕ ಯುಕ್ತಿ ಕರ್ಯಾ.ಕಿಮ ಕದ್ಯಾಮ <verse eid="JOS 9:3" /><verse number="4" style="v" sid="JOS 9:4" />ತ್ಯುನೆ ತ್ಯುನಾ ಗದ್ಡಾನಾ ಉಪ್ಪರ ಜುನ್ನಾ ಕೊತ್ಳಾ ಘಾಲಿನ ತ್ಯುನಾ ಉಪ್ಪರ ಫಾಟಿನ ಗೈನ ಭಾಂದಲ ದ್ರಾಕ್ಷಾರಕ್ಹನು ಜುನ್ನಾ ಬುದ್ದಲಿಯೊನೆ ಉಚೈನ ಫಾಟಲ ಜುನ್ನಾ ಚಪ್ಪಲೊನೆ ಘಾಲ್ಲಿನ ಜುನ್ನಾ ವಣ್ಣಾವೊನೆ <verse eid="JOS 9:4" /><verse number="5" style="v" sid="JOS 9:5" />ಬುಳಾಸಾಯಲ ಬಚಕಾವೊನಾ ತುಕಡಾವೊನಿ ಬುತ್ತಿ ಭಾಂದಿಲಿನ ಹಮೆ ರಾಯಭಾರಿ ವೈ ಕೈನ ಗಿಲ್ಗಾಲಮಾ ರ‍್ಹಯಲ ಯೆಹುಶುವಾನಾ ಪಾಳೆಯೆನೆ ಐನ ತಿನೆ ವರಿ ಇಸ್ರಾಯಲೊವೊನೆ ಹಮೆ ದುರ ಗಾಮತಾ ಆಯಾಸ; ತುಮೆ ಹಮಾರಾ ಕ್ಹಾತೆ ಒಡಂಡಿಕೆ ಕರಲಿವೊ ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 9:5" /><verse number="6" style="v" sid="JOS 9:6" />ಹಮೆ ದುರ ಗಾಮತಾ ಆಯಾಸ; ತುಮೆ ಹಮಾರಾ ಕ್ಹಾತೆ ಒಡಂಡಿಕೆ ಕರಲಿವೊ ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 9:6" /><verse number="7" style="v" sid="JOS 9:7" />ತೆಳಾಮಾ ಇಸ್ರಾಯಲೊ ಹಿವ್ವಿಯೊ ಥಯಲ ತ್ಯುನೊನೆ ತುಮೆ ಯಕ್ಕ ಸಮಯಮಾ ಆ ಅಪ್ನಾ ಗಾಮೊನೊಜ ನಿವಾಸಿಯೊ ಥಯಲ ರ‍್ಹೌ; ತೆ ಪಕ್ಷ ಮಾ ಹಮೆ ತುಮಾರಾ ಕ್ಹಾತೆ ಒಡಂಡಿಕೆ ಕರಲಿವಾನು ಕಿಮ್ಮ ವ್ಹೈ ಕೈನ ಉತ್ತರ ದಿದ್ಯೊ. <verse eid="JOS 9:7" /><verse number="8" style="v" sid="JOS 9:8" />ತ್ಯುನೆ ಯೆಹಉಶುವಾನೆ ಹಮೆ ತಾರಾ ದಾಸೊ ಥಯಾಸ ಕೈನ ತೆ ತ್ಯುನೊನೆ ತುಮೆ ಕುನ್ನ ವ್ಹೈ, ಕಿಜಾನಾ ವ್ಹೈ ಕೈನ ಪುಚ್ಯೊ. ತಿನಾಹುತಿ ತ್ಯುನೆ <verse eid="JOS 9:8" /><verse number="9" style="v" sid="JOS 9:9" />ತಾರಾ ಸೆವಕ ಥಯಲ ಹಮೆ ತಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ನಾಮನಾ ಮಹತ್ತನಾ ನಿಮಿತ್ತ ಘನಾ ದುರ ಗಾಮಾತಾ ಆಯಾಸ. ಹಮಾರಾ ಮ್ಹೊಟಾ ಗಾಮವಾಲಾ ತಿನಾ ಐಗುಪ್ತಮಾ ಕರಲ ಅದ್ಬುತ ಕಾರ್ಯೊನಿ ಸುದ್ದಿನೆ ಹೆಷ್ಬೊನನೊ ರಾಜೊ ಥಯಲ ಸಿಹೊನ, <verse eid="JOS 9:9" /><verse number="10" style="v" sid="JOS 9:10" />ಅಷ್ಟರೊತಮಾ ರ‍್ಹಯಲ ಬಾಷಾನಿನೊ ರಜೊಥಯಲ ಓಗ ಕವಾಲಾ ಬೆಜನಾ ಅಮೊರಿನಾ ರಾಜಾವೊನೆ ಕರಲ ಕ್ಹಾರು ಐಕಿನ <verse eid="JOS 9:10" /><verse number="11" style="v" sid="JOS 9:11" />ತುಮೆ ಪ್ರಯಾಣನಾಹುತಿ ಬುತ್ತಿ ಭಾಂದಿಲಿನ ಗೈನ ಇಸ್ರಾಯಲನಾ ಕ್ಹಾಮಾ ಐನ ಹಮೆ ತುಮಾರಾ ಸೆವಕ ವ್ಹೈ; ತುಮೆ ಹಮಾರಾ ಕ್ಹಾತೆ ಒಡಂಬಡಿಕೆ ಕರಲಿವೊ ಕೈನ ತ್ಯುನೊನೆ ಮಾಂಗಿಲಿವೊ ಕೈನ ಹಮ್ನೊನೆ ಮೊಕಲಾಯಾ. <verse eid="JOS 9:11" /><verse number="12" style="v" sid="JOS 9:12" />ಹಮೆ ತುಮೊನೆ ಕ್ಹಾಮಾ ಆವಾನಾಹುತಿ ಘರ ಛೊಡಿನ ಜಾತಾಮಾ ಜಾವಾನಾಹುತಿ ಲಿದಲ ರೊಕಲೊ ಉನ್ನೊವ್ಹತ್ತೊ; ಹಮ್ನಾ ಕ್ಹುಕ್ಹೈನ ತುಕಡಾ ತುಕಡಾ ಥಯಾಸ ದೆಕೊ. <verse eid="JOS 9:12" /><verse number="13" style="v" sid="JOS 9:13" />ಹಮೆ ದ್ರಾಕ್ಷಿನೊ ರಕ್ಹ ಭರಲಿದಲ ತೆ ಹಂಡ್ಲಾ ನವಾ ವ್ಹತ್ತಾ; ಹಮ್ನಾ ಫಾಟ್ಯಾಸ. ಹಮಾರಾ ವಣ್ಣಾ ಚಪ್ಪಲೊ ದಿರ್ಘಪ್ರಯಾಣಕ್ಹು ಜುನ್ನಾ ಥಯಾಸ ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 9:13" /><verse number="14" style="v" sid="JOS 9:14" />ತೆಳಾಮಾ ಇಸ್ರಾಯಲೊ ತ್ಯುನಾ ಬುತ್ತಿಮಾನು ದಕ್ಹು ಕಾಳ್ಳಿದ್ಯಾ. ತೆ ನೈಸೊ ಯಹೊವಾನೆ ಯಹೊವಾನೆ ಪ್ಯುಚ್ಚಾ ನೈ. <verse eid="JOS 9:14" /><verse number="15" style="v" sid="JOS 9:15" />ಯೆಹುಶುವಾ ತ್ಯುನಾ ಕ್ಹಾತೆ ತುಮೊನೆ ಜಿವಕ್ಹು ವಚಾ಼ಡುಸ ಕೈನ ಸಮಾಧಾನನೊ ಒಡಂಬಡಿಕೆ ಕರಲಿದ್ಯೊ.ಸಮೂಹ ಪ್ರದಾನೊ ಕ್ಹಮ ಘಾಲ್ಯಾ. <verse eid="JOS 9:15" /><verse number="16" style="v" sid="JOS 9:16" />ಒಡಂಬಡಿಕೆ ಥೈನ ತನ್ನದಿನಪರ ತ್ಯುನಾ ಕ್ಹಾಮಾ ರ‍್ಹವಾಲಾ ಅಪ್ನಾ ವಚ್ಮಾ಼ಜ಼ ರ‍್ಹವಾಲಾ ಥಯಾಸ ಕೈನ ಇಸ್ರಾಯಲೊನೆ ಗೊತ್ತ ಥಯು.ಕಿಮ್ಮ ಕದ್ಯಾಮ <verse eid="JOS 9:16" /><verse number="17" style="v" sid="JOS 9:17" />ಇಸ್ರಾಯಲೊ ತನ್ನವಾ ದನ್ನಮಾ ಗೈನ ಸೆರಲ ಗಿಬ್ಯೊನ್, ಕೆಫಿೀರಾ, ಬೆರೊತ, ಕಿರ್ಯತ್ಯಾರಿಮ ಕವಾನಾ ತ್ಯುನಾಜ ಥಯಾತಾ. <verse eid="JOS 9:17" /><verse number="18" style="v" sid="JOS 9:18" />ಸಮೂಹ ಪ್ರದಾನೊ ಇಸ್ರಾಯಲೊನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ನಾಮಮಾ ತ್ಯುನೊನೆ ಕ್ಹಮ ಘಾಲಲಹುತಿ ಇಸ್ರಾಯಲೊ ತ್ಯುನೊನೆ ಮಾರxಯಾ ನೈ. ತೆನೈಸೊ ಸಮೂಹನಾ ಕ್ಹಾರಾ ಪ್ರಧಾನನೊ ವಿರೊದ ಥೈನ ಗುಣ ಗುಟ್ಯಾ. <verse eid="JOS 9:18" /><verse number="19" style="v" sid="JOS 9:19" />ತೆಳಾಮಾ ಪ್ರದಾನೊ ಕ್ಹಾರಾ ಸರ್ವ ಸಮುಹವಾಲಾವೊನೆ ಹಮೆ ಇಸ್ರಾಯಲೊನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ನಾಮಮಾ ತ್ಯುನೊನೆ ಕ್ಹಮ ಘಾಲಲಕ್ಹು ತ್ಯುನೊನೆ ಮಟ್ಟಾನೆ ಥಾವಸ. <verse eid="JOS 9:19" /><verse number="20" style="v" sid="JOS 9:20" />ಹಮೆ ಘಾಲಲ ಕ್ಹಮನಾ ಹುತಿ ಕ್ಹುದಾನಿ ಶಿಟ್ಟ ಅಪ್ನಾ ಉಪ್ಪರ ನೈ ಆಯಲ ನಿಂಗತ ಕರಿಯೆ. <verse eid="JOS 9:20" /><verse number="21" style="v" sid="JOS 9:21" />ತ್ಯುನೆ ಸಮೂಹನೆ ಕ್ಹಾರಾ ಲಾಕ್ಡಾ ಕತ್ರಾಲಾ ಪಾನಿಲಾವಾಲಾ ಥೈನ ಬಾಳಾದೆ ಕೈನ ಕದ್ಯಾ. ಪ್ರದಾನನಾ ವಾತನಿಂಗತಜ಼ ಥಯು. <verse eid="JOS 9:21" /><verse number="22" style="v" sid="JOS 9:22" />ಯೆಹುಶುವಾ ಗಿಬ್ಯೊನನೆ ಬಲೈನ ತ್ಯುನೊನೆ ತುಮೆ ಹಮಾರಾ ವಚ್ಮಾ ರ‍್ಹವಾಲಾ ರೈತಬಿ ಘನಾ ದುರ ವ್ಹೈ ಕೈನ ಹಮೊನೆ ವಂಚಲ ಕಾವೈ? ಇನಾಹುತಿ ತುಮೆ ಪಾಪ ಕರಲವಾಲಾ ವ್ಹೈ. <verse eid="JOS 9:22" /><verse number="23" style="v" sid="JOS 9:23" />ತುಮೆ ಕೆಳಾಮಾಬಿ ದಾಸ ಥೈನ ಮಾರಾ ಕ್ಹುದಾನಾ ಗುಡಿನೆ ಲಾಕ್ಡಾ ಕತ್ರಾಲಾ ಪಾನಿ ಲಾವಾಲಾ ಥಯು ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 9:23" /><verse number="24" style="v" sid="JOS 9:24" />ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ತಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ತಿನೊ ಸೆವಕ ಥಯಲ ಮೊಶೆನೆ ಮಿ ತುಮೊನೆ ಆ ದೆಶ ಕ್ಹಾರು ದೆತಾಮಾ ತುಮೆ ಅನಾ ಕ್ಹಾರಾನಿವಾಸಿಯೊನೆ ಕತ್ರಿಪಡುಕೈನ ಆಜ್ಞಾಕರಲ ಐಕಿನ ಹಮಾರೊ ಜ್ಯೂ ಕಾಡೊಸಿ ಕೈನ ಬುಚ್ಕಿನ ಅಮ್ಮ ಕರ್ಯಾ. <verse eid="JOS 9:24" /><verse number="25" style="v" sid="JOS 9:25" />ಹಮ್ನಾ ಹಮೆ ತಾರಾ ಹತ್ಮಾ ರ‍್ಹೆಯಸ ತುನೆ ಚೊಕು ಕವಾನು ನ್ಯಾಯಕವಾನು ದಿಕ್ಹಾನು ಹಮೊನೆ ಕರ ಕೈನ ಉತ್ತರ ದಿದ್ಯೊ. <verse eid="JOS 9:25" /><verse number="26" style="v" sid="JOS 9:26" />ಯೆಹುಶುವಾ ತೆ ಪೈಲಾಜ ಕದಲನಿಂಗತ ಕರ್ಯೊ.ತೆ ತ್ಯುನೊನೆ ಇಸ್ರಾಯಲನಾ ಹತ್ಮಾತಾ ಸಂಹೃದ ಥಯಾ ಕೈನ ಚುಕೈಲಿನ ಸಮೂಹನಾಹುತಿ <verse eid="JOS 9:26" /><verse number="27" style="v" sid="JOS 9:27" />ಯಹೊವಾ ಇನಿಲಿವಾನಾ ಜ಼ಗಾಮಾ ತೆ ಯಜ್ಞವೆದಿನಾಹುತಿ ಲಾಕ್ಡಾ ಕತ್ರಾಲೊ ಪಾನಿ ಲಾವಾಲೊ ನೆಮಸ್ಯೊ. ತ್ಯುನೆ ಹಮ್ನಾಲಕ್ಕಾ ತೆಜ ಕಾಮ ಕರಸ.<verse eid="JOS 9:27" /></para>
  <chapter eid="JOS 9" />
  <chapter number="10" style="c" sid="JOS 10" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 10:1" />ಎ ಟೈಮ್ಮಾ ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ ಗಾಮನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ವಳಾಯೊ. ಎ ಮನಕ್ಹೊನೆ ಯೆಹುಶುವಾ ವಳಾಯಲ ಸಂಗತಿ ಬಿಜು ಕಿನೆಜ ಗ್ವತ್ತ ನ್ಹೊತು ''ಗೈನ ತೆ ಯೆರಿಕೊ ಗಾಮನೆ ಘನ್ನ ಸುಕ್ಷ್ಮಕ್ಹು ದೆಕೊ” ಕೈನ ಯೆಹುಶುವಾ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಕದ್ಯೊ. ತೆ ಭಂಬಿ ಜನಾ ಯೆರಿಕೊ ಗಾಮೆ ಗೈನ ಯಕ್ಕ ವ್ಯಶ್ಯಾನಾ ಘರಮಾ ರ‍್ಹಯಾ. ತೆ ಬಾಕಡಿನು ನಾಮ ‘ರಾಹಾಬ.’ <verse eid="JOS 10:1" /><verse number="2" style="v" sid="JOS 10:2" />ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 10:2" /><verse number="3" style="v" sid="JOS 10:3" />ತಿಳ್ದಿಲಿವಾನೆ ವಳಾಯೊ. ಎ ಮನಕ್ಹೊನೆ ಯೆಹುಶುವಾ ವಳಾಯ <verse eid="JOS 10:3" /><verse number="4" style="v" sid="JOS 10:4" />ರಾಹಾಬ ಎ ಭಂಬಿ ಜನಾವೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. ತೆನೈಸೊ ತೆ ಪುಚ್ಚಾನೆ ಆಯಲವಾಲಾವೊನೆ ಬೆ ಮನಕ್ಹೊ ನ್ಹ್ಯಾ ಆಯಾತಾ, ತೆನೈಸೊ ತ್ಯುನೆ ಕಿಜಾಂತಾ ಆಯಾತಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನ್ಹೊತು. <verse eid="JOS 10:4" /><verse number="5" style="v" sid="JOS 10:5" />ಖಾಂಜೆ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಾನು ಟೈಮ ಥಾತಾಮಾ ತ್ಯುನೆ ಗೈಪಡ್ಯಾ. ತ್ಯುನೆ ಕಿಜಾ ಗಯಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನತ್ತಿ. ತೆನೈಸೊ ತುಮೆ ಜಲ್ದಿ ಗಯಮ ತ್ಯುನೊನೆ” ಕದಿ. <verse eid="JOS 10:5" /><verse number="6" style="v" sid="JOS 10:6" />ತೆನೈಸೊ ತೆ ಕ್ಹರಿಮಾಜ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಛತ್ತನಾ ಉಪ್ಪರ ಬಲೈ ಲಿನ ಗೈನ ವಟ್ಟಲ ಚಾರಾಮಾ ತ್ಯುನೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. <verse eid="JOS 10:6" /><verse number="7" style="v" sid="JOS 10:7" />ರಾಜಾನಾ ಭಟ್ಟೊ ಗಾಮನಾ ಭಾರಾ ಗೈನ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಿನ ಇಸ್ರೆಲತಾ ಆಯಲ ತೆ ಭಂಬಿ ಜನಾವೊನೆ ಹುಡಕಿನ ಗಯಾ. ತ್ಯುನೆ ಯೊರ್ದನ ನದಿ ಲಕ್ಕಾ ಗೈನ ಮನಕ್ಹೊ ನದ ದಾಟಾನಾ ಕ್ಹಾಟರಾ ಜ಼ಗಾವೊಮಾ ಹುಡಕ್ಯಾ. <verse eid="JOS 10:7" /><verse number="8" style="v" sid="JOS 10:8" />ತೆ ಭಂಬಿ ಗುಡಾಚಾರಿಯೊ ತ್ಯಾಜ ಕ್ಹುರ್xಯಾವಾನೆ ತಯ್ಯಾರಿ ಕರಿಲಿದ್ಯಾತಾ. ತೆನೈಸೊ ರಾಹಾಬ ಛತ್ತನಾ ಉಪ್ಪರ ಗೈನ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="JOS 10:8" /><verse number="9" style="v" sid="JOS 10:9" />''ಯಹೊವಾ ಎ ದೆಶನೆ ತುಮಾರಾ ಮನಕ್ಹೊನೆ ದಿದ್ಯೊಸ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. ತುಮಾರಿ ವಿಶಯ ಐಕಿನ ಹಮೊನೆ ಭೆಂ ಹುಟ್ಯುಸ. ಎ ದೆಶಮಾ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ತುಮೊಕ್ಹು ಭುಚ್ಕಿನ ಛೆ. <verse eid="JOS 10:9" /><verse number="10" style="v" sid="JOS 10:10" />ಯಹೊವಾ ತುಮೊನೆ ಸಹಾಯ ಕರಲ ತರಿಕಾನಾ ಹುತಿ ಹಮೆ ಐಕಿನ ಭುಚ್ಚಕ್ಯಾಸ. ತುಮೆ ಇಜಿಪ್ಟತಾ ಭಾರಾ ಆಯಲ್ಪರ ತೆ ಲಾಲ ಸಮುಂದರನಾ ಪಾನಿನೆ ಕ್ಹುಕ್ಹಾಯಲ ಹಮೆ ಐಕ್ಯಾಸ. ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವ ದಿಕ್ಕಮಾ ರ‍್ಹಯಲ ಸಿಹೊನ ವರಿ ಒಗ್ ಕವಾನಾ ಅಮೊರಿಯನಾ ಬೆ ಜನಾ ರಾಜಾವೊನೆ ತುಮೆ ಕಿಮ್ಮ ನಾಶ ಕರ್‍ಯಾಸ ಕವಾನು ಐಕ್ಯಾಸ. <verse eid="JOS 10:10" /><verse number="11" style="v" sid="JOS 10:11" />ಎ ಟೈಮ್ಮಾ ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊಕ್ಹಾರಾವೊನಾಹುತಿ ಐಕಿನ ಹಮೊನೆ ಘನ್ನು ಭೆಂ ಐಯುಸ; ಹಮೊಮಾ ಕಿನೆಜ ತುಮಾರಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರಾನೆ ಧೈರ್ಯ ನತ್ತಿ. ಕಾಕದ್ಯಾಮ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ, ಭುಪರಲೊಕನೆ ಆಳಾಲೊ ಥಯೊಸ. <verse eid="JOS 10:11" /><verse number="12" style="v" sid="JOS 10:12" />ಹಮ್ನಾ ತುಮೆ ಹಮೊನೆ ಯಕ್ಕ ಪ್ರಮಾಣ ಕರು. ಮಿ ತುಮೊನೆ ದಯಾ ದೆಕಾಡಿನ ಸಹಾಯ ಕರಿ. ತಿನಾಹುತಿ ತುಮೆಬಿ ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ದಯಾ ದೆಕಾಡೊಶಿ ಕೈನ ಯಕ್ಕ ವಳಕ ದಿವೊ. <verse eid="JOS 10:12" /><verse number="13" style="v" sid="JOS 10:13" />ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಕದ್ಯಾಮ ಮಾರಾ ಮಾ ಬಾಪನೆ, ಭಾಯೊ ಭೆನೊನೆ ವರಿ ತ್ಯುನಾ ಕ್ಹಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಜಿವ್ತಾ ಛೊಡಾನೆ ಪ್ರಮಾಣ ಕರೊ” ಕೈನ ಮಾಂಗಿಲಿದಿ. <verse eid="JOS 10:13" /><verse number="14" style="v" sid="JOS 10:14" />ತಿನಾಹುತಿ ತ್ಯುನೆ ''ಹಮಾರು ಜಲಮ ದಿನಬಿ ತುಮಾರು ಜಲಮ ವಚಾ಼ಡೆಸ. ತೆನೈಸೊ ತುಮೆ ಎ ಕಿನೆಜ ಕವೊ ನಕೊ. ಯಹೊವಾ ಎ ದೆಶ ಹಮೊನೆ ದಿದಲ್ಪರ ಹಮೆ ತುಮೊನೆ ದಯಾ ದೆಕಾಡೆಸ. ತುಮೆ ಹಮೊನೆ ಬರೊಕ್ಹೊ ಕರ ಸಕೊಶಿ” ಕದ್ಯಾ. <verse eid="JOS 10:14" /><verse number="15" style="v" sid="JOS 10:15" />ರಾಹಾಬನಾ ಘರನೆ ಗಾಮನಿ ಗೊಡಿಯೆ ಲಾಗಿನ ಭಾಂದ್ಯಾತಾ<verse eid="JOS 10:15" /></para>
  <para style="s">ಪಾಂಚ಼ ಅಮೊರಿಯಾ ರಾಜಾ಼ವೊನೆ ಮಾರಲ</para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 10:16" />ತುಮೆ ಪಾಚಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಮಳಲ ನಂಗತ ತೆ ಪರ್ವತನೆ ನ್ಹಾಟಿನ ಜಾವೊ ತ್ಯಾ ತನ್ನ ದಿನ ದಡಿನ ರೈನ ತ್ಯುನೆ ಗಯಲ್ಪರ ತುಮಾರಿ ವಾಟ ಧರಿನ ಜಾವೊ ಕೈನ ಕದಿ. <verse eid="JOS 10:16" /><verse number="17" style="v" sid="JOS 10:17" />ವರಿ ತ್ಯುನೆ ಹಮೆ ಕದಲ ವಾತನಿಂಗತ ತು ಚಾಲೆಲ ರ‍್ಹಯಾಮ ತು ಹಮಾರಾ ಕರಲ ಪ್ರಮಾಣಖ್ಹು ಬಿಡುಗಡೆ ಥಯೊತೊ. <verse eid="JOS 10:17" /><verse number="18" style="v" sid="JOS 10:18" />ವರಿ ಹಮೆ ಆ ಗಾಮಾ ರ‍್ಹತಾಮಾ ತು ಹಮೊನೆ ಉತಾರೆಲ ಕಿಡಕಿನೆ ಲಾಲ ದೊರೊ ಭಾಂದೊ ಕದ್ಯೊ ವರಿ ತಾರಾ ಮಾಬಾಪನೆ ಭಾಯೊನೆ ಕ್ಹಾರಾ ಸಂಬದಿಕಿಯೊನೆ ತಾರಾ ಘರಮಾ ಬಲೆಲಿದಲ ರ‍್ಹವೊ. <verse eid="JOS 10:18" /><verse number="19" style="v" sid="JOS 10:19" />ತ್ಯುನಾಮಾ ಕಯೊಬಿ ಘರ ಛೊಡಿನ ರೊಡೆ ಆಯೊರೆ ರಗತನು ಪಾಪ ವ್ಹೈ ತ್ಯುನಾ ಮಾತಾನಾ ಉಪ್ಪರ ನಿರ್ದೊಸಿಯೊ ಕೈನ ರ‍್ಹವಸ. ವರಿ ತಾರಾಖ್ಹಾತೆ ಘರಮಾ ರ‍್ಹಯಲವಾಲಾ ಉಪ್ಪರ ಹತ್ತ ಘಾಲ್ಯಾಮ ತೆ ರಗತನು ಪಾಪ ವ್ಹೈ ಅಪ್ನಾ ಮಾತಾನಾ ಉಪ್ಪರ ರ‍್ಹವಸ; <verse eid="JOS 10:19" /><verse number="20" style="v" sid="JOS 10:20" />ತೆ ನೈಸೊ ತು ಹಮಾರಾ ಸಂಗತಿಯೊನೆ ಭಾರಾ ಆವಾನಾಹುತಿ ಹಮೊಖ್ಹು ಕರಲ ಪ್ರಮಾಣಖ್ಹು ಬಿಡುಗಡೆ ಥಾವಸ ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 10:20" /><verse number="21" style="v" sid="JOS 10:21" />ತಿನಾಹುತಿ ತೆ ತುಮಾರಾ ವಾತನಿಂಗತ ಥಾವಾದೆ ಕೈನ ತ್ಯುನೊನೆ ವಳೈ; ತ್ಯುನೆ ಗಯಲ್ಪರ ತೆ ಲಾಲ ದೊರೊ ಕಿಡಕಿನೆ ಭಾಂದಿ. <verse eid="JOS 10:21" /><verse number="22" style="v" sid="JOS 10:22" />ತ್ಯುನೆ ತೆ ಪರ್ವತೆ ಗೈನ ಪಿಟ್ಟ ಲಗಾಡಿನ ಪಾಚ ತನ್ನ ದಿನ ತ್ಯಾಜ ವ್ಹತ್ತಾ. ಪಿಟ್ಟ ಲಗಾಡಿನ ತ್ಯುನೆ ತ್ಯುನೊನೆ ವಾಟನಾ ಯುದ್ದನೆ ಹುಡಕಿನ ದೆಕಿನ ಗೈಪಡ್ಯಾ. <verse eid="JOS 10:22" /><verse number="23" style="v" sid="JOS 10:23" />ತೆಳಾಮ ತ್ಯುನೆ ಬೆಜನಾ ಡೊಂಗರಪರ್ತಾ ಉತ್ರಿನ ತಳು ದಾಟಿನ ನೂನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹುಶುವಾ ಕನ ಐನ ತ್ಯುನೊನೆ ಅನಸಾಯಲ ತಿಳಶ್ಯಾ. <verse eid="JOS 10:23" /><verse number="24" style="v" sid="JOS 10:24" />ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು ಹಮೊನೆ ದಿದ್ಯೊ <verse eid="JOS 10:24" /><verse number="25" style="v" sid="JOS 10:25" />ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಕದ್ಯಾಮ ಮಾರಾ ಮಾ ಬಾಪನೆ, ಭಾಯೊ ಭೆನೊನೆ ವರಿ ತ್ಯುನಾ ಕ್ಹಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಜಿವ್ತಾ ಛೊಡಾನೆ ಪ್ರಮಾಣ <verse eid="JOS 10:25" /><verse number="26" style="v" sid="JOS 10:26" />ಎ ಟೈಮ್ಮಾ ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 10:26" /><verse number="27" style="v" sid="JOS 10:27" />ಎ ಟೈಮ್ಮಾ ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 10:27" /><verse number="28" style="v" sid="JOS 10:28" />ಎ ಟೈಮ್ಮಾ ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 10:28" /><verse number="29" style="v" sid="JOS 10:29" />ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಕದ್ಯಾಮ ಮಾರಾ ಮಾ ಬಾಪನೆ, ಭಾಯೊ ಭೆನೊನೆ ವರಿ ತ್ಯುನಾ ಕ್ಹಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಜಿವ್ತಾ ಛೊಡಾನೆ ಪ್ರಮಾಣ <verse eid="JOS 10:29" /><verse number="30" style="v" sid="JOS 10:30" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 10:30" /><verse number="31" style="v" sid="JOS 10:31" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 10:31" /><verse number="32" style="v" sid="JOS 10:32" />ರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 10:32" /><verse number="33" style="v" sid="JOS 10:33" />ಎ ಟೈಮ್ಮಾ ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 10:33" /><verse number="34" style="v" sid="JOS 10:34" />ರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 10:34" /><verse number="35" style="v" sid="JOS 10:35" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 10:35" /><verse number="36" style="v" sid="JOS 10:36" />ಎ ಟೈಮ್ಮಾ ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 10:36" /><verse number="37" style="v" sid="JOS 10:37" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 10:37" /><verse number="38" style="v" sid="JOS 10:38" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 10:38" /><verse number="39" style="v" sid="JOS 10:39" />ರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 10:39" /><verse number="40" style="v" sid="JOS 10:40" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 10:40" /><verse number="41" style="v" sid="JOS 10:41" />ರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 10:41" /><verse number="42" style="v" sid="JOS 10:42" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 10:42" /><verse number="43" style="v" sid="JOS 10:43" />ರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ<verse eid="JOS 10:43" /></para>
  <chapter eid="JOS 10" />
  <chapter number="11" style="c" sid="JOS 11" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 11:1" />ನುನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ ಗಾಮನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ವಳಾಯೊ. ಎ ಮನಕ್ಹೊನೆ ಯೆಹುಶುವಾ ವಳಾಯಲ ಸಂಗತಿ ಬಿಜು ಕಿನೆಜ ಗ್ವತ್ತ ನ್ಹೊತು ಗೈನ ತೆ ಯೆರಿಕೊ ಗಾಮನೆ ಘನ್ನ ಸುಕ್ಷ್ಮಕ್ಹು ದೆಕೊ” ಕೈನ ಯೆಹುಶುವಾ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಕದ್ಯೊ. ತೆ ಭಂಬಿ ಜನಾ ಯೆರಿಕೊ ಗಾಮೆ ಗೈನ ಯಕ್ಕ ವ್ಯಶ್ಯಾನಾ ಘರಮಾ ರ‍್ಹಯಾ. ತೆ ಬಾಕಡಿನು ನಾಮ ‘ರಾಹಾಬ.’ <verse eid="JOS 11:1" /><verse number="2" style="v" sid="JOS 11:2" />ತೆಳಾಮಾ ಕುನ್ನ ಯಕ್ಕ ಯೆರಿಕೊ ಗಾಮನಾ ರಾಜಾನೆ ಕಾಲ ರಾತೆ ಇಸ್ರಾಯೆಲನಾ ದಕ್ಹಾ ಜನಾ ಅಪ್ನಾ ದೆಶಾ ಕಮಜೊರಿಯೊನೆ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 11:2" /><verse number="3" style="v" sid="JOS 11:3" />ತೆಳಾಮಾ ಯೆರಿಕೊ ಗಾಮನೊ ರಾಜೊ ರಾಹಾಬನೆ.ತಾರಾ ಘರೆ ಐನ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಝಾಕಿನ ಮ್ಹೆಲು ನಕೊ. ತ್ಯುನೊನೆ ಭಾರಿ ಬಲೈ ಲಿನ ಆ. ತ್ಯುನೆ ಅಪ್ನಾ ದೆಶನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಮೊಕ್ಲೊ. <verse eid="JOS 11:3" /><verse number="4" style="v" sid="JOS 11:4" />ರಾಹಾಬ ಎ ಭಂಬಿ ಜನಾವೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. ತೆನೈಸೊ ತೆ ಪುಚ್ಚಾನೆ ಆಯಲವಾಲಾವೊನೆ, ಬೆ ಮನಕ್ಹೊ ನ್ಹ್ಯಾ ಆಯಾತಾ, ತೆನೈಸೊ ತ್ಯುನೆ ಕಿಜಾಂತಾ ಆಯಾತಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನ್ಹೊತು. <verse eid="JOS 11:4" /><verse number="5" style="v" sid="JOS 11:5" />ಖಾಂಜೆ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಾನು ಟೈಮ ಥಾತಾಮಾ ತ್ಯುನೆ ಗೈಪಡ್ಯಾ. ತ್ಯುನೆ ಕಿಜಾ ಗಯಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನತ್ತಿ. ತೆನೈಸೊ ತುಮೆ ಜಲ್ದಿ ಗಯಮ ತ್ಯುನೊನೆ ಧರ ಸಕೊಶಿ” ಕದಿ. <verse eid="JOS 11:5" /><verse number="6" style="v" sid="JOS 11:6" />ತೆನೈಸೊ ತೆ ಕ್ಹರಿಮಾಜ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಛತ್ತನಾ ಉಪ್ಪರ ಬಲೈ ಲಿನ ಗೈನ ವಟ್ಟಲ ಚಾರಾಮಾ ತ್ಯುನೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. <verse eid="JOS 11:6" /><verse number="7" style="v" sid="JOS 11:7" />ರಾಜಾನಾ ಭಟ್ಟೊ ಗಾಮನಾ ಭಾರಾ ಗೈನ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಿನ ಇಸ್ರೆಲತಾ ಆಯಲ ತೆ ಭಂಬಿ ಜನಾವೊನೆ ಹುಡಕಿನ ಗಯಾ. ತ್ಯುನೆ ಯೊರ್ದನ ನದಿ ಲಕ್ಕಾ ಗೈನ ಮನಕ್ಹೊ ನದ ದಾಟಾನಾ ಕ್ಹಾಟರಾ ಜ಼ಗಾವೊಮಾ ಹುಡಕ್ಯಾ. <verse eid="JOS 11:7" /><verse number="8" style="v" sid="JOS 11:8" />ತೆ ಭಂಬಿ ಗುಡಾಚಾರಿಯೊ ತ್ಯಾಜ ಕ್ಹುರ್xಯಾವಾನೆ ತಯ್ಯಾರಿ ಕರಿಲಿದ್ಯಾತಾ. ತೆನೈಸೊ ರಾಹಾಬ ಛತ್ತನಾ ಉಪ್ಪರ ಗೈನ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="JOS 11:8" /><verse number="9" style="v" sid="JOS 11:9" />''ಯಹೊವಾ ಎ ದೆಶನೆ ತುಮಾರಾ ಮನಕ್ಹೊನೆ ದಿದ್ಯೊಸ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. ತುಮಾರಿ ವಿಶಯ ಐಕಿನ ಹಮೊನೆ ಭೆಂ ಹುಟ್ಯುಸ. ಎ ದೆಶಮಾ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ತುಮೊಕ್ಹು ಭುಚ್ಕಿನ ಛೆ. <verse eid="JOS 11:9" /><verse number="10" style="v" sid="JOS 11:10" />ಯಹೊವಾ ತುಮೊನೆ ಸಹಾಯ ಕರಲ ತರಿಕಾನಾ ಹುತಿ ಹಮೆ ಐಕಿನ ಭುಚ್ಚಕ್ಯಾಸ. ತುಮೆ ಇಜಿಪ್ಟತಾ ಭಾರಾ ಆಯಲ್ಪರ ತೆ ಲಾಲ ಸಮುಂದರನಾ ಪಾನಿನೆ ಕ್ಹುಕ್ಹಾಯಲ ಹಮೆ ಐಕ್ಯಾಸ. ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವ ದಿಕ್ಕಮಾ ರ‍್ಹಯಲ ಸಿಹೊನ ವರಿ ಒಗ್ ಕವಾನಾ ಅಮೊರಿಯನಾ ಬೆ ಜನಾ ರಾಜಾವೊನೆ ತುಮೆ ಕಿಮ್ಮ ನಾಶ ಕರ್‍ಯಾಸ ಕವಾನು ಐಕ್ಯಾಸ. <verse eid="JOS 11:10" /><verse number="11" style="v" sid="JOS 11:11" />ಎ ಕ್ಹಾರಾವೊನಾಹುತಿ ಐಕಿನ ಹಮೊನೆ ಘನ್ನು ಭೆಂ ಐಯುಸ; ಹಮೊಮಾ ಕಿನೆಜ ತುಮಾರಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರಾನೆ ಧೈರ್ಯ ನತ್ತಿ. ಕಾಕದ್ಯಾಮ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ, ಭುಪರಲೊಕನೆ ಆಳಾಲೊ ಥಯೊಸ. <verse eid="JOS 11:11" /><verse number="12" style="v" sid="JOS 11:12" />ಹಮ್ನಾ ತುಮೆ ಹಮೊನೆ ಯಕ್ಕ ಪ್ರಮಾಣ ಕರು. ಮಿ ತುಮೊನೆ ದಯಾ ದೆಕಾಡಿನ ಸಹಾಯ ಕರಿ. ತಿನಾಹುತಿ ತುಮೆಬಿ ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ದಯಾ ದೆಕಾಡೊಶಿ ಕೈನ ಯಕ್ಕ ವಳಕ ದಿವೊ. <verse eid="JOS 11:12" /><verse number="13" style="v" sid="JOS 11:13" />ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಕದ್ಯಾಮ ಮಾರಾ ಮಾ ಬಾಪನೆ, ಭಾಯೊ ಭೆನೊನೆ ವರಿ ತ್ಯುನಾ ಕ್ಹಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಜಿವ್ತಾ ಛೊಡಾನೆ ಪ್ರಮಾಣ ಕರೊ” ಕೈನ ಮಾಂಗಿಲಿದಿ. <verse eid="JOS 11:13" /><verse number="14" style="v" sid="JOS 11:14" />ತಿನಾಹುತಿ ತ್ಯುನೆ.ಹಮಾರು ಜಲಮ ದಿನಬಿ ತುಮಾರು ಜಲಮ ವಚಾ಼ಡೆಸ. ತೆನೈಸೊ ತುಮೆ ಎ ಕಿನೆಜ ಕವೊ ನಕೊ. ಯಹೊವಾ ಎ ದೆಶ ಹಮೊನೆ ದಿದಲ್ಪರ ಹಮೆ ತುಮೊನೆ ದಯಾ ದೆಕಾಡೆಸ. ತುಮೆ ಹಮೊನೆ ಬರೊಕ್ಹೊ ಕರ ಸಕೊಶಿ” ಕದ್ಯಾ. <verse eid="JOS 11:14" /><verse number="15" style="v" sid="JOS 11:15" />ರಾಹಾಬನಾ ಘರನೆ ಗಾಮನಿ ಗೊಡಿಯೆ ಲಾಗಿನ ಭಾಂದ್ಯಾತಾ <verse eid="JOS 11:15" /><verse number="16" style="v" sid="JOS 11:16" />ತುಮೆ ಪಾಚಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಮಳಲ ನಂಗತ ತೆ ಪರ್ವತನೆ ನ್ಹಾಟಿನ ಜಾವೊ ತ್ಯಾ ತನ್ನ ದಿನ ದಡಿನ ರೈನ ತ್ಯುನೆ ಗಯಲ್ಪರ ತುಮಾರಿ ವಾಟ ಧರಿನ ಜಾವೊ ಕೈನ ಕದಿ. <verse eid="JOS 11:16" /><verse number="17" style="v" sid="JOS 11:17" />ವರಿ ತ್ಯುನೆ ಹಮೆ ಕದಲ ವಾತನಿಂಗತ ತು ಚಾಲೆಲ ರ‍್ಹಯಾಮ ತು ಹಮಾರಾ ಕರಲ ಪ್ರಮಾಣಖ್ಹು ಬಿಡುಗಡೆ ಥಯೊತೊ. <verse eid="JOS 11:17" /><verse number="18" style="v" sid="JOS 11:18" />ವರಿ ಹಮೆ ಆ ಗಾಮಾ ರ‍್ಹತಾಮಾ ತು ಹಮೊನೆ ಉತಾರೆಲ ಕಿಡಕಿನೆ ಲಾಲ ದೊರೊ ಭಾಂದೊ ಕದ್ಯೊ ವರಿ ತಾರಾ ಮಾಬಾಪನೆ ಭಾಯೊನೆ ಕ್ಹಾರಾ ಸಂಬದಿಕಿಯೊನೆ ತಾರಾ ಘರಮಾ ಬಲೆಲಿದಲ ರ‍್ಹವೊ. <verse eid="JOS 11:18" /><verse number="19" style="v" sid="JOS 11:19" />ತ್ಯುನಾಮಾ ಕಯೊಬಿ ಘರ ಛೊಡಿನ ರೊಡೆ ಆಯೊರೆ ರಗತನು ಪಾಪ ವ್ಹೈ ತ್ಯುನಾ ಮಾತಾನಾ ಉಪ್ಪರ ನಿರ್ದೊಸಿಯೊ ಕೈನ ರ‍್ಹವಸ. ವರಿ ತಾರಾಖ್ಹಾತೆ ಘರಮಾ ರ‍್ಹಯಲವಾಲಾ ಉಪ್ಪರ ಹತ್ತ ಘಾಲ್ಯಾಮ ತೆ ರಗತನು ಪಾಪ ವ್ಹೈ ಅಪ್ನಾ ಮಾತಾನಾ ಉಪ್ಪರ ರ‍್ಹವಸ; <verse eid="JOS 11:19" /><verse number="20" style="v" sid="JOS 11:20" />ತೆ ನೈಸೊ ತು ಹಮಾರಾ ಸಂಗತಿಯೊನೆ ಭಾರಾ ಆವಾನಾಹುತಿ ಹಮೊಖ್ಹು ಕರಲ ಪ್ರಮಾಣಖ್ಹು ಬಿಡುಗಡೆ ಥಾವಸ ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 11:20" /><verse number="21" style="v" sid="JOS 11:21" />ತಿನಾಹುತಿ ತೆ ತುಮಾರಾ ವಾತನಿಂಗತ ಥಾವಾದೆ ಕೈನ ತ್ಯುನೊನೆ ವಳೈ; ತ್ಯುನೆ ಗಯಲ್ಪರ ತೆ ಲಾಲ ದೊರೊ ಕಿಡಕಿನೆ ಭಾಂದಿ. <verse eid="JOS 11:21" /><verse number="22" style="v" sid="JOS 11:22" />ತ್ಯುನೆ ತೆ ಪರ್ವತೆ ಗೈನ ಪಿಟ್ಟ ಲಗಾಡಿನ ಪಾಚಾ ರ‍್ಹೆಲಕ್ಕಾ ತನ್ನ ದಿನ ತ್ಯಾಜ ವ್ಹತ್ತಾ. ಪಿಟ್ಟ ಲಗಾಡಿನ ತ್ಯುನೆ ತ್ಯುನೊನೆ ವಾಟನಾ ಯುದ್ದನೆ ಹುಡಕಿನ ದೆಕಿನ ಗೈಪಡ್ಯಾ. <verse eid="JOS 11:22" /><verse number="23" style="v" sid="JOS 11:23" />ತೆಳಾಮ ತ್ಯುನೆ ಬೆಜನಾ ಡೊಂಗರಪರ್ತಾ ಉತ್ರಿನ ತಳು ದಾಟಿನ ನೂನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹುಶುವಾ ಕನ ಐನ ತ್ಯುನೊನೆ ಅನಸಾಯಲ ತಿಳಶ್ಯಾ.<verse eid="JOS 11:23" /></para>
  <chapter eid="JOS 11" />
  <chapter number="12" style="c" sid="JOS 12" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 12:1" />ನುನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ ಗಾಮನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ವಳಾಯೊ. ಎ ಮನಕ್ಹೊನೆ ಯೆಹುಶುವಾ ವಳಾಯಲ ಸಂಗತಿ ಬಿಜು ಕಿನೆಜ ಗ್ವತ್ತ ನ್ಹೊತು.ಗೈನ ತೆ ಯೆರಿಕೊ ಗಾಮನೆ ಘನ್ನ ಸುಕ್ಷ್ಮಕ್ಹು ದೆಕೊ” ಕೈನ ಯೆಹುಶುವಾ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಕದ್ಯೊ. ತೆ ಭಂಬಿ ಜನಾ ಯೆರಿಕೊ ಗಾಮೆ ಗೈನ ಯಕ್ಕ ವ್ಯಶ್ಯಾನಾ ಘರಮಾ ರ‍್ಹಯಾ. ತೆ ಬಾಕಡಿನು ನಾಮ ‘ರಾಹಾಬ.’ <verse eid="JOS 12:1" /><verse number="2" style="v" sid="JOS 12:2" />ತೆಳಾಮಾ ಕುನ್ನ ಯಕ್ಕ ಯೆರಿಕೊ ಗಾಮನಾ ರಾಜಾನೆ.ಕಾಲ ರಾತೆ ಇಸ್ರಾಯೆಲನಾ ದಕ್ಹಾ ಜನಾ ಅಪ್ನಾ ದೆಶಾ ಕಮಜೊರಿಯೊನೆ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 12:2" /><verse number="3" style="v" sid="JOS 12:3" />ತೆಳಾಮಾ ಯೆರಿಕೊ ಗಾಮನೊ ರಾಜೊ ರಾಹಾಬನೆ.ತಾರಾ ಘರೆ ಐನ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಝಾಕಿನ ಮ್ಹೆಲು ನಕೊ. ತ್ಯುನೊನೆ ಭಾರಿ ಬಲೈ ಲಿನ ಆ. ತ್ಯುನೆ ಅಪ್ನಾ ದೆಶನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಮೊಕ್ಲೊ. <verse eid="JOS 12:3" /><verse number="4" style="v" sid="JOS 12:4" />ರಾಹಾಬ ಎ ಭಂಬಿ ಜನಾವೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. ತೆನೈಸೊ ತೆ ಪುಚ್ಚಾನೆ ಆಯಲವಾಲಾವೊನೆ.ಬೆ ಮನಕ್ಹೊ ನ್ಹ್ಯಾ ಆಯಾತಾ, ತೆನೈಸೊ ತ್ಯುನೆ ಕಿಜಾಂತಾ ಆಯಾತಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನ್ಹೊತು. <verse eid="JOS 12:4" /><verse number="5" style="v" sid="JOS 12:5" />ಖಾಂಜೆ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಾನು ಟೈಮ ಥಾತಾಮಾ ತ್ಯುನೆ ಗೈಪಡ್ಯಾ. ತ್ಯುನೆ ಕಿಜಾ ಗಯಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನತ್ತಿ. ತೆನೈಸೊ ತುಮೆ ಜಲ್ದಿ ಗಯಮ ತ್ಯುನೊನೆ ಧರ ಸಕೊಶಿ” ಕದಿ. <verse eid="JOS 12:5" /><verse number="6" style="v" sid="JOS 12:6" />ತೆನೈಸೊ ತೆ ಕ್ಹರಿಮಾಜ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಛತ್ತನಾ ಉಪ್ಪರ ಬಲೈ ಲಿನ ಗೈನ ವಟ್ಟಲ ಚಾರಾಮಾ ತ್ಯುನೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. <verse eid="JOS 12:6" /><verse number="7" style="v" sid="JOS 12:7" />ರಾಜಾನಾ ಭಟ್ಟೊ ಗಾಮನಾ ಭಾರಾ ಗೈನ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಿನ ಇಸ್ರೆಲತಾ ಆಯಲ ತೆ ಭಂಬಿ ಜನಾವೊನೆ ಹುಡಕಿನ ಗಯಾ. ತ್ಯುನೆ ಯೊರ್ದನ ನದಿ ಲಕ್ಕಾ ಗೈನ ಮನಕ್ಹೊ ನದ ದಾಟಾನಾ ಕ್ಹಾಟರಾ ಜ಼ಗಾವೊಮಾ ಹುಡಕ್ಯಾ. <verse eid="JOS 12:7" /><verse number="8" style="v" sid="JOS 12:8" />ತೆ ಭಂಬಿ ಗುಡಾಚಾರಿಯೊ ತ್ಯಾಜ ಕ್ಹುರ್xಯಾವಾನೆ ತಯ್ಯಾರಿ ಕರಿಲಿದ್ಯಾತಾ. ತೆನೈಸೊ ರಾಹಾಬ ಛತ್ತನಾ ಉಪ್ಪರ ಗೈನ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="JOS 12:8" /><verse number="9" style="v" sid="JOS 12:9" />''ಯಹೊವಾ ಎ ದೆಶನೆ ತುಮಾರಾ ಮನಕ್ಹೊನೆ ದಿದ್ಯೊಸ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. ತುಮಾರಿ ವಿಶಯ ಐಕಿನ ಹಮೊನೆ ಭೆಂ ಹುಟ್ಯುಸ. ಎ ದೆಶಮಾ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ತುಮೊಕ್ಹು ಭುಚ್ಕಿನ ಛೆ. <verse eid="JOS 12:9" /><verse number="10" style="v" sid="JOS 12:10" />ಯಹೊವಾ ತುಮೊನೆ ಸಹಾಯ ಕರಲ ತರಿಕಾನಾ ಹುತಿ ಹಮೆ ಐಕಿನ ಭುಚ್ಚಕ್ಯಾಸ. ತುಮೆ ಇಜಿಪ್ಟತಾ ಭಾರಾ ಆಯಲ್ಪರ ತೆ ಲಾಲ ಸಮುಂದರನಾ ಪಾನಿನೆ ಕ್ಹುಕ್ಹಾಯಲ ಹಮೆ ಐಕ್ಯಾಸ. ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವ ದಿಕ್ಕಮಾ ರ‍್ಹಯಲ ಸಿಹೊನ ವರಿ ಒಗ್ ಕವಾನಾ ಅಮೊರಿಯನಾ ಬೆ ಜನಾ ರಾಜಾವೊನೆ ತುಮೆ ಕಿಮ್ಮ ನಾಶ ಕರ್‍ಯಾಸ ಕವಾನು ಐಕ್ಯಾಸ. <verse eid="JOS 12:10" /><verse number="11" style="v" sid="JOS 12:11" />ಎ ಕ್ಹಾರಾವೊನಾಹುತಿ ಐಕಿನ ಹಮೊನೆ ಘನ್ನು ಭೆಂ ಐಯುಸ; ಹಮೊಮಾ ಕಿನೆಜ ತುಮಾರಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರಾನೆ ಧೈರ್ಯ ನತ್ತಿ. ಕಾಕದ್ಯಾಮ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ, ಭುಪರಲೊಕನೆ ಆಳಾಲೊ ಥಯೊಸ. <verse eid="JOS 12:11" /><verse number="12" style="v" sid="JOS 12:12" />ಹಮ್ನಾ ತುಮೆ ಹಮೊನೆ ಯಕ್ಕ ಪ್ರಮಾಣ ಕರು. ಮಿ ತುಮೊನೆ ದಯಾ ದೆಕಾಡಿನ ಸಹಾಯ ಕರಿ. ತಿನಾಹುತಿ ತುಮೆಬಿ ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ದಯಾ ದೆಕಾಡೊಶಿ ಕೈನ ಯಕ್ಕ ವಳಕ ದಿವೊ. <verse eid="JOS 12:12" /><verse number="13" style="v" sid="JOS 12:13" />ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಕದ್ಯಾಮ ಮಾರಾ ಮಾ ಬಾಪನೆ, ಭಾಯೊ ಭೆನೊನೆ ವರಿ ತ್ಯುನಾ ಕ್ಹಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಜಿವ್ತಾ ಛೊಡಾನೆ ಪ್ರಮಾಣ ಕರೊ” ಕೈನ ಮಾಂಗಿಲಿದಿ. <verse eid="JOS 12:13" /><verse number="14" style="v" sid="JOS 12:14" />ತಿನಾಹುತಿ ತ್ಯುನೆ.ಹಮಾರು ಜಲಮ ದಿನಬಿ ತುಮಾರು ಜಲಮ ವಚಾ಼ಡೆಸ. ತೆನೈಸೊ ತುಮೆ ಎ ಕಿನೆಜ ಕವೊ ನಕೊ. ಯಹೊವಾ ಎ ದೆಶ ಹಮೊನೆ ದಿದಲ್ಪರ ಹಮೆ ತುಮೊನೆ ದಯಾ ದೆಕಾಡೆಸ. ತುಮೆ ಹಮೊನೆ ಬರೊಕ್ಹೊ ಕರ ಸಕೊಶಿ” ಕದ್ಯಾ. <verse eid="JOS 12:14" /><verse number="15" style="v" sid="JOS 12:15" />ರಿಲಿದ್ಯಾತಾ ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 12:15" /><verse number="16" style="v" sid="JOS 12:16" />ತುಮೆ ಪಾಚಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಮಳಲ ನಂಗತ ತೆ ಪರ್ವತನೆ ನ್ಹಾಟಿನ ಜಾವೊ ತ್ಯಾ ತನ್ನ ದಿನ ದಡಿನ ರೈನ ತ್ಯುನೆ ಗಯಲ್ಪರ ತುಮಾರಿ ವಾಟ ಧರಿನ ಜಾವೊ ಕೈನ ಕದಿ. <verse eid="JOS 12:16" /><verse number="17" style="v" sid="JOS 12:17" />ವರಿ ತ್ಯುನೆ ಹಮೆ ಕದಲ ವಾತನಿಂಗತ ತು ಚಾಲೆಲ ರ‍್ಹಯಾಮ ತು ಹಮಾರಾ ಕರಲ ಪ್ರಮಾಣಖ್ಹು ಬಿಡುಗಡೆ ಥಯೊತೊ. <verse eid="JOS 12:17" /><verse number="18" style="v" sid="JOS 12:18" />ವರಿ ಹಮೆ ಆ ಗಾಮಾ ರ‍್ಹತಾಮಾ ತು ಹಮೊನೆ ಉತಾರೆಲ ಕಿಡಕಿನೆ ಲಾಲ ದೊರೊ ಭಾಂದೊ ಕದ್ಯೊ ವರಿ ತಾರಾ ಮಾಬಾಪನೆ ಭಾಯೊನೆ ಕ್ಹಾರಾ ಸಂಬದಿಕಿಯೊನೆ ತಾರಾ ಘರಮಾ ಬಲೆಲಿದಲ ರ‍್ಹವೊ. <verse eid="JOS 12:18" /><verse number="19" style="v" sid="JOS 12:19" />ತ್ಯುನಾಮಾ ಕಯೊಬಿ ಘರ ಛೊಡಿನ ರೊಡೆ ಆಯೊರೆ ರಗತನು ಪಾಪ ವ್ಹೈ ತ್ಯುನಾ ಮಾತಾನಾ ಉಪ್ಪರ ನಿರ್ದೊಸಿಯೊ ಕೈನ ರ‍್ಹವಸ. ವರಿ ತಾರಾಖ್ಹಾತೆ ಘರಮಾ ರ‍್ಹಯಲವಾಲಾ ಉಪ್ಪರ ಹತ್ತ ಘಾಲ್ಯಾಮ ತೆ ರಗತನು ಪಾಪ ವ್ಹೈ ಅಪ್ನಾ ಮಾತಾನಾ ಉಪ್ಪರ ರ‍್ಹವಸ; <verse eid="JOS 12:19" /><verse number="20" style="v" sid="JOS 12:20" />ತೆ ನೈಸೊ ತು ಹಮಾರಾ ಸಂಗತಿಯೊನೆ ಭಾರಾ ಆವಾನಾಹುತಿ ಹಮೊಖ್ಹು ಕರಲ ಪ್ರಮಾಣಖ್ಹು ಬಿಡುಗಡೆ ಥಾವಸ ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 12:20" /><verse number="21" style="v" sid="JOS 12:21" />ತಿನಾಹುತಿ ತೆ ತುಮಾರಾ ವಾತನಿಂಗತ ಥಾವಾದೆ ಕೈನ ತ್ಯುನೊನೆ ವಳೈ; ತ್ಯುನೆ ಗಯಲ್ಪರ ತೆ ಲಾಲ ದೊರೊ ಕಿಡಕಿನೆ ಭಾಂದಿ. <verse eid="JOS 12:21" /><verse number="22" style="v" sid="JOS 12:22" />ತ್ಯುನೆ ತೆ ಪರ್ವತೆ ಗೈನ ಪಿಟ್ಟ ಲಗಾಡಿನ ಪಾಚಾ ರ‍್ಹೆಲಕ್ಕಾ ತನ್ನ ದಿನ ತ್ಯಾಜ ವ್ಹತ್ತಾ. ಪಿಟ್ಟ ಲಗಾಡಿನ ತ್ಯುನೆ ತ್ಯುನೊನೆ ವಾಟನಾ ಯುದ್ದನೆ ಹುಡಕಿನ ದೆಕಿನ ಗೈಪಡ್ಯಾ. <verse eid="JOS 12:22" /><verse number="23" style="v" sid="JOS 12:23" />ತೆಳಾಮ ತ್ಯುನೆ ಬೆಜನಾ ಡೊಂಗರಪರ್ತಾ ಉತ್ರಿನ ತಳು ದಾಟಿನ ನೂನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹುಶುವಾ ಕನ ಐನ ತ್ಯುನೊನೆ ಅನಸಾಯಲ ತಿಳಶ್ಯಾ. <verse eid="JOS 12:23" /><verse number="24" style="v" sid="JOS 12:24" />ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು ಹಮೊನೆ ದಿದ್ಯೊಸ; ತಿನಾ ನಿವಾಸಿಯೊ ಕ್ಹಾರಾ ಹಮಾರಾ ನಿಮಿತ್ತ ಕಂಗಟ್ಟನಿ ಗಯಾಸ ಕೈನ ತಿಳಶ್ಯಾ.<verse eid="JOS 12:24" /></para>
  <chapter eid="JOS 12" />
  <chapter number="13" style="c" sid="JOS 13" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 13:1" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಯೊರ್ದನನಾ ದಾಟಿನ ಗಯಲ್ಪರ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ <verse eid="JOS 13:1" /><verse number="2" style="v" sid="JOS 13:2" />ತುಮೆ ಮನಕ್ಹೊಮಾತಾ ಕುಲನಾ ಯಕ್ಲಾ ನಿಂಗತ ಬಾರಾ ಜನಾವೊನೆ ಇನಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 13:2" /><verse number="3" style="v" sid="JOS 13:3" />ಯೊರ್ದನನಾ ವಚ್ಮಾ ಯಾಜಕರೊ ಹುಬ್ರೆಲ ಜ಼ಗಾಕಂತಾ ಬಾರಾ ದಗ್ಡಾ ಉಚೈನ ತೆ ದಗ್ಡಾವೊನೆ ತುಮಾರಾ ಕ್ಹಾತೆ ಆ ಜ಼ಗಾಕನ ಲೈನ ತುಮೆ ಆ ರಾತೆ ಉತ್ರಾನಿ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡೊ ಕೈನ ಆಜ್ಞಾಕರು ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 13:3" /><verse number="4" style="v" sid="JOS 13:4" />ತೆಳಾಮಾ ಯೆಹುಶುವಾ ತೆ ಇಸ್ರಾಯಲಮಾತೊ ಕುಲತಾ ಯಕ್ಲಾ ನಿಂಗತ ಇನಿಲಿದಲ ಬಾರಾ ಜನಾ ಮನಕ್ಹೊನೆ ಬಲೈನ ತ್ಯುನೊನೆ <verse eid="JOS 13:4" /><verse number="5" style="v" sid="JOS 13:5" />ತುಮೆ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಪೈಲಾಜ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಗೈನ ಇಸ್ರಾಯೆಲ ಕುಲನಾ ನಂಬರನೆ ಕರೆಟ್ಟ ಥೌ ಕೈನ ಹರಯಕ್ಲೊ ಯಕ್ಕ ಯಕ್ಕ ದಗ್ಡೊ ಕ್ಹಾಂದಾಪರ ಉಚೈಲಿನ ಆವೊ. <verse eid="JOS 13:5" /><verse number="6" style="v" sid="JOS 13:6" />ತೆ ತುಮಾರಾ ವಚ್ಮಾ ವಳಕ ಥಾವಸ ಅಗಲ್ಯಾ ಜಲಮಮಾ ತುಮಾರಾ ಬಚ್ಚಾ ತೆ ದಗ್ಡಾ ಸು ಸುಚಿತ ಕರಸ ತುಮೊನೆ ಪುಚ್ಚ್ತಾಮಾ ತುಮೆ ತ್ಯುನೊನೆ <verse eid="JOS 13:6" /><verse number="7" style="v" sid="JOS 13:7" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನಾ ಯೊರ್ದನ ದಾಟತಾಮಾ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈಪಡ್ಯುತು ಕೈನ ಕವೊ.ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈ ಪಡ್ಯುತು ಕೈನ ಆ ದಗ್ಡಾ ಇಸ್ರಾಯಲೊನೆ ಕೆಳಾಮಾಬಿ ಸಾಕ್ಷಿ ಥಾವಸ ಕದ್ಯೊ. <verse eid="JOS 13:7" /><verse number="8" style="v" sid="JOS 13:8" />ಇಸ್ರಾಯಲೊ ಯೆಹೊಶುವಾ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಕರ‍್ಯಾ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಕದಲ ನಿಂಗತ ತ್ಯುನೆ ಇಸ್ರಾಯಲನಾ ಕುಲ ನಂಬರನಾ ನಿಂಗತ ಯೊರ್ದನನಾ ವಚ್ಮಾತಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಉಚೈನ ತ್ಯುನೆ ಉತ್ರಾನ ಜ಼ಗಾಕನ ಲೈನ ತ್ಯಾ ಹುಬ್ರಾಡ್ಯಾ. <verse eid="JOS 13:8" /><verse number="9" style="v" sid="JOS 13:9" />ತೆ ನೈಸೊ ಯೆಹುಶುವಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಲಿನ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊ ಹುಬ್ರೈಯಲ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡ್ಯಾ.ತೆ ಹಮ್ನಾತಾ ತ್ಯಾಜ ರ‍್ಹವಸ. <verse eid="JOS 13:9" /><verse number="10" style="v" sid="JOS 13:10" />ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಯೆಹುಶುವಾ ಮನಕ್ಹೊನೆ ತಿಳಸಲ ಯಹೊವಾನಾ ಅಪ್ಪಣೆ ಕ್ಹಾರಾ ತ್ಯುನೆ ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಹುಬ್ರೈಯಾ.ಮನಕ್ಹೊ ಭೆಗಿನ ತಳು ದಾಟ್ಯಾ. <verse eid="JOS 13:10" /><verse number="11" style="v" sid="JOS 13:11" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ತ್ಯಾ ಗಯಲ್ಪರ ಯಾಜಕೊ ಯಹೊವಾನಾ ಮಂಜುಷ ಕ್ಹರಿ ಥೈನ ದಾಟಿನ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮಾ ಗಯಾ. <verse eid="JOS 13:11" /><verse number="12" style="v" sid="JOS 13:12" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಯುದ್ಧ ಸಿದ್ಧ ಥೈನ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾಮಾತಾ ಗೈನ ತಳು ದಾಟಿಪಡ್ಯಾ. <verse eid="JOS 13:12" /><verse number="13" style="v" sid="JOS 13:13" />ತ್ಯುನೆ ಸುಮಾರ ಚಾಳಕ್ಹ ಹಜಾರ ಭಟ ಥೈನ ಯುದ್ಧ ಕರಾನಾಹುತಿ ಯಹೊವಾನಾ ಕ್ಹಾಮಾ ಯರಿಕೊನಾ ಬೈಲನೆ ಆಯಾ. <verse eid="JOS 13:13" /><verse number="14" style="v" sid="JOS 13:14" />ತೆ ದಿನ್ನೆ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾರಾ ನಜರಮಾ ಘನ ಪಡಸಲಕ್ಹು ಮೊಶೆಮಾ ಕಿಮ್ಮ ತಿಮ್ಮಜ ಅನಾಮಾಬಿ ಇನಾ ಜಿವಕ್ಹು ದಿನಕ್ಹಾರೊ ಭಯ ಭಕ್ತಿವಾಲಾ ವ್ಹತ್ತಾ. <verse eid="JOS 13:14" /><verse number="15" style="v" sid="JOS 13:15" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 13:15" /><verse number="16" style="v" sid="JOS 13:16" />ಯೊರ್ದನನತಾ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕವಾನೆ <verse eid="JOS 13:16" /><verse number="17" style="v" sid="JOS 13:17" />ತೆ ತೆ ಯಾಜಕೊನೆ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕದ್ಯೊ. <verse eid="JOS 13:17" /><verse number="18" style="v" sid="JOS 13:18" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ಯೊರ್ದನತಾ ಉಪ್ಪರ ಐನ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ ತ್ಯುನಾ ಪಗೊ ಮ್ಹೆಲೆಲ್ಪರ ಪಾನಿ ಪೈಲಾತುಜ ಐನ ಯೊರ್ದನನು ತಳು ಭರಿನ ವ್ಹೈನ ಚಾಲ್ಯುತು. <verse eid="JOS 13:18" /><verse number="19" style="v" sid="JOS 13:19" />ಮನಕ್ಹೊ ಯಕವಾ ಮ್ಹೈನಾನಾ ದಕ್ಹವಾ ದಿನಮಾ ಯೊರ್ದನ ದಾಟಿನ ಯೆರಿಕೊನಾ ಪೂರ್ವ ಪ್ರಾಂತ್ಯಮಾ ರ‍್ಹವಾನು ಗಿಲ್ಗಾಲ ಕವಾನಾ ಗಾಮಾ ಉತ್ರ್ಯಾ. <verse eid="JOS 13:19" /><verse number="20" style="v" sid="JOS 13:20" />ಯೆಹುಶುವಾ ಯೊರ್ದನತೊ ಲಿನ ಆಯಲ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಗಿಲ್ಗಾಲಮಾ ಹುಬ್ರಾಡಿನ ಇಸ್ರಾಯಲೊನೆ <verse eid="JOS 13:20" /><verse number="21" style="v" sid="JOS 13:21" />ಅಗಲ್ಯಾ ಕಾಲಮಾ ತುಮಾರಾ ಬಚ್ಚಾ ಆ ದಗ್ಡಾವೊನೆ ಕಾ ಹುಬ್ರಾಡ್ಯಾಸ ಕದ್ಯಾಮ ತುಮೊನೆ ಪುಚ್ಯಾಮ ತುಮೆ ತ್ಯುನೊನೆ <verse eid="JOS 13:21" /><verse number="22" style="v" sid="JOS 13:22" />ಇಸ್ರಾಯಲೊ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ ಥಯಲ ಆ ಯೊರ್ದನ ದಾಟಿನ ಆಯಲಕ್ಹು ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 13:22" /><verse number="23" style="v" sid="JOS 13:23" />ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ ನಂಗತ ಹಮ್ನಾ ಅಪೊನಾ ಕ್ಹಾಮಾ ಆ ಯೊರ್ದನೆ ಬತ್ತಿನ ತುಮೊನೆ ದಟಾಡ್ಯೊಸ. <verse eid="JOS 13:23" /><verse number="24" style="v" sid="JOS 13:24" />ಇನಾಹುತಿ ಭುಲೊಕನಾ ಕ್ಹಾರಾ ಯಹೊವಾನಾ ಹಸ್ತ ಪರಾಕ್ರಮ ವ್ಹೈಕೈನ ತಿಳ್ದಿಲಿವಸ ತುಮಾರಾ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಕೆಳಾಮಾಬಿ ಬುಚ್ಕಾಲಾ ವ್ಹೈ ಕದ್ಯೊ. <verse eid="JOS 13:24" /><verse number="25" style="v" sid="JOS 13:25" />ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು ಹಮೊನೆ ದಿದ್ಯೊಸ; ತಿನಾ ನಿವಾಸಿಯೊ ಕ್ಹಾರಾ ಹಮಾರಾ ನಿಮಿತ್ತ ಕಂಗಟ್ಟನಿ ಗಯಾಸ ಕೈನ ತಿಳಶ್ಯಾ. <verse eid="JOS 13:25" /><verse number="26" style="v" sid="JOS 13:26" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 13:26" /><verse number="27" style="v" sid="JOS 13:27" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 13:27" /><verse number="28" style="v" sid="JOS 13:28" />ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು ಹಮೊನೆ ದಿದ್ಯೊಸ; ತಿನಾ ನಿವಾಸಿಯೊ ಕ್ಹಾರಾ ಹಮಾರಾ ನಿಮಿತ್ತ ಕಂಗಟ್ಟನಿ ಗಯಾಸ ಕೈನ ತಿಳಶ್ಯಾ. <verse eid="JOS 13:28" /><verse number="29" style="v" sid="JOS 13:29" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 13:29" /><verse number="30" style="v" sid="JOS 13:30" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 13:30" /><verse number="31" style="v" sid="JOS 13:31" />ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು ಹಮೊನೆ ದಿದ್ಯೊಸ; ತಿನಾ ನಿವಾಸಿಯೊ ಕ್ಹಾರಾ ಹಮಾರಾ ನಿಮಿತ್ತ ಕಂಗಟ್ಟನಿ ಗಯಾಸ ಕೈನ ತಿಳಶ್ಯಾ. <verse eid="JOS 13:31" /><verse number="32" style="v" sid="JOS 13:32" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 13:32" /><verse number="33" style="v" sid="JOS 13:33" />ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು ಹಮೊನೆ ದಿದ್ಯೊಸ; ತಿನಾ ನಿವಾಸಿಯೊ ಕ್ಹಾರಾ ಹಮಾರಾ ನಿಮಿತ್ತ ಕಂಗಟ್ಟನಿ ಗಯಾಸ ಕೈನ ತಿಳಶ್ಯಾ.<verse eid="JOS 13:33" /></para>
  <chapter eid="JOS 13" />
  <chapter number="14" style="c" sid="JOS 14" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 14:1" />ನುನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ ಗಾಮನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ವಳಾಯೊ. ಎ ಮನಕ್ಹೊನೆ ಯೆಹುಶುವಾ ವಳಾಯಲ ಸಂಗತಿ ಬಿಜು ಕಿನೆಜ ಗ್ವತ್ತ ನ್ಹೊತು.ಗೈನ ತೆ ಯೆರಿಕೊ ಗಾಮನೆ ಘನ್ನ ಸುಕ್ಷ್ಮಕ್ಹು ದೆಕೊ” ಕೈನ ಯೆಹುಶುವಾ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಕದ್ಯೊ. ತೆ ಭಂಬಿ ಜನಾ ಯೆರಿಕೊ ಗಾಮೆ ಗೈನ ಯಕ್ಕ ವ್ಯಶ್ಯಾನಾ ಘರಮಾ ರ‍್ಹಯಾ. ತೆ ಬಾಕಡಿನು ನಾಮ ‘ರಾಹಾಬ.’ <verse eid="JOS 14:1" /><verse number="2" style="v" sid="JOS 14:2" />ತೆಳಾಮಾ ಕುನ್ನ ಯಕ್ಕ ಯೆರಿಕೊ ಗಾಮನಾ ರಾಜಾನೆ.ಕಾಲ ರಾತೆ ಇಸ್ರಾಯೆಲನಾ ದಕ್ಹಾ ಜನಾ ಅಪ್ನಾ ದೆಶಾ ಕಮಜೊರಿಯೊನೆ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 14:2" /><verse number="3" style="v" sid="JOS 14:3" />ತೆಳಾಮಾ ಯೆರಿಕೊ ಗಾಮನೊ ರಾಜೊ ರಾಹಾಬನೆ.ತಾರಾ ಘರೆ ಐನ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಝಾಕಿನ ಮ್ಹೆಲು ನಕೊ. ತ್ಯುನೊನೆ ಭಾರಿ ಬಲೈ ಲಿನ ಆ. ತ್ಯುನೆ ಅಪ್ನಾ ದೆಶನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಮೊಕ್ಲೊ. <verse eid="JOS 14:3" /><verse number="4" style="v" sid="JOS 14:4" />ಆಯಲವಾಲಾವೊನೆ.ಬೆ ಮನಕ್ಹೊ ನ್ಹ್ಯಾ ಆಯಾತಾ, ತೆನೈಸೊ ತ್ಯುನೆ ಕಿಜಾಂತಾ ಆಯಾತಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನ್ಹೊತು. <verse eid="JOS 14:4" /><verse number="5" style="v" sid="JOS 14:5" />ಖಾಂಜೆ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಾನು ಟೈಮ ಥಾತಾಮಾ ತ್ಯುನೆ ಗೈಪಡ್ಯಾ. ತ್ಯುನೆ ಕಿಜಾ ಗಯಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನತ್ತಿ. ತೆನೈಸೊ ತುಮೆ ಜಲ್ದಿ ಗಯಮ ತ್ಯುನೊನೆ ಧರ ಸಕೊಶಿ” ಕದಿ. <verse eid="JOS 14:5" /><verse number="6" style="v" sid="JOS 14:6" />ತೆನೈಸೊ ತೆ ಕ್ಹರಿಮಾಜ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಛತ್ತನಾ ಉಪ್ಪರ ಬಲೈ ಲಿನ ಗೈನ ವಟ್ಟಲ ಚಾರಾಮಾ ತ್ಯುನೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. <verse eid="JOS 14:6" /><verse number="7" style="v" sid="JOS 14:7" />ರಾಜಾನಾ ಭಟ್ಟೊ ಗಾಮನಾ ಭಾರಾ ಗೈನ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಿನ ಇಸ್ರೆಲತಾ ಆಯಲ ತೆ ಭಂಬಿ ಜನಾವೊನೆ ಹುಡಕಿನ ಗಯಾ. ತ್ಯುನೆ ಯೊರ್ದನ ನದಿ ಲಕ್ಕಾ ಗೈನ ಮನಕ್ಹೊ ನದ ದಾಟಾನಾ ಕ್ಹಾಟರಾ ಜ಼ಗಾವೊಮಾ ಹುಡಕ್ಯಾ. <verse eid="JOS 14:7" /><verse number="8" style="v" sid="JOS 14:8" />ತೆ ಭಂಬಿ ಗುಡಾಚಾರಿಯೊ ತ್ಯಾಜ ಕ್ಹುರ್xಯಾವಾನೆ ತಯ್ಯಾರಿ ಕರಿಲಿದ್ಯಾತಾ. ತೆನೈಸೊ ರಾಹಾಬ ಛತ್ತನಾ ಉಪ್ಪರ ಗೈನ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="JOS 14:8" /><verse number="9" style="v" sid="JOS 14:9" />''ಯಹೊವಾ ಎ ದೆಶನೆ ತುಮಾರಾ ಮನಕ್ಹೊನೆ ದಿದ್ಯೊಸ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. ತುಮಾರಿ ವಿಶಯ ಐಕಿನ ಹಮೊನೆ ಭೆಂ ಹುಟ್ಯುಸ. ಎ ದೆಶಮಾ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ತುಮೊಕ್ಹು ಭುಚ್ಕಿನ ಛೆ. <verse eid="JOS 14:9" /><verse number="10" style="v" sid="JOS 14:10" />ಯಹೊವಾ ತುಮೊನೆ ಸಹಾಯ ಕರಲ ತರಿಕಾನಾ ಹುತಿ ಹಮೆ ಐಕಿನ ಭುಚ್ಚಕ್ಯಾಸ. ತುಮೆ ಇಜಿಪ್ಟತಾ ಭಾರಾ ಆಯಲ್ಪರ ತೆ ಲಾಲ ಸಮುಂದರನಾ ಪಾನಿನೆ ಕ್ಹುಕ್ಹಾಯಲ ಹಮೆ ಐಕ್ಯಾಸ. ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವ ದಿಕ್ಕಮಾ ರ‍್ಹಯಲ ಸಿಹೊನ ವರಿ ಒಗ್ ಕವಾನಾ ಅಮೊರಿಯನಾ ಬೆ ಜನಾ ರಾಜಾವೊನೆ ತುಮೆ ಕಿಮ್ಮ ನಾಶ ಕರ್‍ಯಾಸ ಕವಾನು ಐಕ್ಯಾಸ. <verse eid="JOS 14:10" /><verse number="11" style="v" sid="JOS 14:11" />ಎ ಕ್ಹಾರಾವೊನಾಹುತಿ ಐಕಿನ ಹಮೊನೆ ಘನ್ನು ಭೆಂ ಐಯುಸ; ಹಮೊಮಾ ಕಿನೆಜ ತುಮಾರಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರಾನೆ ಧೈರ್ಯ ನತ್ತಿ. ಕಾಕದ್ಯಾಮ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ, ಭುಪರಲೊಕನೆ ಆಳಾಲೊ ಥಯೊಸ. <verse eid="JOS 14:11" /><verse number="12" style="v" sid="JOS 14:12" />ಹಮ್ನಾ ತುಮೆ ಹಮೊನೆ ಯಕ್ಕ ಪ್ರಮಾಣ ಕರು. ಮಿ ತುಮೊನೆ ದಯಾ ದೆಕಾಡಿನ ಸಹಾಯ ಕರಿ. ತಿನಾಹುತಿ ತುಮೆಬಿ ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ದಯಾ ದೆಕಾಡೊಶಿ ಕೈನ ಯಕ್ಕ ವಳಕ ದಿವೊ. <verse eid="JOS 14:12" /><verse number="13" style="v" sid="JOS 14:13" />ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಕದ್ಯಾಮ ಮಾರಾ ಮಾ ಬಾಪನೆ, ಭಾಯೊ ಭೆನೊನೆ ವರಿ ತ್ಯುನಾ ಕ್ಹಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಜಿವ್ತಾ ಛೊಡಾನೆ ಪ್ರಮಾಣ ಕರೊ” ಕೈನ ಮಾಂಗಿಲಿದಿ. <verse eid="JOS 14:13" /><verse number="14" style="v" sid="JOS 14:14" />ತಿನಾಹುತಿ ತ್ಯುನೆ.ಹಮಾರು ಜಲಮ ದಿನಬಿ ತುಮಾರು ಜಲಮ ವಚಾ಼ಡೆಸ. ತೆನೈಸೊ ತುಮೆ ಎ ಕಿನೆಜ ಕವೊ ನಕೊ. ಯಹೊವಾ ಎ ದೆಶ ಹಮೊನೆ ದಿದಲ್ಪರ ಹಮೆ ತುಮೊನೆ ದಯಾ ದೆಕಾಡೆಸ. ತುಮೆ ಹಮೊನೆ ಬರೊಕ್ಹೊ ಕರ ಸಕೊಶಿ” ಕದ್ಯಾ. <verse eid="JOS 14:14" /><verse number="15" style="v" sid="JOS 14:15" />ರಾಹಾಬನಾ ಘರನೆ ಗಾಮನಿ ಗೊಡಿಯೆ ಲಾಗಿನ ಭಾಂದ್ಯಾತಾ<verse eid="JOS 14:15" /></para>
  <chapter eid="JOS 14" />
  <chapter number="15" style="c" sid="JOS 15" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 15:1" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಯೊರ್ದನನಾ ದಾಟಿನ ಗಯಲ್ಪರ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ <verse eid="JOS 15:1" /><verse number="2" style="v" sid="JOS 15:2" />ತುಮೆ ಮನಕ್ಹೊಮಾತಾ ಕುಲನಾ ಯಕ್ಲಾ ನಿಂಗತ ಬಾರಾ ಜನಾವೊನೆ ಇನಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 15:2" /><verse number="3" style="v" sid="JOS 15:3" />ಯೊರ್ದನನಾ ವಚ್ಮಾ ಯಾಜಕರೊ ಹುಬ್ರೆಲ ಜ಼ಗಾಕಂತಾ ಬಾರಾ ದಗ್ಡಾ ಉಚೈನ ತೆ ದಗ್ಡಾವೊನೆ ತುಮಾರಾ ಕ್ಹಾತೆ ಆ ಜ಼ಗಾಕನ ಲೈನ ತುಮೆ ಆ ರಾತೆ ಉತ್ರಾನಿ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡೊ ಕೈನ ಆಜ್ಞಾಕರು ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 15:3" /><verse number="4" style="v" sid="JOS 15:4" />ತೆಳಾಮಾ ಯೆಹುಶುವಾ ತೆ ಇಸ್ರಾಯಲಮಾತೊ ಕುಲತಾ ಯಕ್ಲಾ ನಿಂಗತ ಇನಿಲಿದಲ ಬಾರಾ ಜನಾ ಮನಕ್ಹೊನೆ ಬಲೈನ ತ್ಯುನೊನೆ <verse eid="JOS 15:4" /><verse number="5" style="v" sid="JOS 15:5" />ತುಮೆ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಪೈಲಾಜ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಗೈನ ಇಸ್ರಾಯೆಲ ಕುಲನಾ ನಂಬರನೆ ಕರೆಟ್ಟ ಥೌ ಕೈನ ಹರಯಕ್ಲೊ ಯಕ್ಕ ಯಕ್ಕ ದಗ್ಡೊ ಕ್ಹಾಂದಾಪರ ಉಚೈಲಿನ ಆವೊ. <verse eid="JOS 15:5" /><verse number="6" style="v" sid="JOS 15:6" />ತೆ ತುಮಾರಾ ವಚ್ಮಾ ವಳಕ ಥಾವಸ ಅಗಲ್ಯಾ ಜಲಮಮಾ ತುಮಾರಾ ಬಚ್ಚಾ ತೆ ದಗ್ಡಾ ಸು ಸುಚಿತ ಕರಸ ತುಮೊನೆ ಪುಚ್ಚ್ತಾಮಾ ತುಮೆ ತ್ಯುನೊನೆ <verse eid="JOS 15:6" /><verse number="7" style="v" sid="JOS 15:7" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನಾ ಯೊರ್ದನ ದಾಟತಾಮಾ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈಪಡ್ಯುತು ಕೈನ ಕವೊ.ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈ ಪಡ್ಯುತು ಕೈನ ಆ ದಗ್ಡಾ ಇಸ್ರಾಯಲೊನೆ ಕೆಳಾಮಾಬಿ ಸಾಕ್ಷಿ ಥಾವಸ ಕದ್ಯೊ. <verse eid="JOS 15:7" /><verse number="8" style="v" sid="JOS 15:8" />ಇಸ್ರಾಯಲೊ ಯೆಹೊಶುವಾ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಕರ‍್ಯಾ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಕದಲ ನಿಂಗತ ತ್ಯುನೆ ಇಸ್ರಾಯಲನಾ ಕುಲ ನಂಬರನಾ ನಿಂಗತ ಯೊರ್ದನನಾ ವಚ್ಮಾತಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಉಚೈನ ತ್ಯುನೆ ಉತ್ರಾನ ಜ಼ಗಾಕನ ಲೈನ ತ್ಯಾ ಹುಬ್ರಾಡ್ಯಾ. <verse eid="JOS 15:8" /><verse number="9" style="v" sid="JOS 15:9" />ತೆ ನೈಸೊ ಯೆಹುಶುವಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಲಿನ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊ ಹುಬ್ರೈಯಲ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡ್ಯಾ.ತೆ ಹಮ್ನಾತಾ ತ್ಯಾಜ ರ‍್ಹವಸ. <verse eid="JOS 15:9" /><verse number="10" style="v" sid="JOS 15:10" />ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಯೆಹುಶುವಾ ಮನಕ್ಹೊನೆ ತಿಳಸಲ ಯಹೊವಾನಾ ಅಪ್ಪಣೆ ಕ್ಹಾರಾ ತ್ಯುನೆ ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಹುಬ್ರೈಯಾ.ಮನಕ್ಹೊ ಭೆಗಿನ ತಳು ದಾಟ್ಯಾ. <verse eid="JOS 15:10" /><verse number="11" style="v" sid="JOS 15:11" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ತ್ಯಾ ಗಯಲ್ಪರ ಯಾಜಕೊ ಯಹೊವಾನಾ ಮಂಜುಷ ಕ್ಹರಿ ಥೈನ ದಾಟಿನ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮಾ ಗಯಾ. <verse eid="JOS 15:11" /><verse number="12" style="v" sid="JOS 15:12" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಯುದ್ಧ ಸಿದ್ಧ ಥೈನ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾಮಾತಾ ಗೈನ ತಳು ದಾಟಿಪಡ್ಯಾ. <verse eid="JOS 15:12" /><verse number="13" style="v" sid="JOS 15:13" />ತ್ಯುನೆ ಸುಮಾರ ಚಾಳಕ್ಹ ಹಜಾರ ಭಟ ಥೈನ ಯುದ್ಧ ಕರಾನಾಹುತಿ ಯಹೊವಾನಾ ಕ್ಹಾಮಾ ಯರಿಕೊನಾ ಬೈಲನೆ ಆಯಾ. <verse eid="JOS 15:13" /><verse number="14" style="v" sid="JOS 15:14" />ತೆ ದಿನ್ನೆ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾರಾ ನಜರಮಾ ಘನ ಪಡಸಲಕ್ಹು ಮೊಶೆಮಾ ಕಿಮ್ಮ ತಿಮ್ಮಜ ಅನಾಮಾಬಿ ಇನಾ ಜಿವಕ್ಹು ದಿನಕ್ಹಾರೊ ಭಯ ಭಕ್ತಿವಾಲಾ ವ್ಹತ್ತಾ. <verse eid="JOS 15:14" /><verse number="15" style="v" sid="JOS 15:15" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 15:15" /><verse number="16" style="v" sid="JOS 15:16" />ಯೊರ್ದನನತಾ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕವಾನೆ <verse eid="JOS 15:16" /><verse number="17" style="v" sid="JOS 15:17" />ತೆ ತೆ ಯಾಜಕೊನೆ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕದ್ಯೊ. <verse eid="JOS 15:17" /><verse number="18" style="v" sid="JOS 15:18" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ಯೊರ್ದನತಾ ಉಪ್ಪರ ಐನ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ ತ್ಯುನಾ ಪಗೊ ಮ್ಹೆಲೆಲ್ಪರ ಪಾನಿ ಪೈಲಾತುಜ ಐನ ಯೊರ್ದನನು ತಳು ಭರಿನ ವ್ಹೈನ ಚಾಲ್ಯುತು. <verse eid="JOS 15:18" /><verse number="19" style="v" sid="JOS 15:19" />ಮನಕ್ಹೊ ಯಕವಾ ಮ್ಹೈನಾನಾ ದಕ್ಹವಾ ದಿನಮಾ ಯೊರ್ದನ ದಾಟಿನ ಯೆರಿಕೊನಾ ಪೂರ್ವ ಪ್ರಾಂತ್ಯಮಾ ರ‍್ಹವಾನು ಗಿಲ್ಗಾಲ ಕವಾನಾ ಗಾಮಾ ಉತ್ರ್ಯಾ. <verse eid="JOS 15:19" /><verse number="20" style="v" sid="JOS 15:20" />ಯೆಹುಶುವಾ ಯೊರ್ದನತೊ ಲಿನ ಆಯಲ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಗಿಲ್ಗಾಲಮಾ ಹುಬ್ರಾಡಿನ ಇಸ್ರಾಯಲೊನೆ <verse eid="JOS 15:20" /><verse number="21" style="v" sid="JOS 15:21" />ಅಗಲ್ಯಾ ಕಾಲಮಾ ತುಮಾರಾ ಬಚ್ಚಾ ಆ ದಗ್ಡಾವೊನೆ ಕಾ ಹುಬ್ರಾಡ್ಯಾಸ ಕದ್ಯಾಮ ತುಮೊನೆ ಪುಚ್ಯಾಮ ತುಮೆ ತ್ಯುನೊನೆ <verse eid="JOS 15:21" /><verse number="22" style="v" sid="JOS 15:22" />ಇಸ್ರಾಯಲೊ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ ಥಯಲ ಆ ಯೊರ್ದನ ದಾಟಿನ ಆಯಲಕ್ಹು ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 15:22" /><verse number="23" style="v" sid="JOS 15:23" />ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ ನಂಗತ ಹಮ್ನಾ ಅಪೊನಾ ಕ್ಹಾಮಾ ಆ ಯೊರ್ದನೆ ಬತ್ತಿನ ತುಮೊನೆ ದಟಾಡ್ಯೊಸ. <verse eid="JOS 15:23" /><verse number="24" style="v" sid="JOS 15:24" />ಇನಾಹುತಿ ಭುಲೊಕನಾ ಕ್ಹಾರಾ ಯಹೊವಾನಾ ಹಸ್ತ ಪರಾಕ್ರಮ ವ್ಹೈಕೈನ ತಿಳ್ದಿಲಿವಸ ತುಮಾರಾ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಕೆಳಾಮಾಬಿ ಬುಚ್ಕಾಲಾ ವ್ಹೈ ಕದ್ಯೊ. <verse eid="JOS 15:24" /><verse number="25" style="v" sid="JOS 15:25" />ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ <verse eid="JOS 15:25" /><verse number="26" style="v" sid="JOS 15:26" />ತುಮೆ ಮನಕ್ಹೊಮಾತಾ ಕುಲನಾ ಯಕ್ಲಾ ನಿಂಗತ ಬಾರಾ ಜನಾವೊನೆ ಇನಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 15:26" /><verse number="27" style="v" sid="JOS 15:27" />ತುಮೆ ಮನಕ್ಹೊಮಾತಾ ಕುಲನಾ ಯಕ್ಲಾ ನಿಂಗತ ಬಾರಾ ಜನಾವೊನೆ ಇನಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 15:27" /><verse number="28" style="v" sid="JOS 15:28" />ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ <verse eid="JOS 15:28" /><verse number="29" style="v" sid="JOS 15:29" />ತುಮೆ ಮನಕ್ಹೊಮಾತಾ ಕುಲನಾ ಯಕ್ಲಾ ನಿಂಗತ ಬಾರಾ ಜನಾವೊನೆ ಇನಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 15:29" /><verse number="30" style="v" sid="JOS 15:30" />ಯೆಹುಶುವಾ ಯೊರ್ದನತೊ ಲಿನ ಆಯಲ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಗಿಲ್ಗಾಲಮಾ ಹುಬ್ರಾಡಿನ ಇಸ್ರಾಯಲೊನೆ <verse eid="JOS 15:30" /><verse number="31" style="v" sid="JOS 15:31" />ಯೆಹುಶುವಾ ಯೊರ್ದನತೊ ಲಿನ ಆಯಲ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಗಿಲ್ಗಾಲಮಾ ಹುಬ್ರಾಡಿನ ಇಸ್ರಾಯಲೊನೆ <verse eid="JOS 15:31" /><verse number="32" style="v" sid="JOS 15:32" />ತುಮೆ ಮನಕ್ಹೊಮಾತಾ ಕುಲನಾ ಯಕ್ಲಾ ನಿಂಗತ ಬಾರಾ ಜನಾವೊನೆ ಇನಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 15:32" /><verse number="33" style="v" sid="JOS 15:33" />ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ <verse eid="JOS 15:33" /><verse number="34" style="v" sid="JOS 15:34" />ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ <verse eid="JOS 15:34" /><verse number="35" style="v" sid="JOS 15:35" />ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ <verse eid="JOS 15:35" /><verse number="36" style="v" sid="JOS 15:36" />ಯೆಹುಶುವಾ ಯೊರ್ದನತೊ ಲಿನ ಆಯಲ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಗಿಲ್ಗಾಲಮಾ ಹುಬ್ರಾಡಿನ ಇಸ್ರಾಯಲೊನೆ <verse eid="JOS 15:36" /><verse number="37" style="v" sid="JOS 15:37" />ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ <verse eid="JOS 15:37" /><verse number="38" style="v" sid="JOS 15:38" />ಯೆಹುಶುವಾ ಯೊರ್ದನತೊ ಲಿನ ಆಯಲ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಗಿಲ್ಗಾಲಮಾ ಹುಬ್ರಾಡಿನ ಇಸ್ರಾಯಲೊನೆ <verse eid="JOS 15:38" /><verse number="39" style="v" sid="JOS 15:39" />ಯೆಹುಶುವಾ ಯೊರ್ದನತೊ ಲಿನ ಆಯಲ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಗಿಲ್ಗಾಲಮಾ ಹುಬ್ರಾಡಿನ ಇಸ್ರಾಯಲೊನೆ <verse eid="JOS 15:39" /><verse number="40" style="v" sid="JOS 15:40" />ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ <verse eid="JOS 15:40" /><verse number="41" style="v" sid="JOS 15:41" />ಯೆಹುಶುವಾ ಯೊರ್ದನತೊ ಲಿನ ಆಯಲ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಗಿಲ್ಗಾಲಮಾ ಹುಬ್ರಾಡಿನ ಇಸ್ರಾಯಲೊನೆ <verse eid="JOS 15:41" /><verse number="42" style="v" sid="JOS 15:42" />ಯೆಹುಶುವಾ ಯೊರ್ದನತೊ ಲಿನ ಆಯಲ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಗಿಲ್ಗಾಲಮಾ ಹುಬ್ರಾಡಿನ ಇಸ್ರಾಯಲೊನೆ <verse eid="JOS 15:42" /><verse number="43" style="v" sid="JOS 15:43" />ಪೂರ್ವ ಪ್ರಾಂತ್ಯಮಾ ರ‍್ಹವಾನು ಗಿಲ್ಗಾಲ ಕವಾನಾ ಗಾಮಾ ಉತ್ರ್ಯಾ. <verse eid="JOS 15:43" /><verse number="44" style="v" sid="JOS 15:44" />ಪೂರ್ವ ಪ್ರಾಂತ್ಯಮಾ ರ‍್ಹವಾನು ಗಿಲ್ಗಾಲ ಕವಾನಾ ಗಾಮಾ ಉತ್ರ್ಯಾ. <verse eid="JOS 15:44" /><verse number="45" style="v" sid="JOS 15:45" />ಪೂರ್ವ ಪ್ರಾಂತ್ಯಮಾ ರ‍್ಹವಾನು ಗಿಲ್ಗಾಲ ಕವಾನಾ ಗಾಮಾ ಉತ್ರ್ಯಾ. <verse eid="JOS 15:45" /><verse number="46" style="v" sid="JOS 15:46" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 15:46" /><verse number="47" style="v" sid="JOS 15:47" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 15:47" /><verse number="48" style="v" sid="JOS 15:48" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 15:48" /><verse number="49" style="v" sid="JOS 15:49" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ಯೊರ್ದನತಾ ಉಪ್ಪರ ಐನ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ <verse eid="JOS 15:49" /><verse number="50" style="v" sid="JOS 15:50" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 15:50" /><verse number="51" style="v" sid="JOS 15:51" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 15:51" /><verse number="52" style="v" sid="JOS 15:52" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ಯೊರ್ದನತಾ ಉಪ್ಪರ ಐನ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ <verse eid="JOS 15:52" /><verse number="53" style="v" sid="JOS 15:53" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 15:53" /><verse number="54" style="v" sid="JOS 15:54" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ಯೊರ್ದನತಾ ಉಪ್ಪರ ಐನ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ <verse eid="JOS 15:54" /><verse number="55" style="v" sid="JOS 15:55" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 15:55" /><verse number="56" style="v" sid="JOS 15:56" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 15:56" /><verse number="57" style="v" sid="JOS 15:57" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 15:57" /><verse number="58" style="v" sid="JOS 15:58" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 15:58" /><verse number="59" style="v" sid="JOS 15:59" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ಯೊರ್ದನತಾ ಉಪ್ಪರ ಐನ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ <verse eid="JOS 15:59" /><verse number="60" style="v" sid="JOS 15:60" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 15:60" /><verse number="61" style="v" sid="JOS 15:61" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 15:61" /><verse number="62" style="v" sid="JOS 15:62" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 15:62" /><verse number="63" style="v" sid="JOS 15:63" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ಯೊರ್ದನತಾ ಉಪ್ಪರ ಐನ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ<verse eid="JOS 15:63" /></para>
  <chapter eid="JOS 15" />
  <chapter number="16" style="c" sid="JOS 16" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 16:1" />ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ ಗಾಮನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ವಳಾಯೊ. ಎ ಮನಕ್ಹೊನೆ ಯೆಹುಶುವಾ ವಳಾಯಲ ಸಂಗತಿ ಬಿಜು ಕಿನೆಜ ಗ್ವತ್ತ ನ್ಹೊತು.ಗೈನ ತೆ ಯೆರಿಕೊ ಗಾಮನೆ ಘನ್ನ ಸುಕ್ಷ್ಮಕ್ಹು ದೆಕೊ” ಕೈನ ಯೆಹುಶುವಾ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಕದ್ಯೊ. ತೆ ಭಂಬಿ ಜನಾ ಯೆರಿಕೊ ಗಾಮೆ ಗೈನ ಯಕ್ಕ ವ್ಯಶ್ಯಾನಾ ಘರಮಾ ರ‍್ಹಯಾ. ತೆ ಬಾಕಡಿನು ನಾಮ ‘ರಾಹಾಬ.’ <verse eid="JOS 16:1" /><verse number="2" style="v" sid="JOS 16:2" />ತೆಳಾಮಾ ಕುನ್ನ ಯಕ್ಕ ಯೆರಿಕೊ ಗಾಮನಾ ರಾಜಾನೆ.ಕಾಲ ರಾತೆ ಇಸ್ರಾಯೆಲನಾ ದಕ್ಹಾ ಜನಾ ಅಪ್ನಾ ದೆಶಾ ಕಮಜೊರಿಯೊನೆ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 16:2" /><verse number="3" style="v" sid="JOS 16:3" />ತೆಳಾಮಾ ಯೆರಿಕೊ ಗಾಮನೊ ರಾಜೊ ರಾಹಾಬನೆ.ತಾರಾ ಘರೆ ಐನ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಝಾಕಿನ ಮ್ಹೆಲು ನಕೊ. ತ್ಯುನೊನೆ ಭಾರಿ ಬಲೈ ಲಿನ ಆ. ತ್ಯುನೆ ಅಪ್ನಾ ದೆಶನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಮೊಕ್ಲೊ. <verse eid="JOS 16:3" /><verse number="4" style="v" sid="JOS 16:4" />ರಾಹಾಬ ಎ ಭಂಬಿ ಜನಾವೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. ತೆನೈಸೊ ತೆ ಪುಚ್ಚಾನೆ ಆಯಲವಾಲಾವೊನೆ.ಬೆ ಮನಕ್ಹೊ ನ್ಹ್ಯಾ ಆಯಾತಾ, ತೆನೈಸೊ ತ್ಯುನೆ ಕಿಜಾಂತಾ ಆಯಾತಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನ್ಹೊತು. <verse eid="JOS 16:4" /><verse number="5" style="v" sid="JOS 16:5" />ಖಾಂಜೆ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಾನು ಟೈಮ ಥಾತಾಮಾ ತ್ಯುನೆ ಗೈಪಡ್ಯಾ. ತ್ಯುನೆ ಕಿಜಾ ಗಯಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನತ್ತಿ. ತೆನೈಸೊ ತುಮೆ ಜಲ್ದಿ ಗಯಮ ತ್ಯುನೊನೆ ಧರ ಸಕೊಶಿ” ಕದಿ. <verse eid="JOS 16:5" /><verse number="6" style="v" sid="JOS 16:6" />ತೆನೈಸೊ ತೆ ಕ್ಹರಿಮಾಜ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಛತ್ತನಾ ಉಪ್ಪರ ಬಲೈ ಲಿನ ಗೈನ ವಟ್ಟಲ ಚಾರಾಮಾ ತ್ಯುನೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. <verse eid="JOS 16:6" /><verse number="7" style="v" sid="JOS 16:7" />ರಾಜಾನಾ ಭಟ್ಟೊ ಗಾಮನಾ ಭಾರಾ ಗೈನ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಿನ ಇಸ್ರೆಲತಾ ಆಯಲ ತೆ ಭಂಬಿ ಜನಾವೊನೆ ಹುಡಕಿನ ಗಯಾ. ತ್ಯುನೆ ಯೊರ್ದನ ನದಿ ಲಕ್ಕಾ ಗೈನ ಮನಕ್ಹೊ ನದ ದಾಟಾನಾ ಕ್ಹಾಟರಾ ಜ಼ಗಾವೊಮಾ ಹುಡಕ್ಯಾ. <verse eid="JOS 16:7" /><verse number="8" style="v" sid="JOS 16:8" />ತೆ ಭಂಬಿ ಗುಡಾಚಾರಿಯೊ ತ್ಯಾಜ ಕ್ಹುರ್xಯಾವಾನೆ ತಯ್ಯಾರಿ ಕರಿಲಿದ್ಯಾತಾ. ತೆನೈಸೊ ರಾಹಾಬ ಛತ್ತನಾ ಉಪ್ಪರ ಗೈನ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="JOS 16:8" /><verse number="9" style="v" sid="JOS 16:9" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ <verse eid="JOS 16:9" /><verse number="10" style="v" sid="JOS 16:10" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ<verse eid="JOS 16:10" /></para>
  <chapter eid="JOS 16" />
  <chapter number="17" style="c" sid="JOS 17" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 17:1" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಯೊರ್ದನನಾ ದಾಟಿನ ಗಯಲ್ಪರ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ <verse eid="JOS 17:1" /><verse number="2" style="v" sid="JOS 17:2" />ತುಮೆ ಮನಕ್ಹೊಮಾತಾ ಕುಲನಾ ಯಕ್ಲಾ ನಿಂಗತ ಬಾರಾ ಜನಾವೊನೆ ಇನಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 17:2" /><verse number="3" style="v" sid="JOS 17:3" />ಯೊರ್ದನನಾ ವಚ್ಮಾ ಯಾಜಕರೊ ಹುಬ್ರೆಲ ಜ಼ಗಾಕಂತಾ ಬಾರಾ ದಗ್ಡಾ ಉಚೈನ ತೆ ದಗ್ಡಾವೊನೆ ತುಮಾರಾ ಕ್ಹಾತೆ ಆ ಜ಼ಗಾಕನ ಲೈನ ತುಮೆ ಆ ರಾತೆ ಉತ್ರಾನಿ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡೊ ಕೈನ ಆಜ್ಞಾಕರು ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 17:3" /><verse number="4" style="v" sid="JOS 17:4" />ತೆಳಾಮಾ ಯೆಹುಶುವಾ ತೆ ಇಸ್ರಾಯಲಮಾತೊ ಕುಲತಾ ಯಕ್ಲಾ ನಿಂಗತ ಇನಿಲಿದಲ ಬಾರಾ ಜನಾ ಮನಕ್ಹೊನೆ ಬಲೈನ ತ್ಯುನೊನೆ <verse eid="JOS 17:4" /><verse number="5" style="v" sid="JOS 17:5" />ತುಮೆ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಪೈಲಾಜ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಗೈನ ಇಸ್ರಾಯೆಲ ಕುಲನಾ ನಂಬರನೆ ಕರೆಟ್ಟ ಥೌ ಕೈನ ಹರಯಕ್ಲೊ ಯಕ್ಕ ಯಕ್ಕ ದಗ್ಡೊ ಕ್ಹಾಂದಾಪರ ಉಚೈಲಿನ ಆವೊ. <verse eid="JOS 17:5" /><verse number="6" style="v" sid="JOS 17:6" />ತೆ ತುಮಾರಾ ವಚ್ಮಾ ವಳಕ ಥಾವಸ ಅಗಲ್ಯಾ ಜಲಮಮಾ ತುಮಾರಾ ಬಚ್ಚಾ ತೆ ದಗ್ಡಾ ಸು ಸುಚಿತ ಕರಸ ತುಮೊನೆ ಪುಚ್ಚ್ತಾಮಾ ತುಮೆ ತ್ಯುನೊನೆ <verse eid="JOS 17:6" /><verse number="7" style="v" sid="JOS 17:7" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನಾ ಯೊರ್ದನ ದಾಟತಾಮಾ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈಪಡ್ಯುತು ಕೈನ ಕವೊ.ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈ ಪಡ್ಯುತು ಕೈನ ಆ ದಗ್ಡಾ ಇಸ್ರಾಯಲೊನೆ ಕೆಳಾಮಾಬಿ ಸಾಕ್ಷಿ ಥಾವಸ ಕದ್ಯೊ. <verse eid="JOS 17:7" /><verse number="8" style="v" sid="JOS 17:8" />ಇಸ್ರಾಯಲೊ ಯೆಹೊಶುವಾ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಕರ‍್ಯಾ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಕದಲ ನಿಂಗತ ತ್ಯುನೆ ಇಸ್ರಾಯಲನಾ ಕುಲ ನಂಬರನಾ ನಿಂಗತ ಯೊರ್ದನನಾ ವಚ್ಮಾತಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಉಚೈನ ತ್ಯುನೆ ಉತ್ರಾನ ಜ಼ಗಾಕನ ಲೈನ ತ್ಯಾ ಹುಬ್ರಾಡ್ಯಾ. <verse eid="JOS 17:8" /><verse number="9" style="v" sid="JOS 17:9" />ತೆ ನೈಸೊ ಯೆಹುಶುವಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಲಿನ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊ ಹುಬ್ರೈಯಲ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡ್ಯಾ.ತೆ ಹಮ್ನಾತಾ ತ್ಯಾಜ ರ‍್ಹವಸ. <verse eid="JOS 17:9" /><verse number="10" style="v" sid="JOS 17:10" />ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಯೆಹುಶುವಾ ಮನಕ್ಹೊನೆ ತಿಳಸಲ ಯಹೊವಾನಾ ಅಪ್ಪಣೆ ಕ್ಹಾರಾ ತ್ಯುನೆ ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಹುಬ್ರೈಯಾ.ಮನಕ್ಹೊ ಭೆಗಿನ ತಳು ದಾಟ್ಯಾ. <verse eid="JOS 17:10" /><verse number="11" style="v" sid="JOS 17:11" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ತ್ಯಾ ಗಯಲ್ಪರ ಯಾಜಕೊ ಯಹೊವಾನಾ ಮಂಜುಷ ಕ್ಹರಿ ಥೈನ ದಾಟಿನ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮಾ ಗಯಾ. <verse eid="JOS 17:11" /><verse number="12" style="v" sid="JOS 17:12" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಯುದ್ಧ ಸಿದ್ಧ ಥೈನ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾಮಾತಾ ಗೈನ ತಳು ದಾಟಿಪಡ್ಯಾ. <verse eid="JOS 17:12" /><verse number="13" style="v" sid="JOS 17:13" />ತ್ಯುನೆ ಸುಮಾರ ಚಾಳಕ್ಹ ಹಜಾರ ಭಟ ಥೈನ ಯುದ್ಧ ಕರಾನಾಹುತಿ ಯಹೊವಾನಾ ಕ್ಹಾಮಾ ಯರಿಕೊನಾ ಬೈಲನೆ ಆಯಾ. <verse eid="JOS 17:13" /><verse number="14" style="v" sid="JOS 17:14" />ತೆ ದಿನ್ನೆ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾರಾ ನಜರಮಾ ಘನ ಪಡಸಲಕ್ಹು ಮೊಶೆಮಾ ಕಿಮ್ಮ ತಿಮ್ಮಜ ಅನಾಮಾಬಿ ಇನಾ ಜಿವಕ್ಹು ದಿನಕ್ಹಾರೊ ಭಯ ಭಕ್ತಿವಾಲಾ ವ್ಹತ್ತಾ. <verse eid="JOS 17:14" /><verse number="15" style="v" sid="JOS 17:15" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 17:15" /><verse number="16" style="v" sid="JOS 17:16" />ಯೊರ್ದನನತಾ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕವಾನೆ <verse eid="JOS 17:16" /><verse number="17" style="v" sid="JOS 17:17" />ತೆ ತೆ ಯಾಜಕೊನೆ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕದ್ಯೊ. <verse eid="JOS 17:17" /><verse number="18" style="v" sid="JOS 17:18" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ಯೊರ್ದನತಾ ಉಪ್ಪರ ಐನ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ ತ್ಯುನಾ ಪಗೊ ಮ್ಹೆಲೆಲ್ಪರ ಪಾನಿ ಪೈಲಾತುಜ ಐನ ಯೊರ್ದನನು ತಳು ಭರಿನ ವ್ಹೈನ ಚಾಲ್ಯುತು.<verse eid="JOS 17:18" /></para>
  <chapter eid="JOS 17" />
  <chapter number="18" style="c" sid="JOS 18" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 18:1" />ಥಯಲ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಕೊ ಗಾಮನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ವಳಾಯೊ. ಎ ಮನಕ್ಹೊನೆ ಯೆಹುಶುವಾ ವಳಾಯಲ ಸಂಗತಿ ಬಿಜು ಕಿನೆಜ ಗ್ವತ್ತ ನ್ಹೊತು.ಗೈನ ತೆ ಯೆರಿಕೊ ಗಾಮನೆ ಘನ್ನ ಸುಕ್ಷ್ಮಕ್ಹು ದೆಕೊ” ಕೈನ ಯೆಹುಶುವಾ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಕದ್ಯೊ. ತೆ ಭಂಬಿ ಜನಾ ಯೆರಿಕೊ ಗಾಮೆ ಗೈನ ಯಕ್ಕ ವ್ಯಶ್ಯಾನಾ ಘರಮಾ ರ‍್ಹಯಾ. ತೆ ಬಾಕಡಿನು ನಾಮ ‘ರಾಹಾಬ.’ <verse eid="JOS 18:1" /><verse number="2" style="v" sid="JOS 18:2" />ಗಾಮನಾ ರಾಜಾನೆ.ಕಾಲ ರಾತೆ ಇಸ್ರಾಯೆಲನಾ ದಕ್ಹಾ ಜನಾ ಅಪ್ನಾ ದೆಶಾ ಕಮಜೊರಿಯೊನೆ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 18:2" /><verse number="3" style="v" sid="JOS 18:3" />ತೆಳಾಮಾ ಯೆರಿಕೊ ಗಾಮನೊ ರಾಜೊ ರಾಹಾಬನೆ.ತಾರಾ ಘರೆ ಐನ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಝಾಕಿನ ಮ್ಹೆಲು ನಕೊ. ತ್ಯುನೊನೆ ಭಾರಿ ಬಲೈ ಲಿನ ಆ. ತ್ಯುನೆ ಅಪ್ನಾ ದೆಶನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಮೊಕ್ಲೊ. <verse eid="JOS 18:3" /><verse number="4" style="v" sid="JOS 18:4" />ರಾಹಾಬ ಎ ಭಂಬಿ ಜನಾವೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. ತೆನೈಸೊ ತೆ ಪುಚ್ಚಾನೆ ಆಯಲವಾಲಾವೊನೆ.ಬೆ ಮನಕ್ಹೊ ನ್ಹ್ಯಾ ಆಯಾತಾ, ತೆನೈಸೊ ತ್ಯುನೆ ಕಿಜಾಂತಾ ಆಯಾತಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನ್ಹೊತು. <verse eid="JOS 18:4" /><verse number="5" style="v" sid="JOS 18:5" />ಖಾಂಜೆ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಾನು ಟೈಮ ಥಾತಾಮಾ ತ್ಯುನೆ ಗೈಪಡ್ಯಾ. ತ್ಯುನೆ ಕಿಜಾ ಗಯಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನತ್ತಿ. ತೆನೈಸೊ ತುಮೆ ಜಲ್ದಿ ಗಯಮ ತ್ಯುನೊನೆ ಧರ ಸಕೊಶಿ” ಕದಿ. <verse eid="JOS 18:5" /><verse number="6" style="v" sid="JOS 18:6" />ತೆನೈಸೊ ತೆ ಕ್ಹರಿಮಾಜ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಛತ್ತನಾ ಉಪ್ಪರ ಬಲೈ ಲಿನ ಗೈನ ವಟ್ಟಲ ಚಾರಾಮಾ ತ್ಯುನೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. <verse eid="JOS 18:6" /><verse number="7" style="v" sid="JOS 18:7" />ರಾಜಾನಾ ಭಟ್ಟೊ ಗಾಮನಾ ಭಾರಾ ಗೈನ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಿನ ಇಸ್ರೆಲತಾ ಆಯಲ ತೆ ಭಂಬಿ ಜನಾವೊನೆ ಹುಡಕಿನ ಗಯಾ. ತ್ಯುನೆ ಯೊರ್ದನ ನದಿ ಲಕ್ಕಾ ಗೈನ ನದ ದಾಟಾನಾ ಕ್ಹಾಟರಾ ಜ಼ಗಾವೊಮಾ ಹುಡಕ್ಯಾ. <verse eid="JOS 18:7" /><verse number="8" style="v" sid="JOS 18:8" />ತೆ ಭಂಬಿ ಗುಡಾಚಾರಿಯೊ ತ್ಯಾಜ ಕ್ಹುರ್xಯಾವಾನೆ ತಯ್ಯಾರಿ ಕರಿಲಿದ್ಯಾತಾ. <verse eid="JOS 18:8" /><verse number="9" style="v" sid="JOS 18:9" />''ಯಹೊವಾ ಎ ದೆಶನೆ ತುಮಾರಾ ಮನಕ್ಹೊನೆ ದಿದ್ಯೊಸ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. ತುಮಾರಿ ವಿಶಯ ಐಕಿನ ಹಮೊನೆ ಭೆಂ ಹುಟ್ಯುಸ. ಎ ದೆಶಮಾ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ತುಮೊಕ್ಹು ಭುಚ್ಕಿನ ಛೆ. <verse eid="JOS 18:9" /><verse number="10" style="v" sid="JOS 18:10" />ಯಹೊವಾ ತುಮೊನೆ ಸಹಾಯ ಕರಲ ತರಿಕಾನಾ ಹುತಿ ಹಮೆ ಐಕಿನ ತೆ ಲಾಲ ಸಮುಂದರನಾ ಪಾನಿನೆ ಕ್ಹುಕ್ಹಾಯಲ ಹಮೆ ಐಕ್ಯಾಸ. ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವ ದಿಕ್ಕಮಾ ರ‍್ಹಯಲ ಸಿಹೊನ ವರಿ ಒಗ್ ಕವಾನಾ ಅಮೊರಿಯನಾ ಬೆ ಜನಾ ರಾಜಾವೊನೆ ತುಮೆ ಕಿಮ್ಮ ನಾಶ ಕರ್‍ಯಾಸ ಕವಾನು ಐಕ್ಯಾಸ. <verse eid="JOS 18:10" /><verse number="11" style="v" sid="JOS 18:11" />ಎ ಕ್ಹಾರಾವೊನಾಹುತಿ ಐಕಿನ ಹಮೊನೆ ಘನ್ನು ಭೆಂ ಐಯುಸ; ಹಮೊಮಾ ಕಿನೆಜ ಭುಪರಲೊಕನೆ ಆಳಾಲೊ ಥಯೊಸ. <verse eid="JOS 18:11" /><verse number="12" style="v" sid="JOS 18:12" />ಹಮ್ನಾ ತುಮೆ ಹಮೊನೆ ಯಕ್ಕ ಪ್ರಮಾಣ ಕರು. ಮಿ ತುಮೊನೆ ದಯಾ ದೆಕಾಡಿನ ಸಹಾಯ ಕರಿ. ತಿನಾಹುತಿ ತುಮೆಬಿ ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ದಯಾ ದೆಕಾಡೊಶಿ ಕೈನ ಯಕ್ಕ ವಳಕ ದಿವೊ. <verse eid="JOS 18:12" /><verse number="13" style="v" sid="JOS 18:13" />ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಕದ್ಯಾಮ ಮಾರಾ ಮಾ ಬಾಪನೆ, ಭಾಯೊ ಭೆನೊನೆ ವರಿ ತ್ಯುನಾ ಕ್ಹಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಜಿವ್ತಾ ಛೊಡಾನೆ ಪ್ರಮಾಣ ಕರೊ” ಕೈನ ಮಾಂಗಿಲಿದಿ. <verse eid="JOS 18:13" /><verse number="14" style="v" sid="JOS 18:14" />ತಿನಾಹುತಿ ತ್ಯುನೆ.ಹಮಾರು ಜಲಮ ದಿನಬಿ ತುಮಾರು ಜಲಮ ವಚಾ಼ಡೆಸ. ತೆನೈಸೊ ತುಮೆ ಎ ಕಿನೆಜ ಕವೊ ನಕೊ. ಯಹೊವಾ ಎ ದೆಶ ಹಮೊನೆ ದಿದಲ್ಪರ ಹಮೆ ತುಮೊನೆ ದಯಾ ದೆಕಾಡೆಸ. ತುಮೆ ಹಮೊನೆ ಬರೊಕ್ಹೊ ಕರ ಸಕೊಶಿ” ಕದ್ಯಾ. <verse eid="JOS 18:14" /><verse number="15" style="v" sid="JOS 18:15" />ರಾಹಾಬನಾ ಘರನೆ ಗಾಮನಿ ಗೊಡಿಯೆ ಲಾಗಿನ ಭಾಂದ್ಯಾತಾ <verse eid="JOS 18:15" /><verse number="16" style="v" sid="JOS 18:16" />ತುಮೆ ಪಾಚಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಮಳಲ ನಂಗತ ತೆ ಪರ್ವತನೆ ನ್ಹಾಟಿನ ಜಾವೊ ತ್ಯಾ ತನ್ನ ದಿನ ದಡಿನ ರೈನ ತ್ಯುನೆ ಗಯಲ್ಪರ ತುಮಾರಿ ವಾಟಕದಿ. <verse eid="JOS 18:16" /><verse number="17" style="v" sid="JOS 18:17" />ವರಿ ತ್ಯುನೆ ಹಮೆ ಕದಲ ವಾತನಿಂಗತ ತು (ಚಾಲೆಲ ರ‍್ಹಯಾಮ ತು ಹಮಾರಾ) ಗೈ ಗೈ ಕರಲ ಥಯೊತೊ. <verse eid="JOS 18:17" /><verse number="18" style="v" sid="JOS 18:18" />ವರಿ ಹಮೆ ಆ ಗಾಮಾ ರ‍್ಹತಾಮಾ ತು ಹಮೊನೆ ಉತಾರೆಲ ಕಿಡಕಿನೆ ಲಾಲ ದೊರೊ ಭಾಂದೊ ಕದ್ಯೊ ವರಿ ತಾರಾ ಮಾಬಾಪನೆ ಭಾಯೊನೆ ಕ್ಹಾರಾ ಸಂಬದಿಕಿಯೊನೆ ತಾರಾ ಘರಮಾ ಬಲೆಲಿದಲ ರ‍್ಹವೊ. <verse eid="JOS 18:18" /><verse number="19" style="v" sid="JOS 18:19" />ತ್ಯುನಾಮಾ ಕಯೊಬಿ ಘರ ಛೊಡಿನ ರೊಡೆ ಆಯೊರೆ ರಗತನು ಪಾಪ ವ್ಹೈ ತ್ಯುನಾ ಮಾತಾನಾ ಉಪ್ಪರ ನಿರ್ದೊಸಿಯೊ ಕೈನ ರ‍್ಹವಸ. ವರಿ ತಾರಾಖ್ಹಾತೆ ಘರಮಾ ರ‍್ಹಯಲವಾಲಾ ಉಪ್ಪರ ಹತ್ತ ಘಾಲ್ಯಾಮ ತೆ ರಗತನು ಪಾಪ ವ್ಹೈ ಅಪ್ನಾ ಮಾತಾನಾ ಉಪ್ಪರ ರ‍್ಹವಸ; <verse eid="JOS 18:19" /><verse number="20" style="v" sid="JOS 18:20" />ತೆ ನೈಸೊ ತು ಹಮಾರಾ ಸಂಗತಿಯೊನೆ ಭಾರಾ ಆವಾನಾಹುತಿ ಹಮೊಖ್ಹು ಕರಲ ಪ್ರಮಾಣಖ್ಹು ಬಿಡುಗಡೆ ಥಾವಸ ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 18:20" /><verse number="21" style="v" sid="JOS 18:21" />ತಿನಾಹುತಿ ತೆ ತುಮಾರಾ ವಾತನಿಂಗತ ಥಾವಾದೆ ಕೈನ ತ್ಯುನೊನೆ ವಳೈ; ತ್ಯುನೆ ಗಯಲ್ಪರ ತೆ ಲಾಲ ದೊರೊ ಕಿಡಕಿನೆ ಭಾಂದಿ. <verse eid="JOS 18:21" /><verse number="22" style="v" sid="JOS 18:22" />ಪರ್ವತೆ ಗೈನ ಪಿಟ್ಟ ಲಗಾಡಿನ ಪಾಚಾ ರ‍್ಹೆಲಕ್ಕಾ ತನ್ನ ದಿನ ತ್ಯಾಜ ವ್ಹತ್ತಾ. ಪಿಟ್ಟ ಲಗಾಡಿನ ತ್ಯುನೆ ತ್ಯುನೊನೆ ವಾಟನಾ ಯುದ್ದನೆ ಹುಡಕಿನ ದೆಕಿನ ಗೈಪಡ್ಯಾ. <verse eid="JOS 18:22" /><verse number="23" style="v" sid="JOS 18:23" />ತೆಳಾಮ ತ್ಯುನೆ ಬೆಜನಾ ಡೊಂಗರಪರ್ತಾ ಉತ್ರದಾಟಿನ ನೂನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹುಶುವಾ ಕನ ಐನ ತ್ಯುನೊನೆ ಅನಸಾಯಲ ತಿಳಶ್ಯಾ. <verse eid="JOS 18:23" /><verse number="24" style="v" sid="JOS 18:24" />ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು ಹಮೊನೆ ದಿದ್ಯೊಸ; ತಿನಾ ನಿವಾಸಿಯೊ ಕ್ಹಾರಾ ಹಮಾರಾ ನಿಮಿತ್ತ ಕಂಗಟ್ಟನಿ ಗಯಾಸ ಕೈನ ತಿಳಶ್ಯಾ. <verse eid="JOS 18:24" /><verse number="25" style="v" sid="JOS 18:25" />ತೆ ನೈಸೊ ತು ಹಮಾರಾ ಸಂಗತಿಯೊನೆ ಭಾರಾ ಆವಾನಾಹುತಿ ಹಮೊಖ್ಹು ಕರಲ ಪ್ರಮಾಣಖ್ಹು <verse eid="JOS 18:25" /><verse number="26" style="v" sid="JOS 18:26" />ತೆ ನೈಸೊ ತು ಹಮಾರಾ ಸಂಗತಿಯೊನೆ ಭಾರಾ ಆವಾನಾಹುತಿ ಹಮೊಖ್ಹು ಕರಲ ಪ್ರಮಾಣಖ್ಹು <verse eid="JOS 18:26" /><verse number="27" style="v" sid="JOS 18:27" />ತೆ ನೈಸೊ ತು ಹಮಾರಾ ಸಂಗತಿಯೊನೆ ಭಾರಾ ಆವಾನಾಹುತಿ ಹಮೊಖ್ಹು ಕರಲ ಪ್ರಮಾಣಖ್ಹು <verse eid="JOS 18:27" /><verse number="28" style="v" sid="JOS 18:28" />ತೆ ನೈಸೊ ತು ಹಮಾರಾ ಸಂಗತಿಯೊನೆ ಭಾರಾ ಆವಾನಾಹುತಿ ಹಮೊಖ್ಹು ಕರಲ ಪ್ರಮಾಣಖ್ಹು<verse eid="JOS 18:28" /></para>
  <chapter eid="JOS 18" />
  <chapter number="19" style="c" sid="JOS 19" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 19:1" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಯೊರ್ದನನಾ ದಾಟಿನ ಗಯಲ್ಪರ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ <verse eid="JOS 19:1" /><verse number="2" style="v" sid="JOS 19:2" />ತುಮೆ ಮನಕ್ಹೊಮಾತಾ ಕುಲನಾ ಯಕ್ಲಾ ನಿಂಗತ ಬಾರಾ ಜನಾವೊನೆ ಇನಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 19:2" /><verse number="3" style="v" sid="JOS 19:3" />ಯೊರ್ದನನಾ ವಚ್ಮಾ ಯಾಜಕರೊ ಹುಬ್ರೆಲ ಜ಼ಗಾಕಂತಾ ಬಾರಾ ದಗ್ಡಾ ಉಚೈನ ತೆ ದಗ್ಡಾವೊನೆ ತುಮಾರಾ ಕ್ಹಾತೆ ಆ ಜ಼ಗಾಕನ ಲೈನ ತುಮೆ ಆ ರಾತೆ ಉತ್ರಾನಿ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡೊ ಕೈನ ಆಜ್ಞಾಕರು ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 19:3" /><verse number="4" style="v" sid="JOS 19:4" />ತೆಳಾಮಾ ಯೆಹುಶುವಾ ತೆ ಇಸ್ರಾಯಲಮಾತೊ ಕುಲತಾ ಯಕ್ಲಾ ನಿಂಗತ ಇನಿಲಿದಲ ಬಾರಾ ಜನಾ ಮನಕ್ಹೊನೆ ಬಲೈನ ತ್ಯುನೊನೆ <verse eid="JOS 19:4" /><verse number="5" style="v" sid="JOS 19:5" />ತುಮೆ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಪೈಲಾಜ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಗೈನ ಇಸ್ರಾಯೆಲ ಕುಲನಾ ನಂಬರನೆ ಕರೆಟ್ಟ ಥೌ ಕೈನ ಹರಯಕ್ಲೊ ಯಕ್ಕ ಯಕ್ಕ ದಗ್ಡೊ ಕ್ಹಾಂದಾಪರ ಉಚೈಲಿನ ಆವೊ. <verse eid="JOS 19:5" /><verse number="6" style="v" sid="JOS 19:6" />ತೆ ತುಮಾರಾ ವಚ್ಮಾ ವಳಕ ಥಾವಸ ಅಗಲ್ಯಾ ಜಲಮಮಾ ತುಮಾರಾ ಬಚ್ಚಾ ತೆ ದಗ್ಡಾ ಸು ಸುಚಿತ ಕರಸ ತುಮೊನೆ ಪುಚ್ಚ್ತಾಮಾ ತುಮೆ ತ್ಯುನೊನೆ <verse eid="JOS 19:6" /><verse number="7" style="v" sid="JOS 19:7" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನಾ ಯೊರ್ದನ ದಾಟತಾಮಾ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈಪಡ್ಯುತು ಕೈನ ಕವೊ.ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈ ಪಡ್ಯುತು ಕೈನ ಆ ದಗ್ಡಾ ಇಸ್ರಾಯಲೊನೆ ಕೆಳಾಮಾಬಿ ಸಾಕ್ಷಿ ಥಾವಸ ಕದ್ಯೊ. <verse eid="JOS 19:7" /><verse number="8" style="v" sid="JOS 19:8" />ಇಸ್ರಾಯಲೊ ಯೆಹೊಶುವಾ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಕರ‍್ಯಾ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಕದಲ ನಿಂಗತ ತ್ಯುನೆ ಇಸ್ರಾಯಲನಾ ಕುಲ ನಂಬರನಾ ನಿಂಗತ ಯೊರ್ದನನಾ ವಚ್ಮಾತಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಉಚೈನ ತ್ಯುನೆ ಉತ್ರಾನ ಜ಼ಗಾಕನ ಲೈನ ತ್ಯಾ ಹುಬ್ರಾಡ್ಯಾ. <verse eid="JOS 19:8" /><verse number="9" style="v" sid="JOS 19:9" />ತೆ ನೈಸೊ ಯೆಹುಶುವಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಲಿನ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊ ಹುಬ್ರೈಯಲ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡ್ಯಾ.ತೆ ಹಮ್ನಾತಾ ತ್ಯಾಜ ರ‍್ಹವಸ. <verse eid="JOS 19:9" /><verse number="10" style="v" sid="JOS 19:10" />ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಯೆಹುಶುವಾ ಮನಕ್ಹೊನೆ ತಿಳಸಲ ಯಹೊವಾನಾ ಅಪ್ಪಣೆ ಕ್ಹಾರಾ ತ್ಯುನೆ ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಹುಬ್ರೈಯಾ.ಮನಕ್ಹೊ ಭೆಗಿನ ತಳು ದಾಟ್ಯಾ. <verse eid="JOS 19:10" /><verse number="11" style="v" sid="JOS 19:11" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ತ್ಯಾ ಗಯಲ್ಪರ ಯಾಜಕೊ ಯಹೊವಾನಾ ಮಂಜುಷ ಕ್ಹರಿ ಥೈನ ದಾಟಿನ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮಾ ಗಯಾ. <verse eid="JOS 19:11" /><verse number="12" style="v" sid="JOS 19:12" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಯುದ್ಧ ಸಿದ್ಧ ಥೈನ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾಮಾತಾ ಗೈನ ತಳು ದಾಟಿಪಡ್ಯಾ. <verse eid="JOS 19:12" /><verse number="13" style="v" sid="JOS 19:13" />ತ್ಯುನೆ ಸುಮಾರ ಚಾಳಕ್ಹ ಹಜಾರ ಭಟ ಥೈನ ಯುದ್ಧ ಕರಾನಾಹುತಿ ಯಹೊವಾನಾ ಕ್ಹಾಮಾ ಯರಿಕೊನಾ ಬೈಲನೆ ಆಯಾ. <verse eid="JOS 19:13" /><verse number="14" style="v" sid="JOS 19:14" />ತೆ ದಿನ್ನೆ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾರಾ ನಜರಮಾ ಘನ ಪಡಸಲಕ್ಹು ಮೊಶೆಮಾ ಕಿಮ್ಮ ತಿಮ್ಮಜ ಅನಾಮಾಬಿ ಇನಾ ಜಿವಕ್ಹು ದಿನಕ್ಹಾರೊ ಭಯ ಭಕ್ತಿವಾಲಾ ವ್ಹತ್ತಾ. <verse eid="JOS 19:14" /><verse number="15" style="v" sid="JOS 19:15" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 19:15" /><verse number="16" style="v" sid="JOS 19:16" />ಯೊರ್ದನನತಾ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕವಾನೆ <verse eid="JOS 19:16" /><verse number="17" style="v" sid="JOS 19:17" />ತೆ ತೆ ಯಾಜಕೊನೆ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕದ್ಯೊ. <verse eid="JOS 19:17" /><verse number="18" style="v" sid="JOS 19:18" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ಯೊರ್ದನತಾ ಉಪ್ಪರ ಐನ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ ತ್ಯುನಾ ಪಗೊ ಮ್ಹೆಲೆಲ್ಪರ ಪಾನಿ ಪೈಲಾತುಜ ಐನ ಯೊರ್ದನನು ತಳು ಭರಿನ ವ್ಹೈನ ಚಾಲ್ಯುತು. <verse eid="JOS 19:18" /><verse number="19" style="v" sid="JOS 19:19" />ಮನಕ್ಹೊ ಯಕವಾ ಮ್ಹೈನಾನಾ ದಕ್ಹವಾ ದಿನಮಾ ಯೊರ್ದನ ದಾಟಿನ ಯೆರಿಕೊನಾ ಪೂರ್ವ ಪ್ರಾಂತ್ಯಮಾ ರ‍್ಹವಾನು ಗಿಲ್ಗಾಲ ಕವಾನಾ ಗಾಮಾ ಉತ್ರ್ಯಾ. <verse eid="JOS 19:19" /><verse number="20" style="v" sid="JOS 19:20" />ಯೆಹುಶುವಾ ಯೊರ್ದನತೊ ಲಿನ ಆಯಲ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಗಿಲ್ಗಾಲಮಾ ಹುಬ್ರಾಡಿನ ಇಸ್ರಾಯಲೊನೆ <verse eid="JOS 19:20" /><verse number="21" style="v" sid="JOS 19:21" />ಅಗಲ್ಯಾ ದಾಟಿನ ದಗ್ಡಾವೊನೆ ಕಾ ಕಾಲಮಾ ತುಮಾರಾ ಬಚ್ಚಾ ಆ ಹುಬ್ರಾಡ್ಯಾಸ ಕದ್ಯಾಮ ತುಮೊನೆ ಪುಚ್ಯಾಮ ತುಮೆ ತ್ಯುನೊನೆ <verse eid="JOS 19:21" /><verse number="22" style="v" sid="JOS 19:22" />ಇಸ್ರಾಯಲೊ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ ಥಯಲ ಆ ಯೊರ್ದನ ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ ನಂಗತ ಹಮ್ನಾ ಅಪೊನಾ ಕ್ಹಾಮಾ ಆ ಯೊರ್ದನೆ ಬತ್ತಿನ ತುಮೊನೆ ದಟಾಡ್ಯೊಸ. <verse eid="JOS 19:22" /><verse number="23" style="v" sid="JOS 19:23" />ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು <verse eid="JOS 19:23" /><verse number="24" style="v" sid="JOS 19:24" />ಇನಾಹುತಿ ಭುಲೊಕನಾ ಕ್ಹಾರಾ ಯಹೊವಾನಾ ಹಸ್ತ ಪರಾಕ್ರಮ ವ್ಹೈಕೈನ ತಿಳ್ದಿಲಿವಸ ತುಮಾರಾ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಕೆಳಾಮಾಬಿ ಬುಚ್ಕಾಲಾ ವ್ಹೈ ಕದ್ಯೊ. ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು ಹಮೊನೆ ದಿದ್ಯೊ <verse eid="JOS 19:24" /><verse number="25" style="v" sid="JOS 19:25" />ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಕದ್ಯಾಮ ಮಾರಾ ಮಾ ಬಾಪನೆ, ಭಾಯೊ ಭೆನೊನೆ ವರಿ ತ್ಯುನಾ ಕ್ಹಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಜಿವ್ತಾ ಛೊಡಾನೆ ಪ್ರಮಾಣ <verse eid="JOS 19:25" /><verse number="26" style="v" sid="JOS 19:26" />ಎ ಟೈಮ್ಮಾ ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:26" /><verse number="27" style="v" sid="JOS 19:27" />ಎ ಟೈಮ್ಮಾ ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:27" /><verse number="28" style="v" sid="JOS 19:28" />ಎ ಟೈಮ್ಮಾ ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:28" /><verse number="29" style="v" sid="JOS 19:29" />ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಕದ್ಯಾಮ ಮಾರಾ ಮಾ ಬಾಪನೆ, ಭಾಯೊ ಭೆನೊನೆ ವರಿ ತ್ಯುನಾ ಕ್ಹಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಜಿವ್ತಾ ಛೊಡಾನೆ ಪ್ರಮಾಣ <verse eid="JOS 19:29" /><verse number="30" style="v" sid="JOS 19:30" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 19:30" /><verse number="31" style="v" sid="JOS 19:31" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 19:31" /><verse number="32" style="v" sid="JOS 19:32" />ರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:32" /><verse number="33" style="v" sid="JOS 19:33" />ಎ ಟೈಮ್ಮಾ ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:33" /><verse number="34" style="v" sid="JOS 19:34" />ರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:34" /><verse number="35" style="v" sid="JOS 19:35" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 19:35" /><verse number="36" style="v" sid="JOS 19:36" />ಎ ಟೈಮ್ಮಾ ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:36" /><verse number="37" style="v" sid="JOS 19:37" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 19:37" /><verse number="38" style="v" sid="JOS 19:38" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 19:38" /><verse number="39" style="v" sid="JOS 19:39" />ರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:39" /><verse number="40" style="v" sid="JOS 19:40" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 19:40" /><verse number="41" style="v" sid="JOS 19:41" />ರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:41" /><verse number="42" style="v" sid="JOS 19:42" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 19:42" /><verse number="43" style="v" sid="JOS 19:43" />ರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:43" /><verse number="44" style="v" sid="JOS 19:44" />ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:44" /><verse number="45" style="v" sid="JOS 19:45" />ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:45" /><verse number="46" style="v" sid="JOS 19:46" />ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:46" /><verse number="47" style="v" sid="JOS 19:47" />ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:47" /><verse number="48" style="v" sid="JOS 19:48" />ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:48" /><verse number="49" style="v" sid="JOS 19:49" />ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:49" /><verse number="50" style="v" sid="JOS 19:50" />ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 19:50" /><verse number="51" style="v" sid="JOS 19:51" />ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ<verse eid="JOS 19:51" /></para>
  <chapter eid="JOS 19" />
  <chapter number="20" style="c" sid="JOS 20" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 20:1" />ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ ಗಾಮನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ವಳಾಯೊ. ಎ ಮನಕ್ಹೊನೆ ಯೆಹುಶುವಾ ವಳಾಯಲ ಸಂಗತಿ ಬಿಜು ಕಿನೆಜ ಗ್ವತ್ತ ನ್ಹೊತು.ಗೈನ ತೆ ಯೆರಿಕೊ ಗಾಮನೆ ಘನ್ನ ಸುಕ್ಷ್ಮಕ್ಹು ದೆಕೊ” ಕೈನ ಯೆಹುಶುವಾ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಕದ್ಯೊ. ತೆ ಭಂಬಿ ಜನಾ ಯೆರಿಕೊ ಗಾಮೆ ಗೈನ ಯಕ್ಕ ವ್ಯಶ್ಯಾನಾ ಘರಮಾ ರ‍್ಹಯಾ. ತೆ ಬಾಕಡಿನು ನಾಮ ‘ರಾಹಾಬ.’ <verse eid="JOS 20:1" /><verse number="2" style="v" sid="JOS 20:2" />ತೆಳಾಮಾ ಕುನ್ನ ಯಕ್ಕ ಯೆರಿಕೊ ಗಾಮನಾ ರಾಜಾನೆ.ಕಾಲ ರಾತೆ ಇಸ್ರಾಯೆಲನಾ ದಕ್ಹಾ ಜನಾ ಅಪ್ನಾ ದೆಶಾ ಕಮಜೊರಿಯೊನೆ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 20:2" /><verse number="3" style="v" sid="JOS 20:3" />ತೆಳಾಮಾ ಯೆರಿಕೊ ಗಾಮನೊ ರಾಜೊ ರಾಹಾಬನೆ.ತಾರಾ ಘರೆ ಐನ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಝಾಕಿನ ಮ್ಹೆಲು ನಕೊ. ತ್ಯುನೊನೆ ಭಾರಿ ಬಲೈ ಲಿನ ಆ. ತ್ಯುನೆ ಅಪ್ನಾ ದೆಶನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಮೊಕ್ಲೊ. <verse eid="JOS 20:3" /><verse number="4" style="v" sid="JOS 20:4" />ರಾಹಾಬ ಎ ಭಂಬಿ ಜನಾವೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. ತೆನೈಸೊ ತೆ ಪುಚ್ಚಾನೆ ಆಯಲವಾಲಾವೊನೆ.ಬೆ ಮನಕ್ಹೊ ನ್ಹ್ಯಾ ಆಯಾತಾ, ತೆನೈಸೊ ತ್ಯುನೆ ಕಿಜಾಂತಾ ಆಯಾತಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನ್ಹೊತು. <verse eid="JOS 20:4" /><verse number="5" style="v" sid="JOS 20:5" />ಖಾಂಜೆ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಾನು ಟೈಮ ಥಾತಾಮಾ ತ್ಯುನೆ ಗೈಪಡ್ಯಾ. ತ್ಯುನೆ ಕಿಜಾ ಗಯಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನತ್ತಿ. ತೆನೈಸೊ <verse eid="JOS 20:5" /><verse number="6" style="v" sid="JOS 20:6" />ತೆನೈಸೊ ತೆ ಕ್ಹರಿಮಾಜ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಛತ್ತನಾ ಉಪ್ಪರ ಬಲೈ ಲಿನ ಗೈನ ವಟ್ಟಲ ಚಾರಾಮಾ ತ್ಯುನೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. <verse eid="JOS 20:6" /><verse number="7" style="v" sid="JOS 20:7" />ರಾಜಾನಾ ಭಟ್ಟೊ ಗಾಮನಾ ಭಾರಾ ಗೈನ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಿನ ಇಸ್ರೆಲತಾ ಆಯಲ ತೆ ನಕ್ಹೊ ನದ ದಾಟಾನಾ ಕ್ಹಾಟರಾ ಭಂಬಿ ಜನಾವೊನೆ ಹುಡಕಿನ ಗಯಾ. ತ್ಯುನೆ ಯೊರ್ದನ ನದಿ ಲಕ್ಕಾ ಗೈನ ಮಜ಼ಗಾವೊಮಾ ಹುಡಕ್ಯಾ. <verse eid="JOS 20:7" /><verse number="8" style="v" sid="JOS 20:8" />ತೆ ಭಂಬಿ ಗುಡಾಚಾರಿಯೊ ತ್ಯಾಜ ಕ್ಹುರ್xಯಾವಾನೆ ತಯ್ಯಾರಿ ಕರಿಲಿದ್ಯಾತಾ. ತೆನೈಸೊ ರಾಹಾಬ ಛತ್ತನಾ ಉಪ್ಪರ ಗೈನ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="JOS 20:8" /><verse number="9" style="v" sid="JOS 20:9" />ಯಹೊವಾ ಯೆಹುಶವಾನೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ, ತು ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊನೆ ಮಿ ಮೊಶೆನಾ ಮುಲಕ ಕದಲ ತಿಮ್ಮಜ಼ ತುಮೆ ತುಮಾರಾ ಹುತಿ ದಕ್ಹಾ ಅಶ್ರೆನಾ ಘರೊ ಬಾಂದಿಲಿವೊ.<verse eid="JOS 20:9" /></para>
  <chapter eid="JOS 20" />
  <chapter number="21" style="c" sid="JOS 21" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 21:1" />ಮೊಶೆ ಯಹೊವಾನೊ ಸೆವಕ ವ್ಹತ್ತೊ. ನುನನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಹೊಶುವಾ ಮೊಶೆನೊ ಸಹಾಯಕ ವ್ಹತ್ತೊ. ಮೊಶೆ ಮರಲ್ಪರ ಯಹೊವಾ ಯೆಹೊಶುವಾನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="JOS 21:1" /><verse number="2" style="v" sid="JOS 21:2" />''ಮಾರೊ ಸೆವಕ ಥಯಲ ಮೊಶೆ ಮರಿಗಯೊ. ಹಮ್ನಾ ತು ವರಿ ಎ ಮನಕ್ಹೊ ಯೊರ್ದನ ನದಿ ದಾಟಿನ ಜೌ. ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊ ಥಯಲ ತುಮೊನೆ ಮಿ ದಿವಾನಾ ದೆಶೆ ತುಮೆ ಜೌ. <verse eid="JOS 21:2" /><verse number="3" style="v" sid="JOS 21:3" />ಮಿ ತೆ ದೆಶನೆ ತುಮೊನೆ ದಿವ್ಸ ಕೈನ ಮೊಶೆನೆ ವಾಗ್ದಾನ ಕರ‍್ಯೊಸ. ತಿನಾಹುತಿ ತುಮೆ ಪಗೊ ಮ್ಹೆಲಾನಿ ಕ್ಹಾರಿ ಜ಼ಗಾ ತುಮೊನೆ ದಿವ್ಸ. <verse eid="JOS 21:3" /><verse number="4" style="v" sid="JOS 21:4" />ರಾನ ವರಿ ಲೆಬನೊನ ಡೊಂಗರ ಎ ಕ್ಹಾರು ಮಳಿನ ಯುಫ್ರೆಟಿಸ ಮ್ಹೊಟ್ಟಿ ನದಿ ಲಕ್ಕಾ ಹಿತ್ತಿವಾಲಾವೊನಿ ಕ್ಹಾರಿ ಜ಼ಗಾ ತುಮಾರು ಥಾವಸ. ತುಮಾರಿ ಜ಼ಗಾ ಪಶ್ಚಿಮಾ ರ‍್ಹಯಲ ಎಡಿಟರೆನಿಯನ ಸಮುಂದರ ಲಕ್ಕಾ ಫೈಲಸ. <verse eid="JOS 21:4" /><verse number="5" style="v" sid="JOS 21:5" />ಮಿ ಮೊಶೆನಾ ಕ್ಹಾತೆ ರ್ಲಿಂಗತ ತಾರಾ ಕ್ಹಾತೆಬಿ ರ‍್ಹೌಸ. ತಾರಿ ಜಿಂದಗಿ ಭರಿನ ಕುನ್ನಜ ತುನೆ ತರಬ ನೈ ಸಕ್ತು. ಮಿ ತಾರೊ ಹತ್ತ ನೈ ಛೊಡತೊ; ಢಕಲಿ ಪಡ್ತೊ ನೈ” ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 21:5" /><verse number="6" style="v" sid="JOS 21:6" />''ಯೆಹೊಶುವಾ, ತು ಘಟ್ಟ ಥೈನ ರ‍್ಹೌ; ಧೈರ್ಯವಂತ ಥೈನ ರ‍್ಹೌ; ಎ ಮನಕ್ಹೊ ತ್ಯುನು ದೆಶ ಪಡ್ದಿಲಿವಾನೆ ತು ತ್ಯುನೊನೆ ಅಗೊ ಥೈನ ಚಲೌ. ಮಿ ಇವ್ನೊನೆ ಎ ಜ಼ಗಾ ದಿವ್ಸ ಕೈನ ಇವ್ನಾ ಪುರ್ವಿಕರೊನೆ ಪ್ರಮಾಣ ಕರ‍್ಯೊಸ. <verse eid="JOS 21:6" /><verse number="7" style="v" sid="JOS 21:7" />ತೆನೈಸೊ ತು ಬಿಜಿ ಯಕ್ಕ ವಿಶಯಮಾಬಿ ಘಟ್ಟ ಥೈನ ರ‍್ಹೌ; ಧೈರ್ಯವಂತ ಥೈನ ರ‍್ಹೌ. ಮಾರೊ ಸೆವಕ ಥೈನ ರ‍್ಹಯಲ ಮೊಶೆ ತುನೆ ದಿದಲ ಆಗನ್ಯಾವೊನೆ ತು ಕ್ಹರಿಜ಼ ಪಾಲಸು. ತಿನು ಕ್ಹಾರು ಧರ್ಮೊಪದೆಶ ನಕ್ಕರಬಿ ಬುಕ್ಯಾ ಬಗರ ಚಾಲಿಲಿನ ಗಯಲ ರ‍್ಹಯಮ ತು ಕರಾನಾ ಕ್ಹಾರಾ ಕಾಮೊಮಾ ತುನೆ ಕ್ಹರಿಬಿ ಜಯ ಮಳಸ. <verse eid="JOS 21:7" /><verse number="8" style="v" sid="JOS 21:8" />ತೆ ಧರಮಶಾಸ್ತ್ರಮಾ ಬರ್ದಲ ವಿಶಯೊ ಕೆಳಾಮಾಬಿ ಶೆಂ ಮ್ಹೆಲ. ದಿನ್ನ ರಾತ ತೆ ಧರಮಶಾಸ್ತ್ರನೆ ಧ್ಯಾನ ಕರ. ತೆಳಾಮಾ ತಿಮಾ ಬರ್ದಲ ವಿಶಯೊನೆ ತು ಕ್ಹರಿಮಾಬಿ ವಿದೆಯ ಥೈನ ರ‍್ಹಶಿ. ತು ಇಮ್ಮ ಕರ್xಯೊಮ ತು ಕರಾನಾ ಹರಯಕ್ಕ ಕಾಮಮಾ ತು ಶಾಣ್ಯೊ ಥಾಶಿ ವರಿ ಜಯಶಾಲಿ ಥೈನ ರ‍್ಹಶಿ. <verse eid="JOS 21:8" /><verse number="9" style="v" sid="JOS 21:9" />ಶೆಂ ಮ್ಹೆಲ, ತು ಘಟ್ಟ ಥೈನ ರ‍್ಹೌ ಕೈನಬಿ ಧೈರ್ಯವಾಲೊ ಥೈನ ರ‍್ಹೌ ಕೈನಬಿ ಮಿ ತುನೆ ಆಗನ್ಯಾ ದಿವ್ಸ. ತಿನಾಹುತಿ ಭುಚ್ಕು ನಕೊ, ಕಾಕದ್ಯಾಮ ತು ಗಯಲ ಕ್ಹಾರಿ ಜ಼ಗಾ ತಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾಜ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಸ” ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 21:9" /><verse number="10" style="v" sid="JOS 21:10" />ತೆಳಾಮಾ ಯೆಹುಶುವಾ ಮನಕ್ಹೊನಾ ಅದಿಪತಿನೆ, <verse eid="JOS 21:10" /><verse number="11" style="v" sid="JOS 21:11" />''ತುಮೆ ಪಾಳೆಯನಾ ಕ್ಹಾರಿ ಬಗಲ ಗೈನ ಮನಕ್ಹೊನೆ ತಯ್ಯಾರ ಥೈನ ರ‍್ಹವಾನೆ ದಿಳ್ಸಾವೊ; ದಕ್ಹು ಅನ್ನ ತಯ್ಯಾರ ಕರಿಲಿವಾನೆ ಕವೊ. ಹಜ್ಜುನ ತನ್ನ ದಿನ್ನಮಾ ಅಪೆ ಆಂಯೊರ್ದನ ನದಿ ದಾಟಿನ ಗಯೆಸ. ಮಿ ಗೈನ ಯಹೊವಾ ಥಯಲ ಅಪ್ನೊ ಕ್ಹುದಾ ಅಪೊನೆ ದಿವಾನಾ ದೆಶನೆ ವಶ ಕರಿಲಿಯೆಸ ಕವೊ” ಕೈನ ಆಗನ್ಯಾ ದಿದ್ಯೊ. <verse eid="JOS 21:11" /><verse number="12" style="v" sid="JOS 21:12" />ಪಾಚಲ್ತೊ ಯೆಹುಶುವಾ ರುಬೆನ್ ಗಾದ್ಯಾವಾಲಾವೊನಾ ವರಿ ಮನಸ್ಸೆ ಖಾಂದಾನನಾ ಅರ್ದಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಿಲಿನ ತ್ಯುನೊನೆ, <verse eid="JOS 21:12" /><verse number="13" style="v" sid="JOS 21:13" />''ಯಹೊವಾನೊ ಸೆವಕ ಥಯಲ ಮೊಶೆ ತುಮೊನೆ ಕದಲ ಶೆಂ ಕರಿಲಿವೊ. ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಅರಾಮ ಕರಾನಾ ಹುತಿ ಯಕ್ಕ ದೆಶ ತುಮೊನೆ ದಿವ್ಸ ಕೈನ ವಾಗ್ದಾನ ಕರ್xಯೊತೊ. <verse eid="JOS 21:13" /><verse number="14" style="v" sid="JOS 21:14" />ಯಹೊವಾ ಯೆಳಕ್ಕಾ ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವನಿ ಜ಼ಗಾ ತುಮೊನೆ ದಿದ್ಯೊಸ. ತುಮಾರಾ ಬಾಕಡಿಯೊ, ಬಚ್ಚಾ ವರಿ ತುಮಾರಾ ಬೈಲೊ ಬಕ್ರಾ ಎ ಜ಼ಗಾಮಾಜ ರ‍್ಹೆ ಸಕಸ. ತೆನೈಸೊ ತುಮಾರಾ ಸೈನಿಕೊ ತುಮಾರಾ ಭಾಯೊನಾ ಕ್ಹಾತೆ ಯೊರ್ದನ ನದಿ ದಾಟು. ತುಮೆ ಯುದ್ದನೆ ತಯ್ಯಾರ ಥೈನ ತುಮಾರಾ ಭಾಯೊನೆ ತುನು ದೆಶ ಪಡ್ದಿಲಿವಾಮಾ ಸಹಾಯ ಕರು. <verse eid="JOS 21:14" /><verse number="15" style="v" sid="JOS 21:15" />ಯಹೊವಾ ತುಮಾರಾ ಅರಾಮನಾ ಹುತಿ ಯಕ್ಕ ಜ಼ಗಾ ದಿದ್ಯೊಸ. ಯಹೊವಾ ತುಮಾರಾ ಭಾಯೊನಾ ಹುತಿಬಿ ಯಕ್ಕ ಜ಼ಗಾ ದಿವಸ. ತೆನೈಸೊ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ತ್ಯುನೊನೆ ದಿವಾನಾ ದೆಶೆ ತ್ಯುನೆ ಪಡ್ದಿಲಿಯೆ ಲಕ್ಕಾ ತುಮೆ ತುಮಾರಾ ಭಾಯೊನೆ ಸಹಾಯ ಕರು. ಪಾಚಲ್ತಾ ತುಮೆ ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವ ದಿಕ್ಕಮಾ ರ‍್ಹಯಲ ತುಮಾರಾ ದೆಶೆ ಜಾ ಸಕೊಶಿ. ಯಹೊವಾನೊ ಸೆವಕ ಥಯಲ ಮೊಶೆ ತುಮೊನೆ ದಿದಲ ದೆಶೆ ತೆಜ ವ್ಹೈ” ಕದ್ಯೊ. <verse eid="JOS 21:15" /><verse number="16" style="v" sid="JOS 21:16" />ತೆಲಾಮಾ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ.ತು ಆಗನ್ಯಾ ದಿದಲ ಕರಿಯೆಸ; ತು ಹಮೊನೆ ವಳಾಯಲ ಕ್ಹಾರಿ ಜ಼ಗಾಯೆ ಗಯೆಸ. <verse eid="JOS 21:16" /><verse number="17" style="v" sid="JOS 21:17" />ಹಮೆ ಮೊಶೆನಾ ಆಗನ್ಯಾ ಕ್ಹಾರಾ ಚಾಲಿಲಿನ ಗಯಾ. ತಿನಾ ನಿಂಗತ ತಾರಿ ಆಗನ್ಯಾವೊನೆಬಿ ಚಾಲಿಲಿನ ಗಯೆಸ.ತಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಮೊಶೆನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ತಿಮ್ಮ ತಾರಾ ಕ್ಹಾತೆಬಿ ರ‍್ಹವಾದೆ. <verse eid="JOS 21:17" /><verse number="18" style="v" sid="JOS 21:18" />ಕುನ್ನತಬಿ ತಾರಿ ಆಗನ್ಯಾವೊನೆ ಇನ್ಕಾರ್ಯಮ ತೆನೈಸೊ ಕುನ್ನತಿಬಿ ತುನೆ ವಿರೊದ ಕರ‍್ಯಾಮ ತಿನೆ ಕ್ಹಲಾಸ ಕರಿಯೆಸ. ತು ಕ್ಹಾಲಿ ಘಟ್ಟ ಥೈನ ರ‍್ಹೆ; ಧೈರ್ಯವಾಲೊ ಥೈನ ರ‍್ಹೆ” ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 21:18" /><verse number="19" style="v" sid="JOS 21:19" />ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 21:19" /><verse number="20" style="v" sid="JOS 21:20" />ಯಹೊವಾ ಯೆಳಕ್ಕಾ ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವನಿ ಜ಼ಗಾ ತುಮೊನೆ ದಿದ್ಯೊಸ. ತುಮಾರಾ ಬಾಕಡಿಯೊ, ಬಚ್ಚಾ ವರಿ ತುಮಾರಾ <verse eid="JOS 21:20" /><verse number="21" style="v" sid="JOS 21:21" />ಯಹೊವಾ ಯೆಳಕ್ಕಾ ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವನಿ ಜ಼ಗಾ ತುಮೊನೆ ದಿದ್ಯೊಸ. ತುಮಾರಾ ಬಾಕಡಿಯೊ, ಬಚ್ಚಾ ವರಿ ತುಮಾರಾ <verse eid="JOS 21:21" /><verse number="22" style="v" sid="JOS 21:22" />ಅದೊನಿಜೆದಕ ಯೆಹುಶುವಾ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ <verse eid="JOS 21:22" /><verse number="23" style="v" sid="JOS 21:23" />ಹರಯಕ್ಕ ಕಾಮಮಾ ತು ಶಾಣ್ಯೊ ಥಾಶಿ ವರಿ ಜಯಶಾಲಿ ಥೈನ ರ‍್ಹಶಿ <verse eid="JOS 21:23" /><verse number="24" style="v" sid="JOS 21:24" />ಖಾಂದಾನನಾ ಅರ್ದಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 21:24" /><verse number="25" style="v" sid="JOS 21:25" />ಹರಯಕ್ಕ ಕಾಮಮಾ ತು ಶಾಣ್ಯೊ ಥಾಶಿ ವರಿ ಜಯಶಾಲಿ ಥೈನ ರ‍್ಹಶಿ <verse eid="JOS 21:25" /><verse number="26" style="v" sid="JOS 21:26" />ಖಾಂದಾನನಾ ಅರ್ದಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 21:26" /><verse number="27" style="v" sid="JOS 21:27" />ಖಾಂದಾನನಾ ಅರ್ದಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 21:27" /><verse number="28" style="v" sid="JOS 21:28" />ಖಾಂದಾನನಾ ಅರ್ದಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 21:28" /><verse number="29" style="v" sid="JOS 21:29" />ಹರಯಕ್ಕ ಕಾಮಮಾ ತು ಶಾಣ್ಯೊ ಥಾಶಿ ವರಿ ಜಯಶಾಲಿ ಥೈನ ರ‍್ಹಶಿ <verse eid="JOS 21:29" /><verse number="30" style="v" sid="JOS 21:30" />ಖಾಂದಾನನಾ ಅರ್ದಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 21:30" /><verse number="31" style="v" sid="JOS 21:31" />ಖಾಂದಾನನಾ ಅರ್ದಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 21:31" /><verse number="32" style="v" sid="JOS 21:32" />ಖಾಂದಾನನಾ ಅರ್ದಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 21:32" /><verse number="33" style="v" sid="JOS 21:33" />ಹರಯಕ್ಕ ಕಾಮಮಾ ತು ಶಾಣ್ಯೊ ಥಾಶಿ ವರಿ ಜಯಶಾಲಿ ಥೈನ ರ‍್ಹಶಿ <verse eid="JOS 21:33" /><verse number="34" style="v" sid="JOS 21:34" />ಖಾಂದಾನನಾ ಅರ್ದಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 21:34" /><verse number="35" style="v" sid="JOS 21:35" />ಯಹೊವಾ ಯೆಳಕ್ಕಾ ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವನಿ ಜ಼ಗಾ ತುಮೊನೆ ದಿದ್ಯೊಸ. ತುಮಾರಾ ಬಾಕಡಿಯೊ, ಬಚ್ಚಾ ವರಿ ತುಮಾರಾ <verse eid="JOS 21:35" /><verse number="36" style="v" sid="JOS 21:36" />ಯಹೊವಾ ಯೆಳಕ್ಕಾ ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವನಿ ಜ಼ಗಾ ತುಮೊನೆ ದಿದ್ಯೊಸ. ತುಮಾರಾ ಬಾಕಡಿಯೊ, ಬಚ್ಚಾ ವರಿ ತುಮಾರಾ <verse eid="JOS 21:36" /><verse number="37" style="v" sid="JOS 21:37" />ಖಾಂದಾನನಾ ಅರ್ದಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 21:37" /><verse number="38" style="v" sid="JOS 21:38" />ಹರಯಕ್ಕ ಕಾಮಮಾ ತು ಶಾಣ್ಯೊ ಥಾಶಿ ವರಿ ಜಯಶಾಲಿ ಥೈನ ರ‍್ಹಶಿ <verse eid="JOS 21:38" /><verse number="39" style="v" sid="JOS 21:39" />ಯಹೊವಾ ಯೆಳಕ್ಕಾ ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವನಿ ಜ಼ಗಾ ತುಮೊನೆ ದಿದ್ಯೊಸ. ತುಮಾರಾ ಬಾಕಡಿಯೊ, ಬಚ್ಚಾ ವರಿ ತುಮಾರಾ <verse eid="JOS 21:39" /><verse number="40" style="v" sid="JOS 21:40" />ಯಹೊವಾ ಯೆಳಕ್ಕಾ ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವನಿ ಜ಼ಗಾ ತುಮೊನೆ ದಿದ್ಯೊಸ. ತುಮಾರಾ ಬಾಕಡಿಯೊ, ಬಚ್ಚಾ ವರಿ ತುಮಾರಾ <verse eid="JOS 21:40" /><verse number="41" style="v" sid="JOS 21:41" />ಖಾಂದಾನನಾ ಅರ್ದಾ ಮನಕ್ಹೊನಾ ಕ್ಹಾತೆ ಬೊಲಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 21:41" /><verse number="42" style="v" sid="JOS 21:42" />ಹರಯಕ್ಕ ಕಾಮಮಾ ತು ಶಾಣ್ಯೊ ಥಾಶಿ ವರಿ ಜಯಶಾಲಿ ಥೈನ ರ‍್ಹಶಿ <verse eid="JOS 21:42" /><verse number="43" style="v" sid="JOS 21:43" />ಯಹೊವಾ ಯೆಳಕ್ಕಾ ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವನಿ ಜ಼ಗಾ ತುಮೊನೆ ದಿದ್ಯೊಸ. ತುಮಾರಾ ಬಾಕಡಿಯೊ, ಬಚ್ಚಾ ವರಿ ತುಮಾರಾ <verse eid="JOS 21:43" /><verse number="44" style="v" sid="JOS 21:44" />ಯಹೊವಾ ಯೆಳಕ್ಕಾ ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವನಿ ಜ಼ಗಾ ತುಮೊನೆ ದಿದ್ಯೊಸ. ತುಮಾರಾ ಬಾಕಡಿಯೊ, ಬಚ್ಚಾ ವರಿ ತುಮಾರಾ <verse eid="JOS 21:44" /><verse number="45" style="v" sid="JOS 21:45" />ಹರಯಕ್ಕ ಕಾಮಮಾ ತು ಶಾಣ್ಯೊ ಥಾಶಿ ವರಿ ಜಯಶಾಲಿ ಥೈನ ರ‍್ಹಶಿ<verse eid="JOS 21:45" /></para>
  <chapter eid="JOS 21" />
  <chapter number="22" style="c" sid="JOS 22" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 22:1" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಯೊರ್ದನನಾ ದಾಟಿನ ಗಯಲ್ಪರ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ <verse eid="JOS 22:1" /><verse number="2" style="v" sid="JOS 22:2" />ತುಮೆ ಮನಕ್ಹೊಮಾತಾ ಕುಲನಾ ಯಕ್ಲಾ ನಿಂಗತ ಬಾರಾ ಜನಾವೊನೆ ಇನಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 22:2" /><verse number="3" style="v" sid="JOS 22:3" />ಯೊರ್ದನನಾ ವಚ್ಮಾ ಯಾಜಕರೊ ಹುಬ್ರೆಲ ಜ಼ಗಾಕಂತಾ ಬಾರಾ ದಗ್ಡಾ ಉಚೈನ ತೆ ದಗ್ಡಾವೊನೆ ತುಮಾರಾ ಕ್ಹಾತೆ ಆ ಜ಼ಗಾಕನ ಲೈನ ತುಮೆ ಆ ರಾತೆ ಉತ್ರಾನಿ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡೊ ಕೈನ ಆಜ್ಞಾಕರು ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 22:3" /><verse number="4" style="v" sid="JOS 22:4" />ತೆಳಾಮಾ ಯೆಹುಶುವಾ ತೆ ಇಸ್ರಾಯಲಮಾತೊ ಕುಲತಾ ಯಕ್ಲಾ ನಿಂಗತ ಇನಿಲಿದಲ ಬಾರಾ ಜನಾ ಮನಕ್ಹೊನೆ ಬಲೈನ ತ್ಯುನೊನೆ <verse eid="JOS 22:4" /><verse number="5" style="v" sid="JOS 22:5" />ತುಮೆ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಪೈಲಾಜ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಗೈನ ಇಸ್ರಾಯೆಲ ಕುಲನಾ ನಂಬರನೆ ಕರೆಟ್ಟ ಥೌ ಕೈನ ಹರಯಕ್ಲೊ ಯಕ್ಕ ಯಕ್ಕ ದಗ್ಡೊ ಕ್ಹಾಂದಾಪರ ಉಚೈಲಿನ ಆವೊ. <verse eid="JOS 22:5" /><verse number="6" style="v" sid="JOS 22:6" />ತೆ ತುಮಾರಾ ವಚ್ಮಾ ವಳಕ ಥಾವಸ ಅಗಲ್ಯಾ ಜಲಮಮಾ ತುಮಾರಾ ಬಚ್ಚಾ ತೆ ದಗ್ಡಾ ಸು ಸುಚಿತ ಕರಸ ತುಮೊನೆ ಪುಚ್ಚ್ತಾಮಾ ತುಮೆ ತ್ಯುನೊನೆ <verse eid="JOS 22:6" /><verse number="7" style="v" sid="JOS 22:7" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನಾ ಯೊರ್ದನ ದಾಟತಾಮಾ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈಪಡ್ಯುತು ಕೈನ ಕವೊ.ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈ ಪಡ್ಯುತು ಕೈನ ಆ ದಗ್ಡಾ ಇಸ್ರಾಯಲೊನೆ ಕೆಳಾಮಾಬಿ ಸಾಕ್ಷಿ ಥಾವಸ ಕದ್ಯೊ. <verse eid="JOS 22:7" /><verse number="8" style="v" sid="JOS 22:8" />ಇಸ್ರಾಯಲೊ ಯೆಹೊಶುವಾ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಕರ‍್ಯಾ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಕದಲ ನಿಂಗತ ತ್ಯುನೆ ಇಸ್ರಾಯಲನಾ ಕುಲ ನಂಬರನಾ ನಿಂಗತ ಯೊರ್ದನನಾ ವಚ್ಮಾತಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಉಚೈನ ತ್ಯುನೆ ಉತ್ರಾನ ಜ಼ಗಾಕನ ಲೈನ ತ್ಯಾ ಹುಬ್ರಾಡ್ಯಾ. <verse eid="JOS 22:8" /><verse number="9" style="v" sid="JOS 22:9" />ತೆ ನೈಸೊ ಯೆಹುಶುವಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಲಿನ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊ ಹುಬ್ರೈಯಲ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡ್ಯಾ.ತೆ ಹಮ್ನಾತಾ ತ್ಯಾಜ ರ‍್ಹವಸ. <verse eid="JOS 22:9" /><verse number="10" style="v" sid="JOS 22:10" />ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಯೆಹುಶುವಾ ಮನಕ್ಹೊನೆ ತಿಳಸಲ ಯಹೊವಾನಾ ಅಪ್ಪಣೆ ಕ್ಹಾರಾ ತ್ಯುನೆ ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಹುಬ್ರೈಯಾ.ಮನಕ್ಹೊ ಭೆಗಿನ ತಳು ದಾಟ್ಯಾ. <verse eid="JOS 22:10" /><verse number="11" style="v" sid="JOS 22:11" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ತ್ಯಾ ಗಯಲ್ಪರ ಯಾಜಕೊ ಯಹೊವಾನಾ ಮಂಜುಷ ಕ್ಹರಿ ಥೈನ ದಾಟಿನ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮಾ ಗಯಾ. <verse eid="JOS 22:11" /><verse number="12" style="v" sid="JOS 22:12" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಯುದ್ಧ ಸಿದ್ಧ ಥೈನ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾಮಾತಾ ಗೈನ ತಳು ದಾಟಿಪಡ್ಯಾ. <verse eid="JOS 22:12" /><verse number="13" style="v" sid="JOS 22:13" />ತ್ಯುನೆ ಸುಮಾರ ಚಾಳಕ್ಹ ಹಜಾರ ಭಟ ಥೈನ ಯುದ್ಧ ಕರಾನಾಹುತಿ ಯಹೊವಾನಾ ಕ್ಹಾಮಾ ಯರಿಕೊನಾ ಬೈಲನೆ ಆಯಾ. <verse eid="JOS 22:13" /><verse number="14" style="v" sid="JOS 22:14" />ತೆ ದಿನ್ನೆ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾರಾ ನಜರಮಾ ಘನ ಪಡಸಲಕ್ಹು ಮೊಶೆಮಾ ಕಿಮ್ಮ ತಿಮ್ಮಜ ಅನಾಮಾಬಿ ಇನಾ ಜಿವಕ್ಹು ದಿನಕ್ಹಾರೊ ಭಯ ಭಕ್ತಿವಾಲಾ ವ್ಹತ್ತಾ. <verse eid="JOS 22:14" /><verse number="15" style="v" sid="JOS 22:15" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 22:15" /><verse number="16" style="v" sid="JOS 22:16" />ಯೊರ್ದನನತಾ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕವಾನೆ <verse eid="JOS 22:16" /><verse number="17" style="v" sid="JOS 22:17" />ತೆ ತೆ ಯಾಜಕೊನೆ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕದ್ಯೊ. <verse eid="JOS 22:17" /><verse number="18" style="v" sid="JOS 22:18" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ಯೊರ್ದನತಾ ಉಪ್ಪರ ಐನ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ ತ್ಯುನಾ ಪಗೊ ಮ್ಹೆಲೆಲ್ಪರ ಪಾನಿ ಪೈಲಾತುಜ ಐನ ಯೊರ್ದನನು ತಳು ಭರಿನ ವ್ಹೈನ ಚಾಲ್ಯುತು. <verse eid="JOS 22:18" /><verse number="19" style="v" sid="JOS 22:19" />ಮನಕ್ಹೊ ಯಕವಾ ಮ್ಹೈನಾನಾ ದಕ್ಹವಾ ದಿನಮಾ ಯೊರ್ದನ ದಾಟಿನ ಯೆರಿಕೊನಾ ಪೂರ್ವ ಪ್ರಾಂತ್ಯಮಾ ರ‍್ಹವಾನು ಗಿಲ್ಗಾಲ ಕವಾನಾ ಗಾಮಾ ಉತ್ರ್ಯಾ. <verse eid="JOS 22:19" /><verse number="20" style="v" sid="JOS 22:20" />ಯೆಹುಶುವಾ ಯೊರ್ದನತೊ ಲಿನ ಆಯಲ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಗಿಲ್ಗಾಲಮಾ ಹುಬ್ರಾಡಿನ ಇಸ್ರಾಯಲೊನೆ <verse eid="JOS 22:20" /><verse number="21" style="v" sid="JOS 22:21" />ಅಗಲ್ಯಾ ಕಾಲಮಾ ತುಮಾರಾ ಬಚ್ಚಾ ಆ ದಗ್ಡಾವೊನೆ ಕಾ ಹುಬ್ರಾಡ್ಯಾಸ ಕದ್ಯಾಮ ತುಮೊನೆ ಪುಚ್ಯಾಮ ತುಮೆ ತ್ಯುನೊನೆ <verse eid="JOS 22:21" /><verse number="22" style="v" sid="JOS 22:22" />ಇಸ್ರಾಯಲೊ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ ಥಯಲ ಆ ಯೊರ್ದನ ದಾಟಿನ ಆಯಲಕ್ಹು ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 22:22" /><verse number="23" style="v" sid="JOS 22:23" />ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ ನಂಗತ ಹಮ್ನಾ ಅಪೊನಾ ಕ್ಹಾಮಾ ಆ ಯೊರ್ದನೆ ಬತ್ತಿನ ತುಮೊನೆ ದಟಾಡ್ಯೊಸ. <verse eid="JOS 22:23" /><verse number="24" style="v" sid="JOS 22:24" />ಇನಾಹುತಿ ಭುಲೊಕನಾ ಕ್ಹಾರಾ ಯಹೊವಾನಾ ಹಸ್ತ ಪರಾಕ್ರಮ ವ್ಹೈಕೈನ ತಿಳ್ದಿಲಿವಸ ತುಮಾರಾ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಕೆಳಾಮಾಬಿ ಬುಚ್ಕಾಲಾ ವ್ಹೈ ಕದ್ಯೊ. <verse eid="JOS 22:24" /><verse number="25" style="v" sid="JOS 22:25" />ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು ಹಮೊನೆ ದಿದ್ಯೊಸ; ತಿನಾ ನಿವಾಸಿಯೊ ಕ್ಹಾರಾ ಹಮಾರಾ ನಿಮಿತ್ತ ಕಂಗಟ್ಟನಿ ಗಯಾಸ ಕೈನ ತಿಳಶ್ಯಾ. <verse eid="JOS 22:25" /><verse number="26" style="v" sid="JOS 22:26" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 22:26" /><verse number="27" style="v" sid="JOS 22:27" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 22:27" /><verse number="28" style="v" sid="JOS 22:28" />ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು ಹಮೊನೆ ದಿದ್ಯೊಸ; ತಿನಾ ನಿವಾಸಿಯೊ ಕ್ಹಾರಾ ಹಮಾರಾ ನಿಮಿತ್ತ ಕಂಗಟ್ಟನಿ ಗಯಾಸ ಕೈನ ತಿಳಶ್ಯಾ. <verse eid="JOS 22:28" /><verse number="29" style="v" sid="JOS 22:29" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 22:29" /><verse number="30" style="v" sid="JOS 22:30" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 22:30" /><verse number="31" style="v" sid="JOS 22:31" />ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು ಹಮೊನೆ ದಿದ್ಯೊಸ; ತಿನಾ ನಿವಾಸಿಯೊ ಕ್ಹಾರಾ ಹಮಾರಾ ನಿಮಿತ್ತ ಕಂಗಟ್ಟನಿ ಗಯಾಸ ಕೈನ ತಿಳಶ್ಯಾ. <verse eid="JOS 22:31" /><verse number="32" style="v" sid="JOS 22:32" />ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ <verse eid="JOS 22:32" /><verse number="33" style="v" sid="JOS 22:33" />ತೆ ನೈಸೊ ತ್ಯುನೆ ಯೆಹುಶುವಾನೆ ಯಹೊವಾ ಕ್ಹರಿಜ಼ ತೆ ದೆಶ ಕ್ಹಾರು ಹಮೊನೆ ದಿದ್ಯೊಸ; ತಿನಾ ನಿವಾಸಿಯೊ ಕ್ಹಾರಾ ಹಮಾರಾ ನಿಮಿತ್ತ ಕಂಗಟ್ಟನಿ ಗಯಾಸ ಕೈನ ತಿಳಶ್ಯಾ. <verse eid="JOS 22:33" /><verse number="34" style="v" sid="JOS 22:34" />ನಕ್ಹೊ ಯಕವಾ ಮ್ಹೈನಾನಾ ದಕ್ಹವಾ ದಿನಮಾ ಯೊರ್ದನ ದಾಟಿನ<verse eid="JOS 22:34" /></para>
  <chapter eid="JOS 22" />
  <chapter number="23" style="c" sid="JOS 23" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 23:1" />ಆಕಾಶಿಯಾಮಾ ಘರೊ ಕರಿಲಿದ್ಯಾತಾ. ಯೆಹುಶುವಾ ಬೆ ಉಡಾಚಾರ ಕರಾಲಾವೊನೆ ಯೆರಿಕೊ ಗಾಮನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ವಳಾಯೊ. ಎ ಮನಕ್ಹೊನೆ ಯೆಹುಶುವಾ ವಳಾಯಲ ಸಂಗತಿ ಬಿಜು ಕಿನೆಜ ಗ್ವತ್ತ ನ್ಹೊತು.ಗೈನ ತೆ ಯೆರಿಕೊ ಗಾಮನೆ ಘನ್ನ ಸುಕ್ಷ್ಮಕ್ಹು ದೆಕೊ” ಕೈನ ಯೆಹುಶುವಾ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಕದ್ಯೊ. ತೆ ಭಂಬಿ ಜನಾ ಯೆರಿಕೊ ಗಾಮೆ ಗೈನ ಯಕ್ಕ ವ್ಯಶ್ಯಾನಾ ಘರಮಾ ರ‍್ಹಯಾ. ತೆ ಬಾಕಡಿನು ನಾಮ ‘ರಾಹಾಬ.’ <verse eid="JOS 23:1" /><verse number="2" style="v" sid="JOS 23:2" />ತೆಳಾಮಾ ಕುನ್ನ ಯಕ್ಕ ಯೆರಿಕೊ ಗಾಮನಾ ರಾಜಾನೆ.ಕಾಲ ರಾತೆ ಇಸ್ರಾಯೆಲನಾ ದಕ್ಹಾ ಜನಾ ಅಪ್ನಾ ದೆಶಾ ಕಮಜೊರಿಯೊನೆ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಕದ್ಯಾ. <verse eid="JOS 23:2" /><verse number="3" style="v" sid="JOS 23:3" />ತೆಳಾಮಾ ಯೆರಿಕೊ ಗಾಮನೊ ರಾಜೊ ರಾಹಾಬನೆ.ತಾರಾ ಘರೆ ಐನ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಝಾಕಿನ ಮ್ಹೆಲು ನಕೊ. ತ್ಯುನೊನೆ ಭಾರಿ ಬಲೈ ಲಿನ ಆ. ತ್ಯುನೆ ಅಪ್ನಾ ದೆಶನಾ ಹುತಿ ತಿಳ್ದಿಲಿವಾನೆ ಆಯಾಸ” ಕೈನ ಮೊಕ್ಲೊ. <verse eid="JOS 23:3" /><verse number="4" style="v" sid="JOS 23:4" />ರಾಹಾಬ ಎ ಭಂಬಿ ಜನಾವೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. ತೆನೈಸೊ ತೆ ಪುಚ್ಚಾನೆ ಆಯಲವಾಲಾವೊನೆ.ಬೆ ಮನಕ್ಹೊ ನ್ಹ್ಯಾ ಆಯಾತಾ, ತೆನೈಸೊ ತ್ಯುನೆ ಕಿಜಾಂತಾ ಆಯಾತಾ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ನ್ಹೊತು. <verse eid="JOS 23:4" /><verse number="5" style="v" sid="JOS 23:5" />ಖಾಂಜೆ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಾನು ಟೈಮ ಥಾತಾಮಾ ತ್ಯುನೆ ಗೈಪಡ್ಯಾ. ಗಯಮ ತ್ಯುನೊನೆ ಧರ ಸಕೊಶಿ” ಕದಿ. <verse eid="JOS 23:5" /><verse number="6" style="v" sid="JOS 23:6" />ತೆನೈಸೊ ತೆ ಕ್ಹರಿಮಾಜ ತೆ ಗುಡಾಚಾರಿಯೊನೆ ಛತ್ತನಾ ಉಪ್ಪರ ಬಲೈ ಲಿನ ಗೈನ ವಟ್ಟಲ ಚಾರಾಮಾ ತ್ಯುನೊನೆ ಝಾಕಿನ ಮ್ಹೆಲಿತಿ. <verse eid="JOS 23:6" /><verse number="7" style="v" sid="JOS 23:7" />ರಾಜಾನಾ ಭಟ್ಟೊ ಗಾಮನಾ ಭಾರಾ ಗೈನ ಗಾಮನಾ ಬಾಕಲೊ ಝಾಕಿನ ಇಸ್ರೆಲತಾ ಆಯಲ ತೆ ಭಂಬಿ ಜನಾವೊನೆ ಹುಡಕಿನ ಗಯಾ. ತ್ಯುನೆ ಯೊರ್ದನ ನದಿ ಲಕ್ಕಾ ಗೈನ ಮನಕ್ಹೊ ನದ ದಾಟಾನಾ ಕ್ಹಾಟರಾ ಜ಼ಗಾವೊಮಾ ಹುಡಕ್ಯಾ. <verse eid="JOS 23:7" /><verse number="8" style="v" sid="JOS 23:8" />ತೆ ಭಂಬಿ ಗುಡಾಚಾರಿಯೊ ತ್ಯಾಜ ಕ್ಹುರ್xಯಾವಾನೆ ತಯ್ಯಾರಿ ಕರಿಲಿದ್ಯಾತಾ. ತೆನೈಸೊ ರಾಹಾಬ ಛತ್ತನಾ ಉಪ್ಪರ ಗೈನ ತ್ಯುನಾ ಕ್ಹಾತೆ ಬೊಲಿನ, <verse eid="JOS 23:8" /><verse number="9" style="v" sid="JOS 23:9" />''ಯಹೊವಾ ಎ ದೆಶನೆ ತುಮಾರಾ ಮನಕ್ಹೊನೆ ದಿದ್ಯೊಸ ಕೈನ ಮನೆ ಗ್ವತ್ತ ಛೆ. ತುಮಾರಿ ವಿಶಯ ಐಕಿನ ಹಮೊನೆ ಭೆಂ ಹುಟ್ಯುಸ. ಎ ದೆಶಮಾ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ತುಮೊಕ್ಹು ಭುಚ್ಕಿನ ಛೆ. <verse eid="JOS 23:9" /><verse number="10" style="v" sid="JOS 23:10" />ಯಹೊವಾ ತುಮೊನೆ ಸಹಾಯ ಕರಲ ತರಿಕಾನಾ ಹುತಿ ಹಮೆ ಐಕಿನ ಭುಚ್ಚಕ್ಯಾಸ. ತುಮೆ ಇಜಿಪ್ಟತಾ ಭಾರಾ ಆಯಲ್ಪರ ತೆ ಲಾಲ ಸಮುಂದರನಾ ಪಾನಿನೆ ಕ್ಹುಕ್ಹಾಯಲ ಹಮೆ ಐಕ್ಯಾಸ. ಯೊರ್ದನ ನದಿನಾ ಪುರ್ವ ದಿಕ್ಕಮಾ ರ‍್ಹಯಲ ಸಿಹೊನ ವರಿ ಒಗ್ ಕವಾನಾ ಅಮೊರಿಯನಾ ಬೆ ಜನಾ ರಾಜಾವೊನೆ ತುಮೆ ಕಿಮ್ಮ ನಾಶ ಕರ್‍ಯಾಸ ಕವಾನು ಐಕ್ಯಾಸ. <verse eid="JOS 23:10" /><verse number="11" style="v" sid="JOS 23:11" />ಎ ಕ್ಹಾರಾವೊನಾಹುತಿ ಐಕಿನ ಹಮೊನೆ ಘನ್ನು ಭೆಂ ಐಯುಸ; ಹಮೊಮಾ ಕಿನೆಜ ತುಮಾರಾ ಕ್ಹಾತೆ ಯುದ್ದ ಕರಾನೆ ಧೈರ್ಯ ನತ್ತಿ. ಕಾಕದ್ಯಾಮ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ, ಭುಪರಲೊಕನೆ ಆಳಾಲೊ ಥಯೊಸ. <verse eid="JOS 23:11" /><verse number="12" style="v" sid="JOS 23:12" />ನೆ ಯಕ್ಕ ಪ್ರಮಾಣ ಕರು. ಮಿ ತುಮೊನೆ ದಯಾ ದೆಕಾಡಿನ ಸಹಾಯ ಕರಿ. ತಿನಾಹುತಿ ತುಮೆಬಿ ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ದಯಾ ದೆಕಾಡೊಶಿ ಕೈನ ಯಕ್ಕ ವಳಕ ದಿವೊ. <verse eid="JOS 23:12" /><verse number="13" style="v" sid="JOS 23:13" />ಮಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಕದ್ಯಾಮ ಮಾರಾ ಮಾ ಬಾಪನೆ, ಭಾಯೊ ಭೆನೊನೆ ವರಿ ತ್ಯುನಾ ಕ್ಹಾರಾ ಕುಟುಂಬವಾಲಾವೊನೆ ಜಿವ್ತಾ ಛೊಡಾನೆ ಪ್ರಮಾಣ ಕರೊ” ಕೈನ ಮಾಂಗಿಲಿದಿ. <verse eid="JOS 23:13" /><verse number="14" style="v" sid="JOS 23:14" />ತಿನಾಹುತಿ ತ್ಯುನೆ.ಹಮಾರು ಜಲಮ ದಿನಬಿ ತುಮಾರು ಜಲಮ ವಚಾ಼ಡೆಸ. ತೆನೈಸೊ ತುಮೆ ಎ ಕಿನೆಜ ಕವೊ ನಕೊ. ಯಹೊವಾ ಎ ದೆಶ ಹಮೊನೆ ದಿದಲ್ಪರ ಹಮೆ ತುಮೊನೆ ದಯಾ ದೆಕಾಡೆಸ. ತುಮೆ ಹಮೊನೆ ಬರೊಕ್ಹೊ ಕರ ಸಕೊಶಿ” ಕದ್ಯಾ. <verse eid="JOS 23:14" /><verse number="15" style="v" sid="JOS 23:15" />ರಾಹಾಬನಾ ಘರನೆ ಗಾಮನಿ ಗೊಡಿಯೆ ಲಾಗಿನ ಭಾಂದ್ಯಾತಾ <verse eid="JOS 23:15" /><verse number="16" style="v" sid="JOS 23:16" />ತುಮೆ ಪಾಚಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಮಳಲ ನಂಗತ ತೆ ಪರ್ವತನೆ ನ್ಹಾಟಿನ ಜಾವೊ ತ್ಯಾ ತನ್ನ ದಿನ ದಡಿನ ರೈನ ತ್ಯುನೆ ಗಯಲ್ಪರ ತುಮಾರಿ ವಾಟ ಧರಿನ ಜಾವೊ ಕೈನ ಕದಿ.<verse eid="JOS 23:16" /></para>
  <chapter eid="JOS 23" />
  <chapter number="24" style="c" sid="JOS 24" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 24:1" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಯೊರ್ದನನಾ ದಾಟಿನ ಗಯಲ್ಪರ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ <verse eid="JOS 24:1" /><verse number="2" style="v" sid="JOS 24:2" />ಯಕ್ಲಾ ನಿಂಗತ ಬಾರಾ ಜನಾವೊನೆ ಇನಿಲಿನ ತ್ಯುನೊನೆ <verse eid="JOS 24:2" /><verse number="3" style="v" sid="JOS 24:3" />ಯೊರ್ದನನಾ ವಚ್ಮಾ ಯಾಜಕರೊ ಹುಬ್ರೆಲ ಜ಼ಗಾಕಂತಾ ಬಾರಾ ದಗ್ಡಾ ಉಚೈನ ತೆ ದಗ್ಡಾವೊನೆ ತುಮಾರಾ ಕ್ಹಾತೆ ಆ ಜ಼ಗಾಕನ ಲೈನ ತುಮೆ ಆ ರಾತೆ ಉತ್ರಾನಿ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡೊ ಕೈನ ಆಜ್ಞಾಕರು ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 24:3" /><verse number="4" style="v" sid="JOS 24:4" />ತೆಳಾಮಾ ಯೆಹುಶುವಾ ತೆ ಇಸ್ರಾಯಲಮಾತೊ ಕುಲತಾ ಯಕ್ಲಾ ನಿಂಗತ ಇನಿಲಿದಲ ಬಾರಾ ಜನಾ ಮನಕ್ಹೊನೆ ಬಲೈನ ತ್ಯುನೊನೆ <verse eid="JOS 24:4" /><verse number="5" style="v" sid="JOS 24:5" />ತುಮೆ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನಾ ಮಂಜುಷನಾ ಪೈಲಾಜ <verse eid="JOS 24:5" /><verse number="6" style="v" sid="JOS 24:6" />ತೆ ತುಮಾರಾ ವಚ್ಮಾ ವಳಕ ಥಾವಸ ಅಗಲ್ಯಾ ಜಲಮಮಾ ತುಮಾರಾ ಬಚ್ಚಾ ತೆ ದಗ್ಡಾ ಸು ಸುಚಿತ ತ್ಯುನೊನೆ <verse eid="JOS 24:6" /><verse number="7" style="v" sid="JOS 24:7" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನಾ ಯೊರ್ದನ ದಾಟತಾಮಾ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈಪಡ್ಯುತು ಕೈನ ಕವೊ.ಯೊರ್ದನನು ಪಾನಿ ಹುಬ್ರೈ ಪಡ್ಯುತು ಕೈನ ಆ ದಗ್ಡಾ ಇಸ್ರಾಯಲೊನೆ ಕೆಳಾಮಾಬಿ ಸಾಕ್ಷಿ ಥಾವಸ ಕದ್ಯೊ. <verse eid="JOS 24:7" /><verse number="8" style="v" sid="JOS 24:8" />ಇಸ್ರಾಯಲೊ ಯೆಹೊಶುವಾ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಕರ‍್ಯಾ ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಕದಲ ನಿಂಗತ ತ್ಯುನೆ ಇಸ್ರಾಯಲನಾ ಕುಲ ನಂಬರನಾ ನಿಂಗತ ಯೊರ್ದನನಾ ವಚ್ಮಾತಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಉಚೈನ ಗಾಕನ ಲೈನ ತ್ಯಾ ಹುಬ್ರಾಡ್ಯಾ. <verse eid="JOS 24:8" /><verse number="9" style="v" sid="JOS 24:9" />ತೆ ನೈಸೊ ಯೆಹುಶುವಾ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಲಿನ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊ ಹುಬ್ರೈಯಲ ಜ಼ಗಾಕನ ಹುಬ್ರಾಡ್ಯಾ.ತೆ ಹಮ್ನಾತಾ ತ್ಯಾಜ ರ‍್ಹವಸ. <verse eid="JOS 24:9" /><verse number="10" style="v" sid="JOS 24:10" />ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ತಿಳಸಲ ಯಹೊವಾನಾ ಅಪ್ಪಣೆ ಕ್ಹಾರಾ ತ್ಯುನೆ ಕರೆಲಕ್ಕಾ ಮಂಜುಷನೆ ಉಚೈಲಿದಲ ಯಾಜಕೊ ಯೊರ್ದನನಾ ವಚ್ಮಾ ಹುಬ್ರೈಯಾ.ಮನಕ್ಹೊ ಭೆಗಿನ ತಳು ದಾಟ್ಯಾ. <verse eid="JOS 24:10" /><verse number="11" style="v" sid="JOS 24:11" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ತ್ಯಾ ಗಯಲ್ಪರ ಯಾಜಕೊ ಯಹೊವಾನಾ ಮಂಜುಷ ಕ್ಹರಿ ಥೈನ ದಾಟಿನ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮಾ ಗಯಾ. <verse eid="JOS 24:11" /><verse number="12" style="v" sid="JOS 24:12" />ರುಬೆನ್ಯರೊ ಗಾದ್ಯರೊ ಮನಸ ಕುಲನಾ ಅರ್ಧಾ ಮನಕ್ಹೊ ಮೊಶೆ ಆಜ್ಞಾ ಕರಲ ನಿಂಗತ ಯುದ್ಧ ಸಿದ್ಧ ಥೈನ ಇಸ್ರಾಯೆಲನಾ ಕ್ಹಾಮಾತಾ ಗೈನ ತಳು ದಾಟಿಪಡ್ಯಾ. <verse eid="JOS 24:12" /><verse number="13" style="v" sid="JOS 24:13" />ತ್ಯುನೆ ಸುಮಾರ ಚಾಳಕ್ಹ ಹಜಾರ ಭಟ ಥೈನ ಯುದ್ಧ ಕರಾನಾಹುತಿ ಯಹೊವಾನಾ ಕ್ಹಾಮಾ ಯರಿಕೊನಾ ಬೈಲನೆ ಆಯಾ. <verse eid="JOS 24:13" /><verse number="14" style="v" sid="JOS 24:14" />ತೆ ಮ್ಮಜ ಅನಾಮಾಬಿ ಇನಾ ಜಿವಕ್ಹು ದಿನಕ್ಹಾರೊ ಭಯ ಭಕ್ತಿವಾಲಾ ವ್ಹತ್ತಾ. <verse eid="JOS 24:14" /><verse number="15" style="v" sid="JOS 24:15" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 24:15" /><verse number="16" style="v" sid="JOS 24:16" />ಯೊರ್ದನನತಾ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕವಾನೆ <verse eid="JOS 24:16" /><verse number="17" style="v" sid="JOS 24:17" />ತೆ ತೆ ಯಾಜಕೊನೆ ಉಪ್ಪರ ಆವಾನಾಹುತಿ ಕದ್ಯೊ. <verse eid="JOS 24:17" /><verse number="18" style="v" sid="JOS 24:18" />ಯಹೊವಾನಾ ಒಡಂಬಡಿಕೆನಾ ಮಂಜುಷನೆ ಉಚಾಯೆಲ ಯಾಜಕೊ ಯೊರ್ದನತಾ ಉಪ್ಪರ ಐನ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ್ಪರ ತ್ಯುನಾ ಪಗೊ ಮ್ಹೆಲೆಲ್ಪರ ಪಾನಿ ಪೈಲಾತುಜ ಐನ ಯೊರ್ದನನು ತಳು ಭರಿನ ವ್ಹೈನ ಚಾಲ್ಯುತು. <verse eid="JOS 24:18" /><verse number="19" style="v" sid="JOS 24:19" />ಮನಕ್ಹೊ ಯಕವಾ ಮ್ಹೈನಾನಾ ದಕ್ಹವಾ ದಿನಮಾ ಯೊರ್ದನ ದಾಟಿನ ಯೆರಿಕೊನಾ ಪೂರ್ವ ಪ್ರಾಂತ್ಯಮಾ ರ‍್ಹವಾನು ಗಿಲ್ಗಾಲ ಕವಾನಾ ಗಾಮಾ ಉತ್ರ್ಯಾ. <verse eid="JOS 24:19" /><verse number="20" style="v" sid="JOS 24:20" />ಯೆಹುಶುವಾ ಯೊರ್ದನತೊ ಲಿನ ಆಯಲ ಬಾರಾ ದಗ್ಡಾವೊನೆ ಗಿಲ್ಗಾಲಮಾ ಹುಬ್ರಾಡಿನ ಇಸ್ರಾಯಲೊನೆ <verse eid="JOS 24:20" /><verse number="21" style="v" sid="JOS 24:21" />ಅಗಲ್ಯಾ ಕಾಲಮಾ ತುಮಾರಾ ಬಚ್ಚಾ ಆ ದಗ್ಡಾವೊನೆ ಕಾ ಹುಬ್ರಾಡ್ಯಾಸ ಕದ್ಯಾಮ ತುಮೊನೆ ಪುಚ್ಯಾಮ ತುಮೆ ತ್ಯುನೊನೆ <verse eid="JOS 24:21" /><verse number="22" style="v" sid="JOS 24:22" />ಇಸ್ರಾಯಲೊ ಕ್ಹುಕ್ಹಿ ಜಿಮಿನ ಥಯಲ ಆ ಯೊರ್ದನ ದಾಟಿನ ಆಯಲಕ್ಹು ಕೈನ ಕದ್ಯೊ. <verse eid="JOS 24:22" /><verse number="23" style="v" sid="JOS 24:23" />ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಅಪ್ನಾ ಕ್ಹಾಮೊ ಲಾಲ ಸಮಂದರ ಬತ್ತಿನ ಅಪೊನೆ ದಾಟಲ ನಂಗತ ಹಮ್ನಾ ಅಪೊನಾ ಕ್ಹಾಮಾ ಆ ಯೊರ್ದನೆ ಬತ್ತಿನ ತುಮೊನೆ ದಟಾಡ್ಯೊಸ. <verse eid="JOS 24:23" /><verse number="24" style="v" sid="JOS 24:24" />ಇನಾಹುತಿ ಭುಲೊಕನಾ ಕ್ಹಾರಾ ಯಹೊವಾನಾ ಹಸ್ತ ಪರಾಕ್ರಮ ವ್ಹೈಕೈನ ತಿಳ್ದಿಲಿವಸ ತುಮಾರಾ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾನೆ ಕೆಳಾಮಾಬಿ ಬುಚ್ಕಾಲಾ ವ್ಹೈ ಕದ್ಯೊ. <verse eid="JOS 24:24" /><verse number="25" style="v" sid="JOS 24:25" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 24:25" /><verse number="26" style="v" sid="JOS 24:26" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 24:26" /><verse number="27" style="v" sid="JOS 24:27" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 24:27" /><verse number="28" style="v" sid="JOS 24:28" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 24:28" /><verse number="29" style="v" sid="JOS 24:29" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 24:29" /><verse number="30" style="v" sid="JOS 24:30" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 24:30" /><verse number="31" style="v" sid="JOS 24:31" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 24:31" /><verse number="32" style="v" sid="JOS 24:32" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ <verse eid="JOS 24:32" /><verse number="33" style="v" sid="JOS 24:33" />ಯಹೊವಾ ಯೆಹುಶುವಾನೆ ಆಜ್ಞಾ ಶಾಸನೊನೆ ಮಂಜುಷನೆ ಉಚಾಯಲ ಯಾಜಕೊನೆ<verse eid="JOS 24:33" /></para>
  <chapter eid="JOS 24" />
</usx>