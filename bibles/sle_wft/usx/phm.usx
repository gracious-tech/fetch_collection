<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Shikilagar</book>
  <para style="toc3">ಫಿಲೊಮನನೆ</para>
  <para style="toc2">ಫಿಲೊಮನ</para>
  <para style="toc1">ಫಿಲೊಮನನೆ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="mt2">ಪೌಲನು ಫಿಲೆಮೊನನಿಗೆ ಬರೆದ ಪತ್ರಿಕೆ</para>
  <para style="mt1">ಫಿಲೊಮನನೆ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಫಿಲೊಮೊನ ಬುಕ್ಕ ಅಪೊಸ್ತಲ ಪೌಲಾ ಬರ್ದಲ ರ‍್ಹವಸ ಪೌಲಾ ಆ ಪತ್ರ ಕೊಲೆಸ್ಸೆವಾಲಾವೊಕನ ಮೊಕ್ಲಲ ತುಖಿಕನ ಕ್ಹಾತೆ ಉನೆಸಿಮನ ಕವಾಲೊ ಜಿತದಾಳ ಗಯೊತೊ.ಎ ಒನಿಸಿಮನ ಮಾಲಕ ಫಿಲೊಮೊನ. ಫಿಲೊಮೊನ ಕೊಲೆಸ್ಸ ಸಭೆನೆ ಖಾಸ ಸದಸ್ಯವ್ಹತೊ ಕೈನ ದಕ್ಹಾ ಮನಕ್ಹೊನು ಅಭಿಪ್ರಾಯ ವ್ಹೈ. ಮಾಲಕನೆ ಛೊಡಿನ ನ್ಹಾಟಿ ಗಯಲ ಒನೆಸಿಮನ ಅದೃಷ್ಟಕ್ಹು ಪೌಲಾನೆ ವಳಕ ಪಡಸ ವರಿ ಕ್ರಿಸ್ನು ದಿಕ್ಷಾಸ್ನಾನ ಮಳಸ ತೆಳಾಮಾ ಪೌಲಾ ಜೆಲಮಾ ರ‍್ಹಯಲ ರ‍್ಹವಸ. ಪೌಲಾ ಯಕ್ಕ ಪತ್ರ ಬರ್ದಿನ ಒನೆಸಿಮನನಾ ಹತ್ಮಾ ದಿನ ಮೊಕ್ಲಸ.ಫಿಲೊಮೊನ ತಿನೊ ಜಿತದಾಳ ಒನೆಸಿಮನನಾ ಕ್ಹಾತೆ ಅಂಧಾನ ಕರಿಲ್ಯುಕೈನ ಮಾಲಕನಿ ಮಾಫಿ ಪಡ್ದಿಲಿವಾನು ಯಕ್ಕಜ಼ ನೈಸೊ ಕ್ರಿಸ್ತಯೆಸುಮಾ ತಿನಾ ಭೈ ನಿಂಗತ ತಿನೆ ಸ್ವಾಗತ ಕರುಕೈನ ಎ ಪತ್ರಮಾ ಪೌಲಾ ಮಾಗಿಲಿವಸ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">ಪಿಠಿಕೆ <char style="ior"><ref loc="PHM 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">2) ಫಿಲೊಮೊನನಾ ಹುತಿ ಪ್ರಶಂಸೆ <char style="ior"><ref loc="PHM 1:4-7">1:4-7</ref> </char></para>
  <para style="io1">3)</para>
  <para style="io1">ಒನೆಸಿಮೊನನಾ ಹುತಿ ವಿನಂತಿ <char style="ior"><ref loc="PHM 1:8-22">1:8-22</ref> </char></para>
  <para style="io1">ಖಲಾಸ<char style="ior"><ref loc="PHM 1:23-25">1:23-25</ref> </char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />ಯೆಸು ಕ್ರಿಸ್ತನಾಹುತಿ ಜೆಲ್ಮಾ ರ‍್ಹಯಲ ಪೌಲ ವರಿ ಭೈ ಥಯಲ ತಿಮೊತಿಕ್ಹು</para>
  <para style="p" vid="PHM 1:1">ಹಮಾರೊ ಮಯಾನೊ ವರಿ ಕ್ಹಾತೆ ಸೆವಾ ಕರಾನಾ ತುನೆಬಿ, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />ವರಿ ಭೆನ ಥಯಲ ಅಪ್ಫಿಯಳನೆ, ಹಮಾರಾ ಕ್ಹಾತೆ ಹೊರಾಡಾಲಾ ಅರ್ಖಿಪ್ಪನೆ ವರಿ ತುಮಾರಾ ಘರಮಾ ಮಳಿನ ಆಯಲ ಸಭೆನೆ ಬರ್ದಾನು ಸು ವ್ಹೈ ಕದ್ಯಾಮ;<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />ಅಪ್ನೊ ಬಾ ಥಯಲ ಕ್ಹುದಾ ವರಿ ಪ್ರಭು ಯೆಸು ಕ್ರಿಸ್ತನಿ ಮರಗಾ ಶಾಂತಿ ತುಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ.<verse eid="PHM 1:3" /></para>
  <para style="s">ಫಿಲೊಮೊನನಿ ಮಯಾ ವರಿ ಬರೊಕ್ಹೊ</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />ಕರ್ತಾ ಥಯಲಯೆಸುಪರ ತು ಮುಕ್ಕಲ ಬರೊಕ್ಹೊ ವರಿ ಮಯಾನಾ ಹುತಿ ಕವಾನು ಸು ವೈ ಕದ್ಯಾಮ, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />ಮಾರಿ ಪ್ರಾಥನಾಮಾ ಹಮೆಶಾಬಿ ತುನೆ ಶೆ ಕರಿಲಿನ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಕೌಸ, ತಾರಿ ಹುತಿ ಮಾಂಗಿಲ್ಯುಸ. <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />ಕ್ರಿಸ್ತಮಾ ಅಪೊನೆ ಮಳಲ ಕ್ಹಾರುಜ಼ ವರಾನಾ ಹುತಿ ತುನೆ ಕ್ಹಾರುಜ಼ ಗ್ವತ್ತ ಛೆ. ಕರ್ಇಸ್ತಮಾ ತುನೆ ತು ಅನ್ಯುನತೆಮಾ ರ‍್ಹವಾನಿಕ್ಹು ಕ್ತಿಸ್ತನೆ ಘನ್ನಿ ಮಹಿಮಾ ಥಾವಾದೆ ಕೈನ ಪ್ರಾಥನಾ ಕರುಸ. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />ಭೈ, ತಾರಾ ಮುಲಕ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ ಪ್ರೊತ್ಸಾಹ,ಪ್ರೆರಣೆ ಹುಟ್ಟಲ ಹುತಿ ತ್ಯುನಾ ಹುತಿ ರ‍್ಹಯಲ ಮಯಾ ಮನೆ ಘನ್ನಿ ಕ್ಹುಶಿ ವರಿ ಸಮಾಧಾನ ಮಳ್ಯು.<verse eid="PHM 1:7" /></para>
  <para style="s">ಒನೆಸಿಮನೆ ಮಾಫ ಕರಲ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />ಶಾನೊ ಮನಕ್ಹ ಹಮ್ನಾ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಹುತಿ ಜೆಲಮಾ ರ‍್ಹಯಲ ಪೌಲಾ ಕವಾಲೊ ಮಿ ಮಯಾನಕ್ಹು ತುನೆ ಮಂಗಿಲ್ಯುಸ. <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />ತು ಚೊ಼ಕು ರ‍್ಹಯಲಜ಼ ಕರುಕೈನ ಅಗನ್ಯಾ ಕರಾನೆ ಮನೆ ಕ್ರಿಸ್ತಮಾ ಪುರಾ ಅದಿಕಾರ ರ‍್ಹಯುತಬಿ ತಿಮ ಆಗನ್ಯಾ ದಿದ್ಯಾವಾಚಿ <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />ಮಾರೊ ದಿಕ್ರೊ ಥಯಲ ಒನೆಸಿಮನಾಹುತಿ ತುಕನ ಮಾಂಗಿಲಿವಾಡೊಸ. ಮಿ ಜೆಲ್ಮಾ ರ‍್ಹತಾಮಾ ತೆ ಮಾರೊ ದಿಕ್ರೊ ಥಯೊಸ. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />ಪೈಲಾ ತೆ ತುನೆ ಸುಜ಼ ಉಪಯೊಗವಾಲೊ ನ್ಹೊತೊ. ಹಮ್ನಾ ತೆ ಮನೆಬಿ ವರಿ ತುನೆಬಿ ಉಪಯೊಗವಾಲೊ ಥಯೊಸ.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />ತಿನೆ ಹಮ್ನಾ ತುಕನ ಫರಿನ ಮೊಕ್ಲಾಡೊಸ. ತಿನಾ ಕ್ಹಾತೆ ಮಾರಾ ಮನಸ್ನೆಬಿ ತುಕನ ಮೊಕ್ಲಾಡೊಸ. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />ಮಿ ಹಮ್ನಾ ಸುವಾರ್ತೆನಾಹುತಿ ಜೆಲ್ಮಾ ರ‍್ಹತಾಮಾ ಮನೆ ಮದದ ಕರಾನಾಹುತಿ ಮಕನ ಮುಕ್ಕಿಲ್ಯು ಕೈನ ಕೈಲಿದ್ಯೊತೊ. ನ್ಹ್ಯಾ ಮನೆ ತೆ ಮದತ ಕರತೊ ತಾರಿಬಿ ಸೆವೆ ಕರಸಕ್ತೊತೊ. <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />ತೆನೈಸೊ ಎ ವಿಶಯಮಾ ತಾರಿ ಇಜಾಜ಼ತ ಲಿದ್ಯಾವಾಚಿ ಎ ಫೈಸಲೊ ಲಿವಾನೆ ಮನೆ ಮನಸ ನತ್ತಿ. ಕಾಕದ್ಯಾಮ ತು ಕರಾನಾ ಚೊ಼ಕಾ ಕಾಮೊ ಮನಸೆ ಕರಾನು ರ‍್ಹೌ ತೆನೈಸೊ ಜಬರದಸ್ತಿಕ್ಹು ಕರು ನೈ.<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />ಒನೆಸಿಮ ದಕ್ಹಾ ದಿನ್ನ ತುಕ್ಹು ದುರ ಥಯೊತೊ. ಕಾಕದ್ಯಾಮ ತೆ ಹಮೆಶಾಬಿ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ ಕೈನ ಇಮ್ಮ ಥಯುಸುಕ್ಕ! <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />ಇತ್ತಿ ಉಪ್ಪರ ತೆ ತಾರೊ ಗುಲಾಮ ಥಯಾವಾಚಿ ಜಾಸ್ತಿ ಮಯಾನೊ ಭೈ ಥಯೊಸ. ತಿನೆ ಮಿ ಘನ್ನೊ ಮಯಾ ಕರುಸ. ತೆನೈಸೊ ತು ತಿನೆ ಘನ್ನೊ ಮಯಾ ಕರ. ತಿನೆ ತು ಯಕ್ಕ ಮನಕ್ಹ ವರಿ ಪ್ರಭುಮಾ ಯಕ್ಕ ಭೈ ವ್ಹೈ ಕೈನ ಮಯಾ ಕರ.<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />ಮನೆ ತು ತಾರೊ ಯಕ್ಕ ಸಾತಿದಾರ ವ್ಹೈ ಕೈನ ವಪ್ಪಿಲಿವಾನೊ ರ‍್ಹಯೊಮ, ಒನೆಸಿಮನನೆ ತಾರಾ ಕ್ಹಾತೆ ಮಳೈಲೆ. ತು ಮನೆ ವಪ್ಪಿಲಿದಲ ತಿಮ್ಮಜ ತಿನೆಬಿ ವಪ್ಪಿಲೆ. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />ತೆ ತುನೆ ಸುಬಿ ತಪ್ಪ ಕರ‍್ಯೊಮ ತೆ ತಪ್ಪ ಮಪರ ಘಾಲ. ತೆ ತುನೆ ಸುಬಿ ದಿವಾನೆ ರ‍್ಹಯೊಮ ತೆ ಕ್ಹಾರು ಮರಾ ಹಿಸಾಬಮಾ ಲಗಾಡ. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />ಪೌಲಾ ಥಯಲ ಮಿ ಮಾರಾ ಸ್ವಂತ ಹತೊಕ್ಹು ಎ ಕ್ಹಾರು ಬರ್ದಾಡೊಸ. ಒನೆಸಿಮ ತುನೆ ಸುಬಿ ದಿವಾನು ರ‍್ಹಯೊಮ ಮಿ ತೆ ಕ್ಹಾರು ತುನೆ ದ್ಯುಸ. ತಾರಿ ಆತ್ಮಿಕನಿ ಜಿವಿತನಾಹುತಿ ತು ಮನೆ ಕೆಕ್ಲೊ ರುಣಿ ಥಯೊಸ ಕೆಳಾಮಾಜ಼ ಮಿ ಕತೊ ನೈ. <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />ಮಾರಾ ಭೈ, ಪ್ರಭುಮಾ ಮಿ ತಾರಾಕ್ಹು ಮದತ ಹೊಂದಿಲ್ಯುಸು? ತೆ ಸುವೈ ಕದ್ಯಾಮ ತಾರಾ ಮನಸನೆ ಕ್ರಿಸ್ತಮಾ ಜತ್ತನ ಕರ.<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />ಮಿ ಮಾಂಗಿಲಿದಲ ತು ಕರ್ಸಿ ಕವಾನು ಮನೆ ಗ್ವತ್ತ ರ‍್ಹಯಲಹುತಿ ಮಿ ಎ ಪತ್ರ ಬರ್ದಾಡೊಸ. ಮಿ ಮಾಂಗಿಲಿದಲತಿಬಿ ತು ಜಾಸ್ತಿ ಕರ್ಸಿ ಕವಾನು ಮನೆ ಬರೊಕ್ಹೊ ಛೆ. <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />ಮನೆ ರ‍್ಹವಾನೆ ಯಕ್ಕ ಖೊಲಿ ತಯ್ಯಾರ ಕರ. ಕ್ಹುದಾ ತಾರಿ ಪ್ರಾಥನಾ ಐಕಿನ ಮನೆ ತುಕನ ಆವಾನಾಹುತಿ ಮೌಕೊ ದಿವಸ ಕವಾನು ಮನೆ ಬರೊಕ್ಹೊ ಛೆ.<verse eid="PHM 1:22" /></para>
  <para style="s">ಲಾಸ್ಟನಿಯೊ ವಾತೊ</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />ಕ್ರಿಸ್ತ ಯೆಸುನಾಹುತಿ ಮಾರಾ ಕ್ಹಾತೆ ಜೆಲ್ಮಾ ರ‍್ಹಯಲ ಎಪಫ್ರ ನಮಸ್ಕಾರ ಕದ್ಯೊಸ. <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />ಮಾರ್ಕ, ಅರಿಸ್ತಾಕ, ದೆಮನ, ಲೊಕ, ಇವ್ನೆ ಕ್ಹಾರಾ ತುನೆ ನಮಸ್ಕಾರ ಕದ್ಯಾಸ ಇವ್ನೆ ಕ್ಹಾರಾ ಮಾರಾ ಕ್ಹಾತೆ ಕಾಮ ಕರಾಲಾ ಥಯಾಸ.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನಿ ಕೃಪಾ ತುಮಾರಿ ಆತ್ಮಾನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ ಆಮೆನ.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>