<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EZK" style="id">- Sikkiligar</book>
  <para style="h">ಯಜಕೆಲಾ</para>
  <para style="toc3">ಯಜಕೆಲಾ</para>
  <para style="toc2">ಯಜಕೆಲಾ</para>
  <para style="toc1">ಯಜಕೆಲಾ ಬುಕ್ಕ</para>
  <para style="mt1">ಪ್ರವಾದಿ ಯೆಜೆಕಿಯೆಲನು ಗ್ರಂಥ</para>
  <para style="mt2">ಹೆಜೆಕೆಲ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಯಜಕೆಲ ಪುಸ್ತಕ ಇಸ್ರೆಲನೆ ಪತನ ವರಿ ತಿನು ಪುನಹ ಸ್ಥಾಪನೆನಾ ಹುತಿ ಭವಿಶ್ಯವಾಣಿನು ಪುಸ್ತಕ ಥಯುಸ. ಯೆಜೆಕರಲ ಪ್ರವಾದಿನಾಹುತಿ ತಿಳದಿಲಿದಲ ಕ್ಹಾರು ಎ ಪುಸ್ತಕತುಜ಼ ಆವಸ . ತಿನು ಪ್ರಾವಾದಿನಿ ಸೆವೆ ವಟ್ಟಜ 22 ವರಕ್ಹಲಕ್ಕಾ ಚಾ಼ಲ್ಯು. 7 ವರಕ್ಹಪರ್ತು ಕ್ರಿಸ್ತ ಪುರ್ವ 586 ಮಾ ಜೆರುಸೆಲಿಮ ಪಡಾನು ಪೈಲಾ ವರಿ 15 ವರಕ್ಹ ಥಯಲ್ಪರ ತಿನಾ ದರ್ಶನೊನೆ ಪ್ರತಿಕ್ರಿಯೆ ಥಯುಸ. ಹೆಜೆಕೆಲನು ಇಸ್ರೆಲನೆ ಥಾವನು ಅನೆಕ ವಿಷಯೊನೆ ಪ್ರತಿ ಉತ್ತರ ಕರಾನೆ ಜ಼ರುರತ್ತ ಛೆ. ಯಕ್ಕ ಉದಾಹರಣೆ ಅದ್ಯಾಯ 5 ಮಾ ದಿಕ್ಹಿನ ಆವಸ. ತಿನಿ ದಾಡಿನೆ ಕತ್ರಾನೆ ವರಿ ಬಾಲೊನಾ 3 ಭಾಗೊ ಕರಾನೆ ಕದ್ಯೊ. 5.1 ಯೆರುಸೆಲಿಮನೆ ಸು ಥಾವಾಸ ಕವಾನು ದೆಕಾಡಿನೆ ದಿವಸ. ಹೆಜಿಕೆಲ ಪುಸ್ತಕ 3 ಭಾಗ ಕರ‍್ಯಾಸ; ಇಸ್ರೆಲನೊ ಫೈಸಲೊ. ಆಜು಼ ಬಾಜು಼ಮಾ ರ‍್ಹಯಲ ದೆಶೊನೆ ಫೈಸಲೊ, ವರಿ ಇಸ್ರಾಯಲನೆ ಫರಿನ ಭಾಂದಾನು, ಎ ಕ್ಹಾರಾ ವಿಭಾಗೊಮ ಕ್ಹಾಸ ವಿಶಯ ಸು ವೈ ಕದ್ಯಾಮ ಅಪೆ ಕ್ಹುದಾನೆ ಕಿಮ್ಮ ವಳಕಿಲ್ಯು ಸಂಗತಿಯೊ ಕಿಮ್ಮ ಕಾರಣ ವಾಗುತ್ತವೆ ಕರಸ ಹೆಜೆಕೆಲ 60 ಜಾಸ್ತಿ ಎ ವಾತೊ ಬರದ್ಯೊ. ತೆಳಾಮಾ ತ್ಯುನೆ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ವಳಕಿಲಿವಸ”. ಕ್ಹುದಾ ಫೈಸಲೊ ಕರ್ತಾಮಾ ನೈತೊ ವರಿ ಭಾಂದಾದೆ ಕೈನ ಅಪೆ ವರಿ ತೆ ಅಪೊಕ್ಹು ಸು ಆಸ ಕರಸ ಕೈನ ವಳಕಿಯೆಸ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1. 1. ಅಧ್ಯಾಯ 1 ತು 24 ಲಕ್ಕಾ ಇಸ್ರೆಯಾಲ್ಪರ ಕ್ಹುದಾನೊ ಫೈಸಲೊ ಛೆ ಕೈನ ದಿಕ್ಹಿನ ಆವಸ.</para>
  <para style="io1">2. 25 ತು 32 ಲಕ್ಕಾ ಅಧ್ಯಾಯಮಾ ಕ್ಹುದಾ ಸುತ್ತೆ ರ‍್ಹಯಲ ದೆಶೊನೆ ಫೈಸಲೊ ಕರಸ.</para>
  <para style="io1">3. 33 ತು 48 ಅಧ್ಯಾಯೊಮಾ ಇಸ್ರಾಯೆನೆ ಪುನಹ ಸ್ಥಾಪನಾ ಕರಾನಾ ಹುತಿ ಹೆಜೆಕೆಲ ಪ್ರವಾದನೆ ಕರಸ.</para>
  <chapter number="1" style="c" sid="EZK 1" />
  <para style="s">ಕ್ಹುದಾನಿ ಸಿಂಹಾಸನ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 1:1" />ಕೆಬಾರ ನದಿನಾ ನಜಿಕ ಗುಲಾಮ ಥೈನ ರ‍್ಹಯಲ ಯೆಹುದ್ಯೊನಾ ವಚ್ಮಾ ಮಳಲಕ್ಹು ಮೂವತ್ತನಾ ವರಕ್ಹನಾ ಚಾರವಾ ಮ್ಹೈನಾನಾ ಪಾಂಚ಼ವಾ ದಿನ್ನೆ ಹಬಾಳ ಕ್ಹುಲಿನ ಮನೆ ದೆವದರ್ಶನವೊ ಥಯಾ. <verse eid="EZK 1:1" /><verse number="2" style="v" sid="EZK 1:2" />ರಾಜೊ಼ ಥಯಲ ಯೆಹೊಯಾಖಿನ ಬಂದಿ ಥೈನ ಪಾಂಚ಼ವಾ ವರಕ್ಹನಾ ಚಾರವಾ ಮ್ಹೈನಾನಾ ಪಾಂಚ಼ವಾ ದಿನ್ನೆ <verse eid="EZK 1:2" /><verse number="3" style="v" sid="EZK 1:3" />ಯಹೊವಾನಿ ವಾಕ್ಯಾ ಕಸ್ದಿಯ ದೆಶನಾ ಕೆಬಾರ ನದಿನಾ ನಜಿಕ ಬುಜಿನು ದಿಕ್ರೊ ಯಾಜಕ ಥಯಲ ಯೆಹೆಜ್ಕೆಲಾನೆ ಸಾಕ್ಷಿ ಥೈನ ದಿಕ್ಹ್ಯು; ತ್ಯಾ ಯಹೊವಾನೊ ಹತ್ತ ಮನೆ ಮುಟ್ಟಲಹುತಿ ತೆಳಾಮಾ ತಿಮಾ ತಾಕತ ಐ.<verse eid="EZK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 1:4" />ಹಮ್ನಾ ಮಿ ದೆಕಲ ದರ್ಶನ ಅಮ್ಮ ವ್ಹತೊ. ಉತ್ತರ ದಿಕ್ತೊ ಜೊ಼ರವಾರೊ ಐನ, ಛೊಡೆವಾಚಿ ಧಗ-ಧಗ ಲಾಗಲ ಆಗ ಮ್ಹೊಟು ಮ್ಹಾಡ ದಿಕ್ಹ್ಯು. ತಿನಾ ಸುತ್ತೆಬಿ ಮಿಂಚ ದಿಕ್ಹಿ, ತಿನಾ ವಚ್ಮಾ ತೆ ಆಗನಾ ವಚ್ಮಾ ಕ್ಹೊನಾನು ಉಜಾಲಾ ನಿಂಗತ ಉಟ್ಯು. <verse eid="EZK 1:4" /><verse number="5" style="v" sid="EZK 1:5" />ತಿನಾ ವಚ್ಮಾ಼ತು ಚಾರ ಜಿವಿಯೊನಾ ಆಕಾರೊ ದಿಕ್ಹಿನ ಆಯಾ. ತ್ಯುನಾ ರುಪೊ ಮನಕ್ಹನಾ ರುಪೊ ನಿಂಗತ ವ್ಹತ್ತಾ.<verse eid="EZK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 1:6" />ಯಕ್ಕ ಯಕ್ಕನೆ ಚಾರ ಮ್ಹೊಡಾ ವರಿ ಚಾರ ರಕ್ಯಾ ವ್ಹತ್ತಾ. <verse eid="EZK 1:6" /><verse number="7" style="v" sid="EZK 1:7" />ತ್ಯುನಾ ಪಗೊ ಸಿದಾ ವ್ಹತ್ತಾ ಹೆಜ್ಜಿವೊ ಗೈನಾ ಬಚ್ಚಾ಼ನಾ ಪಗೊ ನಿಂಗತ ವ್ಹತ್ತಾ. ತಿಕ್ಕಲ ಪಿತ್ತೊಳ ನಿಂಗತ ಮಿಂಚಾಡಾತಾ. <verse eid="EZK 1:7" /><verse number="8" style="v" sid="EZK 1:8" />ಯಕ್ಕ ಯಕ್ಕ ಜಿವಿನೆ ಚಾರ ಪಾರ್ಶ್ವವೊಮಾನಾ (ಬಾಜು಼ವೊಮಾ) ರೆಕ್ಯಾವೊನೆ ಮನಕ್ಹನಾ ಹತೊ ನಿಂಗತ ಹತೊ ವ್ಹತ್ತಾ; ತೆ ಚಾರೆ ಜಿವಿಯೊನಾ ಮ್ಹೊಡಾವೊ ರೆಕ್ಯಾವೊ ಕಿಮ್ಮ ವ್ಹತಾ ಕದ್ಯಾಮ <verse eid="EZK 1:8" /><verse number="9" style="v" sid="EZK 1:9" />ರೆಕ್ಯಾವೊ ಯಕ್ಕ ಯಕ್ಕನೆ ಲಾಗಾಡಾತಾ; ತೆ ಜಿವಿಯೊ ಕ್ಹಾಮಾಮಾಬಿ ಫರೆನೈಸೊ ಗೈನ ಮ್ಹೊಡಾ ಥೈನ ಚಾ಼ಲ್ಯಾತಾ.<verse eid="EZK 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 1:10" />ಮ್ಹೊಡಾ ಕಿಮ್ಮ ವ್ಹತ್ತಾ ಕದ್ಯಾಮ ಯಕ್ಕ ಯಕ್ಕನೆ ಕ್ಹಾಮಲ್ಯು ಮ್ಹೊಡು ಮನಕ್ಹನು ವ್ಹೈ, ಸಿದಾಬಗಲನು ಮ್ಹೊಡು ಸಿಂಹಾಡಾನು ವ್ಹೈ, ರೊಡ್ಡಾಬಗಲನು ಮ್ಹೊಡು ಬೈಲನು ವ್ಹೈ, ಪಾಚಲ್ಯು ಮ್ಹೊಡು ಗರುಡ ಪಕ್ಷಿನು ವ್ಹೈ, <verse eid="EZK 1:10" /><verse number="11" style="v" sid="EZK 1:11" />ತ್ಯುನಾ ರೆಕ್ಯೆವೊ ಉಪ್ಪರ ಹರಡಲ ರ‍್ಹೈ, ಯಕ್ಕ ಯಕ್ಕ ಜಿವಿನಾ ರೆಕ್ಯಾವೊ ಬಾಜು಼ ರ‍್ಹಯಲ ಜಿವಿನೆ ಲಾಗಾಡಾತಾ , ಹಜಿ ಬೆ ರೆಕ್ಯಾ ಅಂಗನೆ ಝಾಕ್ಯಾತಾ. <verse eid="EZK 1:11" /><verse number="12" style="v" sid="EZK 1:12" />ಆ ಜಿವಿಯೊ ಕ್ಹಾರಾ ಶಿದಾ ಮ್ಹೊಡಾ ಥೈನ ಚಾ಼ಲ್ಯಾತಾ, ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಚ಼ಲಾಯಲ ಜ಼ಗಾಯೆ ಗಯಾ; ಫರೆವಾಚಿ ಕ್ಹಾಮಾ ಗಯಾ;<verse eid="EZK 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 1:13" />ತೆ ಜಿವಿಯೊನಾ ವಚ್ಮಾ ಅದ್ಬುತ ಕಾಂತಿ ಬಳಾನಾ ಕೆಂಡಾವೊ ಪಂಜುವೊ ನಿಂಗತ ದಿಕ್ಹ್ಯು; ತೆ ಜಿವಿಯೊನಾ ವಚ್ಮಾ ಪ್ಹರಾಡಿಯೊತ್ಯೊ ತೆ ಆಗ ಜೊ಼ರ ಥಾವಾಡಿತಿ, ತಿಮಾತು, ಚಿಣಕಿಯೊ ಚಾ಼ಲ್ಯಾತಾ. <verse eid="EZK 1:13" /><verse number="14" style="v" sid="EZK 1:14" />ತೆ ಜಿವಿಯೊ ಮಿಂಚ ನಿಂಗತ ಅಗಾಬಿ ಪಾಚಾ಼ಬಿ ಸರಕಾಡಿತಿಯೊ.<verse eid="EZK 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 1:15" />ದೆಕ, ಮಿ ಹಮ್ನಾ ತೆ ಜಿವಿಯೊನೆ ದೆಕ್ತಾಮಾ ಯಕ್ಕ ಯಕ್ಕ ಜಿವಿನಾ ಬಾಜು಼ಮಾ ಯಕೆಕ ಗಾಲಿಯೊ ದಿಕ್ಹಿಯೊ. <verse eid="EZK 1:15" /><verse number="16" style="v" sid="EZK 1:16" />ತೆ ಗಾಲಿಯೊ ರಂಗ ಕಿಮ್ಮ ವ್ಹತ್ತು ಕದ್ಯಾಮ ತಿನಾ ವರ್ಣ ಪಿತ ರತ್ನನಾ ನಿಂಗತ ಥಳ-ಥಳ ಮಿಂಚಾ಼ಡಿತಿಯೊ. ಯಕ್ಕ ಗಾಲಿಮಾ ಹಜಿಯಕ್ಕ ಗಾಲಿ ಅಡ್ಡ ಥೈನ ರಚನೆ (ತಯ್ಯಾರ) ನಿಂಗತ ವ್ಹತ್ತು; ತೆ ಚಾರೆ ಗಾಲಿಯೊ ಯಕ್ಕ ಮಾದರಿ ಥಯುತು. <verse eid="EZK 1:16" /><verse number="17" style="v" sid="EZK 1:17" />ತೆ ಫರ್ತಾ ಟೈಮ್ಮಾ ಚಾರೆ ಬಗಲ ಕಯಾ ಬಗಲ ಥೈತಬಿ ಫರಾಡಾತಾ; ಮ್ಹೊಡಾ ಕ್ಹಾಮಾತಾ ಫರೈಲಿನ ಚಾಲ್ಯಾನ್ಹೊತಾ. <verse eid="EZK 1:17" /><verse number="18" style="v" sid="EZK 1:18" />ಗಾಲಿಯೊನಾ ಸುತ್ತೆ ಬಗಲಬಿ ಉಚ್ಚುಥಯಲಬಿ ಭಯಂಕರಥಯಲ ಥಯುತು; ಆ ಭಾಗನಾ ಕ್ಹಾರಾ ಬಗಲಬಿ ಘನ್ನಾ ಡೊಳಾ ವ್ಹತ್ತಾ; <verse eid="EZK 1:18" /><verse number="19" style="v" sid="EZK 1:19" />ಜಿವಿಯೊ ಅಗಾ ಜಾ಼ತಾಮಾ ಗಾಲಿಯೊ ತಿನಾ ಬಾಜು಼ಮಾ ಅಗಾ ಚಾ಼ಲ್ಯಾತಾ; ತೆ ಜಿವಿಯೊ ಜಿಮಿನತಾ ಉಪ್ಪರ ಉಟ್ತಾಮಾ ಗಾಲಿಯೊಬಿ ಉಟಾಡಿತಿಯೊ; <verse eid="EZK 1:19" /><verse number="20" style="v" sid="EZK 1:20" />ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಕಿ ಲಿಂಜಾ಼ವಸ ತ್ಯಾ ಗಯಾ; ಜಿವಿಯೊನೆ ಆತ್ಮಾ ಗಾಲಿಯೊಮಾ ರ‍್ಹಯಲ ಕಾರಣಕ್ಹು ಗಾಲಿಯೊ ತಿನಾ ಕ್ಹಾತೆಜ಼ ಉಟಾಡಿತಿಯೊ. <verse eid="EZK 1:20" /><verse number="21" style="v" sid="EZK 1:21" />ತ್ಯುನೆ ಅಗಾ ಜಾ಼ತಾಮ ಆಬಿ ಅಗಾ ಜಾ಼ವಸ, ತೆ ಹುಬ್ರೆನ ಜಾ಼ತಾಮಾ ಆಬಿ ಹುಬ್ರೈನ ಜಾ಼ತಾತಾ,ತೆ ಜಿಮಿನತಾ ಉಪ್ಪರ ಉಟ್ತಾಮಾ ಗಾಲಿಯೊಬಿ ತಿನಾ ಕ್ಹಾತೆಜ಼ ಉಟತಿತಿಯೊ; ಕಾ ಕದ್ಯಾಮ ಜಿವಿಯೊನಾ ಆತ್ಮಾ ಗಾಲಿಯೊಮಾಬಿ ವ್ಹತ್ತಿ.<verse eid="EZK 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 1:22" />ಭಿಕರ ಥಯಲ ಬರಪನಾ ಹೆಂಟಾ ನಿಂಗತ ಧಗ ಧಗ ಲಾಗಾನಿ ಯಕ್ಕ ತರಾನು ಜಿಮಿನುತು ತೆ ಜಿವಿನಾ ಮಾತಾನಾ ಉಪ್ಪರ ಗ್ಹಾಲಲ ವ್ಹತ್ತು. <verse eid="EZK 1:22" /><verse number="23" style="v" sid="EZK 1:23" />ತಿನಾ ಹೆಟಾ ಜಿವಿಯೊನಾ ರೆಕ್ಯಾವೊ ಮಟ್ಟಸ ಥೈನ ಅಗು ಕರಲ ಯಕ್ಕನೆ ಯಕ್ಕ ಲಾಗಾಡಾತಾ; ತೆ ನೈಸೊ ಯಕ್ಕ ಯಕ್ಕ ಜಿವಿನೆ ಅಂಗ ಝಾಕಿಲಿವಾನೆ ಬೆ ಬೆ ರೆಕ್ಯಾ ವ್ಹತ್ತಾ. <verse eid="EZK 1:23" /><verse number="24" style="v" sid="EZK 1:24" />ತೆ ಅಗಾ ಜಾ಼ತಾಮಾ ರೆಕ್ಯಾವೊನೊ ಆವಾಜ ಪಾನಿನಾ ಪ್ರವಾಹನಾ ಘೊಶನಿಂಗತ, ಸರ್ವಶಕ್ತಾನಿ ಅವಾಜ ನಿಂಗತ, ಆರ್ಭಟಾನು ಸೈನ್ಯಾನಾ ಅವಾಜ಼ ನಿಂಗತ ಮನೆ ಐಕು ಆಯು; ತೆ ಹುಬ್ರೆತಾಮಾ ರೆಕ್ಯಾವೊ ಮಡಚಿಲಿವಾಡಿತಿಯೊ. <verse eid="EZK 1:24" /><verse number="25" style="v" sid="EZK 1:25" />ತ್ಯುನಾ ಮಾತಾನಾ ಉಪ್ಪರ ರ‍್ಹಯಲ ಹಬಾಳಮಾತು ಯಕ್ಕ ಆವಾಜ ಕಾನೆ ಪಡ್ಯು. ಜಿವಿಯೊ ಹುಬ್ರೆತಾಮಾ ರೆಕ್ಯಾವೊ ಮಡಚಿಲಿವಾಡಿತಿಯೊ.<verse eid="EZK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 1:26" />ತ್ಯುನಾ ಮಾತಾನಾ ಉಪ್ಪರ ಇಂದ್ರ ನಿಲಮಣಿ ನಿಂಗತ ಮಿಂಚಾನು ಸಿಂಹಾಸನನಾ ದಿಕ್ಹ್ಯು; ತಿನಾ ಉಪ್ಪರ ಮನಕ್ಹನು ರುಪನಿಂಗತ ಯಕ್ಲೊ ಬೈಟ್ಯೊತೊ. <verse eid="EZK 1:26" /><verse number="27" style="v" sid="EZK 1:27" />ಕಂಬರ ನಿಂಗತ ದಿಕ್ಹಾನು ತಿನಾ ವಚ್ಮಾ ಭಾಗತು ಉಪ್ಪರ ಕ್ಹೊನಾ ನಿಂಗತ ಮಿಂಚಾ಼ಡ್ಯುತು ಧಗಧಗ ಸುತ್ತೆಬಿ ಆಗಬಿ ತೆ ರುಪಮಾ ಕ್ಹಾರಾ ಘನ್ನು ಉಜಾಲು ಥಾವಸ ಕೈನ ರ‍್ಹವಾನು ಅದ್ಬುತ ಮಿಂಚ ದೆಕ್ಯೊ; ಕಂಬರ ನಿಂಗತ ದಿಕ್ಹಾನು ತಿನಾ ವಚ್ಮಾನಾ ಜ಼ಗಾತಾ ಹೆಟಾ ಆಗ ಲಾಗಾಡಿತಿ ಕವಾನು ಮ್ಹೊಟು ಮಿಂಚಾನು ದೆಕ್ಯೊ; ವರಿ ಉಜಾಳು ತಿನಾ ಸುತ್ತಿ ಲಿದ್ಯುತು. <verse eid="EZK 1:27" /><verse number="28" style="v" sid="EZK 1:28" />ಪಾನಿನಾ ದಿನಮಾ ಮೆಘ ಮಂಡಲನಾ ಕಾಮನ ಬಿಲ್ಲ ಮಿಂಚಾನಾ ನಿಂಗತ ತಿನಾ ಸುತ್ತೆಬಿ ಉಜಾಳು ಪಡಿಗಯು. ಅಮ್ಮ ಯಹೊವಾನಿ ಮಹಿಮಾ ಅದ್ಬುತ ದರ್ಶನ ಥಯು.</para>
  <para style="s" vid="EZK 1:28">ಕ್ಹುದಾ ಹೆಜಿಕೆಲನೆ ಪ್ರವಾದಿ ಥಾವಾನೆ ಬಲಾಯಲ</para>
  <para style="p" vid="EZK 1:28">ಆ ಡೊಳೆ ಪಡ್ತಾಮಾ ಮಿ ಡಬ್ಬ ಪಡಿನ ಬೊಲಾವಾಲಾನಾ ಅವಾಜ಼ ಐಕ್ಯೊ.<verse eid="EZK 1:28" /></para>
  <chapter eid="EZK 1" />
  <chapter number="2" style="c" sid="EZK 2" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 2:1" />ತೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಉಟಿನ ಹುಬ್ರೆ, ತಾರಾ ಕ್ಹಾತೆ ಬೊಲುಸ ಕದ್ಯೊ. <verse eid="EZK 2:1" /><verse number="2" style="v" sid="EZK 2:2" />ತೆ ಆ ವಾತ ಕದಲ್ಪರ ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಮಾರಾಮಾ ಐನ ಮಿ ಉಟಿನ ಹುಬ್ರ್ಯಾ ವರಕ್ಹು ಕರ್‍ಯು; ತೆಳಾಮ ಮಾರಾ ಕ್ಹಾತೆ ಬೊಲಲ ವಾಲಾನಿ ಅವಾಜ಼ ಐಕ್ಯೊ. <verse eid="EZK 2:2" /><verse number="3" style="v" sid="EZK 2:3" />ತೆ ಮನೆ ಅಮ್ಮ ಕದ್ಯೊ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಮನೆ ವಿರುದ್ದ ಥೈನ ಫರಿನ ಮೊಸ ಕರಲ ಜನಾಂಗವಾಲಾ ಥಯಲ ಇಸ್ರಾಯಲೊಕನ ತುನೆ ವಳೌಸ; ಆ ದಿನ್ನ ಲಕ್ಕಾ ತ್ಯುನೆ ತ್ಯುನಾ ಪಿತೃವೊ ದಂಗೊ ಕರಾಲಾಜ಼ ಥಯಾಸ. <verse eid="EZK 2:3" /><verse number="4" style="v" sid="EZK 2:4" />ತು ತ್ಯುನೊನೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಕೈನ ಕೆ. ಮಿ ತುನೆ ಕಯಾ ಸಂತಾನವಾಲಾವೊಕನ ತುನೆ ವಳೌಸ ದೆಕ ತೆ ಸಂತಾನವಾಲಾ ಸರಮ ನೈಸೊ ವಾಲಾ ಹಟಾ ಕರಾಲಾ ಥಯಲ ರಹವಸ; <verse eid="EZK 2:4" /><verse number="5" style="v" sid="EZK 2:5" />ತೆ ದಂಗೊ ಕರಾಲಾ ವಂಶನಾ ವ್ಹೈ, ಯಕ್ಕ ವಕ್ಹತ ನೈ ಐಕ್ಯಾಮ; ವರಿ ಐಕ್ಯಾಮ ಯಕ್ಕ ಪ್ರವಾದಿ ವಚ್ಮಾ ಛೆ ಕೈನ ತ್ಯುನಾ ವಚ್ಮಾ಼ ತಿಳದಿದಲಿವಸ.<verse eid="EZK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 2:6" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತ್ಯುನೆ ಸು ಕದ್ಯಾತಬಿ ಭುಚ್ಕುನಕೊ ತ್ಯುನೆ ತುನೆ ದಿಕ್ಕಾರ ಕರಿನ ಠುಕ್ರಾವಸ ಇಚ್ಚಿಯೊನಾ ವಚ್ಮಾ ರ್ಹೌ ಕೈನ ತ್ಯುನಾ ವಚ್ಮಾ ರೈತಬಿ ತ್ಯುನೆ ದಂಗೊ ಕರಾಲಾ ರ‍್ಹಯಾತಬಿ ಭುಚ಼ಕುನಕೊ; <verse eid="EZK 2:6" /><verse number="7" style="v" sid="EZK 2:7" />ತ್ಯುನೆ ಐಕ್ಯಾ ನೈ ಐಕ್ಯಾಮ ತು ಮಾರಾ ವಾತೊನೆ ತ್ಯುನೊನೆ ಕೌಜ಼; ತ್ಯುನೆ ದಂಗೊ ಕರಾಲಾ ವ್ಹೈ.<verse eid="EZK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 2:8" />ತೆ ನೈಸೊ ತೆ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಮಿ ತುನೆ ಕವಾನಾ ವಾತೊ ಐಕ; ಅವಿದೆಯ ಥಯಲ ತೆ ವಂಶನಿಂಗತ ತು ಅವಿದೆಯೆ ಥೌ ನಕೊ; ಮಿ ದಿವಾನು ಮ್ಹೊಡು ಕ್ಹೊಲಿನ ಕ್ಹೈ ಪಡ ಕೈನ ಕದ್ಯೊ. <verse eid="EZK 2:8" /><verse number="9" style="v" sid="EZK 2:9" />ಇಮ್ಮ ಮಿ ದೆಕಾನಾಹುತಿ ಯಕ್ಕ ಹತ ಮಕನ ಫೈಲಾಯಲ ವ್ಹತ್ತು, ಹಮ್ನಾ ತಿಮಾ ಪುಸ್ತಕನಿ ಸುರಳಿ ದಿಕ್ಹ್ಯೊ; <verse eid="EZK 2:9" /><verse number="10" style="v" sid="EZK 2:10" />ತೆ ಸುರಳಿನೆ ಮಾರಾ ಕ್ಹಾಮೊ ಕ್ಹೊಲ್ಯೊ; ತಿನಾ ಭಂಭೆ ಬಗಲ ಲಿಕ್ಕಲ ವ್ಹತ್ತು; ತಿಮಾ ಲಿಕ್ಕಲ ಗೊಳಾಡಾನು, ದುಖ ದುಕಕ್ಹು ಅಡ್ಡಾನು ರವಾ ಧವಾನು ಉಳ್ಳಾಡ್ಯಾನು ಎ ಕ್ಹಾರು ಬರ್ದಲ ವ್ಹತು.<verse eid="EZK 2:10" /></para>
  <chapter eid="EZK 2" />
  <chapter number="3" style="c" sid="EZK 3" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 3:1" />ತೆ ಮನೆ ಅಮ್ಮ ಕದ್ಯೊ ಮನಕ್ಹನಾ ದಿಕ್ರಾ ತುನೆ ಮಳಲ ಆ ಸುರಳಿನೆ ತಿಳದಿಲೆ; ಅಮಾ ರ‍್ಹಯಲ ಸಂಗತಿಯೊನೆ ಇಸ್ರಾಯಲೊನಾ ವಂಶವಾಲಾವೊನೆ ಕೆ. <verse eid="EZK 3:1" /><verse number="2" style="v" sid="EZK 3:2" />ತಿನಾ ಹುತಿ ಮಿ ಮ್ಹೊಡು ಕ್ಹೊಲ್ತಾಮಾ ತೆ ಸುರಳಿ ಮನೆ ಕ್ಹಲಾಯೊ <verse eid="EZK 3:2" /><verse number="3" style="v" sid="EZK 3:3" />ತೆಳಾಮಾ ತೆ ಮನೆ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಮಿ ದಿವಾನು ಆ ಸುರಳಿನೆ ಕ್ಹೈನ ಪೆಟ ಭರಲೆ ಕೈನ ಕತಾಮಾ ತಿನೆ ಕ್ಹೈ ಪಡೊ; ತೆ ಮಾರಾ ಮ್ಹೊಡಾಮಾ ಜೆನ ನಿಂಗತ ಗಳು ವ್ಹತ್ತು. <verse eid="EZK 3:3" /><verse number="4" style="v" sid="EZK 3:4" />ಪಾಚಲ್ತೊ ತೆ ಮನೆ ಅಮ್ಮ ಕದ್ಯೊ ಮನಕ್ಹನಾ ದಿಕ್ರಾ ತು ಇಸ್ರಾಯೆಲನಾ ವಂಶವಲಾವೊಕನ ಗೈನ ಮಿ ತಿಳಾಸಾನಾ ವಾತೊ ತ್ಯುನೆ ಕೆ. <verse eid="EZK 3:4" /><verse number="5" style="v" sid="EZK 3:5" />ಮಿ ತ್ಯುನೆ ಇಸ್ರಾಯಲಾನಾ ವಂಶವಾಲಾವೊಕನ ವಳೌಸ ತ್ರಾಸ ಥಯಲ ಬಿಜಾ಼ ಜಾ಼ತವಾಲಾ ಮನಕ್ಹೊಕನ ನೈ ವಳಾತೊ, ನೈ, <verse eid="EZK 3:5" /><verse number="6" style="v" sid="EZK 3:6" />ತ್ಯುನೆ ತಿಳಸೈ ನೈಸೊ ಕಷ್ಟ ಥಯಲ ಅನ್ಯ ಬಾಷಾ ಬೊಲಾಲಾ ಬಿಜಾ಼ ಬಿಜಾ಼ ಮನಕ್ಹೊಕನ ತು ವಳಾಯಲವಾಲೊ ನ್ಹವೈ. ಹವಾವೊ ಕನ ಮಿ ತ್ಯುನೆ ವಳಾಯಲ ಪಕ್ಷಮಾ ತ್ಯುನೆ ರೈತಬಿ ಕ್ಹರಿಮಾಜ ತಾರಾ ವಾತೊನೆ ಐಕಾಡಾತಾ. <verse eid="EZK 3:6" /><verse number="7" style="v" sid="EZK 3:7" />ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ ತುನೆಬಿ ಐಕ್ತಾ ನೈ; ತ್ಯುನೆ ಮನೆಬಿ ಐಕ್ತಾ ನೈ; ತ್ಯುನೆ ಕ್ಹಾರಾ ಸರಮ ನೈಸೊವಾ ವ್ಹೈ ಹಟಾ ಕರಾಲಾ ಥಯಾಸತೊ. <verse eid="EZK 3:7" /><verse number="8" style="v" sid="EZK 3:8" />ದೆಕ, ಮಿ ತ್ಯುನಾ ಘಟ್ಟ ಮನಸೊನೆ ವಿರುದ್ದ ತಾರು ಮನಸ ಘಟ್ಟ ಕರ‍್ಯೊಸ. ತ್ಯುನೆ ಹಟಮಾರಿ ರ‍್ಹಯಲಕ್ಹು ತುನೆಬಿ ಮಿ ಹಟಮಾರಿ ಕರ‍್ಯೊಸ. <verse eid="EZK 3:8" /><verse number="9" style="v" sid="EZK 3:9" />ತಾರು ಮನಸ ದಗ್ಡಾತಿಬಿ ಘಟ್ಟ ವರಿ ಹಿರಾ ಅಕ್ಲು ಘಟ್ಟ ಕರ‍್ಯೊಸ; ತ್ಯುನೆ ದಂಗೊ ಕರಾಲಾ ವ್ಹೈ ತ್ಯುನೊನೆ ಬುಚ್ಕು ನಕೊ; ಡೊಳಾ ಕಾಡಿನ ದೆಕ್ಯಾತಬಿ ಭುಚ್ಕು಼ ನಕೊ.<verse eid="EZK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 3:10" />ತೆ ನೈಸೊ ತೆ ಮನೆ ಅಮ್ಮ ಕದ್ಯೊ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಮಿ ತುನೆ ಕವಾನಾ ವಾತೊನೆ ಕಾನೆ ಐಕಿನ ಮನಸ್ಸಮಾ ಮ್ಹೆಲ್ಲೆ. <verse eid="EZK 3:10" /><verse number="11" style="v" sid="EZK 3:11" />ಬಂದಿ ಥಯಲ ತಾರಾ ಸ್ವಂತ ಮನಕ್ಹೊಕನ ಗೈನ ತ್ಯುನೆ ಐಕಾದೆ ಯಾ ನೈ ಐಕಾದೆ ತ್ಯುನೊನೆ ಕೈನ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಕೈನ ತ್ಯುನೊನೆ ಕೆ.<verse eid="EZK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 3:12" />ತೆಳಾಮಾ ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಮನೆ ಉಚೈಲಿನ ಗಯಲ್ಪರ ಮಹಿಮಾಕ್ಹು ಭರಲ ಯಹೊವಾನೆ ತಿನಾ ರ‍್ಹವಾನಾ ಜ಼ಗಾಮಾ ಸ್ತೊತ್ರಾ ಥಾವಾದೆ ಕೈನ ಜೊ಼ರ ಅವಾಜ಼ ಮಾರಾ ಪಾಚು ಐಕೊ ಆಯು. <verse eid="EZK 3:12" /><verse number="13" style="v" sid="EZK 3:13" />ಜಿವಿಯೊನಾ ರೆಕ್ಯಾ ಯಕ್ಕನೆ ಯಕ್ಕ ಲಾಗಾನಿ ಅವಾಜ ತ್ಯುನಾ ಬಾಜು಼ಮಾ ಗೊಲ ಗೊಲ ಫರಾನಿಯೊ ಗಾಲಿಯೊನಾ ಅವಾಜ಼ ಅಮ್ಮ ಗಿರ ಕವಾನಿ ಜೊ಼ರ ಬೊಕಂಪ ನಿಂಗತ ಅವಾಜ ಮಾರಾ ಕಾನೆ ಪಡಿ. <verse eid="EZK 3:13" /><verse number="14" style="v" sid="EZK 3:14" />ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಮನೆ ಉಚೈಲಿನ ದುರ ಗೈ. ಚಿಂತಾ ಕರ್ತೊ ವೈಥೈ ಪಡತೊ ಮನಸ್ತಾಪ ಪಡ್ತೊ ಚಾಲ್ಯೊ ವರಿ ಯೊಹೊವಾನೊ ಹತ್ತ ಮಪರ ವ್ಹತೊ. <verse eid="EZK 3:14" /><verse number="15" style="v" sid="EZK 3:15" />ತೆಳಾಮ ಬಂದಿ ಥೈನ ಲಿಂಗೈನ ಕೆಬಾರ ನದಿನಾ ನಜಿಕ ತೆಲ ಆಬಿಬಿಮಾ ರ‍್ಹಯಲ ವಾಲಾವೊಕನ ಐನ ತ್ಯುನೆ ಬೈಟಲ ಜ಼ಗಾಕನ ಐನ ಬೈಟ್ಯೊ; ಕ್ಹಾತ ದಿನ ತ್ಯಾಜ ತ್ಯುನಾ ವಚ್ಮಾ಼ಜ಼ ಸ್ತಬ್ದ ಥೈನ ರ‍್ಹೈ ಪಡ್ಯೊ.<verse eid="EZK 3:15" /></para>
  <para style="s">ಕರ್ತಾ ಹೆಜಿಕೆಲನೆ ಕೈದಾಲೊ ಕೈನ ನೆಮ್ಸಲ</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 3:16" />ಕ್ಹಾತ ದಿನ ಥಯಲ್ಪರ ಯಹೊವಾ ಆ ವಾತ ಮನೆ ಕದ್ಯೊ. <verse eid="EZK 3:16" /><verse number="17" style="v" sid="EZK 3:17" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಮಿ ತುನೆ ಇಸ್ರಾಯಲೊನಾ ವಂಶನಾ ಉಪ್ಪರ ಕಾಯ್ದಾಲೊ ವ್ಹೈ ಕೈನ ನೆಮಸ್ಯೊಸ. ಇಮ್ಮ ಮಾರಾ ಮ್ಹೊಡಾಕ್ಹು ನಿಕ್ಹಳಾನಾ ವಾತನೆ ಐಕಿನ ಮಾರಾಹುತಿ ತ್ಯುನೊನೆ ಎಚ್ಚರ ಕರ. <verse eid="EZK 3:17" /><verse number="18" style="v" sid="EZK 3:18" />ಮಿ ದುಷ್ಟನೆ ‘ಕ್ಹರಿಮಾಜ಼ ಮರಸಿ ಕೈನ ಕತಾಮಾ ತು ತ್ಯುನೆ ಹುಶಾರ ಕರಾನು ತೆ ತಿನಾ ಕೆಟ್ಟ ವಾಟ ಛೊಡಿನ ತಿನಾ ಜಿಂದಗಿ ವಚಡಲ್ಯು ಕೈನ ತಿನೆ ಗ್ಯಾನ ಕದ್ಯಾವಾಚಿ ರ‍್ಹಯೊಮ ತೆ ದುಷ್ಟ ತಿನಾ ಪಾಪಕ್ಹು ಮರಾಲೊ ವ್ಹೈ; ತಿನಾ ಮರಣನೆ ತುಜ಼ ಕಾರಣ ಥಾಸಿ. <verse eid="EZK 3:18" /><verse number="19" style="v" sid="EZK 3:19" />ತು ದುಷ್ಟನೆ ಹುಶಾರ ಕರ‍್ಯಾಮ ತೆ ತಿನಾ ದುಷ್ಟತನನಾ ಕೆಟ್ಟ ವಾಟನೆ ನೈ ಛೊಡ್ಯೊಮ ತಿನಾ ಅಪರಾಧಕ್ಹು ಮರಸ; ತು ತಾರಿ ಜಿಂದಗಿ ವಚಾ಼ಡಲೆಸಿ. <verse eid="EZK 3:19" /><verse number="20" style="v" sid="EZK 3:20" />ತೆ ನೈಸೊ ನಿತಿವಂತವಾಲೊ ತಿನಿ ನಿತಿನೆ ಛೊಡಿನ ಅನಿತಿ ಕರಿನ ಮಿ ತಿನಾ ಕ್ಹಾಮೊ ಒಡ್ಡಲ ಆಟಂಕನೆ ಪಾಡ್ಯೊಮ ತೆ ಕ್ಹರಿಜ಼ ಮರಿಜಾ಼ವಸ; ತು ತಿನೆ ಹುಶಾರ ಕರಿನ ಗೈಯಲಕ್ಹು ತೆ ತಿನಾ ಪಾಪಕ್ಹು ಮರುಲಾಗ್ಯೂ. ತೆ ಕರಲ ಚೊ಼ಕಾ ಕಾಮೊ ಲೆಕ್ಕಾನೆ ನೈ ಆತು; ತಿನಾ ಮರಣಕ್ಹು ತುನೆ ಮುಯ್ಯಿ ತಿರಸುಸ. <verse eid="EZK 3:20" /><verse number="21" style="v" sid="EZK 3:21" />ತು ಶಿಷ್ಟನೆ ಪಾಪ ಕರಲ ನಿಂಗತಜ಼ ಹುಶಾರ ಥಯಲ್ಪರ ತೆ ಪಾಪ ಕರ‍್ಯಾವಾಚಿ ಗಯಾಮ ಹುಶಾರ ಥಯಲ ಕಾರಣ ಜಿವಕ್ಹು ಉಗ್ರಸ; ತು ತಾರಾ ಜಲಮ ವಚಾ಼ಡೆಲಸಿ.<verse eid="EZK 3:21" /></para>
  <para style="s">ಯೆಜಿಕೆಲನೆ ಬೊಲು ನೈಸೊ ಥಾವಾನು</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 3:22" />ತೆ ಜ಼ಗಾಪರ ಮಿ ಯಹೊವಾನಾ ಹಸ್ತನಾ ಸ್ಪರ್ಶಕ್ಹು ತೆ ಮನೆ ತು ಉಟಿನ ಖಾಲಿ ಜ಼ಗಾ ಜಾ಼, ತ್ಯಾ ಮಿ ತಾರಾಕ್ಹಾತೆ ಬೊಲುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="EZK 3:22" /><verse number="23" style="v" sid="EZK 3:23" />ತೆಳಾಮ ಮಿ ಉಟಿನ ಖಾಲಿ ರ‍್ಹಯಲ ಜ಼ಗಾಪರ ಗಯಲ್ಪರ ಕೆಬಾರ ನದಿನಾ ನಜಿಕ ಮನೆ ಮಹಿಮಾ ಅದ್ಬುತ ದರ್ಶನ ಥಯಲ ನಿಂಗತ ಆಹಾ, ತ್ಯಾ ಯಹೊವಾನೆ ಮಹಿಮಾ ಪ್ರತ್ಯೆಕ ಥಯು. ತೆ ದೆಕಿನ ಡಬ್ಬ ಪಡ್ಯೊ. <verse eid="EZK 3:23" /><verse number="24" style="v" sid="EZK 3:24" />ತೆಳಾಮಾ ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಮಾರಾಮಾ ಐನ ಮಿ ಉಟಿನ ಹುಬ್ರಯಲ ನಿಂಗತ ಕರಲ್ಪರ ತೆ ಮನೆ ಅಮ್ಮ ಕದ್ಯೊ ತು ಗೈನ ತಾರಾ ಘರಮಾ ದಡೈಲೆ. <verse eid="EZK 3:24" /><verse number="25" style="v" sid="EZK 3:25" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ ಹಮ್ನಾ ತಾರಾ ಮನಕ್ಹೊಜ಼ ತುನೆ ಭಾಂದಿನ ಘಾಲಸ, ತು ಹೈತಿ ಫರತೊ ನೈ. <verse eid="EZK 3:25" /><verse number="26" style="v" sid="EZK 3:26" />ತೆ ನೈಸೊ ತಾರಿ ಜಿಬ್ಬಬಿ ಸೆದಿನ ಗೈನ ತು ಮೂಕ ಥಯಲ ನಿಂಗತ ಕರುಸ; ತು ತ್ಯುನೊನೆ ದೆಕಲ ರಶಿ ತ್ಯುನೆ ದಂಗೊ ಕರಾಲಾ ವಂಶವಾಲಾ ವ್ಹೈ. <verse eid="EZK 3:26" /><verse number="27" style="v" sid="EZK 3:27" />ಮಿ ತಾರಾ ಕ್ಹಾತೆ ವರಿ ಬೊಲಾಲಾನಾ ಕಾಲಮಾ ತಾರು ಮ್ಹೊಡು ಕ್ಹೊಲುಸ; ತು ತೆಳಾಮ ತ್ಯುನೊನೆ ಕರ್ತಾಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಕೈನ ಕೌ; ಐಕಾಲೊ ಐಕಾದೆ. ನೈಐಕಾಲೊ ಛೊಡಾದೆ; ಕಾ ಕದ್ಯಾಮ ಫರಿ ಪಡಾಲಾ ಮನಕ್ಹೊ ವ್ಹೈ.<verse eid="EZK 3:27" /></para>
  <chapter eid="EZK 3" />
  <chapter number="4" style="c" sid="EZK 4" />
  <para style="s">ಯೆಜಿಕೆಲ ಯರುಸೆಲಿಮನೆ ವಶಮಾ ಕರಲಿವಾನಿಂಗತ ಕರಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 4:1" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಯಕ್ಕ ಇಟಂಗಿ ಲಿನ ತಾರಾ ಕ್ಹಾಮೊ ಮ್ಹೆಲಿನ ತಿಮಾ ಯೆರುಸೆಲಿಮನೊ ನಕ್ಷೊ ಕಾಡ <verse eid="EZK 4:1" /><verse number="2" style="v" sid="EZK 4:2" />ನಕ್ಷಾನಾ ಸುತ್ತೆಬಿ ದಿಬ್ಬ ಘಾಲಿನ ಒಡ್ಡು ಭಾಂದಿನ ಪಾಳೆಯನೆ ಕರಿನ ಕತ್ರಾನಿಯೊ ಮಿಶಿನೊ ಹುಬ್ರಾಡಿನ ತಿನೆ ಮುತ್ತು. <verse eid="EZK 4:2" /><verse number="3" style="v" sid="EZK 4:3" />ತೆ ಥಯಲ್ಪರ ಲ್ಹೊಡಾನಾ ತಗಡೊ ಲಿನ ತೆ ತುನೆಬಿ ತೆ ಗಾಮನೆಬಿ ವಚ್ಮಾ ಲ್ಹೊಡಾನಿ ಗೊಡಿ ನಿಂಗತ ಹುಬ್ರಾಡಿನ ತೆ ಗಾಮ್ನಾ ಉಪ್ಪರ ಡೊಳೊ ಮ್ಹೆಲ; ತು ತಿನೆ ಮುತ್ತಿಗೆ ನಿಂಗತ ಥವಾನು ಆ ಇಸ್ರಾಯಲ ವಂಶವಾಲಾವೊನೆ ವಳಕ ವ್ಹೈ. <verse eid="EZK 4:3" /><verse number="4" style="v" sid="EZK 4:4" />ತೆ ನೈಸೊ ತು ತಾರಾ ರೊಡ್ಡಾ ಬಗಲ ಕ್ಹುರೆ, ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ ಪಾಪನು ವಜ್ಜು ತಿನಾ ಉಪ್ಪರ ಪಡ್ಯುಸ ತು ಕೆಕಲಾ ದಿನ್ನ ಅಮ್ಮ ಕ್ಹುರೆಸಿ ದೆಕ ತೆಕ್ಲಾ ದಿನ ತ್ಯುನು ಪಾಪನು ಉಚೈಲಿನ ರ‍್ಹೌ. <verse eid="EZK 4:4" /><verse number="5" style="v" sid="EZK 4:5" />ತ್ಯುನೆ ಕೆಕ್ಲಾ ವರಕ್ಹ ತಿನಾ ಅಧರ್ಮನು ಫಲ ಅನಭವ ಕರು ತೆಕ್ಲಾ ದಿನ್ನ ಕದ್ಯಾಮ ತನಕ್ಹೊನ ನೌವದ ದಿನ್ನ ತು ಕ್ಹುರೆಲ ರ‍್ಹೌ ಕೈನ ತುನೆ ನೆಮಸ್ಯೊಸ; ತೆಕ್ಲಾ ದಿನ್ನ ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ ಪಾಪನು ವಜ್ಜು಼ ತು ಉಚೈಲಿದಲ ರ‍್ಹೌ. <verse eid="EZK 4:5" /><verse number="6" style="v" sid="EZK 4:6" />ತೆಕ್ಲಾ ದಿನ್ನ ಥಯಲ್ಪರ ಸಿದಾ ಬಗಲ ಕ್ಹುರೈನ ಯೆಹುದ ವಂಶವಾಲಾವೊನು ಪಾಪನೆ ಉಚೈಲ್ಯು; ವರಕ್ಹನಾ ಯಕ್ಕನಾ ಯಕ್ಕ ದಿನ್ನೆ ಚಾಳಕ್ಹ ದಿನ್ನ ತ್ಯುನು ಅಧರ್ಮನೆ ಉಚೈಲ್ಯು ಕೈನ ತುನೆ ಗೊತ್ತ ಕರ‍್ಯೊಸ.<verse eid="EZK 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 4:7" />ತಾರಾ ಭಾಂವಾನೆ ವಚ್ಚಾ಼ನಾ ನೈಸೊ ಮುತ್ತಿಗೆ ಥಯಲ ಯೆರುಸಲೆಮಕನ ಮೊರೆ ಫರೈನ ತಿನಾ ವಿಷಯಮಾ ವಿರುದ್ದ ಪ್ರಕಟ ಕರ.<verse eid="EZK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 4:8" />ದೆಕ ಹಮ್ನಾ ತಾರಾ ಮುತ್ತಿನಾ ದಿನೊ ಗಯೆಲಕ್ಕಾ ತು ಸಿದಾ ಬಗಲತೊ ರೊಡ್ಡಾಬಗಲನೆ ಫರೆವಾಚಿ ತುನೆ ಬಂದ ಕರುಸ. <verse eid="EZK 4:8" /><verse number="9" style="v" sid="EZK 4:9" />ತೆ ನೈಸೊ ಗೌಂ, ಜವೆ ಗೌಂ, ಅವರಿ ಕಾಳ, ಅಲಸಂದಾ, ಸಾವೆ, ಹರಬುರಾ , ತೆ ಕ್ಹಾರು ಲಿನ ಯಕ್ಕ ತಪಾಲಾಮಾ ಘಾಲಿನ ತಿನಾಕ್ಹು ರೊಕ್ಲಾ ಕರಲೆ; ಬಾಜು಼ಮಾ ಕ್ಹುರೆಲ ದಿನ್ನ ಲಕ್ಕಾ, ಕದ್ಯಾಮ ತನಕ್ಹೊನ ನೌವದ ದಿನ್ನ ತಿನೆ ಕ್ಹಾ. <verse eid="EZK 4:9" /><verse number="10" style="v" sid="EZK 4:10" />ತಾರಾ ಅನ್ನನೆ ತೊಲನಾ ನಿಂಗತ ಹರ ದಿನ್ನೆ 230 ಗ್ರಾಂ ನಿಂಗತ ಕ್ಹಾ; ತೆಳಾಮ ತೆಳಾಮ ದಕ್ಹು ದಕ್ಹು ಕ್ಹೌ. <verse eid="EZK 4:10" /><verse number="11" style="v" sid="EZK 4:11" />ವರಿ ಪಾನಿನೆ ಅಳತಿನಾ ಪ್ರಕಾರ ಹರದಿನ್ನೆ ಯಕ್ಕ ತಾಂಬಿಯೊ ಪಾನಿ ತೆಳಾಮ ತೆಳಾಮ ದಕ್ಹು ದಕ್ಹು ಪ್ಯೂ. <verse eid="EZK 4:11" /><verse number="12" style="v" sid="EZK 4:12" />ತು ಸೌದೆನಾ ಬದಲ ಮನಕ್ಹನು ಛಾನ ಉಪಯೊಗ ಕರಿನ ತಾರಾ ಮನಕ್ಹನಾ ಡೊಳಾನಾ ಕ್ಹಾಮೊ ತೆ ಲೊಟನೆ ರೊಕ್ಲಾ ಕರಿನ ಜವ ಗೌಂನಾ ರೊಕ್ಲಾನಿಂಗತ ಕ್ಹಾ. <verse eid="EZK 4:12" /><verse number="13" style="v" sid="EZK 4:13" />ತಿಮ್ಮಜ಼ ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ ಮಾರಾಕ್ಹು ಬಿಜಾ಼ ಗಾಮೊನೆ ನ್ಹಟಾಡಾನು ಪಟ್ಟಿನ ತೆ ದೆಶವಾಲಾವೊನಾ ವಚ್ಮಾ ರ‍್ಹತಾ ತ್ಯುನಾ ಅನ್ನನೆ ಹೊಲಸ ಕರಿನ ಕ್ಹಾವಸ; ಆ ಯಹೊವಾನಿ ವಾತ. <verse eid="EZK 4:13" /><verse number="14" style="v" sid="EZK 4:14" />ತಿನಾಹುತಿ ಮಿ ನಕೊ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ, ಮಿ ಹೊಲಸ ಮುಟ್ಟಲವಾಲೊ ನ್ಹವೈ, ಮಿ ನ್ಹಾನಪಂತೊಬಿ ಹಮ್ನಾ ಲಕ್ಕಾ ಮರಲ ಪಶುನು ಮಾಕ್ಹ ಥೈತಬಿ ಕಾಡ ಮೃಗೊ ಖಲಾಸ ಕರಲ ಪಶುನೂ ಮಾಕ್ಹ ಥೈತಬಿ ಕ್ಹಾದಲವಾಲೊ ನ್ಹವೈ; ಕಯುಬಿ ಅಶುದ್ದ ಥಯಲ ಪದಾರ್ಥ ಮಾರಾ ಮ್ಹೊಡಾಮಾ ಸೆರ್xಯು ನತ್ತಿ ಕೈನ ಕೈಲಿದ್ಯೊ, <verse eid="EZK 4:14" /><verse number="15" style="v" sid="EZK 4:15" />ದೆಕ, ಮನಕ್ಹನಾ ಛಾನ ಬದಲ ಬೈಲೊನಾ ಛಾನನೆ ತುನೆ ಗೊತ್ತ ಕರ‍್ಯೊಸ,ಅನೆ ಉಪಯೊಗ ಕರಿನ ತಾರಾ ರೊಕ್ಲಾನೆ ಬಾಳ್ಳೆ ಕೈನ ಉತ್ತರ ದಿದ್ಯೊ. <verse eid="EZK 4:15" /><verse number="16" style="v" sid="EZK 4:16" />ತೆ ನೈಸೊ ತೆ ಮನೆ ಅಮ್ಮ ಕದ್ಯೊ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಮಿ ಯೆರುಸಲೆಮಾ ಅನಾಜ ಆವಾನು ಹುಬ್ರಾಡುಸ. ನಿವಾಸಿಯೊ ಅನ್ನನೆ ತೊಲ ನಿಂಗತ ಬೆದರಕ್ಹು ಕ್ಹಾವಸ, ಪಾನಿನೆ ಅಳತಿನಾ ನಿಂಗತ ಭುಚ಼ಕತಾ ಪಿವಸ; <verse eid="EZK 4:16" /><verse number="17" style="v" sid="EZK 4:17" />ತ್ಯುನಾಮಾ ಹರಯಕ್ಲೊ ಅನ್ನ ಪಾನಿನಾ ಕೊರತೆ ಪಟ್ಟಿನ ಸ್ತಬ್ದ ಥೈನ ತ್ಯುನಾ ತ್ಯುನಾ ಪಾಪಕ್ಹು ನಾಶ ಥೈನ ಜಾ಼ವಸ.<verse eid="EZK 4:17" /></para>
  <chapter eid="EZK 4" />
  <chapter number="5" style="c" sid="EZK 5" />
  <para style="s">ಯೆಜಿಕೆಲ ತಿನಾ ಬಾಲೊ ಕತ್ರಿಲಿವಸ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 5:1" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಹದ ಥಯಲ ತಲ್ವಾರ ಕಡಿಲಿನ ಕ್ಷೌರಕನಿ ವಸ್ತರ ನಿಂಗತ ಉಪಯೊಗ ಕರ ತಾರು ಮಾತು ವರಿ ತಾರಿ ದಾಡಿಬಿ ಕಡೈಲಿನ ತಕ್ಡಿ ಲೈನ ತಿಕ್ಹ್ಯು ತೆ ಬಾಲೊನೆ ಕರೆಟ್ಟ ತನ್ನ ಭಾಗ ಕರ. <verse eid="EZK 5:1" /><verse number="2" style="v" sid="EZK 5:2" />ಮುತ್ತಿನಾ ದಿನೊ ಥಯಲ್ಪರ ಬಾಲೊನು ಯಕ್ಕ ಭಾಗ ಗಾಮ್ನಾ ವಚ್ಮಾ ಆಗಮಾ ಬಾಳ; ಹಜಿಯಕ್ಕ ಭಾಗ ಲಿನ ಗಾಮ್ನಾ ಸುತ್ತೆಬಿ ತಲ್ವಾರಕ್ಹು ಕತರ; ವರಿಯಕ್ಕ ಭಾಗನೆ ಹವಾಮಾ ತುರ ತಿಮ್ಮಜ಼ ಮಿ ಮಾರಾ ಮನಕ್ಹೊನಾ ಪಾಚೊ ತಲ್ವಾರ ಭಿರಕೌಸ. <verse eid="EZK 5:2" /><verse number="3" style="v" sid="EZK 5:3" />ತೆಳಾಮಾ ಲಾಸ್ಟನಾ ಭಾಗಮಾ ಉಗ್ರಾಳಿದಲ ದಕ್ಹಾ ಬಾಲೊನೆ ಉಪ್ಪರಲ್ಯಾ ಅಂಗ್ಡಾನಾ ತುದಿನೆ ಭಾಂದ; <verse eid="EZK 5:3" /><verse number="4" style="v" sid="EZK 5:4" />ತೆ ಥಯಲ್ಪರ ಅಮಾ ದಕ್ಹಾ ಇನಿಲಿನ ಆಗಮಾ ಘಾಲಿನ ಬಾಳ; ತಿಕ್ಹು ಆಗಬಿ ಗೈನ ಇಸ್ರಾಯಲ ವಂಶವಾಲಾವೊನೆ ಫೈಲಾದೆ.<verse eid="EZK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 5:5" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಆ ಯೆರುಸಲೆಮ; ತೆ ತೆ ದೆಶೊನಾ ವಚ್ಮಾ ಸ್ಥಾಪಿತ ಕರ‍್ಯೊಸ, ತಿನಾ ಸುತ್ತೆಬಿ ಬಿಜಾ಼ ಬಿಜಾ಼ ದೆಶೊ ಛೆ. <verse eid="EZK 5:5" /><verse number="6" style="v" sid="EZK 5:6" />ತೆ ಮಾರಾ ನಿಯಮ ನಿಷ್ಟೆನೆ ಮ್ಹೈ ಆಯೆವಾಚಿ ಜನಾಂಗೊತಾಬಿ ಸುತ್ತೆ ರ‍್ಹಯಲ ದೆಶವಾಲಾತಿಬಿ ಹೆಚ್ಚ ಅಧರ್ಮನೆ ಚಾಲಾಯೊ; ತಿನಾ ಮನಕ್ಹೊ ಮಾರಾ ನಿಯಮೊನೆ ಅನುಭವ ನೈ ಕರೆವಾಚಿ ಮಾರಾ ವಿಧಿಯೊನೆ ಠುಕರಾಯಾಸ. <verse eid="EZK 5:6" /><verse number="7" style="v" sid="EZK 5:7" />ಅಮ್ಮ ರ‍್ಹತಾಮಾ ಕರ್ತಾಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತುಮೆ ಮಾರಾ ನಿಯಮೊ ನೈ ಅನು ಸರಶ್ಯಾಮ ಮಾರಾ ವಿಧಿಯೊನೆ ಪಾಲೆಸೆವಾಚಿ ತಾರಾ ಸುತ್ತ ರ‍್ಹಯಲಬಿ ಜನಾಂಗನಾ ಧರ್ಮ ವಿಧಯೊನೆ ಕರೆವಾಚಿ ತೆ ಜನಾಂಗತಿಬಿ ಹೆಚ್ಕಿ ದಂಗೊ ಕರಾಲಾ ಥಯಾಸ. <verse eid="EZK 5:7" /><verse number="8" style="v" sid="EZK 5:8" />ಹಮ್ನಾ ಮಿಜ ತ್ಯುನೆ ವಿರುದ್ದ ಥಯೊಸ, ಜನಾಂಗನಾ ಡೊಳಾನಾ ಕ್ಹಾಮೊ ತಾರಾ ಮನಕ್ಹೊನೆ ದಂಡ ದ್ಯುಸ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ. <verse eid="EZK 5:8" /><verse number="9" style="v" sid="EZK 5:9" />ತು ಘನ್ನು ಅಸಯಿ ಕಾಮೊ ಕರಲಕ್ಹು ಮಿ ಹಮ್ನಾ ಲಕ್ಕಾ ಹಜಿ ಕ್ಹಾಮುಬಿ ಅಗೊಬಿ ಕರೆವಾಚಿ ದಂಡ ಹಮ್ನಾ ತುನೆ ಕರಸ. <verse eid="EZK 5:9" /><verse number="10" style="v" sid="EZK 5:10" />ಅಮ್ಮ ರೈತಬಿ ತಾರಾಮಾ ಬಾವೊನೆಬಿ ಪಟ್ಟಾವೊನೆಬಿ, ಬಾವೊನೆ ಕ್ಹಾವಸ; ಮಿ ತುನೆ ದಂಡ ದಿನ ತಾರಾಮಾ ಉಗ್ರಲಬಿ ಸಮಸ್ತೊನೆ ಕ್ಹಾರಿ ಬಗಲನಾ ವಾರಾನೆ ತುರುಸ.<verse eid="EZK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 5:11" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮರಾ ಜಿವದಾಣಾ, ತು ತಾರಾ ಹೆರಳ ಥಯಲ ಹೆಯ ವಿಗ್ರಹಕ್ಹು ಅಸಯ್ಯ ಸಾಮಾನೊಕ್ಹು ಮಾರು ಪವಿತ್ರ ಆಲಯನೆ ಹೊಲಸ ಕರಲಕ್ಹು ಗಟ್ಟ ಥೈನ ಮಿ ಸಹಶ್ಯೊ ನೈ, ಮಾಫ ಕರ‍್ತೊ ನೈ. ಕ್ಹರಿಮಾಜ಼ ಮಾಫ ಕರ್ತೊ ನೈ. <verse eid="EZK 5:11" /><verse number="12" style="v" sid="EZK 5:12" />ತಾರಾಮಾನು ತನವಾಮಾನು ಯಕ್ಕ ಭಾಗವಾಲಾ ಪಿಡಾಕ್ಹು ಮರಸ, ತಾರಾ ವಚ್ಮಾ ರೊಗಕ್ಹು ನಾಶ ಥಾವಸ; ಹಜಿಯಕ್ಕ ಭಾಗವಾಲಾ ತಾರಾ ಸುತ್ತೆಬಿ ತಲ್ವಾರಕ್ಹು ಹತ ಥಾವಸ; ವರಿಯಕ್ಕ ಭಾಗವಾಲಾವೊನೆ ಮಿ ಕ್ಹಾರಿಜ಼ಗಾ ವಾರಾಮಾ ತುರಿನ ತ್ಯುನಾ ಪಾಚು ತಲ್ವಾರ ಭಿರಕೌಸ. <verse eid="EZK 5:12" /><verse number="13" style="v" sid="EZK 5:13" />ತಿಮ್ಮಜ಼ ಮಾರಿ ಸಿಟ್ಟಬಿ ಕಾಡಿಲ್ಯುಸ, ಮಾರು ಕ್ರೊಧ ತ್ಯುನಾಪರ ರಿಚೈನ ಶಾಂತ ಥಾವಸ; ಆಗ್ರಹಕ್ಹು ಬೊಲಲವಾಲೊ ಯಹೊವಾ ಥಯಲ ಮಿಜ ವ್ಹೈ ಕವಾನು ಮಾರಿ ಸಿಟ್ಟನೆ ತ್ಯುನಾ ಉಪ್ಪರ ಲೈನ ಛೊಡಲ ಪರ ತ್ಯುನೊನೆ ಗೊತ್ತ ಥಾವಸ. <verse eid="EZK 5:13" /><verse number="14" style="v" sid="EZK 5:14" />ಹಾದಿನ ಜಾ಼ವಾಲಾಕ್ಹಾರಾ ಡೊಳಾನಾ ಕ್ಹಾಮಾ ಮಿ ತ್ಯುನೆ ಹಾಳ ಕರಿನ ಸುತ್ತ ರ‍್ಹಯಲಬಿ ಜನಾಂಗನಾ ನಿಂದೆನೆ ಗುರಿ ಕರುಸ. <verse eid="EZK 5:14" /><verse number="15" style="v" sid="EZK 5:15" />ಮಿ ಸಿಟ್ಟಕ್ಹು ರೊಶಕ್ಹು ಕಠಿನ ಥಯಲ ಖಂಡಕ್ಹುಬಿ ತ್ಯುನೆ ಕರಾನಾ ದಂಡೊ ಸುತ್ತೆ ರ‍್ಹಯಲ ಜನಾಂಗನಾ ದೊಷ ಪರಿಹಾಸನೆ ಬುದ್ದಿ ಥಯಲ ಅಸ್ಪದ ಥಾವಸ ಆ ಯಹೊವಾ ಥಯಲ ಮಾರಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 5:15" /><verse number="16" style="v" sid="EZK 5:16" />ತೆಳಾಮ ಮಿ ತ್ಯುನೆ ಹಾಳಕರಾನೆ ಬರಗಾಲ ಕವಾನಾ ನಾಶ ಕರಾನಾ ಥಯಲ ತಿಕ್ಷ್ಣ ಬಾಣೊನೆ ತಾರಾ ಉಪ್ಪರ ಛೊಡುಸ; ತ್ಯುನೆ ಬರಾಕ್ಹು ಘನ್ನು ಭಾದಿಸಿನ ; ತಾರೊ ರೊಕ್ಲು ಭಾಗಿ ಪಾಡುಸ. <verse eid="EZK 5:16" /><verse number="17" style="v" sid="EZK 5:17" />ಮಿ ವಳಾಯಲ ಕ್ಷಾಮಬಿ ದುಷ್ಟ ಮೃಗೊನಾ ಹತೆ ತ್ಯುನೆ ಬಚ್ಚಾ಼ವೊನೆ ಖಲಾಸ ಕರಸ; ವ್ಯಾದಿಬಿ ರಗತನು ಪ್ರವಾಹಬಿ ತಾರಾಮಾ ವಾಪಸ ದ್ಯುಸ; ತಾರಾ ತಲ್ವಾರನೆ ದ್ಯುಸ. ಎ ಕ್ಹುದಾನಿ ವಾತ ವ್ಹೈ<verse eid="EZK 5:17" /></para>
  <chapter eid="EZK 5" />
  <chapter number="6" style="c" sid="EZK 6" />
  <para style="s">ಮೊರ್ತಿಯೊನೆ ಪುಜಾ ಕರಾನಾ ವಿರುಧ್ದ ಕ್ಹುದಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 6:1" />ಯಹೊವಾ ಆ ವಾತ ಮನೆ ದಯಪಾಲಸ್ಯೊ <verse eid="EZK 6:1" /><verse number="2" style="v" sid="EZK 6:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಇಸ್ರಾಯಲನಾ ಡೊಂಗರೊನೆ ಅಬಿ ಮುಖಥೈನ ಹುಬ್ರೈನ ತ್ಯುನೊನೆ ದೈವೊಕ್ತಿನೆ ಕೆ ಇಸ್ರಾಯಲನಾ ಡೊಂಗರೊನಾ ವಿರುದ್ದ ಪ್ರವಾಧನೆ ಕರ. <verse eid="EZK 6:2" /><verse number="3" style="v" sid="EZK 6:3" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ಆ ವಾತ ಐಕೊ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಡೊಂಗರೊನೆ ತೊರೆ ಕ್ಹಾಡಿಯೊನೆ ಅಮ್ಮ ಕವಸ ಹಮ್ನಾ ಮಿಜ ತುಮಾರಾ ಉಪ್ಪರ ತಲ್ವಾರನೆ ಆವಾ ಲಗಾಡಿನ ಉನ್ನಥ ಸ್ಥಾನನೆ ನಾಶ ಕರುಸ. <verse eid="EZK 6:3" /><verse number="4" style="v" sid="EZK 6:4" />ತುಮಾರಾ ಯಜ್ಙವೆದಿಯೊ ಹಾಳ ಥಾವಸ, ತುಮಾರಾ ಧುಪ ವೆದಿಯೊನೆ ಹಾಳ ಕರಸ. ತುಮಾರಾ ಮನಕ್ಹೊ ತುಮಾರಾ ಮೊರ್ತಿಯೊನಾ ಕ್ಹಾಮಾ ಹತಥೈನ ಪಡಾವರಕ್ಹು ಕರುಸ. <verse eid="EZK 6:4" /><verse number="5" style="v" sid="EZK 6:5" />ಮಿ ಇಸ್ರಾಯಲನಾ ಮುರ್ದಾವೊನೆ ತ್ಯುನಾ ಮೊರ್ತಿಯೊನಾ ಕ್ಹಾಮಾ ಘಾಲಿನ ತುಮಾರಾ ಬಲಿನೊ ಕಟ್ಟೊನಾ ಸುತ್ತೆಬಿ ತುಮಾರಾ ಹಡ್ಕಾವೊನೆ ನಾಕುಸ. <verse eid="EZK 6:5" /><verse number="6" style="v" sid="EZK 6:6" />ತುಮೆ ರ‍್ಹವಾನಾ ಕ್ಹಾರಾ ದೆಶೆಮಾ ರ‍್ಹಯಲ ಗಾಮೊ ಹಾಳ ಥಾವಾಕ್ಹು ಉನ್ನತ ಸ್ಥಾನ ಹಾಳಪಡಾಕ್ಹು ತುಮಾರಾ ಯಜ್ಞ ವೆದಿಯೊ ಹಾಳಥಾವಸ, ತುಮಾರಾ ಗೊಂಬಿಯೊ ಫೊಡಿನ ತೆ ನೈಸೊ ಥಾವಸ, ತುಮಾರಾ ಧುಪ ವೆದಿ ಕತ್ರೈಜಾ಼ವಸ, ತುಮೆ ಕರಲ ವಿಗ್ರಹವೊ ಅಳದಿನ ಜಾ಼ವಸ, <verse eid="EZK 6:6" /><verse number="7" style="v" sid="EZK 6:7" />ತುಮಾರಾವ ವಚ್ಮಾ ಪಡಸ; ತೆಳಾಮಾ ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 6:8" />ಮನಕ್ಹೊನಾ ಶೆಷನೆ ಉಗ್ರಾಡುಸ; ಕಿಮ್ಮ ಕದ್ಯಾಮ ತುಮೆ ಬಿಜಾ಼ ದೆಶೊನೆ ಚದ್ರೈನ ಜಾ಼ತಾಮಾ ತುಮಾರಾಮಾ ದಕ್ಹಾಜನಾ ತೆ ಜನಾಂಗನಾ ವಚ್ಮಾ ತಲ್ವಾರನೆ ತಪ್ಪಸೈ ಲಿವಸ. <verse eid="EZK 6:8" /><verse number="9" style="v" sid="EZK 6:9" />ತೆಳಾಮಾ ತಪ್ಪಸೈಲಿನ ಆಳೊನೆ ಲಿನ ಗಯಲ ಜನಾಂಗೊನಾ ವಚ್ಮಾ ರ‍್ಹವಾಲಾ ತುಮಾರಾ ಅನ್ಯ ದೆವತಾವೊನಾ ಮೊಹಕ್ಹು ಮನೆ ದೆಕಾಡಲ ತ್ಯುನಾ ಮನಸೊನೆ ತ್ಯುನಾ ಗೊಂಬಿಯೊನಾ ಉಪ್ಪರಲ್ಯಾ ಕಾಮಕ್ಹು ದೆವ ದ್ರೊಹ ಕರಲ ತುಮಾರಾ ಡೊಳಾವೊನೆ ಭಂಗಕರಲವಾಲೊ ಮಿಜ ವ್ಹೈ ಕೈನ ಮನೆ ಸೆ ಕರಲಿನ ತುಮೆ ಘನ್ನಾ ಅಸ್ಯಯ ಕಾಮೊ ಕರಿನ ಕೆಟ್ಟ ಕರ್‍ಯಾಸ ಕೈನ ತ್ಯುನಾಮಾ ತ್ಯುನೆಜ ಹೆಸಿ ಲಿವಸ. <verse eid="EZK 6:9" /><verse number="10" style="v" sid="EZK 6:10" />ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಗೊತ್ತ ಥಾವಸ; ಆ ಕೆಡನೆ ತ್ಯುನೊಎ ಕರುಸ ಕೈನ ಮಿ ಕದಲ ಸುಳ್ಳ ವಾತ ನವೈ.<verse eid="EZK 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 6:11" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತು ಚಪ್ಪಾಳ್ಯೊ ಮಾರಿನ ಜಿಮಿನ ಕವಾನಿ ಅಮ್ಮ ಕೆ ಹಾ, ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ ಅಸೈ ಥಯಲ ಕೆಟ್ಟ ಕಾಮೊಕ್ಹುಜ! ತಲ್ವಾರ ಕ್ಷಾಮವ್ಯಾದಿಕ್ಹು ಮರಿಜಾ಼ವಸ. <verse eid="EZK 6:11" /><verse number="12" style="v" sid="EZK 6:12" />ದುರ ರ‍್ಹಯಲವಾಲೊ ವ್ಯಾದಿಕ್ಹು ಮರಸ, ಕ್ಹಾಮೊ ರ‍್ಹಯಲವಾಲೊ ತಲ್ವಾರಕ್ಹು ಮರಸ, ತಪ್ಪಸಿ ಲಿನ ಉಗ್ರಲವಾಲೊ ಕ್ಷಾಮಕ್ಹು ಮರಸ; ಮಿ ತ್ಯುನಾಪರ ಮ್ಹೆಲಲ ರೊಷನೆ ತಿರಸಿ ಪಡುಸ. <verse eid="EZK 6:12" /><verse number="13" style="v" sid="EZK 6:13" />ತೆ ವಂಶವಾಲಾ ಉಚ್ಚಾಥಯಲ ಕ್ಹಾರಾ ಡೊಂಗರೊಪರ ಕ್ಹಾರಾ ಡೊಂಗರೊನಾ ತುದಿಯೊಪರ ಸೊಂಪಥಯಲ ಝಾಡೊನಾ ಹೆಟಾಬಿ ತ್ಯುನಾ ಸಮಸ್ತ ವಿಗ್ರಹೊನೆ ಚೊಕಿ ಬಾಸಾನು ಹೊಮ ಕರ‍್ಯಾ ಘಟ್ಟ ಥಯಲ ಕ್ಹಾರಾ ಎಲಾ ಝಾಡೊನಾ ಹೆಟಾಬಿ ಹತ ಥೈನ ತ್ಯುನಾ ಯಜ್ಞಯೊನಾ ಸುತ್ತೆಬಿ ತ್ಯುನಾ ಗೊಂಬಿಯೊನಾ ವಚ್ಮಾ ಪಡ್ತಾಮಾ ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ಗೊತ್ತ ಥಾವಸ. <verse eid="EZK 6:13" /><verse number="14" style="v" sid="EZK 6:14" />ಮಿ ತ್ಯುನಾ ಉಪ್ಪರ ಹತ್ತ ಉಚೈನ ತ್ಯುನೆ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ದೆಶೊನೆ ಜಂಗಲತು ದಿಬ್ಬಲಕ್ಕಾ ಹಾಳಪಾಳ ಕರುಸ; ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 6:14" /></para>
  <chapter eid="EZK 6" />
  <chapter number="7" style="c" sid="EZK 7" />
  <para style="s">ಇಸ್ರಾಯೆಲನು ನಾಶ ನಜಿಕ ಆಯು</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 7:1" />ತೆ ನೈಸೊ ಯಹೊವಾ ಆ ವಾತ ಮನೆ ಕದ್ಯೊಸ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, <verse eid="EZK 7:1" /><verse number="2" style="v" sid="EZK 7:2" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ದೆಶನೆ ಅಮ್ಮ ಕದ್ಯೊ ಭುಕಂಪ ಪುರ್ಣ ಭುಕಂಪಬಿ ದೆಶನಾ ಚಾರೆ ದಿಕ್ಕಮಾ ಸಂಭವ ಕರ‍್ಯೊ. <verse eid="EZK 7:2" /><verse number="3" style="v" sid="EZK 7:3" />ಹಮ್ನಾಜ ತುನೆ ಭುಕಂಪ ಐ ಪಡ್ಯುತು; ಮಿ ಮಾರಿ ಸಿಟ್ಟ ತುಮಾರಾ ಉಪ್ಪರ ಆವಾ ಲಗಾಡಿನ ತು ಚಾಲಲ ನಿಂಗತ ನ್ಯಾಯ ತಿರಿಸಿನ ತಾರಾ ಸಮಸ್ತ ಅಸ್ಯಯ ಕಾಮೊನಾ ಫಲ ತುನೆ ಕ್ಹಲೌಸ. <verse eid="EZK 7:3" /><verse number="4" style="v" sid="EZK 7:4" />ತುನೆ ಮರಗತೊ ನೈ; ತಾರಾ ದುಮಾರ್ಗನಾ ಫಲ ತುನೆ ಕ್ಹಲೌಸ; ತಾರಾ ಅಸ್ಯಯ ಕಾಮೊ ತಾರಾ ಅನುಭವನೆ ಆವಸ; ತೆಳಾಮಾ ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುನೆ ಗೊತ್ತ ಥಾವಸ. <verse eid="EZK 7:4" /><verse number="5" style="v" sid="EZK 7:5" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಆಹಾ, ಕೆಡ, ಕೆಳಾಮಬಿ ನೈ ದಿಕ್ಹಲ ಕೆಡ, ಹಮ್ನಾ ಆವಸ! <verse eid="EZK 7:5" /><verse number="6" style="v" sid="EZK 7:6" />ಅಂತ್ಯ ಐಯು, ಅಂತ್ಯ ಐಪಡ್ಯು, ತಾರು ಕ್ಹಾಜ಼ ಖಲಾಸ ಥಯು! <verse eid="EZK 7:6" /><verse number="7" style="v" sid="EZK 7:7" />ದೆಶನ ವಾಸಿಯೊ, ತಾರಿ ಗತಿ ಥಯು. ವಕ್ಹತ ಆಯೊ, ದಿನ ಕ್ಹಾಮೊ ವ್ಹತ್ತೊ; ಡೊಂಗರೊನಾ ಉಪ್ಪರ ಐಕಾನು ಅವಾಜ ಉತ್ಸಾಹ ಅವಾಜಕ್ಹಾರಿ, ಕಳಕಳ ವ್ಹೈ. <verse eid="EZK 7:7" /><verse number="8" style="v" sid="EZK 7:8" />ಹಜಿ ದಕ್ಹಾ ಟೈಮಾಜ ಮಿ ತಾರಾ ಉಪ್ಪರ ಮಾರಿ ರೊಷನೆ ರಿಚೈನ ಮಾರಿ ಸಿಟ್ಟ ತಿರಸಿಲಿನ ತಾರಾ ನಡತೆನೆ ತಕ್ಕ ದಂಡ ದಿನ ತಾರಾ ಅಸ್ಯಯ ಕಾಮೊನಾ ಫಲನೆ ತುನೆ ಕ್ಹಲೌಸ. <verse eid="EZK 7:8" /><verse number="9" style="v" sid="EZK 7:9" />ತುನೆ ಮರಗತೊಜ಼ ನೈ, ತಾರಾ ದುಮಾರ್ಗೊನಾ ತಕ್ಕ ಗತಿ ದ್ಯುಸ, ತಾರಾ ಅಸ್ಯಯ ಕಾಮೊ ತಾರಾ ಅನುಭವನೆ ಆವಸ; ಯಹೊವಾ ಥಯಲ ಮಿ ಶಿಕ್ಷಾ ದ್ಯುಸ ಕವಾನು ತ್ಯುನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 7:10" />ದೆಕ, ಶಿಕ್ಷ ದಿವಾನು ದಿನ್ನ, ಹಮ್ನಾ ಐಯು! ತುನೆ ದುರ್ಗತಿಬಿ ಐಸ, ಲಾಕಡಿ ಫುಲ್ಲೊ ಚೊಡಿಸ, ಹೆಮ್ಮನು ಚಿಗುರ ಛೆ. <verse eid="EZK 7:10" /><verse number="11" style="v" sid="EZK 7:11" />ಹಿಂಮ್ಸಾ ಬೆಳದಿ ಬೆಳದಿನ ಕೆಡುಕನಿ ಲಾಕಡಿ ಥೈನ ತುಮಾರಾಮಾನಾ ಕುನಬಿ ಉಗ್ರತು ನೈ, ತೆ ಮನಕ್ಹೊನಾ ಸಮುಹಮಾ ತ್ಯುನಾ ಆಸ್ತಿಯೊಮಾ ಶೆಷ ನೈ ರತು. ತ್ಯುನಾಮಾ ಕಯುಬಿ ಶ್ರೆಷ್ಠತೆಬಿ ನೈ ಹುಬ್ರೆತು. <verse eid="EZK 7:11" /><verse number="12" style="v" sid="EZK 7:12" />ಟೈಮ ಆಯೊ ದಿನ್ನ ಅಗೊ ಆಯೊ; ಇಕ್ಕಾತೊ ಲಿವಾಲೊ ಕ್ಹುಶಿ ಕರ‍್ಯಾವಾಚಿ ರ‍್ಹವಾದೆ, ಇಕ್ಕಾಲೊ ಸುಖಾಮಾ ರ‍್ಹವಾದೆ. ರೊಶ ತೆ ಸಮೂಹನಾ ಹರಯಕ್ಲಾಪರ ಚಡಿಸ. <verse eid="EZK 7:12" /><verse number="13" style="v" sid="EZK 7:13" />ಕಾ ಕದ್ಯಾಮ ಇಕ್ಕಲವಾಲೊ ಕೆಕ್ಲಾಬಿ ವರಕ್ಹ ಜ್ಯುತೊ ರೈತಬಿ ಇಕ್ಕಲ ಸೊತ್ತಬಿ ತಿನಾ ವಶನೆ ಫರು ನೈ; ಉಂಟ ಥಯಲ ದಿವ್ಯ ದರ್ಶನಬಿ ಸಮೂಹನಾ ಕ್ಹಾರಾವೊನೆ ಸಂಬಂದ ಛೆ, ಕುನಬಿ ಪಾಚಾ಼ ಜಾ಼ತಾನೈ,ಕುನ್ನಜ ತ್ಯುನಾ ಕೆಟ್ಟತನಾಕ್ಹು ತ್ಯುನು ಜಿನವಬಿ ವಚಾ಼ಳೆತಾ ನೈ; <verse eid="EZK 7:13" /><verse number="14" style="v" sid="EZK 7:14" />ತ್ಯುನೆ ಲಕಾಡಿನೆಬಿ ಸರ್ವನಾಶ ಕರ‍್ಯಾ ಕುನಬಿ ಯುದ್ದನೆ ಚಾಲ್ಯಾ ನ್ಹೊತಾ; ಮಾರಿ ರೊಷ ತೆ ಸಮೂಹನಾ ಹರಯಕ್ಲಾಪರ ಚಡಿಸ.<verse eid="EZK 7:14" /></para>
  <para style="s">ಇಸ್ರಾಯಲೊನಾ ಪಾಪನೆ ಶಿಕ್ಷಾ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 7:15" />ಗಾಮ್ನಾ ಭಾರು ತಲ್ವಾಕ್ಹು ಮರಸ. ಗಾಮ್ನಾ ಮ್ಹೈನಾ ವ್ಯಾದಿನಾ ಕ್ಷಾಮೊ; ವ್ಯಾದಿನಾ ಕ್ಷಾಮನೆ ಬೊಂದೊ ಥಾವಸ. <verse eid="EZK 7:15" /><verse number="16" style="v" sid="EZK 7:16" />ತ್ಯುನಾಮಾ ಪಲಾಯನ ಕರಲವಾಲಾ ಚುಕೈಲಿನ ತ್ಯುನಾ ಅರ್ಧಮಾಜ ರೈನ ಡೊಂಗರಮಾ ರ‍್ಹಯಲ ಕ್ಹಬುತರೊ ನಿಂಗತ ಡೊಂಗರೊಪರ ವರಿ ಖಣವಿಮಾ ರವಾ ಧವಾನು ಕರಸ. <verse eid="EZK 7:16" /><verse number="17" style="v" sid="EZK 7:17" />ಕ್ಹಾರೊವೊನಾ ಹತೊ ಜೊತ ಪಡಲ ರೈಸ ಕ್ಹಾರಾವೊನಾ ಗುಡ್ಗಾವೊ ಪಾನಿ ನಿಂಗತ ಹಲ್ತಾ ರ‍್ಹವಸ. <verse eid="EZK 7:17" /><verse number="18" style="v" sid="EZK 7:18" />ತ್ಯುನೆ ಕೊತ್ಳಾವೊನೆ ಸುತ್ತಿ ಲಿವಸ, ಭೆ ತ್ಯುನೊನೆ ಝಾಕಿ ಪಡಸ; ಕ್ಹಾರಾವೊನಾ ಮ್ಹೊಡಾವೊಪರ ಸರಮ ರ‍್ಹವಸ. ಕ್ಹಾರಾಜನಾ ಮಾತು ಕಡೈಲಿದಲ ರ‍್ಹವಸ. <verse eid="EZK 7:18" /><verse number="19" style="v" sid="EZK 7:19" />ತ್ಯುನೆ ತ್ಯುನಾ ರುಪ್ಪಾನೆ ರೊಡೊಪರ ಭಿಕಕಾವಸ, ತ್ಯುನು ಕ್ಹೊನು ಅಶುದ್ದ ಪದಾರ್ಥ ನಿಂಗತ ರ‍್ಹವಸ; ಯಹೊವಾ ತಿನಾ ರೊಷನೆ ತಿರಸಾನಾ ದಿನಮಾ ತ್ಯುನು ಕ್ಹೊನು ರುಪ್ಪುಬಿ ತ್ಯುನೊನೆ ವಚಾ಼ಡತು ನೈ ತ್ಯುನಾ ಇಷ್ಟಾ ಥಯಲ ನೈ ನೆರವೆರತು ತ್ಯುನು ಪೆಟಬಿ ನೈ ಭರತು; ಕಾ ಕದ್ಯಾಮ ತ್ಯುನಿ ಆಸ್ತಿಬಿ ತ್ಯುನೊನೆ ಪಾಪಮಾ ಜ಼ಲಾವಸ. <verse eid="EZK 7:19" /><verse number="20" style="v" sid="EZK 7:20" />ತ್ಯುನಾ ಆಭರಣೊನಾ ಚೊಕಾ ತ್ಯುನೊನೆ ಗರ್ವಸ್ಪದ ಥಯು; ತೆ ನೈಸೊ ಹೆಯಬಿ ಅಸ್ಯಯಬಿ ಥಯಲ ತ್ಯುನಾ ದೆವತೆನಾ ಪ್ರತಿಮೆನೆ ಕ್ಹೊನಾ ರುಪ್ಪಾಕ್ಹು ರಡಿ ಕರತಾತಾ;<verse eid="EZK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 7:21" />ತೆ ಥಯಲ್ಪರ ತಿನೆ ತ್ಯುನೊನೆ ಅಶುದ್ದ ಪದಾರ್ಥನೆ ಕರಿನ ಅನ್ಯನಾ ಹತೊಕ್ಹೊ ಕೊಳ್ಳೆ ಫೊಡಾಲಗಾಡಿನ ಲೊಕನಾ ಅತಿ ದುಷ್ಟಕ್ಹು ಹಾಳ ಕರಾಲಗಾಡುಸ; ತ್ಯುನೆ ತಿನೆ ಅಪವಿತ್ರ ಕರಸ. <verse eid="EZK 7:21" /><verse number="22" style="v" sid="EZK 7:22" />ಮಿ ತ್ಯುನೊ ಕಂತು ಮಾರು ಮ್ಹೊಡು ಒರೆ ಕರಾನೆ ಮಾರಾ ಪಸಂದ ಮಂದಿರನೆ ಅಪವಿತ್ರಕರಸ. ಚೊಟ್ಟಾ ತಿಮಾ ಹೊಕ್ಕಿನ ಹೊಲಸ ಕರಸ.<verse eid="EZK 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 7:23" />ಯಕ್ಕ ಸರಪಣಿ ಕರ! ಕಾ ಕದ್ಯಾಮ ದೆಶ ಮನಕ್ಹೊನೆ ಖಲಾಸ ಕರಾಲಾವೊಕ್ಹು ಭರಿಗಯುಸ, ಗಾಮಬಿ ಹಿಂಸಾಕ್ಹು ಭರಿಗಯುಸ. <verse eid="EZK 7:23" /><verse number="24" style="v" sid="EZK 7:24" />ಅಮ್ಮ ರ‍್ಹತಾಮಾ ಮಿ ಅತಿ ದುಷ್ಟ ಜನಾಂಗನೆ ಆವಾಲಗಾಡುಸ, ತ್ಯುನೆ ಮನಕ್ಹೊನೆ ಘರೊ ವಶ ಕರಲಿವಸ. ಮಿ ಬಲಿಷ್ಠಾನಾ ಸೊಕ್ಕನೆ ದಡೈಪಡುಸ, ತ್ಯುನಾ ಪವಿತ್ರ ಜ಼ಗಾವೊ ಹೊಲೆ ಗೆಡಸುಸ. <verse eid="EZK 7:24" /><verse number="25" style="v" sid="EZK 7:25" />ಸಂಕಟ ಆತಾಮಾ; ತ್ಯುನೆ ಸಮಾಧಾನೆ ಹುಡ್ಕಿತರಿ ದಕ್ಹುಬಿ ನೈ ಮಳತು. <verse eid="EZK 7:25" /><verse number="26" style="v" sid="EZK 7:26" />ಉಪ ತ್ರಾಸ್ಪರ ತ್ರಾಸ, ಸುದ್ದಿನಾ ಉಪ್ಪರ ಸುದ್ದಿ, ಆವಸ; ದಿವ್ಯ ದರ್ಶನ ಥಯು ಕೈನ ಪ್ರವಾದಿನಾ ಐಕೈತಾಜ ರ‍್ಹವಸ; ಯಾಜಕೊಮಾ ಧರ್ಮ ಉಪದೆಶ ನೈಸೊ ಥಾವಸ, ಮ್ಹೊಟಾವೊಮಾ ಸಲಹೆ ನೈಸೊ ಥಾವಸ. <verse eid="EZK 7:26" /><verse number="27" style="v" sid="EZK 7:27" />ರಾಜೊ಼ಬಿ ದುಖಮಾ ರ‍್ಹವಸ ರಾಜಾ಼ನೊ ದಿಕ್ರೊ ಬರೊಕ್ಹೊ ಛೊಡಿಪಾಡಸ; ಮನಕ್ಹೊನಾ ಲಕ್ವೊ ಮಾರಲನಿಂಗತ ಕಾಪಸ; ಮಿ ತ್ಯುನಾ ದುರ್ನಡತೆನೆನಾ ತಕ್ಕ ಶಿಕ್ಷಾ ದ್ಯುಸ ಕರಿನ ತ್ಯುನಾ ದುಷ್ಕರ್ಮನೆ ಕರೆಟ್ಟ ಶಿಕ್ಷಾ ದ್ಯುಸ; ತೆಳಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 7:27" /></para>
  <chapter eid="EZK 7" />
  <chapter number="8" style="c" sid="EZK 8" />
  <para style="s">ಹೆಜೆಕೆಲನೆ ಥಯಲ ಕ್ಹುದಾನು ಬೆವಾ ದರ್ಶನ</para>
  <para style="s">ಯೆರುಸೆಲಿಮನೆ ಮೊರ್ತಿಯೊನಿ ಪುಜಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 8:1" />ಯೆಹೊಯಾಖಿನ ಆಳಥೈನ ಛೆವಾ ವರಕ್ಹನಾ ಛೆವಾ ಮ್ಹೈನಾನಾ ಪಾಂಚ಼ವಾ ದಿನ್ನಮಾ ಮಿ ಯೆಹುದನಾ ಶಾನಾ ಮಾರಾ ಘರಮಾ ಯದರ ಬದರ ಥೈನ ಬೈಟತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಾ ಹತ್ತ ಮಪರ ಮ್ಹೆಲಲ ಹುತಿ ಮಿ ಮಹಿಮಾ ಕ್ಹು ಭರ‍್ಯೊ. <verse eid="EZK 8:1" /><verse number="2" style="v" sid="EZK 8:2" />ಹಮ್ನಾ, ಮಿ ದೆಕ್ತಾಮಾ ಆಗ ಲಾಗಲ ನಿಂಗತ ಮನೆ ಮನಕ್ಹ ನಿಂಗತ ತೆಜನೂ ರುಪ ದಿಕ್ಹ್ಯು; ಕಂಬರ ನಿಂಗತ ದಿಕ್ಹಾನು ತಿನಾ ವಚ್ಮಾನಾ ಭಾಗತು ಹೆಟಿ ಆಗ ಲಾಗಿತಿ; ತಿನಾ ವಚ್ಮಾನಾ ಭಾಗತು ಉಪ್ಪರ ಕ್ಹೊನಾನಿಂಗತ ಚಮ್ಕಾಡುಸ ಕವಾನು ಅದ್ಬುತ ಕಾಂತಿ ಚಮಕ್ಯು. <verse eid="EZK 8:2" /><verse number="3" style="v" sid="EZK 8:3" />ತೆಳಾಮಾ ತೆ ತೆಜನು ರುಪಬಿ ಮನಕ್ಹನಾ ಹತ್ತ ನಿಂಗತ ಹತ್ತಬಿ ಧರಿನ ಮಾತು ಧರಾನೆ ಕ್ಹುದಾನಿ ಮನೆ ಉಚೈಲಿನ ಜಿಮಿನ ಹಬಾಳನಾ ವಚ್ಮಾ ಯೆರುಸಲೆಮ ಲಕ್ಕಾ ಲಿಂಗೈನ ಮ್ಹೈ ನಾ ಪ್ರಕಾರ ಉತ್ತರ ದಿಕ್ಕಾನಾ ಬಾಕಲನಾ ಕ್ಹಾಮು ಕ್ಹುದಾನೆ ರೊಷಲಾವಾನು ವಿಗ್ರಹಬಿ ಪೈಲಾ ಜ಼ಗಾ ನೈ ಹುಬ್ರಾಡಲ ನಿಂಗತ ಕ್ಹುದಾನಾ ದರ್ಷನ ದಿಕ್ಹಿನ ಐಯು; ಆಹಾ<verse eid="EZK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 8:4" />ಇಸ್ರಾಯಲನಾ ಕ್ಹುದಾನಾ ಮಹಿಮಾದ್ಬುತನಾ ದರ್ಶನಬಿ ಬೈಲು ಸಿಮೆಮಾ ಥಯಲಜ಼ ಮನೆ ಥಯು . <verse eid="EZK 8:4" /><verse number="5" style="v" sid="EZK 8:5" />ತೆಳಾಮಾ ತೆ ಮನೆ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಉತ್ತರ ದಿಕ್ಕನಾ ಬಗಲ ಡೊಳೊ ಉಚೈನ ದೆಕ ಕೈನ ಕದ್ಯೊ; ತಿಮ್ಮಜ಼ ಮಿ ದೆಕ್ತಾಮಾ ಹಮ್ನಾ ಕ್ಹುದಾನೆ ರೊಷಕರಾನು ತೆ ವಿಗ್ರಹ ಯಜ್ಞವೆದಿನು ಬಾಕಲನಾ ಉತ್ತರ ದಿಕ್ಕನಾ ಬಾಕಲನಾ ಕ್ಹಾಮು ಹುಬ್ರಯುತು. <verse eid="EZK 8:5" /><verse number="6" style="v" sid="EZK 8:6" />ತೆಳಾಮಾ ತೆ ಮನೆ ತೆ ಕದ್ಯೊ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಔನೆ ಕರಾನು ದೆಕ್ಯೊಸ? ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ ನ್ಹ್ಯಾ ಕರಾನು ದುರಾಚಾರೊನೆ ದೆಕ್ಯೊಸ? ಇನಾಕ್ಹು ಮಿ ಮಾರು ಪವಿತ್ರಾಲಯನೆ ಚೊಡಿನ ದುರ ಜೌ಼ ಲಾಗ್ಯೂ. ಆ, ಆನಾತಿಬಿ ಹಜಿಬಿ ಹೆಚ್ಚ ಥಯಲ ದುರಾಚಾರೊನೆ ತು ದೆಕಸಿ ಕದ್ಯೊ.<verse eid="EZK 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 8:7" />ಪಾಚಾ಼ತೊ ತೆ ಮನೆ ಅಂಗ್ಳಾನಾ ಬಾಕಲನೆ ಆವಾ ಲಗಾಡ್ಯೊ; ಹಮ್ನಾ ತೆ ಗೊಡಿಮಾ ಯಕ್ಕ ಭೊಕಾಡೊ ದಿಕ್ಯ್ಹು. <verse eid="EZK 8:7" /><verse number="8" style="v" sid="EZK 8:8" />ತೆಳಾಮ ತೆ ಮನೆ ಮನಕ್ಹನಾ ದಿಕ್ರಾ ಗೊಡಿನೆ ಖಂದ ಕೈನ ಕದ್ಯೊ. ಮಿ ಗೊಡಿ ಭಾಂದತಾಮಾ ದೆಕ, ಯಕ್ಕ ಬಾಕಲ ದಿಕ್ಹ್ಯು. <verse eid="EZK 8:8" /><verse number="9" style="v" sid="EZK 8:9" />ತೆ ಮನೆ ತು ಮ್ಹೈ ಹೊಕ್ಕಿನ ಮನಕ್ಹೊ ಯ್ಹಾ ಚಲಾವಾನು ಅಸ್ಯಯ ಥಯಲ ದುಷ್ಕಾರ್ಯೊನೆ ದೆಕ ಕೈನ ಕದ್ಯೊ. <verse eid="EZK 8:9" /><verse number="10" style="v" sid="EZK 8:10" />ಮಿ ಹೊಕ್ಕಿನ ದೆಕ್ಯೊ ಕ್ಹಾರಾ ಜಾ಼ತನಾ ಜಿವ ಜಂತು ಅಸ್ಯಯ ಮೃಗೊ ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ ಪೂಜಾಕರಾನು ಹರಯಕ್ಕ ಮೂರ್ತಿಯೊನಾ ಸುತ್ತೆಬಿ ಗೊಡಿಯೊಪರ ಚಿತ್ರಾ ಕಾಡಲ ವ್ಹತ್ತು. <verse eid="EZK 8:10" /><verse number="11" style="v" sid="EZK 8:11" />ಇಸ್ರಾಯೆಲನಾ ವಂಶನಾ ಸತ್ತರ ಜನಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ತ್ಯುನಾ ವಚ್ಮಾ ಶಾಫನನೊ ದಿಕ್ರೊ ಥಯಲ ಯಾಜನ್ಯಬಿ ತ್ಯುನಾ ತ್ಯುನಾ ಹತೊಮಾ ಉದ ಧವಾಂಡೊ ವರಿ ಆರತಿ ಧರಲಿನ ಚಿತ್ರಾನಾ ಕ್ಹಾಮಾ ಹುಬ್ರಯಾತಾ; ಧವಾಂಡಾನಿ ಚೊಕಿಬಾಸ ಧವಾಂಡೊಬಿ ಮ್ಹಾಡ ನಿಂಗತ ಉಪ್ಪರ ಚಾಲ್ಯೊತೊ. <verse eid="EZK 8:11" /><verse number="12" style="v" sid="EZK 8:12" />ತೆಳಾಮಾ ತೆ ಮನೆ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಇಸ್ರಾಯಲ ವಂಶನಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಬಿಜಾ಼ ಬಿಜಾ಼ ರುಪಕ್ಹು ಚಿತ್ರಾ ಕಾಡಲ ತ್ಯುನಾ ತ್ಯುನಾ ಕ್ಹೊಲಿಯೊಮಾ ಅಂದಾರಾಮಾ ಚಲಾವಾನು ಕಾಮ ದೆಕ್ಯೊಸು? ಯಹೊವಾ ಅಪೊನೆ ನೈ ದೆಕ್ತೊ. ಯಹೊವಾ ದೆಶನೆ ಛೊಡಿ ಪಡ್ಯೊಸ ಕೈನ ಕ್ಹಾಲಿ ಬೊಲ್ಲಿವಸ. ಕೈನ ಕದ್ಯೊ. <verse eid="EZK 8:12" /><verse number="13" style="v" sid="EZK 8:13" />ಪಾಚಾ಼ತೊ ತೆ ಮನೆ ಆನಾತಿಬಿ ಘನ್ನಾ ದುರಾಚಾರೊನೆ ದೆಕಸಿ. <verse eid="EZK 8:13" /><verse number="14" style="v" sid="EZK 8:14" />ಕೈನ ಮನೆ ಯಹೊವಾನಾ ಉತ್ತರ ದಿಕ್ಕನಾ ಬಾಕಲನಾ ಕ್ಹಾಮೊ ಆವಾಲಗಾಡ್ಯೊ; ದೆಕ, ತ್ಯಾ ಹೆಣ್ಣ ಮನಕ್ಹೊ ತಮ್ಮೂಜ್ ಕವಾಲೊ ಕ್ಹುದಾ ಹುತಿ ರೊತಾ ಬೈಟ್ಯಾತಾ.<verse eid="EZK 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 8:15" />ಪಾಚಾ಼ತೊ ತೆ ಮನೆ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಆ ದೆಕ್ಯೊಸು? ಆನಾತಿಬಿ ವರಿ ಹೆಚ್ಕಿ ರ‍್ಹಯಲ ದುರಾಚಾರೊ ದೆಕ್ಸಿ ಕೈನ ಯಹೊವಾನಾ ಆಲಯನಾ ಮ್ಹೈ ಪ್ರಕಾರನಾ ಮ್ಹೈ ಮನೆ ಆವಾಲಗಾಡ್ಯೊ; <verse eid="EZK 8:15" /><verse number="16" style="v" sid="EZK 8:16" />ಆಹಾ, ಯಹೊವಾನಿ ಗುಡಿನೂ ಬಾಕಲನಾ ಕ್ಹಾಮು ಮಂಟಪನೆ ವರಿ ಬಲಿನು ಕಟ್ಟೊ ವಚ್ಮಾ ಸುಮಾರ ಪಚ್ಚಕ್ಹ ಮನಕ್ಹೊ ಯಹೊವಾನಾ ಗುಡಿನೆ ಪಟ್ಟ ಕರಿನ ಮೂಡಲನಾ ಮ್ಹೊಡು ಥೈನ ಪಾಟಲ್ಯಾ ಟೈಮನಾ ಸುರ್ಯಾನೆ ಪೂಜಾ ಕರತಾತಾ. <verse eid="EZK 8:16" /><verse number="17" style="v" sid="EZK 8:17" />ತೆಳಾಮ ತೆ ಮನೆ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ದೆಕ್ಯೊಸು? ಯೆಹುದ ವಂಶವಾಲಾ ತ್ಯುನೆ ಯ್ಹಾ ಕರಾನಾ ಅಸ್ಯಯ ಕಾಮೊ ಅಲ್ಪ ಥೈನ ಭಾವಸಿ ಲಿದ್ಯಾಮ? ದೆಶನೆ ಹೆಂಸ್ಸೆಕ್ಹು ಭರಲ ನೈಸೊ ಮನೆ ಕೆಣಕಿನ ಚಾಯೆಕೈನ ವರಿ ಪ್ರಯತ್ನ ಕರಾಡಾಸ; ದೆಕ, ಠೊಂಗಿಯೊಕ್ಹು ನಾಕನೆ ಝಾಕಿಲಿವಸ; <verse eid="EZK 8:17" /><verse number="18" style="v" sid="EZK 8:18" />ತೆ ಥಯಲ್ಪರ ಮಿ ಸಿಟ್ಟಕ್ಹು ಬೊಲುಸ, ಕಟಾಕ್ಷ ಕರುಸ, ಉಗ್ರಾತೊ ನೈ; ತ್ಯುನೆ ವದ್ರಾನಿ ಜೊ಼ರ ಅವಾಜ ಮಾರಾ ಕಾನೆ ಪಡಿತಬಿ ಐಕ್ತೊ ನೈ.<verse eid="EZK 8:18" /></para>
  <chapter eid="EZK 8" />
  <chapter number="9" style="c" sid="EZK 9" />
  <para style="s">ಜೆರುಸಲಿಮನೆ ಶಿಕ್ಷಾದಿದಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 9:1" />ಪಾಚಾ಼ತೊ ತೆ ಗಾಮನೆ ದಂಡ ದಿವಾಲಾ ತುಮೆ ಕ್ಹಾರಾ ತುಮಾರಾ ಹತ್ಯಾನಾ ಆಯುದೊನೆ ಧರಲವಾಲಾ ನಜಿಕ ರ‍್ಹವೊ” ಕೈನ ಘಟ್ಟ ಥೈನ ಅಡ್ಡಿನ ಕದಲ ವಾತ ಮಾರಾ ಕಾನೆ ಪಡ್ಯು. <verse eid="EZK 9:1" /><verse number="2" style="v" sid="EZK 9:2" />ತೆಳಾಮಾಜ಼ ಖತರನಾಕ ಆಯುಧೊ ಧರಲಿನ ಛೆ ಜನಾ ದಾಣ್ಗಾವೊ ಉತ್ತರನು ಮ್ಹೊಡು ಥಯಲ ಉಪ್ಪರಲ್ಯಾ ಬಾಕಲನೆ ವಾಟ ಥೈನ ಆಯಾ; ಕಿಮ್ಮತನಾ ವಣ್ಣಾವೊನಾ ಲಿಂಗೈನ ಲೆಖಕನಿ ವಚ್ಮಾ ಭಾಂದಿಲಿದಲ ಹಜಿಯಕ್ಕ ದಾಣ್ಗೊ ತ್ಯುನಾ ವಚ್ಮಾ ವ್ಹತ್ತೊ. ಅವ್ನೊಕ್ಹಾರಾ ಮ್ಹೈ ಹೊಕ್ಕಿನ ತಾಂಬಾನು ಬಲಿನೊ ಕಟ್ಟಾನಾ ಬಾಜು಼ಮಾ ಹುಬ್ರಯಾತಾ. <verse eid="EZK 9:2" /><verse number="3" style="v" sid="EZK 9:3" />ಅಕ್ಲಾಜ಼ ಇಸ್ರಾಯಲನಾ ಕ್ಹುದಾನಾ ತೆಜಸ್ಸನೆ ತಿನಾ ಕೆರುಬಿನೆ ಛೊಡಿನ ಉಪ್ಪರ ಚಡಿನ ಆಲಯನಾ ಪಾಳಿನಾ ಉಪ್ಪರ ಹುಬ್ರಯುತು; ತೆಳಾಮಾ ನಾರಿನಾ ವಣ್ಣಾವೊನೆ ಲಿಂಗೈನ ಲೆಖಕನ ದೌತಿನಾ ವಚ್ಮಾ ಭಾಂದಿಲಿದಲ ದಾಣ್ಗಾನೆ ಯಹೊವಾ ಬಲೈನ. <verse eid="EZK 9:3" /><verse number="4" style="v" sid="EZK 9:4" />ತಿನೆ ತು ಯೆರುಸಲೆಮ ಕ್ಹಾರಾ ಗಾಮ್ಮಾ ಫರಿನ ತಿಮಾ ಮ್ಹೈ ಚಾ಼ಲಾನು ಸಮಸ್ತ ಅಸ್ಯಯ ಕಾಮೊನಾಹುತಿ ನರಳಿನ ಗೊಲಾಟಾ ಥಾವಾನಾ ಮನಕ್ಹೊನಾ ಕಪ್ಪಾಳಪರ ವಳಕ ಕರ ಕದ್ಯೊ. <verse eid="EZK 9:4" /><verse number="5" style="v" sid="EZK 9:5" />ಉಗ್ರಲವಾಲಾವೊನೆ ತುಮೆ ಗಾಮಾ ಕ್ಹಾರಾ ಅನಾ ಪಾಚಾ಼ ಫರತಾ ಖಲಾಸ ಕರೊ. ಕಿನೆಜ಼ ಮುಲಾಜೊ಼ ಮ್ಹೆಲೊ ನಕೊ, ಉಗ್ರಾಡೊನಕೊ, <verse eid="EZK 9:5" /><verse number="6" style="v" sid="EZK 9:6" />ಗಡಿಯಾ, ಜಾಂಜಿಮಾನೊ, ಛೊಕ್ರಿಯೊ, ಬಾಕ್ಡಿ, ಮಾವೊನೆ ಪಟ್ಟಾವೊನೆ ಬಚ್ಚಾ಼ವೊನೆ ಕಯೆವಾಚಿ ಕ್ಹಾರಾವೊನೆ ಕತ್ರಿಪಡ್ಯೊ; ತೆ ನೈಸೊ ತೆ ವಳಕ ಕರಲವಾಲಾವೊನೆ ಕಿನೆಜ ಮುಟ್ಟೊನಕೊ; ಮಾರಾ ಆಲಯಮಾ ಪ್ರಾರಂಬ ಕರೊ ಕವಾನು ತೆ ಮನೆ ಐಕಾವರಕ್ಹು. ತೆಳಾಮಾ ದೆವಾಲಯನಾ ಕ್ಹಾಮಾ ರ‍್ಹಯಲ ಮ್ಹೊಟಾವೊನೆ ಪೈಲಾಲಿನ ಖಲಾಸ ಕರ‍್ಯಾ. <verse eid="EZK 9:6" /><verse number="7" style="v" sid="EZK 9:7" />ತೆ ತ್ಯುನೊನೆ ಜಾ಼ವೊ, ಅಂಗ್ಳಾವೊನೆ ಮುರ್ದಾವೊಕ್ಹು ಭರಿನ ದೆವಾಲಯನೆ ಹೊಲಸ ಕರ್ಯೊ ಕೈನ ಅಪ್ಪಣೆ ದೆತಾಮಾ ತ್ಯುನೆ ಗೈನ ಗಾಮವಾಲಾವೊನೆ ಖಲಾಸ ಕರ‍್ಯಾ. <verse eid="EZK 9:7" /><verse number="8" style="v" sid="EZK 9:8" />ತ್ಯುನೊನೆ ಮಾರಾತಾ ಟೈಮಾ ತ್ಯಾ ಮಿ ಯಕ್ಲೊ ಉಗ್ರಲ ಮಿ ಡಬ್ಬ ಪಡಿನ ಅಯ್ಯೊ, ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ತು ಯೆರುಸಲೆಮನಾ ಉಪ್ಪರ ಸಿಟ್ಟ ಅಗ್ನಿನೆ ಲಿಂಗೈನ ಇಸ್ರಾಯಲನಾ ಸಂಖ್ಯಾನಾ ಕ್ಹಾರಾ ನಾಶಕರ ಕೈನ ಮೊರೆ ಮ್ಹಲ್ತಾಮಾ ತೆ ಮನೆ<verse eid="EZK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 9:9" />ಇಸ್ರಾಯಲೊ ವರಿ ಯೆಹುದ ವಂಶವಾಲಾ ಅಧರ್ಮಬಿ ಅತ್ಯಂತ ಥಯುಸ; ದೆಶಬಿ ರಗತನು ಪುರ್ಣ ಥಯು, ಯೆರುಸೆಲಿಮ ಗಾಮಬಿ ಅಪರಾಧಕ್ಹು ಭರಿಗಯುಸ ಭರಿತ ಥಯುಸ; ತೆ ವಂಶವಾಲಾ ಅಪ್ನಾ ದೆಶವಾಲಾ ಯಹೊವಾ ಛೊಡಿಪಡ್ಯೊಸ ಯಹೊವಾ ದೆಕ್ತೊ ನೈ ಕೈನ ಬೊಲ್ಲಿವಾಡಾಸ ಕೈನ ಮಿ ತೊಬಿ ತ್ಯುನೊನೆ ಆಸಿರ್ವಾದ ಕರಸ, <verse eid="EZK 9:9" /><verse number="10" style="v" sid="EZK 9:10" />ಮರ್ಗ್ಯಾವಾಚಿ ದಯಾಕರ‍್ಯಾವಾಚಿ, ತ್ಯುನಾ ಕೆಟ್ಟ ಕಾಮೊನು ತ್ಯುನೊನೆ ಶಿಕ್ಷಾ ದ್ಯುಸ. <verse eid="EZK 9:10" /><verse number="11" style="v" sid="EZK 9:11" />ತೆಳಾಮಾ ಚೊಕಾ ವಣ್ಣಾವೊನೆ ಘಾಲ್ಲಿನ ದೌತಿನಾ ವಚ್ಮಾ಼ಜ಼ ಭಾಂದಿಲಿವಸ ದಾಣ್ಗಾಬಿ ತಾರಾ ಅಪ್ಪಣೆ ನಿಂಗತಜ಼ ಕರ‍್ಯೊಸ ಕೈನ ಅರಕೆ ಕರ್ಯೊ.<verse eid="EZK 9:11" /></para>
  <chapter eid="EZK 9" />
  <chapter number="10" style="c" sid="EZK 10" />
  <para style="s">ಕ್ಹುದಾನಿ ಮಹಿಮಾ ದೆವಾಲಯನೆ ಛೊಡಿನ ಗಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 10:1" />ಹಮ್ನಾ ಮಿ ದೆಕ್ತಾಮಾ ಕೆರೊಬಿಯೊನಾ ಮಾತಾನಾ ಉಪ್ಪರ ರ‍್ಹಯಲ ಗಗನ ಮಂಡಳ ಉಪ್ಪರ ಕಿಮ್ಮತನೊ ನಿಲಮಣಿ ನಿಂಗತ ಮಿಂಚಾನು ಸಿಂಹಾಸನನಾ ನಿಂಗತ ದಿಕ್ಹ್ಯು. <verse eid="EZK 10:1" /><verse number="2" style="v" sid="EZK 10:2" />ತೆ ಚೊಕಾ ವಣ್ಣಾವೊನೆ ಲಿನ ಗೈನ ತೆ ದಾಣ್ಗಾನೆ ತು ಗಿರಗಿರ ಫರಾನು ಗಾಲಿಯೊನಾ ವಚ್ಮಾ ಕೆರುಬಿನಾ ಹೆಟಾ ಗೈನ ಕೆರುಬಿನಾ ವಚ್ಮಾತೊ ಬೊಗಸೆಮಾ ಕೆಂಡಾವೊನೆ ಭರಿನ ಲೈನ ಗಾಮ್ನಾ ಉಪ್ಪರ ನಾಕ ಕೈನ ಅಪ್ಪಣೆ ದೆತಾಮಾ ತೆ ಮಾರಾ ಡೊಳಾ ಕ್ಹಾಮೊ ಗೈನ ತ್ಯಾ ಪ್ರವೆಶ ಕರ‍್ಯೊ. <verse eid="EZK 10:2" /><verse number="3" style="v" sid="EZK 10:3" />ತೆ ಸೆರತಾಮಾ ಕೆರುಬಿಯೊ ದೆವಾಲಯನಾ ಅಂಗಳಮಾ ಹುಬ್ರಯಾತಾ, ಮೆಘನಾ ಮ್ಹೈ ಪ್ರಕಾರಬಿ ಭರ‍್ಯುತು. <verse eid="EZK 10:3" /><verse number="4" style="v" sid="EZK 10:4" />ತೆ ನೈಸೊ ಯಹೊವಾನಾ ತೆಜಸ್ಸ ಕೆರುಬಿಯೊನೆ ಛೊಡಿನ ಉಪ್ಪರ ಚಡಿನ ದೆವಾಲಯನಾ ಪಾಳಿನಾ ಉಪ್ಪರ ಹುಬ್ರಯುತು; ದೆವಾಲಯಮಾಬಿ ಮೆಘಬಿ ಭರಿತಿ; ಯಹೊವಾನಿ ತೆಜಸ್ಸನಿ ಅದ್ಬುತ ಕಾಂತಿಬಿ ಅಂಗ್ಳಾಮಾಬಿ ಭರಿಗಯುತು. <verse eid="EZK 10:4" /><verse number="5" style="v" sid="EZK 10:5" />ತೆಳಾಮಾ ಕೆರುಬಿಯೊನಾ ರೆಕ್ಯಾನು ಅವಾಜ ಸರ್ವಶಕ್ತಥಯಲ ಕ್ಹುದಾ ಬೊಲಾನಾ ಅವಾಜ ನಿಂಗತ ಗಂಭಿರ ಥೈನ ಭಾರಾ ಪ್ರಕಾರನಾ ಪರ್ಯಂತಬಿ ಐಕಾಯು.<verse eid="EZK 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 10:6" />ತೆ ಚೊಕಾ ವಣ್ಣಾವೊನೆ ಲಿಂಗೈಲ ದಾಣ್ಗಾನೆ ತು ಗರಗರ ಫರಾನಾ ಗಾಲಿಯೊನಾ ವಚ್ಮಾ ಮ್ಹೆ ಗೈನ ಕೆರುಬಿನಾ ವಚ್ಮಾತೊ ಆಗನೆ ಕಾಡಿಲೆ ಕೈನ ಅಪ್ಪಣೆ ದಿವಾನೆ ತೆ ಮ್ಹೈ ಗೈನ ಯಕ್ಕ ಗಾಲಿನಾ ಬಾಜು಼ಮಾ ಗೈನ ಹುಬ್ರೆ. <verse eid="EZK 10:6" /><verse number="7" style="v" sid="EZK 10:7" />ತೆಳಾಮಾ ಯಕ್ಕ ಕೆರುಬಿ ಕೆರುಬಿಯೊನಾ ವಚ್ಮಾ ಹತ್ತ ಘಾಲಿನ ತಿನಾ ವಚ್ಮಾ ರ‍್ಹಯಲ ಆಗನೆ ಲಿನ ಚೊಕಾ ವಣ್ಣಾವೊನೆ ಲಿಂಗೈಲ ಬೊಗಸೆಮಾ ಘಾಲ್ಯು; ತೆ ತಿನೆ ಲಿನ ಹೆಂಗೆ ಚಾಲ್ಯೊ. <verse eid="EZK 10:7" /><verse number="8" style="v" sid="EZK 10:8" />ಕೆರುಬಿನಾ ಯಕ್ಕ-ಯಕ್ಕ ರೆಕ್ಯಾನಾ ಹೆಟು ಮನಕ್ಹನಾ ಹಸ್ತ ನಿಂಗತ ಯಕ್ಕ ಯಕ್ಕ ಹಸ್ತ ದಿಕ್ಯೂ. <verse eid="EZK 10:8" /><verse number="9" style="v" sid="EZK 10:9" />ಹಮ್ನಾ ಮಿ ದೆಕ್ತಾಮಾ ಆ ಕೆರುಬಿಯೊನಾ ಬಾಜು಼ಮಾ ಯಕ್ಕ ಯಕ್ಕ ಕೆರುಬಿನಾ ಬಾಜು಼ ಯಕ್ಕ ಯಕ್ಕ ಗಾಲಿ ನಿಂಗತ ಚಾರ ಗಾಲಿಯೊ ವ್ಹತ್ತಾ; ತೆ ಗಾಲಿಯೊನ ರಂಗ ಪಿತ ರತ್ನನಿಂಗತ ಮಿಂಚ್ಯು. <verse eid="EZK 10:9" /><verse number="10" style="v" sid="EZK 10:10" />ತಿನು ರುಪ ಕಿಮ್ಮ ಕದ್ಯಾಮ ಯಕ್ಕ ಗಾಲಿಮಾ ಹಜಿಯಕ್ಕ ಗಾಲಿಬಿ ಅಡ್ಡ ಥೈನ ಕಾಡಲ ವ್ಹತ್ತು, ತೆ ಯಕ್ಕಜ ಮಾದರಿ ಥಯಾತಾ. <verse eid="EZK 10:10" /><verse number="11" style="v" sid="EZK 10:11" />ತೆ ಫರತಾಮಾ ಚಾರೆ ಜ಼ಗಾಬಿ ಕಿ ಬಗಲಬಿ ಫರತಾತಾ. ಒರೆ ಥೈನ ಫರತಾ ನ್ಹೊತಕ್ಹಾಮಾಲ್ಯಾ ಮ್ಹೊಡಾತಾ ಜಯೆಸ ನೈತೊ ಒರೆ ಥೈನ ಜಾ಼ತಾ ನ್ಹೊತಾ. <verse eid="EZK 10:11" /><verse number="12" style="v" sid="EZK 10:12" />ಕೆರುಬಿಯೊನಾ ಪಿಟ್ಟ, ಹತ್ತ, ರೆಕ್ಯಾ, ಸರ್ವಂಗೊಮಾ ಗಾಲಿಯೊಮಾ ಡೊಳಾವೊ ಭರಿ ಗಯಾತಾ; ಚಾರೆ ಕೆರುಬಿನಾ ಯಕ್ಕನೆ ಯಕ್ಕ ಯಕ್ಕ ಯಕ್ಕ ಗಾಲಿ ವ್ಹತ್ತಿ . <verse eid="EZK 10:12" /><verse number="13" style="v" sid="EZK 10:13" />ಮಿ ಐಕಲ ನಿಂಗತ ತೆ ಗಾಲಿಯೊನು ನಾಮ ಗರಗರ ಗಾಲಿ ನಿಂಗತ.<verse eid="EZK 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 10:14" />ಯಕ್ಕ ಕೆರುಬಿನೆ ಚಾರಚಾರ ಮ್ಹೊಡಾ ವ್ಹತ್ತಾ; ಪೈಲಾನು ಕೆರುಬಿನು, ಬೆವಾನು ಮನಕ್ಹನು, ತನವಾನು ಸಿಂಹಾಡಾನು, ಚಾರವಾನು ಗರುಡ ಪಕ್ಷಿನು. <verse eid="EZK 10:14" /><verse number="15" style="v" sid="EZK 10:15" />ತೆ ಕೆರುಬಿಯೊ ಉಪ್ಪರ ಚಡ್ಯಾ; ಮಿ ಕೆಬಾರ ನದಿಕನ ದೆಕಲ ಜಿವಿಯೊ ಆಜ ವ್ಹೈ. <verse eid="EZK 10:15" /><verse number="16" style="v" sid="EZK 10:16" />ಕೆರುಬಿಯೊ ಅಗಾ ಜಾ಼ತಾಮಾ ಗಾಲಿಯೊಬಿ ತಿನಾ ಬಾಜು಼ಮಾ ಅಗಾ ಜಾ಼ತಾತಾ, ಕೆರುಬಿಯೊ ಜಿಮಿನತಾ ಉಪ್ಪರ ಜೌ಼ ಕೈನ ರೆಕ್ಯಾವೊ ಫೈಲೈಲೆತಾಮಾ ಗಾಲಿಯೊಬಿ ಒರೆ ಥಯೆವಾಚಿ ತ್ಯುನಾ ಕ್ಹಾತೆಜ ಉಪ್ಪರ ಗಯಾ. <verse eid="EZK 10:16" /><verse number="17" style="v" sid="EZK 10:17" />ಜಿವಿಯೊನಿ ಆತ್ಮಾ ಗಾಲಿಮಾಬಿ ರ‍್ಹಯಲ ಕಾರಣಕ್ಹು ತೆ ಹುಬ್ರನ ಜಾ಼ತಾಮಾ ತೆಬಿ ಹುಬ್ರೈನ ಗಯಾ, ತೆ ಚಡ್ತಾಮಾ ತೆಬಿ ತ್ಯುನಾ ಕ್ಹಾತೆಜ ಉಪ್ಪರ ಗೈಪಡ್ಯಾ.<verse eid="EZK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 10:18" />ತೆ ಥಯಲ್ಪರ ಯಹೊವಾ ತೆಜ್ಜಸ ದೆವಾಲಯನಾ ವ್ಹಚ್ಚಲ ಛೊಡಿನ ಕೆರುಬಿನಾ ಉಪ್ಪರ ಹುಬ್ರಯುತು. <verse eid="EZK 10:18" /><verse number="19" style="v" sid="EZK 10:19" />ತೆಳಾಮಾ ಮಾರಾ ಡೊಳಾನಾ ಕ್ಹಾಮೊ ಕೆರುಬಿಯೊನಾ ರೆಕ್ಯಾವೊನೆ ಫೈಲೈಲಿನ ಗಾಲಿಯೊಬಿ ಜಿಮಿನತಾ ಚ಼ಡಿನ ಗೈನ ಯಹೊವಾನಾ ಆಲಯನಾ ಪುರ್ವ ಬಾಕಲಕನ ಹುಬ್ರಯಾತಾ, <verse eid="EZK 10:19" /><verse number="20" style="v" sid="EZK 10:20" />ತಿನಾ ಉಪ್ಪರ ಇಸ್ರಾಯಲೊನೊ ಕ್ಹುದಾನಿ ಮಹಿಮಾನಿ ತೆಜಸ್ಸ ತ್ಯುನೊಪರ ವ್ಹತಿ. ಇಸ್ರಾಯಲನಾ ಕ್ಹುದಾನ ವಶಮಾ ರ‍್ಹತಾಮ ಕೆಬಾರ ನದಿಕನ ಮನೆ ದಿಕ್ಹಲ ತೆ ಜಿವಿಯೊ ಆಜ ವ್ಹೈ; ತೆ ಕೆರುಬಿಯೊ ವ್ಹೈಕೈನ ಹಮ್ನಾ ಮನೆ ತಿಳ್ದಿನ ಐಯು.<verse eid="EZK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 10:21" />ಯಕ್ಕನೆ ಯಕ್ಕ ಚಾರಚಾರ ಮ್ಹೊಡಾ ಚಾರಚಾರ ರಕ್ಯಾವೊ ವ್ಹತ್ತಾ. ತಿನಾ ರೆಕ್ಯಾವೊನಾ ಹೆಟಾ ಮನಕ್ಹನಾ ಹತೊ ನಿಂಗತ ಹತೊ ವ್ಹತಾ. ವ್ಹತ್ತು; <verse eid="EZK 10:21" /><verse number="22" style="v" sid="EZK 10:22" />ತ್ಯುನಾ ಮ್ಹೊಡಾ ಕೆಬಾರ ನದಿನಾ ಬಾಜು಼ ಮಿ ದೆಕಲ ಮ್ಹೊಡಾವೊ ನಿಂಗತ ಮನೆ ದಿಕ್ಹಿನ ಐಯು, ತೆ ತೆ ಮ್ಹೊಡಾ ಹರಯಕ್ಕ ಜಿವಿಬಿ ಗಯಲಶಿದಾ ವ ಮ್ಹೊಡು ಥೈನ ಜಾ಼ತುತು.<verse eid="EZK 10:22" /></para>
  <chapter eid="EZK 10" />
  <chapter number="11" style="c" sid="EZK 11" />
  <para style="s">ಯೆರುಸಲಿಮನು ಖಂಡನ ಕರಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 11:1" />ಪಾಚಲ್ತಾ ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಮನೆ ಉಚೈನ ಯಹೊವಾನಾ ಆಲಯನಾ ಪುರ್ವದಿಕ್ಕನಾ ರ‍್ಹಯಲ ಬಾಕಲಕನ ಲೈನ ಛೊಡ್ಯೂ; ಹಮ್ನಾ ಬಾಕಲನಾ ಕ್ಹಾಮಾ ಪಚ್ಚಕ್ಹ ಜನಾ ಹುಬ್ರಯಾತಾ; ಮಿ ತ್ಯುನಾ ವಚ್ಮಾ ಅಜ್ಜುರನೊ ದಿಕ್ರೊ ಥಯಲ ಯಾಜನ್ಯ, ಬೆನಾಯನೊ ದಿಕ್ರೊ ಥಯಲ ಪೆಲ್ಯತ ಕವಾಲೊ ಮನಕ್ಹೊನಾ ನಾಯಕೊನೆ ದೆಕ್ಯೊ.<verse eid="EZK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 11:2" />ತ್ಯಾ ಕ್ಹುದಾ ಮನೆ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಗಾಮಾ ಕುತಂತ್ರಯೊನೆ ಕಲ್ಪನೆ ಕರಿನ ದುರ ಆಲೊಚನಾ ಕವಾಲಾ ಆಜ಼ ಮನಕ್ಹೊ ವ್ಹೈ; <verse eid="EZK 11:2" /><verse number="3" style="v" sid="EZK 11:3" />ಔನೆ ಘರೊ ಭಾಂದಿಲಿವಾನೊ ಟೈಮ ನತ್ತಿ ಆಯೊ; ಆ ಗಾಮ ತಪಾಲೊ ವ್ಹೈ, ಅಪೆ ತಿಮಾನು ಮಾಕ್ಹ ವ್ಹೈ ಕವಸ. <verse eid="EZK 11:3" /><verse number="4" style="v" sid="EZK 11:4" />ತೆ ಥಯಲ್ಪರ ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಔನಾ ವಿಷಯಮಾ ಪ್ರವಾದನೆ ಕರ. ಎ ಮನಕ್ಹನಾ ದಿಕ್ರಾ ಪ್ರವಾದನೆ ಕರ.<verse eid="EZK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 11:5" />ತೆಳಾಮಾ ಯಹೊವಾನಿ ಆತ್ಮಾ ಮಾರಾಮಾ ಆವಾಹುತಿ ಅಮ್ಮ ಕೆ ಕೈನ ಅಪ್ಪಣ್ಣೆ ಥಯು. ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ, ತುಮೆ ಅಮ್ಮ ಬೊಲಾಡಾಸ, ಥಯು ತುಮಾರಾ ಮನಸಮಾ ಹುಟ್ಟಲ ಆಲೊಚನಾ ಮನೆ ಗೊತ್ತ ಛೆ. <verse eid="EZK 11:5" /><verse number="6" style="v" sid="EZK 11:6" />ತುಮೆ ತೆ ಗಾಮ್ಮಾ ನರಹತ್ಯಾನೆ ಹೆಚ್ಚ ಹೆಚ್ಚ ಕರಿನ ಹತ ಥಯಲವಾಲಾವೊಕ್ಹು ಬಿದಿಯೊನೆ ಭರ್xಯಾಸ. <verse eid="EZK 11:6" /><verse number="7" style="v" sid="EZK 11:7" />ತೆ ಥಯಲ್ಪರ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತುಮಾರಾ ದೊಷಕ್ಹು ಹತ ಥೈನ ಗಾಮಮಾ ಪಡಲ ತುಮಾರಾವೊನಾಜ ಮುರ್ದಾ ವ್ಹೈ ತಪಾಲೊ ಮಾಕ್ಹ, ಆ ಗಾಮನೊ ತಪಾಲೊ ವ್ಹೈ, ತುಮೊನೆಬಿ ಮಿ ತೆ ಹಂಡಾಮಾತೊ ಕಿತ್ತಿನ ಭಾರೊ ಘಾಲುಸ. <verse eid="EZK 11:7" /><verse number="8" style="v" sid="EZK 11:8" />ತಲ್ವಾರಕ್ಹು ಭುಚಕ್ಯಾಸು? ತುಮೊನೆಜ ತವ್ವಾರನೊ ನಿಶ್ಯಾನೊ ಕರುಸ; ಆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 11:8" /><verse number="9" style="v" sid="EZK 11:9" />ಮಿ ಗಾಮಾತೊ ತುಮೊನೆ ಕಿತ್ತಿನ ಅನ್ಯನಾ ಹತೆ ದಿನ ದಂಡ ದಿವಾಲಗಾಡುಸ. <verse eid="EZK 11:9" /><verse number="10" style="v" sid="EZK 11:10" />ತುಮೆ ತಲ್ವಾರನಾ ಮ್ಹೊಡಾಮಾ ಜಾ಼ವೊಶಿ. ಇಸ್ರಾಯಲನಾ ಸಿಮೆನಾ ಮ್ಹೈಜ ತುಮೊನೆ ದಂಡನೆ ದ್ಯುಸ, ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ. <verse eid="EZK 11:10" /><verse number="11" style="v" sid="EZK 11:11" />ಆ ಗಾಮ ತುಮೊನೆ ತಪಾಲೊ ನೈ ಥಾತೊ; ತಿಮಾನು ಮಾಕ್ಹಬಿ ತುಮೆ ನೈ ಥಾತಾ. ಇಸ್ರಾಯಲನಾ ಸಿಮೆನಾ ಮ್ಹೈಜ಼ ತುಮೊನೆ ದಂಡನೆ ದ್ಯುಸ. <verse eid="EZK 11:11" /><verse number="12" style="v" sid="EZK 11:12" />ಮಿಜ ಯಹೊವಾ ವ್ಹೈಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ; ತುಮೆ ಮಾರಿಯೊ ಪದ್ದತಿಯೊ ಪಾಲಶ್ಯಾವಾಚಿ ಮಾರಾ ನಿಯಮೊನೆ ನೈ ಪಾಲಶ್ಯಾವಾಚಿ ತುಮಾರಾ ಸುತ್ತೆಬಿನಾ ಜನಾಂಗೊನೆ ಆಚಾರೊನೆ ಪಾಲಸಲಕ್ಹು ಆ ಕ್ಹಾರು ಥಾವಸ. <verse eid="EZK 11:12" /><verse number="13" style="v" sid="EZK 11:13" />ಮಿ ಆ ವಾತ ಕತಾಮಾ ಬೆನಾಯನೊ ದಿಕ್ರೊ ಥಯಲ ಪೆಲತ್ಯನ ಮರಿ ಗಯೊ. ತೆಳಾಮಾ ಮಿ ಡಬ್ಬ ಪಡಿನ ಜೊ಼ರ ವದ್ರಿನ ಎ, ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ, ಇಸ್ರಾಯಲಮಾ ಉಗ್ರವಾಲಾವೊನೆ ನಾಶ ಕರುಸಿಸು? ಕೈನ ಮೊರೆ ಮ್ಹೆಲ್ಯೊ.<verse eid="EZK 11:13" /></para>
  <para style="s">ದೆಶ ಭ್ರಷ್ಟೊನಾ ಹುತಿ ಕ್ಹುದಾನಿ ವಾತ</para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 11:14" />ತೆಳಾಮಾ ಯಹೊವಾ ಆ ವಾತನೆ ಮನೆ ದಿದ್ಯೊ. <verse eid="EZK 11:14" /><verse number="15" style="v" sid="EZK 11:15" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ ತಾರಾ ಸಹೊದರೊ, ತಾರಾ ನ್ಹಾನಾ ವರಿ ಮ್ಹೊಟಾ ಭಾಯೊ, ತಾರಾ ನೆಂಟೊ ವರಿ ಯೆರುಸಲೆಮವಾಲಾ ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾವೊಮಾ ಕಿನೆ ಕಿನೆಬಿ ಯಹೊವಾನಾ ಕ್ಹಾಮಾತಾ ದುರ ಢಕಲೊ, ಆ ದೆಶ ಅಪೊನೆ ಸಾಸ್ವ್ತ ಥೈನ ಮಳ್ಯುಸ ಕೈನ ಹಿನಾಯಲವಾಲಾ ತ್ಯುನೆ ಕ್ಹಾರಾ ಉಗ್ರ್ಯಾಸತೊ. <verse eid="EZK 11:15" /><verse number="16" style="v" sid="EZK 11:16" />ತೆ ಥಯಲ್ಪರ ತು ಅಮ್ಮ ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಿ ತ್ಯುನೊನೆ ದುರ ಮೊಕಲೈನ ಜನಾಂಗೊಮಾ ಅನ್ಯ ದೆಶೊಮಾ ಬಿಖರೈಗಯಾ ತ್ಯುನೆ ಸೆರಲ ದೆಶೊಮಾ ಮಿ ದಕ್ಹೊ ಟೈಮ ತ್ಯುನೊನೆ ಪವಿತ್ರ ಆಲಯ ಥಯಲ ರ‍್ಹವುಸ.<verse eid="EZK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 11:17" />ತೆ ಥಯಲ್ಪರ ತ್ಯುನೊನೆ ಜನಾಂಗೊಮಾತೊ ಕುಡಸುಸ, ಭಿಕ್ಹರೈಗಯಲ ದೆಶೊಮಾತು ತ್ಯುನೊನೆ ಮಳಿನ ಆವಾಲಗಾಡಿನ ಇಸ್ರಾಯಲ ದೆಶನೆ ತ್ಯುನೊನೆ ದಯಪಾಲಸುಸ. <verse eid="EZK 11:17" /><verse number="18" style="v" sid="EZK 11:18" />ತ್ಯನೆ ತ್ಯಾ ಐನ ಕ್ಹಾರಾ ಅಸಯ್ಯ ಸಾಮನೊನೆ ಸಮಸ್ತ ಹೆಯ ವಿಗ್ರಹವೊನೆ ತ್ಯಾಂತಾ ಕಾಡಿ ಪಡಸ. <verse eid="EZK 11:18" /><verse number="19" style="v" sid="EZK 11:19" />ತ್ಯುನೆ ಮಾರಾ ನಿಯಮೊನೆ ಅನುಸರಸಿನ ಮಾರಾ ವಿಧಿಯೊನೆ ಕೈ ಗೊಳ್ಳಿನ ಪಾಲಸಾಲೊ ಕೈನ ಮಿ ತ್ಯುನೊನೆ ಯಕ್ಕಜ ಮನಸ ದಯಪಾಲಸಿನ ನಯಿ ಆತ್ಮಾ ತ್ಯುನಾಮಾ ಹುಟ್ಟಸುಸ; ದಗ್ಡೊ ಥಯಲ ಮನಸನೆ ತ್ಯುನಾಮಾತು ಕಾಡಿನ ಮೃದು ಮನಸ ಥಯಲ ತ್ಯುನೊನೆ ಘಾಲುಸ; <verse eid="EZK 11:19" /><verse number="20" style="v" sid="EZK 11:20" />ತ್ಯುನೆ ಮನೆ ಪ್ರಜೆ ಥಾವಸ, ಮಿ ತ್ಯುನೊನೆ ಕ್ಹುದಾ ಥವೊಸ. <verse eid="EZK 11:20" /><verse number="21" style="v" sid="EZK 11:21" />ತೆ ನೈಸೊ ಕಿನಿ ಚಿತ್ತಬಿ ತುಮಾರಾ ಅಸಯ್ಯ ಸಾಮನೊನೆ ಹೆಯ ವಿಗ್ರಹವೊನೆ ಅನುಸರಸಲ ತ್ಯುನಿ ದುರ್ನಡತೆನೆ ತ್ಯುನಾ ಮಾತೆ ಭಾಂದುಸ. ಆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 11:21" /></para>
  <para style="s">ಕ್ಹುದಾನು ಮಹಿಮಾ ಜೆರುಸೆಲಿಮನೆ ಛೊಡಿನ ಗಯಲ</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 11:22" />ತೆ ಥಯಲ್ಪರ ಗಾಲಿಯೊನಾ ಬಾಜು಼ಮಾ ಕೆರುಬಿಯೊ ರೆಕ್ಯಾ ಫೈಲೈಲಿದ್ಯಾತಾ, ಇಸ್ರಾಯಲನಾ ಕ್ಹುದಾನಾ ತೆಜಸ್ಸನೆ ತಿನಾ ಉಪ್ಪರ ನೆಲಸ್ಯುತು. <verse eid="EZK 11:22" /><verse number="23" style="v" sid="EZK 11:23" />ತೆಳಾಮಾ ಯಹೊವಾನಿ ಮಹಿಮಾ ಗಾಮ್ನಾ ವಚ್ಮಾತಿ ಚಡಿನ ಗಾಮ್ನಾ ಪುರ್ವ ದಿಕ್ಕಮಾ ರ‍್ಹಯಲ ಡೊಂಗರಪರ ಹುಬ್ರಯುತು. <verse eid="EZK 11:23" /><verse number="24" style="v" sid="EZK 11:24" />ಪಾಚಾ಼ತು ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಭರ್ತರ ಥೈನ ಮನೆ ಉಚೈನ ದಿವ್ಯ ದರ್ಶನನಾ ಮುಕಾಂತರ ಕಸ್ದಿಯ ದೆಶಮಾ ಆಳಥಯಲವಾಲಾವೊನಾ ಕ್ಹಾಮೊ ಲಿಂಗೈನ ಲೈಯು ಮನೆ ಥಯಲ ದಿವ್ಯದರ್ಶನಬಿ ತೆಳಾಮಾ ಗಾಯಬ ಥಯು. <verse eid="EZK 11:24" /><verse number="25" style="v" sid="EZK 11:25" />ಬಬಬಬ<verse eid="EZK 11:25" /></para>
  <chapter eid="EZK 11" />
  <chapter number="12" style="c" sid="EZK 12" />
  <para style="s">ತ್ಯಾ ನೈ ರ‍್ಹಯಲ ಪ್ರವಾದಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 12:1" />ಯಹೊವಾ ಮನೆ ಆಂ ವಾಕ್ಯಾ ದಿದ್ಯೊ. <verse eid="EZK 12:1" /><verse number="2" style="v" sid="EZK 12:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ದ್ರೊಹಿವಂಶನಾ ವಚ್ಮಾ ರ‍್ಹಶಿ, ತೆ ವಂಶವಾಲಾ ದ್ರೊಹಿಯೊ ರ‍್ಹಯಲಕ್ಹು ಡೊಳಾ ರ‍್ಹಯಾತಬಿ ದೆಕ್ತಾ ನೈ, ಕಾನೊ ರ‍್ಹಯಾತಬಿ ಐಕ್ತಾ ನೈ. ಕಾ ಕದ್ಯಾಮ ತ್ಯುನೆ ದ್ರೊಹಿ ವಂಶವಾಲಾ ವ್ಹೈ. <verse eid="EZK 12:2" /><verse number="3" style="v" sid="EZK 12:3" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಜಾ಼ವಾನೆ ಚಾಯೆ ಥಯಲ ಸಾಮ್ನೊ ಜಮಾ ಕರಿನ ಪಾಟೆ ತ್ಯುನಾ ಡೊಳಾ ಕ್ಹಾಮೊ ಜಾ಼, ಕದ್ಯಾಮ ತಾರಿ ರ‍್ಹವಾನಿ ಜ಼ಗಾ ಛೊಡಿನ ತ್ಯುನೆ ದೆಕೆ ನಿಂಗತ ಬಿಜಿಯಕ್ಕ ಜ಼ಗಾಯೆ ಜಾ಼; ತ್ಯುನೆ ದ್ರೊಹಿವಂಶವಾಲಾ ರ‍್ಹಯಾತಬಿ ಯಕ್ಕೆಳೆ ಮನಸಮಾ ಲಾವಾಸ. <verse eid="EZK 12:3" /><verse number="4" style="v" sid="EZK 12:4" />ತು ತಾರಾ ಸಾಮ್ನೊ ವರಿ ಜಾ಼ವಾನೆ ಚಾಯೆ ಥಯಲ ಸಾಮ್ನೊನೆ ಕೈನ ಪಾಟೆ ತ್ಯುನಾ ಡೊಳಾ ಕ್ಹಾಮೊ ಘರಮಾತೊ ಭಾರೊ ಘಾಲಿನ ಜಾ಼ವಾಲೊ ನಿಂಗತ ಕ್ಹಾಂಜೆ ತ್ಯುನಾ ಕ್ಹಾಮಾತೊ ಗೈಪಡ. <verse eid="EZK 12:4" /><verse number="5" style="v" sid="EZK 12:5" />ತ್ಯುನೆ ದೆಕ್ತಾಮಾ ತು ಗೊಡಿಮಾ ಭೊಕಾಡೊ ಕರಿನ ತಿಮಾತೊ ತಾರಾ ಸಾಮ್ನೊ ಲಿನ ಜಾ಼. <verse eid="EZK 12:5" /><verse number="6" style="v" sid="EZK 12:6" />ತ್ಯುನಾ ಡೊಳಾ ಕ್ಹಾಮೊ ತೆ ಕ್ಹಾಂದಾಪರ ಮ್ಹೆಲಿನ ಅಂದಾರಾಮಾ ಉಚೈಲಿನ ಜಾ಼; ಜಿಮಿನೆ ದೆಕ್ಯಾ ಬಗರ ತಾರು ಮ್ಹೊಡು ಝಾಕಿಲೆ; ಮಿ ತುನೆ ಇಸ್ರಾಯಲ ವಂಶವಾಲಾವೊನೆ ಯಕ್ಕ ಅಗಲ್ಯು ಗುರುತ ಥೈನ ಕರ‍್ಯೊಸ.<verse eid="EZK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 12:7" />ತೆಳಾಮಾ ಮಿ ಮನೆ ಥಯಲ ಅಪ್ಪಣೆ ಪೂರಾ ಕರ‍್ಯೊ; ಪಾಟೆ ಮಾರಾ ಸಾಮ್ನೊ ಮಿ ಜಾ಼ವಾನೆ ಚಾ಼ಯೆ ಥಯಲ ಸಾಮ್ನೊ ಘರಮಾತೊ ಭಾರೊ ಘಾಲಿನ ಕ್ಹಾಂಜೆ ಮಾರಾ ಹತ್ತಕ್ಹುಜ ಗೊಡಿನೆ ಭೊಕಾಡೊ ಕರಿನ ಅಂದಾರಾಮಾ ತೆ ಸಾಮ್ನೊ ಭಾರೊ ಘಾಲಿನ ತ್ಯುನಾ ಡೊಳಾ ಕ್ಹಾಮೊ ಕ್ಹಾಂದಾಪರ ಉಚೈಲಿನ ಗಯೊ. <verse eid="EZK 12:7" /><verse number="8" style="v" sid="EZK 12:8" />ಮರ್ನಾ ದಿನ್ನಾ ಪಾಟೆ ಯಹೊವಾ ಮನೆ ಆಂ ವಾತ ದಿದ್ಯೊ. <verse eid="EZK 12:8" /><verse number="9" style="v" sid="EZK 12:9" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಸು ಕರಾಡೊಸ ಕವಾನು ಇಸ್ರಾಯಲನಾ ದ್ರೊಹಿವಂಶವಾಲಾ ತ್ಯುನೆ ಪುಚ್ಯಾ ನತ್ತಿ ಸು? <verse eid="EZK 12:9" /><verse number="10" style="v" sid="EZK 12:10" />ತು ತ್ಯುನೊನೆ ಅಮ್ಮ ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಎ ಗಾಟ್ರು ಯೆರುಸಲೆಮನಾ ರ‍್ಹವಾನಾ ರಾಜ ಕುಮಾರೊನೆ ತ್ಯಾನಾ ಕ್ಹಾರಾ ಇಸ್ರಾಯಲ ವಂಶವಾಲೊವೊನೆಬಿ ಸಂಬಂದ ರ‍್ಹಯಲ ವ್ಹೈ. <verse eid="EZK 12:10" /><verse number="11" style="v" sid="EZK 12:11" />ತು ತ್ಯುನೊನೆ ಅಮ್ಮ ಕೆ: ಮಿ ತುಮೊನೆ ಯಕ್ಕ ಅಗು ಥಾವಾನು ವಳಕ ಥಯೊಸ. ಮಿ ಕರಲನಿಂಗತಜ಼ ತ್ಯುನೊನೆ ಥಾವಾಸ; ತ್ಯುನೆ ಗೈನ ಬಂಧಿಯೊ ಥಾವಸ. <verse eid="EZK 12:11" /><verse number="12" style="v" sid="EZK 12:12" />ತ್ಯುನೊಮಾನೊ ರಾಜ ಕುಮಾರ ಗೊಡಿಮಾ ಭೊಕಾಡೊ ಕರಿನ ಕ್ಹಾಂಜೆನಾ ಟೈಮಾ ತಿಮಾತೊ ಪಾರ ಥಾವಸ. ಮ್ಹೊಡು ಝಾಕಿಲಿವಸ ಜಿಮಿನ ತಿನೆ ದಿಕ್ಹ್ತಿ ಮನೈ. <verse eid="EZK 12:12" /><verse number="13" style="v" sid="EZK 12:13" />ತೆ ಚೂಕೈಲಿವಾನೆ ಕೊಶಿಶ ಕರಸ. ತೆನೈಸೊ, ಮಿ ತಿನೆ ಬಲಿ ನಾಕೊಸ . ತೆ ಮಾರಾ ಬಲಿಮಾ ಪಡಸ. ಮಿ ತಿನೆ ಕಸ್ದಿಯವಾಲಾವೊನು ದೆಶ ಥಯಲ ಬಾಬಿಲೊನನೆ ಲೌಸ. ತೆ ತೆ ದೆಶ ದೆಕ್ತೊ ನೈ; ತೆನೈಸೊ ತೆ ತ್ಯಾ ಮರಸ. <verse eid="EZK 12:13" /><verse number="14" style="v" sid="EZK 12:14" />ತಿನಾ ಸುತ್ತೆಬಿ ರ‍್ಹಯಲವಾಲಾ ಕ್ಹಾರಾವೊನೆ ಮಿ ಸುತ್ತೆ ಮುತ್ತ ರ‍್ಹಯಲ ದೆಶೊನೆ ನ್ಹಾಟಾಡಿ ಪಡುಸ. ತಿನಾ ಕಾಮವಾಲಾವೊನೆ ವರಿ ತಿನಿ ಸೈನ್ಯನೆ ವಾರಾ ನಿಂಗತ ತುರಿಪಡುಸ. ವರಿ ತ್ಯುನೊನೆ ತಲ್ವಾರ ಬಿಸುಸ.<verse eid="EZK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 12:15" />ಮಿ ತ್ಯುನೊನೆ ಜನಾಂಗೊನಾ ವಚ್ಮಾ ಭಿಕ್ಹರೈ ಪಡ್ಯೊಸ ವರಿ ಬಿಜಾ಼ ದೆಶೊನೆ ನ್ಹಾಟಾಡ್ಯೊಸ. ಮಿಜ ಯಹೊವಾ ವ್ಹೈಕೈನ ತೆಳಾಮಾ ಮನಕ್ಹೊ ತಿಳ್ದಿಲಿಸ <verse eid="EZK 12:15" /><verse number="16" style="v" sid="EZK 12:16" />ತೆನೈಸೊ ಮಿ ತ್ಯುನಾಮಾ ದಕ್ಹಾ ಜನಾವೊನೆ ಯುದ್ದಕಹುಬಿ, ಬರಗಾಲಕ್ಹುಬಿ ವರಿ ರೊಗೊಕ್ಹುಬಿ ವಚಾ಼ಡುಸ. ತ್ಯುನೆ ಜಾ಼ವಾನಾ ದೆಶೊನಾ ಮನಕ್ಹೊನೆ ತ್ಯುನೆ ಕರಾನಾ ಅಸೈಂಯೊನಿ ಪದ್ದತೊನಾಹುತಿ ಕಯೆ ನಿಂಗತ ಮಿ ಎ ಕರುಸ. ಮಿಜ ಯಹೊವಾ ವ್ಹೈಕೈನ ತೆಳಾಮಾ ತ್ಯುನೆ ತಿಳ್ದಿಲಿವಸ.<verse eid="EZK 12:16" /></para>
  <para style="s">ಕಾಪಾಲೊ ಪ್ರವಾದಿ ವಳಕ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 12:17" />ತೆಳಾಮಾ ಯಹೊವಾ ಮನೆ ವಾಕ್ಯಾ ದಿದ್ಯೊ. ತೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ, <verse eid="EZK 12:17" /><verse number="18" style="v" sid="EZK 12:18" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ತ್ರಾಸಮಾ ಛೆ ಕೈನ ನಾಟಕ ಕರು. ತು ಅನ್ನ ಲೆತಾಮಾ ಕಾಪು ವರಿ ಹಲ್ಲು. ಪಾನಿ ಪಿತಾಮಾ ಬುಚ್ಕು ವರಿ ಚಿಂತಾ ಕರು. <verse eid="EZK 12:18" /><verse number="19" style="v" sid="EZK 12:19" />ಎ ತು ಸಾಮಾನ್ಯ ಮನಕ್ಹೊನೆ ತಿಳಸೌ. ತು ಅಮ್ಮ ಕೌ, ‘ಹಜುನ ಇಸ್ರಾಯಲ ದೆಶಮಾ ರ‍್ಹಯಲವಾಲಾ ಯೆರುಸಲೆಮಾ ರ‍್ಹಯಲವಾಲಾವೊನಾಹುತಿ ಅಪ್ನೊ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ: ತ್ಯುನೆ ಕ್ಹಾತಾ ಟೆಮಾ ಬುಚ್ಕಿನ; ತ್ಯುನೆ ಪಿತಾ ಟೆಮಾ ಬುಚ್ಕಿನ ರ‍್ಹವಸ. ಕಾ ಕದ್ಯಾಮ ತ್ಯಾ ರ‍್ಹವಾಲಾ ಕ್ಹಾರಾ ಜನಾ ಹಿಂಸಾ ಕರಾಲಾ ಥಯಾಸ. ತ್ಯುನಾ ದೆಶಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರು ನಾಶ ಥಾವಸ ವರಿ ತೆ ದೆಶ ಹಾಳ ಪಡಿಜಾ಼ವಸ. <verse eid="EZK 12:19" /><verse number="20" style="v" sid="EZK 12:20" />ಮನಕ್ಹೊ ರ‍್ಹಯಲ ಗಾಮೊ ನಾಶ ಥಾವಸ; ಪೂರಾ ದೆಶಜ ನಾಶ ಥಾವಸ. ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತೆಳಾಮಾ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ.”<verse eid="EZK 12:20" /></para>
  <para style="s">ಮನಕ್ಹೊನೆ ಮೈಯಾ ರ‍್ಹಯಲ ಗಾದೆ ವರಿ ಪ್ರಸಿದ್ದ ನೈಸೊ ಸಂದೆಶ</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 12:21" />ಪಾಚಲ್ತೊ ಯಹೊವಾ ಮನೆ ಆಂ ವಾಕ್ಯಾ ದಿದ್ಯೊ. ತೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ, <verse eid="EZK 12:21" /><verse number="22" style="v" sid="EZK 12:22" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ‘ಟೈಮ ಚಾ಼ಲ್ಯೊಸ. ಕ್ಹಾರಾ ದರ್ಶನೊ ಪೂರಾ ನೈ ಥಾತಾ’ ಕೈನ ಇಸ್ರಾಯಲ ದೆಶವಾಲಾ ಕೈಲಿವಾನು ಆಂ ವಾತ ಸುವೈ? <verse eid="EZK 12:22" /><verse number="23" style="v" sid="EZK 12:23" />ತೆ ಮನಕ್ಹನೆ ಅಮ್ಮ ಕೆ: ತ್ಯನೊ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ: ಮಿ ಎ ವಾತನೆ ಅಂತ್ಯ ಆವಾಲಗಾಡುಸ. ಇಸ್ರಾಯಲೊನಿ ತೆ ವಾತ ತ್ಯುನೆ ಹಬ್ದಾ ಕೆಳಾಮಾಬಿ ಕತಾ ನೈ. ತಿನಾ ಬದಲ ತ್ಯುನೊನೆ ಅಮ್ಮ ಕೆ: ಟೈಮ ನಜಿಕ ಆಯಾಸ; ಹರಿಯಕ್ಕ ದರ್ಶನ ಪೂರಾ ಥಾವಸ. <verse eid="EZK 12:23" /><verse number="24" style="v" sid="EZK 12:24" />ಇಸ್ರಾಯಲೊಮಾ ಇತ್ತಿ ಉಪ್ಪರ ದರ್ಶನೊ ರ‍್ಹತಾಜ ನೈ; ಮೊಸ ಕರಾನಿ ಕಣಿ ರ‍್ಹತಿಜ ನೈ. <verse eid="EZK 12:24" /><verse number="25" style="v" sid="EZK 12:25" />ಕಾ ಕದ್ಯಾಮ ಮಿಜ ಯಹೊವಾ ವ್ಹೈ. ಮಿ ಕವಾನುಜ಼ ಕೌಸ ವರಿ ತೆ ಸಂಗತಿ ಪೂರಾ ಥಾವಸ. ತಿನೆ ಘನೊ ಟೈಮ ನೈ ಚಾಯೆ ಥಾತೊ ತೆ ತ್ರಾಸೊ ಘನ್ನಾ ಜಲ್ದಿ ಆವಸ; ತುಮಾರಾ ಜಿವಮಾನ ಕಾಲಮಾಜ ಆವಸ. ಎ ದ್ರೊಹಿಯೊ ಥಯಲ ಮನಕ್ಹೊ, ಮಿ ಯಕ್ಕ ವಿಷಯಮಾ ಕದ್ಯೊರೆ ತೆ ವಿಷಯ ಪೂರಾ ಥಾಯೆ ನಿಂಗತ ಕರುಸ.” ಮಾರಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಎ ಕದ್ಯೊ.<verse eid="EZK 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 12:26" />ವರಿ ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ. ತೆ ಸು ಕದ್ಯೊ ಕದ್ಯಾಮ, <verse eid="EZK 12:26" /><verse number="27" style="v" sid="EZK 12:27" />ಮನಕ್ಹನ ದಿಕ್ರಾ, ತುನೆ ಮಿ ದಿದಲ ದರ್ಶನೊನಾಹುತಿ ಘನೊ ಟೈಮ ಥಯಲ್ಪರ ತೆ ಪೂರಾ ಥಾವಸ ಘನ್ನಾ ದಿನೊ ಥಯಲ್ಪರ ಥಾವಾನು ಹಮ್ನಾಜ಼ ಥಾವಸ ಕಯನ ಕವಸ ಕೈನ ಇಸ್ರಾಯಲನಾ ಮನಕ್ಹೊ ತಿಳ್ದಿಲಿವಾಡಾಸ. <verse eid="EZK 12:27" /><verse number="28" style="v" sid="EZK 12:28" />ತಿನಾಹುತಿ ತು ತ್ಯುನೊನೆ ಆಂ ವಿಷಯ ತಿಳ್ಸಾ, ಮಾರೊ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ: ಸು ವೈ ಕದ್ಯಾಮ ಮಿ ಹಜುನ ಘನೊ ತಡಾ ನೈ ಕರ್ತೊ. ಮಿ ಯಕ್ಕ ವಿಷಯ ಪೂರಾ ಥಾವಸ ಕೈನ ಕದ್ಯೊಮ ತೆ ಕ್ಹರಿಬಿ ಪೂರಾ ಥಾವಸ.” ಎ ಮಾರೊ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿಯೊ ವಾತೊ ವ್ಹೈ.<verse eid="EZK 12:28" /></para>
  <chapter eid="EZK 12" />
  <chapter number="13" style="c" sid="EZK 13" />
  <para style="s">ಸುಳ್ಳ ದಾಣಗೊ ಪ್ರವಾದಿಯೊನಾ ವಿರುದ್ದ ಭವಿಶ್ಯವಾಣಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 13:1" />ಯಹೊವಾ ಆಂ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 13:1" /><verse number="2" style="v" sid="EZK 13:2" />"ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಕೈನ ಕ್ಹರಿ ಥಯಲನೆ ಕತಾಮಾ ಇಸ್ರಾಯಲೊನಾ ಪ್ರವಾದಿಯೊನೆ ತು ಪ್ರವಾದನೆ ದೆತಾಮ ಅಮ್ಮ ಕೆ ಯಹೊವಾನಿ ವಾಕ್ಯಾ ಐಕೊ, <verse eid="EZK 13:2" /><verse number="3" style="v" sid="EZK 13:3" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಕಯುಬಿ ಚಮತ್ಕಾರ ನೈಸೊ ಸ್ವಂತ ಬುಧ್ಧಿನೆ ಪೂರಾ ಕರಾನಿ ಮುರ್ಖ ಪ್ರವಾದಿಯೊನಾ ಗತಿ ಸು ಕೌ! <verse eid="EZK 13:3" /><verse number="4" style="v" sid="EZK 13:4" />ಇಸ್ರಾಯಲೊ ತುಮಾರಾ ಪ್ರವಾದಿಯೊ ಹಾಳು ಪ್ರದೆಶೊಮಾ ನರಿಯೊ ನಿಂಗತ ಛೆ. <verse eid="EZK 13:4" /><verse number="5" style="v" sid="EZK 13:5" />ಯಹೊವಾನಾ ದಿನ್ನಮಾ ಯುದ್ದನೆ ಹುಬ್ರೌ ಕೈನ ತುಮೆ ಪೌಳಿನಾ ಒಡುಕುವೊನಾ ಛೌಲಿಮಾ, ಇಸ್ರಾಯಲ ವಂಶನಿ ರಕ್ಷಣೆನಾಹುತಿ ಗೊಡಿಬಿ ಘಟ್ಟ ಕರ‍್ಯಾ ನತ್ತಿ. <verse eid="EZK 13:5" /><verse number="6" style="v" sid="EZK 13:6" />ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಕೈನ ಕವಾಲಾವೊನೆ ಥಯಲ ದರ್ಶನ ಮಿಥ್ಯ, ಐಕಲ ಕಣಿ ಸುಳ್ಳ ವ್ಹೈ; ಯಹೊವಾ ತ್ಯುನೊನೆ ವಳಾಯೊ ನೈ, ತ್ಯುನೆ ಕದಲ ವಾತೊ ಕ್ಹರಿ ಥಾವಸ ಕೈನ ಗಪ್ಪ ಚುಪ್ಪ ನಿರಿಕ್ಷಾ ಕರಲಿದಾಸ. <verse eid="EZK 13:6" /><verse number="7" style="v" sid="EZK 13:7" />ಮಿ ಬೊಲ್ಯಾವಾಚಿ ರ‍್ಹೈತುಬಿ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಕವಾಲಾ ತುಮೊನೆ ಥಯಲ ದರ್ಶನಬಿ ಮಿಥ್ಯ, ತುಮೆ ಕದಲ ಕಣಿ ಸುಳ್ಳ ವ್ಹೈ.<verse eid="EZK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 13:8" />ಅಮ್ಮ ರ‍್ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ - ತುಮೆ ವ್ಯರ್ಥ ಥಯಲ ಕೈನ ಸುಳ್ಳ ರ‍್ಹಯಲ ಕಂಡ ಧರಲಕ್ಹು ಹಮ್ನಾ, ತುಮೊನೆ ವಿರುದ್ದ ಥಯೊಸ, ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಕೈನ ಮಾರಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 13:8" /><verse number="9" style="v" sid="EZK 13:9" />ಮಿಥ್ಯಾ ದರ್ಶನ ಹೊಂದಿನ ಸುಳ್ಳ ಕಣಿ ಕವಾಲಾ ಪ್ರವಾದಿಯೊನಾ ಉಪ್ಪ ಮಿ ಹತ್ತ ಕರುಸ; ತ್ಯುನೆ ಮಾರಾ ಮನಕ್ಹೊನಾ ಮ್ಹೊಟಾವೊನಿ ಸಭೆಮಾ ಸೆರು ನೈ, ಇಸ್ರಾಯಲ ವಂಶನಾ ಪಟ್ಟಿಮಾ ತ್ಯುನಾ ನಾಮೊ ಬರದಲ ರ‍್ಹವಸ, ತ್ಯುನೆ ಇಸ್ರಾಯಲ ದೆಶಮಾ ಮ್ಹೈ ಔಬಿ ನೈ; ಮಿಜ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ;<verse eid="EZK 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 13:10" />ಕ್ಷೆಮ ನೈ ರ್ಹೈತಬಿ ತ್ಯುನೆ ಕ್ಷಮ ಕೈನ ಮಾರಾ ಮನಕ್ಹೊಮಾ ನಕೊ ಕದ್ಯಾಸ ತೊ. ಯಕ್ಲೊ ಪಾತಳಿ ರ‍್ಹಯಲ ಗೊಡಿಬಿ ಭಾಂದ್ಯಾರೆ, ಹಮ್ನಾ ತಿನೆ ಚುನ್ನೊ ಲಗಾಡಸ. <verse eid="EZK 13:10" /><verse number="11" style="v" sid="EZK 13:11" />ತೆನೈಸೊ ತು ಚುನ್ನೊ ಲಗಾಡಾವಾಲಾವೊನೆ ಅಮ್ಮ ಕೆ ಘನ್ನು ಜೊ಼ರ ಪಾನಿ ಐನ ಗೊಡಿಬಿ ಪಡಿಜಾ಼ವಸ, ಬರ್ಪೊ ಪಡಸ; ಜೊ಼ರ ವಾರೊ ಗೊಡಿನಿ ಪಾಡಿಪಡಸ; <verse eid="EZK 13:11" /><verse number="12" style="v" sid="EZK 13:12" />ಹಮ್ನಾ, ಗೊಡಿ ಪಡಲ್ಪರ ತುಮೆ ಚುನ್ನೊ ಲಗಾಡಲ ಕಿಜಾ಼ ಛೆ ಕೈನ ತುಮೊನೆ ಪುಚ್ಚಸಕಸ! <verse eid="EZK 13:12" /><verse number="13" style="v" sid="EZK 13:13" />ಇಮ್ಮ ರxಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮನೆ ಸಿಟ್ಟ ಐನ ಜೊ಼ರ ವಾರಾಕ್ಹು ಗೊಡಿನೆ ತೊಡಿಪಡುಸ; ತಿನೆ ನಾಶಕರಾನೆ ಮಾರಿ ಶಿಟ್ಟಕ್ಹು ಜೊ಼ರ ಪಾನಿ ಆವಸ, ವರಿ ಘನ್ನಿ ಶಿಟ್ಟಕ್ಹು ಬರ್ಪೊ ಪಡಸ; <verse eid="EZK 13:13" /><verse number="14" style="v" sid="EZK 13:14" />ತು ಮೆ ಚುನ್ನೊ ಲಗಾಡಲ ಗೊಡಿನೆ ಮಿ ಅಮ್ಮ ಪಾಡಿನ ಜಿಮಿನಾ ಸಮಾ ಕರಿನ ತಿನು ಅಸ್ತಿವಾರನೆ ಬೈಲು ಕರುಸ ತೆ ಪಡಿಜಾ಼ವಸ, ವರಿ ತುಮೆ ತಿಮಾ ಕ್ಹಾಪ್ಡಿನ ನಾಶ ಥಾವೊಸಿ; ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 13:15" />ಅಮ್ಮ ಮಿ ಗೊಡಿಮಾಬಿ ವರಿ ತುಮೊಮಾಬಿ ತಿನೆ ಚುನ್ನೊ ಲಗಾಡಲ ತುಮೊಮಾಬಿ ಶಿಟ್ಟ ತಿರ್ಸಿಲಿನ ಅಮ್ಮ ಕೌಸ ಗೊಡಿಬಿ ನತ್ತಿ ತಿನೆ ಚುನ್ನೊ ಲಗಾಡಾಲಾಬಿ ನತ್ತಿ. <verse eid="EZK 13:15" /><verse number="16" style="v" sid="EZK 13:16" />ಇಸ್ರಾಯಲನಾ ಪ್ರವಾದಿಯೊ, ಮಾಫಿ ನೈ ರ‍್ಹೈತಬಿ ಮಾಫಿ ಥಾವಸ ಕೈನ ದರ್ಶನೊ ಕರಿನ ತುಮೆ ಯೆರುಸಲೆಮನಾ ಹುತಿ ತುಮೆ ಕದ್ಯಾಸತೊ; ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 13:16" /></para>
  <para style="s">ಹೆಣ್ಣ ಸುಳ್ಳ ಪ್ರವಾದಿಯೊನಿಯೊನಾ ಹುತಿ ಭವಿಶ್ಯವಾಣಿ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 13:17" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಸ್ವಂತ ವಿಚಾರ ಕರಲ ತಿಳಸೈನ ಕವಾನು ತಾರಾ ಸ್ವಂತ ಕುಲನಾ ಹೆಣ್ಣ ಮನಕ್ಹೊನಾ ಕ್ಹಾಮೊ ಮ್ಹೊಡು ಕರಿನ ತ್ಯುನೊನೆ ಮ್ಹೊಟಿ ಅವಾಜಮಾ ಅಮ್ಮ ಕೆ. <verse eid="EZK 13:17" /><verse number="18" style="v" sid="EZK 13:18" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮನಕ್ಹೊನಾ ಜಲಮನೆ ಸಿಕಾರ ಕರುಕೈನ ಕ್ಹಾರಾವೊನಾ ರಟ್ಟಾವೊನೆ ತಾವಿಜೊ ಭಾಂದಿನ ಲಾಂಬಾ ರ‍್ಹಯವಾಲಾವೊನೆಬಿ ವರಿ ಗಿಡ್ಡಾ ರ‍್ಹಯಲವಾಲಾವೊನೆಬಿ ತಿನಾ ತಕ್ಕ ಮಸುಕೊನೆ ತಯ್ಯಾರ ಕರಲ ಹೆಣ್ಣ ಮನಕ್ಹೊನು ಗತಿ ಸು ಕೌ! ಹೆಣ್ಣ ಮನಕ್ಹೊ ತುಮೆ ಮಾರಾ ಮನಕ್ಹೊನಾ ಜಲಮನೆ ಸಿಕಾರ ಕರಿನ ಸ್ವಂತ ಜಲಮನೆ ವಚಾ಼ಡಿಲಿವೊಶಿ? ವಚಾ಼ಡಿಲಿವೊಸಿ? <verse eid="EZK 13:18" /><verse number="19" style="v" sid="EZK 13:19" />ತುಮೆ ಜವೆಘೌಂನಾ ದಾನಾವೊನೆ ರೊಕ್ಲಾನಾ ತುಕ್ಡಾವೊನೆ ಆಸಕರಿನ ಸುಳ್ಳವಾತೆ ಕಾನ ದಿವಾಲಾ ಮಾರಾ ಮನಕ್ಹೊನೆ ಸುಳ್ಳ ಕವಾಕ್ಹು ನೈ ಮರಾಲಾವೊನೆ ಮರಾಡಿನ ಮರಾವಾಲಾವೊನೆ ಉಗ್ರಾಡಿನ ಮಾರಾ ಮನಕ್ಹೊನಾ ವಚ್ಮಾ ಮಾರಾ ಘನತೆನೆ ಕುಂದಿನ ಲಾಯಾಸ.<verse eid="EZK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 13:20" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಆಹಾ, ತುಮೆ ಮನಕ್ಹೊನಾ ಜಲಮನೆ ಪಕ್ಷಿಯೊನಿಂಗತ ಸಿಕಾರ ಕರಾನಾಹುತಿ ಸಾಧನ ಥಯಲ ತುಮಾರಾ ತಾವಿಜೊನೆ ಮಿ ಹೆಸಿನ ತಿನೆ ತುಮಾರಾ ಹತೊಮಾತೊ ಕಿತ್ತಿಪಡುಸ; ತುಮೆ ಪಕ್ಷಿಯೊನಾ ನಿಂಗತ ಸಿಕಾರ ಕರಾನು ಜಲಮನೆ ಮಿ ಛೊಡಾವಾಲಗಾಡುಸ. <verse eid="EZK 13:20" /><verse number="21" style="v" sid="EZK 13:21" />ಮಿತುಮಾರಾ ಮಸಕೊನೆ ಫಾಡಿನ ಮಾರಾ ಮನಕ್ಹೊನೆ ತುಮಾರಾ ಹತೊಮಾತೊ ತಪ್ಸಾಡುಸ; ತ್ಯುನೆ ಅಪರ್ತಾತುಮಾರಾ ಹತೊಮಾ ಸಿಕಾರ ಥಾವಾನೆ ಮಳ್ತಾ ನೈ; ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 13:22" />ಮಿ ನಿರಾಸ ಕರಲ ಶಿಶ್ಯಾನಾ ಮನಸನೆ ತುಮೆ ಸುಳ್ಳ ಕೈನ ಕುಂದಿಸಲಕ್ಹು ದುಷ್ಟ ತಿನಾ ಕೆಟ್ಟ ವಾಟೊನೆ ಛೊಡಿನ ತಿನೊ ಜಲಮ ವಚಾ಼ಡಿಲಿವಾನಾಹುತಿ ತುಮೆ ತಿನಾ ಹತೊನೆ ತಾಕತ ದಿದಲಕ್ಹು <verse eid="EZK 13:22" /><verse number="23" style="v" sid="EZK 13:23" />ತುಮೆ ಮಿಥ್ಯಾ ದರ್ಶನ ಕರಿನ ತಿಳಸೈನ ಕವಾನು ಕಾಮ ಹಜಿ ಚಾಲ್ತುಜ ನೈ; ಮಾರಾ ಮನಕ್ಹೊ ತುಮಾರಾ ಹತೊಮಾತಾ ತಪ್ಸಾಡುಸ; ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 13:23" /></para>
  <chapter eid="EZK 13" />
  <chapter number="14" style="c" sid="EZK 14" />
  <para style="s">ಕ್ಹುದಾ ಮೊರ್ತಿಯೊನೆ ಆರಾಧನಾಖಂಡನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 14:1" />ಇಸ್ರಾಯಲನಾ ಮ್ಹೊಟಾ ಮನಕ್ಹೊಮಾ ದಕ್ಹಾಜ಼ನಾ ಐನ ಮಾರಾ ಕ್ಹಾಮಾ ಬೈಟ್ತಾಮಾ <verse eid="EZK 14:1" /><verse number="2" style="v" sid="EZK 14:2" />ಯಹೊವಾ ಆಂ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 14:2" /><verse number="3" style="v" sid="EZK 14:3" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಇವ್ನೆ ತ್ಯುನಾ ಗೊಂಬಿಯೊನೆ ಮನಸೊಮಾ ಸ್ಹೆಂ ಕರಲಿನ ತ್ಯುನೊನೆ ಪಾಪಕಾರಿ ಥಯಲ ವಿಘ್ನನೆ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಮ್ಹೆಲ್ಲಿದ್ಯಾಸ; ಹವಾವೊನೆ ಮಿ ಕ್ಹುದಾನು ಉತ್ತರ ದಿವಾನು ಯುಕ್ತಬಿ?<verse eid="EZK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 14:4" />ತಿನಾಹುತಿ ತು ತ್ಯುನೊನೆ ತಿಳಸೈನ ಅಮ್ಮ ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಇಸ್ರಾಯಲ ವಂಶಮಾ ಕಯು ಕಯೊ ತ್ಯುನಾ ಗೊಂಬಿಯೊನೆ ಮನಸಮಾ ಸ್ಹೆಂ ಕರಲಿನ ತ್ಯುನೊನೆ ಪಾಪಕಾರಿ ಥಯಲ ವಿಘ್ನನೆ ತ್ಯುನಾ ಕ್ಹಾಮಾ ಮ್ಹೆಲ್ಲಿನ ಪ್ರವಾದಿ ಪ್ರಶ್ನೆ ಪುಚ್ಚಾನೆ ಆವಸ ತೆ ಪಾತಕಕನೆ ಕದ್ಯಾರೆ ತಿನಾ ಹಿಸಾಬ ನೈ ರ‍್ಹಯಲ ಗೊಂಬಿಯೊನಾ ನಿಂಗತ ಯಹೊವಾ ಥಯಲ ಮಿ ತಿನೆ ಉತ್ತರ ದ್ಯುಸ; <verse eid="EZK 14:4" /><verse number="5" style="v" sid="EZK 14:5" />ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ ಕ್ಹಾರಾ ತ್ಯುನಾ ಗೊಂಬಿಯೊನಾ ನಿಮಿತ್ತ ಮನೆ ತೊರದಲಕ್ಹು ಮಿ ತ್ಯುನೊನೆ ಕ್ಹಾರಾಜನಾವೊನೆ ತ್ಯುನಾ ಆಶಾಪಾಶಮಾ ಕ್ಹಾಪಡೈನ ಧರಸ <verse eid="EZK 14:5" /><verse number="6" style="v" sid="EZK 14:6" />ತೆ ಥಯಲ್ಪರ ತು ಇಸ್ರಾಯಲ ಮನಕ್ಹೊನೆ ಅಮ್ಮ ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಕವಸ. <verse eid="EZK 14:6" /><verse number="7" style="v" sid="EZK 14:7" />ತುಮೆ ತುಮಾರಾ ಗೊಂಬಿಯೊನೆ ಛೊಡಿನ ಪಾಚಾ಼ ಸರ್ಕಿನ ಪಾಚಾ಼ ಫರಿನ, ತುಮಾರಾ ಕ್ಹಾರಾ ಸಾಮ್ನೊನೆ ಕನ ಪಿಟ್ಟ ಕರೊ. <verse eid="EZK 14:7" /><verse number="8" style="v" sid="EZK 14:8" />ತಿನಾ ಉಪ್ಪರ ಘನ್ನಿ ಶಿಟ್ಟ ಐನ ತಿನೆ ಗತಿನೆ ಬೆರಗಿನೆ ಹುಶಾಕಿನಾ ವಾತೊನೆ ವಡಪೊನೆ ಇಡ ಕರಿನ ತಿನೆ ಮಾರಾ ಮನಕ್ಹೊಮಾತೊ ಕಿತ್ತಿನ ಘಾಲುಸ; ಅಮ್ಮ ಮಿ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 14:9" />ಯಕ್ಲೊ ಪ್ರವಾದಿ ಉಸುಮಾ ಕ್ಹುದಾನಾ ವಾತೊ ಕದ್ಯಾರೆ ತೆ ಪ್ರವಾದಿನೆ ಮರಳಮಾ ಘಾಲಲವಾಲಾನೆ ಯಹೊವಾ ಥಯಲ ಮಿಜ; ಮಿ ತಿನಾ ಉಪ್ಪರ ಹತ್ತ ಉಚೈನ ಇಸ್ರಯಲೊ ಥಯಲ ಮಾರಾ ಮನಕ್ಹೊಮಾತೊ ತಿನೆ ಕಿತ್ತಿನ ನಾಮ ನೈಸೊ ಕರುಸ. <verse eid="EZK 14:9" /><verse number="10" style="v" sid="EZK 14:10" />ಪ್ರವಾದಿನು ದೊಷ ಕೆಕ್ಲೊ ತಿನೆ ಪ್ರಶ್ನೆ ಪುಚ್ಚಾಲೊ ದೊಷ ತೆಕ್ಲೊ; ಕ್ಹುಶಿವಾಲಾ ತ್ಯುನಾ ತ್ಯುನಾ ದೊಷ ಫಲನೆ ಅನುಭವಕರಸ. <verse eid="EZK 14:10" /><verse number="11" style="v" sid="EZK 14:11" />ಅಮ್ಮ ರ‍್ಹಯಾಮ ಇಸ್ರಯಲ ವಂಶವಾಲಾ ಹಜಿನ ಮನೆ ತೊರೆದಸ, ತ್ಯುನಾ ಲೆಕ್ಕಾ ನೈಸೊ ದೊಷಕ್ಹು ಅಪ್ನೊನೆ ಹೊಲೆಕರಸ; ತ್ಯುನೆ ಮನೆ ಪ್ರಜೆ ಥಾವಸ, ಮಿ ತ್ಯುನೊನೆ ಕ್ಹುದಾ ಥಯಲ ರ‍್ಹಸ, ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 14:11" /></para>
  <para style="s">ನೊಹಾ ದಾನಿಯಲ ವರಿ ಯೊಬ</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 14:12" />ವರಿ ಯಹೊವಾ ಆಂ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 14:12" /><verse number="13" style="v" sid="EZK 14:13" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಅಪಾರಾದ ಕರಿನ ಮನೆ ವಿರುದ್ದ ಥೈನ ಪಾಪ ಕರಲ ದೆಶನಾ ಉಪ್ಪರ ಮಿ ಹತ್ತ ಉಚೈನ ತ್ಯುನು ಅನಾಜ ಬಂದಕರೈನ ಕಾಡಿನ ಕ್ಷಾಮನೆ ಆವಾಲಗಾಡಿನ ಮನಕ್ಹೊ ಜಾ಼ನವರೊನೆ ತಿಮಾತೊ ನಿರ್ಮೂಲ ಕರಾನಾ ಪಕ್ಷಮಾ <verse eid="EZK 14:13" /><verse number="14" style="v" sid="EZK 14:14" />ನೊಹಾ, ದಾನಿಯಲ, ಯೊಬ ಕೈನ ತನ್ನೆ ಜನಾ ದಾಣ್ಗಾ ತ್ಯಾ ವ್ಹತ್ತಾ ತ್ಯುನಾ ಸದಾಚಾರಕ್ಹು ಸ್ವಂತ ಜಲಮ ವಚಾ಼ಡಿ ಲೆತಾತಾ; ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 14:15" />ಮಾರಿ ಆಗನ್ಯಾನಾಹುತಿ ದುಷ್ಟ ಗೆಂಡಾ ಮೃಗಾವೊ ದೆಶಮಾ ಫರಿನ ತಿನೆ ನಿರ್ಜನ ಕರಿನ ಹಾಳ ಕರಿನ ಕುನಬಿ ದಾಟಿನ ನೈ ಜೌ಼ ಕೈನ ಬುಚ್ಕಾಡಾನಾ ಪಕ್ಷಮಾ <verse eid="EZK 14:15" /><verse number="16" style="v" sid="EZK 14:16" />ಆಂ ತನ್ನೆಜನಾ ದಾಣ್ಗಾ ತಿಮಾ ವ್ಹತ್ತಾ ಮಾರೊ ಜಲಮ ತುಮೆ ಉಗ್ರ್ಯಾತಬಿ ನೈತೊ ತುಮಾರಾ ಗಂಡ ಬಚ್ಚಾವೊನೆ ರ‍್ಹವಾದೆ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ರ‍್ಹವಾದೆ ನೈ ವಚಾ಼ಡಿ ಲೆತಾತಾ; ದೆಶಬಿ ಹಾಳ ಥೈನ ಜಾ಼ವಸ; ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 14:16" /><verse number="17" style="v" sid="EZK 14:17" />ನೈತೊ ತಲ್ವಾರಜ, ದೆಶಮಾ ಹೊಕ್ಕಿನ ಜೌ಼ ಕೈನ ಆಗನ್ಯಾ ದಿನ ಮಿ ತಿನೆ ತೆ ದೆಶನೆ ಲೈನ ಮನಕ್ಹೊ ವರಿ ಜಾನವರೊನೆ ತಿಮಾತೊ ಕಲಾಸ ಕರಾನಾ ಪಕ್ಷಮಾ <verse eid="EZK 14:17" /><verse number="18" style="v" sid="EZK 14:18" />ಆಂ ತನ್ನೆ ಜನಾ ದಾಣ್ಗಾ ತಿಮಾ ಮಆರೊ ಜಲಮ, ತುಮೆ ಉಗ್ರ್ಯಾಮ ನೈತೊ ತುಮಾರಾ ಗಂಡ ಬಚ್ಚಾವೊನೆ ರ‍್ಹವಾದೆ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ರ‍್ಹವಾದೆ ನೈ ವಚಾ಼ಡಿ ಲೆತಾತಾ; ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 14:18" /><verse number="19" style="v" sid="EZK 14:19" />ನೈತೊ ಮಿ ತೆ ದೆಶನಾ ಉಪ್ಪರ ಮಾರಿ ಶಿಟ್ಟ ತಿನಾ ಉಪ್ಪರ ಶಿಟ್ಟನೆ ಲೈನ ರಗತ ಚುವೈನ ತ್ರಾಸ ವಳೈನ ಮನಕ್ಹೊನೆ ವರಿ ಜಾನರೊನೆ ಕಲಾಸ ಕರಾನಾ ಪಕ್ಷಮಾ <verse eid="EZK 14:19" /><verse number="20" style="v" sid="EZK 14:20" />ನೊಹಾ ದನಿಯಲ ಯೊಬ ಕವಾಲಾ ತಿಮಾ ವ್ಹತ್ತಾ ಮಾರೊ ಜಲಮ, ತ್ಯುನಾ ಸದಚಾರಕ್ಹು ಸ್ವಂತ ಜಲಮೊನೆ ವಚಾ಼ಡಿ ಲಿದ್ಯಾರೆ ನೈತೊ ತುಮಾರಾ ಗಂಡ ಬಚ್ಚಾವೊನೆ ರ‍್ಹವಾದೆ ಹೆಣ್ಣ ಬಚ್ಚವೊನೆ ರ‍್ಹವಾದೆ ವಚಾ಼ಡಿ ಲೆತಾ ನ್ಹೊತಾ; ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ <verse eid="EZK 14:20" /><verse number="21" style="v" sid="EZK 14:21" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಿ ತಲ್ವಾರ ಕ್ಷಾಮ ದುಷ್ಟ ಮೃಗೊ ವ್ಯಾದಿ ಕವಾಲಾ ಚಾರೆ ತ್ರಾಸೊನೆ ಯರುಸಲೆಮನಾ ಕ್ಹಾತೆಜ ಲೈನ ಮನಕ್ಹೊನೆ ವರಿ ಜಾನವರೊನೆ ಕಲಾಸ ಕರ್ತಾಮಾ ಕೆ ಸಕಸಿ! <verse eid="EZK 14:21" /><verse number="22" style="v" sid="EZK 14:22" />ತೆನೈಸೊ ಬಾಕ್ಡಿಯೊ ದಾಣ್ಗಾವೊಮಾ ದಕ್ಹಾಜನಾ ಕಿಮ್ಮ ತಪ್ಸಿಲಿದ್ಯಾ ಉಗ್ರಿನ ತ್ಯಾಂತಾ ಲಿನ ಜಾ಼ವಸ; ಆಹಾ, ತ್ಯುನೆ ತುಮೊಕನೈನ ಸೆರಲ್ಪರ ತುಮೆ ತ್ಯುನಾ ಕೆಟ್ಟವಾಟೊ ಅಧ್ಬುತಕಾಮೊನೆ ದೆಕಿನ ಮಿ ಯರುಸಲೆಮನಾ ಉಪ್ಪರ ಆವಾಲಗಾಡಲ ತ್ರಾಸನಾ ವಿಷಯಮಾ, ತಿನೆ ಉಂಟಕರಲ ಕ್ಹಾರಾ ತ್ರಾಸೊನಾ ವಿಷಯಮಾ ಸಮಾಧಾನ ಹೊಂದೊಸಿ. <verse eid="EZK 14:22" /><verse number="23" style="v" sid="EZK 14:23" />ತುಮೆ ತ್ಯುನಾ ಕೆಟ್ಟ ವಾಟೊ ವರಿ ಅಧ್ಬುತೊನೆ ದೆಕ್ತಾಮಾ ತ್ಯುನಾಕ್ಹುಜ ತುಮೊನೆ ಸಮಾಧಾನ ಥಾವಸ; ಮಿ ಯರುಸಲೆಮನೆ ಕರಲ ಗಪ್ಪನೆ ಕರಲ ನವೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ; ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 14:23" /></para>
  <chapter eid="EZK 14" />
  <chapter number="15" style="c" sid="EZK 15" />
  <para style="s">ದ್ರಾಕ್ಷಿ ಬಳ್ಳಿನಿ ಹುತಿ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 15:1" />ಯಹೊವಾ ಆಂ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ. <verse eid="EZK 15:1" /><verse number="2" style="v" sid="EZK 15:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ ದ್ರಾಕ್ಷಿನು ಝಾಡ ಉಗ್ರಲ ಝಾಡೊತಿಬಿ ಸು ಹೆಚ್ಕಿ? ಜಂಗಲಮಾ ದ್ರಾಕ್ಷಿನು ಸು ವಿಷೆಶ ವ್ಹೈ? <verse eid="EZK 15:2" /><verse number="3" style="v" sid="EZK 15:3" />ದ್ರಾಕ್ಷಿನಿ ಲಾಕ್ಡಿ ಲಿನ ತಿನಾಕ್ಹು ಸುಬಿ ಕರಸ? ಕಯುಬಿ ಸಾಮನ ರ‍್ಹೈತಬಿ ತಗಲಿ ಘಾಲಾನಾಹುತಿ ತಿಕ್ಹು ಗುಟ ಕರಲಿವಸ? <verse eid="EZK 15:3" /><verse number="4" style="v" sid="EZK 15:4" />ಆಹಾ, ತಿನೆ ಸೌದೆ ನಿಂಗತ ಆಗಮಾ ಘಾಲಸ; ಆಗಬಿ ತಿನಾ ಭಂಬಿದ ಕೊನಾವೊನೆ ಬಾಳಿ ಪಡಸ, ವಚ್ಮಾನು ಭಾಗ ನೈಸೊ ಥಾವಸ; ತೆಳಾಮಾ ಕಯುಬಿ ಮುಟ್ಟಿಮಾ ಆವಸು? <verse eid="EZK 15:4" /><verse number="5" style="v" sid="EZK 15:5" />ಹಮ್ನಾ ತೆ ರ‍್ಹಯಲ ನಿಂಗತಜ಼ ರ‍್ಹತಾಮಾ ಕಯಾಜ ಕಾಮನೆ ಐಯು ನೈ; ಆಗಮಾ ಬಾಳಿನ ಆಂ ಕ್ಹಾರು ಥಯಲ್ಪರ ಕಯಾ ಕಾಮನೆ ಐಯುತು?<verse eid="EZK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 15:6" />ಅಮ್ಮ ರ‍್ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಜಂಗಲಮಾ ದ್ರಾಕ್ಷಿನು ಝಾಡನೆ ಮಿ ಕಿಮ್ಮ ಆಗನೆ ಸೌದೆನೆ ದಿದ್ಯೊಸತೊ ತಿಮ್ಮಜ಼ ಮಿ ಯರುಸಲೆಮವಾಲಾವೊನೆ ನಾಶನೆ ಕರಾನೆ ದಿದ್ಯೊಸ. <verse eid="EZK 15:6" /><verse number="7" style="v" sid="EZK 15:7" />ತ್ಯುನಾ ಉಪ್ಪರ ಶಿಟ್ಟನೊ ಡೊಳೊ ಮ್ಹೆಲುಸ; ತ್ಯುನೆ ಆಗಮಾತಾ ತಪ್ಸಿಲಿದ್ಯಾ ಆಗಬಿ ತ್ಯುನೊನೆ ಗಳಿಪಡಸ; ಮಿ ತ್ಯುನಾ ಉಪ್ಪರ ಶಿಟ್ಟನೊ ಡೊಳೊ ಮ್ಹೆಲ್ತಾಮಾ ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ. <verse eid="EZK 15:7" /><verse number="8" style="v" sid="EZK 15:8" />ತ್ಯುನೆ ದ್ರೊಹ ಕರಲಕ್ಹು ಮಿ ದೆಶನೆ ಹಾಳಕರುಸ; ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 15:8" /></para>
  <chapter eid="EZK 15" />
  <chapter number="16" style="c" sid="EZK 16" />
  <para style="s">ಯರುಸಲಿಮನು ಅವಿಸ್ವಾಶಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 16:1" />ಪಾಚಲ್ತೊ ಯಹೊವಾ ಆಂ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 16:1" /><verse number="2" style="v" sid="EZK 16:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಯರುಸಲೆಮನೆ ತಿನಾ ಅಸಹ್ಯ ಕಾಮೊನೆ ತಿಳಸಿನ ಅಮ್ಮ <verse eid="EZK 16:2" /><verse number="3" style="v" sid="EZK 16:3" />ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಯರುಸಲೆಮ ವಾಲಾವೊನೆ ಆಂ ವಾತ ಕೈನ ಮೊಕಲ್ಯೊಸ ತು ಹುಟ್ಟಲ ಕಾನಾನ ದೆಶ ತೆಜ ತಾರಿ ಹುಟ್ಟಲ ಜಿಮಿನ ವ್ಹೈ, ತಾರಬಾ ಅಮೊರಿವಾಲೊ ವ್ಹೈ ತಾರಿಯಾ ಹಿತ್ತಿವಾಲಿ ವ್ಹೈ. <verse eid="EZK 16:3" /><verse number="4" style="v" sid="EZK 16:4" />ತಾರಾ ಜನ್ಮಾನಾಹುತಿ ಸು ಕೌ! ತು ಹುಟ್ಟಲ ದಿನಮಾ ಕುನಬಿ ತಾರಿ ದುಟ್ಟಿ ಕಾಟಿನ ಭಾಂದ್ಯಾ ನೈ, ತುನೆ ಪಾನಿಕ್ಹು ಧ್ಯಯಿನ ಶುದ್ದ ಕರ‍್ಯಾ ನೈ, ಮಿಟ್ಟನ್ನು ದಕ್ಹುಬಿ ಸವರ್ಯಾನೈ, ತುನೆ ಫಡ್ಕಾಮಾ ಕೆಕ್ಲಾ ಸಲಾ ಸುತ್ಯಾ ನೈ. <verse eid="EZK 16:4" /><verse number="5" style="v" sid="EZK 16:5" />ತುನೆ ಕಟಾಕ್ಷಿನ ಕರುಣೆ ಕರಿನ ಕುನ್ನ ತುನೆ ಹೈ ಮದದ ಕರ‍್ಯಾ ನೈ. ತಾರಾ ಹುಟ್ಟಲ ದಿನಮಾ ತು ಹೆಸಿಗೆ ಥಯೊತೊ, ತುನೆ ಬಯಲಮಾ ಭಿರಕೈ ಪಡ್ಯಾ.<verse eid="EZK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 16:6" />ಮಿ ದಾಟಿನ ಜಾ಼ತಾಮಾ ತಾರಾ ರಗತಮಾ ಉಳ್ಯಾಡಾನು ತುನೆ ದೆಕಿನ ತು ರಗತಮಾ ರ್ಹೈತಬಿ ವಾಚ ಕೈನ ಕದ್ಯೊ, ಹಾ, ತು ರಗತಮಾ ರ‍್ಹೈತಬಿ ವಾಚ ಕೈನ 16.6 ಮೂಲ ಕದ್ಯೊ. ವಚಾ಼ಡ್ಯೊ. <verse eid="EZK 16:6" /><verse number="7" style="v" sid="EZK 16:7" />ಜಿಮಿನಮಾ ಮೊಳಕೆನಾ ನಿಂಗತಮಿ ತುನೆ ಬೆಳಸಾನೆ ತು ಪ್ರಾಯ ಭರಿನ ಘನ್ನಿ ಸುಂದರಿ ಥೈ; ತುನೆ ಸ್ತನ ಐಯು, ತಾರಾ ಬಾಲೊ ಮ್ಹೊಟಾ ಥಯಾ; ತೆನೈಸೊ ತು ಫಡ್ಕಾಮಾ ಉಗಾಡಿ ವ್ಹತ್ತಿ.<verse eid="EZK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 16:8" />ಮಿ ಜಾ಼ತಾಮಾ ತುನೆ ದೆಕ್ತಾಮಾ ಹಮ್ನಾ, ತು ಹಿವಾನೆ ತಯ್ಯಾರ ಥೈಸ; ತೆಳಾಮಾ ಮಿ ಮಾರಾ ಹೊದಿಕೆ ತಾರಾ ಉಪ್ಪರ ಘಾಲಿನ ತಾರಿ ಮಾನನೆ ವಚಾ಼ಡ್ಯೊ; ತೆನೈಸೊ ಮಿ ತುನೆ ವಾತ ದಿದಲ ಒಡಂಬಡಿಕೆ ಕರಿಲಿದಲಕ್ಹು ತು ಮಾರಿ ಥೈಸ; ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ <verse eid="EZK 16:8" /><verse number="9" style="v" sid="EZK 16:9" />ತೆಳಾಮಾ ಮಿ ಪಾನಿಮಾ ತುನೆ ಅಂಗ ಧವೈನ ತಾರೊ ಉಪ್ಪರಲ್ಯು ರಗತ ಧ್ಯನಿ ತುನೆ ತೆಲ ಲಗಾಡ್ಯೊ. <verse eid="EZK 16:9" /><verse number="10" style="v" sid="EZK 16:10" />ತೆನೈಸೊ ಮಿ ಕಸುತಿನು ವಣ್ಣಾ ತುನೆ ಘಾಲಿನ ಚೊ಼ಕು ಚಾಮ್ಡಾನಾ ಕಾರಮಲಿಯೊನೆ ತಾರಾ ಪಗೊನೆ ಘಾಲಿನ ನವು ಥಯಲ ಚೊಕಿ ಮಡಿನೆ ತುನೆ ಪೆರ್xಯಾಡಿನ ರೆಷ್ಮನು ಹೊದಿಕೆ ತುನೆ ವರಾಡ್ಯೊ. <verse eid="EZK 16:10" /><verse number="11" style="v" sid="EZK 16:11" />ವರಿ ಮಿ ತಾರಾ ಹತೊನೆ ಬಾಂಗ್ಡಿಯೊನೆ ಗಳಾಮಾ ಹಾರನೆ, <verse eid="EZK 16:11" /><verse number="12" style="v" sid="EZK 16:12" />ನಾಕೆ ನತನಿನೆ, ಮಾತೆ ಚೊಕು ಕಿರಿಟ ಮ್ಹೆಲಿನ ತುನೆ ಕ್ಹೊನಾನಾ ಸಾಮ್ನೊಕ್ಹು ಸಿಂಗಾರ ಕರ‍್ಯೊ. <verse eid="EZK 16:12" /><verse number="13" style="v" sid="EZK 16:13" />ತಾ ಸಾಮ್ನೊ ಕ್ಹೊನು ರುಪ್ಪು; ತಾರಾ ವಣ್ಣಾ ನವಿ ಥಯಲ ಚೊಕಿ ಮಡಿ, ರೆಷ್ಮನು ಹೊದಿಕಿ, ಕಸುತಿನಾ ವಣ್ಣಾ; ತಾರು ಅನ್ನ ಘೌಂನು ಲೊಟ ಜೆನ, ತೆಲ, ತಾರು ಲಾವಣ್ಯ ಘನ್ನು ಚೊಕು ರ‍್ಹಯಲ; ತು ಚೊಕಿ ಥೈನ ರಾಣಿ ಥಯಿ. <verse eid="EZK 16:13" /><verse number="14" style="v" sid="EZK 16:14" />ಮಿ ತುನೆ ದಿದಲ ಮಾರಾ ವೈಭವಕ್ಹು ತಾರಿ ಸುಂದರತಾಬಿ ಪೂರಾ ಥಯು; ತಾರಿ ಚೆಲುವಕೆ ನಾಮ ವಾಸಿನು ಜನಾಂಗೊಮಾ ಫೈಲ್ಯು; ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 16:15" />ತೆನೈಸೊ ತು ತಾರಾ ಸುಂದರತಾಮಾ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಿನ ಮಿ ಪ್ರಸಿದ್ದಿ ಥೈಸ ಕೈನ ಫುಗ್ಗಿನ ಸುಳೆತನ ಕರಿ; ದಾಟಿನ ಜಾ಼ವಾನು ಹರಯಕ್ಲಾನಾ ಕ್ಹಾತೆ ಮಿತಿಮಿರಿನ ಹಾದರ ಕರಿ ಯಕ್ಕ ಯಕ್ಲಾನೆ ಮ್ಹೈ ಥೈ. <verse eid="EZK 16:15" /><verse number="16" style="v" sid="EZK 16:16" />ತು ಪೂಜಾನಾ ಜ಼ಗಾವೊ ಭಾಂದಿಲಿನ ತಾರಿ ಚಿತ್ರಾ ವಿಚಿತ್ರ ವಣ್ಣಾವೊಕ್ಹು ತಿನೆ ತಯ್ಯಾರ ಕರಿನ ತ್ಯಾ ವ್ಯಬಿಚಾರ ಕರಿ. ಆಂ ಥಯಲ ಕ್ಹಾರು ಥಾವಾನು ನ್ಹೊತು. <verse eid="EZK 16:16" /><verse number="17" style="v" sid="EZK 16:17" />ವರಿ ಮಿ ಮಾರಾ ಕ್ಹೊನಾ ರುಪ್ಪಾಕ್ಹು ಕರೈನ ತುನೆ ದಿದಲ ತಾರಾ ಪಸಂದ ರ‍್ಹಯಲ ಸಾಮ್ನೊನೆ ಲಿನ ತು ತಿಕ್ಹು ದಾಣ್ಗಾವೊನಾ ಮೂರ್ತಿಯೊ ಕರಲಿನ ತ್ಯುನಾಕ್ಹಾತೆ ಹಾದರ ಕರಿ. <verse eid="EZK 16:17" /><verse number="18" style="v" sid="EZK 16:18" />ತಾರಾ ಕಸುತಿ ವಣ್ಣಾವೊನೆ ಲಿನ ಮೂರ್ತಿಯೊನೆ ಘಾಲಿನ ತ್ಯುನಾ ಕ್ಹಾಮು ಮಾರಾ ತೆಲನೆ ಮಾರಾ ಊದನೆ ಚಡೈ. <verse eid="EZK 16:18" /><verse number="19" style="v" sid="EZK 16:19" />ಮಿ ತುನೆ ದಿದಲ ರೊಕ್ಲಾನೆ ತಾರಾ ಅನ್ನನೆ ಮಿ ದಿದಲ ಘೌಂನೊ ಲೊಟ, ತೆಲ, ಜೆನ ಎ ಕ್ಹಾರು ತು ಆಂ ಮೂರ್ತಿಯೊನಾ ಕ್ಹಾಮಾ ಬಾಸನುಹೊಮ ಕರಿ; ಅಮ್ಮ ಥಯುತು! ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 16:19" /><verse number="20" style="v" sid="EZK 16:20" />ತೆನೈಸೊ ತು ಮನೆ ಜನ್ನಲ ಗಂಡ ವರಿ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ಧರಿನ ಮೂರ್ತಿಯೊನೆ ಅನ್ನ ಥೌ ಕೈನ ಬಲಿ ದಿದಿ. ಎ ನ್ಹಾನಿ ವಿಶಯ ವ್ಹೈ ಕೈನ ವಿಚಾರ ಕರಿಸು? <verse eid="EZK 16:20" /><verse number="21" style="v" sid="EZK 16:21" />ತಿನೆ ಮಿರಸು ಕೈನ ತು ಮಾರಾ ಬಚ್ಚಾವೊನೆ ಹತಸಿನ ಆಗನ್ಯಾ ದಿನ ಮೂರ್ತಿಯೊನೆ ಚಡೈ? <verse eid="EZK 16:21" /><verse number="22" style="v" sid="EZK 16:22" />ಆಂ ತಾರಾ ಅಸಹ್ಯ ಕಾಮೊನೆ ಸುಳೆತನಾನತ ತು ಹಗಲೆಲಾ ಕರ್ತಾಮಾ ತು ವಣ್ಣಾವಾಚಿ ಉಗಾಡಿ ಥೈನ ತಾರಾ ರಗತಮಾ ವದ್ಯಾಡತಾ ತಾರು ಎಳೆತನಾನೆ ತಾರಾ ಸ್ಹೆಂನೆ ಲೈ ನೈ. <verse eid="EZK 16:22" /><verse number="23" style="v" sid="EZK 16:23" />ಅಯ್ಯೊ, ತಾರಿ ಗತಿ ಮಿ ಸು ಕೌ ಕವಾನು ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 16:23" /></para>
  <para style="s">ಜೆರುಸೆಲಿಮನಿ ಸುಳಿತನಾನಿ ಜಿವ್ನಿ</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 16:24" />ತು ಆಂ ಕೆಟ್ಟ ಕಾಮೊನೆ ಕ್ಹಾರಾ ಕರಲ ಹರಯಕ್ಕ ಚೌಕಮಾ ಗುಬ್ಬು ಕರಿನ ಜಗಲಿನೆ ಭಾಂದಿಲಿದಿತಿ. <verse eid="EZK 16:24" /><verse number="25" style="v" sid="EZK 16:25" />ಯಕ್ಕಯಕ್ಕ ರಸ್ತಾನಾ ಕೊನಾಮಾಬಿ ತು ಜಗಲಿನೆ ಭಾಂದಿಲಿನ ತಾರಾ ಸುಂದರತಾನೆ ಕೆಟ್ಟ ಕಾಮನೆ ಒಪ್ಸಿನ ಜಾ಼ವಾಲಾ ಕ್ಹಾರಾವೊನೆ ಮಳಿನ ಸುಳೆತನ ಹೆಚ್ಚ ಕರಿಸ. <verse eid="EZK 16:25" /><verse number="26" style="v" sid="EZK 16:26" />ತಾರಾ ಬಾಜು಼ವಾಲಾ ಅತಿಕಾಮಿ ಥಯಲ ಐಗುಪ್ತ ವಾಲಾವೊನಾ ಕ್ಹಾತೆ ತುಬಿ ಸಿಕ್ಕಿನ ಹೆಚ್ಚ ಹಾದರ ಕರಿನ ಮನೆ ತಡೈಸ. <verse eid="EZK 16:26" /><verse number="27" style="v" sid="EZK 16:27" />ತೆ ಥಯಲ್ಪರ ಮಿ ತುಪರ ಹತ್ತ ಉಚೈನ ತಾರಾ ಅನ್ನನೆ ಕಮ್ಮ ಕರ‍್ಯೊ; ತುನೆ ದ್ವೆಶ ಕರಿನ ತಾರಾ ಕೆಟ್ಟ ಚಾಲನೆ ಅಸಹ್ಯ ಕರಾಲಾ ಪಿಲಿಷ್ಟಿನಾ ಜಾ಼ಂಜಿಮಾನ ಛೊಕ್ರಿಯೊನಾ ಹತ್ಮಾ ಕ್ಹಾಪ್ಡಾಯೊ. <verse eid="EZK 16:27" /><verse number="28" style="v" sid="EZK 16:28" />ವರಿ ಅಕ್ಲು ಬಸ ನೈ ಥಾತು ಕೈನ ಅಶ್ಯೂರ್ಯನಾ ಕ್ಹಾತೆ ಹಾದರ ಕರಿನ; ಹಾ, ತ್ಯುನಾಕ್ಹಾತೆ ಹಾದರ ಕರಿತಬಿ ತುನೆ ತೃಪ್ತಿ ಥಯಿ ನೈ. <verse eid="EZK 16:28" /><verse number="29" style="v" sid="EZK 16:29" />ತೆನೈಸೊ ತು ಘನ್ನು ವ್ಯಾಪಾರ ರ‍್ಹಯಲ ಕಸ್ದಿಯ ದೆಶನೆ ಸೆರಿನ ತ್ಯಾಬಿ ಘನ್ನು ಸುಳೆತನಾ ಕರಿ, ತಿನಾಹುತಿ ತುನೆ ತೃಪ್ತಿ ಥಯಿ ನೈ.<verse eid="EZK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 16:30" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತಾರು ಮನಸ ಆಸನೆ ಕೆಕ್ಲಿಸಲಾ ಆಸ! ಅಕ್ಲಾಕ್ಹಾರಾ ಕೆಟ್ಟ ಕಾಮೊ ರಿನ ಭಾಂದಲ ಕ್ಹಾರು ಜಾರಸ್ತಿ ಥಯಾಸತೊ; <verse eid="EZK 16:30" /><verse number="31" style="v" sid="EZK 16:31" />ಹರಿ ಯಕ್ಕ ಒಣಿನಾ ಮುಲಾಮಾ ಕ್ಹಾರಾ ಚೌಕೊಮಾ ಜಗಲಿನೆ ಕರಲಿದಿಸ; ಮಳಲ ಕಮ್ಮರ‍್ಹಯಲ ಇನ್ಕಾರ ಕರಾನಾ ಸುಳೆನಿಂಗತ ತು ಚಾಲಾಲಿ ನವೈ. <verse eid="EZK 16:31" /><verse number="32" style="v" sid="EZK 16:32" />ತು ಸುಳೆತನ ಕರಾನು ಪತಿವರ್ತಾ! ಮಾಟಿನಾ ಬಿಜಾ಼ ಮನಕ್ಹೊನೆ ಮಳಾನಿ ಜಾರಿನಿ! <verse eid="EZK 16:32" /><verse number="33" style="v" sid="EZK 16:33" />ಕ್ಹಾರಿ ಜ಼ಗಾಮಾ ಸುಳೆಯೊನೆ ದೊಕ್ಡಾ ದಿವಾನು ಛೆ; ತುತಬಿ ತಾರಾ ಕ್ಹಾರಾ ಗೆಣ್ಯಾವೊನೆ ತುಜ ದೆಸಿ; ತ್ಯುನೆ ಕ್ಹಾರಾ ಜ಼ಗಾತಾ ಐನ ತುಕನ ವ್ಯಭಿಚಾರ ಕರಲಕ್ಹು ತ್ಯುನೊನೆ ಇನಾಮ ದೆಸಿ. <verse eid="EZK 16:33" /><verse number="34" style="v" sid="EZK 16:34" />ತಾರಾ ಸುಳೆತನಾನೆ ವರಿ ಬಿಜಾ಼ ವೆಷನಾ ಸುಳೆತನಾನೆ ವ್ಯತ್ಯಾಸ ಛೆ; ತಾರಾಮಾ ವ್ಯಬಿಚಾರ ಕರಾನೆ ಕುನಬಿ ಕುನಬಿ ತಾರಾ ಪಾಚಾ಼ ನೈ ಆತಾ; ತು ದೆಸಿ ರ‍್ಹೈತಬಿ ತುನೆ ಸುಜ಼ ಮಳತು ನೈ; ತಾರಿ ಕೆಟ್ಟ ವಿಚಾರ ವಿಪರಿತ ವ್ಹೈ.<verse eid="EZK 16:34" /></para>
  <para style="s">ಯೆರುಸೆಲಿಮನೆ ಕ್ಹುದಾನೊ ಫೈಸಲೊ</para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 16:35" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ವ್ಯಬಿಚಾರಣಿ, ಯಹೊವಾನಿ ವಾಕ್ಯಾ ಐಕ! <verse eid="EZK 16:35" /><verse number="36" style="v" sid="EZK 16:36" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಿತಿಮಿರಲ ತಾರಾ ಕಾಮಮಾ, ತಾರಾಮಾ ವ್ಯಬಿಚಾರ ಕರಲ ತಾರಾ ಗುಂಪನಾ ಮೂಲಕ ತುನೆ ಥಯಲ ಮಾನಭಂಗ, ತಾರಾ ಕ್ಹಾರಾ ಅಸಹ್ಯನಾ ಸಾಮ್ನೊನೆ, ತು ತಿನೆ ಚಡಾಯಲ ತಾರಾ ಬಚ್ಚಾವೊನು ರಗತ. <verse eid="EZK 16:36" /><verse number="37" style="v" sid="EZK 16:37" />ಎ ಕ್ಹಾರಾವೊನೆ ಮಿ ದೆಕಿನ ತು ಪೊಕ್ಹಲಾಯಲ ಕ್ಹಾರಾ ಗುಂಪನೆ ತು ಮೊಹಿಸಲ ಕ್ಹಾರಾವೊನೆ ತು ಹಗೆ ಕರಲ ಕ್ಹಾರಾವೊನಾ ಕ್ಹಾತೆ ಸುತ್ತೆ ಮುತ್ತೆ ತುನೆ ವಿರುದ್ದ ಥೈನ ಮಳೈನ ತ್ಯುನಾ ಡೊಳಾನಾ ಕ್ಹಾಮೊ ತಾರಿ ಮನಾ ಮರ್ಯಾದಿನೆ ಬಟ್ಟ ಬೈಲ ಕರುಸ. <verse eid="EZK 16:37" /><verse number="38" style="v" sid="EZK 16:38" />ವ್ಯಬಿಚಾರ ಕರಲ ನಿಂಗತ, ರಗತ ಚುವಾ ನಿಂಗತ ಹೆಣ್ಣ ಮನಕ್ಹೊನೆ ತಿನಾ ತಕ್ಕ ಶಿಕ್ಷಾ ದಂಡದಿನ ಶಿಟ್ಟಕ್ಹು ಘನ್ನಿ ಶಿಟ್ಟಕ್ಹು ತಾರು ರಗತ ಚುವೌಸ. <verse eid="EZK 16:38" /><verse number="39" style="v" sid="EZK 16:39" />ಮಿ ತಾರಾ ಸುತ್ತೆ ರ‍್ಹಯಲ ವಾಲಾನೆ ಹತ್ತ ವಶಮಾ ಕರುಸ; ತ್ಯುನೆ ತಾರಾ ದಿಬ್ಬಾನೆ ಪಾಡಿನ ತಾರಾ ಜಗಲಿಯೊನೆ ತೊಡಿನ ತಾರಾ ವಣ್ಣಾವೊನೆ ಕಿತ್ತಿನ ತಾರಾ ಕ್ಹೊನಾನಾ ಸಾಮ್ನೊನೆ ಕಿತ್ತಿಲಿನ ತುನೆ ಬಟ್ಟ ಬೈಲಮಾ ಛೊಡಿನ ಜಾ಼ವಸ.<verse eid="EZK 16:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EZK 16:40" />ತ್ಯುನೆ ತಾರಾ ವಿಚಾರಮಾ ಶಾನಾವೊನೆ ಮಳೈನ ತುನೆ ದಗ್ಡಾ ನಾಕಿನ ಮಾರಸ, ತಲ್ವಾರೊಕ್ಹು ಕತ್ರಸ. <verse eid="EZK 16:40" /><verse number="41" style="v" sid="EZK 16:41" />ತಾರಾ ಘರೊನೆ ಆಗಕ್ಹು ಬಾಳಿ ಪಾಡಸ; ಘನಾ ಜನಾ ಹೆಣ್ಣ ಮನಕ್ಹೊನಾ ಡೊಳಾನಾ ಕ್ಹಾಮಾ ತುನೆ ದಂಡ ದಿವಸ; ತು ತಾರು ಸುಳೆತನಾ ಛೊಡಿಪಡು ಕೈನ ಮಿ ಕರುಸ; ತು ತಾರಾ ಗುಂಪನೆ ಹಜಿ ದೊಕ್ಡಾ ನೈ ದೆತಿ. <verse eid="EZK 16:41" /><verse number="42" style="v" sid="EZK 16:42" />ಅಮ್ಮ ಮಿ ತಾರಾ ಉಪ್ಪರ ಶಿಟ್ಟ ತಿರಸಾನೆ ಮಾರಿ ಶಿಟ್ಟ ತುಕಂತು ಗೈಪಡಸ ; ಮಿ ಶಾಂತ ಥೈನ ಹಜಿ ಯಕ್ಕೆಮ್ಮ ಶಿಟ್ಟ ಥಾತೊ ನೈ. <verse eid="EZK 16:42" /><verse number="43" style="v" sid="EZK 16:43" />ತು ತಾರಾ ನ್ಹಾನಪಂತ ಸ್ಹೆಂ ಕರೆವಾಚಿ ಆಂ 16.43 ಪಾಟಾ ನಿಂಗತ ಮಾರಾ ಉಪ್ಪರ ಕಾಪತಾಮಾ ಆ ಕೆಟ್ಟ ಕಾಮೊ ಕರಿನ ಮನೆ ತಡಾಯಲಕ್ಹು ಹಮ್ನಾ, ಮಿ ತಾರಾ ಕೆಟ್ಟ ವಾಟನೊ ಫಲನೆ ತಾರಾ ಮಾತೆ ಭಾಂದುಸ; ತು ಲೆಕ್ಕಾ ನೈಸೊ ಕೆಟ್ಟ ವಿಚಾರೊ ಕರಿಸತೊ ವರಿ ಆಂ ಅಸಹ್ಯ ಕಾಮೊಬಿ ಕರಿಸತೊ. ಆಂ ಕರ್ತಾ ಥಯಲಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 16:43" /></para>
  <para style="s">ಮಾ ನಿಂಗತ ದಿಕ್ರಿ</para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 16:44" />ಒಡಪೊಮಾ ಶ್ಯಾಣ್ಯಾ ಯಾ ನಿಂಗತ ದಿಕ್ರಿ ಕವಾನಾ ಒಡಪನೆ ತಾರಾ ವಿಷಯಮಾ ಕವಸ. <verse eid="EZK 16:44" /><verse number="45" style="v" sid="EZK 16:45" />ಮಾಟಿನೆಬಿ ವರಿ ಬಚ್ಚಾವೊನೆಬಿ ತಾರಿ ಯಾನೆ ತಿನಾ ತಕ್ಕ ದಿಕ್ರಿ; ಮಾಟಿನೆಬಿ ಬಚ್ಚಾವೊನೆಬಿ ಬೆಜಾರ ಥವಾಲಾ ತಾರಾ ಮ್ಹೊಟಿ ಭೆನೊನೆ ತಿನಾತಕ್ಕ ಭೆನ ರ‍್ಹೌ; ತಾರಿಯಾ ಹಿತ್ತಿವಾಲಿ ವ್ಹೈ, ತಾರಬಾ ಅಮೊರಿವಾಲೊ ವ್ಹೈ;<verse eid="EZK 16:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="EZK 16:46" />ತಾರಾ ಉತ್ತರ ದಿಕ್ಕನೆ ತಾರಿಯೊ ದಿಕ್ರಿಯೊರೊನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾನಾ ಸಮಾರ್ಯ ತಾರಿ ಮ್ಹೊಟಿ ಭೆನ ದಕ್ಷಿಣ ದಿಕ್ಕನಾ ತಾರಿಯೊ ದಿಕ್ರಿಯೊನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾನಿ ಸೊದೊಮ್ ತಾರಿ ಭೆನ ವ್ಹೈ. <verse eid="EZK 16:46" /><verse number="47" style="v" sid="EZK 16:47" />ತೆನೈಸೊ ತು ಚಾಲಲ ಕೆಟ್ಟವಾಟ ತ್ಯುನೆ ಚಾಲಲ ನ್ಹವ್ಹೈ, ತಾರಾ ಅಸಹ್ಯ ಕಾಮೊ ತ್ಯುನೆ ಕರಲವಾಲಾ ನ್ಹವೈ, ತ್ಯುನಿ ಕೆಟ್ಟ ವಾಟ ಚೊಕಿ ನ್ಹವೈ ಕೈನ ತ್ಯುನಾತಿ ಘನ್ನಿ ಕೆಟ್ಟ ಥೈನ ಚಾಲ್ಲಿದಿ.<verse eid="EZK 16:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="EZK 16:48" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಾರೊ ಜಲಮ, ತುಬಿ ತಾರಾ ಕುಮಾರ್ತೆಯೊ ಚಾಲಲ ನಿಂಗತ ಸೊದೊಮ್ ಕವಾಲಿ ತಾರಿ ಭೆನ ರ‍್ಹವಾದೆ ತಿನಾ ಕುರ್ತೆ ರ‍್ಹವಾದೆ ಚಾಲ್ಯಾ ನೈ. <verse eid="EZK 16:48" /><verse number="49" style="v" sid="EZK 16:49" />ಸೋದೊಮ್ ಕವಾಲಿ ತಾರಿ ಭೆನೊ ದೊಷ ದೆಕ; ಹೆಮ್ಮೆ ಪಡದಾನು ವ್ಹೈ. ಪೆಟ ಭರಲಿವಾನು ಸ್ವಂತ ಸುಖಾಮಾ ಡುಬಲ ರ‍್ಹವಸ, ಇಬಿ ತಿನಾಮಾ ತೆಬಿ ಕುಮಾರ್ತೆಮಾ ವ್ಹತ್ತಾ. ತೆನೈಸೊ ತೆ ದಿನ್ನ ದರಿದ್ರನೆ ಬೆಂಬಲ ಥಯು ನ್ಹೊತು. <verse eid="EZK 16:49" /><verse number="50" style="v" sid="EZK 16:50" />ತ್ಯುನೊನೆ ಸೊಕ್ಕ ಐನ ಮಾರಾ ಡೊಳಾ ಕ್ಹಾಮೊ ಅಸಹ್ಯ ಕಾಮೊನೆ ಕರ‍್ಯಾ; ಮಿ ತೆ ದೆಕಿನ ತ್ಯುನೊನೆ ನಿರ್ಮೂಲ ಕರ‍್ಯೊಸ.<verse eid="EZK 16:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="EZK 16:51" />ಸಮಾರ್ಯಾ ಕವಾಲಿ ತು ಕರಲ ಪಾಪೊಮಾ ಅರ್ದು ಕರಿ ನೈ. ತುಬಿ ತಾರಾ ಭೆನೊತಿಬಿ ಘನ್ನಾ ಕೆಟ್ಟ ರ‍್ಹಯಲ ಅಸಹ್ಯ ಕಾಮೊನೆ ಕರಿಸ; ತು ಕರಲ ಹಿಸಾಬ ನೈಸೊ ಕೆಟ್ಟ ವಿಚಾರೊಕ್ಹು ತ್ಯುನೆ ನಿರ್ದೊಶಿಯೊ ವ್ಹೈ ಕೈನ ದೆಕಾಡಿನ ದಿದಿ. <verse eid="EZK 16:51" /><verse number="52" style="v" sid="EZK 16:52" />ತಾರಾ ದೊಷೊಜ ತಾರಾ ಭೆನೊನಾ ಪಕ್ಷಮಾ ಹುಬ್ರಯಲಕ್ಹು ತು ಸರಮಾ; ತ್ಯುನಾತಿಬಿ ಘನ್ನಾ ತು ಕರಲ ಅಸಹ್ಯ ಪಾಪೊನಾ ಮೂಲಕ ತ್ಯುನೆ ತಾರಾತಿಬಿ ಚೊಕಾ ವ್ಹೈ ಕೈನ ದಿಕ್ಹಿನ ಆಯಾಸ; ತು ಲಜ್ಜೆಪಡು, ಸರಮ ನೈಸೊ; ತಾರಾ ಭೆನೊ ನಿರ್ದೊಶಿಯೊ ಕೈನ ದೆಕಾಡಿನ ದಿದಿಸ.<verse eid="EZK 16:52" /></para>
  <para style="s">ಸೊದೊಮ ವರಿ ಸಮಾರ್ಯ ವರಿಸ್ಥಾಪನಾ</para>
  <para style="p">
    <verse number="53" style="v" sid="EZK 16:53" />ಸೊದೊಮ, ತಿನಾ ಕುಮಾರ್ತೆಯರೊ, ಸಮಾರ್ಯಾ, ತಿನಾ ಕುಮಾರ್ತೆಯರೊ, ಇವ್ನಿ ಕೆಟ್ಟ ವಾಟ ಮಿ ತಪ್ಸಾಡುಸ, ತಿನಾ ಕ್ಹಾತೆ ತಾರಿ ಕೆಟ್ಟ ವಾಟನೆ ತಪ್ಸಾಡುಸ. <verse eid="EZK 16:53" /><verse number="54" style="v" sid="EZK 16:54" />ಅಮ್ಮ ರ‍್ಹತಾಮಾ ತು ತಾರಾ ಕೆಟ್ಟ ಕಾಮೊನಾ ಮೂಲ ತ್ಯುನೊನೆ ಸ್ಹೆಂ ಕರಲಕ್ಹು ಲಜ್ಜೆ ಪಡ್ದುಸ, ಸರಮಾಸಿ. <verse eid="EZK 16:54" /><verse number="55" style="v" sid="EZK 16:55" />ತೆಳಾಮಾ ಸಮಾರ್ಯಾ, ಸೊದೊಮ್ ಕವಾಲಿಯೊ ತಾರಾ ಭೆನೊ ತ್ಯುನಾ ಕುಮಾರ್ತೆಯೊ ತ್ಯುನಾ ಪೈಲಾನಾ ಸ್ಥಿತಿನೆ ಸೆರಸ, ತುಬಿ ತಾರಾ ಕುಮಾರ್ತೆಯೊ, ತುಮಾರಾ ಪೈಲಾನಾ ಸ್ಥಿತಿನೆ ಸೆರೊಸಿ. <verse eid="EZK 16:55" /><verse number="56" style="v" sid="EZK 16:56" />ಅರಾಮಿನಾ ಕುಮಾರ್ತೆಯೊ, ತಿನಾ ಸುತ್ತೆ ರ‍್ಹಯಲ ಕ್ಹಾರಾಜನಾ, ತುನೆ ಕಿಯಾಬಿ ಹಿನಾವಾಲಾ ಪಿಲಿಷ್ಟಿನಾ ಕುಮಾರ್ತೆಯೊ, ವರಿ ಎ ಕ್ಹಾರಾವೊನಾ ದೊಷನೆ ತು ಗುರಿ ಥಾವಾತಿ ಪೈಲಾಜ಼, <verse eid="EZK 16:56" /><verse number="57" style="v" sid="EZK 16:57" />ತಾರು ಕೆಟ್ಟತನಾ ಬಯಲೆ ಆವಾತಿ ಪೈಲಾಜ಼ ತೆ ತಾರಾ ಗರ್ವಕಾಲಮಾ ಸೊದೊಮ್ ಕಾವಾಲಿ ತಾರಿ ಭೆನು ನಾಮ ತಾರಾ ಮ್ಹೊಡಾಮಾ ಐಯುಜ ನೈ; <verse eid="EZK 16:57" /><verse number="58" style="v" sid="EZK 16:58" />ಹಮ್ನಾ ತಾರಿ ಕೆಟ್ಟ ವಾಟ ವರಿ ಕೆಟ್ಟ ವಿಚಾರೊನು ಫಲ ನೆ ತು ಅನುಭವಿಸಆನು ಐಯು. ಆಂ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 16:58" /></para>
  <para style="s">ಹಮೆಶಾ ರ‍್ಹವಾನು ಒಡಂಬಡಿಕೆ</para>
  <para style="p">
    <verse number="59" style="v" sid="EZK 16:59" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತು ಒಡಂಬಡಿಕೆ ಮಿರಿನ ತಾರಿ ಕ್ಹಮ್ಮನೆ ಇನ್ಕಾರ ಕರಿಸ, ತು ಕರಲಕ್ಹು ತಿನಾ ತಕ್ಕ ಮಿ ತುನೆ ಕರುಸ. <verse eid="EZK 16:59" /><verse number="60" style="v" sid="EZK 16:60" />ಕಿಮ್ಮಬಿ ಮಿ ತಾರಾ ಜಾಂಜಿಮಾನನಾ ಕಾಲಮಾ ತಾರಾ ಕ್ಹಾತೆ ಕರಿಲಿದಲ ಒಡಂಬಡಕೆನೆ ಸ್ಹೆಂ ನೆ ಲೈನ ತಾರಾಕ್ಹಾತೆ ಕೆಳಾಮಾಜ಼ ನೈ ತಪ್ಪಲ ಒಡಂಡಿಕೆ ಕರಲಿನ ಖಾತ್ರಿ ಕರುಸ. <verse eid="EZK 16:60" /><verse number="61" style="v" sid="EZK 16:61" />ಇನಾಹುತಿ ಮಿ ಕುಮಾರ್ತೆಯೊನೆ ನಿಂಗತ ತುನೆ ದಿವಾನಾ ತಾರಾ ಭೆನೊ ತಾರಾಮಾ ಸೆರತಾಮಾ ತು ತಾರಾ ಕೆಟ್ಟ ವಾಟೊನೆ ಸ್ಹೆಂ ಕರಲಿನ ಸರಮಾಸಿ; ಆಂ ಮಾರಿ ದಯಾ ತಾರಾ ಪಾಚಲಿ ಒಡಂಡಿಕೆನು ಫಲ ನ್ಹವೈ. <verse eid="EZK 16:61" /><verse number="62" style="v" sid="EZK 16:62" />ಮಿ ಎ ಒಡಂಬಡಿಕೆನ ತಾರಾ ಕ್ಹಾತೆ ಕರಿಲಿವಾನೆ ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುನೆ ಗೊತ್ತ ಥಾವಸ; <verse eid="EZK 16:62" /><verse number="63" style="v" sid="EZK 16:63" />ಮಿ ತಾರಾ ಕೆಟ್ಟ ಕಾಮೊನೆ ಕ್ಹಾರಾ ಮಾಫ ಕರಲ್ಪರ ತು ತೆ ಕ್ಹಾರಾವೊನೆ ಸ್ಹೆಂ ಕರಿನ ಸರಮೈನ ತಾರಾ ಅವಮಾನನಾ ನಿಮಿತ್ತ ಹಜಿ ಮ್ಹೊಡು ಕ್ಹೊಲ್ಯಾವಾಚಿ ರ‍್ಹಶಿ ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 16:63" /></para>
  <chapter eid="EZK 16" />
  <chapter number="17" style="c" sid="EZK 17" />
  <para style="s">ಹದ್ದೊ ವರಿ ದ್ರಾಕ್ಷಿ ಬಳ್ಳಿನಿ ಸಾಮ್ಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 17:1" />ಯಹೊವಾ ಆಂ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 17:1" /><verse number="2" style="v" sid="EZK 17:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಇಸ್ರಾಯಲ ವಂಶವಾಲಾವೊನೆ ಆ ಸಾಮ್ಯ ಒಗ್ಗಟ ನಿಂಗತ ಕೆ <verse eid="EZK 17:2" /><verse number="3" style="v" sid="EZK 17:3" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ರುಂದ ರ‍್ಹಯಲ ವರಿ ಲಾಂಬು ರ‍್ಹಯಲ ರೆಕ್ಯಾ ರ‍್ಹಯಲ ಪಿಚ್ಚಾ಼ ಭರಲ ಘನಾ ಕರಲನಿ ಘಾರ ಲೆಬನೊನಿನೆ ಐನ ದೆವದಾರು ಝಾಡನಾ ಉಪ್ಪರಲ್ಯಾ ಠೊಂಗಿನೆ ಕಿತ್ತ್ಯು; <verse eid="EZK 17:3" /><verse number="4" style="v" sid="EZK 17:4" />ಉಪ್ಪರಲಿ ತುದಿನಾ ಚಿರಗನೆ ಕಡ್ಡಿನ ವ್ಯಾಪಾರ ಕರಾನಾ ದೆಶೆ ಲಿನ ಗೈನ ಘನ್ನು ವರ್ತಕರ ರ‍್ಹವಾನಾ ಗಾಮಮಾ ಮ್ಹೆಲಿ ಪಡಿ. <verse eid="EZK 17:4" /><verse number="5" style="v" sid="EZK 17:5" />ಪಾಚಾ಼ತು ತೆ ತೆ ದೆವದಾರು ರ‍್ಹಯಲ ದೆಶನಾ ಯಕ್ಕ ಬಿಯೊ ಲಿನ ಫಲ ರ‍್ಹಯಲ ನಿರಾವರಿ ಜಿಮಿನಮಾ ಲಗಾಡಿನ ಚೊ಼ಕು ಬೆಳದ್ಯು. <verse eid="EZK 17:5" /><verse number="6" style="v" sid="EZK 17:6" />ತೆ ಗುಂಚಲೊಥೈನ ಬೆಳದಿನ ದ್ರಾಕ್ಷಿಯೊ ಘನ್ನಾ ಫೈಲಿನ ತಿನಾ ರೆಂಬಾವೊನೆ ತೆ ಘಾರನಾ ಕನ ಚಾಚಿನ ತಿನಾಹಟು ತಿನಾಬೆರೊನೆ ಛೊಡ್ಯು; ತೆ ಲತೆ ಥೈನ ರೆಂಬಾವೊನೆ ಫೈಲೈನ ಚಿಗರೊನೆ ಮೊಕ್ಲಯು.<verse eid="EZK 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 17:7" />ರುಂದ ರ‍್ಹಯಲ ರೆಕ್ಯಾ ರ‍್ಹಯಲ ಪಿಚ್ಚಾ಼ ಭರಲ ವರಿಯಕ್ಕ ಮ್ಹೊಟಿ ಘಾರ ವ್ಹತ್ತಿ; ಹಮ್ನಾ ತೆ ದ್ರಾಕ್ಷಿನು ತೆ ನಾಟಿ ಲಿದಲ ಪಾತಿಯೊಮಾತಿ ತಿನಾ ಬಗಲ ತಿನಾ ಬೆರೊನೆ ಫರೈನ ತಿನಾ ರೆಂಬಾವೊನೆ ಚಾಚಿನ ತಿಕ್ಹು ಪಾನಿನೆ ಉರಾಡಾತಿತಿ. <verse eid="EZK 17:7" /><verse number="8" style="v" sid="EZK 17:8" />ತೆ ಘನ್ನು ಹಸರ ಥೈನ ರೆಂಬೆನೆ ಫೈಲೈನ ಫಲ ದಿವಾನೆ ಅನಕುಲ ರ‍್ಹಯಲ ಚೊಕು ನಿರಾವರಿ ಜಿಮಿನಮಾ ಹುಟ್ಯತು. <verse eid="EZK 17:8" /><verse number="9" style="v" sid="EZK 17:9" />ಎ ವಾತನೆ ಕೆ ಕರ್ತಾ ಥಯಕಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತೆ ಸಮೃದ್ದಿ ಥೈನ ರ‍್ಹವಸ? ತೆ ಕದಲ ಘಾರ ತಿನಾ ಬೆರೊನೆ ಕಿತ್ತಿನ ತಿನಾ ಫಲನೆ ಕತ್ರಾನೆ ತೆ ಕ್ಹುಕ್ಹೈನ ತಿನಾ ಪಾಲೊ ಬಾಡತಾ ನೈಸು ತೆ ಬೆರನಾ ಕ್ಹಾತೆ ಕಿತ್ತಾವಸ; ಘನಿ ತಾಕತಕ್ಹು ನೈ ಘನಾ ಮನಕ್ಹೊಕ್ಹು ನೈ. <verse eid="EZK 17:9" /><verse number="10" style="v" sid="EZK 17:10" />ಹುಟ್ಟಲ ತೆ ಲತೆ ಬಿ ಸಮೃದ್ದಿಕ್ಹು ರ‍್ಹವಸ? ಕೆಟ್ಟ ವಾರೊ ಆತಾಮಾ ಬಾಡ್ತಾ ನೈ? ಬೆಳದಲ ಜಿಮಿನಮಾಜ ಕ್ಹುಕ್ಹೈ ಜಾ಼ವಸ.<verse eid="EZK 17:10" /></para>
  <para style="s">ಸಾಮ್ಯನು ಮತ್ಲಬ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 17:11" />ಯಹೊವಾ ಹಜಿಯಕ್ಕ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 17:11" /><verse number="12" style="v" sid="EZK 17:12" />ದ್ರೊಹಿ ವಂಶವಾಲಾವೊನೆ ಆಂ ಮನಕ್ಹೊನೆ ಅಮ್ಮ ಕೆ ಇನು ಅಬಿಪ್ರಾಯ ತುಮೊನೆ ಗೊತ್ತ ನತ್ತಿ ಸು? ಹಮ್ನಾ ಬಾಬಿಲೆನೊ ರಾಜೊ಼ ಯರುಸಲೆಮನೆ ಐನ ತ್ಯಾನಾ ರಾಜಾವೊನೆ ಮಂತ್ರಿಯೊನೆ ಧರಿನ ಬಾಬಿಲೊನನೆ ಲಿನ ಗಯೊ. <verse eid="EZK 17:12" /><verse number="13" style="v" sid="EZK 17:13" />ವರಿ ರಾಜ ವಂಶವಾಲಾಮಾ ಯಕ್ಲಾನೆ ಇನಿನ ತಿನಾಕ್ಹಾತೆ ಒಡಂಬಡಿಕೆ ಕರಲಿನ ತಿನಾಕ್ಹು ಕ್ಹಮ್ಮ ಘಲೈನ <verse eid="EZK 17:13" /><verse number="14" style="v" sid="EZK 17:14" />ಇನು ರಾಜ್ಯ ಉಪ್ಪರ ಉಟೆವಾಚಿ ಒಡಂಬಡಿಕೆನೆ ಪಾಲಸಲಕ್ಹು ಹುಬ್ರೆತಾ ನೈಕೈನ ತೆ ಗಾಮ್ನಾ ತಾಕತವಾಲಾವೊನೆ ಗಡಿಪಾರ ಕರಾಯೊ. <verse eid="EZK 17:14" /><verse number="15" style="v" sid="EZK 17:15" />ತೆನೈಸೊ ತೆ ಬಾಬೆಲೊನನಾ ರಾಜಾನಾ ಉಪ್ಪರ ಫರಿನ ಪಡಿನ ಘೊಡಾವೊನೆ ಘನಾ ಸೈನಿಕೊನೆ ಅಪೊನೆ ದಿದ್ಯಾಸ ಕೈನ ಐಗುಪ್ತ ರಾಜಾ಼ನಾ ದುತೊನೆ ವಳಾಯೊ. ಆಂ ಸಮೃದ್ದಿಕ್ಹು ರ‍್ಹವಸ? ಹವಾ ಕಾಮೊನೆ ಕರಲವಾಲೊ ಪಾರಥಾವಸ? ಒಡಂಬಡಿಕೆನೆ ಮಿರಲವಾಲೊ ತಪ್ಸಿಲಿದ್ಯೊಸ? <verse eid="EZK 17:15" /><verse number="16" style="v" sid="EZK 17:16" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಾರೊ ಜಲಮ, ಆಂ ಕಿನಾಕ್ಹು ರಾಜೊ಼ ಥೈನ ನೆಮ್ಸಲ ವ್ಹೈ, ಕಿನೆ ಘಾಲಲ ಕ್ಹಮ್ಮನೆ ಇನ್ಕಾರ ಕರ್ಯೊ, ಕಿನು ಒಡಂಬಡಿಕೆ ಮಿರ‍್ಯೊ, ತೆ ರಾಜಾಕನ , ಕದ್ಯಾಮ ಬಾಬೆಲೊನ ಕವಾನಾ ತಿನಾ ರ‍್ಹವಾನಾ ಜ಼ಗಾಮಾ ಎ ಮರಾನು ಖಚಿತ ವ್ಹೈ. <verse eid="EZK 17:16" /><verse number="17" style="v" sid="EZK 17:17" />ಫರೊಹನ ತಿನು ಮ್ಹೊಟಿ ಸೆನಾ ಮ್ಹೊಟು ಪರಿವಾರ ಐನ ಘನಾ ಮನಕ್ಹೊನೆ ಮಾರಾನಾಹುತಿ ಗುಬ್ಬಾವೊನೆ ಘಾಲಿನ ಗೊಡಿಯೊ ಭಾಂದ್ಯಾ ಯುದ್ದ ಕ್ಹೆಲ್ತಾಮಾ ಇನೆ ಸುಜ಼ ಮದದ ಥೈಯು ನೈ. <verse eid="EZK 17:17" /><verse number="18" style="v" sid="EZK 17:18" />ಎ ಘಾಲಲ ಕ್ಹಮ್ಮನೆ ಇನ್ಕಾರಿನ ಒಡಂಬಡಿಕೆನೆ ಇನ್ಕಾರ್ಯೊ ನೈ; ಹತ್ತಪರ ಹತ್ತ ಮ್ಹೆಲ್ಯಾಮಾ ಸು? ಎ ಕ್ಹಾರು ಕರಿನ ಛೊಡ್ಯೊಸತೊ? ಎ ಪಾರ ಥಾವಸ. <verse eid="EZK 17:18" /><verse number="19" style="v" sid="EZK 17:19" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಾರಾ ಕ್ಹಮ್ಮಬಿ, ಮನೆ ದಿದಲ ಕ್ಹಮ್ಮ ತೆ ಇನ್ಕಾರಿನ ಮಾರಾ ಒಡಂಬಡಿಕೆನೆ ಇನ್ಕಾರಲ ದೊಷ ತಿನಾ ಮಾತಾಪರ ಭಾಂದುಸ. <verse eid="EZK 17:19" /><verse number="20" style="v" sid="EZK 17:20" />ಮಿ ತಿನೆ ಮಾರಾ ಜಾಲಮಾ ಘಾಲುಸ, ಮಿ ಘಾಲಲ ಜಾಲಮಾ ಕ್ಹಾಪ್ಡಸ. ಮಿ ತಿನೆ ಬಾಬೆಲೊನನೆ ಲೈನ ತಿನಾ ಕ್ಹಾತೆ ಬೊಲಿನ ತೆ ಮನೆ ಕರಲ ಅಪರಾದನೆ ತಿನಾಪರ ಘಾಲುಸ. <verse eid="EZK 17:20" /><verse number="21" style="v" sid="EZK 17:21" />ತಿನಿ ಸೆನಾ ಕ್ಹಾರಿ ಭಿಕ್ಹರೈನ ನ್ಹಾಟಿನ ಗೈನ ತಲ್ವಾರನೆ ಗುರಿಥಾವಸ; ಉಗ್ರಲವಾಲಾವೊನೆ ಕ್ಹಾರಿ ಜ಼ಗಾ ವಾರಾಮಾ ಭಿರಕೈ ಪಡುಸ; ಎ ವಾತ ಕದಲ ಯಹೊವಾ ಥಯಲ ಮಿಜ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 17:21" /></para>
  <para style="s">ಕ್ಹುದಾನಿ ವಾಗ್ದಾನನೊ ಬರೊಕ್ಹೊ</para>
  <para style="q1">
    <verse number="22" style="v" sid="EZK 17:22" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಿಜ ಉಚ್ಚು ಥಯಲ ದೆವದಾರು ಝಾಡನಾ ಉಪ್ಪರ ರ‍್ಹಯಲ ಟೊಂಗಿನೆ ಕಾಡಿನ ತಿನೆ ಗಾಡುಸ; ತುದಿನಾ ಟೊಂಗಿಯೊಮಾ ಕ್ಹಾರಾತಿ ಚೊಕು ರ‍್ಹಯಲ ಚಿವುಟಿ ಚೊಕು ರ‍್ಹಯಲ ಡೊಂಗರನಾ ಉಪ್ಪರ ಗಡೌಸ; <verse eid="EZK 17:22" /><verse number="23" style="v" sid="EZK 17:23" />ಮಿ ತಿನೆ ಇಸ್ರಾಯಲನಾ ಡೊಂಗರಪರ ಘಾಲಾನೆ ತೆ ಚೊಕು ರ‍್ಹಯಲ ದೆವದಾರು ಝಾಡ ಟೊಂಗಿಯೊನೆ ಫೈಲೈನ ಫಲ ದಿವಸ; ತಿಮಾ ಘನಾ ತರನಾ ಪಕ್ಷಿಯೊ ರ‍್ಹತಾ ತಿನಾ ಟೊಂಗಿಯೊನಿ ಛೌಲಿನು ಆಸ್ರೊ ಥಾವಸ. <verse eid="EZK 17:23" /><verse number="24" style="v" sid="EZK 17:24" />ತೆಲಾಮಾ ಯಹೊವಾ ಥಯಲ ಮಿ ಉಚ್ಚು ರ‍್ಹಯಲ ಬಗ್ಸಾಡಿ ಬಗ್ಗಲನೆ ಉಚ್ಚು ಕರಿನ ಹಸರ ರ‍್ಹಯಲನೆ ಕ್ಹುಕ್ಹೈನ ಕ್ಹುಕ್ಹಾಯಲನೆ ಬೆಳಸಾಯೊಸ ಕೈನ ಹರಯಕ್ಕ ಝಾಡೊ ತಿಳ್ದಸ;</para>
  <para style="p" vid="EZK 17:24">ಎ ಯಹೊವಾ ಥಯಲ ಮಿಜ ಕೈನ ಚಲಾಯೊಸ.<verse eid="EZK 17:24" /></para>
  <chapter eid="EZK 17" />
  <chapter number="18" style="c" sid="EZK 18" />
  <para style="s">ಖುದ್ದನಿ ಜವಾಬ್ದಾರಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 18:1" />ಯಹೊವಾ ವರಿಯಕ್ಕ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 18:1" /><verse number="2" style="v" sid="EZK 18:2" />ಬಾಪೊ ಕ್ಹಾಟಾ ದ್ರಾಕ್ಷಯೊ ಕ್ಹಾದ್ಯಾ, ಬಚ್ಚಾವೊನಾ ದಾತೊ ಜು಼ಮ್ಮ ಧರಲ ಕವಾನು ವಡಪ ತುಮೆ ಇಸ್ರಾಯಲ ದೆಶನಾಹುತಿ ಕವಾನು ಕಾ?<verse eid="EZK 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 18:3" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಾರಾ ಕ್ಹಮ್ಮಬಿ, ತುಮೆ ಎ ವಡಪನೆ ಇಸ್ರಾಯಲಮಾ ಹಜಿ ಉಚೌ ನೈ. <verse eid="EZK 18:3" /><verse number="4" style="v" sid="EZK 18:4" />ಹಮ್ನಾ ಘನಾ ನರ ಜಾನವರೊ ಮಾರಾಜ ವ್ಹೈ; ಬಾಪೊ ಸುವೈ, ಬಚ್ಚಾ ಸುವೈ, ನರನಾ ಜಾನವರೊ ಕ್ಹಾರಾ ಮಾರಾ ಅದಿಮಾ ಛೆ; ಪಾಪ ಕರಾನು ಜಾನವರ ಮರಸ.<verse eid="EZK 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 18:5" />ಯಕ್ಲೊ ಸದ್ದರ್ಮಿ ಥೈನ ನಿತಿನಾ ಫೈಸಲಾವೊನೆ ಕರಿನ <verse eid="EZK 18:5" /><verse number="6" style="v" sid="EZK 18:6" />ಡೊಂಗರೊನಾ ಉಪ್ಪರ ಎಡಿ ಕ್ಹಾಯೆವಾಚಿ ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾನಾ ವಿಗ್ರಹಕನ ದೆಕೆವಾಚಿ ಬಾಜು಼ವಾಲಾನಿ ಬೈಕೊನೆ ಕೆಡಸೆವಾಚಿ <verse eid="EZK 18:6" /><verse number="7" style="v" sid="EZK 18:7" />ಭಾರಿ ಥಯೆಲ ಬಾಕಡಿನಾ ಕ್ಹಾತೆ ಮಳೆವಾಚಿ ಕಿನೆಜ ತ್ರಾಸ ದಿದೆವಾಚಿ ಸಾಲಾಕರೆಲವಾಲೊ ವತ್ತಿನೆ ಬಿಗಿ ಧರೆವಾಚಿ ಕಿನು ಸೊತ್ತನೆ ಅಪಹರಸಿನ ಭುಕ್ಕ ಲಾಗಲವಾಲಾನೆ ಅನ್ನ ಘಾಲಿನ ಉಗಾಡೊ ರ‍್ಹಯಲವಾಲಾನೆ ಝಾಡಿ ವರಾಡಿನ <verse eid="EZK 18:7" /><verse number="8" style="v" sid="EZK 18:8" />ಸಾಲಾನೆ ಬಡ್ಡಿ ಲಿದೆವಾಚಿ ಫೈದಾನೆ ದೊಕ್ಡಾ ದಿದೆವಾಚಿ ಅನ್ಯಾಯನೆ ಹತ್ತ ಘಾಲೆವಾಚಿ ವಾದಿ ಹರಯಕ್ಕ ವಾದಿನೆ ಚೊಕಿತರಾ ಫೈಸಲೊ ಕರೊ <verse eid="EZK 18:8" /><verse number="9" style="v" sid="EZK 18:9" />ಮಾರಾ ನಿಯಮೊನೆ ಪಾಲ್ಸಿನ ಮಾರಾ ನಿಯಮೊನೆ ಪಾಲ್ಸಿನ ಚಾ಼ಲ್ಯಾರೆ ಹವೊ ಚೊ಼ಕು ಕಾಮ ಕರಾಲೊ ಥಾವಾನೆ ಜಿವ್ಸಸ ಎಜ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 18:9" /><verse number="10" style="v" sid="EZK 18:10" />ಹವೊ ಪಡ್ದಲ ದಿಕ್ರಾನೆ ಹಮ್ನಾ ಕದಲ ಕೆಟ್ಟ ಕಾಮೊಮಾ ಸುತಬಿ ಕರೊ <verse eid="EZK 18:10" /><verse number="11" style="v" sid="EZK 18:11" />ಚೊಕಾ ಕಾಮೊಮಾ ಸುತಬಿ ಕರೆವಾಚಿ ಡೊಂಗರೊಪರ ಎಡಿನೆ ಕ್ಹೈನ ಬಾಜು಼ ವಾಲಾನಿ ಬಾಕ್ಡಿನೆ ಕೆಡ್ಸಿನ <verse eid="EZK 18:11" /><verse number="12" style="v" sid="EZK 18:12" />ದಿನ ದರಿದ್ರನೆ ತ್ರಾಸ ಕರಿನ ಮನಕ್ಹೊನಾ ಸೊತ್ತನೆ ಅಪಹರಸಿನ ಸಾಲಾ ದಿವಾಲಾನೆ ವತ್ತಿನೆ ಬಿಗಿ ಧರಿನ ವಿಗ್ರಹವೊಕನ ಡೊಳೊ ಉಚೈನ ಅಸಹ್ಯ ಕಾಮೊನೆ ಕರಿನ <verse eid="EZK 18:12" /><verse number="13" style="v" sid="EZK 18:13" />ಸಾಲಾನೆ ಬಡ್ಡಿಲಿನ ಫೈದಾನೆ ದೊಕ್ಡಾದಿನ ಬಲಾತ್ಕಾರಿ ರಗತ ಚುವಾಲೊ ರ‍್ಹಯಾರೆ ಜಿವ್ಸಸ? ಆಂ ಕೆಟ್ಟ ಕಾಮೊ ಕರಲವಾಲೊ ಮರಸಜ; ತಿನಾ ಮೌತನೆ ತೆಜ ಕಾರಣ ವ್ಹೈ.<verse eid="EZK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 18:14" />ಹಮ್ನಾ ತೆ ಪಡದಲ ದಿಕ್ರೊ ಬಾಪ ಕಲ ಪಾಪೊನೆ ಕ್ಹಾರಾ ದೆಕಿನ ಬುಚ್ಕಿನ ಹವಾ ಕಾಮೊ ಕರೆವಾಚಿ <verse eid="EZK 18:14" /><verse number="15" style="v" sid="EZK 18:15" />ಡೊಂಗರೊಪರ ಎಡಿ ಕ್ಹಾಯೆವಾಚಿ ಇಸ್ರಾಯಲನಾ ವಂಶನಾ ವಿಗ್ರಹವೊನ ದೆಕೆವಾಚಿ ಬಾಜು಼ವಾಲಾನಿ ಬೈಕೊನೆ ಕೆಡ್ಸೆವಾಚಿ <verse eid="EZK 18:15" /><verse number="16" style="v" sid="EZK 18:16" />ಕಿನೆಬಿ ತ್ರಾಸ ದಿದೆವಾಚಿ ವತ್ತಿನೆ ಪುಚ್ಚೆವಾಚಿ ಕಿನಾ ಸೊತ್ತನೆ ಅಪಹರಸಿನ ಭುಕ್ಕ ಲಾಗಲವಾಲಾನೆ ಅನ್ನ ದಿದೆವಾಚಿ ಉಗಾಡಾ ರ‍್ಹಯಲವಾಲಾನೆ ಝಾಡಿ ವರಾಡಿನ <verse eid="EZK 18:16" /><verse number="17" style="v" sid="EZK 18:17" />ಗರಿಬನಾ ಉಪ್ಪರ ಹತ್ತ ಕರೆವಾಚಿ ಬಡ್ಡಿ ಪುಚ್ಚೆವಾಚಿ ಫೈದಾನೆ ದೊಕ್ಡಾ ದಿದೆವಾಚಿ ಮಾರಾ ವಿದಿಯೊನೆ ಕರಿನ ಮಾರಾ ನಿಯಮೊ ಪಾಲಶಾರೆ ಮಾರಾ ಬಾಪನಾ ಅಧರ್ಮನಾ ನಿಮಿತ್ತ ನೈ ಮರ್ತೊ, ಜಿವಸಸ. <verse eid="EZK 18:17" /><verse number="18" style="v" sid="EZK 18:18" />ಇನೊ ಬಾ ಕ್ಹುದ್ದನಾ ಕ್ಹಾಂದಾನಾ ಘನೊ ಅರದಿನ ಛಿಲ್ಲಿನ ಕ್ಹುದ್ದನಾ ಕ್ಹಾಂದಾನಾ ವಚ್ಮಾ ಕೆಟ್ಟ ಕಾಮೊ ಕರಲಕ್ಹು ಕಾರಣ ಹಮ್ನಾ, ಇನಾ ಅಧರ್ಮಕ್ಹುಜ ಮರಸ. <verse eid="EZK 18:18" /><verse number="19" style="v" sid="EZK 18:19" />ತೆನೈಸೊ ತುಮೆ ಬಾನಾ ದೊಷ ಫಲನೆ ದಿಕ್ರೊ ಕಿಮ್ಮ ಅನುಭವಿಸತೊ ನೈ ಕೈನ ಅಪೆಕ್ಷೆ ಕರೊಸಿತೊ? ದಿಕ್ರೊ ನಿತಿನಾ ಫೈಸಲಾನೆ ಕರಿನ ಮಾರಾ ವಿದಿಯೊನೆ ಚಾಲಿನ ಕರ್xಯಾರೆ ಜಿವ್ಸಸ. <verse eid="EZK 18:19" /><verse number="20" style="v" sid="EZK 18:20" />ಪಾಪಕರಾಲೊಜ಼ ಮರಸ; ದಿಕ್ರೊ ಬಾಪನಾ ದೊಷನಾ ಫಲನೆ ಅನುಭವ ಕರಸ, ಬಾಪ ದಿಕ್ರಾನು ದೊಷನಾ ಫಲನೆ ಅನುಭವ ಕರಸ; ಶಿಷ್ಟ ಶಿಷ್ಟನು ಫಲ ಶಿಷ್ಟನುಜ಼, ದುಷ್ಟ ದುಷ್ಟನೊ ಫಲ ದುಷ್ಟನುಜ.<verse eid="EZK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 18:21" />ತೆನೈಸೊ ದುಷ್ಟ ತೆ ಕರಾನಾ ಪಾಪೊ ಕ್ಹಾರಾ ಛೊಡಿನ ಮಾರಾ ವಿದಿಯೊನೆ ಚಾಲಿನ ನಿತಿನ್ಯಾಯನಾ ಕರ‍್ಯಾರೆ ನೈ ಮರತೊ, ಜಿವ್ಸಸ. <verse eid="EZK 18:21" /><verse number="22" style="v" sid="EZK 18:22" />ತೆ ಕರಲ ಕಯು ಅಪರಾದ ವ್ಹೈ ತಿನಾ ಇಸಾಬನೆ ಸೆರಸ, ತೆ ಕರಾನಾ ಸದ್ದರ್ಮಕ್ಹು ತೆ ಜಿವ್ಸಸ. <verse eid="EZK 18:22" /><verse number="23" style="v" sid="EZK 18:23" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ದುಷ್ಟನಾ ಮೌತತಮಾ ಮನೆ ಸುಜ಼ ಫೈದೊ ನೈ ರ‍್ಹೈತಬಿ ಕ್ಹುಶಿ ಛೆ? ತೆ ತಿನಾ ಕೆಟ್ಟ ವಾಟೊನೆ ಛೊಡಿನ ಜಿವ್ಸಾನು ಮನೆ ಕ್ಹುಶಿ ವ್ಹೈ. <verse eid="EZK 18:23" /><verse number="24" style="v" sid="EZK 18:24" />ತೆನೈಸೊ ಶಿಷ್ಟ ತಿನಾ ಶಿಷ್ಟತನಾನೆ ಛೊಡಿನ ಅಧರ್ಮನೆ ಕರಿನ ದುಷ್ಟ ಕರಾನಾ ಕೆಟ್ಟ ಕಾಮೊ ಕರ‍್ಯಾರೆ ತೆ ಜಿವ್ಸಸ? ತೆ ಕರಲ ಕಯಾ ಚೊಕಾ ಕಾಮೊ ತಿನಾ ಇಸಾಬನೆ ನೈ ಸೆರ್ತಾ, ತೆ ಕರಾನಾ ಪಾಪೊಕ್ಹುಜ ತೆ ಮರಸ.<verse eid="EZK 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 18:25" />ತೆನೈಸೊ ತುಮೆ ಕರ್ತಾನು ಕ್ರಮ ಸಮಾ ನತ್ತಿಕೈನ ಕವಾಡಾಸ; ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ, ಮಾರಾ ಕ್ರಮನೆ ಸಮಾ ನತ್ತಿಸು? ತುಮಾರು ಕ್ರಮ ಸಮಾ ನತ್ತಿ ತೆಕ್ಲುಜ. <verse eid="EZK 18:25" /><verse number="26" style="v" sid="EZK 18:26" />ಶಿಷ್ಟಾ ತಿನು ಶಿಷ್ಟತನ ಛೊಡಿನ ಅಧರ್ಮನೆ ಕರಿನ ತಿಮಾಜ ಮರ್ಯಾರೆ ತಿನಾಜ ಅಧರ್ಮಕ್ಹುಜ ಮರು ಲಾಗ್ಯು. <verse eid="EZK 18:26" /><verse number="27" style="v" sid="EZK 18:27" />ದುಷ್ಟ ತೆ ಕರಲ ದುಷ್ಟ ಕಾಮೊನೆ ಛೊಡಿನ ನಿತಿ ನ್ಯಾಯನೆ ಕರ‍್ಯಾರೆ ತಿನೊ ಜಲಮ ವಚಾ಼ಡಿ ಲಿವಸ. <verse eid="EZK 18:27" /><verse number="28" style="v" sid="EZK 18:28" />ತೆ ವಿಚಾರ ಕರಿನ ತೆ ಕರಾನು ಅಪರಾದೊನೆ ಛೊಡಲಕ್ಹು ನೈ ಮರ್ತೊ, ಜಿವ್ಸಸ. <verse eid="EZK 18:28" /><verse number="29" style="v" sid="EZK 18:29" />ತೆನೈಸೊ ಇಸ್ರಾಯಲ ವಂಶವಾಲಾ ಕರ್ತಾ ಕ್ರಮನೆ ಸಮಾ ನತ್ತಿ ಕೈನ ಕವಾಡಾಸ; ಇಸ್ರಾಯಲ ವಂಶವಾಲಾ, ಮಾರು ಕ್ರಮ ಸಮಾ ನತ್ತಿಸು? ತುಮಾರು ಕ್ರಮ ಸಮಾ ವ್ಹೈ.<verse eid="EZK 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 18:30" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಇಸ್ರಾಯಲ ವಂಶವಾಲಾ, ತುಮಾರಾ ತುಮಾರಾ ಚಾಲನಾ ತಕ್ಕ ತಿಮ್ಮಜ಼ ಮಿ ತುಮೊನೆ ತಿರ್ಪ ಕರುಸ; ಅಧರ್ಮ ತುಮೊನೆ ನಾಶ ಕರೆವಾಚಿ ಫರಿನ ತುಮಾರಾ ಅಪರಾದೊನೆ ಛೊಡಿಪಡೊ. <verse eid="EZK 18:30" /><verse number="31" style="v" sid="EZK 18:31" />ತುಮೆ ಕರ್ತಾ ಆಯಲ ಅಪರಾದೊನೆ ತುಮಾರಾಮಾತು ಛೊಡೈನ ತುಮಾರಾ ಮನಸೊನೆ ಸ್ವಬಾವನೆ ಚೊಕಾ ಕರಲಿವೊ; ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ , ತುಮೆ ಕಾ ಮರ್ತಾ ನೈ? <verse eid="EZK 18:31" /><verse number="32" style="v" sid="EZK 18:32" />ಮರಾಲಾನಾ ಮೌತಮಾ ಮನೆ ಕ್ಹುಶಿ ನತ್ತಿ; ಪಾಪೊಕ್ಹು ಫರಿನ ಜಿವ್ಸೊ; ಆಂ ಕರ್ತಾ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 18:32" /></para>
  <chapter eid="EZK 18" />
  <chapter number="19" style="c" sid="EZK 19" />
  <para style="s">ಇಸ್ರೆಯೆಲನಾ ರಾಜಾ಼ನಾ ಹುತಿ ದುಖನು ಗಿದ್ದ</para>
  <para style="q1">
    <verse number="1" style="v" sid="EZK 19:1" />ಇಸ್ರಾಯಲನೊ ಪ್ರಬುವೊನಾ ವಿಷಯಮಾ ಆಂ ಶೊಕ ಗಿದ್ದನೆ ಉಚಾ. <verse eid="EZK 19:1" /><verse number="2" style="v" sid="EZK 19:2" />ಆಹಾ, ತಾರಿಯಾ ಸಿಂಹಾಡಾವೊಮಾನಿ ಸಿಂಹಾಡೊ ವ್ಹೈ, ಪ್ರಾಯನಾ ಸಿಂಹಾಡಾನಾ ವಚ್ಮಾ ಕ್ಹುರೈತಿ, ಬಚ್ಚಾವೊನೆ ರಾಕಿ. <verse eid="EZK 19:2" /><verse number="3" style="v" sid="EZK 19:3" />ತೆ ಬೆಳಸಲ ಯಕ್ಕ ಬಚ್ಚು ಪ್ರಾಯನಾ ಸಿಂಹಾಡೊ ಥೈನ ಸಿಕಾರ ಕರಾನು ಶಿಕ್ಕಿನ ಮನಕ್ಹೊನೆ ಗಳಾನೆ ಚಾಲುಕರ್ಯು. <verse eid="EZK 19:3" /><verse number="4" style="v" sid="EZK 19:4" />ಮನಕ್ಹೊ ಕ್ಹಾರಾ ಆಂ ಸುದ್ದಿ ಐಕಿನ ತಿನೆ ಮ್ಹೊಟಿ ಖಾಡಿ ಕರಿನ ತಿಮಾ ತೆ ಪಡ್ಯೊ. ತಿನೆ ಸರಪಣಿಯೊಕ್ಹು ಬಿಗ್ದಿನ ಐಗುಪ್ತ ದೆಶನೆ ಲಿನ ಗಯಾ. <verse eid="EZK 19:4" /><verse number="5" style="v" sid="EZK 19:5" />ತೆ ಸಿಂಹಾಡೊ ಕಾಯ್ದೊತೊ ರೈತಬಿ ತಿನಿ ನಿರಿಕ್ಷಾ ಹಾಳ ಥಯು ಕೈನ ತಿನಾ ಬಚ್ಚಾವೊಮಾ ಹಜಿಯಕ್ಕನೆ ಕಾಡಿನ ರಾಕಿನ ಮ್ಹೊಟೊ ಕರಿ. <verse eid="EZK 19:5" /><verse number="6" style="v" sid="EZK 19:6" />ತೆ ಪ್ರಾಯನೊ ಸಿಂಹಾಡೊ ಥೈನ ಸಿಂಹಾಡಾನಾ ವಚ್ಮಾ ಫರ್ತು ಸಿಕಾರ ಕರಾನು ಶಿಕ್ಕಿನ ಮನಕ್ಹೊನೆ ಖಾವಾನು ಶುರು ಕರ್‍ಯು. <verse eid="EZK 19:6" /><verse number="7" style="v" sid="EZK 19:7" />ತೆ ಗಾಮೊನೆ ಹಾಳ ಕರಿನ ಘನಾ ಜನಾ ರಾಂಡಿಯೊ ರ‍್ಹಯಲವಾಲಿಯೊನೆ ಕೆಡಶ್ಯೊ, ತಿನಾ ಅಡ್ಡಾನಾ ಅವಾಜಕ್ಹು ದೆಶಬಿ ತಿಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರು ಕ್ಷಿಣ ಥಯು. <verse eid="EZK 19:7" /><verse number="8" style="v" sid="EZK 19:8" />ತೆಳಾಮಾ ಜನಾಂಗೊ ಸುತ್ತೆನಾ ಗಾಮೊತಿ ಮಳಿನ ಐನ ತಿನೆ ವಿರುದ್ದ ಥೈನ ಹುಬ್ರೈನ ಜಾಲ ಘಾಲಿನ ಕ್ಹಾಡಿ ಕ್ಹಂದಾನೆ ತ್ಯಾ ಮಳ್ಯು. <verse eid="EZK 19:8" /><verse number="9" style="v" sid="EZK 19:9" />ತೆ ತಿನೆ ಸರಪಣಿಯೊಕ್ಹು ಬಿಗ್ದಿನ ಪಿಂಜರಾಮಾ ಘಾಲಿನ ಬಾಬೆಲೊನನಾ ರಾಜಾ಼ಕನ ಲಾಯಾ. ತಿನಿ ಅವಾಜ ಇಸ್ರಾಯಲನಾ ಡೊಂಗರೊಮಾ ಹಜಿ ಐಕು ಆವಾ ವರಕ್ಹು ತಿನೆ ಬಂದನಮಾ ಮ್ಹೆಲ್ಯಾ. <verse eid="EZK 19:9" /><verse number="10" style="v" sid="EZK 19:10" />ತುನೆ ಜ಼ನ್ನಲ ಮಾ ನಿರಾವರಿಮಾ ನಾಟಿನ ದ್ರಾಕ್ಷಿನಿ ಬಳ್ಳಿ ಥಯಿತಿ ತೆ ಬಳ್ಳಿ ಘನಾ ತಂಪಕ್ಹು ಫಲ ವರಿ ಪೊದೆ ಥೈನ ಬೆಳದ್ಯುತು. <verse eid="EZK 19:10" /><verse number="11" style="v" sid="EZK 19:11" />ತಿಮಾ ರಾಜಾ ದಂಡನಾ ಯೊಗ್ಯ ಥಯಲ ಘಟ್ಟ ಗೊಂಬಿಯೊ ವ್ಹತ್ತಾ, ತಿನು ಉಚ್ಚು ಬಿಜಾ ರೆಂಬೆಯೊತಿಬಿ ಹೆಚ್ಚ ವ್ಹತ್ತು. ಘನಾ ರೆಂಬೆಯೊನಾ ವಚ್ಮಾ ಲಾಂಬಾ ಥೈನ ದಿಕ್ಹ್ಯಾ. <verse eid="EZK 19:11" /><verse number="12" style="v" sid="EZK 19:12" />ತೆ ಲತೆನಾ ಕ್ರೊದಿಯೊ ಕಿತ್ತಿನ ಜಿಮಿನ್ಪರ ನಾಕಿ ಪಡ್ಯಾ. ಪುರ್ವ ಬಗಲತೊ ವಾರೊ ತಿನಾ ಫಲನೆ ಹಾಳ ಕರಿ. ತಿನಾ ಘಟ್ಟ ಗೊಂಬಿಯೊ ತುಟಿನ ವರೈಗಯಾ. ಆಗ ತಿನೆ ಗಳಿಪಡಿ. <verse eid="EZK 19:12" /><verse number="13" style="v" sid="EZK 19:13" />ಹಮ್ನಾ ತೆ ಪಾನಿ ನೈ ರ‍್ಹಯಲ ಹಾಳ ಜ಼ಗಾ ನಾಟಿ ಗಡಾಯೊಸ. <verse eid="EZK 19:13" /><verse number="14" style="v" sid="EZK 19:14" />ಆಗ ದಂಡನಾ ರುಪ ಥಯಲ ತಿನಿ ಝಳಾಕ್ಹು ಗೈನ ತಿನು ಫಲ ಗಳಲಕ್ಹು ರಾಜ ದಂಡನೆ ಯೊಗ್ಯ ಥಯಲ ಕಯಾ ಘಟ್ಟ ಕೊಂಬಿಯೊ ತಿಮಾ ಉಗ್ರ್ಯಾ ನತ್ತಿ.</para>
  <para style="p" vid="EZK 19:14">ಆಂ ದುಖ ಗಿದ್ದ ವ್ಹೈ ಆಂ ದುಖ ಗಿದ್ದ ಛೆ.<verse eid="EZK 19:14" /></para>
  <chapter eid="EZK 19" />
  <chapter number="20" style="c" sid="EZK 20" />
  <para style="s">ಕ್ಹುದಾನಿ ಚಿತ್ತ ವರಿ ಮನಕ್ಹನು ಪ್ರತಿಭಟನಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 20:1" />ಯೆಹೊಯಾಖಿಯನ ಜೆಲ್ಮಾ ರ‍್ಹಯಲ ಕ್ಹಾತವಾ ವರಕ್ಹನಾ ಪಾಂಚ಼ವಾ ಮ್ಹೈನಾನಾ ದಕ್ಹವಾ ದಿನ್ನಮಾ ಇಸ್ರಯಲನಾ ಮ್ಹೊಟಾವೊಮಾ ದಕ್ಹಾಜನಾ ಯಹೊವಾನೆ ಪ್ರಶ್ನೆ ಪುಚ್ಚಾನೆ ಐನ ಮಾರಾ ಕ್ಹಾಮಾ ಬೈಟ್ಯಾ. <verse eid="EZK 20:1" /><verse number="2" style="v" sid="EZK 20:2" />ತೆಳಾಮಾ ಯಹೊವಾ ಆಂ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 20:2" /><verse number="3" style="v" sid="EZK 20:3" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ ಇಸ್ರಾಯಲನಾ ಮ್ಹೊಟಾವೊಮಾ ತಿಳಸೈನ ಅಮ್ಮ ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮನೆ ಪ್ರಶ್ನೆ ಪುಚ್ಚಾನೆ ಆಯಾಸು? ಮಾರಾ ಕ್ಹಮ್ಮಬಿ, ಮಿ ತುಮೊನೆ ಉತ್ತರ ನೈ ದೆತೊ; ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 20:3" /><verse number="4" style="v" sid="EZK 20:4" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಇವ್ನೊನೆ ಫೈಸಲೊ ಕರಾನೆ ತಾರು ಮನಸ ತಯ್ಯಾರ ಛೆ? ಇವ್ನಾ ಪಿತೃವೊನು ಕೆಟ್ಟ ಕಾಮ ಇವ್ನೊನೆ ಅಮ್ಮ ಕೆ <verse eid="EZK 20:4" /><verse number="5" style="v" sid="EZK 20:5" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ. ಕಯಾ ದಿನಮಾ ಮಿ ಇಸ್ರಾಯಲೊನೆ ಇನಿಲಿನ ಯಾಕೊಬ ಕ್ಹಾಂದಾನವಾಲಾವೊನೆ ವಾತ ದಿದಲ ಮಿ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ಐಗುಪ್ತ ದೆಶಮಾ ಪ್ರಮಾಣ ಕರಿನ ತಿಳಸಾಯೊಸು <verse eid="EZK 20:5" /><verse number="6" style="v" sid="EZK 20:6" />ಕ್ಹಾರಾ ದೆಶೊತಿ ಸುಂದರ ಥಯಲ ದೆಶನೆ ತುಮೊನೆ ದೆಕ್ಯೊಸ; ಮಿ ತುಮೊನೆ ಐಗುಪ್ತ ದೆಶತೊ ಉದ್ದಾರ ಕರಿನ ದುದ್ದ ಜೆನ ವೈನ ಜಾವಾನಾ ತೆ ದೆಶನೆ ವಳೌಸ ಕೈನ ವಾತ ದಿದ್ಯೊಸ. <verse eid="EZK 20:6" /><verse number="7" style="v" sid="EZK 20:7" />ತುಮೆ ಕ್ಹಾರಾ ತುಮಾರಾ ಡೊಳಾವೊನೆ ಪಸಂದ ರ‍್ಹಯಲ ಅಸಹ್ಯ ಸಾಮ್ನೊನೆ ಭಿರಕೈ ಪಡೊ, ಐಗುಪ್ತನಾ ವಿಗ್ರಹೊಕ್ಹು ತುಮೊನೆ ಹೊಲಸ ಕರಲಿವೊ ನಕೊ; ಮಿ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ವ್ಹೈ ಕವಾನು ತ್ಯುನೊನೆ ಹುಶಾರ ಕರ್ಯೊ. <verse eid="EZK 20:7" /><verse number="8" style="v" sid="EZK 20:8" />ತ್ಯುನೆ ರ‍್ಹೈತಬಿ ಮಾರಾ ವಾತೊ ಐಕ್ಯಾವಾಚಿ ಮಾರಾ ಉಪ್ಪರ ಫರಿನ ಪಡ್ಯಾ; ತ್ಯುನಾ ಡೊಳಾನೆ ಪಸಂದ ರ‍್ಹಯಲ ಅಸಹ್ಯ ಸಾಮ್ನೊನೆ ಕುನ್ನಜ ಭಿರಕಾಯಾ ನೈ. ಐಗುಪ್ತನಾ ವಿಗ್ರಹೊನೆ ಇನ್ಕಾರ ಕರ‍್ಯಾ ನೈ; ತೆಳಾಮಾ ಮಿ ಇವ್ನಾ ಉಪ್ಪರ ಐಗುಪ್ತ ದೆಶನಾ ಮ್ಹೈ ಮಾರಿ ರೊಷಾ ಅಗ್ನಿನೆ ರಿಚೈನ ಮಾರಿ ಶಿಟ್ಟನೆ ತಿರಸಿ ಲ್ಯುಸ ಕೈಲಿದ್ಯೊ. <verse eid="EZK 20:8" /><verse number="9" style="v" sid="EZK 20:9" />ತೆನೈಸೊ ತುಮೊನೆ ಐಗುಪ್ತ ದೆಶಮಾತೊ ಪಾರ ಕರುಸ ಕವಾನು ಜನಾಂಗ ಕ್ಹಾಮು ಮನೆ ಇವ್ನೊನೆ ಪ್ರಕಟ ಕರಲಿದ್ಯೊತೊ ಕೈನ ವಿಚಾರ ಕರಿನ ತ್ಯುನಾ ಸುತ್ತೆ ತೆ ಜನಾಂಗ ಕ್ಹಾಮಾ ಮಾರು ನಾಮ ಅಪ ಕಿರ್ತಿನೆ ಗುರಿ ಥಯೆವಾಚಿ ಮಾರಾ ನಾಮನಾ ನಿಮಿತ್ತ ಸಹಿಸಿ ಲಿದ್ಯೊ.<verse eid="EZK 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 20:10" />ತೆಳಾಮಾ ಮಿ ತ್ಯುನೊನೆ ಐಗುಪ್ತ ದೆಶಮಾತೊ ಛೊಡೈನ ಜಂಗಲನೆ ಬಲೈಲಾವಾನೆ <verse eid="EZK 20:10" /><verse number="11" style="v" sid="EZK 20:11" />ಪಾಲ್ಸಾವಾಲಾವೊನೆ ಜಿವ ಧಾರ ಥಯಲ ಮಾರಾ ಆಗನ್ಯಾ ವಿದಿಯೊನೆ ತ್ಯುನೊನೆ ತಿಳಸೈನ ದಿದ್ಯೊ. <verse eid="EZK 20:11" /><verse number="12" style="v" sid="EZK 20:12" />ತೆನೈಸೊ ಹಮೊನೆ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊ ಥಯನ ಕರಲ ಯಹೊವಾ ಮಿಜ ವ್ಹೈ ಕವಾನು ತ್ಯುನೆ ತಿಳ್ದಿಲಿಯು ಕೈನ ಮನೆ ವರಿ ತ್ಯುನೊನೆ ಗುರತ ಥಯಲ ಸಬ್ಬತ ದಿನೊನೆ ತ್ಯುನೊನೆ ನೆಮಸ್ಯೊ. <verse eid="EZK 20:12" /><verse number="13" style="v" sid="EZK 20:13" />ತೆನೈಸೊ ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ ಜಂಗಲಮಾ ಮಾರಾ ಉಪ್ಪರ ಫರಿನ ಪಡ್ಯಾ. ಪಾಲ್ಸಾವಾಲಾವೊನೆ ಜಿವ ಧಾರನೆ ಮಾರಾ ಆಗನ್ಯಾನಾ ವಿದಿಯೊನೆ ಪಾಲ್ಸಾವಾಚಿ ಇನ್ಕಾರ ಕರ‍್ಯಾ. ಮಿ ನೆಮ್ಸಲ ಸಬ್ಬತ ದಿನೊನೆ ಕ್ಹಾಸ ಕರಿನ ಹೊ ಕರ‍್ಯಾ; ತೆಳಾಮಾ ಮಿ ತ್ಯುನಾಪರ ಜಂಗಲಮಾ ಮಾರಿ ರೊಷಾ ಅಗ್ನಿನೆ ರಿಚೈನ ಇವ್ನೊನೆ ಧ್ವಂಸ ಕರುಸ ಕೈನ ಕೈಲಿದ್ಯೊ. <verse eid="EZK 20:13" /><verse number="14" style="v" sid="EZK 20:14" />ವರಿಬಿ ತಿನಾಹುತಿ ಕಯಾ ಜನಾಂಗನಾ ಕ್ಹಾಮೊ ತ್ಯುನೊನೆ ಪಾರ ಕರ‍್ಯೊಸತೊ ತೆ ಜನಾಂಗನಾ ಕ್ಹಾಮೊ ಮಾರು ನಾಮ ಅಪಕಿರ್ತಿನೆ ಗುರಿ ಥವು ನೈಕೈನ ಮಾರಾ ನಾಮನಾ ನಿಮಿತ್ತಜ ತಡದಿಲಿದ್ಯೊ. <verse eid="EZK 20:14" /><verse number="15" style="v" sid="EZK 20:15" />ಪಾಚಾ಼ತೊ ಘಾನಾ ದೆಶೊ ಶಿರಮಣಿ ಥಯಲ ಕಯಾ ದೆಶನೆ ತ್ಯುನೊನೆ ವಾಗ್ದಾನ ಕರ್ಯೊ ದುದ್ದ ವರಿ ಜೆನ ಜಾವಾನಾ ತುಮೊನೆ ತೆ ದೆಶೆ ಸೆರಸು ಕೈನ ಜಂಗಲಮಾ ತ್ಯುನೊನೆ ಪ್ರಮಾಣ ಕರ‍್ಯೊ. <verse eid="EZK 20:15" /><verse number="16" style="v" sid="EZK 20:16" />ಕಾ ಕದ್ಯಾಮ ತ್ಯುನು ಮನಸ ತ್ಯುನಾ ಮೊರ್ತಿಯೊಮಾ ಆಸಕ್ತಿಕ್ಹು ತ್ಯುನೆ ಮಾರಾ ಆಗನ್ಯಾ ವಿದಿಯೊನೆ ಪಾಲ್ಶಾವಾಚಿ ಇನ್ಕಾರ ಕರಿನ ಮಿ ನೆಮ್ಸಲ ಸಬ್ಬತ ದಿನೊನೆ ಹೊಲೆ ಕರಾಲಾ ಥಯಾತಾ. <verse eid="EZK 20:16" /><verse number="17" style="v" sid="EZK 20:17" />ತೆನೈಸೊ ಮಿ ತ್ಯುನೊನೆ ನಾಶ ಕರೆವಾಚಿ ತಿಮ್ಮಜ಼ ಮಾರಿ ಕಾಳಜಿ ತ್ಯುನೊನೆ ವಚಾ಼ಡಿ; ಮಿ ತ್ಯುನೊನೆ ಜಂಗಲಮಾ ನಾಶ ಕರ್ಯೊ ನೈ.<verse eid="EZK 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 20:18" />ಪಾಚಾ಼ತೊ ಮಿ ಜಂಗಲಮಾ ತ್ಯುನಾ ಕ್ಹಾಂದಾನವಾಲಾವೊನೆ ತುಮೆ ತುಮಾರಾ ಬಾಪೊನಾ ಆಗನ್ಯಾವಿದಿಯೊನೆ ಪಾಲ್ಸೆವಾಚಿ ತ್ಯುನಾ ವಿದಿಯೊನೆ ಪಾಲ್ಸೆವಾಚಿ ತ್ಯುನಾ ಗೊಂಬಿಯೊಕ್ಹು ತುಮೊನೆ ಹೊಲಸ ಕರಲೆಯೆವಾಚಿ ರ‍್ಹೌ; <verse eid="EZK 20:18" /><verse number="19" style="v" sid="EZK 20:19" />ಮಿ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ವ್ಹೈ; ತುಮೆ ಮಾರಾ ಆಗನ್ಯಾವೊನೆ ಪಾಲ್ಸಿನ ಮಾರಾ ವಿದಿಯೊನೆ ಚಾಲಿನ ರ‍್ಹವೊ; <verse eid="EZK 20:19" /><verse number="20" style="v" sid="EZK 20:20" />ಮಿ ನೆಮ್ಸಲ ಸಬ್ಬತ ದಿನೊನೆ ಮಾರಾ ದಿನೊ ವ್ಹೈಕೈನ ಕರೊ; ಮಿ ತುಮಾರೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೆ ತಿಳದಿ ಲಿವು ಕೈನ ತೆ ತುಮೊನೆ ವರಿ ಮನೆ ಗುರತ ಥಾವಾಸ ಕೈನ ಕದ್ಯೊ.<verse eid="EZK 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 20:21" />ತೆ ಕ್ಹಾಂದಾನವಾಲಾ ಮಾರಾ ಉಪ್ಪರ ಫರಿನ ಪಡ್ಯಾ; ಮಾರಾ ಆಗನ್ಯಾವೊನೆ ಪಾಲ್ಸ್ಯಾ ನೈ; ಚಾಲಲವಾಲಾವೊನೆ ಜಿವ ಧಾರ ಥಯಲ ಮಾರಾ ವಿದಿಯೊನೆ ಚಾಲಿನ ಕರ‍್ಯಾ ನೈ; ಮಿ ನೆಮ್ಸಲ ಸಬ್ಬತ ದಿನೊನೆ ಹೊಲೆ ಕರ‍್ಯಾ; ತಿನಾಹುತಿ ಮಿ ಜಂಗಲಮಾ ಇವ್ನಾಪರ ಮಾರಿ ರೊಷಾ ಅಗ್ನಿನೆ ರಿಚೈನ ಮಾರಿ ಶಿಟ್ಟ ತಿರಸಿ ಲಿಯುಸ ಕೈ ಲಿದ್ಯೊ <verse eid="EZK 20:21" /><verse number="22" style="v" sid="EZK 20:22" />ತೆನೈಸೊ ಮಿ ತ್ಯುನೊನೆ ಕಯಾ ಜನಾಂಗನಾ ಕ್ಹಾಮೊ ಪಾರ ಕರ‍್ಯೊಸ ತೆ ಜನಾಂಗನಾ ಕ್ಹಾಮೊ ಮಾರು ನಾಮ ಕೆಟ್ಟು ನೈ ಕೈನ ಮಾರಾ ನಾಮನಾ ಹುತಿ ತಡ್ದಿಲಿನ ಹತ್ತ ಪಾಚೊ ಸರಕೈ ಲಿದ್ಯೊ. <verse eid="EZK 20:22" /><verse number="23" style="v" sid="EZK 20:23" />ಮಿ ತುಮೊನೆ ಜನಾಂಗೊಮಾ ಭಿಕ್ಹರೈನ ದೆಶದೆಶೊನೆ ತುರಿ ಪಡುಸ ಕೈನ ಜಂಗಲಮಾ ತ್ಯುನೊನೆ ಪ್ರಮಾಣ ಕರ‍್ಯೊಸ. <verse eid="EZK 20:23" /><verse number="24" style="v" sid="EZK 20:24" />ಪಾಚಾ಼ತೊ ತ್ಯುನೆ ಮಾರಾ ಆಗನ್ಯಾವೊನೆ ನೈ ಚಾಲಿನ ಮಾರಾ ವಿದಿಯೊನೆ ಇನ್ಕಾರಿನ ಮಿ ನೆಮ್ಸಲ ಸಬ್ಬತ ದಿನೊನೆ ಹೊಲೆ ಕರಿನ ತ್ಯುನಾ ಪಿತೃವೊನಾ ಗೊಂಬಿಯೊನಾ ಉಪ್ಪರ ಡೊಳೊ ಘಾಲಲಕ್ಹು<verse eid="EZK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 20:25" />ತೆನೈಸೊ ಮಿಜ ಮಿ ತ್ಯುನೊನೆ ಆಗನ್ಯಾವೊನೆ ಜಿವ ಧಾರವಾಚಿ ವಿದಿಯೊನೆ ಹಿತರ‍್ಹಯಲ ಅಗನ್ಯಾ ದಿದ್ಯೊ <verse eid="EZK 20:25" /><verse number="26" style="v" sid="EZK 20:26" />ತ್ಯುನೆ ತ್ಯುನು ಪಸ್ಟ ಬಚ್ಚಾವೊನೆ ಆಹುತಿ ದಿನ ಚಡಾಯಲ ಬಲಿಕ್ಹು ತ್ಯುನೊನೆ ಹೊಲೆ ನೈ ಕರಿನ ಕೆಟ್ಟ ಪರಸ್ಥಿತಿನೆ ಲಾಯೊ. ತ್ಯುನೆ ಮಿ ಯಹೊವಾ ವ್ಹೈ ಕವಾಹುತಿ ಮಿ ಇಮ್ಮ ಕರ‍್ಯೊ. <verse eid="EZK 20:26" /><verse number="27" style="v" sid="EZK 20:27" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಇಸ್ರಾಯಲ ವಂಶವಾಲಾವೊನೆ ಎ ವಾತ ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತುಮಾರಾ ಪಿತೃವೊ ಹಜಿಯಕ್ಕ ದ್ರೊಹ ಕರಿನ ಮನೆ ದೊಷ ದಿದ್ಯಾಸ. <verse eid="EZK 20:27" /><verse number="28" style="v" sid="EZK 20:28" />ಮಿ ಪ್ರಮಾಣ ಪೂರ್ವಕ ಥೈನ ತ್ಯುನೊನೆ ವಾಗ್ದಾನ ಕರಲ ದೆಶೆನೆ ಸೆರಸಲಪರ ತ್ಯುನಾ ಉಚ್ಚಾ ಥಯಲ ಕ್ಹಾರಾ ಡೊಂಗರೊನೆ ಚೊಕಾ ಥೈನ ಉಟಲ ಕ್ಹಾರಾ ಝಾಡೊನೆ ದೆಕಿನ ತ್ಯಾ ಬಲಿನಾ ಪಶುನೆ ವದಿಸಿನ ಮನೆ ಶಿಟ್ಟ ಆವಾನಾ ನೈವದ್ಯನೆ ಚಡೈನ ಚೊಕಿ ಬಾಸನು ಹೊಮಾ ಕರಿನ ಪಾನ ದ್ರವ್ಯನೆ ರಿಚೈನ ವಪ್ಸಾವಾಡಾತಾ. <verse eid="EZK 20:28" /><verse number="29" style="v" sid="EZK 20:29" />ತುಮೆ ಜಾವಾನಾ ಬಾ ಮಾ ಕವಾನಾ ಪೂಜಾನಿ ಜ಼ಗಾ ಸು ಜ಼ಗಾ ಹಮ್ನಾಲಕ್ಕಾ ಹವಾ ಪೂಜಾನಾ ಜ಼ಗಾವೊನೆ ಬಾಮಾ ಇಬ್ರಿಯ ಜಾತಾಮಾ ಬಾಮಾ ಕವಾನಾ ಶಬ್ದಾನೆ ಜಾ ಸು ಕವಾನು ಅರ್ಥ ವ್ಹೈ. ಕವಾನು ನಾಮ ವ್ಹೈ. <verse eid="EZK 20:29" /><verse number="30" style="v" sid="EZK 20:30" />ಇಸ್ರಾಯಲ ವಂಶವಾಲಾವೊನೆ ಅಮ್ಮ ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತುಮಾರಾ ಪಿತೃವೊ ನಿಂಗತ ತುಮೊನೆ ತುಮೆಜ ಹೊಲಸ ಕರಲಿವಾಡಾಸ? ತ್ಯುನಾ ಪೂಜಾ ಕರಾ ಅಸಹ್ಯ ಸಾಮ್ನೊನೆ ತುಮೆಬಿ ಪೂಜಾ ಕರಿನ ದೆವದ್ರೊಹ ಕರೊಸಿತೊ? <verse eid="EZK 20:30" /><verse number="31" style="v" sid="EZK 20:31" />ತುಮೆ ಬಲಿ ಚಡಾತಾ ತುಮಾರಾ ಬಚ್ಚಾವೊನೆ ಆಹುತಿನೆ ದಿನ ಹಮ್ನಾ ಲಕ್ಕಾ ತುಮೊನೆ ಅಶುದ್ದ ಕರಲಿವಾಡಾಸ? ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ, ಮಿ ತುಮಾರಾ ಹವಾವೊನೆ ಕ್ಹುದಾನು ಉತ್ತರ ದೆಸಕುಸ? ಮಾರಾ ಕಮ್ಮಬಿ, ತುಮೊನೆ ಕ್ಹುದಾನು ಉತ್ತರ ದಿದ್ಯೊಸ; ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 20:31" /><verse number="32" style="v" sid="EZK 20:32" />ಮಿ ಜನಾಂಗ ನಿಂಗತ , ಬಿಜಾ ದೆಶವಾಲಾ ನಿಂಗತ ಝಾಡ ವರಿ ದಗ್ಡಾವೊನಾ ಗೊಂಬಿಯೊನೆ ಪೂಜಾ ಕರಯೆಸ ಕೈನ ತುಮಾರಾ ಮನಸಮಾ ಹುಟ್ಟಾನು ವಿಚಾರ ಕೆಕ್ಲು ವ್ಹೈ ಸಾಗತು ನೈ.<verse eid="EZK 20:32" /></para>
  <para style="s">ಶಿಕ್ಷಾ ದಿವಾಲೊ ವರಿ ಮಾಫ ಕರಾಲೊ ಕ್ಹುದಾ</para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 20:33" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಾರಾ ಕ್ಹಮ್ಮಬಿ ಮಿ ಶಿಕ್ಷಾ ಹಸ್ತನೆ ಉಚೈನ ಬುಜ್ಜೊ಼ನಿ ತಾಕತ ದೆಕಾಡಿನ ರೊಷಾನಿ ಅಗ್ನಿನೆ ರಿಚಾತೊ ತುಮಾರಾ ಉಪ್ಪರ ದೊರೆತನಾ ಕರುಸ. <verse eid="EZK 20:33" /><verse number="34" style="v" sid="EZK 20:34" />ಹೊ, ಮಿ ಶಿಕ್ಷಾ ಹಸ್ತನೆ ಉಚೈನ ಬುಜ ಪರಾಕ್ರಮನೆ ದೆಕಾಡಿನ ರೊಷಾ ಅಗ್ನಿನೆ ರಿಚಾತೊ ತುಮೊನೆ ಜನಾಂಗೊಮಾತೊ ಪಾರ ಕರಿನ ತುಮೆ ಭಿಕ್ಹರೈ ಗಯಲ <verse eid="EZK 20:34" /><verse number="35" style="v" sid="EZK 20:35" />ದೆಶೊಮಾತೊ ತುಮೊನೆ ಮಳೈನ ಜನಾಂಗೊನಾ ವಚ್ಮಾನಾ ಜಂಗಲನೆ ಬಲೈನ ತ್ಯಾಜ ಯದ್ರಾ ಬದ್ರಾ ಥೈನ ವಾದಸುಸ. <verse eid="EZK 20:35" /><verse number="36" style="v" sid="EZK 20:36" />ಮಿ ಐಗುಪ್ತನಾ ಜಂಗಲಮಾ ತುಮಾರಾ ಪಿತೃವೊನಾ ಕ್ಹಾತೆ ವಾದಸಲ ನಿಂಗತ ತುಮಾರಾ ಕ್ಹಾತೆಬಿ ವಾದಸುಸ; ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 20:36" /><verse number="37" style="v" sid="EZK 20:37" />ಮಿ ತುಮೊನೆ ಇಸಾಬ ಕರಾ ವರಕ್ಹು ಲಾಕ್ಡಿನಾ ಹೆಟಾ ಧವಾಡೊ ಕರಿನ ಒಡಂಬಡಿಕೆನಾ ಕಟ್ಟಕ್ಹು ಭಾಂದಿನ ಮನೆ ಫರಿನ ಪಡ್ಯಾ <verse eid="EZK 20:37" /><verse number="38" style="v" sid="EZK 20:38" />ದ್ರೊಹಿಯೊ ಥಯಲವಾಲಾವೊನೆ ತುಮಾರಾಮಾತೊ ಝಾಡಿಪಡುಸ; ತ್ಯುನೆ ಪ್ರಸಿದ್ದಿಯೊ ಥೈನ ದೆಶತೊ ಮಿ ತ್ಯುನೊನೆ ಪಾರ ಕರಿತಬಿ ತ್ಯುನೆ ಇಸ್ರಾಯಲ ದೆಶೆ ಜಾತಾಜ ನೈ; ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="EZK 20:39" />ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ, ಕತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಜಾವೊ ತುಮರ ಗೊಂಬಿಯೊನೆ ಲಿವೊ; ಅಗಾತೊ ಮಾರಿ ವಾತ ಐಕೊಸಿಜ, ಇನಾ ಉಪ್ಪರ ಮಾರಾ ಪರಿಶುದ್ದ ನಾಮನೆ ತುಮಾರಾ ಬಲಿಯೊಕ್ಹುಬಿ ವರಿ ಗೊಂಬಿಯೊಕ್ಹುಬಿ ತುಮೆ ಅಪಕಿರ್ತಿನೆ ಗುರಿ ಕರ್ತಾ ನೈ. <verse eid="EZK 20:39" /><verse number="40" style="v" sid="EZK 20:40" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ದೆಶಮಾ ಇಸ್ರಾಯಲ ವಂಶನಾ ಕ್ಹಾರಾ ಮಾರಾ ಪರಿಶುದ್ದ ಡೊಂಗರಪರ, ಇಸ್ರಾಯಲನಾ ಡೊಂಗರೊಪರ ಮನೆ ಮಳೈ ಲಿವಸ; ತ್ಯಾಜ ತ್ಯುನೊನೆ ಪ್ರಸನ್ನ ಥೌಸ, ತ್ಯಾಜ ತುಮಾರಾ ಕಾಣಿಕೆಯೊನೆ ವರಿ ನೈವೆದ್ಯನೆ ಮಿಸಾನೆ ನೈ ಥಯಲನೆ ಆವಾ ಲಗಾಡುಸ. <verse eid="EZK 20:40" /><verse number="41" style="v" sid="EZK 20:41" />ಮಿ ತುಮೊನೆ ಜನಾಂಗಮಾತೊ ಪಾರ ಕರಿನ ತುಮೆ ಭಿಕರೈ ಗಯಲ ದೆಶೊತ ಲೈನ ಮಳತಾಮಾ ತುಮಾರಿ ಚೊಕಿ ಬಾಸನಿ ಹೊಮಾನೆ ವಪ್ಪಿಲಿನ ತುಮೊನೆ ಪ್ರಸನ್ನ ಥೌಸ; ಘನಾ ಜನಾಂಗೊನಾ ಕ್ಹಾಮಾ ತುಮಾರಾ ರಕ್ಷಣೆನಾ ಮೂಲಕ ಮಾರಿ ಮರ್ಯಾದಿನೆ ವಚಾ಼ಡಿ ಲಿವುಸ. <verse eid="EZK 20:41" /><verse number="42" style="v" sid="EZK 20:42" />ಮಿ ಪ್ರಮಾಣ ಕರಿನ ತುಮಾರಾ ಪಿತೃವೊನೆ ಕಯು ದೆಶ ದಿದ್ಯೊಸತೊ ತೆ ಇಸ್ರಾಯಲ ದೆಶನೆ ಆವಾಲಗಡಾತಾಮಾ ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊ ಗೊತ್ತ ಥಾವಸ. <verse eid="EZK 20:42" /><verse number="43" style="v" sid="EZK 20:43" />ತುಮೆ ತುಮೊನೆ ಹೊಲಸ ಕರಲಿದಲಕ್ಹು ತುಮಾರಿ ನಡತೆನೆ ವರಿ ಕ್ಹಾರಾ ಕಾಮೊನೆ ತ್ಯಾ ಸ್ಹೆಂನೆ ಲೈನ ತುಮೆ ಕರಲ ಘನಾ ಕೆಟ್ಟ ಕಾಮೊನಾ ನಿಮಿತ್ತ ತುಮೊನೆ ದೆಕಿನ ತುಮೆಜ ಅಸಹ್ಯ ಕರೊಸಿ. <verse eid="EZK 20:43" /><verse number="44" style="v" sid="EZK 20:44" />ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾ, ತುಮಾರಿ ಕೆಟ್ಟ ಚಾಲನೆ ವರಿ ಕೆಟ್ಟ ಕಾಮೊನೆ ತಿನಾ ತಕ್ಕ ತಿಮ್ಮಜ಼ ಮಿ ತುಮೊ ದಂಡ ದಿದೆವಾಚಿ ಮಾರಾ ನಾಮನ ನಿಮಿತ್ತ ಮಿ ತುಮೊನೆ ತಡ್ದಿ ಲೆತಾಮಾ ಮಿಜ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ; ಆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 20:44" /></para>
  <para style="s">ದಕ್ಷಿಣ ದಿಕ್ಕನಿ ಆಗ</para>
  <para style="p">
    <verse number="45" style="v" sid="EZK 20:45" />ಪಾಚಾ಼ತೊ ಯಹೊವಾ ಆಂ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 20:45" /><verse number="46" style="v" sid="EZK 20:46" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ದಕ್ಷಿಣಕನ ಮ್ಹೊಡು ಕರಿನ ಬೊಲ್ತಾಮಾ ದಕ್ಷಿಣ ಸಿಮೆನಾ ಮಳಾಮಾ ಪ್ರಸ್ತಾಪ ಉಚೈನ ತೆ ಮಳಾನೆ ಅಮ್ಮ ತಿಳಸೈನ ಕೆ <verse eid="EZK 20:46" /><verse number="47" style="v" sid="EZK 20:47" />ಯಹೊವಾನಿ ಆಂ ವಾತ ಐಕಿನ, ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಆಹಾ, ಮಿ ತಾರಾಮಾ ಆಗ ಲಗಾಡುಸ, ತೆ ತಾರಾಮಾನಾ ಹಸರ ಝಾಡೊನೆ ವರಿ ಕುಕ್ಹಾಯಲ ಝಾಡೊನೆ ಗಳಿಜಾ಼ವಸ; ಧಗಧಗ ಲಾಗಲ ಇಜ್ಜಾಯೆವಾಚಿ ಉತ್ತರತು ದಕ್ಷಿಣ ಲಕ್ಕಾ ಕ್ಹಾರುಜ಼ ಬಳಿ ಜಾ಼ವಸ. <verse eid="EZK 20:47" /><verse number="48" style="v" sid="EZK 20:48" />ತೆ ಲಾಗಾಡಲವಾಲೊ ಯಹೊವಾ ಥಯಲ ಮಿ ಕವಾನು ಘನಾ ನರ ಜಾನವರೊನೆ ಗೊಚರ ಥಾವಸ; ತೆ ಇಜ್ಜಾತಿಜ ನೈ. <verse eid="EZK 20:48" /><verse number="49" style="v" sid="EZK 20:49" />ತೆಳಾಮಾ ಮಿ ಅಯ್ಯೊ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ, ಆಂ ಒಡಪೊ ಕವಾಲೊ ನವೈಸು? ಕೈನ ಆಂ ಮನಕ್ಹೊ ಮಾರಾಹುತಿ ಕೈಲಿವಾಡಾಸ ಕವಾನು ಅರಕೆ ಕರ್ಯೊ.<verse eid="EZK 20:49" /></para>
  <chapter eid="EZK 20" />
  <chapter number="21" style="c" sid="EZK 21" />
  <para style="s">ಕ್ಹುದಾನು ಫೈಸಲೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 21:1" />ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 21:1" /><verse number="2" style="v" sid="EZK 21:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಯರುಸಲೆಮಕನ ಮ್ಹೊಡು ಕರಿನ ತ್ಯಾನಾ ಪವಿತ್ರ ಜ಼ಗಾವೊಕನ ಬೊಲ್ತೊ ಇಸ್ರಾಯಲ ದೆಶನಾ ಪ್ರವಾದನ ಉಚೈನ ತೆ ದೆಶನೆ ಇಮ್ಮ ತಿಳಸೈನ ಕೆ <verse eid="EZK 21:2" /><verse number="3" style="v" sid="EZK 21:3" />ಯಹೊವಾ ಇಮ್ಮ ಕವಸ ಆಹಾ ಮಿ ತುನೆ ವಿರುದ್ದ ಥಯೊಸ, ಮಾರಾ ತಲ್ವಾರನೆ ಮ್ಯಾನಮಾತೊ ಕಾಡಿನ ತಾರಾಮಾನಾ ಶಿಷ್ಟೊನೆ ವರಿ ದುಷ್ಟೊನೆ ಕ್ಹಲಾಸ ಕರಿ ಪಡುಸ. <verse eid="EZK 21:3" /><verse number="4" style="v" sid="EZK 21:4" />ಮಿ ತಾರಾಮಾನಾ ಶಿಷ್ಟೊನೆ ವರಿ ದುಷ್ಟೊನೆ ಕ್ಹಲಾಸ ಕರಾನಾಹುತಿ ಮಾರಿ ತಲ್ವಾರ ಮ್ಯಾನಮಾತು ಐನ ದಕ್ಷಿಣತು ಉತ್ತರಲಕ್ಕಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊನಾ ಉಪ್ಪರ ಪಡಸ; <verse eid="EZK 21:4" /><verse number="5" style="v" sid="EZK 21:5" />ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತಲ್ವಾರ ಕಾಡ್ಯೊಸ ಕೈನ ತೆಳಾಮಾ ಮನಕ್ಹೊನೆ ಗೊತ್ತ ಥಾವಸ; ತೆ ವರಿ ಮ್ಯಾನಮಾ ನೈ ಜಾ಼ತು. <verse eid="EZK 21:5" /><verse number="6" style="v" sid="EZK 21:6" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ ಮೊರೆ ಮ್ಹೆಲ; ಕಂಬರ ತುಟಲನಿಂಗತ ದುಕ್ಕಕ್ಹು ಮನಕ್ಹೊನಾ ಕ್ಹಾಮೊ ನೆಳ್ಳ. <verse eid="EZK 21:6" /><verse number="7" style="v" sid="EZK 21:7" />ಕಾ ನಳ್ಳಾಡೊಸ ಕೈನ ತ್ಯುನೆ ತುನೆ ಪುಚ್ಚತ್ತಾಮಾ ತು ತ್ಯುನೊನೆ ಕೆಟ್ಟ ಸುದ್ದಿನಾ ಹುತಿ ನೆಳ್ಳುಸ; ಹಮ್ನಾ ತ್ರಾಸ ಐಯು: ಕ್ಹಾರಾವೊನಾ ಮನಸೊ ಕರಗಿನ ಪಾನಿ ಥಾವಸ; ಕ್ಹಾರಾವೊನಾ ಹತೊ ಜೊತ ಪಡಸ, ಕ್ಹಾರಾವೊನು ಮನಸ ಕುಂದಸ, ಕ್ಹಾರಾವೊನಾ ಗುಡ್ಗಾ ಕಮ್ಜೊ಼ರ ಥಾವಸ; ಹಮ್ನಾ ಐಯು, ಥಯು, ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ ಕೈನ ಜವಾಬ ದೆ.<verse eid="EZK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 21:8" />ಪಾಚಾ಼ತೊ ಯಹೊವಾ ಆಂ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ , <verse eid="EZK 21:8" /><verse number="9" style="v" sid="EZK 21:9" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ; ಕರ್ತಾ ಇಮ್ಮ ಕವಸ ಕವಾನು ಕೈನ ಇಮ್ಮ ಕೆ ಆಹಾ ತಲ್ವಾರ ಸಾಣ ಧರಲ ಧಾರ ತಲ್ವಾರ, ಛೆ .<verse eid="EZK 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 21:10" />ಕ್ಹಲಾಸ ಕರಾನಾ ನಿಂಗತ ಚುಪ ಛೆ ಚಮ್ಕಾ ನಿಂಗತ ತಿಕ್ಕಲ ಛೆ. ಹಮಾರಾ ಕುಮಾರನಾ ರಾಜ಼ನು ದಂಡ ಉಗ್ರಲ ಕ್ಹಾರಾ ದಂಡೊನೆ ಇನ್ಕಾರ ಕರಸತೊ ಕವಾನು ಹಮೆ ಸಂಬ್ರಹ ಪಡಿಯೆಸ? <verse eid="EZK 21:10" /><verse number="11" style="v" sid="EZK 21:11" />ತಲ್ವಾರ ಹತ್ಮಾ ತಯ್ಯಾರ ಥಾವಾನೆ ತಿಕ್ಕನೆ ದಿದ್ಯಾಸ, ಘಾತಕನಾ ಹತೆ ಇಡಥಾವಾ ಅಕ್ಲು ಧಾರ ರ‍್ಹಯಲ ತಿಕ್ಕಲ ಛೆ. <verse eid="EZK 21:11" /><verse number="12" style="v" sid="EZK 21:12" />ಎ ಮನಕ್ಹನಾ ದಿಕ್ರಾ ವದರ, ಗೊಳಾಡ! ತಲ್ವಾರ ಮಾರಾ ಮನಕ್ಹೊಪರಬಿ ಇಸ್ರಾಯಲನಾ ಕ್ಹಾರಾ ಶಾನಾವೊಪರ ಉಪ್ಪರ ಪಡ್ಯುಸ; ಮಾರಾ ಮನಕ್ಹೊನಾಕ್ಹಾತೆ ತಲ್ವಾನೆ ಬೊಂದೊ ಥಾವಾಸ: ಛಾತಿ ಬಡೈಲಿವಸ. <verse eid="EZK 21:12" /><verse number="13" style="v" sid="EZK 21:13" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಇಮ್ಮ ಕವಸ ಶೊಧನೆ ಅನುಭವ ಥಯು; ಇನ್ಕಾರ ಕರಲ ರಾಜ಼ನಾ ಲಾಕಡಿ ನಾಶ ಥಯಾರೆ ಗತಿ ಸುವೈ?<verse eid="EZK 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 21:14" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ ತು ಕ್ಹುದಾನಾ ಸಂಕಲ್ಪನೆ ಕೈನ ಚ಼ಪ್ಪಾಳ್ಯೊ ಮಾರ; ತಲ್ವಾರ ಬೆ ಅಕ್ಲು ತನ್ನ ಅಕ್ಲು ಕ್ಹಲಾಸ ಕರಾದೆ! ಪ್ರಜಾನೆ ಹತಿಸಾನು ತಲ್ವಾರ! ಸುತ್ತೆಬಿ ಭಿರಕೈನ ಅದಿಪತಿಯೊನೆ ಹತಿಸಾನು ತಲ್ವಾರ <verse eid="EZK 21:14" /><verse number="15" style="v" sid="EZK 21:15" />ತ್ಯುನು ಮನಸ ಪಾನಿ ಥೈನ ಘನಾ ಮನಕ್ಹೊ ಟೆಕ್ಹ ಲಾಗಿನ ಪಡುಕೈನ ಕ್ಹಲಾಸ ಕರಾನು ತಲ್ವಾರನೆ ತ್ಯುನಾ ಪುರ ಬಾಕಲೊನೆ ಲಾಯೊಸ. ಆಹಾ ಮಿಂಚ಼ ನಿಂಗತ ಮಿಂಚ಼ಸ, ವಧೆಥೈನ ತಿಕ್ಕಲ ಛೆ! <verse eid="EZK 21:15" /><verse number="16" style="v" sid="EZK 21:16" />ಎ ತಲ್ವಾರ, ಯಕ್ಕಥೈನ ಸಿದಾಬಗಲ ಜಾ಼ ತಯ್ಯಾರ ಥೈನ ರೊಡ್ಡಾ ಬಗಲ ಜಾ಼ ತಾರು ಮ್ಹೊಡು ರ‍್ಹಯಲ ಜ಼ಗಾಕನ ಜಾ಼. <verse eid="EZK 21:16" /><verse number="17" style="v" sid="EZK 21:17" />ಮಿ ಚಪ್ಪಾಳೊ ಮಾರಿನ ಮಾರಿ ಶಿಟ್ಟನೆ ತಿರಸಿಲ್ಯುಸ. ಕರ್ತಾ ಥಯಲ ಮಿಜ಼ ಆಂ ಕದ್ಯೊಸ<verse eid="EZK 21:17" /></para>
  <para style="s">ಬಾಬಿಲೊನನಾ ರಾಜಾ಼</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 21:18" />ಯಹೊವಾ ಮನೆ ವರಿಯಕ್ಕ ವಾಕ್ಯಾನೆ ದಿದ್ಯೊ <verse eid="EZK 21:18" /><verse number="19" style="v" sid="EZK 21:19" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ ಬಾಬಿಲೊನನಾ ರಾಜಾ಼ನು ತಲ್ವಾರ ಆವಾನಾಹುತಿ ಬೆ ವಾಟನಾ ನಕ್ಷಾನೆ ಲಿಕ್ಕ; ತೆ ಭಂಬಿ ಯಕ್ಕಜ಼ ದೆಶತಾ ಗಯಲ ನಿಂಗತ ರ್ಹವಾದೆ; ಯಕ್ಕಕ್ಕ ಗಾಮನೆ ಜಾ಼ವಾನಿ ವಾಟ ಪೈಲಾ ಝಾಡಕ್ಹು ವಳಕ ಕರ. <verse eid="EZK 21:19" /><verse number="20" style="v" sid="EZK 21:20" />ಅಮ್ಮೊನ್ಯರ ರಬ್ಬಾ ಕವಾನಾ ಗಾಮನೆ ಯೆಹುದಮಾ ಮಳಲ ಯರುಸಲೆಮನೆ ತಲ್ವಾರ ಆವಾನಾಹುತಿ ವಾಟ ಕರ. <verse eid="EZK 21:20" /><verse number="21" style="v" sid="EZK 21:21" />ವಾಟ ಮಾರಾನಾ ಜ಼ಗಾಮಾ ಬೆ ವಾಟೊಮಾ ಪೈಲಾಮಾ ಬಾಬಿಲೊನನೊ ರಾಜೊ಼ ಸಕಣಾ ದೆಕಾನಾಹುತಿ ಹುಬ್ರಯೊಸ; ಬಾಣೊನೆ ಕಲಕಿ ವಿಗ್ರಹೊನೆ ಪ್ರಶ್ನೆ ಪುಚ್ಚಿನ ಕಲ್ಜಾನೆ ಪರಿಕ್ಷಾ ಕರ‍್ಯೊಸ. <verse eid="EZK 21:21" /><verse number="22" style="v" sid="EZK 21:22" />ಯರುಸಲೆನು ಗುರುತುನು ಬಾಣಾ ತಿನಾ ಸಿದಾ ಹತ್ಮಾ ಮಳ್ಯುಸ; ಗೊಡಿಯೊ ಪ್ಹೊಡಾನಿಯೊ ಮಶಿನೊ ಹುಬ್ರಾಡಿನ ಮ್ಹೊಡು ಕ್ಹೊಲಿನ ಸಂಹಾರ ಧ್ವನಿಗೈದು ವದರಿನ ವ್ಹೈ ಗೊಡಿಯೊ ಪ್ಹೊಡಾನಿಯೊ ಮಶಿನೊ ಪುರ ಬಾಕಲೊನಾ ಕ್ಹಾಮಾ ಹುಬ್ರಾಡಿನ ಗುಬ್ಬಾ ಘಾಲಿನ ಒಡ್ಡು ಭಾಂದುಕೈನ ತಿನಾಕ್ಹು ಸುಚನೆ ಥಯು. <verse eid="EZK 21:22" /><verse number="23" style="v" sid="EZK 21:23" />ಪುರ ನಿವಾಸಿಯೊ ತ್ಯುನೆ ತೆ ರಾಜಾ಼ಕ್ಹು ಕರಲಿದಲ ಪ್ರಮಾಣೊಮಾ ಭರೊಕ್ಹೊ ಮ್ಹೆಲಿನ ಎ ಸಕಣಾ ಸುಳ್ಳ ವ್ಹೈ ಕೈನ ಭಾವಸಸ ತೆನೈಸೊ ತೆ ತ್ಯುನಾ ಅರ್ಧಮನೆ ಭಾರೊ ಲಾವಾನೆ ತಿನಾ ಹತೆ ಮಳಸ. <verse eid="EZK 21:23" /><verse number="24" style="v" sid="EZK 21:24" />ಇಮ್ಮ ರ್‍ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತುಮಾರಾ ಅಪರಾದೊನೆ ಭಾರಾ ಲೈನ ತುಮಾರಾ ಪಾಪೊ ತುಮಾರಾ ಕಾಮೊ ಕ್ಹಾರಾ ತುಮೆ ತುಮಾರಾ ಅರ್ಧಮನೆ ಮಾರಾ ಸ್ಹೆಂನೆ ಲೈನ ಪಾಪೊಯೊ ಥೈನ ಮಾರಾ ಸ್ಹೆಂನೆ ಆಯಲ ಕಾರಣ ಶತ್ರುನಾ ಹತೆ ಮಳ್ಯೊಸಿ.<verse eid="EZK 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 21:25" />ಇಸ್ರಾಯಲನೊ ಮಾಲಕ ದುಷ್ಟ ಬ್ರಷ್ಟ ತುನೆ ಟೈಮ ನಜಿಕ ಛೆ; ಎಜ಼ ತಾರಾ ಅಪರಾದನೆ ಲಾಸ್ಟ ಶಿಕ್ಷಾ ವ್ಹೈ <verse eid="EZK 21:25" /><verse number="26" style="v" sid="EZK 21:26" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮ್ಹೊಡಾಪರ ರ‍್ಹಯಲ ಟುವಾಲ ಕಿತ್ತಿಪಡ! ಕಿರಿಟನೆ ಉಚೈನ ಘಾಲ! ಕ್ಹಾರುಜ಼ ವ್ಯತ್ಯಸ್ತ ಥಾವಾದೆ; ಹೆಟಲ್ಯಾನೆ ಉಪ್ಪರ ಕರ, ಉಪ್ಪರಲ್ಯಾನೆ ಹೆಟೊ ಕರ; <verse eid="EZK 21:26" /><verse number="27" style="v" sid="EZK 21:27" />ಮಿ ಆ ಗಾಮನೆ ಪಳ್ಳ ಕರುಸ ಪಳ್ಳ-ಪಳ್ಳ ಕರುಸ ರಾಜ್ಯನೆ ಭಾದ್ಯ ಆಯೆಲಕ್ಕಾ ಯಕ್ಕ ರ‍್ಹಯಲ ನಿಂಗತ ರ್ಹವಸ; ತಿನೆ ರಾಜ್ಯನೆ ದ್ಯುಸ.<verse eid="EZK 21:27" /></para>
  <para style="s">ಅಮೊನಿಯಾವಾಲಾ ವರಿ ತಲ್ವಾರ</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 21:28" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ ತು ಕ್ಹುದಾನಿಯೊ ವಿಚಾರೊ ದೆಕಾಡತೊ ಅಮ್ಮ ಕೆ ಅಮೊನ್ಯವಾಲಾವೊನಾ ವಿಶಯಮಾ ಅಮ್ಮ ಕೆ ತ್ಯುನೆ ಕರಾನು ದೊಶಣೆನಾ ಹುತಿ ಅಮ್ಮ ಕವಸ ಆಹಾ ತಲ್ವಾರ-ತಲ್ವಾರ ಕತ್ರಾನೆ ಭಾರೊ ಕಾಡ್ಯೊಸ ಮಿಂಚಾ಼ನಾ ಯಕ್ಲೊ ಧಾರ ಕರ‍್ಯಾಸ.<verse eid="EZK 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 21:29" />ಅಮ್ಮೊನ ತಾರಾ ಪ್ರವಾದಿಯೊ ಮಿಥ್ಯೆನೆ ಸಾಕ್ಷಾತ ಕರಿನ ಸುಳ್ಳ-ಸುಳ್ಳ ಕಣಿ ಕವಾಡಾಸ. ಟೈಮ ನಜಿಕ ಐನ ಅಪರಾದನು ಲಾಸ್ಟಟೈಮ ಸಂಬವಿಸಿನ ಹತಥೈನ ಪಡಲ ದುಷ್ಟೊನಿ ಗತಿನೆ ದೆಕ! ಜೊಯಿಸೊನೆ ನಂಬಲ ತು ತೆ ದುಷ್ಟೊನಾ ಗರ್ದನೊಪರ ಒರಗಿನ ಜಾ಼ವಸ. <verse eid="EZK 21:29" /><verse number="30" style="v" sid="EZK 21:30" />ತಲ್ವಾರನೆ ಮ್ಯಾನಮಾ ಘಾಲ. ತಾರಾ ಸೃಷ್ಟಿನಾ ಜ಼ಗಾಮಾ, ತಾರಾ ತುನೆ ಫೈಸಲೊ ಕರುಸ. <verse eid="EZK 21:30" /><verse number="31" style="v" sid="EZK 21:31" />ತಾರಾ ಉಪ್ಪರ ಮಾರಿ ಶಿಟ್ಟನೆ ರಿಚೈನ ಆಗನೆ ಫುಕ್ಕಿನ ತುನೆ ಹುಟ್ಟಲ ಜ಼ಗಾ ಜಂಗಲನಾ ಪ್ರಾಣಿಯೊ ಹಾಳ ಕರಾಮಾ ಘಟ್ಟ ರ‍್ಹಯಲವಾಲಾನಾ ಹಮಾ ಕ್ಹಾಪ್ಡೌಸ. <verse eid="EZK 21:31" /><verse number="32" style="v" sid="EZK 21:32" />ತು ಆಗನೆ ಪಾಲ ಥಾಸಿ; ತಾರು ರಗತ ಕ್ಹಾರಾ ದೆಶಮಾ ಭರಲ ರ‍್ಹವಸ; ತು ಹಜು಼ನ ಸ್ಹೆಂನೆ ನೈಆತೊ; ಯಹೊವಾ ಥಯಲ ಮಿ ಎ ಕದ್ಯೊಸ.<verse eid="EZK 21:32" /></para>
  <chapter eid="EZK 21" />
  <chapter number="22" style="c" sid="EZK 22" />
  <para style="s">ಯೆರುಸೆಲಿಮನಾ ಪಾಪೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 22:1" />ಯಹೊವಾ ಹಜಿಯಕ್ಕ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 22:1" /><verse number="2" style="v" sid="EZK 22:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ ರಕ್ತಮಯ ಥಯಲ ತೆ ಗಾಮೆ ಫೈಸಲೊ ಕರಾನೆ ತಾರು ಮನಸ ತಯ್ಯಾರ ಛೆಸು, ತಯ್ಯಾರ ಥಯುಸು? ತಿನಾ ಕ್ಹಾರಾ ಕೆಟ್ಟ ಕಾಮೊನೆ ತಿನೆ ತಿಳ್ಸಾ <verse eid="EZK 22:2" /><verse number="3" style="v" sid="EZK 22:3" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತಾರಾ ವಚ್ಮಾ ರಗತನೆ ರಿಚಾ಼ ದಂಡ ದಿವಾನು ಕಾಲ ನಜಿಕ ಲಾಯಲ ಗಾಮ! ತಾರಾ ಕೆಡನಾಹುತಿ ಮೊರ್ತಿಯೊ ಕರಿನ ತುನೆ ಅಶುದ್ದ ಕರಲಿನ ಗಾಮ! <verse eid="EZK 22:3" /><verse number="4" style="v" sid="EZK 22:4" />ತು ರಿಚಾ಼ಯಲ ರಗತಕ್ಹು ಅಪರಾದಿ ಕರಿಲಿದಲ ಗೊಂಬಿಯೊಕ್ಹು ಹೊಲಸ ಥೈನ ಶಿಕ್ಷಾನೊ ಟೈಮನೆ ನಜಿಕ ಲೈನ ದಂಡನಾ ಕಾಲನೆ ಐಯುಸ; ತಿನಾಹುತಿ ತುನೆ ಜನಾಂಗೊನಾ ದೊಷಣೆನೆ ಘನಾ ದೆಶೊಪರಬಿ ಹಾಸ್ಯನೆ ಗುರಿ ಕರ‍್ಯೊಸ. <verse eid="EZK 22:4" /><verse number="5" style="v" sid="EZK 22:5" />ಗಲಿಜಿ ವರಿ ಅಪವಿತ್ರ ಥಯಲ ಗಾಮ ತಯ್ಯಾರ ಥಯಲ ನಜಿಕವಾಲಾ ದುರವಾಲಾ ತುನೆ ಅಸಯ್ಯ ಕರಸ. <verse eid="EZK 22:5" /><verse number="6" style="v" sid="EZK 22:6" />ಹಮ್ನಾ ಇಸ್ರಾಯಲನಾ ಮಾಲಕೊ ತ್ಯುನಾ ತ್ಯುನಾ ಶಕ್ತಿನಾಹುತಿ ತಾರಾಮಾ ರಗತ ರಿಚಾ಼ತಾಜ಼ ಛೆ. <verse eid="EZK 22:6" /><verse number="7" style="v" sid="EZK 22:7" />ತಾರಾ ಮನಕ್ಹೊ ಮಾ ಬಾಪನೆ ಕಿಳ ಕರ್‍ಯಾಸ, ತಾರಾ ಮನಕ್ಹೊ ಬಿಜಾ಼ ದೆಶವಾಲಾವೊನೆ ತ್ರಾಸ ಕರಾಡ್ಯಾಸ, ತಾರಾ ಮನಕ್ಹೊ ಅನಾಥೊನೆ ರಾಂಡಿಯೊನೆ ತ್ರಾಸ ಕರ್‍ಯಾಸ. <verse eid="EZK 22:7" /><verse number="8" style="v" sid="EZK 22:8" />ತು ತಾರಾ ಪವಿತ್ರ ಸಾಮ್ನೊನೆ ಅಲಕ್ಷ್ಯ ಕರಿನ ಮಿ ನೆಮಸಲ ಸಬ್ಬತ ದಿನೊನೆ ಹೊಲಸ ಕರ‍್ಯೊಸ. <verse eid="EZK 22:8" /><verse number="9" style="v" sid="EZK 22:9" />ತಾರಾಮಾನಾ ಚಾಡಾ ಕವಾಲಾ ರಗತ ಚು಼ವಾಯಾಸ; ತಾರಾ ಮನಕ್ಹೊ ಡೊಂಗರೊಪರ ಬಲಿ ದಿದಲ ಅನ್ನ ಕ್ಹಾದ್ಯಾಸ; ತಾರಾ ವಚ್ಮಾ ಕೆಟ್ಟ ಕಾಮೊನೆ ಕರ್‍ಯಾಸ. <verse eid="EZK 22:9" /><verse number="10" style="v" sid="EZK 22:10" />ತಾರಾಮಾ ಬಾಪನೆ ಬಲಾತ್ಕಾರ ಕರ್‍ಯಾಸ ; ತಾರಾಮಾ ಭಾರಾ ಘಾಲಲ ರ‍್ಹಯಲವಾಲಿಯೊನೆ ಮಳಾಯಾಸ. <verse eid="EZK 22:10" /><verse number="11" style="v" sid="EZK 22:11" />ತಾರಾಮಾ ಯಕ್ಲೊ ಬಾಜು಼ವಾಲಾನಿ ಬೈಕೊನಾಕ್ಹಾತೆ ಕೆಟ್ಟಕಾಮ ಕರ‍್ಯೊಸ; ಹಜಿಯಕ್ಲೊ ಅತ್ಯಾಚಾರ ಕರಿನ ವ್ಹಾವುನೆ ಕೆಡಸ್ಯೊಸ; ಬಿಜೆಯಕ್ಲೊ ಖಾಸ ಭೆನನೆ ಕೆಡಶ್ಯುಸ ಕರ‍್ಯೊಸ. <verse eid="EZK 22:11" /><verse number="12" style="v" sid="EZK 22:12" />ತಾರಾ ಮನಕ್ಹೊ ರಗತ ಚು಼ವಾಡಾನೆ ಲಂಚಾ ಲಿದ್ಯಾಸ; ತಾರಾ ಮನಕ್ಹೊ ಸಾಲಾನೆ ಬಡ್ಡಿ ಲಿನ ಫೈದಾನೆ ದೊಕ್ಡಾ ದಿನ ತಿನಾ ಬಾಜು಼ವಾಲಾನೆ ಭಾದಸಿನ ದೊಚಿಲಿನ ಮನೆ ಇಕ್ಹರಿ ಪಡ್ಯಾಸ; ಎ ಕರ್ತಾ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 22:12" /><verse number="13" style="v" sid="EZK 22:13" />ಹಮ್ನಾ ದೊಚಿಲಿದಲ ಫೈದಾನೆ ತಾರಾ ರಿಚಾ಼ಯಲ ರಗತನೆ ಮಿ ದೆಕಿನ ಹತ್ತ ಮಾರಲಿದ್ಯೊಸ. <verse eid="EZK 22:13" /><verse number="14" style="v" sid="EZK 22:14" />ಮಿ ತುನೆ ದಂಡ ದಿವಾನಾ ಕಾಲಮಾ ಮನಸನೆ ಘಟ್ಟ ಕರಲಿದ್ಯೊಸು? ಹತೊನೆ ತಾಕತವರ ಕರಲಿದ್ಯೊಸು? ಯಹೊವಾ ಥಯಲ ಮಿ ಎ ಕದ್ಯೊಸ, ಚ಼ಲೌಸ. <verse eid="EZK 22:14" /><verse number="15" style="v" sid="EZK 22:15" />ಮಿ ತುನೆ ಜನಾಂಗೊಮಾ ಭಿಕ್ಹರೈನ ದೆಶದೆಶೊನೆ ತುರಿನ ತಾರಾ ಹೊಲಸನೆ ತಾರಾಮಾತೊ ಕಾಡಿನ ನಾಶ ಕರುಸ. <verse eid="EZK 22:15" /><verse number="16" style="v" sid="EZK 22:16" />ಜನಾಂಗೊನಾ ಡೊಳಾನಾ ಕ್ಹಾಮೊ ತಾರಾಕ್ಹು ತುಜ಼ ಅಪರ್ಕಿತಿನೆ ಗುರಿಥಾಸಿ; ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 22:16" /></para>
  <para style="s">ಕ್ಹುದಾನು ಭಟ್ಟಿ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 22:17" />ಪಾಚಾ಼ತೊ ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 22:17" /><verse number="18" style="v" sid="EZK 22:18" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ ಇಸ್ರಾಯಲ ವಂಶ ಕವಾನು ಲ್ಹೊಡು ಮಾರಾ ನಜ಼ರಮಾ ಕಲ್ಮಶ ಥಯುಸ; ಭಟ್ಟಿಮಾ ಕ್ಹಾರು ತಾಂಬು , ಪಿತ್ತೊಳ, ಲ್ಹೊಡು, ಸಿಸ, ತೆ ರುಪ್ಪು. <verse eid="EZK 22:18" /><verse number="19" style="v" sid="EZK 22:19" />ಇಮ್ಮ ರ್‍ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತು ಕ್ಹಾರಾ ಕಸರ ಥಯಲಕ್ಹು ಹಮ್ನಾ, ತುಮೊನೆ ಯರುಸಲೆಮನಾ ಮ್ಹೈ ಮಳೌಸ. <verse eid="EZK 22:19" /><verse number="20" style="v" sid="EZK 22:20" />ರುಪ್ಪು, ತಾಂಬು, ಲ್ಹೊಡು, ಸಿಸ, ಪಿತ್ತೊಳ ಎ ಕ್ಹಾರಾವೊನೆ ಭಟ್ಟಿಮಾ ಮಳೈನ ಫುಕ್ಕಿನ ಆಗ ಲಗಾಡಿನ ಕರಗಾವಾ ನಿಂಗತ ಮಿ ತುಮೊನೆ ಮಾರಾ ಘನ್ನಿ ಶಿಟ್ಟಮಾ ಮಳೈನ ಮ್ಹೆಲಿನ ಕರಗೌಸ. <verse eid="EZK 22:20" /><verse number="21" style="v" sid="EZK 22:21" />ಹೊ ಮಿ ತುಮೊನೆ ಮಾರಾ ಶಿಟ್ಟನಿ ಆಗಮಾ ಮಳೈನ ಫುಕ್ಕಾನೆ ತುಮೆ ತಿಮಾ ಕರಗೈ ಜಾ಼ವೊಸಿ. <verse eid="EZK 22:21" /><verse number="22" style="v" sid="EZK 22:22" />ರುಪ್ಪು ಭಟ್ಟಿಮಾ ಕರಗಾವಾ ನಿಂಗತ ತುಮೆ ಮಾರಿ ಶಿಟ್ಟನಿ ಆಗಮಾ ಕರಗೊಸಿ; ತುಮೊಪರ ಶಿಟ್ಟನಿ ಆಗನೆ ರಿಚಾ಼ಯಲವಾಲೊ ಯಹೊವಾ ಥಯಲ ಮಿಜ಼ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 22:22" /></para>
  <para style="s">ಇಸ್ರಾಯೆಲನ ಮ್ಹೊಟಾ ಮನಕ್ಹೊನು ಪಾಪ</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 22:23" />ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ. <verse eid="EZK 22:23" /><verse number="24" style="v" sid="EZK 22:24" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತೆ ರಾಜ್ಯನೆ ಇಮ್ಮ ಕೆ ಕ್ಹುದಾನಾ ಶಿಟ್ಟನಾ ಆ ದಿನಮಾ ತು ಶುದ್ದ ನೈ ಥಯಲ ದೆಶ, ಪಾನಿನೈಸೊ ದೆಶ. <verse eid="EZK 22:24" /><verse number="25" style="v" sid="EZK 22:25" />ತೆ ರಾಜ್ಯಮಾ ಪ್ರವಾದಿಯೊ ಮ್ಹೈನಾ ಮ್ಹೈ ಬೊಲಿದ್ಯಾಸ. ಬೆಟೆನೆ ಚಿರತಾ ಗರ್ಜನೆ ಕರಾನಾ ಸಿಂಹಾಡಾ ನಿಂಗತ ಛೆ, ನರನಾ ಪ್ರಾಣಿಯೊ ಗಳ್ಯಾಸ, ಆಸ್ತಿನೆ ಚೊ಼ಕಾ ಸಾಮ್ನೊನೆ ದೊಚಿಲಿದ್ಯಾಸ; ದೆಶಮಾ ಘನಾ ಮನಕ್ಹೊನೆ ರಾಂಡಿಯೊ ನಿಂಗತ ಕರ್‍ಯಾಸ. <verse eid="EZK 22:25" /><verse number="26" style="v" sid="EZK 22:26" />ತ್ಯಾನಾ ಯಾಜಕೊ ಮಾರಾ ವಿದಿಯೊನೆ ಭಂಗ ಕರ್‍ಯಾಸ ಮಾರಾ ಪರಿಶುದ್ದ ಸಾಮ್ನೊನೆ ಹೊಲಸ ಕರ್‍ಯಾಸ; ಮಿಸಾನಾಹುತಿ ಮಿಸಲಕ್ಹು ಭೆದ ಥಯು ನೈ, ಶುದ್ದ ರ‍್ಹಯಲ ವಿಚಾರೊನೆ ಬೊದನೆ ಕರ‍್ಯಾ ನೈ; ಮಿ ನೆಮ್ಸಲ ಸಬ್ಬತ ದಿನೊನೆ ವಿಮುಖ ಥಯಾಸ; ಇನಾಕ್ಹು ಮಿ ತ್ಯುನಾ ವಚ್ಮಾ ಅಪಕಿರ್ತಿನೆ ಗುರಿ ಥಯಾಸ. <verse eid="EZK 22:26" /><verse number="27" style="v" sid="EZK 22:27" />ತ್ಯಾನಾ ಪ್ರಧಾನೊ ಸುಲಿಗೆನಾಹುತಿ ರಗತ ಚು಼ವಾನು ನರನಾ ಪ್ರಾಣಿಯೊನೆ ಗಳಾಲಾ ಥೈನ ಬೆಟೆನೆ ಚಿರಾಲಾ ತೊಳಾ ನಿಂಗತ ಛೆ. <verse eid="EZK 22:27" /><verse number="28" style="v" sid="EZK 22:28" />ತ್ಯಾನಾ ಪ್ರವಾದಿಯೊ ಇವ್ನಾಹುತಿ ಮಿಥ್ಯಾನಾ ದರ್ಶನೆ ಸುಳ್ಳ ಕಣಿನೆ ಯಹೊವಾ ಬೊಲ್ಯಾವಾಚಿ಼ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಕೈನ ಕತೊ ಉಪ್ಪರ-ಉಪ್ಪರ ಚು಼ನ್ನೊ ಲಗಾಡ್ಯಾಸ. <verse eid="EZK 22:28" /><verse number="29" style="v" sid="EZK 22:29" />ಸಾದಾ ಮನಕ್ಹೊ ಹಿಮ್ಸಾ ಕರಿನ ಸೊರೆ ಕರ್‍ಯಾಸ, ದಿನ ದರಿದ್ರೊನೆ ಭಾದಸಿನ ಬಿಜಾ಼ ದೆಶೊನೆ ಅನ್ಯಾಯ ಥೈನ ಅರದಿನ ಛೊಡ್ಯಾಸ. <verse eid="EZK 22:29" /><verse number="30" style="v" sid="EZK 22:30" />ಮಿ ದೆಶ ಹಾಳ ಕರಾಕ್ಹು ಮಾರಾ ಕ್ಹಾಮಾ ದೆಶನಾ ರಕ್ಷಣೆನಾಹುತಿ ಪೌಳಿನಾ ಒಡಕಿಮಾ ಹುಬ್ರ್ಯಾವಾನಾಹುತಿ ಗೊಡಿನೆ ಘಟ್ಟ ಕರಲಿವಾನಾಹುತಿ ತಿನಾ ತಕ್ಕವಾಲಾನೆ ಮಿ ಹುಡ್ಕಾನೆ ಕುನ್ನಜ಼ ಮಳ್ಯು ನೈ. <verse eid="EZK 22:30" /><verse number="31" style="v" sid="EZK 22:31" />ತಿನಾಹುತಿ ಮಿ ಮಾರಾ ಶಿಟ್ಟನೆ ತ್ಯುನಾ ಉಪ್ಪರ ರಿಚೈನ ಮಾರಿ ಶಿಟ್ಟನಿ ಆಗಕ್ಹು ತ್ಯುನೊನೆ ದ್ವಂಸ ಕರಿನ ತ್ಯುನಿ ಕೆಟ್ಟ ವಾಟನೆ ತ್ಯುನಾ ಮಾತೆ ಭಾಂದ್ಯೊಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 22:31" /></para>
  <chapter eid="EZK 22" />
  <chapter number="23" style="c" sid="EZK 23" />
  <para style="s">ಪಾಪಿ ಭೆನೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 23:1" />ಯಹೊವಾ ವರಿಯಕ್ಕ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 23:1" /><verse number="2" style="v" sid="EZK 23:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಯಕ್ಕ ‘ಮಾನಾ ಬಚ್ಚಾ ಥಯಲ ಬೆ ದಿಕ್ರಿಯೊ ವ್ಹತ್ತಾ; <verse eid="EZK 23:2" /><verse number="3" style="v" sid="EZK 23:3" />ತ್ಯುನೆ ಐಗುಪ್ತಮಾ ಸುಳೆತನಾ ಕರಾಡಾತಾ, ನ್ಹಾನಪಂತಮಾ ಸುಳೆಯೊ ಥೈನ ಚಾ಼ಲಾಡಾತಾ; ತ್ಯಾ ತ್ಯುನಾ ಸ್ತನೊ ಚಿಕಲ್ಯಾ, ಎಳೆನಾ ತೊಟ್ಟವೊ ನಸುಕ್ಯಾ. <verse eid="EZK 23:3" /><verse number="4" style="v" sid="EZK 23:4" />ತ್ಯುನಾ ನಾಮೊ ಸುವೈ ಕದ್ಯಾರೆ, ಒಹೊಲ ಕವಾನು ಮ್ಹೊಟಿ ಭೆನು ವ್ಹೈ ಒಹೊಲಿಬ ಕವಾನು ನ್ಹಾನಿ ಬ್ಹೆನು ವ್ಹೈ; ತ್ಯುನೆ ಮಾರಾ ಬೈಕೊವೊ ಥೈನ ಗಂಡ ಬಚ್ಚಾವೊನೆ ಜ಼ನ್ನ್ಯಾ. ಒಹೊಲ ಕವಾನು ಸಮಾರ್ಯನೆ, ಒಹೊಲಿಬ ಕವಾನು ಯರುಸಲೆಮನೆ ಸುಚನೆ ಕರಾನಾ ನಾಮೊ ಥಯಾಸ. <verse eid="EZK 23:4" /><verse number="5" style="v" sid="EZK 23:5" />ಒಹೊಲ ಮಾರಿ ಬೈಕೊ ಥೈತಬಿ ಸುಳಿಥೈನ ಚಾ಼ಲಿನ ತಿನಾ ಮಿಂಡಾವೊನೆ ಕದ್ಯಾಮ ಅಸ್ಸಿರಿಯಾವಾಲಾ <verse eid="EZK 23:5" /><verse number="6" style="v" sid="EZK 23:6" />ಯೊದೊ ನಿಲಾಂಬರೊ ನಾಯಕೊ ಶಿಟ್ಟನಾ ನಾಯಕೊ ಕುನಬಿ ಚುಕ್ಯಾವಾಚಿ ಮನೊಹರನಾ ಜಾ಼ಂಜಿಮಾನೊ ಥಯಲ ಅಶ್ಶುರ್ಯರೊನೆ ಮೊಹಿಸಿನ <verse eid="EZK 23:6" /><verse number="7" style="v" sid="EZK 23:7" />ತ್ಯುನೊನೆ ತಿನೆ ಸುಳಿ ಥೈನ ಒಪ್ಪಸಿ; ತ್ಯುನೆ ಕ್ಹಾರಾ ಅಶ್ಶುರ್ಯರಮಾ ಚೊ಼ಕಾ ಘನಾ ಚೊ಼ಕಾ ವ್ಹೈ; ತೆ ಕಿನೆ ಮೊಹಿಸಿತೊ ತ್ಯುನಾ ವಿಗ್ರಹೊಕ್ಹೊ ತಿನೆ ಹೊಲಸ ಕರಲಿದಿ. <verse eid="EZK 23:7" /><verse number="8" style="v" sid="EZK 23:8" />ತೆ ಐಗುಪ್ತತಿಬಿ ತಿನಿ ಸುಳೆತನಾನೆ ಛೊಡಿ ನೈ; ತಿನಾ ನ್ಹಾನಪಂತಮಾಜ಼ ತ್ಯಾನಾ ಮನಕ್ಹೊ ತಿನಾಕ್ಹಾತೆ ಕ್ಹುರೈನ ತಿನಾ ಎಳೆನಾ ತೊಟ್ಟೊನೆ ನಸುಕಿನ ತಿನಾಕ್ಹಾತೆ ಸುಳೆಗಾರಿಕೆನೆ ಹೆಚ್ಚ-ಹೆಚ್ಚ ಕರ‍್ಯಾ. <verse eid="EZK 23:8" /><verse number="9" style="v" sid="EZK 23:9" />ತಿನಾಹುತಿ ಮಿ ತಿನೆ ತಿನಾ ಮಿಂಡಾವೊನಾ ಹತೆ ಕದ್ಯಾಮ ತೆ ಮೊಹಿಸೆಲ ಅಶ್ಶುರ್ಯರನಾ ಹತೆ ಒಪ್ಸಾಯೊ. <verse eid="EZK 23:9" /><verse number="10" style="v" sid="EZK 23:10" />ಇವ್ನೆ ತಿನೆ ಕೆಡ್ಸಿನ ತಿನಾ ಗಂಡ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ಉಚೈಲಿನ ಗೈನ ತಿನೆ ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಕರ‍್ಯಾ. ಇವ್ನೆ ತಿನೆ ದಂಡ ದಿದಲಕ್ಹು ಬಾಕ್ಡಿಯೊಮಾ ತಿನೆ ಕೆಟ್ಟ ನಾಮ ಐಯು. <verse eid="EZK 23:10" /><verse number="11" style="v" sid="EZK 23:11" />ತಿನಿ ಭೆನ ಥಯಲ ಒಹೊಲಿಬನೆ ಎ ದೆಕಿನಬಿ ತಿನಾತಿಬಿ ಅದಿಕ ಥೈನ ಮೊಹ ಥೈನ ಮ್ಹೊಟಿ ಭೆನಾ ಸುಳಿತನಾತಿಬಿ ಹೆಚ್ಚ ಸುಳೆತನಾ ಕರಿನ ತಿನೆ ಮಿರಿ ಘನಿ ಕೆಟ್ಟ ಥಯಿ. <verse eid="EZK 23:11" /><verse number="12" style="v" sid="EZK 23:12" />ಎ ನಾಯಶಿಟ್ಟನಾ ನಾಯಕೊ ಯೊದೊ ವಿಚಿತ್ರವಾಲಾ ಅಶ್ವಾರುಢೊ ಕುನಬಿ ತಪ್ಪೆವಾಚಿಮನೊಹನಾ ಜಾ಼ಂಜಿಮಾನೊ ಥಯಲ ಅಶ್ಶುರ್ಯರೊನೆ ಮೊಹಿಸಿ. <verse eid="EZK 23:12" /><verse number="13" style="v" sid="EZK 23:13" />ತೆ ಹೊಲಸಥೈನ ಗಯಲನೆ ದೆಕ್ಯೊ, ಭಂಬೆಜ಼ನಾ ಯಕ್ಕಜ಼ ವಾಟೆ ಧರ್ಯಾ. <verse eid="EZK 23:13" /><verse number="14" style="v" sid="EZK 23:14" />ಎ ತಿನಾ ಸುಳೆತನಾನೆ ಹಜಿ಼ ಹೆಚ್ಚ ಕರಿ; ಹಮ್ನಾ , ಕಸ್ದಿಯೊನಾ ಚಿತ್ರಾವೊ ಕದ್ಯಾಮ <verse eid="EZK 23:14" /><verse number="15" style="v" sid="EZK 23:15" />ಗೊಡಿಪರ ಕಿರಮಂಜಿಕ್ಹು ಚಿತ್ರಾ ಪಾಡಾನು ದೆಕಲ್ಪರ ಕಂಬರನೆ ಪಟ್ಟಾನೆ ಭಾಂದಿನ ಮಾತಾನೆ ಚು಼ಂಗನಾ ಟುವಾಲನೆ ಭಾಂದಿನ ಕುನಬಿ ಚು಼ಕ್ಯಾವಾಚಿ ನಜ಼ರನೆ ಸರದಾರೊ ನಿಂಗತ ರ್ಹೈನ ತ್ಯುನಿ ಹುಟ್ಟಲ ಜಿಮಿನ ಥಯಲ ಬಾಬೆಲನಾ ಥೈನ ದಿಕ್ಹಿನ ಆಯಲ ಮನಕ್ಹೊನು ಆಕಾರ. <verse eid="EZK 23:15" /><verse number="16" style="v" sid="EZK 23:16" />ಎ ಮೊಹಥೈನ ಕಸ್ದಿಯ ದೆಶನೆ ತೆ ಮನಕ್ಹೊಕನ ಸುದ್ದಿ ಕವಾಲಾನೆ ವಳಾಯೊ. <verse eid="EZK 23:16" /><verse number="17" style="v" sid="EZK 23:17" />ತೆಳಾಮಾ ಬಾಬೆಲೆವಾಲಾ ಇನಾ ರತಿಮಂಚ಼ಪರ ಚ಼ಡಿನ ತ್ಯುನಾ ಸುಳೆಗಾರಿಕೆಕ್ಹು ಇನೆ ಕೆಡಸ್ಯಾ; ಎ ತ್ಯುನಾಕ್ಹು ಹೊಲಸ ಥಾವಾನೆ ಇನಿ ಆಸ ತ್ಯುನಾಕ್ಹು ಗೈ. <verse eid="EZK 23:17" /><verse number="18" style="v" sid="EZK 23:18" />ಎ ಮುಚ್ಚಮರೆಮಾ ಸುಳಿತನಾ ಕರಿನ ತಿನಿ ಇಜ್ಜತನೆ ಕೆಡಸಿಲೆತಾಮಾ ಮಾರು ಅನುರಾಗಬಿ ಪೈಲಾ ಇನಾ ಮ್ಹೊಟಿ ಭೆನಕ್ಹು ಅಗಲಿದ ನಿಂಗತ ಇನಾಕ್ಹುಬಿ ಅಗಲ್ಯುಸ. <verse eid="EZK 23:18" /><verse number="19" style="v" sid="EZK 23:19" />ತೆ ರ್ಹೈತಬಿ ತೆ ಐಗುಪ್ತಮಾ ಸುಳಿ ಥಯಲ ತಿನಾ ಎಳೆ ಪ್ರಾಯನೆ ಸ್ಹೆಂ ಕರಲಿನ ತಿನಾ ಸುಳಿತನಾನೆ ಹಜು಼ ಹೆಚ್ಕಿ ಕರಿನ <verse eid="EZK 23:19" /><verse number="20" style="v" sid="EZK 23:20" />ಗದ್ಡಾವೊ ನಿಂಗತ ಬೆದವಾಲಾ ಘೊಡಾವಿ ನಿಂಗತ ದಾಟಸ. ತೆನೈಸೊ ಕಸ್ದಿಯೊನಾ ಮಿಂಡಾವೊನೆ ಮೊಹಿಸಿ. <verse eid="EZK 23:20" /><verse number="21" style="v" sid="EZK 23:21" />ಒಹೊಲಿಬ ತಾರಾ ನ್ಹಾನಾ ಸ್ತನೊನೆ ಆಶಪಡಲ ಐಗುಪ್ತೊಕ್ಹು ತೊಟ್ಟುವೊನೆ ನಸುಕಿಲಿದಲ ತಾರಾ ಎಳೆ ಪ್ರಾಯನಾ ಕಾಮನೆ ತು ಸ್ಹೆಂನೆ ಲೈನ ತೆ ಮಿಂಡಾವೊನೆ ಮೊಹಿಸಿಸ್ತೊ.<verse eid="EZK 23:21" /></para>
  <para style="s">ನ್ಹಾನಿ ಭೆನನೆ ಕ್ಹುದಾನಿ ಫೈಸಲೊ</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 23:22" />ಇಮ್ಮ ರ್‍ಹತಾಮಾ ಒಹೊಲಿಬ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ. ಆಹಾ ಕಯಾ ಮಿಂಡಾವೊಕ್ಹು ತಾರಿ ಆಸ ಕ್ಹರಿ ತೆ ಮಿಂಡಾವೊನೆ ಕದ್ಯಾಮ ಚೊ಼ಕಾ ಜಾ಼ಂಜಿಮಾನೊ ಕುನಬಿ ಚು಼ಕ್ಯಾವಾಚಿ ನಾಯಕೊ ಉಪ ನಾಯಕೊ ಪ್ರಭು ಪ್ರದಾನೊ ಅಶ್ವಾರುಡೊ <verse eid="EZK 23:22" /><verse number="23" style="v" sid="EZK 23:23" />ಬಾಬೆಲೊನವಾಲಾ ಕ್ಹಾರಾ ಕಸ್ದಿವಾಲಾ, ಪೆಕೊದಿನವಾಲಾ, ಷೊಯವಾಲಾ, ಕೊಯವಾಲಾ, ಇವ್ನೊನೆ ಇವ್ನಾಕ್ಹಾತೆ, ಕ್ಹಾರಾ ಅಶ್ಶುರ್ಯರೊನೆ ಮಿ ತುನೆ ವಿರುದ್ದ ಥೈನ ಉಟಾಡಿನ ಕ್ಹಾರಿ ಜ಼ಗಾತಾ ತಾರಾ ಉಪ್ಪರ ಪಡಾ ವರಕ್ಹು ಕರುಸ. <verse eid="EZK 23:23" /><verse number="24" style="v" sid="EZK 23:24" />ತ್ಯುನಾ ಆಯುದೊ ರಥ, ಗಾಡಿ, ಜನಾಂಗೊನು ಸಮೂಹ ಇವ್ನಾಕ್ಹಾತೆ ತಾರಾ ಉಪ್ಪರ ಪಡಸ; ಗುರಾಣಿ, ಖೆಡ್ಯ, ಶಿರಸ್ತ್ರಾಣ, ಎ ಕ್ಹಾರು ಘಾಲಿನ ತುನೆ ವಿರುದ್ದ ಥೈನ ಸುತ್ತೆಬಿ ವ್ಯುಹ ಭಾಂದಸ; ಫೈಸಲೊ ಕರಾನು ಅದಿಕಾರನೆ ಮಿ ತ್ಯುನೊನೆ ವಪ್ಸಾವಾನೆ ತ್ಯುನೆ ತ್ಯುನಾ ಪೈಸಲಾನಾ ನಿಂಗತ ಪೈಸಲೊ ಕರಿನ ತುನೆ ತ್ಯುನೆ ದಂಡ ದಿವಸ. <verse eid="EZK 23:24" /><verse number="25" style="v" sid="EZK 23:25" />ಮಿ ಮಾರಿ ಶಿಟ್ಟನೆ ತಾರಾ ಉಪ್ಪರ ರಿಚಾ಼ವಾನೆ ತ್ಯುನಾ ತಾರಾಮಾ ಶಿಟ್ಟ ಕಾಳ್ಳಿವಸ; ತಾರಾ ನಾಕ ವರಿ ಕಾನೊನೆ ಕಿತ್ತಿ ಪಡಸ; ತಾರಾಮಾ ಉಗ್ರಲವಾಲಾ ತಲ್ವಾರನೆ ಬೊಂದೊ ಥಾವಸ; ತಾರಾ ಗಂಡ ವರಿ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ಅಪಹರಿಸಸ; ತಾರಾ ಮನಕ್ಹೊನಿ ಶೆಷ ಆಗನೆ ಅಹುತಿ ಥಾವಸ. <verse eid="EZK 23:25" /><verse number="26" style="v" sid="EZK 23:26" />ತಾರಾ ವಣ್ಣಾವೊನೆ ಯಳದಿನ ತಾರಾ ಚಂದ ರ‍್ಹಯಲ ಕ್ಹೊನಾನಾ ಸಾಮ್ನೊನೆ ಕಾಡಿಪಡಸ. <verse eid="EZK 23:26" /><verse number="27" style="v" sid="EZK 23:27" />ಇಮ್ಮ ಮಿ ತಾರು ಪುಂಡಾಟನೆ ತು ಐಗುಪ್ತತಿ ಚಾ಼ಲಿನ ಆಯಲ ತಾರಾ ಸುಳೆತನಾನೆ ತಾರಾತೊ ಕಾಡುಸ; ಪಾಚಾ಼ತೊ ತು ತ್ಯುನೊಕನ ಹಜಿ಼ ಡೊಳೊ ಉಚಾಯೆವಾಚಿ ಐಗುಪ್ತನೆ ಸ್ಹೆಂನೆ ಲಾಯೆವಾಚಿ಼ ರ್ಹಸಿ. <verse eid="EZK 23:27" /><verse number="28" style="v" sid="EZK 23:28" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಹಮ್ನಾ ತು ಕಿನೆ ಹಗೆ ಕರಸಿತೊ ತಾರಿ ಆಸ ಕಿನಾಕ್ಹು ಪಾಚಿ ಫರಿ ತ್ಯುನಾ ಹತೆ ತುನೆ ಮಿ ವಪ್ಸಾವಾನೆ <verse eid="EZK 23:28" /><verse number="29" style="v" sid="EZK 23:29" />ತ್ಯುನೆ ತಾರಾಮಾ ಹಗೆ ತಿರಸಿಲಿನ ತು ರಾಬಲ ಕ್ಹಾರು ಅಪಹರಸಿನ ತುನೆ ಬಟ್ಟ ಬರಿದ ಕರಿನ ಛೊಡಿ ಪಡಸ; ಇಮ್ಮ ಸರಮ ಇಡ ಥಯಲ ತಾರಿ ಸುಳಿತನಾ ವ್ಹೈ, ತಾರು ಪುಂಡಾಟಬಿ ಸುಳೆತನಾ ಬೈಲಿನೆ ಆವಸ. <verse eid="EZK 23:29" /><verse number="30" style="v" sid="EZK 23:30" />ತೆ ತ್ರಾಸೊಕ್ಹು ತುನೆ ಅನುಭವ ಥಾವಾನಾಹುತಿ ತು ಜನಾಂಗೊನೆ ಮೊಹಿಸಿನ ತ್ಯುನಾ ಗೊಂಬಿಯೊಕ್ಹು ತುನೆ ಹೊಲಸ ಕರಲಿದಿಸ ಕಾರಣ. <verse eid="EZK 23:30" /><verse number="31" style="v" sid="EZK 23:31" />ತು ತಾರಾ ಭೆನಾ ವಾಟಮಾ ಚಾ಼ಲಲಕ್ಹು ತೆ ಪಿದಲ ಫೈಸಲಾನಿ ಪಾತ್ರೆ ತಾರಾ ಹತ್ಮಾ ದ್ಯುಸ. <verse eid="EZK 23:31" /><verse number="32" style="v" sid="EZK 23:32" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಉಂಡಾ ರುಂದ ಘನು ಧರಸ ಥಯಲ ತರಾ ಭೆನಾ ಸಾಮನಮಾ ತು ಪಿದಲ ಹಾಸ್ಯನೆಬಿ ಕುಚೊದ್ಯನೆ ಗುರಿ ಥಾಸಿ <verse eid="EZK 23:32" /><verse number="33" style="v" sid="EZK 23:33" />ಸಮಾರ್ಯ ಥಯಲ ತಾರಾ ಭೆನ ಪಿದಲ ನಿಶಾಮ ಬೆಚ್ಚುಬೆರಗಿನ ಥಾಳಾಮಾ ತು ಪಿನ-ಪಿನ ಪೂರಾ ನಶಾಥೈನ ದುಕ್ಕ ಭರಲವಾಲಿ ಥಾಸಿ <verse eid="EZK 23:33" /><verse number="34" style="v" sid="EZK 23:34" />ತಿಮಾ ಯಕ್ಕ ಗುಟುಕ ಛೊಡ್ಯಾವಾಚಿ ಪಿನ ತಿನಾ ಬೊಕಿಯೊನೆ ಕಡ್ಡಿನ ಚಾ಼ಟಿನ ತಾರಾ ಸ್ತನೊನೆ ಬಗಿದಿ ಲೆಸಿ; ಎ ಮಾರಿ ಆಗನ್ಯಾ ಕವಾನಿ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 23:34" /><verse number="35" style="v" sid="EZK 23:35" />ಇಮ್ಮ ರ್‍ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತು ಮನೆ ಪಿಟ್ಟ ಪಾಚೊ಼ ಭಿರಕೈನ ಇಕ್ಹರಲಕ್ಹು ತಾರಾ ಪುಂಡಾಟನಾ ವರಿ ಸುಳಿತನಾನಾ ಫಲನೆ ತು ಅನುಭವಿಸು.<verse eid="EZK 23:35" /></para>
  <para style="s">ಭಂಬಿ ಭೆನೊನೆ ಥಯಲ ಶಿಕ್ಷಾ</para>
  <para style="p">
    <verse number="36" style="v" sid="EZK 23:36" />ವರಿ ಯಹೊವಾ ಮನೆ ಅಮ್ಮ ಕದ್ಯೊ ಮನಕ್ಹನಾ ದಿಕ್ರಾ ಒಹೊಲನೆಬಿ ಒಹೊಲಿಬನೆಬಿ ಫೈಸಲೊ ಕರಾನೆ ತಾರು ಮನಸ ಸಿದ್ದ ಛೆಸು? ತಿನಾ ಕೆಟ್ಟ ವಿಚಾರೊನೆ ತ್ಯುನೊನೆ ತಿಳ್ಸಾ. <verse eid="EZK 23:36" /><verse number="37" style="v" sid="EZK 23:37" />ತ್ಯುನೆ ವ್ಯಬಿಚಾರ ಕರಾಲಾ ವ್ಹೈ, ತ್ಯುನೊ ಹತ್ತ ರಗತ ಥಯೊಸ, ತ್ಯುನಾ ಗೊಂಬಿಯೊಕ್ಹು ವ್ಯಬಿಚಾರ ಕರ್‍ಯಾಸ, ಮನೆ ಹುಟ್ಟಲ ತಾಮಾರಾ ಗಂಡ ಬಚ್ಚಾವೊನೆ ತೆ ಗೊಂಬಿಯೊನೆ ಬಲಿಥೈನ ಆಹುತಿ ದಿದ್ಯಾಸ. <verse eid="EZK 23:37" /><verse number="38" style="v" sid="EZK 23:38" />ಎ ನೈಸೊ ಮನೆ ಎ ಅಪರಾಧನೆ ಕರ್‍ಯಾಸ; ಆಹುತಿ ದಿದಲ ದಿನ್ನಮಾ ಮಾರಾ ಪವಿತ್ರ ಆಲಯನೆ ಅಪವಿತ್ರ ಕರಿನ ಮಿ ನೆಮಸಲ ಸಬ್ಬತ ದಿನನೆ ಹೊಲಸ ಕರ್‍ಯಾಸ. <verse eid="EZK 23:38" /><verse number="39" style="v" sid="EZK 23:39" />ತ್ಯುನಾ ಬಚ್ಚಾವೊನೆ ಕ್ಹಲಾಸ ಕರಿನ ತ್ಯುನಾ ಗೊಂಬಿಯೊಕ್ಹು ಅರ್ಪಿಸಲ ದಿನಮಾ ಮಾರಾ ಪವಿತ್ರ ಆಲಯಮಾ ಸೆರಿನ ಹೊಲಸ ಕರ್‍ಯಾಸ; ಹಮ್ನಾ ಮಾರಾ ಗುಡಿನಾ ವಚ್ಮಾ ಎ ಕ್ಹಾರು ಕರ‍್ಯಾ. <verse eid="EZK 23:39" /><verse number="40" style="v" sid="EZK 23:40" />ತೆಕ್ಲು ನೈಸೊ ಸುದ್ದಿ ಕವಾಲಾನೆ ವಳೈನ ದಣ್ಗಾವೊನೆ ದುರತಾ ಬಲೈಲಿದ್ಯಾ; ಹಮ್ನಾ ತ್ಯುನೆ ಆಯಾ; ಎ ಬಾಕ್ಡಿ, ತ್ಯುನಾಹುತಿ ತು ಅಂಗ ಧ್ವಲಿನ ಡೊಳೆ ಅಂಜೊ಼ನ ಲಗಾಳಿನ ತುನೆ ಕ್ಹೊನಾನಾ ಸಮ್ನೊಕ್ಹು ತಯ್ಯಾರ ಕರಲಿನ <verse eid="EZK 23:40" /><verse number="41" style="v" sid="EZK 23:41" />ವೈಭವನಾ ಪಲಂಗಾನಾ ಉಪ್ಪರ ಬೈಟಲ; ತಿನಾ ಕ್ಹಾಮು ಕ್ಹಾವಾನೆ ತಯ್ಯಾರ ಥಯಲ ಟೆಬಲಪರ ಮಾರಾ ಬಾಸನಾ ತೆಲೊನೆ ಮ್ಹೆಲಿಸ. <verse eid="EZK 23:41" /><verse number="42" style="v" sid="EZK 23:42" />ತ್ಯಾ ಕ್ಹುಸಿ ಥಾವಾಲಾ ಮ್ಹೊಟಾ ಗುಂಪನಾ ಕಳಕಳ ಥಯು; ರಾನಮಾತು ಮಂಗೈಲಿನ ಪಿದ್ಯಾ ರಾಜ್ಯವೊನಾ ಕ್ಹಾತೆ ಮಳಿನ ತೆ ಭಂಬಿಜ಼ನಾ ಹತ್ಮಾ ಕಡಾವೊನೆ ಘಾಲಿನ ತ್ಯುನಾ ಮಾತಾನೆ ಸುಂದರ ಕಿರಿಟನೆ ಮ್ಹೆಲ್ಯಾ. <verse eid="EZK 23:42" /><verse number="43" style="v" sid="EZK 23:43" />ತೆಳಾಮಾ ಮಿ ಕಳಾ ನೈ ರ‍್ಹಯಲವಾಲಿನೆ ಹಜಿ ವ್ಯಬಿಚಾರ ವ್ಹೈಸು! ಇವ್ನೆ ತಿನಾಕ್ಹಾತೆ ತೆ ಇವ್ನಾಕ್ಹಾತೆ ಜಾರತನಾ ಕರಸತೊ ಕೈ ಕೈಲಿದ್ಯಾ. <verse eid="EZK 23:43" /><verse number="44" style="v" sid="EZK 23:44" />ಸುಳಿನೆ ಸೆರಾನಾನಿಂಗತ ಎ ಮನಕ್ಹೊ ತಿನೆ ಸೆರ‍್ಯಾ; ಹೊ, ಕೆಟ್ಟ ಬಾಕ್ಡಿಯೊ ಥಯಲ ಒಹೊಲನೆ ಒಹೊಲಿಬನೆ ಸೆರ‍್ಯಾ. <verse eid="EZK 23:44" /><verse number="45" style="v" sid="EZK 23:45" />ಸದ್ದರ್ಮಿಯೊ ತ್ಯುನೊನೆ ಫೈಸಲೊ ಕರಿನ ವ್ಯಬಿಚಾರಿಯೊನೆ ರಗತ ಚು಼ವಾಲಾ ಬಾಕ್ಡಿಯೊನೆ ತಕ್ಕ ದಂಡನೆ ತ್ಯುನೊನೆ ದಿವಸ; ತ್ಯುನೆ ವ್ಯಬಿಚಾರ ಕರಾಲಾ ವ್ಹೈ, ತ್ಯುನೊ ಹತ್ತ ರಗತ ಥಯೊಸ. <verse eid="EZK 23:45" /><verse number="46" style="v" sid="EZK 23:46" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಿ ಆಂ ಬಾಕ್ಡಯೊನಾ ದಂಡನಾಹುತಿ ಪಂಚಾತಿ ಮಳೈನ ತ್ಯುನೊನೆ ಸೊರೆಮಾ ಕ್ಹಾಪಡೈನ ಕ್ಹಾರಾವೊನೆ ಭಯಾಸ್ಪದ ಥಾವಾನಿಂಗತ ಕರುಸ. <verse eid="EZK 23:46" /><verse number="47" style="v" sid="EZK 23:47" />ಸಬೆವಾಲಾ ಇವ್ನಾ ಉಪ್ಪರ ದಗ್ಡಾ ಭಿರಕೈನ ತಲ್ವಾರೊಕ್ಹು ಇನೊನೆ ಕ್ಹಲಾಸ ಕರಿನ ಇವ್ನಾ ಗಂಡ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ ಮಾರಿನ ಇವ್ನಾ ಘರೊ ಆಗಕ್ಹು ಬಾಳಿಪಡಸ. <verse eid="EZK 23:47" /><verse number="48" style="v" sid="EZK 23:48" />ಇಮ್ಮ ಮಿ ದೆಶೊಮಾತೊ ಪುಂಡಾಟನೆ ಕಾಡುಸ; ಇನಾಕ್ಹು ಕ್ಹಾರಾ ಬಾಕ್ಡಿಯೊನೆ ತುಮಾರಾ ಪುಂಡಾಟನೆ ಅನುಸರಿಸು ನೈಕೈನ ಗ್ಯಾನ ಆವಸ. ತುಮಾರಾ ಪುಂಡಾಟನೆ ಫಲನೆ ತುಮೊನೆ ಕ್ಹಲಾವಸ; <verse eid="EZK 23:48" /><verse number="49" style="v" sid="EZK 23:49" />ತುಮಾರಾ ಗೊಂಬಿಯೊಕ್ಹು ಥಯಲ ತುಮಾರಾ ಪಾಪೊನೆ ತುಮೆ ಅನುಭವಿಸಿನ ಮಿಜ಼ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತಿಳದಿ ಲಿವೊಸಿ.<verse eid="EZK 23:49" /></para>
  <chapter eid="EZK 23" />
  <chapter number="24" style="c" sid="EZK 24" />
  <para style="s">ಯರುಸೆಲಿಮ ಅನ್ನ ತಪಾಲೊ ವ್ಹೈ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 24:1" />ನೌವಾ ವರಕ್ಹನಾ ದಕ್ಹವಾ ಮ್ಹೈನಾನಾ ದಕ್ಹವಾ ದಿನಮಾ ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ. <verse eid="EZK 24:1" /><verse number="2" style="v" sid="EZK 24:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಎ ದಿನನಾ ಎಜ಼ ದಿನನು ನಾಮನೆ ಲಿಕ್ಕಿಲೆ; ಎಜ಼ ದಿನಮಾ ಬಾಬಲೊನನೊ ರಾಜೊ಼ ಯರುಸಲೆಮನೆ ಮುತ್ತಿಗೆ ಘಾಲ್ಯೊಸ. <verse eid="EZK 24:2" /><verse number="3" style="v" sid="EZK 24:3" />ಆಂ ದ್ರೊಹಿ ವಂಶನೆ ದೃಷ್ಟಾಂತನೆ ಉಚೈನ ಅಮ್ಮ ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತಪಾಲೊ ಚು಼ಲ್ಲಾನಾ ಉಪ್ಪರಮ್ಹೆಲ, ತಿಮಾ ಪಾನಿ ಘಾಲ; <verse eid="EZK 24:3" /><verse number="4" style="v" sid="EZK 24:4" />ಮಾಕ್ಹನಾ ತುಕ್ಡಾವೊನೆ ಕದ್ಯಾಮ ಮಾಂಡಿ ಮುಂದೊಡ ಪೈಲಾ ರ‍್ಹಯಲ ಚೊ಼ಕಾ ಮಾಕ್ಹನೆ ಕ್ಹಾರಾ ತಿಮಾ ಮಳೈ ಘಾಲ, ಚೊ಼ಕಾ ರ‍್ಹಯಲ ಹಡ್ಕಾವೊನೆ ತಿಮಾ ಭರಾ. <verse eid="EZK 24:4" /><verse number="5" style="v" sid="EZK 24:5" />ಹಿಂಡಮಾ ಚೊ಼ಕು ರ‍್ಹಯಲನೆ ಕಾಳ್ಳೆ; ಹಂಡಾನಾ ಹೆಟೊ ಹಡ್ಕಾವೊನೆ ರಾಸಿರಾಸಿ ಥಯನ ವಟ್ಟಿನ ಚೊ಼ಕಿತರಾ ಉಕಳೈನ; ಹೊ, ಹಡ್ಕಾ ತಿಮಾ ಚ಼ಡಾದೆ. <verse eid="EZK 24:5" /><verse number="6" style="v" sid="EZK 24:6" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ. ಹಾ, ಮಾಡ್ರೊ ಥಯಲ ಗಾಮನಿ ಗತಿ ಸು ಕೌ! ತೆ ಹಂಡಾನು ಕಾಳು ಗಯೆವಾಚಿ಼ ತಿಮಾಜ಼ ಹೆಪ್ಪ ಗಟ್ಟ್ಯುಸತೊ! ಮಾಕ್ಹನಾ ತುಕ್ಡಾವೊನೆ ಮಳಲ ನಿಂಗತ ಕಾಡಿಪಡ, ಇನೆ ಕ್ರಮನು ಚಿಟ ನತ್ತಿ. <verse eid="EZK 24:6" /><verse number="7" style="v" sid="EZK 24:7" />ಯರುಸಲೆಮ ಚು಼ವಾಯಲ ರಗತ ತಿಮಾಜ಼ ಹುಬ್ರಯುಸ; ದುಳ ಝಾಕ್ಯುಸ ಕೈನ ತೆ ಗಾಮವಾಲಾ ತಿನೆ ಜಿಮಿನ್ಪರ ರಿಚಾ಼ಯೆವಾಚಿ ಕ್ಹಾಲಿ ದಗ್ಡಾಪರ ಹುಬ್ರಾಡಾಸ; <verse eid="EZK 24:7" /><verse number="8" style="v" sid="EZK 24:8" />ತೆ ರಗತಕ್ಹು ಶಿಟ್ಟ ಐನ ಶೆಡನೆ ಶೆಡ ತಿರಸು ಕೈನ ತಿನೆ ಮಿ ಇಂಗ ಕರೆವಾಚಿ಼ ಕ್ಹಾಲಿ ದಗ್ಡಾಪರ ಹುಬ್ರಾಡ್ಯೊಸ. <verse eid="EZK 24:8" /><verse number="9" style="v" sid="EZK 24:9" />ಇಮ್ಮ ರ್‍ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಹಾ,ಮಾಡ್ರೊ ಥಯಲ ಗಾಮನಿ ಗತಿನೆ ಸು ಕೌ! ಮಿಜ಼ ಆಗನೆ ರಾಶಿಥೈನ ಲಗಾಡುಸ. <verse eid="EZK 24:9" /><verse number="10" style="v" sid="EZK 24:10" />ಘನು ಸೌದೆ ಘಾಲ, ಆಗನೆ ಲಗಾಡ, ಮಾಕ್ಹನೆ ಘನೊ ಚ಼ಡಾ, ಶರವೊ ಉಕಳಾ ಹಡ್ಕಾವೊ ಚ಼ಡಿನ ಜಾ಼ವಾದೆ. <verse eid="EZK 24:10" /><verse number="11" style="v" sid="EZK 24:11" />ಪಾಚಾ಼ತೊ ಹಂಡೊ ಉನ್ನೊ ಥೈನ ತಾಂಬು ಲಾಲ ಥೈನ ಮ್ಹೈನು ಗಲಿಜ ಕರಗಿನ ಕಾಳು ನೈಸೊ ಥೈನ ತಿನೆ ಬರಿದು ಕರಿನ ಆಗನಾ ಕೆಂಡಾವೊಪರ ಮ್ಹೆಲ. <verse eid="EZK 24:11" /><verse number="12" style="v" sid="EZK 24:12" />ತೆ ಮನೆ ಕ್ಹಾಲಿ ಪ್ರಯಾಸನೆ ಆಯಾಸನೆ ಉಂಟ ಕರ್‍ಯುಸ; ತೆ ರ್ಹೈತಬಿ ತಿನೆ ಲಾಗಲ ಘನ್ನು ಕಾಳು ಗಯು ನೈ, ಆಗಕ್ಹುಬಿ ಥಯು ನೈ. <verse eid="EZK 24:12" /><verse number="13" style="v" sid="EZK 24:13" />ತಾರಿ ಉರುಣಗಿ ಅಸಹ್ಯ ರ‍್ಹಯಲಕ್ಹುಬಿ ಮಿ ತುನೆ ಕೆಕ್ಲೊ ಶುದ್ದ ಕರಿತಬಿ ತು ಶುದ್ದ ಥಯೆವಾಚಿ಼ ಗಯಲಕ್ಹು ಮಿ ಮಾರಿ ಶಿಟ್ಟನೆ ತಾರಾಮಾ ತಿರಿಸಿಲಿನ ಶಾಂತ ಥಯೆಲಕ್ಕಾ ತು ತಾರಾ ರಾಡಿನೆ ಹಜಿ಼ ನೈ ಗೈನ ಶುದ್ದ ಥಯೆವಾಚಿ಼ ರ್ಹಸಿ. <verse eid="EZK 24:13" /><verse number="14" style="v" sid="EZK 24:14" />ಯಹೊವಾ ಥಯಲ ಮಿಜ಼ ಎ ಕದ್ಯೊಸ; ಎ ಸಾಗಸ, ಮಿ ಪುರಾಕರುಸ; ಪಾಚು಼ ರ‍್ಹಯಲ ಮಾಫಕರುಸ, ಮರಗುಸ, ತಾರಾ ಕೆಟ್ಟವಾಟನೆ ಕೆಟ್ಟಕಾಮೊನೆ ಕರೆಟ್ಟ ತುನೆ ಫೈಸಲೊ ಥಾವಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 24:14" /></para>
  <para style="s">ಪ್ರವಾದಿನಿ ಬೈಕೊನು ಮರಣ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 24:15" />ಯಹೊವಾ ಹಜಿಯಕ್ಕ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 24:15" /><verse number="16" style="v" sid="EZK 24:16" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ ಹಮ್ನಾ, ಯಕ್ಕಜ಼ ಮಾರಕ್ಹು ಮಿ ತುನೆ ಡೊಳಾನೆ ಪಸಂದ ಥಯಲವಾಲಿನೆ ತಾರಾಮಾತೊ ಕಾಡಿ ಪಡುಸ, ತೆ ರ್ಹೈತಬಿ ತು ಬೊಂಬಲು ನಕೊ, ರೌನಕೊ, ತಾರು ಡೊಳಾಮಾನು ಪಾನಿ ಔನೈ, ಅವಾಜ಼ ನೈಸೊ ಮಾಂಗಿಲೆ. <verse eid="EZK 24:16" /><verse number="17" style="v" sid="EZK 24:17" />ದುರ ಥಯಲ ದುಕ್ಕನೆ ದೆಕಾಡು ನಕೊ, ಟುವಾನೆ ಸುತ್ತಿಲೆ, ಕಾರಮಲಿಯೊನೆ ಘಾಲಿ ಲಿದಲ ರ್ಹೆ, ಮ್ಹೊಡಾನೆ ಪಡ್ಕಾಕ್ಹು ಝಾಕಿಲ್ಯು ನಕೊ, ಮೌತನು ಅನ್ನ ಕ್ಹೌ ನಕೊ, <verse eid="EZK 24:17" /><verse number="18" style="v" sid="EZK 24:18" />ಇಮ್ಮ ಅಗನ್ಯಾ ಥಾವಾನೆ ಮಿ ಪ್ರಾಂತಕಾಲಮಾ ಮನಕ್ಹೊನೆ ಕದ್ಯೊ; ಕ್ಹಾಂಜ಼ೆ ಮಾರಿ ಬೈಕೊ ಮರಿ ಗಯಿ; ಮರನಾದಿನ್ನೆ ಪಾಟೆ ಮನೆ ಅಗನ್ಯಾ ಥಯಲ ನಿಂಗತ ಚಾ಼ಲ್ಯೊ. <verse eid="EZK 24:18" /><verse number="19" style="v" sid="EZK 24:19" />ಮನಕ್ಹೊ ತು ಅಮ್ಮ ಕರಲಕ್ಹು ಹಮೆ ತಿಳದ್ಯಾನೈಸು? ತಿಳಸಾತಾನೈಸು? ಕೈನ ಮನೆ ಪುಚ್ಚತಾಮಾ <verse eid="EZK 24:19" /><verse number="20" style="v" sid="EZK 24:20" />ಮಿ ತ್ಯುನೊನೆ ಅಮ್ಮ ಕದ್ಯೊ. ಯಹೊವಾ ಅಂ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊಸ <verse eid="EZK 24:20" /><verse number="21" style="v" sid="EZK 24:21" />ಇಸ್ರಾಯಲನಾ ವಂಶವಾಲಾನೆ ಅಮ್ಮ ಕೆ ಹಾ, ತುಮೊನೆ ಕ್ಹಾಸ ತಾಕತ ಡೊಳಾನಿ ಕ್ಹುಶಿ ಜ಼ಲಮತೊ ಮಯಾ ಥಯಲ ಮಾರಾ ಪವಿತ್ರ ಆಲಯನೆ ಮಿ ಹೊಲೆ ಕರುಸ. ತುಮೆ ಛೊಡಿನ ಆಯಲ ತುಮಾರಾ ಗಂಡ ಹೆಣ್ಣ ಬಚ್ಚಾ ತಲ್ವಾರನೆ ಬೊಂದೊ ಥಾವಸ ಕವಾನು ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಕದ್ಯೊಸ. <verse eid="EZK 24:21" /><verse number="22" style="v" sid="EZK 24:22" />ಮಿ ಕರಲ ನಿಂಗತ ತೆಳಾಮಾ ತುಮೆಬಿ ಕರೊಸಿ, ಕದ್ಯಾಮ ಫಡ್ಕಾಕ್ಹು ಮ್ಹೊಡು ಝಾಕಿಲಿದ್ಯಾವಾಚಿ಼ ಗಾರಿಕೆನೆ ಕ್ಹಾದ್ಯಾವಾಚಿ಼ <verse eid="EZK 24:22" /><verse number="23" style="v" sid="EZK 24:23" />ಟುವಾನೆ ಸುತ್ತಿಲಿನ ಕಾರಮಲಿಯೊ ಘಾಲಿನ ರ್ಹವೊಸಿ, ತುಮೆ ಅಡ್ಡತಾ ನೈ ರೊತಾನೈ; ತುಮಾರಾ ಅಧರ್ಮಕ್ಹು ಕ್ಷಿಣಥೈನ ಜಾ಼ವೊಸಿ, ಯಕ್ಲಾನಾ ಕ್ಹಾಮಾ ಯಕ್ಲಾ ನಳ್ಳೊಸಿ. <verse eid="EZK 24:23" /><verse number="24" style="v" sid="EZK 24:24" />ಯಹೊವಾನಿ ಎ ವಾತನೆ ಐಕೊ ಎ ವಿಷಯಮಾ ಯೆಹೆಜ್ಕೆಲಾ ತುಮೊನೆ ಪೈಲಾ ವಳಕ ಥಾವಸ, ತೆ ಕರಲ ನಿಂಗತ ಕ್ಹಾರುಜ಼ ಕರೊಸಿ; ಎ ಸಂಬವ ಥಾತಾಮಾ ಮಿಜ಼ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ. <verse eid="EZK 24:24" /><verse number="25" style="v" sid="EZK 24:25" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತ್ಯುನೊನೆ ಬಲಾಧಾರಬಿ ಡೊಳಾನಿ ಕ್ಹುಶಿ ಥಯಲ ತ್ಯುನಾ ಪಸಂದ ಸುಂದರಾಲನೆ ಮನಸ ಉಲ್ಲಾಸ ಥಯಲ ತ್ಯುನಾ ಗಂಡ ಹೆಣ್ಣ ಬಚ್ಚಾವೊನೆ <verse eid="EZK 24:25" /><verse number="26" style="v" sid="EZK 24:26" />ಮಿ, ನಿರ್ಮೂಲ ಕರಾನಾ ದಿನಮಾ ಚು಼ಕೈಲಿನ ತುಕನ ಔಸ, ಥಯಲ ಸಂಗತಿನೆ ತಾರಾ ಕಾನೆ ಪಡಾ ವರಕ್ಹು ಕೌಸ. <verse eid="EZK 24:26" /><verse number="27" style="v" sid="EZK 24:27" />ತೆ ದಿನಮಾ ಚು಼ಕೈಲಿದಲ ವಾಲಾನೆ ತು ಮ್ಹೊಡು ಕ್ಹೊಲಸಿ, ತಾರಾ ಮೂಕಾತನಾನೆ ಜ಼ವೈಲಿನ ಬೊಲಸಿ; ಅಮ್ಮ ತು ತ್ಯುನೊನೆ ವಳಕ ಥಾವಾನೆ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 24:27" /></para>
  <chapter eid="EZK 24" />
  <chapter number="25" style="c" sid="EZK 25" />
  <para style="s">ಅಮೊನಿಯನಾ ವಿರುದ್ದ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 25:1" />ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ, <verse eid="EZK 25:1" /><verse number="2" style="v" sid="EZK 25:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ ತು ಅಮ್ಮೊನೆ ಕ್ಹಾಮೊ ಥೈನ ತಿನಾ ವಿಷಯಮಾ ದೈವ ಸಂಕಲ್ಪನೆ ಪ್ರಕಟ ಕರ್ತೊ ತಿನೆ ಇಮ್ಮ ಕೆ, <verse eid="EZK 25:2" /><verse number="3" style="v" sid="EZK 25:3" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತನೆ ಐಕ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ. ಅಮ್ಮೊನ ಮಾರಾ ಪವಿತ್ರ ಆಲಯನೆ ಹೊಲಸ ರ‍್ಹಯಲನೆ, ಇಸ್ರಾಯಲನು ದೆಶ ಹಾಳ ಪಡಲನೆ ಯಹೊದ ವಂಶವಾಲಾ ಸೆರೆ ಗಯಲನೆ ತು ದೆಕಿನ ಆಹಾ ಕದ್ಯೊ. <verse eid="EZK 25:3" /><verse number="4" style="v" sid="EZK 25:4" />ಹಮ್ನಾ ಮಿ ತುನೆ ಮೂಡಣವಾಲಾವೊನೆ ಬಾದ್ಯಥೈನ ವಶಮಾ ಕರುಸ; ತ್ಯುನೆ ತಾರಾಮಾ ತ್ಯುನಾ ಗುಡಾರೊನೆ ಘಾಲಿನ ಪಾಳೆ ಕರಲಿವಸ; ತಾರಾ ಫಲನೆ ಕ್ಹೈನ ತಾರಾ ದುದ್ದನೆ ಪಿಪಡಸ. <verse eid="EZK 25:4" /><verse number="5" style="v" sid="EZK 25:5" />ಮಿ ರಬ್ಬಾ ಗಾಮನೆ ಹುಂಟೊನೆ ಲಾಯಥೈನ ಅಮ್ಮೊನ ಸಿಮೆನೆ ಬಕ್ರಾನಾ ಹಿಂಡನೆ ಅರಾಮ ಕರಾನಿ ಜ಼ಗಾ ನಿಂಗತ ಕರಸ; ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ. <verse eid="EZK 25:5" /><verse number="6" style="v" sid="EZK 25:6" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಇಮ್ಮ ಕವಸ, ತು ಚಪ್ಪಾಳೊ ಮಾರಿನ ಪಗ್ಗಕ್ಹು ಜಿಮಿನ ಬಡೈನ ಇಸ್ರಾಯಲ ದೆಶನೆ ಪೂರಾ ಮನಸಕ್ಹು ಇನ್ಕಾರ ಕರಿನ ತಿನಾ ಗತಿನೆ ಹಿಗ್ಗಿ ಲಿದಲಕ್ಹು <verse eid="EZK 25:6" /><verse number="7" style="v" sid="EZK 25:7" />ಹಮ್ನಾ ಮಿ ತಾರಾ ಉಪ್ಪರ ಹತ್ತ ಉಚೈನ ತುನೆ ಸುರೆ ಥೈನ ಕಿಳ ಮನಕ್ಹೊನಾ ವಶಮಾ ಕರಲಿನ ಜನಾಂಗೊಮಾತು ಕಿತ್ತಿನ ದೆಶಮಾತೊ ತಾರು ನಾಮ ನುಚ್ಚಿನ ತುನೆ ಹಾಳ ಕರುಸ; ತೆಳಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈಕೈನ ತುಮೊನೆ ಗೊತ್ತ ಥಾವಸ,<verse eid="EZK 25:7" /></para>
  <para style="s">ಮೊವಾಬ್ಯನಾ ವಿರುದ್ದ ಪ್ರವಾದನ</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 25:8" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಆಹಾ, ಯಹೊದವಂಶ ಕ್ಹಾರಾ ಜನಾಂಗನಾ ನಿಂಗತ ಛೆ, ಕ್ಹಾಸ ಸುವೈ? ಕೈನ ಮೊವಾಬು ಸೆಯಿರು ಕೈಲಿದಲಕ್ಹು <verse eid="EZK 25:8" /><verse number="9" style="v" sid="EZK 25:9" />ಹಮ್ನಾ, ದೆಶ ಭುಷಣ ಥಯಲ ಮೊವಾಬಿನ ಗಡಿನಾ ಗಾಮೊ ಕದ್ಯಾಮ ಬೆತಯೆಷಮೊತ ಬಾಳಮೆಯೊನ, ಕಿರ್ಯಾಥಯಮ ಕವಾನಾ ಗಾಮೊ ರ್ಹವಾನಾ ಜ಼ಗಾಮಾ ಮಿ ಮೊವಾಬಿನಾ ಮೆರೆನೆ ಫೊಡಿನ <verse eid="EZK 25:9" /><verse number="10" style="v" sid="EZK 25:10" />ತೆ ಸಿಮೆನೈಸೊ ಅಮ್ಮೊನೆ ಪುರ್ವತೊ ಬಾದ್ಯಥೈನ ದಿನ ಅಮ್ಮೊನ್ಯರೊ ಜನಾಂಗೊಮಾ ನಿರ್ನಾಮ ಥವುಕೈನ ಮಾರಾ ಸಂಕಲ್ಪನೆ ಪುರಾಕರುಸ; <verse eid="EZK 25:10" /><verse number="11" style="v" sid="EZK 25:11" />ಮೊವಾಬ್ಯನೆ ದಂಡ ದಿನ ತಿರಸುಸ; ತೆಳಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈಕೈನ ತ್ಯುನೊನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 25:11" /></para>
  <para style="s">ಯೆದೊಮನಾ ವಿರುದ್ದ ಪ್ರವದನೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 25:12" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ, ಎದೊಮು ಯಹುದ ವಂಶನೆ ಪ್ರತಿಕಾರ ಕರ್‍ಯಾಸ; ಮುಯ್ಯಿನೆ ಮುಯ್ಯಿತಿರುಸುಸ ಮಹಾ ಅಪರಾಧನೆ ಕರ್‍ಯಾವಾಚಿ಼; <verse eid="EZK 25:12" /><verse number="13" style="v" sid="EZK 25:13" />ಇಮ್ಮ ರ್‍ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಿ ಎದೊಮನಾ ಉಪ್ಪರ ಹತ್ತ ಉಚೈನ ತಿಮಾತು ಮನಕ್ಹೊನೆ ಜಾನವರೊನೆ ನಿರ್ಮೂಲ ಕರಿನ ತೆಮಾನತು ದೆದಾನಿಲಕ್ಕಾ ತಿನೆ ಹಾಳ ಕರಿನ ಪ್ರಜೆನೆ ತಲ್ವಾರನೆ ಕ್ಹಾಪಡೌಸ. <verse eid="EZK 25:13" /><verse number="14" style="v" sid="EZK 25:14" />ಮಿ ಎದೊಮನೆ ಮಾರಾ ಮನಕ್ಹೊ ಥಯಲ ಇಸ್ರಾಯಲನಾ ಹತ್ತಕ್ಹು ಮುಯ್ಯಿ ತಿರಸುಸ; ತ್ಯುನೆ ಮಾರಾ ಶಿಟ್ಟನೆ ತಕ್ಕ ನಿಂಗತ ತಿನೆ ಕರಸ; ಮಾರಿ ಪ್ರತಿಕಾರ ಎದೊಮಿನು ಅನುಭವನೆ ಆವಸ; ಆಂ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 25:14" /></para>
  <para style="s">ಪಿಲಿಸ್ತಿನನಾ ವಿರುದ್ದ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 25:15" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ, ಪಿಲಿಷ್ಟಿವಾಲಾ ಯಹುದನೆ ವಿರುದ್ದ ಕರ್‍ಯಾಸ; ಹೊ, ಮುಯ್ಯಿನೆ ಮುಯ್ಯಿ ತಿರಸಾತಾ ತಿನೆ ಪುರಾ ಮನಸಕ್ಹು ಇನ್ಕಾರಿನ ದಿರ್ಘ ದ್ವೆಷಕ್ಹು ಹಾಳ ಕರ್‍ಯಾಸ; <verse eid="EZK 25:15" /><verse number="16" style="v" sid="EZK 25:16" />ಇಮ್ಮ ರ್‍ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಹಮ್ನಾ, ಮಿ ಪಿಲಿಷ್ಟೊನಾ ವಿರುದ್ದ ಹತ್ತ ಉಚೌಸ; ಕೆರೆತಿವಾಲಾವೊನೆ ಕತ್ರಿನ ಸಮಂದರನಾ ದಂಡಿಮಾ ಮನಕ್ಹೊನೊ ಯಕ್ಲಾನೆಬಿ ವಚಾ಼ಡತೊ ನೈ. <verse eid="EZK 25:16" /><verse number="17" style="v" sid="EZK 25:17" />ತ್ಯುನೆ ಕ್ಹಾರಾ ಘಟ್ಟ ಹುಶಾರಕಿ ದಿನ ಕರಿನ ಮುಯ್ಯಿನೆ ಮುಯ್ಯಿ ತಿರುಸುಸ; ಇಮ್ಮ ಶೆಡ ಕರಾನೆ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಗೊತ್ತ ಥಾವಸ.<verse eid="EZK 25:17" /></para>
  <chapter eid="EZK 25" />
  <chapter number="26" style="c" sid="EZK 26" />
  <para style="s">ತುರನಾ ಗಾಮನಾ ವಿರುದ್ದ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 26:1" />ಯೆಹುಯಾಕಿಮನೆ ಜೈಲಮಾ ಘಾಲಿನ ಗ್ಯಾರಾವಾ ವರಕ್ಹನಾ ಕಯಾ ಯಕ್ಕ ಮ್ಹೈನಾನಾ ಪಸ್ಟ ದಿನ್ನಮಾ ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ. <verse eid="EZK 26:1" /><verse number="2" style="v" sid="EZK 26:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತುರ ಯೆರುಸಲೆಮನಾ ವಿಷಯಮಾ, ಜನಾಂಗೊನೆ ಅಡ್ಡಿ ಥಯಲ ಬಾಕಲ ತುಟಿ ಗಯುಸ! ಮಕನ ಕ್ಹುಲಿ ಗಯುಸ; ಯೆರುಸಲೆಮ ಹಾಳ ಥಯಲಕ್ಹು ಮಿ ಭರಿಲ್ಯುಸ ಕೈನ ಕೈಲಿದಲಕ್ಹು <verse eid="EZK 26:2" /><verse number="3" style="v" sid="EZK 26:3" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ದೆಕ, ತುರ, ತುನೆ ವಿರುದ್ದ ಥಯೊಸ; ಸಮುಂದರನಾ ಅಲೆಯೊ ಉಟಾಡಲ ನಿಂಗತ ಮಿ ಘನ್ನಾ ಜನಾಂಗೊನೆ ತಾರಾ ಉಪ್ಪರ ಉಟಾಡುಸ. <verse eid="EZK 26:3" /><verse number="4" style="v" sid="EZK 26:4" />ತೆ ತುರನಾ ಗೊಡಿಯೊನೆ ಪಡಿನ ತಿನಾ ಗೊಪುರೊನೆ ನಾಶ ಕರಿಪಡಸ; ಮಿ ತಿನಿ ಮಾತಿ ಕೆರದಿನ ತೆ ಝಾಡಿನ ಸುಜ಼಼ನೈಸೊ ಕರುಸ; <verse eid="EZK 26:4" /><verse number="5" style="v" sid="EZK 26:5" />ತೆ ಸಮುಂದರನಾ ವಚ್ಮಾ ಬಲಿಯೊನೆ ಕ್ಹುಕ್ಹಿ ಜ಼ಗಾ ಥಾವಸ; ಮಿಜ಼ ತೆ ದೆಕ್ಯೊಸ ಕೈನ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಕವಸ; ತೆ ಜನಾಂಗೊನೆ ಛತ್ತ ಥಾವಸ; <verse eid="EZK 26:5" /><verse number="6" style="v" sid="EZK 26:6" />ಬೈಲಭುಮಿನಾ ತಿನಿಯೊ ದಿಕ್ರಿಯೊ ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಥಾವಸ; ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ಕ್ಹಾರಾವೊನೆ ಗ್ವತ್ತ ಥಾವಸ; <verse eid="EZK 26:6" /><verse number="7" style="v" sid="EZK 26:7" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ದೆಕ, ರಾಜಾಧಿರಾಜ ಬಾಬೆಲನೊ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರನೆ ಘೊಡಾ, ರಥಾ, ಘೊಡಾ ಚ಼ಲಾವಾಲಾ ಘನ್ನಾ ಮನಕ್ಹೊನು ಪರಿವಾರ ಎ ಕ್ಹಾರಾವೊಕ್ಹು ರ‍್ಹಯಲ ಮಿ ಪುರ್ವ ದಿಕ್ತೊ ತುರನಾ ಉಪ್ಪರ ಆವಾಲಗಾಡುಸ. <verse eid="EZK 26:7" /><verse number="8" style="v" sid="EZK 26:8" />ತೆ ಬೈಲಭುಮಿಪರ ರ‍್ಹಯಲ ತಾರಿಯೊ ದಿಕ್ರಿಯೊನೆ ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಕರಿನ ತುನೆ ವಿರುದ್ದ ಥೈನ ಒಡ್ಡುಕಟ್ಟ ದಿಬ್ಬಿ ಘಾಲಿನ <verse eid="EZK 26:8" /><verse number="9" style="v" sid="EZK 26:9" />ಗುರಾಣಿ ಉಚಾವಾಲಾವೊನೆ ವಳೈನ ತಿನಾ ಭಾವ ಕರಾನಾ ಸಾಮನೊಕ್ಹು ತಾರಿ ಪೌಳಿಗೊಡಿನೆ ಮಾರಾಲಗಾಡಿನ ತಿನಾ ಹತಿಯಾರೊಕ್ಹು ತಾರಾ ಗೊಡಿಯೊ ಪಾಡಿಪಡಸ. <verse eid="EZK 26:9" /><verse number="10" style="v" sid="EZK 26:10" />ತೆ ಹಿಸಾಬ ನೈ ರ್xಯಲ ಘೊಡಾವೊಕ್ಹು ಉಟಲ ಧುಳ ತುನೆ ಝಾಕಸ; ಚಿರೈಗಯಲ ಕೊಟೆಮಾ ದುಶ್ಮನ ವ್ಹಕ್ಕೆ ನಿಂಗತ ತೆ ತಾರಾ ಬಾಕಲೊಮಾ ವ್ಹಕ್ತಾಮಾ ಘೊಡಾ ನ್ಹಾಟಾಕ್ಹು, ಗಾಡಿ, ರಥಾ ಇವ್ನಾ ಅವಾಜ಼ನೆ ತಾರಿಯೊ ಗೊಡಿಯೊ ಹಲ್ಲಸ. <verse eid="EZK 26:10" /><verse number="11" style="v" sid="EZK 26:11" />ತಿನಾ ಘೊಡಾವೊನಾ ಪಗೊಕ್ಹು ತಾರಿಯೊ ಒಣಿಯೊನೆ ಕ್ಹುಂದಾ ಲಗಾಡಿನ ತಲ್ವಾರಕ್ಹು ತಾರಾ ಮನಕ್ಹೊನೆ ಕ್ಹಲಾಸ ಕರಿನ ತಾರಾ ತಾಕತವರ ದಗ್ಡಾವೊನಾ ಕ್ಹಂಬಾವೊನೆ ಪಾಡಿಪಡಸ. <verse eid="EZK 26:11" /><verse number="12" style="v" sid="EZK 26:12" />ತಿನಾ ಸೈನಿಕೊ ತಾರಿ ಆಸ್ತಿನೆ ಲುಟಿನ ತಾರಾ ಸಾಮನೊನೆ ಚೊ಼ರಿ ಕರಿನ ತಾರಿಯೊ ಗೊಡಿಯೊನೆ ಪಾಡಿನ ತಾರಾ ಮ್ಹೊಟಾ ಘರೊನೆ ಕಿತ್ತಿನ ತಾರಾ ದಗ್ಡಾ ಝಾಡೊ ಮಾತಿನೆ ಸಮುಂದರನಾ ಪಾಲ ಕರಸ. <verse eid="EZK 26:12" /><verse number="13" style="v" sid="EZK 26:13" />ಮಿ ತಾರಿ ಗಿದ್ದೊನಿ ಅವಾಜ಼ನೆ ಹುಬ್ರಾಡಿ ಪಡುಸ; ತಾರಿ ಕಿನ್ನರಿಯೊನು ಅವಾಜ಼ ಹಬ್ದಾತಿ ಐಕು ನೈ ಆತಿ. <verse eid="EZK 26:13" /><verse number="14" style="v" sid="EZK 26:14" />ಮಿ ತುನೆ ಘಟ್ಟ ದಗ್ಡೊ ಕರುಸ; ತು ಬಲಿಯೊನೆ ವರಾವಾನೆ ನಕಾನಿ ಜ಼ಗಾ ಥಾಶಿ; ತಾರಾ ಉಪ್ಪರ ಹಬ್ದಾ ಘರೊ ಭಾಂದತಾ ನೈ; ಯಹೊವಾ ಥಯಲ ಮಿಜ಼ ಅಪ್ಪಣೆ ದಿದ್ಯೊಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 26:14" /><verse number="15" style="v" sid="EZK 26:15" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ತುರನೆ ಅಮ್ಮ ಕವಸ ತಾರಾ ವಚ್ಮಾ ಕೊಲೆ ಥೈನ ದುಕ್ಕೊ ಥಯಲವಾಲಾ ನೆಳ್ಳಾಕ್ಹು ತು ಪಡಾನಾ ಅವಾಜ಼ನೆ ದ್ವಿಪೊ ಹಲ್ಲಿ ಜಾ಼ವಸ ನೈ. <verse eid="EZK 26:15" /><verse number="16" style="v" sid="EZK 26:16" />ತೆಳಾಮಾ ಸಮುಂದರನಾ ಆಜು಼ ಬಾಜು಼ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಪ್ರಭುವೊ ತ್ಯುನಾ ಸಿಂಹಾಸನೊಪರ್ತಾ ಉತ್ರಿನ ಉಪ್ಪರಲ್ಯಾ ಅಂಗ್ಡಾ ಕಾಡಿನ ಬುಟೆದಾರಿನಾ ವಣ್ಣಾ ಕಿತ್ತಿನ ನಾಕಿನ ತತ್ತರನೆ ವರಾಡಿಲಿನ ಜಿಮನ ಪರ ಬೈಟಿನ ಕ್ಷಣಕ್ಷಣಬಿ ಕಾಪತೊತುನೆ ಬುಚ್ಕಿನ ಘಾಬ್ರಾ ಥಾವಸ. <verse eid="EZK 26:16" /><verse number="17" style="v" sid="EZK 26:17" />ಇವ್ನೆ ತಾರಿ ವಿಷಯಮಾ- ಹಡಗೊ ಚ಼ಲಾವಾಲಾವೊನಾ ಘರೊ, ನಾಮ ರ‍್ಹಯಲ ಪುರಿ, ಸಮುಂದರಕ್ಹು ತಾಕತವರ ಥಯಲ ಗಾಮ, ತು ಕೆಕ್ಲುಕಿ ಹಾಳ ಥೈ! ಸಮುಂದರ ಪರ ಫರಾಲಾ ಕ್ಹಾರಾವೊನೆ ಭೆ ಹುಟ್ಸಾವಾವಾಲಾ ಥಯಲ ತಾರಾ ಘರವಾಲಾ ಕೆಕ್ಲಾಕಿ ಹಾಳ ಥಯಾ! <verse eid="EZK 26:17" /><verse number="18" style="v" sid="EZK 26:18" />ಎ ತಾರಾ ನಾಶ ಥಾವಾನಾ ದಿನ್ನಮಾ ಕರಾವಳಿ ಕಾಪಸ; ತು ನೈ ರ‍್ಹಯಲಕ್ಹು ಸಮುಂದರನಾ ದ್ವಿಪ ಕಾಪಸ ಕವಾನಾ ಶೊಕನು ಗಿದ್ದ ಕವಸ. <verse eid="EZK 26:18" /><verse number="19" style="v" sid="EZK 26:19" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ, ಮಿ ತುನೆ ಹಾಳ ಗಾಮ ಕರಿನ ಮನಕ್ಹೊ ನೈ ರ‍್ಹಯಲ ಗಾಮೊನಿ ಗತಿ ಲೈನ ತು ಜಲರಾಶಿಮಾ ಡುಬಿನ ಜಾವಾವರ್ಕ್ಹು ತಾರಾ ಉಪ್ಪರ ಮಹಾ ಸಾಗರ ಆತಾಮಾ <verse eid="EZK 26:19" /><verse number="20" style="v" sid="EZK 26:20" />ಪೈಲಾನಾ ಕಾಲಮಾ ಹಾಳ ಥಯಲ ಗಾಮೊ ನಿಂಗತ ತುನೆ ಅಧೊಲೊಕಮಾ ಢಕ್ಲಿನ ಪಾತಾಳನೆ ಉರ್ತಲ ಪೈಲಾನಾ ಕಾಲವಾಲಾವೊನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾ ವರ್ಕ್ಹು ಕರುಸ; ಹೊ, ತು ತಾರಾ ಮಹಿಮಾನೆ ಜಿವಲೊಕಮಾ ನೆಲೆ ಕರ‍್ಯಾಬಗರ ನೈ ರ‍್ಹಯಲವಾಲಾ ನಿಂಗತ ತುನೆ ಪಾತಾಳನೆ ಉತ್ರಲವಾಲಾವೊನಾ ಸವಾಸಮಾ ಮಳೌಸ. <verse eid="EZK 26:20" /><verse number="21" style="v" sid="EZK 26:21" />ತುನೆ ಘನ್ನೊ ನಾಶ ಕರುಸ; ತು ನೈ ರ‍್ಹಯಲ ನಿಂಗತ ಥಾಶಿ; ಕಕ್ಲಾ ಹುಡಕಯಾ ತಬಿ ತು ಕೆಳಾಮಾಜ಼಼ ಮಳ್ತಿ ನೈ;ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 26:21" /></para>
  <chapter eid="EZK 26" />
  <chapter number="27" style="c" sid="EZK 27" />
  <para style="s">ತುನರನಾ ಆಂತ್ಯಕ್ರಿಯೆನು ಗಿದ್ದ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 27:1" />ಯಹೊವಾ ವರಿಯಕ್ಕ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 27:1" /><verse number="2" style="v" sid="EZK 27:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ತುರನಾ ವಿಷಯಮಾ ಶೊಕನು ಗಿದ್ದ ಉಚಾ, ತಿನೆ ಅಮ್ಮ ಕೆ <verse eid="EZK 27:2" /><verse number="3" style="v" sid="EZK 27:3" />ಸಮುಂದರನಾ ಬಾಕಲಕನ ರ‍್ಹತಿ ಜನಾಂಗೊನಾ ಹುತಿ ಘನ್ನಾ ದ್ವಿಪನಾ ಕ್ಹಾತೆ ವ್ಯಾಪಾರ ಕರಾನಿ ಪುರಿ! ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತುರ, ಪುರಿತರಾ ಕ್ಹುಬಸುರತ ಥಯಸ ಖೈನ ಕೈಲಿದಿತೊ! <verse eid="EZK 27:3" /><verse number="4" style="v" sid="EZK 27:4" />ತಾರಿ ಜ಼ಗಾತೊ ಸಮುಂದರನಾ ವಚ್ಮಾ಼ಜ಼಼ ವ್ಹೈ; ತುನೆ ಭಾಂದಲವಾಲಾ ತಾರಿ ಸುಂದರತಾನೆ ಪುರಾ ಕರ‍್ಯಾ. <verse eid="EZK 27:4" /><verse number="5" style="v" sid="EZK 27:5" />ಶೆನಿರ, ಪಾನಿನಾ ತುರಾಯಿ ಝಾಡಕ್ಹು ತಾರಾ ಪಕ್ಕೆನಾ ಹಲಗಿಯೊ ಕರಿನ ತ್ಯಾ ಕ್ಹಂಬೊ ತಯ್ಯಾರ ಕರಾನೆ ಲೆಬುನೊನಕ್ಹು ದೆವದಾರ ಝಾಡನೆ ಲಾಯಾ. <verse eid="EZK 27:5" /><verse number="6" style="v" sid="EZK 27:6" />ಬಾಷಾನನಾ ಅಲ್ಲೊನ ಝಾಡತಾ ತಾರಾ ಹುಟ್ಟೊ ತಯ್ಯರ ಕರಿನ ಕಿತ್ತಿಮ್ ದ್ವಿಪನಾ ತಿಲಕನಾ ಹಲಗಿಕ್ಹು ತಾರಾ ಉಪ್ಪರ್ಲಿ ಮಾಳಗಿನೆ ಭಾಂದಿನ ದತಕ್ಹು ಕೆತ್ಯಾ. <verse eid="EZK 27:6" /><verse number="7" style="v" sid="EZK 27:7" />ತಾರಿ ಹಾಯಿ ತುನೆ ಝಂಡೊ ಥಾವಾದೆ ಕೈನ ತಿನೆ ಐಗುಪ್ತನಾ ಕಾಮೊನಾ ನಾರುಬಟ್ಟೆಕ್ಹು ಕರ‍್ಯಾ. ತಾರಾ ಮೆಲ್ಕಟ್ಟ ಎಲಿಷಕರಾವಳಿನಾ ಧುಮ್ರ ರಕ್ತವರ್ಣಕ್ಹು ಚಿತ್ರಾ ನಿಂಗತ ಭರೈತು. <verse eid="EZK 27:7" /><verse number="8" style="v" sid="EZK 27:8" />ಚಿದೊನನಾ ಅವಾರ್ದಿವಾಲಾ ತುನೆ ಹುಟ್ಟ ಘಾಲಸ; ತುರ ಗಾಮವಾಲಾ, ತಾರಾಮಾನಾ ವಿವೆಕಿಯೊ ತಾರಾ ಹಡಗೊ ಚ಼ಲಾವಾಲಾ; <verse eid="EZK 27:8" /><verse number="9" style="v" sid="EZK 27:9" />ತಾರಾಮಾ ಮಳ್ಯಲ ಗೆಬಲಿನನಾ ಶಾನಾ ಶಾಣ್ಯಾ ತಾರಿ ಕಂಡಿಯೊನೆ ಘಟ್ಟ ಕರಸ. ಸಮುಂದರನಾ ಕ್ಹಾರಾ ಹಡಗೊ ಹಡಗಾ ಚ಼ಲಾವಾಲಾವೊನಾ ಕ್ಹಾತೆಜ಼ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹೈನ ತುನೆ ಸಾಮನೊ ಲೈನ ದೆತಾತಾ, <verse eid="EZK 27:9" /><verse number="10" style="v" sid="EZK 27:10" />ಪಾರಸಿಯವಾಲಾ ಲುದ್ಯವಾಲಾ ಪುಟ್ಯವಾಲಾ ತಾರಾ ಸೈನ್ಯನಾ ಅದಿಕಾರಿಯೊ ಥೈನ ವ್ಹತಾ ಕ್ಹೆಡ್ಯ ಶಿರಸ್ತ್ರಾಣೊನೆ ತಾರಾಮಾ ಜೊತ ಪಾಡಿನ ತುನೆ ಭುಷಣೆ ಕರಾಡಾತಾ. <verse eid="EZK 27:10" /><verse number="11" style="v" sid="EZK 27:11" />ಅವಾರ್ದಿನಾವಾಲಾ ಹಲೆಕ ಸೈನಿಕೊ ಸುತ್ತ ಮುತ್ತ ತಾರಾ ಗೊಡಿಯೊ ಪರ ಹುಬ್ರಯಾತಾ, ಗಮ್ಮದ್ಯವಾಲಾ ತಾರಾ ಕೊತ್ತಲೊಮಾ ಕೈದಾಲಾ ಥಯಾತಾ, ಕ್ಹಾರಾ ಜ಼ನಾ ತ್ಯುನಾ ಕ್ಹೆಡ್ಯವೊನೆ ಸುತ್ತ ಮುತ್ತೆ ತಾರಾ ಗೊಡಿಯೊನೆ ಜೊತ ಘಾಲಿನ ತಾರಿ ಸುಂದರತಾನೆ ಪುರಾ ಕರ‍್ಯಾ. <verse eid="EZK 27:11" /><verse number="12" style="v" sid="EZK 27:12" />ಘನ್ನಾ ತಾರಾ ತರಾನಿ ಆಸ್ತಿ ತುನೆ ಚಾ಼ಯೆ ಥಯಲಕ್ಹು ತಾರ್ಷಿಷವಾಲಾ ತುಕನ ಕಾಮವಾಲಾ ಥೈನ ರುಪ್ಪು ಲ್ಹೊಡು ತವರ ಸಿಸೊ ತುನೆ ದಿದ್ಯಾ.<verse eid="EZK 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 27:13" />ಯಾವಾನವಾಲಾ ತುಬಲವಾಲಾ ಮೆಷೆಕವಾಲಾ ತಾರಾ ಪರವಾಗಿ ವ್ಯಾಪಾರ ಕರಿನ ನರಜಾನವರೊನೆ ತಾಂಬಾ ಸಾಮನೊ ತುನೆ ಲಿವಾನು ದಿವಾನು ಕರ‍್ಯಾ. <verse eid="EZK 27:13" /><verse number="14" style="v" sid="EZK 27:14" />ತೊಗರ್ಮವಾಲಾ ಯುದ್ದನಾ ಘೊಡಾ, ಜಾ಼ತನಾ ಘೊಡಾ ಹೆಸರಗದಡಾ ಎಕ್ಹಾರು ತಾರಾಹುತಿ ಲಾಯಾ. <verse eid="EZK 27:14" /><verse number="15" style="v" sid="EZK 27:15" />ದೆದಾನವಾಲಾ ತಾರಾ ವ್ಯಾಪಾರಿಯೊ; ಘನ್ನಾ ದ್ವಿಪನಾ ಉತ್ಪತ್ತಿ ತಾರಾ ಹತೆ ಮಳ್ಯು; ಹತ್ತಿನಾ ದಾತೊನೆ ಕರಿಝಾಡೊ ತುನೆ ವಾಟೊ ದಿದ್ಯಾ. <verse eid="EZK 27:15" /><verse number="16" style="v" sid="EZK 27:16" />ತಾರಾ ಹತ್ತನಾ ಕಾಮನಾ ಸಾಮನೊ ಘನ್ನಾ ರ‍್ಹಯಲಕ್ಹು ಆರಾಮವಾಲಾ ತಾರಾ ಥೈನ ವ್ಯಾಪಾರ ಕರಿನ ಕೆಂಪರಲ ರಕ್ತಾಂಬರ ಕಸುತಿನಾ ವಣ್ಣಾ ನಾರುಬಟ್ಟೆ ಹವಳ ಮಾಣಿಕ್ಯ ಎಕ್ಹಾರಾ ಸಾಮನೊ ತುನೆ ಲೈನ ರಿಚಾ಼ಯಾ. <verse eid="EZK 27:16" /><verse number="17" style="v" sid="EZK 27:17" />ಯೆಹುದ್ಯವಾಲಾ ಇಸ್ರಾಯೆಲ ದೆಶವಾಲಾ ತುಕನನಾ ಕಾಮವಾಲಾ ಥೈನ ಮಿನ್ನಿಥಿವಾಲಾ ಘೌಂ ಖಡಿಸಕ್ಕರ ಜೆನ ತೆಲ ಬಾಸನು ತೆಲ ಎ ಸಾಮನೊನೆ ತುನೆ ದಿದ್ಯಾ. <verse eid="EZK 27:17" /><verse number="18" style="v" sid="EZK 27:18" />ತಾರಾ ಹತ್ತಾನಾ ಕಾಮನಾ ಸಾಮನೊ ತುಕನ ಘನ್ನಾ ರ‍್ಹಯಲಕ್ಹು ಘನ್ನಾ ತರಾ ತರಾನಿ ಆಸ್ತಿ ತುನೆ ಚಾ಼ಯೆ ಥಯಲಕ್ಹಿಬಿ ದಮಸ್ಕವಾಲಾ ತಾರಾ ಪರವಾಗಿ ವ್ಯಾಪಾರ ಕರಿನ ಹೆಲ್ಬೊನನು ದ್ರಾಕ್ಷಿಯೊನು ರಕ್ಹನೆ ಚಾಹರನಾ ಬಕ್ರಾನಾ ಬಾಲೊ ತುಕನ ಭರ್xಯಾ. <verse eid="EZK 27:18" /><verse number="19" style="v" sid="EZK 27:19" />ವೆದಾನವಾಲಾ ದಾವಾನವಾಲಾ ಉಜಾಲಿತಾ ಬಿಜಾ಼ ಬಿಜಾ಼ ಸನುಗೊನೆ ಲೈನ ತುನೆ ದಿದ್ಯಾ. ಲ್ಹೊಡು ಮಸಾಲಾನು ಸಾಮನ ತುನೆ ದಿದ್ಯಾ. <verse eid="EZK 27:19" /><verse number="20" style="v" sid="EZK 27:20" />ದೆದಾನವಾಲಾ ಹಲ್ಲಣನೆ ಕರೆಟ್ಟ ರ‍್ಹಯಲ ಚೊ಼ಕಾ ಜಮಕಾನೊ ತಾರಾಹುತಿ ಲಾವಾಲಾ ವ್ಯಾಪಾರಿಯೊ ಥಯಾತಾ. <verse eid="EZK 27:20" /><verse number="21" style="v" sid="EZK 27:21" />ಅರಬವಾಲಾ ಕೆದಾರನಾ ಕ್ಹಾಸ ಅದಿಕಾರಿಯೊ ತಾರಾ ಹತ್ತನಾ ಕಾಮ ಕರಾಲಾ; ಬಕ್ರಿಯೊ ಟಗರೊ ಬೈಲೊನೆ ತಾರಾಹುತಿ ಚ಼ಲೈಲಿನ ಆಯಾ. <verse eid="EZK 27:21" /><verse number="22" style="v" sid="EZK 27:22" />ಶೆಬದವಾಲಾ ರಗ್ಮವಾಲಾ ತುಕನನಾ ಕಾಮವಾಲಾ ಥಯನ ಕನಕ ಕ್ಹಾಸ-ಕ್ಹಾಸ ಬಾಸನು ತೆಲ ಸಮಾಸ್ತಾಮುಲ ರತ್ನ ಎ ಸಾಮನೊ ತಾರಾಹುತಿ ಲಾಯಾ. <verse eid="EZK 27:22" /><verse number="23" style="v" sid="EZK 27:23" />ಹಾರಾನ ಕನ್ನೆ ಎದೆನ ಜ಼ಗಾವಾಲಾ ಶೆಬ, ಅಶ್ಯುರ್, ಕಿಲ್ಮದ ಗಾಮ್ನಾ ಕಾಮವಾಲಾ. <verse eid="EZK 27:23" /><verse number="24" style="v" sid="EZK 27:24" />ತಾರಾ ವ್ಯಾಪಾರಿಯೊ ಥೈನ ಉತ್ತಮಾಂಬರನಾ ಕಸುತಿನಾ, ಧುಮ್ರನಾ ನಿಲುವಂಗಿ, ಎ ಕ್ಹಾರಾ ಮಾಲೊನೆ ರಾಕ್ಹಕ್ಹು ಘಟ್ಟ ಬಿಗ್ದಿನ ಯಕ್ಕತರಾ ವಣ್ಣಾಕ್ಹು ಗಾಟ್ರಾ, ತಾರಾಹುತಿ ಕಮಾಯಾ. <verse eid="EZK 27:24" /><verse number="25" style="v" sid="EZK 27:25" />ತಾರ್ಷಿನಾ ಹಡಗಾ ಸಾಲ-ಸಾಲ ತುನೆ ಚಾ಼ಯೆ ಥಯಲ ಜಿನಿಸೊನೆ ಲಿನ ಆಯಾ. ತು ಬರ್ತಿ ಥಯನ ಸಮುಂದರನಾ ವಚ್ಮಾ ಘನ್ನು ವಜ್ಜು ಥೈ. <verse eid="EZK 27:25" /><verse number="26" style="v" sid="EZK 27:26" />ಹುಟ್ಟ ಘಾಲಾಲಾ ತುನೆ ಮಹಾ ತರಂಗೊನೆ ಅಟ್ಕಾಯಾಸ; ಪುರ್ವ ದಿಕ್ಕನೊ ಘನ್ನೊ ಜೊ಼ರ ವಾರು ತುನೆ ಸಮುಂದರನಾ ವಚ್ಮಾ ಲಾಗ್ಯುಸ. <verse eid="EZK 27:26" /><verse number="27" style="v" sid="EZK 27:27" />ತಾರಿ ಆಸ್ತಿ, ತಾರಾ ಜಿನಿಸೊ, ತಾರಾ ಸಾಮನೊ, ತಾರಾ ಹಡಗೊ ಚ಼ಲಾವಾಲಾ, ತಾರಾ ಅಂಬಿಗೊ, ತಾರಾ ಕಂಡಿಯೊನೆ ಘಟ್ಟ ಕರಾಲಾ, ತಾರಾ ವ್ಯಾಪಾರಿಯೊ, ತುಕನನಾ ಕ್ಹಾರಾ ಸೈನಿಕೊ, ಕಿಮ್ಮೆಬಿ ತಾರಾಮಾ ಮಳ್ಯಲ ತಾರಾ ಸಿಬ್ಬಂದೊಯೊ ತಾರಾ ನಾಶನನಾ ದಿನ್ನಮಾ ಸಮುಂದರ ಡುಬಿ ಜಾ಼ವಸ. <verse eid="EZK 27:27" /><verse number="28" style="v" sid="EZK 27:28" />ತಾರಾ ಹಡಗೊ ಚಲಾವಾಲಾವೊನಾ ಕುಗಾಟನೆ ನಜಿಕನಾ ಗಾಮೊ ಕಾಪಸ. <verse eid="EZK 27:28" /><verse number="29" style="v" sid="EZK 27:29" />ಹುಟ್ಟ ಘಾಲಾಲಾ ಕ್ಹಾರಾ ಜ಼ನಾ ಅಂಬಿಗೊ ಸಮುಂದರನಾ ಕ್ಹಾರಾ ನಾವಿಕೊ ತ್ಯುನಾ ತ್ಯುನಾ ಹಡಗೊತಾ ಉತ್ರಿನ ಜಿಮಿನ ಪರ ಹುಬ್ರೈನ <verse eid="EZK 27:29" /><verse number="30" style="v" sid="EZK 27:30" />ತಾರಾಹುತಿ ಅವಾಜ಼ ಗೈನ ದುಕ್ಕಕ್ಹು ಅಡ್ಡಿನ ಮಾತಾಪರ ಧುಳನೆ ನಾಕಿನ ರಾಕ ಪರ ಪಡಿನ ಉಳ್ಯಾಡಿನ <verse eid="EZK 27:30" /><verse number="31" style="v" sid="EZK 27:31" />ತಾರಾಹುತಿ ಮಾತು ಭದ್ರ್ಯಲಿನ ಕೊತ್ಳೊ ಸುತ್ತಿಲಿನ ದುಕ್ಕಕ್ಹು ಗೊಳಾಡಿನ ತಾರಾಹುತಿ ಘನ್ನಾ ರವಸ. <verse eid="EZK 27:31" /><verse number="32" style="v" sid="EZK 27:32" />ತ್ಯುನೆ ರೊದನ ಕರ್ತಾ ತಾರಿ ವಿಷಯಮಾ ಶೊಕನು ಗಿದ್ದ ಕೈನ ಅಮ್ಮ ಕದ್ಯಾ, ಸಮುಂದರನಾ ವಚ್ಮಾ ಬಿಕೊ ಕವಾನಾ ತುರನೆ ಕಯು ಸಮಾನ ವ್ಹೈ? <verse eid="EZK 27:32" /><verse number="33" style="v" sid="EZK 27:33" />ತಾರಾ ಸಾಮನೊ ಸಮುಂದರೊನೆ ಹೈದಿನ ಫೈಲಿ ಗಯಾ. ತ್ಯುನಾಕ್ಹು ಘನ್ನಾ ಜನಾಂಗೊ ಭರ್xಯೊ; ತಾರಿ ಘನ್ನಿ ಆಸ್ತಿಕ್ಹು ವ್ಯಾಪಾರನಾ ಜಿನಿಸೊಕ್ಹು ಭುರಾಜೊ಼ನೆ ಬೆಳ್ಸಾಯೊ. <verse eid="EZK 27:33" /><verse number="34" style="v" sid="EZK 27:34" />ಹಮ್ನಾತುನಿ ತು ಸಮುಂದತೊ ಹಾಳ ಥಯೊ. ತಾರಾ ಸಾಮನೊ ತುಕನ ಮಳ್ಯಲ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಘನ್ನಾ ಪಾನಿಮಾ ಡುಬಿ ಗಯಾ. <verse eid="EZK 27:34" /><verse number="35" style="v" sid="EZK 27:35" />ಕರಾವಳಿನಾ ಕ್ಹಾರಾ ರ‍್ಹವಾಲಾ ತಾರಿ ಗತಿನೆ ಭುಚ್ಕಿ ಗಯಾಸ; ರಾಜಾ಼ ಚುಮ್ಮೈಗಯು ಘಾಬ್ರಾ ಥಯಾಸ. <verse eid="EZK 27:35" /><verse number="36" style="v" sid="EZK 27:36" />ಜನಾಂಗೊನಾ ಕಾಮವಾಲಾ ತುನೆ ದೆಕಿನ ಅಕ್ಹಸ; ತು ಘನ್ನು ನಾಶ ಥಯನ ವರಿ ಕೆಳಾನಾಜ ನೈ ರ‍್ಹಯಲವಾಲೊ ಥಾಶಿ.<verse eid="EZK 27:36" /></para>
  <chapter eid="EZK 27" />
  <chapter number="28" style="c" sid="EZK 28" />
  <para style="s">ತುರನಾ ರಾಜಾ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 28:1" />ಯಹೊವಾ ವರಿಯಕ್ಕ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ. <verse eid="EZK 28:1" /><verse number="2" style="v" sid="EZK 28:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ತುರನಾ ಪ್ರಭುನೆ ಅಮ್ಮ ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ, ತು ಪುಗ್ಯಲ ಮನಸ್ಸವಾಲೊ ಥಯಲ ಆಹಾ, ಮಿ ಕ್ಹುದಾ ವ್ಹೈ, ಸಮುಂದರನಾ ವಚ್ಮಾ ಕ್ಹುದಾನಿ ಸಿಂಹಾಸನನೆ ಚ಼ಡ್ಯೊಸ ತೆಕ್ಲುಜ಼ ಕೈಲಿದ್ಯೊ; ತು ತಾರಾ ಮನಸನೆ ಕ್ಹುದಾನಾ ಮನಸ ನಿಂಗತ ಹೆಚ್ಕಿ ಕರಿಲಿದಲ ಕಾ? ತು ಕೆಳಾಮಾಜ಼಼ ಕ್ಹುದಾ ನ್ಹವ್ಹೈ, ತು ನರಪ್ರಾಣಿಜ಼ ವ್ಹೈ. <verse eid="EZK 28:2" /><verse number="3" style="v" sid="EZK 28:3" />ದೆಕ, ತು ದಾನಿಯೆಲತೊ ಗ್ಯಾನಿ ವ್ಹೈ; ತುನೆ ಝಕಾಯಲ ಗುಟ್ಟ ಕಯುಜ಼ ನತ್ತಿ; <verse eid="EZK 28:3" /><verse number="4" style="v" sid="EZK 28:4" />ತುರು ಗ್ಯಾನ ವಿವೆಕಕ್ಹು ತು ಆಸ್ತಿ ಕರಿನ ತಾರಾ ಟಿಜೊ಼ರಿಯೊಮಾ ಕ್ಹೊನು ರುಪ್ಪ ಭರಿಲಿದ್ಯೊಸ; <verse eid="EZK 28:4" /><verse number="5" style="v" sid="EZK 28:5" />ತು ತಾರಿ ಘನ್ನಿ ಗ್ಯಾನಕ್ಹು ವ್ರಾಪಾರಕ್ಹು ಆಸ್ತಿ ಗಳಸಿಲಿದಲಕ್ಹು ತಾರು ಮನಸ ತಾರಿ ಆಸ್ತಿಕ್ಹು ಫುಗ್ಯುಸ; <verse eid="EZK 28:5" /><verse number="6" style="v" sid="EZK 28:6" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತು ತಾರಾ ಮನಸನೆ ಕ್ಹುದಾನಾ ಮನಸ ಅಕ್ಲು ಹೆಚ್ಕಿ ಕರಿಲಿದಲಕ್ಹು <verse eid="EZK 28:6" /><verse number="7" style="v" sid="EZK 28:7" />ಮಿ ತಾರಾ ಉಪ್ಪರ ಘನ್ನಾ ಕೆಟ್ಟ ಜನಾಂಗನಾ ಪಾಡಾಲಗಾಡುಸ; ತ್ಯುನೆ ತಾರಿ ಗ್ಯಾನನಾ ಉಪ್ಪರ ತಲ್ವಾರ ಫರೈನ ತಾರು ಉಜಾಲು ಹೊಲಸ ಕರಸ. <verse eid="EZK 28:7" /><verse number="8" style="v" sid="EZK 28:8" />ತುನೆ ಪಾತಾಳನೆ ಢಕ್ಲಿ ಪಡಸ; ಸಮುಂದರನಾ ವಚ್ಮಾ ತುನೆ ಮರಲವಾಲಾವೊನಿ ಗತಿ ಥಾವಸ. <verse eid="EZK 28:8" /><verse number="9" style="v" sid="EZK 28:9" />ತು ತುನೆ ಕ್ಹಾಲಾಸ ಕರಾಲಾವೊನಾ ಕ್ಹಾಮೊ ಮಿ ಕ್ಹುದಾ ವ್ಹೈ ಕೈನ ಕಶಿ ಸು? ಕ್ಹಲಾಸ ಥಾವಾಲಾನಾ ಹತ್ಮಾ ತು ಕೆಳಾಮಾಜ಼಼ ಕ್ಹುದಾ ನ್ಹವ್ಹೈ, ನರಪ್ರಾಣಿಜ಼ ವ್ಹೈ. <verse eid="EZK 28:9" /><verse number="10" style="v" sid="EZK 28:10" />ತು ಬಿಜಾ಼ವೊನಾ ಹತ್ಮಾತೊ ಮನೆ ನೈ ನಂಬಲವಾಲಾವೊನಾ ಮೌತನೆ ಗುರಿ ಥಾಶಿ; ಮಿಜ಼ ದೆಕ್ಯೊಸ, ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಿಚಾರ ವ್ಹೈ. <verse eid="EZK 28:10" /><verse number="11" style="v" sid="EZK 28:11" />ಯಹೊವಾ ವರಿಯಕ್ಕ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ.<verse eid="EZK 28:11" /></para>
  <para style="s">ತುರ ರಾಜೊ಼ ಪಡಾನು</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 28:12" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ತುರನಾ ರಾಜಾ಼ನಾ ವಿಷಯಮಾ ಶೊಕನು ಗಿದ್ದ ಕೈನ, ತಿನೆ ಅಮ್ಮ ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತು ಸರ್ವಸುಲಕ್ಷಣ ಶಿರೊಮಣಿ, ಪುರಾ ಗ್ಯಾನಿ, ಪುರಾ ಕ್ಹುಬಸುರತ ವ್ಹೈ. <verse eid="EZK 28:12" /><verse number="13" style="v" sid="EZK 28:13" />ಕ್ಹುದಾನೊ ಮಳೊ ಥಯಲ ಎದೆನಮಾ ತು ವ್ಹತ್ತೊ; ಮಾಣಿಕ್ಯ, ಪುಷ್ಯರಾಗ, ಪಚ್ಚೆ, ಪಿತರತ್ನ, ಬೆರುಲ್ಲ, ವೈಡುರ್ಯ, ನಿಲಕೆಂಪರಲು, ಸ್ಫಟಿಕ, ಎ ನವರತ್ನಕ್ಹು, ಭುಶಿತ ಥಯೊಸ; ತಾರಾಮಾನಾ (ಎ ರತ್ನನಾ) ಗುಡೊ ಘರೊ ಸುವರ್ಣಕ್ಹು ತಯ್ಯಾರ ಥಯಾತಾ; ತಾರಿ ಸೃಷ್ಟಿನಾ ದಿನ್ನಮಾ ತಯ್ಯಾರ ಥಯಾ. <verse eid="EZK 28:13" /><verse number="14" style="v" sid="EZK 28:14" />ತು ರೆಕ್ಯಾ ಕಾಡಿನ ಛೊಲಿ ದಿವಾನಿ ಕೆರುಬಿ ಥಯೊತೊ; ಮಿ ತುನೆ ಕ್ಹುದಾನಾ ಪರಿಶುದ್ದ ಡೊಂಗರಪರ ಹುಬ್ರಾಡ್ಯೊ; ತು ಕೆಂಡಾನಾ ಪಾನಿಮಾ ಅಂಗ ಧೊಲ್ಲೆತೊ ವ್ಹತ್ತೊ. <verse eid="EZK 28:14" /><verse number="15" style="v" sid="EZK 28:15" />ತಾರಿ ಸೃಷ್ಟನಾ ದಿನ್ನತೊ ತಾರಾಮಾ ಅಪರಾದ ಮಳೆಲಕ್ಕಾ ತಾರಿ ನಡತೆ ನಿರ್ದೊಷ ಥೈನ ದಿಕ್ಹಾಡುತು. <verse eid="EZK 28:15" /><verse number="16" style="v" sid="EZK 28:16" />ತಾರಿ ಮಿತಿ ನೈ ರ‍್ಹಯಲ ವ್ಯಾಪಾರಕ್ಹು ತಾರಾಮಾ ಬಲಾತ್ಕಾರ ಭರಿನ ತು ಪಾಪಿ ಥಯೊ. ತಿನಾಹುತಿ ಮಿ ತುನೆ ಕ್ಹುದಾನಾ ಡೊಂಗರೊ ಹೊಲಸ ಕರಿನ ಢಕ್ಲಿ ಪಡ್ಯೊ; ಹೊ. ಛೌಲಿ ದಿವಾನು ಕೆರುಬಿ, ಕೆಂಡನಾ ಪಾನಿನಾ ವಚ್ಮಾನು ತಾರಿ ಜ಼ಗಾತು ಮಿ ತುನೆ ಕಿತ್ತಿ ನಾಶ ಕರ‍್ಯೊ. <verse eid="EZK 28:16" /><verse number="17" style="v" sid="EZK 28:17" />ತು ತಾರಾ ಸೊಬಗನಾ ಹುತಿ ಫುಗ್ಯಲ ಮನಸವಾಲೊ ಥಯನ ತಾರು ಉರ್ದಾನು ತಾರಿ ಗ್ಯಾನನೆ ಹಾಳ ಕರಿಲಿದ್ಯೊಸ; ಇನಾಕ್ಹು ಮಿ ತುನೆ ಜಿಮಿನಪರ ಢಕ್ಲಿನ ತು ರಾಜಾ಼ವೊನೆ ಸಬಕ ಥಯೆ ಲಿಂಗೆ ತಯುನಾ ಡೊಳಾ ಕ್ಹಾಮೊ ಘಾಲ್ಯೊ. <verse eid="EZK 28:17" /><verse number="18" style="v" sid="EZK 28:18" />ತಾರಾ ಘನ್ನಾ ಅಪರಾದೊಕ್ಹು ಅನ್ಯಾಯನಾ ವ್ಯಾಪಾರಕ್ಹು ತಾರಾಮಾನಾ ಪವಿತ್ರಾಲಯೊನೆ ಹೊಲಸ ಕರ‍್ಯೊಸ; ತಿನಾಹುತಿ ಮಿ ತಾರಾಮಾತೊ ಆಗನೆ ಆವಾ ಲಗಾಡ್ಯೊ, ತೆ ತುನೆ ಗಳ್ಯು, ದೆಕಾಲಾ ಕ್ಹಾರಾವೊನಾ ಡೊಳಾ ಕ್ಹಾಮು ತುನೆ ರಾಕ ಕರಿಪಡ್ಯೊ; <verse eid="EZK 28:18" /><verse number="19" style="v" sid="EZK 28:19" />ಜನಾಂಗೊಮಾ ತುನೆ ಗ್ವತ್ತ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ತಾರಿ ಗತಿನೆ ಭುಚ್ಕಿನ ಘಾಬ್ರಾ ಥಾವಸ; ತು ಘನ್ನೊ ನಾಶ ಥೈನ ಕೆಳಾಮಾಜ಼಼ ನೈಸೊವಾಲೊ ಥಯೊ.<verse eid="EZK 28:19" /></para>
  <para style="s">ಸಿದೊನನಾ ವಿಷಯಮಾ ಪ್ರವಾದನ</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 28:20" />ಯಹೊವಾ ಎ ವಾಕ್ಯ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 28:20" /><verse number="21" style="v" sid="EZK 28:21" />ಮನಕ್ಹದಿಕ್ರಾ, ತು ಸಿದೊನನೆ ಅಭಿಮುಖ ಥಯನ ತಿನಾ ವಿಷಯಲಮಾ ಅಮ್ಮ ಕೆ, <verse eid="EZK 28:21" /><verse number="22" style="v" sid="EZK 28:22" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಆಹಾ, ಚಿದೊನ, ಮಿ ತುನೆ ವಿರುದ್ದ ಥಯನ ತಾರಾ ವಚ್ಮಾ ಮಶುರ ಥೌಸ; ಮಿ ಎ ಗಾಮನೆ ಶಿಕ್ಷಾ ದಿನ ಮಾರಿ ಮರ್ಯಾದಿ ವಚಾ಼ಡಿಲಿದಲ ಪರ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ಕ್ಹಾರಾವೊನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 28:22" /><verse number="23" style="v" sid="EZK 28:23" />ಮಿ ತಿಮಾ ರೊಗೊ ತಿನಾ ಒಣಿಯೊಮಾ ನಾಶನ ಉಂಟ ಕರುಸ; ತಲ್ವಾರ ಸುತ್ತ ಮುತ್ತ ತಿನಾ ಉಪ್ಪರ ಫರಾವಾಕ್ಹು ಮನಕ್ಹೊ ತಿನಾ ವಚ್ಮಾ ಕ್ಹಲಾಸ ಥೈನ ಪಡಸ; ತೆಳಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 28:23" /><verse number="24" style="v" sid="EZK 28:24" />ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾವೊನೆ ಚೊ಼ಟಾವಾನೊ ಕಾಟೊ ಹಬ್ದಾ ನೈ ರ‍್ಹತೊ; ಕದ್ರಾವಾನಾ ಆಜು಼ ಬಾಜು಼ನಾ ತ್ರಾಸವೊನು ತ್ರಾಸ ಹಬ್ದಾ ನೈ ಥಾತು; ಮಿಜ಼ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ದಿಕ್ಹಸ.<verse eid="EZK 28:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 28:25" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ, ಜನಾಂಗೊಮಾ ಚದರಿ ಗಯಲ ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾವೊನೆ ಮಿ ಮಳೈನ ಕ್ಹಾರಾ ಜನಾಂಗನಾ ಡೊಳಾ ಕ್ಹಾಮೊ ಮಾರಿ ಮರ್ಯಾದಿ ವಚಾ಼ಡಿ ಲಿದಲಪರ ತೆ ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾ ಮಾರೊ ಸೆವಕ ಥಯಲ ಯಾಕೊಬನೆ ಮಿ ದಿದಲ ತ್ಯುನಾ ಸ್ವಂತ ದೆಶಮಾ ರ‍್ಹವಸ. <verse eid="EZK 28:25" /><verse number="26" style="v" sid="EZK 28:26" />ತ್ಯಾ ಭೆಂವಾಚಿ ರ‍್ಹವಸ, ಘರೊ ಭಾಂದಿಲಿನ ಕ್ಹೆತರೊ ಕರಿಲಿನ ಸುಕಾಕ್ಹು ರ‍್ಹವಸ; ತ್ಯುನೊನೆ ಕದ್ರಾವಾಲಾ ಆಜು಼ ಬಾಜು಼ವಾಲಾವೊನೆ ಮಿ ಶಿಕ್ಷಾ ದಿದಲಪರ ಮಿಜ಼ ತ್ಯುನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ಗ್ವತ್ತ ಥಾವಸ.<verse eid="EZK 28:26" /></para>
  <chapter eid="EZK 28" />
  <chapter number="29" style="c" sid="EZK 29" />
  <para style="s">ಐಗುಪ್ತನಾ ವಿಷಯಮಾ ಪ್ರವಾದನೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 29:1" />ಯೆಹೊಯಾಕಿನ ಸೆರೆಯಾದ ದಕ್ಹವಾ ವರಕ್ಹನಾ ದಕ್ಹವಾ ಮ್ಹೈನಾನಾ ಬಾರಾವಾ ದಿನ್ನಮಾ ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ, <verse eid="EZK 29:1" /><verse number="2" style="v" sid="EZK 29:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ , ತು ಐಗುಪ್ತನೊ ರಾಜಾ಼ನಾ ವಿರುದ್ದ ಮ್ಹೊಡು ಕರಿನ ತಿನಾ ವಿಷಯಮಾಬಿ ಐಗುಪ್ತನಾ ಕ್ಹಾರಾವೊನಾ ವಿಷಯಮಾ ಅಮ್ಮ ಕೆ <verse eid="EZK 29:2" /><verse number="3" style="v" sid="EZK 29:3" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ, ಐಗುಪ್ತನೊ ರಾಜೊ಼ ಥಯಲ ಫರೊಹನ, ತಾರಾ ನದಿಯೊನಾ ವಚ್ಮಾ ದಡಿಲಿನ ಎ ನದಿ ಮಾರಿಜ಼ ವ್ಹೈ, ಮಾರಾಹುತಿಜ಼ ಕರಿಲಿದಲ ವ್ಹೈ ಕೈನ ಕೈಲಿವಾನಿ ಮ್ಹೊಟೊ ಕ್ಹಾಪ ದೆಕ, ಮಿ ತುನೆ ವಿರುದ್ದ ಥಯೊಸ. <verse eid="EZK 29:3" /><verse number="4" style="v" sid="EZK 29:4" />ಮಿ ತಾರಾ ದಾತೊನೆ ಬಲಿ ಘಾಲಿನ ತಾರಿ ನೈಲ ನದಿನಾ ಮಚ್ಲಿಯೊ ತಾರಾ ಪಿಟ್ಟನಾ ಚಿಪ್ಪೊನೆ ಚಿಟ್ಕಾಯೆ ನಿಂಗತ ಕರಿನ ಚಿಟ್ಕಾಯಲ ತೆ ಮಚ್ಲಿಯೊನಾ ಕ್ಹಾತೆ ತುನೆ ತಾರಿ ನೈಲ ನದಿನಾ ವಚ್ಮಾತೊ ಭಾರೊ ಜಗ್ಗಿನ, <verse eid="EZK 29:4" /><verse number="5" style="v" sid="EZK 29:5" />ತುನೆ ತಾರಾ ನದಿನಾ ಕ್ಹಾರಾ ಮಚ್ಲಿಯೊನೆ ರಾನನಾ ಪಾಲೆ ಕರುಸ; ತು ಭಾರು ಪಡ್ಯಲ ರ‍್ಹಶಿ; ತುನೆ ಕುನ್ನಜ಼ ಉಚಾತು ನೈ, ಬುರತಾ ನೈ; ಮಿ ತುನೆ ಬುಜಂತೊನೆ ಹಬಾಳನಾ ಪಕ್ಷಿಯೊನೆ ಆಹಾರ ಕರ‍್ಯೊಸ. <verse eid="EZK 29:5" /><verse number="6" style="v" sid="EZK 29:6" />ತೆಳಾಮಾ ಐಗುಪ್ತನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾವೊನೆ ತ್ಯುನೆ ಕ್ಹಾಲಿ ದಂಡಿನಾ ಉರುಲಗೊಲ ಥಯಾ ಕೈನ ಸರ್ಮೈನ ಮಿಜ಼ ಯಹೊವಾ ಕವಾನು ತಿಲ್ದಿಲಿವಸ. <verse eid="EZK 29:6" /><verse number="7" style="v" sid="EZK 29:7" />ಐಗುಪ್ತ, ಇಸ್ರಾಯೆಲವಾಲಾ ತಾರಾ ಉಪ್ಪರ ಹತ್ತ ಮ್ಹೆಲ್ತಾಮಾ ತು ತುಟಿನ ತ್ಯುನಾ ಕ್ಹಾರಾವೊನಾ ಕ್ಹಾಂದಾವೊನೆ ಚೊ಼ಟಿ; ಉರಿಕೊಳ್ಳಾನೆ ತು ಫುಟಿನ ತ್ಯುನಾ ವಚ್ಮಾ ಭೆಂ ಉಂಟ ಕರಿ. <verse eid="EZK 29:7" /><verse number="8" style="v" sid="EZK 29:8" />ಇಮ್ಮ ರ‍್ಹತಾಕ್ಹು ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಆಹಾ, ಮಿ ತಾರಾ ಉಪ್ಪರ ತಲ್ವಾರ ಆವಾಲಗಾಡಿನ ಮನಕ್ಹೊನೆ ಜಾನವರೊನೆ ತುಕಂತೊ ನಾಶ ಕರುಸ. <verse eid="EZK 29:8" /><verse number="9" style="v" sid="EZK 29:9" />ಫರೊಹನ ಎ ನದಿ ಮಾರಿಜ಼ ವ್ಹೈ, ಮಿಜ಼ ಕರಿಲಿದಲ ವ್ಹೈ ಕೈಲಿದಲಕ್ಹು ಐಗುಪ್ತ ದೆಶ ಹಾಳ ಥಾವಸ; ತೆಳಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 29:9" /><verse number="10" style="v" sid="EZK 29:10" />ದೆಕ, ಮಿ ತುನೆಬಿ ತಾರಿ ನದಿನೆಬಿ ವಿರುದ್ದ ಥೈನ ಐಗುಪ್ತ ದೆಶನೆ ಮಿಗ್ದೊಲತೊ ಸೆವೆನೆಯ ಲಕ್ಕಾ, ಹೊ ಕುಷಿನ ಲಕ್ಕಾ ಘನ್ನು ಹಾಳ ಕರುಸ. <verse eid="EZK 29:10" /><verse number="11" style="v" sid="EZK 29:11" />ಕಯೊಜ಼ ಮನಕ್ಹ ತ್ಯಾ ಪಗ್ಗ ಮ್ಹೆಲಿನ ದಾಟಿನ ಜಾ಼ತೊ ನೈ; ಕಯುಜ಼ ಜಾನವರ ಕ್ಹುಂದಿನ ದಾಟಿನ ಜಾ಼ತು ನೈ; ಚಾಳಕ್ಹ ವರಕ್ಹ ಮನಕ್ಹೊ ನೈಸೊ ಥಾವಸ. <verse eid="EZK 29:11" /><verse number="12" style="v" sid="EZK 29:12" />ಹಾಳ ಪಡ್ಯಲ ದೆಶೊಮಾ ಐಗುಪ್ತ ದೆಶನೆ ಹಾಳ ಕರುಸ; ಹಾಳ ಥಯಲ ಗಾಮೊಮಾ ತಿನಾ ಗಾಮೊನೆ ಹಾಳ ಕರುಸ; ಚಾ಼ಳಕ್ಹ ವರಕ್ಹ ತಿಮ್ಮ ರ‍್ಹವಸ; ಮಿ ಐಗುಪ್ತವಾಲಾವೊನೆ ಜನಾಂಗೊಮಾ ಚದರಿನ ದೆಶದೆಶೊನೆ ತುರಿ ಪಡುಸ. <verse eid="EZK 29:12" /><verse number="13" style="v" sid="EZK 29:13" />ಚಾ಼ಳಕ್ಹ ವರಕ್ಹನಾ ಉಪ್ಪರ ಮಿ ಐಗುಪ್ತವಾಲಾವೊನೆ ತ್ಯುನೆ ಚದರಿ ಗಯಲ ಜನಾಂಗೊಮಾತೊ ತ್ಯುನೊನೆ ಮಳೈನ ಐಗುಪ್ತನಿ ಕೆಟ್ಟ ಸ್ಥಿತಿ ತಪ್ಸಿನ, <verse eid="EZK 29:13" /><verse number="14" style="v" sid="EZK 29:14" />ತ್ಯುನಿ ಜನ್ಮ ಭುಮಿ ಥಯಲ ಪತ್ರೊಸ ದೆಶನೆ ಫರಿನ ಆವಾ ಲಗಾಡುಸ; ತ್ಯಾಜ಼ ತ್ಯುನೆ ಕಿಳ ಮಟ್ಟ ರ‍್ಹಯಲ ರಾಜ್ಯವಾಲಾ ಥಾವಸ. <verse eid="EZK 29:14" /><verse number="15" style="v" sid="EZK 29:15" />ತೆ ರಾಜ್ಯ ಕ್ಹಾರಾ ರಾಜ್ಯವೊಮಾ ಕಮ್ಮ ಕವೈ ಲಿವಸ; ಬಿಜಾ಼ ಜನಾಂಗೊತಿ ತೆ ಮ್ಹೊಟು ವ್ಹೈ ಕೈನ ತೆ ವರಿ ಮಾತು ನೈ ಉಚಾ಼ತು; ತೆ ಜನಾಂಗೊನಾ ಉಪ್ಪರ ಫರಿನ ಅದಿಕಾರ ಕರ‍್ಯಾವಾಚಿ ಮಿ ತಿನೆ ಕೆಟ್ಟ ಗತಿನೆ ಲೌಸ. <verse eid="EZK 29:15" /><verse number="16" style="v" sid="EZK 29:16" />ಐಗುಪ್ತ ಫರಿನ ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾವೊನು ಭರೊಕ್ಹೊ ಥಾತು ನೈ; ವರಿ ತಿಕನ ಡೊಳಾ ಉಚಾವಾನಾ ಕ್ಹುದಾನಾ ದ್ರೊಹನೆ ಶೆಂ ಇಸ್ರಾಯೆಲವಾಲಾವೊಮಾ ಐಗುಪ್ತತು ಹಬ್ದಾ ಹುಟ್ತು ನೈ. ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಥವಸ.<verse eid="EZK 29:16" /></para>
  <para style="s">ನೆಬುಕದ್ನೆಚ್ಚರ ಐಗುಪ್ತನೆ ವಶ ಕರಿಲಿದಲ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 29:17" />ಯೆಹೊಯಾಕಿನ ಸೆರೆ ಥಯಲ ಇಕ್ಹಪರ ಕ್ಹಾತವಾ ವರಕ್ಹನಾ ಯಕ್ಕವಾ ಮ್ಹೈನಾನಾ ಯಕ್ಕವಾ ದಿನ್ನಮಾ ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ. <verse eid="EZK 29:17" /><verse number="18" style="v" sid="EZK 29:18" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಬಾಬೆಲನೊ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರ ತುರನೆ ದಾಳಿ ಕರಿನ ತಿನಾ ಸೈನಿಕೊಕ್ಹು ಘನ್ನಾ ಪ್ರಯಾಸನಾ ಸೆವಾ ಕರಾಯೊಸ; ಹರಯಕ್ಲಾನು ಮಾತು ಟಕ್ಳು ಛೆ, ಹರಯಕ್ಲಾನೊ ಕ್ಹಾಂದೊ ಕಾಯಿ ಭಾಂದಲ ಛೆ; ತೆನೈಸೊ ತೆ ದಾಳಿಮಾ ತೆ ಕರಲ ಮ್ಹೈನತನೆ ತಿನೆ ರ‍್ಹವಾದೆ ತಿನಾ ಸೈನಿಕೊನೆ ರ‍್ಹವಾದೆ ತುರತು ಸುಜ಼಼ ಪೈದೊ ಮಳ್ಯು ನೈ. <verse eid="EZK 29:18" /><verse number="19" style="v" sid="EZK 29:19" />ಇಮ್ಮ ರ‍್ಹಯಲಕ್ಹು ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ದೆಕ, ಮಿ ಬಾಬೆಲನೊ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರನೆ ಐಗುಪ್ತ ದೆಶ ದ್ಯುಸ; ತೆ ತಿನಾ ಮನಕ್ಹೊ ಯಾವತ್ತನೆ ಲಿನ ತೆ ದೆಶನೆ ಬಂದಿ ಕರಿನ ಲುಟಿ ಕರಸ ತೆಜ಼ ತಿನಾ ಸೈನ್ಯನೆ ಪಗಾರ ವ್ಹೈ. <verse eid="EZK 29:19" /><verse number="20" style="v" sid="EZK 29:20" />ತೆ ಸೈನ್ಯನಾ ಕ್ಹಾತೆ ಮಾರಾಹುತಿ ಸೆವೆ ಕರಕ್ಹು ತೆ ಕರಲ ಮ್ಹೈನತನೆ ಪ್ರತಿಫಲ ಥೈನ ಮಿ ಐಗುಪ್ತ ದೆಶ ತಿನೆ ದಿದ್ಯೊಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 29:20" /><verse number="21" style="v" sid="EZK 29:21" />ತೆ ದಿನ್ನಮಾ ಮಿ ಇಸ್ರಾಯೆಲ ವಂಶನೆ ಶಿಂಗ್ಡೊ ಉಟಾಡಿನ ತೆ ವಂಶವಾಲಾವೊನಾ ವಚ್ಮಾ ತಾರು ಮ್ಹೊಡು ಕ್ಹೊಲುಸ; ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಥಾವಸ.<verse eid="EZK 29:21" /></para>
  <chapter eid="EZK 29" />
  <chapter number="30" style="c" sid="EZK 30" />
  <para style="s">ಐಗುಪ್ತ ನೆಬುಕದ್ನೆಚ್ಚರಕ್ಹು ಹಾಳ ಥಾವಸ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 30:1" />ಯಹೊವಾ ವರಿಯಕ್ಕ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ. <verse eid="EZK 30:1" /><verse number="2" style="v" sid="EZK 30:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಆಂ ಕ್ಹುದಾನಿ ವಾತನೆ ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಅಡ್ಡೊ! ಅಯ್ಯೊ ದಿನ್ನ! <verse eid="EZK 30:2" /><verse number="3" style="v" sid="EZK 30:3" />ದಿನ್ನ ನಜಿಕ ಛೆ; ಹೊ, ಯಹೊವಾನು ದಿನ್ನ, ಕಾರ್ಮುಗಿಲನು ದಿನ್ನ ನಜಿಕ ಅಯ್ಯು; ತೆ ಜನಾಂಗೊನೆ ನ್ಯಾಯ ತಿರ್ಸಾನು ಕಾಲ ವ್ಹೈ. <verse eid="EZK 30:3" /><verse number="4" style="v" sid="EZK 30:4" />ತಲ್ವಾರ ಐಗುಪ್ತನಾ ಉಪ್ಪರ ಪಡಸ; ತ್ಯಾನಾ ಮನಕ್ಹೊ ಕ್ಹಲಾಸ ಥಾವಾನೆ ಕುಷಿನಮಾ ತ್ರಾಸ ಥಾವಸ; ಐಗುಪ್ತನಾ ಕೆಕ್ಲಾಕಿ ಮನಕ್ಹೊನೆ ಲಿಂಜಾ಼ವಸ; ತಿನು ಅಸ್ತಿವಾರ ಹಾಳ ಥಾವಸ; <verse eid="EZK 30:4" /><verse number="5" style="v" sid="EZK 30:5" />ಕುಷವಾಲಾ, ಪುಟ್ಯವಾಲಾ, ಲುದ್ಯವಾಲಾ, ಬಿಜಾ಼ ಬಿಜಾ಼ ಕ್ಹಾರಾ ವಿದೆಶವಾಲಾ, ಕುಬ್ಯವಾಲಾ, ಅರೆಬಿಯೊ, ಸ್ವಂತ ಮನಕ್ಹೊ, ಇವ್ನೆ ಕ್ಹಾರಾ ಐಗುಪ್ತವಾಲಾವೊನಾ ಕ್ಹಾತೆ ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಥಾವಸ. <verse eid="EZK 30:5" /><verse number="6" style="v" sid="EZK 30:6" />ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಐಗುಪ್ತನೆ ಆಧಾರ ಥಯಲವಾಲಾ ಪಡಸ, ತಿನಿ ತಾಕತನಿ ಉತ್ರಿ ಜಾ಼ವಸ; ತ್ಯಾನಾ ಮನಕ್ಹೊ ಮಿಗ್ದೊಲತಾ ಸೆವೆನೆಯ ಲಕ್ಕಾ ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಥಾವಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 30:6" /><verse number="7" style="v" sid="EZK 30:7" />ಹಾಳಥಯಲ ದೆಶಮಾ ತೆ ದೆಶ ಹಾಳ ಥಯಲ ರ‍್ಹವಸ, ಹಾಳ ಥಯಲ ಗಾಮೊಮಾ ತಿನಾ ಗಾಮೊ ಹಾಳ ಪಡಲ ರ‍್ಹವಸ. <verse eid="EZK 30:7" /><verse number="8" style="v" sid="EZK 30:8" />ಮಿ ಐಗುಪ್ತನೆ ಆಗ ಲಗಾಡಿನ ತಿನಾ ಕ್ಹಾರಾ ಸಹಾಯಕೊನೆ ನಾಶ ಕರಲ್ಪರ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 30:8" /><verse number="9" style="v" sid="EZK 30:9" />ತೆ ದಿನ್ನೊಮಾ ಸುದ್ದಿ ಕವಾಲಾ ಮಾರಿ ಸನಿದಾನತಾ ಗೈನ ಹಡಗಾವೊಮಾ ಗೈನ ಅರಾಮ ರ‍್ಹಯಲ ಕುಷ್ಯವಾಲಾವೊನೆ ಭುಚ್ಕಾಡಸ; ಐಗುಪ್ತನಾ ನಾಶನನಾ ದಿನ್ನಮಾ ಕುಷ್ಯವಾಲಾವೊನೆ ತ್ರಾಸ ಥಾವಸ; ತೆ ದಿನೊ ದೆಕೊ ಐಯುಸ. <verse eid="EZK 30:9" /><verse number="10" style="v" sid="EZK 30:10" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಿ ಬಾಬೆಲನೊ ರಾಜೊ಼ ಥಯಲ ನೆಬುಕದ್ನೆಚ್ಚರನಾ ಹತ್ಮಾತೊ ಐಗುಪ್ತನಾ ನೈ ಮೊಜಾ಼ನೆ ಥಾವಾನಾ ಮನಕ್ಹೊನೆ ನಾಶ ಕರುಸ. <verse eid="EZK 30:10" /><verse number="11" style="v" sid="EZK 30:11" />ತೆ ದೆಶನೆ ನಾಶ ಕರಾನೆ ತಿನೆ ಘನ್ನಾ ಖತರನಾಕ ಜನಾಂಗವಾಲಾ ಥಯಲ ತಿನಾ ಸೈನಿಕೊನಾ ಕ್ಹಾತೆ ಆವಾ ಲಗಾಡುಸ; ತ್ಯುನೆ ಐಗುಪ್ತನಾ ಉಪ್ಪರ ತಲ್ವಾರ ಕಾಡಿನ ದೆಶನೆ ಕ್ಹಲಾಸ ಥಯಲವಾಲಾವೊಕ್ಹು ಭರಸ. <verse eid="EZK 30:11" /><verse number="12" style="v" sid="EZK 30:12" />ಮಿ ನೈಲ ನದಿನೆ ಕ್ಹುಕ್ಹೈನ ದೆಶನೆ ಕೆಟ್ಟ ಮನಕ್ಹೊನೆ ಇಕ್ಕ ಪಡುಸ; ಹೊ, ದೆಶನೆ ತಿಮಾ ರ‍್ಹಯಲ ಹರಯಕ್ಕಬಿ ಬಿಜಾ಼ವೊಕ್ಹು ಹಾಳ ಕರಾಲಗಾಡುಸ; ಯಹೊವಾ ಥಯಲ ಮಿಜ಼ ಕದ್ಯೊಸ.<verse eid="EZK 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 30:13" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ. ಮಿ ನೊಫಿನ ಗಾಮಾನಿಯೊ ಮೊರ್ತಿಯೊನೆ ಫೊಡಿನ ತ್ಯುನೊನೆ ನಾಶ ಕರುಸ; ಐಗುಪ್ತದೆಶಮಾ ಹಬ್ದಾ ಕಯೊ ಪ್ರಭುಜ಼ ನೈ ರ‍್ಹತೊ; ಮಿ ತೆ ದೆಶನೆ ಭೆಂ ಘಾಲುಸ. <verse eid="EZK 30:13" /><verse number="14" style="v" sid="EZK 30:14" />ಮಿ ಪತ್ರೊಸನೆ ಹಾಳ ಕರಿನ ಚೊವನೆ ಆಗ ಲಗಾಡಿನ ನೊಪುರನೆ ಶಿಕ್ಷಾದಿನ. <verse eid="EZK 30:14" /><verse number="15" style="v" sid="EZK 30:15" />ಐಗುಪ್ತನೆ ರಕ್ಷಣಾ ಕೊಟೆ ಥಯಲ ಸಿನನಾ ಉಪ್ಪರ ಮಾರಿ ಶಿಟ್ಟಕ್ಹು ನೊಪುರಮಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಕತ್ರಿ ಪಡುಸ. <verse eid="EZK 30:15" /><verse number="16" style="v" sid="EZK 30:16" />ಮಿ ಐಗುಪ್ತನೆ ಕಿಚ್ಚ ಲಗಾಡಾಕ್ಹು ಸಿನ ಜ಼ಲಮನು ತ್ರಾಸ ಕ್ಹಾವಸ; ನೊಪುರ ಭಂಗನೆ ಗುರಿ ಥಾವಸ; ನೊಫನಾ ಉಪ್ಪರ ದುಶ್ಮನೊ ದುಪ್ಪಾರೆಜ಼ ಪಡಸ. <verse eid="EZK 30:16" /><verse number="17" style="v" sid="EZK 30:17" />ಒನನಾ ಗಾಮನಾ ವರಿ ಪಿಬೆಸೆತನಾ ಗಾಮನಾ ಯುವಕೊ ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾ ಥಾವಸ; ತ್ಯಾ ರ‍್ಹವಾಲಾ ಸೆರೆ ಥೈನ ಜಾ಼ವಸ. <verse eid="EZK 30:17" /><verse number="18" style="v" sid="EZK 30:18" />ಐಗುಪ್ತ ಉಚಾವಾಲಗಾಡಲ ನೊಗ ಮಿ ತಹಪನೆಸಮಾ ತುಟತಾಮಾ ತ್ಯಾ ದಿನ್ನ ನಿಕ್ಹಳತೊ ನೈ, ತಿನಿ ತಾಕತನಿ ನಶಾ ಝಕೈ ಜಾ಼ವಸ, ಕಾರ್ಮುಗಿಲ ತಿನೆ ಸುತ್ತಿ ಲಿವಸ, ತಿನಿಯೊ ಬಾಕ್ಡಿಯೊ ಸೆರೆನೆ ಲಿಂಜಾ಼ವಸ. <verse eid="EZK 30:18" /><verse number="19" style="v" sid="EZK 30:19" />ಇಮ್ಮ ಮಿ ಐಗುಪ್ತವಾಲಾವೊನೆ ಶಿಕ್ಷಾ ದಿನ ತಿರಿಸತಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಥಾವಸ.<verse eid="EZK 30:19" /></para>
  <para style="s">ಫರೊಹನನಾ ಹತೊ ಬಾಗಾನು</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 30:20" />ಯೆಹೊಯಾಕಿನ ಸೆ ಥಯಲ ಗ್ಯಾರವಾ ವರಕ್ಹನಾ ಯಕ್ವಾ ಮ್ಹೈನಾನಾ ಕ್ಹಾತವಾ ದಿನ್ನಮಾ ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ. <verse eid="EZK 30:20" /><verse number="21" style="v" sid="EZK 30:21" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಮಿ ಐಗುಪ್ತನೊ ರಾಜೊ಼ ಥಯಲ ಫರೊಹನಾ ಹತ್ತನೆ ತೊಡಿ ಪಡ್ಯೊಸ; ದೆಕ, ತಿನೆ ಕುನ್ನಜ಼ ಭಾಂದ್ಯು ನೈ, ವಕ್ಹಡ ಲಗಾಡ್ಯಾ ನೈ, ತೆ ತಲ್ವಾರ ಧರೆ ನಿಂಗತ ತಾಕತವರ ಥಯೆ ನಿಂಗತ ಕುನ್ನಜ಼ ಫಡ್ಕು ಭಾಂದಿನ ತಿನೆ ಬಿಗದ್ಯಾ ನೈ. <verse eid="EZK 30:21" /><verse number="22" style="v" sid="EZK 30:22" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ, ಮಿ ಐಗುಪ್ತನೊ ರಾಜೊ಼ ಥಯಲ ಫರೊಹನನೆ ವಿರುದ್ದ ಥೈನ ತಿನಾ ಹತೊನೆ, ಕದ್ಯಾಮ ಕರೆಟ್ಟ ರ‍್ಹಯಲನೆ, ತೊಡಲನೆ ಘನ್ನೊ ತೊಡಿನ ತಲ್ವಾರ ತಿನಾ ಹತ್ತಮಾತು ಪಡೆನಿಂಗತ ಕರುಸ. <verse eid="EZK 30:22" /><verse number="23" style="v" sid="EZK 30:23" />ಐಗುಪ್ತವಾಲಾವೊನೆ ಜನಾಂಗೊಮಾ ಚದರಿನ ದೆಶ ದೆಶನೆ ತುರಿ ಪಡುಸ. <verse eid="EZK 30:23" /><verse number="24" style="v" sid="EZK 30:24" />ಮಿ ಬಾಬೆಲನಾ ರಾಜಾ಼ನಾ ಹತೊನೆ ತಾಕತ ದಿನ ಮಾರಿ ತಲ್ವಾರನೆ ತಿನಾ ಹತ್ಮಾ ದಿನ ಫರೊಹನನಾ ಹತೊ ತೊಡಾನೆ ದುಕ್ಕಕ್ಹು ಜ಼ಲಮನು ತ್ರಾಸ ಕ್ಹಾಯೆ ನಿಂಗತ ಫರೊಹನ ತೆ ರಾಜಾ಼ನಾ ಕ್ಹಾಮೊ ನೆಳ್ಳಸ. <verse eid="EZK 30:24" /><verse number="25" style="v" sid="EZK 30:25" />ಮಿ ಬಾಬೆಲನಾ ರಾಜಾ಼ನಾ ಹತೊ ತಾಕತಕ್ಹು ಭರುಸ; ಫರೊಹನನಾ ಹತೊ ಜೊ಼ತ ಪಡಸ; ಮಿ ಮಾರಿ ತಲ್ವಾರ ಬಾಬೆಲನಾ ರಾಜಾ಼ನೆ ದೆತಾಕ್ಹು ತೆ ತಿನೆ ಐಗುಪ್ತ ದೆಶನಾ ಉಪ್ಪರ ಉಚಾವಸ.ತೆಳಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ಕ್ಹಾರಾವೊನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 30:25" /><verse number="26" style="v" sid="EZK 30:26" />ಮಿ ಐಗುಪ್ತವಾಲಾವೊನೆ ಜನಾಂಗೊಮಾ ಚದರಿನ ದೆಶ ದೆಶನೆ ತುರತಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಥಾವಸ.<verse eid="EZK 30:26" /></para>
  <chapter eid="EZK 30" />
  <chapter number="31" style="c" sid="EZK 31" />
  <para style="s">ಐಗುಪ್ತನೆ ದೆವದಾರು ಝಾಡನು ಹೊಲಸಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 31:1" />ಯೆಹೊಯಾಕಿನ ಸೆರೆ ಥಯಲ ಗ್ಯಾರವಾ ವರಕ್ಹನಾ ತನ್ವಾ ಮ್ಹೈನಾನಾ ಯಕ್ವಾ ದಿನ್ನಮಾ ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ. <verse eid="EZK 31:1" /><verse number="2" style="v" sid="EZK 31:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಐಗುಪ್ತನೊ ರಾಜೊ಼ಥಯಲ ಫರೊಹನನೆ ತಿನಾ ನೈ ಮೊಜಾ಼ನೆ ಥಾವಾನಾ ಮನಕ್ಹೊನೆ ಅಮ್ಮ ಕೆ- ಮ್ಹೊಟಪನಮಾ ತುನೆ ಸಮಾನ ಕುನ್ನ ಛೆ? <verse eid="EZK 31:2" /><verse number="3" style="v" sid="EZK 31:3" />ಆಹಾ, ತಿಲಕ ದೆವದಾರ ಯಕ್ಕ ಝಾಡ ಲೆಬನೊನಮಾ ವ್ಹತ್ತು; ತಿನಾ ಠೊಂಗಿಯೊ ಚೊ಼ಕಾ ಛೆ, ತಿನಿ ಛೌಲಿ ಮ್ಹೊಟಿ, ತೆ ಉಚ್ಚು ಘನ್ನು ಛೆ, ತಿನಿ ತುದಿ ಹಬಾಳನೆ ಮುಟ್ಟಸ. <verse eid="EZK 31:3" /><verse number="4" style="v" sid="EZK 31:4" />ತಿನೆ ಪಾನಿನಾ ತುಫಾನೊ ಬೆಳಸಾಯಾ, ಮಹಾನದಿ ವೃದ್ದಿ ಕರಿ, ನದಿನಾ ಶಾಕೆ ತ್ಯಾನಾ ಮಳಾವೊನೆ ಸುತ್ತಿಲಿದ್ಯಾ, ಭುಮಿನಾ ಕ್ಹಾರಾ ಝಾಡೊನೆ ನದಿ ತಿನಾ ಕಾಲುವೆನೆ ದಿದ್ಯು. <verse eid="EZK 31:4" /><verse number="5" style="v" sid="EZK 31:5" />ಇಮ್ಮ ರ‍್ಹವಾಕ್ಹು ತೆ ಝಾಡ ರಾನನಾ ಕ್ಹಾರಾ ಝಾಡೊತಿಬಿ ಚೊ಼ಕು ವ್ಹತ್ತು; ತಿನಾ ಠೊಂಗಿಯೊ ನಿಬಿಡ ವ್ಹತ್ತಿಯೊ; ತ್ಯಾ ನಿರಾವರಿ ರ‍್ಹಯಲಕ್ಹು; ತಿನಾ ಠೊಂಗಿಯೊ ಲಾಂಬಾ ಥೈನ ಬೆಳದ್ಯಾತಾ. <verse eid="EZK 31:5" /><verse number="6" style="v" sid="EZK 31:6" />ಕ್ಹಾರಾ ಹಬಾಳನಾ ಪಕ್ಷಿಯೊ ತಿನಾ ಠೊಂಗಿಯೊಪರ ಗುಡ ಕರಿ ಲಿದ್ಯಾತಾ; ಜಾನವರೊ ತಿನಾ ಠೊಂಗಿಯೊನಾ ಹೆಟಾ ರ‍್ಹೈನ ಬಚ್ಚಾ಼ ಜನ್ನಾಡಾತಾ; ಕ್ಹಾರಾ ಮಹಾಜನಾಂಗೊ ತಿನಿ ಛೌಲಿಮಾ ಆಶ್ರಯ ವ್ಹತ್ತಾ. <verse eid="EZK 31:6" /><verse number="7" style="v" sid="EZK 31:7" />ತಿನಾ ಬೆರನೆ ಜಲಾಸರೆ ರ‍್ಹಯಲಕ್ಹು ತೆ ಝಾಡ ಉಚ್ಚಾ಼ತುಬಿ ಠೊಂಗಿಯೊನಾ ತುದಿತಾಬಿ ಕಂಗೊಳಸಾಡುತು. <verse eid="EZK 31:7" /><verse number="8" style="v" sid="EZK 31:8" />ಕ್ಹುದಾನಾ ಮಳಾಮಾನಾ ದೆವದಾರು ತಿನೆ ಪಸಂದ ಕರ‍್ಯಾ ಬಗರ ರ‍್ಹಯಾ; ತರಾಯಿನಾ ಝಾಡೊ ತಿನಾ ಠೊಂಗಿಯೊ ಅಕ್ಲಾ ಲಾಂಬಾ ನ್ಹೊತಾ; ಕಾಪುಕನಾ ಝಾಡೊ ತಿನಾ ಠೊಂಗಿಯೊ ಅಕ್ಲಾ ಜಾ಼ಡಾ ನ್ಹೊತಾ; ಕ್ಹುದಾನಾ ಮಳಾಮಾನು ಕಯು ಝಾಡಬಿ ತಿನಾ ನಿಂಗತ ಚೊ಼ಕು ನ್ಹೊತು. <verse eid="EZK 31:8" /><verse number="9" style="v" sid="EZK 31:9" />ಮಿ ತಿನೆ ಘನ್ನಾ ಶಾಕೆಕ್ಹು ಚೊ಼ಕೊ ಕರ‍್ಯೊ; ಕ್ಹುದಾನು ಮಳೊ ರ‍್ಹಯಲ ಎದೆನನಾ ಕ್ಹಾರಾ ಝಾಡೊ ತಿನೆ ಅಸುಯೆ ಥಾತಾತಾ. <verse eid="EZK 31:9" /><verse number="10" style="v" sid="EZK 31:10" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ತೆ ಝಾಡ ಘನ್ನು ಉಚ್ಚು಼ ಬೆಳ್ದಿನ ತಿನಿ ತುದಿನೆ ಮ್ಹಾಡನೆ ಲಗಾಡಿನ ತಿನಾ ನಿಳನಾ ವಿಷಯಮಾ ಫುಗ್ಯಲಕ್ಹು <verse eid="EZK 31:10" /><verse number="11" style="v" sid="EZK 31:11" />ಮಿ ತಿನೆ ಜನಾಂಗೊಮಾ ಘನ್ನೊ ತಾಕತವರ ಥಯಲವಾಲಾನಾ ಹತ್ಮಾ ದಿ ಪಡ್ಯೊಸ. ತೆ ತಿನಾ ಕೆಟ್ಟತನಾ ನಿಂಗತ ತಿನೆ ಶಿಕ್ಷಾ ದಿವಸಜ಼; ಮಿ ತಿನೆ ಢಕ್ಲಿಪಡ್ಯೊ. <verse eid="EZK 31:11" /><verse number="12" style="v" sid="EZK 31:12" />ಘನ್ನಾ ಭಯಾನಕ ಥಯಲ ಜನಾಂಗವಾಲಾ ಬಿಜಾ಼ ದೆಶನಾ ಮನಕ್ಹೊ ತಿನೆ ಕಾಟಿನ ಗೈ ಪಡ್ಯಾಸ; ತಿನಾ ಠೊಂಗಿಯೊ ಡೊಂಗರೊಮಾಬಿ ಕ್ಹಾರಾ ತಳಾವೊಮಾ ಪಡ್ಯಾಸ; ತಿನಾ ಠೊಂಗಿಯೊ ದೆಶನಾ ಕ್ಹಾರಾ ತೊರೆನಾ ಬಾಜು಼ ತುಟಿನ ಪಡ್ಯಲ ಛೆ; ಲೊಕನಾ ಕ್ಹಾರಾ ಜನಾಂಗೊ ತಿನಾ ಛೌಲಿಕ್ಹು ಭಾರಾ ತಿನೆ ಛೊಡಿನ ಗಯಾಸ. <verse eid="EZK 31:12" /><verse number="13" style="v" sid="EZK 31:13" />ಪಡಲ ಬುಡನಾ ಉಪ್ಪರ ಕ್ಹಾರಾ ಹಬಾಳನಾ ಪಕ್ಷಿಯೊ ಎರಗಸ; ತಿನಾ ಠೊಂಗಿಯೊನೆ ಕ್ಹಾರಾ ಜಾನವರೊ ಕ್ಹುಂದಸ.<verse eid="EZK 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 31:14" />ನಿರಾವರಿನಾ ಕಯಾ ಝಾಡೊ ತ್ಯುನಾ ಉಚ್ಚಾ಼ನೆ ಹೆಚ್ಕಿ ಕರಿಲಿನ ತ್ಯುನಿ ತುದಿನೆ ಮ್ಹಾಡನೆ ಲಾಗು ನೈಸೊ ಪಾನಿನೆ ಪಿತಾ ರ‍್ಹಯಲ ಮ್ಹೊಟಾ ಮ್ಹೊಟಾ ಝಾಡೊ ಉಚ್ಚಾ಼ ಥೈನ ಬೆಳ್ದೆ ನೈಸೊ ಅಮ್ಮ ಥಯು; ತೆ ಕ್ಹಾರಾ ಮರಣನಾ ಪಾಲ ಥಾವಸ; ಪಾತಾಳನೆ ತ್ಯುನಿ ಗತಿ ವ್ಹೈ; ಪಾತಾಳೆ ಉತ್ರಿನ ಗಯಲವಾಲಾವೊಕನ ನರ ಜನ್ಮವಾಲಾವೊನೆ ಯಕ್ಕ ಗುಂಪ ಥೈನ ಮಳಸ. <verse eid="EZK 31:14" /><verse number="15" style="v" sid="EZK 31:15" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ತೆ ಝಾಡ ಪಾತಾಳೆ ಉತ್ರಿನ ಗಯಲ ದಿನ್ನಮಾ ಮಿ ದುಕ್ಕನಾ ನಿಶಾನಾ ಕರ‍್ಯೊ; ತಿನಾ ದುರಥಾವಾನಾಹುತಿ ಮ್ಹೊಟಿ ನದಿ ಝಾಕಿನ ನದಿನಾ ಶಾಕೆ ಕಾಡಿ ಪಡ್ಯೊ, ಪಾನಿನು ತುಫಾನ ಹುಬ್ರೈ ಗಯು; ತಿನಾಹುತಿ ಲೆಬನೊನ ಗೊಳಾಡೆ ನಿಂಗತ ಕರ‍್ಯೊ ಭುಮಿನಾ ಕ್ಹಾರಾ ಝಾಡೊ ತೆ ದುಕ್ಕಕ್ಹು ಕುಕ್ಹೈ. <verse eid="EZK 31:15" /><verse number="16" style="v" sid="EZK 31:16" />ಮಿ ತಿನೆ ಭುತ್ಡಾವೊನಾ ಕ್ಹಾತೆ ಮಳೌ ಕೈನ ಪಾತಾಳನೆ ಢಕ್ಲಿಪಡ್ಯಲ ಪರ ತೆ ಪಡ್ಯಲ ಅವಾಜ಼ನೆ ಕ್ಹಾರಾ ಜನಾಂಗವಾಲಾ ಕಾಪ್ಯಾ; ವರಿ (ಪೈಲಾನಾ ಕಾಲಮಾ) ಅಧೊಲೊಕನಾ ಪಾಲ ಥಯಲ ಎದೆನನಾ ಕ್ಹಾರಾ ಝಾಡೊ, ಲೆಬನೊನನಾ ಚೊ಼ಕಾತಿ ಚೊ಼ಕಾ ಝಾಡೊ, ತೆನೈಸೊ ನಿರಾವರಿನಾ ಕ್ಹಾರಾ ತರಾನಾ ಝಾಡೊ ತ್ಯಾ ಸಂತೈಸಿ ಲಿದ್ಯಾ. <verse eid="EZK 31:16" /><verse number="17" style="v" sid="EZK 31:17" />ಎನೈಸೊ ತಿನೆ ರಟ್ಟಾನಿ ತಾಕತ ಥೈನ ಜನಾಂಗೊನಾ ವಚ್ಮಾ ತಿನಿಛೌಲಿನೆ ಆಶ್ರಯ ಕರಿ ಲಿದ್ಯಲವಾಲಾ ತಿನಾ ಕ್ಹಾತೆ ಪಾತಾಳನೆ ಉತ್ರಿನ ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಕರಾಲಾವೊನಾ ಕ್ಹಾತೆ ಮಳ್ಯಾ. <verse eid="EZK 31:17" /><verse number="18" style="v" sid="EZK 31:18" />ತಿನಿ ಶ್ರಿಂಗಾರತನಾಕ್ಹು ಮಹಿಮಾಕ್ಹು ಮಳಲ ತು ಎದೆನನಾ ಝಾಡೊಮಾ ಕಿಕ್ಹು ಕಮ್ಮ ಛೆ? ತೆನೈಸೊ ತು ಎದೆನನಾ ಝಾಡೊನಾ ಕ್ಹಾತೆ ಪಾತಳಮಾ ಢಕ್ಲೈನ ಅನ್ಯ ಮನ್ಕಹೊ ರ‍್ಹಯಲವಾಲಾವೊನಾ ವಚ್ಮಾ ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಕರಾಲಾವೊನಾ ಕ್ಹಾತೆ ಒರಗಿ ಜಾ಼ಶಿ. ಫರೊಹನ ತಿನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಎಜ಼ ಗತಿ ವ್ಹಂದಿಲಿವಸ ಕವಾನು ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 31:18" /></para>
  <chapter eid="EZK 31" />
  <chapter number="32" style="c" sid="EZK 32" />
  <para style="s">ಐಗುಪ್ತನಾ ರಾಜಾ಼ನೆ ಮೊಸಳಿನ ಹೊಲ್ಸಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 32:1" />ಯೆಹೊಯಾಕಿನ ಸೆರೆ ಥಯಲ ಬಾರವಾ ವರಕ್ಹನಾ ಬಾರವಾ ಮ್ಹೈನಾನಾ ಯಕ್ವಾ ದಿನ್ನಮಾ ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 32:1" /><verse number="2" style="v" sid="EZK 32:2" />ನರನಾ ಮನಕ್ಹ, ತು ಐಗುಪ್ತನೊ ರಾಜೊ಼ ಥಯಲ ಫರೊಹನನಾ ವಿಷಯಮಾ ಶೊಕನು ಗಿದ್ದ ತಿನೆ ಅಮ್ಮ ಕೆ ತು ಜನಾಂಗೊಮಾ ಕೃರ ರಾಜೊ಼ ಕವೈಲಿದ್ಯೊಸ; ದೆಕ ಮಹಾ ನದಿಮಾನು ಮ್ಹಟೊ ಕ್ಹಾಪ ಥೈಗಯೊಸ; ತು ರ‍್ಹಯಲ ನದಿಯೊನೆ ಜು಼ದು ಕರಿನ ಐನ ಪಾನಿನೆ ತಾರಾ ಪಗೊಕಂತೊ ಸರಕೈನ ಜನಾಂಗೊನಾ ತಳಾವೊನೆ ಕ್ಹುಂದಿನ ಮಾತಿಕ್ಹು ಬುಜ್ಜಿ ಪಾಡ್ಯೊ. <verse eid="EZK 32:2" /><verse number="3" style="v" sid="EZK 32:3" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಗುಂಪ ಥೈನ ಮಳ್ಯಲ ಘನ್ನಾ ಜನಾಂಗೊವಾಲಾನಾ ಹತ್ಮಾತೊ ಮಿ ಮಾರಿ ಬಲಿನೆ ತಾರಾ ಉಪ್ಪರ ನಾಕುಸ; ತ್ಯುನೆ ತುನೆ ತೆ ಬಲಿತಾ ಉಪ್ಪರ ಜಗ್ಗಸ. <verse eid="EZK 32:3" /><verse number="4" style="v" sid="EZK 32:4" />ಮಿ ತುನೆ ಜಿಮಿನಪರ ನಾಕಿಪಡುಸ; ತುನೆ ಭಾರೊ ಭಿರ್ಕೈನ ಕ್ಹಾರಾ ಹಬಾಳನಾ ಪಕ್ಷಿಯೊನೆ ತಾರಾ ಉಪ್ಪರ ಆವಾವರ್ಕ್ಹು ಕರಿನ ಕ್ಹಾರಾ ಜಾನವರೊನೆ ತುಕ್ಹು ತೃಪ್ತ ಕರೌಸ. <verse eid="EZK 32:4" /><verse number="5" style="v" sid="EZK 32:5" />ತಾರು ಮಾಕ್ಹು ಡೊಂಗರೊಪರ ನಾಕಿನ ಕ್ಹಾಡಿಯೊನೆ ತಾರೊ ಅಂಗನೊ ಭಾಗೊಕ್ಹು ಭರಿನ. <verse eid="EZK 32:5" /><verse number="6" style="v" sid="EZK 32:6" />ತಾರು ರಗತನಾ ತುಪಾನಕ್ಹು ದೆಶನೆ ಡೊಂಗರೊ ಲಕ್ಕಾ ಭಿಂಜೌ಼ಸ; ತಳಾ ತಾರಾಕ್ಹು ಭರಸ. <verse eid="EZK 32:6" /><verse number="7" style="v" sid="EZK 32:7" />ಫರೊಹನ, ಮಿ ತಾರಾ ಉಜಾಲಾನೆ ಇಜ್ಜಾ಼ತಾಮಾ ಪರ್ದೊ ಘಾಲಿನ ತ್ಯಾನಾ ಮ್ಹಾಡಕ್ಹು ಝಾಕಿ ಪಡುಸ, ಚಂದಪ್ಪಾ ಉಜಾಲು ನೈ ದೆತೊ. <verse eid="EZK 32:7" /><verse number="8" style="v" sid="EZK 32:8" />ತಾರಾ ಉಪ್ಪರ ಹಬಾಳಮಾ ಮಿಂಚಾ಼ನಾ ಕ್ಹಾರಾ ದಿವ್ವಾವೊನೆ ಮಿ ಮಸಕ ಕರಿನ ತಾರಾ ದೆಶಮಾ ಅಂದಾರು ಕರುಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 32:8" /><verse number="9" style="v" sid="EZK 32:9" />ಮಿ ತಾರಾ ನಾಶನ ಸುದ್ದಿ ಜನಾಂಗೊಮಾ ತುನೆ ನೈ ತಿಳ್ದಲ ದೆಶೊನೆಬಿ ಮುಟ್ಸಾತಾಮಾ ತೆ ಘನ್ನಾ ಜನಾಂಗೊನು ಮನಸ ಕಳವಳ ಥಾವಸ. <verse eid="EZK 32:9" /><verse number="10" style="v" sid="EZK 32:10" />ಹೊ, ಘನ್ನಾ ಜನಾಂಗೊ ತಾರಿ ಗತಿನೆ ಭುಚ್ಕಿನ ಘಾಬ್ರಾ ಥಾವಾವರ್ಕ್ಹು ಕರುಸ; ಮಿ ಮಾರಿ ತಲ್ವಾರನೆ ತ್ಯುನಾ ರಾಜಾ಼ವೊನಾ ಡೊಳಾವೊನಾ ಕ್ಹಾಮೊ ಫರಾತಾಮಾ ತ್ಯುನೆ ತಾರಿ ಕೆಟ್ಟ ಸ್ಥಿತಿನೆ ಶೆಂ ಕರಿನ ಭೆಂಕ್ಹು ಘಾಬ್ರಾ ಥಾವಸ; ತಾರಾ ನಾಶನಾ ದಿನ್ನೆ ಹರಯಕ್ಲೊ ತ್ಯುನು-ತ್ಯುನು ಜ಼ಲಮನಾ ಹುತಿ ಪಲ ಕಾಪಸ.<verse eid="EZK 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 32:11" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಬಾಬೆಲನಾ ರಾಜಾ಼ನು ತಲ್ವಾರ ತಾರಾ ಉಪ್ಪರ ಪಡಸ. <verse eid="EZK 32:11" /><verse number="12" style="v" sid="EZK 32:12" />ಮಿ ತಾರಾ ಘನ್ನಾ ಮನಕ್ಹೊನೆ ಘನ್ನಿ ಭಯಾನಕ ಜನಾಂಗವಾಲಾ ಥಯಲ ತಾಕತವರವಾಲಾವೊನಾ ತಲ್ವಾರೊಕ್ಹು ಕ್ಹಲಾಸ ಕರುಸ; ಐಗುಪ್ತ ಹೆಚ್ಕಿ ಕರಿಲಿವಾನಾ ಸಂಗತಿಯೊ; ತಿನಾ ಮನಕ್ಹೊ ಕೆಳಾಮಾಜ಼಼ ನೈಸೊ ಥಾವಸ. <verse eid="EZK 32:12" /><verse number="13" style="v" sid="EZK 32:13" />ಘನ್ನಾ ತುಫಾನೊನಾ ದಂಡಿಕನನಾ ಜಾನವರೊನೆ ನಾಶ ಕರುಸ; ತೆ ಪಾನಿನೆ ಕಲಕಲಿಕೆ ಹಬ್ದಾ ಕಯೊ ಮನಕ್ಹ ತ್ಯಾ ಪಗ್ಗ ನೈ ಮ್ಹೆಲ ಸಕ್ತೊ, ಕಯು ಜಾನವರ ಗೊರಸ ನೈ ಮಳ್ತು. <verse eid="EZK 32:13" /><verse number="14" style="v" sid="EZK 32:14" />ತೆಳಾಮಾ ತೆ ಪಾನಿ ಪಾತಳು ಥಯೆ ನಿಂಗತ ತೆ ತುಫಾನೊ ತೆಲನಾ ನಿಂಗತ ಹರದೆ ನಿಂಗತ ಕರುಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 32:14" /><verse number="15" style="v" sid="EZK 32:15" />ಐಗುಪ್ತಮಾ ಭರಲ ಕ್ಹಾರಿ ಆಸ್ತಿನೆ ಮಿ ನಿಗಸಿನ ತೆ ದೆಶನೆ ಹಾಳ ಕರಿನ ತ್ಯಾನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊನೆ ಕ್ಹಲಾಸ ಕರ್xಯಲಪರ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 32:15" /><verse number="16" style="v" sid="EZK 32:16" />ಪ್ರಾಲಾಪ ಕರಾಲಾ ಎ ಶೊಕನು ಗಿದ್ದಕವಾದೆ; ಜನಾಂಗೊನಾ ಛೊಕ್ರಿಯೊ ಇಮ್ಮ ಗೊಳಾಟ ಕರಾದೆ ಐಗುಪ್ತನಾಹುತಿಬಿ ತ್ಯಾನಾ ಘನ್ನಾ ಮನಕ್ಹೊನಾಹುತಿಬಿ ದುಕ್ಕ ಥೈನ ಎ ಗಿದ್ದ ಕವಾದೆ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 32:16" /></para>
  <para style="s">ಮೌತ ಥಯಲವಾಲಾವೊನು ದುನಿಯಾ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 32:17" />ಯೆಹೊಯಾಕಿನ ಸೆರೆ ಥಯಲ ಬಾರವಾ ವರಕ್ಹನಾ ಬಾರವಾ ಮ್ಹೈನಾನಾ ಪಂದ್ರಾವಾ ದಿನ್ನಮಾ ಯಹೊವಾ ಎ ವಾಕ್ಯ ಮನೆ ದಿದ್ಯೊಸ. <verse eid="EZK 32:17" /><verse number="18" style="v" sid="EZK 32:18" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಐಗುಪ್ತನಾ ನೈ ಮೊಜಾ಼ನೆ ಥಾವಾನಾ ಮನಕ್ಹೊನಾಹುತಿ ಗೊಳಾಡಿನ ತ್ಯುನೊನೆ ಘನ ಥಯಲ ಜನಾಂಗವಾಲಾವೊನೆ ಅಧೊಲೊಕನಾ ಉಂಡಾಮಾ ಢಕ್ಲಿ ಪಡ. <verse eid="EZK 32:18" /><verse number="19" style="v" sid="EZK 32:19" />ತು ಸುಂದರತಾಮಾ ಕಿಕ್ಹು ಕಮ್ಮ ಛೆ? ಉತ್ರಿನ ಗೈನ ಸುನ್ನತಿ ನೈಸೊವಾಲಾನಾ ವಚ್ಮಾ ಒರಗ. <verse eid="EZK 32:19" /><verse number="20" style="v" sid="EZK 32:20" />ಆಹಾ, ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಸ ಕರಾಲಾವೊನಾ ವಚ್ಮಾ ಪಡಸ; ತಲ್ವಾರ ಉಚಾ಼ಯಲ ಛೆ; ಪಾತಾಳಮಾ ಐಗುಪ್ತನೆ ತಿನಾ ಘನ್ನಾ ಮನಕ್ಹೊನೆ ಎಳದಿಲಿವೊ. <verse eid="EZK 32:20" /><verse number="21" style="v" sid="EZK 32:21" />ಪಾತಾಳಮಾನಾ ತಾಕತವರೊ ತಿನೆ ತಿನಾ ಸಹಾಯಕೊನೆ ದೆಕಿನ ಒಹೊ, ಇವ್ನೆ ಸುನ್ನತಿ ನೈಸೊವಾಲಾ ವ್ಹೈ, ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಕಾರಾಲಾ ವ್ಹೈ, ಉತ್ರಿನ ಐನ ಒರಗಿನ ಪಡ್ಯಾ ಕೈಲಿವಸ. <verse eid="EZK 32:21" /><verse number="22" style="v" sid="EZK 32:22" />ಅಶ್ಯರವಾಲಾ ತಿನಾ ಮನಕ್ಹೊ ಕೆಳಾಮಾಬಿ ತ್ಯಾ ರ‍್ಹವಸ; ತೆ ಮನಕ್ಹೊನಾ ಮಜಾ಼ರೊ ತಿನೆ ಸುತ್ತಿ ಲಿದ್ಯಾಸ; ತ್ಯುನೆ ಕ್ಹಾರಾ ಜ಼ನಾ ಸಂಹೃತವಾಲಾ, ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಥಾವಾಲಾ ವ್ಹೈ; <verse eid="EZK 32:22" /><verse number="23" style="v" sid="EZK 32:23" />ತ್ಯುನಾ ಮಜಾ಼ರೊ ಅಧೊಲೊಕನಾ ಮ್ಹೈನಾ ಜ಼ಗಾವೊಮಾ ಫೈಲಿ ಗಯಾಸ; ಅಶ್ಯುಪವಾಲಾ ಅಶ್ಯರನಾ ಮಜಾ಼ರನಾ ಸುತ್ತೆ ಛೆ; ಜಿವಲೊಕಮಾ ಭಿಕರ ಥಯಲವಾಲಾ ಇವ್ನೆ ಕ್ಹಾರಾ ಜ಼ನಾ ಸಂಹೃತವಾಲಾ, ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಥಯಲವಾಲಾ ವ್ಹೈ. <verse eid="EZK 32:23" /><verse number="24" style="v" sid="EZK 32:24" />ಎಲಾಮ ತ್ಯಾ ಛೆ; ತಿನಾ ಮನಕ್ಹೊ ಕ್ಹಾರಾ ತಿನಾ ಮಜಾ಼ರೊನೆ ಸುತ್ತಿ ಲಿದ್ಯಾಸ; ತ್ಯುನೆ ಕ್ಹಾರಾ ಜ಼ನಾ ಸಂಹೃತವಾಲಾ, ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಥಯಲವಾಲಾ ವ್ಹೈ; ಜಿವಲೊಕಮಾ ಭಿಕರ ಥಯನ ತೆ ಸುನ್ನತಿ ನೈಸೊವಾಲಾ ಅಧೊಲೊಕನೆ ಉತ್ರಿನ ಭುತ್ಡಾವೊನಾ ವಚ್ಮಾ ಅವಮಾನ ಥಯಾಸ. <verse eid="EZK 32:24" /><verse number="25" style="v" sid="EZK 32:25" />ಕ್ಹುರ್xಯಾವಾನೆ ಕ್ಹಲಾಸ ಥಯಲ ತಿನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊನಾ ವಚ್ಮಾ ಜ಼ಗಾ ಕರ್‍ಯಾಸ, ತ್ಯುನಾ ಮಜಾ಼ರೊ ತಿನಾ ಸುತ್ತ ಮುತ್ತ ಛೆ; ತ್ಯುನೆ ಕ್ಹಾರಾ ಜ಼ನಾ ಸುನ್ನತಿ ನೈಸೊವಾಲಾ ವ್ಹೈ, ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಥಯಲವಾಲಾ ವ್ಹೈ; ತ್ಯುನೆ ಜಿವಲೊಕಮಾ ಭಿಕರ ಥೈನ ಭುತ್ಡಾವೊನಾ ಕ್ಹಾತೆ ಮಳಿನ ಅವಮಾನ ಥಯಲವಾಲಾ ಥಯಾಸ; ಸಂಹೃತವಾಲಾವೊನಾ ವಚ್ಮಾ಼ಜ಼಼ ಎಲಾಮನೆ ಜ಼ಗಾ ತಯ್ಯಾರ ಥೈಸ. <verse eid="EZK 32:25" /><verse number="26" style="v" sid="EZK 32:26" />ಮೆಷೆಕ ತುಬಲ ತ್ಯುನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ತ್ಯಾ ರ‍್ಹವಸ; ತೆ ಮನಕ್ಹೊನಾ ಮಜಾ಼ರೊ ತ್ಯುನೊನೆ ಸುತ್ತಿ ಲಿದ್ಯಾಸ; ತ್ಯುನೆ ಕ್ಹಾರಾ ಜ಼ನಾ ಸುನ್ನತಿ ನೈಸೊವಾಲಾ, ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಥಯಲವಾಲಾ ವ್ಹೈ; ಜಿವಲೊಕಮಾ ಭಿಕರ ಥಯಾತಾತೊ; <verse eid="EZK 32:26" /><verse number="27" style="v" sid="EZK 32:27" />ಸುನ್ನತಿ ನೈಸೊವಾಲಾ ಶುರೊ ಜಿವಲೊಕಮಾ ತಾಕತವರೊನೆಬಿ ಭಿಕರ ಥೈನ ಕ್ಹಲಾಸ ಥೈನ ಆಯುದ್ದನಾ ಕ್ಹಾತೆಜ಼ ಪಾತಾಳೆ ಉತ್ರಿನ ತಲ್ವಾರೊನೆ ಮ್ಹೊಟ್ಲಾ ಕರಿಲಿನ ತ್ಯುನಾ ಅಸ್ಥಯೊನಾ ಉಪ್ಪರ ತ್ಯುನಾ ಕೆಟ್ಟ ಕಾಮೊನು ವಜ್ಜು಼ ಉಚೈಲಿದ್ಯಾಸ ತ್ಯುನಾ ವಚ್ಮಾ ಮೆಷೆಕನಾವಾಲಾ ತುಬಲಿನವಾಲಾ ಪಡ್ಯಾ ಬಗರ ಜಾ಼ವಸ ಸು.<verse eid="EZK 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 32:28" />ಫರೊಹನ, ತು ಸುನ್ನತಿ ನೈಸೊವಾಲಾವೊನಾ ವಚ್ಮಾ ನಾಶ ಥೈನ ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಥಯಲವಾಲಾವೊನಾ ವಚ್ಮಾ ಪಡಿಜಾ಼ಶಿ! <verse eid="EZK 32:28" /><verse number="29" style="v" sid="EZK 32:29" />ಎದೊಮ ತಿನಾ ರಾಜಾ಼ ಕ್ಹಾರಾ ಶಾನಾ ಮನಕ್ಹೊ ತ್ಯಾ ಛೆ; ತ್ಯುನೆ ತಾಕತವರ ಥೈನ ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಥಯಲವಾಲಾವೊನಾ ಕ್ಹಾತೆ ಪಡ್ಯಲ ರ‍್ಹವಸ; ಸುನ್ನತಿ ನೈಸೊವಾಲಾವೊನಾ ಕ್ಹಾತೆ ಉಂಡು ರ‍್ಹಯಲ ಜ಼ಗಾಮಾ ವಚ್ಮಾ ಒರಗಿನ ಗಯಾಸ. <verse eid="EZK 32:29" /><verse number="30" style="v" sid="EZK 32:30" />ಉತ್ತರ ದೆಶನಾ ಕ್ಹಾರಾ ಪ್ರಭುವೊ ಕ್ಹಾರಾ ಚಿದೊನ್ಯವಾಲಾ ಸಂಹೃತವಾಲಾವೊನಾ ಕ್ಹಾತೆ ಉತ್ರಿನ ತ್ಯಾ ಛೆ; ಭಯಾನಕ ರ‍್ಹಯಲ ತ್ಯುನಾ ತಾಕತನೆ ಸರ್ಮಿನ ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಥಯಲವಾಲಾವೊನಾ ವಚ್ಮಾ ಸುನ್ನತಿ ನೈಸೊವಾಲಾ ಥೈನ ಪಡಿನ ಉಂಡಾಮಾ ಪಡಲ ವಾಲಾವೊನಾ ಕ್ಹಾತೆ ವಚ್ಮಾ ಅವಮಾನ ಥಯಾಸ.<verse eid="EZK 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EZK 32:31" />ಫರೊಹನ ಇವ್ನೆ ಕ್ಹಾರಾವೊನೆ ದೆಕಿನ ತಿನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊನಾ ವಿಷಯಮಾ ಸಮಾದಾನ ವ್ಹಂದಸ; ಹೊ, ಫರೊಹನ ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾ ಥಯಲವಾಲಾ ತಿನಾ ಕ್ಹಾರಾ ಸೈನಿಕೊ ಸಮಾದಾನ ವ್ಹಂದಸ. ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 32:31" /><verse number="32" style="v" sid="EZK 32:32" />ದೆಕ, ಜಿವಲೊಕಮಾ ಮಿ ಮಾರಿ ಭೆಂ ಹುಟ್ಸಾಯೊಸ; ಫರೊಹನ ತಿನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಸುನ್ನತಿ ನೈಸೊವಾಲಾವೊನಾ ವಚ್ಮಾ, ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಥಯಲವಾಲಾವೊನಾ ವಚ್ಮಾ, ರ‍್ಹವಸ ಕವಾನು ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 32:32" /></para>
  <chapter eid="EZK 32" />
  <chapter number="33" style="c" sid="EZK 33" />
  <para style="s">ಕೈದಾಲಾವೊಪರ ಪಡಲ ವಜ್ಜು಼</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 33:1" />ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ- <verse eid="EZK 33:1" /><verse number="2" style="v" sid="EZK 33:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತಾರಾ ಮನಕ್ಹೊನೆ ಬೊದನೆ ಕರಿನ ತ್ಯುನೊನೆ ಅಮ್ಮ ಕೆ, ಮಿ ದೆಶಪರ ತಲ್ವಾರನೆ ಬಿಸತಾಮಾ ತೆ ದೆಶವಾಲಾ ತ್ಯುನಾಮಾ ಇನಿಲಿದಲ ಕೈದಾಲೊ, <verse eid="EZK 33:2" /><verse number="3" style="v" sid="EZK 33:3" />ದೆಶನಾ ಉಪ್ಪರ ಪಡಾನು ತಲ್ವಾರನೆ ದೆಕಲ ಬರೊಬ್ಬರ ಪೊಂಗೊ ಉದಿನ ಸ್ವಂತ ಮನಕ್ಹೊನೆ ಹುಶಾರ ಕರ‍್ಯಾ. <verse eid="EZK 33:3" /><verse number="4" style="v" sid="EZK 33:4" />ಅವಾಜ಼ ಐಕ್ಯಲವಾಲೊ ಕಯೊಬಿ ರ‍್ಹವಾದೆ ಹುಶಾರ ಥಯಾವಾಚಿ ಪಡಾನಾ ತಲ್ವಾರನೆ ಕ್ಹಾಪಡಿನ ನಾಶ ಥಯೊಮ ತಿನಾ ಮೌತನೆ ತೆಜ಼ ಕಾರಣ ವ್ಹೈ. <verse eid="EZK 33:4" /><verse number="5" style="v" sid="EZK 33:5" />ತೆ ಕೊಂಬನು ಅವಾಜ಼ ಐಕಿನಬಿ ಹುಶಾರ ಥಯೊ ನೈ ತೆಕ್ಲುಜ಼ ವ್ಹೈ; ತಿನಿ ಮೌತನೆ ತೆಜ಼ ಕಾರಣ ವ್ಹೈ; ಹುಶಾರ ಥಯಲ ರ‍್ಹವತ್ತೊ ತಿನು ಜ಼ಲಮ ವಚಾ಼ಡಿ ಲೆತೊತೊ. <verse eid="EZK 33:5" /><verse number="6" style="v" sid="EZK 33:6" />ತೆನೈಸೊ ಕೈದಾಲೊ ಪಡಾನಾ ತಲ್ವಾರನೆ ದೆಕಿನಬಿ ಕೊಂಬ ಉದ್ಯಾ ಬಗರ ಸ್ವಂತ ಮನಕ್ಹೊನೆ ಹುಶಾರ ಕರ‍್ಯಾವಾಚಿ ರ‍್ಹಯಲ ಟೈಮಮಾ ತಲ್ವಾರ ಪಡಿನ ತೆ ಮನಕ್ಹೊಮಾ ಕಿನೆಬಿ ರ‍್ಹವಾದೆ ನಾಶ ಕರ‍್ಯಾಮ, <verse eid="EZK 33:6" /><verse number="7" style="v" sid="EZK 33:7" />ತಿನಾ ಅಧರ್ಮಮಾ ನಾಶ ಥಯಲ ತೆ ಮನಕ್ಹನಾ ಮರಣನೆ ಕಾರಣ ಥಯಲ ಕೈದಾಲಾನೆ ಮುಯಿ ತಿರಿಸುಸ. <verse eid="EZK 33:7" /><verse number="8" style="v" sid="EZK 33:8" />ಮಿ ದುಷ್ಟನೆ- ದುಷ್ಟ, ಮರಶಿಜ಼ ಕೈನ ಕತಾಮಾ ತು ತೆ ದುಷ್ಟನೆ ತಿನಾ ಕೆಟ್ಟ ವಾಟತೊ ತಪ್ಪಿಸಾನೆ ತಿನೆ ಹುಶಾರ ಕರ್xಯಾಬಗರ ಗಯಾಮ ತೆ ತಿನಾ ಅಪರಾದಕ್ಹುಜ಼ ಮರು ಲಾಗಸ; ತಿನಾ ಮೌತನೆ ಕಾರಣ ಥಯಲ ತುನೆ ಮಿ ಮುಯಿ ತಿರಿಸೌಸ. <verse eid="EZK 33:8" /><verse number="9" style="v" sid="EZK 33:9" />ತೆನೈಸೊ ತು ದುಷ್ಟನೆ ಕೆಟ್ಟ ವಾಟತೊ ತಪ್ಪಿಸಾನಾ ಹುತಿ ತಿನೆ ಹುಶಾರ ಕರ‍್ಯೊತಬಿ ತೆ ತಿನೆ ನೈ ಛೊಡ್ಯಮ ತಿನಾ ಅಪರಾದೊಮಾಜ಼ ಮರಸ; ತುಜ಼ ತಾರು ಜ಼ಲಮ ವಚಾ಼ಡಿಲೆಶಿ.<verse eid="EZK 33:9" /></para>
  <para style="s">ಖುದ್ದನಿ ಜವಾಬ್ದಾರಿ</para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 33:10" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾವೊನೆ ಅಮ್ಮ ಕೆ, ಅಪ್ನಾ ದ್ರೊಹನಾ ವರಿ ಪಾಪನು ಭಾರ ಅಪ್ನಾ ಉಪ್ಪರ ಪಡ್ಯುಸ; ತಿಕ್ಹು ಕುಂದೈನ ಥೈನ ಚಾ಼ಲ್ಯಾಸ; ಅಪೆ ಕಿಮ್ಮ ವಾಚಾ಼ ಕೈನ ಕೈಲಿವೊಶಿತೊ. <verse eid="EZK 33:10" /><verse number="11" style="v" sid="EZK 33:11" />ಮಾರಾ ಜ಼ಲಮನಿ ಕ್ಹಮ್ಮ, ದುಷ್ಟನಾ ಮರಣಮಾ ಮನೆ ಲೆಶ ಥಯುತಬಿ ಕ್ಹುಶಿ ನತ್ತಿ; ತೆ ತಿನಾ ಕೆಟ್ಟ ವಾಟನೆ ಛೊಡಿನ ಜಿವ್ಸಾನು ಮನೆ ಕ್ಹುಶಿ ವ್ಹೈ. ಎ ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾವೊ, ತುಮಾರಾ ಕೆಟ್ಟ ವಾಟೊ ಛೊಡೊ, ಛೊಡಿ ಪಡೊ; ತುಮೆ ಕಾ ಮರೊಶಿ? ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 33:11" /><verse number="12" style="v" sid="EZK 33:12" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಮನಕ್ಹೊನೆ ಅಮ್ಮ ಕೆ- ಶಿಷ್ಟ ದ್ರೊಹ ಕರಲಪರ ತಿನು ಪುಣ್ಯ ತಿನೆ ಉದ್ದಾರ ನೈ ಕರ್xತು; ದುಷ್ಟ ತಿನಾ ದುಷ್ಟತನಾನೆ ಛೊಡ್ಯಮ ತಿನು ಪಾಪ ತಿನೆ ಪಾಡತು ನೈ; ಶಿಷ್ಟ ಪಾಪ ಕರ‍್ಯಾಮ ತಿನು ಪುಣ್ಯ ತಿನೆ ವಚಾ಼ಡತು ನೈ. <verse eid="EZK 33:12" /><verse number="13" style="v" sid="EZK 33:13" />ಮಿ ಶಿಷ್ಟನೆ- ತು ವಾಚ಼ಶಿಜ಼ ಕೈನ ಕವಾಕ್ಹು ತೆ ತಿನಾ ಪುಣ್ಯನಾ ಉಪ್ಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಿನ ಪಾಪ ಕರ‍್ಯೊಮ ತೆ ಕರಲ ಕಯುಜ಼ ಚೊ಼ಕು ಕಾಮ ತಿನಾ ಲೆಕ್ಕಾಮಾ ನೈ ಮಳಾತು; ತೆ ಕರಾನಾ ಪಾಪಕ್ಹುಜ಼ ತೆ ಮರಸ. <verse eid="EZK 33:13" /><verse number="14" style="v" sid="EZK 33:14" />ಮಿ ದುಷ್ಟನೆ ತು ಮರ್ಶಿಜ಼ ಕೈನ ಕವಾಕ್ಹು ತೆ ತಿನಾ ಪಾಪನೆ ಛೊಡಿನ ನಿತಿನ್ಯಾಯನೆ ಚ಼ಲಾವಾನಾ ಪಕ್ಷಮಾ. <verse eid="EZK 33:14" /><verse number="15" style="v" sid="EZK 33:15" />ಕದ್ಯಾಮ ತೆ ದುಷ್ಟ ಒತ್ತೆನೆ ಬಿಗಿ ಧರ‍್ಯಾಮ ಬಗರ ಕಾಳ್ಳಿದ್ಯಲ ಕ್ಹಾರು ವಾಪಸ ದಿನಜಿವನೆ ಆಧಾರ ರ‍್ಹಯಲ ನಿಯಮೊನೆ ಪಾಲನೆ ಕರಿನ ಕ್ಹಾರಾ ದುಷ್ಕ ಕಾಮೊನೆ ದುರ ರ್xಯಮ ಪಕ್ಷಮಾ ನೈ ಮರ್ತೊ, ಜಿವ್ತಿ ರ‍್ಹವಸಜ಼. <verse eid="EZK 33:15" /><verse number="16" style="v" sid="EZK 33:16" />ತೆ ಕರಲ ಕಯು ಪಾಪ ತಿನಾ ಹಿಸಾಬೆ ನೈ ಮಳ್ತು; ನಿತಿನ್ಯಾಯನೆ ಚ಼ಲಾವಸತೊ; ಜಿವ್ತೊ ರ‍್ಹವಸಜ಼. <verse eid="EZK 33:16" /><verse number="17" style="v" sid="EZK 33:17" />ತೆನೈಸೊ ತಾರಾ ಮನಕ್ಹೊ ಕರ್ತಾನು ಕ್ರಮ ಸಮಾ ನತ್ತಿ ಕೈನ ಕವಸ, ತ್ಯುನುಜ಼ ಕ್ರಮ ಸಮಾ ನತ್ತಿ ತೆಕ್ಲುಜ಼ ವ್ಹೈ. <verse eid="EZK 33:17" /><verse number="18" style="v" sid="EZK 33:18" />ಶಿಷ್ಟ ತಿನಾ ಶಿಷ್ಟತನಾನೆ ಛೊಡಿನ ಅಧರ್ಮ ಕರ‍್ಯೊಮ ತೆ ಅಧರ್ಮಕ್ಹುಜ಼ ಮರಸ. <verse eid="EZK 33:18" /><verse number="19" style="v" sid="EZK 33:19" />ದುಷ್ಟ ತಿನು ದುಷ್ಟತನಾನೆ ಛೊಡಿನ ನಿತಿನ್ಯಾಯನೆ ಚ಼ಲಾಯಮ ತಿಕ್ಹು ತೆ ವಾಚ಼ಸ. <verse eid="EZK 33:19" /><verse number="20" style="v" sid="EZK 33:20" />ತೆನೈಸೊ ತುಮೆ ಯಹೊವಾನಿ ಕ್ರಮ ಸಮಾ ನತ್ತಿ ಕೈನ ಕವಾಡಾಸ; ಇಸ್ರಾಯೆಲ ವಂಶವಲಾ, ತುಮಾರಾ ತುಮಾರಾ ನಡತೆನೆ ತಕ್ಕ ಮಿ ತುಮೊನೆ ಫೈಸಲೊ ಕರುಸ.<verse eid="EZK 33:20" /></para>
  <para style="s">ಯೆರುಸೆಲಿಮ ಪಡಾನಿ ಸುದ್ದಿ</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 33:21" />ಹಮೆ ಬಂದಿ ಥೈನ ಬಾರಾವಾ ವರಕ್ಹನಾ ದಕ್ಹವಾ ಮ್ಹೈನಾನಾ ಪಾಂಚ಼಼ವಾ ದಿನ್ನಮಾ ಯೆರುಸಲೆಮತಾ ಪಲಾಯನ ಕರಲ ಯಕ್ಲೊ ಮಕನ ಐನ ಗಾಮ ಶತ್ರು ಥಯುಸ ಕೈನ ಕದ್ಯೊ. <verse eid="EZK 33:21" /><verse number="22" style="v" sid="EZK 33:22" />ತೆ ಆವಾನಾ ದಿನ್ನನಾ ಪಾಚ಼ಲ್ಯಾ ಕ್ಹಾಂಜೆ ಮಿ ಯಹೊವಾನಿ ಹತ್ತನಾ ಸ್ಪರ್ಶಕ್ಹು ಪರವಶ ಥಯಲಕ್ಹು ಯಹೊವಾ ತೆ ಪಾಟೆ ಆವಸ ಕೈನ ಮಾರು ಮ್ಹೊಡು ಕ್ಹೊಲ್ಯೊತೊ; ಹೊ, ಮಾರು ಮ್ಹೊಡು ಕ್ಹುಲ್ಯುತು, ಮಾರು ಮುಕತನಾ ಗಯುತು.<verse eid="EZK 33:22" /></para>
  <para style="s">ಮನಕ್ಹೊನು ಪಾಪ</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 33:23" />ತೆಳಾಮಾ ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ. <verse eid="EZK 33:23" /><verse number="24" style="v" sid="EZK 33:24" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಇಸ್ರಾಯೆಲ ಗಾಮ್ನಾ ಹಾಳ ಜ಼ಗಾವೊಮಾ ರ‍್ಹವಸ ಅಬ್ರಹಾಮ ಯಕ್ಲೊಜ಼ ರ‍್ಹಯೊತುಬಿ ಆಂ ದೆಶ ತಿನೆ ಸ್ವಾಸ್ತ್ಯ ಥೈನ ಮಳ್ಯಲ ಸು ಮ್ಹೊಟು ವ್ಹೈ ಕೈನ ತಿಳ್ದೊಶಿ ಸು. <verse eid="EZK 33:24" /><verse number="25" style="v" sid="EZK 33:25" />ತಿನಾಹುತಿ ತು ತ್ಯುನೊನೆ ಅಮ್ಮ ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ರಗತಕ್ಹು ಮಳ್ಯಲ ಮಾಕ್ಹ ಕ್ಹಾವೊಶಿ, ಗೊಂಬಿಯೊ ಕನ ಡೊಳಾ ಉಚಾವೊಶಿ. ರಗತ ಚು಼ವ್ವಾವೊಶಿ; ತುಮಾರಾ ಹೆವಾ ದೆಶನೆ ಅನುಬೊಸಾನೆ ಥಾವಸ ಸು? <verse eid="EZK 33:25" /><verse number="26" style="v" sid="EZK 33:26" />ತುಮೆ ತಲ್ವಾರಮಾಜ಼ ಛೆ, ದುರಾಚಾರ ಚ಼ಲಾವೊಶಿ, ತುಮೊಮಾ ಹರಯಕ್ಲೊ ತ್ಯುನಾ ತ್ಯುನಾ ನೆರೆಯವನಾ ಬೈಕೊನೆ ಕೆಡಶ; ತುಮಾರಾ ಹೆವಾ ದೆಶನೆ ಅನುಬೊಸಸ ಸು? <verse eid="EZK 33:26" /><verse number="27" style="v" sid="EZK 33:27" />ವರಿ ತ್ಯುನೊನೆ ಅಮ್ಮ ಕೆ- ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಮಾರಾ ಕ್ಹಮ್ಮ, ಹಾಳ ಜ಼ಗಾವೊಪರ ರ‍್ಹವಾಲಾವೊನೆ ತಲ್ವಾರ ಕ್ಹಲಾಸ ಕರಸ; ಭಾರಾ ರ‍್ಹವಾಲಾವೊನೆ ಮಿ ಮೃಗನೆ ಪಾಲ ಕರುಸ; ಮಹೆಲಮಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ರೊಗ ಕ್ಹಲಾಸ ಕರಸ. <verse eid="EZK 33:27" /><verse number="28" style="v" sid="EZK 33:28" />ಮಿ ದೆಶನೆ ಹಾಳ ಕರಿಪಡುಸ, ತಿನಿ ತಾಕತನಿ ನಶಾ ಉತ್ರಿ ಜಾ಼ವಸ; ಇಸ್ರಾಯೆಲನಿ ಲೆನಾಡ ; ಕುನ್ನ ತ್ಯಾ ಹೈದಿನ ನೈ ಜಾ಼ತು. <verse eid="EZK 33:28" /><verse number="29" style="v" sid="EZK 33:29" />ತ್ಯುನೆ ಕರಲ ಘನ್ನಾ ದುರಾಚಾರೊ ಕ್ಹು ಮಿ ದೆಶನೆ ಹಾಳ ಕರಲ್ಪರ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ. ಕೈನ ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಥಾವಸ.<verse eid="EZK 33:29" /></para>
  <para style="s">ಪ್ರವಾದಿನು ಸುದ್ದಿನು ಫಲಿತಾಂಶ</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 33:30" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತಾರಾ ಮನಕ್ಹೊ ಗೊಡಿಯೊನಾ ಛೌಲಿಮಾಬಿ ಘರನಾ ಬಾಕಲೊಮಾಬಿ ತಾರಿ ಪ್ರಸ್ತಾಪ ಉಚೈನ ಪರಸ್ಪರ ಥೈನ ಯಕ್ನೆ ಯಕ್ಕ- ಯಹೊವಾನಾ ಮ್ಹೊಡಾತಿ ಆಯಲ ವಾತ ಐಕೆ ಆವೊ ಕೈನ ಕೈಲಿವಾಡಾಸ. <verse eid="EZK 33:30" /><verse number="31" style="v" sid="EZK 33:31" />ಪ್ರಶ್ನೆ ಪುಚಾ಼ನೆ ಆವಾನ ಮನಕ್ಹೊ ನಿಂಗತ ತ್ಯುನೆ ತುಕನ ಐನ ಮಾರಾ ಭಕ್ತೊ ಥೈನ ತಾರಾ ಕ್ಹಾಮಾ ಬೈಟಿನ ತಾರಾ ವಾತೊ ಐಕಸ, ತೆನೈಸೊ ಕೈದಿಲಿನ ನೈ ಜಾ಼ತಾ; ಮ್ಹೊಡಾಕ್ಹು ಘನ್ನು ಪ್ಯಾರ ದೆಕಾಡಸ. ತ್ಯುನು ಮನಸ್ಸ ಕಾಳ್ಳಿದ್ಯಲವಾಲಾವೊಪರ ಜಾ಼ವಸ. <verse eid="EZK 33:31" /><verse number="32" style="v" sid="EZK 33:32" />ದೆಕ, ತಾರಿ ವಾತ ತ್ಯುನಾ ಹಿಸಾಬಮಾ ಯಕ್ಕ ಗಿದ್ದ ಕವಾಲಾನು ವಾದ್ಯ ಗ್ಯಾನಕ್ಹು ವಜಾ಼ಡಿನ ಚೊ಼ಕಿ ಸ್ವರಕ್ಹು ಕವಾನಾ ಪ್ಯಾರನಾ ಗಿದ್ದನೆ ಸಮಾ ಛೆ; ತಾರಾ ವಾತೊ ಐಕಸ ತೆನೈಸೊ ಕೈದಿಲೆತಾ ನೈ. <verse eid="EZK 33:32" /><verse number="33" style="v" sid="EZK 33:33" />ತು ಪೈಲಾಜ಼಼ ಕವಾನು ಥಾತಾಮಾ (ಆಹಾ, ಥಯು) ತ್ಯುನಾ ವಚ್ಮಾ ರ‍್ಹಯಲವಾಲೊ ಪ್ರವಾದಿಜ಼ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಕ್ಹರಿಬಿ ಗ್ವತ್ತ ಥಾವಸ.<verse eid="EZK 33:33" /></para>
  <chapter eid="EZK 33" />
  <chapter number="34" style="c" sid="EZK 34" />
  <para style="s">ಇಸ್ರಾಯೆಲನಾ ಕುರುಬರೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 34:1" />ಯಹೊವಾ ಎ ವಾತ ಮನೆ ದಿದ್ಯೊ. <verse eid="EZK 34:1" /><verse number="2" style="v" sid="EZK 34:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಇಸ್ರಾಯೆಲ ಕವಾನಾ ಹಿಂಡನಾ ಕುರಬುರ್xಯೊನೆ ಎ ಕ್ಹುದಾನಿ ವಾತ ಕೆ, ಕೆಜ಼ ಕೆ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಅಯ್ಯೊ, ಸ್ವಂತ ಪೆಟನೆ ಹೊರೆದ ಲಿವಾನಾ ಇಸ್ರಾಯೆಲನಾ ಕುರಬುರ್xಯೊನಿ ಗತಿ ಸು ಕೌ! ಬಕ್ರಾವೊನು ಪೆಟ ದೆಕಾನು ಕುರುಬು ಧರ್ಮ ವ್ಹೈ. <verse eid="EZK 34:2" /><verse number="3" style="v" sid="EZK 34:3" />ತುಮೆ ಕೊಬ್ಬಿನು ಮಾಕ್ಹ ಕ್ಹಾವೊಶಿ, ಬಕ್ರಾನಾ ಬಾಲೊನಿ ಹೊದಕಿ ವರಾಡಿಲಿವೊಶಿ, ಕೊಬ್ಬಲ ಬಕ್ರಾವೊನೆ ಕಾಟೊಶಿ; ತೆನೈಸೊ ಬಕ್ರಾವೊನೆ ಚ಼ರಾತಾ ನೈ. <verse eid="EZK 34:3" /><verse number="4" style="v" sid="EZK 34:4" />ಹಾ, ತುಮೆ ದುರ್ಬಲ ರ‍್ಹಯಲನೆ ಬಲ ಕರ‍್ಯಾ ನೈ, ರೊಗೊನೆ ಸ್ವಸ್ಥ ಕರ‍್ಯಾ ನೈ, ತ್ಯುನು ಸು ಬಗೈತುಬಿ ತುಮೆ ಭಾಂದತಾ ನೈ. ನ್ಹಟಾಡಲನೆ ಹಿಂಡಮಾ ಮಳಾಯಾ ನೈ, ಚು಼ಕೈಲಿದಲನೆ ಹುಡಕ್ಯಾ ನೈ, ತೆ ಕ್ಹಾರಾವೊನೆ ಹಿಂಸೆ ಬಲತ್ಕಾರಕ್ಹು ಆಳತಾ ಆಯಾಸ. <verse eid="EZK 34:4" /><verse number="5" style="v" sid="EZK 34:5" />ಕುರುಬರೊ ನೈ ರ‍್ಹಯಲಕ್ಹು ತೆ ಚದರಿ ಗಯಾ; ದಿಕ್ಕಾಪಾಲ ಥೈನ ರಾನನಾ ಕ್ಹಾರಾ ಕ್ರುರ ಜಾನವರೊನೆ ಅನ್ನ ಥಯಾ; <verse eid="EZK 34:5" /><verse number="6" style="v" sid="EZK 34:6" />ಮಾರಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಮಲೆನಾಡನೆ ಉಚ್ಚು ರ‍್ಹಯಲ ಹರಯಕ್ಕ ಡೊಂಗರನಾ ಉಪ್ಪರ ಫರ್xಯಾ; ಹೊ, ಮಾರಾ ಬಕ್ರಾ ಕ್ಹಾರಾ ಭುಮಂಡಲಪರ ಚದರಿ ಗಯಾ; ಕುನ್ನಜ಼ ತ್ಯುನೊನೆ ಕಾಳಜಿ ಕರ‍್ಯಾ ನೈ. ಗೈನ ಹುಡಕ್ಯಾ ನೈ. <verse eid="EZK 34:6" /><verse number="7" style="v" sid="EZK 34:7" />ಕುರುಬರೊ, ಯಹೊವಾನಿ ವಾತ ಐಕೊ; <verse eid="EZK 34:7" /><verse number="8" style="v" sid="EZK 34:8" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಾರಾ ಕ್ಹಮ್ಮ ಮಾರಾ ಬಕ್ರಾ ಚೊ಼ರಿ ಥಯಾ, ರಾನನಾ ಕ್ಹಾರಾ ಜಾನವರೊನೆ ಅನ್ನ ಥಯಾ, ಕುರುಬರೊ ನ್ಹೊತಾತೊ, ಮಾರಾ ಕುರುಬರೊ ಮರಾ ಬಕ್ರಾವೊನೆ ಹುಡುಕ್ಯಾ ನೈತೊ, ತ್ಯುನೆ ಸ್ವಂತ ಪೆಟೊನೆ ದೆಕಿಲಿದ್ಯಾಸ ನೈಸೊ ಮಾರಾ ಬಕ್ರಾವೊನಾ ಪೆಟನೆ ದೆಕ್ಯಾಜ಼ ನೈ. <verse eid="EZK 34:8" /><verse number="9" style="v" sid="EZK 34:9" />ತಿನಾಹುತಿ, ಕುರುಬರೊ ಯಹೊವಾನಿ ವಾತ ಐಕೊ, <verse eid="EZK 34:9" /><verse number="10" style="v" sid="EZK 34:10" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮಾರಾ ಜ಼ಲಮನಿ ಕ್ಹಮ್ಮ, ಮಿ ಕುರುಬರೊನೆ ವಿರುದ್ದ ಥಯೊಸ; ತ್ಯುನೆ ಮಾರಾ ಬಕ್ರಾವೊನು ಲೆಕ್ಕೊ ಮನೆ ವಪ್ಸು; ಮಾರಾ ಬಕ್ರಾ ಚ಼ರಾವಾನಾ ಕಾಮಕ್ಹು ತ್ಯುನೊನೆ ಕಾಡಿ ಪಡುಸ. ತೆ ಕುರುಬರೊ ಹಬ್ದಾ ಸ್ವಂತ ಪೆಟೊ ಬರಿಲೆತಾ ನೈ; ಮಾರಾ ಬಕ್ರಾ ಅನ್ನ ಥೈನ ತ್ಯುನಾ ಮ್ಹೊಡಾವೊಮಾ ಪಡ್ಯಾ ಬಗರ ತ್ಯುನೊನೆ ವಚಾ಼ಡುಸ.<verse eid="EZK 34:10" /></para>
  <para style="s">ಚೊ಼ಕೊ ಕುರುಬುರ‍್ಯೊ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 34:11" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ, ಮಿಜ಼ ಮಾರಾ ಬಕ್ರಾವೊನೆ ಪಾಚೊ಼ ಲಾಗಿನ ಹುಡಕುಸ. <verse eid="EZK 34:11" /><verse number="12" style="v" sid="EZK 34:12" />ಹಿಂಡನೊ ಕುರುಬ ಸುತ್ತ ಮುತ್ತ ಚದರಿ ಗಯಲ ತಿನಾ ಬಕ್ರಾವೊನೆ ಹುಡಕೆ ನಿಂಗತ ಮಿ ಮಾರಾ ಬಕ್ರಾವೊನೆ ಹುಡಕುಸ; ಕಾರ್ಮುಗಿಲನಾ ದಿನೊಮಾ ಚಲ್ಲಾಪಿಲ್ಲಿ ಥಯಲ ಕ್ಹಾರಾ ಜ಼ಗಾವೊತಾ ತ್ಯುನೊನೆ ಛೊಡೈನ. <verse eid="EZK 34:12" /><verse number="13" style="v" sid="EZK 34:13" />ಜನಾಂಗೊನಾ ವಶತೊ ತಪ್ಸಿನ. ದೆಶ ದೆಶತಾ ಮಳೈನ ಸ್ವಂತ ದೆಶೆ ಆವಾಲಗಾಡಿನ. ಇಸ್ರಾಯೆಲನಾ ಡೊಂಗರೊಮಾಬಿ ತೊರೆನಾ ಬಾಜು಼ಮಾಬಿ ವಕ್ಳಾವೊಕನ, ಕ್ಹಾರಾ ಹಕ್ಕೆಮಾಬಿ ಚ಼ರೌಸ. <verse eid="EZK 34:13" /><verse number="14" style="v" sid="EZK 34:14" />ತ್ಯುನೊನೆ ಚೊ಼ಕೊ ಚಾ಼ರೊ ಚ಼ರೌಸ; ತ್ಯುನು ಹುಲಗಾವಲ ಇಸ್ರಾಯೆಲನಾ ಉಚ್ಚಾ ರ‍್ಹಯಲ ಡೊಂಗರೊಪರ ರ‍್ಹವಸ; ತ್ಯಾ ಚೊ಼ಕಾ ಚಾ಼ರಾಮ ಕ್ಹುರವಸ; ಇಸ್ರಾಯೆಲನಾ ಡೊಂಗರೊಮಾ ಕಚ್ಚಾ಼ ಚಾ಼ರಾನೆ ಚ಼ರಸ. <verse eid="EZK 34:14" /><verse number="15" style="v" sid="EZK 34:15" />ಮಿಜ಼ ಮಾರಾ ಬಕ್ರಾವೊನೆ ಚ಼ರೈನ ಅರಾಮ ಕ್ಹುರಯೆ ನಿಂಗತ ಕರುಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 34:15" /><verse number="16" style="v" sid="EZK 34:16" />ಚು಼ಕೈ ಲಿನ ಗಯಲನೆ ಹುಡಕುಸ, ನ್ಹಟಾಡಲ ಹಿಂಡಮಾ ಮಳೌಸ, ದುರ್ಬಲ ಥಯಲನೆ ತಾಕತವರ ಕರುಸ, ತುಟಲ ಅಂಗನೆ ಭಾಂದುಸ; ಬಲತಲ ಕೊಬ್ಬಲ ಬಕ್ರಾವೊನೆ ನಾಶ ಕರುಸ; ತ್ಯುನೊನೆ ನ್ಯಾಯ ದಂಡನೆ ಕವಾನಾ ಚಾ಼ರಾನೆ ಕ್ಹಲೌಸ.<verse eid="EZK 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 34:17" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಮಾರಿ ಹಿಂಡ, ದೆಕೊ, ಮಿ ತುಮಾರಾಮಾನಾ ಬಕ್ರಾ ಬಕ್ರಿಯೊನೆ ಟಗರೊ ಮಧ್ಯವರ್ತಿ ಥೈನ ನ್ಯಾಯ ತಿರಿಸುಸ. <verse eid="EZK 34:17" /><verse number="18" style="v" sid="EZK 34:18" />ಟಗರೊ ಬಕ್ರಾ, ಚೊ಼ಕಾ ಚಾ಼ರಾನೆ ತುಮೆ ಚಾ಼ವಾನು ಛೊಡಿನ ಬಿಜಾ಼ ಚಾ಼ರಾನೆ ಕ್ಹುಂದಿನ ಪಗ್ಗನಿ ಕಸಾ ಕರಲ ನ್ಹಾನು ಕಾಮ ವ್ಹೈ ಸು? ಚೊ಼ಕು ಪಾನಿನೆ ಪಿನ ಉಗ್ರಲನೆ ಪಗ್ಗಕ್ಹು ಬಾಜು಼ ಕರಿನ ನ್ಹಾನು ಕಾಮ ವ್ಹೈಸು? <verse eid="EZK 34:18" /><verse number="19" style="v" sid="EZK 34:19" />ತುಮೆ ಕ್ಹುಂದಿನ ಪಗ್ಗನಿ ಕಸಾ ಕರಲ ಮಾರಾ ಬಕ್ರಾ ಚ಼ರುಲಾಗ್ಯು; ತುಮೆ ಪಗ್ಗಕ್ಹು ಕಲೈನ ಬಾಜು಼ ಕರಲನೆ ತ್ಯುನೆ ಪಿವ ಲಾಗ್ಯು. <verse eid="EZK 34:19" /><verse number="20" style="v" sid="EZK 34:20" />ಇಮ್ಮ ರ‍್ಹವಾಕ್ಹು ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ದೆಕೊ, ಮಿಜ಼ ಕೊಬ್ಬಲ ಟಗರೊ ಹೊತನೆಬಿ ಗರಿಬ ಬಕ್ರಾವೊನೆ ಮೆಕೆನೆಬಿ ನ್ಯಾಯ ತಿರಿಸುಸ. <verse eid="EZK 34:20" /><verse number="21" style="v" sid="EZK 34:21" />ಟಗರೊ ಬಕ್ರಿಯೊ, ತುಮೆ ಬಕ್ರಾ ಮೆಕೆಯೊನೆ ಪಕ್ಕಿಕ್ಹುಬಿ ಕ್ಹಾಂದಾಕ್ಹುಬಿ ಢಕಲ್ತಾ ದುರ್ಬಲ ಥಯಲನೆ ಶಿಂಗ್ಡಾವೊಕ್ಹು ಗುದ್ದತು ಮಾರಾ ಹಿಂಡನೆ ಚದರಸಿನ ಛೊಡ್ಯಾ; <verse eid="EZK 34:21" /><verse number="22" style="v" sid="EZK 34:22" />ತಿನಾಹುತಿ ಮಾರಿ ಹಿಂಡ ಹಬ್ದಾ ಕೆಳಾಮಾಜ಼಼ ಚೊ಼ರಿ ಥಯಾವಾಚಿ ಮಿ ತಿನೆ ರಕ್ಷಾ ಕರಿನ ಬಕ್ರಾ ಮೆಕೆನೆಬಿ ನ್ಯಾಯ ತಿರಸುಸ.<verse eid="EZK 34:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 34:23" />ಮಾರಿ ಹಿಂಡನೆ ಕೈದಾನೆ ಯಕ್ಕಜ಼ ಕುರುಬನೆ ತಯ್ಯಾರ ಕರುಸ; ಮಾರೊ ಸೆವಕ ಥಯಲ ದಾವಿದ ಕವಾನೊ ತೆ ಕುರುನ ತಿನೆ ಚ಼ರಾವಸ; ಹೊ, ತಿನೊ ಕುರುಬ ಥೈನ ತಿನೆ ಚ಼ರಾತೊ ಆವಸ. <verse eid="EZK 34:23" /><verse number="24" style="v" sid="EZK 34:24" />ಯಹೊವಾ ಥಯಲ ಮಿ ಮಾರಾ ಮನಕ್ಹೊನೊ ಕ್ಹುದಾ ಥೈನ ರ‍್ಹೌಸ; ಮಾರೊ ಸೆವಕ ಥಯಲ ದಾವಿದ ತ್ಯುನೊನೆ ಆಳಾಲೊ ಪ್ರಭು ಥೈನ ರ‍್ಹವಸ; ಯಹೊವಾ ಥಯಲ ಮಿಜ಼ ಎ ಕದ್ಯೊಸ. <verse eid="EZK 34:24" /><verse number="25" style="v" sid="EZK 34:25" />ಮಿ ತ್ಯುನಾ ಕ್ಹಾತೆ ಸಮಾಧಾನನು ಒಡಂಬಡಿಕೆ ಕರಿ ಲ್ಯುಸ; ದುಷ್ಟ ಜಾನವರೊ ದೆಶಮಾ ಹಬ್ದಾ ನೈ ರ‍್ಹಯಲ ನಿಂಗತ ಕರುಸ; ಮಾರಾ ಮನಕ್ಹೊ ರಾನಮಾ ಭೆಂವಾಚಿ ರ‍್ಹವಸ, ಜಂಗಲಮಾ ಅರಾಮ ನಿಂದರ ಕರಸ. <verse eid="EZK 34:25" /><verse number="26" style="v" sid="EZK 34:26" />ಮಿ ತ್ಯುನೊನೆ ಮಾರಾ ಡೊಂಗರನಾ ಸುತ್ತೆ ರ‍್ಹಯಲ ಜ಼ಗಾವೊನೆ ಆಶಿರ್ವಾದ ಕರಿನ ಕ್ಹುಷಿ ಕರೌಸ; ಕರೆಟ್ಟ ಟೈಮೆ ಪಾನಿ ಆವಾ ಲಗಾಡುಸ; ಶುಭದಾಯಕ ಆಶಿರ್ವಾದನು ಪಾನಿ. <verse eid="EZK 34:26" /><verse number="27" style="v" sid="EZK 34:27" />ಕ್ಹೆತರನಾ ಝಾಡೊ ಫಲ ಛೊಡಸ; ಕ್ಹೆತರೊ ಚೊ಼ಕಾ ಬೆಳೆ ದಿವಸ; ಮನಕ್ಹು ಸ್ವದೆಶಮಾ ನೆಮ್ಮದಿಕ್ಹು ರ‍್ಹವಸ; ತ್ಯುನಾ ಉಪ್ಪರ ಘಾಲಲ ನೊಗನಾ ಗುಟೊನೆ ಮಿ ತೊಡಿನ ತ್ಯುನೊನೆ ಅಡಿಯಾಳ ಥೈನ ಕರಿ ಲಿದಲ ಅಧಿನತೊ ಛೊಡಾಯಲಪರ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ದೃಡ ಥಾವಸ. <verse eid="EZK 34:27" /><verse number="28" style="v" sid="EZK 34:28" />ತೆ ದಿನ್ನತೊ ತ್ಯುನೊನೆ ಬಿಜಾ಼ ಮನಕ್ಹೊ ಸುರೆ ನೈ ಕರ ಸಕ್ತಾ, ಜಂಗಲನಾ ಜಾನವರೊ ನೈ ಕ್ಹಾ ಸಕ್ತಾ; ತ್ಯುನೆ ಕಿನೆಜ಼ ಭುಚ಼ಕ್ಯಾ ವಾಚಿ ನೆಮ್ಮದಿ ಥೈನ ರ‍್ಹವಸ. <verse eid="EZK 34:28" /><verse number="29" style="v" sid="EZK 34:29" />ಮಿ ತ್ಯುನಾಹುತಿ ಪ್ರಸಿದ್ದ ಫಲನಾ ಝಾಡೊ ಬೆಳಸುಸ, ಬರಗಾಲ ತ್ಯುನಾ ದೆಶನೆ ಹಬ್ದಾ ಹಾಳ ನೈ ಕರ್ತು, ತ್ಯುನೆ ಬಿಜಾ಼ ಮನಕ್ಹೊನಾ ತಿರಸ್ಕಾರನೆ ಗುರಿ ನೈ ಥಾತಾ. <verse eid="EZK 34:29" /><verse number="30" style="v" sid="EZK 34:30" />ತೆಳಾಮಾ ತ್ಯುನೆ ತ್ಯುನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಕವಾನಾ ಮನೆ ತ್ಯುನಾ ಕ್ಹಾತೆ ಛೆ ಕೈನಬಿ ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾ ಥಯಲ ತ್ಯುನೆ ಮಾರಾ ಮನಕ್ಹೊ ಥಯಾಸ ಕೈನಬಿ ಗ್ವತ್ತ ಕರಿಲಿವಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 34:30" /><verse number="31" style="v" sid="EZK 34:31" />ತುಮೆ ಮಾರಾ ಬಕ್ರಾ ವ್ಹೈ, ಮಾರಾ ಕಾವಲನಾ ಬಕ್ರಾ ವ್ಹೈ; ನರ ಜಾನವರೊ ಥಯಲ ತುಮೊನೆ ಮಿ ಕ್ಹುದಾ ವ್ಹೈ ಕೈನ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಕವಸ.<verse eid="EZK 34:31" /></para>
  <chapter eid="EZK 34" />
  <chapter number="35" style="c" sid="EZK 35" />
  <para style="s">ಎದೊನನೆ ಕ್ಹುದಾನಿ ಶಿಕ್ಷಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 35:1" />ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ- <verse eid="EZK 35:1" /><verse number="2" style="v" sid="EZK 35:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಸೆಯಿರ ಡೊಂಗರನಾ ಗಾಮನೆ ಕ್ಹಾಮೊ ಥೈನ ತಿನೆ ಎ ಕ್ಹುದಾನಿ ವಾತ ಕೆ, <verse eid="EZK 35:2" /><verse number="3" style="v" sid="EZK 35:3" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಸೆಯಿರ ಡೊಂಗರ, ದೆಕೊ, ಮಿ ತುಮೊನೆ ವಿರುದ್ದ ಥಯೊಸ; ಮಿ ತಾರಾ ಗಾಮ್ನಾ ಉಪ್ಪರ ಹತ್ತ ಉಚೈನ ತಿನೆ ಹಾಳ ಕರಿ ಪಡುಸ. <verse eid="EZK 35:3" /><verse number="4" style="v" sid="EZK 35:4" />ಮಿ ತಾರಾ ಗಾಮೊನೆ ನಾಶ ಕರ್ತಾಮಾ ತು ರಾನ ಥಾಶಿ; ತೆಳಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತಿಳ್ದಿಲೆಶಿ. <verse eid="EZK 35:4" /><verse number="5" style="v" sid="EZK 35:5" />ತು ಇಸ್ರಾಯೆಲೊನಾ ಉಪ್ಪರ ಘನ್ನಿ ಶಿಟ್ಟ ಮ್ಹೆಲಿನ ತ್ಯುನಾ ಅಪರಾದೊನಾ ಲಾಸ್ಟ ಕಾಲಮಾ ಆಪತ್ತ ಥಯಲ್ಪರ ತ್ಯುನೊನೆ ತಲ್ವಾರನಾ ಮ್ಹೊಡೆ ಗುರಿ ಕರಲಕ್ಹು. <verse eid="EZK 35:5" /><verse number="6" style="v" sid="EZK 35:6" />ತಿನಾಹುತಿ ಮಾರಾ ಜ಼ಲಮನಿ ಕ್ಹಮ್ಮ, ಮಿ ತುನೆ ರಗತಕ್ಹು ಭರುಸ, ರಗತನಿ ಕೊಡಿ ತುನೆ ಪಾಚಿ಼ ಲಾಗಸ; ತು ರಗತ ಸುರಸಾನೆ ಹೆಸ್ಯಾ ಬಗರ ರ‍್ಹಯಲಕ್ಹು ರಗತನು ತುಫಾನಜ಼ ತುನೆ ಪಿಟ್ಟ ಲಾಗಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 35:6" /><verse number="7" style="v" sid="EZK 35:7" />ಸೆಯಿರ ಡೊಂಗರ, ಮಿ ತಾರಾ ಗಾಮನೆ ಹಾಳ ಕರಿನ ತಿಮಾ ಜಾ಼ವಾಲಾವೊನೆ ಆವಾಲಾವೊನೆ ನಾಶ, <verse eid="EZK 35:7" /><verse number="8" style="v" sid="EZK 35:8" />ತಾರಾ ಡೊಂಗರೊನೆ ತಾರಾ ಮನಕ್ಹೊನಾ ಮುರ್ದಾವೊಕ್ಹು ಭರುಸ; ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಕರಾಲಾ ತಾರು ಡೊಂಗರ ಖಾಡಿ ಕರಿನ ಪಡಿ ಜಾ಼ವಸ. <verse eid="EZK 35:8" /><verse number="9" style="v" sid="EZK 35:9" />ಮಿ ತುನೆ ಹಮೆಶಾನಾ ನಾಶನನೆ ಗುರಿ ಕರುಸ; ತಾರಾ ಗಾಮೊ ಮನಕ್ಹೊ ನೈಸೊ ಥಾವಸ; ತೆಳಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತಾರಾ ಮನಕ್ಹೊನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 35:9" /><verse number="10" style="v" sid="EZK 35:10" />ತು ಎ ಬೆ ಜನಾಂಗೊ ಎ ಬೆ ದೆಶೊ ಮಾರಾ ವಶ ಥಾವಸ, ಹಮೆ ತಿನೆ ಅನುಭವಿಸೆಸ ಕೈಲಿನ ತ್ಯಾ ಮಾರಿ ಸಾನಿಧ್ಯನೆ ಅಲಕ್ಷ ಕರಲಕ್ಹು ಮಾರಾ ಜ಼ಲಮನಿ ಕ್ಹಮ್ಮ, <verse eid="EZK 35:10" /><verse number="11" style="v" sid="EZK 35:11" />ತು ಮಾರಾ ಮನಕ್ಹೊನೆ ದ್ವೆಶ ಕರಿನ ತ್ಯುನಾ ಉಪ್ಪರ ಮ್ಹೆಲ್ಯಲ ಶಿಟ್ಟನೆಬಿ ಮ್ಹೊಟಾ ಕಾಮನೆಬಿ ಮಿ ತುನೆ ಪ್ರತಿ ಕರುಸ; ತುನೆ ಶಿಕ್ಷಾ ದಿದಲ್ಪರ ಮಿ ತ್ಯುನೊನೆ ದಿಕ್ಹುಸ. ತೆಳಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 35:11" /><verse number="12" style="v" sid="EZK 35:12" />ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ ವರಿ ತು ಇಸ್ರಾಯೆಲನಾ ಡೊಂಗರೊನೆ ದೆಕಿನ ಹಾಳ ಥೈ ಗಯಾ, ಅಪೊನೆ ತುತ್ತ ಥಯಾಸ ಕೈನ ಕರಲ ದುಷಣೆ ಯಹೊವಾ ಥಯಲ ಮಾರಾ ಕಾನೆ ಪಡ್ಯಾಸ ಕವಾನು ತುನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 35:12" /><verse number="13" style="v" sid="EZK 35:13" />ತಾರಾ ಮನಕ್ಹೊ ಮ್ಹೊಟೊ ಅವಾಜ಼ ಕರಿನ ಮಾರಾ ಉಪ್ಪರ ಕದಲ ಹೆಚ್ಕಿ ಹರಟೆ ಐಕ್ಯೊಸ. <verse eid="EZK 35:13" /><verse number="14" style="v" sid="EZK 35:14" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಮಿ ತುನೆ ಹಾಳ ಕರಿನ ಪುರಿ ದುನಿಯಾನೆ ಕ್ಹುಷ ಕರುಸ. <verse eid="EZK 35:14" /><verse number="15" style="v" sid="EZK 35:15" />ಇಸ್ರಾಯನು ಆಸ್ತಿ ಹಾಳ ಥಾತಾಮಾ ದುನಿಯಾ ಕ್ಹಾರಿ ಕ್ಹುಶಿ ಥಾವಾ ವರಕ್ಹು ಕರುಸ; ಸೆಯಿರ ಡೊಂಗರ ತು ಹಾಳ ಥಾಶಿ; ಹೊ, ಯೆದೊಮ ಸಿಮೆ ಕ್ಹಾರು ಘನ್ನು ಹಾಲ ಥಾವಸ; ತೆಳಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ಗ್ವತ್ತ ಥಾವಸ.<verse eid="EZK 35:15" /></para>
  <chapter eid="EZK 35" />
  <chapter number="36" style="c" sid="EZK 36" />
  <para style="s">ಇಸ್ರಾಯೆಲೊನಿ ಅಗ್ಲಿ ಸೌಭಾಗ್ಯ ಮನಸ್ಸನಿ ಶುದ್ದಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 36:1" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಇಸ್ರಾಯೆಲನಾ ಡೊಂಗರೊನೆ ಎ ಕ್ಹುದಾನಿ ವಾತ ಕೆ- ಇಸ್ರಾಯೆಲನಾ ಡೊಂಗರೊ, ಯಹೊವಾನಿ ವಾಕ್ಯಾ ಐಕೊ. <verse eid="EZK 36:1" /><verse number="2" style="v" sid="EZK 36:2" />ದುಷ್ಮನ ತುಮೊನೆ ದೆಕಿನ ಆಹಾ, ಕತಾ ಎ ಜು಼ನ್ನಾ ಘರೊ ಹಮಾರಾ ವಶ ಥಯಾಸ ಕೈನ ಫುಗ್ಯಲಕ್ಹು ಎ ಕ್ಹುದಾನಿ ವಾತ ಕೌ ಕೈನ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ಅಪ್ಪಣೆ ಥಯಸ <verse eid="EZK 36:2" /><verse number="3" style="v" sid="EZK 36:3" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಅಯ್ಯೊ, ಕ್ಹಾರಿ ಬಗಲಬಿ ಕ್ಹುಂದೈಲಿನ ಹಾಳ ಥಯಲ ತುಮೆ ಜನಾಂಗೊಮಾ ಉಗ್ರಲವಾಲಾವೊನಾ ವಶ ಥಯಾಸತೊ! ಹರಟೆ ಕರಾಲಾವೊನಾ ಮ್ಹೊಮಾ ಪಡಿನ ಮನಕ್ಹೊನಾ ದುಷಣೆನೆ ಗುರಿ ಥಯಾಸತೊ! <verse eid="EZK 36:3" /><verse number="4" style="v" sid="EZK 36:4" />ತಿನಾಹುತಿ ಇಸ್ರಾಯೆಲನಾ ಡೊಂಗರೊ, ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾಕ್ಯಾ ಐಕೊ- ಡೊಂಗರೊ ತೊರೆ ತಗ್ಗುನೆಬಿ ರಾನ ಥಯಲ ಹಾಳ ಜ಼ಗಾವೊನೆಬಿ ಸುತ್ತೆ ಜನಾಂಗೊಮಾ ಉಗ್ರಲವಾಲಾ ಚೊ಼ರಿ ಕರಿನ ಅಣಕಿಸಾನು ಹಾಳ ಗಾಮೊನೆಬಿ ಯಹೊವಾ ಕರ್ತಾ ಅಮ್ಮ ಕವಸ. <verse eid="EZK 36:4" /><verse number="5" style="v" sid="EZK 36:5" />ಆಹಾ, ಮಾರಾ ದೆಶನೆ ತ್ಯುನಿ ಸ್ವಾಸ್ತ್ಯ ಕರಿಲಿನ ಪುರಾ ಮನಸ್ಸಕ್ಹು ಕ್ಹುಷಿ ಥಯಲವಾಲಾ ತಿನೆ ಪುರಾ ಮನಸ್ಸಕ್ಹು ತಿರಸ್ಕಾರ ಕರಿನ ಸುರೆನೆ ಢಕ್ಲಿ ಪಡ್ಯಲವಾಲಾ ಥಯಲ ಕ್ಹಾರಾ ಎದೊಮವಾಲಾವೊನೆ ಬಿಜಾ಼ ಜನಾಂಗೊಮಾ ಉಗ್ರಲವಾಲಾವೊನೆ ಮಿ ರೊಷಕ್ಹು ಶಿಟ್ಟ ಥಾತೊ ಶಪಿಸ್ಯೊಸ; <verse eid="EZK 36:5" /><verse number="6" style="v" sid="EZK 36:6" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಇಸ್ರಾಯೆಲ ದೆಶನಾ ವಿಷಯನಿ ಎ ಕ್ಹುದಾನಿ ವಾತನೆ ತಿನಾ ಡೊಂಗರೊ ತೊರೆ ತಗ್ಗುನೆ ಕೌ ಕೈನ ಅಪ್ಪಣೆ ಥಯುಸ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಆಹಾ, ಮಿ ಶಿಟ್ಟಕ್ಹು ರೊಷಾವೆಶಕ್ಹು ಬೊಲ್ಯೊಸ, ತುಮೆ ಬಿಜಾ಼ ಜನಾಂಗೊಕ್ಹು ಅವಮಾನ ಅನುಭವಿಸ್ಯಾಸತೊ! <verse eid="EZK 36:6" /><verse number="7" style="v" sid="EZK 36:7" />ತಿನಾಹುತಿ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ತುಮಾರಾ ಸುತ್ತೆ ಬಿಜಾ಼ ಜನಾಂಗೊ ತ್ಯುನಾ ಉಪ್ಪರ ಥಯಲ ಅವಮಾನನೆ ಅನುಭವಿಸಾನು ಕ್ಹರಿಜ಼ ವ್ಹೈ ಕೈನ ಹತ್ತ ಉಚೈನ ಕ್ಹಮ್ಮ ಘಾಲ್ಯೊಸ. <verse eid="EZK 36:7" /><verse number="8" style="v" sid="EZK 36:8" />ಇಸ್ರಾಯೆಲನಾ ಡೊಂಗರೊ, ತುಮಾರಾ ಝಾಡೊ ಠೊಂಗಿಯೊ ಫಾಡಿಲಿನ ಮಾರಾ ಮನಕ್ಹೊ ಥಯಲ ಇಸ್ರಾಯೆಲೊನೆ ಫಲ ದಿವಸ; ತ್ಯುನು ಆವಾನು ನಜಿಕ ಛೆ. <verse eid="EZK 36:8" /><verse number="9" style="v" sid="EZK 36:9" />ದೆಕೊ, ಮಿ ತುಮಾರಾ ಪಕ್ಷನೊ ವ್ಹೈ; ತುಮೊಕನ ಫರುಸ; ತುಮೊಮಾ ಉಳಾನಾ, ಬಿತ್ತಸ; <verse eid="EZK 36:9" /><verse number="10" style="v" sid="EZK 36:10" />ತುಮೊಮಾ ಘನ್ನಾ ಜ಼ನಾ ಕದ್ಯಾಮ ಇಸ್ರಾಯೆಲ ಪುರಾ ವಂಶ ರ‍್ಹಯೆ ನಿಂಗತ ಕರುಸ; ಗಾಮೊ ಮನಕ್ಹೊಕ್ಹು ಭರಿ ಜಾ಼ವಸ, ಹಾಳ ಜ಼ಗಾವೊಪರ ಕಟ್ಟಡ ಉಟಸ; <verse eid="EZK 36:10" /><verse number="11" style="v" sid="EZK 36:11" />ತುಮೊಮಾ ಘನ್ನಾ ಮನಕ್ಹೊನೆ ಜಾನವರೊನೆ ವೃದಿ ಕರುಸ; ತೆ ಘನ್ನಾ ಅಭಿವೃದ್ದಿ ಥಾವಸ; ಪೈಲಾ ನಿಂಗತ ತುಮೊಮಾ ರ‍್ಹವಾಲಾವೊನೆ ಭರೈನ ಪೈಲಾತಿ ತುಮೊನೆ ಚೊ಼ಕಿ ಸ್ಥಿತಿನೆ ಲೌಸ; ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 36:11" /><verse number="12" style="v" sid="EZK 36:12" />ಡೊಂಗರನು ಸಿಮೆ, ಮಿ ತಾರಾಮಾ ಮನಕ್ಹೊನು ಸಂಚಾರ ಉಂಟ ಕರುಸ; ಮಾರಾ ಮನಕ್ಹೊ ಥಯಲ ಇಸ್ರಾಯೆಲೊ ತರಾಮಾ ಸಂಚಾರ ಕರ್ತಾ ತುನೆ ಸ್ವಾಸ್ತ್ಯ ಥೈನ ಅನುಭವಿಸಸ; ತು ಹಬ್ದಾ ತ್ಯುನೊನೆ ಬಚ್ಚಾ಼ ದಿದ್ಯಾ ಬಗರ ರ‍್ಹಶಿ. <verse eid="EZK 36:12" /><verse number="13" style="v" sid="EZK 36:13" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ತು ನರಭಕ್ಷಕ ಥೈನ ತಾರಾ ಮನಕ್ಹೊನೆ ಪುತ್ರಶೊಕ ದಿದಿ ಕೈನ ತುನೆ ಗಾಳೊ ದಿವಸತೊ; <verse eid="EZK 36:13" /><verse number="14" style="v" sid="EZK 36:14" />ಹಬ್ದಾ ತು ಮನಕ್ಹೊನೆ ಖಲಸ ಕರಾಲೊ ಥಾತಿ ನೈ, ತಾರಾ ಮನಕ್ಹೊನೆ ಹಬ್ದಾ ಪುತ್ರಶೊಕ ನೈ ದೆತಿ; <verse eid="EZK 36:14" /><verse number="15" style="v" sid="EZK 36:15" />ಮ್ಲೆಚ್ಛರ ಧಿಕ್ಕಾರನೆ ಹಬ್ದಾ ತಾರಾ ಕಾನೆ ನೈ ಪಾಡ್ತೊ; ತು ಜನಾಂಗೊಕ್ಹು ಹಬ್ದಾ ಅವಮಾನ ನೈ ಅನುಭವಿಸ್ತಿ; ತಾರಾ ಮನಕ್ಹೊ ಮುಗ್ಗರಿಸಾನೆ ಹಬ್ದಾ ತು ಕಾರಣ ನೈ ಥಾತಿ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 36:15" /></para>
  <para style="s">ಇಸ್ರಾಯೆಲನು ನಯಿ ಜಿವನ</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 36:16" />ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 36:16" /><verse number="17" style="v" sid="EZK 36:17" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾ ಸ್ವಂತ ದೆಶಮಾ ರ‍್ಹತಾಮಾ ತ್ಯುನಾ ಕೆಟ್ಟ ವಾಟೊ ಕೆಟ್ಟ ವಿಚಾರೊಕ್ಹು ತಿನೆ ಹೊಲೆಗೈದ್ಯಾ; ತ್ಯುನಿ ನಡತೆ ಮುಟ್ಟಿನಿ ಹೊಲಸ ನಿಂಗತ ಮನೆ ಹಸೈ ಥಯುತು. <verse eid="EZK 36:17" /><verse number="18" style="v" sid="EZK 36:18" />ತ್ಯುನೆ ದೆಶನಾ ಉಪ್ಪರ ರಗತ ಚು಼ವೈನ ತ್ಯುನಿ ಗೊಂಬಿಯೊಕ್ಹು ತಿನೆ ಹೊಲೆಗೈದ್ಯಲಕ್ಹು ಮಿ ತ್ಯುನಾ ಉಪ್ಪರ ಮಾರಿ ರೊಷಾಗ್ನಿನೆ ಸುರಸಿನ. <verse eid="EZK 36:18" /><verse number="19" style="v" sid="EZK 36:19" />ಜನಾಂಗೊಮಾ ತ್ಯುನೊನೆ ಚದರಸಿನ ದೆಶ ದೆಶನೆ ತುರಿನ ತ್ಯುನಾ ಕೆಟ್ಟ ವಾಟೊ ಕೆಟ್ಟ ವಿಚಾರೊನೆ ಕರೆಟ್ಟ ದಂಡ ದಿದ್ಯೊ. <verse eid="EZK 36:19" /><verse number="20" style="v" sid="EZK 36:20" />ತ್ಯುನೆ ತೆ ಜನಾಂಗೊಮಾ ಮಳಲ್ಪರ ಒಹೊ, ಇವ್ನೆ ಯಹೊವಾನಾ ಮನಕ್ಹೊ ವ್ಹೈ, ತಿನಾ ದೆಶತಾ ಭ್ರಷ್ಟ ಥೈನ ಆಯಾಸ ಕೈನ ಕವೈಲಿನ ಮಾರಾ ಪರಿಶುದ್ದ ನಾಮನೆ ಅಪಕಿರ್ತಿನೆ ಲಾವಾನೆ, <verse eid="EZK 36:20" /><verse number="21" style="v" sid="EZK 36:21" />ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾ ಜನಾಂಗೊಮಾ ಮಳಿನ ತ್ಯಾ ಅಪಕಿರ್ತಿನೆ ಗುರಿ ಕರಲ ಮಾರಾ ಪರಿಶುದ್ದ ನಾಮನಾ ಹುತಿ ಮಿ ಮರಗ್ಯೊ. <verse eid="EZK 36:21" /><verse number="22" style="v" sid="EZK 36:22" />ತಿನಾಹುತಿ ತು ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾವೊನೆ ಇಮ್ಮ ಕೆ- ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾವೊ, ತುಮಾರಾಹುತಿ ನ್ಹವೈ, ತುಮೆ ಜನಾಂಗೊನಾ ಕ್ಹಾತೆ ಮಳಿನ ಅಪಕಿರ್ತಿನೆ ಗುರಿ ಕರಿನ ಮಾರಾ ಪರಿಶುದ್ದ ನಾಮನಾ ಹುತಿಜ಼ ಎ ರಕ್ಷಣೆನಾ ಕಾಮನೆ ಕರುಸ. <verse eid="EZK 36:22" /><verse number="23" style="v" sid="EZK 36:23" />ಜನಾಂಗೊಮಾ ಅಪಕಿರ್ತಿನೆ ಗುರಿ ಥಯಲ, ಕದ್ಯಾಮ ತುಮೆ ಜನಾಂಗೊನಾ ವಚ್ಮಾ ಅಪಕಿರ್ತಿನೆ ಗುರಿ ಕರಲ ಮಾರಾ ಘನ ನಾಮನೆ ಗೌರವನೆ ಮಿ ವಚಾ಼ಡಿಲ್ಯುಸ; ಇಮ್ಮ ಮಿ ತ್ಯುನಾ ಡೊಳಾ ಕ್ಹಾಮಾ ತುಮಾರಾ ರಕ್ಷಣೆನಾ ಮುಲಕ ಮಾರಿ ಗೌರವ ವಚಾ಼ಡಿಲೆತಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಥಾವಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 36:23" /><verse number="24" style="v" sid="EZK 36:24" />ಮಿ ತುಮೊನೆ ಜನಾಂಗೊಮಾತೊ ಛೊಡೈನ ಕ್ಹಾರಾ ದೆಶೊತೊ ಮಳೈನ ಸ್ವಂತ ದೆಶನೆ ಬಲೌಸ. <verse eid="EZK 36:24" /><verse number="25" style="v" sid="EZK 36:25" />ಮಿ ತುಮಾರಾ ಉಪ್ಪರ ನಿರ್ಮಲೊದಕನೆ ಪ್ರೊಕ್ಷಣೆನೆ ತುಮೆ ನಿರ್ಮಲ ಥಾವೊಶಿ; ತುಮಾರಾ ಕ್ಹಾರಾ ಮುರ್ತಿಯೊಕ್ಹುಬಿ ಕ್ಹಾರಾ ವಿದನಾ ಹೊಲಸಕ್ಹುಬಿ ತುಮೊನೆ ಶುದ್ದ ಕರುಸ. <verse eid="EZK 36:25" /><verse number="26" style="v" sid="EZK 36:26" />ಮಿ ತುಮೊನೆ ನವು ಮನಸ್ಸ ದಿನ ತುಮೊಮಾ ನಯಿ ಆತ್ಮಾ ಹುಟ್ಟಿಸೌಸ; ದಗ್ಡಾ ರ‍್ಹಯಲ ಮನಸನೆ ತುಮೊಕ್ಹು ಕಾಡಿನ ನರಮ ರ‍್ಹಯಲ ಮನಸನೆ ತುಮೊನೆ ದ್ಯುಸ. <verse eid="EZK 36:26" /><verse number="27" style="v" sid="EZK 36:27" />ಮಾರಿ ಆತ್ಮಾನೆ ತುಮೊಮಾ ರ‍್ಹಯೆ ನಿಂಗತ ಅನುಗ್ರಹ ಕರಿನ ತುಮೆ ಮಾರಾ ನಿಯಮೊನೆ ಅನುಸರಣೆ ಕರೆ ನಿಂಗತ ಕರುಸ. ತುಮೆ ಮಾರು ಆಗನ್ಯಾ ಕೈದಿಲಿನ ಆಚರಣೆ ಕರೊಶಿ. <verse eid="EZK 36:27" /><verse number="28" style="v" sid="EZK 36:28" />ಮಿ ತುಮೊನೆ ಪಿತೃವೊನೆ ಅನುಗ್ರಹ ಕರಲ ದೆಶಮಾ ತುಮೆ ರ‍್ಹವೊಶಿ. ತುಮೆ ಮನೆ ಮನಕ್ಹೊ ಥೈನ ರ‍್ಹವೊಶಿ, ಮಿ ತುಮೊನೆ ಕ್ಹುದಾ ಥೈನ ರೌಸ. <verse eid="EZK 36:28" /><verse number="29" style="v" sid="EZK 36:29" />ಮಿ ತುಮೊನೆ ತುಮಾರಾ ಕ್ಹಾರಾ ಹೊಲಸಕ್ಹು ಉದ್ದಾರ ಕರಿನ ಬೆಳೆ ಬೆಳ್ಧಾದೆಕೈನ ಅಪ್ಪಣೆ ದಿನ ತಿನೆ ವೃದ್ದಿ ಕರುಸ; ತುಮೊನೆ ಬರಗಾಲ ಹಬ್ದಾ ಆವಾನೆ ನೈ ದೆತೊ. <verse eid="EZK 36:29" /><verse number="30" style="v" sid="EZK 36:30" />ತುಮೆ ಬರಗಾಲ ದೆಶವಾಲಾ ವ್ಹೈ ಕೈನ ಜನಾಂಗೊ ತುಮೊನೆ ನಿಂದಾ ಕರ‍್ಯಾ ಬಗರ ಮಿ ಝಾಡನಾ ಫಲನೆ ಕ್ಹೆತರನಾ ಬೆಳೆನೆ ಹೆಚ್ಕಿ ಕರುಸ. <verse eid="EZK 36:30" /><verse number="31" style="v" sid="EZK 36:31" />ತೆಳಾಮಾ ತುಮೆ ತುಮಾರಾ ಕೆಟ್ಟ ವಾಟೊ ದುರಾಚಾರೊನೆ ಶೆಂ ಕರಿನ ತುಮಾರಾ ಅಪರಾಧೊನಾ ವರಿ ಅಸಹ್ಯ ಕಾಮೊಕ್ಹು ತುಮೊಕ್ಹು ತುಮೆಜ಼ ಹೆಸಿ ಲಿವೊಶಿ.<verse eid="EZK 36:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 36:32" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ, ಮಿ ಎ ರಕ್ಷಣೆನಾ ಕಾಮನೆ ಕರಾನು ತುಮಾರಾಕ್ಹು ನ್ಹವೈ ಕೈನ ತುಮೊನೆ ಗ್ವತ್ತ ರ‍್ಹವಾದೆ; ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾ, ತುಮಾರಾ ದುರ್ಮಾರ್ಗೊನೆ ಲಜ್ಜ ಪಡೊ, ಸರಮೊ. <verse eid="EZK 36:32" /><verse number="33" style="v" sid="EZK 36:33" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಮಿ ತುಮೊನೆ ತುಮಾರಾ ಕ್ಹಾರಾ ಅಪರಾದೊಕ್ಹು ಶುದ್ದ ಕರಾನಾ ದಿನ್ನಮಾ ಗಾಮೊನೆ ರ‍್ಹವಾಲಾವೊಕ್ಹು ಭರುಸ, ಹಾಳ ಜ಼ಗಾವೊಪರ ಘರೊ ಥಾವಸ. <verse eid="EZK 36:33" /><verse number="34" style="v" sid="EZK 36:34" />ಹೈದಿನ ಜಾ಼ವಾಲಾವೊನಾ ಡೊಳಾ ಕ್ಹಾಮಾ ಹಾಳಪಡಲ ಜಂಗಲನಿ ಜಿಮಿನನೆ ಕ್ಹಂದಸ. <verse eid="EZK 36:34" /><verse number="35" style="v" sid="EZK 36:35" />ತೆಳಾಮಾ ಮನಕ್ಹೊ- ಜಂಗಲ ರ‍್ಹಯಲ ಎ ದೆಶ ಎದೆನ್ ಗಾರ್ಡನ ನಿಂಗತ ಚಮ್ಕಸ; ಪಡಿನ ಹಾಳ ಥಯಲ ಗಾಮೊ ಕೊಟೆಕೊತ್ತಲಕ್ಹು ಮಳಿನ ಮನಕ್ಹೊಕ್ಹು ಭರಿ ಗಯುಸ ಕೈನ ಕವಸ. <verse eid="EZK 36:35" /><verse number="36" style="v" sid="EZK 36:36" />ಯಹೊವಾ ಥಯಲ ಮಿಜ಼ ಪಡಿ ಗಯಲನೆ ಭಾಂದಿನ ಹಾಳ ಥಯನೆ ಬೆಳಸ್ಯೊಸ ಕವಾನು ತುಮಾರಾ ಸುತ್ತೆ ಉಗ್ರಲ ಜನಾಂಗೊನೆ ಗ್ವತ್ತ ಥಾವಸ; ಯಹೊವಾ ಥಯಲ ಮಿಜ಼ ಕದ್ಯೊಸ, ಕರುಸ.<verse eid="EZK 36:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EZK 36:37" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಮಿ ವರಿ ಯಕ್ಕ ವಿಷಯಮಾ ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾವೊನಾ ವಿಜ್ಞಾಪನೆ ಐಕಿನ ಪುರಾ ಕರುಸ; ಕದ್ಯಾಮ ತ್ಯುನಿ ಜನಸಂಕ್ಯಾನೆ ಹಿಂಡ-ಹಿಂಡ ಥೈನ ಹೆಚ್ಚ ಕರುಸ. <verse eid="EZK 36:37" /><verse number="38" style="v" sid="EZK 36:38" />ಮಿಸಲ ಥಯಲ ಮಂದೆ ನಿಂಗತ, ಸನ್ನೊಮಾ ಯೆರುಸಲೆಮೆ ಐನ ಮಳಾನಾ ಹಿಂಡ ನಿಂಗತ ಮನಕ್ಹೊ ಹಾಳ ಥಯಲ ಗಾಮೊಮಾ ಹಿಂಡ ಹಿಂಡ ಥೈನ ಭರಿ ಜಾ಼ವಸ; ತೆಳಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಥಾವಸ.<verse eid="EZK 36:38" /></para>
  <chapter eid="EZK 36" />
  <chapter number="37" style="c" sid="EZK 37" />
  <para style="s">ಕ್ಹುಕ್ಹಾಯಲ ಹಡ್ಕಾವೊನು ಮಡ್ಡಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 37:1" />ಮಿ ಯಹೊವಾನಾ ಹಸ್ತಸ್ಪರ್ಶಕ್ಹು ಕ್ಹುದಾನಾ ವಶಮಾ ಥಯೊತೆ ತಿನಾ ಆತ್ಮಾನಾ ಮುಲಕ ಮನೆ ಲಿನ ಗೈನ ಹಡ್ಕಾವೊಕ್ಹು ಭರಲ ಯಕ್ಕ ಘಾಟಮಾ ಉತಾರಿನ. <verse eid="EZK 37:1" /><verse number="2" style="v" sid="EZK 37:2" />ಮಿ ತೆ ಹಡ್ಕಾವೊನಾ ವಚ್ಮಾ ಕ್ಹಾಡಿನೆ ಬಳಸಿಲಿನ ಆವಾ ವರ್ಕ್ಹು ಕರ‍್ಯೊ; ದೆಕ, ಕ್ಹಾಡಿನಾ ಉಪ್ಪರ ಕ್ಹಾರು ಘನ್ನು ಕ್ಹುಕ್ಹೈ ಗಯಲ ಹಡ್ಕಾ ಲೆಕ್ಕೊ ನೈಸೊ ಪಡ್ಯಾತಾ. <verse eid="EZK 37:2" /><verse number="3" style="v" sid="EZK 37:3" />ತೆ ಮನೆ- ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಎ ಹಡ್ಕಾವೊನೆ ಜ಼ಲಮ ಆವಸ ಸು ಕೈನ ಪುಚ್ಚಾ಼ಕ್ಹು? ಮಿ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ, ತುನೆಜ಼ ಗ್ವತ್ತ ಕೈನ ಉತ್ತರ ದಿದ್ಯೊ. <verse eid="EZK 37:3" /><verse number="4" style="v" sid="EZK 37:4" />ತೆಳಾಮಾ ತೆ ಮನೆ ಅಮ್ಮ ಅಪ್ಪಣೆ ದಿದ್ಯೊ. ತು ಹಡ್ಕಾವೊಪರ ಅವಾಜ಼ಕ್ಹು ತಿನೆ ಎ ಕ್ಹುದಾನಿ ವಾತ ಕೆ. ಕ್ಹುಕ್ಹೈ ಗಯಲ ಹಡ್ಕಾ, ಯಹೊವಾನಿ ವಾಕ್ಯಾ ಐಕೊ. <verse eid="EZK 37:4" /><verse number="5" style="v" sid="EZK 37:5" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ತುಮೊನೆ ಅಮ್ಮ ಕವಸ- ದೆಕೊ, ಮಿ ತುಮೊಮಾ ಶ್ವಾಸ ಆವಾಲಗಾಡುಸ; ತುಮೆ ಜಿವ್ತಾ ಥಾವೊಶಿ. <verse eid="EZK 37:5" /><verse number="6" style="v" sid="EZK 37:6" />ಮಿ ತುಮಾರಾ ಉಪ್ಪರ ನರ್ರೊನೆ ಆವಾ ಲಗಾಡಿನ, ಮಾಕ್ಹ ಆವಾ ಲಗಾಡಿನ, ಚಾ಼ಮ್ಡು ಆವಾ ಲಗಾಡಿನ, ತುಮೊಮಾ ಸ್ವಾಸ ಭರುಸ; ತೆಳಾಮಾ ತುಮೆ ಜಿವ್ತಾ ಥೈನ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತಿಳ್ದಿಲಿವೊಶಿ. <verse eid="EZK 37:6" /><verse number="7" style="v" sid="EZK 37:7" />ಮನೆ ಅಪ್ಪಣೆ ಥಯಲ ನಿಂಗತ ಮಿ ತೆ ಕ್ಹುದಾನಿ ವಾತ ಕತಾಕ್ಹು ಅವಾಜ಼ ಐಯು, ದೆಕೊ, ಟಕಟಕ ಕತಾ ಹಡ್ಕಾ ಹಡ್ಕಾವೊನೆ ಜು಼ಡ್ಯಾ. <verse eid="EZK 37:7" /><verse number="8" style="v" sid="EZK 37:8" />ಮಿ ದೆಕ್ತಾಮಾ ಆಹಾ, ತ್ಯುನಾ ಉಪ್ಪರ ನರ್ರೊ ಆಯಾ, ಮಾಕ್ಹ ಫೈಲಿ ಗಯು, ಉಪ್ಪರ ಪುರಾ ಚಾಮ್ಡು ಐಯು; ಉಸುಲ ನ್ಹೊತು. <verse eid="EZK 37:8" /><verse number="9" style="v" sid="EZK 37:9" />ತೆಳಾಮಾ ತೆ ಮನೆ- ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಶ್ವಾಸನೆ ಕೆ, ಕೆ; ಶ್ವಾಸ, ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ತು ಚಾರೆ ದಿಕ್ಕತಿ ಬಿಸಿನ ಮರಲ ಶರಿರೊ ಜಿವ್ತಾ ಥಯೆ ನಿಂಗತ ತ್ಯುನಾ ಉಪ್ಪರ ಫರ ಕೈನ ಉಸುಲನೆ ಕೆ.<verse eid="EZK 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 37:10" />ಕೈನ ಅಪ್ಪಣೆ ದೆತಾಮಾ ಮಿ ಅಪ್ಪಣೆ ನಿಂಗತ ಕದ್ಯೊ. ದೆಕ, ಶ್ವಾಸ ತ್ಯುನಾಮಾ ವ್ಹಕ್ಯು, ಜಿವ್ತಾ ಥಯಾ, ಪಗೊಕ್ಹು ಹುಬ್ರಯಾ, ಘನ್ನಿ ಮ್ಹೊಟಿ ಸೈನ್ಯ ಥಯು. <verse eid="EZK 37:10" /><verse number="11" style="v" sid="EZK 37:11" />ಪಾಚ಼ಲ್ತೊ ತೆ ಮನೆ ಅಮ್ಮ ಕದ್ಯೊ- ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಎ ಹಡ್ಕಾ ಇಸ್ರಾಯೆಲನಾ ಪುರಾ ವಂಶ ವ್ಹೈ; ದೆಕ, ತೆ ವಂಶವಾಲಾ- ಅಯ್ಯೊ, ಹಮಾರಾ ಹಡ್ಕಾ ವರೈ ಗಯಾ, ಹಮಾರಿ ನಿರಿಕ್ಷೆ ಹಾಳ ಥೈತಿ; ಹಮೆ ಬುಡನಾಶ ಥಯಾ ಕೈನ ತಿಳ್ದಿಲಿವಾಡಾಸ. <verse eid="EZK 37:11" /><verse number="12" style="v" sid="EZK 37:12" />ತಿನಾಹುತಿ ತು ಎ ಕ್ಹುದಾನಿ ವಾತ ತ್ಯುನೊನೆ ಕೆ- ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಮಾರಾ ಮನಕ್ಹೊ, ದೆಕೊ, ಮಿ ತುಮಾರಾ ಮಜಾ಼ರೊನೆ ಕಾಡಿನ ತಿಮಾತೊ ತುಮೊನೆ ಉಟಾಡಿನ ಇಸ್ರಾಯೆಲ ದೆಶನೆ ಮಳಾ ವರ್ಕ್ಹು ಕರುಸ. <verse eid="EZK 37:12" /><verse number="13" style="v" sid="EZK 37:13" />ಮಾರಾ ಮನಕ್ಹೊ, ಮಿ ತುಮಾರಾ ಮಜಾ಼ರೊನೆ ಕಾಡಿನ ತಿಮಾತೊ ತುಮೊನೆ ಉಟಾಡತಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತುಮೊನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 37:13" /><verse number="14" style="v" sid="EZK 37:14" />ಮಿ ಮಾರು ಶ್ವಾಸ ತುಮೊಮಾ ಜಾ಼ವಾ ಲಗಾಡಿನ ತುಮೊನೆ ಜ಼ಲಮ ವಚಾ಼ಡಿನ ತುಮಾರಾ ದೆಶಮಾ ಸೆಲಸುಸ; ತೆಳಾಮಾ ಯಹೊವಾ ಥಯಲ ಮಿಜ಼ ಎ ಕೈನ ಕರ‍್ಯೊಸ ಕೈನ ತಿಳ್ದಿಲಿವೊಶಿ; ಎ ಯಹೊವಾನಿ ವಿಚಾರ ವ್ಹೈ.<verse eid="EZK 37:14" /></para>
  <para style="s">ಇಸ್ರಾಯೆಲಬಿ ಯೆಹುದ ಯಕ್ಕಜ಼</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 37:15" />ಯಹೊವಾ ವರಿಯಕ್ಕ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ. <verse eid="EZK 37:15" /><verse number="16" style="v" sid="EZK 37:16" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಯಕ್ಕ ದಂಡ ಲಿನ ತಿಮಾ- ಯೆಹುದನು, ಯೆಹುದನೆ ಮಳಲ ಇಸ್ರಾಯೆಲನು ವ್ಹೈ ಕೈನ ಲಿಕ್ಕಿನ ವರಿಯಕ್ಕ ದಂಡ ಲಿನ ತಿಮಾ- ಯೊಸೆಫನು, ಎಫ್ರಾಯಿಮನು ಯೊಸೆಫನೆ ಮಳಲ ಕ್ಹಾರು ಇಸ್ರಾಯೆಲೊನು ವ್ಹೈ ಕೈನ ಲಿಕ್ಕ; <verse eid="EZK 37:16" /><verse number="17" style="v" sid="EZK 37:17" />ಪಾಚ಼ಲ್ತಾ ತೆ ತಾರಾ ಹತ್ಮಾ ಯಕ್ಕ ಥಾಯೆ ನಿಂಗತ ತೆ ಭಂಬಿನೆ ಯಕ್ಕನೆ ಯಕ್ಕ ಲಾಂಬಾ ಜೊಡಸಿನ ಧರ. <verse eid="EZK 37:17" /><verse number="18" style="v" sid="EZK 37:18" />ತಾರಾ ಮನಕ್ಹೊ - ಎ ಸುವೈ? ಹಮೊನೆ ತಿಳ್ಸಾತೊ ನೈ ಸು ಕೈನ ತುನೆ ಪುಚ಼ತಾಮಾ ತು ತ್ಯುನೊನೆ- <verse eid="EZK 37:18" /><verse number="19" style="v" sid="EZK 37:19" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ದೆಕ, ಎಫ್ರಾಯಿಮ ಧರ್xಯಲ ದಂಡನೆ ಕದ್ಯಾಮ ಯೊಸೆಫನು ವರಿ ಯೊಸೆಫನೆ ಮಳಲ ಇಸ್ರಾಯೆಲ ಕುಲನಾ ದಂಡನೆ ಮಿ ಕಾಡಿನ ಯೆಹುದನಾ ದಂಡನೆ ಲಾಂಬಾ ಮಳೈನ ತೆ ಭಂಬಿನೆ ಮಾರಾ ಹತ್ಮಾ ಯಕ್ಕಜ಼ ದಂಡ ಥೈನ ಧರುಸ ಕವಾನು ಕೆ. <verse eid="EZK 37:19" /><verse number="20" style="v" sid="EZK 37:20" />ಕತಾಮಾ ತು ನಾಮ ಲಿಕ್ಕಲ ದಂಡ ತ್ಯುನಾ ಡೊಳಾ ಕ್ಹಾಮಾ ತಾರಾ ಹತ್ಮಾ ರ‍್ಹವಾದೆ. <verse eid="EZK 37:20" /><verse number="21" style="v" sid="EZK 37:21" />ಎ ತ್ಯುನೊನೆ ಕೆ- ಕರ್ತಾ ಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ದೆಕ, ಇಸ್ರಾಯೆಲವಾಲಾ ವಶ ಥಯಲ ಜನಾಂಗೊಮಾತೊ ಮಿ ತ್ಯುನೊನೆ ಉದ್ದಾರ ಕರಿನ ಕ್ಹಾರಾ ಭನಿತಾಬಿ ಮಳೈನ ಸ್ವಂತ ದೆಶನೆ ಬಲೌಸ. <verse eid="EZK 37:21" /><verse number="22" style="v" sid="EZK 37:22" />ತ್ಯಾ ಇಸ್ರಾಯೆಲನಾ ಡೊಂಗರೊನಾ ಉಪ್ಪರ ಯಕ್ಕಜ಼ ಜನಾಂಗ ಥೈನ ಕರುಸ; ಯಕ್ಲೊಜ಼ ತ್ಯುನೊನೆ ಕ್ಹಾರಾವೊನೆ ರಾಜೊ಼ ಥೈನ ರ‍್ಹಸ; ತ್ಯುನೆ ಹಬ್ದಾ ಕೆಳಾಮಾಬಿ ಬೆ ಜನಾಂಗವಾಲಾ ಥೈನಬಿ ಭಾಗ ಥೈನ ರ‍್ಹತಾನೈ; <verse eid="EZK 37:22" /><verse number="23" style="v" sid="EZK 37:23" />ತ್ಯುನಾ ಮೊರ್ತಿಯೊಕ್ಹೊಬಿ ರ‍್ಹವಾದೆ ಅಸೈ ಸಾಮನೊಕ್ಹು ರ‍್ಹವಾದೆ ಕಯಾಬಿ ದುರಾಚಾರಕ್ಹುಬಿ ರ‍್ಹವಾದೆ ತ್ಯುನೊನೆ ಹಬ್ದಾ ಹೊಲೆಗೆಯ್ದಿ ಲೆತಾ ನೈ; ತ್ಯುನೆ ಪಾಪ ಕರಿ ಕರಿನ ಕ್ಹಾರಾ ದೆವದ್ರೊಹಕ್ಹು ಮಿ ತ್ಯುನೊನೆ ಛೊಡೈನ ಕರಿನ ಶುದ್ದ ಕರುಸ; ತ್ಯುನೆ ಮನೆ ಪ್ರಜೆ ಥೈನ ರ‍್ಹವಸ, ಮಿ ತ್ಯುನೊನೆ ಕ್ಹುದಾ ಥೈನ ರ‍್ಹೌಸ. <verse eid="EZK 37:23" /><verse number="24" style="v" sid="EZK 37:24" />ಮಾರೊ ಸೆವಕ ಥಯಲ ದಾವಿದ ತ್ಯುನೊನೆ ರಾಜೊ಼ ಥೈನ ರ‍್ಹವಸ; ತ್ಯುನೊನೆ ಕ್ಹಾರಾವೊನೆ ಯಕ್ಲೊಜ಼ ದೆಕ್ರಾಣಕಿ ಕರಾಲೊ ರ‍್ಹವಸ; ತ್ಯುನೆ ಮಾರಾ ನಿಯಮೊನೆ ಅನುಸರಸಿನ ಮಾರಾ ವಿದಿಯೊನೆ ಕೈದಿ ಲಿನ ಆಚರಣೆ ಕರಸ. <verse eid="EZK 37:24" /><verse number="25" style="v" sid="EZK 37:25" />ಮಾರೊ ಸೆವಕ ಥಯಲ ಯಾಕೊಬನೆ ಮಿ ದಿದಲ ದೆಶಮಾ ತ್ಯುನೆ ರ‍್ಹವಸ; ಹೊ ತುಮಾರಾ ಪಿತೃವೊ ರ‍್ಹಯಲ ದೆಶಮಾ ತ್ಯುನೆ ತ್ಯುನಾ ಸಂತಾನವಾಲಾ ತಲತಲಾಂತರ ಲಕ್ಕಾ ರ‍್ಹವಸ; ಮಾರೊ ಸೆವಕ ಥಯಲ ದಾವಿದ ತ್ಯುನೊನೆ ಹಮೆಶಾ ರಾಜೊ಼ ಥೈನ ರ‍್ಹವಸ. <verse eid="EZK 37:25" /><verse number="26" style="v" sid="EZK 37:26" />ವರಿ ಮಿ ತ್ಯುನಾ ಕ್ಹಾತೆ ಸಮಾಧಾನನು ಒಡಂಬಡಿಕೆ ಕರಿಲ್ಯುಸ; ತೆ ಹಮೆಶಾಬಿ ರ‍್ಹವಸ; ಮಿ ತ್ಯುನೊನೆ ನೆಲೆಗೊಳಸಿನ ವೃದ್ದಿ ಕರಿನ ಮಾರಾ ಪವಿತ್ರ ಆಲಯನೆ ತ್ಯುನಾ ವಚ್ಮಾ ಯುಗಯುಗಾಂತರ ಲಕ್ಕಾ ಹುಬ್ರಾಡುಸ. <verse eid="EZK 37:26" /><verse number="27" style="v" sid="EZK 37:27" />ಹೊ, ಮಾರು ರ‍್ಹವಾನು ಸ್ಥಾನ ತ್ಯುನಾ ವಚ್ಮಾ ರ‍್ಹವಸ; ಮಿ ತ್ಯುನೊನೆ ಕ್ಹುದಾ ಥೈನ ರ‍್ಹೌಸ, ತ್ಯುನೆ ಮನೆ ಪ್ರಜೆ ಥೈನ ರ‍್ಹವಸ. <verse eid="EZK 37:27" /><verse number="28" style="v" sid="EZK 37:28" />ಮಾರಿ ಪವಿತ್ರಾಲಯ ತ್ಯುನಾ ವಚ್ಮಾ ಹಮೆಶಾ ರ‍್ಹವಾನೆ ಇಸ್ರಾಯೆಲನೆ ಮಿಸಲ ಕರಿಲಿದಲವಾಲೊ ಯಹೊವಾ ಥಯಲ ಮಿಜ಼ ವ್ಹೈ ಕೈನ ಜನಾಂಗೊನೆ ಗ್ವತ್ತ ಥಾವಸ.<verse eid="EZK 37:28" /></para>
  <chapter eid="EZK 37" />
  <chapter number="38" style="c" sid="EZK 38" />
  <para style="s">ಗೊಗ ಕ್ಹುದಾನಿ ಅಸ್ತ್ರ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 38:1" />ಯಹೊವಾ ಎ ವಾಕ್ಯಾ ಮನೆ ದಿದ್ಯೊ <verse eid="EZK 38:1" /><verse number="2" style="v" sid="EZK 38:2" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಮೆಷೆಕವಾವೊನೆಬಿ ತುಬಲಿನವಾಲಾವೊನೆ ಆಳಾನಾ ಮಾಗೊಗ ದೆಶನಾ ರಾಜೊ಼ ಥಯಲ ಗೊಗನಕನ ಮ್ಹೊಡು ಕರಿನ ತಿನೆ ಎ ಕ್ಹುದಾನಿ ವಾತ ಕೆ. <verse eid="EZK 38:2" /><verse number="3" style="v" sid="EZK 38:3" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಮೆಷೆಕ ತುಬಲ ಜನಾಂಗೊನೊ ಪ್ರಭು ಥಯಲ ಗೊಗನ ಮಿ ತುನೆ ವಿರುದ್ದ ಥಯೊಸ. <verse eid="EZK 38:3" /><verse number="4" style="v" sid="EZK 38:4" />ತುನೆ ಫರಿನ ತಾರಾ ದಾಡನೆ ಕೊಂಕಿ ಘಾಲಿನ ಹೈಂ ಜಗ್ಗಿಲಿನ ಅಶ್ವಾರುಧವಾಲಾ ಕ್ಹೆಡ್ಯ ಜಾನವರೊ ಕುನ್ನಜ಼ ಚು಼ಕ್ಯಾವಾಚಿ ವಿಚಿತ್ರಾಂಬವಾಲಾ ಕ್ಹಡ್ಗಹಸ್ತವಾಲಾ ಥಯಲ ರಾಹುತರ ಮ್ಹೊಟಾ ತಂಡಕ್ಹು ಮಳಲ ತಾರಿ ಕ್ಹಾರಿ ಸೈನ್ಯನೆ, <verse eid="EZK 38:4" /><verse number="5" style="v" sid="EZK 38:5" />ಕುನ್ನಜ಼ ಚು಼ಕ್ಯಾವಾಚಿ ಖೆಡ್ಯಶಿರಸ್ತ್ರಾಣಧಾರಿ ಥಯಲ ಪಾರಸಿಯೊ ಕೊಷ್ಯವಾಲಾ ಪುಟ್ಯವಾಲಾ ತ್ಯುನಾ ಕ್ಹಾತೆ ಆಯಾ. <verse eid="EZK 38:5" /><verse number="6" style="v" sid="EZK 38:6" />ಇವ್ನೊನೆ ಕ್ಹಾರಿ ಬಗಲ್ತಾ ಥಯಲ ಗೊಮೆರ್ಯವಾಲಾವೊನೆ, ಉತ್ತರ ದಿಕ್ಕನಾ ಕಟ್ಟಕಡೆತಾ ಆಯಲ ಗುಮ್ಮಿಗುಮ್ಮಿ ಥಯಲ ತೊಗರ್ಮವಾಲಾವೊನೆ ಕಿಮ್ಮೆಬಿ ಘನ್ನಾತಿ ಘನ್ನಾ ಜನಾಂಗೊನೆ ತಾರಾ ಕ್ಹಾತೆ ಆವಾಲಗಾಡುಸ. <verse eid="EZK 38:6" /><verse number="7" style="v" sid="EZK 38:7" />ತಯ್ಯಾರ ರ‍್ಹೆ, ತುಕನ ಮಳಿನ ಆಯಲವಾಲಾ ಕ್ಹಾರಾ ತಂಡನಾ ಕ್ಹಾತೆ ತುನೆ ತಯ್ಯಾರ ಕರಿಲೆ; ತು ತ್ಯುನೊನೆ ಪಾಲಕ ಥೈನ ರ‍್ಹೆ. <verse eid="EZK 38:7" /><verse number="8" style="v" sid="EZK 38:8" />ಘನ್ನಾ ದಿನ್ನ ಥಯಲ್ಪರ ತುನೆ ಅಪ್ಪಣೆ ಥಾವಸ; ತಲ್ವಾರಕ್ಹು ನಾಶ ಥೈನ ಪುನರ್ಜಿವಿತ ಥಯಲ ದೆಶಮಾ ತು ಕಾಲಾನು ಕಾಲನೆ ವ್ಹಕ್ಕಿನ ಘನ್ನಾ ಜನಾಂಗೊಮಾತೊ ಒಟ್ಟಗುಡ್ಯಲ (ಮಾರಾ) ಮನಕ್ಹೊನಾ ಉಪ್ಪರ ಪಡಶಿ; ಹೊ, ಜನಾಂಗೊಮಾತೊ ಪಾರ ಥಯಲ ತೆ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಬಹುಕಾಲ ಹಾಳ ಥಯಲ ಇಸ್ರಾಯೆಲನಾ ಡೊಂಗರೊಮಾ ನೆಮ್ಮದಿ ಥೈನ ರ‍್ಹವಾಕ್ಹು ತು ತ್ಯುನಾ ಉಪ್ಪರ ಪಡಶಿ. <verse eid="EZK 38:8" /><verse number="9" style="v" sid="EZK 38:9" />ತು ತಾರಾ ಕ್ಹಾರಾ ಗುಮ್ಮಿಯೊ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಾನಾ ಘನ್ನಾ ಜನಾಂಗೊ ಬಿರುಗಾಳಿ ನಿಂಗತ ಐಪಡೊಶಿ; ಕಾರ್ಮುಗಿಲಿನೊ ಪಾದಿಮಾ ದೆಶನೆ ಝಾಕಿ ಪಡೊಶಿ. <verse eid="EZK 38:9" /><verse number="10" style="v" sid="EZK 38:10" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ತೆಳಾಮಾ ತಾರಾ ಮನಸಮಾ ವಿಚಾರೊ ಹುಟ್ಟಸ. <verse eid="EZK 38:10" /><verse number="11" style="v" sid="EZK 38:11" />ತು- ಆಹಾ, ಮಿ ಪೌಳಿಗೊಡಿ ನೈ ರ‍್ಹಯಲ ಕ್ಹೆಡಾ ಗಾಮೊ ಭರ್xಯಲ ದೆಶನೆ ವ್ಹಕ್ಕಿನ ಅಗಳಿ ಬಾಕಲ ಗೊಡಿಯೊ ನೈಸೊ ನೆಮ್ಮದಿಕ್ಹು ಭೆವಾಚಿ ರ‍್ಹಯಲವಾವೊನಾ ಉಪ್ಪರ ಪಡುಸ ಕೈನ ಕೈಲಿನ, <verse eid="EZK 38:11" /><verse number="12" style="v" sid="EZK 38:12" />ಸುಲಿಗೆ ಕರಿನ ಚೊ಼ರಿ ಕರು ಕೈನ ನಿರ್ಜನ ರ‍್ಹಯಲಕ್ಹು ಮನಕ್ಹೊ ಭರಿಗಯಲ ಜ಼ಗಾವೊನಾ ಉಪ್ಪರ ಹತ್ತ ಕರು ಕೈನಬಿ ಜನಾಂಗೊಮಾತೊ ಮಳಿನ ಭಯಲ ಎ ಕ್ಹಾರಿ ಆಸ್ತಿನೆ ಮಳೈಲಿನ ಲೊಕನಾ ವಚ್ನಾ ರ‍್ಹವಾಲಾವೊನೆ ಕಹಲಾಸ ಕರು ಕೈನಬಿ ವಿಚಾರ ಕರಶಿ. <verse eid="EZK 38:12" /><verse number="13" style="v" sid="EZK 38:13" />ಶೆಬೆದವಾಲಾ ದೆದಾನವಾಲಾ ತಾರ್ಷಿಷನಾ ವ್ಯಾಪಾರ ಕರಾಲಾ ತಿನಾ ಸಿಂಹಪ್ರಾಯವಾಲಾ ಕ್ಹಾರಾ ತುನೆ ದೆಕಿನ- ತು ಸುರೆ ಕರಾನೆ ಆಯೊಸ ಸು? ಚೊ಼ರಿ ಕರಿನ ಕ್ಹೊನು ರುಪ್ಪಾನೆ ಕಾಳ್ಳಿನ ಬೈಲೊ ವರಿ ಬಿಜಾ಼ ಸೊತ್ತನೆ ಅಪಹರಸಿನ ಆಯೊಸ ಸು ಕೈನ ಪುಚ್ಚಸ.<verse eid="EZK 38:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 38:14" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಗೊಗನೆ ಎ ಕ್ಹುದಾನಿ ವಾತ ಕೆ- ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಮಾರಾ ಮನಕ್ಹೊ ಥಯಲ ಇಸ್ರಾಯೆಲವಾಲಾ ನೆಮ್ಮದಿಕ್ಹು ರ‍್ಹವಾನಾ ಟೈಮಮಾ ತೆ ನೆಮ್ಮದಿ ತುನೆ ಗೊತ್ತ ಥಾವಸ ನೈ. <verse eid="EZK 38:14" /><verse number="15" style="v" sid="EZK 38:15" />ತು ತಾರಿ ಜ಼ಗಾನೆ ಛೊಡಿನ ಘೊಡಾನಾ ಸವಾರೊ ಮ್ಹೊಟಿ ಸೈನ್ಯ ಥೈನ ಗುಂಪ ಮಳಲ ಘನ್ನಾ ಜನಾಂಗೊನಾ ಕ್ಹಾತೆ ಉತ್ತರ ದಿಕ್ಕನಾ ಕಟ್ಟಕಡೆತೊ ಐನ. <verse eid="EZK 38:15" /><verse number="16" style="v" sid="EZK 38:16" />ಮಾರಾ ಮನಕ್ಹೊ ಥಯಲ ಇಸ್ರಾಯೆಲೊಪರ ಪಡಿನ ಕಾರ್ಮುಗಿಲಿನೊಪಾದಿಮಾ ದೆಶನೆ ಝಾಡಿ ಪಡಶಿ; ಎ, ಗೊಗ, ಜನಾಂಗೊನಾ ಡೊಳಾ ಕ್ಹಾಮಾ ತಾರಾ ನಾಶನಕ್ಹು ಮಾರಿ ಗೌರವ ವಚಾ಼ಡಿಲಿನ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ಜನಾಂಗೊನೆ ಗ್ವತ್ತ ಥಾಯೆ ನಿಂಗತ ಮಿ ತುನೆ ಟೈಮತೊ ಟೈಮಮಾ ಮಾರಾ ದೆಶನಾ ಉಪ್ಪರ ಪಡೆ ನಿಂಗತ ಕರುಸ. <verse eid="EZK 38:16" /><verse number="17" style="v" sid="EZK 38:17" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಮಾರಾ ಸೆವಕೊ ಥಯಲ ಇಸ್ರಾಯೆಲನಾ ಪ್ರವಾದಿಯೊ ಪೈಲಾನಾ ಕಾಲಮಾ ಘನ್ನಾ ವರಕ್ಹ ಪ್ರವಾದನೆ ಕರ್ತೊ ಮಿ ಯಕ್ಲಾನೆ ಇಸ್ರಾಯೆಲೊನಾ ಉಪ್ಪರ ಪಡೆ ನಿಂಗತ ಕರುಸ ಕೈನ ಅಗಾ ತಿಳ್ಸಾಯಾಸ ತೆಕ್ಲುಜ಼ ವ್ಹೈ. ಮಿ ತ್ಯುನಾ ಮುಲಕ ಅಗೊ ತಿಳ್ಸಾಯಲ ತುಜ಼ ನ್ಹವೈ ಸು.<verse eid="EZK 38:17" /></para>
  <para style="s">ಗೊಗನೆ ಕ್ಹುದಾನಿ ಶಿಕ್ಷಾ</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 38:18" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಗೊಗನ ಇಸ್ರಾಯೆಲ ದೆಶನಾ ಉಪ್ಪರ ಪಡಾನಾ ದಿನ್ನಮಾ ಮಿ ಘನ್ನೊ ಶಿಟ್ಟ ದೆಕಾಡಿನೆ ದ್ಯುಸ. <verse eid="EZK 38:18" /><verse number="19" style="v" sid="EZK 38:19" />ಮಿ ರೊಷಾವಿಷ್ಟ ಥೈನ ಶಿಟ್ಟಕ್ಹು ಬಳ್ತೊ ಇಮ್ಮ ಕದ್ಯೊಸ- ತೆ ದಿನ್ನಮಾ ಇಸ್ರಾಯೆಲ ದೆಶಮಾ ಅದ್ಭುತ ಕಾಪಾವರಕ್ಹು ಥಾವಸ ಕ್ಹರಿಬಿ; <verse eid="EZK 38:19" /><verse number="20" style="v" sid="EZK 38:20" />ಸಮುಂದರನಾ ಮಚ಼್ಲಿ಼ಯೊ ಹಬಾಳನ ಪಕ್ಷಿಯೊ ಭುಜಂತು ಜಿಮಿನಮಾ ಹರದಾಡಾಲಾ ಕ್ರಿಮಿ ಕಿಟ ಭಮಂಡಲನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಮಾರಾ ಕ್ಹಾಮಾ ಕಾಪಸ; ಡೊಂಗರೊ ಉಳ್ಳಿನ ಪಡಸ, ಜರಿಯೊ ಕವಚಿ ಲಿವಸ, ಕ್ಹಾರಾ ಗೊಡಿಯೊ ಜಿಮಿನನೆ ಲಾಗಿಜಾ಼ವಸ. <verse eid="EZK 38:20" /><verse number="21" style="v" sid="EZK 38:21" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ತಲ್ವಾರ ಮಾರಾ ಕ್ಹಾರಾ ಡೊಂಗರೊನೆ ಗೊಗವಾಲಾವೊನೆ ಕ್ಹಲಾಸ ಕರಾದೆ ಕೈನ ಅಪ್ಪಣೆ ದ್ಯುಸ; ಯಕ್ಕಕ್ಹು ಯಕ್ಕ ಕ್ಹಲಾಸ ಥಾವಸ. <verse eid="EZK 38:21" /><verse number="22" style="v" sid="EZK 38:22" />ಮಿ ಗೊಗನಾ ಕ್ಹಾತೆ ವ್ಯಾಜ್ಯ ಕರತೊ ತಿನೆ ರೊಗನೆಬಿ ಮಾರನೆಬಿ ಗುರಿ ಕರಿನ ತಿನಾ ಉಪ್ಪರಬಿ ತಿನಾ ಗುಮ್ಮಿಯೊನಾ ಉಪ್ಪರಬಿ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾನಾ ಘನ್ನಾ ಜನಾಂಗೊನಾ ಉಪ್ಪರಬಿ ಘನ್ನು ಪಾನಿ, ಮ್ಹೊಟಾ ಮ್ಹೊಟಾ ಘಾರ್ಗಿಯೊ, ಆಗ, ಗಂಧಕ, ಎ ಕ್ಹಾರು ಚು಼ವಾವುಸ. <verse eid="EZK 38:22" /><verse number="23" style="v" sid="EZK 38:23" />ಇಮ್ಮ ಮಿ ಮಾರಿ ಮಹಿಮಾನೆ ದೆಕಾಡಿನ ಮಾರಿ ಗೌರವನೆ ವಚಾ಼ಡಿಲಿನ ಘನ್ನಾ ಜನಾಂಗೊ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತಿಳ್ದಿ ಲಿಯೆ ನಿಂಗತ ತ್ಯುನಾ ಡೊಳಾ ಕ್ಹಾಮೊ ದಿಕ್ಹುಸ.<verse eid="EZK 38:23" /></para>
  <chapter eid="EZK 38" />
  <chapter number="39" style="c" sid="EZK 39" />
  <para style="s">ಗೊಗನಿ ಸೊಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 39:1" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಗೊಗನೆ ವಿರುದ್ದ ಥೈನ ಎ ಕ್ಹುದಾನಿ ವಾತ ಕೆ- ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಆಹಾ ಮೆಷೆಕ್ ತುಬಲ ಜನಾಂಗೊನೊ ಪ್ರಭು ಥಯಲ ಎ ಗೊಗ, <verse eid="EZK 39:1" /><verse number="2" style="v" sid="EZK 39:2" />ಮಿ ತುನೆ ವಿರುದ್ದ ಥೈನ ತುನೆ ಫರಿನ ಅಗೊ ಕರಿನ ಉತ್ತರ ದಿಕ್ಕತೊ ಬಲೈನ. ಇಸ್ರಾಯೆಲನಾ ಡೊಂಗರೊಪರ ಮೊಕ್ಲುಸ, <verse eid="EZK 39:2" /><verse number="3" style="v" sid="EZK 39:3" />ತಾರಾ ರೊಡ್ಡಾ ಹತ್ಮಾತೊ ಬಿಲ್ಲು ಬಾಣನೆ ತೊಡಿನ ತಾರಾ ಸಿದಾ ಹತ್ಮಾತೊ ಬಾಣೊನೆ ಉದ್ರಿಪಡುಸ. <verse eid="EZK 39:3" /><verse number="4" style="v" sid="EZK 39:4" />ತು ತಾರಾ ಕ್ಹಾರಾ ಸೈನ್ಯಾನೆ ತಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಾಲಾ ಜನಾಂಗೊ ಇಸ್ರಾಯೆಲನಾ ಡೊಂಗರೊಮಾ ಪಡಿ ಜಾ಼ವೊಶಿ; ಮಿ ತುಮೊನೆ ಮಾಕ್ಹ ಕ್ಹಾವಾನಾ ಬಿಜಾ಼ ಬಿಜಾ಼ ಪಕ್ಷಿಯೊನೆಬಿ ಭುಜಂತೊನೆಬಿ ಅನ್ನ ಕರುಸ; <verse eid="EZK 39:4" /><verse number="5" style="v" sid="EZK 39:5" />ತುಮೆ ಭಾರಾ ಪಡೊಶಿ; ಮಿಜ಼ ಅಪ್ಪಣೆ ದಿದ್ಯೊಸ್ತೊ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 39:5" /><verse number="6" style="v" sid="EZK 39:6" />ಮಿ ಮಾಗೊಗ ದೆಶನಾ ಉಪ್ಪರಬಿ ಕರಾವಳಿನಾ ಗಾಮೊಮಾ ನಿರಭಯ ಥೈನ ರ‍್ಹಯವಾಲಾವೊನಾ ಉಪ್ಪರಬಿಆಗನೆ ವಳೌಸ; ತೆಳಾಮಾ ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ ಕೈ ನ ತ್ಯುನೊನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 39:6" /><verse number="7" style="v" sid="EZK 39:7" />ಮಿ ಮಾರಾ ಪವಿತ್ರ ನಾಮನೆ ಮಾರಾ ಮನಕ್ಹೊ ಥಯಲ ಇಸ್ರಾಯೆಲೊನಾ ವಚ್ಮಾ ಪ್ರಕಟ ಕರುಸ, ತಿನೆ ಇತ್ತಿ ಉಪ್ಪರ ನಾಮ ಕೆಡ್ಸಾನು ಗುರಿ ನೈ ಕರ್ತೊ; ಮಿಜ಼ ಯಹೊವಾ ವ್ಹೈ, ಇಸ್ರಾಯೆಲನೊ ಪವಿತ್ರ ಕ್ಹುದಾ ವ್ಹೈ ಕೈನ ಜನಾಂಗೊಮಾ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 39:7" /><verse number="8" style="v" sid="EZK 39:8" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ದೆಕ ಐಯು, ಥಯು; ಮಿ ಪೈಲಾಜ಼ ಕದಲ ದಿನ್ನ ಎಜ಼ ವ್ಹೈ. <verse eid="EZK 39:8" /><verse number="9" style="v" sid="EZK 39:9" />ಇಸ್ರಾಯೆಲನಾ ಗಾಮೊನಾ ರ‍್ಹವಾಲಾ ಭಾರಾ ಐನ ಶತ್ರುನಾ ಆಯುಧೊನೆ ಆಗ ಲಗಾಡಿನ ಬಾಳಿ ಪಡುಸ; ಹೊ, ಕ್ಹೆಡ್ಯ, ಗುರಾಣಿ, ಬಿಲ್ಲೊ, ಬಾಣೊ, ಬಡ್ಡಾ, ಬರ್ಚಿಯೊ ಎ ಕ್ಹಾರು ಕ್ಹಾತ ವರಕ್ಹ ಲಕ್ಕಾ ಬಳ್ತಾಜ಼ ಆವಸ; <verse eid="EZK 39:9" /><verse number="10" style="v" sid="EZK 39:10" />ರಾನಮಾ ಲಾಕ್ಡಾ ಲೌನೈ ಲಾಗ್ತು, ಜಂಗಲಮಾ ಝಾಡನೆ ಕಾಟು ನೈ ಲಾಗ್ತು; ಆಯುಧೊನೆಜ಼ ಬಾಳಸ; ತ್ಯುನೊನೆ ಸುರೆ ಕರ್xಯಲವಾಲಾವೊನೆ ತ್ಯುನೆ ಕಾಳ್ಳಿವಸ, ತ್ಯುನೊನೆ ಚೊ಼ರಿ ಕರಲವಾಲಾವೊನೆ ತ್ಯುನೆ ಚೊ಼ರಿ ಕರಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 39:10" /></para>
  <para style="s">ಗೊಗನಿ ಸಮಾಧಿ ಕರಾನು</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 39:11" />ತೆ ದಿನ್ನಮಾ ಮಿ ಇಸ್ರಾಯೆಲಮಾ ಲವಣ ಸಮುಂದರನಾ ಪುರ್ವ ದಿಕ್ಕಮಾ ಜಾ಼ವಾಲಾವೊನಿ ವಾಟ ಥಯಲ ಕ್ಹಾಡಿನೆ ಗೊಗನೆ ಬುರಾನಿ ಜ಼ಗಾ ಥೈನ ಕರುಸ; ತ್ಯಾ ಪ್ರಯಾಣ ಕರಾನೆ ಥಾತು ನೈ; ತ್ಯಾಜ಼ ಗೊಗನೆ ತಿನಾ ಕ್ಹಾರಾ ಸಮುಹನೆ ಬುರಸ; ತೆ ಗೊಗನಾ ಸಮುಹನಿ ಕ್ಹಾಡಿ ಕವೈಲಿವಸ. <verse eid="EZK 39:11" /><verse number="12" style="v" sid="EZK 39:12" />ಇಸ್ರಾಯೆಲವಾಲಾ ದೆಶನೆ ಶುದ್ದ ಕರಾನಾಹುತಿ ಕ್ಹಾತ ಮ್ಹೈನಾ ತ್ಯುನೊನೆ ಬುರ್ತಾಜ಼ ರ‍್ಹವಸ. <verse eid="EZK 39:12" /><verse number="13" style="v" sid="EZK 39:13" />ದೆಶನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ತ್ಯುನೊನೆ ಬುರಿ ಪಡಸ; ಇಮ್ಮ ಮಿ ಮಶಹುರ ಥಾತಾಮಾ ಮಾರಾ ಮನಕ್ಹೊನೆ ನಾಮ ಉಚ್ಚು಼ ಥಾವಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 39:13" /><verse number="14" style="v" sid="EZK 39:14" />ಪಾಚ಼ಲ್ತಾ ತ್ಯುನೆ ದೆಶನೆ ಶುದ್ದಕರಾನೆ ಕರೆಟ್ಟ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಇನಿನ- ತುಮೆ ದೆಶಮಾ ಫರತಾ ಜಿಮಿನಪರ ಉಗ್ರಲ ಹಡ್ಕಾವೊನೆ ಬುರಿನ ಮ್ಹೆಲೊ ಕೈನ ನಿಯತ ಥೈನ ನೆಮಸಸ; ಕ್ಹಾತ ಮ್ಹೈನಾ ಥಯಲ ಬರೊಬ್ಬರ ಇವ್ನೆ ಎ ಹುಡ್ಕಾನು ಕಾಮಮಾ ಲಾಗಸ. <verse eid="EZK 39:14" /><verse number="15" style="v" sid="EZK 39:15" />ವಾಟೊಮಾ ಕುನ್ನಬಿ ರ‍್ಹವಾದೆ ಪ್ರಯಾಣ ಕರ್ತಾ ರ‍್ಹತಾಮಾ ಮನಕ್ಹೊನಾ ಹಡ್ಕಾ ದಿಕ್ಹ್ಯಮ ತ್ಯಾ ಯಕ್ಕ ಗುರುತನೆ ಹುಬ್ರಾಡಸ; ಬುರಿನ ಮ್ಹೆಲಾಲಾ ಗೊಗನಾ ಸಮುಹನಾ ತಗ್ಗಮಾ ತಿನೆ ಬುರೆ ಲಕ್ಕಾ ತೆ ಗುರುತ ತಿಮ್ಮಜ಼಼ ಹುಬ್ರಯಲ ರ‍್ಹವಸ. <verse eid="EZK 39:15" /><verse number="16" style="v" sid="EZK 39:16" />ತೆನೈಸೊ ಯಕ್ಕ ಗಾಮನೆ ಹೆಮೊನಪುರ ಕವಾನು ನಾಮ ಥಾವಸ. ಇಮ್ಮ ದೆಶನೆ ಶುದ್ದ ಕರಸ.<verse eid="EZK 39:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 39:17" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ಕ್ಹಾರಾ ತರಾನಾ ಪಕ್ಷಿಯೊನೆಬಿ ಕ್ಹಾರಾ ಭುಜಂತೊನೆಬಿ ಇಮ್ಮ ಕೆ- ತುಮೆ ಮಳಿನ ಆವೊ; ಮಿ ಇಸ್ರಾಯೆಲನಾ ಡೊಂಗರೊಪರ ತುಮಾರಾಹುತಿ ಕರಾನಿ ಮ್ಹೊಟಿ ಯಜ್ಞನೆ ಕ್ಹಾರಾ ಭನಿತಾ ಐನ ಮಾಕ್ಹನೆ ಕ್ಹೈನ ರಗತ ಪಿವೊ. <verse eid="EZK 39:17" /><verse number="18" style="v" sid="EZK 39:18" />ಟಗರ ಬಕ್ರು ಪಾಡೊ ಬಾಷಾನನಾ ಕೊಬ್ಬಲ ಜಾನವರೊ, ಕದ್ಯಾಮ ಬಲಿಷ್ಟೊ, ಭುಪತಿಯೊ ಇವ್ನು ಮಾಕ್ಹಬಿ ರಗತಬಿ ತುಮೊನೆ ಮಳಸ. <verse eid="EZK 39:18" /><verse number="19" style="v" sid="EZK 39:19" />ಮಿ ತುಮಾರಾಹುತಿ ಕ್ಹಲಾಸ ಕರಲ ಬಲಿ ದಿದಲ ಜಾನವರೊನಾ ಮಾಕ್ಹನೆ ಪೆಟ ಭರಿನ ಕ್ಹಾವೊಶಿ, ರಗತನೆ ಘುಂಗ ಥಯೆ ನಿಂಗತ ಪಿವೊಶಿ. <verse eid="EZK 39:19" /><verse number="20" style="v" sid="EZK 39:20" />ಮಿ ತಯ್ಯಾರ ಕರಾನಾ ತೆ ಕ್ಹೌಮಾ ಘೊಡಾ ಚ಼ಲಾವಾಲಾ ಕ್ಹಾರಾ ಶುರ ಬಿಜಾ಼ ಬಿಜಾ಼ ಸೈನಿಕೊ ಇವ್ನೊನೆ ಚಾ಼ಯೆ ಥಯಲ ತೆಕ್ಲು ಖಾವೊಸಿ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 39:20" /></para>
  <para style="s">ಇಸ್ರಾಯೆಲನೆ ಫರಿನ ಭಾಂದಾನು</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 39:21" />ಇಮ್ಮ ಮಿ ಜನಾಂಗೊನಾ ವಚ್ಮಾ ಮಾರಿ ಮಹಿಮಾ ಸ್ಥಾಪನೆ ಕರಾನೆ ತೆ ಸೈನಿಕೊನಾ ಉಪ್ಪರ ಹತ್ತ ಕರಿನ ನ್ಯಾಯ ದಂಡನೆ ಕರಾಲೊ ಮಿಜ಼ ವ್ಹೈ ಕವಾನು ತೆ ಕ್ಹಾರಾ ಜನಾಂಗೊನೆ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 39:21" /><verse number="22" style="v" sid="EZK 39:22" />ವರಿ ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾ ಮಿಜ಼ ತ್ಯುನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ತೆಳಾಮ್ತಾ ಕೆಳಾಮಾಬಿ ತಿಳ್ದಿಲಿವಸ. <verse eid="EZK 39:22" /><verse number="23" style="v" sid="EZK 39:23" />ಎನೈಸೊ ಇಸ್ರಾಯೆಲೊ ತ್ಯುನಾ ಅಧರ್ಮನಾ ನಿಮಿತಜ಼ ಸೆರೆ ಥೈನ ಗಯಾ ಕೈನಬಿ ತ್ಯುನೆ ದ್ರೊಹ ಕರಲಕ್ಹು ಮಿ ತ್ಯುನೊನೆ ವಿಮುಖ ಥೈನ ತ್ಯುನೆ ಕ್ಹಾರಾ ತಲ್ವಾರಕ್ಹು ಕ್ಹಲಾಸ ಥಯೆ ನಿಂಗತ ತ್ಯುನೊನೆ ದುಶ್ಮನೊನಾ ವಶ ಕರ‍್ಯೊ ಕವಾನು ಜನಾಂಗೊನೆ ಗ್ವತ್ತ ಥಾವಸ; <verse eid="EZK 39:23" /><verse number="24" style="v" sid="EZK 39:24" />ತ್ಯುನಾ ಹೊಲಸತನಾನೆಬಿ ಕೆಟ್ಟಕಾಮೊನೆಬಿ ತಕ್ಕ ಮಿ ತ್ಯುನೊನೆ ದಂಡಸಿನ ತ್ಯುನೊನೆ ವಿಮುಖ ಥಯೊ. <verse eid="EZK 39:24" /><verse number="25" style="v" sid="EZK 39:25" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಮಾರಾ ಪವಿತ್ರ ನಾಮನೆ ಹಬ್ದಾ ಅಪಕಿರ್ತಿ ಆಯೆ ನೈಸೊ ಮಿ ಹಮ್ನಾ ಆಗ್ರಹ ರ‍್ಹಯಲವಾಲೊ ಥೈನ ಯಾಕೊಬ್ಯವಾಲಾನಾ ಕೆಟ್ಟ ಸ್ಥಿತಿನೆ ಚು಼ಕೈನ ಇಸ್ರಾಯೆಲ ಕ್ಹಾರಾ ವಂಶವಾಲಾವೊನೆ ದಯಾ ದೆಕಾಡುಸ; <verse eid="EZK 39:25" /><verse number="26" style="v" sid="EZK 39:26" />ಮಿ ಮಾರಾ ಮನಕ್ಹೊನೆ ಬಿಜಾ಼ ಜನಾಂಗೊನಾ ವಶಮಾತೊ ವಚಾ಼ಡಿನ ತೆ ಶತ್ರುವೊನಾ ದೆಶತೊ ಮಳೈನ ಘನ್ನಾ ಜನಾಂಗೊನಾ ಡೊಳಾಕ್ಹಾಮಾ ತ್ಯುನಾ ರಕ್ಷಣೆನಾ ಮುಲಕ ಮಾರಿ ಮರ್ಯಾದಿನೆ ವಚಾ಼ಡಿ ಲಿನ ಪಾಚ಼ಲ್ತೊ. <verse eid="EZK 39:26" /><verse number="27" style="v" sid="EZK 39:27" />ಮಿ ಮಾರಾ ಮನಕ್ಹೊನೆ ಬಿಜಾ಼ ದೆಶೊತೊ ವಾಪಾಸ ಲೌಸ ಮಿ ತ್ಯುನಾ ದುಶ್ನೊನಾ ದೆಶತೊ ಮಲೌಸ ತೆಳಾಮಾ ಘನ್ನಾ ದೆಶವಾಲಾ ಮಿ ಕೆಕ್ಲೊ ಪವಿತ್ರ ವ್ಹೈ ಕೈನ ಗ್ವತ್ತ ಥಾವಸ. <verse eid="EZK 39:27" /><verse number="28" style="v" sid="EZK 39:28" />ಮಿ ತ್ಯುನೊನೆ ಜನಾಂಗೊಮಾತೊ ಸೆರೆ ಗಯೆ ನಿಂಗತ ಕರಿನ ಪಾಚ಼ಲ್ತೊ ಮಳೈನ ಸ್ವಂತ ದೆಶನೆ ಲಾಯಲಕ್ಹು ಮಿಜ಼ ತ್ಯುನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ವ್ಹೈ ಕೈನ ದೃಡ ಕರಿಲಿವಸ. ತ್ಯುನೊಮಾ ಕಿನೆಜ಼ ಸೆರೆಮಾ ನೈ ಛೊಡತೊ. <verse eid="EZK 39:28" /><verse number="29" style="v" sid="EZK 39:29" />ಹಬ್ದಾ ಕೆಳಾಮಾಜ಼ ತ್ಯುನೊನೆ ಮ್ಹೊಡು ಫರಾತೊ ಸನೈ ಥಾತೊ; ಇಸ್ರಾಯೆಲ ವಂಶನ ಉಪ್ಪರ ಮಾರಿ ಆತ್ಮಾನೆ ಸುರಸಾಯೊಸ ತೆಕ್ಲುಜ಼; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 39:29" /></para>
  <chapter eid="EZK 39" />
  <chapter number="40" style="c" sid="EZK 40" />
  <para style="s">ಯೆಜೆಕೆಲನೆ ಯೆರುಸೆಲಿಮನೆ ಲಿನ ಗಯಲ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 40:1" />ಹಮೆ ಸೆರೆ ಥಯಲ ಪಚ್ಚಕ್ಹವಾ ವರಕ್ಹನಾ ಕದ್ಯಾಮ ಗಾಮ ಹಾಳ ಥೈನ ಚೌದಾವಾ ವರಕ್ಹನಾ ಯಕ್ವಾ ಮ್ಹೈನಾನಾ ದಕ್ಹವಾ ದಿನ್ನಮಾ, ಹೊ, ತೆಜ಼ ದಿನ್ನಮಾ ಮಿ ಯಹೊವಾನು ಹತ್ತ ಮ್ಹೆಲಲ ಹುತಿ ಕ್ಹುದಾನಿ ತಾಕತ ಮಾರಾಮಾ ಐನ ತೆ ಮನೆ ತ್ಯಾ ಲಿನ ಗಯೊ. <verse eid="EZK 40:1" /><verse number="2" style="v" sid="EZK 40:2" />ತೆ ಮನೆ ಇಸ್ರಾಯೆಲ ದೆಶನೆ ಲೈನ ಅತ್ಯುನ್ನತ ಡೊಂಗರಪರ ಉತಾರ್ಯೊಸ ಕೈನ ಕ್ಹುದಾನಾ ದರ್ಶನಮಾ ಮನೆ ದಿಕ್ಹಿನ ಐಯು. ದಕ್ಷಿಣ ಬಗಲ ತೆ ಡೊಂಗರನಾ ಉಪ್ಪರ ಗಾಮ ನಿಂಗತ ರ‍್ಹವಾನು ಯಕ್ಕ ಘರ ದಿಕ್ಹ್ಯು. <verse eid="EZK 40:2" /><verse number="3" style="v" sid="EZK 40:3" />ತೆ ಮನೆ ತ್ಯಾ ಲಾವಾನೆ ದೆಕ, ತಾಂಬಾ ನಿಂಗತ ಚಮ್ಕಾನೊ ಯಕ್ಕ ಮನಕ್ಹ ಕಿಮ್ಮತನಿ ಹುರಿ ಹುರಿನೆ ಅಳತಿನಿ ಲಾಕಡಿ ಹತ್ತಮಾ ಧರಿಲಿನ ಬಾಕಲಮಾ ಹುಬ್ರಯೊತೊ. <verse eid="EZK 40:3" /><verse number="4" style="v" sid="EZK 40:4" />ತೆ ಮನಕ್ಹ ಮನೆ - ಮನಕ್ಹನಾ ದಿಕ್ರಾ, ತು ಡೊಳಾ ಘಾಲಿನ ದೆಕ, ಕಾನ ದಿನ ಐಕ; ಮಿ ತುನೆ ದೆಕಾಡಾನು ಕ್ಹಾರು ಮನಸ್ಸಮಾ ತಿಳ್ದಿಲೆ; ಮಿ ತುನೆ ದೆಕಡಾನು ತು ದೆಕುಜ಼ ಕೈನ ನ್ಹ್ಯಾ ಲಾಯಲ ವ್ಹೈ; ತು ದೆಕಲ ಕ್ಹಾರು ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾವೊನೆ ಪ್ರಕಟ ಕರು ಕೈನ ಕದ್ಯೊ. <verse eid="EZK 40:4" /><verse number="5" style="v" sid="EZK 40:5" />ದೆಕ, ಯಕ್ಕ ಗೊಡಿ ತೆ ಘರನೆ ಸುತ್ತಿಲಿದ್ಯು; ತೆ ಮನಕ್ಹನಾ ಹತ್ಮಾ 3 ಹತ್ತ ಲಾಂಬು ಅಳತಿಕೊಲ ವ್ಹತ್ತು. ತೆ ಗೊಡಿನೆ ಜಾ಼ಡು ಯಕ್ಕ ಲಾಕಡು, ಉಚ್ಚು ಯಕ್ಕ ಲಾಕ್ಡು ಅಳತಿ ಕರ‍್ಯೊ. <verse eid="EZK 40:5" /><verse number="6" style="v" sid="EZK 40:6" />ಪಾಚಲ್ತೊ ತೆ ಪುರ್ವನಾ ಹೆಬ್ಬಾಗಿಲನೆ ಐನ ಪೊಟಂಗ್ಯೊ ಚ಼ಡಿನ ಹೊಚ಼ಲನಿ ರುಂದನೆ ಯಕ್ಕ ಲಾಕ್ಡು ಅಳತಿ ಕರ‍್ಯೊ. ಯಕ್ಕೆಕ ಹೊಚ಼ಲನು ರುಂದನೆ ಯಕ್ಕೆಕ ಲಾಕ್ಡು ವ್ಹತ್ತು. <verse eid="EZK 40:6" /><verse number="7" style="v" sid="EZK 40:7" />ತ್ಯಾ ಗೊಡಿಮಾ ರ‍್ಹಯಲ ಯಕ್ಕೆಕ ಕ್ಹೊಲಿನು ಲಾಂಬು ಯಕ್ಕ ಲಾಕ್ಡು, ರುಂದ ಯಕ್ಕ ಲಾಕ್ಡು; ದಿವಸ್ತಾನನಾ ಕ್ಹಾಮು ಮ್ಹೊಟು ಬಾಕಲ ತಿನಾ ಕ್ಹಾಮು ವ್ಹಚ಼ಲ ಲಾಂಬಾಮಾ ಯಕ್ಕ ಲಾಕಡಿ ವ್ಹತಿ ತೆ ಕೊಲಿಯೊ ಯಕ್ಕೆಕ 5 ಹತೊ ಲಾಂಬಾಮ ವ್ಹತಾ ದಿವಸ್ತಾನ <verse eid="EZK 40:7" /><verse number="8" style="v" sid="EZK 40:8" />ತೆ ಗೊಡಿನಾ ಕೊಣಾ ಯಕ್ಕನೆ ಯಕ್ಕ ಪಾಂಚ಼-ಪಾಂಚ಼ ಮಾರ ದುರ ವ್ಹತ್ತಾ; ದೆವಸ್ಥಾನನೆ ಕ್ಹಾಮು ಹೆಬ್ಬಾಗಿಲ ಕೈಸಾಲೆನಾ ಹೊಚ಼ಲನಾ ರುಂದ ಯಕ್ಕ ಲಾಕ್ಡು ವ್ಹತ್ತು. <verse eid="EZK 40:8" /><verse number="9" style="v" sid="EZK 40:9" />ಪಾಚ಼ಲ್ತೊ ತೆ ಹೆಬ್ಬಾಗಿಲ ಕೈಸಾಲೆನಾ ರುಂದನೆ ಅಳತಿ ಕರ‍್ಯೊ; ತೆ 4 ಹತ್ತ ವ್ಹತ್ತು; ಕ್ಹಾಮೊನು ರುಂದ 1-1 ಹತ್ತ ವ್ಹತ್ತು; ಹೆಬ್ಬಾಗಿಲ ಕೈಸಾಲೆ ದೆವಸ್ಥಾನನಾ ಕ್ಹಾಮು ವ್ಹತ್ತು. <verse eid="EZK 40:9" /><verse number="10" style="v" sid="EZK 40:10" />ಪುರ್ವನು ಹೆಬ್ಬಾಗಿಲನಾ ಬೆ ಜ಼ಗಾ ತನ್ನ ತನ್ನ ಗೊಡಿನಾ ಕೊಣಿಯೊ ವ್ಹತ್ತಾ; ತೆ ಕ್ಹಾರು ಯಕ್ಕಜ಼ ಅಳತಿನು ವ್ಹತ್ತು; ಬೆ ಜ಼ಗಾನಾ ನಿಲವುಕಂಬಾ ಯಕ್ಕಜ಼ ಅಳತಿನಾ ವ್ಹತ್ತಾ.<verse eid="EZK 40:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 40:11" />ಪಾಚ಼ಲ್ತೊ ತೆ ಹೆಬ್ಬಾಗಿಲನಾ ದ್ವಾರನೆ ಅಳತಿ ಕರ‍್ಯೊ; ರುಂದಮಾ 5 ಹತ್ತ ವ್ಹತ್ತು; ಲಾಂಬಾಮಾ 7 ಹತ್ತ ವ್ಹತ್ತಾ. <verse eid="EZK 40:11" /><verse number="12" style="v" sid="EZK 40:12" />ಬೆ ಜ಼ಗಾಮಾ ಗೊಡಿನಾ ಕೊಣಿಯೊನಾ ಕ್ಹಾಮಾ ಅರ್ದಾಲೊ ವ್ಹತ್ತು. ಅವಕಾಶ ವ್ಹತ್ತು; ಭಂಬಿ ಬನಿನಾ ಗೊಡಿನಾ ಕೊಣಿಯೊನು ರುಂದ 3-3 ಹತ್ತ ವ್ಹತ್ತು. <verse eid="EZK 40:12" /><verse number="13" style="v" sid="EZK 40:13" />ತೆ ಯಕ್ಕ ಬನಿನಾ ಗೊಡಿನಾ ಕೊಣಿನಾ ಮಾಳಗಿನಾ ಭರ್ಲ್ಯಾ ಕೊಣಾನೆ ಕದ್ಯಾಮ (ಯಕ್ಕ ಕೊಣಿನಾ) ಬಾಕಲತಾ (ವರಿಯಕ್ಕ ಕೊಣಿನಾ) ಬಾಕಲನೆ ಹೆಬ್ಬಾಗಿನಾ ರುಂದನೆ ಅಳತಿ ಕರ್ತಾಮಾ ಕ್ಹಡಾ ಬಾರಾ ಹತ್ತ ವ್ಹತಾ. <verse eid="EZK 40:13" /><verse number="14" style="v" sid="EZK 40:14" />ಪ್ರಾಕಾರಮಾನಾ ನಿಲವುಕಂಬಾ ಲಕ್ಕಾ ನಿಲವುಕಂಬಾನಾ ಅಳತಿ ಕರ್ತಾಮಾ 30 ಹತೊ ವ್ಹತ್ತಾ; ಹೆಬ್ಬಾಗಿನೆ ಸುತ್ತ ಮುತ್ತ ಅಳತಿ ಕರ್ಯೊ. <verse eid="EZK 40:14" /><verse number="15" style="v" sid="EZK 40:15" />ಪ್ರವೆಶ ಸ್ಥಾನನಾ ಭಾರಾತಾ ಮ್ಹೈನಾ ಕೈಸಾಲೆನಾ ಲಾಸ್ಟ ಲಕ್ಕಾ ಹೆಬ್ಬಾಗಿಲ 25 ಹತ್ತ ಲಾಂಬು ವ್ಹತ್ತು. <verse eid="EZK 40:15" /><verse number="16" style="v" sid="EZK 40:16" />ಗೊಡಿನಾ ಕೊಣಿಯೊಮಾ ಮ್ಹೈನಾ ಭಂಬಿ ಬನಿನಾ ನಿಲವು ಖಂಬಾವೊಮಾ ಕೈಸಾಲೆಯೊಮಾ ನೈ ಕಾಡಾನಾ ಕಿಡಕಿಯೊ ಹೆಬ್ಬಾಗಿಲಮಾ ಸುತ್ತ ಮುತ್ತ ವ್ಹತ್ತಾ; (ಭಾರ್ಲ್ಯಾ) ನಿಲವು ಖಂಬಾವೊಮಾ ಕರ್ಜುರನಾ ಝಾಡೊ ಚಿತ್ರಾ ಕರಲ ವ್ಹತ್ತಾ.<verse eid="EZK 40:16" /></para>
  <para style="s">ಭಾರ್ಲ್ಯು ಅಂಗ್ಳಾ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 40:17" />ಪಾಚ಼ಲ್ತೊ ತೆ ಮನೆ ಭಾರ್ಲ್ಯು ಪ್ರಾಕಾರ ಕನ ಲಾಯೊ; ದೆಕ, ಕ್ಹೊಲಿಯೊ ಪ್ರಾಕಾರನಾ ಸುತ್ತೆ ಘಾಲನ ನೆಲಗಟ್ಟ ದೆಕ್ಹ್ಯಾ; ಮಳಿನ ನೆಲಗಟ್ಟನಾ ಉಪ್ಪರ ಮುವ್ವತ ಕ್ಹೊಲಿಯೊ ವ್ಹತ್ತಾ. <verse eid="EZK 40:17" /><verse number="18" style="v" sid="EZK 40:18" />ತೆ ಹೆಟಲ್ಯಾ ನೆಲಗಟ್ಟ ಹೆಬ್ಬಾಗಿನಾ ಭಂಬಿ ಜ಼ಗಾ ವಚಾ಼ಯಲ ತ್ಯುನಾ ಅಕ್ಲಾ ರುಂದ ವ್ಹತ್ತಾ. <verse eid="EZK 40:18" /><verse number="19" style="v" sid="EZK 40:19" />ತೆ ಪುರ್ವಮಾಬಿ ಪಚ್ಚಿಮಮಾಬಿ ಹೆಟಲ್ಯಾ ಹೆಬ್ಬಾಗಿಲನಾ ಮ್ಹೈತಾ ಮ್ಹೈನಾ ಪ್ರಾಕಾರನಾ ಭಾರಾ ಲಕ್ಕಾ ಅಳತಿ ಕರ್ತಾಮಾ ಐವತ್ತ ಹತ್ತ ಯಕ್ಲು ವ್ಹತ್ತು. <verse eid="EZK 40:19" /><verse number="20" style="v" sid="EZK 40:20" />ಎ ನೈಸೊ ಭಾರ್ಲ್ಯು ಪ್ರಾಕಾರನಾ ಉತ್ತರನು ಹೆಬ್ಬಾಗಿಲನು ರುಂದನೆ ಲಾಂಬಾನೆ ಅಳತಿ ಕರ‍್ಯೊ. <verse eid="EZK 40:20" /><verse number="21" style="v" sid="EZK 40:21" />ತಿಮಾ ಭಂಬಿ ಬನಿ ಗೊಡಿನಾ ಕೊಣಿಯೊ ತನ್ನ ತನ್ನ ವ್ಹತ್ತಾ; ತ್ಯಾನಾ ನಿಲವು ಕಂಬಾ ಕೈಸಾಲೆನಿ ಪಸ್ಟನಾ ಹೆಬಾಗಿಲನಾ ಅಳತಿ ನಿಂಗತ ವ್ಹತ್ತಾ; ತೆ ಹೆಬ್ಬಾಗಿಲನು ಲಾಂಬು ಪಚ್ಚಕ್ಹ ಹತ್ತ ವ್ಹತ್ತು. ರುಂದಮಾ ಕ್ಹಡಾ ಬಾರಾ ಹತೊ ವ್ಹತಾ. <verse eid="EZK 40:21" /><verse number="22" style="v" sid="EZK 40:22" />ತ್ಯಾನಾ ಕಿಡಕಿಯೊ ಕೈಸಾಲೆ ಚಿತ್ರಿತ ಥಯಲ ಕರ್ಜುರನಾ ಝಾಡೊ ಪುರ್ವ ಹೆಬ್ಬಾಗಿಲನಾ ಅಳತಿ ಅಕ್ಲಾ ವ್ಹತ್ತಾ; ಕ್ಹಾತ ಪೊಟಂಗ್ಯೊ ಚ಼ಡಿನ ತ್ಯಾ ಚಾ಼ಲ್ಯಾತಾ; ಕೈಸಾಲೆ ಮ್ಹೈ ವ್ಹತ್ತು. <verse eid="EZK 40:22" /><verse number="23" style="v" sid="EZK 40:23" />ಭಾರ್ಲ್ಯು ಪ್ರಾಕಾರನಾ ಪಚ್ಚಿಮ ಪುರ್ವ ಹೆಬ್ಬಾಗಿಲೊನಾ ಕ್ಹಾಮಾ ಮ್ಹೈನಾ ಪ್ರಾಕಾರನೆಬಿ ಹೆಬ್ಬಾಗಿಲೊ ವ್ಹತ್ತಾ; ಯಕ್ಕ ಬಾಕಲತಾ ಬಿಜೆಕ್ಕ ಬಾಕಲನೆ ಐವತ್ತ ಹತೊ ಅಳತಿ ಕರ‍್ಯೊ.<verse eid="EZK 40:23" /></para>
  <para style="s">ದಕ್ಷಿಣನು ಬಾಕಲ</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 40:24" />ಪಾಚಾ಼ಲ್ತೊ ತೆ ಮನೆ ದಕ್ಷಿಣನೆ ಬಲೈಲಿನ ಆಯೊ. ದೆಕ, ತ್ಯಾ ಯಕ್ಕ ಹೆಬ್ಬಾಗಿಲ ಛೆ; ತೆ ತ್ಯಾನಾ ನಿಲವುಖಂಬಾವೊನೆ ಕೈಸಾಲೆನೆ ಅಳತಿ ಕರ್ತಾಮಾ ಪಾಚ಼ಲ್ಯಾ ಅಳತಿಯೊಜ಼ ದಿಕ್ಹಿನ ಆಯಾ. <verse eid="EZK 40:24" /><verse number="25" style="v" sid="EZK 40:25" />ತಿಮಾಬಿ ತಿನಾ ಕೈಸಾಲೆಮಾಬಿ ಕ್ಹಾರಾ ಬನಿ ತ್ಯವಾ ಕಿಡಕಿಯೊ ವ್ಹತ್ತಾ; ಹೆಬ್ಬಾಗಿಲನು ಲಾಂಬು ಪಚ್ಚಕ್ಹ ಹತೊ, ರುಂದ ಕ್ಹಡಾಬಾರಾ ಹತ್ತ ವ್ಹತ್ತು. <verse eid="EZK 40:25" /><verse number="26" style="v" sid="EZK 40:26" />ತ್ಯಾ ಚ಼ಡಾನೆ ಕ್ಹಾತ ಪೊಟಂಗ್ಯೊ ವ್ಹತ್ತಿಯೊ; ಕೈಸಾಲೆ ಮ್ಹೈ ವ್ಹತ್ತು; ಕೈಸಾಲೆನಾ ಇದ್ರಾ ಬದರ ನಿಲವು ಖಂಬಾವೊಮಾ ಕರ್ಜುರನಾ ಝಾಡೊ ಚಿತ್ರಿತ ಥಯಾತಾ. <verse eid="EZK 40:26" /><verse number="27" style="v" sid="EZK 40:27" />ಮ್ಹೈನಾ ಪ್ರಾಕಾರಮಾಬಿ ದಕ್ಷಿಣನೆ ಹೆಬ್ಬಾಗಿಲ ವ್ಹತ್ತು; ದಕ್ಷಿಣಮಾ ಯಕ್ಕ ಬಾಕಲತಾ ಕ್ಹಾಮಲ್ಯಾ ಬಲನೆ ಕ್ಹೊ ಹತ್ತ ಅಳತಿ ಕರ‍್ಯೊ.<verse eid="EZK 40:27" /></para>
  <para style="s">ಮ್ಹೈನಿ ಅಂಗ್ಳಾ</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 40:28" />ಪಾಚ಼ಲ್ತೊ ತೆ ಮನೆ ದಕ್ಷಿಣನು ಬಾಕಲನಾ ವಾಟತೊ ಮ್ಹೈನಾ ಪ್ರಾಕಾರನೆ ಬಲೈಲಿನ ಆಯೊ; ತೆ ಪಶ್ಚಿಮ ಹೆಬ್ಬಾಗಿಲನೆ ತ್ಯಾನಾ ಗೊಡಿನಾ ಕೊಣಿಯೊ, ನಿಲವುಕಂಬ, ಕೈಸಾಲೆ ಎ ಕ್ಹಾರು ಅಳತಿ ಕರ್ತಾಮಾ ತೆಕ್ಲಾಜ಼ ಅಳತಿ ವ್ಹತ್ತಾ; <verse eid="EZK 40:28" /><verse number="29" style="v" sid="EZK 40:29" />ತಿಮಾಬಿ ತಿನಾ ಕೈಸಾಲೆಮಾಬಿ ಕಿಡಕಿಯೊ ಕ್ಹಾರಾ ಬನಿ ವ್ಹತ್ತಾ; ಹೆಬ್ಬಾಗಿಲ ಲಾಂಬಾಮಾ ಐವತ್ತ ಹತೊ ವ್ಹತಾ, ರುಂದಮಾ ಪಚ್ಚಕ್ಹ ಹತ್ತೊ ವ್ಹತ್ತಾ. <verse eid="EZK 40:29" /><verse number="30" style="v" sid="EZK 40:30" />ಸುತ್ತ ಮುತ್ತ ಕೈಸಾಲಿ ವ್ಹತ್ತಾ; ಯಕ್ಕೆಕ ಲಾಂಬಾಮಾ ಪಚ್ಚಕ್ಹ ಹತೊ, ರುಂದಮಾ ಪಾಂಚ಼ ಹತೊ ವ್ಹತಾ. <verse eid="EZK 40:30" /><verse number="31" style="v" sid="EZK 40:31" />ತೆ ಹೆಬ್ಬಗಿಲ ಕೈಸಾಲೆ ಭಾರಲ್ಯಾ ಪ್ರಾಕಾರನೆ ಅಭಿಮುಖ ವ್ಹತ್ತಾ; ತಿನಾ ನಿಲವು ಖಂಬಾವೊಮಾ ಕರ್ಜುರನಾ ಝಾಡೊ ಚಿತ್ರಿತ ಥಯಾತಾ; ತ್ಯಾ ಚ಼ಡಾನೆ ಆಟ ಪೊಟಂಗ್ಯೊ ವ್ಹತ್ತಾ.<verse eid="EZK 40:31" /></para>
  <para style="s">ಪುರ್ವ ಬಗಲನಿ ಅಂಗ್ಳಾ</para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 40:32" />ತೆನೆ ಮ್ಹೈನಾ ದ್ರಾಕಾರನಾ ಪುರ್ವನೆ ಬಲೈ ಲೈನ ತ್ಯಾನಾ ಹೆಬ್ಬಾಗಿನೆ ತಿನಾ ಗೊಡಿನಾ ಕೊಣಿಯೊ, ನಿಲವುಕಂಬ, ಕೈಸಾಲೆ ಎ ಕ್ಹಾರು ಅಳತಿ ಕರ್ತಾಮಾ ತೆ ಅಳತಿಜ಼ ದಿಕ್ಹಿನ ಆಯಾ; <verse eid="EZK 40:32" /><verse number="33" style="v" sid="EZK 40:33" />ತಿಮಾಬಿ ತಿನಾ ಕೈಸಾಲೆಮಾಬಿ ಕ್ಹಾರಾ ಬನಿ ಕಿಡಕಿಯೊ ವ್ಹತ್ತಿಯೊ; ತೆ ಹೆಬ್ಬಾಗಿಲ ಲಾಂಬಾಮಾ ಪಚ್ಚಕ್ಹ ಹತೊ ವ್ಹತಾ. ರುಂದಮಾ ಕ್ಹಡಾ ಬಾರಾ ಹತೊ ವ್ಹತಾ. <verse eid="EZK 40:33" /><verse number="34" style="v" sid="EZK 40:34" />ತಿನು ಕೈಸಾಲೆ ಭಾರ್ಲ್ಯಾ ಪ್ರಾಕಾರನೆ ಅಭಿಮುಖ ವ್ಹತ್ತು; ಕೈಸಾಲೆನಾ ಎದುರಾ ಬದುರನಾ ನಿಲವು ಖಂಬಾವೊಮಾ ಕರ್ಜುರನಾ ಝಾಡೊ ಚಿತ್ರಿತ ವ್ಹತ್ತಾ; ತ್ಯಾ ಚ಼ಡಾನೆ ಆಟ ಪೊಟಂಗ್ಯೊ ವ್ಹತ್ತಾ.<verse eid="EZK 40:34" /></para>
  <para style="s">ಉತ್ತರ ಬಾಕಲನು ಮ್ಹೈನು ಭಾಗ</para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 40:35" />ಪಾಚ಼ಲ್ತೊ ತೆ ಮನೆ ಪಚ್ಚಿಮನಾ ಬಾಕಲೆ ಬಲೈಲಿನ ಗೈನ ತಿನೆ ತಿನಾ ಗೊಡಿನಾ ಕೊಣೆ, ನಿಲವು ಕಂಬಾ, ಕೈಸಾಲೆ ಎ ಕ್ಹಾರು ಅಳತಿ ಕರ್ತಾಮಾ ತ್ಯಾಬಿ ತೆ ಅಳತಿಜ಼ ದಿಕ್ಹಿನ ಐಯು; <verse eid="EZK 40:35" /><verse number="36" style="v" sid="EZK 40:36" />ತಿಮಾ ಕ್ಹಾರಾ ಬನಿ ಕಿಡಕಿಯೊ ವ್ಹತ್ತಿಯೊ; ತೆ ಲಾಂಬಾಮಾ ಐವತ್ತ ಹತ್ತ, ರುಂದಮಾ ಪಚ್ಚಕ್ಹ ಹತ್ತ ವ್ಹತ್ತು. <verse eid="EZK 40:36" /><verse number="37" style="v" sid="EZK 40:37" />ತಿನಾ ನಿಲವುಕಂಬಾ ಭಾರ್ಲ್ಯಾ ಪ್ರಾಕಾರನೆ ಅಭಿಮುಖ ಥೈನ ವ್ಹತ್ತಾ; ತ್ಯಾ ಚ಼ಡಾನೆ ಆಟ ಪೊಟಂಗ್ಯೊ ವ್ಹತ್ತಿಯೊ.<verse eid="EZK 40:37" /></para>
  <para style="s">ಉತ್ತರ ಭಾಕಲನಾ ನಜಿಕ ರ‍್ಹಯಲ ಘರೊ</para>
  <para style="p">
    <verse number="38" style="v" sid="EZK 40:38" />ಹೆಬ್ಬಾಗಿಲನಾ ನಿಲವುಖಂಬಾವೊನಾ ಬಾಜು಼ಮಾ ಯಕ್ಕ ಕ್ಹೊಲಿ ತಿನು ದ್ವಾರ ದಿಕ್ಹ್ಯು; ತೆ ಕ್ಹೊಲಿಯೊಮಾ ಸರ್ವಾಂಗಹೊಮ ಜಾನವರೊನಾ ಮಾಕ್ಹನೆ ಧವಾಡಾತಾ. <verse eid="EZK 40:38" /><verse number="39" style="v" sid="EZK 40:39" />ಹೆಬ್ಬಾಗಿಲನಾ ಕೈಸಾಲೆಮಾ ಭಂಬಿ ಬನಿಬಿ ಬೆ ಬೆ ಪಿಠಾ ವ್ಹತ್ತಾ; ತ್ಯುನಾ ಉಪ್ಪರ ಸರ್ವಾಂಗಹೊಮ ಜಾನವರ, ದೊಷ ಪರಿಹಾರಕ ಯಜ್ಞನು ಜಾನವರ, ಪ್ರಾಯಶ್ಚಿತ್ತ ಯಜ್ಞನು ಜಾನವರ ಎ ಕ್ಹಾರನೆ ಕ್ಹಲಾಸ ಕರ್ತಾ ವ್ಹತ್ತಾ . <verse eid="EZK 40:39" /><verse number="40" style="v" sid="EZK 40:40" />ಉತ್ತರನು ಹೆಬ್ಬಾಗಿಲ ಪ್ರವೆಶ ಸ್ಥಾನನಾ ಪೊಟಂಗ್ಯೊನಾ ಬಾಜು಼ತೆ ಬಾಕಲ ಕೈಸಾಲೆನಾ ಭಾರೊ ಯಕ್ಕ ಕೊನಿಮಾ ಬೆ ಪಿಠೊ, ವರಿಯಕ್ಕ ಕೊನಿಮಾ ಬೆ ಪಿಠೊ ವ್ಹತ್ತಾ. <verse eid="EZK 40:40" /><verse number="41" style="v" sid="EZK 40:41" />ಹೆಬ್ಬಾಗಿಲನಾ ಬೆ ಜ಼ಗಾವೊಮಾ ಹೈಂ ಚಾರ ತ್ಯಾ ಚಾರ ಪಿಠೊ, ಪುರಾ ಯಜ್ಞ ಜಾನವರೊನೆ ಕತ್ರಾನಾ ಆಟ ಪಿಠೊ ವ್ಹತ್ತಾ. <verse eid="EZK 40:41" /><verse number="42" style="v" sid="EZK 40:42" />ತೆನೈಸೊ ಸರ್ವಾಂಗಹೊಮನೆ ಉಪಯುಕ್ತ ಥಯಲ ಕೆತ್ತಲ ದಗ್ಡಾನಾ ಚಾರ ಪಠೊ ವ್ಹತ್ತಾ; ತ್ಯುನು ಅಗಲ ದೆಡ ಹತ್ತ, ಲಾಂಬಾಮಾ ದೆಡ ಹತ್ತ, ಉಚ್ಚಾಮಾ ಯಕ್ಕ ಹತ್ತ; ತ್ಯುನಾ ಉಪ್ಪರ ಸರ್ವಾಂಗಹೊಮ ಜಾನವರೊನಾ ಕಾಟಾನಾ ಸಾಮನೊನೆ ಮ್ಹೆಲತಾತಾ. <verse eid="EZK 40:42" /><verse number="43" style="v" sid="EZK 40:43" />ಅಂಚಮಾ ಹತ್ತ ಯಕ್ಲು ಕೊಡಿಯೊ ಮಾರಲ ವ್ಹತು. ನೈವೆದ್ಯನು ಮಾಕ್ಹ ಪಿಠೊನಾ ಉಪ್ಪರ ವ್ಹತ್ತು.<verse eid="EZK 40:43" /></para>
  <para style="s">ಯಾಜಕೊನಾ ಹುತಿ ಖೊಲಿ</para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 40:44" />ಪಾಚ಼ಲ್ತೊ ತೆ ಮನೆ ಮ್ಹೈನಾ ಪ್ರಾಕಾನೆ ಬಲೈ ಲಿನ ಆಯೊ; ದೆಕ, ತ್ಯಾ ಬೆ ಕ್ಹೊಲಿಯೊ ದಿಕ್ಹ್ಯೊ; ಉತ್ತರ ಬಾಕಲನಾ ಬಾಜು಼ಮಾ ಯಕ್ಕ ಕ್ಹೊಲಿ ದಕ್ಷಿಣನಾ ಬಗಲ ಮ್ಹೊಡು ಕರಿನ ವ್ಹತು. ವರಿಯಕ್ಕ ಕ್ಹೊಲಿ ಪಚ್ಚಿಮನೆ ವರಿ ಉತ್ತರ ಅಭಿಮುಖ ವ್ಹತ್ತು. <verse eid="EZK 40:44" /><verse number="45" style="v" sid="EZK 40:45" />ತೆಳಾಮಾ ತೆ ಮನೆ- ದಕ್ಷಿಣ ಅಭಿಮುಖ ಥಯಲ ಎ ಕ್ಹೊಲಿ ದೆವಾಲಯನಾ ಪಾರುಪತ್ಯನೆ ಚ಼ಲಾವಾನಾ ಯಾಜಕೊನೆ ನೆಮಕ ಥಯುಸ; <verse eid="EZK 40:45" /><verse number="46" style="v" sid="EZK 40:46" />ಉತ್ತರ ದಿಕ್ಕನೆ ಅಭಿಮುಖ ಥಯಲ ತೆ ಕ್ಹೊಲಿ ಯಜ್ಞವೆದಿನಾ ಕಾರ್ಯ ದರ್ಶಿ ಥಯಲ ಯಾಜಕೊನೆ ನೆಮಕ ಥಯುಸ; ಚದೊಕನಾ ಸಂತತಿವಾಲಾ ಥಯಲ ಇವ್ನೆ ಲೆವಿ ಕುಲವಾಲಾವೊಮಾ ಯಹೊವಾನಿ ಸನ್ನಿದಿ ಸೆವಕೊ ಥಯಾಸ ಕೈನ ಕದ್ಯೊ.<verse eid="EZK 40:46" /></para>
  <para style="s">ದ್ವಾರ ಮಂಟಪ</para>
  <para style="p">
    <verse number="47" style="v" sid="EZK 40:47" />ಪಾಚ಼ಲ್ತೊ ತೆ ಪ್ರಾಕಾರನಿ ಅಳತಿ ಕರ್ತಾಮಾ ತೆ 50 ಹತ್ತೊ ವ್ಹತ್ತಾ. ಲಾಂಬುಬಿ 50 ಹತ್ತೊ ವ್ಹತ್ತಾ. ಅಗಲಬಿ ಚಚ್ಚೌಕ ವ್ಹತ್ತು; ಬಲಿನೊ ಕಟ್ಟೊ ದೆವಸ್ಥಾನನಾ ಕ್ಹಾಮು ವ್ಹತ್ತು. <verse eid="EZK 40:47" /><verse number="48" style="v" sid="EZK 40:48" />ತೆಳಾಮಾಜ಼ ತೆ ಮನೆ ದೆವಸ್ಥಾನನಾ ದ್ವಾರ ಮಂಟಪನೆ ಬಲೈ ಲೈನ ಅಳತಿ ಕರ್ತಾಮಾ ತಿನಾ ಎದುರ ಬದುರನಾ ನಿಲವು ಕಂಬಾನಾ ಅಗಲ ತನ್ನ ತನ್ನ ಹತೊ ವ್ಹತೊ. <verse eid="EZK 40:48" /><verse number="49" style="v" sid="EZK 40:49" />ದ್ವಾರ ಮಂಟಪ ಲಾಂಬಾಮಾ ಇಕ್ಹ ಹತೊ ವ್ಹತಾ. ಅಗಲಮಾ ಗ್ಯಾರಾ ಹತೊ ವ್ಹತ್ತಾ; ದಕ್ಹ ಪೊಟಂಗ್ಯೊನೆ ಚ಼ಡಿನ ತ್ಯಾ ಚಾ಼ಲ್ಯಾತಾ; ಭಂಬಿ ಬಿನಾ ನಿಲವು ಖಂಬಾವೊನಾ ಬಾಜು಼ಮಾ ಯಕ್ಕೆಕ ಆದಾರನೆ ಖಂಬಾ ವ್ಹತ್ತಾ.<verse eid="EZK 40:49" /></para>
  <chapter eid="EZK 40" />
  <chapter number="41" style="c" sid="EZK 41" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 41:1" />ಪಾಚ಼ಲ್ತೊ ತೆ ಮನೆ ಪರಿಶುದ್ದ ಸ್ಥಳನೆ ಲೈನ ತಿನೆ ಅಳತಿ ಕರ್ತಾಮಾ ತಿನು ಎದುರ ಬದುರನಾ ನಿಲವು ಕಂಬಾನಾ ಅಗಲ ಕ್ಹುದಾನಾ ಗುಡಾರನಾ ಅಗಲ ನಿಂಗತ ತನ್ನ ತನ್ನ ಹತೊ ವ್ಹತಾ. ದ್ವಾರನು ಅಗಮಲ ಪಾಂಚ಼ ಹತೊ ವ್ಹತಾ, <verse eid="EZK 41:1" /><verse number="2" style="v" sid="EZK 41:2" />ದ್ವಾರನಾ ಭಂಬಿ ಬಾಜು಼ನಾ ಗೊಡಿಯೊನು ಅಗಲ ಅಡಿ ಹತೊ ವ್ಹತಾ, ಪರಿಶುದ್ದ ಸ್ಥಳ ಲಾಂಬಾಮಾ ಇಕ್ಹ ಹತೊ ವ್ಹತಾ. ಅಗಲಮಾ ದಕ್ಹ ಹತೊ ವ್ಹತಾ.<verse eid="EZK 41:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 41:3" />ಪಾಚ಼ಲ್ತೊ ತೆ ಹಜು಼ನ ಅಗೊ ಗೈನ ಪರಿಶುದ್ದ ಸ್ಥಳನಾ ಕೊನಿಮಾ ಗರ್ಭಗ್ರಹನೆ ಅಳತಿ ಕರ್ತಾಮಾ ದ್ವಾರನು ಯಕ್ಕೆಕ ನಿಲವುಕಂಬನು ಅಗಲ ಯಕ್ಕ ಯಕ್ಕ ಹತ್ತ ವ್ಹತಾ. ದ್ವಾರನು ಅಗಲ ತನ್ನ ಹತೊ ವ್ಹತಾ. <verse eid="EZK 41:3" /><verse number="4" style="v" sid="EZK 41:4" />ದ್ವಾರನಾ ಬಾಜು಼ನಾ ಗೊಡಿಯೊನು ಅಗಲ ಕ್ಹಡಾ ತನ್ನ ಕ್ಹಡಾ ತನ್ನ ಹತೊ ವ್ಹತಾ. ಗರ್ಭಗ್ರಹ ಲಾಂಬಾಮಾ ದಕ್ಹ ಹತೊ ವ್ಹತಾ. ಅಗಲಮಾ ದಕ್ಹ ಹತೊ ವ್ಹತಾ. ತೆಳಾಮಾ ತೆ ಮನೆ ಎ ಮಹಾಪರಿಶುದ್ದ ಸ್ಥಳ ವ್ಹೈ ಕೈನ ಕದ್ಯೊ.<verse eid="EZK 41:4" /></para>
  <para style="s">ದೆವಸ್ಥಾನನಾ ಸುತ್ತೆ ರ‍್ಹಯಲ ಕ್ಹೊಲಿಯೊ</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 41:5" />ಪಾಚ಼ಲ್ತೊ ತೆ ಅಳತಿ ಕರ್ತಾಮಾ ದೆವಸ್ಥಾನನಿ ಗೊಡಿನು ಅಗಲ ತನ್ನ ಹತೊ ವ್ಹತಾ, ದೆವಸ್ಥನನಾ ಸುತ್ತ ಮುತ್ತ ಕ್ಹಾರಾ ಬನಿ ತಿನಾ ಬಾಜು಼ನೆ ಚಿಟ್ಕಾಯಲ ಕ್ಹೊಲಿಯೊನು ಅಗಲ ಬೆ ಬೆ ಹತೊ ವ್ಹತಾ. <verse eid="EZK 41:5" /><verse number="6" style="v" sid="EZK 41:6" />ತೆ ಕ್ಹೊಲಿಯೊ ಯಕ್ನಾ ಉಪ್ಪರ ಯಕ್ಕ ತನ್ನ ಅಂತಸ್ತ ವ್ಹತ್ತಾ; ಯಕ್ಕೆಕ ಅಂತಸ್ತಮಾ ಮುವತ್ತ-ಮುವತ್ತ ವ್ಹತ್ತಾ; ದೆವಸ್ಥಾನನಿ ಗೊಡಿ ಪೊಟಂಗ್ಯೊ-ಪೊಟಂಗ್ಯೊ ಕರಿನ ಭಾಂದಲ ವ್ಹತ್ತಾ. ಗೊಡಿಮಾ ಕಾಡಾ ನೈಸೊ ತೆ ಪೊಟಂಗ್ಯಜ಼ ಸುತ್ತೆ ರ‍್ಹಯಲ ಕ್ಹೊಲಿಯೊನಾ ತೊಲೆನೆ ಆಧಾರ ಥಯಾತಾ. <verse eid="EZK 41:6" /><verse number="7" style="v" sid="EZK 41:7" />ಸುತ್ತೆ ರ‍್ಹಯಲ ಅಂತಸ್ತೊ ಉಪ್ಪರ-ಉಪ್ಪರ ಗಯಲ ತಿಮ್ಮ ತೆತೆ ಕ್ಹೊಲಿಯೊನು ಅಗಲ ಹೆಚ್ಕಿ ಥಾತು ಗಯು; ತೆ ದೆವಸ್ಥಾನನೆ ಸುತ್ತಿ ಲಿನ ಉಪ್ಪರ-ಉಪ್ಪರ ಗಯಲ ತಿಮ್ಮ ತಿನೆ ಬಿಗಿಬಿಗಿ ಥೈನ ಅವ್ಳಿ ಲಿದ್ಯಲ ನಿಂಗತ ವ್ಹತ್ತಾ. ಇಮ್ಮ ಉಪ್ಪರ ಉಪ್ಪರಲ್ಯಾ ಅಂತಸ್ತೊ ದಸ್ಥಾನನಾ ಬನಿ ಅಗಲ ಥಾತು ಐಯು; ಹಲ್ಯಾ ಅಂತಸ್ತತು ವಚ್ಮಾನಾ ಅಂತಸ್ಥನಾ ವಾಟತಾ ಉಪ್ಪರಲ್ಯಾ ಅಂತಸ್ಥನೆ ಚ಼ಡಾಡಾತಾ. <verse eid="EZK 41:7" /><verse number="8" style="v" sid="EZK 41:8" />ದೆವಸ್ಥಾನನಸುತ್ತ ಮುತ್ತ ಯಕ್ಕ ಜಗಲಿ ದಿಕ್ಹ್ಯು; ತೆ ಕ್ಹೊಲಿಯೊನೆ ತಹದಿ ಥೈನ ನಮಟ್ಟತಾ ಪುರಾ ಛೆ ಮಾರ ಅಳತಿಕೊಲ ತೆಕ್ಲು ಉಚ್ಚು ವ್ಹತ್ತು. <verse eid="EZK 41:8" /><verse number="9" style="v" sid="EZK 41:9" />ಕ್ಹೊಲಿಯೊನಾ ಭಾರ್ಲಿ ಗೊಡಿ ಜಾ಼ಡಾಮಾ ಅಡಿ ಹತೊ ವ್ಹತಾ. <verse eid="EZK 41:9" /><verse number="10" style="v" sid="EZK 41:10" />ದೆವಸ್ಥಾನನೆ ಚಿಟ್ಕಲ ತೆ ಕ್ಹೊಲಿಯೊನಾ ದಿಕ್ಷಿತ ಯಾಜಕೊನಾ ಕ್ಹೊಲಿಯೊನಾ ವಚ್ಮಾ ದೆವಸ್ಥಾನನಾ ಸುತ್ತ ಮುತ್ತ ದಕ್ಹ ಹತೊ ಅಂತರ ವ್ಹತ್ತು. <verse eid="EZK 41:10" /><verse number="11" style="v" sid="EZK 41:11" />ತೆ ಕ್ಹಾರಾ ಕ್ಹೊಲಿಯೊನಾ ಪ್ರವೆಶನೆಬಿ ಬೆಜ಼ ಬಾಕಲೊ, ಉತ್ತರ ಯಕ್ಕ ದಕ್ಷಿಣ ಯಕ್ಕ, ತೆ ಭಂಬಿ ಜಗಲಿಕನ ವ್ಹತ್ತಾ; ತೆ ಜಗಲಿ ಕ್ಹಾರಾ ಬನಿ ಅಡಿ ಹತೊ ವ್ಹತಾ.<verse eid="EZK 41:11" /></para>
  <para style="s">ಪಸ್ಚಿಮ ಖೊಲಿಯೊ</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 41:12" />ಪಡುವಣಮಾ ದಿಕ್ಷತನಾ ಪ್ರಾಕಾರನಾ ಪಾಚ಼ಲ್ಯಾ ಶಾಲೆನು ಅಗಲ ದಕ್ಹ ಹತೊ ವ್ಹತಾ, ಲಾಂಬಾಮಾ ಚಾ಼ಳಕ್ಹಪರ ಪಾಂಚ಼಼ ಹತೊ ವ್ಹತಾ. ತಿನಿ ಗೊಡಿ ಜಾ಼ಡಾಮಾ ಅಡಿ ಹತೊ ವ್ಹತಾ. <verse eid="EZK 41:12" /><verse number="13" style="v" sid="EZK 41:13" />ತೆ ಮನಕ್ಹ ಅಳತಿ ಕರ್ತಾಮಾ ದೆವಸ್ಥಾನ ಲಾಂಬಾಮಾ ಐವತ್ತ ಹತೊ ವ್ಹತಾ. ದಿಕ್ಷತರನಾ ಪ್ರಾಕಾರ, ಶಾಲೆ, ಶಾಲೆನಾ ಗೊಡಿಯೊ, ಇವ್ನು ಪುರಾ ಅಗಲ ಐವತ್ತ ಹತೊ ವ್ಹತಾ.<verse eid="EZK 41:13" /></para>
  <para style="s">ದೆವಸ್ಥಾನನಾ ಪುರಾ ಅಳತಿ</para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 41:14" />ಪುರ್ವಮಾನಾ ದೆವಸ್ಥಾನನು ಮ್ಹೊಡು, ದಿಕ್ಷಿತರ ಪ್ರಾಕಾರ, ಇವ್ನು ಪುರಾ ಅಗಲ ಐವತ್ತ ಹತೊ ವ್ಹತಾ. <verse eid="EZK 41:14" /><verse number="15" style="v" sid="EZK 41:15" />ತೆ ದಿಕ್ಷತರ ಪ್ರಾಕಾರನಾ ಪಾಚ಼ಲಿ ಶಾಲೆನೆ ತೆ ಪ್ರಾಕಾರಕನ ಅಳತಿ ಕರ್ತಾಮಾ ತೆ ಲಾಂಬಾಮಾ ಭಂಬಿ ಬನಿ ಗೊಡಿಯೊನಾ ಕ್ಹಾತೆಜ಼ ಕ್ಹೊ ಮಾರ ವ್ಹತ್ತು.<verse eid="EZK 41:15" /></para>
  <para style="s">ದೆವಸ್ತಾನನು ಪುರಾ ವಿವರಣ</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 41:16" />ಗರ್ಭಗ್ರಹ, ಪ್ರಾಕಾರಮಾನಾ ದ್ವಾರ ಮಂಟಪೊ, ಹೊಚ್ಚಲೊ, ಕಾಡಾನೆ ನೈ ಥಾವಾನಾ ಕಿಡಕಿಯೊ, ಹೊಚ್ಚಲನಾ ಕ್ಹಾಮಾ ತನ್ನ ಅಂತಸ್ತ ಸುತ್ತೆ ಭಾಂದಲ ಗೊಡಿಯೊನಾ ಎಟ್ಟೊ, ಇವ್ನೊನೆ ಅಳತಿ ಕರ‍್ಯೊ; <verse eid="EZK 41:16" /><verse number="17" style="v" sid="EZK 41:17" />ಜಿಮಿನತಾ ಕಿಡಕಿ ಲಕ್ಕಾ ದ್ವಾರನಾ ಉಪ್ಪರ ಗರ್ಭಗ್ರಹನಾ ವರಿ ಹೈಂನಾ ಗ್ರಹನಾ ಗೊಡಿಯೊನೆ ಸುತ್ತ ಮುತ್ತ ಹಲಗಿಯೊ ಚೌಕ-ಚೌಕ ಥೈನ ವರಾಡ್ಯಲ ವ್ಹತ್ತಾ; ಕಿಯೊನಾ (ಬಾಜು಼ಮಾ ಹಲಗಿನಾ) ಹೊದಿಕೆ ವ್ಹತ್ತು. <verse eid="EZK 41:17" /><verse number="18" style="v" sid="EZK 41:18" />(ತೆ ಚೌಕಮಾ) ಕೆರುಬಿಯೊ ಕರ್ಜುರನಾ ಝಾಡೊ ಚಿತ್ರಿತ ಥಯಾತಾ; ಬೆ ಬೆ ಕೆರುಬಿಯೊನಾ ವಚ್ಮಾಯಕ್ಕೆಕ ಕರ್ಜುರನು ಝಾಡ; ಯಕ್ಕೆಕ ಕೆರುಬಿನೆ ಬೆ ಬೆ ಮ್ಹೊಡಾ ವ್ಹತ್ತಾ; <verse eid="EZK 41:18" /><verse number="19" style="v" sid="EZK 41:19" />ಕರ್ಜುರನಾ ಝಾಡನಾ ಯಕ್ಕ ಬಾಜು಼ಮಾ ಮನಕ್ಹನಾ ಮ್ಹೊಡಾನಾ ಕ್ಹಾಮು, ಬಿಜೆಕ್ಕ ಬಾಜು಼ಮಾ ಶಿಂಯ್ಯಾನಾ ಮ್ಹೊಡಾನಾ ಕ್ಹಾಮೊ; ದೆವಸ್ಥಾನನಾ ಕ್ಹಾರು ಮ್ಹೈನು ಭಾಗ ಸುತ್ತ ಮುತ್ತ ಇಮ್ಮ ಚಿತ್ರಮಯ ಥಯುತು. <verse eid="EZK 41:19" /><verse number="20" style="v" sid="EZK 41:20" />ಜಿಮಿನತಾ ದಾರವಂದಮಾ ಉಪ್ಪರ ಲಕ್ಕಾ ಕೆರುಬಿಯೊ ಕರ್ಜುರನಾ ಝಾಡೊ ಚಿತ್ರತ ಥಯಾತಾ.<verse eid="EZK 41:20" /></para>
  <para style="s">ಲಾಕ್ಡಾನೊ ಬಲಿನೊ ಕಟ್ಟೊ</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 41:21" />ಪರಿಶುದ್ದ ಸ್ಥಳ (ಹೈಂನಾ) ಗೊಡಿನು ಬಾಕಲಚೌಕಟ್ಟ ಚೌಕ ವ್ಹತ್ತು; ಮಹಾಪರಿಶುದ್ದ ಸ್ಥಳನಾ ಹೈಂನಾ ಗೊಡಿನು ಚೌಕಟ್ಟ ನಿಂಗತ ವ್ಹತ್ತು.<verse eid="EZK 41:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 41:22" />ತ್ಯಾ ಝಾಡನು ವೆದಿ ಯಕ್ಕ ವ್ಹತ್ತು; ತೆ ಉಚ್ಚಾಮಾ ತನ್ನ ಮಾರ, ಲಾಂಬಾಮಾ ಯಕ್ಕ ಹತ್ತ ವ್ಹತೊ. ತಿನಾ ಮುಲಾಬಿ ಪಿಠಬಿ ಪಕ್ಕಬಿ ಝಾಡನಾ ವ್ಹತ್ತಾ; ತೆ ಮನಕ್ಹ ಮನೆ - ಎ ಯಹೊವಾನಾ ಸಮ್ಮುಖನು ಟೆಬಲ ವ್ಹೈ ಕೈನ ಕದ್ಯೊ.<verse eid="EZK 41:22" /></para>
  <para style="s">ಬಾಕಲೊ</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 41:23" />ಪರಿಶುದ್ದ ಸ್ಥನಾ ವರಿ ಮಹಾಪರಿಶುದ್ದ ಸ್ಥಲನಾ ಬಾಕಲೊನೆ ಬೆ ಬಾಕಲೊ; <verse eid="EZK 41:23" /><verse number="24" style="v" sid="EZK 41:24" />ಯಕ್ಕೆಕ ಬಾಕಲನೆ ಬೆ-ಬೆ ಮಡಚಾ಼ನಾ ಭಾಗೊ; ಹೈನಾ ಬಾಕಲನೆ ಬೆ ಭಾಗ ತಿನಾ ಬಾಕಲನೆ ಬೆ ಭಾಗ ವ್ಹತ್ತಾ. <verse eid="EZK 41:24" /><verse number="25" style="v" sid="EZK 41:25" />ತೆ ಬಾಕಲೊಮಾ, ಕದ್ಯಾಮ ಪರಿಶುದ್ದ ಸ್ಥಳನಾ ಬಾಕಲೊಮಾ ಕೆರುಬಿಯರೊ ಕರ್ಜುರನಾ ಝಾಡೊ ಗಿಯೊಮಾ ಚಿತ್ರಿತ ಥಯಲ ತಿಮ್ಮಜ಼಼ ಚಿತ್ರಿತ ಥಯಾತಾ; ದ್ವಾರ ಮಂಟಪನಾ ಭಾರಾ ಝಾಡನು ಸುರು ವ್ಹತ್ತು <verse eid="EZK 41:25" /><verse number="26" style="v" sid="EZK 41:26" />ದ್ವಾರಮಂಟಪನಾ ಬಾಜು಼ನಾ ಗೊಡಿಯೊಮಾ ಕಾಡನೆ ನೈ ಥಾವಾನಾ ಕಿಡಕಿಯೊ (ಚಿತ್ರಿತ) ಕರ್ಜುರನಾ ಝಾಡೊ ವ್ಹತಾ.<verse eid="EZK 41:26" /></para>
  <chapter eid="EZK 41" />
  <chapter number="42" style="c" sid="EZK 42" />
  <para style="s">ಯಾಜಕೊನಾ ಕ್ಹೊಲಿಯೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 42:1" />ಪಾಚ಼ಲ್ತೊ ತೆ ಮನೆ ಪಚ್ಚಿಮನಾ ವಾಟತೊ ಭಾರ್ಲ್ಯಾ ಪ್ರಾಕಾರಕನ ಬಲೈನ ದಿಕ್ಷಿತನಾ ಪ್ರಾಕಾರನೆ ಉತ್ತರನಾ ಪೌಳೆ ಗೊಡಿನೆಬಿ ವಚ್ಮಾನಾ ಕ್ಹೊಲಿಯೊಕನ ಬಲೈ ಲಿನ ಐನ <verse eid="EZK 42:1" /><verse number="2" style="v" sid="EZK 42:2" />ಉತ್ತರ ದಿಕ್ಕನಾ ಬಾಕಲ ರ‍್ಹಯಲ ಕ್ಹೊಲಿಯೊನಾ ಸಾಲನಾ ಕ್ಹಾಮೊ ಹುಬ್ರಾಡ್ಯೊ; ತೆ ಸಾಲ ಲಾಂಬಾಮಾ ಐವತ್ತ ಹತೊ ವ್ಹತಾ. <verse eid="EZK 42:2" /><verse number="3" style="v" sid="EZK 42:3" />ಮ್ಹೈನಾ ಪ್ರಾಕಾರನೆ ಮಳಲ ದಕ್ಹ ಹತೊ ವ್ಹತಾ. ಅಗಲನಾ ದಿಕ್ಷಿತರ ಪ್ರಾಕಾರನೆ ಭಾರ್ಲ್ಯಾ ಪ್ರಾಕಾರನಾ ನೆಲಗಟ್ಟಿನೆಬಿ ವಚ್ಮಾ ರ‍್ಹಯಲ ತೆ ಪ್ರದೆಶ ಪಚ್ಚಕ್ಹ ಹತೊ ವ್ಹತ್ತಾ. ತ್ಯಾನಾ ಬೆ ಸಾಲ ತನ್ವಾ ಅಂತಸ್ತನಾ ಛತ್ತನಾ ವಾಟೊ ಯಕ್ಕನೆ ಯಕ್ಕ ಎದುರ ಥಯಾತಾ. <verse eid="EZK 42:3" /><verse number="4" style="v" sid="EZK 42:4" />ತೆ ಸಾಲೊನಾ ವಚ್ಮಾ ಐವತ್ತ ಹತೊ ವ್ಹತ್ತಾ. ಲಾಂಬು ಪಾಂಚ಼಼ ಅತೊ ಯಕ್ಲಿ ಅಗಲನಿ ಯಕ್ಕ ವಾಟ ವ್ಹತ್ತಿ; ಕ್ಹೊಲಿಯೊ ಬಾಕಲೊ ಉತ್ತರ ದಿಕ್ಕ ಬನಿ ವ್ಹತ್ತಿಯೊ. <verse eid="EZK 42:4" /><verse number="5" style="v" sid="EZK 42:5" />ಉಪ್ಪರಲ್ಯಾ ಕ್ಹೊಲಿಯೊ ವಚ್ಮಾನಾ ವರಿ ಹೆಟಲ್ಯಾ ಕ್ಹೊಲಿಯೊತಾ ಅಡ್ಚನ ವ್ಹತ್ತಾ; ಛತ್ತನಾ ವಾಟೊ ತ್ಯುನು ಅಗಲನೆ ಕ್ಹೈ ಪಡ್ಯಾತಾ. <verse eid="EZK 42:5" /><verse number="6" style="v" sid="EZK 42:6" />ಕ್ಹೊಲಿಯೊ ತನ್ನ ಅಂತಸ್ತ ವ್ಹತ್ತಾ; (ಭಾರಲ್ಯಾ) ಪ್ರಾಕಾರನಾ ಕ್ಹೊಲಿಯೊನೆ ರ‍್ಹಯಲ ತಿಮ್ಮ ಎ ಕ್ಹೊಲಿಯೊನೆ ಕೈಸಾಲೆ ನ್ಹೊತಿಯೊ; ತಿನಾಹುತಿ ಜಿಮಿನಪರ ಉತ್ತರಮಾ ಉಪ್ಪರಲ್ಯಾ ಕ್ಹೊಲಿಯೊ ಹೆಟಲ್ಯೊ ವರಿ ವಚ್ಮಾನಾ ಕ್ಹೊಲಿಯೊತಿಬಿ ಇಕ್ಕಟ ವ್ಹತ್ತಾ. <verse eid="EZK 42:6" /><verse number="7" style="v" sid="EZK 42:7" />ಭಾರಲ್ಯಾ ಪ್ರಾಕಾರನ ಬನಿ ರ‍್ಹವಾನಾ ಕ್ಹೊಲಿಯೊನಾ ಸಾಲನೆ ಸಮಾನ ಭಾರ್ಲಿ ಗೊಡಿ ಯಕ್ಕ ವ್ಹತ್ತಿ; ತೆ ಪಚ್ಚಕ್ಹ ಹತೊ ಲಾಂಬಿ (ಬೆವಾ) ಸಾಲನಾ ಕ್ಹಾಮು ವ್ಹತ್ತು. <verse eid="EZK 42:7" /><verse number="8" style="v" sid="EZK 42:8" />ಭಾರ್ಯಾ ಪ್ರಾಕಾರನಾ ಲಾಸ್ಟ ರ‍್ಹವಾನಾ ಕ್ಹೊಲಿಯೊನು ಸಾಲ ಲಾಂಬಾಮಾ ಪಚ್ಚಕ್ಹ ಹತೊ, ದೆವಸ್ಥಾನ ಕ ರ‍್ಹವಾನಾ ಕ್ಹೊಲಿಯೊನು ಸಾಲ ಲಾಂಬಾಮಾ ಐವತ್ತ ಹತೊ ವ್ಹತಾ. <verse eid="EZK 42:8" /><verse number="9" style="v" sid="EZK 42:9" />ಕ್ಹೊಲಿಯೊನಾ ಪ್ರಾಕಾರನಾ ಪುರ್ವಮಾ ಹೆಟಲ್ಯಾ ಮಟ್ಟಮಾ ಎ ಪ್ರಾಕಾರನಿ ಗೊಡಿನಾ ವಚ್ಮಾ ಭರಲ್ಯಾ ಪ್ರಾಕಾರತೊ ತ್ಯಾ ಜಾ಼ವಾನಿ ವಾಟ ವ್ಹತ್ತಿ. <verse eid="EZK 42:9" /><verse number="10" style="v" sid="EZK 42:10" />ಎನೈಸೊ ಪುರ್ವಮಾ ದಿಕ್ಷಿತರ ಪ್ರಾಕಾರನೆಬಿ ಪೌಲಿಗೊಡಿನೆಬಿ ವಚ್ಮಾ ಕ್ಹೊಲಿಯೊ ವ್ಹತ್ತಾ; <verse eid="EZK 42:10" /><verse number="11" style="v" sid="EZK 42:11" />ಇವ್ನಾ ವಚ್ಮಾ ಯಕ್ಕ ವಾಟ ವ್ಹತ್ತಿ; ತೆ ಉತ್ತರ ದಿಕ್ಕ ಕ್ಹೊಲಿಯೊ ನಿಂಗತ ದಿಕ್ಹಾಡಾತಾ, ತೆ ಲಾಂಬಾಮಾ ರುಂದಮಾ ತ್ಯುನು ಲಾಂಬು ರುಂದ ಯಕ್ಕಜ಼ ವ್ಹೈ; ಇವ್ನು ರಚನಾಕ್ರಮ ದ್ವಾರ ನಿರ್ಗಮಸ್ಥಾನ ಕ್ಹಾರಾ ತ್ಯುನಾ ನಿಂಗತ ವ್ಹತ್ತಾ; ದಕ್ಷಿಣ ಕ್ಹೊಲಿಯೊ ತಿಮ್ಮಜ಼಼ ವ್ಹತ್ತಾ. <verse eid="EZK 42:11" /><verse number="12" style="v" sid="EZK 42:12" />ಕೊಲಿಯೊನಾ ಪ್ರಾಕಾರನೆ ಪುರ್ವಮಾ ಸೆರಾನಾ ಬನಿ ಗೊಡಿನಾ ಬಾಜು಼ಮಾಜ಼ ರ‍್ಹವಾನಿ ವಾಟನಾ ಲಾಸ್ಟಮಾ ಯಕ್ಕ ಬಾಕಲ ವ್ಹತ್ತು. <verse eid="EZK 42:12" /><verse number="13" style="v" sid="EZK 42:13" />ತೆಳಾಮಾ ತೆ ಮನೆ- ದಿಕ್ಷಿತರ ಪ್ರಾಕಾರನಾ ಉತ್ತರ ವರಿ ದಕ್ಷಿಣ ಬಗಲ ರ‍್ಹಯಲ ಕ್ಹೊಲಿಯೊ ಪರಿಶುದ್ದ ಥಯಾಸ; ತ್ಯಾ ಯಹೊವಾನಿ ಸನ್ನಿದಿನಾ ಸೆವಕೊ ಥಯಲ ಜಕೊ ಮಹಾಪರಿಶುದ್ದ ಸಾಮನೊನೆ ಭುಜಿಸಸ, ವರಿ ಧಾನ್ಯ ನೈವೆದ್ಯ, ದೊಷಪರಿಹಾರಕಯಜ್ಞ ದ್ರವ್ಯ, ಪ್ರಾಯಶ್ಚಿತ್ತಯಜ್ಞ ದ್ರವ್ಯ ಕಾನಾ ಎಜ಼ ಮಹಾಪರಿಶುದ್ದ ಪಧರ್ಥನೆ ತ್ಯಾ ಮ್ಹೆಲಸ; ತೆ ಸ್ಥಳ ಪರಿಶುದ್ದ ವ್ಹೈ ತೆಕ್ಲುಜ಼. <verse eid="EZK 42:13" /><verse number="14" style="v" sid="EZK 42:14" />ಯಾಜಕೊ ಪರಿಶುದ್ದಪ್ರಾಕಾರನೆ ಪ್ರವೆಶ ಕಲಪರ ತಿನೆ ಛೊಡಿನ ಭರಲ್ಯಾ ಪ್ರಾಕಾರನೆ ಜೌ಼ನೈ; ತ್ಯುನಾ ದಿಕ್ಷಾನಾ ವಣ್ಣಾವೊನೆ ತಯಾಜ಼ ಕಿನ ಮ್ಹೆಲ್ಯು, ತೆ ಪರಿಶುದ್ದಜ಼ ವ್ಹೈ; ಪಾಚ಼ಲ್ತಾ ಬಿಜಾ಼ ವಣ್ಣಾವೊನೆ ಘಾಲ್ಲಿನ ಸಾಮಾನ್ಯ ಮನಕ್ಹೊನಾ ಪ್ರಾಕಾರನೆ ಆವಸ.<verse eid="EZK 42:14" /></para>
  <para style="s">ದೆವಾಲಯನಿ ಸುತ್ ಮುತ್ತನಿ ಅಳತಿ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 42:15" />ತೆ ಮನಕ್ಹ ಮ್ಹೈನಾ ಮಂದಿರನೆ ಅತಿ ಕರಿನ ಛೊಡಲಪರ ಮನೆ ಪುರ್ವ ಹೆಬ್ಬಾಗಿಲನಾ ವಾಟತಾ ಹೈಂ ಬೈ ಲಿನ ಐನ ಪುರಾ ಆಲಯನಾ ಸುತ್ತ ಮುತ್ತ ಅಳತಿ ಕರ‍್ಯೊ. <verse eid="EZK 42:15" /><verse number="16" style="v" sid="EZK 42:16" />ಪುರ್ವ ದಿಕ್ಕಮಾ ಲಾಂಬಾ ಅಳತಿಕೊಲಕ್ಹು ಪಾಂಚ಼ ಕ್ಹೊ ಕೊಲ ಎಳದ್ಯೊ. <verse eid="EZK 42:16" /><verse number="17" style="v" sid="EZK 42:17" />ಉತ್ತರ ದಿಕ್ಕಮಾ ಲಾಂಬು ಅಳತಿಕೊಲಕ್ಹು ಪಾಂಚ಼ ಕ್ಹೊ ಕೊಲ ಎಳದ್ಯೊ. <verse eid="EZK 42:17" /><verse number="18" style="v" sid="EZK 42:18" />ದಕ್ಷಿಣ ದಿಕ್ಕಮಾ ಅಳತಿಕೊಲಕ್ಹು ಪಾಂಚ಼ ಕ್ಹೊ ಕೊಲ ಎಳದ್ಯೊ. <verse eid="EZK 42:18" /><verse number="19" style="v" sid="EZK 42:19" />ಪಶ್ಚಿಮ ಗೊಡಿನಾ ಬನಿ ಫರಿನ ಅಳತಿಕೊಲಕ್ಹು ಬೆಕ್ಹೊನ ಐವತ್ತ ಹತೊ. ಕೊಲ ಎಳದ್ಯೊ. <verse eid="EZK 42:19" /><verse number="20" style="v" sid="EZK 42:20" />ಆಲಯನೆ ಚಾರ ಬಗಲಬಿ ಅಳತಿ ಕರ‍್ಯೊ; ಪರಿಶುದ್ದ ಥಯಲ ವರಿ ಅಪರಿಶುದ್ದ ರ‍್ಹಯಲ ಪ್ರದೆಶನೆ ಜು಼ದಾ ಕರಾನೆ 250 ಹತ್ತ ಪಾಂಚ಼ ಕ್ಹೊ ಅಳತಿ ಕೊಲ ಲಾಂಬಾನು ಪಾಂಚ಼ ಕ್ಹೊ ಅಳತಿ ಕೊಲ ಅಗಲನಿ ಗೊಡಿ ಸುತ್ತ ಮುತ್ತ ವ್ಹತ್ತು.<verse eid="EZK 42:20" /></para>
  <chapter eid="EZK 42" />
  <chapter number="43" style="c" sid="EZK 43" />
  <para style="s">ದೆವಾಲಯಮಾನಿ ಆರಾಧನಾ</para>
  <para style="s">ಯಹೊವಾನಿ ಪುನರಾಗಮನ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 43:1" />ಪಾಚ಼ಲ್ತೊ ತೆ ಮನೆ ಪುರ್ವ ಬಾಕಲಕನ ಬಲೈ ಲಿನ ಗಯಲ್ಪರ, <verse eid="EZK 43:1" /><verse number="2" style="v" sid="EZK 43:2" />ದೆಕ, ಇಸ್ರಾಯೆಲನೊ ಕ್ಹುದಾನು ತೆಜಸ್ಸ ಪುರ್ವ ವಾಟತು ಐಯು; ತಿನಿ ಅವಾಜ಼ ಪಾನಿನಾ ತುಫಾನನಾ ಅವಾಜ಼ ನಿಂಗತ ವ್ಹತ್ತು; ತಿನಾ ತೆಜಸ್ಸಕ್ಹು ಭುಮಿ ಬೆಳಗಿ. <verse eid="EZK 43:2" /><verse number="3" style="v" sid="EZK 43:3" />ಪಸ್ಟ ಮನೆ ದಿಕ್ಹಿನ ಆಯಲ ತೆಜಸ್ಸ ನಿಂಗತ ತೆ ದಿಕ್ಹ್ಯು; ಗಾಮನೆ ಹಾಳ ಕರಾನೆ ಮಿ ಆಯಲ್ಪರ ಕೆವು ದೆಕ್ಹೊ ತೆವುಜ಼ ದೆಕ್ಯೊ; ಕೆಬಾರ್ ನದಿಕನ ಮನೆ ಥಯಲ ಅದ್ಭುತ ದರ್ಶನ ನಿಂಗತ ದರ್ಶನ ಹಮ್ನಾಬಿ ಮನೆ ಥಯು; ತಿನೆ ದೆಕಿನ ಅಡ್ಡ ಪಡ್ಯೊ. <verse eid="EZK 43:3" /><verse number="4" style="v" sid="EZK 43:4" />ತೆಳಾಮಾ ಯೆಹೊವನಿ ತೆಜಸ್ಸ ಪುರ್ವ ಬಾಕಲನಾ ವಾಟತು ದೆವಸ್ಥಾನಮಾ ಐಯು. <verse eid="EZK 43:4" /><verse number="5" style="v" sid="EZK 43:5" />ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಮನೆ ಉಚೈನ ಮ್ಹೈನಾ ಪ್ರಾಕಾರನೆ ಲಾತಾಮಾ ಆಹಾ, ಯಹೊವಾನಿ ತೆಜಸ್ಸ ದೆವಸ್ಥಾನಮಾ ಭರಿ ಗಯುತು. <verse eid="EZK 43:5" /><verse number="6" style="v" sid="EZK 43:6" />ತೆಳಾಮಾ ದೆವಸ್ಥಾನಮಾ ಮನೆ ಬೊಲಿ ಕವಾಲಾನಿ ಅವಾಜ಼ ಮಾರಾ ಕಾನೆ ಪಡಿ; ತೆ ಮನಕ್ಹ ಮಾರಾ ಬಾಜು಼ಮಾ ಹುಬ್ರಯೊತೊ. <verse eid="EZK 43:6" /><verse number="7" style="v" sid="EZK 43:7" />ಬೊಲಾಲೊ ಮನೆ ಅಮ್ಮ ಕದ್ಯೊ- ನರನಾ ದಿಕ್ರಾ, ಎ ಮಾರಿ ಸಿಂಹಾಸನನಿ ಜ಼ಗಾ ವ್ಹೈ, ಮಾರಿ ಪಾದಸನ್ನಿದಿ ವ್ಹೈ; ನ್ಹ್ಯಾ ಮಿ ಇಸ್ರಾಯೆಲೊನಾ ವಚ್ಮಾ ಹಮೆಶಾ ರ‍್ಹೌಸ; ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾ ರ‍್ಹವಾದೆ ತ್ಯುನಾ ರಾಜಾ಼ ರ‍್ಹವಾದೆ ತ್ಯುನಾ ದೆವ ದ್ರೊಹಕ್ಹುಜ಼, ನಾಶ ಥಯಲ ರಾಜಾ಼ವೊನಾ ಮುರ್ದಾಕ್ಹು ಮಾರು ನಾಮ ಅಪವಿತ್ರ ಕರ್ತು ನೈ. <verse eid="EZK 43:7" /><verse number="8" style="v" sid="EZK 43:8" />ಮಾರಾ ಹೊಚ್ಚಲ ನಿಲವುಕನ ತ್ಯುನಾ ಹೊಚಚಲ ನಿಲವು ಘಾಲ್ಲಿನ ಮಾರಾ ಘರೆಬಿ ತ್ಯುನಾ ಘರೆಬಿ ಯಕ್ಕಜ಼ ಗೊಡಿ ಥಯೆ ನಿಂಗತ ಕರಿಲಿವಾಕ್ಹು ಹಬ್ದಾ ಮಾರು ಪವಿತ್ರ ನಾಮ ಕೆಡಸ್ಯಾ; ತಿನಾಹುತಿ ಮಿ ಶಿಟ್ಟ ಥೈನ ತ್ಯುನೊನೆ ನಾಶ ಕರ‍್ಯೊ. <verse eid="EZK 43:8" /><verse number="9" style="v" sid="EZK 43:9" />ಹಮ್ನಾತಬಿ ತ್ಯುನು ದೆವದ್ರೊಹನೆ ವರಿ ರಾಜಾ಼ವೊನಾ ಮುರ್ದಾ ಮಕ್ಹು ದುರ ಕರಾದೆ; ತೆಳಾಮಾ ಮಿ ತ್ಯುನಾ ವಚ್ಮಾ ಹಮೆಶಾ ರ‍್ಹೌಸ.<verse eid="EZK 43:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 43:10" />ಮನಕ್ಹನಾ ದಿಕ್ರಾ , ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾ ತ್ಯುನಾ ಅಪರಾದೊಕ್ಹು ಸರಮೆ ನಿಂಗತ ದೆವಾಲಯ ತ್ಯುನೊನೆ ದೆಕಾಡ; ತ್ಯುನೆ ತಿನಿ ಅಳತಿ ಕರಾದೆ. <verse eid="EZK 43:10" /><verse number="11" style="v" sid="EZK 43:11" />ತ್ಯುನೆ ಕರಲ ಕ್ಹಾರಾ ಕೆಟ್ಟ ಕಾಮೊನೆ ಸರಮ್ಯಾಮ ತು ದೆವಸ್ಥನನಾ ರುಪನೆ ವ್ಯವಸ್ಥೆನೆ ಗಮನಾಗಮನ ನಿಯಮೊನೆ ಕ್ಹಾರಾ ರಚನಾ ವಿಧಾನನೆ ಕ್ಹಾರಾ ವಿಧಿಯೊನೆ ಕ್ಹರು ನಿರ್ಮಾಣ ರಿತಿನೆ ಕ್ಹಾರಾ ಕಟ್ಟಳೆನೆ ತ್ಯುನೊನೆ ತಿಳಸೈನ ತ್ಯುನಾ ಡೊಳಾ ಕ್ಹಾಮೊ ಲಿಕ್ಕ. <verse eid="EZK 43:11" /><verse number="12" style="v" sid="EZK 43:12" />ಎಜ಼ ದೆವಸ್ಥಾನನು ನಿಯಮ ವ್ಹೈ; ಪರ್ವತಾಗ್ರಮಾತಿನಾ ಕ್ಹಾರಾ ಪ್ರದೆಶ ಸುತ್ತ ಮುತ್ತ ಘನ್ನು ಪರಿಶುದ್ದ ರ‍್ಹೌ. ದೆಕ, ದೆವಸ್ಥಾನನು ನಿಯಮ ಎಜ಼ ವ್ಹೈ.<verse eid="EZK 43:12" /></para>
  <para style="s">ಬಲಿನೊ ಕಟ್ಟೊ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 43:13" />ಯಜ್ಞವೆದಿ ಲಾಂಬಾ ಯಕ್ಕ ಹತ್ತ ಅಳತಿನಾ ಪ್ರಕಾರ ಅಮ್ಮ ರ‍್ಹೌ (ಲಾಂಬಾ ಮಾರ ಕದ್ಯಾಮ ಮಾರಪರ ಯಕ್ಕ ಹಿಡಿಯುದ್ದ) ಹೆಟಲ್ಯಾ ಭಾಗನು ಉಚ್ಚು ಯಕ್ಕ ಹತ್ತ ವ್ಹತು, ಉಪ್ಪರಲ್ಯಾ ಬಿಡುವನು ಅಗಲ ಸುತ್ತೆ ಯಕ್ಕ ಹತ್ತ ವ್ಹತಾ. ಬಿಡುವನಿ ತುದಿಮಾ ಸುತ್ತೆ ದಿಂಡಿನಿ ಅಗಲ ಯಕ್ಕ ಗೆಂಡ; ಎಜ಼ ಯಜ್ಞವೆದಿನು ಪಿಠ ವ್ಹೈ. <verse eid="EZK 43:13" /><verse number="14" style="v" sid="EZK 43:14" />ಜಿಮಿನಪರ ಕದ್ಯಾಮ ಹೆಟಲ್ಯಾ ಭಾಗನಾ ಉಪ್ಪರ ಹೆಟಲ್ಯಾ ಅಂತಸ್ತನು ಉಚ್ಚು ಯಕ್ಕ ಹತ್ತ ವ್ಹತಾ. ತಿನಾ ಉಪ್ಪರಲ್ಯು ಬಿಡುವನು ಅಗಲ ಅರ್ದೊ ಹತ್ತ ಯಕ್ಲು ವ್ಹತು. ತೆ ನ್ಹಾನಾ ಅಂತಸ್ತನಾ ಉಪ್ಪರ ಮ್ಹಾಟಾ ಅಂತಸ್ತನು ಉಚ್ಚು ಬೆ ವ್ಹತೊ ಯಕ್ಲು ವ್ಹತು, ಉಪ್ಪರಲ್ಯಾ ಬಿಡುವನು ಅಗಲ ಅರ್ದೊ ಹತ್ತ ವ್ಹತು, ವ್ಹೈ. <verse eid="EZK 43:14" /><verse number="15" style="v" sid="EZK 43:15" />ಹೊಮಕುಂಡನಾ ಅಂತಸ್ತನು ಉಚ್ಚು ಬೆ ಹತೊ ಯಕ್ಲು ವ್ಹತು. ಹೊಮಕುಂಡನಾ ಉಪ್ಪರ ಚಾರ ಶಿಂಗ್ಡಾ ರ‍್ಹೌ. <verse eid="EZK 43:15" /><verse number="16" style="v" sid="EZK 43:16" />ಹೊಮಕುಂಡ ಛೆ ಹತೊ ಯಕ್ಲು ವ್ಹತು. ಅಗಲ ಚೌಕ ರ‍್ಹೌ. <verse eid="EZK 43:16" /><verse number="17" style="v" sid="EZK 43:17" />ಮ್ಹೊಟು ಅಂತಸ್ತ ಕ್ಹಾತ ಹತೊ ವ್ಹತಾ. ಅಗಲ ಚಾರೆ ಪಾರ್ಶ್ವಮಾ ಸಮಾ ರ‍್ಹೌ. ಸುತ್ತೆನೆ ದಿಂಡಿನು ಅಗಲ ಅರ್ದು ಮಾರ; ಹೆಟಲ್ಯಾ ಭಾಗನು ಸುತ್ತ ಅಂಚನು ಅಗಲ ಅರ್ದೊ ಹತ್ತ ವ್ಹತು. ಸೊಪಾನ ಪುರ್ವನೆ ಅಭಿಮುಖ ಥೈನ ರ‍್ಹೌ.<verse eid="EZK 43:17" /></para>
  <para style="s">ಯಜ್ಞವೆದಿನು ಕ್ಹುದಾನಾ ಹುತಿ ಶುದ್ದಿಕರಾನು</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 43:18" />ತೆಳಾಮಾ ತೆ ಮನಕ್ಹ ಮನೆ ಇಮ್ಮ ಕದ್ಯೊ- ನರನಾ ದಿಕ್ರಾ, ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಸರ್ವಾಂಗಹೊಮನೆ ರಗತ ಚಿಪ್ಡಾವಾನಿ ಸಂಸ್ಕಾರನೆ ಯಜ್ಞವೆದಿನೆ ಶುದ್ದಿಕರ್ತಾಮಾ ಎ ಚಿಧಿಯೊನೆ ಕರು- <verse eid="EZK 43:18" /><verse number="19" style="v" sid="EZK 43:19" />ಲೆವಿಯೊ ಚಾದೊಕನಾ ಸಂತಾನವಾಲಾ ಮಾರಿ ಸನ್ನಿದಿನಾ ಸೆವಕೊ ಥಯಲ ಯಾಜಕೊನೆ ತು ಯಕ್ಕ ಹೊರಿನೆ ದೊಷಪರಿಹಾರಕ ಬಲಿದೆ. ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 43:19" /><verse number="20" style="v" sid="EZK 43:20" />ತಿನಾ ರಗತಮಾ ದಕ್ಹು ಲಿನ ಯಜ್ಞವೆದಿನಾ ಚಾರೆ ಶಿಂಗ್ಡಾವೊನೆ ಮ್ಹೊಟಾ ಅಂತಸ್ತನಾ ಚಾರೆ ಮುಲಾವೊನೆ ಸುತ್ತೆ ದಿಂಡಿನೆಬಿ ಲಗಾಡಿನ ಯಜ್ಞವೆದಿನಾ ದೊಷನೆ ಪರಿಹರಸಿನ ತಿನೆ ಶುದ್ದ ಕರ. <verse eid="EZK 43:20" /><verse number="21" style="v" sid="EZK 43:21" />ವರಿ ದೊಷಪರಿಹಾರಯಜ್ಞನಾಹುತಿ ಕತ್ರಲ ಹೊರಿನೆ ತು ಒಪ್ಪಿಸಾನೆ ನೆಮಿಸಲವಾಲೊ ಪವಿತ್ರಾಲಯನಾ ಭಾರೊ ದೆವಸ್ಥಾನನೆ ಸಂಬಂಧ ರ‍್ಹಯಲ ಜ಼ಗಾಪರ ತಿನೆ ಬಾಳು. <verse eid="EZK 43:21" /><verse number="22" style="v" sid="EZK 43:22" />ಬೆವಾ ದಿನ್ನಮಾ ತು ಪುರಾ ಅಂಗ ರ‍್ಹಯಲ ಹೊತನೆ ದೊಷಪರಿಹಾರಯಜ್ಞನಾಹುತಿ ಅರ್ಪಿಸ; ಹೊರಿಕ್ಹು ಯಜ್ಞವೆದಿ ಶುದ್ದ ಥಯಲ ನಿಂಗತ ಬಕ್ರಾಕ್ಹು ಶುದ್ದ ಕರು. <verse eid="EZK 43:22" /><verse number="23" style="v" sid="EZK 43:23" />ತು ಯಜ್ಞವೆದಿನು ಶುದ್ದಿ ಕಾರ್ಯನೆ ಕ್ಹರಾಯಲ್ಪರ ಪುರಾ ಅಂಗ ರ‍್ಹಯಲ ಗುಳಿ ಹಿಂಡಮಾತೊ ಲಾಯಲ ಪುರಾ ಅಂಗ ರ‍್ಹಯಲ ಟಗರನೆ ಅರ್ಪಿಸು. <verse eid="EZK 43:23" /><verse number="24" style="v" sid="EZK 43:24" />ತು ತೆ ಕ್ಹಾರು ಯಹೊವಾನೆ ಸಮರ್ಪಿಸಾನೆ ಯಾಜಕೊ ತ್ಯುನಾ ಉಪ್ಪರ ಮಿಟ್ಟು ನಾಕಿನ ಯಹೊವಾನಾಹುತಿ ಸರ್ವಾಂಗಹೊಮ ಕರು. <verse eid="EZK 43:24" /><verse number="25" style="v" sid="EZK 43:25" />ಕ್ಹಾತ ದಿನ್ನ ತು ದಿನ್ನೆ ದಿನ್ನೆ ದೊಷಪಿಹಾರಕಯಜ್ಞನಾಹುತಿ ಯಕ್ಕೆಕ ಹೊತ ಅರ್ಪಿಸ; ಯಾಜಕೊಬಿ ಪುರಾ ಅಂಗ ರ‍್ಹಯಲ ಹೊರಿನೆ ಹಿಂಡಮಾತಾ ಲಾಯಲ ಪುರಾ ಅಂಗ ರ್xಯಲ ಟಗರನೆ ಅರ್ಪಿಸಾದೆ. <verse eid="EZK 43:25" /><verse number="26" style="v" sid="EZK 43:26" />ಇಮ್ಮ ಕ್ಹಾತ ಇಮ್ಮ ಯಜ್ಞವೆದಿನು ದೊಷನೆ ಪರಿಹಾರ ಕರ್ತೊ ತಿನೆ ಶುದ್ದ ಕರಿನ ಪ್ರತಿಷ್ಟೆ ಕರು. <verse eid="EZK 43:26" /><verse number="27" style="v" sid="EZK 43:27" />ಕ್ಹಾತ ದಿನ್ನ ಕಾರ್ಯ ಕ್ಹರಾಯಲ್ಪರ ಅಟವಾ ದಿನ್ನಮಾಬಿ ಅಗಾಬಿ ಯಾಜಕೊ ಯಜ್ಞವೆದಿನಾ ಉಪ್ಪರ ತುಮಾರಾ ಪಕ್ಷ ಥೈನ ಸರ್ವಾಂಗಹೊಮ ಸಮಾಧಾನಯಜ್ಞ ಕರು; ತೆಳಾಮಾ ಮಿ ತುಮೊಪರ ಕ್ಹುಶಿ ಥೌಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 43:27" /></para>
  <chapter eid="EZK 43" />
  <chapter number="44" style="c" sid="EZK 44" />
  <para style="s">ಪುರ್ವದ್ವಾರನು ಉಪಯೊಗ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 44:1" />ಪಾಚ಼ಲ್ತೊ ತೆ ಮನಕ್ಹ ಮನೆ ಪವಿತ್ರಾಲಯನಾ ಪುರ್ವ ಭಾರಲ್ಯಾ ಹೆಬ್ಬಾಗಿಲೆ ವರಿ ಬಲೈಲಿನ ಆಯೊ; ತೆ ಜ಼ಕೈಯು. <verse eid="EZK 44:1" /><verse number="2" style="v" sid="EZK 44:2" />ತೆಳಾಮಾ ಯಹೊವಾ ಮನೆ- ಎ ಬಾಕಲ ಝಾಕ್ಯಲ ರ‍್ಹೌ, ಅನೆ ಕಾಡು ನೈ. ಇನಾಕ್ಹು ಕುನ್ನಜ಼ ಮ್ಹೈ ಜಾ಼ವಾನು ನಕೊ; ಇಸ್ರಾಯೆಲನೊ ಕ್ಹುದಾ ಥಯಲ ಯಹೊವಾ ಅಕ್ಹು ಮ್ಹೈ ಗಯೊಸ್ತೊ; ತೆ ಝಕೈನಜ಼ ರ‍್ಹೌ. <verse eid="EZK 44:2" /><verse number="3" style="v" sid="EZK 44:3" />ಪ್ರಭುವೊ ಯಹೊವಾನಿ ಸನ್ನಿದಿಮಾ ಹವಿರ್ಬೊಜನ ಕಾರಾನೆ ನ್ಹ್ಯಾ ಪ್ರಭು ಥೈನ ಬೈಟ ಸಕಸ; ತೆ ಹೆಬ್ಬಾಗಿಲ ಕೈಸಾಲೆನಾ ವಾಟನೆ ಮಳಿನ ತೆಜ಼ ವಾಟೆ ಜೌ಼ ಕೈನ ಕದ್ಯೊ.<verse eid="EZK 44:3" /></para>
  <para style="s">ಲೆವಿಯೊನು ಕರ್ತವ್ಯ</para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 44:4" />ಪಾಚ಼ಲ್ತೊ ತೆ ಮನಕ್ಹ ಉತ್ತರ ದಿಕ್ಕ ಹೆಬ್ಬಾಗಿಲನಾ ವಾಟತೊ ಮನೆ ದೆವಸ್ಥಾನನಾ ಕ್ಹಾಮೊ ಲಾಯೊ; ಆಹಾ, ಮಿ ದೆಕ್ತಾಮಾ ಯಹೊವಾನು ತೆಜಸ್ಸ ಯಹೊವಾನಿ ಆಲಯನೆ ಭರಿಗಯುತು; ತಿನೆ ದೆಕಿನ ಅಡ್ಡ ಪಡ್ಯೊ. <verse eid="EZK 44:4" /><verse number="5" style="v" sid="EZK 44:5" />ತೆಳಾಮಾ ಯಹೊವಾ ಮನೆ ಅಮ್ಮ ಕದ್ಯೊ- ನರನಾ ದಿಕ್ರಾ, ಯಹೊವಾನಿ ಆಲಯ ಕ್ಹಾರಾ ನಿಯಮನಿಷ್ಟೆನಾ ವಿಷಯನಾಹುತಿ ಮಿ ತುನೆ ಕವಾನು ಕ್ಹಾರು ತು ಕಾನೆ ಐಕಿನ ಡೊಳೆ ದೆಕಿನ ಮನದಟ್ಟ ಕರಿಲೆ; ವರಿ ಪವಿತ್ರಾಲಯನಾ ಗಮನಾಗಮನ ವಿಧಿಯೊನೆ ಧ್ಯಾನ ದೆ. <verse eid="EZK 44:5" /><verse number="6" style="v" sid="EZK 44:6" />ಎನೈಸೊ ತು ತೆ ದ್ರೊಹಿಯೊನೆ ಕದ್ಯಾಮ ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾವೊನೆ ಇಮ್ಮ ಕೆ, ಕರ್ತಾ ಥೈಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ. <verse eid="EZK 44:6" /><verse number="7" style="v" sid="EZK 44:7" />ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾ, ತುಮೆ ಮಾರು ಅನ್ನ ರ‍್ಹಯಲ ರಗತ ಅರ್ಪಿಸ್ತಾಮಾ ತನಮನಮಾ ಸುನ್ನತಿ ನೈಸೊವಾಲಾ ಥಯಲ ಮ್ಲೆಚ್ಛರನೆ ಮಾರಿ ಪವಿತ್ರ ಆಯಲಮಾ ಬಲೈ ಲೈನ ಮಾರಿ ಮಂದಿರನೆ ಗಲಿಜ಼ ಕರಿನ ಮಾರಿ ಒಡಂಬಡಿಕೆನೆ ಭಂಗ ಕರಿನ ತುಮಾರಾ ಘನ್ನಾ ದುರಾಚಾರೊನಾ ಹಿಸಾಬ ಲಗಾಡ್ಯಾಸ; <verse eid="EZK 44:7" /><verse number="8" style="v" sid="EZK 44:8" />ತುಮೆ ಮಾರಾ ಪರಿಶುದ್ದ ಸಾಮನೊನೆ ಕೈದ್ಯಾನೈ ಕರ್xಯಾ ನೈ; ಎ ಮ್ಲೆಚ್ಛರ ಮಾರಿ ಪವಿತ್ರಾಲಯಮಾ ಮಾರಾ ಸಾಮನೊನಾ ಉಪ್ಪರ ಪಾರುಪತ್ಯ ಕರಾಲಾ ಥೈನ ನೆಮಿಸಿ ಲಿದ್ಯಾಸ; ತುಮಾರಾ ಘನ್ನಾ ದುರಾಚಾರೊ ಹಬ್ದಾ ಬಸ್ಸ. <verse eid="EZK 44:8" /><verse number="9" style="v" sid="EZK 44:9" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಇಸ್ರಾಯೆಲೊಮಾ ಮಳಲ ಮ್ಲೆಚ್ಛರಮಾ ತನಮನಮಾ ಸುನ್ನತಿ ಹಿನ ಥಯಲ ಕುನ್ನಬಿ ಮಾರಿ ಪವಿತ್ರಾಲಯನೆ ಪ್ರವೆಶ ಕರು ನೈ'<verse eid="EZK 44:9" /></para>
  <para style="s">ಲೆವೆಯೊನೆ ಯಜೊಕೊನಾ ಕಾಮೊಕ್ಹು ಛೊಡಾಯಲ</para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 44:10" />ಇಸ್ರಾಯೆಲೊ ಮನೆ ಛೊಡ್ಯಲಪರ ಮಾರಾಕ್ಹು ರ‍್ಹವಾದೆ ತ್ಯುನಾ ಗೊಂಬಿಯೊಕನ ಫರಿನ ಮನೆ ದುರ ಥೈನ ಗಯಲ ಲೆವಿಯೊ ತ್ಯುನಾ ದೊಷನು ಫಲ ಅನುಬವಿಸಸ. <verse eid="EZK 44:10" /><verse number="11" style="v" sid="EZK 44:11" />ತ್ಯುನೆ ಮಾರಿ ಪವಿತ್ರಾಲಯಮಾ ಪರಿಚಾರಕೊ ಮಂದಿರ ದ್ವಾರ ಪಾಲಕೊ ಥೈನ ಮಂದಿರಮಾ ಸೆವೆ ಕರು; ಮನಕ್ಹೊನಾ ಪಕ್ಷ ಥೈನ ಸರ್ವಾಂಗಹೊಮ ಜಾನವರನೆ ಸಮಾಧಾನ ಯಜ್ಞ ಜಾನವರನೆ ಕತ್ರಿನ ತ್ಯುನೊನೆ ಸೆವೆ ಕರಾನೆ ಸಿದ್ದ ಥೈನ ರ‍್ಹೌ. <verse eid="EZK 44:11" /><verse number="12" style="v" sid="EZK 44:12" />ತ್ಯುನೆ ಮೊರ್ತಿಯೊನಾ ಕ್ಹಾಮಾ ಮನಕ್ಹೊನಾಹುತಿ ಸೆವೆ ಕರಿನ ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾವೊನೆ ಪಾಪಕಾರಿ ವಿಘ್ನ ಥಯಲಕ್ಹು ಮಿ ತ್ಯುನಾ ಉಪ್ಪರ ಹತ್ತ ಉಚಾ಼ಯೊಸ, ತ್ಯುನೆ ತ್ಯುನಾ ದೊಷನು ಫಲ ಅನುಭವಿಸಿನಜ಼ ರ‍್ಹೌ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 44:12" /><verse number="13" style="v" sid="EZK 44:13" />ತ್ಯುನೆ ಮನೆ ಯಾಜಕ ಸೆವೆ ಕರಾನೆ ಮಾರಾ ಸನ್ನಿದಿನೆ ಔನೈ; ಮಾರಿ ಅತಿಪವಿತ್ರ ಥಯಲ ಪರಶುದ್ದ ಸಾಮನೊಮಾ ಕಿನಾಜ಼ ನಜಿಕ ಜೌ಼ನೈ; ತ್ಯುನೊನೆ ಥಯಲ ಅವಮಾನನೆ ತ್ಯುನೆ ಕರಲ ದುರಾಚಾರನಾ ಫಲ ಅನುಭವಿಸಸ. <verse eid="EZK 44:13" /><verse number="14" style="v" sid="EZK 44:14" />ದೆವಾಲಯನಾ ಕ್ಹಾರಾ ಸೆವೆಮಾಬಿ ತ್ಯಾ ಥಾವಾನಾ ಕ್ಹಾರಾ ಕಾಮೊಮಾಬಿ ಸೆವಕನು ಕಾಮಜ಼ ತ್ಯುನೊನೆ ದ್ಯುಸ.<verse eid="EZK 44:14" /></para>
  <para style="s">ಯಾಜಕೊ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 44:15" />ತೆನೈಸೊ ಇಸ್ರಾಯೆಲೊ ಮನೆ ಛೊಡ್ಯಲ್ಪರ ಲೆವಿಯೊ ಚಾದೊಕನಾ ಸಂತಾನವಾಲಾ ಥಯಲ ಯಾಜಕೊ ಮಾರಿ ಪವಿತ್ರಾಲಯನಾ ಪಾರುಪತ್ಯನೆ ನೆರವೆರಿಸಲಕ್ಹು ತ್ಯುನೆ ಮನೆ ಸೆವಿಸಾನೆ ಮಾರಿ ಸನ್ನಿದಿನೆ ಆವಸ, ಮನೆ ರಗತ ವರಿ ಚರ್ಬಿ ಅರ್ಪಿಸ್ತಾಮಾ ಮಾರಾ ಸಮ್ಮುಖಮಾ ಹುಬ್ರ್ಯವಸ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 44:15" /><verse number="16" style="v" sid="EZK 44:16" />ತ್ಯುನೆ ಮಾರಿ ಪವಿತ್ರಾಲಯನೆ ಪ್ರವೆಶ ಕರಿನ ಮಾರಿ ಸೆವೆ ಕರಾನೆ ಮಾರಿ ವೆದಿನೆ ನಜಿಕ ಗೈನ ಮಾರಿ ಆಲಯನಾ ದೆಕ್ರಾಣಕಿ ವಹಿಸಸ. <verse eid="EZK 44:16" /><verse number="17" style="v" sid="EZK 44:17" />ತ್ಯುನೆ ಮ್ಹೈನಾ ಪ್ರಾಕಾರನಾ ಬಾಕಲೊಮಾಬಿ ದೆವಸ್ಥಾನಮಾಬಿ ಸೆವೆ ಕರ್ತಾಮಾ ಕಯುಜ಼ ಉಣ್ಣೆನಾ ವಣ್ಣಾ ತ್ಯುನಾ ಉಪ್ಪರ ರ‍್ಹೌನೈ. <verse eid="EZK 44:17" /><verse number="18" style="v" sid="EZK 44:18" />ಇವ್ನೆ ಮಾತಾನೆ ಕಿಮ್ಮತನೊ ಫಟ್ಕೊ, ಕಂಬರನೆ ನಾರಿನ ವಣ್ಣಾ ಘಾಲಿಲಿನ ರ‍್ಹವಾದೆ; ಘಾಮ ಆವಾನು ಕಯಾಜ಼ ವಣ್ಣಾ ಘಾಲ್ಯು ನೈ. <verse eid="EZK 44:18" /><verse number="19" style="v" sid="EZK 44:19" />ತ್ಯುನೆ ಭಾರಲ್ಯಾ ಪ್ರಾಕಾರನೆ ಕದ್ಯಾಮ ತ್ಯಾನಾ ಮನಕ್ಹೊಕನ ಜಾ಼ತಾಮಾ ತ್ಯುನಾ ದಿಕ್ಷಾನಾ ವಣ್ಣಾ ತ್ಯುನೊನೆ ತಗಲಿಸಿನ ತ್ಯುನೊನೆ ಪರಿಶುದ್ದ ನೈ ಥಯೆ ನಿಂಗತ ತಿನೆ ಕಾಡಿನ ಪರಿಶುದ್ದ ರ‍್ಹಯಲ ಕ್ಹೊಲಿಯೊಮಾ ಮ್ಹೆಲಿನ ಬಿಜಾ಼ ವಣ್ಣಾ ಘಾಲಿ ಲಿವಾದೆ. <verse eid="EZK 44:19" /><verse number="20" style="v" sid="EZK 44:20" />ತ್ಯುನೆ ಮಾತು ಬೊಳ್ಸಿಲ್ಯುನೈ, ಬಾಲೊ ಘನ್ನಾ ಬೆಳಸು ನೈ, ಕಟೈಲಿಲ ರ‍್ಹೌಬಿ ನೈ. <verse eid="EZK 44:20" /><verse number="21" style="v" sid="EZK 44:21" />ಮ್ಹೈನಾ ಪ್ರಾಕಾರನೆ ಪ್ರವೆಶ ಕರ್ತಾಮಾ ಕಯೊ ಯಾಜಕ ಕಡಕ ದ್ರಾಕ್ಷಾ ರಕ್ಹನೆ ಪಿದ್ಯಲ ರ‍್ಹೌನೈ. <verse eid="EZK 44:21" /><verse number="22" style="v" sid="EZK 44:22" />ಯಾಜಕೊ ವಿಧವೆನೆ ರ‍್ಹವಾದೆ ಮಾಟಿ ಛೊಡಲವಾಲಿನೆ ರ‍್ಹವಾದೆ ಹಿವಾ ಕರಿಲ್ಯು ನೈ; ತೆನೈಸೊ ಇಸ್ರಾಯೆಲ ವಂಶನಾ ಛೊಕ್ರಿಯೊನೆ ರ‍್ಹವಾದೆ ಯಾಜಕನಿ ವಿಧವೆನೆ ರ‍್ಹವಾದೆ ಹಿವಾ ಕರಿಲಿವಾದೆ. <verse eid="EZK 44:22" /><verse number="23" style="v" sid="EZK 44:23" />ಮಿಸಲ ರ‍್ಹಯಲನೆಬಿ ಮಿಸಲ ನೈ ರ‍್ಹಯಲನೆಬಿ ಭೆದ ಮಾರಾ ಮನಕ್ಹೊನೆ ದೆಕಾಡಿನ ಶುದ್ದಾಶುದ್ದ ವಿವೆಚನೆ ತ್ಯುನೊನೆ ಬೊದನೆ ಕರಾದೆ. <verse eid="EZK 44:23" /><verse number="24" style="v" sid="EZK 44:24" />ವ್ಯಾಜ್ಯ ಥಾವಾನಿ ಜ಼ಗಾ ತಿನೆ ತಿರಿಸಾನೆ ಹುಬ್ರೈನ ಮಾರಾ ನ್ಯಾಯವಿಧಿಯೊನೆ ಅನುಸಾರ ಥೈನ ತಿರಿಸಾದೆ; ಮಿ ಕರಲ ಸನ್ನೊಮಾ ಮಾರಾ ನಿಯಮನಿಷ್ಟೆನೆ ಕೈದಿಲಿನ ಮಾರಾ ಸಬ್ಬತ್ತ ಆಚರಣೆ ಕರೆ ನಿಂಗತ ದೆಕಿಲಿವಾದೆ. <verse eid="EZK 44:24" /><verse number="25" style="v" sid="EZK 44:25" />ಮರಲವಾಲಾವೊನಾ ಮುರ್ದಾವೊನಾ ನಜಿಕ ಗೈನ ತ್ಯುನೊನೆ ಅಪವಿತ್ರ ಕರಿಲ್ಯು ನೈ; ತೆನೈಸೊ ಮರಲ ಮಾ, ಬಾಪ, ದಿಕ್ರೊ, ದಿಕ್ರಿ, ಭೈ, ಹಿವಾ ನೈಸೊ ಭೆನ, ಇವ್ನಾಹುತಿ ಯಕ್ಲೊ ತಿನೆ ಅಪವಿತ್ರ ಕರಿಲ್ಯುನೈ; <verse eid="EZK 44:25" /><verse number="26" style="v" sid="EZK 44:26" />ತ್ಯವಾನೆ ಶುದ್ದ ಥಯಲ್ಪರಬಿ ಕ್ಹಾತ ದನ್ನ ಬಿಜಾ಼ ಕರು. <verse eid="EZK 44:26" /><verse number="27" style="v" sid="EZK 44:27" />ತೆ ಸೆವೆ ಕರಾನೆ ಪವಿತ್ರಾಲಯನೆ ಪ್ರವೆಶ ಕರಿನ ಮ್ಹೈನಾ ಪ್ರಾಕಾನ ಜಾ಼ವಾನಾ ದಿನ್ನಮಾ ತಿನಾ ದೊಷಪರಿಹಾರನಾಹುತಿ ಬಲಿ ಅರ್ಪಿಸು; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ. <verse eid="EZK 44:27" /><verse number="28" style="v" sid="EZK 44:28" />ಯಾಜಕೊನೆ ಯಕ್ಕ ಸ್ವಸ್ತ್ಯ ಥಾವಸ; ಮಿಜ಼ ತ್ಯುನೊ ಸ್ವಸ್ತ್ಯ ವ್ಹೈ; ಇಸ್ರಾಯೆಲಮಾ ತ್ಯುನೊನೆ ಕಯಿಜ಼ ಆಸ್ತಿ ದ್ಯುನೈ; ಮಿಜ಼ ತ್ಯುನೊನೆ ಆಸ್ತಿ ವ್ಹೈ. <verse eid="EZK 44:28" /><verse number="29" style="v" sid="EZK 44:29" />ತ್ಯುನೆ ಧಾನ್ಯ ನೈವೆದ್ಯನೆ ದೊಷಪರಿಹಾರಕಯಜ್ಞದ್ರವ್ಯನೆ, ಪ್ರಾಯಶ್ಚಿತ್ತಯಜ್ಞದ್ರವ್ಯನೆ, ಅನುಭವಿಸಾದೆ; ಕ್ಹಾಲಿ ಯಹೊವಾನುಜ಼ ರ‍್ಹವಾದೆ ಕೈನ ಇಸ್ರಾಯೆಲೊ ಹರಕಿ ಕರಿಲಿವಾನು ಕ್ಹಾರು ತ್ಯುನೊನೆ ಸಲ್ಲು. <verse eid="EZK 44:29" /><verse number="30" style="v" sid="EZK 44:30" />ಕ್ಹಾರಾ ಪ್ರಥಮಫಲೊಮಾ ಉತ್ಕ್ರಷ್ಟ ಥಯಲ ತುಮೆ ಮನೆ ಪ್ರತ್ಯೆಕ ಕರಿನ ಸಮರ್ಪಿಸಾನಾ ಕ್ಹಾರಾ ಪದಾರ್ಥೊ ತ್ಯುನೊನೆ ಥೌ; ತುಮಾರು ಘರ ಆಶಿರ್ವಾದನೆ ನೆಲೆ ಥಯೆ ನಿಂಗತ ತುಮೆ ಪಸ್ಟಲ್ಯಾ ಲೊಟನೆ ಯಾಜಕೊನೆ ದ್ಯು. <verse eid="EZK 44:30" /><verse number="31" style="v" sid="EZK 44:31" />ಯಾಜಕೊ ತ್ಯುನೆ ಥೈನ ಮರಿನ ತೆನೈಸೊ ಕಾಡಮೃಗಕ್ಹು ಮರಲ ಪಕ್ಷಿನೆ ರ‍್ಹವಾದೆ ಜಾನವರನೆ ರ‍್ಹವಾದೆ ಕ್ಹೌನೈ.<verse eid="EZK 44:31" /></para>
  <chapter eid="EZK 44" />
  <chapter number="45" style="c" sid="EZK 45" />
  <para style="s">ದೆಶನು ಯಹೊವಾನೊ ವಾಟೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 45:1" />ತುಮೆ ದೆಶನೆ ಸ್ವಾಸ್ತ್ಯ-ಸ್ವಾಸ್ತ್ಯ ಥೈನ ವಾಟತಾಮಾ ಯಕ್ಕ ಭಾಗ ಮಿಸಲ ಥೈನ ಪ್ರತ್ಯೆಕ ಕರಿನ ಯಹೊವಾನೆ ನಮರ್ಪಿಸು; ತೆ ಲಾಂಬಾಮಾ ಕ್ಹಡಾ ಬಾರಾ ಹಜಾ಼ರ ಹತೊ, ಅಗಲಮಾ ದಕ್ಹ ಹಜಾ಼ರ-ಹಜಾ಼ರ ಹತ ವ್ಹತ್ತು; ತೆ ಪುರಾ ಗಾಮ ಸುತ್ತ ಮುತ್ತ ಪರಿಶುದ್ದ ರ‍್ಹೌ. <verse eid="EZK 45:1" /><verse number="2" style="v" sid="EZK 45:2" />ತಿಮಾ ಅಡಿಕ್ಹೊ ಹತೊ ವ್ಹತಾ. ಲಾಂಬಾಮಾ ಅಡಿಕ್ಹೊ ಹತೊ ಅಗಲನು ಚೌಕನಿ ಜ಼ಗಾ ಪವಿತ್ರಾಲಯನೆ ನಿವೆಶನ ಥೈನ ರ‍್ಹವಸ; ತಿನಾ ಸುತ್ತೆ ಅಡಿಕ್ಹೊ ಹತೊ ವ್ಹತಾ. ಅಗಲ ರ‍್ಹಯಲ ಭುಮಿ ರ‍್ಹವಸ. <verse eid="EZK 45:2" /><verse number="3" style="v" sid="EZK 45:3" />ಪೈಲಾ ಅಳತಿ ಕರಲ ಜ಼ಗಾಮಾ ಕ್ಹಡಾ ಬಾರಾ ಹಜಾ಼ರ ಹತೊ ವ್ಹತಾ. ಲಾಂಬು ಪಾಂಚ಼಼ ಹಜಾ಼ರ ಹತೊ ಅಗಲನು ಯಕ್ಕ ಅಂಶನೆ ಅಳತಿ ಕರ; ತಿಮಾ ಅತಿಪರಿಶುದ್ದ ರ‍್ಹಯಲ ಪವಿತ್ರಾಲಯ ರ‍್ಹೌ. <verse eid="EZK 45:3" /><verse number="4" style="v" sid="EZK 45:4" />ಎ ದೆಶಮಾ ಪರಿಶುದ್ದ ಭಾಗ; ಎ ಪವಿತ್ರಾಲಯನಾ ಅರ್ಚಕೊ ಯಹೊವಾನಾ ಸನ್ನಿದಿ ಸೆವಕೊ ಥಯಲ ಯಾಜಕೊನೆ ಸಲ್ಲಾನು ವ್ಹೈ; ಎ ಯಾಜಕೊನಾ ಘರೊನೆ ಅಗ್ರಹಾರ ಥೈನ ಪವಿತ್ರಾಲಯನೆ ಪವಿತ್ರಸ್ಥಾನ ಥೈನ ರ‍್ಹವಸ. <verse eid="EZK 45:4" /><verse number="5" style="v" sid="EZK 45:5" />ದೆವಾಲಯನಾ ಸೆವಕೊ ಥಯಲ ಲೆವಿಯೊ ಗಾಮೊ ಭಾಂದಿಲಿನ ರ‍್ಹಹೆ ಲಿಂಗತ ಕ್ಹಡಾ ಬಾರಾ ಹಜಾ಼ರ ಹತೊ ಲಾಂಬು ಪಾಂಚ಼ ಹಜಾ಼ರ ಹತೊ ಅಗಲನಿ ಜ಼ಗಾ ತ್ಯುನೊನೆ ಸ್ವಾಸ್ತ್ಯ ಥಾವಸ. <verse eid="EZK 45:5" /><verse number="6" style="v" sid="EZK 45:6" />ತುಮೆ ಮನೆ ಸಮರ್ಪಿಸಾನಾ ಪರಿಶುದ್ದ ಭಾಗನಾ ಬಾಜು಼ ಬಾಜು಼ಮಾ ಅಡಿ ಹಜಾ಼ರ ಹತೊ ಅಗಲನು ಕ್ಹಡಾ ಬಾರಾ ಹಜಾ಼ರ ಹತೊ ಲಾಂಬಾ ಜ಼ಗಾನೆ ರಾಜಧಾನಿನೆ ಮ್ಹೈ ಥಯಲ ಜಿಮಿನ ಐನ ನೆಮಿಸು; ತಿಮಾ ಇಸ್ರಾಯೆಲ ಕ್ಹಾರಾ ವಂಶವಾಲಾವೊನೆ ಹಕ್ಕ ರ‍್ಹವಸ.<verse eid="EZK 45:6" /></para>
  <para style="s">ಮುಖಂಡೊ</para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 45:7" />ಪ್ರಭುನು ಸ್ವಾಸ್ತ್ಯ ತುಮೆ ಮಿಸಲ ಕರಲ ಸಮರ್ಪಿಸಾನಿ ಜ಼ಗಾನೆ ರಾಜಧಾನಿನೆ ಮ್ಹೈ ಥಯಲ ಜಿಮಿನನೆ ಉಭಯಪಾರ್ಶ್ವ ರ‍್ಹವಸ; ತುಮೆ ಮಿಸಲ ಕರಲ ಸಮರ್ಪಿಸಾನಾ ಜ಼ಗಾನಾ ವರಿ ರಾಜಧಾನಿನೆ ಮ್ಹೈ ಥಯಲ ಜಿಮಿನನಾ ಪಡುವಲಮಾ ತೆ ಪಡುವಲನೆ ಹರಡಸ, ಪುರ್ವಮಾ ಪುರ್ವನೆ ಹರಡಸ, ತೆ ಲಾಂಬಾಮಾ ಪಡುವಲತು ಪರ್ವನೆ ಯಕಕ ಕುಲನು ಸ್ವಾಸ್ತ್ಯ ಲಾಂಬಾನೆ ಸರಿಸಮಾ ರ‍್ಹವಸ. <verse eid="EZK 45:7" /><verse number="8" style="v" sid="EZK 45:8" />ತೆ ತಿನೆ ಇಸ್ರಾಯೆಲಮಾ ಜಿಮಿನ ಸ್ವಾಸ್ತ್ಯ ಥಾವಸ; ಇತ್ತಿ ಉಪ್ಪರ ಪ್ರಭುವೊ ಮಾರಾ ಮನಕ್ಹೊನೆ ಹಿಂಸೆ ನೈ ಕರ್ತಾ; ದೆಶನಿ ಜಿಮಿನನೆ ಇಸ್ರಾಯೆಲೊನೆ ಕುಲತಾ ಕುಲನೆ ವಾಟಸ.<verse eid="EZK 45:8" /></para>
  <para style="s">ಮುಖಂಡೊನೆ ರ‍್ಹಯಲ ನಿಯಮ</para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 45:9" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ- ಇಸ್ರಾಯೆಲನಾ ಪ್ರಭುವೊ, ಹಬ್ದಾ ಬಸ್ಸ, ಬಸ್ಸ; ಕೊಳ್ಳೆನೆ ಬಲಾತ್ಕಾರನೆ ತ್ಯಜಿಸಿನ ನಿತಿನ್ಯಾಯನೆ ಚ಼ಲಾವೊ; ಮಾರಾ ಮನಕ್ಹೊನಾ ಬಾಧ್ಯತೆನೆ ಚು಼ಕೈನ ಅನ್ಯಾಯನೆ ಛೊಡಿ ಪಡೊ; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ, <verse eid="EZK 45:9" /><verse number="10" style="v" sid="EZK 45:10" />ತುಮಾರಾ ತಕ್ಕಡಿಮಾ ಧಾನ್ಯನಿ ಅಳತಿ ರಸದ್ರವ್ಯನಿ ಅಳತಿ ನ್ಯಾಯ ಥೈನ ರ‍್ಹೌ. <verse eid="EZK 45:10" /><verse number="11" style="v" sid="EZK 45:11" />ಎಫಾ (ಕವಾನಾ ಧಾನ್ಯನಿ ಅಳತಿ) ವರಿ ಬತ್ (ಕವಾನಾ ರಸದ್ರವ್ಯನಿ ಅಳತಿ) ಯಕ್ಕಜ಼ ಪ್ರಮಾಣ ರ‍್ಹಯಲ ವ್ಹೈ; ಬತ್ ಕವಾನು ಹೊಮೆರನಾ ದಕ್ಹಮಾ ಯಕ್ಕ ಪಾಲ; ಎಫಾ ಕವಾನು ಹೊಮೆರಿನ ದಕ್ಹಮಾ ಯಕ್ಕ ಪಾಲ ವ್ಹೈ; ಎ ಬೆ ಹೊಮೆರ ಅಳತಿನೆ ಸಂಬಂಧ ರ‍್ಹೌ. <verse eid="EZK 45:11" /><verse number="12" style="v" sid="EZK 45:12" />ತೊಲೆ ಇಕ್ಹ ತೊಲಾ ತುಕಾ ರ‍್ಹೌ; ತುಮೊಮಾ ದಿವಾನಾ ಮಾನೆ ಇಕ್ಹ, ಪಚ್ಚಕ್ಹ (ನೈತೊ) ಪಂದ್ರಾ ತೊಲಾ ತುಕಾನು ರ‍್ಹೌ. <verse eid="EZK 45:12" /><verse number="13" style="v" sid="EZK 45:13" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ, ತುಮೆ ತುಮಾರಾ ದೊಷಪರಿಹಾರನಾಹುತಿ ಧಾನ್ಯ ನೈವೆದ್ಯನೆ ಸರ್ವಾಂಗಹೊಮನೆ ಸಮಾಧಾನ ಯಜ್ಞನೆ ಕರಾವಾನಾಹುತಿ ಸಮರ್ಪಿಸಾನು ಸುವೈ ಕದ್ಯಾಮ ಯಕ್ಕ ಹೊಮರ್ ಅಳತಿನಿ ಘೌಂಮಾ ಎಫಾ ಅಳತಿನು ಛೆಮಾ ಯಕ್ಕ ಪಾಲ; ಯಕ್ಕ ಹೊಮರ್ ಅಳತಿನಿ ಜವೆಘೌಂಮಾ ಎಫಾ ಅಳತಿನು ಛೆಮಾ ಯಕ್ಕ ಪಾಲ ವ್ಹೈ; <verse eid="EZK 45:13" /><verse number="14" style="v" sid="EZK 45:14" />ಯಕ್ಕ ಬತ್ ತೆಲಮಾ ಸಮರ್ಪಿಸಾನು ಭಾಗ ಕಕ್ಲು ವ್ಹೈ ಕದ್ಯಾಮ ಯಕ್ಕ ಕೊರ ಕದ್ಯಾಮ ದಕ್ಹ ಬತ್ ತೆನೈಸೊ ಯಕ್ಕ ಹೊಮೆರ ಅಳತಿನಿ ತೆಲಮಾ ಯಕ್ಕ ಬತ್ ಅಳತಿನು ದಕ್ಹಮಾ ಯಕ್ಕ ಪಾಲ ವ್ಹೈ; ದಕ್ಹ ಬತ್ ಕದ್ಯಾಮ ಯಕ್ಕ ಹೊಮೆರ ವ್ಹೈ; <verse eid="EZK 45:14" /><verse number="15" style="v" sid="EZK 45:15" />ಬೆಕ್ಹೊ ಬಕ್ರಾವೊಮಾ ಇಸ್ರಾಯೆಲನಾ ನಿರಾವರಿನಾ ಹುಲ್ಗವಲನು ಯಕ್ಕ ಬಕ್ರು ವ್ಹೈ; <verse eid="EZK 45:15" /><verse number="16" style="v" sid="EZK 45:16" />ಎ ಕ್ಹಾರಾನೆ ದೆಶನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊ ಇಸ್ರಾಯೆಲನಾ ಮುಖಂಡೊ ವಪ್ಪಿಸು. <verse eid="EZK 45:16" /><verse number="17" style="v" sid="EZK 45:17" />ಸನ್ನೊಮಾ ಅಮಾವಾಸೊಮಾ ಸಬ್ಬತ್ತೊಮಾ ಇಸ್ರಾಯೆಲ ವಂಶವಾಲಾವೊನೆ ನೆಮಕ ಥಯಲ ಕ್ಹಾರಾ ಸನ್ನೊಮಾ ಸರ್ವಾಂಗಹೊಮಪಶು, ಧಾನ್ಯನೈವೆದ್ಯ, ಪಾನನೈವೆದ್ಯ, ಎಕ್ಹಾರು ಒದಗಿಸಾನು ಮುಖಂಡ ಕರ್ತವ್ಯ ವ್ಹೈ; ಇಸ್ರಾಯೆಲ ವಂಶನಾ ದೆಷನಿವಾರಣೆನಾಹುತಿ ತೆ ದೊಷಪರಿಹಾರಕ ಯಜ್ಞಪಶು,ಧಾನ್ಯನೈವೆದ್ಯ, ಸರ್ವಾಂಗಹೊಮಪಶು, ಸಮಾಧಾನಯಜ್ಞಪಶು, ಎಕ್ಹಾರು ವಪ್ಪಿಸು.<verse eid="EZK 45:17" /></para>
  <para style="s">ಸನ್ನೊ</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 45:18" />ಕರ್ತಾ ಥೈಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ, ಯಕ್ವಾ ಮ್ಹೈನಾನಾ ಯಕ್ವಾ ದಿನ್ನಮಾ ತು ಪುರಾ ಅಂಗ ರ‍್ಹಯಲ ಹೊರಿನೆ ಇನಿಲಿನ ತಿಕ್ಹು ಪವಿತ್ರಾಲಯನೆ ಶುದ್ದಿ ಕರು. <verse eid="EZK 45:18" /><verse number="19" style="v" sid="EZK 45:19" />ತೆಳಾಮಾ ಯಾಜಕ ತೆ ದೊಷಪರಿಹಾರಕಯಜ್ಞಪಶುನಾ ರಗತಮಾ ದಕ್ಹು ಲಿನ ದೆವಸ್ಥಾನನಾ ಬಾಕಲನಾ ಚೌಕಟ್ಟನೆ ಯಜ್ಞವೆದಿನಾ ಮ್ಹೊಟಾ ಅಂತಸ್ತನಾ ಚಾರೆ ಮುಲಾವೊನೆಬಿ ಮ್ಹೈನಾ ಪ್ರಾಕಾರನಾ ಹೆಬ್ಬಾಗಿನಾ ನಿಲವುಖಂಬಾವೊನೆಬಿ ಲಗಾಡು. <verse eid="EZK 45:19" /><verse number="20" style="v" sid="EZK 45:20" />ತಿನಾ ನಿಂಗತಜ಼ ಕ್ಹಾತವಾ ಮ್ಹೈನಾನಾ ಯಕ್ವಾ ದಿನ್ನಮಾ ತು ಯಜ್ಞ ಕರಿನ ಕುನ್ನತಬಿ ಅಕಸ್ಮಾತ ಥೈನ ಕರಲ ತಪ್ಪಕ್ಹು ರ‍್ಹವಾದೆ ಗ್ಯಾನ ನೈರ‍್ಹಯಲವಾಲಾವೊನಾ ದೆವಾಲಯನೆ ಥಯಲ ಪುರಾ ದೊಷನೆ ಪರಿಹರಸು. <verse eid="EZK 45:20" /><verse number="21" style="v" sid="EZK 45:21" />ಯಕ್ವಾ ಮ್ಹೈನಾನಾ ಚೌದಾವಾ ದಿನ್ನಮಾ ಕ್ಹಾತ ದಿನ್ನ ಲಕ್ಕಾ ಪಸ್ಕ ಸನ್ನ ಆಚರಣೆ ಕರ್ತಾ ರ‍್ಹೌ; ಕ್ಹಾಟು ನೈ ರ‍್ಹಯಲ ರೊಕ್ಲಾನೆಜ಼ ಕ್ಹೌ. <verse eid="EZK 45:21" /><verse number="22" style="v" sid="EZK 45:22" />ತೆ ದಿನ್ನಮಾ ಮುಖಂಡ ತಿನಾಕ್ಹು ದೆಶನಾ ಕ್ಹಾರಾ ಮನಕ್ಹೊಕ್ಹು ದೊಷಪರಿಹಾರ ಯಜ್ಞನಾಹುತಿ ಯಕ್ಕ ಹೊರಿನೆ ಒಪ್ಪಿಸಾದೆ. <verse eid="EZK 45:22" /><verse number="23" style="v" sid="EZK 45:23" />ಸನ್ನನಾ ಕ್ಹಾತ ದಿನ್ನಮಾಬಿ ಯಹೊವಾನೆ ಸಮರ್ಪಿಸಾನು ಸರ್ವಾಂಗಹೊಮನಾಹುತಿ ತೆ ಕ್ಹಾತ ದಿನ್ನ ಲಕ್ಕಾ ದಿನ್ನ ಯಕ್ಕ ಪುರಾ ಅಂಗ ರ‍್ಹಯಲ ಕ್ಹಾತ ಹೊರಿಯೊ ಕ್ಹಾತ ಟಗರೊ ದಿವಾದೆ, ವರಿ ದೊಷಪರಿಹಾರಕಯಜ್ಞನಾಹುತಿ ದಿನ್ನೆ ಯಕ್ಕ ಹೊತನೆ ದಿವಾದೆ. <verse eid="EZK 45:23" /><verse number="24" style="v" sid="EZK 45:24" />ಎನೈಸೊ ಯಕ್ಕೆಕ ಹೊರಿ ವರಿ ಟಗರನಾ ಕ್ಹಾತೆ ಮುವತ್ತ-ಮುವತ್ತ ಸೆರ (ಘೌಂನೊ ಲೊಟನೆ) ಛೆ ಛೆ ಸೆರ ತೆಲನೆ ಧಾನ್ಯನೈವೆದ್ಯನಾಹುತಿ ವಪ್ಪಿಸೌ. <verse eid="EZK 45:24" /><verse number="25" style="v" sid="EZK 45:25" />ಕ್ಹಾತವಾ ಮ್ಹೈನಾನಾ ಪಂದ್ರಾವಾ ದಿನ್ನಮಾ ಶುರು ಥಾವಾನಾ ಸನ್ನನಾ ಕ್ಹಾತವಾ ದಿನ್ನಮಾಬಿ ತೆ ದೊಷಪರಿಹಾರಕಯಜ್ಞಪಶು, ಸರ್ವಾಂಗಹೊಮಪಶು, ಧಾನ್ಯನೈವೆದ್ಯ, ತೆಲ, ಎಕ್ಹಾರು ತೆಜ಼ ಕ್ರಮ ನಿಂಗತ ದ್ಯು.<verse eid="EZK 45:25" /></para>
  <chapter eid="EZK 45" />
  <chapter number="46" style="c" sid="EZK 46" />
  <para style="s">ಮುಖಂಡ ವರಿ ಸನ್ನೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 46:1" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಹಪ್ತಾಮಾ ಕಾಮ ಥಾವಾನಾ ಛೆ ದಿನ್ನಮಾ ಮ್ಹೈನಾ ಪ್ರಾಕರನಾ ಪುರ್ವ ಹೆಬ್ಬಗಿಲ ಝಾಕ್ಯಲ ರ‍್ಹೌ; ತೆನೈಸೊ ಸಬ್ಬತ ದಿನ್ನಮಾಬಿ ಅಮಾಸಮಾಬಿ ಕಾಡಲ ರ‍್ಹೌ. <verse eid="EZK 46:1" /><verse number="2" style="v" sid="EZK 46:2" />ಮುಖಂಡ ಭಾರಲ್ಯಾ ಕೈಸಾಲೆನಾ ವಾಟತಾ ತೆ ಹೆಬಾಗಿಲನೆ ಪ್ರವೆಶ ಕರಿನ ಬಾಕಲ ನಿಲವುಕಂಬನಾ ಬಾಜು಼ಮಾ ಹುಬ್ರೈನ ತೆ ವಪ್ಪಿಸಲ ಸರ್ವಾಂಗಹೊಮಪಶುನೆ ಸಮಾಧಾನಯಜ್ಞಪಶುನೆ ಯಾಜಕೊ ಅರ್ಪಿಸ್ತಾಮಾ ಬಾಕಲನಾ ಹೊಚ್ಚಲಮಾ ಅಡ್ಡ ಪಡಾದೆ; ಪಾಚ಼ಲ್ತಾ ಜೈ಼ಪಡಾದೆ; ತೆ ದಿನ್ನ ಕ್ಹಾಂಜ಼ ಲಕ್ಕಾ ಬಾಕಲನೆ ಝಾಕು ನೈ. <verse eid="EZK 46:2" /><verse number="3" style="v" sid="EZK 46:3" />ಸಬ್ಬತ ದಿನ್ನಮಾಬಿ ಅಮಾಸಮಾಬಿ ದೆಶನಾ ಮನಕ್ಹೊ ತೆ ಹೆಬ್ಬಗಿಲನಾ ದ್ವಾರನಾ ಕ್ಹಾಮಾ ಯಹೊವಾನಾ ಸಮ್ಮುಖಮಾ ಅಡ್ಡಪಡಾದೆ. <verse eid="EZK 46:3" /><verse number="4" style="v" sid="EZK 46:4" />ಸಬ್ಬತ ದಿನ್ನಮಾ ಪ್ರಭು ಯಹೊವಾನೆ ಪುರಾ ಅಂಗ ರ‍್ಹಯಲ ಛೆ ಬಕ್ರಾ ಪುರಾ ಅಂಗ ರ‍್ಹಯಲ ಯಕ್ಕ ಟಗರನೆ ಸರ್ವಾಂಗಹೊಮ ಥೈನ ಅರ್ಪಿಸು; <verse eid="EZK 46:4" /><verse number="5" style="v" sid="EZK 46:5" />ಟಗರನಾ ಕ್ಹಾತೆ ಮುವತ್ತ ಸೆರ ಘೌಂನೊ ಲೊಟ ಬಕ್ರಾವೊನಾ ಕ್ಹಾತೆ ತಾಕತ ರ‍್ಹಯಲ ತೆಕ್ಲು ಘೌಂನು ಲೊಟ ಮುವತ್ತ-ಮುವತ್ತ ಸೆರ ಘೌಂನು ಲೊಟ ಛೆ ಛೆ ಸೆರ ನಿಂಗತ ತೆಲನೆ ಧಾನ್ಯನೈವೆದ್ಯನಹುತಿ ದಿವಾದೆ. <verse eid="EZK 46:5" /><verse number="6" style="v" sid="EZK 46:6" />ಅಮಾಸಮಾ ತೆ ಪುರಾ ಅಂಗ ರ‍್ಹಯಲ ಯಕ್ಕ ಹೊರಿನೆ ಛೆ ಬಕ್ರಾವೊನೆ ಯಕ್ಕ ಟಗರ ವಪ್ಪಿಸೌ; ತೆ ಪುರಾ ಅಂಗ ಥೈನಜ಼ ರ‍್ಹೌ; <verse eid="EZK 46:6" /><verse number="7" style="v" sid="EZK 46:7" />ವರಿ ಹೊರಿನಾ ಕ್ಹಾತೆ ಮುವತ್ತ ಸೆರ, ಟಗರನಾ ಕ್ಹಾತೆ ಮುವತ್ತ ಸೆರ, ಬಕ್ರಾವೊನಾ ಕ್ಹಾತೆ ತಾಕತ ರ‍್ಹಯಲ ತೆಕ್ಲು ಸೆರ ಘೌಂನೊ ಲೊಟ ಮುವತ್ತ-ಮುವತ್ತ ಸೆರನೆ ಛೆ ಛೆ ಸೆರ ನಿಂಗತ ತೆಲ ಧಾನ್ಯನೈವೆದ್ಯನಾಹುತಿ ಒದಗಿಸು.<verse eid="EZK 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 46:8" />ಮುಖಂಡ ಪ್ರವೆಶ ಕರ್ತಾಮಾ ಹೆಬ್ಬಾಗಿಲ ಕೈಸಾಲೆನಾ ವಾಟತಾ ಮಳಿನ ತೆಜ಼ ವಾಟತಾ ಜಾ಼ವಾದೆ. <verse eid="EZK 46:8" /><verse number="9" style="v" sid="EZK 46:9" />ದೆಶನಾ ಮನಕ್ಹೊತೊ ಸನ್ನೊಮಾ ಯಹೊವಾನಾ ಸಮ್ಮುಖಮಾ ಧಿಕ್ಹತಾಮಾ ಉತ್ತರ ದಿಕ್ಕ ಬಾಕಲತಾ ಆರಾಧನೆ ಕರಾನೆ ಪ್ರವೆಶ ಕರಲವಾಲೊ ಪಶ್ಚಿಮ ಬಾಕಲತೊ ಜಾ಼ವಾದೆ; ಪಶ್ಚಿಮ ಬಾಕಲತೊ ಆಯಲವಾಲೊ ಉತ್ತರ ದಿಕ್ಕ ಬಾಕಲತೊ ಜಾ಼ವಾದೆ; ತೆ ಪ್ರವೆಶ ಕರಲ ಬಾಕಲತೊ ವಾಪಸ ಗಯಾವಾಚಿ ಆಯಲ ಮ್ಹೊಡಾಕ್ಹುಜ಼ ಜಾ಼ವಾದೆ. <verse eid="EZK 46:9" /><verse number="10" style="v" sid="EZK 46:10" />ಮನಕ್ಹೊ ಪ್ರವೆಶ ಕರ್ತಾಮಾ ಪ್ರಭು ತ್ಯುನಾ ವಚ್ಮಾ ಪ್ರವೆಶ ಕರಾದೆ; ತ್ಯುನೆ ಜಾ಼ತಾಮಾ ತೆಬಿ ಜಾ಼ವಾದೆ. <verse eid="EZK 46:10" /><verse number="11" style="v" sid="EZK 46:11" />ಮುಖಂಡ ಉತ್ಸವೊಮಾ ಸನ್ನೊಮಾ ಹೊರಿನಾ ಕ್ಹಾತೆ ಮುವತ್ತ ಸೆರ, ಟಗರನಾ ಕ್ಹಾತೆ ಮುವತ್ತ ಸೆರ, ಬಕ್ರಾವೊನಾ ಕ್ಹಾತೆ ತಾಕತ ರ‍್ಹಯಲ ತೆಕ್ಲಿ ಸೆರ ಘೌಂನಾ ಲೊಟನೆ ಮುವತ್ತ-ಮುವತ್ತ ಸೆರನೆ ಛೆ ಛೆ ಸೆರ ನಿಂಗತ ತೆಲನೆ ಧಾನ್ಯನೈವೆದ್ಯನಾಹುತಿ ಒದಗಿಸು. <verse eid="EZK 46:11" /><verse number="12" style="v" sid="EZK 46:12" />ಮುಖಂಡ ಸ್ವಂತ ಇಚ್ಛಾಕ್ಹು ಕಾಣಕಿ ರ‍್ಹವಾದೆ ಸರ್ವಾಂಗಹೊಮ ರ‍್ಹವಾದೆ ಸಮಾದಾನ ಯಜ್ಞನೆ ರ‍್ಹವಾದೆ ಯಹೊವಾನೆ ಸಮರ್ಪಿಸ್ತಾಮಾ ತಿನಾಹುತಿ ಪುರ್ವ ಹೆಬ್ಬಾಗಿಲನೆ ಕಾಡು; ತೆ ಸಬ್ಬತ ದಿನ್ನಮಾ ಸಮರ್ಪಿಸೆ ನಿಂಗತ ಸರ್ವಾಂಗಹೊಮಪಶುನೆ ರ‍್ಹವಾದೆ ಸಮಾಧಾನ ಯಜ್ಞಪಶುನೆ ಸಮರ್ಪಿಸಿನ ಜಾ಼ವಾದೆ; ಗಯಲ್ಪರ ಬಾಕಲ ಝಾಕು.<verse eid="EZK 46:12" /></para>
  <para style="s">ಹರದಿನ್ನನಿ ಬಲಿ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 46:13" />ತು ಪುರಾ ಅಂಗ ರ‍್ಹಯಲ ವರಕ್ಹನು ಬಕ್ರಾನೆ ಯಹೊವಾನೆ ಸರ್ವಾಂಗಹೊಮ ಥೈನ ದಿನ್ನೆ ಅರ್ಪಿಸು; ಹರದಿನ್ನ ಪಾಟೆ ತಿನೆ ಅರ್ಪಿಸು. <verse eid="EZK 46:13" /><verse number="14" style="v" sid="EZK 46:14" />ತಿನಾಕ್ಹಾತೆ ಹರದಿನ್ನ ಪಾಟೆ ಧಾನ್ಯನೈವೆದ್ಯ ಥೈನ ಪಾಂಚ಼಼ ಸೆರ ಘೌಂನಾ ಲೊಟನೆ ತಿನೆ ಪಗ್ಳಾವಾನೆ ಬೆ ಸೆರ ತೆಲನೆ ತು ಸಮರ್ಪಿಸು; ಎಕ್ಹಾರು ಹರಹಮೆಶಾ ಯಹೊವಾನೆ ಧಾನ್ಯನೈವೆದ್ಯ ಥೈನ ಅರ್ಪಿಸು; ಎ ಹಮೆಶಾನು ನಿಯಮ ವ್ಹೈ. <verse eid="EZK 46:14" /><verse number="15" style="v" sid="EZK 46:15" />ಯಾಜಕೊ ಬಕ್ರಾನೆ ಧಾನ್ಯ ನೈವೆದ್ಯನೆ ತೆಲನೆ ಹಮೆಶಾ ಸರ್ವಾಂಗಹೊಮ ಥೈನ ಹರದಿನ್ನ ಪಾಟೆ ಸಮರ್ಪಿಸು.<verse eid="EZK 46:15" /></para>
  <para style="s">ಮುಖಂಡ ವರಿ ಜ಼ಗಾ</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 46:16" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ ಪ್ರಭು ತಿನಾ ಬಚ್ಚಾವೊಮಾ ಯಕ್ಲಾನೆ ಭುದಾನ ಕರ‍್ಯೊಮ ತೆ ಬಾಪನು ಸ್ವಾಸ್ತ್ಯ ಥಯಲಕ್ಹು ಬಚ್ಚಾವೊನೆ ಹಕ್ಕ ಆವಸ, ತೆ ಬಾಧ್ಯ ಥೈನ ಮಳಲ ಸ್ವಾಸ್ತ್ಯಜ಼ ವ್ಹೈ. <verse eid="EZK 46:16" /><verse number="17" style="v" sid="EZK 46:17" />ತೆನೈಸೊ ಮುಖಂಡ ತಿನಾ ಜಿಮಿನನು ಯಕ್ಕ ಭಾಗ ತಿನಾ ಸೆವಕೊಮಾ ಯಕ್ಲಾನೆ ದಾನ ಕರ‍್ಯೊಮ ಬಿಡುಗಡೆನಾ ವರಕ್ಹ ಲಕ್ಕಾ ತೆ ತಿನಾ ಅದಿನ ಥಾವಸ; ಪಾಚ಼ಲ್ತು ತೆ ಫರಿನ ಪ್ರಭುನಾ ವಶ ಥಾವಸ; ತೆನೈಸೊ ಪ್ರಭು ತಿನಾ ಬಚ್ಚಾವೊನೆ ದಿದಲ ಸ್ವಾಸ್ತ್ಯ ತ್ಯುನೊನೆ ಮಳಸ. <verse eid="EZK 46:17" /><verse number="18" style="v" sid="EZK 46:18" />ಎನೈಸೊ ಪ್ರಭು ಮನಕ್ಹೊನಾ ಪಿತ್ರಾರ್ಜಿತ ಜಿಮಿನನೆ ಸ್ವಾದಿನ ಕರಿಲಿನ ತ್ಯುನಿ ಬಾಧ್ಯತೆನೆ ತಪ್ಪಿಸು ನೈ; ಸ್ವಂತ ಜಿಮಿನನೆಜ಼ ಭಾಗ ಕರಿನ ತಿನಾ ಬಚ್ಚಾವೊನೆ ಪಾಲ ದಿವಾದೆ; ನೈತೊ ಮಾರಾ ಮನಕ್ಹೊಮಾ ಹರಯಕ್ಲೊ ತ್ಯುನಾ ತ್ಯುನಾ ಭುಸ್ಥಿತಿನೆ ಜ಼ವೈಲಿನ ದೆಕ್ಕಾಪಾಲ ಥಯನ ಜಾ಼ಸ.<verse eid="EZK 46:18" /></para>
  <para style="s">ದೆವಾಲಯನಾ ಅನ್ನ ಕರಾನಿ ಖೊಲಿ</para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 46:19" />ಪಾಚ಼ಲ್ತೊ ತೆ ಮನಕ್ಹ ಮನೆ ಹೆಬ್ಬಾಗಿಲನಾ ಬಾಜು಼ನು ಪ್ರವೆಶನಾ ವಾಟತಾ ಉತ್ತರ ದಿಕ್ಕನೆ ಅಭಿಮುಖ ಥೈನ ಯಾಜಕೊನೆ ನೆಮಕ ಥಯನಬಿ ರ‍್ಹವಾನಾ ಪರಿಶುದ್ದ ರ‍್ಹಯಲ ಕ್ಹೊಲಿಯೊನೆ ಬಲೌಸ; ದೆಕ, ತ್ಯುನಾ ಪಾಚೊ಼ ಪಡುವಲಮಾ ಯಕ್ಕ ಜ಼ಗಾ ವ್ಹತ್ತಿ. <verse eid="EZK 46:19" /><verse number="20" style="v" sid="EZK 46:20" />ತೆಳಾಮಾ ತೆ ಮನೆ ಯಾಜಕೊ ಹವಿಸ್ಸನೆ ಭಾರಲ್ಯಾ ಪ್ರಾಕಾರನೆ ಲಿನಗೈನ ಮನಕ್ಹೊನೆ ಶುದ್ದ ಕರೆ ನೈಸೊ ಪ್ರಾಯಶ್ಚಿತ್ತಯಜ್ಞಪಶುನಾ ವರಿ ದೊಷಪರಿಹಾರಕಯಜ್ಞಪಶುನು ಮಾಕ್ಹನೆ ಚ಼ಡಾವಾನೆ ಧಾನ್ಯನೈವೆದ್ಯನೆ ಪಕ್ವ ಕರಾನೆಬಿ ಎ ಜ಼ಗಾ ಥಯಲ ಛೆ ಕೈನ ಕದ್ಯೊ. <verse eid="EZK 46:20" /><verse number="21" style="v" sid="EZK 46:21" />ಪಾಚ಼ಲ್ತೊ ತೆ ಮನೆ ಭಾರಲ್ಯಾ ಪ್ರಾಕಾರನೆ ಲಿನ ಐನ ತ್ಯಾನಾ ಚಾರ ಮುಲಾವೊನಿ ವಾಟತೊ ಬಲೈಲಿನ ಗಯೊ; ದೆಕ, ದ್ರಾಕಾರನಾ ಯಕ್ಕೆಕ್ಕ ಮುಲಾಮಾ ಯಕ್ಕೆಕ್ಕ ಮ್ಹೈನಿ ಅಂಗಳಾ ದಿಕ್ಹಿ. <verse eid="EZK 46:21" /><verse number="22" style="v" sid="EZK 46:22" />ಹೊ, ಪ್ರಾಕಾರನಾ ಚಾರೆ ಮುಲಾವೊಮಾಬಿ ಇಕ್ಹ ಹತೊ ಲಾಂಬಾಮಾ ಪಂದ್ರಾ ಹತೊ ಅಗಲಮಾ ಪ್ರತ್ಯೆಕ ರ‍್ಹಯಲ ಅಂಗಳಾ ವ್ಹತ್ತಾ; ಮುಲಾವೊಮಾನಾ ತೆ ಚಾರೆ ಅಂಗಳಾ ಯಕ್ಕಜ಼ ಅಳತಿ ವ್ಹತ್ತಾ. <verse eid="EZK 46:22" /><verse number="23" style="v" sid="EZK 46:23" />ತಿಮಾ ಸುತ್ತ, ಕದ್ಯಾಮ ತೆ ಚಾರ ಅಂಗಳಾನಾ ಸುತ್ತ ಮುತ್ತ ದಗ್ಡಾವೊನಾ ವರಸೆ ಚಾಚುತು; ತೆ ವರಸೆನಾ ಹೆಟಾ ಚು಼ಲ್ಲಾ ಸುತ್ತೆ ಭಾಂದಲ ವ್ಹತ್ತಾ. <verse eid="EZK 46:23" /><verse number="24" style="v" sid="EZK 46:24" />ತೆಳಾಮಾ ತೆ ಮನೆ ಎ ದೆವಾಲಯನಾ ಸೆವಕೊ ಯಜ್ಞಪಶುವೊನೆ ಲಾಯಲ ಮನಕ್ಹೊನಾಹುತಿ ತ್ಯುನಾ ಮಾಕ್ಹನೆ ಛಡಾವಾನಿ ಪಾಕಶಾಲೆ ವ್ಹೈ ಕದ್ಯೊ.<verse eid="EZK 46:24" /></para>
  <chapter eid="EZK 46" />
  <chapter number="47" style="c" sid="EZK 47" />
  <para style="s">ದೆವಸ್ಥಾನತು ಆವಾನು ವಕಳೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 47:1" />ಪಾಚ಼ಲ್ತೊ ತೆ ಮನೆ ದೆವಸ್ಥಾನನಾ ಬಾಕಲಕನ ವರಿ ಬಲೈಲಿನ ಆಯೊ; ಆಹಾ, ದೆವಸ್ಥಾನನು ಹೊಚ್ಚಲ ಹೆಟಾತೊ ಪಾನಿ ಗೈನ ಪುರ್ವನೆ ಹರದಾಡಾಡುತು ದೆವಸ್ಥಾನ ಪುರ್ವ ಅಭಿಮುಖ ತೆಕ್ಲುಜ಼; ತೆ ಪಾನಿ ದೆವಸ್ಥಾನನಾ ಬಲಗಡೆ ಹೆಟಾತು ಗಯಲ ಯಜ್ಞವೆದಿನಾ ದಕ್ಷಿಣಮಾ ಹರದಾಡಾಡುತು. <verse eid="EZK 47:1" /><verse number="2" style="v" sid="EZK 47:2" />ತೆಳಾಮಾ ತೆ ಮನೆ ಉತ್ತರ ದಿಕ್ಕ ಹೆಬ್ಬಾಗಿಲತೊ ದೆವಾಲಯನಾ ಭಾರಲ್ಯಾ ವಾಟತು ಸುತ್ತಿಲಿನ ಪುರ್ವ ಹೆಬ್ಬಾಗಿಲನೆ ಬಲೈಲಿನ ಆಯೊ; ತ್ಯಾ ದೆಕಾನೆ ತಿನಾ ಢಾವಾ ಬನಿ ಹಲ್ಲು ಹಲ್ಲು ಹರದಾನು ಪಾನಿ ದಿಕ್ಹ್ಯು. <verse eid="EZK 47:2" /><verse number="3" style="v" sid="EZK 47:3" />ತೆ ಮನಕ್ಹ ಹತ್ತಮಾ ಹುರಿ ಧರಿಲಿನ ಪುರ್ವನೆ ಪಾಂಚ಼ಕ್ಹೊ ಹತೊ ಅಳತಿ ಕರಿನ ಮನೆ ಪಾನಿನಾ ಹಿಂಗೆನಾ ಬನಿ ದಟಾಡ್ಯೊ; ತ್ಯಾ ಪಾನಿ ಹೆಜ್ಜಿ ಡುಬಾವರ್ಕ್ಹು ವ್ಹತ್ತು. <verse eid="EZK 47:3" /><verse number="4" style="v" sid="EZK 47:4" />ತೆ ವರಿ ಪಾಂಚ಼ಕ್ಹೊ ಹತೊ ಅಳತಿ ಕರಿನ ಮನೆ ಪಾನಿನಾ ಹಿಂಗೆ ದಟಾಡತಾಮಾ ತೆ ಪಾನಿ ಕುಡ್ಗಾ ಲಕ್ಕಾ ವ್ಹತ್ತು. ತೆ ವರಿ ಪಾಂಚ಼ಕ್ಹೊ ಹತೊ ಅಳತಿ ಕರಿನ ಮನೆ ಪಾನಿನಾ ಹಿಂಗೆ ದಟಾಡತಾಮಾ ಪಾನಿ ಕಂಬರ ಲಕ್ಕಾ ವ್ಹತ್ತು. <verse eid="EZK 47:4" /><verse number="5" style="v" sid="EZK 47:5" />ತೆ ವರಿ ಪಾಂಚ಼ಕ್ಹೊ ಹತೊ ಅಳತಿ ಕರ‍್ಯೊ;ತೆ ಮಕ್ಹು ದಾಟಾನೆ ನೈ ಥಾವಾನು ತೊರೆ ವ್ಹತ್ತು; ಪಾನಿ ಉಚ್ಚು ಥೈನ ಇಶಾಡಾ ಅಕ್ಲು ಪ್ರವಾಹ ವ್ಹತ್ತು; ದಾಟಾನೆ ನೈ ಥಾವಾನು ತೊರೆ ಥಯುತು. <verse eid="EZK 47:5" /><verse number="6" style="v" sid="EZK 47:6" />ತೆಳಾಮಾ ತೆ ಮನೆ- ನರನಾ ದಿಕ್ರಾ ಎ ದೆಕ್ಯೊಸ ಸು? ಕೈನ ಪುಚ್ಚಿನ ಮನೆ ತೊರೆನಾ ದಂಡಿಯೆ ಛಡೈನ ಪಾಚೊ಼ ಫರಾಯೊ. <verse eid="EZK 47:6" /><verse number="7" style="v" sid="EZK 47:7" />ಮಿ ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಆಹಾ, ತೊರೆನಾ ಭಂಬಿ ದಂಡಿಯೊಮಾ ಘನ್ನಾ ಘನ್ನಾ ಝಾಡೊ ದಿಕ್ಹ್ಯಾ. <verse eid="EZK 47:7" /><verse number="8" style="v" sid="EZK 47:8" />ತೆಳಾಮಾ ತೆ ಮನೆ ಅಮ್ಮ ಕದ್ಯೊ ಎ ಪ್ರವಾಹ ಪುರ್ವ ಗಾಮೆ ಗೈನ ಅರಾಬ ಕವಾನಾ ತಗ್ಗೆ ಉಟ್ರಿನ ಲವಣ ಸಮುಂದರನಾ ಬನಿ ಹರದಸ; ದೆವಸ್ಥಾನತು ಗಯಲ ಪ್ರವಾಹ ಲವಣ ಸಮುಂದರನೆ ಮಳಾಕ್ಹು ತಿನು ಪಾನಿ ಚೊ಼ಕು ಥಾವಸ. <verse eid="EZK 47:8" /><verse number="9" style="v" sid="EZK 47:9" />ಎ ಪಾನಿ ಕಿಜಾ಼-ಕಿಜಾ಼ ಹರದಸ ತ್ಯಾ ತ್ಯಾ ಗುಂಪ ಗುಂಪ ಥೈನ ಜಾ಼ವಾನಾ ಘನ್ನಾ ತರಾನಾ ಜಲಜಂತೊ ಜಿವ್ತಾ ರ‍್ಹವಸ; ಮಚ್ಲಿಯೊ ಗುಂಪ ಗುಂಪ ರ‍್ಹವಸ. ಎ ಪಾನಿ ಸಮುಂದರನೆ ಪಡ್ತಾಮಾ (ತೆ ಪಾನಿ) ಚೊ಼ಕು ಥಾವಸ; ತೆ ತೊರೆ ಕಿಜಾ಼-ಕಿಜಾ಼ ಹರದಸ ತ್ಯಾ ತ್ಯಾ ಜಿವ ಉಂಟ ಥಾವಸ. <verse eid="EZK 47:9" /><verse number="10" style="v" sid="EZK 47:10" />ತೆಳಾಮಾ ತೆ ಲವಣ ಸಮುಂದನಾ ದಂಡಿಮಾ ಬೆಸ್ತರೊ ಹುಬ್ರಯಲ ರ‍್ಹವಸ; ಎನಗೆದತೊ ಎನೆಗ್ಲಯಿಮ ಲಕ್ಕಾ ಕ್ಹಾರಿ ದಂಡಿ ಬಲಿ ವಚ್ಚಾವಾನಿ ಜ಼ಗಾ ಥಾವಸ; ಬಿಜಾ಼ ಬಿಜಾ಼ ಮಚ್ಲಿಯೊ ಮಹಾಸಾಗರನಾ ಮಚ್ಲಿಯೊ ನಿಂಗತ ತ್ಯುನೊನೆ ರಾಶಿ-ರಾಶಿ ಥೈನ ಮಳಸ. <verse eid="EZK 47:10" /><verse number="11" style="v" sid="EZK 47:11" />ತೆನೈಸೊ ತಿನಾ ಸುತ್ತೆ ಜಿಮಿನ ಸೌಳ ತಳಾ ಗಳಾ ನೈ ಥಾತಾ, ತೆ ಮಿಟ್ಟಾನಾ ಗಣಿಯೊ ಥಾವಸ. <verse eid="EZK 47:11" /><verse number="12" style="v" sid="EZK 47:12" />ಪಾನಿನಾ ಭಂಬಿ ದಂಡಿಯೊಮಾ ಕ್ಹಾರಾ ಫಲನಾ ಝಾಡೊಬೆಳದಸ; ತ್ಯುನಾ ಪಾಲೊ ವರಾತಾ ನೈ, ಫಲ್ಲೊ ಕ್ಹರತಾ ನೈ; ತೊರೆನು ಪಾನಿ ಪವಿತ್ರಾಯಲಮಾತು ಆವಾಕ್ಹು ತೆ ಮ್ಹೈನಾ ಮ್ಹೈನಾಮಾ ನವಾ ನವಾ ಫಲ್ಲೊ ದೆತು ರ‍್ಹವಸ; ತ್ಯುನು ಫಲ ಆಹಾರನೆ ಭಾಜಿಪಾಲೊ ವಕ್ಹಡನೆ ಅನುಕುಲ ಕರಸ.<verse eid="EZK 47:12" /></para>
  <para style="s">ಇಸ್ರಾಯೆಲನಾ ಗಡಿ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 47:13" />ಕರ್ತಾ ಥಯಲ ಯಹೊವಾ ಅಮ್ಮ ಕವಸ, ತುಮೆ ಇಸ್ರಾಯೆಲನಾ ಬಾರಾ ಕುಲನೆ ದೆಶ ಬಾಧ್ಯ ಥೈನ ವಾಟತಾಮಾ ಮೆರೆನೆ ಅನುಸರಿಸು. ಯೊಸೆಫನೆ ಬೆ ಪಾಲ ಮಳಾದೆ. <verse eid="EZK 47:13" /><verse number="14" style="v" sid="EZK 47:14" />ಮಿ ತುಮಾರಾ ಪಿತೃವೊನೆ ಪ್ರಮಾಣ ಥೈನ ವಾಗ್ದಾನ ಕರಲ ಎ ದೆಶನೆ ತುಮೆ ಕ್ಹಾರಾ ಸರಿಸಮಾನ ಅನುಭವಿಸೊಶಿ; ಎ ತುಮೊನೆ ಸ್ವಾಸ್ತ್ಯ ಥಯನಜ಼ ರ‍್ಹವಸ. <verse eid="EZK 47:14" /><verse number="15" style="v" sid="EZK 47:15" />ತುಮಾರು ದೆಶ ಮೆರೆ ಅಮ್ಮ ರ‍್ಹೌ ಉತ್ತರ ಮೆರೆ ಮ್ಹೊಟಾ ಸಮುಂದರತು ಶುರು ಥೈನ ಚೆದಾದನಾ ವಾಟಮಾನಾ ಹೆತ್ಲೊನಾ ವಾಟತಾ ಐನ. <verse eid="EZK 47:15" /><verse number="16" style="v" sid="EZK 47:16" />ಹಮಾತ, ಬೆರೊತ, ದಮಸ್ಕನಾ ಎಲ್ಲೆನೆ ಹಮಾತನಾ ಎಲ್ಲೆನೆ ವಚ್ಮಾನು ಸಿಬ್ರಯಿಮ ಕವಾನಾ ಗಾಮೊಪರ ಹರ್ವಾನನಾ ಸರಹತ್ತನೆ ನಜಿಕ ರ‍್ಹಯಲ ಹಾಚೆರ ಹತ್ತಿಕೊನಿ ಕನ ಕ್ಹರು. <verse eid="EZK 47:16" /><verse number="17" style="v" sid="EZK 47:17" />ಇಮ್ಮ ಉತ್ತರ ಮೆರೆ ಸಮುಂದರತು ದಮಸ್ಕನಾ ಸರಹದ್ದಮಾ ರ‍್ಹವಾನಾ ಹಚರ ಐನೊನ ಲಕ್ಕಾ ಹಬ್ಬಸ; ತಿನಾ ಉತ್ತರಮಾ ಹಮಾತನು ಗಾಮ ರ‍್ಹವಸ. ಎ ಉತ್ತರ ದಿಕ್ಕ ಗಡಿ ವ್ಹೈ. <verse eid="EZK 47:17" /><verse number="18" style="v" sid="EZK 47:18" />ಪುರ್ವಮಾ ಹವ್ರಾನ, ದಮಸ್ಕ, ಗಿಲ್ಯಾದ ಎಕ್ಹಾರಾನೆ ಇಸ್ರಾಯೆಲ ದೆಶನಾ ವಚ್ಮಾ ಯೊರ್ದನ ಹೊಳಿ ಎಲ್ಲೆ ಥೈನ ರ‍್ಹವಸ; (ಉತ್ತರ ದಿಕ್ಕ) ಮೆರೆತಾ ಪುರ್ವ ಸಮುಂದರ ಲಕ್ಕಾ ತುಮೆ ಗುರುತ ಘಾಲು. ಎ ಪುರ್ವ ಮೆರೆ ವ್ಹೈ. <verse eid="EZK 47:18" /><verse number="19" style="v" sid="EZK 47:19" />ಪಶ್ಚಿಮ ಮೆರೆ ತಾಮಾರತೊ ಗೈನ ಮೆರಿಬೊತ ಕಾದೆಶನಾ ತಳಾನಾ ಉಪ್ಪರ (ಐಗುಪ್ತನಾ ಕ್ಹಾಮು ರ‍್ಹವಾನು) ತೊರೆನಾ ವಾಟತಾ ಮ್ಹೊಟಾ ಸಮುಂದರನೆ ಮಟ್ಟು. ಎ ಪಶ್ಚಿಮ ಗಡಿ ವ್ಹೈ. <verse eid="EZK 47:19" /><verse number="20" style="v" sid="EZK 47:20" />ಪಡುವಲಮಾ (ಪಶ್ಚಿಮ) ಮೆರೆತಾ ಹಮಾತನಾ ವಾಟನೆ ಕ್ಹಾಮಲ್ಯಾ (ಕರಾವಳಿ) ಲಕ್ಕಾ ಮ್ಹೊಟಾ ಸಮುಂದರ ಎಲ್ಲೆ ಥೈನ ರ‍್ಹವಸ. ಎ ಪಡುವಣನು ಮೆರೆ ವ್ಹೈ. <verse eid="EZK 47:20" /><verse number="21" style="v" sid="EZK 47:21" />ಎ ದೆಶನೆ ತುಮೆ ಇಸ್ರಾಯೆಲನಾ ಕುಲ ಕುಲನೆ ವಾಟು. <verse eid="EZK 47:21" /><verse number="22" style="v" sid="EZK 47:22" />ತುಮೊನೆಬಿ ತುಮಾರಾ ವಚ್ಮಾ ಪ್ರವಾಸ ಕರ್ತಾ ಬಚ್ಚಾವೊನೆ ಪಡದ್ಯಲ ವಿದೆಶಿಯೊನೆ ದೆಶನೆ ಬಾಧ್ಯ ಥೈನ ವಾಟು; ತ್ಯುನೆ ಇಸ್ರಾಯೆಲನಾ ವಚ್ಮಾ ತುಮೊನೆ ಸ್ವದೆಶಿ ನಿಂಗತಜ಼ ರ‍್ಹೌ; ಇಸ್ರಾಯೆಲನಾ ಕುಲಮಾ ತುಮಾರಾ ಕ್ಹಾತೆ ತ್ಯುನೊನೆ ಸ್ವಾಸ್ತ್ಯ ಥಾವಾದೆ. <verse eid="EZK 47:22" /><verse number="23" style="v" sid="EZK 47:23" />ಕಯಾಜ಼ ಕುಲಮಾ ವಿದೆಶಿ ಪ್ರವಾಸ ಥೈನ ರ‍್ಹವಸ ತ್ಯಾ ತಿನೆ ಸ್ವಾಸ್ತ್ಯನೆ ದ್ಯು; ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 47:23" /></para>
  <chapter eid="EZK 47" />
  <chapter number="48" style="c" sid="EZK 48" />
  <para style="s">ಕುಲಾವೊನೆ ದೆಶ ವಾಟಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 48:1" />ತೆ ಕುಲೊನಾ ನಾಮೊ ಅಮ್ಮ ಛೆ ದೆಶನು ಉತ್ತರಮಾ ಹಮಾತ ಗಡಿನಾ ನಜಿಕ ದಾನಿನೆ ಯಕ್ಕ ಪಾಲ, ತಿನಾ ಉತ್ತರನು ಗಡಿನ ಹೆತ್ಲೊನನು ವಾಟನಾ ಬಾಜು಼ಮಾ ಗೈನ ಹಮಾತಿನಾ ವಾಟ ದಾಟಿನ ದಮಸ್ಕನಿ ಗಡಿಮಾ ರ‍್ಹಯಲ ಹಚರ ಎನಾನಲಕ್ಕಾ ಫೈಲಸ. <verse eid="EZK 48:1" /><verse number="2" style="v" sid="EZK 48:2" />ದಾನಿನನು ದಿಕ್ಕನಾ ಗಡಿನಾ ಬಾಜು಼ಮಾ ಪುರ್ವತಾ ಪಶ್ಚಿಮಲಕ್ಕಾ ಆಶೆರನೆ ಯಕ್ಕ ಪಾಲ. <verse eid="EZK 48:2" /><verse number="3" style="v" sid="EZK 48:3" />ದಾನಿನನಾ ಸರಹದ್ದನಾ ಬಾಜು಼ಮಾ ಪುರ್ವತು ಪಶ್ಚಿಮಲಕ್ಕಾ ನಫ್ತಾಲಿನೆ ಯಕ್ಕ ಪಾಲ. <verse eid="EZK 48:3" /><verse number="4" style="v" sid="EZK 48:4" />ನಫ್ತಾಲಿನಾ ಗಡಿನಾ ಬಾಜು಼ಮಾ ರ‍್ಹಯಲ ಪುರ್ವತೊ ಪಶ್ಚಿಮಲಕ್ಕಾ ಮನಸ್ಸೆನೆ ಯಕ್ಕ ಪಾಲ. <verse eid="EZK 48:4" /><verse number="5" style="v" sid="EZK 48:5" />ಮನಸ್ಸೆ ಗಡಿನಾ ಬಾಜು಼ಮಾ ಪುರ್ವತೊ ಪಶ್ಚಿಮಲಕ್ಕಾ ಎಫ್ರಾಯಿಮನೆ ಯಕ್ಕ ಪಾಲ. <verse eid="EZK 48:5" /><verse number="6" style="v" sid="EZK 48:6" />ಎಫ್ರಯಿಮಗಡಿನಾ ಬಾಜು಼ಮಾ ಪುರ್ವತು ಪಶ್ಚಿಮಲಕ್ಕಾ ರೊಬೆನನೆ ಯಕ್ಕ ಪಾಲ. <verse eid="EZK 48:6" /><verse number="7" style="v" sid="EZK 48:7" />ರೊಬೆನ ಗಡಿನಾ ಬಾಜು಼ಮಾ ಪುರ್ವತಾ ಪಶ್ಚಿಮಲಕ್ಕಾ ಯುದನೆ ಯಕ್ಕ ಪಾಲ. <verse eid="EZK 48:7" /><verse number="8" style="v" sid="EZK 48:8" />ಯುದನು ಗಡಿನಾ ಬಾಜು಼ಮಾ ಪುರ್ವತಾ ಪಶ್ಚಿಮಾಲಕ್ಕಾ ತುಮೆ ಮಿಸಲ ಥಯಲ ಸಮರ್ಪಿಸುವಾನು ಪಾಲ ರ‍್ಹವಸ. ತಿನು ರುಂದ ಕ್ಹಡಾ ಬಾರಾ ಹಜಾ಼ರಾ ಹತೊ ಲಾಂಬಾಮಾ ಪಶ್ಚಿಮತಾ ಪುರ್ವನೆ ಕುಲಾನಾ ಪಾಲೊ ಲಾಂಬಾಮಾ ಸರಿಸಮಾನ; ತಿನಾ ವಚ್ಮಾ಼ ಪವಿತ್ರ ಆಲಯ ರ‍್ಹವಸ <verse eid="EZK 48:8" /><verse number="9" style="v" sid="EZK 48:9" />ತುಮೆ ಮಿಸಲ ಭುಮಿಮಾ ಕ್ಹುದಾನೆ ಕ್ಹಾಸ ಮಿಸಲ ಥಯಲ ಸಮರ್ಪಿಸಾನು ಪಾಲನು ಲಾಂಬು ಕ್ಹಡಾ ಬಾರಾ ಹಜಾ಼ರ ಹತೊ ವ್ಹತಾ. <verse eid="EZK 48:9" /><verse number="10" style="v" sid="EZK 48:10" />ಮಿಸಲ ಥಯಲ ಪವಿತ್ರ ಜ಼ಗಾ ಯಾಜೊಕೊನು ವ್ಹೈ.ಉತ್ತರಮಾ ತೆ ಲಾಂಬಾಮಾ ಪಾಂಚ಼ ಹಜಾ಼ರ ಹತೊ. ಪುರ್ವಮಾ ಅಗಲಮಾ ಕ್ಹಡಾ ಬಾರಾ ಹಜಾ಼ರ ಹತೊ ವ್ಹತಾ. ಉತ್ತರಮಾ ಕ್ಹಡಾ ಬಾರಾ ಹಜಾ಼ರ ಹತೊ ವ್ಹತಾ. ತಿನಾ ವಚ್ಮಾ಼ ಯಹೊವಾನಿ ಪವಿತ್ರ ಆಯಲ ರ‍್ಹವಸ. <verse eid="EZK 48:10" /><verse number="11" style="v" sid="EZK 48:11" />ತೆ ಕ್ಷೆತ್ರ ಚಾದಕೊನಾ ಸಂತಾನೊಮಾ ಮಾರಾಹುತಿ ಮಿಸಲ ರ‍್ಹಯಲ ವರಿ ಮಾರಿ ಆಲಯನಿ ದೆಕ್ರಾಣಕಿ ಪುರಾಕರಾಲಾ ಥಯಲ ತ್ಯುನು ರ‍್ಹವಸ. ಇಸ್ರಾಯಲೊ ಮನೆ ತಿರಸ್ಕಾರ ಕರ್ತಾಮಾ ಲೆವಿಯೊ ತಿರಸ್ಕಾರ ಕರಲನಿಂಗತ ಇವ್ನೆ ತಿರಸ್ಕಾರ ಕರ್ಯಾನೈ. <verse eid="EZK 48:11" /><verse number="12" style="v" sid="EZK 48:12" />ಲೆವಿಯೊನಾ ಪಾಲನಾ ಗಡಿನಾ ಬಾಜು಼ಮಾ ರ‍್ಹಯಲ ತೆ ಜ಼ಗಾ ಪವಿತ್ರ ದೆಶಮಾ ರ‍್ಹಯಲ ಮಿಸಲ ಥೈನ ಯಾಜಕೊ ರ‍್ಹವಸ. ಎ ಕ್ಹಾಸ ರ‍್ಹಯಲ ಜಗಾ ವ್ಹೈ. <verse eid="EZK 48:12" /><verse number="13" style="v" sid="EZK 48:13" />ವರಿ ದಕ್ಹ ಹಜಾ಼ರ ಹತೊ ಲಾಂಬಾಮಾ ವರಿ ಪಾಂಚ಼಼ ಹಜಾ಼ರ ಹತೊ ಅಗಲನು ಯಕ್ಕ ಪಾಲ ಯಾಜಕೊನಾ ಪಾಲನು ಗಡಿನಾ ಬಾಜು಼ಮಾ ರ‍್ಹಯಲ ಲೆವಿಯೊನು ವ್ಹೈ. ಎ ಭಂಬಿ ಪಾಲೊ ವಟ್ಟ ಅಳತಿ ಕೆಕ್ಲು ಕದ್ಯಾಮ ಲಾಂಬಾಮಾ ಕ್ಹಡಾ ಬಾರಾ ಹತೊ ವರಿ ಅಗಲ ದಕ್ಹ ಹಜಾ಼ರ ಹತೊ ವ್ಹೈ. <verse eid="EZK 48:13" /><verse number="14" style="v" sid="EZK 48:14" />ತಿನಾಹುತಿ ತೆ ಕ್ಷೆತ್ರ ಯಹೊವಾನೆ ಮಿಸಲ ರ‍್ಹಯಲ ಹುತಿ ತಿಮಾನು ಕಯುಜ಼ ಭಗ ಇಕ್ಕೊ ನೈ. ವರಿ ಬದಲಿಬಿ ಕರುನೈ. ವರಿ ತೆ ಕಿನಾಜ ಶಮಾ ಥೌ ನೈ. <verse eid="EZK 48:14" /><verse number="15" style="v" sid="EZK 48:15" />ಕ್ಹಡಾ ಬಾರಾ ಹತೊ ಲಾಂಬಾಮಾ ರ‍್ಹಯಲ ತೆ ಕ್ಷೆತ್ರನಾ ಬಾಜು಼ಮಾ ಮಿಸಲ ಪಾಲ ವಟ್ಟಜ಼ ಅಳತಿಮಾ ಉಗ್ರಲ ಅಡಿ ಹಜಾ಼ರ ಹತೊ ಅಗಲನಿ ಭುಮಿ ಮಿಸಲ ವ್ಹೈ ಕೈನ ಗಾಮನೆ ಕದ್ಯಾಮ ಮನಕ್ಹೊನೆ ರ‍್ಹವಾನೆ ವರಿ ಸುತ್ತೆ ರ‍್ಹಯಲ ಗಾಮೊನೆ ಜು಼ದು ಕರಲ ರ‍್ಹವಾದೆ. ತೆ ಗಾಮ ತಿನಾ ವಚ್ಮಾ಼ ರ‍್ಹವಾದೆ. <verse eid="EZK 48:15" /><verse number="16" style="v" sid="EZK 48:16" />ಗಾಮನಿ ಅಳತಿ ಅಮ್ಮ ರ‍್ಹೌ ಉತ್ತರ ಭಾಗಮಾ ಬೆ ಹಜಾ಼ರ ಅಡಿಕ್ಹೊ ಹತೊ. ಪುರ್ವ ಬಗಲ ಬೆ ಹಜಾ಼ರ ಅಡಿ ಕ್ಹೊ ಹತೊ ರ‍್ಹೌ. ವರಿ ಪಸ್ಚಿಮ ಬಗಲ ಯಕ್ಕ ಕ್ಹಾತಕ್ಹೊನ ಐವತ್ತ ಹತೊ ರ‍್ಹೌ. <verse eid="EZK 48:16" /><verse number="17" style="v" sid="EZK 48:17" />ಗಾಮಾನಾ ಸುತ್ತೆ ಪ್ರದೆಶ ರ‍್ಹೌ. ತಿನು ಅಗಲ ಉತ್ತರಮಾ ಯಕ್ಹೊನ ಪಚ್ಚಕ್ಹ ಹತೊ ದಕ್ಷಿಣಮಾ ಯಕ್ಹೊನ ಪಚ್ಚಕ್ಹ ಹತೊ ವರಿ ಪುರ್ವಾಮಾ ಯಕ್ಹೊನ ಪಚ್ಚಕ್ಹ ಹತೊ ವರಿ ಪಸ್ಚಿಮಮಾ ಬೆಕ್ಹೊನ ಯಕ್ಹೊನ ಪಚ್ಚಕ್ಹ ಹತೊ ರ‍್ಹೌ. <verse eid="EZK 48:17" /><verse number="18" style="v" sid="EZK 48:18" />ಗಾಮನೆ ಛೊಡಿನ ತಿನಾ ವಳಪಟ್ಟಮಾ ಉಗ್ರಲ ಭುಮಿನು ಲಾಂಬು ಮಿಸಲ ರ‍್ಹಯಲ ಪವಿತ್ರ ಜ಼ಗಾನಾ ಬಾಜು಼ಮಾ ಪುರ್ವನಾ ಬಾಜು಼ಮಾ ಪಾಂಚ಼಼ ಹಜಾ಼ರ ಹತೊ ವರಿ ಪಶ್ಚಿಮನು ಪಾಂಚ಼಼ ಹಜಾ಼ರ ಹತೊ ರ‍್ಹೌ. ತೆ ಜಿಮಿನ ಮಿಸಲ ರ‍್ಹಯಲ ಪವಿತ್ರ ಜ಼ಗಾನೆ ಅನುಸರಿಸು. ತಿನು ಉತ್ಪತ್ತಿ ತೆ ಗಾಮನಾ ಮನಕ್ಹೊನೆ ಅನ್ನ ಥಾವಸ. <verse eid="EZK 48:18" /><verse number="19" style="v" sid="EZK 48:19" />ತ್ಯುನೆ ಇಸ್ರಾಯೆಲನಾ ಕಯಾ ಕುಲನೆ ಸೆರ್ಯಾತಾ. ಗಾಮಮಾ ರ‍್ಹಯಲವಾಲಾ ತೆ ಜಿಮಿನ ಬಿತ್ತಸ. <verse eid="EZK 48:19" /><verse number="20" style="v" sid="EZK 48:20" />ಮಿಸಲ ರ‍್ಹಯಲ ಪುರಾ ಜ಼ಗಾನಿ ಲಾಂಬು ಕ್ಹಡಾ ಬಾರಾ ಹಜಾ಼ರ ಹತೊ ವರಿ ತುಮೆ ಮಿಸಲ ರ‍್ಹಯಲನೆ ಅರ್ಪಿಸಾನೆ ಪವಿತ್ರ ಜ಼ಗಾ ಗಾಮನೆ ಒಳಪಟ್ಟಿನ ಭುಮಿನೆ ಧರಿನೆ ಚೌಕ ಥೈನ ರ‍್ಹೌ. <verse eid="EZK 48:20" /><verse number="21" style="v" sid="EZK 48:21" />ಮಿಸಲ ರ‍್ಹಯಲ ಪವಿತ್ರ ಜ಼ಗಾ ವರಿ ಗಾಮ ಒಳಪಟ್ಟಲ ಭುಮಿ ಭಂಬಿ ಬಗಲ ಉಗ್ರಲ ಭುಮಿ ಮುಖಂಡ ಪಾಲ ರ‍್ಹವಾದೆ ತೆ ಪಾಲ ಮಿಸಲ ರ‍್ಹಯಲ ಜ಼ಗಾನೆ ಪುರ್ವ ಬಗಲ ಕ್ಹಡಾ ಬಾರಾ ಹಜಾ಼ರಾ ಹತೊ ಲಾಂಬು. ತಿನಾ ಬಾಜುಮಾ ಪಶ್ಚಿಮ ಬಗಲ ಕ್ಹಡಾ ಬಾರಾ ಹಜಾ಼ರ ಹತೊ ಲಾಂಬು ತಿನಾ ಬಾಜು಼ಮಾ ಕುಲನಾ ಪಾಲ ಯಕ್ಲು ಲಾಂಬು ಥೈನ ಹಬ್ಬಸ; ತೆ ಮುಖಂಡೊ ಸೆರಲ ವ್ಹೈ. ಎ ಪವಿತ್ರ ಆಲಯ ಮಿಸಲ ರ‍್ಹಯಲ ಜಗಾನಾ ವಚ್ಮಾ ರ‍್ಹವಸ. <verse eid="EZK 48:21" /><verse number="22" style="v" sid="EZK 48:22" />ರಾಜಾನು ಪಾಲ ರ‍್ಹಯಲ ಬೆ ಭಾಗನಾ ವಚ್ಮಾ ಉತ್ತರ ಗಡಿತು ಗಾಮ್ಮಾ ರ‍್ಹೈನ ದಕ್ಷಿಣ ಗಡಿನಾ ಲಕ್ಕಾ ಕದ್ಯಾಮ ಯುದನು ದಕ್ಷಿಣ ಗಡಿತು ಬೆನ್ಯಾಮಿನ ಗಡಿಲಕ್ಕಾ ರಾಜಾ಼ನು ಪಾಲ ರ‍್ಹವಸ.<verse eid="EZK 48:22" /></para>
  <para style="s">ಉಗ್ರಲ ಕುಲನೆ ಸೆರಲ ಭುಮಿ</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 48:23" />ಉಗ್ರಲ ಕುಲಾನಾ ಪಾಲೆ ಕ್ರಮಾ ಸು ವೈ ಕದ್ಯಾ ಪುರ್ವತು ಪಶ್ಚಿಮಲಕ್ಕಾ ಬೆನ್ಯಾಮಿನನೆ ಯಕ್ಕ ಪಾಲ. <verse eid="EZK 48:23" /><verse number="24" style="v" sid="EZK 48:24" />ಬೆನ್ಯಾಮಿನನಾ ಬಾಜು಼ಮಾ ಪುರ್ವತು ಪಶ್ಚಿಮಲಕ್ಕಾ ಸಿಮೊಯನನೆ ಯಕ್ಕ ಪಾಲ. <verse eid="EZK 48:24" /><verse number="25" style="v" sid="EZK 48:25" />ಸಿಮೊಯನನಾ ಗಡಿನಾ ಬಾಜು಼ಮಾ ಪುರ್ವತೊ ಪಶ್ಚಿಮಲಕ್ಕಾ ಇಸ್ಸಾಕಾರನೆ ಯಕ್ಕ ಪಾಲ. <verse eid="EZK 48:25" /><verse number="26" style="v" sid="EZK 48:26" />ಇಸ್ಸಾಕಾರ ಗಡಿನಾ ಬಾಜು಼ಮಾತೊ ಪುರ್ವತೊ ಪಶ್ಚಿಮಲಕ್ಕಾ ಜೆಬೊಲೊನೆ ಯಕ್ಕ ಪಾಲ. <verse eid="EZK 48:26" /><verse number="27" style="v" sid="EZK 48:27" />ಜೆಬೊಲೊನೆನಿ ಗಡಿತೊ ಬಾಜು಼ಮಾ ರ‍್ಹಯಲ ಪುರ್ವತೊ ಪಶ್ಚಿಮಾಲಕ್ಕಾ ಗಾದ ಕವಾಲಾಕುಲನೆ ಯಕ್ಕ ಪಾಲ. <verse eid="EZK 48:27" /><verse number="28" style="v" sid="EZK 48:28" />ಗಾದನಿ ಗಡಿ ದಕ್ಷಿಣನಿ ಗಡಿ ತಾಮಾರ್ತು ಗೈನ ಮೆರೆಬತ್ತ ಕಾದೆಶ ವಕಳೊ ದಾಟಿನ ಐಗುಪ್ತು ನ ಅಗು ನದಿನಿ ವಾಟ ಧರಿನ ಮಹಾ ಸಮುದ್ರಾನೆ ಮಳಸ. <verse eid="EZK 48:28" /><verse number="29" style="v" sid="EZK 48:29" />ತುಮೆ ಇಸ್ರಾಯಲನಾ ಕುಲನೆ ಖುದ್ದ ತುಮೆಜ ವಾಟಿನ ದಿವಾನು ದೆಶ ಎಜ಼. ಕುಲನು ಪಾಲ ಎಜ಼ ವ್ಹೈ. ಎ ಕರ್ತಾ ಥಯಲ ಯಹೊವಾನಿ ವಾತ ವ್ಹೈ.<verse eid="EZK 48:29" /></para>
  <para style="s">ಯೆರುಸೆಲಿಮೆ ಜಾ಼ವಾನು ಬಾಕಲೊ</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 48:30" />ಗಾಮಮಾತು ಜಾ಼ವಾನು ಅಮ್ಮ ರ‍್ಹೌ. ಉತ್ತರ ಬಗಲ ಲಾಂಬಾಮಾ ಬೆ ಹಜಾರ ಅಡಿಕ್ಹೊ ಹತೊ ಛೆ. <verse eid="EZK 48:30" /><verse number="31" style="v" sid="EZK 48:31" />ಗಾಮನಾ ಬಾಕಲೊನೆ ಇಸ್ರಾಯಲನಾ ಕುಲೊನೊ ನಾಮೊ ರ‍್ಹವಾದೆ. ಉತ್ತರಮಾ ತನ್ನ ಬಾಕಲೊ, ಯಕ್ಕ ರುಬೆನ ಬಾಕಲ, ಬಿಜೆಕ ಯುದನು ಬಾಕಲ, ಬಿಜೆಕ ಲೆವಿಯೊನು ಬಾಕಲ. <verse eid="EZK 48:31" /><verse number="32" style="v" sid="EZK 48:32" />ಪುರ್ವನಾ ಬಗಲನು ಲಾಂಬಾಮಾ ಬೆ ಹಜಾ಼ರ ಕ್ಹೊ ಹತೊ ಛೆ. ತಿಮಾ ತನ್ನ ಬಾಕಲೊ, ಯಕ್ಕ ಯೊಸೆಫನು ಬಾಕಲ. ಬಿಜೆಕ ಬೆನ್ಯಾಮಿನನು ಬಾಕಲ. ಬಿಜೆಕ ದಾನಿನು ಬಾಕಲ. <verse eid="EZK 48:32" /><verse number="33" style="v" sid="EZK 48:33" />ದಕ್ಷಿಣನು ಬಗಲ ಲಾಂಬಾಮಾ ಬೆ ಹಜಾರ ಅಡಿಕ್ಹೊ ಹತೊ ತಿಮಾ ತನ್ನ ಬಾಕಲೊ ಯಕ್ಕ ಸಿಮೊಯೊನನು ಬಾಕಲ ಬಿಜೆಕ ಇಸ್ಸಾಕಾರನು ಬಾಕಲ ಬಿಜೆಕ ಜೆಬೊಲಿನು ಬಾಕಲ, <verse eid="EZK 48:33" /><verse number="34" style="v" sid="EZK 48:34" />ಪಸ್ಚಿಮ ಗಡಿನು ಲಾಂಬು ಬೆ ಹಜಾರ ಅಡಿಕ್ಹೊ ಹತೊ ತಿಮಾ ತನ್ನ ಬಾಕಲೊ, ಯಕ್ಕ ಬಾಕಲ ಗಾದಿನು ಬಾಕಲ. ಬಿಜೆಕ ಆಶೆರನು ಬಾಕಲ, ಬಿಜೆಕ ನಫ್ತಾಲಿನು ಬಾಕಲ. <verse eid="EZK 48:34" /><verse number="35" style="v" sid="EZK 48:35" />ಗಾಮನು ಸುತ್ತೆನು ಅಳತಿ ನೌ ಹಜಾರ ಹತೊ; ತೆ ತಯ್ಯಾರ ಕರಲ ದಿನತು ತೆ ಗಾಮನೆ ಯಹೊವಾ ಶಮಹಾ ಮತ್ಲಬ ವ್ಹೈ. ಜ಼ಗಾ ಕೈನ ನಾಮ ಥಾವಸ.<verse eid="EZK 48:35" /></para>
  <chapter eid="EZK 48" />
</usx>