<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Shikilagar</book>
  <para style="h">1 ಯೊಹಾನ</para>
  <para style="toc3">1 ಯೊಹಾನ</para>
  <para style="toc2">1 ಯೊಹಾನ</para>
  <para style="toc1">1 ಯೊಹಾನ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="mt2">ಯೊಹಾನನು ಬರೆದ ಮೊದಲನೆಯ ಪತ್ರಿಕೆ</para>
  <para style="mt1">1 ಯೊಹಾನ ಬರ್ದಲ ಪತ್ರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಯೊಹಾನ ಬರ್ದಲ ಯಕ್ವಾ ಪತ್ರಿಕೆಮಾ ಅಪೊಸ್ತಲ ಥಯಲ ಯೊಹಾನ ಯೆಸು ಸ್ವಾಮಿ ಹುಟ್ಟಲ್ಪರ 50-100 ವರಕ್ಹನಾ ವಚ್ಮಾ ಬರ್ದ್ಯೊಸ. ಯೊಹಾನ ಆ ಪತ್ರಿಕೆ ತೆಜ಼ ಬರ್ದ್ಯೊಸ ಕೈನ ದೆಕಾಡಿನ ನತ್ತಿ ದಿದ್ಯೊ, ತೆ ಪೈಲಾ ಅದ್ಯಾಯ ಮಾಜ ತೆ ಯೆಸು ಸ್ವಾಮಿನು ಜಿವಿತ ವರಿ ತೆ ಮರಿನ ತನ್ನ ದಿನ ಥಯಲ್ಪರ ಉಟಿನ ಆಯೆಲ ದೆಕಲ ವಾಲೊ ವ್ಹೈ ಕೈನ ದೆಕಾಡಿನ ದಿವಸ ಯೊಹಾನ ಬರ್ದಲ ಯಕ್ವಾ ಪತ್ರಿಕೆಮಾ ಬರ್ದಲ ತರಿಕೊ ಯೊಹಾನ ಬರ್ದಲ ಸುವಾರ್ತಾನಾ ಬುಕ್ಕನಾ ಕ್ಹಾತೆ ಘನ್ನು ಮಳಸ. ಯೊಹಾನ ಬರ್ದಲ ಸುವಾರ್ತಾನು ಬುಕ್ಕ ಯೊಹಾನಜ಼ ಬರ್ದ್ಯೊಸ ಕೈನ ಕ್ಹಾರಾಜ಼ನಾ ಬರೊಕ್ಹೊ ಕರಸ ತಿನಾನಿಂಗತಜ಼ ಯೊಹಾನ ಬರ್ದಲ ಯಕ್ವಾ ಬೆವಾ ವರಿ ತನವಾ ಪತ್ರಿಕೆ ಯೊಹಾನ ಎಫೆಸಮಾ ರ‍್ಹತಾಮಾ ಬರ್ದ್ಯೊಸ ಕೈನ ಕ್ಹಾರಾಜ಼ನಾ ಬರೊಕ್ಹೊ ಕರಸ.</para>
  <para style="ip">ಯೊಹಾನನಿ ಸಬೆ ಕ್ಹುದಾಜ಼ ನತ್ತಿ ಕೈನ ಕವಾಲಾ ಮನಕ್ಹೊ ಕ್ಹು ತ್ರಾಸ ಖಾತಾಮಾ ಯೆಸು ಸ್ವಾಮಿಪರ ಬರೊಕ್ಹೊ ಮುಕ್ಕಲವಾಲಾವೊನಾ ಹುತಿ ಆ ಪತ್ರಿಕೆ ಬರ್ದ್ಯೊಸ ತೆ ಸಬೆನಾ ಮನಕ್ಹೊ ಯೆಸು ಸ್ವಾಮಿ ಕ್ಹುದಾ ವ್ಹೈ ಮಾತ್ರ ಯೆಸು ಸ್ವಾಮಿ ಮನಕ್ಹನಾ ರುಪಮಾ ಆಯೊಸ ಕೈನ ನೈ ಬರೊಕ್ಹೊ ಕರಲಕ್ಹು ಯೊಹಾನ ಯೆಸು ಸ್ವಾಮಿನಾ ಕ್ಹಾತೆ ರ‍್ಹತಾಮ ತೆ ತಿನೆ ಮುಟ್ಟಲ ತೆ ಯೆಸು ಸ್ವಾಮಿನಾ ಕ್ಹಾತೆ ರ‍್ಹತಾಮಾ ಹರಯಕ್ಕ ಥಯಲ ಆ ಪತ್ರಿಕೆಮಾ ಬರ್ದಸ <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char> ಯೊಹಾನ ಆ ಪತ್ರಿಕೆ ಶಾನಾ ಹುತಿ ಬರ್ದ್ಯೊಸ ಕದ್ಯಾಮ ತಿನಿ ಖುಶಿ ಪುರಾ ಥೌ <char style="xt"><ref loc="1JN 1:4">1:4</ref></char> ಯೆಸು ಸ್ವಾಮಿಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಲವಾಲಾ ಪಾಪಕ್ಹು ದುರ ರ‍್ಹೌ ಕೈನ <char style="xt"><ref loc="1JN 2:1">2:1</ref></char> ತಪ್ಪ ಭೊದನೆಕ್ಹು ವಾಚು಼ ಕೈನ <char style="xt"><ref loc="1JN 2:26">2:26</ref></char> ವರಿ ಯೆಸು ಸ್ವಾಮಿಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಲವಾಲಾವೊನೆ ರಕ್ಷಣೆ ಮಳಸಜ಼ ಕೈನ ದೆಕಾಡಿನ ದಿವಾನಾ ಹುತಿ <char style="xt"><ref loc="1JN 5:13">5:13</ref></char></para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1) ಯೊಹಾನ ತೆ ಕಿನೆ ಪತ್ರ ಲಿಕ್ಕಾಡೊಸ ವರಿ ಶಾನಾ ಹುತಿ ಬರ್ದಾಡ್ಯೊಸ ಕೈನ ಕವಸ <char style="ior"><ref loc="1JN 1:1">1:1</ref>,<ref loc="1JN 1:4">4</ref></char></para>
  <para style="io1">2) ವರಿ ಕ್ಹುದಾ ಅಪೊನೆ ಕಿಮ್ಮ ಉಜಾಲು ಥಯೊಸ ವರಿ ಅಪ್ನೊ ಯೆಸು ಸ್ವಾಮಿ ಕಿಮ್ಮ ಹೊತ್ತೊ ಅಪೆಬಿ ತಿನಾ ನಿಂಗತ ಕಿಮ್ಮ ರ‍್ಹೌ ಕೈನ ಕದ್ಯೊಸ. <char style="ior"><ref loc="1JN 1:5-3:10">1:5—3:10</ref></char></para>
  <para style="io1">3) ತೆ ಥಯಲ್ಪರ ಅಪೆ ಯಕ್ಲಾನೆ ಯಕ್ಲೊ ಕಿಮ್ಮ ಮಯಾ ಕರು ಕೈನ ಕವಾನಿ ಆಗ್ಯಾ ಶೆ ದಿಲಾವಸ<char style="ior"><ref loc="1JN 3:11">3:11</ref>; <ref loc="1JN 5:2">5:2</ref></char></para>
  <para style="io1">4) ಯೊಹಾನ ಪತ್ರಿಕೆಮಾ ಸು ಕವಾನು ಕೈನ ಕ್ಹರಾವಾಸ. <char style="ior"><ref loc="1JN 5:13-21">5:13-21</ref></char></para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">ಜ಼ಲಮ ದಿವಾನಿ ವಾಕ್ಯಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />ಎ ಜಗತ ಶುರು ಥಾವಾತಿ ಅಗ್ದುರಜ಼ ರ‍್ಹಯಲ ಜ಼ಲಮ ರ‍್ಹಯಲ ಕ್ಹುದಾನಿ ವಾಕ್ಯಾನಾ ಹುತಿ ಹಮೆ ತುಮೊನೆ ಬರ್ದಾಡಾಸ; ಎ ಕ್ಹಾರು ಕಾನೊಕ್ಹು ಐಕ್ಯಾಸ; ಡೊಳಾಕ್ಹು ದೆಕ್ಯಾಸ; ಧ್ಯಾನ ದಿನ ದೆಕ್ಯಾಸ, ಹತೊಕ್ಹು ಮುಟ್ಟಿನ ದೆಕ್ಯಾಸ. <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />ತೆ ಜ಼ಲಮ ಹಮೊನೆ ದಿಕ್ಹ್ಯೊಸ. ಹಮೆ ತೆ ದೆಕಲಹುತಿ ತಿನಾಹುತಿ ಸಾಕ್ಷಿ ಕೈಯೆಸ. ಹಮೆ ಹಮ್ನಾ ತುಮೊನೆ ತೆ ಜಿವ್ತಾ ಜ಼ಲಮ್ನಿ ಸಾಕ್ಷಿ ಕವಾಡಾಸ. ತೆ ಬಾ ಥಯಲ ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಹಮೆಶಾನೊ ಜ಼ಲಮ ವ್ಹೈ. ಕ್ಹುದಾ ತೆ ಹಮೆಶಾನೊ ಜ಼ಲಮ ಹಮೊನೆ ದೆಕಾಡ್ಯೊ.<verse eid="1JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 1:3" />ಹಮೆ ದೆಕಲ ಕ್ಹಾರು ವರಿ ಐಕಲ ಹಮ್ನಾ ಹಮೆ ತುಮೊನೆ ಕಯೆಸ. ಕಾ ಕದ್ಯಾಮ ತುಮೆ ಹಮಾರಿ ಅನ್ಯುನತೆಮಾ ಪಾಲಲಿವಾಲಾ ಥೌ ಕೈನ ಹಮಾರಿ ಆಸ ವ್ಹೈ. ಅಪ್ನಿ ಅನ್ಯುನೆತೆ ಬಾ ಥಯಲ ಕ್ಹುದಾ ವರಿ ತಿನೊ ದಿಕ್ರೊ ಯೆಸು ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾನು ವ್ಹೈ. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />ಅಪ್ನಿಕ್ಹುಶಿ ಪುರಾ ಥಾವಾದೆ ಕೈನ ಹಮೆ ತುಮೊನೆ ಎ ಸಂಗತಿಯೊ ಬರ್ದಾಡಾಸ.<verse eid="1JN 1:4" /></para>
  <para style="s">ಕ್ಹುದಾ ಉಜಾಲು ವ್ಹೈ</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />ಹಮೆ ಕ್ಹುದಾಕಂತು ಐಕಿನ ತುಮೊಕನ ಕವಾನಿಯೊ ವಾತೊ ಕಯ್ಯೊ ವ್ಹೈ ಕದ್ಯಾಮ, ಕ್ಹುದಾ ಉಜಾಲು ವ್ಹೈ. ತಿಮಾ ಅಂದಾರು ನತ್ತಿ. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />ತಿನಾಹುತಿ ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಅನ್ಯುನ್ಯೆತಾಮಾ ಛೆ ಕೈನ ಹಮೆ ಕೈಲಿನ, ಅಂದಾರಾಮಾ ಜಿವಸ್ತಾ ರ‍್ಹಯ್ಯಾಮ ಸುಳ್ಳ ಕದಲನಿಂಗತ ಥಯ್ಯು. ಕಾಕದ್ಯಾಮ ಅಪೆ ಕ್ಹರಿ ಪಾಲನ ನತ್ತಿ ಕರಾಡಾ. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />ಕ್ಹುದಾ ಉಜಾಲು ಥೈನ ಛೆ. ತಿನಾಹುತಿ ಅಪೆ ಉಜಾಲಾಮಾ ಜಿವ್ನಾ ಕರು. ಅಪೆ ಉಜಾಲಾಮಾ ಜಿವ್ನಾ ಕರಾಲಾ ರ‍್ಹಯಾಮ ಯಕ್ಕನೆ ಯಕ್ಕ ಅನ್ಯುನ್ಯೆತಾಮಾ ಛೆ ಕೈನ ವರಿ ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ಯೆಸು ರಗತ ಅಪ್ನಾ ಕ್ಹಾರಾ ಪಾಪೊಕ್ಹು ಛೊಡಾವಸ.<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />ಅಪೊಮಾ ಪಾಪ ನತ್ತಿ ಕೈನ ಕೈಲಿದ್ಯಾಮ, ಅಪೊನೆ ಅಪೆಜ಼ ಮೊಸ ಕರಲಿವಾಲಾ ಥಯಾಸ. ವರಿ ಅಪೊಮಾ ಕ್ಹರಿ ನತ್ತಿ. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />ತೆನೈಸೊ ಅಪ್ನಾ ಪಾಪೊ ಕೈಲಿದ್ಯಾಮ, ತೆ ಬರೊಕ್ಹೊವಾಲೊ ನಿತಿವಂತವಾಲೊ ರ‍್ಹಯಲಹುತಿ ಅಪ್ನಾ ಕ್ಹಾರಾ ಕೆಟ್ಟ ಕಾಮೊ ಮಾಫ ಕರಿನ ಅಪೊನೆ ಶುದ್ಧ ಕರಸ. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />ಅಪೆ ಪಾಪ ಕರ‍್ಯಾ ನತ್ತಿ ಕೈನ ಕದ್ಯಾಮ ಕ್ಹುದಾನೆಜ಼ ಸುಳ್ಳ ವ್ಹೈ ಕೈನ ಕವಾಲಾ ಥಯಾಸ ವರಿ ಕ್ಹುದಾನಿ ವಾಕ್ಯಾನೆ ನೈ ವಪ್ಪಿಲಿವಾಲಾ ಥೈಯೆಸ.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">ಯೆಸು ಕ್ರಿಸ್ತಜ಼ ಅಪೊನೆ ಮದದ ಕರಾಲೊ ವ್ಹೈ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />ಮಾರಾ ಮಯಾನಾ ಬಚ್ಚಾ಼ವೊ, ತುಮೆ ಪಾಪ ಕರು ನೈ ಕೈನ ಮಿ ತುಮೊನೆ ಪತ್ರ ಬರ್ದಾಡೊಸ. ತೆನೈಸೊ ಕುನಬಿ ಪಾಪ ಕರ‍್ಯಾಮ ಅಪೊನೆ ಮದತ ಕರಾನೆ ಯೆಸು ಕ್ರಿಸ್ತ ಛೆ. ನಿತಿವಂತವಾಲೊ ಥಯಲ ತೆ ಬಾ ಅಪ್ನೊ ಬಾ ಥಯಲ ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಛೆ. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />ಅಪ್ನಾ ಪಾಪೊ ವರಿ ಕ್ಹಾರಾ ಮನಕ್ಹೊನಾ ಪಾಪೊ ಪರಿಹಾರ ಕರಾನೆ ಯೆಸುಜ಼ ವಾಟ ವ್ಹೈ.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />ಕ್ಹುದಾನಿ ಆಗನ್ಯಾನೆ ಅಪೆ ವಿಧೆಯ ಥಯಲ ರ‍್ಹಯಾಮ, ಕ್ಹುದಾನಾ ಹುತಿ ಕ್ಹರಿಮಾಜ಼ ತಿಳ್ದಿಲಿದ್ಯಾಸ ಕವಾನು ಗ್ವತ್ತ ಥಾವಸ. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />"ಕ್ಹುದಾನೆ ಮಿ ವಳಕ್ಯೊಸ "ಕೈನ ಕವಾಲೊ ಕ್ಹುದಾನಿ ಆಗ್ಯ್ನಾನೆ ನೈ ವಿಧೆಯ ಥಯಲ ರ‍್ಹಯೊಮ, ತೆ ಸುಳ್ಳಮಾ ರ‍್ಹಯಲವಾಲೊ ವ್ಹೈ ವರಿ ತಿಕನ ಕ್ಹರಿಜ಼ ನತ್ತಿ. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />ತೆನೈಸೊ ಕಯೊಬಿ ಕ್ಹುದಾನಿ ವಾಕ್ಯಾನೆ ವಿದೆಯ ಥಯೊಮ, ಕ್ಹರಿಜ಼ ಕ್ಹುದಾಪರ ತಿನೆ ರ‍್ಹಯಲ ಮಯಾ ಪುರಾಜ಼ ವ್ಹೈ. ಅಪೆ ಕ್ಹುದಾನೆ ಅನುಸರಸಾಡಾಸ ಕವಾನು ಇಕ್ಹುಜ಼ ತಿಳ್ದಿಲಿಯೆಸ. <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />ಮಿ ಕ್ಹುದಾಮಾ ಛೆ ಕವಾಲೊ ಯೆಸು ಜಿವ್ನಾ ಕರಲನಿಂಗತ ಜಿವ್ನಾ ಕರು.<verse eid="1JN 2:6" /></para>
  <para style="s">ನವು ಆಗ್ಯಾ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />ಮಾರಾ ಮಯಾನಾ ದೊಸ್ತೊ, ಮಿ ತುಮೊನೆ ನಯ್ಯೊ ಆಗನ್ಯಾ ಬರದಾಡೊ ನತ್ತಿ. ಪೈಲಾತೊಬಿ ಎ ಆಗನ್ಯಾ ತುಮೊನೆ ವ್ಹತ್ತಿ. ತುಮೆ ಹಮ್ನಾಜ಼ ಐಕಲ ವಾಕ್ಯಾಜ಼ ಎ ಆಗನ್ಯಾ ವ್ಹೈ. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />ತೆನೈಸೊ ಎ ಆಗನ್ಯಾ ಮಿ ತುಮೊನೆ ನಯ್ಯೊ ಆಗನ್ಯಾ ರ‍್ಹಯಲ ನಿಂಗತ ವ್ಹೈ ಕೈನ ಕದಲ ನಿಂಗತ ಬರ್ದಾಡೊಸ. ತೆ ಆಗನ್ಯಾ ಕ್ಹರಿನಿಯೊಜ಼ ವ್ಹೈ. ತಿನು ಕ್ಹರಿ ತುಮೆ ಯೆಸುಮಾ ವರಿ ತುಮೊಮಾ ದೆಕ ಸಕೊಸಿ. ಅಂದಾರು ಗೈಪಡಾಡುಸ ವರಿ ಕ್ಹರಿನು ಉಜಾಲು ಆಯುಸ.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />"ಮಿ ಉಜಾಲಾಮಾ ಛೆ "ಕೈನ ಕವಾಲೊ ತೆ ತಿನಾ ಭೈನೆ ಮೊಸ ಕರತೊ ರ‍್ಹಯೊಮ, ತೆ ಮನಕ್ಹ ಹಜಿ಼ನಬಿ ಅಂದಕಾರಮಾ ಛೆ. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />ತಿನಾ ಭೈನೆ ಮಯಾ ಕರಾಲೊ ಉಜಾಲಾಮಾ ಛೆ. ಬಿಜೆ಼ಕ್ಲಾನೆ ಪಾಪಮಾ ಚ಼ಲಾವಾನು ತಿನಾಮಾ ರ‍್ಹತು ನೈ. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />ತೆನೈಸೊ ತಿನಾ ಭೈನೆ ಮೊಸ ಕರಾಲೊ ಅಂದಕಾರಮಾ ಛೆ. ತೆ ಅಂದಕಾರಮಾ ಜಿವ್ನಾ ಕರಸ. ತಿನೆ ತೆ ಕಿಜ್ಗಾ಼ ಚಾ಼ಲ್ಯೊಸ ಕವಾನು ಗ್ವತ್ತ ನತ್ತಿ. ಕಾಕದ್ಯಾಮ ಅಂದಕಾರನಿ ತಾಕತ ತಿನೆ ಡೊಳಾ ದಿಕ್ಹೆ ನೈಸೊ ಕರಿಪಾಡ್ಯುಸ.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />ಮಯಾನಾ ಬಚ್ಚಾ಼ವೊ, ತುಮಾರಾ ಪಾಪೊ ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಮಾಫ ಥಯಲ ಹುತಿ ಮಿ ಆ ತುಮೊನೆ ಬರ್ದಾಡ್ಯೊಸ. <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />ಬಾವೊ, ಆದಿತೊ ರ‍್ಹಯಲವಾಲಾನೆ ತುಮೆ ತಿಳದಲ ಹುತಿ ಮಿ ತುಮೊನೆ ಬರ್ದಾಡೊಸ. ಜಾಂಜಿಮಾನೊ, ತುಮೆ ಕೆಟ್ಟ ರ‍್ಹಯಲವಾಲಾನೆ ಹರಾಡಲ ಹುತಿ ಮಿ ತುಮೊನೆ ಬರ್ದಾಡ್ಯೊಸ.<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />ಬಚ್ಚಾ಼ವೊ, ತುಮೆ ಬಾನೆ ವಳಕಲ ಹುತಿ ಮಿ ತುಮೊನೆ ಬರ್ದಾಡ್ಯೊಸ. ಬಾ ಥಯಲವಾಲಾ, ಆದಿಮಾತೊಬಿ ರ‍್ಹಯಲವಾಲೊ ತುಮೆ ತಿಳದಲಹುತಿ ಮಿ ತುಮೊನೆ ಬರ್ದಾಡ್ಯೊಸ. ಜಾಂಜಿಮಾನೊ, ತುಮೆ ಘನ್ನಾ ತಾಕತ ರ‍್ಹಯಲವಾಲಾ ಹುತಿ ವರಿ ತುಮೆ ಕೆಟ್ಟನೆ ಸೊಲ್ಸಲ ಹುತಿ ಮಿ ತುಮೊನೆ ಬರ್ದಾಡ್ಯೊಸ.<verse eid="1JN 2:14" /></para>
  <para style="s">ದುನಿಯಾನಾ ಉಪ್ಪರ ಮಯಾ ನಕೊ ಮುಕ್ಕೊ</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />ಎ ಜಗತ ರ‍್ಹೈನೆಕಾ ಜಗತಮಾ ರ‍್ಹಯಲ ಸಾಮನ ರ‍್ಹೈನೆಕಾ ತಿನೆ ತುಮೆ ಮಯಾ ಕರೊ ನಕೊ. ಎ ಜಗತ್ನೆ ಮಯಾ ಕರಾಲೊ ಬಾನೆ (ಕ್ಹುದಾನೆ) ಮಯಾ ಕರತೊ ನೈ. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />ಜಗತಮಾ ರ‍್ಹಯಲ ಕೆಟ್ಟ ಸು ವ್ಹೈ ಕದ್ಯಾಮ; ಅಪೊನೆ ಪಾಪೊ ಕರು ಕೈನ ಮನಸ ಜಗ್ಗಾನಾ ಕಾಮೊ, ಅಪೆ ದೆಕಾನು ಪಾಪೊನು ಸಾಮನ ಅಪೊನೆ ಮಳು ಕೈನ ಆಸ ಕರಾನು, ವರಿ ಅಪೊಕನ ರ‍್ಹಯಲ ಸಾಮನೊಮಾ ಸ್ವಕ್ಕ ಕರಾನು. ತೆನೈಸೊ ಇವ್ನೊಮಾ ಕಯುಜ಼ ಕ್ಹುದಾ ಕಂತು ಆತು ನೈ. ಎ ಕ್ಹಾರು ಎ ಜಗತಮಾತು ಆವಸ. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />ಎ ಜಗತ ವರಿ ಮನಕ್ಹೊ ಆಸ ಕರಾನು ಹಾಳ ಥೈಜಾ಼ವಸ. ತೆನೈಸೊ ಕ್ಹುದಾನಿ ಚಿ಼ತ್ತನಿಂಗತ ಕರಾಲೊ ಹಮೆಶಾಬಿ ಜಿವ್ತೊ ರ‍್ಹವಸ.<verse eid="1JN 2:17" /></para>
  <para style="s">ಕ್ರಿಸ್ತನೊ ವಿರೊದಿ</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />ಮಾರಾ ಮಯಾನಾ ಬಚ್ಚಾ಼ವೊ, ಅಂತ್ಯ ಕಾಲ ನಜಿಕ ಆಯೊಸ! ಕ್ರಿಸ್ತನೊ ದುಶ್ಮನ ಆವಾಡೊಸ ಕೈನ ತುಮೆ ಐಕ್ಯಾಸ. ತಿನಾಹುತಿ ತುಮೆ ಅಂತ್ಯ ಕಾಲ ನಜಿ಼ಕ ಆಯೊಸ ಕೈನ ಹಮೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />ಕ್ರಿಸ್ತನೊ ದುಶ್ಮನೊ ಅಪ್ನಾ ಗುಂಪಮಾ ರ‍್ಹಯಾತಬಿ. ತ್ಯುನೆ ಅಪೊನೆ ಛೊಡಿನ ಗಯಾ. ತ್ಯುನೆ ಕ್ಹರಿಮಾಜ಼ ಅಪ್ನಾ ನ್ಹೊತಾ. ತ್ಯುನೆ ಕ್ಹರಿಮಾಜ಼ ಅಪ್ನಾ ಸಭೆವಾಲಾ ರ‍್ಹವತ್ತೊ ಅಪ್ನಾ ಕ್ಹಾತೆ ರ‍್ಹತಾತಾ. ತೆನೈಸೊ ತ್ಯುನೆ ಗೈ ಪಡ್ಯಾ. ತ್ಯುನೆ ಕ್ಹರಿಮಾಜ಼ ಅಪ್ನಾ ನ್ಹೊತಾ ಕವಾನು ಇಕ್ಹು ದೆಕಾಡಿನ ದಿವಸ.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />ಪರಿಶುದ್ಧ ರ‍್ಹಯಲವಾಲೊ (ಕ್ಹುದಾ ನೈತೊ ಕ್ರಿಸ್ತ) ದಿದಲ ವರಾ ತುಮೊನೆ ಮಳಿಸ. ತಿನಾಹುತಿ ತುಮೆ ಕ್ಹಾರು ಕ್ಹರಿ ವಳಕ್ಯಾಸ. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />ಮಿ ತುಮೊನೆ ಕಾ ಬರ್ದಿನ ದ್ಯು? ತುಮೆ ಕ್ಹರಿ ನತ್ತಿ ವಳಕಿ ಲಿದ್ಯಾ ಕೈನ ಬರ್ದುಸು? ನೈತೊ! ತುಮೆ ಕ್ಹರಿ ವಳಕಲ ಹುತಿ ಮಿ ಎ ಪತ್ರ ಬರ್ದಾಡೊಸ. ಕ್ಹರಿಕ್ಹು ಕಯುಜ಼ ಸುಳ್ಳ ಆತು ನೈ ಕವಾನು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ.<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />ತಿನಾಹುತಿ ಸುಳ್ಳ ಕವಾಲೊ ಕುನ ವ್ಹೈ? ಯೆಸು ಕ್ರಿಸ್ತ ನ್ಹವೈ ಕೈನ ಕವಾಲೊ ಸುಳ್ಳ ಬೊಲಾಲೊ ವ್ಹೈ. ತೆ ಕ್ರಿಸ್ತನೊ ದುಶ್ಮನ ವ್ಹೈ. ತೆ ಬಾನೆ ರ‍್ಹೈನೆಕಾ (ಕ್ಹುದಾನೆ) ತಿನಾ ದಿಕ್ರಾನೆ ರ‍್ಹೈನೆಕಾ (ಕ್ರಿಸ್ತನೆ) ನಂಬತೊ ನೈ. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />ದಿಕ್ರಾನೆ ನೈ ನಂಬಲವಾಲೊ ಬಾನೆ ನೈ ವ್ಹಂದಿಲೆತೊ. ತೆನೈಸೊ ದಿಕ್ರಾನೆ ಮಳೈಲಿದಲವಾಲೊ ಬಾನೆಬಿ ಹೊಂದಲ ನಿಂಗತ ವ್ಹೈ.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />ತುಮೆ ಶುರುತಾಬಿ ಐಕಲ ಭೊದನೆ ನಿಂಗತ ಚಾ಼ಲೊ. ತೆ ಭೊದನೆ ನಿಂಗತ ಚಾ಼ಲಾಲಾ ತುಮೆ ದಿಕ್ರಾಮಾಬಿ ಬಾಮಾಬಿ ರ‍್ಹಯಲ ನಿಂಗತ ವ್ಹೈ. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />ಕ್ರಿಸ್ತ ಅಪೊನೆ ಹಮೆಶಾನೊ ಜ಼ಲಮ ದ್ಯುಸ ಕೈನ ದಿದಲ ವಾಗ್ದಾನ.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />ತುಮೊನೆ ತಪ್ಪ ವಾಟ್ಮಾ ನಿಂಜಾ಼ವಾಲಾ ಮನಕ್ಹೊನಾ ಹುತಿ ಎ ಪತ್ರ ಬರ್ದಾಡ್ಯೊಸ. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />ಕ್ರಿಸ್ತ ಖಾಸ ರ‍್ಹಯಲ ವರಾ ತುಮೊನೆ ಮರಗಿನ ದಿದ್ಯೊ. ತೆ ತುಮೊಮಾ ಹಜು಼ನ ಛೆ. ತಿನಾಹುತಿ ತುಮೊನೆ ಕಯಾಜ಼ ಉಪದೆಶನಿ ಜ಼ರುರತ ನತ್ತಿ. ತೆ ತುಮೊನೆ ದಿದಲ ವರಾ ತೆ ತುಮೊನೆ ಕ್ಹಾರುಜ಼ ಉಪದೆಶ ಕರಸ. ತೆ ಕ್ಹರಿಜ಼ ವ್ಹೈ ಸುಳ್ಳ ನ್ಹ ವ್ಹೈ. ತಿನಾಹುತಿ ತುಮೆ ತೆ ಉಪದೆಶ ನಿಂಗತ ತಿಮಾ ರ‍್ಹವೊ.<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />ಹೊ, ಮಾರಾ ಮಯಾನಾ ದಿಕ್ರಾವೊ, ತಿನಾಮಾಜ಼ ರ‍್ಹಯ್ಯೆ. ಅಪೆ ಇಮ್ಮ ಕರ‍್ಯಾಮ. ಕ್ರಿಸ್ತ ಫ್ಹರಿನ ಆವಾನಾ ದಿನಮಾ ಅಪೆ ಭುಚ್ಕಾನಿ ಜ಼ರುರತ ನತ್ತಿ. ದಡಿ ರ‍್ಹವಾನಿ ಜ಼ರುರತ ನತ್ತಿ; ಸರಮಾವಾನಿ ಜ಼ರುರತ ರ‍್ಹತಿ ನೈ. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />ಕ್ರಿಸ್ತ ನಿತಿವಂತವಾಲೊ ವ್ಹೈ ಕವಾನು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. ತಿನಾಹುತಿ ಚೊ಼ಕು ಕರಾಲಾ ಮನಕ್ಹೊ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ ವ್ಹೈ ಕವಾನು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />ಬಾ ಅಪೊನೆ ಘನ್ನೊ ಮಯಾ ಕರ‍್ಯೊ! ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ ವ್ಹೈ ಕೈನ ಕವೈಲಿವಾನಾ ಯಕ್ಲೊ ಕ್ಹುದಾ ಅಪೊನೆ ಮಯಾ ಕರ‍್ಯೊ. ಅಪೆ ಕ್ಹರಿಮಾಜ಼ ಕ್ಹುದಾನ ಬಚ್ಚಾ಼ ವ್ಹೈ. ತೆನೈಸೊ ಜಗತ್ಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊತೊ ಹಮೆ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ ವ್ಹೈ ಕವಾನು ತಿಳ್ದಿಲಿದ್ಯಾ ನತ್ತಿ. ಕಾಕದ್ಯಾಮ ತ್ಯುನೆ ಕ್ಹುದಾನೆ ವಳಕ್ಯಾ ನತ್ತಿ. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />ಮಯಾನಾ ದೊಸ್ತೊ, ಹಮ್ನಾ ಅಪೆ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ ಥಯಾಸ. ಅಗಾ ಅಪೆ ಸು ಥೈಯೆಸ ಕೈನ ಅಪೊನೆ ದೆಕಾಡಿನ ದಿದ್ಯೊ ನತ್ತಿ.ತೆನೈಸೊ ಕ್ರಿಸ್ತ ಫರಿನ ಆಯಲ್ಪರ ತಿನೆ ತಿಳ್ದಿಲಿಯೆಸ. ಅಪೆ ತಿನಾ ನಿಂಗತ ಥಯೆಸ. ಅಪೆ ತಿನು ಕ್ಹರಿನು ರೂಪ ದೆಕಿಯೆಸ. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />ಕ್ರಿಸ್ತಮಾ ಆಸ ಮ್ಹೆಲಲ ಹರಿಯಕ್ಲಾ ಕ್ರಿಸ್ತ ಕಿಮ್ಮ ಪರಿಶುದ್ಧ ಛೆ ತಿನಾ ನಿಂಗತಜ಼ ಹರಿಯಕ್ಲಾ ಪರಿಶುದ್ಧ ಥೌ.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />ಪಾಪ ಕರಾಲೊ ಕ್ಹುದಾನಿಯೊ ಆಗನ್ಯಾ ದಾಟಿನ ಜಾ಼ವಲೊ ಥಾವಸ. ಹೊ ಪಾಪ ಕರಾನು ವರಿ ಕ್ಹುದಾನಿಯೊ ಆಗನ್ಯಾನೆ ವಿರುದ್ದ ಕರಾಲೊಬಿ ತ್ಯುನೊನೆ ಸುಜ಼ ಫರಕ ನ್ಹವೈ. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />ಕ್ರಿಸ್ತ ಮನಕ್ಹೊನೆ ಪಾಪಕ್ಹು ಛೊಡಾವಾನಾಹುತಿ ಆಯೊಸ ಕವಾನು ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ. ತಿಕನ ಪಾಪ ಕವಾನು ನತ್ತಿ. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />ತಿನಾಹುತಿ ಕ್ರಿಸ್ತಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹ ಪಾಪ ಕರತೊಜ಼ ರ‍್ಹತೊ ನೈ. ಪಾಪ ಕರತೊಜ಼ ರ‍್ಹವಾಲೊ ತಿನೆ ಕೆಳಾಮಾಜ಼ ಕಳೈಲಿದಲವಾಲೊ ನ್ಹವೈ ವರಿ ಕೆಳಾಮಾಜ಼ ತಿಳದಿಲಿದವಾಲೊ ನ್ಹವೈ.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />ಮಯಾನಾ ಬಚ್ಚಾ಼ವೊ, ತುಮೊನೆ ಕುನ್ನಜ಼ ತಪ್ಪ ವಾಟ್ಮಾ ನಿಂಜಾ಼ಯೆ ನೈಸೊ ತುಮೆ ದೆಕಿಲಿವೊ. ಕ್ರಿಸ್ತ ನಿತಿವಂತವಾಲೊ ವ್ಹೈ. ತಿನಾ ನಿಂಗತಜ಼ ನಿತಿವಂತವಾಲಾ ಥೌಸ ಕೈನ ಕವಾಲಾ ಚೊ಼ಕುಜ಼ ಕಾಮ ಕರು. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />ಸೈತಾನ ಪೈಲಾತೊಬಿ ಪಾಪೊ ಕರಾಡೊಸ. ಪಾಪೊ ಕರಾಲೊ ಸೈತಾನಾ ಕ್ಹಾತೆ ಮಳಲವಾಲೊ ವ್ಹೈ. ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ಕ್ರಿಸ್ತ ಸೈತಾನ ಕಾಮೊ ಹಾಳ ಕರಾನೆಜ಼ ಆಯೊಸ.<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />ಕ್ಹುದಾಕಂತೊ ನವೊ ಜ಼ಲಮಲಿನ ಹುಟ್ಟಿನ ಆಯಲವಾಲೊ ಪಾಪಮಾ ರ‍್ಹತೊಜ಼ ನೈ ಕಾಕದ್ಯಾಮ ತೆ ದಿದಲ ನವೊ ಜ಼ಲಮ ಕ್ಹುದಾನೊ ರ‍್ಹಯಲ ರ‍್ಹವಸ. ತೆ ಕ್ಹುದಾಕಂತೊ ನವೊ ಜ಼ಲಮ ಲಿನ ಹುಟ್ಟಲ ಹುತಿ ತೆ ಅಗೊಬಿ ಪಾಪ ಕರಾನೆ ಥಾತು ನೈ. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />ತಿನಾ ಹುತಿ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ ವರಿ ಸೈತಾನನಾ ಕುನ ವ್ಹೈ ಕೈನ ತಿಳದಿಲಿಯ್ಯೆಸ. ಯೊಗ್ಯ ರ‍್ಹಯಲ ನೈ ಕರಾಲಾ ಮನಕ್ಹೊ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ ನ್ಹವೈ. ತಿನಾ ಭೈನೆ ನೈ ಮಯಾ ಕರಾಲೊ ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ನ್ಹವೈ.<verse eid="1JN 3:10" /></para>
  <para style="s">ಯಕ್ಲಾನೆ ಯಕ್ಲೊ ಮಯಾ ಕರೊ</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />ಅಪೆ ಯಕ್ನಾ ಯಕ್ಕ ಮಯಾ ಕರು ಕವಾನು ತುಮೆ ಪೈಲಾತಾಬಿ ಐಕಲ ವಾಕ್ಯಾ. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />ತುಮೆ ಕಾಯಿನ ನಿಂಗತ ರ‍್ಹವೊ ನಕೊ. ತೆ ಕೆಟ್ಟನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲವಾಲೊ ವ್ಹತ್ತೊ. ತೆ ತಿನಾ ಭೈನೆ (ಹೆಬಲ) ಖಲಾಸ ಕರಿಪಾಡ್ಯೊ. ತೆ ತಿನಾ ಭೈನೆ ಖಲಾಸ ಕರಲ ಶಾನಾ ಹುತಿ ವ್ಹೈ? ತಿನಾ ಕಾಮೊ ಕೆಟ್ಟಜ಼ ವ್ಹೈ. ತಿನಾ ಭೈನಾ ಕಾಮೊ ಚೊ಼ಕಾ ರ‍್ಹಯಲ ಹುತಿ ವ್ಹೈ.<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />ಭಾಯೊ ಭೆನೊ, ಎ ದುನಿಯಾಮಾನಾ ಮನಕ್ಹೊ ತುಮೊನೆ ದುಶ್ಮನಿ ಕರ್ತಾಮಾ ಘಾಬ್ರಾಥಾವೊನಕೊ. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />ಅಪೆ ಮರಣನೆ ದುರ ಕರಿನ ಜಿವ್ತಾ ರ‍್ಹವಾನೆ ಆಯಾಸ ಕವಾನು ಅಪೊನೆ ಗ್ವತ್ತ ಛೆ. ಕ್ರಿಸ್ತಮಾ ಮಾರಾ ಭಾಯೊ ಭೆನೊನೆ ಅಪೆ ಮಯಾ ಕಾರಿಕ್ಹು ಎ ಕ್ಹಾರು ವಳಕ್ಯೊಸ. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />ತಿನಾ ಖುದ್ದನಾ ಭೈನೆ ದ್ವೆಶ ಕರಾಲೊ ಹರಿ ಯಕ್ಲೊ ಖಲಾಸ ಕರಾಲೊ ಥಯಾಸ. ಕಯಾಜ಼ ಖಲಾಸ ಕರಾಲಾಮಾ ಹಮೆಶಾನೊ ಜ಼ಲಮ ರ‍್ಹತೊ ನೈ. ಕೈನ ಮನೆ ಗ್ವತ್ತ ಥಯುಸ. <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />ಯೆಸು ತಿನೊ ಜ಼ಲಮಜ಼ ದಿದಲ ಹುತಿ ಕ್ಹರಿನಿ ಮಯಾ ಛೆ ಕವಾನು ಹಮೆ ವಳಕಿಲಿದ್ಯಾ ತಿನಾಹುತಿ ಭಾಯೊ ಭೆನೊನಾ ಹುತಿ ಅಪೆ ಜ಼ಲಮ ದ್ಯು. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />ಎ ದುನಿಯಾಮಾ ಸೌಕಾರ ರ‍್ಹಯಲ ಕುನಬಿ ಕೊರೆತೆಮಾ ರ‍್ಹಯಲ ತಿನಾ ಭೈನೆ ದೆಕಿನಬಿ ಮದತ ನೈ ಕರ‍್ಯಮ ತಿಮಾ ಕ್ಹುದಾನಿ ಮಯಾ ರ‍್ಹವಾನೆ ಸಾದ್ಯ ಛೆ ಸು? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />ಮಾರಾ ಬಚ್ಚಾ಼ವೊ ಮಾರಿ ಮಯಾ ಖಾಲಿ ವಾತೊಮಾ ವರಿ ಶಬ್ದುಮಾ ರ‍್ಹೌ ನೈ ಮಾರಿ ಮಯಾ ಕ್ಹರಿನಿ ಮಯಾ ರ‍್ಹೌ ಅಪೆ ಕರಾನಾ ಕಾಮಾಮಾಜ಼ ಆಪನಿ ಮಯಾ ದೆಕಾಡಿನ ದ್ಯು.<verse eid="1JN 3:18" /></para>
  <para style="s">ಕ್ಹುದಾನಾ ಕ್ಹಾಮಾ ಧೈರ್ಯಕ್ಹು ರ‍್ಹವಾನು</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />ಅಪೆ ಕ್ಹರಿನಿವಾಟಮಾ ರ‍್ಹಯಲಿವಾಲಾ ವ್ಹೈ ಕೈನ ಇನಾ ಮುಲಕಜ಼ ತಿಳದಿಲಿಯೆಸ. <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />ಅಪನಿ ಮನಸಾಕ್ಷಿ ಅಪೆ ತಪ್ಪಿಸ್ಥ ವ್ಹೈ ಕೈನ ಕದ್ಯಾ ತಬಿ ಅಪೆ ಕ್ಹುದಾನಾ ಕ್ಹಾಮಾ ಸಮಾಧಾನ ಕ್ಹು ರ‍್ಹವಾನೆ ಸಾಧ್ಯ. ಕಾಕದ್ಯಾಮ ಅಪನಿ ಮನಸ್ಸನಿ ತಿಬಿ ಕ್ಹುದಾ ಮ್ಹೊಟೊ ವ್ಹೈ. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />ಮಾರೊ ಮಯಾನೊ ದೊಸ್ತತೊ, ಅಪೆ ತಪ್ಪ ಕರಾಡಾನತಿ ಕೆಲಾಮಾಬಿ ತುಮೊನೆ ಕಲಿಮ, ಅಪೆ ಕ್ಹುದಾನೆ ಕ್ಹಾತೆ ದೈರೆಕ್ಹು ಆವಾನು ಸಾದ್ಯ.<verse eid="1JN 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 3:22" />ವರಿ ಅಪೆ ತಿನಿ ಕದಲ ತಿಮ್ಮ ರ‍್ಹೈನ ತಿನಿ ಎಣಿಕೆಮಾ ರ‍್ಹೈನ ತಿನೆ ಪಸಂದ ರ‍್ಹಯಲ ಕಾಮೊ ಕರಾಲಾ ರ‍್ಹಯಲ ಹುತಿ ಅಪೆ ಸು ಮಾಂಗಿಲಿದ್ಯಾ ತುಬಿ ತಿಕ್ಹು ವ್ಹಂದಿಲಿಯೆಸ. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />ಕ್ಹುದಾನಾ ಆಗನ್ಯೆ ಸು ವ್ಹೈ ಕದ್ಯಾಮ ತಿನೊ ದಿಕ್ರೊ ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತಮಾ ಅಪೆ ಬರೊಕ್ಹೊ ಮ್ಹೆಲಿನ ಯಕ್ನೆ ಯಕ್ಕ ಮಯಾ ಕರು ಕವಾನುಜ಼ ವ್ಹೈ. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />ಕ್ಹುದಾನಿ ಆಗನ್ಯಾನೆ ವಿಧೆಯ ರ‍್ಹಯಲವಾಲೊ ಕ್ಹುದಾಮಾ ಛೆ ಕವಾನು ಅಪ್ನೊನೆ ಕಿಮ್ಮ ಗ್ವತ್ತ‌ ಛೆ ಕ್ಹುದಾ ಅಪ್ನೊನೆ ದಿದಲ ಪವಿತ್ರ ಆತ್ಮಾ ಕ್ಹುಜ಼ ಅಪೊನೆ ಗ್ವತ್ತ ಛೆ.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">ಕೆಟ್ಟ ಆತ್ಮಾ ವರಿ ಕ್ಹರಿನಿ ಆತ್ಮಾ ಕುನ್ನ ವ್ಹೈ ಕೈನ ಕಳಿಲಿವೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />ಮಾರಾ ಮಯಾನಾ ದೊಸ್ತೊ, ಎ ದುನಿಯಾಮಾ ಘನ್ನಾ ಸುಳ್ಳ ಪ್ರವಾದಿಯೊ ಛೆ. ತಿನಾ ಹುತಿ ಹರಿ ಯಕ್ಕ ಆತ್ಮಾಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲೊ ನಕೊ. ತೆನೈಸೊ ತೆ ಆತ್ಮಾವೊ ಕ್ಹುದಾತಿ ಐಯೊಸ ಕೈನ ಪರಿಕ್ಷಾ ಕರಿನ ವಳಕಿಲಿವೊ. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />ಕ್ಹುದಾನಿ ಆತ್ಮಾನೆಬಿ ತುಮೆ ವಳಕಿಲಿವಾನೆ ಇಮ್ಮಜ಼ ಸಾದ್ಯ ಛೆ" ಎ ದುನಿಯಾಮಾ ಮನಕ್ಹ ಥೈನ ಆಯಲ ಯೆಸುಜ಼ ಕ್ರಿಸ್ತ ವ್ಹೈ ಕೈನ ಮಿ ಬರೊಕ್ಹೊ ಕರುಸ "ಕೈನ ಕವಾನಿ ಆತ್ಮಾಜ಼಼ ಕ್ಹುದಾಕಂತಿ ಆಯಲ ವ್ಹೈ.<verse eid="1JN 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 4:3" />ಯೆಸುನಾ ಹುತಿ ಇಮ್ಮ ನೈ ಕವಾನಿ ಆತ್ಮಾ ಕ್ಹುದಾಕಂತಿ ಆಯಲ ನ್ಹವೈ. ತೆ ಆತ್ಮಾ ಕ್ರಿಸ್ತನಾ ವಿರೊದಿ ವ್ಹೈ. ಕರ್ಇಸ್ತನೊ ವಿರೊದಿ ಆವಸ ಕವಾನು ತುಮೆ ಐಕೊಶಿ. ಕ್ರಿಸ್ತನೊ ವಿರೊದಿ ಹಮ್ನಾಜ಼ ದುನಿಯಾಮಾ ಛೆ.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />ಮಾರಾ ಮಯಾನಾ ಬಚ್ಚಾ಼ವೊ, ತುಮೆ ಕ್ಹುದಾನೆ ಸೆರಲವಾಲಾ ವ್ಹೈ. ತೆನೈಸೊ ತುಮೆ ತ್ಯುನೊನೆ <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />ತೆ ಮನಕ್ಹೊ ಎ ದುನಿಯಾಮಾ ಮಳಲವಾಲಾ ವ್ಹೈ. ತಿನಾಹುತಿ ತ್ಯುನೆ ಕವಾನು ಕ್ಹಾರು ಎ ದುನಿಯಾನೆ ಮಳಲ ವ್ಹೈ. ತುನೆ ಸು ಕದ್ಯಾತುಬಿ ದುನಿಯಾನಿಯೊಜ಼ ವಾತೊ ಕವಸ. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />ಹಮೆತೊ ಕ್ಹುದಾಕುತ ಆಯಲ ವ್ಹೈ. ತಿನಾಹುತಿ ಕ್ಹುದಾನೆ ವಳಕಲವಾಲಾ ಮನಕ್ಹೊ. ಹಮೆ ಕವಾನು ಐಕಸ. ತೆನೈಸೊ ಕ್ಹುದಾಕಂತಾ ನೈ. ಅಯಲ ಮನಕ್ಹೊ ಹಮೆ ಕವಾನು ಐಕ್ತಾ ನೈ. ಕಯು ಕ್ಹರಿ ಕವಾನು ಆತ್ಮ ಕಯು ಸುಳ್ಳ ಕವಾನಿ ಆತ್ಮ ಕವಾನು ಇಮ್ಮ ಕವಸ.<verse eid="1JN 4:6" /></para>
  <para style="s">ಕ್ಹುದಾಜ಼ ಮಯಾ ವ್ಹೈ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />ಮಯಾನಾ ದೊಸ್ತೊ. ಮಯಾ ಕ್ಹುದಾಕಂತು ಆಯಲ ರ‍್ಹಯಲ ಹುತಿ ಅಪೆ ಬಿ ಯಕ್ನೆ ಯಕ್ಕ ಮಯಾ ಕರು. ಮಯಾ ಕರಾಲೊ ನವೊ ಜ಼ಲಮಲಿನ ಹುಟ್ಟಲವಾಲೊ ಥಯಾಸ. ತಿನಾಹುತಿ ತೆ ಕ್ಹುದಾನೆ ವಳಕಲವಾಲೊ ವ್ಹೈ. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />ಮಯಾ ನೈ ಕರಾಲೊ ಕ್ಹುದಾನೆ ವಳಕಾಲೊ ನ್ಹವೈ. ಕಾಕದ್ಯಾಮ ಕ್ಹುದಾ ಮಯಾನೊ ರುಪ ವ್ಹೈ. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />ಕ್ಹುದಾ ತಿನಾ ರ‍್ಹಯಲ ಯಕ್ಲಾಜ಼ ದಿಕ್ರಾನಾ ಮುಲಕ ಮನೆ ಜ಼ಲಮ ದಿವಾನಾ ಹುತಿ ದುನಿಯಾಮಾ ಮೊಕಲ್ಯೊ. ಇನಾ ನಿಂಗತ ಕ್ಹುದಾ ತಿನಿ ಮಯಾ ದೆಕಾಡ್ಯೊ. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />ಅಪೊಪರ ರ‍್ಹಯಲ ಕ್ಹುದಾನಿ ಮಯಾ ಕ್ಹರಿನಿಜ಼ ವ್ಹೈ. ಅಪೊನೆ ಕ್ಹುದಾಪರ ರ‍್ಹಯಲ ಕ್ಹರಿನಿ ಮಯಾ ನ್ಹವೈ. ಅಪ್ನಾ ಪಾಪ ನಿವಾರಣನಾ ಹುತಿ ಕ್ಹುದಾ ತಿನಾ ದಿಕ್ರಾನೆ ಮೊಕಲ್ಯೊ.<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />ಮಯಾನಾ ದೊಸ್ತೊ, ಇಮ್ಮ ಕ್ಹುದಾ ಅಪೊನೆ ಘನ್ನಿ ಮಯಾ ಕರ‍್ಯೊ! ತಿನಾಹುತಿ ಅಪೆ ಯಕ್ನೆ ಯಕ್ಕ ಮಯಾ ಕರು. ಕ್ಹುದಾನೆ ಕುನ್ನಜ಼ ದೆಕ್ಯು ನತ್ತಿ. ತೆನೈಸೊ ಅಪೆ ಯಕ್ನೆ ಯಕ್ಕ ಮಯಾ ಕರ‍್ಯಾಮ ಕ್ಹುದಾ ಅಪ್ನಾಮಾ ರ‍್ಹವಸ. ಅಪೆ ಯಕ್ನಾ ಯಕ್ಕ ಮಯಾ ಕರ‍್ಯಾಮ ಕ್ಹುದಾನಿ ಮಯಾ ಅಪ್ನಾಮಾ ಪುರಾ ಥೈನ ರ‍್ಹವಸ. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />ಕ್ಹುದಾನೆ ಕುನ್ನಜ಼ ಕೆಳಾಮಾ ದೆಕ್ಯು ನತ್ತಿ. ಅಪೆ ಯಕ್ಲಾನೆ ಯಕ್ಲಾ ಮಯಾ ಕರ‍್ಯಾರೆ ಕ್ಹುದಾ ಅಪ್ನೊಮಾ ರ‍್ಹಯಲ ರ‍್ಹವಸ, ವರಿ ತಿಕ್ಹು ಮಳಾನಿ ಮಯಾ ಅಪ್ನೊಮಾಬಿ ಆವಸ.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />ಅಪೆ ಕ್ಹುದಾಮಾ ಛೆ ವರಿ ಕ್ಹುದಾ ಅಪೊಮಾ ಛೆ ಕವಾನು ಅಪೊನೆ ಗ್ವತ್ತ ಛೆ. ಕ್ಹುದಾ ತಿನಿ ಆತ್ಮಾ ದಿದಲ ಹುತಿ ತಿನಾಹುತಿ ಅಪ್ನೊನೆ ಎ ಗ್ವತ್ತ ಥಯೊಸ. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />ಕ್ಹುದಾ ತಿನಾ ದಿಕ್ರಾನೆ ದುನಿಯಾನೆ ರಕ್ಷಕ ಕರಿನ ಮೊಕಲ್ಯೊ ಅಪೆ ದೆಕ್ಯಾಸ. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />ಯೆಸು ಕ್ರಿಸ್ತ ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ವ್ಹೈ ಕೈನ ಕುನ್ನ ವಪ್ಪಿಲಿವಸ ತಿನಾಮಾ ಕ್ಹುದಾ ರ‍್ಹವಸ ವರಿ ತೆ ಕ್ಹುದಾಮಾ ರ‍್ಹವಸ. <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />ಕ್ಹುದಾ ಅಪೊಪರ ಮ್ಹೆಲಲ ಮಯಾ ಅಪೆ ಗ್ವತ್ತ ಕರ್ಲಿದ್ಯಾಸ ವರಿ ಅಪೆ ಬರೊಕ್ಹೊ ಕರ‍್ಯಾಸ.</para>
  <para style="p" vid="1JN 4:16">ಕ್ಹುದಾ ಮಯಾನೊ ಸ್ವರುಪ ವ್ಹೈ. ಮಯಾಮಾ ಘಟ್ಟ್ಟ ಥೈನ ರ‍್ಹವಾಲೊ ಕ್ಹುದಾ ತಿಮಾ ಘಟ್ಟ್ಟ ಥೈನ ರ‍್ಹವಸ. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />ಪೈಸಲಾನಾ ದಿನಮಾ ಅಪ್ನೊಮಾ ರ‍್ಹಯಲ ಧೈರ್ಯಕ್ಹುಜ಼ ತಿನಿ ಮಯಾ ಅಪ್ನೊಮಾ ಬೆಳದಲ ಛೆ. ಕಾ ಕದ್ಯಾಮ ಯೆಸು ಕಿಮ್ಮ ಛೆ ಅಪೆಬಿ ತಿಮ್ಮಜ಼ ದುನಿಯಾಮಾ ಛೆ. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />ಮಯಾ ರ‍್ಹಯಲ ಜ಼ಗಾ ಭೆ ನತಿ. ಬುಚುಕ ರ‍್ಹಯಲ ಜ಼ಗಾ ಭೆ ರ‍್ಹವಸ. ತೆ ನೈಸೊ ಭೆ ನೆ ಮಾರಿಪಡಸ. ಬುಚಕಾಲೊ ಮಾಯಾಮ್ಮಾ ಪುರಾನೈ ಥಾತೊ ನೈ.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />ಕ್ಹುದಾ ಪೈಲಾತೊಜ ಅಪನೊನೆ ಮಾಯಾ ಕರಲಕ್ಹು ಅಪೆ ತಿನಿ ಮಯಾ ಕರಿಯೆಸ. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />ಯಕ್ಲೊ ತೆ ಕ್ಹುದಾನೆ ಮಯಾ ಕರಸ ತೆ ಕೈನ ತಿನಾ ಭಾಯೊನೆ ದುಶ್ಮನಿ ಕರ‍್ಯಾಮ ತೆ ಸುಳ್ಳ ಬೊಲಾಲೊ ಥಯೊಸ. ಕಾ ಕದ್ಯಾಮ್ಮಾ ತಿನಾ ಕ್ಹಾತೆ ರ‍್ಹಯಲ ಭಾಯೊನೆಬಿ ಮಯಾ ಕರವಾಲೊ, ತೆ ನೈ ದೆಕೆಲ ಕ್ಹುದಾನೆ ಕಿಮ್ಮ ಮಯಾ ಕರಸಕ? <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />ಕ್ಹುದಾನೆ ಮಯಾ ಕರಸ. ತಿನೆ ಭಾಯೊನೆ ಮಯಾ ಕರಸ ಕೈನ ಆಜ್ಞಾ ಅಪೆ ತಿನಾಕ್ಹುಜ ಹೊಂದ್ಯಾಸ.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">ದುನಿಯಾನೆ ಜಿತ್ತೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />ಯೆಸು ಕ್ರಿಸ್ತ ವ್ಹೈ ಕೈನ ಬರೊಕ್ಹೊ ಕರಾಲೊ ಹರಯಕ್ಲೊ ಕ್ಹುದಾಕ್ಹು ಹುಟ್ಟಲವಾಲೊ ವ್ಹೈ, ಕುನ್ನ ಹುಟ್ಸಯಲ ಬಾಪನೆ ಮಯಾ ಕರಸ ತೆ ತಿನಾ ಬಾಪಕ್ಹು ಹುಟ್ಟಲವಾಲಾ ಹರಯಕ್ಲಾನೆ ಮಯಾ ಕರಸ. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />ಅಪೆ ಕ್ಹುದಾನಾ ಬಚ್ಚಾ಼ವೊನೆ ಮಯಾ ಕರಸ ಕೈನ ಕ್ಹುದಾನೆ ಮಯಾ ಕರಿನ ತಿನಿ ವಾತ ಲಿಂಗತ ಚಾಲ್ಯಾರೆಜ ಗ್ವತ್ತ ಥಾವಸ.<verse eid="1JN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 5:3" />ಕ್ಹುದಾನಾ ಉಪ್ಪರ ರ‍್ಹಯಲ ಮಯಾ ಸು ವ್ಹೈ ಕದ್ಯಾಮ ತಿನಾ ಆಗ್ಯಾನಾ ನಿಂಗತ ಚಾಲಾನುಜ ವ್ಹೈ. ತಿನಾ ಆಗ್ಯಾ ವಜ್ಜು ನ್ಹವೈ. <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />ಮ್ಹೊಟೊ ಕುರಬುರ‍್ಯೊ (ಕ್ರಿಸ್ತ) ದಿಕ್ಹಾತಾಮಾ, ತುಮೊನೆ ಕಿರಿಟ ಮಳಸ. ಮ್ಹೊಟಿ ಮಹಿಮಾ ವ್ಹಂದಿಲಿದ್ಯಾಮ ತೆ ಕಿರಿಟ ತಿನು ಸುಂದ್ದರತಾ ಜವೈ ಲೈತೊನೈ. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />ಜಾಜಿಮಾನೆ ಮಿ ತುಮೊನೆ ದಕ್ಹಿಯೊ ವಾತೊ ಕೌಕಯಿನ. ಆಯೊಸ. ತುಮೆ ಮೊಟಾಹೊನೆ ಅದಿನ ಥಹೊ. ತುಮೆ ಕ್ಹಾರಾ ಯಕ್ಕನೆ ಯಕ್ಕಲೊ ತಗಿಲಿ ಚಲು.<verse eid="1JN 5:5" /></para>
  <para style="s">ಯೆಸು ಕ್ರಿಸ್ತನಾ ಹುತಿ ಸಾಕ್ಷಿ</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />ಕಾಕದ್ಯಾಮ ಯೆಸು ಕ್ರಿಸ್ತ ಪಾನಿಕ್ಹು ರಗತಕ್ಹು ಸಾಕ್ಷಿ ಹೊಂದವಾಲೊ ವ್ಹೈ. ಪಾನಿಕ್ಹು ಯಕ್ಕಜ಼ ನೈ ರಗತಕ್ಹು ಸಾಕ್ಷಿ ಹೊಂದಲವಾಲೊ ವ್ಹೈ. ಆತ್ಮಾ ಸಾಕ್ಷಿ ದಿವಸ ಕಾಕದ್ಯಾಮ ತೆ ಆತ್ಮಾ ಕ್ಹರಿನಿ ಆತ್ಮಾ ವ್ಹೈ. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />ತೆ ತುಮೊನೆ ಪಾಲನೆ ಕರಾನಾಹುತಿ ತುಮಾರಿ ಚಿಂತಾ ಕ್ಹಾರಿ ತಿನೆ ಒಪ್ಪಸೊ. <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />ಆತ್ಮ ಪಾನಿ ವರಿ ರಗತ ಎ ತನ್ನೆನೆ ಸಾಕ್ಷಿನಿ ವಚಾರ ಯಕ್ಕಜ಼ ವ್ಹೈ.<verse eid="1JN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 5:9" />ಮನಕ್ಹೊ ಸಾಕ್ಷಿ ಕತಾಮಾ ಅಪೆ ಬರೊಕ್ಹೊ ಕರಿಯೆಸ ತೆನೈಸೊ ಕ್ಹುದಾನಿ ಸಾಕ್ಷಿ ತಿತ್ತಿಬಿ ಖಾಸವ್ಹೈ. ಕ್ಹುದಾ ತಿನ್ನಾ ಸ್ವಂತ ದಿಕ್ರಾನಾ ಹುತಿ ಕದಲ ಕ್ಹರಿಜ಼ ತೆ ಅಪೊನೆ ದಿದಲ ಸಾಕ್ಷಿ ವ್ಹೈ. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />ಕ್ಹುದಾನಾ ದಿಕ್ರಾನೆ ಬರೊಕ್ಹೊ ಕರಲಾವೊನೆ ಕ್ಹುದಾಕ್ಹು ಸಾಕ್ಷಿದಿದಲ ಕ್ಹರಿ ವ್ಹಂದಲ ರ‍್ಹವಸ. ಕ್ಹುದಾನೆ ನೈನಂಬಲವಾಲೊ. ಕ್ಹುದಾನೆ ಸುಳ್ಳವಾಲೊ ಕರಸ. ಕಾಕದ್ಯಾಮ ಕ್ಹುದಾ ತಿನಾ ದಿಕ್ರಾನೆ ಹುತಿ ಕದಲ ತೆ ಬರೊಕ್ಹೊ ನೈ ಕರ್ತೊ.<verse eid="1JN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 5:11" />ತೆ ಸಾಕ್ಷಿ ಕೈವೈ ಕದ್ಯಾಮ, ಕ್ಹುದಾ ಅಪನೊನೆ ಹಮೆಶಾನೊ ಜ಼ಲಮ್ಮ ದಿದ್ಯೊಸ. ತೆ ಜ಼ಲಮ್ಮ ತಿನಾ ದಿಕ್ರಾಮಾ ಛೆ ಕೈನ. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />ಕುನ ಕ್ಹುದಾನಾ ದಿಕ್ರಾನೆ ನಂಬಸ ತ್ಯುನೊನೆ ತೆ ಜ಼ಲಮ್ಮ ಛೆ,ತೆನೈಸೊ ಕುನ ಕ್ಹುದಾನಾ ದಿಕ್ರಾನೆ ನೈ ನಂಬತು ತ್ಯುನೊಮಾ ತೆ ಜ಼ಲಮ್ಮ ನತ್ತಿ.<verse eid="1JN 5:12" /></para>
  <para style="s">ಹಮೆಶಾನು ಜ಼ಲಮ</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />ಕ್ಹುದಾನಾ ದಿಕ್ರಾಪರ ಭರೊಕ್ಹೊ ಮ್ಹೆಲಾವಾಲಾ ಥೈನತಮನೊಮ್ಮಾ ತೆ ಹಮೆಶಾನು ಜ಼ಲಮ್ಮ ಛೆಕೈನ ಗೊತ್ತ ಥವಾನಾಹುತಿ ತಮನೊನೆ ಆ ವಿಷಯಯೊ ಲಿಕ್ಯೊ. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />ವರಿ ಕ್ಹುದಾನಾ ಚಿತ್ತನಾ ಪೆ ಮಾಂಗಿಲಿವಾನು ತೆ ಪುರಾ ಕರಸ ಕೈನ ಭರೊಕ್ಹೊ ತಿಪರ ರ‍್ಹವಸ. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />ಅಪೆ ಸು ಮಾಂಗಿಲಿದ್ಯಾ ತಬಿ ತೆ ಅಪೆ ಮಾಂಗಿಲಿದೆಲ ಐಕಸ ಕೈನ ಅಪ್ನೊ ಗೊತ್ತ ರ‍್ಹೈಮ, ಅಪೆ ಮಾಂಗಿಲಿವಾನು ತಿಕ್ಹು ಅಪೊನೆ ಮಳಸ ಕೈನ ಗೊತ್ತ ಥಾವಸ.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />ತುಮಾರಾಮಾ ಕುನಬಿ ಯಕ್ಕ ವಿಸ್ವಾಸಿ ತಿನಾ ಬಾ ಮೌಥ ನೈಸೊ ಪಾಪ ದೆಕಿನ ತೆ ಕ್ಹುದಾ ಕನ ಮಾಂಗಿಲಿವಾದೆ ತೆಳಾಮಾ ಕ್ಹುದಾ ಮೌತ ನೈಸೊ ಪಾಪ ಕರಾವಾಲಾವೊನೆ ಜ಼ಲಮ ದಿವಸ. ಮೌತ ರ‍್ಹಯಲ ಪಾಪ ಛೆ ತೆ ಪಾಪನಾ ವಿಷಯಮ್ಮಾ ತೆ ಮಾಂಗಿಲ್ಯು ಮಿ ನೈ ಕತೊ. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />ನಿತಿನೆ ವಿರುದ್ದ ಥಯಲ ಕ್ಹಾರು ಪಾಪ ಥೈಯುಸ. ತೆನೈಸೊ ಮೌತ ರ‍್ಹಯಲ ಪಾಪ ಛೆ.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />ಕ್ಹುದಾಕ್ಹು ಹುಟೆಲ ಪಾಪ ನೈಕರತ್ತಾ ಕೈನ ಮನೆ ಗೊತ್ತ ಛೆ. ಕ್ಹುದಾಕ್ಹು ಹುಟೆಲ ಕ್ಹುದಕ್ಹು ತಿನೆ ವಚಾಡಲಿವಸ ಕೆಟ್ಟನು ತೆ ನೈ ಮೊಟ್ಟತೊ.<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />ಕ್ಹಾರಿ ದುನಿಯಾಮ್ಮಾ ಕೆಟನಾ ವಿಷಮಾ ರ‍್ಹೈತಬಿ ಅಪೆ ಕ್ಹುದಾನೆ ಸಂಬಂಧಪಟ್ಟೆಲ ವಾಲಾ ಛೆ ಕೈನ ಅಪನೊನೆ ಗೊತ್ತ ಛೆ.<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ಆ ದುನಿಯಾಮಾ ಐನ ಅಪೆ ಕ್ಹರಿನಾಜ ಕ್ಹುದಾನೆ ವಳಕಿಲಿವಾನಾ ಹುತಿ ಅಪನೊನೆ ಗ್ಯಾನ ದಿವಸ ಕೈನ ಅಪನೊನೆ ಗೊತ್ತ ಛೆ,ವರಿ ಹಮೆ ಕ್ಹುದಾನಾ ದಿಕ್ರೊ ಥಯಲ ಯೆಸುಕ್ರಿಸ್ತಮಾ ರ‍್ಹವಾಲೊ ಥೈನ ಕ್ಹರಿನಾ ಕ್ಹುದಾಮಾ ರ‍್ಹಹೆಲವಾಲಾ ಛೆ. ತೆ ಕ್ರಿಸ್ತ ಕ್ಹರಿನೊ ಕ್ಹುದಾ ವ್ಹೈ,ಹಮೆಶಾನೊ ಜ಼ಲಮ ಥಯೊಸ.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />ಮಯಾನಾ ಬಚ್ಚಾ಼ವೊ, ಮುರ್ತಿಯೊನಾ ನಜಿಕ ಗಯಾವಾಚಿ ತಮನೊನೆ ವಚಾಳಿವೊ.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>