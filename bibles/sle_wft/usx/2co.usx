<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- Shikilagar</book>
  <para style="h">2 ಕೊರಿಂಥ</para>
  <para style="toc3">2 ಕೊರಿಂಥ</para>
  <para style="toc2">2 ಕೊರಿಂಥ</para>
  <para style="toc1">2 ಕೊರಿಂಥವಾಲಾವೊನೆ ಬರ್ದಲ ಬೆವಾ ಪತ್ರ</para>
  <para style="mt2">ಕೊರಿಂಥದವರಿಗೆ ಬರೆದ ಎರಡನೆಯ ಪತ್ರಿಕೆ</para>
  <para style="mt1">2 ಕೊರಿಂಥವಾಲಾವೊನೆ ಬರ್ದಲ ಬೆವಾ ಪತ್ರ</para>
  <para style="imt">ವಳಕ</para>
  <para style="ip">ಪೌಲಾ ವರಿ ಕ್ರೈಸ್ತೊನೆ ಘನ್ನು ವೈ ಮನಸ ಥಾತಾಮ ಎ ಪತ್ರ ಬರ್ದಲ ವ್ಹೈ. ಕೊರಿಂಥ ಸಭಾನಾ ಮನಕ್ಹೊಮಾ ದಕ್ಹಾ ಮನಕ್ಹೊ ಪೌಲಾನಿ ವರ್ತನೆನೆ ಘನ್ನಾ ಖಂಡನೆ ಕರ‍್ಯಾತಾ. ಪೌಲಾ ತೊ ತಿಪರ ಘಾಲಲ ದೊಶಾರೊಪಣೆ ವಿಚಾರ ಲೆಕ್ಕೊ ಕರ‍್ಯಾವಾಚಿ ಕೊರೆಂಥವಾಲಾವೊನಾ ಕ್ಹಾತೆ ಮಳಾನು ಮನಸೆ ಆಸ ಕರಸ. ತೆ ಥಾತಾಮಾ ತಿನಿ ಕ್ಹುಶಿ ದೆಕಾಡಿನ ದಿವಸ.</para>
  <para style="ip">ಪತ್ರನಾ ಶುರುಮಾ ಪೌಲಾ ಕೊರಿಂಥ ಸಭೆನಾ ಕ್ಹಾತೆ ತಿನು ಮಾಯಾನು ಸಂಭಂದ ದೆಕಾಡಿನೆ ದಿವಸ. ತ್ಯಾ ರ‍್ಹಯಲ ದಕ್ಹಾ ಕೆಟ್ಟ ಮನಕ್ಹೊ ವರಿ ಪ್ರತಿಭಟನಾಕ್ಹು ತೆ ಘನ್ನೊ ಘಟ್ಟ ಥೈನ ಚಾಲ್ಯೊ ಕೈನ ದೆಕಾಡಿನೆ ದಿವಸ. ಎ ಕಠಿನ ತನಾಕ್ಹು ಕೊರಿಂಥನಾ ಮನಕ್ಹೊನು ಮನಸಬದಲಿ ವರಿ ಶಾಂತಿ ವಪ್ಪಂದನನೆ ಕಾರಣ ಥಯು ಕೈನ ಕ್ಹುಶಿ ಥಾವಸ. ಜುದೆಯಮಾ ರ‍್ಹಯಲ ಕ್ರೈಸ್ತರೊನೆ ಜ಼ರುರತ ರ‍್ಹಯಲ ಪುರಾಕರಾನಾಹುತಿ ಮನಸೆ ಕಾಣಿಕೆ ದ್ಯು ಕೈನ ಪ್ರೊತ್ಸಾಹ ಕರಸ. ಕೊರಿಂಥಮಾ ದಕ್ಹಾ ಮನಕ್ಹೊ ತ್ಯುನಾಕ್ಹು ತ್ಯುನೆಜ಼ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊ ವ್ಹೈ ಕೈನ ಪೌಲಾನೆ ಕ್ಹುದಾನೊ ಮನಕ್ಹ ನ್ಹವೈ ಕೈನ ಪ್ರಚಾರ ಕರಾಡ್ಯಾತಾ. ತಿನಾಹುತಿ ಪೌಲಾ ಲಾಸ್ಟನಾ ಅದ್ಯಾಯೊಮಾ ಕವಸ.</para>
  <para style="iot">ಪಿಠಿಕೆ</para>
  <para style="io1">1. ಪೌಲಾ ತಿನಿ ಸೆವೆನಾ ಹುತಿ ಕದಲ <char style="ior"><ref loc="2CO 1:1-7:16">1:1—7:16</ref></char></para>
  <para style="io1">2. ಯೆರುಸೆಲಿಮಮಾ ರ‍್ಹಯಲ ಗರಿಬೊನೆ ರೊಕ್ಕಾ ಕುಡ್ಸಾನು <char style="ior"><ref loc="2CO 8:1-9:15">8:1—9:15</ref></char></para>
  <para style="io1">3. ಪೌಲಾ ತಿನೆ ರ‍್ಹಯಲ ಅದಿಕಾರ ಉಪಯೊಗ ಕರಿಲಿದಲ <char style="ior"><ref loc="2CO 10:1-13:10">10:1—13:10</ref></char></para>
  <para style="io1">4. ತ್ರೈಯಿಕ ಕ್ಹುದಾನೊ ಆಶಿರ್ವಾದ <char style="ior"><ref loc="2CO 13:11-14">13:11-14</ref></char></para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />ಕ್ಹುದಾನಿ ಚಿತ್ತ ನಿಂಗತ ಕ್ರಿಸ್ತ ಯೆಸುನೊ ಅಪೊಸ್ತಲ ಥಯಲ ಪೌಲಾ ವರಿ ಭೈ ಥಯಲ ತಿಮೊಥಿನಾ ಕ್ಹಾತೆ ಮಳಿನ</para>
  <para style="p" vid="2CO 1:1">ಕೊರಿಂಥಮಾ ರ‍್ಹಯಲ ಕ್ಹುದಾನಿ ಸಬೆವಾಲಾವೊನೆ ಅಖಾಯ ಸಿಮೆಮಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ ಎ ಪತ್ರ ಬರ್ದಾಡೊಸ.<verse eid="2CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2" />ಅಪ್ನೊ ಬಾ ಥಯಲ ಕ್ಹುದಾಕ್ಹು ವರಿ ಪ್ರಭು ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತಕ್ಹು ತುಮೊನೆ ಕೃಪಾ, ಶಾಂತಿ ಮಳಾದೆ.<verse eid="2CO 1:2" /></para>
  <para style="s1">ಪೌಲ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಕದಲ</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />ಅಪ್ನೊ ಕರ್ತಾ ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನೊ ಬಾ ಥಯಲ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರ. ತೆ ಮರಗಾಲೊ ಬಾ ವರಿ ಕ್ಹಾರಿ ತರಾಕ್ಹು ಕಾಳಜಿ ಕರಾಲೊ ಕ್ಹುದಾ ರ‍್ಹೈನ, <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />ಅಪೊನೆ ಆವಾನಾ ಕ್ಹಾರಾ ದುಕ್ಕೊಮಾಬಿ ಅಪೊನೆ ಸಂತೈಸಾಲೊ ವ್ಹೈ. ಅಪೆ ಕಿಮ್ಮ ದುಕ್ಕಮಾ ರ‍್ಹತಾಮಾ ಕ್ಹುದಾ ಅಪೊನೆ ಸಂತೈಸ್ಯೊ ತಿನಾ ನಿಂಗತ ಅಪೆ ಬಿಜಾ಼ವೊನೆ ಕರು. <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />ಕಾಕದ್ಯಾಮ ಕ್ರಿಸ್ತನಾಹುತಿ ಅಪೊನೆ ಕಿಮ್ಮ ತ್ರಾಸ ಹೆಚ್ಕಿ ಥಾತು ಆವಸ ತಿನಾ ನಿಂಗತ ಕ್ರಿಸ್ತಕ್ಹು ಹೆಚ್ಕಿ ಆದರಣೆ ಮಳಸ. <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />ಅಪೊನೆ ತ್ರಾಸ ರ‍್ಹಯಲಜ಼ ರ‍್ಹಯೊಮ ತೆ ತ್ರಾಸೊ ತುಮೊನೆ ಆದರಣೆ ಥೈನ ವರಿ ರಕ್ಷಣೆನಾಹುತಿ ಅಪೊನೆ ಆದರಣೆ ರ‍್ಹಯುಮ ತೆ ತುಮೊನೆ ಆದರಣೆನಾಹುತಿ ಅಪೊನೆ ರ‍್ಹಯಲ ತ್ರಾಸೊ ತುಮೆ ತಡ್ದಿಲಿನ ವಪ್ಪಿಲಿವಾನೆ ಎ ತುಮೊನೆ ಮದತ ಥಾವಸ. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />ತುಮಾರಿ ವಿಷಯಮಾ ಹಮೊನೆ ಘನ್ನಿ ನಿರಿಕ್ಷೆ ಛೆ. ತುಮೆ ಹಮಾರಾ ತ್ರಾಸೊಮಾ ಕ್ಹಾತೆ ಹಿಸ್ಸೊ ಲಿದಲಹುತಿ ಹಮೊನೆ ಆವಾನಿ ಆದರಣೆಮಾ ತುಮೆ ಹಿಸ್ಸೊ ಲಿವಾಲಾ ಥಾವೊಶಿ ಕೈನ ಹಮೊನೆ ಗ್ವತ್ತ ಛೆ.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />ಭಾಯೊ ಭೆನೊ, ಹಮೆ ಎಶ್ಯಾ ಸಿಮೆಮಾ ಖಾದಲ ಕಷ್ಟ ತ್ರಾಸ ತುಮೊನೆ ಗ್ವತ್ತ ರ‍್ಹೌ ಕೈನ ಆಸ ಕರಿಯೆಸ. ತ್ಯಾ ಹಮಾರಿ ತಡ್ದಿಲಿವಾನಿ ತಾಕತತಿಬಿ ಜಾಸ್ತಿ ತ್ರಾಸ ಅನುಭವಿಶಾ ತ್ಯಾ ಹಮೆ ತುಟಿ ಗಯಾ ಜಿವ್ತಾ ರ‍್ಹಯೆಸ ಕೈನ ಆಸ ಜ಼ವೈ ಲಿದ್ಯಾ. <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />ಮರಾನು ತೊ ಗ್ಯಾರಂಟಿ ವ್ಹೈ ಕೈನ ಲಾಗತಾ ಟೈಮಮಾ ಹಮೆ ಹಮೊಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲ್ಯಾ ಬಗರ ಮರೆಲವಾಲಾವೊನೆ ಜಿವ್ತೊ ಕರಾಲಾ ಕ್ಹುದಾಪರ ಬ್ಹರೊಕ್ಹೊ ಮ್ಹೆಲು ಕೈನ ಆಂ ಕ್ಹಾರು ಹಮಾರಾ ಕ್ಹಾತೆ ಥಯು. <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />ತೆ ಹಮೊನೆ ತೆಕ್ಲು ಖತರನಾಕ ಮೌತಕ್ಹು ವಚಾ಼ಡ್ಯೊ. ಅಗೊಬಿ ಕೆಳಾಮಾಬಿ ವಚಾ಼ಡಸ. <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />ತುಮೆ ಹಮಾರಾಹುತಿ ಪ್ರಾರ್ಥನಾ ಕರೊಶಿ ತಿನಾಹುತಿಬಿ ತೆ ಹಮೊನೆ ಆಗೊಬಿ ವಚಾ಼ಡಸ ಕೈನ ತಿಪರ ಆಸ ಮ್ಹೆಲ್ಯಾಸ. ಅಮ್ಮಜ಼ ಘನ್ನಾ ಜ಼ನಾವೊನಿ ಪ್ರಾರ್ಥನಾಕ್ಹು ಹಮೊನೆ ಥಾವಾನಾ ಉಪಕಾರನಾಹುತಿ ಘನ್ನಾ ಮನಕ್ಹೊಕ್ಹು ಕ್ಹುದಾನೆ ಕೃತಜ್ಞತಾ ಸ್ತುತಿ ಥಾವಸ.<verse eid="2CO 1:11" /></para>
  <para style="s1">ಪೌಲನಾ ಮಸ್ಲತಮಾ ಬದ್ಲಿ</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />ಹಮೆ ಕ್ಹಾಲಿ ಮನಕ್ಹೊನು ಗ್ಯಾನಕ್ಹು ಕಾಮ ಕರ‍್ಯಾ ಬಗರ ಕ್ಹುದಾನಿ ಕೃಪಾನೆ ಧರ್ಲಿನ ಪರಿಶುದ್ಧ ವರಿ ನಿಯತ್ತಕ್ಹು ರ‍್ಹೈನ ಆಂ ದುನಿಯಾಮಾ ಕ್ಹಾರಾವೊತಿಬಿ ಪೈಲಾ ತುಮಾರಿ ವಿಷಯಮಾ ಚಾ಼ಲಿನ ಗಯಾಸ ಕೈನ ಹಮಾರಿ ಮನಸ ಸಾಕ್ಷಿ ಕವಸ. ಆಂಜ಼ ಹಮೊನೆ ರ‍್ಹಯಲ ಘಮಂಡ ವ್ಹೈ. <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />ತುಮೆ ಹಮಾರಾ ಪತ್ರ ಒದಿನ ಕಳೈಲಿವಾನಾ ಸಂಗತಿಯೊಜ಼ ಹೊತ್ತಾ ವರಿ ಬಿಜು಼ ಸುಜ಼ ಹಮೆ ತುಮೊನೆ ಬರದ್ಯಾ ನತ್ತಿ. <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />ತುಮೆ ಹಮೊನೆ ಕ್ಹಾಲಿ ನಕ್ಕರ ಕಳಿಲಿದ್ಯಾಸ ಲಾಸ್ಟಲಕ್ಕಾಬಿ ಒಪ್ಪಿಲಿವೊಶಿ ಕೈನ, ಅಪ್ನೊ ಪ್ರಭು ಥಯಲ ಯೆಸು ಆವಾನಾ ದಿನ್ನೆ ತುಮೆ ಹಮಾರಿ ಘಮಂಡ ಕರಾನೆ ಕಾರಣ ಥಯಲನಿಂಗತ ಹಮೆಬಿ ತುಮಾರಾ ಘಮಂಡ ಕರಾನೆ ಕಾರಣ ಥಯೆಸ ಕೈನ ತುಮೆ ಒಪ್ಪಿಲಿವೊಶಿ.<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />ಮಿ ಆಂ ಕ್ಹಾರಾ ವಿಷಯಮಾ ಘನ್ನೊ ಬರೊಕ್ಹಾವಾಲೊ ವ್ಹತೊ. ತಿನಾಹುತಿ ಮಿ ತುಮೊನೆ ಮಳಾನೆ ವಿಚಾರ ಕರ‍್ಯೊತೊ. ತೆಳಾಮಾ ತುಮೊನೆ ಬೆಸಲಾ ಆಶಿರ್ವಾದ ಮಳತುತು. <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />ಪೈಲಾ ತುಮೊಕನ ಐನ ಪಾಚ಼ಲ್ತೊ ಮೆಕೆದೊನಿಯಾನೆ ಗೈನ ತೆ ಥಯಲ್ಪರ ಮೆಕೆದೊನಿಯಾತೊ ವರಿ ತುಮೊಕನ ಐನ ತುಮೆ ಮನೆ ಯುದಾಯನೆ ಜಾ಼ವಾನಾಹುತಿ ಮನೆ ಮದತ ಕರೊ ಕೈನ ಕವಾನಿ ವಿಚಾರ ವ್ಹತಿ. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />ಮಿ ಎ ವಿಚಾರ ಕರ್ತಾಮಾ ತುಮೊಕನ ಆವಾನು ಉದ್ದೆಶ ಕ್ಹರಿಮಾಜ಼ ಮನೆ ನ್ಹೊತು ಕೈನ ವಿಚಾರ ಕರೊಶಿ ಸು? ಮಿ ದುನಿಯಾವಾಲಾ ವಿಚಾರ ಕರಲನಿಂಗತ ವಿಚಾರ ಕರ‍್ಯೊಸ ಸು? ತ್ಯುನೆತೊ ವಿಚಾರ ಕರ್ತಾಮಾ ಯಕ್ಕೆಮ ಹುಂ ಯಕ್ಕೆಮ ನೈ ಕವಸ. <verse eid="2CO 1:17" /><verse number="18" style="v" sid="2CO 1:18" />ತುಮೆ ಕ್ಹುದಾಪರ ನೈ ಬರೊಕ್ಹೊ ಕರಾಲಾ ರ‍್ಹವತ್ತೊ. ಹಮೆ ತುಮೊನೆ ಯಕ್ಕಜ಼ ಟೈಮಮಾ ಹೊ ನೈತೊ ನೈ ಕವಾನು ತುಮೆ ನತ್ತಿ ಕದ್ಯಾ ಕವಾನು ಬರೊಕ್ಹೊ ಕರ್ತಾನ್ಹೊತಾ. <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />ಮಿ ವರಿ ಸಿಲ್ವಾನ, ತಿಮೊಥಿ ವರಿ ತುಮೊನೆ ಕ್ಹಾರವೊನೆ ಗ್ವತ್ತ ರ‍್ಹಯಲ ಕ್ಹುದಾನೊ ದಿಕ್ರೊ ಯೆಸು ಕ್ರಿಸ್ತ ಹಮ್ನಾ ಹುಂ ಕೈನ ಪಾಚಾ಼ತಾ ಫರಾಲೊ ನ್ಹವೈ. ಕೆಳಾಮಾಬಿ ಕ್ಹರಿನೆ ಕ್ಹರಿಜ಼ ವ್ಹೈ ಕೈನ ಕವಾಲೊ ವ್ಹೈ ತೆ ಕೆಳಾಬಿ ಯಕ್ಕ ಸೆಮ ರ‍್ಹವಾಲೊ ವ್ಹೈ. <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ಕರಲ ಪುರಾ ವಾಗ್ದಾನೊ ಕ್ರಿಸ್ತಮಾ ಕ್ಹರಿನಾ ವ್ಹೈ. ಅಪೊಕಂತಿ ಕಿಮ್ಮ ಕ್ಹುದಾನೆ ಮಹಿಮಾ ಥಾಯೆ ನಿಂಗತ ಹಮೆ ಕ್ರಿಸ್ತನಾ ಮೂಲಕ ಆಮೆನ್ ಕಯ್ಯೆಸ. <verse eid="2CO 1:20" /><verse number="21" style="v" sid="2CO 1:21" />ತುಮೊನೆ ವರಿ ಹಮೊನೆ ಕ್ರಿಸ್ತಮಾ ಘಟ್ಟ ಕರಾಲೊ ಕ್ಹುದಾಜ಼ ವ್ಹೈ. ಕ್ಹುದಾ ತಿನಾ ಖಾಸ ಆಶಿರ್ವಾದೊ ಅಪೊನೆ ದಿದ್ಯೊಸ. <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />ಅಪೆ ತಿನಾ ವ್ಹೈ ಕೈನ ದೆಕಾಡಾನೆ ತೆ ಅಪೊಪರ ಶಿಕ್ಕೊ ಘಾಲ್ಯೊಸ. ತೆ ತಿನಿ ಪವಿತ್ರ ಆತ್ಮಾ ಅಪ್ನಾ ಮನಸ್ಮಾ ಮ್ಹೆಲ್ಯೊಸ. ತೆ ಅಪೊನೆ ದಿದಲ ವಾಗ್ದಾನ ಪುರಾ ಕರಸ ಕವಾನೆ ಪವಿತ್ರ ಆತ್ಮಾಜ಼ ಅಪೊನೆ ಸಾಕ್ಷಿ ಥೈಸ.<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />ತುಮೊನೆ ಶಿಕ್ಷಾದಿವಾನ ರ‍್ಹೈನೆಕಾ ದುಖ ದಿವಾನು ರ‍್ಹೈನೆಕಾ ಮನೆ ಮನಸ ನ್ಹೊತು. ತಿನಾಹುತಿ ಮಿ ತುಮೊಕನ ವಾಪಸ ಫರಿನ ನತ್ತಿ ಆಯೊ. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />ತುಮಾರೊ ಬರೊಕ್ಹೊ ಹತೊಟಿಮಾ ಮ್ಹೆಲ್ಲಿವಾನಾ ಹುತಿ ಹಮೆ ಕೊಶಿಸ ಕರಾಡ್ಯಾಸ ಕೈನ ಮಿ ಕವಾಡ್ಯೊ ನತ್ತಿ.ತುಮೆ ಬರೊಕ್ಹಾಮಾ ಘಟ್ಟ ಛೆ. ತೆನೈಸೊ ಹಮೆ ತುಮಾರಿ ಖುಶಿನಾ ಹುತಿ ತುಮಾ ಕ್ಹಾತೆ ಕಾಮ ಕರಾಲಾ ಥಯಾಸ.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />ಬಿಜೆಕ್ಕೆಮ ತುಮೊಕನ ಐನ ತುಮೊನೆ ತ್ರಾಸಮಾ ಪಾಡು ನೈ ಕೈನ ಮಿ ಫೈಸಲೊ ಕರಲಿದ್ಯೊಸ. <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />ಮಿಜ಼ ತುಮೊನೆ ದುಖ ದಿದ್ಯೊಮ, ಮನೆ ಕುನ್ನ ಖುಶಿ ಕರಸ? ಮಾರಾಕ್ಹು ದುಖಮಾ ಪಡಲವಾಲಾ ತುಮೆ ನ್ಹವೈ ಸು? <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />ತಿನಾಹುತಿ ಮಿ ತೆ ಪತ್ರ ಬರ್ದ್ಯೊಸ; ಮನೆ ಖುಶಿ ಕರಾಲಾಜ಼ ಮನೆ ದುಖಮಾ ಪಾಡು ನೈ ಕೈನ ಮಿ ಆಯೊ ನೈ ಮಾರಿ ಖುಶಿಜ಼ ತುಮಾರಿ ಖುಶಿ ವ್ಹೈ ಕೈನ ಮಿ ತಿಳದಿಲಿದ್ಯೊಸ. <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />ಮಿ ತುಮೊನೆ ಘನ್ನೊ ತ್ರಾಸಕ್ಹು ವರಿ ಮನಸ ದುಕ್ಕ ಕರಿಲಿನ ವರಿ ರೊತೊಜ಼ ಬರದ್ಯೊಸ. ಮಾರು ಉದ್ದೆಶ ತುಮೊನೆ ದುಖ ಕರುಕೈನ ನ್ಹವೈ. ತೆನೈಸೊ ಮಿ ತುಮೊನೆ ಕೆಕ್ಲೊ ಮಯಾ ಕರೊಸ ಕೈನ ತಿಳ್ಸವಾನು ವ್ಹೈ.<verse eid="2CO 2:4" /></para>
  <para style="s1">ಅಪರಾದಿನೆ ಮಾಫಿ</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />ಮನಸೆ ದುಖ ಕರಾಲೊ ತುಮೊಮಾ ಯಕ್ಲೊ ರ‍್ಹೈತಬಿ ತೆ ಕ್ಹಾಲಿ ಮನೆ ಯಕ್ಕಜ಼ ದುಖ ನತ್ತಿ ಕರ‍್ಯೊ ತುಮಾರಾಮಾ ಘನ್ನಾಜ಼ನಾವೊನೆ ದುಖ ಕರ‍್ಯೊಸ. ತೆ ದುಖ ಕ್ಹಾರಾ ಜ಼ನಾವೊನೆ ಥಯುಸ ಕೈನ ಮಿ ಕತೊ ನೈ. <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />ಹವಾ ಮನಕ್ಹನೆ ತುಮಾರಾ ಘನ್ನಾ ಮನಕ್ಹೊಕ್ಹು ಮಳಲ ಶಿಕ್ಷಾ ಬಸ್ಸ. <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />ಹಮ್ನಾ ತುಮೆ ತಿನೆ ಶಿಕ್ಷಾ ದಿದ್ಯಾವಾಚಿ ತಿನೆ ಮಾಫಕರೊ, ತಿನೆ ಮಯಾ ಕರೊ. ನೈತೊ ತೆ ಘನ್ನೊ ದುಖಮಾ ಡುಬಿ ಜಾ಼ವಸ. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />ತಿನಾಹುತಿ ತಿನೆ ತುಮೆ ಮಯಾ ದೆಕಾಡು ಕೈನ ಮಾಂಗಿಲ್ಯುಸ. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />ಕ್ಹಾರಾ ವಿಷಯಮಾ ತುಮೆ ವಿಧೆಯ ಥಯಾಸು ನೈ ಕೈನ ತುಮಾರಿ ಚಾಳಿಯೊ ಪರಿಕ್ಷಾ ಕರ್ಲಿನ ತಿಳಿದಿಲ್ಯು ಕೈನ ತೆಜ಼ ಉದ್ದೆಶಕ್ಹು ಬರ್ದ್ಯೊಸ. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />ತುಮೆ ಕಿನೆ ಮಾಫ ಕರೊಶಿ ನೈ ತಿನೆ ಮಿಬಿ ಮಾಫ ಕರುಸ. ತುಮಾರಾಹುತಿಜ಼ ತಿನೆ ಕ್ರಿಸ್ತನಾ ಸನ್ನಿದಾನಮಾ ಮಾಫ ಕರ‍್ಯೊಸ. <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />ಸೈತಾನ ಅಪೊನೆ ಮೊಸ ಕರಿಪಾಡು ನೈ ಕೈನ ಅಮ ಕರ‍್ಯೊ. ತೆ ಸು ಕರಸ ತಿನಾ ವಿಚಾರೊ ಕಿಮ್ಮ ಶೆ ಕೈನ ಅಪೆತೊ ಚೊ಼ಕಿ ತರಾಜ಼ ತಿಳದಿಲಿದ್ಯಾಸ.<verse eid="2CO 2:11" /></para>
  <para style="s1">ತ್ರೊವಾನೆ ಪೌಲಾನಿ ಪ್ರಯಾಣ</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />ಕ್ಹುದಾ ಮಾರಾಹುತಿ ಬಾಕಲ ಕಾಡ್ಯೊಸ ಕೈನ ವಿಚಾರ ಕರಲಿನ ಕ್ರಿಸ್ತನಿ ಸುವಾರ್ತೆ ಕವಾನೆ ಮಿ ತ್ರೊವಾ ಕವಾನಾ ಗಾಮೆ ಆಯೊ. <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />ರ‍್ಹೈತುಬಿ ತ್ಯಾ ಮಾರೊ ಭೈ ತಿತ ನೈ ಮಳಲಕ್ಹು ಮನೆ ಸಮಾದಾನ ಥಯು ನೈ ತಿನಾಹುತಿ ತ್ಯಾ ರ‍್ಹಯಲ ಕ್ಹಾರಾವೊನೆ ಮಳಿನ ತ್ಯಾಂತೊ ಮೆಕೆದೊನ್ಯನೆ ಆಯೊ.<verse eid="2CO 2:13" /></para>
  <para style="s1">ಕ್ರಿಸ್ತ ಮುಲಕ ಜಯ</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಥಾವಾದೆ ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಕೆಳಾಮಾಬಿ ಅಪೊನೆ ಜಿತ್ತಾಡಾಲೊ ವ್ಹೈ. ಕ್ಹುದಾನಾ ಗ್ಯಾನನಿ ಚೊ಼ಕಿ ಬಾಸ ಕ್ಹಾರಿ ಜ಼ಗಾ ಫೈಲಾವಾನೆ ಅಪೊನೆ ಉಪಯೊಗ ಕರ‍್ಯೊಸ. <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />ರಕ್ಷಣೆನಿ ವಾಟಮಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ವರಿ ಹಾಳ ಥಾವಾನಿ ವಾಟಮಾ ರ‍್ಹಯಲ ಮನಕ್ಹೊನೆ ಕ್ಹುದಾಮಾ ಕ್ರಿಸ್ತನಿ ಬಾಸನಾ ಮನಕ್ಹೊ ಥಯಾಸ. <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />ಅಪೆ ಹಾಳ ಥಾವಾನಾ ವಾಟಮಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ತ್ಯುನೆ ಬಳಾನು ಆಗ ಥಯಾಸ; ರಕ್ಷಣೆನಾ ವಾಟ್ಮಾ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಜುವ ದಿವಾಲಾ ಸುಗಂದ ವ್ಹೈ. ಹವಾ ಕಾಮೊನೆ ಕುನ್ನ ಲಾಯಕ ವ್ಹೈ? <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />ಕೆಕ್ಲಾಕಿ ಮನಕ್ಹೊ ಕ್ಹುದಾನಿ ವಾಕ್ಯಾ ತಿಮಾ ಸು ಚಾ಼ಯೆ ತೆ ಘಾಲಿನ ವ್ಯಾಪಾರ ಕರಸ. ಹಮೆ ತೊ ತಿಮ್ಮ ನವೈ. ಕ್ಹುದಾಕಂತಾಜ಼ ಇನಿಲಿದಲವಾಲಾ ಥೈನ ಕ್ಹುದಾನಾ ಕ್ಹಾಮಾ ಕ್ರಿಸ್ತ ಯೆಸುನಾ ಅನ್ಯೊನ್ಯತೆಮಾ ಹಮೆ ಸು ಹೊತ್ತು ತೆಜ಼ ತುಮೊನೆ ಕದ್ಯಾಸ.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="s">ಕ್ಹುದಾನಿ ಸೆವೆನಾಹುತಿ ನಯಿ ವಾತ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />ಹಮೊನೆ ಹಮೆಜ಼ ಘನ್ನಾ ಚೊ಼ಕಾ ವ್ಹೈ ಕೈನ ಕೈಲಿವಾಡಾಸ ಸು? ನೈತೊ ಬಿಜಾ಼ವೊನೆ ದೆಕಾಡಾನಾಹುತಿ ಯೊಗ್ಯತಾ ಪತ್ರ ಹಮೊನೆ ಚಾ಼ಯೆ ಕೈನ ತುಮೊನೆ ಲಾಗಸ ಸು? ನೈತೊ ತೆ ಯೊಗ್ಯತಾ ಪತ್ರ ತುಮೊಕ್ಹು ಹಮೆ ಲ್ಯುಸು? <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />ಹಮೊನೆ ತುಮೆಜ಼ ತೆ ಯೊಗ್ಯತಾ ಪತ್ರ ವ್ಹೈ ತೆ ಪತ್ರ ಹಮಾರಾ ಮನಸೊಮಾ ಬರ್ದಲ ಛೆ ತೆ ಪತ್ರ ಕ್ಹಾರಾವೊನೆ ಗೊತ್ತ ಛೆ. ತೆ ಪತ್ರ ಕ್ಹಾರಾ ಒದಸ. <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />ತುಮೆಬಿ ತಿಮ್ಮಜ಼ ದೆಕಾಡೊಶಿ ಕಿಮ್ಮ ಕದ್ಯಾಮ ಕ್ರಿಸ್ತ ಹಮಾರಾ ಹತೆ ಬರ್ದಾಯಲ ನಿಂಗತಜ಼ ತುಮೆ ಹಮಾರಿ ಸೆವಾನು ಫಲ ವ್ಹೈ. ತೆ ಪತ್ರ ಕ್ಹಾಲಿ ಮಸಿಕ್ಹು ಲಿಕ್ಕಲ ನವೈ. ಜ಼ಲಮ ರ‍್ಹಯಲ ಕ್ಹುದಾನಿ ಆತ್ಮಾಕ್ಹುಜ಼ ಬರ್ದಲ ವ್ಹೈ. ದಗ್ಡಾನಾ ಹಲಗಿಪರ ನೈ ಮನಕ್ಹನಾ ಮನಸನಾ ಹಲಗಿಪರ ಬರ್ದಲ ವ್ಹೈ.<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />ಹಮೊನೆ ಹವೊ ಬರೊಕ್ಹೊ ಕ್ರಿಸ್ತನಾ ಮುಲಕಜ಼ ಕ್ಹುದಾಪರ ಛೆ. <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />ಹಮೊಕ್ಹುಜ಼ ಸುಬಿ ಥಯುಸ ಕವಾನೆ ಅಕ್ಲಾ ಹಮೆ ಲಾಯಕ ನತ್ತಿ. ಹಮೊನೆ ಯೊಗ್ಯತೆ ಆಯಲ ಕ್ಹುದಾಕ್ಹುಜ಼ ವ್ಹೈ. <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />ತೆ ನವು ವಡಂಬಡಿಕೆನಾ ಸೆವಕೊ ಥಾವಾನೆ ತಾಕತ ಹಮೊನೆ ದಿದ್ಯೊಸ. ಆಂ ನವು ವಡಂಬಡಿಕೆ ಲಿಖಿತ ರುಪನಾ ನಿಂಗತ ನತ್ತಿ ಕ್ಹುದಾನಿ ಆತ್ಮಾನೆ ಸಂಬಂದ ರ‍್ಹಯಲ ವ್ಹೈ. ಲಿಖಿತ ರುಪಮಾ ರ‍್ಹಯಲ ವಡಂಬಡಿಕೆ ಮೌತ ಲಾವಸ. ಕ್ಹುದಾನಿ ಆತ್ಮಾನೆ ಸಂಬಂದ ರ‍್ಹಯಲ ವಡಂಬಡಿಕೆ ಜ಼ಲಮ ದಿವಸ.<verse eid="2CO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />ದಗ್ಡಾಪರ ಬರ್ದಲ ಆಂ ಮೌತನೆ ಲಾವಾನು ಶಾಸನ ಘನ್ನು ಮಹಿಮಾಕ್ಹು ಭರಲ ವ್ಹತ್ತು. ತೆ ಮಹಿಮಾಕ್ಹು ಮೊಶೆನಾ ಮ್ಹೊಡಾಪರ ತೆ ಮಹಿಮಾ ವ್ಹತ್ತಿ. ತೆ ಮಹಿಮಾ ದಕ್ಹಾ ದಿನ ಥಯಲ್ಪರ ಗೈ ಪಡಾನಿ ರ‍್ಹೈತಬಿ ತೆ ಮಹಿಮಾಕ್ಹು ಮೊಶೆನು ಮ್ಹೊಡು ದೆಕಾನೆ ಇಸ್ರಾಯೆಲ ಮನಕ್ಹೊನೆ ಥಯು ನೈ. <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />ತೆಜ಼ ಮಹಿಮಾ ತೆಕ್ಲಿ ರ‍್ಹಯಾರೆ ಕ್ಹುದಾನಿ ಆತ್ಮಾನೆ ಸಂಬಂದ ರ‍್ಹಯಲ ಆಂ ಸೆವಾ ಹಜು಼ ಕೆಕ್ಲಿ ಮಹಿಮಾಕ್ಹು ಭರಲ ರ‍್ಹೌ? <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />ತಪ್ಪ ಕರಾಲಾನೆ ಫೈಸಲೊ ಕರಾನೆ ರ‍್ಹಯಲ ಸೆವಾಜ಼ ಮಹಿಮಾಕ್ಹು ಭರಲ ರ‍್ಹಯಾರೆ ಆಂ ನಿತಿನಿ ಸೆವಾ ಹಜು಼ನ ಕೆಕ್ಲಿಕಿ ಮಹಿಮಾಕ್ಹು ಭರಲ ರ‍್ಹೌ? <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />ಹಮ್ನಾ ಘನ್ನಿ ಮಹಿಮಾ ರ‍್ಹಯಲ ಸೆವಾ ಆಯಲಕ್ಹು ಪೈಲಾ ರ‍್ಹಯಲ ಸೆವಾನಿ ಮಹಿಮಾ ತಿನಾ ಕ್ಹಾಮಿ ಮಹಿಮಾ ನೈಸೊ ಥೈ. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />ಕ್ಹರಿಜಾ಼ವಾನಿ ಮಹಿಮಾಜ಼ ಅಕ್ಲಿ ಪ್ರಭಾವಕ್ಹು ಭರಲ ರ‍್ಹಯಾಮ ಹಮೆಶಾಬಿ ರ‍್ಹವಾನಿ ಮಹಿಮಾ ಹಜು಼ನ ಕೆಕ್ಲಿಕಿ ಜಾಸ್ತ ಪ್ರಭಾವಕ್ಹು ಭರಲ ರ‍್ಹೌ ನೈ?<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />ಹಮೊನೆ ಅಕ್ಲೊ ಬರೊಕ್ಹೊ ರ‍್ಹಯಲಕ್ಹುಜ಼ ಹಮೆ ಅಕ್ಲಾ ಧೈರ್ಯಕ್ಹು ಛೆ. <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />ಅಪೆ ಮೊಶೆನಿಂಗತ ನತ್ತಿ. ಕುಂದಿ ಜಾ಼ವಾನಿ ಮಹಿಮಾ ಅಂತ್ಯಥಾವಾನಾ ಇಸ್ರಾಯೆಲನಾ ಮನಕ್ಹೊ ದೆಕು ನೈ ಕೈನ ಮೊಶೆ ತಿನಾ ಮ್ಹೊಡಾನೆ ಘುಮುಸ ಘಾಲ್ಲಿದ್ಯೊ. <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />ತೆನೈಸೊ ತೆ ಮನಕ್ಹೊ ಗ್ಯಾನ ನೈಸೊವಾಲಾ ಥೈನ ತ್ಯುನೆ ಕಳೈಲಿದ್ಯಾ ನೈ. ತ್ಯುನೆ ಜುನ್ನು ವಡಂಬಡಿಕೆ ಒದತಾಮಾ ಹಜು಼ನಬಿ ತೆಜ಼ ಘುಮುಸಮಾ ಕಳಿಲಿವಸ. ತೆ ಘುಮುಸ ಕಾಡ್ಯಾ ನೈ. ಕಾಕದ್ಯಾಮ ತೆ ಘುಮುಸ ಕ್ರಿಸ್ತಕ್ಹುಜ಼ ಕಡಾವಸ. <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />ಹಜು಼ನಬಿ ಮೊಶೆನು ಧರ್ಮಶಾಸ್ತ್ರ ಒದತಾಮಾ ತ್ಯುನಾ ಮನಸೊಬಿ ಮಂಡ ರ‍್ಹವಸ. <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />ತ್ಯುನು ಮನಸ ಪ್ರಭು ಬಗಲ ಫರ್ತಾಮಾಜ಼ ತೆ ಘುಮುಸ ಝಾಕಲ ಖುಲ್ಲಾ ಥಾವಸ. <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />ತೆ ಪ್ರಭು ಕ್ಹುದಾನಿ ಆತ್ಮಾ ವ್ಹೈ. ಕಿಜಾ಼ ಪ್ರಭುನಿ ಆತ್ಮಾ ರ‍್ಹವಸ ತ್ಯಾ ಬಿಡುಗಡೆ ರ‍್ಹವಸ. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />ಅಪ್ನಾ ಮ್ಹೊಡಾ ಘುಮುಸಕ್ಹು ಝಕಾಯಾ ನತ್ತಿ. ಅಪೆ ಮ್ಹೊಡಾಪರ ಘುಮುಸ ನೈಸೊವಾಲಾ ಥಯಾಸ. ಪ್ರಭುನಿ ಮಹಿಮಾ ಅರಕ್ಹಾಮಾ ದಿಕ್ಹಾನಾ ಭೌಲಾನಿಂಗತ ಛೆ. ಪ್ರಭುಕ್ಹು ದಿಕ್ಹಾನಿ ಮಹಿಮಾ ಅಪೊನೆ ಘನ್ನಿ ಬದಲಾವಣೆ ಕರಿನ ತಿನಾ ನಿಂಗತಜ಼ ಕರಸ. ಎ ಕ್ಹಾರು ಕಾಮ ಕ್ಹುದಾನಿ ಆತ್ಮಾ ಥಯಲ ಪ್ರಭುನುಜ಼ ವ್ಹೈ.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s">ಆತ್ಮಿಕ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />ತಿನಾಹುತಿ ಕ್ಹುದಾ ತಿನಿ ಮರ್ಗಾಕ್ಹು ಎ ಸೆವಾ ದಿದ್ಯೊಸ. ತಿನಾಹುತಿ ಅಪೆ ಬುಚ಼ಕ್ತಾ ನೈ. <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />ಸರಮ ಆವಾನು ಕಾಮ ಝಾಕಿಲಿನ ಕರಾನಾ ಕಾಮೊ ಅಪೆ ಛೊಡಿನ ಅಪೆ ಕುತಂತ್ರ ಉಪಯೊಗ ಕರ್ತಾಜ಼ ನೈ. ಕ್ಹುದಾನು ಉಪದೆಶ ಬದಲಿ ಕರ್ತಾಜ಼ ನೈ. ಅಪೆ ಕ್ಹರಿ ರ‍್ಹಯಲಜ಼ ಕೈಯೆಸ. ಹಮೆ ಕುನ್ನ ವ್ಹೈ ಕವಾನು ಮನಕ್ಹೊನೆ ದೆಕಾಡಿನ ದಿಯೆಸ. ಇಮ್ಮ ಹಮೆ ಕ್ಹುದಾನಾ ಕ್ಹಾಮಾ ಕೆವಾ ಛೆ ಕವಾನು ತ್ಯುನಾ ಮನಸೊಮಾ ತಿಳದಿಲಿವಸ. <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />ಹಮೆ ಕವಾನಿ ಸುವಾರ್ತೆ ದಕ್ಹಾ ಮನಕ್ಹೊನೆ ದಡಿನ ವಸೆ ತೆ ಸುವಾರ್ತೆ ನಾಶಥಾವಾಲಾವೊನೆ ತೆ ದಡಿನ ಛೆ. <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />ಎ ದುನಿಯಾನೊ ಅದಿಪತಿ ಬರೊಕ್ಹೊ ನೈಸೊವಾಲಾವೊನೆ ತ್ಯುನಾ ಮನಸೊ ಕುಡ್ಡಾ ಕರ‍್ಯೊಸ. ಕ್ರಿಸ್ತನಿ ಮಹಿಮಾನಾಹುತಿ ರ‍್ಹಯಲ ಸುವಾರ್ತೆನು ಉಜಾಲು ತ್ಯುನೆ ದೆಕ್ತಾ ನೈ. ಕ್ರಿಸ್ತ ಯಕ್ಲೊಜ಼ ಕ್ಹುದಾನೊ ಪ್ರತಿರುಪ ಥಯೊಸ. <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />ಅಪೆ ಅಪ್ನಾಹುತಿ ಭೊದನೆ ಕರ್ತಾ ನೈ. ತೆನೈಸೊ ಯೆಸು ಕ್ರಿಸ್ತಜ಼ ವ್ಹೈ ಕೈನ ವರಿ ತಿನಾ ಸೆವಕೊ ವ್ಹೈ ಕೈನ ಭೊದನೆ ಕರಿಯೆಸ. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />ತಿನಾಹುತಿ ಅಂದಾರಾಮಾತು ಉಜಾಲು ಆವಸ ಕೈನ ಕ್ಹುದಾ ಯಕ್ಕ ದಿನ್ನ ಕದ್ಯೊ ಎಜ಼ ಕ್ಹುದಾ ಅಪ್ನಾಮಾ ತಿನು ಉಜಾಲು ಥಯೊಸ. ಕ್ರಿಸ್ತನಾ ಮ್ಹೊಡಾಪರ ರ‍್ಹಯಲ ಅಪೊನೆ ದೆಕಾಡಿನೆ ದಿವಾನಾ ಮುಲಕ ತೆ ಅಪೊನೆ ಉಜಾಲು ದಿದ್ಯೊಸ.<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />ಅಪೊನೆ ಎ ನಿಕ್ಷೆಪ ಕ್ಹುದಾಕ್ಹುಜ ಮಳ್ಯುಸ. ಅಪೆತೊ ನಿಕ್ಷೆಪ ಭರಲ ಗಾಡಗಿಯೊನಿಂಗತ ಛೆ. ಎ ಮ್ಹೊಟಿ ತಾಕತ ಆಯಲ ಕ್ಹುದಾಕಂತುಜ಼ ವ್ಹೈ ಕೈನ ದೆಕಾಡಿನೆ ದಿವಸ. ಅಪೊಕಂತು ನ್ಹವೈ. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />ಅಪ್ನಾ ಸುತ್ತೆ ಮುತ್ತೆ ಅಡ್ಚನ ಛೆ. ಹಾರ‍್ಯಾ ನತ್ತಿ. ಘನ್ನಿಸಲಾ ಸು ಕರು ಕೈನ ಅಪೊನೆ ಗ್ವತ್ತ ನತ್ತಿ ವರಿಬಿ ಅಪೆ ಭುಚ಼ಕ್ತಾ ನೈ. <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />ಅಪೆ ತ್ರಾಸಮಾ ಪಡ್ಯಾ. ಕ್ಹುದಾ ಅಪೊನೆ ಢಕಲ್ಯೊ ನೈ. ದಕ್ಹಿಯೆಳ ಅಪೊನೆ ತ್ರಾಸ ಥಯು. ವರಿಬಿ ಅಪೆ ನಾಶ ಥಯಾನೈ. <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />ಅಪ್ನಾ ಅಂಗಮಾ ಯೆಸುನೊ ಜ಼ಲಮ ದಿಕ್ಹು ಕೈನ ತೆ ಮರಣ ಅನುಭವಿಶ್ಯೊ. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />ಅಪೆ ಜಿವ್ತಾ ರ‍್ಹಯಾತುಬಿ ಯೆಸುನಾಹುತಿ ಹಮೆಶಾಬಿ ಮರಣನಿ ಅಪಾಯಮಾ ಛೆ. ಮರಿಜಾ಼ವಾನು ಅಪ್ನಾ ಅಂಗಮಾ ತಿನೊ ಜ಼ಲಮ ದಿಕ್ಹಾದೆ ಕೈನ ಎ ಅಪ್ನಾ ಕ್ಹಾತೆ ಥಯು. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />ತಿನಾಹುತಿ ಅಪ್ನೊಮಾ ಮರಣ ಕಾಮ ಕರಸ. ವರಿಬಿ ಜ಼ಲಮ ತುಮೊಮಾ ಕಾಮ ಕರಸ.<verse eid="2CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />ಮಿ ಬರೊಕ್ಹೊ ಕರಲಹುತಿಜ಼ ಬೊಲ್ಯೊಸ ಕೈನ ಪವಿತ್ರ ಗ್ರಂಥಮಾ ಬರ್ದಲ ಛೆ. ಅಪ್ನೊ ಬರೊಕ್ಹೊಬಿ ತಿನಾ ನಿಂಗತಜ಼ ಛೆ. ಅಪೆ ಬರಕ್ಹೊ ಕರಲಹುತಿಜ಼ ಬೊಲಿಯೆಸ. <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />ಪ್ರಭು ಥಯಲ ಯೆಸುನೆ ಮರಲವಾಲಾವೊಮಾತೊ ಉಟಾಡಲ ಕ್ಹುದಾ ಅಪೊನೆಬಿ ಕ್ರಿಸ್ತನಾ ಕ್ಹಾತೆ ಉಟಾಡಸ ಕವಾನು ಅಪೊನೆ ಗ್ವತ್ತ ಛೆ. ಕ್ಹುದಾ ಹಮೊನೆ ತುಮಾರಾ ಕ್ಹಾತೆಜ಼ ತಿನಾ ಕ್ಹಾಮೊ ಹುಬ್ರಾಡಸ. <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />ಎ ಕ್ಹಾರು ತುಮಾರಾಹುತಿಜ಼ ಇಮ್ಮ ಕ್ಹುದಾನಿ ಮರ್ಗಾ ಜಾಸ್ತಿ-ಜಾಸ್ತಿ ಮನಕ್ಹೊನೆ ಕ್ಹುದಾನೆ ಮಹಿಮಾ ಕರಸ.<verse eid="2CO 4:15" /></para>
  <para style="s1">ಬರೊಕ್ಹಾಮಾ ಜಿವ್ನಾ ಕರಾನು</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />ತಿನಾಹುತಿ ಅಪೆ ಬಲಹಿನ ಥೈನ ರ‍್ಹತಾನೈ. ಅಪ್ನು ಭಾರಲ್ಯು ಅಂಗನೆ ವೈಸ ಥಾವಸ ವರಿ ಬಲಹಿನ ಥಾವಸ ಅಪ್ನು ಅಂತರ್ಯ ದಿನ್ನೆ ದಿನ್ನೆ ನೌ ಥಾವಸ. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />ದಕ್ಹಾ ದಿನ್ನ ಅಪ್ನೊನೆ ಅಡ್ಚನ ರ‍್ಹವಸ. ವರಿಬಿ ಹಮೆಶಾನಿ ಮಹಿಮಾ ಹೊಂದಿಲಿವಾನೆ ತೆ ಅಪೊನೆ ಮದತ ಥಾವಸ. <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />ತಿನಾಹುತಿ ಅಪೊನೆ ದಿಕ್ಹಾನು ಕ್ಹಾರಾನಾಹುತಿ ವಿಚಾರ ಕರ್xಯಾವಾಚಿ ಅಪೊನೆ ನೈ ದಿಕ್ಹಾನಾವೊನಾ ಹುತಿ ವಿಚಾರ ಕರಿಯೆಸ. ವರಿ ಅಪೊನೆ ದಿಕ್ಹಾನು ಕ್ಹಾರುಜ಼ ದಕ್ಹಾ ದಿನ್ನ ರ‍್ಹವಸ ನೈಸೊ ದಿಕ್ಹಾನು ಹಮೆಶಾಬಿ ರ‍್ಹವಸ.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />ಜಿಮಿನಪರ ಅಪೆ ರ‍್ಹಯಲ ಗುಡಾರ ಕದ್ಯಾಮ ಅಪ್ನು ಅಂಗ ನಾಶ ಥಾವಸ ಕೈನ ಅಪೊನೆ ಗ್ವತ್ತ ಛೆ ತೆನೈಸೊ ತೆ ಥಾತಾಮಾ ಅಪೊನೆ ರ‍್ಹವಾನಾ ಹುತಿ ಕ್ಹುದಾ ಅಪೊನೆ ಯಕ್ಕ ಘರ ದಿವಸ. ತೆ ಮನಕ್ಹೊ ಭಾಂದಲ ಘರ ನ್ಹವೈ. ತೆ ಪರಲೊಕಮಾ ರ‍್ಹಯಲ ಹಮೆಶಾನು ಘರ ವ್ಹೈ. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />ಅಪೆ ಹಮ್ನಾ ಎ ಅಂಗಮಾ ಸುಸ್ತ ಥೈ ಗೈಯಾಸ. ಪರಲೊಕಮಾ ರ‍್ಹಯಲ ಅಪ್ನೊ ಘರ ಕ್ಹುದಾ ಅಪೊನೆ ಕೆಳಾಮಾ ದಿವಸ ಕೈನ ದೆಕಡ್ಯಾಸ. <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />ತೆ ಅಪೆ ಘಾಲ್ಲೆತಾಮಾ ಉಗಾಡಾ ರ‍್ಹತಾ ನೈ. <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />ಎ ಘರಮಾ ರ‍್ಹಯೆ ಲಕ್ಕಾ ಅಪೊನೆ ಯಕ್ಕ ವಜ್ಜು ಛೆ. ವರಿ ಅಪೆ ನೆಳ್ಳಿಯೆಸ. ಉಗಾಡಾ ರ‍್ಹವಾನು ಅಪೊನೆ ನೈ ಚೊ಼ಕು ರ‍್ಹಯಲ ಹುತಿ ಪರಲೊಕನು ಘರ ಘಾಲ್ಲಿವಾನೆ ಮನಸ ಕರಿಯೆಸ. ಮರಿ ಜಾ಼ವಾನು ಎ ಅಂಗ ಅಪ್ನಾ ಪುರಾ ಅಂಗನೆ ಔಳಗಿಲಿವಸ. <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />ಇನಾಹುತಿಜ಼ ಕ್ಹುದಾ ಅಪೊನೆ ತಯ್ಯಾರ ಕರ‍್ಯೊಸ. ಎ ಕ್ಹಾರು ಕ್ಹರಿಜ಼ ವ್ಹೈ ಕೈನ ದೆಕಾಡಾನಾ ಹುತಿ ಪವಿತ್ರ ಆತ್ಮಾ ಅಪೊನೆ ದಿದ್ಯೊಸ.<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />ತಿನಾ ಹುತಿಜ಼ ಅಪೆ ಹರ ಟೈಮ್ಮ ಧೈರೆಕ್ಹು ಛೆ. ಎ ಅಂಗಮಾ ಜಿವ್ತಾ ರ‍್ಹಯೆ ಲಕ್ಕಾ ಪ್ರಭುಕ್ಹು ದುರ ರ‍್ಹಯೆಸ ಕೈನ ಕವಾನು ಅಪೊನೆ ಗ್ವತ್ತ ಛೆ. <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />ಅಪೆ ಸು ದೆಕಾಡ್ಯಾಸ ತಿನಾ ಹುತಿ ಅಪೆ ಜಿವ್ತಾ ನತ್ತಿ. ವರಿಬಿ ಅಪೆ ಕಿಪರ ಬರೊಕ್ಹೊ ಮ್ಹೆಲ್ಯಾಸ ತಿನಾಹುತಿ ಜಿವ್ತಾ ಛೆ. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />ತಿನಾಹುತಿ ಅಪೆ ಧೈರ್ಯವಾಲಾ ಥೈನ ಎ ಅಂಗ ಛೊಡಿನ ಪ್ರಭುನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾನು ಕ್ಹರಿಮಾಜ಼ ಆಸ ಕರಿಯೆಸ. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />ಕ್ಹುದಾನೆ ಮೆಚ್ಚೆಸಾನು ಯಕ್ಕಜ಼ ಅಪ್ನು ಉದ್ದೆಶ ವ್ಹೈ. ಅಪೆ ಅಪ್ನಾ ಅಂಗಮಾ ನ್ಹ್ಯಾ ರ‍್ಹತಾಮಾಬಿ ಪ್ರಭುನಾ ಕ್ಹಾತೆ ತ್ಯಾ ರ‍್ಹವಾನೆ ತಿನೆ ಮೆಚ್ಚೆಸಾನು ಯಕ್ಕಜ಼ ಉದ್ದೆಶ ವ್ಹೈ. <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />ಅಪೆ ಕ್ಹಾರಾ ನ್ಯಾಯ ವಿಚಾರಣೆನಾ ಹುತಿ ಕ್ರಿಸ್ತನಾ ಕ್ಹಾಮಾ ಹುಬ್ರೌ. ಹರಿಯಕ್ಲೊ ದುನಿಯಾನಿ ಅಂಗಮಾ ರ‍್ಹತಾಮಾ ಕರಲ ಚೊ಼ಕಾನಾ ಹುತಿ ವರಿ ಕೆಟ್ಟನಾ ಹುತಿ ರ‍್ಹೈನೆಕಾ ತಿನೊ ಪ್ರತಿಫಲ ಹೊಂದಸ.<verse eid="2CO 5:10" /></para>
  <para style="s">ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ದೊಸ್ತಿ</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />ಪ್ರಭುನು ಭೆ ಸುವೈ ಕವಾನು ಅಪೊನೆ ಗ್ವತ್ತ ಛೆ. ತಿನಾಹುತಿ ಕ್ಹರಿನೆ ವಪ್ಪಿಲಿವಾನಾಹುತಿ ಮನಕ್ಹೊನೆ ಮದತ ಕರಾನೆ ಅಪೆ ಕೊಶಿಶ ಕರಿಯೆಸ. ಅಪೆ ಕೆವಾ ಛೆ ಕವಾನು ಕ್ಹುದಾನೆ ಗ್ವತ್ತ ಛೆ. ತುಮೆಬಿ ತುಮಾರಾ ಮನಸೊ ಕಿಮ್ಮ ಛೆ ಕವಾನು ವಳಕ್ಯಾಸ ಕೈನ ಬರೊಕ್ಹೊ ಛೆ. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />ಹಮೆ ತುಮಾರಾ ಕ್ಹಾಮಾ ವರಿ ಯಕ್ಕೆಬ ಸಾಬಿತ ಕರಾಡ್ಯಾನತ್ತಿ. ವರಿಬಿ ಹಮಾರಾ ಹುತಿ ತುಮೊಕನ ಕವಾಡ್ಯಾಸ. ತುಮೆ ಹಮಾರಿ ವಿಶಯಮಾ ಹಮ್ಮೆ ಕರಾನೆ ತುಮೊನೆ ಸಬುತ ದಿಯೆಸ. ತೆಳಾಮಾ ಡೊಳೆ ದಿಕ್ಹಾನಾ ಕಾಮೊನೆ ದೆಕಿನ ಹೆಮ್ಮೆ ಪಡಾನಾ ಮನಕ್ಹೊನೆ ದಿವಾನು ಸಬೊತ ಹಮೊಕನ ರ‍್ಹವಸ. ತೆ ಯಕ್ಕ ಮನಕ್ಹನು ಮನಸನಾ ಹುತಿ ಚಿಂತಾ ಕರ್ತೊ ನೈ. <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />ಹಮೆ ಪಿಸಾಳಾ ವಸೆತೊ ತೆ ಕ್ಹುದಾನಾ ಹುತಿ ವ್ಹೈ ವರಿ ಹಮೊಕನ ಚೊ಼ಕು ಗ್ಯಾನ ರ‍್ಹಯುಮ ತುಮಾರಾ ಹುತಿಜ಼ ವ್ಹೈ. <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />ಕ್ರಿಸ್ತನಿ ಮಯಾ ಹಮೊನೆ ವತ್ತಾಯಾ ಕರಸ. ಕಾ ಕದ್ಯಾಮ ಕ್ಹಾರಾ ಮನಕ್ಹೊನಾ ಹುತಿ ತೆ ಮರ್xಯೊಸ ಕೈನ ಅಪೊನೆ ಗ್ವತ್ತ ಛೆ. ತಿನಾಹುತಿ ಕ್ಹಾರಾ ಮರ್xಯಾ. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />ಜಿವ್ತಾ ರ‍್ಹವಾಲಾ ಇತ್ತಿ ಉಪ್ಪರ ತ್ಯುನಾಹುತಿ ಜಿವ್ನಾ ಕರು ನೈ ಕೈನ ಕ್ರಿಸ್ತ ಕ್ಹಾರಾ ಮನಕ್ಹೊನಾ ಹುತಿ ಮರ್xಯೊ. ತೆ ಮನಕ್ಹೊ ತಿನಾಹುತಿ ಜಿವ್ನಾ ಕರು ಕೈನ ತೆ ತ್ಯುನಾಹುತಿ ಮರ್ಯೊ ವೆ ಮರಲವಾಲಾವೊಮಾತೊ ಜಿವ್ತೊ ಥೈನ ಉಟ್ಯೊ.<verse eid="2CO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16" />ಇಮ್ಮ ರ‍್ಹಯಲಹುತಿ ಮನಕ್ಹೊನಾ ಅಂಗನಾಹುತಿ ವಿಚಾರ ಕರಾನು ಆಜ಼ತಾ ವಿಚಾರ ಕರ್ತಾ ನೈ. ದುನಿಯಾ ವಿಚಾರ ಕರಲಿಂಗತ ಪಾಚ಼ಲ್ಯಾ ಕಾಲಮಾ ಹಮೆ ಕ್ರಿಸ್ತನಾ ಹುತಿ ವಿಚಾರ ಕರ್ಯಾತಾ. ಹಮ್ನಾ ತಿಮ ಹಮೆ ವಿಚಾರ ಕರ್ತಾ ನೈ. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />ಕುನಬಿ ಕ್ರಿಸ್ತಮಾ ರ‍್ಹಯೊಮ ತೆ ನವೊ ಸೃಷ್ಠಿ ಥಯಾಸ. ಜುನ್ನಿಯೊ ಸಂಗತಿಯೊ ಗೈಪಡಿಯೊ. ಕ್ಹಾರುಜ ನವು ಥಯು. <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />ಎ ಕ್ಹಾರುಜ಼ ಕ್ಹುದಾಕ್ಹುಜ಼ ಥಯು. ಕ್ರಿಸ್ತನಾ ಮುಲಕ ಕ್ಹುದಾ ಅಪೊನೆ ತಿನಾಕ್ಹಾತೆ ಸಮಾಧಾನ ಕರ‍್ಯೊಸ. ವರಿ ಬಿಜಾ಼ವೊನೆಬಿ ಸಮಾಧಾನಮಾ ಬಲೈಲಾವಾನೆ ಕ್ಹುದಾ ತೆ ಕಾಮ ಅಪೊನೆ ದಿದ್ಯೊಸ. <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />ಕದ್ಯಾಮ ಕ್ಹುದಾ ಕ್ರಿಸ್ತಮಾ ಕ್ಹಾರಿ ಜಗತ್ನೆ ತಿನಾ ಕ್ಹಾತೆ ಸಮಾಧಾನ ಕರಿಲೆತೊತೊ. ಕ್ಹುದಾ ಕ್ರಿಸ್ತಮಾ ಮನಕ್ಹೊನು ಅಪರಾಧ ದೆಕಾಡತೊ ನೈ. ಎ ಸಮಾಧಾನನು ಸುದ್ದಿ ಮನಕ್ಹೊನೆ ಕೆ ಕೈನ. ಕಾಮ ಕ್ಹುದಾ ಅಪೊನೆ ದಿದ್ಯೊಸ.<verse eid="2CO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20" />ತಿನಾಹುತಿ ಕ್ರಿಸ್ತನಾ ಬಗಲ್ತಾ ಬೊಲಾನಾಹುತಿ ಮೊಕ್ಲಲ ಛೆ. ಎ ಕ್ಹುದಾ ಎ ಕ್ಹಾರು ಅಪ್ನಾ ಬಗಲ್ತೊ ಮನಕ್ಹೊನೆ ಬಲಾವಾನು ವ್ಹೈ. ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ತುಮೆ ಸಮಾಧಾನಮಾ ರ‍್ಹವೊ ಕೈನ ತೊಮೊಕನ ಮಾಂಗಿಲೆತಾಮಾ ಕ್ರಿಸ್ತನಾ ಬಗಲ್ತಾ ಬೊಲಾಲಾ ಥಯಾಸ. <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />ಕ್ರಿಸ್ತಮಾ ಪಾಪ ನ್ಹೊತು. ವರಿ ಅಪೆ ಕ್ಹುದಾನೆ ಸಮರ್ಪಕ ಥೈನ ನಿತಿವಾಲಾನಿಂಗತ ಕ್ಹುದಾ ತಿನೆ ಪಾಪನೊ ಸ್ವರುಪ ಕರ‍್ಯೊ.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />ಹಮೆ ಕ್ಹುದಾನಾ ಕ್ಹಾತೆ ಕಾಮ ಕರಾಲಾ ವ್ಹೈ. ಇನಾಹುತಿ ಹಮೆ ತುಮೊಕನ ಸು ಮಾಂಗಿಲಿಯೆಸ ಕದ್ಯಾಮ, ತುಮೆ ಕ್ಹುದಾಕಂತು ಹೊಂದಿಲಿದಲ ಕೃಪಾ ಉಪಯೊಗ ಥಾವಾ ವರಕ್ಹು ದೆಕಿಲಿವೊ. <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />ಪ್ರಸನ್ನತೆನಾ ಕಾಲಮಾ ತಾರಿ ಮರ್ಗಾ ಐಕ್ಯೊ, ರಕ್ಷಣೆನಾ ದಿನೊಮಾ ತುನೆ ಮದತ ಕರ್ಯೊಸ ಕೈನ ಕ್ಹುದಾ ಕವಾಡೊಸತೊ. ತೆ ಪ್ರಸನ್ನತೆನೊ ಕಾಲ; ಆಂಜ಼ ತೆ ರಕ್ಷಣೆನು ದಿನ ವ್ಹೈ.<verse eid="2CO 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3" />ಹಮಾರಿ ಸೆವೆ ಕಿನಾ ಕ್ಹಾಮಿಬಿ ಕೆಟ್ಟ ಥಾಯೆನೈಸೊ, ಹಮೆ ಕಿನೆಜ಼ ಅಡ್ಡಿ ಕರ‍್ಯಾ ನೈ. <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />ತಿನಾಹುತಿ, ಕ್ಹಾರಾ ವಿಶಯೊಮಾ ಕ್ಹುದಾನಾ ಸೆವಕೊ ವ್ಹೈ ಕೈನ ಹಮಾರಾ ಸೆವೆನೆ ಸಮ್ಮತ ಕರಲಿನ, ಹಮೆ ತ್ರಾಸಮಾಬಿ, ಸಂಕಟಮಾಬಿ, ಇಕ್ಕಟಮಾಬಿ, ಮಾರೊಮಾಬಿ, <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" />ಜೆಲಮಾ, ತ್ರಾಸೊಮಾ ಅನುಭವಸ್ಯಾಶ. ಅಂಗಭಾಬಿನ ಕಾಮ ಕರ್ಯಾಸ. ನಿಂದರ ನೈಸೊ ಭುಕ್ಕ ಲಾಗಿನ ತಡಪ್ಯಾಸ; ಎ ಕ್ಹಾರಾ ವಿಶಯೊಮಾ ಘನು ಸಮಾದಾನ ದೆಕಾಡ್ಯಾಸ. <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />ಚೊಕು ಮನಸ, ಗ್ಯಾನ, ಶಾಂತಿ, ದಯಾ ಪವಿತ್ರ ಆತ್ಮಾಮಾ ಕಪಟ ನೈಸೊ ಮಯಾ, <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />ಕ್ಹರಿನಿ ವಾಕ್ಯಾ, ಕ್ಹುದಾನಿ ಮಹಿಮಾ ಇಮಾ ರ‍್ಹಯಲವಾಲಾ ಥೈನ, ಹತೊಮಾ ನಿತಿ ಕವಾನಾ ಆಯುದೊ ಧರಿಲಿದ್ಯಾಸ. <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />ಅಪೆ ಮಾನ ವರಿ ಅವಮಾನ, ಕಿರ್ತಿ ವರಿ ಅಪಕಿರ್ತಿಮಾ ಸೆವಾ ಕರ್ಯಾಸ. ಕ್ಹರಿವಾಲಾ ರ‍್ಹಯತಬಿ ಮೊಸ ಕರಾಲಾ ವ್ಹೈ ಕೈನ ಐಕೈ ಲಿದ್ಯಾಸ. <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />ಅಪೆ ಸಿದ್ದ ರ‍್ಹೈತಬಿ ವಳಕ ನೈಸೊವಾಲಾ ಥೈನ ಸೆವಾ ಕರ‍್ಯಾಸ. ಮರಾಲಾ ವ್ಹೈ ಕೈನ ದೆಕಾಡ್ಯಾ ತಬಿ ಜ್ಯುತಾ ಸೆ! ದೆಕಿ ಶಿಕ್ಷಾ ಗುರಿ ಥೈತಬಿ ಮರಾಲಾ ಥಯಾಸ, <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />ದುಖಪಡ್ದಾಲಾ ರ‍್ಹೈತಬಿ ಸೆವಾಮಾ ಕೆಳಾಮಾಬಿ ಕ್ಹುಶ ರ‍್ಹಯೆಸ, ಗರಿಬ ರ‍್ಹೈತಬಿ ಘನಾಜನಾವೊನೆ ಸೌಕಾರವಾಲಾ ಕರ‍್ಯಾಸ; ಸುಬಿ ನೈಸೊವಾಲಾ ರ‍್ಹೈತಬಿ ಕ್ಹಾರುಜ಼ ವ್ಹಂದಲವಾಲಾ ಥಯಾಸ.<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />ಕೊರಿಂಥಮಾ ರ‍್ಹಯಲವಾಲಾ ಕ್ಹುಲಾ ಮನಸಕ್ಹು ಖುಲ್ಲಾ ಮನಸಕ್ಹು ಹಮೆ ತುಮಾರಾ ಕ್ಹಾತೆ ಬೊಲ್ಯಾಸ. <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />ಹಮಾರಾಮಾ ಕೆಟ್ಟ ಭಾವಾನಾ ನತ್ತಿ. ಎ ರ‍್ಹವಾನು ತುಮಾರಾಜ಼ ವ್ಹೈ. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />ತಿನಾಹುತಿ ಬಚ್ಚಾವೊನೆ ಕದಲ ತಿಮ್ಮ ಕದ್ಯಾಸ; ಹಮೆ ಪೂರಾಮನಸಕ್ಹು ಮಯಾ ಕರಲ ನಿಂಗತ, ತುಮೆಬಿ ಹಮೊನೆ ಪೂರಾ ಮನಕ್ಹು ಮಯಾ ಕರೊ.<verse eid="2CO 6:13" /></para>
  <para style="s">ಕ್ರೈಸ್ತರೊ ಅನ್ಯ ಮನಕ್ಹೊನಾ ಅನ್ಯುನತೆ ಕೆಟ್ಟು ನೈ</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />ತುಮೆ ಕ್ರಿಸ್ತಪರ ಬರೊಕ್ಹೊ ನೈಸೊವಾಲಾವೊನಾ ಕ್ಹಾತೆ ಮಳಿನ ಇಜ್ಜೊಡ ಥಾವೊ ನಕೊ. ಧರ್ಮನೆ ವರಿ ಅಧರ್ಮನೆ ಮದತ ಸುವೈ? <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />ಉಜಾ಼ಲಾನೆ ವರಿ ಅಮದಾರಾನೆ ಅನ್ಯುನತೆ ಸುವೈ? ಕ್ರಿಸ್ತನೆಬಿ ವರಿ ಸೈತಾನೆ ಒಪ್ಪಂದ ಸುವೈ? ವಿಶ್ವಾಶಿನೆ ಅವಿಶ್ವಾಸಿನೆ ಪಾಲ ಸುವೈ? <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />ಕ್ಹುದಾನಿ ಸಭೆನೆ ವಿಗ್ರಹೊನೆ ಒಪ್ಪಿಗೆ ಸುವೈ? ಅಪೆ ಕ್ಹುದಾ ಕದಲ ನಿಂಗತ ಜಿವ ಸ್ವರೂಪ ಥಯಲ ಕ್ಹುದಾನಾ ಸಭೆ ಥಯಾಸತೊ, ಮಾರಾ ಮನಕ್ಹೊಮಾಜ಼ ಮಿ ಘರ ಕರುಸ, ತ್ಯುನಾ ವಚ್ಮಾಜ಼ ಮಿ ಫರುಸ ತ್ಯುನೊನೆ ಮಿಜ಼ ಕ್ಹುದಾ ಥಯಲ ರ‍್ಹೌಸ, ತ್ಯುನೆ ಮನೆ ಪ್ರಜೆ ಥಾವಸ ಕೈನ ಕದ್ಯೊಸ. <verse eid="2CO 6:16" /><verse number="17" style="v" sid="2CO 6:17" />ತಿನಾಹುತಿ ಅನ್ಯ ಮನಕ್ಹೊನೆ ಛೊಡಿನ ಭಾರಾ ಆವೊ ತ್ಯುನಾಕ್ಹು ಬಿಜಾ಼ ಥೈನ ಜಿವ್ನಾ ಕರೊ ಕೆಟ್ಟ ರ‍್ಹಯಲನೆ ಮುಟ್ಯೊ ನಕೊ ಕೈನ ಕರ್ತಾ ಕದ್ಯೊಸ. <verse eid="2CO 6:17" /><verse number="18" style="v" sid="2CO 6:18" />ತೆನೈಸೊ ಮಿ ತುಮೊನೆ ಸ್ವಿಕಾರ ಕರಲಿನ ತುಮೊನೆ ಬಾ ಥೈನ ರ‍್ಹೌಸ; ತುಮೆ ಮನೆ ರಾಜಾ಼ ರಾಣಿಯೊ ಥಾವೊಸಿ ಕೈನ ಸರ್ವಶಕ್ತ ಥಯಲ ಕರ್ತಾ ಕವಸ.<verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />ಮಯಾನಾ ಭಾಯೊ ಭೆನೊ, ಎ ವಾಗ್ದಾನೊ ಅಪೊನೆ ರ‍್ಹಯಲಕ್ಹು, ಅಪೆ ಅಂಗನಿ ಆತ್ಮಾನೆ ಶುದ್ದ ಕರಲಿನ ಅಪೊನೆ ಸ್ವಚ್ಚ ಕರಲಿನ ಕ್ಹುದಾನಾ ಭೆಂಕ್ಹು ಭರಲವಾಲಾ ಥೈನ ಪವಿತ್ರಾತಾಮಾ ರ‍್ಹವಾನಿ ಕೊಶಿಶ ಕರಿಯೆ.<verse eid="2CO 7:1" /></para>
  <para style="s">ಪೌಲಾ ತೆಜ಼ ಪೈಲಾ ಲಿಕ್ಕಲ ಬುಕ್ಕಕ್ಹು ಚೊ಼ಕು ಫಲ ಥಯು ಕೈನ ಖುಶಿ ಥಯಲ</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />ತುಮಾರಾ ಮನಸೊಮಾ ಹಮೊನೆ ಜ಼ಗಾ ದಿವೊ. ತುಮೊಮಾ ಕಿನೆಜ಼ ಅನ್ಯಾಯ ಕರ್ಯಾ ನೈ. ಕಿನೆಜ಼ ತ್ರಾಸ ಕರ್ಯಾ ನೈ. ಕಿನೆಜ಼ ಮೊಸ ಕರ್ಯಾ ನೈ. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />ತುಮಾರಾ ಉಪ್ಪರ ಘಾಲು ಕೈನ ಹಮೆ ಎ ಕವಾಡಾ ನತ್ತಿ; ತುಮಾರಾ ಕ್ಹಾತೆ ಮರ್ಯಾರೆ, ಜ್ಯುತಾ ರ‍್ಹೈತಬಿ ಕವಾ ನಿಂಗತ ತುಮೆ ಹಮಾರಾ ಮನಸೊಮಾ ಛೆ ಕೈನ ಮಿ ಪೈಲಾಜ಼ ಕದ್ಯೊತೊ. <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />ತುಮಾರಾಮಾ ಮನೆ ಘನೊ ಭರೊಕ್ಹೊ ಛೆ, ಘಟ್ಟ ರ‍್ಹಯಲ ಅಬಿಮಾನ ಛೆ. ಮಿ ಕ್ಹಾರಾ ತ್ರಾಸೊಮಾ ತುಟಲ ಮನಸಕ್ಹು ಕ್ಹುಶಿ ಕರಾಲೊ ಥಯೊಸ. <verse eid="2CO 7:4" /><verse number="5" style="v" sid="2CO 7:5" />ಅಪೆ ಮೆಕೆದೊನಿಯೆ ಆಯಲ್ಪರ ಹಮಾರಾ ಅಂಗೊನೆ ನೆಮ್ಮದಿ ನತ್ತಿ. ತೆನೈಸೊ ಕ್ಹಾರಾ ವಿಶಯೊಮಾ ಹಮೊನೆ ತ್ರಾಸೊ ವ್ಹತ್ತಾ. ಭಾರಾ ಲಡೆ, ಮ್ಹೈಂ ಭೆಂ <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />ತೆನೈಸೊ ದಿನಾ ವಸ್ಥೆಮಾ ರ‍್ಹವಾಲಾವೊನೆ ಸ್ಹೆಂ ಕರಾಲೊ ಕ್ಹುದಾ ತಿತಾನೆ ವಳಾವಾನಾ ಮೂಲಕ ಹಮೊನೆ ಸ್ಹೆಂ ಕರ‍್ಯೊ. <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />ತಿನಾ ಲಿಕಾವಟಕ್ಹು ತುಮಾರಾಕ್ಹು ಘನು ಸಮಾದಾನ ಹೊಂದ್ಯೊಸ ಕೈನ, ತುಮಾರಿ ಚೊ಼ಕಿ ಮಯಾ, ತುಮಾರು ದುಕ್ಕ, ಮಾರಾಪರ ರ‍್ಹವಾನಿ ತುಮಾರಿ ಕಾಳಜಿ; ಎ ಕ್ಹಾರು ಹಮೊನೆ ಕತಾಮಾ ಮಿ ಹಜಿ ಘನೊ ಕ್ಹುಶಿ ಥಯೊ. <verse eid="2CO 7:7" /><verse number="8" style="v" sid="2CO 7:8" />ಮಿ ಲಿಕ್ಕಲ ಪತ್ರಕ್ಹು ತುಮೊನೆ ದುಕ್ಕ ಥೈತಬಿ ಮನೆ ಸುಜ಼ ಕೆಟ್ಟ ನತ್ತಿ. ತೆ ತುಮೊನೆ ದಕ್ಹೊ ಟೈಮ ದುಕ ಕರ‍್ಯುಸ ಕೈನ ಮಿ ಪೈಲಾಜ ಪಶ್ಚಾತಾಪ ಪಡಿತಬಿ ಹಮ್ನಾ ಕ್ಹುಶಿ ಥವುಸ. <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />ತುಮೊನೆ ತ್ರಾಸ ಥಯು ಕೈನ ಮಿ ಹಮ್ನಾ ಕ್ಹುಶಿ ಥಯೆವಾಚಿ ತುಮೆ ದುಕಿ ಥೈನ ಪಶ್ಚಾತಾಪ ಪಡ್ದಿನ ಮಾನಸಾಂತರ ಹೊಂದಾನಾಹುತಿ ಕ್ಹುಶಿ ಥವುಸ. ತುಮೆ ಕ್ಹುದಾನಾ ಚಿತ್ತನಾಹುತಿ ದುಕಿ ಥಯಲಕ್ಹು ಹಮಾರಾಕ್ಹು ಕಿಮಾಜ಼ ತುಮೊನೆ ಕೆಟ್ಟ ಥಯು ನೈ. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />ಕ್ಹುದಾನಿ ಚಿತ್ತನಾಹುತಿ ದುಕ್ಕ ರಕ್ಷಣೆ ದೆಕ್ತಾಮಾ ತ್ರಾಸನೆ ಶುರು ಕರಸ, ತೆ ತ್ರಾಸಮಾ ಪಶ್ಚಾತಾಪನೆ ಆಸ್ಪದ ನತ್ತಿ; ತೆನೈಸೊ ಲೊಕಮಾ ರ‍್ಹವಾನು ದುಕ್ಕಮೌತ ಆವಾಲಗಾಡಸ. <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />ತುಮೆ ಕ್ಹುದಾನಿ ಚಿತ್ತನಾಹುತಿ ಕ್ಹಾದಲ ದುಕ್ಕ ತುಮಾರಾಮಾ ಕೆಕ್ಲು ಹಂಬಲ, ತಪ್ಪ ರ‍್ಹಯಲವಾಲಾವೊನೆ ಶಿಕ್ಷಾ ದಿವಾನೆ ಕಸ್ಟ ಪಡದಿನ ತುಮೆ ನಿರ್ದೊಸಿಯೊ ವ್ಹೈ ಕೈನ ಕವಾನಾಹುತಿ ಕೆಕ್ಲಿಕಿ ಮ್ಹೈನತ ಕರ‍್ಯಾಸ, ಕೆಕ್ಲೊ ಮನೊವ್ಯಥೆನೆ ಅನುಭವಿಸ್ಯಾಸ; ಕೆವು ಬುಚಕ ದೆಕ್ಲಾಡ್ಯಾಸ; ಮನಕ್ಹನಾ ತ್ರಾಸನಾಹುತಿ ಕೆಕ್ಲಿಕಿ ಶಿಟ್ಟ ಕರಿನ ಶಿಕ್ಷಾ ಕರ‍್ಯಾಸ ಎ ಕ್ಹಾರು ಅದೃಶ ಥೈ ಗಯಾಸ. <verse eid="2CO 7:11" /><verse number="12" style="v" sid="2CO 7:12" />ಮಿ ತುಮೊನೆ ಬರ್ದಲ ತಪ್ಪ ಕರಲವಾಲಾನೆ ಶಿಕ್ಷಾ ಥವು ಕೈನ ನವೈ, ತೆ ತಪ್ಪಕ್ಹು ಪಿಡಿತನೆ ನ್ಯಾಯಾ ಮಳುಕೈನ ನವೈ; ಹಮಾರಾಹುತಿ ತುಮೊನೆ ರ‍್ಹವಾನು ಅಕ್ಕರೆ, ಆಸ್ತಿಯೊ ಕ್ಹುದಾನಿ ಸನ್ನಿದಿಮಾ ತುಮೊನೆ ದಿಕ್ಹು ಕೈನ ಬರ್ದ್ಯೊಸ. ತಿನಾಹುತಿ ಹಮಾರಾ ಮನಸೆ ಶಾಂತಿ ಥಯಿಸ. <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />ತೆಕ್ಲು ನೈ, ತುಮೆ ಕ್ಹಾರಾ ತಿತಾನಾ ಮನಸನೆ ಶಾಂತ ಕರಲಕ್ಹು ತಿನಿ ಕ್ಹುಶಿ ದೆಕಿನ ಹಮೆ ಬಿದ್ದಕ್ಹಾ ತೃಪ್ತ ಥಯಾ.. <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />ಕಾಕದ್ಯಾಮ ಮಿ ತಿತಾನಾ ಕ್ಹಾಮೊ ತುಮಾರಾಹುತಿ ಚೊ಼ಕು ಕದ್ಯೊಸ ಕರಿಜ಼ ; ತಿಮ್ಮಜ ಚೊ಼ಕು ಕದಲಕ್ಹು ಮಿ ಸರಮಾತೊ ನೈ. ತಿನಾಹುತಿ ಮಿ ತುಮೊನೆ ಕದಲ ಕ್ಹಾರಾ ವಾತೊ ಕಿಮ್ಮ ಕ್ಹರಿ ವ್ಹತ್ತಾತೊ ತಿಮ್ಮಜ಼ ಅಪೆ ತಿತಾನಾ ಕ್ಹಾಮಾ ಕದಲ ಚೊ಼ಕಾ ವಾತೊ ಕ್ಹಾರಾ ಕ್ಹರಿ ವ್ಹೈ ಕೈನ ದಿಕ್ಹಿನ ಆಯಾ. <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />ತುಮೆ ವಿದೆಯತೆಮಾ ಭಯ ಭಕ್ತಿಕ್ಹು ತಿನಾ ಸ್ವಿಕಾರ ಕರಲಿದಲ ಸ್ಹೆಂ ಕರಲೆತಾಮಾ ತುಮಾರಾಪರ ತಿನೆ ರ‍್ಹವಾನಿ ಮಯಾ ಹೆಚ್ಚ ಥೈಸ. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />ತುಮಾರಾಪರ ಮನೆ ತರಿಕಾಮಾ ಪೂರಾ ಭರೊಕ್ಹೊ ರ‍್ಹಯಲಕ್ಹು ಮಿ ಕ್ಹುಶಿ ಥವುಸ.<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s">ಯರುಸಲೆನಾ ಗರಿಬ ಕ್ರೈಸ್ತರೊನಾಹುತಿ ದೊಕ್ಡಾನಿ ಮದತ ಕರಾನಾ ವಿಶಯ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />ಮಯಾನಾ ಭಾಯೊ ಭೆನೊ ಮೆಕೆದೊನನಾ ಸಭೆವೊನೆ ದಿದಲ ಕ್ಹುದಾನಾ ಕೃಪೆನಾಹುತಿ ತುಮೊನೆ ಕಳುಕೈನ ಆಸ ಕರಿಯೆಸ, <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />ತೆ ಸಭೆಕನ ಘನಾ ಕಸ್ಟೊ ಐತಬಿ ಅಪ್ನಾ ವಿಪರಿತ ಥಯಲ ಗರಿಬಿಮಾ ಘನಾ ಕ್ಹುಶಿಕ್ಹು ಭರಲವಾಲಾ ಥೈನ ಉದ್ದಾರ ಥಯಿ ಗಯಾ. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />ತ್ಯುನೆ ತ್ಯುನಾ ತಾಕತಕ್ಹುಜ಼ ತಾಕತನೆ ಮಿರಿನ ತ್ಯುನಾ ಪಸಂದನೆ ತ್ಯುನೆಜ ಉದ್ದಾರ ಥೈನ ದಾನ ಕರ‍್ಯಾ. <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />ಇನೆ ಹಮೆಜ಼ ಸಾಕ್ಷಿ ವ್ಹೈ. ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನೆ ಮದತ ಕರಾನಾ ಕಾಮಮಾ ತ್ಯುನೆ ಪಾಲಗಾರ ಥಾವಾನೆ ಅನುಮತಿ ಥವು ಕೈನ ಹಮೊನೆ ಘನಾ ಮಾಂಗಿಲಿದ್ಯಾ. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />ಹಮೆ ಇನೆ ಇನ್ಕಾರ ಕರಲ ರಿತಿಮಾ ತ್ಯುನೆ ದಿದೆವಾಚಿ, ಪೈಲಾ ತ್ಯುನೊನೆ ಕರ್ತಾಕನ ಒಪ್ಸನ ದಿದ್ಯಾ; ತೆ ಥಯಲ್ಪರ ಕ್ಹುದಾನಾ ಚಿತ್ತನಾಹುತಿ ಹಮೊನೆ ವರಿ ತ್ಯುನೊನೆ ಒಪ್ಸಾಯಾ. <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />ತಿತಾ ಶುರು ಕರಲ ತಿಮ್ಮ ಧರ್ಮನಾ ಕಾಮೊನೆ ಪೂರಾ ಕರು ಕೈನ ಹಮೆ ತಿನೆ ಪುಚ್ಯಾಸ. <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />ತುಮೆ ಕ್ಹುದಾಪರ ಮ್ಹೆಲಲ ಭರೊಕ್ಹಾಮಾ, ಗ್ಯಾನಮಾ, ಘನಾ ಬಿಜಾ಼ ಥಯಲ ಆಸಕ್ತಿಮಾ ವರಿ ಹಮಾರಿ ಮಯಾಕ್ಹು ತುಮೊಮಾ ಹುಟ್ಟಲ ಮಯಾಮಾ ಕಿಮ್ಮ ಸಮೃದ ಥೈನ ವ್ಹತ್ತಾತೊ ತಿಮ್ಮಜ಼ ಎ ಧರ್ಮನಾ ಕಾಮೊಮಾ ಸಮೃದ್ದ ಥೈನ ಅಗಾ ಬಡೊ. <verse eid="2CO 8:7" /><verse number="8" style="v" sid="2CO 8:8" />ಎ ಕ್ಹಾರು ಆಗನ್ಯಾ ರೂಪಮಾ ಕವಾಡಾ ನತ್ತಿ ತೆನೈಸೊ ಬಿಜಾ಼ ಆಸಕ್ತಿನಾ ಹೊಲಸಿನ ತುಮಾರಿ ಮಯಾ ಕೆಕ್ಲಿ ಯಥಾರ್ಥ ವ್ಹಯ ಕೈನ ಸಾಬಿತ ಕರುಕೈನ ಕೌಸ. <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />ಹಮಾರೊ ಕರ್ತಾ ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತನಿ ಕೃಪಾ ತುಮೊನೆ ಗೊತ್ತ ಥಾತಿ ನೈ; ತೆ ಸೌಕಾರ ರ‍್ಹೈತಬಿ ತಿನಾ ಗರಿನಾ ಮುಕಾಂತರ ತುಮೆ ಸೌಕಾರ ಥೌಕೈನ ತುಮಾರಾಹುತಿ ತೆ ಗರಿಬ ಥಯೊ. <verse eid="2CO 8:9" /><verse number="10" style="v" sid="2CO 8:10" />ಎ ಧರ್ಮಾನಾ ಕಾಮೊನಾಹುತಿ ಮಾರಿ ಸಲಹಾ ಕೌಸ, ಎ ತುಮಾರಾ ಮದತನೆ, ಎ ಕಾಮನೆ ಯಕ್ಕ ವರಕ್ಹನಾ ಪಾಚಾ಼ ಕರಾನಾಹುತಿ ತುಮೆ ಮನಸ ಕರಲ ಯೊಗ್ಯ ದಿಕ್ಹ್ಯುಸ. ಅಗು ಜಾವಾನೆ ಮನಸ ಕರಲ ತಿಮ್ಮಜ಼ ತಿನೆ ಕಾಮನಾ ರೂಪನೆ ಲಾವಾನೆ ಕೊಶಿಶ ಕರೊ. <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />ಎ ಕಾಮನೆ ಶುರು ಕರಾನೆ ತುಮೊಮಾ ಸಿದ್ದ ಮನಸ ರ‍್ಹವಾನಾ ತಿಮ್ಮಜ಼ ತುಮಾರಾ ತುಮಾರಾ ತಾಕತನಾ ನಿಂಗತ ತಿನೆ ಕರೊ. <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />ಯಕ್ಲೊ ದಿವಾ ನಿಂಗತ ಮನಸ ರ‍್ಹಯಲವಾಲೊ ಥೈನ ತೆ ತಿನಾ ಯೊಗ್ಯತೆನೆ ಅನುಸಾರ ಥೈನ ದಿದ್ಯಾರೆ ತೆ ಕರೆಟ್ಟ ಥಯಲ ರ‍್ಹವಸ; ತಿನೆ ಕ್ಹುದಾಕ್ಹು ಮೆಚ್ಚಿಕೆ ಮಳಸ. <verse eid="2CO 8:12" /><verse number="13" style="v" sid="2CO 8:13" />ಬಿಜಾ಼ವೊನೆ ತ್ರಾಸ ಪರಿಹಾರ, ತುಮೊನೆ ತ್ರಾಸ ಥೌಕೈನ ಮಾರಿ ಆಸ <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />ಸರಿಸಮಾನ ರ‍್ಹೌ ಕೈನ ಮಾರು ಮನಸ ವ್ಹೈ. ತೆಳಾಮಾಜ಼಼ ತುಮಾರಿ ಸಮೃದ್ದಿಬಿ ತ್ಯುನು ತ್ರಾಸಬಿ ನಿಗಸಸ. ಅಗು ತ್ಯುನಿ ಸಮೃದ್ದಿ ತುಮಾರಿ ತ್ರಾಸ ನಿಗಸಾನಾಹುತಿ ಅನುಕೂಲ ಥಾವಸ. ಇಮ್ಮ ಸಮಾನ ಉಂಟ ಥಾವಸ.<verse eid="2CO 8:14" /></para>
  <para style="s">ಧರ್ಮನಾ ದ್ರವ್ಯನೆ ಮಳಾವಾನಾಹುತಿ ಪೌಲಾ ಯೊಗ್ಯ ಥಯಲ ದಕ್ಹಾ ದಾಣ್ಗಾವೊನೆ ಕೊರಿಂಥೆ ವಳಾಯಲ</para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 8:15" />ಧರ್ಮ ಶಾಸ್ತ್ರಮಾ ಲಿಕ್ಕಲ ನಿಂಗತ ಘನು ಶೆಖರ ರ‍್ಹಯಲ ವಾಲಾನೆ ಅದಿಕಾರ ಥಯು ನೈ ಮಿತಿಮಿರಿನ ಶೆಖರ ವಾಲಾನೆ ಕಮ್ಮ ಥಯು ನೈ. <verse eid="2CO 8:15" /><verse number="16" style="v" sid="2CO 8:16" />ತುಮಾರಾಹುತಿ ಮನೆ ರ‍್ಹವಾನಿ ಚಿಂತಾನೆ ಕ್ಹುದಾ ತಿತಾನಾ ಮನಸಮಾ ಹುಟ್ಸಾಯಲಕ್ಹು ತಿನೆ ಸೊತ್ರಾ ಕರುಸ. <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />ತೆ ತುಮೊಕನ ಜೌಕೈನ ಅಪೆ ಪುಚ್ತಾಮಾ ತೆ ಒಪ್ಪೆವಾಚಿ ಆಸಕ್ತಿವಾಲೊ ಥಯೊತೊ, ತಿನಾ ಕ್ಹುದ್ದಾನಾ ಚಿತ್ತಕ್ಹು ತುಮೊಕನ ಆಯೊ. <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />ತಿನಾಕ್ಹಾತೆ ಹಜಿ ಯಕ್ಲಾ ಭೈನೆ ವಳಾಯಾಸ. ಎ ಭೈತಿನಾ ರ‍್ಹ ಬಿಜಾ಼ ಹಮಾರಾ ಭೈ ಮೊಕ್ಲ. ಎ ಭೈ ಸುವಾರ್ತೆನಾ ಸೆವೆಮಾ ಕ್ಹಾರಾ ಸಭೆವೊಮಾ ಕಿರ್ತಿ ಪಡ್ದಾಲೊ ಥಯೊಸ. <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />ಎನೈಸೊ, ಕರ್ತಾನಾ ಮಹಿಮಾನಾಹುತಿ ವರಿ ಹಮಾರಾ ತಯಾರ ಮನಸನೆ ದೆಕಾಡಾನಾಹುತಿ ಹಮೆ ಕರಾನಾ ಧರ್ಮನಾ ಕಾಮೊನಾ ಸಂಬಂದ ಥೈನ ಹಮಾರಾ ಕ್ಹಾತೆ ಪ್ರಮಾಣ ಕರಲ ನಿಂಗತ ಸಭೆವೊಮಾತೊ ಇನೆ ಇನಿಲಿದ್ಯಾ. <verse eid="2CO 8:19" /><verse number="20" style="v" sid="2CO 8:20" />ಅಪೆ ಜ಼ಮಾಕರಲ ಎ ಚೊಕಾ ಕೊಡುಗೆನಾ ವಿಶಯಮಾ ಯಕ್ಲಾ ಹಮಾರಾಪರ ತಪ್ಪ ಘಾಲಾನಾಹುತಿ ಆಸ್ಪದ ದ್ಯು ನೈ. <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />ತಿ ಕಾಕದ್ಯಾಮ ಕರ್ತಾನಾ ನಜ಼ರಮಾ ನೈಸೊ ಮನಕ್ಹೊನಾ ನಜ಼ರಮಾ ಯೊಗ್ಯ ಥಯಲ ಕರಾನು ಅಪ್ನು ಉದ್ದೆಶ ವ್ಹೈ. <verse eid="2CO 8:21" /><verse number="22" style="v" sid="2CO 8:22" />ಎ ಭಂಬಿಜ಼ನಾ ಕ್ಹಾತೆ ಮಾರಾ ಭಾಯೊಮಾ ಹಜಿ಼ಯಕ್ಲಾನೆ ವಳಾಯಾಸ; ಹಮೆ ಘನಾ ವಕ್ಹತೊಮಾ, ಘನಾ ಕಾಮೊಮಾ ತಿನೆ ಪರಿಕ್ಷಾ ಕರಿನ ಆಸಕ್ತ ವ್ಹೈ ಕೈನ ಕಳೈಲಿದ್ಯಾಸ; ಹಮ್ನಾ ತೆ ತುಮೊಮಾ ಮ್ಹೆಲಲ ಕ್ಹಾಸ ಭರೊಕ್ಹಾಕ್ಹು ಹಜಿ಼ ಘನು ಹೆಚ್ಚ ಆಸಕ್ತಿವಾಲೊ ಥಯೊಸ. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />ತಿತಾನಾಹುತಿ ಕವಾನು ರ‍್ಹಯಾರೆ, ತೆ ಮಾರೊ ಪಾಲಗಾರ ವ್ಹೈ ತುಮಾರಾ ಪ್ರಯೊಜನನೆ ಮನೆ ಮದತ ಕರಾಲೊ ಥಯೊಸ; ತೆ ಭಾಯೊನಾಹುತಿ ಕವಾನು ರ‍್ಹಯಾರೆ, ತ್ಯುನೆ ಸಭೆಮಾತಾ ವಳಾಯಲವಾಲಾ ವ್ಹೈ. ವರಿ ಕ್ರಿಸ್ತನಿ ಮಹಿಮಾ ಉಜಾ಼ಲು ಕರಾಲಾ ಥಯಾಸ. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />ತಿನಾಹುತಿ ಇವ್ನೊನೆ ಮಯಾಕ್ಹು ದೆಕಿಲಿವೊ. ಹಮೆ ತುಮೊನೆ ಚೊಕು ಕದಲ ನಿಂಗತ ಚಾ಼ಲಿನ ಸಭೆವೊನೆ ತುಮಾರಿ ಯೊಗ್ಯಕ್ಹು ಮನಸಮಾ ವಿಚಾರ ಕರೊ.<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನಾಹುತಿ ತುಮೆ ವಿಚಾ಼ರ ಕರಲ ದೊಕ್ಡಾನಾಹುತಿ ಮಿ ತುಮೊನೆ ಲಿಕ್ಕಾನು ಅವಶ್ಯ ನತ್ತಿ. <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />ತಾರಾ ಮನಸನಿ ಇಚ್ಚಾ ಸುವೈ ಕೈನ ಮನೆ ಗೊತ್ತ ಛೆ. ಪಾಚ಼ಲ್ಯಾ ವರಕ್ಹತಿಬಿ ಅಕ್ಹಾಯವಾಲಾ ಮದತ ಕರಾನಾಹುತಿ ತಯ್ಯಾರ ಥಯಾಸ ಕೈನ ಮೆಕೆದೊನಿಯೊನಾ ಕ್ಹಾಮಾ ತುಮಾರಾಹುತಿ ಚೊ಼ಕು ಕತೊ ಛೆ. ವರಿ ತಾರಿ ಆಸಕ್ತಿ ತ್ಯುನಾಮಾ ಘನಾಜ಼ನಾ ಪ್ರೆರಪ ಥವು. <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />ತೆನೈಸೊ ಹಮೆ ತುಮೊನೆ ಹೊಗಳಲಕ್ಹು ಆದಾರ ರಹಿತ ಥಯುಸ ಮಿ ಕದಲ ತಿಮ್ಮಜ ತುಮೆಬಿ ತಯ್ಯಾರ ಥಾವೊಕೈನ ತೆ ಭಾಯೊನೆ ವಳಾಯೊಸ. <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />ತುಮೆ ತಯ್ಯಾರ ಥಯಾರೆ ಯಕ್ಕ ವಕ್ಹತ ಮೆಕೆದೊನಿಯೊ ವಾಲಾವೊಮಾ ಕುನ್ನತಬಿ ಮಾರಾ ಕ್ಹಾತೆ ಐನ ತುಮೆ ತಯ್ಯಾರ ಥಯಾ ನತ್ತಿ ಕೈನ ದೆಕಿನ ಹಮೊನೆ ತುಮಾರಾಪರ ಹವೊ ಭರೊಕ್ಹೊ ಮ್ಹೆಲಲಕ್ಹು ಹಮೆ ಸರಮೌ ಲಾಗ್ಯು; ತುಮೊನೆ ಸರಮ ಆವಸಕೈನ ಮಿ ಅಮ್ಮ ಕೌಸ. <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಎ ಭಾಯೊ ಪೈಲಾಜ಼ ತುಮೊಕನ ಐನ ತುಮೆ ಪೈಲಾಜ಼ ವಾಗ್ದಾನ ಕರಲ ಕೊಡುಗೆನೆ ತಯ್ಯಾರ ಕರಾನೆ ತುಮೊನೆ ಮದತ ಕರಾನಾಹುತಿ ಇವ್ನೊನೆ ಮಾಂಗಿಲ್ಯುಸ ಅವಶ್ಯ ವ್ಹೈ ಕೈನ ಮನೆ ಗೊತ್ತ ಥಯು , ಆಂ ದಾನಾ ವತ್ತಾಯನು ವಸೂಲಿ ರ‍್ಹಯಾರೆ ಪೂರಾ ಮನಸಕ್ಹು ದಿದಲ ದಾನ ಥಯಲ ರ‍್ಹವಸ.<verse eid="2CO 9:5" /></para>
  <para style="s">ಪೌಲಾ ಕೊರಿಂಥ ಸಭೆವಾಲಾವೊನೆ ಉದಾರ ಥೈನ ದಿವಾನೆ ಪ್ರೆರೆಪ ಕರಲ</para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />ತೆನೈಸೊ ವಿರಳ ಥೈನ ಬಿತ್ತಾಲೊ ವಿರಳ ಥೈನ ಕಾಟಸ. ಕೈನ ಬಿತ್ತಾಲೊ ಕೈನ ಕಾಟಸ. ಆಂ ತುಮೊನೆ ತಿಳದಾದೆ. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />ಹರಯಕ್ಲೊ ತಿನಾ ತಿನಾ ಮನಸಮಾ ಫೈಸಲೊ ಕರಲ ನಿಂಗತಜ಼ ದಿವಾದೆ ; ದುಕ್ಕಕ್ಹು ರ‍್ಹವಾದೆ ಒತ್ತಾಯಕ್ಹು ರ‍್ಹವಾದೆ ಕುನ್ನಜ಼ ದ್ಯು ನೈ; ಕಾ ಕದ್ಯಾಮ ಕ್ಹುಶಿ ಥಯನ ದಿವಾಲಾನೆ ಕ್ಹುದಾ ಮಯಾ ಕರಸ. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />ಕ್ಹುದಾ ಕ್ಹಾರಾ ಬಿಜಾ ಥಯಲ ದಾನಾವೊನೆ ತುಮೊನೆ ಧಾರಾಳ ಥೈನ ದಿವಾನಾಹುತಿ ತಾಕತವರ ಥಯಲಕ್ಹು , ತುಮೆ ಕೆಳಾಮಾಬಿ ಕ್ಹಾರಾ ವಿಶಯೊಮಾ ಪರಿಪೂರ್ಣವಾಲಾ ಥಯನ ಘನಾ ಕಾಮೊನೆ ಕೈನ ಕರಾಲಾ ಥಯನ ರ‍್ಹೌ. <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />ತೆ ಗರಿಬೊನೆ ಧಾರಳ ಥೈನ ದಿವಸ; ತಿನಿ ನಿತಿಬಿ ಹಮೆಶ್ಯಾಬಿ ರ‍್ಹವಸ. <verse eid="2CO 9:9" /><verse number="10" style="v" sid="2CO 9:10" />ಬಿತ್ತಾಲಾನೆ ಬಿಯಾನೆ ಕ್ಹಾವಾಲಾನೆ ಅನ್ನ ದಿವಾಲೊ ತುಮೊನೆ ಬಿತ್ತಾನಾಹುತಿ ಬಿಯೊ ದಿನ ತಿನೆ ಹೆಚ್ಚ ಕರಿನ ತುಮಾರಾ ಧರ್ಮನಾ ಕಾಮೊಕ್ಹು ಥಾವಾನು ಫಲನೆ ವೃದ್ದಿ ಕರಸ. <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />ಇಮ್ಮ ತುಮೆ ಕ್ಹಾರಾ ವಿಶಯೊಮಾ ಸೌಕಾರ ಥೈನ ರ‍್ಹೌ ಉದಾರ ಥೈನ ದಿವಾನೆ ತಾಕತವರ ಥಾವೊಸಿ; ತೆನೈಸೊ ತುಮಾರಾ ದಾನೊ ಹಮಾರಾ ಹತೊಕ್ಹು ಹಜಿ಼ಯಕ್ಲಾನೆ ಸೆರಲ್ಪರ ತೆ ಕ್ಹುದಾನೆ ಕೃತಜ್ಞತ ಸ್ತುತಿ ಉಂಟ ಕರಸ. <verse eid="2CO 9:11" /><verse number="12" style="v" sid="2CO 9:12" />ಕಿಮ್ಮ ಕದ್ಯಾಮ ಕರಾನು ಎ ಧರ್ಮನು ಕಾಮ ಕ್ಹುದಾನಾ ಮನಕ್ಹೊನು ಕೊರತೆ ನಿಗಸಸ ಎನೈಸೊ ಘನಾ ತರಿಕಾಮಾ ಕ್ಹುದಾನೆ ಕೃತಜ್ಞತಾಸ್ತುತಿ ಉಂಟ ಕರಾನೆ ಆಂ ಕಾರಣ ಥಾವಸ. <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />ತುಮೆ ಕರಾನಿ ಮದತ ವರಿ ತುಮಾರು ಯೊಗ್ಯನು ಭಾವ ಘನಾಜ಼ನಾ ದೆಕ್ತಾಮಾ, ತುಮೆ ಕರಲ ಕಾಮನೆ ಕರಟ್ಟ, ಕ್ರಿಸ್ತನಿ ಸುವಾರ್ತಾನೆ ತುಮೆ ಅನುಸರಸಲಕ್ಹು, ತ್ಯುನೊನೆ ವರಿ ವರಿ ಕ್ಹಾರಾಜ಼ನಾವೊನೆ ತುಮೆ ಉದಾರ ಥೈನ ಮದತಕರಾಲಾವೊಕ್ಹು ತ್ಯುನೆ ಕ್ಹುದಾನೆ ಸ್ತುತಿ ಕರಸ. <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />ತೆನೈಸೊ ತುಮಾರಾಹುತಿ ವಿಜ್ಞಾಪನ ಕರಿನ ಕ್ಹುದಾನು ಚೊಕಿ ರ‍್ಹಯಲ ಕೃಪಾ ತುಮೊನೆ ಮಳಲಕ್ಹು ತ್ಯುನೆ ತುಮೊನೆ ದೆಕಾನೆ ಆಸ ಕರ‍್ಯಾವಾಚಿ ತುಮಾರಾಹುತಿ ಪ್ರಾರ್ಥನಾ ಕರಸ. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />ಮೊಜಾ಼ನೆ ಅಸಾದ್ಯ ಥಯಲ ದಾನೊನೆ ನಿಮಿತ್ತ ಕ್ಹುದಾನೆ ಸ್ತೊತ್ರಾ ಥಾವಾದೆ.<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s">ತಿನೆ ಅದಿಕಾರ ನತ್ತಿಕೈನ ವಿರೊದಿಯೊ ಕದಲ ವಾತೊನೆ ಪೌಲಾ ದಿವಾನು ಜವಾಬ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />ಪೌಲಾ ಹಮಾರಾ ಕ್ಹಾಮೊ ರ‍್ಹತಾಮಾ ದಿನ ಥೈನ ಚಾ಼ಲಿಲಿವಸ ದೂರಮಾ ರ‍್ಹತಾಮಾ ಅಪೊನೆ ದಿಟ್ಟತನಾ ದೆಕ್ಲಾಡಾಲೊ ಥಯೊಸ ಕೈನ ಕವಾನು ತೆ ಪೌಲಾ ಕವಾಲೊ ಮಿ ಕ್ರಸ್ತನು ಶಾಂತ ಮನಸನೆ ಕ್ಹರಿನಿ ಸ್ಹೆಂನೆ ಲೈನ ತುಮೊನೆ ಕ್ಹರಿಜ಼ ಕವಾನು ಸುವೈ ಕದ್ಯಾರೆ, <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />ಕುನಬಿ ಅಪೊನೆ ಲೊಕನಾ ತರಿಕಾಮಾ ಜಿವ್ಸಸಕೈನ ಮೊಜ಼ಸತೊ ತ್ಯುನಾ ಕ್ಹಾತೆ ದಿಟ್ಟತನಾಕ್ಹು ರ‍್ಹೌ ಕೈನ ಕೈಲಿದ್ಯೊಸ. ಹಮೆ ತುಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹತಾಮಾ ಥ್ಯವು ದಿಟ್ಟತನಾನೆ ದೆಕ್ಲಾಡಾನಾಹುತಿ ಅವಕಾಶ ಮಳು ನೈ ಕೈನ ತುಮೊಕನ ಮಾಂಗಿಲ್ಯುಸ. <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />ಅಪೆ ಲೊಕಮಾ ರ‍್ಹೈತಬಿ ಲೊಕನಾಹುತಿ ಯುದ್ದ ಕರಾಲಾ ನವೈ. <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />ಅಪೆ ಉಪಯೊಗ ಕರಾನಾ ಆಯುದೊ ಲೊಕನಾ ಆಯುದೊ ನವೈ. ತೆ ಕ್ಹುದಾನಾ ಇಸಾಬಮಾ ತಾಕತವರ ಥಯಲ ವ್ಹೈ ಕೊಟೆವೊನೆ ಪಾಡಾಲಾ ಥಯಾಸ. <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />ಅಪೆ ಕ್ಹುದಾನಾ ಗ್ಯಾನನೆ ವಿರೊದಿಯೊ ಥೈನ ಉಟಾನಾ ಅಹಂ ಬಾವಾನಾವೊನೆ ನಸ್ಟ ಕರಿನ, ಹರಯಕ್ಕ ವಿಚಾರೊನೆ ಕ್ರಿಸ್ತನೆ ವಿದೆಯೆ ಥಾವಾ ನಿಂಗತ ಕಬ್ಜೊ ಕರಿನ, <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />ತುಮಾರಿ ವಿದೆಯತೆ ಪೂರಾ ಥಯಲ್ಪರ ಕ್ಹಾರಾ ಅವಿದೆಯತೆನೆ ಪ್ರತಿಕಾರನೆ ದಿವಾನಾಹುತಿ ತಯ್ಯಾರ ಥಯಾಸ. <verse eid="2CO 10:6" /><verse number="7" style="v" sid="2CO 10:7" />ತುಮೆ ಭಾರು ರ‍್ಹಯಲ ಯಕ್ಕಜ಼ ದೆಕ್ಯೊಸಿ. ಕುನ್ನತಬಿ ತಿನೆ ಕ್ರಿಸ್ತವಾಲೊ ವ್ಹೈಕೈನ ಒಪ್ಪಿ ಲಿದ್ಯಾರೆ ತೆ ವಿಚಾರ ಕರಲಿನ ತೆ ಕಿಮ್ಮ ಕ್ತಿಸ್ತವಾಲೊ ವ್ಹೈ ತಿಮ್ಮಜ಼ ಹಮೆಬಿ ಕ್ರಸ್ತವಾಲಾ ವ್ಹೈ ಕೈನ ಕಳೈಲಿವಾದೆ. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />ಹಮೊನೆ ರ‍್ಹವಾನು ಅದಿಕಾರನೆ ಹಮೆ ಯಕ್ಕ ವಕ್ಹತ ಹೆಚ್ಚ ಹೊಗಳಿಲಿದ್ಯಾಮ ತಿಮ್ಮಜ಼ ಹೊಗಳಿ ಲಿವಾಮಾ ಸರಮೌ ನೈ, ತೆನೈಸೊ ತುಮೊನೆ ಪಾಡಾನಾಹುತಿ ನವೈ ಭಾಂದಾನಾಹುತಿ ವ್ಹೈ ಕರ್ತಾ ಎ ಅದಿಕಾರ ಹಮೊನೆ ದಿದಲ ರ‍್ಹವಸ. <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />ಮಿ ತುಮೊ ಪತ್ರಿಕೆನಾ ಮುಲಕ ಬುಕ್ಕಾಡಾಡೊಸ ಕೈನ ತಿಳ್ದಿ ಲಿವೊ ನಕೊ. <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />ತಿನಾಕ್ಹು ಆಯಲ ಪತ್ರಿಕೆ ಕಟೊರ ರ‍್ಹಯಲ ವ್ಹೈ, ತಾಕತವರ ಥಯಾಸ, ತೆನೈಸೊ ದೈಹಿಕ ಥಯಲ ತೆ ಕಮಜ಼ೊರ ನ್ಹವೈ ತಿನಾ ವಾತೊ ಅವಮಾನನಾ ವಾತೊ ವ್ಹಯ ಕೈನ ದಕ್ಹಾ ಜ಼ನಾ ಕವಸತೊ. <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />ಥ್ಯವಾ, ಅಪೆ ದೂರ ರ‍್ಹತಾಮಾ ಪತ್ರಿಕೆನಾ ಮುಲಕ ವಾತೊಮಾ ಕೆವಾ ಥಯಾಸತೊ ನಜಿಕ ರ‍್ಹತಾಮಾ ಕಾಮೊಮಾಬಿ ಥ್ಯವಾಜ಼ ಛೆ ಕೈನ ಕಳೈಲಿವಾದೆ.<verse eid="2CO 10:11" /></para>
  <para style="s">ಬಿಜೆಯಕ್ಲಾ ಸವಾರತಾ ಕದಲ ಜ಼ಗಾಕನ ತೆ ಕವಾಲೊ ನ್ಹವ್ಹೈ ಕೈನ ಪೌಲಾ ಕವಸ</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />ತ್ಯುನೊನೆ ತ್ಯುನೆಜ಼ ಹೊಗಳಿಲಿವಾಲಾವೊಮಾ ಹಮೊನೆ ಸೆರಸಿಲಿವಾಹುತಿ ರ‍್ಹವಾದೆ ತ್ಯುನಕ್ಹಾತೆ ಹೊಲಸನಾ ಥಾವಾದೆ ಮಿ ಪಸಂದ ಕರ್ತೊ ನೈ. ತ್ಯುನೆತಬಿ ತ್ಯುನಾ ತ್ಯುನಾಮಾಜ಼ ತ್ಯುನೊನೆ ಅಳತಿ ಕರಲಿನ ತ್ಯುನೊನೆತ್ಯುನೆಜ಼ ಹೊಲಿಸಿಲಿನ ವಿವೆಕ ನೈಸೊವಾಲಾ ಥಯಾಸ. <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />ಹಮೆತಬಿ ಹಮಾರಾ ಯೊಗ್ಯತೆನೆ ಮಿರಿನ ಹೊಗಳಿ ಲಿದ್ಯಾವಾಚಿ ಕ್ಹುದಾ ಹಮೊನೆ ನೆಮ್ಸಲ ನಿಂಗತ ಮರೆಮಾ ರ‍್ಹೈನ ಹೊಗಳಿ ಲಿಯೆಸ. ಎ ಮರೆಮಾ ರ‍್ಹೈನ ತುಮೊಲಕ್ಕಾ ಆಯಾಸ. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />ಹಮೆ ಕ್ರಿಸ್ತನಿ ಸುವಾರ್ತೆನೆ ಕತಾ ಬಿಜಾ಼ವೊತಿ ಪೈಲಾಜ಼ ತುಮೊಕನ ಆಯಲಕ್ಹು ತುಮೊಪರ ಅದಿಕಾರ ನೈಸೊವಾಲಾ ನಿಂಗತ ಮೆರೆನೆ ಅತಿಕ್ರಮಿಸಿನ ಜಾ಼ತಾ ನೈ. ಕ್ರಸ್ತನಿ ಸುವಾರ್ತೆನೆ ಕತಾ ಹಮೆ ತುಮೊಕನ ಆಯಾಸತೊ. <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />ಅಪೆ ಮಿತಿಮಿರಿನ ಬಿಜಾ಼ವೊನಾ ಮ್ಹೈನತನಾ ಫಲನೆ ಲಿನ, ಎ ಹಮಾರಾ ವ್ಹೈ ಕೈನ ಜಗ್ಗಾಲಾ ನವೈ. ತೆನೈಸೊ ತಾರಿ ನಂಬಿಕೆ ಹೆಚ್ಚ ಥಾತಾಮಾ ತುಮಾರಾ ಮುಲಕ ಹಮಾರಿ ಮಿತಿ ಹಜಿ಼ ಫೈಲಿ. <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />ತುಮೆ ಹಿಂಗೆ ರ‍್ಹವಾನಾ ಗಾಮೊಮಾ ಸುವಾರ್ತೆ ಕಯೆಸ ಕೈನ ಆಸ ಮ್ಹೆಲ್ಲಿದ್ಯಾಸ. ಬಿಜೆಯಕ್ಲಾನಾ ಜ಼ಗಾಪರ ಹಮೊನೆ ಮಳಲ ಫಲನಾಹುತಿ ವೃದ್ದಿ ಥಾತಾ ನೈ. <verse eid="2CO 10:16" /><verse number="17" style="v" sid="2CO 10:17" />ಹೆಚ್ಚ ಥಾವಾಲೊ ಕರ್ತಾಮಾ ಹೆಚ್ಚ ಥಾವಾದೆ. <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />ತಿನೆ ತೆಜ಼ ಹೊಗಳಿಲಿವಾಲೊ ಯೊಗ್ಯ ನ್ಹವೈ. ಕರ್ತಾ ಕಿನೆ ಹೊಗಳಸತೊ ತೆಜ಼ ಯೊಗ್ಯ ವ್ಹೈ.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s">ಪೌಲಾ ಹುಶಾರಕಿ ಕರಾನು</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />ಮಿ ಮನೆ ಹೊಗಳಿ ಲಿವಾನೆ ಪಿಸಾಳಾಪನೆ ತುಮೆ ನಕ್ಕರ ತಡ್ದಿಲಿವೊಕೈನ ಪುಚ್ಚುಸ. ತುಮೆ ಮನೆ ತಡ್ದಿಲಿವೊ. <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />ಕಾಕದ್ಯಾಮ ಕ್ಹುದಾಮಾ ರ‍್ಹವಾನಾ ಚಿಂತಾಕ್ಹುಜ಼ ಮಿ ತುಮಾರಾ ವಿಶಯಮಾ ಚಿಂತಾ ಕರುಸ. ತುಮೊನೆ ಕ್ರಿಸ್ತ ಕವಾಲಾ ಯಕ್ಲಾಜ಼ ದಾಣ್ಗಾನೆ ಶುದ್ದ ಕನ್ಯೆನೆ ಒಪ್ಸುಕೈನ ತುಮೊನೆ ತಿನೆ ಘಟ್ಟ ಕರ‍್ಯೊಸತೊ. <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />ತೆನೈಸೊ ಕಿಮ್ಮ ಹವಾ ಕ್ಹಾಪನೆ ಮ್ಹೈ ಥೈನ ಮೊಸನೆ ಗೈ ತಿಮ್ಮಜ಼ ತುಮಾರು ಮನಸ ಕ್ರಸ್ತನಾ ವಿಶಯಮಾ ರ‍್ಹವಾನು ಯಥಾರ್ಥನೆ ಶುದ್ದನೆ ಛೊಡಿನ ಕೆಟ್ಟಿ ಗಯುಸ ಕೈನ ಮನೆ ಬುಚು಼ಕ ವಾಟ್ಯುಸ. <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />ಕಾಕದ್ಯಾಮ ಕುನ್ನತಬಿ ಐನ ಹಮೆ ಕದಲ ಯೆಸು ನೈಸೊ ಹಜಿಯಕ್ಲೊ ಯೆಸು ತುಮೊನೆ ದಿಕ್ಹಾಲೊ ನತ್ತಿ ತುಮೆ ಹೊಂದೆವಾಚಿ಼ ರ‍್ಹಯಲ ಬಿಜಾ಼ ಥಯಲ ಆತ್ಮಾನಾ ಪ್ರೆರಣೆನೆ ಹೊಂದತಾಮಾ, ತುಮೆ ಒಪ್ಯಾವಾಚಿ ರ‍್ಹಯಲ ಬಿಜು಼ ಸುವಾರ್ತೆನೆ ಐಕ್ತಾಮಾ ತಡ್ದಿಲಿವೊಸಿ ಘನು ಘಾಬ್ರು. <verse eid="2CO 11:4" /><verse number="5" style="v" sid="2CO 11:5" />ಘನಾ ಚೊ಼ಕಾ ರ‍್ಹಯಲ ಅಪೊಸ್ತಲೊ ಕೈಲಿವಾನಾ ತ್ಯುನಾತಿಬಿ ಮಿ ಯಕ್ಕಮಾತಬಿ ಕಮ್ಮ ಥಯಲವಾಲೊ ನವೈಕೈನ ಮೊಜು಼ಸ. <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />ಮಿ ತರಬೆತಿಮಾ ನಿಪುಣ ನೈ ರ‍್ಹೈತಬಿ ಗ್ಯಾನಮಾ ಕಮ್ಮ ನತ್ತಿ. ಎ ಕ್ಹಾರಾ ವಕ್ಹತಮಾ ದೆಕಾಡಿನ ದಿದ್ಯೊಸ.<verse eid="2CO 11:6" /></para>
  <para style="s">ತೆ ಕೊರಿಂಥ ಸಭೆನೆ ದೊಕ್ಡಾನಿ ಮದತ ಲಿದ್ಯಾವಾಚಿ ಗಯಲಕ್ಹು ದೊಷೊ ಮೊಜು಼ ನೈಕೈನ ಪೌಲಾ ಕದಲ</para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7" />ತುಮೆ ಅಬಿವೃದ್ದಿ ಥೌಕೈನ ಮನೆಮಿಜ಼ ತಗ್ಸಿಲಿನ ಕ್ಹುದಾನಿ ಸುವಾರ್ತಾನೆ ತುಮೊನೆ ಉಚಿತ ಕದಲಕ್ಹು ಪಾಪ ಕರ‍್ಯೊಸಸು? <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />ತುಮೊನೆ ಸೆವಾ ಕರಾನಾಹುತಿ ಮಿ ಬಿಜಾ಼ ಸಭೆವೊಕ್ಹು ಮದತ ಕರಲಿವಾಡೊತೊ, ತುಮಾರಾಹುತಿ ಬಿಜಾ಼ ಸಭೆವೊಕ್ಹು ದೊಕ್ಡಾ ಉಸಲ ಕರಾಡೊತೊ. <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" />ಮಿ ತುಮಾರಾಮಾ ರ‍್ಹತಾಮಾ ಖರ್ಚಾನೆ ಸುಜ಼ ನೈ ರ‍್ಹಯಲ ಟೈಮಾ ಕಿನಾಜ಼ ಉಪ್ಪರ ವಜ್ಜು ಘಾಲ್ಯೊ ನತ್ತಿ. ಮೆಕೆದೊನತಾ ಆಯಲ ಭಾಯೊ ಮನೆ ಚಾ಼ಯೆ ಥಯಲ ಕ್ಹಾರುಜ಼ ದಿದ್ಯಾ. ಮಿ ತುಮೊನೆ ಕಿಮಾಜ಼ ವಜ್ಜು಼ ಥೌ ನೈಕೈನ ದೆಕಿಲಿವಾಡೊತೊ. ಇಪರಬಿ ದೆಕಿಲ್ಯುಸ. <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />ಹಮ್ನಾ ಮಾರಿ ಹೊಗಳಿಕೆ ಆಖಾಯನಾ ಗಾಮೊಮಾ ಯಕ್ಲೊಬಿ ತಡದ್ಯಾವಾಚಿ ಕ್ರಿಸ್ತಕನ ಕ್ಹರಿಜ಼ ಕೌಸ. <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />ತುಮಾರಾಕ್ಹು ಮಿ ಸುಜ಼ ಕಾ ಲಿವಾಡೊ ನತ್ತಿ? ತುಮೊಪರ ಮಯಾ ನೈ ರ‍್ಹಯಲಕ್ಹು ಸು? ನತ್ತಿ, ತುಮೊಪರ ಹಮೊನೆ ರ‍್ಹಯಲ ಮಯಾ ಕೆಕ್ಲಿಕಿ ಕ್ಹುದಾ ದೆಕ್ಯೊಸ. <verse eid="2CO 11:11" /><verse number="12" style="v" sid="2CO 11:12" />ದಕ್ಹಾಜನಾ಼ ತ್ಯುನೆ ಕರಾನಾ ಕಾಮೊ, ಅಪೆ ಅಪೊಸ್ತಲೊ ಥೈನ ಕರಾನಾ ಕಾಮೊ ಸರಿ ಸಮಾನ ವ್ಹೈ ಕೈನವಾದ ಕರಾನೆ ಅವಕಾಶ ಹುಡಕಸ. ಹುಡ್ಕಾಲಾವೊನೆ ಕಯುಜ಼ ಆಸ್ಪದ ಮಳೆವಾಚಿ಼ ಮಿ ಹಮ್ನಾ ಕರಾನುಜ಼ ಅಗೊ ಬಡೈನ ಜೌಸ. <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />ತೆನೈಸೊ ಥ್ಯವಾ ಸುಳ್ಳ ಅಪೊಸ್ತಲೊ, ಮೊಸಕರಾಲಾ ಕಾಮವಾಲಾ, ಕ್ರಿಸ್ತನಾ ಅಪೊಸ್ತ ಥೈನ ದಿಕ್ಹಾನಾಹುತಿ ಬಿಜು಼ ರೂಪ ಘಾಲ್ಲಿಲಿವಾಲಾ ಥಯಾಸ. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />ಆಂ ಸುವೈ ಘಾಬ್ರು ನವೈ. ಸೈತಾನ ತೆಜ಼ ಪ್ರಕಾಶ ರೂಪ ದೆವದೂತನು ರೂಪ ಘಲ್ಲೆತಾಮಾ, <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />ತಿನಾ ಸೆವಕೊ ನಿತಿನೆ ಸೆವಕೊ ಥೈನ ದಿಕ್ಹಾನಾಹುತಿ ರೂಪ ಘಾಲ್ಲಿವಾನು ಘಬ್ರುಸು ನವೈ. ತ್ಯುನು ಅಂತ್ಯಾವಸ್ಥೆಬಿ ತ್ಯುನಾ ಕಾಮೊನೆ ತಕ್ಕ ರ‍್ಹವಸ.<verse eid="2CO 11:15" /></para>
  <para style="s">ತೆ ಕ್ರಿಸ್ತನಾ ಸೆವೆಮಾ ಪಡ್ದಲ ಕಷ್ಟ ಕ್ರಿಸ್ತಕ್ಹು ಹೊಮದಲ ಜಾಸ್ತಿ ಕಯು ವ್ಹೈ ಕೈನ ಕವಾನು</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />ಕುನಬಿ ಮನೆ ಬುದ್ದಿಹಿನ ವ್ಹೈ ಕೈನ ತಿಳದ್ಯೊ ನಕೊ ಕೈನ ಫರಿನ ಕೌಸ. ತಿಮ್ಮಜ಼ ಸ್ಹೆಂ ಕರಿತಬಿ ಚಿಮತಾ ನತ್ತಿ. ಮನೆ ಬುದ್ದಿ ನೈಸೊವಾಲೊ ಕೈನ ಸ್ವಿಕಾರ ಕರಿನ. ತೆಳಾಮಾ ಮಿ ಆತ್ಮಾನಿ ಪ್ರಶಂಸೆ ಕರಾನೆ ಕಮ್ಮ ಥೈತಬಿ ಕಮ್ಮ ಥಾವಸ. <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />ಮಿ ಹಮ್ನಾ ಬೊಲಾನಾ ವಾತೊನೆ ಕರ್ತಾನೆ ಅನುಸರಸಾಲಾ ಥೈನ ನೈಸೊ ಭರೊಕ್ಹಾಕ್ಹು ತಿನೆ ಹೊಗಗಳಿಲಿವಾನೆ ಬುದ್ದಿ ನೈಸೊವಾಲಾ ನಿಂಗತ ಕರುಸ. <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />ದಕ್ಹಾಜ಼ನಾ ಲೊಕನು ಸಮಂದ ಥಯಲ ಕಾಮೊಮಾ ಹೊಗಳಿಲಿವಾನಾಹುತಿ ಮಿ ಹೊಗಳುಸ. <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />ತುಮೆ ಗ್ಯಾನವಾಲಾ ಥೈನ ಗ್ಯಾನ ನೈಸೊವಾಲಾವೊನೆ ಕ್ಹುಶಿಕ್ಹು ತಡ್ದಿಲಿವೊಸಿತೊ. <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />ಯಕ್ಲೊ ತುಮೊನೆ ತಿನಾಮಾ ವಶಮಾ ಕರಲಿದ್ಯಾಮ, ಯಕ್ಲೊ ತುಮೊನೆ ಗಳಿತಬಿ, ಯಕ್ಲೊ ತುಮೊನೆ ಫರಿನ ಧರ‍್ಯಾಮ, ಯಕ್ಲೊ ತಿನೆ ಹೆಚ್ಕಿ ಕರಲಿದ್ಯಾಮ ಯಕ್ಲೊ ತಿನಾ ಮ್ಹೊಡಾಪರ ಮಾರಿತಬಿ ತಡ್ದಿಲಿವಸತೊ. <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />ಹಮೆ ತಾಕತ ನೈಸೊವಾಲಾ ಥೈನ ಸರಮಕ್ಹು ಕೌಸ. ಕಯಾ ಆದಾರಕ್ಹು ಕುನ್ನತಬಿ ಮ್ಹೊಟಾಪನಕ್ಹು ಹೊಗಳಸತೊ ತಿನಾಕ್ಹುಜ಼ ಮಿ ಹೊಗಳಿಲಿವಾನಾಹುತಿ ಗ್ಯಾನನೈಸೊವಾಲಾ ನಿಂಗತ ಬೊಲಾಡೊಸ. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />ತ್ಯುನೆ ಇಬ್ರಿವಾಲಾ ವ್ಹೈ? ಮಿ ಇಬ್ರಿವಾಲೊ ವ್ಹೈ ತ್ಯುನೆ ಇಸ್ರಾಯಲನಾ ವ್ಹೈ? ಮಿ ಇಸ್ರಾಯಲವಾಲೊ ವ್ಹೈ. ತ್ಯುನೆ ಅಬ್ರಾಮನನಾ ವಂಶವಾಲಾ ವ್ಹೈ? ಮಿಬಿ ತೆಜ಼ ವಂಶವಾಲೊ ವ್ಹೈ. <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />ತ್ಯುನೆ ಕ್ರಸ್ತನಾ ಸೆವಕೊ ವ್ಹೈ? ತ್ಯುನಾತಿಬಿ ಮಿ ಹೆಚ್ಚ ಸೆವೆ ಕರಾಲೊ ಥಯೊಸ. ಮಿ ಗ್ಯಾನ ನೈಸೊವಾಲಾ ನಿಂಗತ ಬೊಲಾಡೊಸ ಕ್ರಿಸ್ತನಾ ಸೆವಾಮಾ ತ್ಯುನಾತಿಬಿ ಹೆಚ್ಚ ಮ್ಹೈನತ ಕರ‍್ಯೊಸ, ಹೆಚ್ಚ ಜೆಲಮಾ ರ‍್ಹಯೊಸ, ಮಿತಿಮಿರಿನ ಮಾರೊ ಕ್ಹಾದ್ಯೊಸ. ಘನಿಸಲಾ ಮೌತನಾ ಮ್ಹೊಡಾಮಾ ಕ್ಹಾಪಡ್ಯೊಸ. <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />ಪಾಂಚ಼ಸಲಾ ಯಹುದ್ಯೊಕ್ಹು ಮನೆ ಯಕ್ಕ ಕಮ್ಮ ಚಾಳಕ್ಹ ಮಾರೊ ಬೈಟ್ಯಾಸ. <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" />ತನ್ನಸಲಾ ಬಾರಕೊಲಕ್ಹು ಮನೆ ಮಾರ‍್ಯಾಸ. ಯಕ್ಕಸಲಾ ಮನಕ್ಹೊ ಮನೆ ಕ್ಹಲಾಸ ಕರಾನೆ ದಗ್ಡಾ ನಾಕ್ಯಾಸ. ತನ್ನಸಲಾ ಮಿ ರ‍್ಹಯಲ ಹಡಗ ತುಟಿ ಗಯು. ಯಕ್ಕರಾತ ಯಕ್ಕಪಾಟ ಸಮಮದರಮಾ ಕಾಟ್ಯೊಸ. <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />ಕ್ರಸ್ತನಿ ಸೆವಾಮಾ ಕೆಕ್ಲಾಕಿ ಕ್ಹಮ್ಮೊ ಘಾಲ್ಯಾಸ. ನದಿಯೊನಾ ಅಪಾಯೊ, ಚ್ವಟ್ಟಾನಾ ಅಪಾಯೊ, ಕ್ಹುದನಾ ಮನಕ್ಹೊ ಅಪಾಯೊ ಅನ್ಯ ಮನಕ್ಹೊಕ್ಹು ಅಪಾಯೊ, ಗಾಮಾ ಅಪಾಯ, ಬಿಜಿ ಜ಼ಗಾಮಾ ಅಪಾಯೊ ಸಮಂದಮಾ ಅಪಾಯೊ, ಸುಳ್ಳ ಭಾಯೊಕ್ಹು ಆಪಾಯೊ, ಮನೆ ಥಯು. <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />ತ್ರಾಸ ಕ್ಹೈನ ರಾಬ್ಯೊಸ, ಕೆಕ್ಲಿಸಲಾ ನಿಮದರ ಹಾಳ ಥೈಸ; ಭುಕ್ಕಕ್ಹು ಪನಿನಾ ತರಕ್ಹಕ್ಹು ವದ್ಯಾಡ್ಯೊಸ; ಕೆಕ್ಲಿಕಿಸಲಾ ಅನ್ನ ವರಿ ವಣ್ಣಾ ನೈಸೊ ಅಲೆದಾಡ್ಯೊಸ; ಥಂಡನಾ ದಿನಮಾ ಕಾಪ್ಯೊಸ. <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />ಹವಾ ಬಿಜಾ ಸಂಗತಿಯೊಮಾ, ಕ್ಹಾರಾ ಸಭೆವೊನಾಹುತಿ ಚಿಂತಾ ದಿನ್ನೆ ದಿನ್ನೆ ಮನೆ ಕದ್ರಾತುತು. <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />ಕುನ್ನತಬಿ ತಾಕತವರ ರ‍್ಹಯಾರೆ ಮಿ ತಿನಾಕ್ಹಾತೆ ತಾಕತವರ ಥೈನ ವ್ಹತ್ತೊ? ಕುನ್ನತಬಿ ತಪ್ಸಿ ಲಿದ್ಯಾಮ ಮಿ ಸಂತಾಪ ಪಡ್ದೆವಾಚಿ ವ್ಹತ್ತೊ? <verse eid="2CO 11:29" /><verse number="30" style="v" sid="2CO 11:30" />ಮಿ ಹೊಗಳಿಲಿದ್ಯಾಮ ಮಾರಿ ತಾಕತನಾಹುತಿ ಹೊಗಗಳಿಲೆತೊತೊ. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />ಮಾರಾ ವಾತೊ ಸುಳ್ಳ ವ್ಹೈ ಕೈನ ಮಾರೊ ಕರ್ತಾ ಥಯಲ ಯೆಸು ಕ್ರಿಸ್ತ ಕ್ಹುದಾ, ಬಾಬಿ ಥಯಲವಾಲೊ ಹಮೆಶಾಬಿ ಸ್ತುತಿ ಹೊಂದಾಲೊ ವ್ಹೈ ಕೈನ ಕ್ಹುದಾ ವ್ಹೈ ಕೈನ ಗೊತ್ತ ಥಯು. <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" />ದಮಸ್ಕಮಾ ರಾಜೊ಼ ಥಯಲ ಅರೆತನಾ ಅದಿನಮಾ ರ‍್ಹಯಲ ಅದಿಪತಿ ಮನೆ ಧರುಕೈನ ದಮಸ್ಕನಾ ಗಾಮನೆರ ಕಾಯ್ದಾತಾಮಾ. <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />ತ್ಯುನೆ ಮನೆ ಯಕ್ಕ ಟೊಪ್ಲಿಮಾ ಬೈಟಾಡೊ ಗೊಡಿಮಾ ರ‍್ಹಯಲ ಯಕ್ಕ ಕಿಡಕಿತಾ ಉತಾರಿ ಪಡ್ಯಾ. ಇಮ್ಮ ತಿಮಾ ಹತ್ತಕ್ಹು ತಪ್ಸಿಲಿನ ನ್ಹಾಟಿ ಗಯೊ.<verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s">ಪೌಲಾನೆ ಥಯಲ ದರ್ಶನ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />ಹೊಗಳಿಲಿವಾನು ಹಿತಕರ ನವೈ. ತೆನೈಸೊ ಹೊಗಳಿ ಲಿವಾನು ಮನೆ ಅನಿವಾರ್ಯ ಥಯುಸ. ತಿನಾಹುತಿ ಕರ್ತಾ ಮನೆ ದಿದಲ ದರ್ಶನೊನೆ ವರಿ ತಿಳಸಾಯಲ ರಹಸ್ಯೊನಾಹುತಿ ಕವುಸ. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />ಕ್ರಿಸ್ತಮಾ ರ‍್ಹಯಲ ಯಕ್ಕ ಮನಕ್ಹನೆ ದೆಕ್ಯೊ. ತೆ ಚೌದಾ ವರಕ್ಹ ಪಾಚೊ಼ ತನವಾ ಸ್ವರ್ಗೆ ಗಯೊ. ತೆ ಅಂಗನಾಕ್ಹಾತೆಜ ಗಯೊ, ತೆನೈಸೊ ಅಂಗನಾಕ್ಹಾತೆ ಗಯೊ ಮಿ ಕದ್ಯೊಸ, ಕ್ಹುದಾ ಛೆ. <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />ತೆ ಪರದೆಶಲಕ್ಕಾ ಗೈನ ಮನಕ್ಹೊಕ್ಹು ಉಚ್ಚಾರ ಕರಾನೆ, ಬೊಲಾನೆ ನೈ ಆಯಲ ವಾತೊ ಐಕ್ಯೊಸ ಕೈನ ಕದ್ಯೊ. . <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />ತೆ ಟೈಮಾ ತೆ ಅಂಗನಾಕ್ಹಾತೆಜ಼ ವ್ಹತ್ತೊ ನೈತೊ ಅಂಗನಾಕ್ಹಾತೆಜ಼ ಮಿ ಕದ್ಯೊತೊ, ಕ್ಹುದಾ ಛೆ <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />ತಿನಾಹುತಿ ಮಿ ಹೆಮ್ಮೆ ಕರುಸ. ತೆನೈಸೊ ಮಾರಿ ತಾಕತನೆ ಬಿಜಿ ಹೊಗಳಿಕಿ ಮನೆ ನತ್ತಿ. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />ಹೊಗಳಿಲಿವಾನು ಮನೆ ಯಕ್ಕ ಯೆಳ ಮನಸ ರ‍್ಹೈತಬಿ ತಿಮ್ಮ ಹೊಗಳಿಲಿವಾಮಾ ಗ್ಯಾನ ನೈಸೊವಾಲಾ ನಿಂಗತ ನೈ ಥಾತೊ, ಕಾಕದ್ಯಾಮ ಕ್ಹರಿಜ ಕವಾಡೊಸ. ರ‍್ಹೈತಬಿ ಕುನ್ನಬಿ ಮಾರಾಮಾ ದಿಕ್ಹ್ಯಾತಿಬಿ ಮಾರಾಕ್ಹು ಐಕಾತಬಿ ಹೆಚ್ಚ ಮನೆ ಮ್ಹೊಟೊ ವ್ಹೈ ಕೈನ ಕೌ ನೈ. <verse eid="2CO 12:6" /><verse number="7" style="v" sid="2CO 12:7" />ಎ ಕಾರಣಕ್ಹು ವರಿ ಮನೆ ತಿಳ್ಸಾಯಲ ರಹಸ್ಯೊಕ್ಹು ಘನಾ ಕ್ಹಾಸ ರ‍್ಹಯಲಕ್ಹು ಮಿ ಹೊಗಳಿ ಲಿದ್ಯಾವಾಚಿ಼ ಗಪ್ಪ ರ‍್ಹೌಸ. ಪ್ರಕಟನೆನಾ ಹೆಚ್ಚಕ್ಹು ಮಿ ಮನೆ ಅತಿಶಯ ಥೈನ ಹೆಚ್ಚ ಕರಲ್ಯು ನೈ ಕೈನ ಯಕ್ಕ ಶೂಲ ಮನೆ ತಿವಿದಾನಾಹುತಿ ಮಾರಾ ಅಂಗಮಾ ಮ್ಹೆಲ್ಯಾಸ. ಮಿ ಅಹಂಕಾರ ಕರ‍್ಯಾವಾಚಿ ತಿಮ್ಮಜ಼ ಎ ಮನೆ ತಿವಿದಿನ ಸೈತಾನನಾ ದೂತನಾ ನಿಂಗತ ಕದ್ರಾವಾಡುತು. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />ಆಮ ದುಕ್ಕ ಮನೆ ಛೊಡಿನ ಜಾವಾ ನಿಂಗತ ತನ್ನಸಲಾ ಕರ್ತಅಕನ ಮಾಂಗಿಲಿದ್ಯೊ ತೆನೈಸೊ <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />ತಿನಾಹುತಿ ತೆ, ಮಾರಿ ಕರಪಾ ತುನೆ ಬಸ್ಸ, ತಾಕತವರ ನಯ ರ‍್ಹಯಲ ಟೈಮಾ ಮಾರಿ ತಾಕತ ತಾರಾಕ್ಹಾತೆ ರ‍್ಹವಸ. ಕೈನ ಮನೆ ಕದ್ಯೊ. ಇಮ್ಮ ರ‍್ಹತಾಮಾ, ಕ್ರಿಸ್ತನಿ ತಾಕತ ಮಾರಾಮಾ ಔ ಕೈನ ಮನೆ ಥಾವಾನು ತಾಕತ ನೈ ರ‍್ಹತಾ ಟೈಮಾ ಘನೊ ಕ್ಹುಶಿ ಥೈನ ಹೆಚ್ಚ ಕರುಸ. <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />ತಿನಾಹುತಿ ಕ್ರಿಸ್ತನಾ ನಿಮಿತ್ತ ಬಲಹಿನಮಾ ಇನ್ಕಾರಮಾ , ಕೆರತೆಮಾ, ತ್ರಾಸಮಾ, ವರಿ ಇಕ್ಕಟ ಅನುಭವ ಕರ್ತಾಮಾ ಕ್ಹುಶಿ ಥಯೊಸ. ಕಾಕದ್ಯಾಮ ಮಿ ಕೆಳಾಮಾ ತಾಕತ ನಯಸೊವಾಲೊ ಥವುಸತೊ, ತೆಳಾಮಾಜ಼ ತಾಕತವಾಲೊ ಥವುಸ.<verse eid="2CO 12:10" /></para>
  <para style="s">ಪೌಲಾ ತಿನು ಪ್ರತಿ ವಾದಾನೆ ಮುಗ್ಸಿನ ತೆ ಕೊರಿಂಥೆ ಐನ ಕ್ಹಾರುಜ಼ ಕೌಸ ಕವಾನು</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />ಮಿ ಇಮ್ಮ ಲಿಕ್ಕಿನ ಗ್ಯಾನ ನೈಸೊವಾಲೊ ಥಯೊಸ! ತಿನೆ ತುಮೆ ಮನೆ ಬಲವಂತ ಕರೊ ನಕೊ. ತುಮಾರಾಕ್ಹು ಮನೆ ಹೊಗಳಿಕೆ ಥಾವಾನು ವ್ಹತ್ತು, ಕಾಕದ್ಯಾಮ ಮಿ ದಕ್ಹೊ ಅಲ್ಪ ಥೈತಬಿ ಚೊಕೊ ರ‍್ಹಯಲ, ಅಪೊಸ್ತಲೊ ಕವೈಲಿವಾತಿ ಯಕ್ಕಮಾತಬಿ ಕಮ್ಮ ರ‍್ಹಯಲವಾಲೊ ನವೈ. <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />ಮಿ ತ್ರಾಸನೆ ಸ್ಥಿರ ಚಿತ್ತಮಾ ತಡ್ದಿ ಲಿವಾಮಾ ಚೊಕಾ ಕಾಮೊ ವರಿ ಅದ್ಬುತ ಕಾಮೊ, ತಿಮ್ಮ , ಮ್ಹೊಟಾ ಕಾಮೊ ಕರಲಾವಾಲಾಮಾ ಯಕ್ಕ ಅಪೊಸ್ತಲನೆ ರ‍್ಹಯಲ ಲಕ್ಷಣಾ ತುಮಾರಾ ವಚ್ಮಾ ಪ್ರಕಟ ಥಯು ನತ್ತಿ. <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />ಮನೆ ದೆಕಿಲಿವಾನು ವಜ್ಜು ಮಿ ತುಮೊಪರ ಛೊಡ್ಯಾ ಬಗರ ವರಿ ಯಕ್ಕಜ಼ ವಿಶಮಾ ನೈತೊ ಬಿಜಾ಼ ಕಯಾಜ಼ ವಿಶಯಮಾ ತುಮೊನೆ ಉಗ್ರಲ ಸಭೆವಾಲಾ ನಿಂಗತ ಕಮ್ಮ ಕರ‍್ಯೊ ನೈತೊ? ಮಾರು ಎ ತಪ್ಪನೆ ಕ್ಷಮಾ ಕರೊ. <verse eid="2CO 12:13" /><verse number="14" style="v" sid="2CO 12:14" />ಹಮ್ನಾ ಮಿ ತುಮೊಕನ ತನವಾ ಸಲಾ ಆವಾನೆ ತಯ್ಯಾರ ಥಯೊಸ ವರಿ ತುಮೊನೆ ವಜ್ಜು ಥಯಲ ನಯ ರ‍್ಹತು. ಮಿ ತುಮಾರಾ ಸೊತ್ತನೆ ಬಯಸ್ಯಾವಾಚಿ ತುಮೊನೆ ಆಶಿಸಕರುಸ. ಬಚ್ಚಾ ಮಾಬಾಪನಾಹುತಿ ಜ಼ಮಾ ಕರಾನು ಧರ್ಮ ನವೈ ತೆನೈಸೊ ಮಾಬಾಪೊ ಬಚ್ಚಾವೊನಾಹುತಿ ಜ಼ಮಾ ಕರಾನು ಧರ್ಮ ವ್ಹೈ. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />ಮಿತೊ ಮನೆ ರ‍್ಹಯಲ ತುಮಾರಿ ಆತ್ಮಾ ಸಂರಕ್ಷನೆನಾಹುತಿ ಖುಶಿಕ್ಹು ಖರ್ಚ ಕರುಸ, ಮನೆಜ಼ ಖರ್ಚ ಕರಲ್ಯುಸ, ಮಿ ತುಮೊನೆ ಘನ್ನೊ ಮಯಾ ಕರ‍್ಯಾರೆ ತುಮೆ ಸು ಮನೆ ಕಮ್ಮ ಮಯಾ ಕರೊಶಿ? <verse eid="2CO 12:15" /><verse number="16" style="v" sid="2CO 12:16" />ತೆನೈಸೊ ಇಮ್ಮ ರ‍್ಹತಾಮಾ ಮಿ ತುಮೊನೆ ವಜ್ಜು ಥಯೊ ನತ್ತಿ, ತೆನಯಸೊ ಉಪವಾಸಕ್ಹು ತುಮೊನೆ ಸಂಚು ಕರಿನ ಧರ‍್ಯೊಸ ಕೈನ ಕವೊ. <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />ಮಿ ತುಮೊಕನ ವಳಾತಾಮಾ ಕಿನಾ ಮುಲಕ ಥೈತಬಿ ತುಮೊನೆ ವಮಚತ ಕರಿನ ಸುತಬಿ ಲಿದ್ಯೊ? <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />ತುಮೊಕನ ಜಾ಼ವಾನಾಹುತಿ ಮಿ ತಿತಾನೆ ಮಾಂಗಿಲಿನ ತಿನಾಕ್ಹಾತೆ ತೆ ಭಾಯೊನೆ ವಳೈನ ದಿದ್ಯೊ, ತಿತಾ ತುಮೊನೆ ವಂಚನೆ ಕರಿನ ಸುತಬಿ ಲಿದ್ಯ? ಹಮೆ ಬೆಜ಼ನಾ ಯಕ್ಕಜ಼ ವಾಟಮಾ ಚಾ಼ಲ್ಯಾನೈ? ಹಮೆ ತೆಜ಼ ಕ್ರಮಮಾ ಹೆಜ್ಜಿ ಮ್ಹೆಲ್ಯಾ ನೈ? <verse eid="2CO 12:18" /><verse number="19" style="v" sid="2CO 12:19" />ಹಮೆ ಅಕ್ಲಿಯೆಳ ಲಕ್ಕಾ ತುಮರಾ ಕ್ಹಾಮಾ ಪ್ರತಿ ಥಯಲ ಕರಾಡಾಸ ಕೈನ ಭಾವಿಸ್ಯಾಸ? ಕ್ಹುದಾನಿ ಸನ್ನಿದಿಮಾ ಅಪೆ ಕ್ರಿಸ್ತಮಾ ರ‍್ಹೈನ ತುಮಾರಿ ಭಕ್ತಿನಾಹುತಿ ಬೊಲಾಲಾ ಥಯಾಸ. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />ಮಿ ಆತಾಮಾ ಯಕ್ಕಳೆ ತುಮೆ ಇಚ್ಚಾ ಕರಲ ಪ್ರಕಾರ ಮಿ ದಿಕ್ಹತೊ ನೈ ಕವಾನು ಬುಚ಼ಕ ಮನೆ ಛೆ. ತಿಮ್ಮಜ಼ ಮಿ ಇಚ್ಚಾಕರಲ ಪ್ರಕಾರ ತುಮೆ ದಿಕ್ಹಾತಾ ನೈ ಕಯನ ಶಂಕಾ ಮನೆ ಛೆ. ಯಕ್ಕ ವಕ್ಹತ ತುಮೊಮಾ ಲಡೈ, ಹೊಚ್ಚಿಗಿಟ್ಟಿ , ದ್ವೆಷ, ಮಂದ ಗ್ಯಾನ ಚಾಡಾ ಕವಾನು , ಕಾನಮಾ ಕವಾನು, ಫುಗ್ಗಾನು, ಕಲಹ ಉಟಾಡಸ ರ‍್ಹವಸ ಕೈನ ಮನೆ ಶಕ್ಕ ಛೆ. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />ಮಿ ಫರಿನ ಆಯಲ್ಪರ ಮಾರೊ ಕ್ಹುದಾ ತುಮಾರಾ ವಿಶಯಮಾ ಮನೆ ತಗ್ಸಿ ಲಿವಾನು ಗುರಿ ಕರಲ ನಿಂಗತ ಪೈಲಾ ನಿಂಗತ ಪಾಪ ಕರಿನ, ಬಂಡತನಾ ಹಾದರತನಾ, ಕೆಟ್ಟನೆ ಕರಿನ ಪಶ್ಚಾತಾಪ ಪಡ್ದಲ ಘನಾಜ಼ನಾ ವಿಶಯೊಮಾ ಮಿ ದುಕ್ಕ ಪಡ್ದಾನಾಹುತಿ ಮನೆ ಬುಚ಼ಕ ಛೆ.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s">ಲಾಸ್ಟನಿಯೊ ಗ್ಯಾನನಿಯೊ ವಾತೊ ವರಿ ಆಶಿರ್ವಾದ</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />ಹಮ್ನಾ ಮಿ ತುಮೊಕನ ಆವಾನು ತನ್ವಾ ಸಲಾ ವ್ಹೈ. ಕಯುಬಿ ದುರ (ಅಪವಾದ) ರ‍್ಹಯುತುಬಿ ತಿನಾಹುತಿ ತಿನೆ ಬೆ ನೈತೊ ತನ್ನ ಸಾಕ್ಷಿಯೊ ರ‍್ಹೌ ಕೈನ ಬರ್ದಲ ಛೆ. <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />ಮಿ ತುಮೊಕನ ಬೆವಾಸಲಾ ಆತಾಮಾ, ಪಾಪಕರಲವಾಲಾವೊನೆ ವರಿ ಬಿಜಾ಼ವೊನೆಬಿ ಹುಶಾರಕಿ ಕರ‍್ಯೊ. ಹಮ್ನಾ ದುರ ರ‍್ಹಯುತಬಿ ವರಿ ಹುಶಾರಕಿ ಕರಾಡ್ಯೊಸ. ವರಿ ನಿ ಫರಿನ ಆತಾಮಾ ತ್ಯುನೊನೆ ಶಿಕ್ಷಾದಿದ್ಯಾವಾಚಿ ರ‍್ಹತೊ ನೈ. <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />ಕ್ರಿಸ್ತಯೆಸುಜ಼ ಮಾರಾ ಮುಕಾಂತರ ಬೊಲಸ ಕವಾನು ತುಮೊನೆ ಸಾಕ್ಷಿ ಚಾ಼ಯೆ ನೈ? ಯೆಸುಕ್ರಿಸ್ತ ತುಮಾರಿ ವಿಶಯಮಾ ದುರ್ಬಲ ವ್ಹೈಕೈನ ವರ್ತನೆ ಕರ‍್ಯೊನೈ. ತಾಕತವರ ಥೈನ ತುಮೊಮಾ ಛೆ. ಕವಾನು ಎಜ಼ ಆಧಾರ ವ್ಹೈ. <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />ಬಲಹಿನ ರ‍್ಹತಾಮಾ ತ್ಯುನೆ ಶಿಲುಬಿಪರ ಚ಼ಡಾಯಾ ಕವಾನು ಕ್ಹರಿ ವ್ಹೈ. ತೆನೈಸೊ ಕ್ಹುದಾನಿ ತಾಕತಕ್ಹು ತೆ ಜುವ್ತೊ ಛೆ. ಕ್ರಿಸ್ತಯೆಸುಮಾ ಅಪೆ ಬಲಹಿನ ವ್ಹೈ ಸು? ತೆ ನೈಸೊ ತುಮಾರಿ ವಿಶಮಾ ದೆಕ್ತಾಮಾ ಕ್ಹದಾನಿ ತಾಕಕ್ಹು ಯೆಸುಸ್ವಾಮಿನಾ ಕ್ಹಾತೆ ಜಿವ್ತಾ ಛೆ. <verse eid="2CO 13:4" /><verse number="5" style="v" sid="2CO 13:5" />ತುಮಾರಿ ವಿಸ್ವಾಸಿ ಜಿವನಮಾ ತಮಾರಿಕ್ಹು ತುಮೊನೆಜ಼ ಪರಿಕ್ಷಾಕರಿನ ದೆಕೊ. ತುಮಾರು ಅಂತರಂಗ ಪರಿಕ್ಷಾ ಕರಿನ ದೆಕೊ.ತುಮೊಮಾ ಕ್ರಿಸ್ತಯೆಸು ತುಮೊಮಾ ಛೆ. ತುಮೆ ವಳಕ್ಯಾಸ ನೈ? ತೆ ತುಮೊಮಾ ನೈ ರ‍್ಹವತ್ತೊ ತುಮೆ ಕೆಟ್ಟ ಮನಕ್ಹೊಜ಼ ವ್ಹೈ. <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />ಹಮೆತೊ ಕೆಟ್ಟ ನ್ಹವೈ ಕೈನ ತುಮೊನೆ ಗ್ವತ್ತ ಛೆ ಕೈನ ಮಿ ಬರೊಕ್ಹೊ ಕರುಸ. <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />ತುಮೆ ಕಯುಜ಼ ಕೆಟ್ಟ ಕರುನೈ ಕೈನ ಕ್ಹುದಾನೆ ಪ್ರಾಥನಾ ಕರುಸ. ತಿಮಾ ಯಕ್ಕಜ಼ ಅಪೆ ಚೊ಼ಕಾ ವ್ಹೈ ಕೈನ ಉದ್ದೆಶ ಹಮೊನೆ ನತ್ತಿ. ಹಮೆ ಕೆಟ್ಟ ವ್ಹೈ ಕೈನ ಕವೈಲಿದ್ಯಾತಬಿ ತುಮೆ ಚೊ಼ಕುಜ಼ ಕರು ಕೈನ ಹಮಾರು ಉದ್ದೆಶ ವ್ಹೈ. <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />ಕ್ಹರಿ ಬಗಲ ರ‍್ಹೈನ ತಿನಾ ವಿರುದ್ದ ಹಮೆ ಸುಜ಼ ಕರ್ತಾ ನೈ. <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />ತುಮೆ ಕ್ಹರಜ಼ ಬಲಾಢ್ಯ ರ‍್ಹಯಾಮ ಹಮೆ ಬಲಹಿನ ರ‍್ಹಯಾತಬಿ ಹಮೊನೆ ಖುಶಿ ವ್ಹೈ. ತುಮೆ ಕ್ರೈಸ್ತವಿಸ್ವಾಸಿಯೊಮಾ ಪರಿಪುರ್ಣ ಥೌ ಕವಾನುಜ಼ ಹಮಾರಿ ಪ್ರಾಥನಾನು ಉದ್ದೆಶ ವ್ಹೈ. <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />ತಿನಾಹುತಿಜ಼ ತುಮೊಕನ ಆವಾತಿ ಪೈಲಾಜ಼ ಅ ಕ್ಹಾರು ಬರ್ದಾಡ್ಯೊಸ.ತುಮೊನೆ ಹಾಳಕರಾಹುತಿ ನ್ಹವೈ. ತುಮೊನೆ ಉಟಾಡಾನಾ ಹುತಿ ಪ್ರಭು ಮನೆ ಅದಿಕಾರ ದಿದಲ ವ್ಹೈ.ಕೆಳಾಮಾಜ಼ ತುಮಾರಾ ಕ್ಹಾಮೊ ಐನ ಮನೆ ರ‍್ಹಯಲ ಅದಿಕಾರ ಕಠಿನ ಥೈನ ಉಪಯೊಗ ಕರಾನು ಮಾರು ಉದ್ದೆಶ ನ್ಹವೈ. <verse eid="2CO 13:10" /><verse number="11" style="v" sid="2CO 13:11" />ಲಾಸ್ಟಮಾ ಭಾಯೊ ಖುಶಿಕ್ಹು ರ‍್ಹವೊ ಪರಿಪುರ್ಣ ಕರ್ಲಿವೊ ಧೈರ‍್ಯಕ್ಹು ರ‍್ಹವೊ ಯಕ್ಕಜ಼ ಮನಸಕ್ಹು ರ‍್ಹವೊ ಸಮಾದಾನ ಕ್ಹು ರ‍್ಹವೊ ತೆಳಾಮಾ ಮಯಾಕ್ಹು ರ‍್ಹಯಲ ಶಾಂತಿದಾಯಕ ರ‍್ಹಯಲ ಕ್ಹುದಾ ತುಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಸ. <verse eid="2CO 13:11" /><verse number="12" style="v" sid="2CO 13:12" />ಮಯಾನಿ ಮಟ್ಟಿ ದಿನ ಯಕ್ನೆ ಯಕ್ಕ ವಂದನೆ ಕರೊ. ಕ್ಹುದಾನಾ ಮನ್ಹೊ ತುಮೊನೆ ಶುಭಾಶಯ ಕದ್ಯಾಸ. <verse eid="2CO 13:12" /><verse number="13" style="v" sid="2CO 13:13" />ಅಪ್ನೊ ಪ್ರಭು ಯೆಸು ಕ್ರಿಸ್ತನೊ ಆಶಿರ್ವಾದ ಕ್ಹುದಾನಿ ಮಯಾ ಪವಿತ್ರ ಆತ್ಮಾನಿ ಅನ್ಯುನ್ಯೆತೆ ತುಮಾರಾ ಕ್ಹಾರಾವೊನಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ. <verse eid="2CO 13:13" /><verse number="14" style="v" sid="2CO 13:14" />ಅಪ್ನೊ ಪ್ರಭು ಯೆಸುಕ್ರಿಸ್ತನಾ ಬಗಲ್ತಿ ಆಲಯ ವರಾ ಕ್ಹುದಾನಿ ಮಯಾ, ಪವಿತ್ರ ಆತ್ಮಾನಿ ಅನ್ಯುನ್ಯತೆ ತುಮಾರಾ ಕ್ಹಾತೆ ರ‍್ಹವಾದೆ..<verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>