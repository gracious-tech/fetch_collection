<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">TA30.SFM 24/11/2004 N. C KITAABUA FIRST DRAFT LUSAKA ZAMBIA.</book>
  <para style="h">AMOSI</para>
  <para style="toc1">Kitabu Kyakua Amosi</para>
  <para style="toc2">Amosi</para>
  <para style="toc3">Amo</para>
  <para style="mt2">KITABU KYAKUA</para>
  <para style="mt1">AMOSI</para>
  <para style="imt">BULONDOLOZI</para>
  <para style="im">
    <char style="bk">Keki kitabu</char> kili na mpunda ya bukabika bwakua Amosi. Amosi waali wali musungi wa nama (1.1) kabili waali wali mulimi (7.14). Leza ni ye waamukuutile kuti abe kabika wakue. Amosi waali wa ku muzi wa Tekoa, muzi waali mu bukolo bwa ku nkungulua ya Yudea. Inzi mpunda yakue ingi yaali palua bukolo bwa ku nkungua bwa Izraeli. Amosi waali wabikula Uzia lu-aali wali likolo wa ku Yudea, ni Yeroboamu wa bubili lu-aali wali likolo wa kyalo kya Izraeli. Bebi byaakitikile mu pepi myaka 750 NK.</para>
  <para style="ip">Amosi waabikwile palua kukandua kwa ntundu ingi mu tutue tubili twakutendekelapo. Inzi mpunda yakue ingi yaali yali palwakua Izraeli. Ozo waali wali musita wakua Izraeli wakukitikilua na biweme. Musita wa kukitikilua na biweme, Baizraeli baamulabile Leza ni kukitila bapabi bibiipile (2.6). Kukandua kwabo na Leza kwaali kwa kubatwala mu buzia (7.17). Inzi Leza abanga walaile nangue waakakwasia Baizraeli kuti bakaanzie paakale byalo binge byonse bibaateekele pa kale (9.12).</para>
  <para style="iot">Bwipi bwa bili mu kitabu kyakua Amosi</para>
  <para style="io">1. Mu mulongo wa mambo, Amosi waitoota.</para>
  <para style="io">2. Kabili mu nsempu isyele ya mu katue ka 1 ni 2, alandilemo palua kukandua kwa ntundu ilekenkeene.</para>
  <para style="io">3. Katue ka 3 kwita mu katue ka 9.11 mulandilue palua kukandua, ni buzia bwakua Izraeli.</para>
  <para style="io">4. Ku mpeleezio mu katue ka 9.12-15, Bazumizi baasyelepo Leza wabalaya kuti ababweziizie ku Izraeli.</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1.1: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 15:1-7">2 Mak 15.1-7</ref>; <ref loc="2CH 26:1-23">2 Mil 26.1-23</ref>; <ref loc="2KI 14:23-29">2 Mak 14.23-29</ref></char>
    </note> Totu i twebo twakua Amosi, umo wa pa basungi ba nama ba ku Tekoa. Twebo tu-aamwene palwakua Izraeli mu myaka ibili ntanzi ya ntensi, Uzia lu-aali likolo wa ku Yudea, ni Yeroboamu mwina Yehoashi lu-aali wali likolo wa Baizraeli.<verse eid="AMO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1.2: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 3:16">Yoe 3.16</ref>
      </char>
    </note>Amosi waalandile nangue,</para>
  <para style="q1" vid="AMO 1:2">“Yawe wabuluma pa Lupili lwa Sayuni,</para>
  <para style="q2" vid="AMO 1:2">watukuma mu Yeruzalemu.</para>
  <para style="q1" vid="AMO 1:2">Bikusi bya kuliiwa na nama tebiliko,</para>
  <para style="q2" vid="AMO 1:2">bikusi bili peulu lupili lwa Karmeli byauma.”<verse eid="AMO 1:2" /></para>
  <para style="s1">Bupinguzi palua bantu bapalameene na Baizraeli.</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1.3: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 17:1-3">Isa 17.1-3</ref>; <ref loc="JER 49:23-27">Yer 49.23-27</ref>; <ref loc="ZEC 9:1">Zak 9.1</ref></char>
    </note>Yawe walanda evi,</para>
  <para style="q1" vid="AMO 1:3">“Pa mulandu wa bibalo bitatu ao bina<note caller="+" style="f"><char style="fr" closed="false">1.3 </char><char style="fq" closed="false">bibalo bitatu ao bina</char><char style="ft" closed="false">: I kulanda nangue bibalo bya kubalabala.</char></note> bya bantu ba mu Damaski,</para>
  <para style="q2" vid="AMO 1:3">nsikaba kubalekelela pasili kubakanda,</para>
  <para style="q1" vid="AMO 1:3">pantu bakitwama bintu bya Bagileadi</para>
  <para style="q2" vid="AMO 1:3">mu kubombia byela bya busanze.<verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />Naakatuma mulilo pa nghanda yakua Hazaeli,</para>
  <para style="q2" vid="AMO 1:4">ozo waakazizia byubo byakua Ben-Hadadi.<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />Naakatyona mulyango wa Damaski,</para>
  <para style="q2" vid="AMO 1:5">naakeenoona likolo wa mu Lulambe lwa Aveni,<note caller="+" style="f"><char style="fr" closed="false">1.5 </char><char style="ft" closed="false">Lulambe lwa Aveni i kulanda nangue Lulambe lwa Bubi</char></note></para>
  <para style="q1" vid="AMO 1:5">ni olia akwete nkonto ya bukolo mu Beti Edeni.</para>
  <para style="q2" vid="AMO 1:5">Bantu bonse ba ku Aramu baakaya kuteekua buzia ku kyalo kya Kiri,”</para>
  <para style="q2" vid="AMO 1:5">koku i kulanda kwakua Yawe.<verse eid="AMO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1.6: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 14:29-31">Isa 14.29-31</ref>; <ref loc="JER 47:1-7">Yer 47.1-7</ref>; <ref loc="EZK 25:15-17">Eze 25.15-17</ref>; <ref loc="JOL 3:4-8">Yoe 3.4-8</ref>; <ref loc="ZEP 2:4-7">Zef 2.4-7</ref>; <ref loc="ZEC 9:5-7">Zak 9.5-7</ref></char>
    </note>Yawe walanda evi,</para>
  <para style="q1" vid="AMO 1:6">“Pa mulandu wa bibalo bitatu bya bantu ba mu Gaza ao bina,</para>
  <para style="q2" vid="AMO 1:6">nsikaba kubalekelela pasili kubakanda.</para>
  <para style="q1" vid="AMO 1:6">Pantu bakitwama bantu bengi</para>
  <para style="q2" vid="AMO 1:6">ni kuya kubasisia nga bazia ku Baedomu.<verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />Naakatuma mulilo ku bibumba bya muzi wa Gaza,</para>
  <para style="q2" vid="AMO 1:7">ozo waakazizia byubo byakue.<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />Naakafumiapo makolo a ku Ashdodi ni a ku Ashkeloni.</para>
  <para style="q2" vid="AMO 1:8">Naakakanda muzi wa Ekroni, ni kwipaya Bafilistini bonse,”</para>
  <para style="q2" vid="AMO 1:8">koku i kulanda kwakua Yawe Kabezia Mpungu.<verse eid="AMO 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1.9: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 23:1-18">Isa 23.1-18</ref>; <ref loc="EZK 26:1-21">Eze 26.1-21</ref>; <ref loc="EZK 27:1-36">27.1-36</ref>; <ref loc="EZK 28:1-19">28.1-19</ref>; <ref loc="JOL 3:4-8">Yoe 3.4-8</ref>; <ref loc="ZEC 9:1-4">Zak 9.1-4</ref>; <ref loc="MAT 11:21-22">Mat 11.21-22</ref>; <ref loc="LUK 10:13-14">Lk 10.13-14</ref></char>
    </note>Yawe walanda evi,</para>
  <para style="q1" vid="AMO 1:9">“Pa mulandu wa bibalo bitatu bya bantu ba mu Tiro ao bina,</para>
  <para style="q2" vid="AMO 1:9">nsikaba kubalekelela pasili kubakanda.</para>
  <para style="q1" vid="AMO 1:9">Pantu bakitwama bantu bengi</para>
  <para style="q2" vid="AMO 1:9">ni kuya kubasisia nga bazia ku Baedomu.</para>
  <para style="q2" vid="AMO 1:9">Tebaafikiliizie kipanghano kya bukibuza kibaakitile.<verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />Naakatuma mulilo ku bibumba bya muzi wa Tiro,</para>
  <para style="q2" vid="AMO 1:10">ozo waakazizia byubo byakue.”<verse eid="AMO 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1.11: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 34:5-17">Isa 34.5-17</ref>; <ref loc="ISA 63:1-6">63.1-6</ref>; <ref loc="JER 49:7-22">Yer 49.7-22</ref>; <ref loc="EZK 25:12-14">Eze 25.12-14</ref>; <ref loc="EZK 35:1-15">35.1-15</ref>; <ref loc="OBA 1:1-14">Oba 1.1-14</ref>; <ref loc="MAL 1:2-5">Mal 1.2-5</ref></char>
    </note>Yawe walanda evi,</para>
  <para style="q1" vid="AMO 1:11">“Pa mulandu wa bibalo bitatu bya bantu ba mu Edomu ao bina,</para>
  <para style="q2" vid="AMO 1:11">nsikaba kubalekelela pasili kubakanda,</para>
  <para style="q1" vid="AMO 1:11">pantu bakitwama kipanga ni kukumbizia ba kwabo.<note caller="+" style="f"><char style="fr" closed="false">1.11 </char><char style="fq" closed="false">ba kwabo</char><char style="ft" closed="false">: I Baizraeli baali ba mu luvyalo lwakua Yakobo, Yakobo ozo waali wali wa kwakue kwa Esau, Esau kikolue wa Baedomu.</char></note></para>
  <para style="q2" vid="AMO 1:11">Bakikaana kumunvwila nkumbu</para>
  <para style="q1" vid="AMO 1:11">pantu kipuki kyakue kyakiba kyalunduluka musita onse,</para>
  <para style="q2" vid="AMO 1:11">ni kikonko kyakue pasili kufuukiiwa.<verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />Naakatuma mulilo mu muzi wa Temani,</para>
  <para style="q2" vid="AMO 1:12">ozo waakazizia byubo bya ku Bozra.”<verse eid="AMO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1.13: </char>
      <char style="xt" closed="false">
        <ref loc="JER 49:1-6">Yer 49.1-6</ref>; <ref loc="EZK 21:28-32">Eze 21.28-32</ref>; <ref loc="EZK 25:1-7">25.1-7</ref>; <ref loc="ZEP 2:8-11">Zef 2.8-11</ref></char>
    </note>Yawe walanda evi,</para>
  <para style="q1" vid="AMO 1:13">“Ba-amoni bakibala bibalo bitatu ao bina,</para>
  <para style="q2" vid="AMO 1:13">ni pakako, kisinka nakaba kubakanda.</para>
  <para style="q1" vid="AMO 1:13">Lubaali basakukila ba Gileadi pakuti belundileko mipaka,</para>
  <para style="q2" vid="AMO 1:13">baali batumbula mavumo a banakazi baali baimisi.<verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />Naakatuma mulilo ku bibumba bya muzi wa Raba,</para>
  <para style="q2" vid="AMO 1:14">ozo waakazizia byubo byakue</para>
  <para style="q1" vid="AMO 1:14">mu nsungu ya malilo mu busiku bwa bului,</para>
  <para style="q2" vid="AMO 1:14">mu mwela ukata mu busiku bwa kinkunsia.<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />Likolo wabo pamo ni babiloolo bakue,</para>
  <para style="q2" vid="AMO 1:15">baakatwalua mu kyalo kyeni,”</para>
  <para style="q2" vid="AMO 1:15">koku i kulanda kwakua Yawe.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2.1: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 15:1-9">Isa 15.1-9</ref>; <ref loc="ISA 16:14">16.14</ref>; <ref loc="ISA 25:10-12">25.10-12</ref>; <ref loc="JER 48:1-47">Yer 48.1-47</ref>; <ref loc="EZK 25:8-11">Eze 25.8-11</ref>; <ref loc="ZEP 2:8-11">Zef 2.8-11</ref></char>
    </note>Yawe walanda evi,</para>
  <para style="q1" vid="AMO 2:1">“Pa mulandu wa bibalo bitatu bya bantu ba mu Moabu ao bina,</para>
  <para style="q2" vid="AMO 2:1">nsikaba kubalekelela pasili kubakanda,</para>
  <para style="q1" vid="AMO 2:1">pantu baaziziizie bikuza byakua likolo wa ku Edomu</para>
  <para style="q2" vid="AMO 2:1">mpaka bya-aluka nga makese.<verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />Naakatuma mulilo pa kyalo kya Moabu</para>
  <para style="q2" vid="AMO 2:2">ozo waakazizia byubo bya mu Kerioti.</para>
  <para style="q1" vid="AMO 2:2">Moabu waakapona mu nsungu ya bului,</para>
  <para style="q2" vid="AMO 2:2">balukale pabakaba basamuna, ni ntandala paikaba yalila.<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />Naakeenoona kateeka wa ku Moabu,</para>
  <para style="q2" vid="AMO 2:3">ni kwipaya babiloolo bakue bonse pamo nakue,”</para>
  <para style="q2" vid="AMO 2:3">koku i kulanda kwakua Yawe.<verse eid="AMO 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />Yawe walanda evi,</para>
  <para style="q1" vid="AMO 2:4">“Pa mulandu wa bibalo bitatu bya bantu ba mu Yudea ao bina,</para>
  <para style="q2" vid="AMO 2:4">nsikaba kubalekelela pasili kubakanda,</para>
  <para style="q1" vid="AMO 2:4">pantu baakeene kusunga mizilo,</para>
  <para style="q2" vid="AMO 2:4">ni kukaana kunakila milao yane,</para>
  <para style="q1" vid="AMO 2:4">pa mulandu wa kukonka baleza ba bufi,</para>
  <para style="q2" vid="AMO 2:4">baleza baali bapupua na babikolue babo.<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />Naakatuma mulilo mu Yudea,</para>
  <para style="q2" vid="AMO 2:5">ozo waakazizia byubo bya mu Yeruzalemu.”<verse eid="AMO 2:5" /></para>
  <para style="s1">Leza wapingula Baizraeli</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />Yawe walanda nangue</para>
  <para style="q1" vid="AMO 2:6">pa mulandu wa bibalo bitatu bya Baizraeli ao bina,</para>
  <para style="q2" vid="AMO 2:6">takaba kubalekelela pasili kubakanda,</para>
  <para style="q1" vid="AMO 2:6">pantu balibasisia balunghami na mutofue,</para>
  <para style="q2" vid="AMO 2:6">ni bapabi na mpe imo ya nkwabilo.<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />Balibanyanta pa mitue ya bapabi,</para>
  <para style="q2" vid="AMO 2:7">nga pa lufunko lwa pa kyalo,</para>
  <para style="q1" vid="AMO 2:7">ni kukaana kupeela nsambu babiibikiziiziwe.</para>
  <para style="q2" vid="AMO 2:7">Se ni mwanae mwalalume balibakumana na mwanakazi umo,</para>
  <para style="q2" vid="AMO 2:7">ni pakako, balibatiikaania Liina lyane lizuuke.<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />Baali balaala mumbali ya kubalua kitale,</para>
  <para style="q2" vid="AMO 2:8">pa ngubo ipokelue ku bapabi kuti ibe kikwatizi.</para>
  <para style="q1" vid="AMO 2:8">Baali baminina bikolani mu nghanda ya baleza babo,</para>
  <para style="q2" vid="AMO 2:8">bikolani bibaali basita na nfolanga ya balia bali ni mizia,<verse eid="AMO 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2.9: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 3:8-11">Mam 3.8-11</ref>
      </char>
    </note> Yawe walanda nangue, “Anzia nainoonene Ba-amori,</para>
  <para style="q2" vid="AMO 2:9">baali baleepele nga bimuti bya mumpelempele,</para>
  <para style="q2" vid="AMO 2:9">ni kuya balumine nga bimuti bya mwaloni.</para>
  <para style="q1" vid="AMO 2:9">Nainoonene mazabo abo ku misambo ku muulu,</para>
  <para style="q2" vid="AMO 2:9">ni kutukuna misila yabo kwinsina.<verse eid="AMO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />Naamifumiizie mu kyalo kya Misri,</para>
  <para style="q2" vid="AMO 2:10">ni kumilombola mu kaseeba myaka 40,</para>
  <para style="q2" vid="AMO 2:10">kuti n'mipeele kyalo kya Ba-amori.”<verse eid="AMO 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2.11: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 6:1-8">Mpe 6.1-8</ref>
      </char>
    </note>“Kabili pa baana benu naasaakwilepo bamo kuba bakabika,</para>
  <para style="q2" vid="AMO 2:11">ni pa baana benu balumendo naasakwilepo bamo kuba banaziri.<note caller="+" style="f"><char style="fr" closed="false">2.11 </char><char style="fq" closed="false">banaziri</char><char style="ft" closed="false">: I Baizraeli balia baipeele kuli Leza mu kukita bilapo bya kusimina divai ao bikolani ao kutebula misisi yabo ao kukumia kifwile (mona Mpe 6.1-8).</char></note></para>
  <para style="q1" vid="AMO 2:11">Ati mwe Baizraeli, te i evio?”</para>
  <para style="q2" vid="AMO 2:11">Koku i kulanda kwakua Yawe.<verse eid="AMO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />“Inzi mwe mwaalengiizie banaziri kubala mu kumina bikolani,</para>
  <para style="q2" vid="AMO 2:12">ni kukaania bakabika tekuti babikule.”<verse eid="AMO 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />“Evi ndikumisansa</para>
  <para style="q2" vid="AMO 2:13">nga tyakala vi-iliyasansa lu-itweme nghano mu masaaka.<verse eid="AMO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14" />Olia aliwakundukisia takapusuka,</para>
  <para style="q2" vid="AMO 2:14">wa maka, maka akue aakapua,</para>
  <para style="q2" vid="AMO 2:14">ni lukale takeepususia.<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />Kalasa wa buta takeesimpa,</para>
  <para style="q2" vid="AMO 2:15">aliwakundukisia takazembuluka,</para>
  <para style="q2" vid="AMO 2:15">ni museli wa farasi takeepususia.<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />Pa bobo busiku anzia kine kukabe bipami biine bya ba balukale,</para>
  <para style="q2" vid="AMO 2:16">baakabutuka tekuba bavwele kantu,”</para>
  <para style="q2" vid="AMO 2:16">koku i kulanda kwakua Yawe.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />Unvue keebo kakilandua na Yawe pa mulandu wenu mwe Baizraeli, mwe lupua lwalingi lunaafumiizie mu Misri:<verse eid="AMO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />“Mwemue sie i banaasaakwile pa ntundu yonse ya pa kyalo.</para>
  <para style="q2" vid="AMO 3:2">Ni pakako, naakamikanda pa mulandu wa bibalo byenu.”<verse eid="AMO 3:2" /></para>
  <para style="s1">Mwilo wakua kabika</para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />Ati, kubako bantu babili kuti baenda pamo</para>
  <para style="q2" vid="AMO 3:3">tekuba baunvwenenke?<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />Ati, kubako nkalamu aliwabuluma mu musitu lu-asinakwate nama?</para>
  <para style="q2" vid="AMO 3:4">Kubako mwina nkalamu kuti wabuluma mu lisele lu-asinakwate kantu?<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />Ati, kubako kooni kuti kakwatua mu muteo ute-elue</para>
  <para style="q2" vid="AMO 3:5">pasili kabembo?</para>
  <para style="q1" vid="AMO 3:5">Ati, kubako muteo kuti wapusa</para>
  <para style="q2" vid="AMO 3:5">tekuba mwali kya kukwatuamo?<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />Ati, kubako musita uliwaliziiwa ntandala ya bului mu muzi</para>
  <para style="q2" vid="AMO 3:6">bantu tebezi kutiina?</para>
  <para style="q1" vid="AMO 3:6">Ati, kubako musita uliwafika busanzo mu muzi,</para>
  <para style="q2" vid="AMO 3:6">te Yawe aliwabuleeta?<verse eid="AMO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />Kisinka Yawe Kabezia Mpungu tezi kukita kantu</para>
  <para style="q2" vid="AMO 3:7">pasili kutubula mapange akue ku babombi bakue bakabika.<verse eid="AMO 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />Nkalamu lu-aliwabuluma,</para>
  <para style="q2" vid="AMO 3:8">nani asivinda kutiina?</para>
  <para style="q1" vid="AMO 3:8">Yawe Kabezia Mpungu lu-aliwalanda,</para>
  <para style="q2" vid="AMO 3:8">nani asivinda kubikula?<verse eid="AMO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />Ele mukunda mu byubo bya mu Ashdodi,</para>
  <para style="q2" vid="AMO 3:9">ni mu byubo bya mu Misri nangue,</para>
  <para style="q1" vid="AMO 3:9">“Kolonghane peulu mpili ya ku Samaria,</para>
  <para style="q2" vid="AMO 3:9">mone lubebue viluvulilemo,</para>
  <para style="q1" vid="AMO 3:9">ni kubiibikiziwa mukati mwakue.”<verse eid="AMO 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />Yawe walanda evi, “Bantu ba ku Samaria tebamanine kukita biweme.</para>
  <para style="q2" vid="AMO 3:10">Bezuziizie bintu mu byubo byabo,</para>
  <para style="q2" vid="AMO 3:10">bintu bibapokele mu bukabooko ni mu bungipaani.”<verse eid="AMO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11" />Ni pakako, evi i vilimukulanda Yawe Kabezia Mpungu nangue,</para>
  <para style="q1" vid="AMO 3:11">“Basamaria baakazyungulukila kyalo kyenu,</para>
  <para style="q2" vid="AMO 3:11">baakatuuta byubo byenu</para>
  <para style="q2" vid="AMO 3:11">ni kupoka nghanda yenu ya kufyamamo.”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />Yawe walanda evi,</para>
  <para style="q1" vid="AMO 3:12">“Nga evelia musungi vi-aliwasompola mu kanua ka nkalamu, myendo ibili ao kiputu kya kutui,</para>
  <para style="q2" vid="AMO 3:12">i vikyaakaba ni ku Baizraeli bekeele mu Samaria,</para>
  <para style="q1" vid="AMO 3:12">balia baleele pa bulita bwabo,</para>
  <para style="q2" vid="AMO 3:12">ni ku bantu ba mu Damaski,</para>
  <para style="q2" vid="AMO 3:12">bantu bekeele mu bitebe byabo bya mutengo.”<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />“Ale twilizie ni kusininkizia palua luvyalo lwakua Yakobo,” koku i kulanda kwakua Mulopue, Yawe Leza wa Maka onse.<verse eid="AMO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3.14: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 23:15">2 Mak 23.15</ref>
      </char>
    </note>“Busiku bunakakanda Baizraeli pa mulandu wa bibalo byabo,</para>
  <para style="q2" vid="AMO 3:14">naakatuuta bitale bya ku Beteli.</para>
  <para style="q1" vid="AMO 3:14">Tutunfi twa bitale twaakeenoonua</para>
  <para style="q2" vid="AMO 3:14">ni kuponena pansi.<verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />Naakatuuta nghanda ya pa musita wa mainza,</para>
  <para style="q2" vid="AMO 3:15">ni nghanda ya pa musita wa kipua.</para>
  <para style="q1" vid="AMO 3:15">Nghanda ifwaniiziwe na meno a nzovu yaakatuutua,</para>
  <para style="q2" vid="AMO 3:15">ni nghanda yonse ikata yaakeenoonua,”</para>
  <para style="q2" vid="AMO 3:15">koku i kulanda kwakua Yawe.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />Twilizie kaka keebo mwe banakazi ba pa lupili lwa Samaria, mwe bali nga nghombe ya ku Basani,</para>
  <para style="q2" vid="AMO 4:1">mwe balibabiibikizia bapabi, ni mwe balibakita bibiipile ku babulilue,</para>
  <para style="q2" vid="AMO 4:1">ni kubaana balume benu nangue “tupeele bikolani!”<verse eid="AMO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2" />Yawe Kabezia Mpungu waalaile mu buzuuke bwakue nangue,</para>
  <para style="q2" vid="AMO 4:2">“Kisinka musita ulimukwiza</para>
  <para style="q1" vid="AMO 4:2">lubakaba kumifumia na ndobaano,</para>
  <para style="q2" vid="AMO 4:2">ni basyelepo pakati kenu baakaba kulobua na ndobaano nga lisabi.<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />Mwaakafumiziwa lya palia patutikile bibumba,</para>
  <para style="q2" vid="AMO 4:3">mwakapoozua panze lya ku Harmoni,”</para>
  <para style="q2" vid="AMO 4:3">koku i kulanda kwakua Yawe.<verse eid="AMO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />“Endo ku Beteli, muye mubale kibalo,</para>
  <para style="q2" vid="AMO 4:4">endo ku Gilgali, mulunduluke kubala.</para>
  <para style="q1" vid="AMO 4:4">Leete ngelelo yenu kubalua lukeelekeele,</para>
  <para style="q2" vid="AMO 4:4">kamo ka pa lyanondo mu nsiku itatu.<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />Zizie mukate ututumukile nga ngelelo ya kusantila,</para>
  <para style="q2" vid="AMO 4:5">iitasie palua bupe bumulimwapeela mu kutona kwenu,</para>
  <para style="q1" vid="AMO 4:5">iitantamune palua bebio byabupe mwe Baizraeli</para>
  <para style="q2" vid="AMO 4:5">pantu bebi i bimutonene kukita,”</para>
  <para style="q2" vid="AMO 4:5">koku i kulanda kwakua Yawe Kabezia Mpungu.<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />“Naaleetele kimina kya nzala mu mizi yenu yonse,</para>
  <para style="q2" vid="AMO 4:6">ni kubulua kwa bilio mu kubalua muzi.</para>
  <para style="q2" vid="AMO 4:6">Anzia kyaali evio temwambweleele,”</para>
  <para style="q2" vid="AMO 4:6">koku i kulanda kwakua Yawe.<verse eid="AMO 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />“Ntanzi ya kufikiila kuzombola,</para>
  <para style="q2" vid="AMO 4:7">nsyaamipeele nvula pa myezi itatu.</para>
  <para style="q1" vid="AMO 4:7">Naanokiizie nvula mu muzi umo,</para>
  <para style="q2" vid="AMO 4:7">inzi mu unge muzi nsyaanokiiziemo.</para>
  <para style="q1" vid="AMO 4:7">Nvula yaanokeele mu bukaba bumo,</para>
  <para style="q2" vid="AMO 4:7">mu bunge mwaasyele mwaumine pantu nsyanokiiziemo.<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />Bantu baendookele mu mizi ni mizi balimukukeba menda a kumina</para>
  <para style="q2" vid="AMO 4:8">inzi tebasangilemo a kubakumana.</para>
  <para style="q2" vid="AMO 4:8">Anzia kyaali evio, temwambweleele,”</para>
  <para style="q2" vid="AMO 4:8">koku i kulanda kwakua Yawe.<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />“Lingi nainoonene makaba enu ni makaba a mizabibu,</para>
  <para style="q2" vid="AMO 4:9">naumiizie bimuti na mwela wa lyuza.</para>
  <para style="q1" vid="AMO 4:9">Luzie lwaaliile bilimbua byonse bya mu makaba enu ni bimuti bya mizeituni.</para>
  <para style="q2" vid="AMO 4:9">Anzia kyaali evio, temwambweleele,”</para>
  <para style="q2" vid="AMO 4:9">koku i kulanda kwakua Yawe.<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />“Naatumine kimina pakati kenu,</para>
  <para style="q2" vid="AMO 4:10">nga vinaakitile ku Bamisri.</para>
  <para style="q1" vid="AMO 4:10">Naipaile baana benu balumendo na kipanga.</para>
  <para style="q2" vid="AMO 4:10">Naamipokele farasi yenu.</para>
  <para style="q1" vid="AMO 4:10">Naizuziizie myona yenu na bunu bwa mibili ibolele mu mitanda yenu.</para>
  <para style="q2" vid="AMO 4:10">Anzia kyaali evio, temwambweleele,”</para>
  <para style="q2" vid="AMO 4:10">koku i kulanda kwakua Yawe.<verse eid="AMO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 4:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4.11: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 19:24">Kut 19.24</ref>
      </char>
    </note>“Nainoonene bamo pakati kenu</para>
  <para style="q2" vid="AMO 4:11">nga evelia vinainoonene Sodoma ni Gomora.</para>
  <para style="q1" vid="AMO 4:11">Naamisomwene nga kakooko ka-apulua pa mulilo.</para>
  <para style="q2" vid="AMO 4:11">Anzia kyaali evio, temwambweleele,”</para>
  <para style="q2" vid="AMO 4:11">koku i kulanda kwakua Yawe.<verse eid="AMO 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />“Ni pakako, evi i vinaakamikitila mwe Baizraeli!</para>
  <para style="q2" vid="AMO 4:12">Kabili pantu naakamikitila evio mwe Baizraeli,</para>
  <para style="q2" vid="AMO 4:12">iiteanie kusaakaana ni Leza wenu.”<verse eid="AMO 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />Olia waabumbile mpili</para>
  <para style="q2" vid="AMO 4:13">ni waalengele mwela,</para>
  <para style="q2" vid="AMO 4:13">olia aliwafyula malanga akue ku bantu,</para>
  <para style="q1" vid="AMO 4:13">aliwa-alula lukeelekeele kuba nfinzi</para>
  <para style="q2" vid="AMO 4:13">ni kwenda pa kyalo pa nkendo ilendukile,</para>
  <para style="q2" vid="AMO 4:13">Yawe, Leza wa Maka onse, i Liina lyakue.<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s1">Amosi wa-ana bantu balapile</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />Mwe Baizraeli, twilizie totu twebo twa lwimbo lwa malilo lundimukumimbila.<verse eid="AMO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />“Kinundue Izraeli aponene,</para>
  <para style="q2" vid="AMO 5:2">takikabuuka,</para>
  <para style="q1" vid="AMO 5:2">waasiilue waleele pansi,</para>
  <para style="q2" vid="AMO 5:2">tekuli wa kumukwasia kubuuka.”<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />Yawe Kabezia Mpungu wa-ana Baizraeli nangue,</para>
  <para style="q1" vid="AMO 5:3">“Muzi waakatuma balukale 1,000 ku bului,</para>
  <para style="q2" vid="AMO 5:3">kwaakabwela sie balukale 100.</para>
  <para style="q1" vid="AMO 5:3">Muzi waakatuma balukale 100 ku bului,</para>
  <para style="q1" vid="AMO 5:3">kwaakabwela sie balukale lyanondo.”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />Yawe wabaana Baizraeli nangue,</para>
  <para style="q1" vid="AMO 5:4">“Nkebe mube ni bukose.<verse eid="AMO 5:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5" />Tekunkebe ku Beteli,</para>
  <para style="q1" vid="AMO 5:5">tekuye ku Gilgali,</para>
  <para style="q2" vid="AMO 5:5">tekwabuke kuya ku Bersheba.</para>
  <para style="q1" vid="AMO 5:5">Pantu Gilgali, kisinka waakaya mu buzia.</para>
  <para style="q2" vid="AMO 5:5">Ni Beteli waaka-alulua kuba mpuni.”<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />Mukebe Yawe mube ni bukose,</para>
  <para style="q2" vid="AMO 5:6">kine te evio, Yawe waakapyanga bantu ba mu nghanda yakua Yusufu nga mulilo.</para>
  <para style="q1" vid="AMO 5:6">Ozo mulilo waakazizia Beteli,</para>
  <para style="q2" vid="AMO 5:6">tekuli muntu waakauzimia.<verse eid="AMO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />Lisyamo lyenu mwe baliba-alulula nsambu kuba bwimba bululile,</para>
  <para style="q2" vid="AMO 5:7">ni kupooza nsambu pansi.<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5.8: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 9:9">Yob 9.9</ref>; <ref loc="JOB 38:31">38.31</ref></char>
    </note>Olia waakitile Bulimina ni Kipindabusiku pamo ni Orioni,</para>
  <para style="q2" vid="AMO 5:8">olia aliwa-alulula nfinzi kuba lukeelekeele,</para>
  <para style="q2" vid="AMO 5:8">ni musita wa koba kuba busiku,</para>
  <para style="q1" vid="AMO 5:8">olia aliwakuuta menda a lyezi ni ku-etila pa kyalo,</para>
  <para style="q2" vid="AMO 5:8">Liina lyakue i Yawe.<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />Aliwainoona nghanda lubilo lubilo,</para>
  <para style="q2" vid="AMO 5:9">ni kutuuta byubo bya mizi.<verse eid="AMO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />Basuulile olia aliwasasililana mu kilie,</para>
  <para style="q2" vid="AMO 5:10">baleebwile olia aliwalanda kisinka.<verse eid="AMO 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />Mulimwaabiibikizia bapabi,</para>
  <para style="q2" vid="AMO 5:11">ni kubeebila buzombozi mu kusonkia musonko.</para>
  <para style="q1" vid="AMO 5:11">Ni pakako, anzia kine mwaakuulile nghanda ya mabue,</para>
  <para style="q2" vid="AMO 5:11">temukeekalamo.</para>
  <para style="q1" vid="AMO 5:11">Anzia kine mwaalimine bukaba bwa mizabibu,</para>
  <para style="q2" vid="AMO 5:11">temukamina divai ya mizabibu.<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />Pantu n'manine vivulile bilubo byenu</para>
  <para style="q2" vid="AMO 5:12">ni vitanine bibalo byenu.</para>
  <para style="b" vid="AMO 5:12" />
  <para style="q1" vid="AMO 5:12">Mulimwaemia bantu basili na kilubo ni kupoka bituulilo,</para>
  <para style="q2" vid="AMO 5:12">kabili mulimwatana bapabi nsambu mu kilie.<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />Ni pakako, olia akengeele aliwatalala pa musita nga ozo,</para>
  <para style="q2" vid="AMO 5:13">pantu musita ubiipile.<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />Kite biweme, tekuba bibiipile,</para>
  <para style="q2" vid="AMO 5:14">evi mube ni bukose.</para>
  <para style="q1" vid="AMO 5:14">Ni Yawe Leza wa Maka onse waakaba pamo nenu</para>
  <para style="q2" vid="AMO 5:14">nga vimulimwalanda nangue pa-ali.<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />Suule bibiipile, tone biweme,</para>
  <para style="q2" vid="AMO 5:15">biike nsambu mu bilie.</para>
  <para style="q1" vid="AMO 5:15">Pange Yawe Leza wa Maka onse waakeeleela</para>
  <para style="q2" vid="AMO 5:15">bantu basyele bakosele ba mu luvyalo lwakua Yusufu.<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />Ni pakako, Mulopue Yawe Leza wa Maka onse walanda evi,</para>
  <para style="q1" vid="AMO 5:16">“Kwaakaba malilo mu misebo yonse,</para>
  <para style="q2" vid="AMO 5:16">kuloosia kwa bulanda mu kubalua kisaakaanino kya bantu.</para>
  <para style="q1" vid="AMO 5:16">Balimi baakakuutua kwiza kulila,</para>
  <para style="q2" vid="AMO 5:16">ni ba kuloosia bakeeza kuloosia.<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />Mu makaba onse a mizabibu mwaakaba malilo.</para>
  <para style="q2" vid="AMO 5:17">Pantu naakeeza kupita pakati kenu,”</para>
  <para style="q2" vid="AMO 5:17">koku i kulanda kwakua Yawe.<verse eid="AMO 5:17" /></para>
  <para style="s1">Busiku bwakua Yawe</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />Lisyamo kuli mwe balibatokamua</para>
  <para style="q2" vid="AMO 5:18">busiku bwakua Yawe.</para>
  <para style="q1" vid="AMO 5:18">Mulimwatokaminuaki busiku bwakua Yawe?</para>
  <para style="q2" vid="AMO 5:18">Bobo busiku bwaakaba nfinzi, tekuba kisue.<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />Kyaakaba nga muntu wabutuka nkalamu,</para>
  <para style="q2" vid="AMO 5:19">wasaakaana na kimbui,</para>
  <para style="q1" vid="AMO 5:19">wapanda ku kimbui, waingila mu nghanda yakue, ni kukikilizia kuboko kwakue ku kibumba,</para>
  <para style="q2" vid="AMO 5:19">wasumua na nzoka.<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />Kubako busiku bwakua Yawe tebukaba nfinzi, pasili kuba kisue?</para>
  <para style="q2" vid="AMO 5:20">Kubako teikaba nfinzi ikata isili na minghenghe?<verse eid="AMO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5.21: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:11-14">Isa 1.11-14</ref>
      </char>
    </note>Yawe walanda nangue, “Nsuulile, ndeebwile nsikunkulu yenu ya mpupo,</para>
  <para style="q2" vid="AMO 5:21">nsiwamiinue na kulonghana kwenu.<verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />Anzia kili evio, mulimwandeetela ngelelo ya kuzizia ni bupe bwa bunga</para>
  <para style="q2" vid="AMO 5:22">nsikabipokelela.</para>
  <para style="q1" vid="AMO 5:22">Anzia kine mulimwaleeta bupe bwa mutende,</para>
  <para style="q2" vid="AMO 5:22">nsikabukentako. <verse eid="AMO 5:22" /><verse number="23" style="v" sid="AMO 5:23" />Lekele nsungu ya nghimbo yenu,</para>
  <para style="q2" vid="AMO 5:23">nsikatwilizia nghimbo ya bilimba byenu.<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />Inzi lekele nsambu ipongoke nga mwenzi,</para>
  <para style="q2" vid="AMO 5:24">bulunghami bube nga kaezi kasili kakama.<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5.25: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 7:42-43">Mii 7.42-43</ref>
      </char>
    </note>“Kubako mwe Baizraeli, mwandeeteele ngelelo ni bupe</para>
  <para style="q2" vid="AMO 5:25">mu kaseeba mu elia myaka 40?<verse eid="AMO 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26" />Mwakilendula kitale kyakua likolo wenu,</para>
  <para style="q2" vid="AMO 5:26">Sukoti kateeka leza wenu,</para>
  <para style="q2" vid="AMO 5:26">ni Kiuni leza wenu wa lutanda,</para>
  <para style="q2" vid="AMO 5:26">bamwaikitiile mwe bene.<verse eid="AMO 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27" />Ni pakako, naakamitwala mu kyalo kya buzia, kule kupita ku Damaski,”</para>
  <para style="q2" vid="AMO 5:27">koku i kulanda kwakua Yawe, ali ni Liina lya Leza wa Maka onse.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s1">Lisyamo ku bantu beketekeele</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1" />Lisyamo lyenu mwe bekeele bawamiinue mu Sayuni,</para>
  <para style="q2" vid="AMO 6:1">mwe beyunvwile mwali ni mutende pa Lupili lwa Samaria,</para>
  <para style="q1" vid="AMO 6:1">mwe bakindami ba mponvu pa ntundu yonse,</para>
  <para style="q2" vid="AMO 6:1">mwe baketekeelue na Baizraeli!<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />Endo mwaye mumone muzi wa Kalnehi,</para>
  <para style="q2" vid="AMO 6:2">muye mumone ni muzi ukata wa Hamati,</para>
  <para style="q2" vid="AMO 6:2">kabili muye mukookele ni ku Gati, muzi wa Bafilistini.</para>
  <para style="q1" vid="AMO 6:2">Ati, kubako ezi mizi yaali yawamiisie kukila bukolo bwenu bwa Yuda ni bwa Izraeli? Kubako, kyalo kyabo kyaali kyatanine kukila kyalo kyenu?<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />Mulimwalangakana kusyenia kule busiku bwa masanzo,</para>
  <para style="q2" vid="AMO 6:3">inzi mwalimukupalamika buteeko bwa kutiinia.<verse eid="AMO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />Kyaakamibiipila mwe bali balaala pa malita afwaniiziwe na meno a nzovu,</para>
  <para style="q2" vid="AMO 6:4">ni kuya mwaiyolwela pa bitebe bya mutengo.</para>
  <para style="q1" vid="AMO 6:4">Mwe balibalia munani wa misoka ya mikooko</para>
  <para style="q2" vid="AMO 6:4">pamo ni wa misoka ya nghombe itapukile.<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />Mwemue mulimwalizia binanda nga Daudi,</para>
  <para style="q2" vid="AMO 6:5">mulimwatunga nghimbo ni kulizia bilimba bilekenkeene.<verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />Mulimwaminina divai mu nsupa,</para>
  <para style="q2" vid="AMO 6:6">ni kusuba mafuta a bunu buweme ku mibili yenu.</para>
  <para style="q2" vid="AMO 6:6">Inzi temulimwaunvua nkumbu pa mulandu wa kwinoonua kwa luvyalo lwakua Yusufu.<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />Ni pakako, mwaakaba mwali mu bantu ba mambo kuya mu buzia.</para>
  <para style="q2" vid="AMO 6:7">Nsikunkulu yenu pamo ni kuwaminua byaakapua.<verse eid="AMO 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />Yawe Kabezya Mpungu, Yawe Leza mwine wa Maka onse walapa walanda nangue,</para>
  <para style="q1" vid="AMO 6:8">“Nsuulile kiitoni kyakua Yakobo,</para>
  <para style="q2" vid="AMO 6:8">nsuulile byubo byakue.</para>
  <para style="q1" vid="AMO 6:8">Muzi ni kubalua kantu kalimo,</para>
  <para style="q2" vid="AMO 6:8">naakapeela balwani babo.”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />Kine mu nghanda imo mwaakasyala bantu lyanondo, ni bo kumo baakafua. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />Kabili kine muntu wa mu lupua lwa babo bafwile waiza kufumia mibili yabo mu nghanda kuti aye azizie, kine muli muntu wapandanga, wasyele wakosele mu muputule wa nghanda, ozo muntu wa mu lupua lwabo alikumwipuzia nangue, “Ewe, ulimo ni unge muntu akosele?” Kine walanda nangue, “Temuli,” alikumwana evi, “Talala! Fwefue tetupalile kuzimbula Liina lyakua Yawe.”<verse eid="AMO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11" />Pantu Yawe wakifumia mwano,</para>
  <para style="q2" vid="AMO 6:11">wene wakaba kutuuta nghanda ikata bibazu bibazu,</para>
  <para style="q2" vid="AMO 6:11">ni iniini kutuuta tuniini tuniini.<verse eid="AMO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />Ati, kubako farasi kuti wakunduka pa myalala?</para>
  <para style="q2" vid="AMO 6:12">Ati, kubako muntu kuti walima na nghombe pa myalala?</para>
  <para style="q1" vid="AMO 6:12">Inzi mwemue mwa-alwile nsambu kuba bwimba,</para>
  <para style="q2" vid="AMO 6:12">ni mazabo a bulunghami kuba bwimba bululile.<verse eid="AMO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13" />Mwe balibawaminua kwanziwa kwa muzi wa Lo-debari<note caller="+" style="f"><char style="fr" closed="false">6.13 </char><char style="fq" closed="false">Lo-debari</char><char style="ft" closed="false">: Leli liina lililyaunvwika nga lya mu Kiebrania i kulanda nangue “mpuni,”</char></note></para>
  <para style="q2" vid="AMO 6:13">ni kulanda nangue, “Kubako tetwakikwata muzi wa Karnaimu<note caller="+" style="f"><char style="fr" closed="false">6.13 </char><char style="fq" closed="false">Karnaimu</char><char style="ft" closed="false">: Liina lya ozu muzi uniini i kulanda nangue “masengo,” kilangililo kya maka</char></note> na maka etu fwe bene?”<verse eid="AMO 6:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />Pantu Yawe Leza wa Maka onse walanda evi,</para>
  <para style="q2" vid="AMO 6:14">“Nakaba kulengia ntundu ikabe kumyalukila mwe nghanda yakua Izraeli.</para>
  <para style="q1" vid="AMO 6:14">Ni yo yakaba kumyemia</para>
  <para style="q2" vid="AMO 6:14">kutendekela ku Lebo Hamati ku nkungua mpaka ku Lulambe lwa Araba ku mboosi.”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s1">Bimonua byakua Amosi</para>
  <para style="s1">Kimonua kya mambo: Luzie</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />Keki i kintu kinaalangisiiziwe na Yawe Kabezia Mpungu. Naamumwene walimukuteania bisepe bya luzie pa kyamba kya kuzombola buzombozi bwakua likolo pa musita waali wamenenapo binge bilimbua. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />Luzie palwaali lwalimukulia bilimbua byonse bya mu makaba, na-angwile nalanda nangue, “We Yawe Kabezia Mpungu eleela bantu bobe! Kubako Yakobo alikutwalilila syani kuba mukose? Wene akilile kukeepa!”<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />Ni pakako, Yawe wa-alwile malanga akue.</para>
  <para style="p" vid="AMO 7:3">Yawe waalandile evi, “Keki tekikaba kukitika.”<verse eid="AMO 7:3" /></para>
  <para style="s2">Kimonua kya bubili: Mulilo</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />Kintu kinaalangisiiziwe na Yawe Kabezia Mpungu ni keki: Yawe Kabezia Mpungu waali wakuuta bupinguzi bwa mulilo, ni ozo mulilo waakamiizie lyezi ni kwinoona kyalo. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />Kabili wa-angwile, “We Yawe Kabezia Mpungu, napaapaata tekukita evio! Kubako Yakobo alikutwalilila syani kuba mukose? Wene akilile kukeepa!”<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />Ni pakako, Yawe wa-alwile malanga akue.</para>
  <para style="p" vid="AMO 7:6">Yawe Kabezia Mpungu waalandile evi, “Keki tekikaba kukitika.”<verse eid="AMO 7:6" /></para>
  <para style="s2">Kimonua kya butatu: Kalingo ka kuolwelako</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />Kinaalangisiiziwe na Yawe mu kimonua ni keki: Yawe waali waimeene mumbali kibumba kyaali kyakuulua na kalingo ka kuolwelako, wakwete ni lukamba lwa kalingo ka kuolwelako mu minue yakue. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />Yawe wangipuziizie nangue, “Ati Amosi, umweneki?”</para>
  <para style="p" vid="AMO 7:8">Naamwasukile, “Lukamba lwa kalingo ka kuolwelako.”</para>
  <para style="p" vid="AMO 7:8">Kabili Yawe waalandile evi, “Mona ndimukubiika kalingo ka kuolwelako pa bantu bane Baizraeli. Nene nsikikaba kubeeleela.<verse eid="AMO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9" />“Nkendo ya mukinzi iliyapupilapo ba mu luvyalo lwakua Izaaki yaakeenoonua,</para>
  <para style="q2" vid="AMO 7:9">Ni pa bifuka bizuuke bilibyapupilapo Baizraeli paakeenoonua. Naakeepaya ba mu nghanda yakua Yeroboamu.”<verse eid="AMO 7:9" /></para>
  <para style="s1">Kabika Amosi ni kitambua Amazia.</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />Kupwako, Amazia kitambua wa ku Beteli watuma mpunda kuli Yeroboamu likolo wa Baizraeli walanda nangue, “Amosi alimukukuleetela bukankobenkania mu Baizraeli. Twebo twakue twakaba kwinoona kyalo.” <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />Pantu evi i vilimukulanda Amosi.</para>
  <para style="q1" vid="AMO 7:11">“Yeroboamu waakeepawa ku bului.</para>
  <para style="q2" vid="AMO 7:11">Kisinka Baizraeli baakatwalua mu buzia,</para>
  <para style="q2" vid="AMO 7:11">kule ni kyalo kyabo.”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />Pa kyamba Amazia waamwanine Amosi nangue, “Fuma papa we mumoni! Bwelela mu kyalo kya Yudea, uye ubikwile koko ni kupeeluako bilio. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />Tekutwalilila kubikula mu Beteli pantu papa pazuukile, kabili i nkendo iliyapupilapo likolo.”<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />Amosi waamwasukile Amazia nangue, “Nene nsyaalipo kabika ao mwina kabika, inzi naali musungi wa nama ni ndabukizi wa bimuti bya miku.” <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />Inzi Yawe wanfumiizie ku mwilo wa busungi bwa nama ni kunghana nangue, “Endo ubikwile bantu bane, Baizraeli.” <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />Ale kansi unvua keebo kakua Yawe we aliwalanda nangue,</para>
  <para style="q1" vid="AMO 7:16">“Tekubikwila Baizraeli,</para>
  <para style="q2" vid="AMO 7:16">kabili tekusimikila ba mu luvyalo lwakua Izaaki.”<verse eid="AMO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 7:17" />“Ni pakako, Yawe walanda evi,</para>
  <para style="q1" vid="AMO 7:17">‘Mukazi obe wakaba kwaluka mukambue mu muzi,</para>
  <para style="q2" vid="AMO 7:17">baana bobe, balalume ni banakazi, bakaba kwipawa ku bului.</para>
  <para style="q1" vid="AMO 7:17">Bukaba bobe bwakaba kulingua ni kuputulaniiwa.</para>
  <para style="q2" vid="AMO 7:17">Ni we wakaba kufwila mu kyalo kya Bazima.</para>
  <para style="q1" vid="AMO 7:17">Baizraeli ni bo kisinka bakaba kuya kuteekua buzia mu kyalo kyeni,</para>
  <para style="q2" vid="AMO 7:17">kule ni kyalo kyabo.’”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s1">Kimonua kya kipanda kilimo mazabo.</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />Yawe Kabezia Mpungu wanangisiizie kinge kimonua kinaamwenemo kipanda kilimo mazabo apiile. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />Yawe wangipuziizie evi, “Ati Amosi, umweneki?”</para>
  <para style="p" vid="AMO 8:2">Na-asukile nangue, “Kipanda kilimo mazabo apiile.”</para>
  <para style="p" vid="AMO 8:2">Yawe i lu-anghanine, “Musita wa kukaana kweleela bantu bane wakumana.”<verse eid="AMO 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3" />Yawe Kabezia Mpungu walanda evi, “Mu bobo busiku nghimbo mu Nghanda yakua Leza yaakaaluka nghimbo ya malilo. Mibili ingi mu nkendo ingi yaakaba yapoozua sie tondolo!”<verse eid="AMO 8:3" /></para>
  <para style="s1">Leza waakakanda Izraeli</para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />Unvue mwe balibabiibikizia bantu babuliilue,</para>
  <para style="q2" vid="AMO 8:4">ni kuluvia bapabi ba mu kyalo.<verse eid="AMO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5" />Mwemue mulimwalanda evi,</para>
  <para style="q1" vid="AMO 8:5">“Kubako kubaluka kwa kwezi kwakaba kupua musitaki pakuti tukabe kusisia mbezu?</para>
  <para style="q2" vid="AMO 8:5">Sabata ni yo yakaba kupua musitaki pakuti tukabe kusisia nghano?”</para>
  <para style="q1" vid="AMO 8:5">Mulimwakeefia tulingo,</para>
  <para style="q2" vid="AMO 8:5">mulimwasezia mutengo,</para>
  <para style="q2" vid="AMO 8:5">mulimwapompola na kalingo ka bufi,<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />mulimwasita mupabi na mutofue,</para>
  <para style="q2" vid="AMO 8:6">abuliilue ni ye mulimwamusita na mpe imo ya nkwabilo,</para>
  <para style="q2" vid="AMO 8:6">mulimwasisia nghano mwabikiliilemo ni busapia.<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />Yawe, bwitanko bwakua Yakobo, wakilapa mu Liina lyakue walanda nangue, “Nsikalaba kubalua kantu kabakita.<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />“Kubako kyalo tekikasunkaana palua ozu mulandu,</para>
  <para style="q2" vid="AMO 8:8">ni bantu bekeelemo tebakaloosia?</para>
  <para style="q1" vid="AMO 8:8">Kyalo kyalingi kyaakatungupila nga Mwenzi wa Nile.</para>
  <para style="q2" vid="AMO 8:8">Kyaakatuulama ni kukooka nga mabimbi a mwenzi wa ku Misri.<verse eid="AMO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9" />“Yawe Kabezia Mpungu walanda nangue,</para>
  <para style="q1" vid="AMO 8:9">“Mu bobo busiku waakalengia busiku kwila koba kali pakati mutue,</para>
  <para style="q2" vid="AMO 8:9">ni kukupa kyalo na nfinzi koba kaseeme.<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />Naakaalula nsikunkulu ya mpupo yenu kuba ndoosio,</para>
  <para style="q2" vid="AMO 8:10">ni nghimbo yenu yonse kuba nghimbo ya malilo.</para>
  <para style="q1" vid="AMO 8:10">Naakamilengia mwe bonse kuvwala masaaka,</para>
  <para style="q2" vid="AMO 8:10">ni kumitebula kakuuzu ku mitue yenu.</para>
  <para style="q1" vid="AMO 8:10">Ozo musita naakaukita kuba nga musita wa kuloosia mwana lyonga,</para>
  <para style="q2" vid="AMO 8:10">ni mpeleezio ya bobo busiku yaakaba yakilile kubiipa.<verse eid="AMO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />“Yawe Kabezia Mpungu walanda evi, ‘Nsiku ilimukwiza,</para>
  <para style="q2" vid="AMO 8:11">lunaakatuma nzala pa kyalo.</para>
  <para style="q1" vid="AMO 8:11">Teikaba nzala ya bilio ao kyaka kya menda,</para>
  <para style="q2" vid="AMO 8:11">inzi yaakaba nzala ya kunvua keebo kakua Yawe.<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />Bantu baakaba basakaana kufuma ku Lyezi lya Mukele kuya ku Lyezi lya Mediterania,</para>
  <para style="q2" vid="AMO 8:12">ni kupitaana kufuma ku nkungua kuya ku kabanga,</para>
  <para style="q1" vid="AMO 8:12">balimukukeba keebo kakua Yawe,</para>
  <para style="q2" vid="AMO 8:12">inzi tebakakasanga.’<verse eid="AMO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 8:13" />Mu bobo busiku,</para>
  <para style="q1" vid="AMO 8:13">bakazyana baweme ni balumendo ba maka,</para>
  <para style="q2" vid="AMO 8:13">baakapenzuka na kyaka.<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />Balia balibalapa mu meena a mikisi ya ku Samaria,</para>
  <para style="q2" vid="AMO 8:14">balia balibalanda nangue, ‘Mu liina lyakua leza mukose wa ku Dani,’</para>
  <para style="q2" vid="AMO 8:14">ao nangue, ‘Mu liina lyakua leza mukose wa ku Bersheba,’</para>
  <para style="q2" vid="AMO 8:14">baakapona pasili kubuuka.”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s1">Bupinguzi bwakua Yawe</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />Naamwene Yawe waimeene mumbali kitale. Waalandile nangue,</para>
  <para style="q1" vid="AMO 9:1">“Uma ku bisulo,</para>
  <para style="q2" vid="AMO 9:1">evi mapumpu atente.</para>
  <para style="q1" vid="AMO 9:1">Biponiizie pa mitue ya bantu bonse.</para>
  <para style="q2" vid="AMO 9:1">Ni balia baakasyalapo naakabeepaya na kipanga.</para>
  <para style="q1" vid="AMO 9:1">Tekuli muntu waakabutuka.</para>
  <para style="q2" vid="AMO 9:1">Tekuli waakapanda.<verse eid="AMO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />Anzia beimbila nzila ya kuya kumbo,</para>
  <para style="q2" vid="AMO 9:2">nakaba kubafumiamo na kuboko kwane.</para>
  <para style="q1" vid="AMO 9:2">Anzia basela mu myulu,</para>
  <para style="q2" vid="AMO 9:2">nakaba kubakoosiizia pansi.<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />Anzia befiika peulu lupili lwa Karmeli,</para>
  <para style="q2" vid="AMO 9:3">nakaba kubakeba ni kubakwata.</para>
  <para style="q1" vid="AMO 9:3">Anzia banfyama kwinsina lyezi,</para>
  <para style="q2" vid="AMO 9:3">nakaba kwana kizoka kikabe kubasumina koko kwenka.<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />Anzia batwalua ku buzia na balwani babo,</para>
  <para style="q2" vid="AMO 9:4">nakaba kulengia bakeepailue koko kwenka.</para>
  <para style="b" vid="AMO 9:4" />
  <para style="q1" vid="AMO 9:4">“Nakaba kuya nabakenteleele na menso ane,</para>
  <para style="q2" vid="AMO 9:4">pakuti n'mbakitile bibiipile tekuba biweme.”<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />Mulopue, Yawe wa Maka onse aliwakumia kyalo, ni kyo kilikyasunguluka.</para>
  <para style="q2" vid="AMO 9:5">Bonse bekeelemo balibaloosia.</para>
  <para style="q1" vid="AMO 9:5">Kyalo kyalingi kilikyalenduka ni kukooka nga mabimbi a Mwenzi wa Nile.</para>
  <para style="q2" vid="AMO 9:5">Ni pa kyamba kilikyakooka nga mabimbi a mwenzi wa ku Misri.<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />Ozu Yawe aliwakuula nghanda yakue ya bukolo mu myulu</para>
  <para style="q2" vid="AMO 9:6">ni aliwaimika biputa byakue pa kyalo,</para>
  <para style="q1" vid="AMO 9:6">ozu aliwakuuta menda a mu lyezi</para>
  <para style="q2" vid="AMO 9:6">ni aliwa-etila pa kyalo,</para>
  <para style="q2" vid="AMO 9:6">Liina lyakue ni Yawe.<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7" />Yawe waipuzia evi, “Mwe Baizraeli!</para>
  <para style="q2" vid="AMO 9:7">Kubako nsimipendele nga vin'mpendele bantu ba ku Etyopia?”<note caller="+" style="f"><char style="fr" closed="false">9.7 </char><char style="fq" closed="false">Etyopia</char><char style="ft" closed="false">: Leli liina mu Kiebrania ikulanda nangue Kushi</char></note></para>
  <para style="q1" vid="AMO 9:7">“Kubako te nene waamifumiizie mu Misri?</para>
  <para style="q2" vid="AMO 9:7">Te nene waafumiizie Bafilistini ku Kaftori?</para>
  <para style="q2" vid="AMO 9:7">Te nene waafumiizie Bashamu ku Kiri?<verse eid="AMO 9:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />“Kisinka menso ane ne Yawe Kabezia Mpungu,</para>
  <para style="q2" vid="AMO 9:8">akentele pa bukolo bwa bibalo.</para>
  <para style="q1" vid="AMO 9:8">Nakaba kubwinoona pa kyalo,</para>
  <para style="q2" vid="AMO 9:8">inzi nsikeenoona nvyalo yonse yakua Yakobo,”</para>
  <para style="q2" vid="AMO 9:8">koku i kulanda kwakua Yawe.<verse eid="AMO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />“Pantu naakafumia nsambu ya kuuluzia Baizraeli pa ntundu yonse,</para>
  <para style="q2" vid="AMO 9:9">naakabauluzia nga nghano iliyauluziiwa mu kipanda.</para>
  <para style="q2" vid="AMO 9:9">Tekuli lubezu lwa nghano lwaakaponena pansi.<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />Bantu bonse ba bibalo pa bantu bane,</para>
  <para style="q2" vid="AMO 9:10">baakeepawa na kipanga,</para>
  <para style="q1" vid="AMO 9:10">balia bonse balibalanda nangue,</para>
  <para style="q2" vid="AMO 9:10">‘Tetukasanzua.’<verse eid="AMO 9:10" /></para>
  <para style="s1">Kuwamiwa paakale pa kyamba kya kwinoonua</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9.11: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 15:16-18">Mii 15.16-18</ref>
      </char>
    </note>“Mu bobo busiku</para>
  <para style="q1" vid="AMO 9:11">“naakabwezia nghanda iponene yakua Daudi,</para>
  <para style="q2" vid="AMO 9:11">naakawamia palia penoonekele,</para>
  <para style="q2" vid="AMO 9:11">naakeemika paakale bituuti byakue,</para>
  <para style="q2" vid="AMO 9:11">naakakuula paakale nga viyaali pa mambo,<verse eid="AMO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12" />evi Baizraeli bakapoke nkendo yaasyeleko mu kyalo kya Edomu,</para>
  <para style="q2" vid="AMO 9:12">pamo ni ntundu yane yonse,”</para>
  <para style="q2" vid="AMO 9:12">koku i kulanda kwakua Yawe ozo waakakita bebi bintu.<verse eid="AMO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13" />Yawe walanda evi,</para>
  <para style="q1" vid="AMO 9:13">“Nsiku ilimukwiza, muzombozi lu-aliwaakaba wakitwaliile kuzombola</para>
  <para style="q2" vid="AMO 9:13">musita wa kulima wasyafikile,</para>
  <para style="q1" vid="AMO 9:13">ni aliwatika mizabibu lu-aliwaakaba wakitwaliilile kutika musita wa kulimba wasyafikile,</para>
  <para style="q1" vid="AMO 9:13">mpili yaakatoonia divai ya lenu,</para>
  <para style="q2" vid="AMO 9:13">ni tupili ni to twaakaipongola.<verse eid="AMO 9:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 9:14" />Naakafumia bantu bane, Baizraeli, mu buzia ni kubabwezia.</para>
  <para style="b" vid="AMO 9:14" />
  <para style="q1" vid="AMO 9:14">“Baakakuula paakale mizi ituutikile ni kwikalamo.</para>
  <para style="q2" vid="AMO 9:14">Baakalimba mizabibu ni kuminako divai.</para>
  <para style="q2" vid="AMO 9:14">Baakalima makaba ni kulia bibaakabyalamo.<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />Naakalimba Izraeli mu kyalo kyakue,</para>
  <para style="q2" vid="AMO 9:15">kabili tekuli muntu waakamunukula mu kyalo kinaamupeele,”</para>
  <para style="q2" vid="AMO 9:15">koku i kulanda kwakua Yawe Leza wenu.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>