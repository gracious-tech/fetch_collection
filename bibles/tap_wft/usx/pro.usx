<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">TA20.SFM 11/11/2007 MK FREDERICK. FIRST DRAFT KITAABUA LUBUMBASHI D.R.C</book>
  <para style="h">MAPINDA</para>
  <para style="toc1">Kitabu Kya Mapinda</para>
  <para style="toc2">Mapinda</para>
  <para style="toc3">Map</para>
  <para style="mt2">KITABU KYA</para>
  <para style="mt1">MAPINDA</para>
  <para style="imt">BULONDOLOZI</para>
  <para style="im">
    <char style="bk">Kitabu kya Mapinda</char>ni mukolonghano wa bulanzi bwa mulangue wakua Solomoni. Bakalemba bengi ba-ampeene nakue ni kulundapo mapinda, inzi Likolo Solomoni mwana mwalalume mwina likolo Daudi i waalembelemo mapinda engi. Solomoni waali wamanikile pa mulandu wa mulangue wakue, ni 1 Makolo 4.32 mulandile nangue Solomoni waalembele mapinda 3,000. Ni pakako, twebo twingi twa mu keki kitabu kya mapinda twaalembelue Solomoni lu-aali wakikosele mu elia myaka 1,000 NK. Tunge twebo twa mu keki kitabu, tuli nga twaali twalembua ni kukolonghaniiwa pa musita waali wateeka Hezekia mu kyalo kya Yudea kutula mu mwaka wa 715 kwita mwaka wa 686 NK (Mapinda 25.1).</para>
  <para style="ip">Mapinda, ni bulanzi bwa mulangue buli ni kisinka kiinekiine, inzi bupuseneko ni bulayo ao bukabika. Kipalo, Mapinda 22.6 mulandile nangue Sambilizia mwana nzila i apalile kukonka, pantu anzia akakota takafumamo. Anzia kili evio, aza mapinda te bulayo bwakwana nangue tekuli kintu kisikavinda kukitika ao kwinooneka mu bwikazi bwa mwana waakuziiziwe mu nzila ipalile. Ni pakako, aza mapinda ni nsokezi iweme imaniine pa bintu bya kisinka. Kitabu kiine kya Mapinda kilandile kikata kya mapinda mu katue ka 1.2-6. Kikata kya aza mapinda ni kukwasia babipuba ni balumendo kuti baye bali ni mulangue, ni nsokezi iweme pamo ni kulengia balia bali ni mulangue bakile kuba ni mulangue.</para>
  <para style="iot">Bwipi bwa bili mu kitabu kya Mapinda</para>
  <para style="io1">1. Mu katue ka 1 kwita mu katue ka 22.16, ni mapinda akua Solomoni.</para>
  <para style="io1">2. Mu katue ka 22.17 kwita mu katue ka 24, ni mikolonghano ibili ya twebo twa mulangue.</para>
  <para style="io1">3. Mu katue ka 25 kwita mu katue ka 29, ni mukolonghano wa unge wa mapinda akua Solomoni. Aza mapinda aakolonghaniziwe na babombi bakua likolo Hezekia.</para>
  <para style="io1">4. Mu katue ka 30 muli bulanzi bwakua Aguri.</para>
  <para style="io1">5. Mu katue ka 31.1-9 muli bulanzi bwakua Lemueli.</para>
  <para style="io1">6. Mu katue ka mpeleezio 31.10-31 mulondolwelue palua mukazi ali ni mibeele iweme.</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s1">Kikata kya Mapinda</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1.1: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 4:32">1 Mak 4.32</ref>
      </char>
    </note>Mapinda akua Solomoni likolo wa Baizraeli, mwana mwina Daudi.<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />Aza mapinda i alialengia muntu kuba ni mulangue pamo ni masambilizio,</para>
  <para style="q2" vid="PRO 1:2">ni kumana ndubulwilo ya mukati,<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />Pamo ni kumusambilizia bikitua bya mulangue,</para>
  <para style="q2" vid="PRO 1:3">ni bya bulunghami, ni bya nsambu pamo ni biweme.<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />Kabili i aliapeela babipuba mulangue,</para>
  <para style="q2" vid="PRO 1:4">ni kupeela balumendo maano ni bukengezi,<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />Evi wa mulangue onvue ni kulundiluapo masambilizio,</para>
  <para style="q2" vid="PRO 1:5">akile kuya wali ni mulangue pamo ni nsokezi iweme,<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />Pakuti enike mapinda pamo ni bipalo,</para>
  <para style="q2" vid="PRO 1:6">ni kwinika bulanzi bwa balia bali ni mulangue pamo ni bitandiko byabo.<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1.7: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 28:28">Yob 28.28</ref>; <ref loc="PSA 111:10">Mlb 111.10</ref>; <ref loc="PRO 9:10">Map 9.10</ref></char>
    </note>Kumutiina Yawe i ntendeko ya maano,</para>
  <para style="q2" vid="PRO 1:7">inzi babipuba balibafuupula mulangue ni masambilizio.<verse eid="PRO 1:7" /></para>
  <para style="s1">Nsokezi ku balumendo</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />We mwana wane, unvua masambilizio akua so,</para>
  <para style="q2" vid="PRO 1:8">kabili tekufuupula mafunde akua noko.<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />Pantu alikuya ali ngala ya buwame ku mutue obe,</para>
  <para style="q2" vid="PRO 1:9">kabili nga mikufu mu mukosi obe.<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />We mwana wane, kine wabembua na bantu ba bibalo,</para>
  <para style="q2" vid="PRO 1:10">tekwitabila.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Kine balanda nangue, “Iza tuye nobe,</para>
  <para style="q2" vid="PRO 1:11">tuye tufyaminepo muntu umo asili na mulandu ni kumwipaya,<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />Tuye tubateleke bakosele nga vilivyateleka kilibu,</para>
  <para style="q2" vid="PRO 1:12">tubateleke balingi nga balia balibakookela mu kiina.<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />Tulikusanga bunonsi bonse bwa mponvu,</para>
  <para style="q2" vid="PRO 1:13">tulikwizuzia nghanda yetu na bintu bitulikupoka.<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />Ale iza wampane ni fwefue,</para>
  <para style="q2" vid="PRO 1:14">byonse bitulikupoka tulikukasana.”<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />We mwana wane, tekuba waenda pamo nabo,</para>
  <para style="q2" vid="PRO 1:15">kaania lukasa lobe tekuti luye lwapita molia mubalibapita.<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />Pantu makasa abo aliakundukila ku bubi,</para>
  <para style="q2" vid="PRO 1:16">kabili tebezi kukokola kuzuumia mulopa.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Pantu bukila bulibwateiwa tooni twamwene,</para>
  <para style="q2" vid="PRO 1:17">bwa mpuni.<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />Baba bantu balibabenza mulopa wabo bene,</para>
  <para style="q2" vid="PRO 1:18">balibafyamina bukose bwabo bene.<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Evi i vili mibeele ya bantu balibatokamua bunonsi bwa bupompo,</para>
  <para style="q2" vid="PRO 1:19">bupompo bulibwaputukizia bukose bwabo.<verse eid="PRO 1:19" /></para>
  <para style="s1">Mulangue wakuuta</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1.20: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 8:1-3">Map 8.1-3</ref>
      </char>
    </note>Mulangue aliwasamuna mu kisaakaanino kya bantu,</para>
  <para style="q2" vid="PRO 1:20">aliwasamuna lizui lyakue pa kisisiizio.<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />Aliwapunda mu mampetompeto,</para>
  <para style="q2" vid="PRO 1:21">pa milyango ya kwingililamo mu muzi, aliwalanda.<verse eid="PRO 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />“Mwe basili na maano! Mwaakaba mwatonenetonene sie kusiba na maano?</para>
  <para style="q2" vid="PRO 1:22">Mwe ba mufuupula! Mwaakaba mwawamiinuewamiinue sie kufuupula?</para>
  <para style="q2" vid="PRO 1:22">Mwe babipuba! Mwaakaba mwasuulilesuulile sie maano?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Pilibuke pa mulandu wa nsokezi yane.</para>
  <para style="q2" vid="PRO 1:23">Unvue, nene ndikumipongwela Mweo wane,</para>
  <para style="q2" vid="PRO 1:23">ndikumibwila masambilizio ane.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Inzi nakimikuuta, ni mwe mwakaana kwitaba,</para>
  <para style="q2" vid="PRO 1:24">nakimyolwela kuboko kwane, temwakipoozako maano,<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />Mwakipuulula nsokezi yane yonse,</para>
  <para style="q2" vid="PRO 1:25">ni kukaana mwano wane,<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />Ni nene wenka naakaseka pa musita wa busanzo bwenu,</para>
  <para style="q2" vid="PRO 1:26">naakamipunika musita waakeeza maavia,<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />Lubebue palukamifikila nga mwela ukata,</para>
  <para style="q2" vid="PRO 1:27">ni lwinoono palukamifikila nga mulula,</para>
  <para style="q2" vid="PRO 1:27">ni pamukafikilua na busanzo ni misa.<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />“Pabakankuuta, nsikaba-asuka.</para>
  <para style="q2" vid="PRO 1:28">Baakankeba inzi tebakan'mona.<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />Pantu bakisuula maano,</para>
  <para style="q2" vid="PRO 1:29">kabili pantu tebakisaakula kumutiina Yawe.<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />Bakisuula nsokezi yane,</para>
  <para style="q2" vid="PRO 1:30">bakifuupula mwano wane.<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />Ni pakako, bakaba kuya balia mazabo a mu bikitua byabo,</para>
  <para style="q2" vid="PRO 1:31">ni kwikuta nsokezi yabo bene.<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />Pantu misango ibi ya bupuba yaakabeepaya,</para>
  <para style="q2" vid="PRO 1:32">balia balibatwalilila mu bupuba, bwaakabeenoona.<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />Inzi muntu aliwantwilizia wakaba kuya waikeele mu mutende,</para>
  <para style="q2" vid="PRO 1:33">kabili wakaba kuya wateekameene pasili kutiina bibiipile.”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Kilambu kya mulangue</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />We mwana wane, kine waitabila twebo twane,</para>
  <para style="q2" vid="PRO 2:1">ni kusunga bwino mafunde ane mukati mobe,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />Pamo ni kuteya kutui kobe kuti kutwilizie mulangue,</para>
  <para style="q2" vid="PRO 2:2">ni kunvwisia mu mutima obe,<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />Kisinka kine wamukuuta mulangue,</para>
  <para style="q2" vid="PRO 2:3">ni kumana wamuzanzwila lizui,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />Kabili kine wabakeba nga mutofue,</para>
  <para style="q2" vid="PRO 2:4">ni kubakebelezia nga bukonto bufiikilue,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />I paulikumana vya kumutiina Yawe,</para>
  <para style="q2" vid="PRO 2:5">ni kwinika vya kumumana Leza.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />Pantu Yawe aliwapeela bantu mulangue,</para>
  <para style="q2" vid="PRO 2:6">mu kanua kakue mulimwafuma bukengezi ni kumana.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />Aliwabiikila balunghami bukonto,</para>
  <para style="q2" vid="PRO 2:7">wene i kisoolelo kya balia balibaenda mu kisinka.<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />Aliwalabukila nghendelo ya bantu balibakita bintu bya nsambu,</para>
  <para style="q2" vid="PRO 2:8">ni kusunga nzila ya bazuuke bakue.<verse eid="PRO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />Kine wewe wantwilizia ulikwinika bulunghami ni nsambu pamo ni kisinka.</para>
  <para style="q2" vid="PRO 2:9">Ulikwinika kubalua nzila iweme.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Pantu mulangue alikwingila mu mutima obe,</para>
  <para style="q2" vid="PRO 2:10">ni maano alikusansamusia bukose bobe.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />Kwinika kulikukusunga,</para>
  <para style="q2" vid="PRO 2:11">ni kumana kulikukulabukila.<verse eid="PRO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />Mulangue alikukupususia mu nzila ya babi,</para>
  <para style="q2" vid="PRO 2:12">ni ku bantu balibalanda twebo tubi.<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />Bantu balibasia nzila ilungi</para>
  <para style="q2" vid="PRO 2:13">pakuti bende mu nzila ya nfinzi,<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />Bantu balibawaminua kukita bibiipile,</para>
  <para style="q2" vid="PRO 2:14">ni kusansamukila mu bupompo bwa bubi,<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />Tusansaila twabo, ni twa mampetompeto,</para>
  <para style="q2" vid="PRO 2:15">ni nzila yabo teyololokele.<verse eid="PRO 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />Mulangue alikukupususia ku mwanakazi mukambue,</para>
  <para style="q2" vid="PRO 2:16">ku mwanakazi mweni ali ni twebo twa kubembia.<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />Mwanakazi aliwasia kibuza wa mu bukazyana bwakue,</para>
  <para style="q2" vid="PRO 2:17">ni kulaba kipingo kyakua Leza wakue.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />Kisinka nghanda yakue ilungi ku lufu,</para>
  <para style="q2" vid="PRO 2:18">ni ku bafwile i kulungheeme nzila yakue.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Bonse balibaya kuli wene, tepali aliwabwela,</para>
  <para style="q2" vid="PRO 2:19">ao kubwelela ku nzila ya bukose.<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Ni pakako upalile kuya waendela mu nzila ya bantu baweme,</para>
  <para style="q2" vid="PRO 2:20">ni kukonka mibeele ya balunghami.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Pantu balunghami baakeekala mu kyalo,</para>
  <para style="q2" vid="PRO 2:21">ni basili na kabi baakeekalililamo.<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />Inzi babi baakafumiiwa mu kyalo,</para>
  <para style="q2" vid="PRO 2:22">ni bankitatubi baakanukuluamo.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Kibwezia kya bulunghami</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />We mwana wane, tekuba walaba masambilizio ane,</para>
  <para style="q2" vid="PRO 3:1">inzi sunga milao yane mu mutima obe.<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />Pantu yakaba kuvuzia myaka ya bwikazi bobe,</para>
  <para style="q2" vid="PRO 3:2">ni kukupeela mutende ni buyantanzi.<verse eid="PRO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Ntono ni bukisinka tekuti bilekenkane nobe,</para>
  <para style="q2" vid="PRO 3:3">bikakilile mu mukosi obe,</para>
  <para style="q2" vid="PRO 3:3">bilembe pa kibao kya mu mutima obe.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3.4: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 2:52">Lk 2.52</ref>
      </char>
    </note>Ni we ulikwitabilua ni kumonua waweme</para>
  <para style="q2" vid="PRO 3:4">ku menso akua Leza ni ku menso a bantu.<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Muketekele Yawe na mutima obe onse,</para>
  <para style="q2" vid="PRO 3:5">pasili kusintilila pa maano obe we mwine.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />Mu nzila yobe yonse, mumane wene,</para>
  <para style="q2" vid="PRO 3:6">ni ye alikuolola nzila yobe.<verse eid="PRO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3.7: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:16">Bar 12.16</ref>
      </char>
    </note>Tekwimona we mwine kuba wali ni mulangue,</para>
  <para style="q2" vid="PRO 3:7">mutiine Yawe ni kwikeka ku bubi.<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Kukita evio kulikukuleetela bukose mu mubili,</para>
  <para style="q2" vid="PRO 3:8">ni maka mu bikuza byobe.<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Mukindike Yawe na bunonsi bobe,</para>
  <para style="q2" vid="PRO 3:9">mukindike na ntomono ya mu buzombozi bobe bonse.<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />Ni pakako, milue yobe yaakeezula,</para>
  <para style="q2" vid="PRO 3:10">ni mitondo yobe yaakeezulamo divai ya lenu.<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3.11: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:17">Yob 5.17</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:5-6">Bae 12.5-6</ref>
      </char>
    </note>We mwana wane, tekuleebula nsokezi yakua Yawe,</para>
  <para style="q2" vid="PRO 3:11">kabili tekutoobolua lu-aliwakusasilila.<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3.12: </char>
      <char style="xt" closed="false">
        <ref loc="REV 3:19">Nfy 3.19</ref>
      </char>
    </note>Pantu muntu atonenue na Yawe aliwasokua,</para>
  <para style="q2" vid="PRO 3:12">nga evelia mwana atonenue na se.<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Lisyuko ku mwalalume aliwasanga mulangue,</para>
  <para style="q2" vid="PRO 3:13">ni aliwainika.<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />Pantu mulangue akilile bunonsi bwa mutofue,</para>
  <para style="q2" vid="PRO 3:14">ni kibwezia kyakue kitanine kukila kibwezia kya oro.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />Mulangue ni wa mponvu kukila mabue a mutengo,</para>
  <para style="q2" vid="PRO 3:15">ni byonse biuliwakeba tebivinda kulinghaniwako.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Nsiku ingi ili mu kuboko kwakue kwa kulio,</para>
  <para style="q2" vid="PRO 3:16">ni mu kuboko kwakue kwa kuso i muli bunonsi ni mukinzi.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />Nzila yakue, i nzila ifwaniine,</para>
  <para style="q2" vid="PRO 3:17">ni tusansaila twakue tulungi ku mutende.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />Mulangue i kimuti kya bukose ku balia bamukwatiisie,</para>
  <para style="q2" vid="PRO 3:18">kabili i lisyuko ku onse atwaliliile kuba nakue.<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Kupitila mu mulangue, Yawe waabiikile biputa bya kyalo,</para>
  <para style="q2" vid="PRO 3:19">ni mu kumana waimikile myulu.<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />Mu kumana kwakue, biponga byaakasanikile,</para>
  <para style="q2" vid="PRO 3:20">ni kulengia malezi kutoonia lume.<verse eid="PRO 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />We mwana wane, tekulekeela mulangue ni maano kufuma pa ntanzi yobe,</para>
  <para style="q2" vid="PRO 3:21">kwatisia maano aweme pamo ni bukengezi.<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />Ni byo i bilikuya byali bukose bwa mutima obe,</para>
  <para style="q2" vid="PRO 3:22">ni bifwanizio bya mu mukosi obe.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />Ni pakako, ulikuya wali ni mutende mu nzila yobe,</para>
  <para style="q2" vid="PRO 3:23">ni kuulu kobe tekuya kwaipuutala.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Musita uwalaala, teuya wali na mwezo.</para>
  <para style="q2" vid="PRO 3:24">Ulikuona tulo twaweme.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Tekuya wali na mwezo wa lwinoono lwa kukutulumukila,</para>
  <para style="q2" vid="PRO 3:25">anzia kine kusanzua kwa babi kwaiza,<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />Pantu Yawe waya wali maswapi obe,</para>
  <para style="q2" vid="PRO 3:26">ni ye waya wasungile kuulu kobe tekuti kukwatue mu muteo.<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />Tekukaana kupeela kiweme ku bantu bapalile,</para>
  <para style="q2" vid="PRO 3:27">lu-ukili ni maka a kukita evio.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Tekumwana mwinobe nangue,</para>
  <para style="q2" vid="PRO 3:28">“Endo, ukeeze lukeele mane nkakupeele”</para>
  <para style="q2" vid="PRO 3:28">Koku kintu kya kumupeela wakwete.<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />Tekukitila mwinobe mapange abi,</para>
  <para style="q2" vid="PRO 3:29">olia ekeele waakuketekeele.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Tekusongela muntu pasili mulandu,</para>
  <para style="q2" vid="PRO 3:30">kine takitile kantu ka kukukisia.<verse eid="PRO 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Tekumwena bunkua muntu aliwakyuzyania,</para>
  <para style="q2" vid="PRO 3:31">ni pa nzila yakue tekusaakulapo ata imo.<verse eid="PRO 3:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />Pantu Yawe asuulile muntu aliwakita bibiipile,</para>
  <para style="q2" vid="PRO 3:32">inzi wene ni kibuza wa balia balibakita biweme.<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />Ntiipu yakua Yawe ili mu nghanda mwa mubi,</para>
  <para style="q2" vid="PRO 3:33">inzi Yawe aliwapaala nghanda ya mulunghami.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3.34: </char>
      <char style="xt" closed="false">
        <ref loc="JAS 4:6">Yak 4.6</ref>; <ref loc="1PE 5:5">1 Pet 5.5</ref></char>
    </note>Aliwafuupula balia bali ni mufuupula,</para>
  <para style="q2" vid="PRO 3:34">inzi aliwapeela buwame ku bekeefiizie.<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Bali ni mulangue balibapyana bulumba,</para>
  <para style="q2" vid="PRO 3:35">inzi babipuba balibamoniiwa busoni.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Kibwezia kya mulangue</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Mwe baana bane, unvue mafunde akua sinue,</para>
  <para style="q2" vid="PRO 4:1">kabili twilizie evi mube ni maano.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />Pantu ndimukumipeela mafunde aweme,</para>
  <para style="q2" vid="PRO 4:2">tekuti mukasie masambilizio ane.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Lunaali mwana mu nghanda yakua tawe,</para>
  <para style="q2" vid="PRO 4:3">nakili kalala, mwana lyonga wakua yangu.<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />Tawe waali wansambilizia walanda nangue,</para>
  <para style="q2" vid="PRO 4:4">“Mutima obe uye walanguluka twebo twane,</para>
  <para style="q2" vid="PRO 4:4">sunga milao yane, ni we ulikuya wali mukose.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />Ba wali ni mulangue, ba wali ni kyunvwila</para>
  <para style="q2" vid="PRO 4:5">tekulaba ao kukaana twebo twa mu kanua kane.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Tekumusia mulangue, ni ye alikukulabukila,</para>
  <para style="q2" vid="PRO 4:6">mutone, ni ye alikukusunga.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Ntendeko ya mulangue ni ezi: Ba wali ni mulangue.</para>
  <para style="q2" vid="PRO 4:7">Anzia uzeeziiziapo byonse bi-uli nabio, kya mponvu ba wali ni kyunvwila.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Mukindike, ni ye alikukukindika.</para>
  <para style="q2" vid="PRO 4:8">Kine wamukumbatila alikukukindika.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Alikukupeela buwame kuba kitambala ku mutue obe,</para>
  <para style="q2" vid="PRO 4:9">alikukufwanizia na ngala ya bulumba.”<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Twilizia we mwana wane, itabila bindimukulanda,</para>
  <para style="q2" vid="PRO 4:10">ni myaka ya bukose bobe ilikuvula.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Nakusambilizia nzila ya mulangue,</para>
  <para style="q2" vid="PRO 4:11">nakulombola mu tusansaila twa bulunghami.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Luuliwaenda, lutanfu lobe telukilinghaniiwa.</para>
  <para style="q2" vid="PRO 4:12">Kine wakunduka tewipuutala.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Kwatisia mafunde, pasili ku-aleka aye,</para>
  <para style="q2" vid="PRO 4:13">akwatisia, pantu ene i bukose bobe.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Tekwingila mu nzila ya babi,</para>
  <para style="q2" vid="PRO 4:14">tekukonka mibeele ya bantu babi.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Leya ezio nzila, kabili tekwendamo,</para>
  <para style="q2" vid="PRO 4:15">isie uye mu nzila yobe.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Pantu tebezi kulaala kine tebanakitenke bubi,</para>
  <para style="q2" vid="PRO 4:16">ni tulo tetwizi kuoneka kine tebanapuutazie muntu.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Pantu bubi i bilio byabo.</para>
  <para style="q2" vid="PRO 4:17">Nghemo ikata i divai yabo.<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Nzila ya balunghami ili nga kisue kya ku makia,</para>
  <para style="q2" vid="PRO 4:18">kilikyailundilako mpaka bwakiililila.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Inzi nzila ya babi ili nga nfinzi ikata,</para>
  <para style="q2" vid="PRO 4:19">ni kilikyabeepuutazia tebakimanine.<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />We mwana wane, pooza maano ku bindimukulanda,</para>
  <para style="q2" vid="PRO 4:20">teya kutui ku twebo twane.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Tekubifumia pa menso obe,</para>
  <para style="q2" vid="PRO 4:21">bisunge bwino mu mutima obe.<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />Pantu i bukose ku muntu aliwabisyukila.</para>
  <para style="q2" vid="PRO 4:22">Kabili i kutuuka kwa mubili wakue onse.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />Sunga mutima obe kukila byonse biuliwasunga,</para>
  <para style="q2" vid="PRO 4:23">pantu i mulimwafuma byonse bi-uliwakita.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Sunga kanua kobe ku twebo twa bukisanguka,</para>
  <para style="q2" vid="PRO 4:24">ni milomo ya kiitoni ibe kule ni wewe.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Menso obe akente ku ntanzi,</para>
  <para style="q2" vid="PRO 4:25">ni nkopio yobe pasili kukapa.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4.26: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:13">Bae 12.13</ref>
      </char>
    </note>Pooza maano mulimwapita makasa obe,</para>
  <para style="q2" vid="PRO 4:26">ni nzila yobe yonse iwamiiwe bwino.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Tekupilibukila kulio ao kuso,</para>
  <para style="q2" vid="PRO 4:27">fumia kuulu kobe mu bubi.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Nsokezi palua bukambue</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />We mwana wane, unvua mulangue wane,</para>
  <para style="q2" vid="PRO 5:1">teya kutui ku twebo twa maano.<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />Evi uye wavinda kwinika biweme,</para>
  <para style="q2" vid="PRO 5:2">ni milomo yobe isunge maano.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Pantu milomo ya mwanakazi mukambue, iliyatoonia kapelo,</para>
  <para style="q2" vid="PRO 5:3">ni bulanzi bwakue buteleele kukila mafuta.<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />Inzi mpeleezio ya bulanzi bwakue ilulile kukila kimuti kiluliisie,</para>
  <para style="q2" vid="PRO 5:4">ni kunooneka nga kipanga kya mindyakubili.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Makasa akue alimukuya akookela ku lufu,</para>
  <para style="q2" vid="PRO 5:5">ntanfu yakue ilungi kumbo.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Kabili tasakameene nzila ya bukose.</para>
  <para style="q2" vid="PRO 5:6">Nzila yakue ipotonkeene, kabili taimanine.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Ni pakako, mwe baana bane ntwilizie,</para>
  <para style="q2" vid="PRO 5:7">kabili tekufume mu bindimukulanda.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Nzila yobe ilekenkane kule ni wene,</para>
  <para style="q2" vid="PRO 5:8">kabili tekupalamina ku mulyango wa nghanda yakue.<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />Ukeeza kupeela bange mukinzi obe,</para>
  <para style="q2" vid="PRO 5:9">ni myaka yobe ku balia basili na nkumbu.<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />Baeni bakeeza kwikusiiwa na maka obe,</para>
  <para style="q2" vid="PRO 5:10">ni miilo yobe ikeeza kuya yali mu nghanda mwa mweni.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />Ku mpeleezio ya bukose bobe waakaloosia,</para>
  <para style="q2" vid="PRO 5:11">musita waakeenoonua munofu ni mubili obe.<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Waakalanda nangue, “Ale naasuuliileki masambilizio?</para>
  <para style="q2" vid="PRO 5:12">Ale naafuupwiliileki nsokezi?<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Nsyaanakiile bakasambilizia bane,</para>
  <para style="q2" vid="PRO 5:13">ni kubatwilizia balia balibanfunda!<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Naali nasyaumiine kwingila mu bwavia bukata,</para>
  <para style="q2" vid="PRO 5:14">mu libumba lya bantu bakua Leza.”<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Mina menda a mu nsupa yobe we mwine,</para>
  <para style="q2" vid="PRO 5:15">menda aliapita lubilo kufuma mu kiina kyobe we mwine.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Ale tusulo tobe twa menda tulikusalanghaninaki mu misebo?</para>
  <para style="q2" vid="PRO 5:16">Ni twezi twa menda kuya kiyeyeye?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Aye ali sie obe we bunke,</para>
  <para style="q2" vid="PRO 5:17">pasili kupeelako baeni.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Kasulo kobe kapaalue,</para>
  <para style="q2" vid="PRO 5:18">kabili uwaminue na mukazi wa mu bulumendo bobe,<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />Aweme nga nswala, ni kufwanina nga kasia,</para>
  <para style="q2" vid="PRO 5:19">mabeele akue aye akuwamiine nsiku yonse,</para>
  <para style="q2" vid="PRO 5:19">kabili uye wawamiinue nsiku yonse mu ntono yakue.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Ale ni kiki kilikukulengia we mwana wane kuti uwaminue na muka nghwana?</para>
  <para style="q2" vid="PRO 5:20">Ale ni kiki kilikukulengia kukumbatila nkulo ya mwanakazi mukambue?<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Pantu nzila yobe ili ku menso akua Yawe,</para>
  <para style="q2" vid="PRO 5:21">ni ye aliwatoosia monse muuliwapita.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Mubi aliwakwatua na bubi bwakue mwine.</para>
  <para style="q2" vid="PRO 5:22">Ni ye aliwakakua na nkamba ya bibalo byakue.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />Aliwafua pa mulandu wakubula masambilizio,</para>
  <para style="q2" vid="PRO 5:23">ni bupuba bwakue bukata bulibwamulovia.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Nsokezi ilekenkeene</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />We mwana wane, kine waipeele kulipa mizia ya mwino,</para>
  <para style="q2" vid="PRO 6:1">kabili kine waalaile palwakua ozo muntu,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />Kine uteelue na biuliwalanda,</para>
  <para style="q2" vid="PRO 6:2">kabili kine ukwetue na twebo twa mu kanua kobe.<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />We mwana wane, pakuti wipususie,</para>
  <para style="q2" vid="PRO 6:3">pantu waibiikile mu maboko a mwino, kita evi:</para>
  <para style="q2" vid="PRO 6:3">Endo wikeefie ni kumupaapaata mwino.<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Tekulekeela menso obe kunvua tulo,</para>
  <para style="q2" vid="PRO 6:4">ni nkopio yobe kuona.<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />Iipususie nga kasia kapusuka mu minue ya mbwela,</para>
  <para style="q2" vid="PRO 6:5">ao nga koni kapusuka mu minue ya mutei.<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Endo waya pa lupazi we munanghani,</para>
  <para style="q2" vid="PRO 6:6">langakana nzila yakue ube ni mulangue.<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />Lupazi teluli na kalombozi,</para>
  <para style="q2" vid="PRO 6:7">na mukulu-ao na kateeka.<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />Inzi lulilwaibiikila bilio bya pa musita wa likungulu,</para>
  <para style="q2" vid="PRO 6:8">kabili lulilwaikolonghaniizia bilio pa musita wa buzombozi.<verse eid="PRO 6:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />We munanghani! Waya waleeleleele sie mpaka musitaki?</para>
  <para style="q2" vid="PRO 6:9">Ulikubuuka musitaki mu tulo tobe?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6.10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:33-34">Map 24.33-34</ref>
      </char>
    </note>Uliwalanda nangue, “Ndaalenkepo kaniini, nghonenkepo kaniini,</para>
  <para style="q2" vid="PRO 6:10">nkunzenkepo kuboko kaniini ni kutuuzia.”<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />Ni evi bupabi bwakaba kukwizila nga kabooko,</para>
  <para style="q2" vid="PRO 6:11">ni kubulua kwakaba kukukonka nga kipoopoosi ali ni kilwilo.<verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Muntu mubi, muntu wa mpuni,</para>
  <para style="q2" vid="PRO 6:12">aliwaendooka walimukulanda twebo twa bupompo.<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />Aliwakapia na menso akue ni kusinia na makasa akue,</para>
  <para style="q2" vid="PRO 6:13">aliwakita tulangi na minue yakue.<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />Mu mutima mwakue muli bupompo, aliwalangakana bubi musita onse,</para>
  <para style="q2" vid="PRO 6:14">ni kubyala mbezu ya bupusano.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Ni pakako, bwavia bwaakamutulumukilila sie,</para>
  <para style="q2" vid="PRO 6:15">waakatulumukililua ni kutyonua pasili kumona ntuukilo.<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />Kuli bintu mutanda bisuulilue na Yawe,</para>
  <para style="q2" vid="PRO 6:16">ee, bintu kilooba bilibyamukisia mutima.<verse eid="PRO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 6:17" />Menso a kiitoni, lulimi lulilwalanda bufi,</para>
  <para style="q2" vid="PRO 6:17">ni minue iliyazuumia mulopa usili na kafi,<verse eid="PRO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 6:18" />Mutima uliwalangakana malanga abi,</para>
  <para style="q2" vid="PRO 6:18">ni maulu angukile kubutukila ku bubi,<verse eid="PRO 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19" />Musininkizi wa bufi aliwalanda bufi,</para>
  <para style="q2" vid="PRO 6:19">ni olia aliwabyala mbezu ya mbiikizi mu lupua.<verse eid="PRO 6:19" /></para>
  <para style="s1">Nsokezi palua bukambue</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />We mwana wane, konka milao yakua so,</para>
  <para style="q2" vid="PRO 6:20">kabili tekuti ukabe kulekela masambilizio akua noko.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Kakilila milao lyonse mu mutima obe,</para>
  <para style="q2" vid="PRO 6:21">ivwale mu mukosi obe.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />Luuliwaenda, milao yaya yakulombwele,</para>
  <para style="q2" vid="PRO 6:22">lu-uliwalaala yaya ya kusungile.</para>
  <para style="q2" vid="PRO 6:22">Ni kukulanzia lu-uliwabuuka.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />Pantu ezi milao i musaniko,</para>
  <para style="q2" vid="PRO 6:23">aza masambilizio i kisue,</para>
  <para style="q1" vid="PRO 6:23">ni nsokezi ya masambilizio</para>
  <para style="q2" vid="PRO 6:23">i nzila ya bukose.<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />I bya kukusunga ku mwanakazi mubi,</para>
  <para style="q2" vid="PRO 6:24">ni ku lubembo lwa mwanakazi mukambue.<verse eid="PRO 6:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />Tekutokamua mu mutima obe na kuwama kwakue,</para>
  <para style="q2" vid="PRO 6:25">kabili tekulekelela akubembe na nkopio ya menso akue.<verse eid="PRO 6:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Pantu mwanakazi mukambue kuti waongua na mutengo wa kisoso kya mukate,</para>
  <para style="q2" vid="PRO 6:26">inzi pa muka nghwana aliwazeeziiziapo bukose bwine bwine.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />Eba, kubako muntu kuti wabiika mulilo mu nkulo,</para>
  <para style="q2" vid="PRO 6:27">ni bivwalo byakue pasili kuzia?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Ao muntu kuti wanyanta lukasa pa mazekezeke a mulilo,</para>
  <para style="q2" vid="PRO 6:28">ni makasa akue pasili kuzia?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Evi i vili muntu aliwaingila kwa muka nghwana,</para>
  <para style="q2" vid="PRO 6:29">kubalua muntu aliwamukumia takabula kukandua.<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Bantu tebezi kumufuupula kabooko</para>
  <para style="q2" vid="PRO 6:30">kine waibila kwikuta pantu ali ni nzala.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />Inzi kine wakwatua, alikubweziiziamo nghendo kilooba,</para>
  <para style="q2" vid="PRO 6:31">ni ye alikufumia bunonsi bonse bwa mu nghanda yakue.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Inzi olia aliwakita bukambue na mwanakazi, tali na maano.</para>
  <para style="q2" vid="PRO 6:32">Olia aliwatona kwinoona mutima wakue mwine, i aliwakita evio.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />Wene waakaaluka ni bilonda ni busoni,</para>
  <para style="q2" vid="PRO 6:33">ni kulandilua bibiipile tekukapua.<verse eid="PRO 6:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Pantu bunkua bulibwamuleetela mulume kipuki.</para>
  <para style="q2" vid="PRO 6:34">Ni ye takaba na nkumbu busiku bwa kukita kibwelezi.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />Takeetabila nfuto ata imo,</para>
  <para style="q2" vid="PRO 6:35">kabili takeetabila bituulilo anzia kine bikabe byavulile.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />We mwana wane, sunga twebo twane,</para>
  <para style="q2" vid="PRO 7:1">labukila milao yane mukati mobe.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />Konka milao yane ukabe ni bukose,</para>
  <para style="q2" vid="PRO 7:2">ni kusunga mafunde ane nga kambooli ka mu linso lyobe.<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />Kakila milao ku minue yobe,</para>
  <para style="q2" vid="PRO 7:3">uilembe pa kibao kya mu mutima obe.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Ana mulangue nangue, “Uli nkazyamwine,”</para>
  <para style="q2" vid="PRO 7:4">ni kumwana kyunvwila nangue, “Uli lupua lwane.”<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Evi bakusunge ku mwanakazi mukambue,</para>
  <para style="q2" vid="PRO 7:5">ni ku kuleula ku muka nghwana aliwabembia na twebo twakue.<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Pantu pa nzota ya mu nghanda yane</para>
  <para style="q2" vid="PRO 7:6">naakentele mu kisampi.<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />Naamwene pa babipuba,</para>
  <para style="q2" vid="PRO 7:7">pa balumendo nainikilepo mulumendo asimanine kantu.<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />Mulumendo waali waya mu musebo ukata pepi ni lipeto,</para>
  <para style="q2" vid="PRO 7:8">walungi ku nghanda kulikwaikala mwanakazi umo.<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />Koba kasyazimiine, musita wa kyungulo,</para>
  <para style="q2" vid="PRO 7:9">pasyafiita, pa kamuntu uli ni.<verse eid="PRO 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Kupwako, mwanakazi umo waya kusaakaana nakue,</para>
  <para style="q2" vid="PRO 7:10">wavwele nga mukende ali ni mutima wa bupompo.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />Mwanakazi ali ni nsungu ni butaale,</para>
  <para style="q2" vid="PRO 7:11">makasa akue tekuba azikia mu nghanda yakue.<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />Unge musita aliwasangua mu nzila, ni unge musita mu misolo,</para>
  <para style="q2" vid="PRO 7:12">ni mu mapeto walimukubenza.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Kupwako, wamukumbatila mulumendo ni kumufyompa,</para>
  <para style="q2" vid="PRO 7:13">ni kumwana pasili busoni.<verse eid="PRO 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />“Ngelelo ya kyabupe kya mutende ndinayo ku nghanda.</para>
  <para style="q2" vid="PRO 7:14">Lelo nafikilizia kilapo kyane.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Ni pakako, i kinafuminanga kuti ngize nsaakaane nobe.</para>
  <para style="q2" vid="PRO 7:15">Nakukebanga mpaka nakumona.<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Pa bulita bwane napanzikangapo ngubo,</para>
  <para style="q2" vid="PRO 7:16">ngubo ya ku Misri ya mazela.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />Nafuuminizyanga manukato pa bulita bwane,</para>
  <para style="q2" vid="PRO 7:17">ni bubaani, ni kizime pamo ni mudalasini.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Iza twikute ntono mpaka lukeelekeele,</para>
  <para style="q2" vid="PRO 7:18">tusansamusie mitima yetu na ntono.<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Pantu mulume wane ku nghanda taliko,</para>
  <para style="q2" vid="PRO 7:19">aile mu bulendo lwa kule.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />Wakitwama ni mufuko wa nfolanga,</para>
  <para style="q2" vid="PRO 7:20">wakaba kubwela sie kwezi wasyalingi.”<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />Na twebo twakue tuweme aliwamubembia,</para>
  <para style="q2" vid="PRO 7:21">aliwamwanzia na lubembo lwa kanua kakue.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Ni penka papo aliwamukonka,</para>
  <para style="q2" vid="PRO 7:22">nga nghombe ndume alimukuya ku kusinzua,</para>
  <para style="q2" vid="PRO 7:22">ao nga kisongo kilimukwingila mu muteo.<verse eid="PRO 7:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23" />Anzia muvui kine wamutunka ku maini,</para>
  <para style="q2" vid="PRO 7:23">nga koni kabutukiile pa kakose,</para>
  <para style="q2" vid="PRO 7:23">tavinda kumana nangue i busanzo bwa bukose bwakue.<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Ni pakako, we mwana wane ntwilizie,</para>
  <para style="q2" vid="PRO 7:24">poozako maano ku bindimukukwana.<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />Mutima obe tekuti upooze maano ku nzila yakue,</para>
  <para style="q2" vid="PRO 7:25">ukeeza kuzeezelela mwaliwapita. <verse eid="PRO 7:25" /><verse number="26" style="v" sid="PRO 7:26" />Pantu tasyaipaile balalume bengi,</para>
  <para style="q2" vid="PRO 7:26">balia ba-asyasinzile, ni bengi.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />Nghanda yakue i nzila ikata ya kumbo,</para>
  <para style="q2" vid="PRO 7:27">ikookeele ku miputule ya lufu.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Bulumba bwa mulangue</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8.1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:20-21">Map 1.20-21</ref>
      </char>
    </note>Eba, mulangue tezi kulila?</para>
  <para style="q2" vid="PRO 8:1">Kumana ni ye tezi kuzanzula lizui lyakue?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Pa kifuka kya pa muulu sana pepi ni nzila,</para>
  <para style="q2" vid="PRO 8:2">pa masanzyonzila i paimeene.<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />Mumbali mulyango wa kwingililapo mu muzi,</para>
  <para style="q2" vid="PRO 8:3">pa nghingililo, aliwasamuna,<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />“Mwe bantu, ndinamikuuta,</para>
  <para style="q2" vid="PRO 8:4">ni lizui lyane ni pa mulandu wa bantu.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Mwe basimanine kantu, be ni maano,</para>
  <para style="q2" vid="PRO 8:5">ni mwe babipuba, be ni mutima wa kumana.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Twilizie pantu ndi ni twa kulanda twa mponvu,</para>
  <para style="q2" vid="PRO 8:6">ndikwizula milomo yane nande twebo tulungi.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Kanua kane kalikulanda kisinka,</para>
  <para style="q2" vid="PRO 8:7">pantu bubi kunvwika mu milomo yane ni kibalo.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Twebo tonse twa mu kanua kane ni twa nsambu,</para>
  <para style="q2" vid="PRO 8:8">tepali kalubile ao kabiipile pa tonse.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Tonse tuli sie bwino ku olia amanine,</para>
  <para style="q2" vid="PRO 8:9">tulungheeme ku balia bali ni maano.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Saakula masambilizio ane kukila mutofue,</para>
  <para style="q2" vid="PRO 8:10">ni kumana kukila oro isambikile.<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Pantu mulangue i aweme kukila mabue a mutengo,</para>
  <para style="q2" vid="PRO 8:11">ni bintu byonse bitonekele tebivinda kulinghaniwa nakue.<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />“Nene, ne mulangue, ngikeele pamo ni bukengezi,</para>
  <para style="q2" vid="PRO 8:12">kwinika ni kumana ndi nabo.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Kutiina Yawe, kusuula bubi.</para>
  <para style="q2" vid="PRO 8:13">Nsuulile kiitoni, ni kwitasia, ni mibeele ibi,</para>
  <para style="q2" vid="PRO 8:13">pamo ni bulanzi bubi.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Nsokezi ni yane pamo ni bukengezi bwa kiine,</para>
  <para style="q2" vid="PRO 8:14">kumana ni maka ndi nabio.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Mubukwasi bwane, makolo aliateeka,</para>
  <para style="q2" vid="PRO 8:15">ni kupingula mu nsambu.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Mubukwasi bwane, bena makolo balibateeka,</para>
  <para style="q2" vid="PRO 8:16">ni babiloolo balibalombola bwino pa kyalo.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Ntonene balia bantonene,</para>
  <para style="q2" vid="PRO 8:17">ni bonse balibankeba na mute, baliban'mona.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Bunonsi ni mukinzi bili kuli nene,</para>
  <para style="q2" vid="PRO 8:18">bunonsi bulibwalunduluka pamo ni nsambu.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Mazabo ane akindeeme kukila oro,</para>
  <para style="q2" vid="PRO 8:19">ni kibwezia kyane kikilile mutofue usambikile.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Ndinaenda mu nzila ya bulunghami,</para>
  <para style="q2" vid="PRO 8:20">mu tusansaila twa nsambu,<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />Ndinanonsia balia bantonene,</para>
  <para style="q2" vid="PRO 8:21">ndinaizuzia kipao kyabo.<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8.22: </char>
      <char style="xt" closed="false">
        <ref loc="REV 3:14">Nfy 3.14</ref>
      </char>
    </note>“Yawe waanengele wa mambo mu miilo yakue,</para>
  <para style="q2" vid="PRO 8:22">ntanzi ya miilo yakue ya kale.<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Nene kundi kutula ku mambo,</para>
  <para style="q2" vid="PRO 8:23">kyalo lukyaali tekinabeko.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Biponga lubyaali tebinabeko, naali nasyavyelue,</para>
  <para style="q2" vid="PRO 8:24">tusulo twizwilemo menda lutwaali tetunabeko.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Mpili luyaali teinabeko,</para>
  <para style="q2" vid="PRO 8:25">ntanzi ya tupili naali nasyavyelue.<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />Lu-aali tanalenge kyalo, ao makaba,</para>
  <para style="q2" vid="PRO 8:26">ni ntendeko ya lufunko lwa mu kyalo.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Naali nalipo lu-aali wabiika myulu,</para>
  <para style="q2" vid="PRO 8:27">lu-aali wabiika mupaka wa lyulu ni menda.<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />Lu-aali wabiika malezi a mu muulu,</para>
  <para style="q2" vid="PRO 8:28">ni lu-aali walumia tusulo twa menda,<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />Lu-aali wabiika mupaka wa lyezi,</para>
  <para style="q2" vid="PRO 8:29">evi menda tekuti apule mafunde akue,</para>
  <para style="q2" vid="PRO 8:29">ni lu-aakitile biputa bya kyalo.<verse eid="PRO 8:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30" />Naali pamo nakue nga kituemambo wa miilo.</para>
  <para style="q2" vid="PRO 8:30">Naali nsansa yakue kubalua busiku.</para>
  <para style="q2" vid="PRO 8:30">Naali ni nsansa kubalua busiku ku menso akue.<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />Naali nasansamukila kyalo kikeeluemo na bantu,</para>
  <para style="q2" vid="PRO 8:31">ni nsansa yane yaali yali pamo ni bena bantu.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />“Ni pakako, ntwilizie mwe baana bane,</para>
  <para style="q2" vid="PRO 8:32">pantu lisyuko lili na balia balibakonka nzila yane.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Unvue masambilizio ane mube ni mulangue,</para>
  <para style="q2" vid="PRO 8:33">kabili tekukaane.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Lisyuko ku olia aliwantwilizia,</para>
  <para style="q2" vid="PRO 8:34">aliwapempa kubalua busiku ku milyango yane,</para>
  <para style="q2" vid="PRO 8:34">wapembeele mumbali milyango yane.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Pantu olia wansanga, wasanga bukose</para>
  <para style="q2" vid="PRO 8:35">ni kupokelela buwame kuli Yawe.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Inzi olia aliwa-andua kunsanga, aliwakisia mutima wakue mwine,</para>
  <para style="q2" vid="PRO 8:36">balia bonse bansuulile, batonene lufu.”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Mulangue ni bupuba</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Mulangue waakuulile nghanda yakue,</para>
  <para style="q2" vid="PRO 9:1">waabaazile mapumpu akue kilooba.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />Waipaile nama yakue ni kusanziamo divai yakue,</para>
  <para style="q2" vid="PRO 9:2">waapanzikile ni meza yakue.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />Waatumine mubombi wakue mwanakazi,</para>
  <para style="q2" vid="PRO 9:3">pa kifuka kya pa muulu wa muzi kuti akupe.<verse eid="PRO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4" />“Kubalua kipuba eze engile,”</para>
  <para style="q2" vid="PRO 9:4">ni olia asimanine kantu, aliwamwana nangue,<verse eid="PRO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5" />“Iza ulie bilio byane,</para>
  <para style="q2" vid="PRO 9:5">ni kumina divai inakisanzia.<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />Mwe babipuba, lekele bupuba mube ni bukose.</para>
  <para style="q2" vid="PRO 9:6">Endele mu nzila ya kumana.”<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />Aliwasoka wa kapuni aliwaileetelela kuleebulua.</para>
  <para style="q2" vid="PRO 9:7">Ni aliwasasilila mubi aliwaileetelela matuka.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Tekusasilila ali ni mufuupula pantu nga alikukukenda,</para>
  <para style="q2" vid="PRO 9:8">sasilila wa mulangue, ni ye alikukutona.<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />Sambilizia wa mulangue, ni ye alikulunduluka kuba ni mulangue.</para>
  <para style="q2" vid="PRO 9:9">Sambilizia mulunghami, ni ye alikulunduluka kumana.<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9.10: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 28:28">Yob 28.28</ref>; <ref loc="PSA 111:10">Mlb 111.10</ref>; <ref loc="PRO 1:7">Map 1.7</ref></char>
    </note> Kumutiina Yawe, i ntendeko ya mulangue,</para>
  <para style="q2" vid="PRO 9:10">ni kumumana Muzuuke, i kuba ni maano.<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Pantu kupitila mu mulangue nsiku yobe ilikuvuziiwa,</para>
  <para style="q2" vid="PRO 9:11">ni myaka ya bwikazi bobe ilikulundua.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />Kine uli ni mulangue, mulangue obe we mwine.</para>
  <para style="q2" vid="PRO 9:12">Kine uli wa kapuni, kwema ni kobe we mwine.<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />Mwanakazi kipuba aliwasaamia,</para>
  <para style="q2" vid="PRO 9:13">Tamanine kantu, kabili tali na busoni.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Aliwaikala mu mulyango wa nghanda yakue,</para>
  <para style="q2" vid="PRO 9:14">pa kifuka kya pa muulu wa muzi,<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />Walimukukuuta balia balibapita,</para>
  <para style="q2" vid="PRO 9:15">balibapita mu nzila yakue,<verse eid="PRO 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16" />“Kubalua kipuba eze engile mono!”</para>
  <para style="q2" vid="PRO 9:16">Ni olia asimanine kantu aliwamwana nangue,<verse eid="PRO 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17" />“Menda ebilue aweme,</para>
  <para style="q2" vid="PRO 9:17">ni mukate uliwaliiwa mu kafiso uliwawaminina.”<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Inzi kipuba tamanine nangue momo i muli bafwile,</para>
  <para style="q2" vid="PRO 9:18">ni baeni ba ozo mwanakazi nangue bali pansi kumbo.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s1">Mapinda akua Solomoni</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 10:1" />Aza i mapinda akua Solomoni:</para>
  <para style="q1" vid="PRO 10:1">Mwana wa mulangue aliwasansamusia se,</para>
  <para style="q2" vid="PRO 10:1">inzi kipuba, bulanda kuli nghina.<verse eid="PRO 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Bukonto bulibwanonkelua mu bubi tebuli na kibwezia,</para>
  <para style="q2" vid="PRO 10:2">inzi bulunghami bulibwapususyania ku lufu.<verse eid="PRO 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />Yawe tezi kulekelela mulunghami kwemiwa na nzala,</para>
  <para style="q2" vid="PRO 10:3">inzi aliwabatana babi belia bibalibatokamua.<verse eid="PRO 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Olia aliwabomba na kuboko kunangheene aliwaileetelela bupabi,</para>
  <para style="q2" vid="PRO 10:4">inzi kuboko kwa olia alumine kulikwaleeta bunonsi.<verse eid="PRO 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Olia aliwakolonghania musita wa kipua, i mwana ali ni mulangue,</para>
  <para style="q2" vid="PRO 10:5">inzi olia aliwalaala musita wa kuzombola, i mwana aliwamoniania busoni.<verse eid="PRO 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Mapaalo ali pa mutue wa mulunghami,</para>
  <para style="q2" vid="PRO 10:6">inzi bupompo bukupiliile kanua ka mubi.<verse eid="PRO 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Liina lya mulunghami lililyabombiiwa ku mapaalo,</para>
  <para style="q2" vid="PRO 10:7">inzi liina lya mubi, lyaakabola.<verse eid="PRO 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />Wa mulangue aliwaitabila nsokezi,</para>
  <para style="q2" vid="PRO 10:8">inzi kipuba wa bulanzi bwingi waakaloba.<verse eid="PRO 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Olia aliwaenda mu bulunghami, aliwaenda pasili busanzo,</para>
  <para style="q2" vid="PRO 10:9">inzi olia aliwamuzeeziizia nzila waakamanika.<verse eid="PRO 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Olia aliwakapia na linso aliwaleeta bulanda,</para>
  <para style="q2" vid="PRO 10:10">inzi aliwasokana mu kisinka aliwaleeta mutende.<verse eid="PRO 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />Kanua ka balunghami, i kasulo ka menda a bukose,</para>
  <para style="q2" vid="PRO 10:11">inzi bupompo buli mu kanua ka mubi.<verse eid="PRO 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10.12: </char>
      <char style="xt" closed="false">
        <ref loc="JAS 5:20">Yak 5.20</ref>; <ref loc="1PE 4:8">1 Pet 4.8</ref></char>
    </note>Kukenda kulikwalengia bupusano,</para>
  <para style="q2" vid="PRO 10:12">inzi ntono iliyavimba pa bubi bonse.<verse eid="PRO 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Mulangue uliwasangua mu milomo ya muntu aliwainika,</para>
  <para style="q2" vid="PRO 10:13">inzi nfimbo iliyaumua mu musana wa muntu asili na maano.<verse eid="PRO 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Wa mulangue aliwabiika bukonto bwa bukengezi,</para>
  <para style="q2" vid="PRO 10:14">inzi kanua ka kipuba, kalikapalamika lwinoono.<verse eid="PRO 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Bunonsi bwa munonsi, i muzi wakue ulumine.</para>
  <para style="q2" vid="PRO 10:15">Inzi lwinoono lwa bapabi i bupabi bwabo.<verse eid="PRO 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Kilambu kya mulunghami kilikyaleeta bukose,</para>
  <para style="q2" vid="PRO 10:16">Inzi bunonsi bwa mubi ni kibalo.<verse eid="PRO 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Olia aliwaunvua lu-aliwasasililua, ali mu nzila ya bukose,</para>
  <para style="q2" vid="PRO 10:17">Inzi olia aliwakaana nsokezi, aliwazeeza.<verse eid="PRO 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Olia asuulile mwinakue mu kafiso wa bufi,</para>
  <para style="q2" vid="PRO 10:18">ni olia aliwa-ambana, kipuba.<verse eid="PRO 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Mu bwingi bwa twebo, temwapusa bubi,</para>
  <para style="q2" vid="PRO 10:19">inzi aliwasunga milomo yakue, aliwabombia maano.<verse eid="PRO 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Lulimi lwa mulunghami luli nga mutofue uwamiisie,</para>
  <para style="q2" vid="PRO 10:20">mutima wa mubi ni wa mpuni.<verse eid="PRO 10:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Milomo ya balunghami iliyaliisia bengi,</para>
  <para style="q2" vid="PRO 10:21">inzi babipuba balibafua pa mulandu wa kusimana.<verse eid="PRO 10:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />Mapaalo akua Yawe alianonsyania,</para>
  <para style="q2" vid="PRO 10:22">pasili kwemenapo.<verse eid="PRO 10:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Kipuba kukita bubi, kuli nga musaapo,</para>
  <para style="q2" vid="PRO 10:23">inzi muntu wa kyunvwila aliwawaminua na mulangue.<verse eid="PRO 10:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Kilikyatiina mubi i kilikyamufikila,</para>
  <para style="q2" vid="PRO 10:24">inzi balunghami balibapeelua kibalibakeba.<verse eid="PRO 10:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Kine mulula wapita, babi balibazeeza,</para>
  <para style="q2" vid="PRO 10:25">inzi mulunghami wene, kiputa kya muyayaya.<verse eid="PRO 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Nga mpubili mu meno, ni byunsi mu menso,</para>
  <para style="q2" vid="PRO 10:26">i vili munanghani ku balia balibamutuma.<verse eid="PRO 10:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />Kutiina Yawe kulikwalunda nsiku ya muntu,</para>
  <para style="q2" vid="PRO 10:27">inzi myaka ya babi iliyakeefiiwa.<verse eid="PRO 10:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Maswapi a balunghami ni nsansa,</para>
  <para style="q2" vid="PRO 10:28">inzi kuketekela kwa babi kwa mpuni.<verse eid="PRO 10:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />Nzila yakua Yawe, i lusako lulumine ku mulunghami,</para>
  <para style="q2" vid="PRO 10:29">inzi ni lwinoono ku bankitatubi.<verse eid="PRO 10:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Balunghami tebakaloviiwa,</para>
  <para style="q2" vid="PRO 10:30">inzi babi tebakeekala mu kyalo.<verse eid="PRO 10:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Kanua ka balunghami kalikalanda bya mulangue,</para>
  <para style="q2" vid="PRO 10:31">inzi lulimi lwa muntu wa kiitoni lwaakaloviiwa.<verse eid="PRO 10:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Milomo ya balunghami imanine bilibyaitabiziiwa,</para>
  <para style="q2" vid="PRO 10:32">inzi kanua ka mubi kalikalanda bibiipile.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />Kalingo ka bupompo, ni kilubo kuli Yawe,</para>
  <para style="q2" vid="PRO 11:1">inzi bilemo bilingheene bilibyamuwamina.<verse eid="PRO 11:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Lulilwaiza kiitoni, ni busoni i pabulibwaiza,</para>
  <para style="q2" vid="PRO 11:2">inzi mulangue uliwaleeta kwikeefia.<verse eid="PRO 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Bulunghami bwa balunghami bulibwabalombola,</para>
  <para style="q2" vid="PRO 11:3">inzi kiitoni kya bapoti kilikyabalovia.<verse eid="PRO 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Bunonsi tebuli na kibwezia busiku bwa kukandua,</para>
  <para style="q2" vid="PRO 11:4">inzi bulunghami buli bwapususyania ku lufu.<verse eid="PRO 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Bukisinka bwa mulunghami bulibwalundulula nzila yakue,</para>
  <para style="q2" vid="PRO 11:5">inzi mubi aliwaponena mu bubi bwakue mwine.<verse eid="PRO 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />Bulunghami bwa balunghami bulibwabapususia,</para>
  <para style="q2" vid="PRO 11:6">inzi balia balibakita bya bupompo balibakwatua mu bupompo bwabo.<verse eid="PRO 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />Mubi lu-aliwafua, maswapi akue aliazeeza,</para>
  <para style="q2" vid="PRO 11:7">ni byonse bi-aketekeele mu maka akue bilibyapua.<verse eid="PRO 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />Mulunghami aliwapususiiwa mu maavia,</para>
  <para style="q2" vid="PRO 11:8">inzi mubi aliwaingila mu maavia.<verse eid="PRO 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />Olia asiliwatiina Leza aliwainoona benakue na kanua kakue,</para>
  <para style="q2" vid="PRO 11:9">inzi mu bukengezi balunghami balibapususiiwa.<verse eid="PRO 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />Balunghami lubalibanonka, muzi uliwawaminua,</para>
  <para style="q2" vid="PRO 11:10">ni babi lubalibaloba, bantu balibabulula tupundu.<verse eid="PRO 11:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />Kupitila mu mapaalo a balunghami, muzi uliwalumbua,</para>
  <para style="q2" vid="PRO 11:11">inzi uliwainoonua kupitila mu tunua twa babipuba.<verse eid="PRO 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />Olia aliwalandila mwinakue twebo twa mufuupula ni kipuba,</para>
  <para style="q2" vid="PRO 11:12">inzi muntu wa maano aliwatalala.<verse eid="PRO 11:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />Olia aliwapitaana wa-ambana, aliwafyula tufiso,</para>
  <para style="q2" vid="PRO 11:13">inzi aketekeelue aliwafiika milandu.<verse eid="PRO 11:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />Kyalo kisili na mulombozi wa mulangue kilikya-anziiwa,</para>
  <para style="q2" vid="PRO 11:14">inzi kolia kuli bakasoka bengi, kuli mutende.<verse eid="PRO 11:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />Olia aliwaipeela kulipa mizia ya mweni, aliwaemenamo,</para>
  <para style="q2" vid="PRO 11:15">inzi olia asiliwalaya kulipa mizia, ali ni mutende.<verse eid="PRO 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />Mwanakazi wa mukinzi, aliwakindikua lyonse,</para>
  <para style="q2" vid="PRO 11:16">inzi bapompo balibapokolola bunonsi.<verse eid="PRO 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />Olia ali ni nkumbu, aliwakitila mutima wakue biweme,</para>
  <para style="q2" vid="PRO 11:17">inzi asasile aliwaemia mubili wakue mwine.<verse eid="PRO 11:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />Mubi aliwasaziiwa nsazio ya bupompo,</para>
  <para style="q2" vid="PRO 11:18">inzi olia aliwabyala bulunghami, ali ni kilambu kya kisinka.<verse eid="PRO 11:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />Olia aliwatwalilila mu bulunghami, ali ni bukose,</para>
  <para style="q2" vid="PRO 11:19">inzi olia aliwakonkelela bubi, aliwafua.<verse eid="PRO 11:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />Yawe asuulile balia bali ni mutima wa kiitoni,</para>
  <para style="q2" vid="PRO 11:20">inzi balia bapwililikile mu nzila yabo balibamuwamina.<verse eid="PRO 11:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />Kisinka mubi takabula kukandua,</para>
  <para style="q2" vid="PRO 11:21">inzi balunghami baakapususiiwa.<verse eid="PRO 11:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Nga vili kazele ka oro ku moona wa ngulube,</para>
  <para style="q2" vid="PRO 11:22">i vili ni mwanakazi aweme asili na mulangue.<verse eid="PRO 11:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />Nkulu ya mulunghami iliyapeleela mu biweme,</para>
  <para style="q2" vid="PRO 11:23">inzi maswapi a mubi, ni mu kukandua.<verse eid="PRO 11:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />Muntu aliwapeelapeela, aliwakila kunonka,</para>
  <para style="q2" vid="PRO 11:24">inzi olia aliwakilikila bisilungheeme, aliwakila kuba mupabi.<verse eid="PRO 11:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />Muntu wa buntu aliwakitikilua na biweme,</para>
  <para style="q2" vid="PRO 11:25">ni olia aliwapaana bya kumina ni ye aliwaminiiwa.<verse eid="PRO 11:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />Olia aliwatanana nghano, bantu balibamutiipa,</para>
  <para style="q2" vid="PRO 11:26">inzi mapaalo ali pa mutue wakua olia aliwatona kusisia.<verse eid="PRO 11:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />Olia aliwakebesia kukita biweme, atonekele,</para>
  <para style="q2" vid="PRO 11:27">inzi olia aliwakeba kukita bubi aliwabusanga.<verse eid="PRO 11:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />Olia aswapiile bunonsi bwakue, aliwapona,</para>
  <para style="q2" vid="PRO 11:28">inzi mulunghami aliwalunduluka nga maani abisi.<verse eid="PRO 11:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />Olia aliwatuuta nghanda yakue, aliwapyana mwela.</para>
  <para style="q2" vid="PRO 11:29">Ni kipuba alikuba muzia wa muntu wa mulangue.<verse eid="PRO 11:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />Mazabo a mulunghami, i kimuti kya bukose,</para>
  <para style="q2" vid="PRO 11:30">ni olia aliwapususia bantu ali ni mulangue.<verse eid="PRO 11:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11.31: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 4:18">1 Pet 4.18</ref>
      </char>
    </note>Kine mulunghami aliwasaziiwa pa kyalo,</para>
  <para style="q2" vid="PRO 11:31">paliibufi mubi pamo ni wa bibalo.<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />Olia atonene masambilizio, atonene bukengezi,</para>
  <para style="q2" vid="PRO 12:1">inzi olia asuulile kusasililua, ni kipuba.<verse eid="PRO 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />Muntu aweme aliwasanga buwame bwakua Yawe,</para>
  <para style="q2" vid="PRO 12:2">inzi wa nsokezi ibi aliwapingulua na Yawe.<verse eid="PRO 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />Muntu tavinda kwileetela mutende na kukita bubi,</para>
  <para style="q2" vid="PRO 12:3">inzi mulunghami takaponiwa na kantu.<verse eid="PRO 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />Mukazi aweme, i ngala ya mulume wakue,</para>
  <para style="q2" vid="PRO 12:4">inzi olia aliwamoniania busoni, ali nga keesi kalikabunguzia bikuza bya mulume.<verse eid="PRO 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />Malanga a balunghami alungi,</para>
  <para style="q2" vid="PRO 12:5">inzi nsokezi ya babi, ni bupompo.<verse eid="PRO 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />Twebo twa babi, tuli na mapange a kulovia,</para>
  <para style="q2" vid="PRO 12:6">inzi kanua ka balunghami kalikabapususia.<verse eid="PRO 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />Babi balibainoonua ni kuloba,</para>
  <para style="q2" vid="PRO 12:7">inzi nghanda ya balunghami iliyatwalilila.<verse eid="PRO 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />Muntu aliwatasiiwa kukonkana ni mulangue wakue,</para>
  <para style="q2" vid="PRO 12:8">ni wa malanga abi aliwafuupulua.<verse eid="PRO 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />Muntu aliwafuupulua koku waali ni mubombi,</para>
  <para style="q2" vid="PRO 12:9">aweme kukila muntu emwene kuba wali wa mponvu inzi tekuba wali na bilio.<verse eid="PRO 12:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />Mulunghami aliwasakamana bukose bwa nama yakue,</para>
  <para style="q2" vid="PRO 12:10">inzi nkumbu ya babi, ni kwemia.<verse eid="PRO 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />Mulimi wa mute, ali na bilio bingi,</para>
  <para style="q2" vid="PRO 12:11">inzi olia aliwakonka milandu ya mpuni, tali na maano.<verse eid="PRO 12:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />Mubi aliwatokamua bunonsi bwa mubi,</para>
  <para style="q2" vid="PRO 12:12">inzi mulunghami aliwaimana sinta.<verse eid="PRO 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />Kilubo kya mu kanua, muteo wa muntu mubi,</para>
  <para style="q2" vid="PRO 12:13">inzi mulunghami aliwafuma mu maavia.<verse eid="PRO 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />Muntu aliwaikusiiwa na buwame bwa mazabo a mu kanua kakue,</para>
  <para style="q2" vid="PRO 12:14">aliwabweziiziwa bikitua bya minue yakue.<verse eid="PRO 12:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />Nzila ya kipuba iweme ku menso akue mwine,</para>
  <para style="q2" vid="PRO 12:15">inzi mulunghami aliwatwilizia nsokezi.<verse eid="PRO 12:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />Bupuba bwa muntu asili na maano tebwakokola kumanika,</para>
  <para style="q2" vid="PRO 12:16">inzi muntu akengeele aliwapuulula matuka.<verse eid="PRO 12:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />Olia aliwalanda kisinka, aliwasininkizia bya kiine,</para>
  <para style="q2" vid="PRO 12:17">inzi musininkizi wa bufi, aliwalanda bufi.<verse eid="PRO 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />Twebo tubi tulitwakisia nga kipanga,</para>
  <para style="q2" vid="PRO 12:18">inzi bulanzi bwa mulangue bulibwaleeta bukose.<verse eid="PRO 12:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />Bukisinka bulibwatwalilila lyonse,</para>
  <para style="q2" vid="PRO 12:19">inzi bufi ni bwa pa musita uniini sie.<verse eid="PRO 12:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />Bupompo buli mu mutima wa balia balibalangakana bubi,</para>
  <para style="q2" vid="PRO 12:20">inzi balia bali ni mapange a mutende, bali ni nsansa.<verse eid="PRO 12:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />Tekuli busanzo bulibwaponena balunghami,</para>
  <para style="q2" vid="PRO 12:21">inzi babi balibavuziiziwa maavia.<verse eid="PRO 12:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />Kanua ka bufi, ni kilubo kuli Yawe,</para>
  <para style="q2" vid="PRO 12:22">inzi balia balibakita bulunghami, i nsansa yakue.<verse eid="PRO 12:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />Muntu akengeele, aliwafiika maano akue,</para>
  <para style="q2" vid="PRO 12:23">inzi babipuba balibamania bupuba bwabo.<verse eid="PRO 12:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />Kuboko kukinkimeene, i kulikwateeka,</para>
  <para style="q2" vid="PRO 12:24">inzi bunanghani bulibwaleeta buzia.<verse eid="PRO 12:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />Kutooboka kwa mutima kulikwapwisia nsansa,</para>
  <para style="q2" vid="PRO 12:25">inzi keebo kaweme kalikasansamusia.<verse eid="PRO 12:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />Mulunghami aliwalanga nzila ku mwinakue,</para>
  <para style="q2" vid="PRO 12:26">inzi nzila ya babi iliyabazeezia.<verse eid="PRO 12:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />Mukumbi munanghani tezi kusanga mabingo akue,</para>
  <para style="q2" vid="PRO 12:27">inzi wa mute tezi kubwela tonte.<verse eid="PRO 12:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />Mu nzila ya bulunghami i muli bukose,</para>
  <para style="q2" vid="PRO 12:28">ni mu tusansaila twakue temuli lufu.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />Mwana wa mulangue aliwatwilizia mafunde akua se,</para>
  <para style="q2" vid="PRO 13:1">inzi wa kapuni, tezi kutwilizia nsokezi.<verse eid="PRO 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />Muntu aliwaikusiiwa na buwame bwa mazabo a mu kanua kakue,</para>
  <para style="q2" vid="PRO 13:2">inzi mutima wa muntu mubi uliwalia bubi.<verse eid="PRO 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />Olia aliwalabukila kanua kakue, aliwasunga bukose bwakue,</para>
  <para style="q2" vid="PRO 13:3">inzi olia aliwaizula milomo yakue ali ni bwavia.<verse eid="PRO 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />Mutima wa munanghani uliwatokamua pasili kusanga kantu,</para>
  <para style="q2" vid="PRO 13:4">inzi mutima wa olia akinkimeene, uliwaikuta.<verse eid="PRO 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />Mulunghami tezi kutona kulanda bufi,</para>
  <para style="q2" vid="PRO 13:5">inzi muntu mubi aliwakila kuluvia, ni ye aliwamoniiwa busoni.<verse eid="PRO 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />Bulunghami bulibwasunga mulunghami mu nzila yakue,</para>
  <para style="q2" vid="PRO 13:6">inzi bubi bulibwalovia wa bibalo.<verse eid="PRO 13:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />Kuli ni olia aliwailanga kuba munonsi, inzi tekuba wali na kantu.</para>
  <para style="q2" vid="PRO 13:7">Kuli ni olia aliwailanga kuba mupabi, inzi wali ni bunonsi bwingi.<verse eid="PRO 13:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />Bunonsi bwa muntu i bulibwamulubula,</para>
  <para style="q2" vid="PRO 13:8">inzi mupabi tali na ka kumupususia.<verse eid="PRO 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />Kisue kya mulunghami kilikyabenghemesia,</para>
  <para style="q2" vid="PRO 13:9">inzi musaniko wa mubi uliwazima.<verse eid="PRO 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />Kiitoni, kilikyaleeta mazibo,</para>
  <para style="q2" vid="PRO 13:10">inzi mulangue, uli na balia balibaunvua nsokezi.<verse eid="PRO 13:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />Bunonsi bwa lubilo lubilo bulibwakeepa,</para>
  <para style="q2" vid="PRO 13:11">inzi olia aliwanonka bukebuke, aliwavuzia.<verse eid="PRO 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />Maswapi aliakokola, aliakisia mutima,</para>
  <para style="q2" vid="PRO 13:12">inzi kelia kintu kipembeelue kine kyafika, ni kimuti kya bukose.<verse eid="PRO 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />Olia aliwafuupula mafunde, aliwaileetela lwinoono,</para>
  <para style="q2" vid="PRO 13:13">inzi olia aliwanakila milao, aliwalambulua.<verse eid="PRO 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />Masambilizio a muntu wa mulangue, i kasulo ka bukose,</para>
  <para style="q2" vid="PRO 13:14">aliamulengia kuleuka miteo ya lufu.<verse eid="PRO 13:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />Maano aweme alialengia kutoneka,</para>
  <para style="q2" vid="PRO 13:15">inzi nzila ya bapompo ya maavia.<verse eid="PRO 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />Kubalua muntu wa maano aliwabomba wakengeele,</para>
  <para style="q2" vid="PRO 13:16">inzi kipuba aliwasalanghania bupuba bwakue.<verse eid="PRO 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />Mukenzi mubi aliwaponiizia bantu mu maavia,</para>
  <para style="q2" vid="PRO 13:17">inzi mukenzi wa kisinka, aliwaleeta bukose.<verse eid="PRO 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />Bupabi pamo ni busoni, bili na olia aliwakaana masambilizio,</para>
  <para style="q2" vid="PRO 13:18">inzi olia aliwakonka nsokezi, aliwakindikua.<verse eid="PRO 13:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />Kine kelia kintu kitonekele kyakitika, muntu aliwawaminua,</para>
  <para style="q2" vid="PRO 13:19">inzi babipuba kwikeka ku bubi, kilubo.<verse eid="PRO 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />Enda na ba mulangue, ni we uli kuba ni mulangue,</para>
  <para style="q2" vid="PRO 13:20">inzi kibuza wa babipuba aliwaema.<verse eid="PRO 13:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />Bwavia bulibwakonka ba bibalo,</para>
  <para style="q2" vid="PRO 13:21">inzi mulunghami aliwalambulua buwame.<verse eid="PRO 13:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />Muntu aweme aliwasia bupyani ku benzikulu,</para>
  <para style="q2" vid="PRO 13:22">ni bunonsi bwa muntu wa bibalo, bukonto bwa mulunghami.<verse eid="PRO 13:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />Bukaba bwa mupabi kuti bwafumia buzombozi bwingi,</para>
  <para style="q2" vid="PRO 13:23">inzi bilibyainoonua pa mulandu wa kubiibikiziiwa.<verse eid="PRO 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />Muntu asiizi kubombia nfimbo, akendele mwana wakue,</para>
  <para style="q2" vid="PRO 13:24">inzi olia amutonene, aliwamukanda pa musita upalile.<verse eid="PRO 13:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />Mulunghami ali ni bilio byamukumeene,</para>
  <para style="q2" vid="PRO 13:25">inzi kavumo ka mubi kalikaemooka na nzala.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />Mwanakazi wa mulangue aliwakuula nghanda yakue,</para>
  <para style="q2" vid="PRO 14:1">inzi kipuba aliwatuuta nghanda yakue na minue yakue.<verse eid="PRO 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />Olia aliwaenda mu bulunghami bwakue, aliwatiina Yawe,</para>
  <para style="q2" vid="PRO 14:2">inzi olia asili mulunghami mu nzila yakue, aliwamufuupula.<verse eid="PRO 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />Mu kanua ka kipuba muli nfimbo ya kiitoni,</para>
  <para style="q2" vid="PRO 14:3">inzi twebo twa muntu wa mulangue tulitwamusunga.<verse eid="PRO 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />Kine tekuli nghombe, mu mukondo mulimwabula bilio,</para>
  <para style="q2" vid="PRO 14:4">inzi maka a nghombe alialeeta bilio.<verse eid="PRO 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />Musininkizi wa kisinka tavinda kulanda bufi,</para>
  <para style="q2" vid="PRO 14:5">inzi musininkizi wa bufi, mupuza wakue ni bufinke sie.<verse eid="PRO 14:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />Muntu wa kapuni aliwakeba mulangue, ni ye tezi kuusanga,</para>
  <para style="q2" vid="PRO 14:6">inzi bukengezi bulengele ku muntu aliwainika.<verse eid="PRO 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />Fuma ku menso a kipuba,</para>
  <para style="q2" vid="PRO 14:7">pantu ku milomo yakue teukonvuako maano.<verse eid="PRO 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />Mulangue wa muntu wa maano, kulangakana nzila yakue,</para>
  <para style="q2" vid="PRO 14:8">inzi bupuba bwa babipuba, bupomponke sie.<verse eid="PRO 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />Babipuba tebezi kusakamana lubalibabala,</para>
  <para style="q2" vid="PRO 14:9">inzi balunghami balibatona kweleelua na Leza.<verse eid="PRO 14:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />Mutima i umanine bulanda bwakue,</para>
  <para style="q2" vid="PRO 14:10">ni mweni tavinda kwampana nakue mu nsansa yakue.<verse eid="PRO 14:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />Nghanda ya mubi iliyaloviiwa,</para>
  <para style="q2" vid="PRO 14:11">inzi katanda ka mulunghami kalikabeelelela.<verse eid="PRO 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14.12: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:25">Map 16.25</ref>
      </char>
    </note>Kuli nzila imwenekele yaweme ku menso a muntu,</para>
  <para style="q2" vid="PRO 14:12">inzi ku mpeleezio iliyatwala ku lufu.<verse eid="PRO 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />Anzia useka, mutima waya wali ni bulanda.</para>
  <para style="q2" vid="PRO 14:13">Nsansa luiliyapua, palipaiza bulanda.<verse eid="PRO 14:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />Olia aliwabwelela pa kyamba mu mutima wakue, aliwawaminua mu nzila yakue mwine,</para>
  <para style="q2" vid="PRO 14:14">ni mulunghami aliwalambulua na bikitua byakue.<verse eid="PRO 14:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />Kipuba aliwaitabila kubalua kantu,</para>
  <para style="q2" vid="PRO 14:15">inzi wa mulangue aliwakenta pa kunyanta.<verse eid="PRO 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />Wa mulangue aliwatiina Yawe ni kwikeka ku bubi,</para>
  <para style="q2" vid="PRO 14:16">inzi kipuba tezi kwisakamana, kabili aliwakita lubilo lubilo.<verse eid="PRO 14:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />Olia asiliwakokola kufiitua, aliwakita bya bupuba,</para>
  <para style="q2" vid="PRO 14:17">ni onse aliwakita bubi aliwasuulua.<verse eid="PRO 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />Babipuba balibapyana bupuba,</para>
  <para style="q2" vid="PRO 14:18">inzi ba maano balibavwala ngala ya bukengezi.<verse eid="PRO 14:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />Babi balibafwinama ku ntanzi ya balia balibakita biweme,</para>
  <para style="q2" vid="PRO 14:19">ni ba bibalo mu milyango ya balunghami.<verse eid="PRO 14:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />Mupabi aliwasuulua na mupabi nakue,</para>
  <para style="q2" vid="PRO 14:20">inzi munonsi ali ni babibuza bengi.<verse eid="PRO 14:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />Olia aliwapunika mwinakue, aliwaluvia,</para>
  <para style="q2" vid="PRO 14:21">inzi olia aliwaunvwila mupabi nkumbu, asyukile.<verse eid="PRO 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />Eba! Balia balibalangakana bibiipile tebezi kuluvia?</para>
  <para style="q2" vid="PRO 14:22">inzi ntono ni bukisinka bili na balia balibalangakana biweme.<verse eid="PRO 14:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />Kubomba na mute kulikwaleeta kibwezia,</para>
  <para style="q2" vid="PRO 14:23">inzi bulanzi bwa mpuni bulibwaleeta bupabi.<verse eid="PRO 14:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />Ngala ya ba mulangue, bunonsi bwabo,</para>
  <para style="q2" vid="PRO 14:24">inzi bupuba bwa babipuba, bupubanke sie.<verse eid="PRO 14:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />Musininkizi wa kiine aliwapususia mitima ya bantu,</para>
  <para style="q2" vid="PRO 14:25">inzi olia aliwabeepa, aliwaleeta bupompo.<verse eid="PRO 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />Aliwatiina Yawe ali ni maswapi alumine,</para>
  <para style="q2" vid="PRO 14:26">ni baana bakue baakaba ni kwa kubutukila.<verse eid="PRO 14:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />Kutiina Yawe i kasulo ka bukose,</para>
  <para style="q2" vid="PRO 14:27">kabili i kwikeka ku miteo ya lufu.<verse eid="PRO 14:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />Bulumba bwakua likolo, bwingi bwa bantu bakue,</para>
  <para style="q2" vid="PRO 14:28">inzi kukeepa kwa bantu, kwinooneka kwakua kateeka.<verse eid="PRO 14:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />Olia asiliwalenga kufiitua ali ni maano engi,</para>
  <para style="q2" vid="PRO 14:29">inzi olia ali ni mutima wa kasonto aliwalumba bupuba.<verse eid="PRO 14:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />Mutima wa mutende, uliwaleeta bukose bwa mubili,</para>
  <para style="q2" vid="PRO 14:30">inzi bunkua, bulibwabozia bikuza.<verse eid="PRO 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />Olia aliwakyuzia mupabi, aliwatuka Kabumba wabo,</para>
  <para style="q2" vid="PRO 14:31">inzi olia aliwaunvwila nkumbu muntu abulilue, aliwakindika Kabumba.<verse eid="PRO 14:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />Mubi aliwatintilua pansi pa mulandu wa bunkitatubi bwakue,</para>
  <para style="q2" vid="PRO 14:32">inzi mulunghami ali ni maswapi mu kufua kwakue.<verse eid="PRO 14:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />Mu mutima wa muntu ali ni mulangue i muli maano,</para>
  <para style="q2" vid="PRO 14:33">inzi tezi kusangua mu mutima wa babipuba.<verse eid="PRO 14:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />Bulunghami, bulibwakindamika ntundu,</para>
  <para style="q2" vid="PRO 14:34">inzi kibalo, kilikyaleeta lutiipu ku bantu bonse.<verse eid="PRO 14:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />Likolo aliwawaminua na mubombi aliwabomba na mulangue,</para>
  <para style="q2" vid="PRO 14:35">inzi kikonko kyakue kili pa olia aliwakita bintu bisipalile.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />Bwasuko bwa bufuuke bulibwafuukia kipuki,</para>
  <para style="q2" vid="PRO 15:1">inzi twebo twa kusasa tulitwaleeta kipuki.<verse eid="PRO 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Lulimi lwa muntu wa mulangue lulilwaleeta bukengezi ni bulunghami,</para>
  <para style="q2" vid="PRO 15:2">inzi kanua ka kipuba kalikasalanghania bupuba.<verse eid="PRO 15:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />Menso akua Yawe amwene ponse,</para>
  <para style="q2" vid="PRO 15:3">akentele pa babi ni pa baweme.<verse eid="PRO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Lulimi lufuuke, i kimuti kya bukose,</para>
  <para style="q2" vid="PRO 15:4">inzi kiitoni kili mukati kilikyatoobola mutima.<verse eid="PRO 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />Kipuba aliwafuupula mafunde akua se,</para>
  <para style="q2" vid="PRO 15:5">inzi olia ali ni maano aliwakonka nsokezi.<verse eid="PRO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Mu nghanda mwa mulunghami muli bukonto bwingi,</para>
  <para style="q2" vid="PRO 15:6">inzi bunonsi bwa babi, bulibwaleeta lwinoono.<verse eid="PRO 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Milomo ya ba mulangue, iliyasalanghania bukengezi,</para>
  <para style="q2" vid="PRO 15:7">inzi mutima wa babipuba te evio.<verse eid="PRO 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />Ngelelo ya mubi, kilubo kuli Yawe,</para>
  <para style="q2" vid="PRO 15:8">inzi mapepo a mulunghami, aliamusansamusia Yawe.<verse eid="PRO 15:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />Yawe asuulile nzila ya mubi,</para>
  <para style="q2" vid="PRO 15:9">inzi wene atonene olia aliwakonka bulunghami.<verse eid="PRO 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Olia aliwasia nzila iweme, aliwakandua,</para>
  <para style="q2" vid="PRO 15:10">ni asitonene kusokua, aliwafua.<verse eid="PRO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />Kine lufu ni lwinoono bili ku menso akua Yawe,</para>
  <para style="q2" vid="PRO 15:11">paliibufi mitima ya bantu.<verse eid="PRO 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Muntu wa mufuupula, tezi kutona kulungikua,</para>
  <para style="q2" vid="PRO 15:12">kabili tezi kutona kwipuzia muntu wa maano.<verse eid="PRO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Mutima wa nsansa, uliwalangisia lukebu lwa nsansa,</para>
  <para style="q2" vid="PRO 15:13">inzi bulanda bwa mu mutima, bulibwalengia mweo kutooboka.<verse eid="PRO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Mutima wa maano uliwakeba bukengezi,</para>
  <para style="q2" vid="PRO 15:14">Inzi kanua ka babipuba kalikalia bupuba.<verse eid="PRO 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />Nsiku yonse ya muntu aliwaema, ibiipile,</para>
  <para style="q2" vid="PRO 15:15">inzi muntu wa nsansa, ali mu maliila lyonse.<verse eid="PRO 15:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Kyawama kuba ni bunonsi buniini wali ni katiina kuli Yawe,</para>
  <para style="q2" vid="PRO 15:16">kukila kuba ni bunonsi bwingi wali ni lyemo.<verse eid="PRO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Kyawama kulia saasa palia pali ntono,</para>
  <para style="q2" vid="PRO 15:17">kukila kulia nghombe anonene palia pali kukendana.<verse eid="PRO 15:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Muntu wa kipuki kikata aliwalengia mazibo,</para>
  <para style="q2" vid="PRO 15:18">inzi olia asiliwalenga kufiitua, aliwapwisia bikanza.<verse eid="PRO 15:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Nzila ya munanghani isakiluemo myunga,</para>
  <para style="q2" vid="PRO 15:19">inzi nzila ya mulunghami iwamiiziwe.<verse eid="PRO 15:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Mwana wa mulangue aliwamusansamusia se,</para>
  <para style="q2" vid="PRO 15:20">inzi kipuba aliwamufuupula nghina.<verse eid="PRO 15:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Bupuba i nsansa ya muntu asili na maano,</para>
  <para style="q2" vid="PRO 15:21">inzi akengeele aliwawamia lwendo lwakue.<verse eid="PRO 15:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />Kine tekuli nsokezi, butantiko bulibwakilikilua,</para>
  <para style="q2" vid="PRO 15:22">inzi kine pali nsokezi ingi bulibwalunduluka.<verse eid="PRO 15:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Muntu aliwawaminua na bwasuko buweme,</para>
  <para style="q2" vid="PRO 15:23">ni keebo kalikalandua pa musita upalile, kalikakila kuwama.<verse eid="PRO 15:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Nzila ya muntu wa mulangue ilungi mwiulu ku bukose,</para>
  <para style="q2" vid="PRO 15:24">evi tekuti akookele kumbo.<verse eid="PRO 15:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />Yawe aliwatuuta nghanda ya olia ali ni kiitoni,</para>
  <para style="q2" vid="PRO 15:25">inzi aliwabiika mupaka wa musolo wa mwanakazi afwiliilue na mulume.<verse eid="PRO 15:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />Yawe asuulile malanga a babi,</para>
  <para style="q2" vid="PRO 15:26">inzi twebo tuweme tulitwamuwamina.<verse eid="PRO 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Olia aliwatokamua bunonsi, aliwaemia lupua lwakue,</para>
  <para style="q2" vid="PRO 15:27">inzi olia asitonene bituulilo, waakaba mukose.<verse eid="PRO 15:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Mutima wa mulunghami uliwalangakana musango wakwasukilamo,</para>
  <para style="q2" vid="PRO 15:28">inzi kanua ka kipuba kalikafumia bubi.<verse eid="PRO 15:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />Yawe ali kule ni babi,</para>
  <para style="q2" vid="PRO 15:29">inzi aliwaunvua mapepo a mulunghami.<verse eid="PRO 15:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />Kisue kya menso kilikyasansamusia mutima,</para>
  <para style="q2" vid="PRO 15:30">ni mpunda iweme iliyainia bikuza.<verse eid="PRO 15:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />Kutui kulikwatwilizia nsokezi iweme,</para>
  <para style="q2" vid="PRO 15:31">kulikwaikala pa balia bali ni mulangue.<verse eid="PRO 15:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Olia aliwakaana masambilizio, aliwaisuula ye mwine,</para>
  <para style="q2" vid="PRO 15:32">inzi olia aliwaunvua lu-aliwasasililua, aliwakengela.<verse eid="PRO 15:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />Kutiina Yawe i masambilizio a mulangue,</para>
  <para style="q2" vid="PRO 15:33">ni bufuuke, bulibwatangilila mukinzi.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Mapange a mu mutima, ni obe we mwine,</para>
  <para style="q2" vid="PRO 16:1">inzi keebo ka mpeleezio kali na Yawe.<verse eid="PRO 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Nzila ya muntu, imuwamiine ye mwine,</para>
  <para style="q2" vid="PRO 16:2">inzi Yawe aliwatoosia mutima.<verse eid="PRO 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Mubiikile Yawe miilo yobe,</para>
  <para style="q2" vid="PRO 16:3">ni mapange obe alikufikiliziiwa.<verse eid="PRO 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />Yawe ali ni ki-aakitiile kubalua kantu,</para>
  <para style="q2" vid="PRO 16:4">nga evelia babi ni bo pa musita wa lwinoono.<verse eid="PRO 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />Yawe asuulile kubalua muntu ali ni mutima wa kiitoni,</para>
  <para style="q2" vid="PRO 16:5">kisinka mubi takabula kukandua.<verse eid="PRO 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Kupitila mu ntono ni bukisinka, bubi bulibwaeleelua.</para>
  <para style="q2" vid="PRO 16:6">Ni mu kutiina Yawe, bantu balibaikeka ku bubi.<verse eid="PRO 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Nzila ya muntu luiliyamuwamina Yawe,</para>
  <para style="q2" vid="PRO 16:7">Yawe aliwamupwanika na balwani bakue.<verse eid="PRO 16:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Kyawama kuba ni bunonsi buniini wali ni bulunghami,</para>
  <para style="q2" vid="PRO 16:8">kukila kuba ni bunonsi bwingi wali ni bubi.<verse eid="PRO 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Mutima wa muntu, uliwalangakana muutoneene,</para>
  <para style="q2" vid="PRO 16:9">inzi Yawe i aliwalombola ntanfu yakue.<verse eid="PRO 16:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Milomo yakua likolo iliyalanda bulanzi bwa kileza,</para>
  <para style="q2" vid="PRO 16:10">ni kanua kakue tekezi kuluvia mu bupinguzi.<verse eid="PRO 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Kalingo ni bilemo bya nsambu ni byakua Yawe,</para>
  <para style="q2" vid="PRO 16:11">mabue ali mu mufuko a kulingilako, ni miilo yakue.<verse eid="PRO 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />Kukita bubi, kilubo ku makolo,</para>
  <para style="q2" vid="PRO 16:12">pantu kitebe kya bukolo kilikyateekua mu bulunghami.<verse eid="PRO 16:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Milomo ya bulunghami, nsansa ya makolo,</para>
  <para style="q2" vid="PRO 16:13">ni balia bamutonene, balibalanda bilungi.<verse eid="PRO 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Kipuki kyakua likolo, mukenzi wa lufu,</para>
  <para style="q2" vid="PRO 16:14">inzi muntu wa mulangue aliwakifuukia.<verse eid="PRO 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Mu kubenghema kwa lukebu lwakua likolo muli bukose,</para>
  <para style="q2" vid="PRO 16:15">ni buwame bwakue buli nga malezi a nvula ya mpeleezio.<verse eid="PRO 16:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />Kyawama kuba ni mulangue kukila oro.</para>
  <para style="q2" vid="PRO 16:16">Ee, kipalile kusaakula maano kukila mutofue.<verse eid="PRO 16:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Nzila ikata ya mulunghami, ni kwikeka ku bubi.</para>
  <para style="q2" vid="PRO 16:17">Olia akonkele nzila yakue, asungile mutima wakue.<verse eid="PRO 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Kiitoni kilikyatangilila lwinoono,</para>
  <para style="q2" vid="PRO 16:18">ni mutima wa kwitantamuna uliwatangilila kupona.<verse eid="PRO 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Kyawama kuya wafuukile wali mupabi,</para>
  <para style="q2" vid="PRO 16:19">kukila kupaana bunonsi wali ni kiitoni.<verse eid="PRO 16:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Olia aliwasunga mafunde, aliwalunduluka,</para>
  <para style="q2" vid="PRO 16:20">ni aswapiile Yawe, ali ni lisyuko.<verse eid="PRO 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Olia ali ni mutima wa mulangue, aliwakuutua wa maano,</para>
  <para style="q2" vid="PRO 16:21">ni kuwama kwa bulanzi, kulikwalunduluzia kumana.<verse eid="PRO 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Olia ali ni mulangue, ali ni kasulo ka bukose,</para>
  <para style="q2" vid="PRO 16:22">inzi babipuba balibakandua mu bupuba bwabo.<verse eid="PRO 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Mutima wa muntu wa mulangue, uliwasambilizia kanua kakue,</para>
  <para style="q2" vid="PRO 16:23">kabili uliwalunduluzia maano a lulimi lwakue.<verse eid="PRO 16:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Twebo tuweme tuli nga kapelo,</para>
  <para style="q2" vid="PRO 16:24">ni to tulitwawamia mutima ni kukosia bikuza.<verse eid="PRO 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16.25: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:12">Map 14.12</ref>
      </char>
    </note>Kuli nzila imwenekele yaweme ku menso a muntu,</para>
  <para style="q2" vid="PRO 16:25">inzi ku mpeleezio iliyatwala ku lufu.<verse eid="PRO 16:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Nzala ya mubombi iliyamulengia kubomba,</para>
  <para style="q2" vid="PRO 16:26">pantu nkulu ya kanua kakue iliyamuleetela mute wa kubomba.<verse eid="PRO 16:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Muntu asili na kibwezia aliwaimba kiina kya bubi,</para>
  <para style="q2" vid="PRO 16:27">ni mumbali milomo yakue muli nga muli mulilo uliwazizyania.<verse eid="PRO 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Muntu mubi, aliwaleeta mazibo,</para>
  <para style="q2" vid="PRO 16:28">ni olia wa busongezi, aliwapusania babibuza.<verse eid="PRO 16:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Muntu aliwakyuzyania aliwabembia mwinakue,</para>
  <para style="q2" vid="PRO 16:29">ni kumulombola mu nzila isiweme.<verse eid="PRO 16:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Olia aliwakapia na linso, aliwakambila kukita bibiipile,</para>
  <para style="q2" vid="PRO 16:30">ni olia aliwasumba milomo yakue, aliwalanda bibiipile.<verse eid="PRO 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Ndale, i ngala ya bulumba,</para>
  <para style="q2" vid="PRO 16:31">iliyasangua sie mu nzila ya bulunghami.<verse eid="PRO 16:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Olia asiliwalenga kufiitua, aweme kukila wa buvinde,</para>
  <para style="q2" vid="PRO 16:32">ni olia aliwateeka mutima wakue, aweme kukila olia aliwasakukila muzi.<verse eid="PRO 16:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />Bubale bulibwateelua pa kibeta,</para>
  <para style="q2" vid="PRO 16:33">inzi bupinguzi bonse bulibwafuma kuli Yawe.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />Kyawama kulia bilio byume wali ni mutende,</para>
  <para style="q2" vid="PRO 17:1">kukila nghanda ilimo maliila engi mwali ni mazibo.<verse eid="PRO 17:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Mubombi wa maano aliwateeka bwino mwana aliwakita bintu bya busoni,</para>
  <para style="q2" vid="PRO 17:2">ni ye waakabamo ni nsempu ya bupyani nga wa mu lupua.<verse eid="PRO 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Mupika, i wakusungulwilamo mutofue, ni kikuka kya mulilo, i kya kwapikamo oro,</para>
  <para style="q2" vid="PRO 17:3">inzi Yawe aliwatoosia mitima.<verse eid="PRO 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Nkitatubi aliwatwilizia milomo ya bubi,</para>
  <para style="q2" vid="PRO 17:4">ni wa bufi aliwatwilizia lulimi lubi.<verse eid="PRO 17:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Olia aliwakyuzia mupabi, aliwatuka Kabumba wabo,</para>
  <para style="q2" vid="PRO 17:5">ni olia aliwasekelela busanzo, takabula kukandua.<verse eid="PRO 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Ngala ya bakote, benzikulu,</para>
  <para style="q2" vid="PRO 17:6">ni bulumba bwa baana, ba sibo.<verse eid="PRO 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Bulanzi buweme tebwawama mu kanua ka kipuba,</para>
  <para style="q2" vid="PRO 17:7">paliibufi milomo yakua kateeka iliyabeepa.<verse eid="PRO 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Kituulilo kili nga lyese ku menso akua olia aliwapaana.</para>
  <para style="q2" vid="PRO 17:8">Konse kualikukibombia kilikumuleetela kibwezia.<verse eid="PRO 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Olia aliwavimba pa kilubo, aliwakeba ntono,</para>
  <para style="q2" vid="PRO 17:9">inzi olia aliwabweluluka pa keebo kamonke, aliwasalanghania babibuza.<verse eid="PRO 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Kusasililua kulikwapokelelua mu mutima wa olia ali ni maano,</para>
  <para style="q2" vid="PRO 17:10">kukila nfimbo 100 ku kipuba.<verse eid="PRO 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Muntu mubi aliwakeba sie kwisangula kuli Leza,</para>
  <para style="q2" vid="PRO 17:11">ni pakako, aliwatuminua mukenzi asasile.<verse eid="PRO 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Kyawama kusaakaana ni kimbui mukota kipokelue baana,</para>
  <para style="q2" vid="PRO 17:12">kukila kusaakaana ni kipuba mu bupuba bwakue.<verse eid="PRO 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Olia aliwabwezia bubi pa biweme,</para>
  <para style="q2" vid="PRO 17:13">bubi tebukapua mu nghanda yakue.<verse eid="PRO 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Ntendeko ya mazibo ili nga kulekelela menda apanguke.</para>
  <para style="q2" vid="PRO 17:14">Kansi lekele bikanza lubisinamifikie ku mazibo.<verse eid="PRO 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Olia aliwapeela mubi nsambu ni kumutana mulunghami nsambu,</para>
  <para style="q2" vid="PRO 17:15">bonse babili, kilubo kuli Yawe.<verse eid="PRO 17:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Ale nfolanga ibeeleeleki mu minue ya kipuba kuti asite mulangue,</para>
  <para style="q2" vid="PRO 17:16">ni ye tekuba wali na maano?<verse eid="PRO 17:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Kibuza aweme, ni kibuza wa kubalua busiku,</para>
  <para style="q2" vid="PRO 17:17">inzi wa mu lupua aliwavyalua kuti akwasie musita wa lyemo.<verse eid="PRO 17:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Muntu asili na maano aliwalaya</para>
  <para style="q2" vid="PRO 17:18">ni kwipeela kulipa mizia ya mwinakue.<verse eid="PRO 17:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Olia atonene mazibo, atonene bibalo,</para>
  <para style="q2" vid="PRO 17:19">ni olia aliwaitantamuna, aliwakeba lwinoono.<verse eid="PRO 17:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />Olia akosele mutima, tezi kumona buwame,</para>
  <para style="q2" vid="PRO 17:20">ni olia ali ni lulimi lwa kiitoni, aliwaponena mu bwavia.<verse eid="PRO 17:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Olia avyele kipuba, bulanda bwakue mwine,</para>
  <para style="q2" vid="PRO 17:21">se kwa kipuba, tali na nsansa.<verse eid="PRO 17:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Mutima wa nsansa, miti iweme,</para>
  <para style="q2" vid="PRO 17:22">inzi mutima uliwatooboka, uliwaumia bikuza.<verse eid="PRO 17:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Muntu mubi aliwapokelela kituulilo mu kafiso</para>
  <para style="q2" vid="PRO 17:23">pakuti avulunghanie bupinguzi.<verse eid="PRO 17:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Maano ali ku ntanzi ya muntu ali ni mulangue,</para>
  <para style="q2" vid="PRO 17:24">inzi menso a kipuba afikile kupelele kyalo.<verse eid="PRO 17:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Mwana kipuba, bulanda kuli se,</para>
  <para style="q2" vid="PRO 17:25">kabili ni kikonko kuli nghina waamuvyele.<verse eid="PRO 17:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Kukanda mulunghami tekuweme,</para>
  <para style="q2" vid="PRO 17:26">ao kuuma babiloolo tekuweme.<verse eid="PRO 17:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Olia aliwasunga twebo twakue, akengeele,</para>
  <para style="q2" vid="PRO 17:27">ni olia ateekameene mutima, ali ni maano.<verse eid="PRO 17:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Mupuba ni ye kine waikala tondolo, alikumonua kuba ni mulangue,</para>
  <para style="q2" vid="PRO 17:28">lu-aliwamuma kanua kakue, aliwamonua kuba ni maano.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />Olia aliwaikeka ku benakue aliwakeba kukita mu-atoneene,</para>
  <para style="q2" vid="PRO 18:1">kabili aliwafiitua lu-aliwasokua.<verse eid="PRO 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Kipuba tezi kuwaminua na maano,</para>
  <para style="q2" vid="PRO 18:2">inga sie kukita mutoneene mutima wakue.<verse eid="PRO 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Mubi lu-aliwaiza, ni mufuupula ni o uliwaiza,</para>
  <para style="q2" vid="PRO 18:3">ni pa kyamba kya busoni, kuleebulua.<verse eid="PRO 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Twebo twa mu kanua ka muntu, buziba buzikile,</para>
  <para style="q2" vid="PRO 18:4">kasulo ka mulangue, menda a kaezi aliaenda.<verse eid="PRO 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Kukita kitoolela ku mubi tekuweme,</para>
  <para style="q" vid="PRO 18:5">ao kumutana nsambu mulunghami musita wa bupinguzi.<verse eid="PRO 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Milomo ya kipuba iliyafikyania ku bikanza,</para>
  <para style="q2" vid="PRO 18:6">ni kanua kakue kalikakuuta bipumo.<verse eid="PRO 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Kanua ka kipuba ni lwinoono lwakue,</para>
  <para style="q2" vid="PRO 18:7">ni milomo yakue ni muteo wa kukwatuamo ye mwine.<verse eid="PRO 18:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />Twebo twa musongezi tuli nga bisoso bya bilio biweme,</para>
  <para style="q2" vid="PRO 18:8">bisoso bilibyakookela munda.<verse eid="PRO 18:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Olia anangheene mu miilo,</para>
  <para style="q2" vid="PRO 18:9">i lupua lwakua nghinooni.<verse eid="PRO 18:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />Liina lyakua Yawe, kyubo kilumine.</para>
  <para style="q2" vid="PRO 18:10">Mulunghami kine wabutukilako, alikuya wali ni mutende.<verse eid="PRO 18:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />Munonsi amwene nangue bunonsi i kyubo kyakue kya maka.</para>
  <para style="q2" vid="PRO 18:11">Alangakeene nangue i kibumba kimusungile.<verse eid="PRO 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Kwinooneka kwa muntu kulikwatangililua na kiitoni.</para>
  <para style="q2" vid="PRO 18:12">Ni kwikeefia kulikwatangililua na mukinzi.<verse eid="PRO 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Kwasuka lu-usinaunvue,</para>
  <para style="q2" vid="PRO 18:13">bupuba ni busoni.<verse eid="PRO 18:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Mweo wa muntu uliwasipikizia malwele,</para>
  <para style="q2" vid="PRO 18:14">kubako kuli ni alikuvinda kuteekamania mutima utoobokele?<verse eid="PRO 18:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Mutima wa muntu wa maano uliwakeba bukengezi,</para>
  <para style="q2" vid="PRO 18:15">ni kutui kwa muntu wa mulangue kuli kwakeba maano.<verse eid="PRO 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Kyabupe kya muntu kilikyamwizwila nzila,</para>
  <para style="q2" vid="PRO 18:16">ni kumuleeta ku menso a bantu bakulu.<verse eid="PRO 18:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Olia aliwaipokolola wa mambo aliwamoneka wali ni nsambu,</para>
  <para style="q2" vid="PRO 18:17">inga sie kine unge waiza kutoosia twebo twakue.<verse eid="PRO 18:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Kuteya bubale kulikwapwisia bikanza,</para>
  <para style="q2" vid="PRO 18:18">ni kupingula milandu ya bakulu.<verse eid="PRO 18:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Muntu aluviiziwe na wa kwakue, aliwafinia mutima kukila muzi uli ni kibumba,</para>
  <para style="q2" vid="PRO 18:19">ni bikanza bili nga minkolonto ya milyango ya ku kyubo.<verse eid="PRO 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Kavumo ka muntu kalikaikusiiwa na mazabo a mu kanua kakue,</para>
  <para style="q2" vid="PRO 18:20">kabili aliwaikuta mazabo a ku milomo yakue.<verse eid="PRO 18:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Lufu ni bukose bili mu buvinde bwa lulimi,</para>
  <para style="q2" vid="PRO 18:21">ni balia babutonene, balibalia mazabo akue.<verse eid="PRO 18:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Olia aliwaupa mwanakazi, aliwasanga kintu kiweme.</para>
  <para style="q2" vid="PRO 18:22">Aliwapokelela buwame kufuma kuli Yawe.<verse eid="PRO 18:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Mupabi aliwalanda wapaapaata,</para>
  <para style="q2" vid="PRO 18:23">inzi munonsi aliwa-asuka wasasile.<verse eid="PRO 18:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Olia ali ni babibuza bengi, aliwaileetelela lwinoono,</para>
  <para style="q2" vid="PRO 18:24">inzi kuli ni kibuza aliwa-ampana na muntu kukila lupua lwakue.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />Kyawama mupabi aliwaenda mu bulunghami bwakue,</para>
  <para style="q2" vid="PRO 19:1">kukila kipuba ali ni kiitoni mu bulanzi.<verse eid="PRO 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Muntu tapalile kubulua maano,</para>
  <para style="q2" vid="PRO 19:2">ni olia aliwaya lubilo lubilo aliwaipuutala.<verse eid="PRO 19:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Muntu aliwailovia mu bupuba bwakue,</para>
  <para style="q2" vid="PRO 19:3">inzi mutima wakue uliwamufiitilua Yawe.<verse eid="PRO 19:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Bunonsi bulibwavuzia bibuza,</para>
  <para style="q2" vid="PRO 19:4">inzi mupabi aliwakaanua na bapabi nakue.<verse eid="PRO 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Musininkizi wa bufi, takabula kukandua,</para>
  <para style="q2" vid="PRO 19:5">ni olia aliwalanda bufi takapusuka.<verse eid="PRO 19:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Bengi balibapaapaata ku bakindami,</para>
  <para style="q2" vid="PRO 19:6">inzi kubalua muntu, kibuza wa muntu aliwapaana.<verse eid="PRO 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Lupua lonse lwa mupabi lulilwamusuula,</para>
  <para style="q2" vid="PRO 19:7">paliibufi babibuza bakue, i balibakila sie kuya kule ni kumusia!</para>
  <para style="q2" vid="PRO 19:7">Mupabi anzia kine wabelambilizia tebamunvua.<verse eid="PRO 19:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Olia ali ni mulangue, atonene bukose bwakue,</para>
  <para style="q2" vid="PRO 19:8">ni olia ali ni kyunvwila, aliwamona buwame.<verse eid="PRO 19:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Musininkizi wa bufi takabula kukandua,</para>
  <para style="q2" vid="PRO 19:9">ni olia aliwalanda bufi aliwazeeza.<verse eid="PRO 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Bwikazi buweme tebupalile ku kipuba,</para>
  <para style="q2" vid="PRO 19:10">paliibufi muzia kuteeka bakindami.<verse eid="PRO 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Wa mulangue tezi kulenga kufiitua.</para>
  <para style="q2" vid="PRO 19:11">Kweleela kilubo, i bulumba bwakue.<verse eid="PRO 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Kipuki kyakua likolo kili nga kubuluma kwa nkalamu,</para>
  <para style="q2" vid="PRO 19:12">inzi ntono yakue ili nga lume ku bikusi.<verse eid="PRO 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Mwana kipuba, kukeepelua kwakua se,</para>
  <para style="q2" vid="PRO 19:13">ni bikanza bya mukazi, bili nga matooni asiliapua.<verse eid="PRO 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Nghanda pamo ni bunonsi, bupyani bulibwafuma ku muvyazi,</para>
  <para style="q2" vid="PRO 19:14">inzi mukazi wa maano aliwafuma kuli Yawe.<verse eid="PRO 19:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Muleele uliwaleeta tulo twingi,</para>
  <para style="q2" vid="PRO 19:15">ni munanghani aliwaema na nzala.<verse eid="PRO 19:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Olia aliwakonka mafunde, aliwasunga bukose bwakue,</para>
  <para style="q2" vid="PRO 19:16">inzi olia asiliwakonka nzila yakue, waakafua.<verse eid="PRO 19:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Olia aliwakwasia mupabi, aliwamukopia Yawe,</para>
  <para style="q2" vid="PRO 19:17">ni Yawe aliwamulambula pa bikitua byakue biweme.<verse eid="PRO 19:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Kanda mwana obe maswapi lu-akiliko,</para>
  <para style="q2" vid="PRO 19:18">kine teumukwasiizie, wamukwasia kwinooneka.<verse eid="PRO 19:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Muntu wa kipuki kikata, apalile kukandua,</para>
  <para style="q2" vid="PRO 19:19">kine wewe wamukwasia, wakaba kumukwasia ni linge.<verse eid="PRO 19:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Twilizia nsokezi ni kupokelela mafunde,</para>
  <para style="q2" vid="PRO 19:20">evi ku mpeleezio ukabe ni mulangue.<verse eid="PRO 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Mu mutima wa muntu muli mapange engi,</para>
  <para style="q2" vid="PRO 19:21">inzi kitonene Yawe i kilikyafikiliziiwa.<verse eid="PRO 19:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Kikebekele ku muntu, kuya wali wa kisinka,</para>
  <para style="q2" vid="PRO 19:22">mupabi aweme kukila wa bufi.<verse eid="PRO 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Kutiina Yawe kulikwatwala ku bukose,</para>
  <para style="q2" vid="PRO 19:23">ni olia aliwamutiina, aliwaya waikeele waikusi,</para>
  <para style="q2" vid="PRO 19:23">ni bubi tebukamupalamina.<verse eid="PRO 19:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Munanghani aliwabiika kuboko kwakue mu nsaani,</para>
  <para style="q2" vid="PRO 19:24">ni kwandua kutwala pa kanua kakue.<verse eid="PRO 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Uma muntu wa kapuni pakuti babipuba basambilileko maano,</para>
  <para style="q2" vid="PRO 19:25">kabili sasilila olia amanine, pakuti abe ni bukengezi.<verse eid="PRO 19:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Mwana aliwaemia se ni kukumba nghina,</para>
  <para style="q2" vid="PRO 19:26">aliwaleetelana busoni ni mufuupula.<verse eid="PRO 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />We mwana wane, kine walekela kutwilizia mafunde</para>
  <para style="q2" vid="PRO 19:27">ulikusangukila twebo twa mulangue.<verse eid="PRO 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Musininkizi asipalile, aliwafuupula bupinguzi,</para>
  <para style="q2" vid="PRO 19:28">ui tunua twa babi tulitwazakila bubi.<verse eid="PRO 19:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Kukandua kuteaniiziwe pa balia bali ni mufuupula,</para>
  <para style="q2" vid="PRO 19:29">ni bipumo mu musana wa babipuba.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />Divai i kapuni, ni kikolani i mazibo,</para>
  <para style="q2" vid="PRO 20:1">ni muntu onse aliwabembua mu bebi bintu tali na mulangue.<verse eid="PRO 20:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />Kipuki kyakua likolo, kili nga kubuluma kwa nkalamu,</para>
  <para style="q2" vid="PRO 20:2">olia aliwamulengia kufiitua, aliwaluvia mutima wakue mwine.<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Bukindami bwa muntu, kulekela mazibo,</para>
  <para style="q2" vid="PRO 20:3">inzi kubalua kipuba aliwatona mazibo.<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Munanghani tezi kutona kulima pa musita wa kulima,</para>
  <para style="q2" vid="PRO 20:4">ni pakako, musita wa buzombozi waya walombelezia bilio pantu tali na kantu.<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />Malanga a mu mutima wa muntu, buziba buzikile,</para>
  <para style="q2" vid="PRO 20:5">inzi muntu wa mulangue aliwatapulapo.<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Kubalua muntu aliwalanda buwame bwakue,</para>
  <para style="q2" vid="PRO 20:6">ale muntu wa kisinka alikumonua nani?<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Kine mulunghami waendela mu bulunghami bwakue,</para>
  <para style="q2" vid="PRO 20:7">baana bakue balibapaalua mu kyamba kyakue.<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Likolo lu-aliwaikala pa kitebe kya bupinguzi,</para>
  <para style="q2" vid="PRO 20:8">aliwauluzia bubi bonse na menso akue.<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />Nani alikuvinda kulanda nangue, “Nakiswesia mutima wane,</para>
  <para style="q2" vid="PRO 20:9">nakisambika ku bibalo byane?”<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Mabue a tulingo tulekenkeene, ni bilemo bilekenkeene,</para>
  <para style="q2" vid="PRO 20:10">bebi byonse bibili, bilubo kuli Yawe.<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Mwana ni ye aliwamanika kupitila mu bikitua byakue,</para>
  <para style="q2" vid="PRO 20:11">kine biweme, ao kine bilungi.<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Kutui kulikwaunvua, ni linso lililyamona,</para>
  <para style="q2" vid="PRO 20:12">byonse bibili bikitilue na Yawe.<verse eid="PRO 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Tekutonesia tulo, ukeeza kukula wali mupabi,</para>
  <para style="q2" vid="PRO 20:13">labuka, ni we ulikwikuta bilio.<verse eid="PRO 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />“Temuli kantu, temuli kantu!” Nangue musiti,</para>
  <para style="q2" vid="PRO 20:14">inzi aliwaitasia wasyaile.<verse eid="PRO 20:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PRO 20:15" />Kuli oro ni mabue engi a mutengo,</para>
  <para style="q2" vid="PRO 20:15">inzi milomo iliyalanda twebo twa maano, libue lya mutengo.<verse eid="PRO 20:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Muntu kine walaya kulipila mizia ya muntu asimanikile, apokueko ngubo yakue nga kikwatizi,</para>
  <para style="q2" vid="PRO 20:16">mumukite kuba kikwatizi pa mulandu wa ozo mweni.<verse eid="PRO 20:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Kya kulia kya bupoti, kiweme ku muntu,</para>
  <para style="q2" vid="PRO 20:17">inzi pa kyamba, kanua kakue kalikaizulamo tubwekese.<verse eid="PRO 20:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Kine pali nsokezi mapange aliafikiliziiwa,</para>
  <para style="q2" vid="PRO 20:18">kine watona kusakukilana, upalile kulangakananke.<verse eid="PRO 20:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Olia aliwapitaana wa-ambana, aliwafyula tufiso,</para>
  <para style="q2" vid="PRO 20:19">kansi tekwampana na kilandelande.<verse eid="PRO 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Olia aliwatiipa se ao nghina,</para>
  <para style="q2" vid="PRO 20:20">kisue kya bukose bwakue kyaazimiiwa musita wa nfinzi ikata.<verse eid="PRO 20:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Bupyani bulibwalombua ntanzi ya nsita,</para>
  <para style="q2" vid="PRO 20:21">ku mpeleezio tebukaba na mapaalo.<verse eid="PRO 20:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Tekulanda nangue, “Ndikukita kibwelezi!”</para>
  <para style="q2" vid="PRO 20:22">Muswapile Yawe, akupususie.<verse eid="PRO 20:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />Mabue a tulingo tulekenkeene, kilubo kuli Yawe,</para>
  <para style="q2" vid="PRO 20:23">ni bilemo bya bupoti tebifwaniine.<verse eid="PRO 20:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />Ntanfu ya muntu iliyalombolua na Yawe,</para>
  <para style="q2" vid="PRO 20:24">ale muntu kuti wamana syani nzila yakue mwine?<verse eid="PRO 20:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />Kulanda lubilo lubilo nangue keki ni kya kupeela Leza, muteo,</para>
  <para style="q2" vid="PRO 20:25">pantu kuti waiza kwemenamo.<verse eid="PRO 20:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Likolo wa mulangue aliwauluzia babi,</para>
  <para style="q2" vid="PRO 20:26">aliwabapingula pasili nkumbu.<verse eid="PRO 20:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />Mweo wa muntu, i musaniko wakua Yawe,</para>
  <para style="q2" vid="PRO 20:27">i uliwakebelezia mu nkendo yonse ya mukati ka muntu.<verse eid="PRO 20:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Ntono ni bukisinka bilibyamusunga likolo,</para>
  <para style="q2" vid="PRO 20:28">ni bukolo bwakue busimpilue na ntono.<verse eid="PRO 20:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Bulumba bwa balumendo, maka abo.</para>
  <para style="q2" vid="PRO 20:29">Kuwama kwa bakote, mutue wa ndale.<verse eid="PRO 20:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Bipumo ni bilonda, ni miti yakupwisia bubi.</para>
  <para style="q2" vid="PRO 20:30">Nfimbo iliyaswesia mutima mpaka mukati.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />Mutima wakua likolo uli mu minue yakua Yawe nga vili tunkolonfua twa menda,</para>
  <para style="q2" vid="PRO 21:1">aliwaulombola konse ku atonene.<verse eid="PRO 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Kubalua nzila ya muntu, iweme ku menso akue mwine.</para>
  <para style="q2" vid="PRO 21:2">Inzi Yawe aliwatoosia mitima.<verse eid="PRO 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />Kukita biweme ni bilungi,</para>
  <para style="q2" vid="PRO 21:3">kulikwamuwamina Yawe kukila ngelelo.<verse eid="PRO 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Menso a kiitoni ni mutima wa kwitantamuna,</para>
  <para style="q2" vid="PRO 21:4">kilangililo kya bibalo bya bantu babi.<verse eid="PRO 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Mapange a muntu wa mute, alialeeta bunonsi bwingi,</para>
  <para style="q2" vid="PRO 21:5">inzi kubalua muntu aliwakita lubilo lubilo, bupabi bulibwaiza pali wene.<verse eid="PRO 21:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Bunonsi bulibwanonkelua mu bufi,</para>
  <para style="q2" vid="PRO 21:6">byunsi bilibyaya kiyeyeye.</para>
  <para style="q2" vid="PRO 21:6">Balia balibabukeba, balibakeba lufu.<verse eid="PRO 21:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Bupoti bwa babi bulibwabatwala kule,</para>
  <para style="q2" vid="PRO 21:7">pantu balibakaana kukita bulunghami.<verse eid="PRO 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Nzila ya muntu emanine nangue ali ni bilubo, ipeteeme,</para>
  <para style="q2" vid="PRO 21:8">inzi mibeele ya muntu asili na mulandu ili bwino.<verse eid="PRO 21:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />Kyawama kwikala mu kafuli ka mutenge wa nghanda,</para>
  <para style="q2" vid="PRO 21:9">kukila kwikala mu nghanda pamo ni mukazi wa mazibo.<verse eid="PRO 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Muntu mubi, aliwakeba bubi,</para>
  <para style="q2" vid="PRO 21:10">kabili tezi kunvwila mwinakue nkumbu.<verse eid="PRO 21:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Muntu wa kapuni lu-aliwakandua, kipuba aliwa-aluka ni mulangue,</para>
  <para style="q2" vid="PRO 21:11">ni wa mulangue lu-aliwasambiliziiwa, aliwalunduluka kuba ni maano.<verse eid="PRO 21:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Mulunghami amanine bili mu nghanda ya babi,</para>
  <para style="q2" vid="PRO 21:12">kabili aliwabalovia ni kubenoona.<verse eid="PRO 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Olia aliwakilika matui tekuti onvue kulila kwa mupabi,</para>
  <para style="q2" vid="PRO 21:13">ni ye waakalila, inzi takonvwiwa.<verse eid="PRO 21:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Bupe bwa mu kafiso bulibwapwisia kikonko,</para>
  <para style="q2" vid="PRO 21:14">ni kituulilo kya mu kafiso kilikyapwisia kipuki.<verse eid="PRO 21:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Bupinguzi bwa nsambu lubulibwakitika, balunghami balibawaminua,</para>
  <para style="q2" vid="PRO 21:15">inzi bankitatubi balibaswapulukua.<verse eid="PRO 21:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Olia aliwaemooka ni kusia nzila ya maano,</para>
  <para style="q2" vid="PRO 21:16">aliwaisanga walimukutuuzia mu libumba lya bafwile.<verse eid="PRO 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Olia atonene maliila, aliwa-aluka mupabi.</para>
  <para style="q2" vid="PRO 21:17">Olia atonene divai ni mafuta takanonka.<verse eid="PRO 21:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Mubi i bupusuko bwa mulunghami,</para>
  <para style="q2" vid="PRO 21:18">ni olia aliwakita bupompo, bupusuko bwa muntu wa kisinka.<verse eid="PRO 21:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />Kyawama kwikala mu kaseeba,</para>
  <para style="q2" vid="PRO 21:19">kukila kwikala pamo ni mukazi wa mazibo ni musokozi.<verse eid="PRO 21:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Mu bwikazi bwa bantu ba maano muli bukonto bwa mponvu ni mafuta,</para>
  <para style="q2" vid="PRO 21:20">inzi kipuba aliwalia byonse.<verse eid="PRO 21:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Olia aliwakonka bulunghami ni ntono,</para>
  <para style="q2" vid="PRO 21:21">aliwasanga bukose ni bulunghami pamo ni mukinzi.<verse eid="PRO 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Muntu wa mulangue aliwakwata muzi wa bantu ba maka</para>
  <para style="q2" vid="PRO 21:22">ni kutuuta kyubo kya maswapi abo.<verse eid="PRO 21:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Olia aliwakilikila kanua kakue ni lulimi lwakue,</para>
  <para style="q2" vid="PRO 21:23">aliwapususia mutima wakue ku bukyuzi.<verse eid="PRO 21:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Muntu wa kiitoni ni aliwaitantamuna, liina lyakue ni “Mupuni.”</para>
  <para style="q2" vid="PRO 21:24">Kwitantamuna kwakue ni kwa kiitoni.<verse eid="PRO 21:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Kutokamua kwa munanghani kulikwamwipaya,</para>
  <para style="q2" vid="PRO 21:25">pantu maboko akue aliakaana kubomba.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Munanghani aliwakeba koba konse,</para>
  <para style="q2" vid="PRO 21:26">inzi mulunghami aliwapaana sie pasili kutanana.<verse eid="PRO 21:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Ngelelo ya mubi, kilubo kikata.</para>
  <para style="q2" vid="PRO 21:27">Paliibufi kine aliwaelela na malanga abi!<verse eid="PRO 21:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Musininkizi wa bufi, aliwazeeza,</para>
  <para style="q2" vid="PRO 21:28">inzi muntu ali ni matui, aliwalanda twebo tulitwatwalilila.<verse eid="PRO 21:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Mubi aliwaumia pa mpala,</para>
  <para style="q2" vid="PRO 21:29">inzi mulunghami aliwawamia nzila yakue.<verse eid="PRO 21:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Tekuli mulangue ao bukengezi ao nsokezi</para>
  <para style="q2" vid="PRO 21:30">iliyavinda kutwalilila musitoneene Yawe.<verse eid="PRO 21:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Farasi ateaniziiziwe mbeela mu busiku bwa bului,</para>
  <para style="q2" vid="PRO 21:31">inzi Yawe i aliwaleeta bwanzio.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />Kyawama kuba ni bulumba kukila kuba ni bunonsi bwingi.</para>
  <para style="q2" vid="PRO 22:1">Ni kwitabilua kuweme kukila kuba ni mutofue pamo ni oro.<verse eid="PRO 22:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Kintu kimo kili na munonsi ni mupabi ni keki:</para>
  <para style="q2" vid="PRO 22:2">Yawe i Kabumba wabo.<verse eid="PRO 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Mukengezi aliwamona bubi ni kufyama,</para>
  <para style="q2" vid="PRO 22:3">inzi babipuba balibaya sie ku ntanzi mpaka baikisia.<verse eid="PRO 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Kunakila ni kumutiina Yawe</para>
  <para style="q2" vid="PRO 22:4">kulikwaleeta bunonsi, ni mukinzi pamo ni bukose.<verse eid="PRO 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Myunga ni tukose, bili mu nzila ya bafinine mitima,</para>
  <para style="q2" vid="PRO 22:5">inzi olia asungile mutima wakue, alikuba wali kule nabio.<verse eid="PRO 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Sambilizia mwana nzila i apalile kukonka,</para>
  <para style="q2" vid="PRO 22:6">pantu anzia akakota takafumamo.<verse eid="PRO 22:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Mupabi, aliwateekua na munonsi,</para>
  <para style="q2" vid="PRO 22:7">ni mukopi, mubombi wa olia aliwakopia.<verse eid="PRO 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Olia aliwabyala bubi, aliwazombola bwavia,</para>
  <para style="q2" vid="PRO 22:8">ni nfimbo yakue ya kukandilanako ilikutyoka.<verse eid="PRO 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Muntu wa buntu, aliwapaalua,</para>
  <para style="q2" vid="PRO 22:9">pantu aliwakasania bapabi bilio byakue.<verse eid="PRO 22:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Kumba wa kapuni ni mazibo alikupua.</para>
  <para style="q2" vid="PRO 22:10">Ee, mazibo ni matuka, bilikupua.<verse eid="PRO 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Olia atonene buswesi bwa mutima ni aliwalanda bulanzi buweme,</para>
  <para style="q2" vid="PRO 22:11">likolo alikuba kibuza wakue.<verse eid="PRO 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />Menso akua Yawe alialabukila maano,</para>
  <para style="q2" vid="PRO 22:12">inzi aliwalovia twebo twa mupoti.<verse eid="PRO 22:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Munanghani aliwalanda nangue, “Panze pali ni nkalamu!</para>
  <para style="q2" vid="PRO 22:13">Ndikwipailua mu kisaakaanino kya bantu.”<verse eid="PRO 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Kanua ka mwanakazi mukambue, kiina kizikile.</para>
  <para style="q2" vid="PRO 22:14">Olia asuulilue na Yawe, aliwaponenamo.<verse eid="PRO 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Bupuba bukakiliilue mu mutima wa mwana,</para>
  <para style="q2" vid="PRO 22:15">inzi nfimbo ya kumukanda iliyabukumbila kule.<verse eid="PRO 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Olia aliwabiibikizia mupabi pakuti avuzie bunonsi bwakue,</para>
  <para style="q2" vid="PRO 22:16">ni aliwapeela munonsi byabupe, bonse babili balibapeleela ku bupabi.<verse eid="PRO 22:16" /></para>
  <para style="s1">Bulanzi 30 bwa mulangue</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />Twilizia unvue bulanzi bwa balia bali ni mulangue,</para>
  <para style="q2" vid="PRO 22:17">ni kupooza maano ku bindimukusambilizia.<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />Pantu kuti kyawama kine wasunga masambilizio mukati mobe,</para>
  <para style="q2" vid="PRO 22:18">ni ku-apitulukamo kubalua musita.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Evi maswapi obe aye ali muli Yawe.</para>
  <para style="q2" vid="PRO 22:19">Ni wewe wenka, nakusambilizia lelo.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Eba, nsikulembeele bulanzi 30,</para>
  <para style="q2" vid="PRO 22:20">bulanzi bwa nsokezi ni bwa maano,<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />Evi bukusambilizie kuba wa kiine ni wa kulanda kisinka,</para>
  <para style="q2" vid="PRO 22:21">pakuti ubwezie mpunda ya kiine ku balia bakutumine?<verse eid="PRO 22:21" /></para>
  <para style="s1">Bulanzi bwa mambo</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Tekupompola mupabi bunonsi bwakue pantu ye ni mupabi,</para>
  <para style="q2" vid="PRO 22:22">Ni mu kilie tekubiibikizia nsambu muntu abulilue.<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />Pantu Yawe aliwabalandila,</para>
  <para style="q2" vid="PRO 22:23">ni kubiibikizia bwikazi bwa balia balibababiibikizia.<verse eid="PRO 22:23" /></para>
  <para style="s1">Bulanzi bwa bubili</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Tekukita bukibuza na olia ali ni kipuki kikata,</para>
  <para style="q2" vid="PRO 22:24">ao kwenda pamo ni muntu asiliwakokola kufiitua.<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />Ukeeza kusambilila mibeele yakue,</para>
  <para style="q2" vid="PRO 22:25">ni kulengia kukwatua we mwine mu muteo.<verse eid="PRO 22:25" /></para>
  <para style="s1">Bulanzi bwa butatu</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Tekuti ube umo wa pa balia balibalaya,</para>
  <para style="q2" vid="PRO 22:26">ao kwitabila kulipa mizia nghwana.<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />Kine teuli na kinge kya kumulipa,</para>
  <para style="q2" vid="PRO 22:27">wene kuti watwaminamo bulita bobe.<verse eid="PRO 22:27" /></para>
  <para style="s1">Bulanzi bwa buna</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Tekutelulula kalangi ka mipaka ya kale,</para>
  <para style="q2" vid="PRO 22:28">mipaka yaabiikilue na babikolue bobe.<verse eid="PRO 22:28" /></para>
  <para style="s1">Bulanzi bwa busaano</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Kubako umwene muntu amanine bwino mwilo wakue?</para>
  <para style="q2" vid="PRO 22:29">Alikubomba ntanzi ya makolo.</para>
  <para style="q2" vid="PRO 22:29">Takaba kubombela babiloolo basipalile.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s1">Bulanzi bwa mutanda</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />Luuliwaikala ku kulia pamo ni kateeka,</para>
  <para style="q2" vid="PRO 23:1">tekulaba nangue ulimukulia nani.<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />Kine uli nkandakalio,</para>
  <para style="q2" vid="PRO 23:2">biika mwele pa mukolomino obe.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />Kabili tekutokamua bilio byakue biweme,</para>
  <para style="q2" vid="PRO 23:3">pantu kuti bya kubembia.<verse eid="PRO 23:3" /></para>
  <para style="s1">Bulanzi bwa kilooba</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Tekwiemia mu kukeba bunonsi.</para>
  <para style="q2" vid="PRO 23:4">Tekupozesiako maano.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />Pantu kuti wa bumona, ni bo bwazeeza</para>
  <para style="q2" vid="PRO 23:5">pantu kisinka bunonsi bulibwaikitila mapaapi,</para>
  <para style="q2" vid="PRO 23:5">nga nzwiba aliwapupuka mu muulu.<verse eid="PRO 23:5" /></para>
  <para style="s1">Bulanzi bwa mwanda</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Tekulia bilio bya muntu wa butani,</para>
  <para style="q2" vid="PRO 23:6">kabili tekutokamua bilio byakue biweme,<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />Pantu mu mutima wakue alimukupenda biulimukulia,</para>
  <para style="q2" vid="PRO 23:7">alikukwana, “Mina, Lia!”</para>
  <para style="q2" vid="PRO 23:7">Inzi mu mutima mwali binge.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Elia mikusu iwalyanga ulikuiluka,</para>
  <para style="q2" vid="PRO 23:8">ni ntasio yobe ilikuba ya mpuni.<verse eid="PRO 23:8" /></para>
  <para style="s1">Bulanzi bwa fundi</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Tekulanda twebo twa maano ku kipuba,</para>
  <para style="q2" vid="PRO 23:9">pantu alikufuupula mulangue wa twebo tobe.<verse eid="PRO 23:9" /></para>
  <para style="s1">Bulanzi bwa lyanondo</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Tekutelulula kalangi ka mipaka ya kale,</para>
  <para style="q2" vid="PRO 23:10">kabili tekupoka makaba a baana nsiiwa.<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />Pantu Kalubula wabo ali ni maka,</para>
  <para style="q2" vid="PRO 23:11">wene waakabalandila, ni we waakamoneka wali ni kilubo.<verse eid="PRO 23:11" /></para>
  <para style="s1">Bulanzi bwa lyanondo ni bumo</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Poozako maano mu kukonka masambilizio,</para>
  <para style="q2" vid="PRO 23:12">ni kuteya matui obe ku kutwilizia twebo twa maano.<verse eid="PRO 23:12" /></para>
  <para style="s1">Bulanzi bwa lyanondo ni bubili</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Tekumulekeela mwana pasili kumuuma,</para>
  <para style="q2" vid="PRO 23:13">pantu kine wamusepula nfimbo, tafua.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Musepule nfimbo</para>
  <para style="q2" vid="PRO 23:14">ni kupususia bukose bwakue ku lufu.<verse eid="PRO 23:14" /></para>
  <para style="s1">Bulanzi bwa lyanondo ni butatu</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />We mwana wane, kine mutima obe uli ni mulangue,</para>
  <para style="q2" vid="PRO 23:15">kisinka mutima wane ni o ulikuwaminua.<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />Mutima wane ulikuwaminua,</para>
  <para style="q2" vid="PRO 23:16">milomo yobe luiliyalanda bilungi.<verse eid="PRO 23:16" /></para>
  <para style="s1">Bulanzi bwa lyanondo ni buna</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Mutima obe tekuti unvwile bantu ba bibalo bunkua,</para>
  <para style="q2" vid="PRO 23:17">inzi wewe tiina Yawe koba konse.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />Pantu kisinka kuli ni buwame ku ntanzi,</para>
  <para style="q2" vid="PRO 23:18">ni maswapi obe teakapua.<verse eid="PRO 23:18" /></para>
  <para style="s1">Bulanzi bwa lyanondo ni busaano</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Unvua we mwana wane, kabili ba ni mulangue,</para>
  <para style="q2" vid="PRO 23:19">lombola mutima obe mu nzila iweme.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Tekuya wali pa libumba lya bakyakolua,</para>
  <para style="q2" vid="PRO 23:20">ao balia balibalia munani wa nama nga bakazule.<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />Pantu kyakolua ni kazule baakapeleela ku bupabi,</para>
  <para style="q2" vid="PRO 23:21">ni tulo twaakabavwika bilaka.<verse eid="PRO 23:21" /></para>
  <para style="s1">Bulanzi bwa lyanondo ni mutanda</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Mutwilizie so akuvyele,</para>
  <para style="q2" vid="PRO 23:22">kabili tekumufuupula noko mu bukote bwakue.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Sita kiine, inzi tekuti ukisisie.</para>
  <para style="q2" vid="PRO 23:23">Sita mulangue, ni masambilizio pamo ni maano.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Se kwa mwana mulunghami, ali ni nsansa ikata.</para>
  <para style="q2" vid="PRO 23:24">Olia avyele mwana wa maano, ni ye aliwasansamusiiwa.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />So ni noko bawaminue,</para>
  <para style="q2" vid="PRO 23:25">noko akuvyele asangalale.<verse eid="PRO 23:25" /></para>
  <para style="s1">Bulanzi bwa lyanondo ni kilooba</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />We mwana wane, n'mpeele mutima obe,</para>
  <para style="q2" vid="PRO 23:26">ni menso obe awaminue na nzila yane.<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />Pantu mukende, ali nga kiina kizikiisie,</para>
  <para style="q2" vid="PRO 23:27">ni mwanakazi mweni ali nga kiina kyondele.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Ee, aliwabenza nga kabooko,</para>
  <para style="q2" vid="PRO 23:28">ni kulengia balalume bengi kusiba ba kisinka.<verse eid="PRO 23:28" /></para>
  <para style="s1">Bulanzi bwa lyanondo ni mwanda</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />Nani ali ni maavia? Nani ali ni bulanda? Nani ali ni mazibo?</para>
  <para style="q2" vid="PRO 23:29">Nani aliwaitendooka? Nani ali ni bilonda bya mpuni?</para>
  <para style="q2" vid="PRO 23:29">Nani akasikile menso?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Ni olia aliwakokola musita uleepele mu bumini,</para>
  <para style="q2" vid="PRO 23:30">olia aliwakeba kutompatompa bwalua bulekenkeene.<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Wewe tekutokamua bwalua lubukasikile,</para>
  <para style="q2" vid="PRO 23:31">anzia kine bulimukufumia tufulo twabenghema,</para>
  <para style="q2" vid="PRO 23:31">ni kukooka bwino bukebuke.<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Inzi pa mpeleezio bulibwasuma nga nzoka,</para>
  <para style="q2" vid="PRO 23:32">ni bwimba bwakue nga bwa ngwezie.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Menso obe alikumona byeni,</para>
  <para style="q2" vid="PRO 23:33">ni mutima obe ulikufumia bintu bisipalile.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Ee, ulikuya wali nga muntu aleele pakati buziba,</para>
  <para style="q2" vid="PRO 23:34">nga muntu aleele ku mulingoti wa bwato.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />Ulikulanda evi, “Bakinsepa, inzi nsyakikisika.</para>
  <para style="q2" vid="PRO 23:35">Bakinghuma, inzi nsyakyunvua kantu.</para>
  <para style="q2" vid="PRO 23:35">Ndikubuuka musitaki kuti ntwalilile kukeba bunge bwalua?”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s1">Bulanzi bwa lyanondo ni fundi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Bantu babi tekubonvwila bunkua,</para>
  <para style="q2" vid="PRO 24:1">kabili tekutokamua kuba pamo nabo.<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />Pantu mutima wabo uliwalangakana bupoti,</para>
  <para style="q2" vid="PRO 24:2">ni milomo yabo iliyalanda sie bibiipile.<verse eid="PRO 24:2" /></para>
  <para style="s1">Bulanzi bwa anondo abili</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Nghanda iliyakuulua na mulangue,</para>
  <para style="q2" vid="PRO 24:3">ni kwimikua na maano.<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />Ni mu bukengezi miputule yakue iliyaizuziwamo</para>
  <para style="q2" vid="PRO 24:4">bintu bya mutengo ukata ni bifwaniine.<verse eid="PRO 24:4" /></para>
  <para style="s1">Bulanzi bwa anondo abili ni bumo</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Muntu wa mulangue, i alumine.</para>
  <para style="q2" vid="PRO 24:5">Ee, muntu wa maano i aliwavuzia maka.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Pantu aliwalua bului na nsokezi ya maano,</para>
  <para style="q2" vid="PRO 24:6">ni mu bwingi bwa bakasoka, bwanzio bulibwamoneka.<verse eid="PRO 24:6" /></para>
  <para style="s1">Bulanzi bwa anondo abili ni bubili</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Mulangue amukilile kipuba.</para>
  <para style="q2" vid="PRO 24:7">Kipuba tezi kwasamuna kanua kakue pa mulyango.<verse eid="PRO 24:7" /></para>
  <para style="s1">Bulanzi bwa anondo abili ni butatu</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Olia aliwakambila kukita bubi,</para>
  <para style="q2" vid="PRO 24:8">bantu balikumukuuta kankobenkania.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Malanga akua kipuba ni kibalo,</para>
  <para style="q2" vid="PRO 24:9">ni muntu wa kapuni ni kilubo ku bantu.<verse eid="PRO 24:9" /></para>
  <para style="s1">Bulanzi bwa anondo abili ni buna</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Kine wanaka mu nsiku ya lyemo,</para>
  <para style="q2" vid="PRO 24:10">maka obe akeepele.<verse eid="PRO 24:10" /></para>
  <para style="s1">Bulanzi bwa anondo abili ni busaano</para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Pususia balia batwemue kuti baye bepawe,</para>
  <para style="q2" vid="PRO 24:11">ni balia basyali pepi ni kwipawa, kita maka ubapususie.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Kine walanda nangue, “Mona fwefue tetwakyunvua ezi milandu,”</para>
  <para style="q2" vid="PRO 24:12">Kubako olia aliwatoosia mitima, kuti wamana?</para>
  <para style="q2" vid="PRO 24:12">Ni olia aliwasunga mutima obe, tavinda kwinika?</para>
  <para style="q2" vid="PRO 24:12">Ni ye takasazia kubalua muntu kukonkana ni miilo yakue?<verse eid="PRO 24:12" /></para>
  <para style="s1">Bulanzi bwa anondo abili ni mutanda</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />We mwana wane, lia kapelo pantu kaweme,</para>
  <para style="q2" vid="PRO 24:13">ni muto wa kapelo pantu usonsele mu kanua kobe.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Upalile kumana nangue mulangue uli nga kapelo kuli wewe,</para>
  <para style="q2" vid="PRO 24:14">kine wausanga, wakaba kuya wali ni nsiku iweme ku ntanzi</para>
  <para style="q2" vid="PRO 24:14">ni maswapi obe teakaba apua.<verse eid="PRO 24:14" /></para>
  <para style="s1">Bulanzi bwa anondo abili ni kilooba</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />We muntu mubi, tekubenza bwikazi bwa mulunghami,</para>
  <para style="q2" vid="PRO 24:15">tekupoka nghanda yakue.<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />Anzia mulunghami apona nghendo kilooba ni kubuuka paakale,</para>
  <para style="q2" vid="PRO 24:16">inzi babi balibaloviiwa na bubi.<verse eid="PRO 24:16" /></para>
  <para style="s1">Bulanzi bwa anondo abili ni mwanda</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Tekuwaminua lulilwapona mulwani obe,</para>
  <para style="q2" vid="PRO 24:17">ni mutima obe tekuti usangalale lu-aliwaipuutala.<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />Pantu Yawe kine wamona evio alikufiitua,</para>
  <para style="q2" vid="PRO 24:18">ni ye takaba kubakanda.<verse eid="PRO 24:18" /></para>
  <para style="s1">Bulanzi bwa anondo abili ni fundi</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Tekwema pa mulandu wa bankitatubi,</para>
  <para style="q2" vid="PRO 24:19">ao kunvwila babi bunkua.<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />Pantu muntu mubi tali na nsiku iweme ku ntanzi.</para>
  <para style="q2" vid="PRO 24:20">Musaniko wa mubi uliwazima.<verse eid="PRO 24:20" /></para>
  <para style="s1">Bulanzi bwa anondo atatu</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />We mwana wane, tiina Yawe pamo ni likolo,</para>
  <para style="q2" vid="PRO 24:21">kabili tekwampana na babisanguka.<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />Pantu busanzo bwabo bwakaba kubatulumukilila sie.</para>
  <para style="q2" vid="PRO 24:22">Ale nani amanine lwinoono lwaakaleetua na Yawe ni likolo?<verse eid="PRO 24:22" /></para>
  <para style="s1">Bulanzi bunge bwa mulangue</para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 24:23" />Bobu i bulanzi bwa bantu ba mulangue.</para>
  <para style="q2" vid="PRO 24:23">Kuba ni kitoolela mu bupinguzi tekuweme.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Olia aliwamwana mubi nangue, “Wewe uli ni nsambu,”</para>
  <para style="q2" vid="PRO 24:24">Bantu balikumutiipa, ni ntundu ilikumusuula.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Inzi ku balia balibamutana nsambu, balikuya bali ni nsansa,</para>
  <para style="q2" vid="PRO 24:25">ni mapaalo aweme alikuya ali pali bene.<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Bwasuko bwa kisinka</para>
  <para style="q2" vid="PRO 24:26">buli nga kufyompa pa milomo yakua kibuza.<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Wamia miilo yobe ya panze,</para>
  <para style="q2" vid="PRO 24:27">ni kuteania bukaba bobe,</para>
  <para style="q2" vid="PRO 24:27">mane ukuule nghanda yobe.<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Tekusininkizia bya bufi ku mwinobe pasili mulandu,</para>
  <para style="q2" vid="PRO 24:28">ao kubeepa na milomo yobe.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />Tekulanda nangue, “Ndikumukitila nga vi-akinkitila.</para>
  <para style="q2" vid="PRO 24:29">Ndikumulipa kukonkana ni vi-akikita.”<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Nakipita pepi ni bukaba bwa munanghani,</para>
  <para style="q2" vid="PRO 24:30">ni pepi ni bukaba bwa mizabibu bwa muntu asili na maano,<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />Ni mo mumenene sie myunga,</para>
  <para style="q2" vid="PRO 24:31">ni bo bukupiliilue sie na lunkoto,</para>
  <para style="q2" vid="PRO 24:31">ni kibumba kyakue kya mabue, kituutilue.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Kupwako, nakenta, ni kulangakana,</para>
  <para style="q2" vid="PRO 24:32">namona ni kusangapo masambilizio:<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />
    <note caller="+" style="x">
      <char style="xo" closed="false">24.33: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:10-11">Map 6.10-11</ref>
      </char>
    </note>Kulaala kaniini, ni kuona kaniini,</para>
  <para style="q2" vid="PRO 24:33">kukunza maboko kaniini ni kutuuzia.<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />Ni evi bupabi bwakaba kukwizila nga kabooko,</para>
  <para style="q2" vid="PRO 24:34">ni kubulua kwakaba kukukonka nga kipoopoosi ali ni kilwilo.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s1">Mapinda ange akua Solomoni</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Aza i mapinda ange akua Solomoni, mapinda a-ambwilue na bantu bakua Hezekia likolo wa mu kyalo kya Yudea<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Kufiika keebo, bulumba bwakua Leza,</para>
  <para style="q2" vid="PRO 25:2">inzi bulumba bwa makolo, kukebelezia keebo.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Nga vili kuleepa kwa lyulu kuya mu muulu, ni kuzika kwa kyalo kuya pansi,</para>
  <para style="q2" vid="PRO 25:3">ni mutima wa makolo i viusivinda kukebeleziiwa.<verse eid="PRO 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Fumia biko mu mutofue,</para>
  <para style="q2" vid="PRO 25:4">ni mutili wa mutofue alikukukitila kipe.<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />Fumia babi ku menso akua likolo,</para>
  <para style="q2" vid="PRO 25:5">ni kitebe kyakue kya bukolo kilikwimikua mu bulunghami.<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">25.6: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 14:8-10">Lk 14.8-10</ref>
      </char>
    </note>Tekwitantamuna pa menso akua likolo,</para>
  <para style="q2" vid="PRO 25:6">ni kukeba kifuka pa bakindami.<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />Pantu kyawama kwanua nangue, “Iza kono ku ntanzi,”</para>
  <para style="q2" vid="PRO 25:7">kukila kumoniiwa busoni pa bakindami.</para>
  <para style="b" vid="PRO 25:7" />
  <para style="q2" vid="PRO 25:7">Kine kuli ni kawamonanga na menso obe,<verse eid="PRO 25:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8" />Tekubutukila kuya kusongela ku kilie,</para>
  <para style="q2" vid="PRO 25:8">ukeeza kwandua kumana bya kukita ku mpeleezio</para>
  <para style="q2" vid="PRO 25:8">mwinobe pa-akaba kukumonia busoni.<verse eid="PRO 25:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Lanzyania ni mwinobe,</para>
  <para style="q2" vid="PRO 25:9">kabili tekufyulilane tufiso.<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />Evi olia alikunvua tekuti akumonie busoni.</para>
  <para style="q2" vid="PRO 25:10">Ukeeza kuleebulua mu bwikazi bobe bonse.<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Keebo kalikalandua pa musita upalile,</para>
  <para style="q2" vid="PRO 25:11">kali nga nsombo ya oro ili mu kipe kya mutofue.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Nga evelia vili lutimbi lwa oro, ni bifwanizio bya oro isambikile,</para>
  <para style="q2" vid="PRO 25:12">i vili ni olia aliwasoka kutui kulikwanakila.<verse eid="PRO 25:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Nga evelia vili kasama ka kibue musita wa kuzombola,</para>
  <para style="q2" vid="PRO 25:13">i vili ni mukenzi wa kisinka ku olia amutumine.</para>
  <para style="q2" vid="PRO 25:13">Pantu aliwasansamusia mutima wakua selenzi.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Nga evelia vili malezi ni mwela pasili nvula,</para>
  <para style="q2" vid="PRO 25:14">i vili ni olia aliwaitasia bufi palua kilambu kisipeenue.<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Mu kusipikizia, kateeka aliwalengiwa kuzumina,</para>
  <para style="q2" vid="PRO 25:15">ni lulimi luteleele, lulilwatyona kakuza.<verse eid="PRO 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Kine wasyukila kapelo, tekuliisia,</para>
  <para style="q2" vid="PRO 25:16">ukeeza kwikuta ni kuluka.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Kuulu kobe kuye kwali sie musita umo umo ku nghanda ya mwino,</para>
  <para style="q2" vid="PRO 25:17">akeeza kunaka nobe ni kukusuula.<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Muntu aliwasininkizia mwinakue bya bufi,</para>
  <para style="q2" vid="PRO 25:18">ali nga nondo ni kipanga, ni muvui unoonekele.<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />Kuswapila muntu asiliwakisinka musita wa maavia,</para>
  <para style="q2" vid="PRO 25:19">kuli nga liino libolele, ni mukonzo uvyukile.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Nga evelia vili olia aliwavuula ngubo yakue musita wa kasama,</para>
  <para style="q2" vid="PRO 25:20">kabili nga siki pa kilonda,</para>
  <para style="q2" vid="PRO 25:20">i vili ni olia aliwaimba nghimbo ku muntu afinine mutima.<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">25.21: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:20">Bar 12.20</ref>
      </char>
    </note>Kine mulwani obe onvwile nzala, mupeele bilio,</para>
  <para style="q2" vid="PRO 25:21">kabili kine onvwile kyaka, mupeele menda a kumina.<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />Mu kukita evi, ulikubiika mazekezeke a mulilo pa mutue wakue,</para>
  <para style="q2" vid="PRO 25:22">ni Yawe alikukulambula.<verse eid="PRO 25:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Nga vili mwela wa ku nkungua uliwaleeta nvula,</para>
  <para style="q2" vid="PRO 25:23">i vili ni lulimi lulilwalengia muntu kufiitua.<verse eid="PRO 25:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />Kyawama kwikala mu kafuli ka mutenge wa nghanda,</para>
  <para style="q2" vid="PRO 25:24">kukila kwikala mu nghanda pamo ni mukazi wa mazibo.<verse eid="PRO 25:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Nga evelia vili menda a kasama ku muntu ali ni kyaka,</para>
  <para style="q2" vid="PRO 25:25">i vili ni mpunda iweme ifumine kule.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Mulunghami aliwalekelela mubi,</para>
  <para style="q2" vid="PRO 25:26">ali nga kasulo ka menda kalikavunduka, kabili nga kiina kya menda kivundwilue.<verse eid="PRO 25:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Nga evelia vikisipalile kuliisia kapelo,</para>
  <para style="q2" vid="PRO 25:27">i vikisipalile ni kwikebela bulumba bobe we mwine.<verse eid="PRO 25:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Olia asiliwateeka mutima wakue,</para>
  <para style="q2" vid="PRO 25:28">ali nga muzi uli ni kibumba kituutikile.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />Nga evelia vili kibue musita wa likungulu, ni nvula musita wa buzombozi,</para>
  <para style="q2" vid="PRO 26:1">ni mukinzi i viusipalile ku kipuba.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Nga evelia vili munsole mu kuwayawaya kwakue, nga kamimbili mu kupupuka kwakue,</para>
  <para style="q2" vid="PRO 26:2">i vili ni ntiipu ya mpuni isiizi kukwata muntu.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Musepe wa kuuminako farasi, kikobelo kya kulombwelako punda,</para>
  <para style="q2" vid="PRO 26:3">ni nfimbo ya kuuminako kipuba mu musana.<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Tekumwasuka kipuba mubeeleele bupuba bwakue,</para>
  <para style="q2" vid="PRO 26:4">ukeeza kupalana nakue.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Mwasuke kipuba mubeeleele bupuba bwakue,</para>
  <para style="q2" vid="PRO 26:5">akeeza kwaluka wa mulangue ku menso akue mwine.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Olia aliwalaizia kipuba kutwala mpunda,</para>
  <para style="q2" vid="PRO 26:6">aliwaiputula makasa akue, ni kumina bwimba.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Nga vilebeele maulu a mulema,</para>
  <para style="q2" vid="PRO 26:7">i vili ni mapinda mu kanua ka kipuba.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Nga vili libue lya mutengo mu topiito,</para>
  <para style="q2" vid="PRO 26:8">i vili ni muntu aliwakindika kipuba.<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />Nga vili musambo wa myunga mu kuboko kwakua kyakolua,</para>
  <para style="q2" vid="PRO 26:9">I vili ni mapinda mu kanua ka kipuba.<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />Nga vili muntu aliwalasa mivui ni kukisia bonse,</para>
  <para style="q2" vid="PRO 26:10">i vili ni muntu aliwapeela miilo kipuba ao mupitanzila.<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />Nga vili kabua kalikabwelela ku malusi akue,</para>
  <para style="q2" vid="PRO 26:11">i vili ni kipuba aliwabweziapo kukita bya bupuba.<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />Ewe, umwene muntu ali ni mulangue ku menso akue mwine?</para>
  <para style="q2" vid="PRO 26:12">Kyawama kuswapila kipuba kukila wene.<verse eid="PRO 26:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />Munanghani aliwalanda nangue, “Mu nzila muli ni nkalamu,</para>
  <para style="q2" vid="PRO 26:13">nkalamu asasile ali mu musebo ukata.”<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />Nga vilivyazyungulusiiwa mulyango mu bulato bwakue,</para>
  <para style="q2" vid="PRO 26:14">i vilivyaipilibula munanghani pa bulita bwakue.<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />Munanghani aliwabiika kuboko kwakue mu nsaani,</para>
  <para style="q2" vid="PRO 26:15">inzi aliwaunvua bunanghani bwa kutwala pa kanua kakue.<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />Munanghani emwene kuba ni mulangue pa menso akue</para>
  <para style="q2" vid="PRO 26:16">kukila bantu kilooba baliba-asuka ni maano.<verse eid="PRO 26:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />Olia aliwaingila mu mazibo asili akue,</para>
  <para style="q2" vid="PRO 26:17">ali nga muntu aliwakwata ku matui a kabua kalimukupita.<verse eid="PRO 26:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18" />Nga wa luuba vi-aliwapooza bikooko bya mulilo,</para>
  <para style="q2" vid="PRO 26:18">ni mivui, bintu bilibyaipaana,<verse eid="PRO 26:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19" />i vili ni muntu aliwamubeepa mwinakue,</para>
  <para style="q2" vid="PRO 26:19">ni kumwana nangue, “Ne nakiba nakusekia sie!”<verse eid="PRO 26:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />Mulilo uliwazima pantu tepali nkuni,</para>
  <para style="q2" vid="PRO 26:20">ni pasili musongezi, tepali mazibo.<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />Nga vitulitwazukunsia mazekezeke ao kukwikizia nkuni pa mulilo,</para>
  <para style="q2" vid="PRO 26:21">i vili ni muntu mubi aliwasomenkezia mazibo.<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />Twebo twa musongezi tuli nga bisoso biweme bya bilio,</para>
  <para style="q2" vid="PRO 26:22">kabili tulitwakookela munda.<verse eid="PRO 26:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />Nga vili twebo twa kwiwaminizia ni mutima ubi,</para>
  <para style="q2" vid="PRO 26:23">i vili ni keeso kakupilueko mutofue.<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />Muntu asuulile bange aliwafyamina mu bulanzi bwakue,</para>
  <para style="q2" vid="PRO 26:24">inzi aliwateeka bukonto bwa bupoti mu mutima wakue.<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />Lualiwalanda twebo twaweme, tekumuketekela,</para>
  <para style="q2" vid="PRO 26:25">pantu kuli bilubo kilooba bili mu mutima wakue.<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />Anzia kukenda kwakue kuya kwafiikilue na bupoti,</para>
  <para style="q2" vid="PRO 26:26">bubi bwakue bulibwamoneka pa menso a bantu.<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />Olia aliwaimba kiina, waakaponenamo ye mwine.</para>
  <para style="q2" vid="PRO 26:27">Kine wabulunkusia libue, lilikumubwelelela.<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />Lulimi lwa bufi, lusuulile balia bakisiiziwe na lo,</para>
  <para style="q2" vid="PRO 26:28">ni kanua ka kwiwaminizia, kalikaleeta lwinoono.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">27.1: </char>
      <char style="xt" closed="false">
        <ref loc="JAS 4:13-16">Yak 4.13-16</ref>
      </char>
    </note>Tekwitasia pa bya lukeele,</para>
  <para style="q2" vid="PRO 27:1">pantu teumanine bilikukitika mu busiku bumo.<verse eid="PRO 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Lekela muntu unge akutasie, tekuba kanua kobe we mwine,</para>
  <para style="q2" vid="PRO 27:2">mweni, tekuba milomo yobe we mwine.<verse eid="PRO 27:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />Libue lifinine, ni musenga ulemene,</para>
  <para style="q2" vid="PRO 27:3">inzi busokozi bwa kipuba bufinine kukila bebi bibili.<verse eid="PRO 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Kikonko kibiipile, ni kipuki kili nga kibunda.</para>
  <para style="q2" vid="PRO 27:4">Ale nani aliwavinda kwimana ku ntanzi ya bunkua?<verse eid="PRO 27:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />Kyawama kusasililua pa menso a bantu,</para>
  <para style="q2" vid="PRO 27:5">kukila ntono ifiikilue.<verse eid="PRO 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />Kibuza kine wakukisia, muketekele,</para>
  <para style="q2" vid="PRO 27:6">kukila miifyompo ya mulwani.<verse eid="PRO 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Muntu ekusi, asuulile kapelo,</para>
  <para style="q2" vid="PRO 27:7">inzi olia ali ni nzala, bilulile bilibyasonsa.<verse eid="PRO 27:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Nga vili koni kalikawayawaya kule ni kinsua kyakue,</para>
  <para style="q2" vid="PRO 27:8">i vili ni muntu aliwawayawaya kule ni nghanda yakue.<verse eid="PRO 27:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Nga vili mafuta a bunu buweme ni bubaani, bilibyawamina mutima,</para>
  <para style="q2" vid="PRO 27:9">i vili ni makola a bukibuza bwa muntu bulibwafuma mu mapange a mu mutima wakue.<verse eid="PRO 27:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Kibuza obe ni kibuza wakua so, tekubalekela,</para>
  <para style="q2" vid="PRO 27:10">kabili tekuti ukabe kuya mu nghanda mwa lupua lobe busiku bwa lyemo lyobe.</para>
  <para style="q2" vid="PRO 27:10">Kyawamako mwinobe ali pepi kukila lupua luli kule.<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />We mwana wane, ba ni mulangue usansamusie mutima wane,</para>
  <para style="q2" vid="PRO 27:11">evi n'mone mwakumwasukila olia aliwansasilila.<verse eid="PRO 27:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Mukengezi aliwamona bubi ni kufyama,</para>
  <para style="q2" vid="PRO 27:12">inzi babipuba balibaya sie ku ntanzi mpaka baikisia.<verse eid="PRO 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Muntu kine walaya kulipila mizia ya muntu asimanikile, apokueko ngubo yakue nga kikwatizi,</para>
  <para style="q2" vid="PRO 27:13">apokue kikwatizi pa mulandu wa ozo mweni.<verse eid="PRO 27:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Olia aliwapaala kibuza wakue wasamwine lukeelekeele pakili,</para>
  <para style="q2" vid="PRO 27:14">kyaakamoneka nga kitiipu.<verse eid="PRO 27:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Mukazi wa mazibo,</para>
  <para style="q2" vid="PRO 27:15">ali nga matooni a nvula aliatoonatoona busiku bwa nvula.<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />Aliwakilikila ozo mukazi, aliwakilikila mwela,</para>
  <para style="q2" vid="PRO 27:16">ao kukwata mafuta na kuboko kwakue kwa kulio.<verse eid="PRO 27:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Nga kyela vikilikyanoona kyela nakue,</para>
  <para style="q2" vid="PRO 27:17">ni muntu i vi-aliwasambiliziiwa na mwinakue.<verse eid="PRO 27:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Olia aliwasunga kimuti kya miku aliwaliako mazabo,</para>
  <para style="q2" vid="PRO 27:18">ni olia aliwasunga selenzi aliwakindikua.<verse eid="PRO 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Nga lukebu vilulilwapalana na lukebu mu menda,</para>
  <para style="q2" vid="PRO 27:19">ni muntu i vi-aimanine.<verse eid="PRO 27:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Kumbo ni lwinoono tebyaikuta ata kaniini,</para>
  <para style="q2" vid="PRO 27:20">ni menso a muntu te-ezi kwikuta ata kaniini.<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Mupika, i wakusungulwilamo mutofue, ni kikuka kya mulilo, i kya kwapikamo oro,</para>
  <para style="q2" vid="PRO 27:21">inzi muntu aliwaeziiwa pa mulandu wa bulumba bwakue.<verse eid="PRO 27:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Anzia ubuula mwinsi ni kumutua kipuba nga nghano,</para>
  <para style="q2" vid="PRO 27:22">bupuba bwakue tebupua.<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Kita maka umane mibeele ya bisepe byobe,</para>
  <para style="q2" vid="PRO 27:23">ni kusunga bwino nghombe yobe.<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />Pantu bukata tebwayayaya,</para>
  <para style="q2" vid="PRO 27:24">ni ngala ya bukolo teyatwalilila mu nvyalo yonse.<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />Musita uliwasebua lubambua, palipatutuka lunge,</para>
  <para style="q2" vid="PRO 27:25">ni lubamba kufuma mu mpili lulilwakolonghaniiwa.<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />Mikooko iliyakuleetela masako a kukitamo ngubo yobe,</para>
  <para style="q2" vid="PRO 27:26">ni mbuzi wakaba kumusisia ni kusitamo makaba.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Kabili ulikuya wali ni mabeele engi a mbuzi a kukutuusia pamo ni lupua lobe</para>
  <para style="q2" vid="PRO 27:27">pamo ni kuliisia babombi bobe banakazi.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />Babi balibabutuka sie tekuba bakumbilue na muntu,</para>
  <para style="q2" vid="PRO 28:1">inzi balunghami bapamine nga nkalamu.<verse eid="PRO 28:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Pa mulandu wa bukisanguka bwa kyalo, bakateeka balibavula,</para>
  <para style="q2" vid="PRO 28:2">inzi kateeka wa maano ni akengeele, aliwaleeta mutende.<verse eid="PRO 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Mulombozi mupabi aliwaemia bapabi,</para>
  <para style="q2" vid="PRO 28:3">ali nga nvula ya mwela iliyainoona bilio.<verse eid="PRO 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Balia basilibakonka mizilo, balibatasia bubi,</para>
  <para style="q2" vid="PRO 28:4">inzi balia balibakonka mafunde, balibakanzana nabo.<verse eid="PRO 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Bantu babi tebamanine bilungheeme,</para>
  <para style="q2" vid="PRO 28:5">inzi balia balibamukeba Yawe babimanine.<verse eid="PRO 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />Kyawama mupabi aliwaenda mu nsambu</para>
  <para style="q2" vid="PRO 28:6">kukila munonsi ali mu nzila ibi.<verse eid="PRO 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />Olia aliwakonka mizilo, mwana wa mulangue,</para>
  <para style="q2" vid="PRO 28:7">inzi kibuza wa bakazule, aliwamonia se busoni.<verse eid="PRO 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />Olia aliwavuzia bunonsi bwakue mu kukopia nfolanga ya kaloba,</para>
  <para style="q2" vid="PRO 28:8">aliwakolonghaniizia muntu aliwaunvwila bapabi nkumbu.<verse eid="PRO 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Olia aliwakilika kutui kwakue tekuti onvue mizilo,</para>
  <para style="q2" vid="PRO 28:9">ni mapepo akue ni bilubo.<verse eid="PRO 28:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Olia aliwalengia balunghami kuzeezelela mu nzila ibi,</para>
  <para style="q2" vid="PRO 28:10">aliwaponena mu kiina kyakue mwine,</para>
  <para style="q2" vid="PRO 28:10">inzi balia bapwililikile balibapyana biweme.<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Munonsi ali ni mulangue pa menso akue mwine,</para>
  <para style="q2" vid="PRO 28:11">inzi mupabi ali ni maano, aliwamutoosia bwino bwino.<verse eid="PRO 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Balunghami kine ba-anzia, bulumba bukata.</para>
  <para style="q2" vid="PRO 28:12">Inzi babi kine i bateeka, bantu balibafyama.<verse eid="PRO 28:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Olia aliwafiika bilubo byakue, tezi kulunduluka,</para>
  <para style="q2" vid="PRO 28:13">Inzi olia aliwalapila ni kulekela, aliwaeleelua.<verse eid="PRO 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Lisyuko ku muntu aliwatiina Yawe lyonse,</para>
  <para style="q2" vid="PRO 28:14">inzi olia aliwafinia mutima wakue, aliwaponena mu busanzo.<verse eid="PRO 28:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Nga vili nkalamu aliwabuluma, ni kimbui kilikyasakukila,</para>
  <para style="q2" vid="PRO 28:15">i vili ni kateeka mubi aliwateeka bapabi.<verse eid="PRO 28:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Kateeka asili na maano, aliwakila kubabiibikizia,</para>
  <para style="q2" vid="PRO 28:16">inzi olia asiliwatokamua bunonsi bwa bupompo, aliwaikala nsiku ingi.<verse eid="PRO 28:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Olia afiniinue na mulopa wa muntu,</para>
  <para style="q2" vid="PRO 28:17">aliwaya wali mbutusi mpaka musita wa kufua kwakue.</para>
  <para style="q2" vid="PRO 28:17">Tekuti kuye kwali muntu wa kumukwasia.<verse eid="PRO 28:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Muntu aliwaenda mu bulunghami, aliwapususiiwa.</para>
  <para style="q2" vid="PRO 28:18">Inzi olia ali ni kiitoni mu nzila yakue, aliwaponena mu kiina.<verse eid="PRO 28:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Olia aliwalima bukaba bwakue, ali ni bilio bingi.</para>
  <para style="q2" vid="PRO 28:19">Inzi olia aliwakonka milandu ya mpuni waya wali ni bupabi bukata.<verse eid="PRO 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Muntu wa kisinka, ali ni mapaalo engi.</para>
  <para style="q2" vid="PRO 28:20">Inzi olia aliwakeba kunonka lubilo lubilo, aliwakandua.<verse eid="PRO 28:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Kuba ni kitoolela ku bantu, tekuweme.</para>
  <para style="q2" vid="PRO 28:21">Inzi muntu kuti waluvia pa mulandu wa kisoso kya mukate.<verse eid="PRO 28:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Wa butani aliwatona kunonka lubilo lubilo,</para>
  <para style="q2" vid="PRO 28:22">kabili tamanine nangue kuti wabulua.<verse eid="PRO 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Olia aliwasasilila mwinakue, aliwatonua pa kyamba</para>
  <para style="q2" vid="PRO 28:23">kukila olia aliwamulandila twebo twa kuwaminizia.<verse eid="PRO 28:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Muntu aliwaiba bunonsi bwakua se ao bwakua nghina ni kulanda nangue, “Te kilubo,”</para>
  <para style="q2" vid="PRO 28:24">ozo muntu, kibuza wakua nghinooni.<verse eid="PRO 28:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Wa butani aliwabuusia mazibo,</para>
  <para style="q2" vid="PRO 28:25">inzi olia amuswapiile Yawe, alikuba munonsi.<verse eid="PRO 28:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Muntu eswapiile ye mwine, kipuba.</para>
  <para style="q2" vid="PRO 28:26">Inzi olia aliwaendela mu mulangue, aliwapususiiwa.<verse eid="PRO 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Muntu aliwakwasia bapabi tezi kubulua kantu,</para>
  <para style="q2" vid="PRO 28:27">inzi olia aliwazibata, ali ni ntiipu ingi.<verse eid="PRO 28:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Babi kine bateeka, bantu balibafyama.</para>
  <para style="q2" vid="PRO 28:28">Inzi kine baloviiwa, balunghami balibavula.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />Olia aliwasokuasokua sie ni ye wakosia mutima,</para>
  <para style="q2" vid="PRO 29:1">takakokola kutyoka, kabili takamona kwa kupusukila.<verse eid="PRO 29:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Kine balunghami bapaalua, bantu balibasansamuka.</para>
  <para style="q2" vid="PRO 29:2">Inzi mubi kine i wateeka, bantu balibalwala.<verse eid="PRO 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Olia atonene mulangue, aliwasansamusia se.</para>
  <para style="q2" vid="PRO 29:3">Inzi kibuza wa bakende, aliwazeezia bunonsi bwakue.<verse eid="PRO 29:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Likolo aliwateeka kyalo kupitila mu nsambu.</para>
  <para style="q2" vid="PRO 29:4">Inzi olia aliwapeelua bituulilo, aliwainoona kyalo.<verse eid="PRO 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Olia aliwaiwaminizia ku mwinakue,</para>
  <para style="q2" vid="PRO 29:5">aliwateyela mwinakue bukila.<verse eid="PRO 29:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Mu kilubo kya muntu mubi, muli muteo.</para>
  <para style="q2" vid="PRO 29:6">Inzi mulunghami aliwaimba ni kusangalala.<verse eid="PRO 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Mulunghami aliwakenta twebo twa mupabi.</para>
  <para style="q2" vid="PRO 29:7">Mubi tali na maano a kuti amane.<verse eid="PRO 29:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Bantu bali ni kapuni balibazizia muzi.</para>
  <para style="q2" vid="PRO 29:8">Inzi bantu bali ni mulangue balibapwisia kikonko.<verse eid="PRO 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Kine wa mulangue wakanzana na kipuba,</para>
  <para style="q2" vid="PRO 29:9">kipuba kine wafiitua, ao kine waseka, tepali mutende.<verse eid="PRO 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Balia balibazuumia mulopa, basuulile olia apwililikile,</para>
  <para style="q2" vid="PRO 29:10">Kabili balibakeba kwipaya balunghami.<verse eid="PRO 29:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Kipuba aliwalanda na kipuki kyakue kyonse.</para>
  <para style="q2" vid="PRO 29:11">Inzi wa mulangue, aliwaleeta mutende ku mpeleezio.<verse eid="PRO 29:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Kateeka kine watwilizia bya bufi,</para>
  <para style="q2" vid="PRO 29:12">babombi bakue bonse, baliba-aluka babi.<verse eid="PRO 29:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Kintu kimo kili na mupabi ni aliwabiibikizyania ni keki:</para>
  <para style="q2" vid="PRO 29:13">Yawe aliwabapeela bukose.<verse eid="PRO 29:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Kine likolo aliwapingula mupabi mu kisinka,</para>
  <para style="q2" vid="PRO 29:14">bukolo bwakue bwaya bwali bwa muyayaya.<verse eid="PRO 29:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Nfimbo pamo ni kusasililua, bilibyaleeta mulangue.</para>
  <para style="q2" vid="PRO 29:15">Inzi mwana aliwalekelelua pasili kukandua aliwamonia nghina busoni.<verse eid="PRO 29:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Babi lubalibateeka, bubi bulibwavula.</para>
  <para style="q2" vid="PRO 29:16">Inzi balunghami balibamona kupona kwabo.<verse eid="PRO 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Kanda mwanao ni ye alikukuleetela mutende.</para>
  <para style="q2" vid="PRO 29:17">Ee, alikusansamusia mutima obe.<verse eid="PRO 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Palia pasili kimonua, bantu balibaya kiyeyeye.</para>
  <para style="q2" vid="PRO 29:18">Inzi olia aliwakonka mizilo, ali ni nsansa.<verse eid="PRO 29:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Mubombi tezi kusokua sie na twebo,</para>
  <para style="q2" vid="PRO 29:19">pantu anzia amana tapoozako maano.<verse eid="PRO 29:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />Kubako umumanine olia aliwalanda kilandelande?</para>
  <para style="q2" vid="PRO 29:20">Kyawama kuketekela kipuba kukila muntu wa ozu musango.<verse eid="PRO 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Olia aliwasunga mubombi wakue kutula ku bwanike bwakue,</para>
  <para style="q2" vid="PRO 29:21">pa mpeleezio waakamusangukila.<verse eid="PRO 29:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Muntu wa kipuki aliwalengia mazibo.</para>
  <para style="q2" vid="PRO 29:22">Ni muntu wa kipuki kikata aliwalengia bibalo bingi.<verse eid="PRO 29:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Kiitoni kya muntu kilikyamukoosia.</para>
  <para style="q2" vid="PRO 29:23">Inzi mufuuke aliwakindikua.<verse eid="PRO 29:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Olia aliwa-ampana na kabooko, asuulile mutima wakue mwine.</para>
  <para style="q2" vid="PRO 29:24">Aliwaunvua ntiipu yatiipua, inzi tekuba walanda kantu.<verse eid="PRO 29:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />Kutiina bantu, muteo wa kukuleetela busanzo.</para>
  <para style="q2" vid="PRO 29:25">Inzi olia amuswapiile Yawe, ali ni mutende.<verse eid="PRO 29:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Bengi balibakeba kutonua na kateeka.</para>
  <para style="q2" vid="PRO 29:26">Inzi nsambu ya muntu iliyafuma kuli Yawe.<verse eid="PRO 29:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Muntu mubi, asuulile balunghami.</para>
  <para style="q2" vid="PRO 29:27">Ni mulunghami, asuulile babi.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s1">Bulanzi bwakua Aguri</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Bobu i bulanzi bwa mponvu bwakua Aguri mwina Yake,</para>
  <para style="q1" vid="PRO 30:1">kuli Itieli ni Ukali.</para>
  <para style="b" vid="PRO 30:1" />
  <para style="q1" vid="PRO 30:1">“We Leza wandekeela, we Leza wandekeela,</para>
  <para style="q2" vid="PRO 30:1">kabili n'mpeleelelue.<verse eid="PRO 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />Kisinka nene ndi kipuba kukila bantu bonse.</para>
  <para style="q2" vid="PRO 30:2">Kabili nsili na maano a bumuntu.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Nsyaasambiliile mulangue,</para>
  <para style="q2" vid="PRO 30:3">kabili nsimanine twebo twakua Muzuuke.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Nani waaselele mwiulu ni kukooka pansi?</para>
  <para style="q2" vid="PRO 30:4">Nani waakolonghaniizie mwela mu minue yakue?</para>
  <para style="q1" vid="PRO 30:4">Nani waakakile menda mu ngubo yakue?</para>
  <para style="q2" vid="PRO 30:4">Nani waimikile mpeleezio yonse ya kyalo?</para>
  <para style="q1" vid="PRO 30:4">Liina lyakue nani? Liina lyakua mwana wakue nani?</para>
  <para style="q2" vid="PRO 30:4">Nghane kine umanine!<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />“Kubalua keebo kakua Leza kasininkiziiziwe.</para>
  <para style="q2" vid="PRO 30:5">Wene i kisoolelo kya balia balibabutukilamo.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Tekulundapo pa twebo twakue,</para>
  <para style="q2" vid="PRO 30:6">akeeza kukusasilila ni we wamoneka kuba wa bufi.<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />“We Yawe nakulomba bintu bibili.</para>
  <para style="q2" vid="PRO 30:7">Tekuti ukabe kuntana ntanzi ya kufua kwane:<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />Fumia bupunzu ni bufi pali nene.</para>
  <para style="q2" vid="PRO 30:8">Tekun'mpeela bupabi ao bunonsi,</para>
  <para style="q2" vid="PRO 30:8">inzi n'mpeeleko bilio byane bya kubalua nsiku.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Pantu kine byanvulila ndikwikuta ni kukulaba nalanda nangue, ‘Yawe nani?’</para>
  <para style="q2" vid="PRO 30:9">Ao tekuti ngie nali mupabi ni kuya naiba,</para>
  <para style="q2" vid="PRO 30:9">Ni kuleebuzia Liina lyakua Leza wane.<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />“Tekubeepezia mubombi kuli selenzi,</para>
  <para style="q2" vid="PRO 30:10">akeeza kukutiipa ni we wamoneka kuba wa kilubo.<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />“Kuli ni luvyalo lulilwatiipa basibo,</para>
  <para style="q2" vid="PRO 30:11">kabili tebezi kupaala ba nghinabo.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Kuli ni luvyalo luswetele ku menso abo bene,</para>
  <para style="q2" vid="PRO 30:12">inzi telwaasambilue biko byabo.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Kuli ni luvyalo lukilile kulendula menso abo!</para>
  <para style="q2" vid="PRO 30:13">Nkopio yabo ni yo yalendwilue.<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Kuli ni luvyalo luli ni meno nga kipanga ni lumuma nga myele,</para>
  <para style="q2" vid="PRO 30:14">pakuti baye balia bapabi ni kubalovia pa kyalo pamo ni balia babuliilue pakati ka bantu.<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />“Mupoti, ali na bakazyana babili balibalila nangue,</para>
  <para style="q2" vid="PRO 30:15">‘N'mpeele, N'mpeele.’</para>
  <para style="b" vid="PRO 30:15" />
  <para style="q1" vid="PRO 30:15">“Kuli bintu bitatu bisilibyaikuta ata kaniini.</para>
  <para style="q2" vid="PRO 30:15">Ee, bina bisilibyalanda nangue, ‘Byavula.’<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />Kilibu, kavumo ka nghumba,</para>
  <para style="q2" vid="PRO 30:16">ni bulongo busilibwaikuta menda,</para>
  <para style="q2" vid="PRO 30:16">pamo ni mulilo usiliwalanda nangue, ‘Byavula.’<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />“Linso lya muntu aliwafuupula se,</para>
  <para style="q2" vid="PRO 30:17">ni kufuupula nghina,</para>
  <para style="q2" vid="PRO 30:17">lyaakakompua na bizooko bya mu lulambe,</para>
  <para style="q2" vid="PRO 30:17">ni twina nzwiba twaakalilia.<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />“Kuli bintu bitatu bilibyan'mpezia maano.</para>
  <para style="q2" vid="PRO 30:18">Ee, bintu bina binsimanine,<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />Lwendo lwa nzwiba mu lweleele,</para>
  <para style="q2" vid="PRO 30:19">lwendo lwa kizoka pa mwalala,</para>
  <para style="q1" vid="PRO 30:19">lwendo lwa bwato pa menda,</para>
  <para style="q2" vid="PRO 30:19">ni lwendo lwa mwalalume ali ni mukazyana.<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />“I vili ni nzila ya mwanakazi mukende.</para>
  <para style="q2" vid="PRO 30:20">Aliwalia ni kupukusa pa kanua kakue,</para>
  <para style="q2" vid="PRO 30:20">ni kulanda nangue, ‘Nsiluviizie.’<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />“Pa mulandu wa bintu bitatu, kyalo kilikyatenta,</para>
  <para style="q2" vid="PRO 30:21">ni pa mulandu wa bintu bina kilikya-andua kusipikizia.<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />Pa mulandu wa muzia lu-aliwa-aluka likolo,</para>
  <para style="q2" vid="PRO 30:22">ni kipuba kine waikuta bilio.<verse eid="PRO 30:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23" />Pa mulandu wa mwanakazi abiipile kine waupua,</para>
  <para style="q2" vid="PRO 30:23">ni mubombi mwanakazi aliwapokolola kyupo kyakua nghinalenzi.<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />“Kuli bilengua bina bikeepele mu kyalo.</para>
  <para style="q2" vid="PRO 30:24">Inzi bili ni maano engi.<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />Mpazi, ni bilengua bisili na maka.</para>
  <para style="q2" vid="PRO 30:25">Anzia evio, iliyaibiikila bilio pa musita wa likungulu.<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />Bibila, ni bilengua bisili na maka.</para>
  <para style="q2" vid="PRO 30:26">Anzia evio, bilibyaikitila nghanda mu mabue.<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />Nzie, teili na likolo.</para>
  <para style="q2" vid="PRO 30:27">Anzia evio, iliyabuukila pamo mu mabumba.<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />Lunso, kuti wakwatua na minue.</para>
  <para style="q2" vid="PRO 30:28">Anzia evio, aliwaikala mu nghanda mwa likolo.<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />“Kuli bilengua bitatu bilibyaenda lwendo lufwaniine.</para>
  <para style="q2" vid="PRO 30:29">Ee, bina bili ni lwendo luweme.<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />Nkalamu ali ni maka pa nama yonse,</para>
  <para style="q2" vid="PRO 30:30">asiizi kutiina nama inge yonse.<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />Kazenze kalikaenda kaikenkenta, pamo ni kapwata,</para>
  <para style="q2" vid="PRO 30:31">ni likolo azyungulukiilue na balukale bakue.<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />“Kine ukitile bya bupuba ni kuya waitantamuna,</para>
  <para style="q2" vid="PRO 30:32">ao kine ukambiile kukita bibiipile,</para>
  <para style="q2" vid="PRO 30:32">biika kuboko kobe pa kanua kobe.<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />Pantu kine wafulumia mabeele a nama ulikusanga manteka.</para>
  <para style="q2" vid="PRO 30:33">Kuuma pa moona kulikwafumia mulopa.</para>
  <para style="q2" vid="PRO 30:33">Ni kusomenkezia kipuki kulikwaleeta mazibo.”<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s1">Nsokezi yakua likolo Lemueli</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Bulanzi bwakua likolo Lemueli, bu-aasambiliziiziwe na nghina.<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />We mwana wane, twilizia! Twilizia, we mwana wa munda mwane!</para>
  <para style="q2" vid="PRO 31:2">Twilizia, we mwana wane, we bwasuko bwa mapepo ane.<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />Tekupeela banakazi maka obe,</para>
  <para style="q2" vid="PRO 31:3">ao nzila yobe ku balia balibavulunghania likolo.<verse eid="PRO 31:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />We Lemueli, makolo teapalile kumina divai,</para>
  <para style="q2" vid="PRO 31:4">Makolo teapalile.</para>
  <para style="q2" vid="PRO 31:4">Ao bakindami kutokamua bikolani.<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />Bakeeza kukolua ni kulaba mizilo,</para>
  <para style="q2" vid="PRO 31:5">bakeeza kubiibikizia nsambu ya muntu aliwaema.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Bwalua bululile, ni ku balia balimukuzeeza.</para>
  <para style="q2" vid="PRO 31:6">Ni divai, ni ku balia bali ni bulanda bukata mu mutima.<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />Baleke bamine ni kulaba bupabi bwabo,</para>
  <para style="q2" vid="PRO 31:7">evi tekuti baye balanguluka nghemo yabo ata kaniini.<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />Landilako bakameme bonse,</para>
  <para style="q2" vid="PRO 31:8">ni kusampulula balia basili na wa kubakwasia.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Asamuna kanua kobe upingule mu nsambu.</para>
  <para style="q2" vid="PRO 31:9">Bapabi pamo ni babuliilue, ubapeele nsambu yabo.<verse eid="PRO 31:9" /></para>
  <para style="s1">Mwanakazi wa mibeele iweme</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />Mwanakazi wa mibeele iweme alikumonekela pi?</para>
  <para style="q2" vid="PRO 31:10">Pantu mutengo wakue ukilile mabue a mutengo.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />Mutima wakua mulume wakue umuketekeele,</para>
  <para style="q2" vid="PRO 31:11">ni ye takabula kibwezia.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Aliwamukitila biweme tekuba bibiipile,</para>
  <para style="q2" vid="PRO 31:12">nsiku yonse ya bukose bwakue.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />Aliwakeba sufu ni kitani,</para>
  <para style="q2" vid="PRO 31:13">ni kubomba miilo yakue na mutima onse.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Wene ali nga bwato bwa makwebo.</para>
  <para style="q2" vid="PRO 31:14">Aliwaleeta bilio byakue kufuma kule.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Aliwabuuka paakili lukeelekeele,</para>
  <para style="q2" vid="PRO 31:15">aliwapeela bilio ku bantu ba mu nghanda yakue,</para>
  <para style="q2" vid="PRO 31:15">ni babombi bakue banakazi miilo yabo.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Aliwakenta bukaba ni kubusita.</para>
  <para style="q2" vid="PRO 31:16">Mu bikwatua bya mu minue yakue i mu-aliwabyalila bukaba bwa mizabibu.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Aliwabomba miilo yakue na maka,</para>
  <para style="q2" vid="PRO 31:17">ni kulumia maboko akue.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Aliwamona nangue makwebo akue ali ni kibwezia.</para>
  <para style="q2" vid="PRO 31:18">Musaniko wakue tewizi kuzima musita wa busiku.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Aliwasuka nyunzi na minue yakue,</para>
  <para style="q2" vid="PRO 31:19">ni maboko akue akwatiliile.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Aliwaolola maboko akue ku bapabi,</para>
  <para style="q2" vid="PRO 31:20">ee, aliwaolwela maboko akue ku babuliilue.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />Tezi kutiina kasama pa mulandu wa bantu ba mu nghanda yakue,</para>
  <para style="q2" vid="PRO 31:21">pantu bonse ba mu nghanda yakue bavwikilue ngubo ya kasi.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Aliwaikitila ngubo ya pa bulita bwakue.</para>
  <para style="q2" vid="PRO 31:22">Aliwavwala ngubo ya kitani kiweme ni ya mukumino wa bulumbi.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Mulume wakue amanikile mu milyango,</para>
  <para style="q2" vid="PRO 31:23">lu-aliwaikala pakati ka masiiko a kyalo.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Aliwakita ngubo ya kitani ni kusisia.</para>
  <para style="q2" vid="PRO 31:24">Aliwasisia misipi ku basulu.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Maka ni mukinzi i ngubo yakue.</para>
  <para style="q2" vid="PRO 31:25">Aliwasekelela pa mulandu wa musita uliwaiza.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />Aliwa-asamuna kanua kakue na mulangue,</para>
  <para style="q2" vid="PRO 31:26">ni mizilo ya buwame ili mu kanua kakue.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Aliwakentesia nzila ya bantu ba mu nghanda yakue,</para>
  <para style="q2" vid="PRO 31:27">kabili tezi kulia bilio bya bunanghani.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />Baana bakue balibamukuuta lisyuko.</para>
  <para style="q2" vid="PRO 31:28">Mulume wakue aliwamukuuta evio vyenka, ni kumutasia walanda nangue,<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />“Bakazyana bengi balibakita biweme,</para>
  <para style="q2" vid="PRO 31:29">inzi wewe ukilile bonse.”<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Monekelo iliyabeepa, ni kuwama kwa lukebu, ni kwa mpuni.</para>
  <para style="q2" vid="PRO 31:30">Inzi mwanakazi aliwatiina Yawe i aliwatasiiwa.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Mukindike mu byonse bi-aliwakita na maboko akue,</para>
  <para style="q2" vid="PRO 31:31">ni miilo yakue imuleetela mukinzi ponse.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>