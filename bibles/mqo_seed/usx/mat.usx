<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Modole</book>
  <para style="h">O MATIUS</para>
  <para style="toc2">O Matius</para>
  <para style="toc1">O Matius</para>
  <para style="mt1">O HABARI MA OWA NAGE</para>
  <para style="mt2">O MATIUS WOHINGAHU-NGAHU</para>
  <para style="is">O Habari ma Owa nage o Matius wohingahu-ngahu ma dumutu</para>
  <para style="ip">O Matius awi bo'uo'a neena inahingahu o Habari ma Owa geena la o Yesus una geena ma 'Oana o Nyawa wonahiha-halamata. Unau neena, nage ma Jou ma Dutu wohija-jajio'au aha woboa. Harage de o nabi yohingahuo'au o bo'u ibe-berehi'u o jaji ma hila'a. Ngaro ma hila o Yesus woboano o dunia'a neena de womanoa do'a 'a o Yahudio'a, ma o Habari ma Owa geena ma dumutu duga 'a o Yahudi ma nyawa'awa. Ho ena o nyawa'a moi-moi o dunia'a neena.</para>
  <para style="ip">Na'o ngone pabaca ma bo'u neena geena aha pana'o o 'iau ma hila nanga Jou Yesus womaboa o duniano. Wiohi'i de o to'ata ma 'oana witaili. De o hagala moi-moi ma wo'idi-diai o Galilea'a, geena la: Cara'iau o nyawa wo'idoto'o; wo'ihiai'i o nyawa manga panya'e 'iini-ni'o'a; de cara'iau Wohonenge de Womomi'oli. Neena moi-moi ma dumutu la pomahina'o pohigou-goungu, o Yesus Una geena to ngone o nyawa moi-moi o dunia'a nanga baradoha ma du-duuhu.</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Ma Yesus Kristus awi edete de awi dotumu manga ronga-ronga</para>
  <para style="r">(Luk. 3:23-38)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Ma Yesus Kristus geena ma 'oana o Daut de ma aba o Abraham manga guti'u. Neena Awi edete de awi dotumu manga ronga-ronga:<verse eid="MAT 1:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="MAT 1:2" />O Abraham awi ngoa'a o Ishak,</para>
  <para style="q2" vid="MAT 1:2">o Ishak awi ngoa'a o Yakub,</para>
  <para style="q2" vid="MAT 1:2">o Yakub awi ngoa'a o Yehuda de awi riadodoto.<verse eid="MAT 1:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="MAT 1:3" />O Yehuda awi ngoa'a o Peres de o Zerah manga eha o ngo Tamar,</para>
  <para style="q2" vid="MAT 1:3">o Peres awi ngoa'a o Hezron,</para>
  <para style="q2" vid="MAT 1:3">o Hezron awi ngo'a o Ram,<verse eid="MAT 1:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="MAT 1:4" />o Ram awi ngoa'a o Aminadab,</para>
  <para style="q2" vid="MAT 1:4">o Aminadab awi ngoa'a o Nahason,</para>
  <para style="q2" vid="MAT 1:4">o Nahason awi ngoa'a o Salmon,<verse eid="MAT 1:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="MAT 1:5" />o Salmon awi ngoa'a o Boas nage o ngo Rahapino awi we'ata,</para>
  <para style="q2" vid="MAT 1:5">o Boas awi ngoa'a o Obed nage o ngo Ruutino awi we'ata,</para>
  <para style="q2" vid="MAT 1:5">o Obed awi ngoa'a o Isai,<verse eid="MAT 1:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="MAT 1:6" />de o Isai awi ngoa'a o Daut.</para>
  <para style="p" vid="MAT 1:6">O Daut guuna, wodadi o Israelo'a manga 'oana.</para>
  <para style="q2" vid="MAT 1:6">O Daut awi ngoa'a o Salomo ge ma we'ata o ngo Batsyebano. Ongo Batsyeba gumuna o Uria awi bao.<verse eid="MAT 1:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="MAT 1:7" />O Salomo awi ngoa'a o Rahabeam,</para>
  <para style="q2" vid="MAT 1:7">o Rahabeam awi ngoa'a o Abia,</para>
  <para style="q2" vid="MAT 1:7">o Abia awi ngoa'a o Asa,<verse eid="MAT 1:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="MAT 1:8" />o Asa awi ngoa'a o Yosafat,</para>
  <para style="q2" vid="MAT 1:8">o Yosafat awi ngoa'a o Yoram,</para>
  <para style="q2" vid="MAT 1:8">o Yoram awi ngoa'a o Uzia,<verse eid="MAT 1:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="MAT 1:9" />o Uzia awi ngoa'a o Yotam,</para>
  <para style="q2" vid="MAT 1:9">o Yotam awi ngoa'a o Ahas,</para>
  <para style="q2" vid="MAT 1:9">o Ahas awi ngoa'a o Hizkia,<verse eid="MAT 1:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 1:10" />o Hizkia awi ngoa'a o Manasye,</para>
  <para style="q2" vid="MAT 1:10">o Manasye awi ngoa'a o Amon,</para>
  <para style="q2" vid="MAT 1:10">o Amon awi ngoa'a o Yosia,<verse eid="MAT 1:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 1:11" />de o Yosia awi ngoa'a o Yekhonya de awi riadodotoli ma regu ma oraha o Israelo'a ma bangiha yo'iumo o Babeli'a de yo'ihangihara do'a.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Wa'utu, o Israelo'a ma bangiha yolio'au o Babelo'a de yaino hiadono o Yesus womaboa o duniano manga ronga-ronga onane:</para>
  <para style="q2" vid="MAT 1:12">O Yekhonya awi ngoa'a o Sealtiel,</para>
  <para style="q2" vid="MAT 1:12">o Sealtiel awi ngoa'a o Zerubabel,<verse eid="MAT 1:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 1:13" />o Zerubabel awi ngoa'a o Abihud,</para>
  <para style="q2" vid="MAT 1:13">o Abihud awi ngoa'a o Elyakim,</para>
  <para style="q2" vid="MAT 1:13">o Elyakim awi ngoa'a o Azor,<verse eid="MAT 1:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="MAT 1:14" />o Azor awi ngoa'a o Zadok,</para>
  <para style="q2" vid="MAT 1:14">o Zadok awi ngoa'a o Akhim,</para>
  <para style="q2" vid="MAT 1:14">o Akhim awi ngoa'a o Eliud,<verse eid="MAT 1:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="MAT 1:15" />o Eliud awi ngoa'a o Eleazar,</para>
  <para style="q2" vid="MAT 1:15">o Eleazar awi ngoa'a o Matan,</para>
  <para style="q2" vid="MAT 1:15">o Matan awi ngoa'a o Yakub,<verse eid="MAT 1:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="MAT 1:16" />de o Yakub awi ngoa'a o Yusuf.</para>
  <para style="q1" vid="MAT 1:16">O Yusuf nuunau ge womodo'a de o ngo Maria,</para>
  <para style="q2" vid="MAT 1:16">de o ngo Marianou o Yesus womaboa nage witehongo ma Kristus, nage ma Jou ma Dutu wiili-ili'i.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Ho o Abrahamo'a de yaino hiadono ma 'oana o Dautu'u, geena manga guti'u yamogio'o de yahoatu'ou. Ma 'oana o Dautino hiadono o Israel ma bangiha yo'iumo o Babeli'a, geena manga guti'u yamogio'o de yahoatu'oli. De ma oraha o Israelo'a yo'iumo o Babeli'a hiadono ma Yesus Kristus womaboa o duniano, geena manga guti'u yamogio'o de yahoatu'oli.<verse eid="MAT 1:17" /></para>
  <para style="s">Ma Yesus Kristus womaboa o duniano</para>
  <para style="r">(Luk. 2:1-7)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Ma Yesus Kristus womaboa, ma jarita onane: Ma oraha o ngo Maria o Yesus ma eha yoma'ajajio'au yoma'amodo'a de o Yusuf. Ongo Maria numuna o naulu 'amana'owahi, ena momongo mohiahano'au. Ongo Maria mohiaha hababu o Omaha 'iofi-ofi. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />O Yusuf nuuna o nyawa woti-tiai ma Jou ma Dutu awi biono'a. Wa'utu wana'o na'o o ngo Maria mohiahano'au, una awi hininga ma doda'a womau o ngo Maria mimadau womahibongonino. Hababu, una 'awoolu'u mihiehe o mae'e o nyawa yolepe-lepe manga biono'a. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Ma wa'utu o Yusuf watiba-tibangohi ma haala geena, de wonanele na'o ma Jou ma Dutu awi malai'ata 'iboa de 'itemo, &lt;&lt;Yusuf ma 'oana Daut awi guti'u. Uwa nohawana nomimodo'a o ngo Maria, hababu ma ngoa'a ge 'ami po'o ma doda'a geena o Omaha 'Iofi-ofino. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />De muna aha moma'ualenge de ami ngoa'a o naulu, de halingou nowihironga o Yesus, hababu duga Una aha watuuhu Awi 'awaha manga baradoha.&gt;&gt;<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Geena moi-moi idadi la harage o 'iau nage o nabi womatengo wohidemo'au na'o, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />&lt;&lt;O moholehe momatengo o naulu 'a ma na'owahi aha mohiaha de moma'ualenge ami ngoa'a o naulu, ma Ngoa'a guuna aha wihironga, o Imanuel.&gt;&gt; Ma mangariti, &lt;&lt;Ma Jou ma Dutu naga de-de ngone.&gt;&gt;<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Ma oraha o Yusuf womomi'ino, una wadiai moi-moi nage ma Jou ma Dutu awi malai'ata wihidemo'au una'a. Una o ngo Maria mimodo'a. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ma o Yusuf de o ngo Maria 'a yomahiiduwahi hiadono ma Ngoa'a guuna womaboa. Ma oraha ma Ngoa'a guuna womabo'au, de o Yusuf wihironga, o Yesus.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Yopade-pade ge yataila'o o mamanga ma mangariti manga daera o wange ma hiwaha 'idadu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />O Yesus womaboa o Betlehemo'a o Yudea ma tona'o'a, wa'utu o Herodes wo'oana geena'a. Wa'utu geena, yamuluo naga yopade-pade o mamanga o diwango'a yataila'o ma mangariti dina o wange ma hihiwa'a de yao'o de yotagi o Yerusalemo'o. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />Ona yo'a-'ahano o nyawa-nyawa'a, &lt;&lt;Ee 'iya'a e, o Yahudio'a manga 'oana nage aha womaboa'u? Hababu, ngomi miama'e'au o mamanga moi o wange ma hiwano ma dudunguu geena na'o Una womaboa'au. Ho o oraha neena ngomi mioboa miohuba Una'a.&gt;&gt;<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Ma oraha ma 'oana o Herodes woihene ma habari geena, de witodo'ana, 'ogeenali ma awi 'awaha moi-moi o Yerusalemo'a. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Ho ma 'oana o Herodes wo'ihulo'o la yo'itoomu o 'imam ma hae-hae'e de o Yahudio'a manga agama'a yodoto-doto'o. De wohano ona'a. &lt;&lt;Bee'a nihingahu ngoino, 'Ia'a ma 'Oana wonahiha-halamata, nage ma Jou ma Dutu wohija-jajio'au ge aha womaboa?&gt;&gt;<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Ona yopaluhu, &lt;&lt;Una womaboa'au o Betlehemo'a, o Yudea ma daera'a, hababu harage ge yatulihu'u'au o nabi awi bo'u'u onane,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;Ngini o Betlehem ma nyawa o Yudea ma tona'o'a.</para>
  <para style="q2" vid="MAT 2:6">Ngaro nia bendara 'a iete'e, ma aha idadi o bendara ma amo'o.</para>
  <para style="q1" vid="MAT 2:6">Hababu tingini nia bendarino geena aha womaboa womatengo wodadi baluhu</para>
  <para style="q2" vid="MAT 2:6">ge aha wopareta de wo'ipaliara 'ai awaha o Israelo'a.&gt; &gt;&gt;<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Woihene 'ogeena, de ma 'oana o Herodes 'a womahibongonino wo'iaho'o yopade-pade nage o mamanga yataila'o ma diai dinao'o o wange ma hiwa'o. De wo'ihano ona'a, &lt;&lt;'Awuluo niama'e o mamanga geena 'ipuda?&gt;&gt; <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Geena'a de, wo'ihulo'o yotagi o Betlehemi'a de wo'ihibehehongo wotemo, &lt;&lt;Niotagi o Betlehemi'a, de niwihali'i ma Ngoa'a guuna. Na'o niwima'e'au, nima'ilio nihingahu ngoino la ngoi ma ta'ai'a towihuba Una'a.&gt;&gt;<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />'Iduangino yoihene o Herodes womaade-ade 'ogeena, ona yotagi. Wa'utu yotagi, 'itodo'anino o mamanga ge yama'e'au o wange ma hiwade itagi 'ihila-hila de 'imatogumu 'ipahi ma Ngoa'a geena awi dingiio'a ma de'ude. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Wa'utu yama'e o mamanga geena, de ona duru yohanaanga. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Ona yoohama ma woa'a geena de wima'e o Ngoa'a guuna de ma eha o ngo Maria, geena'a de, yatilabu'u'u de yohuba ma Ngoa'i'a geena, de yapelenga manga 'arata ma no-noa de yo'ula manga hu-huba geena la: O gurahi, o maingaana, de o gota ma titigono ma bounu 'ihemo-hemo ihironga o mur. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Geena iduangino, ma Jou ma Dutu wo'ihitiari manga nanelo'a, la uwa yoma'ilioli o Herodesi'a. Ho ona yolio manga tona'iha yaboa o nge'omo ma homoali.<verse eid="MAT 2:12" /></para>
  <para style="s">O Yusuf de o ngo Maria wihidiato'o o Yesus o Mesiri'a</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Ma oraha yopade-pade o mamanga yataila'o ma mangariti goona yolio'a, de o Yusuf wonanele na'o ma Jou ma Dutu awi malai'ata 'iboa de 'itemo, &lt;&lt;Yusuf, nomomi'ou! Nowiaha ma Ngoa'a guuna de ani we'ata de nimahidiaato'o o Mesir ma tona'i'a. Doa'u nimanoa hiadono Tinihidemoli mangale niolio, hababu ma 'oana o Herodes wihali'i ma gigiria'a o Ngoa'a guuna la witooma Una'a.&gt;&gt;<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Woihene 'ogeena, de o Yusuf womomi'i, ho 'ageena ma wutu, ena ma Ngoa'a guuna de ma eha wo'ihidiato'o o Mesiri'a. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Ona do'a yomanoa hiadono ma 'oana o Herodes wohonenge.</para>
  <para style="p" vid="MAT 2:15">Moi-moi geena idadi harage de ma hila ma Jou ma Dutu wotemo'au o nabi'a wotemo, &lt;&lt;'Ai Ngoa'a towiaho'o o Mesirino.&gt;&gt;<verse eid="MAT 2:15" /></para>
  <para style="s">Ma 'oana o Herodes wohulo'o yo'itooma o ngoa-ngoa'a o Betlehemo'a</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Wa'utu o Herodes wana'o, o nyawa ge yopade-pade o mamanga yataila'o ma diai dinao'o o wange ma hiwa'o 'ayodinii'uwa o iau nage wotemo'au, de una durue witootaha. Ho wohulo'o yo'itooma o Betlehemo'a de ma date-date'i'a manga ngoa'a o naulu nage manga umuru o taunu modidi de 'ihi'au'u.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />Wa'utu yo'itooma o ngoa-ngoa'a geena, ho 'iau ge ma hila ma Jou ma Dutu wotemo ma nabi Yeremia'a idadio'au, onane,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;&lt;O Rama ma bendaro'a, yoihene o nyawa yomadodora</para>
  <para style="q2" vid="MAT 2:18">de yohigalibetongo.</para>
  <para style="q1" vid="MAT 2:18">Ongo Rahel mo'igali ami ngoa-ngoa'a,</para>
  <para style="q2" vid="MAT 2:18">de milalu ma moolu'u hababu ami ngoa-ngoa'a yo'iiwau.&gt;&gt;<verse eid="MAT 2:18" /></para>
  <para style="s">O Mesiro'a de yaino yolio</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Wa'utu ma 'oana o Herodes wohonengo'au, ena o Yusuf o Mesiro'ahi, de wonanele ma Jou ma Dutu awi malai'ata moi 'iboa, de 'itemo una'a, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />&lt;&lt;Yusuf, nomomi'ou. No'iaha o Ngoa'a geena de ma eha de nioliou o Israel ma tona'i'a, hababu ma 'oana o Herodes de o nyawa ge yomau witooma o Ngoa'a geena yohonengo'au.&gt;&gt; <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Woihene 'ogeena, de o Yusuf womomi'i de wo'iaha o Ngoa'a geena de ma eha yolio o Israel ma tona'i'a.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Ma wa'utu o Yusuf woihene na'o o Arkhelaus wo'oano'au o Yudea ma daera'a wialiti ma dea o Herodes, o Yusuf wohawano'au wolio do'ai'a. Ho ma Jou ma Dutu awi malai'ata 'ihingahu o Yusufi'a awi nanelo'a, la uwa wotagi o Yudea'a ma wotagi o Galilea'a. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Wa'utu yomahiadono o Galilea ma daera'a, ona yomanoa o bendara moio'a ma ronga o Nazaret. Geena ma haala idadi ho'o'iau nage ma Jou ma Dutu wotemo'au ma hila o nabi-nabi'a onane, &lt;&lt;Una aha witehongo, o Nazaret ma Nyawa.&gt;&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">O Yohanes woohi-ohi'i awi do-doto'o</para>
  <para style="r">(Mrk. 1:1-8; Luk. 3:1-18; Yoh. 1:19-28)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />O wa'utu geena, o Yohanes woohi-ohi'i woboa o tona'a 'i'a-'a'aha'a o Yudea ma daera'a de womulaenge wodoto'o wotemo, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />&lt;&lt;Niotobau o baradoha niodiai de nima'ilio ma Jou ma Dutu'a, hababu ma Jou ma Dutu Woparetau wodadi o 'Oana!&gt;&gt; <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />O Yohanes nuunau nage ma nabi Yesaya wotemo'au onane,</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;Naga o nyawa manga ilingi yohigaho'o o tona'a i'a-'a'aha'a,</para>
  <para style="q2" vid="MAT 3:3">&lt;Nihidiai ma Jou awi nge'omo,</para>
  <para style="q2" vid="MAT 3:3">nihiri'oto to Una awi nge'omo.&gt; &gt;&gt;<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />O Yohanes awi baju 'i'a-'a'ulu'u o unta ma gogono yadiai'u. Awi bulu geena o aewani ma 'aino. Awi inomo o 'aladede de o madu o bongani'a. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Manga lepe o Yerusalemo'a de o Yudea'a de o Yordan ma ngaili ma date-date'ino ge, yo'aino o Yohanesino. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Ona yomanga'u manga baradoha, ho o Yohanes wo'iohi'i o Yordan ma ngailo'a.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />O Farisio'a de o Sadukio'a ma manga lepe yoboa o Yohanesino la wo'iohi'i. Ma wa'utu o Yohanes wo'ima'e, de wotemo, &lt;&lt;Ee, ngini o nyawa-nyawa ma diiha harage de 'ao ngia! Uwa niote na'o nioboa'au neenano la tiniohi'i, de ngini idadi nimahilehene ma Jou ma Dutu awi hu'umino ge aha 'iboa. <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Na'o 'igou-goungu niotoba'au o baradoha niodiai, niohimaiti nia go'oie de niagogelu'u yaowa-owa <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Uwa niote o hu'umu onidaenua hababu ngini geena o Abraham awi guti'u. Tinitemo e, Ma Jou ma Dutu wadadi wadiai o he-heleo neena idadi o Abraham awi guti'u. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" /><note caller="-" style="x"><char style="xo" closed="false">3:10: </char><char style="xt" closed="false">Mat.7:19; Luk.3:9</char></note> O patu naga 'inoau'u'au o gota ma goa'a, mangale ihitodanga o gota hiadono ma ngutu-ngutu'u'u. O gota nage ma howo'o itiiha, geena aha yatodanga de yaumo o u'u'a. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Ngoi tiniohi'i de o a'ele, ma dudu'ngu na'o ngini niotoba'au o baradoha niodiai. Ma ngoio'a de aha womatengo woboa, Una awi 'uaha 'iholoi 'iamo'o de-de ngoi. Awi tarupa taai'i ma o yadaenua. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Una wo'ihi'ati-tinga'ou o nyawa ma owa de o nyawa ma diiha. Geena harage de o nyawa awi tatapa wagagaono wohitado'o awi gandumu mangale wohi'atinga'a ma afa de ma owa. O gandum geena aha walomu o tila-tila'a, duga ma afa wohitaulu o u'u'a nage 'aihone-honengua.&gt;&gt;<verse eid="MAT 3:12" /></para>
  <para style="s">O Yohanes wiohi'i o Yesusi'a</para>
  <para style="r">(Mrk.1:9-11; Luk. 3:21-22)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Wa'utu geena, o Yesus woboa o Galilea ma daerano de wotagi o Yordan ma ngaili'a la o Yohanes wiohi'i Una'a. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Ma o Yohanes wamao'u o yadaenua wiohi'i o Yesusi'a, ho wotemo, &lt;&lt;Aba, Ngona halingou noiohi'i, de idodoau ho Aba na'aino ngoino?&gt;&gt;<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Ma o Yesus wotemo una'a, &lt;&lt;O geenau ngaro. Hababu de podiai 'ogeena, podiaio'au moi-moi ge ma Jou ma Dutu awi mau.&gt;&gt; Woihene 'ogeena, de o Yohanes wodinii'i o 'iau nage o Yesus wotemo'au.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Wiohi'i iduangino, de o Yesus womapuda ma a'elie. 'Ageena ena, o diwanga 'ipelenga de o Yesus wama'e ma Jou ma Dutu awi Omaha harage de 'ao namo dara widuguti Una'u. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Geena'a de ma Jou ma Dutu awi ilingi 'itemo, &lt;&lt;Nuuna to Ngoi 'ai Ngoa'a towihiboho-bohono. Una 'Ai hininga wahanaanga.&gt;&gt;<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">O To'ata ma 'oana witaili o Yesusi'a</para>
  <para style="r">(Mrk. 1:12-13; Luk. 4:1-13)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Geena'a de aha, o Omaha 'Iofi-ofi wiaha o Yesus o tona'a 'i'a-'aha'a, la o To'ata ma 'oana witaili Una'a. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Geena'a ma dingii, o Yesus wopuaha o wange moruatino de o wutu moruatino<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="fq" closed="false">o Yesus wopuaha o wange moruatino de o wutu moruatino </char><char style="ft" closed="false">hababu Awi hininga duga 'a ma Jou ma Dutu'a.</char></note>. Ma baha'u, o Yesus wihawini. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Geena'a de, o To'ata ma 'oana iboa o Yesusi'a de 'itemo Una'a, &lt;&lt;Na'o Ngona neena 'igou-goungu ma Jou ma Dutu awi Ngoa'a, Bee'a nohulo'o o he-heleo neena 'imadadi o roti.&gt;&gt;<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Ma o Yesus 'awoolu'u ho wotemo onane, &lt;&lt;O Bo'u 'Ibe-berehi ma doda'u itulihu'u onane,</para>
  <para style="q1" vid="MAT 4:4">&lt;'ade o rotiwa aha o nyawa 'powango,</para>
  <para style="q2" vid="MAT 4:4">Ma de ma Jou ma Dutu awi demono moi-moi nage ma Jou ma Dutu wotemo.&gt; &gt;&gt;<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Geena'a de aha, o To'ata ma 'oana wiaha o Yesusi'a, o Yerusalem ma bendara 'iofi-ofio'a nage, geena'a o to'ata ma 'oana winoa'u o Yesus, o dingii 'i'a-'a'ulie ma Jou ma Dutu awi woa ma de'uo'a. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />De 'itemo o Yesusi'a, &lt;&lt;Ngona neena ma Jou ma Dutu awi ngoa'a to, ho Bee'a noma tebulu neena'a de nau'u. Hababu o Bo'u Ibe-berehi'u ituliho'au onane,</para>
  <para style="q1" vid="MAT 4:6">&lt;Ma Jou ma Dutu aha wahulo'o awi ma-malai'ata</para>
  <para style="q1" vid="MAT 4:6">la nigoana de nilegono.</para>
  <para style="q1" vid="MAT 4:6">La Ani dou ma uwa yatigi o heleo'u.&gt; &gt;&gt;<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />De o Yesus wopaluhu, &lt;&lt;O Bo'u Ibe-berehi'u ituliho'au:</para>
  <para style="q1" vid="MAT 4:7">Uwa nowitaili ma Jou ma Dutu'a, ani Jou.&gt;&gt;<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Aha de o To'ata ma 'oana wiahali o Yesusi'a o de'u 'i'a-'a'a'ulie de wihimaiti o dunia'a ma pareta moi-moi de ma araata moi-moi. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />De ma to'ata ma 'oana itemo o Yesusi'a, &lt;&lt;Moi-moi ge nama'e'au neena aha tonihidu'ula na'o noihuba.&gt;&gt;<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />O Yesus wopaluhu, &lt;&lt;Ee To'ata ma 'oana, naga o Bo'u Ibe-berehi ma doda'u ituliho'au, ngona 'iani nowihuba duga-duga 'ama Jou ma Dutu'a de nowileleani duga 'a Una'a.&gt;&gt;<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Geena'a de aha, o To'ata ma 'oana wimada o Yesusi'a, de o ma-malai'ata 'iboa wileleani Una'a.<verse eid="MAT 4:11" /></para>
  <para style="s">O Yesus womulaenge wodoto'o o Galilea ma daera'a la yotoba</para>
  <para style="r">(Mrk. 1:14-15; Luk. 4:14-15)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Wa'utu geena, o Yesus woihene, na'o o Yohanes woohi-ohi'i woohamo'au o bui'a, de Una wolio o Nazaret ma hoani'a o Galilea ma daera'a. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />O Nazaret wamada de Wotagioli ho wogogele o Kapernaum ma bendaro'a nage o Galilea ma talaga ma date'o'a, o Zebulon de o Naftali ma daera'a. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Geena idadi, ho o 'iau nage ma Jou ma Dutu wotemo'au o nabi Yesaya'a idadio'au, onane:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;&lt;O nyawa-nyawa nage yogogele o Zebulon de o Naftali ma daera</para>
  <para style="q2" vid="MAT 4:15">Nage o Galilea ma talaga ma date'o'a, de o Yordan ma ngaili ma hononga'a,</para>
  <para style="q2" vid="MAT 4:15">ona goona 'ao Yahudio'awa.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />O nyawa ge yowango o daluho'a,</para>
  <para style="q2" vid="MAT 4:16">yama'e'au o daraanga ma hiwa.</para>
  <para style="q1" vid="MAT 4:16">O nyawa ge o daluhu yo'iparetano yo'iaha o honengi'a,</para>
  <para style="q2" vid="MAT 4:16">ma yama'e'au o daraanga!&gt;&gt;<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Ma oraha geena de o Yesus womulaenge wohingahu wotemo, &lt;&lt;Halingou niotoba o baradoha niodiai de nima'ilio ma Jou ma Dutu'a hababu Una woparetau mangale Wo'oana!&gt;&gt;<verse eid="MAT 4:17" /></para>
  <para style="s">O Yesus wo'iaho'o o nao'o yohoma-homa yahoata</para>
  <para style="r">(Mrk. 1:16-20; Luk. 5:1-11)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Ma oraha o Yesus wotagi-tagi o Galilea ma talaga batingo'a, de wo'ima'e o lia'a de dodoto yamididi geena la o Simon (nage wihironga o Petrus) de o Andreas. Ma oraha geena, ona o nao'o yomadohoma magigiria'a, o Galilea ma talaga'a. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />O Yesus wotemo ona'a, &lt;&lt;Niaino nionii'i Ngoino. Ngoi aha tinidoto'o o nyawa ni'ilomu la 'inii'i Ngoino!&gt;&gt; <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Geena'a de manga homa yamada de winii'i o Yesus'a.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Geena iduangino, o Yesus wogila-gilali, de wo'ima'eli o lia'a de dodoto yamididi, geena la o Yakobus de o Yohanes o Zebedeus awi ngoa-ngoa'a. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Geena'a de yamididi goona 'ayogila-gila yamada manga ngootili de manga dea, de winii'i o Yesusi'a.<verse eid="MAT 4:22" /></para>
  <para style="s">O Yesus wodoto'o de Wo'ihiai'i o nyawa manga lepe</para>
  <para style="r">(Luk. 6:17-19)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Geena'a de, o Yesus wo'a'adagi o dingiio'a moi-moi o Galilea ma daera'a de wodoto'o o dodoomu ma woa-woa'a. Una wohingahu o Habari ma Owa mangale ma Jou ma Dutu awi pareta hababu Wo'ana. De Una ma wo'ihiai'i o nyawa yopa-panya'e de 'ayoti-tiaiwa. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />O Yesus awi habari o Siria'a moi-moi yaedono'au, ho o nyawa manga lepe yoboa Una'a. Ona yo'iaha o nyawa yopa-panya'e nage manga panya'e 'iini-ini'o'a, yoha-hangihara, o to'ata yo'ido-dongohami'a, yomuhu-muhu'u de yopa-paluga, de moi-moi goona o Yesus wo'ihiai'i. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Geena de imahi'ai'a, o nyawa manga lepe winii'i o Yesusi'a: O nyawa-nyawa o Galilea ma daerano, de o Dekapolis<note caller="+" style="f"><char style="fr" closed="false">4.25 </char><char style="fq" closed="false">Dekapolis </char><char style="ft" closed="false">Ma mangariti, &lt;&lt;o bendara mogio'o&gt;&gt;. </char></note> ma daerano, o Yerusalem ma bendarino, o Yudea ma daerano, de Yordan ma ngaili do'a ma honongano.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">O Yesus wodoto'o o de'uo'a</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Wa'utu o Yesus wo'ima'e o nyawa manga lepe goona, Una wohawu o de'ude. Wogogelu'u, de awi ni-nii'i yo'ai'a yomahidutu'u Una'a. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Geena'a de, o Yesus womulaenge wo'idoto'o. Wotemo onane,<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />&lt;&lt;Duru hara yohanaanga o nyawa-nyawa nage yomao'u o yadaenua ma Jou ma Dutu awi biono'a,</para>
  <para style="q2" vid="MAT 5:3">Hababu onau goona yodadi ma Jou ma Dutu awi nyawa nage ma Jou ma Dutu awi pareta'a.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Duru yohanaango'a o nyawa-nyawa ge manga hininga 'ihuha,</para>
  <para style="q2" vid="MAT 5:4">hababu ma Jou ma Dutu aha wo'ilalu.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Duru yohanaango'a o nyawa-nyawa ge 'a yoerewa,</para>
  <para style="q2" vid="MAT 5:5">hababu ma Jou ma Dutu aha wo'i'ula ona'a o dunia neena.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Duru yohanaango'a o nyawa-nyawa ge yodahawini yodiai o haala yaowa-owa,</para>
  <para style="q2" vid="MAT 5:6">hababu ma Jou ma Dutu aha wo'i'ula hiadono yo'iduga.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Duru yohanaango'a o nyawa-nyawa ge yohimaiti manga dora o nyawa ma homoa'a,</para>
  <para style="q2" vid="MAT 5:7">hababu ma Jou ma Dutu aha wohimaiti awi dora ona'a.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Duru yohanaango'a o nyawa-nyawa ge manga hininga iberehi ma Jou ma Dutu awi biono'a,</para>
  <para style="q2" vid="MAT 5:8">hababu ona aha wima'e ma Jou ma Dutu.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Duru yohanaango'a o nyawa-nyawa ge yo'ihi'adame o nyawa ma homoa'a,</para>
  <para style="q2" vid="MAT 5:9">hababu ma Jou ma Dutu aha wotemo ona goona Awi ngoa-ngoa'a.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Duru yohanaango'a o nyawa-nyawa ge yama'e o hangihara o nyawano hababu yodiai o haala yaowa-owa,</para>
  <para style="q2" vid="MAT 5:10">hababu onau goona yodadi ma Jou ma Dutu awi 'awaha nage ma Jou ma Dutu awi pareta'a.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Duru niohanaango'a ngini ge mangale nionii'i Ngoino,</para>
  <para style="q2" vid="MAT 5:11">nihohedu,</para>
  <para style="q2" vid="MAT 5:11">nihangihara,</para>
  <para style="q2" vid="MAT 5:11">de nironga madiiha.<verse eid="MAT 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 5:12" />Niohanaanga de nimagaragou,</para>
  <para style="q2" vid="MAT 5:12">hababu ma Jou ma Dutu wohidiaio'au nia hewa ma amo'o o horoga'a. Hababu, o nabi-nabi ma hila ma itihila'au yohangihara harage de ngini niaohana.&gt;&gt;<verse eid="MAT 5:12" /></para>
  <para style="s">O gahi de daraanga</para>
  <para style="r">(Mrk. 9:50; Luk. 14:34-35)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />O Yesus wotemoli, &lt;&lt;Ngini geena harage de 'ao gahi o dunia'a. Na'o o gahi de 'apamaowau 'igahi, de o 'iahi done pohigahi? Geena 'ai baragunawau, ma 'ayaumo de yado'o-do'o.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Ngini ma harage de o daraanga o dunia'a. O bendara da'u o de'u ma tubuo'a 'aidadiwa yohidutulu'u. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />'Amoiwa o hilo yatuu'i'a de yohitamunu'u de o tampayanga, ma maraio'au yohitodengu'u ma ngiio'a la moi-moi o nyawa o woa ma doda'a ge yo'idararono. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />'Ogeenali ma nia daraanga geena halingou ihiwa o nyawa'a, la ona yama'e o'iau hona niodiaio'au yaowa-owa geena, de wipuji nia Dea o horoga'a.&gt;&gt;<verse eid="MAT 5:16" /></para>
  <para style="s">O Yahudio'a manga agama ma do-doto'o</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />&lt;&lt;Uwa niotemo, na'o Ngoi taino neena tayoihanga o Musa awi Hu'umu de o nabi-nabi manga do-doto'o. Ngoi taino 'a taihangua, ma 'ena tohimaiti ma mangariti ma gou-goungu. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Nioihene nihidi-diai e! Na'o o diwanga de o tona'a 'ademaenahi, geena 'a ma ube-ubewa ma 'aiihangua ma hu'umu geena, na'o moi-moi ge ma hu'umo'a geena 'oidadiwahi. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Hababu geena, nagoonau yapalene o do-doto'o geena ngaro 'a ma ube-ubewa ma, de yohidoto'o o nyawa'a la ona ma 'ogeena, ona geena aha iholoi yoete'e ma Jou ma Dutu awi 'awaha'a. Ma nage yodinii'i ma dodoto'o geena de yohidoto'o o nyawa'a 'ogeenali, ona geena aha yoamo'o ma Jou ma Dutu awi awaha'a. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Ho nioihene nihidi-diai! Na'o ngini niomau niodadi ma Jou ma Dutu awi 'awaha, geena halingou ngini 'iholoide niodiai ma Jou ma Dutu awi mau de nage o Yahudio'a manga agama'a yodoto-doto'o de o Farisio'a.&gt;&gt;<verse eid="MAT 5:20" /></para>
  <para style="s">O hitiari mangale o ganamoto</para>
  <para style="r">(Luk. 12:57-59)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />&lt;&lt;Ngini niana'o'au nanga edete de nanga dotumu yo'ihidoto'o onane: &lt;Uwa niotooma. Nagoonau yotooma aha yo'ihu'umu.&gt; <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Ma neena Ngoi tinihidemo e, nagoonau bato ngaro yongamo duga 'ao nyawa'a, ona aha yo'ihu'umu. De nagoonau yodoana o nyawa'a, ona aha o agama'a ma baluhu yo'ihu'umu. De nagoonau yotemo o nyawa'a yohuma, ona aha yo'ihu'umu o u'u o naraka'a nage 'ito'a-to'ara. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Ho, na'o nia hu-huba nio'ula ma Jou ma Dutu'a de niodanganono na'o naga o nyawa manga hininga 'ihau'u nginino, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />geena halingou nianoa'ohi nia hu-huba geena o hu-huba 'idu-dutuu'u ma date'o'a, la niotagi nima'adame'ahi nage manga hininga niahau-hau'o'a. Geena'a de aha nima'ilio nio'ula niahu-huba geena ma Jou ma Dutu'a.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />Na'o naga o nyawa yotemo niahala, de yomau niaha o ha'imi'a, ngini halingou itai-taiti nimahi'alooahohi wa'utu 'a o nge'ominohi. Hababu, na'o 'anima'adamewa, maraio'au niaha o ha'imi'a. De ona aha nihigiama ma hoata o hurudado'a de nihiohama o bui'a. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Nioda-danganono e, maraio'au ngini 'aidadiwahi niohupu o buino na'o nia nagimi oniabootuahi niohangu.&gt;&gt;<verse eid="MAT 5:26" /></para>
  <para style="s">Mangale o howono</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />&lt;&lt;Ngini niana'o'au o do-doto'o harage oneena: &lt;Uwa niohowono.&gt;<verse eid="MAT 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 5:28" />Ma neena Ngoi tinitemo e, naguunau o naulu womatengo mima'e o ngewe'a awi hininga'a midanyahihuu, geena ma nyawa guuna wohowono'au de ma ngewe'a guumuna awi hininga'a. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Na'o nia la'o ma hononga nidiai hiadono niobaradoha, nia'uapeti'au de niaumo'au ma nia la'o geena! Iholoi yaowa nia la'o ma hononga 'iihanga de 'anihu'umua, uwa hiadono de nia la'o modidio'a ma nia roehe ma ngodumu niumo o naraka'a. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Na'o nia giama ma hononga nidiai hiadono niobaradoha, niaoto'au de niaumo ma nia giama geena! 'Iholoi yaowa nia giama ma hononga 'iihanga, uwa hiadono de nia giama modidihona ma nia roehe ma ngodumu 'iohama o naraka'a.&gt;&gt;<verse eid="MAT 5:30" /></para>
  <para style="s">O ngo-ngolu'u</para>
  <para style="r">(Mat. 19:9; Mrk. 10:11-12; Luk. 16:18)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />O Yesus wotemoli, &lt;&lt;Demaenali ma o do-doto'o harage onane: &lt;Nagoonau manga we'ata yo'iolu'u, halingou o ngo-ngolu'u ma hurata yo'ula manga we'ati'a.&gt; <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Duga neena Ngoi tinitemo ngini'a e, o naulu 'aidadi awi we'ata miolu'u na'o ma we'ata mohowono'au. Ma na'o 'ouwa, de ma naulu guuna awi we'ata miolu'u, geena wodiaio'au ma we'ata mohala ma Jou ma Dutu awi biono'a. Hababu, na'o ma ngewe'a nage miolu'o'au momodo'ali de o nyawa ma homoa, geena harage de o ngewe'a nage mohowo-howono, de o nyawa ge mimo-modo'a ma wahala'au ma Jou ma Dutu awi biono'a, hababu ma nyawa guuna ma harage wohowono'au.&gt;&gt;<verse eid="MAT 5:32" /></para>
  <para style="s">Mangale o gogoboto</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />&lt;&lt;Ngini niana'o'au nanga edete de nanga dotumu manga do-doto'o onane: &lt;Uwa niapalene nia gogoboto, o'iau naga nio'oboto'au ma Jou ma Dutu awi biono'a, halingou niadiai.&gt; <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Ma neena ngoi tinitemo ngini'a: 'A ma ube-ubewa ma uwa nio'oboto, ngaro de o diwanga ma, hababu geena ma Jou ma Dutu awi ngii mangale wopareta; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />de o tona'a ma ronga, hababu o tona'a geena ma Jou ma Dutu awi dou ma angi. Ngini ma uwa nio'oboto de o Yerusalem ma bendara ma ronga, hababu o bendara geena to ma Jou ma Dutu, Una geena ma 'Oana woamo-amo'o. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Ngini ma uwa nio'oboto de tingini mahirete nia hae'e, hababu ngini 'aniadadiwa niadiai nia utu 'iarehe e'ola 'ibiihi ngaro 'ao lia moi ma. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Ngaro 'aniotemo, &lt;'Iyolo&gt; e'ola &lt;'Ouwa&gt; Na'o 'iholoi de geena 'ao to'ata ma 'oanino.&gt;&gt;<verse eid="MAT 5:37" /></para>
  <para style="s">O tingi'ai uwa pohibalaha de o tingi'ai</para>
  <para style="r">(Luk. 6:29-30)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />O Yesus wotemoli, &lt;&lt;Ngini ma niana'o'au o do-doto'o harage de onane: &lt;Na'o o nyawa manga la'o niatiiha, tingini ma yatiiha. Na'o o nyawa manga ilingi niaota'a, tingini ma yaota'a.&gt; <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ma Ngoi tinitemo e, uwa niobalaha o tingi'ai o nyawa'a, nage yoti-tingi'ai ngini'a. Ma nagoonau yapo'a nia niagotoa'a ma guida'a geena ya owa ma gubalioli nihida'unu. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />De na'o o nyawa niaha o ha'imi'a hababu yomau yaehe nia baju, geena nio'i'ulali nia baju 'i'a-'a'ulu'u. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />De na'o naga o nyawa nipa'iha niamo'u manga gina ma ga'ulu o kilo moi'a, ge'ena halingou niamo'uou o kilo modidi'a. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Na'o o nyawa yomagaaho'o nia 'iani ngini'a, nio'i'ula'a. De na'o yomadabau nia 'iani, uwa 'anio'i'ulawa.&gt;&gt;<verse eid="MAT 5:42" /></para>
  <para style="s">Nia haturuu nio'idora</para>
  <para style="r">(Luk. 6:27-28, 32-36)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />&lt;&lt;Ngini nioiheno'au o dodoto'o onane ma demo: &lt;Nio'idora nia ma-manai, de nio'ibuhulu ge nia haturuu.&gt; <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ma Ngoi tinitemo e, nio'idora nia haturuu, de nio'idahaubayanga ona ge nihangihara ngini'a, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />la ngini aha niodadi nia Dea o horoga'a awi ngoa-ngoa'a. Hababu ma Jou ma Dutu awi wange ma la'o wohipuda mangale o nyawa ma owa de o nyawa ma diiha ma. Una ma wohiguti o beha'a, mangale o nyawa manga wowango yaowa-owa de iti-tiiha ma. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Hababu na'o nio'ihibohono duga 'a nyawa'a nage nihibohono ngini'a, o 'iau done aha niama'e? Uwa nionganono o hewa ma Jou ma Dutuno. Hababu o balahiteenge yoga-gaaho'o ma 'ogeena yodiai. <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />De na'o nio'itabea duga ge 'ania nyawa'a, o 'iau ma holoi de o nyawa ma homoa? O nyawa ge 'awina'owa ma Jou ma Dutu ma yodiai 'ogeena! <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Ania Dea o horoga'a wohigou-goungu wo'idora o nyawa'a moi-moi. Ho ngini ma halingou 'ogeena.&gt;&gt;<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">O hitiari mangale o nyawa po'iduhunu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />&lt;&lt;Niohi-hininga! Na'o o agama ma mau niadiai uwa niohimaiti'a. Hababu na'o niohimaiti'a, nia Dea da'u o horoga'a o hewa 'aniwi'ulawa.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />Geenau ho na'o yohu-huha nio'iduhunu, uwa niohimaiti'a harage o nyawa 'ayomaelu-elu'u. 'Ona yaigo o dodoomu ma woa'a de o tapa'o'a la bali o nyawa yo'ihidaiyana. Niohi-hininga! Ona geena yama'e'au manga hewa, geena la o nyawa yo'ihidaiyana. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Ma na'o nia 'iani nio'ula o nyawa'a, geena animahibongonino la o nyawa uwa yana'o. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Mada'a la o 'iani nio'ula geena duga 'a ma Jou ma Dutu wana'o. Una aha niwihewa. Nage Wama'e 'animahibongonino.&gt;&gt;<verse eid="MAT 6:4" /></para>
  <para style="s">O do-doto'o mangale pohaubayanga</para>
  <para style="r">(Luk. 11:2-4)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />&lt;&lt;Na'o nimadahaubayanga, geena uwa harage de o nyawa 'ayomaelu-elu'u la halingou 'a o dodoomu ma woa'a yai'a, e'ola o 'awaha manga biono'a la o nyawa nima'e. Nioihene nihidi-diai e, geenau to ona manga hewa geena la o nyawa yo'ihidaiyana.<verse eid="MAT 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 6:6" />Duga na'o la nimadahaubayanga, geena nimahidebeno'a nia ngiio'a la nia Dea ge o nyawa 'awima'e-ma'ewa wama'e 'ogeena de niwihewa.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />Ho na'o nimadahaubayanga, geena ma betongo uwa 'ageena niogi-gilio harage 'ao nyawa ge ma Jou ma Dutu 'awina'o-na'owa. Ona yotemo bali na'o manga haubayanga ma betongo i'udai de i'a-'a'uli'a geena aha ma Jou ma Dutu wadawongo. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Uwa harage de ona, hababu nia Dea wana'o'au nia paraluu 'animadahaubayanguahi ena. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Ho nimadahaubayanga onane,</para>
  <para style="q1" vid="MAT 6:9">&lt;Mia Aba da'u o horoga'a!</para>
  <para style="q2" vid="MAT 6:9">Tanu ngomi o nyawa moi-moi Ani ronga miapuji.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Tanu ngona noparetau o dunia'a,</para>
  <para style="q2" vid="MAT 6:10">de tanu ani mau mianii'i</para>
  <para style="q2" vid="MAT 6:10">neena'a harage o horoga'a.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Tanu no'ula mia inomo</para>
  <para style="q2" vid="MAT 6:11">ge miaparaluu neena ma wange.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />De tanu nimiapongo mia hala</para>
  <para style="q2" vid="MAT 6:12">harage 'angomioli mi'iapongo</para>
  <para style="q2" vid="MAT 6:12">o nyawa manga hala ngomino.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />De uwa nimimada'a mitaili,</para>
  <para style="q2" vid="MAT 6:13">ma nimihipidili o diihano.</para>
  <para style="q2" vid="MAT 6:13">[Ngona geena ma 'Oana, nopa-pareta, nimipuji 'ahiado-adoni'a. Amin.]&gt;<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Hababu na'o ngini ni'iapongo o nyawa'a nage yahala'au ngini'a, nia Dea o horoga'a ma niwiapongo ngini'a. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ma na'o ngini 'ani'iapongua o nyawa'a nage yahala'au ngini'a, nia Dea o horoga'a ma niwiapongua ngini'a.&gt;&gt;<verse eid="MAT 6:15" /></para>
  <para style="s">O hitiari mangle o puaha</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />O Yesus wotemoli, &lt;&lt;Na'o niopuaha, geena uwa nia biono 'ailamaanu'u harage de o nyawa ge yomaelu-elu'u manga biono ma yangalio'a, la o nyawa yo'ina'o na'o ona yopuaha la yo'ihidaiyana. Nioda-danganono e! Geenau to ona manga hewa yama'e'au. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ma na'o ngini niopuaha'a, geena nimamamahau'o'a de nimawuhi'a. <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />La o nyawa uwa yana'o na'o niopuaha'a, duga 'ania Dea ge o nyawa 'awima'e-ma'ewa Una aha niwihewa ge wama'e 'animahibongonino.&gt;&gt;<verse eid="MAT 6:18" /></para>
  <para style="s">O 'arataa o horoga'a</para>
  <para style="r">(Luk. 12:33-34)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />&lt;&lt;Uwa nimadolomu o arata o dunia'a, hababu o butete'e de o moo'o aha yatiiha, de yotohi-tohi'i yoboa yatohi'i ma 'arataa. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Ma 'iholoi yaowa nimadolomu o 'arataa o horoga'a ge o bute-te'e de 'aimoo'uwau, de yotohi-tohi'i 'ayatohi'uwau. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Hababu 'ia'a naga nia 'arata, nia hininga ma geena'a.&gt;&gt;<verse eid="MAT 6:21" /></para>
  <para style="s">O roehe ma hilo</para>
  <para style="r">(Luk. 11:34-36)</para>
  <para style="p">
    <verse number="22-23" style="v" sid="MAT 6:22-23" />&lt;&lt;Nanga la'o geena 'aimatero de nanga roehe ma hilo. Na'o nia la'o idoto geena aha nimahima'e itiai 'o'iau hona niodi-diaio'au. Ma na'o nia la'o 'aidodonua geena ngini aha harage o daluho'a. Ho na'o nia hilo 'aidaraangua, geena aha pohironga 'italuho'au.&gt;&gt;<verse eid="MAT 6:22-23" /></para>
  <para style="s">Ma Jou ma Dutu awi mau de o 'arataa</para>
  <para style="r">(Luk. 16:13, 12:22-31)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />&lt;&lt;'Amoiwa yo'arajaanga manga baluhu yamididio'a; hababu aha womatengo iholoi widora de ge womatengo'ali wibuhulu, e'ola aha womatengo'a 'iholoi wihingounu de ge womatengo'ali. 'Ogeenali ma ngini. Na'o niowango de 'animadolomu o araata o dunia'a, marai ngini 'aidadiwa nio'arajaanga to ma Jou ma Dutu awi mau.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Hababu geena nioda-danganono! Uwa niododato mangale nia wowango, o 'iau aha niaodomo e'ola niao'ele. De ngini ma uwa niododato de tingini niaroehe, o 'iau aha nia pa'e. Ngini niana'o nia wowango 'iholoi ibaraguna de o inomo de nia roehe 'iholoi ibaraguna de o pa'eanga. <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Bee'a niataila'o o namo-namo o ginita'a, ena 'oimadutudu'uwa de 'oimadugutu'uwa, de 'aimadolomuwa ma tila-tila'a, ma ma Jou ma Dutu watowo! Hongoli ngini? Ngini de o namo geena nginiohi 'iholoi niobaraguna to? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Na'o ngini niododato de nia wowango o wutu de o wange, bote 'aidadi nia umuru nia dogo ngaro 'a ma ube-ubewa ma? Maraio'au 'ai dadiwa to?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />Idodoau ho niododato ma ngale nia pa'eanga? Niagelelo o huri-huri 'iwangode o godoa'a, ena 'oima'arajaangua de ma baju 'oimadidiniwa, <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />ma ma 'oana o Salomo awi 'aya ma awi pa'eanga 'a 'ogeenawa ma rahai harage de o huri-huri geena. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />O ubutu o godoa'a neena ma wange 'iwangode de ma dewelano yatuu'o'au yaboo-booti'a, ma ma Jou ma Dutu wapaliara de wadiai 'irahai. Hongoli ngini o nyawa? Maraio'au ma Jou niwipaliara de wadiai niawowango 'irahai. Ho dodoau ho ngini i'uranga nionga'u? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Uwa niododato de uwa niotemo, o'iau aha paodomo de pao'ele, de o'iau aha pomahinoa? <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />'Ogeena dau geena yahali-hali'i, o nyawa gee ma Jou ma Dutu 'awinga'uwa. Ma nia Dea o horoga'a wana'o, na'o ngini nioparaluu moi-moi geena. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Ho, niatihila niadiai to ma Jou ma Dutu awi pareta la Wapareta niawowango, de nia paraluu aha wo'ula. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Hababu geenau ho, uwa niododato o dewela ma wange, hababu o dewela ma wange geena de ma enali to ena ma huha. Neena ma wange yaowa'au to ena ma huha, ho uwau niadogo.&gt;&gt;<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Uwa nimahi'ahala</para>
  <para style="r">(Luk. 6:37-38, 41-42)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />O Yesus wotemoli, &lt;&lt;Uwa ni'ihihala o nyawa'a la ma Jou ma Dutu ma 'a niwihihalawa ngini'a. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Hababu harage ho'o'ia ni'ihihala o nyawa'a, ma Jou ma Dutu ma niwihihala ngini'a o geena. De o duduga nage nihipa'e o nyawa'a mangale ni'ihituga manga hala, ma Jou ma Dutu ma aha wapa'e mangale niwihituga nia hala. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Dodoauho niage-gelelo o nyawa manga hala ma ete'e, ma nia hala ma amo'o ma 'aniomalii-liillo'a? Geena harage o geneo 'iete-ete'e nia ma'e nia riado-doto manga la'o'a, ena momongo bala'a ma dobi'i nage yatamuno'o ma nia la'o'o ma hirete, ma 'aniama'ewa. <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Ho icara'iau ngini 'aidadi niotemo nia riadodoti'a, &lt;Ino taai'i ani la'o ma geneo&gt;, ena momongo tinginio'a ma nia la'o'a mahirete o bala'a ma dobi'i. <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Ee, tengelu'u! Tingini 'ihila nihihupu o bala'a ma dobi'i nia la'o'a, la nimahima'e itiaio'ahi aha de niohihupu o bala'a ma dobi'i nia riado-doto manga la'o'a.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />Uwa nio'ula o 'iani 'iofi-ofi o 'aho'a, la ma 'aho geena 'imalelo'o de nigoli. De uwa nio'ula o mutiara o booki'a, la ma booko geena uwa yado'o-do'o ma mutiara geena.&gt;&gt;<verse eid="MAT 7:6" /></para>
  <para style="s">Nimagaaho'o ma Jou'a o 'iau nage nioparaluu</para>
  <para style="r">(Luk. 11:9-13)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />O Yesus wotemoli, &lt;&lt;Nimagaaho'o ma Jou ma Dutu'a la aha niwi'ula, nimadahali'i la nimadama'e. Nimatoilingi la aha o ngoana Niwidapaata. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Hababu nagoonau yomagaho'o aha wo'i'ula de nagoonau yomadahali'i aha yomadama'e, de nagoonau yoomatoilingi aha o ngoana Niwidapaata. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />'Amoiwa na'o manga ngoa'a yogaaho'o o roti de ma dea wo'ula o heleo, <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />e'ola na'o o ngoa'a yogaaho'o o nao'o de ma dea wo'ula o ngia. <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Ngaro niotingi'ai, ma 'aniana'o nio'ula yaowa-owa nia ngoa'i'a. Hongoli nia Dea da'u o horoga'a, Una aha 'iholoi wo'ula yaowa-owa o nyawa ge yomagaaho'o Una'a!<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />Ho niodiai o nyawa'a nage harage de ngini niaigo o nyawa yodiai ngini'a, geena o Musa de o nabi-nabi manga do-doto'o matiti.&gt;&gt;<verse eid="MAT 7:12" /></para>
  <para style="s">O ngoana 'ipe-peeto</para>
  <para style="r">(Luk. 13:24)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />O Yesus wotemoli, &lt;&lt;Nioohamou o ngoana 'ipe-peeto! Hababu, na'o nioohama niaboa o ngoana 'imo-amo'i'a geena, 'ihi'ai'a o naraka'a, ma nge'omo geena 'ai hangirawa de geena'a o nyawa manga lepe yaboa. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Ma na'o nioohama niaboa o ngoana 'ipe-peeto'a, geena 'ihi'ai'a o wowango'a, o nge'omo geena 'ipeeto de 'ihangihara de 'ayolepewa geena'a yaboa.&gt;&gt;<verse eid="MAT 7:14" /></para>
  <para style="s">O gota ma roehe de ma howo'o</para>
  <para style="r">(Luk. 6:43-44)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />O Yesus wotemoli, &lt;&lt;Ngini halingou nimahidi-diai de o nabi-nabi'a ge yoelu-elu'u hababu ona nidoboa harage de o domba, ena momongo ona geena harage de o 'aewani 'iti-tingi'ai. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Ngini aha ni'ina-na'o de to ona manga go'oie de manga gogelu'u. O gota 'ihi-hihi'a, maraio'au 'aihowo'ua o anggur ma howo'o e'ola 'aihowo'ua o ara ma howo'o. <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Moi-moi o gota ma owa-owa maraio'au ma howo'o ma ma owa-owa, ma o gota iti-tiiha maraio'au ma howo'o ma itiiha. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Maraio'au o gota ma owa, de ma howo'o itiiha, e'ola o gota ma diiha ma 'aihowo'o. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Ho o gota ge 'ihowo'o iti-tiiha, maraio'au aha yatodanga de yohidaulu o u'u'a. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />O geenali ma de o nabi yoelu-elu'u ngini aha nio'ina-na'o de to ona manga go'oie de manga gogelu'u.&gt;&gt;<verse eid="MAT 7:20" /></para>
  <para style="s">Nadiai la uwa 'a ma demo'a</para>
  <para style="r">(Luk. 13:25-27)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />O Yesus wotemoli, &lt;&lt;'A moi-moiwa o nyawa 'iaho'o Ngoino, &lt;Jou, Jou,&gt; aha podadi ma Jou ma Dutu awi 'awaha, ma 'a o nyawa-nyawa nage yadinii'i 'ai Dea o horoga'a awi mau. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />O dunia ma baha'a aha, o nyawa manga lepe yotemo Ngoino, &lt;Jou! Jou! De to Ngona ani ronga ngomi mihihabario'au ma Jou ma Dutu awi behehongo, o to'ata mioginii'i, de o haala 'ihera-heranga ma miodiai!&gt; <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Ma Ngoi aha totemo, &lt;Ngoi 'a tinina'owa! Nimagoa'i'a nena'a ngini ge nioti-tingi'ai.&gt; &gt;&gt;<verse eid="MAT 7:23" /></para>
  <para style="s">O nyawa yonga'u-nga'u halingou yadiai o 'iau o Yesus wotemo</para>
  <para style="r">(Luk. 6:47-49)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />O Yesus wotemoli, &lt;&lt;Nagoonau yoiheno'au 'ai demo neena de yodomote'e, ona geena harage de womatengo awi woa wohigo'o o heleo ma de'uo'a. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Ho ma oraha o beha'a hiadono 'inguuihi, de o rato ma, ma 'ailubawa hababu ma woa geena wohigo'o o woa ma babangino'a o heleo nage i'ua-'uata.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />Ma o nyawa ge yoiheno'au 'ai demo neena de yodomote'ua, ona geena harage de o nyawa ge yohuma-huma nage wohigo'o awi woa o dowongio'a. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Wa'utu o beha'a de yodunguihi de yodarato, ma woa geena 'iluba 'ihoroma ibooto'a.&gt;&gt;<verse eid="MAT 7:27" /></para>
  <para style="s">O Yesus awi 'uaha</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Wa'utu iduango'au o Yesus womaade-ade, de o nyawa yolepe-lepe geena'a ge duru yoheranga yoihene awi dodoto'o geena. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Hababu Una wo'idoto'o 'a de to Unama hirete awi 'uaha 'aimaterowa de to ona manga agama'a yodoto-doto'o.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">O Yesus wihiai'i o nyawa womatengo wopado-pado</para>
  <para style="r">(Mrk. 1:40-45; Luk. 5:12-16)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />O Yesus wouti o de'uo'a de wau'u geena, de o nyawa manga lepe winii'i Una'a. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Ma oraha geena o nyawa womatengo wopado-pado woboa Unano. Ma nyawa guuna watilabu'u'u o Yesus awi biono'a de wotemo, &lt;&lt;Ee Aba, na'o nomode'e de noihiai'i.&gt;&gt;<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />De o Yesus wigagao ma nyawa'a guuna de wotemo, &lt;&lt;Ngoi tomode'e. Ho neena noai'ou.&gt;&gt; De 'ageena'a ena ma nyawa guuna awi panya'e 'iai'o'au. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Geena iduangino, de o Yesus wotemo ma nyawa'a guuna, &lt;&lt;Noda-danganono e, Uwa nohi'a-'angahu 'a moi'a ma, ma notagi o imami'a de nogaaho'o wonitaila'o la wana'o 'igou-goungu ani panya'e 'iai'o'au. De aha nohihuba o huhuba nage harage ma nabi o Musa wohulo'o'au, geena ho'a o dudunguu na'o 'igou-goungu ani panya'e 'iai'o'au.&gt;&gt;<verse eid="MAT 8:4" /></para>
  <para style="s">O Yesus wihiai'i ma 'apita awi gilaongo womatengo</para>
  <para style="r">(Luk. 7:1-10)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Wa'utu o Yesus woohama o Kapernaum ma bendari'a, geena'a de ma 'apita womatengo woboa de wogaaho'o Una'a: <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />&lt;&lt;Aba, 'ai gilaongo wopanya'e magigiria'ao do'a o woa'a. Wopaluga'au. Una duru wohangihara.&gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />O Yesus wotemo una'a, &lt;&lt;Ngoi aha ta'ai'a towihiai'i.&gt;&gt;<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />De ma 'apita guuna wotemo o Yesusi'a, &lt;&lt;Aba, 'uwau na'ai'a 'ai woa'a, hababu ngoi oyadaenua Tonidawongo 'ai woa'a Aba, Iti Aba notemo o demo o ngale moi neena'a de naino, maraio'au 'ai gilaongo guuna woai'i. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Hababu ngoi tana'o Aba 'anadadi napareta o nyawa'a la yoai'i, harage de ngomi o hurudado ma idadi mi'ipareta mia nyawa'a. Ngoio'a demaenahi iholoi yo'a'ulie, de ngoio'a de u'u demaenali ma o hurudado halingou yodinii'i 'ai pareta. Nao to'ipareta 'ai nyawa-nyawa'a tote, &lt;Notagi!&gt; Maraio'au una wotagi. Na'o to'ipareta 'ai nyawa'a ma reguoli tote, &lt;Na'aino!&gt; Maraio'au una wo'aino. De na'o to'ipareta 'ai nyawa yo'a-'arajaangi'a ma reguoli, &lt;Neena nodiai!&gt; Maraio'au wadiai o 'iau nage to'ipareta.&gt;&gt;<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />O Yesus woihene ma haala geena iduangino, de o Una duru woherana, de Wotemo o nyawa-nyawa'a nage winii-nii'i Una'a, &lt;&lt;Nioihene nihidi-diai e, 'omaiwahi Tama'e o nyawa womatengo awi ngonga'u ma amo'o o Israel ma bangihano. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Nioda-danganono e, 'ahao o nyawa manga lepe nage 'a o Yahudio'awa o dunia'a neena, o wange ma hiwa'a hiadono o wange ma dumuno'a, ona moi-moi yodadiou ma Jou awi 'awaha, de yogogelou yomahidoomo de ma Aba o Abraham, o Ishak de o Yakub ma Jou ma Dutu awi pareta'a. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Ma ngaro ma Jou ma Dutu wo'ili'i o Yahudi ma bangiha yodadi Awi 'awaha, ma manga lepe onano 'ayo'iiwa do'a. Ma Jou ma Dutu aha wo'iumo o dingii 'italu-taluhi'a. Geena'a, ona aha yoali de duru yohangihara.&gt;&gt; <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Geena iduangino, O Yesus wotemo ma 'apita'a guuna, &lt;&lt;O oraha neena, aba noliou! Aba nonga'u ngaro Ngoi 'aneena'a tomaade-ade, aba ani gilaongo 'aidadi woai'i. Harage de ngona ani nonga'u.&gt;&gt; Ho 'ageena'a ena ma 'apita awi gilaongo woai'o'au.<verse eid="MAT 8:13" /></para>
  <para style="s">O Yesus wohiai'i o Simon ma diotono o ngewe'a de o nyawa ma reguoli</para>
  <para style="r">(Mrk. 1:29-34; Luk. 4:38-41)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Geena iduangino, o Yesus wotagi o Petrus awi woa'a. De mima'e o Petrus ma diotono o ngewe'a momaiduo'a o dangilo'a hababu migogama. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Geena'a de o Yesus wagagao ami giami'a, de ami panya'e geena 'iai'i, ho momomi'ie de mohidiai la o Yesus woodomo.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Wa'utu o wutuou, de o nyawa-nyawa ge o to'ata yo'ido-dongohami'a manga lepe yo'iaha o Yesusino, de wa'o'iginii'i ma to'ata geena 'a de o demo o ngale moi, de Una ma wohiai'i moi-moi o nyawa yopa-panya'e. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />O geena idadi la harage de o Nabi Yesaya wohidemo'au onane, &lt;&lt;Una wamo'u to ngone nanga hangihara de wohiai'i nanga panya'e!&gt;&gt;<verse eid="MAT 8:17" /></para>
  <para style="s">O nyawa nage yomau winii'i o Yesus</para>
  <para style="r">(Luk. 9:57-62)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Wa'utu o Yesus wo'ima'e o nyawa manga lepe wihigilolitino, de Una wohulo'o awi ni-nii'i'a la yodihidete do'a o talaga ma hongona'a. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Geena'a de o Yahudio'a manga agama'a yodoto-doto'o womatengo woboa de wotemo o Yesusi'a, &lt;&lt;Aba Guru, ngoi tonii'i o 'ia'a naga bato!&gt;&gt;<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />De o Yesus wopaluhu, &lt;&lt;O 'aewani 'iti-tingi'ai de ma aru'o'a. 'Ogeenali ma de o namo o ginita'a, de ma iguto'a. Ma o Nyawa ma Ngoa'a a'oiwa awi dingii mangale womahiaini.&gt;&gt;<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />De o Yesusi'a ge wi ni-nii'i womatengo wotemo, &lt;&lt;Aba! Tanu toliohi 'ai dea towipoohu'u ihila.&gt;&gt;<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Ma o Yesus wopaluhu, &lt;&lt;Noinii'ou! Mada'a la o nyawa nage 'a yodo-domote'ua ma Jou ma Dutu awi mau yapoohu'u manga nyawa yohone-honenge.&gt;&gt;<verse eid="MAT 8:22" /></para>
  <para style="s">O Yesus o rato wohiogo</para>
  <para style="r">(Mrk. 4:35-41; Luk. 8:22-25)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Geena'a de o Yesus wopalene o ngootilie, de awi ni-nii'i ma yonii'i. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />De itodo'anino o rato geena ma talaga'a, ho manga ngootili o mo'u-mo'u yapo'a. Ma ma oraha geena o Yesus womaiduo'a. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Ho awi ni-nii'i ya'ai'a witomanga yotemo, &lt;&lt;Aba! Nonaduhunohi, polutuou ho!&gt;&gt;<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />De o Yesus wotemo ona'a, &lt;&lt;Ee Ngini o nyawa nage i'uranga nionga'u-nga'u, Dodoau ho niohawana?&gt;&gt; Geena'a de o Yesus womagoa'ie de wodorohu o rato de mo'u-mo'u geena, ho ma talaga geena 'iogo.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Yama'e o geena, de o Yesus awi ni-nii'i yoheranga, de yoma'a-atemo, &lt;&lt;O nyawa o 'iau Nuuna e? Hiadono o rato de o mo'u-mo'u ma yodinii'i Awi pareta.&gt;&gt;<verse eid="MAT 8:27" /></para>
  <para style="s">O Yesus o to'ata waginii'i</para>
  <para style="r">(Mrk. 5:1-20; Luk. 8:26-39)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Ma oraha yomahiadoni'a do'a o talaga ma hononga'a, o Gadara ma daera'a, de yamididi o to'ata yo'idongohami'a yohupu o bo-boohu'o'a de ya'aino o Yesusino. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />De ma to'ata geena 'imaorehe nage ma nyawa'a yamimidi goona, &lt;&lt;Adede, Jou ma Dutu awi ngoa'a! Nomau nimidodoau? Ani wa'utu mangale nimihangihara 'ayaadonuahi, dodoau ho o oraha neena nimihangiharau?&gt;&gt;<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Geena ma date'o'a, de o boo-booko ma lepe geena'a 'imaduhumele magigiria'a. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />De ma to'a-to'ata geena 'imagaaho'o o Yesusi'a onane, &lt;&lt;Na'o nimiginii'i, nimihulo'o la mioohama o boo-booki'a geena.&gt;&gt;<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />De o Yesus wotemo ona'a, &lt;&lt;Tagi niohupu!&gt;&gt; Geena'a de ma to'a-to'ata geena 'ihupu ma nyawano goona yamididi de 'iohama o boo-booki'a geena. De ma boo-booko geena 'ihuruputu o baa'oro ma date'i'a, de moi-moi 'imatebulu o talaga'u de ilutu ho 'ihonenge.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Yama'e 'ogeena de, o nyawa nage yogoa-goana ma boo-booko geena yoloa, yomahiadoni'a o bendarao'a, yohijarita moi-moi ge 'ida-dadio'au. Ona ma yohijarita mangale o'iau idadio'au nage ma nyawa yamididi'a goona. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Geena yoihene iduangino, ho o nyawa-nyawa o bendaro'a geena yomahidobooto'a yotagi o Yesusi'a. Wa'utu yoma'ama'e de o Yesus, ona yogaaho'o o Yesusi'a la Una wa mada manga daera geena.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">O Yesus wohiai'i o nyawa womatengo wopa-paluga</para>
  <para style="r">(Mrk. 2:1-12; Luk. 5:17-26)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Geena iduangino, de o Yesus de awi ni-nii'i yopalene o ngootilie de yoma'ilioli o talaga ma hononga'a, Awi hoani'a. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Geena'a do'a, yamuluo naga wiaha womatengo wopa-paluga o Yesusino wiiduha o 'o'owa'a. Wa'utu o Yesus wo'ima'e to ona manga ngonga'u ma 'uata, de wotemo wopa-paluga'a ge, &lt;&lt;'ai ngoa'a, nohanangou. Ani baradoha taapongo'au.&gt;&gt;<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Ho o Yahudio'a manga agama'a yodoto-doto'o yamuluo naga geena'a manga hininga'a yotemo, &lt;&lt;Ma nyawa nuuna wihohedu ma Jou ma dutu'a!&gt;&gt;<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Ma o Yesus wana'o manga hininga ma doda, ho wotemo, &lt;&lt;idodoau ho nia didibanga iti-tiiha? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />'Ia'a 'iholoi 'igapanga totemo wopa-paluga'a, &lt;Ani baradoha taapongo'au&gt;, e'ola totemo, &lt;nomomi'i de notagiou?&gt; <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Ho neena Ngoi una towihiai'i, la naina'o, o dunia'a neena o Nyawa ma Ngoa'a de Awi 'uaha'a mangale waapongo o nyawa manga baradoha&gt;&gt; Geena'a de o Yesus wotemo wopa-paluga'a, &lt;&lt;Nomomi'ou, nagoa'ou ma ani 'o'owa, de noliou ani woa'a!&gt;&gt;<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Geena'a de wopa-paluga guuna womomi'i, de wolio awi woa'a. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Yama'e 'ogeena, de o nyawa yolepe-lepe goona yohawana de wipuji ma Jou ma dutu'a, hababu ma Jou ma Dutu wo'ula'au o 'uaha ma amo'o o nyawa'a guuna o dunia'a neena.<verse eid="MAT 9:8" /></para>
  <para style="s">O Yesus wiaho'o o Matiusi'a</para>
  <para style="r">(Mrk. 2:13-17; Luk. 5:27-32)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Geena'a de, o Yesus wotagi wamada ma dingi geena, de Una wima'e womatengo o balahiteenge woga-gaaho'o wo'arajaanga wogogelu'u o balahiteenge ma kantoro'a. Awi ronga o Matius. O Yesus wotemo una'a, &lt;&lt;Naino noinii'i Ngoino.&gt;&gt; Geena'a de o Matius womagoa'a de winii'i o Yesusi'a.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Wa'utu'o Yesus wo'odomo ma gigiria'a o Matius awi woa'a, geena'a de yoboa o balihetenge yogagaaho'o ma reguoli, de o nyawa yoba-baradoha nage yote de yomahidoodomo de o Yesus de Awi ni-nii'i. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Gena'a de o Farisio'a ma nyawa yama'e ma haala geena, de ona yohano o Yesus awi ni-nii'i'a, &lt;&lt;Dodoau ho ania guru yomahidoomo de o balahiteenge yogagaaho'o de o nyawa yoba-baradoha?&gt;&gt;<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />O Yesus woihene yotemo 'ogeena ho wotemo, &lt;&lt;O nyawa 'ayopa-panya'ewa 'ayoparaluuwa o dotere, duga 'ao nyawa yopa-panya'e. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Ho niotagi nimadoto'o o Bo'u 'Ibe-berehi ma doda itemo: &lt;'Ai mau geenala nia dora, de 'ania hada'awa,&gt; Hababu Ngoi toboa 'ato'iaho'ua o nyawa yotitiai, duga 'ao nyawa yoba-baradoha.&gt;&gt;<verse eid="MAT 9:13" /></para>
  <para style="s">Mangale o puaha</para>
  <para style="r">(Mrk. 2:18-22; Luk. 5:33-39)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Ge'ena'a de o Yohanes woohi-ohi'i awi ni-nii'i ya'aino o Yesusino de yohano, &lt;&lt;Dodoau ho ngomi o Fariso'a mio puaha, ma Ani ni-nii'i 'ayopuahawa?&gt;&gt; <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />O Yesus wopaluhu, &lt;&lt;Bote 'ai dadi o naulu ge womo-modo'a ge awi ma-manai de de unaahi de manga hininga ihuha? Maraio'au o uwa! Ma duga aha yaadono ma wa'utu, nage ma naulu womo-modo'a aha wiehe onano. Geena aha de ona yopuaha.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />Amoiwa o nyawa manga baju 'itiimuno'au de yohitapa'a de o moha ma dobi'i ma hungi. Hababu na'o ma pa'eanga geena iwo'a, ma moha ma hungi geena ya'ooromou ho ma baju 'itiimuno'au ge 'iracanga 'iholoi 'iamo'o. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />'Ogeenali ma, 'amoiwa o nyawa yodalihi o angguru ma hungi o dingi ma hila'u ge o 'aewani ma 'aino. Hababu done ma angguru ma dingii ge o 'aewani ma 'aino ipela'a de ma angguru ma ipoa. Mangale geena, o angguru ma hungi 'iani podalihi ma ngii ma hungi'u, la ma angguru de ma ngii geena uwa itiiha.&gt;&gt;<verse eid="MAT 9:17" /></para>
  <para style="s">O Yesus mihiai'i o ngewe'a momatengo de momatengo mihiwangoli</para>
  <para style="r">(Mrk. 5:21-43; Luk. 8:40-56)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Wa'utu o Yesus ma gigiria'a yoma'ade-ade de o Yohanes woohi-ohi'i awi ni-nii'i, geena'a de o Yahudio'a ma agama'a ma baluhu woboa. Una watilabu'u'u o Yesus awi biono'a de wotemo, &lt;&lt;Aba Guru, 'ai ngoa'a o ngewe'a aha ami ngomaha 'itoa'u'u, duga tanu noiduhunu hio'o tanu na'ai'ahi, de nodonoa Ani giama la momomi'oli.&gt;&gt;<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Geena'a de o Yesus de awi ni-nii'i yotagi yoma'anii'i de ma nyawa guuna.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20-21" style="v" sid="MAT 9:20-21" />Manga do-dagi ma hidogorona'a de momatengo ami aunu 'ipoa-poa ma daao o taunu mogioo'o de modidinou, momahidutu'u o Yesus awi dudunino. Muna matibanga, &lt;&lt;Ngaro 'a tatigi awi baju i'a-'a'ulu'u geena toai'i.&gt;&gt; Geena'a de matigi Awi baju i'a-'a'ulu'u ma balene.<verse eid="MAT 9:20-21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />De ma oraha geena o Yesus womalelo'o de mima'e o ngewe'a gumuna de wotemo muna'a, &lt;&lt;'ai ngowa'a! Uwa ani hingina 'ihuha, hababu noinga'u Ngoino ho, ani panya'e 'iai'i!&gt;&gt; De 'ageena'a ena, de ami panya'e geena 'iai'o'au.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />O Yesus woboa o dodoomu ma woa ma baluhu awi woa'a, Geena'a o nyawa yosulingi de yogalibetongo ma gigiria'a. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />De o Yesus wotemo ona'a, &lt;&lt;Niohupu'a ngini moi-moi, hababu o ngowa'a numuna 'amohongenua 'amomaiduo'a.&gt;&gt;</para>
  <para style="p" vid="MAT 9:24">Ma ona 'awihiiete Una'a. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />O nyawa yolepe-lepe goona yo'iginii'i, de o Yesus woohama ho wagagao ma ngowa'a gumuna ami giami'a de momomi'i. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Ho ma habari geena itagi ma daera'a geena yaedono'ou.<verse eid="MAT 9:26" /></para>
  <para style="s">O Yesus wo'ihiai'a yamididi yopilo-pilo'o</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />O Yesus womagoa'a geena'a, de o nge'omo ma gorona'a de yopilo-pilo'o yamididi winii'i. Ona yomahigaho-gaho'o, &lt;&lt;Ee Dautu awi guti'u! Nimidoranohi!&gt;&gt;<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Ma oraha o Yesus woohami'a o woa moio'a, de yopilo-pilo'o yo'aino o Yesusino de wotemo ona'a, &lt;&lt;Nionga'u? Na'o ngoi idadi tinihiai'i?&gt;&gt;</para>
  <para style="p" vid="MAT 9:28">De ona yopaluhu, &lt;&lt;Mionga'u, Aba!&gt;&gt;<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Geena'a de o Yesus wagagao manga la'o'a de wotemo, &lt;&lt;Hababu nionga'u, idadi 'imote'e ti ngini nia mau.&gt;&gt; <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Geena'a de yomahima'e'au. O Yesus wo'ihitiari, &lt;&lt;Uwa niohingahu ma haala geena 'a moi'a ma.&gt;&gt;<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />Ma wa'utu yotagi de 'ayogila yohi'awaha ma daera'a geena.<verse eid="MAT 9:31" /></para>
  <para style="s">Womou-mou idadi womaade-ade</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Wa'tu yopilo-pilo'o yopaha'a, de womatengo womou-mou o to'ata widongohamu'u wi'aha o Yesusino. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />O Yesus waginii'i ma to'ata geena, de idadio'au womaade-ade. Ho o nyawa yolepe-lepe geena'a yoheranga de yotemo, &lt;&lt;'Omaiwahi miama'e 'oneena idadi o Israelo'a.&gt;&gt;<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Ma o Farisio'a yotemo, &lt;&lt;O to'ata ma 'oana wi'ula'a o guata ma ngale waginii'i o to'ata geena.&gt;&gt;<verse eid="MAT 9:34" /></para>
  <para style="s">O Yesus wo'idora wo'ima'e o nyawa manga lepe</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />O yesus waloliti o bendara de o hoana moi-moi, de Wodoto'o o Yahudio'a manga dodoomu ma woa-woa'a. Una wohingahu o Habari ma Owa mangale ma Jou ma Dutu awi pareta o nyawa-nyawa'a nage yonga'u-nga'u. Una ma wo'ihiai moi-moi o nyawa manga panya'e de wo'ihiai'i o nyawa nage itiaiwa. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Wa'utu, o Yesus wo'ima'e'a o nyawa yolepe-lepe goona de wo'ihininga hababu ona manga huha ilepe harage de o duba ma gogoana 'aoiwau mangale yo'igoana <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Geena'a de o Yesus wotemo awi ni-nii'i'a, &lt;&lt;'Iumu'u'ou ma amo'o'a ma youtu-utu'u 'a yolepewa. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Hababu geena niogaaho'o ma Baili ma Dutu'a la wo'ihidingoto youtu-utu'u mangale youtu'u.&gt;&gt; <note caller="+" style="f">C<char style="fr" closed="false">9:38: </char><char style="ft" closed="false">Bolo: &lt;&lt;O nyawa neena naga manga lepe yomau yohigihene o Habari ma Owa 'imatero 'a o bira 'iumu'u ma amo'o'a, ma youtu-utu'u 'a yolepewa. Hababu geena, niogaaho'o ma baili ma dutu'a geena la ma Jou ma Dutu, la wo'ihidingoto yo'a-'arajaanga mangale yautu'u.&gt;&gt;</char></note><verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">O hu-hulo'o yamogio'o de yamididi</para>
  <para style="r">(Mrk. 3:13-19; Luk. 6:12-16)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Ma moi geena o Yesus wo'iaho'o o hu-hulo'o yamogioo'o de yamididi. Geena'a de wo'i'ula o 'uaha mangale yaginii'i o omaha ma diiha de yohiai'i o panya'e 'iini-ini'o'a de o nyawa nage manga roehe 'aitiaiwa. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />O hu-hulo'o yamogioo'o de yamididi goona manga ronga-ronga onane: Ma di-dihila'a, o Simon nage wihironga o Petrus, de ma dodoto o Andreas, geena'a de o Yakobus de ma dodoto o Yohanes, geena la o Zebedeus awi ngoa-ngoa'a. <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Geena'a de o Filipus de o Bartolomeus, o Tomas, de o Matius o balahiteenge woga-gaaho'o, de o Yakobus o Alfeus awi ngoa'a, o Tadeus, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />de o Simon o Zelot ma nyawa<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="fq" closed="false">Simon o Zelot ma nyawa </char><char style="ft" closed="false">O Zelot ma nyawa geena o bolu-bolu moi o Yahudino nage yo'ilawa-lawana o Roma'a ma pareta,</char></note>, de o Yudas Iskariot nage o wihigiama ma hoata o Yesus.<verse eid="MAT 10:4" /></para>
  <para style="s">O hu-hulo'o manga 'arajaanga</para>
  <para style="r">(Mrk. 6:7-13; Luk. 9:1-6)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Geena'a de o hu-hulo'o yamogioo'o de yamididi goona o Yesus wo'ihulo'o de wo'ihibehehongo onane: &lt;&lt;Uwa niotagi ge 'ao Yahudio'awa manga daera'a e'ola o Samaria manga benda-bendari'a ma. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ma niotagi o Israeli'a nage 'ayonii'uau ma Jou ma Dutu'a, harage de o duba 'a'oiwa ma dutu. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Ho niotagi niohingahu ona'a onane, 'Aitaowau de ma Jou ma Dutu woparetau. <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Nio'ihiai'i o nyawa ge yopa-panya'e; nio'ihiwango o nyawa ge yohone-honengo'au; niohiai'i o nyawa ge yopado-pado de nioginii'i o omaha ma diiha. Ngini niadawongo'au geena moi-moi 'aniohanguwa. Ho, nio'ula ma ma bo-bangu 'oiwa. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Uwa nioaha o pipi o gurahi, o pipi o hala'a, bolo o pipi o tambaga. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Ma uwa nioaha nia beta-beta, e'ola nia ga-gali o dobi'i modidi nia do-dagio'a, e'ola nia tarupa e'ola nia papadi. Hababu o nyawa yo'arajaanga geena maraio'au yo'i'ula o'iau naga yoparaluu.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Na'o ngini nimahiadono'au o bendaro'a bolo o hoano'a, niohali'i o nyawa moi nage yomode'e nimahido-dogumu. Niomanoa de de ona hiadono niotagioli. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Gee nioohama manga woa'a, de nio'itabea. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Na'o o woa ma dutu goona nidawongo, mada'a la nia tabea geena naga ona'a. Ma na'o ona 'anihigumadawa, niohigilioli nia tabea geena.<note caller="+" style="f">E <char style="fr" closed="false">10:13: </char><char style="ft" closed="false">O Yahudio'a ma nyawa yotemo bali na'o yohigilio manga tabea done aha o nyawa o barakati 'ayama'ewa.</char></note> <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Na'o naga o woa'a bolo o bendaro'a 'anihigumadawa bolo 'anihigumadawa, niamada'a ma ngii geena de nia dou ma hoata ma 'a'awo niodabarihu'u geena ma ngale ngini nihinganono ona yohala'au ma Jou ma Dutu'a <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Niohi-hininga! O dunia ma do-dogumoka, o Sodom de o Gomora ma nyawa dua manga hu'umu 'iholoi i'ualenge de gee o Sodom de o Gomora ma bendara geena!&gt;&gt;<verse eid="MAT 10:15" /></para>
  <para style="s">O hangihara aha 'iboa</para>
  <para style="r">(Mrk. 13:9-13; Luk. 21:12-17)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />O Yesus wotemoli awi ni-nii'i'a, &lt;&lt;Niohi-hininga neena: Ngoi tinihulo'o harage, o duba o haewani 'iti-tingi'ai ma hido-dogorana'a. Ngini halingou niopade harage de 'ao ngia de nia hingina 'irahai harege de o namo dara. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Nimagoa-goana hababu ngini aha nitago'o de niaha o agama ma balu-baluhu. Ngini aha nipoha o dodoomu ma woa-woa'a. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Ngini dua niaha yopa-pareta'a de o 'oa-'oana hababu ngini to ngoi 'ai ni-nii'i. De geenau ma oraha ngini nio'ula o ha'ihi ona'a mangale Ngoi de o nyawa-nyawa'a ma nage ma Jou ma Dutu 'awina-o-na'owa. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Ma na'o niaha o ha'imi'a mangale niadili, 'uwa niohawana ma ngale o'iau aha halingou niotemo e'ola cara'iau halingou nimaade-ade, hababu geenau ma oraha, ma Jou ma Dutu aha wo'ula ngini'a o 'iau halingou nimaade-ade ona'a. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Hababu nimaade-ade o oraha geena, geena nginiwa ma hirete nia demo-deno ma ena nia Dea o horoga'a awi Omaha.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />'Ahao de ma wa'utuo'a, o nyawa aha yohigiama ma hoata 'ai riadodoto 'a la yo'itooma. De done aha 'ogeenali idadi naga o dea de o ngoa'a. O ngoa-ngoa'a aha yolawana manga eha de manga dea'a, de yo'ihigiama ma hoata o nyawa'a la yo'itooma. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Ngini aha o nyawa moi-moi nibuhulu hababu ngini to ngoi 'ai ni-nii'i. Ma nagoonau yotongohono hiadono ma baha'a, ona aha yohalamata. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Na'o ngini nihangihara naga o bendara moi'a, geena nioloa o bendara ma homoa'ali. De ngoi tinitemo e, 'aniabootuahi niodongohama o Israelo'a ma benda-bendara, ena o Nyawa ma Ngowa'a woboa'au.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />O ni-nii'i 'ayoholoidewa de o guru, de o nyawa yo'a-'arajaanga 'ayodaduiewa de manga baluhu. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Yaowa'au na'o o ni-nii'i moi yodadio'au harage de o guru, de o nyawa moi yo'a-'arajaanga harage de manga baluhu. Na'o o woa moi ma baluhu wihironga'au o Beelzebul,<note caller="+" style="f">F<char style="fr" closed="false">10:25: </char><char style="ft" closed="false">Geena o To'ata ma 'Oana ma ronga moioli.</char></note> de hongoli o woa ma doda'ali? Ona aha yo'ihironga iholoi itiiha!&gt;&gt;<verse eid="MAT 10:25" /></para>
  <para style="s">Powidomodongo ma Jou ma Dutu'a</para>
  <para style="r">(Luk. 12:2-7)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />O Yesus wotemoli &lt;&lt;Uwa nio'idomodongo o nyawa'a. 'A'oiwa naga 'ihigiiunino nage aha 'ayama'ewa, de 'a'oiwa naga 'ihibongonino nage aha 'aihupuwa. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />O 'iau naga gee tinitemo ngini'a nage o nyawa ma regu 'ayoihenua, halingou nio'ihingahu nihito-tongooti'a o nyawa-nyawa'a. De o 'iau nage tinihihudu nia ngau'i'a, halingou nihingahu o nyawa-nyawa manga biono'a harage de nimaade-ade o woa ma de'uo'a de yau'u. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Uwa ni'idomodongo ona gee yato-tooma nia roehe, ma 'ayaa'unuwa yotooma nia nyawa. Halingou niwidomodongo ma Jou ma Dutu ge wo'uaha wabinaha nia roehe de nia jiwa ma o u'uo'a ge 'aihone-honenguau. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />O tui-tui o dutu modidi idadi pagoo'o de o pipi 'ai haliwa. Ngaro 'ogeena ma, 'a o dutu moi ma 'oiwa 'iota'a o tonau'u na'o nia Dea 'awamauwa. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />De ngini nia utu nia haeo'a ma wana'o ma lepe. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Hababu geena uwa niodomodongo! Ngini 'iholoi niobaraguna de o tui-tui neena!&gt;&gt;<verse eid="MAT 10:31" /></para>
  <para style="s">O Yesus winga'u o 'awaha'a manga biono'a</para>
  <para style="r">(Luk. 12:8-9)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />&lt;&lt;Nago'ona yomanga'u na'o ona geena to Ngoi 'ai ni-nii'i o 'awaha manga biono'a, ngoi ma aha tomanga'u ona'a 'ai Dea o horoga'a awi biono'a. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Ma nagoonau yomahipongono o 'awaha manga biono'a na'o ona 'ato ngoiwa 'ai ni-nii'i, ngoi ma aha tomahipongono ona 'ai Dea o horoga'a awi biono'a.&gt;&gt;<verse eid="MAT 10:33" /></para>
  <para style="s">'Ao damewa, ma 'ao ributu</para>
  <para style="r">(Luk. 12:51-53, 14:26-27)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />&lt;&lt;Uwa niotemo bali, Ngoi toboa o duniano neena geena la ngini nima'adame. Ma Ngoi toboa neena aha idadi nima'aributu la nima'ati-tinga'a. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ngoi toboa la aha todiai o ngoa-ngowa'a o naulu 'ayo'ihingounua manga dea'a, o ngowa'a o ngewe'a 'ayo'idomote'ua manga eha'a, de o modo'a 'ayo'ihingounua manga dunungi'a o ngewe'a. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Aha idadi o haturuu ma amo'o geena la 'ao woa ma doda'u!<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />O nyawa ge yohibohono manga eha de manga dea'a 'iholoi'a de Ngoino, ona geena oyadaenua inii'i Ngoino. 'Ogeenali ma o nyawa nage yohibohono manga ngoa'i'a o naulu de o ngewe'a'a 'aiholoi de ngoi geena oyadaenuwa idadi inii'i Ngoino. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />De o nyawa gee 'ayoolu'u yamo'u o saliipi de 'ainii'uwa, geena oyadaenuwa inii'i Ngoino. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Nagoonau gee manga wowango mangale awi roehe mahirete, geena yohonenge de yoma'ati-tinga'a de ma Jou ma Dutu 'ahiado-adoni'a.&gt;&gt;<verse eid="MAT 10:39" /></para>
  <para style="s">O wowango yaowa-owa ma hewa</para>
  <para style="r">(Mrk. 9:41)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />O Yesus wotemoli, &lt;&lt;Nagoonau nidawongo ngini, geena ma ngale 'idawongo Ngoi. De nagoonau 'idawongo Ngoino, geena ma mangariti widawongo Una nage woihulo-hulo'o. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />O nyawa nage widawongo o nabi geena ona aha ma Jou wo'ula manga hewa harage de o nabi yama'e. De nagoonau yo'idawongo o nyawa nage manga hingina 'irahai, geena ona aha ma Jou wo'i'ula manga hewa harage o nyawa manga hininga 'ira-rahai yama'e. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Nagoonau yo'ihio'ele o nyawa nage 'ao'iawa yo'idae-daene ngaro 'a o a'ele ma homoa ma hababu ona yoinii'o'au Ngoino, nioda-danganono ma raio'au ona aha yama'e ma hewa ma Jouno!&gt;&gt;<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">O Yesus wohingahu mangale o Yohanes woohi-ohi'i</para>
  <para style="r">(Luk. 7:18-35)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />O Yesus wodoto'o awi ni-nii'i'a goona iduangino, Una wamada ma dingii geena. De wotagi wodoto'o de wohingahu o Habari ma Owa mangale ma Jou ma Dutu o benda-bendaro'a o Galilea ma daera'a.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Wa'utu geena, o Yohanes o buio'a. De wa'utu o Yohanes woihene mangle moi-moi ma Yesus Kristus wodiai, una wohulo'o awi ni-nii'i'a yotagi o Yesusi'a yohano. <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />Yohano onane, &lt;&lt;Aba, Ngonau neena nage ma Jou ma Dutu wojajioau mangale woboa? E'ola halingou o nyawa ma homoahi miodamaa?&gt;&gt;<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />De o Yesus wotemo ona'a, &lt;&lt;Nima'ilio o Yohanesi'a de niohingahu una'a o 'iau nage niama'e'au de nioiheno'au: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />yopilo-pilo'o yomahima'e'au, yopa-paluga yomadagio'au yopado-pado yoai'o'au, yopongo-pongo yomahiiheno'au, yohonengu'u yomomi'oli, de yohu-huha yoiheno'u o Habari ma Owa ma Jou ma Dutuno.&gt;&gt; <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />De o Yesus wo'ihulo'oli yotemo o Yohanesi'a, &lt;&lt;O nyawa ge 'idawongo Ngoino de yonga'u ona goona duru yohanaanga.&gt;&gt;<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Wa'utu o Yohanes awi ni-nii'i yotagio'au, o Yesus womulaenge womaade-ade o nyawa-nyawa'a geena'a mangale o Yohanes. Una wotemo onane, &lt;&lt;Ma moi'u ge wa'utu o Yohanes wodoto o tona'a 'i'a-'aha'a, niotagi una'a niomau niododoau? Bote niomau niwima'e ma nyawa ge o wange neena womaade-ade ma homoa de ma dewelano womaade-ade ma homoa, harage de o ubutu ya'ai'a ya'aino hababu o dado'o yawua'a? Maraio'au 'ouwa to? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />E'ola mangale o 'iau ho niotagi do'ai'a? Bote niomau niwima'e ma nyawa nage womahinoa'u o pa'eanga 'ira-rahai? Maraio'au 'ouwa to? Hababu o nyawa ge yomahinoa'u o pa'eanga 'ira-rahai, awi ngi ma 'oana awi 'adato'a. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Ho mangale o 'iau ho niotagi do'ai'a? 'Igoungu, unahi 'ihiloi woamo'o de o nabi. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Hababu o Yohanesi'au ma dumutu o Bo'u 'ibe-berehio'a itemo,</para>
  <para style="q1" vid="MAT 11:10">&lt;Niagelelo, Ngoi tohulo'o 'ai huhulo'o wohila de de Ngona,</para>
  <para style="q2" vid="MAT 11:10">'una aha wohidiai o nge'omo mangale Ngona.&gt;<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Nioda-danganono e! O dunia'a neena 'amoiwa moi 'iholoi yoamo'o de o Yohanes Woohi-ohi'i. Ngaro 'ogeena, ma o nyawa gee 'iholoi yoete'e ma Jou ma Dutu awi awaha ma hidogorona'a, ona 'iholoi yoamo'o de o Yohanes. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />'Imulaenge o Yohanes wohihabari awi do-doto'o hiadono neena, naga o nyawa yoti-tingi'ai, yoributu nage o nyawa-nyawa ma jou ma Dutu awi 'awaha. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Hiadono o yohanes woohi-ohi'i woboa, moi-moi o Musa awi behehongo de o nabi manga do-doto'o ihila'au 'ihingahu o'iau naga gee halingou idadi. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />De na'o ngini niomau nionga'u, o Yohanes geena la o Elia, nage awi bo-boa ihingahuo'au 'ihila. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Na'o de nia ngau'o'a, nioiheni'a!<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />De o'iau halingou tohitero o nyawa ma oraha neena? Ona harage o ngoa-ngoa'a yogogelu'u o paharo'a. O bolu moi yotemo ma regu'a, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />&lt;Ngomi o bangiheli miniduwua'o'au ma ngini 'a niorogewa! Ngomi mionyanyi o hininga huha ma nyanyi ma ngini 'anioaliwa!&gt; <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />O Yohanes woboano ika de wopuaha. Una o anggur 'awao'e-o'eluwa. De o nyawa yotemo, &lt;Una o to'ata widongohamu'u.&gt; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Neena o Nyawa ma Ngoa'a woboano, una woodomo ma de woo'ele de yotemo, &lt;Niwima'e o nyawa guuna! Una wotopo'ana de witabaeto. Una o balahiteenge yoga-gaaho'o de yoba-baradoha manga manai.&gt; Ngaro 'ogeena, ma o di-dibangia 'ira-rahai ma Jou ma Dutuno, 'inyata naga o nyawa manga go'oie'a.&gt;&gt;<verse eid="MAT 11:19" /></para>
  <para style="s">O Yesus wongamo o nyawa-nyawa'a nage 'ayoolu'u yotoba</para>
  <para style="r">(Luk. 10:13-15)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Geena'a de o Yesus womulaenge wo'ihito-tobioni'a o benda-bendara nage 'ayotoba-tobawa o baradoha yodiai, ngaro geena'a 'iholoi 'ilepe o haa-haala 'ihera-heranga wodiai ma. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />&lt;&lt;Niobodito ngini o Khorazim ma nyawa de o Betsaida ma nyawa! Hababu na'o o haa-haala 'ihera-heranga harage nginio'a neena la idadio'au o Tiruso'a de o Sidono'a, maraio'au 'ona ma daaou yotoba o baradoha yodiai de yomahinoa o hininga ma huha ma pa'eanga de manga mumu'o'a o 'a'awo yodonoa'u. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Nioda-danganono! O dunia ma baha'a aha, o Tirus de o Sidon 'iholoi i'ualenge manga hu'umu de to ngini neena! <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />De ngini o Kapernaumo'a! Bote niote ngini ma Jou ma Dutu niwigoa'a o horogade? Maraio'au 'ouwa! Ho ena aha o naraka'a niumo. Hababu na'o o Sodomo'a la idadio'au o haala 'ihera-heranga nage harage nginio'a, maraio'au ma Bendara geena hiadono neena 'a demaenahi! <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Nioda-danganono! O dunia ma baha'a done aha o Sodom ma nyawa 'iholoi i'ualenge manga hu'umana de ti ngini neena!&gt;&gt;<verse eid="MAT 11:24" /></para>
  <para style="s">Nia'aino Ngoino</para>
  <para style="r">(Luk. 10:21-22)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Ma oraha geena o Yesus wohaubayanga, &lt;&lt;Aba, Jou ge o diwanga de o tona'a naparetano! Amaowa'a, hababu moi-moi neena Ngona 'anohimaitua o nyawa'a ge yopade-pade de yomahina'o-na'o'a o hagala moi-moi, ma Ngona nohimaiti o nyawa biaha'a, nodiai hiadono yomangariti. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Geenau ani hingina yadaene Aba.&gt;&gt;<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />Geena'a de o Yesus wotemo, &lt;&lt;O hagala moi-moi 'ai Dea Woihidu'ula'au. De 'amoiwa moi ngoi ina'o, duga 'a 'Ai Dea. De 'amoiwa moi 'ai Dea wina'o duga 'a awi Ngowa'a, de o nyawa-nyawa nage o Nyawa ma Ngoa'a wo'iili-ili'i mangale wina'o ma Aba.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />Niainou ngoino moi-moi ge nio'a-'angela de niamao nia gina 'itu-tubuho. Ngoi aha tinihihanaanga. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Niodomote'e 'ai pareta de nimadoto'o ngoino. Hababu ngoi 'ai hingina 'itipo'o'u, ho ngini aha niamao niohanaanga. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Hababu 'ai pareta geena nihihananga de nia gina tini'ula ma i'ualenge.&gt;&gt;<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">O Yesus awi 'uaha demaena mangale waaturu o 'iau halingou o nyawa yodiai o Sabat ma wange'u</para>
  <para style="r">(Mrk. 2:23-28; Luk. 6:1-5)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ma moi geena, o Yahudio'a manga hiaini ma wange'u nage ihironga o Sabat, de o Yesus de awi ni-nii'i yotagi yaboa o gandum ma bailino, de yautu'u ho yaodomo. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />O Farisio'a yo'ima'e de yotemo o Yesusi'a, &lt;&lt;No'itaila'ohi! Ani ni-nii'i yapalene to ngone nanga agama ma 'autoranga, mangale yadiai nage 'aidadiwa padiai o hiaini ma wange'u ge ihironga o Sabat.&gt;&gt;<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />O Yesus wopaluhu ona'a, &lt;&lt;'Aee 'aniabacawahi? Gedage o 'iau o daut wodiai, wa'utu una de awi nyawa-nyawa nage wini-nii'i yo'ihawini? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Ma 'oana o Daut woohama ma Jou ma Dutu awi Woa'a, de waodomo o roti nage idadio'au o huhuba ma Jou ma Dutu'a. De aha una ma o roti geena wo'i'ula o nyawa'a nage winii-nii'i. Ena momongo 'imote'e nanga 'autoranga, ma roti geena 'aidadiwa yaodomo halingou duga 'ao imam-imam 'iadadi yaodomo <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />E'ola o Musa awi bo'u 'aniabacawasi? Geena la o Sabat 'ihinoi-noimi o imam-imam ge yoleleani ma Jou ma Dutu awi Woa'a, ngaro yapalene o hiaini ma Wange ma behehongo, ma 'ayo'ihihalawa. <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Nioihene nihidi-diai e, neena naga womatengo iholoi wobaraguna de ma Jou ma Dutu awi Woa. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />O Bo'u 'Iofi-ofi'u 'itulihu'u onane: &lt;Ngoi 'ataigowa o hu-huba o 'aewani, ma 'a o dora.&gt; Na'o la ngini nimahina'o 'Ai demo geena, marai aha 'ani'ihihalawa o nyawa ge manga hala 'a'oiwa. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Hababu o Nyawa ma Ngoa'a Una wapareta o hiani ma wange nage 'ihironga Sabat.&gt;&gt;<verse eid="MAT 12:8" /></para>
  <para style="s">O nyawa womatengo awi giama ma hononga 'ihone-honenge</para>
  <para style="r">(Mrk. 3:1-6; Luk. 6:6-11)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />O Yesus wamada ma dingii geena de wotagi o do-doomu ma woa'a. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Geena'a womatengo awi giama ma hononga 'ihone-honengo'au. Yamuluo naga geena'a yahali-hali'i o Yesus awi hala, yohano o Yesusi'a, &lt;&lt;'Aidadi bolo 'ouwa, o hiaini ma wange'u ge ihironga o Sabat de o nyawa manga panya'e pohiai'i?&gt;&gt;<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />O Yesus wopaluhu, &lt;&lt;Na'o la o hiani ma wange'u ge ihironga o Sabat, de o duba o dutu moi iota'a o guhu'u de bote ma duba ma dutu awa gooa'ua ma duba geena o guhude? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Hongoli ngini o nyawa 'iholoi niobaraguna de o duba geena, ho mangale geena ngone 'aidadi podiai o haala ma owa o hiani ma wange'u ge ihironga o Sabat.&gt;&gt; <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Geena'a de o Yesus wotemo o nyawa awi giama ma hononga 'ihone-honengi'a, &lt;&lt;Ani giama nari'otino.&gt;&gt;</para>
  <para style="p" vid="MAT 12:13">Ma nyawa guuna awi giama wari'oto, de ma wigiama ma hononga ma panya'e ia'i harage ama honongali. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Geena'a de o Farisio'a ma nyawa yohupu o do-doomu ma woa'a geena de yomahi'aduga witooma o Yesusi'a.<verse eid="MAT 12:14" /></para>
  <para style="s">O huhulo'o nage ma Jou ma Dutu wiili-ilii'i</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />O Yesus wana'o o Farisio'a manga hininga itiiha Una'a, ho wamada ma dingii geena. Wa'utu o Yesus wotagi, o nyawa manga lepe winii'i, de wo'ihiai'i moi-moi manga panya'e. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Ma Una 'awo'ihigumadawa ona'a, la uwa yohingahu, Una geena naguunau. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />La ihitotomo o 'iau nage o nabi Yesaya wohingahuo'au:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />&lt;&lt;Niwi ma'e 'ai Gilaongo nage towiili-ili'i.</para>
  <para style="q2" vid="MAT 12:18">Una towihiboho-bohono de 'ai hininga wahanaanga Ngoi aha towi'ula 'ai Omaha.</para>
  <para style="q2" vid="MAT 12:18">Una aha wohingahu o ba-bangihaa'a<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Una aha 'awori-ributuwa de 'awomaore-orehua,</para>
  <para style="q2" vid="MAT 12:19">de 'awomaade-adewa yomaore-orehe naga o tapa'o'a.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Una awi hininga 'irahai o nyawa'a ge yola-lamaana,</para>
  <para style="q2" vid="MAT 12:20">geena harage de Una 'awatoa'ua o tiba nage 'itu'o'au,</para>
  <para style="q2" vid="MAT 12:20">harageli de Una 'awahonengua o poci gee 'icememero'au ma do'ara.</para>
  <para style="q1" vid="MAT 12:20">Una wo'itudau o nyawa hiadono yoadili youtumu de o yoadilua ge.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />De o ba-bangiha moi-moi aha yomahinganono Una'a.&gt;&gt;<verse eid="MAT 12:21" /></para>
  <para style="s">O Yesus de o Beelzebul</para>
  <para style="r">(Mrk. 3:20-30; Luk. 11:14-23)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Geena'a de o Yesusi'a wiaha o nyawa womatengo wopilo'o de womou hababu o to'ata widongohamu'u. O Yesus wihiai'i ho idadi womahima'e de womaade-ade. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />O nyawa moi-moi yoheranga ho yotemo, &lt;&lt;Poelua nuunau o Daut awi Ngoa'a ge inahijajio'au?&gt;&gt;<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />O Farisio'a yoiheno'au geena de yotemo, &lt;&lt;Una idadi waginii'i o to'ata, hababu o To'ata ma 'oana ge ma ronga Beelzebul ma guata wi'ula'a.&gt;&gt;<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />O Yesus wana'o o Farisio'a manga di-dibanga ho wotemo, &lt;&lt;Na'o o pareta'u moi la yoma'aributu maraio'au ma pareta'u geena aha ihoroma. De na'o o woa'u moi yoma'aributu de yoma'a'ati-tinga'a, maraio'au aha 'ihoroma. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />'Ogeenali de o To'a-to'ata ma 'oana. Na'o ima'agiinii'i imahi to'a- to'ata, maraio'au 'ima'ati-tinga'a de 'ima'abuhulu. De o to'ata ma 'oana ma pareta 'aitongohonua to?. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Ngini niotemo na'o ngoi o to'ata toginii'i 'a de o Beelzebul ma guata. Na'o 'ogeena de tingini nia nyawa ona 'ianou yo'i'ula o guata o to'ata yoginii'i? Tinginiou nia nyawa ma hirete yohimaiti na'o nia di-dibanga geena 'oyadaenuwa. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Ma ngoi toginii'i o to'ata geena de ma Jou ma Dutu awi Omaha ma guata, geena ma mangariti ma Jou ma Dutu womulaenge wopareta nginio'a.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />Cara'iau o nyawa idadi yoohama wimoi wo'ua-'uata awi woa'a la awi 'iau hona yaora, na'o una 'awipuhu'uwa 'ihila? Halingou wihu'o'ahi aha de awi harataa yaora.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />Nagoonau 'a de de ngoiwa, ona geena 'Ai haturuu, nagoona 'Aiduhunua, ona geena yodiai o nyawa-nyawa yoma'a'ulu de de Ngoi! <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Hababu geena tinihidemo, na'o o nyawa o baradoha yodiai, geena 'ayama'e'ahi o apongo, 'ogeenali yo'ihohedu o nyawa'a, geena 'ayama'e'ahi o apongo. Ma na'o o nyawa yahohedu o Omaha 'iofi-ofi'a, ona geena 'ayama'ewa o apongo. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Na'o moi'ani o 'iani yotemo ma ngale wiributu o Nyawa ma Ngoa'a, geena 'ayo'iapongo'ahi manga baradoha'a. Ma na'o yahohedu o Omaha 'Iofi-ofi, geena 'ayo'iaponguau ma orahi neena de 'ahiado-adoni'a.&gt;&gt;<verse eid="MAT 12:32" /></para>
  <para style="s">Ma roehe de howo'o</para>
  <para style="r">(Luk. 6:43-45)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />O Yesus wotemo, &lt;&lt;Na'o o gota ma owa geena ma howo'o ma irahai. Na'o o gota ma diiha, geena maraio'au ma howo'o ma itiiha. Ngone idadi pana'o na'o o gota ma owa bolo itiiha, pataila'o 'amahowo'o'a. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Ngini o nyawa nioti-tingi'ai, icara'iau ngini 'aidadi nimaade-ade o haa-haala ma owa, na'o ngini niotingi'ai? Hababu o 'iau nia hininga'a, geena aha 'ihupuou nia uluha. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />O nyawa ma owa, yohihupu o 'iau hona yaowa-owa hababu manga hininga ma doda'a do'a yaowa-owa. 'Ogeenali ma, o nyawa ma diiha yohihupu o 'iau hona iti-tiiha hababu manga hininga ma doda'a do'a 'ao tingi'ai.<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />Ho nioda-danganono! O dunia ma baha'a, o nyawa moi-moi aha yomadomo'u manga demo ge ma faeda 'oiwa. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Hababu nia demo-demo ma hirete aha ihibutuhu niohala bolo 'ouwa.&gt;&gt;<verse eid="MAT 12:37" /></para>
  <para style="s">O Farisio'a yogaaho'o o Yesus wodia o haala 'ihera-heranga</para>
  <para style="r">(Mrk. 8:11-12; Luk. 11:29-32)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Geena'a de o agama'a yodoto-doto'o yamuluo naga de o Farisio'a yotemo, &lt;&lt;Aba Guru, ngomi miomau miama'e nodiai o haala 'ihera-heranga.&gt;&gt;<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />O Yesus wopaluhu, &lt;&lt;Ngini o nyawa-nyawa ge niowango neena'a naga, niotingi'ai de niotongohonua ma Jou'a, ho niogaaho'o tinihimaiti o haala 'ihera-heranga moi. Ma Ngoi 'atinihimaitua o haala 'ihera-heranga ngaro 'amoi ma, duga 'atinihidanganono ngini'a o haala 'ihera-heranga 'ida-dadio'au ma hila o nabi Yunus ge. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Hababu, harage de o nabi o Yunus o nao'o ma po'o ma doda'a awi wange haange de o wutu haange, 'ogeenali de o Nyawa ma Ngoa'a o horoga'a, aha o boohu'u ma doda'a ma daao o wange haange de o wutu haange. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />O dunia ma baha'a, o Niniwe ma nyawa aha yomagoa'a yomaade-ade mangale yo'ihihala o nyawa-nyawa'a ge yowango ma oraha neena naga. Hababu o Niniwe ma nyawa ona yotoba'au o baradoha yodiai ma oraha o Yunus wo'idoto'o. Ma neena'a naga womatengo iholoi woamo'o de o Yunus. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Wa'utu o dunia ma baha'a, ma 'oana o ngewe'a ge momanoa-noa o 'oremie'a motagi de o nyawa-nyawa ma oraha neena, yo'itae ona'a. Hababu ma 'oana o ngewe'a gumuna moboa o tona'a ma baha'a de maino momau moihene o Salomo awi 'umati, de igou-goungu neena'a naga de ma ena o nyawa moi iholoi de o Salomo, ma una wihigihenua.&gt;&gt;<verse eid="MAT 12:42" /></para>
  <para style="s">O omaha ma diiha imailio</para>
  <para style="r">(Luk. 11:24-26)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />O Yesus wotemoli, &lt;&lt;Na'o la o omaha ma diiha wimada ma nyawa guuna, ma omaha ma diiha geena itagi iloliti imadahali'i o dingii idudu-dungu la imahiani, ma ena aimadama'ewa. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Mangale geena ena itemo, &lt;Ngoi toma'iliou 'ai woa tamada-mada'au.&gt; Wa'utu ena imahiadonia'a do'a, ma woa geena 'amoi-moiwa, iberehi de ihididiai'au. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Geena'a de ena itagi yaaha o omaha ma diiha tumudingoli, ge iholoi itiiha de de ena. Geena'a de ona yoomahama ma nyawa'a guuna, de yomanoa geena'a. Ma baha'u ma nyawa guuna iholoi itiiha de ma hila. O geenali aha idadi de o nyawa-nyawa yoti-tingiai o oraha neena.&gt;&gt;<verse eid="MAT 12:45" /></para>
  <para style="s">O Yesus awi eha de awi riadodoto ma dutu</para>
  <para style="r">(Mrk. 3:31-35; Luk. 8:19-21)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Wa'utu o Yesus 'ayoma'ade-ade de o nyawa yolepe-lepe, geena'a de o Yesus ma eha de Awi riadodoto. Ona yomahigo'ono ma duduno'a, de yomau yoma'ama'e de o Yesus. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Geena'a de womatengo o nyawa yolepe-lepeno wo'ai'a o Yesusi'a, &lt;&lt;Aba, Ani eha de ani riadodoto do'a ma duduno'a, de yomau nima'ama'e.&gt;&gt;<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />O Yesus wopaluhu, &lt;&lt;Nagumunau 'ai eha de 'ai riadodoto?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Geena'a de Una wo'itumutu Awi ni-nii'i'a de wotemo, &lt;&lt;Noona 'ai eha de 'ai riadodoto. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />O nyawa nage yadiai ma Jou ma Dutu o horoga'a Awi mau, goonala 'ai riadodoto o naulu de o ngewe'a de 'ai eha.&gt;&gt;<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">O Hi'atero mangale o gihihi wohibari-barihi</para>
  <para style="r">(Mrk. 4:1-9; Luk. 8:4-8)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />'Ageena ma wange ena o Yesus wamada'au ma woa geena, de wotagi o talaga ma date'i'a de wogogelu'u geena'a. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />O nyawa duru manga lepe yomalomu wihigilolitino o Yesusino, geenau ho Una wo'ai'a o ngootili'a de wogogelu'u geena'a, de o nyawa yolepe-lepe yomahigo'ono o talaga ma date'o'a. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Geena'a o Yesus wo'idoto'o waini-ini'o'a de wapa'e de o hi'atero. Wotemo: &lt;&lt;Naga womatengo wotagi awi baili'a de wohibarihi awi gihihi.<verse eid="MAT 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 13:4" />Wa'utu una wohibarihi awi gihihi geena, ma regu iota'a o nge'omo ma date'u'u, geena'a de o namo o ginita'a yaino de yaodomo yaboboti'a. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Ma regu iota'a o tona'a ihe-heleo'u, nage ma tona'a ama ngina-nagina'u. Ma gihihi geena 'a ena iwango'au, hababu ma tona'a iina. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Ma wa'utu o wange yodihiwa, ma gihihi geena imoya ho itoolenge hitigi i honenge, hababu 'aimahingutuu'a. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Ma reguoli iota'a o ubutu ihihihi'a ma doda'u. Ma ubutu geena ihero de ihi'aduu'u, ho ma gihihi geena ihonenge. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Ma ma reguoli iota'a o tona'a yaowa-owa'u, ho ma gihihi geena ihero hitigi ihowo'o, de naga ma regu ilio ihidigali o ratuhu moi, ma regu moributanga, ma regu moruange.&gt;&gt;<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />Iduangino o Yesus wohiade-ade ma hi'atero geena, Una wotemo, &lt;&lt;Nagonau de manga ngau'o'a tanu yoihene.&gt;&gt;<verse eid="MAT 13:9" /></para>
  <para style="s">Idodoau ho o Yesus wapa'e de o hi'atero</para>
  <para style="r">(Mrk. 4:10-12; Luk. 8:9-10)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Geena'a de o Yesus awi ni-nii'i yo'ai'a o Yesusi'a de yohano, &lt;&lt;Aba guru, dodoau ho no'idoto'o o nyawa-nyawa'a de napa'e de o hi'atero?&gt;&gt;<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />O Yesus wopaluhu, &lt;&lt;Hababu, ngini ni'ula'au o cocatu la nia na'o icara'iau ma Jou wo'oana, ma ona'a o uwa. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Hababu to nagonau de ma ena'a, geena aha yo'i'ula 'age'au ilepe. Ma to nagonau amanga 'iawa, ngaro ama ube-ube'awa, geena ma aha yaehe. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Geenau ma hababu ho, Ngoi to'idoto'o o nyawa-nyawa'a tapa'e de o hi'atero, hababu ona yama'e, ma harage 'ayama'ewa; ona yoihene, ma harage 'ayoihenua de o yomamangaratiiwa. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />De o geena imadadi harage 'ao nabi Yesaya wohingahuo'au, Ma Jou wotemo:</para>
  <para style="q1" vid="MAT 13:14">&lt;Ona aha yoihene 'aitogu-togumua</para>
  <para style="q1" vid="MAT 13:14">ma ona o yoma mangaritiiwa;</para>
  <para style="q2" vid="MAT 13:14">Ona aha yodadananoho 'ai togu-togumua</para>
  <para style="q2" vid="MAT 13:14">ma ona aya na'owa o iau idadi.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Hababu o nyawa-nyawa noona manga hininga iopino'au.</para>
  <para style="q2" vid="MAT 13:15">Manga ngau'u 'ayoolu'ou yoihene.</para>
  <para style="q1" vid="MAT 13:15">De manga la'o yaruwutu yapau-pau'u.</para>
  <para style="q2" vid="MAT 13:15">La ona uwa yama'e de manga la'o.</para>
  <para style="q2" vid="MAT 13:15">La ona uwa yoihene de manga ngau'u.</para>
  <para style="q1" vid="MAT 13:15">De ona uwa yoma mangariti de manga hininga.</para>
  <para style="q2" vid="MAT 13:15">La ona uwa yoma'ilio Ngoino la To 'ihihalamata.&gt; &gt;&gt;<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />O Yesus wotemo awi ni-nii'i'a, &lt;&lt;Duga ngini duru nio utumu, hababu ngini igou-goungu nia ma'e de nio ihene. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Nia hi-hiningae, o nabi-nabi de o nyawa yotitiai ma Jou'a, manga lepe, yomau yama'e o iau nage nia ma'e o oraha neena, duga ona 'ayama'ewa. Ona yomau yoihene nage o oraha neena nioihe-ihene, duga 'ayoihenua.&gt;&gt;<verse eid="MAT 13:17" /></para>
  <para style="s">O Yesus wohi ma mangariti mangale o gigihihi wohibari-barihi</para>
  <para style="r">(Mrk. 4:13-20; Luk. 8:11-15)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />&lt;&lt;Nio ihene, ma mangariti mangale o gihihi wohibari-barihi 'aano ge. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />O gihihi ge iota'a o nge'omo ma date'u'u, geena harage 'ao nyawa-nyawa yoihene o habari mangale icara'iau ma Jou wo'oana, ma oyoma mangaritiiwa. Ho o to'ata iboa de yaehe ma habari geena manga hininga'a. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />O gihihi iota'a ge o tona'a ihe-heleo'u, geena harage 'ao nyawa-nyawa yoihene o habari geena, de yadawongo de manga hininga ma garago. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Ma habari geena 'aimahingutu'ua to ona manga hininga'a, ho wa'utu ona yaohana o huha bolo o aniaya mangale ma habari geena, 'ageena ena yamada'au ma habari geena. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Nage iota'a o ubutu ihihi'a'u, geena harage 'ao nyawa nyawa-nyawa yoihene o habari geena, ma yododato de manga wowango, yodabali o dunia ma arata. Ho ma habari ihi'aduu'u manga hininga ma doda'a, hitigi 'aihowo'ua. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />De o gihihi ge iota'a o tona'a yaowa-owa'u, geena harage o nyawa-nyawa yoihene ma habari geena, de yoma mangariti. Ho hiadono ihowo'o, ho muna'a ma giliono o ratuhu moi, muna'a moributanga, muna'a moruange.&gt;&gt;<verse eid="MAT 13:23" /></para>
  <para style="s">O hi'atero mangale o nguuhumu iwango o gandumu ma go-gorona'a</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />O Yesus wohijaritali o nyawa-nyawa'a, o hi'atero moioli, Wotemo, &lt;&lt;Na'o ma Jou wo'oana, geena harage onane; Womatengo o baili ma dutu, una wohibarihi o gihihi yaowa-owa awi bailo'a. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />O wutu moi'u, wa'utu o nyawa-nyawa yo'o'inihu'o'au, geena'a ma baili ma dutu guuna awi haturuu yoboa, yodutudu'u o nguuhumu awi gandumu ma bailo'a, de yotagi. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Wa'utu ma gandumu geena iwango, de ma howo'o ma ihupu, ma nguuhumu ma iwango harage ama gandumoli. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Wa'utu awi nyawa yo'a'arajaanga yama'e ma nguuhumu geena, de yotemo una'a, &lt;Tuanga aewolo, ma moi'u notudu'u 'ai bailo'a o gihihi yaowa-owa? Ho 'ia'a de yaino ma nguuhumu?&gt; <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Ma baili ma dutu guuna wopaluhu, &lt;Geena marai 'ai ha-haturuu yodiai.&gt; Geena'a de yo'a'arajaanga yohanoli, &lt;Ho 'anomode'e ma ngu-nguuhumu geena miaapu'u?&gt; <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Una wopaluhu, &lt;Uwa, hababu na'o niaapu'u, done ma gandumu imahinii'i iapu'u. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Niamada'a ma ngu-nguuhumu geena iwango ima 'anii'i hitigi ma oraha yaadono pautu'u. Ngoi aha totemo youtu-utu'i'a: O nguuhumu ihila nia utu'u, la nia li'o de nia tuu'u. Geena'a de aha nia utu'u ma gandumu de nialomu 'ai tila-tila'a.&gt; &gt;&gt;<verse eid="MAT 13:30" /></para>
  <para style="s">O hi'atero mangale o sawi ma mui</para>
  <para style="r">(Mrk. 4:30-32; Luk. 13:18-19)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />O Yesus wohijaritali o nyawa-nyawa'a o hi'atero moi, Wotemo, &lt;&lt;Na'o ma Jou wo'oana, geena ma jarita harage 'ao hi'atero neena; Woma tengo waehe o sawi ma mui de watudu'u awi bailo'a. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />O sawi ma mui geena duru 'ao ete'e. Ma na'o iwango'au, moi-moi o joro 'aenahi iamo'o. Ena ima dadi o gota ma amo'o, ho o namo o ginita'a ma ya'aino ima diigutu ma jaga-jaga'a.&gt;&gt;<figure style="fig" alt="Pohon sawi" file="gt00048.jpg" size="span" copy="Gordon's Graphics gt00048" ref="13.32">O sawi ma utu</figure><verse eid="MAT 13:32" /></para>
  <para style="s">O hi'atero mangale o ragi</para>
  <para style="r">(Luk. 13:20-21)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />O Yesus wohijaritali o nyawa-nyawa'a o hi'atero ma reguoli. &lt;&lt;Na'o ma Jou wo'oana, geena ma jarita harage 'ao ngewe'a momatengo ma ehe o ragi de mohi'aruae de o terigu o kilo moruange, hiadono ihero moi-moi.&gt;&gt;<verse eid="MAT 13:33" /></para>
  <para style="s">Idodoau ho o Yesus wapa'e o hi'atero</para>
  <para style="r">(Mrk. 4:33-34)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />O Yesus wo'idoto'o o nyawa-nyawa'a moi-moi wapa'e de o hi'atero. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />De o geena la idadi harage 'ao nabi watehongo'au,</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;Ngoi tapa'e de o hi'atero na'o mima'aade-ade de ona;</para>
  <para style="q2" vid="MAT 13:35">Ngoi tohingahu o haala ihipongo-pongoni'a wa'utu o dunia neena idadi.&gt;&gt;<verse eid="MAT 13:35" /></para>
  <para style="s">O Yesus wohi mangariti o hi'atero mangale o nguuhumu o gandumu ma hidogorona'a</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Geena'a de o Yesus wo'imada o nyawa yolepe-lepe, de woohama o woa'a. Awi ni-nii'i yo'ai'a de yotemo, &lt;&lt;Aba guru, bee'a nimihingahu ma mangariti, ma hi'atero mangale o gandumu de o nguuhumu.&gt;&gt;<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />O Yesus wopaluhu, &lt;&lt;O nyawa ge wohibari-barihi o gihihi ma owa, geenala o Nyawa ma Ngoa'a. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />O baili geena, o dunia. O gihihi yaowa-owa, geenala o nyawa-nyawa ge yodadio'au ma Jou awi umata. O ngu-nguuhumu geenala, o nyawa-nyawa ge yodadio'au hara 'ao wini-nii'i o to'ata ma 'oani'a. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />O haturuu ge yotudu-tudu'u o ngu-nguuhumu geenala, o to'ata ma oana. Ma oraha youtu'u geenala, o wange o dunia ma baha, de youtu-utu'u geenala, o ma-malai'ata. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Ho'o'ia o ngu-nguuhumu yalomu de yatuu'u o u'u'a, o geenali wa'utu o dunia ma baha. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />O Nyawa ma Ngoa'a aha wohulo'o o ma-malai'ati'a, la yo'ilomu o nyawa-nyawa ge mangale ona ho o nyawa-nyawa yobaradoha, de moi-moi ge o nyawa yodidiai o baradoha. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Ona moi-moi aha yo'iumo o berehoo'a ge ma u'u ito'a-to'ari'a; geena'a aha ona yoali de yohangihara. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Ma o nyawa ge yadi-diai ma Jou awi pareta, aha yobangoro harage 'ao wange, ma Jou ma Dutu awi pareta'a, ho nagonau de manga ngau'o'a tanu yoihene.&gt;&gt;<verse eid="MAT 13:43" /></para>
  <para style="s">O hi'atero mangale o arata o tona'o'a ihibaitu'u</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />&lt;&lt;Na'o ma Jou ma wo'oana, geena ma jarita hara 'ao hi'atero neena: O nyawa womatengo wama'e o arata o bailo'a o tona'a ma doda'a, geena'a de unama wohibaitoli o tona'u'u. Geena'a de mangale wogarago ho ma nyawa guuna wotagi wawu'unu moi-moi awi arata, geena'a de una woma'ilio de wagoo'o ma baili geena.&gt;&gt;<verse eid="MAT 13:44" /></para>
  <para style="s">O hi'atero mangale o mutiara ira-rahai</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />&lt;&lt;Na'o ma Jou wo'oana, geena ma jarita harage 'ao hi'atero neena: Womatengo womawu'u-wu'unu, wohali'i o mutiara ihali-hali. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Wa'utu una wama'e o mutiara moi duru ira-rahai, 'ageena ena wotagio'au wawu'unu moi-moi awi arata, de wagoo'o ma mutiara geena.&gt;&gt;<verse eid="MAT 13:46" /></para>
  <para style="s">O hi'atero mangale o homa</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />&lt;&lt;Nao ma Jou wo'oana geena ma jarita ihi'atero harage 'ao homa yaumo'u o talaga'a, de yadaene ma nao'o iini-ini'o'a. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Wa'utu ma homa geena yaomango'au, ma homa geena yagoa'a o du-dungiha. Geena'a de ona yatinga'a ma nao-nao'o geena: Ma nao'o yaowa-owa yaiyunu manga udi'u, de ma nao'o iti-tiiha yaumo. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />O geenali aha idadi wa'utu o dunia ma baha yaadono, wa'utu geena o ma-malai'ata aha itagi yo'ihi'atinga'a o nyawa yoba-baradoha, de o nyawa ge yadi-diai ma Jou awi pareta. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Geena'a de aha o nyawa yoba- baradoha yo'iumo o u'u 'aihone-honengua. Geena'au aha ona yoali de yohangihara.&gt;&gt;<verse eid="MAT 13:50" /></para>
  <para style="s">O 'iani ma hungi de ma hila</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />O Yesus wohano, &lt;&lt;Bote nima ma mangariti geena moi-moi?&gt;&gt;</para>
  <para style="p" vid="MAT 13:51">Ona yopaluhu, &lt;&lt;Aba guru, ngomi mimangariti!&gt;&gt;<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Geena'a de o Yesus wotemo, &lt;&lt;Geenau ma hababu, ho ma noimi o agama'a yodoto-doto'o, yodadio'au ma Jou awi awaha, geena ma jarita harage 'ao woa ma dutu wohihupu, awi arata ma hungi de ma hila ma ngi-ngiino.&gt;&gt;<verse eid="MAT 13:52" /></para>
  <para style="s">O Yesus awi olu'u o Nazareto'a</para>
  <para style="r">(Mrk. 6:1-6; Luk. 4:16-30)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Iduangino o Yesus wohijarita ma hi-hi'atero geena, Una wamada ma dingii geena, <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />de wotagi awi hoani'a. Ido'a Una wotagi o dodoomu ma woa'a de wo'idoto'o, wa'utu o nyawa-nyawa geena yoihene, ona duru yoheranga, ona yotemo, &lt;&lt;Ma nyawa nuuna ianou woma dama'e o 'umati geena? De ianou womadama'e o 'uaha geena ho wodiai o haala ihera-heranga? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Ae ma Nuuna o woa wodidiai awi ngoa'a? Nage ma eha o ngo Maria; de Awi riado-doto nage nao, Yakobus, o Yusuf, o Simon de o Yudas. <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />De Awi bila-bilanga ma yogogele neena'a? Ho 'ianou womadama'e geena moi-moi?&gt;&gt; <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Geena'a de ona ayoolu'u widawongo. O Yesus wotemo ona'a, &lt;&lt;O nabi moi ia'a naga wai'a geena wihoromati, ma na'o awi hoana de awi woa'a, geena awi horomatiwa.&gt;&gt; <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Mangale ona awi nga'uwa o Yesusi'a ho, Una 'ai lepewa wodiai o haala ihera-heranga geena.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">O Yohanes woohi-ohi'i witooma</para>
  <para style="r">(Mrk. 6:14-29; Luk. 9:7-9)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Wa'utu geena o Herodes wo'oana o Galilea ma daera'a, woihene o Habari mangale o Yesus. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />O Herodes wotemo nage awi daera ihibalu-baluhi'a, &lt;&lt;Ee, marai nuuna o Yohanes woohi-ohi'i wowango'auoli! Geenau ho Una awadadi wodiai o haala ihera-heranga.&gt;&gt;<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Hababu ma hila, o Herodes wohulo'o witago'o de wili'o o Yohanesi'a la wihiohama o bui'a. O Herodes wodiai o geena, mangale mimodo'a awi dawulu ma dutu, geenalah o ngo Herodias, o Filipus ma we'ata. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Hababu ma hila o Yohanes wotemo o Herodesi'a, onane, &lt;&lt;'Ai dadiwa nomimodo'a o ngo Herodias!&gt;&gt; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Ho o Herodes awi hininga ma doda'a womau witooma o Yohanesi'a, duga una wo'idomodongo o nyawa yolepe-lepe'a, hababu ona yana'o'au o Yohanes geena o nabi moi.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Wa'utu o Herodes wodiai o rame mangale awi umuru idogo o taunu moioli, geena'a o ngo Herodias ami ngoa'a momatengo o moholehe moroge o Herodes de awi nyawa-nyawa yoboa-boano manga biono'a. Ami roge geena o Herodes awi hininga yadaene, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />ho o Herodes wojaji hitigi wo'oboto muna'a, ngaro oiau hona mogaaho'o maraio'au mi'ula.<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />Mangale ma eha mibaja, ho ma ngoa'a gumuna motemo, &lt;&lt;O oraha neena ngoi togaaho'o o Yohanes woohi-ohi'i awi hae'e o baki'u nanoa'u de no'ulano!&gt;&gt;<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Ma oraha o Herodes woihene ami ga-gaaho'o, una duru awi hininga ihuha. Ma mangale wojajio'au awi nyawa-nyawa manga biono'a ho, una wohinii'i ma ngoa'a gumuna ami ga-gaaho. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Geena'a de o Herodes wo'ihulo'o awi nyawa'a, la yo'ai'a o bui'a de yatobi'i o Yohanes awi hae'e. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Geena'a de o Yohanes awi hae'e yaaha yohiohama yanoa'u o bakio'a de yo'ula muna'a. Muna ma o ota'a ma eha'a. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Geena iduangino o Yohanes awi ni-nii'i ya'aino yaehe awi maiyeti de yapoohu'u. Geena'a de ona yotagi yohingahu ma habari geena o Yesusi'a.<verse eid="MAT 14:12" /></para>
  <para style="s">O Yesus wohiodomo o nyawa yaribuhu motoa</para>
  <para style="r">(Mrk. 6:30-44; Luk. 9:10-17; Yoh. 6:1-14)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Wa'utu o Yesus woihene ma habari geena, Una wopalene o ngootilie de wotagi o dingii ililili'a. Ma wa'utu o nyawa-nyawa yoihene na'o o Yesus wongootilo'au, ona yamada manga benda-bendara de yotagi wituulu o Yesusi'a yaboa o du-dungiha. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Wa'utu o Yesus wouti o ngootilo'a de wau'u, Una wo'ima'e o nyawa duru manga lepe, Una duru wo'idora. Geena'a de yopa-panya'e wo'ihitogumu.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Wa'utu o wange i'umulu'o'au, o Yesus awi ni-nii'i yomahidutu'u o Yesusi'a de yotemo Una'a, &lt;&lt;Neena o wange i'umulo'o'au, de ma dingii neena imatinga'ino. Iholoi yaowa Aba Guru, no'ihulo'o ma nyawa-nyawa noona la yotagi, la yomadogoo'o o inomo o hoa-hoani'a.&gt;&gt;<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Ma o Yesus wotemo ona'a, &lt;&lt;Uwau yotagi, nginiou halingou nihi odomo.&gt;&gt;<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Awi ni-nii'i yopaluhu, &lt;&lt;Neena'a naga 'amia roti motoa'a, amia nao'o ma 'amodidio'a!&gt;&gt;<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />O Yesus wotemo, &lt;&lt;Niaahano,&gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Geena'a de Una wo'ihulo'o o nyawa-nyawa yogogele o ubuto'a. Una waehe ma roti motoa de ma nao modidi geena, de womatawagade o horogade de Wotemo amo owa ma Jou ma Dutu yaomanga-omanga de. Iduangino Una wapela-pela'a ma roti de awi giama, wo'ula Awi ni-nii'i'a la yo'ihi'ado'u o nyawa-nyawa'a. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Ona moi-moi yoodomo hitigi yo'ipunuhu. Iduangino geena o Yesus Awi ni-nii'i yalomu ma inomo ma holoi o udi mogio de modidiohi. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Wa'utu yoodomo geena'a, 'ao naulohi yaribuhu motoa, geena 'ayo'idoimuahi o nge-ngewe'a de o ngoa-ngoa'a.<verse eid="MAT 14:21" /></para>
  <para style="s">O Yesus womadagi o a'ele ma de'uha</para>
  <para style="r">(Mrk. 6:45-52; Yoh. 6:16-21)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Geena iduangino o Yesus wo'ihulo'o awi ni-nii'i'a yopalene o ngootilie, la yotagi yohila o talaga ma hononga'a, geena'a de o Yesus wo'ihulo'o o nyawa yolepe-lepe yolio. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />O nyawa yolepe-lepe yolio'a, o Yesus wohawu o de'ude de uma dahaubayanga, wa'utu italuho'au ma Una 'ageena'ahi. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Ena awi ni-nii'i manga ngootili, o talaga ma gorona'au yai'a. Manga ngootili geena o mo'u-mo'u yapo'a, mangale o dado'o manga bionino. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Wa'utu i'initau o Yesus wo'ai'a ona'a, de womadagi o a'ele ma de'uha <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Wa'utu awi ni-nii'i wima'e, Una uma dagi o a'ele ma de'uha, ona duru yohidodo'ana, ho yomaorehe, &lt;&lt;Ayoyai, o to'ata!&gt;&gt;<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Ma o Yesus wotemo ona'a, &lt;&lt;Nimaliili! Uwa nio hawana. 'A Ngoi ho.&gt;&gt;<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Ho o Petrus wotemo, &lt;&lt;Na'o Ngona igoungu o Yesus, noihulo'o la ta'ai'a toma dagi o a'ele ma de'uha.&gt;&gt;<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />O Yesus wopaluhu, &lt;&lt;Nainou.&gt;&gt; Geena'a de o Petrus wouti o ngootilo'a de wau'u, de womadagi o a'ele ma de'uha de wo'ai'a o Yesusi'a. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ma wa'utu o Petrus wamao o dado'o duru iuata ma talaga'a geena, una wohawana ho wolutu, de woma orehe, &lt;&lt;Jou, noiduhunu.&gt;&gt;<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Geena'a de o Yesus widoa'a, de wagagao o Petrus awi giami'a, de wotemo, &lt;&lt;E Petrus, ngona neena i'uranga Noinga'u. Dodoau ho ani hininga 'ilio-lio?&gt;&gt;<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Geena'a de o Yesus de o Petrus yopalene ma ngootilie geena, de ma dado'o ma iliili. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Ho awi ninii'i wihuba o Yesusi'a. Ona yotemo, &lt;&lt;Igoungu, Nuuna ma Jou ma Dutu Awi Ngoa'a.&gt;&gt;<verse eid="MAT 14:33" /></para>
  <para style="s">O Yesus wo'ihitogumu o nyawa yopa-panya'e o Genesareto'a</para>
  <para style="r">(Mrk. 6:53-56)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Wa'utu ona yoma hiadoni'a o Talaga ma hononga'a, ona youti o Genesaretiha. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Geena'a de o nyawa-nyawa wina'o o Yesusi'a, ona yohihabari ma habari geena, o bendara ma hiridateino. Geena'a de moi-moi yopa-panya'e yo'iaha o Yesusi'a. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Ona yogaaho'o o Yesusi'a la tanu wo'ihigumada yagagao awi baju i'a'a'ulu'u ngaro ama baleni'a. Ho nyawa moi-moi manga panya'e ia'i.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">O Yahudio'a ma nyawa yapalene ma Jou ma Dutu awi pareta mangale yanii'i manga baluhu ma hila-hila manga 'autoranga</para>
  <para style="r">(Mat. 15:1-20)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Geena'a de, yamuluo naga o Farisio'a ma nyawa, de agama'a yodoto-doto'o, nage o Yerusalemo'a yo'aino o Yesusino. Ona yohano Una'a, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt;Idodoau ho ani ni-nii'i yapalene nanga balu ma hila-hila manga adata? Ho wa'utu yoodomo de manga giama ayaiho'ua ihila, imote'e nanga 'autoranga!&gt;&gt;<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />O Yesus wopaluhu, &lt;&lt;De idodoau ho ngini ma, nia palene ma Jou ma Dutu awi 'autoranga? Mangale ania nii'i nia baluhu ma hila-hila manga adata? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Hababu ma Jou wotemo, &lt;Ni'i horomati, nia dea de nia eha,&gt; de &lt;Nagonau yo'ihilolai manga dea bolo manga eha, ona halingou yo'ihu'umu yo'iho-honenge.&gt; <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ma ngini nii'i doto'o o nyawa: Na'o o nyawa yotemo manga baluhi'a, &lt;O 'iau nage halingou to'ula 'ai dea de 'ai eha'a, geena tohihuba'au ma Jou'a,&gt; <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Ma nyawa goona 'ayo'ihoromatiwau manga baluhi'a. Hababu mangale nia dotumu manga autoranga ho, ngini nia ete-ete'e ma Jou awi pareta. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Ayo tengelu'u! Itiaio'au, hara de o nabi Yesaya ma hila awi demo, mangale ngini, geenalah:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />&lt;O nyawa-nyawa noona ipuji 'amanga ulu ma 'aio'a,</para>
  <para style="q1" vid="MAT 15:8">Ma manga hininga'a yomatinga'a de de Ngoi.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />O iwa ma faeda ipuji Ngoino,</para>
  <para style="q2" vid="MAT 15:9">Hababu o 'iau yo'ihidoto'o o nyawa-nyawa'a,</para>
  <para style="q2" vid="MAT 15:9">Yanii'i ato nyawa manga autoranga, de yotee bali geena to Ngoi 'ai 'autoranga.&gt; &gt;&gt;<verse eid="MAT 15:9" /></para>
  <para style="s">O 'iau ma hababu hiadono o nyawa yobaradoha</para>
  <para style="r">(Mrk. 7:14-23)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Geena'a de o Yesus, wo'iaho'o o nyawa-nyawa, de wotemo ona'a, &lt;&lt;Nio ihene la nima ma mangariti! <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />O 'iau nage iohama manga ulu'o, geena 'ai ma dadiwa o baradoha, duga o'iau nage ihupu manga uluha, geenala imadadi o baradoha.&gt;&gt;<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Geena'a de o Yesus awi ni-nii'i yomahidutu Una'a, de yotemo, &lt;&lt;Ee Aba noma na'o bolo 'ouwa! O'iau 'aano ge noma ade-ade, manga hininga ayadaenua o Farisio'a ma nyawa-nyawa?&gt;&gt;<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />O Yesus wopaluhu, &lt;&lt;Nage o joro 'ai Deawa o horoga'a wotudu'u, geena aha yaapu'u hitigi ma ngutu-ngutu'u'u. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Uwa ni'i daali'a o Farisi ma nyawa'a. Hababu ona geena harage 'ao daera ma balu-baluhu yopilo-pilo'o; de na'o yopilo-pilo'o yoma 'atuda de yopilo-pilo'o, maraio'au goona yamididi yoota'a o guhu'u.&gt;&gt;<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />O Petrus wotemo, &lt;&lt;Aba guru, tanu nimihimangaratinou ma hi'atero geena!&gt;&gt;<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />O Yesus wopaluhu, &lt;&lt;O ho ngini ma 'ani ma mangaritiwahi? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Ania na'owa? O 'iau nage iohama nanga ulu'o, iuti nanga po'o'u, geena'a de aha pohidagioli? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Ma nage ihupu nanga uluha, geenala ipuda manga hiningade; Geenau ina hibaradoha o nyawa. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Hababu manga hiningade ipuda o dibanga iti-tiiha, ho idadi o nyawa yotooma, yohowono, itiyoma'apa'e'a, yotohi'i, yodadi o ha'ihi ma ngelu'u, de yo'ironga ma diiha. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Geenau moi-moi yo'ihibaradoha o nyawa, ma ge yoodomo de manga giama ayaiho'ua, geena 'a'o uwa.&gt;&gt;<verse eid="MAT 15:20" /></para>
  <para style="s">O Kanan ma nyawa momatengo ami ngonga'u</para>
  <para style="r">(Mrk. 7:24-30)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Geena'a de o Yesus wamada ma dingii geena, de wotagi o Tirus de o Sidon ma bendara ma date-dateino. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Ma daera'a geena, o Kana'an ma nyawa momatengo, maino o Yesusino de mogaaho'o, &lt;&lt;ee Yesus o Dautu awi guti'u, tanu noidora! 'Ai ngoa'a o ngewe'a do'a midongohami'a o to'ata. De duru 'a amidohau'o'a.&gt;&gt;<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Ao demo o ngale moi ma o Yesus awopaluhua. Geena'a de Awi ni-nii'i ya'ai'a de yogaaho'o yotemo, &lt;&lt;Aba guru, nomihulo'i'au ma ngewe'a gumuna motagi. Muna amuna di-digigorino nanga duduniha!&gt;&gt;<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />O Yesus wopaluhu, &lt;&lt;Ngoi ma Jou ma Dutu woihulo'o, 'ao Israel ma nyawa to'iduhunu, nage o nge'omo yangowu-ngowu'a.&gt;&gt;<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Ma ngewe'a gumuna ma'aino de ma tilabu'u'u o Yesus awi biono'a, de motemo, &lt;&lt;Tuanga, tanu noiduhunu.&gt;&gt;<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />O Yesus wopaluhu, &lt;&lt;Ayadaenua o ngoa-ngoa'a manga inomo, de po'ula o'aho'a.&gt;&gt;<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Ma ngewe'a gumuna mopaluhu, &lt;&lt;Itiai tuanga, duga ma 'aho geena yaodomo ma inomo 'a ma rue-rue nage iota'a ani ama'u'u.&gt;&gt;<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Geena'a de o Yesus wotemo muna'a, &lt;&lt;Bilanga, ani ngonga'u 'ao guata! Pamada'au la idadi harage ani ga-gaaho'o!&gt;&gt; 'Ageena ena ma ngewe'a gumuna ami ngo'a itogumo'au.<verse eid="MAT 15:28" /></para>
  <para style="s">O nyawa manga lepe yopa-panya'e o Yesus wohitogumu</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />O Yesus wamada ma dingii geena, de wotagi waboa o Galilea ma talaga ma uluno. Geena'a de Una wohawu o de'ude moi de wogogelu'u geena'a. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />O nyawa manga lepe yo'iaha o Yesusino, yocuga-cuga, yopilo-pilo'o, yopa-paluga, yomou-mou, de manga lepehi o nyawa yopa-panya'e ma regu. Ona yo'inoa o Yesus awi biono'a, geena'a de Una wo'ihiai'i ma nyawa-nyawa goona. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Geena'a o nyawa yolepe-lepe duru yoheranga, wa'utu yo'ima'e yomou-mou yomaade-ade, yocuga-cuga yotogumu, yopa-paluga yomadagi, de yopilo-pilo'o yomahima'e. Geena'a de ona wipuji ma Jou ma Dutu'a nage, o Israelo'a ma nyawa wihuba-huba.<verse eid="MAT 15:31" /></para>
  <para style="s">O Yesus wo'ihiodomo o nyawa yaribuhu hoata yoholoi</para>
  <para style="r">(Mrk. 8:1-10)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Geena'a de o Yesus wo'iaho'o awi ni-nii'i'a de wotemo, &lt;&lt;Ngoi duru to'idora o nyawa yolepe-lepe'a noona. O wange haangenou ona inii'i, de o oraha neena o iwau manga inomo. Ngoi ato ihigumadawa ona yolio de manga hawino'a, done o nge'omo ma goronano de yohalautu.&gt;&gt;<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Geena'a de awi ni-nii'i yohano o Yesusi'a, &lt;&lt;Ma dingii neena 'ao ga'ulino o hoana yatinga'a, la done ia'a po'idama'e o inomo o nyawa manga lepe neena?&gt;&gt;<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Ho o Yesus wohano ona'a, &lt;&lt;Muluo'a gena'anaga nia roti?&gt;&gt;</para>
  <para style="p" vid="MAT 15:34">Ona yopaluhu, &lt;&lt;Tumudingo'a, de mia nao'o ile-leete'e muluo'a naga.&gt;&gt;<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Geena'a de o Yesus wo'ihulo'o o nyawa yolepe-lepe yogogele o tona'u'u. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Una waehe o roti tumudiingi de o na'o geena, de Una wotemo amaowa'a ma Jou ma Dutude. Una wapela-pela'a ma roti de ma nao'o de Awi giama, de wo'ula awi ni-nii'i'a. Ona yo'ihi'ado'u o nyawa yolepe-lepe'a. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Ma nyawa moi-moi geena'a yoodomo hitigi yo'ipunuhu. Geena'a de awi ni-nii'i yalomu ma inomo ma holoi. Moi-moi o bokolo tumudingi yaoma-omanga. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Manga lepe yoodomo wa'utu geena 'ao nau-naulohi yaribuhu hoata, geena ayo'idoimuahi o nge-ngewe'a de o ngoa-ngoa'a.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Geena'a de o Yesus wo'ihulo'o ma nyawa-nyawa goona yolio. Una ma hirete wopalene o ngootilie de wotagi o Magadan ma daera'a.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">O Farisio'a de o Saduki ma nyawa yogaaho'o o haala ihera-heranga</para>
  <para style="r">(Mrk. 8:11-13; Luk. 12:54-56)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Geena'a de o Farisio'a de o Sadukio'a ma nyawa-nyawa yoboa o Yesusi'a de yomau witaili. Ona yogaaho'o o Yesusi'a la wohimaiti ona'a o haala moi ihera-heranga o la yana'o Una geena woboa ma Jou ma Dutuno. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Ma o Yesus wopaluhu: &lt;&lt;Na'o o wange itumunou de o diwanga iterebo'o, ngini niotemo: Neena o ngogorou <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Ma o dewela o dedewelano mangale o diwanga o iterebo'o de ilobi, ngini niotemo: Neena o beha'ou. O gitawa o diwango'a 'ai dadi niata'ihiri, ma o dunia ma baha ma du-dungu ania dadiwa. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />O nyawa yoti-tingi'ai de yopihi-pihi yogaaho'o o dudunguu. Ma o Yesus awo'i'ulawa o dudunguu, duga ato ma nabi Yunus.&gt;&gt; Iduangino womaade-ade o geena, o Yesus de awi ni-nii'i yotagi de yo'imada.<verse eid="MAT 16:4" /></para>
  <para style="s">Nimahidi-diai o Farisio'a de o Sadukio'a ma nyawa manga dodoto'o harage de 'ao ragi</para>
  <para style="r">(Mrk. 8:14-21)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />O Yesus de awi ni-nii'i yotagi o Galilea ma talaga ma hononga'a. Wa'utu geena, ona yamongo yoaha manga roti. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Ho o Yesus wotemo ona'a, &lt;&lt;Ngini iani nimahidi-diai o Farisio'a de o Sadukio'a ma nyawa manga ragi.&gt;&gt;<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Ona yoihene o Yesus wotemo o geena de yoma'atemo moi de moi, &lt;&lt;Ee, ma Aba Guru o geena womaade-ade mangale 'apoahawa nanga roti.&gt;&gt;<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Ma o Yesus wana'o o 'iau 'aano ge yoama'aade-ade, ho Una wotemo ona'a, &lt;&lt;Bote niotemo o geena tomaade-ade hababu 'a nioahawa o roti? Waee, ho ngini ma ani nga'uwahi! <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Ngini nimahina'o'au! Hababu ngini marai 'anio danganonohi, wa'utu ngoi tapela-pela'a o roti motoa de to'ihiodomo o nyawa yaribuhu motoa yoholoi. Wa'utu geena o udi muluohi ma boloi ngini nia lomu? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />De wa'utu to'ihiodomo o nyawa yaribuhu hoata yoholoi 'ade o roti tumudiingi, o udi muluohi ngini nia lomu ma boloi? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Ho na'o o geena, dodoau ho o oraha neena ngini animahina'owahi? Hababu, 'aano ge 'ai ade-ade 'ai ma'uhuutu 'ao rotiwa. Ma tinitemoli ngini'a, ngini iani nimahidi-diai o Farisio'a de o Sadukio'a ma nyawa manga ragi!&gt;&gt;<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Geena'a de aha awi ni-nii'i yomahina'o. Nage o Yesus wo'ihitiari yomahididiai de o ragi, o Yesus awi ma'uhuutu 'ao ragiwa ge o nyawa yadi-diai o roti, ma 'ao Farisi de o Sadukio'a ma nyawa manga dodoto'o ma diiha, uwa hiadono yodinii'i.<verse eid="MAT 16:12" /></para>
  <para style="s">O Petrus womanga'u na'o o Yesus geena ma 'Oana wonahiha-halamata</para>
  <para style="r">(Mrk. 8:27-30; Luk. 9:18-21)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />O Yesus de awi ni-nii'i yomahiadoni'a o daera o Kaisarea Filipi ma bendara ma date'o'a. Geena'a o Yesus wohano awi ni-nii'i'a, &lt;&lt;O nyawa yotemo, o Nyawa ma Ngoa'a geena naguunau?&gt;&gt;<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Ho ona yopaluhu, &lt;&lt;Ma regu yotemo o Yohanes woohi-ohi'i, ma regu yotemo ma nabi Elia. Ho ma regu yotemo ma nabi Yeremia, e'ola moi o na-nabiino.&gt;&gt;<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Geena'a de o Yesus wo'ihano ona'a, &lt;&lt;Ho na'o imote'e ngini Ngoi neena naguunau?&gt;&gt;<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />O Simon Petrus wopaluhu, &lt;&lt;Aba Guru Ngonau ma 'Oana nimihiha-halamata. Ngonau ma Jou ma Dutu wowango-wango awi Ngoa'a!&gt;&gt;<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Geena'a de o Yesus wotemo o Simoni'a, &lt;&lt;Simon, o Yunus awi ngoa'a! Ngona duru nohanango'au, hababu o 'iau 'aano ge notemo 'a o nyawawa nihingahuno, ma 'ai Dea da'u o horoga'a nowihingahu. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Mangale geena, Ngoi tonihi ronga o Petrus, ma mangariti, o heleo i'ua-uta. De geena ma heleo ma de'uo'a Ngoi tohigo'o 'ai Jama'ata. De 'ai Jama'ata geena 'ademaena 'ahiado-adoni'a, amoiwa yadadi yahoroma 'ai jama'ata geena, ngaro de o honenge ma 'uaha ma. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Ngoi aha toni'ula o haaka la natuda ma jama'ata geena. Geena harage toni 'ula o horoga ma 'uci, la o 'iau natuumungu o dunia'a neena, geena ma ma Jou ma Dutu watuumungu. O geenali de o 'iau nohigumada o dunia'a neena, geena ma ma Jou ma Dutu wohigumada.&gt;&gt;<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Iduangino Womaade-ade, Una wo'itaaele awi ni-nii'i la 'a o nyawa moi'a ma uwa ihingahu, na'o Una geena ma Oana wonahiha-halamata, nage ma Jou ma Dutu wohijajio'au.<verse eid="MAT 16:20" /></para>
  <para style="s">O Yesus wohingahu idi-dihila'a mangale awi hangihara de awi honenge</para>
  <para style="r">(Mrk. 8:31-9:1; Luk. 9:22-27)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Geena de imahi'ai'a o Yesus womahingahu womahito-tongoti'a awi ni-nii'i'a, Una halingou wotagi o Yerusalem ma bendari'a, ido'a aha waohana o hangihara o Yahudi ma balu-baluhino, imam ma hae-hae'ino de o Yahudi ma agama'a yodoto-doto'o. Ona noona aha witooma o Yesusi'a, ma 'a o wange haange ena wowango'auoli.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Ma o Petrus witoba'a o Yesus ma date'i'a de witaaele, wotemo &lt;&lt;Aba Guru uwa 'ogeena Nomaade-ade. Tanu ma Jou nowihitinga'a geena moi-moi. Uwa hiadono naohana!&gt;&gt;<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Ma o Yesus womalelo'o de witaele o Petrusi'a, &lt;&lt;Nomaliili! Ani demo geena harage 'ao to'ata ma 'oana ma demo. Ngona uwa noi'adu'ulu ma Jou ma Dutu awi mau tadiai ho. Hababu ngona napa'e 'a de o nyawa ma dibanga, de 'ato ma Jou wa awi dibanga napa'e.&gt;&gt;<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Geena'a de o Yesus wo'itemo awi ni-nii'i'a, &lt;&lt;Nagonau yomau inii'i, geena 'ai dadiwa yamote'e toona manga mau. Yamo'u o salipi, de inii'i Aitauri'a. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Hababu nagonau yowango de yatibanga atoona manga roehe mahirete, ona geena aha manga wowango iihanga 'ahiado-adoni'a. Ma nagonau yo'ula manga wowango de iini'i ngoi, ona aha yomadama'e o wowango 'ahiado-adoni'a. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />O iwa ma utumu na'o o nyawa womatengo de wama'e o arata moi-moi o dunia'a neena, ma awa ma'ewa o wowango 'ahiado-adoni'a ma Jou ma dutuno.<verse eid="MAT 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 16:27" />Habau o nyawa ma Ngoa'a woboali o duniano neena, yoma'anii'i de ma Dea awi ma-malai'ata ma 'uaha. Wa'utu geena o Nyawa ma Ngoa'a aha wabalaha o nyawa-nyawa'a imote'e o 'iau ona yadiao'au. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Nio ihene nihididiai 'aano ge o'iau Totemo'au. Neena'a naga niahidogorona'a, aha de maena 'ayohonengua, na'o awi ma'ewahi o Nyawa ma Ngoa'a woboa wodadi wo 'Oana.&gt;&gt;<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">O Yesus awi rupa ingali o de'uo'a</para>
  <para style="r">(Mar. 9:2-13; Luk. 9:28-36)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />O wange butanga ipaha'a o Yesus wo'iaha o Petrus, o Yakobus de ma dodoto o Yohanes, ona yoma'anii'i yohawu o de'u moi i'a'a'ulie. Geena'a amoiwa o nyawa ma homoa. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Geena'a manga biono'a, o Yesus awi biono ingali: Awi biono ma hiwa harage 'ao wange de awi baju i'a'a'ulu'u ma iarehe ileto-letongo. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Geena'a de awi ni-nii'i yo'ima'e o Musa de o Elia yoma'ade-ade de o Yesus. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Geena'a de o Petrus wotemo o Yesusi'a, &lt;&lt;Aba guru, duru 'a o hanaanga ngone neena'a. Ho na'o 'anomode'e, ngomi tohigo'o o woa-woa haange neena'a: Moi to Ngona Aba guru, moi to Musa de moi to Elia.&gt;&gt;<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Wa'utu o Petrus awomaade-adehi, itodo'anino o 'amo-amo ita-tararono iuti de yo'itamunu. Geena'a de ona yoihene o ilingi o 'amo-amo ma dodano itemo 'onane, &lt;&lt;Nuuna to Ngoi 'ai ngoa'a to wihiboho-bohono, Una 'ai hininga wahanaanga. Niwigihene Una'a.&gt;&gt;<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Wa'utu o Yesus awi ni-nii'i yoihene ma ilingi geena ona duru yohawana hitigi ona yomapaga o tona'u'u. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Geena'a de o Yesus wa'ai'a de wo'i 'ayabete, de wotemo, &lt;&lt;Nio momi'i. Uwa niohawana!&gt;&gt; <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Wa'utu ona manga hae'e yapetade geena'a 'amoiwau duga 'a o Yesusou womatengo'a.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Wa'utu ona youti ma de'u'u geena, o Yesus wo'ihibehehongo ona'a, &lt;&lt;Uwa nihi'a'angahu amoi'a ma 'aano ge nia ma'e-ma'e, hitigi o Nyawa ma Ngoa'a womomi'i o honengino.&gt;&gt;<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />O Yesus awi ni-nii'i yohano Una'a, &lt;&lt;Idodoau ho o agama'a yodoto-doto'o yotemo bali halingou o Elia ihila woboa?&gt;&gt;<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />O Yesus wopaluhu, &lt;&lt;Itiai, o Elia aha woboa ihila la wohi'adiai o hagala moi-moi. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Ma Ngoi tinitemo, o Elia woboa'au, duga o nyawa-nyawa awi na'owa; Ona widiai imote'e to ona manga mau. O geenali ona aha widiai o Nyawa ma Ngoa'i'a.&gt;&gt;<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Geena'a de aha ona yomama-mangariti, na'o o Yesus awi ade-ade mangale o Elia, geenala ma dumutu 'ao Yohanes woohi-ohi'i'a.<verse eid="MAT 17:13" /></para>
  <para style="s">O Yesus waginii'i o to'ata nage o ngoa'i'a widongohami'a</para>
  <para style="r">(Mar. 9:14-29; Luk. 9:37-43)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Wa'utu o Yesus de awi ni-nii'i ge yahaange yoma'iliooli o nyawa yolepe-lepe'a, geena'a o ngoa'a o naulu womatengo woboa de watilabu'u'u o Yesus awi biono'a. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />De wotemo, &lt;&lt;Aba guru, tanu nowidora 'ai ngoa'a. Una wimuhu-muhu'u duru hangihara, ho na'o widoboano i'ade woota'a o u'u'u de o a'elu'u. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ngoi towiaha'au ani ni-nii'i'a ma ona ayadadiwa yaai'i.&gt;&gt;<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />O Yesus wopaluhu, &lt;&lt;Wolo hara 'ao gu-guulewa ngini neena! Itiaio'au ngini o nyawa 'anio nga'u-nga'uwa de nio ba-baradoha, ma daao muluonohi halingou Ngoi dede ngini? De ma daao muluonohi Ngoi halingou toma tongohono.? Niwiahano ma ngoa'a guuna.&gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Geena'a de o Yesus wodorohu ma to'ata geena de wahulo'o la ihupu ma ngoa'ino geena. Geena'a de ma to'ata ma ihupu, ho 'ageena ena ma ngoa'a guuna wotogumo'au.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Geena'a de awi ni-nii'i yotagi o Yesusi'a wa'utu o Yesus 'awoma tengo'a de yohano, &lt;&lt;Aba guru, Idodoau ho ngomi amiadadiwa mia ginii'i ma to'ata geena?&gt;&gt;<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />O Yesus wopaluhu, &lt;&lt;Hababu nia ngonga'u 'ai 'uatua. Nia ngano-nganono! Na'o nia ngonga'u de maena, ngaro ma ete'e harage 'a o Sawi ma mui, ngini 'aidadi nio temo o de'u'a <note caller="-" style="x"><char style="xo" closed="false">17.20 </char><char style="xt" closed="false">O Sawi ma mui geena duru iete ma ma roehe ma ga'ulie hitigi o metere haange ho onamo o ginita'a ma ima diigutu. Ena neena iwango do'a o Pelistina'a</char></note>neena, &lt;Nomahelo do'angi'a!&gt; Maraio'au ma de'u geena imahelo. Moi-moi 'ania dadi niadiai! Ho itigoo'o nio nga'u ma Jou'a. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />[Ma ngini ma halingou nia na'o, o omaha ma diiha o ne-neena 'ai dadi paginii'i duga 'a de o haubayanga de o puaha.]&gt;&gt;<verse eid="MAT 17:21" /></para>
  <para style="s">O Yesus wohidemoli mangale aha wohonenge</para>
  <para style="r">(Mar. 9:30-32; Luk. 9:43-45)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Wa'utu o Yesus de awi ni-nii'i yolomuno o Galilea'a, Una wotemo ona'a, &lt;&lt;'ai taaowau ena o Nyawa ma Ngoa'a wihigiama ma hoata o nyawa-nyawa'a. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Una aha witooma, ma 'a o wange haange ena wowango'auoli.&gt;&gt;</para>
  <para style="p" vid="MAT 17:23">Wa'utu awi ni-nii'i yoihene o geena de manga hininga duru ihuha.<verse eid="MAT 17:23" /></para>
  <para style="s">O Yesus wohangu o balahitenge mangale ma Jou ma Dutu Awi woa</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Wa'utu o Yesus de awi ni-nii'i yomahiadoni'a o Kapernaum ma bendaro'a, o nyawa ge yoga-gaaho'o o balahitenge mangale ma Jou ma Dutu awi woa yo'aino o Petrusino de yohano, &lt;&lt;Ani guru wohangu bolo o uwa o balahitenge mangale ma Jou ma Dutu awi woa?&gt;&gt;<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />O Petrus wopaluhu, &lt;&lt;Iolo wohangu!&gt;&gt;</para>
  <para style="p" vid="MAT 17:25">Wa'utu o Petrus woohamou o woa'a, o Yesus wihano ihila o Petrusi'a, &lt;&lt;E Simon na'o imote'e ingona, nagonau halingou yohangu o balahiteenge ma o'a-o'ani'a neena o dunia'a? O 'awaha bolo o nyawa yotagi-tagino?&gt;&gt;<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />O Petrus wopaluhu, &lt;&lt;O nyawa yotagi-tagino,&gt;&gt; O Yesus wotemo, &lt;&lt;Ho o 'awaha ngarouwa yohangu o balahitenge.<verse eid="MAT 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 17:27" />Ma uwa hitigi manga hininga apadaenua. Ho notagi o talaga'a la nomeme'ana. O nao'o ididihila'a nameme'ana naehe de napelenga ma ulu, geena'a aha nama'e o tiwi ipahi pohihangu tongone inamididi nanga balahitenge to ngona de to Ngoi.&gt;&gt;<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Nagoonau iholoi yoamo'o</para>
  <para style="r">(Mrk. 9:33-37; Luk. 9:46-48)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Wa'utu o Yesus awi ni-nii'i yo'ai'a de yohano Una'a, &lt;&lt;Nagonau iholoi yoamo'o ma Jou ma Dutu awi 'awaha ma hidogorona'a?&gt;&gt;<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />O Yesus wo'iaho'o o ngoa'a ma ete'e moi de wohulo'o la womahigo'ono manga biono'a. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Geena'a de Wotemo, &lt;&lt;Nio nga'u! Duga nagonau yadadi yomangali harage 'ao ngoa'a ma ete'e neena, geena aha yodadi ma Jou ma Dutu awi awaha. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />O nyawa nage manga hininga yohitipo'o'u de yodadi hara'ao ngoa'a ma ete'e neena, goona iholoi yoamo'o ma Jou ma Dutu awi 'awaha manga hidogorona'a. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />De nagonau yo'idawongo o ngoa'a ma ete'e neena mangale inga'u Ngoino, geena ona idawongo'au Ngoi.&gt;&gt;<verse eid="MAT 18:5" /></para>
  <para style="s">Uwa niodiai hiadono o nyawa yobaradoha</para>
  <para style="r">(Mrk. 9:42-48; Luk. 17:1-2)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />O Yesus wotemoli, &lt;&lt;Nagonau yo'idiai o ngoa'a ma ete-ete'e neena hitigi 'ai nga'uwau, iholoi yaowa manga toma'u ihili'o o heleo 'iamo-amo'o de yo'itapu o gahi ilu'u-lu'u'u. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Nio bodito o nyawa-nyawa o dunia'a neena, mangale o haa-haala geena hitigi o nyawa yobaradoha. Igoungu o haala o ge-geena aha de maena, ma yobodito o nyawa yodi-diai o hababu!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />Na'o la ani giama 'e'ola ani dou, nidiai nobaradoha, naoto la naumo'au. Hababu iholoi yaowa nowango de ma Jou ma Dutu de ani giama 'e'ola ani dou ama hononga'a, uwahiadono de ania giama de ani dou imahiodu-odumu ma niumo o naraka'u. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />De na'o ani la'o nidiai ho nobaradoha, iholoi yaowa na'uapete la naumo'au. Hababu iholoi yaowa na'o ngona nowango de ma Jou ma Dutu de ani la'o ama hononga'a. Uwa hiadono de la'o modidio'a ma niumo o naraka'u.&gt;&gt;<verse eid="MAT 18:9" /></para>
  <para style="s">O hi'atero mangale o duba iihanga</para>
  <para style="r">(Luk. 15:3-7)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Nia hi-hingina, 'ao nyawa moi'a ma 'aidadiwa ni'ihohedu o nyawa biaha, harage 'ao ma ete'e noona. Hababu o nyawa-nyawa noona de manga malai'ato'a da'u o horoga'a de ma Jou ma Dutu.<verse eid="MAT 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 18:11" />Hababu o Nyawa ma Ngoa'a woboa o duniano neena duga wo'ihihalamata o nyawa yoba-baradoha!<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Icara'iau nia ma-ma'e? Na'o bali womatengo awi o duba o dutu o ratuhumoio'a, de iihanga o dutu moi, bee'a done o 'iau wodiai ma nyawa guuna? Maraio'au una wamada awi duba ge o dutu morihiwo de hiwo ge o de'uo'a, de wotagi wahali'i ge iiha-ihanga. <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Tinitemoe, na'o una wama'e awi duba geena, una duru womagarago mangale o dutu moi geena, ngaro de o dutu morihiwo de hiwo ge aiiha-ihangua. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />O geenali de nia Dea da'u o horoga'a, Awoolu'u de o nyawa moio yonga'uo'au ge Ngoino de yoihanga.<verse eid="MAT 18:14" /></para>
  <para style="s">Mangale o hitiari nanga riado-doti'a</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />&lt;&lt;Na'o 'ani riado-doto wodiai o baradoha ngona'a, no'ai'a de nowihimaiti awi hala. Nadiai geena 'a nima hibongonino nimididio'a. Na'o una wodomote'e ani demo-demo, geena ngona nowia'unu uma'ilio. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Ma na'o o uwa, no'iaha o nyawa wometengo e'ola yamididi. Hababu o bo'u Ibe-berehii'u itulihu'u'au, &lt;Na'o ngone powitae wahala, halingou ma ha'ihi ma 'urangu'u yamididi e'ola yahaange.&gt; <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Na'o una awoihenua ania hitiari geena, nihingahu o jamaa'ati'a awi haala geena. De na'o una awoihenua o jama'ata manga hitiari, una geena powihitero harage 'ao baliteenge yoga-gaaho'o ge yoba-balehuta, nage ma Jou awi na'owahi.&gt;&gt;<verse eid="MAT 18:17" /></para>
  <para style="s">Aihigumadawa de</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />&lt;&lt;Tinitemoe: O 'iau nage anihigumadawa o dunia'a neena, geena ma ma Jou ma Dutu awohigumadawa. De o 'iau iigumada o dunia'a neena, geena ma ma Jou ma Dutu wohigumada o horoga'a.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />De tinitemoli ngini'a: Na'o neena'a naga nginio'a yamididi o dunia'a neena yohaubayanga de 'ao hininga moi, o 'iau hona ona yogaaho'o manga haubayanga geena wadawongo 'ai dea da'u o horoga'a. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Hababu 'ia'a yamididi e'ola yahaange yolomuno mangale yonga'u Ngoino, Ngoi naga dede ona.&gt;&gt;<verse eid="MAT 18:20" /></para>
  <para style="s">O hi'atero mangale o apongo</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Geena'a de o Petrus wohano o Yesusi'a, &lt;&lt;Jou, na'o 'ai riado-doto wodiai o baradoha ngoino, halingou ma muluo ngoi towiapongo? Hitigi ma tumudiingi?&gt;&gt;<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />O Yesus wopaluhu, &lt;&lt;O uwa hitigi 'ama tumudiingua, ma ma moritumudiingi de nohidigali ma tumudiingi! <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Hababu na'o ma Jou ma Dutu wopareta geena harage 'ao hi'atero neena: Ma 'oana womatengo yoma'adoimi manga nagimi de awi gi-gilaongo. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Wa'utu una wo'ipiri'iha, wihitaali woma tengo awi gilaongo nage awi nagimi ijuta-juta. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Ma gilaongo guuna awaaunuau wohangu awi nagimi. Ho, ma 'oana wopareta, la ma wigilaongo guuna, de awi ngoa'a, de awi we'ata, de awi arata moi-moi, yawu'unu la ihihangu. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Ma gilaongo guuna watilabu'u'u, ma oana awi biono'a de wogaaho'o, &lt;Tuanga, tanu uwahi noido-doa'ani. Maraio'au ngoi to hangu moi-moi 'ai nagimi.&gt; <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Geena'a de ma 'oana widora una'a, ho una wai'ili moi-moi awi nagimi.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />Wa'utu ma gilaongo guuna wohupu, una yoma'ama'e de awi manai o 'arajaanga moi, una ma de awi nagimo'a o ribuhu muluo naga. Una witago'o awi manai guuna, de wigoodongo, de wotemo, &lt;Nohangu moi-moi ani nagimi!&gt; <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Geena'a de awi manai guuna watilabu'u'u awi biono'a, de wogaaho'o, &lt;Uwahi manai, moi-moi aha tohangu!&gt; <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Ma una awoolu'u. Walelono de awi manai guuna wihiohama o bui'a, hitigi moi-moi wohangu awi nagimi. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Wa'utu ma gi-gilaongo ma regu yama'e 'ogeena idadi, ona duru manga hininga ihuha, ho yohingahu ma haala geena ma 'oani'a. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Geena'a de ma 'oana wiaho'o awi gilaongo ge awi hininga iti-tiiha de wotemo una'a, &lt;Ee gilaongo ani hininga iti-tiiha! Moi-moi ani nagimi tai'ilo'au mangale anoma dodora'u. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Ho ngona ma halingou no'idora ani ma-manai'a, harage 'angoi tonidora'au ngona'a?&gt; <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Ma 'oana duru wongamo ho ma gilaongo awi hininga iti-tiiha ge wihiohama o bui'a, hitigi awi nagimi wohangu wabo-boti'a.&gt;&gt;<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />O Yesus wohibobaha awi jarita, de o demo-demo 'onane, &lt;&lt;O geenali de 'ai Dea da'u o horoga'a aha niwihidiai ngini'a moi-moi, na'o ngini ni'iapongo 'ania riado-doti'a de 'ania hininga 'ade ma ngodumu.&gt;&gt;<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">O do-doto'o mangale o giabere'i 'aidadiwa poma'aolu'u</para>
  <para style="r">(Mrk. 10:1-12)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Iduangino o Yesus wodoto'o geena moi-moi, Una wamada o galilea ma daera de wotagi o Yudea ma daera'a ge o Yordan ma ngaili ma hononga'a. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Manga lepe o nyawa winii'i, de wo'ihiai'i yopa-panya'e geena'a.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Geena'a de o Farisio'a ma nyawa yoboa de wibole ma goa-goa. Ona yohano Una'a, &lt;&lt;Imote'e nanga agama ma autoranga, bote 'aidadi mia we'ata mi'iolu'u, ngaro o iwa ma hababuma?&gt;&gt;<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />O Yesus wopaluhu, &lt;&lt;Ngini ma marai nia baca'au, o bo'u Ibe-berehi ma doda, hababu wa'utu o nyawa idi-dihila'a wo'itulada geenala o ngewe'a de o naulu?&gt;&gt; <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />De iduangino Una womaade-ade, &lt;&lt;Mangale geenau ho, o nau-naulu yo'imada manga eha de manga dea, de yorimoi de manga we'ata, ho ona yamididi yodadi amoiou.&gt;&gt; <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Ho ona 'amodidiwau, ma 'amoiou. Mangale genau ho, o 'iau nage ma Jou wo'ihi'arimoio'au, 'aidadiwa o nyawa ihi'atinga'a.<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Geena'a de o Farisio'a ma nyawa yohano Una'a, &lt;&lt;Na'o o geena idodoau ho, o Musa wo'ihigumada yoma'aolu'u, itigoo'o de manga ngo-ngolu'u ma hurato'a?&gt;&gt;<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />O Yesus wopaluhu, &lt;&lt;Mangale 'ania hae'e ma gopini ho, o Musa niwihigumada ni'iolu'u nia we'ata. Ma na'o ma hila 'a'o geenawa. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Ho nioihene nihidi-diai: Nagoonau manga we'ata ayohowonua de yo'iolu'u, geena'a de yomodo'a de o ngewe'a moioli, geena ma nyawa guuna wohowono'au.&gt;&gt;<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Ho awi ni-nii'i yohano o Yesusi'a, &lt;&lt;Na'o o giabere'i la imadadi ma rupa o geena, iholoi yaowa uwau pomodo'a.&gt;&gt;<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Ma o Yesus wotemo ona'a, &lt;&lt;'Ama moiu'uwa o nyawa yodinii'i ma demo-demo geena, duga 'ao nyawa nage ma Jou wo'iili-ili'o'au. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Hababu, naga ma regu o nyawa 'ayo modo'awa, mangale ayomaboanohi ena o geenau. Ma regu ayomodo'awa mangale o nyawa yo'idiai. De ma reguoli ona mahirete ayoolu'u yomodo'a, mangale yomau wile-leani ma Jou'a. Nagonau yoma-mangariti ma ade-ade neena, mada'au la yoma-mangariti.&gt;&gt;<verse eid="MAT 19:12" /></para>
  <para style="s">O Yesus wo'ihibara'ati o ngoa-ngoa'a</para>
  <para style="r">(Mrk. 10:13-16; Luk. 18:15-17)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Geena'a de o nyawa yo'iaha o ngoa-ngoa'a ma ete'e o Yesusi'a, la Awi giama wo'idatami manga hae'ie, de wo'idahaubayanga. Ma awi ni-nii'i yo'i ngamo ma nyawa-nyawa goona. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Ma o Yesus wotemo ona'a, &lt;&lt;Ni'i mada'a o ngoa-ngoa'a yo'aino Ngoino! Uwa ni'itaaele, hababu, o no-noonau ma nyawa geena yodadi ma Jou awi umata.&gt;&gt;<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />Geena'a de o Yesus wodonoa awi giama manga hae'ie de wo'ihibara'ati. Geena'a de Una wotagi.<verse eid="MAT 19:15" /></para>
  <para style="s">O nyawa wo'aya-'aya</para>
  <para style="r">(Mrk. 10:17-31; Luk. 18:18-30)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />O wange moi'u, o nyawa womatengo wo'aino o Yesusino, de wotemo, &lt;&lt;O haala yaowa-owa itoto'iau tadiai la tama'e o wowango 'ahiado-adoni'a?&gt;&gt;<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />O Yesus wopaluhu, &lt;&lt;Idodoau ho nohano Ngoino, o 'iau yaowa-owa? Duga 'amoio'a yaowa-owa. Na'o ngona nomau nowango, ngona halingou nodinii'i moi-moi ma Jou awi pa-pareta.&gt;&gt;<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Ma nyawa guuna wohanoli, &lt;&lt;Ia'aena geena ma pareta.&gt;&gt; O Yesus wopaluhu, &lt;&lt;Uwa notooma, uwa nohowono, uwa notohi'i, uwa nodadi o ha'ihi ma ngelu-ngelu'u, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />no'ihoromati ani eha de ani dea; de no'idora nimahinyawa-nyawa'a, harage nadora to ngona ani roehe ma hirete.&gt;&gt;<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Ma nyawa ma goo guuna wotemo o Yesusi'a, &lt;&lt;Moi-moi geena tadiao'au, ho o iahi ma 'uranga?&gt;&gt;<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />O Yesus wotemo una'a, &lt;&lt;Na'o nomau notiai, notagi nawu'unu moi-moi ani arata. Ma pipi no'i'ula o nyawa yohu-huha'a, la ngona aha nama'e o arata o horoga'a, geena iduangino na'aino de noinii'i Ngoi!&gt;&gt;<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Wa'utu una woihene o Yesus awi demo-demo o geena, una wotagi de awi hininga ma huha, hababu una duru wo'aya.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Geena'a de o Yesus wotemo awi ni-nii'i'a, &lt;&lt;Tinitemoe, duru 'ao huha o nyawa yo'aya-'aya yoohama ma Jou awi pareta'a. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Tohigalioli tinitemo ngini'a, Iholoi igapanga o unta iohama o huhumu ma pidahi'a, na'o o nyawa yo'aya yoohama ma Jou awi pareta'a.&gt;&gt;<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Wa'utu awi ni-nii'i yoihene o Yesus womaade-ade o geena, ona duru yoheranga, ho ona yotemo, &lt;&lt;Na'o 'ogeena nagonau aha yohalamata?&gt;&gt;<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />O Yesus wo'ida-dananoho de wotemo, &lt;&lt;Na'o 'ao nyawa'au, maraio'au adadiwa! Ma mana'o ma Jou o'iauhona maraio'au idadi.&gt;&gt;<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Geena'a de o Petrus wotemo, &lt;&lt;Nimitaila'o, ngomi moi-moi mia mada'au, la niminii'i Ngona'a Aba. Ho o 'iau aha mia ma'e?&gt;&gt;<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />O Yesus wotemo ona'a, &lt;&lt;Nio nga'u: Wa'utu o dunia ma hungi idadioli, o Nyawa ma Ngoa'a aha wodogogele o 'oana ma go-gogele ibe-berehi. Wa'utu geena ngini 'ai ni-nii'i aha nio o go-gogele mogio'o de modidi, de nia pareta o Israel ma bangiha mogio'o de modidi! <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />De nagonau yamada'au manga woa, manga riadodoto o ngewe'a e'ola o naulu, e'ola manga eha de manga dea, manga ngoa-ngoa'a, e'ola manga baili, ma nyawa goona aha yama'e ilio, muna ilape o ratuhu moi'a. De ona aha yama'e o wowango 'ahiado-adoni'a. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />O nyawa manga lepe o oraha neena yobaraguna aha ayobaragunawau, de o nyawa 'ayobaragunawa aha yobaraguna.&gt;&gt;<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">O Hi'atero mangale yo'a-'arajaanga o angguru ma bailo'a</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />&lt;&lt;Na'o ma Jou ma Dutu wopareta, geena harage 'ao hi'atero neena: Womatengo o angguru ma baili ma dutu, wohupu wode-dewelah la wo'ihali'i o nyawa la yo'a'arajaanga awi angguru ma bailo'a. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Wa'utu, yoma'aputuho'au de o nyawa yo'a-'arajaanga goona mangale manga hewa, o wange moi manga hewa o nyawa moi o tiwi o hala'a o ngodumu moi, geena'a de wo'ihulo'o yo'arajaanga awi bailo'a. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />O dedewelano o da-da'o hiwo una wotagioli, de wo'ima'e'a o paharo'a yamuluo naga o iwa manga 'arajaanga yogogelu'u geena'a. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Una wotemo ona'a, &lt;E niotagi 'ai baili'a de nio'arajaanga, ngoi aha tini hewa de o hewa ipahi.&gt; <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Ona ma yotagi. O wange i'orona o da-da'o mogio'o de modidi'u, de o wange i'umulu'ou ipahi o dada'o hange'u, una wohupuoli de wodiai 'aima tero de 'aano ge. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Ho poeluadone o boboha motoa o wange i'umulu'u, una wohupuoli de wo'ima'eli o nyawa de maena'ahi o iwa manga 'arajaanga. Ho una wo'ihano ona'a, &lt;Dodoau ho o wange moi 'animadadawaga, de 'anioolu'u nio'arajaanga?&gt; <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Ma nyawa goona yopaluhu, &lt;Amoiwa mi'ula o arajaanga.&gt; Ma baili ma dutu wotemo, &lt;Na'o o geena, nio tagi 'ai angguru ma baili'a de nio 'arajaanga do'a.&gt;<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Wa'utu italuhou, ma baili ma dutu guuna wotemo awi mandori'a, &lt;Notagi no'iaho'o moi-moi yo'a-'arajaanga, de nohangu moi-moi manga hewa ona'a, yoohama yotu-tuuluo'a de naino hitigi yoohama yohila-hila'a.&gt; <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Geena'a de yo'a'arajaanga ge yo'arajanga poelua o boboha motoa o wange i'umulu'u yoohama yoboa. Ona moi-moi yadawongo manga hewa o pipi o hala'a o ngodumu moi. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Geena'a de yoboa ge o dedewelano yoohama yo'arajaanga. Manga hininga'a yotemo bali ona manga hewa<note caller="-" style="x"><char style="xo" closed="false">20.10 </char><char style="xt" closed="false" /></note> iholoi. Ena momongo ona ma 'a o hala'a o ngodumu moio'a. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Wa'utu ona yadawongo manga hewa geena, ona yotaiayana ma baili ma dutu'a. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Yotemo &lt;Yotutuulu yoohama yo'arajaanga 'a o da-da'o moi. Ma na'o ngomi, o wange moi mia pahi, o wange ma midahau'u'u. De na'o tuanga nohangu aimatero ona dede ngomi!&gt; <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Ma ma bailima dutu guuna wotemo, nage yo'a'arajaanga womatengo'a, &lt;E manai, ngoi atahalawa ngini'a, 'aano ge poma'aputuho'au ma nia hewa, o wange moi o hala'a o ngodumu moi. <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Ho naeheu nedo'a ani hewa, la notagiou. Ngoi ma to'i'ulahi manga hewa ge yotu-tuulu yoohama yo'arajaanga 'ai ma tero de to ngona, nage toni 'ula-'ula ngona'a. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Bote tongoi 'ai pipi de 'aidadiwa todiai imote'e to ngoi 'ai hininga ma mau? Bolo 'ano bu'u, hababu ngoi 'ai hininga yaowa?&gt; &gt;&gt;<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />O Yesus wotemoli ona'a, &lt;&lt;O geenali de o nyawa ayobabaragunawa o oraha neena, aha yobaraguna, de o nyawa yoba-baraguna o oraha neena, aha ayobaragunawau.&gt;&gt;<verse eid="MAT 20:16" /></para>
  <para style="s">O Yesus wohingahu wohidigali ma haange'a mangale wohonenge</para>
  <para style="r">(Mrk. 10:32-34; Luk. 18:31-34)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Wa'utu o Yesus de awi ni-nii'i manga dodagi ma hidogorona'a, manga dumutu o Yerusalemie, Una wo'iaho'o la yomatinga'a ma dudube, de Una wotemo ona'a. <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />&lt;&lt;Nioihene e! O oraha neena ngone nanga dumutu o Yerusalemie, ido'a o Nyawa ma Ngoa'a aha wihigiama ma hoata, o imam-imam ma hae-hae'e de o agama'a yodoto-doto'o. Geena'a de Una wihu'umu hitigi wohonenge. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />De ona aha wihigiama ma hoata 'a o Yahudi ma nyawa'awa. Ona wihohedu, ona wihangihara, ona wisalipi. Ma 'ao wange haange ena womomi'o'au.&gt;&gt;<verse eid="MAT 20:19" /></para>
  <para style="s">O Yakobus de o Yohanes manga eha ami ga-gaaho'o</para>
  <para style="r">(Mrk. 10:35-45)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Geena'a de o Zebedus ma we'ata de ami ngoa-ngoa'a yo'aino o Yesusino. Muna ma tilabu'u'u o Yesus awi biono'a de mogaaho'o o 'iani moi.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />O Yesus wohano muna'a, &lt;&lt;E bilanga o 'iau nogaaho'o?&gt;&gt;</para>
  <para style="p" vid="MAT 20:21">Muna mopaluhu, &lt;&lt;Ngoi tomau 'ai ngoa'a noona yamidi yogogele, womatengo Ani gubalio'a, de wotengo Ani guida'o'a, Na'o ma duulu'a nodadio'au o oana.&gt;&gt;<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Ma o Yesus wopaluhu wotemo, &lt;&lt;Ngini ania na'owa o 'iau nio nagaaho'o. Ngoi neena aha 'ao lepe toahana o hangihara. Bote 'ania au'unu nia mo'u o hangihara harage tamo'u-mo'u?&gt;&gt;</para>
  <para style="p" vid="MAT 20:22">Ona yopaluhu, &lt;&lt;Amia mo'uo'a!&gt;&gt;<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />O Yesus wopaluhu, &lt;&lt;Itiaio'au ngini ania mo'uo'a. Duga mangale nagonau yogogele 'ai gubalio'a de 'ai guida'o'a, geena 'a Ngoiwa taputuhu. Ma diingi geena ato nyawa-nyawa nage 'ai Aba wohita-tapuo'au.&gt;&gt;<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Wa'utu awi ni-nii'i ge ma reguohi yomogio'o, yoihene manga gaaho'o goona yaamididi, ona duru yo'ingamo o riado-doti'a ge. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Mangale geenau ho o Yesus wo'iaho'ino ona moi-moi, de wotemo, &lt;&lt;Ngini halingou nia na'o, o ba-bangiha manga balu-baluhu nage awi na'o-na'owa ma Jou ika de yo'i pareta o awaha de ma ga-gangamo'a, o genali de manga nyawa yola-laagomo ika de yo'ihangihara o'awaha. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Ma ngini! 'Ai dadiwa o geena. Ho nagonau neena'a naga nginio'a yomau iholoi yoamo'o, halingou yodadi 'ania gilaongo. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />De nagonahi neena'a naga nginio'a yomau iholoi yo'a'ulie, halingou yodadi 'ania gilaongo. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Geena harage 'a o Nyawa ma Ngoa'a Una woboa o duniano neena mangale 'apole-leaniwa, ma duga 'awole-leani de wo'ula awi roehe wo'ula la watuuhu moi-moi o nyawa manga baradoha.&gt;&gt;<verse eid="MAT 20:28" /></para>
  <para style="s">O Yesus wo'ihitogumu manga la'o yamididi yopilo-pilo'o</para>
  <para style="r">(Mrk. 10:46-52; Luk. 18:35-43)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Wa'utu o Yesus de awi ni-nii'i yamada o Yerikho ma bendara, o nyawa manga lepe yo'inii'i ona'a. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Wa'utu geena o nyawa yamididi yopilo-pilo'o yogogelu'u o nge'omo ma date'o'a, geena'a de goona ma nyawa yamididi yoihene na'o o Yesus geenano waboa, ho ona yomaorehe, &lt;&lt;Aba ma 'oana o Dautu awi guti'u, tanu nimidora!&gt;&gt;<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Ma o nyawa yolepe-lepe geena ge yo'i ngamo de yo'ihulo'o yomalili. Ma ona 'age'au yomaorehe ya'ua-'uatie, &lt;&lt;Aba ma 'oana o Dautu awi guti'u, tanu nimidora!&gt;&gt;<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Geena'a de o Yesus womatogumu de wo'iaho'o goona ma nyawa yopilo-pilo'o yamididi, de wo'ihano ona'a, &lt;&lt;Niomau tinidodoau ngini'a?&gt;&gt;<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Ona yopaluhu, &lt;&lt;Tuanga ngomi mio mau mimahima'e.&gt;&gt;<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Geena'a de o Yesus duru wo'idora ona'a ho o Yesus wananauhu manga la'o. Ho 'ageena ena yomahima'e'au. Iduangino geena, ona winii'i o Yesusi'a.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">O nyawa manga lepe widawongo de wipuji o Yesus wa'utu woohama o Yerusalem ma bendari'a</para>
  <para style="r">(Mrk. 11:1-11; Luk. 19:28-40; Yoh. 12:12-19)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Wa'utu o Yesus de awi ni-nii'i yomahiadonou o Yerusalem ma bendari'a, ona yaadono o Betfage ma hoani'a o Saitun ma de'uo'a. Geena'a de o Yesus wo'ihulo'o awi ni-nii'i yamididi la yotagi yohila. <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />De wobehehongo onane: &lt;&lt;Niotagi o hoana ge nia bioni'a. Do'a aha nia ma'e o 'eledei moi ma bede'a ihili'o'a de ma ngoa'o'a. Nia hohe ma lili'o de niaahano modidihona Ngoino. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />De na'o o nyawa nitaaele, niotemo 'onane, &lt;Ma Jou waparalu.&gt; Geena de aha ma nyawa guuna wohigumada nia aha ma 'eledei geena. 'Aitaaowa de wohigilio'au.&gt;&gt;<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Moi-moi ma haala geena idadi la harage de o'iau o nabi-nabi ihingahu'o'au:<verse eid="MAT 21:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="MAT 21:5" />&lt;&lt;Nihingahu o Sion ma nyawa-nyawa'a, nia 'oana naga niwidoboa.</para>
  <para style="q2" vid="MAT 21:5">Una awi hininga 'itipo'o'u de wobalenu'u o 'eledei'u, o 'eledei ma ngoa'a moi ma goo'a.&gt;&gt;<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Geena'a de awi ni-nii'i yamididi goona ya'ai'a, de yadiai harage 'ao Yesus awi behehongo. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Geena'a de ona yaaha ma 'eledei ma eha de ma ngoa'a. Geena'a de manga baju i'a'a'ulu'u yohinao ma 'eledei ma poretiha. De aha o Yesus wobalene ma 'eledei de geena. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Manga lepehi o nyawa yohinao manga baju i'a'a'ulu'u o nge'omiha, de ma regu yoehe o gota ma jaga-jaga de yodonoa o nge'omiha. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />O nyawa manga lepe yomadagi awi bioniha de awi duduniha, yomaore-orehe, &lt;&lt;Powi puji Una'a, nage ma 'oana o Dautu awi guti'u! Powi puji nage ma Jou ma Dutu wihulo'oau woboa! Powi puji ma Jou ma Dutu ge awi ngii i'a-'a'ulie!&gt;&gt;<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Wa'utu o Yesus woohamou o Yerusalem ma bendari'a, ma Bendara geena irua, ho ma nyawa-nyawa geena ge yoma'ahano, &lt;&lt;Nuuna naguunau?&gt;&gt;<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Geena'a de o nyawa yolepe-lepe ge wini-nii'i yopaluhu, &lt;&lt;Una geena o Yesus, o nabi ge o Nasaretino, o Galilea ma daera'a.&gt;&gt;<verse eid="MAT 21:11" /></para>
  <para style="s">O Yesus woohama ma Jou ma Dutu awi woa'a</para>
  <para style="r">(Mrk. 11:15-19; Luk. 19:45-48; Yoh. 2:13-22)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Geena'a de o Yesus woohama ma Jou ma Dutu awi woa ma bibini'a, de wo'iginii'i moi-moi yomawu'u-wu'unu geena'a. Una wapaga leoto, o tiwi ihiali-aliti manga ama'a, de o namo dara yowu'u-wu'unu manga go-gogele. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />De Una wotemo ona'a, &lt;&lt;O Bo'u 'Ibe-berehi ma doda'u itulihu'u'au, ma Jou ma Dutu wotemo, &lt;'ai woa geena o haubayanga ma dingii.&gt; Ma ngini niadiai harage o yoora-ora ma dingii!&gt;&gt;<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Geena'a de o nyawa yoli-pilo'o, de yopa-paluga yoboa o Yesusi'a ma Jou ma Dutu awi woano, ho o Yesus wo'ihiai'i. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ma wa'utu o imam ma hae-hae'e de o agama'a yodoto-doto yama'e o Yesus wodiai o haala ihera-heranga geena de duru yongamo Una'a. De ona 'age'au yongamo wa'utu yoihene o ngoa-ngoa'a yomaore-orehe ma Jou ma Dutu awi woa'a, &lt;&lt;Powi puji Una nage ma oana o Dautu awi gutino!&gt;&gt;<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Ona yotemo o Yesusi'a, &lt;&lt;Ngona noihene? O 'iau naga yotemo?&gt;&gt;</para>
  <para style="p" vid="MAT 21:16">O Yesus wopaluhu, &lt;&lt;Iolo, toihe-ihene, Marai niabaca'au o Bo'u Ibe-berehii'u itemo onane: &lt;'A o ngoa-ngoa'ohi de 'ao ngoa'a ma giauohi ena ma Jou wo'idoto'o'au la ona wipuji Una'a?&gt; &gt;&gt;<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Geena'a de Una wamada ma bendara geena, de wotagi o Betania'a de womatuwutu geena'a.<verse eid="MAT 21:17" /></para>
  <para style="s">O Yesus wohilolai o ara ma gota</para>
  <para style="r">(Mrk. 11:12-14, 20-24)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Ma dewela o dedewelano, o Yesus woma'ilioli o Yerusalemi'a, o nge'omo ma goronano Una wamoa wihawini. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />O nge'omo ma date'o'a geena Una wama'e o ara ma gota o utu moi. Geena'a de Una wa'ai'a ma gota'a geena, ma ma howo'o 'amoio ma 'oiwa duga ama ho'a imare-ree'a. Geena'a de o Yesus wotemo ma gota'a geena, &lt;&lt;O oraha neena de imahi'ai'a ngona ano howo'uau 'ahiado-adoni'a!&gt;&gt; 'Ageena ena ma gota geena i'toolengo'au.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Wa'utu o Yesus awi ni-nii'i yama'e geena moi-moi, ona duru yoheranga, de yohano Una'a &lt;&lt;Woolo icara'iau ho 'ai todo'anino ma gota geena itoolengo'au?&gt;&gt;<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />O Yesus wopaluhu, &lt;&lt;Igoungu, na'o ngini igou-goungu nio nga'u, de ania hininga uwa itawa-iatawara, ngini 'ania dadi nio diai harage o 'iau tadiaio'au o gota'a geena. De 'ageenawa bato, ma ngini ma, ngaro 'ania temo o de'u'a neena, &lt;Nomaapu'u de nomahibaiti o gahi'u!&gt; Marai geena aha idadi.&gt;&gt; <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />O 'iau hona nio gaaho'o nia haubayanga ma doda'a, maraio'au nia dawongo, itigoo'o nio nga'u.<verse eid="MAT 21:22" /></para>
  <para style="s">O Yahudio'a yo'ihi balu-baluhu yodahano o Yesus awi 'uaha</para>
  <para style="r">(Mrk. 11:27-33; Luk. 20:1-8)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Ho de o Yesus Womahiadoni'a o Yerusalemi'a, Una woohama ma Jou ma Dutu awi woa'a de wo'idoto'o o nyawa-nyawa'a, wa'utu Una wodoto ma gigiria'a, geena'a de o imam ma hae-hae'e, de o Yahudio'a manga balu-baluhu yoboa de yo'ai'a o Yesusi'a, de yohano Una'a, &lt;&lt;De to nagonau manga 'uaha, ho nodiai moi-moi neena? De nagonau ni'ula o 'uaha ngona'a?&gt;&gt;<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />O Yesus wopaluhu, &lt;&lt;Ngoi ma tinihano ngini'a. Ho na'o niopaluhu, geena'a de aha Ngoi ma tatehongo ngini'a, de to nagonau manga 'uaha moi-moi to diai ma haala neena. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Ianou womadama'e o 'uaha o Yohanes woohi-ohi, la wo'iohi'i o nyawa ma Jou ma Dutuno e'ola o nyawano?&gt;&gt; Geena'a de o imam ma hae-hae'e yoma'adibanga, de yotemo, &lt;&lt;Na'o ngone potemo, &lt;De to ma Jou awi 'uaha,&gt; Ma ube Una wotemo, &lt;Na'o o geena idodoau ho 'anio nga'uwa?&gt;<verse eid="MAT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 21:26" />Ma na'o potemo, &lt;De o nyawa manga 'uaha&gt; Ngone po'idomodongo o nyawa yolepe-lepe'a, hababu bali ona yotemo o Yohanes geena o nabi moi.&gt;&gt; <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Ho ona yopaluhu, &lt;&lt;Ngomi 'amia na'owa.&gt;&gt;</para>
  <para style="p" vid="MAT 21:27">Geena'a de o Yesus wotemo ona'a, &lt;&lt;Na'o o geena Ngoi ma 'atehongua ngini'a, nagonau i'ula o 'uaha, ho tadiai moi-moi geena.&gt;&gt;<verse eid="MAT 21:27" /></para>
  <para style="s">O Hi'atero mangale o ngoa'a yamididi</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Geena'a de o Yesus wotemo, &lt;&lt;Cara'iau na'o imote'e ngini niata'ihiri: Naga womatengo awi ngoa'a o naulu yamididio'a. Wa'ai'a awi ngoa'i'a o lia'a wotemo, &lt;Ngoa'a notagi no'arajaanga 'ai anggur ma bailo'a neena ma wange.&gt; <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />O ngoa'a guuna wopaluhu, &lt;'atoolu'u aba&gt;, ma ipaha de awi di-dibanga 'ingali, ho wotagi o anggur ma baili'a. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Geena'a de wo'ai'ali awi ngoa'a o dodoti'a wotemo harage de 'ogeenali. O ngoa'a guuna wopaluhu, &lt;'Iyolo Aba,&gt; ma 'awotagiwa. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />O ngoa'a yamididi noona, nagoonau yodomote'e ma dea awi mau?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">O imam ma hae-hae'e de o Yahudio'a manga balu-baluhu yopaluhu, &lt;&lt;O ngoa'a o lia'a.&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Ho o Yesus wotemo, &lt;&lt;Ngoi tinitemo e, o balahiteenge yoga-gaaho'o de o nge-ngewe'a ihila yodadi ma Jou ma Dutu awi 'awaha de ngini neena ge.<verse eid="MAT 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 21:32" />Hababu o Yohanes woohi-ohi'i woboa, una wohimaiti o wowango nage imote'e ma Jou ma Dutu awi mau, ma awi do-doto'o 'anionga'uwa. Ma o balahiteenge yoga-gaaho'o de o nge-ngewe'a yohuda-hudala, ona yonga'u ma Jou'a. De ngini ngaro niama'e'au geena moi-moi geena ma niomangaliwa de nioolu'u nionga'u ma jou'a.&gt;&gt;<verse eid="MAT 21:32" /></para>
  <para style="s">O hi'atero mangale o nyawa yo'a-'arajaanga o angguru ma bailo'a</para>
  <para style="r">(Mrk. 12:1-12; Luk. 20:9-19)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />O Yesus wotemoli, &lt;&lt;Bee'a nioihene o hi'atero moioli neena. Womatengo o baili ma dutu awi angguru wotudu'u. Una wapagara wohiba'itino, de wopaiti o guhu nage o angguru yoteo-teo ma ngii, geena'a de wohigo'o yogoa-goana manga woa 'i'a-'a'ulie. Iduangino geena una wohihewa ma awi angguru ma baili geena, de wotagi o daera ma homoa'a. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Wa'utu yaadono'au ma oraha o angguru ma howo'o yotowi, ma baili ma dutu guuna wo'ihidingoto awi gi-gilaongo, ma baili yo'a'arajaangi'a, la waehe awi do'u. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Ma yo'a'arajaanga ge o bailo'a geena yo'itago'o, ma baili ma dutu awi gi-gilaongo: Womatengo wipoha, maregu yo'itooma, de mareguoli yo'iheleo. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Ma baili ma dutu guuna wo'ihidingotoli awi gi-gilaongo ma reguoli, de iholoiohi yolepe de yodi-dihila'a. Ma ona yo'idiai aimatero de yodi-dihila'a. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Ma baha'u ma baili ma dutu guuna wihidingoto awi ngoa'a ma hirete, watibangu'u, &lt;Maraio'au, 'ai ngoa'a ho wihoromati,&gt; <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Ma wa'utu yo'a-'arajaanga ma bailio'a geena wima'e ma baili ma dutu awi ngoa'a, ona yoma'atemo moi de moi, yotemo, &lt;Ee, nuunau o puha'a ma dutu. Niaino ngone powitooma, la ngone pama'e awi o puha'a!&gt; <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Geena'a de ma ngoa'a guuna witago'o de wiumo o baili ma duduni'a de witooma.&gt;&gt;<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />O Yesus wohano o Yahudio'a manga agama ma balu-baluhu, &lt;&lt;Ho, na'o ma baili ma dutu guuna woliono, icara'iau done aha wo'idiai nage yo'a'arajaangi'a goona?&gt;&gt;<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Ona yopaluhu, &lt;&lt;Maraio'au aha wo'itooma ma nyawa yoti-tingi'ai goona, de aha wohihewali ma awi angguru ma baili geena, nage ma do'u yo'ula ma oraha yaadanono de.&gt;&gt;<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Ho o Yesus wotemo ona'a, &lt;&lt;Marai niabaca'au, nage o bo'u ma doda'u itulihu'u'au,</para>
  <para style="q1" vid="MAT 21:42">&lt;O heleo nage ayapa'e-pa'ewa o woa yodi-diai,</para>
  <para style="q2" vid="MAT 21:42">Idadi ma ba-bangini ma guata.</para>
  <para style="q1" vid="MAT 21:42">Neena ma Jou wodiai;</para>
  <para style="q2" vid="MAT 21:42">Duru 'a o rahai!&gt; &gt;&gt;<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />O Yesus wotemoli ona'a, &lt;&lt;Ho nia ngano-nganono, moi-moi o haaka nage naga nginio'a ma Jou ma Dutu aha waeheu geena, de wo'i'ula o nyawa'a ge yadi-diai awi pareta. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />[O nyawa nage yoota'a ma heleo'u geena, aha yowedele; de o nyawa ge yo'itapadu ma heleo geena, aha yo'idululu hitigi iholoioli yowedele.]&gt;&gt;<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Wa'utu o imam ma hae-hae'e de o Farisio'a yoihene ma hi'atero geena, ona yomana'o awi demo geena ma dumutu ona'a. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Ho ona yohidaila'o la witago'o o Yesusi'a. Ma ona yo'idomodongo o nyawa yolepe-lepe'a, hababu o nyawa-nyawa yotemo o Yesus geena o nabi moi.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">O hi'atero mangale o modo'a ma rame</para>
  <para style="r">(Luk. 14:15-24)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />O Yesus womaade-adeli ona'a de o hi'atero, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />wotemo, &lt;&lt;Ma Jou ma Dutu awi pareta geena ma jarita harage 'ao hi'atero neena: Ma 'oana womatengo wodiai awi ngoa'a o naulu, awi modo'a ma rame. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Ma 'oana guuna wohulo'o awi gi-gilaongi'a, la yotagi yo'ihobo'o o nyawa-nyawa nage yo'iaho-aho'o o rame'a geena. Ma ma nyawa-nyawa goona ayoolu'u ya'aino. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Ni'ihingahu'a ma nyawa-nyawa'a goona, &lt;Na'o o inomo ma rame mihidiai'u'au. 'Ai hapi de ma ngoa-ngoa'a ge ya owa-owa mia toa'o'au. Moi-moi mihidiai'u'au ho nio'ainou ma modo'a ma rame'a!&gt; <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Ma nyawa-nyawa nage yo'iaho-aho'o goona ayodaali'awa. Ona moi-moi yoboritagio'au manga baili'a yo'arajaanga, ma regu yomawu'uno'au; <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Ma reguoli yo'itago'o ma 'oana awi gi-gilaongo goona de yo'ipoha de yo'itooma. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Wa'utu ma 'oana woihene ma haala geena, una duru wongamo. Ho wo'ihulo awi hu-hurudado'a yotagi la yo'itooma ge yoto-tooma goona de manga bendara yatuu'u. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Geena iduangino, ma 'oana wohulo'o la yo'iaho'o awi gi-gilaongo ma reguoli, de wotemo ona'a, &lt;O modo'a ma rame ihidiai'u'au, ma o nyawa-nyawa ge toi'aho-aho'o, ayadaenua yoohama 'ai modo'a ma rame'a. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Ho o oraha neena, nio tagi o tapa'i'a, la ni'iaho'o o nyawa ni'ilepe-lepeno o modo'a ma rameno neena.&gt; <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Geena'a de awi gi-gilango goona ma yotagi. Ona yotagi o tapa'i'a, de yo'ilomu nagonau hona yo'ma'ama'e, o nyawa ma owa de o nyawa manga hininga iti-tiiha. Hiadono o modo'a ma rame ma dingii geena yaomanga.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Geena'a de ma 'oana woohama o dingii nage o modo'a ma rame'a mangale woma'ama'e de awi nyawa-nyawa. Geena'a una wima'e womatengo awi baju 'una awomahinoawa o rame ma baju. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Ho ma 'oana wihano una'a, &lt;Ee manai, idodoau ho noohama neenano de anomahino'uwa o rame ma baju?&gt; Ma ma nyawa guuna awomalii-liilo'a. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Geena'a de ma 'oana wotemo awi gi-gilaongi'a, &lt;Nia li'o ma nyawa nuuna awi giama de awi dou, de niwiumo ma duduni'a o ngii italu-taluhi'a. Geena'au do'a o gali de o hangihara.&gt; &gt;&gt;<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Geena'a de o Yesus awi jarita wohibobaha, de wotemo 'onane, &lt;&lt;Manga lepe ma Jou ma Dutu wo'iaho'o, ma ayo lepewa wo'iili'i.&gt;&gt;<verse eid="MAT 22:14" /></para>
  <para style="s">Mangale o balahiteenge</para>
  <para style="r">(Mrk. 12:13-17; Luk. 20:20-26)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Ma moi geena o Farisio'a yotagi yomaaturu, mangale icara'iau widaa'ala o Yesus de manga ha-hano. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Ho ona yo'ihulo'o manga ni-nii'i de o Herodes awi ni-nii'i yamuluo naga, la yotagi o Yesusi'a, la yotemo 'onane. &lt;&lt;Aba guru, ngomi miana'o Ngona geena notiai. Ngona nodoto'o nohito-tongotino, mangale ma Jou awi mau o nyawano, amoiwa manga di-dibanga nodinii'i hababu Ngona 'ano'idomodongua nagoona'au ngaro. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Mangale genau ho; Bee'a nimihingahu ngomino, imote'e nanga agama ma autoranga, bote 'aidadi mio hangu o balahiteenge ma kaisari'a, bolo 'ai daiwa?&gt;&gt;<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />O Yesus wana'o manga ma'uhuutu ma diiha geena, ho Una wotemo, &lt;&lt;Ee ngelu-ngelu'u! Dodoau ho nio mau nitaili? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Bee'a nihimaitino nia tiwi, ge nihi hangu-hangu o balahiteenge!&gt;&gt; Geena'a de ona yo'ula Una'a, o tiwi o hala'a o ngodumu moi.<verse eid="MAT 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 22:20" />O Yesus wohano ona'a, &lt;&lt;Tonagonau manga dulada de manga ronga neena?&gt;&gt;<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Ona yopaluhu, &lt;&lt;To ma kaisar.&gt;&gt;</para>
  <para style="p" vid="MAT 22:21">Ho o Yesus wotemo ona'a, &lt;&lt;Na'o o geena, nio'ula ma Kaisar o 'iau nage to una, de ma Jou ma Dutu'a o 'iau nage toma Jou ma Dutu.&gt;&gt;<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Wa'utu ona yoihene o Yesus awi demo geena, ona duru yoheranga. Ho geena'a de ona yotagi wimada o Yesus.<verse eid="MAT 22:22" /></para>
  <para style="s">Mangale yohone-honenge yowangoli</para>
  <para style="r">(Mrk. 12:18-27; Luk. 20:27-40)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />'ageena ma wange ena, o Sadukio'a ma nyawa yamuluo naga yoboa o Yesusino. Ona goona manga do-doto'o, bali na'o o nyawa yohonengo'au geena ayomomi'uau. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Ona yotemo, &lt;&lt;Aba guru, o Musa wodoto'o 'onane: Na'o o naulu womatengo womodo'a'au de wohonenge awi ngoa'a 'a'o iwahi, geena halingou awi dodoto mimodo'a, wohone-honenge awi bao gumuna, la wohone-honenge ma awi guti'u de ma ena. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Ma hila imadadio'au ngomio'a yatumudingo'a yoriadodoto. Ma lia'a womodo'a, de wohonenge awi ngoa'a 'a'o iwahi. Geena halingou awi bao gumuna widamada awi dodotu'u. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Ma ma dodotoli guuna wohonenge awi ngoa'a o iwahi. Aimatero idadi awi dodotu'oli yahaange, hitigi yatumudingihona ona ma manga ngoa'a 'a'oiwahi de yohonengo'au. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Ma baha'u ma ngewe'a gumuna ma mohonenge. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Ho, wa'utu o nyawa yohone-honenge yomomi'oli, ma ngewe'a gumuna to nagoonau awi we'ata? Hababu yatumudingihona mimodo'a'a.&gt;&gt;<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />O Yesus wopaluhu, &lt;&lt;Ngini duru niahala, hababu ngini animamangaritiiwa o bo'u Ibe-berehi, e'ola ma Jou ma Dutu awi 'uaha. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Hababu na'o o nyawa yohonengo'au aha yomomi'oli, geena 'aidadiwau yomodo'a, hababu ona yowango harage 'ao malai'ata da'u o horoga'a. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Marai ngini niabaca'au, o'iau ma Jou ma Dutu wotemo mangale o nyawa yohone-honengo'au yomomi'oli? Ma Jou wotemo, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />&lt;Ngoi neena ma Jou ma Dutu, nage o Abraham, o Isak, de o Yakub ihuba-huba,&gt; Ma Jou ma Dutu guuna ayohone-honengua manga Jou, ma yowango-wango manga Jou!&gt;&gt;<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Wa'utu ona yoihene o Yesus awi demo geena, ona duru yoheranga de awi dodoto'o geena.<verse eid="MAT 22:33" /></para>
  <para style="s">O hu'umu 'i'a-'a'ulie</para>
  <para style="r">(Mrk. 12:28-34; Luk. 10:25-28)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Wa'utu o Farisio'a ma nyawa-nyawa'a yoihene, na'o Yesus wo'idiao'au o Sadukio'a ma nyawa ayadadiwau yomaade-ade, ho ona yomalomu. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Ho manga agama'a yodoto-doto'o womatengo witaili o Yesusi'a de o ha-hano. <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />Wotemo, &lt;&lt;Aba guru, nanga agama hu'umu, o hu'umu ia'aenahi iholoi 'i'a'ulie?&gt;&gt;<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />O Yesus wopaluhu, &lt;&lt;Nowidora ma Jou ma Dutu'a de ani hininga ma ngodumu, de ani guata, ani a'ala moi-moi. <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Neena o hu'umu i'a-'a'ulie, de iba-baraguna! <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />De o hu'umu ma modidi'a, aimatero de ididihila'a: Ni'idora nimahinyawa-nyawa'a, harage nia dora nia roehe ma hirete. <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Moi-moi o agama ma hu'umu, niwi'ula o Musa, de o nabi-nabi manga dodoto'o, geena moi-moi matiti o hu'umu modidino neena.&gt;&gt;<verse eid="MAT 22:40" /></para>
  <para style="s">Mangale ma 'Oana wohiha-halamata</para>
  <para style="r">(Mrk. 12:35-37; Luk. 20:41-44)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Wa'utu o Farisio'a ma nyawa-nyawa ayomalomunohi geena'a, o Yesus wohano ona'a, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />&lt;&lt;Icara'iau nia ma-ma'e mangale ma 'oana wonahiha-halamata? De Una geena nogoonau manga guti'u?&gt;&gt;</para>
  <para style="p" vid="MAT 22:42">Ona yopaluhu, &lt;&lt;Ma 'oana o Daut awi guti'u.&gt;&gt;<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />O Yesus wohano, &lt;&lt;Na'o o geena, idodoau ho, ngomaha Iofi-ofi widongohami'a, de wotemo ma 'Oana Wohiha-halamata, geena ma &lt;Jou&gt;? Hababu o Daut wotemo,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />&lt;Ma Jou wotemo, 'ai Jou'a,</para>
  <para style="q2" vid="MAT 22:44">Nogogelu'u 'ai guida'o'a</para>
  <para style="q2" vid="MAT 22:44">Hiadono ani ha-haturuu to'idiai yoihene ngona'a.&gt;<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Ho na'o o Daut wotemo, ma 'Oana Wohiha-halamata geena ma Jou, de icara'iau Una geena o Daut awi guti'u?&gt;&gt;<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Amoiwa yadadi wipaluhu o Yesusi'a. De ma wange geena de imahi'ai'a, 'amoiwau yohano o iani Una'a.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Inahinganono la nimahitiari o agama'a yodoto-doto'o de o Farisi'o'a</para>
  <para style="r">(Mrk. 12:38-39; Luk. 11:43, 46, 20:45-46)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Geena'a de o Yesus wo'itemo o nyawa yolepe-lepe'a de awi ni-nii'i'a, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />&lt;&lt;O agama'a yodoto-doto'o de o Farisio'a ma nyawa yo'i'ula o haaka, la ihimangariti o Musa awi hu'umu. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Ho, o iauhona yohulo'o niodinii'i, ma uwa niadiai o 'iau yadiai, hababu ona yodinii'ua o'iau nage yohidoto-doto'o. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Ona ihigegoto o haala ihu-huha, de o autoranga itu-tubuho, ena momongo ona mahirete ma, ona 'ayo'iduhunua la onyawa yadiai ma 'autoranga geena. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Moi-moi geena yadiai duga 'ayomau la o nyawa yama'e. Ona yaigo yomahinoa o bo'u 'ibe-berehi ma ngii ma bubuhu'u 'ingoa-ngoata ge manga hae'o'a de manga giamo'a, de manga baju i'a'-a'ulu'u ma renda-renda ya'a-'a'ulu'u! <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Na'o ona yoohama o rame'a de o dodoomu 'ibe-berehi ma woa'a geena ona yaigo yogogele o dingii yaowa-owa'u dina ma bioniha. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Ona yohanaanga na'o o nyawa-nyawa o paharo'a yo'ihoromati ona'a, de yo'iaho'o, &lt;Aba guru&gt;. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Ma ngini, uwa niomode'e niaho'o, &lt;Aba guru&gt;, hababu nia Guru geenala aumatengo'a, de ngini neena moi-moi 'a o riado-doto. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />De o nyawa o dunia'a neena 'amoi ma uwa ni'iaho'o, &lt;Aba&gt;, hababu nia Aba geena duga 'awomatengo'a da'u o horoga'a. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />De ngini ma uwa niomau niaho'o, &lt;Tuanga ma amo'o&gt;, hababu nia tuanga ma amo'o geena, duga awomatengo'a, geenala ma 'Oana nihiha-halamata nage ma Jou ma Dutu wohijajio'au. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />O nyawa nage neena naga iholoi woamo'o nginio'a, geena halingou wodadi o gilaongo ngini'a. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />O nyawa nage yomahiie, geena ma Jou ma Dutu aha wo'ihidaduu'u, de o nyawa nage yomahidaduu'u, aha wo'ihidaduie.&gt;&gt;<verse eid="MAT 23:12" /></para>
  <para style="s">O Yesus wo'ihito-tobioni'a ge yoelu-elu'u</para>
  <para style="r">(Mrk. 12:40; Luk. 11:39-42, 44, 52, 20:47)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />&lt;&lt;Niobodito ngini, o agama'a nio doto-doto'o, de Farisio'a ma nyawa, moi-moi ngini nimaelu-elu'u. Nginiou geena nii'i tato'o nyawa nage yomau yodadi ma Jou awi 'awaha. Ma ngini mahirete anioolu'u nio dadi ma Jou awi 'awaha. De o nyawa ma regu nage ayomede'e ma ngini nii'i tato'o.<verse eid="MAT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14" />[Niobodito o agama'a nio doto-doto'o, de o Fariso'a ma nyawa, ngini nimaelu-elu'u. Ngini ni'idaa'ala o ba-bao de niaora manga woa. De na'o nimadahaubayanga geena nia'a-'a'uli'a la o nyawa nina'o ngini o nyawa ma owa. Geenau ho tingini nia hu'umu aha 'iholoi aha 'itubuho.]<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />Niobodito ngini, o agama'a niodoto-doto'o, de o Farisio'a ma nyawa! Ngini nimaelu-elu'u! Ngini nio'a-'adagi o tona'a de ngooti'a, mangale nio mau wotengo woohama 'ania agama'a, ngini niwidiai ma nyawa guuna aha woohama o naraka'a, nage iholoi itiiha dedengini.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Niobodito ngini o balu-baluhu ge niomau nio'ituda ena momongo 'animahima'ewa! Hababu ngini ni'idoto'o 'onane, &lt;Na'o o nyawa yo'oboto de ma Jou ma Dutu awi Woa, ngaro 'ayodiaiwa ma 'aido-doawa. Ma na'o Yo'oboto de ma Jou ma Dutu awi woa ma gurahi, manga 'oboto geena halingou yadiai.&gt; <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Ngini o nyawa niohuma-huma de niopilo-pilo'o! Ia'a iholoi ibaraguna: O Gurahi bolo ma Jou ma Dutu awi woa nage ihi Ofi ma gurahi geena? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Ngini ma ni'idoto'o onane, &lt;Na'o moi yo'oboto de o hada'a yodu-dutuu'u ma ngii, geena ngaro manga 'oboto 'ayadiaiwa ma 'aido-doawa ma na'o yo'oboto de o hu-huba nage to ena ma ngiio'a, geena halingou yadiai.&gt; <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Ngini duru niopilo'o'au! Ia'a iholoi ibaraguna? O huhuba, bolo o huhuba yodu-dutu'u ma ngii ge Ihiofi ma huhuba geena? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Mangale geenau ho, na'o moi yo'oboto de o huhuba ma ngii yodudutu'u, geena ma mangariti ona yo'oboto'au de o hada'a ma ngii yodudutu'u, de moi-moi o huhuba nage ma ngiio'a geena. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />De na'o moi yo'oboto de ma Jou ma Dutu awi woa, geena ma ona yo'oboto'au de ma Jou ma Dutu, hababu Una womanoa geena'a. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />De na'o moi yo'oboto de o horoga, geena ona yo'oboto'au de ma Jou awi gogogele, de nage ma Jou ma Dutu'a nage wogogelu'u geena'a.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Niobodito ngini o agama'a niodoto-doto'o de o Farisio'a! Ngini nimaelu-elu'u. O rampa-rampa harage o sulasi o adas manisi de jintana ma nio'ula ma do'u mogioo'o ma Jou'a. Ena momongo, o 'iau naga ge 'iholoi ibaraguna o agama ma hhu'umu harage de o adili, o dora de o hingounu 'aniodinii'uwa. Ena geenau iholoi ibaraguna niodinii'i de ma ho-homoahi ma niodinii'i. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Ngini neena niohibalu-baluhu niopilo-pilo'o! O guulu nia a'elo'a geena nia'ayahi, ena momongo o unta aniaahilou.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Niobodito o agama'a nio doto-doto'o, de o Farisio'a ma nyawa! Ngini nima elu-elu'u! Ngini nia wowango harage de nia hawo-hawo, de nia hude-hude ama dudunino niaiho'o niabe-berehi'a, ma ma doda'a duru 'a o beree'e, hababu moi-moi nia ma'e geena, 'a de nia hininga ma diiha de nia dopo'ana. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ee ngini! O Farisio'a ma nyawa nage niopilo-pilo'o, nia berehi'ahi nia hawo-hawo'o de hude-hude ma doda'u, la ma dudunino ma iberehi.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Niobodito ngini o agama'a nio doto-doto'o, de o Farisio'a ma nyawa! Ngini nimaelu-elu'u! Ngini harage 'ao boohu'u nage ma dudunino yaceeto'a ma ceete 'iare-arehe, ho ma duduni'ia pama'e'a ma rahaio'a, ena ma doda'a do'a o 'obongo de o gaaailide duru ibounu. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />O geenali de ngini. O nyawa nima'e'a 'aniaowa, ena nia hininga ma doda'a, geena yaomango'a de o ngelu-ngelu'u de o diiha.<verse eid="MAT 23:28" /></para>
  <para style="s">O Yesus wohingahu mangale o agama'a yodoto-doto'o de o Farisi ma nyawa aha yo'ihu'umu</para>
  <para style="r">(Luk. 11:47-51)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Niobodito ngini o agama'a niodoto-doto'o de o Farisio'a ma nyawa nage nimaelu-elu'u! Ngini niodiai o nabi manga boohu'u de o nyawa ma owa-owa manga tugu mangale ni'ida-danganono. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />De niotemo, &lt;Na'o ho ngomi miowango ma oraha mia edete de mia dotumohi ma hila, tanu ngomi amionii'ua miotooma o nabi-nabi.&gt; <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Ho nginiou mahirete nimahidemo na'o ngini geena o nabi-nabi yo'ito-tooma manga guti'u. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Na'o 'ogeena de ika nihigila-gilade niohitotomi'a o ba-baradoha nage nia edete de nia dotumu yamulaengo'au. <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Ee ngini neena o nyawa ma diiha ge o nyawa ma diiha manga guti'u harage de o ngia 'ibiha-biha. Maraio'au ngini idadiwa nimahilehene o hu'umino nage o naraka'a. <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Hababu geena, ngoi aha to'ihidingoto ngini'a o nabi-nabi de o nyawa yopade-pade de yodoto-doto'o; munu'a aha nio'itooma, de munu'a nio'ihidele o salipo'a, de munu'ali nio'ihangihara o do-doomu ma woa-woa'a, de nio'iginii'i o bendara moio'a de o bendara maregu'a. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Geenau ho, ngini aha nihu'umu hababu ni'itooma o nyawa nage manga hala 'a'oiwa 'imulaenge o Habelo'a, hiadono o Zakharia o Berekhya awi ngoa'a nage niwitooma ma Jou ma Dutu ma hirete awi woa de o hu-huba yodu-dutuu'u ma ngii ma hidogorona'a. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Ngoi tinitemo e,: Ma haala neena moi-moi aha o nyawa-nyawa ma oraha neena naga yamo'u.&gt;&gt;<verse eid="MAT 23:36" /></para>
  <para style="s">O Yesus awi hininga 'ihuha o Yerusalem ma nyawa'a hababu ayoolu'u yoihene Una'a</para>
  <para style="r">(Luk. 13:34-35)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Geena iduangino de o Yesus wotemo, &lt;&lt;Sio o Yerusalem ma nyawa! Ayosio ee! Ngini ni'itooma'au o nabi-nabi! Nio'iheleo nio'ihonengo'a ma Jou ma Dutu awi hu-hulo'o! 'Igi-giliou tomau tiniduhunu harage o namo ma eha, ma ngoa'a yagoanino yaporonu'u, ma ngini nioolu'u! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Hababu geena ma Jou ma Dutu 'a de de nginiwau. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Nioda-danganono e! Neena de 'imahi'ai'a ngini aha 'anima'ewau ngoi. Hiadono niotemo, &lt;Ucehehe! Niwihibara'ati Una ge woboa de ma Jou awi 'uaha!&gt; Aha de nima'eli.&gt;&gt;<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">O Yesus wohidemo mangale ma Jou ma Dutu awi woa aha itoropaha</para>
  <para style="r">(Mrk. 13:1-2; Luk. 21:5-6)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Wa'utu o Yesus wamada ma Jou ma Dutu awi woa, awi ni-nii'i ya'aino de wihidumutu ma Jou ma Dutu awi woa. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />O Yesus wotemo ona'a, &lt;&lt;Niama'e'au, moi-moi geena? Tinitemo e, done 'ao heleo geena moio ma aima'aretenu'uwau ma dingio'a. Moi-moi aha itoropaha.&gt;&gt;<verse eid="MAT 24:2" /></para>
  <para style="s">O huha de o hangihara aha 'iboa</para>
  <para style="r">(Mrk. 13:3-13; Luk. 21:7-19)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Geena'a de o Yesus wotagi wohawu o Saitun ma de'ude, Ho Wogogelu'u geena'a, de awi ni-nii'i ya'ai'a mangale yomau, yoma'aade-ade 'aona'a. Ona yohano, &lt;&lt;Nimihingahunou, muluo'a moi-moi geena imadadi. De 'o'iau ma dudunguu nage Ngona noboali, de o dunia ma baha ma?&gt;&gt;<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />O Yesus wopaluhu, &lt;&lt;Nimahidi-diai, uwa hiadono o nyawa nidaa'ala. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Hababu o nyawa aha manga lepe yoboa de yaaha 'ai ronga, de yotemo, &lt;Ngoiou neena, ma 'Oana o nyawa wohiha-halamata!&gt; Ona geena aha yo'idaa'ala o nyawa'a magilepe la yonii'i ona'a. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Ngini aha niogiihene o paraanga ma ilingi de ma habari, ma uwa niohawana. Hababu moi-moi geena halingou idadi, ma geena ama wa'utuwahi o dunia ma baha. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />O bangiha moi, aha yoma'ahaturu de o bangiha. De o pareta'u moi, aha yoma'ahaturu de o pareta'u. Ia'a o dunia ma amo'ino neena, aha idadi o baulaco de o ohu. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Geena moi-moi aha 'imulaenge, ma hau'u harage 'a o ngewe'a momatengo moma'ualengou.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />Geena'a de ngini ma aha nitago'o, de ngini aha nihigiama ma hoata la nihangihara de nitooma. Moi-moi o nyawa aha nibuhulu, hababu ngini geena, 'ai ni-nii'i. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Ma wa'utu geena o nyawa manga lepe aha ayonga'uwau Ngoino, de yoma'abuhulu moi de moi. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />O nabi-nabi ma ngelu'u manga lepe aha yoboa, de yo'ielu'u o nyawa-nyawa'a. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />O tingi'ai 'ai dogo monga, hiadono o nyawa ayadadiwau yoma'ahayanga. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Ma o nyawa nage tatapu 'Inga'u hiadono ma baha'a, ona geena aha ma Jou ma Dutu wo'ihihalamata. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />De o Habari ma Owa, mangale icara'iau ma Jou ma dutu wopareta, aha ihihabari o dunia'a moi-moi, la moi-moi o nyawa yoihene.&gt;&gt; Geena ipaha de aha o dunia ma baha.<verse eid="MAT 24:14" /></para>
  <para style="s">O Yesus wohingahu nage 'o'iau idadiou o hangihara ma orahu'u</para>
  <para style="r">(Mrk. 13:14-23; Luk. 21:20-24)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />&lt;&lt;Ngini aha niwima'e, &lt;Womatengo nage 'awidomote'uwa ma Jou'a aha wodiai ma Jou ma Dutu awi woa 'a iofiwau&gt;, harage o nabi Daniel watehongo'au, (Nagoonau yabaca neena, niataila'o icara'iau ma mangariti) <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Wa'utu geena, o nyawa-nyawa ge yomanoa-noa o Yudea'a halingou yoloa o de'ude. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />O nyawa nage da'u manga woa ma de'uo'a, uwau youti manga woa ma doda'u mangale manga 'iani yaehe. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />O nyawa nage manga bailo'a yai'a, uwa yoma'ilio yaehe manga baju i'a'a'ulu'u. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />De duru yohangihara ma wange'u geena, nage o nge-ngewe'a yohiaha-aha, de o nge-ngewe'a yongoa'a ma ehano. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Nimadahaubayanga la uwa o beha-beha'a ho o Hiaini ma Wange'u de ngini nioloa! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Ma oraha geena o hangihara aha idadi nage omaiwahi idadi imulaenge o dunia idadi hiadono neena, de aha 'omaiwau idadi. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Na'o ma Jou ma Dutu 'awohitipowa ma oraha, maraio'au 'amoiwau yowango-wangohi. Ma duga Awi 'awaha, ho wohitipo'o ma oraha geena.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />Ma oraha geena na'o moi yotemo ngini'a, &lt;Bee'a niwima'e! Ma 'Oana wohiha-halamata nengo'a bolo geena'a naga&gt;, Uwa nio'inga'u. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Hababu aha demaena yohiha-halamata ma ngelu'u de o nabi-nabi ma ngelu'u. Ona aha yodiai o 'iau hona ge 'abiahawa de o haala 'ihera-heranga mangale yo'ielu'u de poelua ma Jou ma dutu awi 'awaha ma yo'ielu'u. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Ngoi tinihidemo'au 'a ma orahuwahi ma haala geeena idadi, ho nioda-danganono.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />Na'o o nyawa yotemo ngini'a, &lt;Una do'a o tona'a 'i'a-'aha'a,&gt; uwa nia'ai'a. E'ola na'o yotemo, &lt;Una womaiyuni'a nengo'a o ngiio'a,&gt; uwa nionga'u. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Hababu o Nyawa ma Ngoa'a woboa harage 'a o leletongo 'ica-cawi daiiha o wange ma hiwa'a de ma hiwa hiadono o wange ma dumuniha.<verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />'Ia'a naga o 'aewani ma honenge geena'a o wogono 'imalomu.&gt;&gt;<verse eid="MAT 24:28" /></para>
  <para style="s">O Nyawa Ma Ngoa'a awi bo-boa</para>
  <para style="r">(Mrk. 13:24-27; Luk. 21:25-28)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />&lt;&lt;Nage o huha ma oraha ipaha'a, 'aitaaowa de o wange italuhu, o mede 'aihiwawau, o ma-mamanga o diwango'a ma iota'a, de moi-moi da'u o ngawa-ngawa'a i'aruae. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Geena iduangino, aha niama'e o du-dungu o diwango'a mangale o Nyawa ma Ngoa'a woboa. Wa'utu geena moi-moi o nyawa o dunia'a neena aha yo'o'iali. Ona wima'e o nyawa ma Ngoa'a woboa wihaono o 'amo-amo de awi uaha de awi 'umati 'iamo-amo'o. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />De o trompet ma ilingi nage duru iamo-amo'ie yawua'a, de o Nyawa ma Ngoa'a aha wo'ihulo'o awi ma-malai'ata yo'ilomu awi awaha o dunia ma libu'u hoata, o diwanga ma baha'a hiadono o diwanga ma baha'a.&gt;&gt;<verse eid="MAT 24:31" /></para>
  <para style="s">O dodoto'o o ara ma utuno</para>
  <para style="r">(Mrk. 13:28-31; Luk. 21:29-33)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />&lt;&lt;Nimadegehe, de nimadoto'o ara ma utuno, na'o ma jaga-jaga ibo-boo'o de tooli, geena ngini niana'o o ngogoro ma oraha ihorio'au. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />O geenali ma, na'o ngini nima'e o huha de o hangihara nage tinihideno'au moi-moi geena la idadi, geena ngini aha nia na'o o Nyawa ma ngoa'a 'ihorio'au woboa. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Nioihene hididiai! Ma haala geena aha idadi, ge o nyawa ayowango-wangohi o oraha neena, ayobotuahi yohonenge. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />O diwanga de o dunia aha iihanga, ma 'ai demo-demo 'ahiado-adoni'a.&gt;&gt;<verse eid="MAT 24:35" /></para>
  <para style="s">Amoiwa yana'o ma oraha o Nyawa ma Ngoa'a woboali</para>
  <para style="r">(Mrk. 13:32-37; Luk. 17:26-30, 34-36)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />&lt;&lt;Amoiwa yana'o muluo'a ma wange de ma oraha, o ma-malai'ata o horoga'a ma 'ayana'owa, ma Jou ma Dutu awi Ngoa'a ma awana'owa, duga 'a ma Dea wana'o. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Na'o o Nyawa ma Ngoa'a woboa, geena imadadi harage ama hila ma oraha o Nuh. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Nage wa'utu o nguuihi ma amo-amo'o 'ai boawahi, moi-moi yoodomo de yoo'ele, yomodo'a, o geenau aitauria hitigi o Nuh woohama o 'apa'a. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Wa'utu o nguuihi yo'idoboa, geena'a de aha yomatodo'ana o 'iau idadio'au. O geenali de o Nyawa ma Ngoa'a woboa. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Ma oraha geena, na'o o nyawa yamididi manga bailo'a yoarajaanga, womatengo o Nyawa ma Ngoa'a aha wiaha de womatengo wimada'u. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Na'o o ngewe'a yamidi yotutu'i'a o gandumu, momatengo o Nyawa ma Ngoa'a aha miaha, de momatengo mimada'u. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Ho, halingou nimagoa-goana, hababu ngini 'ania na'owa muluo'a nia Jou woboa. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Niangano-nganono neena! Na'o ho o woa ma dutu womatengo wana'o'au, o ta'o muluo o wutu'u de yotohi-tohi'i yoboa, maraio'au aumaiduwa, la yotohi-tohi uwa yodongohama awi woa'a. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Hababu genau ho, ngini ma iani nimagoa-goana. Hababu o Nyawa ma Ngoa'a woboa ma oraha aniana'owa.&gt;&gt;<verse eid="MAT 24:44" /></para>
  <para style="s">O gi-gilango wohi-ngounu de 'a wohingou-ngounuwa</para>
  <para style="r">(Luk. 12:41-48)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />O Yesus wotemoli, &lt;&lt;Na'o o geena, o gilaongo naguunau wohingou-ngounu de wobarija una geena aha awi tuanga wigoa'a la wo'ihidadibaluhu o gilaongo'a ma regu, la wo'ihiodomo na'o ma wa'utu'u. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Duru wohanganga ma gilaongo guuna. Na'o awi tuanga woliono ena una awi arajanga wagoa'a ma gi-giria'a. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Tinitemo e, ma tuanga guuna aha wihigagao moi-moi awi 'arata awi gilaongi'a guuna. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ma na'o o gilaongo awi hininga itiiha, aha awi hininga'a wotemo, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />&lt;'ai tuanga ma daaohi aha wolio,&gt; Geena'a de una wo'ipoha o gi-gilaong ma regu'a, de yomahidoodomo de yomahidoo'ele de o nyawa yomaeto-eto. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Geena'a de awi tuanga wolio ma wange de ma oraha awa na'owa ena woboa'au. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Ma tuanga guuna wipoha awi gilaongi'a witii-tiiha'a, de wiumo o nyawa yoelu-elu'u manga ngii'a, geena'a do'a ona yoali de duru yohangihara.&gt;&gt;<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">O Hi'atero mangale o moholehe yamogio'o</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />&lt;&lt;Na'o o nyawa ma Ngoa'a woboa de wodadi o 'Oana, geena ma jarita harage 'ao hi'atero neena: Ya mogio'o o moholehe o modo'a ma ni-nii'i borimo-moi yomagehe o poci, de yotagi wihobo'o nage womo-modo'a. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Geena'adau, yamotoa yohuma-huma, de yamotoa yopade-pade. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />O mo-moholehe nage yohuma-huma yamotoa goona yoaha manga poci, ma manga gooro yohidogo-dogo 'ayoahawa. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Ma yamotoa nage yopade-pade, yoaha'a manga poci de manga gooro yohidogo-dogo yadua-duangu'ou. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Womo-modo'a guuna ma daao woboa ho o mo-moholehe goona yonihu'u de ayodiidu'a.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />O wutu go-goronano, de yogiihene o nyawa yomaorehe! Womo-modo'a woboa'au! Niaino powihobo'o! <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />O mo-moholehe yamogio'o goona yoihene egeena, yomomi'i, de ona yohi'adiai manga poci. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Geena'a de ma mo-moholehe nage yohuma-huma goona yotemo ma mo-moholehe yopade-pade'a, &lt;E tanu nimi u'lano ania gooro ma ube-ubewa, hababu mia poci i'honengou ho!&gt; <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Ma o mo-moholehe nage yopade-pade goona yotemo onane, &lt;'Aidadiwa! Hababu done pomidagaadonua!. Iholoi yaowa niotagi la nio goo'o o nyawa'a nage yomawu'u-wu'unu.&gt; <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Geena de, ma mo-moholehe nage yohuma-huma goona yotagi yogoo'o o gooro. Ma ma gigiria'a ona yotagi yogo'o o gooro, ma womo-modo'a ge woboa. Ho ma mo-moholehe nage yo pade-pade ge yomahidi- diai mongau yoohama o rame ma ngii'a yoma'ani'i de ma modo'a o naulu guuna de ma ngoana ma yabeno.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />Geena'a de, ma mo-moholehe nage yohuma-huma goona yoboa, yagelelo o ngoana 'ibeno'au, ho ona yoaho'o, Aba! E Aba! Tanu o ngoana nimi depelenga'ahi. <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Ma wowomo-modo'a guuna wopaluhu, &lt;Ngoi 'atini na'owa.&gt; &gt;&gt;<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Iduangino Wohijarita ma hi'atero geena, o Yesus wotemoli, &lt;&lt;Mangale geena, nimagoa-goanou, hababu ngini ania na'owa muluo'a Ngoi toboali.&gt;&gt;<verse eid="MAT 25:13" /></para>
  <para style="s">O nyawa yo'a-'arajaanga nage yoto-tongohono de ayoto-tongohonua</para>
  <para style="r">(Luk. 19:12 - 27)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />O Yesus Wotemoli, &lt;&lt;Na'o o nyawa ma Ngoa'a nage o horoga'a Woboali de Wo'uaha harage Ma Oana, geena ma jarita idadi harage de 'aohi'atero neena: Naga o nyawa womatengo nage wotagi o diingi i'a-'a'u'li'a. Wa'utu una wotagiou, una wo'iaho'o awi nyawa yo'a'arajaanga moi-moi yomatoomu, ho una wo'ihiataha awi arata ona'a la yomahidaila'o de awi pipi la yama'e ma utumu. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Una awi nyawa yo'a'arajaanga nage womatengo una wo'ula o pipi o hala'a o ngai motoa. Una awi nyawa yo'a-arajanga nage womatengo'ali wo'ula o pipi o hala'a o ngai modidi. De una awi nyawa yo'a'arajaanga nage maregu oli, una wo'ula o pipi o hala'a o ngai moi. Una wo'ihiataha o pipi o hala'a geena ona'a, imote'e toona manga goga'unu moi-moi. Geena iduangino, una wotagi. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Geena'a de, wo'a-arajanga nage wa dawongo o pipi o hala'a o ngi motoa geena'a 'awohi'gila-gila'a womahidaila'o de ma pipi geena, ho wama'e ma utumu o pipi o hala'a o ngi motoali. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Ugeenali de o nyawa yo'a'arajaanga nage wadawongo o pipi o hala'a o ngai modidi. Una womahidaila'o de ma pipi geena, ho una waehe o pipi o hala'a o ribuhu modidioli. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Ma o nyawa yo'a-'arajaanga nage wadawongo o pipi o hala'a o ngai moi, una wotagi wopaiti o guhu o tona'u'u, de waiyunu awi tuanga awi pipi geena'a.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />Duru 'aodaao de aha manga tuanga wolio. Wa'utu woliono, una wo'i polu awi nyawa yo a'-arajaanga de wo'i hulo'o awi nyawa yo'a-'arajaanga goona yohingahu una'a, icara'iau de awi pipi nage wo'ihiataho'au ona'a. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />O nyawa yo'a-'arajaanga nage wadawongo o pipi o hala'a o ngai motoa geena wo'ai'a awi tuangi'a de wo'ula o pipi o hala'a o ngai mogio'o awi tuangi'a. De o nyawa wo'a-'arajaanga guuna wotemo awi tuangi'a, Aba, aba nohiataho'au ngoino ma ani pipi o hala'a o ngai motoa, ho oraha neena nagelelo, ngoi tama'e ma utumu o ngai motoali. <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Ho awi tuanga wotemo una'a, duru yaowa o'iau nage nodiai geena. Ngona ma 'ai nyawa yo 'a-'arajaanga nage yaowa de notongohono. Ngona notongohono'au o haa-haala ile-leete'e, ho ngoi aha toni hiataha ngona'a o ha-haa'la 'ila-laagomo. Ho noohama de noini'i Ngoino la nomaha-hanaanga de-de Ngoi.<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />Geena iduangino, o nyawa yo 'a-'arajaanga nage wadawongo o pipi o hala'a o ngai modidi wo'ai'a awi tuangi'a. Ma nyawa guuna wotemo awi tuangi'a, Aba, aba noihia'taha ngoino ani pipi o hala'a o ngai modidi, ho o oraha neena nagelelo, ngoi tama'e ma utumu o pipi o hala'a o ngai modidioli. <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Ho awi tuanga guuna wotemo una'a, &lt;Duru yaowa o'iau nage nodiai geena. Ngona ma 'ai nyawa yo'a-'arajaanga nage yaowa de notongohono. Hababu, Ngona notongohono'au o haa-haala ile-leete'e, ho ngoi aha tonihi'ataha ngona'a o ha'haala 'ila-laagomo. Ho noohama de noinii'i. Naino la pomaha-hanaanga dede ngoi.&gt; <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Geena iduangino, o nyawa wo'a'arajanga nage wadawongo o pipi o hala'a o ngai moi ma wo'ai'a awi tuangi'a. De wotemo awi tuangi'a onane, &lt;Ngoi ta na'o, aba ani hininga iopini. Aba ngona ika de noutu'u o dingi nage aba ngona o maiwa nohibarihi o gihihi, de aba ma ika de nomagehe ma howo'o o dingi nage ngona ma o maiwahi nodutudu'u. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Mangale geena, wa'utu aba no'ula ma ani pipi neena, ngoi tohawana, uwa hiadono ma ani pipi neena iihanga. Ho iholoi yaowa ngoi topaiti o guhu o tona'u'u, de taiyunu aba ani pipi. Ho naeheu ma ani pipi neena.&gt; <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Geena'a de awi tuanga wotemo una'a, &lt;We, ngona neena o nyawa yo 'a-'arajanga nage yoti-tingi'ai de yotuudu'u. Ngona nana'o'au, Ngoi ika de tomadugutu'u o dingi nage ngoi o maiwa tohibarihi o gihihi, de ngoi ma ikade to magehe ma howo'o o dingii nage ngoi o maiwa todutudu'u. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Na'o o geena, halingou ngona naiyunu 'ai pipi geena o baangi'a, la wa'utu ngoi tolio, 'aidadi tadawongoli 'ai pipi geena de ma utumo'a.&gt; <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Ho ma tuanga guuna wotemo ma nyawa yo'a-arajanga ma regu'a, &lt;Niaehe'au ma pipi o hala'a o ngai moi geena una'a, de niwi 'ula'a o nyawa wo'a-'arajaanga nage awi pipi o hala'a o ngi mogio'o'a. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Hababu, to nagonau de ma ena aha, geena aha yo'i'ulali iholi ilepe, ho duru yoholoi'u. Ma to nagonau 'a'oiwa aha yaehe ngaro ama ube-ube'awau ma. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />De o gilaongo ge o iwa awi faeda niwiumo ma duduni'a ge italu-taluhi'a. Geena'a aha wohingihara de woali.&gt; &gt;&gt;<verse eid="MAT 25:30" /></para>
  <para style="s">O Yesus Wohingahu icara'iau aha wa'utu Una Woha'imou o nyawa'a moi-moi</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />&lt;&lt;Na'o o Nyawa ma Ngoa'a nage o horogano Woboauoli de to Una awi uaha nage i'u'umati de moi-moi o malai'ata de-de Una, ho Una Wogogele o 'Oana ma go-gogelu'u nage i'u'umati. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Hagala bangiha aha Wo'ihi'a'toomu Awi biono'a. De aha Una aha Wo'ihi'a'tinga'a imadadi o doomu modidi harage ao aewani ma go-goana wohi'a'tinga'a o duba de o a'bingi. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />O nyawa-nyawa nage yamote'o'au ma Jou Awi mau, ona goona harage de o duba-duba, ho Una wo'i polu to Una awi guida'o'a. De aha o nyawa-nyawa nage 'a yamote'ua ma Jou awi mau, ona goona harage de ao abi-abingi, ho wo'i polu to Una awigubalio'a. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Wa'utu geena, o nyawa ma Ngoa'a guuna Wo oano'au Wotemo'au ma nyawa-nyawa nage naga awi guida'o'a, &lt;Nengo'a niaino ngini nage 'ai Aba niwihiba-baraati! Nia ainou o dingi nage Ngoi to'uaha hala'u o'oana, Ngoi tohi'adiaio'au o dingi duga ngini geena'a amadi-dihilahi wa'utu o dunia neena idadi. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Hababu, wa'utu Ngoi i'hawini, ngini nihiodomo Ngoino. Wa'utu 'ai i'biti idudungu, ngini nihio'ele Ngoino. Wa'utu Ngoi idadi onyawa ma homoano, ngini nidawongo niawoa'a. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Wa'utu 'ai pa'eanga oiwa, ngini ni'ula o pa'eanga Ngoino. Wa'utu I'gogama, nileleani Ngoino. Wa'utu Ngoi o boio'a nioboa nitaila'o Ngoino.&gt;<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />De o nyawa-nyawa nage yadiai o'iani nage yaowa-owa yotemo Una'a uune, &lt;Jou, a'wuluou ngomi miwima'e ma Jou wihawiini de ngomi miwihiodomo ma Jou'a, e'ola ma Jou awi i'biti idudungu de ngomi miwihio'ele ma Jou'a? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Awuluou miwima'e ma'e ma Jou wodadi onyawa ma homoano amia deara'a de ngomi miwidawongo ma Jou amia woa'a? E'ola awuluo miwima'e ma Jou oiwa awi pa'eanga de ngomi miwi'u'la o pa'eanga ma Jou'a? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />De awuluo miwima'e ma Jou wigogama ho mioboa miwileleani ma Jou'a?&gt; <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Ho aha ma 'Oana guuna wotemo ona'a one, &lt;Nia hininga nihididiai nage Ngoi totemo ngini'a neena, moi-moi nage niodiai la niwiduhunu naga womatengo nage 'ai riadodoto nage onyawa awi bare'eni'awa, geena 'imatero de ngini nio diai Ngoino.&gt;<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />De aha, Una wotemo o nyawa-nyawa'a nage naga awi gubalio'a une, &lt;Niotagi'au neena'a de niai'a ngini o nyawa-nyawa nage ma Jou wohilolaio'au, de nio'ai'au nioohama o u'u'a nage 'aihone-honengua ge, nage ihidiaio'au mangale o ibilihi de ma ni-nii'i. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Hababu wa'utu Ngoi ihawini, ngini ani u'lawa o inomo la toodomo. Wa'utu Ngoi 'ai ngomaha idudungu, ngini ani'ulawa o a'ele la tao'ele. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ugeenali, wa'utu Ngoi todadi onyawa ma homoa tingini ania daera'a, ngini ani dawongua ania woa'a. Wa'utu 'ai pa'eanga oiwa, ngini ani ulawa o pa'eanga. Wa'utu topanya'e ngini aniuruhua, de wa'utu ngoi naga o gugurunga'a, ngini ani taila'onowa.&gt; <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />De aha o nyawa-nyawa gogona ma yotemo onane, Jou, awuluou ngomi miwima'e ma'e ma Jou Wihawini, Awi i'biti idudungu, wodadi o nyawa ma homoano, Awi pa'eanga oiwa, Wopanya'e e'ola naga o gugurunga'a de ngomi amiwileleaniwa ma Jou'a? <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />De Una aha wopaluhu Ona'a une, &lt;Nia hininga nihididiai nage, Ngoi totemo ngini'a neena, moi-moi nage niodiai de anioolu'u niwiduhunu naga womatengo nage 'ai riadodoto nage onyawa awi bare'eni'awa, geena 'imatero de ngini a'nio olu'u niodiai Ngoino.&gt; &gt;&gt; <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />De o Yesus wotemoli, &lt;&lt;O nyawa-nyawa nage yotitingi'ai geena aha yotagi ou'u'a nage 'aihone-honengua 'aihiado-adoni'a. Ma o nyawa nage manga wowango iti-tiai, aha yowango de ma Jou ma Dutu 'ahiado-adoni'a.&gt;&gt;<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">O agama'a yo'ihibalu-baluhu yoma'adatoro o Yesus witooma</para>
  <para style="r">(Mrk. 14:1-2; Luk. 22:1-2; Yoh. 11:45-53)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Wa'utu iduangino o Yesus Wo'ihidoto'o o haala moi-moi geena, Una Wotemo Awi ni-nii'i'a, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt;Ngini nia na'o'au to, ao wange modidiohi ngone o yahudi ma nyawa podiai owange maamo'o o paska mangale po hininga wa'utu ma Jou ma Dutu Wo'ihihupu tongone nanga Balu-baluhu ma hila o Mesir ma bangihano nage yo'i hahangihara ona'a. Ho wa'utu owange maamo'o geena, naga onyawa wohigiamamahoatou o Nyawa ma Ngoa'a nage o horogano la Wi hidelee.&gt;&gt;<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Geena ma wa'utu, o yahudi ma nyawa manga imam ma hae-hae'e yomatoomu ma imam maamo'o o Kayafas awi 'adato'a. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Ona yoma'a aturu la yohibongonino Witago'o de Witooma o Yesusi'a <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />ma ona yoma'atemo, &lt;&lt;uwa powitago'o Una'a ipahi o wange maamo'u'u, uwa hiadono onyawa magilepe nage wiigo Una'a yodiai o ributu.&gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s">O Yesus Widuragi o gooro ma bounu ihemo-hemo</para>
  <para style="r">(Mrk. 14:3-9; Yoh. 12:1-8)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Wa'utu o Yesus o Betania ma hoano'a, Wotulu o simon awiwoa'a. O simon neena ma hila wopanya'e nage yote o pado. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Wa'utu o Yesus magigiria'a wogogelu'u woodomo, naga momatengo o ngewe'a maino moaha ogooro ma bounu ihemo-hemo nage ihali-hali o botolo moi. De ma ngewe'a gumuna moduragi de ma gooro geena mohimemeneoho o Yesus Awi hae'uu. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Ma wa'utu o Yesus Awi ninii'i migelelo muna madiai 'ogeena, ona ayohanangua. Ho ona yotemo, &lt;&lt;O gooro ma bounu ihemo-hemo 'ogeena ma hali de muna amohiguguule de! <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Na'o iwu'unu ma ija duru aohali, de ma pipi geena 'aidadi mo'ula onyawa yohuhuha'a.&gt;&gt;<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Ma o Yesus Wana'o manga hininga'a goona, ho Una Wotemo ona'a, &lt;&lt;Dodoau ho nimi ngamo ma ngewe'a numuna? Muna modiaio'au iani nage ya owa Ngoino. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />O nyawa yohuhuha halalu naga dedengini ma Ngoi 'ahiado-adoni'awa dedengini. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Hababu, moduragi ogooro ma bounu ihemo-hemo 'ai roehu'u, geena 'imatero de muna mohidiaio'au 'ai maiyeti wa'utu ipoohu'ou aha. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Nio danganono nihididiai nage Ngoi totemo neena, ia'a naga yohingahu o habari ma owa ma Jou ma Dutuno neena o dunia'a moi-moi, marai ona yohiade-ade o'iau nage o ngewe'a numuna modiaio'au Ngoino, hiadono o nyawa-nyawa aha mihininga muna'a aitauri'a.&gt;&gt;<verse eid="MAT 26:13" /></para>
  <para style="s">O Yudasa yoma'aaturu wihigiama ma hoatou o Yesusi'a</para>
  <para style="r">(Mrk. 14:10-11; Luk. 22:3-6)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Naga womatengo yamogio'ode yamididino o Yesus awi ninii'i, awi ronga o Yudas iskariot. Una wotagi o imam ma hae-hae'i'a. <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />Womahiadoni'a wohano ona'a, &lt;&lt;Na'o ngoi towihigima ma hoata o Yesus ngini'a o'iau ni'ula ngoino?&gt;&gt; Ho ona wi'ula o pipi o hala'a moruange o yudasi'a. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Geena'a de o yudasa wohali'i ma oraha yaowa-owa la wihigiama ma hoata o Yesus ona'a.<verse eid="MAT 26:16" /></para>
  <para style="s">O Yesus de Awi ni-nii'i yoodomo o inomo nage yohironga o paskah</para>
  <para style="r">(Mrk. 14:12-21; Luk. 22:7-14, 21-23; Yoh. 13:21-30)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />O wange madidihila'a o wange maamo'o o roti 'ai ragi-ragiwa, o Yesus awi ninii'i yo'aia Una'a de yohano, &lt;&lt;Guru, ia'a Guru nomau Ngomi mihidiai o inomo o wange maamo'o nage yohironga o paskah la pomahidoomo?&gt;&gt;<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />De o Yesus Wotemo ona'a, &lt;&lt;Nio'ai'a o Yerusalem ma bendari'a, do'a ngini aha nima'ama'e de o nyawa womatengo. Niotemo ma nyawa guuna'a une, &lt;Ma Guru Wotemo, Awi wa'utu 'ai taaowau. Ho nanga wange ma amo'o'a nage yohironga o paskah Womahidoomo de Awi ninii'i ani woa'a baba.&gt; &gt;&gt;<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />Yoihene iduanga o Yesus Wote 'ogeena, awi ninii'i yadiai 'imatero de nage Wo'ihulo'o goona'a ge. Geena'a de ona yohidiai mainomo owange maamo'o nage yohironga o paska geena.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Wa'utu italuho'au o Yesus de Awi ninii'i ya mogio'o de yamididi yogogelu'u yamahidoomo. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Magigiria'a ona yoodomo, o Yesus Wotemo, &lt;&lt;Niodanganono nihididiai nage Ngoi tinitemo neena, naga o nyawa womatengo dedengini nage aha wopali Ngoino.&gt;&gt;<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Yogiihene geena, ona manga hininga duru ihuha. Ho moi de moi yomademo Una'a, &lt;&lt;Jou angoiwa to?&gt;&gt;<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />O Yesus wopaluhu ona'a, &lt;&lt;Ma nyawa guuna womatengo naga de de ngini nage ao hawo'o moi de Ngoi mihitabu o roti. Guunau nage aha woihigiama ma hoata. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />'Igoungu onyawa ma Ngoa'a nage o horogano aha Wohonenge harage de nage ma Jou ma Dutu Watatapuo'au ma hila. O nabi-nabi ya tuliho'au 'ogeena o bo'u iofi-ofi'u. Ma wobodito'au onyawa nage wohigiama ma hoata onyawa ma Ngoa'i'a, una aha wa ohana o hu'umu nage aodubuho! Ma nyawa guuna iholoi yaowa uwau womaboa o dunia'a neena.&gt;&gt;<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />De o yudasa nage wihigiama ma hoatou ge wote o Yesusi'a, &lt;&lt;Guru, ma nyawa nage Guru nowitehongo'au guuna angoiwa to?&gt;&gt;</para>
  <para style="p" vid="MAT 26:25">&lt;&lt;Ngona mahirete nage notemo 'au 'ogeena.&gt;&gt;<verse eid="MAT 26:25" /></para>
  <para style="s">O Yesus de Awi ninii'i yo Yomahidoodomo</para>
  <para style="r">(Mrk. 14:22-26; Luk. 22:14-20; 1Kor. 11:23-25)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Wa'utu o Yesus de Awininii'i magigiria'a yoodomo, o Yesus Waehe o roti de Wotemo amaowa'a ma Jou ma Dutu'a. Geena ipaha'a, Una wapela-pela'a o roti geena de Wo u'la ona'a, Wotemo, o roti neena 'ai roehe, ho nia odomou.<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Geena ipaha'a o Yesus Waehe o cawan de Wotemo amaowa'a ma Jou ma Dutude. De aha Woula ona'a de Wotemo, &lt;&lt;Ngini moi-moi niooe'le o angguru ao cawaninou neena. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Hababu to Ngoi 'ai aunnu. Wa'utu Ngoi tohenenge, 'ai aunnu aha i'poa mangale ihitatapu ma Jou ma Dutu Awi jaji o nyawa'a. De to Ngoi 'ai aunnu ipoas nage geena mangale yatuu'hu onyawa yolepe-lepe manga baradoha. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Nioihene nihididiai nage Ngoi totemo ngini'a e, neena deimahi'ai'a, Ngoi atoo'elluwau o angguru. Ma aha wa'utu ma Jou ma Dutu Wo uaha iani ma 'oana a'wi awaha'a, aha de Ngoi tao'eloli o angguru nage ma hungi de de ngini.&gt;&gt;<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Geena'a de ona yohinyanyi o nyanyi moi ma Jou ma Dutu wihilamo'o. De geena iduangino ona yotagi o zaitun ma de'ude.<verse eid="MAT 26:30" /></para>
  <para style="s">O habari mangale O Petrus aha womahipongono o Yesusi'a</para>
  <para style="r">(Mrk. 14:27-31; Luk. 22:31-34; Yoh. 13:36-38)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />De o Yesus Wotemo Awi ni-nii'i'a, &lt;&lt;Neenau ma wutu'u ngini moi-moi aha nio loa nidugumada'a; hababu o bo'u ma doda'u ituliho'au: ma Jou ma Dutu Wotemo, &lt;Ngoi aha Towitooma o duba ma tutuda guuna, de Awi duba o duono'a aha ipilingana yai'a yaino.&gt; <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Ma iduangino Ngoi tomomi'oli, Ngoi aha totagi tinihoboo'o o galilea'a.&gt;&gt;<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />O petrus wotemo o Yesusi'a, &lt;&lt;Ngaro moi-moi de ma reguohi nage nimada'a Aba, ma ngoi a'ouwa.&gt;&gt;<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />De o Yesus Wotemo o Petrusi'a, &lt;&lt;Noihene nohidi-diai e nage totemo ngona'a, neena ma wutu'u onamo 'aiholenuwahi, ngona ma haangeu nomahipongono, note ngona anoi na'owa Ngoino.&gt;&gt;<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Ma o Petrus wotemo Una'a une, &lt;&lt;Geena ngaro ngoi halingou tohonenge dede Ngona Guru ma ngoi 'a tomahipongonua Ngona'a Guru.&gt;&gt; De o Yesus Awi ninii'i ma regu nage ma yotemo 'ogeena.<verse eid="MAT 26:35" /></para>
  <para style="s">O Yesus Wohaubayanga O Getsemanio'a</para>
  <para style="r">(Mrk. 14:32-42; Luk. 22:39-46)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Iduangino geena O Yesus de Awi ninii'i yotagi o dingii moi'a nage ma ronga o Getsemani. Geena'a do'a Una Wotemo ona'a, niogogelu'ohi neena e jai-jai Ngoi totagi to haubayanga. <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Ma o Yesus wo'iaha o Petrus, Yakobus de oa Yohanis, zebedeus awi ngoa'a yamididi goona Winii'i Una'a. Geena ma wa'utu, Awi hininga imulaenge ihuha de Awi roehe ma ito-towoworo. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Una Wotemo Awi ni-nii'i'a, &lt;&lt;'ai hininga duru ihuha, Ta'mao iani ge de a'tohonengou. Neena'ahi ngini e, de ngini ma nimagoa-goana de de Ngoi.&gt;&gt;<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Geena iduangino o Yesus Wotagi maube i'a'uli'a, de Una Watilabu'u hiadono Awi biona ma yaadono o tona'uu de Wohaubayanga wotemo, &lt;&lt;Aba o, na'o 'ai dadi de tanu uwa taohana ma hangihara neena. Ma uwa imote'e to Ngoi 'ai mau, ma imote'e Aba to Ngona ani mau.&gt;&gt;<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Geena iduangino o Yesus Woma'ilio Awi ni-nii'i'a yahaange goona, de Wo'igelelo ena ona yonihu'o'a. De Una Wo'i tumomi'i de Wotemo o Petrusi'a, 'ae, ngona 'aidadiwa nomatongohono ngaro ao da'o moi la nimagoa-goana de de Ngoi? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Nima goa-goana de nimadahaubayanga la uwa nia ohana o da-daili. Igoungo'au niahininga'a niomau nio diai nage iti-tiai ma ania roehe ayaohonua.<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Ma moiohi o Yesus Wo tagi Wohaubayanga, Awidemo, &lt;&lt;Aba na'o ma hangihara neena halingou Ngoi ta Ohana, de 'aidadiwau ihitinga'a imadaua imote'e to Ngona Aba ani mau.&gt;&gt; <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Geena iduangino o Yesus Woma'ilioli de Wo'igelelo Awi ninii'i 'ayomaiduo'ahi mangale ona ayonihu'oli.<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />Ma moi ohi o Yesus, ona Wo'i mada'a de Wohidigali ma haange haubayanga de Awi haubayanga ma demo-demo aimatero. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Geena iduangino Una Woma'ilioli Awi ni-nii'i'a de Wotemo, &lt;&lt;Ngini nimaidu de animihiano'ali? Nia gelelo ya adono'au Awi wa'utu onyawa ma Ngoa'a Wihigiama ma hoata onyawa yo babaradoha manga uaha'a. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Nio momi'i la potagi. Niagelelo onyawa nage woihigiama ma hoata woboa'au.&gt;&gt;<verse eid="MAT 26:46" /></para>
  <para style="s">O Yesus Witago'o</para>
  <para style="r">(Mrk. 14:43-50; Luk. 22:47-53; Yoh. 18:3-12)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Magigiria'a o Yesus 'a Woma ade-adehi, o Yudasa, womatengo nage yamogio'o deyamididino Awi ninii'i guuna woboa. Una woboa yoma'anii'i de o duono moi maamo'o, maregu yoaha ohumaranga de mareguohi yoaha o gota ma dobi'i. Ma nyawa-nyawa goona o imam ma hae-hae'e de oyahudio'a ma balu-baluhu yo'ihulo'o. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />O Yudasa nage wihigiama ma hoata o Yesusi'a wo'ihingahuoau ma dudunguu, una wotemo one, &lt;&lt;O nyawa nage ngoi aha towi ame, Guunau nage ngini halingou niwitago'o.&gt;&gt;<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Wa'utu yaadono ma dingii'a geena, o Yudasa awi digila-gila widagi o Yesusi'a de wote &lt;&lt;Tabea, Aba Guru!&gt;&gt; De una wiame o Yesusi'a.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />O Yesus Wopaluhu, &lt;&lt;E manai, nodiaiou o 'iau nage nomau nodiai.&gt;&gt; Geena'a de o nyawa yolepe-lepe goona yo'ai'a de witago'o o Yesusi'a.<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />Ma womatengo o Yesus awi ni-nii'ino, wahiata awi humaranga de wihumaranga o imam ma amo'o awi gilaongo awi ngau'i'a hiadono awi ngau'u ma itoa'a. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />De Yesus Wotemo ma nyawa'a guuna, &lt;&lt;Nohiohamou ani humaranga geena! Mangale na'o o nyawa yo'ihitooma deo humaranga una ma wohonenge de o humaranga. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Uwa nia mongo, Ngoi 'ai dadi togaaho'o 'ai Aba de la Una aigila-gila Woihidingoto o malai'ata de ma ribuhu mangale Ngoi iduhunu. <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Ma na'o Ngoi tadiai 'ogeena, geena mangariti, moi-moi nage 'ituliho'au o bo'u iofi-ofi'u mangale Ngoi neena naga, 'ai dadi awa.&gt;&gt;<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />De o Yesus Wotemo o nyawa yolepe-lepe'a nage yoboa witago'ou Una'a, &lt;&lt;Niotemo bote Ngoi neena o nyawa totitingi'ai, hiadono nioboa nioaha o humaranga de o gota ma dobi'i la nitago'o Ngoino? Ena momongo Tohiwange moi tohingahu ma Jou ma Dutu Awi Habari ma Owa ma Jou ma Dutu awi woa'a, ma ngini ani tago'ua Ngoino geena'a <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ma imada'au, mangale igoungu moi-moi geena iani idadi, 'imatero de nage ma Jou ma Dutu Wotemo'au ama hilahi o nabi-nabi'a nage 'itulihu'u'au o bo'u iofi-ofi'u.</para>
  <para style="p" vid="MAT 26:56">Geena'a de, moi-moi Awi ninii'i Wida'aloa o Yesusi'a.<verse eid="MAT 26:56" /></para>
  <para style="s">O Yesus o agama'a ma ha'imi manga biono'a</para>
  <para style="r">(Mrk. 14:53-65; Luk. 22:54-55, 63-71; Yoh. 18:13-14, 19-24)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />O nyawa-nyawa nage Witago'o o Yesusi'a, Una wiaha o imam ma amo'o o Kayafas awi woa'a. Do'a naga yomalomuno'au o agama'a yodoto-doto'o de o yahudio'a ma balu-baluhu. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Wa'utu o Yesus Wiaha geena'a, o petrus ma wonii'i ma womahihori'awa hiadono una wo ohama o imam maamo'o awi woa ma bibino'a. Geena'a wai'a una wogogele womahiganu deo huru-hurudado geena'a nage la witaila'o o'i'au nage idadiou o Yesusi'a. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Geena'a, o imam ma hae-hae'e de moi-moi agama ma ha'imi yo'ihibalu-baluhu ona yo'ihali'i o nyawa-nyawa nage yo ha'i'hi aitiaiwa la yo maiti o Yesus Awi hala, la ona Wihu'umu Wihohonenge Una'a. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Ma ona ayohi'ama'ewa Awi hala, geena ngaro ma wa'utu onyawa manga lepeu nage yo boa la yoha'i'hi aitiaiwa mangale o Yesus. Ma baha'u, onyawa ya mididi nage yo ha'i'hi une, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />ma nyawa Nuuna ma hila Wotemo'a, Una aha wa horoma ma Jou ma Dutu awi woa de ao wange haange'a Una aha Wohigo'o au oli.&gt;&gt;<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Geena'a o imam maamo'o Woma goa'a de wote o Yesusi'a, &lt;&lt;O nyawa manga lepe yohingahuo'au to Ngona ani hala, de Ngona anomaade-ada'ewa?&gt;&gt; <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ma o Yesus 'a Womaliililo'a. De o imam ma amo'o wotemoli Una'a, ho nanga Jou ma Dutu nage wowango-wango, be'a natehongino 'igoungu Ngona ma 'Oana Wohiha-halamata, ma Jou ma Dutu Awi Ngoa'a bolo 'a Ngonawa?<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />O Yesus Wopaluhu, ngona mahirete natehongo'au 'ogeena. Ma Ngoi totemo ngini'a, neena'a de imahi'ai'a ngini aha niwima'e o nyawa ma Ngoa'a Wogogele nage Awi Uaha i amo-amo'o Awi guida'o'a de Woboa o a'mo-a'mo ma de'uno o diwango'a.<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />De yo ihene o Yesus Wotemo 'ogeena, imam ma amo'o, duru de wongamo hiadono awi baju i'a-'a'ulu'u ma waracanga dewote une, &lt;&lt;We, ma nyawa Nuuna wihohedu ma Jou ma Dutu'a! Ho, ngone ngaro uwau pohali'i o ha'ihi! Ngini mahirete nio iheno'au, to?<verse eid="MAT 26:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 26:66" />Neena imote'e ngini icara'iau?&gt;&gt;</para>
  <para style="p" vid="MAT 26:66">De ona yo paluhu, &lt;&lt;Una halingou Wama'e o hu'umu Wihohonenge.&gt;&gt;<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Geena iduangino, ona yaobili o Yesus Awi biono'o de Una ma Wi poha. De maregu ma Wipo'a <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />de yo temo bee'a no'ita-taana nagoonau nage Ngona Nipo'a.<verse eid="MAT 26:68" /></para>
  <para style="s">O Petrus womahipongono o Yesusi'a</para>
  <para style="r">(Mrk. 14:66-72; Luk. 22:56-62; Yoh. 18:15-18, 25-27)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Wa'utu geena, o petrus wogogelu'u o bibini ma date'o'a. De o ngewe'a mo'a-'arajanga momatengo maino, de motemo o petrusi'a, &lt;&lt;ngona neena ma ikade nima'a-'anii'i de o Yesus o Galilea ma nyawa Guuna to?&gt;&gt;<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Ma o petrus womahipongono o nyawa yolepe-lepe manga biono'a moi-moi de wotemo, &lt;&lt;Ngoi atomahina'owa o'iau ani ma'uhuutu!&gt;&gt; <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Geena'a de una wo'aia o bibini ma ngoani'a. O ngewe'a mo'a-'arajanga womatengoli mima'e o Petrusi'a, de motemo ma nyawa-nyawa geena'a, &lt;&lt;Ma nyawa nuuna 'aano ma ikade yoma'anii'i de o Yesus o Nazaretino ge.&gt;&gt;<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Ma o petrus womahipongonoli de woo'boto, &lt;&lt;Nanga Jouo'au! Ngoi atowina'owa ma nyawa Guuna.&gt;&gt;<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Geena iduangino, aitaowa ena, o nyawa-nyawa nage yomahigo'o-go'ono geena'a yomahidutu'u o petrusi'a de yotemo, &lt;&lt;Marai ngonao ma moi'ani toona manga nyawa. 'A ani demohi ena panana'o au.&gt;&gt;<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Geena'a de o Petrus wo'obo-o'boto de wotemo, &lt;&lt;Ngoi atowina'owa ma nyawa Guuna.&gt;&gt;</para>
  <para style="p" vid="MAT 26:74">'Ageena'a ena ma namo iholeno'au. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />De o Petrus womadanganono geenalaho Yesus Wotemo'au una'a, o namo 'aiholenuwahi ena ngona ma haange noma pongono Ngoino. De o Petrus wohupu, de woali awo hohowonou.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">O Yesus Wiaha o pilatusi'a</para>
  <para style="r">(Mrk. 15:1; Luk. 23:1-2; Yoh. 18:28-32)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />O de-dewelano, o imam ma hae-hae'e moi-moi de o Yahudio'a manga balu-baluhu yomalomu yodiai o butuhu mangale Witooma o Yesusi'a. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Ona Wi puhu'u, de wiaha Wihigiama ma hoata o Pilatusi'a, nage o Roma'a manga gubernur.<verse eid="MAT 27:2" /></para>
  <para style="s">O Yudas wohonenge womali'o</para>
  <para style="r">(Kis. 1:18-19)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Wa'utu o Yudas nage o Yesusi'a wihigiama ma hoa-hoata, woihene na'o o Yesus wihu'umu wiho-honenge, una duru womanyahala. Geena'a de una wohigilio o pipi o hala'a moruange geena o imam ma hae-hae'i'a, de o yahudi manga balu-baluhi'a. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Una wotemo ona'a, &lt;&lt;Ngoi tobaradoha'au mangale towihigiama ma hoata o nyawa nage awi hala o iwa!&gt;&gt; Ma ona yopaluhu: &lt;&lt;Geena ngomi amiana'owau, geena ana uruhi'au!&gt;&gt;<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />O Yudas wohi'aweli ma pipi geena ma Jou Awi woa ma doda'a de aha wotagi womali'o.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />O imam ma hae-hae'e yalomu ma pipi geena de yotemo: &lt;&lt;O pipi neena 'aidadiwau pohiohama o hada'a ma no-noa'u, hababu neena o aunu ma pipi.&gt;&gt; <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Iduangino yoma'aaturu, ona yohigoo'o ma pipi geena o tona'a, nage ihironga o tona'a ma aunu. La ma tona'a geena yapa'e o nyawa ma homoano manga bo-boohu'u ma ngii. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Geenau ma hababu ho, hiadono o oraha neena ma tona'a geena ihironga: &lt;&lt;O aunu ma tona'a.&gt;&gt;<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />De o geena idadi, la ihitotomo o 'iau nage o nabi Yeremia watehongo'au: &lt;&lt;Ona yaehe ma pipi o hala'a o ngodumu moruange geena, Geenau nage o Israel ma nyawa ihitatapuo'au to Una awi ija, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />de ma tiwi geena yohigo'o o tona'a, mangale o bohu'u yodidiai, harage 'a ma Jou wohulo'o'au ngoino.&gt;&gt;<verse eid="MAT 27:10" /></para>
  <para style="s">O Yesus O Pilatus awi biono'a</para>
  <para style="r">(Mrk. 15:2-5; Luk. 23:3-5; Yoh. 18:33-38)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Geena'a de o Yesus wihitaalioli o Pilatusi'a, o gubernur geena ma deara'a ge, o Pilatus wohano, &lt;&lt;Ngona neena o Yahudio'a manga 'Oana?&gt;&gt; O Yesus wopaluhu, &lt;&lt;Ngona mahirete na tehongo'au.&gt;&gt; <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Ma wa'utu o imam ma hae-hae'e de o Yahudio'a ma balu-baluhu witae o Yesusi'a, ao ngale moi ma Una 'awopaluhua.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Ho o Pilatus wote Una'a: &lt;&lt;Ee bote geena 'anoihenua nage ona nitae ma gudai Ngona'a de?&gt;&gt;<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Ma o Yesus 'ao demo o ngale moi ma awopaluhua hiadono ma Gubernur guuna duru woheranga.<verse eid="MAT 27:14" /></para>
  <para style="s">O Yesus wihu'umu wiho-honenge</para>
  <para style="r">(Mrk. 15:6-15; Luk. 23:13-25; Yoh. 18:39-19:16)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />O taunu ihinoimi, wa'utu o wange ma amo'o ihironga o Paska, o gubernur, biaha wo'ihihupu womatengo o buino imote'e o nyawa ma gilepe manga mau. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Wa'utu geena, o buio'a naga womatengo nage wina'o'au duru wotingi'ai, awi ronga o Yesus Barabas. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Ho wa'utu o nyawa yolepe-lepe yomatoomuno'au o Pilatus wo'ihano ona'a, &lt;&lt;Niomau naguunau ngoi towihihupu ngini'a, o Yesus Barabas bolo o Yesus nage witehongo ma Kristus?&gt;&gt; <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />O Pilatus wana'o'au, ona wihigiama ma hoata o Yesus una'a, mangale wibuhulu.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Wa'utu o pilatus wogogelu'u, o ha'imi ma go-gogelo'a, ma we'ata mohidingoto o behehongo una'a: &lt;&lt;Uwa nocapuru o nyawa woti-tiai guuna awi haala, hababu mangale Una ngoi duru tohangihara 'ai nanele ma doda'a 'awutu'a&gt;&gt; <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Ma o imam ma hae-hae'e de o Yahudio'a ma balu-baluhu 'ai tauri'au yo'ibaja o nyawa yolepe-lepe'a la yogaaho'o o pilatusi'a la o barabas wihihupu de o Yesus Wi hu'umu Wihohonenge. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Ho o gubernur Pilatus wo'ihanoli o nyawa yolepe-lepe goona, &lt;&lt;Noona yamididio'a naguunau niomau ngoi towihihupu?&gt;&gt;</para>
  <para style="p" vid="MAT 27:21">Ona yopaluhu, &lt;&lt;O Barabasa!&gt;&gt;<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />O Pilatus wohanoli, &lt;&lt;Ho na'o 'ogeena o'iau nage halingou ngoi tadiai de ma Yesusu nuuna nage onyawa Witehongo ma Kristus?&gt;&gt;</para>
  <para style="p" vid="MAT 27:22">De ona moi-moi yoma orehe, &lt;&lt;Una niwi hideli'au!&gt;&gt;<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Ho o Pilatus wohanoli ona'a, &lt;&lt;Una o howono o'iau Wodiai ho?&gt;&gt;</para>
  <para style="p" vid="MAT 27:23">Ma onyawa yolepe-lepe 'age'au i'ua'tie yomaorehe, &lt;&lt;Una niwi hideli'au!&gt;&gt;<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Wa'utu geena o gubernur o pilatus 'awomadodoawau, de geena'a imulaengo'au irua. Ho una waehe oa'ele de waiho'o awi giama onyawa yolepe-lepe manga biono'a la idadi o dudu'ngu, una awa halawa, ma una awa mote'e onyawa yolepe-lepe manga mau. Una wote une, &lt;&lt;Ngoi ato tangunjawapuau e. Na'o ma Nyawa Nuuna Wohonenge, nginiou moi-moi nio tangunjawa'pa!&gt;&gt;<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />De onyawa yolepe-lepe goona yote, &lt;&lt;Iolo, ngaro ngomi de amia ngoa-ngoa'u'u mia tanggo ma hu'umu mangale ma Nyawa Guuna Awi honenge.&gt;&gt;<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Wogiihene geena, o Pilatus wa mote'e onyawa yolepe-lepe manga mau, ho una wihihupu o barabas. Ma o Yesusi'a, wo'ihulo'o o hurudado la wipoha Una'a de o gumini ge ma doe'a naga deo iani idoto-doto 'a. Geena iduangino Pilatus wihigiama ma hoata o Yesus ona'a la Wihidele.<verse eid="MAT 27:26" /></para>
  <para style="s">O Hu-hurudado Witeba-teba de Wihohedu O Yesusi'a</para>
  <para style="r">(Mrk. 15:16-20; Yoh. 19:2-3)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Geena iduangino ho yo'iaho'o manga ma-manai yo hu-hurudado moi-moi yomatoomu wi higilolitino Ma Yesus. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Ona yataai'i o Yesus Awi baju de wihinoa Una'a ma baju i'a'a'ulu'u ma ungu harage o 'oa-oana jaga yapa'e. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Ona yadiai o mahkota moi o jaga-jagano nage ihihihi'a de yohinoa o Yesus Awi Hae'i'a. De aha ona yodonoa o papadi ma dobi'i Awi giama o guida'o'a, de yatilabu'u Awibiono'a de Wi hohedu Una'a. Yote, &lt;&lt;Tabea o Yahudi ma nyawa manga Oana&gt;&gt;. <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Ona Wiobili Una'a, de ya ehe ma papadi geena, de Wihipoha Awi hae'i'a. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Iduangino wihigugu'ule Una'a, ona yata'ai'i ma baju i'a'a'ulu'u nage ma ungu geena de wihinoali Awi baju to Una mahirete. De aha Una Wiaha Wihihupu la Wihidele.<verse eid="MAT 27:31" /></para>
  <para style="s">O Yesus Wihidele</para>
  <para style="r">(Mrk. 15:21-32; Luk. 23:26-43; Yoh. 19:17-27)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />O nge'omo ma gorona'a, ona yoma'a ma'e de womatengo o kirene ma nyawa awi ronga o simon. Ona wipa'iha ma nyawa guuna wamo'u o Yesus awi saliipi. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Geena'a de ona yomahiadono o dii'ngi moi'a nage ma ronga o golgota, ma mangariti &lt;&lt;O 'obongo ma ngi&gt;&gt;. <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Geena'a ona Wi'ula o Yesusi'a la wao'ele o angguru nage ya ganuo'au de o 'aewani ma milingi. Ma iduangino o Yesus Wataili ma angguru geena, Una awoolu'u wao'ele.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Geena'a de ona Wihidele Una'a, de yohi'a ado'ua to Una awi pa'eanga de o undiana. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Geena iduangino ona yogogelu'u geena la wigoana Una'a. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Awi hae'e ma de'u'de ihituliho'o ho'iau ona Witae ge geenala: Nuunau o Yesusu, o Yahudi ma nyawa manga Oana. <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Yamididi yotitingi'ai ma yo'ihidihedele de Una; womatengo awi guida'a ma hononga'a, womatengoli awi gubali ma hononga'a.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />O nyawa-nyawa nage yatoa'a geenano ayagiwi-giwi manga hae'e, de Wihohedu o Yesusi'a. <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />Ona yote, &lt;&lt;Ngona nage nomau naluba ma Jou ma Dutu awiwoa, de Nohigo'oli ao wange haange'a! Na'o Ngona ma Jou ma Dutu awi Ngoa'a, Noutiou ma saliipu'u geena, de Ngona mahirete Nomahilamata!&gt;&gt;<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Ugeenali de o imam ma hae-hae'e de o agama'a yodoto-doto'o aha de o Yahudio'a yo'ihibalu-baluhu Wihohedu o Yesusi'a. Ona yote, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />Una Wo'ihihalamata o nyawa ma homoa, ena momongo Una mahirete awa dadiwa Womahihalamata! Na'o Una o Israelo'a manga Oana, iholoi yaowa Una o oraha neena Wouti o saliipu'u geena, aha de ngomi mio mode'e mio nga'u Una'a. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Una Wonga'u ma Jou ma Dutu'a, de Wotemo Una ma Jou ma Dutu Awi Ngoa'a. Ho, ino ngone pagelelo ma Jou ma Dutu Wo mode'e Wihilamata bolo ouwa o oraha neena.<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />Yamididi yotitingi'ai nage yo'ihididihidele de Una goona ma a'ugeena Wihohedu Una'a.<verse eid="MAT 27:44" /></para>
  <para style="s">O Yesus wohonenge</para>
  <para style="r">(Mrk. 15:33-41; Luk. 23:44-49; Yoh. 19:28-30)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Wa'utu o wange i'orona, moi-moi ma daera geena'a 'ai taluhu'u, ma daao o ta'o haangeno. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />O ta'o haange o wange i'umulu'u, de o Yesus Womaorehe Wapau-paude wa pa'e o Aram ma demo. Wotemo, Eli, Eli lama Sabakhtani? Nage mangariti, &lt;&lt;Jou ma Dutu 'ai Jou, idodoau ho Noimada'a?&gt;&gt;<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Yamuluo o nyawa geena yoihene womaorehe geena, de yote, &lt;&lt;E, Una Wiaho'o ma nabi Elia!&gt;&gt; <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Ho geenau ma wa'utu, naga womatengo o onano nage awomataiti woehe o sponso, ho wohitabu o angguru ma cu'a'u. De aha ma sponso geena wohi topo'o o gota'a ho wohitigi o Yesusu awi ulude la Wa wiwihi.<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />Ma maregu nage yotemo, &lt;&lt;Uwahi! La powigelelohi, iani bote o nabi Elia Wihihalamata Una'a.&gt;&gt;<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Deaha o Yesus Womaoreheoli Wapau-paude, de Awi Ngomaha itoa'a.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Geena'a de ma Jou ma Dutu awi woa ma dadato'o nage ihidelu'u ma iracanga modidio'a da'uu'u hiadono dau'u'u. O ohu de o de'u iheheleo ma ipela'a. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />O boboohu'u ma ipelenga, de manga lepe ma Jou ma Dutu awi umati nage yohone-honengo'au ma yo wangoli. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Ona yohupu boboohu'ino iduangino o Yesusu Wowango o honengino, de ona yoohama o yerusalem ma bendari'a. De do'a onyawa manga lepe yo'ima'e ona'a.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Ma 'Apita de o hu-hurudado nage magigiria'a Wigoana o Yesus durue de yohawanau wa'utu yamao o tona'a itiwiwili, de moi-moi nage idadi geena. De ona yotemo, &lt;&lt;Igoungu, Una nuuna ma Jou ma Dutu Awi Ngoa'a!&gt;&gt;<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Geena'a ma manga lepe o ngewe'a nage magigiria'a yagelelo maga'ulo'a de yaino. Onau noona nage ma Yesus winii'o'au mangale wileleani Una'a nage ao galilea'ahi de yaino. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Ona goona geenala o ngo maria o Magdalano, o ngo maria o yakobus de o yusuf ma eha de o zebedeus awi ngoa-ngoa'a manga eha.<verse eid="MAT 27:56" /></para>
  <para style="s">O Yesus Wipoohu'u.</para>
  <para style="r">(Mrk. 15:42-47; Luk. 23:50-56; Yoh. 19:38-42)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Ma wutu geena waino womatengo wo a'ya-a'ya o arimateano nage awi ronga o Yusuf. Una guuna ma o Yesus awi ninii'i. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Una wotagi o pilatusi'a, de wogaaho'o o Yesus awi maiyeti. Geena'a de o pilatus wo'i hulo'o la o Yesus awi maiyeti yo u'la una'a. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Ho Yusuf waehe ma maiyeti geena, de wa hao de o maiyeti ma ha-hao nage yohironga o linene ge ma hungi. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Ho una wa noa'u o Yesus awi maiyeti o boohu'u ma doda'a touna mahirete awi boohu'u nage o aru'o'a ma doda. Geena iduangino una wodululu'a o heleo iamo-amo'i moi wohi tamunu ma boohu'u ma ngoana geena. Aha de wotagi. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Ongo maria o Magdalano de o ngo maria mareguoli ayo gogelu'ou geena'a yodaali'a ma boohu'u geena.<verse eid="MAT 27:61" /></para>
  <para style="s">O Yesus awi Boohu'u yogoana-goana</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />De ma dewelano, o sabat ma wange'u, imam ma hae-hae'e de o Farisio'a ma nyawa-nyawa yotagi o Pilatusi'a <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />de yotemo, &lt;&lt;Tuanga, ngomi 'a mio danganonohi wa'utu ma tabaelu'u Guuna awo wangohi, Una wotema'a, &lt;O wange haange ipaha Ngoi aha to momi'i.&gt; <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Mangale geena, no'ihulo'i'a o nyawa yagoana ma boohu'u geena yohidi-diai hiadono o wange haange, uwa hiadono awi ni-nii'i yatohi'i awi maiyeti de yote o nyawa-nyawa'a bali Una wihimomi'o'au o honengino. De ma dengelu'u nage ituuluno nage iholoi itiiha de nage ididihila'a.&gt;&gt;<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Woihene geena, o pilatus wotemo, &lt;&lt;ni'iahau 'ai hurudado ya muluo naga, de nio goana nihidiai ma boohu'u geena.&gt;&gt;<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Geena iduangino, ona yotagi ma boohu'i'a. De ona yohidunguu'a ma heleo'a nage ihi tamunu ma boohu'u geena ma ngoana, geena'a de yogoana geena'a.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">O Yesus womomi'i o honengino</para>
  <para style="r">(Mrk. 16:1-8; Luk. 24:1-12; Yoh. 20:1-10)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Wa'utu o sabat ma wange i paha'a, o dedewelano o hiaiini ma wange'u, o ngo Maria Magdalena de o ngo Maria nage maregu oli goona yo tagi ya taila'o o Yesus awi boohu'u geena. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />I'todo'anino o tona'a itiwiwili duru ao guatino. Womatengo ma Jou awi malai'ata wo uti o horogano de wa lulu o heleo ma dadamunu geena, de wo gogele ma heleo ma de'u o'a. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Ma biono ma malai'ata guuna ma dararono harage ao leletongo, de awi pa'eanga duru ao garehe. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />O hurudado ma nini'i nage yo goa-goana geena'a duru yohawana hiadono ona yo totowoworo, de manga rupa harage ao nyawa yo honengo'au.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />O Malai'ata guuna 'itemo ma nge-ngewe'a'a goona, &lt;&lt;Uwa ngaro nio hawana! Ngoi ta na'o ngini niwihali'i o Yesus nage wihidelo'au geena.<figure style="fig" alt="Malaikat berkata bahwa Yesus sudah bangkit" file="wa03930.jpg" size="span" copy="Wade wa 03930" ref="28.5">O malai'ata ihingahu na'o Yesus womomi'o'au</figure> <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Una awi iwa neena'a. Una wo womomi'o'au harage awatehongo'au ma hila. Niaino nia taila'o awi diingi Una wipatiranga. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />O oraha neena, nio tagi nimataiti nihingahu awi ni-nii'i'a, &lt;Una wo womomi'o'au de neena naga wo hila'a wo ma hiadono de ngini o galilea'a. Do'a aha ngini niwi ma'e Una'a!&gt; Nio da-danganono o i'au nage Ngoi to temoa ngini'a.&gt;&gt;<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Ma nge-ngewe'a goona ayo ma taiti ya mada ma boohu'u geena. O dodato de o garago ima'aganu'u, ona yoma papalitana la yohingahu ma haala geena o Yesus awi ni-nii'i'a.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />Itodo'anino o Yesus waino de yoma'ama'e de o nge-ngewe'a goona, de wote, &lt;&lt;tabea!&gt;&gt; Ho ona yai'a yoma hitigi Una'a, aha de ya'oo awi douno de wihuba Una'a. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />&lt;&lt;Uwa nio hawana,&gt;&gt; o Yesus wotemo ona'a, &lt;&lt;Tagi nihingahu 'ai riadodoti'a la ona yotagi o galiea'a; do'a aha ona i'ma'e Ngoino.&gt;&gt;<verse eid="MAT 28:10" /></para>
  <para style="s">O Hurudado nage yogoa-goana manga demo</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Wa'utu ona o nge'omo ma gorona'a, o hurudado nage yogoa-goana o Yesus awi boohu'uo goona yolio o bendari'a de yohingahu o imam ma hae-hae'i'a moi-moi nage ida-dadio'au. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />O imam ma hae-hae'e yoma'aaturu de o Yahudio'a manga balu-baluhu, geena'a de yo'ula o pipi hu-hurudado'a goona duru ao lamo'o. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />De yote: &lt;&lt;Ngini halingou nio temo, geenala awi ni-nii'i yaino o wutu-wutu de Witohi'i wa'utu ngini nimaiduo'a. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />De na'o ma Gubernuuru woihene ma haala geena, ngomi aha miwibaja una'a la ngini onidodoawa.&gt;&gt;<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Ona yadawongo geena ma pipi de yadiai harage yo'ihibehehongo'au ona'a. De ma jarita neena yaedono'au o yahudi ma nyawa'a hiadono neena naga.<verse eid="MAT 28:15" /></para>
  <para style="s">O Yesus womahimaiti awi ni-nii'i'a</para>
  <para style="r">(Mrk. 16:14-18; Luk. 24:36-49; Yoh. 20:19-23; Kis. 1:6-8)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />O Yesus awi ni-nii'i yamogio'o de moi goona yotagi ode'u o galilea'a hara de nage o Yesus wo'ihulo'o yo'ai'a. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Wa'utu ona wima'e o Yesus do'aena'a, ona wihuba Una'a. Ma maregu nage ona 'a yonga'uwahi. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />O Yesus womahidutu'u ona'a, de wotemo, &lt;&lt;Moi-moi o 'uaha o horoga'a de o tona'o'a ihigiama ma hoato'au Ngoino. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Hababu geena nio tagi'au o hagala bangiha'a o dunia'a moi-moi, ni'idiai ona 'ai ni-nii'i. Ona ni'iohi'i de o Aba awi ronga, de Awi Ngoa'a, de o Omaha. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Ni'i doto'i'a ona ya mote'e nage tini hulo'o'au. De nio da-danganono Ngoi aha halalu dedengini hiadono o dunia ma baha.&gt;&gt;<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>