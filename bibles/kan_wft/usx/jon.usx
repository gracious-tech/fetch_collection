<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">- Siddi</book>
  <para style="toc3">ಜೊನಾ</para>
  <para style="toc2">ಜೊನಾ</para>
  <para style="toc2">ಜೊನಾ</para>
  <para style="toc1">ಜೊನಾ ಪರ್‍ವಾದ್ಯಾಚೆ ಪುಸ್ತಕ್</para>
  <para style="mt2">ಜೊನಾ ಪರ್‍ವಾದ್ಯಾಚೆ ಪುಸ್ತಕ್</para>
  <para style="mt1">ಜೊನಾ ಪರ್‍ವಾದ್ಯಾಚೆ ಪುಸ್ತಕ್</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ಜೊನಾಚೆ ಪುಸ್ತಕ್ ನಿನಿವೆಚ್ಯಾ ಶಾರಾಕ್ಡೆ ಜೊನಾ ಪರ್ವಾದನಾಚ್ಯಾ ಸೆವೆಚ್ಯಾ ವಿಶಯಾತ್ ಸಾಂಗ್ತಾ. ಹುರಲ್ಲ್ಯಾ ಪರ್‍ವಾದನ್ ಪುಸ್ತಕಾನ್ಕಿ ಹೆ ಪುಸ್ತಕ್ ದೆವಾಚ್ಯಾ ಖಬ್ರಿಯಾಚ್ಯಾಕಿಂತಾ ಪರ್ವಾದ್ಯಾಚ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ವಿಶಯಾತ್ ಸಾಂಗ್ತಾ. ಇಜ್ರಾಯೆಲಾಚೊ ರಾಜಾ ಜೆರೊಬ್ಬಾಮಾಚ್ಯಾ ದೊನ್ವೆಚ್ಯಾ ಕಾಳಾರ್ ಮಟ್ಲ್ಯಾರ್, ಕ್ರಿಸ್ತ್ ಪುರ್ವ್ ಆಟ್ಸೆಕ್ನಾ ಸಾಡೆ ಸಾತ್ಸೆತ್ ಹೆ ಘಡಲ್ಲೆ ಹಾಯ್. ಖರೆ ಹ್ಯೊ ಪುಸ್ತಕ್ ಲಿವಲ್ಲೊ ಎಳ್ ಬುದ್ದವಂತಾಕ್ನಿ ಸಮಾ ಗೊತ್ತ್ ನಾ.</para>
  <para style="ip">ದೆವಾನ್ ಜೊನಾಕ್ ನಿನಿವೆಚ್ಯಾ ವಿರುದ್ದ್ ಪರ್ಗಟ್ ಕರುಕ್ ಧಾಡ್ಲ್ಯಾರ್ಬಿ, ಜೊನಾ ತೆಚೆ ಗೊಸ್ಟ್ ಆಯ್ಕಿ ನಸ್ತಾನಾ ನಿನವೆಕ್ ವಿರುದ್ದ್ ಹೊತ್ತ್ಯಾ ದಿಕ್ಕಾಕ್ ಪರ್ಯಾನ್ ಕರ್ಲ್ಯಾನ್.<char style="xt"><ref loc="JON 1:1-3">1:1-3</ref> </char> ತೊ ತಾರ್ಶಿಸ್ ಶಾರಾಕ್ ಜಾತಲ್ಯಾ ಡೊನಾತ್ ಚಡ್ಲೊ. ಡೊನ್ ತಾರ್ಶಿಸಾಕ್ ಜಾತಾನಾ ದೆವಾನ್ ಮೊಟೆ ವಾರೆ ವಾದಾಳ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್. ಡೊನ್ ಚಾಲ್ವುನಾರೆ ಲೈ ಭಿಂಯ್ಯಾಲೆ. ಅನಿ ದೆವಾಚೊ ರಾಗ್ ಥಂಡ್ ಕರುಕ್ ಸಾಟ್ನಿ ತೆನಿ ತೆಕಾ ಸಮುಂದರಾತ್ ಟಾಕ್ಲ್ಯಾನಿ. ತನ್ನಾ ಜೊನಾಕ್ ಗಿಳುಕ್ ಸಾಟ್ನಿ ಮೊಟಿ ಮಾಸೊಳಿ ಧಾಡುನ್ ದಿಲ್ಯಾನ್. ತನ್ನಾ ಜೊನಾಚೊ ಮನ್ ಬದಲ್ತಾ. ಅನಿ ದೆವಾನ್ ತೆಕಾ ಝಿತ್ತೆ ಥವ್ತಾ. ಆಕ್ರಿಕ್ ಜೊನಾ ನಿನೆವೆಕ್ ಜಾವ್ನ್ ದೆವಾಚೆ ವಚನ್ ಸಾಂಗ್ತಾನಾ ನಿನಿವೆಚ್ಯಾ ಲೊಕಾನಿ ಮನ್ ಬದ್ಲುನ್ ಘೆಟ್ಲ್ಯಾನಿ. ಜೊನಾಕ್ ದೆವಾನ್ ದಯಾ ದಾಕ್ವುತಲೆ ಮನ್ ನತ್ತೆ, ಜ್ಯಾಲ್ಯಾರ್ಬಿ ದೆವ್ ದಯಾ ಮಾಯಿ ಮನುನ್ ಹ್ಯಾ ಪುಸ್ತಕಾತ್ ದಿಸುನ್ ಯೆತಾ.<char style="xt"><ref loc="JON 4:2">4:2</ref> </char></para>
  <para style="iot">ಭಾಗಾ</para>
  <para style="io1">1. ಜೊನಾ ದೆವಾಕ್ನಾ ಪಳುನ್ ಗೆಲ್ಲೆ. ಅನಿ ಆಕ್ರಿಕ್ ಮಾಸೊಳಿಚ್ಯಾ ಪೊಟಾತ್ ಪಾವಲ್ಲ್ಯಾ ವಿಶಯಾತ್ ಸಾಂಗ್ತಾ. <char style="ior"><ref loc="JON 1">1</ref> </char></para>
  <para style="io1">2. ಮಾಸ್ಳಿಚ್ಯಾ ಪೊಟಾತ್ ಜೊನಾನ್ ದೆವಾಕ್ ಮಾಗ್ನಿ ಕರಲ್ಲೆ <char style="ior"><ref loc="JON 2">2</ref> </char></para>
  <para style="io1">3. ಜೊನಾ ನಿನಿವೆತ್ ಪರ್ಗಟ್ ಕರ್ಲ್ಯಾನ್. ಅನಿ ಲೊಕಾನಿ ಮನ್ ಬದಲ್ಲ್ಯಾನಿ, ಅನಿ ದೆವಾನ್ ತೆಂಕಾ ಮಾಪ್ ಕರ್ಲ್ಯಾನ್.<char style="ior"><ref loc="JON 3">3</ref> </char></para>
  <para style="io1">4. ನಿನಿವೆಚ್ಯಾ ಲೊಕಾಕ್ನಿ ದಯಾ ದಾಕ್ವಲ್ಯಾ ಸಾಟ್ನಿ ಜೊನಾಕ್ ರಾಗ್ ಯೆಲೊ.ಅನಿ ದೆವಾನ್ ಅಪ್ನಿ ಸಗ್ಳ್ಯಾಂಚೊ ಪ್ರೆಮ್ ಕರ್‍ತಾ ಮನುನ್ ದೆವ್ ಜೊನಾಕ್ ಸಾಂಗ್ತಾ. <char style="ior"><ref loc="JON 4">4</ref> </char></para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">ಜೊನಾ ದೆವಾಕ್ ಮಾನಿನಸಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />ಎಕ್ ದಿಸಿ ಅಮಿತ್ತ್ಯ್ ಚೊ ಲೆಕ್ ಜೊನಾಕ್, ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚೆ ಧನ್ ಆಯಿಕ್ಲೆ, ತೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್: <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />ಉಟ್, ಅನಿ ನಿನಿವೆ ಶಾರಾಕ್ ಜಾವ್ನ್ ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ತೆಂಚ್ಯಾ ಬುರ್ಸ್ಯಾಪಾನಾಚಿ ಖಬರ್ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಯೆವ್ನ್ ಪಾವ್ಲಾ ಮನುನ್ ಸಾಂಗ್. <verse eid="JON 1:2" /><verse number="3" style="v" sid="JON 1:3" />ಖರೆ ಜೊನಾ ಉಟುನ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ನಾ ಪಳುನ್ ಜಾವ್ಕ್ ಸಾಟ್ನಿ ತಾರ್ಶಿಸಿಕ್ಡೆ ಗೆಲೊ. ತೊ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ನಾ ಧುರ್ ಜಾವ್ಕ್ ಸಾಟ್ನಿ, ಜೊಪ್ಪಾಕ್ ಜಾವ್ನ್, ತಾರ್ಶಿಸಿಕ್ ಜಾತಲಿ ಢೊನ್ ಚಡುನ್, ಪರ್ಯಾನಾಚೆ ಪಯ್ಸೆ ದಿವ್ನ್ ಬಸ್ಲೊ.<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />ಅಶೆ ಢೊನ್ ಜಾವ್ನಗೆತ್ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಸಮುಂದರಾತ್ ಮೊಟ್ಟೊ ವಾರೊ ಉಟಿ ಸಾರ್ಕೊ ಕರ್‍ಲ್ಯಾನ್, ತ್ಯಾ ವಾರ್ಯಾ-ವಾದಾಳಾತ್ ಗಾವುನ್ ಢೊನ್ ಫುಟ್ತಾ ಸರ್ಕಿ ಹೊಲಿ. <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />ಢೊನ್ ಚಾಲ್ವುತಲಿ ಲೊಕಾ ಭಿಂಯ್ಯಾಲಿ, ಅನಿ ಅಪ್ಲ್ಯಾ-ಅಪ್ಲ್ಯಾ ದೆವಾಕ್ಡೆ ಕುಕ್ ಮಾರ್ಲ್ಯಾನಿ, ಢೊನಾಚೆ ವಜ್ಜೆ ಕಮಿ ಕರುಕ್ ಢೊನಾತ್ಲಿ ಸಾಮಾನಾ ಪಾನಿಯಾತ್ ಟಾಕ್ಲ್ಯಾನಿ, ಖರೆ ಜೊನಾ ಹಿಕ್ಡಿ ಢೊನಾತ್ ಖಾಯ್ಲ್ಯಾ ಭಾಜುಕ್ ಜಾವ್ನ್ ಘಟ್ ನಿಜಲ್ಲೊ.<verse eid="JON 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 1:6" />ಢೊನ್ ಚಾಲ್ವುತಲ್ಯಾಂಚೊ ಮುಖಂಡ್ ಜೊನಾ ನಿಜಲ್ಯಾಕ್ಡೆ ಯೆವ್ನ್, ಜೊನಾಕ್ ಉಟ್ವುನ್ “ಅರೆ! ಅಶೆ ಕಶೆ ನಿಜ್ಲೆ ತಿಯಾ? ಉಟ್, ಅನಿ ತುಜ್ಯಾ ದೆವಾಕ್ಡೆ ಮಾಗ್ನಿಕರ್ ಖೈ ತರ್ ತುಜ್ಯಾ ದೆವಾನ್ ಅಮ್ಕಾ ಹ್ಯಾ ತರಾಸಾತ್ನಾ ಹುರ್ವಿಲ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />ತನ್ನಾ ಢೊನ್ ಚಾಲ್ವುತಲ್ಯಾನಿ ಎಕಾಮೆಕಾಕ್ ಹ್ಯೊ ತರಾಸ್ ಅಮ್ಚೆ ವರ್‍ತಿ ಯೆವ್ಕ್ ಕಾರನ್ ಕೊನ್ ಮನುನ್ ಚಿಟಿಯಾ ಕಾಡುನ್ ಬಗುಂವಾ ಮಟ್ಲ್ಯಾನಿ. ಅನಿ ಚಿಟಿಯಾ ಕಾಡ್ಲ್ಯಾನಿ ತನ್ನಾ ಚಿಟಿ ಜೊನಾಚ್ಯಾಚ್ ನಾವಾರ್ ಯೆಲಿ. <verse eid="JON 1:7" /><verse number="8" style="v" sid="JON 1:8" />ತನ್ನಾ ತ್ಯಾ ಢೊನ್ ಚಾಲ್ವುತಲ್ಯಾನಿ, “ಹೆ ತರಾಸ್ ಅಮ್ಚೆ ವರ್‍ತಿ ಯೆವ್ಕ್ ಕಾರನ್ ಕಾಯ್ ಮನುನ್ ಸಾಂಗ್, ತಿಯಾ ಕಾಯ್ ಕಾಮ್ ಕರ್ತೆ? ತಿಯಾ ಖಯ್ತ್ನಾ ಯೆಲೆ? ತುಜೊ ದೆಶ್ ಖಲೊ? ತಿಯಾ ಖಲ್ಯಾ ಲೊಕಾಂಚೊ?” ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />“ಮಿಯಾ ಹೆಬ್ರೆವಾಚೊ, ಸಮುಂದರ್ ಅನಿ ಜಿಮಿನ್, ಮಳಬಾಕ್ನಿ ರಚಲ್ಲ್ಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಭಿಂವ್ನ್ ಚಲ್ತಲೊ.” <verse eid="JON 1:9" /><verse number="10" style="v" sid="JON 1:10" />ದೆವಾಕ್ ಚುಕ್ವುನ್ ಪಳುನ್ ಜಾವ್ಕ್ ಮನುನ್ ಹ್ಯಾ ಢೊನಾತ್ ಚಡುನ್ ಯೆಲ್ಲೊ, ಮನುನ್ ಜೊನಾನ್ ಸಾಂಗ್ಲ್ಯಾನ್.</para>
  <para style="p" vid="JON 1:10">ತನ್ನಾ ತೆನಿ ಲೈ ಭಿಂಯ್ಯಾಲೆ, ಅನಿ “ಹೆ ಕಾಯ್ ಕರ್‍ಲೆ ತಿಯಾ!” ಮಟ್ಲ್ಯಾನಿ. <verse eid="JON 1:10" /><verse number="11" style="v" sid="JON 1:11" />ಖರೆ ಹಿಕ್ಡಿನ್ ಸಮುಂದರಾತ್ಲೆ ವಾರೆ ವಾದಾಳ್ ಲೈಚ್ ಹೊವ್ಕ್ ಲಾಗಲ್ಲೆ “ಸಮುಂದರ್ ಥಂಡ್ ಹೊವ್ಚೆ ತರ್ ತುಕಾ ಅತ್ತಾ ಅಮಿ ಕಾಯ್ ಕರುಚೆ?” ಮನುನ್ ತೆನಿ ಜೊನಾಕ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />ತನ್ನಾ, “ಹೆ ವಾರೆವಾದಾಳ್ ತುಮ್ಚೆ ವರ್‍ತಿ ಯೆವ್ಕ್ ಮಿಯಾಚ್ ಕಾರನ್ ಮನುನ್ ಮಾಕಾ ಗೊತ್ತ್ ಹಾಯ್, ಎಕ್ ಕಾಮ್ ಕರಾ ಮಾಕಾ ತುಮಿ ಸಮುಂದರಾತ್ ಟಾಕುನ್ ಸೊಡಾ, ತನ್ನಾ ಸಮುಂದರ್ ಥಂಡ್ ಹೊತಾ,” ಮಟ್ಲ್ಯಾನ್.<verse eid="JON 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13" />ಜೊನಾಕ್ ಸಮುಂದರಾತ್ ಟಾಕುಕ್ ತೆಂಕಾ ಮನ್ ನತ್ತೊ, ತಸೆ ಮನುನ್ ತೆನಿ ಢೊನ್ ದಂಡೆಕ್ ಘೆವ್ನ್ ಜಾವ್ಕ್ ಕಟ್ಪಟ್ ಕರ್‍ಲ್ಯಾನಿ, ಖರೆ ತೆಂಚ್ಯಾನ್ ಹೊವ್ಕ್ ನಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಸಮುಂದರಾಚಿ ಲ್ಹಾಟಾ ಲೈ ಮಾರುಕ್ ಲಾಗಲ್ಲಿ. <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />ತನ್ನಾ ತೆನಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಕುಕ್ ಮಾರ್‍ಲ್ಯಾನಿ, “ಸರ್ವೆಸ್ಪರಾ ಹ್ಯಾ ಜೊನಾ ಮನ್ತಲ್ಯಾ ಮಾನ್ಸಾಕ್ ಲಾಗುನ್ ಅಮ್ಕಾ ನಾಶ್ ಕರುನಕ್ಕೊ, ಅಮ್ಕಾ ಹ್ಯಾ ಚುಕ್ ನಸಲ್ಲ್ಯಾ ಮಾನ್ಸಾಚ್ಯಾ ರಗ್ತಾಚೆ ಕಾರನ್ ಹೊವ್ಕ್ ದಿವ್‍ ನಕ್ಕೊ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಹೆ ಸಗ್ಳೆ ತುಜ್ಯಾ ಮನಾ ಸಾರ್ಕೆ ಹೊವ್ಲಾ ನ್ಹಯ್” <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />ಮಾನಾ ತೆನಿ ಜೊನಾಕ್ ಉಕ್ಲುನ್ ಸಮುಂದರಾತ್ ಟಾಕ್ಲ್ಯಾನಿ, ತನ್ನಾ ಸಮುಂದರ್ ಅಪ್ನಾಚೊ ಅರ್ಬಾಟ್ ಸೊಡುನ್ ಥಂಡ್ ಹೊಲೊ. <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />ಹೆ ಸಗ್ಳೆ ಬಗುನ್ ತಿ ಲೊಕಾ ಸರ್ವೆಸ್ಪರಾ ವರ್‍ತಿ ವಿಶ್ವಾಸ್ ಕರುಕ್ ಲಾಗ್ಲಿ, ಅನಿ ದೆವಾಕ್ ಭಿಂಯ್ಯಾಲಿ ಅನಿ ಬಲಿ ಭೆಟ್ವುನ್ ಮಾಗ್ನಿ ಪಾವ್ಸುತಾತ್.<verse eid="JON 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17" />ದೆವಾನ್ ಸಮುಂದರಾತ್ ಅದ್ದಿಚ್ ಎಕ್ ಮೊಟ್ಟಿ ಮಾಸ್ಳಿ ತಯಾರ್ ಕರುನ್ ಥವಲ್ಲ್ಯಾನ್, ತ್ಯಾ ಮಾಸ್ಳಿನ್ ಜೊನಾಕ್ ಗಿಳ್ಳಿನ್, ತಿನ್ ದಿಸಾ ಪತರ್, ದಿಸ್ ರ್‍ಹಾತ್ ಜೊನಾ ಮಾಸ್ಳಿಚ್ಯಾ ಪೊಟಾತ್ ರ್‍ಹಾಲೊ.<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">ಜೊನಾಚಿ ಮಾಗ್ನಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />ತನ್ನಾ ಜೊನಾ ಮಾಸ್ಳಿಚ್ಯಾ ಪೊಟಾತ್ನಾ ಅಪ್ನಾಚೊ ಸರ್ವೆಸ್ಪರ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಅಸೆ ಮಾಗ್ನಿ ಕರ್‍ತಾ;<verse eid="JON 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JON 2:2" />“ಮಿಯಾ ಮಾಜ್ಯಾ ತರಾಸಾತ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಕುಕ್ ಮಾರ್ಲೊ,</para>
  <para style="q2" vid="JON 2:2">ಅನಿ ತೆನಿ ಮಾಕಾ ಜಾಬ್ ದಿಲ್ಯಾನ್.</para>
  <para style="q2" vid="JON 2:2">ಪಾತಾಳಾಚ್ಯಾ ಪೊಟಾತ್ನಾ ಕುಕ್ ಮಾರ್ಲೊ,</para>
  <para style="q2" vid="JON 2:2">ತಿಯಾ ಮಾಜೊ ಆವಾಜ್ ಆಯ್ಕ್ಲೆ.<verse eid="JON 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತಿಯಾ ಮಾಕಾ ಸಮುಂದರಾಚ್ಯಾ ಮಟ್ ಮದ್ದಿ ಖೊಲಾತ್ ಘಾಟ್ಲೆ;</para>
  <para style="q2" vid="JON 2:3">ಹೊಂವಾರ್ಯಾನಿ ಮಾಕಾ ಘೆರೊ ಘಾಟ್ಲ್ಯಾನಿ;</para>
  <para style="q2" vid="JON 2:3">ಮೊಟಿ-ಮೊಟಿ ಲ್ಹಾಟಾ ಮಾಜೆ ವೈನಾ ಗೆಲಿ;<verse eid="JON 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4" />ತನ್ನಾ ತುಜ್ಯಾ ಡೊಳ್ಯಾಂಚ್ಶಾ ಇದ್ರಾಕ್ನಾ ಮಾಕಾ</para>
  <para style="q2" vid="JON 2:4">ಭಾಯ್ರ್ ಘಾಟಲ್ಲೆ ಹಾಯ್ ಕಾಯ್ಕಿ ಮನುನ್ ಚಿಂತ್ಲೊ,</para>
  <para style="q2" vid="JON 2:4">ಜಾಲ್ಯಾರ್ಬಿ ತುಜ್ಯಾ ಪವಿತ್ರ್ ಗುಡಿಕ್ಡೆ ಮಿಯಾ ಪರ್‍ತುನ್ ಬಗ್ತಾ;<verse eid="JON 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5" />ಮಾಜ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ಪಾನಿಯಾನ್ ಜಿವ್ ಕಾಡುಚೆ ಮನುನ್ ಘೆರೊ ಘಾಟ್ಲ್ಯಾನ್,</para>
  <para style="q2" vid="JON 2:5">ದರ್ಯಾಚ್ಯಾ ಪಾನಿಯಾನ್ ಮಾಕಾ ಬುಡ್ವುನ್ ಧರ್ಲ್ಯಾನ್;</para>
  <para style="q2" vid="JON 2:5">ಜವ್ಳ್ ಧರಲ್ಲಿ ಝಾಡಾ ಮಾಜ್ಯಾ ಟಕ್ಲ್ಯಾಕ್ ಯೆವ್ನ್ ಗುಸ್ಮಟ್ಲಿ;<verse eid="JON 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6" />ಮಡ್ಡಿಯಾಂಚ್ಯಾ ಮುಳಾತ್ ಸಗೊಳ್ ಉತ್ರುನ್ ಮಿಯಾ ಗೆಲೊ.</para>
  <para style="q2" vid="JON 2:6">ಜಗಾಚಿ ದಾರಾ ಮಾಜ್ಯಾ ಪಾಟಿ ಶಾಶ್ವತಾನಿ ಧಾಪ್ಲಿ,</para>
  <para style="q2" vid="JON 2:6">ಹೊಲ್ಯಾರ್ಬಿ ತಿಯಾ ಮಾಜೊ ಜಿವ್ ತ್ಯಾ ಖೊಲಾತ್ನಾ ವರ್‍ತಿ ಉಕಲ್ಲೆ, ಮಾಜ್ಯಾ ದೆವಾ ಸರ್ವೆಸ್ಪರಾ.<verse eid="JON 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7" />ಮಾಜೊ ಜಿವ್ ಮಾಜ್ಯಾ ಭುತ್ತುರುಚ್ ಜಿರುನ್ ಗೆಲ್ಲ್ಯಾ ತನ್ನಾ</para>
  <para style="q2" vid="JON 2:7">ಸರ್ವೆಸ್ಪರಾ ಮಿಯಾ ತುಕಾ ಯಾದ್ ಕರ್‍ಲೊ,</para>
  <para style="q2" vid="JON 2:7">ಮಾಜಿ ಮಾಗ್ನಿ ತುಜ್ಯಾಕ್ಡೆ ತುಜ್ಯಾ ಪವಿತ್ರ್ ಗುಡಿತ್ ಯೆವ್ನ್ ಪಾವ್ಲಿ.<verse eid="JON 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8" />ಉಪೆಗಾಕ್ ನಸಲ್ಲ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಹೊಂದುನ್ ರಾತಲಿ ಲೊಕಾ</para>
  <para style="q2" vid="JON 2:8">ದೆವಾಚೊ ಪ್ರೆಮ್ ಸೊಡ್ತಾತ್,<verse eid="JON 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಖರೆ ಮಿಯಾ ಸ್ತುತಿ ಗಿತಾನಿ ಸರ್ವೆಸ್ಪರಾ ತುಕಾ ಬಲಿ ಭೆಟ್ವುತಾ,</para>
  <para style="q2" vid="JON 2:9">ಅನಿ ಮಾಗುನ್ ಘೆಟಲ್ಲಿ ಮಾಗ್ನಿ ಮಿಯಾ ದಿತಾ,</para>
  <para style="q2" vid="JON 2:9">ಸಗ್ಳಿ ರಾಕ್ವನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ನಾಚ್ ಯೆತಾ.”<verse eid="JON 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಮಾಸ್ಳಿನ್ ಜೊನಾಕ್ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆರ್ ಯೆವ್ನ್ ವೊಕ್ಲಿನ್.<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">ಜೊನಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಮಾನ್ತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />ತನ್ನಾ ದೊನ್ವೆ ಪಟಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್ ಜೊನಾಕ್ ಆಯ್ಕುನ್ ಅಸೆ ಮನ್ತಾ; <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />“ಉಟ್ ಅನಿ ನಿನಿವೆ ಶಾರಾಕ್ ಜಾ, ಅನಿ ಮಿಯಾ ಸಾಂಗಲ್ಲಿ ಖಬರ್ ತ್ಯಾ ಶಾರ್‍ಹಾತ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ಪರ್ಗಟ್.” <verse eid="JON 3:2" /><verse number="3" style="v" sid="JON 3:3" />ಅಶೆ ಜೊನಾ ಉಟುನ್ ಸರ್ವೆಸ್ಪರಾನ್ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ನಿನಿವೆಕ್ ಜಾತಾ, ತೆ ಶಾರ್ ಎಗ್ದಾ ಫಿರುನ್ ಸಾರುಕ್ ತಿನ್ ದಿಸ್ ಲಾಗ್ತ್ಯಾತ್ ತವ್ಡೆ ಮೊಟೆ ಹೊತ್ತೆ. <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />ಜೊನಾ ಎಕ್ ದಿಸಾಚಿ ವಾಟ್ ಚಲುನ್ಗೆತ್, “ಅನಿ ಖಾಲಿ ಚಾಳಿಸ್ ದಿಸಾ ಹುರ್ಲಾತ್ ದೆವ್ ಹೆ ಶಾರ್ ನಾಸ್ ಕರ್‍ತಾ!” ಮನುನ್ ಪರ್ಗಟ್ ಕರ್ಲ್ಯಾನ್.<verse eid="JON 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 3:5" />ಹೆ ಆಯ್ಕುನ್, ನಿನಿವೆಚಿ ಲೊಕಾ ದೆವಾಚೆರ್ ವಿಶ್ವಾಸ್ಲಿ, ಅನಿ ಸಗ್ಳ್ಯಾ ಲೊಕಾನಿ ಉಪಾಸ್ ಪರ್ಗಟ್ ಕರ್‍ಲ್ಯಾನಿ, ಅನಿ ಬಾರಿಕ್ಲ್ಯಾ ಪೊರಾನಿ ಅನಿ ಮೊಟ್ಯಾ ಲೊಕಾನಿ ಚಿಲಾಚೆ ಫಟೆ ಆಂಗಾರ್ ಧಾಪುನ್ ಘೆಟ್ಲ್ಯಾನಿ.<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />ಹಿ ಖಬರ್ ನಿನಿವೆಚ್ಯಾ ರಾಜಾಕ್ ಬಿ ಜಾವ್ನ್ ಪಾವ್ಲಿ, ತನ್ನಾ ತೆನಿ ಅಪ್ಲೆ ಸಿಂವಾಸನ್ ಸೊಡ್ಲ್ಯಾನ್, ಅನಿ ಅಪ್ಲೆ ಕಪ್ಡೆ ಕಾಡುನ್ ಥವ್ನ್ ಚಿಲಾಚೆ ಫಟೆ ಆಂಗಾರ್ ಘಾಲುನ್ ಘೆವ್ನ್ ರಕ್ಕಾತ್ನಿ ಜಾವ್ನ್ ಬಸ್ಲೊ. <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />ಅನಿ ರಾಜಾನ್ ಸಗ್ಳ್ಯಾ ನಿನಿವೆತ್ ಅಶೆ ಮನುನ್ ಪರ್ಗಟ್ ಕರುಕ್ ಅಪ್ಲ್ಯಾ ಸೆವಕಾಕ್ನಿ ಹುಕುಮ್ ದಿಲ್ಯಾನ್, “ಮಾನ್ಸಾ ಹೊಂವ್ದಿ, ಘರ್‍ಹಾತ್ ಬಾಳಗಲ್ಲಿ ಕಸ್ಲಿ ಬಿ ಜನಾವರಾ ಹೊಂವ್ದಿತ್, ಕಸ್ಲಿಬಿ ರುಚ್ ಬಗಿನಸ್ತಾನಾ ರಾಂವ್ದಿತ್, ಪೊಟಾಕ್ ಖಾಯ್ನಸ್ತಾನಾ ಪಾನಿ ಸಯ್ತ್ ಫಿನಸ್ತಾನಾ ರ್‍ಹಾಂವ್ದಿತ್.” <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />ಮಾನ್ಸಾ ಅನಿ ಬಾಳಗಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಜನಾವರಾಚ್ಯಾ ಆಂಗಾರ್ ಚಿಲಾಚೆ ಫಟೆ ಘಾಲುನ್ ಘೆವ್ನ್ ದೆವಾಕ್ಡೆ ಮಾಗ್ನಿ ಕರಾ, ಸಗ್ಳಿ ಲೊಕಾ ಅಪ್ಲೆ ಬುರ್ಸೆಪಾನ್ ಸೊಡುನ್ ದಿವ್ಚೆ, ಅನಿ ದೆವಾಕ್ಡೆ ಫಾಟಿ ಪರ್ತಾ, <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />ಕೊನಾಕ್ ಗೊತ್ತ್, ಎಕ್ ಎಳಾ ದೆವ್ ಅಪ್ಲೊ ರಾಗ್ ಥಂಡ್ ಕರುನ್ ಘೆವ್ನ್ ಹೊತಲ್ಯಾ ತರಾಸಾತ್ನಾ ಅಮ್ಕಾ ಹುರ್ವುಲ್ಯಾರ್ಬಿ ಹುರ್ವುಲ್ಯಾನ್.<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />ದೆವಾನ್ ನಿನಿವೆಚಿ ಲೊಕಾ ಅಪ್ಲ್ಯಾ ಬುರ್ಸ್ಯಾಪಾನಾತ್ನಾ ಬರ್ಯಾಪಾನಾಕ್ ಫಾಟಿ ಯೆತಲೆ ಬಗಟ್ಲ್ಯಾನ್, ಅನಿ ನಿನಿವೆ ಶಾರ್ ನಾಶ್ ಕರುವಾ ಮನುನ್ ಚಿಂತ್ತಲ್ಲೆ ಅಪ್ಲೆ ಮನ್ ಬದ್ಲುನ್ ಅಪ್ನಿ ತೆಂಕಾ ಕರ್‍ತಾ ಮಟಲ್ಲೆ ನಾಶ್ ಕರುಕ್ ನಾ.<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">ಜೊನಾಚೊ ರಾಗ್ ಅನಿ ದೆವಾಚಿ ಕರಾನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />ಖರೆ ಜೊನಾಕ್ ಬೆಜಾರ್ ಹೊತಾ, ಅನಿ ರಾಗ್ ಯೆತಾ. <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />ತೆಚೆ ಸಾಟ್ನಿ ದೆವಾಕ್ಡೆ ಮಾಗ್ನಿ ಕರುನ್, “ಒ, ಸರ್ವೆಸ್ಪರಾ ಮಿಯಾ ಮಾಜ್ಯಾ ದೆಸಾತ್ ರ್‍ಹಾತಾನಾಚ್ ಮಿಯಾ ಅಸೆ ಸಾಂಗಟಲ್ಲೊ ನ್ಹಯ್ , ತಸೆ ಮನುನ್ ಮಿಯಾ ತನ್ನಾ ತಾರ್ಶಿಸಾಕ್ ಪಳುನ್ ಜಾವ್ಕ್ ಲಾಗಲ್ಲೊ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತಿಯಾ ಲೈ ದಯಾಳ್ ಅನಿ ಕರಾನ್ ದಾಕ್ವುತಲೊ, ಸೊಸುನ್ಗೆತಲೊ ಅನಿ ಲೈ ಪ್ರೆಮಾನ್ ಭರಲ್ಲೊ ದೆವ್, <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />ತಸೆಹೊವ್ನ್ ಸರ್ವೆಸ್ಪರಾ, ಅತ್ತ್ಯಾಚ್ ಮಾಚೊ ಜಿವ್ ಕಾಡ್, ಮಿಯಾ ರ್‍ಹಾತಲ್ಯಾ ಬದ್ಲಾಕ್ ಮರಲ್ಲೆಚ್ ಬರೆ ಮಟ್ಲ್ಯಾನ್.”<verse eid="JON 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ , “ತಿಯಾ ಅಶೆ ರಾಗ್ ಕರುನ್ ಘೆತಲೆ ಸಮಾ ನ್ಹಯ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />ತನ್ನಾ, ಜೊನಾ ತೆ ಶಾರ್ ಸೊಡುನ್ ತ್ಯಾ ಶಾರಾಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಗೆಲೊ, ಥೈ ಎಕ್ ಝೊಪ್ಡೆ ಘಾಲುನ್ ಘೆವ್ನ್ ಕಾಯ್ ಹೊತಾ ಬಗುನ್ಗೆತ್ ಝೊಪ್ಡ್ಯಾತ್ ಬಸ್ಲೊ. <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಯೆಲ್ ಉಗ್ವಿ ಸರ್ಕೆ ಕರ್‍ಲ್ಯಾನ್, ತಿ ಯೆಲ್ ಜೊನಾಚ್ಯಾ ಟಕ್ಲ್ಯಾಕ್, ಸಾವ್ಳಿ ದಿವ್ ಲಾಗಲ್ಲೆ, ಹೆಕಾ ಲಾಗುನ್ ತೊ ಲೈ ಖುಶಿ ಹೊತಾ. <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />ದುಸ್ರ್ಯಾ ದಿಸಿ ದಿಸಾ ಉಜ್ವಾಡ್ತಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ತ್ಯಾ ಯೆಲಿಕ್ ಖಾವ್ಕ್ ಎಕ್ ಕಿಡೊ ತಯಾರ್ ಕರ್‍ಲ್ಯಾನ್.ಅನಿ ತ್ಯಾ ಕಿಡ್ಯಾನ್ ತ್ಯಾ ಯೆಲಿಕ್ ಚಾವ್ಲ್ಯಾನ್ ತಿ ವಾಳುನ್ ಗೆಲಿ. <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />ದಿಸ್ ವೈರ್ ಚಡುನ್ಗೆತ್ ಯೆತಾನಾ, ಸರ್ವೆಸ್ಪರಾನ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ಹುನ್ನ್ ವಾರೊ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್‍ತಾ. ತನ್ನಾ ಲಿಂಬಾರ್ ಜೊನಾಚ್ಯಾ ಟಕ್ಲ್ಯಾ ವರ್‍ತಿ ಪಡ್ತಾ ಅನಿ ತೊ ನಿರ್ಮೊಳಿ ಯೆವ್ನ್ ಪಡ್ತಾ, ಅನಿ ಮರಾನ್ ಮಾಗ್ಲ್ಯಾನ್, ಅನಿ “ಮಿಯಾ ಝಿತ್ತೊ ರ್‍ಹಾತಲ್ಯಾ ಕಿಂತಾ, ಮರಲ್ಲೆಚ್ ಬರೆ” ಮಟ್ಲ್ಯಾನ್.<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />ತನ್ನಾ ಜೊನಾಕ್ ದೆವ್ ಮನ್ತಾ, “ಜೊನಾ ತಿ ಯೆಲ್ ಮರ್ಲಿ ಮನುನ್ ತಿಯಾ ಎವ್ಡೊ ರಾಗ್ ಕರುನ್ ಘೆತಲೊ ಸಮಾ ಕಾಯ್? ಸಾಂಗ್ ಬಗುವಾ,” ತನ್ನಾ ಜೊನಾ, “ಹೊಯ್ ಮಿಯಾ ಮರಿ ಸರ್ಕೊ ರಾಗ್ ಕರುನ್ ಘೆತಲೆ ಸಮಾ ಹಾಯ್” ಮನ್ತಾ.<verse eid="JON 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10" />ತನ್ನಾ, ಸರ್ವೆಸ್ಪರಾನ್ ತೆಕಾ, ತಿಯಾ ಹ್ಯಾ ಯೆಲಿ ಸಾಟ್ನಿ ಕಾಮ್ ಕರುಕ್ನೆ, ತಿ ವಾಡ್ವುಕ್ಬಿ ನ್ಹಯ್ . ತಿ ಅಪ್ನಿಚ್ ಎಕ್ ರ್‍ಹಾತ್ತಿತ್ ಉಗಾವ್ಲಿ. ಎಕುಚ್ ರ್‍ಹಾತ್ತಿತ್ ಬಾವ್ನ್ ಗೆಲಿ. ತೆಜ್ಯಾ ಸಾಟ್ನಿ ಯೆವ್ಡೆ ಲೈ ಕಾಳ್ಜಿ. <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />ಅಸೆ ರ್‍ಹಾತಾನಾ, ಎಕ್ ಲಾಕ್ ವಿಸ್ ಹಾಜಾರಾನ್ಬಿ ಜಾಸ್ತಿ ಅಪ್ನಿ ಕರುಕ್ ಲಾಗಲ್ಲಿ ಬರ್ಯಾ ವಾಯ್ಟಾಚಿ ಅರು ನಸಲ್ಲಿ ಲೊಕಾ, ಅನಿ ಕವ್ಡಿಕಿ ಜನಾವರಾ ಹೊತ್ತ್ಯಾ ಮೊಟ್ಯಾ ನಿನಿವೆ ಶಾರಾಚ್ಯಾ ವಿಶಯಾತ್ ಮಿಯಾ ಅನಿ ಕವ್ಡೆ ದಯಾ ದಾಕ್ವುಚೆ? ಸಾಂಗ್ ಬಗುಂವಾ, ಮಟ್ಲ್ಯಾನ್.<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>