<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">-Siddi</book>
  <para style="h">ಒಬದ್ಯ</para>
  <para style="toc3">ಒಬ</para>
  <para style="toc2">ಒಬದಿಯಾ</para>
  <para style="toc1">ಒಬದಿಯಾ ಪರ್‍ವಾದ್ಯಾಚೆ ಪುಸ್ತಕ್</para>
  <para style="mt2">ಒಬದಿಯಾ ಪರ್‍ವಾದ್ಯಾಚೆ ಪುಸ್ತಕ್</para>
  <para style="mt1">ಒಬದಿಯಾ ಪರ್‍ವಾದ್ಯಾಚೆ ಪುಸ್ತಕ್</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ಹ್ಯಾ ಪುಸ್ತಕಾತ್ ಒಬದಿಯಾಚೆ ಪರ್‍ವಾದನ್ ಹಾಯ್. ಒಬದಿಯಾಚಿ ಖಬರ್ ಎಸಾವಾಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ಎದೊಮಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವಿರೊದ್ ಝಡ್ತಿ ಪರ್ಗಟ್ತಾ. ಒಬದಿಯಾಚೆ ಪುಸ್ತಕ್ ಕನ್ನಾ ಲಿವ್ನ್ ಹೊಲಾ ಮನುನ್ ಬುದ್ವಂತಾಕ್ನಿ ಸಮಾ ಕಳಲ್ಲೆ ನಾ. ಹೆ ಬಾಬಿಲೊನಾನ್ ಜರುಜಲೆಮಾಕ್ ಆಕ್ರಮನ್ ಕರಲ್ಲ್ಯಾ ಎಳಾರ್ ಹೊವ್ಕ್ ಫಿರೆ. ಮಟ್ಲ್ಯಾರ್ ತ್ಯಾ ಎಳಾರ್ ಎದೊಮಾಚ್ಯಾ ಲೊಕಾನಿ ಇಜ್ರಾಯೆಲಾಚ್ಯಾಕ್ನಿ ಮಜತ್ ಕರುಕ್ನಾತ್. ಹೆ ಖರೆ ಹೊಲ್ಯಾರ್, ಹೆ ಪುಸ್ತಕ್ ಕ್ರಿಸ್ತ್ ಪುರ್ವ್ ಸಾಸೆ ವರ್ಸಾಚ್ಯಾ ಆಸ್ ಪಾಸ್ ಲಿವಲ್ಲೆ ರ್‍ಹಾವ್ಕ್ ಫಿರೆ.</para>
  <para style="ip">ಒಬದ್ದ್ಯಾ ಅದ್ದಿ ಎದೊಮಾಚ್ಯಾ ವಿರೊಧ್ ಝಡ್ತಿ ಪರ್ಗಟ್ತಾ, ಖರೆ ಪಂದ್ರಾವ್ಯಾ ವಚನಾತ್ ಸಗ್ಳ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿಬಿ ಹಿ ಝಡ್ತಿ ಪಗಳ್ತಾ. ಆಕ್ರಿಕ್ ಒಬದಿಯಾ ಎಗ್ದಾ ಇಜ್ರಾಯೆಲಾಚಿ ಬಂಧಿಹೊಲ್ಲಿ ಲೊಕಾ ಪರ್‍ತುನ್ ಯೆವ್ನ್ ಅಪ್ನಾಚಿ ಜಿಮಿನ್ ಪರ್‍ತುನ್ ಕಾಡುನ್ ಘೆತಾತ್ ಮನುನ್ ಸಾಂಗ್ತಾ.</para>
  <para style="iot">ಭಾಗಾ</para>
  <para style="io1">1. <char style="ior"><ref loc="OBA 1:1-14">1—14</ref> </char> ವಚನಾತ್ನಿ ಎದೊಮಾಚ್ಯಾ ವರ್‍ತಿ ಝಡ್ತಿ ಪರ್ಗಟ್ ಕರುನ್ ಹೊತಾ.</para>
  <para style="io1">2. <char style="ior"><ref loc="OBA 1:15-21">15—21</ref> </char> ವಚನಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ಅಪ್ನಾಚ್ಯಾ ಘಮಂಡಿ ಸಾಟ್ನಿ ಝಡ್ತಿ ಹೊತಾ ಅನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಬಂಧಿತ್ನಾ ಪರ್‍ತುನ್ ಯೆವ್ನ್ ಅಪ್ನಾಚಿ ಜಿಮಿನ್ ತಾಬೆತ್ ಕರುನ್ ಘೆತಾತ್. ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಎದೊಮಾಚ್ಯಾ ಜಿಮ್ನಿಚ್ಯಾ ವರ್‍ತಿಬಿ ರಾಜ್ವಡ್ಕಿ ಚಾಲು ಕರ್‍ತಾತ್ ಮನುನ್ ಕಳ್ವುತಾತ್.</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />ಒಬದಿಯಾನ್ ಬಗಟಲ್ಲೆ ಸರ್ವೆಸ್ಪರಾಚೆ ದರ್ಶನ್, ಎದೊಮ್ ದೆಶಾಚ್ಯಾ ವಿಶಯಾತ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೆ ಮನ್ತಾ.</para>
  <para style="s" vid="OBA 1:1">ಸರ್ವೆಸ್ಪರ್ ದೊಮಾಕ್ ಶಿಕ್ಷಾ ದಿತಲೆ</para>
  <para style="q1" vid="OBA 1:1">ಸರ್ವೆಸ್ಪರಾಕ್ನಾ ಯೆಲ್ಲಿ ಖಬರ್ ಅಮಿ ಆಯಿಕ್ಲಾಂವ್, ತೆನಿ ಧುತ್ಯಾಚ್ಯಾ ವೈನಾ ದೆಸಾಕ್ನಿ ಅಸೆ ಸಾಂಗುನ್ ಧಾಡ್ಲಾ:</para>
  <para style="q2" vid="OBA 1:1">“ಜಾವಾ, ಎದೊಮಾಚ್ಯಾ ವರ್‍ತಿ ಝಗ್ಡೊ ಕರುಕ್ ಜಾಂವಾ”.<verse eid="OBA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />“ಎದೊಮಾ, ಅಬಕ್,</para>
  <para style="q2" vid="OBA 1:2">ತುಕಾ ಕಳಿನಸಲ್ಲ್ಯಾ ದೆಶಾಂಚ್ಯಾನ್ಕಿಬಿ ಕಮಿಚೊ ಕರ್‍ತಾ.</para>
  <para style="q2" vid="OBA 1:2">ತಿಯಾ ತಿರಸ್ಕಾರಾಕ್ ಗುರಿ ಹೊಲೆ.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />ತುಜ್ಯಾ ಘಮಂಡಿನ್ ತುಕಾ ಪಶ್ವುಲಾ.” ಲೈ ವೈಲ್ಯಾ ಜಾಗ್ಯಾವರ್‍ತಿ ವಸ್ತಿ ಹಾಯ್; ಗುಂಡ್ಯಾಂಚ್ಯಾ ಖಾಚಿಯಾತ್ನಿ ಘಟ್ ಹಾಯ್; ಮಾಕಾ ಜಿಮ್ನಿಕ್ ಉತ್ರುಕ್ ಲಾವ್ನಾರೊ ಕೊನ್? ಮನುನ್ಗೆತ್ ಹಾಸ್.<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />ಘಾರ್ ಕೆವ್ಡೆ ವರ್‍ತಿ ಹುಡ್ತಾ ತವ್ಡೆ ವರ್‍ತಿ ತಿಯಾ ಹುಡಿತ್ ರಾಲ್ಯಾರ್ಬಿ,</para>
  <para style="q2" vid="OBA 1:4">ಚಿಕ್ಕಿಯಾಂಚ್ಯಾ ಮಂಡಳಾತ್ ರಾಲ್ಯಾರ್ಬಿ,</para>
  <para style="q2" vid="OBA 1:4">ಥೈತ್ನಾ ತುಕಾ ಉತ್ರುಕ್ ಲಾವ್ನಾರ್, ಮನ್ತಾ ಸರ್ವೆಸ್ಪರ್.<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />ತುಜ್ಯಾಕ್ಡೆ ಚೊರಾ ಹೊಂವ್ದಿತ್ ರಾತ್ತಿನ್ ಲುಟ್ನಾರೆ ಹೊಂವ್ದಿತ್ ಯೆಲ್ಯಾರ್</para>
  <para style="q2" vid="OBA 1:5">ತೆನಿ ಅಪ್ನಾಕ್ ಪಾಜೆ ಹೊಲ್ಲೆ ತವ್ಡೆಚ್ ಘೆವ್ನ್ ಜಾಯ್ ಹೊತ್ತೆ ನ್ಹಯ್?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />ಖರೆ ಎಸಾವಾಚಿ ಸಗ್ಳಿ ಆಸ್ತಿ ಫುರಾ ಲುಟ್ ಹೊಲಾ.<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />ತುಜ್ಯಾ ವಾಂಗ್ಡಿಯಾನಿಚ್ ತುಕಾ ಫಾಟ್ ಲಾಗ್ಲಾತ್.</para>
  <para style="q2" vid="OBA 1:7">ತುಕಾ ಗಡಿಚ್ಯಾ ಭಾಯ್ರ್ ಡಕ್ಲುನ್ ಟಾಕ್ಲಾತ್.</para>
  <para style="q1" vid="OBA 1:7">ತುಜ್ಯಾ ಪಾಜೆ ಹೊಲ್ಲ್ಯಾ ಲೊಕಾನಿಚ್ ತುಕಾ ಪಶ್ವುನ್ ಹಾರ್ವುಲಾತ್.</para>
  <para style="q2" vid="OBA 1:7">ತುಜೊ ಅನ್ನ್ ಖಲ್ಲ್ಯಾ ಲೊಕಾನಿಚ್ ಕಳಿನಸ್ತಾನಾ ತುಕಾ ಪಾಸೊ ಘಾಟ್ಲಾತ್.<verse eid="OBA 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ,</para>
  <para style="q2" vid="OBA 1:8">ತ್ಯಾ ದಿಸಿ ಎದೊಮಾಚ್ಯಾ ಶಾನ್ಯಾ ಮಾನ್ಸಾಕ್ನಿ</para>
  <para style="q2" vid="OBA 1:8">ಎಸಾವಾಚ್ಯಾ ಮಡ್ಡಿಚ್ಯಾ ಬುದ್ವಂತಾಕ್ನಿ ಮಿಯಾ ನಾಶ್ ಕರಿನಸ್ತಾನಾ ಸೊಡ್ತಾ ಕಾಯ್?<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />ತೆಮಾನ್ ಗಾಂವಾ, ತುಜಿ ಝಗ್ಡ್ಯಾಚಿ ಸೈನಿಕಾ ಘಾಬರ್‍ತಾತ್;</para>
  <para style="q2" vid="OBA 1:9">ಎಸಾವಾಚ್ಯಾ ಮಡ್ಡಿಯಾತ್ನಿ ರ್‍ಹಾತಲಿ ಸಗ್ಳಿ ಲೊಕಾ ಮರ್‍ತಾತ್.<verse eid="OBA 1:9" /></para>
  <para style="s">ಎದೊಮಾಚ್ಯಾ ಶಿಕ್ಷಾಕ್ ಕಾರನಾ</para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />“ತುಜೊ ಭಾವ್ ಜಾಕೊಬಾಚ್ಯಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಅಪ್ನಿ ಕರಲ್ಲ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾಕ್ನಿ ತಿಯಾ ಅವ್ಮಾನಾಕ್ ಗಾವ್ಸಿಲ್.</para>
  <para style="q2" vid="OBA 1:10">ಶಾಶ್ವತ್ ನಾಸಾಕ್ ಪಡ್ಸಿಲ್.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />ತುಜ್ಯಾ ಭಾವಾಚಿ ಆಸ್ತಿ ಚೊರಲ್ಲ್ಯಾ ದಿಸಿ ತಿಯಾ ಘಟ್ ಇಬೆ ರಾವ್ನ್ ಬಗಿತ್ ಹೊತ್ತೆ.</para>
  <para style="q2" vid="OBA 1:11">ದುಶ್ರ್ಯಾ ದೆಶಾಚಿ ಲೊಕಾ ತೆಜ್ಯಾ ಶಾರಾಂಚ್ಯಾ ಯೆಸಿತ್ ಗುಸುನ್</para>
  <para style="q2" vid="OBA 1:11">ಜರುಜಲೆಮಾಚ್ಯಾ ಆಸ್ತಿ ಸಾಟ್ನಿ ಚಿಟ್ ಘಾಟಲ್ಲ್ಯಾ ದಿಸಿ ತಿಯಾಬಿ ತೆಂಚ್ಯಾ ಗತಿನ್ ಹೊತ್ತೆ.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />ತುಜ್ಯಾ ಭಾವಾಚ್ಯಾ ಬುರ್ಸ್ಯಾ ದಿಸಿ, ತಿಯಾ ಗಪ್ ಬಗುನ್ಗೆತ್ ಇಬೆ ರ್‍ಹಾತಲೆ ನತ್ತೆ,</para>
  <para style="q2" vid="OBA 1:12">ಜುದಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ನಾಸಾತ್ ಖುಶಿ ಹೊತಲೆ ನತ್ತೆ.</para>
  <para style="q2" vid="OBA 1:12">ತೆಂಚ್ಯಾ ತರಾಸಾತ್ ತಿಯಾ ಬಡಾಯ್ ಕರ್‍ತಲೆ ನತ್ತೆ.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />ಮಾಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ತರಾಸಾಚ್ಯಾ ಎಳಾರ್ ತಿಯಾ ತೆಂಚ್ಯಾ ಶಾರಾಚ್ಯಾ ಯೆಸಿತ್ ಗುಸ್ತಲೆ ನತ್ತೆ.</para>
  <para style="q2" vid="OBA 1:13">ತೆಂಚ್ಯಾ ಆಸ್ತಿಕ್ ತಿಯಾ ಹಾತ್ ಘಾಲ್ತಲೆ ನತ್ತೆ.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />ಚಕ್ವುನ್ ಘೆವ್ನ್ ಜಾತಲ್ಯಾ ತೆಂಕಾ ಜಿವ್ ಕಾಡುಕ್ ಸಾಟ್ನಿ ಕತ್ರಿಯಾತ್ನಿ ಇಬೆರ್‍ಹಾತಲೆ ನತ್ತೆ.</para>
  <para style="q2" vid="OBA 1:14">ಲೈ ತರಾಸಾಚ್ಯಾ ಎಳಾತ್ನಿ ಚುಕ್ವುನ್ ಘೆಟಲ್ಲ್ಯಾಕ್ನಿ ದುಶ್ಮನಾಚ್ಯಾ ಹಾತಿತ್ ಒಪ್ಸುನ್ ದಿತಲೆ ನಕ್ಕೊ ಹೊಲ್ಲೆ.”<verse eid="OBA 1:14" /></para>
  <para style="s">ದೆವ್ ದೆಸಾಕ್ನಿ ಇಚಾರ್‍ನಿ ಕರ್‍ತಾ</para>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />“ಸಗ್ಳ್ಯಾ ದೆಸಾಕ್ನಿಬಿ ಸರ್ವೆಸ್ಪರಾಚೊ ದಿಸ್ ಜಗ್ಗೊಳ್ ಯೆಲಾ.</para>
  <para style="q2" vid="OBA 1:15">ತಿಯಾ ಕರಲ್ಲೆಚ್ ತುಕಾಬಿ ಕರುನ್ ಹೊತಾ.</para>
  <para style="q2" vid="OBA 1:15">ತುಜೆ ಬುರ್ಸೆ ಕಾಮ್ ತುಜ್ಯಾ ಟಕ್ಲ್ಯಾರುಚ್ ಯೆತಾ.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />ಮಾಜ್ಯಾ ಲೊಕಾನು, ಪವಿತ್ರ್ ಮಡ್ಡಿಚ್ಯಾ ವರ್‍ತಿ ಮಾಜ್ಯಾ ಶಿಕ್ಷಾಚೆ ಕೊಡು ಪಾನಿ ಫಿಲ್ಯಾಸಿ.</para>
  <para style="q2" vid="OBA 1:16">ತಸೆಚ್ ಸಗ್ಳ್ಯಾ ದೆಸಾಕ್ನಿಬಿ ಕೊಡು ಪಾನಿ ದಿವ್ನ್ ಹೊತಾ.</para>
  <para style="q2" vid="OBA 1:16">ಹೊಯ್, ಪರ್‍ತುನ್-ಪರ್‍ತುನ್ ಕೊಡುಪಾನಿ ಫಿವ್ನ್ ಝೊಲೆ ಮಾರ್‍ತಾತ್. ಆಕ್ರಿಕ್ ನಾ ಫತ್ತೊ ಹೊತಾತ್.”<verse eid="OBA 1:16" /></para>
  <para style="s">ಇಜ್ರಾಯೆಲಾಚಿ ಜಿಕ್</para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />“ಖರೆ ಚುಕ್ವುನ್ ಘೆಟಲ್ಲಿ ಲೊಕಾ ಸಿಯೊನ್ ಮಡ್ಡಿಚ್ಯಾ ವರ್‍ತಿ ರ್‍ಹಾತಾತ್,</para>
  <para style="q2" vid="OBA 1:17">ತೊ ನಿತಳ್ ಕರಲ್ಲೊ ಜಾಗೊ ಮನ್ವುನ್ ಘೆತಾ.</para>
  <para style="q2" vid="OBA 1:17">ಜಾಕೊಬಾಚ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ ಅಪ್ನಾಚಿ ಸ್ವತಾಚಿ ಆಸ್ತಿ ಪರ್‍ತುನ್ ಅನ್ಬೊಗ್ ಕರ್‍ತಾತ್.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />ಜಾಕೊಬಾಚಿ ಪಿಳ್ಗಿ ಆಗಿಚ್ಯಾ ಸಾರ್ಕಿ;</para>
  <para style="q2" vid="OBA 1:18">ಜುಜೆಚಿ ಪಿಳ್ಗಿ ಪೆಟ್ತಲ್ಯಾ ಆಗಿಚ್ಯಾ ಸಾರ್ಕಿ.</para>
  <para style="q2" vid="OBA 1:18">ಹೆ ದೊನಿಬಿ ಮಿಳುನ್ ಕುಳ್ಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಹೊತ್ತ್ಯಾ ಎಸಾವಾಚ್ಯಾ ಪಿಳ್ಗಿಕ್ ಧಗ್-ಧಗ್ ಆಗ್ ಪೆಟುನ್ ಜಾಳ್ವುನ್ ಟಾಕ್ತಾತ್.</para>
  <para style="q2" vid="OBA 1:18">ಎಸಾವಾಚ್ಯಾ ಪಿಳ್ಗಿತ್ ಕೊನ್ಬಿ ಹುರಿನಾತ್.” ಹಿ ಸರ್ವೆಸ್ಪರಾಚಿ ಗೊಸ್ಟ್.<verse eid="OBA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />“ತನ್ನಾ ನೆಗೆವಾಚಿ ಲೊಕಾ ಎಸಾವಾಚಿ ಮಡ್ಡಿ ಅಧಿನಾತ್ ಕರುನ್ ಘೆತಾತ್.</para>
  <para style="q2" vid="OBA 1:19">ಶೆಫೆಲ್ಹಾಚಿ ಲೊಕಾ ಫಿಲಿಸ್ತಿಯಾಕ್, ಅನಿ ಇಜ್ರಾಯೆಲಾಚಿ ಲೊಕಾ ಎಫ್ರಾಯಿಮ್ ಅನಿ ಸಮರ್ಯಾಚಿ ಜಿಮಿನ್ ಸ್ವತಾಚಿ ಕರುನ್ ಘೆತಾತ್.</para>
  <para style="q2" vid="OBA 1:19">ಬೆಂಜ್ಯಾಮಿನಾಚ್ಯಾ ಘರಾನ್ಯಾಚೆ ಗಿಲ್ಯಾದಾಕ್ ಸ್ವತಾಚೆ ಕರುನ್ಗೆತಾತ್.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />ಬಂಧಿಖಾನ್ಯಾತ್ ಹೊತ್ತ್ಯಾ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಲೊಕಾಂಚೊ ತಾಂಡೊ ಕಾನಾನ್ ದೆಸಾಕ್ ಜೆರಾಪಾತಿಚ್ಯಾ ಪತರ್ ಸ್ವತಾಚೆ ಕರುನ್ಗೆತಾತ್.</para>
  <para style="q2" vid="OBA 1:20">ಸೆಪಾರತ್ ಮನ್ತಲ್ಯಾಕ್ಡೆ ಬಂಧಿ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಜೆರುಜಲೆಮಾಚಿ ಲೊಕಾ ನೆಗೆವಾಚಿ ಶಾರಾ ಸ್ವತಾಚೆ ಕರುನ್ ಘೆತಾತ್.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />ಸುಟ್ಕಾ ಕರ್‍ನಾರೆ ಎಸಾವಾಚ್ಯಾ ಮಡ್ಡಿರ್ ರಾಜ್ವಡ್ಕಿ ಕರ್‍ತಾನಾ ಸಿಯೊನ್ ಮಡ್ಡಿರ್ ಚಡ್ತಾತ್.</para>
  <para style="q2" vid="OBA 1:21">ತನ್ನಾ ರಾಜ್ವಡ್ಕಿ ಸರ್ವೆಸ್ಪರಾಚಿಚ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ.”<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>