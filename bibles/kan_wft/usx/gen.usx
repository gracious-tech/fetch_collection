<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">-Siddi</book>
  <para style="h">ಉತ್ಪತ್ತಿ</para>
  <para style="toc2">ಉತ್ಪತ್ತಿ</para>
  <para style="toc1">ಉತ್ಪತ್ತಿ ಪುಸ್ತಕ್</para>
  <para style="toc3">ಉತ್ಪ</para>
  <para style="mt2">ಆದಿಕಾಂಡ</para>
  <para style="mt1">ಉತ್ಪತ್ತಿ</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ಉತ್ಪತ್ತಿ ಶಬ್ದಾಚೊ ಅರ್ಥ್ “ಶುರು ನಾತರ್ ಚಾಲು” ಅನಿ ಹೆ ಜುನ್ನ್ಯಾ ಕರಾರಾತ್ ಪೈಲೆಚೆ ಪುಸ್ತಕ್ ಹೊವ್ನ್ ಹಾಯ್. ಹೆ ಮುಳಾಕ್ ಹಿಬ್ರು ಬಾಶೆಚ್ಯಾ ಪೈಲೆಚ್ಯಾ ಮನ್ತಲ್ಯಾ ಶಬ್ದಾ ವಾಂಗ್ಡಾ ಶುರು ಹೊತಾ, ಸಗ್ಳೆ ಖೈತ್ನಾ ಶುರು ಹೊಲೆ ಮನುನ್ ದಾಕ್ವುತಾ, ಅನಿ ಲೈ ಕರುನ್ ಮಾನ್ಸಾಕ್ನಾ ದೆವಾಚೊ ಯಾವಾರ್ ಕಸೊ ಶುರು ಹೊಲೊ ಮನ್ತಲೆ ದಾಕ್ವುತಾ,</para>
  <para style="ip">ಹ್ಯಾ ವಿಶಯಾತ್ ಲೈ ಬುದ್ವಂತ್ ಲೊಕಾನಿ ಲೈ ಸಿದ್ದಾಂತಾ ಥವ್ನ್ ಘೆವ್ನ್ ಹಾತ್.ಉತ್ಪತ್ತಿಚೆ ಪುಸ್ತಕ್ ಲಿವಲ್ಲೊ ಮಾನುಸ್ ನಾತರ್ ಮಾನ್ಸಾ ನಿ ತೆ ಕ್ರಿಸ್ತ್ ಉಪ್ಜುಚ್ಯಾ ಅದ್ದಿ ಪಾಂಚಾಕ್ನಾ ಸಾವ್ಯಾ ಶತಮಾನಾತ್ ಮಟ್ಲ್ಯಾರ್, ಕ್ರಿಸ್ತ್ ಉಪ್ಜುಚ್ಯಾ ಅದ್ದಿ ತೆರಾ ಸೆಂಬರಾಕ್ನಾ ಚವ್ದಾ ಸೆಂಬರ್ ವರ್ಸಾತ್ನಿ ಲಿವ್ಕ್ ಫಿರೆ ಮನುನ್ ವಿಶ್ವಾಸ್ ಕರ್‍ತಾತ್.</para>
  <para style="ip">ಬಾಬಿಲೊನಾಚಿ ಲೊಕಾ ಹೆ ಪುಸ್ತಕ್ ಮೊಯ್ಜೆನ್ ಲಿವ್ಲಾ ಮನುನ್ ವಿಶ್ವಾಸ್ ಕರ್‍ತಾತ್, ತಸೆಚ್ ಮೊಯ್ಜೆನ್ ಉತ್ಪತ್ತಿ, ನಿರ್ಗಮನ್ ಅನಿ ಯಾಜಕಕಾಂಡ, ಅರನ್ಯಾ ಕಾಂಡ ಅನಿ ಧರ್ಮೊಪದೆಶ ಕಾಂಡ ಪುಸ್ತಕಾ ಲಿವ್ಲಾ ಮನುನ್ ಸಾಂಪ್ರದಾಯಿಕ್ ವಿಶ್ವಾಸ್ ಕರುನ್ ಹೊತಾ.</para>
  <para style="ip">ಉತ್ಪತ್ತಿಚೊ ಪುಸ್ತಕ್ ಕಿರಿಸ್ತಾಂವಾಕ್ನಿ ಬೈಬಲಾಚೊ ಹುರಲ್ಲೊ ಭಾಗ್ ಅರ್ಥ್ ಕರುನ್ ಘೆವ್ಕ್ ಮಾಹ್ತಿ ದಿತಲೆ ಹೊವ್ನ್ ಹಾಯ್.</para>
  <para style="ip">ಜುನ್ನ್ಯಾ ಅನಿ ನ್ಹವ್ಯಾ ಕರಾರಾತ್ನಿ ಜಗಾತ್ ಪಾಪ್ ಕಸೊ ಗುಸ್ಲೊ ಅನಿ ಮಾನ್ಸಾಕ್ನಿ ಕಾಯ್ ಅವಶ್ಯಾಕತೆ ಹಾಯ್ ಮನ್ತಲೆ ಅಮ್ಕಾ ದಾಕ್ವುತಾ.</para>
  <para style="ip">ರಾಕ್ವನ್ ಕಾರಿ ಮನ್ತಲೊ ಲೊಕಾಕ್ನಿ ಹುರ್ವುತಲಿ ದೆವಾಚಿ ಯೆವ್ಜನ್ ಬಿ ಅಮ್ಕಾ ದಾಕ್ವುತಾ, ಜೆಜುಚ್ಯಾ ವಿಶಯಾಚ್ಯಾ ಪೈಲೆಚ್ಯಾ ಪರ್ವಾದನೆ ವೈನಾ ಹೆ ಬಗುಕ್ ಹೊತಾ.</para>
  <para style="ip">ಜಿಮ್ನಿ ವೈಲ್ಯಾ ಸಗ್ಳ್ಯಾ ರಾಶ್ರ್ಟಾಕ್ನಿ ಆಶಿರ್ವಾದ್ ಕರ್ತಾ ಮನ್ತಲಿ ಅಬ್ರಾಮಾಕ್ ದೆವಾಚಿ ಗೊಸ್ಟ್, <char style="xt" closed="false"><ref loc="GEN 3:15">3:15</ref>. </char><char style="xt" closed="false"><ref loc="GEN 12:13">12:13</ref>.</char></para>
  <para style="iot">ಭಾಗಾ</para>
  <para style="io1">1. ಪಾಟ್ ಎಕ್ ಅನಿ ದೊನಾತ್ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಸರ್ವೆಸ್ಪರಾನ್ ಜಗ್ ಅನಿ ಆದಾಮ್ ಹವ್ವಾಕ್ ರಚ್ಲ್ಯಾನ್.</para>
  <para style="io1">2. ಪಾಟ್ ತಿನಾಕ್ನಾ ಪಾಂಚಾತ್ ಆದಾಮ್ ಹವ್ವಾ ತೆಂಚೊ ಪಾಪ್ ಅನಿ ತೆಂಚಿ ಪಿಳ್ಗಿ ಹೆಚ್ಯಾ ವಿಶಯಾತ್ ಬಗುನ್ ಹೊತಾ.</para>
  <para style="io1">3. ಸಾಕ್ನಾ ನವ್ವ್ಯಾ ಪಾಟಾತ್ನಿ ನೊಯೆ ಅನಿ ಮೊಟ್ಟ್ಯಾ ಹಂವಾರ್ಯಾಚ್ಯಾ ವಿಶಯಾತ್ ಸಾಂಗ್ತಾ.</para>
  <para style="io1">4. ಮಾನಾ ಹೆ ಪುಸ್ತಕ್ ನೊಯೆಚೊ ಎಳ್ ಅನಿ ತೆಜ್ಯಾ ಮಾನಾಚೊ ಎಳ್ ಕಾಯ್ ಹೊಲೊ ಮನ್ತಲೆ ದಾಕ್ವುನ್ ದಿತಾ, ಅಬ್ರಾಮ್ ಅನಿ ಬಾಬೆಲಾಚೆ ಗೊಪುರ್ ಹೆ ಸಗ್ಳೆ ವಿಶಯ್ ಅಮಿ ಧಾ ಅನಿ ಅಕ್ರಾವ್ಯಾ ಪಾಟಾತ್ನಿ ಬಗುಕ್ ಹೊತಾ.</para>
  <para style="io1">5. ಪಾಟ್ ಬಾರಾಕ್ನಾ ಪನ್ನಾಸಾತ್ ಅಬ್ರಾಂಮ್ ತೆಜೊ ಕುಟುಂಬ್ ಅನಿ ಇಜ್ರಾಯೆಲ್ ರಾಜ್ಯಾಚ್ಯಾ ವಿಶಯಾತ್ ಕಳುನ್ ಯೆತಾ.</para>
  <para style="io1">ಎ. ಅಬ್ರಾಂಮ್ ಅನಿ ತೆಚಿ ಬಾಯ್ಕೊ ಸಾರಾಚ್ಯಾ ಜಿವನಾಚ್ಯಾ ವಿಶಯಾತ್ ಪಾಟ್ ಬಾರಾಕ್ನಾ ಪಂಚಿಸ್ ಪಾಟಾತ್ನಿ ಬಗ್ತಾಂವ್.</para>
  <para style="io1">ಬಿ.ಪಾಟ್ ವಿಸಾರ್ ಎಕಾ ಕ್ನಾ ವಿಸಾರ್ ಆಟಾ ಪತರ್ ಇಸಾಕ್ ಅನಿಬಿ ತೆಚಿ ಬಾಯ್ಕೊ ರೆಬೆಕಾಚೆ ಜಿವನ್ ಅನಿ ತೆಚೆ ಮರಾನ್ ತಿಸಾರ್ ಪಾಂಚ್ವ್ಯಾ ಪಾಟಾತ್ ದಾಕ್ವುನ್ ಹೊಲಾ.</para>
  <para style="io1">ಸಿ.ಪಾಟ್ ಪಂಚಿಸಾಕ್ನಾ ಪನ್ನಾಸಾತ್ ಜಾಕೊಬಾಚೆ ಜಿವನ್ ತೆಚಿ ಲೆಕಾ ಅನಿ ತೆನಿ ಇಜಿಪ್ತಾಕ್ನಾ ಕಾನಾನಾಕ್ ಗೆಲ್ಲೆ ಸಗ್ಳೆ ವಿಶಯಾ ಹಾತ್.</para>
  <para style="io1">ಡಿ. ಪಾಟ್ ತಿಸಾರ್ ಸಾತಾಕ್ನಾ ಪನ್ನಾಸಾತ್ ಜಾಕೊಬಾಚೊ ಪ್ರೆಮಾಚೊ ಲೆಕ್ ಜುಜೆಚೆ ಜಿವನ್ ಅನಿ ತೊ ಕಸೊ ಇಜಿಪ್ತಾಚೊ ಅಧಿಕಾರಿ ಹೊಲೊ ಮನ್ತಲೆ ದಾಕ್ವುತಾ.</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">ರಚನ್ಯಾಚಿ ಕಾನಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />ಅದ್ದಿ ದೆವಾನ್ ಮಳಬ್ ಅನಿ ಜಿಮಿನ್ ರಚ್ಲ್ಯಾನ್, <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />ತನ್ನಾ ಜಿಮ್ನಿಕ್ ಆಕಾರ್ ನತ್ತೊ ಅನಿ ಕಾಯ್ಬಿ ನತ್ತೆ ಸಗ್ಳ್ಯಾಕ್ಡೆ ಕಾಳೊಕ್ ಹೊತ್ತೊ, ಅನಿ ದೆವಾಚೊ ಆತ್ಮೊ ಪಾನಿಯಾಚ್ಯಾ ವರ್‍ತಿ ಫಿರುನ್ ಖೆಳುನ್ಗೆತ್ ಹೊತ್ತೊ. <verse eid="GEN 1:2" /><verse number="3" style="v" sid="GEN 1:3" />ತನ್ನಾ ದೆವಾನ್: “ಉಜ್ವೊಡ್ ಹೊಂವ್ದಿತ್” ಮಟ್ಲ್ಯಾನ್, ಉಜ್ವೊಡ್ ಹೊಲೊ. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />ತೊ ಉಜ್ವೊಡ್ ದೆವಾಕ್ ಬರೊ ದಿಸ್ಲೊ, ತನ್ನಾ ತೆನಿ ಉಜ್ವೊಡಾಕ್ ಕಾಳ್ಕಾಕ್ನಾ ಎಗಳ್ಲ್ಯಾನ್, <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />ಅನಿ ತೆನಿ ಉಜ್ವೊಡಾಕ್ “ದಿಸ್” ಅನಿ ಕಾಳ್ಕಾಕ್ “ರ್‍ಹಾತ್” ಮನುನ್ ನಾವ್ ದಿಲ್ಯಾನ್, ಅಸೆ ಸಾಂಜ್ ಹೊವ್ನ್ ಸಕ್ಕಾಳ್ ಹೊಲಿ ಹ್ಯೊ ಪೈಲೆಚೊ ದಿಸ್.<verse eid="GEN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />ಮಾನಾ ತೆನಿ, “ಪಾನಿಯಾಚ್ಯಾ ಮದ್ದಿ ಎಕ್ ಅಂತ್ರಾಳ್ ಹೊಂವ್ದಿತ್” ಮಟ್ಲ್ಯಾನ್, <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />ಅಸೆ ದೆವಾನ್ ಅಂತ್ರಾಳ್ ಹೊಂವ್ದಿತ್, ಅನಿ ವೈಲೆ ಪಾನಿ ಅನಿ ಖಾಯ್ಲೆ ಪಾನಿ ಎಗ್ಳೆ ಹೊಂವ್ದಿತ್, ಮಟ್ಲ್ಯಾನ್ ತಸೆಚ್ ಹೊಲೆ. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />ದೆವಾನ್ ತ್ಯಾ ಅಂತ್ರಾಳಾಕ್ ಮಳಬ್ ಮನುನ್ ನಾವ್ ದಿಲ್ಯಾನ್ ತಸೆಚ್ ಸಾಂಜ್ ಹೊವ್ನ್ ಸಕ್ಕಾಳ್ ಹೊಲಿ ಹ್ಯೊ ದೊನ್ವೊ ದಿಸ್.<verse eid="GEN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />ಮಾನಾ ದೆವಾನ್ “ಮಳ್ಬಾಚ್ಯಾ ಖಾಲ್ತಿ ಹೊತ್ತ್ಯಾ ಪಾನಿಯಾಕ್ ಎಕಾಕ್ಡೆ ಜಮಾ ಹೊಂವ್ದಿ ಅನಿ ವಾಳ್ಕಿ ಜಿಮಿನ್ ದಿಸುಂದಿತ್” ಮಟ್ಲ್ಯಾನ್, ತೆ ತಸೆಚ್ ಹೊಲೆ. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />ದೆವಾನ್ ವಾಳ್ಕ್ಯಾ ಜಾಗ್ಯಾಕ್ ಜಿಮಿನ್ ಮನುನ್ ಅನಿ ಎಕಾಕ್ಡೆ ಗೊಳಾ ಹೊಲ್ಲ್ಯಾ ಪಾನಿಯಾಕ್ ಸಮುಂದರ್ ಮನುನ್ ನಾವ್ ದಿಲ್ಯಾನ್ ತೆ ದೆವಾಕ್ ಬರೆ ದಿಸ್ಲೆ. <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />ತನ್ನಾ ದೆವಾನ್, “ಬಿಂಯ್ ದಿತಲಿ ಅನಿ ಫಳಾ ದಿತಲಿ ಸಗ್ಳ್ಯಾ ರಿತಿಚಿ ಝಾಡಾ ಜಿಮಿನ್ ಉಗ್ವುಂದಿ”, ಮಟ್ಲ್ಯಾನ್ ತೆ ತಸೆಚ್ ಹೊಲೆ. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />ಜಿಮ್ನಿಚ್ಯಾ ವರ್‍ತಿ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಝಾಡಾ ಉಗಾವ್ಲಿ, ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಬಿಂಯ್ ದಿತಲಿ ಝಾಡಾ ಅನಿ ಫಳಾ ದಿತಲಿ ಝಾಡಾ ಉಗಾವ್ಲಿ, ತೆ ದೆವಾಕ್ ಬರೆ ದಿಸ್ಲೆ. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />ಅಸಿಚ್ ಸಾಂಜ್ ಹೊವ್ನ್ ಸಕ್ಕಾಳ್ ಹೊಲಿ ತೊ ತಿನ್ವೊ ದಿಸ್.<verse eid="GEN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />ಅನಿ ದೆವಾನ್, “ದಿಸಾಕ್ ರಾತಿಕ್ನಾ ಎಗ್ಳು ಸಾಟ್ನಿ ಮಳ್ಬಾತ್ ಉಜ್ವೊಡಾ ದಿಸುಂದಿತ್, ಅನಿ ಹೆಚ್ಯಾ ವೈನಾ ದಿಸಾ, ವರ್ಸಾ, ಅನಿ ಕಾಲ್ ದಾಕ್ವುಂದಿತ್, <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />ಅನಿ ತೊ ಉಜ್ವೊಡ್ ಮಳ್ಬಾತ್ ರ್‍ಹಾವ್ನ್ ಜಿಮ್ನಿ ವರ್‍ತಿ ಹೊಳ್ವುಂದಿತ್” ಮಟ್ಲ್ಯಾನ್, ತಸೆಚ್ ಹೊಲೆ. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />ತೆಚ್ಯಾ ಮಾನಾ ದೆವಾನ್ ದಿಸ್ ಅನಿ ಚಂದ್ರಾಮ್ ರಚ್ಲ್ಯಾನ್, ದಿಸ್ ಚಾಲ್ವುಕ್ ದಿಸ್ ಅನಿ ರ್‍ಹಾತ್ ಚಾಲ್ವುಕ್ ಚಂದ್ರಾಮ್ ಅನಿ ಚಿಕ್ಕಿಯಾಬಿ ರಚ್ಲ್ಯಾನ್. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />ದೆವಾನ್ ತೆಂಕಾ ಜಿಮ್ನಿಕ್ ಉಜ್ವೊಡ್ ದಿವ್ಕ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />ಅನಿ ದಿಸ್ ಅನಿ ರ್‍ಹಾತ್ ಚಾಲ್ವುಕ್, ಉಜ್ವೊಡ್ ಅನಿ ಕಾಳೊಕ್ ಎಗ್ಳೆ ಕರುನ್ ಥವ್ಲ್ಯಾನ್, ಅನಿ ತೆಕಾ ತೆ ಬರೆ ದಿಸ್ಲೆ. <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />ಅಸಿಚ್ ಸಾಂಜ್ ಹೊವ್ನ್ ಸಕ್ಕಾಳ್ ಹೊಲಿ ತೊ ಚಾರ್ವೊ ದಿಸ್.<verse eid="GEN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />ಮಾನಾ ದೆವಾನ್, “ಲೈ ನಮುನ್ಯಾಚ್ಯಾ ಪಾನಿಯಾತ್ ರಾತಲಿ ಜನಾವರಾನಿ ಭರುಂದಿ, ಅನಿ ಮಳ್ಬಾತ್ ಫಾಕ್ರಾ ಹುಡುಂದಿ”, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />ಅಸೆ ದೆವಾನ್, ಪಾನಿಯಾತ್ ರಾತಲಿ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಮೊಟ್ಟಿ ಅನಿ ಬಾರಿಕ್ ಜನಾವರಾ ರಚ್ಲ್ಯಾನ್ ಅನಿ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಫಾಕ್ರಾ ರಚಲ್ಯಾನ್, ತನ್ನಾ ತೆಕಾ ತೆ ಬರೆ ದಿಸ್ಲೆ. <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />ದೆವಾನ್ ತಿ: ಪಾನಿಯಾತ್ಲಿ ಜನಾವರಾಂಚಿ ಪಿಳ್ಗಿ ವಾಡುನ್ ಸಮುಂದರ್ ಭರುಂದಿ, ಅನಿ ವರ್‍ತಿ ಹುಡ್ತಲ್ಯಾ ಫಾಕ್ರಾಂಚೊ ಅಂಕೊ ವಾಡುಂದಿತ್ ಮನುನ್, ಆಶಿರ್ವಾದ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />ತಸೆಚ್ ಸಾಂಜ್ ಹೊವ್ನ್ ಸಕ್ಕಾಳ್ ಹೊಲಿ, ತೊ ಪಾಚ್ವೊ ದಿಸ್.<verse eid="GEN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />ಮಾನಾ ದೆವಾನ್: “ಜಿಮಿನ್ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಮೊಟಿ ಬಾರಿಕ್ಲಿ ಗಾಂವ್ಟಿ ಅನಿ ಡಂಗ್ಳಿತ್ಲಿ ಜನಾವರಾ ಉಪ್ಜುಂದಿತ್”, ಮಟ್ಲ್ಯಾನ್, ತೆ ತಸೆಚ್ ಹೊಲೆ. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />ಅಸೆ ದೆವಾನ್ ಹ್ಯಾ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಜನಾವರಾ ರಚ್ಲ್ಯಾನ್, ಅನಿ ತೆಕಾ ತೆ ಬರೆ ದಿಸ್ಲೆ.<verse eid="GEN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />ಮಾನಾ ದೆವಾನ್ “ಅತ್ತಾ ಮಾನ್ಸಾಕ್ನಿ ರಚುಂವಾ ತೆನಿ ಬಗುಕ್ ಅಮ್ಚ್ಯಾ ಸಾರ್ಕೆಚ್ ದಿಸುಚೆ, ಅನಿ ತೆನಿ ಸಮುಂದರಾಚ್ಯಾ ಜನಾವರಾಂಚ್ಯಾ ವರ್‍ತಿಬಿ ಮಳ್ಬಾತ್ ಹುಡ್ತಲ್ಯಾ ಫಾಕ್ರಾಚ್ಯಾ ವರ್‍ತಿಬಿ ಬಾರಿಕ್ ಮೊಟ್ಟ್ಯಾ ಗಾಂವ್ಟಿ ಅನಿ ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಜನಾವಾರಾಂಚ್ಯಾ ವರ್‍ತಿಬಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ತೆವಳ್ತಲ್ಯಾ ಕಿಡ್ಯಾಂಚ್ಯಾ ವರ್‍ತಿಬಿ ರಾಜ್ವಟ್ಕಿ ಕರುಂದಿತ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27" />ಅಸೆ ದೆವಾನ್ ಮಾನ್ಸಾಕ್ನಿ ಅಪ್ನಾಚ್ಯಾ ರುಪಾತ್ ರಚಲ್ಯಾನ್, ತೆಂಕಾ ಅಪ್ನಾಚ್ಯಾ ರುಪಾತ್ ರಚ್ಲ್ಯಾನ್, ಘೊಮಾನುಸ್ ಅನಿ ಬಾಯ್ಕೊಮಾನುಸ್ ಕರುನ್ ರಚ್ಲ್ಯಾನ್.<verse eid="GEN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 1:28" />ದೆವಾನ್ ತೆಂಕಾ ಆಶಿರ್ವಾದ್ ಕರುನ್ ಅನಿ: “ತುಮ್ಚಿ ಪಿಳ್ಗಿ ವಾಡುಂದಿತ್ ಅನಿ ಜಿಮಿನ್ ತುಮ್ಚ್ಯಾ ತಾಬೆತ್ ಕರುನ್ ಘೆವಾ, ಅನಿ ಸಮುಂದರಾತ್ ರ್‍ಹಾತಲ್ಯಾ ಮಾಸೊಳಾಂಚ್ಯಾ ವರ್‍ತಿ, ಮಳ್ಬಾತ್ ಹುಡ್ತಲ್ಯಾ ಫಾಕ್ರಾಂಚ್ಯಾ ವರ್‍ತಿ ಅನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ಫಿರುನ್ ಖೆಳ್ತಲ್ಯಾ ಹರ್ ಎಕ್ ಜನಾವರಾಂಚ್ಯಾ ವರ್‍ತಿ ತುಮಿ ರಾಜ್ವಟ್ಕಿ ಕರಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 1:28" /><verse number="29" style="v" sid="GEN 1:29" />ತನ್ನಾ ದೆವಾನ್ ತೆಂಕಾ; “ಬಿಂಯ್ ದಿತಲ್ಯಾ ಅನಿ ಬಿಂಯ್ ರ್‍ಹಾತಲ್ಯಾ ಸಗ್ಳ್ಯಿ ನಮುನ್ಯಾಚ್ಯಾ ಫಳಾಚಿ ಝಾಡಾ ತುಮ್ಕಾ ಖಾವ್ಕ್ ಮನುನ್ ದಿಲಾ. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />ಅನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ರ್‍ಹಾತಲ್ಯಾ ಜನಾವಾರಾಕ್ನಿ, ಮಳ್ಬಾತ್ ಹುಡ್ತಲ್ಯಾ ಫಾಂಕ್ರಾಕ್ನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ಫಿರುನ್ ಖೆಳ್ತಲ್ಯಾ ಜನಾವರಾಕ್ನಿ ಖಾವ್ಕ್ ಮನುನ್ ಬಾಜಿ ಪಾಲೊ ದಿಲಾ” ಮಟ್ಲ್ಯಾನ್, ತಸೆಚ್ ಹೊಲೆ. <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />ಅಪ್ನಿ ರಚಲ್ಲೆ ಸಗ್ಳೆ ದೆವಾನ್ ಬಗಲ್ಯಾ ತನ್ನಾ, ತೆ ತೆಕಾ ಲೈ ಬರೆ ದಿಸ್ಲೆ ಅಸಿ ಸಾಂಜ್ ಹೊವ್ನ್ ಸಕ್ಕಾಳ್ ಹೊಲಿ, ತೊ ಸಾವೊ ದಿಸ್.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />ಅಸೆ ಮಳಬ್ ಅನಿ ಜಿಮಿನ್ ತ್ಯಾತುರ್ ಹೊತ್ತೆ ಸಗ್ಳೆ ರಚುನ್ ಹೊಲೆ. <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" />ಅಸೆ ಕರುನ್ ದೆವಾನ್ ಅಪ್ನಾಚ್ಯಾ ಹಾತಿನ್ ರಚ್ತಲೆ ಕಾಮ್ ಸಾರುನ್ ಸಾತ್ವ್ಯಾ ದಿಸಿ ಆರಾಮ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />ದೆವಾನ್ ಅಪ್ನಾಚಿ ರಚ್ತಲಿ ಕಾಮಾ ಸಾರುನ್ ಸಾತ್ವೆ ದಿಸಾತ್ ಆರಾಮ್ ಘೆಟಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತ್ಯಾ ದಿಸಾಕ್ “ಪವಿತ್ರ್ ದಿಸ್” ಮನುನ್ ಆಶಿರ್ವಾದ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 2:3" /><verse number="4" style="v" sid="GEN 2:4" />ಹಿ ಮಳಬ್ ಅನಿ ಜಿಮಿನ್ ರಚುನ್ ಹೊಲ್ಲಿ ಚರಿತ್ರಾ.</para>
  <para style="s" vid="GEN 2:4">ಎದೆನಾಚೊ ಮ್ಹಳೊ</para>
  <para style="p" vid="GEN 2:4">ದೆವಾನ್ ಮಳಬ್ ಅನಿ ಜಿಮಿನ್ ರಚಲ್ಯಾ ತನ್ನಾ, <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />ಜಿಮ್ನಿ ವರ್‍ತಿ ಕಸ್ಲಿಬಿ ಝಾಡಾ ನತ್ತಿ, ಅನಿ ಕಸ್ಲೊಬಿ ಬಾಜಿ ಪಾಲೊ ಉಗ್ವು ನತ್ತೆ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಜಿಮ್ನಿ ವರ್‍ತಿ ಪಾವ್ಸ್ ಪಾಡ್ಸುಕ್ ನತ್ತ್ಯಾನ್, ಅನಿ ಜಿಮ್ನಿಚ್ಯಾ ವರ್‍ತಿ ಕಾಮಾ ಕರುಕ್ ಮಾನುಸ್ಬಿ ನತ್ತೊ. <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />ಖರೆ ಜಿಮ್ನಿಚ್ಯಾ ಬುಡ್ನಾ ಪಾನಿಯಾಚಿ ಝರೊ ಯೆವ್ನ್ ಪುರಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಪಾನಿ ಕರಿ.<verse eid="GEN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 2:7" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಜಿಮ್ನಿ ವೈಲಿ ಮಾಟಿ ಘೆವ್ನ್ ಮಾನ್ಸಾಕ್ ರಚ್ಲ್ಯಾನ್ ಅನಿ ತೆಚ್ಯಾ ನಾಕಾತ್ ಜಿವಾಚೊ ಶ್ವಾಸ್ ಪುಕ್ಲ್ಯಾನ್, ತನ್ನಾ ತೊ ಝಿತ್ತೊ ಮಾನುಸ್ ಹೊಲೊ.<verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಎದೆನಾಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಎಕ್ ಮ್ಹಳೊ ತಯಾರ್ ಕರುನ್ ಅಪ್ನಿ ರಚಲ್ಯಾ ಮಾನ್ಸಾಕ್ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 2:9" />ಅನಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಖಾವ್ಕ್ ರುಚಿ ಹೊತ್ತೆ ಅನಿ ಬಗುಕ್ ಲೈ ಬರೆ ದಿಸ್ತಲ್ಯಾ ನಾನಾ ನಮುನ್ಯಾಚಿ ಝಾಡಾ ತ್ಯಾ ಮ್ಹಳ್ಯಾತ್ ಉಗಿ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್, ಅನಿ ತ್ಯಾ ಮಳ್ಯಾಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಜಿವಿತಾಚೆ ಝಾಡ್ ಹೊತ್ತೆ ಅನಿ ತೆ ಬರ್ಯೆ ವಾಯ್ಟ್ ಕಳ್ವುತಲೆ ಹೊತ್ತೆ.<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />ತ್ಯಾ ಮ್ಹಳ್ಯಾತ್ ಎಕ್ ನ್ಹಯ್ ಹೊತ್ತಿ ತಿ ಫುರಾ ಮ್ಹಳ್ಯಾಕ್ ಪಾನಿ ದಿತಾ, ಥೈತ್ನಾ ತಿ ನ್ಹಯ್ ಫಾಟೆ ಪುಟುನ್ ಚಾರ್ ಹೊತಾತ್. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />ಎಕ್ವೆಚ್ಯಾ ಫಾಟ್ಯಾಚೆ ನಾವ್ ಪಿಶೊನ್ ; ತೊ ಸೊನೆ ಗಾವ್ತಲ್ಯಾ ಹವಿಲ್ ದೆಸಾತ್ ಹಂವ್ತಾ. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />ತ್ಯಾ ದೆಸಾತ್ ಸೊನೆ ಲೈ ಚೊಕ್ಕ್ ಬದೊಲಕ್ ಮನ್ತಲೆ ವಿಶೆಸ್ ಧುಪ್ ಅನಿ ಗೊಮೆಧಿಕ್ ಮನ್ತಲೆ ರತ್ನ್ ಗಾವ್ತಾ. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />ದೊನ್ವ್ಯಾ ಫಾಟ್ಯಾಚೆ ನಾವ್ ಗಿಯೊನ್, ತೊ ಕುಶ್ ಮನ್ತಲ್ಯಾ ದೆಸಾತ್ ಹಂವ್ತಾ. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />ತಿನ್ವ್ಯಾ ಫಾಟ್ಯಾಚೆ ನಾವ್ ಟೈಗ್ರಿಸ್; ತೊ ಆಶಿರ್ಯಾ ಮನ್ತಲ್ಯಾ ಅನಿ ದಿಸ್ ಉಗ್ತಲ್ಯಾ ದಿಕ್ಕಾತ್ ಹವ್ತಾ, ಚಾರ್ವ್ಯಾ ಫಾಟ್ಯಾಚೆ ನಾವ್ ಯುಪ್ರಟಿಸ್.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತ್ಯಾ ಮಾನ್ಸಾಕ್ ಎದೆನ್ ಮ್ಹಳ್ಯಾತ್ ಘೊಳುಕ್ ಅನಿ ರಾಕುಕ್ ಮನುನ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />ಅನಿ ತ್ಯಾ ಮಾನ್ಸಾಕ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ “ತಿಯಾ ಹ್ಯಾ ಮಳ್ಯಾತ್ಲೆ ಸಗ್ಳೆ ನಮುನ್ಯಾಚೆ ಫಳ್ ಪಾಜೆ ತವ್ಡೆ ಖಾವ್ಕ್ ಅಡ್ಡಿನಾ, <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />ಖರೆ ಬರ್ಯೆ ಅನಿ ವಾಯ್ಟ್ ಕಳ್ವುತಲ್ಯಾ ಝಾಡಾಚೆ ಫಳ್ ತಿಯಾ ಖಾವ್ಕ್ ನಕ್ಕೊ, ಖಾಲ್ಯಾರ್ ತ್ಯಾಚ್ ದಿಸಾ ಮರುನ್ ಜಾತೆ!” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />ಅನಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್, “ಮಾನುಸ್ ಎಕ್ಲೊಚ್ ರ್‍ಹಾತಲೆ ಬರೆ ನ್ಹಯ್ ಮನುನ್ ಮಿಯಾ ತುಕಾ ಸಮಾ ಹೊಯ್ ಸಾರ್ಕೆ ವಾಂಗ್ಡಿನ್ ಕರುನ್ ದಿತಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 2:18" /><verse number="19" style="v" sid="GEN 2:19" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಜಿಮ್ನಿತ್ಲಿ ಮಾಟಿ ಘೆವ್ನ್ ಜಿಮ್ನಿತ್ ರ್‍ಹಾತಲ್ಯಾ ಹರ್ ಎಕ್ ಜನಾವರಾಕ್ನಿ ಅನಿ ಹರ್ ಎಕ್ ಫಾಂಕ್ರಾಕ್ನಿ ರಚ್ಲ್ಯಾನ್ ಅನಿ ಮಾನ್ಸಾಕ್ಡೆ ನಾವ್ ಥವ್ಕ್ ಮನುನ್ ಹಾನ್ಲ್ಯಾನ್ ಅನಿ ತೆಂಕಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಮಾನ್ಸಾನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್ ತೆಂಕಾ ತೆಚ್ ನಾವ್ ರ್‍ಹಾಲೆ. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />ತ್ಯಾ ಮಾನ್ಸಾನ್ ಜಿಮ್ನಿತ್ ರ್‍ಹಾತಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಜನಾವರಾಕ್ನಿ ಮಳ್ಬಾತ್ ಹುಡ್ತಲ್ಯಾ ಫಾಂಕ್ರಾಕ್ನಿ ಅನಿ ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಕ್ರುರ್ ಜನಾವರಾಕ್ನಿ ನಾವ್ ಥವ್ಲ್ಯಾನ್ ಖರೆ ತೆಕಾ ಸಮಾ ಹೊತಲಿ ವಾಂಗ್ಡಿನ್ ಗಾವ್ಕ್ ನಾ.<verse eid="GEN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 2:21" />ತನ್ನಾ ದೆವಾನ್ ಮಾನ್ಸಾಕ್ ಲೈ ನಿಜ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್, ಅನಿ ತೊ ನಿಜೆತ್ ರ್‍ಹಾತಾನಾ ತೆಚೆ ಪಕ್ಡಿತ್ಲೆ ಹಡ್ಡ್ ಕಾಡ್ಲ್ಯಾನ್ ಅನಿ ತ್ಯಾ ಜಾಗ್ಯಾರ್ ಮಾಸಾನ್ ಧಾಪ್ಲ್ಯಾನ್, <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />ಅನಿ ತೆಚ್ಯಾ ಹಡ್ಡಾನ್ ಎಕ್ ಬಾಯ್ಕೊಮಾನುಸ್ ರಚ್ಲ್ಯಾನ್, ಅನಿ ತಿಕಾ ಹಾನುನ್ ಆದಾಮಾಚ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" />ತನ್ನಾ ತೆನಿ ಬಗುನ್,</para>
  <para style="p" vid="GEN 2:23">“ಅತ್ತಾ ಸಮಾ ಹೊಲೆ, ಹಿ ಮಾಜ್ಯಾ ಸಾರ್ಕಿಚ್ ಹಾಯ್, ಹಿ ಮಾಜ್ಯಾ ಹಡ್ಡಾಚೆ ಹಡ್ಡ್, ಅನಿ ಮಾಂಸಾಚೆ ಮಾಸ್! ತಿಚೆ ನಾವ್ ನಾರಿ” ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್,</para>
  <para style="p" vid="GEN 2:23">ತಿ ಮನ್ಸಾನ್ ರಚಿತ್ ಹೊಲ್ಲಿ ಹಾಯ್ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 2:24" />ಹ್ಯಾ ಕಾರಾನಾ ಸಾಟ್ನಿ ಮಾನುಸ್ ಅಪ್ಲ್ಯಾ ಬಾಯ್ ಬಾಬಾಕ್ ಸೊಡುನ್ ಅಪ್ಲ್ಯಾ ಬಾಯ್ಕೊಕ್ ಮಿಳ್ತಾ, ತೆನಿ ದೊಗೆಬಿ ಎಕುಚ್ ಆಂಗ್ ಹೊತಾತ್.<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />ತೊ ಮಾನುಸ್ ಅನಿ ತೆಚಿ ಬಾಯ್ಕೊ ನಾಗ್ಡೆ ರಾರ್ಲ್ಯಾಬಿ ತೆನಿ ಲಜ್ಜುಕ್ನಾತ್.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">ಮಾನುಸ್ ಖಾಲ್ತಿ ಹೊವ್ನ್ ಚಲಿನಸಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ರಚಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಜನಾವರಾತ್ನಿ ಸಾಪ್ ಲೈ ಉಶಾರ್ ಹೊತ್ತೊ, ಸಾಪಾನ್ ತಿಕಾ: ದೆವಾನ್ ಮ್ಹಳ್ಯಾತ್ಲ್ಯಾ ಖಲ್ಯಾ ಝಾಡಾಚೆ ಫಳ್ ತುಮಿ ಖಾವ್ನ್ ನ್ಹಯ್ ಮನುನ್ ಸಾಂಗಲೆ ಖರೆ ಕಾಯ್? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />ತನ್ನಾ ತ್ಯಾ ಬಾಯ್ಕೊಮನ್ಸಿನ್ ತ್ಯಾ ಸಾಪಾಕ್ ಜಾಬ್ ದಿವ್ನ್, “ಮಳಾತ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಝಾಡಾಂಚಿ ಫಳಾ ಖಾಲ್ಯಾರ್ ಹೊತಾ, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />ಖರೆ ಮ್ಹಳ್ಯಾತ್ಲ್ಯಾ ಮದ್ದಿ ಹೊತ್ತ್ಯಾ ಝಾಡಾಚ್ಯಾ ಫಳಾಂಚ್ಯಾ ವಿಶಯಾತ್ ದೆವಾನ್ ಅಮ್ಕಾ ತೆ ತುಮಿ ಖಾವ್ಚೆಬಿ ನೈ ಅನಿ ಅಪ್ಡುಬಿ ನೈ, ತೆ ತುಮಿ ಖಾಲ್ಯಾರ್ ಮರ್‍ತ್ಯಾಸಿ” ಮನುನ್ ಸಾಂಗ್ಲಾ ಮಟ್ಲಿನ್. <verse eid="GEN 3:3" /><verse number="4" style="v" sid="GEN 3:4" />ತನ್ನಾ ಸಾಪಾನ್ ತ್ಯಾ ಬಾಯ್ಕೊಮಾನ್ಸಿಕ್; ತೆ ಖರೆ ನೈ ತುಮಿ ಮರಿನ್ಯಾಸಿ. <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />ಕನ್ನಾ ತುಮಿ ತ್ಯಾ ಝಾಡಾಚೆ ಫಳ್ ಖಾತ್ಯಾಸಿ ತುಮ್ಚೆ ಡೊಳೆ ಉಗಡ್ತಾತ್. ಅನಿ ತುಮಿ ದೆವಾಚ್ಯಾ ಸಾರ್ಕೆ ಹೊತ್ಯಾಸಿ. ಬರೆ ವೈಟ್ ಒಳ್ಕುನ್ ಘೆತ್ಯಾಸಿ ಮನ್ತಲೆ ದೆವಾಕ್ ಗೊತ್ತ್ ಹಾಯ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 3:5" /><verse number="6" style="v" sid="GEN 3:6" />ತನ್ನಾ ಬಾಯ್ಕೊಮನ್ಸಿಕ್ ತೆ ಝಾಡಾಚೆ ಫಳ್ ಬಗುಕ್ ಖಾವ್ಕ್ ಅನಿ ಅಕ್ಕಲ್ ಯೆವ್ಕ್ ಲೈ ಬರೆ ರಾವ್ಕ್ ಫಿರೆ ಮನುನ್ ಯೆವ್ಜುನ್ ತಿನೆ ಝಾಡಾಚೆ ಫಳ್ ಕಾಡುನ್ ಖಾಲಿನ್; ಅನಿ ಅಪ್ನಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತ್ಯಾ ಘವಾಕ್ಬಿ ದಿಲಿನ್ ತೆನಿಬಿ ತೆ ಖಾಲ್ಯಾನ್. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />ತನ್ನಾಚ್ ತೆಂಚೆ ದೊಗ್ಯಾಂಚೆ ಡೊಳೆ ಉಗಡ್ಲೆ, ತೆನಿ ನಾಗ್ಡೆ ಹೊತ್ತೆ ತೆಂಕಾ ಕಳ್ಳೆ, ಅಂಜುರಾಚ್ಯಾ ಝಾಡ್ಯಾಚಿ ಪಾನಾ ಎಕಾಕ್ ಎಕ್ ಜೊಡ್ಸುನ್ ಅಪ್ಲೆ ಆಂಗ್ ಧಾಪುನ್ ಘೆಟ್ಲ್ಯಾನಿ. <verse eid="GEN 3:7" /><verse number="8" style="v" sid="GEN 3:8" />ತ್ಯಾ ದಿಸಿ ಸಾಂಚೆರ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮ್ಹಳ್ಯಾತ್ ಥಂಡ್ ವಾರ್ಯಾಕ್ ಫಿರುನ್ಗೆತ್ ಹೊತ್ತೊ, ಪಾಯಾಚೊ ಆವಾಜ್ ತೆಂಕಾ ಆಯ್ಕುನ್ ಅನಿ ದೆವ್ ಬಾಬಾಕ್ ದಿಸುಚೆ ನ್ಹಯ್ ಮನುನ್ ಮ್ಹಳ್ಯಾತ್ಲ್ಯಾ ಝಾಡಾಂಚ್ಯಾ ಮದ್ದಿ ನಿಪ್ಲ್ಯಾನಿ. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತೆಕಾ: ತಿಯಾ ಖೈ ಹಾಸ್ ? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ. <verse eid="GEN 3:9" /><verse number="10" style="v" sid="GEN 3:10" />ತನ್ನಾ ತೆನಿ ಜಾಬ್ ದಿವ್ನ್: “ತಿಯಾ ಮ್ಹಳ್ಯಾತ್ ಚಲ್ತಲೊ ತುಜೊ ಆವಾಜ್ ಆಯ್ಕಲೊ ತನ್ನಾ ಮಿಯಾ ನಾಗ್ಡೊ ಹಾಯ್ ಮನುನ್ ಭಿಂವ್ನ್ ನಿಪ್ಲೊ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 3:10" /><verse number="11" style="v" sid="GEN 3:11" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತೆಕಾ “ತಿಯಾ ನಾಗ್ಡೊ ಹಾಸ್ ಮನುನ್ ತುಕಾ ಕೊನಿ ಸಾಂಗ್ಲೆ? ಮಿಯಾ ತುಕಾ ಖಾವ್ ನಕ್ಕೊ ಮನುನ್ ಸಾಂಗಲ್ಯಾ ಝಾಡಾಚೆ ಫಳ್ ಖಾಲೆ ಕಾಯ್?” ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ. <verse eid="GEN 3:11" /><verse number="12" style="v" sid="GEN 3:12" />ತನ್ನಾ ತ್ಯಾ ಘವ್ಮಾನ್ಸಾನ್, “ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ತಿಯಾ ದಿಲ್ಲ್ಯಾ ತ್ಯಾ ಬಾಯ್ಕೊ ಮಾನ್ಸಿನ್ ತ್ಯಾ ಝಾಡಾಚೆ ಫಳ್ ಮಾಕಾ ದಿಲಿನ್ ಅನಿ ಮಿಯಾ ತೆ ಖಾಲೊ”. <verse eid="GEN 3:12" /><verse number="13" style="v" sid="GEN 3:13" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಬಾಯ್ಕೊಮನ್ಸಿಕ್ ಇಚಾರ್‍ಲ್ಯಾನಿ: “ಹೆ ತಿಯಾ ಅಸೆ ಕಾಯ್ ಕರ್‍ಲೆ?” ತನ್ನಾ ತಿನಿ “ಸಾಪಾನ್ ಮಾಕಾ ಪಸ್ವುಲ್ಯಾನ್ ತನ್ನಾ ಮಿಯಾ ಖಾಲೊ ಮಟ್ಲಿನ್”.<verse eid="GEN 3:13" /></para>
  <para style="s">ದೆವಾಚೆ ನ್ಯಾಯ್ ನಿರ್ನಯ್</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಸಾಪಾಕ್ ಸಾಂಗ್ಲ್ಯಾನ್, ತಿಯಾ ಅಸೆ ಬುರ್ಸೆ ಕಾಮ್ ಕರಲ್ಯಾಕ್ ಸಗ್ಳ್ಯಾ ಜನಾವರಾಂಚ್ಯಾನ್ಕಿ ತಿಯಾ ಲೈ ಶಾಪ್ ಗ್ರಸ್ತ್ ಹೊತೈ, ತಿಯಾ ಪೊಟಾನಿ ಚಲುಚೊ ಅನಿ ಜಿವನ್ ಫುರಾ ಮಾಟ್ಟಿಚ್ ಚಾಟುಚೊ. <verse eid="GEN 3:14" /><verse number="15" style="v" sid="GEN 3:15" />ಅನಿ ತುಜ್ಯಾ ಅನಿ ಬಾಯ್ಕೊಮನ್ಸಿಚ್ಯಾ ಮದ್ದಿ, ತುಜ್ಯಾ ಅನಿ ತಿಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ಮದ್ದಿ ವಿರೊಧ್ ಹಾನುನ್ ಥವ್ತಾ, ಅನಿ ತಿಯಾ ತಿಚ್ಯಾ ಲೆಕಾಚೆ ಪಾಯಾಚಿ ಖೊಟಾಕ್ ಚಾವತೈ ಅನಿ ತೊ ತುಜೆ ಟಕ್ಲೆ ಝೆಜ್ರುನ್ ಟಾಕ್ತಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 3:15" /><verse number="16" style="v" sid="GEN 3:16" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಬಾಯ್ಕೊಮಾನ್ಸಿಕ್: ತಿಯಾ ಪೊಟಾನ್ ರ್‍ಹಾತಾನಾ ಲೈ ತರಾಸ್ ಕರುನ್ ಘೆತೈ, ತಿಯಾ ಪೊರಾಕ್ನಿ ಜಲಮ್ ದಿತಾನಾ ಲೈ ತರಾಸ್ ಹೊತಾ, ಅನಿ ತಿಯಾ ತುಜ್ಯಾ ಘವಾಚ್ಯಾ ವರ್‍ತಿ ಆಶ್ಯಾ ಕರ್‍ತೆ ಅನಿ ತೊ ತುಜ್ಯಾ ವರ್‍ತಿ ಹಕ್ಕ್ ಚಾಲ್ವುತಾ. <verse eid="GEN 3:16" /><verse number="17" style="v" sid="GEN 3:17" />ಮಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಘೊಮಾನ್ಸಾಕ್; ತಿಯಾ ತುಜ್ಯಾ ಬಾಯ್ಕೊಚಿ ಗೊಸ್ಟ್ ಆಯ್ಕುನ್ ಮಿಯಾ ತುಕಾ ಖಾವ್ಕ್ ನಕ್ಕೊ ಮಟಲ್ಯಾ ಝಾಡಾಚೆ ಫಳ್ ತಿಯಾ ಖಾಲೈ, ಮನುನ್ ತುಜ್ಯಾ ಕರ್‍ನ್ಯಾಕ್ ಲಾಗುನ್ ಜಿಮಿನ್ ಶರಾಪಾಚ್ಯಾ ಅಧಿನಾತ್ ರ್‍ಹಾತಾ, ತೆಚ್ಯಾ ವೈನಾ ಜಿವನಾತ ಫುರಾ ಕಸ್ಟ್ ಕರುನ್ ಘೊಳುನ್ ತಿಯಾ ತುಜೆ ಪೊಟ್ ಭರುನ್ ಘೆವ್ಚೆ. <verse eid="GEN 3:17" /><verse number="18" style="v" sid="GEN 3:18" />ಅನಿ ತುಜ್ಯಾ ಸಾಟ್ನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ಕಾಟೆ ಅನಿ ಕಳೆ ಉಗಾವ್ತಾ, ಅನಿ ತಿಯಾ ಸೆತಾಚಿ ಫಿಕುಚ್ ಖಾತೈ. <verse eid="GEN 3:18" /><verse number="19" style="v" sid="GEN 3:19" />ಮಾಟಿಕ್ನಾ ಯೆಲ್ಲೊ ತಿಯಾ ಪರ್‍ತುನ್ ಮಾಟಿಕ್ ಜಾಯ್ ಪತರ್ ತರಾಸಾನ್ ಘಾಮ್ ಗಳ್ವುನ್ ಜಿಮ್ನಿ ವರ್‍ತಿ ಸೆತ್ ಕರುನ್ ಫಿಕ್ ಕಾಡುಚೊ ಅನಿ ಮಾಟಿಕ್ನಾ ರಚಲ್ಲ್ಯಾ ತುಕಾ ಪರ್‍ತುನ್ ಮಾಟಿತುಚ್ ಘಾಲುಚೆ <verse eid="GEN 3:19" /><verse number="20" style="v" sid="GEN 3:20" />ಅನಿ ಆದಾಮಾನ್ ಅಪ್ಲ್ಯಾ ಬಾಯ್ಕೊಕ್ ಎವ್ವಾ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಹ್ಯಾ ಸಗ್ಳ್ಯಾ ಮಾನ್ಸಾಚ್ಯಾ ಜಾತಿಕ್ ಮುಳಾಚಿ ಬಾಯ್ ತಿ. <verse eid="GEN 3:20" /><verse number="21" style="v" sid="GEN 3:21" />ಮಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಆದಾಮಾಕ್ ಅನಿ ತೆಚ್ಯಾ ಬಾಯ್ಕೊಕ್ ಜನಾವಾರಾಂಚ್ಯಾ ಚಮ್ಡ್ಯಾಚೆ ಕಪ್ಡೆ ಕರುನ್ ನೆಸ್ವುಲ್ಯಾನ್. <verse eid="GEN 3:21" /><verse number="22" style="v" sid="GEN 3:22" />ದೆವ್ ಬಾಬಾನ್ “ಮಾನುಸ್ ಅತ್ತಾ ಬರೆ ಅನಿ ವಾಯ್ಟಾಚ್ಯಾ ವಿಶಯಾತ್ ಕಳ್ವುನ್ ಘೆವ್ನ್ ಅಮ್ಚ್ಯಾ ಸಾರ್ಕೊ ಹೊಲೊ, ಅತ್ತಾ ಮಾನುಸ್ ಜಿವದಾಯಕ್ ಝಾಡಾಚಿ ಫಳ್ ಕಾಯ್ಬಿ ಖಾಲ್ಯಾರ್ ತೊ ಕನ್ನಾಬಿ ಜಿವಿತ್ ರ್‍ಹಾತಾ” ಮನುನ್ ಘೆಟ್ಲ್ಯಾನ್. <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />ತೆಚ್ಯಾ ಮನಾ ದೆವ್ ಬಾಬಾನ್ ತೆಂಕಾ ಮ್ಹಳ್ಯಾತ್ನಾ ಭಾಯ್ರ್ ಘಾಟ್ಲ್ಯಾನ್, ಅನಿ ದೆವಾನ್ ರಚಲ್ಯಾ ಜಿಮ್ನಿರ್ ಸೆತ್ ಭಾತ್ ಕರುಕ್ ಮನುನ್ ತೆಕಾ ಧಾಡ್ಲ್ಯಾನ್. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />ಅಸೆ ದೆವಾನ್ ಮಾನ್ಸಾಕ್ ಭಾಯ್ರ್ ಘಾಲುನ್ ಜಿವನ್ ದಿತಲ್ಯಾ ಫಳಾಚ್ಯಾ ಝಾಡಾಕ್ಡೆ ಕೊನ್ಬಿ ಯೆವ್ ನೈ ಮನುನ್ ಥೈ ರಾಕುಕ್ ಕೆರುಬಿ ಧುತಾಕ್ನಿ ಅನಿ ಪೆಟ್ತಲೊ ಥಲ್ವಾರ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">ಕಾಯಿನ್ ಅನಿ ಹೆಬೆಲ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />ಆದಾಮ್ ಅಪ್ಲಿ ಬಾಯ್ಕೊ ಎವ್ವಾ ವಾಂಗ್ಡಾ ಮಿಳ್ಯಾನ್ ತನ್ನಾ ತಿ ಪೊಟಾನ್ ರ್‍ಹಾವ್ನ್ ಎಕ್ ಪೊರ್ ಹೊಲೊ ತನ್ನಾ ಹವ್ವಾನ್, “ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಮಜತಿ ವೈನಾ ಎಕ್ ಝಿಲ್ಗೊ ಹೊಲೊ” ಮನುನ್ ತೆಕಾ ಕಾಯಿನ್ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್. <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />ಮಾನಾ ತಿನಿ ಅಬೆಲ್ ಮನ್ತಲ್ಯಾ ಅನಿ ಎಕ್ ಪೊರಾಕ್ ಜಲಮ್ ದಿಲಿನ್, ಅಬೆಲ್ ಬಕ್ರಿಯಾಂಚೊ ತಾಂಡೊ ರಾಕ್ತಲೊ ಹೊಲೊ ಅನಿ ಕಾಯಿನ್ ಶೆತ್ ಕಾರಿ ಹೊಲೊ. <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />ಲೈ ದಿಸಾನ್ ಕಾಯಿನಾನ್ ಅಪ್ನಾಚ್ಯಾ ಶೆತಾಚ್ಯಾ ಫಿಕೆತ್ಲೆ ಉಲ್ಲೆ ದೆವಾಕ್ ಕಾನಿಕ್ ದಿವ್ಕ್ ಹಾನ್ಲ್ಯಾನ್. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />ತಸೆಚ್ ಅಬೆಲಾನ್ಬಿ ಅಪ್ಲ್ಯಾ ಶೆಳಿಯಾಂಚ್ಯಾ ತಾಂಡ್ಯಾತ್ಲ್ಯಾ ಶೆಳಿ ಹಾನುನ್ ತಿ ಕಾಪುನ್ ಬರೊಭಾಗ್ ಬಲಿ ಭೆಟ್ವುಲ್ಯಾನ್, ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ತೆಚಿ ಬಲಿ ಸ್ವಿಕಾರ್ ಕರ್ಲ್ಯಾನ್, <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />ಖರೆ ಕಾಯಿನಾಚಿ ಕಾನಿಕ್ ಸ್ವಿಕಾರ್ ಕರುಕ್ ನಾ ತೆಚ್ಯಾ ವೈನಾ ಕಾಯಿನ್ ಲೈ ರಾಗಾನ್ ಚಾವ್ತಾಳ್ಳೊ, ಅನಿ ತೆಚೆ ತೊಂಡ್ ಬಾವ್ಲೆ. <verse eid="GEN 4:5" /><verse number="6" style="v" sid="GEN 4:6" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಕಾಯಿನಾಕ್, “ಕಶ್ಯಾಕ್ ರಾಗಾರ್ ಹಾಸ್? ತುಜೆ ತೊಂಡ್ ಕಶ್ಯಾಕ್ ಬಾವ್ಲಾ? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />ತಿಯಾ ಬರೆ ಕಾಮ್ ಕರಲ್ಲೆ ಹೊಲ್ಯಾರ್ ಮಿಯಾ ತುಜಿ ಕಾನಿಕ್ ಸ್ವಿಕಾರ್ ಕರಿ ಹೊತ್ತೊ, ಖರೆ ತಿಯಾ ಬುರ್ಸೆ ಕಾಮ್ ಕರಲ್ಯಾ ಸಾಟ್ನಿ ಪಾಪ್ ತುಕಾ ಧರುನ್ ತಾಬೆತ್ ಕರುನ್ ಘೆವ್ಕ್ ಸಾಟ್ನಿ ಹುಂಬ್ಡ್ಯಾತ್ ರಾಕುನ್ಗೆತ್ ಹಾಯ್, ತಿಯಾ ತೆಕಾ ತುಜ್ಯಾ ತಾಬೆತ್ ಥವ್ನ್ ಘೆವ್ಚೆ”, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 4:7" /><verse number="8" style="v" sid="GEN 4:8" />ತೆ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಕಾಯಿನಾನ್ ಅಪ್ಲೊ ಭಾವ್ ಅಬೆಲಾಕ್, “ಅಮಿ ಶೆತಾಕ್ ಜಾವ್ವಾ ಯೆ” ಮನುನ್ ಬಲ್ವುಲ್ಯಾನ್, ತನ್ನಾ ತೆನಿ ದೊಗೆಬಿ ಶೆತಾಕ್ ಗೆಲೆ. ಥೈ ಕಾಯಿನಾನ್ ಅಪ್ನಾಚ್ಯಾ ಭಾವಾಕ್ ವಿರೊದ್ ಹೊವ್ನ್ ಜಿವಾನ್ ಮಾರ್‍ಲ್ಯಾನ್. <verse eid="GEN 4:8" /><verse number="9" style="v" sid="GEN 4:9" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಕಾಯಿನಾ, “ತುಜೊ ಭಾವ್ ಅಬೆಲ್ ಖೈ ಹಾಯ್?” ಮನುನ್ ಇಚಾರ್‍ತಾನಾ, ತೆನಿ “ಮಾಕಾ ಗೊತ್ತ್ ನಾ, ಮಿಯಾ ಕಾಯ್ ತೆಚೊ ರಾಕ್ವಲಿ ಕಾಯ್?” ಮನುನ್ ಜವಾಬ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 4:9" /><verse number="10" style="v" sid="GEN 4:10" />ತೆಕಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ “ಹೆ ತಿಯಾ ಕಾಯ್ ಕರ್‍ಲೆ?” ತಿಯಾ ತುಜ್ಯಾ ಭಾವಾಚೆ ರಗಾತ್ ಜಿಮ್ನಿತ್ನಾ ಬೊಬ್ ಮಾರುನ್ ಮಾಕಾ ಬಲ್ವುಲ್ಲಾ. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />ತಿಯಾ ತುಜ್ಯಾ ಭಾವಾಕ್ ಜಿವಾನ್ ಮಾರ್ಲೆಯ್, ಖರೆ ತೆಚೆ ರಗಾತ್ ಫಿವ್ಕ್ ಜಿಮ್ನಿನ್ ತೊಂಡ್ ಉಗಡ್ಲಾ ತೆಚ್ಯಾ ವೈನಾ ತಿಯಾ ಹ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಸೆತ್ ಕರಿನಸಲ್ಲ್ಯಾ ಶರಾಪಾತ್ ಪಡ್ಲೆ. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />ತ್ಯಾ ದಿಸಾತ್ನಿ ತಿಯಾ ಸೆತ್ ಕರುಕ್ ಜಾತೈ ಖರೆ ಮಾಟಿಕ್ನಾ ಕಾಯ್ಬಿ ಫಳ್ ಗಾಯ್ನಾ, ತಿಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಘರ್ ನಸಲ್ಲೊ ಹೊವ್ನ್ ಡಂಬಾರೆ ಸಾರ್ಕೊ ಫಿರುನ್ಗೆತ್ ರಾತೈ, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 4:12" /><verse number="13" style="v" sid="GEN 4:13" />ತನ್ನಾ ಕಾಯಿನಾನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್: “ಮಾಕಾ ಹಿ ಶಿಕ್ಷ್ಯಾ ಕಟಿನ್ ಹೊಲಿ”, <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />ತಿಯಾ ಮಾಕಾ ಜಿಮ್ನಿಕ್ನಾ ಅನಿ ತುಜ್ಯಾ ಇದ್ರಾಕ್ನಾ ಧುರ್ ಕರುಲೈ, ಮಾಕಾ ಘರ್ ನಾ, ಮಿಯಾ ಡಂಬಾರಿ ಹೊಲಾ ಮಾಕಾ ಕೊನಿ ತರಿ ಬಗಟ್ಲ್ಯಾರ್ ಮಾರುನ್ ಟಾಕ್ತಾತ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 4:14" /><verse number="15" style="v" sid="GEN 4:15" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತೆಕಾ, ನಾ ತಸೆ ಹೊಯ್ನಾ ಸಾರ್ಕೆ ಮಿಯಾ ಬಗುನ್ ಘೆತಾ! ಜರ್ ತುಜೊ ಜಿವ್ ಕಾಡ್ಲ್ಯಾನಿ ತರ್ ತೆಚ್ಯಾ ಬದ್ಲಾಕ್ ಸಾತ್ ಲೊಕಾಂಚೆ ಜಿವ್ ಕಾಡುನ್ ಹೊತಾ ಮಟ್ಲ್ಯಾನ್, ಅನಿ ತೆಚ್ಯಾ ಮಾನಾ ಕಾಯಿನಾಚ್ಯಾ ವರ್‍ತಿ ದೆವಾನ್ ತೆಕಾ ಕೊನ್ಬಿ ಜಿವಾನಿ ಮಾರುಚೆ ನ್ಹಯ್ ಮನುನ್ ಎಕ್ ವಳಕ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />ಮಾನಾ ಕಾಯಿನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚ್ಯಾ ಇದ್ರಾಕ್ನಾ ದುರ್ ಜಾವ್ನ್, ಎದೆನ್ ಮ್ಹಳ್ಯಾಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಫಿರಾಟ್ ಮನ್ತಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಗೆಲೊ.<verse eid="GEN 4:16" /></para>
  <para style="s">ಕಾಯಿನಾಚಿ ಪಿಳ್ಗಿ</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />ಮಾನಾ ಕಾಯಿನಾನ್ ಎಕ್ ಗಾಂವ್ ಭಾಂದ್ಲ್ಯಾನ್, ಕಾಯಿನಾಕ್ ಅನಿ ತೆಚ್ಯಾ ಬಾಯ್ಕೊಕ್ ಎಕ್ ಲೆಕ್ ಉಪಜ್ಲೊ ತೆಚೆ ನಾವ್ ಹನೊಕ್, ಕಾಯಿನಾನ್ ಎಕ್ ಶಾರ್ ಭಾಂದುನ್ ತೆಕಾ ಅಪ್ಲ್ಯಾ ಲೆಕಾಚೆ ನಾವ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />ಹನೊಕಾಕ್ ಎರಾದ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ, ಎರಾದಾಕ್ ಮೆಹುಯಾಯೆಲ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ, ಮೆಹುಯಾಯೆಲಾಕ್ ಮೆತುಶಯೆಲ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ, ಮೆತುಶಯೆಲಾಕ್ ಲಾಮೆಕ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ. <verse eid="GEN 4:18" /><verse number="19" style="v" sid="GEN 4:19" />ಲಾಮೆಕಾನ್ ಆದಾ ಅನಿ ಝಿಲ್ಲಾ ಮನ್ತಲಿ ದೊನ್ ಬಾಯ್ಕಾ ಹೊತ್ತಿ. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />ಆದಾಕ್ ಯಾಬಾಲ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ, ಝೊಪ್ಡ್ಯಾತ್ನಿ ರ್‍ಹಾವ್ನ್ ಗೊರಾ ಡೊರಾಕ್ನಿ ರಾಕುನ್ಗೆತ್ ಜಿವನ್ ಕರ್‍ತಲ್ಯಾಕ್ನಿ ವಾಡ್ ವಡಿಲ್. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />ತೆಜೊ ಭಾವ್ ಜುಬಾಲ್ ತೊ ಪಂವೊ ಅನಿ ಹಾರ್ಪ್ ವಾಜುತ್ತಲ್ಯಾ ಲೊಕಾಕ್ನಿ ವಾಡ್ ವಡಿಲ್. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />ಅನಿ ಎಕ್ ಬಾಯ್ಕೊ ಝಿಲ್ಲಾಕ್ ಜುಬಾಲ್ ಕಾಯಿನ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ, ತೊ ಲೊಂಗ್ಟಾಚೆ ಅನಿ ಪಿತ್ಳಿಚೆ ಸಾಮಾನಾ ಕರ್‍ತಲ್ಯಾ ಲೊಕಾಂಚೊ ವಾಡ್ ವಡಿಲ್, ಜುಬಾಲಾಕ್ ಎಕ್ ಭೆನ್ ಹೊತ್ತಿ ತಿಚೆ ನಾವ್ ನಾಮ್ಹಾ. <verse eid="GEN 4:22" /><verse number="23" style="v" sid="GEN 4:23" />ಮಾನಾ ಲಾಮೆಕಾನ್ ಅಪ್ಲ್ಯಾ ದೊಗೆ ಬಾಯ್ಕಾಕ್ನಿ: ಆದಾ ಅನಿ ಝಿಲ್ಲಾ, ಮಾಜಿ ಗೊಸ್ಟ್ ಆಯ್ಕಾ! ಮಾಕಾ ಎಕ್ ಮಾನುಸ್ ಮಾರುಲಾಗಲ್ಲೊ ಮಿಯಾ ತೆಜೊ ಜಿವ್ ಕಾಡ್ಲೊ ಮಟ್ಲ್ಯಾನ್ , <verse eid="GEN 4:23" /><verse number="24" style="v" sid="GEN 4:24" />ತನ್ನಾ ಕಾಯಿನಾಕ್ ಜಿವಾನ್ ಮಾರ್ತಲ್ಯಾಕ್ನಿ ಸಾತ್ ಪಟ್ಟ್ ಶಿಕ್ಷ್ಯಾ ಗಾವ್ತಾ ಹೊಲ್ಯಾರ್ ! ಮಾಕಾ ಜಿವ್ ಕಾಡಲ್ಯಾಕ್ನಿ ಸಾತಾಚೆ ಸತ್ತರ್ ಜಿವಾ ಕಾಡುನ್ ಹೊತಾ.<verse eid="GEN 4:24" /></para>
  <para style="s">ಸೆತ್ ಅನಿ ಎನೊಶ್</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />ಅನಿ ಪರ್‍ತುನ್ ಆದಾಮ್ ತೆಚ್ಯಾ ಬಾಯ್ಕೊಕ್ ಮಿಳ್ತಾನಾ ತಿಕಾ ಅನಿ ಎಕ್ ಪೊರ್ ಉಪಜ್ಲೊ ತನ್ನಾ ಹವ್ವಾನ್, “ದೆವಾನ್ ಮಾಕಾ ಕಾಯಿನಾನ್ ಜಿವಾನಿ ಮಾರಲ್ಲ್ಯಾ ಅಬೆಲಾಚ್ಯಾ ಬದ್ಲಾಕ್ ಎಕ್ ಲೆಕ್ ದಿಲ್ಯಾನ್” ಮನುನ್ ತೆಕಾ ತಿನಿ ಸೆತ್ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್. <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />ಮಾನಾ ಸೆತಾಕ್ ಎಕ್ ಪೊರ್ ಉಪಜ್ಲೊ , ತೆನಿ ತೆಕಾ ಎನೊಶ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್, ತನ್ನಾಚ್ಯಾನ್ ಲೊಕಾನಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚೆ ನಾವ್ ಘೆವ್ನ್ ಮಾಗ್ನಿ ಕರುಕ್ ಶುರು ಕರ್ಲ್ಯಾನಿ.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">ಆದಾಮಾಚಿ ಪಿಳ್ಗಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />ಆದಾಮಾಚ್ಯಾ ಪಿಳ್ಗಿಚಿ ಚರಿತ್ರಾ ಅಸಿ ಹಾಯ್; ದೆವಾನ್ ಮಾನ್ಸಾಕ್ ರಚ್ತಾನಾ ತೆಕಾ ಅಪ್ನಾಚ್ಯಾ ಸಾರ್ಕೆಚ್ ರಚ್ಲ್ಯಾನ್. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />ತೆನಿ ತೆಂಕಾ ಘೊಮಾನುಸ್ ಅನಿ ಬಾಯ್ಕೊ ಮಾನುಸ್ ಕರುನ್ ರಚ್ಲ್ಯಾನ್ ತೆಂಕಾ ರಚಲ್ಲ್ಯಾ ದಿಸಾತುಚ್ ಆಶಿರ್ವಾದ್ ಕರುನ್ “ಮಾನುಸ್” ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 5:2" /><verse number="3" style="v" sid="GEN 5:3" />ಆದಾಮ್ ಎಕ್ಸೆ ತಿಸ್ ವರ್ಸಾಚೊ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ತೆಕಾ ತೆಚ್ಯಾ ಸಾರ್ಕೊಚ್ ಎಕ್ ಲೆಕ್ ಉಪಜ್ಲೊ, ತೆಚೆ ನಾವ್ ಸೆತ್ ಮನುನ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />ಸೆತ್ ಮನ್ತಲೊ ಉಪಜಲ್ಯಾ ಮಾನಾ ಆದಾಮ್ ಆಟ್ಸೆ ವರಿಸ್ ಝಿತ್ತೊ ರ್‍ಹಾವ್ನ್ ತೆಕಾ ಅನಿಬಿ ಪೊರಾ ಹೊಲಿ. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />ಅನಿ ತೊ ನ್ಹವ್ಸೆ ತಿಸ್ ವರ್ಸಾತ್ ಮರುನ್ ಗೆಲೊ.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />ಸೆತಾಕ್ ಎಕ್ಸೆ ಪಾಂಚ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಎಕ್ ಲೆಕ್ ಉಪಜ್ಲೊ ತೆಚೆ ನಾವ್ ಎನೊಶ್. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />ಎನೊಶ್ ಉಪಜಲ್ಯಾ ಮಾನಾ ಆಟ್ಸೆ ಸಾತ್ ವರಿಸ್ ಜಿವನ್ ಕರ್ಲ್ಯಾನ್ ತೆಕಾ ಅನಿಬಿ ಪೊರಾ ಹೊಲಿ. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />ಅನಿ ನೊವ್ಸೆ ಬಾರಾ ವರ್ಸಾತ್ ತೊ ಮರ್ಲೊ.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />ಎನೊಶಾಕ್ ನ್ಹವ್ವದ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ತೆಕಾ ಕೆನಾನ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />ಕೆನಾನ್ ಉಪಜಲ್ಯಾ ಮಾನಾ ಎನೊಶಾನ್ ಆಟ್ಸೆ ಪಂದ್ರಾ ವರಿಸ್ ಪತರ್ ಜಿವನ್ ಕರ್ಲ್ಯಾನ್, ತೆಕಾ ಅನಿಬಿ ಪೊರಾ ಹೊತ್ತಿ. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />ಮಾನಾ ಎನೊಶ್ ನ್ಹವ್ಸೆ ಪಾಚ್ ವರಿಸಾತ್ ಮರುನ್ ಗೆಲೊ.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />ಮಾನಾ ಕೆನಾನಾಕ್ ಸತ್ತರ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಮಹಲಾಲೆಲ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ, <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />ಮಾನಾ ತೆಚೊ ಬಾಬಾ ಕೆನಾನ್ ಆಟ್ಸೆ ಚಾಳಿಸ್ ವರಿಸ್ ಪತರ್ ಜಿವನ್ ಕರ್ಲ್ಯಾನ್, ಅನಿ ತೆಕಾ ಪೊರಾ ಉಪಜ್ಲಿ. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />ಮಾನಾ ಕೆನಾನ್ ನ್ಹವ್ಸೆ ಧಾ ವರಿಸ್ ಝಿತ್ತೊ ರ್‍ಹಾವ್ನ್ ಮರುನ್ ಗೆಲೊ.<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />ಮಹಲಾಲೆಲಾಕ್ ಸಾಟಾರ್ ಪಾಚ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಜಾರೆದ್ ಮನ್ತಲ್ಯಾ ನಾವಾಚೊ ಲೆಕ್ ಉಪಜ್ಲೊ. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />ಜಾರೆದ್ ಉಪಜಲ್ಯಾ ಮಾನಾ ಅನಿ ಪೊರಾ ಹೊಲಿ ಮಾನಾ ಮಹಲಾಲೆಲಾಕ್ ಆಟ್ಸೆ ತಿಸ್ ವರಿಸ್ ಜಿವನ್ ಕರ್ಲ್ಲ್ಯಾನ್. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />ಅಸಿ ಮಹಲಾಲೆಲ್ ಆಟ್ಸೆ ನ್ಹವದಾರ್ ಪಾಚ್ ವರಿಸ್ ಪತರ್ ಝಿತ್ತೊ ರ್‍ಹಾವ್ನ್ ಮರುನ್ ಗೆಲೊ. <verse eid="GEN 5:17" /><verse number="18" style="v" sid="GEN 5:18" />ಜಾರೆದಾಕ್ ಎಕ್ಸೆ ಸಾಟಾರ್ ದೊನ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಹನೊಕ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />ಹನೊಕ್ ಉಪಾಜಲ್ಲ್ಯಾ ಮಾನಾ ಜಾರೆದಾಕ್ ಅನಿಬಿ ಪೊರಾ ಹೊಲಿ ಜಾರೆದಾನ್ ಆಟ್ಸೆ ವರಿಸ್ ಝಿತ್ತೊ ರಾಲೊ . <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />ಜಾರೆದ್ ನ್ಹವ್ಸೆ ಸಾಟಾರ್ ದೊನ್ ವರಿಸ್ ಝಿತ್ತೊ ರ್‍ಹಾವ್ನ್ ಮರುನ್ ಗೆಲೊ.<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />ಹನೊಕ್ ಸಾಟಾರ್ ಪಾಂಚ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಮೆತುಶೆಲ್ ಮನ್ತಲೊ ಎಕ್ ಲೆಕ್ ಉಪಜ್ಲೊ. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />ಮಾನಾ ತೊ ದೆವಾಕ್ ವಿಶ್ವಾಸಾಚೊ ಹೊವ್ನ್ ತಿನ್ಸೆ ವರ್ಸಾ ಜಿವನ್ ಕರ್ಲ್ಯಾನ್ ತೆಕಾ ಅನಿಬಿ ಪೊರಾ ಹೊತ್ತಿ. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />ಹನೊಕ್ ತಿನ್ಸೆ ಸಾಟಾರ್ ಪಾಂಚ್ ವರಿಸ್ ಝಿತ್ತೊ ರಾಲೊ. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />ಹನೊಕ್ ದೆವಾಚ್ಯಾ ವಾಂಗ್ಡಾ ವಿಶ್ವಾಸಾನ್ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ತೊ ನಾಪತ್ತೊ ಹೊವ್ನ್ ದೆವಾನ್ ತೆಕಾ ಘೆವ್ನ್ ಗೆಲ್ಯಾನ್.<verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />ಮಾನಾ ಮೆತುಶೆಲಾಕ್ ಎಕ್ಸೆ ಆಯ್ಸಿರ್ ಸಾತ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಲಾಮೆಕ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />ಲಾಮೆಕಾಕ್ ಪೊರ್ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಮೆತುಶೆಲಾಕ್ ಅನಿಬಿ ಪೊರಾ ಹೊತ್ತಿ, ಅನಿ ತೆನಿ ಸಾತ್ಸೆ ಆಯ್ಸಿರ್ ದೊನ್ ವರಿಸಾತ್ ಮರುನ್ ಗೆಲೊ. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />ಅನಿ ಮೆತುಶೆಲಾನ್ ನ್ಹವ್ಸೆ ಸಾಟಾರ್ ನ್ಹವ್ ವರಿಸ್ ಜಿವನ್ ಕರುನ್ ಮರುನ್ ಗೆಲೊ.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />ಮಾನಾ ಲಾಮೆಕಾಕ್ ಎಕ್ಸೆ ಆಯ್ಸಿರ್ ದೊನ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ತೆಕಾ ಎಕ್ ಪೊರ್ ಉಪಜ್ಲೊ, <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />ದೆವಾನ್ ಶಾಪ್ ದಿಲ್ಲ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಘೊಳ್ತಲ್ಯಾ ತರಾಸಾತ್ನಾ ಅಮ್ಕಾ ಸುಟ್ಕಾ ದಿತಾ ಮನುನ್ ನೊಯೆ ಮನ್ತಲೆ ನಾವ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />ನೊಯೆ ಚ್ಯಾ ಮಾನಾ ಲೆಮೆಕಾಕ್ ಅನಿ ಪೊರಾ ಹೊಲಿ ಮಾನಾ ತೊ ಪಾಂಸ್ಸೆ ನ್ಹವದಾರ್ ಪಾಂಚ್ ವರಿಸ್ ಝಿತ್ತೊ ರಾಲೊ. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />ಮಾನಾ ಲೆಮೆಕ್ ಸಾತ್ಸೆ ಸತ್ತರಾರ್ ಸಾತ್ ವರಿಸಾತ್ ಮರುನ್ ಗೆಲೊ.<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />ಮಾನಾ ನೊಯೆ ಪಾಂಸ್ಸೆ ವರ್ಸಾಚೊ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಶೆಮ್, ಹಾಮ್, ಅನಿ ಜಾಫೆತ್ ಮನ್ತಲಿ ತಿನ್ ಲೆಕಾ ಉಪಜ್ಲಿ.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">ಮಾನ್ಸಾಚೆ ಬುರ್ಸೆಪಾನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />ಹ್ಯಾ ಜಗಾ ವರ್‍ತಿ ಲೊಕಾ ವಾಡುನ್ಗೆತ್ ಗೆಲ್ಲ್ಯಾ ಸಾರ್ಕಿ ತೆಂಕಾ ಚೆಡ್ವಾಬಿ ಉಪಜ್ಲಿ. <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />ತನ್ನಾ ದೆವಾಚ್ಯಾ ಲೆಕಾನಿ ಮಾನ್ಸಾಚ್ಯಾ ಲೆಕಿಯಾಂಚೆ ಸುಂದರ್ ಪಾನ್ ಬಗುನ್, ಅಪ್ನಿ ಎಚುನ್ ಘೆಟಲ್ಯಾ ಚೆಡ್ವಾಕ್ನಿ ಲಗಿನ್ ಕರುನ್ ಘೆಟ್ಲ್ಯಾನಿ. <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್, ಮಾಜೊ ಆತ್ಮೊ ಸದಾಸರ್ವತಾಕ್ ಹೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ರಾವ್ಕ್ ಮಿಯಾ ಸೊಡಿನಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಲೊಕಾ ಮರ್ತಲಿಚ್, ತೆನಿ ಎಕ್ಸೆ ವಿಸ್ ವರಿಸ್ ತವ್ಡೆಚ್ ಝಿತ್ತೆ ರ್‍ಹಾವ್ಚೆ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 6:3" /><verse number="4" style="v" sid="GEN 6:4" />ತ್ಯಾ ದಿಸಾತ್ನಿ ಅನಿ ತೆಚ್ಯಾ ಮಾನಾಚ್ಯಾ ದಿಸಾತ್ನಿ ಮಾನ್ಸಾಂಚ್ಯಾ ಲೆಕಿಯಾಂಚ್ಯಾ ಅನಿ ದೆವಾಚ್ಯಾ ಲೆಕಾಂಚ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೈ ಮೊಟ್ಟ್ಯಾ ಆಂಗಾಚಿ ಲೊಕಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಹೊತ್ತಿ, ತೆನಿ ಲೈ ತಾಕ್ತಿಚೆ ಅನಿ ನಾವ್ ಕರಲ್ಲೆ ಹೊವ್ನ್ ಹೊತ್ತೆ.<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಜಗಾಚ್ಯಾ ವರ್‍ತಿ ಮಾನ್ಸಾಚೆ ಬುರ್ಸೆ ಪಾನ್ ಲೈ ವಾಡುನ್ಗೆತ್ ಹೊತ್ತೆ, ಅನಿ ತೆಂಚಿ ಮನಾತ್ಲಿ ಯೆವ್ಜನ್ಯಾ ಕನ್ನಾಬಿ ಬುರ್ಶಿಚ್ ಹೊವ್ನ್ ಹೊತ್ತೆ ಬಗುನ್, <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />ಜಿಮ್ನಿ ವರ್‍ತಿ ಮಾನ್ಸಾಕ್ನಿ ರಚಲ್ಯಾ ಸಾಟ್ನಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಲೈ ಬೆಜಾರ್ ಹೊಲೊ, ಅನಿ ತೆಜೊ ಮನ್ ಚುಟ್ಮುಟ್ಲೊ, <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />ಮಿಯಾ ಹ್ಯಾ ರಚಲ್ಯಾ ಜಿಮ್ನಿ ವೈನಾ ಮಾನ್ಸಾಕ್ನಿ ನಾಶ್ ಕರ್ತಾ, ಅನಿ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಹರ್ ಎಕ್ ಜನಾವಾರಾಕ್ನಿ, ಫಾಕ್ರಾಕ್ನಿ ಅನಿ ಜಿಮ್ನಿರ್ ಫಿರುನ್ಕೆಳ್ತಲ್ಯಾ ಕಿಡ್ಯಾಕ್ನಿಬಿ ನಾಶ್ ಕರ್ತಾ , ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಮಿಯಾ ತೆಂಕಾ ರಚಲ್ಯಾ ವೈನಾ ಮಾಕ್ ಲೈ ಬೆಜಾರ್ ಹೊವ್ಲಾ, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />ಖರೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚ್ಯಾ ನದ್ರೆಕ್ ನೊಯೆ ಮೆಚ್ಕಿಚೊ ಹೊವ್ನ್ ಹೊತ್ತೊ.<verse eid="GEN 6:8" /></para>
  <para style="s">ನೊಯೆ</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />ಹಿ ನೊಯೆಚಿ ಚರಿತ್ರಾ: ತೊ ಧರ್ಮಿಸ್ಟ್ ಅನಿ ಚುಕ್ ನಸಲ್ಲೊ ಹೊವ್ನ್ ಹೊತ್ತೊ, ತ್ಯಾ ಎಳಾರ್ ತೆಜಾ ಸಾರ್ಕೊ ಕೊನ್ಬಿ ನತ್ತೊ, ಅನಿ ತೊ ದೆವಾಚ್ಯಾ ವಾಂಗ್ಡಾ ವಿಶ್ವಾಸಾನ್ ಹೊತ್ತೊ. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />ಅನಿ ನೊಯೆಕ್ ಶೆಮ್, ಹಾಮ್, ಜಾಫೆತ್ ಮನ್ತಲಿ ತಿನ್ ಲೆಕಾ ಹೊತ್ತಿ. <verse eid="GEN 6:10" /><verse number="11" style="v" sid="GEN 6:11" />ತ್ಯಾ ಎಳಾರ್ ಲೊಕಾಂಚ್ಯಾ ವೈನಾ ಜಿಮಿನ್ ಬುರ್ಸ್ಯಾ ಪಾನಾನ್ ತರಾಸಾನ್ ಭರಲ್ಲಿ ಹೊತ್ತಿ. <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಜಗಾ ವರ್‍ತಿ ಹೊತ್ತಿ ಲೊಕಾಂಚಿ ಚಾಲ್ ಬುರ್ಶಿ ಹೊಲ್ಲಿ ಬಗಟ್ಲ್ಯಾನ್.<verse eid="GEN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 6:13" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ನೊಯೆಕ್, ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ಮಿಯಾ ನಾಶ್ ಕರ್ತಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಹೆಂಚ್ಯಾ ವೈನಾ ಜಿಮ್ನಿರ್ ತರಾಸ್ ಭರಲ್ಲೊ ಹಾಯ್, ಮಿಯಾ ಖರೆಚ್ ತೆಂಕಾಬಿ ಜಗಾತ್ ರ್‍ಹಾತಲೆ ಸಗ್ಳೆಬಿ ನಾಶ್ ಕರ್ತಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />ಅನಿ ಎಕ್ ಬರ್‍ಯಾ ಝಾಡಾಚೆ ತುಜ್ಯಾ ಸಾಟ್ನಿ ಮನುನ್ ಎಕ್ ಮೊಟಿ ಢೊನ್ ಭಾಂದುನ್ ಘೆ ತ್ಯಾತುರ್ ಲೈ ಖೊಲಿಯಾ ರಾಂವ್ದಿ ಅನಿ ಭಾಯ್ರ್ ಅನಿ ಭುತ್ತುರ್ನಾ ಡಾಂಬರ್ ಲಾವ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />ಅನಿ ತ್ಯಾ ಢೊನಾಚಿ ಲಾಂಬಿ ತಿನ್ಸೆ ಹಾತ್, ರುಂದಿಕ್ ಪನ್ನಾಸ್ ಹಾತ್ ಅನಿ ಉಪ್ಪರ್ ತಿಸ್ ಹಾತ್ ಹೊವ್ನ್ ರ್‍ಹಾವ್ಚೆ. <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />ಡೊನಾಚ್ಯಾ ಥಾಟಾಚ್ಯಾ ಖಾಲ್ತಿ ಭೊತ್ಯಾನಿ ಎಕ್ ಹಾತ್ ಲಾಂಬಿ ಕಿಂಡ್ ಥವ್ ತೆಚ್ಯಾ ಜಗ್ಗೊಳ್ ದಾರ್ ರಾಂವ್ದಿತ್ ಅನಿ ತ್ಯಾತುರ್ ತಿನ್ ಮಾಳ್ಗಿ ರಾಂವ್ದಿ. <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />ಮಿಯಾ ತುಕಾ ಸಾಂಗ್ತಲೆ ಅರ್ಥ್ ಕರುನ್ ಘೆ ಮಿಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಜನಾವಾರಾಕ್ನಿ ಜಲ್ ಪ್ರಳಯಾನ್ ನಾಸ್ ಕರ್ತಾ, ಹರ್ ಎಕ್ ಮರುನ್ ಜಾತಾ. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />ಖರೆ ಮಿಯಾ ತುಜಾಕ್ಡೆ ಎಕ್ ಕರಾರ್ ಕರುನ್ಗೆತಾ ತೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ತಿಯಾ ಅನಿ ತುಜಿ ಬಾಯ್ಕೊ, ಲೆಕಾ, ಸುನ್ನಾ ಹೆನಿ ಸಗ್ಳೆ ಢೊನಾತ್ ಜಾವ್ಚೆ. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />ಅನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ಹೊತ್ತ್ಯಾ ಜನಾವರಾತ್ನಿ ಹರ್ ಎಕ್ಬಿ ಎಕ್ ಗಂಡ್ ಎಕ್ ಹೆನ್ನ್ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಢೊನಾತ್ ಝಿತ್ತೆ ರಾಂವ್ದಿತ್, <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />ಜಿಮ್ನಿ ವರ್‍ತಿ ರ್‍ಹಾತಲ್ಯಾ ಎಕ್ ಜೊಡ್ ಫಾಕ್ರಾಂಚಿ, ಅನಿ ಎಕ್ ಜೊಡ್ ಜಿಮ್ನಿ ವರ್‍ತಿ ಫಿರುನ್ ಖೆಳ್ತಲ್ಯಾ ಕಿಡ್ಯಾಂಚಿ, ಅನಿ ಹರ್ ಎಕ್ ಜಾತಿಚಿಬಿ ದೊದೊನ್ ಜನಾವಾರಾ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಝಿತ್ತೆ ರಾವ್ಕ್ ಯೆಂವ್ದಿ. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />ಅನಿ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚೆ ಖಾವ್ಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ಜಿನ್ಸಾ ತಮ್ಕ್ಯಾ ವಾಂಗ್ಡಾ ಡೊನಾತ್ ಥವ್ನ್ ಗೆ ತೆ ತುಕಾ ಅನಿ ಸಗ್ಳ್ಯಾ ಜನಾವಾರಾಕ್ನಿ ಜೆವ್ನಾಕ್ ಹೊತಾ. <verse eid="GEN 6:21" /><verse number="22" style="v" sid="GEN 6:22" />ನೊಯೆನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಕರ್ಲ್ಯಾನ್.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">ಜಲ್ ಪ್ರಳಯ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />ಅನಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ನೊಯೆಕ್: ತುಜ್ಯಾ ಘರಾತ್ಲ್ಯಾ ಲೊಕಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಢೊನಾತ್ ಜಾ. ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಹ್ಯಾ ಎಳಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ತಿಯಾ ಎಕ್ಲೊಚ್ ಮಾಜ್ಯಾ ನದ್ರೆಕ್ ಧರ್ಮಿಸ್ಟ್ ಹೊವ್ನ್ ದಿಸ್ಲೆಯ್. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />ಅನಿ ಹರ್ ಎಕ್ ಜಾತಿಚೆಬಿ ನಿತಳ್ ಜನಾವರಾತ್ನಿ ಸಾತ್ ಜೊಡಿಯಾ ನಿತಳ್ ನತ್ತ್ಯಾ ಜನಾವರಾತ್ನಿ ಎಕೆಕ್ ಜೊಡಿಯಾ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಬಲ್ವುನ್ ಘೆ. <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />ಅನಿ ಮಳ್ಬಾತ್ ಉಡ್ತಲ್ಯಾ ಫಾಂಕ್ರಾತ್ನಿ ಸಾತ್ ಜೊಡಿಯಾ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಘೆ ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಝಿತ್ತಿ ರ್‍ಹಾವ್ನ್ ಅನಿ ತೆಂಚಿ ಪಿಳ್ಗಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ವಾಡುಕ್ ಪಾಜೆ. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />ಅತ್ತಾಚ್ಯಾನ್ ಸಾತ್ ದಿಸ್ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಮಿಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಮೊಟೊ ಪಾವ್ಸ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಹೊ ಪಾವ್ಸ್ ಚಾಳಿಸ್ ದಿಸ್ ಅನಿ ರ್‍ಹಾತ್ ಯೆತಾ, ಅನಿ ಮಿಯಾ ರಚಲ್ಯಾ ಹರ್ ಎಕ್ ಜಿವಿಕ್ಬಿ ಜಿಮ್ನಿ ವೈನಾ ನಾಶ್ ಕರ್ತಾ, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ನೊಯೆನ್ ಕರ್ಲ್ಯಾನ್.<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />ಜಿಮ್ನಿ ವರ್‍ತಿ ಜಲ್ ಪ್ರಳಯ್ ಹೊತಾನಾ ನೊಯೆಕ್ ಸಾಸೆ ವರಿಸ್ ಹೊಲ್ಲೊ ಹೊತ್ತೊ. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />ನೊಯೆ ಅನಿ ತೆಚಿ ಬಾಯ್ಕೊ ಲೆಕಾ ಅನಿ ಸುನ್ನಾ ಹೆನಿ ಸಗ್ಳೆ ಜಲ್ ಪ್ರಳಯಾಕ್ನಾ ಬಚಾವ್ ಹೊವ್ಕ್ ಸಾಟ್ನಿ ಮನುನ್ ಢೊನಾತ್ ಗೆಲೆ. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />ಅನಿ ನಿತಳ್ ಅನಿ ನಿತಳ್ ನತ್ತಿ ದೊನಿ ನಮುನ್ಯಾಚಿ ಜನಾವರಾತ್ನಿ, ಫಾಂಕ್ರಾತ್ನಿ ಅನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ಫಿರುನ್ ಖೆಳ್ತಲೆ ಹರ್ ಎಕ್ ನಮುನ್ಯಾಚೆ ಕಿಡೆ ಅನಿ ಹರ್ ಎಕ್ ಪೊಟಾನಿ ಜಾತಲೆ ಹರ್ ಎಕ್, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />ಅನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ರ್‍ಹಾತಲ್ಯಾ ಹರ್ ಎಕ್ ನಮುನ್ಯಾಚಿ ದೊದೊನ್ ಗಂಡ್ ಅನಿ ಹೆನ್ನ್ ಢೊನಾತ್ ಗುಸುಕ್ ಸಾಟ್ನಿ ನೊಯೆಕ್ಡೆ ಯೆಲೆ, ಅಸೆ ಹೊವ್ಚೆ ಮನುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾನ್.<verse eid="GEN 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 7:10" />ಸಾತ್ ದಿಸಾಚ್ಯಾ ಮಾನಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಜಲ್ ಪ್ರಳಯ್ ಸುರು ಹೊಲೆ.<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />ನೊಯೆಕ್ ಸಾಸೆ ವರ್ಸಾ ಬರ್ಲಿ ತ್ಯಾ ವರ್ಸಾಚ್ಯಾ ದೊನ್ವೆ ಮೈನ್ಯಾಚ್ಯಾ ಸತ್ರಾ ದಿಸಾ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಬುಡ್ಲ್ಯಾ ಸಾಗರ್‍ಹಾತ್ಲಿ ಝರಿಯಾ ಪುಟ್ಲಿ ಅನಿ ಮಳ್ಬಾಚಿ ಪ್ರಳಯಾಚಿ ದಾರಾ ಉಗಡ್ಲಿ ಅನಿ ಪಾವ್ಸ್ ವತುಲಾಲೊ. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />ಅನಿ ಚಾಳಿಸ್ ದಿಸ್ ಅನಿ ಚಾಳಿಸ್ ರ್‍ಹಾತ್ ಪಾವ್ಸ್ ಜಿಮ್ನಿ ವರ್‍ತಿ ವತ್ಲೊ. <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />ತ್ಯಾ ದಿಸಿ ನೊಯೆನ್ ಅಪ್ಲಿ ಲೆಕಾ ಶೆಮ್ ಹಾಮ್ ಜಾಫೆತ್ ಅನಿ ಅಪ್ಲಿ ಬಾಯ್ಕೊ ಅನಿ ಸುನ್ನಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಢೊನಾತ್ ಗುಸ್ಲೊ, <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />ಅನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ಹೊತ್ತೆ ಹರ್ ಎಕ್ ಜಾತಿಚೆ ಎಚುನ್ ಘೆಟಲ್ಲೆ ಜನಾವರ್ ಅನಿ ಹರ್ ಎಕ್ ಜಾತಿಚಿ ಫಾಕ್ರಾ, ಜಿಮ್ನಿರ್ ಫಿರುನ್ ಖೆಳ್ತಲೆ ಕಿಡೆ ಢೊನಾತ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಗುಸ್ಲೆ. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಶ್ವಾಸ್ ರ್‍ಹಾತಲ್ಯಾ ಜನಾವಾರಾ ಅಪಪ್ಲ್ಯಾ ಜಾತಿಚ್ಯಾ ಸಾರ್ಕೆ ಜೊಡ್ಯಾನಿ ಯೆವ್ನ್ ನೊಯೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಢೊನಾತ್ ಗುಸ್ಲೆ. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />ಹಿ ಜನಾವಾರಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚ್ಯಾ ಹುಕುಮಾ ಸರ್ಕೆ ಹರ್ ಎಕ್ ಜಾತಿಬಿ ಗಂಡ್ ಅನಿ ಹೆನ್ನ್ ನೊಯೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಢೊನಾತ್ ಭುತ್ತುರ್ ಯೆಲಿ, ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಢೊನಾಚೆ ಧಾರ್ ಧಾಪ್ಲ್ಯಾನ್ .<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />ಚಾಳಿಸ್ ದಿಸ್ ಪಾವ್ಸ್ ಪಡುನ್ಗೆತುಚ್ ಹೊತ್ತೊ, ಅನಿ ಪಾನಿ ಲೈ ವೈರ್ ಯೆತಾನಾ ಢೊನ್ ಪಾನಿಯಾ ವರ್‍ತಿ ಪೆಂವುಕ್ ಲಾಗ್ಲೆ ಅನಿ ಜಿಮ್ನಿಕ್ನಾ ವರ್‍ತಿ ಉಟ್ಲೆ.<verse eid="GEN 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 7:18" />ಅನಿ ಪಾನಿ ಲೈ ಹೊವ್ನ್ ಭರುಲಾಲೆ ತನ್ನಾ ಢೊನ್ ಪಾನಿಯಾವರ್‍ತಿ ಪೆಂವುಲಾಲೆ. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />ಜಿಮ್ನಿ ವೈರ್ ಮೊಟಿ ಮೊಟಿ ಮಡ್ಡಿಯಾ ಬುಡುನ್ ಜಾಯ್ ಸಾರ್ಕೆ ತವ್ಡೆ ಪಾನಿ ಭರ್ಲೆ. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />ಪಾನಿ ಮಡ್ಡಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಪಂದ್ರಾ ಹಾತ್ ಹೊತ್ತೆ. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />ಜಿಮ್ನಿ ವರ್‍ತಿ ಹೊತ್ತಿ ಸಗ್ಳಿ ಜನಾವರಾ ಫಾಕ್ರಾ ಅನಿ ಮಾನ್ಸಾ ಮರುನ್ ಗೆಲಿ, ಜಿಮ್ನಿ ವರ್‍ತಿ ಹೊತ್ತೆ ಹರ್ ಎಕ್ ನಮುನ್ಯಾಚೆ ಫಿರುನ್ ಖೆಳ್ತಲೆ ಕಿಡೆ ಮರುನ್ ಗೆಲೆ. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />ಜಿಮ್ನಿ ವರ್‍ತಿ ಹೊತ್ತೆ ಹರ್ ಎಕ್ ನಮುನ್ಯಾಚೆ ಶ್ವಾಸ್ ಖೆಳ್ತಲೆ ಕಿಡೆ ಮರುನ್ ಗೆಲೆ. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />ಅಸೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಜಿಮ್ನಿ ವರ್‍ತಿ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಮಾನ್ಸಾಕ್ನಿ, ಜನಾವಾರಾಕ್ನಿ, ಅನಿ ಫಾಕ್ರಾಕ್ನಿ ಫಿರುನ್ ಖೆಳ್ತಲೆ ಕಿಡೆ ಹರ್ ಎಕ್ಬಿ ನಾಶ್ ಕರ್ಲ್ಯಾನ್; ನೊಯೆ ಅನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಢೊನಾತ್ ಹೊತ್ತೆ ಸಗ್ಳೆ ವಾಚುನ್ ರ್‍ಹಾಲೆ. <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />ಅನಿ ಎಕ್ಸೆ ಪನ್ನಾಸ್ ದಿಸಾ ಪತರ್ ಪಾನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ಭರುನ್ ಲೈ ಹೊವ್ನ್ ಹೊತ್ತೆ.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">ಜಲ್ ಪ್ರಳಯ್ ಸರ್ನಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ನೊಯೆಕ್ ಅನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತ್ಯಾ ಜನಾವರಾಕ್ನಿ ಇಸ್ರುಕ್ ನಾ, ಅನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ವಾರೊ ಯೆಯ್ ಸಾರ್ಕೆ ಕರುನ್ ಪಾನಿ ಆಟ್ವುಕ್ ಶುರು ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />ಅನಿ ಸಾಗರಾಚಿ ಝರಿಯಾ ಅನಿ ಮಳ್ಬಾಚಿ ದಾರಾ ಧಾಪ್ಲಿ, ಅನಿ ವತುಕ್ ಲಾಗಲ್ಲೊ ಪಾವ್ಸ್ ಬಂದ್ ಹೊಲೊ. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />ಅನಿ ಎಕ್ಸೆ ಪನ್ನಾಸ್ ದಿಸಾಂಚ್ಯಾ ಪತರ್ಬಿ ಪಾನಿ ಉತ್ರುಕ್ ಶುರು ಹೊವ್ಕ್ ನತ್ತೆ. <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />ಸಾತ್ವ್ಯಾ ಮೈನಾಚ್ಯಾ ಸತ್ರಾವ್ಯಾ ದಿಸಿ ಢೊನ್ ಅರಾರಾಟ್ ಮನ್ತಲ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ಮಡ್ಡಿವರ್‍ತಿ ಇಬೆರಾಲಿ. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />ದಾವೆಚ್ಯಾ ಮೈನ್ಯಾತ್ ಪೈಲೆಚ್ಯಾ ದಿಸಿ ಪಾನಿ ಆಟಿತ್ ಯೆತಾನಾ ಮಡ್ಡಿಚ್ಯಾ ಟಿಕ್ರಿಯಾ ದಿಸುಕ್ ಲಾಗ್ಲಿ.<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />ನೊಯೆನ್ ಚಾಳಿಸ್ ದಿಸಾ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಢೊನಾಚಿ ಎಕ್ ಕಿಡಕಿ ಉಗಡ್ಲ್ಯಾನ್, <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />ಅನಿ ಎಕ್ ಕಾವ್ಳೊ ಭಾಯ್ರ್ ಸೊಡ್ಲ್ಯಾನ್ ಅನಿ ಜಿಮ್ನಿ ವೈಲೆ ಪಾನಿ ವಾಳಿ ಪತರ್ ಬಿ ಕಾವ್ಳೊ ಥೈ ಹಿತ್ತೆ ಫಿರುನ್ಗೆತ್ ಹೊತ್ತೊ.<verse eid="GEN 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 8:8" />ಮಾನಾ ಅನಿಬಿ ನೊಯೆನ್ ಜಿಮಿನ್ ಆಟ್ಲಾಕಿ ನಾ ಮನುನ್ ಬಗುಕ್ ಎಕ್ ಪಾರಿವಾಳಾಕ್ ಧಾಡುನ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />ತನ್ನಾ ಪಾನಿ ಹೊತ್ತ್ಯಾ ವೈನಾ ತೊ ಪಾರಿವಾಳಾಕ್ ಪಾಯ್ ಥವ್ಕ್ ಜಾಗೊ ನತ್ತ್ಯಾ ವೈನಾ ಪರ್‍ತುನ್ ಯೆಲೆ, ತನ್ನಾ ನೊಯೆ ತೆಕಾ ಘೆವ್ನ್ ಢೊನಾಚ್ಯಾ ಭುತ್ತುರ್ ಸೊಡ್ಲ್ಯಾನ್. <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />ಮಾನಾ ನೊಯೆನ್ ಸಾತ್ ದಿಸ್ ರಾಕುನ್ ತ್ಯಾ ಪಾರಿವಾಳಾಕ್ ಅನಿ ಪರ್‍ತುನ್ ಭಾಯ್ರ್ ಸೊಡ್ಲ್ಯಾನ್. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />ತ್ಯಾ ದಿಸಿ ಸಾಂಚೆಕ್ಡೆ ಪರ್‍ತುನ್ ಪಾರಿವಾಳ್ ನೊಯೆಚ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆತಾ, ತೆಚ್ಯಾ ಠೊಚ್ಯಾತ್ ಒಲಿವ್ ಝಾಡಾಚೆ ಎಕ್ ಕವ್ಳೊ ಚಿಗುರ್ ರ್‍ಹಾತಾ, ತನ್ನಾ ನೊಯೆನ್ ಜಿಮ್ನಿ ವೈಲೆ ಪಾನಿ ಉತರ್ಲೆ ಮನುನ್ ಕಳ್ವುನ್ ಘೆಟ್ಲ್ಯಾನ್. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />ಅನಿ ಸಾತ್ ದಿಸಾ ಮಾನಾ ನೊಯೆನ್ ಪಾರಿವಾಳಾಕ್ ಪರ್‍ತುನ್ ಧಾಡ್ಲ್ಯಾನ್ ಖರೆ ಪಾರಿವಾಳ್ ಪರ್‍ತುನ್ ಯೆವ್ಕುಚ್ ನಾ.<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />ನೊಯೆಕ್ ಸಾಸೆ ಎಕ್ ವರ್ಸಾ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಎಕ್ವೆಚ್ಯಾ ಮೈನೆಚ್ಯಾ ಎಕ್ವೆ ದಿಸಿ ಜಿಮ್ನಿ ವೈಲೆ ಪಾನಿ ಉತರ್ಲೆ, ನೊಯೆನ್ ಢೊನಾಚೆ ದಾರ್ ಉಗ್ಡುನ್ ಹಿಕ್ಡಿ ತಿಕ್ಡಿ ಬಗ್ಲ್ಯಾನ್ ಜಿಮಿನ್ ವಾಳುಲಾಗಲಿ ದಿಸ್ಲಿ. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />ದೊನ್ವೆ ಮೈನ್ಯಾಚ್ಯಾ ಇಸಾರ್ ಸಾತ್ವ್ಯಾ ದಿಸಿ ಜಿಮಿನ್ ಫುರಾ ವಾಳಲ್ಲಿ ಹೊತ್ತಿ.<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />ತನ್ನಾ ದೆವಾನ್ ನೊಯೆಕ್, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“ತಿಯಾ ಅನಿ ತುಜಿ ಬಾಯ್ಕೊ ಲೆಕಾ ಅನಿ ಸುನ್ನಾ ಢೊನಾತ್ನಾ ಭಾಯ್ರ್ ಜಾವಾ, <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />ಅನಿ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತಿ ಜನಾವರಾ, ಫಾಕ್ರಾ, ಫಿರುನ್ ಖೆಳ್ತಲೆ ಕಿಡೆ ಹರ್ ಎಕ್ಬಿ ಭಾಯ್ರ್ ಯೆಂವ್ದಿತ್ ಅನಿ ತೆಂಚಿ ಪಿಳ್ಗಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ಲೈ ಹೊವ್ನ್ ವಾಡುಂದಿತ್” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 8:17" /><verse number="18" style="v" sid="GEN 8:18" />ಮಾನಾ ನೊಯೆ ಅನಿ ತೆಚಿ ಬಾಯ್ಕೊ ಲೆಕಾ, ಸುನ್ನಾ ಸಗ್ಳೆಬಿ ಢೊನಾಚ್ಯಾ ಭಾಯ್ರ್ ಯೆಲೆ. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />ಅನಿ ಸಗ್ಳಿ ಜನಾವರಾ, ಫಾಕ್ರಾ, ಫಿರುನ್ ಖೆಳ್ತಲೆ ಕಿಡೆ ಅಪಪ್ಲ್ಯಾ ತಾಂಡ್ಯಾ ಸಾರ್ಕೆ ಢೊನಾತ್ನಾ ಭಾಯ್ರ್ ಯೆಲೆ.<verse eid="GEN 8:19" /></para>
  <para style="s">ನೊಯೆ ಬಲಿ ಭೆಟ್ವುತಲೆ</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />ತನ್ನಾ ನೊಯೆನ್ ಎಕ್ ಬಲಿಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಭಾಂದ್ಲ್ಯಾನ್, ಅನಿ ಶುದ್ದ್ ಜನಾವಾರಾ ಅನಿ ಫಾಂಕ್ರಾತ್ನಿ ಎಕೆಕ್ ಘೆವ್ನ್ ಚರ್ಚರಿ ಜಾಳ್ವುನ್ ಬಲಿ ಭೆಟ್ವುಲ್ಯಾನ್. <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />ಬಲಿ ಭೆಟ್ವುತಲಿ ಬರಿ ವಾಸ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಮೆಚ್ಕಿ ಹೊಲಿ ಅನಿ ತೆನಿ ಹೆಜ್ಯಾನ್ ಫಿಡೆ ಮಿಯಾ ಮಾನ್ಸಾ ಸಾಟ್ನಿ ಜಿಮ್ನಿಕ್ ಶರಾಪಿನಾ, ಅನಿ ಹ್ಯಾ ಮಾನ್ಸಾಚೆ ಮನಾತ್ಲಿ ಯೆವ್ಜನ್ ತೊ ಬಾರಿಕ್ ರ್‍ಹಾತಾನಾಚ್ ಬುರ್ಶಿ ಮನುನ್ ಮಾಕಾ ಗೊತ್ ಹಾಯ್, ಅತ್ತಾ ಕರಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಅನಿ ಕನ್ನಾಬಿ ಮಿಯಾ ಜಿಮ್ನಿಕ್ ನಾಶ್ ಕರಿನಾ.<verse eid="GEN 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 8:22" />ಜಿಮಿನ್ ರ್‍ಹಾಯ್ ಪತರ್ಬಿ ಪೆರ್‍ತಲೊ, ಕಾತ್ರನಿಚೊ, ಥಂಡ್, ಅನಿ ಗರಮ್, ನಿಂಬ್ರಾಳ್ ಥಂಡಿಚಿ ದಿಸಾ, ದಿಸ್ ಅನಿ ರ್‍ಹಾತ್ ಹೆ ಸಗ್ಳೆ ರ್‍ಹಾತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">ನೊಯೆಚ್ಯಾ ವಾಂಗ್ಡಾ ದೆವಾಚೊ ಖರಾರ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />ದೆವಾನ್ ನೊಯೆಕ್ ಅನಿ ತೆಚ್ಯಾ ಲೆಕಾಕ್ನಿ ಆಶಿರ್ವಾದ್ ದಿವ್ನ್ ತೆಂಕಾ, ತುಮ್ಚಿ ಪಿಳ್ಗಿ ವಾಡುಂದಿತ್ ಅನಿ ಹ್ಯಾ ಜಗಾತ್ ಭರುಂದಿತ್, <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />ಹರ್ ಎಕ್ ಜನಾವರಾ, ಫಾಕ್ರಾ, ಜಿಮ್ನಿ ವರ್‍ತಿ ಫಿರುನ್ ಖೆಳ್ತಲೆ ಕಿಡೆ ಅನಿ ಮಾಸೊಳ್ಯಾ ತುಮ್ಕಾ ಖಾಲ್ತಿ ಹೊವ್ನ್ ರಾಂವ್ದಿ, ಅನಿ ತೆ ಸಗ್ಳೆ ತುಮ್ಚ್ಯಾ ಅಧಿನಾತ್ ರಾಂವ್ದಿತ್. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />ಅನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ಫಿರುನ್ ಖೆಳ್ತಲಿ ಸಗ್ಳಿ ಜನಾವಾರಾ ತುಮಿ ಖಾವಾ, ತುಮ್ಕಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಭಾಜಿ ಪಾಲೊ ಖಾವ್ಕ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಹೆಬಿ ದಿಲಾ. <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />ಖರೆ ರಗ್ತಾನ್ ಬರಲೆ ಮಾಸ್ ಖಾವ್ನೈ ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತ್ಯಾ ರಗ್ತಾತ್ ಜಿವ್ ರ್‍ಹಾತಾ ತಸೆ ಮನುನ್ ಮಿಯಾ ತುಕಾ ಖಾತಲೆ ನಕ್ಕೊ ಮನುಲ್ಲಾ. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />ಅಸೆ ರ್‍ಹಾತಾನಾ ತುಮ್ಚೆ ರಗಾತ್ ಘಳ್ವುನ್ ಜಿವ್ ಕಾಡ್ತಲ್ಯಾಕ್ನಿ ಮಿಯಾ ತೆಕಾ ಪರ್‍ತುನ್ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ ದಿತಾ, ತೆ ಮಾನ್ಸಾಚೊ ಜಿವ್ ಕಾಡ್ತಲೆ ಖಲೆ ಜನಾವರ್ ಹೊಲ್ಯಾರ್ಬಿ ತೆಕಾ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ದಿತಾ. <verse eid="GEN 9:5" /><verse number="6" style="v" sid="GEN 9:6" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾನ್ಸಾಕ್ ಅಪ್ನಾಚ್ಯಾ ರುಪಾತ್ ರಚ್ಲ್ಯಾನ್ ತಸೆ ಮನುನ್ ಜೆ ಕೊನ್ ಎಕ್ಲ್ಯಾನ್ ದುಸ್ರ್ಯಾಚೊ ಜಿವ್ ಕಾಡ್ಲ್ಯಾನ್ ತರ್ ಅನಿ ಎಕ್ಲೊ ತೆಜೊ ಜಿವ್ ಕಾಡ್ತಾ.<verse eid="GEN 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 9:7" />ಅನಿ ತುಮ್ಕಾ ಪೊರಾ ಲೈ ಹೊವ್ನ್; ಜಿಮ್ನಿ ವರ್‍ತಿ ತುಮ್ಚಿ ಪಿಳ್ಗಿ ವಾಡುಂದಿತ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />ದೆವಾನ್ ನೊಯೆಕ್ ಅನಿ ತೆಚ್ಯಾ ಲೆಕಾಕ್ನಿ, <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />“ಅಬಕ್, ಮಿಯಾ ಅನಿ ತುಮ್ಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ವಾಂಗ್ಡಾ, <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />ಅನಿ ತುಮ್ಚ್ಯಾ ಢೊನಾತ್ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಯೆಲ್ಲಿ ಸಗ್ಳಿ ಜನಾವರಾ ಫಾಕ್ರಾ ಹರ್ ಎಕ್ ನಮುನ್ಯಾಚ್ಯಾ ಜಿವಿಚ್ಯಾ ವಾಂಗ್ಡಾ, <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />ಹ್ಯಾ ಗೊಸ್ಟಿಯಾನಿ ಮಿಯಾ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಕರಾರ್ ಕರುನ್ಗೆತಾ, ಹ್ಯಾನ್ ಫಿಡೆ ಜಲ್ ಪ್ರಳಯಾನ್ ಹ್ಯಾ ಜಗಾಕ್ ಅನಿ ಜಿವಿಯಾಕ್ನಿ ನಾಶ್ ಕರಿನಾ ಮನುನ್ ಮಿಯಾ ಗೊಸ್ಟ್ ದಿತಾ. <verse eid="GEN 9:11" /><verse number="12" style="v" sid="GEN 9:12" />ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಅನಿ ಝಿತ್ತಿ ಹೊತ್ತ್ಯಾ ಹರ್ ಎಕ್ ಜಿವಿಚ್ಯಾ ವಾಂಗ್ಡಾ ಕರುನ್ ಘೆತಲೊ ಶಾಶ್ವತ್ ಆನಾಕ್ ಒಳಕ್ ಹೊವ್ನ್ ರ್‍ಹಾಯ್ ಸಾರ್ಕೆ, <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />ಮಿಯಾ ಮಳ್ಬಾತ್ನಿ ಕಾಮನ್ ಬಿಲ್ಲು ಥವ್ತಾ, ಹಿ ಮಿಯಾ ಜಗಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಕರುನ್ಗೆಟಲ್ಯಾ ಕರಾರಾಕ್ ವಳಕ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />ಜಗಾ ವರ್‍ತಿ ಮೊಡಾ ದಿಸ್ತಾನಾ ಮೊಡಾತ್ನಿ ಕಾಮನ್ ಬಿಲ್ಲ್ ದಿಸ್ತಾ. <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />ಮಿಯಾ ತೆ ಕಾಮನ್ ಬಿಲ್ಲ್ ಬಗ್ತಾನಾ, ಅನಿ ಕನ್ನಾಬಿ ಜಗಾಚ್ಯಾ ವಾಂಗ್ಡಾ ತುಜೆ ವರ್‍ತಿ, ಅನಿ ಜನಾವರಾಂಚ್ಯಾ ವರ್‍ತಿ ಪ್ರಳಯ್ ಯೆಯ್ನಾ ಮನುನ್ ಕರಲ್ಲೊ ಕರಾರ್ ಯಾದ್ ಕರುನ್ಗೆತಾ. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />ಕಾಮನ್ ಬಿಲ್ಲು ಅನಿ ಮೊಡಾ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಮಾಕಾ ಅನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ಹೊತ್ತ್ಯಾ ಹರ್ ಎಕ್ ಜಿವಿಕ್ನಿ ಹೊಲ್ಲಿ ಗೊಸ್ಟ್ ಯಾದ್ ಕರುನ್ಘೆತಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 9:16" /><verse number="17" style="v" sid="GEN 9:17" />ಅನಿ ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ನೊಯೆಕ್ ಮಾಕಾ ಅನಿ ಸಗ್ಳ್ಯಾ ಜಿವಿಕ್ನಿ ಹೊಲ್ಲ್ಯಾ ಖರಾರಾಕ್ ಹಿಚ್ ವಳಕ್ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 9:17" /></para>
  <para style="s">ನೊಯೆ ಅನಿ ತೆಚಿ ಲೆಕಾ</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />ಢೊನಾತ್ನಾ ಭಾಯ್ರ್ ಯೆಲ್ಲಿ ನೊಯೆಚಿ ಲೆಕಾ ಶೆಮ್, ಹಾಮ್, ಜಾಫೆತ್, ಹಾಮ್ ಕಾನಾನಾಚೊ ಬಾಬಾ. <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />ಅನಿ ನೊಯೆಚ್ಯಾ ಪೊರಾಂಚಿ ಪಿಳ್ಗಿ ಸಗ್ಳ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಪಗಳ್ಳಿ, ಅನಿ ಜಿಮ್ನಿ ವೈಲ್ಯಾ ಲೊಕಾಕ್ನಿ ಹೆನಿಚ್ ವಾಡ್ ವಡ್ಲಾ ಹೊವ್ನ್ ಹಾತ್. <verse eid="GEN 9:19" /><verse number="20" style="v" sid="GEN 9:20" />ನೊಯೆ ಎಕ್ ಸೆತ್ ಕಾರಿ ಹೊವ್ನ್ ಹೊತ್ತೊ ತೆನಿ ಎಕ್ ದರಾಕ್ಷಾಚೊ ಮ್ಹಳೊ ಕರುಕ್ ಸುರು ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />ತೊ ಎಕ್ ದಿಸಿ ದರಾಕ್ಷಾಚೊ ವಾಯ್ನ್ ಫಿವ್ನ್ ನಿಶ್ಯಾ ಹೊವ್ನ್ ತೆಚ್ಯಾ ಝೊಪ್ಡ್ಯಾತ್ ನಾಗ್ಡೊಚ್ ಪಡುನ್ ರ್‍ಹಾತಾ. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />ತೊ ನಾಗ್ಡೊ ನಿಜಲ್ಲೆ ತೆಜೊ ಲೆಕ್ ಕಾನಾನಾಚೊ ಬಾಬಾ ಹಾಮಾನ್ ಬಗುನ್ ಝೊಪ್ಡ್ಯಾಚ್ಯಾ ಭಾಯ್ರ್ ಹೊತ್ತ್ಯಾ ಭಾವಾಕ್ನಿ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />ಮಾನಾ ತೆನಿ ದೊಗೆಬಿ ಝೊಪ್ಡ್ಯಾಚ್ಯಾ ಬಿತ್ತುರ್ ಝಗೊ ಘೆವ್ನ್ ಪಾಟ್ಲ್ಯಾ ಪಾಯಾನಿ ಚಲುನ್ ಜಾವ್ನ್ ಬಾಬಾಚ್ಯಾ ಆಂಗಾ ವರ್‍ತಿ ಧಾಪ್ಲ್ಯಾನಿ, ತಸೆಹೊವ್ನ್ ತೊ ನಾಗ್ಡೊ ಹೊತ್ತೆ ತೆನಿ ಬಗುಕ್ನಾತ್. <verse eid="GEN 9:23" /><verse number="24" style="v" sid="GEN 9:24" />ಮಾನಾ ನೊಯೆ ಉಟುನ್ ಧಾಕ್ಲ್ಯಾ ಲೆಕಾನ್ ಕರಲ್ಲೆ ಆಯ್ಕುನ್, <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />ತೆಚ್ಯಾ ವೈನಾ ಕಾನಾನ್ ಶರಾಪಾತ್ ಪಡುಂದಿತ್.</para>
  <para style="p" vid="GEN 9:25">ಅನಿ ತೊ ತೆಜಾ ಭಾವಾಕ್ನಿ ಗುಲಾಮ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ ಮನುನ್ ಶಾಪ್ ದಿಲ್ಯಾನ್ .<verse eid="GEN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 9:26" />ಅನಿ ನೊಯೆನ್, ಶೆಮಾಚ್ಯಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಸ್ತುತಿ ಹೊಂವ್ದಿತ್, ಅನಿ ಶೆಮಾಕ್ ಕಾನಾನ್ ಗುಲಾಮ್ ಹೊವ್ನ್ ರಾಂವ್ದಿತ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 9:27" />ಅನಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಜಾಪೆತಾಚಿ ಪಿಳ್ಗಿ ವಾಡುಂದಿತ್, ಅನಿ ಕಾನಾನ್ ತೆಂಚೊ ಗುಲಾಮ್ ಹೊವ್ನ್ ರಾಂವ್ದಿತ್.<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />ಜಲ್ ಪ್ರಳಯ್ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ನೊಯೆನ್ ತಿನ್ಸೆ ಪನ್ನಾಸ್ ವರಿಸ್ ಜಿವಾನ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />ಮಾನಾ ನೊಯೆ ನ್ಹವ್ಸೆ ಪನ್ನಾಸ್ ವರಿಸ್ ಪತರ್ ರ್‍ಹಾವ್ನ್ ಮರುನ್ ಗೆಲೊ.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">ನೊಯೆಚ್ಯಾ ಪೊರಾಂಚಿ ಪಿಳ್ಗಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />ನೊಯೆಚಿ ಲೆಕಾ ಶೆಮ್, ಹಾಮ್, ಜಾಫೆತ್ ಹೆಂಕಾ ಜಲ್ ಪ್ರಳಯಾಚ್ಯಾ ಮಾನಾ ಲೆಕಾ ಉಪಜ್ಲಿ ತೆಂಚಿ ವಂಶಾವಳಿ ಅಸಿ ಹಾಯ್:<verse eid="GEN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 10:2" />ಹಿ ಜಾಫೆತಾಚಿ ಲೆಕಾ: ಗೊಮೆರ್, ಮಾಗೊಗ್, ಮೆದ್ಯಾ, ಜಾವಾನ್, ತುಬಾಲ್ ಮೆಶೆಕ್ ಅನಿ ತಿರಾಸ್,<verse eid="GEN 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 10:3" />ಅನಿ ಹಿ ಗೊಮೆರಾಚಿ ಲೆಕಾ: ಆಶ್ಕೆನಾಸ್‍, ರಿಫಾತ್ ಅನಿ ತೊಗಾರ್ಮಾ. <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />ಹಿ ಜಾವಾನಾಚಿ ಲೆಕಾ: ಎಲಿಶಾ, ತಾರ್ಶಿಸ್, ಸೈಪ್ರಸ್, ಕಿತ್ತಿಮ್ ಅನಿ ದೆದಾನ್, <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />ಹೆನಿ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆ ವೈನಿ ದ್ವಿಪಾತ್ನಿ ಜಿವನ್ ಕರ್ಲ್ಯಾನಿ ಅಪಪ್ಲಿ ಭಾಶಾ, ಕುಲ್ ದೆಶ್ಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಹೆನಿಚ್ ಜಾಫೆತಾಚಿ ಪಿಳ್ಗಿ. <verse eid="GEN 10:5" /><verse number="6" style="v" sid="GEN 10:6" />ಹಿ ಹಾಮಾಚಿ ಲೆಕಾ: ಕುಶ್, ಮಿಚ್ರಯಿಮ್, ಲಿಬಿಯಾ ಅನಿ ಕಾನಾನ್. <verse eid="GEN 10:6" /><verse number="7" style="v" sid="GEN 10:7" />ಅನಿ ಕುಶಾಚಿ ಲೆಕಾ: ಸೆಬಾ, ಹವಿಲ್, ಸಬ್ದಾ, ರಾಮಾ, ಅನಿ ಸಾಬ್ತಕಾ ರಾಮಾಚಿ ಲೆಕಾ ಶೆಬಾ ಅನಿ ದೆದಾನ್. <verse eid="GEN 10:7" /><verse number="8" style="v" sid="GEN 10:8" />ಅನಿ ಕುಶಾಕ್ ನಿಮ್ರೊದ್ ಮನ್ತಲೊ ಎಕ್ ಲೆಕ್ ಹೊತ್ತೊ ಹೆಚ್ ಲೈ ತಾಕ್ತಿಚೊ ಅನಿ ಜಗಾಚೊ ಪೈಲೆಚೊ ಪರಾಕರ್ಮಿ. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />ತಸೆ ಹೊವ್ನ್ ಧನಿಯಾಚ್ಯಾ ನದ್ರೆತ್ “ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚ್ಯಾ ಇದ್ರಾಕ್ ನಿಮ್ರೊದಾ ಸಾರ್ಕೊ ಶ್ರೆಸ್ಟ್ ಶಿಕಾರ್ ಕಾರಿ” ಕರುಂದಿತ್ ಮನ್ತಲಿ ಸಾಂಗ್ನಿ ಆಜ್ ಪತರ್ಬಿ ಹಾಯ್. <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />ಶಿನಾರ್ ದೆಸಾತ್ ಹೊತ್ತ್ಯಾ ಬಾಬಿಲೊನ್, ಯೆರೆಕ್, ಅಕದ್ ಅನಿ ಕಾಲ್ನೆ ಮನ್ತಲಿ ಶಾಹರಾ ತೆಚ್ಯಾ ರಾಜಾಚಿ ಮುಲ್ ಶಾರಾ. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />ತ್ಯಾ ದೆಸಾತ್ನಾ ತೊ ಅಶಿರಿಯಾ ಗಾಂವಾಕ್ ಯೆವ್ನ್ ಅನಿ ನಿನಿವೆ ರಹೊಬೊತಿರ್, ಕಾಲಾ; <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />ನಿನಿವೆ ಅನಿ ಕಾಲಹಾಕ್ ಮದ್ದಿ ಹೊತ್ತೆ ರೆಶನ್ ಮನ್ತಲೆ ಮೊಟೆ ಶಾರ್ ಭಾಂದ್ಲ್ಯಾನ್.<verse eid="GEN 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 10:13" />ಅನಿ ಇಜಿಪ್ತಾಚ್ಯಾ ಪಿಳ್ಗಿಕ್ನಾ ಲುದ್, ಆನಾಮ್, ಲೆಹಾಬ್ ಅನಿ ನಾಪ್ತುರ್, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />ಪತ್ರುಸ್ಯಾ, ಕಸ್ಲು ಹ್ಯಾ ಅನಿ ಕಪ್ತೊರಿಯಾಚಿ ಲೊಕಾ ಉಪಜ್ಲಿ, ಪಿಲಿಸ್ಟಿಯಾ ಕಸ್ತುಹ್ಯಾಕ್ನಾ ಉಪಜ್ಲಿ.<verse eid="GEN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 10:15" />ಕಾನಾನಾಚೊ ಥೊರ್ಲೊ ಲೆಕ್ ಸಿದೊಮ್, ಅನಿ ತೆಚ್ಯಾ ಮಾನಾ ಹೆತ್ ಉಪಜ್ಲೊ. <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />ಎವ್ಡೆಚ್ ನಸ್ತಾನಾ ಜೆಬುಸಿ , ಅಮೊರಿ, ಗಿರ್ಗಾಸಿ, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />ಹಿವಿಯಾ, ಆರ್ಕಿಯಾ, ಸಿನಿತ್, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />ಆರ್ವಾದಿತ್, ಜೆಮಾರಿತ್ ಅನಿ ಹಾಮಾತಿತ್ ಹೆನಿ ಸಗ್ಳೆ ಕಾನಾನಾಕ್ನಾ ಉಪಾಜಲ್ಲೆ, ಮಾನಾ ಕಾನಾಚ್ಯಾ ಕುಳಾಚೆ ಪಗಳ್ಳೆ. <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />ಕಾನಾನ್ ಗಾರಾಂಚೆ ಪ್ರದೆಶ್ ಸಿದೊನ್ ಶಾರ್‍ಹಾತ್ನಾ ಗೆರಿಕ್ನಾ ಗಾಜಾ ಮನ್ತಲ್ಯಾ ಶಾರಾ ಪತರ್ ಅನಿ ಸೊದೊಮ್ ಗೊಮೊರ್, ಆದ್ಮಾ ಅನಿ ಜೆಬೊಯಿಮ್ ಮನ್ತಲ್ಯಾ ಶಾರ್‍ಹಾತ್ನಿ ಜಾತಲ್ಯಾ ಲೆಶಾ ಮನ್ತಲ್ಯಾ ವಾಟೆಕ್ ಹೊತ್ತ್ಯಾ ಗಾಂವಾ ಪತರ್ ಪಗಳ್ಳೆ.<verse eid="GEN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 10:20" />ಕುಲ್ ಭಾಶಾ ದೆಶ್ ಅನಿ ಲೊಕಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಹೆನಿ ಹಾಮಾಚ್ಯಾ ಪಿಳ್ಗಿಚೆ.<verse eid="GEN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />ಜಾಫೆತಾಚೊ ಥೊರ್ಲೊ ಭಾವ್ ಶೆಮ್ ಮನ್ತಲೊ ಎಬೆರಾಚ್ಯಾ ಲೊಕಾಂಚೊ ವಾಡ್ ವಡಿಲ್ ಹೊವ್ನ್ ಹೊತ್ತೊ. <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />ಶೆಮಾಚಿ ಲೆಕಾ ಹೆನಿಚ್: ಎಲಾಮ್, ಅಶುರ್, ಅರ್ಪಕ್ಯಾದ್, ಲುದ್ ಅನಿ ಆರಾಮ್.<verse eid="GEN 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 10:23" />ಆರಾಮಾಚಿ ಲೆಕಾ: ಉಸ್, ಹುಲ್, ಗೆತೆರ್ ಅನಿ ಮಾಶ್. <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />ಅರ್ಪಕ್ ಶೆಲಾಚೊ ಬಾಬಾ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಅನಿ ಶೆಲಾಚೊ ಲೆಕ್ ಎಬೆರ್. <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />ಅನಿ ಎಬೆರಾಕ್ ದೊನ್ ಲೆಕಾ ಉಪಜ್ಲಿ ತ್ಯಾತುರ್ ಎಕ್ಲ್ಯಾಚೆ ನಾವ್ ಪೆಲೆಗ್ ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೆಚ್ಯಾ ಎಳಾರ್ ಜಿಮಿನ್ ವಾಟೆ ಹೊಲಿ, ಅನಿ ತೆಚ್ಯಾ ಭಾವಾಚೆ ನಾವ್ ಜೊಕ್ತಾನ್. <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />ಜೊಕ್ತಾನಾಚಿ ಲೆಕಾ: ಅಲ್ಮೊದಾದ್, ಶೆಲೆಪ್, ಹಾಜಾರ್ ಮಾವೆತ್ ಅನಿ ಜೆರಾ, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />ಹಾದೊರಾಮ್, ಉಜಾಲ್, ದಿಕ್ಲಹ್, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />ಒಬಾಲ್, ಅಬಿಮಾಯೆಲ್, ಸೆಬಾ, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />ಒಫಿರ್, ಹವಿಲ್, ಅನಿ ಜೊಬಾಬ್. <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />ಅನಿ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ಮಡ್ಡಿಯಾಂಚ್ಯಾ ಜಾಗ್ಯಾ ವೈನಿ ಹೊತ್ತ್ಯಾ ಶೆಫಾರ್ ಮಡ್ಡಿ ಪತರ್ಬಿ ಹೆಂಚೊ ವಸ್ತಿ ಕರ್ತಲೊ ಜಾಗೊ ಹೊತ್ತೊ. <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />ಖಾಂದಾನ್, ಭಾಶಾ, ದೆಶ್ ಲೊಕಾಂಚ್ಯಾ ಪರ್ಕಾರ್ ಹೆನಿಚ್ ಶೆಮಾಚ್ಯಾ ಪಿಳ್ಗಿಚೆ. <verse eid="GEN 10:31" /><verse number="32" style="v" sid="GEN 10:32" />ತೆಂಚ್ಯಾ ದೆಶ್ಯಾಂಚ್ಯಾ ವೈನಾ ಅನಿ ಲೊಕಾಂಚ್ಯಾ ಪಿಳ್ಗಿಯಾಂಚ್ಯಾ ವೈನಾ ಹೆನಿ ನೊಯೆಚ್ಯಾ ಪಿಳ್ಗಿಚೆ, ಹೆಂಚ್ಯಾ ವೈನಾ ಪ್ರಳಯ್ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಲೊಕಾ ಪಗಳ್ಳಿ.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">ಬಾಬೆಲ್ ಗೊಪುರ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />ಹ್ಯಾ ಜಗಾಚಿ ಪುರಾ ಲೊಕಾಬಿ ಎಕುಚ್ ಭಾಶ್ಯಾ ಅನಿ ಎಕುಚ್ ನಮುನೆಚಿ ಗೊಸ್ಟಿಯಾ ವಾಪ್ರಿತ್. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />ತೆನಿ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ಡೆ ಪ್ರಯಾನ್ ಕರುನ್ಗೆತ್ ಜಾಯ್ತ್ ರ್‍ಹಾತಾನಾ ಶಿನಾರ್ ದೆಶಾಚ್ಯಾ ಎಕ್ ಮಾಳ್ ಜಾಗ್ಯಾವರ್‍ತಿ ವಸ್ತಿ ಕರ್ಲ್ಯಾನಿ. <verse eid="GEN 11:2" /><verse number="3" style="v" sid="GEN 11:3" />ಅನಿ ತೆನಿ ಎಕಾಮೆಕಾಕ್, “ಯೆವಾ ಸಗ್ಳ್ಯಾನಿ ಅಮಿ ಮಾಟಿಚಿ ಇಟ್ಗಿಯಾ ಕರುನ್ ಅನಿ ತಿ ಜಾಳುಂವಾ” ಅಸೆ ಕರುನ್ ತೆನಿ ಗುಂಡ್ಯಾಂಚ್ಯಾ ಬದ್ಲಾಕ್ ಇಟ್ಗಿ, ಸಿಮೆಂಟಾಚ್ಯಾ ಬದ್ಲಾಕ್ ಡಾಂಬೊರ್ ವಾಪರ್ಲ್ಯಾನಿ. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />ಅನಿ ಎಕ್‍ ಶಾರ್ ಭಾಂದುಂವಾ ಮಳ್ಬಾಕ್ ಪಾವ್ತಲೆ ಗೊಪುರ್ ಭಾಂಧುನ್ ಮೊಟ್ಟೆ ಹೊವ್ವಾ ಅಸೆ ಕರ್ತಾನಾ ಅಮಿ ಪುರಾ ಜಗ್ ಭರ್ ಪಗ್ಳುನ್ ಜಾತಲೆ ರ್‍ಹಾಯ್ನಾ, ಮನುನ್ ಬೊಲುನ್ ಘೆಟ್ಲ್ಯಾನಿ.<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />ತನ್ನಾ ಮಾನ್ಸಾಚಿ ಲೆಕಾ ಭಾಂಧುಲಾಗಲ್ಲೆ ಶಾರ್ ಅನಿ ಗೊಪುರ್ ಬಗುಕ್ ಮನುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಖಾಲ್ತಿ ಉತ್ರುನ್ ಯೆಲೊ. <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />ತೆ ತೆನಿ ಬಗಲ್ಯಾ ಮಾನಾ “ಅಬಕ್, ಅತ್ತಾ ತೆನಿ ಎಕುಚ್ ಭಾಶ್ಯಾಚೆ ಬೊಲ್ತಲೆ ಹೊವ್ನ್ ಹಾತ್ ಅನಿ ಹೆ ತೆನಿ ಕರುಕ್ ಲಾಗಲ್ಲೆ ಆರಂಭಾಕ್ ತವ್ಡೆಚ್ ಅಸೆಚ್ ಸೊಡ್ಲ್ಯಾರ್ ಕಾಯ್ಬಿ ಕರುಕ್ ಶಕ್ತ್ ಹಾತ್. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />ಎವಾ, ಅಮಿ ಉತ್ರುನ್ ಜಾವ್ನ್ ತೆಂಚಿ ಭಾಶ್ಯಾ ತೆಂಕಾ ಕಳಿನಾ ಸಾರ್ಕೆ ಕಂಗಾಲ್ ಕರುಂವಾ” ಮಟ್ಲ್ಯಾನಿ. <verse eid="GEN 11:7" /><verse number="8" style="v" sid="GEN 11:8" />ತಸಿ ಕರುನ್ ತೆಂಕಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಸಗ್ಳ್ಯಾ ಜಗಾತ್ ಪಗ್ಳ್ಯಾನ್, ಮಾನಾ ತೆನಿ ಶಾರ್ ಭಾಂದ್ತಲೆ ಬಂದ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />ಅಸೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಪುರಾ ಜಗಾಚಿ ಭಾಶಾ ಗೊಂದಲ್ ಕರುನ್ ಗಾಲುನ್ ಲೊಕಾಕ್ನಿ ಪಗ್ಳುನ್ ಗಾಟಲ್ಯಾ ಸಾಟ್ನಿ ತ್ಯಾ ಶಾರಾಕ್ ಬಾಬೆಲ್ ಮನುನ್ ನಾವ್ ಪಡ್ಲೆ.<verse eid="GEN 11:9" /></para>
  <para style="s">ಶೆಮಾಚಿ ವಂಶಾವಳಿ</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />ಹಿ ಶೆಮಾಚಿ ವಂಶಾವಳಿ: ಪ್ರಳಯ್ ಹೊವ್ನ್ ಸರುನ್ ದೊನ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಶೆಮಾಕ್ ಸೆಂಬರ್ ವರಿಸ್ ಹೊಲ್ಲೊ ಹೊತ್ತ್ಯಾ ತನ್ನಾ ತೆಕಾ ಎಕ್ ಲೆಕ್ ಉಪಜ್ಲೊ ತೆಚೆ ನಾವ್ ಅರ್ಪಕ್ಷದ್. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />ತೆಚ್ಯಾ ಮಾನಾ ಶೆಮಾಕ್ ಪೊರಾ ಹೊತ್ತಿ ತೊ ಪಾಸೆ ವರ್ಸಾತ್ ಮರುನ್ ಗೆಲೊ.<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />ಮಾನಾ ಅರ್ಪಕ್ಷದ್ ತಿಸಾರ್ ಪಾಂಚ್ ವರ್ಸಾಚೊ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಶೆಲಾ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />ಮಾನಾ ತೆಕಾ ಅನಿಬಿ ಪೊರಾ ಹೊತ್ತಿ ತೊ ಚಾರ್ಸೆ ತಿನ್ ವರ್ಸಾ ಪತರ್ ಝಿತ್ತೊ ರ್‍ಹಾವ್ನ್ ಮರುನ್ ಗೆಲೊ. <verse eid="GEN 11:13" /><verse number="14" style="v" sid="GEN 11:14" />ಶೆಲಾಕ್ ತಿಸ್ ವರ್ಸಾ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಎಬೆರ್ ಉಪಜ್ಲೊ. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />ಎಬೆರ್ ಹೊಲ್ಯಾ ಮಾನಾ ತೆಕಾ ಅನಿ ಪೊರಾ ಹೊತ್ತಿ ತೊ ಚಾರ್ಸೆ ತಿನ್ ವರಿಸ್ ಝಿತ್ತೊ ರ್‍ಹಾವ್ನ್ ಮರುನ್ ಗೆಲೊ.<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />ಎಬೆರಾಕ್ ತಿಸಾರ್ ಚಾರ್ ವರ್ಸಾ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಪೆಲೆಗ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />ತೆಚ್ಯಾ ಮಾನಾ ಎಬೆರಾಕ್ ಅನಿಬಿ ಪೊರಾ ಹೊತ್ತಿ, ತೊ ಚಾರ್ಸೆ ತಿಸ್ ವರಿಸ್ ಪತರ್ ಝಿತ್ತೊ ರ್‍ಹಾವ್ನ್ ಮರುನ್ ಗೆಲೊ.<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />ಪೆಲೆಗಾಕ್ ತಿಸ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ರೆಗು ಮನ್ತಲೊ ಪೊರ್ ಉಪಜ್ಲೊ.<verse eid="GEN 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 11:19" />ರೆಗು ಉಪಜ್ಲೊ ಮಾನಾ ಪೆಲೆಗಾಕ್ ಪೊರಾ ಹೊತ್ತಿ, ಅನಿ ತೊ ದೊನ್ಸೆ ನ್ಹವ್ ವರಿಸ್ ಝಿತ್ತೊ ರ್‍ಹಾತಾ.<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />ರೆಗುಕ್ ತಿಸಾರ್ ದೊನ್ ವರ್ಸಾ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಎಕ್ ಲೆಕ್ ಉಪಜ್ಲೊ ತೆಚೆ ನಾವ್ ಶೆರುಕ್. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />ತೆಚ್ಯಾ ಮಾನಾ ಶೆರುಕಾಕ್ ಪೊರಾ ಉಪಜ್ಲಿ ತೊ ದೊನ್ಸೆ ಸಾತ್ ವರಿಸ್ ಪತರ್ ಝಿತ್ತೊ ರ್‍ಹಾವ್ನ್ ಮರುನ್ ಗೆಲೊ.<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />ಮಾನಾ ಶೆರುಕಾಕ್ ತಿಸ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಎಕ್ ಲೆಕ್ ಉಪಜ್ಲೊ ತೆಚೆ ನಾವ್ ನಾಹೊರ್. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />ನಾಹೊರಾಚ್ಯಾ ಮಾನಾ ತೆಕಾ ಅನಿಬಿ ಪೊರಾ ಹೊಲಿ, ತೊ ದೊನ್ಸೆ ವರಿಸ್ ಝಿತ್ತೊ ರಾಲೊ.<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />ನಾಹೊರಾಕ್ ವಿಸಾರ್ ನ್ಹವ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ತೆಕಾ ತೆರಹ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ . <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />ತೆಚ್ಯಾ ಮಾನಾ ನಾಹೊರಾಕ್ ಪೊರಾ ಹೊಲ್ಲಿ ಅನಿ ತೊ ಎಕ್ಸೆ ಎಕುನಿಸ್ ವರ್ಸಾ ಝಿತ್ತೊ ರಾಲೊ.<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />ಮಾನಾ ತೆರಹಾಕ್ ಸತ್ತರ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಅಬ್ರಾಮ್, ನಾಹೊರ್, ಹಾರಾನ್ ಮನ್ತಲಿ ಲೆಕಾ ಉಪಜ್ಲಿ.<verse eid="GEN 11:26" /></para>
  <para style="s">ತೆರಾಚಿ ಪಿಳ್ಗಿ</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />ತೆರಾಚಿ ವಂಶಾವಳಿ ಅಸಿ ಹಾಯ್ ತೆರಾಕ್ ಅಬ್ರಾಮ್, ನಾಹೊರ್, ಹಾರಾನ್ ಮನ್ತಲಿ ಲೆಕಾ ಉಪಜ್ಲಿ, ಅಪ್ಲೊ ಬಾಬಾ ರ್‍ಹಾತಾನಾಚ್ ಹಾರಾನ್, ಹಾರಾನಾಕ್ ಲೊಟ್ ಉಪಜ್ಲೊ, ಅನಿ ಹಾರಾನ್ ಅಪ್ನಾಚೊ ಬಾಬಾ ರ್‍ಹಾತಾನಾಚ್ ಮರುನ್ ಗೆಲೊ. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />ಅನಿ ಹಾರಾನ್ ಅಪ್ಲೊ ಬಾಬಾ ಝಿತ್ತೊ ರ್‍ಹಾತಾನಾಚ್ ಸ್ವಂತ್ ಗಾಂವಾತ್ ಬಾಬಿಲೊನಾಚ್ಯಾ ಉರ್ ಮನ್ತಲ್ಯಾ ಶಾರ್‍ಹಾತ್ ಮರುನ್ ಗೆಲೊ. <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />ಮಾನಾ ಅಬ್ರಾಮಾನ್ ಅನಿ ನಾಹೊರಾನ್ ಲಗಿನ್ ಕರುನ್ ಗೆಟ್ಲ್ಯಾನಿ ಅಬ್ರಾಮಾಚ್ಯಾ ಬಾಯ್ಕೊಚೆ ನಾವ್ ಸಾರಾ, ಅನಿ ನಾಹೊರಾಚ್ಯಾ ಬಾಯ್ಕೊಚೆ ನಾವ್ ಮಿಲ್ಕಾ; ತಿ ಹಾರಾನಾಚಿ ಲೆಕ್, ಹೆಕಾ ಅನಿ ಎಕ್ಬಿ ಲೆಕ್ ಹೊತ್ತಿ ತಿಚೆ ನಾವ್ ಇಸ್ಕಾ. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />ಖರೆ ಸಾರಾ ವಾಂಜ್ಡಿ ಹೊತ್ತಿ ತಿಕಾ ಪೊರಾ ಹೊಯ್ನಸಿತ್.<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />ತೆರಾನ್ ಅಪ್ಲೊ ಲೆಕ್ ಅಬ್ರಾಹಾಮಾಕ್ ಅನಿ ನಾತು ಲೊಟ್ ತೊ ಹಾರಾನಾಚೊ ಲೆಕ್, ಅನಿ ಅಪ್ಲಿ ಸುನ್ನ್ ಅಬ್ರಾಮಾಚಿ ಬಾಯ್ಕೊ ಸಾರಾಕ್ ಬಲ್ವುನ್ ಗೆವ್ನ್ ಬಾಬೆಲೊನಾಚ್ಯಾ ಉರ್ ಶಾರ್ ಸೊಡುನ್ ಜಾವ್ನ್ ಹಾರಾನ್ ಮನ್ತಲ್ಯಾ ಶಾರಾಕ್ ಪಾವ್ನ್ ಥೈ ವಸ್ತಿ ರಾಲ್ಯಾನಿ.<verse eid="GEN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 11:32" />ಮಾನಾ ತೆರಾ ದೊನ್ಸೆ ಪಾಂಚ್ ವರಿಸ್ ಝಿತ್ತೊ ರ್‍ಹಾವ್ನ್ ಮರುನ್ ಗೆಲೊ.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">ಅಬ್ರಾಹಾಮಾಕ್ ದೆವಾಚಿ ಬಲ್ವನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಬ್ರಾಹಾಮಾಕ್, ತುಜೊ ದೆಶ್ ಬಳಗ್ ಅನಿ ಬಾಬಾಚೆ ಘರ್ ಸೊಡುನ್ ಮಿಯಾ ದಾಕ್ವುತಲ್ಯಾ ದೆಸಾಕ್ ಜಾ.<verse eid="GEN 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2" />ಮಿಯಾ ತುಕಾ ಲೈ ಮೊಟೊ ದೆಶ್ ಕರ್ತಾ,</para>
  <para style="q2" vid="GEN 12:2">ಅನಿ ಮಿಯಾ ತುಕಾ ಆಶಿರ್ವಾದ್ ದಿತಾ,</para>
  <para style="q2" vid="GEN 12:2">ಅನಿ ಮಿಯಾ ತುಜೆ ನಾವ್ ಮೊಟೆ ಕರ್ತಾ, ಅನಿ ತಿಯಾ ಆಶಿರ್ವಾದ್ ಹೊತೆಯ್.<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />ತುಕಾ ಆಶಿರ್ವಾದ್ ದಿತಲ್ಯಾಕ್ನಿ ಮಿಯಾ ಆಶಿರ್ವಾದ್ ದಿತಾ,</para>
  <para style="q2" vid="GEN 12:3">ಖರೆ ತುಜ್ಯಾ ವರ್‍ತಿ ಶಾಪ್ ಘಾಲ್ತಲ್ಯಾಕ್ನಿ ಮಿಯಾ ಶಾಪ್ ದಿತಾ,</para>
  <para style="q2" vid="GEN 12:3">ತುಜ್ಯಾ ವೈನಾ ಜಗಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ಮಿಯಾ ಆಶಿರ್ವಾದ್ ಕರ್ತಾ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚ್ಯಾ ಗೊಸ್ಟಿ ಸಾರ್ಕೆ ಅಬ್ರಾಮ್ ಭಾಯ್ರ್ ಪಡುನ್ ಗೆಲೊ, ಅನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಲೊಟಾಬಿ ಗೆಲೊ.</para>
  <para style="p" vid="GEN 12:4">ತೊ ಹಾರಾನ್ ಶಾರ್ ಸೊಡುನ್ ಜಾತಾನಾ ಅಬ್ರಾಹಾಮಾಕ್ ಸತ್ತರಾರ್ ಪಾಂಚ್ ವರ್ಸಾ ಹೊಲ್ಲೆ ರ್‍ಹಾತಾ. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />ಅಬ್ರಾಮಾನ್ ಅಪ್ಲ್ಯಿ ಬಾಯ್ಕೊ ಅನಿ ಭಾವಾಚೊ ಲೆಕ್ ಲೊಟಾಕ್ ಘೆವ್ನ್ ಅನಿ ಹಾರಾನಾತ್ ಖಮ್ವಲ್ಲಿ ಆಸ್ತಿ ಅನಿ ಆಳಾಕ್ನಿ ಘೆವ್ನ್ ಕಾನಾನ್ ದೆಸಾಕ್ ಜಾವ್ಕ್ ಲಾಗ್ಲೊ. ತೊ ಕಾನಾನ್ ದೆಶ್ಯಾಕ್ ಯೆವ್ನ್ ಪಾವಲ್ಲ್ಯಾ ತನ್ನಾ, <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />ಅಬ್ರಾಮ್ ಶೆಕೆಮಾಚ್ಯಾ ಪವಿತ್ರ್ ಜಾಗ್ಯಾ ವೈಲ್ಯಾ ಮೊರಿಯಾ ಝಾಡಾ ಪತರ್ಬಿ ಪಾವ್ಲೊ, ತ್ಯಾ ಎಳಾರ್ ಕಾನಾನಾಚಿ ಲೊಕಾ ತ್ಯಾ ದೆಸಾತ್ ವಸ್ತಿ ರಾಯ್ತ್. <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />ಥೈ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ದಿಸುನ್: ಮಿಯಾ ಹ್ಯೊ ದೆಶ್ ತುಜ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ಲೊಕಾಕ್ನಿ ದಿತಾ, ಮಟ್ಲ್ಯಾನ್.</para>
  <para style="p" vid="GEN 12:7">ತನ್ನಾ ತೆನಿ ಅಪ್ನಾಕ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ದಿಸ್ಲೊ ಮನುನ್ ಎಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಭಾಂದ್ಲ್ಯಾನ್. <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />ತೆನಿ ಬೆತೆಲಾಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಹೊತ್ತ್ಯಾ ಮಡ್ಡಿಯಾಂಚ್ಯಾ ಜಾಗ್ಯಾಕ್ ಜಾವ್ನ್ ಝೊಪ್ಡೆ ಭಾಂದ್ಲ್ಯಾನ್, ಬೆತೆಲಾಚ್ಯಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಬೆತೆಲ್ ಅನಿ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಆಯಿ ಮನ್ತಲೆ ಗಾಂವ್ ಹೊತ್ತೆ, ಅನಿ ತೆನಿ ಥೈಬಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಭಾಂದ್ಲ್ಯಾನ್, ಅನಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚ್ಯಾ ನಾವಾರ್ ಆರಾದನ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />ಮಾನಾ ಅಬ್ರಾಮ್ ತೊ ಜಾಗೊ ಸೊಡುನ್ ನೆಗೆವ್ ಪತರ್ಬಿ ಗೆಲೊ.<verse eid="GEN 12:9" /></para>
  <para style="s">ಇಜಿಪ್ತಾತ್ ಅಬ್ರಾಮ್</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />ತ್ಯಾ ಎಳಾರ್ ಜಿಮ್ನಿರ್ ಬರ್‍ಗಾಲ್ ಹೊತ್ತೊ, ತೆಚ್ಯಾ ವೈನಾ ಅಬ್ರಾಮ್ ಇಜಿಪ್ತಾಚ್ಯಾ ದಕ್ಷಿನಾಕ್ ಉಲ್ಲೊ ಎಳ್ ರಾವ್ಕ್ ಮನುನ್ ಗೆಲೊ ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೊ ಬರ್‍ಗಾಲ್ ಲೈ ಕಠಿನ್ ಹೊತ್ತೊ. <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />ತನ್ನಾ ಅಬ್ರಾಮಾನ್ ಇಜಿಪ್ತಾಕ್ ಜಾವ್ನ್ ಪಾವ್ತಲ್ಯಾ ಅದ್ದಿಚ್ ಅಪ್ಲ್ಯಾ ಬಾಯ್ಕೊಕ್, ತಿಯಾ ಬಗುಕ್ ಲೈ ಬರಿ ದಿಸ್ತೆಯ್. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾನಿ ತುಕಾ ಬಗುನ್ ಹಿ ಹೆಚಿ ಬಾಯ್ಕೊ ಮನುನ್ ಒಳ್ಕುನ್ ತೆನಿ ತುಕಾ ಕಾಡುನ್ ಗೆವ್ಕ್ ಮನುನ್ ತುಕಾ ಹುರ್ವುನ್ ಮಾಕಾ ಜಿವಾನಿ ಮಾರುನ್ ಟಾಕ್ತಲೆ, <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />ತಸೆ ಮನುನ್ ತುಜ್ಯಾ ವೈನಾ ಮಾಜೊ ಜಿವ್ ಹುರ್ತಾ, ಅನಿ ತಿಯಾ ತೆಂಕಾ ತಿಯಾ ಮಾಜಿ ಭೆನ್ ಮನುನ್ ಸಾಂಗ್, ತನ್ನಾ ತೆನಿ ತುಜೊ ಭಾವ್ ಮನುನ್ ಮಾಜ್ಯಾ ವರ್‍ತಿ ದಯಾ ದಾಕ್ವುತಲೆ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 12:13" /><verse number="14" style="v" sid="GEN 12:14" />ತನ್ನಾ ಅಬ್ರಾಮ್ ಇಜಿಪ್ತಾಕ್ ಜಾವ್ನ್ ಪಾವ್ಲೊ ತನ್ನಾ ಥೈತ್ನಾ ಲೊಕಾನಿ ಸಾರಾಕ್ ಬಗ್ತಾನಾ ತಿ ಭಗುಕ್ ಲೈ ಸುಂದರ್ ಹೊತ್ತಿ. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />ಅನಿ ಪಾರೊವ್ ರಾಜಾಚಿ ಅಧಿಕಾರಿಯಾ ತಿಕಾ ಬಗುನ್, ತಿ ಲೈ ಸುಂದರ್ ಹಾಯ್ ಮನುನ್ ರಾಜಾಕ್ ತಿಚ್ಯಾ ವಿಶಯಾತ್ ಕಳ್ವುನ್ ತಿಕಾ ರಾಜಾಚ್ಯಾ ಘರಾಕ್ ಧಾಡುನ್ ದಿಲ್ಯಾನಿ.<verse eid="GEN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 12:16" />ರಾಜಾನ್ ಅಬ್ರಾಮ್ ಸಾರಾಚೊ ಭಾವ್ ಮನುನ್ ಚಿಂತುನ್ ಸಾರಾ ವೈನಾ ಅಬ್ರಾಹಾಮಾಕ್ ದಯಾ ದಾಕ್ವುಲ್ಯಾನ್, ಅನಿ ತೆಕಾ ಗೊರಾ, ಶೆಳಿಯಾ, ಬಕ್ರಿಯಾ, ಅನಿ ಗಾಡ್ವಾ, ಆಳಾ ಅನಿ ಒಂಟಿಯಾ ದಿಲ್ಯಾನ್.<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />ಖರೆ ಅಬ್ರಾಮಾಚಿ ಬಾಯ್ಕೊ ಸಾರಾಕ್ ಬಲ್ವುನ್ ಘೆಟ್ಲ್ಯಾಲ್ಯಾ ವೈನಾ ದೆವಾನ್ ರಾಜಾ ವರ್‍ತಿ ಅನಿ ರಾಜಾಚ್ಯಾ ಘರ್‍ಹಾತ್ ರ್‍ಹಾತಲ್ಯಾಕ್ನಿ ಮೊಟೊ ಸಂಕಟ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />ತನ್ನಾ ಪಾರೊವ್ ರಾಜಾನ್ ಅಬ್ರಾಹಾಮಾಕ್ ಬಲ್ವುಕ್ ಲಾವ್ನ್, ತಿಯಾ ಅಸೆ ಕಶ್ಯಾಕ್ ಕರ್‍ಲೆ? ಸಾರಾ ತುಜಿ ಬಾಯ್ಕೊ ಮನುನ್ ಕಶ್ಯಾಕ್ ಸಾಂಗುಕ್ ನೈ? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />ಮಿಯಾ ತಿಕಾ ಮಾಜಿ ಬಾಯ್ಕೊ ಕರುನ್ ಘೆವ್ಚೆ ಮನುನ್ ಕರಲ್ಲೊ ಖರೆ ತಿಯಾ ಹಿ ಮಾಜಿ ಭೆನ್ ಹೊತಾ ಮನುನ್ ಕಶ್ಯಾಕ್ ಸಾಂಗ್ಲೈ? ತುಜ್ಯಾ ಬಾಯ್ಕೊಕ್ ಘೆವ್ನ್ ಹಿತೆತ್ನಾ ಜಾ! ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />ತನ್ನಾ ಪಾರೊವ್ ರಾಜಾನ್ ಅಬ್ರಾಹಾಮಾಕ್ ಇಜಿಪ್ತಾತ್ನಾ ಧಾಡಾ ಮನುನ್ ಅಪ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ ಹುಕುಮ್ ದಿಲ್ಯಾನ್, ಮಾನಾ ಅಬ್ರಾಹಾಮಾಕ್ ತೆಚಿ ಬಾಯ್ಕೊ ಸಾರಾ ಅನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತಿ ಆಸ್ತಿ ಸಗ್ಳಿ ದಿವ್ನ್ ತೆಕಾ ದಾಡ್ಲ್ಯಾನ್.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">ಅಬ್ರಾಮ್ ಅನಿ ಲೊಟ್ ಎಗಳ್ತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />ಮಾನಾ ಅಬ್ರಾಮ್ ಅಪ್ನಾಚಿ ಆಸ್ತಿ ಅನಿ ಬಾಯ್ಕೊಕ್ ಬಲ್ವುನ್ಗೆವ್ನ್ ಇಜಿಪ್ತಾತ್ನಾ ನೆಗೆವ್ ಮನ್ತಲ್ಯಾ ಗಾಂವಾಕ್ ಗೆಲೊ. ಅನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಲೊಟ್ಬಿ ಹೊತ್ತೊ. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />ಅನಿ ಅಬ್ರಾಮಾಕ್ಡೆ ಲೈ ಶೆಳಿಯಾ, ಬಕ್ರಿ ಅನಿ ಗೊರಾಡೊರಾ, ಸೊನೆ ಚಾಂದಿ ರ್‍ಹಾವ್ನ್ ತೊ ಲೈ ಮೊಟೊ ಸಾವ್ಕಾರ್ ಹೊತ್ತೊ. <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />ಮಾನಾ ತೊ ಇಜಿಪ್ತ್ ಸೊಡುನ್ ನೆಗೆವ್ ದೆಶ್ಯಾ ಪತರ್ ಎಕ್ ಜಾಗ್ಯಾ ವೈನಾ ಅನಿ ಎಕ್ ಜಾಗ್ಯಾ ವೈರ್ ಫಿರುನ್ಗೆತ್ ಬೆತೆಲ್ ಅನಿ ಆಯಿ ಮನ್ತಲ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ಮದ್ದಿ ಝೊಪ್ಡೆ ಭಾಂದಲ್ಯಾನ್, <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಭಾಂದಲ್ಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಪರ್‍ತುನ್ ಯೆವ್ನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚೆ ನಾವ್ ಘೆವ್ನ್ ಆರಾದನ್ ಕರ್ಲ್ಯಾನ್.<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />ಅನಿ ಅಬ್ರಾಮಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತ್ಯಾ ಲೊಟಾಕ್ಬಿ ಗೊರಾ ಅನಿ ಬಕ್ರಿಯಾ ಶೆಳಿಯಾ ಹೊತ್ತಿ ಅನಿ ಸ್ವತಾಚೊ ಕುಟುಂಬ್ ಅನಿ ಆಳಾಬಿ ಹೊತ್ತಿ. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />ಖರೆ ತೆಂಚ್ಯಾ ದೊಗ್ಯಾಂಚ್ಯಾಕ್ಡೆ ಬಿ ಲೈ ಜನಾವರಾ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ತೆನಿ ದೊಗೆಬಿ ವಾಂಗ್ಡಾ ರಾವ್ಕ್ ಜಾಗೊ ಪಾವ್ಕ್ ನಾ.<verse eid="GEN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 13:7" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಅಬ್ರಾಮಾಚ್ಯಾ ಅನಿ ಲೊಟಾಚ್ಯಾ ಗೊರಾಡೊರಾ ರಾಕ್ತಲ್ಯಾಂಚ್ಯಾ ಮದ್ದಿ ಝಗ್ಡೊ ಹೊವ್ಕ್ ಸುರು ಹೊಲೆ, ತ್ಯಾ ದಿಸಾತ್ನಿ ಕಾನಾನಾಚಿ ಲೊಕಾ ಅನಿ ಪೆರಿಜಿಂಚಿ ಲೊಕಾ ತ್ಯಾ ದೆಸಾತ್ ವಸ್ತಿ ರಾಯ್ತ್.<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />ತನ್ನಾ ಅಬ್ರಾಮಾನ್ ಲೊಟಾಕ್, “ಮಾಜ್ಯಾ ಅನಿ ತುಜ್ಯಾ ಮದ್ದಿ ಅನಿ ಮಾಜ್ಯಾ ಘೊರಾ ರಾಕ್ತಲ್ಯಾಂಚ್ಯಾ ಅನಿ ತುಜ್ಯಾ ಗೊರಾ ರಾಕ್ತಲ್ಯಾಂಚ್ಯಾ ಮದ್ದಿ ಝಗ್ಡೊ ಹೊತೊಲೊ ನಕ್ಕೊ ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಮಿಯಾ ಅನಿ ತಿಯಾ ಸಮಂದಿಕಾ ನೈ ಕಾಯ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 13:9" />“ಮಾನಾ ಅನಿ ಸಗ್ಳೆ ದೆಶ್ ತುಜಾ ಇದ್ರಾಕುಚ್ ಹಾಯ್ ನೈ? ತಿಯಾ ಮಾಜ್ಯಾಕ್ನಾ ಎಗ್ಳೊ ಸರಕ್, ಅನಿ ತಿಯಾ ಡಾವ್ಯಾಕ್ ಜಾತೈ ಹೊಲ್ಯಾರ್ ಮಿಯಾ ಉಜ್ವ್ಯಾ ಭಾಜುಕ್ ಜಾತಾ ನಾತರ್ ತಿಯಾ ಉಜ್ವ್ಯಾಕ್ ಜಾತೈ ಹೊಲ್ಯಾರ್ ಮಿಯಾ ಡಾವ್ಯಾಕ್ ಜಾತಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />ಲೊಟಾನ್ ಬಗ್ತಾನಾ ಜೊರ್ದಾನ್ ನ್ಹಯಿಚ್ಯಾ ಭೊತ್ಯಾನಿ ಭರ್ಪುರ್ ಪಾನಿ ಹೊತ್ತೊ ಜೊಗರಿ ಪತರ್ಲೊ ಜಾಗೊ ತೆಕಾ ದಿಸ್ಲೊ, ತ್ಯಾ ಎಳಾರ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಸೊದೊಮ್ ಅನಿ ಗೊಮೊರ್ ಶಾರಾಕ್ನಿ ನಾಶ್ ಕರ್‍ತಲ್ಯಾ ಅದ್ದಿ, ತೊ ಜಾಗೊ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚೊ ಮ್ಹಳೊ ಸಾರ್ಕೊ ಅನಿ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾ ಸರ್ಕೊಬಿ ಹೊವ್ನ್ ಹೊತ್ತೊ. <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />ಲೊಟಾನ್ ತೆ ಬಗುನ್ ಜೊರ್ದಾನ್ ಮನ್ತಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಗೆಲೊ, ಅನಿ ತೆನಿ ಎಕಾಮೆಕಾಕ್ ಎಗಳ್ಳೆ. <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />ಅಬ್ರಾಮ್ ಕಾನಾನಾಚ್ಯಾ ಜಾಗ್ಯಾರ್ ವಸ್ತಿ ಕರುಲಾಲೊ ಅನಿ ಲೊಟಾನ್ ಸೊದೊಮ್ ಶರಾಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ಮಾಳ್ ಜಾಗ್ಯಾ ವೈನಿ ಝೊಪ್ಡೆ ಭಾಂದ್ಲ್ಯಾನ್. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />ತ್ಯಾ ಸೊದೊಮಾತ್ಲಿ ಲೊಕಾ ಲೈ ಬುರ್ಸೆ ಹೊವ್ನ್ ಹೊತ್ತಿ ಅನಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ವಿರೊದ್ ಹೊವ್ನ್ ಪಾಪ್ ಕರಿತ್ ಹೊತ್ತೆ.<verse eid="GEN 13:13" /></para>
  <para style="s">ಅಬ್ರಾಮ್ ಹೆಬ್ರೊನಾಕ್ ಜಾತಲೆ</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />ಅಬ್ರಾಮ್ ಲೊಟಾಕ್ನಾ ಎಗ್ಳೊ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತೆಕಾ, ತಿಯಾ ಹೊತ್ತ್ಯಾ ಜಾಗ್ಯಾ ವೈನಾ ಚಾರಿ ದಿಕ್ಕಾಕ್ನಿಬಿ ಡೊಳೆ ವರ್‍ತಿ ಕರುನ್ ಬಗ್, <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />ಅನಿ ತುಜಿ ನದರ್ ಖೈ ಪಾತರ್ ಪಾವ್ತಾ ತೊ ಸಗ್ಳೊ ಜಾಗೊ ಮಿಯಾ ತುಕಾ ಅನಿ ತುಜಾ ಪಿಳ್ಗಿಕ್ ಸದಾ ಸರ್ವತಾಕ್ ದಿತಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />ಕೊನ್ ತರ್ಬಿ ಧುಳ್ ಮೆಜ್ತಾ ಹೊಲ್ಯಾರ್ ತುಜಿ ಪಿಳ್ಗಿಬಿ ಮೆಜ್ತಾ. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />ಅನಿ ಉಟ್ ಹೊ ದೆಶ್ ಲಾಂಬ್ ಅನಿ ರುಂದ್ ಫಿರುನ್ ಬಗ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತೊ ಮಿಯಾ ತುಕಾ ದಿತಾ. <verse eid="GEN 13:17" /><verse number="18" style="v" sid="GEN 13:18" />ಮಾನಾ ಅಬ್ರಾಮಾನ್ ಅಪ್ನಾಚೊ ವಾಟೊ ಘೆವ್ನ್ ಹೆಬ್ರೊನಾತ್ ಹೊತ್ತ್ಯಾ ಮಾಮ್ರೆ ಮನ್ತಲ್ಯಾ ಶುದ್ದ್ ಝಾಡಾಕ್ಡೆ ಜಾವ್ನ್ ಝೊಪ್ಡೆ ಭಾಂದ್ಲ್ಯಾನ್, ಅನಿ ತೆನಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಭಾಂದ್ಲ್ಯಾನ್.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">ಅಬ್ರಾಮ್ ಲೊಟಾಕ್ ಹುರ್ವುತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />ಮಾನಾ ತ್ಯಾ ಎಳಾರ್ ಶಾರಾಚೊ ರಾಜಾ ಆಮ್ರಾಫೆಲ್; ಅನಿ ಎಲ್ಲಸಾರಿಚೊ ರಾಜಾ ಅರಿಯೊಕ್; ಎಲಾಮಾಚೊ ರಾಜಾ ಕೆದೊರ್ಲಗೊಮ್; ಅನಿ ಗೊಯಿಮಾಚೊ ರಾಜಾ ತಿದಾಲ್ ಹೆ ಚಾರ್ ರಾಜಾ. <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />ಸೊದೊಮಾಚೊ ರಾಜಾ ಬೆರಾ, ಗೊಮೊರಾಚೊ ರಾಜಾ ಬಿರ್ಶಾ, ಆದ್ಮಚೊ ರಾಜಾ ಶಿನಾಬ್, ಜೆಬೊಯಿಮಾಚೊ ರಾಜಾ ಶೆಮೆಬೆರ್ ಅನಿ ಬೆಲಾ ನಾತರ್ ಚೊವೊರಾಚೊ ರಾಜಾ ಹ್ಯಾ ಚಾರ್ ರಾಜಾಂಚ್ಯಾ ವಿರೊದ್ ಲಡಾಯಿಕ್ ಗೆಲ್ಯಾನಿ. <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />ಅನಿ ರಾಜಾನಿ ಸಿದ್ದಮ್ ಕೊಳ್ಳಾತ್ ತೆಂಚೊ ಸೈನ್ಯ್ ಸಗ್ಳೊ ರಾಜಾನಿ ಗೊಳಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />ಹೆನಿ ಬಾರಾ ವರಿಸ್ ಕೆದೊಲ್ ಲಾವೊಮೆಕಾಚ್ಯಾ ಹಾತಿತ್ ಹೊತ್ತೆ, ತೆರಾವ್ಯಾ ವರ್ಸಾತ್ ತೆನಿ ತೆಚ್ಯಾ ವಿರೊದ್ ಹೊಲೆ. <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />ಚೌದಾವ್ಯಾಚ್ಯಾ ವರ್ಸಾತ್ ಕೆರ್ದೊಲ್ ಲಾವೊಮೆರ್ ಅನಿ ತೆಂಚಿ ವಾಂಗ್ಡಿಯಾ ತೆಂಚ್ಯಾ ಸೈನ್ಯಾಕ್ಡೆ ಯೆಲೆ ಅನಿ ತೆನಿ ಅಸ್ಟರೊತ್ ಕೆರ್ನೆಯಿಮಾತ್, ರೆಫಾಯಿಮಾಕ್ನಿ ಅನಿ ಹಾಮಾತ್ ಅನಿ ಜುಜಿಮಾಕ್ನಿ ಅನಿ ಶಾವಿ ಕಿರ್ಯಾತಾತ್ ಎಮಿಮಾಕ್ನಿ, <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />ಅನಿ ಹೊರಿಯಾಕ್ನಿ ಸೆಯಿರ್ ಮಡ್ಡಿತ್ಲ್ಯಾ ಡಂಗ್ಳಿತ್ ಎಲ್ಪಾರಾನಿನಚ್ಯಾ ಎಜ್ಜಾ ಪಾತರ್ ಹಾಮ್ಡುನ್ ಘಾಟ್ಲ್ಯಾನಿ. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />ತೆನಿ ಪಾಟಿ ಪರ್‍ತುನ್ ಯೆವ್ನ್ ಮಿಶ್ಪತ್ ಮನ್ತಲ್ಯಾ ಕಾದೆಸಾಕ್ ಯೆಲ್ಯಾನಿ ಅನಿ ತೆನಿ ಅಮಾಲೆಕ್ಯಾಂಚೊ ಅಪ್ಲೊ ಕರುನ್ ಘೆಟ್ಲ್ಯಾನಿ. ಅನಿ ಹಚಚೊನ್ ತಾಮಾರಿತ್ ವಸ್ತಿ ರ್‍ಹಾವ್ನ್ ಅಮೊರಿಯಾಂಕ್ನಿ ಜಿಕ್ಲ್ಯಾನಿ.<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />ತ್ಯಾ ಎಳಾರ್ ಸೊದೊಮಾಚೊ ಅನಿ ಗೊಮೊರಾಚೊ, ಆದ್ಮಚೊ, ಜೆಬೊಯಿಮಾಚೊ ಬೆಲಾಚೊ ಜೊವರ್ ಮನ್ತಲೊ ರಾಜ್ಯಾನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಲಡಾಯಿ ಕರುಕ್ ಮನುನ್ ಸಿದ್ದಿಮಾಚ್ಯಾ ಕೊಳ್ಳಾತ್ ಗೆಲ್ಯಾನಿ. <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />ತೆನಿ ಎಲಾಮಾಚ್ಯಾ ರಾಜ್ಯಾಹೊಲ್ಲ್ಯಾ ಕೆದೊರ್ಲಗೊವಾಕ್ ಗೊಯಿಮಾಚೊ ರಾಜಾ ತಿದಾಲಾಕ್ ಶಿನಾರಿಚೊರಾಜ್ಯಾ ಅಮ್ರಾಫೆಲಾಕ್ ಅನಿ ಎಲ್ಲಸಾರಿಚೊ ರಾಜಾ ಅರಿಯೊಕಾಕ್ ವಿರೊದ್ ಹೊವ್ನ್ ಯುದ್ದ್ ಕರಲ್ಯಾನಿ, ಅಸಿ ಚಾರ್ ರಾಜ್ಯಾನಿ ಪಾಂಚ್ ಜನಾ ರಾಜಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಲಡಾಯ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />ಸೊದೊಮ್ ಅನಿ ಗೊಮೊರಾಚೆ ರಾಜಾ ಪಳುನ್ ಜಾತಾನಾ ತೆನಿ ಸಿದ್ದಿಮ್ ಕೊಳ್ಳಾತ್ಲ್ಯಾ ಡಾಂಬ್ರಾಚ್ಯಾ ಖಡ್ಡ್ಯಾತ್ನಿ ಪಡ್ಲೆ, ಅನಿ ತಿನ್ ರಾಜಾ ಹುರುನ್ ಮಡ್ಡಿಚ್ಯಾ ವರ್‍ತಿ ಪಳುನ್ ಜಾವ್ನ್ ನಿಪ್ಲ್ಯಾನಿ. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />ಮಾನಾ ತೆನಿ ಸೊದೊಮ್ ಅನಿ ಗೊಮೊರಾಚ್ಯಾನಿ ಕರಲ್ಲೆ ಸಗ್ಳ್ಯಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಸಗ್ಳೆಬಿ, ಜಿಕುನ್ ಹಾನ್ಲ್ಯಾನಿ. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />ತ್ಯಾ ಸೊದೊಮಾತ್ ಅಬ್ರಾಮಾಚೊ ಭಾವಾಚೊ ಲೆಕ್ ಲೊಟಾಕ್ಬಿ ಅನಿ ತೆಚ್ಯಾ ಆಸ್ತಿಕ್ ವಿರೊಧಿಯಾನಿ ಗೆವ್ನ್ ಗೆಲ್ಲ್ಯಾನಿ.<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />ಖರೆ ತ್ಯಾತುರ್ ಎಕ್ ಇಬ್ರಿಯಾಚೊ ಮಾನುಸ್ ಚುಕ್ವುನ್ ಘೆವ್ನ್ ಯೆವ್ನ್ ಥೈ ಹೊಲ್ಲಿ ಖಬರ್ ಅಬ್ರಾಹಾಮಾಕ್ ಸಾಂಗ್ತಾ. ತ್ಯಾ ಎಳಾರ್ ಅಬ್ರಾಮ್ ಅಮೊರಿಯಾತ್ಲ್ಯಾ ಮಮ್ರೆಯಾಚ್ಯಾ ಒಕ್ ಮನ್ತಲ್ಯಾ ಪವಿತ್ರ್ ಝಾಡಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ವಸ್ತಿ ಹೊತ್ತೊ, ಮಾಮ್ರೆ ಅನಿ ತೆಚಿ ಭಾವಾ ಇಸ್ಕೊಲ್ ಅನಿ ಅಮ್ರಾಫೆಲ್ ಹೆನಿ ಅಬ್ರಾಮಾಚಿ ವಾಂಗ್ಡಿಯಾ ಹೊವ್ನ್ ಹೊತ್ತೆ. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />ಲೊಟಾಕ್ ಭಂದಿ ಕರುನ್ ಘೆವ್ನ್ ನ್ಹೆಲಾತ್ ಮನ್ತಲೆ ಅಬ್ರಾಹಾಮಾಕ್ ಕಳಲ್ಯಾ ತನ್ನಾ ಅಪ್ನಾಚ್ಯಾ ಘರ್‍ಹಾತ್ ಲಡಾಯ್ ಕರುಕ್ ತಯಾರ್ ಹೊತ್ತ್ಯಾ ತಿನ್ಸೆ ಆಟ್ರಾ ಲೊಕಾಕ್ನಿ ತಯಾರ್ ಕರುನ್ ಘೆವ್ನ್ ತೆಂಚಿ ಪಾಟ್ ಲಾಗುನ್ ದಾನ್ ಮನ್ತಲ್ಯಾ ಶಾರಾ ಪಾತರ್ ಪಳ್ಸುನ್ ಘಾಟ್ಲ್ಯಾನ್. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />ಅನಿ ರಾತ್ತಿನ್ ಅಪ್ಲ್ಯಾ ಸೈನಾಚೆ ದೊನ್ ವಾಟೆ ಕರುನ್ ಅಬ್ರಾಮ್ ಅನಿ ಸೆವಕಾ ದುಶ್ಮನಾಚ್ಯಾ ವರ್‍ತಿ ಲಡಾಯ್ ಕರ್ಲ್ಯಾನಿ, ಅನಿ ತೆಂಕಾ ಹಾರ್ವುನ್ ದಮಸ್ಕಾಚ್ಯಾ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ ಹೊಬಾ ಗಾಂವಾಕ್ ಪಳಸ್ಲ್ಯಾನಿ. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />ಮಾನಾ ಅಬ್ರಾಮಾನ್ ವಿರೊಧಿ ಘೆವ್ನ್ ಗೆಲ್ಲ್ಯಾ ಲೊಟಾಕ್ ಅನಿ ಸಗ್ಳಿ ವಸ್ತಾ ಅಪ್ಲಿ ಆಸ್ತಿ ಅನಿ ಭಂಧಿಕರುನ್ ನೆಲ್ಲ್ಯಾ ಬಾಯ್ಕಾಮಾನ್ಸಾಕ್ನಿ ಅನಿ ಬಂಧಿ ಹೊಲ್ಲ್ಯಾ ಹರ್ ಎಕ್ಬಿ ಸೊಡ್ಸುನ್ ಹಾನ್ಲ್ಯಾನ್.<verse eid="GEN 14:16" /></para>
  <para style="s">ಮೆಲ್ಕಿಜೆದೆಕಾನ್ ಅಬ್ರಾಹಾಮಾಕ್ ಆಶಿರ್ವಾದ್ ಕರಲ್ಲೆ</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />ಕೆದೊರ್ಲಗೊಮರಾಕ್ ಅನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತ್ಯಾ ರಾಜಾಕ್ನಿ ಹಾರ್ವುನ್ ಅನಿ ಪರ್‍ತುನ್ ತೆಚ್ಯಾ ಘರಾಕ್ ಯೆಲೊ, ತನ್ನಾ ಅಬ್ರಾಹಾಮಾಕ್ ಭೆಟುಚೆ ಮನುನ್ ಸೊದೊಮಾಚೊ ರಾಜಾ ತೊ ಹೊತ್ತ್ಯಾ ಶಾವೆ ಕೊಳ್ಳಾತ್ ಗೆಲೊ, ತಸೆ ಹೊವ್ನ್ ತೆಕಾ ರಾಜಾಚೊ ಕೊಳ್ಳ್ ಮನುನ್ ನಾವ್ ಯೆಲೆ. <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />ಅನಿ ಸಾಲೆಮಾಚೊ ರಾಜಾ ಮಲ್ಕಿಜೆದೆಕ್ಬಿ ಅಬ್ರಾಹಾಮಾಕ್ ಭೆಟುಕ್ ಮನುನ್ ಯೆತಾ ತೊ ಮೊಹನ್ನತ್ ದೆವಾಚೊ ಯಾಜಕ್ ಹೊಲ್ಲೊ ರ್‍ಹಾತಾ, ಅನಿ ತೊ ತೆಕಾ ಮನುನ್ ಭಾಕ್ರಿಯಾ ಅನಿ ವಾಯ್ನ್ ಘೆವ್ನ್ ಯೆಲೊ, <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />ಅನಿ ಅಬ್ರಾಹಾಮಾಕ್ ಆಶಿರ್ವಾದ್ ದಿವ್ನ್ ಅಬ್ರಾಮಾ, ಮಳಬ್ ಅನಿ ಜಿಮಿನ್ ರಚಲ್ಲೊ ಮೊಟೊ ದೆವ್ ತುಕಾ ಆಶಿರ್ವಾದ್ ದಿಂವ್ದಿತ್ ! <verse eid="GEN 14:19" /><verse number="20" style="v" sid="GEN 14:20" />ತುಜ್ಯಾ ದುಶ್ಮನಾಂಚ್ಯಾಕ್ನಾ ಜಿಕುಕ್ ತುಕಾ ಮಜತ್ ಕರಲ್ಲ್ಯಾ ಮೊಹನ್ನತ್ ದೆವಾಕ್ ಸ್ತುತಿ ಹೊಂವ್ದಿತ್! ಮಟ್ಲ್ಯಾನ್, ಅನಿ ಅಬ್ರಾಮಾನ್ ತೆಕಾ ಯುದ್ದಾತ್ ಜಿಕುನ್ ಹಾನಲ್ಯಾ ಸಾಮಾನಾತ್ ಧಾತ್ಲೊ ಎಕ್ ವಾಟೊ ದಿಲ್ಯಾನ್.<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />ಮಾನಾ ಸೊದೊಮಾಚ್ಯಾ ರಾಜ್ಯಾನ್ ಅಬ್ರಾಹಾಮಾಕ್ ತಿಯಾ ಹಾನಲ್ಲಿ ವಸ್ತಾ ತಿಯಾಚ್ ಥವ್ನ್ ಘೆ, ಖರೆ ಮಾಜಿ ಲೊಕಾ ತವ್ಡಿಚ್ ಮಾಕಾ ದಿ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />ಖರೆ ಅಬ್ರಾಮಾನ್ ತೆಕಾ ಮಳಬ್ ಅನಿ ಜಿಮಿನ್ ರಚಲ್ಯಾ ಮಹೊನ್ನತ್ ದೆವಾಕ್ಡೆ ಹಾತ್ ಉಚ್ಲುನ್ ಆನ್ ಘಾಲ್ತಾ, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />ಮಿಯಾ ತುಜೆ ಕಾಯ್ಬಿ ಘೆಯ್ನಾ, ತೆ ಎಕುಚ್ ಎಕ್ ದೊರೊ ಹೊಂವ್ದಿತ್, ನಾತರ್ ವ್ಹನಾಯಾಚಿ ನಾಡಿ ಹೊಂವ್ದಿತ್, ಮಿಯಾ ಮಾಜ್ಯಾಕ್ಡೆ ಥವ್ನ್ ಘೆಯ್ನಾ, ಅಬ್ರಾಹಾಮಾಕ್ ಸಾವ್ಕಾರ್ ಕರಲ್ಲೆ ಮಿಯಾಚ್ ಮನುನ್ ಸಾಂಗುನ್ಗೆತ್ ಫಿರುಕ್ ಅವ್ಕಾಸ್ ಹೊತಲೆ ನಕ್ಕೊ. <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />ಮಾಕಾ ಕಾಯ್ಬಿ ನಕ್ಕೊ, ಮಾಜ್ಯಾ ಆಳಾನಿ ಖಾಲ್ಲೆ ಫಿಲ್ಲೆ ತವ್ಡೆಚ್ ಫಿರೆ ಖರೆ ಮಾಕಾ ಲಡಾಯಿತ್ ಮಜತ್ ಕರಲ್ಲೆ ವಾಂಗ್ಡಿ ಆನೆರ್, ಇಸ್ಕೊಲ್, ಅನಿ ಮಾಮ್ರೆ ತೆಂಚೊ ವಾಟೊ ದಿಲ್ಯಾರ್ ಫಿರೆ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">ಅಬ್ರಾಮಾಚ್ಯಾ ವಾಂಗ್ಡಾ ದೆವಾಚೊ ಕರಾರ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />ಹೆ ಸಗ್ಳೆ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಬ್ರಾಮಾಚ್ಯಾ ದರ್ಶನಾತ್ ದಿಸುನ್, ತೆಕಾ, “ಅಬ್ರಾಮ್ ತಿಯಾ ಬ್ಹಿಂವ್ ನಕ್ಕೊ; ಮಿಯಾ ತುಜೊ ಢಾಲ್ ಹೊವ್ನ್ ಹಾಯ್, ತುಕಾ ಮಿಯಾ ಮೊಟೊ ಭೊಮಾನ್ ದಿತಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />ಖರೆ ಅಬ್ರಾಮಾನ್ ತೆಕಾ, “ಸರ್ವೆಸ್ಪರ್ ದೆವಾ, ತಿಯಾ ಕಾಯ್ ಬರೆ ಭೊಮಾನ್ ಮಾಕಾ ದಿಲ್ಯಾರ್ಬಿ ಆಜ್ ಪತರ್ ಮಾಕಾ ಪೊರಾ ನಾತ್ ನೈ? ಮಾಕಾ ವಾರಿಸ್ದಾರ್ ದಮಸ್ಕಾತ್ ರಾತಲೊ ಮಾಜೊ ಸೆವಕ್ ಎಲಿಯೆಜೆರುಚ್ ಹೊತಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />ಅನಿ ಅಬ್ರಾಮಾನ್, “ತಿಯಾ ಮಾಕಾ ಪೊರ್ ದಿವ್ಕ್ ನೈ, ತೆಚ್ಯಾ ವೈನಾ ಮಾಜ್ಯಾ ಘರ್‍ಹಾತ್ ಉಪಾಜಲ್ಲೊ ಸೆವಕ್ ತೊ ಮಾಜಿ ಸಗ್ಳಿ ಆಸ್ತಿ ಅಧಿನಾತ್ ಕರುನ್ಗೆತಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಬ್ರಾಹಾಮಾಕ್, “ತುಜಿ ಆಸ್ತಿ ಪುರಾ ತುಜೊ ಸೆವಕ್ ಘೆಯ್ನಾ, ತುಜ್ಯಾಕ್ನಾ ಉಪಾಜಲ್ಲೊ ಲೆಕುಚ್ ತೆಚ್ಯಾ ಆಸ್ತಿಕ್ ವಾರಿಸ್ದಾರ್ ಹೊತಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />ಮಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಬ್ರಾಹಾಮಾಕ್ ಭಾಯ್ರ್ ಬಲ್ವುನ್ ನೆವ್ನ್, “ಮಳ್ಬಾಕ್ ನದರ್ ಘಾಲುನ್ ಬಗ್ ಅನಿ ತುಜೆನ್ ಹೊಲ್ಯಾರ್ ಚುಕ್ಕಿಯಾ ಮೆಜ್ ಅನಿ ಅಸೆಚ್ ತುಜಿ ಪಿಳ್ಗಿಬಿ ಹೊತಾ!” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />ತನ್ನಾ ಅಬ್ರಾಮಾನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾ ವರ್‍ತಿ ವಿಶ್ವಾಸ್ ಕರ್ಲ್ಯಾನ್, ತ್ಯಾ ವಿಶ್ವಾಸಾ ವೈನಾ ಸರ್ವೆಸ್ಪರ್ ಖುಶಿ ಹೊಲೊ ಅನಿ ತೆಕಾ ಸ್ವಿಕಾರ್ ಕರ್ಲ್ಯಾನ್.<verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />ಮಾನಾ ತೆನಿ ಅಬ್ರಾಹಾಮಾಕ್ “ಕಲ್ದಿಯಾತ್ಲ್ಯಾ ಉರ್ ಶಾರಾಕ್ ತುಕಾ ಬಲ್ವುನ್ ಹಾನುನ್, ಹೊ ದೆಶ್ ದಿವ್ಚೆ ಮನುನ್ ಕರ್ಲಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />ಖರೆ “ಸರ್ವೆಸ್ಪರಾ ಹ್ಯೊ ದೆಶ್ ಗಾವ್ತಾ ಮನುನ್ ಕಸೆ ಒಳ್ಕುನ್ ಗೆವ್ಕ್ ಹೊತಾ?” ಮನುನ್ ಅಬ್ರಾಮಾನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />ದೆವಾನ್ ತನ್ನಾ, “ತಿನ್ ವರ್ಸಾಚಿ ಎಕ್ ಪಾಡಿ, ತಿನ್ ವರ್ಸಾಚೆ ಬಕ್ರೆ ಅನಿ ತಿನ್ ವರ್ಸಚಿ ಎಕ್ ಶೆಳಿ ಹಾನ್, ಅನಿ ಎಕ್ ಕೌಡೊ ಅನಿ ಎಕ್ ಪಾರಿವಾಳ್ ಘೆವ್ನ್ ಯೆ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 15:9" /><verse number="10" style="v" sid="GEN 15:10" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಸಾಂಗಲ್ಲೆ ಸಗ್ಳೆ ಅಬ್ರಾಮಾನ್ ಹಾನ್ಲ್ಯಾನ್, ಮಾನಾ ತೆ ಕಾತ್ರುನ್ ಅರ್ಧೆ ತುಕ್ಡೆ ಕರ್ಲ್ಯಾನ್, ಅನಿ ಅರ್ಧೆ ಕರಲ್ಯಾಕ್ ಕಾಪುನ್ ದೊನ್ ತುಕ್ಡೆ ಕರ್ತಾ, ಖರೆ ಫಾಕ್ರಾಕ್ನಿ ಕಾಪುಕ್ ನಾ. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />ಮಾನಾ ಉಲ್ಲ್ಯಾ ಯೆಳಾನ್ ಹಳಿ ಹದ್ದಾ ಯೆತಾನಾ ಅಬ್ರಾಮಾನ್ ತೆಂಕಾ ಪಳ್ಸುನ್ ಘಾಟ್ಲ್ಯಾನ್.<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />ಮಾನಾ ಸಾಂಜ್ ಹೊಲಿ ದಿಸ್ ಬುಡುಲಾಲೆ ಅಬ್ರಾಹಾಮಾಕ್ ಮೊಟ್ಟಿ ನಿಜ್ ಲಾಗ್ಲಿ, ಮೊಟೊ ಅನಿ ಭಯಾನಕ್ ಕಾಳೊಕ್ ಹೊಲೊ.<verse eid="GEN 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 15:13" />ತನ್ನಾ ಅಬ್ರಾಹಾಮಾಕ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್, ಚಾರ್ಸೆ ವರಿಸ್ ತುಜಿ ಲೊಕಾ ಕೊನ್ಬಿ ನತ್ತೆ ಹೊವ್ನ್ ಸ್ವತ್ಯಾಚ್ಯಾ ನೈ ಹೊಲ್ಲ್ಯಾ ದೆಸಾತ್ ವಸ್ತಿ ರ್‍ಹಾತಾತ್, ಅನಿ ಗುಲಾಮ್ ಗಿರಿತ್ ರ್‍ಹಾತಾತ್, ತೆ ತುಕಾ ಯಾದ್ ರಾಂವ್ದಿತ್.<verse eid="GEN 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 15:14" />ಖರೆ ತುಮಿ ತೊ ದೆಶ್ ಸೊಡುನ್ ಜಾತಾನಾ ತುಮ್ಕಾ ಗುಲಾಮ್ ಗಿರಿತ್ ಚಾಲ್ವುತಲ್ಯಾ ಲೊಕಾಕ್ನಿ ಮಿಯಾ ಶಿಕ್ಷ್ಯಾ ದಿತಾ ಅನಿ ತೆನಿ ಭಾಯ್ರ್ ಪಡ್ತಾನಾ ಲೈ ಸಾವ್ಕಾರಾ ಹೊವ್ನ್ ಯೆತಾತ್. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />ತಿಯಾ ಮ್ಹಾತಾರ್ಯಾ ವೈಯಾತ್ ಲೈ ಸಮಾಧಾನಾನ್ ರಾತೈ ತುಜಿ ಮಾಟಿ ಶಾಂತ್ಪಾನಾನ್ ಹೊತಾ.<verse eid="GEN 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 15:16" />ಮಾನಾ ತುಜ್ಯಾ ಚಾರ್ವೆಚ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ ಪಾಟಿ ಪರ್‍ತುನ್ ಯೆತಾತ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತವ್ಡ್ಯಾ ಪತರ್ ಮಿಯಾ ಅಮೊರಿಯಾಕ್ನಿ ತ್ಯಾ ದೆಸಾತ್ನಾ ಭಾಯ್ರ್ ಕಾಡುನ್ ರ್‍ಹಾಯ್ನಾ, ತೆನಿ ಯೆವ್ನ್ ತೆಂಕಾ ಹಾರ್ವುತಾತ್ ಅನಿ ಮಿಯಾ ತೆಂಕಾ ಲೈ ಶಿಕ್ಷ್ಯಾ ದಿತಾ.<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />ಮಾನಾ ದಿಸ್ ಬುಡುನ್ ಲೈ ಕಾಳೊಕ್ ಹೊಲೊ, ತೆನಿ ಕರಲ್ಯಾ ಜನಾವರಾಂಚ್ಯಾ ಮಾಸಾಚ್ಯಾ ತುಕ್ಡ್ಯಾಂಚ್ಯಾ ಮದ್ನಾ ಡುಕ್ಟಾಚೆ ಗಾಡ್ಗೆ ಅನಿ ಆಗಿಚಿ ಚುಡ್ ದಾಟುನ್ ಗೆಲಿ. <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />ಮಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಬ್ರಾಮಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಆನ್ ಕರುನ್, “ಮಿಯಾ ತುಜ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ಲೊಕಾಕ್ನಿ, ಇಜಿಪ್ತಾಕ್ನಾ ಯುಪ್ರಟಿಕ್ ಮನ್ತಲ್ಯಾ ನ್ಹಯ್ ಪಾತರ್ಚೊ ಜಾಗೊ ದಿಲಾ, <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />ಕೆನಿಯಾ, ಕನಿಜಿಯಾ, ಕದ್ಮೊನಿಯಾ, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />ಹಿತ್ತಿಯಾಂಚೊ, ಪೆರಿಜಿತಾಂಚೊ, ರಾಫಾಯಿತಾಂಚೊ, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />ಅಮೊರಿತಾಂಚೊ, ಕಾನಾನ್ ಗಾರಾಂಚೊ, ಗಿರ್ಗಾಶಿತಾಂಚೊ, ಅನಿ ಜೆಬುಸಿಯಾಂಚೊ ದೆಶ್” ಮಿಯಾ ತುಕಾ ದಿತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">ಹಾಗಾರ್ ಅನಿ ಇಸ್ಮಾಯೆಲ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />ಅಬ್ರಾಮಾಚಿ ಬಾಯ್ಕೊ ಸಾರಾಕ್ ಪೊರಾ ನತ್ತಿ ತಿಕಾ ಎಕ್ ಇಜಿಪ್ತಾಚಿ ಹಾಗರ್ ಮನ್ತಲ್ಯಾ ನಾವಾಚಿ ಆಳ್ ಹೊತ್ತಿ. <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />ತನ್ನಾ ಸಾರಾನ್ ಅಬ್ರಾಹಾಮಾಕ್, ದೆವಾನ್ ಮಾಕಾ ತರ್ ಪೊರಾ ದಿವ್ಕ್ ನಾ, ತಿಯಾ ಮಾಜಿ ಆಳ್ ಹಾಗಾರಾವಾಂಗ್ಡಾ ಮಿಳ್ ಅನಿ ತಿಚ್ಯಾಕ್ನಾ ಹೊತಲ್ಯಾ ಪೊರಾನಿ ಮಿಯಾ ಕುಟುಂಬ್ ಭಾಂದುನ್ಗೆತಾ ಮಟ್ಲಿನ್. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />ಅಬ್ರಾಮ್ ಕಾನಾನ್ ದೆಶ್ಯಾತ್ ಯೆವ್ನ್ ಧಾ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಸಾರಾನ್ ಅಪ್ಲೊ ಅಬ್ರಾಹಾಮಾಕ್ ಅಪ್ಲಿ ಇಜಿಪ್ತಾಚಿ ಆಳ್ ಹಾಗರಾಕ್ ತೆಚಿ ಬಾಯ್ಕೊ ಕರುನ್ ದಿಲಿನ್. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />ತೊ ಹಾಗರಾಕ್ ಮಿಳ್ಳೊ, ಅನಿ ತಿ ಅಬ್ರಾಮಾಕ್ನಾ ಪೊಟಾನ್ ರಾಲಿ ತೆ ತಿಕಾ ಕಳಲ್ಯಾ ತನ್ನಾ ತಿಚ್ಯಾ ಯಜಮಾನಿಕ್ ಮಾನ್ ದಿಯ್ನಾ ಹೊಲಿ.<verse eid="GEN 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 16:5" />ತನ್ನಾ ಸಾರಾನ್, “ಮಾಜ್ಯಾ ತರಾಸಾಕ್ ಕಾರನ್ ತಿಯಾಚ್, ಅತ್ತಾ ತಿ ಪೊಟಾನ್ ರಾವ್ಕ್ ಮಿಯಾಚ್ ತುಕಾ ದಿಲೊ ಖರೆ ತಿ ಮಾಕಾ ಮಾನ್ ದಿ ನಾ ಹೊಲಾ, ಮಾಕಾ ಅನಿ ತುಕಾ ಸರ್ವೆಸ್ಪರ್ ದೆವುಚ್ ಝಡ್ತಿ ಕರುಂದಿತ್” ಮಟ್ಲಿನ್.<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />ತನ್ನಾ ಅಬ್ರಾಮಾನ್, “ತಿಯಾ ಹಾಗಾರಾಚಿ ಯಜಮಾನಿ, ತುಕಾ ಪಾಜೆ ತಸೆ ತಿಯಾ ತಿಕಾ ಕರ್ಲ್ಯಾರ್ ಹೊತಾ,” ಮನುನ್ ಸಾರಾಕ್ ಸಾಂಗ್ಲ್ಯಾನ್, ತನ್ನಾಚ್ಯಾನ್ ಸಾರಾನ್ ಹಾಗಾರಾಕ್ ತರಾಸ್ ದಿವ್ಕ್ ಶುರು ಕರ್‍ಲಿನ್, ಹಾಗರಾ ಥೈತ್ನಾ ಪಳುನ್ ಗೆಲಿ.<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />ಶುರಾ ಮನ್ತಲ್ಯಾ ಗಾಂವಾಕ್ ಜಾತಲ್ಯಾ ವಾಟೆಕ್ ಎಕ್ ಭಾಂಯ್ ಹೊತ್ತಿ, ತ್ಯಾ ಭಾಂಯಿಕ್ಡೆ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಧುತಾನ್ ಹಾಗರಾಕ್ ಭೆಟುನ್, <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />ಹಾಗರಾ, ಸಾರಾಚಿ ಆಳ್ ತಿಯಾ ಖೈತ್ನಾ ಯೆಲೈ?</para>
  <para style="p" vid="GEN 16:8">ಅನಿ ತಿಯಾ ಖೈ ಜಾವ್ಲೆಯ್ ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ, ತನ್ನಾ ಹಾಗರಾನ್, “ಮಾಜ್ಯಾ ಯಜಮಾನಿಕ್ ಸೊಡುನ್ ಪಳುನ್ ಜಾವ್ಕ್ ಲಾಗ್ಲಾ” ಮನುನ್ ಜಾಬ್ ದಿಲಿನ್.<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />ತನ್ನಾ ದೆವ್ ಧುತಾನ್, “ಸಾರಾ ತುಜಿ ಯಜಮಾನಿ ನೈ ಕಾಯ್? ತಿಯಾ ತಿಚ್ಯಾಕ್ಡೆ ಪರ್‍ತುನ್ ಜಾ ಅನಿ ತಿಚ್ಯಾ ಹಾತಿಖಾಯ್ಲ್ ರಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />ಮಾನಾ ದೆವ್ ಧುತಾನ್, “ಹಾಗಾರಾ ತುಜಿ ಪಿಳ್ಗಿ ಮೆಜುಕ್ ಹೊಯ್ನಸಲ್ಲಿ ತವ್ಡಿ ಲೈ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />ಮಾನಾ ದೆವ್ ಧುತಾನ್ ತಿಕಾ,</para>
  <para style="q2" vid="GEN 16:11">ಹಾಗರಾ ತಿಯಾ ಅತ್ತಾ ಪೊಟಾನ್ ಹಾಸ್; ತುಕಾ ಎಕ್ ಲೆಕ್ ಉಪಾಜ್ತಾ, ತೆಕಾ ತಿಯಾ ಇಸ್ಮಾಯೆಲ್ ಮನುನ್ ನಾವ್ ಥವ್; ತುಜೊ ಕಸ್ಟ್ ಸರ್ವೆಸ್ಪರಾನ್ ಆಯಿಕ್ಲಾ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 16:12" />ಅನಿ ಇಸ್ಮಾಯೆಲ್ ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಗಾಡ್ವಾ ಸಾರ್ಕೊ ಭಿರ್ಸ್ ಅನಿ ಸ್ವತಂತ್ರ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಅನಿ ತೊ ಹರಿ ಎಕ್ಲ್ಯಾಕ್ ಅನಿ ಹರ್ ಎಕ್ಲೊ ತೆಕಾ ವಿರೊದ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾತ್, ಅನಿ ಅಪ್ನಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಭಾವಾಂಚ್ಯಾಕ್ನಾ ದುರ್ ರ್‍ಹಾತಾ, ಮನುನ್ ಸಾಂಗುನ್ ಥೈತ್ನಾ ಗೆಲೊ.<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />ಹಾಗಾರಾನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲಾ ಮನುನ್ ಅನಿ ಮಾಜ್ಯಾ ವಿಶಯಾತ್ ಚಿಂತ್ಲಾ ಮನುನ್ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ “ಮಾಕಾ ಬಗ್ತಲೊ ದೆವ್” ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, “ಮಾಕಾ ಬಗ್ತಲ್ಯಾಕ್ ಮಿಯಾ ಬಗಟ್ಲೊ” ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್.<verse eid="GEN 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 16:14" />ಕಾದೆಶ್ ಅನಿ ಬೆರಿದಿಯಾಚ್ಯಾ ಮದ್ದಿ ರ್‍ಹಾತಲ್ಯಾ ಹ್ಯಾ ಭಾಂಯಿಕ್ ಮಾಕಾ ಬಗಟಲ್ಲೊ ಜಿವಿತಾಚ್ಯಾ ಭಾಂಯಿಕ್ ಲಹೈರೊಯಿ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />ಮಾನಾ ಹಾಗರಾನ್ ಅಬ್ರಾಮಾಚ್ಯಾ ಲೆಕಾಕ್ ಜಲಮ್ ದಿಲಿನ್, ಅಬ್ರಾಮಾನ್ ಹಾಗರಾಕ್ ಉಪಾಜಲ್ಲ್ಯಾ ಝಿಲ್ಗ್ಯಾಕ್ ಇಸ್ಮಾಯೆಲ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />ಹಾಗರಾನ್ ಇಸ್ಮಾಯೆಲಾಕ್ ಜಲಮ್ ದಿಲ್ಲ್ಯಾ ತನ್ನಾ ಅಬ್ರಾಹಾಮಾಕ್ ಆಂಯ್ಸೆರ್ ಸಾ ವರಿಸ್ ಹೊಲ್ಲೊ ರ್‍ಹಾತಾ.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">ಸುನ್ನತ್ ಕರಾರಾಚಿ ವಳಕ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />ಅಬ್ರಾಹಾಮಾಕ್ ನ್ಹವದಾರ್ ನ್ಹವ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ದರ್ಶನ್ ದಿವ್ನ್: ಮಿಯಾ ಸಗ್ಳೆಬಿ ಕರುಕ್ ಶಕ್ತ್ ಹೊತ್ತೊ ದೆವ್, ತಿಯಾ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ದೊಶ್ ನತ್ತೊ ಹೊವ್ನ್ ಚಲುಚೆ. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />ಮಿಯಾ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಎಕ್ ಕರಾರ್ ಕರುನ್ ಘೆತಾ; ತೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ತುಕಾ ಲೈ ವಾಡ್ವುತಾ ಅನಿ ತುಕಾ ಲೈ ಮೊಟಿ ಪಿಳ್ಗಿ ದಿತಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 17:2" /><verse number="3" style="v" sid="GEN 17:3" />ತನ್ನಾ ಎಗ್ದಮ್ ಅಬ್ರಾಹಾಮಾನ್ ದೆವಾಕ್ ಡಬ್ ಪಡುನ್ ನಮಸ್ಕಾರ್ ಕರ್ಲ್ಯಾನ್, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />ತನ್ನಾ ದೆವಾನ್, ಮಿಯಾ ತುಕಾ ಗೊಸ್ಟ್ ದಿತಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ತಿಯಾ ಲೈ ದೆಸಾಕ್ನಿ ವಾಡ್ ವಡಿಲ್ ಹೊವ್ನ್ ರಾತೈ. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />ಹೆಚ್ಯಾನ್ ಫಿಡೆ ತುಕಾ ಅಬ್ರಾಮ್ ಮನ್ತಲೆ ನಾವ್ ರ್‍ಹಾಯ್ನಾ ಅಬ್ರಾಹಾಮ್ ಮನುನ್ ನಾವ್ ಯೆತಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಮಿಯಾ ತುಕಾ ಲೈ ದೆಶ್ಯಾಕ್ನಿ ವಾಡ್ ವಡಿಲ್ ಕರುನ್ ಥವ್ಲಾ. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />ಅನಿ ತುಜ್ಯಾ ವೈನಾ ನವಿ ಲೊಕಾ ತಯಾರ್ ಹೊತಾತ್, ಅನಿ ತುಜಾಕ್ನಾ ದೆಶಾ ಅನಿ ರಾಜಾ ಉತ್ಪನ್ ಹೊತಾತ್.<verse eid="GEN 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 17:7" />ಮಿಯಾ ತುಕಾ ಅನಿ ತುಜ್ಯಾ ಪಿಳ್ಗಿಕ್ ದೆವ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಅನಿ ಹಿ ಗೊಸ್ಟ್ ಮಿಯಾ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಸದಾಸರ್ವತಾಕ್ ಘಟ್ ಕರುನ್ ಥವ್ತಾ. <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />ಅನಿ ಮಿಯಾಚ್ ತುಜೊ ದೆವ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ ಅನಿ ತಿಯಾ ಪರ್ಯಾನ್ ಕರುಕ್ ಲಾಗಲ್ಲೊ ಕಾನಾನ್ ದೆಶ್ ತುಕಾ ಅನಿ ತುಜ್ಯಾ ಪಿಳ್ಗಿಕ್ ದಿತಾ, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />ಅಸಿ ರ್‍ಹಾತಾನಾ ಅಮ್ಚ್ಯಾ ಗೊಸ್ಟಿ ಸಾರ್ಕೆ ತಿಯಾ ಅನಿ ತುಜ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ ಮಾಕಾ ಮಾನ್ ದಿವ್ನ್ ಚಲುಚೆ ಮನುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಬ್ರಾಹಾಮಾಕ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />ಅನಿ ಮಾಜ್ಯಾ ಖಾಯ್ದಾಚಿ ಒಳಕ್ ಹೊವ್ನ್ ತುಕಾ ಅನಿ ತುಜ್ಯಾ ಸಗ್ಳ್ಯಾ ಘೊಮಾನ್ಸಾಕ್ನಿ ಸುನ್ನತ್ ಹೊವ್ಕ್ ಪಾಜೆ. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />ತಿಯಾ ಸುನ್ನತ್ ಕರ್ಸುನ್ ಘೆವ್ಚೆ ತೆ ತುಜ್ಯಾ ಅನಿ ಮಾಜ್ಯಾ ಮದ್ದಿ ಹೊಲ್ಲ್ಯಾ ಕರಾರಾಕ್ ವಳಕ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ತುಮ್ಚ್ಯಾ ಪಿಳ್ಗಿತ್ ಉಪ್ಜುನ್ ಆಟ್ ದಿಸ್ ಹೊಲ್ಲ್ಯಾ ಝಿಲ್ ಬಾಳ್ಸಾಕ್ ಸುನ್ನತ್ ಹೊವ್ಚೆ, ತೊ ಖಲ್ಯಾಬಿ ಖಂದಾನಾತ್ ಉಪ್ಜುಂದಿತ್, <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />ಅನಿ ತುಮ್ಚ್ಯಾ ಪಿಳ್ಗಿತ್ ಉಪ್ಜುನ್ ಆಟ್ ದಿಸ್ ಹೊಲ್ಲ್ಯಾ ಝಿಲ್ ಬಾಳ್ಸಾಕ್ ಸುನ್ನತ್ ಹೊವ್ಚೆ, ತೆನಿ ತುಮ್ಚ್ಯಾ ಘರಾನಾಚೆ ಹೊಂವ್ದಿತ್ ನಾತರ್ ಬಾಳ್ಗುಕ್ ಘೆಟಲ್ಲೆ ಹೊವ್ನ್ ರಾಂವ್ದಿತ್ ನಾತರ್ ಇಕಾತ್ ಘೆಟಲ್ಲೆ ಹೊವ್ನ್ ರಾಂವ್ದಿತ್ ತೆಕಾ ಸುನ್ನತ್ ಹೊಲ್ಲೆ ರ್‍ಹಾವ್ಚೆ, ಹಿಚ್ ಮಿಯಾ ತುಮ್ಕಾ ದಿಲ್ಲಿ ಗೊಸ್ಟ್ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತುಜ್ಯಾ ಪಿಳ್ಗಿತ್ ಉಪಾಜಲ್ಲ್ಯಾ ಹರ್ ಎಕ್ ಝಿಲ್ಗ್ಯಾಕ್ ಸುನ್ನತ್ ಹೊವ್ಕ್ ಪಾಜೆ, ಹಿ ಎಕ್ ಆಂಗಾಚಿ ವಳಕ್ ಹೊವ್ನ್ ಹಾಯ್ ಅನಿ ಮಿಯಾ ತುಮ್ಕಾ ದಿಲ್ಲಿ ಗೊಸ್ಟ್ ಶಾಸ್ವತ್ ಕರಾರ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />ಅನಿ ಜೆ ಕೊನ್ ಸುನ್ನತ್ ಕರುನ್ ಘೆಯ್ನಸ್ತಾನಾ ಮಾಜ್ಯಾ ಗೊಸ್ಟಿಕ್ ಮಾನ್ ದಿನಸ್ಲ್ಯಾಕ್ ಅನಿ ಮಾಜ್ಯಾ ಕರಾರಾಚ್ಯಾ ಸಾರ್ಕೆ ಚಲುಕ್ ನಾ ತಸೆ ಮನುನ್ ಮಾಜ್ಯಾ ಲೊಕಾಂತ್ನಾ ತೆಕಾ ಶಾಶ್ವತ್ ಕಾಡುನ್ ಟಾಕ್ತಾ.<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />ದೆವಾನ್ ಅಬ್ರಾಹಾಮಾಕ್, “ತುಜಿ ಬಾಯ್ಕೊ ಸಾರಾಚೆ ನಾವ್ ಸಾರಾ ರ್‍ಹಾಯ್ನಾ ತಿಕಾ ಮಿಯಾ ಸಾರ್‍ಹಾ ಮನುನ್ ದುಸ್ರೆ ನಾವ್ ದಿತಾ”, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />ಅನಿ ಮಿಯಾ ತಿಕಾ ಆಶಿರ್ವಾದ್ ಕರುನ್ ಎಕ್ ಲೆಕ್ ದಿತಾ; ತೆಚೆ ವೈನಾ ಲೊಕಾಂಚೆ ರಾಜಾ ತಿಚೆಕ್ನಾಚ್ ಉಪಾಜ್ತಾತ್, ರಾಜಾಕ್ನಿ ಅನಿ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ತಿ ಮುಳಾಚಿ ಬಾಯ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />ಅಬ್ರಾಹಾಮಾನ್ ದೆವಾಕ್ ಅಪ್ಲೆ ತೊಂಡ್ ಜಿಮ್ನಿಕ್ ಲಾಗಿ ಪತರ್ ಡಬ್ಬ್ ಪಡುನ್ ನಮಸ್ಕಾರ್ ಕರ್ಲ್ಯಾನ್ ಅನಿ ಹಾಸುನ್ಗೆತ್ ಸೆಂಬರ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ಮಾನ್ಸಾಕ್ ಲೆಕ್ ಉಪಾಜ್ತಾ ಕಾಯ್ ?ಅನಿ ನ್ಹವ್ವದ್ ವರ್ಸಾತ್ ಸಾರ್‍ಹಾಕ್ ಪೊರ್ ಹೊತಾತ್ ಕಾಯ್?. <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />ಮಾನಾ ತೆನಿ ದೆವಾಕ್, ತುಜ್ಯಾ ಆಶಿರ್ವಾದಾತ್ ಇಸ್ಮಾಯೆಲ್ ರಾವ್ಕ್ ಫಿರೆ ನೈ? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />ತನ್ನಾ ದೆವಾನ್ ತೆಕಾ, ನಾ ! ಖರೆ ತುಜಿ ಬಾಯ್ಕೊ ಸಾರ್‍ಹಾಕ್ ಲೆಕ್ ಉಪಾಜ್ತಾ, ತೆಕಾ ತಿಯಾ ಇಸಾಕ್ ಮನುನ್ ನಾವ್ ಥವ್, ಅನಿ ಮಿಯಾ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಎಕ್ ಕರಾರ್ ಕರುನ್ಗೆತಾ ಅನಿ ತೆಚ್ಯಾ ಮಾನಾಚ್ಯಾ ಪಿಳ್ಗಿ ವಾಂಗ್ಡಾ ಶಾಶ್ವತಾಚೊ ಕರಾರ್ ಕರುನ್ಗೆತಾ. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />ಇಸ್ಮಾಯೆಲಾಚ್ಯಾ ವಿಶಯಾತ್ ಮಿಯಾ ಆಯ್ಕಲ್ಲ್ಯಾ ಸಾರ್ಕೆ, ತೆಕಾ ಆಶಿರ್ವಾದ್ ದಿವ್ನ್, ವಾಡ್ವುತಾ, ಅನಿ ತೆಜೊ ಎಕ್ ಮೊಟೊ ದೆಶ್ ಕರ್ತಾ, ಅನಿ ತೆಕಾ ಲೈ ಪೊರಾ ಹೊತಾತ್ ಅನಿ ಬಾರಾ ರಾಜಾಕ್ನಿ ತೊ ವಾಡ್ ವಡಿಲ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />ಖರೆ ಮಿಯಾ ಯೆತಲ್ಯಾ ವರ್ಸಿ ತುಕಾ ಹ್ಯಾ ಎಳಾರ್ ಸಾರಾಕ್ನಾ ಉಪಾಜ್ತಲೊ ಲೆಕ್ ಇಸಾಕಾ ವಾಂಗ್ಡಾ ಎಕ್ ಕರಾರ್ ಕರುನ್ಗೆತಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಬ್ರಾಹಾಮಾ ವಾಂಗ್ಡಾ ಬೊಲುನ್ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ತೆಜ್ಯಾಕ್ನಾ ವರ್‍ತಿ ಗೆಲೊ.<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾನ್ ದೆವಾಚ್ಯಾ ಹುಕುಮಾ ಸಾರ್ಕೆ ತ್ಯಾ ದಿಸಿ ಇಸ್ಮಾಯೆಲಾಕ್, ತೆಚ್ಯಾ ಘರ್‍ಹಾತ್ ರ್‍ಹಾತಲ್ಯಾ ಆಳಾಕ್ನಿ ಅನಿ ತೆಂಚ್ಯಾ ಝಿಲ್ಗ್ಯಾಕ್ನಿ ದುಸ್ರ್ಯಾ ದೆಸಾಕ್ನಾ ಹಾನಲ್ಯಾ ಸೆವಕಾಕ್ನಿ ಸುನ್ನತ್ ಕರಸ್ಲ್ಯಾನ್. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />ಅಬ್ರಾಹಾಮಾನ್ ಸುನ್ನತ್ ಕರುಸುನ್ಗೆಟಲ್ಲ್ಯಾ ತನ್ನಾ ತೆಕಾ ನ್ಹವದಾರ್ ನ್ಹವ್ ವರಿಸ್ ಹೊಲ್ಲೆ. <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />ಅನಿ ಇಸ್ಮಾಯೆಲಾಕ್ ಸುನ್ನತ್ ಹೊತಾನಾ ತೆರಾ ವರ್ಸಾಚೊ ಹೊವ್ನ್ ಹೊತ್ತೊ. <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />ಅಬ್ರಾಹಾಮ್ ಅನಿ ತೆಚೊ ಲೆಕ್ ಇಸ್ಮಾಯೆಲ್ ದೊಗ್ಯಾಕ್ನಿಬಿ ಎಕುಚ್ ದಿಸಿ ಸುನ್ನತ್ ಹೊಲಿ. <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />ಅನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಘರ್‍ಹಾತ್ ರ್‍ಹಾತಲ್ಯಾ ಘೊಮನ್ಸಾಕ್ನಿ ಅನಿ ಇಕಾತ್ ಹಾನಲ್ಯಾಕ್ನಿಬಿ ಸುನ್ನತ್ ಕರ್ಸುನ್ ಹೊಲಿ.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">ಅಬ್ರಾಹಾಮಾಕ್ ಲೆಕ್ ದಿತಾ ಮನ್ತಲಿ ಗೊಸ್ಟ್ ದಿಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />ಮಾಮ್ರೆ ಮನ್ತಲ್ಯಾ ಒಕ್ ಝಾಡಾಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ಅಬ್ರಾಹಾಮ್ ವಸ್ತಿ ರ್‍ಹಾತಾನಾ, ತ್ಯಾ ದಿಸಿ ದೊಪಾರಿ ಝಳ್ ಝಳಿತ್ ನಿಂಬ್ರಾಚ್ಯಾ ಎಳಾರ್ ತೊ ಅಪ್ನಾಚ್ಯಾ ಝೊಪ್ಡ್ಯಾಚ್ಯಾ ಹುಂಬ್ಡ್ಯಾತ್ ಬಸಲ್ಲೊ ರ್‍ಹಾತಾ ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತೆಕಾ ದರ್ಶನ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />ತನ್ನಾ ತೆನಿ ವರ್‍ತಿ ಬಗ್ತಾನಾ ತಿನ್ ಘವ್ಮಾನ್ಸಾ ಇಬೆ ಹೊತ್ತೆ ದಿಸ್ತಾತ್ ತೆಂಚ್ಯಾಕ್ಡೆ ಲಗ್ಗುನಾ ಪಳುನ್ ಜಾವ್ನ್ ಜಿಮ್ನಿಪಾತರ್ ಮಾನ್ ಬಾಗ್ವುನ್ ನಮಸ್ಕಾರ್ ಕರ್ತಾ ಮಾನಾ ತೆಂಕಾ, <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />“ಸಾಯ್ಬಾನೊ, ದಯಾ ಕರುನ್ ಮಾಜ್ಯಾ ಝೊಪ್ಡ್ಯಾಕ್ಡೆ ಇಬೆ ರಾಯ್ನಸ್ತಾನಾ ಜಾವ್ನಕಾಸಿ ಮಿಯಾ ತುಮ್ಚಿ ಸೆವಾ ಕರುಚೆ, <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />ಮಿಯಾ ತುಮ್ಚಿ ಪಾಯಾ ಧುವ್ನ್ ಘೆವ್ಕ್ ಪಾನಿ ಹಾನುನ್ ದಿತಾ, ತುಮಿ ಝಾಡಾಚ್ಯಾ ಬುಡಿ ಆರಾಮ್ ಘೆವಾ, <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />ಅನಿ ತುಮ್ಕಾ ಮಿಯಾ ಜೆವಾನ್ ಹಾನುನ್ ದಿತಾ, ಜೆವಾನ್ ಕರಾ ತೆಚೆ ವೈನಾ ತುಮ್ಕಾ ಪ್ರಯಾನ್ ಕರುಕ್ ಮಜತ್ ಹೊತಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್, ಮಾನಾ ತ್ಯಾ ತಿನಿ ಜಾನಾನಿಬಿ “ಹಾ, ತಿಯಾ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಹೊಂವ್ದಿತ್ ” ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />ಮಾನಾ ಅಬ್ರಾಹಾಮ್ ಝೊಪ್ಡ್ಯಾತ್ ಸಾರ್‍ಹಾಕ್ಡೆ ಪಳುನ್ ಜಾವ್ನ್ ಲಗ್ಗುನಾ ತಿನ್ ಸೆರ್ ಬರೆ ಪಿಟ್ಟ್ ಘೆವ್ನ್ ಆಳ್ವುನ್ ಉಲ್ಲಿ ಭಾಕ್ರಿಯಾ ಕರ್ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 18:6" /><verse number="7" style="v" sid="GEN 18:7" />ಮಾನಾ ತೊ ಗೊಟ್ಯಾಕ್ ಜಾವ್ನ್ ಪುಟ್ಪುಟಿತ್ ಪಾಡ್ಕೊ ಹಾನುನ್ ಲಗ್ಗುನಾ ರಾಂದುಕ್ ಆಳಾಕ್ಡೆ ದಿಲ್ಯಾನ್. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />ಮಾನಾ ತೆನಿ ರಾಂದಲ್ಲೆ ಮಾಸ್ ಅನಿ ದುದ್ದ್ ಅನಿ ಧಂಯ್ ಹಾನುನ್‍ ತ್ಯಾ ತಿನ್ ಮಾನ್ಸಾಕ್ನಿ ವಾಡ್ಲ್ಯಾನ್, ತೆನಿ ಝಾಡಾಚ್ಯಾ ಬುಡಿ ಬಸುನ್ ಖಾತಾನಾ ತೆಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ಇಬೆ ರ್‍ಹಾವ್ನ್ ತೆಚಿ ಸೆವಾ ಕರಿತ್ ಹೊತ್ತೊ.<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾಕ್, ತುಜಿ ಬಾಯ್ಕೊ ಸಾರ್‍ಹಾ ಖೈ ಹಾಯ್? ಮನುನ್ ಇಚಾರ್ಲ್ಯಾನಿ, ತನ್ನಾ ಅಬ್ರಾಹಾಮಾನ್ “ತಿ ಝೊಪ್ಡ್ಯಾತ್ ಹಾಯ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />ತನ್ನಾ ತೆಂಚ್ಯಾತ್ ಎಕ್ಲ್ಯಾನ್ ತೆಕಾ ಯೆತಲ್ಯಾ ವರಿಸ್ “ಮಿಯಾ ಹ್ಯಾ ಎಳಾರ್ ಯೆತಾನಾ ತುಜಿ ಬಾಯ್ಕೊ ಸಾರಾಕ್ ಎಕ್ ಝಿಲ್ಗೊ ಹೊಲ್ಲೊ ರ್‍ಹಾತಾ”.</para>
  <para style="p" vid="GEN 18:10">ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. ತಿ ಝೊಪ್ಡ್ಯಾಚ್ಯಾ ದಾರಾಕ್ಡೆಇಬೆ ರ್‍ಹಾವ್ನ್ ತೆನಿ ಸಾಂಗ್ತಲೆ ಸಗ್ಳೆ ಆಯ್ಕಿತ್ ಹೊತ್ತಿ. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />ಅಬ್ರಾಹಾಮ್ ಅನಿ ಸಾರ್‍ಹಾ ಲೈ ಮಾತಾರಿ ಹೊಲ್ಲೆ, ಅನಿ ಸಾರ್‍ಹಾಕ್ ಪೊರಾ ಹೊತಲೊ ಎಳ್ ಸರುನ್ ಗೆಲ್ಲೊ.<verse eid="GEN 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 18:12" />ತೆಚ್ಯಾ ವೈನಾ ತೆ ಆಯ್ಕುನ್ ತಿಕಾ ಹಾಸುಕ್ ಯೆವ್ನ್ ಮನಾತುಚ್ ಚಿಂತುನ್ ಮಾತಾರಿಕ್ ಘವಾಕ್ನಾ ನಿಜುಕ್ ಹೊತಾ ಕಾಯ್ ? ಮಾಜೊ ನ್ಹವ್ರೊಬಿ ಮ್ಹಾತಾರೊ ಹೊಲಾ.<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಬ್ರಾಹಾಮಾಕ್, ಸಾರಾಕ್ “ಮಿಯಾ ಸಾಂಗಲ್ಲೆ ವಿಶ್ವಾಸ್ ಹೊವ್ಕ್ ನಾ ಮನುನ್ ಮಾಕಾ ಪೊರಾ ಹೊತಲೆ ವಾಯಾ ಕಾಯ್?ಮನುನ್ ಕಶ್ಯಾಕ್ ಹಾಸುಲಾ? <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಹೊಯ್ ನಸಲ್ಲೆ ಕಾಯ್ಬಿ ಹಾಯ್ ಕಾಯ್? ಮಿಯಾ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಯೆತಲ್ಯಾ ವರ್ಸಿ ಹ್ಯಾ ಎಳಾರ್ ತುಜ್ಯಾಕ್ಡೆ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ ಸಾರ್‍ಹಾಕ್ ಎಕ್ ಪೊರ್ ರ್‍ಹಾತಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />ಖರೆ ಸಾರಾನ್ ಬ್ಹಿವ್ನ್, “ನಾ ಮಿಯಾ ಹಾಸುಕ್ ನಾ” ಮಟ್ಲಿನ್. ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ “ಹೊಯ್, ತಿಯಾ ಹಾಸ್ಲೆಯ್!” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 18:15" /></para>
  <para style="s">ಸೊದೊಮಾಚ್ಯಾ ಸಾಟ್ನಿ ಅಬ್ರಾಮಾಚಿ ಮಾಗ್ನಿ</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />ಮಾನಾ ತೆನಿ ಜಾತಾನಾ ಸೊದೊಮಾಕ್ಡೆ ಜಾತಾನಾ ಅಬ್ರಾಹಾಮ್ ತೆಂಕಾ ಧಾಡುನ್ ದಿವ್ಕ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಗೆಲೊ. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />ಮಿಯಾ ಅತ್ತಾ ಕರ್‍ತಲೆ ಕಾಮ್ ಅಬ್ರಾಹಾಮಾಕ್ ಸಾಂಗಿನಸ್ತಾನಾ ಕಸಿ ರಾವ್? ಮನುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮನಾತುಚ್ ಚಿಂತುನ್ ಘೆಟ್ಲ್ಯಾನ್. <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />ಹೆಚ್ಯಾ ಪಿಳ್ಗಿಕ್ನಾ ಮೊಟ್ಟೆ ಅನಿ ಮಾಹಾನ್ ದೆಶ್ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಅನಿ ತೆಚ್ಯಾ ವೈನಾ ಜಗಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಂಚಿ ಪಿಳ್ಗಿ ಆಶಿರ್ವಾದ್ ಘೆತಾ. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />ಅನಿ ತುಜ್ಯಾ ಲೆಕಾಕ್ನಿ ಅನಿ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ನಿತಿನ್ ಅನಿ ನ್ಯಾಯಾನ್ ಮಾನ್ ದಿವ್ನ್ ಚಲುಕ್ ಮನುನ್ ಮಿಯಾ ತುಕಾ ಎಚುನ್ ಘೆಟ್ಲಾ , ಮಿಯಾ ದಿತಾ ಮಟಲೆ ಫುರಾ ದಿತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />ಅನಿ ಸೊದೊಮ್ ಅನಿ ಗೊಮೊರಾತ್ಲಿ ಲೊಕಾ ಲೈ ಬುರ್ಶಿ ಮನುನ್ ಲೈಂದಾ ಆಯ್ಕಲ್ಲೊ, ತೆಂಚ್ಯಾ ವಿರೊದ್ ರಡ್ನೆ ಲೈ ಹೊಲಾ, ಅನಿ ತೆಂಚೊ ಪಾಪ್ ಲೈ ಹೊಲಾ. <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />ಮಿಯಾ ಖಾಲ್ತಿ ಉತ್ರುನ್ ಯೆತಾ ಅನಿ ತೆಂಚ್ಯಾ ವಿಶಯಾತ್ಲೆ ರಡ್ನೆ ಮಾಜ್ಯಾಕ್ಡೆ ಪಾವಲ್ಲೆ ಖರೆ ಹೊಯ್ ಕಾಯ್ ನಾ ಮನುನ್ ಬಗ್ತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />ಖರೆ ತಿ ಘವ್ಮಾನ್ಸಾ ಸೊದೊಮಾಕ್ಡೆ ಚಲಿತ್ ರ್‍ಹಾತಾನಾ, ಅಬ್ರಾಹಾಮ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆ ರ್‍ಹಾತಾ.<verse eid="GEN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 18:23" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚ್ಯಾ ಇದ್ರಾಕ್ ಅಬ್ರಾಹಾಮ್ ಯೆವ್ನ್ ತಿಯಾ ಬುರ್ಶಾ ಲೊಕಾಕ್ನಿ ನಾಶ್ ಕರ್ತಾನಾ ಬರ್‍ಯಾ ಲೊಕಾಕ್ನಿಬಿ ನಾಶ್ ಕರ್ತೆ ಕಾಯ್ ? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />ಎಕ್ ಯೆಳಾ ತ್ಯಾ ಶಾರ್‍ಹಾತ್ ಪನ್ನಾಸ್ ಲೊಕಾ ಧರ್ಮಿಸ್ಟ್ ರಾಲ್ಯಾರ್ ತಿಯಾ ತೊ ಶಾರ್ ನಾಶ್ ಕರ್‍ತೆ ಕಾಯ್? ತ್ಯಾ ಪನ್ನಾಸ್ ಲೊಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಶಾರ್ ಹುರ್ಯಿ ನ್ಹಯ್ ಕಾಯ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />ಬುರ್ಶಾ ಲೊಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಮನುನ್ ಧರ್ಮಿಸ್ಟ್ ಲೊಕಾಕ್ನಿ ನಾಶ್ ಕರಿನೈ, ಎಕ್ ಯೆಳಾ ತಿಯಾ ನಾಶ್ ಕರ್‍ಲೆ ತರ್ ಬುರ್ಶಾಕ್ನಿ ಅನಿ ಬರ್‍ಯಾಕ್ನಿ ಎಕುಚ್ ನಮುನಿ ಬಗಲ್ಯಾ ಗತ್ ಹೊತಾ, ತೆನಿ ದೊಗ್ಯಾಕ್ನಿಬಿ ಶಿಕ್ಷ್ಯಾ ಹೊತಾ, ಅನಿ ತಿಯಾ ಹ್ಯಾ ಜಗಾಕ್ ಝಡ್ತಿ ಕರ್ತಲೊ ಮನುನ್ ಮಾಕಾ ಗೊತ್ತ್ ಹಾಯ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 18:25" /><verse number="26" style="v" sid="GEN 18:26" />ಮಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ “ತ್ಯಾ ಸೊದೊಮ್ ಶಾರ್‍ಹಾತ್ ಪನ್ನಾಸ್ ಲೊಕಾ ಧರ್ಮಿಸ್ಟ್ ರಾಲ್ಯಾರ್ಬಿ ತೊ ಶಾರ್ ಮಿಯಾ ಹುರ್ವುತಾ,” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾನ್ ಮಿಯಾ ತುಜ್ಯಾಕ್ನಾ ಅನಿಬಿ ಬೊಲುಲ್ಲಾ ಖರೆ ಮಾಜ್ಯಾ ಹ್ಯಾ ಧರ್ಯಾ ಸಾಟ್ನಿ ಮಾಕಾ ಕ್ಷಮಾ ಕರ್, ಮಿಯಾ ಕೆವಲ್ ಮಾಟಿ ಅನಿ ರಕ್ಕಾ ಮಾಕಾ ಕಾಯ್ಬಿ ಸಾಂಗ್ತಲಿ ಕಿಮ್ಮತ್ ನಾ.<verse eid="GEN 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 18:28" />ಎಕ್ ಯೆಳಾ ಪಾಂಚ್ ಲೊಕಾ ಕಮ್ಮಿ ಹೊವ್ನ್ ತ್ಯಾ ಪಾಂಚ್ ಲೊಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ತೊ ಶಾರ್ ನಾಶ್ ಕರ್ತೈ ಕಾಯ್ ? ಮನುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಇಚಾರ್‍ಲ್ಯಾನಿ . ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾಕಾ ಚಾಳಿಸಾರ್ ಪಾಂಚ್ ಲೊಕಾ ಧರ್ಮಿಸ್ಟ್ ರ್‍ಹಾವ್ನ್ ದಿಸ್ಲ್ಯಾರ್ಬಿ ತ್ಯಾ ಶಾರಾಕ್ ಮಿಯಾ ನಾಶ್ ಕರಿನಾ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />ಅಬ್ರಾಹಾಮಾನ್ ಅನಿ ಪರ್‍ತುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್, ತಿಯಾ ತ್ಯಾ ಶಾರ್‍ಹಾತ್ ಚಾಳಿಸ್ ಲೊಕಾ ದಿಸ್ಲ್ಯಾರ್ ನಾಶ್ ಕರಿನೈ ಕಾಯ್ ? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ. ತನ್ನಾ ದೆವ್ ಬಾಬಾನ್ ತೆಕಾ, ಚಾಳಿಸ್ ಲೊಕಾ ಧರ್ಮಿಸ್ಟ್ ದಿಸ್ಲ್ಯಾರ್ಬಿ ತ್ಯಾ ಶಾರಾಕ್ ನಾಶ್ ಕರಿನಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್, ಮಾಜ್ಯಾ ವರ್‍ತಿ ರಾಗ್ ಹೊವ್ ನಕ್ಕೊ ಮಿಯಾ ಅನಿಬಿ ಬೊಲುಚೆ: ಹ್ಯಾ ಶಾರ್‍ಹಾತ್ ತಿಸ್ ಲೊಕಾ ಧರ್ಮಿಸ್ಟ್ ರಾಲ್ಯಾರ್ಬಿ ತೊ ಶಾರ್ ನಾಶ್ ಕರಿನೈ ಕಾಯ್ ? ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತೆಕಾ “ತಿಸ್ ಲೊಕಾ ಧರ್ಮಿಸ್ಟ್ ರಾಲ್ಯಾರ್ಬಿ ತೊ ಶಾರ್ ನಾಶ್ ಕರಿನಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />ಅನಿಬಿ ಮಾನಾ ಅಬ್ರಾಹಾಮಾನ್, ಮಾಜೊ ಸರ್ವೆಸ್ಪರಾ ದೆವ್ ಮಾಜ್ಯಾ ಧೈರ್ಯಾಕ್ ಸಾಟ್ನಿ ಮಾಕಾ ಕ್ಷಮಾ ಕರ್ ವಿಸ್ ಲೊಕಾ ಧರ್ಮಿಸ್ಟ್ ರಾಲ್ಯಾರ್ಬಿ ಕಾಯ್ ಕರ್‍ತೆ? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ, ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ವಿಸ್ ಲೊಕ್ ಧರ್ಮಿಸ್ಟ್ ರಾಲ್ಯಾರ್ಬಿ ತೊ ಶಾರಾ ನಾಶ್ ಕರಿನಾ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />ಅನಿಬಿ ಅಬ್ರಾಹಾಮಾನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಮಾಜ್ಯಾ ವರ್‍ತಿ ರಾಗ್ ಕರು ನಕ್ಕೊ ಅನಿ ಎಗ್ದಾ ಪರಸ್ನೆ ಇಚಾರ್ತಾ, ಖರೆ ಧಾ ಲೊಕಾ ಧರ್ಮಿಸ್ಟ್ ರಾಲ್ಯಾರ್ ಕಾಯ್ ಕರ್ತೈ? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ, ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತ್ಯಾ ಶಾರ್‍ಹಾತ್ ಧಾ ಲೊಕಾ ನಿತಿವಂತ್ ದಿಸ್ಲ್ಯಾರ್ಬಿ ತೊ ಶಾರಾ ಮಿಯಾ ನಾಶ್ ಕರಿನಾ, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />ಮಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಬ್ರಾಮಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ತಲೆ ಸಾರುನ್ ಥೈತ್ನಾ ಗೆಲೊ, ಅನಿ ಅಬ್ರಾಹಾಮ್ ಅಪ್ಲ್ಯಾ ಘರಾಕ್ ಗೆಲೊ.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">ಸೊದೊಮ್ ಗೊಮೊರಾಚೊ ಪಾಪ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />ದೊಗೆ ದೆವ್ ಧುತಾ ಸಾಂಚೆಕ್ಡೆ ಸೊದೊಮಾಕ್ ಯೆಲ್ಯಾನಿ, ಸೊದೊಮಾಕ್ ಗುಸ್ತಲ್ಯಾ ದಡ್ಪ್ಯಾಕ್ಡೆ ಲೊಟ್ ಮನ್ತಲೊ ಮಾನುಸ್ ಬಸುನ್ ಹೊತ್ತೊ, ಅನಿ ತೆನಿ ತೆಂಕಾ ಬಗುನ್ ತೆಂಚ್ಯಾಕ್ಡೆ ಜಾವ್ನ್ ತೆಂಚ್ಯಾ ಇದ್ರಾಕ್ ಮಾನ್ ಬಾಗ್ವುನ್, <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />ಸಾಯ್ಬಾನೊ, ತುಮ್ಚ್ಯಾ ಸೆವಕಾಚ್ಯಾ ಘರಾಕ್ ಯೆವಾ ಅನಿ ತುಮ್ಚಿ ಪಾಂಯಾ ಧುವಾ ಅನಿ ಆಜ್ ರಾತ್ತಿನ್ ಹಿತ್ತೆ ರಾವಾ, ಸಕ್ಕಾಳಾಕ್ ಲಗ್ಗುನಾ ಉಟುನ್ ಜಾವಾ. ಮಟ್ಲ್ಯಾನ್, ತನ್ನಾ ತೆನಿ “ನಾ” ಅಮಿ ಹ್ಯಾ ಶಾರಾಚ್ಯಾ ಕತ್ರಿತ್ ರ್‍ಹಾತ್ ಕಳ್ದುಚೆ, ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />ಲೊಟಾನ್ ತೆಂಕಾ ಲೈ ವತ್ತಾಯ್ ಕರ್ತಾನಾ ತೆನಿ ತೆಚ್ಯಾ ಘರಾಕ್ ಜಾವ್ಕ್ ಒಪ್ಲ್ಯಾನಿ ತೆನಿ ಘರಾಕ್ ಯೆಲ್ಲ್ಯಾ ಮಾನಾ ತೆಂಕಾ ಪುಗ್ ನಸಲ್ಲ್ಯಾ ಪಿಟ್ಟಾಚಿ ಭಾಕ್ರಿಯಾ ಕರುನ್ ತೆಂಕಾ ವಾಡ್ಲ್ಯಾನ್, ತೆನಿ ಜೆವಾನ್ ಕರ್ಲ್ಯಾನಿ.<verse eid="GEN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 19:4" />ಮಾನಾ ತೆನಿ ಜೆವಾನ್ ಕರುನ್ ನಿಜುಕ್ ಜಾತಲ್ಯಾ ಅದ್ದಿ, ಸೊದೊಮ್ ಶಾರ್‍ಹಾತ್ಲಿ ದಾಂಡ್ಗೆ ಅನಿ ಮ್ಹಾತಾರಿ ಘವ್ಮಾನ್ಸಾ ಸಗ್ಳಿ ಗೊಳಾ ಹೊವ್ನ್ ಲೊಟಾಚ್ಯಾ ಘರಾ ಘೆರಾವ್ ಘಾಲುನ್ ಇಬೆ ರ್‍ಹಾವ್ನ್, ತೆನಿ ಲೊಟಾಕ್, <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />ಆಜ್ ರಾತ್ತಿನ್ ತುಜ್ಯಾ ಘರಾಕ್ ಯೆಲ್ಲಿ ಘವ್ಮಾನ್ಸಾ ಖೈ ಹಾತ್? ತೆಂಕಾ ಭಾಯ್ರ್ ಬಲ್ವುನ್ ಹಾನ್; ಹ್ಯಾ ಸೊದೊಮಾಚ್ಯಾ ಘೊವ್ಮಾನ್ಸಾನಿ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ನಿಜುಕ್ ಆಶ್ಯಾ ಕರಲ್ಯಾನಿ,<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />ಲೊಟ್ ಭಾಯ್ರ್ ಯೆವ್ನ್ ದಾರಾ ಲಾವ್ನ್, <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />ತ್ಯಾ ಘೊಮಾನ್ಸಾಕ್ನಿ, ಮಾಜ್ಯಾ ದೊಸ್ತಾನೊ ದಯಾ ಕರುನ್ ಮಾಗ್ತಾ ಅಸ್ಲೆ ಬುರ್ಸೆ ಕಾಮ್ ಕರುನಕಾಸಿ. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />ಬಗಾ ಮಾಕಾ ದೊನ್ ನಿಂಬೆ ಚೆಡ್ವಾ ಹಾತ್, ತುಮ್ಚ್ಯಾ ಸಾಟ್ನಿ ತೆಂಕಾ ಮಿಯಾ ಭಾಯ್ರ್ ಧಾಡ್ತಾ, ಖರೆ ತೆಂಕಾ ಕಾಯ್ ತುಮಿ ಕಾಯ್ ಪಾಜೆ ತೆ ಕರಾ ಖರೆ ಹ್ಯಾ ಘೊಮಾನ್ಸಾಕ್ನಿ ಕಾಯ್ಬಿ ಕರುನಕಾಸಿ ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೆನಿ ಮಾಜ್ಯಾ ಘರಾಕ್ ಯೆಲ್ಲೆ ಸೈರೆ ತೆಂಕಾ ರಾಕ್ತಲೆ ಮಾಜಿ ಜವಾಬ್ದಾರಿ ಹಾಯ್, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್ .<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />ಖರೆ ತೆನಿ, ಭಾಯ್ಲ್ಯಾ ಗಾಂವ್ಚ್ಯಾ ವಾಟೆ ವೈನಾ ಸರಕ್ ! ಅಮ್ಚ್ಯಾ ವಾಟೆ ವೈನಾ ಸರಕ್ ನಾತರ್ ತೆಂಚ್ಯಾಕಿಂತಾಬಿ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಬುರ್ಸೆ ಕಾಮ್ ಕರ್ತಾಂವ್ ಮನುನ್ ಲೊಟಾಕ್ ಡಕ್ಲುನ್ ಟಾಕುನ್ ಧಾರ್ ಪೊಡುಕ್ ತಯಾರ್ ಹೊಲ್ಯಾನಿ. <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />ಖರೆ ಬುತ್ತುರ್ ಹೊತ್ತ್ಯಾ ಮಾನ್ಸಾನಿ ಲೊಟಾಕ್ ಘರಾಚ್ಯಾ ಬುತ್ತುರ್ ವಡುನ್ ಘೆವ್ನ್ ದಾರ್ ಧಾಪ್ಲ್ಯಾನಿ. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />ಮಾನಾ ತ್ಯಾ ಧುತಾನಿ ತ್ಯಾ ಘರಾಚ್ಯಾ ಭಾಯ್ರ್ ಹೊತ್ತ್ಯಾ ಬಾರಿಕ್ಲ್ಯಾಕ್ನಾ ಮೊಟ್ಟ್ಯಾ ಪಾತರ್ ಘೊಮಾನ್ಸಾಂಚೆ ಡೊಳೆ ದಿಸಿನಾ ಸಾರ್ಕೆ ಕುಡ್ಡೆ ಕರ್ಲ್ಯಾನಿ, ಅನಿ ತೆಂಕಾ ದಾರ್ ಕಲೆ ಮನುನ್ ಕಳಿನಾ ಸಾರ್ಕೆ ಹೊಲೆ.<verse eid="GEN 19:11" /></para>
  <para style="s">ಲೊಟಾನ್ ಸೊದೊಮ್ ಸೊಡಲ್ಲೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />ಅನಿ ತೆನಿ ಲೊಟಾಕ್, ತುಕಾ ಹ್ಯಾ ಶಾರ್‍ಹಾತ್ ಲೆಕಾ ಲೆಕಿಯಾ ಜಾವೈಯಾ ನಾತರ್ ಅನಿ ಕೊನ್ಬಿ ಸೈರೆ ರಾಲ್ಯಾರ್ ತೆಂಕಾ ಘೆವ್ನ್ ಹಿತ್ತೆತ್ನಾ ಭಾಯ್ರ್ ಪಡ್. <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಅಮಿ ಹ್ಯೊ ಶಾರ್ ನಾಶ್ ಕರ್ತಾಂವ್, ಹ್ಯಾ ಶಾರಾಚ್ಯಾ ವಿಶಯಾತ್ ಲೈ ಕಟಿನ್ ಧನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಆಯಿಕ್ಲಾ, ಅನಿ ತಸೆ ಹೊವ್ನ್ ಅಮ್ಕಾ ಸೊದೊಮಾಕ್ ನಾಶ್ ಕರುಕ್ ಧಾಡಲ್ಲೆ ಹಾಯ್, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನಿ.<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />ತೆಚ್ಯಾ ಮಾನಾ ಲೊಟಾನ್ ಅಪ್ಲ್ಯಾ ಲೆಕಿಯಾಕ್ನಿ ಲಗಿನ್ ಹೊನಾರ್ ಹೊತ್ತ್ಯಾ ಜಾವಯ್ಯಾಂಚ್ಯಾಕ್ಡೆ ಜಾವ್ನ್ ಯೆವಾ ಲಗ್ಗುನಾ ತಯಾರ್ ಹೊವ್ನ್ ಭಾಯ್ರ್ ಯೆವಾ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಹ್ಯೊ ಶಾರ್ ನಾಶ್ ಕರ್ನಾರ್ ಹಾಯ್ ಮಟ್ಲ್ಯಾನ್ ಖರೆ ತೆಚ್ಯಾ ಜಾವೈಯಾನಿ ತೊ ಮಸ್ಕೆರಿ ಕರುಲ್ಲಾ ಮನುನ್ ಚಿಂತ್ಲ್ಯಾನಿ.<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />ದೆವ್ ಧುತಾನಿ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ಅದ್ದಿ ಜಾವ್ಚೆ ಮನುನ್ ಲೊಟಾಕ್ ಗಡ್ಬಡ್ ಕರ್ಲ್ಯಾನಿ , ಅನಿ ಲಗ್ಗುನಾ ಉಟ್ ತುಜ್ಯಾ ಬಾಯ್ಕೊಕ್ ಅನಿ ಲೆಕಿಯಾಕ್ನಿ ಘೆವ್ನ್ ಹಿತ್ತೆತ್ನಾ ಭಾಯ್ರ್ ಪಡ್, ಹೆ ಶಾರ್ ನಾಸ್ ಹೊತಾನಾ ತುಮ್ಚ್ಯಾ ಜಿವಾಕ್ ಘಾತ್ ಹೊತಲೆ ನಕ್ಕೊ ಮಟ್ಲ್ಯಾನಿ, <verse eid="GEN 19:15" /><verse number="16" style="v" sid="GEN 19:16" />ಅನಿ ಕಂಗಾಲ್ ಹೊವ್ನ್ ತಡೊ ಕರ್ತಾನಾ, ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಲೊಟಾಚ್ಯಾ ವರ್‍ತಿ ದಯಾ ದಾಕ್ವುಲ್ಯಾನ್, ಅನಿ ಕಂಗಾಲ್ ಹೊವ್ನ್ ತಡೊ ಕರ್ತಾನಾ, ತೆಕಾ ಅನಿ ತೆಚ್ಯಾ ಬಾಯ್ಕೊಕ್ ಅನಿ ಲೆಕಿಯಾಕ್ನಿ ದೆವ್ ಧುತಾನಿ ಹಾತ್ ದರುನ್ ತೆಂಕಾ ಶಾರಾಚ್ಯಾ ಭಾಯ್ರ್ ಆರಾಮಾನ್ ಹಾನುನ್ ಪಾವ್ಸುಲ್ಯಾನಿ. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />ತನ್ನಾ ದೆವ್ ದುತಾಂತ್ಲ್ಯಾ ಎಕ್ಲ್ಯಾನ್, “ಜಿವ್ ಹುರ್ವುನ್ ಘೆವ್ಕ್ ಮನುನ್ ಪಳುನ್ ಜಾವಾ, ಡಂಗ್ಳಿತ್ ನಾತರ್ ಮಡ್ಡಿಚ್ಯಾ ವರ್‍ತಿ ಜಾವ್ನ್ ಪಾವಿ ಪತರ್ ಇಬೆ ರಾವ್ನಾಕಾಸಿ ಪಾಟಿ ಪರ್‍ತುನ್ ಬಗುನಕಾಸಿ, ನಾತರ್ ಹ್ಯಾ ಶಾರಾಚ್ಯಾ ವಾಂಗ್ಡಾ ನಾಶ್ ಹೊವ್ನ್ ಜಾತ್ಯಾಸಿ ಬಗಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />ಖರೆ ಲೊಟಾನ್, ಸಾಯ್ಬಾನೊ, ದಯಾ ಕರುನ್ ಲೈ ಧುರ್ ಪಳುನ್ ಜಾವ್ಕ್ ಅಮ್ಕಾ ಒತ್ತಾಯ್ ಕರುನಕಾಸಿ. <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />ತುಜಾ ಸೆವಕಾಕ್ ತುಮಿ ದಯಾ ದಾಕ್ವುನ್ ಮಾಜೊ ಜಿವ್ ವಾಚ್ವುಲ್ಯಾಕ್ ಲೈ ಮೊಟೊ ಉಪ್ಕಾರ್ ಹೊಲೆ; ಖರೆ ಮಡ್ಡಿ ಲೈ ಧುರ್ ಹಾಯ್ ಥೈ ಪತರ್ ಮಿಯಾ ಪಾವ್ಚ್ಯಾ ಅದ್ದಿಚ್ ಮರುನ್ ಜಾತಾ. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />ತನ್ನಾ ತೆನಿ ತೆಬಕ್, ಥೈ ಬಾರಿಕ್ ಶಾರ್ ದಿಸುಲ್ಲಾ ಕಾಯ್ ? ಥೈ ಜಾವ್ಕ್ ಮಾಕಾ ಹುಕುಮ್ ದಿಲ್ಯಾರ್ ಮಾಜೊ ಜಿವ್ ವಾಚ್ತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />ತನ್ನಾ ತ್ಯಾ ಮಾನ್ಸಾನಿ, “ಹೊಲೆ ತರ್, ತುಕಾ ಹುಕುಮ್ ದಿತಾ ಜಾ ಅನಿ ಜಿವ್ ವಾಚ್ವುನ್ ಘೆ ಮಿಯಾ ತೆ ಶಾರ್ ನಾಶ್ ಕರಿನಾ ಮಟ್ಲ್ಯಾನಿ. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />ಹೊಲ್ಯಾರ್ ತಿಯಾ ಲಗ್ಗುನಾ ತ್ಯಾ ಶಾರಾಕ್ ಪಳುನ್ ಜಾ, ತಿಯಾ ತ್ಯಾ ಶಾರಾಕ್ ಜಾವ್ನ್ ಪಾಯಿ ಪಾತರ್ ಮಿಯಾ ಸೊದೊಮ್ ಶಾರ್ ನಾಶ್ ಕರಿನಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನಿ. ತೆ ಶಾರ್ ಲೈ ಬಾರಿಕ್ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ಲೊಟಾನ್ ತೆಕಾ ಜೊವರ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 19:22" /></para>
  <para style="s">ಸೊದೊಮ್ ಅನಿ ಗೊಮೊರ್ ನಾಶ್ ಹೊತಲೆ</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />ಲೊಟ್ ಜಾವ್ನ್ ಚೊಗರಾಕ್ ಪಾವಿಪತರ್ ದಿಸ್ ಉಜ್ವಾಡ್ಲೊ. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್, ಸೊದೊಮ್ ಅನಿ ಗೊಮೊರ್ ಶಾರಾಂಚ್ಯಾ ವರ್‍ತಿ ಸರ್ಗಾಕ್ನಾ ಕೆಂಡಾಚೊ ಅನಿ ಆಗಿಚೊ ಪಾವ್ಸ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />ಅಸೆ ಕರುನ್ ತ್ಯಾ ಶಾರಾಕ್ ಅನಿ ತೆಚ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಶಾರಾಕ್ನಿ ಅನಿ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ಅನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ಹೊತ್ತ್ಯಾ ಫಿಕಾಕ್ ನಾಶ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />ಖರೆ ಲೊಟಾಚ್ಯಾ ಬಾಯ್ಕೊನ್ ಪಳ್ತಾನಾ ಪಾಟಿ ಪರ್‍ತುನ್ ಬಗಲ್ಯಾ ಸಾಟ್ನಿ ತಿ ಮಿಟ್ಟಾಚೊ ಖಾಂಬೊ ಹೊಲಿ.<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />ಅಬ್ರಾಹಾಮ್ ದುಸ್ರೆ ದಿಸಿ ಸಕ್ಕಾಳಾಕ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಪೈಲೆ ಭೆಟಲ್ಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಜಾವ್ನ್ ತೆಚ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆ ರ್‍ಹಾವ್ನ್, <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />ತೆನಿ ಸೊದೊಮ್ ಅನಿ ಗೊಮೊರ್ ಶಾರ್ ಬಗಟ್ಲ್ಯಾನ್, ಬೊಗ್ಧ್ಯಾತ್ನಾ ಡುಕೊಟ್ ಯೆವ್ಲಾಗಲ್ಲೊ ದಿಸ್ತಾ. <verse eid="GEN 19:28" /><verse number="29" style="v" sid="GEN 19:29" />ಅಸೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಬ್ರಾಹಾಮಾಕ್ ಯಾದ್ ಕರುನ್ ಗೆವ್ನ್ ಲೊಟಾಕ್ ಹುರ್‍ವುನ್ ತೊ ಹೊತ್ತ್ಯಾ ಶಾರಾಕ್ನಿ ನಾಶ್ ಕರ್ಲ್ಯಾನ್ .<verse eid="GEN 19:29" /></para>
  <para style="s">ಮೊಹಾಬಾಂಚೊ ಅನಿ ಅಮ್ಮೊನಾಂಚೊ ಪುರ್ವಜ್</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />ಮಾನಾ ಲೊಟಾಕ್ ಜೊಗರ್‍ಹಾತ್ ರಾವ್ಕ್ ಬ್ಹಿಂಯೆ ಕರ್ತಾನಾ, ತೊ ಅನಿ ತೆಚಿ ಲೆಕಿಯಾ ಥೈತ್ನಾ ಮಡ್ಡಿಚ್ಯಾ ವರ್‍ತಿ ಎಕ್ ಢೊಂಭಾತ್ನಿ ಜಾವ್ನ್ ವಸ್ತಿ ರಾಲ್ಯಾನಿ . <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />ಎಕ್ ದಿಸಿ ಥೊರ್ಲ್ಯಾ ಲೆಕಿನ್ ಅಪ್ನಾಚ್ಯಾ ಭೆನಿಕ್, “ಹ್ಯಾ ಜಾಗ್ಯಾರ್ ಅಮ್ಕಾ ಪೊರಾ ಉಪಾಜುಕ್ ಸಾಟ್ನಿ ಲಗಿನ್ ಹೊವ್ಕ್ ಎಕ್ಬಿ ಘೊಮಾನುಸ್ ನಾ, ಅನಿ ಅಮ್ಚೊ ಬಾಬಾಬಿ ಲೈ ಮ್ಹಾತಾರೊ ಹೊಲಾ, <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />ತಸೆ ಹೊವ್ನ್ ಅಮಿ ಅಮ್ಚಿ ಪಿಳ್ಗಿ ನಾ ಕರುನ್ ಗೆತಲೆ ನಕ್ಕೊ ಅನಿ ಅಮಿ ಅಮ್ಚಾ ಬಾಬಾಕ್ ನಿಶಾ ಹೊಯ್ ಸಾರ್ಕೆ ಕರುನ್ ಅಮಿ ತೆಚ್ಯಾಕ್ನಾ ಪೊರಾ ಕರುನ್ ಘೆವ್ವಾ ಹೆಜ್ಯಾ ವೈನಾ ಅಮಿ ಬಾಬಾಚಿ ಪಿಳ್ಗಿ ಹುರ್ವುಕ್ ಹೊತಾ” ಮನುನ್ ಸಾಂಗ್ಲಿನ್. <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />ಮಾನಾ ತ್ಯಾ ದಿಸಿ ರಾತ್ತಿನ್ ತೆಂಚ್ಯಾ ಬಾಬಾಕ್ ವಾಯ್ನ್ ದಿವ್ನ್ ತೆಕಾ ನಿಶಾ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ತೆಚಿ ಥೊರ್ಲಿ ಲೆಕ್ ಜಾವ್ನ್ ವಾಂಗ್ಡಾ ಮಿಳ್ತಾ, ಖರೆ ತಿ ಕನ್ನಾ ನಿಜ್ಲಿ ಅನಿ ಕನ್ನಾ ಉಟುನ್ ಗೆಲಿ ಮನುನ್ ಕಳುಕ್ನಾ.<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />ಮಾನಾ ದುಸ್ರೆ ದಿಸಿ, ಥೊರ್ಲ್ಯಾ ಲೆಕಿನ್ ತಿಚ್ಯಾ ಧಾಕ್ಲ್ಯಾ ಭೆನಿಕ್, “ಮಿಯಾ ಕಾಲ್ ರ್‍ಹಾತ್ತಿ ಬಾಬಾಚ್ಯಾ ವಾಂಗ್ಡಾ ನಿಜಲ್ಲೊ ಆಜ್ ತಿಯ್‍ ಬಾಬಾಕ್ ವಾಯ್ನ್ ದಿ ಅನಿ ತೆಕಾ ನಿಶಾ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಜಾವ್ನ್ ನಿಜ್, ಅಸಿ ಕರುನ್ ಅಮ್ಚಾ ಬಾಬಾಚಿ ಪಿಳ್ಗಿ ಹುರ್ವುಕ್ ಹೊತಾ” ಮನುನ್ ಸಾಂಗ್ಲಿನ್. <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />ಮಾನಾ ತ್ಯಾ ದಿಸಿ ರ್‍ಹಾತ್ತಿ ತೆಂಚ್ಯಾ ಬಾಬಾಕ್ ವಾಯ್ನ್ ದಿವ್ನ್ ತೆಕಾ ನಿಶಾ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಧಾಕ್ಲಿ ಲೆಕ್ ಜಾವ್ನ್ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳ್ಳಿನ್, ತ್ಯಾ ದಿಸಿಬಿ ತೊ ನಶಾತ್ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ತಿ ಕನ್ನಾ ನಿಜ್ಲಿ ಅನಿ ಕನ್ನಾ ಉಟುನ್ ಗೆಲಿ ಮನುನ್ ಕಳುಕ್ನಾ. <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />ಅಸಿ ಕರುನ್ ಲೊಟಾಚಿ ದೊನಿ ಲೆಕಿಯಾಬಿ ಅಪ್ಲ್ಯಾ ಬಾಬಾಕ್ನಾ ಪೊಟಾನಿ ರಾಲ್ಯಾನಿ. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />ಮಾನಾ ಥೊರ್ಲ್ಯಾ ಲೆಕಿಕ್ ಲೆಕ್ ಉಪಜ್ಲೊ ತಿನಿ ತೆಕಾ ಮೊವಾಬ್ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್, ಅತ್ತಾ ಹೊತ್ತ್ಯಾ ಮೊಹಾಬ್ ಲೊಕಾಕ್ನಿ ಹೊಚ್ ವಾಡ್ ವಡಿಲ್. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />ಅನಿ ತೆಚ್ಯಾ ಧಾಕ್ಲ್ಯಾ ಲೆಕಿಕ್ಬಿ ಎಕ್ ಲೆಕ್ ಉಪಜ್ಲೊ, ತಿನಿ ತೆಕಾ ಬೆನಾಮ್ಮಿ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್, ತೊ ಅತ್ತಾ ಹೊತ್ತ್ಯಾ ಅಮ್ಮೊನಿಯಾಕ್ನಿ ವಾಡ್ ವಡಿಲ್.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">ಅಬ್ರಾಹಾಮ್ ಅನಿ ಅಬಿಮೆಲೆಕ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />ಅಬ್ರಾಹಾಮ್ ಮಾಮ್ರೆತ್ನಾ ಕಾನಾನ್ ದೆಶಾಚ್ಯಾ ದಕ್ಷಿನ್ ಸಿಮೆಕ್ ಜಾವ್ನ್ ಕಾದೆಶ್ ಅನಿ ಶುರಿಚ್ಯಾ ಮದ್ದಿ ವಸ್ತಿ ಕರುನ್ಗೆತ್ ಉಲ್ಲೊ ಎಳ್ ಗೆರಾರಿ ಮನ್ತಲ್ಯಾ ಗಾಂವಾತ್ ಹೊತ್ತೊ. <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />ಗೆರಾರಿತ್ ರ್‍ಹಾತಾನಾ ಅಬ್ರಾಹಾಮಾನ್ ಸಾರ್‍ಹಾ ಮಾಜಿ ಭೆನ್ ಮನುನ್ ಸಾಂಗಟ್ಲ್ಯಾನ್, ತನ್ನಾ ಸಾರಾಕ್ ಅಪ್ನಾಚ್ಯಾಕ್ಡೆ ಥವ್ನ್ ಗೆವ್ಚೆ ಮನುನ್ ಗೆರಾರಿಚ್ಯಾ ರಾಜಾ ಅಬಿಮೆಲೆಕಾನ್ ಮನ್ ಕರ್ಲ್ಯಾನ್, <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />ಅಬಿಮೆಲೆಕಾಚ್ಯಾ ಸಪ್ನಾತ್ ತ್ಯಾ ದಿಸಿ ರಾತ್ತಿನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಬೊಲುನ್, ತಿಯಾ ಮರ್ತೈಯ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತಿಯಾ ಹಾನಲ್ಯಾ ಹ್ಯಾ ಬಾಯ್ಕೊಚೆ ಲಗಿನ್ ಹೊಲಾ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />ಖರೆ ಅಬಿಮೆಲೆಕಾನ್ ತಿಚ್ಯಾ ಜಗೊಳ್ಬಿ ಜಾವ್ಕ್ ನಾ ಅನಿ ತೆನಿ, ದೆವಾ ಮಿಯಾ ಚುಕ್ ಕರಲ್ಲೊ ನೈ ಹೊಲ್ಯಾರ್ಬಿ ಮಾಕಾ ಅನಿ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ನಾಶ್ ಕರ್‍ತೆ ಕಾಯ್? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />ಅಬ್ರಾಹಾಮಾನ್ ಸ್ವತಾ ಅಪ್ನಿಚ್ ತಿ ಮಾಕಾ ಭೆನ್ ಹೊವ್ಚೆ ಮಟ್ಲ್ಯಾನ್, ಅನಿ ತಿನಿಬಿ ಹೊ ಮಾಕಾ ಭಾವ್ ಹೊವ್ಚೆ ಮಟ್ಲಿನ್, ಮಿಯಾ ಚುಕ್ ಕರುಕ್ ನಾ ಮಿಯಾ ಚುಕ್ ಕರುಕ್ ಲಾಗ್ಲಾ ಮನುನ್ ಮಾಕಾ ಗೊತ್ತ್ ನತ್ತೆ, ಮಿಯಾ ಹೆ ಸಗ್ಳೆ ಬರ್‍ಯಾ ಮನಾನ್ ಅನಿ ಬರ್‍ಯಾ ಹಾತಿನ್ ಕರ್‍ಲೊ, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />ತನ್ನಾ ದೆವಾನ್ ಅಬೆಮೆಲೆಕಾಚ್ಯಾ ಸಪ್ನಾತ್ ಯೆವ್ನ್ , ಹೊಯ್, ತಿಯಾ ತೆ ಬರ್‍ಯಾ ಮನಾನ್ ಅನಿ ಬರ್‍ಯಾ ಹಾತಿನ್ ಕರ್‍ಲೆ ಮನುನ್ ತಿಕಾ ವಿರೊದ್ ಹೊವ್ನ್ ತಿಯಾ ಪಾಪ್ ಕರಿನಾ ಸಾರ್ಕೆ ಅಡ್ವುನ್ ತಿಯಾ ತಿಕಾ ಅಪ್ಡಿನಾ ಸಾರ್ಕೆ ಕರಲ್ಲೊ.<verse eid="GEN 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 20:7" />ತೆಚ್ಯಾ ವೈನಾ ತೆಚಿ ಬಾಯ್ಕೊ ತೆಕಾ ಒಪ್ಸುನ್ ದಿ, ತೊ ಎಕ್ ಪ್ರವಾದಿ ತೊ ತುಜ್ಯಾ ಸಾಟ್ನಿ ಮಾಗ್ನಿ ಕರ್ತಾ ತನ್ನಾ ತಿಯಾ ವಾಚ್ತೆಯ್, ತಿಯಾ ತಿಕಾ ದಿಯ್ನಸ್ಲ್ಯಾರ್, ತಿಯಾ ಅನಿ ತುಜಿ ಲೊಕಾ ಮರುನ್ ಜಾತ್ಯಾಸಿ ಮನುನ್ ಹುರ್ಶಾಕಿ ದಿಲ್ಯಾನ್.<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />ಮಾನಾ ದುಸ್ರೆ ದಿಸಿ ಸಕ್ಕಾಳಿ ಅಬಿಮೆಲೆಕಾನ್ ತೆಚೆ ಸಫಾನ್ ಕಾಮ್ಗಾರ್ಯಾಕ್ನಿ ಸಾಂಗ್ಲ್ಯಾನ್, ತೆನಿ ಆಯ್ಕುನ್ ಬ್ಹಿಂವ್ಲ್ಯಾನಿ. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />ಮಾನಾ ತೆನಿ ಅಬ್ರಾಹಾಮಾಕ್ ಬಲ್ವುನ್: ತಿಯಾ ಅಮ್ಕಾ ಅಸೆ ಕಶ್ಯಾಕ್ ಕರ್‍ಲೆ ? ಅಸ್ಲಿ ಚುಕ್ ಮಾಜ್ಯಾ ವರ್‍ತಿ ಅನಿ ಮಾಜ್ಯಾ ರಾಜಾಚ್ಯಾ ವರ್‍ತಿ ಕಶ್ಯಾಕ್ ಘಾಟಲೈ? ಮಿಯಾ ಕರುಕ್ ನಸಲ್ಲ್ಯಾ ಕಾಮಾಚಿ ಅಪರಾದ್ ಕರುಕ್ ಲಾವ್ಲೆ. <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />ಕಶ್ಯಾಕ್ ತಿಯಾ ಅಸೆ ಕರ್‍ಲೆ? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾನ್ ತೆಕಾ, ಹ್ಯಾ ಜಾಗ್ಯಾಚಿ ಲೊಕಾ ದೆವಾಚೆ ಬ್ಹಿಂಯೆ ನಸ್ತಾನಾ ಮಾಜ್ಯಾ ಬಾಯ್ಕೊಚ್ಯಾ ವೈನಾ ಮಾಕಾ ಜಿವಾನಿ ಮಾರ್ತಿಲ್ ಮನುನ್ ಚಿಂತಲ್ಲೊ. <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />ಖರೆಚ್ ಸಾಂಗುಚೆ ಹೊಲ್ಯಾರ್, ತಿ ಮಾಜಿ ಭೆನ್, ಮಾಜ್ಯಾ ಬಾಬಾಚಿ ಲೆಕ್ ಖರೆ ಮಾಜ್ಯಾ ಬಾಯ್ಚಿ ಲೆಕ್ ನೈ, ಅನಿ ಮಿಯಾ ತಿಕಾ ಲಗಿನ್ ಹೊಲೊ. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />ದೆವಾನ್ ಮಾಕಾ ಮಾಜ್ಯಾ ಬಾಬಾಚ್ಯಾ ಘರ್‍ಹಾತ್ನಾ ಧಾಡುನ್ ದುಸ್ರಾ ಜಾಗ್ಯಾರ್ ಜಾಯ್ ಸಾರ್ಕೆ ಕರಲ್ಯಾಕ್ ಮಿಯಾಚ್ ಸಾರಾಕ್, ತಿಯಾ ಕವ್ಡಿ ಬರ್‍ಯಾ ಮನಾಚಿ ಮನುನ್ ದಾಕ್ವುಕ್ ಮಾಕಾ ಎಕ್ ಉಪ್ಕಾರ್ ಕರುಚೆ ತೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ಅಮಿ ಖೈ ಜಾತಾಂವ್ ಥೈ ಮಿಯಾ ತುಕಾ ಭಾವ್ ಹೊವ್ಚೆ ಮನುನ್ ತಿಕಾ ಸಾಂಗಟಲ್ಲೊ.<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />ಮಾನಾ ಅಬಿಮೆಲೆಕಾನ್ ಸಾರ್‍ಹಾಕ್ ಪರ್‍ತುನ್ ಅಬ್ರಾಹಾಮಾಕ್ ದಿಲ್ಯಾನ್ ಅನಿ ತನ್ನಾ ಗೊರಾ ಬಕ್ರಿಯಾ, ಆಳಾ ತೆಕಾ ಒಪ್ಸುನ್, <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />ಅಬಕ್ ಮಾಜೊ ದೆಶ್ ತುಕಾ ಖೈ ಮನಾಕ್ ಲಾಗ್ತಾ ಥೈ ಬಾಳ್ವಿ ಕರುನ್ ಖಾ, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />ಅನಿ ತೆನಿ ಸಾರ್‍ಹಾಕ್, ಬಗ್ ತುಜ್ಯಾ ಭಾವಾಕ್ ಮಿಯಾ ಎಕ್ ಹಜಾರ್ ರುಪೈಚಿ ಚಾಂಧಿಚೆ ಪೈಸೊ ದಿಲಾ. ಹಿತ್ತೆ ಹೊಲ್ಲ್ಯಾ ವಿಶಯಾತ್ ಹೆ ಚುಕ್ ಸಮಾ ಕರುನ್ ಘೆವ್ಕ್ ದಿಲ್ಲೆ ಹಾಯ್, ತಿಯಾ ಪವಿತ್ರ್ ಮನಾಚಿ ಮನುನ್ ಹರ್ ಎಕ್ಲ್ಯಾಕ್ನಿ ಹೆ ಸಾಕ್ಷಿ ಹೊವ್ನ್ ರ್‍ಹಾತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾನ್ ದೆವಾಕ್ಡೆ ಮಾಗ್ನಿ ಕರ್ತಾನಾ, ದೆವಾನ್ ಅಬಿಮೆಲೆಕಾಕ್ ತೆಚ್ಯಾ ಬಾಯ್ಕೊಕ್ ಅನಿ ದಾಸಿಯಾಕ್ನಿ ಗುನ್ ಕರ್ಲ್ಯಾನ್ ಅನಿ ತೆಂಕಾ ಪೊರಾ ಹೊಲಿ. <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಅಬ್ರಾಹಾಮಾಚಿ ಬಾಯ್ಕೊ ಸಾರಾಚ್ಯಾ ವೈನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಬಿಮೆಲೆಕಾಚ್ಯಾ ಘರ್‍ಹಾತ್ ಹೊತ್ತ್ಯಾ ಬಾಯ್ಕಾಮಾನ್ಸಾಕ್ನಿ ಪೊರಾ ಹೊಯ್ನಾ ಸಾರ್ಕೆ ಕರಲ್ಲ್ಯಾನ್.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">ಇಸಾಕ್ ಉಪಾಜ್ತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಸಾರ್‍ಹಾಕ್ ದಿಲ್ಲಿ ಗೊಸ್ಟ್ ಫುರಾ ಕರ್ತಾ. <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />ಅಬ್ರಾಹಾಮ್ ಮ್ಹಾತಾರೊ ಹೊಲ್ಲ್ಯಾ ಎಳಾರ್ಬಿ ದೆವಾನ್ ದಿಲ್ಲ್ಯಾ ಗೊಸ್ಟಿ ಸಾರ್ಕೆ ತ್ಯಾ ಕಾಳಾರ್ ತಿನಿ ಪೊಟಾನಿ ರ್‍ಹಾವ್ನ್ ಎಕ್ ಲೆಕಾಕ್ ಜಲಮ್ ದಿಲಿನ್. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />ಅಬ್ರಾಹಾಮಾನ್ ಸಾರ್‍ಹಾಕ್ನಾ ಉಪಾಜ್ಲ್ಯಾಲ್ಯಾ ಲೆಕಾಕ್ ಇಸಾಕ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗೊಸ್ಟಿಚ್ಯಾ ಸಾರ್ಕೆ ಅಬ್ರಾಹಾಮಾನ್ ತೆಚ್ಯಾ ಲೆಕಾಕ್ ಆಟ್ ದಿಸಾ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಸುನ್ನತ್ ಕರಸ್ಲ್ಯಾನ್. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />ಇಸಾಕ್ ಉಪಾಜಲ್ಲ್ಯಾ ತನ್ನಾ ಅಬ್ರಾಹಾಮಾಕ್ ಸಂಬರ್ ವರ್ಸಾ ಹೊಲ್ಲೊ ರ್‍ಹಾತಾ. <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />ತನ್ನಾ ಸಾರಾನ್, “ದೆವಾನ್ ಮಾಜ್ಯಾ ತೊಂಡಾರ್ ಹಾಸೊ ದಿಲಾ ಹೆ ಆಯ್ಕುನ್ ಹರ್ ಎಕ್ಲೊಬಿ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಹಾಸ್ತಾತ್” ಮನುನ್ ಸಾಂಗ್ಲಿನ್. <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />ಸಾರ್‍ಹಾನ್, ಮಾಕಾ ಅಬ್ರಾಹಾಮಾಕ್ನಾ ಪೊರಾ ಹೊತಾತ್ ಮನುನ್ ಕೊನ್ಬಿ ಯವ್ಜುಕ್ ನತ್ತ್ಯಾನಿ ಅನಿ ಸಾರಾ ಪೊರಾಕ್ನಿ ಥಾನ್ ಪಾಜ್ವುತಾ ಮನುನ್, ಖರೆ ಅಬ್ರಾಹಾಮ್ ಮಾತಾರೊ ಹೊಲ್ಯಾರ್ಬಿ ತೆಚ್ಯಾ ಸಾಟ್ನಿ ಮಿಯಾ ಎಕ್ ಲೆಕಾಕ್ ಜಲಮ್ ದಿಲೊ.<verse eid="GEN 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />ಮಾನಾ ಇಸಾಕ್ ಮೊಟೊ ಹೊಲೊ ಅನಿ ತೆನಿ ಥಾನ್ ಫಿತಲೆ ಸೊಡಲ್ಯಾ ದಿಸಿ ಅಬ್ರಾಹಾಮಾನ್ ಸಗ್ಳ್ಯಾಕ್ನಿ ಮೊಟೆ ಜೆವಾನ್ ಘಾಟ್ಲ್ಯಾನ್.<verse eid="GEN 21:8" /></para>
  <para style="s">ಹಾಗರಾಕ್ ಅನಿ ಇಸ್ಮಾಯೆಲಾಕ್ ಧಾಡುನ್ ದಿಲ್ಲೆ</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />ಎಕ್ ದಿಸಿ ಅಬ್ರಾಹಾಮಾಕ್ನಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಹಾಗರಾಕ್ ಉಪಾಜಲ್ಲೊ ಲೆಕ್ ಇಸ್ಮಾಯೆಲ್ ಸಾರ್‍ಹಾಚೊ ಲೆಕ್ ಇಸಾಕಾಕ್ ಎಡ್ಸಡುಲಾಗಲ್ಲೆ ಬಗ್ಲಿನ್. <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />ತನ್ನಾ ಸಾರಾನ್ ಅಬ್ರಾಹಾಮಾಕ್, “ತ್ಯಾ ದಾಸಿಕ್ ಅನಿ ತಿಚ್ಯಾ ಲೆಕಾಕ್ ಭಾಯ್ರ್ ಘಾಲ್, ಆಸ್ತಿ ಫುರಾ ಮಾಜ್ಯಾ ಲೆಕ್ ಇಸಾಕಾಕ್ ಹೊತಾ, ಅನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಅನಿ ಎಕ್ಲೊ ವಾಟೊ ಹೊತಲೆ ಮಾಕಾ ಮನ್ ನಾ ”ಮನುನ್ ಸಾಂಗ್ಲಿನ್. <verse eid="GEN 21:10" /><verse number="11" style="v" sid="GEN 21:11" />ಇಸ್ಮಾಯೆಲ್ ಬಿ ಅಬ್ರಾಹಾಮಾಚೊ ಲೆಕ್ ಹೊಲ್ಯಾ ಸಾಟ್ನಿ ತೆಚ್ಯಾ ವಿಶಯಾತ್ ಅಬ್ರಾಹಾಮಾಕ್ ಲೈ ದುಕ್ಕ್ ಹೊತಾ. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />ಖರೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಬ್ರಾಹಾಮಾಕ್, ತುಜ್ಯಾ ಆಸ್ತಿಕ್ ಇಸಾಕ್ ಎಕುಚ್ ವಾರಿಸ್ದಾರ್ ಹೊವ್ಚೆ, ಅನಿ ತಿಯಾ ಹಾಗರಾ ಸಾಟ್ನಿ ಅನಿ ತಿಚ್ಯಾ ಲೆಕಾ ಸಾಟ್ನಿ ಮನುನ್ ಚಿಂತಾ ಕರುನಕ್ಕೊ ಸಾರಾನ್ ಸಾಂಗಟಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಕರ್. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />ಖರೆ ಮಿಯಾ ತುಜ್ಯಾ ಸೆವಕಿಚ್ಯಾ ಲೆಕಾಕ್ ಆಶಿರ್ವಾದ್ ದಿತಾ, ತೆಚ್ಯಾ ವೈನಾ ಮಿಯಾ ಮೊಟೊ ಲೊಕಾಂಚೊ ತಾಂಡೊ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತೊ ಬಿ ತುಜೊಚ್ ಲೆಕ್ ನೈ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />ಮಾನಾ ದುಸ್ರೆ ದಿಸಾ ಸಕ್ಕಾಳಾಕ್ ಉಲ್ಲೆ ಜೆವಾನ್ ಅನಿ ಚಮ್ಡ್ಯಾಚ್ಯಾ ಚಿಲಾತ್ ಪಾನಿ ದಿವ್ನ್ ಪೊರಾಕ್ ತಿಚ್ಯಾ ಡುಬ್ರಿವರ್‍ತಿ ಬಸ್ವುನ್ ತೆಂಕಾ ಘರ್‍ಹಾತ್ನಾ ಧಾಡುನ್ ದಿಲ್ಯಾನ್, ಮಾನಾ ತೆನಿ ಬೆರ್ಶಿಬಾಚ್ಯಾ ಡಂಗ್ಳಿತ್ ಪಿರುನ್ಗೆತ್ ಹೊತ್ತ್ಯಾನಿ. <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />ಅನಿ ಉಲ್ಲೊ ಎಳ್ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ತೆಂಚ್ಯಾಕ್ಡೆ ಹೊತ್ತೆ ಪಾನಿ ಸರುನ್ ಗೆಲೆ, ತೆಂಕಾ ಪಿವ್ಕ್ ಪಾನಿ ನತ್ತ್ಯಾ ಸಾಟ್ನಿ , ತಿ ಲೆಕಾಕ್ ಎಕ್ ಝಿಳಿಚ್ಯಾ ಸಾವ್ಳಿತ್ ನಿಜ್ವುತಾ, <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />ಅನಿ ತ್ಯಾ ಪೊರಾಕ್ನಾ ಸೆಂಬರ್ ಮಿಟರ್ ಧುರ್ ಜಾವ್ನ್ ಮಾಜೆ ಪೊರ್ ಮರ್ತಲೆ ಬಗುಕ್ ಹೊಯ್ನಾ ಮನುನ್ ಅಪ್ನಾ ಯೆವ್ಡ್ಯಾಕುಚ್ ಸಾಂಗುನ್ ಘೆವ್ನ್ ರಡುಲಾಲಿ.<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ತ್ಯಾ ಪೊರಾಚೆ ರಡ್ತಲೆ ಆಯಿಕ್ತಾ, ದೆವ್ ಧುತಾನ್ ಸರ್ಗಾಕ್ನಾ ತಿಕಾ ಬಲ್ವುನ್, ಹಾಗರಾ ತಿಯಾ ಕಶ್ಯಾಕ್ ತರಾಸ್ ಘೆತೆಯ್? ಬ್ಹಿಂವ್ ನಕ್ಕೊ ದೆವಾಕ್ ತುಜಾ ಪೊರಾಚೊ ರಡೊ ಆಯಿಕ್ಲಾ, <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />ಜಾ ತೆಕಾ ಉಕ್ಲುನ್ ಘೆ, ಅನಿ ತೆಕಾ ರಮಸ್ ಮಿಯಾ ತೆಚ್ಯಾ ಪಿಳ್ಗಿ ವೈನಾ ಮೊಟೊ ದೆಶ್ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />ಮಾನಾ ದೆವಾನ್ ತಿಚೆ ಡೊಳೆ ಉಗಡ್ಲ್ಯಾನ್ ಅನಿ ತಿಕಾ ಎಕ್ ಬಾಂಯ್ ದಿಸಿ ಸಾರ್ಕೆ ಕರ್ತಾ, ಮಾನಾ ತಿ ಜಾವ್ನ್ ಪಾನಿ ಭರುನ್ ಘೆವ್ನ್ ಲೆಕಾಕ್ ಪಾನಿ ಫಿವಸ್ತಾ. <verse eid="GEN 21:19" /><verse number="20" style="v" sid="GEN 21:20" />ದೆವ್ ತ್ಯಾ ಝಿಲ್ಗ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾವ್ನ್ ತೆಕಾ ವಾಡ್ವಳ್ಕಿ ಕರ್ತಾ, ಅನಿ ತೊ ತ್ಯಾ ಡಂಗ್ಳಿತ್ ಜಿವನ್ ಕರಿತ್ ಮೊಟೊ ಶಿಕಾರಿಕಾರ್ ಹೊತಾ.<verse eid="GEN 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 21:21" />ತೆಚಿ ಬಾಯ್ ತೆಕಾ ಇಜಿಪ್ತಾತ್ನಾ ಎಕ್ ಚೆಡು ಹಾನುನ್ ಬಾಯ್ಕೊ ಕರ್‍ಲಿನ್, ಮಾನಾ ತೆನಿ ಪರಾನ್ ಮನ್ತಲ್ಯಾ ಡಂಗ್ಳಿತ್ ವಸ್ತಿ ಕರಿತ್ ರ್‍ಹಾತಾತ್.<verse eid="GEN 21:21" /></para>
  <para style="s">ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ಅನಿ ಅಬಿಮೆಲೆಕಾಚ್ಯಾ ಮದ್ಲೊ ಕರಾರ್</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />ಮಾನಾ ಅಬಿಮೆಲೆಕ್ ಅನಿ ತೆಚೊ ಸೈನ್ಯಾಧಿಕಾರಿ ಫಿಕೊಲ್ ತೆನಿ ದೊಗೆ ಜಾನಾಬಿ ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ತ್ಯಾತ್, ಅನಿ ಅಬಿಮೆಲೆಕಾನ್ ಅಬ್ರಾಹಾಮಾಕ್, “ತಿಯಾ ಕರ್‍ತಲ್ಯಾ ಹರ್ ಎಕಾತ್ಬಿ ದೆವ್ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಹಾಯ್, <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />ತನ್ನಾ ತಿಯಾ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಭಾಸ್ ದಿ, ತಿಯಾ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಅನಿ ಮಾಜ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ವಾಂಗ್ಡಾ ನ್ಯಾಯಾನ್ ಚಲ್, ಅನಿ ಮಿಯಾ ತುಕಾ ದಯಾ ದಾಕ್ವುಲ್ಯಾ ಸರ್ಕೆ ತಿಯಾ ಬಿ ಮಾಕಾ ದಯಾ ದಾಕ್ವುಚೆ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />ತನ್ನಾ ಅಬ್ರಾಹಾಮಾನ್ ಮಿಯಾ ಭಾಸ್ ದಿತಾ ಮನುನ್,<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />ಮಾನಾ ಅಬಿಮೆಲೆಕಾಚ್ಯಾ ಸೆವಕಾನಿ ಕಾಡುನ್ ಘೆಟಲ್ಯಾ ಭಾಂಯಿಚ್ಯಾ ವಿಶಯಾತ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 21:26" />ತನ್ನಾ ಅಬಿಮೆಲೆಕಾನ್, “ತೆ ಕೊನ್ ಕರ್ಲಾತ್ ಮನುನ್ ಮಾಕಾ ಗೊತ್ತ್ ನಾ, ತಿಯಾ ಮಾಕಾ ಅದ್ದಿಚ್ ಕಶ್ಯಾಕ್ ಸಾಂಗುಕ್ ನೈ” ಅನಿ ಹ್ಯಾ ವಿಶಯಾತ್ ಆಯ್ಕುಲಾಗಲ್ಲೊ ಅತ್ತ್ಯಾಚ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 21:26" /><verse number="27" style="v" sid="GEN 21:27" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾನ್ ಅನಿ ಅಬಿಮೆಲೆಕಾಕ್ ಉಲ್ಲಿ ಗೊರಾಡೊರಾ ದಿವ್ನ್ ತೆನಿ ದೊಗೆಬಿ ಎಕ್ ಕರಾರ್ ಕರುನ್ ಘೆಟ್ಲ್ಯಾನಿ. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />ಅನಿ ಅಬ್ರಾಹಾಮಾನ್ ಶೆಳಿಯಾಂಚ್ಯಾ ತಾಂಡ್ಯಾತ್ನಾ ಸಾತ್ ಶೆಳಿಯಾ ಎಗ್ಳೆ ಕರ್ಲ್ಯಾನ್, <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />ಅನಿ ಅಬಿಮೆಲೆಕಾನ್ ತೆಕಾ ತಿಯಾ ಹೆ ಕಶ್ಯಾಕ್ ಎಗ್ಳೆ ಕರ್‍ಲೆ? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />ತನ್ನಾ ಅಬ್ರಾಹಾಮಾನ್, “ಹಿ ಭಾಂಯ್ ಮಿಯಾಚ್ ಖಂಡುಕ್ ಲಾವ್ಲಾ, ಮನ್ತಲ್ಯಾಕ್ ಹೆ ಸಾಕ್ಷಿ ಹೊವ್ನ್ ರಾಂವ್ದಿತ್, ತಸೆ ಹೊವ್ನ್ ಹಿ ಸಾತ್ ಶೆಳಿಯಾ ಘೆ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 21:30" /><verse number="31" style="v" sid="GEN 21:31" />ತೆಚ್ಯಾ ವೈನಾ ತ್ಯಾ ಕರಾರ್ ಕರಲ್ಯಾ ಭಾಂಯಿಕ್ ಬೆರ್ಶೆಬ್ ಮನುನ್ ನಾವ್ ಹೊಲೆ.<verse eid="GEN 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32" />ಬೆರ್ಶೆಬಾತ್ ಕರಾರ್ ಹೊಲ್ಯಾ ಮಾನಾ ಅಬಿಮೆಲೆಕ್ ಅನಿ ತೆಜೊ ಸೈನಾಧಿಕಾರಿ ಫಿಕೊಲ್ ಪಿಲಿಶ್ಟಿಯಾಕ್ ಪರ್‍ತುನ್ ಗೆಲ್ಯಾನಿ. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾನ್ ಬೆರ್ಶೆಬಾತ್ ತಾಮೆರಿಸ್ಕಾಚೆ ಝಾಡ್ ಲಾವ್ನ್ ಸದಾ ಸರ್ವತಾಕ್ ಜಿವನ್ ಕರ್‍ತಲ್ಯಾ ದೆವಾಕ್ ಆರಾದನ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />ಮಾನಾ ಅಬ್ರಾಹಾಮ್ ಪಿಲಿಶ್ಟಿಯಾಂಚ್ಯಾ ದೆಸಾತ್ ಲೈ ಎಳಾಚ್ಯಾನ್ ಜಿವನ್ ಕರಿತ್ ಹೊತ್ತೊ.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">ಅಬ್ರಾಹಾಮ್ ಇಸಾಕಾಕ್ ಭೆಟ್ವುತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />ದೆವಾನ್ ಅಬ್ರಾಹಾಮಾಚೊ ವಿಶ್ವಾಸ್ ಪರಿಕ್ಷಾ ಕರುಚೆ ಮನುನ್ ನಿರ್ದಾರ್ ಕರುನ್, “ಅಬ್ರಾಹಾಮಾ!” ಮನುನ್ ಬಲ್ವುಲ್ಯಾನ್, ತನ್ನಾ ಅಬ್ರಾಹಾಮಾನ್, “ಅಬಕ್ ಮಿಯಾ ಹಿತ್ತೆಚ್ ಹಾಂವ್” ಮನುನ್ ಜಾಬ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />ತನ್ನಾ ದೆವಾನ್ ತೆಕಾ, “ತೆಜೊ ಎಕ್ಲೊಚ್ ಪ್ರೆಮಾಚೊ ಲೆಕ್ ಇಸಾಕಾಕ್ ಘೆವ್ನ್ ಮಿಯಾ ಸಾಂಗ್ತಲ್ಯಾ ಮೊರಿಯಾ ದೆಶ್ಯಾಕ್ ಜಾವ್ನ್ ಮಿಯಾ ದಾಕ್ವುತಲ್ಯಾ ಮಡ್ಡಿ ವರ್‍ತಿ ತೆಕಾ ಬಲಿ ಭೆಟ್ವುಚೆ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾನ್ ದುಸ್ರೆ ದಿಸಿ ಉಟುನ್ ಬಲಿಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ನಾಕ್ಡಾ ಘೆವ್ನ್ ಅನಿ ದೊಗ್ಯಾ ಆಳಾಕ್ನಿ ಅನಿ ಇಸಾಕಾಕ್ ಬಲ್ವುನ್ ಘೆವ್ನ್ ದೆವಾನ್ ಸಾಂಗಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಜಾವ್ಲ್ಲೊ. <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />ತೆನಿ ತಿನ್ವೆ ದಿಸಿ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ ಪಾವಲ್ಲ್ಯಾ ತನ್ನಾ, ಅಬ್ರಾಹಾಮಾನ್ ಧುರ್ನಾ ಬಗ್ತಾನಾ ತೆಕಾ ತೊ ಜಾಗೊ ದಿಸ್ತಾ. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾನ್ ಅಪ್ನಾಚ್ಯಾ ಆಳಾಕ್ನಿ ತುಮಿ ಗಾಡ್ವಾಕ್ನಾ ಹಿತ್ತೆಚ್ ರಾವಾ; ತ್ಯಾ ಜಾಗ್ಯಾಕ್ ಮಿಯಾ ಅನಿ ಮಾಜೊ ಲೆಕ್ ಜಾವ್ನ್ ದೆವಾಕ್ ಆರಾದನ್ ಕರುನ್ ಪರ್‍ತುನ್ ಯೆತಾಂವ್, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />ಬಲಿ ಭೆಟ್ವುಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ನಾಕ್ಡಾ ಅಪ್ಲೊ ಲೆಕ್ ಇಸಾಕಾ ವರ್‍ತಿ ವಾವ್ಲ್ಯಾನ್ ಅನಿ ಸುರಿ ಅನಿ ಜಳ್ತಲೆ ಇಂಗ್ಳೆ ಘೆವ್ನ್ ತೆನಿ ದೊಗೆಬಿ ಚಲುನ್ ಗೆಲ್ಯಾನಿ. <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />ತನ್ನಾ ಇಸಾಕಾನ್ ಅಪ್ನಾಚೊ ಬಾಬಾ ಅಬ್ರಾಹಾಮಾಕ್,</para>
  <para style="p" vid="GEN 22:7">“ಬಾಬಾ” ಮನುನ್ ಬಲ್ವುಲ್ಯಾನ್. ತನ್ನಾ ಅಬ್ರಾಹಾಮಾನ್, ಕಾಯ್ ಮಾಜ್ಯಾ ಲೆಕಾ? ಮನುನ್ ಜವಾಬ್ ದಿಲ್ಯಾನ್, ತನ್ನಾ ಇಸಾಕಾನ್ ಆಗ್ ಅನಿ ನಾಕ್ಡಾ ಹಾತ್, ಖರೆ ಜಾಳ್ವುತಲಿ ಬಲಿ ಭೆಟ್ವುಕ್ ಪಾಜೆ ಹೊಲ್ಲೊ ಬಕ್ರೊ ಖಯ್ ಹಾಯ್? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />ತನ್ನಾ ಅಬ್ರಾಹಾಮಾನ್, “ತೆ ದೆವುಚ್ ದಿತಾ” ಮಟ್ಲ್ಯಾನ್, ಅನಿ ತೆನಿ ದೊಗೆಬಿ ಚಲುನ್ ಗೆಲೆ.<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />ತೆನಿ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ ಪಾವಲ್ಯಾ ತನ್ನಾ ಥೈ ಅಬ್ರಾಹಾಮಾನ್ ದೆವಾನ್ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಭಾಂದುನ್ ನಾಕ್ಡಾ ಥವ್ಲ್ಯಾನ್ ಅನಿ ತ್ಯಾ ನಾಕ್ಡಾಂಚ್ಯಾ ವರ್‍ತಿ ಅಪ್ಲೊ ಲೆಕ್ ಇಸಾಕಾಕ್ ಭಾಂದುನ್ ಥವ್ಲ್ಯಾನ್ ಅನಿ,<verse eid="GEN 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 22:10" />ತೆಕಾ ಬಲಿ ದಿವ್ಕ್ ಮನುನ್ ಸುರಿ ವರ್‍ತಿ ಉಚಲ್ಯಾನ್, <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />ಖರೆ ಸರ್ಗಾತ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚ್ಯಾ ಧುತಾನ್, “ಅಬ್ರಾಹಾಮಾ, ಅಬ್ರಾಹಾಮಾ!” ಮನುನ್ ಬಲ್ವುಲ್ಯಾನ್, ತನ್ನಾ ಅಬ್ರಾಹಾಮಾನ್ “ಅಬಕ್ ಮಿಯಾ ಹಿತ್ತೆ ಹಾಂವ್” ಮನುನ್ ಜಾಬ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಧುತಾನ್, ತುಜ್ಯಾ ಲೆಕಾಕ್ ಕಾಯ್ಬಿ ಕರು ನಕ್ಕೊ, ತಿಯಾ ದೆವಾಚ್ಯಾ ನದ್ರೆಕ್ ಖಾಲ್ತಿ ಹೊವ್ನ್ ಚಲ್ತಲೊ ಮಾನುಸ್ ಮನುನ್ ಮಾಕಾ ಕಳ್ಳೆ ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತಿಯಾ ತುಜ್ಯಾ ಎಕುಚ್ ಎಕ್ ಲೆಕಾಕ್ ಮಾಜ್ಯಾ ಸಾಟ್ನಿ ಬಲಿ ಭೆಟ್ವುಕ್ ಪಾಟಿ ಸರ್ಕುಕ್ ನೈ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />ಮಾನಾ ಅಬ್ರಾಹಾಮ್ ಬಗ್ತಾನಾ, ಝಿಳಿತ್ ಎಕ್ ಶೆಳಿ ಸಿಂಗಾ ಸಿರ್ಕುನ್ ಘೆವ್ನ್ ಹೊತ್ತೆ ಬಗ್ಲ್ಯಾನ್, ಲಗ್ಗುನಾ ಜಾವ್ನ್ ತ್ಯಾ ಟಗರ್ ಹಾನುನ್ ಲೆಕಾಚ್ಯಾ ಬದ್ಲಾಕ್ ಜಾಳ್ವುತಲಿ ಬಲಿ ಭೆಟ್ವುಲ್ಯಾನ್.<verse eid="GEN 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 22:14" />ಮಾನಾ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ “ಸರ್ವೆಸ್ಪರ್ ದಿನಾರೊ” ಮನುನ್ ನಾವ್ ದಿಲ್ಯಾನ್, ಅನಿ ತ್ಯಾ ಮಡ್ಡಿಕ್ ಅಜುನ್ ಪತರ್ಬಿ ಮಡ್ಡಿ ವರ್‍ತಿ ಸರ್ವೆಸ್ಪರ್ ದಿತಾ ಮನ್ತಲಿ ಗೊಸ್ಟ್ ಹಾಯ್.<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />ಮಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚ್ಯಾ ಧುತಾನ್ ಸರ್ಗಾಕ್ನಾ ದೊನ್ವೆಂದಾ ಅಬ್ರಾಹಾಮಾಕ್ ಬಲ್ವುನ್ ತೆಕಾ, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />ತಿಯಾ ಮಾಜ್ಯಾ ಸಾಟ್ನಿ ತುಜಾ ಹೊತ್ತ್ಯಾ ಎಕುಚ್ ಲೆಕಾಕ್ ದಿವ್ಕ್ ತಯಾರ್ ಹೊಲ್ಲ್ಯಾ , ತನ್ನಾ ಮಿಯಾ ತುಕಾ ಎಕ್ ಗೊಸ್ಟ್ ದಿತಾ: <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />ತುಜಿ ಪಿಳ್ಗಿ ಮಳ್ಬಾತ್ಲ್ಯಾ ಚುಕ್ಕಿಯಾಂಚ್ಯಾ ತವ್ಡಿ ಅನಿ ಸಮುಂದ್ರಾಚ್ಯಾ ದಂಡೆ ವೈಲ್ಯಾ ರೆತಿ ತವ್ಡಿ ವಾಡ್ವುನ್ ಆಶಿರ್ವಾದ್ ದಿತಾ , ಅನಿ ತಿಯಾ ತೆಂಚಿ ಶಾರಾ ತುಜ್ಯಾ ಅಧಿನಾತ್ ಕರುನ್ ಘೆತೆ. <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />ತಿಯಾ ಮಾಜ್ಯಾ ಗೊಸ್ಟಿಯಾಕ್ನಿ ಖಾಲ್ತಿ ಹೊವ್ನ್ ಚಲಲ್ಯಾ ಸಾಟ್ನಿ ತುಜ್ಯಾ ಪಿಳ್ಗಿಕ್ ಆಶಿರ್ವಾದ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಅಮ್ಕಾಬಿ ಆಶಿರ್ವಾದ್ ದಿ ಮನುನ್ ಸಗ್ಳ್ಯಾ ದೆಶ್ಯಾಂಚಿ ಲೊಕಾ ಮಾಗ್ತಾತ್. <verse eid="GEN 22:18" /><verse number="19" style="v" sid="GEN 22:19" />ಅಬ್ರಾಹಾಮ್ ಅಪ್ಲ್ಯಾ ಆಳಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಪರ್‍ತುನ್ ಅಪ್ನಿ ವಸ್ತಿ ರಾತಲೊ ಜಾಗೊ ಬೆರ್ಶೆಬಾಕ್ ಗೆಲೊ.<verse eid="GEN 22:19" /></para>
  <para style="s">ನಾಹೊರಾಚಿ ಪಿಳ್ಗಿ</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />ಉಲ್ಲೊ ಎಳ್ ಕಳ್ದಲ್ಯಾ ಮಾನಾ ಅಪ್ಲೊ ಭಾವ್ ನಾಹೊರಾಚಿ ಬಾಯ್ಕೊ ಮಿಲ್ಕಾಕ್ ಲೆಕ್ ಉಪಜ್ಲೊ ಮನ್ತಲಿ ಖಬರ್ ಅಬ್ರಾಹಾಮಾಕ್ ಗಾವ್ಲಿ. <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />ಎಕ್ವೆಚೊ ಉಚ್ ತೆಜೊ ಭಾವ್ ಬುಚ್ ಅನಿ ಆರಾಮಾಚೊ ಬಾಬಾ ಕೆಮುವೆಲ್, <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />ಕೆಸೆದ್, ಹಾಜೊ, ಪಿಲ್ದಾಶ್, ಇದ್ಲಾಪ್ ಅನಿ ಬೆತುವೆಲ್. <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />ರೆಬೆಕ್ಕಾಚೊ ಬಾಬಾ ಬೆತುವೆಲ್, ಮಿಲ್ಕಾನ್ ಅಬ್ರಾಹಾಮಾಚೊ ಭಾವ್ ನಾಹೊರಾಚ್ಯಾ ಆಟ್ ಲೆಕಾಕ್ನಿ ಜಲಮ್ ದಿಲಿನ್. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />ಅನಿ ನಾಹೊರಾಚಿ ಅನಿಎಕ್ ಬಾಯ್ಕೊ ರೆಹುಮಾಕ್ ಬಿ ಚಾರ್ ಲೆಕಾ ಉಪಾಜ್ತಾತ್ ತೆಂಚಿ ನಾಂವಾ ತೆಬಾ, ಗಾಹಾಮ್, ತಾಹಶ್, ಮಾಖಾ.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">ಸಾರ್‍ಹಾಚೆ ಮರಾನ್ ಅನಿ ಸಮಾದಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />ಸಾರ್‍ಹಾ ಎಕ್ಸೆ ವಿಸಾರ್ ಸಾತ್ ವರ್ಸಾ ಜಿವಾನಿ ರಾಲಿ. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />ತಿ ಕಾನಾನ್ ದೆಸಾತ್ಲಾ ಹೆಬ್ರೆ ಮನ್ತಲ್ಯಾ ಗಾಂವಾತ್ ಮರುನ್ ಗೆಲಿ, ಮಾನಾ ಅಬ್ರಾಹಾಮ್ ಯೆವ್ನ್ ತಿಕಾ ಬಗುನ್ ಲೈ ರಡ್ಲ್ಯಾನ್.<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />ಮಾನಾ ತಿಚೆ ಮಡೆ ನಿಜ್ವಲ್ಯಾಕ್ನಾ ತೊ ಜಾಗೊ ಸೊಡುನ್ ಹಿತ್ತಿಯಾಂಚ್ಯಾಕ್ಡೆ ಜಾವ್ನ್ ತೆಂಕಾ, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />“ಮಿಯಾ ಹ್ಯಾ ಗಾಂವಾಚೊ ನೈ” ಮಿಯಾ ಹಿತ್ತೆ ಪ್ರವಾಶ್ ಕರುಕ್ ಯೆಲ್ಲೊ, ಖರೆ ಮಾಜ್ಯಾ ಬಾಯ್ಕೊಚಿ ಮಾಟಿ ಕರುಕ್ ಮಾಕಾ ಉಲ್ಲೊ ಜಾಗೊ ಇಕಾತ್ ದಿವಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />ತನ್ನಾ ಅಬ್ರಾಹಾಮಾಕ್ ಹಿತ್ತಿಯಾನ್, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />ಸಾಯ್ಬಾನೊ, ದಯಾ ಕರುನ್ ಮಾಜಿ ಗೊಸ್ಟ್ ಆಯ್ಕಾ ಅಮ್ಚ್ಯಾ ನದ್ರೆಕ್ ತಿಯಾ ಎಕ್ ಮೊಟೊ ಮುಖಂಡ್ ಹೊವ್ನ್ ಬಗ್ತಾಂವ್, ಅಮ್ಚ್ಯಾ ಸಾಟ್ನಿ ಸಮಾಧಿ ಕರುಕ್ ಮನುನ್ ಹೊತ್ತ್ಯಾ ಬರ್‍ಯಾ ಜಾಗ್ಯಾರ್ ತಿಕಾ ಮಾಟಿ ಕರ್ ಅಮ್ಚ್ಯಾತ್ಲೆ ಕೊನ್ ಹೊಲ್ಯಾರ್ಬಿ ತುಕಾ ತುಜ್ಯಾ ಬಾಯ್ಕೊಚ್ಯಾ ಮಾಟಿ ಸಾಟ್ನಿ ಅಮ್ಚಾತ್ ಖಲೊ ಜಾಗೊಬಿ ಗೆ . ಮನುನ್ ಜವಾಬ್ ದಿಲ್ಯಾನಿ.<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />ಥೈ ಹೊತ್ತ್ಯಾ ಹಿತ್ತಿಯಾಕ್ನಿ ಅಬ್ರಾಹಾಮಾನ್ ಉಟುನ್ ಇಬೆ ರ್‍ಹಾವ್ನ್ ಮಾನ್ ಬಾಗ್ವುನ್ ನಮಸ್ಕಾರ್ ಕರುನ್, <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />ತುಮಿ ಖರೆಚ್ ಮಾಜ್ಯಾ ಬಾಯ್ಕೊಕ್ ಮಾಟಿ ಕರುಕ್ ಜಾಗೊ ದಿತಲೆ ಹೊಲ್ಯಾರ್ ಚೊಹರಾಚೊ ಲೆಕ್ ಎಪ್ರೊನಾಚ್ಯಾಕ್ಡೆ ವಾಂಗ್ಡಾ ಬೊಲುನ್, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />ತೆಚ್ಯಾ ಸೆತಾಕ್ಡೆ ಹೊತ್ತ್ಯಾ ಮೆಕ್ಪೆಪೆಲ್ ಮನ್ತಲೊ ಡೊಂಬೊ ತುಮ್ಚ್ಯಾ ಇದ್ರಾಕ್ ಫುರಾ ಪೈಸೊ ಘೆವ್ನ್ ಇಕಾತ್ ದಿವ್ಕ್ ಸಾಂಗ್ ಅಸೆ ಮಿಯಾ ಮಾಜ್ಯಾ ಸ್ವತಾಕ್ ಜಾಗೊ ಘೆವ್ಕ್ ಹೊತಾ.<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />ಎಪ್ರೊನ್ ಹಿತ್ತಿಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಶಾರಾಚ್ಯಾ ದಡ್ಪ್ಯಾತ್ ಬಸುಲ್ಲೊ ರ್‍ಹಾತಾ, ಥೈ ತೆಂಚೆ ಬೊಲ್ನೆ ಆಯ್ಕುನ್ ತೆನಿ ತೆಂಚ್ಯಾ ಸಗ್ಳ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಅಸೆ ಜವಾಬ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />“ತಸೆ ನೈ ಸಾಯ್ಬಾನೊ ಮಾಜಿ ಗೊಸ್ಟ್ ಆಯ್ಕಾ, ತೊ ಜಾಗೊ ಅನಿ ಡೊಂಬೊ ಸಗ್ಳ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಇದ್ರಾಕುಚ್ ತುಕಾ ದಿತಾ, ತಿಯಾ ತುಜಾ ಬಾಯ್ಕೊಚಿ ಮಾಟ್ಟಿ ಕರುಕ್ ಹೊತಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾನ್ ಹಿತ್ತಿಯಾಕ್ನಿ ಮಾನ್ ಬಾಗ್ವುನ್ ನಮಸ್ಕಾರ್ ಕರುನ್, <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />ಎಪ್ರೊನಾಕ್ ಅಬ್ರಾಹಾಮಾನ್ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ಆಯ್ಕಿ ಸಾರ್ಕೆ ಮಾಜೆ ಬೊಲ್ನಿ ಉಲ್ಲೆ ಆಯಿಕ್ತ್ಯಾಸಿ ಕಾಯ್, ಮಿಯಾ ಹ್ಯಾ ಸೆತಾಚಿ ಪೈಸೆ ದಿತಾ ತುಮಿ ಸ್ವಿಕಾರ್ ಕರುಚೆ ತನ್ನಾ ಮಿಯಾ ಹೊ ಜಾಗೊ ಸ್ವತಾಚೊ ಕರುನ್ ಘೆತಾ ಅನಿ ಮಾಜ್ಯಾ ಬಾಯ್ಕೊಚಿ ಮಾಟಿ ಕರ್ತಾ,<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />ತನ್ನಾ ಎಪ್ರೊನಾನ್ ಅಬ್ರಾಹಾಮಾಕ್, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />ಸಾಯ್ಬಾ, ಮಿಯಾ ಸಾಂಗ್ತಲೆ ಹಿತ್ತೆ ಆಯ್ಕ್, ತಿಯಾ ತುಜ್ಯಾ ಬಾಯ್ಕೊಚಿ ಮಾಟಿ ಕರ್, ತ್ಯಾ ಜಾಗ್ಯಾಚೆ ಕಿಮ್ಮತ್ ಚಾರ್ಸೆ ಚಾಂದಿಚೆ ಪೈಸೆ, ತೆ ಕಾಯ್ ಅಮ್ಚ್ಯಾ ಮದ್ದಿ ಲೈ ಕಾಯ್? ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 23:15" /><verse number="16" style="v" sid="GEN 23:16" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾನ್ ತ್ಯಾ ಜಾಗ್ಯಾಚೊ ಚಾರ್ಸೆ ಚಾಂದಿಚೆ ಪೈಸೆ ವಜನ್ ಜೊಕುನ್ ಹಿತ್ತಿಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಎಪ್ರೊನಾಕ್ ದಿಲ್ಯಾನ್, ಅನಿ ತೆಚ್ಯಾ ಬೊಲ್ನ್ಯಾಕ್ ಒಪ್ಲ್ಯಾನ್.<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />ಅಸೆ ಎಪ್ರೊನಾಚೊ ಜಾಜೊ ಮಾಮ್ರೆ ಶಾರಾಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ಮೆಕ್ಪೆಲ್ ಮನ್ತಲ್ಯಾ ಡೊಂಬಾಚ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತೆ ಸೆತ್ಬಿ ಅನಿ ಸಗ್ಳಿ ಝಾಡಾಬಿ ಅಬ್ರಾಹಾಮಾಚೊ ವಾಟೊ ಹೊಲಿ, <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />ಮಾನಾತಿ ಅಬ್ರಾಹಾಮಾಚೆ ಸ್ವತಾಚಿ ಜಿಮಿನ್ ಮನುನ್ ಹಿತ್ತಿಯಾಕ್ನಿ ಅನಿ ತ್ಯಾ ಶಾರಾಂಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ತಿರ್ಮಾನ್ ಹೊಲೆ.<verse eid="GEN 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 23:19" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾನ್ ಅಪ್ಲಿ ಬಾಯ್ಕೊ ಸಾರ್‍ಹಾಕ್ ಕಾನಾನ್ ದೆಶಾಚ್ಯಾ ಮಾಮ್ರೆಚ್ಯಾ ಮೆಕ್ಪೆಲಾಚ್ಯಾ ಸೆತಾತ್ಯಾ ಡೊಂಬಾತ್ ಮಾಟಿ ದಿಲ್ಯಾನ್. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />ಅಸೆ ಹಿತ್ತಿಯಾಂಚೊ ತೊ ಡೊಂಬ್ ಮಸನ್ಗಿಚೊ ಜಾಗೊ ಹೊವ್ನ್ ಅಬ್ರಾಹಾಮಾಕ್ ಗಾವ್ಲೊ.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">ಇಸಾಕ್ ಅನಿ ರೆಬೆಕ್ಕಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />ಅಬ್ರಾಹಾಮ್ ಲೈ ಮ್ಹಾತಾರೊ ಹೊತಾ ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತೆಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಕರಲ್ಯಾ ಕಾಮಾತ್ ಆಶಿರ್ವಾದ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />ಅಬ್ರಾಹಾಮಾಚೆ ಸಗ್ಳಿ ಆಸ್ತಿ ಬಗುನ್ ಘೆತಲೊ ಎಕ್ ಜಾಂಟೊ ಆಳ್ ರ್‍ಹಾತಾ, ಅಬ್ರಾಹಾಮ್ ತೆಕಾ ಬಲ್ವುನ್, ತುಜೊ ಹಾತ್ ಮಾಜ್ಯಾ ಜಾಂಗೆಚ್ಯಾ ಬುಡಿ ಥವ್, <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />ಜಿಮಿನ್ ಅನಿ ಮಳಬ್ ರಚಲ್ಯಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ನಾವಾನ್ ಮಾಜ್ಯಾ ಲೆಕಾ ಸಾಟ್ನಿ ಮಿಯಾ ಜಿವನ್ ಕರ್‍ತಲ್ಯಾ ಕಾನಾನ್ ದೆಶ್ಯಾತ್ನಾ ಚೆಡು ಹುಡ್ಕುನ್ ಹಾನಿನಾ ಮನುನ್ ಭಾಸ್ ದಿ, <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />ತಿಯಾ ಮಾಜ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ಡೆ ಮಟ್ಲ್ಯಾರ್ ಮಿಯಾ ಉಪಾಜಲ್ಲ್ಯಾ ಜಾಗ್ಯಾರ್ ಜಾವ್ನ್ ಮಾಜ್ಯಾ ಸಮಂಧಿಕಾತ್ನಾ ಇಸಾಕಾಕ್ ಬಾಯ್ಕೊ ಹಾನ್.<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />ತನ್ನಾ ತ್ಯಾ ಸೆವಕಾನ್, ತೆ ಚೆಡು ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಹ್ಯಾ ದೆಸಾಕ್ ಯೆಯ್ ನಸ್ಲ್ಯಾರ್, ತುಜಾ ಲೆಕಾಕ್ ತುಜ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಜಾಗ್ಯಾಕ್ ಧಾಡುಚೆ ಕಾಯ್? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />ತನ್ನಾ ಅಬ್ರಾಹಾಮಾನ್, “ನಾ, ಮಾಜ್ಯಾ ಲೆಕಾಕ್ ಪಾಟಿ ಧಾಡುನಕ್ಕೊ. <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮಾಜ್ಯಾ ಲೆಕಾಕ್ ಎಕ್ ಚೆಡು ಹುಡ್ಕುನ್ ಹಾನುಕ್ ದೆವ್ ಧುತಾಕ್ ಫಿಡೆ ದಾಡ್ತಾ, ಅನಿ ದೆವಾನ್ ಮಾಕಾ ಅನಿ ಮಾಜ್ಯಾ ಪಿಳ್ಗಿಕ್ ಹ್ಯೊ ದೆಶ್ ದಿತಾ ಮನುನ್ ಗೊಸ್ಟ್ ದಿಲಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />ಖರೆ ತೆ ಚೆಡು ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಯೆವ್ಕ್ ಮಾನಿ ನಸ್ಲ್ಯಾರ್, ತಿಯಾ ತ್ಯಾ ಆನಾತ್ನಾ ಸುಟ್ಕಾ ಹೊತೈ, ಖರೆ ತಿಯಾ ಮಾಜ್ಯಾ ಲೆಕಾಕ್ ಥೈ ಜಾಯ್ ಸಾರ್ಕೆ ಕರುನುಕ್ಕೊ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 24:9" />ತಸೆ ಹೊವ್ನ್ ತ್ಯಾ ಸೆವಕಾನ್ ಅಪ್ಲೊ ಯಜಮಾನ್ ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ಜಾಂಗೆಚ್ಯಾ ಬುಡಿ ಹಾತ್ ಥವ್ನ್ ಭಾಸ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />ಅನಿ ಅಬ್ರಾಹಾಮಾಚಿ ಧಾ ಒಂಟಿಯಾಚ್ಯಾ ವರ್‍ತಿ ಲೈ ಕಿಮ್ತತಿಚಿ ವಸ್ತಾ ವಾಂವುನ್ ನಾಹೊರ್ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾ, ಮೆಸೊಪೊಟೊಮಿಯಾ ಮನ್ತಲ್ಯಾ ಶಾರಾಕ್ ಯೆವ್ನ್ ಪಾವ್ಲೊ. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />ತೊ ಜಾವ್ನ್ ಪಾವಲ್ಲ್ಯಾ ಮಾನಾ ಶಾರಾಚ್ಯಾ ಭಾಯ್ರ್ ಹೊತ್ತ್ಯಾ ಭಾಂಯಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ಒಂಟಿಯಾಕ್ನಿ ಡೊಗ್ಲಾ ಠೆಕ್ವುಲ್ಯಾನ್, ಸಾಂಚೆಕ್ಡೆ ತ್ಯಾ ಗಾವಾತ್ಲಿ ಬಾಯ್ಕಾಮನ್ಸಾ ಭಾಂಯ್ಕ್ ಪಾನಿ ನೆವ್ಕ್ ಯೆಯ್ತ್. <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />ತನ್ನಾ ತ್ಯಾ ಸೆವಕಾನ್, ಮಾಜೊ ಯಜಮಾನ್ ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾ, ಆಜ್ ತಿಯಾ ಮಾಜ್ಯಾ ಯಜಮಾನಾಕ್ ಕರಲ್ಲೆ ಕರಾರ್ ಮಜತ್ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್, <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />ತ್ಯಾ ಶಾರಾಚಿ ಚೆಡ್ವಾ ಹ್ಯಾ ಭಾಂಯಿಕ್ ಪಾನಿಯಾಕ್ ಮನುನ್ ಯೆತಾತ್ ತನ್ನಾ ಮಿಯಾ ಹಿತ್ತೆ ಇಬೆ ರ್‍ಹಾತಾ, <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />ಮಿಯಾ ಚೆಡ್ವಾತ್ನಿ ಎಕ್ಲಿಕ್ಡೆ ದಯಾ ಕರುನ್ ಬಿಂದ್ಗೊ ಖಾಲ್ತಿ ಉತ್ರುನ್ ಪಾನಿ ದಿ ಮನುನ್ ಮಾಗ್ತಾ, ತನ್ನಾ ತಿನಿ ತಿಯಾಬಿ ಪಾನಿ ಫಿ ಅನಿ ತುಜ್ಯಾ ಒಂಟಿಯಾಕ್ನಿಬಿ ಪಾನಿ ಪಿವ್ಸು ಮಟ್ಲ್ಯಾರ್ ತಿಚ್ ಮಾಜೊ ಯಜಮಾನ್ ಇಸಾಕಾ ಸಾಟ್ನಿ ತಿಯಾ ಎಚಲ್ಲೆ ಚೆಡು, ಅಸೆ ಹೊಲ್ಯಾರ್ ಮಿಯಾ ಮಾಜ್ಯಾ ಯಜಮಾನಾಕ್ಡೆ ದಿಲ್ಲೊ ಭಾಸ್ ಫುರಾ ಹೊತಾ ಮನುನ್ ಮಾಗ್ನಿ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 24:14" /><verse number="15" style="v" sid="GEN 24:15" />ಸೆವಕ್ ಮಾಗ್ನಿ ಕರುನ್ ಸಾರುಚ್ಯಾ ಅದ್ದಿಚ್ ಅಬ್ರಾಹಾಮಾಚೊ ಭಾವ್ ನಾಹೊರ್ ಅನಿ ಮಿಲ್ಕಾಚೊ ಲೆಕ್ ಬೆತುವೆಲಾಚಿ ಲೆಕ್ ರೆಬೆಕ್ಕಾ ಖಾಂಜ್ಯಾ ವರ್‍ತಿ ಬಿಂದ್ಗೊ ಥವ್ನ್ ಘೆವ್ನ್ ಪಾನಿಯಾಕ್ ಭಾಂಯಿಕ್ಡೆ ಯೆಲಿ.<verse eid="GEN 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 24:16" />ತಿನಿ ಖಾಲ್ತಿ ಉರ್ತುನ್ ಬಿಂದ್ಗ್ಯಾತ್ ಪಾನಿ ಭರುನ್ ಘೆವ್ನ್ ಪರ್‍ತುನ್ ಯೆಲಿ, ತಿ ಲೈ ಸುಂದರ್, ದಾಂಡ್ಗಿ ಅನಿ ಲಿಂಬೆ ಚೆಡು ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />ತನ್ನಾ ತ್ಯಾ ಸೆವಕಾನ್, ತೆಚೆಕ್ಡೆ ಪಳುನ್ ಜಾವ್ನ್, “ಬಾಯಿ ದಯಾ ಕರುನ್ ಉಲ್ಲೆ ತುಜ್ಯಾ ಬಿಂದ್ಗ್ಯಾತ್ಲೆ ಪಾನಿ ಫಿವ್ಕ್ ದಿ” ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />ತನ್ನಾಚ್ ತಿನಿ ತೆಕಾ ಅಪ್ಲ್ಯಾ ಖಾಂಜ್ಯಾ ವೈಲೊ ಭರಲ್ಲೊ ಬಿಂದ್ಗೊ ಖಾಲ್ತಿ ಉತ್ರುನ್ “ಪಾನಿ ಫಿ” ಮಟ್ಲಿನ್,<verse eid="GEN 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 24:19" />ತೆನಿ ಪಾನಿ ಪಿವ್ನ್ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ತುಮ್ಚ್ಯಾ ಒಂಟ್ಯಾಕ್ನಿ ಮಿಯಾ ಪಾನಿ ಹಾನುನ್ ದಿತಾ ತೆಂಕಾ ಪಾಜೆ ತವ್ಡೆ ಫಿಂವ್ದಿತ್ ಮಟ್ಲಿನ್. <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />ಬಿಂದ್ಗ್ಯಾತ್ಲೆ ಫಿತಲೆ ಪಾನಿ ಡೊನ್ಯಾತ್ ವೊತುನ್ ಅನಿಬಿ ಪಾನಿ ಹಾನುಕ್ ಪರ್‍ತುನ್ ಗೆಲಿ, ಮಾನಾ ತಿನಿ ಲಗ್ಗುನಾ ಭಾಂಯಿಕಡೆ ಜಾವ್ನ್ ಪಾನಿ ಭರುನ್ ಸಗ್ಳ್ಯಾ ಒಂಟ್ಯಾಕ್ನಿ ಪಾನಿ ಹಾನುನ್ ಫಿವ್ಸುಲಿನ್.<verse eid="GEN 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 24:21" />ಮಾನಾ ತೊ ಗಪ್ ಇಬೆ ರ್‍ಹಾವ್ನ್ ತಿಕಾ ಬಗುನ್ಗೆತ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಪ್ಲಿ ಮಾಗ್ನಿ ಆಯ್ಕ್ಲಾ ಮನುನ್ ಕಳ್ವುನ್ ಘೆಟ್ಲ್ಯಾನ್.<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />ಒಂಟಿಯಾನಿ ಪಾನಿ ಫಿಲ್ಲ್ಯಾ ಮಾನಾ ತ್ಯಾ ಆಳಾನ್ ರೆಬೆಕ್ಕಾಕ್ ಲೈ ಕಿಮ್ತಿಚೆ ಸೊನ್ಯಾಚಿ ನಾಕಾಚಿ ಮೊತಿ, ಅನಿ ದೊನ್ ಮೊಟ್ಟಿ ಲೈ ಕಿಮ್ತಿಚಿ ಸೊನ್ಯಾಚಿ ಕಾಕ್ನಾ ಹಾತಾಕ್ನಿ ನೆಸ್ವುಲ್ಯಾನ್. <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />ಅನಿ ತಿಕಾ, ತುಮ್ಚೊ ಬಾಬಾ ಕೊನ್? ಅನಿ ತುಮ್ಚ್ಯಾ ಬಾಬಾಚ್ಯಾ ಘರ್‍ಹಾತ್ ಮಾಕಾ ರಾವ್ಕ್ ಜಾಗೊ ಹಾಯ್ ಕಾಯ್? ಮನುನ್ ಇಚಾರ್ತಾ.<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />ಮಾನಾ ರೆಬೆಕ್ಕಾನ್, ಮಾಜೊ ಬಾಬಾ ನಾಹೊರಾಚೊ ಅನಿ ಮಿಲ್ಕಾಚೊ ಲೆಕ್ ಬೆತುವೆಲ್ ಮಟ್ಲಿನ್. <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />ಅನಿ ತುಮ್ಕಾ ಅನಿ ಒಂಟಿಯಾಕ್ನಿ ರಾವ್ಕ್ ಎಗ್ಳೊ ಎಗ್ಳೊ ಜಾಗೊ ಅನಿ ಖಾವ್ಕ್ ಚಾರೊ ಹಾಯ್ ಮಟ್ಲಿನ್.<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />ಮಾನಾ ತ್ಯಾ ಸೆವಕಾನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಡಿಂಬಿಯಾ ಗಾಲುನ್ ಆರಾದನ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />ತೆನಿ ಮಾಜೊ ಯಜಮಾನ್ ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾ ತುಕಾ ಧನ್ಯವಾದ್ ತಿಯಾ ತುಜೆ ಪ್ರೆಮ್ ಅನಿ ಖರೆಪಾನ್ ತೆಚೆಕ್ನಾ ಕಾಡುಕ್ ನೈ, ಅನಿ ಮಾಜ್ಯಾ ಯಜಮಾನಾಚ್ಯಾ ಸಮಂಧಿಕಾಂಚ್ಯಾಕ್ಡೆ ನಿಟ್ ವಾಟೆನ್ ಹಾನುನ್ ಪಾವಸ್ಲೆಯ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />ಮಾನಾ ರೆಬೆಕ್ಕಾ ಪಳುನ್ಗೆತ್ ಅಪ್ಲ್ಯಾ ಬಾಯ್ಚಾ ಘರಾಕ್ ಗೆಲಿ ಅನಿ ಹೊಲ್ಲಿ ಸಂಗ್ತಿಯಾ ತೆಂಕಾ ಸಾಂಗ್ಲಿನ್. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />ಅನಿ ರೆಬೆಕ್ಕಾಕ್ ಲಾಬಾನ್ ಮನ್ತಲೊ ಭಾವ್ ಹೊತ್ತೊ, ಅನಿ ತೊ ಅಬ್ರಾಮಾಚೊ ಸೆವಕ್ ಹೊತ್ತ್ಯಾ ಭಾಂಯಿಕ್ಡೆ ಜಾವ್ಚೆ ಮನುನ್ ಭಾಯ್ರ್ ಪಳುನ್ಗೆತ್ ಯೆಲೊ. <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />ಅನಿ ಲಾಬಾನಾನ್ ಭೆನಿಚ್ಯಾ ನಾಕಾತ್ಲಿ ಮೊತಿ ಅನಿ ಹಾತಾಂತ್ಲಿ ಕಾಕ್ನಾ ಬಗಟಲ್ಲ್ಯಾನ್, ಅನಿ ಒಂಟಿಯಾ ಘೆವ್ನ್ ಭಾಂಯಿಕಡೆ ಇಬೆ ಹೊತ್ತ್ಯಾ ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ಸೆವಕಾಚ್ಯಾ ವಿಶಯಾತ್ ಆಯ್ಕಲ್ಲ್ಯಾನ್ ಅನಿ ತೆಜ್ಯಾಕ್ಡೆ ಜಾವ್ನ್ ಪಾವ್ಲೊ. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />ತೆಕಾ ಬಗುನ್ ಲಾಬಾನಾನ್, ಸರ್ವೆಸ್ಪರಾಚೆ ಆಶಿರ್ವಾದ್ ಘೆಟಲ್ಯಾ ತಿಯಾ ಕಶ್ಯಾಕ್ ಇಬೆ ಹಾಸ್? ಮಿಯಾ ಮಾಜ್ಯಾ ಘರ್‍ಹಾತ್ ತುಜ್ಯಾ ಸಾಟ್ನಿ ಮನುನ್ ರಾವ್ಕ್ ಎಕ್ ಖೊಲಿ ತಯಾರ್ ಕರ್ಲಾ ಅನಿ ತುಜ್ಯಾ ಒಂಟಿಯಾಕ್ನಿಬಿ ಥೈ ಜಾಗೊ ಹಾಯ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />ತನ್ನಾ ಲಾಬಾನಾಚ್ಯಾ ಘರಾಕ್ ಸೆವಕ್ ಗೆಲೊ, ಅನಿ ಒಂಟ್ಯಾ ವೈಲಿ ಪೊಟ್ಲಿಯಾ ಉತ್ರುಕ್ ಲಾಬಾನಾನ್ ಮಜತ್ ಕರ್ಲ್ಯಾನ್; ಅನಿ ತ್ಯಾ ಒಂಟಿಯಾಕ್ನಿ ಚಾರೊ ಘಾಟ್ಲ್ಯಾನ್, ಅನಿ ಮಾನಾ ತ್ಯಾ ಸೆವಕಾಕ್ ಅನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತ್ಯಾಕ್ನಿ ಪಾಯ್ ಧುವ್ಕ್ ಪಾನಿ ಹಾನುನ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />ಮಾನಾ ಲಾಬಾನ್ ತ್ಯಾ ಸೆವಕಾಕ್ ಜೆವಾನ್ ವಾಡುಚೆ ಮನುನ್ ಗೆಲ್ಯಾರ್, ತ್ಯಾ ಸೆವಕಾನ್ ಮಿಯಾ ಖಲ್ಯಾ ಕಾಮಾನ್ ಯೆಲಾ ಮನುನ್ ತುಮ್ಕಾ ಸಾಂಗ್ಲ್ಯಾ ಶಿವಾಯ್ ಜೆವಾನ್ ಕರಿನಾ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್, ತನ್ನಾ ಲಾಬಾನಾನ್ ತೆಕಾ ಕಾಯ್ ತೆ ಸಾಂಗ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />ತೆನಿ ಕಾಯ್ ಸಾಂಗ್ಲ್ಯಾನ್ ಮಟ್ಲ್ಯಾರ್, ಮಿಯಾ ಅಬ್ರಾಹಾಮಾಚೊ ಸೆವಕ್,<verse eid="GEN 24:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 24:35" />ಅನಿ ಮಾಜ್ಯಾ ಯಜಮಾನಾಕ್ ಆಶಿರ್ವಾದ್ ಕರುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಲೈ ಸಾವ್ಕಾರ್ ಕರ್ಲಾ, ಅನಿ ತೆಚೆಕ್ಡೆ ಗೊರಾಂಚೆ, ಬಕ್ರ್ಯಾಂಚೆ ಶೆಳಿಯಾಂಚೆ ತಾಂಡೆ, ಸೊನೆ ರುಪೆ, ಗಾಡ್ವಾ ಅನಿ ಒಂಟಿಯಾ ಸೆವಕಾ ಅನಿ ಸೆವಕಿಯಾ ದಿಲಾ. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />ಅನಿ ತೆಜಾ ಬಾಯ್ಕೊಕ್ ಮಾತ್ಯಾರಾ ವಯ್ಯಾತ್ ಎಕ್ ಲೆಕ್ ದಿಲಾ, ತೆಚಿ ಆಸ್ತಿ ಫುರಾ ತ್ಯಾ ಲೆಕಾಚ್ಯಾ ನಾವಾರ್ ಕರುನ್ ದಿಲಾ, <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />ಅಸಿ ರ್‍ಹಾತಾನಾ ಮಾಜ್ಯಾ ಯಜಮಾನಾನ್ ತೆಚ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಕಾನಾನ್ ದೆಸಾಕ್ ಜಾವ್ನ್ ಅಪ್ಲ್ಯಾ ಲೆಕಾಕ್ ಎಕ್ ಚೆಡು ಹುಡ್ಕುನ್ ಹಾನುನಕ್ಕೊ ಮನುನ್ ಗೊಸ್ಟ್ ದಿಲಾ, <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />ಅನಿ ತೆಚ್ಯಾ ಸಮಂದಿಕಾಂಚ್ಯಾಕ್ನಾ ಎಚುನ್ ಚೆಡು ಹಾನುಚೆ ಮನುನ್ ಮಾಜ್ಯಾಕ್ಡೆ ಭಾಸ್ ಘೆಟ್ಲಾ. <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />ಅನಿ ಮಿಯಾ ತೆ ಚೆಡು ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಯೆಯ್ನಾ ಹೊಲ್ಯಾ ಕಾಯ್ ಕರುಚೆ? ಮಟಲ್ಲೊ, <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />ತನ್ನಾ ಯಜಮಾನಾನ್ ಮಾಕಾ, ಮಿಯಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಖಾಲ್ತಿ ಹೊವ್ನ್ ಚಲ್ತಲೊ ಮಾನುಸ್ ತಸೆ ಹೊವ್ನ್ ಅಪ್ಲೆ ಕಾಮ್ ಪುರಾ ಹೊವ್ಕ್ ಅಪ್ಲ್ಯಾ ಧುತಾಕ್ ಫಿಡೆ ಧಾಡ್ತಾ, ಅನಿ ಮಾಜ್ಯಾ ಲೆಕಾಕ್ ಮಾಜ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಲೊಕಾತ್ನಿ ಚೆಡು ಗಾಯ್ ಸಾರ್ಕೆ ಕರುನ್ ತುಜೆ ಕಾಮ್ ಫುರಾ ಕರ್ತಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />ಅನಿ ಲೆಕಾಕ್ ಮಾಜ್ಯಾ ಬಾಬಾಚ್ಯಾ ಗಾಂವಾತ್ ಜೆಡು ದಿವ್ಕ್ ತೆನಿ ಮನ್ ಕರಿನಸಲ್ಯಾರ್ ತಿಯಾ ಕರಲ್ಯಾ ಭಾಸಾತ್ನಾ ಸುಟ್ಕಾ ಹೊತೆ.<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />ತನ್ನಾ “ಮಾಜ್ಯಾ ಯಜಮಾನಾಚೊ ದೆವ್ ಹೊಲ್ಲ್ಯಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾ ದಯಾ ಕರುನ್ ಮಿಯಾ ಕರಲ್ಯಾ ತರಾಸಾಕ್ ಬರೆ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ ಮನುನ್ ಹ್ಯಾ ಭಾಂಯಿಕ್ಡೆ ಯೆವ್ನ್ ಇಬೆ ಹೊತ್ತೊ”. <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />ತನ್ನಾ ಮಿಯಾ ಹಿತ್ತೆ ಪಾನಿ ನೆವ್ಕ್ ಯೆತಲ್ಯಾ ಚೆಡ್ವಾ ಸಾಟ್ನಿ ಮನುನ್ ರಾಕಿತ್ ರ್‍ಹಾತಾ, ಮಾನಾ ತಿಕಾ ದಯಾ ಕರುನ್ “ಮಾಕಾ ಫಿವ್ಕ್ ಉಲ್ಲೆ ಬಿಂದ್ಗ್ಯಾತ್ಲೆ ಪಾನಿ ದಿ” ಮನುನ್ ಮಾಗ್ತಾ. <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />ಮಾನಾ ತಿನಿ ಮಾಕಾ ಅನಿ ಮಾಜ್ಯಾ ಒಂಟಿಯಾಕ್ನಿ ಪಾನಿ ದಿತಾ ಮಾಟ್ಲ್ಯಾರ್, ತಿ ಮಾಜ್ಯಾ ಯಜಮಾನಾಚ್ಯಾ ಲೆಕಾಕ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ನೆಮಲ್ಲೆ ಚೆಡು ಹೊಂವ್ದಿ ಮಟ್ಲೊ. <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />ಅಸಿ ಮಿಯಾ ಮಾಜ್ಯಾ ಮನಾತ್ ಮಾಗ್ನಿ ಕರುನ್ ಸಾರುಚ್ಯಾ ಅದ್ದಿಚ್, ತಿಕುನಾ ಪಾನಿಯಾಕ್ ಮನುನ್ ರೆಬೆಕ್ಕಾ ಭಾಂಯಿಕ್ ಬಿಂದ್ಗೊ ಘೆವ್ನ್ ಯೆತಾನಾ ಮಿಯಾ ತಿಕಾ, ಮಾಕಾ ಫಿವ್ಕ್ ಉಲ್ಲೆ ಪಾನಿ ದಿ ಮಟ್ಲೊ. <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />ತನ್ನಾ ತಿನಿ ತಾಬೊಡ್ತೊಬ್ ಖಾಂಜಾ ವೈನಾ ಭರಲ್ಲಿ ಘಾಗರ್ ಉತ್ರುನ್ : ಪಾನಿ ಫಿವಾ ಅನಿ ತುಮ್ಚ್ಯಾ ಒಂಟಿಯಾಕ್ನಿ ಫಿವ್ಕ್ ಮಿಯಾ ಹಾನುನ್ ದಿತಾ ಮಟ್ಲಿನ್ ಮಾನಾ ಮಿಯಾ ಪಾನಿ ಫಿಲೊ ತಿನಿ ಮಾಜ್ಯಾ ಒಂಟಿಯಾಕ್ನಿ ಪಾನಿ ಹಾನುನ್ ಪಾಜ್ವುಲಿನ್. <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />ಮಾನಾ ಮಿಯಾ ತಿಕಾ: ತಿಯಾ ಕೊನಾಚಿ ಲೆಕ್ ಮನುನ್ ಇಚಾರ್ಲೊ, ತನ್ನಾ ತಿನಿ ಮಿಯಾ ನಾಹೊರ್ ಅನಿ ಮಿಲ್ಕಾಚೊ ಲೆಕ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಬೆತುವೆಲಾಚಿ ಲೆಕ್ ಮಟ್ಲಿನ್, ಮಾನಾ ಮಿಯಾ ತಿಕಾ ನಾಕಾತ್ಲಿ ಮೊತಿ ಅನಿ ತೊಳ್ ಭಂದಿಯಾ ನೆಸ್ವುಲೊ. <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />ಮಾನಾ ಮಿಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಡಿಂಬಿಯಾ ಘಾಲುನ್ ಆರಾದನ್ ಕರ್‍ಲೊ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತೆನಿ ಮಾಕಾ ಸಮಾ ಜಾಗ್ಯಾಕ್ ಹಾನುನ್ ಪಾವ್ಲ್ಯಾನ್, ಮಾಜ್ಯಾ ಯಜಮಾನಾಚ್ಯಾ ಸಂಮದಿಕಾಂಚೆ ಚೆಡು ತೆಚ್ಯಾ ಲೆಕಾಕ್ ಹುಡ್ಕುನ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />ಅಸಿ ರ್‍ಹಾತಾನಾ ಮಾಜ್ಯಾ ಯಜಮಾನಾಚ್ಯಾ ವಿಶಯಾತ್ ಪ್ರೆಮ್ ಅನಿ ಭರೊಸೊ ರಾಲ್ಯಾರ್ ಮಾಕಾ ಸಾಂಗಾ, ನಾ ಹೊಲ್ಯಾರ್ ನಾ ಮನುನ್ ಸಾಂಗಾ, ಮಿಯಾ ಫಿಡೆ ಕಾಯ್ ಕರುಚೆ ಚಿಂತ್ತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />ತನ್ನಾ ಲಾಬಾನಾನ್ ಅನಿ ಬೆತುವೆಲಾನ್ ತೆಕಾ, ಹೆ ಸಗ್ಳೆ ಸರ್ವೆಸ್ಪರಾಕ್ನಾ ಯೆಲ್ಲೆ ಹಾಯ್; ಅಮಿ ನಿರ್ದಾರ್ ಘೆವ್ಕ್ ಹೊಯ್ನಾ. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />ಅಮಿ ರೆಬೆಕ್ಕಾಕ್ ತುಮ್ಚ್ಯಾ ಅಧಿನಾತ್ ದಿತಾಂವ್; ಬಲ್ವುನ್ ಘೆವ್ನ್ ಜಾ; ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತಿ ತುಜ್ಯಾ ಯಜಮಾನಾಚ್ಯಾ ಲೆಕಾಚಿ ಬಾಯ್ಕೊ ಹೊಂವ್ದಿತ್ ಮಟ್ಲ್ಯಾನಿ. <verse eid="GEN 24:51" /><verse number="52" style="v" sid="GEN 24:52" />ಮಾನಾ ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ಸೆವಕಾನ್ ತೆನಿ ಸಾಂಗಲಿ ಗೊಸ್ಟಿಯಾ ಆಯ್ಕುನ್ ಮಾನ್ ಬಾಗ್ವುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಆರಾದನ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />ಮಾನಾ ತ್ಯಾ ಸೆವಕಾನ್ ಅಪ್ಲಿ ಹಾನಲ್ಲೆ ಆಯಾರಾ ಅನಿ ತಿಕಾ ಸೊನೆ ಚಾಂದಿ ಅನಿ ಕಿಮ್ತಿತಿಚಿ ಕಪ್ಡೆ ರೆಬೆಕ್ಕಾಕ್ ದಿಲ್ಯಾನ್, ಅನಿ ತೆನಿ ರೆಬೆಕ್ಕಾಚ್ಯಾ ಬಾಯ್ಕ್ ಅನಿ ಭಾವಾಕ್ ಲೈ ಕಿಮ್ತಿತಿಚಿ ಆಯಾರಾ ದಿಲ್ಯಾನ್.<verse eid="GEN 24:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="GEN 24:54" />ಮಾನಾ ತ್ಯಾ ಸೆವಕಾನ್ ಅನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತ್ಯಾನಿ ಜೆವಾನ್ ಕರುನ್ ಥೈ ರಾಲ್ಯಾನಿ, ಮಾನಾ ದುಸ್ರೆ ದಿಸಿ ಸಕ್ಕಾಳಿ ಉಟುನ್ “ಅಮಿ ಅತ್ತಾ ಅಮ್ಚ್ಯಾ ಯಜಮಾನಾಕ್ಡೆ ಪರ್‍ತುನ್ ಜಾತಾಂವ್” ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />ಖರೆ ರೆಬೆಕ್ಕಾಚ್ಯಾ ಬಾಯ್ನ್ ಅನಿ ಭಾವಾನ್ ತೆಕಾ, “ರೆಬೆಕ್ಕಾ ಅನಿ ಧಾ ದಿಸಾ ತರಿಬಿ ಅಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ರಾಂವ್ದಿತ್, ಮಾನಾ ತಿಕಾ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಜಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನಿ.<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />ಖರೆ ತ್ಯಾ ಸೆವಕಾನ್ ತೆಂಕಾ, ಮಾಕಾ ಅಡ್ವುನಕಾಶಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾಜೊ ಪ್ರಯಾನ್ ಬರೊ ಕರ್ಲಾ ಅತ್ತಾ ಮಿಯಾ ಯಜಮಾನಾಕ್ಡೆ ಪರ್‍ತುನ್ ಜಾವ್ಚೆ.<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />ಮಾನಾ ತಿಚ್ಯಾ ಭಾವಾನ್ ಅನಿ ಬಾಯ್ನ್ ತೆಕಾ, “ಅಮಿ ತಿಚ್ಯಾ ಮನಾತ್ ಕಾಯ್ ಹಾಯ್ ಮನುನ್ ಇಚಾರ್ತಾಂವ್”. <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />ತೆನಿ ರೆಬೆಕ್ಕಾಕ್ ಬಲ್ವುನ್, ತುಕಾ ತ್ಯಾ ಮಾನ್ಸಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಜಾತಲೊ ಮನ್ ಹಾಯ್ ಕಾಯ್? ತನ್ನಾ ರೆಬೆಕ್ಕಾನ್ “ಹೊಯ್ ಮನ್ ಹಾಯ್”, ಮಟ್ಲಿನ್.<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />ಮನಾ ತೆನಿ ರೆಬೆಕ್ಕಾಕ್ ಅನಿ ತಿಜಿ ಸೆವಕಿಕ್ ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ಆಳಾ ವಾಂಗ್ಡಾ ಧಾಡುನ್ ದಿಲ್ಯಾನಿ. <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />ರೆಬೆಕ್ಕಾ ಜಾವ್ಕ್ ತಯಾರ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ,</para>
  <para style="q1" vid="GEN 24:60">ತಿಚ್ಯಾ ಭಾವಾನ್ ತಿಕಾ, “ಮಾಜ್ಯಾ ಭೆನಿ ತಿಯಾ ಹಜಾರಾನ್ ಹಜಾರ್ ಲೊಕಾಂಕ್ನಿ ಮುಳಾಚಿ ಬಾಯ್ ಹೊವ್ನ್ ರಾ,</para>
  <para style="q2" vid="GEN 24:60">ತುಮ್ಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಯೆತಲ್ಯಾಕ್ನಿ ತುಜ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ ಮಾರುಂದಿತ್, ಅನಿ ತೆಂಚಿ ಶಾರಾ ಅಪ್ನಾಚಿ ಕರುನ್ ಘೆವ್ನಂದಿ”, ಮನುನ್ ಆಶಿರ್ವಾದ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 24:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />ಮಾನಾ ರೆಬೆಕ್ಕಾ ಅನಿ ತಿಚಿ ಆಳ್ ದೊಗೆಬಿ ಒಂಟಿಯಾ ಚಡುನ್ ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ಸೆವಕಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಜಾವ್ಕ್ ಲಾಲೆ.<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />ತನ್ನಾ ಇಸಾಕ್ ಕಾನಾನಾಚ್ಯಾ ದಕ್ಷಿನ್ ಭಾಜುಕ್ ವಸ್ತಿ ಹೊತ್ತೊ ಅನಿ ಲೆಹೈರೊಹಿ ಭಾಂಯಿಕ್ನಾಚಲುನ್ ಯೆಯ್ತ್ ಹೊತ್ತೊ. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />ಇಸಾಕ್ ಸಾಂಚೆಕ್ಡೆ ಸೆತಾಕ್ಡೆ ಫಿರುನ್ ಗೆಲ್ಲ್ಯಾ ತನ್ನಾ ತೆಕಾ ಲೈ ಧುರ್ನಾ ಒಂಟಿಯಾ ಯೆತಲಿ ದಿಸ್ಲಿ. <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />ತನ್ನಾ ರೆಬೆಕ್ಕಾನ್ ಇಸಾಕಾಕ್ ಬಗುನ್ ತಿ ಒಂಟಿಚ್ಯಾ ವೈನಾ ಉತ್ರುನ್ ಯೆವ್ನ್, <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />ಮಾಕಾ ಭೆಟುಕ್ ಮನುನ್ ತ್ಯಾ ಸೆತಾತ್ನಾ ಯೆವ್ ಲಾಗಲ್ಲೊ ಮಾನುಸ್ ಕೊನ್? ಮನುನ್ ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ಆಳಾಕ್ ಇಚಾರ್ಲಿನ್.</para>
  <para style="p" vid="GEN 24:65">ತನ್ನಾ ತ್ಯಾ ಆಳಾನ್ “ತೊ ಮಾಜ್ಯಾ ಯಜಮಾನಾಚೊ ಲೆಕ್” ಮಟ್ಲ್ಯಾನ್, ತನ್ನಾ ರೆಬೆಕ್ಕಾನ್ ತೊಂಡಾ ವೈಲೆ ಮುಸ್ಕೆ ಧಾಪುನ್ ಘೆಟ್ಲಿನ್.<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />ಮಾನಾ ಆಳಾನ್ ಸಗ್ಳಿ ಅಪ್ನಿ ಕರಲ್ಲಿ ಕಾಮಾ ಇಸಾಕಾಕ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 24:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="GEN 24:67" />ಮಾನಾ ಇಸಾಕಾನ್ ರೆಬೆಕ್ಕಾಕ್ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಅಪ್ನಾಚ್ಯಾ ಬಾಯ್ಚ್ಯಾ ಝೊಪ್ಡ್ಯಾತ್ ಗೆಲೊ. ತನ್ನಾಚ್ಯಾನ್ ರೆಬೆಕ್ಕಾ ಇಸಾಕಾಚಿ ಬಾಯ್ಕೊ ಹೊಲಿ, ಅನಿ ತೆನಿ ರೆಬೆಕ್ಕಾಕ್ ಲೈ ಪ್ರೆಮ್ ಕರ್ಲ್ಯಾನ್, ಅಪ್ಲಿ ಬಾಯ್ ಮರಲ್ಲೆ ದುಕ್ಕ್ ತಿಚೆ ವೈನಾ ಇಸರ್ಲ್ಯಾನ್.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">ಅಬ್ರಾಹಾಮಾಚಿ ಅನಿಎಕ್ ಪಿಳ್ಗಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />ಅಬ್ರಾಹಾಮಾನ್ ಕೆತುರಾ ಮನ್ತಲಿ ಅನಿ ಎಕ್ ಬಾಯ್ಕೊಕ್ ಲಗಿನ್ ಕರುನ್ ಘೆಟ್ಲ್ಯಾನ್. <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />ತಿಚ್ಯಾ ವೈನಾ ಜಿಮ್ರಾನ್, ಜೊಕ್ಷಾನ್, ಮೆದಾನ್, ಮಿಡಿಯಾನ್, ಇಶ್ಬಾಕ್ ಅನಿ ಶುಹಾ ಮನ್ತಲ್ಯಾ ಪೊರಾಕ್ನಿ ಜಲಮ್ ದಿಲಿನ್. <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />ಜೊಕ್ಷಾನಾಕ್ ಸೆಬಾ ಅನಿ ದೆದಾನಾಂಚೊ ಬಾಬಾ, ಅನಿ ದೆದಾನಾಚ್ಯಾ ಪಿಳ್ಗಿಚೆ, ಅಶ್ಯುರ್ಯಾನಿ ಲೆಟುಶ್ಯಾನಿ, ಅನಿ ಲೆಯಮ್ಯಾನಿ. <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />ಮಿದ್ಯಾನಾಚಿ ಲೆಕಾ ಗೆಫಾ, ಗೆಫರ್, ಹನೊಕ್ ಅಬಿದಾ, ಎಲ್ದಾವ್ ಹೆನಿ ಸಗ್ಳೆ ಕೆತುರಾ ಮನ್ತಲಿಚಿ ಪಿಳ್ಗಿ.<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />ಖರೆ ಅಬ್ರಾಹಾಮಾನ್ ಅಪ್ನಾಚಿ ಸಗ್ಳಿ ಆಸ್ತಿ ಇಸಾಕಾಕ್ ದಿಲ್ಯಾನ್,<verse eid="GEN 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 25:6" />ಅಪ್ನಾಕ್ ಹೊತ್ತ್ಯಾ ಹುರಲ್ಯಾ ಬಾಯ್ಕಾಂಚ್ಯಾ ಪೊರಾಕ್ನಿ ಅಬ್ರಾಹಾಮಾನ್ ವಾಟೆ ಕರುನ್ ದಿವ್ನ್ ಅಪ್ನಿ ಜಿವಾನಿ ರ್‍ಹಾತಾನಾಚ್ ತೆಂಕಾ ಅಪ್ಲೊ ಲೆಕ್ ಇಸಾಕಾಚ್ಯಾ ಜಗ್ಗೊಳ್ನಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಧಾಡುನ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 25:6" /></para>
  <para style="s">ಅಬ್ರಾಹಾಮಾಚೆ ಮರಾನ್ ಅನಿ ಮಾಟಿ</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />ಅಬ್ರಾಹಾಮ್ ಎಕ್ಸೆ ಸತ್ತರಾರ್ ಪಾಂಚ್ ವರಿಸ್ ಝಿತ್ತೊ ರ್‍ಹಾವ್ನ್ ಫುರಾ ಆಯ್ಸ್ ಭರುನ್ ಮರುನ್ ಗೆಲೊ. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />ತೆನಿ ಫುರಾ ಆಯ್ಸ್ ಭರುನ್ ಮ್ಹಾತಾರೊ ಹೊವ್ನ್ ಪ್ರಾನ್ ಸೊಡ್ಲ್ಯಾನ್ ಅನಿ ಅಪ್ನಾಚ್ಯಾ ಪುರ್ವಜಾಂಚ್ಯಾಕ್ಡೆ ಜಾವ್ನ್ ಮಿಳ್ಳೊ. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />ತೆಚಿ ಲೆಕಾ ಇಸಾಕ್ ಅನಿ ಇಸ್ಮಾಯೆಲಾನ್ ಮಾಮ್ರೆಕ್ ಜಗ್ಗೊಳ್ ಹೊತ್ತ್ಯಾ ಮಕ್ಬೆಲಾಚ್ಯಾ ಡೊಂಬಾತ್ ಹಿತ್ತಿಯಾ ಹಾಗಾರಾಂಚೊ ಲೆಕ್ ಎಪ್ರೊನಾಚ್ಯಾ ಜಾಗ್ಯಾರ್ ಮಾಟಿ ದಿಲ್ಯಾನಿ. <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />ತೊ ಜಾಗೊ ಅಬ್ರಾಹಾಮಾನ್ ಹಿತ್ತಿಯಾಂಚ್ಯಾಕ್ನಾ ಇಕಾತ್ ಘೆಟಲ್ಯಾನ್; ತ್ಯಾತುರ್ ಅಬ್ರಾಹಾಮಾಕ್ ಅನಿ ತೆಚ್ಯಾ ಬಾಯ್ಕೊಕ್ ಮಾಟಿ ದಿಲ್ಯಾನಿ. <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />ಅಬ್ರಾಹಾಮ್ ಮರುನ್ ಗೆಲ್ಲ್ಯಾ ಮಾನಾ ದೆವಾಚೊ ಆಶಿರ್ವಾದ್ ತೆಜೊ ಲೆಕ್ ಇಸಾಕಾಕ್ ಗಾವ್ಲೆ, ತೊ ಬೆರ್ ಲಹೈರೊಯಿ ಮನ್ತಲ್ಯಾ ಭಾಂಯಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ವಸ್ತಿ ಹೊತ್ತೊ.<verse eid="GEN 25:11" /></para>
  <para style="s">ಇಸ್ಮಾಯೆಲಾಚಿ ಪಿಳ್ಗಿ</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />ಅಬ್ರಾಹಾಮಾಕ್ ಸಾರಾಚಿ ಆಳ್ ಇಜಿಪ್ತಾಚಿ ಹಾಗರಾಕ್ ಉಪಾಜಲ್ಲ್ಯಾ ಇಸ್ಮಾಯೆಲಾಚಿ ಪಿಳ್ಗಿ, <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />ಇಸ್ಮಾಯೆಲಾಚ್ಯಾ ಪೊರಾಕ್ನಿ ಅನಿ ತೆಂಚ್ಯಾಕ್ನಾ ಉಪಾಜಲ್ಲ್ಯಾ ಘರಾನ್ಯಾಕ್ನಿ ಥವಲ್ಲಿ ನಾವಾ ಹಿಚ್, ಎಕ್ವೆ ಉಪಾಜಲ್ಲೊ ನೆಬಾಯೊತ್, ಮಾನಾ ಉಪಾಜಲ್ಲೊ ಕೆದಾರ್, ಅದ್ಬಯೆಲ್, ಮಿಬ್ಸಾಬ್, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />ಮಿಸ್ಮಾ, ದುಮಾ, ಮಸ್ಸಾ, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />ಹದದ್, ತೆಮಾ, ಯಟುರ್, ನಾಪಿಸ್ ಅನಿ ಕೆದ್ಮಾ ಮನ್ತಲೊ. <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />ಹೆನಿಚ್ ತೆ ಬಾರಾ ಘರಾನಾಂಚೆ ವಾಡ್ ವಡಿಲಾ, ಹಿ ಹೆನಿ ವಸ್ತಿ ಹೊತ್ತ್ಯಾ ಜಾಗ್ಯಾಕ್ನಿ ಅನಿ ಗಾವಾಕ್ನಿ ಥವಲ್ಲ್ಯಾನಿ. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />ಇಸ್ಮಾಯೆಲ್ ಎಕ್ಸೆ ತಿಸಾರ್ ಸಾತ್ ವರಿಸ್ ಝಿತ್ತೊ ರ್‍ಹಾವ್ನ್ ಮರ್ಲೊ ಅನಿ ಅಪ್ಲ್ಯಾ ಪುರ್ವಜ್ಯಾಂಚ್ಯಾಕ್ಡೆ ಪಾವ್ಲೊ. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />ಇಸ್ಮಾಯೆಲಾನಿ ಹವಿಲ್ ಮನ್ತಲ್ಯಾ ಅನಿ ಶುರ್ ಮನ್ತಲ್ಯಾ ಗಾವಾಂಚ್ಯಾ ಮದ್ದಿ ಹೊತ್ತ್ಯಾ ಪ್ರದೆಶ್ಯಾತ್ನಿ ವಸ್ತಿ ರಾಲ್ಯಾನಿ, ಶುರ್ ಮನ್ತಲೆ ಇಜಿಪ್ತಾಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಅಶಿರ್ಯಾಕ್ ಜಾತಲ್ಯಾ ವಾಟೆಕ್ ಹಾಯ್, ಅಸೆ ಇಸ್ಮಾಯೆಲ್ ಲೊಕಾ ಅಪ್ಲ್ಯಾ ಸಮಂದಿಕಾಕ್ನಿ ಎಗ್ಳೆ ಎಗ್ಳೆ ವಸ್ತಿ ರಾಲ್ಯಾನಿ.<verse eid="GEN 25:18" /></para>
  <para style="s">ಎಸಾವ್ ಅನಿ ಜಾಕೊಬಾಚೊ ಜಲ್ಮ</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />ಅಬ್ರಾಹಾಮಾಚೊ ಲೆಕ್ ಇಸಾಕಾಚಿ ವಂಶಾವಳಿ; ಅಬ್ರಾಹಾಮಾಕ್ ಇಸಾಕ್ ಉಪಜ್ಲೊ, <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />ಇಸಾಕಾಕ್ ಚಾಳಿಸ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಆರಾಮ್ಯಾಂಚೊ ಬೆತುವೆಲಾಚಿ ಲೆಕ್ ಅನಿ ಲಾಬಾನಾಚಿ ಭೆನ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ರೆಬೆಕ್ಕಾಕ್ ಮೆಸಪೊಟೆಮಿಯಾಕ್ನಾ ಬಲ್ವುನ್ ಹಾನುನ್ ಲಗಿನ್ ಹೊಲ್ಯಾನ್. <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />ರೆಬೆಕ್ಕಾಕ್ ಪೊರಾ ಹೊವ್ಕ್ ನಸಲಿ, ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತಿಜಿ ಮಾಗ್ನಿ ಆಯ್ಕ್ಲ್ಯಾನ್ ಅನಿ ರೆಬೆಕ್ಕಾ ಪೊಟಾನ್ ರಾಲಿ. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />ತಿಚ್ಯಾ ಗರ್ಬಾತ್ಲ್ಯಾ ಅವ್ಳಿ ಜವ್ಳಿ ಪೊರಾನಿ ಎಕಾಮೆಕಾಕ್ ಲಾತ್ ಮಾರುನ್ಗೆತಾನಾ, “ತಿನೆ ಮಾಕಾ ಅಸೆ ಕಶ್ಯಾಕ್ ಹೊವ್ಲಾ?” ಮನುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಇಚಾರ್ಲಿನ್. <verse eid="GEN 25:22" /><verse number="23" style="v" sid="GEN 25:23" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್, ತಿಕಾ</para>
  <para style="q1" vid="GEN 25:23">“ತುಜ್ಯಾ ಪೊಟಾತ್ ದೊನ್ ಜನಾಂಗಾಚಿ ಲೊಕಾ ಹಾತ್ ತುಜ್ಯಾ ಗರ್ಬಾತ್ನಾಚ್ ದೊನ್ ನಮುನ್ಯಾಚಿ ಲೊಕಾ ಯೆಗಳ್ತಾತ್,</para>
  <para style="q2" vid="GEN 25:23">ಯೆಕ್ ನಮುನ್ಯಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕಿಂತಾಬಿ ಅನಿ ಎಕ್ ಬಲಿಸ್ಟ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಅನಿ</para>
  <para style="q2" vid="GEN 25:23">ಯೆವ್ಡೆಚ್ ನಸ್ತಾನಾ ಥೊರ್ಲೊ ಧಾಕ್ಲ್ಯಾಚಿ ಸೆವಾ ಕರ್ತಾ ಮನುನ್” ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />ಮೈನೆ ಭರಲ್ಯಾ ತನ್ನಾ ರೆಬೆಕಾಕ್ ಅವ್ಳಿ ಜವ್ಳಿ ಪೊರಾ ಉಪಜ್ಲಿ. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />ಪೈಲೆಚೆ ಪೊರ್ ತಾಂಬ್ಡೆ ಅನಿ ಆಂಗ್ಬರ್ ಕೆಸಾ ಹೊತ್ತೆ ಹೊವ್ನ್ ಉಪಾಜ್ತಾನಾ ತೆಕಾ ಎಸಾವ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನಿ. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />ಮಾನಾ ದೊನ್ವೊ ಲೆಕ್ ಎಸಾವಾಚೊ ಪಾಯ್ ಧರುನ್ಘೆವ್ನ್ ಉಪಜ್ಲೊ, ತೆಕಾ ಜಾಕೊಬ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನಿ, ಹೆನಿ ಉಪಾಜ್ತಾನಾ ಇಸಾಕಾಕ್ ಸಾಟ್ ವರಿಸ್ ಹೊಲ್ಲೆ.<verse eid="GEN 25:26" /></para>
  <para style="s">ಎಸಾವಾನ್ ಅಪ್ಲೊ ಥೊರ್ಲ್ಯಾ ಲೆಕಾಚೊ ಹಕ್ಕ್ ಇಕಲ್ಲೆ</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />ತೆ ದೊನೊ ಝಿಲ್ಗೆ ಮೊಟೆ ಹೊಲೆ ಎಸಾವ್ ಡಂಗ್ಳಿತ್ನಿ ರಾತಲೊ ಅನಿ ಲೈ ಹುಶ್ಯಾರ್ ಶಿಕಾರಿಕಾರ್ ಹೊಲೊ, ಜಾಕೊಬ್ ಲೈ ಸಾದೊ ಮಾನುಸ್ ಹೊಲೊ ಅನಿ ತೊ ಝೊಪ್ಡ್ಯಾತ್ನಿ ವಸ್ತಿ ರ್‍ಹಾಯ್. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />ಇಸಾಕಾಕ್ ಶಿಕಾರಿ ಕರಲೆ ಮಾಸ್ ಖಾತಲೆ ಲೈ ಮನ್ ರ್‍ಹಾತಾ; ತಸೆ ಹೊವ್ನ್ ತೊ ಎಸಾವಾಕ್ ಲೈ ಪ್ರೆಮ್ ಕರ್ತಾ, ಅನಿ ರೆಬೆಕ್ಕಾಕ್ ಜಾಕೊಬಾಚೆರ್ ಲೈ ಪ್ರೆಮ್.<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />ಎಗ್ದಾ ಎಸಾವ್ ಡಂಗ್ಳಿಕ್ನಾ ಲೈ ಫಿರೆ ಹೊವ್ನ್ ಯೆಲ್ಲೊ ತನ್ನಾ ಜಾಕೊಬ್ ರಾಂದುನ್ಗೆತ್ ಹೊತ್ತೊ,<verse eid="GEN 25:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 25:30" />ತನ್ನಾ ಮಾಕಾ ಲೈ ಫಿರೆ ಹೊಲಾ, ತೆ ತಾಂಬ್ಡೆ ರುಚ್ ಹೊತ್ತೆ ಖಾತಲೆ ಮಾಕಾ ಖಾವ್ಕ್ ದಿ ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ, ತೆಚ್ಯಾ ವೈನಾ ಇಸಾವಾಕ್ ಎದೊಮ್ ಮನುನ್ ನಾವ್ ಯೆಲೆ.<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />ತನ್ನಾ ಜಾಕೊಬಾನ್ ತುಜೆ ಥೊರ್ಲೆಪಾನಾಚೆ ಹಕ್ಕ್ ಮಾಕಾ ಇಕಾತ್ ದಿ, ತನ್ನಾ ಮಿಯಾ ತುಕಾ ಖಾತಲೆ ದಿತಾ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />ಎಸಾವಾನ್, “ಹಾ ಇಕಾತ್ ದಿತಾ, ಮರುಕ್ಲಾಗಲ್ಯಾ ಮಾಕಾ ಥೊರ್ಲೆ ಪಾನಾಚೆ ಉಪ್ಪೆಕ್ ಕಾಯ್?” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />ತನ್ನಾ ಜಾಕೊಬಾನ್ ಇಕಾತ್ ದಿಲಾ ಮನುನ್ ಆನ್ ಘಾಲುನ್ ಸಾಂಗ್, ಮನ್ತಾನಾ ಎಸಾವಾನ್ ಆನ್ ಘಾಲುನ್ ಅಪ್ಲೊ ಥೊರ್ಲೆ ಪಾನಾಚೊ ಹಕ್ಕ್ ಇಕಾತ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 25:34" />ತನ್ನಾ ಜಾಕೊಬಾನ್ ಎಸಾವಾಕ್ ಉಕಡಲ್ಲೆ ದಾನೆ ಅನಿ ಭಾಕ್ರಿಯಾ ಖಾವ್ಕ್ ದಿಲ್ಯಾನ್, ಎಸಾವಾನ್ ಖಾವ್ನ್ ಪಾನಿ ಫಿವ್ನ್ ಉಟುನ್ ಗೆಲೊ, ಥೊರ್ಲೆ ಪಾನಾಚ್ಯಾ ಹಕ್ಕಾಕ್ ಎಸಾವಾನ್ ದಿಲ್ಲಿ ಮರ್ಯಾದ್ ಹಿಚ್ ಹೊವ್ನ್ ಹಾಯ್!<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">ಇಸಾಕ್ ಗೆರಾರ್‍ಹಾತ್ ವಸ್ತಿ ಕರ್‍ತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ಎಳಾರ್ ಯೆಲ್ಲೊ ಬರ್‍ಗಾಲ್ ಅನಿ ಪರ್‍ತುನ್ ಕಾನಾನ್ ದೆಸಾತ್ ಯೆತಾ, ತನ್ನಾ ಇಸಾಕಾನ್ ಗೆರಾರಿತ್ ರ್‍ಹಾತಲ್ಯಾ ಪಿಲಿಸ್ಟಿ ಯಾಂಚೊ ರಾಜಾ ಅಬಿಮೆಲೆಕಾಕ್ ಭೆಟುಚೆ ಮನುನ್ ಗೆಲೊ. <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಇಸಾಕಾಕ್ ದರ್ಶನ್ ದಿವ್ನ್ ತಿಯಾ ಇಜಿಪ್ತ್ ದೆಸಾಕ್ ಜಾವ್ನಕ್ಕೊ ಮಿಯಾ ಸಾಂಗ್ತಲ್ಯಾ ದೆಸಾತ್ ಜಾವ್ನ್ ರಾ. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />ಅನಿ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾವ್ನ್ ತುಕಾ ಆಶಿರ್ವಾದ್ ದಿತಾ ಅನಿ ತುಜೊ ಬಾಬಾ ಅಬ್ರಾಹಾಮಾಕ್ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆ ತುಕಾ ಅನಿ ತುಜ್ಯಾ ಪಿಳ್ಗಿಕ್ ಹ್ಯೊ ದೆಶ್ ದಿತಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />ಅನಿ ಮಿಯಾ ಮಳ್ಬಾಚ್ಯಾ ಚುಕ್ಕಿಯಾಂಚ್ಯಾ ತವ್ಡೆ ಪಿಳ್ಗಿ ದಿತಾ, ಅನಿ ತುಜ್ಯಾ ಪಿಳ್ಗಿಕ್ ಹ್ಯೊ ಶಾಹಾರ್ ದಿತಾ, ತುಜ್ಯಾ ವೈನಾ ಜಿಮ್ನಿ ವೈಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಸಂತಾನಾಕ್ನಿ ಆಶಿರ್ವಾದ್ ಗಾವ್ತಾ. <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಅಬ್ರಾಹಾಮಾನ್ ಮಾಜ್ಯಾ ಗೊಸ್ಟಿಕ್ ಮಾನ್ ದಿಲ್ಯಾನ್, ಅನಿ ಮಾಜಿ ಹುಕುಮಾ ಅನಿ ನಿಯಮಾಕ್ನಿ, ಮಾನ್ ದಿವ್ನ್ ಚಲಲ್ಲ್ಯಾ ವೈನಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 26:6" />ತೆಚ್ಯಾ ವೈನಾ ಇಸಾಕ್ ಗೆರಾರಿತ್ ವಸ್ತಿ ರಾಲೊ. <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" />ಮಾನಾ ತ್ಯಾ ಜಾಗ್ಯಾರ್ ಹೊತ್ತಿ ಲೊಕಾ ಸಗ್ಳಿ ರೆಬೆಕ್ಕಾಚ್ಯಾ ವಿಶಯಾತ್ ಇಸಾಕಾಚ್ಯಾಕ್ಡೆ ಇಚಾರಿತ್ ತನ್ನಾ ಇಸಾಕಾನ್ ತಿ ಲೈ ಸುಂದರ್ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ಅಪ್ನಾಕ್ ಮಾರುನ್ ರೆಬೆಕ್ಕ್ ಕಾಡುನ್ ಘೆವ್ನ್ ಜಾತಾತ್ ಮನುನ್ ಬ್ಹಿವ್ನ್, “ತಿ ಮಾಜಿ ಭೆನ್ ” ಹೊವ್ಚೆ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 26:7" /><verse number="8" style="v" sid="GEN 26:8" />ಮಾನಾ ಇಸಾಕ್ ಥೈ ರ್‍ಹಾವ್ನ್ ಲೈ ದಿಸಾ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಎಕ್ ದಿಸಿ ಇಸಾಕ್ ಅನಿ ತೆಚಿ ಬಾಯ್ಕೊ ರೆಬೆಕ್ಕಾ ತೆನಿ ದೊಗೆಬಿ ಮಿಳುನ್ ಹೊತ್ತೆ ಪಿಲಿಶ್ಟಾಚೊ ರಾಜಾ ಅಬಿಮೆಲೆಕಾನ್ ಕಿಡಿಕಿತ್ನಾ ಬಗ್ಲ್ಯಾನ್, <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />ತನ್ನಾ ಅಬಿಮೆಲೆಕಾನ್ ಇಸಾಕಾಕ್ ಬಲ್ವುಕ್ ಲಾವ್ನ್,</para>
  <para style="p" vid="GEN 26:9">“ಹಿ ತುಜಿ ಬಾಯ್ಕೊ ನ್ಹಯ್, ತಿಯಾ ಹಿ ಭೆನ್ ಮನುನ್ ಕಶ್ಯಾಕ್ ಸಾಂಗಲೆಯ್? ತನ್ನಾ ಇಸಾಕಾನ್ , ತಿ ಬಾಯ್ಕೊ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾರ್ ತಿಚ್ಯಾ ವೈನಾ ಮಾಜೊ ಜಿವ್ ಕಾಡ್ತಾತ್ ಮನುನ್ ಚಿಂತಲ್ಲೊ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />ಮಾನಾ ಅಬಿಮೆಲೆಕಾನ್, “ತಿಯಾ ಅಸೆ ಕಾಯ್ ಕರ್ಲೆ? ಅಮ್ಚ್ಯಾತ್ ಹೊತ್ತೊ ಕೊನ್ ತರ್ಬಿ ಘೊಮಾನುಸ್ ತುಜ್ಯಾ ಬಾಯ್ಕೊಕ್ ಮಿಳುಕ್ ಅವ್ಕಾಸ್ ಕರುನ್ ದಿಲ್ಲೆ ಸಾರ್ಕೆ ಹೊಯ್ ಹೊತ್ತೆ ನ್ಹಯ್?, ತಿ ಲೈ ಮೊಟಿ ಚುಕ್ ಹೊಯ್ ಹೊತ್ತಿ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 26:10" /><verse number="11" style="v" sid="GEN 26:11" />ಮಾನಾ ಅಬಿಮೆಲೆಕಾನ್ ಅಪ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ, “ಜೆ ಕೊನ್ ತರ್ ಎಕ್ಲ್ಯಾನ್ ಹ್ಯಾ ಮಾನ್ಸಾಕ್ ಅನಿ ಹೆಚ್ಯಾ ಬಾಯ್ಕೊಕ್ ಕಾಯ್ ತರಾಸ್ ದಿಲ್ಲೆ ಹೊಲ್ಯಾರ್ ತೆಂಕಾ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ಚುಕಲ್ಲಿ ನಾ” ಮನುನ್ ಹುಕುಮ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಇಸಾಕಾಕ್ ಲೈ ಆಶಿರ್ವಾದ್ ದಿಲ್ಯಾನ್, ಅನಿ ಇಸಾಕಾನ್ ತ್ಯಾ ಜಾಗ್ಯಾರ್ ಬ್ಹಿ ಫೆರಲ್ಯಾಕಿಂತಾ ಎಕಾಕ್ ಸೆಂಬರ್ ಪಟ್ಟ್ ಜಾಸ್ತಿ ಗಾವ್ಲೆ; <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />ಮಾನಾ ತೊ ದಿಸಾನ್ ದಿಸ್ ಲೈ ಆಸ್ತಿವಂತ್ ಹೊವ್ನ್ ಲೈ ಸಾವ್ಕಾರ್ ಹೊವ್ಗೆತ್ ಗೆಲೊ.<verse eid="GEN 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 26:14" />ಅನಿ ತೆಚ್ಯಾಕ್ಡೆ ಲೈ ಜನಾವರಾ ಅನಿ ಆಳಾ ಲೈ ಹೊತ್ತಿ ಬಗುನ್ ಪಿಲಿಸ್ಟಿಯಾಂಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಪೊಟಾತ್ ಆಗ್ ಪಡ್ಲಿ. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />ತನ್ನಾ ಅಬ್ರಾಹಾಮ್ ಝಿತ್ತೊ ಹೊತ್ತ್ಯಾ ತನ್ನಾಚ್ ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ಸೆವಕಾನಿ ಖಂಡಲ್ಲಿ ಭಾಂಯಾ ಪಿಲಿಸ್ಟಿಯಾನಿ ಮಾಟಿ ಗಾಲುನ್ ಮುಜ್ವುಲ್ಯಾನಿ .<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />ತನ್ನಾ ಅಬಿಮೆಲೆಕಾನ್, “ಇಸಾಕಾಕ್ ತಿಯಾ ಅಮ್ಚ್ಯಾನ್ ಆಸ್ತಿತ್ ಲೈ ಮೊಟೊ ಹೊಲೈ, ತಸೆ ಹೊವ್ನ್ ಹ್ಯೊ ದೆಶ್ ಸೊಡುನ್ ಜಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 26:16" /><verse number="17" style="v" sid="GEN 26:17" />ಮಾನಾ ಇಸಾಕ್ ತ್ಯಾ ಗಾಂವಾತ್ನಾ ಜಾವ್ನ್ ಗೆರಾರಿಚ್ಯಾ ಕೊಳ್ಳಾತ್ ಝೊಪ್ಡೆ ಭಾಂದುನ್ ಘೆವ್ನ್ ಥೈಚ್ ವಸ್ತಿ ರಾಲೊ.<verse eid="GEN 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 26:18" />ಮನಾ ಅಬ್ರಾಹಾಮಾಚೆ ಮರಾನ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಇಸಾಕಾನ್ ಪಿಲಿಸ್ಟಿಯಾನಿ ಮುಜ್ವಲ್ಲಿ ಭಾಂಯಾ ಪರ್‍ತುನ್ ಕಾಡುನ್ ತೆಂಕಾ ಅಪ್ಲ್ಯಾ ಬಾಬಾನ್ ಥವಲ್ಲಿಚ್ ನಾವಾ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />ಮಾನಾ ಇಸಾಕಾಚ್ಯಾ ಸೆವಕಾನಿ ತ್ಯಾ ಬಾರಿಕ್ಲ್ಯಾ ಝರೊವಾಚ್ಯಾ ಜಗೊಳುಚ್ ಎಕ್ ಭಾಂಯ್ ಕಾಡಲ್ಯಾನಿ ತನ್ನಾ ತ್ಯಾತುರ್ ತೆಂಕಾ ಪಾನಿ ಗಾವ್ಲೆ. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />ಖರೆ ತ್ಯಾ ಭಾಯಚ್ಯಾ ಪಾಯಾತ್ ಗೆರಾರಿಚ್ಯಾ ಕೊಳ್ಳಾತ್ ಗೊರಾ ಬಕ್ರಿಯಾರಾಕ್ತಲ್ಯಾನಿ, ಇಸಾಕಾಚ್ಯಾ ಗೊರಾ ಬಕ್ರಿ ರಾಕ್ತಲ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ, ಹೆ ಪಾನಿ ಅಮ್ಕಾ ಸಂಮದ್ ಪಡಲ್ಲಿ ಮನುನ್ ವಾದ್ ಕರ್ಲ್ಯಾನಿ , ಇಸಾಕಾನ್ ತ್ಯಾ ಭಾಂಯಿಕ್ “ಎಸೆಕ್” ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 26:21" />ಅನಿ ಇಸಾಕಾಚ್ಯಾ ಸೆವಕಾನಿ ಅನಿ ಎಕ್ ಭಾಂಯ್ ಖಂಡ್ಲ್ಯಾನಿ, ತ್ಯಾ ಭಾಂಯಿಚ್ಯಾ ವಿಶಯಾತ್ ಬಿ ಲೊಕಾನಿ ವಾದ್ ಕರ್ಲ್ಯಾನಿ ತೆಚ್ಯಾ ವೈನಾ ಇಸಾಕಾನ್ ತ್ಯಾ ಭಾಂಯಿಕ್ “ಸಿಟ್ನಾ” ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್, ಸಿಟ್ನಾ ಮಟ್ಲ್ಯಾರ್ ದುಶ್ಮನ್ಕಿ. <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />ಮಾನಾ ಇಸಾಕಾನ್ ಥೈತ್ನಾ ಜಾವ್ನ್ ದುಸ್ರಾಕ್ಡೆ ಅನಿ ಎಕ್ ಬಾಯ್ ಖಂಡ್ಲ್ಯಾನ್ ಖರೆ ತ್ಯಾ ಬಾಯಿಚ್ಯಾ ವಿಶಯಾತ್ ಕೊನ್ಬಿ ವಾದ್ ಕರುಕ್ ಯೆವ್ಕನಾತ್ ತಸೆ ಹೊವ್ನ್ ತೆನಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಮ್ಕಾ ಹೊ ಮಾಳ್ ಜಾಗೊ ದಿಲಾ, ಅಮಿ ಹ್ಯಾ ಜಾಗ್ಯಾ ವರ್‍ತಿ ವಾಡ್ವಳ್ಕಿ ಹೊಲ್ಯಾಂವ್ ಮನುನ್ ತ್ಯಾ ಭಾಂಯಿಕ್ “ರೆಹೊಬೊತ್” ನಾವ್ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />ಮಾನಾ ಇಸಾಕ್ ಥೈತ್ನಾ ಬೆರ್ಶೆಬಾಕ್ ಗೆಲೊ. <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />ತ್ಯಾ ರಾತ್ತಿನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಇಸಾಕಾಕ್ ದರ್ಶನ್ ದಿವ್ನ್, “ಮಿಯಾ ತುಜೊ ಬಾಬಾ ಅಬ್ರಾಹಾಮಾಚೊ ದೆವ್, ಮಿಯಾ ತುಜಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾತಾ, ತಿಯಾ ಬ್ಹಿಂವ್ ನಕ್ಕೊ, ಮಿಯಾ ತುಕಾ ಆಶಿರ್ವಾದ್ ದಿತಾ, ಅನಿ ಮಿಯಾ ತುಜ್ಯಾ ಪಿಳ್ಗಿಕ್ ವಾಡ್ವುತಾ, ಮಿಯಾ ಮಾಜ್ಯಾ ಸೆವಕ್ ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ಸಾಟ್ನಿ ಹೆ ಕರುಲ್ಲಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 26:24" /><verse number="25" style="v" sid="GEN 26:25" />ತೆಚ್ಯಾ ವೈನಾ ಥೈ ಇಸಾಕಾನ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಭಾಂದುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಆರಾದನ್ ಕರ್ಲ್ಯಾನ್, ಮಾನಾ ತೆಚ್ಯಾ ಸೆವಕಾನಿ ಥೈ ಅನಿ ಎಕ್ ಭಾಂಯ್ ಖಂಡ್ಲ್ಯಾನಿ ಅನಿ ಇಸಾಕ್ ಥೈ ಎಕ್ ಝೊಪ್ಡೊ ಭಾಂದುನ್ಗೆವ್ನ್ ರಾಲೊ.<verse eid="GEN 26:25" /></para>
  <para style="s">ಇಸಾಕ್ ಅನಿ ಅಬಿಮೆಲೆಕಾಚೆ ಕರಾರ್</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />ತನ್ನಾ ಅಬಿಮೆಲೆಕ್ ಇಸಾಕಾಕ್ ಭೆಟುಕ್ ಮನುನ್ ಅಪ್ಲೊ ಸಲಹಾ ದಿನಾರೊ ಅಹುಜ್ಜತ್ ಅನಿ ಸೆನಾಧಿಪತಿ ಫಿಕೊಲ್ ಹೆಂಕಾ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಗೆರಾರಿತ್ನಾ ಯೆಲೊ. <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />ತನ್ನಾ ಇಸಾಕಾನ್ , ತುಮಿ ಮಾಕಾ ಕುಸ್ಡೆ ಪಾನಾನಿ ಮಾಕಾ ಧಾಡುನ್ ದಿವ್ನ್ ತುಮಿ ಅತ್ತಾ ಕಶ್ಯಾಕ್ ಮಾಕಾ ಬಗುಕ್ ಮನುನ್ ಯೆಲೈ? ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />ತನ್ನಾ ತೆನಿ ತೆಕಾ, ದೆವ್ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಹಾಯ್ ಮನ್ತಲೆ ಮಾಕಾ ಅತ್ತಾ ಕಳುನ್ ಯೆಲಾ, ತನ್ನಾ ಮಿಯಾ ಅನಿ ತಿಯಾ ಎಕ್ ಕರಾರ್ ಕರುನ್ ಘೆಂವ್ವಾ. <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />ಅನಿ ಅಮಿ ತುಕಾ ಕಾಯ್ಬಿ ಬುರ್ಸೆ ಕರಿನಸ್ತಾನಾ ಧಾಡುನ್ ದಿಲ್ಲ್ಯಾಂವ್ ಕಿ ನಾ? ತಸೆ ಮನುನ್ ತಿಯಾಬಿ ಅಮ್ಕಾ ಕಾಯ್ಬಿ ಕರಿನಾ ಮನುನ್ ಅಮ್ಕಾ ಭಾಶ್ ದಿ, ಅಮಿ ತುಮ್ಕಾ ದುರ್ ಧಾಡುನ್ ದಿಲ್ಯಾರ್ಬಿ ಸಮಾಧಾನಾನ್ ಧಾಡುನ್ ದಿಲಾಂವ್, ಅನಿ ಅತ್ತಾ ವಾಂಗ್ಡಾ ಸರ್ವೆಸ್ಪರ್ ಹಾಯ್ ಅನಿ ತುಕಾ ಆಶಿರ್ವಾದ್ ಕರುಕ್ ಲಾಗ್ಲಾ, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 26:29" /><verse number="30" style="v" sid="GEN 26:30" />ಇಸಾಕಾನ್ ತೆಂಚ್ಯಾ ಸಾಟ್ನಿ ಮೊಟೆ ಜೆವಾನ್ ತಯಾರ್ ಕರ್ಲ್ಯಾನ್, ತೆನಿ ಜೆವ್ನ್ ಖಾವ್ನ್ ಫಿಲ್ಯಾನಿ. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />ಮಾನಾ ದುಸ್ರೆ ದಿಸಿ ಸಕ್ಕಾಳಿ ತೆನಿ ದೊಗೆಬಿ ಎಕಾ ಮೆಕಾಕ್ ಕರಾರ್ ಕರುನ್, ಜಾವ್ನ್ ಯೆತಾಂವ್ ಮನುನ್ ಸಾಂಗುನ್ ಗೆಲೆ.<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />ತ್ಯಾ ದಿಸಿ, ಇಸಾಕಾಚ್ಯಾ ಸೆವಕಾನಿ ಯೆವ್ನ್, ತೆನಿ ಖಂಡಲ್ಯಾ ಭಾಂಯಿಚ್ಯಾ ವಿಶಯಾತ್, “ಅಮ್ಕಾ ಭಾಂಯಿತ್ ಎಕ್ ಝರೊ ಗಾವ್ಲಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನಿ. <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />ಇಸಾಕಾನ್ ತ್ಯಾ ಶಾರಾಕ್ ಬೆರ್ಶೆಬಾ ಮನುನ್ ನಾವ್ ಥವಲ್ಯಾ ಸಾರ್ಕೆ ತ್ಯಾ ಭಾಂಯಿಕ್ “ಶಿಬಾ” ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್, ತ್ಯಾ ಗಾಂವಾಕ್ ಅಜುನ್ ಪತರ್ಬಿ ಬೆರ್ಶೆಬ್ ಮನುನ್ ಬಲ್ವುತಾತ್.<verse eid="GEN 26:33" /></para>
  <para style="s">ಎಸಾವಾಚಿ ಬಾಯ್ಕಾ ಭಾಯ್ಲ್ಯಾ ದೆಶಾಚಿ</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />ಚಾಳಿಸ್ ವರ್ಸಾ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಎಸಾವಾನ್ ಹಿತ್ತಿಯಾಂಚ್ಯಾ ದೊನ್ ಬಾಯ್ಕಾಕ್ನಿ ನಗಿನ್ ಹೊಲೊ, ತೆಂಚ್ಯಾತ್ ಎಕ್ಲಿ ಬೆರಿಯಾಚಿ ಲೆಕ್ ಜುಡಿತಾ, ಅನಿ ಎಕ್ಲಿ ಎಲೊನಾಚಿ ಲೆಕ್ ಬಾಸೆಮತ್. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />ಇಸಾಕ್ ಅನಿ ರೆಬೆಕ್ಕಾಕ್ ಹ್ಯಾ ಲಗ್ನಾ ವಯ್ನಾ ಮನಾಕ್ ಲೈ ಬೆಜಾರ್ ಹೊಲೆ.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">ಜಾಕೊಬಾಕ್ ಇಸಾಕಾಚೊ ಆಶಿರ್ವಾದ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />ಇಸಾಕ್ ಮ್ಹಾತಾರೊ ಹೊವ್ನ್ ಡೊಳೆ ದಿಸಿನಸಲ್ಯಾ ತವ್ಡೆ ಮಬ್ಬ್ ಹೊಲೆ, ತೆನಿ ಅಪ್ಲೊ ಥೊರ್ಲೊ ಲೆಕ್ ಎಸಾವಾಕ್, “ಲೆಕಾ” ಮನುನ್ ಬಲ್ವುತಾನಾ,</para>
  <para style="p" vid="GEN 27:1">ಎಸಾವಾನ್, “ಅಬಕ್ ಮಿಯಾ ಹಿತ್ತೆಚ್ ಹಾಂವ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />ತನ್ನಾ ಇಸಾಕಾನ್ ತೆಕಾ, ಅಬಕ್ ಮಿಯಾ ಕನ್ನಾ ಮರ್ತಾ ಮನುನ್ ಗೊತ್ತ್ ನಾ ತವ್ಡೊ ಲೈ ಮ್ಹಾತಾರೊ ಹೊಲಾ; <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />ತಸೆ ಹೊವ್ನ್ ತುಜಿ ಹಾತ್‍ಯಾರಾ, ಅನಿ ಬಿಲ್ಬಾನ್ ಘೆವ್ನ್ ಡಂಗ್ಳಿಕ್ ಜಾವ್ನ್ ಶಿಕಾರ್ ಕರುನ್ ಶಿಕಾರಿಚೆ ಮಾಂಸ್ ಘೆವ್ನ್ ಯೆ; <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />ಅನಿ ಮಾಜ್ಯಾ ಮನಾಕ್ ಯೆತಲೆ ರುಚ್ ಜೆವಾನ್ ತಯಾರ್ ಕರುನ್ ವಾಡ್ ದ್ಯಾಯ್ ಭರುನ್ ಜೆವ್ತಾ ಅನಿ,</para>
  <para style="p" vid="GEN 27:4">ಮಾಕಾ ಮರಾನ್ ಯೆವ್ಚ್ಯಾ ಪೈಲೆ ಮಾಜ್ಯಾ ಮನಾಕ್ ಯೆಯ್ ಸಾರ್ಕೆ ತುಕಾ ಆಶಿರ್ವಾದ್ ಕರ್ತಾ, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />ಇಸಾಕಾನ್ ಎಸಾವಾಕ್ ಸಾಂಗುಲಾಗಲಿ ಹಿ ಗೊಸ್ಟಿಯಾ ರೆಬೆಕ್ಕಾಚ್ಯಾ ಕಾನಾಕ್ ಪಡ್ಲಿ, ಎಸಾವ್ ಶಿಕಾರಿಕ್ ಮನುನ್ ಡಂಗ್ಳಿಕ್ ಗೆಲ್ಲ್ಯಾ ತನ್ನಾ, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />ತಿನಿ ಅಪ್ಲೊ ಲೆಕ್ ಜಾಕೊಬಾಕ್ಡೆ, ತುಜೊ ಬಾಬಾ ತುಜೊ ಭಾವ್ ಎಸಾವಾಕ್ಡೆ ಬೊಲುಲಾಗಲೊ, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />ತಿಯಾ ಜಾವ್ನ್ ಶಿಕಾರ್ ಕರುನ್ ಮಾಂಸ್ ಹಾನುನ್ ಬರೆ ಜೆವಾನ್ ತಯಾರ್ ಕರುನ್ ಮಾಕಾ ವಾಡ್; ಮಾಕಾ ಮರಾನ್ ಯೆವ್ಚ್ಯಾ ಪೈಲೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚ್ಯಾ ಇದ್ರಾಕ್ ತುಕಾ ಆಶಿರ್ವಾದ್ ದಿತಾ, ಮನುಕ್ಲಾಗಲೆ ಮಿಯಾ ಆಯ್ಕ್ಲೊ. <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />ತಸೆ ಹೊವ್ನ್ ಮಾಜ್ಯಾ ಲೆಕಾ ಮಿಯಾ ಸಾಂಗ್ತಲೆ ಕಾನ್ ದಿವ್ನ್ ಆಯ್ಕ್ ಅನಿ ಮಿಯಾ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆ ಕರ್; <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />ಶೆಳಿಯಾಂಚ್ಯಾ ತಾಂಡ್ಯಾಕ್ಡೆ ಲಗ್ಗುನಾ ಜಾ ಅನಿ ದೊನ್ ಶೆಳಿಯಾಂಚೆ ಪೆಟೆ ಹಾನ್, ಮಿಯಾ ತುಜ್ಯಾ ಬಾಬಾಕ್ ಮನಾಕ್ ಯೆತಲೆ ಜೆವಾನ್ ತಯಾರ್ ಕರುನ್ ದಿತಾ, <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />ತಿಯಾ ತೆ ನ್ಹೆವ್ನ್ ತೆಕಾ ವಾಡುಚೆ; ಹೆಜ್ಯಾ ವೈನಾ ತೊ ಮರುಚ್ಯಾ ಪೈಲೆ ತುಕಾಚ್ ಮನಾಕ್ ಯೆಯ್ ಸಾರ್ಕೆ ಆಶಿರ್ವಾದ್ ದಿತಾ, ಮಟ್ಲಿನ್.<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />ತನ್ನಾ ಜಾಕೊಬಾನ್, ಮಾಜ್ಯಾ ಭಾವಾಚ್ಯಾ ಆಂಗ್ಬರ್ ಕೆಸಾ ಹಾತ್, ಮಾಜೆ ಆಂಗ್ ತರ್ ಸಾಪ್ ಹಾಯ್,<verse eid="GEN 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 27:12" />ಬಾಬಾನ್ ಎಕ್ಎಳಾ ಮಾಕಾ ಅಪ್ಡುನ್ ಬಗಟ್ಲ್ಯಾರ್ ಮಿಯಾ ಪಸ್ವುಲೊ ಮನುನ್ ಕಳ್ಳ್ಯಾರ್ ಆಶಿರ್ವಾದ್ ದಿತಲ್ಯಾ ಬದ್ಲಾಕ್ ಶಾಪ್ ದಿಯ್ಲ್, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />ತನ್ನಾ ತೆಚ್ಯಾ ಬಾಯ್ನ್, ಲೆಕಾ ತೆನಿ ಶಾಪ್ ದಿಲ್ಯಾರ್ ತೊ ಶಾಪ್ ಮಾಕಾ ಲಾಗುಂದಿತ್; ತಿಯಾ ಮಾಜಿ ಗೊಸ್ಟ್ ಆಯ್ಕ್ ಅನಿ ಶೆಳಿಯಾಂಚೆ ಪೆಟೆ ಹಾನ್, ಮಟ್ಲಿನ್. <verse eid="GEN 27:13" /><verse number="14" style="v" sid="GEN 27:14" />ತೆನಿ ಜಾವ್ನ್ ತೆ ಪೆಟೆ ಹಾನುನ್ ಬಾಯ್ಕ್ ದಿಲ್ಯಾನ್ ರೆಬೆಕ್ಕಾನ್ ತೆಚ್ಯಾ ಬಾಬಾಕ್ ಮನಾಕ್ ಯೆತಲೆ ಜೆವಾನ್ ರಾಂದ್ಲಿನ್. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />ಅಪ್ಲೊ ಥೊರ್ಲೊ ಲೆಕ್ ಎಸಾವಾಚೆ ನ್ಹವೆ ಕಪ್ಡೆ ಘರ್‍ಹಾತ್ ತಿಚ್ಯಾಕ್ಡೆ ಹೊತ್ತ್ಯೆ, ತೆ ಅಪ್ಲೊ ಧಾಕ್ಲೊ ಲೆಕ್ ಜಾಕೊಬಾಕ್ ನ್ಹೆಸ್ವುಲಿನ್. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />ಶೆಳಿಯಾಂಚ್ಯಾ ಪೆಟ್ಯಾಂಚ್ಯಾ ಚಮ್ಡ್ಯಾನ್ ತೆಚ್ಯಾ ಸಾಪ್ ಹೊತ್ತ್ಯಾ ಹಾತಾಕ್ನಿ ಅನಿ ಮಾನೆಕ್ಬಿ ಲಪಟ್ಲಿನ್. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />ಅನಿ ಅಪ್ನಿ ರಾಂಧಲೆ ಬರೆ ಜೆವಾನ್ ಅನಿ ಕರಲಿ ಭಾಕ್ರಿಯಾ ಅಪ್ಲೊ ಲೆಕ್ ಜಾಕೊಬಾಚ್ಯಾ ಹಾತಿತ್ ದಿವ್ನ್ ಧಾಡ್ಲಿನ್.<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />ಜಾಕೊಬ್ ಬಾಬಾಕ್ಡೆ ಜಾವ್ನ್, “ಬಾಬಾ” ಮನುನ್ ಬಲ್ವುಲ್ಯಾನ್ ತನ್ನಾ “ಕಾಯ್ ಲೆಕಾ ತಿಯಾ ಖಲೊ ಲೆಕ್?” ಮನುನ್ ಬಾಬಾನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />ತನ್ನಾ ಜಾಕೊಬಾನ್, ಮಿಯಾಚ್ ತುಜೊ ಥೊರ್ಲೊ ಲೆಕ್ ಎಸಾವ್; ತುಜ್ಯಾ ಹುಕುಮಾ ಸಾರ್ಕೆ ಜೆವಾನ್ ತಯಾರ್ ಕರುನ್ ಹಾನ್ಲಾ, ಉಟುನ್ ಬಸ್ ಅನಿ ಮಿಯಾ ಶಿಕಾರಿ ಕರುನ್ ಹಾನಲ್ಯಾ ಮಾಂಸಾಚೆ ಜೆವಾನ್ ಕರುನ್ ಮಾಕಾ ಮನಾನಿ ಆಶಿರ್ವಾದ್ ದಿ, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />ಇಸಾಕಾನ್, ಕಾಯ್ ಲೆಕಾ, ಯೆವ್ಡ್ಯಾ ಲುಗ್ಗುನಾ ಕಸಿ ಶಿಕಾರಿ ಗಾವ್ಲಿ? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ, ತನ್ನಾ ಜಾಕೊಬಾನ್, ತುಜೊ ದೆವ್ ಸರ್ವೆಸ್ಪರಾನ್ ತೆ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />ತನ್ನಾ ಇಸಾಕಾನ್, “ಲೆಕಾ ಜಗ್ಗೊಳ್ ಯೆ ಮಿಯಾ ಅಪ್ಡುನ್ ತಿಯಾ ಖರೆಚ್ ಮಾಜೊ ಲೆಕ್ ಎಸಾವ್ ಹೊಯ್ ಕಿ ನೈ ಮನುನ್ ಕಳ್ವುನ್ ಘೆವ್ಚೆ”, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 27:21" /><verse number="22" style="v" sid="GEN 27:22" />ಜಾಕೊಬ್ ಜಗ್ಗೊಳ್ ಯೆಲ್ಯಾ ತನ್ನಾ ಬಾಬಾ ಇಸಾಕಾನ್ ತೆಕಾ ಅಪ್ಡುನ್, “ಧನ್ ತರ್ ಜಾಕೊಬಾಚಿಚ್; ಖರೆ ಹಾತ್ ಎಸಾವಾಚೊ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />ಜಾಕೊಬಾಚ್ಯಾ ಹಾತಾಕ್ನಿಬಿ ತೆಜಾ ಭಾವಾಚ್ಯಾ ಹಾತಾಕ್ನಿ ಹೊತ್ಯಾ ಸಾರ್ಕೆ ಕೆಸಾ ಹೊತ್ಯಾಸಾಟ್ನಿ ಇಸಾಕಾಕ್ ತೆಚಿ ವಳಕ್ ಕಳಿನಸ್ತಾನಾ ತೆಕಾ ಆಶಿರ್ವಾದ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />ಹೊಲ್ಯಾರ್ಬಿ ಅನಿ ಪರ್‍ತುನ್, “ಖರೆಚ್ಬಿ ತಿಯಾ ಮಾಜೊ ಲೆಕ್ ಎಸಾವುಚ್ ಕಾಯ್?” ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ, ಜಾಕೊಬಾನ್ “ಹೊಯ್” ಮನುನ್ ಜಬಾಬ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />ತನ್ನಾ ಇಸಾಕಾನ್, “ತೆ ಶಿಕಾರ್ ಕರಲೆ ಮಾಂಸ್ ಹಾನುನ್ ವಾಡ್ ಜೆವ್ತಾ, ಅನಿ ಮಾನಾ ತುಕಾ ಆಶಿರ್ವಾದ್ ದಿತಾ,” ಮಟ್ಲ್ಯಾನ್, ತಸೆಚ್ ಜಾಕೊಬಾನ್ ವಾಡಲ್ಯಾ ತನ್ನಾ ಇಸಾಕಾನ್ ಜೆವ್ಲ್ಯಾನ್; ಅನಿ ದಿಲ್ಲೊ ವಾಯ್ನ್ ಫಿಲ್ಯಾನ್. <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />ಮಾನಾ ತೆಜೊ ಬಾಬಾ ಇಸಾಕಾನ್, “ಲೆಕಾ, ಜಗ್ಗೊಳ್ ಯೆವ್ನ್ ಮಾಕಾ ಉಪ್ಪಾ ದಿ”, ಮಟ್ಲ್ಯಾನ್, ತೆನಿ ಜಗ್ಗೊಳ್ ಯೆವ್ನ್ ಉಪ್ಪಾ ದಿಲ್ಲ್ಯಾ ತನ್ನಾ, <verse eid="GEN 27:26" /><verse number="27" style="v" sid="GEN 27:27" />ಇಸಾಕಾನ್ ತೆಚ್ಯಾ ಕಂಪ್ಡ್ಯಾಚಿ ಬರೆ ವಾಸ್ ಘೆವ್ನ್, ತೆಕಾ ಆಶಿರ್ವಾದ್ ದಿವ್ನ್, “ಅಬಕ್ ಮಜ್ಯಾ ಲೆಕಾಚಿ ಬರಿ ವಾಸ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಆಶಿರ್ವಾದ್ ದಿಲ್ಲ್ಯಾ ಸೆತ್ಯಾಚ್ಯಾ ವಾಸೆ ಸಾರ್ಕೆ ಹಾಯ್, <verse eid="GEN 27:27" /><verse number="28" style="v" sid="GEN 27:28" />ತಸೆ ಹೊವ್ನ್ ದೆವ್ ತುಕಾ ಮಳ್ಬಾತ್ಲಿ ಇಬ್ಬನಿ ಅನಿ ಫಳ್ ದಿತಲಿ ಜಿಮಿನ್, ಲೈ ಬರೆ ಯೆಲ್ಲೆ ಪಿಕ್ ಅನಿ ವಾಯ್ನ್ ದಿಂವ್ದಿತ್, <verse eid="GEN 27:28" /><verse number="29" style="v" sid="GEN 27:29" />ಲೊಕಾ ತುಜಿ ಸೆವಾ ಕರುಂದಿತ್, ಘರಾನೆ ತುಕಾ ಪಾಯ್ ಪಡುಂದಿತ್, ತುಜ್ಯಾ ಭಾವಾಕ್ನಿ ತಿಯಾಚ್ ಯಜಮಾನ್ ಹೊವ್ನ್ ರಾ, ತುಜ್ಯಾ ಬಾಯ್ಚಿ ಪೊರಾ ತುಕಾ ಪಾಯ್ ಪಡುಂದಿತ್, ತುಕಾ ಆಶಿರ್ವಾದ್ ದಿತಲ್ಯಾಕ್ನಿ ಆಶಿರ್ವಾದ್ ಅನಿ ತುಕಾ ಶರಾಪ್ ದಿಲ್ಲ್ಯಾಕ್ನಿ ಶರಾಪ್ ಹೊಂವ್ದಿತ್”, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 27:29" /></para>
  <para style="s">ಇಸಾಕಾಕ್ಡೆ ಎಸಾವಾಚಿ ಮಾಗ್ನಿ</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />ಇಸಾಕಾನ್ ಜಾಕೊಬಾಕ್ ಆಶಿರ್ವಾದ್ ಕರ್ಲ್ಯಾ ಮಾನಾ ತೊ ಬಾಬಾಚ್ಯಾ ಜಗ್ಗೊಳ್ನಾ ಗೆಲೊ ಅನಿ ತನ್ನಾ ತೆಜೊ ಅನ್ನಾ ಎಸಾವ್ ಶಿಕಾರಿಕ್ ಗೆಲ್ಲೊ ಯೆವ್ನ್ ಪಾವ್ಲೊ. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />ತೆನಿಬಿ ಬರೆ ಜೆವಾನ್ ತಯಾರ್ ಕರುನ್ ಬಾಬಾಕ್ಡೆ ಹಾನುನ್, “ಉಟ್ ಬಾಬಾ ಮಿಯಾ ತುಜ್ಯಾ ಲೆಕಾನ್ ಹಾನಲೆ ಶಿಕಾರಿಚೆ ಮಾಂಸ್ ಜೆವಾನ್ ಕರುನ್ ಮಾಕಾ ಆಶಿರ್ವಾದ್ ದಿ,” ಮನುನ್ ಮಾಗ್ಲ್ಯಾನ್.<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />ಕೊನ್ ತಿಯಾ? ಮನುನ್ ಇಸಾಕಾನ್ ಇಚಾರ್‍ತಾನಾ, “ಮಿಯಾಚ್ ತುಜೊ ಥೊರ್ಲೊ ಲೆಕ್ ಎಸಾವ್” ಮನುನ್ ಜವಾಬ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />ತನ್ನಾ ಇಸಾಕ್ ಥರ್ಥರುನ್ ಕಾಪುನ್ಗೆತ್ “ತಸೆ ಹೊಲ್ಯಾರ್ ಮಾಕಾ ಶಿಕಾರಿಚೆ ಮಾಂಸ್ ಹಾನುನ್ ಜೆವಾನ್ ದಿಲ್ಲೊ ಕೊನ್ ? ತಿಯಾ ಯೆವ್ಚ್ಯಾ ಪೈಲೆ ತೆನಿ ಹಾನಲೆ ಜೆವಾನ್ ಕರುನ್ ಆಕ್ರಿಕ್ ತೆಕಾಚ್ ಆಶಿರ್ವಾದ್ ದಿಲೊ; ತೆಕಾ ದಿಲ್ಲೊ ಆಶಿರ್ವಾದ್ ಚುಕ್ವುಕ್ ಹೊಯ್ನಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />ಬಾಬಾಚಿ ಹಿ ಗೊಸ್ಟ್ ಆಯ್ಕುನ್ ಎಸಾವಾಕ್ ಲೈ ಬೆಜಾರ್ ಹೊತಾ ಅನಿ ಲೈ ರಡ್ಲ್ಯಾನ್, ಅನಿ ಮೊಟ್ಟ್ಯಾ ಧನಾನ್ “ಬಾಬಾ, ಮಾಕಾಬಿ ಆಶಿರ್ವಾದ್ ದಿ” ಮನುನ್ ಮಾಗ್ಲ್ಯಾನ್.<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />“ತುಜ್ಯಾ ಭಾವಾನ್ ಯೆವ್ನ್ ಪಸ್ವುನ್ ತುಕಾ ಹೊವ್ಚೆ ಹೊಲ್ಲೊ ಆಶಿರ್ವಾದ್ ಕಾಡುನ್ಗೆವ್ನ್ ಗೆಲ್ಯಾನ್,” ಮನುನ್ ಇಸಾಕಾನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />ತನ್ನಾ ಎಸಾವಾನ್ ಜಾಕೊಬ್ ಮನ್ತಲೆ ನಾವ್ ತೆಕಾ ಸಮಾ ಹಾಯ್; ಹೆಜ್ಯಾ ಅದ್ದಿ ಮಾಜೊ ಥೊರ್ಲೆ ಪಾನಾಚೊ ಹಕ್ಕ್ ಚೊರ್ಲ್ಯಾನ್; ಅನಿ ಅತ್ತಾ ಮಾಕಾ ಯೆವ್ಚೊ ಹೊಲ್ಲೊ ಆಶಿರ್ವಾದ್ ಕಾಡುನ್ಗೆಟ್ಲ್ಯಾನ್, ಹೆಜ್ಯಾ ವೈನಾ ತೆನಿ ಮಾಕಾ ದೊನ್ ಪಟಿ ಪಸ್ವುಲ್ಯಾನ್ ಮನುನ್ಗೆತ್, ಬಾಬಾಕ್ ಬಗುನ್, “ತುಜ್ಯಾಕ್ಡೆ ಮಾಕಾ ಮನುನ್ ಖಲೊ ಆಶಿರ್ವಾದ್ಬಿ ಹುರುಕ್ನಾ ಕಾಯ್?” ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />ತನ್ನಾ ಇಸಾಕಾನ್ ತೆಕಾ ತುಜೊ ಯಜಮಾನ್ ಕರುನ್ ನೆಮ್ಲಾ; ಭಾವಾಕುಚ್ ತೆಜೊ ಆಳ್ ಕರುನ್ ದಿಲೊ; ಸೆತ್ ಭಾತ್, ಪಿಕ್, ಅನಿ ವಾಯ್ನ್ ತೆಕಾಚ್ ದಿಲೊ, ಅಸೆ ರ್‍ಹಾತಾನಾ ಲೆಕಾ ಮಿಯಾ ತುಕಾ ಕಾಯ್ ಕರುಕ್ ಹೊತಾ? ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 27:37" /><verse number="38" style="v" sid="GEN 27:38" />“ಬಾಬಾ ತುಜ್ಯಾಕ್ಡೆ ತೊ ಎಕುಚ್ ಆಶಿರ್ವಾದ್ ಹೊತ್ತೊ ಕಾಯ್? ಮಾಕಾಬಿ ಆಶಿರ್ವಾದ್ ದಿ” ಮನುನ್ ಲೈ ರಡುನ್ ಮಾಗ್ಲ್ಯಾನ್.<verse eid="GEN 27:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="GEN 27:39" />ತನ್ನಾ ಬಾಬಾ ಇಸಾಕಾನ್ ತೆಕಾ,</para>
  <para style="q2" vid="GEN 27:39">ಅಬಕ್ ತುಜೆ ಘರ್ ಬರ್‍ಯಾ ಜಮ್ನಿಚ್ಯಾ ವೈನಾ ಪಡ್ತಲ್ಯಾ ಮಳ್ಬಾಚ್ಯಾ ಇಬ್ಬನಿತ್ ರ್‍ಹಾತಾ.<verse eid="GEN 27:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40" />ತುಜ್ಯಾ ಕೊಯ್ತ್ಯಾಚ್ಯಾ ಬಳಾ ವೈನಾ ಜಿವನ್ ಕರ್‍ತೆ,</para>
  <para style="q2" vid="GEN 27:40">ತುಜ್ಯಾ ಬಾವಾಚಿ ಸೆವಾ ಕರ್‍ತೆ,</para>
  <para style="q1" vid="GEN 27:40">ಖರೆ ತಿಯಾ ಯಜಮಾನ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ತೆಜೊ ಜುಂ ತುಜ್ಯಾ ಮಾನೆನ್ ಮೊಡುನ್ ಟಾಕ್ತೆಯ್.<verse eid="GEN 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />ಜಾಕೊಬಾನ್ ಬಾಬಾಕ್ನಾ ಘೆಟಲ್ಯಾ ಆಶಿರ್ವಾದಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಲೈ ರಾಗ್ ಹೊಲ್ಯಾನ್ ಅನಿ ಬಾಬಾಚೆ ಮರಾನ್ ಹೊತಲೆ ದಿಸ್ ಜಗ್ಗೊಳ್ ಯೆಲಾತ್ ತೆಚ್ಯಾ ಮಾನಾ ಭಾವ್ ಜಾಕೊಬಾಕ್ಬಿ ಜಿವ್ ಕಾಡ್ತಾ ಮನುನ್ ಮನಾತುಚ್ ಬೊಲುನ್ಗೆಟ್ಲ್ಯಾನ್.<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />ರೆಬೆಕ್ಕಾಕ್ ಎಸಾವಾಚಿ ಹಿ ಯವ್ಜನ್ ಕಳುನ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ ತಿನಿ ಅಪ್ಲೊ ಧಾಕ್ಲೊ ಲೆಕ್ ಜಾಕೊಬಾಕ್ ಬಲ್ವುನ್, ಅಬಕ್ ತುಜೊ ಥೊರ್ಲೊ ಭಾವ್ ತುಕಾ ಜಿವ್ ಕಾಡುನ್ ಅಪ್ನಾಕ್ ಸಮಾಧಾನ್ ಕರುನ್ಗೆಟ್ಲ್ಯಾನಾಯ್,<verse eid="GEN 27:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 27:43" />ತಸೆ ಹೊವ್ನ್ ಲೆಕಾ ಅತ್ತಾ ಮಾಜ್ಯಾ ಗೊಸ್ಟಿಕ್ ಕಾನ್ ದಿ; ಉಟ್ ಅನಿ ಹಾರಾನಾತ್ ಹೊತ್ತ್ಯಾ ಮಾಜ್ಯಾ ಭಾವ್ ಲಾಬಾನಾಕ್ಡೆ ಪಳುನ್ ಜಾ, <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />ತುಜ್ಯಾ ಭಾವಾಚೊ ರಾಗ್ ಥಂಡ್ ಹೊಯ್ ಪತರ್ಬಿ ಉಲ್ಲೆ ದಿಸ್ ಥೈಚ್ ರಾ, <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />ಮಿಯಾ ಕಶ್ಯಾಕ್ ತುಮ್ಕಾ ದೊಗ್ಯಾಕ್ನಿಬಿ ಕಳ್ದುನ್ ಘೆವ್ಚೆ? ತಸೆಹೊವ್ನ್ ತುಜ್ಯಾ ಭಾವಾಕ್ ತಿಯಾ ಕರಲೆ ಇಸ್ರುನ್ ಅಪ್ಲೊ ರಾಗ್ ಥಂಡ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಮಿಯಾ ತುಕಾ ಥೈತ್ನಾ ಬಲ್ವುನ್ ಘೆತಾ ಮಟ್ಲಿನ್.<verse eid="GEN 27:45" /></para>
  <para style="s">ಇಸಾಕಾನ್ ಜಾಕೊಬ್ ಲಾಬಾನಾಕ್ಡೆ ಧಾಡುನ್ ದಿಲ್ಲೆ</para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />ಮಾನಾ ರೆಬೆಕ್ಕಾನ್ ಇಸಾಕಾಕ್, ಹಿತ್ತಿಯಾಂಚ್ಯಾ ಚೆಡ್ವಾಂಚ್ಯಾ ವೈನಾ ಬೆಜಾರ್ ಹೊಲಾ, ಜಾಕೊಬಾನ್ಬಿ ಹ್ಯಾ ಗಾಂವ್ಚೆ ಚೆಡು ಎಚುನ್ ಘೆವ್ನ್ ಹಿತ್ತಿಯಾಂಚೆ ಚೆಡು ಲಗಿನ್ ಹೊಲ್ಯಾರ್ ಮಿಯಾ ಜಿವಾನ್ ಹೊತ್ತೆ ಕಾಯ್ಬಿ ಉಪ್ಪೆಕಾಕ್ ಯೆಯ್ನಾ, ಮಟ್ಲಿನ್.<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />ಯಾಕೊಬಾನ್ ಇಸಾಕಾಕ್ ಬಲ್ವುನ್ ಆಶಿರ್ವಾದ್ ದಿವ್ನ್, ತೆಕಾ ಕಾನಾನಾಂಚ್ಯಾ ಚೆಡ್ವಾಕ್ನಿ ತಿಯಾ ಲಗಿನ್ ಹೊವ್ನಕ್ಕೊ. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />ತನ್ನಾ ತಿಯಾ ಹೊ ಜಾಗೊ ಸೊಡುನ್ ಪದ್ದನ್ ಅರಾಮಿತ್ ತುಜ್ಯಾ ಬಾಯ್ಚೊ ಬಾಬಾ, ಅಜ್ಜಾ ಬೆತುವೆಲಾಚ್ಯಾ ಘರಾಕ್ ಜಾವ್ನ್ ತುಜೊ ಮಾಮಾ ಲಾಬಾನಾಚ್ಯಾ ಎಕ್ ಲೆಕಿಕ್ ಲಗಿನ್ ಕರುನ್ ಗೆ. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ತುಕಾ ಆಶಿರ್ವಾದ್ ದಿವ್ನ್, ತುಕಾ ಲೈ ಪಿಳ್ಗಿ ದಿವ್ನ್ ಲೊಕಾಂಚ್ಯಾ ದೆಶ್ಯಾಕ್ನಿ ಬಾಬಾ ಕರುಂದಿತ್. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />ಅನಿ ಅಬ್ರಾಹಾಮಾಕ್ ದಿಲ್ಲಿ ಗೊಸ್ಟ್ ಅನಿ ಆಶಿರ್ವಾದ್ ತುಕಾ ತುಜ್ಯಾ ಪಿಳ್ಗಿ ಗಾಂವ್ದಿತ್, ಅನಿ ದೆವಾನ್ ಅಬ್ರಾಹಾಮಾಕ್ ದಿಲ್ಲೊ ಜಾಗೊ ಅನಿ ಅಮಿ ವಸ್ತಿ ಹೊತ್ತೊ ಜಾಗೊ ತುಜ್ಯಾ ತಾಬೆತ್ ಹೊಂವ್ದಿತ್, ಮನುನ್ ಧಾಡುನ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />ತಸೆಚ್ ಜಾಕೊಬ್ ಪದ್ದನ್ ಅರಾಮಿಕ್ ಬೆತುವೆಲಾಚೊ ಲೆಕ್ ರೆಬೆಕ್ಕಾಚೊ ಭಾವ್ ಲಾಬಾಚ್ಯಾ ಘರಾಕ್ ಗೆಲೊ, ರೆಬೆಕ್ಕಾ ಜಾಕೊಬಾಚಿ ಅನಿ ಎಸಾವಾಚಿ ಬಾಯ್. <verse eid="GEN 28:5" /><verse number="6" style="v" sid="GEN 28:6" />ಕಾನಾನಾಚ್ಯಾ ಚೆಡ್ವಾಕ್ನಿ ಲಗಿನ್ ಹೊವ್ವ್ ನ್ಹಯ್ ಮನುನ್ ಅಪ್ಲೊ ಬಾಬಾ ಇಸಾಕಾನ್ ಜಾಕೊಬಾಕ್ ಆಶಿರ್ವಾದ್ ದಿವ್ನ್, ಲಗಿನ್ ಹೊವ್ಕ್ ಮನುನ್ ಪದ್ದನ್ ಅರಾಮಿಕ್ ಧಾಡಲ್ಲೆ, ಅನಿ ಜಾಕೊಬಾಕ್ ಹುಕುಮ್ ದಿಲ್ಲೆ ಎಸಾವಾಕ್ ಕಳುನ್ ಯೆಲೆ. <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />ತಸೆ ರ್‍ಹಾತಾನಾ ಬಾಬಾಚ್ಯಾ ಅನಿ ಬಾಬಾಯಿಚ್ಯಾ ಗೊಸ್ಟಿಕ್ ಮಾನುನ್ ಜಾಕೊಬ್ ಪದ್ದನ್ ಅರಾಮಿಕ್ ಗೆಲೊ. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />ಅಪ್ನಾಚಿ ಲೆಕಾ ಕಾನಾನಾಚ್ಯಾ ಚೆಡ್ವಾಕ್ನಿ ಲಗಿನ್ ಕರುನ್ ಘೆತಲೆ ಬಾಬಾಕ್ ಮನ್ ನಾ ಮನುನ್ ಎಸಾವಾಕ್ ಕಳ್ಳೆ. <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />ಎಸಾವಾಕ್ ಲಗಿನ್ ಹೊವ್ನ್ ದೊನ್ ಬಾಯ್ಕಾ ಹೊತ್ತಿ, ಹೊಲ್ಯಾರ್ಬಿ ಅಬ್ರಾಹಾಮಾಚೊ ಲೆಕ್ ಇಸ್ಮಾಯೆಲಾಚಿ ಲೆಕ್ ಅನಿ ನೆಬಾಯೊತ್ಯಾಚ್ಯಾ ಭೆನ್ ಮಹಾಲತಾಕ್ ಲಗಿನ್ ಕರುನ್ಗೆತಾ.<verse eid="GEN 28:9" /></para>
  <para style="s">ಬೆತೆಲಾತ್ ಜಾಕೊಬಾಚೆ ಸಫಾನ್</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />ಜಾಕೊಬ್ ಬೆರ್ಶೆಬಾಕ್ನಾ ಹಾರಾನಾಕ್ಡೆ ಗೆಲೊ. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />ತ್ಯಾ ರಾತ್ತಿನ್ ರಾವ್ಕ್ ಎಕ್ ಬರ್‍ಯಾ ಜಾಗ್ಯಾಕ್ ತೊ ಯೆಲೊ, ಪವಿತ್ರ್ ಜಾಗ್ಯಾರ್ ಯೆವ್ನ್ ಝೊಪ್ಡೆ ಭಾಂದುನ್ ಎಕ್ ಗುಂಡ್ಯಾಕ್ ಉಸೆ ಕರುನ್ ಘೆವ್ನ್ ನಿಜ್ಲೊ. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />ತನ್ನಾ ಜಾಕೊಬಾಕ್ ಎಕ್ ಸಫಾನ್ ಪಡ್ತಾ, ಎಕ್ ನಿಸನ್ ಸರ್ಗಾಕ್ ಲಾವ್ನ್ ಜಿಮ್ನಿ ವರ್‍ತಿ ಇಬೆ ಹೊತ್ತಿ ರ್‍ಹಾತಾ, ತೆಚಿ ತುದಿ ಮಳ್ಬಾಕ್ ಪಾವಲ್ಲಿ ರ್‍ಹಾತಾ, ಜಾಕೊಬ್ ತ್ಯಾ ನಿಸನಿ ವರ್‍ತಿ ದೆವ್ ಧುತಾ ಚಡ್ತಲೆ ಅನಿ ಉತರ್ತಲೆ ಬಗ್ತಾ. <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />ಅನಿ ಥೈ ವಯ್ರ್ ಸರ್ವೆಸ್ಪರ್ ಇಬೆ ಹೊತ್ತೆ ಜಾಕೊಬಾಕ್ ದಿಸ್ತಾ, ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತೆಕಾ, “ಮಿಯಾ ತುಜ್ಯಾ ಅಜ್ಜಾ ಅಬ್ರಾಹಾಮಾಚೊ ದೆವ್ ಬಾಬಾ, ಅನಿ ಮಿಯಾ ಇಸಾಕಾಚೊ ದೆವ್, ಅತ್ತಾ ತಿಯಾ ನಿಜಲ್ಲೊ ಜಾಗೊ ಅನಿ ಹ್ಯೊ ದೆಶ್ ತುಕಾ ಅನಿ ತುಜ್ಯಾ ಪಿಳ್ಗಿ ದಿತಾ. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />ಜಿಮ್ನಿಚ್ಯಾ ವರ್‍ತಿ ಮೆಜುಕ್ ಹೊಯ್ನಾ ತವ್ಡಿ ದುಳ್ ಹಾಯ್ ನೈ ತುಜಿ ಪಿಳ್ಗಿ ತವ್ಡಿ ಲೈ ರ್‍ಹಾತಾ, ತುಜ್ಯಾ ವೈನಾ ಅನಿ ತುಜಾ ಪಿಳ್ಗಿ ವೈನಾ ವೈನಾ ಜಿಮ್ನಿ ವೈರ್ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಕುಲಾಕ್ನಿ ಆಶಿರ್ವಾದ್ ಯೆತಾ, ಅನಿ ಚಾರಿ ದಿಕ್ಕಾಕ್ಬಿ ತುಜಿ ಪಿಳ್ಗಿ ಪಗ್ಳುನ್ ಜಾತಾತ್. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />ಅನಿ ತಿಯಾ ಜಾತಲ್ಯಾ ಹರ್ ಎಕ್ ಜಾಗ್ಯಾರ್ ಮಿಯಾ ತುಕಾ ರಾಕ್ತಾ; ತುಕಾ ಪರ್‍ತುನ್ ಮಿಯಾ ಹ್ಯಾ ಜಾಗ್ಯಾಕ್ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಹಾನ್ತಾ, ಅನಿ ತುಕಾ ದಿಲ್ಲಿ ಗೊಸ್ಟ್ ಫುರಾ ಕರಿನಸ್ತಾನಾ ಮಿಯಾ ಸೊಡಿನಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />ತನ್ನಾ ಜಾಕೊಬ್ ನಿಜೆತ್ನಾ ಜಾಗೊ ಹೊವ್ನ್ “ಖರೆಚ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಹ್ಯಾ ಜಾಗ್ಯಾರ್ ಹಾಯ್ ಮನುನ್ ಮಾಕಾ ಗೊತ್ತ್ ನತ್ತೆ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />ತನ್ನಾ ಜಾಕೊಬ್ ಭಿಂವ್ಲೊ, ಅನಿ “ಹ್ಯೊ ಪವಿತ್ರ್ ಜಾಗೊ, ಹೊಯ್ ಕರೆಚ್ ದೆವಾಚೆ ಘರ್, ಅನಿ ಸರ್ಗಾಚೆ ದಾರ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />ಮಾನಾ ದುಸ್ರೆ ದಿಸಿ ಸಕ್ಕಳಿ ಜಾಕೊಬ್ ಉಟುನ್, ಅಪ್ನಿ ಟಕ್ಲ್ಯಾಚ್ಯಾ ಖಾಲ್ತಿ ಘೆಟಲ್ಯಾ ಗುಂಡ್ಯಾಕ್ ಯಾದೆಚೊ ಖಾಂಬ್ಯಾ ಸಾರ್ಕೆ ನಿಟ್ಟ ಜಿಮ್ನಿತ್ ಇಬೆ ಕರುನ್ ತ್ಯಾ ಗುಂಡ್ಯಾ ವರ್‍ತಿ ಆಲಿವ್ ತೆಲ್ ವೊತ್ಲ್ಯಾನ್ . <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />ಮಾನಾ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ ಜಾಕೊಬಾನ್ ಬೆತೆಲ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್, ಅದ್ದಿ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ ಲುಜ್ ಮನುನ್ ನಾವ್ ಹೊತ್ತೆ.<verse eid="GEN 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 28:20" />ತನ್ನಾ ಜಾಕೊಬಾನ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಪ್ರಯಾನ್ ಕರುನ್: ಅನಿ ದೆವ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾವ್ನ್ ಮಾಕಾ ರಾಕುನ್ ಜೆವಾನ್ ಅನಿ, ನೆಸುಕ್ ಕಪ್ಡೆ ದಿವ್ನ್, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />ತಿಯಾ ಮಾಜೊ ದೆವ್ ಮನುನ್ ಮಿಯಾ ಮಾಜ್ಯಾ ಬಾಬಾಚ್ಯಾ ಘರಾಕ್ ಆರಾಮಾನ್ ಜಾವ್ನ್ ಪಾವ್ತಾ. <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />ಅನಿ ಮಿಯಾ ಗೊಂಡೊ ಪುರಲ್ಲೊ ಜಾಗೊ ಪವಿತ್ರ್ ಹೊವ್ನ್ ಆರಾದನ್ ಕರ್ತಲೊ ಜಾಗೊ ಹೊವ್ನ್ ರಾಂವ್ದಿತ್, ಅನಿ ದೆವಾನ್ ದಿಲ್ಲ್ಯಾ ಧಾತ್ಲೊ ಎಕ್ ಭಾಗ್, ಮಿಯಾ ದೆವಾಕ್ ದಿತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">ಜಾಕೊಬ್ ಲಾಬಾನಾಚ್ಯಾ ಘರಾಕ್ ಪಾವ್ಲೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />ಮಾನಾ ಜಾಕೊಬ್ ಚಲುನ್ಗೆತ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ಲ್ಯಾ ದೆಸಾಕ್ ಜಾವ್ನ್ ಪಾವ್ಲೊ, <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />ತನ್ನಾಚ್ ತೆಕಾ ತ್ಯಾ ಡಂಗ್ಳಿತ್ ಎಕ್ ಭಾಂಯ್ ದಿಸ್ಲಿ, ಅಬಕ್ ಥೈ ತ್ಯಾ ಬಾಂಯ್ಚ್ಯಾ ಜಗ್ಗೊಳ್ ತಿನ್ ಶೆಳಿಯಾಂಚೆ ತಾಂಡೆ ಬಸುನ್ ಹೊತ್ತೆ, ತ್ಯಾ ಭಾಂಯ್ಚೆ ಪಾನಿ ಶೆಳಯಾಕ್ನಿ ಫಿವ್ಸಿತ್, ತ್ಯಾ ಭಾಂಯಿ ವರ್‍ತಿ ಧಾಪಲ್ಲೊ ಗುಂಡೊ ಮೊಟೊ ಹೊತ್ತೊ. <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />ಥೈ ಫುರಾ ಶೆಳಿಯಾ ಗೊಳಾ ಹೊವ್ನ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ ಭಾಂಯಿ ವೈಲೊ ಗುಂಡೊ ಢಕ್ಲುನ್ ಕಾಡುನ್ ಶೆಳಿಯಾಕ್ನಿ ಪಾನಿ ಪಾಜ್ವುನ್ ಪರ್‍ತುನ್ ದಾಪುನ್ ಥೈತ್.<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />ಜಾಕೊಬಾನ್ ತೆಂಕಾ, “ಭಾವಾನೊ ತುಮಿ ಕಲ್ಯಾ ಗಾಂವ್ಚೆ?” ಮನುನ್ ಇಚಾರ್‍ತಾನಾ ತೆನಿ ,</para>
  <para style="q1" vid="GEN 29:4">“ಅಮಿ ಹಾರಾನ್ ಮನ್ತಲ್ಯಾ ಗಾಂವ್ಚೆ” ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />ತನ್ನಾ “ನಾಹೊರಾಚೊ ನಾತು ಲಾಬಾನಾಚಿ ತುಮ್ಕಾ ಒಳಕ್ ಹಾಯ್ ಕಾಯ್?” ಮನುನ್ ಇಚಾರ್‍ತಾನಾ, “ವಳಕ್ತಾಂವ್” ಮನುನ್ ಜವಾಬ್ ದಿಲ್ಯಾನಿ.<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />“ತೆನಿ ಸಗ್ಳೆ ಆರಾಮ್ ಕಾಯ್?” ಮನುನ್ ಇಚ್ಯಾರ್ತಾನಾ “ಹೊಯ್ ತೆನಿ ಆರಾಮ್ ಹಾತ್ ಅಬಕ್ ತೆಚಿ ಲೆಕ್ ರಾಖೆಲ್ ಶೆಳಿಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಯೆವ್ಲಾ” ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />ತನ್ನಾ ಜಾಕೊಬಾನ್, “ಶೆಳಿಯಾಕ್ನಿ ಪಾನಿ ಫಿವ್ಸುನ್ ಚಾರ್ವುಕ್ ಕಶ್ಯಾಕ್ ಸೊಡಿನ್ಯಾಸಿ? ಅಜುನ್ ದಿಸ್ ಬುಡುಕ್ ಲೈ ಎಳ್ ಹಾಯ್; ಶೆಳಿಯಾಕ್ನಿ ಗೊಳಾ ಕರ್ತಲೊ ಎಳ್ ಹೊವ್ನಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />ತನ್ನಾ ತೆನಿ “ಸಗ್ಳೆ ಜಾನಾ ಶೆಳಿಯಾ ರಾಕ್ತಲ್ಯಾನಿ ಗೊಳಾ ಹೊವ್ನ್ ಭಾಂಯಿ ವರ್‍ತಿ ಧಾಪಲೊ ಗುಂಡೊ ಕಾಡಿ ಪತರ್ ಪಾನಿ ಫಿವಸ್ತಲೆ ನಾ, ತೊ ಗುಂಡೊ ಸರಕಲ್ಲ್ಯಾ ತನ್ನಾಚ್ ಶೆಳಿಯಾಕ್ನಿ ಪಾನಿ ಫಿವ್ಸುತಾಂವ್”, ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />ಜಾಕೊಬ್ ಅಜುನ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲುನ್ಗೆತ್ ರ್‍ಹಾತಾನಾಚ್ ಶೆಳಿಯಾ ರಾಕುಂಗೆತ್ ರಾಹೆಲ್ ಅಪ್ಲ್ಯಾ ಬಾಬಾಚಿ ಶೆಳಿಯಾ ಹಾಂಬ್ಡುನ್ ಘೆವ್ನ್ ಯೆವ್ನ್ ಪಾವ್ಲಿ. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />ಅಪ್ಲೊ ಮಾವ್ಳೊ ಲಾಬಾನಾಚಿ ಲೆಕ್ ರಾಖೆಲ್ ಅನಿ ತೆಚಿ ಶೆಳಿಯಾ ಬಗಟಲ್ಲೊ ತಸೊಚ್ ಜಾಕೊಬಾನ್ ಭಾಂಯಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ಜಾವ್ನ್ ಗುಂಡೊ ಸರ್ಕುನ್ ಮಾವ್ಳ್ಯಾಚ್ಯಾ ಶೆಳಿಯಾಕ್ನಿ ಪಾನಿ ಫಿವ್ಸುಲ್ಯಾನ್.<verse eid="GEN 29:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 29:11" />ಅನಿ ಜಾಕೊಬಾನ್ ರಾಖೆಲಾಕ್ ಉಪ್ಪಾ ದಿಲ್ಯಾನ್; ಅನಿ ಮೊಟ್ಯಾನ್ ರಡ್ಲ್ಯಾನ್,<verse eid="GEN 29:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 29:12" />ಅಪ್ನಿ ತಿಚ್ಯಾ ಬಾಬಾಚೊ ಭಾಚೊ, ರೆಬೆಕಾಚೊ ಲೆಕ್ ಮಟ್ಲ್ಯಾನ್, ರಾಖೆಲಾನ್ ಲಗ್ಗುನಾ ಪಳುನ್ಗೆತ್ ಜಾವ್ನ್ ಹಿ ಖಬರ್ ಅಪ್ಲ್ಯಾ ಬಾಬಾಕ್ ಸಾಂಗ್ಲಿನ್. <verse eid="GEN 29:12" /><verse number="13" style="v" sid="GEN 29:13" />ಲಾಬಾನಾನ್ ಅಪ್ಲೊ ಭಾಚೊ ಯೆಲ್ಲಿ ಖಬರ್ ಆಯ್ಕುನ್ ತೆಕಾ ಭೆಟುಕ್ ಮನುನ್ ಪಳುನ್ಗೆತ್ ಗೆಲೊ, ಅನಿ ಜಾಕೊಬಾಕ್ ಯಾಂಗ್ ಮಾರುನ್ ಉಪ್ಪಾ ದಿವ್ನ್, ಘರಾಕ್ ಬಲ್ವುನ್ ನ್ಹೆಲ್ಯಾನ್, ಜಾಕೊಬಾನ್ ಹೊಲ್ಲಿ ಖಬರ್ ಫುರಾ ಲಾಬಾನಾಕ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />ಲಾಬಾನಾನ್ “ತಿಯಾ ಖರೆಚ್ಬಿ ಮಾಜ್ಯಾ ರಗ್ತಾಚೊ ಸಮಂದಿಕ್ ” ಮಟ್ಲ್ಯಾನ್ ಜಾಕೊಬ್ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಎಕ್ ಮ್ಹೈನೊ ಪತರ್ ವಸ್ತಿ ರಾಲೊ.<verse eid="GEN 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 29:15" />ಎಕ್ ದಿಸ್ ಲಾಬಾನಾನ್ ತಿಯಾ ಮಾಜೊ ಸಮಂದಿಕ್ ಮನುನ್ ತುಜ್ಯಾಕ್ಡೆ ಫುಕೊಟ್ ಕಾಮ್ ಕರುನ್ ಘೆತಲೆ ಬರೆ ನೈ; ತುಜ್ಯಾ ಕಾಮಾಕ್ ಕಾಯ್ ಪಗಾರ್ ದಿವ್ಚೆ ಸಾಂಗ್? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ. <verse eid="GEN 29:15" /><verse number="16" style="v" sid="GEN 29:16" />ಲಾಬಾನಾಕ್ ದೊನ್ ಲೆಕಿಯಾ ಹೊತ್ತಿ ಥೊರ್ಲಿಚೆ ನಾವ್ ಲೆಯಾ ಅನಿ ಧಾಕ್ಲಿಚೆ ನಾವ್ ರಾಖೆಲ್. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />ಲೆಯಾಚೆ ಡೊಳೆ ತಿರ್ಸೆ ಹೊತ್ತೆ ಅನಿ ರಾಖೆಲ್ ಅಂಗಾನ್ ಅನಿ ನಾಕಾ ಡೊಳ್ಯಾನಿ ಲೈ ಸುಂದರ್ ಹೊತ್ತಿ.<verse eid="GEN 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 29:18" />ಜಾಕೊಬಾಕ್ ರಾಖೆಲಾ ವರ್‍ತಿ ಪ್ರೆಮ್ ಹೊಲ್ಲೊ ಅನಿ ತೆನಿ “ತುಜಿ ಧಾಕ್ಲಿ ಲೆಕ್ ರಾಖೆಲಾಕ್ ಲಗಿನ್ ಹೊವ್ಕ್ ಸಾಟ್ನಿ ತುಜೆಕ್ಡೆ ಸಾತ್ ವರಿಸ್ ಕಾಮ್ ಕರ್ತಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />ಲಾಬಾನಾನ್ “ತಿಯಾ ಮಾಜೆಕ್ಡೆಚ್ ರಾ ತಿಕಾ ದುಸ್ರ್ಯಾಕ್ನಿ ದಿತಲ್ಯಾ ಕಿಂತಾ ತುಕಾಚ್ ದಿತಲೆ ಬರೆ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 29:20" />ತಸೆಚ್ ಜಾಕೊಬಾನ್ ರಾಖೆಲಾಸಾಟ್ನಿ ಸಾತ್ ವರಿಸ್ ಪತರ್ ಕಾಮ್ ಕರ್ಲ್ಯಾನ್ ತಿಚೆ ವರ್‍ತಿ ತೆಕಾ ಲೈ ಪ್ರೆಮ್ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ತೆಕಾ ಉಲ್ಲಿಚ್ ದಿಸಾ ಕಾಮ್ ಕರಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ದಿಸ್ಲೆ.<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />ಮಾನಾ ಜಾಕೊಬಾನ್ ಮಾಜಿ ಕಾಮಾಚಿ ದಿಸಾ ಸರ್ಲಿ ತುಜ್ಯಾ ಲೆಕಿಕ್ ಮಾಕಾ ಲಗಿನ್ ಕರುನ್ ದಿ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 29:21" /><verse number="22" style="v" sid="GEN 29:22" />ತನ್ನಾ ಲಾಬಾನಾನ್ ಗಾಂವ್ಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ಬಲ್ವುನ್ ಲಗ್ನಾಚೆ ಜೆವಾನ್ ಘಾಟ್ಲ್ಯಾನ್. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />ಖರೆ ರ್‍ಹಾತ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಲಾಬಾನಾನ್ ಅಪ್ಲಿ ಥೊರ್ಲಿ ಲೆಕ್ ಲೆಯಾಕುಚ್ ಜಾಕೊಬಾಕ್ಡೆ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್ ಅನಿ ಜಾಕೊಬ್ ತಿಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳ್ಲೊ. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />ಅನಿ ಲಾಬಾನಾನ್ ಅಪ್ಲಿ ಲೆಕ್ ಲೆಯಾಕ್ ಜಿಲ್ಬಾ ಮನ್ತಲಿ ಆಳ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />ಜಾಕೊಬಾಕ್ ಸಕ್ಕಾಳಿ ಬಗ್ತಾನಾ ತಿ ಲೆಯಾ ಮನುನ್ ಕಳ್ಳೆ, ಅನಿ ತೆನಿ ಮಿಯಾ ಕಾಮ್ ಕರಲೆ ರಾಖೆಲಾ ಸಾಟ್ನಿ , ತಿಯಾ ಅಸೆ ಕಶ್ಯಾಕ್ ಕರ್‍ಲೆ ? ಮಾಕಾ ಕಶ್ಯಾಕ್ ಪಸ್ವುಲೆಯ್? ಮನುನ್ ಲಾಬಾನಾಕ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />ತನ್ನಾ ಲಾಬಾನಾನ್ ಥೊರ್ಲ್ಯಾ ಲೆಕಿಕ್ ಹುರ್ವುನ್ ಘೆವ್ನ್ ಧಾಕ್ಲ್ಯಾ ಲೆಕಿಕ್ ಲಗಿನ್ ಕರುನ್ ದಿತಲಿ ಅಮ್ಚ್ಯಾ ಹಿತ್ತೆತ್ಲಿ ಪಜ್ಜತ್ ನಾ, <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />ಥೊರ್ಲಿಚ್ಯಾ ವಾಂಗ್ಡಾ ಲಗ್ನಾಚಿ ಸಾಸ್ತರಾ ಸಗ್ಳಿ ಸಾರುನ್ಗೆ ಮಾನಾ ಅನಿ ಪರ್‍ತುನ್ ಸಾತ್ ವರಿಸ್ ಕಾಮ್ ಕರ್‍ತೆ ಹೊಲ್ಯಾರ್ ದಾಕ್ಲ್ಯಾ ಲೆಕಿಕ್ಬಿ ಲಗಿನ್ ಕರುನ್ ದಿತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />ಜಾಕೊಬಾನ್ ಹೆಕಾ ಒಪ್ಪುನ್ ಥೊರ್ಲಿ ವಾಂಗ್ಡಾ ಲಗ್ನಾಚಿ ಸಾಸ್ತರಾ ಸಾರ್ಲ್ಯಾನ್ , ಮಾನಾ ಲಾಬಾನಾನ್ ಅಪ್ಲಿ ಧಾಕ್ಲಿ ಲೆಕ್ ರಾಹೆಲಾಕ್ ತೆಕಾ ಲಗಿನ್ ಕರುನ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />ಅಪ್ಲ್ಯಾಚಿ ಆಳ್ ಬಿಲ್ಹಾಕ್, ಅಪ್ನಾಚ್ಯಾ ಲೆಕಿಕ್ ಆಳ್ ಕರುನ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />ಜಾಕೊಬ್ ರಾಹೆಲಾ ವಾಂಗ್ಡಾ ಮಿಳ್ಲೊ ತಿಕಾ ಲೆಯಾ ಕಿಂತಾಬಿ ಲೈ ಪ್ರೆಮ್ ಕರ್ಲ್ಯಾನ್, ಅನಿ ತಿಕಾ ಲಾಗುನ್ ಅನಿ ಸಾತ್ ವರಿಸ್ ಲಾಬಾನಾಚಿ ಸೆವಾ ಕರ್ಲ್ಯಾನ್.<verse eid="GEN 29:30" /></para>
  <para style="s">ಜಾಕೊಬಾಕ್ ಪೊರಾ</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಜಾಕೊಬಾಕ್ ಲೆಯಾಚ್ಯಾ ವರ್‍ತಿ ಪ್ರೆಮ್ ಕಮ್ ಹೊಲೊ, ಹೆ ಬಗುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತಿಕಾ ಪೊಟಾನ್ ರ್‍ಹಾತಲೆ ಆಶಿರ್ವಾದ್ ದಿಲ್ಯಾನ್, ಅನಿ ರಾಹೆಲ್ ವಾಂಜ್ಡಿ ಹೊವ್ನ್ ರಾಲಿ. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />ಲೆಯಾ ಪೊಟಾನಿ ರ್‍ಹಾವ್ನ್ ಲೆಕಾಕ್ ಜಲಮ್ ದಿಲಿನ್, ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾಜೊ ತರಾಸ್ ಬಗ್ಲ್ಯಾನ್ ಅನಿ ಮಾಜೊ ನ್ಹೌರೊ ಮಾಕಾ ಹೆಜ್ಯಾನ್ ಫಿಡೆ ಪ್ರೆಮ್ ಕರ್ತಾ ಮನುನ್ಗೆವ್ನ್ ತ್ಯಾ ಲೆಕಾಕ್ ರುಬೆನ್ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್. <verse eid="GEN 29:32" /><verse number="33" style="v" sid="GEN 29:33" />ತಿನಿ ಅನಿಬಿ ಪೊಟಾನಿ ರ್‍ಹಾವ್ನ್ ಲೆಕಾಕ್ ಜಲಮ್ ದಿಲಿನ್, ಮಾಕಾ ನ್ಹೌರೊ ಸಮಾ ಬಗಿ ನಸಿ ತೆ ಕಳುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾಕಾ ಲೆಕ್ ದಿಲಾ ಮನುನ್ ತೆಕಾ ಸಿಮೆಯೊನ್ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್. <verse eid="GEN 29:33" /><verse number="34" style="v" sid="GEN 29:34" />ಅನಿಬಿ ಪೊಟಾನಿ ರ್‍ಹಾವ್ನ್ ಲೆಕಾಕ್ ಜಲಮ್ ದಿವ್ನ್ ಮಾಜ್ಯಾ ನ್ಹವ್ರ್ಯಾಕ್ ತಿನ್ ಲೆಕಾಕ್ನಿ ಜಲಮ್ ದಿಲೊ ಅತ್ತಾತರಿಬಿ ಅಮಿ ಎಕ್ ಹೊತಲಾಂವ್ ಮನುನ್ ತೆಕಾ ಲೆವಿ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್. <verse eid="GEN 29:34" /><verse number="35" style="v" sid="GEN 29:35" />ಅನಿಬಿ ಪರ್‍ತುನ್ ಪೊಟಾನಿ ರ್‍ಹಾವ್ನ್ ಲೆಕಾಕ್ ಜಲಮ್ ದಿವ್ನ್ ಅತ್ತಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಸ್ತುತಿ ಕರ್ತಾ ಮನುನ್ ತೆಕಾ ಜೆಹುದಾ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್, ಮಾನಾ ತಿಕಾ ಪೊರಾ ಹೊತಲಿ ಬಂದ್ ಹೊಲೆ.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />ರಾಖೆಲಾನ್ ಅಪ್ನಿ ಜಾಕೊಬಾಕ್ ಪೊರಾ ಉಪಾಜುಕ್ ಹೊವ್ಕ್ನಾ ಮನುನ್ ಅಪ್ಲ್ಯಾ ಥೊರ್ಲ್ಯಾ ಭೆನ್ ವರ್‍ತಿ ಹೊಟ್ಟೆಕಿಚ್ ಕರುನ್ಗೆಟ್ಲಿನ್ ಅನಿ ಜಾಕೊಬಾಕ್ಡೆ ಮಾಕಾ ಪೊರಾ ದಿ ನಾತರ್ ಮಿಯಾ ಮರುನ್ ಜಾತಾ ಮಟ್ಲಿನ್.<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />ಜಾಕೊಬಾಕ್ ತಿಚೆ ವರ್‍ತಿ ರಾಗ್ ಹೊವ್ನ್, ಮಿಯಾ ಕಾಯ್ ದೆವ್ ಕಾಯ್ ತುಕಾ ಪೊರಾ ದಿಯ್ ನಸ್ತಾನಾ ರಾವ್ಕ್ ಮಿಯಾ ದೆವಾಚೊ ಜಾಗೊ ಘೆವ್ಕ್ ಹೊಯ್ನಾ, ಮನುನ್ ಜವಾಬ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />ತೆಕಾ ರಾಖೆಲಾನ್ ಮಾಜಿ ದಾಸಿ ಬಿಲ್ಹಾ ಹಾಯ್ ನೈ? ತಿಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳುನ್ ತಿಚ್ಯಾ ಪೊರಾಕ್ ಜಲಮ್ ದಿವ್ನ್ ಮಾಜ್ಯಾ ಹೊಟ್ಟ್ಯಾತ್ ಘಾಲುಂದಿತ್ ತನ್ನಾ ತಿಚ್ಯಾ ವೈನಾ ಮಾಜಿ ಪಿಳ್ಗಿ ಹೊತಲಿ, ಮಟ್ಲಿನ್. <verse eid="GEN 30:3" /><verse number="4" style="v" sid="GEN 30:4" />ಅನಿ ತಸೆಚ್ ಆಳ್ ಬಿಲ್ಹಾಕ್ ಅಪ್ಲ್ಯಾ ನ್ಹೌರಾಕ್ ಒಪ್ಸುನ್ ದಿಲಿನ್, ಜಾಕೊಬ್ ತಿಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳ್ಳೊ. <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />ತಿ ಪೊಟಾನ್ ರ್‍ಹಾವ್ನ್ ಎಕ್ ಲೆಕಾಕ್ ಜಲಮ್ ದಿಲಿನ್. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />ತನ್ನಾ ರಾಖೆಲಾನ್ ದೆವಾನ್ ಮಾಕಾ ನ್ಯಾಯ್ ದಿಲ್ಯಾನ್, ಮಾಜಿ ಮಾಗ್ನಿ ಆಯ್ಕುನ್ ಮಾಕಾ ಲೆಕ್ ದಿಲ್ಯಾನ್ ಮನುನ್ ಲೆಕಾಕ್ “ದಾನ್” ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್. <verse eid="GEN 30:6" /><verse number="7" style="v" sid="GEN 30:7" />ತಿ ಆಳ್ ಬಿಲ್ಹಾ ಅನಿಬಿ ಪೊಟಾನ್ ರ್‍ಹಾವ್ನ್ ಜಾಕೊಬಾಚ್ಯಾ ದೊನ್ವೆಚ್ಯಾ ಲೆಕಾಕ್ ಜಲಮ್ ದಿಲಿನ್, <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />ತನ್ನಾ ರಾಖೆಲಾನ್ ಅಪ್ಲ್ಯಾ ಭೆನಿಚ್ಯಾ ವಾಂಗ್ಡಾ ಲೈ ಇರ್ಸೆನ್ ಜಿಕ್ಲೊ ಮನುನ್ ತ್ಯಾ ಲೆಕಾಕ್ “ನಪ್ತಾಲಿ” ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್.<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />ಲೆಯಾನ್ ಅಪ್ನಾಕ್ ಪೊರಾ ಹೊತಲೆ ಬಂದ್ ಹೊಲಿ ಬಗುನ್ ಅಪ್ಲಿ ಆಳ್ ಜಿಲ್ಪಾಕ್ ಜಾಕೊಬಾಚಿ ಬಾಯ್ಕೊ ಕರುನ್ ದಿಲಿನ್. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />ಜಿಲ್ಪಾಕ್ಬಿ ಜಾಕೊಬಾಚೊ ಲೆಕ್ ಉಪಜ್ಲೊ. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />ಲೆಯಾನ್ ಅಪ್ನಾಕ್ ಬರೆಚ್ ಹೊಲೆ ಮನುನ್ ತ್ಯಾ ಲೆಕಾಕ್ “ಗಾದ್” ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್. <verse eid="GEN 30:11" /><verse number="12" style="v" sid="GEN 30:12" />ಲೆಯಾಚಿ ಆಳ್ ಜಿಲ್ಪಾನ್ ಜಾಕೊಬಾಚ್ಯಾ ಅನಿ ಎಕ್ ಲೆಕಾಕ್ ಜಲಮ್ ದಿಲಿನ್. <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />ತನ್ನಾ ಲೆಯಾನ್, ಮಿಯಾ ಕವ್ಡಿ ನಸಿಬ್ ವಾಲಿ ಅತ್ತಾ ಮಾಕಾ ಬಾಯ್ಕಾ ನಸಿಬ್ ವಾಲಿ ಮನ್ತಾತ್ ತಸಿ ಮನುನ್ ತ್ಯಾ ಲೆಕಾಕ್ “ಅಶೆರ್” ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್.<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />ಘಂವಾಚ್ಯಾ ಕಾತ್ರನಿಚ್ಯಾ ಎಳಾರ್ ರುಬೆನ್ ಸೆತಾಕ್ಡೆ ಜಾಯ್ತ್ ರ್‍ಹಾತಾನಾ, ಮಾಂಡ್ರೆಕಾ ಬಗಟ್ಲ್ಯಾನ್, ಅನಿ ತಿ ಹಾನುನ್ ಅಪ್ಲ್ಯಾ ಬಾಯ್ಕ್ ದಿಲ್ಯಾನ್, ತನ್ನಾ ರಾಖೆಲಾನ್ ತಿಕಾ “ಭೆನಿ ತುಜ್ಯಾ ಲೆಕಾನ್ ಹಾನಲ್ಯಾ ಮಾಂಡ್ರೆಕಾತ್ನಿ ಉಲ್ಲಿ ಮಾಕಾಬಿ ದಿ” ಮನುನ್ ಮಾಗ್ಲಿನ್.<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />ತನ್ನಾ ಲೆಯಾನ್ ತಿಯಾ ಮಾಜ್ಯಾ ನ್ಹೌರಾಕ್ ಚೊರಲ್ಲೆ ನೈ ಕರುನ್ ಮಾಜ್ಯಾ ಲೆಕಾನ್ ಹಾನಲಿ ಹನ್ನಾಬಿ ಘೆವ್ಕ್ ಯೆಲೈ ಕಾಯ್? ಮನುನ್ ಸಾಂಗ್ಲಿನ್, ತನ್ನಾ ರಾಖೆಲಾನ್ “ತಿಯಾ ತುಜ್ಯಾ ಲೆಕಾನ್ ಹಾನಲಿ ಮಾಂಡ್ರೆಕಾ ಮಾಕಾ ದಿಲ್ಯಾರ್ ಆಜ್ ರಾತ್ತಿನ್ ನ್ಹೌರೊ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳ್ತಾ” ಮಟ್ಲಿನ್.<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />ಸಾಂಜೆಕ್ಡೆ ಜಾಕೊಬ್ ಸೆತಾಕ್ನಾ ಘರಾಕ್ ಯೆತಾನಾ ಲೆಯಾ ತೆಚ್ಯಾ ಇದ್ರಾಕ್ ಯೆವ್ನ್ “ತಿಯಾ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳುಚೆ ಮಾಜ್ಯಾ ಲೆಕಾನ್ ಹಾನಲಿ ಮಾಂಡ್ರೆಕಾ ದಿವ್ನ್ ಮಿಯಾ ತುಕಾ ಇಕಾತ್ ಘೆಟ್ಲಾ,” ಮಟ್ಲಿನ್ ತ್ಯಾ ದಿಸಿ ರಾತ್ತಿನ್ ಜಾಕೊಬ್ ತಿಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳ್ಲೊ.<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />ದೆವಾನ್ ಲೆಯಾಚಿ ಮಾಗ್ನಿ ಆಯ್ಕ್ಲ್ಯಾನ್ ಅನಿ ತಿ ಪೊಟಾನಿ ರ್‍ಹಾವ್ನ್ ಜಾಕೊಬಾಚ್ಯಾ ಪಾಂಚ್ವೆಚ್ಯಾ ಲೆಕಾಕ್ ಜಲಮ್ ದಿಲಿನ್. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />ಮಿಯಾ ಮಾಜಿ ಆಳ್ ನ್ಹೌರ್ಯಾಕ್ ಒಪಸಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ದೆವಾನ್ ಮಾಕಾ ಭೊಮಾನ್ ದಿಲ್ಯಾನ್ ಮನುನ್ ತ್ಯಾ ಪೊರಾಕ್ ಇಸ್ಸಾಕಾರ್ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್. <verse eid="GEN 30:18" /><verse number="19" style="v" sid="GEN 30:19" />ಲೆಯಾ ಅನಿ ಪರ್‍ತುನ್ ಪೊಟಾನ್ ರ್‍ಹಾವ್ನ್ ಜಾಕೊಬಾಚ್ಯಾ ಸಾವೆಚ್ಯಾ ಲೆಕಾಕ್ ಜಲಮ್ ದಿಲಿನ್. <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />ದೆವಾನ್ ಮಾಕಾ ಲೈ ಕಿಮ್ತಿಚೆ ಭೊಮಾನ್ ದಿಲ್ಯಾನ್, ಮಿಯಾ ಮಾಜ್ಯಾ ನ್ಹೌರ್ಯಾ ಸಾಟ್ನಿ ಸಾ ಲೆಕಾಕ್ನಿ ಜಲಮ್ ದಿಲೊ ತೆಕಾ ಲಾಗುನ್ ತೊ ಮಾಕಾ ಸ್ವಿಕಾರ್ ಕರುನ್ಗೆತಾ ಅನಿ ಗೌರವಾನ್ ಬಗ್ತಾ ಮನುನ್ ತ್ಯಾ ಲೆಕಾಕ್ ಜೆಬೊಲೊನ್ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್. <verse eid="GEN 30:20" /><verse number="21" style="v" sid="GEN 30:21" />ಮಾನಾ ತಿನಿ ಎಕ್ ಚೆಡ್ವಾಕ್ ಜಲಮ್ ದಿವ್ನ್ ತಿಕಾ ದಿನ್ಹಾ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />ಹೆ ಹೊಲ್ಯಾ ಮಾನಾ ದೆವಾನ್ ರಾಖೆಲಾಕ್ ಯಾದ್ ಕರುನ್ ಘೆವ್ನ್ ತಿಜಿ ಮಾಗ್ನಿ ಆಯ್ಕುನ್ ತಿಬಿ ಪೊಟಾನಿ ರ್‍ಹಾಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />ತಿ ಪೊಟಾನಿ ರ್‍ಹಾವ್ನ್ ಎಕ್ ಲೆಕಾಕ್ ಜಲಮ್ ದಿಲಿನ್ ದೆವಾನ್ ಮಾಕಾ ಹೊತ್ತೊ ಅವ್ಮಾನ್ ದುರ್ ಕರ್ಲ್ಯಾನ್, <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾಕಾ ಅನಿಬಿ ಎಕ್ ಲೆಕ್ ದಿಂವ್ದಿತ್ ಮನುನ್ ತ್ಯಾ ಪೊರಾಕ್ ಜೊಸೆಪ್ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್.<verse eid="GEN 30:24" /></para>
  <para style="s">ಜಾಕೊಬ್ ಅನಿ ಲಾಬಾನಾಚೆ ಕರಾರ್</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />ರಾಖೆಲಾಕ್ ಜುಜೆ ಉಪಾಜಲ್ಲ್ಯಾ ಮಾನಾ ಜಾಕೊಬಾನ್ ಲಾಬಾನಾಕ್ , ಮಿಯಾ ಮಜ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಗಾಂವಾಕ್ ಜಾವ್ಕ್ ಒಪ್ಕಿ ದಿವಾ. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />ಮಿಯಾ ಘೊಳುನ್ ಖಮ್ವಲ್ಲಿ ಬಾಯ್ಕಾ ಪೊರಾ ಸಗ್ಳಿ ಧಾಡುನ್ ದಿ ಮಿಯಾ ಜಾತಾ ತುಮ್ಚಿ ಲೈ ಸೆವಾ ಕರ್ಲಾ ಮನುನ್ ತುಮ್ಕಾ ಗೊತ್ತ್ ಹಾಯ್, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />ತೆಕಾ ಲಾಬಾನಾನ್ ಮಾಜೆ ವರ್‍ತಿ ದಯಾ ಕರುನ್ ಹಿತ್ತೆಚ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ರಾ ತುಜ್ಯಾ ವೈನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾಕಾ ಆಶಿರ್ವಾದ್ ಕರ್ಲಾ ಮನ್ತಲೆ ಮಾಕಾ ದಿಸುನ್ ಯೆವ್ಲಾ. <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />ತುಕಾ ಕಾಯ್ ಪಗಾರ್ ದಿವ್ಚೆ ಸಾಂಗ್ ಮಿಯಾ ದಿತಾ ಮನುನ್ ಜವಾಬ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />ತೆಕಾ ಜಾಕೊಬಾನ್ ಮಿಯಾ ರಾಕಲ್ಲಿ ಜನಾವರಾ ಕಸಿ ವಾಡ್ವಳ್ಕಿ ಹೊಲಾತ್ ಮನುನ್ ತುಕಾಚ್ ಗೊತ್ತ್ ಹಾಯ್. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />ಮಿಯಾ ಯೆವ್ಚೆ ಪೈಲೆ ತುಜ್ಯಾಕ್ಡೆ ಉಲ್ಲಿಸಿಚ್ ಜನಾವರಾ ಹೊತ್ತೆ ಸಗ್ಳೆಬಿ ವಾಡ್ವಳ್ಕಿ ಹೊಲಾ, ಮಿಯಾ ಖೈ ಜಾತಾ ಥೈ ತುಕಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಆಶಿರ್ವಾದ್ ದಿಲಾ, ಖರೆ ಮಿಯಾ ಮಾಜ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಘರಾನಾ ಸಾಟ್ನಿ ಕನ್ನಾ ಖಮ್ವುತಲೆ? ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />ತನ್ನಾ ಲಾಬಾನಾನ್, ಮಿಯಾ ತುಕಾ ಕಾಯ್ ದಿವ್ಚೆ ಸಾಂಗ್ ?ಮಟ್ಲ್ಯಾನ್. ಜಾಕೊಬಾನ್ ಮಾಕಾ ಕಾಯ್ಬಿ ದಿತಲೆ ನಕ್ಕೊ ಎಕುಚ್ ಕಾಮಾಕ್ ಒಪ್ಕಿ ದಿಲ್ಯಾರ್ ಫಿರೆ ಮಿಯಾ ಅನಿ ಪರ್‍ತುನ್ ತುಜ್ಯಾ ಶೆಳಿಯಾಂಚೊ ತಾಂಡೊ ಚಾರ್ವುನ್ ಹಾನ್ತಾ. <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್ ಆಜ್ ಮಿಯಾ ತುಜ್ಯಾ ಶೆಳಿಯಾಂಚ್ಯಾ ತಾಂಡ್ಯಾಕ್ ಚಾರ್ವುಕ್ ಜಾತಾ, ಬಕ್ರ್ಯಾಂಚ್ಯಾ ಪೆಟ್ಯಾತ್ನಿ ಕಾಳಿ ಹೊತ್ತಿ ಅನಿ ಶೆಳಿಯಾಂಚ್ಯಾ ಪೆಟ್ಯಾತ್ನಿ ಹಂಡೆ ಬಂಡೆ ಹೊತ್ತೆ ಎಗ್ಳೆ ಕರ್ ಅನಿ ತೊಚ್ ಮಾಜೊ ಪಗಾರ್. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />ಮಿಯಾ ಖರೊ ಹಾಯ್ ಕಿ ನಾ ಮನುನ್ ತಿಯಾ ಯೆವ್ನ್ ಪರಿಕ್ಷಾ ಕರ್ತಾನಾ ತುಕಾ ಕಳುನ್ ಯೆತಾ ಮಾಜ್ಯಾಕ್ಡೆ ಹಂಡೆ ಬಂಡೆ ನಸಲ್ಲಿ ಶೆಳಿಯಾ ನಾ ಹೊಲ್ಲಿ ರಾಲ್ಯಾರ್ ಅನಿ ಕಾಳ್ಯಾ ರಂಗಾಚಿ ಬಕ್ರಿಯಾ ನಾಹೊವ್ನ್ ದುಸ್ರಿ ರಾಲ್ಯಾರ್ ಮಿಯಾ ಚೊರ್ಲಾ ಮನುನ್ ಚಿಂತ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />ತನ್ನಾ ಲಾಬಾನಾನ್, “ಬರೆ ತಿಯಾ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಹೊಂವ್ದಿತ್” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />ಖರೆ ಲಾಬಾನಾನ್ ತ್ಯಾಚ್ ದಿಸಿ ಪಾಲ್ವ್ಯಾತ್ನಿ ಹಂಡೆ ಬಂಡೆ ಹೊತ್ತ್ಯಾಕ್ನಿ ಅನಿ, ಶೆಳಿಯಾತ್ನಿ ಢಾನೆ ಢಾನೆ ಹೊತ್ತ್ಯಾಕ್ನಿ ಮಟ್ಲ್ಯಾರ್, ಉಲ್ಲೆ ಗೊರೊ ರಂಗ್ ದಿಸ್ತಲ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿ, ಬಕ್ರ್ಯಾಂಚ್ಯಾ ಪೆಟ್ಯಾತ್ನಿ ಕಾಳಿ ದಿಸ್ತಲಿ ಎಗ್ಳುನ್ ಅಪ್ಲ್ಯಾ ಲೆಕಾಂಚ್ಯಾ ತಾಬೆತ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />ತನ್ನಾ ಲಾಬಾನಾನ್ ಅಪ್ನಾಕ್ ಅನಿ ಅಪ್ಲಿ ಶೆಳಿಯಾ ರಾಕುಲಾಗಲ್ಯಾ ಜಾಕೊಬಾಕ್ಬಿ ತಿನ್ ದಿಸ್ ಪರ್ಯಾನ್ ಕರುನ್ ಜಾಯ್ ಸಾರ್ಕೆ ಧುರ್ ಕರುನ್ ಅಪ್ಲ್ಯಾ ಬಕ್ರ್ಯಾಂಚ್ಯಾ ಹಿಂಡಾಕ್ ಚಾರ್ವುಲ್ಯಾನ್.<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಜಾಕೊಬಾನ್ ಚಿನಾರು, ಬಾದಾಮಿ, ಅರ್ಮೊನ್ ಮನ್ತಲ್ಯಾ ಝಾಡಾಂಚಿ ಹಿರ್ವಿ ಟಾಳಿಯಾ ಘೆವ್ನ್ ಪಟ್ಟಿ ಪಟ್ಟಿಯಾ ಕರುನ್ ಚಿರುನ್ ತ್ಯಾತುರ್ಲೊ ಗೊರೊ ರಂಗ್ ದಿಸಿ ಸಾರ್ಕೆ ಕರುನ್, <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />ತೆ ಶೆಳಿಯಾ ಪಾನಿ ಫಿತಲ್ಯಾ ಡೊನ್ಯಾತ್ನಿ ಥವ್ಲ್ಯಾನ್, ಶೆಳಿಯಾ ಅನಿ ಬಕ್ರಿ ಮಿಳ್ತಲೊ ಅನಿ ಪಾನಿ ಫಿತಲ್ಯಾ ಎಳ್ ಎಕುಚ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />ತಿ ಮಿಳ್ತಾನಾ ತೆ ದಾಂಡೆ ಬಗುನ್ಗೆತ್ ಮಿಳಲ್ಯಾ ಸಾಟ್ನಿ ಪಟ್ಟ್ಯಾ ಪಟ್ಟ್ಯಾಂಚೆ ಹಂಡೆ ಬಂಡೆ ನಾತರ್ ಢಾನ್ಯಾ ಢಾನ್ಯಾಂಚ್ಯಾ ಪೆಟ್ಯಾಕ್ನಿ ಜಲಮ್ ದಿಲ್ಯಾನಿ.<verse eid="GEN 30:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 30:40" />ಜಾಕೊಬಾನ್ ತೆ ಪೆಟೆ ಅಪ್ಲೆ ಮನುನ್ ಯೆಗ್ಳುನ್ ತೆಂಕಾ ಲಾಬಾನಾಚ್ಯಾ ತಾಂಡ್ಯಾಕ್ ಮಿಳ್ವುಕ್ನಾ, ಲಾಬಾನಾಚ್ಯಾ ಶೆಳಿಯಾಂಚಿ ತೊಂಡಾ ಗೆರೆ ಹೊತ್ತ್ಯಾ ಶೆಳಿಯಾಂಚ್ಯಾ ಅನಿ ಕಾಳಿ ಹೊತ್ತ್ಯಾ ತ್ಯಾ ಬಕ್ರಿಯಾಂಚ್ಯಾಕ್ಡೆ ಪರ್‍ತುನ್ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 30:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 30:41" />ಅನಿ ಬರಿ ಪುಸ್ಟಿ ಹೊತ್ತಿ ಶೆಳಿಯಾ ಅನಿ ಬಕ್ರಿಯಾ ಮಿಳ್ತಾನಾ ತೆ ದಾಂಡೆ ಬಗುನ್ಗೆತ್ ಮಿಳುಂದಿತ್ ಮನುನ್ ಜಾಕೊಬಾನ್ ಪಾನಿಯಾಚ್ಯಾ ಡೊನ್ಯಾತ್ನಿ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />ಖರೆ ಬಳ್ ನಸಲ್ಯಾ ಶೆಳಿಯಾ ಅನಿ ಬಕ್ರ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ತಸೆ ಕರುಕ್ನಾ, ಅಸೆ ಬಲಿಸ್ಟ್ ಹೊತ್ತಿ ಫುರಾ ಜನಾವರಾ ಜಾಕೊಬಾಚ್ಯಾ ವಾಟ್ಯಾಕ್ ಯೆಲಿ, ಅನಿ ಬಳ್ ನಸಲಿ ಫುರಾ ಲಾಬಾನಾಚ್ಯಾ ವಾಟ್ಯಾಕ್ ಗಾವ್ಲಿ. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />ಅಸೆ ಕರುನ್ ಜಾಕೊಬಾನ್ ಲೈ ಖಮ್ವುನ್ ಸಾವ್ಕಾರ್ ಹೊಲೊ; ತೆಕಾ ಹೆನ್ನ್ ಆಳಾ ಗಂಡ್ ಆಳಾ ಅನಿ ಲೈ ಶೆಳಿಯಾಂಚೊ ತಾಂಡೊ ಅನಿ ಒಂಟಿಯಾ ಗಾಡ್ವಾ ಸಗ್ಳೆ ಲೈ ಗಾವ್ಲೆ.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">ಜಾಕೊಬ್ ಲಾಬಾನಾಕ್ನಾ ಪಳುನ್ ಜಾತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />ಎಕ್ ದಿಸಾ ಲಾಬಾನಾಚ್ಯಾ ಲೆಕಾನಿ, “ಅಮ್ಚ್ಯಾ ಬಾಬಾಚಿ ಆಸ್ತಿ ಸಗ್ಳಿ ಜಾಕೊಬಾಚೊ ವಾಟೊ ಹೊಲಾ; ಅನಿ ಅಮ್ಚ್ಯಾ ಬಾಬಾಚ್ಯಾ ಆಸ್ತಿನ್ ತೊ ಲೈ ಸಾವ್ಕಾರ್ ಹೊಲೊ” ಮನುನ್ ಸಾಂಗ್ತಲಿ ಗೊಸ್ಟ್ ಜಾಕೊಬಾಕ್ ಆಯ್ಕೊ ಯೆಲಿ. <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />ತನ್ನಾ ಜಾಕೊಬಾನ್ ಲಾಬಾನಾಚೆ ತೊಂಡ್ ಬಗ್ತಾನಾ ತೊ ಅದ್ದಿ ಪ್ರೆಮಾನ್ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆ ಅತ್ತಾ ದಿಸಿ ನಸಿ. <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಜಾಕೊಬಾಕ್ ತಿಯಾ ತುಜ್ಯಾ ಸಮಂದಿಕಾಂಚ್ಯಾಕ್ಡೆ ತುಜ್ಯಾ ಬಾಬಾಚ್ಯಾ ದೆಸಾಕ್ ಪರ್‍ತುನ್ ಜಾ; ಮಿಯಾ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾತಾ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />ಅಸೆ ರ್‍ಹಾತಾನಾ ತೆನಿ ರಾಖೆಲಾಕ್ ಅನಿ ಲೆಯಾ ಅಪ್ನಿ ಬಕ್ರಿರಾಕ್ತಲ್ಯಾ ಸೆತಾಕ್ ಭೆಟುಕ್ ಯೆವಾ ಮನುನ್ ಸಾಂಗುನ್ ಧಾಡ್ಲ್ಯಾನ್. <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />ಅನಿ ತೆಂಕಾ, ತುಮ್ಚ್ಯಾ ಬಾಬಾಚೆ ತೊಂಡ್ ಬಗ್ತಾನಾ, ಮಾಜ್ಯಾ ವಿಶಯಾತ್ ಅದ್ದಿ ಹೊತ್ತ್ಯಾ ಪ್ರೆಮಾನಿ ನಾ ಸಾರ್ಕೆ ದಿಸುಲ್ಲಾ, ಹೊಲ್ಯಾರ್ಬಿ ಮಾಜ್ಯಾ ಬಾಬಾಚೊ ದೆವ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಹಾಯ್. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />ಮಿಯಾ ಸಗ್ಳಿ ತಾಕತ್ ವಾಪ್ರುನ್ ತುಮ್ಚ್ಯಾ ಬಾಬಾ ಸಾಟ್ನಿ ಸೆವಾ ಕರ್ಲಾ. <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />ಖರೆ ತುಮ್ಚ್ಯಾ ಬಾಬಾನ್ ಮಾಕಾ ಪಸ್ವುಲ್ಯಾನ್, ಅನಿ ಮಾಜೊ ಪಗಾರ್ ಧಾ ಪಟಿ ಬದಲ್ಲ್ಯಾನ್, ಖರೆ ದೆವಾನ್ ಮಾಕಾ ತೊ ಪಸ್ವುತಲ್ಯಾತ್ನಾ ರಾಕ್ಲ್ಯಾನ್. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />ಎಗ್ದಾ ಲಾಬಾನಾನ್, ಸೆಳಿ ಬಕ್ರಿಯಾಂಚ್ಯಾ ಪೆಟ್ಯಾತ್ನಿ ಚಿಕ್ಕಿಯ ಹೊತ್ತೆ ತಿಯಾ ಥವ್ನ್ ಘೆ, ತೆಚ್ ತುಕಾ ಪಗಾರ್ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್, ಮಾನಾ ತೆನಿ ಮನಾ ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಬಕ್ರಿಯಾನಿ ಹಂಡೆ ಬಂಡೆ ರ್‍ಹಾತಲ್ಯಾ ಪೆಟ್ಯಾಕ್ನಿಚ್ ಜಲಮ್ ದಿಲ್ಯಾನಿ, ತೆಜಾ ವೈನಾ ತೆ ಸಗ್ಳಿ ಮಾಜಿ ಹೊಲಿ, ತೆ ಬಗುನ್ ಲಾಬಾನಾನ್, ಅತ್ತಾ ಮಿಯಾ ಹಂಡೆ ಬಂಡೆ ರಾತಲಿ ಬಕ್ರಿಯಾ ಮಾಕಾ ಘೆತಾ, ತಿಯಾ ಒಳಕ್ ರಾತಲಿ ಬಕ್ರಿಯಾ ಘೆ, ಅನಿ ತೆಚ್ ತುಜೆ ಪಗಾರ್ ಮಟ್ಲ್ಯಾನ್, ಮಾನಾ ತೆನಿ ಸಾಂಗ್ತಾನಾ ಸಗ್ಳ್ಯಾ ಬಕ್ರಾನಿ ಒಳಕ್ ಹೊತ್ತೆ ಪೆಟೆಚ್ ಹೊಲೆ.<verse eid="GEN 31:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 31:9" />ಅಸಿ ಕರುನ್ ದೆವಾನ್ ಮಾಕಾ ತುಮ್ಚ್ಯಾ ಬಾಬಾಕ್ನಾ ಬಕ್ರಾಂಚೊ ತಾಂಡೊ ಕಾಡುನ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />ಜನಾವಾರಾ ಮಿಳ್ತಲ್ಯಾ ಎಳಾರ್ ಮಾಕಾ ಎಕ್ ಸಫಾನ್ ದಿಸ್ಲೆ ತ್ಯಾ ಸಪ್ನಾತ್ ಜನಾವಾರಾ ಮಿಳ್ತಾನಾ ಸಗ್ಳಿ ಪೊಲ್ವ್ಯಾಕ್ನಿ ಟಿಕ್ಕೊ ಅನಿ ಒಳಕ್ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆ ದಿಸ್ಲೆ. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />ತನ್ನಾ ಎಕ್ ದೆವ್ ಧುತಾನ್ ಸಪ್ನಾತ್ ಮಾಕಾ; ಜಾಕೊಬಾ ಮನುನ್ ಬಲ್ವುತಾನಾ, ಮಿಯಾ ಜಾಪ್ ದಿವ್ನ್ “ಮಿಯಾ ಹಿತ್ತೆ ಹಾಯ್” ಮಟ್ಲೊ. <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ ಹಿತ್ತೆ ಬಗ್: ಟಿಕ್ಕೊಅನಿ ಮಚ್ಚಾ ರ್‍ಹಾತಲೆ ಬಕ್ರಿಯಾ ಎಕುಚ್ ಮಿಳ್ತಾತ್, ಅಸಿ ಹೊವ್ಚೆ ಮನುನ್ ಮಿಯಾಚ್ ಕರಲ್ಲೊ ಮಟ್ಲ್ಯಾನ್ ಅನಿ ತುಕಾ ಲಾಬಾನಾನ್ ಕರಲ್ಲೆ ಅನ್ಯಾಯ್ ಮಿಯಾ ಬಗಟ್ಲಾ ತನ್ನಾ ಉಪಾಜ್ತಲೆ ಪೆಟೆ ಪುರಾ ತುಜಿಚ್ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್‍ಲೊ. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೆತೆಲಾತ್ ಯೆಲ್ಲೊ ದೆವ್ ಮಿಯಾಚ್, ತಿಯಾ ಮಾಜ್ಯಾ ಸಾಟ್ನಿ ಎಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಭಾಂದಲೈ, ತಿಯಾ ತ್ಯಾ ಬಲಿ ಭೆಟ್ವುತಲ್ಯಾ ಕಟ್ಟ್ಯಾ ವರ್‍ತಿ ಆಲಿವಾಚೆ ತೆಲ್ ಒತುನ್ ಆನ್ ಕರ್ಲೆ, ತನ್ನಾ ತಿಯಾ ಉಪಾಜಲ್ಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಪರ್‍ತುನ್ ಅತ್ತ್ಯಾಚ್ ಜಾ ಮಟ್ಲ್ಯಾನ್ ಮನುನ್ ಕಳ್ವುಲ್ಯಾನ್, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />ತನ್ನಾ ರಾಖೆಲ್ ಅನಿ ಲೆಯಾನ್ ಜಾಕೊಬಾಕ್, ಅಮ್ಚ್ಯಾ ಬಾಬಾ ಘರ್‍ಹಾತ್ ಅಮ್ಕಾ ಅನಿ ಕಾಯ್ ಹಕ್ಕ್ ಹಾಯ್, <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />ಅನಿ ತೆನಿ ಅಮ್ಕಾ ದುಸ್ರಾ ದೆಶಾಚ್ಯಾ ಸಾರ್ಕೆ ಬಗ್ಲ್ಯಾನ್; ತೆನಿ ಅಮ್ಕಾ ಇಕುನ್ ಗಾವಲ್ಲೆ ಪೈಸೊ ಪುರಾ ಅಪ್ನಿಚ್ ಕರುನ್ಗೆಟ್ಲ್ಯಾನ್. <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />ಅನಿ ಅಮ್ಚ್ಯಾ ಬಾಬಾಕ್ನಾ ದೆವಾನ್ ಅಮ್ಚಿ ಆಸ್ತಿ ಪುರಾ ಕಾಡುನ್ ಘೆಟ್ಲ್ಯಾನ್ ಅತ್ತಾ ಬಗಟ್ಲ್ಯಾರ್ ತಿ ಆಸ್ತಿ ಪುರಾ ಅಮ್ಚ್ಯಾ ಪೊರಾಕ್ನಿ ಗಾವ್ಲಾ ತನ್ನಾ ತಿಯಾ ದೆವ್ ಕಸೊ ಸಾಂಗ್ತಾ ತಸೆಚ್ ಕರ್ ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />ತನ್ನಾ ಜಾಕೊಬಾನ್, ಅಪ್ನಾಚ್ಯಾ ಪೊರಾಕ್ನಿ ಅನಿ ಬಾಯ್ಕಾಕ್ನಿ ಒಂಟಿಚ್ಯಾ ವರ್‍ತಿ ಬಸ್ವುನ್, <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />ಅನಿ ಖಮ್ವಲ್ಲಿ ಸಗ್ಳಿ ಆಸ್ತಿ ಅನಿ ಮೆಸೊಪೊಟೊಮಿಯಾ ದೆಸಾತ್ ಖಮ್ವಲ್ಲಿ ಸಗ್ಳೆ ಜನಾವಾರಾ ಘೆವ್ನ್ ಕಾನಾನ್ ದೆಸಾಕ್ ಅಪ್ಲೊ ಬಾಬಾ ಇಸಾಕಾಕ್ಡೆ ಗೆಲೊ. <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />ತೆನಿ ಜಾತಲ್ಯಾ ಎಳಾರ್ ಲಾಬಾನ್ ಅಪ್ನಾಚ್ಯಾ ಬಕ್ರಿಯಾಂಚೆ ಕೆಸಾ ಕಾತ್ರುಕ್ ಮನುನ್ ಘೆಲ್ಲೊ ರ್‍ಹಾತಾ ತನ್ನಾ ಬಾಬಾ ನತ್ತೆ ಬಗುನ್ ರಾಖೆಲಾನ್ ತೆಜಾ ಘರ್‍ಹಾತ್ ಜಾವ್ನ್ ತೆಚಿ ಕುಲ್ ದೆವಾಚಿ ಮುರ್ತಿಯಾ ಚೊರುನ್ ನೆಲಿನ್.<verse eid="GEN 31:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 31:20" />ಅನಿ ಜಾಕೊಬ್ ಬಿ ಅಪ್ನಿ ಜಾತಾ ಮನುನ್ ಅರಾಮ್ಯಾತ್ಲ್ಯಾ ಲಾಬಾನಾಕ್ ಸಾಂಗಿ ನಸ್ತಾನಾ ತೆಕಾ ಪಸ್ವುನ್ ಪಳುನ್ ಗೆಲೊ. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />ಅನಿ ತೆನಿ ಅಪ್ನಾಚಿ ಆಸ್ತಿ ಫುರಾ ಘೆವ್ನ್ ಪಳುನ್ ಜಾವ್ನ್ ಯುಪ್ರಾಟಿಸ್ ಮನ್ತಲಿ ಮೊಟಿ ನ್ಹಯಿಕ್ ದಾಟುನ್ ಗಿಲ್ಯಾದ್ ಮನ್ತಲ್ಯಾ ಮಡ್ಡಿರ್ ಗೆಲೊ.<verse eid="GEN 31:21" /></para>
  <para style="s">ಲಾಬಾನ್ ಜಾಕೊಬಾಚಿ ಪಾಟ್ ಲಾಗುನ್ ಗೆಲ್ಲೆ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />ತಿನ್ ದಿಸಾ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಜಾಕೊಬ್ ಪಳುನ್ ಗೆಲ್ಲಿ ಖಬರ್ ಲಾಬಾನಾಕ್ ಕಳ್ಳಿ. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />ಮಾನಾ ಲಾಬಾನ್ ಅಪ್ನಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಘೆವ್ನ್ ಜಾಕೊಬಾಚಿ ಪಾಟ್ ಲಾಗುನ್ ಸಾತ್ ದಿಸಾಚ್ಯಾ ಮಾನಾ ಗಿಲ್ಯಾದಾಚ್ಯಾ ಮಡ್ಡಿಕ್ ಜಾವ್ನ್ ಭೆಟ್ಲೊ. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />ತ್ಯಾ ದಿಸಿ ರಾತ್ತಿನ್ ಅರಾಮ್ಯಾತ್ಲ್ಯಾ ಲಾಬಾನಾಚ್ಯಾ ಸಪ್ನಾತ್ ದೆವ್ ಯೆವ್ನ್ “ಬಗ್”, ಜಾಕೊಬಾಕ್ ತಿಯಾ ಕಾಯ್ಬಿ ಬರೆ ನಾತರ್ ಬುರ್ಸೆ ಸಾಂಗುನಕ್ಕೊ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 31:24" /><verse number="25" style="v" sid="GEN 31:25" />ದುಸ್ರೆ ದಿಸಾ ಲಾಬಾನ್ ಜಾಕೊಬಾಕ್ ಜಾವ್ನ್ ಭೆಟ್ಲ್ಯಾನ್, ತನ್ನಾ ಜಾಕೊಬ್ ಮಡ್ಡಿಚ್ಯಾ ವರ್‍ತಿ ಝೊಪ್ಡೆ ಭಾಂದುನ್ ಘೆವ್ನ್ ಹೊತ್ತೊ ಮಾನಾ ಲಾಬಾನಾಬಿ ತ್ಯಾ ಮಡ್ಡಿ ವರ್‍ತಿ ಅಪ್ಲ್ಯಾ ಸಮಂದಿಕಾಕ್ನಿ ಗೊಳಾ ಕರುನ್ ಝೊಪ್ಡೆ ಭಾಂದುನ್ ಘೆಟ್ಲ್ಯಾನ್.<verse eid="GEN 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 31:26" />ಮಾನಾ ಲಾಬಾನಾನ್ ಜಾಕೊಬಾಕ್, ತಿಯಾ ಅಸೆ ಕಶ್ಯಾಕ್ ಕರ್ಲೆ ಮಾಜ್ಯಾ ದೊನಿ ಲೆಕಿಯಾಕ್ನಿಬಿ ಯುದ್ದಾತ್ನಾ ಬಂಧಿಕರುನ್ ನ್ಹೆತಲ್ಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಮಾಕಾಬಿ ಸಾಂಗಿ ನಸ್ತಾನಾ ಯೆಲೆ? <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />ತಿಯಾ ಮಾಕಾ ಸಾಂಗಿ ನಸ್ತಾನಾ ಕಶ್ಯಾಕ್ ಪಸ್ವುನ್ ಯೆಲೆ? ಅನಿ ತಿಯಾ ಮಾಕಾ ಸಾಂಗಲ್ಲೆ ರಾಲ್ಯಾರ್ ಮಿಯಾ ತುಕಾ ಖುಶಿನ್ ಥೈ ಗಿತಾ ಗಾವುನ್ ಅನಿ ವಾಜಾಪ್ ವಾಜ್ವುನ್ ಧಾಡುನ್ ದಿಯ್ ಹೊತ್ತೊ. <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />ತಿಯಾ ಕರಲ್ಯಾ ಮಂಡ್ ಪಾನಾ ವೈನಾ ಮಿಯಾ ಮಾಜ್ಯಾ ನಾತವಾಕ್ನಿ ಉಪ್ಪಾ ದಿವ್ನ್ ಅನಿ ಲೆಕಿಯಾಕ್ನಿ ಜಾವ್ನ್ ಯೆವಾ ಮನುನ್ ಧಾಡುಕ್ಬಿ ನಾ. <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />ಮಿಯಾ ತುಕಾ ಕಾಯ್ಬಿ ಬುರ್ಸೆ ಕರುಕ್ ಹೊತಾ ಖರೆ ತುಜಾ ಬಾಬಾಚ್ಯಾ ದೆವಾನ್ ಕಾಲ್ ರ್‍ಹಾತ್ತಿ ಮಾಜ್ಯಾ ಸಪ್ನಾತ್ ಯೆವ್ನ್ ತುಕಾ ಕಾಯ್ಬಿ ಬುರ್ಸೆ ಕರುನ್ಹಯ್ ಮನುನ್ ಉಶಾರ್ಕಿ ದಿಲಾ. <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />ತುಕಾ ತುಜ್ಯಾ ಬಾಬಾಚ್ಯಾ ಘರಾಕ್ ಪಾಟಿ ಪರ್‍ತುನ್ ಜಾತಲೆ ಮನ್ ಹಾಯ್ ಮನುನ್ ಮಾಕಾ ಕಳಲ್ಲೆ , ಖರೆ ಮಾಜ್ಯಾ ಘರ್‍ಹಾತ್ನಾ ತಿಯಾ ಮಾಜಿ ಮುರ್ತಿಯಾ ಕಶ್ಯಾಕ್ ಚೊರುನ್ ಹಾನ್ಲೈ? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />ತನ್ನಾ ಜಾಕೊಬಾನ್ ತೆಕಾ, ತಿಯಾ ತುಜ್ಯಾ ಲೆಕಿಯಾಕ್ನಿ ಮಾಜ್ಯಾಕ್ನಾ ಕಾಡುನ್ ಘೆತೈ ಮನ್ತಲ್ಯಾ ಭ್ಹಿಯಾನ್ ಮಿಯಾ ಸಾಂಗಿ ನಸ್ತಾನಾ ಪಳುನ್ ಯೆಲೊ, <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />ಖರೆ ಮಿಯಾ ತುಜಿ ಖಲಿಬಿ ಮುರ್ತಿಯಾ ಚೊರುನ್ ಹಾನುಕ್ ನಾ, ತುಜಿ ಮುರ್ತಿ ಕೊನ್ಬಿ ಚೊರುನ್ ಹಾನಲ್ಲೆ ರಾಲ್ಯಾರ್ ತೆಕಾ ಜಿವಾನಿ ಮಾರ್ತಲಿ ಶಿಕ್ಷ್ಯಾ ಹೊಂವ್ದಿತ್ ಮಟ್ಲ್ಯಾನ್, ಖರೆ ಜಾಕೊಬಾಕ್ ರಾಖೆಲಾನುಚ್ ಲಾಬಾನಾಚಿ ಮುರ್ತಿಯಾ ಚೊರುನ್ ಹಾನಲ್ಲಿ ಗೊತ್ತ್ ನತ್ತೆ,<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />ಮಾನಾ ಲಾಬಾನ್ ಜಾವ್ನ್ ಜಾಕೊಬಾಚ್ಯಾ ಝೊಪ್ಡ್ಯಾತ್ ಹುಡಕ್ಲ್ಯಾನ್, ಅನಿ ಲೆಯಾಚ್ಯಾಬಿ ಝೊಪ್ಡ್ಯಾತ್ ಹುಡಕ್ಲ್ಯಾನ್, ಮಾನಾ ತೆಂಚ್ಯಾ ದಾಸಿಚ್ಯಾ ಝೊಪ್ಡ್ಯಾತ್ ಹುಡ್ಕುನ್ ಖರೆ ಥೈಬಿ ತೆಕಾ ತೆಚಿ ಮುರ್ತಿಯಾ ಗಾವ್ಕ್ ನಾತ್ ಮಾನಾ ಥೈತ್ನಾ ರಾಖೆಲಾಚ್ಯಾ ಝೊಪ್ಡ್ಯಾಕ್ ಗೆಲೊ, <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />ಅನಿ ತಿಚ್ಯಾ ಝೊಪ್ಡ್ಯಾತ್ ಕವ್ಡೆ ಹುಡಕ್ಲ್ಯಾಬಿ ತೆಕಾ ಕಾಯ್ ಗಾವ್ಕ್ ನಾ, ತ್ಯಾ ಎಳಾರ್ ರಾಖೆಲ್ ತೆಕಾ ತೆಚಿ ಮುರ್ತಿಯಾ ಗಾವುಕ್ ನಾ, ತಿ ಮುರ್ತಿಯಾ ಒಂಟಿಯಾಂಚ್ಯಾ ವೈನಿ ಭಾಂದಲ್ಲ್ಯಾ ಪಿಸ್ವಿತ್ ಘಾಲುನ್ ತೆಚ್ಯಾ ವರ್‍ತಿ ಚಡುನ್ ಭಸಲ್ಲಿ. <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />ಅನಿ ರಾಖೆಲಾನ್ ಬಾಬಾಕ್, ಬಾಬಾ ತಿಯಾ ಮಾಜ್ಯಾ ವರ್‍ತಿ ರಾಗ್ ಕರು ನಕ್ಕೊ, ಮಿಯಾ ತುಜ್ಯಾ ಇದ್ರಾಕ್ ಉಟುನ್ ಇಬೆ ರಾಯ್‍ ಸಾರ್ಕೆ ನಾ ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಮಾಕಾ ಬಾಯ್ಕಾ ಮನ್ಸಾಕ್ನಿ ಹೊತಲಿ ಮೈನ್ಯಾಚಿ ಪಾಳಿ ಹೊಲಾ ಮಟ್ಲಿನ್, ತನ್ನಾ ಲಾಬಾನಾನ್ ಹುಡಕ್ಲ್ಯಾರ್ಬಿ ತೆಕಾ ಕಾಯ್ ಗಾವ್ಕ್ ನಾ. <verse eid="GEN 31:35" /><verse number="36" style="v" sid="GEN 31:36" />ತನ್ನಾ ಜಾಕೊಬಾನ್ ಲಾಬಾನಾಚ್ಯಾ ವರ್‍ತಿ ರಾಗಾನ್ ಗಾಳಿ ದಿವ್ನ್ ತಿಯಾ ತವ್ಡ್ಯಾ ಲಗ್ಗುನಾ ಮಾಜ್ಯಾ ಫಾಟ್ನಾ ಯೆವ್ಕ್ ಮಿಯಾ ಕಾಯ್ ಚುಕ್ ಕರ್ಲಾ? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ. <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />ಅನಿ ಮಾಜ್ಯಾ ಸಾಮಾನಾತ್ನಿ ಹುಡ್ಕುನ್ ಬಗಟ್ಲ್ಯಾರ್ಬಿ ತುಜೆ ವಸ್ತ್ ಕಾಯ್ಬಿ ಗಾವ್ಕ್ ನಾ ಖರೆ ತಸ್ಲೆ ಕಾಯ್ಬಿ ತುಕಾ ಗಾವ್ಲ್ಯಾರ್ಬಿ ತಿಯಾ ಮಾಜ್ಯಾ ಅನಿ ತುಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಹಾನುನ್ ದಾಕ್ವು ಅಮ್ಚ್ಯಾತ್ ಕೊನ್ ಸಮಾ ಹಾತ್ ಮನುನ್ ತೆನಿಚ್ ನಿರ್ದಾರ್ ಕರುಂದಿತ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />ಖರೆ ಮಿಯಾ ತುಜ್ಯಾಕ್ಡೆ ವಿಸ್ ವರಿಸ್ ಪತರ್ ಕಾಮ್ ಕರ್‍ಲೊ, ಅನಿ ಖರೆ ತುಜ್ಯಾ ಬಕ್ರಾಂಚ್ಯಾ ತಾಂಡ್ಯಾತ್ ಹೊಂವ್ದಿತ್ ಶೆಳಿಯಾಂಚ್ಯಾ ತಾಂಡ್ಯಾತ್ ಹೊಂವ್ದಿತ್ ಎಕ್ಬಿ ಪೆಟೊ ಮರುಕ್ ನಾ ಅನಿ ಮಿಯಾ ತುಜಿ ಎಕ್ಬಿ ಬಕ್ರಿಯಾತ್ನಿ ಎಕ್ಬಿ ಮಿಯಾ ಖಾವ್ಕ್ ನಾ. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />ಕ್ರುರ್ ಜನಾವಾರಾ ಬಕ್ರಾಕ್ನಿ ಜಿವ್ ಕಾಡ್ಲ್ಯಾರ್ಬಿ ತೆಚ್ಯಾ ಬದ್ಲಾಕ್ ಮಾಜಿ ಬಕ್ರಿಯಾ ಘೆಟಲೈ ಮರುನ್ ಗೆಲ್ಲ್ಯಾ ಜನಾವಾರಾ ಮಾಜ್ಯಾಕ್ನಾ ಕಾಯ್ಬಿ ಚುಕ್ ನಾ ಮನುನ್ ಮಿಯಾ ತುಕಾ ಸಾಂಗ್ಲಾ, ಕೊನಿಬಿ ರಾತ್ತಿನ್ ಹೊಂವ್ದಿ ದಿಸಾನ್ ಹೊಂವ್ದಿತ್ ಚೊರುನ್ ಘೆವ್ನ್ ಗೆಲ್ಲ್ಯಾಚಾ ಬದ್ಲಾಕ್ ತಿಯಾ ಮಾಜೆಕ್ನಾ ಜನಾವಾರ್ ಘೆಟಲೈ ನ್ಹಯ್. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />ದಿಸಾನಿ ನಿಂಬಾರ್ ರಾತ್ತಿನ್ ಥಂಡಿತ್ ಡಂಗ್ಳಿತ್ ಮಿಯಾ ತರಾಸ್ ಕರುನ್ ಘೆಟ್ಲೊ; ತನ್ನಾ ಬಿ ಮಾಕಾ ನಿಜುಕ್ ಹೊವ್ಕ್ ನಾ; ಮಾಜಿ ಗತ್ ಅಸಿ ಹೊತ್ತಿ. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />ಅನಿ ಇಸ್ ವರಿಸ್ ಪತರ್ ತುಜಾ ಘರ್‍ಹಾತ್ ಹೊತ್ತೊ; ಅನಿ ತುಜ್ಯಾ ಲೆಕಿಯಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಚವ್ದಾ ವರಿಸ್ ಪತರ್ ಅನಿ ತುಜ್ಯಾ ಬಕ್ರಿಯಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಸಾ ವರಿಸ್ ಪಾತರ್ ಸೆವಾ ಕರ್‍ಲೊ, ಖರೆ ತಿಯಾ ಮಾಜೆ ಪಗಾರ್ ಧಾ ಪಟಿ ಬದಲೈ. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />ಖರೆ ಮಾಜೊ ಬಾಬಾ ಅಬ್ರಾಹಾಮಾಚೊ ದೆವ್ ಅನಿ ಇಸಾಕಾನ್ ಭಕ್ತಿನ್ ಆರಾದನ್ ಕರಲ್ಲೊ ದೆವ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ನಾ ಹೊಲ್ಯಾರ್ ತಿಯಾ ಮಾಕಾ ಖಾಲಿ ಹಾತಿನ್ ಧಾಡಿ ಹೊತ್ತೈ, ಮಾಜೊ ತರಾಸ್ ಅನಿ ಕಾಮ್ ಬಗುನ್ ಕಾಲ್ಚ್ಯಾ ರ್‍ಹಾತ್ತಿ ದೆವಾನ್ ತುಕಾ ಕಾಯ್ಬಿ ಕರುನಕ್ಕೊ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 31:42" /></para>
  <para style="s">ಜಾಕೊಬಾಚೆ ಅನಿ ಲಾಬಾನಾಚೊ ಕರಾರ್</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />ತನ್ನಾ ಜಾಕೊಬಾಕ್, ಹಿ ತುಜಿ ಬಾಯ್ಕಾ ಮಾಜಿ ಲೆಕಿಯಾ ಅನಿ ಹಿ ತುಜಿ ಪೊರಾ ಮಾಜಿ ನಾತ್ರಾ; ಅನಿ ಹಿ ಜನಾವಾರಾ ಸಗ್ಳಿ ಮಾಜಿ ಅನಿ ಹಿತ್ತೆ ತುಜೆ ಮನುನ್ ಕಾಯ್ಬಿ ಹಾಯ್ ಕಾಯ್ ಬಗ್ ಖರೆ ಮಿಯಾ ಮಾಜ್ಯಾ ನಾತ್ರಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಅನಿ ಲೆಕಿಯಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಕಾಯ್ಬಿ ಕರುಕ್ ನಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />ತನ್ನಾ ಮಿಯಾ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಎಕ್ ಕರಾರ್ ಕರುನ್ ಘೆಂವ್ವಾ, ತನ್ನಾ ಅಮ್ಚ್ಯಾ ಖರಾರಾಕ್ ಸಾಕ್ಷಿ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />ತನ್ನಾ ತೆನಿ ಎಕ್ ಗುಂಡೊ ನಿಟ್ಟ್ ಇಬೆ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />ಅನಿ ತೆನಿ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ನಿ; “ಗುಂಡ್ಯಾಂಚೊ ಗುಂಪೊ ಕರಾ” ಮಟ್ಲ್ಯಾನ್, ತನ್ನಾ ತೆನಿ ಗೊಳಾ ಕರ್ಲ್ಯಾನಿ, ಮಾನಾ ತೆನಿ ತ್ಯಾ ಗುಂಡ್ಯಾಂಚ್ಯಾ ಗುಂಪ್ಯಾಕ್ಡೆ ಬಸುನ್ ಜೆವಾನ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />ತನ್ನಾ ಲಾಬಾನಾನ್‍ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ ಯಗರ್ ಸಾಹದುತ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್ ಅನಿ ಜಾಕೊಬಾನ್ ಗಲಿದ್ ಮನುನ್ ಎಕ್ ನಾವ್ ಥವ್ತಾ. <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />ತನ್ನಾ ಲಾಬಾನಾನ್ ಜಾಕೊಬಾಕ್, “ಗಲಿದ್ ಮನ್ತಲೊ ಹ್ಯೊ ಗುಂಡ್ಯಾಂಚೊ ಗುಂಪೊ ಮಾಜ್ಯಾ ಅನಿ ತುಜ್ಯಾ ಮದ್ದಿ ಎಕ್ ಸಾಕ್ಷಿ ಹೊವ್ನ್ ಹಾಯ್” ಮಟ್ಲ್ಯಾನ್ . <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />ಅಸಿ ರ್‍ಹಾತಾನಾ: “ಅಮಿ ದೊಗೆಬಿ ದುರ್ ಹೊಯ್ನಾ ಸಾರ್ಕೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಮ್ಕಾ ಬಗುನ್ಗೆತ್ ರಾಂವ್ದಿತ್” ಮನುನ್ ಲಾಬಾನಾನ್, ತ್ಯಾ ಜಾಗ್ಯಾಕ್ ಮಿಚ್ಪಾ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />ಖರೆ ಲಾಬಾನಾನ್ “ಮಾಜ್ಯಾ ಲೆಕಿಯಾಕ್ನಿ ತಿಯಾ ಮನ್ ದುಕ್ವುನ್ ದುಸ್ರಾ ಚೆಡ್ವಾಕ್ ಲಗಿನ್ ಹೊಲ್ಯಾರ್, ಇಚಾರ್ ಕರುಕ್ ಕೊನ್ಬಿ ನಾಹೊಲ್ಯಾರ್ ಅಮ್ಚೊ ದೆವುಚ್ ಅಮ್ಕಾ ಸಾಕ್ಷಿ ಹೊವ್ನ್ ರ್‍ಹಾತಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51" />ಅಸಿ ರ್‍ಹಾತಾನಾ ಜಾಕೊಬಾಕ್; ತುಜ್ಯಾ ಅನಿ ಮಾಜ್ಯಾ ಮದ್ದಿ ಮಿಯಾ ಇಬೆ ಕರಲ್ಲೊ ಹ್ಯೊ ಖಾಂಬೊ ಬಗ್, ಅನಿ ಗುಂಡ್ಯಾಂಚೊ ಗುಂಪೊ ಬಗ್, <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />ಮಿಯಾ ತುಕಾ ವಾಯ್ಟ್ ಕರುಕ್ ಮನುನ್ ಹ್ಯಾ ಗೊಂಡ್ಯಾಂಚೊ ಗುಂಪೊ ದಾಟುನ್ ತುಜ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆಯ್ನಾ; ತಸೆಚ್ ತಿಯಾಬಿ ಹ್ಯಾ ಗುಂಡ್ಯಾಚೊ ಗುಂಪೊ ಅನಿ ಖಾಂಬೊ ದಾಟುನ್ ಯೆವ್ ನಕ್ಕೊ. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />ನಾತರ್ ಅಮ್ಚ್ಯಾತ್ ಕೊನ್ ತರ್ಬಿ ಹ್ಯೊ ಕರಾರ್ ಮೊಡ್ಲ್ಯಾರ್ ತೆಂಕಾ ಅಬ್ರಾಹಾಮಾಚೊ ಅನಿ ನಾಹೊರಾಚೊ ಅನಿ ತೆಂಚ್ಯಾ ಬಾಬಾಚೊ ದೆವ್ ಮಾಕಾ ಅನಿ ತುಕಾ ಝಡ್ತಿ ಕರುಂದಿತ್, ಮಟ್ಲ್ಯಾನ್ ಅನಿ ಇಸಾಕ್ ಭಯಭಕ್ತಿನ್ ಆರಾದನ್ ಕರ್‍ತಲ್ಯಾ ದೆವಾಚ್ಯಾ ನಾಂವಾರ್ ಆನ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />ತನ್ನಾ ಜಾಕೊಬಾನ್ ಮಡ್ಡಿಚ್ಯಾ ವರ್‍ತಿ ಜನಾವಾರಾಕ್ ಮಾರುನ್ ದೆವಾಕ್ ಬಲಿ ಭೆಟ್ವುಲ್ಯಾನ್ ಅನಿ ಅಪ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಸಮಂದಕಾಕ್ನಿ ಜೆವಾನ್ ಘಾಟ್ಲ್ಯಾನ್, ಮಾನಾ ತೆನಿ ಜೆವಾನ್ ಕರುನ್ ತ್ಯಾ ರಾತ್ತಿನ್ ತ್ಯಾ ಮಡ್ಡಿ ವರ್‍ತಿ ವಸ್ತಿ ರಾಲ್ಯಾನಿ. <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />ಮಾನಾ ದುಸ್ರೆ ದಿಸಿ ಲಾಬಾನಾನ್ ಅಪ್ಲ್ಯಾ ಲೆಕಿಯಾಕ್ನಿ ಅನಿ ನಾತ್ರಾಕ್ನಿ ಆಶಿರ್ವಾದ್ ಕರುನ್ ಭೆಟುನ್ ಉಪ್ಪಾ ದಿವ್ನ್ ಅಪ್ಲ್ಯಾ ಘರಾಕ್ ಪರ್‍ತುನ್ ಗೆಲೊ.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">ಜಾಕೊಬಾನ್ ಎಸಾವಾಕ್ ಭೆಟ್ತಲಿ ತಯಾರಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />ಜಾಕೊಬ್ ಜಾಯ್ತ್ ರ್‍ಹಾತಾನಾ ತೆಕಾ ದೆವ್ ಧುತಾ ಭೆಟ್ಲಿ.<verse eid="GEN 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 32:2" />ದೆವ್ ಧುತಾ ತೆಚ್ಯಾ ಇದ್ರಾಕ್ ಯೆವ್ನ್ ಇಬೆ ರಾಲ್ಯಾನಿ,</para>
  <para style="p" vid="GEN 32:2">ತನ್ನಾ ಜಾಕೊಬಾನ್ ತೆಂಕಾ ಬಗುನ್ ಹೆ ದೆವಾಚೊ ವಾಡೊ ಮನುನ್ ತೆಕಾ ಮಹನಯಿಮ್ ಮನ್ತಲೆ ನಾವ್ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />ಮಾನಾ ಜಾಕೊಬಾನ್ ಅಪ್ಲೊ ಭಾವ್ ಎಸಾವಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಅಪ್ನಾ ಕಿಂತಾ ಫಿಡೆ ಉಲ್ಲ್ಯಾ ಸೆವಕಾಕ್ನಿ ಧಾಡುನ್ ದಿಲ್ಯಾನ್ . <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />ಧಾಡ್ತಾನಾ ತೆನಿ ತೆಂಕಾ, ತುಮಿ ಮಾಜೊ ಯಜಮಾನ್ ಎಸಾವಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಜಾವ್ನ್ ಹಿ ಖಬರ್ ಸಾಂಗಾ; ಮಿಯಾ ತುಜೊ ಆಳ್ ಯೆವ್ಡೆ ದಿಸ್ ಲಾಬಾನಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ದುಸ್ರ್ಯಾ ದೆಶ್ಯಾಚೊ ಹೊವ್ನ್ ವಸ್ತಿ ರ್‍ಹಾತಲೆ ಹೊಲೆ, <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />ಅನಿ ಮಾಕಾ ಗಾಯಾ, ಬೈಲಾ, ಗಾಡ್ವಾ, ಶೆಳಿಯಾ, ಬಕ್ರಿ, ಅನಿ ಗಂಡ್ ಆಳಾ, ಹೆನ್ನ್ ಆಳಾ ಹಾತ್, ತೊ ಮಾಜೆಕ್ನಾ ತೆನಿ ದಯಾನಿ ರ್‍ಹಾವ್ಚೆ ಮನ್ತಲಿ ಮಾಗ್ನಿ ಕರುನ್ ಅಮ್ಕಾ ತುಜ್ಯಾಕ್ಡೆ ಧಾಡ್ಲಾ ಮನುನ್ ಸಾಂಗಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />ತ್ಯಾ ಆಳಾನಿ ಜಾವ್ನ್ ಜಾಕೊಬಾಕ್ಡೆ ಪರ್‍ತುನ್ ಯೆವ್ನ್, ಅಮಿ ತುಜೊ ಭಾವ್ ಎಸಾವಾಕ್ಡೆ ಗೆಲ್ಲ್ಯಾಂವ್, ತೊ ತುಕಾ ಭೆಟುಕ್ ಮನುನ್ ಚಾರ್ಸೆ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಯೆವ್ಲಾ ಮನ್ತಾನಾ, <verse eid="GEN 32:6" /><verse number="7" style="v" sid="GEN 32:7" />ಹೆ ಆಯ್ಕುನ್ ಜಾಕೊಬ್ ಲೈ ಭಿಂಯಾಲೊ ಅನಿ ತಳ್ಮಳ್ಲ್ಯಾನ್ ತೆನಿ ಅಪ್ಲಿ ಆಳಾ ಬಕ್ರಿಯಾ ಗೊರಾ ಅನಿ ಒಂಟಿಯಾ ಸಗ್ಳೆ ದೊನ್ ವಾಟೆ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />ಎಸಾವಾನ್ ಎಕ್ ಭಾಗ್ ಹಾಳ್ ಕರ್ಲ್ಯಾರ್ಬಿ ಅನಿ ಎಕ್ ವಾಟೊ ಹುರ್ವುನ್ಗೆವ್ಚೆ ಮನ್ತಲಿ ತೆಚಿ ಯೆವ್ಜನ್ ಹೊಲ್ಲಿ.<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />ಅನಿ ಜಾಕೊಬಾನ್ ದೆವಾಕ್ ಅಸೆ ಮಾಗ್ನಿ ಕರ್ಲ್ಯಾನ್; ಸರ್ವೆಸ್ಪರ್ ದೆವಾ ಮಾಜೊ ಬಾಬಾ ಇಸಾಕ್ ಅನಿ ಅಜ್ಜ್ಯಾ ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ದೆವಾ, ಮಾಕಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಗಾಂವಾಕ್ ಅನಿ ಬಳ್ಗಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಪರ್‍ತುನ್ ಜಾವ್ಚೆ ಮನುನ್ ಹುಕುಮ್ ದಿಲ್ಲೊ ತಿಯಾಚ್, ಅನಿ ತುಕಾ ಬರೆಚ್ ಕರ್ತಾ ಮನುನ್ ಗೊಸ್ಟ್ ದಿಲ್ಲೈ, <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />ಆಳ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಮಾಜ್ಯಾ ವರ್‍ತಿ ಲೈ ಪ್ರೆಮ್ ಥವ್ನ್ ತುಜಿ ಗೊಸ್ಟ್ ಫುರಾ ಕರ್‍ಲೆ ಮಿಯಾ ತೆಕಾ ಯೊಗ್ಯಾ ನ್ಹಯ್, ಮಿಯಾ ಪೈಲೆ ಜೊರ್ದಾನ್ ನ್ಹಯ್ ದಾಟುನ್ ಯೆತಾನಾ ಮಾಜೆಕ್ಡೆ ಎಕ್ ದಾಂಡೊ ತವ್ಡೊಚ್ ಹೊತ್ತೊ, ಖರೆ ಅತ್ತಾ ಮಾಜೊ ದೊನ್ ತಾಂಡೆ ಹೊಲಾತ್. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />ಮಾಜೊ ಭಾವ್ ಎಸಾವ್ ಯೆವ್ನ್ ಮಾಜ್ಯಾ ಬಾಯ್ಕೊ ಪೊರಾಕ್ನಿ ಅನಿ ಮಾಕಾ ಜಿವ್ ಕಾಡ್ತಾಕಾಯ್ಕಿ ಮನುನ್ ಮಾಕಾ ಭಿಂಯ್ಯೆ ಹಾಯ್, ತೆಚ್ಯಾ ಹಾತಿಕ್ ಗಾಯ್ನಾ ಸಾರ್ಕೆ ಅಮ್ಕಾ ರಾಕ್ ಮನುನ್ ತುಜೆಕ್ಡೆ ಮಾಗ್ತಾ,<verse eid="GEN 32:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 32:12" />ತುಕಾ ಬರೆಚ್ ಕರುನ್ ತುಜಿ ಪಿಳ್ಗಿ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆ ವೈಲ್ಯಾ ರೆತಿ ಸಾರ್ಕೆ ಮೆಜುಕ್ ಹೊಯ್ನಾ ತವ್ಡೆ ಕರ್ತಾ ಮನುನ್ ಸಾಂಗಲೆಯ್.<verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />ಜಾಕೊಬಾನ್ ತ್ಯಾ ದಿಸಿ ರಾತ್ತಿನ್ ಥೈಚ್ ರ್‍ಹಾವ್ನ್ ಅಪ್ನಿ ಹಾನಲ್ಯಾತ್ಲೆ ಉಲ್ಲೆ ಅಪ್ಲೊ ಭಾವ್ ಎಸಾವಾಕ್ ಮನುನ್ ಕಾನಿಕ್ ತಯಾರ್ ಕರುನ್ಗೆಟ್ಲ್ಯಾನ್, <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />ತೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ದೊನ್ಸೆ ಶೆಳಿಯಾ, ವಿಸ್ ಪಾಲ್ವೆ ಅನಿ ದೊನ್ಸೆ ಬಕ್ರಿ, ವಿಸ್ ಟಗ್ರಾ, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />ಅನಿ ದುದ್ ಪಿಳ್ತಲಿ ತಿಸ್ ಹೆನ್ನ್ ಒಂಟಿಯಾ ಅನಿ ತೆಂಚೆ ಪೆಟೆ, ಚಾಳಿಸ್ ಗಾಯಾ, ಧಾ ಬೈಲಾ, ವಿಸ್ ಹೆನ್ನ್ ಗಾಡ್ವಾ, ಧಾ ಗಂಡ್ ಗಾಡ್ವಾ, <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />ಹೆ ಸಗ್ಳೆ ಬಿ ದುಸ್ರೆ ದುಸ್ರೆ ತಾಂಡೆ ಕರುನ್ ಎಗ್ಳುನ್ ಅಪ್ಲ್ಯಾ ಆಳಾಕ್ನಿ ಒಪ್ಸುನ್ ದಿವ್ನ್ ತೆಂಕಾ ಮಾಜ್ಯಾ ಫಿಡೆ ಚಲುನ್ ತಾಂಡ್ಯಾ ತಾಂಡ್ಯಾಂಚ್ಯಾ ಮದ್ದಿ ಜಾಗೊ ಸೊಡುನ್ ಜಾವಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 32:16" /><verse number="17" style="v" sid="GEN 32:17" />ಪೈಲೆಚ್ಯಾ ತಾಂಡ್ಯಾಚ್ಯಾ ಆಳಾಕ್ ತೆನಿ ಮಾಜ್ಯಾ ಭಾವಾನ್ ತುಕಾ ಇದ್ರಾಕ್ ಗಾವ್ನ್ ತಿಯಾ ಕೊನ್? ಕೊನಾಚೊ ಆಳ್ ?ಅನಿ ತುಜ್ಯಾ ಇದ್ರಾಕ್ ಜಾವ್ಕ್ ಲಾಗಲ್ಲಿ ಹಿ ಜನಾವರಾ ಕೊನಾಚಿ? ಮನುನ್ ಇಚಾರ್‍ತಾನಾ, <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />ಹೆ ತುಜೊ ಆಳ್ ಜಾಕೊಬಾಚೆ ; ಮಾಜೊ ಯಜಮಾನ್ ಎಸಾವಾನ್ ತುಕಾ ಕಾನಿಕಾ ದಿವ್ನ್ ಧಾಡ್ಲಾ, ಅನಿ ತೊ ಬಿ ಅಮ್ಚ್ಯಾ ಫಾಟ್ನಾ ಯೆವ್ಲಾ ಮನುನ್ ಜವಾಬ್ ದಿವ್ಚೆ , ಮನುನ್ ಹುಕುಮ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 32:18" /><verse number="19" style="v" sid="GEN 32:19" />ತಸೆಚ್ ದೊನ್ವೆಚ್ಯಾಕ್ ತಿನ್ವೆಚ್ಯಾಕ್ ಅನಿ ತಾಂಡ್ಯಾಂಚ್ಯಾ ಫಾಟ್ನಾ ಜಾತಲ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿಬಿ ತುಮಿ ಎಸಾವ್ ದಿಸ್ತಾನಾ ಅಸೆಚ್ ಸಾಂಗುಚೆ. <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />ಅನಿ ತುಜೊ ಆಳ್ ಜಾಕೊಬ್ ಫಾಟ್ನಾ ಯೆವ್ಲಾ ಮನುನ್ ಸಾಂಗುಕ್ ಇಸ್ರುನಕಾಸಿ ಮನುನ್ ಹುಕುಮ್ ದಿಲ್ಯಾನ್, ಅನಿ ಜಾಕೊಬಾನ್ ಮಿಯಾ ಧಾಡಲ್ಯಾ ಆಯಾರಾನಿ ಎಸಾವಾಕ್ ಸಮಾಧಾನ್ ಕರುನ್ ಮಾನಾ ಜಾವ್ನ್ ತೆಕಾ ಭೆಟ್ತಾ, ತನ್ನಾ ತೊ ಮಾಕಾ ಪ್ರೆಮಾನ್ ಒಪ್ಪುನ್ಗೆತಾ ಮನುನ್ ಮನಾತುಚ್ ಚಿಂತುನ್ಗೆಟ್ಲ್ಯಾನ್. <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />ತಸೆ ಹೊವ್ನ್ ತೆನಿ ಆಯಾರಾ ಪೈಲೆಚ್ ಧಾಡುನ್, ಅಪ್ನಿ ತ್ಯಾ ದಿಸಿ ರಾತ್ತಿನ್ ಝೊಪ್ಡ್ಯಾತ್ ನಿಜ್ಲೊ.<verse eid="GEN 32:21" /></para>
  <para style="s">ದೆವ್ ಧುತಾವಾಂಗ್ಡಾ ಜಾಕೊಬಾಚಿ ಕುಸ್ತಿ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />ತ್ಯಾ ದಿಸಿ ರಾತ್ತಿನ್ ಅಪ್ಲಿ ದೊನ್ ಬಾಯ್ಕಾ ತೆಂಚಿ ಆಳಾ ಅನಿ ಅಕ್ರಾ ಪೊರಾಕ್ನಿ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಮಡ್ಡಿತ್ನಾ ಯಬ್ಬೊಕ್ ಮನ್ತಲಿ ನ್ಹೈ ದಾಟ್ತಲ್ಯಾ ಜಾಗ್ಯಾರ್ ದಾಟ್ಲ್ಯಾನ್. <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />ತೆನಿ ತೆಂಕಾ ಅನಿ ಸಗ್ಳಿ ಆಸ್ತಿ ನ್ಹಯ್ ದಾಟಸ್ಲ್ಯಾನ್.<verse eid="GEN 32:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 32:24" />ಜಾಕೊಬ್ ಎಕ್ಲೊಚ್ ಫಾಟಿ ಇಬೆ ಹೊತ್ತೊ ತನ್ನಾ ಕೊನಿಕಿ ಎಕ್ ಘವ್ಮಾನ್ಸಾನ್ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಉಜ್ವಾಡಿ ಪತರ್ಬಿ ಹೊರಾಟ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />ತ್ಯಾ ಮಾನ್ಸಾನ್ ಅಪ್ನಿ ಜೈ ಹೊವ್ಕ್ ಹೊಯ್ನಸಲೆ ಬಗುನ್ ಹೊರಾಟ್ ಕರುನ್ಗೆತುಚ್ ರ್‍ಹಾತಾನಾ ಜಾಕೊಬಾಚ್ಯಾ ಜಾಂಗೆಚ್ಯಾ ಸಿರಾಕ್ ಆಪಡಲ್ಯಾ ತನ್ನಾ ತೆಚ್ಯಾ ಡೊಗಾಲ್ ಚುಕ್ಲೆ. <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />ತ್ಯಾ ಮಾನ್ಸಾನ್ ಜಾಕೊಬಾಕ್ “ಮಾಕಾ ಸೊಡ್ ಮಿಯಾ ಜಾವ್ಚೆ ಉಜ್ವಾಡುಲ್ಲಾ” ಮನ್ತಾನಾ,</para>
  <para style="q1" vid="GEN 32:26">ಜಾಕೊಬಾನ್ ತೆಕಾ “ತಿಯಾ ಮಾಕಾ ಆಶಿರ್ವಾದ್ ಕರಿನಸ್ತಾನಾ ಮಿಯಾ ತುಕಾ ಜಾವ್ಕ್ ದಿಯ್ನಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 32:26" /></para>
  <para style="q2">
    <verse number="27" style="v" sid="GEN 32:27" />ತ್ಯಾ ಮಾನ್ಸಾನ್ ಜಾಕೊಬಾಕ್ ತುಜೆ ನಾವ್ ಕಾಯ್? ಮನುನ್ ಇಚಾರ್‍ತಾನಾ,</para>
  <para style="q1" vid="GEN 32:27">ಮಾಜೆ ನಾವ್ ಜಾಕೊಬ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 32:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="GEN 32:28" />ತೆನಿ ಜಾಕೊಬಾಕ್ ಹೆಚ್ಯಾನ್ ಫಿಡೆ ತಿಯಾ ಜಾಕೊಬ್ ರ್‍ಹಾಯ್ನಾ,</para>
  <para style="q2" vid="GEN 32:28">ದೆವಾಚ್ಯಾ ಅನಿ ಮಾನ್ಸಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊರಾಟ್ ಕರುನ್ ಝಿಕಲ್ಯಾ ಸಾಟ್ನಿ ತುಕಾ ಇಜ್ರಾಯೆಲ್ ಮನುನ್ ನಾವ್ ಯೆತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 32:28" /></para>
  <para style="q2">
    <verse number="29" style="v" sid="GEN 32:29" />ಜಾಕೊಬಾನ್ ತೆಕಾ ದಯಾ ಕರುನ್ ಸಾಂಗ್ ತುಜೆ ನಾವ್ ಕಾಯ್? ಮನುನ್ ಇಚಾರ್‍ತಾನಾ,</para>
  <para style="q1" vid="GEN 32:29">ಮಾಜೆ ನಾವ್ ಕಶ್ಯಾಕ್ ಇಚಾರ್ತೆಯ್? ಮನುನ್ ತೆಕಾ ಥೈಚ್ ಆಶಿರ್ವಾದ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />ಜಾಕೊಬಾನ್ ಮಿಯಾ ದೆವಾಕ್ ಇದ್ರಾ ಬದ್ರಾಕ್ ಬಗ್ಲೊ ಜಾಲ್ಯಾರ್ಬಿ ಝಿತ್ತೊ ಹಾಂವ್ ಮನುನ್ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ ಪೆನಿಯೆಲ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />ಪಾಂಯಾಚೆ ಹಡ್ಡ್ ನಿಕ್ಳುನ್ ಗೆಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಕುಂಟುನ್ಗೆತ್ ಚಲುನ್ ಪೆನಿಯೆಲ್ ದಾಟಿತ್ ರ್‍ಹಾತಾನಾಚ್ ದಿಸ್ ಉಗಾವ್ಲೊ. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />ತ್ಯಾ ಮಾನ್ಸಾನ್ ಜಾಕೊಬಾಚ್ಯಾ ಜಾಂಗೆಚಿ ಸಿರ್ ಅಪಡಲ್ಯಾ ಸಾಟ್ನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಅಜುನ್ ಪತರ್ಬಿ ಜನಾವರಾಚ್ಯಾ ಜಾಂಗೆಚ್ಯಾ ಹಡ್ಡಾಚ್ಯಾ ವರ್‍ತಿ ಹೊತ್ತೆ ಮಾಂಸ್ ಖಾಯ್ನಾತ್.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">ಜಾಕೊಬ್ ಎಸಾವಾಕ್ ಭೆಟ್ತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />ಜಾಕೊನ್ ಅಪ್ಲೆ ಡೊಳ್ಯಾನಿ ಬಗ್ತಾನಾ, ಎಸಾವ್ ಚಾರ್ಸೆ ಘೊವ್ಮಾನ್ಸಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಯೆತಲೆ ಬಗ್ಲ್ಯಾನ್, ಅಪ್ನಾಚ್ಯಾ ಪೊರಾಕ್ನಿ ಅನಿ ಲೆಯಾಕ್ ಅನಿ ರಾಖೆಲಾಕ್ ಅನಿ ದೊನ್ ದಾಸಿಯಾಕ್ನಿ ಅನಿ ತೆಂಚ್ಯಾ ಪೊರಾಕ್ನಿ ದೊನ್ ವಾಟೆ ಕರುನ್ ಎಗ್ಳ್ಯಾನ್. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />ಮಾನಾ ಜಾಕೊಬಾನ್ ಸೆವಕಿಯಾಕ್ನಿ ಅನಿ ತೆಂಚ್ಯಾ ಪೊರಾಕ್ನಿ ಅದ್ದಿ ಇಬೆ ಕರುನ್, ಮಾನಾ ಲೆಯಾಕ್ ಅನಿ ತಿಚ್ಯಾ ಪೊರಾಕ್ನಿ ತೆಚ್ಯಾ ಮಾನಾ, ರಾಖೆಲ್ ಅನಿ ಜೊಸೆಪಾಕ್ ಆಕ್ರಿಚ್ಯಾ ಜಾಗ್ಯಾರ್ ಇಬೆ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />ಮಾನಾ ಜಾಕೊಬ್ ಫಿಡೆ ಯೆವ್ನ್ ಸಾತ್ ದಾ ಜಿಮ್ನಿಕ್ ಟಕ್ಲೆ ಲಾವ್ನ್ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ ನಮಸ್ಕಾರ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 33:3" /><verse number="4" style="v" sid="GEN 33:4" />ತನ್ನಾ ಜಾಕೊಬಾಕ್ ಎಸಾವಾನ್ ಬಗುನ್, ಪಳುನ್ ಯೆವ್ನ್ ದೊನಿ ಹಾತಿನ್ ಯಾಂಗ್ ಮಾರುನ್ ತೆಚ್ಯಾ ಮಾನೆಕ್ ಉಪ್ಪಾ ದಿಲ್ಯಾನ್, ಅನಿ ತೆನಿ ದೊಗೆಬಿ ರಡ್ಲ್ಯಾನಿ. <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />ಮಾನಾ ಎಸಾವಾನ್ ಬಗ್ತಾನಾ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತಿ ಹಿ ಪೊರಾ ಅನಿ ಬಾಯ್ಕಾ ಕೊನ್? ಮಟ್ಲ್ಯಾನ್,</para>
  <para style="p" vid="GEN 33:5">ತನ್ನಾ ಜಾಕೊಬಾನ್ “ದೆವ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾವ್ನ್ ಮಾಕಾ ದಿಲ್ಲಿ ಪೊರಾ ಹಿ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 33:5" /><verse number="6" style="v" sid="GEN 33:6" />ಮಾನಾ ಸೆವಕಿಯಾ ಅನಿ ಪೊರಾ ಯೆವ್ನ್ ಡಬ್ ಪಡುನ್ ನಮಸ್ಕಾರ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />ಮಾನಾ ಲೆಯಾ ಅನಿ ತಿಚಿ ಪೊರಾ ಯೆವ್ನ್ ನಮಸ್ಕಾರ್ ಕರ್ಲ್ಯಾನಿ, ಆಕ್ರಿಕ್ ಜೊಸೆಪ್ ಅನಿ ರಾಖೆಲ್ ಯೆವ್ನ್ ತೆಕಾ ನಮಸ್ಕಾರ್ ಕರ್ಲ್ಯಾನಿ.<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />ತನ್ನಾ ಮಾನಾ ಎಸಾವಾನ್, “ಮಿಯಾ ವಾಟೆರ್ ಯೆತಾನಾ ಲೊಕಾಕ್ನಿ ಬಗ್ಲೊ ತೆನಿ ಕೊನ್ ? ಅನಿ ತಿ ಸಗ್ಳಿ ಜನಾವಾರಾ ಕಶ್ಯಾಕ್ ?” ಮಟ್ಲ್ಯಾನ್, ತನ್ನಾ ಜಾಕೊಬಾನ್, “ತಿಯಾ ಮಾಕಾ ಸ್ವಿಕಾರ್ ಕರುಂದಿತ್ ಮನುನ್ ಹೆ ಮಿಯಾ ತುಕಾ ಆಯಾರಾ ದಿಲೊ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />ತನ್ನಾ ಎಸಾವಾನ್; “ಭಾವಾ, ಮಾಜ್ಯಾಕ್ಡೆ ಪಾಜೆ ತವ್ಡಿ ಆಸ್ತಿ ಹಾಯ್; ತುಜೆ ತುಕಾಚ್ ರಾವ್ನಂದಿತ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />ತನ್ನಾ ಜಾಕೊಬಾನ್, ತಸೆ ಮನುನಕ್ಕೊ, ತಿಯಾ ಮಾಜ್ಯಾ ವರ್‍ತಿ ದಯಾ ದಾಕ್ವುನ್ ಹಿ ಆಯಾರಾ ಘೆವ್ಚೊ, ಅನಿ ತಿಯಾ ಮಾಕಾ ಪ್ರೆಮಾನ್ ಸ್ವಿಕಾರ್ ಕರ್‍ಲೆ, ಅನಿ ತುಚೆ ತೊಂಡ್ ಬಗ್ತಾನಾ ದೆವಾಚಿ ತೊಂಡ್ ಬಗಲ್ಯಾ ಸಾರ್ಕೆ ಹೊಲೆ, <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />ದೆವಾನ್ ಮಾಕಾ ಕಾಯ್ ಪಾಜೆ ತೆ ದಿಲಾ ತಿಯಾ ದಯಾ ಕರುನ್ ಮಿಯಾ ತುಜ್ಯಾ ಸಾಟ್ನಿ ಮನುನ್ ಹಾನಲ್ಲೆ ಘೆ ಮನುನ್ ಒತ್ತಾಯ್ ಕರ್ತಾನಾ ಇಸಾವಾನ್ ಘೆಟ್ಲ್ಯಾನ್.<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />ಮಾನಾ ಎಸಾವಾನ್ ತೆಕಾ, “ತುಜೊ ಪ್ರಯಾನ್ ಫಿಡೆ ಜಾಂವ್ದಿತ್ ಅಮಿ ತುಚ್ಯಾ ವಾಂಗ್ಡಾ ಯೆತಾಂವ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />ತನ್ನಾ ಜಾಕೊಬಾನ್ ತೆಕಾ, “ಮಾಜಿ ಪೊರಾ ಬಾಳಾ ಲೈ ಬಾರಿಕ್ ಹಾತ್ ಅನಿ ಜನಾವಾರಾಂಚೆ ಪೆಟೆಬಿ ಬಾರಿಕ್ ಹಾತ್ ತೆಂಕಾ ಮಿಯಾ ಎಕ್ ದಿಸ್ ಪತರ್ ಚಲಸ್ಲ್ಯಾರ್ ತೆ ಮರುನ್ ಜಾತಾತ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />ತನ್ನಾ ತಿಯಾ ಫಿಡೆ ಜಾ, ಮಿಯಾ ಫಾಟ್ನಾ ಮಾಜ್ಯಾ ಪೊರಾಕ್ನಿ ಅನಿ ಜನಾವಾರಾಂಚ್ಯಾ ಪೆಟ್ಯಾಕ್ನಿ ಕಾಯ್ಬಿ ತರಾಸ್ ಹೊಯ್ನಾ ಸಾರ್ಕೆ ಕರುನ್ ಆರಾಮಾನ್ ಯೆವ್ನ್ ಮಿಯಾ ತುಕಾ ಸೆರಿಯಿ ಮನ್ತಲ್ಯಾ ಗಾಂವಾತ್ ಭೆಟ್ತಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />ತನ್ನಾ ಎಸಾವಾನ್, ತೆಕಾ “ಮಾಜ್ಯಾ ಉಲ್ಲ್ಯಾ ಸೆವಕಾಕ್ನಿ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಸೊಡುನ್ ಜಾತಾ” ಮಟ್ಲ್ಯಾನ್ ಖರೆ ಜಾಕೊಬಾನ್ ತೆಕಾ; “ನಕ್ಕೊ” ತುಮ್ಚಿ ದಯಾ ಅಮ್ಚಾ ವರ್‍ತಿ ರಾಲ್ಯಾರ್ ಫಿರೆ ಮನುನ್ ಜಬಾಬ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 33:15" /><verse number="16" style="v" sid="GEN 33:16" />ತನ್ನಾ ಎಸಾವಾನ್ ತ್ಯಾ ದಿಸಿ ಸೆಯಿರಾಕ್ ಪಾಟಿ ಪರ್‍ತುನ್ ಗೆಲೊ. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />ಖರೆ ಜಾಕೊಬ್ ಸುಕ್ಕೊತಿ ಮನ್ತಲ್ಯಾ ಗಾಂವಾಕ್ ಜಾವ್ನ್ ಅಪ್ನಾ ಸಾಟ್ನಿ ಎಕ್ ಝೊಪ್ಡೆ ಅನಿ ಜನಾವಾರಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಎಕ್ ಗೊಟೊ ಭಾಂದ್ಲ್ಯಾನ್, ತೆಚ್ಯಾ ವೈನಾ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ “ಸುಕ್ಕೊತ್” ಮನುನ್ ನಾವ್ ಯೆಲೆ.<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />ಮಾನಾ ಜಾಕೊಬ್ ಪದ್ದನ್ ಆರಾಮಿಕ್ನಾ ಕಾನಾನ್ ದೆಶಾಚ್ಯಾ ಶೆಕೆಮ್ ಶಾರಾಕ್ ಯೆವ್ನ್ ತ್ಯಾ ಶಾರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಎಕ್ ಸೆತಾತ್ ಝೊಪ್ಡೆ ಭಾಂದ್ಲ್ಯಾನ್. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />ತೆನಿ ಶೆಕೆಮಾಚೊ ಬಾಬಾ ಹಾಮೊರಾಚ್ಯಾ ಪಿಳ್ಗಿಂಚ್ಯಾಕ್ನಾ ಸೆಂಬರ್ ಚಾಂದಿಚೆ ಪೈಸೆ ದಿವ್ನ್ ಸೆತ್ ಇಕಾತ್ ಘೆಟಲ್ಯಾನ್. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />ಅನಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ಆರಾದನ್ ಕರುಕ್ ಮನುನ್ ಎಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಭಾಂದುನ್ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ “ಎಲ್ ಎಲೊಹಿ ಇಜ್ರಾಯೆಲ್” ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">ದಿ ನಾ ಅನಿ ಶೆಕೆಮಾಚಿ ಲೊಕಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />ಜಾಕೊಬಾಕ್ ಅನಿ ಲೆಯಾಕ್ ದಿನ್ಹಾ ಮನ್ತಲಿ ಲೆಕ್ ಉಪಾಜಲ್ಲಿ, ಶೆಕೆಮ್ ಗಾವಾತ್ಲ್ಯಾ ಬಾಯ್ಕಾ ಮಾನ್ಸಾಕ್ನಿ ಭೆಟುಕ್ ಮನುನ್ ಎಕ್ ದಿಸಾ ತಿ ಭಾಯ್ರ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ, <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />ತ್ಯಾ ದೆಶ್ಯಾಧಿಪತಿ ಹಿವಿಯಾಂಚೊ ಹಾಮೊರ್ ಮನ್ತಲ್ಯಾ ರಾಜಾಚೊ ಲೆಕ್ ಶೆಕೆಮಾನ್ ದಿನಾಕ್ ಬಗುನ್ ತಿಕಾ ವಡುನ್ ನೆವ್ನ್ ಹಾಳ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತಿಚ್ಯಾ ವರ್‍ತಿ ಶೆಕೆಮಾಕ್ ಪ್ರೆಮ್ ಹೊವ್ನ್, ತಿಚ್ಯಾ ವಾಂಗ್ಡಾ ಮನ್ ಬದಲ್ತಲಿ ಗೊಸ್ಟಿಯಾ ಬೊಲ್ತಾ. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />ಮಾನಾ ಶೆಕೆಮಾನ್ ಅಪ್ಲೊ ಬಾಬಾ ಹಾಮೊರಾಕ್ಡೆ, ಮಾಕಾ ತೆ ಚೆಡು ಬಾಯ್ಕೊ ಕರುನ್ ದಿ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />ಯಾಕೊಬಾನ್ ಅಪ್ಲ್ಯಾ ಲೆಕಿಚಿ ಮರ್ಯಾದ್ ಗೆಲ್ಲಿ ಖಬರ್ ಆಯ್ಕ್ಲ್ಯಾನ್ ಖರೆ ಅಪ್ಲಿ ಲೊಕಾ ಸೆತಾಕ್ಡೆ ಗೊರಾ ರಾಕುಕ್ ಗೆಲ್ಲೆ ರ್‍ಹಾತಾತ್ ತೆನಿ ಯೆಯ್ ಪತರ್ಬಿ ಗಪ್ ಹೊತ್ತೊ. <verse eid="GEN 34:5" /><verse number="6" style="v" sid="GEN 34:6" />ತನ್ನಾ ತ್ಯಾ ಎಳಾರ್ ಶೆಕೆಮಾಚೊ ಬಾಬಾ ಜಾಕೊಬಾಕ್ ಭೆಟುನ್ ಬೊಲುಕ್ ಮನುನ್ ಯೆತಾ. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />ಜಾಕೊಬಾಚಿ ಲೆಕಾ ಅಪ್ಲ್ಯಾ ಭೆನಿಚಿ ಖಬರ್ ಆಯ್ಕುನ್ ಸೆತಾಕ್ನಾ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ ಲೈ ರಾಗ್ ಹೊಲ್ಯಾನಿ, ಶೆಕೆಮಾನ್ ಜಾಕೊಬಾಚ್ಯಾ ಲೆಕಿಚೆ ಮರ್ಯಾದ್ ಕಾಡ್ತಲ್ಲೆ ಇಜ್ರಾಯೆಲಾತ್ನಿ ಲೈ ಅವ್ಮಾನ್ ಹೊತಲೆ ಕಾಮ್ ಕರ್ಲಾ. <verse eid="GEN 34:7" /><verse number="8" style="v" sid="GEN 34:8" />ತನ್ನಾ ಹಾಮೊರಾನ್ ಮಾಜೊ ಲೆಕ್ ಶೆಕೆಮಾನ್ ತುಮ್ಚ್ಯಾ ಭೆನಿಕ್ ಲಗಿನ್ ಕರುನ್ ಘೆವ್ಕ ಲೈ ಮನ್ ಕರ್ಲಾ, ತನ್ನಾ ತುಮಿ ದಯಾ ಕರುನ್ ಲಗಿನ್ ಕರುನ್ ದಿವಾ, ಮನುನ್ ದಿನಾಚ್ಯಾ ಭಾವಾಂಚ್ಯಾಕ್ಡೆ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />ತುಮ್ಚ್ಯಾ ಚೆಡ್ವಾಕ್ನಿ ಅಮ್ಕಾ ಲಗಿನ್ ಕರುನ್ ದಿವಾ ಅನಿ ಅಮ್ಚ್ಯಾ ಚೆಡ್ವಾಕ್ನಿ ತುಮ್ಕಾ ಲಗಿನ್ ಕರುನ್ ದಿತಾಂವ್, ಅಸೆ ಅಮಿ ಸೈರೆ ಹೊತಾಂವ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />ಅನಿ ತುಮಿ ಹಿತ್ತೆ ಆರಾಮಾನ್ ಜಿವನ್ ಕರುಕ್ ಹೊತಾ, ಅನಿ ವ್ಯಾಪಾರ್ ಬಿ ಕರುಕ್ ಹೊತಾ, ಅನಿ ಆಸ್ತಿಬಿ ಖಮ್ವುಕ್ ಹೊತಾ, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />ಮಾನಾ ದಿನಾಚ್ಯಾ ಭಾವಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ‍ ಶೆಕೆಮಾನ್ ಬೊಲುನ್, ತುಮ್ಚ್ಯಾಕ್ಡೆ ಅಮ್ಕಾ ದಯಾ ಗಾಂವ್ದಿತ್ ತುಮಿ ಇಚಾರಲ್ಲೆ ತವ್ಡೆ ಅಮಿ ದಿತಾಂವ್. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />ಅನಿ ತುಮಿ ದಿನಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಲಗಿನ್ ಕರುನ್ ಘೆವ್ಕ್ ಮಾಕಾ ಅವ್ಕಾಸ್ ಕರುನ್ ದಿಲ್ಯಾರ್ ಫಿರೆ, ಮಾನಾ ಮಿಯಾ ತುಮ್ಕಾ ವದುದಕ್ಷಿನಿ ಅನಿ ಆಯಾರಾಬಿ ದಿತಾ, ಖರೆ ತುಮಿ ಮಾಕಾ ದಿನಾಕ್ ಲಗಿನ್ ಕರುನ್ ದಿಲ್ಯಾರ್ ಫಿರೆ, ಮನುನ್ ಮಾಗುನ್ ಘೆಟ್ಲ್ಯಾನ್.<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />ತನ್ನಾ ಜಾಕೊಬಾಚ್ಯಾ ಲೆಕಾಕ್ನಿ ತೆಂಚ್ಯಾ ಭೆನಿಚ್ಯಾ ವರ್‍ತಿ ಶೆಕೆಮಾನ್ ಕರಲ್ಯಾ ಬುರ್ಶಾ ಕಾಮಾ ವೈನಾ ಲೈ ರಾಗ್ ಹೊತ್ತ್ಯಾಕ್ ತೆನಿ ಶೆಕೆಮಾಕ್ ಅನಿ ತೆಚ್ಯಾ ಬಾಬಾಕ್ ಝುಟೆ ಸಾಂಗುಚೆ ಮನುನ್ ಚಿಂತುನ್, <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />ಅಮ್ಚಿ ಭೆನ್ ತುಕಾ ಲಗಿನ್ ಹೊವ್ಕ್ ಹೊಯ್ನಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತುಕಾ ಸುನ್ನತ್ ಹೊವ್ಕ್ ನಾ ಮನುನ್ ತಿಯಾ ಅಮ್ಚ್ಯಾ ಭೆನಿಕ್ ಲಗಿನ್ ಹೊವ್ಕ್ ಅಮಿ ಅವ್ಕಾಸ್ ಕರುನ್ ದಿನಾವ್, ತಿಯಾ ಅಮ್ಚ್ಯಾ ಭೆನಿಕ್ ಲಗಿನ್ ಹೊಲ್ಯಾರ್ ಅಮ್ಕಾ ಅವ್ಮಾನ್ ಹೊತಾ.<verse eid="GEN 34:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 34:15" />ಖರೆ ಅಮಿ ಎಕುಚ್ ಎಕ್ ಶರತ್ತಾಕ್ನಾ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಕರಾರ್ ಕರುನ್ ಘೆತಾಂವ್, ತುಮ್ಚ್ಯಾತ್ಲ್ಯಾ ಹರ್ ಎಕ್ ಘೊಮ್ಸಾತ್ನಿ ಸುನ್ನತ್ ಕರ್‍ತಲ್ಯಾ ವೈನಾ ತುಮಿ ಅನಿ ಅಮಿ ಎಕುಚ್ ಪದ್ದತಿಚೆ ಹೊತ್ಯಾಂವ್.<verse eid="GEN 34:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 34:16" />ಮಾನಾ ತುಮ್ಚಿ ಘವ್ಮಾನ್ಸಾ ಅಮ್ಚ್ಯಾ ಚೆಡ್ವಾಕ್ನಿ ಅನಿ ಅಮ್ಚಿ ಘವ್ಮಾನ್ಸಾ ತುಮ್ಚ್ಯಾ ಚೆಡ್ವಾಕ್ನಿ ಲಗಿನ್ ಹೊವ್ನ್ ಅಮಿ ಅನಿ ತುಮಿ ಎಕುಚ್ ಖಂದಾನಾಚೆ ಹೊತಾಂವ್. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />ಖರೆ ತಿಯಾ ಸುನ್ನತ್ ಕರ್ಸುನ್ ಘೆಯ್ ನಸ್ಲ್ಯಾರ್ ಅಮಿ ಅಮ್ಚ್ಯಾ ಭೆನಿಕ್ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಜಾತಾಂವ್ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನಿ.<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />ತನ್ನಾ ತೆನಿ ಸಾಂಗಲ್ಲೆ ಹಾಮೊರಾಕ್ ಅನಿ ಶೆಕೆಮ್ ಖುಶಿ ಹೊಲೆ. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />ತ್ಯಾ ದಾಂಡ್ಗ್ಯಾ ಮಾನ್ಸಾನ್ ಜಾಕೊಬಾಚಿ ಲೆಕ್ ದಿನಾಕ್ ಲೈ ಪ್ರೆಮ್ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತೆನಿ ಸಾಂಗ್ಲ್ಯಾ ಸಾರ್ಕೆ ಕರುನ್ ತಡೊ ಕರುಕ್ ನಾ ಅಪ್ಲ್ಯಾ ಬಾಬಾಚ್ಯಾ ಘರ್‍ಹಾತ್ ಹೊತ್ತ್ಯಾ ಸಗ್ಳೆ ಶೆಕೆಮಾಕ್ ಮರ್ಯಾದ್ ದಿತ್.<verse eid="GEN 34:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 34:20" />ತೆಚ್ಯಾ ವೈನಾ ಹಾಮೊರ್ ಅನಿ ಶೆಕೆಮಾನ್ ಅಪ್ಲ್ಯಾ ಗಾಂವಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲುಕ್ ಮನುನ್ ಶಾರಾಚ್ಯಾ ದಡ್ಪ್ಯಾಕ್ಡೆ ಗೆಲ್ಯಾನಿ. <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />ಹಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಅಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಸಮಾಧಾನಾನ್ ಹಾತ್, ಅನಿ ತೆಂಕಾ ಹಿತ್ತೆ ರಾವ್ಕ್ ಮನುನ್ ಲೈ ಜಿಮಿನ್ ಹಾಯ್ ಅನಿ ತೆನಿ ಹಿತ್ತೆ ವ್ಯಾಪಾರ್ ಕರುಂದಿತ್, ಅನಿ ಅಮಿ ತೆಂಚ್ಯಾ ಚೆಡ್ವಾಕ್ನಿ ಲಗಿನ್ ಕರುನ್ ಘೆಂವ್ವಾ, ತೆನಿ ಅಮ್ಚ್ಯಾ ಚೆಡ್ವಾಕ್ನಿ ಲಗಿನ್ ಹೊಂವ್ದಿತ್ ತೆನಿ ಹಿತ್ತೆ ಫಿರುನ್ಕೆಳುನ್ಗೆತ್ ರಾಂವ್ದಿತ್. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />ಖರೆ ತೆನಿ ಸುನ್ನತ್ ಕರ್ಸುನ್ ಘೆಟಲ್ಯಾ ವೈನಾ ತುಮ್ಚ್ಯಾತ್ಲೆ ಸಗ್ಳ್ಯಾ ಘೊಮಾನ್ಸಾನಿ ಸುನ್ನತ್ ಕರುನ್ ಘೆವ್ಚೆ ಮನುನ್ ಸಾಂಗುಲ್ಲಾತ್ ಅನಿ ತೆನಿ ಅಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ವಸ್ತಿ ರಾವ್ಕ್ ಸಾಟ್ನಿ ಮನುನ್ ಅನಿ ಎಕುಚ್ ಪದ್ದತಿಚೆ ಹೊವ್ಕ್ ಅಮಿ ಮಾನುನ್ ಘೆಂವ್ವಾ.<verse eid="GEN 34:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 34:23" />ಅಸೆ ಕರ್ಲ್ಯಾರ್ ಅಮಿ ತೆಂಚ್ಯಾಕ್ನಾ ಗೊಸ್ಟ್ ಕರುನ್ ಘೆಟ್ಲ್ಯಾರ್, ತೆನಿ ಹಿತ್ತೆಚ್ ರ್‍ಹಾತಾತ್ ಮಾನಾ ತೆಂಚಿ ಘೊರಾ ಅನಿ ಬಕ್ರಿಯಾ ಜನಾವಾರಾಂಚ್ಯಾ ವೈನಾ ಅಮಿ ಲೈ ಸಾವ್ಕಾರ್ ಹೊತಾಂವ್ ನೈ? ತೆಚ್ಯಾ ವೈನಾ ಅಮಿ ತೆಂಚ್ಯಾ ಗೊಸ್ಟಿಕ್ ಒಪ್ಪುನ್ ಘೆಂವ್ವಾ ಮಟ್ಲ್ಯಾನಿ. <verse eid="GEN 34:23" /><verse number="24" style="v" sid="GEN 34:24" />ಮಾನಾ ಶಹಾರಾಚ್ಯಾ ದಡ್ಪ್ಯಾತ್ನಾ ಭಾಯ್ರ್ ಗೆಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಘೊಮಾನ್ಸಾನಿ ಹಾಮೊರಾಚ್ಯಾ ಅನಿ ಶೆಕೆಮಾಚ್ಯಾ ಗೊಸ್ಟಿಕ್ ಮಾನುನ್ ಸುನ್ನತ್ ಕರ್ಸುನ್ ಘೆಟ್ಲ್ಯಾನಿ.<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />ತಿನ್ವೆಚ್ಯಾ ದಿಸಿ ಸುನ್ನತ್ ಕರ್ಸುನ್ ಘೆಟಲ್ಯಾ ಘವ್ಮಾನ್ಸಾಚೆ ದುಕ್ಕ್ ಮರಲ್ಲೆ ರ್‍ಹಾಯ್ನಾ ತನ್ನಾ ತೆನಿ ಕೊನ್ಬಿ ಭಾಯ್ರ್ ಯೆಯ್ ನತ್ತೊ ಎಳ್ ಅನಿ ತೆಂಕಾ ತಾಕತ್ ನಸಲೊ ಎಳ್ ಬುಗುನ್, ಜಾಕೊಬಾಚಿ ಲೆಕಾ ಸಿಮೆಯೊನ್ ಅನಿ ಲೆವಿ ಹೆನಿ ದಿನಾಚಿ ಭಾವಾ , ಹಾತಿತ್ ಸುರಿಯಾ ಧರುನ್ ಘೆವ್ನ್ ಧೈರ್ಯಾನಿ ಶಾಹಾರಾಕ್ ಯೆವ್ನ್ ಘೊಮಾನ್ಸಾಕ್ನಿ ಮಾರುನ್ ಟಾಕ್ಲ್ಯಾನಿ. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />ಮಾನಾ ದಿನಾಚ್ಯಾ ಭಾವಾನಿ ಹಾಮೊರಾಕ್ ಅನಿ ತೆಜೊ ಲೆಕ್ ಶೆಕೆಮಾಚೊ ಜಿವ್ ಕಾಡುನ್ ಶೆಕೆಮಾಚ್ಯಾ ಘರ್‍ಹಾತ್ ಹೊತ್ತ್ಯಾ ದಿನ್ಹಾಕ್ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಯೆಲ್ಯಾನಿ. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />ಮಾನಾ ಶೆಕೆಮಾನ್ ಅಪ್ನ್ಯಾಚ್ಯಾ ಭೆನಿಚಿ ಮರ್ಯಾದ್ ಕಾಡಲ್ಯಾ ವೈನ್‍ ತ್ಯಾ ಶಾರ್‍ಹಾತ್ ಹೊತ್ತೆ ಸಗ್ಳೆ ಘೆವ್ನ್ ಜಾಕೊಬಾಚ್ಯಾ ಪೊರಾನಿ ಘೆವ್ನ್ ಯೆಲ್ಯಾನಿ . <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />ಅನಿ ಶಾರ್‍ಹಾತ್ ಹೊತ್ತೆ ಅನಿ ಸೆತಾತ್ ಹೊತ್ತೆ ಸಗ್ಳೆ ಅನಿ ಗೊರಾ ಬಕ್ರಿಯಾ , ಗಾಡ್ವಾ ಅನಿ ಸಗ್ಳಿ ತೆಂಚಿ ಆಸ್ತಿ ಕಾಡುನ್ ಘೆಟ್ಲ್ಯಾನಿ. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />ಅನಿ ತೆಂಚ್ಯಾ ಬಾಯ್ಕೊ ಪೊರಾಕ್ನಿ ಬಂಧಿ ಕರುನ್ ತೆಂಚ್ಯಾ ಘರ್‍ಹಾತ್ ಹೊತ್ತೆ ಕಿಮ್ತಿಚೆ ಸಮಾನಾ ಕಾಡುನ್ ಘೆವ್ನ್ ಯೆಲ್ಯಾನಿ.<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />ಹೊಲ್ಯಾರ್ ಜಾಕೊಬಾನ್ ಸಿಮೊನಾಕ್ ಅನಿ ಲೆವಿಕ್, ಮಾಕಾ ತುಮಿ ಕಸ್ಟಾತ್ ಗಾಟ್ಲ್ಯಾಸಿ ತುಮಿ ಹ್ಯಾ ದೆಶ್ಯಾಚ್ಯಾ ಕಾನಾನ್ಯಾಚಿ ಅನಿ ಪರಿಜೆವಾಂಚಿ ಲೊಕಾ ಅಮ್ಚಾ ವರ್‍ತಿ ವಿರೊಧ್ ಹೊವ್ನ್ ಯೆತಾತ್, ಅನಿ ಅಮ್ಚ್ಯಾಕ್ಡೆ ಉಲ್ಲಿ ಘವ್ಮಾನ್ಸಾ ಹಾತ್, ತ್ಯಾ ದೆಶಾಚಿ ಲೊಕಾ ಘೊಳಾ ಹೊವ್ನ್ ಅಮ್ಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಯೆಲ್ಯಾರ್ ಅಮಿ ಅನಿ ಅಮ್ಚಿ ಲೊಕಾ ನಾಶ್ ಹೊವ್ನ್ ಜಾತಾಂವ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />ಖರೆ ದಿನಾಚ್ಯಾ ಭಾವಾನಿ ಅಮ್ಚ್ಯಾ ಭೆನಿಕ್ ತೆನಿ ವ್ಯಬಿಚಾರನಿಚ್ಯಾ ಸಾರ್ಕೆ ಉಪಯೊಗ್ ಕರುನ್ ಘೆಟಲ್ಲೆ ಸಮಾ ಹಾಯ್ ಕಾಯ್? ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">ದೆವಾನ್ ಜಾಕೊಬಾಕ್ ಬೆತೆಲಾತ್ ಆಶಿರ್ವಾದ್ ದಿಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />ದೆವಾನ್ ಜಾಕೊಬಾಕ್, “ತಿಯಾ ಬೆತೆಲ್ ಶಾಹರಾಕ್ ಜಾ, ಅನಿ ಥೈ ವಸ್ತಿ ರಾ, ತುಜೊ ಭಾವ್ ಎಸಾವಾಕ್ ಭಿಂವ್ನ್ ಪಳುನ್ ಜಾತಾನಾ ತುಕಾ ದರ್ಶನ್ ದಿಲ್ಲ್ಯಾ ದೆವಾಕ್ ಎಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಭಾಂದ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />ತೆಚ್ಯಾ ವೈನಾ ಜಾಕೊಬಾನ್ ಅಪ್ಲ್ಯಾ ಕುಟ್ಮಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಅನಿ ಸೆವಕಾಕ್ನಿ, ತುಮ್ಚಿ ದುಸ್ರ್ಯಾ ದೆವಾಂಚಿ ಮುರ್ತಿಯಾ ಸಗ್ಳಿ ಭಾಯ್ರ್ ಘಾಲಾ, ಅನಿ ತುಮಿ ಪವಿತ್ರ್ ಹೊವ್ನ್ ನಿತಳ್ ಕಪ್ಡೆ ನೆಸುನ್ ಘೆವಾ.<verse eid="GEN 35:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 35:3" />ಅನಿ ಯೆವಾ ಅಮಿ ಹ್ಯೊ ಜಾಗೊ ಸೊಡುನ್ ಬೆತಲಿಕ್ ಜಾಂವಾ; ಅನಿ ಮಿಯಾ ಜಾತಲ್ಯಾಕ್ಡೆ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾವ್ನ್, ಮಿಯಾ ತರಾಸಾತ್ ರ್‍ಹಾತಾನಾ ಮಜತ್ ಕರಲ್ಯಾ ದೆವಾಕ್ ಎಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಭಾಂದ್ತಾ, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />ಮಾನಾ ತೆನಿ ಜಾಕೊಬಾಕ್ ತೆಂಚ್ಯಾಕ್ಡೆ ಹೊತ್ತಿ ದುಸ್ರ್ಯಾ ದೆವಾಚ್ಯಾ ಮುರ್ತಿಯಾಕ್ನಿ ಅನಿ ತೆಂಚ್ಯಾ ಕಾನಾತ್ಲಿ ಫುಲ್ಲಾ ಸಗ್ಳಿ ಕಾಡುನ್ ದಿಲ್ಯಾನಿ, ತೆನಿ ತೆ ಸಗ್ಳೆ ಘೆವ್ನ್ ಶೆಕೆಮಾಚ್ಯಾ ಜಗೊಳ್ಯಾ ಒಕ್ ಝಾಡಾಚ್ಯಾ ಬುಡಿ ಪುರ್ಲ್ಯಾನ್.<verse eid="GEN 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 35:5" />ಮಾನಾ ಜಾಕೊಬ್ ಅನಿ ತೆಚಿ ಲೆಕಾ ಜಾತಾನಾ ಜಗ್ಗೊಳ್ಯಾ ಶಾಹಾರಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ದೆವಾಚ್ಯಾ ವರ್‍ತಿ ಲೈ ಭಿಂಯೆ ಹೊತ್ತ್ಯಾ ವೈನಾ ತೆನಿ ತೆಂಕಾ ಫಾಟ್ ಲಾಗುನ್ ಜಾವ್ಕ್ ನಾತ್. <verse eid="GEN 35:5" /><verse number="6" style="v" sid="GEN 35:6" />ಮಾನಾ ಜಾಕೊಬ್ ಅನಿ ತೆಚಿ ಲೊಕಾ ಅತ್ತ್ಯಾಚ್ಯಾ ಬೆತೆಲ್ ಗಾವ್ಚ್ಯಾ ಕಾನಾನ್ ದೆಶಾಚ್ಯಾ ಲುಜಿಕ್ ಜಾವ್ನ್ ಪಾವ್ಲ್ಯಾನಿ. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />ತೊ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ನಾ ಚುಕ್ವುನ್ ಘೆವ್ನ್ ಪಳುನ್ ಜಾತಾನಾ, ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತೆಕಾ ಅದ್ದಿ ದರ್ಶನ್ ದಿಲ್ಲೊ ಜಾಗೊ ಹೊಲ್ಲೊ ರ್‍ಹಾತಾ, ತನ್ನಾ ತೆನಿ ಥೈ ಎಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಭಾಂದುನ್, ತ್ಯಾ ಜಾಗ್ಯಾಕ್ “ಎಲ್ ಬೆತೆಲ್” ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 35:7" /><verse number="8" style="v" sid="GEN 35:8" />ಮಾನಾ ರೆಬೆಕ್ಕಾಚಿ ಸುಯಿನ್ ದೆಬೊರಾ ತ್ಯಾ ಗಾಂವಾತ್ ಮರುನ್ ಗೆಲಿ, ತೆನಿ ತಿಕಾ ಬೆತೆಲಾಚ್ಯಾ ದಕ್ಷಿನಾಕ್ ಎಕ್ ಝಾಡಾಚ್ಯಾ ಬುಡಿ ಮಾಟಿ ದಿಲ್ಯಾನಿ, ಮಾನಾ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ “ಅಲ್ಲೊನ್ ಬಾಕುತ್ ” ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನಿ.<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />ದೆವಾನ್ ಜಾಕೊಬಾಕ್ ಪದ್ದಾನ್ ಅರಾಮಿಕ್ನಾ ಪರ್‍ತುನ್ ಯೆಲ್ಲ್ಯಾ ಮಾನಾ ತೆಕಾ ಅನಿಬಿ ದರ್ಶನ್ ದಿವ್ನ್ ಆಶಿರ್ವಾದ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />ದೆವಾನ್ ಜಾಕೊಬಾಕ್, ತುಜೆ ನಾವ್ ಜಾಕೊಬ್ ನೈ ಕಾಯ್ ? ಖರೆ ತಿಯಾ ಹೆಚ್ಯಾನ್ ಫಿಡೆ ಜಾಕೊಬ್ ಹೊವ್ನ್ ರಾಯ್‍ ನಸ್ತಾನಾ ಇಜ್ರಾಯೆಲ್ ಹೊವ್ನ್ ರಾವ್ಚೊ, ತಸೆ ಹೊವ್ನ್ ತೆಕಾ ಇಜ್ರಾಯೆಲ್ ಮನುನ್ ನಾವ್ ಹೊಲೆ. <verse eid="GEN 35:10" /><verse number="11" style="v" sid="GEN 35:11" />ಮಾನಾ ದೆವಾನ್ ತೆಕಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್, ತುಕಾ ಲೈ ಪೊರಾ ಹೊವ್ನ್ ತುಜಿ ಪಿಳ್ಗಿ ಲೈ ವಾಡುನ್ ಮೊಟೊ ತಾಂಡೊ ಹೊತಾ ಅನಿ ತುಜ್ಯಾ ಪಿಳ್ಗಿತ್ನಾ ರಾಜಾ ಉಪಾಜ್ತಾತ್, <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />ಅನಿ ಮಿಯಾ ಅಬ್ರಾಹಾಮಾಕ್ ಅನಿ ಇಸಾಕಾಕ್ ಎಕ್ ವಿಶೆಸ್ ದೆಶ್ ದಿಲ್ಲೊ, ಅತ್ತಾ ಮಿಯಾ ತುಕಾ ಅನಿ ತುಜ್ಯಾ ಫಿಡ್ಲ್ಯಾ ಪಿಳ್ಗಿಕ್ ತೊ ದೆಶ್ ದಿತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 35:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 35:13" />ಮಾನಾ ದೆವ್ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲುನ್, ತ್ಯಾ ಜಾಗ್ಯಾವೈನಾ ವರ್‍ತಿ ಗೆಲೊ. <verse eid="GEN 35:13" /><verse number="14" style="v" sid="GEN 35:14" />ಮಾನಾ ಜಾಕೊಬಾನ್ ತೊ ಜಾಗೊ ವಿಶೆಸ್ ಮನುನ್ ತ್ಯಾ ಜಾಗ್ಯಾರ್ ಎಕ್ ಗುಂಡೊ ಇಬೆ ಕರುನ್ ತೆಕಾ ಒಲಿವಾಚೆ ತೆಲ್ ಅನಿ ವಾಯ್ನ್ ಒತುನ್ ಪವಿತ್ರ್ ಕರ್ಲ್ಯಾನ್.<verse eid="GEN 35:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 35:15" />ಮಾನಾ ತೆನಿ ದೆವಾನ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲ್ಯಾನ್ ಮನುನ್ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ “ಬೆತೆಲ್” ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 35:15" /></para>
  <para style="s">ರಾಖೆಲಾಚೆ ಮರಾನ್</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />ಮಾನಾ ಜಾಕೊಬ್ ಅನಿ ತೆಚಿ ಲೊಕಾ ಬೆತ್ಲೆಹೆಮಾತ್ ಎಪ್ರಾಹಾತ್ ಮನ್ತಲ್ಯಾ ಗಾಂವಾಕ್ ಜಾವ್ಚೆ ಮನುನ್ ಹೊತ್ತ್ಯಾ ಎಳಾರ್, ರಾಖೆಲಾಕ್ ಲೈ ಮೊಟೊ ಪೊರ್ ಉಪಾಜ್ತಲೊ ತರಾಸ್ ಶುರು ಹೊಲೊ, <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />ಖರೆ ತಿಕಾ ತರಾಸ್ ಸೊಸುನ್ಗೆವ್ಕ್ ಹೊಯ್ನಸಿ ತನ್ನಾ ತಿಜಾ ಸುಯಿನಿನ್ ತಿಕಾ, “ರಾಖೆಲ್ ಬ್ಹಿಂವ್ ನಕ್ಕೊ, ತಿಯಾ ಅನಿ ಎಕ್ ಝಿಲ್ಗ್ಯಾಕ್ ಜಲಮ್ ದಿವ್ಲೆ” ಮಟ್ಲಿನ್. <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />ತಿ ಜಿವ್ ಸೊಡ್ತಾ ಸೊಡ್ತಾನಾಚ್ ತೆಕಾ ತಿನಿ ಬೆನೊನಿ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್, ಖರೆ ತೆಜಾ ಬಾಬಾನ್ ತೆಕಾ ಬೆಂಜ್ಯಾಮಿನ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />ರಾಖೆಲ್ ಮರುನ್ಗೆಲಿ, ಅನಿ ತಿಕಾ ಎಪ್ರಾಹಾತಾಕ್ ಜಾತಲ್ಯಾ ವಾಟೆಕುಚ್ ಮಾಟಿ ಕರ್ಲ್ಯಾನಿ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ ಅತ್ತಾ ಬೆತ್ಲೆಹೆಮ್ ಮನ್ತ್ಯಾತ್.<verse eid="GEN 35:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 35:20" />ಮಾನಾ ರಾಖೆಲಾಚ್ಯಾ ಸಾರಿಚ್ಯಾ ವರ್‍ತಿ ಜಾಕೊಬಾನ್ ಎಕ್ ವಿಶೆಸ್ ಖಾಂಬೊ ಥಲ್ಲ್ಯಾನ್, ಅತ್ತಾಬಿ ತೊ ಗುಂಡೊ ಥೈಚ್ ಹಾಯ್, ಅಜುನ್ ಪತರ್ಬಿ ರಾಖೆಲಾಚಿ ಸಮಾಧಿ ಮನುನ್ ಬಲ್ವುತಾತ್. <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />ಮಾನಾ ಇಜ್ರಾಯೆಲ್ ಫಿಡೆ ಜಾವ್ನ್ “ಮಿಗ್ದಲ್ ಎದರ್” ಗೊಪುರಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಝೊಪ್ಡೆ ಭಾಂದುನ್ ಘೆಟ್ಲ್ಯಾನ್.<verse eid="GEN 35:21" /></para>
  <para style="s">ಜಾಕೊಬಾಚಿ ಲೆಕಾ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />ಮಾನಾ ಲೈ ಎಳ್ ಪತರ್ ಇಜ್ರಾಯೆಲ್ ಥೈ ವಸ್ತಿ ಹೊತ್ತೊ ಅನಿ ತೆಕಾ ಬಾರಾ ಲೆಕಾ ರ್‍ಹಾತಾತ್,</para>
  <para style="p" vid="GEN 35:22">ತನ್ನಾ ಅಪ್ಲಿ ಅನಿ ಎಕ್ ಬಾಯ್ಕೊ ಬಿಲ್ಹಾ ವಾಂಗ್ಡಾ ರುಬೆನಾನ್ ನಿಜಲ್ಲಿ ಖಬರ್ ಆಯ್ಕುನ್ ತೆಕಾ ಲೈ ರಾಗ್ ಯೆತಾ, <verse eid="GEN 35:22" /><verse number="23" style="v" sid="GEN 35:23" />ಲೆಯಾಚಿ ಲೆಕಾ, ಜಾಕೊಬಾಚೊ ಥೊರ್ಲೊ ಲೆಕ್ ರುಬೆನ್, ಸಿಮಿಯೊನ್, ಲೆವಿ, ಜೆಹುದ್, ಇಸ್ಸಾಕಾರ್, ಅನಿ ಜೆಬೊಲೊನ್. <verse eid="GEN 35:23" /><verse number="24" style="v" sid="GEN 35:24" />ರಾಖೆಲಾಚಿ ಲೆಕಾ ಜೊಸೆಪ್ ಅನಿ ಬೆಂಜ್ಯಾಮಿನ್. <verse eid="GEN 35:24" /><verse number="25" style="v" sid="GEN 35:25" />ಅನಿ ರಾಖೆಲಾಚಿ ದಾಸಿ ಬಿಲ್ಹಾಚಿ ಲೆಕಾ: ದಾನ್ ಅನಿ ನಪ್ತಾಲಿ. <verse eid="GEN 35:25" /><verse number="26" style="v" sid="GEN 35:26" />ಅನಿ ಲೆಯಾಚಿ ದಾಸಿ ಜಿಲ್ಪಾಚಿ ಲೆಕಾ: ಗಾದ್ ಅನಿ ಆಶೆರ್, ಹೆನಿ ಸಗ್ಳೆ ಜಾಕೊಬ್ ಪದ್ದನ್ ಅರಾಮಿತ್ ರ್‍ಹಾತಾನಾ ಉಪಾಜಲ್ಲಿ ಲೆಕಾ.<verse eid="GEN 35:26" /></para>
  <para style="s">ಇಸಾಕಾಚೆ ಮರಾನ್</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />ಜಾಕೊಬ್ ಅಪ್ಲೊ ಬಾಬಾ ಇಸಾಕ್ ಹೊತ್ತ್ಯಾ ಕಡೆ ಯೆಲೊ, ಮಾಮ್ರೆ ಹೆಬ್ರೊನ್ ಮನ್ತಲ್ಯಾ ಕಿರ್ಯತರ್ಬಾತ್ ಹಾಯ್ ಅಬ್ರಾಹಾಮ್ ಅನಿ ಇಸಾಕ್ ತ್ಯಾ ಗಾಂವಾತ್ ವಸ್ತಿ ರಾಯ್ತ್. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />ಮಾನಾ ಇಸಾಕಾನ್ ಎಕ್ಸೆ ಆಯ್ಸಿ ವರಿಸ್ ಝಿತ್ತೊ ರಾಲೊ. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />ಅನಿ ಇಸಾಕಾಕ್ ಲೈ ವರ್ಸಾಚೊ ಮ್ಹಾತಾರೊ ಹೊವ್ನ್ ಫುರಾ ಆಯ್ಸ್ ಭರುನ್ ಮರುನ್ ಅಪ್ಲ್ಯಾ ವಾಡ್ ವಡ್ಲಾಕ್ನಿ ಜಾವ್ನ್ ಮಿಳ್ಳೊ, ತೆಚಿ ಲೆಕಾ ಎಸಾವ್ ಅನಿ ಜಾಕೊಬಾನ್ ತೆಕಾ ಮಾಟಿ ದಿಲ್ಯಾನಿ.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">ಎಸಾವಾಚಿ ಪಿಳ್ಗಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />ಹಿ ಎದೊಮ್ ಮನ್ತಲ್ಯಾ ಎಸಾವಾಚಿ ವಂಶಾವಳಿ; <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />ಎಸಾವಾನ್ ಕಾನಾನ್ ಲೊಕಾಂಚ್ಯಾ ಬಾಯ್ಕಾ ಮಾನ್ಸಾತ್ನಿ ಲಗಿನ್ ಕರುನ್ಗೆಟ್ಲ್ಯಾನ್ ತಿ, ಹಿತ್ತಿಯಾಂಚ್ಯಾ ಎಲೊನಾಚಿ ಲೆಕ್ ಆದಾ, ಹಿವಿಯಾಂಚ್ಯಾ ಸಿಬೊನಾಚೊ ಲೆಕ್ ಅನಾಹಾಚಿ ಲೆಕ್ ಒಹೊಲಿಬಾಮ್, <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />ಅನಿ ಇಸ್ಮಾಯೆಲಾಚಿ ಲೆಕ್ ಅನಿ ನೆಬಾಯೊತಾಚಿ ಭೆನ್ ಬಾಸೆಮತ್. <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />ಎಸಾವಾಕ್ ಆದಾ ಮನ್ತಲಿಕ್ ಎಲಿಫಜ್, ಅನಿ ಬಾಸೆಮತಾಕ್ ರೆಗುವೆಲ್ ಉಪಜ್ಲೊ. <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />ಒಹೊಲಿಬಾಮಾಕ್ ಯೆಗುಶ್, ಯೆಳಾಮ್ ಅನಿ ಕೊರಹ್ ಉಪಾಜ್ಲೆ ಹೆನಿ ಸಗ್ಳೆ ಜಾನಾಬಿ ಎಸಾವ್ ಕಾನಾನಾಂಚ್ಯಾ ಗಾಂವಾತ್ ಹೊತ್ತ್ಯಾ ತನ್ನಾ ಉಪಾಜ್ಲೆ.<verse eid="GEN 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6" />ಎಸಾವಾನ್ ಅಪ್ಲಿ ಬಾಯ್ಕಾ ಅನಿ ಪೊರಾಕ್ನಿ ಅನಿ ಅಪ್ಲ್ಯಾ ಘರಾಕ್ ಸಮಂದ್ ಪಡಲ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿಬಿ, ಅನಿ ಅಪ್ನಾಕ್ ಹೊತ್ತಿ ಜನಾವರಾ, ಕಾನಾನ್ ಗಾಂವಾತ್ ತೆನಿ ಖಮ್ವಲ್ಲಿ ಆಸ್ತಿ ಸಗ್ಳಿ ಘೆವ್ನ್ ಅಪ್ಲೊ ಭಾವ್ ಜಾಕೊಬಾಚ್ಯಾ ಜಗ್ಗೊಳ್ನಾ ದುಸ್ರಾ ದೆಸಾಕ್ ಗೆಲೊ, <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />ತೆಂಚಿ ಆಸ್ತಿ ಲೈ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ತೆನಿ ದೊಗೆಬಿ ಎಕುಚ್ ಜಗ್ಯಾರ್ ರಾವ್ಕ್ ಹೊವ್ಕ್ನಾ, ತೆಂಚ್ಯಾಕ್ಡೆ ಹೊತ್ತಿ ಜನಾವರಾ ಲೈ ಹೊಲ್ಲ್ಯಾ ವೈನಾ ತೆನಿ ವಸ್ತಿ ಹೊತ್ತೊ ಜಾಗೊ ತೆಂಕಾ ಪಾವ್ಕ್ನಾ. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />ಹೆಜ್ಯಾ ವೈನಾ ಎದೊಮ್ ಮನ್ತಲೊ ಎಸಾವ್ ಸೆಯಿರ್ ಮಡ್ಡಿಚ್ಯಾ ಜಾಗ್ಯಾಕ್ ಜಾವ್ನ್ ಥೈಚ್ ವಸ್ತಿ ರಾಲೊ.<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />ಸೆಯಿರಾಂಚ್ಯಾ ಮಡ್ಡಿತ್ ಹೊತ್ತ್ಯಾ ಎದೊಮ್ಯಾಂಚೊ ವಾಡ್ ವಡಿಲ್ ಎಸಾವಾಚಿ ವಂಶಾವಳಿ ಅಸಿ ಹಾಯ್, <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />ಎಸಾವಾಚಿ ಬಾಯ್ಕೊ ಆದಾ ಮನ್ತಲಿಕ್ ಎಲಿಫಜ್, ಅನಿ ಬಾಸೆಮತ್ ಮನ್ತಲಿಕ್ ರೆಗುಯೆಲ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ. <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />ಎಲಿಫಜಾಕ್ ತೆಮಾನ್, ಒಮಾರ್, ಚೆಪೊ, ಗತಾಮ್ ಅನಿ ಕೆನಜ್ ಮನ್ತಲಿ ಪಾಂಚ್ ಪೊರಾ, <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />ಎಸಾವಾಚೊ ಲೆಕ್ ಎಲಿಫಜಾಕ್ ತಿಮ್ನಾ ಮನ್ತಲಿ ದೊನ್ವಿ ಬಾಯ್ಕೊ ಹೊತ್ತಿ, ತಿಕಾ ಅಮಾಲೆಕಾ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ ,</para>
  <para style="p" vid="GEN 36:12">ಹೆನಿ ಎಸಾವಾಚಿ ಬಾಯ್ಕೊ ಆದಾಚಿ ಪಿಳ್ಗಿ ಚೆ, <verse eid="GEN 36:12" /><verse number="13" style="v" sid="GEN 36:13" />ರೆಗುಯೆಲಾಕ್ ನಹತ್, ಜೆರಹ್, ಶಮ್ಮಾ, ಅನಿ ಮಿಜ್ಜಾ ಮನ್ತಲಿ ಚಾರ್ ಪೊರಾ ಹೆನಿ ಎಸಾವಾಚಿ ಬಾಯ್ಕೊ ಬಾಸೆಮತ್ ಮನ್ತಲಿಚ್ಯಾ ಪಿಳ್ಗಿಚೆ.<verse eid="GEN 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 36:14" />ಎಸಾವಾಚಿ ಬಾಯ್ಕೊ ಸಿಬೆಯೊನಾಚೊ ಲೆಕ್ ಅನಾಹಾಚಿ ಲೆಕ್ ಒಹೊಲಿಬಾಮಾ ಮನ್ತಲಿಕ್ ಯೆಗುಶ್, ಯೆಳಾಮ್ ಅನಿ ಕೊರಹ್ ಮನ್ತಲಿ ತಿನ್ ಪೊರಾ ಹೊತ್ತಿ,<verse eid="GEN 36:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />ಎಸಾವಾಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ಘರಾನಾಚಿ ವಾಡ್ ವಡ್ಲಾ; ಎಸಾವಾಚೊ ಥೊರ್ಲೊ ಲೆಕ್ ಎಲಿಫಜಾಕ್ನಾ ತೆಮಾನ್, ಒಮಾರ್, ಚೆಪೊ, ಕೆನೆಜ್ ಅನಿ<verse eid="GEN 36:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 36:16" />ಕೊರಹ್, ಗತಾಮ್, ಅಮಾಲೆಕ್ ಮನ್ತಲಿ ಘರಾನಾಚಿ ವಾಡ್ ವಡಿಲಾ ಉಪಜ್ಲಿ , ಹಿ ಅಧಿಪತಿ ಲೊಕಾ ಎದೊಮ್ಯಾಂಚ್ಯಾ ಗಾಂವಾತ್ ಆದಾಚ್ಯಾ ಪಿಳ್ಗಿತ್ ಉಪಜ್ಲಿ.<verse eid="GEN 36:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 36:17" />ಎಸಾವಾಚೊ ಲೆಕ್ ರೆಗುಯೆಲಾಕ್ ನಹತ್, ಜೆರಹ್, ಶಮ್ಮಾ, ಅನಿ ಮಿಜ್ಜಾ ಮನ್ತಲಿ ಘರಾನಾಚಿ ವಾಡ್ ವಡಿಲಾ ಉಪಜ್ಲಿ, ಹೆನಿ ಎದೊಮ್ಯಾಂಚ್ಯಾ ಗಾಂವಾತ್ ಎಸಾವಾಚಿ ಬಾಯ್ಕೊ ಬಾಸೆಮತ್ ಮನ್ತಲಿಚ್ಯಾ ಪಿಳ್ಗಿತ್ ಉಪಾಜ್ಲೆ.<verse eid="GEN 36:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 36:18" />ಎಸಾವಾಚಿ ಬಾಯ್ಕೊ ಒಹೊಲಿಬಾಮ್ ಮನ್ತಲಿಚ್ಯಾ ಪಿಳ್ಗಿತ್ ಉಪಾಜಲ್ಲೆ ಘರಾನಾಚಿ ಜಾಂಟಿ ಲೊಕಾ ಕೊನ್ ಮಟ್ಲ್ಯಾರ್, ಯೆಗುಶ್, ಯೆಳಾಮ್, ಅನಿ ಕೊರಹ್ ಹೆನಿಚ್ ಅನಾಹಾಚಿ ಲೆಕ್ ಎಸಾವಾಚಿ ಬಾಯ್ಕೊ ಹೊವ್ನ್ ಹೊತ್ತಿ ಒಹೊಲಿಬಾಮಾಚ್ಯಾ ಪಿಳ್ಗಿಚೆ. <verse eid="GEN 36:18" /><verse number="19" style="v" sid="GEN 36:19" />ಎದೊಮ್ಯಾಂಚೆ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಎಸಾವಾಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ಘರಾನೆಕ್ನಿ ವಾಡ್ ವಡಿಲಾ ಹೆನಿಚ್.<verse eid="GEN 36:19" /></para>
  <para style="s">ಸೆಯಿರಾಚಿ ಪಿಳ್ಗಿ</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />ತ್ಯಾ ಗಾಂವ್ಚಿ ವಾಡ್ ವಡಿಲಾ ಹೊರಿಯಾ ಮನ್ತಲ್ಯಾ ಸೆಯಿರಾಕ್ನಾ ಉಪಾಜಲ್ಲೆ, ಲೊಟಾನ್, ಸೊಬಾಲ್, ಸಿಬೆಯೊನ್ ಅನಿ ಅನಾಹ್, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />ದಿಶೊನ್, ಎಚೆರ್, ದಿಸಾನ್, ಎದೊಮ್ಯಾಂಚ್ಯಾ ಗಾಂವಾತ್ ಸೆಯಿರಾಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ಹೊರಿಯಾತ್ನಿ ಉಪಾಜಲ್ಲೆ ಫುಡಾರಿ ಹೆನಿಚ್.<verse eid="GEN 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 36:22" />ಲೊಟಾನಾಕ್ ಹೊರಿ ಅನಿ ಹೆಮಾಮ್ ಮನ್ತಲಿ ಪೊರಾ ಹೊತ್ತಿ ಅನಿ ತಿಮ್ನಾ ಮನ್ತಲಿ ಎಕ್ ಭೆನ್ ಬಿ ಹೊತ್ತಿ.<verse eid="GEN 36:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 36:23" />ಅಲ್ವಾನ್, ಮಾನಹತ್, ಗೆಬಾಲ್ ಅನಿ ಶೆಪೊ, ಒನಾಮ್ ಮನ್ತಲಿ ಸೊಬಾಲಾಚಿ ಪೊರಾ.<verse eid="GEN 36:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 36:24" />ಸಿಬೆಯೊನಾಕ್ ಅಯ್ಯಾ ಅನಿ ಅನಾಹ್ ಮನ್ತಲಿ ದೊನ್ ಲೆಕಾ ಹೊತ್ತಿ ಹ್ಯಾ ಅನಾಹ್ ಮನ್ತಲ್ಯಾನುಚ್ ಸಿಬಿಯೊನಾಚಿ ಬಾಬಾಚಿ ಶೆಳಿಯಾ ರಾಕ್ತಾನಾ ಡಂಗ್ಳಿತ್ ಹುನ್ನ್ ಪಾನಿಯಾಚಿ ಝರೊ ಹುಡ್ಕುನ್ ಕಾಡಲ್ಯಾನ್. <verse eid="GEN 36:24" /><verse number="25" style="v" sid="GEN 36:25" />ಅನಾಹಾಚಿ ಪೊರಾ ದಿಶೊನ್, ಅನಿ ಲೆಕ್ ಒಹೊಲಿಬಾಮಾ ಮನ್ತಲಿ. <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />ದಿಶೊನಾಚಿ ಪೊರಾ ಹೆಮ್ದಾನ್, ಎಶ್ಬಾನ್ ಅನಿ ಎತ್ರಾನ್, ಕೆರಾನ್.<verse eid="GEN 36:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 36:27" />ಎಚೆರ್ ಮನ್ತಲ್ಯಾಚಿ ಲೆಕಾ ಬಿಲ್ಹಾನ್, ಜಾವಾನ್, ಅನಿ ಅಕಾನ್.<verse eid="GEN 36:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 36:28" />ದಿಸಾನಾಚಿ ಲೆಕಾ ಉಚ್ ಅನಿ ಅರಾನ್,<verse eid="GEN 36:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 36:29" />ಹೆನಿ ಸಗ್ಳ್ಯಾನಿ ಹೊರಿಯಾಂಚ್ಯಾಕ್ನಾ ಉಪಾಜಲ್ಲೆ ಖಂದಾನಾಚೆ ಫುಡಾರಿ; ಲೊಟಾನ್, ಸೊಬಾಲ್, ಸಿಬೆಯೊನ್, ಅನಾಹ್, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />ದಿಶೊನ್, ಎಚೆರ್, ಅನಿ ದಿಸಾನ್ ಹೊರಿಯಾಂಚ್ಯಾಕ್ನಾ ಉಪಾಜುನ್ ಸೆಯಿರ್ ಮನ್ತಲ್ಯಾ ಗಾಂವಾತ್ ರಾಜ್ವಾಡ್ಕಿ ಚಾಲ್ವಲ್ಲೆ ವಾಡ್ ವಡಿಲಾ ಹೆನಿಚ್.<verse eid="GEN 36:30" /></para>
  <para style="s">ಎದೊಮಾಚೆ ರಾಜಾ</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ರಾಜ್ಯಾನಿ ರಾಜ್ವಡ್ಕಿ ಕರುಚ್ಯಾ ಪೈಲೆ ಎದೊಮ್ಯಾಂಚ್ಯಾ ಗಾಂವಾತ್ ರಾಜ್ವಡ್ಕಿ ಕರಲ್ಯಾ ರಾಜ್ಯಾಂಚಿ ನಾಂವಾ ಅಸಿ ಹಾತ್;<verse eid="GEN 36:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="GEN 36:32" />ಬೆಯೊರಾಚೊ ಲೆಕ್ ಬಗಲಾನ್ ದಿನ್ಹಾಬ್ ಮನ್ತಲ್ಯಾ ರಾಜಧಾನಿತ್ ಎದೊಮ್ಯಾತ್ನಿ ರಾಜ್ವಡ್ಕಿ ಕರ್ಲ್ಯಾನ್,<verse eid="GEN 36:32" /></para>
  <para style="q2">
    <verse number="33" style="v" sid="GEN 36:33" />ಬೆಗಲಾಚೆ ಮರಾನ್ ಹೊಲ್ಯಾ ಮಾನಾ ಚೊದ್ರಾಚ್ಯಾ ಜೆರಹ್ ಮನ್ತಲ್ಯಾಚೊ ಲೆಕ್ ಜೊಬಾಬ್ ಮನ್ತಲೊ ರಾಜ್ವಡ್ಕಿ ಚಾಲ್ವುಕ್ ಯೆಲೊ,<verse eid="GEN 36:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="GEN 36:34" />ಜೊಬಾಬ್ ಮನ್ತಲ್ಯಾಚೆ ಮರಾನ್ ಹೊಲ್ಯಾ ಮಾನಾ ತೆಮಾನೊಯಾಂಚ್ಯಾ ದೆಶಾಚೊ ಹುಶಾಮ್ ಮನ್ತಲ್ಯಾನ್ ತೆಚ್ಯಾ ಬದ್ಲಾಕ್ ರಾಜ್ವಡ್ಕಿ ಚಾಲ್ವುಲ್ಯಾನ್.<verse eid="GEN 36:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="GEN 36:35" />ಹ್ಯೊ ಹುಶಾಮ್ ಮರ್ಲ್ಯಾ ಮಾನಾ ಮೊವಾಬ್ಯಾಂಚ್ಯಾ ಗಾಂವಾತ್ ಮಿದಾನ್ಯಾಕ್ನಿ ಹರ್ವಲ್ಲ್ಯಾ ಬದದ್ ಮನ್ತಲ್ಯಾಚೊ ಲೆಕ್ ಹದದ್ ರಾಜಾ ಹೊಲೊ, ತೆಚ್ಯಾ ಶಹಾರಾಚೆ ನಾವ್ ಆವಿತ್.<verse eid="GEN 36:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="GEN 36:36" />ಹದದ್ ಮರ್ಲ್ಯಾ ಮಾನಾ ಮೆಸ್ರಕ್ ಮನ್ತಲ್ಯಾ ಗಾಂವ್ಚೊ ಸಮ್ಲಾ ಮನ್ತಲೊ ರಾಜ್ವಡ್ಕಿಕ್ ಯೆಲೊ.<verse eid="GEN 36:36" /></para>
  <para style="q2">
    <verse number="37" style="v" sid="GEN 36:37" />ಸಮ್ಲಾ ಮರ್ಲ್ಯಾ ಮಾನಾ ನ್ಹೈಚ್ಯಾ ದಂಡೆ ವೈಲ್ಯಾ ರೆಹಬೊತ್ ಶರಾಚೊ ಸಾವುಲ್ ರಾಜಾ ಹೊಲೊ,<verse eid="GEN 36:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="GEN 36:38" />ಸಾವುಲ್ ಮರ್ಲ್ಯಾ ಮಾನಾ ಅಕ್ಬೊರಾಚೊ ಲೆಕ್ ಬಾಲ್ ಹಾನಾನ್ ಮನ್ತಲೊ ರಾಜಾ ಹೊಲೊ, <verse eid="GEN 36:38" /><verse number="39" style="v" sid="GEN 36:39" />ಅಕ್ಬೊರಾಚೊ ಲೆಕ್ ಬಾಲ್ ಹಾನಾನ್ ಮರ್ಲ್ಯಾ ಮಾನಾ ಹದದ್ ರಾಜಾ ಹೊಲೊ, ತೆಚ್ಯಾ ಶಾಹರಾಚೆ ನಾವ್ ಪಾವು, ಅನಿ ತೆಚ್ಯಾ ಬಾಯ್ಕೊಚೆ ನಾವ್ ಮಹೆಟಾಬೆಲ್, ತಿ ಮೆಹಟಾಬೆಲಾಚಿ ಲೆಕ್ ಮಟ್ರಿದಾ ಮನ್ತಲಿಚಿ ಲೆಕ್.<verse eid="GEN 36:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />ಜಾಗೊ, ಪಿಳ್ಗಿ ಅನಿ ನಾಂವಾಂಚ್ಯಾ ಪರ್ಕಾರ್ ಎಸಾವಾಕ್ನಾ ಉಪಾಜ್ಲ್ಯಾ ವಾಡ್ ವಡಿಲಾಂಚೆ ನಾಂವಾ ಹಿಚ್; ತಿಮ್ನ್, ಅಲ್ವಾ, ಯೆತೆತ್, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />ಒಹೊಲಿಬಾಮಾ, ಎಲಾ ಅನಿ ಪಿನೊನ್, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />ಕೆನೆಜ್, ತೆಮಾನ್, ಮಿಬ್ಚಾರ್, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />ಮಗ್ದಿಯೆಲ್, ಅನಿ ಇರಾಮ್ ಅಪ್ಲ್ಯಾ ಗಾಂವ್ಚ್ಯಾ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾ ಜಾಗ್ಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಯೆದೊಮ್ಯಾಂಚೆ ಪಿಳ್ಗಿಚೆ ಹೆನಿಚ್, ಹ್ಯಾ ಎದೊಮ್ಯಾಂಚೊ ವಾಡ್ ವಡಿಲ್, ಎಸಾವ್ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">ಜೊಸೆಪ್ ಅನಿ ತೆಚಿ ಭಾವಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />ಜಾಕೊಬ್ ಅಪ್ಲೊ ಬಾಬಾ ಹೊತ್ತ್ಯಾ ಕಾನಾನ್ ದೆಶಾತುಚ್ ಹೊತ್ತೊ. <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />ಹಿ ಜಾಕೊಬಾಚ್ಯಾ ಪಿಳ್ಗಿಚಿ ಚರಿತ್ರಾ: ಜುಜೆಕ್ ಸತ್ರಾ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ತೆಚಿ ಭಾವಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಬಕ್ರಿ ರಾಕುಕ್ ಜಾಯ್,</para>
  <para style="p" vid="GEN 37:2">ಅನಿ ಜುಜೆಚೆ ಕಾಮ್ ಬಕ್ರಿ ರಾಕ್ತಲೆ ಹೊಲ್ಲೆ, ತೊ ಅಪ್ಲಿ ಭಾವಾ ಬಿಲ್ಹಾ ಅನಿ ಜಿಲ್ಪಾಚ್ಯಾ ಲೆಕಾನಿ ಕಾಯ್ಬಿ ಬುರ್ಸೆ ಕರ್ಲ್ಯಾರ್ ಅಪ್ಲ್ಯಾ ಬಾಬಾಕ್ ಯೆವ್ನ್ ಸಾಂಗಿ.<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />ಇಜ್ರಾಯೆಲ್ ಲೈ ಮಾತಾರೊ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಜುಜೆ ಉಪಾಜಲ್ಲೊ ರ್‍ಹಾತಾ, ತಸೆ ಹೊವ್ನ್ ತೆಕಾ ತೊ ಸಗ್ಳ್ಯಾ ಲೆಕಾಂಚ್ಯಾಕಿಂತಾಬಿ ಲೈ ಪ್ರೆಮ್ ಕರುನ್ ತೆಕಾ ಎಕ್ ಝಗೊ ಸಿವ್ನ್ ದಿಲ್ಲ್ಯಾನ್.<verse eid="GEN 37:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 37:4" />ಜುಜೆಕ್ ತೆಜೊ ಬಾಬಾ ಲೈ ಪ್ರೆಮ್ ಕರ್‍ತಲ್ಯಾ ವೈನಾ ತೆಚಿ ಭಾವಾ ಜುಜೆಚ್ ಬಗಟ್ಲ್ಯಾ ಸೆರ್ಯಿನಸಿತ್ ಅನಿ ಬರೆ ಕರುನ್ ಬೊಲಿನಸಿತ್.<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />ತಸೆ ರ್‍ಹಾತಾನಾ ಜುಜೆಕ್ ಎಕ್ ವಿಶೆಸ್ ಸಫಾನ್ ಪಡ್ತಾ, ತನ್ನಾ ತೊ ಜಾವ್ನ್ ತ್ಯಾ ಸಫ್ನಾಚ್ಯಾ ವಿಶಯಾತ್ ತೆಚ್ಯಾ ಭಾವಾಚ್ಯಾಂಕ್ಡೆ ಜಾವ್ನ್ ಸಾಂಗ್ತಾ, ತನ್ನಾ ತೆಂಕಾ ತೆಚ್ಯಾ ವರ್‍ತಿ ಲೈ ರಾಗ್ ಯೆತಾ. <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />ತನ್ನಾ ಜುಜೆನ್ ತೆಂಕಾ, ಮಾಕಾ ಪಡಲ್ಲೆ ಸಫಾನ್ ಸಾಂಗ್ತಾ ಆಯ್ಕಾ. <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />ಅನಿ ಅಮಿ ಸಗ್ಳ್ಯಾ ನಿ ಸೆತಾತ್ ಘಂವಾಚಿ ಭಾರೆ ಭಾಂದ್ತಾನಾ, ಮಾಜೊ ಭಾರೊ ಉಟುನ್ ಇಬೆ ರ್‍ಹಾತಾ; ಮಾಜ್ಯಾ ಭಾರಾಚ್ಯಾ ಭೊತ್ಯಾನಿ ತುಮ್ಚಿ ಭಾರೆ ಸಗ್ಳಿ ಇಬೆ ರ್‍ಹಾವ್ನ್ ಮಾನ್ ಬಾಗ್ವುಲ್ಯಾನಿ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />ತನ್ನಾ ತೆಚ್ಯಾ ಭಾವಾನಿ ತೆಕಾ, “ತೆಚೆ ಯೆವ್ಜನ್ ಅಮ್ಚ್ಯಾ ವರ್‍ತಿ ತಿಯಾ ರಾಜಾ ಹೊವ್ನ್ ಅಮ್ಚ್ಯಾ ವರ್‍ತಿ ರಾಜ್ವಟ್ಕಿ ಕರ್ತೈ?” ಮನುನ್ ತ್ಯಾ ಸಪ್ನಾಚ್ಯಾ ವೈನಾ ಅನಿಬಿ ತೆಕಾ ಲೈಚ್ ಸೆರ್ಯಿಸಿತ್.<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />ಮಾನಾ ಅನಿಬಿ ಜುಜೆಕ್ ಸಫಾನ್ ಪಡ್ತಾ, ತನ್ನಾ ತೆಚ್ಯಾ ಭಾವಾಕ್ನಿ ಜಾವ್ನ್ ಸಾಂಗ್ತಾ, ಮಾಕಾ ಅನಿಬಿ ಎಕ್ ಸಫಾನ್ ಪಡ್ಲಾ, ದಿಸ್, ಚಂದಾಮಾ ಅನಿ ಅಕ್ರಾ ಚುಕ್ಕಿಯಾ ಮಾಕಾ ಮಾನ್ ಬಾಗ್ವುತ್ತಲೆ ಮಿಯಾ ಬಗಟ್ಲೊ, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />ಅನಿ ಅಪ್ನಾಚ್ಯಾ ಬಾಬಾಕ್ಡೆಬಿ ಜಾವ್ನ್ ಸಾಂಗ್ತಾ, ಖರೆ ತೊ “ಹೆ ಕಸ್ಲೆ ಸಫಾನ್? ಮನುನ್ ತೆಕಾ ಗಾಳಿ ದಿವ್ನ್, ತೆಕಾ ಮಿಯಾ ತುಜಿ ಬಾಯ್ ಅನಿ ತುಜಿ ಭಾವಾ ತುಕಾ ಮಾನ್ ಬಾಗ್ವುತ್ತಲೆ ಮನುನ್ ಯವಜ್ತಲೆ ಕಾಯ್?” ಮನುನ್ ಜುಜೆಕ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 37:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 37:11" />ಮಾನಾ ಜುಜೆಚೊ ಬಾಬಾ ತ್ಯಾ ಸಫ್ನಾಚ್ಯಾ ವಿಶಯಾತ್ ಅಜಾಪ್ ಹೊವ್ನ್ ಯೆವ್ಜುಕ್ ಲಾಲೊ, ಮಾನಾ ಜುಜೆಚಿ ಭಾವಾ ತೆಕಾ ಲೈಚ್ ಕುಸ್ಡೆಪಾನ್ ಕರಿತ್.<verse eid="GEN 37:11" /></para>
  <para style="s">ಜುಜೆಕ್ ಇಕಲ್ಲೆ ಅನಿ ಇಜಿಪ್ತಾಕ್ ನ್ಹೆಲ್ಲೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />ಜುಜೆಚಿ ಭಾವಾ ಎಕ್ ದಿಸಾ ತೆಂಚ್ಯಾ ಬಾಬಾಚಿ ಬಕ್ರಿ ರಾಕುಕ್ ಶೆಕೆಮಾಕ್ ಗೆಲ್ಯಾನಿ.<verse eid="GEN 37:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 37:13" />ಮಾನಾ ಇಜ್ರಾಯೆಲಾನ್ ಜುಜೆಕ್, “ತಿಯಾ ಶೆಕೆಮಾಕ್ ಜಾ, ಥೈ ತುಜಿ ಭಾವಾ ಮಾಜಿ ಬಕ್ರಾಂಚೊ ತಾಂಡೊ ಚಾರ್ವುಕ್ ” ಗೆಲಾತ್, ಮಟ್ಲ್ಯಾನ್ ತನ್ನಾ ಜುಜೆನ್, “ಹಾ ಮಿಯಾ ಜಾತಾ” ಮನುನ್ ಜವಾಬ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />ಅನಿ ಇಜ್ರಾಯೆಲಾನ್ ತೆಕಾ ಹೆಬ್ರೊನಾಚ್ಯಾ ಕೊಳ್ಳಾಚ್ಯಾ ವಾಟೆಕ್ ಶೆಕೆಮಾಕ್ ಜಾ ಅನಿ ತುಜಿ ಭಾವಾ ಬರೆ ಹಾತ್ಕಿ ನಾ ಮನುನ್ ಅನಿ ಬಕ್ರಿಯಾಕ್ನಿ ಬಗುನ್ ಯೆವ್ನ್ ಮಾಕಾ ಕಳ್ವು ಮನುನ್ ಧಾಡುನ್ ದಿಲ್ಯಾನ್, ಮಾನಾ ಜಾಕೊಬ್ ಶೆಕೆಮಾಕ್ ಯೆವ್ನ್ ಪಾವ್ಲೊ. <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />ಜುಜೆ ಶೆಕೆಮಾಚ್ಯಾ ಸೆತಾತ್ನಿ ಫಿರುನ್ ಖೆಳ್ತಲೆ ಬಗುನ್ ಎಕ್ಲ್ಯಾನ್, “ಹಿತ್ತೆ ಕಾಯ್ ಹುಡ್ಕುಲೈ?” ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />ತನ್ನಾ ಜುಜೆನ್ ತೆಕಾ, “ಮಾಜಿ ಭಾವಾ ಆಮ್ಚಿ ಬಕ್ರಿಯಾಂಚೊ ಹಿಂಡ್ ಖೈ ಚಾರ್ವುಲ್ಲಾತ್? ಮಿಯಾ ತೆಂಕಾ ಹುಡ್ಕುಲ್ಲಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />ತೆನಿ ತೆಕಾ, “ಹಿತ್ತೆತ್ನಾ ತೆನಿ ಗೆಲೆ, ಅನಿ ತೆನಿ ಅಮಿ ದೊತಾನಾಕ್ ಜಾಂವಾ ಮನುನ್ ಬೊಲುಲಾಗಲ್ಲೆ ಮಿಯಾ ಆಯ್ಕಲ್ಲೊ” ಮಟ್ಲ್ಯಾನ್, ಮಾನಾ ಜುಜೆನ್ ದೊತಾನಾಕ್ ಹುಡ್ಕುನ್ಗೆತ್ ಜಾವ್ನ್ ಪಾವುನ್ ಥೈ ತೆಂಕಾ ಭೆಟ್ಲೊ.<verse eid="GEN 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 37:18" />ಮಾನಾ ತೆಚ್ಯಾ ಭಾವಾನಿ ತೆಕಾ ಧುರ್ನಾಚ್ ಬಗುನ್ ತೆನಿ ತೆಚ್ಯಾ ವಿರೊಧ್ ತೆಜೊ ಜಿವ್ ಕಾಡುಚೆ ಮನುನ್ ಚಿಂತಲ್ಯಾನಿ. <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />ಅನಿ “ಅಬಕಾ” ಸಫಾನ್ ಬಗ್ತಲೊ ಯೆವ್ಲಾ ಮನುನ್ ಎಕಾ ಮೆಕಾಕ್ ಬೊಲುನ್ ಘೆಟ್ಲ್ಯಾನಿ. <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />ಯೆವಾ, ತೆಕಾ ಜಿವ್ ಕಾಡುನ್ ಪಾನಿ ನಸಲ್ಲ್ಯಾ ಭಾಂಯ್ತ್ ಟಾಕುಂವಾ, ಅನಿ ಕ್ರುರ್ ಜನಾವರಾನ್ ಯೆವ್ನ್ ತೆಕಾ ಖಾಲ್ಯಾನ್ ಕಾಯ್ಕಿ ಮನುನ್ ಸಾಂಗುವಾ, ತನ್ನಾ ತೆಚಿ ಸಪ್ನಾ ಕಾಯ್ ಹೊತಾತ್ ಬಗುಂವಾ ಮನುನ್ ಬೊಲುನ್ ಘೆಟ್ಲ್ಯಾನಿ.<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />ಖರೆ ರುಬೆನಾನ್ ತೆನಿ ಸಾಂಗಲ್ಲೆ ಆಯ್ಕುನ್ ತೆಂಕಾ, ಅಮಿ “ತೆಜೊ ಜಿವ್ ಕಾಡ್ತಲೆ ನಕ್ಕೊ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />“ತೆಕಾ ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಪಾನಿ ನಸಲ್ಲ್ಯಾ ಭಾಂಯಿತ್ ಡಕ್ಲುನ್ ಘಾಲಾ ಖರೆ ತೆಕಾ ಕಾಯ್ಬಿ ದುಕ್ಕ್ ಕರುನಕಾಸಿ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್, ರುಬೆನಾಚೆ ಮನ್ ಮಾನಾ ತೆಕಾ ಬಾಬಾಕ್ಡೆ ನೆವ್ನ್ ಸೊಡುಚೆ ಮನುನ್ ಹೊತ್ತೆ. <verse eid="GEN 37:22" /><verse number="23" style="v" sid="GEN 37:23" />ಖರೆ ಜುಜೆ ಯೆಲ್ಲ್ಯಾ ಮಾನಾ ತೆಚ್ಯಾ ಭಾವಾನಿ ತೆಕಾ ಧರುನ್ ತೆಚೊ ಝಗೊ ಕಾಡುನ್ ಘೆಟ್ಲ್ಯಾನಿ, <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />ಪಾನಿ ನಸಲ್ಲ್ಯಾ ಭಾಂಯಿತ್ ಉಕ್ಲುನ್ ಟಾಕ್ಲ್ಯಾನಿ.<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />ಮಾನಾ ತೆನಿ ಜೆವಾನ್ ಕರುಕ್ ಮನುನ್ ಬಸಲ್ಲ್ಯಾ ತನ್ನಾ ಜುಜೆ ಭಾಂಯಿತ್ ರ್‍ಹಾತಾ, ತೆನಿ ಡೊಳೆ ವರ್‍ತಿ ಕರುನ್ ಬಗ್ತಾನಾ, ಗಿಲ್ಯಾದಿಕ್ನಾ ಇಜಿಪ್ತಾಕ್ ಯಾಪಾರ್ ಕರುಕ್ ಮನುನ್ ಜಾವ್ಕ್ ಲಾಗಲ್ಯಾ ಇಸ್ಮಾಯೆಲಾಕ್ನಿ ಬಗ್ಲ್ಯಾನಿ, ಅನಿ ತೆಂಚ್ಯಾ ಒಂಟಿಯಾ ವೈನಿ ಬರ್‍ಯಾ ವಾಸೆಚೆ ತೆಲ್, ರಗತ್ಬೊಳ್, ಮಸಾಲ್ಯಾಚಿ ಸಾಮಾನಾ ಅನಿ ಕಿಮ್ತಿಚಿ ವಸ್ತಾ ನೆವ್ಕ್ಲಾಗಲ್ಲೆ. <verse eid="GEN 37:25" /><verse number="26" style="v" sid="GEN 37:26" />ತನ್ನಾ ಜೆಹುದಾನ್ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ನಿ, ಅಮಿ ಅಮ್ಚ್ಯಾ ಭಾವಾಕ್ ಜಿವಾನಿ ಮಾರ್‍ಲ್ಯಾರ್ ಅನಿ ತೆಚೆ ಮರಾನ್ ನಿಪ್ವುಲ್ಯಾರ್ ಅಮ್ಕಾ ಕಾಯ್ ಫಾಯ್ದೊ ಗಾವ್ತಾ? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />ತೆಕಾ ಅಮಿ ಹ್ಯಾ ಇಸ್ಮಾಯೆಲಾಕ್ನಿ ಇಕುಂವಾ ಹೆಜ್ಯಾ ವೈನಾ ಅಮ್ಕಾ ಫಾಯ್ದೊ ಹಾಯ್ ಅನಿ ಅಮ್ಚ್ಯಾ ಭಾವಾಕ್ ಜಿವ್ ಕಾಡಲ್ಲೊ ಪಾಪ್ ಅಮ್ಚ್ಯಾ ವರ್‍ತಿ ರ್‍ಹಾಯ್ನಾ, ಮನುನ್ ಸಾಂಗ್ತಾನಾ ಸಗ್ಳ್ಯಾ ಭಾವಾನಿ ಒಪ್ಲ್ಯಾನಿ. <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />ಅನಿ ಮಿದ್ಯಾನಾಕ್ನಾ ಇಕುಕ್ ಜಾತಲೆ ಜಗ್ಗೊಳ್ ಯೆತಲೆ ಬಗುನ್, ತೆನಿ ಜುಜೆಕ್ ಭಾಂಯಿತ್ನಾ ವೈರ್ ಉಕ್ಲುನ್ ತೆಂಚ್ಯಾಕ್ನಾ ಇಸ್ ಚಾಂದಿಚೆ ಪೈಸೆ ಘೆವ್ನ್ ತೆಂಕಾ ಇಕ್ಲ್ಯಾನಿ, ಮಾನಾ ತ್ಯಾ ಯಾಪಾರಿಯಾನಿ ಜುಜೆಕ್ ಇಜಿಪ್ತಾಕ್ ದೆಸಾಕ್ ನ್ಹೆಲ್ಯಾನಿ.<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />ರುಬೆನ್ ತೆಂಚ್ಯಾ ಭಾವಾನಿ ಜುಜೆಕ್ ಇಕ್ತಲ್ಯಾ ಎಳಾರ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ನತ್ತೊ, ಮಾನಾ ತೊ ಪರ್‍ತುನ್ ಜಾವ್ನ್ ಭಾಂಯಿಕ್ಡೆ ಬಗ್ತಾ ಅನಿ ಜುಜೆ ಥೈ ನತ್ತೆ ಬಗುನ್ ಅಪ್ನಾಚೆ ಕಪ್ಡೆ ಪಿಂಜುನ್ ಘೆವ್ನ್ ರಡುಲಾಲೊ. <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />ತನ್ನಾ ಅಪ್ಲ್ಯಾ ಭಾವಾಂಚ್ಯಾಕ್ಡೆ ಜಾವ್ನ್, “ತೊ ಝಿಲ್ಗೊ ಥೈ ನಾ ಅತ್ತಾ ಮಿಯಾ ಕಾಯ್ ಕರು ಮನುನ್?” ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />ಅನಿ ತೆನಿ ಎಕ್ ಬಕ್ರ್ಯಾಕ್ ಕಾತ್ರುನ್ ತ್ಯಾ ರಗ್ತಾತ್ ಜುಜೆಚೊ ಝಗೊ ಬುಡ್ವುನ್ ಕಾಡ್ಲ್ಯಾನಿ. <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />ಮಾನಾ ತೊ ಝಗೊ ತೆನಿ ನೆವ್ನ್ ಅಪ್ಲ್ಯಾ ಬಾಬಾಕ್ ದಾಕ್ವುನ್, ಅಮಿ ಬಗಟಲ್ಲೊ ಹ್ಯೊ ಝಗೊ ಜುಜೆಚೆ ಕಾಯ್? ಮನುನ್ ಇಚ್ಯಾರ್ಲ್ಯಾನಿ.<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />ತನ್ನಾ ಬಾಬಾನ್ ತೊ ಝಗೊ ಬಗುನ್ ಒಳ್ಕುನ್ ಹೊಯ್, ಜುಜೆಚೊಚ್ ಝಗೊ ತೊ ಖಚ್ಚ್ಯಾ ಕ್ರುರ್ ಜನಾವರಾಚ್ಯಾ ತೊಂಡಾತ್ ಗಾವ್ಲೊ ಮಾಜೊ ಲೆಕ್ ಜುಜೆಕ್ ತುಕ್ಡೆ ತುಕ್ಡೆ ಕರುನ್ ಘಾಟ್ಲಾ ಕಾಯ್ಕಿ ಮನುನ್, <verse eid="GEN 37:33" /><verse number="34" style="v" sid="GEN 37:34" />ಲೈ ದುಕ್ಕಾನ್ ಕಪ್ಡೆ ಪಿಂಜುನ್ ಘೆವ್ನ್ ಚಿಲಾಚೆ ಫಟೆ ಭಾಂದುನ್ ಘೆವ್ನ್ ತೆಜಾ ಲೆಕಾಚ್ಯಾ ಸಾಟ್ನಿ ಲೈ ದಿಸಾ ಪತರ್ಬಿ ರಡ್ಲ್ಯಾನ್. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />ಮಾನಾ ಜಾಕೊಬಾಕ್ ತೆಚ್ಯಾ ಲೆಕಾನಿ ಅನಿ ಲೆಕಿಯಾನಿ ಸಮಾಧಾನ್ ಕರುಕ್ ಬಗ್ಲ್ಯಾನಿ ಖರೆ ಜಾಕೊಬಾಕ್ ಸಮಾಧಾನ್ ಹೊವ್ಕ್ ನಾ ಅನಿ, “ಮಿಯಾ ಮರಿ ಪತರ್ಬಿ ಮಾಜ್ಯಾ ಲೆಕಾಚ್ಯಾ ಸಾಟ್ನಿ ದುಕ್ಕಾತ್ ರ್‍ಹಾತಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />ಮಾನಾ ತ್ಯಾ ಮಿದ್ಯಾನ್ಯಾನಿ ಜುಜೆಕ್ ಇಜಿಪ್ತಾತ್ ಹೊತ್ತ್ಯಾ ಫರೊನ್ ರಾಜಾಕ್ ರಾಕ್ತಲೊ ಅಧಿಪತಿ ಪೊಟಿಫರ್ ಮನ್ತಲ್ಯಾಕ್ ಇಕ್ಲ್ಯಾನಿ.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">ತಾಮಾರಾ ಅನಿ ಜುದ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />ತ್ಯಾ ಎಳಾರ್ ಜೆಹುದ್ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ನಿ ಸೊಡುನ್ ಅದುಲ್ಲಾಮ್ ಮನ್ತಲ್ಯಾ ಗಾಂವಾತ್ ಹೊತ್ತ್ಯಾ ಹಿರಾಚ್ಯಾ ಘರ್‍ಹಾತ್ ವಸ್ತಿ ಹೊತ್ತೊ. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />ಜೆಹುದ್ ಕಾನಾನ್ ದೆಶ್ಯಾಚ್ಯಾ ಶುಗಾಚ್ಯಾ ಲೆಕಿಕ್ ಭೆಟುನ್ ತಿಕಾ ಲಗಿನ್ ಹೊವ್ನ್ ತಿಚೆಕ್ಡೆ ಗೆಲೊ. <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />ಅನಿ ತಿನಿ ಎಕ್ ಲೆಕಾಕ್ ಜಲಮ್ ದಿಲಿನ್ ಜುದಾನ್ ತೆಕಾ ಎರ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />ಮಾನಾ ತಿ ಅನಿ ಬಿ ಪೊಟಾನ್ ರ್‍ಹಾವ್ನ್ ಎಕ್ ಲೆಕಾಕ್ ಜಲಮ್ ದಿವ್ನ್ ತೆಕಾ ಒನಾನ್ ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />ಅನಿಬಿ ತಿಕಾ ಎಕ್ ಲೆಕ್ ಉಪಾಜ್ತಾ, ತೆಚೆ ನಾವ್ ಶೆಲಾ, ತೊ ಲೆಕ್ ಜಲಮ್ತಲ್ಯಾ ಎಳಾರ್ ಜುದಾ ಕೆಜಿಬಾತ್ ವಸ್ತಿ ಹೊತ್ತೊ.<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />ಮಾನಾ ಜೆಹುದಾನ್ ಅಪ್ಲೊ ಥೊರ್ಲೊ ಲೆಕ್ ಎರಾನಾಕ್ ತಾಮರ್ ಮನ್ತಲ್ಯಾ ನಾಂವಾಚೆ ಚೆಡು ಹಾನುನ್ ಬಾಯ್ಕೊ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />ಖರೆ ಜೆಹುದಾಚೊ ಥೊರ್ಲೊ ಲೆಕ್ ಎರಾಚಿ ಚಾಲ್ ಬರಿ ನತ್ತಿ, ಅನಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತೊ ಕರ್‍ತಲ್ಯಾ ಬುರ್ಶಾ ಕಾಮಾಂಚ್ಯಾ ವೈನಾ ತೆಕಾ ಜಿವಾನಿ ಮಾರ್‍ಲ್ಯಾನ್.<verse eid="GEN 38:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8" />ಮಾನಾ ಜುದಾನಾನ್ ಎರಾಚೊ ಭಾವ್ ಒನಾನಾಕ್: “ತಿಯಾ ತುಜ್ಯಾ ಭಾವಾಚ್ಯಾ ಘವ್ಮರಲ್ಯಾ ಬಾಯ್ಕೊ ವಾಂಗ್ಡಾ ಮಿಳ್, ಅನಿ ತುಜ್ಯಾ ಭಾವಾಚಿ ಪಿಳ್ಗಿ ವಾಡುಕ್ ಕಾರನ್ ಹೊ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />ಖರೆ ಒನಾನ್ ಭಾವಾಚ್ಯಾ ಬಾಯ್ಕೊ ವಾಂಗ್ಡಾ ಮಿಳ್ತಾನಾ, ತಿ ಪಿಳ್ಗಿ ಅಪ್ಲಿ ಹೊಯ್ನಾ ಮನುನ್ ಕಳುನ್ ಮಾಜ್ಯಾ ಭಾವಾಚಿ ಪಿಳ್ಗಿ ಹೊತಲಿ ನಕ್ಕೊ ಮನುನ್ ಹಾತ್ರಾನ್ ರಾಡ್ ಕರ್ಲ್ಯಾನ್.<verse eid="GEN 38:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 38:10" />ತೆಚ್ಯಾ ವೈನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ ತೆಚಿ ಚಾಲ್ ಬರಿ ದಿಸುಕ್ನಾ ಅನಿ ತೆಕಾಬಿ ಜಿವಾನಿ ಮಾರ್‍ಲ್ಯಾನ್. <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />ತಸೆ ರ್‍ಹಾತಾನಾ ಜುದಾನ್ ಎಕ್ ಎಳಾ ಮಾಜೊ ಲೆಕ್ ಶೆಲಾಕ್ ಮಿಯಾ ಸುನ್ನೆ ವಾಂಗ್ಡಾ ಧಾಡ್ಲ್ಯಾರ್ ತೊಬಿ ಭಾವಾಂಚ್ಯಾ ಗತಿನ್ ಮರುನ್ ಜಾಯ್ಲ್ ಮನುನ್ ಚಿಂತುನ್, ಅಪ್ಲ್ಯಾ ಸುನ್ನ್ ತಾಮಾರಾಕ್ ಮಾಜೊ ಲೆಕ್ ಶೆಲಾ ಅಜುನ್ ಬಾರಿಕ್ ಹಾಯ್ ತೊ ಮೊಟೊ ಹೊಯ್ ಪತರ್ ತಿಯಾ ತುಜ್ಯಾ ಮ್ಹಾಯೆರಾಕ್ ಜಾವ್ನ್ ರಾ, ಮಟ್ಲ್ಯಾನ್ ಅನಿ ತಾಮಾರಾ ಗೆಲಿ.<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />ಉಲ್ಲಿ ದಿಸಾ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಜುದಾಸಾಚಿ ಬಾಯ್ಕೊ ಶುಗಾಚಿ ಲೆಕ್ ಮರುನ್ ಗೆಲಿ, ದುಕ್ಕೆಚೊ ಎಳ್ ಕಳದಲ್ಲ್ಯಾ ಮಾನಾ ಅದುಲ್ಲಾಮ್ ಶಹರಾಚ್ಯಾ ಹಿರಾ ವಾಂಗ್ಡಾ ತಿಮ್ನಾತ್ ಬಕ್ರಿಯಾಂಚಿ ಕೆಸಾ ಕಾತ್ರುಕ್ ಗೆಲೊ. <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />ತಾಮಾರಾಕ್ ಅಪ್ಲೊ ಮಾಮಾ ಬಕ್ರಿಯಾಂಚಿ ಕೆಸಾ ಕಾತ್ರುಕ್ ತಿಮ್ನಾ ಗಾಂವಾಕ್ ಗೆಲಾ ಮನ್ತಲಿ ಖಬರ್ ಕಳ್ತಾ. <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />ಅನಿ ತಿಕಾ ಜುದಾಚೊ ಲೆಕ್ ಶೆಲಾ ದಾಂಡ್ಗೊ ಹೊಲ್ಯಾರ್ಬಿ ಅಪ್ನಾಕ್ ಲಗಿನ್ ಕರುನ್ ದಿವ್ಕ್ನಾ, ಮನುನ್ ತಿ ಅಪ್ಲಿ ವಿದವಾಚೆ ಕಪ್ಡೆ ಬದ್ಲುನ್ ದುಸ್ರೆ ಕಪ್ಡೆ ನೆಸುನ್ ಘೆವ್ನ್, ಪದ್ರಾನಿ ಟಕ್ಲೆ ತೊಂಡ್ ಧಾಪುನ್ಗೆವ್ನ್ , ತಿಮ್ನಾ ಗಾಂವಾಚ್ಯಾ ವಾಟೆ ಕ್ ಹೊತ್ತ್ಯಾ ಎನೆಮ್ ದಡ್ಪ್ಯಾಕ್ಡೆ ಬಸಲ್ಲಿ ರ್‍ಹಾತಾ.<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />ಮಾನಾ ಜುದಾಸ್ ತಿಕಾ ಬಗ್ತಾನಾ ತೊಂಡಾರ್ ಪದರ್ ಧಾಪಲ್ಲೆ ಬಗುನ್ ತಿ ಸುಳಿ ಮನುನ್ ಚಿಂತುನ್, <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />ತಿ ತೆಚಿ ಸುನ್ನ್ ಮನುನ್ ಕಳಿನಸ್ತಾನಾ ತೊ ವಾಟೆರ್ ತಿಕಾ ಮಿಯಾ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ನಿಜ್ತಾ , ಖರೆ ತಿಯಾ ಮಾಕಾ ಕಾಯ್ ದಿತೈ?<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />ತನ್ನಾ ಜುದಾಸಾನ್, “ಮಾಜ್ಯಾ ತಾಂಡ್ಯಾತ್ಲೆ ಎಕ್ ಬಕ್ರ್ಯಾಚೊ ಪೆಟೊ ಧಾಡುನ್ ದಿತಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್, ಮಾನಾ ತಿನಿ,“ ಹೊಲೆ ಅನಿ ತಿಯಾ ಬಕ್ರ್ಯಾಚೊ ಪೆಟೊ ಹಾನುನ್ ದಿಯ್ ಪತರ್ ಮಾಜಾಕ್ಡೆ ಕಾಯ್ಬಿ ಆಡು ಥವ್ತೆಯ್?” ಮಟ್ಲಿನ್.<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />ತನ್ನಾ ತೆನಿ ತಿಕಾ, “ಮಿಯಾ ಕಾಯ್ ಆಡು ಥವ್ಚೆ?” ಮಟ್ಲ್ಯಾನ್, ತನ್ನಾ ತಿನಿ ತುಜೊ ಛಪ್ಪ್ಯಾಚಿ ಮುದ್ದಿ, ಕಂಬ್ರೆಚೊ ನಾಡೊ ಅನಿ, ತಿಯಾ ಹಾತಿತ್ಲೊ ಧಾಂಡೊ ಥವ್ ಮಟ್ಲಿನ್ ತೆನಿ ತೆ ಸಗ್ಳೆ ತಿಕಾ ದಿವ್ನ್ ತಿಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳ್ಳೊ, ಅನಿ ತಿ ಪೊಟಾನ್ ರಾಲಿ.<verse eid="GEN 38:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 38:19" />ಮಾನಾ ತಾಮರಾ ಘರಾಕ್ ಜಾವ್ನ್ ಅಪ್ಲೆ ವಿಧವಾಚೆ ಕಪ್ಡೆ ನೆಸುನ್ ಘೆಟ್ಲಿನ್.<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />ಮಾನಾ ಗೊಸ್ಟ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಜುದಾಸಾನ್ ಅಪ್ನಾಚ್ಯಾ ಹಿರಾ ಮನ್ತಲ್ಯಾ ದೊಸ್ತಾಕ್ಡೆ ಎಕ್ ಬಕ್ರ್ಯಾಚೊ ಪೆಟೊ ದಿವ್ನ್ ತಿಯಾ ಮಾಜಿ ವಸ್ತಾ ಸೊಡ್ಸುನ್ ಹಾನ್ ಮಟ್ಲ್ಯಾನ್, ಖರೆ ಹಿರಾಕ್ ತಿಜಿ ಒಳಕ್ ದರುಕ್ ಹೊವ್ಕ್ನಾ. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />ಮಾನಾ ತೊ ಜಾತಾನಾ ಎನಾಯಿಮಾತ್ ರ್‍ಹಾತಲ್ಯಾ ಘೊಮಾನ್ಸಾಕ್ನಿ, “ಹಿತ್ತೆ ವಾಟೆರ್ ವರ್‍ತಿ ಸುಳಿ ಖೈ ಹಾಯ್?” ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ, ತನ್ನಾ ತೆನಿ ತೆಕಾ, ಹಿತ್ತೆ ತಸ್ಲಿ ಬಾಯ್ಕೊಮಾನುಸ್ ಕೊನ್ಬಿ ನಾ, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನಿ.<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />ತೊ ಜುದಾಕ್ಡೆ ಪರ್‍ತುನ್ ಯೆವ್ನ್, “ಮಾಜ್ಯಾನ್ ತ್ಯಾ ಬಾಯ್ಕೊ ಮಾನ್ಸಿಕ್ ಒಳ್ಕುಕ್ ಹೊವ್ಕ್ ನಾ, ಅನಿ ಥೈ ರ್‍ಹಾತಲ್ಯಾ ಘೊಮಾನ್ಸಾಚ್ಯಾಂಕ್ಡೆ ಇಚಾರ್ಲೊ ತನ್ನಾ ತೆನಿಬಿ ಹಿತ್ತೆ ತಸ್ಲೆ ಕೊನ್ ನಾತ್ ಮಟ್ಲ್ಯಾನಿ.” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />ಮಾನಾ ತೆಕಾ ಜುದಾಸಾನ್, ಲೊಕಾ ಅಮ್ಕಾ ಬಗುನ್ ಹಾಸ್ತಲೆ ಬರೆ ದಿಸಿನಾ, ಖರೆ ಮಿಯಾ ತಿಕಾ ಬಕ್ರ್ಯಾಂಚೊ ಪೆಟೊ ದಿವ್ಚೆ ಮನುನ್ ಕರಲ್ಲೊ, ಅನಿ ತಿ ಮಾಕಾ ಗಾವ್ಕ್ ನಾ, ತಿ ಮಾಜಿ ಸಾಮಾನಾ ತಿಚೆಕ್ಡೆಚ್ ಥವ್ನ್ ಗೆವಂದಿತ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />ತಿನ್ ಮ್ಹಯಿನೆ ಕಳದಲ್ಲ್ಯಾ ಮಾನಾ ಎಕ್ಲ್ಯಾನ್ ಜುದೆವಾಕಾಕ್ಡೆ ಯೆವ್ನ್, “ತುಜಿ ಸುನ್ನ್ ತಾಮಾರಾ ಬುರ್ಸೆ ಕಾಮ್ ಕರುನ್ ಪೊಟಾನಿ ಹಾಯ್ ” ಮಟ್ಲ್ಯಾನ್, ತನ್ನಾ ಜುದಾಸಾನ್, “ತಿಕಾ ವೊಡುನ್ ಭಾಯ್ರ್ ಹಾನುನ್ ಜಾಳ್ವುನ್ ಜಿವ್ ಕಾಡಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />ಮಾನಾ ತಿಕಾ ವೊಡುನ್ ಹಾನುಕ್ ಗೆಲ್ಲ್ಯಾಂಚ್ಯಾಕ್ಡೆ ತಿನಿ ಮಾಜಾಕ್ಡೆ ಹೊತ್ತಿ ಹಿ ಸಾಮಾನಾ ಸಗ್ಳಿ ಬಗಾ! ಹ್ಯೊ ಛಪ್ಪೊ, ದೊರೊ, ಅನಿ ದಾಂಡೊ ಹೆ ಸಗ್ಳೆ ಕೊನಾಚೆ ಹಾಯ್ ತ್ಯಾಚ್ ಮಾನ್ಸಾಕ್ನಾ ಮಿಯಾ ಪೊಟಾನ್ ಹಾಯ್, ಮನುನ್ ಅಪ್ಲ್ಯಾ ಮಾಮಾಕ್ ಸಾಂಗುನ್ ಧಾಡ್ಲಿನ್.<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />ತನ್ನಾ ಜುದೆವಾನ್ ತಿ ವಸ್ತಾ ಸಗ್ಳಿ ಒಳ್ಕುನ್, “ತಿನಿ ಕಾಯ್ ಚುಕ್ ಕರುಕ್ ನಾ, ಮಿಯಾ ತಿಕಾ ಗೊಸ್ಟ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಮಾಜ್ಯಾ ಲೆಕ್ ಶೆಲಾಕ್ ಲಗಿನ್ ಕರುನ್ ದಿವ್ಕ್ ನಾ, ಖರೆ ಲಗಿನ್ ಕರುನ್ ದಿವ್ಕ್ ನಸ್ತಾನಾ ಮಿಯಾಚ್ ಚುಕ್ ಕರ್ಲಾ,” ಮಟ್ಲ್ಯಾನ್, ಅನಿ ಪರ್‍ತುನ್ ಜುದಾಸಾನ್ ತಿಚ್ಯಾ ವಾಂಗ್ಡಾ ತಸ್ಲೆ ಕಾಮ್ ಕರುಕ್ನಾ.<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />ಮಾನಾ ತಾಮಾರಕ್ ಪೊರಾಕ್ನಿ ಜಲಮ್ ದಿತಲೊ ಎಳ್ ಯೆಲೊ, ಅನಿ ತಿಕಾ ಅವ್ಳಿ ಜವ್ಳಿ ಲೆಕಾ ಹಾತ್ ಮನುನ್ ಕಳ್ಳೆ. <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />ಮಾನಾ ತಿ ಪೊರಾ ಉಪಾಜ್ತಾನಾ, ಎಕ್ ಪೊರಾನ್ ಅಪ್ನಾಚೊ ಹಾತ್ ಫಿಡೆ ಕರ್ತಾನಾ, ತೆಚ್ಯಾ ಹಾತಿಕ್ ಸುಯಿನಿನ್ ಪೈಲೆಚೊ ಪೊರ್ ಮನುನ್ ತಾಂಬ್ಡ್ಯಾ ದೊರ್ಯಾನ್ ಭಾಂದ್ಲಿನ್. <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />ಖರೆ ತ್ಯಾ ಪೊರಾನ್ ಅಪ್ಲೊ ಹಾತ್ ಫಾಟಿ ಒಡುನ್ ಘೆಟ್ಲ್ಯಾನ್, ಅನಿ ತೆಜೊ ಭಾವ್ ಅದ್ದಿ ಜಲಮ್ಲೊ, ತೆಚ್ಯಾ ವೈನಾ ಸುಯಿನಿನ್ ತ್ಯಾ ಪೊರಾಕ್ , ತಿಯಾ ಅದ್ದಿ ಜಲಮಲ್ಲ್ಯಾ ಪೊರಾಕ್ ಫಾಟಿ ಡಕ್ಲುನ್ ಯೆಲೈ ಮನುನ್ ತೆಕಾ “ಪೆರೆಚ್” ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್. <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />ಮಾನಾ ತೆಜೊ ಭಾವ್ ಹಾತಿಕ್ ತಾಂಬ್ಡೊ ದೊರೊ ಭಾಂದಲ್ಲೊ ಘೆವ್ನ್ ಜಲಮ್ಲೊ, ಮಾನಾ ತೆನಿ ತೆಕಾ “ಜೆರಹ್” ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನಿ.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">ಜುಜೆ ಅನಿ ಪೊಟಿಫರಾಚಿ ಬಾಯ್ಕೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಜುಜೆಕ್ ಇಜಿಪ್ತಾಕ್ ನೆಲ್ಯಾನಿ, ಅನಿ ಪೊಟಿಪರ್ ಮನ್ತಲ್ಯಾಕ್ ಇಕ್ಲ್ಯಾನಿ, ತೊ ಪಾರೊವ್ ರಾಜ್ಯಾಚೊ ಕಾಮ್ ಕರ್ತಲೊ ಅನಿ ತೆಕಾ ರಾಕ್ವನ್ ಕರ್ತಲೊ ಅಧಿಪತಿ ಹೊಲ್ಲೊ ರ್‍ಹಾತಾ. <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಜುಜೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತ್ಯಾ ವೈನಾ ತೊ ಲೈ ಬರೊ ಹೊಲೊ , ಅನಿ ತೆಚ್ಯಾ ಯಜಮಾನ್ ಪೊಟಿಪರಾಚ್ಯಾ ಘರ್‍ಹಾತ್ ಆಳ್ ಹೊವ್ನ್ ರಾಲೊ. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />ಮಾನಾ ಜುಜೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಸರ್ವೆಸ್ಪರ್ ರ್‍ಹಾವ್ನ್ ತೊ ಕರ್‍ತಲ್ಯಾ ಕಾಮಾತ್ನಿ ಬರೆ ಹೊವ್ಲಾಗಲೆ ತೆಚೆ ಯಜಮಾನ್ ಫೊಟಿಪರಾನ್ ಬಗಟಲ್ಲ್ಯಾ ತನ್ನಾ, <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />ಪೊಟಿಪರಾಕ್ ಜುಜೆಚ್ಯಾ ವಿಶಯಾತ್ ದಯಾ ಗಾವ್ನ್ ತೆಜೊ ಆಳ್ ಹೊಲೊ, ಅನಿ ತೆನಿ ಅಪ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಘರಾಚಿ ಜವಾಬ್ದಾರಿ ದಿಲ್ಯಾನ್ ಅನಿ ಅಪ್ನಾಕ್ ಹೊತ್ತೆ ಸಗ್ಳೆ ಜುಜೆಚ್ಯಾ ಹಾತಿತ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />ತನ್ನಾ ಜುಜೆಕ್ ಸಗ್ಳೊ ಅಧಿಕಾರ್ ದಿಲ್ಲ್ಯಾ ಮಾನಾ ಪೊಟಿಪರಾಚ್ಯಾ ಘರಾಕ್ ಆಸ್ತಿ ಅನಿ ಸೆತಾಭಾತಾತ್ನಿ ಆಶಿರ್ವಾದ್ ಗಾವ್ಲೆ. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />ತೆಚ್ಯಾ ವೈನಾ ಪೊಟಿಪರ್ ಅಪ್ನಾಚ್ಯಾಕ್ಡೆ ಹೊತ್ತೆ ಪುರಾ ಜುಜೆಚ್ಯಾ ಹಾತಿತ್ ದಿಲ್ಯಾನ್,</para>
  <para style="p" vid="GEN 39:6">ಅನಿ ತೆಚ್ಯಾ ಯಜಮಾನಾನ್ ಜೆವ್ತಲೆ ಜವಾನ್ ಎಕ್ ಸೊಡುನ್ ಹರ್ ಎಕಾವರ್‍ತಿ ತೆಕಾ ಅಧಿಕಾರ್ ದಿವ್ನ್ ತೊ ಆರಾಮಾನ್ ಹೊತ್ತೊ ಅನಿ ಜುಜೆ ಬಗುಕ್ ಲೈ ಸುಂದರ್ ಹೊತ್ತೊ.<verse eid="GEN 39:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 39:7" />ಅಸಿ ರ್‍ಹಾತಾನಾ ಯಜಮಾನಾಚ್ಯಾ ಬಾಯ್ಕೊಕ್ ಜುಜೆಚ್ಯಾ ವರ್‍ತಿ ಮನ್ ಹೊತಾ, ಎಕ್ ದಿಸಿ ತಿನಿ ತೆಕಾ, ನಿಜುಕ್ ಯೆ ಮಟ್ಲಿನ್. <verse eid="GEN 39:7" /><verse number="8" style="v" sid="GEN 39:8" />ಖರೆ ತೆನಿ ತಿನಿ ಸಾಂಗಲ್ಲ್ಯಾ ಗೊಸ್ಟಿಕ್ ಮಾನುಕ್ ನಾ. ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಮಾಜ್ಯಾ ಯಜಮಾನಾನ್ ಘರಾಚಿ ಸಗ್ಳಿ ಜವಾಬ್ದಾರಿ ಮಾಕಾ ದಿಲ್ಯಾನಾಯ್. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />ಖರೆ ತೆಚ್ಯಾ ಬಾಯ್ಕೊ ತುಜ್ಯಾ ವರ್‍ತಿ ಮಾಕಾ ಅಧಿಕಾರ್ ದಿವ್ಕ್ ನಾ ಅನಿ ಮಾಕಾ ಘರಾಚೆ ಸಗ್ಳೆ ಅಧಿಕಾರ್ ದಿಲಾ, ಅಸೆ ರ್‍ಹಾತಾನಾ ಮಿಯಾ ದೆವಾಚ್ಯಾ ಇದ್ರಾಕ್ ಕಸೆ ಪಾಪ್ ಕರು?ಮನುನ್ ತಿಕಾ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />ಹೊಲ್ಯಾರ್ಬಿ ತಿ ತೆಕಾ ಹರ್ ಎಕ್ ದಿಸಿಬಿ ತರಾಸ್ ದಿವ್ನ್ ಗೆತ್ ರ್‍ಹಾಯ್, ಖರೆ ತೊ ತಿಚ್ಯಾ ವಾಂಗ್ಡಾ ಹಾತ್ರನಾಕ್ ಜಾವ್ಕ್ ನಾ.<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />ಎಕ್ ದಿಸಿ ಜುಜೆ ತೊ ಎಕ್ಲೊಚ್ ಘರ್‍ಹಾತ್ ರ್‍ಹಾತಾನಾ ಕಾಮಾಚ್ಯಾ ವೈನಾ ತೊ ಬುತ್ತುರ್ ಜಾತಾ ತನ್ನಾ ಖಲಿಬಿ ಸೆವಕಾ ರ್‍ಹಾಯ್ನಾತ್, <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />ತನ್ನಾ ತೆಚ್ಯಾ ಯಜಮಾನಾಚ್ಯಾ ಬಾಯ್ಕೊನ್ ತೆಜೊ ಝಗೊ ಧರುನ್ ವಡುನ್ ತೆಕಾ ಯೆ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ನಿಜ್ ಮಟ್ಲಿನ್, ತನ್ನಾ ತೊ ತಿಚ್ಯಾಕ್ನಾ ಚುಕ್ವುನ್ ಘೆವ್ನ್ ಅಪ್ಲೊ ಝಗೊ ತಿಚ್ಯಾ ಹಾತಿತ್ ಸೊಡುನ್ ಪಳುನ್ ಗೆಲೊ, <verse eid="GEN 39:12" /><verse number="13" style="v" sid="GEN 39:13" />ತೆನಿ ಅಪ್ನಾಚೊ ಝಗೊ ಸೊಡುನ್ ಚುಕ್ವುನ್ ಘೆವ್ನ್ ಘೆಲ್ಲೆ ತಿನಿ ಬಗುನ್, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />ಅಪ್ಲ್ಯಾ ಸೆವಕಾಕ್ನಿ ಬಲ್ವುನ್ ಬಗಾ ಹಿತ್ತೆ ಮಾಜ್ಯಾ ನ್ಹವ್ರ್ಯಾನ್ ಹಾನುನ್ ಹ್ಯಾ ಹೆಬ್ರೆವಾಕ್ ಹಾನುನ್ ಅಮ್ಕಾ ಅವ್ಮಾನ್ ಕರ್ಲ್ಯಾನ್ ಅನಿ ತೊ ಮಾಜ್ಯಾ ಖೊಲಿಕ್ ಯೆವ್ನ್ ಮರ್ಯಾದ್ ಕಾಡುಕ್ ಬಗ್ಲ್ಯಾನ್ ಖರೆ ಮಿಯಾ ಬೊಬ್ ಮಾರ್ಲೊ, <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />ಮಾಜ್ಯಾ ಬೊಬೆನ್ ಬ್ಹಿವ್ನ್ ತೆಚೊ ಝಗೊ ಹಿತ್ತೆಚ್ ಸೊಡುನ್ ಘರ್‍ಹಾತ್ನಾ ಪಳುನ್ ಭಾಯ್ರ್ ಗೆಲೊ ಮನುನ್ ಸಾಂಗ್ಲಿನ್.<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />ಮಾನಾ ತಿನಿ ಅಪ್ನಾಚೊ ನ್ಹವ್ರೊ ಯೆಯ್ ಪತರ್ ತೊ ಝಗೊ ಅಪ್ನಾಕ್ಡೆ ಥವ್ನ್ ಘೆಟಲಿನ್. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />ಮಾನಾ ನ್ಹವ್ರೊ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ, ತಿಯಾ ಕಾಮಾಕ್ ಮನುನ್ ಹಾನಲ್ಲ್ಯಾ ಹೆಬ್ರೆವಾನ್ ಮಾಜ್ಯಾ ಖೊಲಿಕ್ ಯೆವ್ನ್ ಮರ್ಯಾದ್ ಕಾಡ್ಲ್ಯಾನ್. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />ಖರೆ ಮಿಯಾ ಮೊಟ್ಯಾನಿ ಬೊಬ್ ಮಾರ್ತಾನಾ ಝಗೊ ಸೊಡುನ್ ಘರ್‍ಹಾತ್ನಾ ಭಾಯ್ರ್ ಪಳುನ್ ಗೆಲೊ, ಮಟ್ಲಿನ್.<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />ತನ್ನಾ ಯಜಮಾನಾಕ್ ತುಜ್ಯಾ ಸೆವಕಾನ್ ಅಸೆ ಕರ್ಲಾ ಮನುನ್ ಬಾಯ್ಕೊನ್ ಸಾಂಗಲ್ಲೆ ಆಯ್ಕುನ್ ತೆಚ್ಯಾ ವರ್‍ತಿ ಲೈ ರಾಗ್ ಹೊಲೊ. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />ಮಾನಾ ತೆನಿ ಪೊಟಿಫರಾನ್ ಜುಜೆಚ್ ದುಸ್ಮನಾಕ್ನಿ ಘಾಲ್ತಲ್ಯಾ ಭಂಧಿಖಾನ್ಯಾತ್ ಘಾಟ್ಲ್ಯಾನ್, ಅನಿ ಜುಜೆ ಥೈಚ್ ಹೊತ್ತೊ. <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />ಖರೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾವ್ನ್ ತೆಕಾ ಆಶಿರ್ವಾದ್ ದಿಲ್ಯಾನ್, ಅಸೆ ಹೊವ್ನ್ ಯಜಮಾನಾಕ್ನಾ ತೆಕಾ ದಯಾ ಘಾವ್ಲಿ. <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />ಮಾನಾ ತ್ಯಾ ಅಧಿಕಾರಿನ್ ಸಗ್ಳ್ಯಾ ಬಂಧಿ ಹೊತ್ತ್ಯಾಕ್ನಿ ಜುಜೆಚ್ಯಾ ತಾಬೆತ್ ದಿಲ್ಯಾನ್, ತೊ ತೆಂಕಾ ಸಗ್ಳಿ ಕಾಮಾ ಜವಾಬ್ದಾರಿನ್ ಕರ್ಸುನ್ಗೆತ್ ರ್‍ಹಾಯ್. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />ಜುಜೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಹೊತ್ತ್ಯಾ ವೈನಾ ಸಗ್ಳಿ ಕಾಮಾತ್ನಿ ತೆಕಾ ಶಬಾಸ್ಕಿ ಗಾಯ್ತ್ ಹೊತ್ತಿ, ತನ್ನಾ ತೆ ಭಗುನ್ ಅಧಿಕಾರಿನ್ ಸಗ್ಳೆ ಕಾಮಾ ಜುಜೆಕುಚ್ ದಿವ್ನ್ ಆರಾಮ್ ರ್‍ಹಾಯ್.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">ಜುಜೆನ್ ಸಫ್ನಾಚೊ ಅರ್ಥ್ ಸಾಂಗಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />ಹೆ ಸಗ್ಳೆ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಫರೊಹಾ ರಾಜ್ಯಾಚೊ ವಾಯ್ನ್ ದಿತಲೊ ಪ್ರಧಾನ್ ಸೆವಕ್ ಅನಿ ಬಾರಿಕ್ಲಿ ದಿತಲ್ಯಾ ಪ್ರಧಾನ್ ಸೆವಕಾನಿ ರಾಜಾಕ್ ವಿರೊದ್ ಹೊವ್ನ್ ಚುಕ್ ಕರಲ್ಯಾನಿ. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />ತನ್ನಾ ಫರೊಹಾ ರಾಜಾ ತೆಂಚ್ಯಾ ದೊಗ್ಯಾಂಚ್ಯಾ ವರ್‍ತಿ ರಾಗ್ ಹೊವ್ನ್, <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />ತೆಂಕಾ ಜುಜೆ ಹೊತ್ತ್ಯಾ ಭಂದಿಖಾನ್ಯಾತ್ ಘಾಟ್ಲ್ಯಾನ್, ಫರೊಹಾ ರಾಜ್ಯಾಚೊ ರಾಕ್ವಾಲಿ ಹೊವ್ನ್ ಹೊತ್ತೊ ಪೊಟಿಪರ್ ಮನ್ತಲ್ಯಾ ಅಧಿಕಾರಿಕ್ ತ್ಯಾ ಭಂಧಿಖಾನ್ಯಾಚಿ ಜವಾಬ್ದಾರಿಬಿ ಹೊತ್ತಿ. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />ತ್ಯಾ ಭಂಧಿಖಾನ್ಯಾಚ್ಯಾ ಮೊಟ್ಟ್ಯಾ ಅಧಿಕಾರಿನ್ ತೆಂಕಾ ದೊಗ್ಯಾಕ್ನಿ ಜುಜೆಕ್ಡೆ ನೆವ್ನ್ ದಿಲ್ಯಾನಿ, ಜುಜೆಚ್ಯಾ ತಾಬೆತ್ ದಿಲ್ಯಾನಿ, ತೊ ತೆಂಚೊ ಅಧಿಕಾರಿ ಹೊಲೊ, ತೆನಿ ಲೈ ಎಳ್ ಪತರ್ ಥೈಚ್ ಹೊತ್ತೆ.<verse eid="GEN 40:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 40:5" />ಮಾನಾ ತೆಸೆಚ್ ಎಕ್ ದಿಸ್ ರಾತ್ತಿನ್ ತ್ಯಾ ವಾಯ್ನ್ ದಿತಲ್ಯಾಕ್ ಅನಿ ಬಾರಿಕ್ಲಿದಿತಲ್ಯಾಕ್ ಎಕ್ ಸಫ್ನಾ ಪಡ್ತಾತ್, ತ್ಯಾ ಸಪ್ನಾಕ್ನಿ ದುಸ್ರೆ ದುಸ್ರೆ ಅರ್ಥ್ ಹೊತ್ತೊ ರ್‍ಹಾತಾ. <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />ದುಸ್ರೆ ದಿಸಿ ಸಕಕಲಿ ಜುಜೆ ತೆನಿ ಹೊತ್ತ್ಯಾಕ್ಡೆ ಜಾತಾ ಅನಿ ತೆನಿ ಚಿಂತುನ್ಗೆತ್ ಬಸಲ್ಲೆ ದಿಸ್ತಾತ್,<verse eid="GEN 40:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 40:7" />ತೆನಿ ತೆಚ್ಯಾ ಯಜಮಾನಾಚ್ಯಾ ಘರ್‍ಹಾತ್ ಅಪ್ನಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತ್ಯಾ ಪಾರೊಹಾ ರಾಜಾಚ್ಯಾ ಅಧಿಕಾರಿಯಾಕ್ನಿ ಬಗುನ್, “ಆಜ್ ಲೈ ಚಿಂತಾತ್ ಹೊತ್ತೆ ಸಾರ್ಕೆ ದಿಸುಲ್ಲಾ ಕಾಯ್ ಹೊಲೆ?” ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />ತನ್ನಾ ತೆನಿ ದೊಗ್ಯಾನಿಬಿ, ಅಮಿ ದೊಗ್ಯಾನಿಬಿ ಎಕೆಕ್ ಸಪ್ನಾ ಬಗ್ಲ್ಯಾಂವ್;</para>
  <para style="p" vid="GEN 40:8">ಖರೆ ತೆಚೊ ಅರ್ಥ್ ಅಮ್ಕಾ ಸಾಂಗುಕ್ ಕೊನ್ಬಿ ನಾತ್ ಮಟ್ಲ್ಯಾನಿ, ತನ್ನಾ ಜುಜೆನ್ ತೆಂಕಾ, ದೆವಾಕ್ ಎಕ್ಲ್ಯಾಕುಚ್ ಸಪ್ನಾಂಚೊ ಅರ್ಥ್ ಕಳ್ತಾ, ಅನಿ ಅರ್ಥ್ ಸಾಂಗ್ತಲೊಬಿ ತೊಚ್, ತನ್ನಾ ದಯಾ ಕರುನ್ ತುಮ್ಚಿ ಸಪ್ನಾ ಮಾಜ್ಯಾಕ್ಡೆ ಸಾಂಗಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />ತನ್ನಾ ವಾಯ್ನ್ ದಿತಲ್ಯಾನ್ ಸೆವಕಾನ್, ಮಿಯಾ ಮಾಜ್ಯಾ ಸಫ್ನಾತ್ ದರಾಕ್ಷಾಚಿ ಯೆಲ್ ಬಗಟ್ಲೊ. <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />ತ್ಯಾ ಯೆಲಿಕ್ ತಿನ್ ಫಾಟೆ ಹೊತ್ತೆ, ತೆಕಾ ಪಾನಾ ಚಿಗ್ರುನ್ ಫುಲ್ಲಾ ಸುಟ್ಲಿ, ತಿ ಫುಲ್ಲಾ ಗೊಂಚಾಲಾನಿ ಫಳಾ ಹೊಲಿ. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />ತನ್ನಾ ಫರೊನಾಚೆ ವಾಟ್ಕೆ ಮಾಜ್ಯಾ ಹಾತಿತ್ ಹೊತ್ತೆ, ತನ್ನಾ ಮಿಯಾ ದರಾಕ್ಷಿ ಘೆವ್ನ್ ತ್ಯಾ ವಾಟ್ಕ್ಯಾತ್ ಪಿಳುನ್ ಫರೊಹಾಚ್ಯಾ ಹಾತಿತ್ ದಿಲೊ, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />ತನ್ನಾ ಜುಜೆನ್ ತೆಕಾ ತ್ಯಾ ಸಪ್ನಾಚೊ ಅರ್ಥ್ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ತೆ ತಿನ್ ಪಾಟೆ ಮಟ್ಲ್ಯಾರ್ ತಿನ್ ದಿಸಾ. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />ಹ್ಯಾ ತಿನ್ ದಿಸಾತ್ನಿ ರಾಜಾ ತುಕಾ ಬಂಧಿಕಾನ್ಯಾತ್ನಾ ಸುಟ್ಕಾ ಕರುನ್ ಮಾಪಿ ಕರ್ತಾ ಅನಿ ತಿಯಾ ಅದ್ದಿ ಕರ್‍ತಲ್ಯಾ ಕಾಮಾ ವೈನಿ ಅನಿ ಪರ್‍ತುನ್ ಥವ್ತಾ, ಅನಿ ತಿಯಾ ತೆಕಾ ವಾಯ್ನ್ ದಿತಲೊ ಹೊವ್ನ್ ರಾತೈ. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />ಖರೆ ತಿಯಾ ಸುಖಾನ್ ರ್‍ಹಾತಾನಾ ಮಾಕಾ ಯಾದ್ ಕರುನ್ ಮಾಜ್ಯಾ ವಿಶಯಾತ್ ರಾಜಾಕ್ಡೆ ಸಾಂಗುನ್ ಮಾಕಾ ಸುಟ್ಕಾ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />ಅನಿ ಮಿಯಾ ಇಬ್ರಿಯಾ ದೆಶಾಚೊ ಮಾಕಾ ಉಲ್ಲ್ಯಾ ಲೊಕಾನಿ ಕಾಯ್ಬಿ ಚುಕ್ ನಸ್ಲ್ಯಾರ್ಬಿ ಬಂಧಿ ಕರುನ್ ಘೆವ್ನ್ ಯೆಲಾತ್, ಅನಿ ಮಿಯಾ ಹಿತ್ತೆಬಿ ಕಾಯ್ ಚುಕ್ ಕರಿನಸ್ತಾನಾ ಬಲ್ವಂತಾನ್ ಬಂಧಿಖಾನ್ಯಾತ್ ಘಾಟ್ಲಾತ್, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />ವಾಯ್ನ್ ದಿತಲ್ಯಾಚೆಪ್ರಧಾನ್ ಸೆವಕಾಚೆ ಸಫಾನ್ ಬರೆ ಹೊತ್ತೆ ಬಗುನ್, ಬಾರಿಕ್ಲಿ ದಿತಲ್ಯಾನ್ ಜುಜೆಕ್ಡೆ, ಮಾಕಾಬಿ ಎಕ್ ಸಫಾನ್ ಪಡ್ಲೆ, “ತ್ಯಾ ಸಪ್ನಾತ್ ಮಾಜ್ಯಾ ಟಕ್ಲಿಚ್ಯಾ ವರ್‍ತಿ ತಿನ್ ಬಾರಿಕ್ಲಿಯಾಂಚಿ ಬುಟ್ಟಿಯಾ ಹೊತ್ತಿ, <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />ತ್ಯಾ ಬುಟ್ಟಿತ್ ಪರೊಹಾಕ್ ಮನುನ್ ಹೊತ್ತಿ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಫಳಾ ಹೊತ್ತಿ, ಖರೆ ತೆ ಸಗ್ಳೆ ಫಾಕ್ರಾನಿ ಯೆವ್ನ್ ಖಾಲ್ಯಾನಿ,” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />ತನ್ನಾ ಜುಜೆನ್ ತೆಕಾ, “ಹ್ಯಾ ಸಫ್ನಾಚೊ ಅರ್ಥ್ ಮಿಯಾ ತುಕಾ ಸಾಂಗ್ತಾ, ತ್ಯಾ ತಿನ್ ಬುಟ್ಟಿಯಾ ಮಟ್ಲ್ಯಾರ್ ತಿನ್ ದಿಸಾ, <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />ಮಾನಾ ತ್ಯಾ ತಿನ್ ದಿಸಾತ್ ತುಕಾ ರಾಜಾ ಭಂಧಿಖಾನ್ಯಾತ್ನಾ ಸೊಡ್ವುನ್ ಹಾನುನ್ ತುಜಿ ಮಾನ್ ಮಾರ್‍ತಾ ಅನಿ ಖಾಂಬ್ಯಾಕ್ ಲೊಂಬಾತ್ ಘಾಲ್ತಾ; ಮಾನಾ ಫಾಕ್ರಾ ಯೆವ್ನ್ ತುಕಾ ಖಾತಾತ್,” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />ಮಾನಾ ತಿನ್ ದಿಸಾ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಫರೊಹಾ ರಾಜಾಚೆ ಉಪಾಜಲ್ಲೊ ದಿಸಿ ಹೊಲ್ಲೊ ರ್‍ಹಾತಾ, ತ್ಯಾ ದಿಸಿ ರಾಜಾ ತ್ಯಾ ದೊಗೆಜನಾ ಪ್ರಧಾನ್ ಸೆವಕಾಕ್ನಿ ಭಂಧಿಖಾನ್ಯಾತ್ನಾ ಸುಟ್ಕಾ ಕರ್ತಾ, ಅನಿ ಸಗ್ಳ್ಯಾ ಸೆವಕಾಕ್ನಿ ಜೆವಾನ್ ಥವ್ತಾ. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />ಅನಿ ರಾಜಾನ್ ಪಾನಿ ದಿತಲ್ಯಾಕ್ ಅನಿ ಪರ್‍ತುನ್ ತ್ಯಾ ಕಾಮಾಕ್ ಥವ್ತಾ, ಮಾನಾ ತೊ ಅದ್ದಿ ಹೊತ್ತ್ಯಾ ಕಾಮಾ ವೈನಾ ರಾಜಾಚ್ಯಾ ಹಾತಿತ್ ವಾಟ್ಕೆ ದಿತಲೊ ಹೊಲೊ. <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />ಖರೆ ರಾಜ್ಯಾನ್ ಬಾರಿಕ್ಲಿ ದಿತಲ್ಯಾಕ್ ಜಿವ್ ಕಾಡ್ಲ್ಯಾನ್, ಅನಿ ಜುಜೆನ್ ಸಪ್ನಾಂಚೊ ಅರ್ಥ್ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆ ಸಗ್ಳೆಬಿ ಹೊಲೆ. <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />ಖರೆ ಜುಜೆಚ್ಯಾ ವಿಶಯಾತ್ ವಾಯ್ನ್ ದಿತಲ್ಯಾನ್ ರಾಜಾಕ್ಡೆ ಕಾಯ್ಬಿ ಸಾಂಗುಕ್ ನಾ, ಜುಜೆಕ್ ತೆನಿ ಇಸ್ರುನ್ ಸೊಡ್ಲ್ಯಾನ್.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">ಜುಜೆ ರಾಜಾಚ್ಯಾ ಸಪ್ನಾಂಚೊ ಅರ್ಥ್ ಸಾಂಗ್ತಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />ಮಾನಾ ದೊನ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಫರೊಹಾ ರಾಜಾಕ್ ಎಕ್ ಸಪಾನ್ ಪಡ್ತಾ, ತೊ ರಾಜಾ ತ್ಯಾ ಸಪ್ನಾತ್ ನೈಲ್ ನ್ಹಯಿಚ್ಯಾ ದಂಡೆರ್ ಇಬೆ ಹೊತ್ತೊ. <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />ತನ್ನಾ ಸಾತ್ ಪುಟ್ಪುಟಿತ್ ಅನಿ ಸುಂದರ್ ಹೊತ್ತಿ ಗಾಯಾ ನೈಲ್ ನ್ಹಯಿತ್ನಾ ಭಾಯ್ರ್ ಯೆವ್ನ್ ಚರುಕ್ ಲಾಗಲ್ಲಿ. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />ಮಾನಾ ಸಾತ್ ಬಡ್ಕಿ ಅನಿ ಭಗುಕ್ ಬರಿ ನಸಲ್ಲಿ ಗಾಯಾ ನೈಲ್ ನ್ಹಯಿತ್ನಾ ಯೆವ್ನ್ ತ್ಯಾ ಸಾತ್ ಗಾಯಾಂಚ್ಯಾ ಫಾಟ್ನಾ ಇಬೆರಾಲಿ. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />ಮಾನಾ ಸಾತ್ ಬಡ್ಕ್ಯಾ ಗಾಯಾನಿ, ತ್ಯಾ ಸಾತ್ ಪುಟ್ ಪುಟಿತ್ ಹೊತ್ತ್ಯಾ ಗಾಯಾಕ್ನಿ ಖಾಲ್ಯಾನಿ, ತನ್ನಾ ಮಾನಾ ಫರೊಹಾ ರಾಜಾ ನಿಜೆತ್ನಾ ಜಾಗೊ ಹೊಲೊ. <verse eid="GEN 41:4" /><verse number="5" style="v" sid="GEN 41:5" />ಫರೊಹಾ ರಾಜಾ ಅನಿ ಪರ್‍ತುನ್ ನಿಜ್ತಾನಾ ತೆಕಾ ದೊನ್ವೆಚೆ ಸಫಾನ್ ಪಡ್ತಾ, ತ್ಯಾ ಸಫ್ನಾತ್ ಸಾತ್ ಕನ್ಸಾ ಬರೆ ಪುಸ್ಟಿ ಹೊವ್ನ್ ಎಕುಚ್ ಝಾಡಾತ್ ಉಗಾವ್ಲಿ, <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />ತೆಂಚ್ಯಾ ಫಾಟ್ನಾ ತ್ಯಾಚ್ ಝಾಡಾಕ್ ಹುನ್ಲ್ಯಾ ವಾರ್ಯಾನಿ ಜಳುನ್ ಗೆಲ್ಲಿ ದುಸ್ರಿ ಸಾತ್ ಕನ್ಸಾ ಉಗಾವ್ಲಿ. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />ಮಾನಾ ತಿ ಸಾತ್ ವಾಳುನ್ ಗೆಲ್ಲಿ ಕನ್ಸಾ ತ್ಯಾ ಸಾತ್ ಪುಟ್ ಪುಟಿತ್ ಹೊತ್ತ್ಯಾ ಕನ್ಸಾಕ್ನಿ ಖಾತಾತ್, ತನ್ನಾ ಫರೊಹಾ ರಾಜಾ ಜಾಗೊ ಹೊವ್ನ್ ಹೆ ಬಿ ಸಫಾನ್ ಮನುನ್ ಕಳುನ್ ಪರ್‍ತುನ್ ನಿಜ್ತಾ. <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" />ದುಸ್ರೆ ದಿಸಿ ಸಕ್ಕಾಳಿ ರಾಜಾಕ್ ತ್ಯಾ ಸಫ್ನಾಚ್ಯಾ ವಿಶಯಾತ್ ಲೈ ಚಿಂತಾಲಾಗ್ತಾ, ತನ್ನಾ ತೊ ರಾಜಾ ಇಜಿಪ್ತಾತ್ಲ್ಯಾ ಮೊಡ್ಗಾರಾಕ್ನಿ ಬಲ್ವುನ್ ಅನಿ ಪಂಡಿತಾಕ್ನಿ ಬಲ್ವುನ್ ತೆಂಕಾ ತ್ಯಾ ಸಫಾನ್ ಸಾಂಗ್ತಾ ಅನಿ ಅರ್ಥ್ ಇಚಾರ್ತಾ ಖರೆ ತೆಂಚ್ಯಾತ್ ಕೊನಾಕ್ಬಿ ತ್ಯಾ ಸಪ್ನಾಂಚೊ ಅರ್ಥ್ ಸಾಂಗುಕ್ ಅನಿ ವಿವರನ್ ಕರುಕ್ ಹೊವ್ಕ್ ನಾ.<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />ತನ್ನಾ ಫರೊಹಾ ರಾಜಾಕ್ ವಾಯ್ನ್ ದಿತಲ್ಯಾನ್ ಜುಜೆಕ್ ಯಾದ್ ಕರುನ್ ಘೆವ್ನ್, ಅತ್ತಾ ಮಿಯಾ ಮಾಜಿ ಚುಕ್ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಒಪ್ಪುನ್ ಘೆವ್ಚೆ. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />ರಾಜಾ ತಿಯಾ ಮಾಕಾ ಅನಿ ಬಾರಿಕ್ಲಿ ದಿತಲ್ಯಾಕ್ ಅಮ್ಚ್ಯಾ ವರ್‍ತಿ ರಾಗ್ ಯೆವ್ನ್ ಅಮ್ಕಾ ರಾಕ್ತಲ್ಯಾಂಚ್ಯಾ ಅಧಿಪತಿಚ್ಯಾ ಘರ್‍ಹಾತ್ ಭಂದಿಖಾನ್ಯಾತ್ ಘಾಟಲೈ,<verse eid="GEN 41:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 41:11" />ತನ್ನಾ ಅಮ್ಕಾ ದೊಗ್ಯಾಕ್ನಿಬಿ ಎಕುಚ್ ದಿಸಿ ಸಫ್ನಾ ಪಡಲ್ಲಿ ತ್ಯಾ ಸಫ್ನಾಕ್ನಿ ದುಸ್ರೊ ದುಸ್ರೊ ಅರ್ಥ್ ಹೊತ್ತೊ. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />ತನ್ನಾ ಅಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಎಕ್ ಇಬ್ರಿಯಾಂಚೊ ದಾಂಡ್ಗೊ ಝಿಲ್ಗೊ ಹೊತ್ತೊ ತೊ ರಕ್ವಾಲ್ಯಾಂಚ್ಯಾ ಮುಂಖಡಾಚೊ ಸೆವಕ್ ಹೊಲ್ಲೊ ಹೊತ್ತೊ, ತೆಕಾ ಅಮಿ ಅಮ್ಚೆ ಸಫಾನ್ ಸಾಂಗ್ಲಾಂವ್ ತೆ ಅಮ್ಕಾ ತೆನಿ ತ್ಯಾ ಸಫ್ನಾಂಚೊ ಅರ್ಥ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />ತೆನಿ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆ ಮಾಜೆ ಅದ್ದಿ ಹೊತ್ತೆ ಕಾಮ್ ಮಾಕಾ ಗಾವ್ಲೆ ಅನಿ ತೆಚೊ ಅರ್ಥ್ ಸಮಾ ಹೊತ್ತೊ, ಅನಿ ಮಾನಾ ಬಾರಿಕ್ಲಿ ದಿತಲ್ಯಾಕ್ ಸಾಂಗಲ್ಯಾ ಅರ್ಥಾ ಸಾರ್ಕೆ ತೆಕಾ ಮಾರುನ್ ದಂಡ್ ಹೊಲೆ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />ರಾಜ್ಯಾನ್ ಜುಜೆಕ್ ಬಂಧಿಖಾನ್ಯಾತ್ನಾ ಸುಟ್ಕಾ ಕರುಕ್ ಸಾಂಗುನ್ ಧಾಡಲ್ಯಾ ತನ್ನಾ ತೆಕಾ ಲಗ್ಗುನಾ ಸುಟ್ಕಾ ಕರುನ್ ಹೊಲೆ, ಮಾನಾ ಜುಜೆ ಕೆಸಾ ಕಾಡುನ್ ಘೆವ್ನ್ ಶುದ್ದ್ ಕಪ್ಡೆ ನೆಸುನ್ ಘೆವ್ನ್ ಫರೊಹಾ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಜಾವ್ನ್ ಇಬೆ ರಾಲೊ. <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />ತನ್ನಾ ಫರೊಹಾ ರಾಜ್ಯಾನ್ ಜುಜೆಕ್, ಮಾಕಾ ಎಕ್ ಸಫಾನ್ ಪಡ್ಲಾ , ತ್ಯಾ ಸಪ್ನಾಚೊ ಅರ್ಥ್ ಸಾಂಗ್ತಲೊ ಹಿತ್ತೆ ಕೊನ್ಬಿ ನಾತ್ ತಿಯಾ ಹ್ಯಾ ಸಫ್ನಾಚೊ ಅರ್ಥ್ ಸಾಂಗ್ತೈ ಮನುನ್ ಮಿಯಾ ಆಯಿಕ್ಲಾ, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 41:15" /><verse number="16" style="v" sid="GEN 41:16" />ತನ್ನಾ ಜುಜೆನ್, ಮಾಕಾ ಕಾಯ್ ಹ್ಯಾ ಸಪ್ನಾಚೊ ಅರ್ಥ್ ಸಾಂಗ್ತಲೆ ತವ್ಡಿ ತಾಕತ್ ನಾ, ಖರೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ಡೆ ಎಕುಕ್ ತಿ ತಾಕತ್ ಹಾಯ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />ತನ್ನಾ ಫರೊಹಾನ್ ರಾಜಾನ್ ಜುಜೆಕ್ಡೆ ತ್ಯಾ ಸಪ್ನಾತ್, ಮಿಯಾ ನೈಲ್ ನ್ಹಯಿಚ್ಯಾ ದಂಡೆರ್ ಇಬೆ ಹೊತ್ತೊ, <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />ನ್ಹಯಿತ್ನಾ ಪುಟ್ಪುಟಿತ್ ಹೊತ್ತಿ ಸಾತ್ ಗಾಯಾ ಯೆವ್ನ್ ಗವಾತ್ ಚರಿತ್ ಹೊತ್ತಿ, <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />ತನ್ನಾ ಬಡ್ಕಿ ಹೊತ್ತಿ ಅನಿ ಬಗುಕ್ ಬರಿ ನತ್ತಿ ಸಾತ್ ಗಾಯಾ ಯೆವ್ನ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಇಬೆ ರಾಲಿ, ಅನಿ ಮಿಯಾ ಅಸ್ಲಿ ಬಡ್ಕಿ ಗಾಯಾ ಮಿಯಾ ಇಜಿಪ್ತಾತ್ ಖೈಬಿ ಬಗುಕ್ ನಾ. <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />ಮಾನಾ ತ್ಯಾ ಪುಟ್ಪುಟಿತ್ ಹೊತ್ತ್ಯಾ ಸಾತ್ ಗಾಯಾಕ್ನಿ ಹ್ಯಾ ಸಾತ್ ಬಡ್ಕ್ಯಾ ಗಾಯಾನಿ ಖಾಲ್ಯಾನಿ. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />ಮಾನಾ ತಿ ಗಾಯಾ ತೆಂಕಾ ಖಾಲ್ಯಾರ್ಬಿ ಖಾಲ್ಯಾ ಸಾರ್ಕೆ ದಿಸಿ ನಸಿತ್, ಅನಿ ತಿ ಅದ್ದಿ ಕಸಿ ಹೊತ್ತಿ ತಸೆಚ್ ದಿಸಿತ್, ತನ್ನಾ ಮಾನಾ ಮಾಕಾ ನಿಜೆತ್ನಾ ಜಾಗೊ ಜಾಲೊ. <verse eid="GEN 41:21" /><verse number="22" style="v" sid="GEN 41:22" />ಅನಿ ಎಕ್ ಸಪಾನ್ ಅಸೆ ಹಾಯ್: ಎಕುಚ್ ದೆವಾಕ್ ಸಾತ್ ದಾನೆ ಭರಲ್ಲಿ ಕನ್ಸಾ ಉಗಾವ್ಲಿ, <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />ಮಾನಾ ತ್ಯಾ ಝಾಡಾತ್ ವಾರ್ಯಾನಿ ವಾಳುನ್ ಗೆಲ್ಲಿ ಸಾತ್ ಕನ್ಸಾಬಿ ಉಗಾವ್ಲಿ,<verse eid="GEN 41:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 41:24" />ಮಾನಾ ತಿ ವಾಳುನ್ ಗೆಲ್ಲ್ಯಾ ಸಾತ್ ಕನ್ಸಾನಿ ತ್ಯಾ ಪುಸ್ಟಿ ಹೊತ್ತ್ಯಾ ಸಾತ್ ಕನ್ಸಾಕ್ನಿ ಗಿಳ್ಯಾನಿ, ತನ್ನಾ ಮಿಯಾ ಹ್ಯಾ ಸಪ್ನಾಚೊ ಅರ್ಥ್ ಕಳ್ವುನ್ ಘೆವ್ಕ್ ಮನುನ್ ಪಂಡಿತಾಕ್ನಿ ಅನಿ ಮೊಡ್ಗಾರಾಕ್ನಿ ಮಾಜೆ ಸಪಾನ್ ಸಾಂಗ್ಲೊ ಖರೆ ತೆಂಕಾ ತೆಚೊ ಅರ್ಥ್ ನಾತರ್ ವಿವರನ್ ತೆಂಚ್ಯಾನಿ ಸಾಂಗುಕ್ ಹೊವ್ಕ್ ನಾ, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />ತನ್ನಾ ಜುಜೆನ್ ಫರೊಹಾ ರಾಜಾಕ್, ದೆವಾನ್ ತುಮ್ಕಾ ಫಿಡೆ ಹೊತಲ್ಯಾಚ್ಯಾ ವಿಶಯಾತ್ ಕಳ್ವುಲಾ, ಅನಿ ಹ್ಯಾ ದೊನ್ ಸಫ್ನಾಂಚೊ ಅರ್ಥ್ ಎಕುಚ್ ಹಾಯ್. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />ಅನಿ ಪುಟ್ಪುಟಿತ್ ಸಾತ್ ಗಾಯಾಚ್ ಸಾತ್ ವರಿಸ್ ಮನುನ್ ಅನಿ ಸಾತ್ ಪುಟ್ಪುಟಿತ್ ಕನ್ಸಾ ಮಟ್ಲ್ಯಾರ್ ಸಾತ್ ವರಿಸ್ ಹ್ಯಾ ದೊನ್ ಸಫ್ನಾಚೊ ಅರ್ಥ್ ಎಕುಚ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />ಬಡ್ಕಿ ಸಾತ್ ಗಾಯಾ ಅನಿ ವಾಳುನ್ ಗೆಲ್ಲಿ ಸಾತ್ ಕನ್ಸಾ ಮಟ್ಲ್ಯಾರ್, ಹ್ಯಾ ದೆಸಾತ್ ಸಾತ್ ವರಿಸ್ ಬರ್‍ಗಾಲ್ ಯೆತಲೊ ಹಾಯ್ ಮನುನ್ ದಾಕ್ವುನ್ ದಿತಾ, ಅನಿ ಬರ್‍ಯಾ ವರ್ಸಾಚ್ಯಾ ಮಾನಾ ಹಿ ಸಾತ್ ವರ್ಸಾ ಯೆತಾ. <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />ಅನಿ ಮಿಯಾ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಹೊತಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ದೆವಾನ್ ತುಮ್ಕಾ ಫಿಡೆ ಹೊತಲೆಚ್ ದಾಕ್ವುನ್ ದಿಲಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />ಆಯ್ಕ್ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಸಾತ್ ವರಿಸ್ ಸಾತ್ ವರಿಸ್ ಸೆತಾಭಾತಾತ್ನಿ ಬರೆ ಹೊತಾ.<verse eid="GEN 41:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 41:30" />ತೆಚ್ಯಾ ಮಾನಾ ಸಾತ್ ವರಿಸ್ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಬರ್‍ಗಾಲ್ ಯೆತಾ, ಅನಿ ಬರಿ ದಿಸಾ ಇಸ್ರುನ್ ಜಾತಾತ್, ಹ್ಯೊ ಬರ್‍ಗಾಲ್ ದೆಶ್ಯಾಕ್ ನಸ್ಟ್ ಕರ್ತಾ. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />ಬರ್‍ಯಾ ಪಿಕೆಚೊ ಎಳ್ ಫುರಾ ಇಸ್ರುನ್ ಜಾತಾ ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಯೆತಲೊ ಬರಗಾಲ್ ತವ್ಡೊ ಲೈ ಭಯಂಕರ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />ಹಿ ವಿಶಯ್ ಲಗ್ಗುನಾಚ್ ಕರ್ತಾ ಮನುನ್ ಘಟ್ ನಿರ್ದಾರ್ ಕರಲ್ಯಾ ಸಾಟ್ನಿ ದೆವಾನ್ ಫರೊಹಾ ರಾಜಾಕ್, ಎಕುಚ್ ವಿಶಯಾತ್ ದೊನ್ ಸಪ್ನಾ ದಿಲ್ಯಾನ್.<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />ತನ್ನಾ ತುಮಿ ಎಕ್ ಬುದ್ದ್ ಹೊತ್ತ್ಯಾಕ್ ಅನಿ ಶಾನ್ಯಾಕ್ ಎಕ್ಲ್ಯಾಕ್ ತುಮಿ ಹ್ಯಾ ದೆಸಾತ್ ಆಡಳಿತ್ ಅಧಿಕಾರಿ ಹೊವ್ನ್ ಎಚುನ್ ಕಾಡುಚೆ. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />ಬರೆ ಪಿಕ್ ಯೆಲ್ಲ್ಯಾ ಸಾತ್ ವರ್ಸಾತ್ನಿ ಪಾಂಚಾತ್ಲೊ ಎಕ್ ವಾಟೊ ತೆರ್ಗಿ ವಸುಲಿ ಗೊಳಾ ಕರುಕ್ ಎಕ್ ಅದಿಕಾರಿಕ್ ನೆಮುಚೆ. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />ಅನಿ ಫಿಡೆ ಯೆತಲ್ಯಾ ಬರ್ಯ್ಯಾ ವರ್ಸಾತ್ನಿ ಪುರಾ ದಾನೆ ಪರೊಹಾಚ್ಯಾ ಅದಿಕಾರ್‍ಹಾತ್ ಶಾರ್‍ಹಾತ್ನಿ ಗೊಳಾ ಕರುನ್ ರಾಕುನ್ ಥವ್ಕ್ ತೆಂಕಾ ಹುಕುಮ್ ದಿ. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />ತನ್ನಾ ಅಸೆ ದಾನೆ ಗೊಳಾ ಕರುನ್ ಥವ್ತಲ್ಯಾ ವೈನಾ ಇಜಿಪ್ತಾಚಿ ಲೊಕಾ ಯೆತಲ್ಯಾ ಸಾತ್ ಬರಗಾಲಾಚ್ಯಾ ವರ್ಸಾತ್ನಿ ಭುಕೆನ್ ಸತ್ತ್ಯಾ ನಾಸ್ ಹೊಯ್ನಾ ಸಾರ್ಕೆ ತೆಂಕಾ ಪೊಟಾಕ್ ದಿವ್ಕ್ ಹೊತಾ.<verse eid="GEN 41:36" /></para>
  <para style="s">ಜುಜೆ ಇಜಿಪ್ತಾಚೊ ರಾಜ್ಯಾಪಾಲ್ ಹೊಲ್ಲೊ</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />ಹಿ ಯೆವ್ಜನ್ ಫರೊಹಾ ರಾಜಾಕ್ ಅನಿ ತೆಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಅಧಿಕಾರಿಯಾಕ್ನಿ ಬರೆ ದಿಸ್ಲೆ. <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />ಮಾನಾ ಫರೊಹಾ ರಾಜ್ಯಾನ್ ತೆಂಕಾ, ಅಮಿ ದೆವಾಚೊ ಆತ್ಮೊ ಹೊತ್ತ್ಯಾ ಜುಜೆಕಿಂತಾ ಬರೊ ಮಾನುಸ್ ಕನ್ನಾಬಿ ಬಗ್ತಾಂವ್ ಕಾಯ್?. <verse eid="GEN 41:38" /><verse number="39" style="v" sid="GEN 41:39" />ಹೆಜ್ಯಾನ್ ಬರೊ ಮಾನುಸ್ ಅಮ್ಕಾ ಗಾವ್ತಾ ಕಾಯ್ ಮನುನ್ ಜುಜೆಕ್, ದೆವಾನ್ ತುಕಾ ಹೆ ಸಗ್ಳೆ ಕಳ್ವಲ್ಯಾ ಸಾಟ್ನಿ ತುಜ್ಯಾ ಸಮಾ ಬುದ್ದ್ ಹೊತ್ತೊ ಶಾನೊ ಮಾನುಸ್ ಕೊನ್ಬಿ ನಾ; <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />ತೆಚ್ಯಾ ವೈನಾ ಮಿಯಾ ತುಕಾ ಮಾಜ್ಯಾ ದೆಶಾಚೊ ಕರ್ಬಾರಿ ಕರ್ತಾ ಅನಿ ಮಾಜಿ ಫುರಾ ಲೊಕಾ ತುಜಿ ಹುಕುಮಾ ಆಯ್ಕ್ತಾತ್, ಸಿಂವಾಸನಾಚ್ಯಾ ವಿಶಯಾತ್ ತವ್ಡೊಚ್ ಮಿಯಾ ತುಜ್ಯಾನ್ಕಿ ಮೊಟೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" />ತನ್ನಾ ಫರೊಹಾ ರಾಜಾನ್ ಜುಜೆಕ್, “ಅತ್ತಾ ಮಿಯಾ ತುಕಾ ಇಜಿಪ್ತ್ ದೆಶಾಚೊ ರಾಜ್ಪಾಲ್ ಕರ್ತಾ” ಮನುನ್, <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />ರಾಜ್ಯಾನ್ ಅಪ್ಲ್ಯಾ ಬೊಟಾತ್ನಾ ರಾಜಾಚೊ ಛಪ್ಪೊ ಹೊತ್ತಿ ಮುದ್ದಿ ಕಾಡುನ್ ಜುಜೆಚ್ಯಾ ಬೊಟಾಕ್ ನೆಸ್ವುಲ್ಯಾನ್ ಅನಿ ಲೈಲನಾಚೊ ಝಗೊ ಅನಿ ಸೊನ್ಯಾಚೊ ಹಾರ್ ನೆಸ್ವುಲ್ಯಾನ್. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />ತೆನಿ ಜುಜೆಕ್ ಅಪ್ಲೊ ದೊನ್ವೊ ರಾಜ್ ರಥ್ ಫಿರುನ್ಕೆಳುಕ್ ದಿಲ್ಯಾನ್ , ಅನಿ ಗೌರವಾಕ್ ಸೆವಕಾ ಫಿಡೆ ಜಾವ್ನ್ ಡೊಗ್ಲಾಠೆಕುನ್ ನಮಸ್ಕಾರ್ ಕರಾ! ಮನುನ್ ಮೊಟ್ಯಾನ್ ಸಾಂಗ್ಲ್ಯಾನಿ, ಅಸೊ ಜುಜೆ ಇಜಿಪ್ತಾಚೊ ರಾಜ್ಯ್ ಪಾಲ್ ಹೊಲೊ. <verse eid="GEN 41:43" /><verse number="44" style="v" sid="GEN 41:44" />ಮಾನಾ ಫರೊಹಾ ರಾಜ್ಯಾನ್ ತೆಕಾ, “ತುಜೊ ಹುಕುಮ್ ನಸ್ತಾನಾ ಇಜಿಪ್ತಾಚೆ ಕೊನ್ಬಿ ಪಾಯ್ ಉಲ್ಕುಕ್ ಹೊಯ್ನಾ ಅನಿ ಪಾಯಾನ್ ಚಲುಕ್ಬಿ ಹೊಯ್ನಾ” ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಮಿಯಾ ಫರೊಹಾನ್ ರಾಜಾ ಮಾಜ್ಯಾ ಮನಾಕ್ ಯೆಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಕರ್ತಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />ಮಾನಾ ಜುಜೆಕ್ ಫರೊಹಾ ರಾಜಾನ್ ಇಜಿಪ್ತಾಚೆ ಸಫ್ನತ್ಪನ್ನೆಹ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್,</para>
  <para style="p" vid="GEN 41:45">ಅನಿ ಅಪ್ಲಿ ಲೆಕ್ ಆಸನತ್ ಮನ್ತಲಿ ವಾಂಗ್ಡಾ ಲಗಿನ್ ಕರ್ಲ್ಯಾನ್ ಜುಜೆನ್ ಇಜಿಪ್ತ್ ದೆಶಾವರ್‍ತಿ ಅಧಿಕಾರ್ ಶುರು ಕರ್ಲ್ಯಾನ್,<verse eid="GEN 41:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46" />ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಜುಜೆನ್ ಕಾಮ್ ಸುರು ಕರಲ್ಲ್ಯಾ ತನ್ನಾ ತಿಸ್ ವರ್ಸಾಚೊ ಹೊಲ್ಲೊ ರ್‍ಹಾತಾ, ತೆನಿ ಪರೊಹಾ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ನಾ ಜಾವ್ನ್ ಫುರಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾತ್ ಫಿರ್ಲ್ಯಾನ್.<verse eid="GEN 41:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 41:47" />ತ್ಯಾ ಸಾತ್ ವರ್ಸಾತ್ ಜಿಮ್ನಿ ವರ್‍ತಿ ಫಿಕ್ ಬರೆ ಹೊವ್ನ್ ಉತ್ಪನ್ ಹೊತಾ. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />ಜುಜೆನ್ ಇಜಿಪ್ತಾತ್ ತ್ಯಾ ಸಾತ್ ಬರ್‍ಯಾ ವರ್ಸಾತ್ನಿ ಶಹಾರಾಂಚ್ಯಾ ಅಜು ಭಾಜುಕ್ ಹೊತ್ತ್ಯಾ ಸೆತಾಂತ್ಲಿ ಫಿಕ್ ಗೊಳಾ ಕರುನ್ ಶಹಾರ್‍ಹಾತ್ನಿ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />ತೆ ಗೊಳಾ ಕರಲ್ಲೆ ದಾನೆ ಸಮದ್ರಾಚ್ಯಾ ರೆತಿಚ್ಯಾ ಸಾರ್ಕೆ ಲೈ ಹೊತಾನಾ ಜುಜೆನ್ ಮಾಪ್ತಲೆ ಸೊಡುನ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />ಬರ್ಗಾಲಾಚಿ ವರ್ಸಾ ಯೆವ್ಚ್ಯಾ ಪೈಲೆಚ್ ಒನ್ ಶಹಾರಾಚೊ ಯಾಜಕ್ ಪೊಟಿಫರಾಚಿ ಲೆಕ್ ಆಸಾನತ್ ಮನ್ತಲಿಕ್ನಾ ಜುಜೆಕ್ ದೊನ್ ಲೆಕಾ ಉಪಾಜಲ್ಲಿ. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />ಥೊರ್ಲೊ ಲೆಕ್ ಉಪಾಜಲ್ಲ್ಯಾ ತನ್ನಾ ದೆವಾನ್ ಮಾಜ್ಯಾ ತರಾಸಾಚ್ಯಾ ದೆಶ್ಯಾತ್ ಮಾಜ್ಯಾ ಬಾಬಾಚ್ಯಾ ಘರ್‍ಹಾತ್ಲ್ಯಾಕ್ನಿ ಇಸ್ರುಕ್ ಮಜತ್ ಕರ್ಲ್ಯಾನ್ ಮನುನ್ ತೆಕಾ, “ಮನಾಸ್ಸೆ” ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್. <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />ಅನಿ ದೊನ್ವೆಚೊ ಲೆಕ್ ಉಪಾಜಲ್ಲ್ಯಾ ತನ್ನಾ, ಮಾಕಾ ತರಾಸ್ ಹೊಲ್ಲ್ಯಾ ದೆಶಾತುಚ್ ದೆವಾನ್ ವಾಡ್ವಳ್ಕಿ ಕರ್ಲ್ಯಾನ್ ಮನುನ್ ತೆಕಾ ಎಫ್ರಾಯಿಮ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />ಉತ್ಪನಾಚೊ ಸಾತ್ ವರಿಸ್ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಸರುನ್ ಜಾತಾ. <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />ಮಾನಾ ಜುಜೆನ್ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆ ಬರ್ಗಾಲಾಚಿ ಸಾತ್ ವರ್ಸಾ ಶುರು ಹೊಲಿ ಬರ್‍ಗಾಲ್ ಅಜು ಭಾಜುಚ್ಯಾ ಸಗ್ಳ್ಯಾ ದೆಶ್ಯಾತ್ನಿಬಿ ಪಗಳ್ಳೊ, ಅನಿ ಇಜಿಪ್ತಾತಾತ್ ತವ್ಡೆಚ್ ಜೆವ್ನಾಕ್ ಹೊತ್ತೆ. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />ಸಗ್ಳ್ಯಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಕ್ ಬರ್‍ಗಾಲ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ ಲೊಕಾನಿ ಪರೊಹಾಕ್ಡೆ ಜೆವ್ನಾಕ್ ದಿ ಮನುನ್ ಮಾಗ್ಲ್ಯಾನಿ, ತನ್ನಾ ತೆನಿ ತೆಂಕಾ ಜುಜೆಕ್ಡೆ ಜಾವಾ, ಅನಿ ತೊ ಕಾಯ್ ಸಾಂಗ್ತಾ ತಸೆ ಕರಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 41:55" /><verse number="56" style="v" sid="GEN 41:56" />ಬರ್‍ಗಾಲ್ ಫುರಾ ದೆಶ್ಯಾತ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ ಜುಜೆನ್ ಗೊಳಾ ಕರುನ್ ಥವಲ್ಲೆ ದಾನೆ ಕಾಡುಕ್ ಲಾವ್ನ್ ಇಕಾತ್ ದಿಲ್ಯಾನ್ ಅನಿ ತ್ಯಾ ಎಳಾರ್ ಇಜಿಪ್ತಾತ್ ಬರ್‍ಗಾಲ್ ಲೈ ಹೊಲ್ಲೊ ಹೊತ್ತೊ. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />ಇಜಿಪ್ತಾತ್ ಬರ್‍ಗಾಲ್ ಲೈ ಹೊತ್ತೊ, ಸಗ್ಳ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಬರ್‍ಗಾಲ್ ಪಗಳಲ್ಲೊ ಹೊತ್ತ್ಯಾ ತನ್ನಾ ಜೊಸೆಪಾನ್ ಸಗ್ಳಿ ಕಳಂಜಾ ಕಾಡುನ್ ಇಜಿಪ್ತ್ ಕಾರಾಕ್ನಿ ಇಕಾತ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">ಜುಜೆಚಿ ಭಾವಾ ದಾನೆ ಇಕಾತ್ ಹಾನುಕ್ ಇಜಿಪ್ತಾಕ್ ಜಾತಾತ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />ಇಜಿಪ್ತಾತ್ ದಾನೆ ಗಾವ್ತಾತ್ ಮನ್ತಲಿ ಖಬರ್ ಜಾಕೊಬಾಕ್ ಕಳ್ತಾ, ತನ್ನಾ ತೆಂಚ್ಯಾ ಲೆಕಾಕ್ನಿ, “ತುಮಿ ಕಾಯ್ಬಿ ಕರುಕ್ ಹೊಯ್ನಾ ಕಾಯ್?” <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />ಅನಿ ತೆನಿ ತೆಂಕಾ, “ಇಜಿಪ್ತಾತ್ ದಾನೆ ಗಾವ್ತಾತ್ ಮನ್ತಲೆ ಮಿಯಾ ಆಯ್ಕ್ಲಾ, ಅಮಿ ಭುಕೆನ್ ಮರ್ತಲ್ಯಾ ಬದ್ಲಾಕ್ ಥೈ ಜಾವ್ನ್ ದಾನೆ ಹಾನಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 42:2" /><verse number="3" style="v" sid="GEN 42:3" />ಜುಜೆಚಿ ಧಾ ಜನಾ ಭಾವಾ ಮಿಳುನ್ ದಾನೆ ಹಾನುಕ್ ಮನುನ್ ಇಜಿಪ್ತಾ ದೆಸಾಕ್ ಗೆಲ್ಯಾನಿ. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />ಖರೆ ಜಾಕೊಬಾನ್ ಜುಜೆಚೊ ಭಾವ್ ಬೆಂಜ್ಯಾಮಿನಾಕ್ ಕಾಯ್ ತರ್ಬಿ ಹೊಯ್ಲ್ ಮನುನ್ ಬ್ಹಿಂವ್ನ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಧಾಡುಕ್ನಾ.<verse eid="GEN 42:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 42:5" />ಕಾನಾನ್ ದೆಸಾತ್ ಬರ್‍ಗಾಲ್ ಲೈ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ಜಾಕೊಬಾಚಿ ಲೆಕಾ ಹುರಲ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ದಾನೆ ಇಕಾತ್ ಘೆವ್ಕ್ ಇಜಿಪ್ತಾಕ್ ಗೆಲ್ಯಾನಿ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಸಗ್ಳ್ಯಾ ಕಾನಾನಾತ್ ಲೈ ಬರ್‍ಗಾಲ್ ಯೆಲ್ಲೊ ಹೊತ್ತೊ.<verse eid="GEN 42:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />ತನ್ನಾ ಜುಜೆ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾತ್ ರಾಜ್ವಡ್ಕಿ ಚಾಲ್ವಿತ್ ಲೊಕಾಕ್ನಿ ದಾನೆ ಇಕಾತ್ ದಿಯ್ತ್ ರ್‍ಹಾತಾ, ತನ್ನಾ ಜುಜೆಚಿ ಭಾವಾನಿ ಯೆವ್ನ್ ಅಪ್ಲಿ ತೊಂಡಾ ಜಿಮ್ನಿಕ್ ಲಾಗಿ ಪತರ್ ಬಾಗುನ್ ನಮಸ್ಕಾರ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />ಅಪ್ನಾಚ್ಯಾ ಭಾವಾಕ್ನಿ ಬಗ್ತಾನಾ ತೆಕಾ ತೆಂಚಿ ವಳಕ್ ಗಾವ್ತಾ,</para>
  <para style="q1" vid="GEN 42:7">ಖರೆ ಕಾಯ್ಬಿ ಕಳುಕ್ನಸಲ್ಯಾ ಗತಿನ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಭಿರ್ಸಾನ್ ಬೊಲುನ್, “ತುಮಿ ಖೈತ್ನಾ ಯೆಲ್ಯಾಸಿ?” ಮನ್ತಾ ತನ್ನಾ ತೆನಿ ತೆಕಾ,</para>
  <para style="q2" vid="GEN 42:7">“ಅಮಿ ಕಾನಾನ್ ದೆಸಾತ್ನಾ ದಾನೆ ನೆವ್ಕ್ ಮನುನ್ ಯೆಲ್ಯಾಂವ್” ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />ಜುಜೆ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ನಿ ವಳಕ್ತಾ, ಖರೆ ತೆನಿ ವಳ್ಕಿ ನಾತ್. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />ಜುಜೆನ್ ಅಪ್ನಾಚ್ಯಾ ಸಪ್ನಾಂಚಿ ಅನಿ ಭಾವಾಂಚ್ಯಾ ವಿಶಯಾತ್ ಯಾದ್ ಕರುನ್ ತೆಂಕಾ, “ತುಮಿ ದಾನೆ ನೆವ್ಕ್ ಮನುನ್ ಯೆವ್ಕ್ ನ್ಯಾಸಿ, ತುಮಿ ಗುಡಾಚಾರಿ, ಅಮ್ಚ್ಯಾ ದೆಸಾತ್ ಬಳ್ ನಸಲ್ಲ್ಯಾ ಜಾಗೆ ಹುಡ್ಕುಕ್ ಬಗುನ್ ಜಾವ್ಚೆ ಮನುನ್ ಯೆಲ್ಯಾಸಿ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />ತನ್ನಾ ತೆಕಾ, “ನಾ! ಸಾಯ್ಬಾ, ಅಮಿ ದಾನೆ ನೆವ್ಕ್ ಮನುನ್ ಯೆಲ್ಲಿ ಸೆವಕಾ” ಮಟ್ಲ್ಯಾನಿ. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />ಅಮಿ ಸಗ್ಳಿ ಎಕುಚ್ ಬಾಬಾಜಿ ಲೆಕಾ, ಅನಿ ಅಮಿ ಪ್ರಾಮಾನಿಕ್ ಮಾನ್ಸಾ ಅಮಿ ಹುಡ್ಕುಕ್ ಯೆಲ್ಲೆ ನೈ ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />ಮಾನಾ ಜುಜೆನ್ ತೆಂಕಾ, “ನಾ ತುಮಿ ಹ್ಯಾ ದೆಶಾಚೆ ಬಳ್ ನಸಲ್ಲೆ ಜಾಗೆ ಹುಡ್ಕುಕ್ ಯೆಲ್ಯಾಸಿ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />ತನ್ನಾ ತೆನಿ, “ತುಜಿ ಸೆವಕಾ, ಅಮಿ ಬಾರಾ ಜನಾ ಭಾವಾ, ಅನಿ ಕಾನಾನಾತ್ ಹೊತ್ತ್ಯಾ ಎಕುಚ್ ಬಾಬಾಚಿ ಲೆಕಾ ಅನಿ ಅಮ್ಚೊ ಧಾಕ್ಲೊ ಭಾವ್ ಅಮ್ಚ್ಯಾ ಬಾಬಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಹಾಯ್, ಅನಿ ಎಕ್ಲೊ ಭಾವ್ ಹೊತ್ತೊ ತೊ ಮರುನ್ ಗೆಲಾ” ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />ಜುಜೆನ್ ನಾ, ತುಮಿ ಗುಡಾಚಾರಿಯಾಚ್, <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />ತುಮಿ ಸಾಂಗ್ತಲೆ ಖರೆ ಹೊಲ್ಲೆ ರಾಲ್ಯಾರ್, ಜಾವ್ನ್ ತುಮ್ಚ್ಯಾ ಧಾಕ್ಲ್ಯಾ ಭಾವಾಕ್ ಬಲ್ವುನ್ ಹಾನಾ, ತೆಕಾ ಹಾನಿ ಪತರ್ ತುಮಿ ಖೈಬಿ ಜಾವನೈ ಮನುನ್ ಫರೊನ್ ರಾಜ್ಯಾಚೊ ಶಪತ್ ಹಾಯ್, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />ತುಮ್ಚ್ಯಾತ್ಲೊ ಎಕ್ಲೊ ಜಾವ್ನ್ ತೆಕಾ ಹಾನಿ ಪತರ್ ಹುರಲ್ಲೆ ತುಮಿ ಬಂಧಿಖಾನ್ಯಾತ್ ರಾವಾ, ತನ್ನಾ ತುಮಿ ಸಾಂಗ್ತಲೆ ಖರೆ ಕಾಯ್ ಝುಟೆ ಮನುನ್ ಕಳ್ತಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />ತಸೆ ಹೊವ್ನ್ ಜುಜೆನ್ ತೆಂಕಾ ತಿನ್ ದಿಸ್ ಪತರ್ ಭಂದಿಖಾನ್ಯಾತ್ ಥವ್ಲ್ಯಾನ್.<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />ತಿನ್ ದಿಸಾ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಜುಜೆನ್ ತೆಂಕಾ, ಮಿಯಾ ದೆವಾಕ್ ಭಿಂವ್ತಲೊ ಮಾನುಸ್, ಅನಿ ಮಿಯಾ ತುಮ್ಕಾ ಎಕ್ ಕರಾರ್ ಕರುನ್ ಸುಟ್ಕಾ ಕರ್ತಾ, <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />ಅನಿ ತುಮಿ ಪ್ರಾಮಾನಿಕ್ ಮನುನ್ ಖರೆ ಕರುಕ್ ಸಾಟ್ನಿ ತುಮ್ಚ್ಯಾತ್ಲೊ ಎಕ್ಲೊ ಭಾವ್ ಬಂಧಿಖಾನ್ಯಾತ್ ರಾಂವ್ದಿತ್, ಅನಿ ಹುರಲ್ಲೆ ತುಮಿ ಇಕಾತ್ ಘೆಟಲ್ಲೆ ದಾನೆ ನೆವ್ನ್ ಭುಕೆನ್ ಮರುಲಾಗಲ್ಯಾ ತುಮ್ಚ್ಯಾ ಕುಟ್ಮಾಕ್ನಿ ದಿವಾ, <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />ಅನಿ ತುಮ್ಚ್ಯಾ ಧಾಕ್ಲ್ಯಾ ಭಾವಾಕ್ ಮಾಜ್ಯಾ ಸಾಟ್ನಿ ಬಲ್ವುನ್ ಹಾನಾ, ತನ್ನಾ ತುಮಿ ಖರೆ ಸಾಂಗುಲ್ಲ್ಯಾಸಿ ಮನುನ್ ಮಿಯಾ ಒಪ್ತಾ ಅನಿ ತುಮ್ಕಾ ಮರ್‍ನಾಕ್ ಗುರಿ ಕರಿನಾ, ಮಟ್ಲ್ಯಾನ್, ತ್ಯಾ ಭಾವಾನಿ ತೆಚ್ಯಾ ಗೊಸ್ಟಿಕ್ ಒಪ್ಲ್ಯಾನಿ. <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />ತನ್ನಾ ತ್ಯಾ ಭಾವಾನಿ ಎಕಾಮೆಕಾತ್ನಿ, “ಅಮಿ ಅಮ್ಚ್ಯಾ ಭಾವ್ ಜುಜೆಚ್ಯಾ ವರ್‍ತಿ ಕರಲ್ಲ್ಯಾ ಪಾಪಾಕ್ ಅತ್ತಾ ತರಾಸಾತ್ ಹಾತ್, ತನ್ನಾ ಅಮಿ ದಿತಲ್ಯಾ ತರಾಸಾಕ್ ತೆನಿ ಸೊಡಾ ಮನುನ್ ಮಾಗುನ್ ಘೆತಾನಾ ತೆಕಾ ಸೊಡುಕ್ನಾವ್, ತೆಚ್ಯಾ ವೈನಾ ಅಮ್ಕಾ ಅತ್ತಾ ಹ್ಯೊ ತರಾಸ್” ಮನುನ್ ಬೊಲುನ್ ಘೆಟ್ಲ್ಯಾನಿ. <verse eid="GEN 42:21" /><verse number="22" style="v" sid="GEN 42:22" />ತನ್ನಾ ರುಬೆನಾನ್ ತೆಂಕಾ, “ತ್ಯಾ ಝಿಲ್ಗ್ಯಾಚ್ಯಾ ವಿರೊದ್ ಕಾಯ್ಬಿ ಕರುನಕಾಸಿ ಮನುನ್ ಸಾಂಗುಕ್ ನತ್ತೊ ಕಾಯ್? ಮಾಜಿ ಗೊಸ್ಟ್ ತುಮಿ ಆಯ್ಕುಕ್ನಾಸಿ, ಅನಿ ಅತ್ತಾ ತೆಚ್ಯಾ ಮರ್‍ನಾಕ್ ಅಮ್ಕಾ ಹಿ ಶಿಕ್ಷ್ಯಾ ಹೊವ್ಲಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />ತೆನಿ ಬೊಲ್ತಲೆ ಜುಜೆಕ್ ಅರ್ಥ್ ಅನಿ ಬೊಲುಕ್ಬಿ ಹೊಯ್ ತೆ ತೆಚ್ಯಾ ಭಾವಾಕ್ನಿ ಕಳುಕ್ನಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೊ ಕಳಿನಾ ಸಾರ್ಕೆ ಕರುನ್ ದೊನ್ ಭಾಶಾ ಬೊಲ್ತಲ್ಯಾಚ್ಯಾ ವೈನಾ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲಿತ್ ಹೊತ್ತೊ. <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />ಅನಿ ಜುಜೆಕ್ ತೆನಿ ಬೊಲ್ತಲೆ ಬೊಲ್ನೆ ಆಯ್ಕುನ್ ಲೈ ದುಕ್ಕ್ ಹೊವ್ನ್ ತೆನಿ ಹೊತ್ತ್ಯಾಕ್ನಾ ಕಡೆಕ್ ಜಾವ್ನ್ ರಡುನ್ ಮಾನಾ, ಭಾವ್ ಸಿಮಿಯೊನಾಕ್ ತೆಂಚ್ಯಾ ಡೊಳಾಚ್ಯಾ ಇದ್ರಾಕುಚ್ ಬಂಧಿ ಕರ್ಲ್ಯಾನ್.<verse eid="GEN 42:24" /></para>
  <para style="s">ಜುಜೆಚಿ ಭಾವಾ ಕಾನಾನಾಕ್ ಪರ್‍ತುನ್ ಯೆತಲೆ</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />ಮಾನಾ ಜುಜೆನ್ ಅಪ್ಲ್ಯಾ ಸೆವಕಾಕ್ನಿ, “ಅಪ್ಲ್ಯಾ ಭಾವಾಂಚ್ಯಾ ಪಿಸ್ವಿಯಾತ್ನಿ ದಾನೆ ಅನಿ ಹರ್ ಎಕ್ಲ್ಯಾಚೆ ಪೈಸೆಬಿ ಪರ್‍ತುನ್ ತೆಂಚ್ಯಾ ಚಿಲಾತ್ನಿ ಥವಾ ಅನಿ ತೆಂಕಾ ವಾಟೆರ್ ಪಾಜೆ ಹೊಲ್ಲೆ ಜೆವಾನ್ ಬಿ ದಿವ್ನ್ ಧಾಡಾ” ಮನುನ್ ಹುಕುಮ್ ದಿತಾನಾ, ತೆನಿ ತಸೆಚ್ ಕರ್ಲ್ಯಾನಿ, <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />ಹೆಚ್ಯಾ ಮಾನಾ ತ್ಯಾ ಭಾವಾನಿ ಗಾಡ್ವಾಂಚ್ಯಾ ವರ್‍ತಿ ಸಗ್ಳಿ ಸಾಮಾನಾ ವಾವುನ್ ಘೆವ್ನ್ ಗೆಲ್ಯಾನಿ. <verse eid="GEN 42:26" /><verse number="27" style="v" sid="GEN 42:27" />ತಿ ಭಾವಾ ತ್ಯಾ ರಾತ್ತಿನ್ ಎಕ್ ಜಾಗ್ಯಾರ್ ವಸ್ತಿ ರ್‍ಹಾತ್ಯಾತ್, ತೆಂಚ್ಯಾತ್ಲ್ಯಾ ಎಕ್ಲ್ಯಾನ್ ಗಾಡ್ವಾಕ್ನಿ ಪೊಟಾಕ್ ದಿವ್ಚೆ ಮನುನ್ ಪಿಸ್ವಿ ಸೊಡ್ಸುನ್ ಬಗ್ತಾನಾ, ತ್ಯಾ ಪಿಸ್ವಿತ್ ತೆನಿ ದಾನ್ಯಾಕ್ನಿ ದಿಲ್ಲೆ ಪೈಸೆ ರ್‍ಹಾತಾ. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />ಮಾನಾ ತೆನಿ ಹುರಲ್ಯಾ ಭಾವಾಕ್ನಿ ದಾಕ್ವುನ್, “ಹಿತ್ತೆ ಬಗಾ ಮಿಯಾ ದಾನ್ಯಾಕ್ನಿ ದಿಲ್ಲೆ ಪೈಸೆ ಪಿಸ್ವಿತ್ ಹಾಯ್” ಮಟ್ಲ್ಯಾನ್, “ದೆವ್ ಅಮ್ಕಾ ಅಸೆ ಕಾಯ್ ಕರುಲ್ಲಾ?” ಮನುನ್ ಎಕಾಮೆಕಾತ್ನಿ ಬೊಲುನ್ ಘೆಟ್ಲ್ಯಾನಿ.<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />ತೆನಿ ಕಾನಾನ್ ದೆಸಾಕ್ ಪಾವ್ನ್ ಅಪ್ಲೊ ಬಾಬಾ ಜಾಕೊಬಾಕ್ ಹೊಲ್ಲಿ ಸಂಗ್ತಿಯಾ ಸಾಂಗುನ್, <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />ಅಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ತ್ಯಾ ದೆಶಾಚ್ಯಾ ರಾಜ್ಯಪಾಲಾನ್, ಅಮಿ ಗುಡಾಚಾರಿಯಾ ಮನುನ್ ಲೈ ಕಠಿನ್ ಬೊಲ್ಲ್ಯಾನ್.<verse eid="GEN 42:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 42:31" />ತನ್ನಾ ಅಮಿ ತೆಕಾ, “ಅಮಿ ಗುಡಾಚಾರಿಯಾ ನ್ಹಯ್ ಅಮಿ ಪ್ರಾಮಾನಿಕ್ ಲೊಕಾ” ಮಟ್ಲಾಂವ್. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />ಅಮಿ ಎಕುಚ್ ಬಾಬಾಚಿ ಪೊರಾ ಬಾರಾ ಜನಾ ಭಾವಾ ಅನಿ ಅಮ್ಚ್ಯಾತ್ ಎಕ್ಲೊ ಭಾವ್ ಮರುನ್ ಗೆಲಾ, ಅನಿ ಧಾಕ್ಲೊ ಕಾನಾನಾತ್ ಬಾಬಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಹಾಯ್ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾಂವ್. <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />ಅಮಿ ತೆಸೆ ಮನ್ತಾನಾ, ತ್ಯಾ ದೆಶಾಚ್ಯಾ ರಾಜ್ಯಪಾಲಾನ್ ತುಮಿ ಪ್ರಾಮಾನಿಕ್ ಹೊವ್ನ್ ಹಾಸಿ ಮನುನ್ ಮಾಕಾ ಕಳುಚೆ ಹೊಲ್ಯಾರ್, ತುಮ್ಚ್ಯಾತ್ ಎಕ್ ಭಾವಾಕ್ ಹಿತ್ತೆ ಅಮ್ಚ್ಯಾಕ್ಡೆ ಸೊಡುನ್ ಜಾವ್ನ್ ಭುಕೆನ್ ಹೊತ್ತ್ಯಾ ತುಮ್ಚ್ಯಾ ಕುಟ್ಮಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ದಾನೆ ದಿವಾ. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />ಅನಿ ತುಮ್ಚ್ಯಾ ಧಾಕ್ಲ್ಯಾ ಭಾವಾಕ್ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಯೆವಾ, ತನ್ನಾ ತುಮಿ ಗುಡಾಚಾರಿಯಾಕಿ ಪ್ರಾಮಾನಿಕ್ ಮನುನ್ ಕಳ್ತಾ, ಮಾನಾ ತುಮಿ ಖರೆ ಸಾಂಗಲ್ಲೆ ಹೊಲ್ಯಾರ್ ತುಮ್ಚ್ಯಾ ಭಾವಾಕ್ ಸೊಡ್ತಾ ಅನಿ ತುಮಿ ದಾನೆ ಘೆವ್ನ್ ಆರಾಮಾನ್ ಜಾವ್ಕ್ ಹೊತಾ, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್, ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />ಮಾನಾ ತೆನಿ ಸಗ್ಳ್ಯಾ ಭಾವಾನಿ ದಾನೆ ಕಾಡುಕ್ ಮನುನ್ ಅಪ್ಲಿ ಚಿಲಾ ಸೊಡಸಲ್ಲ್ಯಾ ತನ್ನಾ ದಾನ್ಯಾಂಚ್ಯಾ ಸಾಟ್ನಿ ದಿಲ್ಲೆ ಪೈಸೆ ಹೊತ್ತೆ ಬಗುನ್ ತೆಂಚೊ ಬಾಬಾ ಜಾಕೊಬ್ ಅನಿ ತೆನಿ ಸಗ್ಳೆಬಿ ಲೈ ಭಿಂಯಾಲೆ. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />ಮಾನಾ ಜಾಕೊಬಾನ್ ಅಪ್ಲ್ಯಾ ಲೆಕಾಕ್ನಿ, “ಮಿಯಾ ಮಾಜ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೆಕಾಕ್ನಿ ನಾ ಕರುನ್ ಘೆವ್ಚೆ ಮನುನ್ ಕರ್ಲ್ಯಾಸಿ ಕಾಯ್? ಜುಜೆ ನಾ ಹೊಲೊ, ಅನಿ ಸಿಮೊನ್ಬಿ ನಾ ಹೊಲೊ ಅತ್ತಾ ಬೆಂಜ್ಯಾಮಿನಾಕ್ಬಿ ಘೆವ್ನ್ ಜಾವ್ಚೆ ಮನುನ್ ಕರ್ಲ್ಯಾಸಿ ಕಾಯ್” ಮಿಯಾ ಎಕ್ ದುಕ್ಕಿ ಮಾನುಸ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />ಮಾಜ್ಯಾ ಲೆಕಾಕ್ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಧಾಡುನ್ ದಿ ನಾ ಮಟ್ಲ್ಯಾನ್, ತನ್ನಾ ಮಾನಾ ರುಬೆನಾನ್ ಅಪ್ಲ್ಯಾ ಬಾಬಾಕ್, “ಬಾಬಾ, ಮಾಜೆ ವರ್‍ತಿ ವಿಶ್ವಾಸ್ ಕರ್, ಮಿಯಾ ಬೆಂಜ್ಯಾಮಿನಾಕ್ ತುಜೆಕ್ಡೆ ಬಲ್ವುನ್ ಹಾನ್ತಾ, ಮಿಯಾ ತೆಕಾ ಬಲ್ವುನ್ ಹಾನಿ ನಸ್ಲ್ಯಾರ್ ತಿಯಾ ಮಾಜ್ಯಾ ದೊನಿ ಲೆಕಾಕ್ನಿ ಜಿವಾನಿ ಮಾರ್”, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />ತನ್ನಾ ಜಾಕೊಬಾನ್, ಮಿಯಾ ಬೆನ್ಯಾಮಿನಾಕ್ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಧಾಡಿನಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯರ್ ತೆಚೊ ಭಾವ್ ಮರುನ್ ಗೆಲೊ, ಅತ್ತಾ ಮಾಕಾ ಮಾಜಿ ಬಾಯ್ಕೊ ರಾಹೆಲಾಚ್ಯಾ ಪೊಟಾತ್ ಜಲಮಲ್ಲೊ ಹ್ಯೊ ಎಕುಚ್ ಲೆಕ್ ಹುರ್ಲಾ, ತುಮಿ ಪರ್ಯಾನ್ ಕರುನ್ ಜಾತಾನಾ ತೆಕಾ ಕಾಯ್ಬಿ ಹೊಲ್ಯಾರ್, ಮಿಯಾ ಪಿಕ್ಕ್ಯಾ ಟಕ್ಲ್ಯಾಚೊ ಮ್ಹಾತಾರೊ ಮಾನುಸ್ ದುಕ್ಕ್ ಕರುನ್ ಘೆವ್ನ್ ಮರುನ್ ಜಾವ್ಕ್ ತುಮಿಚ್ ಕಾರನ್ ಹೊತ್ಯಾಸಿ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">ಜುಜೆಚಿ ಭಾವಾ ಬೆಂಜ್ಯಾಮಿನಾಕ್ ಘೆವ್ನ್ ಇಜಿಪ್ತಾಕ್ ಗೆಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />ಕಾನಾನ್ ದೆಸಾತ್ ಬರ್‍ಗಾಲ್ ಲೈ ಕಟಿನ್ ಹೊವ್ನ್ ಹೊತ್ತೊ. <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />ಅನಿ ಜಾಕೊಬಾಚ್ಯಾ ಲೆಕಾನಿ ಹಾನಲ್ಲೆ ದಾನೆ ತೆಚ್ಯಾ ಕುಟ್ಮಾಚ್ಯಾ ಲೊಕಾನಿ ಖಾವ್ನ್ ಸರ್ಲೆ, ಜಾಕೊಬಾನ್, ಜಾವಾ ಅನಿ ಜೆವ್ನಾಕ್ ದಾನೆ ಇಕಾತ್ ಹಾನಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />ಜುದಾನ್ ತೆಕಾ, ತ್ಯಾ ದೆಶಾಚ್ಯಾ ರಾಜ್ಯಪಾಲಾನ್ ಅಮ್ಕಾ ತುಮ್ಚ್ಯಾ ಭಾವಾಕ್ ಹಾನಿ ನಸ್ತಾನಾ ಮಾಜೆ ತೊಂಡ್ ಬಗುಕ್ ಯೆವ್ನಕಾಸಿ, ಮನುನ್ ಹುರ್ಶಾಕಿ ದಿಲಾ, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />ಅನಿ ತಿಯಾ ಅಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೆನ್ಯಾಮಿನಾಕ್ ಧಾಡುನ್ ದಿಲ್ಯಾರ್, ಅಮಿ ಜಾವ್ನ್ ದಾನೆ ಹಾನ್ತ್ಯಾಂವ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />ಖರೆ ಬೆನ್ಯಾಮಿನಾಕ್ ಅಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಧಾಡುನ್ ದಿಯ್ನಸ್ಲ್ಯಾಲ್ಯಾರ್ ಅಮಿ ಜಾವ್ನ್ ದಾನೆ ಹಾನಿನಾವ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೆನಿ ಬೆನ್ಯಾಮಿನಾಕ್ ಬಲ್ವುನ್ ಹಾನಿನಸ್ತಾನಾ ತುಮ್ಚೆ ತೊಂಡ್ ದಾಕ್ವುನಕಾಸಿ ಮನುನ್ ಹುರ್ಶಾಕಿ ದಿಲಾ, ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />ತೆ ಆಯ್ಕುನ್ ಇಜ್ರಾಯೆಲಾನ್, “ಅಮ್ಕಾ ಅನಿ ಎಕ್ ಭಾವ್ ಹಾಯ್ ಮನುನ್ ತ್ಯಾ ಮಾನ್ಸಾಕ್ ಸಾಂಗುನ್ ಮಾಕಾ ಕಶ್ಯಾಕ್ ಲೈ ತರಾಸ್ ದಿವ್ಲ್ಯಾಸಿ?” ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />ತ್ಯಾ ಮಾನ್ಸಾನ್ ಅಮ್ಚ್ಯಾ ಕುಟ್ಮಾಂಚ್ಯಾ ವಿಶಯಾತ್ ಕಳ್ವುನ್ ಘೆವ್ಕ್ ಮನುನ್ ಅಮ್ಕಾ ಬರೆ ಕರುನುಚ್, ತುಮ್ಚ್ಯಾ ಘರ್‍ಹಾತ್ ತುಮ್ಚೊ ಬಾಬಾ ಅಜುನಿ ಜಿವಾನ್ ಹಾಯ್ ಕಾಯ್? ಅನಿ ತುಮ್ಕಾ ಎಕ್ ಭಾವ್ ಹಾಯ್ ಕಾಯ್ ? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ, ತನ್ನಾ ಅಮಿ ತೆಕಾ ಹೊತ್ತೆ ಖರೆ ಸಾಂಗ್ಲಾವ್, ಅಮ್ಕಾ ತೊ ಅಮ್ಚ್ಯಾ ಭಾವಾಕ್ ಬಲ್ವುನ್ ಹಾನುಕ್ ಸಾಂಗ್ತಾ ಮನುನ್ ಗೊತ್ತ್ ನತ್ತೆ ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />ಮಾನಾ ಜುದಾನ್ ಅಪ್ಲ್ಯಾ ಬಾಬಾಕ್, ಅಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೆಂಜ್ಯಾಮಿನಾಕ್ ಧಾಡುನ್ ದಿ, ಅಮಿ ತೆಕಾ ಬಗುನ್ ಘೆತಾಂವ್, ಅನಿ ಅಮಿ ಇಜಿಪ್ತಾಕ್ ಜಾವ್ನ್ ದಾನೆ ಹಾನಿ ನಸ್ಲ್ಯಾರ್, ತಿಯಾ, ಅಮಿ ಅನಿ ಅಮ್ಚಿ ಪೊರಾ ಮರುನ್ ಜಾತಾಂವ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />ತೆಕಾ ಕಾಯ್ ಹೊಯ್ನಾ ಸಾರ್ಕೆ ಬಗ್ತಲಿ ಮಾಜಿ ಜವಾಬ್ದಾರಿ, ಮಾಜೊ ಜಿವ್ ಆಡು ಥವ್ನ್ ತರಿಬಿ ತೆಕಾ ಮಿಯಾ ಬೆರೆ ಕರುನ್ ಬಗುನ್ ಘೆತಾ, ಅನಿ ಮಿಯಾ ತೆಕಾ ಪರ್‍ತುನ್ ತುಜಾಕ್ಡೆ ಬಲ್ವುನ್ ಹಾನಿನಸ್ಲ್ಯಾರ್, ತುಜೊ ಶಾಪ್ ಮಾಜೆ ವರ್‍ತಿ ಕನ್ನಾಬಿ ರಾಂವ್ದಿತ್. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಅಮಿ ತುಕಾ ಲೈ ಎಳ್ ರಾಕುಕ್ ಲಾಯ್ನಾವ್, ತಿಯಾ ಅಮ್ಕಾ ಅದ್ದಿಚ್ ಧಾಡುನ್ ದಿಲ್ಲೆ ರಾಲ್ಯಾರ್ ಅತ್ತಾ ಪತರ್ ದೊನ್ದಾ ಜಾವ್ನ್ ಯೆಯ್ ಹೊತ್ತಾಂವ್, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />ತೆಂಚೊ ಬಾಬಾ ಜಾಕೊಬಾನ್, ತುಮಿ ಸಾಂಗ್ತಲೆ ಖರೆ ಹೊಲ್ಲೆ ರಾಲ್ಯಾರ್ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೆನ್ಯಾಮಿನಾಕ್ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಜಾವಾ, ಅನಿ ತ್ಯಾ ರಾಜ್ಯಪಾಲಾಕ್ ಮನುನ್ ಅಮ್ಚ್ಯಾ ದೆಸಾತ್ ಗಾವ್ತಲಿ ಬರಿ ಆಯಾರಾ ಬರ್‍ಯಾವಾಸೆಚೆ ತೆಲ್, ಮಾವ್, ರಗ್ತ್ ಬೊಳ್, ಗೊಡ್ಲೆ ಅಂಟ್, ಅನಿ ಮಸಾಲೆ, ಪಿಸ್ತಾ, ಬಾದಾಮ್ ಕಾಜು ಬಿಂಯ್ಯಾ ಘೆವ್ನ್ ಜಾವಾ. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />ಅನಿ ಅತ್ತಾ ಜಾತಾನಾ ದೊನ್ ಪಟ್ಟ್ ಪೈಸೆ ಘೆವ್ನ್ ಜಾವಾ, ಅದ್ಲ್ಯಾ ಪಟಿಚೆ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಪರ್‍ತುನ್ ಯೆಲ್ಲೆ ಪೈಸೆಬಿ ಘೆವ್ನ್ ಜಾವಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ರಾಜ್ಯ್ ಪಾಲಾನ್ ಚುಕುನ್ ತೆ ದಿಲಾಕಿ ಕಾಯ್ಕಿ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />ಅನಿ ಬೆನ್ಯಾಮಿನಾಕ್ಬಿ ಘೆವ್ನ್ ಜಾವಾ, ಸಗ್ಳೆಬಿ ಯೆಗ್ದಾಚ್ ಪರ್‍ತುನ್ ಯೆವಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />ಮಾನಾ ತುಮಿ ತ್ಯಾ ಮಾನ್ಸಾಚ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆ ಹೊತ್ತ್ಯಾ ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ತುಮ್ಕಾ ಮಜತ್ ಕರುಂದಿತ್ ಅನಿ ತೆಚಿ ದಯಾ ತುಮ್ಚೆ ವರ್‍ತಿ ಯೆಂವ್ದಿತ್ ಸಿಮಿಯೊನಾಕ್ ಅನಿ ಬೆಂಜ್ಯಾಮಿನಾಕ್ ತೊ ಧಾಡುನ್ ದಿಂವ್ದಿತ್ ಮನುನ್ ಮಿಯಾ ಮಾಗ್ನಿ ಕರ್ತಾ, ನಾತರ್, ಅನಿಬಿ ಮಿಯಾ ಮಾಜ್ಯಾ ಲೆಕಾಕ್ ನಾ ಕರುನ್ ಘೆವ್ನ್ ಲೈ ದುಕ್ಕಾತ್ ರ್‍ಹಾತಾ, ಮಿಯಾ ಲೆಕಾಕ್ನಿ ಕಳ್ದುನ್ ಘೆವ್ನ್ ರಾತಲೊ ಹೊಲ್ಯಾರ್ ತಸೆಚ್ ಹೊಂವ್ದಿತ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />ತೆಚ್ಯಾ ವೈನಾ ರಾಜ್ಯ್ ಪಾಲಾಕ್ ಮನುನ್ ದಿವ್ಕ್ ಆಯಾರಾ ಘೆವ್ನ್; ಅದ್ದಿ ಗೆಲ್ಲ್ಯಾ ತನ್ನಾ ನೆಲ್ಲ್ಯಾ ಕಿಂತಾ ದೊನ್‍ಪಟ್ ಪೈಸೆ ಅನಿ ಬೆಂಜ್ಯಾಮಿನಾಕ್ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಗೆಲ್ಯಾನಿ,<verse eid="GEN 43:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 43:16" />ಜುಜೆನ್ ಅಪ್ಲೊ ಭಾವ್ ಬೆಂಜ್ಯಾಮಿನ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಯೆತಲೊ ಬಗುನ್ ಅಪ್ಲೆ ಘರ್ ಬಗುನ್ ಘೆತಲ್ಯಾ ಸೆವಕಾಕ್, ಹ್ಯಾ ಲೊಕಾಕ್ನಿ ಮಾಜ್ಯಾ ಘರಾಕ್ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಜಾ; ತೆನಿ ದೊಪಾರ್ಚೆ ಅಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಾಂಸಾಚೆ ಜೆವಾನ್ ಕರುಂದಿತ್, ತೆಚ್ಯಾ ಸಾಟ್ನಿ ಜನಾವರ್ ಮಾರುನ್ ಮಾಂಸ್ ಕರುನ್ ರಾಂದಾಪ್ ಕರಾ, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />ಜುಜೆನ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾಸಾರ್ಕೆ ಸೆವಕಾನಿ ತೆಚ್ಯಾ ಭಾವಾಕ್ನಿ ಘರ್‍ಹಾತ್ ಬಲ್ವುನ್ ನೆಲ್ಯಾನ್.<verse eid="GEN 43:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 43:18" />ತೆಂಕಾ ಘರಾಕ್ ಘೆವ್ನ್ ಗೆಲ್ಲ್ಯಾಸಾಟ್ನಿ ತೆನಿ ಫಾಟ್ಲ್ಯಾ ಪಟಿ ಅಮ್ಚ್ಯಾ ಪಿಸ್ವಿಯಾತ್ನಿ ಪೈಸೆ ಪರ್‍ತುನ್ ಗೆಲ್ಲ್ಯಾ ವೈನಾ ಅಮ್ಕಾ ಹಿತ್ತೆ ಬಲ್ವುನ್ ಅನಿ ಅಮ್ಚ್ಯಾ ಗಾಡ್ವಾಕ್ನಿ ಕಾಡುನ್ಗೆವ್ನ್, ಅಮ್ಕಾ ಗುಲಾಮ್ ಕರುನ್ ಘೆತಾತ್ ಮನುನ್ ಬೊಲುನ್ ಘೆವ್ನ್ ಲೈ ಭಿಂವ್ಲ್ಯಾನಿ. <verse eid="GEN 43:18" /><verse number="19" style="v" sid="GEN 43:19" />ತಸೆ ಹೊವ್ನ್ ತೆನಿ ಜುಜೆಚ್ಯಾ ಘರ್ ರಾಕ್ವಾಲಿ ಹೊವ್ನ್ ದಾರಾಕ್ಡೆ ರ್‍ಹಾತಲ್ಯಾ ಸೆವಕಾಕ್ಡೆ ಬೊಲುನ್, <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />ಸಾಯ್ಬಾ ದಯಾ ಕರುನ್ ಆಯ್ಕ್, ತುಜ್ಯಾ ಧನಿಕ್ಡೆಬಿ ಅಮಿ ಮಾಗ್ತಲೆ ಹೆಚ್ ಅಮಿ ಅದ್ದಿ ಎಗ್ದಾ ದಾನೆ ನೆವ್ಕ್ ಮನುನ್ ಯೆಲ್ಲ್ಯಾಂವ್ ತನ್ನಾ, <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />ಅಮಿ ಘರಾಕ್ ಪಾಟಿ ಪರ್‍ತುನ್ ಜಾತಾನಾ ಎಕ್ ಜಾಗ್ಯಾರ್ ವಸ್ತಿ ಹೊತ್ಯಾಂವ್, ಥೈ ಅಮ್ಚಿ ಪಿಸ್ವಿಯಾ ಉಗ್ಡುನ್ ಬಗ್ತಾನಾ, ಅಮಿ ದಾನೆ ಘೆವ್ನ್ ದಿಲ್ಲೆ ಪೈಸೆ ಪಿಸ್ವಿಯಾತ್ನಿ ಹೊತ್ತೆ, ತೆ ಅಮಿ ದಿವ್ಚೆ ಮನುನ್ ಪರ್‍ತುನ್ ಹಾನ್ಲಾವ್. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />ಅನಿ ಖರೆ ಅತ್ತಾ ದಾನೆ ನೆವ್ಕ್ ಮನುನ್ ಜಾಸ್ತಿಚೆ ಪೈಸೆ ಘೆವ್ನ್ ಯೆಲ್ಯಾಂವ್, ತೆ ಪೈಸೆ ಅಮ್ಚ್ಯಾ ಪಿಸ್ವಿಯಾತ್ನಿ ಪರ್‍ತುನ್ ಕೊನಿ ಥವಲ್ಲೆ ಮನುನ್ ಅಮ್ಕಾ ಗೊತ್ತ್ ನಾ ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />ತೆಕಾಚ್ ತ್ಯಾ ಸೆವಕಾನ್ ತೆಂಕಾ, ತುಮಿ ಭಿವ್ನಕಾಸಿ ತುಮ್ಚ್ಯಾ ಅನಿ ತುಮ್ಚ್ಯಾ ಬಾಬಾಚ್ಯಾ ದೆವಾನ್ ಆಯಾರಾ ಹೊವ್ನ್ ತುಮ್ಚ್ಯಾ ಪಿಸ್ವಿಯಾತ್ನಿ ಥವ್ಲಾ ಕಾಯ್ಕಿ, ತುಮಿ ಅದ್ದಿ ಯೆಲ್ಲ್ಯಾತನ್ನಾ ಮಿಯಾ ಪೈಸೆ ಘೆಟಲ್ಲೊ, ಮಟ್ಲ್ಯಾನ್ ಅನಿ ಸಿಮೊನಾಕ್ ತೆಂಚ್ಯಾಕ್ಡೆ ಹಾನುನ್ ಪಾವೈಲ್ಯಾನ್.<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />ಮಾನಾ ತ್ಯಾ ಸೆವಕಾನ್ ತೆಂಕಾ ಜುಜೆಚ್ಯಾ ಘರಾಚ್ಯಾ ಭುತ್ತುರ್ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಗೆಲ್ಯಾನ್, ಅನಿ ತೆಂಕಾ ಪಾನಿ ದಿಲ್ಯಾನ್ ತೆನಿ ಹಾತ್ ಪಾಂಯಾ ಧುವ್ನ್ ಘೆಟ್ಲ್ಯಾನಿ ಮಾನಾ ತ್ಯಾ ಸೆವಕಾನ್ ತೆಂಚ್ಯಾ ಘಾಡ್ವಾಕ್ನಿ ಖಾವ್ಕ್ ಚಾರೊ ದಿಲ್ಯಾನ್. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />ತೆನಿ ತೆಂಕಾ ತುಮಿ ಜುಜೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಜವಾನ್ ಕರ್‍ತಲೆ ಹಾಸಿ ಮಟ್ಲ್ಯಾನ್, ದೊಪಾರಿ ಪತರ್ ದಿವ್ಕ್ ಮನುನ್ ಹಾನಲಿ ಸಗ್ಳಿ ಆಯಾರಾ ತಯಾರ್ ಕರುನ್ಗೆಟ್ಲ್ಯಾನಿ. <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />ಮಾನಾ ಜುಜೆ ಘರಾಕ್ ಯೆಲ್ಲ್ಯಾ ಮಾನಾ ತೆನಿ ತೆಕಾ ಹಾನಲ್ಲಿ ಆಯರಾ ಸಗ್ಳಿ ದಿವ್ನ್ ತೆಚ್ಯಾ ಭೊತ್ಯಾನಿ ಡಬ್ಬ್ ಪಡುನ್ ನಮಸ್ಕಾರ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />ಜುಜೆನ್ ತೆಂಕಾ ಆರಾಮ್ ಹಾಸಿ ಕಾಯ್ , ಅನಿ ತುಮ್ಚೊ ಮ್ಹಾತಾರೊ ಬಾಬಾ ಆರಾಮ್ ಹಾಯ್ ಕಾಯ್? ಅಜುನಿ ಜಿವಾನಿ ಹಾಯ್ ಕಾಯ್? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />ತನ್ನಾ ತೆನಿ, “ತುಜಿ ಸೆವಕಾ ಅಮ್ಚೊ ಬಾಬಾ ಜಿವಾನಿ ಅನಿ ಆರಾಮಬಿ ಹಾಯ್” ಮಟ್ಲ್ಯಾನಿ, ಅನಿ ತೆನಿ ಜುಜೆಕ್ ಮಾನ್ ಬಾಗ್ವುನ್ ನಮಸ್ಕಾರ್ ಕರ್ಲ್ಯಾನಿ.<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />ಮಾನಾ ಜುಜೆನ್ ಅಪ್ಲ್ಯಾ ಸ್ವಂತ್ ಬಾಯ್ಚೊ ಲೆಕ್ ಬೆಂಜ್ಯಾಮಿನಾಕ್ ಬಗುನ್, ತುಮಿ ಸಾಂಗಲೊ ತುಮ್ಚೊ ಧಾಕ್ಲೊ ಭಾವ್ ಹ್ಯೊಚ್ ಕಾಯ್? ಮನುನ್ ತೆಕಾ ತುಕಾ ದೆವ್ ಬರೆ ಕರುಂದಿತ್ ಮಾಜ್ಯಾ ಲೆಕಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />ಜುಜೆ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ ಲೈ ಪ್ರೆಮ್ ಕರ್‍ತಲ್ಯಾ ವೈನಾ ತೆಕಾ ಬರೆ ಕರುನ್ ಬಗುನ್ ಖುಸಿನ್ ಡೊಳ್ಯಾತ್ನಾ ಪಾನಿ ಭರುನ್, ಅಪ್ಲ್ಯಾ ಖೊಲಿತ್ ಜಾವ್ನ್ ಲೈ ರಡ್ಲ್ಯಾನ್.<verse eid="GEN 43:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 43:31" />ಮಾನಾ ತೊಂಡ್ ಧುವ್ನ್ ಘೆವ್ನ್, ಅಪ್ನಾಕುಚ್ ಅಪ್ನಿ ಸಂಬಾಳುನ್ ಘೆವ್ನ್, ಭಾಯ್ರ್ ಯೆವ್ನ್, “ಜೆವಾವ್ನಾಕ್ ವಾಡಾ” ಮನುನ್ ಹುಕುಮ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 43:31" /><verse number="32" style="v" sid="GEN 43:32" />ಜೆವಾನ್ ಕರ್ತಾನಾ ಜುಜೆನ್ ಎಕ್ ಮೆಜಾ ವರ್‍ತಿ ಜೆವಾನ್ ಕರ್ಲಾನ್, ಅನಿ ತೆಚ್ಯಾ ಭಾವಾನಿ ದುಸ್ರಾ ಮೆಜಾ ವರ್‍ತಿ ಜೆವಾನ್ ಕರ್ಲ್ಯಾನಿ, ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾನಿ ಅನಿ ದುಸ್ರಾ ಮೆಜಾ ವರ್‍ತಿ ಜೆವಾನ್ ಕರ್ಲ್ಯಾನಿ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಇಬ್ರಿಯಾಂಚಿ ಲೊಕಾ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಬಸುನ್ ಜೆವಾನ್ ಕರ್ಲ್ಯಾರ್ ಅಪ್ಲಿ ಕಿಮ್ಮತ್ ಕಮ್ಮಿ ಹೊತಾ ಮನುನ್ ಚಿಂತಲ್ಯಾನಿ. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />ಜುಜೆನ್ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ನಿ ಥೊರ್ಲ್ಯಾಕ್ನಾ ಬಾರಿಕ್ಲ್ಯಾ ಪತರ್ ಸಮಾ ಬಸಿ ಸಾರ್ಕೆ ಕರುನ್ ಥವಲ್ಯಾನ್ ತೆ ಬಗುನ್ ಭಾವಾನಿ ಅಜಾಪ್ ಹೊವ್ನ್ ಎಕಾ ಮೆಕಾಕ್ ಬಗುನ್ ಘೆಟ್ಲ್ಯಾನಿ. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />ಮಾನಾ ಸೆವಕಾನಿ ಜುಜೆಕ್ನಾ ಲಾಗುನ್ ವಾಡಿತ್ ಯೆಲ್ಯಾನಿ ಖರೆ ಜುಜೆಚ್ಯಾ ಮೆಜಾಕ್ನಾ ಬೆಂಜ್ಯಾಮಿನಾಕ್ ಪಾಂಚ್ ಪಟ್ಟ್ ಜಾಸ್ತಿಚೆ ಧಾಡ್ಲ್ಯಾನ್, ಮಾನಾ ಭಾವಾನಿ ಪೊಟ್ ಭರುನ್ ಜೆವಾನ್ ಕರುನ್ ಪಾನಿ ಫಿಲ್ಯಾನಿ.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">ಜುಜೆಕ್ನಾ ಭಾವಾಂಚಿ ಪರಿಕ್ಷಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />ಮಾನಾ ಜುಜೆನ್ ಅಪ್ಲ್ಯಾ ಘರ್ ಚಾಲ್ವುತಲ್ಯಾಕ್ ಬಲ್ವುನ್, ತ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಪಿಸ್ವಿಯಾತ್ನಿ ಉಕ್ಲುಕ್ ಹೊತಾ ತವ್ಡೆ ದಾನೆ ಭರುನ್, ಎಕೆಕ್ಲ್ಯಾಚ್ಯಾ ಪಿಸ್ವಿಯಾಂಚ್ಯಾ ವೈನಾಬಿ ತೆಂಚ್ಯಾ ತೆಂಚ್ಯಾ ಪೈಸ್ಯಾಚಿ ಪೊಟ್ಲಿಯಾ ಥವ್, <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />ಧಾಕ್ಲ್ಯಾಚ್ಯಾ ಪಿಸ್ವಿತ್ ತೆನಿ ದಾನೆ ಘೆವ್ಕ್ ಹಾನಲೆ ಪೈಸೆ ಅನಿ ಮಾಜೆ ರುಪ್ಯಾಚೊ ಖಟೊರೊಬಿ ಥವ್, ಮನುನ್ ಹುಕುಮ್ ದಿಲ್ಯಾನ್, ಘರ್ ಚಾಲ್ವುತಲ್ಯಾ ಸೆವಕಾನ್ ತಸೆಚ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 44:2" /><verse number="3" style="v" sid="GEN 44:3" />ತ್ಯಾ ಲೊಕಾನಿ ಸಕ್ಕಾಳಿ ಉಜ್ವಾಡ್ತಾನಾಚ್ ಜಾವ್ಕ್ ಒಪ್ಕಿ ಘೆವ್ನ್ ಗಾಡ್ವಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಧಾಡುನ್ ದಿಲ್ಯಾನಿ. <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />ತೆನಿ ಉಲ್ಲೆ ಧುರ್ ಪಾವಲ್ಯಾ ತಸೆಚ್, ಜುಜೆನ್ ಅಪ್ಲ್ಯಾ ಘರ್ ಚಾಲ್ವುತಲ್ಯಾ ಸೆವಕಾಕ್ ತಿಯಾ ಜಾವ್ನ್ ತ್ಯಾ ಲೊಕಾಕ್ನಿ ಫಾಟ್ ಲಾಗುನ್ ಧರ್, ತುಮಿ ಬರೆ ಕರಲ್ಯಾಕ್ ಪರ್‍ತುನ್ ವಾಯ್ಟ್ ಕಶ್ಯಾಕ್ ಕರ್ಲ್ಯಾಸಿ? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />ಮಾಜೊ ಯೆಜ್ಮಾನ್ ಪಾನಿ ಫಿತಲೊ ತ್ಯಾಚ್ ಖಟೊರ್ಯಾನ್ ನೈ ಕಾಯ್? ತ್ಯಾತುರ್ ಬಗುನುಚ್ ನೈ ಕಾಯ್ ಫಿಡೆ ಕಾಯ್ ಘಡ್ನಾರ್ ಹೊತ್ತೆ ಸಾಂಗ್ತಲೊ? ತುಮಿ ಅಸೆ ಕರಲ್ಲೆ ಬುರ್ಸೆಪಾನ್ ಮನುಚೆ, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />ಘರ್ ಚಾಲ್ವುತಲ್ಯಾ ಸೆವಕಾನ್ ತೆಂಚಿ ಫಾಟ್ ಲಾಗುನ್ ಜಾವ್ನ್ ತೆಂಕಾ ಧರುನ್ ತಸೆಚ್ ಸಾಂಗ್ಲ್ಯಾನ್, <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />ತನ್ನಾ ತೆನಿ, ಸಾಯ್ಬಾ, ತಿಯಾ ಅಸ್ಲಿ ಬೊಲ್ನಿಯಾ ಬೊಲ್ತಲೆ ಕಾಯ್? ತುಜಿ ಸೆವಕಾ ಅಮಿ ಕದ್ದಿಬಿ ಅಸ್ಲಿ ಕಾಮಾ ಕರಿನಾವ್. <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />ಪೈಲೆ ಅಮ್ಚ್ಯಾ ಪಿಸ್ವಿಯಾತ್ನಿ ಗಾವಲ್ಲೆ ಪೈಸೆ ಕಾನಾನ್ ದೆಸಾಕ್ನಾ ಹಾನುನ್ ತುಮ್ಕಾಚ್ ದಿಲಾಂವ್, ಅಸೆ ರ್‍ಹಾತಾನಾ ಅಮಿ ತುಜ್ಯಾ ಯೆಜ್ಮಾನಾಚ್ಯಾ ಘರ್‍ಹಾತ್ನಾ ಚಂದಿ ಅನಿ ಸೊನೆ ಕಶ್ಯಾಕ್ ಚೊರ್ತಾಂವ್ ? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />ತೊ ಖಟೊರೊ ಅಮ್ಚ್ಯಾತ್ ಕೊನ್ ತರಿ ಎಕ್ಲ್ಯಾಂಚ್ಯಾಕ್ಡೆ ಗಾವಲ್ಲೊ ಹೊಲ್ಯಾರ್ ತೆಕಾ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ಹೊಂವ್ದಿತ್! ಅನಿ ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಅಮಿ ಸಗ್ಳೆಬಿ ತುಜ್ಯಾ ಯೆಜ್ಮಾನಾಕ್ ಆಳಾ ಹೊವ್ನ್ ರ್‍ಹಾತಾಂವ್, ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />ತನ್ನಾ ತ್ಯಾ ಘರ್ ಚಾಲ್ವುತಲ್ಯಾ ಸೆವಕಾನ್ ತುಮಿ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಹೊಂವ್ದಿತ್, ತೊ ಖಟೊರೊ ಕೊನಾಕ್ಡೆ ಗಾವ್ತಾ, ತೊ ಮಾಕಾ ಆಳ್ ಹೊವ್ನ್ ರಾಂವ್ದಿತ್ ಅನಿ ಹುರಲ್ಯಾಂಚಿ ಕಾಯ್ ಚುಕ್ ನಾ . <verse eid="GEN 44:10" /><verse number="11" style="v" sid="GEN 44:11" />ತೆನಿ ಹರ್ ಎಕ್ಲ್ಯಾನಿಬಿ ಅಪ್ಲಿ ಅಪ್ಲಿ ಪಿಸ್ವಿಯಾ ಖಾಲ್ತಿ ಉತ್ರುನ್ ಸೊಡಸ್ಲ್ಯಾನಿ, <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />ತೆನಿ ಥೊರ್ಲ್ಯಾಕ್ನಾ ಧಾಕ್ಲ್ಯಾ ಪತರ್ ಹರ್ ಎಕ್ಲ್ಯಾಚೆಬಿ ಪಿಸ್ವಿಯಾ ಪರಿಕ್ಷಾ ಕರುನ್ ಬಗಟ್ಲ್ಯಾನ್, ತೊ ಖಟೊರೊ ಬೆಂಜ್ಯಾಮಿನಾಚ್ಯಾ ಚಿಲಾತ್ ಗಾವ್ಲೊ. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />ತನ್ನಾ ತೆನಿ ಲೈ ದುಕ್ಕ್ ಹೊವ್ನ್ ಅಪ್ಲೆ ಕಪ್ಡೆ ಪಿಂಜುನ್ಗೆವ್ನ್ ರಡ್ಲ್ಯಾನಿ; ಅನಿ ಪಿಸ್ವಿಯಾ ಗಾಡ್ವಾಂಚ್ಯಾ ವರ್‍ತಿ ವಾವುನ್ಗೆವ್ನ್ ಫಾಟಿ ಪರ್‍ತುನ್ ಶಹಾರಾಕ್ ಯೆಲ್ಯಾನಿ.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />ಜೆಹುದ್ ಅನಿ ತೆಚಿ ಭಾವಾ ಜುಜೆಚ್ಯಾ ಘರಾಕ್ ಫಾಟಿ ಪರ್‍ತುನ್ ಯೆಲ್ಲ್ಯಾತನ್ನಾ ಜುಜೆ ಘರಾತುಚ್ ಹೊತ್ತೊ ತೆನಿ ತೆಕಾ ಪಾಯ್ ಪಡ್ಲ್ಯಾನಿ. <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />ಜುಜೆನ್ ತೆಂಕಾ ತುಮಿ ಅಸೆ ಕಾಯ್ ಕರ್ಲ್ಯಾಸಿ? ಫಿಡೆ ಘಡ್ನಾರ್ ಹೊತ್ತೆ ಸಾಂಗ್ನಾರೊ ಮಾಜ್ಯಾ ಸಾರ್ಕೊ ಮಾನುಸ್ ಹಿ ಸಂಗ್ತಿಯಾ ಕಳ್ವುನ್ ಘೆತಾ ಮನ್ತಲೆ ತುಮ್ಕಾ ಗೊತ್ತ್ ನಾ ಕಾಯ್? ಮನುನ್ ಇಚ್ಯಾರ್ಲ್ಯಾನ್.<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />ತೆಕಾ ಜೆಹುದಾನ್ ಅಮಿ ಅಮ್ಚ್ಯಾ ಧನಿ ಕಾಯ್ ಸಾಂಗುಂವಾ? ಕಾಯ್ ಜವಾಬ್ ದಿಂವ್ವಾ? ಅಮಿ ಚುಕ್ ಕರುನಾವ್ ಮನುನ್ ದಾಕ್ವುಕ್ ಕಾಯ್ ಕರುಚೆ? ತುಮ್ಚಿ ಆಳಾ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಅಮ್ಚಿ ಪಾಪಾಚಿ ಕಾಮಾ ದೆವಾನುಚ್ ಭಾಯ್ರ್ ಹಾನ್ಲಾ, ತೊ ಖಟೊರೊ ಗಾವಲೊ ಮಾನುಸ್ ಎಕ್ಲೊಚ್ ನಸ್ತಾನಾ ಅಮಿ ಸಗ್ಳೆಬಿ ಗುಲಾಮ್ ಹೊಲಾಂವ್ ನೈ? ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />ತನ್ನಾ ಜುಜೆನ್ ತಸೆ ಕನ್ನಾಬಿ ಹೊತಲೆ ನಕ್ಕೊ; ತೊ ಖಟೊರೊ ಕೊನಾಕ್ಡೆ ಗಾವ್ತಾ ತೊ ಎಕ್ಲೊಚ್ ಮಾಕಾ ಗುಲಾಮ್ ಹೊವ್ನ್ ರಾವ್ಚೊ, ಅನಿ ಹುರಲೆ ತುಮಿ ಸಗ್ಳೆ ತುಮ್ಚ್ಯಾ ಬಾಬಾಕ್ಡೆ ಸಮಾದಾನಾನ್ ಜಾವ್ಕ್ ಅಡ್ಡಿ ಕಾಯ್ಬಿ ನಾ, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 44:17" /></para>
  <para style="s">ಜೆಹುದಾಚಿ ಮಾಗ್ನಿ ಬೆಂಜ್ಯಾಮಿನಾಸಾಟ್ನಿ</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />ತನ್ನಾ ಜೆಹುದಾನ್ ಜಗ್ಗೊಳ್ ಯೆವ್ನ್, ಮಾಜ್ಯಾ ಧನಿ ಮಿಯಾ ತುಮ್ಚೊ ಸೆವಕ್ ಎಕ್ ಗೊಸ್ಟ್ ಮಾಗುನ್ಗೆತಾ; ರಾಗ್ ಹೊವ್ ನಕಾಸಿ ತುಮಿ ಪರೊಹ್ ರಾಜಾಚ್ಯಾ ಸಮಾ ಹಾಸಿ, <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />ಅಮ್ಚೊ ಯೆಜ್ಮಾನ್ ತುಮಿ ಸೆವಕಾ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಅಮ್ಕಾ ಭಾವ್ ನಾತರ್, ಬಾಬಾ ಹಾತ್ ಕಾಯ್ ? ಮನುನ್ ಇಚಾರ್ಲ್ಯಾಸಿ. <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />ಅಮಿ ಮ್ಹಾತಾರೊ ಬಾಬಾ ಹಾಯ್, ತೆಕಾ ಮ್ಹಾತಾರ್ಯಾ ವೈಸಾತ್ ಉಪಾಜಲ್ಲೊ ಎಕ್ ಬಾರಿಕ್ ಝಿಲ್ಗೊ ಹಾಯ್ ಅನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಉಪಾಜಲ್ಲೊ ಮರುನ್ ಗೆಲೊ, ತೆಚ್ಯಾ ಬಾಯ್ಚ್ಯಾ ಪೊಟಾತ್ ಉಪಜಲ್ಯಾತ್ನಿ ತೊ ಎಕ್ಲೊಚ್ ಹುರ್ಲಾ, ಅನಿ ತೊ ಬಾಬಾಕ್ ಲೈ ಪ್ರೆಮಾಚೊ ಲೆಕ್, ಮನುನ್ ಸಾಂಗಲಾಂವ್, <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />ತನ್ನಾ ತುಜಿ ಸೆವಕಾ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಅಮ್ಕಾ ತೆಕಾ ಬಲ್ವುನ್ ಹಾನಾ ಮಿಯಾ ತೆಕಾ ಬಗುಚೆ ಮಟಲೈ. <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />ತುಜಿ ಸೆವಕಾ ಅಮಿ ತೊ ಝಿಲ್ಗೊ ಬಾಬಾಕ್ ಸೊಡುನ್ ಧುರ್ ಜಾವ್ಕ್ ಹೊಯ್ನಾ, ಗೆಲ್ಯಾರ್ ಬಾಬಾ ಮರುನ್ ಜಾತಾ ಮಟಲಾಂವ್. <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />ಖರೆ ತಿಯಾ ತುಮ್ಚೊ ಭಾವ್ ಯೆಯ್ನಸ್ಲ್ಯಾರ್ ತುಮ್ಚಿ ತೊಂಡಾ ದಾಕ್ವುನಕಾಸಿ ಮಟಲೈ.<verse eid="GEN 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 44:24" />ಅಮಿ ತುಜಿ ಸೆವಕಾ ಹೊವ್ನ್ ಅಮ್ಚ್ಯಾ ಯೆಜ್ಮಾನಾನ್ ಇಚಾರಲ್ಲೆ ಅಮ್ಚ್ಯಾ ಬಾಬಾಕ್ ಸಾಂಗ್ಲ್ಯಾಂವ್. <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />ಅಮ್ಚ್ಯಾ ಬಾಬಾನ್ ತುಮಿ ಜಾವ್ನ್ ಅನಿ ಎಗ್ದಾ ದಾನೆ ಹಾನಾ ಮನ್ತಾನಾ, <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />ಅಮಿ ಅಮ್ಚೊ ಭಾವ್ ವಾಂಗ್ಡಾ ನಸ್ತಾನಾ ತ್ಯಾ ಮಾನ್ಸಾಚೆ ತೊಂಡ್ ದಾಕ್ವುಕ್ ಹೊಯ್ನಾ ಅಮ್ಚೊ ಭಾವ್ ಯೆಲ್ಯಾರ್ ಜಾತಾಂವ್ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾವ್, <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />ತನ್ನಾ ಅಮ್ಚ್ಯಾ ಬಾಬಾನ್ ಮಜ್ಯಾ ಬಾಯ್ಕೊಕ್ ದೊನ್ ಲೆಕಾ ಉಪಾಜಲ್ಲೆ ಮನುನ್ ತುಮ್ಕಾಬಿ ಗೊತ್ತುಚ್ ಹೊತ್ತೆ, <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />ತ್ಯಾತುರ್ಲೊ ಎಕ್ಲೊ ಮಾಕಾ ಸೊಡುನ್ ಗೆಲೊ; ತೆಕಾ ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಜನಾವರಾನಿ ಉಲ್ಲೆಬಿ ದಯಾ ನಸ್ತಾನಾ ಪಿಂಜುನ್ ಟಾಕುಕ್ ಫಿರೆ ಮನುನ್ ಚಿಂತಲೊ; ತೆಚ್ಯಾ ಮಾನಾ ತೊ ಮಾಕಾ ದಿಸುಕ್ನಾ, <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />ಅನಿ ಅತ್ತಾ ಹೆಕಾಬಿ ಮಾಜೆಕ್ನಾ ಘೆವ್ನ್ ಜಾವ್ಚೆ ಮನುನ್ ಕರ್ಲ್ಯಾಸಿ, ಅತ್ತಾ ಹೆಕಾಬಿ ಕಾಯ್ಬಿ ಹೊಲ್ಯಾರ್ ಅಸ್ಲೊ ಪಿಕ್ಕ್ಯಾ ಕೆಸಾಂಚೊ ಮ್ಹಾತಾರೊ ಹೊಲ್ಲೊ ಮಿಯಾ ತರಾಸಾನ್ ಮರುಕ್ ತುಮಿಚ್ ಕಾರನ್ ಹೊತ್ಯಾಸಿ, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />ತುಜಿ ಆಳಾ ಅಮಿ ಬಾಬಾಕ್ಡೆ ಗೆಲ್ಲ್ಯಾ ತನ್ನಾ ಲೆಕಾಚ್ಯಾ ವರ್‍ತಿ ಜಿವ್ ಥವ್ನ್ ಹೊತ್ತೊ ಬಾಬಾ ಹ್ಯೊ ಲೆಕ್ ಅಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ದಿಸುಕ್ ನಸ್ಲ್ಯಾರ್, ಝಿಲ್ಗೊ ಯೆವ್ಕ್ನಾ ಮನುನ್ ತೊ ತನ್ನಾಚ್ ಮರುನ್ ಜಾತಾ, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />ತನ್ನಾ ತುಜಿ ಸೆವಕಾ ಅಮಿ, ತುಜೊ ಸೆವಕ್ ಪಿಕ್ಕ್ಯಾ ಕೆಸಾಂಚೊ ಮ್ಹಾತಾರೊ ಅಮ್ಚೊ ಬಾಬಾ ತರಾಸಾನ್ ಮಸನ್ಗಿಕ್ ಜಾವ್ಕ್ ಕಾರನ್ ಹೊತಾಂವ್. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />ಆಳ್ ಹೊವ್ನ್ ಹೊತ್ತೊ ಮಿಯಾ ಬಾಬಾಕ್ಡೆ ಹ್ಯಾ ಝಿಲ್ಗ್ಯಾಕ್ ಜವಾಬ್ದಾರಿ ಹೊಲ್ಲೊ ಹಾಂವ್, ಮಿಯಾ ತೆಕಾ ತುಜ್ಯಾಕ್ಡೆ ಹಾನುಕ್ ನಸ್ಲ್ಯಾರ್ ಬಾಬಾಕ್ ಚುಕಲೊ ಲೆಕ್ ಮನ್ತಲೊ ಶಾಪ್ ಮಾಜೆ ವರ್‍ತಿ ರಾಂವ್ದಿತ್ ಮನುನ್ ಗೊಸ್ಟ್ ದಿಲೊ, <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />ತಸೆ ಹೊವ್ನ್ ಮಿಯಾ ತುಜೆಕ್ಡೆ ಮಾಗ್ತಲಿ ಮಾಗ್ನಿ ಹಿ; ಹ್ಯಾ ಝಿಲ್ಗ್ಯಾಚ್ಯಾ ಬದ್ಲಾಕ್ ತುಜೊ ಆಳ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಮಾಕಾ ಗುಲಾಮ್ ಕರುನ್ ಥವ್ನ್ ಘೆವಾ, ಅನಿ ಹೊ ಮಾಜ್ಯಾ ಭಾವಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಜಾವ್ಕ್ ಪರ್ವಾನ್ಗಿ ದಿವಾ,<verse eid="GEN 44:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 44:34" />ಮಿಯಾ ಹ್ಯಾ ಝಿಲ್ಗ್ಯಾಕ್ ಸೊಡುನ್ ಮಾಜ್ಯಾ ಬಾಬಾಕ್ಡೆ ಕಸೆ ಜಾವ್ಕ್ ಹೊತಾ? ಮನ್ ದುಕ್ವುನ್ ಘೆಟಲ್ಯಾ ಬಾಬಾಕ್ ಮಾಜ್ಯಾನ್ ಬಗುಕ್ ಹೊಯ್ನಾ.<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">ಜುಜೆ ಅಪ್ಲಿ ವಳಕ್ ದಾಕ್ವುನ್ಗೆತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />ಹೆ ಆಯ್ಕ್ಲ್ಯಾ ಮಾನಾ ಜುಜೆಕ್ ಅಪ್ಲ್ಯಾ ಸೆವಕಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಅಪ್ನಾಕುಚ್ ಅಪ್ನಿ ತಡ್ದುಕ್ ಹೊವ್ಕ್ನಾ, ಹಿತ್ತೆತ್ನಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಭಾಯ್ರ್ ದಾಡಾ ಮನುನ್ ತೊಂಡ್ ಉಗ್ಡುನ್ ಸಾಂಗ್ಲ್ಯಾನ್, ಜುಜೆನ್ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ನಿ ವಳಕ್ ಗಾಯ್ ಸಾರ್ಕೆ ಕರುನ್ಗೆತಾನಾ ದುಸ್ರೆ ಕೊನ್ಬಿ ಜಗ್ಗೊಳ್ ನತ್ತೆ. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />ತೆನಿ ಲೈ ಮೊಟ್ಯಾನ್ ರಡಲೆ ಐಗುಪ್ತಾಚ್ಯಾಕ್ನಿ ಆಯಿಕ್ಲೆ, ಅನಿ ಪೊರಾಹ್ ರಾಜಾಚ್ಯಾ ಘರಾಕ್ಬಿ ಖಬರ್ ಗಾವ್ಲಿ, <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />ಜುಜೆನ್ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ನಿ, ಮಿಯಾಚ್ ಜುಜೆ, ಮಾಜೊ ಬಾಬಾ ಅಜುನ್ ಹಾಯ್ ಕಾಯ್? ಮನುನ್ ಇಚ್ಯಾರ್ಲ್ಯಾನ್, ತೆನಿ ಸಗ್ಳೆಬಿ ಭಿಂವ್ನ್ ಜವಾಬ್ ದಿಯ್ನಾ ಸಾರ್ಕೆ ಹೊಲೆ. <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />ಜುಜೆನ್ ತೆಂಕಾ ಜಗ್ಗೊಳ್ ಯೆವಾ ಮನುನ್ ಬಲ್ವುನ್ಗೆವ್ನ್ ತುಮಿ ಇಜಿಪ್ತಾಕ್ ಇಕಲೊ ತುಮ್ಚೊ ಭಾವ್ ಜುಜೆ ಮಿಯಾಚ್, ಮಟಲ್ಲೆ ಆಯ್ಕುನ್ ಭಿಂವ್ನ್ ಜವಾಬ್ ದಿ ನಾ ಸಾರ್ಕೆ ಹೊಲೆ. <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />ತುಮಿ ಮಾಕಾ ಹಿತ್ತೆ ಇಕಲ್ಯಾ ಸಾಟ್ನಿ ಬೆಜಾರ್ ಕರುನ್ಗೆವ್ ನಕಾಸಿ, ದೆವಾನ್ ಜಿವಾಂಚ್ಯಾ ರಾಕ್ವನಿ ಸಾಟ್ನಿ ತುಮ್ಚ್ಯಾ ಕಿಂತಾ ಅದ್ದಿಚ್ ಮಾಕಾ ಹಿತ್ತೆ ಧಾಡುನ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />ದೆಶ್ಯಾತ್ ಬರ್‍ಗಾಲ್ ಯೆವ್ನ್ ಅತ್ತಾ ದೊನ್ ವರಿಸ್ ಹೊಲಾ, ಅನಿ ಪಾಂಚ್ ವರಿಸ್ ಪತರ್ ಪೆರುಕ್ ನಾತರ್ ಕಾತ್ರನಿಕ್ ಅವ್ಕಾಸ್ ನಾ. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />ದೆವಾನ್ ತುಮ್ಕಾ ಅನಿ ತುಮ್ಚ್ಯಾ ಪಿಳ್ಗಿಕ್ ಚಾಲ್ವುಕ್ ಸಾಟ್ನಿ ಅಸೆ ಅಜಾಪ್ ರಿತಿನ್ ತುಮ್ಕಾ ರಾಕ್ವನ್ ಕರುಕ್ ಸಾಟ್ನಿ ಮಾಕಾ ತುಮ್ಚ್ಯಾನ್ ಫಿಡೆಚ್ ಧಾಡ್ಲ್ಯಾನ್. <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />ಮಾಕಾ ಹಿತ್ತೆ ಧಾಡಲೆ ದೆವಾನುಚ್ ತುಮಿ ನೈ, ತೆನಿ ಮಾಕಾ ಪರೊಹ್ ರಾಜ್ಯಾಚೊ ಬಾಬಾ, ಅನಿ ರಾಜ್ವಡ್ಕಿಕ್ ಅಧಿಪತಿ ಅನಿ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಕ್ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚೊ ಅಧಿಕಾರಿ ಕರ್ಲ್ಯಾನ್.<verse eid="GEN 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 45:9" />ತುಮಿ ಮಾಜೊ ಬಾಬಾಕ್ಡೆ ಜಾವ್ನ್ ತುಜೊ ಲೆಕ್ ಜುಜೆ ಅಸೊ ಮನ್ತಾ, ದೆವಾನ್ ಮಾಕಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಕ್ ಅಧಿಪತಿ ಕರುನ್ ನೆಮ್ಲಾ, ತುಮಿ ತಡೊ ಕರಿನಸ್ತಾನಾ ಮಾಜೆಕ್ಡೆ ಯೆವ್ಚೆ, <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />ಹಿತ್ತೆ ಮಾಜ್ಯಾ ಜಗ್ಗೊಳುಚ್ ತುಮಿ ತುಮ್ಚಿ ಪೊರಾ ನಾತ್ರಾ, ಗೊರಾಡೊರಾ, ಬಕ್ರಿ, ಶೆಳಿಯಾ, ಅನಿ ಆಸ್ತಿ ಸಗ್ಳೆಬಿ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಗೊಶೆನ್ ಪ್ರಾಂತ್ಯಾತ್ ರಾವ್ಕ್ ಹೊತಾ. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />ಬರ್‍ಗಾಲ್ ಕಳ್ದುಕ್ ಅನಿ ಪಾಂಚ್ ವರಿಸ್ ಹಾಯ್, ತುಮ್ಕಾ ಅನಿ ತುಮ್ಚ್ಯಾ ಕುಟ್ಮಾಕ್ ಅನಿ ಅನಿ ತುಮ್ಕಾ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿಬಿ ಗರಿಬ್ಪಾನ್ ಯೆಯ್ನಾ ಸಾರ್ಕೆ ಮಿಯಾ ತುಮ್ಕಾ ಬಾಳಗ್ತಾ ತುಮ್ಚಿ ಜನಾವರಾ ಭುಕೆನ್ ಮರ್ತಲೆ ಮಾಜ್ಯಾನ್ ಬಗುಕ್ ಹೊಯ್ನಾ, ಮನುನ್ ಸಾಂಗಲೆ ತೆಂಕಾ ಕಳ್ವಾ.<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />“ಮಿಯಾಚ್ ಸ್ವತಾ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲಲ್ಯಾಕ್ ತುಮಿಚ್ ಸಾಕ್ಷಿ ಅನಿ ಮಾಜೊ ಭಾವ್ ಬೆಂಜ್ಯಾಮಿನ್ಬಿ ಸಾಕ್ಷಿ, ಹೆ ಸಗ್ಳೆ ಸಾಂಗುನ್ ಬಾಬಾಕ್ ಲಗ್ಗುನಾ ಹಿತ್ತೆ ಬಲ್ವುನ್ ಹಾನಾ”, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />ತುಮಿ ಹಿತ್ತೆ ಇಜಿಪ್ತಾತ್ ಮಾಕಾ ಹೊತ್ತಿ ಮರ್ಯಾದ್ ಅನಿ ಗೌರವ್ ಕಸೆ ಹಾಯ್ ಮನುನ್ ಬಗಟಲ್ಲೆ ಬಾಬಾಕ್ ಸಾಂಗುನ್ ಲಗ್ಗುನಾ ತೆಕಾ ಹಿತ್ತೆ ಬಲ್ವುನ್ ಹಾನಾ, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />ಮಾನಾ ಜುಜೆನ್ ಅಪ್ಲೊ ಭಾವ್ ಬೆಂಜ್ಯಾಮಿನಾಕ್ ಯಾಂಗ್ ಮಾರುನ್ ರಡ್ಲ್ಯಾನ್, ಅನಿ ಬೆಂಜ್ಯಾಮಿನಾನ್ಬಿ ರಡ್ಲ್ಯಾನ್, <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />ಅನಿ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ನಿ ಸಗ್ಳ್ಯಾಕ್ನಿಬಿ ಉಪ್ಪಾ ದಿಲ್ಯಾನ್, ಮಾನಾ ತೆನಿ ಸಗ್ಳ್ಯಾನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲ್ಯಾನಿ.<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />ಜುಜೆಚಿ ಭಾವಾ ಯೆಲ್ಲಿ ಖಬರ್ ಪರೊಹಾಚ್ಯಾ ರಾಜಾಚ್ಯಾ ಘರಾಕ್ ಪಾವ್ಲಿ, ಪರೊಹ್ ಅನಿ ತೆಚ್ಯಾ ಘರಾಚ್ಯಾ ಲೊಕಾನಿ ಹೆ ಆಯ್ಕುನ್ ಲೈ ಖುಶಿ ಹೊಲ್ಯಾನಿ. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />ತನ್ನಾ ಪರೊಹಾನ್ ಜುಜೆಕ್ ಬಲ್ವುಕ್ ಲಾವ್ನ್, ತಿಯಾ ತುಜ್ಯಾ ಭಾವಾಕ್ನಿ ಕಳ್ವುಚೆ ಹೊಲ್ಲೊ ಹುಕುಮ್ ಹ್ಯೊ; ತುಮಿ ತುಮ್ಚ್ಯಾ ಗಾಡ್ವಾಂಚ್ಯಾ ವರ್‍ತಿ ಸಗ್ಳಿ ಸಾಮಾನಾ ವಾವುನ್ ಘೆವ್ನ್ ಕಾನಾನ್ ದೆಶ್ಯಾಕ್ ಜಾವ್ನ್ ಥೈತ್ನಾ, <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />ತುಮ್ಚ್ಯಾ ಬಾಬಾಕ್ ಅನಿ ಕುಟ್ಮಾಚ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಬಲ್ವುನ್ಗೆವ್ನ್ ಮಾಜೆಕ್ಡೆ ಯೆವಾ, ಇಜಿಪ್ತಾತ್ ತುಮ್ಕಾ ಲೈ ಬರೊ ಜಾಗೊ ದಿತಾ, ಅನಿ ತುಮ್ಕಾ ಹ್ಯಾ ದೆಶ್ಯಾತ್ ಸುಕ್ ಅನಿ ಆಸ್ತಿ ಗಾವ್ತಾ. <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />ತುಜಾ ಭಾವಾಕ್ನಿ ತೆಂಚ್ಯಾ ಬಾಯ್ಕೊ ಪೊರಾಕ್ನಿ ಅನಿ ಬಾಬಾಕ್ ಹಾನುಕ್ ಇಜಿಪ್ತಾಕ್ನಾ ರಥಾ ಘೆವ್ನ್ ಜಾವಾ; ಅನಿ ತೆಂಕಾ ಘೆವ್ನ್ ಯೆವ್ಕ್ ಸಾಂಗ್, <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />ಆಸ್ತಿಚ್ಯಾ ವಿಶಯಾತ್ ತುಮಿ ಚಿಂತ್ತಲೆ ನಕ್ಕೊ, ಇಜಿಪ್ತಾತ್ ಲೈ ಬರೊ ಭಾಗ್ ತುಮ್ಕಾ ಗಾವ್ತಾ,<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />ಜಾಕೊಬಾಚ್ಯಾ ಪೊರಾನಿ ತಸೆಚ್ ಕರ್ಲ್ಯಾನಿ, ಪರೊಹಾಚ್ಯಾ ಹುಕುಮಾ ಸಾರ್ಕೆ ಜುಜೆನ್ ತೆಂಕಾ ವಾಟೆರ್ ಪಾಜೆ ಹೊಲ್ಲೆ ಜೆವಾನ್ ಅನಿ ಘೊಡ್ಕಿಯಾಂಚಿ ರಥಾ ದಿವ್ನ್ ಧಾಡ್ಲ್ಯಾನ್, <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />ಅನಿ ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಹರ್ ಎಕ್ಲ್ಯಾಕ್ಬಿ ನ್ಹವೆ ಕಪ್ಡೆ ನೆಸ್ವುನ್ ಧಾಡ್ಲ್ಯಾನ್, ಅನಿ ಬೆಂಜ್ಯಾಮಿನಾಕ್ ತಿನ್ಸೆ ಚಾಂದಿಚೆ ಪೈಸೆ, ಅನಿ ಪಾಂಚ್ ಜೊಡಿ ಕಪ್ಡೆ ದಿಲ್ಯಾನ್, <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />ಅಪ್ಲ್ಯಾ ಬಾಬಾ ಸಾಟ್ನಿ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಚಿ ಬರಿ ಸಾಮಾನಾ ಧಾ ಗಂಡ್ ಗಾಡ್ವಾ ವೈನಿ ವಾವುನ್, ಅನಿ ಧಾ ಹೆನ್ನ್ ಗಾಡ್ವಾರ್ನಿ ದಾನೆ ಅನಿ ಜೆವ್ನಾಕ್ ಪಾಜೆ ಹೊಲ್ಲೆ ಸಗ್ಳೆ ದಿವ್ನ್ ಧಾಡ್ಲ್ಯಾನ್. <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />ಅನಿ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ನಿ ವಾಟೆ ವರ್‍ತಿ ಝಗ್ಡುನಕಾಸಿ ಮನುನ್ ಸಾಂಗುನ್ ಧಾಡ್ಲ್ಯಾನ್, ತೆನಿ ಗೆಲೆ.<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />ತೆನಿ ಇಜಿಪ್ತಾಕ್ನಾ ಜಾವ್ನ್ ಅಪ್ಲೊ ಬಾಬಾ ಜಾಕೊಬಾಕ್ಡೆ ಕಾನಾನಾಕ್ ಪಾವ್ಲೆ, <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />ಅನಿ ಜುಜೆ ಅಜುನ್ ಝಿತ್ತೊ ಹಾಯ್, ಅನಿ ತೊ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಚೊ ಅಧಿಪತಿ ಹೊಲಾ ಮನುನ್ ಕಳ್ವುಲ್ಯಾನಿ, ತೆನಿ ಹೆ ಆಯ್ಕುನ್ ತೆಂಚೊ ಬಾಬಾ ಕಂಗಾಲ್ ಹೊಲೊ ಅನಿ ತೆಂಚ್ಯಾ ಗೊಸ್ಟಿಕ್ ವಿಶ್ವಾಸ್ ಕರುಕ್ನಾ.<verse eid="GEN 45:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 45:27" />ಖರೆ ಜುಜೆನ್ ಸಾಂಗುನ್ ಧಾಡಲಿ ಗೊಸ್ಟ್ ಅನಿ ಪರ್ಯಾನಾಕ್ ಪಾಜೆ ಹೊಲ್ಲೆ ರಥಾ ಬಗುನ್ ಜಾಕೊಬಾಕ್ ಖುಶಿ ಹೊಲೊ ಅನಿ ನ್ಹವ್ವೊ ಜಿವ್ ಯೆಲ್ಯಾ ಸಾರ್ಕೆ ಹೊಲೆ, <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />ಮಾನಾ ಜಾಕೊಬಾನ್, “ಮಾಜೊ ಲೆಕ್ ಜುಜೆ ಝಿತ್ತೊ ಹಾಯ್ ಮನುನ್ ಮಿಯಾ ವಿಶ್ವಾಸ್ ಕರ್ತಾ, ಮಾಕಾ ತವ್ಡೆಚ್ ಫಿರೆ! ಮಿಯಾ ಮರುಚ್ಯಾ ಅದ್ದಿಚ್ ಜಾವ್ನ್ ತೆಕಾ ಬಗ್ತಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">ಜಾಕೊಬ್ ಅನಿ ತೆಚ್ಯಾ ಕುಟ್ಮಾಚಿ ಲೊಕಾ ಐಗುಪ್ತಾಕ್ ಜಾತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />ಜಾಕೊಬಾನ್ ಅಪ್ಲೆ ಸಗ್ಳೆಬಿ ಘೆವ್ನ್ ಪರ್ಯಾನ್ ಕರುನ್ ಬೆರ್ಶೆಬ್ ಮನ್ತಲ್ಯಾ ಗಾಂವಾಕ್ ಯೆಲೊ, ಅನಿ ಥೈ ಅಪ್ಲೊ ಬಾಬಾ ಇಸಾಕಾಚ್ಯಾ ದೆವಾಕ್ ಬಲಿ ಭೆಟ್ವುಲ್ಯಾನ್. <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />ತ್ಯಾ ದಿಸಿ ರಾತ್ತಿನ್ ದೆವಾನ್ ಜಾಕೊಬಾಕ್ ಸಪ್ನಾತ್ ಯೆವ್ನ್, ಜಾಕೊಬ್, ಜಾಕೊಬ್ ಮನುನ್ ಬಲ್ವುತಾನಾ,</para>
  <para style="p" vid="GEN 46:2">“ಅಬಕ್ ಮಿಯಾ ತಯಾರ್ ಹಾಂವ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />ತನ್ನಾ ಮಿಯಾಚ್ ದೆವ್ ತುಜ್ಯಾ ಬಾಬಾಚೊ ದೆವ್, ತಿಯಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಕ್ ಜಾವ್ಕ್ ಭಿಂವ್ ನಕ್ಕೊ, ಥೈ ತುಜಿ ಪಿಳ್ಗಿ ಲೈ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ; <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಯಾಚ್ ಇಜಿಪ್ತಾಕ್ ಯೆತಾ, ಥೈತ್ನಾ ತುಜ್ಯಾ ಪಿಳ್ಗಿಕ್ ಖರೆಚ್ಬಿ ವಾಪಸ್ ಪರ್‍ತುನ್ ಹಾನ್ತಾ, ತಿಯಾ ಮರ್ತಲ್ಯಾ ಎಳಾರ್ ಜುಜೆಚ್ ಯೆವ್ನ್ ಅಪ್ಲ್ಯಾ ಹಾತಾನಿ ತುಜೆ ಡೊಳೆ ಧಾಪ್ತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />ಮಾನಾ ಜಾಕೊಬಾನ್ ಬೆರ್ಶೆಬಾಕ್ನಾ ಪರ್ಯಾನ್ ಕರ್ಲ್ಯಾನ್, ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಲೆಕಾನಿ ಅಪ್ಲಿ ಬಾಯ್ಕೊ ಪೊರಾ ಅನಿ ಬಾಬಾ ಜಾಕೊಬಾಕ್ ಪರೊಹಾನ್ ಧಾಡಲ್ಯಾ ರಥಾರ್ನಿ ಬಸ್ವುನ್ಗೆವ್ನ್ ಗೆಲ್ಯಾನಿ. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />ಜಾಕೊಬಾನ್ ಕಾನಾನ್ ದೆಶ್ಯಾತ್ ಖಮ್ವಲ್ಲಿ ಆಸ್ತಿ, ಜನಾವರಾ, ಸಗ್ಳಿ ಘೆವ್ನ್ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಕ್ ಪಾವ್ಲ್ಯಾನಿ. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />ಅಸೆ ಜಾಕೊಬ್ ಇಜಿಪ್ತಾಕ್ ಜಾತಾನಾ, ಅಪ್ಲಿ ಬಾಯ್ಕೊ ಪೊರಾ ಬಾಳಾ, ನಾತ್ರಾ, ಅನಿ ಕುಟ್ಮಾಚ್ಯಾ ಸಗ್ಳ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾಚ್ ಯೆಲೊ,<verse eid="GEN 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />ಇಜಿಪ್ತಾಕ್ ಯೆವ್ನ್ ಪಾವಲ್ಯಾ ಜಾಕೊಬಾಚೆ ಅನಿ ತೆಚಿ ಪಿಳ್ಗಿಚ್ಯಾ ಇಜ್ರಾಯೆಲಾಂಚಿ ನಾವಾ ಅಸಿ ಹಾತ್; ಜಾಕೊಬಾಚೊ ಥೊರ್ಲೊ ಲೆಕ್ ರುಬೆನ್, <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />ರುಬೆನಾಚಿ ಲೆಕಾ, ಹನೊಕ್, ಫಲ್ಲೊ, ಹೆಚ್ರೊನ್, ಅನಿ ಕರ್ಮಿ. <verse eid="GEN 46:9" /><verse number="10" style="v" sid="GEN 46:10" />ಸಿಮೊನಾಚಿ ಲೆಕಾ ಯೆಮುಯಲ್, ಯಾಮಿನ್, ಒಹದ್, ಯಾಕಿನ್, ಅನಿ ಜೊಹರ್, ಅನಿ ಕಾನಾನಾಚ್ಯಾ ಬಾಯ್ಕೊಮನ್ಸಾಕ್ನಿ ಉಪಾಜಲ್ಲೊ ಸಾವ್ಲ್. <verse eid="GEN 46:10" /><verse number="11" style="v" sid="GEN 46:11" />ಲೆವಿಚಿ ಲೆಕಾ, ಗೆರ್ಶೊನ್, ಕೆಹಾತ್, ಅನಿ ಮೆರಾರಿ. <verse eid="GEN 46:11" /><verse number="12" style="v" sid="GEN 46:12" />ಯೆಹೊದಾಚಿ ಲೆಕಾ ಯೆರ್, ಒನಾನ್, ಶೆಲಾಹ್, ಪೆರೆಜ್, ಅನಿ ಜೆರಹ್, ಹ್ಯಾತುರ್ ಎರ್ ಅನಿ ಒನಾನ್ ಮನ್ತಲ್ ಕಾನಾನ್ ದೆಶಾತುಚ್ ಮರುನ್ ಗೆಲ್ಲೆ, ಪೆರೆಜಾಚಿ ಲೆಕಾ ಹೆಚ್ರೊನ್, ಅನಿ ಹಾಮುಲ್. <verse eid="GEN 46:12" /><verse number="13" style="v" sid="GEN 46:13" />ಇಸ್ಸಾಕಾರಾಚಿ ಲೆಕಾ ತೊಲಾ, ಪುವ್ವಾ, ಅನಿ ಜೊಬ್, ಸಿಮ್ರೊನ್. <verse eid="GEN 46:13" /><verse number="14" style="v" sid="GEN 46:14" />ಜೆಬೊಲುನಾಚಿ ಲೆಕಾ ಸೆರೆದ್, ಎಲೊನ್, ಅನಿ ಯಹ್ಲೆಲ್. <verse eid="GEN 46:14" /><verse number="15" style="v" sid="GEN 46:15" />ಹೆನಿ ಸಗ್ಳ್ಯಾನಿ ಪದ್ದನ್ ಅರಾಮಿತ್ ಲೆಯಾಚ್ಯಾ ಪೊಟಾನಿ ಉಪಾಜಲ್ಲೆ, ತಿಕಾ ದಿನ್ಹಾ ಮನ್ತಲಿ ಲೆಕ್ ಬಿ ಉಪಜ್ಲಿ ಒಟ್ಟು ತೆಜ್ಯಾಕ್ನಾ ತಿಸಾರ್ ತಿನ್ ಪೊರಾ ಹೊಲಿ.<verse eid="GEN 46:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 46:16" />ಗಾದಾಚಿ ಲೆಕಾ, ಚಿಪ್ಯೊನ್, ಹಗ್ಗಿ, ಶುನಿ, ಅನಿ ಎಚ್ಬೊನ್, ಎರಿ, ಅರೊದಿ ಅನಿ ಅರೆಲಿ. <verse eid="GEN 46:16" /><verse number="17" style="v" sid="GEN 46:17" />ಅಶೆರಾಚಿ ಲೆಕಾ ಇಮ್ನಾ, ಇಸ್ವಾ, ಇಸಿವಿ, ಬೆರಿಗಾ, ಅನಿ ಹೆಂಚಿ ಭೆನ್ ಶರೆಹ್, ಬೆರಿಕಾಚಿ ಲೆಕಾ, ಹೆಬೆರ್, ಅನಿ ಮಲ್ಕಿಯೆಲ್, <verse eid="GEN 46:17" /><verse number="18" style="v" sid="GEN 46:18" />ಹೆನಿ ಲಾಬಾನಾನ್ ಅಪ್ಲಿ ಲೆಕ್ ಲೆಯಾಕ್ ದಿಲ್ಲಿ ಆಳ್ ಜಿಲ್ಪಾಕ್ ಉಪಾಜಲ್ಲೆ, ಹಿಜ್ಯಾಕ್ನಾ ಜಾಕೊಬಾಕ್ ಹೊಲ್ಲಿ ಪೊರಾ ಅನಿ ನಾತ್ರಾ ಒಟ್ಟು ಸೊಳಾ ಲೊಕಾ.<verse eid="GEN 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 46:19" />ಜಾಕೊಬಾಚಿ ಬಾಯ್ಕೊ ರಾಹೆಲಾಚಿ ಲೆಕಾ, ಜುಜೆ ಅನಿ ಬೆಂಜ್ಯಾಮಿನ್. <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />ಐಗುಪ್ತಾತ್ ಜುಜೆಕ್ ಒನ್ ದೆಶಾಚೊ ಯಾಜಕ್ ಫೊಟಿಪರಾಚಿ ಲೆಕ್ ಆಸನತ್ ಮನ್ತಲಿಕ್ ಉಪಾಜಲ್ಲಿ ಲೆಕಾ ಮನಸ್ಸೆ ಅನಿ ಎಫ್ರಾಯಿಮ್. <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />ಬೆನ್ಯಾಮಿನಾಚಿ ಲೆಕಾ, ಬಿಳಾ, ಬೆಕೆರ್, ಅಶ್ಬೆಲ್ ಅನಿ ಗೆರಾ, ನಾಮಾನ್, ಎಹಿ, ರೊಶ್, ಮುಪ್ಪಿಮ್, ಹುಪ್ಪಿಮ್, ಅನಿ ಆರ್ದ್. <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />ಹೆನಿ ಸಗ್ಳೆ ಚವ್ದಾ ಲೊಕಾ ಜಾಕೊಬಾಕ್ನಾ ರಾಹೆಲಾಕ್ ಉಪಾಜಲ್ಲಿ ಲೆಕಾ.<verse eid="GEN 46:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 46:23" />ದಾನಾಚೊ ಲೆಕ್, ಹುಶಿಮ್. <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />ನಪ್ತಾಲಿಚಿ ಲೆಕಾ, ಯಹೆಲ್, ಗುನಿ, ಯೆಚರ್ ಅನಿ ಶಿಲ್ಲೆಮ್, <verse eid="GEN 46:24" /><verse number="25" style="v" sid="GEN 46:25" />ಹೆನಿ ಲಾಬಾನಾಚಿ ಲೆಕ್ ರಾಹೆಲಾಕ್ ದಿಲ್ಲಿ ಆಳ್ ಬಿಲ್ಹಾ ಮನ್ತಲಿಚ್ಯಾ ಉಪಾಜಲ್ಲಿ ಒಟ್ಟು ಸಾತ್ ಲೊಕಾ.<verse eid="GEN 46:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />ಜಾಕೊಬಾಚಿ ಸುನ್ನಾ ಸೊಡುನ್ ಜಾಕೊಬಾಚ್ಯಾ ಪಿಳ್ಗಿತ್ ಉಪಾಜಲ್ಲಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಕ್ ಗೆಲ್ಲಿ ಲೊಕಾ ಸಾಟಾರ್ ಸಾ, <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />ತೆನಿ ಯೆವ್ಡೆಚ್ ನಸ್ತಾನಾ ಇಜಿಪ್ತಾತ್ ಜೊಸೆಪಾಕ್ ಉಪಾಜಲ್ಲೆ ದೊಗಾಬಿ, ಇಜಿಪ್ತಾಕ್ ಗೆಲ್ಲಿ ಜಾಕೊಬಾಚ್ಯಾ ಕುಟ್ಮಾಚಿ ಒಟ್ಟು ಸತ್ತರ್ ಲೊಕಾ.<verse eid="GEN 46:27" /></para>
  <para style="s">ಜಾಕೊಬ್ ಅನಿ ತೆಚಿ ಪಿಳ್ಗಿ ಇಜಿಪ್ತಾತ್</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />ಜಾಕೊಬಾನ್ ಯೆಹುದಾಕ್ ಗೊಶೆನ್ ಸಿಮೆತ್ ಜುಜೆಕ್ ಭೆಟುಚೊ ಮನುನ್ ಸಾಂಗುನ್ ಫಿಡೆಚ್ ಧಾಡ್ಲ್ಲ್ಯಾನ್, ಅನಿ ತೆನಿ ಸಗ್ಳ್ಯಾನಿ ಗೊಶೆನ್ ಸಿಮೆತ್ ಜಾವ್ನ್ ಪಾವ್ಲ್ಯಾನಿ. <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />ಜೊಸೆಪ್ ರಥ್ ಚಡುನ್ ಅಪ್ಲ್ಯಾ ಬಾಬಾ ಜಾಕೊಬಾಕ್ ಭೆಟುಕ್ ಗೊಶೆನಾಕ್ ಯೆಲೊ, ಬಾಬಾಕ್ ಬಗುನ್ ಯಾಂಗ್ ಮಾರುನ್ ಧರುನ್ ಲೈ ರಡ್ಲ್ಯಾನ್. <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />“ತಿಯಾ ಝಿತ್ತೊ ಹಾಸ್ ಮನುನ್ ಆಯ್ಕ್ಲೊ ಅನಿ ಬಗಟ್ಲೊ ಅತ್ತಾ ಮಿಯಾ ಆರಾಮಾನ್ ಮರುಕ್ ತಯಾರ್ ಹಾವ್”, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 46:30" /><verse number="31" style="v" sid="GEN 46:31" />ಮಾನಾ ಜುಜೆನ್ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ನಿ ಅನಿ ಬಾಬಾಚ್ಯಾ ಘರಾತ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಬಗುನ್, “ಮಿಯಾ ಪರೊಹಾಕ್ಡೆ ಜಾವ್ನ್ ತುಮಿ ಯೆಲ್ಲಿ ಖಬರ್ ಕಳ್ವುನ್, ಕಾನಾನಾಕ್ನಾ ಮಾಜಿ ಭಾವಾ ಅನಿ ಬಾಬಾಚ್ಯಾ ಘರಾತ್ಲೆ ಸಗ್ಳೆ ಮಾಜ್ಯಾಕ್ಡೆ ಯೆಲಾತ್, <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />ಬಕ್ರಿ ರಾಕ್ವಲಿ ಅನಿ ಶೆಳಿಯಾಂಚ್ಯಾ ತಾಂಡ್ಯಾಕ್ನಿ ಚಾರ್ವುತಲೆ ತೆಂಚೆ ಕಾಮ್, ತೆನಿ ಅಪ್ಲಿ ಗೊರಾ ಡೊರಾ ಅನಿ ತೆಂಕಾ ಹೊತ್ತೆ ಸಗ್ಳೆಬಿ ಹಾನ್ಲಾತ್” ಮನುನ್ ಸಾಂಗ್ತಾ, <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />ಪರೊಹಾನ್ ತುಮ್ಕಾ ಬಲ್ವುನ್ ತುಮ್ಚೆ ಕಾಮ್ ಕಾಯ್ ಮನುನ್ ಇಚಾರ್ಲ್ಯಾರ್, <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />ಅಮಿ ತುಜಿ ಸೆವಕಾ ಬಾರಿಕ್ ರ್‍ಹಾತಾನಾಚ್ಯಾನ್ ಆಜ್ ಪತರ್ಬಿ ಅಮ್ಚ್ಯಾ ಪುರ್ವಜ್ಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಶೆಳಿಯಾಂಚೆ ತಾಂಡೆ ಚಾರ್ವುತಲೆಚ್ ಮನುನ್ ಸಾಂಗಾ, ತನ್ನಾ ತೊ ತುಮ್ಕಾ ಗೊಶೆನ್ ಪ್ರಾಂತ್ಯಾ ವಸ್ತಿರಾವ್ಕ್ ದಿತಲೊ ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಇಜಿಪ್ತಾಚ್ಯಾಕ್ನಿ ಬಕ್ರಿ ಚಾರ್ವುತಲೆ ಮಟ್ಲ್ಯಾರ್ ಬರೆ ದಿಸಿನಾ.<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="s">ಪರೊಹ ರಾಜಾ ಜಾಕೊಬಾಕ್ ಸ್ವಾಗತ್ ಕರ್‍ತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />ಜುಜೆನ್ ಪರೊಹ್ ರಾಜಾಚ್ಯಾ ಜಗ್ಗುಳ್ ಯೆವ್ನ್, ಮಾಜೊ ಬಾಬಾ ಅನಿ ಭಾವಾ ಬಕ್ರಿ ಸಗ್ಳಿ ಜನಾವರಾ ಅನಿ ಫುರಾ ಆಸ್ತಿ ಗೆವ್ನ್ ಕಾನಾನಾಕ್ನಾ ಗೊಶೆನ್, ಪ್ರಾಂತ್ಯಾತ್ ಯೆಲಾತ್, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಅಪ್ಲ್ಯಾ ಭಾವಾತ್ನಿ ಪಾಂಚ್ ಲೊಕಾಕ್ನಿ ಬಲ್ವುನ್ ಹಾನುನ್ ಪರೊಹಾಚ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />ಪರೊಹಾನ್ ತುಮ್ಚೆ ಕಾಮ್ ಕಾಯ್ ಮನುನ್ ಇಚಾರ್‍ತಾನಾ,</para>
  <para style="p" vid="GEN 47:3">ತೆನಿ ತುಜಿ ಸೆವಕಾ ಅಮಿ ಅಮ್ಚ್ಯಾ ಪುರ್ವಜಾಂಚ್ಯಾ ಪದ್ದತಿ ಸಾರ್ಕೆ ಪೈಲೆಚ್ಯಾನ್ಬಿ ಬಕ್ರಿ ರಾಕ್ತಲೆ. <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />ಕಾನಾನ್ ದೆಶ್ಯಾತ್ ಲೈ ಬರ್‍ಗಾಲ್ ಯೆಲ್ಲ್ಯಾಸಾಟ್ನಿ ತುಮ್ಚ್ಯಾ ಸೆವಕಾಂಚಿ ಬಕ್ರಿ ಅನಿ ಜನಾವರಾಕ್ನಿ ಚಾರೊ ಗಾಯ್ ನಸ್ತಾನಾ ಉಲ್ಲೆ ಎಳ್ ಹ್ಯಾ ದೆಶ್ಯಾತ್ ರಾವ್ಕ್ ಯೆಲ್ಯಾಂವ್, ಸೆವಕಾಕ್ನಿ ಗೊಶೆನ್ ಸಿಮೆತ್ ರಾವ್ಕ್ ಒಪ್ಕಿ ದಿವಾ ಮನುನ್ ಮಾಗ್ಲ್ಯಾನಿ. <verse eid="GEN 47:4" /><verse number="5" style="v" sid="GEN 47:5" />ಪರೊಹಾನ್ ಜುಜೆಕ್ ತುಜೊ ಬಾಬಾ ಅನಿ ತುಜಿ ಭಾವಾ ತುಜ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆಲಾತ್. <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />ಇಜಿಪ್ತ್ ದೆಶ್ ತುಜ್ಯಾ ಇದ್ರಾಕ್ ಹಾಯ್, ತ್ಯಾತುರ್ ಬರೊ ಭಾಗ್ ತುಜ್ಯಾ ಬಾಬಾಕ್ ಅನಿ ಭಾವಾಕ್ನಿ ವಸ್ತಿ ರಾವ್ಕ್ ಮನುನ್ ನೆಮ್ಸುನ್ ಥವ್, ತೆನಿ ಪಾಜೆ ಹೊಲ್ಯಾರ್ ಗೊಶೆನ್ ಪ್ರಾಂತ್ಯಾತ್ ರಾಂವ್ದಿತ್, ಅನಿ ತೆಂಚ್ಯಾತ್ ಕೊನ್ ತರಿಬಿ ಲೈ ಗೊತ್ತ್ ಹೊತ್ತೆ ರಾಲ್ಯಾರ್ ಮಾಜಿ ಜನಾವರಾಬಿ ರಾಕುಂದಿತ್, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />ಮಾನಾ ಜುಜೆನ್ ಅಪ್ಲೊ ಬಾಬಾ ಜಾಕೊಬಾಕ್ ಹಾನುನ್ ಪರೊಹಾಚ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆ ಕರ್ಲ್ಯಾನ್, ತನ್ನಾ ಜಾಕೊಬಾನ್ ಪರೊಹಾಕ್ ಆಶಿರ್ವಾದ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />ಪರೊಹಾನ್ “ತುಕಾ ಕವ್ಡೆ ವರಿಸ್?” ಮನುನ್ ಇಚಾರ್‍ತಾನಾ,<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />ತನ್ನಾ ಜಾಕೊಬಾನ್ ಮಾಜ್ಯಾ ಬಾಳ್ವಿಚ್ಯಾ ಪರ್ಯಾನಾಚಿ ಎಕ್ಸೆತಿಸ್ ವರಿಸ್ ತವ್ಡಿಚ್, ಮೆಜುನ್ ಬಗಟ್ಲ್ಯಾರ್ ತೆ ಕಮ್ಮಿಚ್ ಅನಿ ಲೈ ತರಾಸಾತ್ನಿ, ಮಾಜ್ಯಾ ಪುರ್ವಜ್ ಲೊಕಾನಿ ಜಿವನ್ ಕರಲೆ ತವ್ಡೆ ದಿಸ್ಬಿ ಮಾಕಾ ಹೊವ್ಕ್ನಾ, <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />ಮನುನ್ ಪರೊಹಾಕ್ ಆಶಿರ್ವಾದ್ ದಿವ್ನ್, ತೆಚ್ಯಾ ಇದ್ರಾಕ್ನಾ ಗೆಲೊ, <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />ಪರೊಹಾ ರಾಜಾನ್ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆ ಜುಜೆನ್ ಅಪ್ಲ್ಯಾ ಬಾಬಾಕ್ ಅನಿ ಭಾವಾಕ್ನಿ ರಾವ್ಕ್ ಜಾಗೊ ನೆಮ್ಸುನ್ ತ್ಯಾತುರ್ಬಿ ಬರೊ ಹೊತ್ತೊ ರಾಮ್ಸೆಸ್ ಜಾಗ್ಯಾರ್ ಆಸ್ತಿ ದಿಲ್ಯಾನ್. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />ಬಾಬಾಕ್ ಅನಿ ತೆಚ್ಯಾ ಘರಾಚ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿಬಿ ತೆಂಚ್ಯಾ ತೆಂಚ್ಯಾ ಕುಟ್ಮಾಂಚ್ಯಾ ಪರ್ಕಾರ್ ತೆಂಕಾ ಜೆವ್ನಾಕ್ ದಿವ್ನ್ ಬಾಳಗ್ಲ್ಯಾನ್.<verse eid="GEN 47:12" /></para>
  <para style="s">ಲೈ ಮೊಟೊ ಬರ್‍ಗಾಲ್</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />ದೆಶ್ಯಾತ್ ಖೈಬಿ ಜೆವ್ನಾಕ್ ಗಾಯ್ನಸಲೊ ತವ್ಡೊ ಲೈ ವೈಟ್ ಬರ್‍ಗಾಲ್ ಹೊತ್ತೊ, ಅಸೆ ಹೊವ್ನ್ ಕಾನಾನ್ ಅನಿ ಇಜಿಪ್ತತ್ ದೆಶಾಚ್ಯಾಕ್ನಿ ಜೆವ್ನಾಕ್ ಗಾವ್ಕ್ ನಾ. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />ಜುಜೆನ್ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಚ್ಯಾಕ್ನಿ ಅನಿ ಕಾನಾನ್ ಗಾಂವ್ಚ್ಯಾಕ್ನಿ ಜೆವ್ನಾಕ್ ಪಾಜೆ ಹೊಲ್ಲೆ ಇಕಾತ್ ದಿವ್ನ್ ಪೈಸೆ ಹಾನುನ್ ಪರೊಹಾಚ್ಯಾ ಘರಾಕ್ ದಿಲ್ಯಾನ್. <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />ಇಜಿಪ್ತಾಚ್ಯಾಂಚೆ ತೆನಿ ಕಾನಾನಾಚ್ಯಾಂಚೆ ಪೈಸೆ ಸರುನ್ ಗೆಲ್ಲ್ಯಾ ತನ್ನಾ ಐಗುಪ್ತಾಚ್ಯಾನಿ ಜುಜೆಕ್ಡೆ ಯೆವ್ನ್, “ಅಮ್ಚೆ ಪೈಸೆ ಸರ್ಲೆ ತಿಯಾ ನ್ಯಾಯಾನುಚ್ ಅಮ್ಕಾ ಜೆವ್ನಾಕ್ ದಿವ್ಚೊ ಅಮ್ಕಾ ಮರುಕ್ ಸೊಡುನಕ್ಕೊ” ಮಟ್ಲ್ಯಾನಿ. <verse eid="GEN 47:15" /><verse number="16" style="v" sid="GEN 47:16" />ಜುಜೆನ್ ತೆಂಕಾ “ಪೈಸೆ ನಸ್ಲ್ಯಾರ್ ತುಮ್ಚಿ ಜನಾವರಾ ಹಾನುನ್ ದಿವಾ ತಿ ಘೆವ್ನ್ ತುಮ್ಕಾ ಜೆವ್ನಾಕ್ ದಿತಾ” ಮಟ್ಲ್ಯಾನ್, <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />ತೆನಿ ಅಪ್ಲಿ ಬಕ್ರಿ ಗೊರಾ, ಗಾಡ್ವಾ, ಘೊಡೆ ಅನಿ ಶೆಳಿಯಾ ಹೆ ಸಗ್ಳೆ ತೆಂಚ್ಯಾಕ್ನಾ ಜುಜೆನ್ ಘೆವ್ನ್ ತೆಂಕಾ ಜೆವ್ನಾಕ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />ತೊ ವರಿಸ್ಬಿ ಕಳ್ದುನ್ ತಿನ್ವೆಚ್ಯಾ ವರ್ಸಾತ್ ತೆನಿ ಜುಜೆಕ್ಡೆ ಯೆವ್ನ್, ಅಮ್ಚಿ ಜನಾವರಾ ಯಜ್ಮಾನಾಚೊ ವಾಟೊ ಹೊಲಿ ಅನಿ ಪೈಸೆಬಿ ಸರ್ಲೆ ಅತ್ತಾ ಅಮ್ಚೆ ಜಾಗೆ ಅನಿ ಆಂಗಾ ತವ್ಡಿಚ್ ಹುರ್ಲಿ ಮನುನ್ ಅಮ್ಚ್ಯಾ ಯಜ್ಮಾನಾಕ್ ನಿಪ್ವುನ್ ಥೈನಸ್ತಾನಾ ಸಾಂಗ್ತಲೆ ಹೊಲೆ, <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />ಅಮಿ ಉಪ್ಪಾಸಿ ಮರ್ತಲೆ ಅನಿ ಅಮ್ಚೆ ಜಾಗೆ ಹಾಳ್ ಪಡುನ್ ರ್‍ಹಾತಲ್ಯಾ ವಾಟ್ಯಾಕ್ ಅಮ್ಕಾ ಅನಿ ಅಮ್ಚ್ಯಾ ಜಾಗ್ಯಾಕ್ನಿ ಪರೊಹಾಕ್ ದಿವ್ನ್ ತೆಕಾ ಗುಲಾಮಾ ಹೊವ್ನ್ ರ್‍ಹಾತಾಂವ್, ಅಮಿ ಮರಿನಸ್ತಾನಾ ಜಿವಾನಿ ರಾವ್ಕ್ ಅನಿ ಜಾಗೆ ಹಾಳ್ ಪಡಿನಸ್ತಾನಾ ರಾವ್ಕ್ ಅಮ್ಕಾ ಜೆವ್ನಾಕ್ ದಿ, ಅನಿ ಫಿರುಕ್ ಬ್ಹಿಯಾ ದಿವ್ಚೆ ಮಟ್ಲ್ಯಾನಿ. <verse eid="GEN 47:19" /><verse number="20" style="v" sid="GEN 47:20" />ಜುಜೆನ್ ಇಜಿಪ್ತಾತ್ಲಿ ಫುರಾ ಜಮಿನ್ ಇಕಾತ್ ಘೆವ್ನ್ ಪರೊಹಾಚ್ಯಾ ತಾಬೆತ್ ದಿಲ್ಯಾನ್, ಬರ್‍ಗಾಲ್ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ಸಗ್ಳ್ಯಾನಿಬಿ ಅಪ್ಲಿ ಅಪ್ಲಿ ಸೆತಾ ಇಕಾತ್ ದಿಲ್ಯಾನಿ ಅಸೆ ಪಿಕ್ ಕಾಡುಕ್ ಹೊತಲಿ ಫುರಾಜಿಮಿನ್ ಪರೊಹಾಚೊ ವಾಟೊ ಹೊಲಿ, <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />ಜುಜೆನ್ ಇಜಿಪ್ತಾತ್ ಎಕ್ ತುದಿಚ್ಯಾನ್ ಅನಿ ಎಕ್ ತುದಿಪತರ್ಬಿ ಲೊಕಾಕ್ನಿ ಫುರಾ ಪರೊಹಾಕ್ ಗುಲಾಮಾ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />ಯಾಜಕಾಂಚಿ ಜಿಮಿನ್ ಮಾತ್ರಾ ಘೆವ್ಕ್ನಾ ತೆಂಕಾ ಪರೊಹಾಕ್ನಾ ಮಜತಿಚೆ ಪೈಸೆ ಗಾವ್ತಲ್ಯಾ ಪೈಸ್ಯಾನಿ ತೆನಿ ಜೆವ್ನಾಕ್ ಪಾಜೆಹೊಲ್ಲೆ ಘೆಟ್ಲ್ಯಾನಿ. <verse eid="GEN 47:22" /><verse number="23" style="v" sid="GEN 47:23" />ತನ್ನಾ ಜುಜೆನ್ ತೆಂಕಾ, ಆಯ್ಕಾ, ಅಜ್ ಮಿಯಾ ತುಮ್ಚಿ ಜಿಮಿನ್ ಪರೊಹಾಸಾಟ್ನಿ ಇಕಾತ್ ಘೆಟ್ಲಾ, ತುಮ್ಕಾ ಬ್ಹಿಯಾ ದಿತಾ ಪೆರಾ, <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />ಕಾತ್ರನಿಚ್ಯಾ ಎಳಾರ್ ಪಾಂಚಾತ್ಲೊ ಎಕ್ ಭಾಗ್ ಪರೊಹಾಕ್ ದಿವ್ಚೆ, ಹುರಲ್ಲೆ ತುಮ್ಕಾ ಅನಿ ತುಮ್ಚ್ಯಾ ಕುಟ್ಮಾಚ್ಯಾ, ಪೊರಾಕ್ನಿ ಅನಿ ಲೊಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಜೆವ್ನಾಕ್ ಥವ್ನ್ ಘೆವಾ, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 47:24" /><verse number="25" style="v" sid="GEN 47:25" />ತನ್ನಾ ತೆನಿ ತಿಯಾ ಅಮ್ಚಿ ಜಿವಾ ರಾಕ್ಲ್ಯಾಸಿ, ತುಜಿ ದಯಾ ಅಮ್ಚೆ ವರ್‍ತಿ ರಾಂವ್ದಿತ್ ತಿಯಾ ಅಮ್ಚೊ ಯೆಜ್ಮಾನ್, ಅಮಿ ಪರೊಹಾಕ್ ಗುಲಾಮಾ ಹೊವ್ನ್ ರ್‍ಹಾತಾಂವ್ ಮಟ್ಲ್ಯಾನಿ. <verse eid="GEN 47:25" /><verse number="26" style="v" sid="GEN 47:26" />ಜುಜೆನ್ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಚೆ ಖಾಯ್ದೊ ಹೊವ್ನ್ ಪಿಕೆತ್ ಪಾಂಚಾತ್ಲೊ ಎಕ್ ಭಾಗ್ ಪರೊಹಾಕ್ ಪಾವ್ಚೆ ಮನುನ್ ಕರ್ಲ್ಯಾನ್, ಆಜ್ ಪತರ್ಬಿ ಹ್ಯೊ ಖಾಯ್ದೊ ಚಾಲ್ತಿ ಹಾಯ್, ಯಾಜಕಾಂಚಿ ಜಿಮಿನ್ ಪರೊಹಾಚ್ಯಾ ವಾಟ್ಯಾಕ್ ಜಾವ್ಕ್ನಾ.<verse eid="GEN 47:26" /></para>
  <para style="s">ಜಾಕೊಬಾಚಿ ಆಕ್ರಿಚಿ ಮಾಗ್ನಿ</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಇಜಿಪ್ತಾಚ್ಯಾ ಗೊಶೆನ್ ಪ್ರಾಂತ್ಯಾತ್ ವಸ್ತಿ ರಾಲ್ಯಾನಿ, ತೆನಿ ಆಸ್ತಿ ಕರುನ್ ಲೈ ಸಾವ್ಕಾರಾ ಹೊಲ್ಯಾನಿ ಅನಿ ತೆಂಕಾ ಲೈ ಪೊರಾಬಾಳಾ ಹೊಲಿ. <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />ಇಜ್ರಾಯೆಲ್ ಇಜಿಪ್ತಾತ್ ಸತ್ರಾ ವರಿಸ್ ರಾಲೊ, ತೆ ಒಟ್ಟು ಝಿತ್ತೊ ಹೊತ್ತಿ ವರ್ಸಾ ಎಕ್ಸೆ ಚಾಳಿಸಾರ್ ಸಾತ್. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />ಜಾಕೊಬಾಕ್ ಮರ್ತಲೊ ಎಳ್ ಜಗ್ಗೊಳ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ ತೆನಿ ಅಪ್ಲೊ ಲೆಕ್ ಜುಜೆಕ್ ಬಲ್ವುಕ್ ಲಾವ್ನ್, ತುಕಾ ಮಾಜೆವರ್‍ತಿ ಪ್ರೆಮ್ ಹೊತ್ತೆ ಹೊಯ್ ಜಾಲ್ಯಾರ್, ಮಾಜ್ಯಾ ಜಾಂಗೆಚ್ಯಾ ಬುಡಿ ಹಾತ್ ಥವ್ನ್ ಆನ್ ಕರುನ್, ಮಿಯಾ ಸಾಂಗ್ತಲಿ ಗೊಸ್ಟಿಯಾ ಪ್ರೆಮಾನ್ ಅನಿ ಖರೆಪಾನಾನ್ ಚಾಲ್ವುನ್ ದಿವ್ಚೆ, ತೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್; ಮಾಕಾ ಐಗುಪ್ತಾತ್ ಮಾಟಿ ದಿವ್ ನಕ್ಕೊ, <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />ಮಿಯಾ ಮರಲ್ಲ್ಯಾ ತನ್ನಾ ಮಾಜೆ ಮ್ಹಡೆ ಹ್ಯಾ ದೆಶ್ಯಾತ್ನಾ ನ್ಹೆವ್ನ್ ಮಾಜ್ಯಾ ಪುರ್ವಜಾಂಚ್ಯಾ ಸಮಾದಿಕ್ಡೆಚ್ ಸಮಾದಿ ಕರುಚೆ,</para>
  <para style="p" vid="GEN 47:30">ತಸೆಚ್ ಕರ್ತಾ ಮನುನ್ ಮಾಜ್ಯಾ ಜಾಂಗೆಚ್ಯಾ ಬುಡಿ ಹಾತ್ ಥವ್ನ್ ಗೊಸ್ಟ್ ದಿ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್, ತೆನಿಬಿ ತಸೆಚ್ ಗೊಸ್ಟ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />ತನ್ನಾ ಜಾಕೊಬಾನ್, ತ್ಯಾ ಹಾತ್ರಾನಾತ್ ಟಕ್ಲ್ಯಾಚ್ಯಾ ಭಾಜುಕ್ ಬಾಗುನ್ ದೆವಾಕ್ ಸ್ತುತಿ ಕರ್ಲ್ಯಾನ್.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">ಎಪ್ರಾಯಿಮ್ ಅನಿ ಮನಸ್ಸೆಕ್ ಜಾಕೊಬಾಚೊ ಆಕ್ರಿಚೊ ಆಶಿರ್ವಾದ್</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />ಉಲ್ಲೊ ಎಳ್ ಹೊಲ್ಯಾ ಮಾನಾ ಬಾಬಾಕ್ ಲೈ ಹುಶ್ಯಾರ್ ನಸ್ತಾನಾ ಹಾತ್ರಾನ್ ಧರ್ಲಾ ಮನ್ತಲಿ ಖಬರ್ ಜುಜೆಕ್ ಗಾವ್ಲಿ ತೆನಿ ಅಪ್ಲ್ಯಾ ಮನಸ್ಸೆ ಅನಿ ಎಫ್ರಾಯಿಮ್ ಮನ್ತಲ್ಯಾ ಲೆಕಾಕ್ನಿ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಅಪ್ಲ್ಯಾ ಬಾಬಾಕ್ಡೆ ಯೆಲೊ. <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />ತುಜೊ ಲೆಕ್ ಜುಜೆ ಯೆಲಾ ಮನುನ್ ಸಾಂಗ್ತಾನಾ ಜಾಕೊಬ್ ಉಟುನ್ ಸಮಾಧಾನ್ ಕರುನ್ ಘೆವ್ನ್ ಹಾತ್ರಾನಾ ವರ್‍ತಿ ಬಸ್ಲೊ, <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" />ಜಾಕೊಬಾನ್ ಜುಜೆಕ್, ಮಾಕಾ ಸರ್ವಶಕ್ತ್ ದೆವಾನ್ ಕಾನಾನಾಚ್ಯಾ ಲುಜಿ ಮನ್ತಲ್ಯಾಕ್ಡೆ ದಿಸುನ್ ಆಶಿರ್ವಾದ್ ದಿವ್ನ್ ಸಾಂಗಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />ಮಿಯಾ ತುಕಾ ಪೊರಾ ದಿವ್ನ್ ತುಜಿ ಪಿಳ್ಗಿ ವಾಡ್ವುತಾ; ತುಕಾ ಲೈ ಲೊಕಾಂಚೊ ಮುಳ್ ಕರುನ್ ಥವ್ತಾ;ಅನಿ ತುಜ್ಯಾ ಮಾನಾ ಹ್ಯೊ ದೆಶ್ ತುಜ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಶಾಶ್ವತ್ ಆಸ್ತಿ ಕರುನ್ ಥವ್ತಾ ಮನುನ್ ಸಾಂಗಲ್ಯಾನ್,<verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />ಅನಿ ಮಿಯಾ ಹಿತ್ತೆ ತುಜ್ಯಾಕ್ಡೆ ಯೆವ್ಚ್ಯಾ ಅದ್ದಿ ತುಕಾ ಇಜಿಪ್ತಾತ್ ಉಪಾಜಲ್ಲಿ ದೊನ್ ಲೆಕಾ ಮಾಜಿ ಹೊವ್ಚಿ, ರುಬೆನ್ ಅನಿ ಸಿಮೆಯೊನ್ ಮಾಜಿ ಲೆಕಾ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆಚ್ ಮನಸ್ಸೆ ಅನಿ ಎಫ್ರಾಯಿಮ್ ಬಿ ಮಾಜಿ ಲೆಕಾ ಹೊವ್ಚೆ, <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />ತೆಂಚ್ಯಾ ಮಾನಾ ತುಕಾ ಹೊಲ್ಲಿ ಲೆಕಾ ತುಜಿ ಹೊವ್ನ್ ರಾಂವ್ದಿತ್, ತೆನಿ ಅಪ್ಲ್ಯಾ ಬಾವಾಂಚ್ಯಾ ಆಸ್ತಿತ್ ವಾಟೊಘೆವ್ನ್ ತೆಂಚ್ಯಾ ಖಂದಾನಾಚಿಚ್ ನಾಂವಾ ಥವ್ನ್ ಘೆಂವ್ದಿತ್. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತುಮ್ಚಿ ಬಾಯ್ ರಾಖೆಲ್, ಮಿಯಾ ಪದ್ದಾನ್ ಅರೆಮಿಕ್ನಾ ಯೆತಾನಾ ಎಪ್ರಾಹಾತಾಕ್ ಪಾವ್ಕ್ ಅಜುನ್ ಧುರ್ ರ್‍ಹಾತಾನಾಚ್, ವಾಟೆವರ್‍ತಿ ಮರುನ್ ಮಾಕಾ ಸೊಡುನ್ ಗೆಲಿ, ಅತ್ತಾ ಬೆತ್ಲೆಹೆಮ್ ಮನುನ್ ಬಲ್ವುತಲ್ಯಾ ಎಪ್ರಾಹಾತಾಕ್ ಜಾತಲ್ಯಾ ವಾಟೆಚ್ಯಾ ಭಾಜುಕ್ ತಿಕಾ ಸಮಾದಿ ಕರ್‍ಲೊ, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />ಅನಿ ಜಾಕೊಬಾನ್ ಜುಜೆಚ್ಯಾ ಲೆಕಾಕ್ನಿ ಬಗುನ್ ಹೆನಿ ಕೊನ್? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />ತನ್ನಾ ಜುಜೆನ್ ಮಾಕಾ ಹ್ಯಾ ದೆಶ್ಯಾತ್ ದೆವಾನ್ ದಿಲ್ಲಿ ಲೆಕಾ ಹಿ ಮಟ್ಲ್ಯಾನ್, ತೆಂಕಾ ಮಾಜ್ಯಾ ಜಗ್ಗೊಳ್ ಬಲ್ವುನ್ ಹಾನ್ ತೆಂಕಾ ಆಶಿರ್ವಾದ್ ದಿತಾ ಮನುನ್ ಜಾಕೊಬಾನ್ ಜುಜೆಕ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="GEN 48:9" /><verse number="10" style="v" sid="GEN 48:10" />ತೊ ಲೈ ಮ್ಹಾತಾರೊ ಹೊಲ್ಯಾಸಾಟ್ನಿ ಡೊಳೆ ದಿಸಿ ನಸ್ತಾನಾ ರ್‍ಹಾತಾನಾ ಜುಜೆನ್ ತೆಂಕಾ ಜಗ್ಗೊಳ್ ಹಾನಲ್ಯಾ ತನ್ನಾ ತೆಂಕಾ ಯಾಂಗ್ ಮಾರುನ್ ಉಪ್ಪಾ ದಿಲ್ಯಾನ್. <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />ಮಾನಾ ಜೊಸೆಪಾಕ್, ಮಿಯಾ ಅನಿ ಪರ್‍ತುನ್ ತುಜೆ ತೊಂಡ್ ಬಗ್ತಾ ಮನುನ್ ಚಿಂತುನತ್ತೊ, ಖರೆ ದೆವಾನ್ ತುಕಾ ತವ್ಡೆಚ್ ನೈ ತುಜಿ ಪಿಳ್ಗಿಬಿ ಬಗಿ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್! ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 48:11" /><verse number="12" style="v" sid="GEN 48:12" />ತನ್ನಾ ಜುಜೆನ್ ಅಪ್ಲ್ಯಾ ಲೆಕಾಕ್ನಿ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಹೊಟ್ಟ್ಯಾತ್ನಾ ಕಾಡುನ್ಗೆವ್ನ್ ಜಿಮ್ನಿ ಪತರ್ ಮಾನ್ ಬಾಗುನ್ ಬಾಬಾಕ್ ನಮಸ್ಕಾರ್ ಕರ್ಲ್ಯಾನ್.<verse eid="GEN 48:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 48:13" />ಮಾನಾ ಜುಜೆನ್ ಎಫ್ರಾಯಿಮಾಕ್ ಅಪ್ಲ್ಯಾ ಉಜ್ವ್ಯಾ ಅನಿ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಡಾವ್ಯಾ ಭಾಜುಕ್ ಅನಿ ಮನಾಸ್ಸೆಕ್ ಅಪ್ಲ್ಯಾ ಡಾವ್ಯಾ ಅನಿ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಉಜ್ವ್ಯಾ ಭಾಜುಕ್ ಜಗ್ಗೊಳ್ ಕರುನ್ ಇಬೆ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />ಮನಸ್ಸೆ ಥೊರ್ಲೊ ಲೆಕ್ ಹೊವ್ನ್ ಉಪಾಜಲ್ಲೊ ರಾಲ್ಯಾರ್ಬಿ ಜಾಕೊಬಾನ್, ಅಪ್ಲಿ ಹಾತಾ ಅಡ್ಡ್ ಕರುನ್, ಧಾಕ್ಲ್ಯಾ ಎಫ್ರಾಯಿಮಾ ವರ್‍ತಿ ಉಜ್ವೊ ಹಾತ್ ಅನಿ ಮನಸ್ಸೆ ವರ್‍ತಿ ಡಾವೊ ಹಾತ್ ಥವ್ನ್, <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />ಜುಜೆಕ್ ಅಸೆ ಮನುನ್ ಆಶಿರ್ವಾದ್ ದಿವ್ನ್,</para>
  <para style="q1" vid="GEN 48:15">ಮಾಜಿ ವಾಡ್ ವಡ್ಲಾ, ಅಬ್ರಾಹಾಮ್, ಅನಿ ಇಸಾಕ್ ಚಲುನ್ಗೆತ್ ಯೆಲ್ಲೊ ದೆವ್ ತ್ಯಾ ದೆವಾನುಚ್ ಮಾಕಾ ಬಾರಿಕ್ ರ್‍ಹಾತಾನಾಚ್ಯಾನ್ ಆಜ್ ಪತರ್ ಚಾಲ್ವುನ್ಗೆವ್ನ್ ಯೆಲಾ,<verse eid="GEN 48:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="GEN 48:16" />ಸಗ್ಳ್ಯಾ ತರಾಸಾಂತ್ನಾ ಮಾಕಾ ಸುಟ್ಕಾ ಕರುನ್ ರಾಕ್ವನ್ ಕರುನ್ ಹಾನಲೊ ಧುತ್ ಝಿಲ್ಗ್ಯಾಕ್ನಿ ಆಶಿರ್ವಾದ್ ದಿಂವ್ದಿತ್ ತೆಂಚ್ಯಾ ವೈನಾ ಮಾಜಿ ವಾಡ್ ವಡ್ಲಾ ಅಬ್ರಾಮ್ , ಇಸಾಕಾಂಚೆ ನಾವ್ ವರ್‍ತಿ ಉಟುಂದಿತ್, ಅನಿ ಹೆನಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ತೆಂಚಿ ಪಿಳ್ಗಿ ಲೈ ಹೊವ್ನ್ ವಾಡುಂದಿತ್! ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />ಜುಜೆಕ್ ಅಪ್ಲ್ಯಾ ಬಾಬಾನ್ ಎಫ್ರಾಯಿಮಾ ವರ್‍ತಿ ಉಜ್ವೊ ಹಾತ್ ಥವಲ್ಯಾ ಬರೆ ದಿಸುಕ್ನಾ, ತೆನಿ ಹಾತ್ ಕಾಡುನ್ ಎಪ್ರಾಯಿಮಾಚ್ಯಾ ಟಕ್ಲ್ಯಾ ವೈನಾ ಕಾಡುನ್ ಮನಸ್ಸೆಚ್ಯಾ ಟಕ್ಲ್ಯಾ ವರ್‍ತಿ ಥವ್ನ್, <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />ಬಾಬಾ ತಸೆ ನೈ, ಥೊರ್ಲೊ ಲೆಕ್ ಹ್ಯೊಚ್ ಹೆಜ್ಯಾ ವರ್‍ತಿ ಉಜ್ವೊ ಹಾತ್ ಥವ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 48:18" /><verse number="19" style="v" sid="GEN 48:19" />ಖರೆ ಬಾಬಾನ್ ತೆಕಾ ಒಪ್ಪಿ ನಸ್ತಾನಾ, ಗೊತ್ತ್ ಹಾಯ್ ಲೆಕಾ, ಮಾಕಾ ಗೊತ್ತ್ ಹಾಯ್, ಹೆಜ್ಯಾನ್ಬಿ ಎಕ್ ದೆಶ್ ಹೊತಾ, ಹ್ಯೊಬಿ ತಾಕ್ತಿಚೊ ಹೊತಾ ಖರೆ ಹೆಜ್ಯಾಕಿಂತಾಬಿ ಹೆಜೊ ಭಾವ್ ತಾಕ್ತಿಚೊ ಹೊತಾ, ತೆಚ್ಯಾ ಪಿಳ್ಗಿ ವೈನಾ ದೆಶ್ಯಾಂಚೊ ತಾಂಡೊಚ್ ತಯಾರ್ ಹೊತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />ತೆನಿ ತೆಂಕಾ ತ್ಯಾ ದಿಸಿ ಆಶಿರ್ವಾದ್ ದಿವ್ನ್, ಇಜ್ರಾಯೆಲ್ ತುಜ್ಯಾಕ್ಡೆ ಆಶಿರ್ವಾದ್ ದಿವ್ನ್, ದೆವ್ ತುಕಾ ಎಫ್ರಾಯಿಮ್ ಅನಿ ಮನಸ್ಸೆಕ್ ಕರಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಕರುಂದಿತ್ ಮನುನ್ ಸಾಂಗ್ತಲಿ ಗೊಸ್ಟ್ ಹೊತಾ , ಮನುನ್ ಸಾಂಗುನ್ ಎಪ್ರಾಯಿಮಾಕ್ ಮನಸ್ಸೆಚ್ಯಾ ಫಿಡೆ ಇಬೆ ಕರ್ಲ್ಯಾನ್.<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />ತನ್ನಾ ಇಜ್ರಾಯೆಲಾನ್, ಜುಜೆಕ್ ಅಬಕ್ ಮಿಯಾ ಮರ್ತಾ, ಖರೆ ದೆವ್ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾವ್ನ್ ತುಮ್ಕಾ ಅನಿ ಪರ್‍ತುನ್ ವಾಡ್ ವಡ್ಲಾಂಚ್ಯಾ ದೆಶ್ಯಾಕ್ ಪಾವ್ಸುತಾ. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />ಅನಿ ಮಿಯಾ ಕೊಯ್ತ್ಯಾನ್ ಅನಿ ಭರ್ಚಿಯಾನಿ ಅಮೊರಿಯಾಂಚ್ಯಾಕ್ನಾ ಘೆವ್ನ್ ಯೆಲ್ಲೊ ಜಾಗೊ ತುಜ್ಯಾ ಭಾವಾಂಚ್ಯಾ ಕಿಂತಾಬಿ ಲೈ ತುಕಾಚ್ ದಿತಾ, ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">ಜಾಕೊಬಾಚಿ ಆಕ್ರಿಚಿ ಬೊಲ್ನಿಯಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />ತನ್ನಾ ಜಾಕೊಬಾನ್ ಸಗ್ಳಿ ಲೆಕಾ ಮನುನ್ಗೆತಲೆ ತುಮಿ ಸಗ್ಳ್ಯಾಕ್ನಿಬಿ ಬಲ್ವುನ್ ಎಕಾಕ್ಡೆ ಗೊಳಾ ಹೊವಾ, ಯೆತಲ್ಯಾ ದಿಸಾತ್ನಿ ಹೊತಲೆ ಮಿಯಾ ತುಮ್ಕಾ ಕಳ್ವುತಾ.<verse eid="GEN 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />ಜಾಕೊಬಾಚ್ಯಾ ಲೆಕಾನೊ ತುಮಿ ಗೊಳಾಹೊವ್ನ್ ಆಯ್ಕಾ, ತುಮ್ಚೊ ಬಾಬಾ ಇಜ್ರಾಯೆಲ್ ಸಾಂಗ್ತಲ್ಯಾಕ್ ಕಾನ್ ದಿವಾ,<verse eid="GEN 49:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="GEN 49:3" />ರುಬೆನಾ ತಿಯಾ ಮಾಜೊ ಥೊರ್ಲೊ ಲೆಕ್, ಅನಿ ಮಾಜಿ ಬಳ್ ಅನಿ ಮಾಜ್ಯಾ ಬಳೆಚಿ ಪೈಲಿ ವಳಕ್, ಮಾಜ್ಯಾ ಗೌರವಾ ಚೊ ಕಾರನ್, ಅನಿ ಬರೆ ಪಾನಾಚೊ ಬಿ ತಿಯಾಚ್, <verse eid="GEN 49:3" /><verse number="4" style="v" sid="GEN 49:4" />ಖರೆ ತಿಯಾ ಹಂವ್ವಾರ್ಯಾಚ್ಯಾ ಪಾನಿಯಾ ಗತಿನ್ ಹೊತ್ತೊ ತಿಯಾ ಮೊಟ್ಟ್ಯಾ ಜಾಗ್ಯಾರ್ ರಾಯ್ನೆಯ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತುಜ್ಯಾ ಬಾಬಾಚೊ ಮಾಂಚೊ ಚಡುನ್ ಬಸ್ಟ್ ಗಾರ್ ಕರ್‍ಲೆ, ಅನಿ ಮಾಜೆ ಹಾತ್ರಾನ್ ಚೆಡ್ಲೆಯ್;<verse eid="GEN 49:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="GEN 49:5" />ಸಿಮೆಯೊನ್ ಅನಿ ಲೆವಿ ಭಾವ್ ಭಾವಾ, ತೆಂಚ್ಯಾ ಘರಾತ್ನಿ ತೆಂಚೆ ಕೊಯ್ತೆ ಕ್ರುರ್ ಪಾನಾಚಿ ಹಾತಿಯಾರಾ ಹೊವ್ನ್ ಹಾತ್.<verse eid="GEN 49:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="GEN 49:6" />ಮಾಜ್ಯಾ ಜಿವಾ ತೆಂಚ್ಯಾ ಗುಟ್ಟಾಚ್ಯಾ ಯೆವ್ಜನಿಯಾಕ್ನಿ ಮಿಳು ನಕ್ಕೊ, ತೆಂಚ್ಯಾ ಘುಟ್ಟಾಚ್ಯಾ ಬೈಟೆಕಾತ್ ಮಿಳುನಕ್ಕೊ, ಮಾಜ್ಯಾ ಗೌರವಾ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಎಕ್ ಹೊವ್ ನಕ್ಕೊ, ತೆನಿ ಅಪ್ಲ್ಲ್ಯಾ ಗುಂಗೆತ್ ಬೈಲಾಕ್ನಿ ಘಾವ್ ಕರ್ಲಾತ್, ಅನಿ ರಾಗಾನಿ ಮಾನ್ಸಾಕ್ ಜಿವ್ ಕಾಡ್ಲ್ಯಾನಿ.<verse eid="GEN 49:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="GEN 49:7" />ತೆಂಚೊ ರಾಗ್ ಭಯಂಕಾರ್ ಅನಿ ತೆಂಚೊ ಅವ್ತಾರ್ ಕ್ರುರ್ ಹೊವ್ನ್ ಹಾಯ್, ತೆ ಶಾಪಾಕ್ ಗುರಿ ಹೊತಾತ್, ತೆಂಕಾ ಜಾಕೊಬಾಚ್ಯಾ ಪಿಳ್ಗಿತ್ನಾ ವಾಟೆಕರುನ್ ಇಜ್ರಾಯೆಲಾತ್ ಯೆಗ್ಳುನ್ ಸೊಡ್ತಾ.<verse eid="GEN 49:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="GEN 49:8" />ಜೆಹುದಾ, ತುಜಿ ಬಾವಾ ತುಕಾ ಹೊಗ್ಳಾಪ್ ಕರ್‍ತಾತ್, ತುಜೊ ಹಾತ್ ದುಸ್ಮನಾಂಚ್ಯಾ ಮಾನೆ ವರ್‍ತಿ ರ್‍ಹಾತಾ, ತುಜ್ಯಾ ಬಾಬಾಚಿ ಲೆಕಾ ತುಕಾ ಪಾಯ್ ಪಡ್ತಾತ್.<verse eid="GEN 49:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="GEN 49:9" />ಜೆಹುದಾ ಸಿಂವಾಚೊ ಪೆಟೊ ಹೊವ್ನ್ ಹಾಯ್, ಮಾಜ್ಯಾ ಲೆಕಾ ಕೊಳ್ಳಾತ್ನಾ ವರ್‍ತಿ ಯೆಲೈ, ತೊ ಸಿಂವಾ ಬಾಸೆನ್ ಅನಿ ದಾಂಡ್ಗ್ಯಾ ಸಿಂವಾಬಾಸೆನ್ ಶಿಕಾರಿಕ್ ಮುದ್ದಾಹೊವ್ನ್ ಬಸ್ಲಾ, ಕೊನ್ ತೊ ತೆಕಾ ಕಿಡ್ವುತಲೊ?<verse eid="GEN 49:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="GEN 49:10" />ರಾಜ್ಯಾಚೊ ದಾಂಡೊ ಧರ್ನಾರೊ ಶಿಲೊವಿಕ್ನಾ ಯೆಯ್ ಪತರ್ ತೊ ಜೆಹುದಾಚ್ಯಾ ಹಾತಿತ್ನಾ ಚುಕಿನಾ, ಚಪ್ಪ್ಯಾಚೊ ದಾಂಡೊ ತೆಚ್ಯಾ ಪಾಂಯಾಂಚ್ಯಾಕ್ನಾ ಧುರ್ ಜಾಯ್ನಾ, ದುಸ್ರೆ ರಾಜಾ ಅಪ್ಲೊ ಅಧಿಕಾರ್ ತೆಜ್ಯಾಕ್ಡೆ ಹಾನುನ್ ವಿಧೆಯ್ ಹೊವ್ನ್ ಮಾನ್ ಬಾಗ್ವುತಾತ್.<verse eid="GEN 49:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="GEN 49:11" />ಅಪ್ಲ್ಯಾ ದಾಂಡ್ಗ್ಯಾ ಗಾಡ್ವಾಕ್ ದರಾಕ್ಷಾಚ್ಯಾ ಯೆಲಿಕ್ ಭಾಂದ್ಲಾ ಅನಿ ವಿಶಿಸ್ಟ್ ದರಾಕ್ಷಾಚ್ಯಾ ಯೆಲಿಕ್ ಗಾಡ್ವಾಚ್ಯಾ ಪೆಟ್ಯಾಕ್ ಭಾಂದ್ತಾ, ಅನಿ ಅಪ್ಲಿ ಅಂಗಿ ವಾಯ್ನಾತ್ ಬುಡ್ವು ತಾ ಅನಿ ವಾಯ್ನಾತ್ ಅಪ್ಲೆ ಕಪ್ಡೆ ಧುತಾ.<verse eid="GEN 49:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="GEN 49:12" />ತೆಚೆ ಡೊಳೆ ವಾಯ್ನಾಚ್ಯಾ ರಸಾ ವೈನಾ ತಾಂಬ್ಡೆ ಹೊವ್ನ್ ರ್‍ಹಾತಾತ್; ಅನಿ ತೆಚಿ ದಾತಾ ದುದ್ದಾನ್ ಗೊರಿ ಹೊವ್ನ್ ರ್‍ಹಾತಾತ್. <verse eid="GEN 49:12" /><verse number="13" style="v" sid="GEN 49:13" />ಜೆಬೊಲೊನ್ ಸಮುಂದರಾಚ್ಯಾ ರೆತಿತ್ ವಸ್ತಿ ರ್‍ಹಾತಾ, ಅನಿ ತೊ ಮೊಟ್ಟ್ಯಾ ಢೊನಾಂಚೊ ಇಬೆ ರಾತಲೊ ಜಾಗೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ತೆಚಿ ಘಡಿ ಸಿದೊನಾಕ್ ಪಾವ್ತಾ.<verse eid="GEN 49:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="GEN 49:14" />ಇಸ್ಸಾಕಾರ್ ದೊನ್ ಗೊಟ್ಯಾಂಚ್ಯಾ ಮದ್ದಿ ನಿಜ್ತಲೊ ಲೈ ಬಳಾಚೊ ಗಾಡಾವ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="GEN 49:14" /><verse number="15" style="v" sid="GEN 49:15" />ಆರಾಮ್ ಪಾನ್ ಬರೆ ಮನುನ್ ದೆಶ್ ಸುಂದರ್ ಮನುನ್ ಬಗುನ್, ಅಪ್ಲಿ ಡುಬ್ಬರ್ ವಜ್ಜೆ ವಾವುಕ್ ಮನುನ್ ಬಾಗ್ವುನ್ ಗುಲಾಮ್ ಗಿರಿಚಿ ಸೆವಾ ಕರ್ತಾ.<verse eid="GEN 49:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="GEN 49:16" />ದಾನ್ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಪಿಳ್ಗಿಯಾಕ್ನಿ ಮಿಳುನ್ ಅಪ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ ಝಡ್ತಿ ಕರ್ತಾ. <verse eid="GEN 49:16" /><verse number="17" style="v" sid="GEN 49:17" />ದಾನ್ ವಿಶ್ಯಾಚೊ ಸಾಪ್ ಹೊವ್ನ್ ಹಾಯ್, ತೊ ಘೊಡ್ಯಾಚ್ಯಾ ಗೆಳಾ ಚಾವ್ಲ್ಯಾರ್ ವರ್‍ತಿ ಚೆಡಲೊ ಡಬ್ಬುಚ್ ಪಡ್ತಾ.<verse eid="GEN 49:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="GEN 49:18" />ಹೆ ದೆವಾ! ತಿಯಾ ರಾಕುಚೆ ಮನುನ್ ಮಿಯಾ ವಾಟ್ ಬಗುಲ್ಲಾ. <verse eid="GEN 49:18" /><verse number="19" style="v" sid="GEN 49:19" />ಗಾದಾ ವರ್‍ತಿ ಯುದ್ದ್ ಕರ್‍ತಲ್ಯಾ ತಾಂಡ್ಯಾಚ್ಯಾ ಹಾತಿತ್ ಗಾವ್ತಾ, ಖರೆ ತೊ ತೆಂಕಾ ಫಾಟ್ ಲಾಗುನ್ ಪಳ್ಸುನ್ ಘಾಲ್ತಾ.<verse eid="GEN 49:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="GEN 49:20" />ಅಶೆರಾಕ್ ದಾನ್ಯಾನಿ ಸಾವ್ಕಾರ್ ಹೊತಾ ತೊ ರಾಜಾಕ್ ಬರೆ ಜೆವಾನ್ ದಿತಾ.<verse eid="GEN 49:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="GEN 49:21" />ನಪ್ತಾಲಿ ಸುಂದರ್ ಚಿತಾಳ್ ಗತಿನ್ ಹಾಯ್, ತೊ ಮೆಚ್ಕಿಚಿ ಬೊಲ್ನಿಯಾ ಬೊಲ್ತಾ.<verse eid="GEN 49:21" /></para>
  <para style="q2">
    <verse number="22" style="v" sid="GEN 49:22" />ಜುಜೆ ಫಳಾನಿ ಬರಲ್ಯಾ ಯೆಲಿ ಗತಿನ್, ತೊ ಭಾಂಯಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ಹೊತ್ತೊ ಫಳಾನಿ ಭರಲ್ಯಾ ಯೆಲಿಚಿ ಟಾಳಿಯಾ ಪಗ್ಳುನ್ ಭಿತ್ತ್ ದಾಟ್ತಾತ್. <verse eid="GEN 49:22" /><verse number="23" style="v" sid="GEN 49:23" />ಭರ್ಚಿಕಾರಾ ತೆಕಾ ಆಕ್ರಮನ್ ಕರ್ಲಾತ್, ತೆಚ್ಯಾ ವರ್‍ತಿ ಕುಶ್ಡೆ ಪಾನಾನ್ ಭರ್ಚಿಯಾ ಮಾರ್‍ತಾತ್. <verse eid="GEN 49:23" /><verse number="24" style="v" sid="GEN 49:24" />ಖರೆ ಜಾಕೊಬಾಚ್ಯಾ ಪಿಳ್ಗಿಕ್ ರಾಕ್ವನ್ ಕರ್‍ತಲ್ಯಾಚ್ಯಾ ಬಳೆವೈನಾ ಅನಿ ಇಜ್ರಾಯೆಲಾಚೊ ಕುರ್ಬುರ್ ಅನಿ ರಾಕ್ವನ್ ಕಾರ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾಚ್ಯಾ ವೈನಾ ತೆಚಿ ಭರ್ಚಿ ಘಟ್ ಇಬೆ ರಾಲಿ.<verse eid="GEN 49:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="GEN 49:25" />ತುಜ್ಯಾ ಪುರ್ವಜಾಂಚೊ ದೆವ್ ತುಕಾ ಮಜತ್ ಕರುಂದಿತ್, ಸಗ್ಳೆ ಕರುಕ್ ಶಕ್ತ್ ಹೊತ್ತೊ ದೆವ್ ತುಕಾ ಮಳ್ಬಾಕ್ನಾ ಪಾವ್ಸ್ ಅನಿ ಜಿಮ್ನಿಚ್ಯಾ ಬುಡ್ನಾ ಝರಿಯಾ ಪಿಳ್ಗಿ ಅನಿ ಗರ್ಬಾಚೊ ಆಶಿರ್ವಾದ್ ದಿಂವ್ದಿತ್.<verse eid="GEN 49:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="GEN 49:26" />ತುಜ್ಯಾ ಬಾಬಾಚಿ ಆಶಿರ್ವಾದಾ, ತುಜ್ಯಾ ವಾಡ್ ವಡ್ಲಾಂಚ್ಯಾ ಆಶಿರ್ವಾದಾಂಚ್ಯಾ ಕಿಂತಾಬಿ ಲೈ ಹೊವ್ನ್ ರ್‍ಹಾತಾತ್, ಆರಂಭಾಚ್ಯಾ ಮಡ್ಡಿಯಾಂಚ್ಯಾಕ್ನಾ ಅನಿ ಸದಾ ಸರ್ವತಾಕ್ ಜಗಾಕ್ನಾ ಹೊತಲ್ಯಾ ಆಶಿರ್ವಾದಾನಿ ಅಪ್ಲ್ಯಾ ಭಾವಾಂಚೊ ಧನಿ ಹೊಲ್ಲ್ಯಾ ಜುಜೆಚ್ಯಾ ಟಕ್ಲ್ಯಾ ವರ್‍ತಿ ಭರುಂದಿತ್.<verse eid="GEN 49:26" /></para>
  <para style="q2">
    <verse number="27" style="v" sid="GEN 49:27" />ಬೆಂಜ್ಯಾಮಿನ್ ಬಕ್ರಿ ಧರ್ತಲ್ಯಾ ಝುಲ್ ಕುತ್ರ್ಯಾ ಸಾರ್ಕೊ ಹಾಯ್, ಚೊರಲ್ಲೆ ಸಕ್ಕಾಳ್ಪಿಡೆ ಖಾತಾ, ಅನಿ ಸಾಂಚೆಕ್ಡೆ ಚೊರಿ ಕರಲೆ ವಾಟುನ್ ದಿತಾ.<verse eid="GEN 49:27" /></para>
  <para style="q2">
    <verse number="28" style="v" sid="GEN 49:28" />ಹೆನಿ ಸಗ್ಳ್ಯಾನಿ ಇಜ್ರಾಯೆಲಾಚಿ ಬಾರಾ ಖಂದಾನಾ, ಅನಿ ತೆಂಚ್ಯಾ ಬಾಬಾನ್ ತೆಂಕಾ ದಿಲ್ಲೊ ಆಶಿರ್ವಾದ್ ಹ್ಯೊಚ್, ಹರ್ ಎಕ್ ಕುಲಾಕ್ ಎಕೆಕ್ ಆಶಿರ್ವಾದ್ ದಿಲ್ಯಾನ್.<verse eid="GEN 49:28" /></para>
  <para style="s">ಜಾಕೊಬಾಚೆ ಮರಾನ್ ಅನಿ ಮಾಟಿ</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />ಅನಿ ತೆನಿ ತೆಂಕಾ ಹುಕುಮ್ ದಿವ್ನ್ ಸಾಂಗಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ಮಿಯಾ ಮಾಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಎಕ್ ಹೊತಾ, ಮಾಜ್ಯಾ ವಾಡ್ ವಡ್ಲಾಂಚೆ ವಾಂಗ್ಡಾ ಹಿತ್ತಿಯಾಂಚ್ಯಾ ಎಪ್ರೊನಾಚ್ಯಾ ಸೆತಾತ್ನಿ ಹೊತ್ತ್ಯಾ ಡೊಂಬಾತ್ ಮಾಕಾ ಮಾಟಿ ದಿವಾ, <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />ಕಾನಾನ್ ದೆಶ್ಯಾತ್ ಮಾಮ್ರೆಕ್ ಇದ್ರಾಕ್ ಹೊತ್ತ್ಯಾ ಮೆಕ್ಬೆಲ್ ಮನ್ತಲ್ಯಾ ಸೆತಾತ್ ಹೊತ್ತ್ಯಾ ಅಬ್ರಾಮಾನ್ ಸೆತ್ಯಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಸಮಾದಿಕ್ ಸಾಟ್ನಿ ಎಪ್ರೊನಾಕ್ನಾ ಇಕಾತ್ ಘೆಟಲ್ಯಾನ್. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />ಥೈ ಅಬ್ರಾಹಾಮಾಕ್ ಅನಿ ತೆಚಿ ಬಾಯ್ಕೊ ಸಾರಾಕ್ ಮಾಟಿ ದಿಲಾತ್ ಅನಿ ಥೈ ಇಸಾಕ್ ಅನಿ ತೆಚಿ ಬಾಯ್ಕೊ ರೆಬೆಕಾಕ್ಬಿ ಮಾಟಿ ದಿಲಾತ್ ಮಿಯಾ ಲೆಯಾಕ್ಬಿ ಥೈಚ್ ಮಾಟಿ ದಿಲಾ. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />ತೆ ಸೆತ್ ಅನಿ ತ್ಯಾತುರ್ ಹೊತ್ತೊ ಡೊಂಬೊ ಹಿತ್ತಿಯಾಂಚ್ಯಾ ಪೊರಾಂಚ್ಯಾಕ್ನಾ, ಇಕಾತ್ ಘೆಟಲ್ಲೆ ಥೈಚ್ ಮಾಕಾಬಿ ಮಾಟಿ ದಿವ್ಚೆ ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 49:32" /><verse number="33" style="v" sid="GEN 49:33" />ಜಾಕೊಬಾನ್ ಅಪ್ಲ್ಯಾ ಲೆಕಾಕ್ನಿ ಹುಕುಮ್ ದಿವ್ನ್ ಹೊಲ್ಯಾ ಮಾನಾ ಅಪ್ಲಿ ಪಾಂಯಾ ಮಾಚ್ಯಾ ವರ್‍ತಿ ಮುದ್ದಾಕರುನ್ ಘೆವ್ನ್ ಪ್ರಾನ್ ಸೊಡುನ್, ಅಪ್ಲ್ಯಾ ವಾಡ್ ವಡ್ಲಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಎಕ್ ಹೊಲೊ.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />ತನ್ನಾ ಜುಜೆನ್ ಅಪ್ಲ್ಯಾ ಬಾಬಾಚ್ಯಾ ತೊಂಡಾ ವರ್‍ತಿ ಡಬ್ಬ್ ಪಡುನ್ ಲೈ ರಡುನ್ ತೆಕಾ ಉಪ್ಪಾ ದಿಲ್ಯಾನ್. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />ಮಾನಾ ಅಪ್ಲ್ಯಾ ಆಳಾತ್ನಿ ಮಡ್ಯಾಕ್ ನ್ಹಾವಸ್ತಲ್ಯಾಕ್ನಿ ಬಲ್ವುನ್ ಬಾಬಾಚ್ಯಾ ಮಡ್ಯಾಕ್ ಬರ್‍ಯಾ ವಾಸೆಚ್ಯಾ ತೆಲಾನಿ ನ್ಹಾವ್ಸುನ್ ತಯಾರ್ ಕರುಕ್ ಹುಕುಮ್ ದಿಲ್ಯಾನ್, ತೆನಿ ತಸೆಚ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />ಚಾಳಿಸ್ ದಿಸಾಂಚ್ಯಾ ಪತರ್ಬಿ ಬರ್‍ಯಾ ವಾಸೆಚ್ಯಾ ತೆಲಾನಿ ನ್ಹಾವಸ್ತಲಿ ಪದ್ದತ್ ಹೊತ್ತಿ ತಸೆ ಹೊವ್ನ್ ತೆಕಾ ತವ್ಡೆ ದಿಸ್ಬಿ ನ್ಹಾವ್ಸುನ್ ಹೊಲೆ, ಅನಿ ಸತ್ತರ್ ದಿಸ್ ಪತರ್ ಬಿ ಇಜಿಪ್ತಾತ್ ಜಾಕೊಬಾಸಾಟ್ನಿ ರಡ್ಲ್ಯಾನಿ ಅನಿ ದುಕ್ಕಾಚಿ ದಿಸಾ ಆಚರನ್ ಕರ್ಲ್ಯಾನಿ.<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />ದುಕ್ಕಾಚಿ ದಿಸಾ ಕಳದ್ಲ್ಯಾ ಮಾನಾ ಜುಜೆನ್ ಪರೊಹಾಚ್ಯಾ ಘರ್ಚ್ಯಾ ಲೊಕಾಕ್ನಿ ತುಮಿ ದಯಾ ಕರುನ್ ಮಾಜಿ ಗೊಸ್ಟಿಯಾ ಪರೊಹಾಕ್ ಸಾಂಗಾ, <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />ಮಾಜ್ಯಾ ಬಾಬಾನ್ ಮರುಚ್ಯಾ ಪೈಲೆಚ್ ಅಪ್ನಿ ಕಾನಾನ್ ದೆಶ್ಯಾತ್ ತಯಾರ್ ಕರುನ್ ಥವಲ್ಯಾ ಸಮಾದಿತ್ ಅಪ್ಲಿ ಮಾಟಿ ಕರುಚೆ ಮನುನ್ ಶಪತ್ ಕರ್ಸುನ್ಗೆಟಲ್ಯಾನ್, ತಸೆ ಹೊವ್ನ್ ದಯಾ ಕರುನ್ ಮಿಯಾ ಜಾವ್ನ್ ಬಾಬಾಚಿ ಮಾಟಿ ಕರುನ್ ಯೆವ್ಕ್ ಒಪ್ಕಿ ದಿವ್ಚೆ, ಮಾನಾ ಮಿಯಾ ಪರ್‍ತುನ್ ಯೆತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />ಪರೊಹಾನ್ ಹಿ ಗೊಸ್ಟ್ ಆಯ್ಕುನ್ ಜುಜೆಕ್, “ತುಜ್ಯಾ ಬಾಬಾಕ್ ಗೊಸ್ಟ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತಿಯಾ ಜಾವ್ನ್ ಮಾಟಿ ಕರುನ್ ಯೆ” ಮನುನ್ ಒಪ್ಕಿ ದಿಲ್ಯಾನ್.<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />ಜುಜೆ ಅಪ್ಲ್ಯಾ ಬಾಬಾಕ್ ಮಾಟಿ ಕರುಕ್ ಜಾತಾನಾ, ತೆಜ್ಯಾವಾಂಗ್ಡಾ ಪರೊಹಾಚ್ಯಾ ಘರಾಚೆ ಸಗ್ಳೆ ಜಾನಾ ಅನಿ ರಾಜಾಚ್ಯಾ ಘರ್ಚಿ ಮುಖಂಡಾ, ಸಗ್ಳಿಲೊಕಾ ಇಜಿಪ್ತಾಚಿ ಮುಖಂಡಾ, <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />ಅನಿ ಜೊಸೆಪಾಚ್ಯಾ ಘರ್ಚಿ ಸಗ್ಳಿ ಲೊಕಾ ಅನಿ ತೆಚಿ ಭಾವಾ ಗೆಲಿ, ತೆನಿ ಅಪ್ಲಿ ಬಾಯ್ಕಾ ಪೊರಾ ಅನಿ ಜನಾವರಾ ತವ್ಡಿಚ್ ಗೊಶೆನಾತ್ ಸೊಡುನ್ ಗೆಲ್ಯಾನಿ. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />ಅನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ರಥಾ ಅನಿ ಘೊಡ್ಕಿಯಾ ಚಾಲ್ವುತಲಿ ಲೊಕಾಬಿ ಹೊತ್ತಿ, ಅಸೆ ಲೈ ಮೊಟೊ ಲೊಕಾಂಚೊ ತಾಂಡೊಚ್ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಗೆಲೊ.<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />ತೆನಿ ಜೊರ್ದಾನ್ ನ್ಹಯಿಚ್ಯಾ ಪೈಲ್ಯಾನ್ ಹೊತ್ತ್ಯಾ ಅಟಾದ್ ಮನ್ತಲ್ಯಾ ಖಳ್ಯಾತ್ ಯೆವ್ನ್ ಲೈ ರಡ್ಲ್ಯಾನಿ, ಅನಿ ಜಾಕೊಬಾನ್ ಬಾಬಾಸಾಟ್ನಿ ಸಾತ್ ದಿಸಾಚೆ ದುಕ್ಕಾಚೆ ಆಚರನ್ ಕರ್ಲ್ಯಾನ್. <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />ಅಟಾದ್ ಮನ್ತಲ್ಯಾ ಖಳ್ಯಾತ್ ಹೊಲ್ಲೆ ದುಕ್ಕಾಚೆ ಆಚರನ್ ಬಗುನ್ ತ್ಯಾ ಗಾಂವ್ಚ್ಯಾ ಕಾನಾನ್ ಲೊಕಾನಿ, ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಯೆಲ್ಲೆ ಹೆ ದುಕ್ಕಾಚೆ ಆಚರನ್ ಲೈ ವಿಶೆಸ್ ಹಾಯ್ ಮಟ್ಲ್ಯಾನಿ! ಹೆಜ್ಯಾ ವೈನಾ ಜೊರ್ದಾನ್ ನ್ಹಯ್ಚ್ಯಾ ಪೈಲ್ಯಾನ್ ಹೊತ್ತ್ಯಾ ಹ್ಯಾ ಜಾಗ್ಯಾಕ್ ಅಬೆಲ್ ಮಿಚ್ರಯಿಮ್ ಮನುನ್ ನಾವ್ ಪಡ್ಲೆ.<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />ಜಾಕೊಬಾಚ್ಯಾ ಲೆಕಾನಿ ಬಾಬಾಚ್ಯಾ ಹುಕುಮಾ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನಿ, <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />ತೆಚಿ ಮಡೆ ಕಾನಾನ್ ದೆಶ್ಯಾಕ್ ಉಕ್ಲುನ್ ನ್ಹೆವ್ನ್ ಮೆಕ್ಬೆಲ್ ಮನ್ತಲ್ಯಾ ಮಾಳ್ ಜಾಗ್ಯಾರ್ ಹೊತ್ತ್ಯಾ ಡೊಂಬಾತ್ ಮಾಟಿ ಕರ್ಲ್ಯಾನಿ, ಮಾಮ್ರೆಚ್ಯಾ ಇದ್ರಾಚೊ ಅನಿ ತೆಚ್ಯಾ ಅಜುಭಾಜುಕ್ ಹೊತ್ತೊ ತೊ ಜೊಗೊ ಅಬ್ರಾಮಾನ್ ಹಿತ್ತಿಯಾಂಚ್ಯಾ ಎಪ್ರೊನಾಕ್ನಾ ಸೆತ್ಯಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಸ್ವತಾಕ್ ಸಮಾದಿಚೊ ಜಾಗೊ ಕರುನ್ ಇಕಾತ್ ಘೆಟಲ್ಯಾನ್. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />ಬಾಬಾಕ್ ಮಾಟಿ ಕರುನ್ ಹೊಲ್ಯಾ ಮಾನಾ ಜುಜೆ, ತೆಚಿ ಭಾವಾ ಅನಿ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಯೆಲ್ಲಿ ಫುರಾ ಲೊಕಾ ಜಾಕೊಬಾಚ್ಯಾ ಮರ್ನಾಚ್ಯಾ ಮಾನಾ ಕರ್ತಲಿ ದಿಸಾ ಕರುಕ್ ಮನುನ್ ಇಜಿಪ್ತಾಕ್ ಫಾಟಿ ಪರ್‍ತುನ್ ಗೆಲೆ.<verse eid="GEN 50:14" /></para>
  <para style="s">ಜುಜೆನ್ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ನಿ ಗೊಸ್ಟ್ ದಿಲ್ಲೆ</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />ಬಾಬಾ ಮರ್ಲ್ಯಾ ಮಾನಾ ಜುಜೆಚ್ಯಾ ಭಾವಾನಿ ತೊ ಅಮ್ಕಾ ಬರೊ ಕರಿನಸಿಲ್ ಅನಿ ಅಮಿ ತೆಕಾ ಕರಲ್ಯಾ ತರಾಸಾಕ್ ಪರ್‍ತುನ್ ತರಾಸ್ ದಿಯ್ಲ್, ಮನುನ್ ಅಪ್ಲ್ಯಾ ಯೆವ್ಡ್ಯಾತುಚ್ ಬೊಲುನ್ ಘೆಟ್ಲ್ಯಾನಿ. <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />ತಸೆ ಹೊವ್ನ್ ತೆನಿ ಜುಜೆಕ್; ತುಜೊ ಬಾಬಾ ಮರುಚ್ಯಾ ಪೈಲೆ ಅಮ್ಕಾ ಹುಕುಮ್ ದಿಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />ಅಮಿ ತುಜಿ ಭಾವಾ ಹೊವ್ನ್ ತುಕಾ ವಾಯ್ಟ್ ಕರಲ್ಲೆ ಖರೆ ಹಾಯ್, ಖರೆ ಅಮ್ಚಿ ಚುಕ್ ಅನಿ ಅಪ್ರಾದಾ ಮಾಪಿ ಕರ್ ಮನುನ್ ಮಾಗಾ ಮಟಲ್ಯಾನ್ ತಸೆ ಹೊವ್ನ್ ಅಮಿ ತುಜ್ಯಾಕ್ಡೆ ಅಮಿ ಕರಲಿ ಚುಕ್ ಕ್ಷಮಾ ಕರ್ ಮನುನ್ ಮಾಗ್ತಾಂವ್, ಮನುನ್ ಸಾಂಗುನ್ ಧಾಡ್ಲ್ಯಾನಿ, ಜುಜೆನ್ ಹಿ ಬೊಲ್ನಿ ಆಯ್ಕುನ್ ರಡ್ಲ್ಯಾನ್.<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />ಅನಿ ಯೆವ್ಡೆಚ್ ನಸ್ತಾನಾ ಭಾವಾ ಸಗ್ಳಿ ಅಪ್ನಿಚ್ ಯೆವ್ನ್ ಜುಜೆಕ್ ಪಾಯ್ ಪಡ್ಲ್ಯಾನಿ, ಅನಿ “ಅಬಕ್ ಅಮಿ ತುಜಿ ಗುಲಾಮಾ” ಮಟ್ಲ್ಯಾನಿ.<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />ಖರೆ ಜುಜೆನ್ ತೆಂಕಾ ಭಿಂವ್ನಕಾಸಿ ಮಿಯಾ ದೆವಾಚ್ಯಾ ಜಾಗ್ಯಾರ್ ಹಾವ್ ಕಾಯ್? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />ತುಮಿ ತರ್ ಮಾಕಾ ಲುಕ್ಷಾನ್ ಕರುಚೆ ಮನುನ್ ಬಗ್ಲ್ಯಾಸಿ, ಖರೆ ದೆವಾನ್ ಬರೆಚ್ ಹೊವ್ಚೆ ಮನುನ್ ಬಗ್ಲ್ಯಾನ್, ಅನಿ ಹೆಜ್ಯಾ ವೈನಾ ಲೈ ಲೊಕಾಂಚಿ ಜಿವಾ ಹುರ್ಲಿ, ಅನಿ ಆಜ್ ಪತರ್ ಬಿ ತೆ ಕಾಮ್ ಚಲುನ್ಗೆತ್ ಹಾಯ್, <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />ತಸೆ ಹೊವ್ನ್ ತುಮಿ ಉಲ್ಲೆಬಿ ಭಿಂವ್ತಲೆ ನಕ್ಕೊ, ಮಿಯಾ ತುಮಿ ಅನಿ ತುಮ್ಕಾ ಸಮಂದ್ ಪಡಲೆ ಸಗ್ಳೆಬಿ ಬಾಳಗ್ತಾ, ಮನುನ್ ಸಾಂಗುನ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ದಯಾನ್ ಬೊಲ್ಲ್ಯಾನ್.<verse eid="GEN 50:21" /></para>
  <para style="s">ಜುಜೆಚೆ ಮರಾನ್</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />ಜುಜೆ ಅನಿ ತೆಚ್ಯಾ ಬಾಬಾಚ್ಯಾ ಕುಟ್ಮಾಚಿ ಲೊಕಾ ಇಜಿಪ್ತಾತ್ ವಸ್ತಿ ರಾಲ್ಯಾನಿ ಜುಜೆ ಎಕ್ಸೆ ಧಾ ವರಿಸ್ ಝಿತ್ತೊ ರಾಲೊ; <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />ಎಫ್ರಾಯಿಮಾಚಿ ಲೆಕಾ ಅನಿ ನಾತ್ರಾ ಬಗಟ್ಲ್ಯಾನ್, ಮನಸ್ಸೆಚೊ ಲೆಕ್ ಮಾಕಿರಾಕ್ಬಿ ಪೊರಾ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ತಿ ಪೊರಾ ಜುಜೆಚ್ಯಾ ಹೊಟ್ಯಾತುಚ್ ಮೊಟಿಹೊಲಿ, <verse eid="GEN 50:23" /><verse number="24" style="v" sid="GEN 50:24" />ಅನಿ ಜುಜೆನ್ ಅಪ್ಲ್ಯಾ ಭಾವಾಕ್ನಿ ಮಾಜೊ ಮರ್ನಾಚೊ ಎಳ್ ಜಗ್ಗೊಳ್ ಯೆಲಾ, ಖರೆ ದೆವ್ ತುಮ್ಕಾ ರಾಕುಕ್ ಖರೆಚ್ ಯೆತಲೊ ಹಾಯ್, ಅಪ್ನಿ ಅಬ್ರಾಮ್, ಇಸಾಕ್ ಅನಿ ಜಾಕೊಬಾಕ್ ದಿತಾ ಮಟಲ್ಯಾ ದೆಶ್ಯಾಕ್ ತುಮ್ಕಾ ಪಾವಸ್ತಾ, ಮಟ್ಲ್ಯಾನ್. <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />ಅನಿ ಜುಜೆನ್ ತ್ಯಾ ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ದೆವ್ ತುಮ್ಕಾ ರಾಕುಕ್ ಯೆತಲ್ಯಾತ್ ಕಾಯ್ಬಿ ಸಂಸೊವ್ ನಾ, ತನ್ನಾ ತುಮಿ ಮಾಜಿ ಹಡ್ಡಾಬಿ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ನ್ಹೆವ್ಚೆ ತಸೆಚ್ ನ್ಹೆತಾಂವ್ ಮನುನ್ ತೆಂಚ್ಯಾಕ್ನಾ ಗೊಸ್ಟ್ ಘೆಟ್ಲ್ಯಾನ್. <verse eid="GEN 50:25" /><verse number="26" style="v" sid="GEN 50:26" />ಜುಜೆನ್ ಇಜಿಪ್ತಾತ್ ಅಪ್ಲ್ಯಾ ಎಕ್ಸೆ ಧಾವೆಚ್ಯಾ ವರ್ಸಾತ್ ಪ್ರಾನ್ ಸೊಡ್ಲ್ಯಾನ್, ತೆಚ್ಯಾ ಮ್ಹಡ್ಯಾಕ್ ಬರ್‍ಯಾ ವಾಸೆಚ್ಯಾ ತೆಲಾನಿ ನ್ಹಾವ್ಸುನ್ ಎಕ್ ಪೆಟಿತ್ ಘಾಲುನ್ ಥವ್ಲ್ಯಾನಿ.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>