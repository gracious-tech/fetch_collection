<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="RUT" style="id">- Siddi</book>
  <para style="toc3">ರುತ್</para>
  <para style="toc2">ರುತ್</para>
  <para style="toc1">ರುತ್ ಪುಸ್ತಕ್</para>
  <para style="mt2">ರುತ್ ಪುಸ್ತಕ್</para>
  <para style="mt1">ರುತ್ ಪುಸ್ತಕ್</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ರುತ್ ಪುಸ್ತಕ್ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ನ್ಯಾಯ್ ಕರ್‍ತಲ್ಯಾ ಅಧಿಕಾರಿಚ್ಯಾ ಎಳಾರ್ ಎಕ್ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಘರಾನ್ಯಾತ್ ಅಜಾಬಾಚಿ ಘಟ್ನಾ ಘಡಲ್ಲಿ ಕಾನಿ ಕರುನ್ ಸಾಂಗ್ತಾ.ತ್ಯಾ ಕುಟುಂಬಾಚಿ ಅವ್ಸ್ ನವೊಮಿ ಮೊವಾಬ್ ದೆಸಾತ್ ವಸ್ತಿ ರ್‍ಹಾತಾನಾ, ಅಪ್ನಾಚ್ಯಾ ಘವಾಕ್ ಅನಿ ದೊನ್ ಲೆಕಾಕ್ನಿ ಕಳ್ದುನ್ ಘೆವ್ನ್ ಲೈ ದುಕ್ಕ್ ಹೊತಾ. ಖರೆ ಮಾನಾ ಮೊವಾಬ್ ದೆಶಾಚಿ ರುತ್ ನವೊಮಿಚ್ಯಾ ವಾಂಗ್ಡಾ ಇಜ್ರಾಯೆಲಾಕ್ ಪಾಟಿ ಪರ್‍ತುನ್, ತಿಕಾ ಸಾತ್ ದಿತಾ ಮನುನ್ ಗೊಸ್ಟ್ ದಿಲ್ಲ್ಯಾ ಮಾನಾ ನವೊಮಿಕ್ ಅನಿ ರುತಾಕ್ ಆಶಿರ್ವಾದ್ ಗಾವ್ತಾ, ಮಾನಾ ಬೊವಾಜ್ ಮನ್ತಲೊ ಸಮಂದಿಕ್ ತೆಂಕಾ ದಯಾ ದಾಕ್ವುನ್ ರುತಾಕ್ ಲಗಿನ್ ಹೊವ್ಕ್ ಒಪ್ಕಿ ದಿತಾ. ನ್ಯಾಯ್ ಕರ್‍ತಲ್ಯಾ ಅಧಿಕಾರಿಚ್ಯಾ ಎಳ್ ಬುರ್ಸೊ ಹೊಲ್ಲೊ ಹೊತ್ತೊ.ಅನಿ ಹುರಲ್ಲಿ ಇಜ್ರಾಯೆಲಾಚಿ ಲೊಕಾ ಖಾಯ್ದೆ ಪಾಳಿ ನಸ್ತಾನಾ ಹೊತ್ತೆ, ಖರೆ ನವೊಮಿ, ರುತ್ ಅನಿ ಬೊವಾಜ್ ಹೆನಿ ದೆವಾಚ್ಯಾ ನೆಮಾಕ್ನಿ ಪಾಳ್ಯಾನಿ.ತನ್ನಾ ತೆನಿ ಇಜ್ರಾಯೆಲಾಕ್ನಿ ಎಕ್ ಉದಾರನ್ ಹೊವ್ನ್ ಹೊತ್ತೆ.</para>
  <para style="ip">ರುತ್ ಪುಸ್ತಕ್ ಲಿವಲ್ಲೆ ಕೊನ್ ಮನ್ತಲೆ ಕೊನಾಕ್ಬಿ ಗೊತ್ತ್ ನಾ. ಹೆ ಖಲ್ಯಾ ಎಳಾರ್ ಲಿವಲ್ಲೆ ಮನುನ್ ಗೊತ್ತ್ ನಾ. ಖರೆ ಹ್ಯಾ ಪುಸ್ತಕಾತ್ ವಾಪರಲ್ಲ್ಯಾ ಹಿಬ್ರು ಬಾಶ್ಯಾಚ್ಯಾ ಆಧಾರಾವಯ್ನಾ ಉಲ್ಲಿ ಲೊಕಾ ಹೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಬಂಧಿ ಹೊಲ್ಯಾ ಮಾನಾ ಲಿವ್ಕ್ ಫಿರೆ ಮನುನ್ ನಿರ್ದಾರ್ ಕರುನ್ ಹೊಲಾ. ರುತ್ ಇಜ್ರಾಯೆಲಾಂಚಿ ನ್ಹಯ್ ಹೊಲ್ಯಾರ್ಬಿ ದಾವಿದ್ ರಾಜಾಚಿ ಪಂಜಿ ಮನ್ತಲೆ ವಿಶೆಸ್ ಹಾಯ್. ಹೆಜ್ಯಾ ವಯ್ನಾ ರುತ್ ಜೆಜು ಕ್ರಿಸ್ತ್ಯಾಚ್ಯಾ ಪಿಳ್ಗಿಚಿ ಮನ್ತಲೆ ದಿಸುನ್ ಯೆತಾ. ದೆವಾಕ್ ಅಮಿ ಉಪಾಜಲ್ಲೆ ಖಲ್ಯಾ ಕುಟ್ಮಾತ್ ಮನ್ತಲ್ಯಾನ್ಕಿ ಅಮ್ಚೆ ಮನ್ ಕಸೆ ಹಾಯ್ ಮನ್ತಲ್ಯಾ ವರ್‍ತಿ ಇಬೆ ಹಾಯ್, ಮನ್ತಲೆ ದಿಸುನ್ ಯೆತಾ.</para>
  <para style="iot">ಭಾಗ್</para>
  <para style="io">1. ನವೊಮಿಚೆ ಕುಟುಂಬ್ ತಿಜೊ ಖಾಲ್ಲೆ ಕರಲೆ ದುಕ್ಕ್, ಅನಿ ಮಾನಾ ನವೊಮಿ ಅನಿ ರುತ್ ಇಜ್ರಾಯೆಲಾಕ್ ಯೆಲ್ಲಿ ಕಾನಿ ಹಾಯ್.<char style="ior"><ref loc="RUT 1">1</ref> </char></para>
  <para style="io">2. ರುತ್ ತೆಜ್ಯಾ ಸೆತಾತ್ ಲೊಂಬಾ ಯೆಚ್ತಾನಾ, ಬೊವಾಜಾಕ್ ಭೆಟ್ತಲೆ ವಿಶಯ್ ಸಾಂಗ್ತಾ.<char style="ior"><ref loc="RUT 2">2</ref> </char></para>
  <para style="io">3. ನವೊಮಿನ್ ರುತಾಕ್, ಅಪ್ನಾಚೊ ಸಮಂದಿಕ್ ಬೊವಾಜಾಕ್ಡೆ ಲಗಿನ್ ಹೊವ್ಕ್ ಧಾಡಲ್ಲೆ, ಅನಿ ತೆನಿ ತಿಕಾ ದಯಾ ದಾಕ್ವಲ್ಲೆ, ಅನಿ ತಿಕಾ ಲಗಿನ್ ಹೊವ್ಕ್ ಒಪ್ಕಿದಿಲ್ಲೆ. <char style="ior"><ref loc="RUT 3">3</ref> </char></para>
  <para style="io">4. ನವೊಮಿಚ್ಯಾ ಮ್ಹರಲ್ಯಾ ಘವಾಚಿ ಆಸ್ತಿ ಬೊವಾಜಾನ್ ಘೆತಲೆ, ಅನಿ ಕಸೆ ರುತಾಕ್ ಲಗಿನ್ ಕರುನ್ ಘೆತಲ್ಯಾ ವಿಶಯಾತ್. <char style="ior"><ref loc="RUT 4">4</ref> </char></para>
  <chapter number="1" style="c" sid="RUT 1" />
  <para style="s">ಎಲಿಮೆಲೆಕ್ ಅನಿ ತೆಜೊ ಕಟುಂಬ್ ಮೊವಾಬಾಕ್ ಗೆಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 1:1" />ನ್ಯಾಯ್ ಕರ್‍ತಲ್ಯಾಂಚ್ಯಾ ರಾಜ್ವಡ್ಕಿಚ್ಯಾ ಎಳಾರ್, ಇಜ್ರಾಯೆಲ್ ದೆಸಾತ್ ಬರ್‍ಗಾಲ್ ಯೆಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ಜುದಾಂಚ್ಯಾ ಪ್ರಾಂತ್ಯಾಚೊ ಎಕ್ಲೊ ಮಾನುಸ್, ಅಪ್ನಾಚಿ ಬಾಯ್ಕೊ ಅನಿ ದೊನ್ ಲೆಕಾಕ್ನಿ ಬಲ್ವುನ್ ಘೆವ್ನ್, ಮೊವಾಬ್ ದೆಸಾಕ್ ವಸ್ತಿ ರಾವ್ಕ್ ಗೆಲೊ. <verse eid="RUT 1:1" /><verse number="2" style="v" sid="RUT 1:2" />ತೆಚೆ ನಾವ್ ಎಲಿಮೆಲೆಕ್, ಅನಿ ತೆಜ್ಯಾ ಬಾಯ್ಕೊಚೆ ನಾವ್ ನವೊಮಿ, ಅನಿ ಎಕ್ ಲೆಕಾಚೆ ನಾವ್ ಮಹ್ಲುನ್ ಅನಿ ಎಕ್ಲೊ ಕಿಲ್ಯೊನ್, ಜುದ್ ದೆಶಾಚ್ಯಾ ಬೆತ್ಲೆಹೆಮಾಕ್ ಯೆವ್ನ್, ಮೊವಾಬ್ ದೆಸಾಕ್ ಜಾವ್ನ್ ಥೈ ವಸ್ತಿ ರ್‍ಹಾಲೆ. <verse eid="RUT 1:2" /><verse number="3" style="v" sid="RUT 1:3" />ತನ್ನಾ ನವೊಮಿಚೊ ಘವ್ ಎಲಿಮೆಲೆಕ್ ಮರ್‍ಲೊ, ಅನಿ ತಿ ದೊನ್ ಲೆಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾಲಿ. <verse eid="RUT 1:3" /><verse number="4" style="v" sid="RUT 1:4" />ಲೆಕಾನಿ ಒರ್ಪಾ ಅನಿ ರುತ್ ಮನ್ತಲ್ಯಾ ನಾವಾಚ್ಯಾ ದೊನ್ ಮೊವಾಬಿ ಬಾಯ್ಕೊ ಮಾನ್ಸಿಯಾಕ್ನಿ ಲಗಿನ್ ಕರುನ್ ಘೆವ್ನ್ ಲೈ ಕರುನ್ ಧಾ ವರ್ಸಾಂಚ್ಯಾ ಪತರ್ ಥೈಚ್ ರ್‍ಹಾಲ್ಯಾನಿ. <verse eid="RUT 1:4" /><verse number="5" style="v" sid="RUT 1:5" />ತನ್ನಾ, ನವೊಮಿಚಿ ಲೆಕಾ ಮಹ್ಲುನ್ ಅನಿ ಕಿಲ್ಯೊನ್ ಮರ್‍ಲೆ, ಅಸೆ ನವೊಮಿ ಘವಾಕ್ ಅನಿ ದೊನಿ ಲೆಕಾಕ್ನಿ ಕಳ್ದುನ್ ಘೆವ್ನ್, ಎಕ್ಲಿಚ್ ಥೈ ರ್‍ಹಾಲಿ .<verse eid="RUT 1:5" /></para>
  <para style="s">ನವೊಮಿ ರುತಾ ವಾಂಗ್ಡಾ ಬೆತ್ಲೆಹೆಮಾಕ್ ಪರ್‍ತುನ್ ಯೆತಲೆ</para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 1:6" />ಸರ್ವೆಸ್ಪರಾನ್ ಅಪ್ನಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ದಯಾ ದಾಕ್ವುಲ್ಯಾನ್ ಅನಿ ತೆಂಕಾ ಪಾವ್ಸ್ ಪಾನಿಯಾನಿ ಫಿಕ್ ದಿಲ್ಯಾನ್ ಮನ್ತಲಿ ಖಬರ್ ಆಯ್ಕುನ್ ನವೊಮಿ ಮೊವಾಬ್ ದೆಸಾಕ್ನಾ ಅಪ್ನಾಚ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಸಾಕ್ ಸುನ್ನಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಜಾವ್ಚೆ ಮನುನ್, <verse eid="RUT 1:6" /><verse number="7" style="v" sid="RUT 1:7" />ತಿ ಅಪ್ನಾಚ್ಯಾ ದೊನಿ ಸುನ್ನಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಅಪ್ನಿ ಹೊತ್ತ್ಯಾ ಜಾಗ್ಯಾಕ್ನಾ ಜುದ್ ದೆಸಾಕ್ ಜಾತಾನಾ, <verse eid="RUT 1:7" /><verse number="8" style="v" sid="RUT 1:8" />ತನ್ನಾ ನವೊಮಿನ್ ಸುನ್ನಾಕ್ನಿ, ತುಮಿ ಪರ್‍ತುನ್ ತುಮ್ಚ್ಯಾ ತುಮ್ಚ್ಯಾ ಮ್ಹಾಯೆರಾಕ್ನಿ ಜಾವಾ; ತುಮಿ ಮಾಕಾ ಅನಿ ಮಾಜ್ಯಾ ಮ್ಹರಲ್ಲ್ಯಾ ಲೆಕಾಕ್ನಿ ಪ್ರೆಮ್ ಕರಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್, ಸರ್ವೆಸ್ಪರ್ ತುಮ್ಕಾ ಪ್ರೆಮ್ ಕರುನ್ ದಯಾ ದಾಕ್ವುಂದಿತ್. <verse eid="RUT 1:8" /><verse number="9" style="v" sid="RUT 1:9" />ತುಮಿ ದೊಗೆಬಿ ಲಗಿನ್ ಹೊವ್ನ್ ಘವಾಚ್ಯಾ ಘರ್‍ಹಾತ್ ಆರಾಮಾನ್ ರಾಯ್ ಸಾರ್ಕೆ ಸರ್ವೆಸ್ಪರ್ ಆಶಿರ್ವಾದ್ ದಿಂವ್ದಿತ್,</para>
  <para style="p" vid="RUT 1:9">ಜಾವ್ನ್ ಯೆತಾ ಮನುನ್ ತೆಂಕಾ ಉಪ್ಪಾ ದಿಲಿನ್. ತನ್ನಾ ತೆನಿ ಮೊಟ್ಯಾನ್ ರಡುಕ್ ಲಾಗ್ಲ್ಯಾನಿ. <verse eid="RUT 1:9" /><verse number="10" style="v" sid="RUT 1:10" />ತನ್ನಾ ತೆನಿ ಅಮಿಬಿ ತುಜ್ಯಾ ವಾಂಗ್ಡಾಚ್ ತುಜ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ಡೆ ಯೆತಾಂವ್ ಮಟ್ಲ್ಯಾನಿ.<verse eid="RUT 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="RUT 1:11" />ತನ್ನಾ ನವೊಮಿನ್, ಮಾಜ್ಯಾ ಲೆಕಿಯಾನು, ತುಮಿ ಫಾಟಿ ಪರ್‍ತುನ್ ಜಾವಾ, ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಕಶ್ಯಾಕ್ ಯೆತ್ಯಾಸಿ? ತುಮ್ಕಾ ಘವಾ ಕರುನ್ ದಿವ್ಕ್ ಮಾಜ್ಯಾ ಪೊಟಾತ್ ದುಸ್ರಿ ಅನಿಬಿ ಲೆಕಾ ಹಾತ್ ಕಾಯ್? <verse eid="RUT 1:11" /><verse number="12" style="v" sid="RUT 1:12" />ಮಾಜ್ಯಾ ಲೆಕಿಯಾನು, ತುಮಿ ಫಾಟಿ ಪರ್‍ತುನ್ ಚಲಾ, ಮಿಯಾ ಅನಿ ಎಕ್ಲ್ಯಾಕ್ ಲಗಿನ್ ಕರುನ್ ಘೆತಲೊ ವಯಾ ಬಿ ದಾಟ್ಲೊ, ಎಕ್ ಎಳಾ ಲಗಿನ್ ಹೊವ್ನ್ ಪೊರಾ ಹೊಂವ್ದಿತ್ ಮನುನ್ ಆಶ್ಯಾನ್ ಅತ್ತ್ಯಾಚ್ ಪೊರಾಕ್ ಜಲಮ್ ದಿಲ್ಯಾರ್ಬಿ, <verse eid="RUT 1:12" /><verse number="13" style="v" sid="RUT 1:13" />ತೆನಿ ಮೊಟೆ ಹೊಯ್ ಪತರ್ ರಾಕ್ತ್ಯಾಸಿ ಕಾಯ್? ತವ್ಡ್ಯಾ ಪತರ್ ಘವ್ ನಸ್ತಾನಾ ರ್‍ಹಾತ್ಯಾಸಿ ಕಾಯ್? ಮಾಜ್ಯಾ ಲೆಕಿಯಾನು ತಸೆ ಕರುನಕಾಸಿ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಸರ್ವೆಸ್ಪರಾಚೊ ಹಾತ್ ಮಾಜ್ಯಾ ವಿರೊದ್ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ಮಿಯಾ ತುಮ್ಚ್ಯಾ ವಿಶಯಾತ್ ಲೈ ಬೆಜಾರ್ ಹೊತಾ ಮಟ್ಲಿನ್.<verse eid="RUT 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 1:14" />ತನ್ನಾ ತೆನಿ ಮೊಟ್ಯಾನ್ ರಡ್ಲ್ಯಾನಿ, ಒರ್ಪಾನ್ ಮಾಮಿಕ್ ಉಪ್ಪಾ ದಿವ್ನ್ ಮ್ಹಾಯೆರಾಕ್ ಗೆಲಿನ್, ಖರೆ ರುತ್ ಮಾಮಿಕ್ ಸೊಡುನ್ ಜಾವ್ಕ್ ನಾ. <verse eid="RUT 1:14" /><verse number="15" style="v" sid="RUT 1:15" />ಮಾನಾ ನವೊಮಿನ್ ರುತಾಕ್, ಅಬಕ್, ತುಜ್ಯಾ ವಾಂಗುಡ್ಚಿ ಜಾವ್ ಪರ್‍ತುನ್ ಅಪ್ನಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ಡೆ ಅನಿ ದೆವಾಂಚ್ಯಾಕ್ಡೆ ಜಾವ್ಕ್ ಲಾಗ್ಲಿ, ತಿಯಾಬಿ ತಿಚ್ಯಾ ಸಾರ್ಕೆ ತುಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಜಾ ಮಟ್ಲಿನ್. <verse eid="RUT 1:15" /><verse number="16" style="v" sid="RUT 1:16" />ತನ್ನಾ ರುತಾನ್, ಮಾಕಾ ಪರ್‍ತುನ್ ಜಾ ಮನುನ್ ಒತ್ತಾಯ್ ಕರುನಕ್ಕೊ, ತಿಯಾ ಖಯ್ ಗೆಲ್ಯಾರ್ಬಿ ಮಿಯಾ ಥೈಚ್ ಯೆತಾ; ತಿಯಾ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾಕ್ಡೆಚ್ ಮಿಯಾಬಿ ವಸ್ತಿ ರ್‍ಹಾತಾ; ತುಜಿ ಲೊಕಾಚ್ ಮಾಜಿ ಲೊಕಾ ಅನಿ ತುಜೊ ದೆವುಚ್ ಮಾಜೊ ದೆವ್. <verse eid="RUT 1:16" /><verse number="17" style="v" sid="RUT 1:17" />ತಿಯಾ ಮರ್‍ತಲ್ಯಾಕ್ಡೆಚ್ ಮಿಯಾಬಿ ಮರ್ತಾ; ಮಾಕಾಬಿ ಥೈಚ್ ಮಾಟಿ ಕರುಚೆ, ಮರಾನ್ ನಸ್ತಾನಾ ಅನಿ ದುಶ್ರ್ಯಾ ಕಾರನಾಕ್ ಮಿಯಾ ತುಕಾ ಸೊಡುನ್ ಗೆಲ್ಲೆ ಹೊಲ್ಯಾರ್ ಸರ್ವೆಸ್ಪರ್ ಮಾಕಾ ಶಿಕ್ಷ್ಯಾ ದಿಂವ್ದಿತ್.<verse eid="RUT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="RUT 1:18" />ರುತ್ ಅಪ್ನಾಚ್ಯಾ ವಾಂಗ್ಡಾಚ್ ಯೆವ್ಕ್ ಘಟ್ ಮನ್ ಕರಲ್ಲಿ ಹಾಯ್ ಮನುನ್ ನವೊಮಿನ್ ಕಳ್ವುನ್ ಘೆವ್ನ್ ಗಪ್ ರ್‍ಹಾಲಿನ್.<verse eid="RUT 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="RUT 1:19" />ತಸೆಚ್ ತೆನಿ ಪರ್ಯಾನ್ ಕರುನ್ ಬೆತ್ಲೆಹೆಮಾಕ್ ಗಾಂವಾಚ್ಯಾ ಭುತ್ತುರ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ ಬಾಯ್ಕಾ ಮನ್ಸಿಯಾನಿ, ಹಿ ನವೊಮಿ ನ್ಹಯ್ ಕಾಯ್? ಮನುನ್ ಅಜಿಬ್ ಹೊವ್ನ್ ಬೊಲುಕ್ ಲಾಗ್ಲ್ಯಾನಿ.<verse eid="RUT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="RUT 1:20" />ತನ್ನಾ ನವೊಮಿನ್, ಮಾಕಾ ನವೊಮಿ ಮನುನ್ ಬಲ್ವುನಕಾಸಿ, ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಲೈ ದುಕ್ಕ್ ದಿಲಾ, ತಸೆಹೊವ್ನ್ “ಮಾರ್‍ಹಾ”<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">ಮಾರಾ ಮಟ್ಲ್ಯಾರ್ ಕೊಡು ಮನುನ್ ಅರ್‍ತ್.</char></note> ಮನುನ್ ಬಲ್ವಾ. <verse eid="RUT 1:20" /><verse number="21" style="v" sid="RUT 1:21" />ಮಿಯಾ ಸಾವ್ಕಾರ್ನಿ ಹೊವ್ನ್ ಗೆಲೊ, ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಕಾಯ್ಬಿ ನತ್ತಿ ಕರುನ್ ಪರ್‍ತುನ್ ಹಾನ್ಲ್ಯಾನ್, ಸರ್ವೆಸ್ಪರ್ ಮಾಜ್ಯಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಹಾಯ್, ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ದುಕ್ವುಲ್ಯಾನ್; ಅಸೆ ರ್‍ಹಾತಾನಾ, ತುಮಿ ಮಾಕಾ ನವೊಮಿ ಮನುನ್ ಬಲ್ವುಕ್ ಕಸೆ ಹೊತಾ? ಮಟ್ಲಿನ್.<verse eid="RUT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="RUT 1:22" />ಅಸೆ ನವೊಮಿ ಅಪ್ನಾಚಿ ಸುನ್ನ್ ಮೊವಾಬಾಚ್ಯಾ ರುತಾ ವಾಂಗ್ಡಾ ಬೆತ್ಲೆಹೆಮಾಕ್ ಯೆಲಿ, ತನ್ನಾ ಬಾರ್‍ಲಿಚಿ ಪಿಕ್ ಕಾತರ್‍ತಲೊ ಎಳ್ ಶುರು ಹೊಲ್ಲೊ.<verse eid="RUT 1:22" /></para>
  <chapter eid="RUT 1" />
  <chapter number="2" style="c" sid="RUT 2" />
  <para style="s">ರುತ್ ಬೊವಜಾಚ್ಯಾ ಸೆತಾತ್ ಕಾಮ್ ಕರ್‍ತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 2:1" />ನವೊಮಿಚೊ ಘವ್ ಎಲಿಮೆಲೆಕಾಚ್ಯಾ ಸಮಂದಿಕಾತ್ನಿ ಎಕ್ ಸಾವ್ಕಾರ್ ಮಾನುಸ್ ಹೊತ್ತೊ, ತೆಚೆ ನಾವ್ ಬೊವಾಜ್. <verse eid="RUT 2:1" /><verse number="2" style="v" sid="RUT 2:2" />ಎಕ್ ದಿಸ್ ಮೊವಾಬಾಂಚ್ಯಾ ರುತಾನ್ ನವೊಮಿಕ್ಡೆ, ಮಿಯಾ ಜಾವ್ನ್ ಕೊನಾಕ್ ಮಾಜೆ ವರ್‍ತಿ ದಯಾ ಯೆತಾ, ತೆಜ್ಯಾ ಸೆತಾತ್ನಾ ಲೊಂಬಾ ಎಚುನ್ ಗೊಳಾ ಕರುನ್ ಹಾನ್ತಾ ಮಟ್ಲಿನ್,</para>
  <para style="p" vid="RUT 2:2">ತನ್ನಾ ನವೊಮಿನ್, ಜಾ ಮಾಜ್ಯಾ ಲೆಕಿ ಮಟ್ಲಿನ್.<verse eid="RUT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="RUT 2:3" />ತನ್ನಾ ರುತ್ ಖಾಪ್ತಲ್ಯಾಂಚ್ಯಾ ಪಾಟ್ನಾ ಜಾವ್ನ್ ಥೈ-ಥೈ ಪಡಲ್ಲಿ ಲೊಂಬಾ ಯೆಚಿ, ತೆ ಸೆತ್ ಎಲಿಮೆಲೆಕಾಚ್ಯಾ ಕುಳಿಚ್ಯಾ ಬೊವಾಜನಾಚೆ ಹೊಲ್ಲೆ.<verse eid="RUT 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="RUT 2:4" />ತನ್ನಾ ಬೊವಾಜಾನ್ ಬೆತ್ಲೆಹೆಮಾಕ್ನಾ ಸೆತಾಕ್ ಯೆವ್ನ್, ಅಪ್ನಾಚ್ಯಾ ಪಿಕ್ ಕಾತ್ರನಿಚ್ಯಾ ಆಳಾಕ್ನಿ, ಸರ್ವೆಸ್ಪರ್ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾಂವ್ದಿತ್, ಮಟ್ಲ್ಯಾನ್, ತನ್ನಾ ಆಳಾನಿ ತೆಕಾ, ಸರ್ವೆಸ್ಪರ್ ತುಕಾ ಆಶಿರ್ವಾದ್ ದಿಂವ್ದಿತ್ ಮನುನ್ ಜವಾಬ್ ದಿಲ್ಯಾನಿ.<verse eid="RUT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 2:5" />ತನ್ನಾ ಬೊವಾಜಾನ್ ಕಾತ್ರನ್ ಕರ್‍ತಲ್ಯಾಕ್ನಿ ಬಗುನ್ ಘೆತಲ್ಯಾ ಮಕಾದಮ್ಮಾಕ್ಡೆ, ಹೆ ಕೊನಾಚೆ ಚೆಡು? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನ್.<verse eid="RUT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 2:6" />ತನ್ನಾ ತ್ಯಾ ಮಕಾದಮ್ಮಾನ್, ಹಿ ಮೊವಾಬಿ ಬಾಯ್ಕೊಮನುಸ್, ನವೊಮಿಚ್ಯಾ ವಾಂಗ್ಡಾ ಮೊವಾಬ್ ದೆಸಾಕ್ನಾ ಯೆಲ್ಲಿ. <verse eid="RUT 2:6" /><verse number="7" style="v" sid="RUT 2:7" />ಹಿನೆ, ಕಾತ್ರನಿಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಫಾಟ್ನಾ ಲೊಂಬಾ ಎಚುನ್ ಘೆವ್ಕ್ ಅಪ್ನಾಕ್ ಒಪ್ಕಿ ದಿವ್ಚೆ ಮನುನ್ ಮಾಗುನ್ ಘೆಟ್ಲಿನ್ , ಸಕ್ಕಾಳಿ ನಸ್ಕಾತ್ ಯೆಲ್ಲಿ ಅಜುನ್ಬಿ ಹಿತ್ತೆಚ್ ಹಾಯ್, ಅತ್ತಾ ಉಲ್ಲೆ ಆರಾಮ್ ಘೆವ್ಕ್ ಲಾಗ್ಲಾ, ಮಟ್ಲ್ಯಾನ್.<verse eid="RUT 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="RUT 2:8" />ತನ್ನಾ ಬೊವಾಜಾನ್ ರುತಾಕ್, ಆಯ್ಕ್ ಮಾಜ್ಯಾ ಲೆಕಿ; ಮಾಜೆ ಸೆತ್ ಸೊಡುನ್ ದುಸ್ರ್ಯಾ ಸೆತಾಕ್ ಜಾವ್ಕ್ ನಕ್ಕೊ, ಮಾಜ್ಯಾ ಹೆನ್ನ್ ಆಳಾಂಚ್ಯಾ ವಾಂಗ್ಡಾಚ್ ರ್‍ಹಾ. <verse eid="RUT 2:8" /><verse number="9" style="v" sid="RUT 2:9" />ಮಾಜಿ ಆಳಾ ಖಲ್ಯಾ ಸೆತಾಕ್ ಕಾತ್ರನಿಕ್ ಜಾತಾತ್ ತ್ಯಾ ಸೆತಾಕ್ ತಿಯಾಬಿ ಜಾ, ತುಕಾ ಕೊನಿಬಿ ತರಾಸ್ ದಿವ್ಚೆ ನ್ಹಯ್ , ಮನುನ್ ಮಿಯಾ ಆಳಾಕ್ನಿ ತಾಕಿತ್ ದಿತಾ, ತುಕಾ ಸೊಸ್ ಲಾಗ್ಲ್ಯಾರ್ ಮಾಜ್ಯಾ ಆಳಾನಿ ಭರುನ್ ಹಾನಲ್ಲೆ ಪಾನಿ ಫಿ ಮಟ್ಲ್ಯಾನ್.<verse eid="RUT 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="RUT 2:10" />ರುತಾನ್ ತೆಕಾ, ಬಾಗುನ್ ನಮಸ್ಕಾರ್ ಕರುನ್, ದುಶ್ರ್ಯಾ ದೆಶಾಚಿ ಹೊಲ್ಲ್ಯಾ ಮಾಜೆ ವರ್‍ತಿ ತುಜಿ ಯೆವ್ಡಿ ಲೈ ಕರಾನ್ ಅನಿ ದಯಾ ಕಶ್ಯಾಕ್? ಮಟ್ಲಿನ್.<verse eid="RUT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="RUT 2:11" />ತನ್ನಾ ಬೊವಾಜಾನ್, ತುಜೊ ಘವ್ ಮರಲ್ಲ್ಯಾಕ್ನಾ ಆಜ್ ಪತರ್ ತಿಯಾ ತುಜ್ಯಾ ಮಾಮಿ ಸಾಟ್ನಿ ಕರಲ್ಲೆ ಸಗ್ಳೆಬಿ ಆಯ್ಕಲಾ, ತಿಯಾ ತುಜ್ಯಾ ಸ್ವತಾಚೆ ದೆಶ್ ಅನಿ ತುಜ್ಯಾ ಬಾಯ್ ಬಾಬಾಕ್ನಿ ಸೊಡುನ್ ವಳಕ್ ನಸಲ್ಲ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ವಸ್ತಿ ರ್‍ಹಾವ್ಕ್ ಯೆಲೆ ಮನುನ್ಬಿ ಮಾಕಾ ಗೊತ್ತ್ ಹಾಯ್. <verse eid="RUT 2:11" /><verse number="12" style="v" sid="RUT 2:12" />ತಿಯಾ ಕರಲ್ಲ್ಯಾ ಉಪ್ಕಾರಾಕ್ ತುಕಾ ಪ್ರತಿ ಫಳ್ ಗಾಂವ್ದಿತ್, ತಿಯಾ ಫಾಕುಟ್ಯಾಂಚೊ ಆಸ್ರೊ ಮಾಗುನ್ ಘೆವ್ನ್ ಯೆಲ್ಲೊ ತೊ ಇಜ್ರಾಯೆಲಾಂಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರಾನ್ ತುಕಾ ಬರೆ ಪರ್‍ತುನ್ ಫಳ್ ದಿಂವ್ದಿತ್, ಮನುನ್ ಜಾವಾಬ್ ದಿಲ್ಯಾನ್.<verse eid="RUT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="RUT 2:13" />ತನ್ನಾ ತಿನಿ, ಸಾಯ್ಬಾ, “ಮಿಯಾ ಆಳ್ ಮನುನ್ ಘೆವ್ಕ್ ಯೊಗ್ಯ್ ನ್ಹಯ್ , ಹೊಲ್ಯಾರ್ಬಿ ಮಾಕಾ ದಯಾ ದಾಕ್ವುನ್ ಪ್ರೆಮಾನ್ ಬೊಲ್ಲ್ಯಾಸಿ,” ಮಟ್ಲಿನ್.<verse eid="RUT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 2:14" />ಜೆವ್ನಾಚೊ ಎಳ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ, ಬೊವಾಜಾನ್, ಹಿತ್ತೆ ಯೆ, ಭಾಕ್ರಿಯಾ ಘೆವ್ನ್, ಆಂಬೊಟ್ ರಸಾತ್ ಬುಡ್ವುನ್ ಖಾ, ಮನುನ್ ಬಲ್ವುತಾನಾ, ತಿ ಜಾವ್ನ್ ಕಾತ್ರನಿಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಬಸ್ಲಿ, ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ತೆನೆ ತಿಕಾ ಭಾಜಲ್ಲಿ ಲೊಂಬಾಬಿ ದಿಲ್ಯಾನ್, ತಿ ಪೊಟ್ ಭರಿ ಪತರ್ ಖಾವ್ನ್ ಅನಿ ಉಲ್ಲೆ ಹುರ್ವುನ್ ಥವ್ನ್ ಘೆಟ್ಲಿನ್. <verse eid="RUT 2:14" /><verse number="15" style="v" sid="RUT 2:15" />ಮಾನಾ ಪರ್‍ತುನ್ ಲೊಂಬಾ ಎಚುನ್ ಘೆವ್ಕ್ ಉಟಲ್ಲ್ಯಾ ತನ್ನಾ, ಬೊವಾಜಾನ್ ಅಪ್ನಾಚ್ಯಾ ಆಳಾಕ್ನಿ, ಹಿಕಾ ಭಾರ್‍ಯಾಂಚ್ಯಾ ಮದ್ದಿ ಲೊಂಬಾ ಎಚುನ್ ಘೆವ್ನ್ ಸೊಡಾ, ತಿಕಾ ಆಡ್ವು ನಕಾಸಿ; <verse eid="RUT 2:15" /><verse number="16" style="v" sid="RUT 2:16" />ಭಾರ್‍ಯಾಂತ್ನಾ ಲೊಂಬಾ ಕಾಡುನ್ಗೆತ್ ಜಾವಾ, ತಿ ಗೊಳಾ ಕರುನ್ ಘೆಂವ್ದಿತ್, ತಿಕಾ ಜೊರ್ ಕರುನಕಾಸಿ, ಮನುನ್ ಹುಕುಮ್ ದಿಲ್ಯಾನ್.<verse eid="RUT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="RUT 2:17" />ರುತಾನ್ ಸಾಂಜ್ ಪತರ್ಬಿ ಲೊಂಬಾ ಎಚುನ್ ಗೊಳಾ ಕರಲ್ಲೆ ಬಡ್ವುನ್ ಬಗ್ತಾನಾ ಲೈ ಕರುನ್ ತಿಸ್ ಸೆರ್ ಬಾರ್‍ಲಿ ಗಾವ್ಲಿ. <verse eid="RUT 2:17" /><verse number="18" style="v" sid="RUT 2:18" />ತಿ ಬಾರ್‍ಲಿ ಘೆವ್ನ್ ಗಾಂವಾಕ್ ಯೆವ್ನ್, ಮಾಮಿಕ್ ದಾಕ್ವುಲಿನ್. ಅನಿ ಅಪ್ನಿ ಖಾತಾನಾ ಹುರ್ವುನ್ ಥವ್ನ್ ಘೆಟಲ್ಲೆ ಖಾನೊ ಕಾಡುನ್ ದಿಲಿನ್. <verse eid="RUT 2:18" /><verse number="19" style="v" sid="RUT 2:19" />ತನ್ನಾ ಮಾಮಿನ್, ತಿಯಾ ಕೊನಾಚ್ಯಾ ಸೆತಾತ್ ಕನ್ಸಾ ಎಚ್ಲೆಯ್? ಖೈ ಕಾಮ್ ಕರ್‍ಲೆ? ತುಕಾ ದಯಾ ದಾಕ್ವಲ್ಲ್ಯಾ ಮಾನ್ಸಾಕ್ ಬರೆ ಹೊಂವ್ದಿತ್, ಮನ್ತಾನಾ,</para>
  <para style="p" vid="RUT 2:19">ರುತಾನ್, ಮಿಯಾ ಲೊಂಬಾ ಯೆಚಲ್ಲ್ಯಾ ಸೆತ್ಯಾಚ್ಯಾ ಮಾಲ್ಕಾಚೆ ನಾವ್ ಬೊವಾಜ್ ಮಟ್ಲಿನ್.<verse eid="RUT 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="RUT 2:20" />ತನ್ನಾ ನವೊಮಿನ್, “ಅಪ್ನಾಚ್ಯಾ ಸುನ್ನೆಕ್ ಮಟ್ಲಿನ್ ಮರಲ್ಲ್ಯಾಕ್ನಿ ಅನಿ ಝಿತ್ತೆ ಹೊತ್ತ್ಯಾಕ್ನಿ ದಯಾ ದಾಕ್ವುತಲ್ಯಾ ದೆವಾಕ್ನಾ ತೆಕಾ ಆಶಿರ್ವಾದ್ ಘಾಂವ್ದಿತ್.” ಅನಿ ನವೊಮಿನ್ ತೊ ಅಮ್ಚೊ ಜಗ್ಗೊಳ್ಲ್ಯಾ ಸಮಂದಿಕ್ ಮನುನ್ಬಿ ರುತಾಕ್ ಸಾಂಗಟ್ಲಿನ್.<verse eid="RUT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="RUT 2:21" />ತನ್ನಾ ಮೊವಾಬಾಂಚ್ಯಾ ರುತಾನ್, ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಮಾಕಾ ತ್ಯಾ ಮಾನ್ಸಾನ್, ಕಾತ್ರನಿಚೊ ಎಳ್ ಸರಿ ಪತರ್ಬಿ ಅಪ್ನಾಚ್ಯಾ ಆಳಾಂಚ್ಯಾ ವಾಂಗ್ಡಾಚ್ ರ್‍ಹಾ, ಮನುನ್ ಸಾಂಗ್ಲಾ ಮಟ್ಲಿನ್.<verse eid="RUT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="RUT 2:22" />ತನ್ನಾ ನವೊಮಿನ್ ಅಪ್ನಾಚಿ ಸುನ್ನ್ ರುತಾಕ್, ಮಾಜ್ಯಾ ಲೆಕಿ, ತಿಯಾ ತೆಜ್ಯಾ ಆಳಾಂಚ್ಯಾ ವಾಂಗ್ಡಾಚ್ ಜಾತಲೆ ಬರೆ, ದುಸ್ರ್ಯಾ ಸೆತಾಕ್ ಗೆಲ್ಯಾರ್ ತುಕಾ ಕಾಯ್ತರಿಬಿ ತರಾಸ್ ಯೆಯ್ಲ್ ಮಟ್ಲಿನ್. <verse eid="RUT 2:22" /><verse number="23" style="v" sid="RUT 2:23" />ತಸೆಚ್ ರುತ್ ಅಪ್ನಾಚ್ಯಾ ಮಾಮಿಚ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾವ್ನ್, ಬಾರ್‍ಲಿ ಅನಿ ಘಂವಾಚಿ ಕಾತ್ರನ್ ಸರಿ ಪತರ್ಬಿ ಬೊವಾಜಾಚ್ಯಾ ಕಾಮ್ ಕರ್‍ತಲ್ಯಾ ಬಾಯ್ಕಾ ಮಾನ್ಸಾಂಚ್ಯಾ ವಾಂಗ್ಡಾಚ್ ಜಾವ್ನ್ ಲೊಂಬಾ ಎಚುಕ್ ಲಾಗಲ್ಲಿ.<verse eid="RUT 2:23" /></para>
  <chapter eid="RUT 2" />
  <chapter number="3" style="c" sid="RUT 3" />
  <para style="s">ರುತಾಕ್ ಘವ್ ಗಾವಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 3:1" />ಉಲ್ಲ್ಯಾ ದಿಸಾಂಚ್ಯಾ ಮಾನಾ, ನವೊಮಿನ್ ಅಪ್ನಾಚಿ ಸುನ್ನ್ ರುತಾಕ್, “ಮಾಜ್ಯಾ ಲೆಕಿ ತಿಯಾ ಘರ್ ಕಾರ್‍ನಿ ಹೊವ್ನ್ ಸುಕಾನ್ ರಾಯ್ ಸಾರ್ಕೆ ಕರುಕ್ ಮಿಯಾ ಕಟ್ಪಟ್ ಕರುಕ್ ಪಾಜೆ ನ್ಹಯ್ . <verse eid="RUT 3:1" /><verse number="2" style="v" sid="RUT 3:2" />ಬೊವಾಜ್ ಅಮ್ಚೊ ಸಂಬಂದಿಕ್, ತೆಚ್ಯಾ ಹೆನ್ನ್ ಆಳಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ತಿಯಾ ಕಾಮ್ ಕರ್ತೆ ನ್ಹಯ್ ? ಅತ್ತಾ ಮಿಯಾ ಸಾಂಗ್ತಲೆ ಆಯ್ಕ್; ತೊ ಆಜ್ ರಾತ್ತಿನ್ ಖಳ್ಯಾತ್ ಬಾರ್‍ಲಿ ವಾರೆ ದಿತಾ. <verse eid="RUT 3:2" /><verse number="3" style="v" sid="RUT 3:3" />ತಿಯಾ ಪಾನಿ ನ್ಹಾವ್ನ್ ಬರ್‍ಯಾ ತೆಲ್ ಲಾವ್ನ್ ಘೆವ್ನ್, ಬರೆ ಕಪ್ಡೆ ನೆಸುನ್ ಘೆವ್ನ್ ಖಳ್ಯಾತ್ ಜಾ; ತೆಚೆ ಜೆವಾನ್ ಹೊಯ್ ಪತರ್ ತೆಕಾ ದಾಕ್ವುನ್ ಘೆವ್ ನಕ್ಕೊ. <verse eid="RUT 3:3" /><verse number="4" style="v" sid="RUT 3:4" />ತೊ ನಿಜ್ತಲೊ ಜಾಗೊ ಕಳ್ವುನ್ ಘೆವ್ನ್ ಜಾವ್ನ್, ತೆಜ್ಯಾ ಪಾಂಯಾಂಚ್ಯಾ ವೈಲೆ ಕಾಂಬ್ರಾನ್ ಕಾಡುನ್ ಪಾಂಯಾಂಚ್ಯಾಕ್ಡೆಚ್ ಆಡ್ ಪಡ್; ಮಾನಾ ತಿಯಾ ಕರುಚೆ ಹೊಲ್ಲೆ ಸಗ್ಳೆ ತೊ ತುಕಾ ಕಳ್ವುತಾ.” ಮಟ್ಲಿನ್.<verse eid="RUT 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="RUT 3:5" />ತನ್ನಾ ಸುನ್ನೆನ್ ಮಾಮಿಕ್, “ತಿಯಾ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಕರ್ತಾ” ಮಟ್ಲಿನ್.<verse eid="RUT 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="RUT 3:6" />ತಸೆಚ್ ರುತಾನ್ ಖಳ್ಯಾತ್ ಜಾವ್ನ್ ಅಪ್ನಾಚ್ಯಾ ಮಾಮಿನ್ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಕರ್‍ಲಿನ್. <verse eid="RUT 3:6" /><verse number="7" style="v" sid="RUT 3:7" />ಬೊವಾಜ್ ಜೆವ್ನ್, ಫಿವ್ನ್ ಬಾರ್‍ಲಿಚ್ಯಾ ರಾಸಿಕ್ಡೆ ಜಾವ್ನ್ ನಿಜ್ಲೊ. ಮಾನಾ ತಿ ಘುಟ್ಟಾನ್ ಯೆವ್ನ್, ತೆಜ್ಯಾ ಪಾಂಯಾಚ್ಯಾ ವಯ್ಲೆ ಕಾಂಬ್ರಾನ್ ಕಾಡುನ್ ಪಾಂಯಾಂಚ್ಯಾಕ್ಡೆಚ್ ಆಡ್ ಪಡ್ಲಿ. <verse eid="RUT 3:7" /><verse number="8" style="v" sid="RUT 3:8" />ಮದ್ಯಾನ್ ರಾತ್ತಿನ್ ಬೊವಜಾನ್ ಉಟುನ್ ಅಪ್ನಾಚ್ಯಾ ಪಾಂಯಾಂಚ್ಯಾಕ್ಡೆ ನಿಜಲ್ಲ್ಯಾ ಬಾಯ್ಕೊಮಾನ್ಸಿಕ್ ಬಗುನ್ ಅಜಿಬ್ ಹೊಲೊ. <verse eid="RUT 3:8" /><verse number="9" style="v" sid="RUT 3:9" />ತನ್ನಾ ತೆನಿ ತಿಕಾ ತಿಯಾ ಕೊನ್? ಮನುನ್ ಇಚಾರ್‍ತಾನಾ,</para>
  <para style="p" vid="RUT 3:9">ತಿನಿ ಮಿಯಾ ತುಜಿ ಚಾಕ್ರಿನ್ ರುತ್. ತಿಯಾ ಮಾಜೊ ಜಗ್ಗೊಳ್ಲೊ ಸಮಂದಿಕ್ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತುಜ್ಯಾ ಕಾಂಬ್ರಾನಾಚಿ ತುದಿ ಮಾಜ್ಯಾ ವರ್‍ತಿ ಧಾಪ್ ಮಟ್ಲಿನ್.<verse eid="RUT 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="RUT 3:10" />ತನ್ನಾ ತೆನಿ, ಮಾಜ್ಯಾ ಲೆಕಿ, “ತುಕಾ ಸರ್ವೆಸ್ಪರಾಕ್ನಾ ಆಶಿರ್ವಾದ್ ಗಾಂವ್ದಿತ್,” “ತಿಯಾ ಗರಿಬ್ ನಾತರ್ ಸಾವ್ಕಾರ್ ದಾಂಡ್ಗ್ಯಾ ಮಾನ್ಸಾಕ್ ಬಗುನ್ ಜಾವ್ಕ್ ನ್ಹಯ್ . ತುಜೆ ಗವ್ರವ್ ಪೈಲೆಚ್ಯಾಕಿಂತಾಬಿ ಲೈ ಹೊವ್ನ್ ದಿಸುನ್ ಯೆಲಾ. <verse eid="RUT 3:10" /><verse number="11" style="v" sid="RUT 3:11" />ಮಾಜ್ಯಾ ಲೆಕಿ, ಅತ್ತಾ ಭಿಂವ್ ನಕ್ಕೊ, ತಿಯಾ ಬರ್‍ಯಾ ಮನಾಚಿ ಮನ್ತಲೆ ಸಗ್ಳ್ಯಾ ಗಾಂವಾಕ್ ಗೊತ್ತ್ ಹಾಯ್; ತಸೆ ಹೊವ್ನ್ ತಿಯಾ ಮಾಗಲ್ಲೆ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="RUT 3:11" /><verse number="12" style="v" sid="RUT 3:12" />ಮಿಯಾ ಜಗ್ಗೊಳ್ಲೊ ಸಮಂದಿಕ್ ಮನ್ತಲೆ ಖರೆಚ್ ಹಾಯ್. ಹೊಲಾರ್ಬಿ ಮಾಜ್ಯಾಕಿಂತಾ ಜಗ್ಗೊಳ್ಲೊ ಅನಿ ಎಕ್ಲೊ ಹಾಯ್. <verse eid="RUT 3:12" /><verse number="13" style="v" sid="RUT 3:13" />ಆಜ್ ರಾತ್ತಿನ್ ಹಿತ್ತೆಚ್ ರ್‍ಹಾ; ಉದ್ದ್ಯಾ ತೆನಿ ಜವಾಬ್ದಾರಿ ಘೆತಾ ಕಾಯ್ ಇಚಾರುಂವಾ; ನಾ ಹೊಲ್ಯಾರ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ವರ್‍ತಿ ಆನ್, ಮಿಯಾಚ್ ತೆ ಕಾಮ್ ಕರ್ತಾ, ಉಜ್ವಾಡಿ ಪತರ್ ಹಿತ್ತೆಚ್ ನಿಜ್ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.”<verse eid="RUT 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="RUT 3:14" />ತಿ ತವ್ಡ್ಯಾ ಪತರ್ಬಿ ತೆಜ್ಯಾ ಪಾಂಯಾಂಚ್ಯಾಕ್ಡೆ ನಿಜುನ್ ಹೊತ್ತಿ. “ಎಕ್ ಬಾಯ್ಕೊಮನುಸ್ ಖಳ್ಯಾಕ್ ಯೆಲ್ಲಿ ಮನ್ತಲೆ ಕೊನಾಕ್ಬಿ ಕಳುಚೆ ನ್ಹಯ್ ” ಮನುನ್ ತೆನಿ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ನಸ್ಕಾತ್ ವಳಕ್ ಗಾಯ್ ನಸಲ್ಲೊ ತವ್ಡೊ ಕಾಳೊಕ್ ರ್‍ಹಾತಾನಾಚ್ ತಿ ಉಟ್ಲಿ. <verse eid="RUT 3:14" /><verse number="15" style="v" sid="RUT 3:15" />ತನ್ನಾ ತೆನಿ ತಿಕಾ, ತುಜೆ ಕಂಬ್ಳೆ ಹಾತರ್ ಮನ್ತಾನಾ ತಿನಿ ಹಾತರ್‍ಲಿನ್, ತೆನಿ ತ್ಯಾತುರ್ ಜಾಸ್ತಿ ಕಮ್ಮಿ ತಿನ್ ಪಾಯ್ಲಿ ಬಾರ್‍ಲಿ ಭರುನ್ ವಾಂವ್ಲ್ಯಾನ್, ತಿ ಗಾಂವಾತ್ ಗೆಲಿ. <verse eid="RUT 3:15" /><verse number="16" style="v" sid="RUT 3:16" />ಅಪ್ನಾಚ್ಯಾ ಮಾಮಿಕ್ಡೆ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ, ಮಾಮಿನ್ ತಿಕಾ “ಮಾಜ್ಯಾ ಲೆಕಿ, ತುಜೆ ಕಾಮ್ ಕಾಯ್ ಹೊಲೆ?” ಮನುನ್ ಇಚಾರ್‍ತಾನಾ,</para>
  <para style="p" vid="RUT 3:16">ತಿನಿ ತ್ಯಾ ಮಾನ್ಸಾನ್ ಕರಲ್ಲೆ ಸಗ್ಳೆ ಸಾಂಗ್ಲಿನ್. <verse eid="RUT 3:16" /><verse number="17" style="v" sid="RUT 3:17" />ತಿಯಾ ಖಾಲಿ ಹಾತಿನ್ ಮಾಮಿಕ್ಡೆ ಜಾವ್ನಕ್ಕೊ ಮನುನ್ ಜಾಸ್ತಿ ಕಮ್ಮಿ ತಿನ್ ಪಾಯ್ಲಿ ಬಾರ್‍ಲಿ ದಿಲ್ಯಾನ್ ಮಟ್ಲಿನ್.<verse eid="RUT 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="RUT 3:18" />ಮಾಮಿನ್ ಮಾಜ್ಯಾ ಲೆಕಿ, “ಹೆ ಕಾಮ್ ಹೊಯ್ ಪತರ್ ಗಪ್ ರ್‍ಹಾ; ಬೊವಾಜ್ ತೆ ಕಾಮ್ ಕರಿ ಪತರ್ ಗಪ್ ರ್‍ಹಾಯ್ನಾ ಮಟ್ಲಿನ್.”<verse eid="RUT 3:18" /></para>
  <chapter eid="RUT 3" />
  <chapter number="4" style="c" sid="RUT 4" />
  <para style="s">ಬೊವಾಜ್ ರುತಾಕ್ ಲಗಿನ್ ಹೊತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="RUT 4:1" />ಬೊವಾಜ್ ಜಾವ್ನ್ ಗಾಂವಾಚ್ಯಾ ಯೆಸಿತ್ ಬೈಟೆಕ್ ಕರ್‍ತಲ್ಯಾ ಜಾಗ್ಯಾರ್ ಜಾವ್ನ್ ಬಸ್ಲೊ, ಅಪ್ನಿ ಸಾಂಗಲ್ಲೊ ಜಗ್ಗೊಳ್ಲೊ ಸಮಂದಿಕ್ ತ್ಯಾ ವಾಟೆನ್ ಜಾವ್ನ್ ಗೆತ್ ಹೊತ್ತೊ ಬಗುನ್, ತೆಕಾ ವಾಂಗ್ಡಿ ಹಿತ್ತೆ ಯೆ, ಬಸ್ ಮನುನ್ ಬಲ್ವುತಾನಾ, ತೊ ಯೆವ್ನ್ ಬಸ್ಲೊ. <verse eid="RUT 4:1" /><verse number="2" style="v" sid="RUT 4:2" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ತೆನಿ ಧಾ ಜಾಂನ್ತ್ಯಾ ಲೊಕಾಕ್ನಿ ಬಲ್ವುತಾನಾ, ತೆನಿಬಿ ಯೆವ್ನ್ ಬಸ್ಲೆ. <verse eid="RUT 4:2" /><verse number="3" style="v" sid="RUT 4:3" />ತನ್ನಾ ತೆನಿ ತ್ಯಾ ಜಗ್ಗೊಳ್ಲ್ಯಾ ಸಮಂದಿಕಾಕ್ ಮೊವಾಬ್ ದೆಸಾಕ್ನಾ ಫಾಟಿ ಪರ್‍ತುನ್ ಯೆಲ್ಲ್ಯಾ ನವೊಮಿನ್ ಎಲಿಮೆಲೆಕಾಚ್ಯಾ ವಾಟ್ಯಾಚೆ ಸೆತ್ ಇಕುಚೆ ಮನುನ್ ಹಾಯ್. <verse eid="RUT 4:3" /><verse number="4" style="v" sid="RUT 4:4" />ಮಿಯಾ ತುಕಾ ಸಾಂಗುಚೆ ಮನುನ್ ಹೊತ್ತೊ, ಹಿತ್ತೆ ಬಸಲ್ಲ್ಯಾ ಜಾಂನ್ತ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕುಚ್ ಇಕಾತ್ ಘೆ, ತುಕಾ ತೆ ಇಕಾತ್ ಘೆತಲೊ ಮನ್ ರ್‍ಹಾಲ್ಯಾರ್ ಘೆ, ನಾ ಹೊಲ್ಯಾರ್ ಮಾಕಾ ಸಾಂಗ್, ತಿಯಾ ಸೊಡ್ಲ್ಯಾರ್ ಮಿಯಾಚ್, ಅನಿ ಮಾಕಾ ಸೊಡುನ್ ಅನಿ ಕೊನ್ ಬಿ ತೆ ಇಕಾತ್ ಘೆವ್ಕ್ ಹೊಯ್ನಾ, ಮನ್ತಾನಾ ತೆನಿ ಮಿಯಾಚ್ ಇಕಾತ್ ಘೆತಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="RUT 4:4" /><verse number="5" style="v" sid="RUT 4:5" />ತನ್ನಾ ಬೊವಾಜಾನ್, “ತಿಯಾ ನವೊಮಿಕ್ನಾ ತೆ ಸೆತ್ ಇಕಾತ್ ಘೆತಲೆ ಹೊಲ್ಯಾರ್, ತೆ ಸೆತ್ ತಿಚ್ಯಾ ಮರುನ್ ಗೆಲ್ಲ್ಯಾ ಲೆಕಾಚ್ಯಾ ನಾವಾರ್ ವರ್‍ತಿಚ್ ರ್‍ಹಾಯ್ ಸಾರ್ಕೆ, ಅನಿ ತೆಚಿ ಬಾಯ್ಕೊ ಹೊಲ್ಲ್ಯಾ ಮೊವಾಬಾಂಚ್ಯಾ ರುತಾಕ್ ತಿಯಾ ಬಾಯ್ಕೊ ಕರುನ್ ಘೆವ್ಚೆ” ಮಟ್ಲ್ಯಾನ್. <verse eid="RUT 4:5" /><verse number="6" style="v" sid="RUT 4:6" />ತ್ಯಾ ಜಗ್ಗೊಳ್ಲ್ಯಾ ಸಮಂದಿಕಾನ್, ತಸೆ ಹೊಲ್ಯಾರ್ ತಿ ಜಿಮಿನ್ ಇಕಾತ್ ಘೆವ್ನ್ ಮಿಯಾ ಮಾಜೆ ವಾರಿಸ್ದಾರ್ ನಾ ಕರುನ್ ಘೆವ್ಕ್ ತಯಾರ್ ನಾ, ತಿ ಜವಾಬ್ದಾರಿ ತಿಯಾಚ್ ವಾವುನ್ ಘೆ; ಮಾಜೆಕ್ಡೆ ಹೊಯ್ನಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="RUT 4:6" /><verse number="7" style="v" sid="RUT 4:7" />ಖಲೊ ತರ್ಬಿ ವಸ್ತ್ ಘೆತಾನಾ ನಾತರ್ ದಿತಾನಾ, ಗೊಸ್ಟ್ ಘಟ್ ಕರುಕ್ ಸಾಟ್ನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾತ್ನಿ ಪೈಲೆಚ್ಯಾನ್ ಯೆಲ್ಲಿ ಪದ್ದತ್ ಖಲಿ ಮಟ್ಲ್ಯಾರ್, ಘೆತಲ್ಯಾಕ್ ದಿತಲೊ ಅಪ್ನಾಚಿ ಹೊನಯಾ ದಿತಲೆ; ಹೆಜ್ಯಾ ವೈನಾ ಗೊಸ್ಟ್ ಘಟ್ ಹೊಲಿ ಮನ್ತಲೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಕಳ್ವುನ್ ಘೆತಾತ್. <verse eid="RUT 4:7" /><verse number="8" style="v" sid="RUT 4:8" />ತಸೆಚ್ ತ್ಯಾ ಜಗ್ಗೊಳ್ಲ್ಯಾ ಸಮಂದಿಕಾನ್ ಬೊವಾಜಾಕ್, “ತಿಯಾಚ್ ಇಕಾತ್ ಘೆ” ಮನುನ್ ಅಪ್ನಾಚಿ ಹೊನಯಾ ಕಾಡುನ್ ದಿಲ್ಯಾನ್. <verse eid="RUT 4:8" /><verse number="9" style="v" sid="RUT 4:9" />ತನ್ನಾ ಬೊವಾಜಾನ್ ಜಾಂನ್ತ್ಯಾಕ್ನಿ ಅನಿ ಹುರಲ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ, ಮಿಯಾ ಎಲಿಮೆಲೆಕ್, ಕಿಲ್ಯೊನ್, ಮಹ್ಲುನ್ ಹೆಂಚಿ ಆಸ್ತಿ ನವೊಮಿಕ್ನಾ ಘೆಟ್ಲೊ, ಹೆಕಾ ತುಮಿಚ್ ಸಾಕ್ಷಿ ಹೊವ್ನ್ ಹಾಸಿ. <verse eid="RUT 4:9" /><verse number="10" style="v" sid="RUT 4:10" />ಸೆತ್ಯಾಚ್ಯಾ ಖಾತ್ಯಾವರ್‍ತಿ ಮರುನ್ ಗೆಲ್ಲ್ಯಾ ಮಹ್ಲುಚ್ಯಾ ನಾವಾವರ್‍ತಿ ರಾವ್ನ್ ತೆಜ್ಯಾ ಸಮಂದಿಕಾತ್ನಿ ಅನಿ ಗಾಂವಾತ್ನಿ ತೆಂಚಿ ಪಿಳ್ಗಿ ಹುರಿಸಾರ್ಕೆ ಮೊವಾಬಾಂಚಿ ತೆಚಿ ಬಾಯ್ಕೊ ರುತಾಕ್ ಬಾಯ್ಕೊ ಕರುನ್ ಘೆಟ್ಲೊ. ಹೆಕಾ ತುಮಿಚ್ ಸಾಕ್ಷಿ ಹೊವ್ನ್ ಹಾಸಿ. <verse eid="RUT 4:10" /><verse number="11" style="v" sid="RUT 4:11" />ತನ್ನಾ ಗಾಂವಾಚ್ಯಾ ಯೆಸಿತ್ ಬೈಟೆಕ್ ಕರ್‍ತಲ್ಯಾ ಜಾಗ್ಯಾರ್ ಬಸಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾನಿ ಅನಿ ಜಾಂನ್ತ್ಯಾನಿ, “ಹೊಯ್ ಅಮಿ ಸಾಕ್ಷಿ ಹಾಂವ್, ಸರ್ವೆಸ್ಪರ್ ಇಜ್ರಾಯೆಲಾಚೆ ಘರಾನ್ ಭಾಂದಲ್ಲ್ಯಾ ರಾಹೆಲ್, ತಿಯಾ ಲೆಯಾ ಮನ್ತಲ್ಲ್ಯಾ ಬಾಯ್ಕೊ ಮನ್ಸಿ ಸಾರ್ಕೆಚ್ ತುಜ್ಯಾ ಘರಾಕ್ ಯೆತಲ್ಯಾ ಹ್ಯಾ ಬಾಯ್ಕೊ ಮನ್ಸಿಕ್ ಬಿ ವಾಡ್ವಳ್ಕಿ ಕರುಂದಿತ್ ಎಪ್ರಾತಾತ್ ವಾಡ್ವಳ್ಕಿ, ಬೆತ್ಲೆಹೆಮಾತ್ ನಾವ್ ಖಮ್ವು. <verse eid="RUT 4:11" /><verse number="12" style="v" sid="RUT 4:12" />ಸರ್ವೆಸ್ಪರಾನ್ ಹ್ಯಾ ಬಾಯ್ಕೊ ಮನ್ಸಿಚ್ಯಾ ವೈನಾ ತುಕಾ ದಿತಲ್ಯಾ ಪೊರಾಕ್ನಿಬಿ ತುಜೆ ಘರ್ ಜುದಾಕ್ ತಾಮರಾಕ್ನಾ ಉಪಾಜಲ್ಲ್ಯಾ ಪೆರೆಚಾಚ್ಯಾ ಘರಾಕ್ ಸಮಾ ಹೊವ್ನ್ ರ್‍ಹಾಂವ್ದಿತ್.”<verse eid="RUT 4:12" /></para>
  <para style="s">ಬೊವಾಜ್ ಅನಿ ತೆಚಿ ಪಿಳ್ಗಿ</para>
  <para style="p">
    <verse number="13" style="v" sid="RUT 4:13" />ಬೊವಾಜಾನ್ ರುತಾಕ್ ಬಾಯ್ಕೊ ಕರುನ್ ಒಪ್ಪುನ್ ಘೆವ್ನ್, ಮಿಳ್ತಾನಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ದಯಾನ್ ತಿ ಗರ್‍ವಾರ್ ರ್‍ಹಾವ್ನ್ ಎಕ್ ಲೆಕ್ ಉಪಜ್ಲೊ. <verse eid="RUT 4:13" /><verse number="14" style="v" sid="RUT 4:14" />ತನ್ನಾ ಬಾಯ್ಕೊ ಮನ್ಸಿಯಾನಿ ನವೊಮಿಕ್, ಹ್ಯಾ ಎಳಾರ್ ತುಕಾ ವಾರಿಸ್ದಾರ್ ದಿಲ್ಲ್ಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಹೊಗ್ಳಾಪ್ ಹೊಂವ್ದಿತ್, ಹ್ಯೊ ಲೆಕ್ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ದೆಸಾತ್ ನಾವ್ ಹೊಲ್ಲೊ ಹೊಂವ್ದಿತ್. <verse eid="RUT 4:14" /><verse number="15" style="v" sid="RUT 4:15" />ಹ್ಯೊ ತುಕಾ ನವೊ ಜಿವನ್ ದಿತಾ; ಮ್ಹಾತಾರ್‍ಯಾ ಎಳಾರ್ ತುಕಾ ರಾಕ್ವನ್ ಕರ್‍ನಾರೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ತುಕಾ ಲೈ ಪ್ರೆಮ್ ಕರ್‍ತಲ್ಯಾ ಸಾತ್ ಲೆಕಾಂಚ್ಯಾ ಕಿಂತಾಬಿ ಬರಿ ಹೊಲ್ಲ್ಯಾ ತುಜ್ಯಾ ಸುನ್ನೆನ್ ಹೆಕಾ ಜಲಮ್ ದಿಲಾ, ಮಟ್ಲ್ಯಾನಿ. <verse eid="RUT 4:15" /><verse number="16" style="v" sid="RUT 4:16" />ತ್ಯಾ ಲೆಕಾಕ್ ನವೊಮಿನುಚ್ ಹೊಟ್ಟ್ಯಾತ್ ಥವ್ನ್ ಘೆವ್ನ್ ಬಾಳಗ್ಲಿನ್. <verse eid="RUT 4:16" /><verse number="17" style="v" sid="RUT 4:17" />ಆಜುಭಾಜುಚ್ಯಾ ಬಾಯ್ಕೊಮನ್ಸಿಯಾನಿ ನವೊಮಿಕ್ ಎಕ್ ಲೆಕ್ ಉಪಜ್ಲೊ ಮನುನ್ ತೆಕಾ ಒಬೆದ್ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನಿ, ಹೊ ಜೆಸ್ಸೆಚೊ ಬಾಬಾ ಜೆಸ್ಸೆ ದಾವಿದಾಚೊ ಬಾಬಾ. <verse eid="RUT 4:17" /><verse number="18" style="v" sid="RUT 4:18" />ಪೆರೆಚಾಚಿ ವಂಶಾವಳಿ, ಪೆರೆಚಾಕ್ ಹೆಚ್ರೊನ್ ಉಪಜ್ಲೊ; <verse eid="RUT 4:18" /><verse number="19" style="v" sid="RUT 4:19" />ಹೆಚ್ರೊನಾಕ್ ರಾಮ್ ಉಪಜ್ಲೊ; ರಾಮಾಕ್ ಅಮ್ಮಿನಾದಾಬ್ ಉಪಜ್ಲೊ; <verse eid="RUT 4:19" /><verse number="20" style="v" sid="RUT 4:20" />ಅಮ್ಮಿನಾದಾಬಾಕ್ ನಹಶೊನ್ ಉಪಜ್ಲೊ; ನಹಶೊನಾಕ್ ಸಲ್ಮೊನ್ ಉಪಜ್ಲೊ; <verse eid="RUT 4:20" /><verse number="21" style="v" sid="RUT 4:21" />ಸಲ್ಮೊನಾಕ್ ಬೊವಾಜ್ ಉಪಜ್ಲೊ; ಬೊವಾಜಾಕ್ ಒಬೆದ್ ಉಪಜ್ಲೊ, <verse eid="RUT 4:21" /><verse number="22" style="v" sid="RUT 4:22" />ಒಬೆದಾಕ್ ಜೆಸ್ಸೆ ಉಪಜ್ಲೊ, ಜೆಸ್ಸೆಕ್ ದಾವಿದ್ ಉಪಜ್ಲೊ.<verse eid="RUT 4:22" /></para>
  <chapter eid="RUT 4" />
</usx>