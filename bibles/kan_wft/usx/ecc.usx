<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Siddi</book>
  <para style="h">ಉಪದೆಸ್ ಕಾರ್</para>
  <para style="toc3">ಉಪ</para>
  <para style="toc2">ಉಪದೆಸ್ ಕಾರ್</para>
  <para style="toc1">ಉಪದೆಸ್ ಕಾರಾಚೆ ಪುಸ್ತಕ್</para>
  <para style="mt2">ಪ್ರಸಂಗಿ</para>
  <para style="mt1">ಉಪದೆಸ್ ಕಾರಾಚೆ ಪುಸ್ತಕ್</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ಉಪದೆಸ್ ಕಾರಾಂಚೆ ಪುಸ್ತಕ್ ಜಿವನಾಚ್ಯಾ ಬುದ್ದಿಚ್ಯಾ ವಿಶಯಾತ್ ಶಿಕ್ವುತಾ. ಹಿಬ್ರುಬಾಶೆತ್ ಪುಸ್ತಕಾ ಕಾರಾಂಚ್ಯಾ ಪ್ರಕಾರ್ ಲೊಕಾಕ್ನಿ ಗೊಳಾ ಕರ್ತಲೊ. ಮನುನ್ ಅರ್ಥ್ ಹಾಯ್. ಲೈ ಬುದ್ವಂತ್ ಲೊಕಾ ಉಪದೆಸ್ ಕಾರಾಂಚೊ ಲಿವಲ್ಲೊ ಸೊಲೊಮೊನ್ ರಾಜಾ ಮನುನ್ ಮಾನ್ತಾತ್, ಖರೆ ಹುರಲ್ಲಿ ಲೊಕಾ ಒಪ್ಪಿನಾತ್. ಎಕ್ ಎಳಾ ಸೊಲೊಮೊನಾನ್ ಹೆ ಪುಸ್ತಕ್ ಲಿವಲ್ಲೆ ಹೊಲ್ಯಾರ್ ಲೈ ಕರುನ್ 970-931 ಚ್ಯಾ ಎಳಾರ್ ಲಿವ್ಕ್ ಫಿರೆ, ಹ್ಯೊ ತೆಜೊ ಜಿವನಾಚೊ ಎಳ್. ಅನಿ ಹುರಲ್ಲಿ ಅದ್ಯಾಯನ್ ಕಾರಾ ಹೆ ದುಶ್ರ್ಯಾ ಕೊನಿಕಿ ಲಿವ್ಕ್ ಫಿರೆ ಮನ್ತಾತ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಹ್ಯಾ ಎಳಾರ್ ವಾಪರಲ್ಲಿ ಭಾಶಾ ಎಕ್ ರಾಜಾಚಿ ಸಾರ್ಕಿ ನಸ್ತಾನಾ, ಎಕ್ ಸೆವಕಾಚಿ ಸಾರ್ಕಿ ಹಾಯ್ ಉಪದೆಸ್ ಕಾರ್: 5:8,9 ತಿ ಅದ್ಯಾಯನ್ ಕಾರಾ ಉಪದೆಸ್ ಕಾರಾಚೆ ಪುಸ್ತಕ್ ಸೊಲೊಮೊನಾಕಿಂತಾ ಲೈ ಎಳಾಚ್ಯಾ ಮಾನಾ ಲಿವ್ನ್ ಹೊಲಾ ಮನುನ್ ಚಿಂತಾತ್, ತೊ ಎಳ್ ಮಟ್ಲ್ಯಾರ್ ಕ್ರಿಸ್ತ್ ಉಪ್ಜುಚ್ಯಾ ಅದ್ದಿ, 400 ಅನಿ 200 ಚ್ಯಾ ಮದ್ದಿ.</para>
  <para style="ip">ಉಪದೆಸ್ ಕಾರ್ ಸಗ್ಳೆಬಿ ಎಕ್ ಉಸಿಲಾ ಸಾರ್ಕೆ ಲಗ್ಗುನಾಚ್ ನಾ ಹೊವ್ನ್ ಜಾತಲೆ ಮನುನ್ ಸಾಂಗ್ತಲ್ಯಾ ವಯ್ನಾ ಆರಂಬ್ ಹೊತಾ (ಉಪದೆಸಕ್ 1:2). ಹೆಚೊ ಅರ್ಥ್ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ಅಮ್ಚೊ ಜಿವನಾ ಅನಿ ಕಾಮ್ ತಾತ್ಕಾಲಿಕ್ ಅನಿ ತೆ ಕಳ್ವುನ್ ಘೆವ್ಕ್ ಕಸ್ಟಾಚೆ ಮನುನ್ ಹೊಲೆ. ಹ್ಯಾತುರ್ಲಿ ಲೈ ವಿಶಯಾ ಉಲ್ಲ್ಯಾಚ್ ಎಳಾತ್ ಇಸ್ರುನ್ ಜಾತಾತ್. ಹ್ಯಾತುರ್ಲೆ ಲೈ ವಿಶಯ್ ಅಮ್ಚ್ಯಾ ಹಾತಿತ್ ರ್‍ಹಾಯ್ನಾ. ಜಿವನಾಕ್ ಕಸೆ ಹಾಯ್ ತಸೆಚ್ ಸ್ವಿಕಾರ್ ಕರ್‍ತಲೆ ಅನಿ ಹೊತ್ತ್ಯಾತುಚ್ ಖುಸಿನ್ ರ್‍ಹಾತಲೆ ಬರೆ (ಉಪದೆಸಕ್ 9:9). ಜಿವನಾಚಿ ತರಾಸಾ ಅನಿ ಖುಸಿ, ದೆವಾಕ್ ಭಿಂವ್ತಲ್ಯಾ ಅನಿ ತೆಚಿ ಹುಕುಮಾ ಮಾನುನ್ ಚಲ್ತಲ್ಯಾ ವಿಶಯಾತ್ ಸಾಂಗುನ್ಗೆತ್ ಪುಸ್ತಕ್ ಸರ್ತಾ (ಉಪದೆಸಕ್ 12:13). ಹೆ ಲೈ ಮಹತ್ವಾಚಿ ವಿಶಯ್ ಹೊವ್ನ್ ಹಾಯ್.</para>
  <para style="iot">ಭಾಗಾ:</para>
  <para style="io1">1. ಉಪದೆಸ್ ಕಾರಾನ್ ಅಪ್ನಾಚ್ಯಾ ಜಿವನಾಚಿ ಉಲ್ಲಿ ಅನ್ಬವಾ ಸಾಂಗುನ್ಗೆತ್, ಬರ್ವನ್ಗಿಕಾರಾಚಿ ವಳಕ್ ಕರುನ್ ದಿತಾ. <char style="ior"><ref loc="ECC 1:1-11">1:1—1:11</ref> </char></para>
  <para style="io1">2. ಜಿವನಾಚ್ಯಾ ಅರ್ಥಾಚ್ಯಾ ವಿಶಯಾತ್ ಚರ್ಚಾ ಕರ್ತಾ.<char style="ior"><ref loc="ECC 1:12-6:9">1:12—6:9</ref> </char></para>
  <para style="io1">3. ಶಿಕಾಪ್ ಕಾರಾಕ್ ಸಲಹಾ ದಿತಾ. <char style="ior"><ref loc="ECC 6:10-12:8">6:10—12:8</ref> </char></para>
  <para style="io1">4. ದೆವಾಕ್ ಭಿಂವ್ತಲೆ ಅನಿ ತೆಚ್ಯಾ ಹುಕುಮಾಕ್ನಿ ಪಾಳ್ತಲೆ ಜಿವನಾಚೆ ಉದ್ದೆಸ್ ಹೊವ್ನ್ ಹಾಯ್ ಮನುನ್ ಸಾಂಗ್ತಲ್ಯಾ ವಯ್ನಾ ಪುಸ್ತಕ್ ಆಕ್ರಿ ಹೊಲಾ. <char style="ior"><ref loc="ECC 12:9-14">12:9—12:14</ref> </char></para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s">ಜಿವನ್ ವ್ಯರ್ಥ್</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />ಜೆರುಜಲೆಮಾತ್ ರಾಜ್ವಟ್ಕಿ ಕರ್ತಲೊ ರಾಜಾ ಅನಿ ದಾವಿದಾಚೊ ಲೆಕ್ ಹೊಲ್ಲ್ಯಾ ಉಪದೆಸ್ ಕಾರಾಚಿ ಶಿಕವ್ನಿಚಿ ಗೊಸ್ಟಿಯಾ. <verse eid="ECC 1:1" /><verse number="2" style="v" sid="ECC 1:2" />ಉಪದೆಸ್ ಕಾರ್ ಕಾಯ್ ಸಾಂಗ್ತಾ ಮಟ್ಲ್ಯಾರ್, ವ್ಯರ್ಥುಚ್ ವ್ಯರ್ಥ್, ಹರ್ ಎಕ್ಬಿ ವ್ಯರ್ಥ್, ಸಗ್ಳೆಬಿ ವ್ಯರ್ಥ್. <verse eid="ECC 1:2" /><verse number="3" style="v" sid="ECC 1:3" />ಹ್ಯಾ ಜಗಾತ್ ಮಾನ್ಸಾನ್ ಕರಲ್ಲ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ಅನಿ ಸೊಸಲ್ಲ್ಯಾ ತರಾಸಾಂಚ್ಯಾ ವಯ್ನಾ ತೆಕಾ ಕಾಯ್ ಫಾಯ್ದೊ? <verse eid="ECC 1:3" /><verse number="4" style="v" sid="ECC 1:4" />ಎಕ್ ಪಿಳ್ಗಿ ನಾಶ್ ಹೊವ್ನ್ ಜಾತಾ ಅನಿ ಎಕ್ ಪಿಳ್ಗಿ ಉಪಾಜ್ತಾ, ಖರೆ ಜಿಮಿನ್ ಕಸಿ ಹಾಯ್ ತಸಿಚ್ ಸದಾ ಸರ್ವತಾಕ್ ಇಬೆ ರ್‍ಹಾತಾ. <verse eid="ECC 1:4" /><verse number="5" style="v" sid="ECC 1:5" />ದಿಸ್ ಉಗಾವ್ತಾ ಅನಿ ಬುಡ್ತಾ, ಅಪ್ನಿ ಉಗಾವಲ್ಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಅನಿ ಪರ್‍ತುನ್ ಲಗ್ಗುನಾ ಜಾತಾ. <verse eid="ECC 1:5" /><verse number="6" style="v" sid="ECC 1:6" />ವ್ಹಾರೊ ದಕ್ಷಿನಾಕ್ ಮಾರುನ್, ಉತ್ತರಾಕ್ ಯೆತಾ, ತೊ ಫಿರುನ್ಗೆತ್ ಫಾಟಿ ಪರ್‍ತುನ್ ಯೆತಾ. <verse eid="ECC 1:6" /><verse number="7" style="v" sid="ECC 1:7" />ಹರ್ ಎಕ್ ನ್ಹಯಾ ಹೊಂವ್ನ್ ಸಮುಂದರಾಕ್ ಪಾವ್ತಾತ್, ಖರೆ ಸಮುಂದರ್ ಭರಿನಾ, ತಿ ನ್ಹಯಾ ಹೊಂವ್ನ್ ಯೆಲ್ಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಪರ್‍ತುನ್ ಜಾತಾತ್. <verse eid="ECC 1:7" /><verse number="8" style="v" sid="ECC 1:8" />ಸಗ್ಳಿ ಕಾಮಾ ಹಾರುನ್ ಜಾತಾತ್, ಹೆ ಮೊಟೆಪಾನ್ ಶಬ್ದಾನಿ ವಿವರನ್ ಕರುಕ್ ಹೊಯ್ನಾ, ಅಮ್ಚ್ಯಾ ಡೊಳ್ಯಾನಿ ಬಗುನ್ ಮನ್ ಭರ್ ಫಿರೆ ಕರುನ್ ಘೆವ್ಕ್ ಹೊಯ್ನಾ, ಅಮ್ಚ್ಯಾ ಕಾನಾಕ್ನಿ ಆಯ್ಕುನ್ ಫಿರೆ ಕರುನ್ ಘೆವ್ಕ್ ಹೊಯ್ನಾ. <verse eid="ECC 1:8" /><verse number="9" style="v" sid="ECC 1:9" />ಅದ್ದಿ ಕಾಯ್ ಘಡಲ್ಲೆ ಹಾಯ್ ತೆಚ್ ಪರ್‍ತುನ್ ಘಡ್ತಾ, ಅದ್ದಿ ಕಾಯ್ ಕರುನ್ ಹೊಲ್ಲೆ ಹಾಯ್ ತೆಚ್ ಪರ್‍ತುನ್ ಕರುನ್ ಹೊತಾ, ಸಗ್ಳ್ಯಾ ಜಗಾತ್ ಕಾಯ್ಬಿ ನ್ಹವೆ ನಾ. <verse eid="ECC 1:9" /><verse number="10" style="v" sid="ECC 1:10" />“ಅಬಕ್” ಕಾಯ್ಕಿ ಎಕ್ ನ್ಹವೆ ಹಾಯ್ ಮನುನ್ ತೆನಿ ಸಾಂಗ್ತಿಲ್, ಖರೆ, ತೆ ಅದ್ದಿಚ್ ಹೊಲ್ಲೆ ರ್‍ಹಾತಾ, ಅಮಿ ಉಪ್ಜುಚ್ಯಾ ಅದ್ದಿ ಹೊಲ್ಲೆ ಹೊವ್ಕ್ ಫಿರೆ. <verse eid="ECC 1:10" /><verse number="11" style="v" sid="ECC 1:11" />ಅದ್ದಿ ಘಡಲ್ಲ್ಯಾ ವಿಶಯಾತ್ ಕಾಯ್ಬಿ ಯಾದ್ ನಾ, ಅನಿ ಅತ್ತ್ಯಾಚ್ಯಾ ಯೆಳಾಚ್ಯಾ ಮಾನಾ ಘಡಲ್ಲೆ ತೆಜ್ಯಾ ಮಾನಾ ಅತ್ತ್ಯಾಚ್ಯಾಕ್ನಿ ಸಾಂಗುಕ್ ಕೊನ್ಬಿ ರ್‍ಹಾಯ್ನಾತ್.<verse eid="ECC 1:11" /></para>
  <para style="s">ಉಪದೆಸ್ ಕಾರಾಚೊ ಅನ್ಬೊವ್</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />ಉಪದೆಸಕ್ ಹೊಲ್ಲೊ ಮಿಯಾ ಜರುಜಲೆಮಾತ್ ಇಜ್ರಾಯೆಲಾಂಚೊ ರಾಜಾ ಹೊವ್ನ್ ಹೊತ್ತೊ, <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />ಜಗಾತ್ ಚಲ್ತಲಿ ಸಗ್ಳಿ ಕಾಮಾ ಲೈ ಹುರ್ಶಾಕಿನ್ ಇಚಾರ್ನಿ ಕರುಚೆ ಮನುನ್ ಮನ್ ಕರ್ಲೊ, ಖರೆ ಮಾನ್ಸಾಚೆ ಕಾಮ್ ಮನುನ್ ದೆವಾನ್ ನೆಮಲ್ಲಿ ತಿ ಕಾಮಾ ಸಗ್ಳಿ ಲೈ ತರಾಸಾಚಿ ಹೊವ್ನ್ ಹಾತ್. <verse eid="ECC 1:13" /><verse number="14" style="v" sid="ECC 1:14" />ಹ್ಯಾ ಜಗಾತ್ ಕರುನ್ ಹೊಲ್ಲೆ ಹರ್ ಎಕ್ ಮಿಯಾ ಬಗಟ್ಲೊ, ಅನಿ ಮಿಯಾ ತುಕಾ ಸಾಂಗ್ತಾ, ಹೆ ವ್ಹಾರ್ಯಾಕ್ ಪಾಟ್ ಲಾಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಹೆ ಸಗ್ಳೆ ವ್ಯರ್ಥ್. <verse eid="ECC 1:14" /><verse number="15" style="v" sid="ECC 1:15" />ತಿಯಾ ವಾಂಕ್ಡೆ ಹೊತ್ತ್ಯಾಕ್ ನಿಟ್ ಕರುಕ್ ಹೊಯ್ನಾ, ಅನಿ ಕಾಯ್ಬಿ ನಸಲ್ಲೆ ಮೆಜುಕ್ ಹೊಯ್ನಾ. <verse eid="ECC 1:15" /><verse number="16" style="v" sid="ECC 1:16" />ಮಿಯಾ ಮನಾತುಚ್, ಮಾಜ್ಯಾನ್ ಅದ್ದಿ ಜರುಜಲೆಮಾತ್ ರಾಜ್ವಟ್ಕಿ ಕರಲ್ಯಾಂಚ್ಯಾಕಿಂತಾ ಮಿಯಾ ಲೈ ಬುದ್ವಂತ್ ಹಾಯ್, ಅನಿ ಮಾಜೆ ಮನ್ ಲೈ ಶಾನೆಪಾನಾನ್ ಅನಿ ಜ್ಞಾನಾನ್ ಭರಲ್ಲೆ ಹಾಯ್ ಮನುನ್ ಚಿಂತ್ಲೊ. <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />ಶಾನೆಪಾನ್ ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಪಿಸೆಪಾನ್ ಅನಿ ಬುದ್ಗೆಡಿಪಾನಾಕ್ಡೆ ಮನ್ ಥವ್ಲೊ, ಖರೆ ಹೆಬಿ ವ್ಹಾರ್ಯಾಕ್ ಪಾಟ್ ಲಾಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಸಗ್ಳೆಬಿ ವ್ಯರ್ಥ್ ಮನುನ್ ಕಳ್ವುನ್ ಘೆಟ್ಲೊ. <verse eid="ECC 1:17" /><verse number="18" style="v" sid="ECC 1:18" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಲೈ ಬುದ್ದ್ ಹೊತ್ತ್ಯಾಕ್ಡೆ ಲೈ ಚಿಂತಾ ಯೆತಾ, ಲೈ ಕಳ್ವುನ್ ಘೆತಲ್ಯಾಕ್ ಮನಾಕ್ ಲೈ ದುಕ್ತಾ.<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />ತನ್ನಾ, ಮಿಯಾ ಮಾಜ್ಯಾ ಮನಾತ್ ಖುಸಿ ಅನಿ ಆನಂದ್ ಹುಡ್ಕುಚೆ ಮನುನ್ ನಿರ್ದಾರ್ ಕರ್ಲೊ. ಖರೆ ಮಾಕಾ ಹೆಬಿ ವ್ಯರ್ಥುಚ್ ಮನುನ್ ಕಳ್ಳೆ. <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />ಮಾಕಾ ಹೊ ಹಾಸೊಬಿ ಪಿಸ್ಯಾ ಪಾನಾಚೊ ಮನುನ್ ಕಳ್ಳೆ, ತಿಯಾ ಖುಸಿ ಹೊವ್ಕ್ ಲಾಗಲ್ಲೆಬಿ ಬರ್ಯಾಚೆ ನ್ಹಯ್, <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />ಮಿಯಾ ಮಾಜ್ಯಾ ತವ್ಡ್ಯಾಕ್ ಹ್ಯಾ ಜಗಾತ್ ಮಾನ್ಸಾಕ್ನಿ ಹೊತ್ತ್ಯಾ ಉಲ್ಲ್ಯಾಸ್ಯಾ ವಯ್ಯಾತ್ನಿ ಕಾಮ್ ಕರ್‍ತಲೆ ಬರೆ ಮನುನ್ ಕಳ್ವುನ್ ಘೆವ್ಚೆ ಮನುನ್ ಮಾಜೊ ಮನ್ ಹುಶಾರ್ ರ್‍ಹಾತಾನಾಚ್ ಆಂಗಾಕ್ ವಯ್ನ್ ಫಿವ್ನ್ ಹುರ್ಗಿ ಭರಿ ಸಾರ್ಕೆ ಅನಿ ಬುದ್ಗೆಡಿಪಾನಾತ್ ಮಾಕಾ ಘಾಲುನ್ ಘೆವ್ಚೆ ಮನುನ್ ಮನಾತುಚ್ ಚಿಂತುನ್ ಘೆಟ್ಲೊ. <verse eid="ECC 2:3" /><verse number="4" style="v" sid="ECC 2:4" />ಮಿಯಾ ಮೊಟಿ ಮೊಟಿ ಕಾಮಾ ಕರುಕ್ ಲಾಗ್ಲೊ, ಅನಿ ಮಾಜ್ಯಾ ಸಾಟ್ನಿ ಘರಾ ಭಾಂದುನ್ ಘೆಟ್ಲೊ. ಅನಿ ದರಾಕ್ಷಾಚೊ ಮ್ಹಳೊ ಲಾವ್ಲೊ; <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />ಮಿಯಾ ಮ್ಹಳೆ ಅನಿ ಫಳಾಂಚಿ ಝಾಡಾ ತಯಾರ್ ಕರಸ್ಲೊ, ಅನಿ ತ್ಯಾತುರ್ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಫಳಾಂಚಿ ಝಾಡಾ ಲಾವ್ಲೊ. <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />ಅನಿ ಉಗಾವ್ತಲ್ಯಾ ಝಾಡಾಕ್ನಿ ಪಾನಿ ಗಾಂವ್ದಿತ್ ಮನುನ್ ಕಾಲ್ಗಿಯಾ ಕಾಡಸ್ಲೊ, <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />ಮಿಯಾ ಲೈ ಗುಲಾಮಾಕ್ನಿ ಇಕಾತ್ ಘೆಟ್ಲೊ, ಅನಿ ತೆಂಚ್ಯಾ ವಯ್ನಾ ಘರ್‍ಹಾತ್ ಲೈ ಗುಲಾಮಾ ಉಪಜ್ಲಿ, ಅನಿ ಮಾಜ್ಯಾಕ್ಡೆ ಜರುಜಲೆಮಾತ್ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾಚ್ಯಾಕ್ನಿ ಮಿಯಾ ಲೈ ಗೊರಾ ಡೊರಾಂಚೊ ವಡಿಲ್ ಹೊಲೊ. <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />ಅನಿ ಮಿಯಾ ದುಸ್ರ್ಯಾ ದುಸ್ರ್ಯಾ ರಾಜ್ವಟ್ಕಿ ಕರ್‍ತಲ್ಯಾ ರಾಜಾಂಚ್ಯಾಕ್ನಾ ಕಾನಿಕ್ ಸ್ವಿಕಾರ್ ಕರುನ್ ಮಾಜ್ಯಾ ಪೆಟಿತ್ ಭರುನ್ ಘೆಟ್ಲೊ, ಅನಿ ಮಾಕಾ ಉಮ್ಮೆದ್ ಕರ್ತಲಿ ಗಿತಾ ಸಾಂಗುಕ್ ಘವ್ಮಾನ್ಸಾ ಅನಿ ಬಾಯ್ಕಾಮಾನ್ಸಾ ಹೊತ್ತಿ, ಅನಿ ಮಾನ್ಸಾಕ್ನಿ ಪಾಜೆ ಹೊತ್ತಿ ಲೈ ಬಾಯ್ಕಾಬಿ ಮಾಕಾ ಹೊತ್ತಿ. <verse eid="ECC 2:8" /><verse number="9" style="v" sid="ECC 2:9" />ಹ್ಯೊ, ಮಿಯಾ ಜರುಜಲೆಮಾತ್ ವಸ್ತಿರಾತಲ್ಯಾ ಸಗ್ಳ್ಯಾಂಚ್ಯಾಕಿಂತಾಬಿ ಲೈ ಮೊಟೊ ಹೊಲೊ ಅನಿ ಮಾಜ್ಯಾ ಬುದ್ದಿನ್ ಮಾಕಾ ಪಡುಕ್ ದಿವ್ಕ್ ನಾ. <verse eid="ECC 2:9" /><verse number="10" style="v" sid="ECC 2:10" />ಮಾಕಾ ಪಾಜೆ ಹೊಲ್ಲೆ ಸಗ್ಳೆ ಮಿಯಾ ಘೆಟ್ಲೊ, ಮಾಜ್ಯಾ ಮನಾಕ್ ಖುಸಿ ಹೊತಲ್ಯಾ ವಿಶಯಾಕ್ ಮಿಯಾ ಆಡ್ವುಕ್ ನಾ, ಮಿಯಾ ಕಾಮ್ ಕರಲ್ಲ್ಯಾ ಹರ್ ಎಕ್ ವಿಶಯಾತ್ ಶಬಾಸ್ಕಿ ಘೆತಾ, ಅನಿ ಹೆ ಸಗ್ಳೆ ಮಾಜ್ಯಾ ಕಾಮಾಕ್ನಿ ಗಾವಲ್ಲೆ ಪ್ರತಿಫಳ್ . <verse eid="ECC 2:10" /><verse number="11" style="v" sid="ECC 2:11" />ತನ್ನಾ ಮಿಯಾ ಹಾತಿನ್ ಕರಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಕಾಮಾತ್ನಿ, ತರಾಸಾಚ್ಯಾ ಕಾಮಾಕ್ನಿ ಬಗಟ್ಲೊ, ವ್ಹಾರ್ಯಾಕ್ ಪಾಟ್ ಲಾಗುನ್ ಗೆಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಜಗಾತ್ ಸಗ್ಳೆಬಿ ವ್ಯರ್ಥ್, ಜಗಾತ್ ಕಾಯ್ಬಿ ಫಾಯ್ದೊ ದಿಸುಕ್ನಾ. <verse eid="ECC 2:11" /><verse number="12" style="v" sid="ECC 2:12" />ಜ್ಞಾನ್ ಬಗುಕ್ ಮನುನ್ ಪರತ್ಲೊ, ಪಿಶೆಪಾನ್ ಅನಿ ಬುದ್ಗೆಡಿಪಾನ್ ಪರ್‍ತುನ್ ಬಗಟ್ಲೊ, ರಾಜಾಚಿ ಕಟ್ಪಟಾಚ್ ಅಸಿ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ, ಅನಿ ಎಕ್ಲ್ಯಾಕ್ಡೆ ಕಾಯ್ ಕರುಕ್ ಹೊತಾ? ಸಾಂಗಲ್ಲೆಚ್ ಹೊತಾ ಮನುನ್ ಚಿಂತುನ್ಗೆಟ್ಲೊ. <verse eid="ECC 2:12" /><verse number="13" style="v" sid="ECC 2:13" />ತನ್ನಾ ಉಜ್ವೊಡ್ ಕಾಳ್ಕಾಕಿಂತಾ ಶ್ರೆಶ್ಟ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆ ಜ್ಞಾನ್ಬಿ ಬುದ್ದ್ ನಸಲ್ಯಾಕ್ನಿ ಶ್ರೆಶ್ಟ್ ಹೊವ್ನ್ ಹಾಯ್ ಮನುನ್ ದಿಸುನ್ ಯೆಲೆ. <verse eid="ECC 2:13" /><verse number="14" style="v" sid="ECC 2:14" />ಜ್ಞಾನ್ ಹೊತ್ತ್ಯಾಚೆ ಡೊಳೆ ಉಗ್ಡೆ ರ್‍ಹಾತಾತ್, ಅನಿ ಪಿಶೊ ಕಾಳ್ಕಾತ್ ಚಲ್ತಾ, ಖರೆ ತೆಂಕಾ ದೊಗಾಕ್ನಿಬಿ ಎಕುಚ್ ಗತ್ ರಾಕುನ್ಗೆತ್ ಹಾಯ್ ಮನುನ್ ಮಾಕಾ ಕಳ್ಳೆ. <verse eid="ECC 2:14" /><verse number="15" style="v" sid="ECC 2:15" />ಮಿಯಾ ಯೆವ್ಡೆ ಲೈ ಶಾನೊ ಹೊವ್ನ್ ಬಿ ಕಾಯ್ ಫಾಯ್ದೊ? ಹ್ಯಾ ಬುದ್ಗೆಡ್ಯಾಕ್ನಿ ಯೆಲ್ಲಿ ಗತ್ ಮಾಕಾಬಿ ಯೆತಾ ಕಾಯ್ಕಿ ಮನುನ್ ಮಿಯಾಚ್ ಜವಾಬ್ ದಿವ್ನ್ ಘೆಟ್ಲೊ, ಹೆ ಸಗ್ಳೆ ವ್ಯರ್ಥ್, <verse eid="ECC 2:15" /><verse number="16" style="v" sid="ECC 2:16" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಪಿಶ್ಯಾಚ್ಯಾ ಸಾರ್ಕೊಚ್ ಶಾನೊಬಿ ಲೈ ದಿಸಾಂಚ್ಯಾ ಮಾನಾ ಇಸ್ರುನ್ ಘಾಲ್ತಾ, ಅನಿ ಅತ್ತಾ ಹೊತ್ತೆ ಸಗ್ಳೆ ಫಿಡೆ ಯೆತಲ್ಯಾ ಯೆಳಾಚ್ಯಾ ಅದ್ದಿಚ್ ಇಸ್ರುನ್ ಸೊಡ್ತಾತ್, ಅಬಕ್, ಪಿಶ್ಯಾಚ್ಯಾ ಸಾರ್ಕೊಚ್ ಶಾನೊಬಿ ಮರುನ್ ಜಾತಾ. <verse eid="ECC 2:16" /><verse number="17" style="v" sid="ECC 2:17" />ಮಾಕಾ ಹ್ಯಾ ಜಗಾತ್ ಕಾಯ್ಬಿ ನಾ ಮನ್ತಲೆ ಕಳುನ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ ಹರ್ ಎಕಾನ್ ಮಾಕಾ ತರಾಸಾತ್ ಘಾಟ್ಲ್ಯಾನ್, ತನ್ನಾ ಮಿಯಾ ವ್ಹಾರ್ಯಾಕ್ ಫಾಟ್ ಲಾಗುನ್ ಗೆಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಸಗ್ಳೆಬಿ ವ್ಯರ್ಥ್ ಮನುನ್ ಕಳ್ವುನ್ ಘೆಟ್ಲೊ. <verse eid="ECC 2:17" /><verse number="18" style="v" sid="ECC 2:18" />ಮಾಜ್ಯಾ ತರಾಸಾಚಿ ಪ್ರತಿಫಳ್ ಫಾಟ್ನಾ ಯೆತಲ್ಯಾಕ್ ಸೊಡುನ್ ದಿವ್ಚೆ ಮನುನ್ ಕಳಲ್ಲ್ಯಾ ತನ್ನಾ ಮಿಯಾ ಹ್ಯಾ ಜಗಾತ್ ಕರುನ್ ಘೆಟಲ್ಲ್ಯಾ ತರಾಸಾಂಚ್ಯಾ ವಿಶಯಾತ್ ಲೈ ಬೆಜಾರ್ ಹೊಲೊ. <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />ಅನಿ ತೊ ಶಾನೊಬಿ ರಾವ್ಕ್ ಫಿರೆ, ನಾತರ್ ಪಿಶೊಬಿ ರಾವ್ಕ್ ಫಿರೆ ಕೊನಾಕ್ ಗೊತ್ತ್? ತೊ ಕಸ್ಲೊ ರಾಲ್ಯಾರ್ಬಿ ಮಿಯಾ ಜಗಾತ್ ಖಲ್ಯಾ ವಿಶಯಾತ್ ಶಾನೆಪಾನ್ ಅನಿ ಕಟ್ಪಟ್ ಕರಲ್ಲೊ ತೆಜ್ಯಾ ವರ್‍ತಿ ರಾಜ್ವಟ್ಕಿ ಕರ್ತಾ, ಅನಿ ಹೆ ಸಗ್ಳೆ ವ್ಯರ್ಥ್. <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />ಅಸೆ ರ್‍ಹಾತಾನಾ, ಮಿಯಾ ಜಗಾತ್ ತರಾಸ್ ಕರಲ್ಲ್ಯಾ ಕಾಮಾಚ್ಯಾ ವಿಶಯಾತ್ ಬೆಜಾರ್ ಹೊಲೊ. <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />ಎಕ್ಲ್ಯಾನ್ ಅಪ್ನಾಚ್ಯಾ ಬುದ್ದಿನ್ ಅನಿ ಶಾನೆಪಾನಾನ್ ಎಕ್ ಸ್ಥಿತಿಕ್ ಹಾನಲ್ಲ್ಯಾ ಮನಾ ಅಪ್ಲ್ಯಾ ಕಾಮಾತ್ ಕಟ್ಪಟ್ ಕರುನಸಲ್ಲ್ಯಾ ಅನಿ ಎಕ್ಲ್ಯಾಕ್ ತೆಚೆ ಫಳ್ ಸೊಡುನ್ ದಿವ್ಚೆ, ಹೆ ವ್ಯರ್ಥಬಿ ಅನ್ಯಾಯ್ ಬಿ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />ಹ್ಯಾ ಜಗಾತ್ ಮಾನ್ಸಾನ್ ಪುರಾ ಮನಾನ್ ಕರ್‍ತಲ್ಯಾ ಖಮಾಯಿತ್ ಫಾಯ್ದೊ ಕಾಯ್? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />ತೆಚ್ಯಾ ಸಗ್ಳ್ಯಾ ದಿಸಾತ್ನಿ ತೆಕಾ ಕಳ್ವಳೊ ಹಾಯ್, ತೆಚೆ ಸಗ್ಳೆ ಕಾಮ್ಬಿ ತರಾಸಾಚೆಚ್, ಅನಿ ರಾತ್ತಿನಿಬಿ ತೆಜ್ಯಾ ಮನಾತ್ ಸಮಾಧಾನ್ ನಾ, ಹೆಬಿ ವ್ಯರ್ಥುಚ್.<verse eid="ECC 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24" />ಅನಿ ಖಾನ್ಯಾ ಫಿನ್ಯಾತ್ಬಿ ತರಾಸ್ ಕರುನ್ ಘೆವ್ನ್ ಸುಕಾನಿ ರ್‍ಹಾತಲ್ಯಾಚ್ಯಾಕ್ನಿ ಮಾನ್ಸಾಕ್ ಅನಿ ಕಾಯ್ ಮೊಟೆ ನ್ಹಯ್, ತನ್ನಾ ಹೆ ಸಗ್ಳೆ ಮಾಕಾ ದೆವಾನುಚ್ ಕರಲ್ಲೆ ಮನುನ್ ದಿಸುನ್ ಯೆಲೆ. <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />ದೆವ್ ನಸ್ತಾನಾ, ತುಮಿ ಖಾವ್ನ್ ಜೆವ್ನ್ ಮೊಜ್ ಮಸ್ತಿ ಕರುನ್ ರ್‍ಹಾತಲೆ ಕಸೆ? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />ದೆವ್ ಅಪ್ನಾಕ್ ಬರೆ ದಿಸಲ್ಯಾಕ್ನಿ ಬುದ್ದ್, ಶಾನೆಪಾನ್, ಅನಿ ಖುಶಿ ದಿತಾ, ಅನಿ ಚುಕ್ ಕರಲ್ಯಾಕ್ನಿ ಅಪ್ನಾಚ್ಯಾ ಮನಾಕ್ ಯೆಲ್ಲ್ಯಾಕ್ನಿ ದಿಲ್ಲೆ ಗೊಳಾ ಕರುನ್ ಥವ್ತಲಿ ಕಟ್ಪಟಾ ಥವ್ತಾ, ಹೆಬಿ ವ್ಹಾರ್ಯಾಕ್ ಪಾಟ್ ಲಾಗುನ್ ಗೆಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ವ್ಯರ್ಥ್.<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s">ಹರ್ ಎಕಾಚೊ ಎಳ್</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1" />ಹರ್ ಎಕ್ಬಿ ದೆವಾನ್ ನೆಮಲ್ಲ್ಯಾ ಎಳಾರ್ ಹ್ಯಾ ಜಗಾತ್ ಘಡ್ತಾ. <verse eid="ECC 3:1" /><verse number="2" style="v" sid="ECC 3:2" />ಉಪಾಜ್ತಲ್ಲ್ಯಾಕ್ ಎಕ್ ಎಳ್, ಅನಿ ಮರ್ತಲ್ಯಾಕ್ ಎಕ್ ಎಳ್, ಲಾವ್ಕ್ ಎಕ್ ಎಳ್, ಲಾವಲ್ಲೆ ಉಪ್ಸುಕ್ ಎಕ್ ಎಳ್, <verse eid="ECC 3:2" /><verse number="3" style="v" sid="ECC 3:3" />ಜಿವ್ ಕಾಡುಕ್ ಎಕ್ ಎಳ್, ಸ್ವಸ್ತ್ ಕರುಕ್ ಎಕ್ ಎಳ್, ಖಾಲ್ತಿ ಪಾಡ್ವುಕ್ ಎಕ್ ಎಳ್, ಭಾಂದುನ್ ಇಬೆ ಕರುಕ್ ಎಕ್ ಎಳ್, <verse eid="ECC 3:3" /><verse number="4" style="v" sid="ECC 3:4" />ರಡುಕ್ ಎಕ್ ಎಳ್, ಹಾಸುಕ್ ಎಕ್ ಎಳ್, ಅಳಾಪ್ ಕರುಕ್ ಎಕ್ ಎಳ್, ನಾಚುಕ್ ಎಕ್ ಎಳ್, <verse eid="ECC 3:4" /><verse number="5" style="v" sid="ECC 3:5" />ಗುಂಡೆ ಟಾಕ್ತಲೊ ಎಕ್ ಎಳ್, ಗುಂಡೆ ಗೊಳಾ ಕರ್ತಲೊ ಎಕ್ ಎಳ್, ಯಾಂಗ್ ಮಾರುಕ್ ಎಕ್ ಎಳ್, ಯಾಂಗ್ ಮಾರಿ ನಸಲ್ಲೊ ಎಕ್ ಎಳ್, <verse eid="ECC 3:5" /><verse number="6" style="v" sid="ECC 3:6" />ಖಮ್ವುಕ್ ಎಕ್ ಎಳ್, ಲುಕ್ಷಾನ್ ಹೊವ್ಕ್ ಎಕ್ ಎಳ್, ಹುರ್ವುತಲೊ ಎಕ್ ಎಳ್, ಟಾಕ್ತಲೊ ಎಕ್ ಎಳ್, <verse eid="ECC 3:6" /><verse number="7" style="v" sid="ECC 3:7" />ಪಿಂಜುಕ್ ಎಕ್ ಎಳ್, ಸಿವುಕ್ ಎಕ್ ಎಳ್, ಬೊಲುಕ್ ಎಕ್ ಎಳ್, ಬೊಲಿನಸ್ತಾನಾ ರಾವ್ಕ್ ಎಕ್ ಎಳ್, <verse eid="ECC 3:7" /><verse number="8" style="v" sid="ECC 3:8" />ಪ್ರೆಮಾನ್ ರಾವ್ಕ್ ಎಕ್ ಎಳ್, ದ್ವೆಶ್ ಕರುಕ್ ಎಕ್ ಎಳ್, ಝಗ್ಡ್ಯಾಕ್ ಎಕ್ ಎಳ್, ಸಮಾಧಾನಾನ್ ರಾವ್ಕ್ ಎಕ್ ಎಳ್. <verse eid="ECC 3:8" /><verse number="9" style="v" sid="ECC 3:9" />ಘೊಳ್ತಲ್ಯಾಕ್ ತೆಜ್ಯಾ ಕಸ್ಟಾನ್ ಕಾಯ್ ಫಾಯ್ದೊ? <verse eid="ECC 3:9" /><verse number="10" style="v" sid="ECC 3:10" />ಮಾನ್ಸಾಚೆ ಕಾಮ್ ಮನುನ್ ದೆವಾನ್ ನೆಮಲ್ಲೊ ಕಟ್ಪಟ್ ಮಿಯಾ ಬಗಟ್ಲಾ. <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />ತಸೆ ಹರ್ ಎಕ್ಲ್ಯಾಕ್ಬಿ ಸಮಾ ಎಳ್ ನಿರ್ದಾರ್ ಕರುನ್ ಥವ್ಲಾ, ತೆನಿ ಅಮ್ಕಾ ಘಡ್ತಲ್ಯಾ ವಿಶಯಾತ್ ಬುದ್ದ್ ದಿಲಾ, ಖರೆ ತೊ ಕನ್ನಾಬಿ ಕಾಯ್ ಕರ್ನಾರ್ ಹಾಯ್ ಮನ್ತಲ್ಯಾ ಸಮಾಧಾನಾಚಿ ಫುರಾ ಬುದ್ದ್ ದಿವ್ಕ್ ನಾ. <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />ಹೆಚ್ಯಾ ವಯ್ನಾ ಮಿಯಾ ಮಾನುಸ್ ಅಪ್ನಾಚ್ಯಾ ಝಿತ್ತೊ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಎಳಾರ್ ಖುಸಿನ್ ಸುಖಾನ್ ರ್‍ಹಾತಲ್ಯಾಚ್ಯಾಕ್ನಿ ತೆಕಾ ಖಲೆಬಿ ಜಾಸ್ತಿಚೆ ನ್ಹಯ್ ಮನುನ್ ಕಳ್ವುನ್ ಘೆಟ್ಲೊ. <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />ಅಮಿ ಸಗ್ಳೆ ಅಮ್ಚ್ಯಾ ಖಾತಫಿತಲೆ ಅನಿ ಖುಸಿನ್ ರ್‍ಹಾತಲೆ ಅನಿ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಕಾಮಾ ಹ್ಯಾತುರ್ ಸಗ್ಳೆ ಆರಾಮಾನ್ ರ್‍ಹಾತಲೆ, ದೆವಾಕ್ನಾ ದಿಲ್ಲೆ ದೆನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="ECC 3:13" /><verse number="14" style="v" sid="ECC 3:14" />ದೆವಾಚೆ ಕಾಮ್ ಸದಾ ಸರ್ವತಾಚೆ ಮನುನ್ ಮಾಕಾ ಗೊತ್ತ್ ಹಾಯ್, ತೆಕಾ ಅಮಿ ಕಾಯ್ಬಿ ಮಿಳ್ವುಕ್ ಹೊಯ್ನಾ, ಅನಿ ತ್ಯಾತುರ್ನಾ ಕಾಯ್ಬಿ ಕಾಡುಕ್ ಹೊಯ್ನಾ, ದೆವಾಚ್ಯಾ ಹ್ಯಾ ನೆಮಾಕ್ ಮಾನುಸ್ ಭಿಂಯಾನ್ ಅನಿ ದೆವಸ್ಪಾನಾನ್ ರಾವ್ಚೆ ಮನ್ತಲೆಚ್ ಹೆ ಕಾರನ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="ECC 3:14" /><verse number="15" style="v" sid="ECC 3:15" />ಅತ್ತಾ ಹಾಲಿ ಘಡಲ್ಲೆ ಸಗ್ಳೆ ಘಡ್ನಾರ್ ಹೊತ್ತೆ ಸಗ್ಳೆ ಅದ್ದಿಚ್ ಹೊವ್ನ್ ಗೆಲ್ಲೆ ಹಾಯ್, ಫಿಡ್ಲೆ ಅತ್ತಾಬಿ ಹಾಯ್, ಹೊವ್ನ್ ಗೆಲ್ಲೆ ದೆವ್ ಪರ್‍ತುನ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ.<verse eid="ECC 3:15" /></para>
  <para style="s">ಜಗಾತ್ ಅನ್ಯಾಯ್</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಮಿಯಾ ಜಗಾಕ್ ಡೊಳೆ ಲಾವ್ನ್ ಬಗುನ್, ಮಿಯಾ ಝಡ್ತಿ ಕರ್‍ತಲ್ಯಾ ಜಾಗ್ಯಾರ್ ಅನಿ ದೆವಸ್ಪಾನಾಚ್ಯಾ ಜಾಗ್ಯಾರ್, ಅಧರ್ಮ್ ಬಗಟ್ಲೊ. <verse eid="ECC 3:16" /><verse number="17" style="v" sid="ECC 3:17" />ತನ್ನಾ ಮಿಯಾ ಮನಾತುಚ್ ದೆವಾನ್ ಪ್ರಾಮಾನಿಕ್ ಅನಿ ಅಪ್ರಾಮಾನಿಕ್ ಮಾನ್ಸಾಕ್ನಿ ಝಡ್ತಿ ಕರ್ತಾ, ತೆಜ್ಯಾ ಝಡ್ತಿತ್ ಸಗ್ಳ್ಯಾ ಕಾಮಾಕ್ನಿಬಿ ನಿರ್ದಾರ್ ಕರಲ್ಲೊ ಎಳ್ ಹಾಯ್ ನ್ಹಯ್ ಮನುನ್ ಘೆಟ್ಲೊ. <verse eid="ECC 3:17" /><verse number="18" style="v" sid="ECC 3:18" />ಅನಿಬಿ ಮಾನಾ ಅಸೆಚ್ ಚಿಂತ್ಲೊ, ದೆವಾನ್ ಮಾನ್ಸಾಕ್ನಿ ಪರಿಕ್ಷಾ ಕರುಕ್ ಅನಿ ಮಾನ್ಸಾಕ್ನಿ ಅಪ್ನಿ ಜನಾವರಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಹಾತ್ ಮನುನ್ ಕಳ್ವುನ್ ಘೆವ್ಕ್ ಹೊಯ್ ಸಾರ್ಕೆ ಹೆ ಮಾನ್ಸಾಚ್ಯಾ ಸಾರ್ಕೆ ಹೊಲ್ಲೆ ನ್ಹಯ್. <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />ಮಾನ್ಸಾಕ್ ಅನಿ ಜನಾವರಾಕ್ನಿ ಎಕುಚ್ ಗತ್, ಜನಾವರಾಕ್ ಮರಾನ್ ಯೆಲ್ಯಾ ಸಾರ್ಕೆ ಮಾನ್ಸಾಕ್ ಯೆತಾ, ಸಗ್ಳ್ಯಾಕ್ನಿಬಿ ಜಿವ್ ಎಕುಚ್, ಮಾನುಸ್ ಜನಾವರಾಕಿಂತಾ ಶ್ರೆಸ್ಟ್ ನ್ಹಯ್, ಹೆ ಸಗ್ಳೆ ವ್ಯರ್ಥ್. <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />ಸಗ್ಳಿ ಜನಾವಾರಾ ಎಕುಚ್ ಜಾಗ್ಯಾರ್ ಜಾತಾತ್, ಸಗ್ಳೆ ಮಾಟಿಕ್ನಾ ಹೊಲ್ಲೆಚ್, ಸಗ್ಳೆ ಪರ್‍ತುನ್ ಮಾಟಿಕುಚ್ ಜಾತಾ. <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />ಮಾನ್ಸಾಚೊ ಆತ್ಮೊ ವರ್‍ತಿ ಚಡ್ತಾಕಿ, ಜನಾವರಾಂಚೊ ಆತ್ಮೊ ಖಾಲ್ತಿ ಜಿಮ್ನಿತ್ ಮಿಳ್ತಾಕಿ, ತೆ ಕೊನಾಕ್ ಗೊತ್ತ್? <verse eid="ECC 3:21" /><verse number="22" style="v" sid="ECC 3:22" />ಅಸೆ ಮಿಯಾ ಚಿಂತುನ್, ಮಾನುಸ್ ಅಪ್ನಾಚ್ಯಾ ಕಾಮಾತ್ನಿ ಖುಸಿ ಹೊತಲೆ ಸೊಡುನ್, ತೆಕಾ ಅನಿ ಕಾಯ್ಬಿ ಮೊಟೆ ನಾ, ಹೊಚ್ ತೆಜೊ ವಾಟೊ ಮನುನ್ ಕಳ್ವುನ್ ಘೆಟ್ಲೊ, ಜಿವನ್ ಸರ್ಲ್ಯಾ ಮಾನಾ ಕಾಯ್ ಚಲ್ತಾ ಮನ್ತಲೆ ಬಗುಕ್ ಮಾನ್ಸಾಕ್ ಪರ್‍ತುನ್ ಹಾನ್ತಲೆ ಕೊನ್?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />ಮಾನಾ ಮಿಯಾ ಬರೆ ಕರುನ್ ಪರ್‍ತುನ್ ಜಗಾತ್ ಹೊತ್ತೊ ತರಾಸ್ ಸಗ್ಳೊ ಬಗಟ್ಲೊ; ಆಹಾ, ತೊ ತರಾಸ್ ಸೊಸುಕ್ ಹೊಯ್ ನಸ್ತಾನಾ ದುಕ್ಕೆತ್ ಹೊತ್ತ್ಯಾ ಲೊಕಾಂಚೊ ಘೊಳ್ ಕಾಯ್ ಸಾಂಗು! ತೆಂಕಾ ಸಮಾಧಾನ್ ಕರ್‍ತಲೆ ಕೊನ್ಬಿ ನತ್ತೆ; ಖರೆ ತರಾಸ್ ದಿತಲ್ಯಾ ಲೊಕಾಂಚೊ ತಾಕತ್ ಲೈ ಹೊತ್ತೊ; ಖರೆ ಸಮಾಧಾನ್ ಕರ್‍ತಲೆ ಕೊನ್ಬಿ ನತ್ತೆ. <verse eid="ECC 4:1" /><verse number="2" style="v" sid="ECC 4:2" />ಹೆ ಸಗ್ಳೆ ಬಗುನ್, ಝಿತ್ತೆ ರ್‍ಹಾತಲ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕಿಂತಾ, ಮರುನ್ ಗೆಲ್ಲ್ಯಾ ಲೊಕಾಂಚೆಚ್ ಬರೆ ಮನುನ್ ಹೊಗ್ಳಾಪ್ ಕರ್ಲೊ; <verse eid="ECC 4:2" /><verse number="3" style="v" sid="ECC 4:3" />ಹೊಯ್, ಹ್ಯಾ ಜಗಾತ್ ಉಪಾಜ್ತಾನಾ ಮರುನ್ ಗೆಲ್ಲ್ಯಾಂಚೆಚ್ ಕವ್ಡೆಕಿ ಬರೆ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಹ್ಯಾ ಜಗಾತ್ ಹೊತಲಿ ಬುರ್ಶಿ ಕಾಮಾ ತೆನಿ ಬಗಿನಸ್ತಾನಾಚ್ ಗೆಲ್ಲೆ ಬರೆ ಮನುನ್ ಕಳ್ವುನ್ ಘೆಟ್ಲೊ. <verse eid="ECC 4:3" /><verse number="4" style="v" sid="ECC 4:4" />ಮಿಯಾ, ಲೊಕಾ ಯೆವ್ಡೆ ಲೈ ತರಾಸ್ ಕರುನ್ ಮೊಟ್ಯಾಪಾನಾ ಸಾಟ್ನಿ ಘೊಳ್ತಾತ್ ಮನುನ್ ಬಗ್ತಾನಾ, ಹೆ ಅಪ್ನಾಚ್ಯಾ ಅಜು ಭಾಜುಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕಿಂತಾ ಸಾವ್ಕಾರ್ ಹೊವ್ಚೆ ಮನುನ್ ತೆನಿ ಘೊಳ್ತಾತ್, ಖರೆ ಹೆ ವ್ಹಾರ್ಯಾಕ್ ಪಾಟ್ ಲಾಗುನ್ ಗೆಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಸಗ್ಳೆ ವ್ಯರ್ಥ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="ECC 4:4" /><verse number="5" style="v" sid="ECC 4:5" />ಉಲ್ಲ್ಯಾ ಲೊಕಾನಿ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆ; ಕಾಯ್ ಬಿ ಕಾಮ್ ಕರಿ ನಸ್ತಾನಾ ಹಾತ್ ಭಾಂದುನ್ ಘೆವ್ನ್ ಬಸುನ್ ರಾತಲೊ ಪಿಸೊ;ಕೊನ್ ತರ್ಬಿ ಎಕ್ಲೊ ಪಿಸೊ ಸಾರ್ಕೊ ಘೊಳಿ ನಸ್ತಾನಾ ಹಾತ್ ಭಾಂದುನ್ ಬಸಲ್ಲೊ ರಾಲ್ಯಾರ್ ತೊ ಅಪ್ನಾಕ್ ಅಪ್ನಿಚ್ ಭುಕೆನ್ ಮಾರುನ್ ಟಾಕ್ತಾ. <verse eid="ECC 4:5" /><verse number="6" style="v" sid="ECC 4:6" />ವ್ಹಾರ್ಯಾಕ್ ಪಾಟ್ ಲಾಗುನ್ ದೊನಿ ಹಾತಿನ್ ಪೊಸೊ ಕರುನ್ ಧರ್ತಲ್ಯಾಕಿಂತಾ ಅಮ್ಚ್ಯಾಕ್ಡೆ ಹೊತ್ತ್ಯಾ ಉಲ್ಲ್ಯಾಸಾತುಚ್ ಖುಶಿನ್ ರ್‍ಹಾತಲೆ ಕವ್ಡೆಕಿ ಬರೆ. <verse eid="ECC 4:6" /><verse number="7" style="v" sid="ECC 4:7" />ಮಿಯಾ ಜಗಾತ್ ಅನಿಬಿ ಎಕ್ ಪಾಯ್ದ್ಯಾಕ್ ಪಡಿನಸಲ್ಲಿ ವಿಶಯ್ ಬಗಟ್ಲೊ. <verse eid="ECC 4:7" /><verse number="8" style="v" sid="ECC 4:8" />ದೊನ್ವೆಚೊ ನಸ್ತಾನಾ ಒಂಡ್ಕೊ ಎಕ್ಲೊ ಹಾಯ್; ತೆಕಾ ಭಾವ್ ಭೆನಿಯಾ ನಾತ್, ಅನಿ ಪೊರಾಬಿ ನಾತ್; ಖರೆ ತೊ ಲೈ ತರಾಸ್ ಕಾಮ್ ಕರ್ತಾ, ಆಸ್ತಿನ್ ತೆಚ್ಯಾ ಡೊಳ್ಯಾಕ್ನಿ ಸಮಾಧಾನ್ ನಾ, ಮಿಯಾ ಸುಖ್ ಸೊಡುನ್ ಕೊನಾ ಸಾಟ್ನಿ ಕಟ್ಪಟ್ ಕರುಲ್ಲಾ ಅನಿ ಮಿಯಾ ಕಶ್ಯಾಕ್ ಖುಶಿ ಕಳ್ದುನ್ ಘೆವ್ಕ್ ಲಾಗ್ಲಾ? ಮನುನ್ಗೆತ್ ಹಾಯ್, ಹೆಬಿ ವ್ಯರ್ಥ್ ಖಾಲಿ ಕಟ್ಪಟ್ ತವ್ಡೆಚ್ ಹೊವ್ಲಾ. <verse eid="ECC 4:8" /><verse number="9" style="v" sid="ECC 4:9" />ಎಕ್ಲ್ಯಾಕಿಂತಾ ದೊನ್ ಲೊಕಾ ರಾಬ್ತಲೆ ಬರೆ, ತೆಚ್ಯಾ ಕಟ್ಪಟಾಕ್ ಬರೊ ಫಾಯ್ದೊ ಹಾಯ್. <verse eid="ECC 4:9" /><verse number="10" style="v" sid="ECC 4:10" />ಎಕ್ಲೊ ಪಡ್ಲ್ಯಾರ್ ತೆಕಾ ಅನಿ ಎಕ್ಲೊ ಉಕಲ್ತಾ; ಖರೆ ತೊ ಪಡಲ್ಲ್ಯಾ ತನ್ನಾ ಎಕ್ಲೊಚ್ ಹೊತ್ತೊ ರಾಲ್ಯಾರ್ ಉಕ್ಲುಕ್ ಕೊನ್ಬಿ ರ್‍ಹಾಯ್ನಾತ್; ಕೊನ್ಬಿ ನಸ್ಲ್ಯಾರ್ ತೆಚಿ ಗತ್ ಕಾಯ್ ಸಾಂಗು. <verse eid="ECC 4:10" /><verse number="11" style="v" sid="ECC 4:11" />ಎಕ್ಲ್ಯಾಚ್ಯಾ ಭಾಜುಕ್ ಅನಿ ಎಕ್ಲೊ ನಿಜ್ಲ್ಯಾರ್ ದೊಗ್ಯಾಕ್ನಿಬಿ ಹುನ್ನ್ ಹೊತಾ, ಎಕ್ಲೊಚ್ ರಾಲ್ಯಾರ್ ಕಸೆ ಹುನ್ನ್ ಹೊತಾ? <verse eid="ECC 4:11" /><verse number="12" style="v" sid="ECC 4:12" />ಎಕ್ ಮಾನ್ಸಾಕ್ ಅನಿ ಎಕ್ ಮಾನ್ಸಾನ್ ಜಿಕುಕ್ ಹೊತಾ, ಖರೆ ಜಿಕಲ್ಲ್ಯಾಕ್ ದೊಗ್ಯಾನಿ ಹಾರ್ವುಕ್ ಹೊತಾ, ತಿನ್ ಎಳ್ಯಾಚಿ ದೊರಿ ತುಟ್ವುತಲಿ ಲೈ ತರಾಸ್. <verse eid="ECC 4:12" /><verse number="13" style="v" sid="ECC 4:13" />ತಸೆ ಹುಶಾರ್ಕಿಚ್ಯಾ ಗೊಸ್ಟಿಯಾಕ್ನಿ ಕಾನ್ ದಿನಸಲ್ಯಾ ಪಿಶ್ಯಾ ಮ್ಹಾತಾರ್ಯಾ ರಾಜಾಕಿಂತಾ, ಶಾನೊ ಗರಿಬ್ ದಾಂಡ್ಗೊ ಮಾನುಸುಚ್ ಬರೊ. <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />ಅಸ್ಲ್ಯಾ ಎಕ್ ದಾಂಡ್ಗ್ಯಾ ಮಾನ್ಸಾಕ್ ರಾಜಾ ಹೊವ್ಕ್ ಬಂಧಿಖಾನ್ಯಾತ್ನಾ ಹಾನುನ್ ಹೊಲೆ, ತೊ ಅಪ್ನಾಚ್ಯಾ ರಾಜ್ವಾಡ್ಯಾತ್ ಗರಿಬ್ ಮಾನುಸ್ ಹೊವ್ನ್ ಉಪಜ್ಲೊ. <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />ಜಗಾತ್ ಫಿರುನ್ ಚಲ್ತಲಿ ಮಾನ್ಸಾ ರಾಜಾಚ್ಯಾ ಮಾನಾಚೊ ಅಧಿಕಾರ್ ಘೆಟಲ್ಲ್ಯಾ ದಾಂಡ್ಗ್ಯಾ ಮಾನ್ಸಾಚ್ಯಾ ಪಕ್ಷಾಕ್ ಯೆತಲೆ ಬಗಟ್ಲೊ. <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />ಲೈ ಲೊಕಾ ತ್ಯಾ ದಾಂಡ್ಗ್ಯಾ ಮಾನ್ಸಾಕ್ ಉಮ್ಮೆದ್ ಭರ್ತಾತ್, ಖರೆ ತೆಜ್ಯಾ ಆಕ್ರಿಚ್ಯಾ ರಾಜ್ವಟ್ಕಿಚ್ಯಾ ಎಳಾರ್ ಕೊನ್ಬಿ ತೆಜ್ಯಾ ವಿಶಯಾತ್ ಖುಶಿ ಹೊವ್ಕ್ ನಾತ್, ಹೆಬಿ ವ್ಹಾರ್ಯಾಕ್ ಪಾಟ್ ಲಾಗುನ್ ಜಾತಲ್ಯಾ ಸಾರ್ಕೆ ಸಗ್ಳೆ ವ್ಯರ್ಥ್ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s">ಗಡ್ಬಡ್ ಕರುನ್ ಆನ್ ಘಾಲುನಕಾಸಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />ದೆವಾಚ್ಯಾ ಗುಡಿತ್ ಜಾತಾನಾ, ಮ್ಹಾಗಾ ವರ್‍ತಿ ಧ್ಯಾನ್ ದಿ, ಪಿಶ್ಯಾಚ್ಯಾ ಬಲಿಕಿಂತಾ ದೆವಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆವ್ನ್ ಕಾನ್ ದಿತಲೆ ಕವ್ಡೆಕಿ ಬರೆ, ಪಿಶ್ಯಾಕ್ನಿ ಅಪ್ನಿ ಕರುಕ್ ಲಾಗಲ್ಲೆ ಪ್ರಾಮಾನಿಕ್ ನ್ಹಯ್ ಮನುನ್ ಗೊತ್ತ್ ನಾ. <verse eid="ECC 5:1" /><verse number="2" style="v" sid="ECC 5:2" />ತಿಯಾ ಬೊಲುಚ್ಯಾ ಪಯ್ಲಿ ಯೆವ್ಜುನ್ ಬೊಲ್ ಅನಿ ದೆವಾಕ್ನಾ ಕಸ್ಲೊಬಿ ಆನ್ ಘಾಲುನಕ್ಕೊ, ತೊ ಸೊರ್ಗಾ ವರ್‍ತಿ ಹಾಯ್, ಅನಿ ತಿಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಹಾಸ್, ತಸೆ ಹೊವ್ನ್, ತುಕಾ ಹೊತ್ತ್ಯಾಚ್ಯಾ ವಿಶಯಾತ್ ಲೈ ಕಾಯ್ಬಿ ಸಾಂಗುಕ್ ಜಾವ್ ನಕ್ಕೊ. <verse eid="ECC 5:2" /><verse number="3" style="v" sid="ECC 5:3" />ತುಮಿ ಲೈ ಚಿಂತಲ್ಯಾ ವಯ್ನಾ ಬುರ್ಶಿ ಸಪ್ನಾ ಬಗುಕ್ ಹೊತಾ, ತುಮಿ ಲೈ ಬೊಲ್ತಲ್ಯಾ ವಯ್ನಾ ಪಿಶೆ ಮನುನ್ ದಿಸುನ್ ಯೆತಾ. <verse eid="ECC 5:3" /><verse number="4" style="v" sid="ECC 5:4" />ತಿಯಾ ದೆವಾಕ್ಡೆ ಆನ್ ಘಾಲುನ್ ಮಾಗುನ್ ಘೆಟಲ್ಲೆ ರಾಲ್ಯಾರ್ ತೆ ಲಗ್ಗುನಾ ಪಾವತ್ ಕರ್, ತೊ ಪಿಶ್ಯಾಕ್ನಿ ದೆವಾಕ್ಡೆ ಖುಸಿ ಗಾಯ್ನಾ, ತುಜಿ ಆನ್ ಘಾಲುನ್ ಕರಲ್ಲಿ ಮಾಗ್ನಿ ಲಗ್ಗುನಾ ಪಾವತ್ ಕರ್. <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />ತಿಯಾ ಮಾಗುನ್ ಘೆವ್ನ್ ಪಾವತ್ ಕರಿನಸ್ತಾನಾ ರ್‍ಹಾತಲ್ಯಾಚ್ಯಾಕ್ನಿ, ಆನ್ ಘಾಲುನ್ ಮಾಗಿನಸ್ತಾನಾ ರ್‍ಹಾತಲೆಚ್ ಬರೆ. <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />ತೆಜ್ಯಾ ತೊಂಡಾನ್ ತುಕಾ ಪಾಪಾತ್ ಗುರಿ ಕರಿನಾ ಸಾರ್ಕೆ ಬಗುನ್ ಘೆ, ಹೆ ಧ್ಯಾನ್ ದಿನಸ್ತಾನಾ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ಹೊಲೆ ಮನುನ್ ದೆವಾಚ್ಯಾ ಯಾಜಕಾಚ್ಯಾ ಫಿಡ್ಯಾತ್ ಸಾಂಗುನಕ್ಕೊ, ಕಶ್ಯಾಕ್ ದೆವ್ ತುಜ್ಯಾ ವರ್‍ತಿ ರಾಗ್ ಹೊಯ್ನಾ ಸಾರ್ಕೆ ಕರ್ತೆ? ಕಶ್ಯಾಕ್ ತೊ ತುಜ್ಯಾ ಹಾತಿಚ್ಯಾ ಕಾಮಾಕ್ನಿ ನಾಸ್ ಕರಿ ಸಾರ್ಕೆ ಕರ್ತೆ? <verse eid="ECC 5:6" /><verse number="7" style="v" sid="ECC 5:7" />ಲೈ ಸಪ್ನಾನಿ ಅನಿ ನಕ್ಕೊ ಹೊಲ್ಲ್ಯಾ ವಿಶಯಾನಿ ಲೈ ಗೊಸ್ಟಿಯಾ ಯೆತಾತ್, ತಿಯಾ ದೆವಾಚ್ಯಾ ಇದ್ರಾಕ್ ದೆವಸ್ಪಾನಾನ್ ರಾ.<verse eid="ECC 5:7" /></para>
  <para style="s">ಜಿವನ್ ವ್ಯರ್ಥ್</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />ಸಂಸ್ಥಾನಾತ್ ಗರಿಬಾಕ್ನಿ ಹೊತಲೆ ತರಾಸ್ ಅನಿ ನಿತಿಚ್ಯಾ ಝಡ್ತಿಚೆ ನಾಶ್ ಯೆತಲೆ ತಿಯಾ ಬಗಟ್ಲ್ಯಾರ್ ಅಜಾಪ್ ಹೊವ್ ನಕ್ಕೊ, ಸಗ್ಳ್ಯಾಕಿಂತಾ ವರ್‍ತಿ ಬಸಲ್ಲೊ ತೆ ಸಗ್ಳೆ ಲಕ್ಷಾತ್ ಹಾನ್ತಾ, ಎಕ್ ಅಧಿಕಾರ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಅನಿ ಎಕ್ಲೊ ರ್‍ಹಾತಾ, ತೊ ತೆಂಚ್ಯಾ ದೊಗ್ಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಜಾಸ್ತಿಚೊ ಅಧಿಕಾರ್ ಹೊತ್ತೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="ECC 5:8" /><verse number="9" style="v" sid="ECC 5:9" />ಜಿಮ್ನಿಕ್ನಾ ಸಗ್ಳ್ಯಾಕ್ನಿಬಿ ಫಾಯ್ದೊ ಹಾಯ್, ಸೆತ್ಯಾಚ್ಯಾ ವಯ್ನಾ ರಾಜಾಕ್ನಿಬಿ ಫಾಯ್ದೊ ಹೊತಾ. <verse eid="ECC 5:9" /><verse number="10" style="v" sid="ECC 5:10" />ತಿಯಾ ಎಕ್ ಯೆಳಾ ಪಯ್ಶ್ಯಾಚಿ ಆಶ್ಯಾ ಕರ್ತಲೊ ರಾಲ್ಯಾರ್, ತುಕಾ ಪಯ್ಶ್ಯಾನ್ ಸಮಾಧಾನ್ ಹೊಯ್ನಾ, ತಿಯಾ ಲೈ ಬಿ ಸಾವ್ಕರ್ ಹೊವ್ಚೆ ಮನುನ್ ಆಶ್ಯಾ ಕರಲ್ಲೆ ರಾಲ್ಯಾರ್, ತುಕಾ ಪಾಜೆ ಹೊಲ್ಲೆ ಗಾಯ್ಚ್ ನಾ, ಹೆ ಸಗ್ಳೆಬಿ ವ್ಯರ್ಥ್. <verse eid="ECC 5:10" /><verse number="11" style="v" sid="ECC 5:11" />ಆಸ್ತಿ ಲೈ ಹೊಲ್ಲೆ ರಾಲ್ಯಾರ್ ವಾಪರ್ತಲ್ಯಾಂಚೊ ಅಂಕೊ ಬಿ ಲೈ ಹೊತಾ, ತೆ ಡೊಳ್ಯಾನ್ ಬಗುಚೆ ತವ್ಡೆಚ್, ಖರೆ ಯೆಜ್ಮಾನಾಕ್ ಕಾಯ್ಬಿ ಫಾಯ್ದೊ ನಾ. <verse eid="ECC 5:11" /><verse number="12" style="v" sid="ECC 5:12" />ರಾಬ್ತಲೊ ಮಾನುಸ್ ಲೈ ಜೆವ್ಲ್ಯಾರ್ಬಿ ಉಲ್ಲೆಸೆ ಜೆವ್ಲ್ಯಾರ್ಬಿ ಆರಾಮಾನ್ ನಿಜ್ತಾ, ಖರೆ ಸಾವ್ಕಾರಾಚಿ ಆಸ್ತಿ ತೆಕಾ ನಿಜ್ ಯೆವ್ಕ್ ದಿನಾ. <verse eid="ECC 5:12" /><verse number="13" style="v" sid="ECC 5:13" />ಹ್ಯಾ ಜಗಾತ್ ಬರೆ ಬುರ್ಸೆಪಾನುಚ್ ಬಗ್ಲೊ, ಲೈ ಆಸ್ತಿ ಹೊತ್ತೊ ಅಪ್ನಾಚಿ ಆಸ್ತಿ ರಾಕುನ್ ಘೆತಲ್ಯಾ ವಿಶಯಾಚ್ ಚಿಂತಾ ಕರ್ತಾ. <verse eid="ECC 5:13" /><verse number="14" style="v" sid="ECC 5:14" />ತಿ ಆಸ್ತಿ ಉಪ್ಪೆಗ್ ನಸಲ್ಲ್ಯಾ ಕಟ್ಪಟಾ ವಯ್ನಾ ಹಾಳ್ ಹೊತಾ, ತೆಕಾ ಲೆಕ್ ಹೊತ್ತೊ ಹೊಲ್ಯಾರ್, ತ್ಯಾ ಲೆಕಾ ಸಾಟ್ನಿ ಕಾಯ್ಬಿ ಹುರಿನಾ. <verse eid="ECC 5:14" /><verse number="15" style="v" sid="ECC 5:15" />ಆವ್ಸಿಚ್ಯಾ ಪೊಟಾತ್ನಾ ಕಸೊ ಯೆಲೊ, ತಸೊಚ್ ಕಾಯ್ಬಿ ನಸ್ತಾನಾ ಜಾತಾ, ಅಪ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಕಟ್ಪಟಾಕ್ ಹಾತಿತ್ ಕಾಯ್ಬಿ ಘೆವ್ನ್ ಜಾಯ್ನಾ. <verse eid="ECC 5:15" /><verse number="16" style="v" sid="ECC 5:16" />ಯೆಲ್ಲೊ ಸಾರ್ಕೊಚ್, ನಾ ಹೊವ್ನ್ ಜಾತಾ, ವ್ಹಾರ್ಯಾಕ್ ಧರುಕ್ ಸಾಟ್ನಿ ಕಟ್ಪಟ್ ಕರಲ್ಲ್ಯಾ ವಯ್ನಾ ತೆಕಾ ಕಾಯ್ ಫಾಯ್ದೊ ಹೊಲೊ? ಹೆ ಸಗ್ಳೆ ವ್ಯರ್ಥ್. <verse eid="ECC 5:16" /><verse number="17" style="v" sid="ECC 5:17" />ತೆಜ್ಯಾ ಸಗ್ಳ್ಯಾ ಜಿವ್ ಮಾನಾತ್ ಕಾಳೊಕ್ ಭರುನ್ ರ್‍ಹಾತಾ, ತೆಕಾ ದುಕ್ಕ್, ಚಿಂತಾ, ದುಕ್ನಿಯಾ ಅನಿ ಲೈ ರಾಗ್, ತೆಜ್ಯಾ ವಾಂಗ್ಡಾಚ್ ಹಾತ್. <verse eid="ECC 5:17" /><verse number="18" style="v" sid="ECC 5:18" />ಅಬಕ್, ಮಿಯಾ ಬಗಲ್ಲೆ ಹೆಚ್, ದೆವಾನ್ ಎಕ್ಲ್ಯಾಕ್ ದಿಲ್ಲ್ಯಾ ಜಿವಮಾನಾಚ್ಯಾ ದಿಸಾತ್ನಿ ತೊ ಜೆವಾನ್ ಖಾನ್ ಘೆವ್ನ್, ಅಪ್ಲ್ಯಾ ಹ್ಯಾ ಜಗಾತ್ ಕರ್‍ತಲ್ಯಾ ಕಟ್ಪಟಾಕ್ನಿ ಸುಖಾನ್ ಜಿವನ್ ಕರ್‍ತಲೆ ಬರೆ, ಅನಿ ಫುಕೊಟ್ಚೆ ದೆನೆ ಹೊವ್ನ್ ಹಾಯ್, ಹೊಚ್ ಮಾನ್ಸಾಚೊ ವಾಟೊ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />ಅನಿ ತೆನಿ ಕೊನಾಕ್ ಆಸ್ತಿ ದಿವ್ನ್ ತೆ ಅನ್ಬೊಗ್ ಕರುನ್ ಅಪ್ನಾಚ್ಯಾ ವಾಟ್ಯಾಕ್ ಯೆಲ್ಲೆ ಘೆವ್ನ್, ಕಟ್ಪಟಾಕ್ನಿ ಖುಶಿ ಹೊವ್ನ್ ರಾವ್ಕ್ ಬಳ್ ದಿಲಾ, ತೆ ದೆವಾಕ್ನಾ ಯೆಲ್ಲೆಚ್ ದೆನೆ. <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />ಅಸ್ಲೊ ಮಾನುಸ್ ಅಪ್ನಾಚ್ಯಾ ಜಿವನಾಚಿ ದಿಸಾ ಯಾದೆಕ್ ಹಾನಿನಾ, ಹೊ ಅಪ್ನಾಚ್ಯಾ ಮನಾಚ್ಯಾ ಖುಶಿತ್ ಬುಡುನ್ ರಾಯ್ ಸಾರ್ಕೆ ದೆವಾನ್ ಕರ್ಲಾ.<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />ಜಗಾತ್ ಮಾನ್ಸಾಕ್ನಿ ಲೈ ಕರುನ್ ಹೊಲ್ಲೊ ತರಾಸ್ ಬಗಟ್ಲೊ. <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />ತೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ದೆವಾನ್ ಎಕ್ಲ್ಯಾಕ್ ಕಸ್ಲಿಬಿ ಕಮ್ಮಿ ನಸ್ತಾನಾ, ಪಯ್ಸೆ ಅನಿ ಆಸ್ತಿ ದಿಲ್ಯಾನ್, ಖರೆ ತೆ ವಾಪ್ರುಕ್ ತೆಕಾ ದೆವಾನ್ ಬಳ್ ದಿವ್ಕ್ ನಾ, ತೆ ಅನಿ ಎಕ್ಲೊ ಅನುಬೊಗ್ ಕರ್ತಾ, ಹೆಬಿ ವ್ಯರ್ಥ್ ಅನಿ ಮೊಟೆ ದುಕ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="ECC 6:2" /><verse number="3" style="v" sid="ECC 6:3" />ಸೆಂಬರ್ ಘಟ್ಲಿ ಪೊರಾ ಹೊವ್ನ್ ಲೈ ವರಿಸ್ ಝಿತ್ತೊ ರಾವ್ನ್ ಸುಖ್ ಸಮಾಧಾನ್ ರಾವ್ನ್ ಅನಿ ಮರ್ನಾಚ್ಯಾ ಮಾನಾ ಮಾಟಿ ಹೊಯ್ ನಸ್ತಾನಾ ರಾಲ್ಯಾರ್, ತ್ಯಾ ಮಾನ್ಸಾಕಿಂತಾ ಉಪ್ಜುಚ್ಯಾ ಅದ್ದಿ ಪೊಟಾತ್ ಪೊರ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ತನ್ನಾ ಮರಲ್ಲೆಚ್ ಕವ್ಡೆಕಿ ಬರೊ ಮನುನ್ ಚಿಂತ್ಲೊ. <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />ತೆ ವ್ಯರ್ಥ್ ಅನಿ ಕಾಳ್ಕಾತ್ ಜಾತಾ, ದಾಟ್ಲೊ ಕಾಳೊಕ್ ತೆಜ್ಯಾ ನಾವಾ ವರ್‍ತಿ ಧಾಪಲ್ಲೊ ರ್‍ಹಾತಾ. <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />ತೆನಿ ದಿಸಾಕ್ ಬಗುಕ್ ನಾತ್, ತೆಕಾ ಬುದ್ದುಚ್ ನಾ, ಖರೆ ತೆಜ್ಯಾಕಿಂತಾ ತೆಕಾ ಶಾಂತ್ಪಾನುಚ್ ಜಾಸ್ತಿಚೆ. <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />ದೊನ್ ಹಾಜಾರ್ ವರಿಸ್ ಝಿತ್ತೊ ರಾರ್ಲ್ಯಾಬಿ ಸುಖ್ ನಸ್ಲ್ಯಾರ್ ಕಾಯ್ ಫಾಯ್ದೊ? ಹೆ ಸಗ್ಳೆಬಿ ಎಕುಚ್ ಜಾಗ್ಯಾರ್ ಜಾತಾತ್ ನ್ಹಯ್. <verse eid="ECC 6:6" /><verse number="7" style="v" sid="ECC 6:7" />ಮಾನುಸ್ ಕರ್‍ತಲೆ ಸಗ್ಳೆ ಕಟ್ಪಟ್ ಅಪ್ನಾಚ್ಯಾ ಪೊಟಾ ಸಾಟ್ನಿಚ್, ಖರೆ ತೆಕಾ ತ್ರಪ್ತಿ ಹೊಯ್ನಾ. <verse eid="ECC 6:7" /><verse number="8" style="v" sid="ECC 6:8" />ಬುದ್ಗೆಡಿಚ್ಯಾನ್ಕಿ ಬುದ್ವಂತಾಕ್ ಕಾಯ್ ಫಾಯ್ದೊ? ಅಪ್ನಿ ಕಸೆ ಚಲುಚೆ ಮನುನ್ ಗೊತ್ತ್ ಹೊತ್ತ್ಯಾಕ್ ಗರಿಬಾಚ್ಯಾ ವಯ್ನಾ ಕಾಯ್ ಫಾಯ್ದೊ? <verse eid="ECC 6:8" /><verse number="9" style="v" sid="ECC 6:9" />ಪಾಯ್ದ್ಯಾಕ್ ನಸಲ್ಲ್ಯಾಚಿ ಆಶ್ಯಾ ಕರ್ತಲ್ಲ್ಯಾಕಿಂತಾ, ಡೊಳ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ಹೊತ್ತ್ಯಾಕ್ ಅನ್ಬೊಗ್ ಕರ್‍ತಲೆಚ್ ಬರೆ, ಹೆಬಿ ವ್ಹಾರ್ಯಾಕ್ ಫಾಟ್ ಲಾಗುನ್ ಗೆಲ್ಯಾ ಸಾರ್ಕೆ ವ್ಯರ್ಥುಚ್. <verse eid="ECC 6:9" /><verse number="10" style="v" sid="ECC 6:10" />ಮಾನುಸ್ ಕಸ್ಲೊ ಹೊಲ್ಯಾರ್ಬಿ ತೆಕಾ ಅದ್ದಿ ದಿವ್ನ್ ಹೊಲ್ಲ್ಯಾ ನಾವಾ ವಯ್ನಾ ಮಾಟಿಚೊಚ್ ಮನುನ್ ಗೊತ್ತ್ ಹೊಲಾ, ತೊ ಅಪ್ನಾಕಿಂತಾ ಬಳ್ ಹೊತ್ತ್ಯಾ ವಾಂಗ್ಡಾ ವಾದ್ ಕರುಕ್ ಹೊಯ್ನಾ. <verse eid="ECC 6:10" /><verse number="11" style="v" sid="ECC 6:11" />ಪಾಯ್ದ್ಯಾಕ್ ಪಡಿನಸಲ್ಲಿ ಗೊಸ್ಟಿಯಾ ಲೈ ಹಾತ್, ತೆಜ್ಯಾ ವಯ್ನಾ ಮಾನ್ಸಾಕ್ ಕಾಯ್ ಫಾಯ್ದೊ? <verse eid="ECC 6:11" /><verse number="12" style="v" sid="ECC 6:12" />ಸಾವ್ಳಿ ಸಾರ್ಕೆ ಫಾಯ್ದ್ಯಾಕ್ ನಸ್ತಾನಾ ಕಳ್ದುನ್ ಜಾತಲ್ಯಾ ಮಾನ್ಸಾಚ್ಯಾ ಜಿವ್ಮಾನಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ದಿಸಾತ್ನಿ ತೆಕಾ ಖಲೆ ಬರೆ ಮನುನ್ ಕೊನಾಕ್ ಗೊತ್ತ್? ಅಪ್ನಿ ಮರ್ಲ್ಯಾ ಮಾನಾ ಹ್ಯಾ ಜಗಾತ್ ಕಾಯ್ ಹೊತಾ ಮನುನ್ ಕೊನಾಕ್ನಾ ಕಳ್ವುನ್ ಘೆತಾ?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s">ಜಿವನಾಚ್ಯಾ ವಿಶಯಾತ್ ಯೆವ್ಜನಿಯಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 7:1" />ಬರ್ಯಾ ವಾಸೆಚ್ಯಾ ತೆಲಾಕಿಂತಾ ಬರೆ ನಾವ್ ಘೆತಲೆ ಕವ್ಡೆಕಿ ಬರೆ, ಅನಿ ತಿಯಾ ಉಪಾಜ್ತಲ್ಯಾ ದಿಸಾಕಿಂತಾ ಮರ್ನಾಚೊ ದಿಸ್ ಕವ್ಡೊಕಿ ಬರೊ. <verse eid="ECC 7:1" /><verse number="2" style="v" sid="ECC 7:2" />ಅನಿ ಖುಶಿಚೆ ಜೆವಾನ್ ಹೊತ್ತ್ಯಾ ಘರಾಕ್ ಜಾತಲ್ಯಾಕಿಂತಾ ಅಳಾಪ್ ಹೊತ್ತ್ಯಾ ಘರಾಕ್ ಜಾತಲೆ ಕವ್ಡೆಕಿ ಬರೆ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಝಿತ್ತೊ ಹೊತ್ತ್ಯಾ ಹರ್ ಎಕ್ಲ್ಯಾಕ್ ಸಗ್ಳ್ಯಾ ಮಾನ್ಸಾಕ್ನಿಬಿ ಆಕ್ರಿಕ್ ಮರಾನುಚ್ ಗತ್ ಮನ್ತಲೆ ಯಾದ್ ಕರುನ್ ಘೆವ್ಚೆ. <verse eid="ECC 7:2" /><verse number="3" style="v" sid="ECC 7:3" />ಹಾಸ್ತಲ್ಯಾಕಿಂತಾ ಬೆಜಾರಾನ್ ರ್‍ಹಾತಲೆಚ್ ಬರೆ; ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೊಂಡ್ ಬೆಜಾರಾತ್ ರ್‍ಹಾತಲೆ ಮನಾಕ್ ಬರೆ. <verse eid="ECC 7:3" /><verse number="4" style="v" sid="ECC 7:4" />ಕೊನ್ ತರ್ಬಿ ಎಕ್ಲೊ ಕನ್ನಾಬಿ ಖುಶಿಚ್ಯಾ ವಿಶಯಾತ್ ಚಿಂತುನ್ಗೆತ್ ರಾಲ್ಯಾರ್ ತೊ ಪಿಸೊ, ಅನಿ ಶಾನೊ ಮಾನುಸ್ ಮರ್ನಾಚ್ಯಾ ವಿಶಯಾತ್ ಚಿಂತುನ್ಗೆತ್ ರ್‍ಹಾತಾ. <verse eid="ECC 7:4" /><verse number="5" style="v" sid="ECC 7:5" />ಪಿಶ್ಯಾ ಮಾನ್ಸಾಚಿ ಗಿತ್ ಆಯಿಕ್ತಲ್ಯಾಕಿಂತಾ, ಶಾನ್ಯಾ ಮಾನ್ಸಾನ್ ಝೊರ್ ಕರ್‍ತಲೆ ಆಯಿಕ್ತಲೆ ಲೈ ಬರೆ. <verse eid="ECC 7:5" /><verse number="6" style="v" sid="ECC 7:6" />ಅನಿ ಪಿಶ್ಯಾಚೊ ಹಾಸೊ ಢೆರ್ಯಾಚ್ಯಾ ಬುಡಿ ಆಗಿತ್ ಮಿಳ್ವಲ್ಲ್ಯಾ ಚಿರ್ಪುಟಾಂಚ್ಯಾ ಕಾಟ್ಯಾಂಚ್ಯಾ ಆವಾಜಾ ಸಾರ್ಕೊ ಹಾಯ್, ಹೆ ಬಿ ವ್ಯರ್ಥುಚ್. <verse eid="ECC 7:6" /><verse number="7" style="v" sid="ECC 7:7" />ತಿಯಾ ಶಾನೊ ಹೊವ್ಕ್ ಫಿರೆ, ಖರೆ ಕೊನಾಕ್ ತರ್ಬಿ ಪಶ್ವಲ್ಲೊ ಹೊಲ್ಯಾರ್, ತಿಯಾ ಪಿಸೊ ಸಾರ್ಕೊ ನಾಟಕ್ ಕರುಲ್ಲೆ, ತಿಯಾ ಲಂಚ್ ಘೆಟಲ್ಲೊ ಹೊಲ್ಯಾರ್ ತೆಜ್ಯಾ ವಯ್ನಾ ತುಜಿ ಚಾಲ್ ನಾಶ್ ಹೊತಾ. <verse eid="ECC 7:7" /><verse number="8" style="v" sid="ECC 7:8" />ಹರ್ ಎಕಾಚಿ ಆಕ್ರಿ ಆರಂಬಾಕಿಂತಾ ಬರಿ ರ್‍ಹಾತಾ, ಗದ್ದಲ್ ರ್‍ಹಾತಲ್ಯಾಚ್ಯಾಕ್ನಿ ಶಾಂತ್ಪಾನಾನ್ ರ್‍ಹಾತಲೆಚ್ ಬರೆ.<verse eid="ECC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 7:9" />ರಾಗಾಕ್ ತುಜ್ಯಾ ತಾಬೆತ್ ಥವ್ನ್ ಘೆ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ರಾಗ್ ಪಿಶ್ಯಾಚ್ಯಾ ಮನಾತ್ ವಸ್ತಿ ರ್‍ಹಾತಾ.<verse eid="ECC 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ECC 7:10" />ಅತ್ತ್ಯಾಚ್ಯಾಕಿಂತಾ, ಜುನ್ನಿ ದಿಸಾ ಬರಿ ಹೊತ್ತಿ ನ್ಹಯ್ ಕಶ್ಯಾಕ್? ಮನು ನಕಾಸಿ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತುಮಿ ಹೆ ಶಾನೆಪಾನಾನ್ ಇಚಾರಿನಾ ಹೊಲ್ಯಾಸಿ.<verse eid="ECC 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 7:11" />ಶಾನೆಪಾನ್ ಆಸ್ತಿ ಸಾರ್ಕೆ ಫಾಯ್ದ್ಯಾಚೆ ಹೊವ್ನ್ ಹಾಯ್; ಹೊಯ್, ಶಾನೊ ಮಾನುಸ್ ಅಪ್ನಾಚಿ ಆಸ್ತಿ ಸರಳ್ ರಿತಿನ್ ಖಮ್ವುನ್ ಘೆತಾ. <verse eid="ECC 7:11" /><verse number="12" style="v" sid="ECC 7:12" />ಪಯ್ಸೆ ತುಕಾ ರಾಕ್ವನ್ ದಿತಾ, ಶಾನೆಪಾನ್ ತುಕಾ ಬರ್ಯಾನ್ ಥವ್ತಾ, ಹೆ ಸಗ್ಳೆ ಬುದ್ದಿಚೆ ವಾಪ್ರುಪ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="ECC 7:12" /><verse number="13" style="v" sid="ECC 7:13" />ಖರೆ ದೆವಾಚಿ ಸಗ್ಳಿ ಕಾಮಾ ಚಿಂತುನ್ ಬಗ್; ತೆನಿ ವ್ಹಾಂಕ್ಡೆ ಕರಲ್ಲೆ ಕೊನ್ ತರ್ಬಿ ಎಕ್ಲ್ಯಾನ್ ಕಸೆ ನಿಟ್ಟ್ ಕರುಕ್ ಹೊತಾ? <verse eid="ECC 7:13" /><verse number="14" style="v" sid="ECC 7:14" />ತುಜ್ಯಾ ಸಾಟ್ನಿ ಬರಿ ದಿಸಾ ಯೆವ್ನ್ಗೆತ್ ರ್‍ಹಾತಾನಾ ಖುಸಿನ್ ರಾ; ಅನಿ ತರಾಸಾ ಯೆತಾನಾ ಖುಸಿ ಅನಿ ದುಕ್ಕ್ ದೊನಿಬಿ ಧಾಡಲ್ಲೆ ದೆವಾನುಚ್ ಮನುನ್ ಉಲ್ಲೆ ಚಿಂತುನ್ ಬಗ್, ಫಿಡೆ ಕಾಯ್ ಹೊತಲೆ ಹಾಯ್ ಮನ್ತಲೆ ತುಜೆನ್ ಕನ್ನಾ ಬಿ ಕಳ್ವುನ್ ಘೆವ್ಕ್ ಹೊಯ್ನಾ.<verse eid="ECC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15" />ಹೆ ಸಗ್ಳೆ ಮಿಯಾ ಮಾಜ್ಯಾ ವ್ಯರ್ಥ್ ಜಿವನಾತ್ ಬಗಟ್ಲಾ, ಪ್ರಾಮಾನಿಕ್ ಮಾನುಸ್ ಅಪ್ನಾಚ್ಯಾ ಪ್ರಾಮಾನಿಕ್ ಪಾನಾತ್ ನಾಶ್ ಹೊವ್ನ್ ಜಾತಾ, ಅನಿ ಬುರ್ಸೊ ಮಾನುಸ್ ಅಪ್ನಾಚ್ಯಾ ಬುರ್ಸೆಪಾನಾತುಚ್ ಲೈ ದಿಸಾ ಪತರ್ ಝಿತ್ತೊ ರ್‍ಹಾತಾ. <verse eid="ECC 7:15" /><verse number="16" style="v" sid="ECC 7:16" />ಬಗ್ ಲೈ ಪ್ರಾಮಾನಿಕ್ ಹೊವ್ಕ್ ಬಿ ಜಾವ್ ನಕ್ಕೊ, ಅನಿ ಲೈ ಶಾನೊ ಹೊವ್ ನಕ್ಕೊ, ಹೆಜ್ಯಾ ವಯ್ನಾ ತುಕಾಚ್ ತಿಯಾ ಕಶ್ಯಾಕ್ ನಾಶ್ ಕರುನ್ ಘೆತೆಯ್? <verse eid="ECC 7:16" /><verse number="17" style="v" sid="ECC 7:17" />ಖರೆ ಲೈ ಕಮ್ಮಿಚೊ ಅನಿ ಲೈ ಪಿಶೊಬಿ ಹೊವ್ನ್ ನಕ್ಕೊ, ಎಳ್ ಭರುಚ್ಯಾ ಅದ್ದಿಚ್ ಕಶ್ಯಾಕ್ ಮರುನ್ ಜಾತೆ? <verse eid="ECC 7:17" /><verse number="18" style="v" sid="ECC 7:18" />ತಿಯಾ ಹೆ ದೊನಿಬಿ ಸೊಡುನ್ ದಿ, ತಿಯಾ ದೆವಾಕ್ನಾ ಭಿಂಯಾನ್ ಹೊತ್ತೊ ಹೊಲ್ಯಾರ್ ಸಗ್ಳ್ಯಾ ಎಳಾರ್ಬಿ ಪಾರ್ ಹೊವ್ನ್ ಜಾತೆ. <verse eid="ECC 7:18" /><verse number="19" style="v" sid="ECC 7:19" />ಶಾನ್ಯಾ ಮಾನ್ಸಾಕ್ ಶಾನೆಪಾನ್ ಶಾರ್‍ಹಾತ್ಲ್ಯಾ ಧಾ ಬುದ್ವಂತಾಚ್ಯಾಕ್ನಿ ಬಲಿಸ್ಟ್ ಕರ್ತಾ. <verse eid="ECC 7:19" /><verse number="20" style="v" sid="ECC 7:20" />ಕನ್ನಾಬಿ ಪಾಪ್ ಕರಿ ನಸ್ತಾನಾ ಬರೆ ಥವ್ಡೆಚ್ ಕರುಕ್ ಹೊತಲೊ ಮಾನುಸ್ ಹ್ಯಾ ಜಗಾತ್ ಕೊನುಚ್ ನಾ. <verse eid="ECC 7:20" /><verse number="21" style="v" sid="ECC 7:21" />ತಿಯಾ ಲೊಕಾಚ್ಯಾ ಬೊಲ್ನ್ಯಾ ವರ್‍ತಿ ಧ್ಯಾನ್ ದಿವ್ ನಕ್ಕೊ; ತೆಚೆ ವಯ್ನಾ ತುಜ್ಯಾ ಸೆವಕಾನ್ ತುಕಾ ಶರಾಪ್ ಘಾಟಲ್ಲೆ ಆಯಿಕ್ಸಿಲ್. <verse eid="ECC 7:21" /><verse number="22" style="v" sid="ECC 7:22" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತಿಯಾ ಲೈದಾ ದುಶ್ರ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವಿಶಯಾತ್ ಬೊಲಲ್ಲೆ ತುಕಾಚ್ ಗೊತ್ತ್ ಹಾಯ್. <verse eid="ECC 7:22" /><verse number="23" style="v" sid="ECC 7:23" />ಮಿಯಾ ಹೆ ಸಗ್ಳೆ ಪರಿಕ್ಷಾ ಕರುನ್ ಬಗುಕ್ ಸಾಟ್ನಿ ಮಾಜಿ ಬುದ್ದ್ ವಾಪರ್ಲೊ ಮಿಯಾ ಲೈ ಶಾನೊ ಹೊವ್ಕ್ ಬಗ್ಲೊ, ಖರೆ ತೆ ಮಾಜ್ಯಾಕ್ನಾ ಲೈ ಧುರ್ ಗೆಲೊ. <verse eid="ECC 7:23" /><verse number="24" style="v" sid="ECC 7:24" />ಕೊನ್ ತರ್ ಎಕ್ಲ್ಯಾನ್ ಜಿವನಾಚೊ ಅರ್ಥ್ ಕಾಯ್ ಮನುನ್ ಕಸೆ ಹುಡ್ಕುಕ್ ಹೊತಾ? ಹೆ ಅಮ್ಕಾ ಲೈ ಖೊಲಾತ್ಲೆ ಹೊವ್ನ್ ಹಾಯ್, ಹೆ ಅರ್ಥ್ ಕರುನ್ ಘೆವ್ಕ್ ಲೈ ಘಟ್ ಹಾಯ್. <verse eid="ECC 7:24" /><verse number="25" style="v" sid="ECC 7:25" />ಖರೆ ಮಿಯಾ ಮಾಜ್ಯಾ ತವ್ಡ್ಯಾಕುಚ್ ಧ್ಯಾನ್ ಕರುನ್ ಬುದ್ದಿನ್ ಅದ್ಯಾಯನ್ ಕರ್ಲೊ, ಅನಿ ಮಿಯಾ ಬುದ್ದ್ ಅನಿ ಮಾಜ್ಯಾ ಪ್ರಶ್ನ್ಯಾಕ್ನಿ ಜವಾಬ್ ಘೆಟ್ಲೊ, ಅನಿ ಕಮ್ಮಿಪಾನ್ ಅನಿ ಬುದ್ಗೆಡಿಪಾನ್ ಕವ್ಡೆ ಪಿಶೆ ಮನುನ್ ಒಳ್ಕುನ್ ಘೆಟ್ಲೊ. <verse eid="ECC 7:25" /><verse number="26" style="v" sid="ECC 7:26" />ತನ್ನಾ ಮಿಯಾ ಮರ್ನಾಕಿಂತಾಬಿ ಲೈ ಕೊಡುಲಿ ಎಕ್ ವಿಶಯ್ ಕಳ್ವುನ್ ಘೆಟ್ಲೊ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಬುರ್ಶಿ ಬಾಯ್ಕೊ ಮಾನುಸ್ ಪಂಜರಾ ಗತಿನ್ ಹಾಯ್, ತಿ ತುಕಾ ದಾಕ್ವುತಲೆ ಪ್ರೆಮ್ ಜಾಳ್ಯಾ ಗತಿನ್ ತುಕಾ ಧರುನ್ ಘೆತಾ, ಅನಿ ಪಾಪ್ ಕರ್ತಲೊ ತಿಚ್ಯಾ ತೆಕ್ಕ್ಯಾತ್ ಸರ್ಪೊಳಿಚ್ಯಾ ಪಾಶ್ಯಾತ್ ಸಾರ್ಕೊ ಗಾವುನ್ ಪಡ್ತಾ. ಜೆ ಕೊನ್ ದೆವಾಕ್ನಾ ಬರೊ ರ್‍ಹಾತಾ ತೊ ತಿಚ್ಯಾಕ್ನಾ ಚುಕ್ವುನ್ ಘೆತಾ, ಖರೆ ಪಾಪಿಕ್ ತಿ ಧರುನ್ ಘೆತಾ. <verse eid="ECC 7:26" /><verse number="27" style="v" sid="ECC 7:27" />ತನ್ನಾ ಉಪದೆಸ್ ಕಾರಾನ್, ಹೊಯ್, ಮಿಯಾ ಹೆ ಉಲ್ಲೆ ಉಲ್ಲೆ ಇಚಾರ್ನಿ ಕರುನ್ ಕಳ್ವುನ್ ಘೆವ್ಚೆ ಮನುನ್ ಜವಾಬ್ ಹುಡಕ್ಲೊ. <verse eid="ECC 7:27" /><verse number="28" style="v" sid="ECC 7:28" />ತನ್ನಾ ಮಾಕಾ ದುಸ್ರಿ ಜವಾಬಾ ಗಾವ್ಲಿ, ಖರೆ ಮಾಕಾ ಎಕ್ ಕಳ್ಳೆ, ಹಜಾರ್ ಘೊಮಾನ್ಸಾತ್ನಿ ಎಕ್ಲೊ ತರ್ ಪ್ರಾಮಾನಿಕ್ ಮಾನುಸ್ ರಾವ್ಕ್ ಫಿರೆ; ಖರೆ ಎಕ್ಬಿ ಬಾಯ್ಕೊ ಮಾನುಸ್ ಗಾವ್ಕ್ ನಾ. <verse eid="ECC 7:28" /><verse number="29" style="v" sid="ECC 7:29" />ಮಿಯಾ ಹೆ ಸಗ್ಳೆ ಶಿಕ್ಲೊ, ದೆವಾನ್ ಮಾನ್ಸಾಕ್ ಪ್ರಾಮಾನಿಕ್ ಕರುನ್ ರಚ್ಲಾ, ಖರೆ ಮಾನ್ಸಾನ್ ಅಪ್ನಾ ಯೆವ್ಡ್ಯಾಕುಚ್ ಕಠಿನ್ ಕರುನ್ ಘೆಟ್ಲಾ.<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 8:1" />ಶಾನೊ ಹೊತ್ತೊ ಕೊನ್? ಹಿ ವಿಶಯಾ ಸಗ್ಳಿ ವಿವರನ್ ಕರುನ್ ಸಾಂಗ್ತಲೊ ಕೊನ್? ತ್ಯಾ ಶಾನೆಪಾನಾನ್ ಎಕ್ಲ್ಯಾಚೆ ತೊಂಡ್ ಹೊಳಾವ್ತಾ, ಒರಟ್ ತೊಂಡ್ ಬದ್ಲುನ್ ರ್‍ಹಾತಾ.<verse eid="ECC 8:1" /></para>
  <para style="s">ರಾಜಾಚ್ಯಾ ಹುಕುಮಾಕ್ನಿ ಪಾಳ್</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />ತಿಯಾ ದೆವಾಚ್ಯಾ ವರ್‍ತಿ ಆನ್ ಘಾಲುನಕ್ಕೊ ಅನಿ ರಾಜಾಚ್ಯಾ ಹುಕುಮಾಕ್ನಿ ಖಾಲ್ತಿ ಹೊವ್ನ್ ಚಲ್. <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />ಅನಿ ರಾಜಾಕ್ಡೆ ತುಜಿ ವಿಶಯಾ ಸಾಂಗುಕ್ ಭಿಂವ್ ನಕ್ಕೊ; ತೊ ಅಪ್ನಾಚ್ಯಾ ಮನಾಕ್ ಯೆಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಕಾಯ್ ಹೊಲ್ಯಾರ್ಬಿ ಕರುಕ್ ಶಕ್ತ್ ಹಾಯ್, ಅನಿ ಘಾತ್ ಹೊತಲ್ಯಾ ಜಾಗ್ಯಾ ವಯ್ನಿ ಇಬೆ ರಾವ್ ನಕ್ಕೊ. <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />ರಾಜಾ ಹರ್ ಎಕ್ ಕಾಮ್ ಅಧಿಕಾರಾನ್ ಕರ್ತಾ, ಅನಿ ತೆಕಾ ಪ್ರಶ್ನ್ ಕರ್ತಲೊ ಕೊನ್ಬಿ ನಾ. <verse eid="ECC 8:4" /><verse number="5" style="v" sid="ECC 8:5" />ರಾಜಾಚ್ಯಾ ಹುಕುಮಾಕ್ನಿ ಮಾನುನ್ ಚಲ್ತಲ್ಯಾಕ್ ಕಸ್ಲಿಬಿ ತರಾಸಾ ಯೆಯ್ನಾತ್; ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಝಡ್ತಿ ಹಾಯ್ ಮನುನ್ ಶಾನ್ಯಾ ಮಾನ್ಸಾಕ್ ಗೊತ್ತ್ ಹಾಯ್. <verse eid="ECC 8:5" /><verse number="6" style="v" sid="ECC 8:6" />ಹರ್ ಎಕ್ ಕಾಮ್ ಕರುಕ್ ಸಮಾ ಎಳ್ ಅನಿ ಝಡ್ತಿ ಹಾಯ್, ತಸೆ ಹೊವ್ನ್ ಮಾನ್ಸಾಚೊ ತರಾಸ್ ತೆಜ್ಯಾ ವರ್‍ತಿ ಮೊಟೊ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="ECC 8:6" /><verse number="7" style="v" sid="ECC 8:7" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಫಿಡೆ ಕಾಯ್ ಹೊತಾ ಮನ್ತಲೆ ಅಮ್ಕಾ ಗೊತ್ತ್ ನಾ; ಅನಿ ತೆ ಕಸೆ ಹೊತಾ ಮನುನ್ ಸಾಂಗ್ತಲೊ ಕೊನ್ ಹಾಯ್? <verse eid="ECC 8:7" /><verse number="8" style="v" sid="ECC 8:8" />ವ್ಹಾರ್ಯಾಕ್ ಆಡ್ವುಕ್ ಕೊನಾಚ್ಯಾನ್ಬಿ ಹೊಯ್ನಾ, ಅನಿ ಮರ್ನಾಚ್ಯಾ ದಿಸಾತ್ನಾ ಚುಕ್ವುನ್ ಘೆವ್ಕ್ ಬಿ ಕೊನಾಚ್ಯಾನ್ ಹೊಯ್ನಾ, ತೆ ಎಕ್ ಝಗ್ಡೊ ಹೊವ್ನ್ ಹಾಯ್ ಅಮಿ ತ್ಯಾತುರ್ನಾ ಚುಕ್ವುನ್ ಘೆವ್ಕ್ ಹೊಯ್ನಾ, ತಸೆಚ್ ಬುರ್ಸ್ಯಾಕ್ ಬುರ್ಸ್ಯಾ ಪಾನಾಕ್ನಾ ಸುಟ್ಕಾ ನಾ.<verse eid="ECC 8:8" /></para>
  <para style="s">ಬುರ್ಸೊ ಅನಿ ಬರೊ</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9" />ತಸೆ ಹೊವ್ನ್ ಎಕ್ಲೊ ಅನಿ ಎಕ್ಲ್ಯಾ ವರ್‍ತಿ ಅಧಿಕಾರ್ ಚಾಲ್ವುನ್ ತೆಕಾ ಹಾನಿ ಕರ್‍ತಲ್ಯಾ ಹ್ಯಾ ಜಗಾತ್ ಹೆ ಸಗ್ಳೆ ಹೊತಲೆ ಬಗುನ್ ಮಿಯಾ ಪರಿಕ್ಷಾ ಕರುನ್ ಸೊಡ್ಲಾ. <verse eid="ECC 8:9" /><verse number="10" style="v" sid="ECC 8:10" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಮಿಯಾ ಬುರ್ಸ್ಯಾ ಮಾನ್ಸಾಕ್ ಮಾಟಿ ದಿತಲೆ ಬಗಟ್ಲೊ, ತೊ ಆರಾಮಾನ್ ಮರ್ಲೊ, ಅನಿ ಬರೊ ಮಾನುಸ್ ನಿತಳ್ ಜಾಗ್ಯಾ ವಯ್ನಾ ಜಾತಲೆ ಯೆಲೆ, ಶಾರ್‍ಹಾತ್ ಕೊನಾಕ್ಬಿ ಯಾದುಚ್ ನಾ ಹೊಲಿ, ಹೆ ಸಗ್ಳೆ ವ್ಯರ್ಥುಚ್. <verse eid="ECC 8:10" /><verse number="11" style="v" sid="ECC 8:11" />ಚುಕೆಕ್ ಲಗ್ಗುನಾ ಸಮಾ ಶಿಕ್ಷ್ಯಾ ಗಾವ್ಕ್ ನಸಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ಚುಕ್ ಕರುಚೆ ಮನ್ತಲಿ ಆಶ್ಯಾ ಮಾನ್ಸಾಂಚ್ಯಾ ಮನಾತ್ ಭರುನ್ ಹಾಯ್. <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />ಎಕ್ ಪಾಪಿ ಸೆಂಬರ್ದಾ ಚುಕ್ ಕರುನ್ಬಿ ಝಿತ್ತೊಚ್ ಹಾಯ್, ತೆನಿ ಕಾಯ್ ಸಾಂಗುಲಾತ್ ಮನುನ್ ಮಾಕಾ ಗೊತ್ತ್ ಹಾಯ್, “ತುಮಿ ದೆವಾಕ್ ಖಾಲ್ತಿ ಹೊವ್ನ್ ಚಲಲ್ಲೆ ರಾಲ್ಯಾರ್, ಸಗ್ಳೆಬಿ ಸಮಾಚ್ ರ್‍ಹಾತಾ. <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />ಖರೆ ಬುರ್ಶಿ ಕಾಮಾ ಕರ್‍ತಲ್ಯಾಕ್ ಬರೆ ಹೊಯ್ನಾ; ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಸಾವ್ಳಿ ಸಾರ್ಕೆ ರಾತಲಿ ತೆಂಚಿ ದಿಸಾ ವಾಡ್ವಳ್ಕಿ ಹೊಯ್ನಾತ್; ತಸೆ ಹೊವ್ನ್ ತೊ ದೆವಾಕ್ ಖಾಲ್ತಿ ಹೊವ್ನ್ ಚಲಿನಸ್ತಾನಾ ರ್‍ಹಾತಾ”. <verse eid="ECC 8:13" /><verse number="14" style="v" sid="ECC 8:14" />ಖರೆ ಹ್ಯಾ ಜಗಾತ್ ಕಾಯ್ಬಿ ಪಾಯ್ದ್ಯಾಕ್ ನತ್ತೆ ಎಕ್ ಕಾಮ್ ಹಾಯ್;ತೆ ಬುರ್ಸ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಚಾಲಿ ಸಾರ್ಕೆ ಯೆತಲಿ ಗತ್ ಬರ್ಯಾ ಮಾನ್ಸಾಕ್ನಿಬಿ ಯೆತಾ, ಖರೆ ಹೆ ಸಗ್ಳೆ ವ್ಯರ್ಥುಚ್ ಮನುನ್ ಮಿಯಾ ಸಾಂಗ್ಲೊ. <verse eid="ECC 8:14" /><verse number="15" style="v" sid="ECC 8:15" />ಅನಿ ಮಾನುಸ್ ಫಿವ್ನ್ ಖಾವ್ನ್ ಖುಶಿನ್ ರ್‍ಹಾತಲ್ಯಾಚ್ಯಾಕ್ನಿ ತೆಕಾ ಹ್ಯಾ ಜಗಾತ್ ಅನಿ ಕಾಯ್ ಬರೆ ಹೊತಲೆ ನಾ ಮನುನ್ ಖುಶಿನ್ ಸುತ್ತಿ ಕರ್ಲೊ; ದೆವಾನ್ ತೆಕಾ ದಿಲ್ಲ್ಯಾ ದಿಸಾತ್ನಿ ತೊ ಕರಲ್ಯಾ ತರಾಸಾತ್ನಿ ಖುಶಿಚ್ ಭರುನ್ ರ್‍ಹಾತಾ. <verse eid="ECC 8:15" /><verse number="16" style="v" sid="ECC 8:16" />ಮಿಯಾ ಹ್ಯಾ ಜಗಾತ್ ಕಾಯ್ ಚಲುಲ್ಲಾ ಮನುನ್ ಬಗುಚೆ ಅನಿ ಶಾನೊ ಹೊವ್ನ್ ಶಿಕುಚೆ ಮನುನ್ ಕಟ್ಪಟ್ ಕರ್ತಾನಾ, ಮಾಕಾ ದಿಸ್ ಅನಿ ರ್‍ಹಾತ್ ಜಾಗೊ ರಾವ್ಕ್ ಹೊತಾ ಹೊವ್ಕ್ ಫಿರೆ, ಮನ್ತಲೆ ಮಾಕಾ ಕಳ್ಳೆ. <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />ಅನಿ ದೆವ್ ಕಾಯ್ ಕರುಲ್ಲಾ ಮನ್ತಲೆ ಕನ್ನಾಚ್ ಕಳ್ವುನ್ ಘೆವ್ಕ್ ಹೊಯ್ನಾ, ತೆ ಲೈ ಘಟ್ ಹಾಯ್, ತಿಯಾ ತೆ ಕಸೆ ಕಳ್ವುನ್ ಘೆವ್ಚೆ ಮನುನ್ ಕಟ್ಪಟ್ ಕರ್ಲ್ಯಾರ್ಬಿ ತೆಬಿ ಲೈ ಘಟ್ ಹಾಯ್, ಶಾನೊ ಮಾನುಸ್ ತೆ ಕಳ್ವುನ್ ಘೆತಾ ಮನ್ತಾತ್ ಖರೆ ತೆಚೆನ್ಬಿ ಹೊಯ್ನಾ.<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />ಹೆ ಸಗ್ಳೆ ಮಿಯಾ ಮಾಜ್ಯಾ ಮನಾತ್ ಚಿಂತುನ್ ಎಕ್ ನಿರ್ದಾರಾಕ್ ಯೆಲೊ, ತೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ಬರ್ಯಾ ಅನಿ ಜಾಂನ್ತ್ಯಾ ಲೊಕಾಂಚೆ ಕಾಮ್, ದೆವಾಚ್ಯಾ ಹಾತಿತ್ ಹಾಯ್, ಖಲ್ಯಾಬಿ ಮಾನ್ಸಾಕ್ ಅಪ್ಲ್ಯಾ ಫಿಡೆ ಹೊತ್ತೆ ಪ್ರೆಮ್ ಅನಿ ದ್ವೆಶ್ ತೆಕಾ ಕಳಿನಾ. <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚೆ ಕಾಮ್ ಸಗ್ಳ್ಯಾಕ್ನಿ ಎಕುಚ್ ರಿತಿನ್ ಹೊತಾ, ಬರ್ಯಾಕ್ ಅನಿ ಬುರ್ಸ್ಯಾಕ್, ಶುದ್ದ್ ಹೊತ್ತ್ಯಾಕ್ ಅನಿ ಅಶುದ್ದ್ ಹೊತ್ತ್ಯಾಕ್, ಬಲಿ ಭೆಟ್ವುತ್ತಲ್ಯಾ ಅನಿ ಬಲಿ ಭೆಟ್ವಿ ನಸಲ್ಲ್ಯಾಕ್ ಎಕುಚ್ ಗತ್, ಚುಕ್ ಕರಿನಸಲ್ಯಾಚ್ಯಾ ಸಾರ್ಕೊ ಚುಕ್ ಕರಲ್ಲೊ ರ್‍ಹಾತಾ ಅನಿ ಆನ್ ಘಾಲ್ತಲ್ಯಾಚ್ಯಾ ಸಾರ್ಕೊ ಆನ್ ಘಾಲುಕ್ ಭಿಂವ್ನಾರೊ ರ್‍ಹಾತಾ. <verse eid="ECC 9:2" /><verse number="3" style="v" sid="ECC 9:3" />ಸಗ್ಳ್ಯಾಕ್ನಿಬಿ ಎಕುಚ್ ಗತ್ ಯೆತಾ ಮನ್ತಲೊ ತರಾಸ್ ಸಗ್ಳ್ಯಾ ಜಗಾತ್ ಭರುನ್ ಹಾಯ್, ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಮಾನ್ಸಾಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ಮನಾತ್ ಬುರ್ಸೆಪಾನ್ ಭರುನ್ ಹಾಯ್, ತೆನಿ ಝಿತ್ತೆ ಹೊತ್ತೆ ತವ್ಡೆ ದಿಸ್ ಪಿಶೆಪಾನ್ ತೆಂಚ್ಯಾ ಮನಾಕ್ ಧರುನ್ ಘೆವ್ನ್ ಹಾಯ್, ಅನಿ ತೆನಿ ಲಗ್ಗುನಾ ಮರ್ತಾತ್. <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />ಖರೆ ಹ್ಯಾ ಜಗಾತ್ ಕೊನ್ ತರ್ ಎಕ್ಲೊ ಝಿತ್ತೊ ಹಾಯ್ ಮಟ್ಲ್ಯಾರ್, ತೊ ಭರ್ವೊಶ್ಯಾನ್ ಜಿವನ್ ಕರುಲಾಗಲ್ಲೊ ಹಾಯ್, ಮರಲ್ಯಾ ಸಿಂವಾಕಿಂತಾ ಝಿತ್ತೆ ಹೊತ್ತೆ ಕುತ್ರೆ ಕವ್ಡೆಕಿ ಬರೆ. <verse eid="ECC 9:4" /><verse number="5" style="v" sid="ECC 9:5" />ಹೊಯ್, ಝಿತ್ತೊ ಹೊತ್ತ್ಯಾಕ್ ಎಕ್ ದಿಸ್ ಸಗ್ಳೆಬಿ ಮರ್ತಲೆಚ್ ಮನುನ್ ಗೊತ್ತ್ ಹಾಯ್, ಖರೆ ಮರಲ್ಯಾಕ್ ಕಾಯ್ಬಿ ಗೊತ್ತ್ ನಾ, ತೆಕಾ ಕಾಯ್ಬಿ ಪ್ರತಿಫಳ್ ಗಾಯ್ನಾ ಅನಿ ತೆನಿ ಸಗ್ಳೆ ಇಸ್ರುನ್ ಘಾಟ್ಲಾ. <verse eid="ECC 9:5" /><verse number="6" style="v" sid="ECC 9:6" />ತೆಂಚೆ ಪ್ರೆಮ್, ತೆಂಚೆ ದ್ವೆಶ್, ಅನಿ ತೆಂಚೊ ಶಿಸ್ತ್ ಸಗ್ಳೆ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಮರ್ಲಾ, ತೆನಿ ಹ್ಯಾ ಜಗಾತ್ ಖಲ್ಯಾಬಿ ಖುಸಿತ್ ಅನಿ ಪರ್‍ತುನ್ ಭಾಗಿ ಹೊವ್ಕ್ ಹೊಯ್ನಾ. <verse eid="ECC 9:6" /><verse number="7" style="v" sid="ECC 9:7" />ಜಾ ಅನಿ ಖುಶಿನ್ ಜೆವಾನ್ ಕರ್, ಅನಿ ಖುಶಿನ್ ವಾಯ್ನ್ ಫಿ, ಅತ್ತಾ ದೆವ್ ತುಜಿ ಕಾಮಾ ಒಪ್ಪುನ್ ಘೆತಾ. <verse eid="ECC 9:7" /><verse number="8" style="v" sid="ECC 9:8" />ಅನಿ ತುಜೆ ಕಪ್ಡೆ ಕನ್ನಾಬಿ ಪಾಂಡ್ರೆ ರಾಂವ್ದಿತ್, ಅನಿ ತುಜ್ಯಾ ಟಕ್ಲ್ಯಾಕ್ ಕನ್ನಾಬಿ ತೆಲಾನ್ ಅಭಿಶೆಕ್ ಕರ್. <verse eid="ECC 9:8" /><verse number="9" style="v" sid="ECC 9:9" />ದೆವಾನ್ ತುಕಾ ಹ್ಯಾ ಜಗಾತ್ ದಿಲ್ಲ್ಯಾ ವ್ಯರ್ಥ್ ಜಿವನಾತ್ ತುಜ್ಯಾ ಪ್ರೆಮಾಚ್ಯಾ ಬಾಯ್ಕೊ ವಾಂಗ್ಡಾ ಸುಖಾನ್ ಜಿವನ್ ಕರ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಹೆ ಸಗ್ಳೆ ತಿಯಾ ತುಜ್ಯಾ ತರಾಸಾಕ್ನಾ ಘೆಟಲ್ಲೆ ಹಾಯ್. <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />ತುಜ್ಯಾ ಹಾತಿಕ್ ಗಾವಲ್ಲೆ ಕಾಮ್ ತಿಯಾ ಮನ್ ದಿವ್ನ್ ಕರ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತಿಯಾ ಜಾವ್ ಲಾಗಲ್ಯಾ ಮರ್ನಾಚ್ಯಾ ಜಗಾತ್ ಕಾಮ್, ಇಚಾರ್, ಬುದ್ದ್, ಶಾನೆಪಾನ್ ರ್‍ಹಾಯ್ನಾ. <verse eid="ECC 9:10" /><verse number="11" style="v" sid="ECC 9:11" />ಮಾಕಾ ಹ್ಯಾ ಲೈ ಪಳುಲಾಗಲ್ಲೊ ಕನ್ನಾಬಿ ಜಿಕಿನಾ ಅನಿ ಶಾನೊ ಕನ್ನಾ ಝಗ್ಡ್ಯಾತ್ ಜಯ್ ಹೊಯ್ನಾ, ಶಾನೊ ಕನ್ನಾಬಿ ಆರಾಮಾನ್ ಜಿವನ್ ಕರಿನಾ, ಜ್ಞಾನಿ ಕನ್ನಾಬಿ ಸಾವ್ಕಾರ್ ಹೊವ್ನ್ ರ್‍ಹಾಯ್ನಾ, ಅನಿ ಹುಶಾರ್ ಹೊತ್ತಿ ಮಾನ್ಸಾ ಕನ್ನಾಬಿ ವಯ್ಲ್ಯಾ ಜಾಗ್ಯಾರ್ ರ್‍ಹಾಯ್ನಾ, ಹರ್ ಎಕ್ಲ್ಯಾಕ್ಬಿ ತರಾಸಾಚೊ ಎಳ್ ಯೆತ್ಯಾಚ್. <verse eid="ECC 9:11" /><verse number="12" style="v" sid="ECC 9:12" />ಫಾಂಕ್ರಾಕ್ನಿ ಲಗ್ಗುನಾ ಪಂಜರಾತ್ ಧರ್ಲೆ ಸಾರ್ಕೆ, ಅನಿ ಮಾಸೊಳ್ಯಾಕ್ನಿ ಜಾಳ್ಯಾತ್ ಧರ್ಲೆ ಸಾರ್ಕೆ, ತುಜೊ ಎಳ್ ಕನ್ನಾ ಯೆತಾ ಮನುನ್ ತುಕಾ ಗೊತ್ತುಚ್ ನಾ, ಅಮ್ಕಾ ಲಗ್ಗುನಾ ಯೆತಲ್ಯಾ ಯೆಳಾಚ್ಯಾ ಜಾಳ್ಯಾತ್ ಧರುನ್ ಹೊತಾ.<verse eid="ECC 9:12" /></para>
  <para style="s">ಶಾನ್ಯಾಚ್ಯಾ ಅನಿ ಪಿಶ್ಯಾಚ್ಯಾ ವಿಶಯಾತ್</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />ಬುದ್ದ್ ಕವ್ಡಿ ಮೊಟಿ ಮನುನ್ ಮಿಯಾ ಹ್ಯಾ ಜಗಾತ್ ಬಗಟ್ಲೊ. <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />ಅಬಕ್, ತೆ ಎಕ್ ಉಲ್ಲಿಸಿ ಲೊಕಾ ಹೊತ್ತೆ ಬಾರಿಕ್ಲೆ ಶಾರ್ ಬಲಿಸ್ಟ್ ರಾಜಾ ತ್ಯಾ ಶಾರಾ ವರ್‍ತಿ ಝಗ್ಡ್ಯಾಕ್ ಯೆಲೊ, ತೆನಿ ತ್ಯಾ ಶಾರಾಕ್ ಘೆರೊ ಘಾಲುನ್, ಥೈ ಮೊಟಿ ಭಿತ್ತಿಯಾ ಭಾಂದ್ಲ್ಯಾನ್ . <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />ತನ್ನಾ ಥೈ ಎಕ್ ಶಾನೊ ಅನಿ ಗರಿಬ್ ಮಾನುಸ್ ಹೊತ್ತೊ, ತೆನಿ ಶಾರಾಕ್ ಹುರ್ವುಲ್ಯಾನ್, ಖರೆ ಎಕ್ ಮಾನ್ಸಾನ್ಬಿ ತೆಚಿ ಯಾದ್ ಕರುಕ್ ನಾತ್. <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />ಮಿಯಾ ಕನ್ನಾಬಿ ಬುದ್ದ್ ಬಳೆಕಿಂತಾ ಜಾಸ್ತಿಚೆ ಮನುನ್ ಸಾಂಗಲ್ಲೊ, ಖರೆ ಎಕ್ಲ್ಯಾನ್ಬಿ ತ್ಯಾ ಶಾನ್ಯಾ ಗರಿಬಾನ್ ಅಪ್ನಾಚಿ ಸಗ್ಳಿ ಬುದ್ದ್ ವಾಪ್ರುನ್ ತೆ ಶಾರ್ ಹುರ್ವುಲ್ಯಾನ್ ಮನ್ತಲೆ ಚಿಂತುಕ್ ನಾತ್. <verse eid="ECC 9:16" /><verse number="17" style="v" sid="ECC 9:17" />ಪಿಶ್ಯಾ ಅಧಿಕಾರಿಚಿ ಬೊಬ್ ಆಯಿಕ್ತಲ್ಯಾಚ್ಯಾಕಿಂತಾ ಸಾವ್ಕಾಸ್ ಬೊಲ್ತಲ್ಯಾ ಬುದ್ವಂತಾಚಿ ಗೊಸ್ಟಿಯಾ ಆಯಿಕ್ತಲೆ ಕವ್ಡೆಕಿ ಬರೆ. <verse eid="ECC 9:17" /><verse number="18" style="v" sid="ECC 9:18" />ಶಾನೆಪಾನ್ ಝಗ್ಡ್ಯಾಕ್ ವಾಪರ್ತಲ್ಯಾ ವಸ್ತಾಂಚ್ಯಾಕಿಂತಾಬಿ ಬರೆ, ಖರೆ ಎಕ್ ಪಾಪಿ ಲೈ ನಮುನ್ಯಾಚೆ ಬರೆಪಾನ್ ಹಾಳ್ ಕರ್ತಾ.<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 10:1" />ಮರಲ್ಲಿ ಮಾಸ್ಕಾ ಆಯ್ದಾನಾತ್ಲೆ ಪುರಾ ಬರ್ಯಾ ವಾಸೆಚೆ ತೆಲ್ ಹಾಳ್ ಕರ್‍ತಾತ್, ಅನಿ ಉಲ್ಲೆಸೆ ಪಿಸೆಪಾನ್ ಲೈ ಶಾನೆಪಾನಾಕ್ ಹಾಳ್ ಕರ್ತಾ. <verse eid="ECC 10:1" /><verse number="2" style="v" sid="ECC 10:2" />ಶಾನ್ಯಾಚಿ ಬುದ್ದ್ ತೆಜ್ಯಾ ಉಜ್ವ್ಯಾ ಭಾಜುಕ್ ರ್‍ಹಾತಾ, ಅನಿ ಪಿಶ್ಯಾಚಿ ಬುದ್ದ್ ತೆಜ್ಯಾ ಡಾವ್ಯಾ ಭಾಜುಕ್ ರ್‍ಹಾತಾ. <verse eid="ECC 10:2" /><verse number="3" style="v" sid="ECC 10:3" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಪಿಶೊ ಪಿಶೆಪಾನ್ ಜಾಸ್ತಿ ಹೊವ್ನ್ ಅಪ್ನಿ ಫಿರ್ತಲ್ಯಾ ವಾಟೆ ವರ್‍ತಿ ಅಪ್ನಾಚೆ ಪಿಶೆಪಾನ್ ಸಗ್ಳ್ಯಾಕ್ನಿ ಕಳ್ವುನ್ ಘೆತಾ. <verse eid="ECC 10:3" /><verse number="4" style="v" sid="ECC 10:4" />ತುಜ್ಯಾ ಕಾಮಾಚೊ ಅಧಿಕಾರಿ ತುಜ್ಯಾ ವರ್‍ತಿ ರಾಗ್ ಯೆಲ್ಲೊ ರಾಲ್ಯಾರ್, ಕಾಮ್ ಸೊಡು ನಕ್ಕೊ, ತಿಯಾ ಸಮಾಧಾನಾನ್ ರ್‍ಹಾತಾನಾ ಲೈ ಮೊಟೊ ರಾಗ್ ಧಾಪುನ್ ಹೊತಾ. <verse eid="ECC 10:4" /><verse number="5" style="v" sid="ECC 10:5" />ಮಿಯಾ ಜಗಾತ್ ಅನಿ ಎಕ್ ತರಾಸ್ ಬಗಟ್ಲಾ, ತೆ ಅಧಿಕಾರಿಚ್ಯಾ ಚುಕೆ ವಯ್ನಾ ಹೊಲಾ ಮನುನ್ ಮಾಕಾ ದಿಸುನ್ ಯೆತಾ. <verse eid="ECC 10:5" /><verse number="6" style="v" sid="ECC 10:6" />ಪಿಶ್ಯಾಕ್ನಿ ಅಧಿಕಾರ್ ಚಾಲ್ವುತಲಿ ಮೊಟಿ ಪದ್ವಿ ಗಾವ್ಲಾ, ಅನಿ ಸಾವ್ಕಾರ್ ಕಮ್ಮಿಚ್ಯಾ ಜಾಗ್ಯಾರ್ ಹಾತ್, <verse eid="ECC 10:6" /><verse number="7" style="v" sid="ECC 10:7" />ಆಳ್ ಘೊಡ್ಕಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಸವಾರಿ ಕರುನ್ಗೆತ್ ಹೊತ್ತೆ ಅನಿ ಧನಿ ಆಳಾಚ್ಯಾ ಸಾರ್ಕೆ ಜಿಮ್ನಿ ವರ್‍ತಿ ಚಲ್ತಲೆ ಬಗಟ್ಲೊ. <verse eid="ECC 10:7" /><verse number="8" style="v" sid="ECC 10:8" />ಖಡ್ಡೊ ಖಂಡಲ್ಲೊ ಮಾನುಸ್ ಅಪ್ನಿಚ್ ತ್ಯಾತುರ್ ಪಡ್ತಾ, ಅನಿ ಭಿತ್ತ್ ಪೊಡುಕ್ ಲಾಗಲ್ಲ್ಯಾಕ್ ಸಾಪ್ ಚಾವ್ತಾ. <verse eid="ECC 10:8" /><verse number="9" style="v" sid="ECC 10:9" />ತಿಯಾ ಗುಂಡ್ಯಾಂಚ್ಯಾ ರಾಸಿತ್ ಕಾಮ್ ಕರುಲಾಗಲ್ಲೊ ಹೊಲ್ಯಾರ್, ತುಕಾ ಗುಂಡ್ಯಾಂಚೊ ಮಾರ್ ಬಸ್ತಾ, ಎಕ್ ಯೆಳಾ ತಿಯಾ ನಾಕುಡ್ ಫೊಡ್ತಲ್ಯಾಕ್ ತೆಜ್ಯಾ ವಯ್ನಾ ಅಪಾಯ್ ಹಾಯ್. <verse eid="ECC 10:9" /><verse number="10" style="v" sid="ECC 10:10" />ತುಜಿ ಕಾಮ್ ಕರ್ತಲಿ ಕುರಾಡ್ ಮಂಡ್ ಹೊಲ್ಲಿ ರಾಲ್ಯಾರ್, ತಿಕಾ ತಿಯಾ ಪಾಜ್ವಿ ನಸ್ತಾನಾ ತೆನಿ ಲೈ ಬಳ್ ಪಾಜೆ ಪಡ್ತಾ, ಲೈ ಕಾಮ್ ಫುರಾ ಹೊವ್ನ್ ಬುದ್ದುಚ್ ವಾಪ್ರುಚೆ ಹೊತಾ. <verse eid="ECC 10:10" /><verse number="11" style="v" sid="ECC 10:11" />ಅನಿ ಸಾಪಾಕ್ ಖೆಳ್ವುತಲ್ಯಾ ಅದ್ದಿಚ್ ತೆನಿ ಖೆಳ್ವುತಲ್ಯಾಕ್ ಚಾವ್ಲ್ಯಾರ್ ಕಾಯ್ ಫಾಯ್ದೊ. <verse eid="ECC 10:11" /><verse number="12" style="v" sid="ECC 10:12" />ಶಾನ್ಯಾಚಿ ಗೊಸ್ಟಿಯಾ ಮಾನ್ ಘೆತಲಿ ಹೊವ್ನ್ ಹಾತ್ ಖರೆ ಪಿಸೊ ಅಪ್ನಾಚ್ಯಾ ಗೊಸ್ಟಿಯಾನಿ ಸ್ವತಾಕುಚ್ ನಾಶ್ ಕರುನ್ ಘೆತಾ. <verse eid="ECC 10:12" /><verse number="13" style="v" sid="ECC 10:13" />ಪಿಶ್ಯಾಚಿ ಗೊಸ್ಟಿಯಾ ಶುರು ಕರ್ತಾನಾ ಬುದ್ಗೆಡಿ ಪಾನಾತ್ ರ್‍ಹಾತಾತ್ ಅನಿ ಆಕ್ರಿಕ್ ಲೈ ತರಾಸಾಚ್ಯಾ ಪಿಶೆ ಪಾನಾತ್ ರ್‍ಹಾತಾತ್. <verse eid="ECC 10:13" /><verse number="14" style="v" sid="ECC 10:14" />ಪಿಸೊ ಮಾನುಸ್ ವಯ್ಲ್ಯಾ ಬೊಲ್ತಾ ಖರೆ ಫಿಡೆ ಕಾಯ್ ಹೊತಲೆ ಹಾಯ್ ಮನುನ್ ಕೊನಾಕ್ಬಿ ಗೊತ್ತ್ ನಾ, ಅನಿ ಅಮ್ಚ್ಯಾ ಮರ್ನಾಚ್ಯಾ ಮಾನಾ ಕಾಯ್ ಹೊತಲೆ ಹಾಯ್? ಅನಿ ತೆಕಾ ಸಾಂಗಿಲ್.<verse eid="ECC 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 10:15" />ಶಾರಾಚಿ ವಾಟ್ ಕಳಿನಸಲ್ಯಾಕ್ ಕಳ್ವುಕ್ ಸಾಟ್ನಿ ಪಿಶ್ಯಾನಿ ತರಾಸ್ ಕರುನ್ ಘೆತಲೆ ಫುಕೊಟ್. <verse eid="ECC 10:15" /><verse number="16" style="v" sid="ECC 10:16" />ಶಾರಾಚೊ ರಾಜಾ ದಾಂಡ್ಗೊ ರಾವ್ನ್ ತೆಚಿ ಅಧಿಕಾರಿಯಾ ರಾತ್ತಿನಿ ತೆಜ್ಯಾ ಕಿಂತಾ ಅದ್ದಿಚ್ ಜೆವ್ನಾಕ್ ಬಸ್ಲ್ಯಾರ್, ಹ್ಯೊ ತುಕಾ ತರಾಸುಚ್. <verse eid="ECC 10:16" /><verse number="17" style="v" sid="ECC 10:17" />ಶಾರಾಚೊ ರಾಜಾ ಆಳ್ಸಿ ನ್ಹಯ್ ಹೊವ್ನ್ ಅಪ್ನಾಚೊ ನಿರ್ದಾರ್ ಘೆತಲೊ ಹೊವ್ನ್ ರಾವ್ನ್, ಅಧಿಕಾರಿಯಾ ಬರೆಪಾನಾನ್ ರಾವ್ನ್ ಸಮಾ ಎಳಾರ್ ಜೆವಾನ್ ಕರುಕ್ ಲಾಗ್ಲ್ಯಾರ್ ತೆಕಾ ತೆ ಕವ್ಡೆಕಿ ಬರೆ. <verse eid="ECC 10:17" /><verse number="18" style="v" sid="ECC 10:18" />ಜೆ ಕೊನ್ ಅಪ್ನಾಚ್ಯಾ ಘರಾಚಿ ಥಾಟ್ ಸಮಾ ಕರುನ್ ಘೆವ್ಕ್ ಲೈ ಆಳ್ಸಿಪಾನ್ ಕರ್ಲ್ಯಾರ್, ತೆ ಘರ್ ಗಳ್ತಾ . <verse eid="ECC 10:18" /><verse number="19" style="v" sid="ECC 10:19" />ಸನ್ ಕರ್‍ತಲ್ಯಾ ವಯ್ನಾ ಖುಶಿ ಹೊತಾ, ಅನಿ ವಾಯ್ನ್ ಫಿತಾನಾ ಖುಶಿ ಹೊತಾ ಖರೆ ತಿಯಾ ಹೆ ಸಗ್ಳೆ ಪಯ್ಶ್ಯಾನ್ ಗಾವ್ತಾ. <verse eid="ECC 10:19" /><verse number="20" style="v" sid="ECC 10:20" />ತುಜ್ಯಾ ಮನಾತ್ಬಿ ರಾಜಾಕ್ ಗಾಳಿಯಾ ದಿವ್ ನಕ್ಕೊ, ಅನಿ ಸಾವ್ಕಾರಾಕ್ನಿ ಬಗುನ್ ಶರಾಪ್ ಘಾಲು ನಕ್ಕೊ, ತಿಯಾ ನಿಜಲ್ಯಾಕ್ಡೆಬಿ ಅಸಿ ಶರಾಪ್ ಘಾಲುನಕ್ಕೊ, ಮಳ್ಬಾತ್ಲೆ ಫಾಕ್ರು ತಿಯಾ ಸಾಂಗಲ್ಲಿ ಗೊಸ್ಟಿಯಾ ಘೆವ್ನ್ ಜಾತಿಲ್, ನಾತರ್ ರಕುಟೆ ಹೊತ್ತಿ ಜಿವಿ ಜಾವ್ನ್ ಸಾಂಗ್ತಿಲ್.<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s">ಶಾನೊ ಮಾನುಸ್ ಕಾಯ್ ಕರ್ತಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 11:1" />ತುಜೆ ಜೆವಾನ್ ಪಾನ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಟಾಕ್ ಲೈ ದಿಸಾ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ತೆ ತುಕಾ ಗಾವ್ತಾ. <verse eid="ECC 11:1" /><verse number="2" style="v" sid="ECC 11:2" />ತುಜೆ ದೆನೆ ಸಾತ್ ನಾತರ್ ಆಟ್ ಲೊಕಾಕ್ನಿ ವಾಟುನ್ ದಿ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಜಗಾತ್ ಫಿಡೆ ಕಾಯ್ ಅವ್ಗಡ್ ಘಡಿಲ್ ಮನುನ್ ತುಕಾ ಗೊತ್ತ್ ನಾ. <verse eid="ECC 11:2" /><verse number="3" style="v" sid="ECC 11:3" />ಝಾಡಾ ಉತ್ತರಾಕ್ ನಾತರ್, ದಕ್ಷಿನಾಕ್ ಖಲ್ಯಾ ಭಾಜುಕ್ ಪಡಲ್ಲಿ ರಾಲ್ಯಾರ್ಬಿ ತೆ ಇಸಬ್ ಕರುನ್ ಹೊಯ್ನಾ, ಮೊಡಾ ಭರಲ್ಲ್ಯಾ ತನ್ನಾ ಪಾವ್ಸ್ ಯೆತಾ; <verse eid="ECC 11:3" /><verse number="4" style="v" sid="ECC 11:4" />ತಿಯಾ ಮೊಡಾಕ್ನಿ ಬಗುನ್ಗೆತ್ ರಾಲ್ಯಾರ್ ಕಾತ್ರನ್ ಕರಿನೆ, ಅನಿ ವ್ಹಾರ್ಯಾಕ್ ಬಗುನ್ಗೆತ್ ರಾಲ್ಯಾರ್ ಪೆರಿನೆ. <verse eid="ECC 11:4" /><verse number="5" style="v" sid="ECC 11:5" />ಆವ್ಸಿಚ್ಯಾ ಪೊಟಾತ್ ಪೊರ್ ಹೊವ್ನ್ ವಾಡ್ತಲ್ಯಾ ಹಡ್ಡಾತ್ನಿ ಜಿವಾಚೊ ಶ್ವಾಸ್ ಕಸೊ ಯೆಲೊ ಮನ್ತಲೆ ತುಕಾ ಕಳಿನಸಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್, ದೆವಾನ್ ಕರಲ್ಲ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ವಿಶಯಾತ್ ತುಕಾ ಕಳಿನಾ. <verse eid="ECC 11:5" /><verse number="6" style="v" sid="ECC 11:6" />ಸಕ್ಕಾಳಾಕ್ ಬಿಂಯ್ ಪೆರ್, ಸಕ್ಕಾಳಾಕ್ನಾ ಸಾಂಜ್ ಪತರ್ಬಿ ಕಾಮ್ ಕರ್, ತ್ಯಾತುರ್ ಕವ್ಡೆ ಉಪ್ಜುನ್ ಯೆವ್ನ್ ಬರೆ ವಾಡ್ತಾ ಅನಿ ಕವ್ಡೆ ಹಾಳ್ ಹೊತಾ ಮನುನ್ ತುಕಾ ಗೊತ್ತುಚ್ ನಾ. <verse eid="ECC 11:6" /><verse number="7" style="v" sid="ECC 11:7" />ದಿಸಾಚೊ ಉಜ್ವೊಡ್ ಖರೆಚ್ ಬರೊ ಹಾಯ್, ದಿಸಾಚ್ಯಾ ಉಜ್ವೊಡಾತ್ ಖುಸಿನ್ ರ್‍ಹಾತಲೆ ಲೈ ಬರೆ. <verse eid="ECC 11:7" /><verse number="8" style="v" sid="ECC 11:8" />ತಿಯಾ ಝಿತ್ತೆ ಹೊತ್ತ್ಯಾ ಹರ್ ಎಕ್ ವರಿಸ್ಬಿ ಖುಶಿನ್ ರಾ, ತಿಯಾ ಕವ್ಡೆ ದಿಸ್ ಝಿತ್ತೊ ಹಾಸ್ ಮನ್ತಲೆ ಕಾಯ್ ಮೊಟೆ ನ್ಹಯ್, ಮರ್ನಾಚಿ ದಿಸಾ ದುರ್ ನಾತ್ ಮನ್ತಲೆ ಯಾದ್ ಥವ್ನ್ ಘೆ. ಅನಿ ಹೆಚ್ಯಾನ್ ಫಿಡೆ ಹೊತಲೆ ಕಾಯ್ಬಿ ಫಾಯ್ದ್ಯಾಚೆ ನ್ಹಯ್.<verse eid="ECC 11:8" /></para>
  <para style="s">ದಾಂಡ್ಗ್ಯಾ ಮಾನ್ಸಾಕ್ನಿ ಸಲಹಾ</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 11:9" />ದಾಂಡ್ಗ್ಯಾನೊ ತುಮ್ಚ್ಯಾ ದಾಂಡ್ಗ್ಯಾಪಾನಾತ್ ಖುಸಿನ್ ರಾವಾ, ಅಜುನ್ ಪತರ್ ತುಮಿ ದಾಂಡ್ಗೆ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ಖುಶಿ ಹೊವಾ, ಮನಾಕ್ ಬರೆ ಲಾಗಿ ಸಾರ್ಕೆ ಅನಿ ಡೊಳ್ಯಾಕ್ನಿ ಬರೆ ದಿಸಿ ಸಾರ್ಕೆ ಚಲಾ. ಖರೆ ತುಮಿ ಕರಲ್ಲ್ಯಾ ಹರ್ ಎಕಾಕ್ ದೆವ್ ಝಡ್ತಿ ಕರ್ತಾ ಮನ್ತಲೆ ಯಾದ್ ಥವ್ನ್ ಘೆವಾ. <verse eid="ECC 11:9" /><verse number="10" style="v" sid="ECC 11:10" />ತುಜ್ಯಾ ಮನಾಚ್ಯಾ ದುಕ್ಕೆಚ್ಯಾ ವಿಶಯಾತ್ ಚಿಂತುನಕ್ಕೊ, ತಿಯಾ ಲೈ ದಿಸಾಂಚ್ಯಾ ಪತರ್ ಅಸೊಚ್ ದಾಂಡ್ಗೊ ರಾಯ್ ನ್ಹಯ್.<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1" />ತರಾಸಾಚಿ ದಿಸಾ ಕುಶಿಚ್ ನಾ, ಮನುನ್ ತಿಯಾ ಸಾಂಗ್ತಲಿ ವರ್ಸಾ ಯೆತಲ್ಯಾ ಅದ್ದಿಚ್, ದಾಂಡ್ಗ್ಯಾ ಪಾನಾತುಚ್ ತುಕಾ ರಚಲ್ಲ್ಯಾಚಿ ಯಾದ್ ಕರ್. <verse eid="ECC 12:1" /><verse number="2" style="v" sid="ECC 12:2" />ತ್ಯಾ ತರಾಸಾಚ್ಯಾ ದಿಸಾತ್ನಿ, ದಿಸ್, ಉಜ್ವೊಡ್, ಚಂದಾಮ್ ಅನಿ ಚುಕ್ಕಿಯಾ ಮಬ್ಬ್ ಹೊತಾತ್; ಪಾವ್ಸಾಚೊ ಎಳ್ ಸರ್ಲ್ಯಾ ಮಾನಾಬಿ, ಮೊಡಾ ಅನಿ ಪರ್‍ತುನ್ ಯೆತಾತ್. <verse eid="ECC 12:2" /><verse number="3" style="v" sid="ECC 12:3" />ತ್ಯಾ ದಿಸಾತ್ನಿ ಘರ್ ರಾಕ್ನಾರಿ ಲೊಕಾ ಥರ್ಥರ್ತಾತ್, ಬಲಿಸ್ಟಾ ಬಾಗ್ತಾತ್, ದಳ್ತಲಿ ಲೊಕಾ ಕಮ್ಮಿ ಹೊವ್ನ್ ಕಾಮ್ ಬಂದ್ ಕರ್‍ತಾತ್, ಕಿಡ್ಕಿಯಾಂತ್ನಾ ಬಗ್ತಲಿ ಲೊಕಾ ಮಂದ್ ಹೊತಾತ್. <verse eid="ECC 12:3" /><verse number="4" style="v" sid="ECC 12:4" />ವಾಟೆಚಿ ದಾರಾ ಧಾಪುನ್ ಹೊತಾ, ದಳ್ತಲೊ ಆವಾಜ್ ಬಾರಿಕ್ ಹೊತಾ, ಫಾಕ್ರಾಂಚೊ ಆವಾಜ್ ಕಮ್ಮಿ ಹೊತಾ, ಗಿತಿಚ್ಯಾ ಲೆಕಿಯಾಕ್ನಿ ಕಮ್ಮಿ ಕರುನ್ ಹೊತಾ. <verse eid="ECC 12:4" /><verse number="5" style="v" sid="ECC 12:5" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ತ್ಯಾ ದಿಸಾತ್ನಿ ಮಾನುಸ್ ಉಪ್ಪರ್ಲೆ ಜಾಗೆ ಬಗಟ್ಲ್ಯಾರ್ ಭಿಂವ್ತಾ, ಅನಿ ಚಲ್ತಲೆ ಲೈ ಅಪಾಯಾಚೆ ಹೊವ್ನ್ ಹಾಯ್, ಫುಲ್ಲಾ ಹೊತಲ್ಯಾ ಬಾದಾಮಿಚ್ಯಾ ಝಾಡಾ ಸಾರ್ಕೆ ತುಜಿ ಕೆಸಾ ಫಾಂಡ್ರಿ ಹೊತಾತ್, ಠೊಳ್ ಝಡ್ ಹೊವ್ನ್ ಸಗ್ಳಿ ಬಳ್ ಸರುನ್ ಜಾತಾ, ತಿಯಾ ಶಾಸ್ವತ್ ಘರಾಕ್ ಜಾತಲೊ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ, ಅನಿ ಅಳಾಪ್ ಕರ್‍ತಲ್ಯಾಂಚೊ ಅಳಾಪ್ ವನಿಯಾತ್ನಿ ಜಾತಾ. <verse eid="ECC 12:5" /><verse number="6" style="v" sid="ECC 12:6" />ಹೆಜ್ಯಾನ್ ಫಿಡೆ ಚಾಂದಿಚಿ ಸರ್ಪೊಳಿ ಕಳ್ಚುನ್ ಪಡುನ್, ಸೊನ್ಯಾಚಿ ಕಟೊರೊ ಫುಟುನ್ ಜಾತಾ, ಪಾನಿಯಾಚೊ ಬಿಂದ್ಗೊ ಝರಾಕ್ಡೆ ಫುಟುನ್ ಜಾತಾ, ಅನಿ ಭಾಂಯಿಚೊ ಗಡ್ಗಡೊ ಮೊಡ್ತಾ. <verse eid="ECC 12:6" /><verse number="7" style="v" sid="ECC 12:7" />ಅಮ್ಚೆ ಆಂಗ್ ಮಾಟಿಚೆ ಮಾಟಿಕ್ ಮಿಳುನ್ ಅದ್ದಿ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆ ಹೊತಾ, ಅನಿ ದೆವಾನ್ ದಿಲ್ಲೊ ಆತ್ಮೊ ದೆವಾಕ್ಡೆ ಪರ್‍ತುನ್ ಜಾತಾ, <verse eid="ECC 12:7" /><verse number="8" style="v" sid="ECC 12:8" />“ವ್ಯರ್ಥುಚ್ ವ್ಯರ್ಥ್, ಸಗ್ಳೆಚ್ ವ್ಯರ್ಥ್ ” ಮನುನ್ ಉಪದೆಸಕ್ ಸಾಂಗ್ತಾ.<verse eid="ECC 12:8" /></para>
  <para style="s">ಆಕ್ರಿಚಿ ಗೊಸ್ಟಿಯಾ</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />ಖರೆ ಉಪದೆಸಕ್ ಬುದ್ದ್ ಹಾಯ್, ತೆನಿ ಅಪ್ನಿ ಕಾಯ್ ಶಿಕ್ಲ್ಯಾನ್ ತೆ ಲೊಕಾಕ್ನಿ ಶಿಕ್ವುಲ್ಯಾನ್, ತೆನಿ ಬುದ್ದ್ ಲೈ ಕರ್ತಲಿ ಸಂಗ್ತಿಯಾ ವಾಚ್ಲ್ಯಾನ್, ಅನಿ ತೆ ಲೈ ಶಾನೆ ಪಾನಾನ್ ಶಿಕ್ಲ್ಯಾನ್, ಅನಿ ಖರ್ಯಾ ವರ್‍ತಿ ವಿಶ್ವಾಸ್ ಕರ್ಲ್ಯಾನ್. <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />ಉಪದೆಸ್ ಕಾರಾನ್ ಉಲ್ಲಿ ಬರಿ ಗೊಸ್ಟಿಯಾ ಹುಡ್ಕುನ್ ಕಾಡುಕ್ ಕಟ್ಪಟ್ ಕರ್ಲ್ಯಾನ್, ಖರೆ ತೆನಿ ಲಿವಲ್ಲಿ ಗೊಸ್ಟಿಯಾ ಲೈ ಖರ್ಯಾಚಿ ಹಾತ್. <verse eid="ECC 12:10" /><verse number="11" style="v" sid="ECC 12:11" />ಸಾಂಗುಲಾಗಲ್ಲಿ ಬುದ್ದಿಚಿ ಗೊಸ್ಟಿಯಾ ಗೊರಾ ಹಾಂಬಡ್ತಲ್ಯಾ ಖಾಟಿ ಸಾರ್ಕಿ ಉಪೆಗಾಚಿ ಹೊವ್ನ್ ಹಾತ್, ಅನಿ ಗೊಳಾ ಕರಲ್ಲಿ ವಾಕ್ಯ್ ಬಳಾನ್ ಮಾರಲ್ಲ್ಯಾ ಮೊಳ್ಯಾಂಚ್ಯಾ ಗತಿನ್ ಹಾಯ್ ಹೆ ದೊನಿಬಿ ಎಕುಚ್ ಕುರ್ಬುರಾಕ್ನಾ ಯೆಲ್ಲಿ ಹೊವ್ನ್ ಹಾತ್. <verse eid="ECC 12:11" /><verse number="12" style="v" sid="ECC 12:12" />ಮ್ಯಾಜ್ಯಾ ಲೆಕಾ, ಹೆ ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಹುರಲ್ಲ್ಯಾ ವಿಶಯಾತ್ನಿಬಿ ಹುಶ್ಯಾರ್ಕಿನ್ ರಾ, ಲೈ ಪುಸ್ತಕಾ ರಚುಕ್ ಮಿತಿ ನಾ, ಲೈ ಶಿಕಾಪ್ ಆಂಗಾಕ್ ಫಿರೆ ಕರ್ತಾ. <verse eid="ECC 12:12" /><verse number="13" style="v" sid="ECC 12:13" />ಸಗ್ಳಿ ವಿಶಯಾ ಸರ್ಲಿ, ಸಗ್ಳೆ ಆಯ್ಕುನ್ ಹೊಲೆ, ದೆವಾಕ್ ಭಿಂವ್ನ್ ತೆಜ್ಯಾ ಹುಕುಮಾಕ್ನಿ ಖಾಲ್ತಿ ಹೊವ್ನ್ ಚಲ್, ಸಗ್ಳ್ಯಾ ಮಾನ್ಸಾಂಚೆ ಕಾಮ್ ಹೆಚ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="ECC 12:13" /><verse number="14" style="v" sid="ECC 12:14" />ಬರೆ ಹೊಂವ್ದಿತ್, ನಸ್ಲ್ಯಾರ್ ಬುರ್ಸೆ ಹೊಂವ್ದಿ, ಸಗ್ಳ್ಯಾ ಘುಟ್ಟಾಚ್ಯಾ ವಿಶಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಸಗ್ಳ್ಯಾಚಿಬಿ ದೆವ್ ಝಡ್ತಿ ಕರ್ತಾ.<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>