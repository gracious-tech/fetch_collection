<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EZK" style="id">- Siddi</book>
  <para style="h">ಎಜ್ಕೆಲ್</para>
  <para style="toc3">ಎಜ್ಕೆ</para>
  <para style="toc2">ಎಜ್ಕೆಲ್</para>
  <para style="toc1">ಎಜ್ಕೆಲ್ ಪರ್‍ವಾದ್ಯಾಚೆ ಪುಸ್ತಕ್</para>
  <para style="mt2">ಯೆಹೆಜ್ಕೇಲನು</para>
  <para style="mt1">ಎಜ್ಕೆಲ್ ಪರ್‍ವಾದ್ಯಾಚೆ ಪುಸ್ತಕ್</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ಎಜ್ಕೆಲ್ ಪುಸ್ತಕ್ ಇಜ್ರಾಯೆಲಾಚೆ ಪಡ್ನೆ ಅನಿ ತೆಚ್ಯಾ ಪರ್‍ತುನ್ ಭಾಂದ್ಪಾಚ್ಯಾ ವಿಶಯಾತ್ ಪರ್‍ವಾದನ್ ಪುಸ್ತಕ್ ಹೊವ್ನ್ ಹಾಯ್. ಎಜ್ಕೆಲ್ ಪ್ರವಾದ್ಯಾಚ್ಯಾ ವಿಶಯಾತ್ ಕಳುನ್ ಎತಲೆ ಸಗ್ಳೆ ಹ್ಯಾ ಪುಸ್ತಕಾಂಚ್ಯಾಕ್ನಾಚ್, ತೆಚಿ ಪ್ರವಾದ್ಯಾಂಚಿ ಸೆವಾ ಸಗ್ಳೆ ಮಿಳುನ್ ಇಸಾರ್ ದೊನ್ ವರ್ಸಾಚ್ಯಾ ಪಾತರ್ ಚಲ್ಲಿ, ಜರುಜಲೆಮ್ ಪಡ್ನೆ, ಕ್ರಿಸ್ತ್ ಉಪ್ಜುಚ್ಯಾ ಅದ್ದಿ ಪಾಸ್ಸೆ ಆಯ್ಸಿರ್ ಸಾವೆಚ್ಯಾ ವರ್ಸಾಕಿಂತಾ ಅದ್ದಿ ಸಾತ್ ವರಿಸ್, ಮಾನಾ ಪಂದ್ರಾ ವರ್ಸಾಚ್ಯಾ ಮಾನಾ ತೆಜ್ಯಾ ಸೆವಾತ್ ತೆಚ್ಯಾ ದರ್ಶನಾಕ್ನಿ ಜವಾಬ್ ದಿವ್ನ್, ಎಜ್ಕೆಲಾನ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಹೊತಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಸಂಗ್ತಿಯಾಚ್ಯಾ ವಯ್ನಾ ಕಾಮ್ ಕರ್‍ತಲೆ ಹಾಯ್. ಎಕ್ ಉದಾರನ್ ಪಾಚ್ವೆಚ್ಯಾ ಪಾಟಾತ್ ದಿಸುನ್ ಯೆತಾ, ಅನಿ ತೆಚಿ ದಾಡಿ ಕಾತ್ರುಕ್ ಅನಿ ಕೆಸಾ ತಿನ್ ಭಾಗ್ ಕರುನ್ ಎಗ್ಳುಚೆ ಮನುನ್ ಸಾಂಗ್ತಾ, ಹೆ ಪಾಚ್ ಫಾಟ್ ಎಕ್ವ್ಯಾ ವಚನಾತ್ ಹಾಯ್, ಜರುಜಲೆಮಾತ್ ಕಾಯ್ ಹೊತಾ ಮನುನ್ ದಾಕ್ವುತಾ.</para>
  <para style="ip">ಎಜ್ಕೆಲ್ ಪುಸ್ತಕಾತ್ ತಿನ್ ಮುಕ್ಕ್ಯ್ ಭಾಗ್ ಹೊವ್ನ್ ಎಗ್ಳೆ ಕರಲ್ಲೆ ಹಾಯ್; ಇಜ್ರಾಯೆಲಾಚಿ ಝಡ್ತಿ ಕರ್‍ತಲೆ, ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ರಾಜ್ಯಾಂಚಿ ಝಡ್ತಿ ಕರ್‍ತಲೆ, ಅನಿ ಇಜ್ರಾಯೆಲಾಚೆ ಪರ್‍ತುನ್ ಭಾಂದಾಪ್. ಹ್ಯಾ ಸಗ್ಳ್ಯಾ ತಿನ್ ಭಾಗಾತ್ನಿ ಮುಕ್ಕ್ಯ್ ವಿಶಯ್ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ಅಮಿ ದೆವಾಕ್ ವಳ್ಕುಕ್ ಸಗ್ಳಿ ವಿಶಯಾ ಕಸಿ ಕಾರನ್ ಹೊತಾತ್ ಮನ್ತಲೆ ಹೊವ್ನ್ ಹಾಯ್. “ತನ್ನಾ ತೆನಿ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಮಾಕಾ ವಳಕ್ತಾತ್”, ಮನ್ತಲಿ ಹಿ ಗೊಸ್ಟಿಯಾ ಸಾಟಾನ್ಬಿ ಜಾಸ್ತಿ ಎಜ್ಕೆಲಾನ್ ಲಿವ್ಲ್ಯಾನ್. ತೆಕಾಚ್ ದೆವಾನ್ ಝಡ್ತಿ ಕರುಂದಿತ್ ನಾತರ್ ಪರ್‍ತುನ್ ಭಾಂದುದಿತ್ ಅಮಿ ತೆಚ್ಯಾ ವಿಶಯಾತ್ ಅನಿ ತೊ ಅಮ್ಚ್ಯಾಕ್ನಾ ಅನಿ ತೊ ಕಾಯ್ ಆಶ್ಯಾ ಕರ್ತಾ ಮನ್ತಲೆ ಶಿಕ್ತಾಂವ್.</para>
  <para style="iot">ಭಾಗ್</para>
  <para style="io1">1. ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ವರ್‍ತಿ ದೆವಾಚೆ ಝಡ್ತಿ ಕರ್ತಲೊ ವಿಶಯಾತ್ ಹಾಯ್. <char style="ior"><ref loc="EZK 1-24">1—24</ref> </char></para>
  <para style="io1">2. ದೆವಾನ್ ಬೊತ್ಯಾನ್ ಹೊತ್ತ್ಯಾ ರಾಜಾಕ್ನಿ ಝಡ್ತಿ ಕರ್ತಾ. <char style="ior"><ref loc="EZK 25-32">25—32</ref> </char></para>
  <para style="io1">3. ಇಜ್ರಾಯೆಲ್ ಪರ್‍ತುನ್ ಭಾಂದಾಪಾಚ್ಯಾ ವಿಶಯಾತ್ ಎಜ್ಕೆಲ್ ಪ್ರವಾದನ್ ಕರ್ತಾ. <char style="ior"><ref loc="EZK 33-48">33—48</ref> </char></para>
  <chapter number="1" style="c" sid="EZK 1" />
  <para style="s">ದೆವಾಚೆ ಸಿಂವಾಸನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 1:1" />ಕೆಬಾರ್ ಮನ್ತಲ್ಯಾ ನ್ಹಯ್ಚ್ಯಾ ಜಗ್ಗೊಳ್ ಬಂಧಿಹೊವ್ನ್ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾ ಜುದೆವಾಂಚ್ಯಾ ಮದ್ದಿ ಮಿಯಾ ವಸ್ತಿ ರ್‍ಹಾತಾನಾ, ತಿಸಾವೆ ವರ್ಸಾಚ್ಯಾ ಚಾರ್ವ್ಯಾ ಮ್ಹಯ್ನ್ಯಾಚ್ಯಾ ಪಾಂಚ್ವ್ಯಾ ದಿಸಾತ್ ಮಳಬ್ ಉಗ್ಡುನ್, ಮಿಯಾ ದೆವಾಚಿ ದರ್ಶನಾ ಬಗಟ್ಲೊ. <verse eid="EZK 1:1" /><verse number="2" style="v" sid="EZK 1:2" />ತನ್ನಾ ರಾಜಾ ಹೊಲ್ಲ್ಯಾ ಜೆಹೊಯಾಕಿನ್ ಬಂಧಿ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಪಾಂಚ್ವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಚಾರ್ವ್ಯಾ ಮ್ಹಯ್ನ್ಯಾಚ್ಯಾ ಪಾಂಚ್ವ್ಯಾ ದಿಸಿ. <verse eid="EZK 1:2" /><verse number="3" style="v" sid="EZK 1:3" />ಸರ್ವೆಸ್ಪರಾಚೆ ವಚನ್ ಕಸ್ದಿಯಾ ದೆಸಾತ್ ಕೆಬಾರ್ ಮನ್ತಲ್ಯಾ ನ್ಹಯ್ಚ್ಯಾ ಜಗ್ಗೊಳ್ ಹೊತ್ತ್ಯಾ ಬುಜಿ ಮನ್ತಲ್ಯಾಚೊ ಲೆಕ್ ಯಾಜಕ್ ಹೊಲ್ಲ್ಯಾ ಎಜ್ಕೆಲಾಕ್ ಚೊಕ್ಕ್ ಆಯ್ಕೊ ಯೆಲೆ, ಅನಿ ಥೈ ಸರ್ವೆಸ್ಪರಾಚಿ ಮಹಿಮಾ ತೆಜ್ಯಾ ವರ್‍ತಿ ಹೊತ್ತಿ.<verse eid="EZK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 1:4" />ತನ್ನಾ ಮಿಯಾ ಬಗಿತ್ ರ್‍ಹಾತಾನಾಚ್, ಅಬಕ್, ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ನಾ ವ್ಹಾರೊ ಉಟ್ಲೊ, ಮೊಟ್ಟೊ ಮೊಡ್ ದಿಸ್ಲೊ, ತೆಚ್ಯಾ ಭೊತ್ಯಾನಿ ಲಕ್ಲಕೊ ಹೊಳಾವ್ಲೊ. ತ್ಯಾತುರುಚ್ ತ್ಯಾ ಆಗಿಚ್ಯಾ ಮದ್ದಿ ಸೊನ್ಯಾ ಸರ್ಕೊ ಉಜ್ವೊಡ್ ದಿಸ್ಲೊ. <verse eid="EZK 1:4" /><verse number="5" style="v" sid="EZK 1:5" />ತೆಚ್ಯಾ ಮದ್ನಾ ಜನಾವರಾಂಚ್ಯಾ ಸಾರ್ಕೆ ದಿಸ್ಲಿ, ತೆಂಚೊ ರುಪ್ ಮಾನ್ಸಾಚ್ಯಾ ರುಪಾ ಸಾರ್ಕೆ ಹೊತ್ತೆ. <verse eid="EZK 1:5" /><verse number="6" style="v" sid="EZK 1:6" />ಎಕೆಕಾಕ್ ಚಾ ಚಾರ್ ತೊಂಡಾ, ಚಾ ಚಾರ್ ರಕುಟೆ ಹೊತ್ತೆ. <verse eid="EZK 1:6" /><verse number="7" style="v" sid="EZK 1:7" />ಅನಿ ತೆಂಚಿ ಪಾಯಾ ನಿಟ್ಟ್ ಹೊವ್ನ್ ವಾಸ್ರಾಂಚ್ಯಾ ಗೆಳಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಹೊತ್ತಿ, ಅನಿ ತಿ ಉಜಳಲ್ಲ್ಯಾ ಪಿತ್ಳಿಚ್ಯಾ ಸಾರ್ಕೆ ಹೊಳ್ವುನ್ಗೆತ್ ಹೊತ್ತಿ. <verse eid="EZK 1:7" /><verse number="8" style="v" sid="EZK 1:8" />ಹರ್ ಎಕ್ ಜನಾವರಾಚ್ಯಾ ಚಾರಿ ಬಾಜುಚ್ಯಾ ರಕುಟ್ಯಾಂಚ್ಯಾ ಖಾಲ್ತಿ ಮಾನ್ಸಾಚ್ಯಾ ಹಾತಿಂಚ್ಯಾ ಸಾರ್ಕಿ ಹಾತಾ ಹೊತ್ತಿ; ತ್ಯಾ ಚಾರಿ ಜನಾವರಾಂಚಿ ತೊಂಡಾ ಅನಿ ರಕುಟೆ ಕಸೆ ಹೊತ್ತೆ ಮಟ್ಲ್ಯಾರ್, <verse eid="EZK 1:8" /><verse number="9" style="v" sid="EZK 1:9" />ತೆ ರಕುಟೆ ಎಕಾಮೆಕಾಕ್ ಲಾಗಿತ್; ಅನಿ ತಿ ಜನಾವರಾ ಫಿಡೆ ಜಾತಾನಾ ಪರ್ತಿನಸ್ತಾನಾ ಎಕುಚ್ ನಿಸಾನ್ ನಿಟ್ಟ್ ಜಾಯ್ತ್.<verse eid="EZK 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 1:10" />ತೆಂಚಿ ತೊಂಡಾ ಕಸಿ ಹೊತ್ತಿ ಮಟ್ಲ್ಯಾರ್, ಎಕ್ಲ್ಯಾಚೆ ತೊಂಡ್ ಮಾನ್ಸಾಂಚ್ಯಾ ತೊಂಡಾಂಚ್ಯಾ ಗತಿನ್ ಹೊತ್ತೆ, ಉಜ್ವ್ಯಾ ಭಾಜುಚೆ ತೊಂಡ್ ಸಿಂವಾಚ್ಯಾ ತೊಂಡಾ ಸಾರ್ಕೆ ಹೊತ್ತೆ, ಧಾವ್ಯಾ ಭಾಜುಚೆ ತೊಂಡ್ ಬಯ್ಲಾಚ್ಯಾ ತೊಂಡಾ ಸಾರ್ಕೆ ಹೊತ್ತೆ, ಅನಿ ಫಾಟ್ಲೆ ತೊಂಡ್ ಗರುಡಾಚ್ಯಾ ತೊಂಡಾ ಸಾರ್ಕೆ ಹೊತ್ತೆ. <verse eid="EZK 1:10" /><verse number="11" style="v" sid="EZK 1:11" />ತೆಂಚಿ ತೊಂಡಾ ಅಸಿ ಹೊತ್ತಿ. ರಕುಟೆ ವರ್‍ತಿ ಪಗಳಲ್ಲೆ ಹೊತ್ತೆ, ಅನಿ ತೆಂಚೆ ರಕುಟೆ ಎಗ್ಳೆ ಎಗ್ಳೆ ಹೊವ್ನ್, ಹರ್ ಎಕ್ ಜನಾವರಾಚೆ ದೊನಿ ರಕುಟೆ ತೆಂಚ್ಯಾ ಭಾಜುಚ್ಯಾ ಜನಾವರಾಂಚ್ಯಾ ರಕುಟ್ಯಾಕ್ನಿ ಲಾಗಿತ್. ಅನಿ ಹುರಲ್ಲ್ಯಾ ದೊನ್ ರಕುಟೆ ಅಪ್ನಾಚಿ ಆಂಗಾ ಧಾಪುನ್ ಘೆಟಲ್ಯಾನಿ. <verse eid="EZK 1:11" /><verse number="12" style="v" sid="EZK 1:12" />ತಿ ಸಗ್ಳಿ ಜನಾವರಾ ದೆವಾಚ್ಯಾ ಆತ್ಮ್ಯಾನ್ ಚಾಲ್ವಲ್ಯಾ ವಾಟೆನ್, ಎಕುಚ್ ನಿಸಾನ್ ಫಾಟಿ ಪರ್‍ತುನ್ ಬಗಿ ನಸ್ತಾನಾ ಫಿಡೆ ಗೆಲಿ.<verse eid="EZK 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 1:13" />ತ್ಯಾ ಜನಾವರಾಂಚ್ಯಾ ಮದ್ದಿ ಅಜಾಪಾಚೊ ಎಕ್ ಉಜ್ವೊಡ್ ಸಾರ್ಕೆ ಜಳ್ತಲೆ ಇಂಗ್ಳೆಕಿ, ಚುಡ್ಕಿ ಸಾರ್ಕೆ ದಿಸ್ಲೆ, ತೆ ಜನಾವರಾಚ್ಯಾ ಮದ್ದಿ ಫಿರುಲಾಗಲ್ಲೆ, ತಿ ಆಗ್ ಲೈ ಪೆಟುಲಾಗಲ್ಲಿ. ತೆಜ್ಯಾ ಭುತ್ತುರ್ನಾ ಲಕ್ಲಕೊ ಯೆಯ್. <verse eid="EZK 1:13" /><verse number="14" style="v" sid="EZK 1:14" />ತಿ ಜನಾವರಾ ಲಕ್ಲಕ್ಯಾಚ್ಯಾ ಉಜ್ವೊಡಾ ಸಾರ್ಕೆ ಫಾಟಿ, ಫಿಡೆ ಸರ್ದುನ್ ಘೆತ್ ಹೊತ್ತಿ.<verse eid="EZK 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 1:15" />ಅಬಕ್, ಮಿಯಾ ತ್ಯಾ ಜನಾವರಾಕ್ನಿ ಬಗಿತ್ ರ್‍ಹಾತಾನಾ, ಹರ್ ಎಕ್ ಭಾಜುಕ್ಬಿ ಜನಾವರಾಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ಜಿಮ್ನಿ ವರ್‍ತಿ ಎಕ್ ಚಕ್ಕರ್ ದಿಸ್ಲೆ. <verse eid="EZK 1:15" /><verse number="16" style="v" sid="EZK 1:16" />ತ್ಯಾ ಚಕ್ರಾಂಚೊ ರಂಗ್ ಅನಿ ರಚನ್ ಕಸೆ ಹೊತ್ತೆ ಮಟ್ಲ್ಯಾರ್, ತೆಂಚೆ ರಂಗ್ ನಿತಳ್ ಗುಂಡ್ಯಾಚ್ಯಾ ಗತಿನ್ ಫಳ್ಪಳುಕ್ ಲಾಗಲ್ಲೆ, ಎಕ್ ಚಕ್ಕರಾತ್ ಅನಿ ಎಕ್ ಚಕ್ಕರ್ ಆಡ್ವೆ ಕರುನ್ ರಚಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಹೊತ್ತೆ, ತಿ ಚಾರಿ ಚಕ್ಕರಾಬಿ ಎಕುಚ್ ನಮುನಿ ಹೊತ್ತಿ. <verse eid="EZK 1:16" /><verse number="17" style="v" sid="EZK 1:17" />ತಿ ಚಲಸ್ತಾನಾ ಚಾರ್ ಭಾಜುತ್ನಿ ಖಲ್ಯಾ ಭಾಜುಕ್ ಹೊಲ್ಯಾರ್ಬಿ ಫಿರಿತ್, ಖರೆ ವ್ಹಾಂಕ್ಡಿ ಫಿರಿ ನಸಿತ್. <verse eid="EZK 1:17" /><verse number="18" style="v" sid="EZK 1:18" />ಚಕ್ಕರಾಂಚ್ಯಾ ಭೊತ್ಯಾನ್ ಸಗ್ಳಿ ಭಾಗಾ ಉಪ್ಪರ್ ಅನಿ ಭಯಾನಕ್ ಹೊವ್ನ್ ಹೊತ್ತಿ; ಹ್ಯಾ ಭಾಗಾಂಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಕಡೆಕ್ಬಿ ಭರುನ್ ಡೊಳೆ ಹೊತ್ತೆ. <verse eid="EZK 1:18" /><verse number="19" style="v" sid="EZK 1:19" />ಜನಾವರಾ ಫಿಡೆ ಜಾತಾನಾ ಸಗ್ಳಿ ಚಕ್ಕರಾ ತೆಚ್ಯಾ ಭಾಜುಕ್ನಾ ಫಿಡೆ ಜಾಯ್ತ್; ತಿ ಜನಾವರಾ ಜಿಮ್ನಿಕ್ನಾ ವರ್‍ತಿ ಉಟ್ತಾನಾ ಚಕ್ಕರಾಬಿ ವರ್‍ತಿ ಉಟಿತ್. <verse eid="EZK 1:19" /><verse number="20" style="v" sid="EZK 1:20" />ದೆವಾಚ್ಯಾ ಆತ್ಮ್ಯಾನ್ ಚಲ್ವುತಲ್ಯಾಕ್ಡೆ ತಿ ಚಲ್ಲಿ, ತ್ಯಾ ಜನಾವರಾಂಚೊ ಆತ್ಮೊ ಚಕ್ಕರಾಂಚ್ಯಾ ಭುತ್ತುರ್ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ಚಕ್ಕರಾಬಿ ತೆಂಚ್ಯಾ ಭಾಜುಕ್ನಾ ವಾಂಗ್ಡಾಚ್ ಉಟಿತ್. <verse eid="EZK 1:20" /><verse number="21" style="v" sid="EZK 1:21" />ತಿ ಫಿಡೆ ಜಾತಾನಾ ಹಿಬಿ ಫಿಡೆ ಜಾಯ್ತ್, ತಿ ಇಬೆ ರ್‍ಹಾತಾನಾ ಹಿಬಿ ಇಬೆ ರಾಯ್ತ್, ತಿ ಜಿಮ್ನಿ ವಯ್ನಾ ಉಟ್ತಾನಾ, ಚಕ್ಕರಾಬಿ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಉಟಿತ್; ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಜನಾವರಾಂಚೊ ಆತ್ಮೊ ಚಕ್ಕರ್‍ಹಾತ್ನಿಬಿ ಹೊತ್ತೊ.<verse eid="EZK 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 1:22" />ತ್ಯಾ ಜನಾವರಾಂಚ್ಯಾ ಟಕ್ಲ್ಯಾ ವರ್‍ತಿ ಲೈ ಭಯಾನಕ್ ಹೊಳಾವ್ತಲ್ಯಾ ಭರ್‍ಪಾಚ್ಯಾ ಗಡ್ಡ್ಯಾ ಗತಿನ್ ಮಳಬ್ ಸಾರ್ಕೆ ಪಗಳಲ್ಲೆ ಹೊತ್ತೆ. <verse eid="EZK 1:22" /><verse number="23" style="v" sid="EZK 1:23" />ತೆಚ್ಯಾ ಖಾಲ್ತಿ ಜನಾವರಾಂಚೆ ರಕುಟೆ ನಿಟ್ಟ್ ಪಗ್ಳುನ್ ಎಕಾಮೆಕಾಕ್ ಲಾಗಿತ್; ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಹರ್ ಎಕ್ ಜನಾವರಾಕ್ ಆಂಗ್ ಧಾಪುನ್ ಘೆತಲೆ ದೊನ್ ರಕುಟೆ ಹೊತ್ತೆ. <verse eid="EZK 1:23" /><verse number="24" style="v" sid="EZK 1:24" />ತೆ ಫಿಡೆ ಜಾತಾನಾ ತೆಂಚ್ಯಾ ರಕುಟ್ಯಾಂಚೊ ಆವಾಜ್ ಪಾನಿಯಾಚ್ಯಾ ಮೊಟ್ಟ್ಯಾ ಹಂವಾರ್ಯಾಚ್ಯಾ ಆವಾಜಾಚ್ಯಾ ಸಾರ್ಕೆ, ಅನಿ ಸಗ್ಳೆ ಕರುಕ್ ಶಕ್ತ್ ಹೊತ್ತ್ಯಾಚ್ಯಾ ಧನಾ ಸಾರ್ಕೆ, ಅನಿ ಆರ್ಬಾಟ್ ಕರ್‍ತಲ್ಯಾ ಸಯ್ನಿಕಾಂಚ್ಯಾ ಬೊಬೆ ಸಾರ್ಕೆ ಮಾಕಾ ಆಯ್ಕಲೆ, ಅನಿ ಇಬೆ ರ್‍ಹಾತಾನಾ ರಕುಟೆ ಮುದ್ದಾ ಕರುನ್ ಘೆಯ್ತ್. <verse eid="EZK 1:24" /><verse number="25" style="v" sid="EZK 1:25" />ತೆಂಚ್ಯಾ ಟಕ್ಲ್ಯಾಂಚ್ಯಾ ವಯ್ಲ್ಯಾ ಮಳ್ಬಾಚ್ಯಾ ವಯ್ನಾ ಎಕ್ ಧನ್ ಮಾಜ್ಯಾ ಕಾನಾತ್ ಪಡ್ಲಿ, ಜನಾವರಾ ಇಬೆ ರ್‍ಹಾತಾನಾ ರಕುಟೆ ಮುದ್ದಾ ಕರುನ್ ಘೆಯ್ತ್.<verse eid="EZK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 1:26" />ತೆಂಚ್ಯಾ ಟಕ್ಲ್ಯಾಚ್ಯಾ ವಯ್ಲ್ಯಾ ಮಳ್ಬಾಚ್ಯಾ ವರ್‍ತಿ ನಿಳೆ ಕಿಮ್ತಿಚ್ಯಾ ಫೊಡ್ಯಾಚ್ಯಾ ಸಾರ್ಕೆ ಹೊಳ್ವುತಲ್ಯಾ ಸಿಂವಾಸನಾಚೊ ಆಕಾರ್ ದಿಸ್ಲೊ, ತೆಚ್ಯಾ ವರ್‍ತಿ ಮಾನ್ಸಾಚ್ಯಾ ರುಪಾಚೊ ಎಕ್ಲೊ ಬಸಲ್ಲೊ ಹೊತ್ತೊ. <verse eid="EZK 1:26" /><verse number="27" style="v" sid="EZK 1:27" />ಕಂಬರ್ ಗತಿನ್ ದಿಸ್ತಲ್ಯಾ ತೆಜ್ಯಾ ಮದ್ಲ್ಯಾ ಭಾಗಾಕ್ನಾ ವರ್‍ತಿ ಸೊನೆ ಫಳ್ಪಳ್ತಾಕಿ, ತ್ಯಾ ಸಗ್ಳ್ಯಾ ರುಪಾತ್ ಪೆಟ್ತಲ್ಯಾ ಆಗಿ ಸಾರ್ಕೆ ಆಜಾಪಾಚಿ ಹೊಳ್ವಾಪ್ ಬಗಟ್ಲೊ, ಕಂಬರ್ ಗತಿನ್ ದಿಸ್ತಲ್ಯಾ ತೆಜ್ಯಾ ಮದ್ಲ್ಯಾ ಭಾಗಾಚ್ಯಾ ಖಾಲ್ತಿ ಆಗ್ ಪೆಟುಲ್ಲಾ ಕಾಯ್ಕಿ ಮನಿ ಸಾರ್ಕೆ ಮೊಟೆ ಉಜ್ವೊಡ್ ಬಗಟ್ಲೊ, ಅನಿ ತೆಜ್ಯಾ ಭೊತ್ಯಾನಿ ಉಜ್ವೊಡ್ ಹೊತ್ತೊ. <verse eid="EZK 1:27" /><verse number="28" style="v" sid="EZK 1:28" />ಪಾವ್ಸಾಳಾತ್ ಮಳ್ಬಾತ್ ಕಾಮನ್ ಬಿಲ್ಲ್ ಹೊಳಾವಲ್ಲ್ಯಾ ಗತಿನ್ ತೆಜ್ಯಾ ಭೊತ್ಯಾನಿ ಉಜ್ವೊಡ್ ಹೊಳ್ವುಲಾಗಲ್ಲೊ, ಅಸೆ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಮಹಿಮಾಚೊ ಅನಿ ಅಜಾಪಾಚೊ ದರ್ಶನ್ ಮಾಕಾ ದಿಸ್ಲೊ.</para>
  <para style="s" vid="EZK 1:28">ಎಜ್ಕೆಲಾಕ್ ದೆವಾನ್ ಪರ್ವಾದಿ ಹೊವ್ಕ್ ಬಲ್ವಲ್ಲೆ</para>
  <para style="p" vid="EZK 1:28">ಮಿಯಾ ಹೆ ಬಗಟಲ್ಲ್ಯಾ ತನ್ನಾ ಡಬ್ಬ್ ಪಡುನ್ ಎಕ್ಲೊ ಬೊಲ್ತಲೊ ಧನ್ ಆಯಿಕ್ಲೊ.<verse eid="EZK 1:28" /></para>
  <chapter eid="EZK 1" />
  <chapter number="2" style="c" sid="EZK 2" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 2:1" />ತೆನಿ ಮಾಕಾ ಸಾಂಗಟಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್; “ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಉಟುನ್ ಇಬೆ ರಾ; ಮಿಯಾ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ತಾ”. <verse eid="EZK 2:1" /><verse number="2" style="v" sid="EZK 2:2" />ತೆನಿ ಹಿ ಬೊಲ್ನೆ ಸಾಂಗ್ತಾನಾ, ಮಾಜ್ಯಾ ಭುತ್ತುರ್ ದೆವಾಚೊ ಆತ್ಮೊ ಗುಸುನ್, ಮಿಯಾ ಉಟುನ್ ಇಬೆ ರಾಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್, ತನ್ನಾ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲಲ್ಯಾಚಿ ಬೊಲ್ನೆ ಆಯಿಕ್ಲೊ. <verse eid="EZK 2:2" /><verse number="3" style="v" sid="EZK 2:3" />ತೆನಿ ಮಾಕಾ ಅಸೆ ಸಾಂಗ್ಲ್ಯಾನ್, “ನರ್ ಮಾನ್ಸಾ, ಮಾಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಉಟುನ್ ಮಾಕಾ ವಿರೊಧ್ ಕರಲ್ಯಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ಮಿಯಾ ತುಕಾ ದಾಡ್ತಾ”. ಅಜುನ್ಬಿ ತೆನಿ ಅನಿ ತೆಂಚಿ ಪುರ್ವಜಾ ಮಾಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಧಂಗೊ ಉಟ್ತಲಿ ಲೊಕಾ ಹೊವ್ನ್ ಹಾತ್, <verse eid="EZK 2:3" /><verse number="4" style="v" sid="EZK 2:4" />ಮಿಯಾ ತುಕಾ ಖಲ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾಕ್ಡೆ ಧಾಡ್ತಾ, ತ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ ಹಟಿ ಅನಿ ಮರ್ಯಾದ್ಗೆಡಿ ಹೊವ್ನ್ ಹಾತ್; ತಿಯಾ ತೆಂಕಾ ಸಾಂಗ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, <verse eid="EZK 2:4" /><verse number="5" style="v" sid="EZK 2:5" />“ತೆನಿ ಧಂಗೊಕಾರಾ, ಆಯ್ಕುಂದಿತ್ ನಾ ಆಯ್ಕಿ ನಸ್ತಾನಾ ರಾಂವ್ದಿತ್. ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೆನಿ ವಿರೊಧ್ ಕರ್‍ತಲ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ, ಖರೆ ಎಕ್ ಪರ್ವಾದಿ ಅಪ್ನಾಚ್ಯಾ ಮದ್ದಿ ಹಾಯ್ ಮನುನ್ ತೆನಿ ಕಳ್ವುನ್ ಘೆತಾತ್”.<verse eid="EZK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 2:6" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಕಾಟ್ಯಾಂಚ್ಯಾ ಝಿಳಿಯಾತ್ನಿ ಗಾವ್ನ್ ಪಡುನ್, ಇಂಚುವಾಂಚ್ಯಾ ಮದ್ದಿ ವಸ್ತಿ ರಾಯ್ ಸಾರ್ಕೆ ತೆಂಚ್ಯಾ ಮದ್ದಿ ರಾಲ್ಯಾರ್ಬಿ ತೆಕಾ ಭಿಂವ್ ನಕ್ಕೊ, ತೆನಿ ಧಂಗೊ ಕರ್‍ತಲ್ಯಾ ಪಿಳ್ಗಿಚೆ, ತೆಂಚ್ಯಾ ಭಿರುಸ್ ಬೊಲ್ನ್ಯಾಕ್ನಿ ಭಿಂವ್ ನಕ್ಕೊ ತೆಂಚ್ಯಾ ಡೊಳೆಕಾಡ್ನ್ಯಾಕ್ ಭಿಂವ್ ನಕ್ಕೊ. <verse eid="EZK 2:6" /><verse number="7" style="v" sid="EZK 2:7" />ತೆನಿ ಆಯ್ಕಲ್ಯಾರ್ಬಿ ಆಯ್ಕಿ ನಸ್ತಾನಾ ಗೆಲ್ಯಾರ್ಬಿ ತಿಯಾ ಮಾಜೆ ಬೊಲ್ನೆ ತೆಂಕಾ ಸಾಂಗುಚೆ, ತೆನಿ ಖರೆಬಿ ಧಂಗೊ ಕಾರಾಚ್.<verse eid="EZK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 2:8" />“ಖರೆ ನರ್ ಮಾನ್ಸಾ, ಮಿಯಾ ಸಾಂಗ್ತಲಿ ಬೊಲ್ನೆ ಆಯ್ಕ್; ಮಾನ್ ದಿವ್ನ್ ಚಲಿ ನಸಲ್ಲ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ಸಾರ್ಕೆ ತಿಯಾ ಮಾನ್ ನಸ್ತಾನಾ ರಾವ್ ನಕ್ಕೊ; ತುಜೆ ತೊಂಡ್ ಉಗಡ್ ಅನಿ ಮಿಯಾ ದಿತಲೆ ಖಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EZK 2:8" /><verse number="9" style="v" sid="EZK 2:9" />ಅಸೆ, ಮಿಯಾ ಬಗಿತ್ ರ್‍ಹಾತಾನಾ ಎಕ್ ಹಾತ್ ಮಾಜ್ಯಾಕ್ಡೆ ಫಿಡ್ಯಾತ್ ಯೆತಲೊ ಬಗಟ್ಲೊ, ಅನಿ ತ್ಯಾತುರ್ ಎಕ್ ಪುಸ್ತಕಾಚಿ ಸುರ್ಳಿ ಹೊತ್ತಿ, <verse eid="EZK 2:9" /><verse number="10" style="v" sid="EZK 2:10" />ತೆನಿ ಮಾಜ್ಯಾ ಇದ್ರಾಕುಚ್ ಸುರ್ಳಿ ತಿ ಉಗಡ್ಲ್ಯಾನ್, ತ್ಯಾತುರ್ ದೊನ್ ಭಾಜುನ್ಬಿ ರೊದಾನ್, ಇಪ್ಳಾಪ್, ದುಕ್ಕಾಚಿ ಬೊಬ್, ನರ್ಳಾಪ್, ಮನುನ್ ಹೆ ತ್ಯಾತುರ್ ಲಿವಲ್ಲೆ ಹೊತ್ತೆ.<verse eid="EZK 2:10" /></para>
  <chapter eid="EZK 2" />
  <chapter number="3" style="c" sid="EZK 3" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 3:1" />ತೆನಿ ಮಾಕಾ ಮಟ್ಲ್ಯಾನ್; “ನರ್ ಮಾನ್ಸಾ, ತುಕಾ ಗಾವಲ್ಲೆ ತಿ ಸುರ್ಳಿ ಕಳ್ವುನ್ ಘೆ; ತಿಯಾ ಜಾವ್ನ್ ತ್ಯಾತುರ್ ಹೊತ್ತಿ ಸಂಗ್ತಿಯಾ ಸಗ್ಳಿ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಸಾಂಗ್”.<verse eid="EZK 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 3:2" />ತನ್ನಾ ಮಿಯಾ ತೊಂಡ್ ಉಗಡಲ್ಲೊ, ತೆನಿ ತಿ ಸುರ್ಳಿ ಖಾವಸ್ಲ್ಯಾನ್. <verse eid="EZK 3:2" /><verse number="3" style="v" sid="EZK 3:3" />ತನ್ನಾ ತೆನಿ ಮಟ್ಲ್ಯಾನ್; ನರ್ ಮಾನ್ಸಾ, ಮಿಯಾ ತುಕಾ ದಿಲ್ಲಿ ಹಿ ಸುರ್ಳಿ ಖಾವ್ನ್ ಪೊಟ್ ಭರುನ್ ಘೆ, ಮನ್ತಾನಾ ತಿ ಸುಳಿ ಮಿಯಾ ಖಾಲೊ. ತೆಚಿ ರುಚ್ ಮ್ಹಾವಾಚ್ಯಾ ಸಾರ್ಕೆ ಗೊಡ್ ಹೊತ್ತೆ.<verse eid="EZK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 3:4" />ಮಾನಾಸರ್ ತೆನಿ ಮಾಕಾ ಅಸಿ ಸಾಂಗಟ್ಲ್ಯಾನ್, “ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾ ಲೊಕಾಚ್ಯಾಕ್ಡೆ ಜಾವ್ನ್ ಮಿಯಾ ಸಾಂಗಟಲ್ಲಿ ಬೊಲ್ನೆ ತೆಂಕಾ ಸಾಂಗ್”. <verse eid="EZK 3:4" /><verse number="5" style="v" sid="EZK 3:5" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಮಿಯಾ ತುಕಾ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ಡೆ ಧಾಡ್ತಾ, ಖರೆ, ತರಾಸ್ ಹೊತ್ತ್ಯಾ ದುಸ್ರ್ಯಾ ಭಾಶ್ಯಾಕ್ಡೆ ತುಕಾ ಧಾಡಿನಾ. <verse eid="EZK 3:5" /><verse number="6" style="v" sid="EZK 3:6" />ತುಕಾ ಕಳಿನಸಲ್ಯಾ ತರಾಸ್ ಹೊತ್ತ್ಯಾ ದುಸ್ರ್ಯಾ ಭಾಶ್ಯಾ ಬೊಲ್ತಲ್ಯಾಂಚ್ಯಾಕ್ಡೆ ಅನಿ ದುಸ್ರ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ಡೆ ತುಕಾ ಧಾಡುನ್ ದಿನಾ, ಅಸ್ಲ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ಡೆ ತುಕಾ ಧಾಡಲ್ಲೆ ರಾಲ್ಯಾರ್ ತೆನಿ ಖರೆಚ್ ತುಜೆ ಬೊಲ್ನೆ ಆಯ್ಕಿ ಹೊತ್ತ್ಯಾನಿ. <verse eid="EZK 3:6" /><verse number="7" style="v" sid="EZK 3:7" />ಖರೆ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಪಿಳ್ಗಿತ್ ತುಕಾ ಆಯ್ಕುಕ್ ತಯಾರ್ ನಾತ್; ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತೆನಿ ಮಾಕಾ ಆಯ್ಕುಕ್ ತಯಾರ್ ನಾತ್; ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತೆನಿ ಹಟಿ ಮನಾಚೆ, ಅನಿ ಮರ್ಯಾದ್ ನತ್ತೆ ಹೊವ್ನ್ ಹಾತ್. <verse eid="EZK 3:7" /><verse number="8" style="v" sid="EZK 3:8" />ಅಬಕ್, ತೆಂಚ್ಯಾ ತೊಂಡಾಕ್ ಲಾಗುನ್ ತುಜೆ ತೊಂಡ್ಬಿ ಕರ್ಲಾ; ಅನಿ ತೆಂಚ್ಯಾ ಕಪ್ಳಾಕ್ ಲಾಗುನ್ ತುಜೆ ಕಪಾಳ್ಬಿ ಘಟ್ ಕರುನ್ ಥವ್ಲಾ. <verse eid="EZK 3:8" /><verse number="9" style="v" sid="EZK 3:9" />ಅನಿ ತುಜೆ ಮನ್ ಘಟ್ಲ್ಯಾ ಗುಂಡ್ಯಾಕಿಂತಾ ವಜ್ರಾಚ್ಯಾ ಸಾರ್ಕೆ ಘಟ್ ಕರುನ್ ಥವ್ಲಾ; ತೆಂಕಾ ಭ್ಹಿಯಾತಲೆ ನಾ, ತೆಂಚ್ಯಾ ಡೊಳೆ ಕಾಡ್ನ್ಯಾಕ್ ಘಾಬ್ರುನುಕ್ಕೊ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತೆನಿ ಧಂಗೊ ಕರ್‍ತಲ್ಯಾ ಪಿಳ್ಗಿಚೆ.<verse eid="EZK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 3:10" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ; ನರ್ ಮಾನ್ಸಾ, ಮಿಯಾ ತುಕಾ ಸಾಂಗಲ್ಲಿ ಗೊಸ್ಟಿಯಾ ತಿಯಾ ಕಾನಾನಿ ಆಯ್ಕುನ್, ಮನಾತ್ ಥವ್ನ್ ಘೆ. <verse eid="EZK 3:10" /><verse number="11" style="v" sid="EZK 3:11" />ಅನಿ ಬಂಧಿ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ತುಜ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ಡೆ ಜಾ, ತೆನಿ ಆಯ್ಕುಂದಿತ್ ನಾತರ್ ಆಯ್ಕಿನಸ್ತಾನಾ ಜಾವುಂದಿತ್, ತೆಂಕಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಸೆ ಸಾಂಗಟ್ಲಾ ಮನುನ್ ಸಾಂಗ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="EZK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 3:12" />ಮಾನಾ ದೆವಾಚ್ಯಾ ಆತ್ಮ್ಯಾನ್ ಮಾಕಾ ವರ್‍ತಿ ಉಕ್ಲುನ್ ಘೆವ್ನ್ ಗೆಲ್ಲ್ಯಾ ತನ್ನಾ, ಮಹಿಮಾನ್ ಭರಲ್ಯಾ ದೆವಾಕ್ ತೆಜ್ಯಾ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾ ಜಾಗ್ಯಾತ್ ಸ್ತುತಿ ಹೊಂವ್ದಿತ್, ಮನ್ತಲಿ ಮೊಟ್ಟ್ಯಾ ಧನಾಚಿ ಘಜ್ನಿ ಮಾಜ್ಯಾ ಫಾಟ್ನಾ ಆಯ್ಕೊ ಯೊಲೊ. <verse eid="EZK 3:12" /><verse number="13" style="v" sid="EZK 3:13" />ಅನಿ ತ್ಯಾ ಜಿವ್ದಾನಾಂಚೆ ರಕುಟೆ ಎಕಾಕ್ ಎಕ್ ಅದಳ್ತಲೊ ಆವಾಜ್, ಅನಿ ತೆಂಚ್ಯಾ ಆಜು ಭಾಜುಕ್ ಗರ ಗರಾನ್ ಫಿರ್ತಲೊ ಚಕ್ರಾಂಚೊ ಅವಾಜ್ ಭುಕಂಪಾ ಸಾರ್ಕೊ ಮೊಟೊ ಅವಾಜ್ ಮಾಕಾ ಆಯ್ಕೊ ಯೆಲೊ. <verse eid="EZK 3:13" /><verse number="14" style="v" sid="EZK 3:14" />ತನ್ನಾ ದೆವಾಚ್ಯಾ ಆತ್ಮ್ಯಾನ್ ಮಾಕಾ ವರ್‍ತಿ ಉಕ್ಲುನ್ ದುರ್ ಘೆವ್ನ್ ಗೆಲ್ಯಾನ್. ಮಿಯಾ ಚಿಂತಾ ಕರುನ್ ಘೆವ್ನ್ ದುಕ್ಕೆನ್ ಗೆಲೊ, ಖರೆ ಸರ್ವೆಸ್ಪರಾಚೊ ತಾಕ್ತಿಚೊ ಹಾತ್ ಮಾಜ್ಯಾ ವರ್‍ತಿ ಹೊತ್ತೊ. <verse eid="EZK 3:14" /><verse number="15" style="v" sid="EZK 3:15" />ಮಾನಾ ಬಂಧಿಕರುನ್ ಘೆವ್ನ್ ಗೆಲ್ಲ್ಯಾ ಕೆಬಾರ್ ನ್ಹಯ್ಚ್ಯಾ ಜಗ್ಗೊಳ್ ಹೊತ್ತ್ಯಾ ತೆಲ್ ಅಬಿಬಾತಾತ್ ವಸ್ತಿ ಹೊತ್ಯಾಂಚ್ಯಾಕ್ಡೆ ಜಾವ್ನ್ ತೆನಿ ಬಸಲ್ಲ್ಯಾ ಜಾಗ್ಯಾರ್ ಹಾಲಿ ನಸ್ತಾನಾ ಬಸುನ್ ಘೆಟ್ಲೊ; ಮಾನಾ ಸತ್ತ್ ದಿಸಾ ಸಗೊಳ್ ತೆಂಚ್ಯಾ ಮದ್ದಿ ಮಿಯಾ ರಾಲೊ.<verse eid="EZK 3:15" /></para>
  <para style="s">ದೆವಾನ್ ಎಜ್ಕೆಲಾಕ್ ರಾಕ್ವನ್ ಕಾರ್ ಕರುನ್ ನೆಮಲ್ಲೆ</para>
  <para style="r">
    <ref loc="EZK 33:1">33:1</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 3:16" />ಸಾತ್ ದಿಸಾ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಹಿ ಗೊಸ್ಟ್ ಸಾಂಗಲ್ಯಾನ್, <verse eid="EZK 3:16" /><verse number="17" style="v" sid="EZK 3:17" />“ನರ್ ಮಾನ್ಸಾ, ಮಿಯಾ ತುಕಾ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಂಚ್ಯಾ ವರ್‍ತಿ ರಾಕನ್ದಾರ್ ಹೊವ್ನ್ ನೆಮಸ್ಲಾ. ಅಸಿ ರ್‍ಹಾತಾನಾ ಮಾಜ್ಯಾ ತೊಂಡಾನ್ ಯೆತಲಿ ಗೊಸ್ಟಿಯಾ ಆಯ್ಕುನ್ ಮಾಜ್ಯಾಕ್ನಾ ತೆಂಕಾ ಹುರ್ಶಾಕಿ ದಿ”. <verse eid="EZK 3:17" /><verse number="18" style="v" sid="EZK 3:18" />ಮಿಯಾ ಬುರ್ಸ್ಯಾ ಮಾನ್ಸಾಕ್ “ತಿಯಾ ಖರೆಚ್ ಮರುನುಚ್ ಜಾತಯ್” ಮನುನ್ ಸಾಂಗ್ತಾನಾ, ತಿಯಾ ತೆಕಾ ಹುರ್ಶಾಕಿ ದಿಸ್ತಾನಾ, ತೊ ಕರ್ತಲಿ ಬುರ್ಶಿ ಕಾಮಾ ಸೊಡುನ್ ಅಪ್ನಾಚೊ ಜಿವ್ ಹುರ್ವುನ್ ಘೆವ್ಚೆ ಮನುನ್ ತಿಯಾ ತೆಕಾ ಬುದ್ದ್ ಸಾಂಗಿ ನಸ್ತಾನಾ ರಾಲ್ಯಾರ್, ತೊ ದುಸ್ಟ್ ಅಪ್ನಾಚ್ಯಾ ಚುಕೆಚ್ಯಾ ವಯ್ನಾ ಮರುಕುಚ್ ಪಾಜೆ; ತೆಚ್ಯಾ ಮರ್ನಾಕ್ ತಿಯಾಚ್ ಕಾರನ್ ಹೊತೆಯ್. <verse eid="EZK 3:18" /><verse number="19" style="v" sid="EZK 3:19" />ತಿಯಾ ತ್ಯಾ ಬುರ್ಸ್ಯಾ ಮಾನ್ಸಾಕ್ ಹುರ್ಶಾಕಿ ದಿವ್ನ್ ಬಿ ತೊ ಮಾನುಸ್ ಅಪ್ನಾಚಿ ಬುರ್ಶಿ ಕಾಮಾ ಸೊಡಿ ನಸ್ತಾನಾ ರಾಲ್ಯಾರ್, ತೆಚ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾ ವಯ್ನಾ ಮರುನ್ ಜಾತಾ; ಅನಿ ತಿಯಾ ತುಜೊ ಜಿವ್ ಹುರ್ವುನ್ ಘೆತೆಯ್.<verse eid="EZK 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 3:20" />ಅಸಿ ರ್‍ಹಾತಾನಾ ನಿತಿವಂತ್ ಮಾನುಸ್ ತೆಚೆ ಬರೆ ಪಾನ್ ಸೊಡುನ್ ವಾಯ್ಟ್ ಕರುನ್ ಮಿಯಾ ತೆಕಾ ತರಾಸಾಚೊ ಸಂಕಟ್ ದಿತಾ, ತ್ಯಾ ಅಪಾಯಾತ್ ಅದ್ಳುನ್ ಪಡ್ಲೊ ತರ್ ಮರುನ್ ಜಾತಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತಿಯಾ ತೆಕಾ ಹುರ್ಶಾಕಿ ದಿನಸಲ್ಯಾ ಕಾರನಾ ವಯ್ನಾ ತೊ ತೆಚ್ಯಾ ಪಾಪಾಚ್ಯಾ ಸಾಟ್ನಿ ಮರುಚೆ ಪಡ್ಲೆ. ಖರೆ ತೆನಿ ಕರಲ್ಲೆ ಬರಿ ಕಾಮಾ ಸಗ್ಳಿ ತೆಚ್ಯಾ ಮೆಜ್ನಿತ್ ಯೆಯ್ನಾತ್; ಖರೆ ತೆಚ್ಯಾ ಮರ್ನಾಕ್ ತಿಯಾಚ್ ಕಾರನ್ ಹೊತೆಯ್. <verse eid="EZK 3:20" /><verse number="21" style="v" sid="EZK 3:21" />ತಿಯಾ ಬರ್ಯಾ ಮಾನ್ಸಾಕ್ ಪಾಪ್ ಕರಿನಾ ಸಾರ್ಕೆ ಹುರ್ಶಾಕಿ ದಿಲ್ಲ್ಯಾ ಮಾನಾ ತೊ ಪಾಪ್ ಕರಿನಸ್ತಾನಾ ರ್‍ಹಾವ್ನ್ ತೊ ಮರಿ ನಸ್ತಾನಾ ರ್‍ಹಾತಾ; ಅನಿ ತುಜೊಬಿ ಜಿವ್ ಹುರ್ತಾ.<verse eid="EZK 3:21" /></para>
  <para style="s">ಎಜ್ಕೆಲಾಚೆ ತೊಂಡ್ ಬಂದ್ ಹೊತಲೆ</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 3:22" />ತನ್ನಾ ತ್ಯಾ ಜಾಗ್ಯಾರ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚೊ ಹಾತ್ ಮಾಜ್ಯಾ ವರ್‍ತಿ ಹೊತ್ತೊ, ತೆನಿ ಮಾಕಾ ಸಾಂಗಟ್ಲ್ಯಾನ್ ತಿಯಾ ಉಟುನ್ ಮ್ಹಾಳ್ ಜಾಗ್ಯಾಕ್ ಜಾ, ಅನಿ ಮಿಯಾ ಥೈ ತುಜ್ಯಾಕ್ಡೆ ಬೊಲ್ತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="EZK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 3:23" />ತನ್ನಾ ಮಿಯಾ ಉಟುನ್ ಮ್ಹಾಳ್ ಜಾಗ್ಯಾರ್ ಗೆಲೊ, ಕೆಬಾರ್ ನ್ಹಯ್ಚ್ಯಾ ಜಗ್ಗೊಳ್ ಮಾಕಾ ಮಹಿಮಾಚೊ ಅದ್ಬುತ್ ದರ್ಶನ್ ಹೊಲ್ಲ್ಯಾ ಸಾರ್ಕೆ, ಥೈಬಿ ಸರ್ವೆಸ್ಪರಾಚೊ ಮಹಿಮಾಚೊ ದರ್ಶನ್ ಇದ್ರಾಕ್ ದಿಸ್ಲೊ. ತೆ ಬಗುನ್ ಡಬ್ಬ್ ಪಡ್ಲೊ. <verse eid="EZK 3:23" /><verse number="24" style="v" sid="EZK 3:24" />ಖರೆ ದೆವಾಚೊ ಆತ್ಮೊ ಮಾಜ್ಯಾ ಭುತ್ತುರ್ ಎವ್ನ್ ಮಿಯಾ ಉಟುನ್ ಇಬೆ ರಾಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್, ತನ್ನಾ ತೆನಿ ಮಾಕಾ ಬೊಲುನ್ ಸಾಂಗಟಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ತಿಯಾ ಜಾವ್ನ್ ಘರ್‍ಹಾತ್ ನಿಪ್. <verse eid="EZK 3:24" /><verse number="25" style="v" sid="EZK 3:25" />ಅನಿ ನರ್ ಮಾನ್ಸಾ, ತುಜಿ ಸ್ವತಾಚಿ ಲೊಕಾ ತುಕಾ ಬಂಧಿಕರುನ್ ಭಾಂದ್ತ್ಯಾತ್ ತನ್ನಾ ಲೊಕಾಂಚ್ಯಾ ಫಿಡ್ಯಾತ್ ಜಾವ್ಕ್ ಹೊಯ್ನಾ, <verse eid="EZK 3:25" /><verse number="26" style="v" sid="EZK 3:26" />ಅಸಿ ರ್‍ಹಾತಾನಾ ಮಿಯಾ ತುಜಿ ಜಿಬಿಲ್ ಘಟ್ ಹೊವ್ನ್ ಮುಕ್ಕೊ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ; ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೆನಿ ಧಂಗೊ ಉಟ್ವುತಲ್ಯಾ ಪಿಳ್ಗಿಚೆ ಲೊಕಾ ಹೊಲ್ಲಿ ಹಾತ್, ತನ್ನಾ ತಿಯಾ ತೆಂಕಾ ಕಾಯ್ಬಿ ಸಾಂಗುಕ್ ಹೊಯ್ನಾ. <verse eid="EZK 3:26" /><verse number="27" style="v" sid="EZK 3:27" />ಮಿಯಾ ತುಜ್ಯಾಕ್ನಾ ಕನ್ನಾ ಬೊಲ್ತಾ ತನ್ನಾ ಮಿಯಾ ತುಜೆ ತೊಂಡ್ ಉಗಡ್ತಾ; ತನ್ನಾ ತಿಯಾ ತೆಂಕಾ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸಿ ಸಾಂಗುಕ್ ಲಾಗ್ಲಾ ಮನುನ್ ಸಾಂಗುಚೆ. ಆಯಿಕ್ತಲೊ ಆಯ್ಕುಂದಿತ್, ನಾತರ್ ಆಯ್ಕಿ ನಸಲ್ಲೊ ಆಯ್ಕಿ ನಸ್ತಾನಾ ಜಾವುಂದಿತ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತೆನಿ ಪರ್‍ತುನ್ ಪಡ್ತಲ್ಯಾ ಘರಾನಾಚೆ.<verse eid="EZK 3:27" /></para>
  <chapter eid="EZK 3" />
  <chapter number="4" style="c" sid="EZK 4" />
  <para style="s">ಎಜ್ಕೆಲಾನ್ ಜರುಜಲೆಮಾಕ್ ಅಪ್ನಾಚ್ಯಾ ತಾಬೆತ್ ಕರುನ್ ಘೆಟಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಕರ್ತಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 4:1" />ತೆ ತವ್ಡೆಚ್ ನ್ಹಯ್ ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಎಕ್ ಇಟಂಗಿ ಘೆವ್ನ್ ತುಜ್ಯಾ ಇದ್ರಾಕ್ ಥವ್ನ್ ಘೆ, ಅನಿ ತೆಜ್ಯಾ ವರ್‍ತಿ ಜರುಜಲೆಮಾಚ್ಯಾ ಶಾರಾಚೊ ನಕಾಸೊ ಬಿಡಸ್, <verse eid="EZK 4:1" /><verse number="2" style="v" sid="EZK 4:2" />ಅನಿ ತೆಚ್ಯಾ ಭೊತ್ಯಾನಿ ಬದು ಘಾಲುನ್ ವಡ್ಕಾ ಭಾಂಧುನ್, ಪಾಳೆ ಭಾಂದುನ್ ಕಾರ್ತತಲೆ ಮಿಶಿನ್ ಇಬೆ ಕರ್, <verse eid="EZK 4:2" /><verse number="3" style="v" sid="EZK 4:3" />ಮಾನಾ ಲೊಂಕ್ಟಾಚೆ ಎಕ್ ತಗಾಡ್ ಘೆವ್ನ್, ತುಜ್ಯಾ ಅನಿ ತ್ಯಾ ಶಾರಾಚ್ಯಾ ಮದ್ದಿ ಇಬೆ ಕರುನ್ ತ್ಯಾ ಶಾರಾಕ್ಡೆ ತೊಂಡ್ ಕರುನ್ ಇಬೆ ರಾ; ತೆ ಆಕ್ರಮನ್ ಕರುನ್ ಹೊತಾ, ಅನಿ ತಿಯಾ ತೆಕಾ ಆಕ್ರಮನ್ ಕರಲ್ಯಾ ಸಾರ್ಕೆ ಹೊತಾ. ಹೆ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ವಳಕ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ.<verse eid="EZK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 4:4" />ಅಸಿರ್‍ಹಾತಾನಾ ತಿಯಾ ತುಜ್ಯಾ ಧಾವ್ಯಾ ಭಾಜುಕ್ ನಿಜುನ್ ಘೆ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾ ಲೊಕಾನಿ ಪಾಪಾಚೆ ವಜ್ಜೆ ತೆಚ್ಯಾ ವರ್‍ತಿ ಥವ್ಚೆ; ಅನಿ ತಿಯಾ ಕವ್ಡ್ಯಾ ದಿಸಾ ಸಗೊಳ್ ಅಸಿ ನಿಜುನ್ ರಾತಯ್ ಬಗ್ ತವ್ಡ್ಯಾ ದಿಸಾ ಸಗೊಳ್ ತೆಂಚಿ ಪಾಪಾಚೆ ವಜ್ಜೆ ವಾವುನ್ಗೆವ್ನ್ ರ್‍ಹಾವ್ಚೆ. <verse eid="EZK 4:4" /><verse number="5" style="v" sid="EZK 4:5" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಅನಿ ತೆನಿ ಕವ್ಡ್ಯಾ ವರ್ಸಾ ಸಗೊಳ್ ತೆಂಚೊ ಪಾಪಾಚೆ ವಜ್ಜೆ ರ್‍ಹಾತಾ, ತವ್ಡಿ ದಿಸಾ ಮಟ್ಲ್ಯಾರ್, ತಿಸಾರ್ ನಂವದ್ ದಿಸಾ ಸಗೊಳ್ ತಿಯಾ ನಿಜುನುಚ್ ರ್‍ಹಾವ್ಚೆ ಮನುನ್ ತುಕಾ ವಳಕ್ ಕರ್ಲಾ; ತವ್ಡ್ಯಾ ದಿಸಾ ಸಗೊಳ್ ತಿಯಾ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಯಾಂಚೊ ಪಾಪಾಚೆ ವಜ್ಜೆ ವಾವುನ್ಗೆವ್ನ್ ರ್‍ಹಾವ್ಚೆ. <verse eid="EZK 4:5" /><verse number="6" style="v" sid="EZK 4:6" />ತವ್ಡಿ ದಿಸಾ ಸರಲ್ಲ್ಯಾ ಮಾನಾ ಉಜ್ವ್ಯಾ ಭಾಜುನ್ ನಿಜುನ್ ಘೆವ್ನ್ ಜುದೆವಾಂಚ್ಯಾ ಪಿಳ್ಗಿಚೊ ಪಾಪಾಚೆ ವಜ್ಜೆ ವಾವುನ್ ಘೆವ್ಚೆ; ವರ್ಸಾಕ್ ಎಕ್ ದಿಸ್ ಮಟ್ಲ್ಯಾರ್, ಚಾಳಿಸ್ ದಿಸಾ ತೆಂಚೊ ಪಾಪಾಚೆ ವಜ್ಜೆ ವಾವ್ಚೆ ಮನುನ್ ತುಕಾ ವಳಕ್ ಕರ್ತಾ.<verse eid="EZK 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 4:7" />ಅನಿ ತುಜ್ಯಾ ಭುಜೆಕ್ ಕಾಂಬ್ರಾನ್ ನಸ್ತಾನಾ, ಆಕ್ರಮನ್ ಕರಲ್ಲ್ಯಾ ಜರುಜಲೆಮಾಚ್ಯಾ ಕಡೆ ತೊಂಡ್ ಪರ್‍ತುನ್ ಘೆವ್ನ್ ಶಾರಾಚ್ಯಾ ವಿರೊಧ್ ಪ್ರವಾದ್ ಕರ್. <verse eid="EZK 4:7" /><verse number="8" style="v" sid="EZK 4:8" />ಅಬಕ್, ತುಜಿ ಆಕ್ರಮನಾಚಿ ದಿಸಾ ಸರಿ ಸಗೊಳ್ ತಿಯಾ ಉಜ್ವ್ಯಾ ಭಾಜುಕ್ ಧಾವ್ಯಾ ಭಾಜುಕ್ ಪರ್ತಿನಾ ಸಾರ್ಕೆ ತುಕಾ ಭಾಂದ್ತಾ.<verse eid="EZK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 4:9" />ತಿಯಾ ಘಂವ್, ಜವ್, ಅವರೆ, ಅಲಸಾಂದೆ, ತಿಳ್, ಹಾರ್ಬೊರೆ, ಹೆ ಸಗ್ಳೆ ಘೆವ್ನ್ ಎಕುಚ್ ಆಯ್ದಾನಾತ್ ಘಾಲುನ್ ಮಿಳ್ವುನ್ ತೆಚೆನಿ ಬಾರಿಕ್ಲಿ ಕರುನ್ ಘೆ; ಅನಿ ಭಾಜುಕ್ ನಿಜಲ್ಯಾ ಯೆವ್ಡೆನ್ ದಿಸಾ, ಮಟ್ಲ್ಯಾರ್ ತಿನ್ಸೆ ನಂವದ್ ದಿಸಾ ಸಗೊಳ್ ತೆ ಖಾ. <verse eid="EZK 4:9" /><verse number="10" style="v" sid="EZK 4:10" />ಅನಿ ತಿಯಾ ಖಾತಲೊ ಖಾನೊ ದಿಸಾಕ್ ಮನುನ್ ದೊನ್ಸೆ ತಿಸ್ ಗ್ರಾಮ್ ವಜನಾ ಯೆವ್ಡೆ ಖಾ; ತಸಿ ಕರುನ್ ತನ್ನಾ ಉಲ್ಲೆ ಉಲ್ಲೆ ಖಾವ್ಚೆ, <verse eid="EZK 4:10" /><verse number="11" style="v" sid="EZK 4:11" />ಅನಿ ಪಾನಿಬಿ ದಿಸಾಕ್ ಎಕ್ ತಾಂಬ್ಯಾ ಭರ್ ತನ್ನಾ ಉಲ್ಲೆ ಉಲ್ಲೆ ಫಿವ್ಚೆ. <verse eid="EZK 4:11" /><verse number="12" style="v" sid="EZK 4:12" />ಅನಿ ತಿಯಾ ನಾಕ್ಡಾಂಚ್ಯಾ ಬದ್ಲಾಕ್ ಮಾನ್ಸಾಚೊ ಶೆನ್ ವಾಪ್ರುನ್ ಲೊಕಾಂಚ್ಯಾ ಇದ್ರಾಕುಚ್ ತ್ಯಾ ಪಿಟ್ಟಾನ್ ಬಾರಿಕ್ಲಿ ಕರುನ್ ಜವಾಚ್ಯಾ ಬಾರಿಕ್ಲಿಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಖಾ. <verse eid="EZK 4:12" /><verse number="13" style="v" sid="EZK 4:13" />ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚಿ ಲೊಕಾಬಿ ಮಾಜ್ಯಾಕ್ನಾ ದುಸ್ರ್ಯಾ ದೆಸಾಕ್ ಪಳ್ವುನ್ ಘಾಲುನ್ ತ್ಯಾ ದೆಶಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ವಸ್ತಿ ರ್‍ಹಾವ್ನ್ ಘೆವ್ನ್ ತೆಂಚೊ ಖಾನೊ ಬುರ್ಸೆ ಕರುನ್ ಖಾತಾತ್; ಹೆ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 4:14" />ತನ್ನಾ ಮಿಯಾ, “ಸರ್ವೆಸ್ಪರ್ ದೆವಾ ನಕ್ಕೊ, ಮಿಯಾ ಬುರ್ಸೆ ಕಾಯ್ ಅಪಡಲ್ಲೊ ನ್ಹಯ್. ಮಿಯಾ ಬಾರಿಕ್ ರ್‍ಹಾತಾನಾಚ್ಯಾನ್ ಆಜ್ ಪತರ್ ಮರಲ್ಯಾ ಜಾನಾವರಾಂಚೆ ಮಾಂಸ್ ಹೊಂವ್ದಿತ್, ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಜನಾವರಾನ್ ಸಾವ್ಜಾನ್ ಮಾರಲ್ಲೆ ಮಾಂಸ್ ಖಲ್ಲೊ ನ್ಹಯ್; ಅನಿ ಖಲೊಬಿ ಬುರ್ಸೊ ಖಾನೊ ತೊಂಡಾತ್ ಘಾಟಲ್ಲೊ ನಾ”, ಮನುನ್ ಸಾಂಗ್ತಾನಾ, <verse eid="EZK 4:14" /><verse number="15" style="v" sid="EZK 4:15" />ತೆನಿ ಮಾಕಾ ಬಗ್, ಮಾನ್ಸಾಚ್ಯಾ ಶೆನಾಚ್ಯಾ ಬದ್ಲಾಕ್ ಗೊರಾಂಚೆ ಶೆನ್ ತುಕಾ ದಿಲಾ, ತೆ ವಾಪ್ರುನ್ ಘೆವ್ನ್ ತಿಯಾ ಬಾರಿಕ್ಲಿ ಬಾಜುನ್ ಘೆ, ಮನುನ್ ಜವಾಬ್ ದಿಲ್ಯಾನ್. <verse eid="EZK 4:15" /><verse number="16" style="v" sid="EZK 4:16" />ತವ್ಡೆಚ್ ನ್ಹಯ್ ತೆನಿ ಮಾಕಾ, ನರ್ ಮಾನ್ಸಾ, ಮಿಯಾ ಜರುಜಲೆಮಾಕ್ ಯೆತಲೆ ಜೆವಾನ್ ಖಾನೊ ಬಂದ್ ಕರ್ತಾ, ಸಗ್ಳಿ ಲೊಕಾ ವಜನಾಚ್ಯಾ ಪ್ರಕಾರ್ ಭಿಂವ್ನ್ ಘೆವ್ನ್ ಖಾತಾತ್, ಪಾನಿಬಿ ಮಾಪಾಚ್ಯಾ ಪರ್ಕಾರ್ ಘಾಬ್ರುನ್ ಫಿತಾತ್. <verse eid="EZK 4:16" /><verse number="17" style="v" sid="EZK 4:17" />ಅನಿ ತೆಂಚ್ಯಾತ್ ಹರ್ ಎಕ್ಲೊಬಿ ಖಾನ್ಯಾ ಫಿನ್ಯಾಕ್ನಾ ಕಮ್ಮಿ ಎವ್ನ್ ಜಿರುನ್ ಅಪ್ನಾಚ್ಯಾ ಪಾಪಾತ್ ನಾಶ್ ಹೊವ್ನ್ ಜಾತಾತ್.<verse eid="EZK 4:17" /></para>
  <chapter eid="EZK 4" />
  <chapter number="5" style="c" sid="EZK 5" />
  <para style="s">ಎಜ್ಕೆಲ್ ಅಪ್ನಾಚಿ ಕೆಸಾ ಕಾತರ್‍ತಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 5:1" />ನರ್ ಮಾನ್ಸಾ, ಎಕ್ ಧಾರ್ಲೊ ತಲ್ವಾರ್ ಘೆವ್ನ್ ಹಜಾಮಾಚ್ಯಾ ವಸ್ತರಾ ಸಾರ್ಕೆ ವಾಪ್ರುನ್ ಘೆವ್ನ್ ತುಜ್ಯಾ ಟಕ್ಲ್ಯಾಚಿ ಅನಿ ದಾಡಿಚಿ ಕೆಸಾ ಕಾಡುನ್ ಎಕ್ ತಕ್ಕಡಿತ್ ಘಾಲುನ್ ತಿ ಕೆಸಾ ಸಮಾ ತಿನ್ ಭಾಗ್ ಕರ್, <verse eid="EZK 5:1" /><verse number="2" style="v" sid="EZK 5:2" />ಅನಿ ಆಕ್ರಮನಾಚಿ ದಿಸಾ ಸರಲ್ಯಾ ಮಾನಾ ಕೆಸಾಂಚೊ ಎಕ್ ಭಾಗ್ ಶಾರಾಚ್ಯಾ ಮದ್ದಿ ಆಗಿನ್ ಜಾಳುನ್ ಸೊಡ್; ಅನಿ ಎಕ್ ಭಾಗ್ ಘೆವ್ನ್ ಶಾರಾಚ್ಯಾ ಭೊತ್ಯಾನಿ ತಲ್ವಾರಾನಿ ತೊಡುನ್ ಘಾಲ್; ಅನಿ ಎಕ್ ಭಾಗ್ ವ್ಹಾರ್ಯಾಕ್ ಹುಡ್ವುನ್ ಸೊಡ್, ತಸಿಚ್ ಮಿಯಾ ಮಾಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಭೊತ್ಯಾನಿ ತಲ್ವಾರ್ ಭಿರ್ಕಟ್ತಾ. <verse eid="EZK 5:2" /><verse number="3" style="v" sid="EZK 5:3" />ತನ್ನಾ ಆಕ್ರಿಚ್ಯಾ ಭಾಗಾತ್ ಹುರಲ್ಯಾ ಉಲ್ಲಿ ಕೆಸಾ ತುಜ್ಯಾ ವಯ್ಲ್ಯಾ ಅಂಗಿಚ್ಯಾ ತುದಿಕ್ ಭಾಂದ್; <verse eid="EZK 5:3" /><verse number="4" style="v" sid="EZK 5:4" />ಮಾನಾ ತ್ಯಾತುರ್ಲಿ ಉಲ್ಲಿಸಿ ಕೆಸಾ ಘೆವ್ನ್ ಆಗಿತ್ ಘಾಲುನ್ ಜಾಳ್; ತೆಚ್ಯಾಕ್ನಾ ಆಗ್ ಎವ್ನ್ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ಲೊಕಾಂಕ್ನಿ ಸಗ್ಳೆಕ್ಡೆ ಪಗಳ್ತಾ.<verse eid="EZK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 5:5" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಸಿ ಮಟ್ಲ್ಯಾನ್, “ಹೆ ಜರುಜಲೆಮ್ ಮಿಯಾ ದೆಶಾಂಚ್ಯಾ ಮದ್ದಿ ಸ್ಥಾಪಿತ್ ಕರ್ಲಾ, ತೆಚ್ಯಾ ಭೊತ್ಯಾನಿ ಹುರಲ್ಲಿ ದೆಶಾ ಹಾತ್”. <verse eid="EZK 5:5" /><verse number="6" style="v" sid="EZK 5:6" />ಅನಿ ತಿ ಮಾಜ್ಯಾ ನೆಮಾಕ್ನಿ ಮಾನಿನಸ್ತಾನಾ, ರಾಜ್ಯ್ ಕಿಂತಾ ಭೊತ್ಯಾನಿ ರ್‍ಹಾತಲ್ಯಾ ದೆಶಾಂಚ್ಯಾಕಿಂತಾ ಲೈ ಬುರ್ಸೆ ಹೊವ್ನ್ ಚಾಲುಲ್ಲಾ; ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತಿ ಮಾಜಿ ನಿಯಮ್ ಪಾಳಿ ನಸ್ತಾನಾ ಮಾಜಿ ಪದ್ದತ್ ಸೊಡುನ್ ಸೊಡ್ಲಾ, <verse eid="EZK 5:6" /><verse number="7" style="v" sid="EZK 5:7" />ಅಸಿ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಸಿ ಸಾಂಗಟ್ಲ್ಯಾನ್; ತುಮಿ ಮಾಜ್ಯಾ ನಿಯಮಾಕ್ನಿ ಮಾನಿನಸ್ಲ್ಯಾರ್ ಮಾಜ್ಯಾ ನೆಮಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಚಲಿನಸ್ಲ್ಯಾರ್ ತುಮ್ಚ್ಯಾ ಭೊತ್ಯಾನಿ ರ್‍ಹಾತಲ್ಯಾ ದೆಶಾಂಚೆ ಧರಮ್ ನಿಯಮ್ ಆಚರನ್ ಕರುನ್, ತ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಕಿಂತಾ ಲೈ ಧಂಗೊ ಉಟ್ವುತಲಿ ಲೊಕಾ ಹೊಲ್ಯಾಸಿ. <verse eid="EZK 5:7" /><verse number="8" style="v" sid="EZK 5:8" />ಅಬಕ್ ಮಿಯಾಚ್ ತುಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಹಾಯ್, ಲೊಕಾಂಚ್ಯಾ ಡೊಳ್ಯಾಚ್ಯಾ ಇದ್ರಾಕುಚ್ ತುಜ್ಯಾ ಲೊಕಾಂಕ್ನಿ ಶಿಕ್ಷ್ಯಾ ದಿತಾ, ಹಿ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 5:8" /><verse number="9" style="v" sid="EZK 5:9" />ತಿಯಾ ಲೈ ಬುರ್ಶಿ ಕಾಮಾ ಕರಿತ್ ಹೊತ್ತ್ಯಾ ವಯ್ನಾ ಮಿಯಾ ಅಜುನ್ ಪತರ್ಬಿ ಅನಿ ಫಿಡೆಬಿ ದಿ ನಸಲ್ಲಿ ಶಿಕ್ಷ್ಯಾ ತುಮ್ಕಾ ದಿತಾ. <verse eid="EZK 5:9" /><verse number="10" style="v" sid="EZK 5:10" />ಅಸಿ ರ್‍ಹಾತಾನಾ ತುಮ್ಚ್ಯಾತ್ಲೆ ಬಾಬಾ ಪೊರಾಕ್ನಿ, ಪೊರಾ ಬಾಬಾಕ್ನಿ ಖಾತ್ಯಾತ್; ತನ್ನಾ ಮಿಯಾ ತುಮ್ಕಾ ಶಿಕ್ಷ್ಯಾ ದಿವ್ನ್ ತುಮ್ಚ್ಯಾತ್ ಹುರಲ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಸಗ್ಳ್ಯಾಕ್ಲ್ಯಾ ವ್ಹಾರ್ಯಾಕ್ ಹುಡ್ವುತಾ.<verse eid="EZK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 5:11" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸಿ ಸಾಂಗ್ತಾ; ಮಾಜ್ಯಾ ಜಿವಾಚ್ಯಾ ವರ್‍ತಿ ಆನ್ ಘಾಲುನ್, ತಿಯಾ ತುಜ್ಯಾ ಬುರ್ಸ್ಯಾ ಮುರ್ತಿಯಾತ್ನಿ ಅನಿ ಅಸಯ್ಯ್ ಸಾಮಾನಾನಿತ್ನಾ ಮಾಜೊ ಪವಿತ್ರ್ ಜಾಗೊ ಬುರ್ಸೆ ಕರಲ್ಲ್ಯಾ ವಯ್ನಾ, ಖರೆಚ್ ಶಿಕ್ಷಾಕ್ ಗುರಿ ಕರ್ತಾ. <verse eid="EZK 5:11" /><verse number="12" style="v" sid="EZK 5:12" />ತುಜ್ಯಾ ಲೊಕಾನಿತ್ಲೊ ತಿನಾತ್ಲೊ ಎಕ್ ಭಾಗ್ ಪಿಡ್ಯಾನಿ ಮರುನ್ ಜಾತಾತ್, ಅನಿ ತುಮ್ಚ್ಯಾ ಮದ್ದಿ ರೊಗ್ ಎವ್ನ್ ನಾಶ್ ಹೊತಾತ್; ಅನಿ ಎಕ್ ಭಾಗ್ ತುಜ್ಯಾ ಭೊತ್ಯಾನಿ ತಲ್ವಾರಾನಿ ಜಿವ್ ಜಾತಾ; ಅನಿ ಎಕ್ ಭಾಗ್ ವ್ಹಾರ್ಯಾಕ್ ಹುಡ್ವುನ್ ತೆಂಚ್ಯಾ ಪಾಟ್ನಾ ತಲ್ವಾರ್ ಭೊತ್ಯಾನಿ ಭಿರ್ಕಟ್ತಾ.<verse eid="EZK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 5:13" />ಅಸಿ ಕರುನ್ ಮಾಜೊ ರಾಗ್ ಥಂಡ್ ಕರುನ್ ಘೆತಾ, ಅನಿ ಮಾಜೊ ಕ್ರೊದ್ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ವೊತುನ್ ಶಾಂತ್ ಹೊತಾ; ಸರ್ವೆಸ್ಪರ್ ಮಿಯಾಚ್ ಮನುನ್ ಮಾಜೊ ರಾಗ್ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ವತಲ್ಯಾ ತನ್ನಾ ತೆಂಕಾ ಕಳ್ತಾ. <verse eid="EZK 5:13" /><verse number="14" style="v" sid="EZK 5:14" />ದಾಟುನ್ ಜಾತಲ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಡೊಳ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕುಚ್ ಮಿಯಾ ತುಮ್ಕಾ ಹಾಳ್ ಕರುನ್, ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ರಾಜಾಕ್ನಿ ನಿಂದ್ಯಾಕ್ ಗುರಿ ಕರ್ತಾ. <verse eid="EZK 5:14" /><verse number="15" style="v" sid="EZK 5:15" />ಮಿಯಾ ರಾಗಾನ್ ಅನಿ ರೊಶ್ಯಾನ್ ಕಟಿನ್ ಶಿಕ್ಷ್ಯಾ ಅನಿ ಲೊಕಾಂಚ್ಯಾ ಗಾಳಿಯಾಕ್ನಿ ಬುದ್ದ್ ಬಾಳ್ ಸಾಂಗಿಸಾರ್ಕೆ ಕರ್ತಾ. ಹಿ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ. <verse eid="EZK 5:15" /><verse number="16" style="v" sid="EZK 5:16" />ತನ್ನಾ ಮಿಯಾ ತುಕಾ ಹಾಳ್ ಕರುಕ್ ಮನುನ್ ಬರ್‍ಗಾಲ್ ಮನ್ತಲೊ ಧಾರ್ಲೊ ಬಾನ್ ತುಜ್ಯಾ ವರ್‍ತಿ ಸೊಡ್ತಾ ತುಮ್ಕಾ ತರಾಸಾನ್ ಲೈ ಕಸ್ಟ್ ದಿವ್ನ್ ಜೆವಾನ್ ದಿತಲೆ ಯೆತಲೆ ಇಬೆ ಕರ್ತಾ. <verse eid="EZK 5:16" /><verse number="17" style="v" sid="EZK 5:17" />ಅಸೆ ಮಿಯಾ ಬರ್‍ಗಾಲ್ ಅನಿ ದುಸ್ಟ್ ಜನಾವಾರಾ ತುಮ್ಚ್ಯಾ ವರ್‍ತಿ ಧಾಡ್ತಾ, ತೆ ತುಮ್ಕಾ ದಿಕ್ಕ್ ನಸಲ್ಲ್ಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಕರ್ತಾ, ಮಾನಾ ದುಕ್ನೆ ಯೆತಾತ್, ಅನಿ ತುಮ್ಚ್ಯಾತ್ ರಗ್ತಾಚೊ ಹಂವಾರೊ ಹೊತಾ, ತುಮ್ಚ್ಯಾ ವರ್‍ತಿ ಕೊಯ್ತೊ ಭಿರ್ಕಾಟುನ್ ಹೊತಾ, ಹಿ ಸರ್ವೆಸ್ಪರಾಚಿ ಗೊಸ್ಟ್.<verse eid="EZK 5:17" /></para>
  <chapter eid="EZK 5" />
  <chapter number="6" style="c" sid="EZK 6" />
  <para style="s">ಮುರ್ತಿಯಾಂಚಿ ಪುಜ್ಯಾ ಕರ್‍ತಲೆ ಸರ್ವೆಸ್ಪರಾನ್ ಖಂಡನ್ ಕರಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 6:1" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಹಿ ಗೊಸ್ಟ್ ಮಾಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, ತೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, <verse eid="EZK 6:1" /><verse number="2" style="v" sid="EZK 6:2" />ನರ್ ಮಾನ್ಸಾ, ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಮಡ್ಡಿಯಾನಿಕ್ನಿ ಬಗುನ್ ತೊಂಡ್ ಕರುನ್ ಇಬೆ ರಾ ತೆಂಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಪರ್ವಾದ್ ಕರ್, <verse eid="EZK 6:2" /><verse number="3" style="v" sid="EZK 6:3" />ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಮಡ್ಡಿಯಾನೊ, ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್ ತುಮಿ ಆಯ್ಕಾ! ಸರ್ವೆಸ್ಪರಾನ್ ಮಡ್ಡಿಯಾಕ್ನಿ, ಗುಂಡ್ಯಾಕ್ನಿ, ನ್ಹಯಾಕ್ನಿ ಅನಿ ಕೊಳ್ಳಾಕ್ನಿ ಅಸಿ ಸಾಂಗ್ಲಾ, ಅಬಕಾ, ಮಿಯಾಚ್ ತುಮ್ಚ್ಯಾ ವರ್‍ತಿ ತಲ್ವಾರ್ ಧಾಡುನ್ ತುಮಿ ವಯ್ಲೆ ಜಾಗೆ ನಾಶ್ ಕರುನ್ ಸೊಡ್ತಾ. <verse eid="EZK 6:3" /><verse number="4" style="v" sid="EZK 6:4" />ಅನಿ ತುಮಿ ಬಲಿ ಭೆಟ್ವುತಲೊ ಜಾಗೊ ಹಾಳ್ ಕರ್ತಾ, ಅನಿ ತುಮಿ ಧುಪ್ ಥವ್ತಲಿ ಅಲ್ತಾರಿ ಫೊಡುನ್ ಟಾಕ್ತಾ, ತುಮ್ಚಿ ಲೊಕಾ ತುಮ್ಚ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಜಿವಾನಿ ಮಾರುನ್ ಪಡಿ ಸರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 6:4" /><verse number="5" style="v" sid="EZK 6:5" />ಅನಿ ಮಿಯಾ ಇಜ್ರಾಯೆಲಾಂಚಿ ಮ್ಹಡಿ ತೆಂಚ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಘಾಲ್ತಾ, ತುಮ್ಚ್ಯಾ ಅಲ್ತಾರಿಚ್ಯಾ ಭೊತ್ಯಾನಿ ತುಮ್ಚಿ ಹಡ್ಡಾ ಪಗಳ್ತಾ. <verse eid="EZK 6:5" /><verse number="6" style="v" sid="EZK 6:6" />ಅನಿ ತುಮಿ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾ ದೆಸಾತ್ನಿ ಗಾಂವಾ ಸಗ್ಳಿ ನಾಶ್ ಹೊವ್ನ್ ಫುಜ್ಯಾ ಕರ್ತಲಿ ಜಾಗೆ ಪಾಡ್ ಪಡುನ್ ಜಾತಾನಾ, ತುಮ್ಚೆ ಬಲಿ ಭೆಟ್ವುತಲೆ ಜಾಗೆ ಹಾಳ್ ಹೊವ್ನ್ ಜಾತಾತ್. ಅನಿ ತುಮ್ಚಿ ಮುರ್ತಿಯಾ ಫುಟುನ್ ನಾ ಹೊವ್ನ್ ಜಾತಾತ್, ಅನಿ ತುಮ್ಚಿ ಧುಪಾ ಥವ್ತಲಿ ಡೆವ್ಳಿಯಾ ಖಾಂಬೆ ತೊಡುನ್ ಹೊತಾ. <verse eid="EZK 6:6" /><verse number="7" style="v" sid="EZK 6:7" />ಅನಿ ಮರಲ್ಲಿ ಲೊಕಾ ತುಮ್ಚ್ಯಾ ಮದ್ದಿ ಎವ್ನ್ ಪಡ್ತಾತ್, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತುಮ್ಕಾ ಕಳ್ತಾ.<verse eid="EZK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 6:8" />ಹೊಲ್ಯಾರ್ಬಿ ಮಿಯಾ ಉಲ್ಲ್ಯಾ ಲೊಕಾಂಕ್ನಿ ಝಿತ್ತೆ ಥವ್ತಾ. ತೆ ಕಸಿ ಮಟ್ಲ್ಯಾರ್, ತುಮಿ ದುಸ್ರ್ಯಾ ದೆಸಾಕ್ ಪಗ್ಳುನ್ ಜಾತಾನಾ, ತುಮ್ಚ್ಯಾತ್ಲಿ ಉಲ್ಲಿ ಲೊಕಾ ತಲ್ವಾರಾಕ್ ಚುಕ್ವುನ್ ಘೆವ್ನ್ ಜಾತಾತ್. <verse eid="EZK 6:8" /><verse number="9" style="v" sid="EZK 6:9" />ತನ್ನಾ ಚುಕ್ವುನ್ ಘೆವ್ನ್ ಬಂಧಿಖಾನ್ಯಾತ್ ನೆಲ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ವಸ್ತಿ ರ್‍ಹಾತ್ಯಾತ್, ತುಮ್ಚಿ ಲೊಕಾ ಮುರ್ತಿಯಾರ್ನಿ ನದರ್ ಥವ್ನ್ ಮಾಕಾ ಸೊಡುನ್ ತೆಂಚ್ಯಾ ಮನಾತ್ನಿ ತೆಂಚ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾ ವಯ್ಲ್ಯಾ ಆಶ್ಯಾನಿ, ದೆವಾಕ್ ದ್ರೊಹ್ ಕರಲ್ಲಿ ತೆಂಚೆ ಡೊಳೆ ಹಾಳ್ ಕರಲ್ಲೊ ಮಿಯಾಚ್ ಮನುನ್ ಮಾಕಾ ಯಾದ್ ಕರುನ್ ಘೆವ್ನ್, ಅಮಿ ಲೈ ಬುರ್ಶಿ ಕಾಮಾ ಕರುಕ್ ಲಾಗ್ಲಾವ್ ಮನುನ್ ತೆಂಚೆ ತೆನಿಚ್ ಕಂಟಾಳ್ತಾತ್. <verse eid="EZK 6:9" /><verse number="10" style="v" sid="EZK 6:10" />ಅನಿ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತೆಂಕಾ ಕಳ್ತಾ; ಹೊ ಸಂಕಟ್ ತೆಂಕಾ ಕರ್ತಾ ಮನುನ್ ಮಿಯಾ ಸಾಂಗಟಲ್ಲೆ ಝುಟಿ ಗೊಸ್ಟ್ ನ್ಹಯ್. <verse eid="EZK 6:10" /><verse number="11" style="v" sid="EZK 6:11" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಸಾಂಗ್ತಾ, ತಿಯಾ ಥಾಪ್ಟಿಯಾ ಮಾರುನ್ ಪಾಂಯ್ ಬಡ್ವುನ್ ಅಸಿ ಸಾಂಗ್; ಒಹೊ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾಂಚೆ ಬುರ್ಶಿಕಾಮಾ ಕವ್ಡಿ! ಅನಿ ತೆನಿ ತಲ್ವಾರ್ ಬರ್‍ಗಾಲ್, ಅನಿ ರೊಗಾನಿ ಮರುನ್ ಜಾತಾತ್. <verse eid="EZK 6:11" /><verse number="12" style="v" sid="EZK 6:12" />ಧುರ್ ಹೊತ್ತ್ಯಾನಿ ಫಿಡಾ ಲಾಗುನ್ ಮರುನ್ ಜಾತಾ, ಜಗ್ಗೊಳ್ ಹೊತ್ತೊ ತಲ್ವಾರಾನಿ ಮರುನ್ ಜಾತಾತ್, ಚುಕ್ವುನ್ ಘೆವ್ನ್ ರಾತಲೊ ಬರ್ಗಾಲಾನಿ ಮರುನ್ ಜಾತಾ; ಅಸೆ ಕರುನ್ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಥವಲ್ಲೊ ರಾಗ್ ಕಾಡ್ತಾ. <verse eid="EZK 6:12" /><verse number="13" style="v" sid="EZK 6:13" />ಹ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ ಉಪ್ಪರ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಮಡ್ಡಿಯಾಂಚ್ಯಾ ವಯ್ನಿ, ಪರ್ವತಾಂಚ್ಯಾ ವೈರ್ನಿ ಹರ್ ಎಕ್ ದಾಟ್ ಪಾನಾಂಚ್ಯಾ ಝಾಡಾಚ್ಯಾ ಖಾಲ್ತಿ ತುಮ್ಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಮುರ್ತಿಯಾಕ್ನಿ ಬರ್ಯಾ ವಾಸೆಚಿ ಬಲಿ ಕರ್‍ತಲ್ಯಾಂಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಝಾಡಾಂಚ್ಯಾ ಖಾಲ್ತಿ ಮರುನ್, ಬಲಿಭೆಟ್ವುತಲ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ಭೊತ್ಯಾನಿ ತುಮ್ಚ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾ ಮದ್ದಿ ಪಡುನ್ ರ್‍ಹಾತಾನಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳುನ್ ಯೆತಾ. <verse eid="EZK 6:13" /><verse number="14" style="v" sid="EZK 6:14" />ಮಿಯಾ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕ್ಲುನ್ ತೆನಿ ವಸ್ತಿ ಹೊತ್ತ್ಯಾ ದೆಸಾತ್ಲ್ಯಾ ಡಂಗ್ಳಿತ್ನಾ ಡಿಬ್ಬಾಚ್ಯಾ ಪತರ್ ನಾಶ್ ಕರುನ್ ಟಾಕ್ತಾ; ತನ್ನಾ ತೆಂಕಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳುನ್ ಯೆತಾ.<verse eid="EZK 6:14" /></para>
  <chapter eid="EZK 6" />
  <chapter number="7" style="c" sid="EZK 7" />
  <para style="s">ಇಜ್ರಾಯೆಲಾಂಚಿ ಆಕ್ರಿ ಜಗ್ಗೊಳ್ ಯೆಲಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 7:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಹಿ ಗೊಸ್ಟ್ ಮಾಕಾ ದಿಲ್ಯಾನ್, <verse eid="EZK 7:1" /><verse number="2" style="v" sid="EZK 7:2" />ನರ್ ಮಾನ್ಸಾ, ದೆವ್ ಬಾಬಾನ್ ಇಜ್ರಾಯೆಲ್ ದೆಸಾಕ್ ಅಸಿ ಸಾಂಗ್ಲ್ಯಾನ್, ಆಕ್ರಿಚೊ ಎಳ್ ಯೆಲಾ; ಚಾರ್ ದಿಕ್ಕಾಕ್ನಿ ಆಕ್ರಿ ಯೆತಾ. <verse eid="EZK 7:2" /><verse number="3" style="v" sid="EZK 7:3" />ಅತ್ತ್ಯಾಚ್ ಆಕ್ರಿಚೊ ಎಳ್ ಯೆಲಾ, ಅನಿ ತಿಯಾ ಮಾಜೊ ರಾಗ್ ತುಜ್ಯಾ ವರ್‍ತಿ ಎವ್ನ್, ತುಜ್ಯಾ ಚಾಲ್ನುಕಿಚ್ಯಾ ಸಾರ್ಕೆ ನ್ಯಾಯ್ ಕರ್ತಾ, ತುಜ್ಯಾ ಸಗ್ಳ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾಚ್ಯಾ ವಯ್ನಾ ತುಕಾ ಶಿಕ್ಷ್ಯಾ ದಿತಾ. <verse eid="EZK 7:3" /><verse number="4" style="v" sid="EZK 7:4" />ಅನಿ ಮಾಜೆ ಡೊಳೆ ತುಕಾ ಬಗಿನಾತ್, ಉಲ್ಲೆಬಿ ಉಸ್ಕೊ ಕರಿನಾ, ತುಕಾ ಬುರ್ಸ್ಯಾ ವಾಟೆಚೊ ಫಳ್ ಖಾವಸ್ತಾ, ಅನಿ ತುಜಿ ಬುರ್ಶಿಕಾಮಾ ತುಜ್ಯಾ ಇದ್ರಾಕ್ ಯೆತಾತ್, ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ಮಿಯಾಚ್ ಮನುನ್ ತುಕಾ ಕಳ್ತಾ.<verse eid="EZK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 7:5" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಸಾಂಗ್ತಾ; ತರಾಸ್! ಕನ್ನಾಬಿ ಬಗಿನಸಲ್ಲೊ ತರಾಸ್ ಯೆತಲೊ! <verse eid="EZK 7:5" /><verse number="6" style="v" sid="EZK 7:6" />ಅಂತ್ ಯೆಲೊ, ಅಂತ್ ಎವ್ನ್ ಪಾವ್ಲೊ, ತಿಯಾ ಸರುನ್ ಗೆಲೈ, <verse eid="EZK 7:6" /><verse number="7" style="v" sid="EZK 7:7" />ದೆಶಾಚ್ಯಾ ವಸ್ತಿರಾತಲ್ಯಾನೊ ತುಮ್ಚಿ ಗತ್ ಸರ್ಲಿ, ದಿಸ್ ಜಗ್ಗೊಳ್ ಪಾವ್ಲಾ; ಮಡ್ಡಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಯೆತಲಿ ಧನ್ ಮಜ್ಯಾ ಕರ್ತಲೊ ಧನ್ ನ್ಹಯ್, ಕಳ್ವಳೊಚ್.<verse eid="EZK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 7:8" />ಅನಿ ಉಲ್ಲ್ಯಾ ಯೆಳಾನ್ ಮಾಜೊ ರಾಗ್ ತುಜ್ಯಾ ವರ್‍ತಿ ವತ್ತಾ, ಅನಿ ಮಾಜೊ ರಾಗ್ ಕಾಡುನ್ ಘೆವ್ನ್, ತುಜ್ಯಾ ಚಾಲ್ನುಕಿಚ್ಯಾ ವಯ್ನಾ ಶಿಕ್ಷ್ಯಾ ದಿತಾ. <verse eid="EZK 7:8" /><verse number="9" style="v" sid="EZK 7:9" />ಅನಿ ತುಜ್ಯಾ ವರ್‍ತಿ ಉಸ್ಕೊ ಕರಿನಾ, ತುಜ್ಯಾ ವರ್‍ತಿ ದಯಾ ದಾಕ್ವಿನಾ, ಹುರ್ವಿನಾ, ತನ್ನಾ ತುಜ್ಯಾ ಬುರ್ಶಿಕಾಮಾ ತುಕಾಚ್ ಕಳ್ತಾ; ಮಾನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ತುಕಾ ಶಿಕ್ಷ್ಯಾ ದಿವ್ಲಾ ಮನುನ್ ಅರ್ಥ್ ಹೊತಾ.<verse eid="EZK 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 7:10" />ಅಬಕ್, ಶಿಕ್ಷ್ಯಾ ದಿತಲಿ ದಿಸ್ ಯೆಲೊ! ತುಜಿ ಬುರ್ಶಿ ಗತ್ ಎವ್ನ್ ಪಾವ್ಲಾ, ದಾಂಡೊ ಫುಲ್ಲಾ ಸೊಡ್ಲಾ. ಅನಿ ತುಜಿ ಘಮೆಂಡಿ ಚಿಗರ್ಲಾ. <verse eid="EZK 7:10" /><verse number="11" style="v" sid="EZK 7:11" />ಅನಿ ತರಾಸ್ ಉಗ್ವುನ್ ಬುರ್ಸೆಪಾನಾಚೊ ದಾಂಡೊ ಹೊಲಾ; ತುಮ್ಚ್ಯಾತ್ಲೆ ಕೊನ್ಬಿ ಹುರಿನಾತ್, ತ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ತಾಂಡ್ಯಾತ್ನಿ ತೆಂಚ್ಯಾ ಆಸ್ತಿ ಕಾಯ್ಬಿ ರ್‍ಹಾಯ್ನಾ ತೆಂಚ್ಯಾತ್ ಕಾಯ್ಬಿ ಮೊಟೆಪಾನ್ ಹುರಿನಾ.<verse eid="EZK 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 7:12" />ಎಳ್ ಯೆಲೊ, ದಿಸ್ ಜಗ್ಗೊಳ್ ಪಾವ್ಲೊ, ಇಕಾತ್ ಘೆತಲೊ ಮಾನುಸ್ ಭಾಜುಕ್ ರಾವ್ನೆಯ್, ಇಕ್ತಲೊ ಮಾನುಸ್ ದುಕ್ಕೆನ್ ರಾವ್ನೆಯ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ರಾಗಾಚೊ ಆಗ್ ಲೊಕಾಂಚ್ಯಾ ತಾಂಡ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಚಡ್ಲಾ. <verse eid="EZK 7:12" /><verse number="13" style="v" sid="EZK 7:13" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಇಕ್ತಲೊ ಮಾನುಸ್ ಕವ್ಡೊ ವರಿಸ್ ಝಿತ್ತೊ ರಾಲ್ಯಾರ್ಬಿ ಇಕಲ್ಲೆ ಬದಿಕ್ ತೆಚ್ಯಾಕ್ಡೆ ತಾಬೆತ್ ಪರ್‍ತುನ್ ಯೆಯ್ನಾ, ಅನಿ ಘಡಲ್ಲಿ ದಿವ್ಯ್ ದರ್ಶನಾ ಸಗ್ಳಿ ತಾಂಡ್ಯಾತ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಸಮಂಧ್ ಪಡಲ್ಲೆ ಹಾಯ್, ತನ್ನಾ ಕೊನ್ಬಿ ಪರ್‍ತುನ್ ಯೆಯ್ನಾತ್, ಕೊನ್ಬಿ ತೆಂಚ್ಯಾ ಬುರ್ಸ್ಯಾಪಾನಾನ್ ತೆಂಚೊ ಜಿವ್ ಹುರ್ವುನ್ ಘೆವ್ಕ್ ಹೊಯ್ನಾ. <verse eid="EZK 7:13" /><verse number="14" style="v" sid="EZK 7:14" />ತೆನಿ ಬೊಂಗೊ ವಾಜ್ವುನ್ ಸಗ್ಳೆ ತಯಾರ್ ಕರಲ್ಲೆ ರಾಲ್ಯಾರ್ಬಿ, ಕೊನ್ಬಿ ಝಗ್ಡ್ಯಾಕ್ ಜಾಯ್ನಾತ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ದೆವ್ ಹೊಲ್ಲ್ಯಾ ಮಾಜ್ಯಾ ರಾಗಾಚಿ ಆಗ್ ತ್ಯಾ ತಾಂಡ್ಯಾ ವರ್‍ತಿ ಚಡ್ಲಾ.<verse eid="EZK 7:14" /></para>
  <para style="s">ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಪಾಪಾಕ್ನಿ ಶಿಕ್ಷ್ಯಾ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 7:15" />ಗಾಂವಾಚ್ಯಾ ಭಾಯ್ರ್ ತಲ್ವಾರ್ ಹಾಯ್, ಗಾಂವಾಚ್ಯಾ ಭುತ್ತುರ್ ರೊಗ್ ಅನಿ ಬರ್‍ಗಾಲ್ ಹಾತ್; ಗಾಂವಾಚ್ಯಾ ಬಾರ್ಯ್ ಹೊತ್ತೆ ತಲ್ವಾರಾಕ್ನಿ ಗಾವ್ತಾತ್, ಅನಿ ಭುತ್ತುರ್ ಹೊತ್ತಿ ಲೊಕಾ ದುಕ್ನ್ಯಾಕ್ ಅನಿ ಬರ್ಗಾಲಾಕ್ ಗಾವುನ್ ಪಡ್ತಾತ್. <verse eid="EZK 7:15" /><verse number="16" style="v" sid="EZK 7:16" />ತೆಂಚ್ಯಾತ್ಲಿ ಪಳುನ್ ಗೆಲ್ಲಿ ಲೊಕಾ ಚುಕ್ವುನ್ ಘೆವ್ನ್ ಜಾವ್ನ್, ಅಪ್ನಾಚ್ಯಾ ಬುರ್ಸ್ಯಾಪಾನಾತುಚ್ ರ್‍ಹಾವ್ನ್ ಮಡ್ಡಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಅನಿ ಕೊಳ್ಳಾತ್ನಿ ಪಾರಿವಳಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಗೊಳಾಟ್ ಕರಿತ್ ರ್‍ಹಾತ್ಯಾತ್. <verse eid="EZK 7:16" /><verse number="17" style="v" sid="EZK 7:17" />ತನ್ನಾ ತೆಂಚಿ ಸಗ್ಳ್ಯಾಚಿ ಹಾತಾ ಬಳ್ ನಸ್ತಾನಾ ಲೊಂಬಾತ್ ಪಡ್ತಲಿ. ಅನಿ ಸಗ್ಳ್ಯಾಚಿ ಡೊಪ್ರಾ ಪಾನಿಯಾಚ್ಯಾ ಸಾರ್ಕೆ ಸಯ್ಲ್ ಹೊತಾತ್. <verse eid="EZK 7:17" /><verse number="18" style="v" sid="EZK 7:18" />ಅನಿ ತೆನಿ ಚಿಲಾ ಲಪ್ಟುನ್ಗೆವ್ನ್ ಘೆತಾತ್, ಅನಿ ತೆಂಕಾ ಭ್ಹಿಯೆ ಧಾಪುನ್ ಘಾಲ್ತಾ; ಅನಿ ತೆಂಚಿ ತೊಂಡಾ ಲಜ್ಜೆನ್ ಭರ್ತಲಿ, ಮಾನಾ ತೆನಿ ಸಗ್ಳ್ಯಾಂಚ್ಯಾ ಟಕ್ಲ್ಯಾಚಿ ಕೆಸಾ ಕಾಡುನ್ ಘೆವ್ನ್ ರ್‍ಹಾತ್ಯಾತ್. <verse eid="EZK 7:18" /><verse number="19" style="v" sid="EZK 7:19" />ಅನಿ ಅಪ್ನಾಚೆ ಚಾಂದಿ ಸಗ್ಳಿ ವಾಟೆರ್ ಟಾಕ್ತಾತ್, ಅನಿ ತೆಂಚೆ ಸೊನೆ ಸಗ್ಳೆ ಅಶುದ್ದ್ ಹೊಲ್ಲೆ ರ್‍ಹಾತಾ; ಹೆ ಸೊನೆ ಅನಿ ಚಾಂದಿ ಸಗ್ಳೆ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ರಾಗಾಚ್ಯಾ ಚುಕ್ವುಕ್ ಹೊಯ್ನಾ; ಅನಿ ತೆಂಚ್ಯಾ ಮನಾಚ್ಯಾ ಸಾರ್ಕೆ ಕಾಯ್ಬಿ ಹೊಯ್ನಾ, ತೆಂಚಿ ಸುಕಾಕ್ ಲಾಗುನ್ ಪೊಟ್ ಭರುನ್ ಘೆವ್ಕ್ ಹೊಯ್ನಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೆಂಕಾ ಆಸ್ತಿ ಪಾಪಾತ್ ಪಡಿ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 7:19" /><verse number="20" style="v" sid="EZK 7:20" />ತಿ ಲೊಕಾ ಅಪ್ನಾಚ್ಯಾ ಸುಂದರ್ ಕರುನ್ ಘೆತಲ್ಯಾ ಸೊನ್ಯಾಚಾಂದಿನಿ ಬುರ್ಶಿ ಅನಿ ಬಗುಕ್ಬಿ ಬರಿ ದಿಸಿನಸಲ್ಲ್ಯಾ ಮುರ್ತಿಯಾ ತೆಂಚ್ಯಾ ಕರುನ್ ಘೆಟ್ಲ್ಯಾತ್, ತೆಚ್ಯಾ ಸಾಟ್ನಿ ತೆ ಮಿಯಾ ಅಶುದ್ದ್ ಖಾನೊ ಹೊವ್ನ್ ಕರ್ತಾ. <verse eid="EZK 7:20" /><verse number="21" style="v" sid="EZK 7:21" />ದುಸ್ರಾಂಚ್ಯಾ ಹಾತಿತ್ನಾ ಲುಟ್ ಕರುನ್ ಲಾವ್ನ್ ದೆಶಾಚ್ಯಾ ಲೈ ಬುರ್ಸ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಲುಟ್ ಕರಸ್ತಾ ತೆನಿ ತೆ ಅಪಡ್ಸಿಪಡ್ ಕರ್‍ತಾತ್. <verse eid="EZK 7:21" /><verse number="22" style="v" sid="EZK 7:22" />ಮಿಯಾ ಮಾಜೆ ತೊಂಡ್ ತೆಂಚ್ಯಾಕ್ನಾ ಪರ್‍ತುನ್ ಘೆತಾ, ಅನಿ ತೆನಿ ಮಾಜಿ ಅಮುಲ್ಯ್ ಗುಡಿ ಅಪಡ್ಸಿಪಡ್ ಕರ್‍ತಾತ್. ಅನಿ ಚೊರಾ ಭುತ್ತುರ್ ಗುಸುನ್ ಬುರ್ಸೆ ಕರ್‍ತಾತ್.<verse eid="EZK 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 7:23" />“ಎಕ್ ಸರ್ಪೊಳಿ ಕರ್! ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ದೆಶ್ ಮಾನ್ಸಾಕ್ನಿ ಜಿವಾನಿ ಮಾರ್ತಲ್ಯಾನಿ ಭರಲ್ಲೆ ಹಾಯ್, ಅನಿ ಶಾರ್ ತರಾಸಾನ್ ಭರುನ್ ಗೆಲಾ”. <verse eid="EZK 7:23" /><verse number="24" style="v" sid="EZK 7:24" />ಅಸಿ ರ್‍ಹಾತಾನಾ, ಮಿಯಾ ಲೈ ಬುರ್ಸ್ಯಾ ಲೊಕಾಕ್ನಿ ಬಲ್ವುತಾ, ತೆನಿ ಲೊಕಾಂಚಿ ಘರಾ ಸಗ್ಳೆ ತೆಂಚ್ಯಾ ತಾಬೆತ್ ಕರುನ್ ಘೆತಾತ್, ಮಿಯಾ ತಾಕ್ತಿತ್ ಹೊತ್ತ್ಯಾಂಚೊ ಗರ್ವಿಸ್ಠ್ ಪಾನ್ ಮೊಡುನ್ ಟಾಕ್ತಾ; ಅನಿ ತೆಂಚಿ ಪವಿತ್ರ್ ಜಾಗೆ ಹೊಲೆ ಹೊತಾತ್. <verse eid="EZK 7:24" /><verse number="25" style="v" sid="EZK 7:25" />ಸಂಕಟ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ, ತೆನಿ ಸಮಾಧಾನ್ ಹುಡಕ್ಲ್ಯಾರ್ಬಿ ಉಲ್ಲೆಬಿ ತೆಂಕಾ ಗಾಯ್ನಾತ್, <verse eid="EZK 7:25" /><verse number="26" style="v" sid="EZK 7:26" />ತರಾಸಾಚ್ಯಾ ವರ್‍ತಿ ತರಾಸ್; ಖಬ್ರಿಚ್ಯಾ ವರ್‍ತಿ ಖಬರ್ ಯೆತಾತ್, ತೆನಿ ಪರ್ವಾದಿಚ್ಯಾ ವಾಂಗ್ಡಾ ದರ್ಶನಾ ಗಾವ್ತಲಿ ವಾಟ್ ಬಗುನ್ಗೆತ್ ರ್‍ಹಾತ್ಯಾತ್, ಯಾಜಕಾತ್ನಿ ನೆಮಾ ನಾ ಹೊತಾತ್, ಜಾಂನ್ತ್ಯಾತ್ನಿ ಬುದ್ವಾದ್ ಸಾಂಗ್ತಲೆ ನಾ ಹೊವ್ನ್ ಜಾತಾತ್. <verse eid="EZK 7:26" /><verse number="27" style="v" sid="EZK 7:27" />ರಾಜಾಕ್ ಲೈ ದುಕ್ಕ್ ಹೊತಾ, ರಾಜಾಚೊ ಲೆಕ್ ಭರ್ವೊಸೊ ಸೊಡುನ್ ಸೊಡ್ತಾ, ಅನಿ ಸಾದ್ರನ್ ಹೊತ್ತ್ಯಾ ಲೊಕಾಂಚಿ ಹಾತಾ ಭಿಂವ್ನ್ ಲಕ್ವಾ ಮಾರಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಥರ್ಥತಾತ್; ಮಿಯಾ ತೆಂಚ್ಯಾ ಬುರ್ಶಾ ಚಾಲ್ನುಕಿಚ್ಯಾ ವಯ್ನ್ ಮಿಯಾ ಶೆಡ್ ಕಾಡುನ್ ಘೆತಾ, ತೆಂಚ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ವಯ್ನಾ ಶಿಕ್ಷ್ಯಾ ದಿತಾ; ತನ್ನಾ ತೆಂಕಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳ್ತಾ.<verse eid="EZK 7:27" /></para>
  <chapter eid="EZK 7" />
  <chapter number="8" style="c" sid="EZK 8" />
  <para style="s">ಎಜ್ಕೆಲಾಕ್ ಹೊಲ್ಲೊ ದೆವಾಚೊ ದೊನ್ವೆಚೊ ದರ್ಶನ್</para>
  <para style="s">ಜರುಜಲೆಮಾತ್ ಮುರ್ತಿ ಫುಜ್ಯಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 8:1" />ಯೆಹೊಯಾಕಿನ್ ಬಂಧಿಹೊಲ್ಲ್ಯಾ ಸಾವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಸಾವ್ಯಾ ಮ್ಹೆನ್ಯಾಚ್ಯಾ ಪಾಂಚ್ವ್ಯಾ ದಿಸಾ ಮಿಯಾ ಅನಿ ಜುದೆವಾಂಚಿ ಜಾಂನ್ತ್ಯಾ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಮಾಜ್ಯಾ ಘರ್‍ಹಾತ್ ಬಸಲ್ಯಾ ತನ್ನಾ; ಸರ್ವೆಸ್ಪರಾನ್ ಹಾತ್ ಮಾಜ್ಯಾ ವರ್‍ತಿ ಥವಲ್ಲ್ಯಾ ವಯ್ನಾ ದೆವಾಚ್ಯಾ ಮಹಿಮೆನ್ ಭರ್ಲೊ, <verse eid="EZK 8:1" /><verse number="2" style="v" sid="EZK 8:2" />ಅಬಕ್, ಮಿಯಾ ಬಗಿತ್ ರ್‍ಹಾತಾನಾ ಆಗ್ ಪೆಟಲ್ಲ್ಯಾ ಗತಿನ್ ಮೊಟ್ಟೊ ಉಜ್ವೊಡ್ ದಿಸ್ಲೊ, ತೊ ಮಾನ್ಸಾಚ್ಯಾ ರುಪಾಚ್ಯಾ ಸಾರ್ಕೆ ದಿಸಿತ್ ಹೊತ್ತೆ, ಕಂಬ್ರೆಚ್ಯಾ ಭಾಸೆನ್ ದಿಸ್ತಲ್ಯಾ ತೆಚ್ಯಾ ಮದ್ಲ್ಯಾ ಭಾಗಾಕ್ನಾ ಖಾಲ್ತಿ ಆಗ್ ಪೆಟಿತ್ ಹೊತ್ತಿ. ತೆಚ್ಯಾ ಮದ್ಲ್ಯಾ ಭಾಗಾಕ್ನಾ ವರ್‍ತಿ ಹೊಳಾವ್ತಲ್ಯಾ ಸೊನ್ಯಾಚ್ಯಾ ಸಾರ್ಕೆ ಅಜಾಪಾಚೊ ಉಜ್ವೊಡ್ ಹೊಳಾದ್ಲೊ. <verse eid="EZK 8:2" /><verse number="3" style="v" sid="EZK 8:3" />ತನ್ನಾ ತೆಜೊ ಹಾತ್ ಫಿಡೆ ಕರುನ್ ಮಾಜೆ ಟಕ್ಲೆ ಧರುನ್ ಘೆಟ್ಲ್ಯಾನ್, ದೆವಾಚೊ ಆತ್ಮೊ ಮಾಕಾ ಉಕ್ಲುನ್ ಘೆವ್ನ್ ಜಿಮ್ನಿಚ್ಯಾ ಅನಿ ಮಳ್ಬಾಚ್ಯಾ ಮದ್ದಿ ಹೊತ್ತ್ಯಾ ಜರುಜಲೆಮಾಚ್ಯಾ ಪತರ್ ನೆವ್ನ್ ಭುತ್ತುರ್ಲ್ಯಾ ಭಾಗಾಚ್ಯಾ ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ದಾರಾಚ್ಯಾ ಇದ್ರಾಕ್ ದೆವಾಕ್ ರಾಗ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್‍ತಲ್ಯಾ ಮುರ್ತಿಕ್ ಅದ್ದಿ ಹೊತ್ತ್ಯಾ ಜಾಗ್ಯಾರ್ ಇಬೆ ಕರಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ದೆವಾಚ್ಯಾ ದರ್ಶನಾತ್ ದಿಸುನ್ ಯೆಲೆ.<verse eid="EZK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 8:4" />ಆಹಾ, ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ದೆವಾಚಿ ಮಹಿಮಾ ಅದ್ಬುತ್ ದರ್ಶನ್ ಮ್ಹಾಳ್ ಜಾಗ್ಯಾರ್ ಹೊಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಹಿತ್ತೆಬಿ ಹೊಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಮಾಕಾಬಿ ಹೊಲೆ. <verse eid="EZK 8:4" /><verse number="5" style="v" sid="EZK 8:5" />ತನ್ನಾ ದೆವಾನ್ ಮಾಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, “ನರ್ ಮಾನ್ಸಾ, ಉತ್ತರಾಚ್ಯಾ ದಿಕ್ಕಾಕ್ಡೆ ತೆಚಿ ದಿಸ್ಟ್ ಘಾಲ್, ತನ್ನಾ ಮಿಯಾ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ನಾ ಮಾಜಿ ದಿಸ್ಟ್ ಬಗಲ್ಯಾ ತನ್ನಾ; ಅಬಕ್, ದೆವಾಕ್ ರಾಗ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಲಿ ತಿ ಮುರ್ತಿ ಅಲ್ತಾರಿಕ್ಡೆ ಭುತ್ತುರ್ ಗುಸ್ತಲ್ಯಾ ದಾರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆ ಹೊತ್ತೆ”. <verse eid="EZK 8:5" /><verse number="6" style="v" sid="EZK 8:6" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, “ನರ್ ಮಾನ್ಸಾ, ಹೆನಿ ಕಾಯ್ ಕರುನ್ಗೆತ್ ಹಾತ್ ಮನುನ್ ಬಗುಲೈ ಕಾಯ್? ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾನಿ ಹಿತ್ತೆ ಕರುಲಾಗಲ್ಲೊ ಬುರ್ಶಿಕಾಮಾ ಬಗಲೈ ಕಾಯ್? ಹೆಚ್ಯಾ ವಯ್ನಾ ಮಿಯಾ ಪವಿತ್ರ್ ದೆವಾಚಿ ಗುಡಿ ಸೊಡುನ್ ದುರ್ ಜಾತಲೆ ಯೆಲೆ. ಯೆ, ಹೆಚ್ಯಾನ್ ಅನಿ ಲೈ ಬುರ್ಶಿ ಕಾಮಾ ಬಗ್ತಯ್”.<verse eid="EZK 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 8:7" />ಮಾನಾ ತೆನಿ ಮಾಕಾ ಅಂಗ್ನಾಚ್ಯಾ ದಾರಾಕ್ಡೆ ಹಾನ್ಲ್ಯಾನ್; ಅಬಕ್, ತ್ಯಾ ಭಿತ್ತಿತ್ ಮಾಕಾ ಎಕ್ ಡೊಂಮ್ಕೊ ದಿಸ್ಲೊ. <verse eid="EZK 8:7" /><verse number="8" style="v" sid="EZK 8:8" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, ನರ್ ಮಾನ್ಸಾ, ಭಿತ್ತಿಕ್ ಖಂಡ್, ತನ್ನಾ ಮಿಯಾ ಭಿತ್ತ್ ಖಂಡ್ತಾನಾ ಎಕ್ ದಾರ್ ದಿಸ್ಲೆ. <verse eid="EZK 8:8" /><verse number="9" style="v" sid="EZK 8:9" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, ತಿಯಾ ಭುತ್ತುರ್ ಜಾ ಥೈ ತೆನಿ ಹಿತ್ತೆ ಕವ್ಡೆ ಬುರ್ಶಿ ಕಾಮಾ ಕರುಲಾತ್ ಮನುನ್ ಬಗ್, <verse eid="EZK 8:9" /><verse number="10" style="v" sid="EZK 8:10" />ತನ್ನಾ ಮಿಯಾ ಭುತ್ತುರ್ ಗುಸುನ್ ಬಗಟ್ಲೊ. ಥೈ, ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಕಿಡ್ಯಾಂಚೆ, ಬುರ್ಶಿ ಜನಾವರಾಂಚೆ ಅನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಫುಜ್ಯಾ ಕರ್ತಲಿ ಸಗ್ಳಿ ಮುರ್ತಿಯಾಂಚಿ ಚಿತ್ರಾ ಭಿತ್ತಿಯಾ ವಯ್ನಿ ಕಾಡಲ್ಲೆ ಹೊತ್ತಿ. <verse eid="EZK 8:10" /><verse number="11" style="v" sid="EZK 8:11" />ಅನಿ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾ ಸತ್ತರ್ ಲೊಕಾ ಜಾಂನ್ತೆ ತೆಂಚ್ಯಾ ಮದ್ದಿ ಶೆಪಾನಾಚೊ ಲೆಕ್ ಜಾಜನ್ಯ್ ಮನ್ತಲೊ ತೆಂಚ್ಯಾ ಹಾತಿತ್ನಿ ಧುಪಾಚಿ ಆರತಿಯಾ ಧರುನ್ ಘೆವ್ನ್ ತ್ಯಾ ಚಿತ್ರಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆ ಹೊತ್ತೆ; ತ್ಯಾ ಧುಪಾಚಿ ವಾಸ್ ಅನಿ ಡುಕೊಟ್ ಮಳ್ಬಾಚ್ಯಾ ಸಾರ್ಕೆ ವರ್‍ತಿ ಜಾಯ್. <verse eid="EZK 8:11" /><verse number="12" style="v" sid="EZK 8:12" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, “ನರ್ ಮಾನ್ಸಾ, ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾ ಜಾಂನ್ತ್ಯಾನಿ ನಾನಾ ನಮುನ್ಯಾಚ್ಯಾ ರುಪಾನಿ ಚಿತ್ರ್ ಕಾಡಲ್ಯಾ ಕಾಳೊಕ್ ಹೊತ್ತ್ಯಾ ಖೊಲಿಯಾತ್ನಿ ಕರ್ತಲಿ ಕಾಮಾ ಬಗಲೈ ಕಾಯ್? ಸರ್ವೆಸ್ಪರ್ ಅಮ್ಕಾ ಬಗಿನಾ, ಸರ್ವೆಸ್ಪರಾನ್ ಹೊ ದೆಶ್ ಸೊಡುನ್ ಸೊಡ್ಲಾ ಮನುನ್ ಬೊಲುನ್ ಘೆತಾತ್”.<verse eid="EZK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 8:13" />ಮಾನಾ ತೆನಿ ಮಾಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, “ತಿಯಾ ತೆನಿ ಕರ್ತಲಿ ಹೆಚ್ಯಾನ್ಕಿ ಲೈಬಿ ಬುರ್ಶಿ ಕಾಮಾ ಬಗ್ತಯ್”. <verse eid="EZK 8:13" /><verse number="14" style="v" sid="EZK 8:14" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ದಾರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್; ಅಬಕ್, ಹಿತ್ತೆ ಬಾಯ್ಕಾ ಮಾನ್ಸಾ ತಮ್ಮುಜ್ ದೆವಾ ಸಾಟ್ನಿ ರಡುನ್ಗೆತ್ ಬಸಲ್ಯಾನಿ.<verse eid="EZK 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 8:15" />ತೆನಿ ಮಾಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, “ನರ್ ಮಾನ್ಸಾ, ಹೆ ಸಗ್ಳೆ ಬಗಟ್ಲೆ ಕಾಯ್? ತಿಯಾ ಹೆಚ್ಯಾನ್ಬಿ ಲೈ ಬುರ್ಶಿ ಕಾಮಾ ಬಗ್ತಯ್”, <verse eid="EZK 8:15" /><verse number="16" style="v" sid="EZK 8:16" />ತೆನಿ ಮಾಕಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಭುತ್ತುರ್ಲ್ಯಾ ಭಾಗಾಚ್ಯಾ ದಾರಾತ್ ಮಾಕಾ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್; ಅಬಕ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ದಾರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಹೊತ್ತ್ಯಾ ಮಂಟಪಾಕ್ ಅನಿ ಬಲಿ ಭೆಟ್ವುತ್ತಲ್ಯಾ ಅಲ್ತಾರಿಚ್ಯಾ ಮದ್ದಿ ಲೈ ಕರುನ್ ಪಂಚಿಸ್ ಘವ್ಮಾನ್ಸಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗುಡಿಕ್ ಪಾಟ್ ಕರುನ್ ಘೆವ್ನ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ಡೆ ತೊಂಡ್ ಕರುನ್ ಘೆವ್ನ್ ದಿಸಾಕ್ ಫುಜ್ಯಾ ಕರಿತ್ ಹೊತ್ತೆ.<verse eid="EZK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 8:17" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, “ನರ್ ಮಾನ್ಸಾ, ಹೆ ಸಗ್ಳೆ ಬಗ್ತೆಯ್ ಕಾಯ್? ಜುದೆವಾಂಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ತೆನಿ ಕರುಲಾಗಲ್ಲಿ ಸಗ್ಳಿ ಬುರ್ಶಿ ಕಾಮಾ ಕಾಯ್ಬಿ ಮೊಟಿ ನ್ಹಯ್ ಮನುನ್ ಯೆವಜ್ಲಾತ್ ಕಾಯ್ಕಿ? ದೆಶ್ ಸಗ್ಳೊ ಸಂಕಟಾನ್ ಭರುನ್ ಥವಲ್ಲೆ ಯೆವ್ಡೆಚ್ ನಸ್ತಾನಾ ಮಾಕಾಬಿ ಕಿಡ್ವುಚೆ ಮನುನ್ ಕಟ್ಪಟ್ ಕರುಲಾತ್; ಬಗ್, ನಾಕಾಕ್ ಟಾಳಿಯಾ ಘಾಲುನ್ ಘೆತಾತ್”. <verse eid="EZK 8:17" /><verse number="18" style="v" sid="EZK 8:18" />ತೆಚ್ಯಾ ಸಾಟ್ನಿ ಮಿಯಾ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ರಾಗಾನ್ ಚಲ್ತಾ, ಅನಿ ದಯಾ ದಾಕ್ವಿನಾ, ತೆಂಕಾ ಹುರ್ವಿನಾ; ತೆನಿ ರಡಿತ್ ಬೊಬ್ ಮಾರುನ್ ಘೆಟಲ್ಲೊ ಮೊಟ್ಟೊ ಅವಾಜ್ ಮಾಜ್ಯಾ ಕಾನಾತ್ ಪಡ್ಲ್ಯಾಬಿ ಆಯ್ಕಿನಾ.<verse eid="EZK 8:18" /></para>
  <chapter eid="EZK 8" />
  <chapter number="9" style="c" sid="EZK 9" />
  <para style="s">ಜರುಜಲೆಮಾಕ್ ಶಿಕ್ಷ್ಯಾ ದಿಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 9:1" />ಮಾನಾ ತೆನಿ, ಮಾಕಾ ಆಯ್ಕಿ ಸಾರ್ಕೆ ಮೊಟ್ಯಾನಿ, ಶಾರಾಕ್ ಶಿಕ್ಷ್ಯಾ ದಿವ್ಕ್ ಶಕ್ತ್ ಹೊತ್ತ್ಯಾನೊ, ತುಮಿ ಸಗ್ಳೆ ಜನಾ ಜಿವ್ ಕಾಡುಕ್ ಪಾಜೆ ಹಿಲ್ಲಿ ತಯಾರ್ ಘೆವ್ನ್ ಜಗ್ಗೊಳ್ ಯೆವಾ, ಮನ್ತಲೊ ಆವಾಜ್ ಮಾಜ್ಯಾ ಕಾನಾತ್ ಪಡ್ಲಿ. <verse eid="EZK 9:1" /><verse number="2" style="v" sid="EZK 9:2" />ಎಗ್ದಮ್ ಭಯಾನಕ್ ಹತಿಯಾರ್ ಧರುನ್ ಘೆವ್ನ್ ಸಾ ಘವ್ಮಾನ್ಸಾ ದಿಸ್ ಉಗ್ವಾತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ತೊಂಡ್ ಕರುನ್ ಹೊತ್ತ್ಯಾ ಪಿಡ್ಲ್ಯಾ ದಾರಾಕ್ ಯೆಲ್ಯಾನಿ; ಅನಿ ಕಿಮ್ತಿಚಿ ಕಪ್ಡೆ ನೆಸಲ್ಲೊ ಎಕ್ ಮಾನುಸ್ ಬರ್ವನ್ಗಿಕ್ ವಾಪರ್ತಲೆ ವಸ್ತ್ ಕಂಬ್ರೆಕ್ ಭಾಂದುನ್ ಘೆವ್ನ್ ತೆಂಚ್ಯಾ ಮದ್ದಿ ಹೊತ್ತೊ, ಹೆನಿ ಸಗ್ಳ್ಯಾನಿ ಭುತ್ತುರ್ ಜಾವ್ನ್ ತಾಂಬ್ಯಾಚ್ಯಾ ಬಲಿ ಭೆಟ್ವುತಲ್ಯಾ ಅಲ್ತಾರಿಕ್ಡೆ ಇಬೆ ಹೊತ್ತ್ಯಾನಿ.<verse eid="EZK 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 9:3" />ತನ್ನಾಚ್ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ದೆವಾಚೊ ಉಜ್ವೊಡ್ ಕೆರುಬಿಕ್ ಸೊಡುನ್ ವರ್‍ತಿ ಚಡುನ್ ಗುಡಿಚ್ಯಾ ಹುಂಬ್ಡ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಇಬೆ ಹೊತ್ತೆ; ತನ್ನಾ ಕಿಮ್ತಿಚಿ ಕಪ್ಡೆ ನೆಸುನ್ ಬರವನ್ಗಿಕಾರಾಚಿ ಬರ್ವನ್ಗಿಕ್ ವಾಪರ್ತಲೆ ವಸ್ತ್ ಕಂಬ್ರೆಕ್ ಭಾಂದುನ್ ಘೆಟಲ್ಲ್ಯಾ ತೆಕಾ ಸರ್ವೆಸ್ಪರಾನ್ ಬಲ್ವುನ್, <verse eid="EZK 9:3" /><verse number="4" style="v" sid="EZK 9:4" />ತನ್ನಾ ದೆವಾನ್ ತೆಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, “ತಿಯಾ ಜರುಜಲೆಮಾಚ್ಯಾ ಶಾರಾಕ್ನಿ ಪರ್‍ತುನ್ ಥೈ ಚಲ್ತಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾಕ್ನಿ ನರಳುನ್ ಗೊಳಾಟ್ ಕರುಲಾಗಲ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಕಪ್ಳಾಚ್ಯಾ ವರ್‍ತಿ ವಳಕ್ ಕರ್”.<verse eid="EZK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 9:5" />ಅನಿ ತೆನಿ ಹುರಲ್ಯಾಕ್ನಿ ಸಾ ಲೊಕಾಕ್ನಿ, ತುಮಿ ಶಾರ್‍ಹಾತ್ ಹೆಚ್ಯಾ ಪಾಟ್ನಾ ಫಿರುನ್ಗೆತ್ ಜಾವ್ನ್ ತುಮಿ ಕೊನಾಕ್ಬಿ ಮುಲಾಜೊ ಬಗಿನಸ್ತಾನಾ ಜಿವ್ ಕಾಡುಚೆ, ಅನಿ ಕೊನಾಕ್ಬಿ ಹುರ್ವುನಕಾಸಿ, <verse eid="EZK 9:5" /><verse number="6" style="v" sid="EZK 9:6" />ಮ್ಹಾತಾರ್ಯಾ ಘೊಮನ್ಸಾಕ್ನಿ, ದಾಂಡ್ಗ್ಯಾ ಘೊಮಾನ್ಸಾಕ್ನಿ, ಅನಿ ದಾಂಡ್ಗ್ಯಾ ಬಾಯ್ಕಾಮಾನ್ಸಾಕ್ನಿ ಅನಿ ಆವ್ಸಿಯಾಕ್ನಿ, ಪೊರಾಕ್ನಿ, ಮನುನ್ ಬಗಿ ನಸ್ತಾನಾ ಸಗ್ಳ್ಯಾಂಚೊ ಜಿವ್ ಕಾಡಾ; ಖರೆ ವಳಕ್ ಹೊತ್ತ್ಯಾಕ್ನಿ ಕೊನಾಕ್ನಿ ಆಪ್ಡುನಕಾಸಿ; ತನ್ನಾ ತೆನಿ ದೆವಾಚ್ಯಾ ಪವಿತ್ರ್ ಜಾಗ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ಹೊತ್ತ್ಯಾ ಜಾಂನ್ತ್ಯಾನಿಕ್ನಾ ಧರುನ್ ಹರ್ ಎಕ್ಲ್ಯಾಕ್ ಜಿವಾನಿ ಮಾರಿತ್ ಗೆಲ್ಯಾನಿ. <verse eid="EZK 9:6" /><verse number="7" style="v" sid="EZK 9:7" />ತನ್ನಾ ತೆನಿ ತೆಂಕಾ, ಗುಡಿಚ್ಯಾ ಅಂಗ್ನಾತ್ನಿ ಮ್ಹಡ್ಯಾನಿ ಭರುನ್ ದೆವಾಚಿ ಗುಡಿಕ್ ಅಪಡ್ಸಿಪಡ್ ಕರಾ ಜಾವಾ ಮಟ್ಲ್ಯಾನ್, ತನ್ನಾ ತೆನಿ ಜಾವ್ನ್ ಶಾರ್‍ಹಾತ್ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಜಿವ್ ಕಾಡ್ಲ್ಯಾನಿ.<verse eid="EZK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 9:8" />ತೆನಿ ಜಿವ್ ಕಾಡುನ್ಗೆತ್ ರ್‍ಹಾತಾನಾ, ಥೈ ಎಕ್ಲೊಚ್ ಹುರಲ್ಲೊ ಮಿಯಾ ಡಬ್ಬ್ ಪಡುನ್ ಅಯ್ಯೊ ಸರ್ವೆಸ್ಪರ್ ದೆವಾ, ತಿಯಾ ಜರುಜಲೆಮಾಚ್ಯಾ ವರ್‍ತಿ ತುಜೊ ರಾಗಾ ವೊತುನ್ ಜರುಜಲೆಮಾತ್ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ನಾಸ್ ಕರ್ತಯ್ ಕಾಯ್ ಮನುನ್ ಮಾಗ್ಲೊ.<verse eid="EZK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 9:9" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, ಇಜ್ರಾಯೆಲ್ ಅನಿ ಜುದೆವಾಂಚ್ಯಾ ಬುರ್ಸೆಪಾನ್ ಲೈ ಹೊಲಾ; ಅನಿ ದೆಶ್ ಪುರಾ ರಕ್ತಾನ್ ಭರಲ್ಲೆ ಹಾಯ್, ಜರುಜಲೆಮ್ ಶಾರ್ ಅಪ್ರಾದಾನ್ ಬರಲ್ಲೆ ಹಾಯ್; ತ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾನಿ ಸರ್ವೆಸ್ಪರಾನ್ ದೆವಾನ್ ಅಮ್ಚೊ ದೆಶ್ ಸೊಡುನ್ ಸೊಡ್ಲಾ, ಸರ್ವೆಸ್ಪರ್ ಬಗಿನಾ ಹೊಲಾ ಮನುನ್ ಬೊಲುನ್ಗೆತ್ ಹೊತ್ತ್ಯಾನಿ. <verse eid="EZK 9:9" /><verse number="10" style="v" sid="EZK 9:10" />ಮಿಯಾ ತೆಂಕಾ ಮುಲಾಜೊಬಿ ಬಗಿನಾ, ದಯಾ ದಾಕ್ವಿನಾ, ತೆಂಚ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾಚ್ಯಾ ವಯ್ನಾ ತೆಂಕಾ ಶಿಕ್ಷ್ಯಾ ದಿವ್ನುನುಚ್ ದಿತಾ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="EZK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 9:11" />ತನ್ನಾಚ್ ಕಿಮ್ತಿಚಿ ಫಾಳಿಯಾ ಧಾಪುನ್ ಘೆವ್ನ್ ಬರ್ವನ್ಗಿಕ್ ವಾಪರ್ತಲೊ ವಸ್ತ್ ಕಂಬ್ರೆಕ್ ಭಾಂದುನ್ಗೆವ್ನ್ ಮಾನುಸ್ ಪರ್‍ತುನ್ ಎವ್ನ್, ತಿಯಾ ಹುಕುಮಾ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಕರುನ್ ಹೊಲಾ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="EZK 9:11" /></para>
  <chapter eid="EZK 9" />
  <chapter number="10" style="c" sid="EZK 10" />
  <para style="s">ದೆವಾಚಿ ಮಹಿಮಾ ದೆವಾಚಿ ಗುಡಿಕ್ ಸೊಡುನ್ ಗೆಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 10:1" />ತನ್ನಾ ಮಿಯಾ ಬಗ್ತಾನಾ ಕೆರುಬಿಯಾಚ್ಯಾ ಟಕ್ಲ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ನಿಳ್ಯಾ ಕಿಮ್ತಿಚ್ಯಾ ಫೊಡ್ಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಹೊಳಾವ್ತಲ್ಯಾ ಸಿಂವಾಸನಾಚೊ ಆಕಾರ್ ಸಾರ್ಕೆ ದಿಸ್ಲೆ. <verse eid="EZK 10:1" /><verse number="2" style="v" sid="EZK 10:2" />ತೆನಿ ಕಿಮ್ತಿಚೆ ಕಪ್ಡೆ ನೆಸಲ್ಲ್ಯಾ ತ್ಯಾ ಮಾನ್ಸಾಕ್, ತಿಯಾ ಗರಗರ್ ಫಿರ್ತಲ್ಯಾ ಚಕ್ರಾಚ್ಯಾ ಮದ್ದಿ ಕೆರುಬಿಯಾಚ್ಯಾ ಖಾಲ್ತಿ ಜಾ ಕೆರುಬಿಯಾಂಚ್ಯಾ ಮದ್ನಾ ಪೊಸೊ ಬರ್ ಆಗಿಚೆ ಇಂಗ್ಳೆ ಭರುನ್ ಘೆವ್ನ್ ಶಾರಾಚ್ಯಾ ವರ್‍ತಿ ಹೊಡಾಂಗ್ ಮನುನ್ ಸಾಂಗ್ತಾನಾ ತನ್ನಾ ತೊ ಮಾಜ್ಯಾ ಡೊಳ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ನಾ ಥೈ ಭುತ್ತುರ್ ಗೆಲೊ.<verse eid="EZK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 10:3" />ತೊ ಭುತ್ತುರ್ ಗೆಲ್ಲ್ಯಾ ತನ್ನಾ ಕೆರುಬಿಯಾ ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ಇಬೆ ಹೊತ್ತಿ, ತನ್ನಾ ಮೊಡಾ ಭುತ್ತುರ್ಲ್ಯಾ ಅಂಕ್ನಾತ್ ಭರ್ಲೆ. <verse eid="EZK 10:3" /><verse number="4" style="v" sid="EZK 10:4" />ಅಸಿ ರ್‍ಹಾತಾನಾ, ಸರ್ವೆಸ್ಪರಾಚೊ ಉಜ್ವೊಡ್ ಕೆರುಬಿಯಾಕ್ನಿ ಸೊಡುನ್ ವರ್‍ತಿ ಜಾವ್ನ್ ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಹುಂಬ್ಡ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಇಬೆ ರಾಲಿ; ದೆವಾಚ್ಯಾ ಗುಡಿತ್ ಪುರಾ ಮೊಡಾ ಭರ್ಲೆ, ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾಚೊ ಉಜ್ವೊಡ್ ಅಂಕ್ನಾತ್ ಪುರಾ ಪಗಳ್ಳಿ. <verse eid="EZK 10:4" /><verse number="5" style="v" sid="EZK 10:5" />ತನ್ನಾ ಕೆರುಬಿಯಾಂಚ್ಯಾ ಫಾಕುಟ್ಯಾಚೊ ಆವಾಜ್ ಸಗ್ಳೆ ಕರುಕ್ ಶಕ್ತ್ ಹೊತ್ತ್ಯಾ ದೆವಾನ್ ಬೊಲ್ತಲ್ಯಾ ಧನಾ ಸಾರ್ಕೊ ಗಂಬಿರ್ ಹೊವ್ನ್ ಭಾಯ್ಲ್ಯಾ ಅಂಕ್ನಾತ್ ಪತರ್ ಆಯ್ಕೊ ಯೆಲೊ.<verse eid="EZK 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 10:6" />ತೆನಿ ಕಿಮ್ತಿಚೆ ಕಪ್ಡೆ ನೆಸುನ್ ಹೊತ್ತ್ಯಾ ಮಾನ್ಸಾಕ್, ತಿಯಾ ಗರಾಗರ್ ಫಿರ್ತಲ್ಯಾ ಚಕ್ರಾಚ್ಯಾ ಮದ್ದಿ ಜಾವ್ನ್ ಕೆರುಬಿಮಾಂಚ್ಯಾ ಮದ್ನಾ ಆಗ್ ಕಾಡುನ್ ಘೆ, ಮನುನ್ ಹುಕುಮ್ ದಿತಾನಾ, ತೊ ಭುತ್ತುರ್ ಜಾವ್ನ್ ಎಕ್ ಚಕ್ರಾಚ್ಯಾ ಭಾಜುಕ್ ಇಬೆ ರಾಲೊ. <verse eid="EZK 10:6" /><verse number="7" style="v" sid="EZK 10:7" />ತನ್ನಾ ಎಕ್ ಕೆರುಬಿನ್ ಕೆರುಬಿಮಾಚ್ಯಾ ಮದ್ನಾ ಹಾತ್ ಲಾಂಬ್ ಕರುನ್ ಆಗ್ ಕಾಡುನ್ ಘೆವ್ನ್ ಕಿಮ್ತಿಚೆ ಕಪ್ಡೆ ನೆಸಲ್ಯಾಚ್ಯಾ ಹಾತಿತ್ ದಿಲ್ಯಾನ್. ತೊ ತೆ ಘೆವ್ನ್ ಭಾಯ್ರ್ ಗೆಲೊ.<verse eid="EZK 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 10:8" />ಕೆರುಬಾಂಚ್ಯಾ ಫಾಕುಟ್ಯಾಂಚ್ಯಾ ಖಾಲ್ತಿ ಮಾನ್ಸಾಚ್ಯಾ ಹಾತ್ ಸಾರ್ಕಿ ಹಾತಾ ದಿಸ್ಲಿ. <verse eid="EZK 10:8" /><verse number="9" style="v" sid="EZK 10:9" />ಅಬಕ್, ಮಿಯಾ ಬಗಿತ್ ರ್‍ಹಾತಾನಾಚ್ ತ್ಯಾ ಕೆರುಬಿಯಾಂಚ್ಯಾ ಭೊತ್ಯಾನಿ ಎಕೆಕ್ ಚಕ್ರಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಚಾರ್ ಚಕ್ರಾ ಹೊತ್ತಿ, ತ್ಯಾ ಚಕ್ರಾಂಚೊ ರಂಗ್ ಕಿಮ್ತಿಚೊ ಗುಂಡೊ ಹೊಳಾವ್ತಲ್ಯಾ ಮೊತಿ ಸರ್ಕೊ ಹೊಳ್ದಿ. <verse eid="EZK 10:9" /><verse number="10" style="v" sid="EZK 10:10" />ತೆಂಚೊ ರುಪ್ ಕಸಿ ಮಟ್ಲ್ಯಾರ್, ಎಕ್ ಚಕ್ಕರಾತ್ ಅನಿ ಎಕ್ ಚಕ್ಕರ್ ಆಡ್ವೆ ಲಾವ್ನ್ ರಚಲ್ಲೆ ಸಾರ್ಕೆ ಹೊತ್ತಿ. ತಿ ಚಾರಿಬಿ ಎಕುಚ್ ನಮುನಿ ಹೊತ್ತಿ. <verse eid="EZK 10:10" /><verse number="11" style="v" sid="EZK 10:11" />ತಿ ಪರತ್ ತಾನಾ ಚಾರ್ ಕಡೆನ್ಬಿ ಖಲ್ಯಾಕ್ಡೆಬಿ ಪರ್ತಿತ್, ಖರೆ ವ್ಹಾಕ್ಡೆ ಹೊವ್ನ್ ಫಿರಿ ನಸಿತ್, ಫಿಡೆ ತೊಂಡ್ ಕರುನ್ ಜಾಯ್ತ್ ಖರೆ ವ್ಹಾಂಕ್ಡೆ ಹೊವ್ನ್ ಜಾಯ್ ನಸಿತ್. <verse eid="EZK 10:11" /><verse number="12" style="v" sid="EZK 10:12" />ಅನಿ ಕೆರುಬಿಯಾಂಚಿ ಡುಬ್ಬರ್, ಹಾತ್, ಫಾಕುಟೆ, ಅನಿ ಸಗ್ಳೆ ಆಂಗಾತ್ಲ್ಯಾ ಭಾಗಾಕ್ ಚಕ್ರಾಕ್ನಿಬಿ ಡೊಳೆ ಭೊತ್ಯಾನಿ ಭರಲ್ಲೆ. ಚಾರ್ ಕೆರುಬಿಯಾತ್ನಿ ಎಕೆಕ್ಲ್ಯಾಕ್ ಎಕೆಕ್ ಚಕ್ಕರ್ ಹೊತ್ತೆ. <verse eid="EZK 10:12" /><verse number="13" style="v" sid="EZK 10:13" />ಅನಿ ಮಿಯಾ ಆಯ್ಕಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತ್ಯಾ ಚಕ್ಕರಾಚಿ ನಾವ್ ಗಿರ್ಗಿರ್ ಫಿರ್ತಲಿ ಚಕ್ರಾ ಮನುನ್ ಹೊತ್ತೆ.<verse eid="EZK 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 10:14" />ಅನಿ ಎಕೆಕ್ ಕೆರುಬಿಯಾಕ್ನಿ ಚಾರ್ ತೊಂಡಾ ಹೊತ್ತಿ, ಪಯ್ಲೆಚೆ ಕೆರುಬಿಚೆ ತೊಂಡ್, ದೊನ್ವೆಚೆ ಮಾನ್ಸಾಚೆ, ತಿನ್ವೆಚೆ ಸಿಂವಾಚೆ, ಚಾರ್ವೆಚೆ ಗಿಡ್ಗ್ಯಾಚೆ ತೊಂಡ್, <verse eid="EZK 10:14" /><verse number="15" style="v" sid="EZK 10:15" />ತಿ ಕೆರುಬಿಯಾ ವರ್‍ತಿ ಚಡ್ಲಿ; ಮಿಯಾ ಕೆಬಾರ್ ನ್ಹಯಿಕ್ಡೆ ಬಗಲ್ಲಿ ಜಿವ್ದಾಳಾ ಹಿಚ್. <verse eid="EZK 10:15" /><verse number="16" style="v" sid="EZK 10:16" />ಅನಿ ಕೆರುಬಿಯಾ ಫಿಡೆ ಜಾತಾನಾ, ತೆಂಚಿ ಚಕ್ರಾಬಿ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾಚ್ ಜಾಯ್ತ್, ಕೆರುಬಿಯಾ ಜಿಮ್ನಿ ವಯ್ನಾ ಹುಡುಚೆ ಮನುನ್ ಫಾಕುಟೆ ಪಗಳ್ತಾನಾ, ಚಕ್ರಾಬಿ ವಾಂಕ್ಡೆ ಹೊಯ್ ನಸ್ತಾನಾ ಚಡ್ಲಿ, <verse eid="EZK 10:16" /><verse number="17" style="v" sid="EZK 10:17" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಜಿವ್ದಾನಿಯಾಂಚೊ ಆತ್ಮೊ ಚಕ್ಕರಾತ್ನಿ ಹೊತ್ತ್ಯಾ ವಯ್ನಾ ತಿ ಇಬೆ ರ್‍ಹಾತಾನಾ ಹಿಬಿ ಇಬೆ ರಾಯ್ತ್, ಅನಿ ತಿ ಹುಡ್ತಾನಾ ಹಿಬಿ ತೆಂಚೆ ವಾಂಗ್ಡಾಚ್ ಹುಡಿತ್.<verse eid="EZK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 10:18" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾಚೊ ಉಜ್ವೊಡ್ ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಹುಂಬ್ಡ್ಯಾಕ್ನಾ ಸೊಡುನ್ ಕೆರುಬಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಇಬೆ ರಾಲೊ. <verse eid="EZK 10:18" /><verse number="19" style="v" sid="EZK 10:19" />ತನ್ನಾ ಕೆರುಬಿಯಾ ಮಾಜ್ಯಾ ಡೊಳ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕುಚ್ ಫಾಕುಟೆ ಪಗ್ಳುನ್ ಘೆವ್ನ್ ಚಕ್ರಾಂಚ್ಯಾ ವಾಂಗ್ಡಾಚ್ ಜಿಮ್ನಿ ವಯ್ನಾ ಚಡುನ್ ಜಾವ್ನ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾತ್ ದಾರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಜಾವ್ನ್ ಇಬೆ ರಾಲಿ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಇಜ್ರಾಯೆಲಾಂಚೊ ದೆವ್ ಹೊಲ್ಲ್ಯಾ ಸರ್ವೆಸ್ಪರಾಚೊ ಉಜ್ವೊಡ್ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಇಬೆ ರ್‍ಹಾಲೆ. <verse eid="EZK 10:19" /><verse number="20" style="v" sid="EZK 10:20" />ತನ್ನಾ ಕೆಬಾರ್ ನ್ಹಯಿಕ್ಡೆ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ದೆವಾಚಿ ಗಾಡಿ ಹೊವ್ನ್ ಹೊತ್ತಿ ತನ್ನಾ ಮಾಕಾ ದಿಸಲ್ಲಿ ಜಿವ್ದಾನಿಯಾ ಹಿಚ್, ಹಿ ಕೆರುಬಿಮಾ ಮನುನ್ ಮಾಕಾ ಅತ್ತಾ ಕಳುನ್ ಯೆಲೆ.<verse eid="EZK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 10:21" />ಅನಿ ಎಕೆಕಾಕ್ ಚಾಚಾರ್ ತೊಂಡಾ, ಚಾಚಾರ್ ಫಾಕುಟೆ ಹೊತ್ತೆ; ತೆಂಚ್ಯಾ ಫಾಕುಟ್ಯಾಂಚ್ಯಾ ಖಾಲ್ತಿ ಮಾನ್ಸಾಚ್ಯಾ ಹಾತಿ ಸಾರ್ಕೆ ಹಾತಾ ಹೊತ್ತಿ. <verse eid="EZK 10:21" /><verse number="22" style="v" sid="EZK 10:22" />ತೆಂಚಿ ತೊಂಡಾ ಕೆಬಾರ್ ನ್ಹಯ್ಚ್ಯಾ ಜಗ್ಗೊಳ್ ಮಿಯಾ ಬಗಟಲ್ಲ್ಯಾ ತೊಂಡಾಚ್ಯಾ ಸಾರ್ಕೆ ಮಾಕಾ ದಿಸುನ್ ಯೆಲೆ, ತೆನಿ ತಿಚ್ ತೊಂಡಾ; ಅನಿ ಹರ್ ಜಿವಿಚಿ ತೊಂಡಾ ನಿಸಾನಿ ಜಾಯ್ತ್.<verse eid="EZK 10:22" /></para>
  <chapter eid="EZK 10" />
  <chapter number="11" style="c" sid="EZK 11" />
  <para style="s">ಜೆರುಜಲೆಮಾಚೆ ಖಂಡನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 11:1" />ಮಾನಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಆತ್ಮ್ಯಾನ್ ಮಾಕಾ ಉಕ್ಲುನ್ ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಹೊತ್ತ್ಯಾ ದಾರಾಕ್ಡೆ ಘೆವ್ನ್ ಜಾವ್ನ್ ಇಬೆ ಕರ್ಲ್ಯಾನ್, ಥೈ ಪಂಚಿಸ್ ಲೊಕಾ ಹೊತ್ತಿ, ತ್ಯಾತುರ್ ಇಜ್ರಾಯೆಲಾಚಿ ದೊನ್ ಮುಖಂಡಾ ಅಜ್ಜುರಾಚೊ ಲೆಕ್ ಝಾಜಾನಿಯಾ ಅನಿ ಬೆನಾಮಿಯಾಚೊ ಲೆಕ್ ಪೆಲಾತಿಯಾ ಹೊತ್ತೆ ಮಿಯಾ ಬಗಟ್ಲೊ.<verse eid="EZK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 11:2" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, “ನರ್ ಮಾನ್ಸಾ, ಹೆನಿ ಶಾರ್‍ಹಾತ್ನಿ ಬುರ್ಶಿ ಯೌಜನ್ ಕರುನ್ ಲೊಕಾಕ್ನಿ ಬುರ್ಶಿ ಸಲಹಾ ದಿತಲಿ ಲೊಕಾ ಹಿಚ್”. <verse eid="EZK 11:2" /><verse number="3" style="v" sid="EZK 11:3" />ತೆನಿ ಸಾಂಗ್ತಾತ್, ತೆನಿ ಘರ್ ಭಾಂದ್ತಲೊ ಎಳ್ ಅಜುನ್ ಯೆವ್ಕನಾ, ಹೆ ಶಾರ್ ಎಕ್ ಟೊಪ್, ಅನಿ ಅಮಿ ತ್ಯಾತುರ್‍ಲೆ ಮಾಸ್ ಮನುನ್ ಸಾಂಗ್ತಾತ್. <verse eid="EZK 11:3" /><verse number="4" style="v" sid="EZK 11:4" />ತಸಿ ಹೊವ್ನ್, ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ತೆಂಚ್ಯಾ ವಿರೊಧ್ ಪರ್ವಾದ್ ಕರ್, ಯೆ ನರ್ ಮಾನ್ಸಾ. <verse eid="EZK 11:4" /><verse number="5" style="v" sid="EZK 11:5" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾಚೊ ಆತ್ಮೊ ಮಾಜ್ಯಾತ್ ಯೆಲೊ, ಅನಿ ಮಾಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೆ ಮನ್ತಾ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾನು ತುಮಿ ಕಾಯ್ ಬೊಲುಲ್ಯಾಸಿ, ಸಮಾ ತುಮ್ಚ್ಯಾ ಮನಾತ್ನಿ ಹಾಸಲ್ಲಿ ಯೌಜನ್ ಗೊತ್ತುಚ್ ಹಾಯ್ ಮನುನ್ ಸಾಂಗ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="EZK 11:5" /><verse number="6" style="v" sid="EZK 11:6" />ತುಮಿ ಹ್ಯಾ ಶಾರ್‍ಹಾತ್ನಿ ಲೈ ಲೊಕಾಕ್ನಿ ಜಿವಾನಿ ಮಾರಿ ಸಾರ್ಕೆ ಕರುನ್ ಸಗ್ಳಿ ವೊನಿಯಾ ಮ್ಹಡ್ಯಾನಿ ಭರಿ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾಸಿ.<verse eid="EZK 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 11:7" />ತಸಿ ಹೊವ್ನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸಿ ಮನ್ತಾ, ತುಮ್ಚ್ಯಾ ಚುಕೆನ್ ಶಾರ್‍ಹಾತ್ ಪಡಲ್ಲಿ ಮ್ಹಡಿಯಾ, ತಿಚ್ ಟೊಪಾತ್ಲೆ ಮಾಸ್ ಅನಿ ಹೆ ಶಾರುಚ್ ಟೊಪ್, ಮಿಯಾ ತುಮ್ಕಾತರ್ ಥೈತ್ನಾ ಕಾಡುನ್ ಟಾಕ್ತಾ. <verse eid="EZK 11:7" /><verse number="8" style="v" sid="EZK 11:8" />ತಲ್ವಾರಾಕ್ ಭಿಂವನ್ತ್ಯಾಸಿ ಕಾಯ್ ಕಾಯ್? ತುಮ್ಕಾ ತಲ್ವಾರಾನುಚ್ ಮಾರ್ತಾ. ಹಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್. <verse eid="EZK 11:8" /><verse number="9" style="v" sid="EZK 11:9" />ಮಿಯಾ ತುಮ್ಕಾ ಹ್ಯಾ ಶಾರ್‍ಹಾತ್ನಾ ಭಾಯ್ರ್ ಕಾಡುನ್ ದುಸ್ರ್ಯಾಚ್ಯಾ ಹಾತಿತ್ ದಿವ್ನ್, ಶಿಕ್ಷ್ಯಾ ದಿತಾ. <verse eid="EZK 11:9" /><verse number="10" style="v" sid="EZK 11:10" />ಅನಿ ತುಮಿ ತುಮ್ಚ್ಯಾ ತಲ್ವಾರಿಕ್ ಗಾವ್ತ್ಯಾಸಿ, ಹೆಚ್ಯಾ ವಯ್ನಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಹದ್ದಿಚ್ಯಾ ಭುತ್ತುರುಚ್ ಮಿಯಾ ತುಮ್ಕಾ ಶಿಕ್ಷ್ಯಾ ದಿತಾ. ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ಕಳ್ತಾ. <verse eid="EZK 11:10" /><verse number="11" style="v" sid="EZK 11:11" />ಹೊ ಶಾರ್ ತುಮ್ಕಾ ಟೊಪ್ ಹೊವ್ನ್ ರ್‍ಹಾಯ್ನಾ, ಅನಿ ತುಮಿ ತ್ಯಾತುರ್‍ಲೆ ಮಾಸ್ಬಿ ಹೊಯ್ನ್ಯಾಸಿ, ಖರೆ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಹದ್ದಿರುಚ್ ಭುತ್ತುರುಚ್ ತುಮ್ಕಾ ಶಿಕ್ಷ್ಯಾ ದಿತಾ. <verse eid="EZK 11:11" /><verse number="12" style="v" sid="EZK 11:12" />ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ತುಮ್ಕಾ ಕಳ್ತಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತುಮಿ ಮಾಜಿ ನೆಮ್ ಪಾಳಿ ನಸ್ತಾನಾ, ತುಮ್ಚ್ಯಾಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ದೆಶಾಂಚಿ ಕರ್ನಿಯಾ ಪಾಳಲ್ಲ್ಯಾ ವಯ್ನಾ ತುಮ್ಕಾ ಹೆ ಸಗ್ಳೆ ಹೊತಾ. <verse eid="EZK 11:12" /><verse number="13" style="v" sid="EZK 11:13" />ಮಿಯಾ ಹೆ ಬೊಲ್ನೆ ಬೊಲುನ್ಗೆತ್ ರ್‍ಹಾತಾನಾಚ್, ಬೆನಾಮಿಯಾಚೊ ಲೆಕ್ ಪೆಲಿಯಾತ್ ಮರ್ಲೊ, ತನ್ನಾ ಮಿಯಾ ಡಬ್ಬ್ ಪಡುನ್ ಜೊರಾನ್ ಅಯ್ಯೊ ಸರ್ವೆಸ್ಪರ್ ದೆವಾ, ಇಜ್ರಾಯೆಲಾತ್ ಹುರಲ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಸತ್ತ್ಯಾ ನಾಸ್ ಕರ್ತೆ ಕಾಯ್? ಮನುನ್ ಬೊಬ್ ಮಾರ್ಲೊ.<verse eid="EZK 11:13" /></para>
  <para style="s">ದೆಶ್ ಹಾಳ್ ಕರ್ನಾರ್ಯಾಕ್ನಿ ದೆವಾಚಿ ಗೊಸ್ಟ್</para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 11:14" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾಜ್ಯಾಕ್ನಾ ಬೊಲುನ್, <verse eid="EZK 11:14" /><verse number="15" style="v" sid="EZK 11:15" />ನರ್ ಮಾನ್ಸಾ, ತುಜಿ ಭಾವಾ, ಸಯ್ರೆ, ಜೆರುಜಲೆಮಾಚೆ ಪಿಳ್ಗಿತ್ ಹುರಲ್ಲೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಕ್ನಾ ದುರ್ ಜಾವ್ನ್, ಹೊ ದೆಶ್ ಅಮ್ಕಾ ಸ್ವತಾಚೆ ಹೊವ್ನ್ ಗಾವ್ಲಾ ಮನುನ್ ಚಾಳ್ವುಲ್ಯಾಸಿ ಕಾಯ್.<verse eid="EZK 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 11:16" />ಅತ್ತಾ ಮಿಯಾ ತುಕಾ ಸಾಂಗ್ತಾತೆ ತುಜಾಕ್ನಾ ಬಂಧಿತ್ ಹೊತ್ತ್ಯಾಕ್ನಿ ಸಾಂಗ್, ಮಿಯಾಚ್ ತೆಂಕಾ ತೆಂಚ್ಯಾ ದೆಸಾತ್ನಾ ಧುರ್ ಕರುನ್ ದುಸ್ರ್ಯಾ ದೆಸಾತ್ನಿ ಥವ್ಲಾ, ಖರೆ ಆಜುನ್ಬಿ ಉಲ್ಲ್ಯಾ ಯೆಳಾಕ್ ಸಾಟ್ನಿ, ಮಿಯಾ ತೆನಿ ಜಾವ್ನ್ ಹೊತ್ತ್ಯಾಕ್ಡೆ ತೆಂಚೆಕ್ನಾ ಹಾವ್. <verse eid="EZK 11:16" /><verse number="17" style="v" sid="EZK 11:17" />ದೆವ್ ಅಸಿ ಸಾಂಗ್ತಾ, ತೆಂಕಾ ಲೊಕಾತ್ನಿ ಮಿಳ್ವುತಾ, ಪಗ್ಳುನ್ ಗೆಲ್ಲ್ಯಾ ದೆಶಾನಿತ್ನಾ ತೆಂಕಾ ಬಲ್ವುನ್, ಇಜ್ರಾಯೆಲ್ ದೆಶ್ ತೆಂಕಾ ದಿತಾ ಮನ್ತಾ. <verse eid="EZK 11:17" /><verse number="18" style="v" sid="EZK 11:18" />ತೆನಿ ಯೆಲ್ಲೆ ತನ್ನಾ, ಥೈತ್ಲಿ ಸಗ್ಳಿ ಬುರ್ಶಿ ಸಾಮಾನಾ ಅನಿ ಸಗ್ಳಿ ಬುರ್ಶಿ ಮುರ್ತಿಯಾ ಕಾಡುನ್ ಟಾಕ್ತ್ಯಾತ್. <verse eid="EZK 11:18" /><verse number="19" style="v" sid="EZK 11:19" />ಮಿಯಾ ತೆಂಕಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಎಕ್ ಮನ್ ಅನಿ ನ್ಹವೊ ಆತ್ಮೊ ಭುತ್ತುರ್ ಘಾಲ್ತಾ, ಮಿಯಾ ತೆಂಚ್ಯಾತ್ನಾ ಗುಂಡ್ಯಾ ಸಾರ್ಕೆ ಘಟ್ಲೊ ಕಾಳಿಂಜ್ ಕಾಡುನ್, ಮಾಸಾ ಸಾರ್ಕೆ ಮವ್ಲಿ ಕಾಳಿಂಜ್ ದಿತಾ. <verse eid="EZK 11:19" /><verse number="20" style="v" sid="EZK 11:20" />ತನ್ನಾ ತೆನಿ ಮಾಜಿ ನೆಮಾ ಪಾಳುನ್, ಮಾಜಿ ಹುಕುಮಾ ಚುಕಿ ನಸ್ತಾನಾ ಪಾಳ್ತಾತ್, ಅನಿ ತೆನಿ ಮಾಜಿ ಲೊಕಾ ಅನಿ ಮಿಯಾ ತೆಂಚೊ ದೆವ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="EZK 11:20" /><verse number="21" style="v" sid="EZK 11:21" />ಖರೆ ಕೊನಾಚೊ ಮನ್ ತೆಂಚ್ಯಾ ಬುರ್ಸ್ಯಾ ಸಾಮಾನಾಚ್ಯಾ ಸಾಟ್ನಿ, ಬುರ್ಸ್ಯಾ ಮುರ್ತಿಯಾಂಚಿ ಪುಜಾ ಕರ್‍ತಾತ್, ತೆಂಚಿ ಬುರ್ಶಿ ಚಾಲ್ ತೆಂಚ್ಯಾ ಟಕ್ಲ್ಯಾಕ್ ಭಾಂದ್ತಾ. ಹಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್.<verse eid="EZK 11:21" /></para>
  <para style="s">ದೆವಾಚಿ ಮಹಿಮಾ ಜರುಜಲೆಮ್ ಸೊಡುನ್ ಗೆಲ್ಲಿ</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 11:22" />ಮಾನಾ ಚಕ್ರಾಚ್ಯಾ ಭಾಜುಕ್ ಕೆರುಬಿಯಾಂಚೆ ಫಾಕುಟೆ ಪಗಳ್ಳೆ. ಇಜ್ರಾಯೆಲ್ ದೆವಾಚ್ಯಾ ಮಹಿಮಾ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಇಬೆ ರ್‍ಹಾಲೆ. <verse eid="EZK 11:22" /><verse number="23" style="v" sid="EZK 11:23" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾಚೊ ಮಹಿಮಾ ಶಾರಾಚ್ಯಾ ಮದ್ನಾ ಚಡುನ್ ಶಾರಾಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಹೊತ್ತ್ಯಾ ಮಡ್ಡಿರ್ ಜಾವ್ನ್ ಇಬೆ ರಾಲಿ. <verse eid="EZK 11:23" /><verse number="24" style="v" sid="EZK 11:24" />ತನ್ನಾ ದೆವಾಚ್ಯಾ ಆತ್ಮ್ಯಾನ್ ಮಾಕಾ ಉಕ್ಲುನ್ ಕಸ್ದಿಯಾಚ್ಯಾ ದೆಸಾತ್ ಬಂಧಿತ್ ಹೊತ್ತ್ಯಾ ಲೊಕಾಂಕ್ಡೆ ಜಗ್ಗೊಳ್ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್. ತನ್ನಾ ಮಾಕಾ ಹೊಲ್ಲಿ ದಿವ್ಯ್ ದರ್ಶನಾ ಮಾಯಾ ಹೊವ್ನ್ ಗೆಲಿ. <verse eid="EZK 11:24" /><verse number="25" style="v" sid="EZK 11:25" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ದಾಕ್ವಲ್ಲಿ ಸಗ್ಳಿ ಸಂಗ್ತಿಯಾ ಮಿಯಾ ಬಂಧಿತ್ ಹೊತ್ತ್ಯಾಕ್ನಿ ಲಗ್ಗುನಾ ಸಾಂಗ್ಲೊ.<verse eid="EZK 11:25" /></para>
  <chapter eid="EZK 11" />
  <chapter number="12" style="c" sid="EZK 12" />
  <para style="s">ಥೈ ರಾಯ್ ನಸಲ್ಲೊ ಪ್ರವಾದಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 12:1" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾಜ್ಯಾಕ್ಡೆ ಬೊಲುನ್, <verse eid="EZK 12:1" /><verse number="2" style="v" sid="EZK 12:2" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಘಾತ್ಕಿ ಘರಾನಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ವಸ್ತಿ ಹಾಸ್, ತ್ಯಾ ಘರಾನಾಚೆ ಘಾತಕ್ ಕರಲ್ಲ್ಯಾ ವಯ್ನಾ ಕಾನಾ ರಾವ್ನ್ ಬಿ ಕಿಂವ್ಡೆ ಡೊಳೆ ರಾವ್ನ್ ಬಿ ಕುಡ್ಡೆ ಮಟ್ಲ್ಯಾನ್.<verse eid="EZK 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 12:3" />ನರ್ ಮಾನ್ಸಾ, ಎಕ್ ಜಾಗ್ಯಾ ವಯ್ನಾ ದುಸ್ರ್ಯಾ ಜಾಗ್ಯಾರ್ ಜಾವ್ಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ಸಾಮಾನಾ ಗೊಳಾ ಕರುನ್ ಘೆವ್ನ್ ಸಾಂಚೆಕ್ಡೆಚ್ ತೆಂಚ್ಯಾ ಇದ್ರಾಕ್ನಾ ಜಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತಿಯಾ ರಾತಲೊ ಜಾಗೊ ಸೊಡುನ್ ತೆನಿ ಬಗ್ತಾ ಬಗ್ತಾನಾಚ್ ತೆಂಚ್ಯಾ ಇದ್ರಾಕ್ನಾಚ್ಯಾ ಜಾ. ತಿನಿ ಘಾತ್ಕೆ ಪಿಳ್ಗಿಚೆ ಹೊಲ್ಯಾರ್ಬಿ ಎಕ್ ಯೆಳಾಕ್ ಅಪ್ನಾಚೆ ಘಾತ್ಕೆ ಮನ್ ವಳ್ಕುನ್ ಘೆತಿಲ್. <verse eid="EZK 12:3" /><verse number="4" style="v" sid="EZK 12:4" />ತಿಯಾ ತುಜಿ ಸಾಮಾನಾ ಸಗ್ಳಿ ದಿಸಾಚ್ಯಾ ಉಜ್ವಾಡಾತುಚ್ ತೆಂಚ್ಯಾ ಇದ್ರಾಕ್ನಾ ಘರಾಚ್ಯಾ ಭಾರ್ಯ ಥವ್, ಅನಿ ಸಾಂಜೆ ತೆಂಚ್ಯಾ ಇದ್ರಾಕ್ನಾಚ್ ಚಲ್. <verse eid="EZK 12:4" /><verse number="5" style="v" sid="EZK 12:5" />ತೆನಿ ತುಕಾ ಬಗುನ್ಗೆತ್ ರ್‍ಹಾತಾನಾ ಭಿತ್ತಿ ಫೊಡುನ್ ವಾಟ್ ಕರುನ್ ತ್ಯಾತುರ್ನಾ ತುಜಿ ಸಾಮಾನಾ ಭಾರ್ಯ ಥವ್. <verse eid="EZK 12:5" /><verse number="6" style="v" sid="EZK 12:6" />ತೆಂಚ್ಯಾ ಡೊಳ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ತೆ ಖಾಂಜಾರ್ ವಾವ್ನ್ ಘೆ, ಕಾಳ್ಕಾತ್ ಘೆವ್ನ್ ಜಾ ಅನಿ ಜಿಮಿನ್ ದಿಸಿನಾ ಸಾರ್ಕೆ ತೊಂಡ್ ಧಾಪುನ್ ಘೆ, ಮಿಯಾ ತುಕಾ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಹಿ ಎಕ್ ವಳಕ್ ಕರ್ಲಾ. <verse eid="EZK 12:6" /><verse number="7" style="v" sid="EZK 12:7" />ತನ್ನಾ ಮಾಕಾ ಹುಕುಮಾ ಕರುನ್ ಸಾರ್ಲೊ, ದಿಸಾನಿ ಮಾಜಿ ಸಾಮಾನಾ ಘರ್‍ಹಾತ್ನಾ ತಿಕ್ಡಿ ಥವ್ನ್ ತಿನ್ಸಾನಾಕ್ ಮಾಜ್ಯಾ ಹಾತಿನ್ ಭಿತ್ತ್ ಫೊಡುನ್ ವಾಟ್ ಕರುನ್ ತಿ ಸಾಮಾನಾ ಬಾರ್ಯ್ ಘಾಲುನ್, ತೆಂಚ್ಯಾ ಡೊಳೆ ಇದ್ರಾಕ್ನಾ ಉಕ್ಲುನ್ ನೆಲೊ.<verse eid="EZK 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 12:8" />ದುಸ್ರ್ಯಾ ದಿಸಿ ಸಕ್ಕಾಳಿ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಮಾಕಾ ಆಯ್ಕೊ ಯೆಲಿ, <verse eid="EZK 12:8" /><verse number="9" style="v" sid="EZK 12:9" />ನರ್ ಮಾನ್ಸಾ, ಘಾತ್ಕಿ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಘರಾನ್ಯಾನ್ ತಿಯಾ ಕಾಯ್ ಕರುಲೆ? ಮನುನ್ ಇಚಾರಿತ್ ನ್ಹಯ್, <verse eid="EZK 12:9" /><verse number="10" style="v" sid="EZK 12:10" />ತಿಯಾ ತೆಂಕಾ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಹೆ ವಜ್ಜೆ ಜರುಜಲೆಮಾತ್ ರ್‍ಹಾತಲ್ಯಾ ರಾಜಾಕ್ನಿ ಅನಿ ಥೈ ರ್‍ಹಾತಲ್ಯಾ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಸಮಂದ್ ಪಡ್ಲಾ. <verse eid="EZK 12:10" /><verse number="11" style="v" sid="EZK 12:11" />ತೆಂಕಾ ಸಾಂಗ್, ಮಿಯಾ ತೆಂಕಾ ವಳಕ್ ಹೊವ್ನ್ ಹಾಯ್, ಮಿಯಾ ಕರಲ್ಯಾ ಸಾರ್ಕೆ ತೆಂಕಾ ಹೊತಾ, ತೆನಿ ತೆಂಚೊ ಜಾಗೊ ಸೊಡುನ್ ದುಸ್ರ್ಯಾ ಜಾಗ್ಯಾಕ್ ಜಾವ್ನ್ ಗುಲಾಮ್ ಹೊವ್ನ್ ರ್‍ಹಾತ್ಯಾತ್. <verse eid="EZK 12:11" /><verse number="12" style="v" sid="EZK 12:12" />ತೆಂಚ್ಯಾ ಮದ್ಲೊ ರಾಜಾಚೊ ಲೆಕ್ ಖಾಂಜಾರ್ ವಜ್ಜೆ ಘೆವ್ನ್ ತಿನ್ಸಾನಾಕ್ ಭಿತ್ತಿಕ್ ಫೊಡುನ್ ವಾಟ್ ಕರುನ್ ತ್ಯಾತುರ್ನಾ ಸಾಮಾನಾ ಭಾಯ್ರ್ ಘಾಲ್ತಾ, ತೊ ತೊಂಡ್ ಧಾಪುನ್ ಘೆತಾ, ಜಿಮಿನ್ ತೆಚ್ಯಾ ಡೊಳ್ಯಾಕ್ ದಿಸಿನಾ. <verse eid="EZK 12:12" /><verse number="13" style="v" sid="EZK 12:13" />ಖರೆ ಮಿಯಾ ತೆಕಾ ಬಲಿ ಟಾಕ್ತಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಮಿಯಾ ಗಾಟಲ್ಯಾ ಪಾಶ್ಯಾತ್ ತೊ ಗಾವುನ್ ಪಡ್ತಾ, ತೆಕಾ ಕಸ್ದಿಯಾ ದೆಸಾಕ್ ಬಾಬಿಲೊನಾಕ್ ನ್ಹೆತಾ, ತೊ ಥೈ ರ್‍ಹಾವ್ನ್ ಮರ್ತಾ. ಖರೆ ತೊ ದೆಶ್ ಬಗಿನಾ. <verse eid="EZK 12:13" /><verse number="14" style="v" sid="EZK 12:14" />ತೆಚ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಸೆವೆಕಾಕ್ನಿ, ತೆಜೊ ಸಯ್ನ್ ಮಿಯಾ ಸಗ್ಳ್ಯಾಕ್ಡೆ ವಾರ್ಯಾನ್ ಹುಡ್ವುನ್ ತೆಂಚ್ಯಾ ಪಾಟ್ನಾ ತಲ್ವಾರ್ ಭಿರ್ಕಟ್ತಾ. <verse eid="EZK 12:14" /><verse number="15" style="v" sid="EZK 12:15" />ಮಿಯಾ ತೆಂಕಾ ದೆಸಾತ್ನಿ ಪಗ್ಳುನ್ ಅನಿ ದುಸ್ರ್ಯಾ ದೆಸಾತ್ನಿ ಸಿಪ್ಡುನ್ ಜಾಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ತೆಂಕಾ ಕಳ್ತಾ. <verse eid="EZK 12:15" /><verse number="16" style="v" sid="EZK 12:16" />ಖರೆ ಮಿಯಾ ಉಲ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ, ತಲ್ವಾರ್, ಬರ್‍ಗಾಲ್ ಅನಿ ಪಿಡಾತ್ನಾ ವಾಚ್ವುನ್ ತೆನಿ ತೆಂಚಿ ಬುರ್ಶಿ ಕಾಮಾ ವಿಶಯಾತ್ ತೆಂಚಾಚ್ ಲೊಕಾಕ್ನಿ ಸಾಂಗಿ ಸಾರ್ಕೆ ಅವ್ಕಾಸ್ ಕರುನ್ ದಿತಾ, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ತೆಂಕಾ ಕಳ್ತಾ.<verse eid="EZK 12:16" /></para>
  <para style="s">ಖಾಪ್ತಲ್ಯಾ ಪರ್ವಾದ್ಯಾಚೊ ಚ್ಹಿನ್ನೊ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 12:17" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಜೆಕ್ಡೆ ಬೊಲ್ಯಾನ್, <verse eid="EZK 12:17" /><verse number="18" style="v" sid="EZK 12:18" />“ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಸಿತ್ ಜೆವ್ತಾನಾ ಖಾಪುನ್ಗೆತ್ ಜೆವ್ ಅನಿ ಪಾನಿ ಫಿತಾನಾ ಥರ್ಥರುನ್ಗೆತ್ ಪಾನಿ ಫಿ”. <verse eid="EZK 12:18" /><verse number="19" style="v" sid="EZK 12:19" />ತ್ಯಾ ದೆಸಾತ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ ಅಸಿ ಸಾಂಗ್, “ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್, ಇಜ್ರಾಯೆಲ್ ದೆಶಾಚ್ಯಾ ಜರುಜಲೆಮಾತ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ ವಿಶಯಾತ್ ಅಸೆ ಮನ್ತಾ, ತೆನಿ ಸಿತ್ ಜೆವ್ತಾನಾ ಕಡ್ಕಡುನ್ಗೆತ್ ಜೆವ್ತಾತ್ ಅನಿ ಪಾನಿ ಫಿತಾನಾ ಥರ್ಥರುನ್ಗೆತ್ ಪಾನಿ ಫಿತಾತ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ದೆಸಾತ್ಲ್ಯಾ ಬುರ್ಸ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವಯ್ನಾ ಥೈತ್ಲಿ ಆಸ್ತಿ ನಾಶ್ ಹೊವ್ನ್ ಜಾತಾ, ದೆಶ್ ಹಾಳ್ ಪಡ್ತಾ”. <verse eid="EZK 12:19" /><verse number="20" style="v" sid="EZK 12:20" />ತನ್ನಾ ಭರಲ್ಲಿ ಶಾರ್‍ಹಾತ್ಲಿ ಲೊಕಾ ನಸ್ತಾನಾ ಹಾಳ್ ಪಡುನ್ ಜಾತಾ, ಅಸೆ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮನ್ತಲೆ ಗೊತ್ತ್ ಹೊತಾ.<verse eid="EZK 12:20" /></para>
  <para style="s">ಸಾಂಗ್ನಿ ಅನಿ ಲೊಕಾತ್ನಿ ವಾಪ್ರುಪ್ ನಸಲ್ಲಿ ಬರಿ ಖಬರ್</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 12:21" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾಜೆಕ್ಡೆ ಬೊಲ್ಲ್ಯಾನ್. <verse eid="EZK 12:21" /><verse number="22" style="v" sid="EZK 12:22" />ನರ್ ಮಾನ್ಸಾ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಎಳ್ ಜಾವುನ್ಗೆತುಚ್ ರ್‍ಹಾತಾ, ದರ್ಶನಾ ಸಗ್ಳಿ ಪುರಾ ಹೊಯ್ನಾತ್. ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಬೊಲ್ತಲಿ ಹಿ ಸಾಂಗ್ನಿ ಕಸ್ಲಿ? <verse eid="EZK 12:22" /><verse number="23" style="v" sid="EZK 12:23" />ತೆಂಕಾ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸಿ ಮನ್ತಾ, ಮಿಯಾ ಹಿ ಸಾಂಗ್ನಿ ಸಾರ್ತಾ ಅನಿ ಕನ್ನಾಚ್ ಇಜ್ರಾಯೆಲಾತ್ನಿ ತಿ ಸಾಂಗ್ನಿ ವಾಪ್ರುಕ್ ಹೊಯ್ನಾ, ತೆಚ್ಯಾ ಬದ್ಲಿಕ್ ಎಳ್ ಎವ್ನ್ ಪಾವ್ಲಾ, ಅನಿ ದರ್ಶನಾ ಪುರಾ ಹೊತಲೊ ಎಳ್ ಜಗ್ಗೊಳ್ ಯೆಲಾ. <verse eid="EZK 12:23" /><verse number="24" style="v" sid="EZK 12:24" />ಹೆಚ್ಯಾನ್ ಫಿಡೆ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾತ್ನಿ ಕೊನಾಕ್ಬಿ ಝುಟಿ ದರ್ಶನ್ ಹೊಯ್ನಾ, ಅನಿ ಪಶ್ವನ್ಗಿಚಿ ಭವಿಶ್ ವಾನಿ ರ್‍ಹಾಯ್ನಾತ್. <verse eid="EZK 12:24" /><verse number="25" style="v" sid="EZK 12:25" />ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್, “ಮಿಯಾ ಬೊಲಲ್ಲೆ ಬೊಲ್ನೆ ಬೊಲುನುಚ್ ಬೊಲ್ತಾ, ಅನಿ ಮಿಯಾ ತೆ ಬೊಲಲ್ಲೆ ಬೊಲ್ನೆ ಚಲ್ತಾ, ಅತ್ತಾ ಸಾವ್ಕಾಸ್ ಹೊಯ್ನಾ, ಬುರ್ಶಾ ಪಿಳ್ಗಿಚ್ಯಾನು ಮಿಯಾ ತುಮ್ಚ್ಯಾ ಕಾಳಾರ್ ಸಾಂಗಲ್ಲೆ ಯೆವ್ಡೆ ನಸ್ತಾನಾ ಬೊಲಲ್ಲೆ ಕರ್ತಾ” ಹಿ ದೆವಾಚಿ ಗೊಸ್ಟ್. <verse eid="EZK 12:25" /><verse number="26" style="v" sid="EZK 12:26" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಹಿ ಗೊಸ್ಟ್ ಸಾಂಗ್ಲ್ಯಾನ್, <verse eid="EZK 12:26" /><verse number="27" style="v" sid="EZK 12:27" />ನರ್ ಮಾನ್ಸಾ, “ಅಬಕ್ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ ಅಸಿ ಸಾಂಗ್ತಾತ್, ಹೆಕಾ ಹೊಲ್ಲಿ ದಿವ್ಯಾ ದರ್ಶನಾ ಲೈ ದುರ್ ಕಾಳಾಕ್ ಸಮಂದ್ ಪಡಲ್ಲೆ ಹಾಯ್”, ಲೈ ದಿಸಾಂಚ್ಯಾ ಮಾನಾ ಹೊತಲೆ ಅತ್ತ್ಯಾಚ್ ಹೊತಾ ಮನುನ್ ಸಾಂಗ್ತಾ. <verse eid="EZK 12:27" /><verse number="28" style="v" sid="EZK 12:28" />ಅಶೆ ಹೊವ್ನ್ ತಿಯಾ ತೆಂಕಾ ಅಸಿ ಸಾಂಗ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಸಿ ಸಾಂಗ್ತಾ, ಹೆಚ್ಯಾನ್ ಫಿಡೆ ಮಿಯಾ ಬೊಲಲ್ಲೆ ಘಡುಕ್ ಲೈ ಎಳ್ ಲಾಗಿನಾ, ಅನಿ ಮಿಯಾ ಬೊಲಲ್ಲೆ ಹೊವ್ನುಚ್ ಹೊತಾ. ಹಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್.<verse eid="EZK 12:28" /></para>
  <chapter eid="EZK 12" />
  <chapter number="13" style="c" sid="EZK 13" />
  <para style="s">ಝುಟ್ಯಾ ಗಂಡ್ ಪರ್ವಾದಿಯಾಂಚ್ಯಾ ವಿರೊಧ್ ಪರ್ವಾದ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 13:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಹಿ ಗೊಸ್ಟ್ ದಿಲ್ಯಾನ್, <verse eid="EZK 13:1" /><verse number="2" style="v" sid="EZK 13:2" />ನರ್ ಮಾನ್ಸಾ, ಪರ್‍ವಾದನ್ ಕರುನ್ ಸ್ವತಾಕ್ ಮನಾಕ್ ದಿಸಲ್ಲೆಚ್ ಪರ್ಗಟ್ ಕರುನ್ಗೆತ್ ಹೊತ್ತ್ಯಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಪರ್ವಾದಿಯಾಕ್ನಿ ಖಂಡನ್ ಕರುನ್ ಅಸೆ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಆಯ್ಕಾ. <verse eid="EZK 13:2" /><verse number="3" style="v" sid="EZK 13:3" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಸೊ ಮನ್ತಾ, ಕಸ್ಲೆಚ್ ಶಿಕ್ಷನ್ ನಸ್ತಾನಾ, ಸ್ವತಾಚಿ ಬುದ್ಗೆಡಿ ಪಿಶ್ಯಾ ಪರ್ವಾದಿಯಾಂಚಿ ಗತ್ ಕಾಯ್ ಸಾಂಗು! <verse eid="EZK 13:3" /><verse number="4" style="v" sid="EZK 13:4" />ಇಜ್ರಾಯೆಲಾ, ತುಜೆ ಪರ್ವಾದಿ ಹಾಳ್ ಪಡಲ್ಲ್ಯಾ ಜಾಗ್ಯಾ ವಯ್ಲ್ಯಾ ಕೊಲ್ಯಾಂಚ್ಯಾ ಗತಿನ್ ಹಾತ್. <verse eid="EZK 13:4" /><verse number="5" style="v" sid="EZK 13:5" />ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ದಿಸಾ ದಿಸಿ ಝಗ್ಡ್ಯಾಕ್ ಇಬೆ ರ್‍ಹಾವ್ಚೆ ಮನುನ್ ತುಮಿ ಭಿತ್ತಿಯಾಕ್ನಿ ರಾಕ್ವಲಿ ಥವ್ಕ್ ನಾತ್, ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ರಾಕ್ವನಿಕ್ ಸಾಟ್ನಿ ಕೊಸಳ್ತಲಿ ಭಿತ್ತ್ ಘಟ್ ಕರುಕ್ಬಿ ನ್ಯಾಸಿ. <verse eid="EZK 13:5" /><verse number="6" style="v" sid="EZK 13:6" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮನುನ್ ಸಾಂಗ್ತಲ್ಯಾ ಲೊಕಾಕ್ನಿ ದಿಸಲ್ಲ್ಯಾ ದರ್ಶನಾ ಖರಿಚ್, ಅನಿ ಆಯ್ಕಲ್ಲೆ ಝುಟೆ, ತೆಂಕಾ ಸರ್ವೆಸ್ಪರಾನ್ ಧಾಡುಕ್ನಾ, ತೆನಿ ಅಪ್ನಿ ಬೊಲಲ್ಲೆ ಬೊಲ್ನೆ ಖರೆ ಹೊತಾ ಮನುನ್ ಫುಕೊಟುಚ್ ಚಿಂತುನ್ಗೆವ್ನ್ ಹಾತ್. <verse eid="EZK 13:6" /><verse number="7" style="v" sid="EZK 13:7" />ಮಿಯಾ ಬೊಲಿನಸ್ತಾನಾ ರಾಲ್ಯಾರ್ಬಿ ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ ಮನುನ್ ಸಾಂಗಿತ್ ಹೊತ್ತ್ಯಾಂಚೆ ತುಮ್ಕಾ ದಿಸಲ್ಲೆ ದರ್ಶನ್ ಖರೆ ನ್ಹಯ್, ಅನಿ ತುಮಿ ಸಾಂಗಲ್ಲೆ ಭವಿಶ್ ಬಿ ಝುಟೆಚ್ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 13:8" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ತುಮಿ ಉಪ್ಪೆಕಾಕ್ ನಸಲ್ಲೆ ಬೊಲುನ್, ಝುಟಿ ದರ್ಶನಾ ಬಗಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ಅಬಕ್ ಮಿಯಾ ತುಮ್ಕಾ ವಿರೊದ್ ಹೊವ್ನ್ ಹಾಯ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಮಾಜಿ ಗೊಸ್ಟ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 13:8" /><verse number="9" style="v" sid="EZK 13:9" />ಝುಟಿ ದರ್ಶನಾ ಬಗುನ್ ಝುಟಿ ಭವಿಶ್ ಸಾಂಗ್ತಲ್ಯಾ ಪರ್ವಾದಿಯಾಕ್ನಿ ಮಿಯಾ ಹಾತ್ ಉಕಲ್ತಾ, ತೆನಿ ಮಾಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಜಾಂನ್ತ್ಯಾ ಬಯ್ಟೆಕಾತ್ನಿ ಮಿಳ್ತಲೆ ನಕ್ಕೊ, ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಪಟ್ಟಿತ್ ತೆಂಚಿ ನಾವಾ ಲಿವ್ತಲೆ ನಕ್ಕೊ, ತೆನಿ ಇಜ್ರಾಯೆಲ್ ದೆಸಾತ್ ಗುಸ್ತಲೆಬಿ ನಾ, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮನ್ತಲೆ ತುಮ್ಕಾ ಕಳ್ತಾ. <verse eid="EZK 13:9" /><verse number="10" style="v" sid="EZK 13:10" />ಸಮಾಧಾನಾನ್ ನಸ್ಲ್ಯಾರ್ಬಿ ತೆನಿ ಸಮಾಧಾನಾನ್ ಹಾತ್ ಮನುನ್ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಪಸ್ವುಲ್ಯಾನಿ ನ್ಹಯ್, ಎಕ್ಲ್ಯಾನ್ ಕೊನಿ ತರ್ಬಿ ಪಾತಳ್ ಭಿತ್ತ್ ಭಾಂದಲ್ಲಿ ರಾಲ್ಯಾರ್, ಅಬಕ್ ತೆಕಾ ಚುನ್ನೊ ಲಾವ್ತಾತ್. <verse eid="EZK 13:10" /><verse number="11" style="v" sid="EZK 13:11" />ತಸೆ ಹೊವ್ನ್ ತಿಯಾ ಚುನ್ನೊ ಲಾವ್ತಲ್ಯಾಕ್ನಿ ಅಸೊ ಸಾಂಗ್, ಲೈ ಪಾವ್ಸ್ ಪಡುನ್ ಭಿತ್ತ್ ಪಡುನ್ ಜಾತಾ, ಘಾರ್ಬಿಯಾ ಪಡ್ತಾತ್, ಭಿತ್ತಿಕ್ ವಾರೆ ವಾದಾಳ್ ಪಾಡ್ವುತಾ. <verse eid="EZK 13:11" /><verse number="12" style="v" sid="EZK 13:12" />ಅಬಕ್ ಭಿತ್ತ್ ಪಡಲ್ಲ್ಯಾ ತನ್ನಾ, ತುಮಿ ಲಾವಲ್ಲೊ ಚುನ್ನೊ ಖಯ್ ಗೆಲೊ ಮನುನ್ ತುಮ್ಕಾ ಇಚಾರ್ತಾತ್ ನ್ಹಯ್? <verse eid="EZK 13:12" /><verse number="13" style="v" sid="EZK 13:13" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ವರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಮಿಯಾ ರಾಗಾನ್ ಭಿತ್ತಿಕ್ ವಾರೆ ವಾದಾಳಾನ್ ಪಾಡ್ವುತಾ, ತೆಕಾ ನಾಶ್ ಕರುಕ್ ಸಾಟ್ನಿ ಮಾಜ್ಯಾ ರಾಗಾ ವಯ್ನಾ ವಿಪರಿತ್ ಪಾವ್ಸ್ ಯೆತಾ, ಮಾಜ್ಯಾ ಲೈ ರಾಗಾ ವಯ್ನಾ ಘಾರ್ಬಿಯಾ ಪಡ್ತಾತ್. <verse eid="EZK 13:13" /><verse number="14" style="v" sid="EZK 13:14" />ತುಮಿ ಚುನ್ನೊ ಮಾರಲ್ಲಿ ಭಿತ್ತ್ ಮಿಯಾ ಜಿಮ್ನಿಕ್ ಪಾಡ್ವುನ್, ತಿಜಿ ಪಾಯಾ ಮ್ಹಾಳ್ ಕರ್ತಾ, ತಿ ಪಡುನ್ ಜಾತಾ, ಅನಿ ತುಮಿಬಿ ತ್ಯಾತುರ್ ಗಾವ್ನ್ ನಾಸ್ ಹೊತ್ಯಾಸಿ, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ತುಮ್ಕಾ ಕಳ್ತಾ. <verse eid="EZK 13:14" /><verse number="15" style="v" sid="EZK 13:15" />ಅಸೆ ಮಿಯಾ ಭಿತ್ತಿ ವರ್‍ತಿ ಅನಿ ತೆಕಾ ಚುನ್ನೊ ಮಾರಲ್ಲ್ಯಾ ತುಮ್ಚೆ ವರ್‍ತಿಬಿ ರಾಗ್ ಕಾಡುನ್, ಘೆವ್ನ್ ಅಸೊ ಮನ್ತಾ, ಭಿತ್ತ್ ಬಿ ನಾ ಹೊಲಿ, ಅನಿ ತಿಕಾ ಚುನ್ನೊ ಲಾವಲ್ಲಿ ಲೊಕಾಬಿ ನಾ ಹೊಲಿ, <verse eid="EZK 13:15" /><verse number="16" style="v" sid="EZK 13:16" />ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಪರ್ವಾದಿಯಾನೊ, ಸಮಾಧಾನಾನ್ ನಸ್ಲ್ಯಾರ್ಬಿ ಸಮಾಧಾನಾನ್ ಹಾತ್ ಮನುನ್ ತುಮಿ ದರ್ಶನಾ ಬಗುನ್ ತುಮಿ ಬಗಲ್ಲ್ಯಾ ಜೆರುಜಲೆಮಾಚ್ಯಾ ವಿಶಯಾತ್ ಪರ್‍ವಾದನ್ ಕರಲ್ಲ್ಯಾಸಿ ನ್ಹಯ್, ಮನ್ತಲಿ ಹಿ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 13:16" /></para>
  <para style="s">ಝುಟಿ ಪರ್ವಾದಿನಿಯಾಂಚ್ಯಾ ವಿರೊಧ್ ಪರ್‍ವಾದನ್</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 13:17" />ನರ್ ಮಾನ್ಸಾ, ಸ್ವತ್ಯಾಚ್ಯಾ ಮನಾಕ್ ದಿಸಲ್ಲೆ ಭವಿಶ್ ಸಾಂಗ್ತಲ್ಯಾ ತುಜ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ಬಾಯ್ಕಾ ಮನ್ಸಿಯಾಂಚ್ಯಾಕ್ಡೆ ತೊಂಡ್ ಪರ್‍ತುನ್ ತೆಂಕಾ ಖಂಡನ್ ಕರುನ್ ಅಸೆ ಪರ್‍ವಾದನ್ ಕರ್. <verse eid="EZK 13:17" /><verse number="18" style="v" sid="EZK 13:18" />ಸರ್ವೆಸ್ವರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಲೊಕಾಂಚೊ ಜಿವ್ ಕಾಡುಕ್ ಮನುನ್ ಸಗ್ಳ್ಯಾಂಚ್ಯಾ ಹಾತಿಕ್ ತಾಯಿತ್ ಭಾಂದುನ್, ಲಾಂಬ್ ಹೊತ್ತ್ಯಾಕ್ನಿ ಅನಿ ಗಿಡ್ಡ್ಯಾಕ್ನಿ ಬಿ ಸಮಾ ಹೊಯ್ ಸಾರ್ಕೆ ಮುಸ್ಕೆ ತಯಾರ್ ಕರುನ್ ಘೆವ್ನ್ ಹೊತ್ತ್ಯಾ, ಬಾಯ್ಕೊ ಮನ್ಸಾನೊ ತುಮ್ಚಿ ಗತ್ ಕಾಯ್ ಮನುನ್ ಸಾಂಗು! ಬಾಯ್ಕೊ ಮನ್ಸಿಯಾನೊ, ತುಮಿ ಮಾಜ್ಯಾ ಲೊಕಾಂಚಿ ಜಿವಾ ಕಾಡುನ್ ಸ್ವತಾಚಿ ಜಿವಾ ಹುರ್ವುನ್ ಘೆವ್ಕ್ ಲಾಗ್ಲ್ಯಾಸಿ ಕಾಯ್? <verse eid="EZK 13:18" /><verse number="19" style="v" sid="EZK 13:19" />ತುಮಿ ಮುಟ್ಬರ್ ಜೆವ್ನಾಕ್ ಅನಿ ಬಾರಿಕ್ಲಿಚ್ಯಾ ತುಕ್ಡ್ಯಾಂಚಿ ಆಶ್ಯಾ ಕರುನ್ ಝುಟ್ಯಾಕ್ ಕಾನ್ ದಿತಲ್ಯಾ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಝುಟೆ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಮ್ಹರಿ ನಸಲ್ಲ್ಯಾಕ್ನಿ ಜಿವ್ ಕಾಡುನ್, ಮರ್ತಲ್ಯಾಕ್ನಿ ಹುರ್ವುನ್ ಮಾಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ಮಾಜೆ ಮಾನ್ ಕಮ್ಮಿ ಕರುಲ್ಯಾಸಿ. <verse eid="EZK 13:19" /><verse number="20" style="v" sid="EZK 13:20" />ತಸೆ ಹೊವ್ನ್ ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ತುಮಿ ಲೊಕಾಂಚೊ ಜಿವ್ ಫಾಕ್ರಾ ಸಾರ್ಕೆ ಶಿಕಾರ್ ಕರುಕ್ ವಾಪರಲ್ಲಿ ತುಮ್ಚಿ ತಾಯಿತಾಕ್ನಿ, ಕಂಟಾಳುನ್ ತುಮ್ಚಾ ಹಾತಿತ್ನಾ ಕಾಡುನ್ ಟಾಕ್ತಾ, ತುಮಿ ಜನಾವರಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಶಿಕಾರ್ ಕರ್‍ತಲ್ಯಾ ಫಾಕ್ರಾಕ್ನಿ ಮಿಯಾ ಸೊಡಸ್ತಾ. <verse eid="EZK 13:20" /><verse number="21" style="v" sid="EZK 13:21" />ಮಿಯಾ ತುಮ್ಚೆ ಮುಸ್ಕೆ ಪಿಂಜುನ್ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ತುಮ್ಚಾ ಹಾತಿತ್ನಾ ಶಿಕಾರ್ ಹೊವ್ನ್ ಗಾಯ್ನಾ, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ತುಮ್ಕಾ ಕಳ್ತಾ. <verse eid="EZK 13:21" /><verse number="22" style="v" sid="EZK 13:22" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಮಿಯಾ ಮನ್ ಮೊಡಿನಸಲ್ಲ್ಯಾ ಶಿಶ್ಯಾಚೆ ಮನ್ ತುಮಿ ಝುಟೆ ಸಾಂಗುನ್ ಮನ್ ಮೊಡ್ಲ್ಯಾಸಿ, ಬುರ್ಸೆ ಪಾನ್ ಕರ್ನಾರೊ ಅಪ್ನಾಚಿ ವಾಟ್ ಅಪ್ನಾಚೊ ಜಿವ್ ಹುರ್ವುನ್ ಘೆವ್ಕ್ ಹೊಯ್ನಾ ಸಾರ್ಕೆ ತುಮಿ ತೆಕಾ ಘಟ್ ಭಾಂದ್ಲ್ಯಾಸಿ. <verse eid="EZK 13:22" /><verse number="23" style="v" sid="EZK 13:23" />ಅಸೆ ಹೊವ್ನ್ ತುಮಿ ಭವಿಶ್ ಅನಿ ದರ್ಶನಾ ಬಗ್ತಲೆ ಬಂದ್ ಕರುನ್, ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ತುಮ್ಚ್ಯಾ ಹಾತಿತ್ನಾ ಚುಕ್ವುನ್ ಘೆತಾ, ಅಸೆ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮನ್ತಲೆ ತುಮ್ಕಾ ಕಳ್ತಾ.<verse eid="EZK 13:23" /></para>
  <chapter eid="EZK 13" />
  <chapter number="14" style="c" sid="EZK 14" />
  <para style="s">ದೆವಾನ್ ಮುರ್ತಿ ಆರಾದನ್ ಖಂಡನ್ ಕರಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 14:1" />ತನ್ನಾ ಇಜ್ರಾಯೆಲಾಚಿ ಥೊಡಿ ಜಾಂನ್ತಿ ಲೊಕಾ ಮಾಜೆಕ್ಡೆ ಬಸ್ಲಿ, <verse eid="EZK 14:1" /><verse number="2" style="v" sid="EZK 14:2" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಜೆಕ್ಡೆ ಬೊಲ್ಲ್ಯಾನ್, <verse eid="EZK 14:2" /><verse number="3" style="v" sid="EZK 14:3" />ನರ್ ಮಾನ್ಸಾ ಹಿ ಲೊಕಾ ಮುರ್ತಿಯಾಕ್ನಿ ಅಪ್ನಾಚ್ಯಾ ಮನಾತ್ ಥವ್ನ್ ಘೆವ್ನ್, ಅಸ್ಲ್ಯಾಕ್ನಿ ಮಿಯಾ ಖರೆ ಹೊತ್ತೆ ಸಾಂಗಿ ನಸಲ್ಲೆ ದಿತಲೆ ಸಮಾ ಕಾಯ್? ಕನ್ನಾಬಿ ನಾ. <verse eid="EZK 14:3" /><verse number="4" style="v" sid="EZK 14:4" />ತಸೆ ಹೊವ್ನ್ ತಿಯಾ ತೆಂಕಾ ಬೊಲುನ್ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾತ್ನಿ ಜೆ ಕೊನ್ ಮುರ್ತಿಯಾಕ್ನಿ ಅಪ್ನಾಚ್ಯಾ ಮನಾತ್ ಜಾಗೊ ದಿವ್ನ್ ಚುಕ್ ಕರುಂಗೆತ್ ಹಾತ್ ಆನಿ ಪ್ರವಾದಿಯಾಕ್ನಿ ಪರಸ್ನೆ ಇಚಾರುಕ್ ಯೆಲ್ಯಾರ್, ಪಾತಾಳಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತೆಂಚ್ಯಾ ಮೆಜ್ನಿಕ್ ಯೆಯ್ ನಸಲ್ಲ್ಯಾ ಮುರ್ತಿಯಾಕ್ನಿ ಸಮಾ ಹೊವ್ನ್ ಜವಾಬ್ ದಿತಾ. <verse eid="EZK 14:4" /><verse number="5" style="v" sid="EZK 14:5" />ಇಜ್ರಾಯೆಲಾಚೆ ಪಿಳ್ಗಿಯಾಕ್ನಿ ತೆಂಚ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾ ವಯ್ನಾ ಮಾಕಾ ಸೊಡುನ್ ಸೊಡಲ್ಲೆ ರಾಲ್ಯಾರ್ ಮಿಯಾ ತೆಂಕಾ ಸಗ್ಳೆ ತೆಂಚ್ಯಾ ಆಶಾ ಪಾಶಾತ್ನಿ ಗಾಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 14:5" /><verse number="6" style="v" sid="EZK 14:6" />ತಸೆ ಹೊವ್ನ್ ತಿಯಾ ಇಜ್ರಾಯೆಲ್ ಕಾರಾಕ್ನಿ ಸರ್ವೆಸ್ಪರ್ ಅಶೆ ಮನ್ತಾ, ತುಮಿ ತುಮ್ಚ್ಯಾ ಮುರ್ತಿಯಾಕ್ನಿ ಸೊಡುನ್ ಫಾಟ್ ಕರಾ. <verse eid="EZK 14:6" /><verse number="7" style="v" sid="EZK 14:7" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಇಜ್ರಾಯೆಲ್ ಕುಳಿಚೆ ಅನಿ ಇಜ್ರಾಯೆಲಾತ್ ರ್‍ಹಾತಲ್ಯಾ ದುಸ್ರ್ಯಾ ದೆಶಾಚ್ಯಾನಿ ಮಾಜೆಕ್ನಾ ಧುರ್ ಹೊವ್ನ್ ಅಪ್ನಾಚ್ಯಾ ಮನಾತ್ ಮುರ್ತಿಯಾಕ್ನಿ ಜಾಗೊ ದಿವ್ನ್, ಪರ್‍ವಾದ್ಯಾಕ್ಡೆ ಗೆಲ್ಲೆ ತನ್ನಾ ತೆಂಕಾ ವಯ್ನಾ ದೆವಾಚೆ ಉತ್ತರ್ ಆಯ್ಕಲ್ಯಾರ್ ತೆಕಾ ಸರ್ವೆಸ್ಪರ್ ಹೊಲ್ಲೊ ಮಿಯಾಚ್ ಜವಾಬ್ ದಿತಾ. <verse eid="EZK 14:7" /><verse number="8" style="v" sid="EZK 14:8" />ತೆಚ್ಯಾ ವರ್‍ತಿ ಲೈ ರಾಗ್ ಯೆವ್ನ್ ತೆಕಾ ಹುರ್ಶಾಕಿಚಿ ವಳಕ್ ಕರುನ್ ಭಾಂದಲ್ಲಿ ಸಾಂಗ್ನಿಯಾ ವಸ್ತಾ ಕರುನ್ ಮಾಜ್ಯಾ ಲೊಕಾನಿತ್ನಾ ಕಾಡುನ್ ಟಾಕ್ತಾ, ಅಸೆ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳ್ತಾ. <verse eid="EZK 14:8" /><verse number="9" style="v" sid="EZK 14:9" />ಎಕ್ಲೊ ಪ್ರವಾದಿ ಮಳ್ಳ್ ಹೊವ್ನ್ ದೆವಾಚಿ ಗೊಸ್ಟಿಯಾ ಸಾಂಗ್ಲ್ಯಾರ್, ತ್ಯಾ ಪರ್‍ವಾದ್ಯಾಕ್ ಮಳ್ಳ್ ಕರಲ್ಲೊ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮಿಯಾಚ್. ಮಿಯಾ ತೆಚ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕ್ಲುನ್ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಮಾಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಕಾಡುನ್ ಟಾಕುನ್ ತೆಕಾ ನಾಶ್ ಕರ್ತಾ. <verse eid="EZK 14:9" /><verse number="10" style="v" sid="EZK 14:10" />ಪರ್ವಾದಿಚಿ ಚುಕ್ ಕವ್ಡಿಕಿ, ತೆಕಾ ಪರಶ್ನೆ ಇಚಾರ್ತಲ್ಯಾಚಿ ಚುಕ್ ತವ್ಡಿಚ್, ದೊಗಾಬಿ ತೆಂಚಿ ಶಿಶ್ಯಾ ಸೊಸ್ತಾತ್. <verse eid="EZK 14:10" /><verse number="11" style="v" sid="EZK 14:11" />ಅಸೆ ಹೊಲ್ಯಾರ್ ಇಜ್ರಾಯೆಲಾಚಿ ಲೊಕಾ ಮಾಕಾ ಸೊಡಿನಾತ್, ಅಪ್ನಾಚ್ಯಾ ಮ್ಹೆಜುಕ್ ಹೊಯ್ ನಸಲ್ಲ್ಯಾ ಚುಕೆಂಚ್ಯಾ ವಯ್ನಾ ಅಪಡ್ಸಿಪಡ್ ಕರುನ್ ಘೆಯ್ನಾತ್. ತೆನಿ ಮಾಜಿ ಲೊಕಾ ಹೊವ್ನ್ ರ್‍ಹಾತ್ಯಾತ್, ಮಿಯಾ ತೆಂಕಾ ದೆವ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಮನುನ್ ಸರ್ವೆಸ್ಪರಾಚಿ ದೆವಾಚಿ ಗೊಸ್ಟ್.<verse eid="EZK 14:11" /></para>
  <para style="s">ನೊಹೆ, ದಾನಿಯೆಲ್ ಅನಿ ಜೊಬ್</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 14:12" />ಅನಿ ಸರ್ವೆಸ್ಪರಾನ್ ದೆವಾನ್ ಮಾಕಾ ಹಿ ಗೊಸ್ಟ್ ದಿಲ್ಯಾನ್. <verse eid="EZK 14:12" /><verse number="13" style="v" sid="EZK 14:13" />ನರ್ ಮಾನ್ಸಾ, ಎಕ್ ಗಾಂವ್ ಚುಕ್ ಕರುನ್ ಮಾಕಾ ವಿರೊಧ್ ಪಾಪ್ ಕರಲ್ಯಾ ದೆಶಾಚ್ಯಾ ವರ್‍ತಿ ಮಾಜೊ ಹಾತ್ ಉಕ್ಲುನ್, ತೆಂಕಾ ಗಾವ್ತಲೆ ಖಾನ್ ಬಂದ್ ಕರ್ತಾ, ಲೊಕಾಕ್ನಿ ಜನಾವರಾಕ್ನಿ ನಾಶ್ ಕರುನ್ ಟಾಕ್ತಾ. <verse eid="EZK 14:13" /><verse number="14" style="v" sid="EZK 14:14" />ನೊಯೆ, ದಾನಿಯೆಲ್ ಅನಿ ಜೊಬ್ ಮನ್ತಲಿ ತಿನ್ ಘವ್ಮಾನ್ಸಾ ತ್ಯಾ ದೆಸಾತ್ ರಾವ್ನಬಿ ಅಪ್ನಾಚ್ಯಾ ಬರ್ಯಾ ಕಾಮಾ ವಯ್ನಾ ಸ್ವತಾಚಿ ಜಿವಾ ಎಕುಚ್ ಹುರ್ವುನ್ ಘೆಯ್ತ್, ಹಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್. <verse eid="EZK 14:14" /><verse number="15" style="v" sid="EZK 14:15" />ಮಾಜ್ಯಾ ಹುಕುಮಾಚ್ಯಾ ಸಾರ್ಕೆ ದುಸ್ಟ್ ಜನಾವರಾ ದೆಸಾತ್ ಫಿರುನ್ಗೆತ್ ತೆ ಲುಕ್ಷಾನ್ ಕರಿತ್ ಕೊನ್ಬಿ ದಾಟುನ್ ಜಾಯ್ನಾ ಸಾರ್ಕೆ ಭಿಂವ್ಸುನ್ಗೆತ್ ಹೊಲ್ಯಾರ್, <verse eid="EZK 14:15" /><verse number="16" style="v" sid="EZK 14:16" />ಹಿ ತಿನಿ ಘವ್ಮಾನ್ಸಾ ತ್ಯಾ ದೆಸಾತ್ ರಾಲ್ಯಾರ್ಬಿ ಮಾಜ್ಯಾ ಜಿವಾವರ್‍ತಿ ಆನ್ ತೆನಿ ಯೆವ್ಡೆಚ್ ಹುರ್ವುನ್ ಘೆವ್ನ್ ರಾಲ್ಯಾರ್, ಲೆಕಾಕ್ನಿ ಹೊಂವ್ದಿತ್ ನಾತರ್ ಲೆಕಿಯಾಕ್ನಿ ಹೊಂವ್ದಿತ್ ಹುರ್ವುನ್ ಘೆವ್ಕ್ ಹೊಯ್ ಹೊತ್ತೆ, ದೆಶ್ ಹಾಳ್ ಹೊವ್ನ್ ಜಾತಾ, ಹಿ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 14:16" /><verse number="17" style="v" sid="EZK 14:17" />ನಾತರ್ ತಲ್ವಾರುಚ್ ದೆಸಾತ್ ಗುಸುನ್ ಪಾರ್ ಹೊವ್ನ್ ಜಾತಾ ಮನುನ್ ಹುಕುಮ್ ದಿವ್ನ್, ಮಿಯಾ ತೆಕಾ ದೆಸಾಕ್ ತೆ ಹಾನುನ್ ಮಿಯಾ ಮಾನ್ಸಾ ಅನಿ ಜನಾವರಾ ನಾಸ್ ಕರುನ್ ಹೊಲ್ಯಾರ್ಬಿ, <verse eid="EZK 14:17" /><verse number="18" style="v" sid="EZK 14:18" />ಹಿ ತಿನಿ ಘವ್ಮಾನ್ಸಾಬಿ ದೆಸಾತ್ ರಾಲ್ಯಾರ್ಬಿ, ಮಾಜ್ಯಾ ಜಿವಾ ವರ್‍ತಿ ಆನ್ ಘಾಲುನ್ ಸಾಂಗ್ತಾ, ಅಪ್ನಿ ಹುರುನ್ ರಾಯ್ ಹೊತ್ತೆ ತೆಂಚ್ಯಾ ಲೆಕಾಕ್ನಿ ಹೊಂವ್ದಿತ್ ಲೆಕಿಯಾಕ್ನಿ ಹೊಂವ್ದಿತ್ ಹುರ್ವಿ ನತ್ತ್ಯಾನಿ, ಹಿ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 14:18" /><verse number="19" style="v" sid="EZK 14:19" />ಮಿಯಾ ತ್ಯಾ ದೆಶಾಚ್ಯಾ ವರ್‍ತಿ ಮಾಜೊ ರಾಗ್ ವೊತುನ್, ರಗಾತ್ ಗಳ್ವುನ್, ಫಿಡಾ ಧಾಡುನ್, ಮಾನ್ಸಾ ಅನಿ ಜನಾವರಾಕ್ನಿ ನಾಶ್ ಕರಲ್ಲ್ಯಾ ಎಳಾರ್, <verse eid="EZK 14:19" /><verse number="20" style="v" sid="EZK 14:20" />ನೊಯೆ, ದಾನಿಯೆಲ್ ಅನಿ ಜೊಬ್ ಹೆನಿ ಥೈ ರಾಲ್ಯಾರ್ಬಿ ಮಾಜ್ಯಾ ಜಿವಾಚೆ ಆನ್ ಘಾಲುನ್ ಸಾಂಗ್ತಾ, ಅಪ್ನಾಚ್ಯಾ ಬರ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ವಯ್ನಾ ಅಪ್ನಾಚಿ ಜಿವಾ ಹುರ್ವುನ್ ಘೆಯ್ ಹೊತ್ತ್ಯಾನಿ ಖರೆ ಅಪ್ನಾಚ್ಯಾ ಲೆಕಾಕ್ನಿ ಹೊಂವ್ದಿತ್ ಲೆಕಿಯಾಕ್ನಿ ಹೊಂವ್ದಿತ್ ಹುರ್ವುನ್ ಘೆಯ್ ನಸಿ ಹೊತ್ತ್ಯಾನಿ, ಹಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್.<verse eid="EZK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 14:21" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಮಿಯಾ ತಲ್ವಾರ್, ಬರ್‍ಗಾಲ್, ಕ್ರುರ್ ಜನಾವರ್ ಅನಿ ಚಾರ್ ಫಿಡಾ ಮನ್ತಲಿ ಜರುಜಲೆಮಾಚ್ಯಾ ವರ್‍ತಿ ವಾಂಗ್ಡಾಚ್ ಹಾನುನ್ ಮಾನ್ಸಾ ಅನಿ ಜನಾವರಾಕ್ನಿ ನಾಶ್ ಕರ್ತಾನಾ ಸಾಂಗ್ತಲೆ ಕಾಯ್! <verse eid="EZK 14:21" /><verse number="22" style="v" sid="EZK 14:22" />ಹೊಲ್ಯಾರ್ ಲೆಕಾ ಅನಿ ಲೆಕಿಯಾ ಉಲ್ಲಿ ಲೊಕಾ ಕಸಿಬಿ ಚುಕ್ವುನ್ಗೆವ್ನ್ ಹುರ್ವುನ್ ಥೈತ್ನಾ ತೆಂಕಾ ನ್ಹೆವ್ನ್ ಹೊತಾ, ಆಹಾ, ತೆನಿ ತುಮ್ಚ್ಯಾಕ್ಡೆ ಮಿಳಲ್ಲ್ಯಾ ತನ್ನಾ, ತುಮಿ ತೆಂಚಿ ಬುರ್ಶಿ ವಾಟಾ ಅನಿ ಬುರ್ಶಿ ಕಾಮಾ ಬಗುನ್, ಮಿಯಾ ಜರುಜಲೆಮಾ ವರ್‍ತಿ ಹಾನಲ್ಲ್ಯಾ ತರಾಸಾಚ್ಯಾ ವಿಶಯಾತ್ ಅನಿ ತೆಕಾ ಯೆಯ್ ಸಾರ್ಕೆ ಕರಲ್ಲ್ಯಾ ತರಾಸಾಚ್ಯಾ ವಿಶಯಾತ್ ತುಮ್ಕಾ ಸಮಾಧಾನ್ ಹೊತಾ. <verse eid="EZK 14:22" /><verse number="23" style="v" sid="EZK 14:23" />ತುಮಿ ತೆಂಚಿ ಬುರ್ಶಿ ವಾಟಾ ಅನಿ ಬುರ್ಶಿ ಕಾಮಾ ಬಗ್ತಾನಾ, ತೆಂಚ್ಯಾಕ್ನಾಚ್ ತುಮ್ಕಾ ಸಮಾಧಾನ್ ಹೊತಾ, ಮಿಯಾ ಜರುಜಲೆಮಾಕ್ ಕರಲ್ಲೆ ಸಗ್ಳೆ ಫುಕೊಟ್ ಕರುಕ್ನಾ ಮನುನ್ ತುಮ್ಕಾ ಕಳುನ್ ಯೆತಾ, ಹಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್.<verse eid="EZK 14:23" /></para>
  <chapter eid="EZK 14" />
  <chapter number="15" style="c" sid="EZK 15" />
  <para style="s">ದರಾಕ್ಷಾಚ್ಯಾ ಎಲಿಚ್ಯಾ ವಿಶಯಾತ್ ಎಕ್ ಕಾನಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 15:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಹಿ ಗೊಸ್ಟ್ ದಿಲ್ಯಾನ್, <verse eid="EZK 15:1" /><verse number="2" style="v" sid="EZK 15:2" />ನರ್ ಮಾನ್ಸಾ ದರಾಕ್ಷಾಚೆ ಝಾಡ್ ಹುರಲ್ಲ್ಯಾ ಝಾಡಾಂಚ್ಯಾಕಿಂತಾ ಕಾಯ್ ಲೈ? ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಝಾಡಾತ್ನಿ ದರಾಕ್ಷಾಚ್ಯಾ ಝಾಡಾಚೆ ವಿಸೆಸ್ ಕಾಯ್? <verse eid="EZK 15:2" /><verse number="3" style="v" sid="EZK 15:3" />ಲೊಕಾ ದರಾಕ್ಷಾಚೆ ನಾಕುಡ್ ಘೆವ್ನ್ ತೆಚೆನ್ ಕಾಯ್ ತರ್ ಬಿ ಕರ್‍ತಾತ್ ಕಾಯ್? ತೆಚೆ ನಾಕುಡ್ ಘೆವ್ನ್ ತೆಚೆರ್ ಕಾಯ್ ತರ್ ಲೊಂಬಾತ್ ಘಾಲ್ತ್ಯಾತ್ ಕಾಯ್? <verse eid="EZK 15:3" /><verse number="4" style="v" sid="EZK 15:4" />ತೆ ಜಾಳ್ವುತಲೆ ನಾಕುಡ್ ಕರುನ್ ಆಗಿತ್ ಘಾಲ್ತಾತ್, ಆಗ್ ತೆಚಿ ದೊನಿ ತುದಿಯಾ ಜಾಳ್ವುತಾ, ಅನಿ ತೆಜೊ ಮದ್ಲೊ ಭಾಗ್ ಇಂಗ್ಳೊ ಹೊತಾ. ತೆ ಕಾಯ್ ತರ್ಬಿ ಕಾಮಾಕ್ ಎತಾ ಕಾಯ್? <verse eid="EZK 15:4" /><verse number="5" style="v" sid="EZK 15:5" />ತೆ ಸಮಾ ರ್‍ಹಾತಾನಾಚ್ ಕಾಯ್ ಕಾಮಾಕ್ ಎವ್ಕ್ ನಾ, ಅನಿ ಜಾಳ್ವುನ್ ಇಂಗ್ಳೊ ಹೊಲ್ಯಾ ಮಾನಾ ಖಲೆ ಕಾಮಾಕ್ ಎಯ್ಲ್?<verse eid="EZK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 15:6" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರ್ , ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಝಾಡಾತ್ನಿ ದರಾಕ್ಷಾಚೆ ಝಾಡ್ ಮಿಯಾ ಆಗಿಕ್ ನಾಕುಡ್ ಕರುನ್ ದಿಲ್ಲ್ಯಾ ಗತಿನ್, ಜರುಜಲೆಮಾಚ್ಯಾ ನಾಶಾಕ್ ಗುರಿ ಕರ್ತಾ. <verse eid="EZK 15:6" /><verse number="7" style="v" sid="EZK 15:7" />ಅನಿ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ರಾಗಾಚಿ ನದರ್ ಥವ್ತಾ, ತೆನಿ ಆಗಿತ್ನಾ ಚುಕ್ವುನ್ ಘೆಟ್ಲ್ಯಾರ್ಬಿ ತೆಂಕಾ ಆಗ್ ಗಿಳ್ತಾ, ಮಿಯಾ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ರಾಗಾಚಿ ನದರ್ ಥವಲ್ಲ್ಯಾ ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ತುಮ್ಕಾ ಕಳ್ತಾ. <verse eid="EZK 15:7" /><verse number="8" style="v" sid="EZK 15:8" />ತೆನಿ ಮಾಕಾ ಪಸ್ವಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಮಿಯಾ ದೆಶ್ ಹಾಳ್ ಕರ್ತಾ, ಮನ್ತಲಿ ಹಿ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 15:8" /></para>
  <chapter eid="EZK 15" />
  <chapter number="16" style="c" sid="EZK 16" />
  <para style="s">ಜೆರುಜಲೆಮಾಚಿ ಅವಿಶ್ವಾಸ್ಪಾನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 16:1" />ಮಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಹಿ ಗೊಸ್ಟ್ ದಿಲ್ಯಾನ್. <verse eid="EZK 16:1" /><verse number="2" style="v" sid="EZK 16:2" />ನರ್ ಮಾನ್ಸಾ ತಿಯಾ ಜೆರುಜಲೆಮಾಕ್ ತಿಜಿ ಬುರ್ಶಿ ಕಾಮಾ ಕಳ್ವುನ್, <verse eid="EZK 16:2" /><verse number="3" style="v" sid="EZK 16:3" />ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರಾನ್ ದೆವಾನ್, ಜೆರುಜಲೆಮಾಕ್ ಮನ್ತಲಿಕ್ ಹಿ ಗೊಸ್ಟ್ ಸಾಂಗ್, ತುಜಿ ಉಪಾಜಲ್ಲೆ ಕಾನಾನಾಂಚ್ಯಾ ದೆಸಾತ್, ಬಾಬಾ ತುಜೊ ಅಮೊರಿತಾಂಚೊ, ತುಜಿ ಬಾಯ್ ಹಿತ್ತಿತಾಂಚಿ. <verse eid="EZK 16:3" /><verse number="4" style="v" sid="EZK 16:4" />ತಿಚ್ಯಾ ಉಪಾಜಲ್ಲ್ಯಾಚ್ಯಾ ವಿಶಯಾತ್ ಕಾಯ್ ಸಾಂಗು! ತಿಯಾ ಉಪಾಜಲ್ಲ್ಯಾ ದಿಸಿ ತುಜಿ ಬೊಂಬ್ಲಿ ಕಾಪುನ್ ಕೊನಿಬಿ ಭಾಂದುಕ್ನಾತ್, ತುಕಾ ಪಾನಿಯಾನ್ ಧುವ್ನ್ ನಿತಳ್ ಕರುಕ್ನಾತ್, ತುಕಾ ಉಲ್ಲೆಬಿ ಮಿಟ್ಟ್ ಲಾವ್ಕ್ನಾತ್, ತುಕಾ ಕಪ್ಡ್ಯಾತ್ ಲಪ್ಟುಕ್ನಾತ್. <verse eid="EZK 16:4" /><verse number="5" style="v" sid="EZK 16:5" />ತುಕಾ ದಯಾ ದಾಕ್ವುನ್, ಕಾಳ್ಜಿ ದಾಕ್ವುನ್ ಕೊನಿಬಿ ತುಕಾ ಅಸ್ಲಿ ಮಜತ್ ಕರುಕ್ನಾತ್, ತಿಯಾ ಉಪಾಜಲ್ಲ್ಯಾ ದಿಸಿ ರಾಡ್ ಹೊಲ್ಲಿ ಹೊತ್ತೆ, ತುಕಾ ಮ್ಹಾಳಾತ್ ಟಾಕುನ್ ಸೊಡಲ್ಲೆ ಹೊತ್ತೆ.<verse eid="EZK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 16:6" />ಮಿಯಾ ದಾಟುನ್ ಜಾತಾನಾ, ತುಜ್ಯಾ ರಗ್ತಾತುಚ್ ಲೊಳುನ್ಗೆತ್ ಹೊತ್ತ್ಯಾ ತುಕಾ ಬಗುನ್ ತಿಯಾ ರಗ್ತಾನ್ ಹೊಲಿ ಹೊಲ್ಲಿ ರಾಲ್ಯಾರ್ಬಿ ಝಿತ್ತಿ ರಾ ಮನುನ್ ಸಾಂಗ್ಲೊ. ಹೊಯ್ ತಿಯಾ ಬುರ್ಶಿ ಹೊಲ್ಯಾರ್ಬಿ ಝಿತ್ತಿ ರಾ ಮನುನ್ ವಾಚ್ವುಲೊ. <verse eid="EZK 16:6" /><verse number="7" style="v" sid="EZK 16:7" />ಜಿಮ್ನಿ ವರ್‍ತಿ ಮೊಳ್ಕ್ಯಾ ಸಾರ್ಕೆ ಮಿಯಾ ತುಕಾ ವಾಡ್ವುತಾನಾ, ತಿಯಾ ವಾಡುನ್ ದಾಂಡ್ಗಿ ಹೊವ್ನ್, ಲೈ ಸುಂದರ್ ಹೊಲೈ, ತುಕಾ ಥಾನಾ ಯೆಲಿ, ತುಜಿ ಕೆಸಾ ಲಾಂಬ್ ಹೊಲಿ, ಖರೆ ತಿಯಾ ಕಪ್ಡೆ ನಸ್ತಾನಾ ನಾಗ್ಡೆ ಹೊಲ್ಲೆಯ್.<verse eid="EZK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 16:8" />ಮಿಯಾ ದಾಟುನ್ ಜಾತಾನಾ ಅಬಕ್ ತುಕಾ ಬಗ್ತಾನಾ, ತಿಯಾ ಲಗ್ನಾಚಿ ಹೊಲ್ಲೆಯ್, ತನ್ನಾ ಮಿಯಾ ಮಾಜ್ಯಾ ಕಾಂಬ್ರಾನಾಚಿ ಪದರ್ ತುಜ್ಯಾ ವರ್‍ತಿ ಘಾಲುನ್ ತುಜಿ ಮರ್ಯಾದ್ ಧಾಪ್ಲೊ, ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಮಿಯಾ ಗೊಸ್ಟ್ ದಿವ್ನ್ ಕರಾರ್ ಕರುನ್ ಘೆಟಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತಿಯಾ ಮಾಜಿ ಹೊಲೆಯ್, ಹಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್. <verse eid="EZK 16:8" /><verse number="9" style="v" sid="EZK 16:9" />ತನ್ನಾ ಮಿಯಾ ತುಕಾ ಪಾನಿ ನಾವ್ಸುನ್ ತುಜ್ಯಾ ವಯ್ಲೆ ರಗಾತ್ ಧುವ್ನ್, ತಿಕಾ ತೆಲ್ ಲಾವ್ಲೊ. <verse eid="EZK 16:9" /><verse number="10" style="v" sid="EZK 16:10" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಮಿಯಾ ಹಾತಿನಿ ಕರಲ್ಲೆ ಕಪ್ಡೆ ತುಕಾ ನೆಸ್ವುನ್, ಸಮುಂದರಾಚ್ಯಾ ಬರ್ಯಾತ್ಲ್ಯಾ ಬರೆ ಚಮ್ಡ್ಯಾಚಿ ವ್ಹಾನಯಾ ತುಕಾ ನೆಸ್ವುನ್, ಕಿಮ್ತಿಚೆ ಕಪ್ಡೆ ತುಕಾ ನೆಸ್ವುನ್, ರೆಶ್ಮಿಚೆ ಕಾಂಬ್ರಾನ್ ಕಾಂಬರ್ಲೊ. <verse eid="EZK 16:10" /><verse number="11" style="v" sid="EZK 16:11" />ಅನಿ ಮಿಯಾ ತುಜ್ಯಾ ಹಾತಾಕ್ನಿ ಕಾಕ್ನಾ ಅನಿ ಗಳ್ಯಾಕ್ ಪವ್ಳಿ, <verse eid="EZK 16:11" /><verse number="12" style="v" sid="EZK 16:12" />ಅನಿ ನಾಕಾತ್ ನತ್ತ್, ಕಾನಾಕ್ ಕಾನಾತ್ಲಿ ಪುಲ್ಲ್ ಅನಿ ಟಕ್ಲ್ಯಾ ವರ್‍ತಿ ಸುಂದರ್ ಮುಕುಟ್ ಥವ್ನ್, ತುಕಾ ವಸ್ತಾನಿ ಶಿಂಗಾರ್ ಕರ್ಲೊ. <verse eid="EZK 16:12" /><verse number="13" style="v" sid="EZK 16:13" />ತುಜಿ ವಸ್ತಾ ಚಾಂದಿ ಅನಿ ಸೊನ್ಯಾಚಿ, ತುಜೆ ಕಪ್ಡೆ ಕಿಮ್ತಿಚೆ ಕಪ್ಡೆ, ರೆಶ್ಮಿಚೆ ಕಾಂಬ್ರಾನ್, ಹಾತಿಚ್ಯಾ ಕರಲ್ಲೆ ಕಪ್ಡೆ, ತುಜಿ ಜೆವಾನ್ ಘಂವಾಚೆ ಬರೆ ಪಿಟ್ಟ್, ಮ್ಹಾಂವ್ ಅನಿ ತೆಲ್, ತುಜೆ ಸುಂದರ್ ಪಾನ್ ಲೈ ಸುಂದರ್, ತಿಯಾ ವಾಡುನ್ ರಾನಿ ಹೊಲೆಯ್. <verse eid="EZK 16:13" /><verse number="14" style="v" sid="EZK 16:14" />ಮಿಯಾ ತುಕಾ ದಿಲ್ಲ್ಯಾ ಮಾಜ್ಯಾ ವಯ್ಭವಾ ವಯ್ನಾ ತಿಯಾ ಲೈ ಸುಂದರ್ ಹೊವ್ನ್ ವಾಡ್ಲೆಯ್, ತುಜೆ ಸುಂದರ್ ಪಾನ್ ಸಗ್ಳ್ಯಾಕ್ಡೆ ಪಗಳ್ಳಿ, ಹಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್.<verse eid="EZK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 16:15" />ಖರೆ ತಿಯಾ ತುಜ್ಯಾ ಸುಂದರ್ ಪಾನಾನ್ ವಿಶ್ವಾಸ್ ಥವ್ನ್, ಮಿಯಾ ನಾವ್ ಘೆಟ್ಲೊ ಮನುನ್ ಮಸ್ತಿ ಕರುನ್, ದಾಟುನ್ ಜಾತಲ್ಯಾ ಹರ್ ಎಕ್ಲ್ಯಾ ವಾಂಗ್ಡಾ ನಿಜಲೈ, <verse eid="EZK 16:15" /><verse number="16" style="v" sid="EZK 16:16" />ತಿಯಾ ಫುಜಾ ಕರ್‍ತಲೆ ಜಾಗೆ ಭಾಂದುನ್ಗೆವ್ನ್ ತುಜ್ಯಾ ನಾನಾ ನಮುನ್ಯಾಚಿ ವಸ್ತಾನಿ ತೆಕಾ ಶಿಂಗಾರ್ ಕರುನ್ಗೆವ್ನ್ ಥೈ ಬುರ್ಸೆಪಾನ್ ಕರ್‍ಲೆ, ಹೆ ಹೊವ್ ನಸುಚೆ ಹೊತ್ತೆ, ಅನಿ ಹೊತಲೆ ನತ್ತೆ. <verse eid="EZK 16:16" /><verse number="17" style="v" sid="EZK 16:17" />ಅನಿ ಮಿಯಾ ಮಾಜ್ಯಾ ಸೊನ್ಯಾನ್ ಅನಿ ಚಾಂದಿನ್ ತುಕಾ ಕರ್ಸುನ್ ದಿಲ್ಲಿ ವಸ್ತಾ ಘೆವ್ನ್, ತೆಜ್ಯಾನ್ ಘವ್ಮಾನ್ಸಾಂಚಿ ಮುರ್ತಿಯಾ ಕರುನ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ವ್ಯಬಿಚಾರ್ ಕರ್‍ಲೆ. <verse eid="EZK 16:17" /><verse number="18" style="v" sid="EZK 16:18" />ತುಜಿ ಹಾತಿಚ್ಯಾ ಕರಲ್ಲೆ ಕಪ್ಡೆ ಘೆವ್ನ್, ಮುರ್ತಿಯಾಕ್ನಿ ತೆ ನೆಸ್ವುನ್ ತೆಂಚ್ಯಾ ಫಿಡೆ ಮಾಜೆ ಭೆಟ್ವುತಲೆ ತೆಲ್ ಅನಿ ಧುಪ್ ಭೆಟ್ವುಲೈ. <verse eid="EZK 16:18" /><verse number="19" style="v" sid="EZK 16:19" />ಮಿಯಾ ದಿಲ್ಲಿ ಬಾರಿಕ್ಲಿ, ತುಕಾ ದಿಲ್ಲೆ ಜೆವಾನ್, ಘಂವಾಚೆ ಬರೆ ಪಿಟ್ಟ್, ತೆಲ್, ಮ್ಹಾಂವ್ ಹೆ ಸಗ್ಳೆ ತಿಯಾ ತ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಬರ್ಯಾವಾಸೆಚಿ ಬಲಿ ಕರುನ್ ಭೆಟ್ವುಲೆಯ್, ಹೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 16:19" /><verse number="20" style="v" sid="EZK 16:20" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ತಿಯಾ ಮಾಜ್ಯಾಕ್ನಾ ಉಪಾಜಲ್ಲಿ ಚೆಡ್ವಾ ಅನಿ ಝಿಲ್ಗೆ ಧರುನ್ ಮುರ್ತಿಯಾಕ್ನಿ ಜೆವಾನ್ ಹೊಂವ್ದಿತ್ ಮನುನ್ ಬಲಿ ಭೆಟ್ವುಲೆಯ್, ಹಿ ಬಾರಿಕ್ ಗೊಸ್ಟ್ ಮನುನ್ ಚಿಂತಲೈ ಕಾಯ್! <verse eid="EZK 16:20" /><verse number="21" style="v" sid="EZK 16:21" />ತೆ ಮಿರ್ಸುಚೆ ಮನುನ್ ತಿಯಾ ಮಾಜ್ಯಾ ಪೊರಾಕ್ನಿ ಸೊಡುನ್ ಮುರ್ತಿಯಾಕ್ನಿ ಬಲಿ ಭೆಟ್ವುನ್ ದಿಲೈ ಕಾಯ್? <verse eid="EZK 16:21" /><verse number="22" style="v" sid="EZK 16:22" />ತುಜಿ ಹಿ ಬುರ್ಶಿಕಾಮಾ, ವ್ಯೆಭಿಚಾರ್ ತಿಯಾ ಪರ್‍ತುನ್-ಪರ್‍ತುನ್ ಕರ್ತಾನಾ ತಿಯಾ ಕಪ್ಡೆ ನಸ್ತಾನಾ ನಾಗ್ಡೆ ಹೊವ್ನ್ ತುಜ್ಯಾ ರಗ್ತಾತ್ ತಿಯಾ ಲೊಳುನ್ಗೆತ್ ಹೊತ್ತೆ ತುಜೆ ಬಾಳ್ಸೆಪಾನ್ ತಿಯಾ ಯಾದಿಕ್ ಹಾನುನ್ ಘೆವ್ಕ್ ನಾ. <verse eid="EZK 16:22" /><verse number="23" style="v" sid="EZK 16:23" />ಅಯ್ಯೊ, ತುಜಿ ಗತ್ ಕಾಯ್ ಮನುನ್ ಸಾಂಗು, ಹಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್.<verse eid="EZK 16:23" /></para>
  <para style="s">ಜೆರುಜಲೆಮಾಚೆ ವ್ಯಬಿಚಾರಾಚೆ ಜಿವನ್</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 16:24" />ತಿಯಾ ಹಿ ಬುರ್ಶಿ ಕಾಮಾ ಕರಲ್ಲೆ ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಹರ್ ಎಕ್ ಚವ್ಕಾತ್ ಮಂಟಪ್ ಭಾಂದುನ್ ಕರುನ್ ಕಟ್ಟೊ ಕರುನ್ಗೆಟಲೆಯ್. <verse eid="EZK 16:24" /><verse number="25" style="v" sid="EZK 16:25" />ಹರ್ ಎಕ್ ವಾಟೆಚ್ಯಾ ತುದಿಕ್ ಕಟ್ಟೊ ಭಾಂದುನ್ಗೆವ್ನ್ ತುಜೆ ಸುಂದರ್ ಪಾನ್ ನಿಚ್ ಕಾಮಾಕ್ ಒಪ್ಸುನ್, ದಾಟುನ್ ಜಾತಲ್ಯಾ ಸಗ್ಳ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳುನ್ ಜಾಸ್ತಿಚೆ ಸುಳ್ ಪಾನ್ ಕರ್‍ಲೆ. <verse eid="EZK 16:25" /><verse number="26" style="v" sid="EZK 16:26" />ತಿಚ್ಯಾ ಸೆಜಾರಿ ಲೊಕಾ ಇಜಿಪ್ತ್ ಕಾರಾಂಚ್ಯಾಕ್ನಾಬಿ ತಿಯಾ ಮಿಳುನ್ ಲೈ ವ್ಯೆಭಿಚಾರ್ ಕರುನ್, ಮಾಕಾ ಚಾವ್ತಾಳಿ ಸಾರ್ಕೆ ಕರ್‍ಲೆ. <verse eid="EZK 16:26" /><verse number="27" style="v" sid="EZK 16:27" />ತಸೆಹೊವ್ನ್, ಮಿಯಾ ತುಜ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕ್ಲುನ್, ತುಜೆ ಖಾನ್ ಕಮ್ಮಿ ಕರ್ಲೊ, ತುಕಾ ದ್ವೆಶ್ ಕರುನ್ ತುಜ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾಕ್ನಿ ಸೊಸುನ್ ಘೆಯ್ನಸಲ್ಲ್ಯಾ ಪಿಲಿಸ್ತಿಯಾಂಚ್ಯಾ ದಾಂಡ್ಗ್ಯಾ ಚೆಡ್ವಾಂಚ್ಯಾ ಹಾತಿತ್ ಸಿಗಾ ಘಾಟ್ಲೊ. <verse eid="EZK 16:27" /><verse number="28" style="v" sid="EZK 16:28" />ಅನಿ ತವ್ಡೆಚ್ ಫಿರೆ ಹೊಯ್ನಾ ಮನುನ್ ಆಶುರ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾಬಿ ನಿಜಲೈ, ಹೊಯ್ ತೆಂಚ್ಯಾಕ್ನಾ ನಿಜ್ಲ್ಯಾರ್ಬಿ ತುಕಾ ನಿಜ್ ಯೆವ್ಕ್ ನಾ. <verse eid="EZK 16:28" /><verse number="29" style="v" sid="EZK 16:29" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ತಿಯಾ ಲೈ ಯಾಪಾರ್ ಕರ್‍ತಲ್ಯಾ ಕಸ್ದಿಯಾಂಚ್ಯಾ ದೆಸಾಕ್ ಮಿಳುನ್ ಥೈಬಿ ಲೈ ವ್ಯೆಭಿಚಾರ್ ಕರ್‍ಲೆ, ಜಾಲ್ಯಾರ್ಬಿ ಧ್ಯಾಯ್ ಭರುಕ್ನಾ.<verse eid="EZK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 16:30" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಸಾಂಗ್ತಾ, ತುಜೊ ಮನ್ ವ್ಯಬಿಚಾರಾಕ್ ಸಿಕ್ ಹೊವ್ನ್ ಗೆಲಾ, ಯೆವ್ಡಿ ಸಗ್ಳಿ ಬುರ್ಶಿ ಕಾಮಾ ಕರುನ್ ಭಾಂದಲ್ಲಿ ನತ್ತಿ ಸುಳ್ ಪಾನಾಚಿ ಬಾಯ್ಕೊ ಮಾನುಸ್ ಹೊಲೆಯ್ ನ್ಹಯ್. <verse eid="EZK 16:30" /><verse number="31" style="v" sid="EZK 16:31" />ಹರ್ ಎಕ್ ಒನಿಚ್ಯಾ ಆಕ್ರಿಕ್ ತಿಯಾ ಖೊಲಿ ಭಾಂಧುನ್ ಸಗ್ಳ್ಯಾ ಚವ್ಕಾತ್ನಿ ಪಿಟ್ಟ್ ಭಾಂಧುನ್ ಘೆಟ್ಲೆಯ್, ಗಾವಲ್ಲೆ ಸಗ್ಳೆಬಿ ಕಮ್ಮಿಚೆ ಮನುನ್ ತಿರಸ್ಕಾರ್ ಕರ್‍ತಲ್ಯಾ ಸುಳಿ ಸಾರ್ಕಿ ತಿಯಾ ಚಲ್ತಲಿ ನ್ಹಯ್. <verse eid="EZK 16:31" /><verse number="32" style="v" sid="EZK 16:32" />ತಿಯಾ ವ್ಯೆಭಿಚಾರ್ ಕರ್ತಲಿ ಘವಾ ವಯ್ಲಿ ಬಾಯ್ಕೊ ಮಾನುಸ್, ಘವಾಚ್ಯಾ ಬದ್ಲಾಕ್ ದುಶ್ರ್ಯಾಚ್ಯಾ ಮಿಳ್ತಲಿ ರಾಂಡ್ ತಿಯಾ. <verse eid="EZK 16:32" /><verse number="33" style="v" sid="EZK 16:33" />ಸಗ್ಳ್ಯಾಕ್ಡೆ ವ್ಯೆಭಿಚಾರ್ ಕರ್‍ತಲ್ಯಾ ಬಾಯ್ಕೊ ಮನ್ಸಿಕ್ ಪಯ್ಸೆ ದಿವ್ನ್ ಹೊತಾ, ಖರೆ ತಿಯಾ ತುಜ್ಯಾ ಧಗ್ಡಾಕ್ನಿ ತಿಯಾಚ್ ಪಯ್ಸೆ ದಿತೆಯ್, ತೆನಿ ಸಗ್ಳ್ಯಾ ಭಾಜುಕ್ನಾ ತುಜ್ಯಾಕ್ಡೆ ಎವ್ನ್ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ನಿಜುಕ್ ತಿಯಾಚ್ ತೆಂಕಾ ಭೊಮಾನ್ ದಿತೆಯ್. <verse eid="EZK 16:33" /><verse number="34" style="v" sid="EZK 16:34" />ತುಜ್ಯಾ ವ್ಯಬಿಚಾರಾಕ್ ಅನಿ ಹುರಲ್ಲ್ಯಾ ರಾಂಡಾಂಚ್ಯಾ ವ್ಯಬಿಚಾರಾಕ್ನಿ ವ್ಯತ್ಯಾಸ್ ಹಾಯ್, ತುಜ್ಯಾಕ್ಡೆ ವ್ಯಬಿಚಾರ್ ಕರುಕ್ ಕೊನ್ಬಿ ತುಜ್ಯಾ ಫಾಟ್ನಾ ಯೆಯ್ನಾತ್, ತಿಯಾಚ್ ದಿತೆಯ್ ಖರೆ ತುಕಾ ಕಾಯ್ಬಿ ಗಾಯ್ನಾ, ತುಜೆ ಬುರ್ಸೆಪಾನ್ ಲೈಚ್ ಹೊಲ್ಲೆ ಖರೆ.<verse eid="EZK 16:34" /></para>
  <para style="s">ಜೆರುಜಲೆಮಾಚ್ಯಾ ವಿಶಯಾತ್ ದೆವ್ ಝಡ್ತಿ ಕರ್‍ತಲೆ</para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 16:35" />ಅಸೆ ರ್‍ಹಾತಾನಾ ವ್ಯಬಿಚಾರನಿ, ಸರ್ವೆಸ್ಪರಾಚಿ ಹಿ ಗೊಸ್ಟ್ ಆಯ್ಕ್! <verse eid="EZK 16:35" /><verse number="36" style="v" sid="EZK 16:36" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೆ ಸಾಂಗ್ತಾ, ಮಿತಿ ಮಿರಲ್ಲೆ ತುಜಿ ಆಂಗಾಚಿ ಆಶ್ಯಾ, ತುಜ್ಯಾಕ್ಡೆ ವ್ಯಬಿಚಾರ್ ಕರಲ್ಲ್ಯಾ ತುಜ್ಯಾ ಧಗ್ಡಾಕ್ನಿ ತುಕಾ ಹೊಲ್ಲೆ ಮರ್ಯಾದ್ ಪಾನ್, ತುಜಿ ಸಗ್ಳಿ ಬುರ್ಶಿ ಮುರ್ತಿಯಾ, ತಿಯಾ ತೆಂಕಾ ಭೆಟ್ವಲ್ಲೆ ತುಜ್ಯಾ ಪೊರಾಂಚೆ ರಗಾತ್, <verse eid="EZK 16:36" /><verse number="37" style="v" sid="EZK 16:37" />ಹೆ ಸಗ್ಳೆ ಮಿಯಾ ಬಗುನ್, ತಿಯಾ ವ್ಯಬಿಚಾರ್ ಕರಲ್ಲ್ಯಾ ತುಜ್ಯಾ ಸಗ್ಳ್ಯಾ ಧಗ್ಡಾಕ್ನಿ ಅನಿ ತಿಯಾ ವ್ಯಬಿಚಾರ್ ಕರಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ತುಕಾ ಕುಸ್ಡೆ ಕರ್‍ತಲ್ಯಾ ಸಗ್ಳ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಭೊತ್ಯಾನಿ ತುಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಮಿಳ್ವುನ್, ತೆಂಚ್ಯಾ ಡೊಳ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕುಚ್ ತುಕಾ ನಾಗ್ಡೆ ಕರುನ್ ತುಜಿ ಮರ್ಯಾದ್ ಮ್ಹಾಳಾಕ್ ಹಾನ್ತಾ. <verse eid="EZK 16:37" /><verse number="38" style="v" sid="EZK 16:38" />ವ್ಯೆಭಿಚಾರ್ ಕರ್‍ತಲ್ಯಾ, ಅನಿ ರಗಾತ್ ಗಳ್ವುತಲ್ಯಾ ಬಾಯ್ಕಾಮಾನ್ಸಿಯಾಕ್ನಿ ಸಮಾ ಶಿಕ್ಷ್ಯಾ ದಿವ್ನ್ ರಾಗಾನ್ ಅನಿ ಕಿಚ್ಚಾನ್ ತುಜೆ ರಗಾತ್ ಗಳ್ವುತಾ. <verse eid="EZK 16:38" /><verse number="39" style="v" sid="EZK 16:39" />ಮಿಯಾ ತುಕಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾಂಚ್ಯಾ ಹಾತಿತ್ ಗಾಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ತೆನಿ ತುಜಿ ಮಂಟಪ್ ಪಾಡ್ವುನ್, ಕಟ್ಟೆ ಫೊಡುನ್, ತುಜೆ ಕಪ್ಡೆ ಕಾಡುನ್, ತುಜಿ ವಸ್ತಾ ಚೊರುನ್ಗೆವ್ನ್ ಜಾವ್ನ್, ತುಕಾ ಯೆವ್ಡೆಚ್ ಖಾಲಿ ಸೊಡುನ್ ಜಾತಾತ್. <verse eid="EZK 16:39" /><verse number="40" style="v" sid="EZK 16:40" />ತೆನಿ ತುಜ್ಯಾ ವಿಶಯಾತ್ ಬಯ್ಟೆಕ್ ಬಲ್ವುನ್, ತುಕಾ ಗುಂಡೆ ಮಾರುನ್ ಜಿವ್ ಕಾಡ್ತಾತ್, ತಲ್ವಾರಿನ್ ತೊಡ್ತಾತ್. <verse eid="EZK 16:40" /><verse number="41" style="v" sid="EZK 16:41" />ತುಜಿ ಘರಾ ಆಗಿನ್ ಜಾಳ್ವುತಾತ್, ಲೈ ಬಾಯ್ಕಾಮನ್ಸಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ತುಕಾ ಶಿಕ್ಷ್ಯಾ ದಿತಾತ್, ತಿಯಾ ತುಜೆ ಸುಳ್ ಪಾನ್ ಇಬೆ ಕರಿಸಾರ್ಕೆ ಮಿಯಾ ಕರ್ತಾ, ತಿಯಾ ತುಜ್ಯಾ ಧಗ್ಡಾಕ್ನಿ ಹೆಜ್ಯಾನ್ ಫಿಡೆ ಪಯ್ಸೆ ದಿವ್ಕ್ ಹೊಯ್ನಾ. <verse eid="EZK 16:41" /><verse number="42" style="v" sid="EZK 16:42" />ಅಸೆ ಮಿಯಾ ತುಜೆ ವಯ್ಲೊ ಸಗ್ಳೊ ರಾಗ್ ಕಾಡುನ್ಗೆಟ್ಲ್ಯಾ ಮಾನಾ ಮಾಜೊ ರಾಗ್ ತುಜೆಕ್ನಾ ಜಾತಾ, ಮಿಯಾ ಶಾಂತ್ ಹೊವ್ನ್ ಹೆಜ್ಯಾನ್ ಫಿಡೆ ರಾಗ್ ಹೊಯ್ನಾ. <verse eid="EZK 16:42" /><verse number="43" style="v" sid="EZK 16:43" />ತಿಯಾ ತುಜ್ಯಾ ದಾಂಡ್ಗ್ಯಾ ಪಾನಾಚಿ ದಿಸಾ ಯಾದ್ ಕರಿನಸ್ತಾನಾ ಹಿ ಬುರ್ಶಿಕಾಮಾ ಕರುನ್ ಮಾಕಾ ಚಾವ್ತಾಳಿ ಸಾರ್ಕೆ ಕರ್‍ಲೆ ಸಾಟ್ನಿ ಅಬಕ್, ಮಿಯಾ ತುಜ್ಯಾ ಬುರ್ಸ್ಯಾಚಿ ಶಿಕ್ಷ್ಯಾ ತುಜ್ಯಾ ಆಂಗಾರ್ ಘಾಲ್ತಾ, ತಿಯಾ ಮೆಜುಕ್ ಹೊಯ್ನಾ ತವ್ಡಿಚ್ ನ್ಹಯ್ ಹಿ ಪೊಜ್ಡಿ ಕಾಮಾ ಕರುನ್ಗೆತ್ ಗೆಲ್ಲೆ ನಸ್ತಾನಾ, ಹಿ ಬುರ್ಶಿ ಕಾಮಾ ಬಿ ಕರ್‍ಲೆ ನ್ಹಯ್, ಹಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್.<verse eid="EZK 16:43" /></para>
  <para style="s">ಅವ್ಸಿ ಸಾರ್ಕಿ ಲೆಕ್</para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 16:44" />ಸಾಂಗ್ನಿಯಾತ್ನಿ ಹುಶಾರ್ ಹೊತ್ತಿ ಲೊಕಾ ಅವ್ಸಿ ಸಾರ್ಕಿ ಲೆಕ್ ಮನುನ್ ಮನ್ತಲಿ ಗೊಸ್ಟ್ ತುಜ್ಯಾ ವಿಶಯಾತ್ ಸಾಂಗ್ತಾತ್. <verse eid="EZK 16:44" /><verse number="45" style="v" sid="EZK 16:45" />ಘವಾಚೊ ಅನಿ ಪೊರಾಂಚೊ ಕಂಟಾಳೊ ಯೆತಲ್ಯಾ ಅವ್ಸಿಕ್ ತಿಯಾ ಸಮಾ ಹೊಲ್ಲಿ ಲೆಕ್ ಹಾಸ್, ಘವಾಚೊ ಅನಿ ಪೊರಾಂಚೊ ಕಂಟಾಳೊ ಕರುನ್ ಘೆತಲ್ಯಾ ತುಜ್ಯಾ ಅಕ್ಕಾಚ್ಯಾ ತಕ್ಕ್ ತಿಯಾ ಹಾಸ್, ತುಜಿ ಬಾಯ್ ಹಿತ್ತಿಯಾಂಚಿ ಅನಿ ಬಾಬಾ ಅಮೊರಿತಾಂಚೊ.<verse eid="EZK 16:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="EZK 16:46" />ತುಜ್ಯಾ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ ಅಪ್ನಾಚ್ಯಾ ದಾಂಡ್ಗ್ಯಾ ಚೆಡ್ವಾಕ್ನಿ ಘೆವ್ನ್ ವಸ್ತಿ ರಾತಲಿ ಸಮಾರ್ಯ್ ತುಜಿ ಅಕ್ಕಾ, ತುಜ್ಯಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ದಾಂಡ್ಗ್ಯಾ ಚೆಡ್ವಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ವಸ್ತಿ ರಾತಲಿ ಸೊದೊಮ್ ತುಜಿ ಭೆನ್. <verse eid="EZK 16:46" /><verse number="47" style="v" sid="EZK 16:47" />ಖರೆ ತಿಯಾ ಚಲಲ್ಲಿ ಬುರ್ಶಿವಾಟ್ ತೆನಿ ಚಲಲ್ಲಿ ಸಾರ್ಕಿ ನ್ಹಯ್, ತುಜಿ ಕಂಟಾಳ್ಯಾಚಿ ಕಾಮಾ ತೆನಿ ಕರಲ್ಲಿ ಸಾರ್ಕಿ ನ್ಹಯ್, ತೆಂಚಿ ಬುರ್ಶಿ ಚಾಲ್ನುಕ್ ಉಲ್ಲಿಸಿಚ್ ಮನುನ್ ತಿಯಾ ತೆಂಚ್ಯಾಕಿಂತಾಬಿ ಲೈ ಬುರ್ಶಿ ಚಾಲ್ನುಕ್ ಚಲ್ಲೆಯ್. <verse eid="EZK 16:47" /><verse number="48" style="v" sid="EZK 16:48" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೆ ಸಾಂಗ್ತಾ, ಮಾಜ್ಯಾ ಜಿವಾಚ್ಯಾ ವರ್‍ತಿ ಆನ್, ತಿಯಾ ಅನಿ ತುಜ್ಯಾ ಲೆಕಿಯಾನಿ ಚಲಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಸೊದೊಮ್ ತುಜಿ ತಂಗಿನ್ ಹೊಂವ್ದಿತ್, ತಿಚ್ಯಾ ಲೆಕಿಯಾನಿ ಹೊಂವ್ದಿತ್ ಚಲುಕ್ನಾತ್. <verse eid="EZK 16:48" /><verse number="49" style="v" sid="EZK 16:49" />ಸೊದೊಮ್ ಮನ್ತಲ್ಯಾ ತುಜ್ಯಾ ತಂಗಿಚಿ ಚುಕ್ ಬಗ್, ಬಡಾಯ್ ಕರ್‍ತಲೆ, ಪೊಟ್ ಭರುನ್ ಘೆತಲೆ, ಅಪ್ನಾಚ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಸುಕಾತ್ ಬುಡುನ್ ರ್‍ಹಾತಲೆ, ಹೆ ತಿಚ್ಯಾಕ್ಡೆ ಅನಿ ತಿಚ್ಯಾ ಲೆಕಿಯಾಂಚ್ಯಾಕ್ಡೆ ಹೊತ್ತೆ, ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ತಿ ಗರಿಬಾಕ್ನಿ ಮಜತ್ಕಾರಿ ಹೊವ್ಕ್ ನಾ. <verse eid="EZK 16:49" /><verse number="50" style="v" sid="EZK 16:50" />ತೆನಿ ಮಸ್ತಿನ್ ಮಾಜ್ಯಾ ಡೊಳ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ಕಂಟಾಳ್ಯಾಚಿ ಕಾಮಾ ಕರ್ಲ್ಯಾನಿ, ತೆ ಕಾಮಾ ಬಗುನ್ ತೆಂಕಾ ನಾಸ್ ಕರ್ಲೊ. <verse eid="EZK 16:50" /><verse number="51" style="v" sid="EZK 16:51" />ಸಮಾರ್ಯ್ ಮನ್ತಲಿನ್ಬಿ ತಿಯಾ ಕರಲ್ಲ್ಯಾ ಪಾಪಾತ್ನಿ ಅರ್ಧೊ ಪಾಪ್ಬಿ ಕರುಕ್ನಾ, ತಿಯಾ ತುಜ್ಯಾ ಅಕ್ಕಾ ತಂಗಿಯಾಂಚ್ಯಾಕಿಂತಾ ಕಂಟಾಳಾಚಿ ಕಾಮಾ ಕರ್‍ಲೆ, ತಿಯಾ ಕರಲ್ಲ್ಯಾ ಮೆಜುಕ್ ಹೊಯ್ನಾ ತವ್ಡ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾನಿ ತೆನಿ ಚುಕಿದಾರ್ ನ್ಹಯ್ ಮನುನ್ ತಿಯಾ ದಾಕ್ವುನ್ ದಿಲೈ. <verse eid="EZK 16:51" /><verse number="52" style="v" sid="EZK 16:52" />ತುಜಿ ಚುಕಾಚ್ ತುಜ್ಯಾ ಅಕ್ಕಾ ತಂಗಿಯಾಂಚ್ಯಾ ಭಾಜುಕ್ನಾ ಹೊವ್ನ್ ಇಬೆರಾಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತುಕಾ ಬರೆ ದಿಸುಕ್ ಪಾಜೆ, ತೆಂಚ್ಯಾ ಕಿಂತಾ ಲೈ ಬುರ್ಶಿ ಪಾಪಾ ಕರಲ್ಲ್ಯಾ ವಯ್ನಾ, ತೆನಿ ತುಜ್ಯಾ ಕಿಂತಾ ಬರೆ ಸಾರ್ಕೆ ದಿಸುನ್ ಯೆವ್ಲಾತ್, ತಿಯಾ ಮರ್ಯಾದ್ ದಿಸುಚಿ, ಲಜ್ಜ್ಯಾ ಕರುಚಿ, ತುಜ್ಯಾ ಅಕ್ಕಾ, ತಂಗಿಯಾಕ್ನಿ ಚುಕ್ ನಸಲ್ಲೆ ಮನುನ್ ದಾಕ್ವುನ್ ದಿಲೈ.<verse eid="EZK 16:52" /></para>
  <para style="s">ಸೊದೊಮ್ ಅನಿ ಸಮಾರ್ಯಾಚೆ ಪರ್‍ತುನ್ ಭಾಂದಾಪ್</para>
  <para style="p">
    <verse number="53" style="v" sid="EZK 16:53" />ಸೊದೊಮ್ ಅನಿ ತಿಜಿ ಲೆಕಿಯಾ, ಸಮಾರ್ಯ್ ಅನಿ ತಿಜಿ ಲೆಕಿಯಾ ಹೆಂಚಿ ಸಂಕಟ್ ಮಿಯಾ ಚುಕ್ವುತಾ, ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ತುಜಿ ಸಂಕಟಾಬಿ ಚುಕ್ವುತಾ. <verse eid="EZK 16:53" /><verse number="54" style="v" sid="EZK 16:54" />ಅಸೆ ರ್‍ಹಾತಾನಾ, ತಿಯಾ ತುಜ್ಯಾ ಮೆಜ್ನಿಕ್ ಹೊಯ್ ನಸಲ್ಲ್ಯಾ ತವ್ಡ್ಯಾ ಕಂಟಾಳ್ಯಾಚ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ವಯ್ನಾ ತೆಂಕಾ ಸಮಾಧಾನ್ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಲಜ್ಜೆಕ್ ಗಾವ್ತೆಯ್, <verse eid="EZK 16:54" /><verse number="55" style="v" sid="EZK 16:55" />ತನ್ನಾ ಸಮಾರ್ಯ್, ಸೊದೊಮ್, ಮನ್ತಲಿ ಅಕ್ಕಾ ತಂಗಿಯಾ, ತೆಂಚಿ ಲೆಕಿಯಾಬಿ, ಅಪ್ನಾಚ್ಯಾ ಪಯ್ಲೆಚ್ಯಾ ಸ್ಥಿತಿಕ್ ಜಾತಾತ್, ತಿಯಾಬಿ ಅನಿ ತುಜ್ಯಾ ಲೆಕಿಯಾಚ್ಯಾ ತುಮ್ಚ್ಯಾ ಪಯ್ಲೆಚ್ಯಾ ಸ್ಥಿತಿಕ್ ಪಾವ್ತ್ಯಾಸಿ. <verse eid="EZK 16:55" /><verse number="56" style="v" sid="EZK 16:56" />ಆರಾಮಿಚಿ ಲೆಕಿಯಾ, ತಿಚ್ಯಾ ಭೊತ್ಯಾಚಿ ಸಗ್ಳಿ ಲೊಕಾ ತುಕಾ ಕನ್ನಾಬಿ ಚಾಳ್ವುಲಾಗಲ್ಲಿ ಪಿಲಿಸ್ತಿಯಾಂಚಿ ಲೆಕಿಯಾ, ತಿಯಾ ಹೆಂಚ್ಯಾ ಸಗ್ಳ್ಯಾಂಚ್ಯಾ ಶರಾಪಿಕ್ ಗುರಿ ಹೊವ್ಚ್ಯಾ ಪಯ್ಲೆ, <verse eid="EZK 16:56" /><verse number="57" style="v" sid="EZK 16:57" />ತುಜೆ ಬುರ್ಸೆಪಾನ್ ಮ್ಹಾಳಾಕ್ ಯೆತಲ್ಯಾ ಅದ್ದಿತ್ಯಾ ತುಜ್ಯಾ ಮಸ್ತಿಚ್ಯಾ ಎಳಾರ್, ಆಮಾಮಿಯಾಂಚ್ಯಾ ಲೆಕಿಂಚ್ಯಾಕ್ನಾ ಅನಿ ಪಿಲಿಸ್ತಿಯಾಂಚ್ಯಾ ಲೆಕಿಯಾಂಚ್ಯಾಕ್ನಾ ತುಜೆ ನಾವ್ ತೆಂಚ್ಯಾ ತೊಂಡಾತ್ ಯೆವ್ಕ್ ನಾ. <verse eid="EZK 16:57" /><verse number="58" style="v" sid="EZK 16:58" />ತುಜ್ಯಾ ಬುರ್ಸ್ಯಾ ಚಾಲ್ನುಕಿಚೆ ಫಳ್ ತಿಯಾಚ್ ಖಾತಲೆ ಹೊಲೆ, ಹಿ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ.<verse eid="EZK 16:58" /></para>
  <para style="s">ಶಾಶ್ವತಾಕ್ ರಾತಲೊ ಕರಾರ್</para>
  <para style="p">
    <verse number="59" style="v" sid="EZK 16:59" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಸೊ ಮನ್ತಾ, ತಿಯಾ ಕರಾರ್ ಮೊಡುನ್ ಮಾಜಿ ಆನ್ ಮೊಡುನ್, ತಿಯಾ ಕರಲ್ಯಾ ತಕ್ಕ್ ಮಿಯಾ ಶಿಕ್ಷ್ಯಾ ದಿತಾ. <verse eid="EZK 16:59" /><verse number="60" style="v" sid="EZK 16:60" />ಅಸೆ ತರ್ಬಿ ಮಿಯಾ ತುಜ್ಯಾ ದಾಂಡ್ಗೆಪಾನಾತ್ ತುಜ್ಯಾಕ್ನಾ ಕರುನ್ಗೆಟಲ್ಲೊ ಕರಾರ್ ಯಾದೆಕ್ ಹಾನುನ್ಗೆವ್ನ್, ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಕನ್ನಾಬಿ ಚುಕಿನಸಲ್ಲೊ ಕರಾರ್ ಕರುನ್ಗೆವ್ನ್ ಖಾತ್ರಿ ಕರ್ತಾ. <verse eid="EZK 16:60" /><verse number="61" style="v" sid="EZK 16:61" />ಹೆಚ್ಯಾ ಪ್ರಕಾರ್ ಮಿಯಾ ಲೆಕಿಯಾಕ್ನಿಕಿ ಸಾರ್ಕೆ ತುಕಾ ದಿಲ್ಲಿ ತುಜಿ ಅಕ್ಕಾ ಅನಿ ತಂಗಿಯಾ ತುಜ್ಯಾಕ್ಡೆ ಮಿಳ್ತಾನಾ, ತಿಯಾ ತುಜಿ ಬುರ್ಶಿಕಾಮಾ ಯಾದ್ ಕರುನ್ ಘೆವ್ನ್ ಲಜ್ತೆಯ್. ಹಿ ಮಾಜಿ ದಯಾ ತುಜ್ಯಾ ಫಾಟ್ಲ್ಯಾ ಕರಾರಾಚೊ ಫಳ್ ನ್ಹಯ್. <verse eid="EZK 16:61" /><verse number="62" style="v" sid="EZK 16:62" />ಮಿಯಾ ಹ್ಯೊ ಕರಾರ್ ತುಜಾಕ್ನಾ ಕರುನ್ಗೆತಾನಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತುಕಾ ಗೊತ್ತ್ ಹೊತಾ. <verse eid="EZK 16:62" /><verse number="63" style="v" sid="EZK 16:63" />ಮಿಯಾ ತುಜಿ ಬುರ್ಶಿ ಕಾಮಾ ಮಾಪಿ ಕರಲ್ಲ್ಯಾ ಮಾನಾ, ತಿಯಾ ತೆಂಕಾ ಯಾದೆಕ್ ಲಜ್ಜುನ್, ಅವ್ಮಾನ್ ಕರುನ್ ಘೆವ್ನ್, ತುಕಾ ಹೊಲ್ಲ್ಯಾ ಅವ್ಮಾನಾ ಸಾಟ್ನಿ ತಿಯಾ ತೊಂಡ್ ಫೊಡಿನಸ್ತಾನಾ ರ್‍ಹಾತೆಯ್, ಹಿ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ.<verse eid="EZK 16:63" /></para>
  <chapter eid="EZK 16" />
  <chapter number="17" style="c" sid="EZK 17" />
  <para style="s">ಹದ್ದಾಂಚೆ ಅನಿ ಝಾಡಾಂಚೆ ವಿಶಯ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 17:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಹಿ ಗೊಸ್ಟ್ ದಿಲ್ಯಾನ್, <verse eid="EZK 17:1" /><verse number="2" style="v" sid="EZK 17:2" />ನರ್ ಮಾನ್ಸಾ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಹಿ ಕಾನಿ ಒಡ್ಪ್ ವಯ್ನಾ ಸಾಂಗ್, <verse eid="EZK 17:2" /><verse number="3" style="v" sid="EZK 17:3" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಸಾಂಗ್ತಾ, ರುಂದ್ ಅನಿ ಲಾಂಬ್ ರಕುಟ್ಯಾಂಚಿ ಫಾಕಾನಿ ಭರಲ್ಲಿ ಲೈ ನಮುನ್ಯಾಚ್ಯಾ ಬನ್ನಾಚಿ ಮೊಟಿ ಹದ್ದಾ ಲೆಬನೊನಿಕ್ ಎವ್ನ್ ದೆವದಾರು ಝಾಡಾಚ್ಯಾ ವಯ್ಲ್ಯಾ ಭಾಗಾಚಿ ಟಾಂಕಿಯಾ ಕುಟ್ಲ್ಯಾನ್. <verse eid="EZK 17:3" /><verse number="4" style="v" sid="EZK 17:4" />ಲೈ ತುದಿಚೆ ಚಿಗರಾ ಚಾವ್ನ್ ಘೆವ್ನ್ ಯಾವಾರಾಚ್ಯಾ ದೆಸಾತ್ ಜಾವ್ನ್ ಲೈ ಯಾವಾರಿ ಲೊಕಾ ಹೊತ್ತ್ಯಾ ಶಾರ್‍ಹಾತ್ ಥವ್ಲ್ಯಾನ್. <verse eid="EZK 17:4" /><verse number="5" style="v" sid="EZK 17:5" />ತೆಜ್ಯಾ ಮಾನಾ ತೆನಿ ತ್ಯಾ ದೆವದಾರುಚೆ ಝಾಡ್ ಹೊತ್ತ್ಯಾ ದೆಶಾಚಿ ಬಿಂಯ್ ಘೆವ್ನ್ ಜಾವ್ನ್, ಲೈ ಬರ್ಯಾ ಪಾನಿಯಾಚ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಲಾವ್ನ್ ತನ್ನಾ ತೆ ಲೈ ಬರೆ ಪಾನಿಯಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ರ್‍ಹಾತಲ್ಯಾ ಝಾಡಾಚ್ಯಾ ಗತಿನ್ ವಾಡ್ಲೆ. <verse eid="EZK 17:5" /><verse number="6" style="v" sid="EZK 17:6" />ತೆ ಲೈ ಮೊಟೆ ಹೊವ್ನ್ ವಾಡುನ್, ದರಾಕ್ಷಾಚ್ಯಾ ಎಲಿ ಗತಿನ್ ಪಗ್ಳುನ್, ಅಪ್ನಾಚೆ ಫಾಟೊ ತ್ಯಾ ಹದ್ದಾಚ್ಯಾ ಭಾಜುಕ್ ಪಗ್ಳುನ್, ತೆಜ್ಯಾ ಬುಡಿ ಅಪ್ನಾಚಿ ಬೆರಾ ಸೊಡ್ಲ್ಯಾನ್, ತೆ ಎಲ್ ಹೊವ್ನ್ ಫಾಟೆ ಪಗ್ಳುನ್, ಚಿಗುರ್ ಸೊಡ್ಲ್ಯಾನ್. <verse eid="EZK 17:6" /><verse number="7" style="v" sid="EZK 17:7" />ಥೈ ಅನಿ ಎಕ್ ಮೊಟೆ ರುಂದ್ ಫಾಕುಟ್ಯಾಂಚೆ ಹೊತ್ತೆ ಅನಿ ಫಾಕಾ ಹೊತ್ತೆ ಅನಿ ಎಕ್ ಹದ್ದ್ ಹೊತ್ತೆ, ಅಬಕ್ ತಿ ದರಾಕ್ಷಾಚಿ ಎಲ್, ಅಪ್ನಿ ಚಿಗರಲ್ಲ್ಯಾ ಜಾಗ್ಯಾ ವಯ್ನಾ ತೆಜ್ಯಾ ಭಾಜುಕ್ ಅಪ್ನಾಚಿ ಬೆರಾ ಪರ್‍ತುನ್, ಅಪ್ನಾಚಿ ಫಾಟೆ ಪಗ್ಳುನ್, ತೆಜ್ಯಾಕ್ನಾ ಪಾನಿಯಾಚಿ ವಾಟ್ ಬಗಿತ್ ಹೊತ್ತೆ. <verse eid="EZK 17:7" /><verse number="8" style="v" sid="EZK 17:8" />ತೆ ಲೈ ಬರಿ ಎಲ್ ಹೊವ್ನ್ ಅಪ್ನಾಚಿ ಫಾಟೆ ಪಗ್ಳುನ್, ಫಳ್ ದಿವ್ಕ್ ಅನ್ಕುಲ್ ಹೊತಲ್ಯಾ ಬರ್ಯಾ ಪಾನಿಯಾಚ್ಯಾ ಜಾಗ್ಯಾ ವರ್‍ತಿ ಲಾವಲ್ಲೆ ಹೊತ್ತೆ. <verse eid="EZK 17:8" /><verse number="9" style="v" sid="EZK 17:9" />ಅನಿ ತಿಯಾ ಹಿ ಗೊಸ್ಟ್ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಅಸೊ ಮನ್ತಾ, ತೆ ವಾಡ್ವಳ್ಕಿ ಹೊವ್ನ್ ರ್‍ಹಾತಾ ಕಾಯ್? ತೆಕಾ ಲಾವಲ್ಲ್ಯಾ ಹದ್ದಾನ್ ತೆಚಿ ಬೆರಾ ಉಪ್ಸುನ್, ತೆಚೆ ಫಳ್ ತೊಡ್ತಾನಾ, ತೆ ವಾಳುನ್ ತೆಚಿ ಸಗ್ಳಿ ಹಿರ್ವಿ ಪಾನಾ ಬಾವ್ನ್ ಜಾತಾತ್ ನ್ಹಯ್? ತೆ ಬೆರಾ ವಾಂಗ್ಡಾ ಉಪ್ಸುನ್ ಹೊತಾ, ತೆಬಿ ಲೈ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ನಾತರ್ ಲೈ ಬಳಾನ್ ನ್ಹಯ್. <verse eid="EZK 17:9" /><verse number="10" style="v" sid="EZK 17:10" />ಆಹಾ, ಲಾವಲ್ಲಿ ಎಲ್, ಬರಿಚ್ ರ್‍ಹಾತಾ ಕಾಯ್? ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚೊ ವಾರೊ ಮಾರ್ತಾನಾ, ಬಾಡುನ್ ಜಾತ್ಯಾಚ್ ನ್ಹಯ್, ಕಸೆ ವಾಡ್ಲಾ ತಸೆಚ್ ಬಾಡುನ್ ಜಾತಾ.<verse eid="EZK 17:10" /></para>
  <para style="s">ಕಾನಿ ವಿವರನ್ ಕರಲ್ಲೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 17:11" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಅನಿ ಎಕ್ ಗೊಸ್ಟ್ ದಿಲ್ಯಾನ್. <verse eid="EZK 17:11" /><verse number="12" style="v" sid="EZK 17:12" />ಚುಕ್ ಕರಲ್ಲ್ಯಾ ಘರಾನಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಅಸೆ ಸಾಂಗ್, ತುಮ್ಕಾ ಹೆಚೆ ಉದ್ದೆಸ್ ಗೊತ್ತ್ ನಾ ಕಾಯ್? ಅಬಕ್ ಬಾಬೆಲಾಚೊ ರಾಜಾ ಜರುಜಲೆಮಾಕ್ ಎವ್ನ್, ಥೈ ತ್ಲ್ಯಾ ರಾಜಾಕ್ನಿ ಅನಿ ಮುಖಂಡಾಕ್ನಿ ಧರುನ್ಗೆವ್ನ್ ಬಾಬೆಲಾಕ್ ನ್ಹೆಲ್ಯಾನ್. <verse eid="EZK 17:12" /><verse number="13" style="v" sid="EZK 17:13" />ಅನಿ ರಾಜಾಚ್ಯಾ ಘರಾನ್ಯಾಚ್ಯಾ ಎಕ್ಲ್ಯಾಕ್ ಎಚುನ್ ಘೆವ್ನ್, ತೆಜ್ಯಾ ವಾಂಗ್ಡಾ ಕರಾರ್ ಕರುನ್ಗೆವ್ನ್, ತೆಜ್ಯಾಕ್ನಾ ಆನ್ ಕರುಕ್ ಲಾವ್ನ್, <verse eid="EZK 17:13" /><verse number="14" style="v" sid="EZK 17:14" />ತೆಜೊ ರಾಜ್ ವಾಡ್ವಳ್ಕಿ ಹೊಯ್ ನಸ್ತಾನಾ, ಕರಾರಾ ಚಾಲ್ವುನ್ ನ್ಹೆತಲ್ಯಾಂಚ್ಯಾಕ್ನಾಚ್ ಇಬೆರ್‍ಹಾವ್ಚೆ ಮನುನ್ ತ್ಯಾ ದೆಶಾಚ್ಯಾ ಬಲಿಸ್ಟ್ ಲೊಕಾಕ್ನಿ ಘಡಿಚ್ಯಾ ಭಾಯ್ರ್ ಘಾಟ್ಲ್ಯಾನ್. <verse eid="EZK 17:14" /><verse number="15" style="v" sid="EZK 17:15" />ಖರೆ ತೆನಿ ಬಾಬಿಲೊನಾಚ್ಯಾ ರಾಜಾಕ್ ವಿರೊಧ್ ಹೊವ್ನ್ ಘೊಡ್ಕಿಯಾ ಅನಿ ಲೈ ಸಯ್ನಿಕಾಕ್ನಿ ಅಮ್ಕಾ ದಿವ್ಚೆ ಮನುನ್ ಇಜಿಪ್ತಾಕ್ ರಾಜಾ ಖಬ್ರಿಕಾರಾಕ್ನಿ ಸಾಂಗುನ್ ಧಾಡಲ್ಲ್ಯಾನ್, ಹ್ಯೊ ಕಾಯ್ ಅಸೊಚ್ ಕಮ್ಮಿ ನಸಲ್ಲೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾ ಕಾಯ್? ಅಸ್ಲಿ ಕಾಮಾ ಕರಲ್ಲೊ ಸುಟ್ಕಾ ಹೊತಾ ಕಾಯ್? ಕರಾರಾಕ್ನಿ ಮಾನಿ ನಸ್ತಾನಾ ಚಲಲ್ಲೊ ಚುಕ್ವುನ್ ಘೆವ್ನ್ ರಾವ್ಕ್ ಹೊತಾ ಕಾಯ್? <verse eid="EZK 17:15" /><verse number="16" style="v" sid="EZK 17:16" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಮಾಜ್ಯಾ ಜಿವಾವರ್‍ತಿ ಆನ್, ಹೆಕಾ ಕೊನಾಕ್ನಾ ರಾಜಾ ಹೊವ್ನ್ ನೆಮ್ಸುನ್ ಹೊಲಾ, ಅನಿ ಹೆನಿ ಕೊನಾಕ್ ದಿಲ್ಲಿ ಗೊಸ್ಟ್ ಚುಕ್ಲಾ, ಕೊನಾಚ್ಯಾ ಕರಾರಾಕ್ ಖಾಲ್ತಿ ಹೊವ್ನ್ ಚಲುಕ್ನಾ, ತ್ಯಾ ರಾಜಾಕ್ಡೆ, ಮಟ್ಲ್ಯಾರ್ ಬಾಬಿಲೊನ್ ಮನ್ತಲ್ಯಾ ತೆಜ್ಯಾ ವಸ್ತಿಚ್ಯಾ ಜಾಗ್ಯಾ ವರ್‍ತಿ ಹ್ಯೊ ಖರೆಚ್ ಮರ್ತಾ. <verse eid="EZK 17:16" /><verse number="17" style="v" sid="EZK 17:17" />ಫಾರೊವ್ ರಾಜಾಚೊ ಮೊಟೊ ಸಯ್ನ್, ಅನಿ ಮೊಟೊ ಕುಟುಂಬ್ ಎವ್ನ್, ಲೈ ಲೊಕಾಕ್ನಿ ಜಿವ್ ಕಾಡುಚೆ ಮನುನ್ ಬದು ಘಾಲುನ್ ಅನಿ ಬರೊ ರಸ್ತೊ ತಯಾರ್ ಕರುನ್ ಕುಪ್ಪ್ ಭಾಂದ್ಲ್ಯಾನಿ. ಹೆಕಾ ಝಗ್ಡ್ಯಾತ್ ಕಾಯ್ಬಿ ಮಜ್ಜತ್ ಹೊಯ್ನಾ. <verse eid="EZK 17:17" /><verse number="18" style="v" sid="EZK 17:18" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೆನಿ ದಿಲ್ಲಿ ಭಾಸ್ ಮೊಡ್ಲ್ಯಾನ್, ಅನಿ ಕರಾರಾಕ್ನಿ ಮಿಕುನ್ ಚಲ್ಲ್ಯಾನ್, ಹಾತಿ ವರ್‍ತಿ ಹಾತ್ ಥವಲ್ಯಾರ್ ಕಾಯ್ ಹೊಲೆ? ಹೆ ಸಗ್ಳೆ ಕರುನ್ ಸೊಡ್ಲ್ಯಾನ್ ನ್ಹಯ್? ಹ್ಯೊ ಚುಕ್ವುನ್ ಘೆವ್ಕ್ ಹೊಯ್ನಾ. <verse eid="EZK 17:18" /><verse number="19" style="v" sid="EZK 17:19" />ಅಸೆ ರ್‍ಹಾತಾನಾ, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಮಾಜ್ಯಾ ಜಿವಾವರ್‍ತಿ ಆನ್ ಕರುನ್ ಸಾಂಗ್ತಾ, ತೆನಿ ಮಾಕಾ ಆನ್ ಕರಲ್ಲೆ ತಿರಸ್ಕಾರ್ ಕರುನ್, ಮಾಜ್ಯಾ ಕರಾರಾಕ್ನಿ ಚುಕ್ವುನ್ ಘೆಟಲ್ಲೊ ಚುಕೆಚೊ ದೊಸ್ ತೆಜ್ಯಾ ಟಕ್ಲ್ಯಾಕ್ ಭಾಂದ್ತಾ. <verse eid="EZK 17:19" /><verse number="20" style="v" sid="EZK 17:20" />ಮಿಯಾ ತೆಕಾ ಮಾಜೊ ಬಲಿ ಘಾಲ್ತಾ, ತೊ ಮಿಯಾ ಘಾಟಲ್ಲ್ಯಾ ಪಾಸ್ಯಾತ್ ಗಾವ್ನ್ ಪಡ್ತಾ, ತೆಕಾ ಬಾಬೆಲಾಕ್ ಹಾನುನ್ ಥೈಚ್ ತೆಜ್ಯಾ ವಾಂಗ್ಡಾ ವಾದ್ ಕರುನ್, ತೆನಿ ಮಾಕಾ ಕರಲ್ಲ್ಯಾ ಚುಕ್ ತೆಜ್ಯಾ ವರ್‍ತಿ ವಾವ್ತಾ. <verse eid="EZK 17:20" /><verse number="21" style="v" sid="EZK 17:21" />ತೆಜೊ ಸಗ್ಳೊ ಸಯ್ನಾ ಪಗ್ಳುನ್ ಪಳುನ್ ಜಾವ್ನ್, ತಲ್ವಾರಿಕ್ ಗಾವ್ತಾತ್, ಹುರಲ್ಲ್ಯಾಕ್ನಿ ಸಗ್ಳ್ಯಾ ಭಾಜುಕ್ನಾ ಮಾರ್ತಲ್ಯಾ ವಾರ್ಯಾಕ್ ಹುಡ್ವುತಾ, ತನ್ನಾ ಹಿ ಗೊಸ್ಟ್ ಬೊಲಲ್ಲೆ ಸರ್ವೆಸ್ಪರ್ ಮಿಯಾಚ್ ಮನುನ್ ಕಳ್ತಾ.<verse eid="EZK 17:21" /></para>
  <para style="s">ದೆವಾಚ್ಯಾ ಗೊಸ್ಟಿಚೊ ಭರೊಸೊ</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 17:22" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಮಿಯಾಚ್ ದೆವದಾರು ಝಾಡಾಚ್ಯಾ ವಯ್ಲ್ಯಾ ಟಾಂಕಿಯಾ ಕಾಡುನ್ ತೆ ಲಾವ್ನ್, ಲೈ ತುದಿಚ್ಯಾ ಚಿಗರಲ್ಲ್ಯಾತ್ನಿ ಲೈ ಬರೆ ಹೊತ್ತೆ ಕುಟುನ್ ಹಾನುನ್ ಲೈ ಉಪ್ಪರ್ಲ್ಯಾ ಮಡ್ಡಿ ವರ್‍ತಿ ಲಾವ್ತಾ. <verse eid="EZK 17:22" /><verse number="23" style="v" sid="EZK 17:23" />ಮಿಯಾ ತೆ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಮಡ್ಡಿಚ್ಯಾ ಜಾಗ್ಯಾ ವರ್‍ತಿ ಲಾವ್ತಾನಾ, ತೆ ಲೈ ಬರೆ ದೆವದಾರುಚೆ ಝಾಡ್ ಹೊವ್ನ್, ಟಾಂಕಿಯಾ ಪಗ್ಳುನ್, ಫಳ್ ದಿತಾ, ತ್ಯಾತುರ್ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಫಾಕ್ರಾ ವಸ್ತಿ ರ್‍ಹಾವ್ನ್, ತೆಜ್ಯಾ ಟಾಂಕಿಯಾಂಚ್ಯಾ ಸಾವ್ಳಿಕ್ ಆಧಾರ್ ಕರುನ್ ಘೆತಾತ್. <verse eid="EZK 17:23" /><verse number="24" style="v" sid="EZK 17:24" />ತನ್ನಾ ಮಿಯಾ ಸರ್ವೆಸ್ಪರ್ , ಉಪ್ಪರ್ಲ್ಯಾ ಝಾಡಾಕ್ ಕಮ್ಮಿಚೆ ಕರುನ್ ಕಮ್ಮಿಚ್ಯಾ ಝಾಡಾಕ್ ಉಪ್ಪರ್ ಕರುನ್, ಹಿರ್ವ್ಯಾಕ್ ವಾಳ್ವುನ್, ವಾಳ್ಕ್ಯಾಕ್ ಚಿಗ್ರುನ್ ಹಿರ್ವೆ ಕರುನ್ ಥವ್ಲಾ ಮನುನ್ ಡಂಗ್ಳಿತ್ಲಿ ಸಗ್ಳಿ ಝಾಡಾ ಕಳ್ವುನ್ ಘೆತಾತ್, ಹೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಿಯಾ ಬೊಲ್ಲಾ ಅನಿ ತೆ ಮಿಯಾ ಕರ್ತಾ.<verse eid="EZK 17:24" /></para>
  <chapter eid="EZK 17" />
  <chapter number="18" style="c" sid="EZK 18" />
  <para style="s">ವಯ್ತಿಕ್ ಜವಾಬ್ದಾರಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 18:1" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾಕಾ ಸಾಂಗ್ಲ್ಯಾನ್, <verse eid="EZK 18:1" /><verse number="2" style="v" sid="EZK 18:2" />ಬಾಬಾನಿ ಅಂಬೊಟ್ಲಿ ದ್ರಾಕ್ಷಿ ಖಾಲ್ಯಾನಿ, ಖರೆ ಪೊರಾಕ್ನಿ ದಾತಾ ಸಿಳ್ಳ್ ಹೊಲಿ. ಮನ್ತಲಿ ಸಾಂಗ್ನಿ ತುಮಿ ಇಜ್ರಾಯೆಲ್ ದೆಶಾಚ್ಯಾ ವಿಶಯಾತ್ ಸಾಂಗ್ತ್ಯಾಶಿ ಕಶ್ಯಾಕ್? <verse eid="EZK 18:2" /><verse number="3" style="v" sid="EZK 18:3" />ಸರ್ವೆಸ್ಪರ್ ಅಸೆ ಮನ್ತಾ ಮಾಜೆ ಜಿವಾಚೆ ಆನ್ ತುಮಿ ಹಿ ಸಾಂಗ್ನಿ ಇಜ್ರಾಯೆಲಾಕ್ ಲೊಕಾಕ್ನಿ ಕನ್ನಾಬಿ ಸಾಂಗುಚೆ ಮನುನ್ ರ್‍ಹಾಯ್ನಾ. <verse eid="EZK 18:3" /><verse number="4" style="v" sid="EZK 18:4" />ಸಗ್ಳಿ ಜನಾವರಾ ಮಾಜೆಚ್, ಬಾಬಾ ಕಾಯ್ ಪೊರಾ ಕಾಯ್ ಸಗ್ಳಿ ಜನಾವರಾ ಮಾಜ್ಯಾ ತಾಬೆತ್ ಹಾತ್. ಪಾಪ್ ಕರ್ತಲಿ ಜನಾವರ್ ಮರ್ತಾ. <verse eid="EZK 18:4" /><verse number="5" style="v" sid="EZK 18:5" />ಎಕ್ಲೊ ನಿತಿವಂತ್ ಹೊವ್ನ್ ಸಮಾ ಹೊತ್ತೆ ಕರ್ತಾ ಅನಿ ಬರೆ ಹೊತ್ತೆ ಕರ್ತಾ. <verse eid="EZK 18:5" /><verse number="6" style="v" sid="EZK 18:6" />ಮಡ್ಡಿಯಾರ್ನಿ ಬಿ ದಿವ್ನ್ ಹುರಲ್ಲಿ ಖಾಯ್ನಾ, ಇಜ್ರಾಯೆಲ್ ಘರಾನ್ಯಾಚ್ಯಾ ಮುರ್ತಿಯಾಕ್ನಿ ನದರ್ ಘಾಲುನ್ ಬಗಿ ನಸ್ತಾನಾ, ಬುರ್ಸ್ಯಾಚ್ಯಾ ಬಾಯ್ಕೊಕ್ ಹಾಳ್ ಕರಿ ನಸ್ತಾನಾ, <verse eid="EZK 18:6" /><verse number="7" style="v" sid="EZK 18:7" />ಬಾರ್ಯ್ ಹೊಲ್ಲ್ಯಾ ಬಾಯ್ಕೊ ಮನ್ಸಿಕ್ ಮಿಳಿ ನಸ್ತಾನಾ, ಕೊನಾಕ್ ತರಾಸ್ ದಿ ನಸ್ತಾನಾ, ರಿನ್ ಕರಲ್ಯಾಚೆ ಅಡು ಥವಲ್ಲೆ ದಿನಸ್ತಾನಾ, ಕೊನಾಚಿಬಿ ಆಸ್ತಿ ಚೊರುನ್ ಘೆಯ್ ನಸ್ತಾನಾ, ಬುಕ್ ಲಾಗಲ್ಯಾಕ್ ಜೆವಾನ್ ದಿವ್ನ್ ನಾಗ್ಡೆ ಹೊತ್ತ್ಯಾಕ್ನಿ ಕಪ್ಡೆ ದಿವ್ನ್, <verse eid="EZK 18:7" /><verse number="8" style="v" sid="EZK 18:8" />ರಿನಾಕ್ ಬಡ್ಡಿ ಕಾಡಿ ನಸ್ತಾನಾ, ಲಾಬಾಕ್ ಪಯ್ಸೆ ದಿನಸ್ತಾನಾ, ಅನ್ಯಾಯಾತ್ ಹಾತ್ ಘಾಲಿ ನಸ್ತಾನಾ, ಪ್ರತಿವಾದಾಕ್ ಸಾರ್ಕೊ ನ್ಯಾಯ್ ದಿತಾ. <verse eid="EZK 18:8" /><verse number="9" style="v" sid="EZK 18:9" />ಮಾಜಿ ಪದ್ದತ್ ಪಾಳುನ್, ಖರ್ಯಾನ್ ಚಲ್ಲ್ಯಾರ್, ತೊ ಬರ್ಯಾ ವಾಟೆನ್ ಚಲ್ತಲೊ ಹೊವ್ನ್ ಹಾಯ್ ಮನುನ್ ತೊ ಜಿವನ್ ಕರ್ತಾ, ಹಿ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್. <verse eid="EZK 18:9" /><verse number="10" style="v" sid="EZK 18:10" />ಅಸ್ಲ್ಯಾಂಚ್ಯಾ ಪೊಟಾನಿ ಉಪಾಜಲ್ಲೊ ಲೆಕ್. ಅತ್ತಾ ಸಾಂಗಲ್ಲಿ ಬುರ್ಶಿ ಕಾಮಾತ್ನಿ ಖಲೆತರ್ಬಿ ಕರುನ್, <verse eid="EZK 18:10" /><verse number="11" style="v" sid="EZK 18:11" />ಬರ್ಯಾ ಕಾಮಾತ್ನಿ ಖಲೆಬಿ ಕರಿ ನಸ್ತಾನಾ ಮಡ್ಡಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಬಲಿ ಭೆಟ್ವಲ್ಲೆ ಹುರಲ್ಲೆ ಖಾವ್ನ್, ಸೆಜಾರಾಚ್ಯಾ ಬಾಯ್ಕಾಕ್ನಿ ಹಾಳ್ ಕರ್ತಲೊ, <verse eid="EZK 18:11" /><verse number="12" style="v" sid="EZK 18:12" />ತೊ ಗರಿಬಾಕ್ನಿ ತರಾಸ್ ದಿವ್ನ್, ಲೊಕಾಂಚಿ ಆಸ್ತಿ ಖಬ್ಜಾ ಕರುನ್ ರಿನ್ ಕರಲ್ಲ್ಯಾಚಿ ಅಡು ಥವಲ್ಲೆ ದಿನಸ್ತಾನಾ ಮುರ್ತಿಯಾಂಚ್ಯಾ ಕಡೆ ಡೊಳೆ ಉಕ್ಲುನ್ ಬಗುನ್, <verse eid="EZK 18:12" /><verse number="13" style="v" sid="EZK 18:13" />ರಿನಾಕ್ ಬಡ್ಡಿ ಕಾಡುನ್, ರಿನಾಕ್ ಪಯ್ಸೆ ದಿವ್ನ್ ಬಲತ್ಕಾರಾಚೆ ರಗಾತ್ ವತ್ತಲೊ ಹೊಲ್ಯಾರ್ ತೊ ಝಿತ್ತೊ ರ್‍ಹಾತಾ ಕಾಯ್? ನಾ ರ್‍ಹಾಯ್ನಾ, ತೆನಿ ಸಗ್ಳಿ ಬುರ್ಶಿ ಕಾಮಾ ಕರಲ್ಲ್ಯಾ ವಯ್ನಾ, ತೊ ಖರೆಚ್ ಮರ್ತಾ, ಅನಿ ತೆಚ್ಯಾ ಮರ್ನಾಕ್ ತೊಚ್ ಕಾರನ್. <verse eid="EZK 18:13" /><verse number="14" style="v" sid="EZK 18:14" />ಅತ್ತಾ ದುಸ್ರ್ಯಾಹೆಚ್ಯಾ ಪೊಟಾನ್ ಉಪಾಜಲ್ಲೊ ಲೆಕ್ ತೊ ಅಪ್ನಾಚ್ಯಾ ಬಾಬಾನ್ ಕರಲ್ಲಿ ಸಗ್ಳಿ ಪಾಪಾ ಡೊಳ್ಯಾನಿ ಬಗ್ತಾ ಖರೆ ತೆ ಕರಿನಾ. <verse eid="EZK 18:14" /><verse number="15" style="v" sid="EZK 18:15" />ಮಡ್ಡಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಬಲಿಯಾ ಭೆಟ್ವುಲ್ಲೆ ಹುರಲ್ಲೆ ಖಾಲ್ಯಾರ್, ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಪಿಳ್ಗಿಚೆ ಮುರ್ತಿಯಾಂಚ್ಯಾಕ್ಡೆ ಡೊಳೆ ಉಕ್ಲುನ್ ಬಗಟ್ಲ್ಯಾರ್, ಸೆಜಾರಾಚ್ಯಾ ಬಾಯ್ಕಾಕ್ನಿ ಹಾಳ್ ಕರ್ಲ್ಯಾರ್, <verse eid="EZK 18:15" /><verse number="16" style="v" sid="EZK 18:16" />ಕೊನಾಕ್ಬಿ ತರಾಸ್ ದಿಯ್ನಸ್ತಾನಾ, ಅಡು ಥವ್ಚೆ ಮನುನ್ ಇಚಾರಿ ನಸ್ತಾನಾ, ಕೊನಾಚೆ ಚೊರಿನಾ, ಭುಕೆನ್ ಹೊತ್ತ್ಯಾಕ್ನಿ ವಾಡ್ತಾ ಅನಿ ನೆಸುಕ್ ಕಪ್ಡೆ ದಿತಾತ್. <verse eid="EZK 18:16" /><verse number="17" style="v" sid="EZK 18:17" />ಗರಿಬಾಚ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕ್ಲಿ ನಸ್ತಾನಾ, ಬಡ್ಡಿ ಇಚಾರಿ ನಸ್ತಾನಾ, ಫಾಯ್ದ್ಯಾ ಸಾಟ್ನಿ ಪಯ್ಸೆ ದಿನಾ, ತೊ ಮಾಜಿ ಹುಕುಮಾ ಫಾಳ್ತಾ, ತೊ ತೆಚ್ಯಾ ಬಾಬಾಚ್ಯಾ ಪಾಪಾಕ್ನಿ ಲಾಗುನ್ ಮರಿ ನಸ್ತಾನಾ, ಝಿತ್ತೊ ರ್‍ಹಾತಾ. <verse eid="EZK 18:17" /><verse number="18" style="v" sid="EZK 18:18" />ತೆಚ್ಯಾ ಬಾಬಾನ್ ತರ್ ಸ್ವತ್ಯಾಚ್ಯಾ ಕುಳಿಚ್ಯಾಕ್ನಿ ಲೈ ಕರುನ್ ವಾಟುನ್, ಸೊಲುನ್ ಸ್ವತ್ಯಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ಬರ್ಶೆಕಾಮ್ ಕರ್ಲ್ಯಾನ್, ತಸೆ ಹೊವ್ನ್ ಅಪ್ನಿ ಕರಲ್ಲ್ಯಾ ಕರ್ನ್ಯಾ ವಯ್ನಾ ತೊ ಮರ್ತಾ. <verse eid="EZK 18:18" /><verse number="19" style="v" sid="EZK 18:19" />ಲೆಕ್ ನಿತಿನ್ ನ್ಯಾಯಾನ್ ಚಲುನ್ ಅನಿ ಮಾಜಿ ಹುಕುಮಾ ಪಾಳ್ಲ್ಯಾರ್ ಜಿವನ್ ಕರ್ತಾ. <verse eid="EZK 18:19" /><verse number="20" style="v" sid="EZK 18:20" />ಪಾಪ್ ಕರ್ತಲೊಚ್ ಮರ್ತಾ, ಲೆಕ್ ಬಾಬಾಚ್ಯಾ ಬುರ್ಸ್ಯಾ ಪಾನಾಚೆ ಫಳ್ ಅನ್ಭೊಗ್ಸಿನಾ, ಬಾಬಾ ಲೆಕಾಚ್ಯಾ ಬರ್ಶೆ ಪಾನಾಚೆ ಫಳ್ ಅನ್ಭೊಗ್ಸಿನಾ, ಬರ್ಯಾ ಮಾನ್ಸಾಚ್ಯಾ ಬರ್ಯಾ ಪಾನಾಚೆ ಫಳ್, ಬರೆ ಪಾನುಚ್, ಬುರ್ಸ್ಯಾ ಮಾನ್ಸಾಚೆ ಫಳ್ ಬುರ್ಸೆಪಾನುಚ್. <verse eid="EZK 18:20" /><verse number="21" style="v" sid="EZK 18:21" />ಖಲೊಬಿ ಎಕ್ ಬುರ್ಸೊ ಮಾನುಸ್ ಪಾಪ್ ಕರ್‍ತಲೆ, ಸೊಡುನ್ ಮಾಜಿ ಹುಕುಮಾ ಪಾಳುನ್ ಬರಿ ಕಾಮಾ ಕರುನ್ ರಾಲ್ಯಾರ್ ತೊ ಮರಿನಾ. <verse eid="EZK 18:21" /><verse number="22" style="v" sid="EZK 18:22" />ತೆನಿ ಕರಲ್ಲ್ಯಾ ಬರ್ಯಾ ಕಾಮಾಬಿ ತೆಚ್ಯಾ ಮೆಜ್ನಿಕ್ ಜಾಯ್ನಾ, ತೊ ಕರುಲಾಗಲ್ಲ್ಯಾ ಬರ್ಯಾ ಕಾಮಾಚ್ಯಾ ವಯ್ನಾ ತೊ ಝಿತ್ತೊ ರ್‍ಹಾತಾ. <verse eid="EZK 18:22" /><verse number="23" style="v" sid="EZK 18:23" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಶೆ ಮನ್ತಾ, ಬುರ್ಸೊ ಮಾನುಸ್ ಪಾಪ್ ಕರುನ್ ಮರ್ತಲೆ, ಮಾಕಾ ಉಲ್ಲೆಬಿ ಖುಶಿ ನಾ, ಖರೆ ತೊ ಬರ್ಯಾನ್ ರ್‍ಹಾತಲ್ಯಾತ್ ಮಾಕಾ ಖುಶಿ ಹಾಯ್ ಮನ್ತಾ. <verse eid="EZK 18:23" /><verse number="24" style="v" sid="EZK 18:24" />ಖರೆ ಜರ್ ತರ್ ಎಕ್ ಬರೊ ಮಾನುಸ್ ಬರೆ ಪನ್ ಸೊಡುನ್, ಸಗ್ಳಿ ಬುರ್ಶಿ ಕಾಮಾ, ಎಕ್ ಬುರ್ಸೊ ಮಾನುಸ್ ಕರ್ತಲಿ ಕರುಲಲ್ಯಾರ್, ತೊ ಝಿತ್ತೊ ರಾಯ್ಲ್ ಕಾಯ್? ತೆನಿ ಕರಲ್ಲಿ ಬರಿ ಕಾಮಾಬಿ ತೆಜ್ಯಾ ಮೆಜ್ನಿಕ್ ಜಾಯ್ನಾ ತೆನಿ ಕರಲ್ಯಾ ಪಾಪಾಚ್ಯಾ ವಯ್ನಾ ತೊ ಮರ್ತಾ. <verse eid="EZK 18:24" /><verse number="25" style="v" sid="EZK 18:25" />ಖರೆ ತಿಯಾ ಸರ್ವೆಸ್ಪರಾಚಿ ರಿತ್ ಸಮಾ ನಾ ಮನುನ್ ಸಾಂಗುಲಾಗಲ್ಲ್ಯಾ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಘರಾನ್ಯಾಚ್ಯಾನೊ ಮಾಜಿ ರಿತ್ ಸಮಾ ನಾ ಕಾಯ್? ತುಮ್ಚಿ ರಿತುಚ್ ಸಮಾ ನಾ. <verse eid="EZK 18:25" /><verse number="26" style="v" sid="EZK 18:26" />ಕ್ನಾಬರೊ ಮಾನುಸ್ ಬರೆ ಪನ್ ಸೊಡುನ್ ಬುರ್ಶಿ ಕಾಮಾ ಕರುಕ್ ಲಾಗ್ತಾ, ತನ್ನಾ ತೊ ಅಪ್ನಿ ಕರಲ್ಲ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾಕ್ನಿ ಲಾಗುನುಚ್ ಮರುಚೆ ಪಡ್ತಾ. <verse eid="EZK 18:26" /><verse number="27" style="v" sid="EZK 18:27" />ಕನ್ನಾ ಎಕ್ಲೊ ಬುರ್ಸೆ ಪಾಪಾಚೆ ಕಾಮ್ ಸೊಡುನ್ ಬರೆ ಕಾಮ್ ಕರುಕ್ ಲಾಗ್ತಾ. ತೊ ಅಪ್ನಾಚೊ ಜಿವ್ ಹುರ್ವುನ್ ಘೆತಾ. <verse eid="EZK 18:27" /><verse number="28" style="v" sid="EZK 18:28" />ಅಪ್ನಿ ಕಾಯ್ ಕರುಲಾ ಮನ್ತಲೆ ಕಳ್ವುನ್ ಘೆವ್ನ್ ಪಾಪ್ ಕರ್‍ತಲೆ ಸೊಡ್ತಾ ತೊ ಮರಿನಾ, ಖರೆಚ್ ಝಿತ್ತೊ ರ್‍ಹಾತಾ. <verse eid="EZK 18:28" /><verse number="29" style="v" sid="EZK 18:29" />ಅನಿ ತಿಯ್ಯಾ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಘರಾನಾಚಿ ತೆಚಿ ವಾಟ್ ಸಮಾ ನಾ ಮನುನ್ ಸಾಂಗುಲಾತ್ ಖರೆ ಇಜ್ರಾಯೆಲ್ ಘರಾನ್ಯಾಚ್ಯಾಚೊ ತುಮ್ಚಿ ವಾಟುಚ್ ಸಮಾ ನಾ. ಸರ್ವೆಸ್ಪರ್ ಸಾರ್ಕೆ ನಾ ಮನ್ತೆ? ತಿಯಾಚ್ ಸಮಾ ನಾಸ್. <verse eid="EZK 18:29" /><verse number="30" style="v" sid="EZK 18:30" />ಅತ್ತಾ ಮಿಯಾ ಸರ್ವೆಸ್ಪರ್ ತುಮ್ಕಾ ಇಜ್ರಾಯೆಲಾಚ್ಯಾಕ್ನಿ ಸಾಂಗುಕ್ ಲಾಗ್ಲಾ, ತುಮಿ ಕರಲ್ಲ್ಯಾ ಕಾಮಾ ವಯ್ನಾ, ತುಮ್ಚ್ಯಾ ಹರ್ ಎಕ್ಲ್ಯಾಚೊ ನಿರ್ದಾರ್ ಕರ್ತಾ, ತುಮಿ ಕರುಲಾಗಲ್ಲಿ ಬುರ್ಶಿ ಕಾಮಾ ಸೊಡಾ ಅನಿ ತುಮ್ಚಿ ಪಾಪಾ ತುಮ್ಕಾ ಹಾಳ್ ಕರುಕ್ ಸೊಡುನಕಾಸಿ. <verse eid="EZK 18:30" /><verse number="31" style="v" sid="EZK 18:31" />ತುಮಿ ಕರುನ್ಗೆತ್ ಯೆಲ್ಲ್ಯಾ ಪಾಪಾಚಿ ಕಾಮಾ ಸಗ್ಳಿ ತುಮ್ಚ್ಯಾಕ್ನಾ ಕಾಡುನ್ ಟಾಕುನ್ ತುಮ್ಚಿ ಮನಾ ಅನಿ ಸ್ವಭಾವಾ ನ್ಹವೊ ಕರುನ್ ಘೆವಾ, ಇಜ್ರಾಯೆಲಾನೊ ತುಮಿ ಕಶ್ಯಾಕ್ ಮರ್‍ತ್ಯಾಸಿ? <verse eid="EZK 18:31" /><verse number="32" style="v" sid="EZK 18:32" />ಮಾಕಾ ಮರ್ತಲ್ಯಾಚ್ಯಾ ಮರ್ನಾತ್ ಖುಸಿ ನಾ. ತುಮ್ಚೊ ಪಾಪಾಚೊ ಮನ್ ಪರ್‍ತುನ್ ಘೆವ್ನ್ ಜಿವನ್ ಕರಾ, ಹಿ ಸರ್ವೆಸ್ಪರಾಚಿ ಗೊಸ್ಟ್. ನಕ್ಕೊ, ತುಮ್ಚೆ ಪಾತ್ಕಿ ಜಿವನ್ ಬದ್ಲಾ ಮನ್ತಾ ಸರ್ವೆಸ್ಪರ್ .<verse eid="EZK 18:32" /></para>
  <chapter eid="EZK 18" />
  <chapter number="19" style="c" sid="EZK 19" />
  <para style="s">ದುಕ್ಕಾಚಿ ಗಿತ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 19:1" />ಮಾಕಾ ಸರ್ವೆಸ್ಪರಾನ್, ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ರಾಜಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಹಿ ದುಕ್ಕಾಚಿ ಗಿತ್ ಸಾಂಗ್,<verse eid="EZK 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="EZK 19:2" />ತುಜಿ ಅವ್ಸ್ ಸಿಂವಾಚ್ಯಾ ಮದ್ದಿ,</para>
  <para style="q1" vid="EZK 19:2">ಸಿಂವಿನ್, ಬಾಳಗ್ಲಿನ್ ಅಪ್ನಾಚ್ಯಾ ಪೊರಾಕ್ನಿ ದಾಂಡ್ಗ್ಯಾ ಸಿಂವಾಚ್ಯಾ ಮದ್ದಿ ರ್‍ಹಾವ್ನ್.<verse eid="EZK 19:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="EZK 19:3" />ತಿನಿ ಮೊಟೆ ಖಲ್ಲ್ಯಾ ಎಕ್ ಪಿಲ್ಲ್ ಮೊಟೊ ಸಿಂವ್ ಹೊಲೆ ಶಿಕಾರ್ ಕರುಕ್ ಶಿಕುನ್,</para>
  <para style="q2" vid="EZK 19:3">ಲೊಕಾಕ್ನಿ ಮಾರುನ್ ಖವ್ಕಲಾಗ್ಲೊ,<verse eid="EZK 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 19:4" />ದೆಶಾನಿ ಹಿ ಖಬರ್ ಆಯ್ಕುನ್ ಖಡ್ಡೊ ಖಂಡುನ್ ತ್ಯಾತುರ್ ಪಡ್ಲೆ,</para>
  <para style="q1" vid="EZK 19:4">ತೆಕಾ ಸರ್ಪೊಳಿನ್ ಭಾಂದುನ್ ಅವ್ಳುನ್,</para>
  <para style="q2" vid="EZK 19:4">ಇಜಿಪ್ಟ್ ದೆಸಾಕ್ ನೆಲ್ಯಾನಿ.<verse eid="EZK 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 19:5" />ತ್ಯಾ ಸಿಂವಿನಿನ್ ಅಪ್ನಿ ರಾಕುನ್ ಗೆತ್ ಬಸ್ಲ್ಯಾರ್ಬಿ ಅಪ್ನಾಚಿ ಆಶ್ಯಾ ಹಾಳ್ ಕರುನ್ ಘೆಯ್ ನಸ್ತಾನಾ,</para>
  <para style="q2" vid="EZK 19:5">ಅಪ್ನಾಚ್ಯಾ ಪಿಲ್ಲಾತ್ನಿ ಅನಿ ಎಕ್ ಕಾಡುನ್ ಘೆವ್ನ್ ಬಾಳ್ಗುನ್ ಮೊಟೆ ಕರ್‍ಲಿನ್.<verse eid="EZK 19:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="EZK 19:6" />ತೆಬಿ ಸಿಂವ್ ಮೊಟೊ ಹೊವ್ನ್ ಹುರಲ್ಯಾ ಸಿಂವಾ ಮದ್ದಿ ಫಿರುಂಗೆತ್,</para>
  <para style="q2" vid="EZK 19:6">ಶಿಕಾರ್ ಕರ್‍ತಲೆ ಶಿಕುನ್ ಮನ್ಸಾಕ್ನಿ ಖಾವ್ಕ್ ಚಾಲು ಕರ್ಲ್ಯಾನ್.<verse eid="EZK 19:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="EZK 19:7" />ತೆ ಶಾರಾ ನಾಶ್ ಕರುನ್,</para>
  <para style="q2" vid="EZK 19:7">ಲೈ ಲೊಕಾ ಘವ್ ಮರಲ್ಯಾ ಬಾಯ್ಕಾಕ್ನಿ ಹಾಳ್ ಕರ್ಲ್ಯಾನ್,</para>
  <para style="q1" vid="EZK 19:7">ತೆಚ್ಯಾ ಘಜ್ನಿಕ್ ಭ್ಹಿವ್ನ್ ತೆಚ್ಯಾ ಇದ್ರಾಕ್ ಕಾಯ್ಬಿ ನಾ ಸಾರ್ಕೆ ಹೊಲೆ.<verse eid="EZK 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 19:8" />ತನ್ನಾ ದೆಶಾ ಭೊತ್ಯಾನಿ ರಾಜಾಕ್ನಾ ಗೊಳಾ ಯೆವ್ನ್,</para>
  <para style="q2" vid="EZK 19:8">ತೆಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಉಟುನ್,</para>
  <para style="q2" vid="EZK 19:8">ಜಾಳಿ ಘಾಲುನ್ ಖಡ್ಡೊ ಕಾಡಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಗಾವುನ್ ಪಡ್ಲೆ,<verse eid="EZK 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 19:9" />ತೆನಿ ಸರ್ಪೊಳಿನ್ ಭಾಂದುನ್ ಪಂಜರಾತ್ ಘಾಲುನ್,</para>
  <para style="q2" vid="EZK 19:9">ಬಾಬಿಲೊನಾಚ್ಯಾ ರಾಜಾಕ್ಡೆ ಹಾನ್ಲ್ಯಾನಿ,</para>
  <para style="q1" vid="EZK 19:9">ತೆಚಿ ಧನ್ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಮಡ್ಡಿತ್ ತೆಚೊ ಅವಾಜ್ ಯೆಯ್ ನಸಿ ಸಾರ್ಕೆ ರಾಕುಂಗೆತ್ ಹೊತ್ತೆ.<verse eid="EZK 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 19:10" />ತುಜಿ ಅವ್ಸ್ ಪಾನಿಯಾಚ್ಯಾ ಜಾಗ್ಯಾರ್ ಲಾವಲ್ಲಿ ದರಾಕ್ಷಾಚ್ಯಾ ಎಲಿಚೊ ಫಾಟೊ ಹೊವ್ನ್ ಹೊತ್ತಿ,</para>
  <para style="q2" vid="EZK 19:10">ತ್ಯಾ ಜಾಗ್ಯಾರ್ ಪಾನಿ ಹೊತ್ತ್ಯಾ ವಯ್ನಾ ತೊ ಫಾಟೊ ತಾಕ್ತಿನ್ ಹಿರ್ವೆ ಹೊವ್ನ್ ವಾಡ್ಲೊ.<verse eid="EZK 19:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="EZK 19:11" />ತ್ಯಾತುರ್ ಹೊತ್ತಿ ರಾಜಾಚೊ ದಾಂಡೊ ಯೊಗ್ಯ್ ಹೊತ್ತಿ</para>
  <para style="q1" vid="EZK 19:11">ಘಟ್ಲ್ಯಾ ಫಾಟ್ಯಾಂಚ್ಯಾ ಹುರಲ್ಲ್ಯಾ ಬುಡ್ಚಿಯಾಂಚ್ಯಾಕಿಂತಾ ಲೈ ಹೊವ್ನ್ ಉಪ್ಪರ್ ಮದ್ದಿ ಉಪ್ಪರ್ ಹೊವ್ನ್ ದಿಸಿತ್.<verse eid="EZK 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 19:12" />ಖರೆ ತೊ ಫಾಟೊ ರಾಗಾನಿ,</para>
  <para style="q1" vid="EZK 19:12">ಉಪ್ಸುನ್ ಕಾಡುನ್ ಜಿಮ್ನಿ ವರ್‍ತಿ ಹೊಡಾಂಗುನ್ ಹೊಲೆ,</para>
  <para style="q2" vid="EZK 19:12">ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ವ್ಹಾರೊ ಎವ್ನ್ ತೆಂಚಿ ಫಳಾ ವಾಳ್ವುಲ್ಯಾನ್,</para>
  <para style="q2" vid="EZK 19:12">ತೆಚಿ ಘಟ್ಲಿ ಟಾಳಿಯಾ ಮೊಡುನ್ ವಾಳುನ್ ಗೆಲಿ ಅನಿ ಆಗಿನ್ ತೆಂಕಾ ಬಸಮ್ ಕರ್‍ಲಿನ್.<verse eid="EZK 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 19:13" />ಅತ್ತಾ ಹೆ ಪಾನಿ ನಸಲ್ಲ್ಯಾ ವಾಳ್ಕ್ಯಾ ಜಾಗ್ಯಾರ್ ಲಾವ್ನ್ ಹೊಲಾ.<verse eid="EZK 19:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="EZK 19:14" />ತಿಚ್ಯಾ ಟಾಳಿಯಾಂಚ್ಯಾ ವಯ್ನಾ ಆಗ್ ಜಾವ್ನ್ ಬಸಮ್ ಕರಲ್ಯಾ ವಯ್ನಾ,</para>
  <para style="q2" vid="EZK 19:14">ರಾಜಾಚ್ಯಾ ದಾಂಡ್ಯಾಕ್ ಯೊಗ್ಯ್ ಅಸಲ್ಲಿ ಫಾಟೊ ತ್ಯಾತುರ್ ಹುರುಕ್ನಾ,</para>
  <para style="q2" vid="EZK 19:14">ಹೆ ಎಕ್ ದುಕ್ಕ್ ಅನಿ ದುಕ್ಕೆಚಿ ಗಿತ್ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 19:14" /></para>
  <chapter eid="EZK 19" />
  <chapter number="20" style="c" sid="EZK 20" />
  <para style="s">ಸರ್ವೆಸ್ಪರಾ ಚಿತ್ತ್ ಅನಿ ಮಾನ್ಸಾಚೆ ಸಾಹಾಸ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 20:1" />ಜೆಹೊಯಾಕಿಮ್ ಬಂಧಿಹೊಲ್ಲ್ಯಾ ಸಾತ್ವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಪಾಚ್ವ್ಯಾ ಮ್ಹಯ್ನ್ಯಾಚ್ಯಾ ಧಾವ್ಯಾ ದಿಸಾತ್, ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಜಾಂನ್ತ್ಯಾತ್ನಿ ಉಲ್ಲಿ ಲೊಕಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಪರಸ್ನೆ ಇಚಾರುಕ್ ಮನುನ್ ಎವ್ನ್ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಬಸ್ಲ್ಯಾನಿ. <verse eid="EZK 20:1" /><verse number="2" style="v" sid="EZK 20:2" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಅಶೆ ಸಾಂಗ್ಲ್ಯಾನ್, <verse eid="EZK 20:2" /><verse number="3" style="v" sid="EZK 20:3" />ನರ್ ಮಾನ್ಸಾ, ತ್ಯಾ ಮುಖಂಡಾನಿಕ್ಡೆ ಬೊಲುನ್ ಅಶೆ ಸಾಂಗ್, ತುಮಿ ಮಾಜ್ಯಾ ಮನಾತ್ಲಿ ಖುಶಿ ಇಚಾರುಕ್ ಯೆಲ್ಯಾಶಿ ನ್ಹಯ್? ಮಾಜ್ಯಾ ಜಿವಾ ವರ್‍ತಿ ಆನ್, ಮಿಯಾ ಝಿತ್ತೊ ದೆವ್ ಹೊಲ್ಲ್ಯಾ ವಯ್ನಾ, ತುಮ್ಕಾ ಕಾಯ್ಬಿ ಇಚಾರುಕ್ ಸೊಡಿನಾ, ಮನುನ್ ಸರ್ವೆಸ್ಪರ್ ಸಾಂಗ್ತಾ. <verse eid="EZK 20:3" /><verse number="4" style="v" sid="EZK 20:4" />ತಿಯಾ ತೆಂಕಾ ಹೆ ಸಾಂಗುಕ್ ತಯಾರ್ ಹಾಸ್ ನ್ಹಯ್? ನರ್ ಮಾನ್ಸಾ, ತಸೆ ಕರ್ ಅನಿ ತೆಂಕಾ ತೆಂಚ್ಯಾ ವಾಡ್ ವಡ್ಲಾಂಚೆ ಕರಲ್ಲಿ ಬುರ್ಶಿ ಕಾಮಾ ಸಮ್ಜುನ್ ಸಾಂಗ್. <verse eid="EZK 20:4" /><verse number="5" style="v" sid="EZK 20:5" />ಖಲ್ಯಾ ದಿಸಾತ್ನಿ ಮಿಯಾ ಇಜ್ರಾಯೆಲಾಕ್ ಎಚುನ್ ಕಾಡಲ್ಲೆ ತನ್ನಾ ತೆಂಕಾ ಭಾಸ್ ದಿಲ್ಲೊ, ಮಿಯಾ ತೆಕಾ ಇಜಿಪ್ತಾತ್ ಮಾಜೊ ರುಪ್ ದಾಕ್ವುಲೊ ಅನಿ ತೆಂಕಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಸಾಂಗ್. <verse eid="EZK 20:5" /><verse number="6" style="v" sid="EZK 20:6" />ತ್ಯಾ ದಿಸಾತ್ನಿ ಮಿಯಾ ತುಮ್ಕಾ ಇಜಿಪ್ತ್ ದೆಸಾಕ್ನಾ ಭಾಯ್ರ ಕಾಡುನ್, ಮಿಯಾ ತೆಂಚ್ಯಾ ಸಾಟ್ನಿ ಹುಡಕಲ್ಲ್ಯಾ ದುದ್ದ್ ಅನಿ ಮ್ಹವ್ ಹಂವ್ತಲ್ಯಾ ದೆಸಾಕ್ನಾ ಸಗ್ಳ್ಯಾ ದೆಸಾತ್ನಿ ಲೈ ಸುಂದರ್ ಹೊತ್ತ್ಯಾ ದೆಸಾಕ್ ತೆಂಕಾ ಬಲ್ವುನ್ ಹಾನ್ತಾ, ಮನುನ್ ಮಿಯಾ ಮನುನ್ ಗೊಸ್ಟ್ ದಿಲ್ಲೊ. <verse eid="EZK 20:6" /><verse number="7" style="v" sid="EZK 20:7" />ಮಿಯಾ ತೆಂಚೊ ದೆವ್ ಹೊಲ್ಲ್ಯಾ ವಯ್ನಾ, ತೆಂಕಾ ತೆಂಚಿ ಬುರ್ಶಿ ಮುರ್ತಿಯಾ ಧುರ್ ಟಾಕುನ್, ಇಜಿಪ್ತಾಚ್ಯಾ ಝುಟ್ಯಾ ದೆವಾಕ್ನಿ ಲಾಗುನ್ ಅಪ್ನಾಚೆ ಪವಿತ್ರಪಾನ್ ಹಾಳ್ ಕರುನ್ ಘೆವ್‍ನಕಾಶಿ, ಮಿಯಾ ತುಮ್ಚೊ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮನುನ್ ಹುಶಾರ್ಕಿ ದಿಲೊ. <verse eid="EZK 20:7" /><verse number="8" style="v" sid="EZK 20:8" />ತೆನಿ ತರ್ ಗೊಸ್ಟ್ ಆಯ್ಕುಕ್ನ್ಯಾತ್ ಮಾಜೆ ವಿರೊಧ್ ಹೊಲ್ಯಾನಿ, ತೆಂಚ್ಯಾ ಡೊಳ್ಯಾಕ್ನಿ ಬರೆ ಮನುನ್ ದಿಸ್ತಲಿ ಸಾಮಾನಾ ಕೊನಿಬಿ ಅನಿ ತೆನಿ ಮುರ್ತಿಯಾ ಟಾಕುಕ್ನ್ಯಾತ್ ಅನಿ ಇಜಿಪ್ತಾ ಮಾಜೊ ರಾಗಾನಿ ಸೊಡುಕ್ ತಯಾರ್ ಹೊತ್ತೊ. <verse eid="EZK 20:8" /><verse number="9" style="v" sid="EZK 20:9" />ತರ್ಬಿ ತುಮ್ಕಾ ಇಜಿಪ್ತ್ ದೆಶಾಚ್ಯಾ ಪಾರ್ ಕರ್ತಾ ಮನುನ್ ಲೊಕಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಮಿಯಾ ಪರ್ಗಟ್ ಕರ್ಲೊ ಮನುನ್ ಯೆವ್ಜುನ್ ತೆಂಚ್ಯಾ ಭೊತ್ಯಾನಿ ತ್ಯಾ ದೆವಾಚ್ಯಾ ವಿಶಯಾತ್ ಬೊಲುನ್ಹಯ್, ತೆ ಸೊಸುನ್ ಫಿರೆ ಹೊಲಾ ಅತ್ತಾ ಅನಿ ಗಪ್ ರ್‍ಹಾಯ್ನಾ. <verse eid="EZK 20:9" /><verse number="10" style="v" sid="EZK 20:10" />ಅನಿ ಮಿಯಾಚ್ ತೆಂಕಾ ಇಜಿಪಾತ್ನಾ ಸುಟ್ಕಾ ಕರುನ್ ಹಾನುನ್ ಮರುಭುಮಿತ್ ಹಾನುನ್ ತನ್ನಾ, <verse eid="EZK 20:10" /><verse number="11" style="v" sid="EZK 20:11" />ಮಿಯಾ ತೆಂಕಾ ಮಾಜಿ ಹುಕುಮಾ ದಿವ್ನ್, ಮಾಜೊ ಕಾನುನ್ ಸಿಕ್ವುಲೊ, ಹೆ, ಜೆ ಕೊನ್ ಪಾಳ್ತಾ, ತೆಕಾ ಕಳ್ವುಲೊ. <verse eid="EZK 20:11" /><verse number="12" style="v" sid="EZK 20:12" />ಅಸಿ ರ್‍ಹಾತಾನಾ ಮಿಯಾ ತೆಂಕಾ ಸಬ್ಬಾತ್ ಅಮ್ಚಾ ಮದ್ದಿ ಎಕ್ ಕರಾರ್ ಹೊವ್ನ್ ದಿಲಾ, ಅನಿ ಪವಿತ್ರ್ ಕರ್ತಲೊ ದೆವ್ ಮಿಯಾಚ್ ಮನುನ್ ಯಾದ್ ಕರುನ್ ದಿಲಾ. <verse eid="EZK 20:12" /><verse number="13" style="v" sid="EZK 20:13" />ಖರೆ ತೆನಿ ಮರುಭುಮಿತ್ ಬಿ ಮಾಕಾ ಹುರ್ಪಾಟಿ ಹೊವ್ನ್ ದುಕ್ವುಲ್ಯಾನಿ, ತೆನಿ ಮಾಜೊ ಕಾನುನ್ ಮೊಡುನ್ ಹುಕುಮಾ ಸ್ವಿಕಾರುನ್ಯಾತ್, ಜೆ ಕೊನ್ ಹೆ ಪಾಳ್ತಾ, ತೊ ಝಿತ್ತೊ ರ್‍ಹಾತಾ, ತೆನಿ ಸಾಬ್ಬಾತ್ ಬಿ ಪಾಳುನಾತ್, ಮಿಯಾ ತೆಂಕಾ ಮರುಭುಮಿತ್ ರಾಗ್ ಸಾರುನ್ಗೆವ್ಚೆ ಮನುನ್ ಘೆಟಲ್ಲೊ. ನಾಸ್ ಕರುಕ್ ತಯಾರ್ ಹೊತ್ತೊ. <verse eid="EZK 20:13" /><verse number="14" style="v" sid="EZK 20:14" />ಹೊಲ್ಯಾರ್ಬಿ ಮಿಯಾ ತಸೆ ಕರುಕ್ನಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಮಿಯಾ ಇಜಿಪ್ತಾತ್ನಾ ಇಜ್ರಾಯೆಲಾಕ್ ಭಾಯ್ರ್ ಹಾನಲ್ಲೆ ದೆಶಾನಿ ಬಗ್ಲ್ಯಾನಾತ್ ಆನಿ ಮಾಜೆ ನಾವ್ ಹಾಳ್ ಹೊತಲೆ ನಕ್ಕೊ ಮನುನ್, ಮಾಜ್ಯಾ ನಾವಾಕ್ ಲಾಗುನ್ ಸೊಸುನ್ ಘೆಟ್ಲೊ. <verse eid="EZK 20:14" /><verse number="15" style="v" sid="EZK 20:15" />ತಸೆ ಹೊವ್ನ್ ಸಗ್ಳ್ಯಾ ದೆಶಾಚ್ಯಾ ವಯ್ಬವಾನಿ ಭರಲ್ಲೆ ಕಲೆ ದೆಸಾತ್ ಮರುಭುಮಿತ್ ಮಿಯಾ ತೆಂಕಾ ದಿಲ್ಲ್ಯಾ ದುದ್ದ್ ಅನಿ ಮ್ಹವ್ ಹೊವ್ತಲ್ಯಾ ದೆಸಾಕ್ ಧಾಡಿನಾ ಮನುನ್ ಗೊಸ್ಟ್ ದಿಲೊ. <verse eid="EZK 20:15" /><verse number="16" style="v" sid="EZK 20:16" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೆನಿ ಮಾಜಿ ಹುಕುಮಾ ಅನಿ ಕಾನುನ್ ಮೊಡುನ್ ಸಾಬ್ಬಾತ್ ಪಾಳಿನಸ್ತಾನಾ, ಮುರ್ತಿಯಾಂಚಿ ಪುಜಾ ಕರಲ್ಲ್ಯಾ ವಯ್ನಾ, ಮಿಯಾ ತೆ ಭಾಸ್ ಘೆಟ್ಲಾ. ಸಾಬ್ಬಾತ್ ದಿಸಾ ಅಪವಿತ್ರ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EZK 20:16" /><verse number="17" style="v" sid="EZK 20:17" />ಖರೆ ಮಾಕಾ ತೆಂಚೊ ಪಾಪ್ ದಿಸುನ್ ಕಾಳ್ಜಿ ಮಿಯಾ ತೆಂಕಾ ಮರುಭುಮಿತ್ ಮಾರುಚೆ ನ್ಹಯ್ ಮನುನ್ ನಿರ್ದಾರ್ ಕರ್ಲೊ. <verse eid="EZK 20:17" /><verse number="18" style="v" sid="EZK 20:18" />ಮಾನಾ ಮಿಯಾ ಡಂಗ್ಳಿತ್ ತೆಂಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ತುಮಿ ತುಮ್ಚ್ಯಾ ಬಾಬಾಚ್ಯಾ ಹುಕುಮಾಕ್ನಿ ಮಾನ್ ದಿ ನಸ್ಲ್ಯಾರ್, ತೆಚ್ಯಾ ನಿಯಮಾಕ್ನಿ ಮಾನುನ್ ಚಲಿ ನಸ್ಲ್ಯಾರ್ ತೆಚ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾಕ್ನಾ ತುಮ್ಕಾ ಬುರ್ಸೆ ಕರುನ್ ಘೆಯ್ ನಸ್ತಾನಾ ರ್‍ಹಾವ್ಚೆ. <verse eid="EZK 20:18" /><verse number="19" style="v" sid="EZK 20:19" />ಮಿಯಾ ತುಮ್ಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರ್ , ಮಾಜಿ ಹುಕುಮಾ ಪಾಳುನ್ ಮಾಜ್ಯಾ ಪದ್ಧತಿಚ್ಯಾ ಚಲಾ ಸಾರ್ಕೆ ಅನಿ ಕಾನುನಾ ಪಾಳಾ. <verse eid="EZK 20:19" /><verse number="20" style="v" sid="EZK 20:20" />ಮಿಯಾ ನೆಮಲ್ಲಿ ಸಬ್ಬಾತಾಚಿ ದಿಸಾ ಮಾಜೊ ಪರಿಶುದ್ದ್ ದಿಸ್ ಮನುನ್ ಆಚರನ್ ಕರಾ, ಮಿಯಾಚ್ ತುಮ್ಚೊ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ಸಗ್ಳ್ಯಾ ಲೊಕಾನಿ ಕಳ್ವುನ್ ಘೆವ್ಕ್ ಅನಿ ತುಮ್ಕಾ ವಳಕ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಮನುನ್ ಸಾಂಗ್ಲೊ. <verse eid="EZK 20:20" /><verse number="21" style="v" sid="EZK 20:21" />ಖರೆ ತ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಮಾಜ್ಯಾ ವರ್‍ತಿ ಪರ್‍ತುನ್ ಪಡ್ಲ್ಯಾನಿ, ಮಾಜ್ಯಾ ಹುಕುಮಾ ಪಾಳುನ್ ಚಲುಕ್ ನಾ, ಪಾಳುನ್ ಘೆವ್ನ್ ಚಲಲ್ಯಾಕ್ನಿ ಜಿವಾಧಾರ್ ಹೊಲ್ಲ್ಯಾ ಮಾಜ್ಯಾ ಪದ್ದತಿಕ್ನಿ ಪಾಳುನ್ ಘೆವ್ನ್ ಚಲುಕ್ನ್ಯಾಸಿ, ಮಿಯಾ ನೆಮಲ್ಲ್ಯಾ ಸಬ್ಬತ್ ದಿಸಾಕ್ನಿ ಅಪಡ್ಸಿಪಡ್ ಕರ್ಲ್ಯಾನಿ, ತೆಚ್ಯಾ ವಯ್ನಾ ಮಿಯಾ ಡಂಗ್ಳಿತ್ ಹೆಂಚ್ಯಾ ವರ್‍ತಿ ಮಾಜೊ ಲೈ ಮೊಟ್ಟ್ಯಾ ರಾಗಾನಿ ಮಾಜೊ ರಾಗ್ ಕಾಡುನ್ ಘೆತಾ. <verse eid="EZK 20:21" /><verse number="22" style="v" sid="EZK 20:22" />ಹೊಲ್ಯಾರ್ಬಿ ಮಿಯಾ ಖಲ್ಯಾ ದೆಶಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ತೆಂಕಾ ಪಾರ್ ಕರ್ಲಾ, ತ್ಯಾ ದೆಶಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಮಾಜೆ ನಾವ್ ವಾಯ್ಟ್ ಹೊವ್ಚೆ ನ್ಹಯ್ ಮನುನ್, ಮಾಜ್ಯಾ ನಾವಾಚ್ಯಾ ವಯ್ನಾ ಸಂಬಾಳುನ್ ಘೆವ್ನ್ ಹಾತ್ ಫಾಟಿ ಕಾಡುನ್ ಘೆಟ್ಲೊ. <verse eid="EZK 20:22" /><verse number="23" style="v" sid="EZK 20:23" />ಮಿಯಾ ತೆಂಕಾ ದೆವಾಕ್ ಮಾನ್ ದಿ ನಸಲ್ಲ್ಯಾ ಲೊಕಾತ್ನಿ ಪಗಳ್ತಾ ಮನುನ್, ಮರುಭುಮಿತ್ ಆನ್ ಕರುನ್ ಸಾಂಗಲ್ಲೊ. <verse eid="EZK 20:23" /><verse number="24" style="v" sid="EZK 20:24" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಮಾಜಿ ಲೊಕಾ ಮಾಜಿ ಹುಕುಮಾ ಮಾನುನ್ ಘೆವ್ನ್ ಚಲಿ ನಸ್ತಾನಾ, ಮಾಜಿ ನಿಯಮಾ ಸೊಡುನ್ ಮಿಯಾ ನೆಮಲ್ಲಿ ಸಬ್ಬತ್ ದಿಸಾ ಅಪ್ಡಸಿಪ್ಪಡ್ ಕರುನ್ ತೆಂಚ್ಯಾ ವಾಡ್ ವಡ್ಲಾಂಚ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಡೊಳೆ ಪರತ್ಲಾತ್. <verse eid="EZK 20:24" /><verse number="25" style="v" sid="EZK 20:25" />ಅಸೆ ರ್‍ಹಾತಾನಾ, ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳ್ವುನ್ ಘೆವ್ಚೆ ಮನುನ್ ಮಿಯಾ ತೆಂಕಾ ಬರಿ ನಸಲ್ಲಿ ಹುಕುಮಾ ಜಿವನಾತ್ ಆಧಾರ್ ನತ್ತೆ ಪದ್ದತಿಯಾಕ್ನಿ ನೆಮಸ್ಲೊ. <verse eid="EZK 20:25" /><verse number="26" style="v" sid="EZK 20:26" />ತೆನಿ ತೆಂಚ್ಯಾ ಪಯ್ಲೆಚ್ಯಾ ಪೊರಾಕ್ನಿ ಜಾಳುನ್ ಭೆಟ್ವಲ್ಲ್ಯಾ ಬಲಿಯಾಂಚ್ಯಾಕ್ನಾ ತೆಕಾ ಅಪಸ್ಪಡ್ ಕರುನ್ ಉಲ್ಲ್ಯಾ ಬುರ್ಸ್ಯಾ ಸ್ಥಿತಿಕ್ ಹಾನ್ಲೊ. <verse eid="EZK 20:26" /><verse number="27" style="v" sid="EZK 20:27" />ಅತ್ತಾ, ನರ್ ಮಾನ್ಸಾ, ಇಜ್ರಾಯೆಲಾಕ್ನಿ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೆ ಸಾಂಗ್ತಾ, ಹೆ ತೆಂಚ್ಯಾ ಪುರ್ವಜಾನಿ ಪಸ್ವುನ್ ಮಾಕಾ ಅವಿಶ್ವಾಸಿ ಹೊವ್ನ್ ಮರ್ಯಾದ್ ದಿವ್ಕ್ ನ್ಯಾಯ್. <verse eid="EZK 20:27" /><verse number="28" style="v" sid="EZK 20:28" />ಮಿಯಾ ಗೊಸ್ಟ್ ದಿಲ್ಲ್ಯಾ ದೆಸಾಕ್ ಹಾನಲ್ಯಾ ಮಾನಾ, ತೆಂಕಾ ತೆನಿ ತಿ ಮಡ್ಡಿಯಾ ಅನಿ ಹಿರ್ವಿ ಝಾಡಾ ಬಗುನ್ ತೆನಿ ಸಗ್ಳ್ಯಾನಿ ಬಲಿದಾನಾ ದಿಲ್ಯಾನಿ. ತೆನಿ ಮಾಕಾ ಬಲಿಯಾ ಭೆಟುಕ್ ಹಾನಲ್ಲ್ಯಾನಿ. ಬೊನೆ ಚಡ್ವುನ್ ಬರ್ಯಾ ವಾಸೆಚಿ ಬಲಿ ದೆವಾಕ್ ಪಾನ್ಯಾಚ್ಯಾ ರುಪಾಚಿ ಬಲಿ ಭೆಟ್ವುಲ್ಯಾನಿ. <verse eid="EZK 20:28" /><verse number="29" style="v" sid="EZK 20:29" />ಮಿಯಾ ತೆಂಕಾ ಸಾಂಗ್ಲೊ ಹೆ ಉಪ್ಪರ್ಲೆ ಜಾಗೆ ಕಾಯ್ ಹೆ? ತುಮಿ ಖಯ್ ಜಾವ್ಕ್ ಲ್ಯಾಸಿ, ತೆನಿ ತೆಂಕಾ ಪಯ್ಲೆಚಾನ್ ಉಪ್ಪರ್ಲೊ ಜಾಗೊ ಮನುನ್ ಬಲ್ವುತ್ಯಾತ್. <verse eid="EZK 20:29" /><verse number="30" style="v" sid="EZK 20:30" />ಅತ್ತಾ ಮಿಯಾ ಸರ್ವೆಸ್ಪರ್ ಕಾಯ್ ಸಾಂಗ್ತಾತೆ ಸಾಂಗ್, ತುಮಿ ಕಶ್ಯಾಕ್ ತುಮ್ಚಾ ಪುರ್ವಜಾನಿ ಕರಲ್ಲಿ ಪಾಪಾ ಕರುಲ್ಯಾಸಿ ಅನಿ ಮುರ್ತಿಯಾಂಚ್ಯಾ ಫಾಟ್ನಾ ಪಾಳಲ್ಯಾಸಿ. <verse eid="EZK 20:30" /><verse number="31" style="v" sid="EZK 20:31" />ತುಮಿ ಬಲಿ ಭೆಟ್ವುನ್, ತುಮ್ಚ್ಯಾ ಪೊರಾಕ್ನಿ ಭೆಟ್ವುನ್, ಆಜ್ ಪತರ್, ತುಮ್ಕಾ ಅಶುದ್ದ್ ಕರುನ್ ಘೆವ್ಕ್ ಲಾಗ್ಲ್ಯಾಸಿ ಕಾಯ್? ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾನೊ, ತುಮ್ಚ್ಯಾ ಅಸ್ಲ್ಯಾಕ್ನಿ ದೆವಾಚೊ ಜವಾಬ್ ದಿವ್ಕ್ ಹೊತಾ ಕಾಯ್? ಮಾಜ್ಯಾ ಜಿವಾ ವರ್‍ತಿ ಆನ್ ಘಾಲುನ್ ಸಾಂಗ್ತಾ ತುಮ್ಕಾ ದೆವಾಚೊ ಜವಾಬ್ ದಿಯ್ನಾ ಮನ್ತಲಿ ಹಿ ದೆವಾಚಿ ಗೊಸ್ಟ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 20:31" /><verse number="32" style="v" sid="EZK 20:32" />ತುಮಿ ತುಮ್ಚಿ ಮನಾ ದುಸ್ರ್ಯಾ ದೆಶಾಚಿ ಲೊಕಾ, ಗುಂಡ್ಯಾಕ್ನಿ, ಝಾಡಾಕ್ನಿ ಫುಜಾ ಕರ್ತ್ಯಾತ್ ತೆಂಚ್ಯಾ ಸಾರ್ಕೆ ಕರುನ್ ಘೆಟ್ಲ್ಯಾಸಿ, ಖರೆ ತಸಿ ಹೊಯ್ನಾ.<verse eid="EZK 20:32" /></para>
  <para style="s">ದೆವ್ ಶಿಕ್ಷ್ಯಾ ದಿತಾ ಅನಿ ಮಾಪ್ ಕರ್ತಾ</para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 20:33" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸಿ ಮನ್ತಾ, ಮಾಜ್ಯಾ ಜಿವಚ್ಯಾರ್ ಆನ್ ಘಾಲ್ತಾ. ಮಿಯಾ ಶಿಕ್ಷ್ಯಾ ದಿತಲೊ ಹಾತ್ ಉಕ್ಲುನ್, ಪಾವ್ಲ್ಯಾಚೊ ಪರಾಕ್ರಮ್ ದಾಕ್ವುನ್, ರಾಗಾಚಿ ಆಗ್ ವತುನ್ಗೆತ್ ತುಮ್ಚ್ಯಾ ವರ್‍ತಿ ಆಡಳಿತ್ ಕರ್ತಾ. <verse eid="EZK 20:33" /><verse number="34" style="v" sid="EZK 20:34" />ಹ್ಯೊ, ಮಿಯಾ ಶಿಕ್ಷ್ಯಾ ದಿತಲೊ ಹಾತ್ ಉಕ್ಲುನ್, ಪಾವ್ಲ್ಯಾಚೊ ಬಳ್ ದಾಕ್ವುನ್, ರಾಗಾಚಿ ಆಗ್ ವತುನ್ಗೆತ್, ತುಮ್ಕಾ ದೆಸಾತ್ನಾ ಸುಟ್ಕಾ ಕರುನ್, ತುಮಿ ಪಗ್ಳುನ್ ಜಾತಲ್ಯಾ ದೆಸಾತ್ನಾ ತುಮ್ಕಾ ಗೊಳಾ ಕರುನ್, <verse eid="EZK 20:34" /><verse number="35" style="v" sid="EZK 20:35" />ಮಿಯಾ ಮರುಬುಮಿಕ್ ಬಲ್ವುನ್ ಹಾನುನ್ ಥೈಚ್ ಇದ್ರಾ ಬದ್ರಾಕ್ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಇಚಾರ್ನಿ ಕರ್ತಾ. <verse eid="EZK 20:35" /><verse number="36" style="v" sid="EZK 20:36" />ಅನಿ ಮಿಯಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಮರುಭುಮಿಕ್ ತುಮ್ಚ್ಯಾ ಪುರ್ವಜಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಇಚಾರ್ನಿ ಕರಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾಬಿ ಇಚಾರ್ನಿ ಕರ್ತಾ. ಹಿ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ. <verse eid="EZK 20:36" /><verse number="37" style="v" sid="EZK 20:37" />ಮಿಯಾ ತುಮ್ಕಾ ಮೆಜ್ನಿ ಕರಲ್ಲ್ಯಾ ಸಾರ್ಕೆ, ದಾಂಡ್ಯಾಚ್ಯಾ ಖಾಲ್ತಿ ಜಾಯ್ ಸಾರ್ಕೆ ಕರುನ್ ಕರಾರಾಚ್ಯಾ ಕಟ್ಟಾನಿ ತುಮ್ಕಾ ಭಾಂದುನ್, <verse eid="EZK 20:37" /><verse number="38" style="v" sid="EZK 20:38" />ಮಾಕಾ ಪರ್‍ತುನ್ ಹೊಲ್ಲ್ಯಾ ಬುರ್ಸ್ಯಾಕ್ನಿ ತುಮ್ಚ್ಯಾಕ್ನಾ ಧಾಡುನ್ ಸೊಡ್ತಾ; ತೆನಿ ವಸ್ತಿ ಹೊತ್ತ್ಯಾ ದೆಸಾಕ್ನಾ ಮಿಯಾ ತೆಂಕಾ ಸುಟ್ಕಾ ಕರ್ಲ್ಯಾರ್ಬಿ, ತೆನಿ ಇಜ್ರಾಯೆಲ್ ದೆಸಾಕ್ ಜಾವ್ನ್ ಪಾಯ್ಚ್ ನಾತ್; ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳ್ತಾ. <verse eid="EZK 20:38" /><verse number="39" style="v" sid="EZK 20:39" />ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾನೊ, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸಿ ಮನ್ತಾ, ಜಾವಾ, ತುಮ್ಚ್ಯಾ ಮುರ್ತಿಯಾಕ್ನಿ ಫುಜ್ಯಾ ಕರಾ; ಮಾನಾ ತರ್ಬಿ ಮಾಜೆ ಬೊಲ್ನೆ ಆಯ್ಕುನುಚ್ ಆಯ್ಕತ್ಯಾಸಿ; ಹೆಚ್ಯಾ ಮಾನಾ ಮಾಜ್ಯಾ ಪರಿಶುದ್ದ್ ನಾವಾಕ್ ತುಮ್ಚ್ಯಾ ಬಲಿಯಾನಿ ಅನಿ ಮುರ್ತಿಯಾನಿ ತುಮಿ ಮಾಜ್ಯಾ ನಾವಾಚಿ ಕಿರ್ತಿ ಕಮ್ಮಿ ಹೊಯ್ ನ್ಯಾಸಿ. <verse eid="EZK 20:39" /><verse number="40" style="v" sid="EZK 20:40" />ಅಸೆ ಸರ್ವೆಸ್ಪರ್ ಹೊಲ್ಲೊ ದೆವ್ ಅಸೆ ಸಾಂಗ್ತಾ, ಗಾಂವಾತ್ನಿ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚೆ ಸಗ್ಳೆ ಮಾಜ್ಯಾ ಪವಿತ್ರ್ ಮಡ್ಡಿರ್ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಪರ್ವತಾತ್ ಮಾಕಾ ಸೆವಾ ಕರ್‍ತಾತ್, ಥೈಚ್ ತೆಂಚ್ಯಾ ಇದ್ರಾಕ್ ಯೆತಾ, ಥೈ ತುಮ್ಚಿ ಕಾನಿಕಾ ಬರಿ ಬಲಿಯಾ ತೆಕಾ ಸಮಂದ್ ಪಡಲ್ಲೆ ಸಗ್ಳೆ ಘೆತಾ. <verse eid="EZK 20:40" /><verse number="41" style="v" sid="EZK 20:41" />ಮಿಯಾ ತುಮ್ಕಾ ದೆಶಾಚ್ಯಾಕ್ನಾ ಪಾರ್ ಕರುನ್, ತುಮಿ ಪಗ್ಳುನ್ ಗೆಲ್ಲ್ಯಾ ದೆಶಾನಿತ್ನಾ, ಹಾನುನ್ ಮಿಳ್ವುತಾನಾ ತುಮ್ಚೊ ಬರ್ಯಾ ವಾಸೆಚೊ ಬಲಿಚೊ ಕಟ್ಟೊ ಸ್ವಿಕಾರ್ ಕರುನ್ ಸಗ್ಳ್ಯಾ ದೆಶಾಚ್ಯಾ ಇದ್ರಾಕ್ ಯೆತಾ, ಸಗ್ಳ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ತುಮ್ಚ್ಯಾ ರಾಕ್ವನಿಚ್ಯಾ ವಯ್ನಾ ಮಾಜಿ ಮರ್ಯಾದ್ ರಾಕುನ್ ಘೆತಾ. <verse eid="EZK 20:41" /><verse number="42" style="v" sid="EZK 20:42" />ಮಿಯಾ ಭಾಸ್ ದಿವ್ನ್ ತುಮ್ಚ್ಯಾ ಪುರ್ವಜಾಕ್ನಿ ಖಲೊ ದೆಶ್ ದಿಲೊ, ತ್ಯಾ ಇಜ್ರಾಯೆಲ್ ದೆಸಾಕ್ ತುಮ್ಕಾ ಹಾನ್ತಾನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತುಮ್ಕಾ ಕಳ್ತಾ. <verse eid="EZK 20:42" /><verse number="43" style="v" sid="EZK 20:43" />ತುಕಾ ಅಪವಿತ್ರ್ ಕರಲ್ಯಾ ತುಜ್ಯಾ ಚಲ್ನುಕಿಕ್ ತುಜ್ಯಾ ಸಗ್ಳ್ಯಾ ಕಾಮಾಕ್ನಿ ಥೈಚ್ ಯಾದೆಕ್ ಹಾನುನ್ ಘೆ, ತುಮಿ ಕರಲ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾ ವಯ್ನಾ ತುಮ್ಕಾ ಬಗುನ್ ತುಮಿಚ್ ಕಂಟಾಳ್ತ್ಯಾಸಿ, <verse eid="EZK 20:43" /><verse number="44" style="v" sid="EZK 20:44" />ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾನೊ, ತುಮ್ಚ್ಯಾ ಬುರ್ಶಾ ಚಾಲ್ನುಕಿಕ್ ಅನಿ ಬುರ್ಸ್ಯಾ ಕಾಮಾಕ್ ತಕ್ಕ್ ಮಾಜ್ಯಾ ನಾವಾಕ್ ಲಾಗುನ್ ಮಿಯಾ ತುಮ್ಕಾ ಶಿಕ್ಷ್ಯಾ ದಿನಸ್ತಾನಾ ತುಮ್ಕಾ ಸಂಬಾಳುನ್ ಘೆವ್ನ್ ರ್‍ಹಾತಾನಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳ್ತಾ, ಹೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್.<verse eid="EZK 20:44" /></para>
  <para style="s">ದಕ್ಷಿನಾತ್ ಆಗ್</para>
  <para style="p">
    <verse number="45" style="v" sid="EZK 20:45" />ಮಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಜ್ಯಾಕ್ನಾ ಬೊಲ್ಲ್ಯಾನ್, <verse eid="EZK 20:45" /><verse number="46" style="v" sid="EZK 20:46" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ತೊಂಡ್ ಕರುನ್, ತಿಕ್ಡಿನ್ ಬೊಲುನ್ಗೆತ್ ದಕ್ಷಿನ್ ದಿಕ್ಕಾತ್ ಹೊತ್ತ್ಯಾ ಗಾಂವಾತ್ಲ್ಯಾ ಮ್ಹಳ್ಯಾಚ್ಯಾ ವಿಶಯಾತ್ ತ್ಯಾ ಮ್ಹಳ್ಯಾಕ್ ಪರ್‍ವಾದನ್ ಕರುನ್ ಅಸಿ ಸಾಂಗ್. <verse eid="EZK 20:46" /><verse number="47" style="v" sid="EZK 20:47" />ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಆಯ್ಕ್; ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಆಹಾ, ಮಿಯಾ ತುಮ್ಚ್ಯಾತ್ ಆಗ್ ಲಾವ್ತಾ, ತೆ ಮಾಜ್ಯಾಕ್ಡೆ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಹಿರ್ವ್ಯಾ ಝಾಡಾಕ್ನಿ, ವಾಳ್ಕ್ಯಾ ಝಾಡಾಕ್ನಿ ಜಾಳುನ್ ಸೊಡ್ತಾ, ಜಳ್ತಲೆ ಆಗ್ ಇಜಿ ನಸ್ತಾನಾ, ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾ ಪತರ್ ಸಗ್ಳ್ಯಾಬಿ ಜಳುನ್ ಜಾತಾತ್. <verse eid="EZK 20:47" /><verse number="48" style="v" sid="EZK 20:48" />ತೆ ಲಾವಲ್ಲೊ ಸರ್ವೆಸ್ಪರ್ ಮಿಯಾಚ್ ಮನುನ್ ಸಗ್ಳ್ಯಾ ಜನಾವರಾಕ್ನಿ ಕಳ್ತಾ. ತೆ ಇಜಿನಾ. <verse eid="EZK 20:48" /><verse number="49" style="v" sid="EZK 20:49" />ತನ್ನಾ ಮಿಯಾ, ಅಯ್ಯೊ ಸರ್ವೆಸ್ಪರ್ ದೆವಾ, ತೊ ವಡ್ಪಾ ಸಾಂಗ್ನಾರೊ ನ್ಹಯ್ ಕಾಯ್? ಮನುನ್ ಹಿ ಲೊಕಾ ಮಾಜ್ಯಾ ವಿಶಯಾತ್ ಬೊಲುನ್ ಘೆತಾತ್. ಮನುನ್ ಸಾಂಗುನ್ ಘೆಟ್ಲೊ.<verse eid="EZK 20:49" /></para>
  <chapter eid="EZK 20" />
  <chapter number="21" style="c" sid="EZK 21" />
  <para style="s">ಸರ್ವೆಸ್ಪರಾಚಿ ಝಡ್ತಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 21:1" />ಸರ್ವೆಸ್ಪರಾಕ್ನಾ ಮಾಕಾ ಹಿ ಗೊಸ್ಟ್ ಯೆಲಿ, <verse eid="EZK 21:1" /><verse number="2" style="v" sid="EZK 21:2" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಜೆರುಜಲೆಮಾಚ್ಯಾ ವಿರೊದ್ ದಿಕ್ಕಾಕ್ ತೊಡ್ ಕರುನ್, ತೆಚ್ಯಾ ಪವಿತ್ರ್ ಜಾಗ್ಯಾಕ್ಡೆ ಬೊಲುನ್ಗೆತ್ ಇಜ್ರಾಯೆಲ್ ದೆಶಾಚ್ಯಾ ವರ್‍ತಿ ವಿರೊಧ್ ಕರುನ್ ಪ್ರವಾದ್ ಕರುನ್, <verse eid="EZK 21:2" /><verse number="3" style="v" sid="EZK 21:3" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಶೆ ಮನ್ತಾ, ಅಬಕ್ ಮಿಯಾ ತುಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಹಾಯ್, ಮಾಜ್ಯೊ ತಲ್ವಾರ್ ಧರುನ್ ಘೆವ್ನ್ ತಲ್ವಾರಾಚ್ಯಾ ಪೊತ್ಯಾತ್ನಾ ಬಾರ್ಯ್ ಕಾಡುನ್, ತುಜಾತ್ಲ್ಯಾ ಬರ್ಯಾ ಲೊಕಾಕ್ನಿ ಅನಿ ಬುರ್ಸ್ಯಾ ಲೊಕಾಕ್ನಿ ತೊಡುನ್ ಜಿವ್ ಕಾಡ್ತಾ. <verse eid="EZK 21:3" /><verse number="4" style="v" sid="EZK 21:4" />ಮಿಯಾ ಮಾಜ್ಯಾಕ್ಡೆ ಹೊತ್ತ್ಯಾ ಬರ್ಯಾ ಲೊಕಾಕ್ನಿ ಅನಿ ಬುರ್ಸ್ಯಾ ಲೊಕಾಕ್ನಿ ನಾಶ್ ಕರುಚೆ ಮನುನ್ ಮಾಜೊ ತಲ್ವಾರ್ ಪೊತ್ಯಾತ್ನಾ ಬಾರ್ಯ್ ಕಾಡುನ್ ಜಾವ್ನ್ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ಪತರ್ ಸಗ್ಳ್ಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಪಡ್ತಾ. <verse eid="EZK 21:4" /><verse number="5" style="v" sid="EZK 21:5" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ಹೊಲ್ಲೊ ಮಿಯಾಚ್ ಮಾಜೊ ತಲ್ವಾರ್ ಪೊತ್ಯಾತ್ನಾ ಬಾರ್ಯ್ ಕಾಡ್ಲಾ ಮನ್ತಲೆ ಸಗ್ಳ್ಯಾ ಮಾನ್ಸಾಕ್ನಿ ಕಳ್ತಾ; ತೆ ಪರ್‍ತುನ್ ಪೊತ್ಯಾಚ್ಯಾ ಭುತ್ತುರ್ ಜಾಯ್ನಾ. <verse eid="EZK 21:5" /><verse number="6" style="v" sid="EZK 21:6" />ಎ, ನರ್ ಮಾನ್ಸಾ, ಮಾಗುನ್ ಘೆ, ಕಂಬರ್ ಮೊಡಲ್ಲ್ಯಾ ತವ್ಡ್ಯಾ ದುಕ್ಕೆನ್ ಲೊಕಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಲೊಳ್. <verse eid="EZK 21:6" /><verse number="7" style="v" sid="EZK 21:7" />ತನ್ನಾ ಕಶ್ಯಾಕ್ ಲೊಳುಲೈ? ಮನುನ್ ತುಕಾ ತೆನಿ ಇಚಾರ್ತಾತ್, ತನ್ನಾ ತಿಯಾ ತೆಂಕಾ, ಬುರ್ಸ್ಯಾ ಖಬ್ರಿಚ್ಯಾ ವಿಶಯಾತ್ ಲೊಳ್ತಾ. ಅಬಕ್ ಸಂಕಟ್ ಯೆಲೊ, ಸಗ್ಳ್ಯಾಂಚೊ ಮನ್ ಕರ್ಗುನ್ ಪಾನಿ ಹೊತಾ, ಸಗ್ಳ್ಯಾಚಿ ಹಾತಾ ಲೊಂಬಾತ್ ಪಡ್ತಾತ್, ಸಗ್ಳ್ಯಾಂಚೊ ಮನ್ ದುಕ್ತಾ, ಸಗ್ಳ್ಯಾಂಚಿ ಡಿಂಬಿಯಾ ಬಳ್ ನಸ್ತಾನಾ ಖಾಪ್ತಾತ್, ಅಬಕ್ ಯೆಲೆ ಎವ್ನ್ ಪಾವ್ಲೆ! ಹೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್ ಮನುನ್ ಜವಾಬ್ ದಿ. <verse eid="EZK 21:7" /><verse number="8" style="v" sid="EZK 21:8" />ಸರ್ವೆಸ್ಪರಾಚಿ ಖಬರ್ ಮಾಕಾ ದಿಲಾ, <verse eid="EZK 21:8" /><verse number="9" style="v" sid="EZK 21:9" />ಎ, ನರ್ ಮಾನ್ಸಾ, ಸರ್ವೆಸ್ಪರ್ ಅಸಿ ಮನ್ತಾ, ಮನುನ್ ಅಸೆ ಸಾಂಗ್,<verse eid="EZK 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 21:10" />ತಲ್ವಾರ್ ಕಟ್ವುನ್, ಪಾಜ್ವುನ್,</para>
  <para style="q2" vid="EZK 21:10">ಮಿಚ್ಚಿ ಸಾರ್ಕೆ ಗಾಸಲ್ಲೆ ಹಾಯ್. ಮಿಂಚಾನ್,</para>
  <para style="q2" vid="EZK 21:10">ಉಮ್ಮೆದ್ ಕರುಕ್ ಹೊತಾ ಕಾಯ್ ಅಮ್ಚ್ಯಾ ಕುಮಾರಾಚೊ ರಾಜ್ ದಾಂಡೊ ಮನುನ್?</para>
  <para style="q2" vid="EZK 21:10">ಹುರಲ್ಯಾ ಸಗ್ಳ್ಯಾ ದಾಂಡೆ ಸಗ್ಳೆ ಸೊಡುನ್ ಸೊಡ್ತಲೊ ದಾಂಡೊ ಮನುನ್?<verse eid="EZK 21:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="EZK 21:11" />ತಲ್ವಾರ್ ಹಾತಿಕ್ ಗಾವ್ಚೆ ಮನುನ್ ಗಾಸುನ್ ತಯಾರ್ ಹೊವ್ನ್ ಹಾಯ್,</para>
  <para style="q2" vid="EZK 21:11">ಘಾತಕ್ ಕರ್‍ತಲ್ಯಾಚ್ಯಾ ಹಾತಿಕ್ ಇಡ್ ಹೊತಾ ತಸೆ ಕಟ್ವನ್ ಮಿಚ್ಚಿ ಸಾರ್ಕೆ ಹಾಯ್.<verse eid="EZK 21:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="EZK 21:12" />ಎ, ನರ್ ಮಾನ್ಸಾ, ಕುಕ್ ಮಾರ್,</para>
  <para style="q2" vid="EZK 21:12">ಗೊಳಾಟ್ ಕರ್, ಹಿಡ್ದೆ ಬಡ್ವುನ್ಗೆ!</para>
  <para style="q1" vid="EZK 21:12">ತೊ ತಲ್ವಾರ್ ಮಾಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ರಾಜಾಚ್ಯಾ ವರ್‍ತಿ ಮುಂಖಡಾ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ತೆಜ್ಯಾ ತೊಂಡಾಕ್ ಗಾವ್ತಾತ್.<verse eid="EZK 21:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="EZK 21:13" />ಸರ್ವೆಸ್ಪರ್ ಅಶೆ ಮನ್ತಾ, ಚವ್ಕಸಿ ಚಲಿತ್ ಹಾಯ್,</para>
  <para style="q1" vid="EZK 21:13">ತಿರಸ್ಕಾರ್ ಕರುಲಾಗಲ್ಲೊ ರಾಜಾಚೊ ದಾಂಡೊ ನಾಶ್ ಹೊಲ್ಯಾರ್ ಗತ್ ಕಾಯ್?<verse eid="EZK 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 21:14" />ನರ್ ಮಾನ್ಸಾ, ದೆವಾಚೆ ಉತ್ತರ್ ಕರ್, ಥಾಪ್ಟಿಯಾ ಮಾರ್, ತಲ್ವಾರ್ ದೊನ್ ಪಟ್ಟ್ ಅನಿ ತಿನ್ ಪಟ್ಟ್ ಜಿವ್ ಕಾಡುಂದಿತ್. ಲೊಕಾಕ್ನಿ ನಾಶ್ ಕರ್ತಲೊ ತಲ್ವಾರ್ ಅಧಿಕಾರಿಯಾಂಚ್ಯಾ ಭೊತ್ಯಾನಿ ತೊಡುನ್ ನಾಶ್ ಕರ್ತಲೊ ತಲ್ವಾರ್. <verse eid="EZK 21:14" /><verse number="15" style="v" sid="EZK 21:15" />ತೆಂಚಿ ಮನಾ ಪಾನಿ ಹೊವ್ನ್ ಲೈ ಲೊಕಾ ಅಡ್ಕಳುನ್ ಪಡಿ ಸಾರ್ಕೆ ನಾಶ್ ಕರ್‍ತಲ್ಯಾ ತಲ್ವಾರಾಕ್ ತೆಂಚ್ಯಾ ಗಾಂವಾಚ್ಯಾ ದಾರಾಕ್ನಿ ಹಾನ್ಲಾ, ಮಿಂಚಾಚ್ಯಾ ಸಾರ್ಕೆ ಮಿಂಚುಲಾ ಅನಿ ಜಿವ್ ಕಾಡುಕ್ ಮನುನ್ ತಲ್ವಾರಾಚ್ಯಾ ಸಾರ್ಕೆ ತಯಾರ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 21:15" /><verse number="16" style="v" sid="EZK 21:16" />ತಲ್ವಾರಾ, ನಿಟ್ಟ್ ಜಾ ಉಜ್ವ್ಯಾಕ್ ತಯಾರ್ ಹೊವ್ನ್ ಡಾವ್ಯಾಕ್ ಜಾ ತುಜೆ ತೊಂಡ್ ಹೊತ್ತ್ಯಾಕ್ಡೆ ಜಾ. <verse eid="EZK 21:16" /><verse number="17" style="v" sid="EZK 21:17" />ಥಾಪ್ಟಿಯಾ ಮಾರುನ್ ಮಾಜೊ ರಾಗ್ ಥಂಡ್ ಕರುನ್ ಘೆತಾ, ಹೆ ಸರ್ವೆಸ್ಪರ್ ಹೊಲ್ಲ್ಯಾ ಮಾಜಿ ಗೊಸ್ಟ್.<verse eid="EZK 21:17" /></para>
  <para style="s">ಬಾಬಿಲೊನಾಚೊ ರಾಜಾ</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 21:18" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಅನಿ ಎಕ್ ಗೊಸ್ಟ್ ದಿಲ್ಯಾನ್, ನರ್ ಮಾನ್ಸಾ, <verse eid="EZK 21:18" /><verse number="19" style="v" sid="EZK 21:19" />ಬಾಬಿಲೊನಾಚ್ಯಾ ರಾಜಾಚೊ ತಲ್ವಾರ್ ಯೆವ್ಕ್ ದೊನ್ ವಾಟ್ ಹೊತ್ತೊ ನಕಾಸೊ ಕಾಡ್; ತಿ ದೊನ್ ವಾಟಾ ಎಕುಚ್ ದೆಸಾಕ್ನಾ ಗೆಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ರಾಂವ್ದಿತ್, ಅನಿ ಎಕೆಕ್ ಶಾರಾಕ್ ಜಾತಲ್ಯಾ ವಾಟೆಚ್ಯಾ ಝಾಡಾಕ್ ವಳಕ್ ಚಿತ್ರ್ ಕಾಡ್. <verse eid="EZK 21:19" /><verse number="20" style="v" sid="EZK 21:20" />ಅಮ್ಮೊನಾಚ್ಯಾ ರಬ್ಬಾ ಮನ್ತಲ್ಯಾ ಶಾರಾಕ್ಬಿ ಅನಿ ಭೊತ್ಯಾನಿ ಭಿತ್ತ್ ಅಸಲ್ಲ್ಯಾ ಜುದೆಯಾಂಚ್ಯಾ ಖಿಲ್ಲೊ ಹೊತ್ತ್ಯಾ ಜರುಜಲೆಮಾಕ್ ತಲ್ವಾರ್ ಯೆವ್ಕ್ ವಾಟಾ ಕರ್. <verse eid="EZK 21:20" /><verse number="21" style="v" sid="EZK 21:21" />ವಾಟ್ ಫಾಟೆ ಹೊತಲ್ಯಾ ಜಾಗ್ಯಾರ್ ದೊನ್ ವಾಟೆಚ್ಯಾ ಆರಂಬಾತ್ ಬಾಬಿಲೊನಾಚ್ಯಾ ರಾಜಾ ಶಕ್ನಾ ಬಗುಕ್ ಮನುನ್ ಇಬೆ ಹಾಯ್, ಬಾನಾಕ್ನಿ ಹಾಲ್ವುನ್, ಮುರ್ತಿಯಾಕ್ನಿ ಪರಶ್ನೆ ಇಚಾರುನ್, ಕಾಳಿಂಜಾಚಿ ಪರಿಕ್ಷಾ ಕರ್ಲಾ, <verse eid="EZK 21:21" /><verse number="22" style="v" sid="EZK 21:22" />ಜರುಜಲೆಮ್ ವಳ್ಕಿಚೊ ಬಾನ್ ತೆಚ್ಯಾ ಉಜ್ವ್ಯಾ ಹಾತಿತ್ ಗಾವ್ಲಾ; ಥೈ ತೊ ಭಿತ್ತ್ ಫೊಡ್ತಲಿ ಹಾತಿಯಾರಾ ಪಿಡ್ಲ್ಯಾ ದಾರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆ ಕರುನ್, ತೊಂಡ್ ಉಗ್ಡುನ್ ನಾಶ್ ಕರ್‍ತಲ್ಯಾಚಿ ಧನ್ ಕರುನ್, ದಿಬ್ಬ್ ಗಾಲುನ್ ಒಡ್ಡ್ ಭಾಂದುಚೆ ಮನುನ್ ಸುಚ್ನಾ ತೆಚೆಕ್ನಾ ಯೆಲೆ, <verse eid="EZK 21:22" /><verse number="23" style="v" sid="EZK 21:23" />ಹೊಲ್ಯಾರ್ ತ್ಯಾ ಗಾಂವಾತ್ಲಿ ಲೊಕಾ ತೆನಿ ತ್ಯಾ ರಾಜಾಕ್ನಾ. ಪಯ್ಲೆಚ್ಯಾನ್ ಅಮಿ ತ್ಯಾ ರಾಜಾಕ್ನಾ ಕರುನ್ ಘೆಟಲ್ಯಾ ಆನಾತ್ನಿ ಭರೊಸೊ ಥವ್ನ್, ಹೆ ಶಕ್ನಾ ಝುಟೆ ಮನುನ್ ಕಳ್ವುನ್ ಘೆಟ್ಲ್ಯಾತ್, ಖರೆ ತೆನಿ ತೆಚಿ ಬುರ್ಶಿ ಕಾಮಾ ಸಗ್ಳ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಹಾನ್ತ್ಯಾತ್. ತೆನಿ ತೆಚ್ಯಾ ಹಾತಿತ್ ಗಾವುನ್ ಪಡ್ತಾ. <verse eid="EZK 21:23" /><verse number="24" style="v" sid="EZK 21:24" />ಅಸಿ ರ್‍ಹಾತಾನಾ, ಸರ್ವೆಸ್ಪರ್ ಅಸೆ ಮನ್ತಾ, ತುಮ್ಚಿ ಚುಕಾ ಉಜ್ಡೊಡಾಕ್ ಎವ್ನ್, ತಮ್ಚಿ ಪಾಪಾ ತುಮ್ಚ್ಯಾ ಕಾಮಾಕ್ನಿ ಪ್ರತ್ಯೆಕ್ ಹೊವ್ನ್, ತುಮಿ ತುಮ್ಚಿ ಬುರ್ಶಿ ಕಾಮಾ ಮಾಜ್ಯಾ ಯಾದೆಕ್ ಹಾನ್ಲ್ಯಾಸಿ, ತೆಚ್ಯಾ ಸಾಟ್ನಿ ವಿರೊಧಿಯಾಂಚ್ಯಾ ಹಾತಿಕ್ ಗಾವುನ್ ಪಡ್ತ್ಯಾಸಿ. <verse eid="EZK 21:24" /><verse number="25" style="v" sid="EZK 21:25" />ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ರಾಜಾ, ಬುರ್ಸೊ, ಬ್ರಸ್ಟ್, ತುಕಾ ಎಳ್ ಜಗ್ಗೊಳ್ ಯೆಲಾ, ಹೆಚ್ ತುಜೆ ಆಕ್ರಿಚ್ಯಾ ಶಿಕ್ಷಾಚೊ ಎಳ್. <verse eid="EZK 21:25" /><verse number="26" style="v" sid="EZK 21:26" />ಸರ್ವೆಸ್ಪರ್ ಅಶೆ ಮನ್ತಾ, ತುಜೊ ಟಕ್ಲ್ಯಾಚೊ ಪವ್ಡ್ ಕಾಡ್! ಮುಕುಟ್ ಕಾಡ್! ಸಗ್ಳೆಬಿ ಅದ್ದಿ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆ ರ್‍ಹಾಯ್ನಾ, ಖಾಲ್ತಿ ಹೊತ್ತೆ ವರ್‍ತಿ ಮಿಳ್ವುನ್ ಹೊತಾ, ವರ್‍ತಿ ಹೊತ್ತೆ ಖಾಲ್ತಿ ಉತ್ರುಸುನ್ ಹೊತಾ. <verse eid="EZK 21:26" /><verse number="27" style="v" sid="EZK 21:27" />ಮಿಯಾ ಪಾಡ್, ಪಾಡ್! ಮಿಯಾ ಹ್ಯಾ ಶಾರಾಕ್ ಪಾಡ್ ಕರ್ತಾ, ಲೊಟುನ್ ಘಾಲ್ತಾ, ದೆಸಾಕ್ ವಾರಿಸ್ದಾರ್ ಹೊತ್ತೊ ಯೆವ್ಚ್ಯಾ ಅದ್ದಿ ಎಕ್ಬಿ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆ ರ್‍ಹಾಯ್ನಾ, ತನ್ನಾ ತೆಕಾ ರಾಜ್ಯ್ ದಿತಾ.<verse eid="EZK 21:27" /></para>
  <para style="s">ಅಮ್ಮೊನಿಯಾ ಅನಿ ತಲ್ವಾರ್</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 21:28" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ದೆವಾಚಿ ಇಚ್ಚ್ಯಾ ಪರ್ಗಟ್ ಕರುನ್ಗೆತ್ ಅಸಿ ಸಾಂಗ್, ಅಮ್ಮೆನಿಯಾಚ್ಯಾ ವಿಶಯಾತ್ಬಿ ಅನಿ ತೆನಿ ಕರ್‍ತಲ್ಯಾ ವಿಶಯಾತ್ಬಿ ತೆನಿ ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಸಾಂಗ್ತಾ ಆಹಾ ತಲ್ವಾರ್ ಜಿವ್ ಕಾಡಿ ಸಾರ್ಕೆ ಅನಿ, ಹೊಳ್ದಿ ಸಾರ್ಕೆ ಗಾಸುನ್ ಧಾರ್ ಹೊಲಾ. <verse eid="EZK 21:28" /><verse number="29" style="v" sid="EZK 21:29" />ಅಮ್ಮೊನ್, ತುಮ್ಚಿ ಪ್ರವಾದಿಯಾ ಮನುನ್ ಸಾಂಗುನ್ಗೆತಲಿ ತುಮ್ಚಿ ಲೊಕಾ ದರ್ಶನ್ ಬಗಟ್ಲಾಂವ್, ಮನುನ್ ಝುಟಿ ಶಕ್ನಾ ಸಾಂಗ್ತಾತ್, ಎಳ್ ಜಗ್ಗೊಳ್ ಎವ್ನ್, ಚುಕೆಚೊ ಆಕ್ರಿಚೊ ಎಳ್ ಎವ್ನ್ ಪಾವ್ಲಾ. ಮರುನ್ ಪಡಲ್ಯಾಂಚೆ ಬುರ್ಸ್ಯಾಂಚಿ ಗತ್ ಬಗ್! ಭವಿಶ್ ಸಾಂಗ್ತಲ್ಯಾ ವರ್‍ತಿ ವಿಶ್ವಾಸ್ ಕರಲ್ಲೊ ತಿಯಾ ತ್ಯಾ ಬುರ್ಸ್ಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಪಡ್ತೆ. <verse eid="EZK 21:29" /><verse number="30" style="v" sid="EZK 21:30" />ತಲ್ವಾರಾಕ್ ಬಾಜುಕ್ ಲಾವ್, ತುಜ್ಯಾ ಉಪಾಜಲ್ಲ್ಯಾ ಜಾಗ್ಯಾರ್, ಅನಿ ತುಕಾ ರಚಲ್ಲ್ಯಾ ಜಾಗ್ಯಾರ್ ತುಕಾ ನ್ಯಾಯ್ ಕರ್ತಾ. <verse eid="EZK 21:30" /><verse number="31" style="v" sid="EZK 21:31" />ತುಜ್ಯಾ ವರ್‍ತಿ ಮಾಜೊ ರಾಗ್ ಘಾಲುನ್, ರಾಗಾಚಿ ಆಗ್ ಫುಕುನ್ ದಯಾ ನತ್ತ್ಯಾಕ್ನಿಹಾಳ್ ಕರ್‍ತಲ್ಯಾತ್ ಘಟ್ ಮುಟ್ಟ್ ಹೊತ್ತ್ಯಾಂಚ್ಯಾ ಹಾತಿತ್ ಸಿಗಾ ಘಾಲ್ತಾ. <verse eid="EZK 21:31" /><verse number="32" style="v" sid="EZK 21:32" />ತಿಯಾ ಆಗಿಕ್ ಜಳುನ್ ಜಾತಯ್, ತುಜೆ ರಗಾತ್ ದೆಸಾತ್ ಸಗ್ಳೆ ಆಟಲ್ಲೆ ರ್‍ಹಾತಾ. ತಿಯಾ ಕನ್ನಾಬಿ ಯಾದೆಕ್ ಯೆಯ್ನ್ ನ್ಹಯ್, ಸರ್ವೆಸ್ಪರ್ ಮಿಯಾಚ್ ಹೆ ಸಾಂಗ್ಲಾ.<verse eid="EZK 21:32" /></para>
  <chapter eid="EZK 21" />
  <chapter number="22" style="c" sid="EZK 22" />
  <para style="s">ಜರುಜಲೆಮಾಚಿ ಮೊಟ್ಟಿ ಪಾಪಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 22:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಪರ್‍ತುನ್ ಮಾಜ್ಯಾಕ್ಡೆ ಬೊಲುನ್, <verse eid="EZK 22:1" /><verse number="2" style="v" sid="EZK 22:2" />ನರ್ ಮಾನ್ಸಾ, ರಗ್ತಾನ್ ಭರಲ್ಲ್ಯಾ ತ್ಯಾ ಶಾರಾಕ್ ಝಡ್ತಿ ಕರುಕ್ ತುಜೊ ಮನ್ ತಯಾರ್ ಹಾಯ್ ಕಾಯ್? ತೆಂಚಿ ಬುರ್ಶಿ ಕಾಮಾ ತೆಂಕಾ ಅಸಿ ಸಾಂಗ್. <verse eid="EZK 22:2" /><verse number="3" style="v" sid="EZK 22:3" />ಸರ್ವೆಸ್ಪರ್ ಅಸೆ ಮನ್ತಾ, ತುಜ್ಯಾ ಮದ್ದಿ ರಗಾತ್ ಪಾಡ್ವುನ್ ಶಿಕ್ಷಾಚೊ ಎಳ್ ಜಗ್ಗೊಳ್ ಹಾನುನ್ ಘೆಟಲ್ಲ್ಯಾ ಶಾರಾ! ತುಜ್ಯಾ ಬುರ್ಸ್ಯಾ ಪಾನಾಕ್ ಸಾಟ್ನಿ ಮುರ್ತಿಯಾ ಕರುನ್ ಘೆವ್ನ್ ತುಕಾ ಪೊಜ್ಡೆ ಕರುನ್ ಘೆಟಲ್ಲ್ಯಾ ಶಾರಾ! <verse eid="EZK 22:3" /><verse number="4" style="v" sid="EZK 22:4" />ತಿಯಾ ಪಾಡ್ವುಲ್ಯಾ ರಗ್ತಾ ವಯ್ನಾ ಅನಿ ಚುಕಿದಾರಾನ್ ಕರುನ್ ಘೆಟಲ್ಲ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾ ವಯ್ನಾ ಅಶುದ್ದ್ ಹೊವ್ನ್ ಶಿಕ್ಷಾಚೊ ಎಳ್ ಜಗ್ಗೊಳ್ ಹಾನುನ್ ಘೆವ್ನ್, ಮಾರಾಚ್ಯಾ ಎಳಾಕ್ ಜಗ್ಗೊಳ್ ಎಲೆ, ತಸೆ ಹೊವ್ನ್ ತುಕಾ ಲೊಕಾಂಚ್ಯಾ ನಿಂದ್ಯಾಕ್ ಅನಿ ಸಗ್ಳ್ಯಾ ದೆಶಾಂಚ್ಯಾ ಹೆಸ್ಡುಕ್ ಗುರಿ ಕರ್ಲಾ. <verse eid="EZK 22:4" /><verse number="5" style="v" sid="EZK 22:5" />ಅಶುದ್ದ್ ಅನಿ ಹೊಲಿ ಹೊಲ್ಲ್ಯಾ ಶಾರಾ, ಜಗ್ಗೊಳ್ಲಿ ಅನಿ ಧುರ್ಲಿ ಲೊಕಾ ತುಕಾ ಹೆಸ್ಡತಾತ್. <verse eid="EZK 22:5" /><verse number="6" style="v" sid="EZK 22:6" />ಅಬಕ್, ಇಜ್ರಾಯೆಲಾಚಿ ಮುಖಂಡಾನೊ, ತೆಂಚ್ಯಾ ತಾಕ್ತಿ ಸಾರ್ಕೆ ತುಜೆರ್ ರಗಾತ್ ಟಾಕುನ್ಗೆತ್ ಹಾತ್, <verse eid="EZK 22:6" /><verse number="7" style="v" sid="EZK 22:7" />ತುಜ್ಯಾ ಬಾಯ್ ಬಾಬಾಕ್ನಿ ಮಾನ್ ದಿವ್ಕ್ ನಾತ್, ತುಜ್ಯಾ ಲೊಕಾನಿ ದುಸ್ರ್ಯಾ ದೆಸಾಕ್ನಿ ತರಾಸ್ ದಿಲಾತ್, ತುಜಾ ಲೊಕಾನಿ ಪರ್ದೆಶಿಕ್ನಿ ಅನಿ ಘವ್ಮರಲ್ಲ್ಯಾ ಬಾಯ್ಕೊ ಮನ್ಸಿಯಾಕ್ನಿ ತರಾಸ್ ದಿಲ್ಯಾತ್, <verse eid="EZK 22:7" /><verse number="8" style="v" sid="EZK 22:8" />ತಿಯಾ ತುಜ್ಯಾ ಪವಿತ್ರ್ ವಸ್ತಾಕ್ನಿ ದ್ಯಾನ್ ದಿಯ್ನಸ್ತಾನಾ, ಮಿಯಾ ನೆಮಲ್ಲ್ಯಾ ಸಬ್ಬತಾಚ್ಯಾ ದಿಸಾಕ್ ಬ್ರಸ್ಟ್ ಕರ್ಲೆ. <verse eid="EZK 22:8" /><verse number="9" style="v" sid="EZK 22:9" />ತುಜ್ಯಾಕ್ಡೆ ಚಾಡಿ ಬೊಲ್ತಲ್ಯಾನಿ ರಗಾತ್ ಪಾಡ್ವುಲ್ಯಾನಿ, ತುಜಾ ಲೊಕಾನಿ ಮಡ್ಡಿ ವರ್‍ತಿ ಬಲಿ ಭೆಟ್ವುನ್ ಹುರಲ್ಲೆ ಖಾಲ್ಯಾನಾತ್, ಅನಿ ತುಜ್ಯಾ ಮದ್ದಿ ಬುರ್ಶಿ ಕಾಮಾ ಕರ್‍ಲ್ಯಾನಾತ್, <verse eid="EZK 22:9" /><verse number="10" style="v" sid="EZK 22:10" />ತುಜ್ಯಾಕ್ಡೆ ಬಾಬಾಕ್ ಮರ್ಯಾದ್ ಕಾಡ್ಲಾತ್, ತುಜ್ಯಾಕ್ಡೆ ಭಾಯ್ರ್ ಹೊಲ್ಲ್ಯಾ ಬಾಯ್ಕೊ ಮಾನ್ಸಿಕ್ನಾ ಮಿಳ್ಳಾತ್, <verse eid="EZK 22:10" /><verse number="11" style="v" sid="EZK 22:11" />ತುಜ್ಯಾತ್ ಎಕ್ಲ್ಯಾನ್ ಭಾಜುಕ್ಲ್ಯಾಚ್ಯಾ ಬಾಯ್ಕೊಚ್ಯಾ ವರ್‍ತಿ ಬುರ್ಸೆ ಕರ್ಲ್ಯಾನಾಯ್, ಅನಿ ಎಕ್ಲ್ಯಾನ್ ಹಾಳ್ ಬುರ್ಸೆ ಕಾಮ್ ಕರುನ್ ಸುನ್ನೆಕ್ ಹಾಳ್ ಕರ್ಲಾ, ಅನಿ ಅಪ್ನಾಚ್ಯಾ ಖಾಸ್ ಭೆನಿಕ್ ಹಾಳ್ ಕರ್ಲ್ಯಾನಾಯ್. <verse eid="EZK 22:11" /><verse number="12" style="v" sid="EZK 22:12" />ತುಜ್ಯಾ ಲೊಕಾನಿ ರಗಾತ್ ಪಾಡ್ವುಕ್ ಲಂಚ್ ಘೆಟ್ಲಾತ್, ತುಜ್ಯಾ ಲೊಕಾನಿ ರಿನ್ ದಿವ್ನ್ ಫಾಯ್ದ್ಯಾ ಸಾಟ್ನಿ ಬಡ್ಡಿಕ್ ಘೆವ್ನ್, ಲಾಬಾಕ್ ಪಯ್ಸೆ ಘೆವ್ನ್, ಅಜು ಭಾಜುಚಾಕ್ನಿ ತರಾಸ್ ದಿವ್ನ್, ಖಬ್ಜಾ ಕರುನ್ ಘೆವ್ನ್ ಅನಿ ಮಾಕಾ ಇಸ್ರುನ್ ಸೊಡ್ಲ್ಯಾನಿ, ಮನುನ್ ಸರ್ವೆಸ್ಪರ್ ಸಾಂಗ್ತಾ. <verse eid="EZK 22:12" /><verse number="13" style="v" sid="EZK 22:13" />“ತಿಯಾ ಕಾಡುನ್ ಹಾನಲ್ಲೆ ಫಾಯ್ದ್ಯಾಚೆ, ತುಜ್ಯಾಕ್ಡೆ ವೊತಲ್ಲೆ ರಗಾತ್ ಮಿಯಾ ಬಗುನ್ ಹಾತ್ ಬಡ್ವುನ್ ಘೆಟ್ಲೊ. <verse eid="EZK 22:13" /><verse number="14" style="v" sid="EZK 22:14" />ಮಿಯಾ ತುಕಾ ಶಿಕ್ಷ್ಯಾ ದಿತಲ್ಯಾ ಎಳಾರ್ ಮನ್ ಘಟ್ ಕರುನ್ ಘೆಟ್ಲೆ ಕಾಯ್? ಹಾತಾ ಬಳಾನ್ ಥವ್ನ್ ಘೆವ್ನ್ ಹಾಸ್ ಕಾಯ್? ಸರ್ವೆಸ್ಪರ್ ಹೊಲ್ಲೊ ಮಿಯಾಚ್ ಹೆ ಸಾಂಗುಕ್ ಲಾಗ್ಲಾ ಅನಿ ತಸಿಚ್ ಕರ್ತಾ. <verse eid="EZK 22:14" /><verse number="15" style="v" sid="EZK 22:15" />ಮಿಯಾ ತುಕಾ ಲೊಕಾತ್ನಿ ಪಗ್ಳುನ್, ದೆಶಾ ದೆಸಾತ್ನಿ ಪಗ್ಳುನ್, ತುಜಾತ್ಲೆ ಬುರ್ಸೆಪಾನ್ ಕಾಡುನ್ ನಾಶ್ ಕರ್ತಾ. <verse eid="EZK 22:15" /><verse number="16" style="v" sid="EZK 22:16" />ಲೊಕಾಂಚ್ಯಾ ಡೊಳ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ತುಜ್ಯಾ ಯೆವ್ಡ್ಯಾಕ್ ತಿಯಾಚ್ ಮರ್ಯಾದ್ ಕಾಡುನ್ಗೆತೆ, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ತುಕಾ ಕಳ್ತಾ”.<verse eid="EZK 22:16" /></para>
  <para style="s">ದೆವಾಚಿ ನಿತಳ್ ಕರ್ತಲಿ ಭಟ್ಟಿ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 22:17" />ಮಾನಾ ಮಾಕಾ ಸರ್ವೆಸ್ಪರಾನ್ ಅಸೆ ಸಾಂಗ್ಲ್ಯಾನ್, <verse eid="EZK 22:17" /><verse number="18" style="v" sid="EZK 22:18" />ನರ್ ಮಾನ್ಸಾ, ಇಜ್ರಾಯೆಲ್ ಮನ್ತಲ್ಯಾ ಕುಳಿಚೆ ಲೊಂಗಾಟ್ ಮಾಜ್ಯಾ ನದ್ರೆತ್ ಹಾಳ್ ಹೊಲಾ, ತೆ ಸಗ್ಳೆ ತಾಂಬೆ, ಪಿತ್ಳಿ, ಲೊಂಗಾಟ್, ಸಿಸ್ ಅನಿ ಪಾತೊಳ್ ಚಾಂದಿಚ್ಯಾ ಬಾಶೆನ್ ಹಾತ್. <verse eid="EZK 22:18" /><verse number="19" style="v" sid="EZK 22:19" />ಅಸೆ ಹೊವ್ನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ತುಮಿ ಸಗ್ಳೆ ಕಚ್ರೊ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ಅಬಕ್ ತುಮ್ಕಾ ಜರುಜಲೆಮಾತ್ ಮಿಳ್ವುತಾ. <verse eid="EZK 22:19" /><verse number="20" style="v" sid="EZK 22:20" />ಚಾಂದಿ, ತಾಂಬೆ, ಲೊಂಗಾಟ್, ಸಿಸ್ ಅನಿ ಪಿತ್ಳಿ ಹೆಂಕಾ ಭಟ್ಟಿತ್ ಘಾಲುನ್, ತಾಪ್ವುನ್ ಜಾಳ್ವುಲ್ಯಾ ಸಾರ್ಕೆ, ಮಿಯಾ ತುಮ್ಕಾ ಮಾಜ್ಯಾ ಮೊಟ್ಟ್ಯಾ ರಾಗಾನ್ ಜಾಳ್ವುನ್ ಕರ್ಗುಕ್ ಲಾವ್ತಾ. <verse eid="EZK 22:20" /><verse number="21" style="v" sid="EZK 22:21" />ಹೊಯ್ ಮಿಯಾ ತುಮ್ಕಾ ಮಾಜ್ಯಾ ಪೆಟ್ತಲ್ಯಾ ರಾಗಾಚ್ಯಾ ಭಟ್ಟಿತ್ ಘಾಲುನ್ ಸಿಜ್ವುನ್, ತ್ಯಾತುರ್ ಕರ್ಗುಕ್ ಲಾವ್ತಾ. <verse eid="EZK 22:21" /><verse number="22" style="v" sid="EZK 22:22" />ಚಾಂದಿ, ಭಟ್ಟಿತ್ ಕರಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತುಮಿ ಮಾಜ್ಯಾ ರಾಗಾಚ್ಯಾ ಭಟ್ಟಿತ್ ಕರಗ್ತ್ಯಾಸಿ, ತುಮ್ಚ್ಯಾ ವರ್‍ತಿ ರಾಗಾಚಿ ಆಗ್ ಘಾಟಲ್ಲೊ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ತುಮ್ಕಾ ಕಳ್ತಾ.<verse eid="EZK 22:22" /></para>
  <para style="s">ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಮುಖಂಡಾಂಚಿ ಪಾಪಾ</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 22:23" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಅಸೆ ಸಾಂಗ್ಲ್ಯಾನ್, <verse eid="EZK 22:23" /><verse number="24" style="v" sid="EZK 22:24" />ನರ್ ಮಾನ್ಸಾ, ತ್ಯಾ ದೆಶಾಚಾಕ್ನಿ ಅಸೆ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ರಾಗಾಚ್ಯಾ ದಿಸಿ ತಿಯಾ ನಿತಳ್ ನಸಲ್ಲೊ ದೆಶ್ ಅನಿ ಪಾವ್ಸ್ ನಸಲ್ಲೊ ದೆಶ್, <verse eid="EZK 22:24" /><verse number="25" style="v" sid="EZK 22:25" />ತ್ಯಾ ದೆಸಾತ್ ಪ್ರವಾದಿಯಾನಿ ಭುತ್ತುರ್ನಾ ಬೊಲುನ್ ಘೆವ್ನ್, ಶಿಕಾರ್ ಕರುನ್ ಪಿಂಜ್ತಲ್ಯಾ ಸಿಂವಾ ಸಾರ್ಕೆ ಹೊಲ್ಯಾತ್, ಮಾನ್ಸಾಕ್ನಿ ಗಿಳ್ತಾತ್, ಆಸ್ತಿ ಅನಿ ಕಿಮ್ತಿಚಿ ವಸ್ತಾ ಲುಟ್ಲಾತ್, ದೆಸಾತ್ ಲೈ ಲೊಕಾಕ್ನಿ ವಿಧವ್ ಕರ್ಲಾತ್. <verse eid="EZK 22:25" /><verse number="26" style="v" sid="EZK 22:26" />ಥೈ ಹೊತ್ತ್ಯಾ ಯಾಜಕಾನಿ ಮಾಜಿ ನಿಯಮಾ ಮೊಡ್ಲಾತ್, ಮಾಜ್ಯಾ ನಿತಳ್ ಸಾಮಾನಾಕ್ನಿ ಅಶುದ್ದ್ ಕರ್‍ಲ್ಯಾನಾತ್, ಎಚುನ್ ಥವಲ್ಲ್ಯಾಕ್ ಅನಿ ಎಚುನ್ ಥವ್ಕ್ ನಸಲ್ಲ್ಯಾಕ್ ಕಾಯ್ಬಿ ವ್ಯತ್ಯಾಸ್ ಥವ್ಕ್ ನಾತ್, ತೆಚ್ಯಾ ಸಾಟ್ನಿ ನಿತಳ್ ಅನಿ ನಿತಳ್ ನತ್ತೆ, ಮನುನ್ ಬಗುಕ್ನಾತ್, ಮಿಯಾ ನೆಮಲ್ಲ್ಯಾ ಸಬ್ಬತಾಚ್ಯಾ ದಿಸಾಕ್ನಿ ವಿರೊದ್ ಹೊವ್ನ್ ಹಾತ್, ಹೆಚ್ಯಾ ವಯ್ನಾ ಮಿಯಾ ತೆಂಚ್ಯಾ ಮದ್ದಿ ಕಮ್ಮಿಚ್ಯಾ ಮರ್ಯಾದಿಚೊ ಹೊವ್ನ್ ಹಾವ್. <verse eid="EZK 22:26" /><verse number="27" style="v" sid="EZK 22:27" />ಥೈತ್ಲಿ ಜಾಂನ್ತಿ ಲೊಕಾ ಜಾಸ್ತಿ ವಸುಲಿ ಸಾಟ್ನಿ ರಗಾತ್ ಪಾಡ್ವುನ್, ಮಾನ್ಸಾಕ್ನಿ ಗಿಳ್ತಲೆ ಹೊವ್ನ್, ಶಿಕಾರಿಕ್ ಪಿಂಜ್ತಲಿ ಝುಲ್ ಕುತ್ರೆ ಹೊಲ್ಯಾತ್. <verse eid="EZK 22:27" /><verse number="28" style="v" sid="EZK 22:28" />ಥೈ ಹೊತ್ತಿ ಝುಟಿ ಪ್ರವಾದಿಯಾ ಹೆಂಚೆ ಝುಟೆ ದರ್ಶನ್, ಝುಟಿ ಗೊಸ್ಟಿಯಾ ಬಗುನ್ ಸರ್ವೆಸ್ಪರಾನ್ ತೆಂಚೆಕ್ಡೆ ಬೊಲ್ಯಾನ್ ಮನುನ್ ಚುನ್ನೊ ಲಾವ್ತಾತ್. <verse eid="EZK 22:28" /><verse number="29" style="v" sid="EZK 22:29" />ಸಾದ್ರನ್ ಲೊಕಾಕ್ನಿ ತರಾಸ್ ದಿವ್ನ್ ಲುಟ್ಲ್ಯಾನಿ, ಕಾಯ್ಬಿ ಗತ್ ನಸಲ್ಲ್ಯಾಕ್ನಿ ಅನಿ ದುಶ್ರ್ಯಾ ದೆಶಾಚ್ಯಾಕ್ನಿ ಅನ್ಯಾಯ್ ಕರ್‍ಲ್ಯಾನಾತ್. <verse eid="EZK 22:29" /><verse number="30" style="v" sid="EZK 22:30" />ಮಿಯಾ ಮಾಜೊ ದೆಶ್ ಹಾಳ್ ಹೊಯ್ ನಸಿ ಸಾರ್ಕೆ, ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ದೆಶ್ ರಾಕುಕ್ ಅನಿ ಬಿರಕ್ ಪಡಲ್ಲ್ಯಾ ಭಿತ್ತಿಚ್ಯಾ ಗತಿನ್ ಇಬೆರಾವ್ಕ್, ಅನಿ ಭಿತ್ತ್ ಘಟ್ ಕರುಕ್ ಪಾಜೆ ಹೊಲ್ಲೊ ಹುಡಕ್ಲ್ಯಾರ್ಬಿ ಮಾಕಾ ಕೊನ್ಬಿ ಗಾವ್ಕ್ ನಾ. <verse eid="EZK 22:30" /><verse number="31" style="v" sid="EZK 22:31" />ತೆಚ್ಯಾ ವಯ್ನಾ, ಮಿಯಾ ಮಾಜೊ ರಾಗ್ ತೆಂಚೆವರ್‍ತಿ ವೊತುನ್, ಮಾಜ್ಯಾ ಪೆಟ್ತಲ್ಯಾ ರಾಗಾತ್ ತೆಂಕಾ ಜಾಳ್ವುನ್, ತೆಂಚಿ ಬುರ್ಶಿ ಚಾಲಿಚಿ ಚುಕ್ ತೆಂಚ್ಯಾ ಟಕ್ಲ್ಯಾಕ್ ಘಾಲ್ತಾ, ಮನ್ತಲಿ ಹಿ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 22:31" /></para>
  <chapter eid="EZK 22" />
  <chapter number="23" style="c" sid="EZK 23" />
  <para style="s">ಪಾಪಿ ಭೆನಿಯಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 23:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಅನಿ ಎಕ್ ಗೊಸ್ಟ್ ಸಾಂಗ್ಲ್ಯಾನ್, <verse eid="EZK 23:1" /><verse number="2" style="v" sid="EZK 23:2" />ನರ್ ಮಾನ್ಸಾ, ಎಕ್ ಬಾಯ್ಕೊ ಮನ್ಸಿಚಿ ದೊನ್ ಲೆಕಿಯಾ ಹೊತ್ತಿ. <verse eid="EZK 23:2" /><verse number="3" style="v" sid="EZK 23:3" />ತೆನಿ ಇಜಿಪ್ತಾತ್ ಸುಳ್ ಪಾನ್ ಕರಿತ್, ತೆಂಚ್ಯಾ ಬಾರಿಕ್ ಪಾನಾತ್ನಾ ತೆನಿ ವ್ಯಬಿಚಾರ್ ಕರಿತ್ ಹೊತ್ತ್ಯಾ ವಯ್ನಾ ತೆಂಚಿ ತಾನಾ ಹಿಚಕ್ಲ್ಯಾನಿ, ಅನಿ ತೆಂಚೆ ಥಾನಾಚಿ ಬೊಂಡಿಯಾ ಚಿರಡ್ಲ್ಯಾನಿ. <verse eid="EZK 23:3" /><verse number="4" style="v" sid="EZK 23:4" />ಥೊರ್ಲಿಚೆ ನಾವ್ ಒಹೊಲಾ ಅನಿ ಬಾರಿಕ್ಲಿಚೆ ನಾವ್ ಒಹೊಲಿಬಾ, ತೆನಿ ಮಾಜಿ ಬಾಯ್ಕಾ ಹೊವ್ನ್, ತೆಂಕಾ ಲೆಕಾ ಅನಿ ಲೆಕಿಯಾ ಮಾಜ್ಯಾ ಸಾಟ್ನಿ ಉಪಜ್ಲಿ, ಒಹೊಲಾ ಸಾಮಾರಿಯಾ ಅನಿ ಒಹೊಲಿಬಾ ಜೆರುಜಲೆಮ್ ಮನುನ್ ದಾಕ್ವುತಲಿ ನಾವಾ ಹೊವ್ನ್ ಹಾತ್. <verse eid="EZK 23:4" /><verse number="5" style="v" sid="EZK 23:5" />ಒಹೊಲಾ ಮಾಜಿ ಬಾಯ್ಕೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾನಾಚ್ ವ್ಯಬಿಚಾರ್ ಕರ್‍ಲಿನ್, ತಿನಿ ಅಪ್ನಾಚ್ಯಾ ದಗ್ಡಾಕ್ನಿ ಮಟ್ಲ್ಯಾರ್ ಅಸ್ಸಿರಿಯಾಂಚಿ ಸಯ್ನಿಕಾ, <verse eid="EZK 23:5" /><verse number="6" style="v" sid="EZK 23:6" />ಅನಿ ಝಾಂಬ್ಳೆ ಕಪ್ಡೆ ನೆಸಲ್ಲೆ, ದಾಂಡ್ಗೆ ಘೊಡ್ಕಿಯಾ ಚಾಲ್ವುನಾರೆ, ಮುಖಂಡಾ, ಕೊನ್ಬಿ ಚುಕಿನಸ್ತಾನಾ ಲೈ ಬರಿ ದಿಸ್ತಲಿ ದಾಂಡ್ಗ್ಯಾ ಮಾನ್ಸಾಕ್ನಿ ತೆಂಕಾ ಫಟ್ವುತಲೆ, ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಅಸ್ಸಿರಿಯಾಕ್ನಿ ಮನ್ ಲಾವ್ಲಿನ್. <verse eid="EZK 23:6" /><verse number="7" style="v" sid="EZK 23:7" />ಅಪ್ನಾಕ್ ತೆಂಕಾ ಸುಳಿ ಹೊವ್ನ್ ಒಪಸ್ಲಿನ್, ತೆನಿ ಸಗ್ಳೆ ಅಸ್ಸಿರಿಯಾತ್ನಿ ಲೈ ಮೊಟೆ, ತೆನಿ ಮನ್ ಕರಲ್ಲ್ಯಾಂಚ್ಯಾ ಮುರ್ತಿಯಾನಿಕ್ನಾ ಅಪ್ನಾಕ್ ಅಪವಿತ್ರ್ ಕರುನ್ ಘೆಟ್ಲಿನ್. <verse eid="EZK 23:7" /><verse number="8" style="v" sid="EZK 23:8" />ತಿನಿ ಅಪ್ನಿ ಇಜಿಪ್ತಾತ್ ಹೊತ್ತ್ಯಾ ತನ್ನಾಕ್ನಾಚ್ ವ್ಯಬಿಚ್ಯಾರ್ ಸೊಡುಕ್ನಾ, ಅಪ್ನಾಚ್ಯಾ ಬಾರಿಕ್ ಪನಾತ್ ಥೈ ಹೊತ್ತ್ಯಾ ನಿಕ್ನಾ ಅಪ್ನಿ ನಿಜುನ್ ತಿಚೆ ಕವ್ಳಿ ಥಾನಾಚಿ ಬೊಂಡಿಯಾ ಚಿರ್ಡುನ್ ತಿಚ್ಯಾಕ್ನಾ ಜಾಸ್ತಿ ವ್ಯಬಿಚಾರ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EZK 23:8" /><verse number="9" style="v" sid="EZK 23:9" />ತಸೆ ಹೊವ್ನ್ ಮಿಯಾ ತಿಕಾ ತಿಚ್ಯಾ ದಗ್ಡಾಚ್ಯಾ ಮಟ್ಲ್ಯಾರ್ ತಿನಿ ಮಳ್ಳ್ ಕರಲ್ಲ್ಯಾ ಅಸ್ಸಿರಿಯಾಂಚ್ಯಾ ಹಾತಿತ್ ಘಾಟ್ಲೊ. <verse eid="EZK 23:9" /><verse number="10" style="v" sid="EZK 23:10" />ಹೆನಿ ತಿಚೆ ನಾಗ್ಡೆಪಾನ್ ಪರ್ಗಟ್ ಕರ್ಲ್ಯಾನಿ, ಅನಿ ತೆಂಚ್ಯಾ ಝಿಲ್ಗ್ಯಾ ಅನಿ ಚೆಡ್ವಾಕ್ ಉಕ್ಲುನ್ ನೆವ್ನ್, ತೆಂಕಾ ತಲ್ವಾರಿನ್ ಮಾರ್ಲ್ಯಾನಿ, ತಿಕಾ ಝಡ್ತಿ ಹೊತಾನಾ ಬಾಯ್ಕೊ ಮನ್ಸಾತ್ನಿ ಬುರ್ಸೆ ನಾವ್ ಯೆಲೆ. <verse eid="EZK 23:10" /><verse number="11" style="v" sid="EZK 23:11" />ತಿಚಿ ಭೆನ್ ಒಹೊಲಿಯಾನ್ ಹೆ ಬಗುನ್ಬಿ ತನ್ನಾ ತಿಚ್ಯಾನ್ ಜಾಸ್ತಿಚಿ ಆಶಾ ಕರುನ್ ಅಕ್ಕಾಕಿಂತಾ ಜಾಸ್ತಿಚೆ ವ್ಯಬಿಚಾರ್ಪನ್ ಕರುನ್ ತಿಚ್ಯಾನ್ ಮೊಟ್ಟಿ ಸುಳಿ ಹೊಲಿ. <verse eid="EZK 23:11" /><verse number="12" style="v" sid="EZK 23:12" />ತಿನಿ ಅಪ್ನಾಚ್ಯಾ ಅಜುಬಾಜುಚ್ಯಾ, ಮುಖಂಡಾಕ್ನಿ, ಸಯ್ನಿಕಾ, ವಿಚಿತ್ರ ಕಪ್ಡೆ ನೆಸುನ್ ಘೆವ್ನ್ ಘೊಡ್ಕೊ ಚಾಲ್ವುತಲ್ಯಾಕ್ನಿ, ಸುಂದರ್ ದಾಂಡ್ಗ್ಯಾಕ್ನಿ ಅಪ್ನಾಚ್ಯಾ ಪಾಶ್ಯಾತ್ ಪಾಡ್ವುಲಿನ್. <verse eid="EZK 23:12" /><verse number="13" style="v" sid="EZK 23:13" />ತಿಬಿ ಅಪವಿತ್ರ್ ಹೊವ್ನ್ ಗೆಲ್ಲೆ ಬಗಟ್ಲೊ, ತೆನಿ ದೊಗ್ಯಾನಿ ಎಕುಚ್ ವಾಟ್ ಧರ್‍ಲ್ಯಾನಿ. <verse eid="EZK 23:13" /><verse number="14" style="v" sid="EZK 23:14" />“ಹಿನಿ ಅಪ್ನಾಚೆ ವ್ಯಬಿಚಾರ್ ಅನಿ ಜಾಸ್ತಿ ಕರ್‍ಲಿನ್, ಭಿತ್ತಿಚ್ಯಾ ಚಿತ್ತರಾತ್ನಿ ಹೊತ್ತ್ಯಾ ಕಸ್ದಿಯಾಂಚ್ಯಾ ಘೊಮನ್ಸಾಕ್ನಿ ಬಗ್ಲಿನ್, <verse eid="EZK 23:14" /><verse number="15" style="v" sid="EZK 23:15" />ತ್ಯಾ ಕಸ್ದಿಯಾಂಚ್ಯಾ ಘವ್ಮಾನ್ಸಾಚೆ ಕಪ್ಡೆ ತಾಂಬ್ಡೆ ಹೊತ್ತೆ. ತೆನಿ ಕಂಬ್ರೆಕ್ ಪಟ್ಟೊ ಭಾಂದುನ್ ಟಕ್ಲ್ಯಾಕ್ ಪವ್ಡ್ ನೆಸುನ್, ಬಗುಕ್ ಮುಖಂಡಾಚ್ಯಾ ಸಾರ್ಕೆ ದಿಸಿತ್, ತೆನಿ ಕಸ್ದಿಯಾಂಚ್ಯಾ ಲೆಕಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಭಿತ್ತಿಯಾನಿ ಚಿತ್ರಾ ಕಾಡ್ತಲೆ ಬಗ್ಲಿನ್. <verse eid="EZK 23:15" /><verse number="16" style="v" sid="EZK 23:16" />ತನ್ನಾ, ಹಿನಿ ಆಶಾ ಕರುನ್, ಕಸ್ದಿಯಾ ದೆಸಾತ್ ಅಪ್ನಾಚ್ಯಾ ಖಬ್ರಿಕಾರಾಕ್ನಿ ಧಾಡ್ಲಿನ್. <verse eid="EZK 23:16" /><verse number="17" style="v" sid="EZK 23:17" />ತನ್ನಾ ಬಾಬಿಲೊನಾತ್ ಹಿಚ್ಯಾ ಧಗ್ಡಾನಿ ಭಾಜ್ ಚಡುನ್ ಅಪ್ನಾಚ್ಯಾ ವ್ಯಬಿಚಾರಾ ವಯ್ನಾ ಹಿಕಾ ಹಾಳ್ ಕರ್ಲ್ಯಾನಿ, ಹಿ ತೆಂಚೆಕ್ನಾ ಅಪವಿತ್ರ್ ಹೊಲಿ, ತನ್ನಾ ಹಿಚಿ ಆಶ್ಯಾ ಹಿಚ್ಯಾಕ್ನಾ ಗೆಲಿ. <verse eid="EZK 23:17" /><verse number="18" style="v" sid="EZK 23:18" />ಅಸೆ ಹಿನಿ ವ್ಯಬಿಚಾರ್ ಕರುನ್, ಅಪ್ನಾಚೆ ನಾಗ್ಡೆಪಾನ್ ದಾಕ್ವುನ್ ಘೆಟಲ್ಲೆ ತನ್ನಾ, ಅಪ್ನಾಚೊ ಪ್ರೆಮ್ ಪಯ್ಲೆ ಹಿಚ್ಯಾ ಅಕ್ಕಾಕ್ನಾ ಗೆಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಹಿಚೆಕ್ನಾಬಿ ಗೆಲೆ. <verse eid="EZK 23:18" /><verse number="19" style="v" sid="EZK 23:19" />ಖರೆ ಹಿನಿ ಅಪ್ನಿ ಇಜಿಪ್ತಾತ್ ಬಾರಿಕ್ ಹೊತ್ತಿ ತನ್ನಾಚೆ ವ್ಯಬಿಚಾರ್ ಪನ್ ಯಾದ್ ಕರುನ್ಗೆವ್ನ್, ಅಪ್ನಾಚೆ ವ್ಯಬಿಚಾರ್ ಪಾನ್ ಜಾಸ್ತಿ ಕರ್‍ಲಿನ್. <verse eid="EZK 23:19" /><verse number="20" style="v" sid="EZK 23:20" />ಗಾಡ್ವಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಮಂದ್, ಅನಿ ಘೊಡ್ಕ್ಯಾಂಚ್ಯಾ ಭಾಶೆನ್ ದಾಟ್ತಲೆ ಹೊಲ್ಲ್ಯಾ ಕಸ್ದಿಯಾಂಚ್ಯಾ ದಗ್ಡಾಕ್ನಿ ಜಾಳ್ಯಾತ್ ಘಾಲುನ್ ಘೆಟ್ಲಿನ್”. <verse eid="EZK 23:20" /><verse number="21" style="v" sid="EZK 23:21" />ಒಹೊಲಿ ತುಜ್ಯಾ ಬಾರಿಕ್ ಥಾನಾಕ್ನಿ ಆಶ್ಯಾ ಕರಲ್ಲ್ಯಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಬೊಂಡಿಯಾ ಚಿರ್ಡುನ್ ಘೆವ್ನ್ ತುಜ್ಯಾ ಬಾರಿಕ್ ಪಾನಾಚಿ ಬುರ್ಶಿ ಕಾಮಾ ಯಾದಿಕ್ ಹಾನುನ್ ಘೆಟ್ಲೆಯ್,<verse eid="EZK 23:21" /></para>
  <para style="s">ಬಾರಿಕ್ಲ್ಯಾ ಭೆನಿಚ್ಯಾ ವರ್‍ತಿ ದೆವಾಚಿ ಝಡ್ತಿ</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 23:22" />ಅಸೆ ಹೊವ್ನ್, ಒಹೊಲಿಬಾ, ಸರ್ವೆಸ್ಪರ್ , ಅಸೆ ಮನ್ತಾ, “ಖಲ್ಯಾ ದಗ್ಡಾಂಚ್ಯಾಕ್ನಾ ತುಜಿ ಆಶ್ಯಾ ಫುರಾಹೊಲಿ ಮಟ್ಲ್ಯಾರ್, ತಿ ದಗ್ಡಾ, ಬರಿ ದಾಂಡ್ಗಿ ಮಾನ್ಸಾ, ಮುಖಂಡಾ, ಜಾಂನ್ತೆ ಅನಿ ಘೊಡ್ಕಿಯಾ ಚಾಲ್ವುನಾರೆ, ಭೊತ್ಯಾನಿ ಹೊತ್ತಿ ಸಗ್ಳಿ ಲೊಕಾ. <verse eid="EZK 23:22" /><verse number="23" style="v" sid="EZK 23:23" />ಮಟ್ಲ್ಯಾರ್, ಬಾಬೆಲಾಚಿ ಲೊಕಾ, ಸಗ್ಳೆ ಕಸ್ದಿಯಾಚೆ, ಪೆಕೊದಾಚೆ, ಶೊಯಾಚೆ, ಕೊಯಾಚೆ ಅನಿ ಅಸ್ಸಿರಿಯಾಚೆ ಹೆಂಕಾ ಸಗ್ಳ್ಯಾಕ್ನಿಬಿ ಮಿಯಾ ತುಕಾ ವಿರೊದ್ ಕರುನ್ ಉಟ್ವುತಾ. <verse eid="EZK 23:23" /><verse number="24" style="v" sid="EZK 23:24" />ತೆನಿ ರಥಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ, ಗಾಡಿಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ, ಲೊಕಾಂಚ್ಯಾ ತಾಂಡ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ, ತಾಕ್ತಿಚೆ ಹೊವ್ನ್ ತುಜ್ಯಾ ವಿರೊಧ್ ಯೆಲ್ಯಾತ್, ಭೊತ್ಯಾನಿ ಗುರಾನಿ, ಟಕ್ಲ್ಯಾಚಿ ರಾಕ್ವನಿಚೆ ಕವ್ಚಿ, ಧರುನ್ ಘೆವ್ನ್ ತುಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಮಿಯಾ ತೆಂಕಾ ನ್ಯಾಯ್ ಕರ್ತಲೊ ಅಧಿಕಾರ್ ದಿತಾ, ತೆನಿ ತೆಂಚ್ಯಾ ನ್ಯಾಯಾಚ್ಯಾ ಸಾರ್ಕೆ ಶಿಕ್ಷ್ಯಾ ದಿತ್ಯಾತ್. <verse eid="EZK 23:24" /><verse number="25" style="v" sid="EZK 23:25" />ಮಿಯಾ ಮಾಜೊ ರಾಗ್ ತುಜೆರ್ ವೊತುನ್ ತೆನಿ ತುಜೆರ್ ರಾಗ್ ಕಾಡುನ್ಗೆತ್ಯಾತ್, ತುಜೆ ನಾಕ್, ಕಾನಾ ಕಾತರ್ತ್ಯಾತ್, ತುಜಾತ್ ಹುರಲ್ಲೆ, ತಲ್ವಾರಾಕ್ ಗಾವ್ತ್ಯಾತ್, ತುಜ್ಯಾ ಚೆಡ್ವಾ ಝಿಲ್ಗ್ಯಾಕ್ನಿ ಧರುನ್ ನ್ಹೆತ್ಯಾತ್, ತುಜಿ ಹುರಲ್ಲಿ ಲೊಕಾ ಆಗಿನ್ ಜಳುನ್ ಜಾತಾತ್. <verse eid="EZK 23:25" /><verse number="26" style="v" sid="EZK 23:26" />ತೆನಿ ತುಜೆ ಕಪ್ಡೆ ಕಾಡುನ್ ಟಾಕುನ್, ತುಜಿ ಸುಂದರ್ ವಸ್ತಾ, ಕಾಡುನ್ ಘೆತ್ಯಾತ್. <verse eid="EZK 23:26" /><verse number="27" style="v" sid="EZK 23:27" />ಅಶೆ ಮಿಯಾ ತುಜಿ ಬುರ್ಶಿ ಕಾಮಾ ತಿಯಾ ಇಜಿಪ್ತಾತ್ ಹೊತ್ತ್ಯಾಕ್ನಾ ಕರುನ್ಗೆತ್ ಯೆಲ್ಲಿ, ತುಜೆ ವ್ಯಬಿಚಾರ್ ಕಾಡುನ್ ಟಾಕ್ತಾ ಮಾನಾ ತಿಯಾ ತೆಂಚೆಕ್ಡೆ ಡೊಳೆ ಉಕ್ಲುನ್ ಬಗಿನಸ್ತಾನಾ, ಇಜಿಪ್ತಾಕ್ ಯಾದ್ ಕರಿನಸ್ತಾನಾ ರ್‍ಹಾತೆಯ್”. <verse eid="EZK 23:27" /><verse number="28" style="v" sid="EZK 23:28" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಶೆ ಮನ್ತಾ, ಅಬಕ್, ತಿಯಾ ಕೊನಾರ್ ರಾಗ್ ಕರ್ತೆ ಬಗ್, ತುಜಿ ಆಶಾ ಕೊನಾ ವಯ್ನಾ ಪರ್‍ತುನ್ ಘೆತಯ್ ತೆಚ್ಯಾ ಹಾತಿತ್ ಮಿಯಾ ತುಕಾ ಒಪ್ಸುನ್ ದಿತಾ. <verse eid="EZK 23:28" /><verse number="29" style="v" sid="EZK 23:29" />ತೆನಿ ತುಜೆರ್ ರಾಗ್ ಕಾಡುನ್ ಘೆವ್ನ್, ತಿಯಾ ರಾಬಲ್ಲೆ ಸಗ್ಳೆ ಚೊರುನ್, ತುಕಾ ಖಾಲಿ ಕರ್ತ್ಯಾತ್, ಅಸೆ ಲಜ್ಜೆನ್ ಭರಲ್ಲೆ ತುಜೆ ವ್ಯಬಿಚಾರ್ ಪಾನ್, ತುಜೆ ಬುರ್ಸೆ ಪಾನ್, ಅನಿ ವ್ಯಬಿಚಾರ್ ಮ್ಹಾಳಾಕ್ ಯೆತಾ. <verse eid="EZK 23:29" /><verse number="30" style="v" sid="EZK 23:30" />ಹಿ ತರಾಸಾ ತುಕಾ ಯೆವ್ಕ್, ತಿಯಾ ಲೊಕಾಕ್ನಿ ಪಾಶ್ಯಾತ್ ಘಾಲುನ್, ತೆಂಚ್ಯಾ ಮುರ್ತಿಯಾನಿ ತುಕಾ ಅಪವಿತ್ರ್ ಕರುನ್ ಘೆಟಲ್ಲೆಚ್ ಕಾರನ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 23:30" /><verse number="31" style="v" sid="EZK 23:31" />ತಿಯಾ ತುಜ್ಯಾ ಅಕ್ಕಾಚ್ಯಾ ವಾಟೆನ್ ಚಲಲ್ಲ್ಯಾ ವಯ್ನಾ, ತಿನಿ ಫಿಲ್ಲೆ ಶಿಕ್ಷಾಚೆ ಆಯ್ದಾನುಚ್ ತುಜ್ಯಾ ಹಾತಿತ್ ದಿತಾ.<verse eid="EZK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 23:32" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ,</para>
  <para style="q1" vid="EZK 23:32">“ಲಾಂಬ್ಬಿ, ರುಂದ್ಬಿ, ಲೈ ಭರ್‍ತಲ್ಯಾ ತುಜ್ಯಾ ಅಕ್ಕಾಚ್ಯಾ ಆಯ್ದಾನಾತ್ ತಿಯಾ ಫಿವ್ನ್,</para>
  <para style="q2" vid="EZK 23:32">ಹಾಸಾರಾಕ್ಬಿ ಅನಿ ಟೊಪ್ತಲ್ಯಾ ಗೊಸ್ಟಿಯಾಕ್ನಿ ಶಿಕಾರ್ ಹೊತೆಯ್.<verse eid="EZK 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZK 23:33" />ಸಮಾರ್ಯ ಮನ್ತಲ್ಯಾ ತುಜ್ಯಾ ಅಕ್ಕಾನ್ ಫಿಲ್ಲ್ಯಾ ಭಯಾನಕ್ ಅನಿ ದುಕ್ಕೆಚ್ಯಾ ಆಯ್ದಾನಾತ್ನಾ ತಿಯಾಬಿ ಫಿವ್ನ್,</para>
  <para style="q2" vid="EZK 23:33">ನಾಶಾನ್ ಅನಿ ದುಕ್ಕೆನ್ ಭರಲ್ಲಿ ರ್‍ಹಾತೆಯ್.<verse eid="EZK 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZK 23:34" />ತ್ಯಾತುರ್ ಎಕ್ ಟೆಂಬೊಬಿ ಹುರ್ವಿ ನಸ್ತಾನಾ ಫಿವ್ನ್,</para>
  <para style="q2" vid="EZK 23:34">ತೆಚೆ ತುಕ್ಡೆ ತುಕ್ಡೆ ಕರುನ್ ಫೊಡುನ್ ತುಜಿ ಥಾನಾ ಪಿಂಜುನ್ ಘೆತಯ್,</para>
  <para style="q2" vid="EZK 23:34">ಹ್ಯೊ ಮಾಜೊ ಹುಕುಮ್ ಹೊವ್ನ್ ಹಾಯ್” ಮನುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್.<verse eid="EZK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 23:35" />ಅಶೆ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, “ತಿಯಾ ಮಾಕಾ ಡುಬ್ರಿಚ್ಯಾ ಫಾಟಿ ನಿಪ್ವುನ್ ಇಸರಲ್ಲ್ಯಾ ವಯ್ನಾ ತುಜ್ಯಾ ಬುರ್ಶಾ ಕಾಮಾಚಿ ಅನಿ ವ್ಯಬಿಚಾರಾಚೆ ಫಳ್ ತಿಯಾಚ್ ಅನ್ಬೊಗುಕ್ ಪಾಜೆ”.<verse eid="EZK 23:35" /></para>
  <para style="s">ದೊನ್ ಭೆನಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ದೆವಾಚಿ ಝಡ್ತಿ</para>
  <para style="p">
    <verse number="36" style="v" sid="EZK 23:36" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಅಸಿ ಸಾಂಗ್ಲ್ಯಾನ್, ನರ್ ಮಾನ್ಸಾ, ಒಹೊಲಾಕ್ ಅನಿ ಒಹೊಲಿಬಾಕ್ ಶಿಕ್ಷ್ಯಾ ದಿವ್ಕ್ ತುಜೊ ಮನ್ ತಯಾರ್ ಹಾಯ್ ಕಾಯ್? ತೆಂಚಿ ಬುರ್ಶಿ ಕಾಮಾ ತೆಂಕಾ ಕಳ್ವು. <verse eid="EZK 23:36" /><verse number="37" style="v" sid="EZK 23:37" />ತೆನಿ ವ್ಯಬಿಚಾರ್ ಕರ್‍ಲ್ಯಾನಾತ್, ತೆಂಚೊ ಹಾತ್ ರಗ್ತಾನ್ ಭರ್ಲಾ, ತ್ಯಾ ಮುರ್ತಿಯಾಕ್ನಿ ವಾಂಗ್ಡಾ ವ್ಯೆಭಿಚಾರ್ ಕರ್ಲಾತ್, ಅಪ್ನಾಚ್ಯಾಕ್ನಾ ಉಪಾಜಲ್ಲ್ಯಾ ಲೆಕಾಕ್ನಿ ಮುರ್ತಿಯಾಕ್ನಿ ಬಲಿ ಭೆಟ್ವುಲಾತ್. <verse eid="EZK 23:37" /><verse number="38" style="v" sid="EZK 23:38" />ಹೆ ಕರಲ್ಲ್ಯಾ ದಿಸಿಚ್ ಮಾಜೆ ಪವಿತ್ರ್ ಘರ್, ಅಪವಿತ್ರ್ ಕರುನ್ ಮಿಯಾ ಎಚಲ್ಲೊ ಸಾಬ್ಬಾತಾಚೊ ದಿಸ್ ಅಪವಿತ್ರ್ ಕರ್‍ಲ್ಯಾನಾತ್. <verse eid="EZK 23:38" /><verse number="39" style="v" sid="EZK 23:39" />ಅಪ್ನಾಚ್ಯಾ ಪೊರಾಂಚೊ ಜಿವ್ ಕಾಡುನ್, ಅಪ್ನಾಚ್ಯಾ ಮುರ್ತಿಯಾಕ್ನಿ ಭೆಟ್ವುಲ್ಲ್ಯಾ ದಿಸಿಚ್ ಮಾಜ್ಯಾ ಪವಿತ್ರ್ ಗುಡಿತ್ ಗುಸುನ್ ಅಪವಿತ್ರ್ ಕರ್ಲ್ಯಾನಿ, ಅಬಗ್ ಮಾಜ್ಯಾ ಘರಾ ಭುತ್ತುರ್ ಸರ್ ಮದ್ದಿ ಹೆ ಕರ್ಲ್ಯಾನಿ. <verse eid="EZK 23:39" /><verse number="40" style="v" sid="EZK 23:40" />ಖಬ್ರಿ ಕಾರ್ ಧಾಡುನ್, ಘೊಮನ್ಸಾಕ್ನಿ ಧುರ್ನಾ ಬಲ್ವುನ್ ಘೆವ್ನ್, ತೆನಿ ಯೆಲ್ಯಾನಿ, ಎಯ್ ಬಾಯ್ಕೊಮನ್ಸಿ ತೆಂಚೆ ಸಾಟ್ನಿ ತಿಯಾ ಪಾನಿ ನ್ಹವ್ನ, ಡೊಳ್ಯಾಕ್ನಿ ಕಾಳೆ ಲಾವ್ನ್ ಘೆವ್ನ್, ತುಕಾ ವಸ್ತಾನಿ ಸಿಂಗಾರ್ ಕರುನ್ ಘೆಟ್ಲೆ, <verse eid="EZK 23:40" /><verse number="41" style="v" sid="EZK 23:41" />ಅನಿ ಸಿಂಗಾರಾಚ್ಯಾ ಭಾಜೆರ್ ಬಸ್ಲೆ, ತೆಂಚ್ಯಾ ಇದ್ರಾಕ್ ಬರ್ಯಾ ಜೆವ್ನಾಕ್ ತಯಾರ್ ಹೊಲ್ಲ್ಯಾ ಮೆಜಾರ್ ಧುಪ್ ಅನಿ ತೆಲ್ ಥವ್ಲೆ. <verse eid="EZK 23:41" /><verse number="42" style="v" sid="EZK 23:42" />ಥೈ ಲೊಕಾಂಚ್ಯಾ ಅವಾಜಾಚೊ ತಾಂಡೊ ತೆಂಚ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತೊ, ಮರುಬುಮಿಕ್ನಾ ಪಿದೊಡ್ಯಾಕ್ನಿ ಬಲ್ವುನ್, ತೆನಿ ಗಾವಾತ್ಲ್ಯಾ ಲೊಕಾನಿಕ್ನಾ ಮಿಳುನ್, ತೆಂಚ್ಯಾ ದೊಗ್ಯಾಂಚ್ಯಾ ಹಾತಿಕ್ ಕಡಾನ್ ಘಾಲುನ್, ತೆಂಚ್ಯಾ ಟಕ್ಲ್ಯಾಕ್ ಸುಂದರ್ ಮುಕುಟ್ ಘಾಟ್ಲ್ಯಾನಿ. <verse eid="EZK 23:42" /><verse number="43" style="v" sid="EZK 23:43" />ತನ್ನಾ ಮಿಯಾ ಬಾಡುನ್ ಗೆಲ್ಲಿಕ್ ಅಜುನ್ ವ್ಯಬಿಚಾರ್ ಕರ್ತ್ಯಾತ್ ನ್ಹಯ್ ಮಟ್ಲೊ. <verse eid="EZK 23:43" /><verse number="44" style="v" sid="EZK 23:44" />ವ್ಯಬಿಚಾರಿಕ್ನಾ ಮಿಳ್ತಲ್ಯಾ ಸಾರ್ಕೆ ಹಿ ಲೊಕಾ ತಿಚೆಕ್ನಾ ಮಿಳ್ಳಿ, ಹೊಯ್ ಬುರ್ಶಿ ಬಾಯ್ಕೊಮನ್ಸಾ ಹೊಲ್ಲ್ಯಾ ಒಹೊಲಾ ಅನಿ ಒಹೊಲಿಬಾಕ್ಡೆ ಮಿಳ್ಳ್ಯಾನಿ. <verse eid="EZK 23:44" /><verse number="45" style="v" sid="EZK 23:45" />ನಿತಿಚಿ ಮಾನ್ಸಾ ತೆಂಕಾ ನ್ಯಾಯ್ ದಿವ್ನ್ ವ್ಯಬಿಚಾರಿಯಾಕ್ನಿ ರಗಾತ್ ವತಲ್ಯಾಂಚ್ಯಾ ಬಾಯ್ಕೊ ಮನ್ಸಾಕ್ನಿಬಿ ಲಾಗು ಹೊಲ್ಲೆ ದಂಡ್ ಲಾವ್ತ್ಯಾತ್, ತೆನಿ ವ್ಯಬಿಚಾರ್ನಿಯಾ ತೆಂಚೊ ಹಾತ್ ರಗ್ತಾನ್ ಭರ್ಲಾ. <verse eid="EZK 23:45" /><verse number="46" style="v" sid="EZK 23:46" />ಸರ್ವೆಸ್ಪರ್ ಅಸೆ ಮನ್ತಾ, “ಮಿಯಾ ಹ್ಯಾ ಬಾಯ್ಕೊ ಮನ್ಸಾಂಚ್ಯಾ ವಿರೊಧ್ ಬಯ್ಟೆಕ್ ಕರುನ್, ತೆಂಕಾ ತರಾಸಾತ್ ಘಾಲುನ್, ಸಗ್ಳ್ಯಾನಿಬಿ ಭ್ಹಿಯಾ ಒಪ್ಸುನ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 23:46" /><verse number="47" style="v" sid="EZK 23:47" />ಬಯ್ಟೆಕಾತ್ಲೆ ಹೆಂಚ್ಯಾ ವರ್‍ತಿ ಗುಂಡೆ ಮಾರುನ್ ಹೆಂಕಾ ತಲ್ವಾರಾನಿ ಮಾರುನ್, ತೆಂಚ್ಯಾ ಲೆಕಾ ಅನಿ ಲೆಕಿಯಾಕ್ನಿ ಮಾರುನ್ ತೆಂಚಿ ಘರಾ ಆಗಿನ್ ಜಾಳುತ್ಯಾತ್. <verse eid="EZK 23:47" /><verse number="48" style="v" sid="EZK 23:48" />ಅಸೆ ಮಿಯಾ ದೆಸಾತ್ನಾ ಬುರ್ಸೆಪಾನ್ ಕಾಡುನ್ ಟಾಕ್ತಾ, ಹೆಚ್ಯಾ ವಯ್ನಾ ಸಗ್ಳ್ಯಾ ಬಾಯ್ಕೊಮನ್ಸಾಕ್ನಿಬಿ ತುಮಿ ಕರಲ್ಲಿ ಬುರ್ಶಿ ಕಾಮಾ ಕರುಚೆ ನ್ಹಯ್ ಮನುನ್ ಅಕ್ಕಲ್ ಯೆತಾ. <verse eid="EZK 23:48" /><verse number="49" style="v" sid="EZK 23:49" />ತುಮ್ಚಾ ಬುರ್ಶಾ ಕಾಮಾಚೆ ಫಳ್ ತುಮ್ಕಾ ಖಾವ್ಸುಲ್ಯಾತ್, ತುಮ್ಚ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾ ವಯ್ನಾ ಹೊಲ್ಲೊ ಪಾಪ್ ತುಮಿ ಸೊಸ್ತ್ಯಾಸಿ, ಅಸಿ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮನ್ತಲೆ ತುಮ್ಕಾ ಕಳ್ತಾ”.<verse eid="EZK 23:49" /></para>
  <chapter eid="EZK 23" />
  <chapter number="24" style="c" sid="EZK 24" />
  <para style="s">ಜರುಜಲೆಮ್ ರಾಂದ್ತಲೆ ಆಯ್ದಾನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 24:1" />ನವ್ಯಾ ವರ್ಸಾಚ್ಯಾ, ಧಾವ್ಯಾ ಮಯ್ನ್ಯಾಚ್ಯಾ, ಧಾವ್ಯಾ ದಿಸಿ, ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾಕಾ ಅಸೆ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EZK 24:1" /><verse number="2" style="v" sid="EZK 24:2" />ನರ್ ಮಾನ್ಸಾ, ಹ್ಯಾ ದಿಸಾಚ್ಯಾ, ಹ್ಯಾಚ್ ದಿಸಾಚೆ ನಾವ್ ಲಿವ್ನ್ ಘೆ, ಹ್ಯಾ ದಿಸಿಚ್ ಬಾಬಿಲೊನಾಚೊ ರಾಜಾ ಜೆರುಜಲೆಮಾಕ್ ಖಬ್ಜಾ ಕರ್ಲಾ. <verse eid="EZK 24:2" /><verse number="3" style="v" sid="EZK 24:3" />ಹ್ಯಾ ದುಸ್ಟ್ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಕಾನಿ ಸಾರ್ಕೆ ಕರುನ್ ಅಸಿ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸಿ ಸಾಂಗ್ತಾ, ಟೊಪ್ ಚುಲಿಚ್ಯಾ ವರ್‍ತಿ ಥವ್, ತ್ಯಾತುರ್ ಪಾನಿ ವತ್; <verse eid="EZK 24:3" /><verse number="4" style="v" sid="EZK 24:4" />ಮಾಸಾಚೆ ತುಕ್ಡೆ ಜಾಂಗ್ ಅನಿ ಖಾಂಜೊ ಹೆ ಸಗ್ಳಿ ಬರೆ ತುಕ್ಡೆ ತ್ಯಾತುರ್ ವಾಂಗ್ಡಾಚ್ ಘಾಲ್, ಅನಿ ಬರಿ ಹೊತ್ತಿ ಹಡ್ಡಾ ತ್ಯಾತುರ್ ಭರ್. <verse eid="EZK 24:4" /><verse number="5" style="v" sid="EZK 24:5" />ಹಿಂಡಾತ್ಲೆ ಬರೆ ಹೊತ್ತೆ ಕಾಡುನ್ ಘೆ, ಟೊಪಾಚ್ಯಾ ಥಳಾತ್ ಹಡ್ಡಾ ಗೊಳಾ ಕರುನ್, ಬರೆ ಕರುನ್ ಸಿಜ್ವುನ್, ಹಡ್ಡಾ ತ್ಯಾತುರ್ ಉಕಡ್. <verse eid="EZK 24:5" /><verse number="6" style="v" sid="EZK 24:6" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಶೆ ಮನ್ತಾ, ಖುನಿ ಕಾರಾನಿ ಭರಲ್ಲ್ಯಾ ಶಾರಾ, ತುಕಾ ದಿಕ್ಕಾರ್! ತ್ಯಾ ಟೊಪಾಚೊ ಜಂಗ್ ಸೊಡುನ್ ಜಾಯ್ ನಸ್ತಾನಾ ತ್ಯಾತುರುಚ್ ರಾಫ್ ಹಾಯ್ ನ್ಹಯ್, ಮಾಸಾಚೆ ತುಕ್ಡೆ ಎಚುನ್, ಗಾಂವ್ ಗಾವಲ್ಲೆ ಕಾಡುನ್ ಸೊಡ್. <verse eid="EZK 24:6" /><verse number="7" style="v" sid="EZK 24:7" />ಜೆರುಜಲೆಮಾಚ್ಯಾ ಶಾರಾಚೆ ಗಳಲ್ಲೆ ರಗಾತ್ ತ್ಯಾತುರುಚ್ ಇಬೆ ಹಾಯ್ ನ್ಹಯ್, ಧುಳ್ ಲಾಗ್ತಾ ಮನುನ್ ತ್ಯಾ ಶಾರಾಚಿ ಲೊಕಾ ತೆ ಜಿಮ್ನಿಚ್ಯಾ ವರ್‍ತಿ ಟಾಕಿ ನಸ್ತಾನಾ, ತೆಕಾ ಮೊಟ್ಟ್ಯಾ ಗುಂಡ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಇಬೆ ಕರ್‍ತಾತ್. <verse eid="EZK 24:7" /><verse number="8" style="v" sid="EZK 24:8" />ತ್ಯಾ ರಕ್ತಾಚ್ಯಾ ರಾಗಾನ್ ಶೆಡಾಕ್ ಶೆಡ್ ಕಾಡುನ್ ಘೆವ್ಚೆ ಮನುನ್, ತೆ ಮಿಯಾ ಆಟುಕ್ ದಿ ನಸ್ತಾನಾ ಮೊಟ್ಟ್ಯಾ ಗುಂಡ್ಯಾಚ್ಯಾ ತುದಿರ್ ವರ್‍ತಿ ಇಬೆ ಕರ್ಲಾ. <verse eid="EZK 24:8" /><verse number="9" style="v" sid="EZK 24:9" />ಅಶೆ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೆ ಮನ್ತಾ, ಹ್ಯಾ ಖುನ್ ಕಾರಾನಿ ಭರಲ್ಯಾ ಶಾರಾ, ತಿಕಾ ದಿಕ್ಕಾರ್! ಮಿಯಾಚ್ ಆಗ್ ಗುಂಪೊ ಕರುನ್ ಲಾವ್ತಾ. <verse eid="EZK 24:9" /><verse number="10" style="v" sid="EZK 24:10" />ಲೈ ಆಗ್ ಹೊಂವ್ದಿತ್ ಜಾಸ್ತಿ ನಾಕ್ಡಾ ಘಾಲ್, ಮಾಸ್ ಸಿಜುಂದಿ ಕಡೆ ಹದಾ ರ್‍ಹಾಂವ್ದಿತ್, ಹಡ್ಡಾ ಸಿಜುಂದಿತ್. <verse eid="EZK 24:10" /><verse number="11" style="v" sid="EZK 24:11" />ಮಾನಾ ಹಂಡೊ ತಾಪುನ್, ತಾಂಬ್ಯಾಚ್ಯಾ ಸಾರ್ಕೆ ತಾಂಬ್ಡೆ ಹೊವ್ನ್ ಭುತ್ತುರ್ಲೆ ಬುರ್ಸೆ ಕರ್ಗುನ್ ಜಂಗ್ ನಾ ಹೊವ್ನ್ ಜಾತಾ, ತೆಕಾ ಖಾಲಿ ಕರುನ್ ಖೆಂಡಾಚ್ಯಾ ವರ್‍ತಿ ಥವ್. <verse eid="EZK 24:11" /><verse number="12" style="v" sid="EZK 24:12" />ತೆ ಮಾಕಾ ಉಲ್ಲೆಚ್ ತರಾಸ್ ಅನಿ ಫಿರೆ ಹೊಯ್ ಹೊಲಾ, ಹೊಲಾರ್ಬಿ ತೆಕಾ ಲಾಗಲ್ಲಿ ಜಂಗ್ಬಿ ಜಾವ್ಕ್ ನಾ ಆಗ್ಬಿ ಇಜುಕ್ನಾ. <verse eid="EZK 24:12" /><verse number="13" style="v" sid="EZK 24:13" />ತಸೆಚ್ ತುಜಿ ಬುರ್ಶಿಕಾಮಾ ಕಂಟಾಳಲ್ಲ್ಯಾ ವಯ್ನಾ ಮಿಯಾ ತುಕಾ ಕವ್ಡೆಬಿ ನಿತಳ್ ಕರ್ಲ್ಯಾರ್ಬಿ ತಿಯಾ ನಿತಳ್ ಹೊಯ್ ನಸಲ್ಲ್ಯಾ ವಯ್ನಾ, ಮಿಯಾ ಮಾಜೊ ರಾಗ್ ತುಜಾರ್ ಘಾಲುನ್ ಶಾಂತ್ ಹೊಯ್ ಸಗೊಳ್ ತಿಯಾ ತುಜೆ ಬುರ್ಸೆ ಕಾಡುನ್ ಘೆಯ್ ನಸ್ತಾನಾ ಶುದ್ದ್ ಹೊಯ್ ನಸ್ತಾನಾ ಹಾಸ್. <verse eid="EZK 24:13" /><verse number="14" style="v" sid="EZK 24:14" />ಸರ್ವೆಸ್ಪರ್ ಹೊಲ್ಲೊ ಮಿಯಾ ಹೆ ಸಾಂಗ್ಲಾ; ಹೆ ಚಲುನುಚ್ ಚಲ್ತಾ, ಮಿಯಾ ಪುರಾ ಕರ್ತಾ; ಪಾಟಿ ಘೆಯ್ನಾ, ಮಾಪಿ ಕರಿನಾ, ದಯಾ ದಾಕ್ವಿನಾ, ತುಜಿ ಬುರ್ಶಿ ವಾಟಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ವಯ್ನಾ ಸಮಾ ಹೊವ್ನ್ ತುಕಾ ನ್ಯಾಯ್ ಹೊತಾ, ಹೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್.<verse eid="EZK 24:14" /></para>
  <para style="s">ಪ್ರವಾದ್ಯಾಚ್ಯಾ ಬಾಯ್ಕೊಚೆ ಮರಾನ್</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 24:15" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಅನಿ ಎಕ್ ಗೊಸ್ಟ್ ಸಾಂಗ್ಲ್ಯಾನ್, <verse eid="EZK 24:15" /><verse number="16" style="v" sid="EZK 24:16" />“ನರ್ ಮಾನ್ಸಾ, ಅಬಕ್ ಎಕುಚ್ ಮಾರಾಕ್ ಮಿಯಾ ತುಕಾ ಡೊಳ್ಯಾಚಿ ಖುಸಿ ಹೊವ್ನ್ ಹೊತ್ತಿಕ್ ತುಜೆಕ್ನಾ ಕಾಡುನ್ ಘೆವ್ನ್ ಜಾತಾ, ಹೊಲ್ಯಾರ್ಬಿ ತಿಯಾ ಗೊಳಾಟ್ ಕರುನುಕ್ಕೊ, ರಡುನಕ್ಕೊ, ದುಕ್ಕ್ ಗಾಲುನಕ್ಕೊ, ಅವಾಜ್ ಕರ್ ನಸ್ತಾನಾ ಮಾಗ್. <verse eid="EZK 24:16" /><verse number="17" style="v" sid="EZK 24:17" />ದುರ್ ಹೊವ್ನ್ ಹೊಲ್ಲೊ ದುಕ್ಕ್ ದಾಕ್ವುನಕ್ಕೊ, ಟಿವಾಲೊ ಲಪ್ಟುನ್ ಘೆವ್ನ್, ಹೊನಯಾ ಘಾಲುನ್ ಘೆವ್ನ್ ರಾ, ತೊಂಡ್ ಕಪ್ಡ್ಯಾನಿ ಧಾಪುನ್ ಘೆವ್ ನಕ್ಕೊ, ಕೊನ್ ತರಿ ಮರಲ್ಯಾ ತನ್ನಾ ಘಾಲ್ತಲೆ ಜೆವಾನ್ ಕರುನಕ್ಕೊ”. <verse eid="EZK 24:17" /><verse number="18" style="v" sid="EZK 24:18" />ಅಸಿ ಹುಕುಮ್ ಹೊತಾನಾ, ಮಿಯಾ ನಸ್ಕಾತ್ ಲೊಕಾಕ್ನಿ ಪ್ರವಾದನ್ ಕರ್ಲೊ; ತಿನ್ಸಾನಾಕ್ ಮಾಜಿ ಬಾಯ್ಕೊ ಮರುನ್ ಗೆಲಿ; ದುಸ್ರೆನ್ ದಿಸಿ ಸಕ್ಕಾಳಿ ಮಾಕಾ ಹುಕುಮ್ ಹೊಯ್ನಾ ಸಾರ್ಕೆ ಮಾನುನ್ ಚಲ್ಲೊ. <verse eid="EZK 24:18" /><verse number="19" style="v" sid="EZK 24:19" />ತನ್ನಾ ಲೊಕಾ, “ತಿಯಾ ಅಸೆ ಕರ್‍ತಲ್ಯಾ ವಯ್ನಾ ಅಮಿ ಕಾಯ್ ಅರ್ಥ್ ಕರುನ್ ಘೆವ್ಚೆ? ಕಳ್ವುಚೆ ನ್ಹಯ್”? ಮನುನ್ ಇಚಾರ್‍ತಾನಾ, <verse eid="EZK 24:19" /><verse number="20" style="v" sid="EZK 24:20" />ಮಿಯಾ ತೆಂಕಾ ಅಸೆ ಸಾಂಗ್ಲೊ; “ಸರ್ವೆಸ್ಪರಾನ್ ಹೆ ಬೊಲ್ನೆ ಮಾಕಾ ದಿಲ್ಯಾನ್, <verse eid="EZK 24:20" /><verse number="21" style="v" sid="EZK 24:21" />ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾಕ್ ಅಸಿ ಸಾಂಗ್, ಅಬಕ್ ತುಕಾ ಮುಕ್ಯ್ ಬಳ್, ಡೊಳ್ಯಾಚಿ ಖುಸಿ ಅನಿ ಪ್ರೆಮಾಚೊ ಜಿವ್ ಹೊಲ್ಲ್ಯಾ ಮಾಜೊ ಪವಿತ್ರ್ ಗುಡಿಕ್ ಮಿಯಾ ಅಪವಿತ್ರ್ ಕರ್ತಾ; ತುಮಿ ಸೊಡುನ್ ಯೆಲ್ಲ್ಯಾ ತುಮ್ಚಿ ಝಿಲ್ಗೆ ಚೆಡ್ವಾ ತಲ್ವಾರಾಕ್ ಗಾವ್ತಾತ್”, ಮನ್ತಲೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಸಾಂಗ್ತಾ. <verse eid="EZK 24:21" /><verse number="22" style="v" sid="EZK 24:22" />ತನ್ನಾ ಮಿಯಾ ಕರಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತುಮಿ ಕರ್ತ್ಯಾಶಿ, ಮಟ್ಲ್ಯಾರ್ ಕಪ್ಡ್ಯಾನಿ ತೊಂಡ್ ಧಾಪುನ್ ಘೆಯ್ ನಸ್ತಾನಾ, <verse eid="EZK 24:22" /><verse number="23" style="v" sid="EZK 24:23" />ದುಕ್ಕೆತ್ ರ್‍ಹಾತಾನಾ ದುಸ್ರ್ಯಾನಿ ಹಾನುನ್ ದಿಲ್ಲೆ ಜಜೆವಾನ್ ಖಾಯ್ ನಸ್ತಾನಾ, ಪಾವ್ಡ್ ಲಪ್ಟುನ್ ಘೆಯ್ ನಸ್ತಾನಾ, ಹೊನಯಾ ಘಾಲುನ್ ಘೆಯ್ ನಸ್ತಾನಾ, ರ್‍ಹಾತ್ಯಾಸಿ; ತುಮಿ ಗೊಳಾಟ್ ಕರಿನ್ಯಾಸಿ, ರಡಿನ್ಯಾಸಿ, ಹೊಲ್ಯಾರ್ ತುಮ್ಚ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾ ವಯ್ನಾ ಕಾಯ್ ನಸಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಜಾತ್ಯಾಸಿ. ಎಕ್ಲ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಎಕ್ಲೊ ನರಳ್ತ್ಯಾಸಿ, <verse eid="EZK 24:23" /><verse number="24" style="v" sid="EZK 24:24" />ಹ್ಯಾ ವಿಶಯಾತ್ ಎಜ್ಕೆಲಾನ್ ಮಾಕಾ ಫಿಡೆ ಹೊತಲೊ ವಳಕ್ ಹೊವ್ನ್ ಹಾಯ್. ತೆನಿ ಕರಲ್ಯಾ ಸಾರ್ಕೆ ಸಗ್ಳೆಬಿ ಕರಾ, ಹೆ ಘಡ್ತಾನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮನುನ್ ತುಮ್ಕಾ ಕಳ್ತಾ. <verse eid="EZK 24:24" /><verse number="25" style="v" sid="EZK 24:25" />“ನರ್ ಮಾನ್ಸಾ, ತೆಂಕಾ ತಾಕ್ತಿಚೊ ಆಧಾರ್ ಡೊಳ್ಯಾಚ್ಯಾ ಖುಸಿ ಹೊಲ್ಲ್ಯಾ ತೆಂಚ್ಯಾ ಗುಡಿಕ್ ತೆನಿ ಆಶ್ಯಾ ಕರ್‍ತಲೆ ತೆಂಚಿ ಝಿಲ್ಗೆ ಅನಿ ಚೆಡ್ವಾ ತೆಂಚ್ಯಾ ಬಳೆತ್ನಾ ಕಾಡುನ್ ಟಾಕ್ತಲ್ಯಾ ದಿಸಾ ದಿಸಿ, <verse eid="EZK 24:25" /><verse number="26" style="v" sid="EZK 24:26" />ತ್ಯಾ ದಿಸಾತ್ ಚುಕ್ವುನ್ ಘೆಟಲ್ಲೊ ತುಜೆಕ್ಡೆ ಯೆತಲೊ, ಅನಿ ಘಡಲ್ಲ್ಯಾ ಘಟ್ನಾಂಚಿ ಖಬರ್ ತುಜ್ಯಾ ಕಾನಾತ್ ಪಡ್ತಾ. <verse eid="EZK 24:26" /><verse number="27" style="v" sid="EZK 24:27" />ತ್ಯಾ ದಿಸಾತ್ ಚುಕ್ವುನ್ ಘೆಟಲ್ಯಾಕ್ ಸಾಟ್ನಿ ತುಜೆ ತೊಂಡ್ ಉಗಡ್ತೆ, ತಿಯಾ ಅನಿ ಮುಕ್ಕೊ ರಾಯ್ನಸ್ತಾನಾ ಬೊಲ್ತೆ, ಅನಿ ತೆಂಕಾ ವಳಕ್ ಹೊವ್ನ್ ರಾತಯ್, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳ್ತಾ”.<verse eid="EZK 24:27" /></para>
  <chapter eid="EZK 24" />
  <chapter number="25" style="c" sid="EZK 25" />
  <para style="s">ಅಮ್ಮೊನಾಚ್ಯಾ ವಿರೊಧ್ ಪರ್‍ವಾದನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 25:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಅಸೆ ಸಾಂಗ್ಲ್ಯಾನ್, <verse eid="EZK 25:1" /><verse number="2" style="v" sid="EZK 25:2" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಅಮ್ಮೊನಾಕ್ಡೆ ತೊಂಡ್ ಕರುನ್, ತೆಚ್ಯಾ ವಿಶಯಾತ್ ದೆವಾಚಿ ಇಚ್ಚ್ಯಾ ಪರ್ಗಟ್ ಕರುನ್ಗೆತ್ ಅಸೆ ಸಾಂಗ್, <verse eid="EZK 25:2" /><verse number="3" style="v" sid="EZK 25:3" />ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಖಬರ್ ಆಯ್ಕ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಸಾಂಗ್ತಾ, ಅಮ್ಮೊನಾ, ಮಾಜಿ ಪವಿತ್ರ್ ಗುಡಿ, ಪವಿತ್ರ್ ಹೊವ್ನ್ ಹಾಯ್, ಇಜ್ರಾಯೆಲಾಂಚೆ ಗಾಂವ್ ಪಾಡ್ ಪಡಲ್ಲೆ ಜುದೆವಾಂಚ್ಯಾ ಪಿಳ್ಗಿಚೆ ಗಡಿಪಾರ್ ಹೊಲ್ಲೆ ಬಗುನ್ ಆಹಾ ಮಟ್ಲೆ. <verse eid="EZK 25:3" /><verse number="4" style="v" sid="EZK 25:4" />ತಸೆ ಹೊವ್ನ್ ಅಬಕ್, ಮಿಯಾ ತುಕಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ಹೊತ್ತ್ಯಾಂಚ್ಯಾ ವಾರಿಸ್ದಾರ್ ರಾಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ತೆನಿ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಟಂಬು ಗಾಲುನ್ ಘೆವ್ನ್ ಥೈಚ್ ರ್‍ಹಾತ್ಯಾತ್, ಅನಿ ತುಜಿ ಹನ್ನಾ ಖಾತಾತ್, ಅನಿ ತುಜೆ ದುದ್ದ್ ಫಿತಾತ್, <verse eid="EZK 25:4" /><verse number="5" style="v" sid="EZK 25:5" />ಮಿಯಾ ರಬ್ಬಾ ಶಾರಾಕ್, ಒಂಟಿಯಾಕ್ನಿ ಗೊಟೊ ಕರುನ್ ಅನಿ ಅಮ್ಮೊನ್ ಗಾಂವಾಚ್ಯಾ ಬಕ್ರ್ಯಾಂಚ್ಯಾ ಹಿಂಡಾಕ್ನಿ ಆರಾಮ್ ಕರ್ತಲೊ ಜಾಗೊ ಕರ್ತಾ; ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮನುನ್ ಕಳ್ತಾ. <verse eid="EZK 25:5" /><verse number="6" style="v" sid="EZK 25:6" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ತಿಯಾ ಥಾಪ್ಟಿಯಾ ಮಾರುನ್, ಪಾಯಾನಿ ಜಿಮಿನ್ ಬಡ್ವುನ್, ಇಜ್ರಾಯೆಲ್ ದೆಸಾಕ್ ಪುರಾ ಮನಾನಿ ತಿರಸ್ಕಾರ್ ಕರುನ್, ತೆಕಾ ಗತ್ ಬಗುನ್ ಫುಗ್ಲೆಯ್. <verse eid="EZK 25:6" /><verse number="7" style="v" sid="EZK 25:7" />ತೆಚ್ಯಾ ವಯ್ನಾ, ಮಿಯಾ ತುಜ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕ್ಲುನ್ ಲುಟ್ ಕರುಕ್ ಮನುನ್ ತುಕಾ ದುಶ್ರ್ಯಾ ದೆಶಾಚ್ಯಾ ಅಧಿಕಾರಿಚ್ಯಾ ತಾಬೆತ್ ದಿತಾ, ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ನಿಕ್ಳುನ್, ದೆಶಾಚ್ಯಾಕ್ನಾ ತುಜೆ ನಾವ್ ಪುಸುನ್ ತುಕಾ ಹಾಳ್ ಕರ್ತಾ; ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತುಕಾ ಕಳ್ತಾ.<verse eid="EZK 25:7" /></para>
  <para style="s">ಮೊವಾಬಾಚ್ಯಾ ವಿರೊಧ್ ಪರ್‍ವಾದನ್</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 25:8" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಶೆ ಮನ್ತಾ, ಹೆ, ಜುದೆವಾಂಚ್ಯಾ ಪಿಳ್ಗಿಚೆ ಸಗ್ಳ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಸಾರ್ಕೆಚ್ ಹಾಯ್, ಮನುನ್ ಮೊವಾಬ್ ಅನಿ ಸೆಯಿರಾನ್ ಸಾಂಗುನ್ ಘೆಟ್ಲ್ಯಾನಿ. <verse eid="EZK 25:8" /><verse number="9" style="v" sid="EZK 25:9" />ತಸೆ ಹೊವ್ನ್, ದೆಶಾಚಿ ವಸ್ತಾ ಹೊಲ್ಲ್ಯಾ ಮೊವಾಬಾಚಿ ಘಡ್ ಶಾರಾ ಮಟ್ಲ್ಯಾರ್, ಬೆತ್ ಯೆಶಿಮೊತ್, ಬಾಳ್ಮೆಯೊನ್, ಕಿರ್ಯಾತಯಿಮ್ ಮನ್ತಲಿ ಶಾರಾ, ಹೊತ್ತ್ಯಾಕ್ಡೆ ಮಿಯಾ ಮೊವಾಬಾಚಿ ಘಡ್ ಫೊಡುನ್ ಟಾಕ್ತಾ. <verse eid="EZK 25:9" /><verse number="10" style="v" sid="EZK 25:10" />ತೊ ಗಾಂವ್ ಯೆವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಅಮ್ಮೊನಾಕ್ಬಿ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾತ್ ಹೊತ್ತ್ಯಾಕ್ನಿ ವಾರಿಸ್ದಾರ್ ಹೊವ್ನ್ ದಿವ್ನ್ ಅಮ್ಮೊನಾನಿ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ನಾಶ್ ಹೊವ್ಚೆ ಮನುನ್ ಮಾಜಿ ಆಶ್ಯಾ ಪುರಾ ಕರ್ತಾ. <verse eid="EZK 25:10" /><verse number="11" style="v" sid="EZK 25:11" />ಮೊವಾಬ್ಯಾಕ್ನಿ ಶಿಕ್ಷ್ಯಾ ದಿ ನಸ್ತಾನಾ ಸೊಡಿನಾ, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತೆಂಕಾ ಕಳ್ತಾ.<verse eid="EZK 25:11" /></para>
  <para style="s">ಎದೊಮಾಚ್ಯಾ ವಿರೊಧ್ ಪರ್‍ವಾದನ್</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 25:12" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಶೆ ಮನ್ತಾ, “ಮಿಯಾ ಎದೊಮ್ ಜುದೆವಾಂಚ್ಯಾ ಪಿಳ್ಗಿಕ್ ಶೆಡ್ ಕರಿ ನಸ್ತಾನಾ, ಶೆಡಾಕ್ ಶೆಡ್ ಕರುನ್ ಮೊಟೊ ಪಾಪ್ ಕರ್ಲೊ”, <verse eid="EZK 25:12" /><verse number="13" style="v" sid="EZK 25:13" />ಅಶೆ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರ್ ಅಶೆ ಮನ್ತಾ, ಮಿಯಾ ಎದೊಮಾಚ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕ್ಲುನ್, ತ್ಯಾತುರ್ ಹೊತ್ತ್ಯಾ ಲೊಕಾಕ್ನಿ ಅನಿ ಜನಾವರಾಕ್ನಿ ನಾಶ್ ಕರ್ತಾ. ತೆಮಾನ್ ಶಾರಾಕ್ನಾ ದೆದಾನ್ ಶಾರಾ ಪತರ್ ಹಾಳ್ ಕರುನ್ ಲೊಕಾಕ್ನಿ ತಲ್ವಾರಾಕ್ ಗಾಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 25:13" /><verse number="14" style="v" sid="EZK 25:14" />“ಮಿಯಾ ಎದೊಮಾಕ್ ಮಾಜಿ ಲೊಕಾ ಹೊಲ್ಲ್ಯಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಹಾತಿತ್ನಾ ಶೆಡ್ ಕಾಡುನ್ ಘೆತಾ, ತೆನಿ ಮಾಜ್ಯಾ ರಾಗಾಕ್ನಿ ಸಮಾ ಹೊವ್ನ್ ತೆಕಾ ಕರ್‍ತಾತ್; ಮಾಜೊ ಶೆಡ್ ಎದೊಮಾಚ್ಯಾ ಅನ್ಬೊಗಾಕ್ ಯೆತಾ”, ಹೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್.<verse eid="EZK 25:14" /></para>
  <para style="s">ಪಿಲಿಶ್ಟಿಯಾಚ್ಯಾ ವಿರೊಧ್ ಪರ್‍ವಾದನ್</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 25:15" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಶೆ ಮನ್ತಾ, ಪಿಲಿಸ್ತಿಯಾನಿ ಜುದೆವಾಚ್ಯಾಕ್ನಿ ವಿರೊದ್ದ್ ಕರ್ಲಾತ್, ಹೊಯ್, ಶೆಡಾಕ್ ಶೆಡ್, ಕಾಡುನ್ಗೆವ್ಕ್, ತೆ ಪುರಾ ಮನಾನ್ ತಿರಸ್ಕಾರ್ ಕರಾ, ಲೈ ಎಳ್ ರ್‍ಹಾತಲ್ಯಾ ರಾಗಾನ್ ಹಾಳ್ ಕರ್ಲಾತ್. <verse eid="EZK 25:15" /><verse number="16" style="v" sid="EZK 25:16" />ಅಶೆ ರ್‍ಹಾತಾನಾ, ಸರ್ವೆಸ್ಪರ್ ಅಶೆ ಮನ್ತಾ, ಅಬಕ್, ಮಿಯಾ ಪಿಲಿಸ್ತಿಗಾರಾಂಚ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕಲ್ತಾ, ಕೆರೆತಿಯಾಕ್ನಿ ಕಾಪುನ್ ಟಾಕುನ್, ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆನ್ ಹೊತ್ತ್ಯಾ ಹುರಲ್ಯಾ ಲೊಕಾಕ್ನಿ ನಾಶ್ ಕರುನ್ ಸೊಡ್ತಾ. <verse eid="EZK 25:16" /><verse number="17" style="v" sid="EZK 25:17" />ಸಗ್ಳ್ಯಾಕ್ನಿ ಲೈ ಕರುನ್ ಖಂಡನ್ ಕರುನ್ ಶೆಡಾಕ್ ಶೆಡ್ ಕಾಡ್ತಾ, ಅಸಿ ಪರ್‍ತುನ್ ಜವಾಬ್ ದಿತಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತೆಂಕಾ ಕಳ್ತಾ.<verse eid="EZK 25:17" /></para>
  <chapter eid="EZK 25" />
  <chapter number="26" style="c" sid="EZK 26" />
  <para style="s">ತಿರ್ ಶಾರಾಚ್ಯಾ ವಿರೊಧ್ ಪರ್‍ವಾದನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 26:1" />ಯೆಹೊಯಾಕಿನಾಚ್ಯಾ ಬಂಧಿ ಹೊಲ್ಲ್ಯಾ, ಅಕ್ರಾವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಎಕ್ ಮಯ್ನ್ಯಾಚ್ಯಾ ಪಯ್ಲೆಚ್ಯಾ ದಿಸಿ, ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಹಿ ಗೊಸ್ಟ್ ದಿಲ್ಯಾನ್. <verse eid="EZK 26:1" /><verse number="2" style="v" sid="EZK 26:2" />ನರ್ ಮಾನ್ಸಾ, ತಿರ್ ಅನಿ ಜೆರುಜಲೆಮಾಚ್ಯಾ ವಿಶಯಾತ್, ಆಹಾ, ಲೊಕಾಕ್ನಿ ಅಡ್ಕಳ್ ಹೊವ್ನ್ ಇಬೆ ಹೊತ್ತೆ ದಾರ್ ಮೊಡುನ್ ಗೆಲೆ! ಮಾಜೆಕ್ಡೆ ಪರತಲ್ಲೆ ಜೆರುಜಲೆಮ್ ಹಾಳ್ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಮಿಯಾ ಭರ್ತಾ ಮನುನ್ ಘೆಟಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, <verse eid="EZK 26:2" /><verse number="3" style="v" sid="EZK 26:3" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಅಬಕ್ ತಿರ್ ಶಾರ್, ಮಿಯಾ ತುಕಾ ವಿರೊಧ್ ಹೊಲಾ, ಸಮುಂದರಾಚಿ ಲಾಟಾ ಉಟಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಮಿಯಾ ಲೈ ಲೊಕಾಕ್ನಿ ತುಜ್ಯಾ ವರ್‍ತಿ ಉಟಿ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 26:3" /><verse number="4" style="v" sid="EZK 26:4" />ತೆನಿ ತಿರ್ ಶಾರಾಚಿ ಬಿರಕ್ ಪಡಲ್ಲಿ ಭಿತ್ತಿಯಾ ಪಾಡ್ವುನ್, ತೆಚಿ ಖಿಲ್ಲೊ ಪಾಡ್ವುತಾತ್, ಮಿಯಾ ತೆಚಿ ಮಾಟಿ ಕೆದ್ರುನ್ ಝಾಡುನ್, ಕಾಡುನ್ ತೆಕಾ ಕಾಯ್ಬಿ ನಾ ಕರ್ತಾ. <verse eid="EZK 26:4" /><verse number="5" style="v" sid="EZK 26:5" />ತೆ ಸಮುಂದರಾಚ್ಯಾ ಮದ್ದಿ ಜಾಳ್ಯಾಕ್ನಿ ಘಾಲ್ತಲೊ ಜಾಗೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಹೆ ಮಿಯಾಚ್ ಬೊಲ್ಲಾ, ಮನುನ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಸಾಂಗ್ತಾ, ಲೈ ಲೊಕಾ ಎವ್ನ್ ತುಕಾ ಕಾಯ್ಬಿ ನಾ ಸಾರ್ಕೊ ಕರ್‍ತಾತ್. <verse eid="EZK 26:5" /><verse number="6" style="v" sid="EZK 26:6" />ಮ್ಹಾಳ್ ಜಾಗ್ಯಾ ವಯ್ಲಿ ತೆಚಿ ಗಾಂವಾ ತಲ್ವಾರಿನ್ ಮರ್ತಾತ್, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮನುನ್ ಸಗ್ಳ್ಯಾಕ್ನಿ ಕಳ್ತಾ. <verse eid="EZK 26:6" /><verse number="7" style="v" sid="EZK 26:7" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೆ ಸಾಂಗ್ತಾ, ಅಬಕ್, ರಾಜಾಂಚೊ ರಾಜಾ, ಬಾಬೆಲಾಚೊ ರಾಜಾ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ನೆಬುಕದ್ನೆಚರಾಕ್, ಘೊಡ್ಕೊ, ರಥಾ, ಹಾತ್ತಿ, ಲೊಕಾಂಚೊ ತಾಂಡೊ ಹ್ಯಾ ಸಗ್ಳ್ಯಾನ್ ಭರಲ್ಲೊ ಹೊವ್ನ್, ದಿಸ್ ಉಗವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ತೆಕಾ ತಿರ್ ಶಾರಾ ವರ್‍ತಿ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 26:7" /><verse number="8" style="v" sid="EZK 26:8" />ತೊ ಮ್ಹಾಳ್ ಜಾಗ್ಯಾಚ್ಯಾ ತುಜ್ಯಾ ಗಾಂವಾಕ್ನಿ ತಲ್ವರಾನಿ ಮಾರುನ್, ತುಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಬದು ಘಾಲುನ್ ದಿಬ್ಬ್ ಘಾಲ್ತಾ, <verse eid="EZK 26:8" /><verse number="9" style="v" sid="EZK 26:9" />ಗುರಾನಿ ಉಕಲಲ್ಲ್ಯಾಕ್ನಿ ಧಾಡುನ್ ಅಪ್ನಾಚ್ಯಾ ಭಿತ್ತಿ ಫೊಡ್ತಲೆ ಮೊಟ್ಟ್ಯಾ ನಾಕ್ಡಾಚ್ಯಾ ನಾಟಾನಿ, ತುಜ್ಯಾ ಬಿರ್‍ಕಾ ಫುಟಲ್ಲಿ ಭಿತ್ತಿಯಾಕ್ನಿ ಮಾರುನ್, ಅಪ್ನಾಚ್ಯಾ ತಲ್ವರಾನಿ ತುಜೆ ಖಿಲ್ಲೊ ಫೊಡುನ್ ಟಾಕ್ತಾ. <verse eid="EZK 26:9" /><verse number="10" style="v" sid="EZK 26:10" />ತೆಜ್ಯಾ ಮ್ಹೆಜುಕ್ ಹೊಯ್ನಾ ತವ್ಡ್ಯಾ ಘೊಡ್ಕಿಯಾನಿ ಉಟಲ್ಲಿ ಧುಳ್ ತುಕಾ ಧಾಪ್ತಾ, ಬಿರಕ್ ಯೆಲ್ಲ್ಯಾ ಖಿಲ್ಲೆತ್ನಿತ್ ವಿರೊಧಿ ಗುಸಲ್ಯಾ ಸಾರ್ಕೆ ತೊ ತುಜ್ಯಾ ದಾರಾತ್ನಿ ಗುಸ್ತಾನಾ, ಘೊಡ್ಕಿಯಾ ಪಳ್ತಲೆ, ಬಯ್ಲ್ ಗಾಡಿಯಾ, ರಥಾ ಹೆಂಚ್ಯಾ ಆವಾಜಾಕ್ ತುಜಿ ಭಿತ್ತಿಯಾ ಹಾಲ್ತಾತ್. <verse eid="EZK 26:10" /><verse number="11" style="v" sid="EZK 26:11" />ತೊ ಅಪ್ನಾಚ್ಯಾ ಘೊಡ್ಕಿಯಾಂಚ್ಯಾ ಕಟ್ಕೆ ತುಜಿ ವಾಟಾ ತುಡ್ವುಕ್ ಲಾವ್ನ್, ತಲ್ವಾರಾನಿ ತುಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಮಾರುನ್, ತುಜೆ ಘಟ್ ಇಬೆ ಹೊತ್ತೆ ಖಾಂಬೆ ಪಾಡ್ವುತಾ. <verse eid="EZK 26:11" /><verse number="12" style="v" sid="EZK 26:12" />ತೆಚಿ ಸಯ್ನಿಕಾ ತುಜಿ ಆಸ್ತಿ ಲುಟುನ್ ಕಾಡುನ್ಗೆವ್ನ್, ತುಜಿ ಸಾಮಾನಾ ಖಬ್ಜಾ ಕರುನ್ಗೆತ್, ತುಜಿ ಭಿತ್ತಿಯಾ ಪಾಡ್ವುನ್, ತುಜಿ ಸುಂದರ್ ಹೊತ್ತಿ ಘರಾ ಪಾಡ್ವುನ್, ತುಜಿ ಮಾಟಿ, ಗುಂಡೆ, ಝಾಡಾ ಸಗ್ಳೆ ಸಮುಂದರಾಚೊ ವಾಟೊ ಕರ್‍ತಾತ್. <verse eid="EZK 26:12" /><verse number="13" style="v" sid="EZK 26:13" />ಮಿಯಾ ತುಜ್ಯಾ ಗಿತಾಂಚೊ ಧನ್ ಇಬೆ ಕರ್ತಾ, ತುಜ್ಯಾ ವಿನೆಚಿ ಧನ್ ಆಯ್ಕಿನಾ. <verse eid="EZK 26:13" /><verse number="14" style="v" sid="EZK 26:14" />ಮಿಯಾ ತುಕಾ ಬೊಳ್ ಗುಂಡಾ ಸಾರ್ಕೆ ಕರ್ತಾ, ತಿಯಾ ಜಾಳ್ಯಾಕ್ನಿ ಹಾತರಲ್ಲೊ ಗುಂಡೊ ಹೊತೆಯ್, ತುಜ್ಯಾ ವರ್‍ತಿ ಅನಿ ಘರ್ ಭಾಂದಿನಾತ್, ಸರ್ವೆಸ್ಪರ್ ಮಿಯಾಚ್ ಬೊಲುಲ್ಲಾ, ಹಿ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ. <verse eid="EZK 26:14" /><verse number="15" style="v" sid="EZK 26:15" />ಸರ್ವೆಸ್ಪರ್ ತಿರ್ ಶಾರಾಕ್ ಅಸೊ ಸಾಂಗ್ತಾ, ತುಜ್ಯಾ ಮದ್ದಿ ಖುನ್ ಹೊವ್ನ್ ಘಾವ್ ಹೊಲ್ಲಿ ಲೊಕಾ ನರ್ಳುನ್ಗೆತ್ ರ್‍ಹಾತಾನಾ, ತಿಯಾ ಡಬ್ಬ್ ಪಡ್ತಲ್ಯಾ ನಾದಾಕ್ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆಕ್ ರಾತಲಿ ಘರಾ ಹಾದರ್ತಾತ್ ನ್ಹಯ್. <verse eid="EZK 26:15" /><verse number="16" style="v" sid="EZK 26:16" />ತನ್ನಾ ಸಮುಂದರಾಚ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತಿ ಸಗ್ಳೆ ರಾಜಾ, ಅಪ್ನಾಚ್ಯಾ ಸಿಂವಾಸನಾಂಚ್ಯಾ ವಯ್ನಾ ಉತ್ರುನ್, ಝಗೆ ಕಾಡುನ್ ಟಾಕುನ್, ಹಾತಿನ್ ಸಿವಲ್ಲೆ ಕಪ್ಡೆ ಕಾಡುನ್ ಟಾಕುನ್, ಥರ್ಥರೊ ಕಾಂಬ್ರುನ್ ಘೆವ್ನ್, ಜಿಮ್ನಿ ವರ್‍ತಿ ಬಸುನ್ ಹರ್ ಎಕ್ ಎಳಾರ್ಬಿ ಭಿಂವ್ನ್, ಥರ್ಥರುನ್ಗೆತ್ ತುಕಾ ಭಿಂವ್ನ್ ರ್‍ಹಾತ್ಯಾತ್. <verse eid="EZK 26:16" /><verse number="17" style="v" sid="EZK 26:17" />ಹೆನಿ ತುಜ್ಯಾ ವಿಶಯಾತ್, ವಿಪ್ಳಾಪ್ ದಾಕ್ವುನ್, ಢೊನ್ ಚಾಲ್ವುತಲ್ಯಾಂಚ್ಯಾ ಘರಾ, ನಾವ್ ಘೆಟಲ್ಯಾ ಗಾಂವಾ, ಸಮುಂದರಾಕ್ನಾ ಬಳ್ ಘೆಟಲ್ಲ್ಯಾ ಶಾರಾ, ತಿಯಾ ಲೈ ಹಾಳ್ ಹೊಲೆಯ್, ಸಮುಂದರಾತ್ ಫಿರ್ತಲಿ ಲೊಕಾ ಭಿಂಯಾನ್ ಭರಲ್ಲಿ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ, ತುಜಿ ಲೊಕಾ ಲೈ ಹಾಳ್ ಹೊಲಿ. <verse eid="EZK 26:17" /><verse number="18" style="v" sid="EZK 26:18" />ಹ್ಯಾ ತುಜ್ಯಾ ಹಾಳ್ ಹೊತಲ್ಯಾ ದಿಸಾತ್, ಸಮುಂದರಾಚಿ ದಂಡ್ ಹಾಲ್ತಾ, ತಿಯಾ ನಾ ಹೊವ್ನ್ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆ ವಯ್ಲಿ ಗಾಂವಾ ಕಡ್ಕಡ್ತಾತ್, ಮನ್ತಲಿ ವಿಪ್ಳಾಪಾಚಿ ಗಿತ್ ಆಯಿಕ್ತಾ. <verse eid="EZK 26:18" /><verse number="19" style="v" sid="EZK 26:19" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಮಿಯಾ ತುಕಾ ಹಾಳ್ ಗಾಂವ್ ಕರುನ್ ಮಾನ್ಸಾ ನತ್ತ್ಯಾ ಶಾರಾಂಚ್ಯಾ ಗತಿಕ್ ಹಾನುನ್, ತಿಯಾ ಪಾನಿಯಾತ್ನಿ ಬುಡುನ್ ಜಾಯ್ ಸಾರ್ಕೆ ತುಜ್ಯಾ ವರ್‍ತಿ ಮೊಟೆ ಸಮುಂದರ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ, <verse eid="EZK 26:19" /><verse number="20" style="v" sid="EZK 26:20" />ಜುನ್ನ್ಯಾ ಕಾಳಾತ್ ಹಾಳ್ ಹೊಲ್ಲ್ಯಾ ಶಾರಾಂಚ್ಯಾ ಸಾರ್ಕೆ ತುಕಾ ಲೈ ಪಾತಾಳಾಕ್ ಡಕ್ಳುನ್ ಉತರಲ್ಲ್ಯಾ ಅದ್ಲ್ಯಾ ಯೆಳಾಚ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ವಸ್ತಿ ರ್‍ಹಾತಾ, ಹೊಯ್ ತಿಯಾ ತುಜಿ ಮಹಿಮಾ ಜಿವಾಚ್ಯಾ ಲೊಕಾತ್ ಇಬೆ ಕರಿನಸ್ತಾನಾ, ಲೊಕಾಚ್ ನಾತ್ ಸಾರ್ಕೆ ತುಕಾ ಪಾತಾಳಾಕ್ ಉತರಲ್ಲ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳ್ವುತಾ. <verse eid="EZK 26:20" /><verse number="21" style="v" sid="EZK 26:21" />ತುಕಾ ಲೈ ನಾಶ್ ಕರ್ತಾ, ತಿಯಾ ನಾ ಹೊತೆಯ್, ಕವ್ಡೆ ಹುಡಕ್ಲ್ಯಾರ್ಬಿ ತಿಯಾ ಕನ್ನಾಬಿ ಗಾವಿ ನ್ಹಯ್, ಹೆ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 26:21" /></para>
  <chapter eid="EZK 26" />
  <chapter number="27" style="c" sid="EZK 27" />
  <para style="s">ತಿರ್ ಶಾರಾ ಸಾಟ್ನಿ ದುಕ್ಕೆಚಿ ಗಿತ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 27:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಅನಿ ಎಕ್ ವಚನ್ ದಿಲ್ಯಾನ್, <verse eid="EZK 27:1" /><verse number="2" style="v" sid="EZK 27:2" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ತುರಿಚ್ಯಾ ವಿಶಯಾತ್ ದುಕ್ಕಾಚಿ ಗಿತ್ ಸಾಂಗ್, ತೆಜ್ಯಾ ಸಾಟ್ನಿ ಅಸೆ ಸಾಂಗ್. <verse eid="EZK 27:2" /><verse number="3" style="v" sid="EZK 27:3" />ಸಮುಂದರಾಚ್ಯಾ ವಾಟೆವರ್‍ತಿ ವಸ್ತಿ ರ್‍ಹಾವ್ನ್ ಗೆತ್, ಲೊಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಲೈ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆ ವಯ್ಲ್ಯಾ ಗಾಂವಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಯಾಪಾರ್ ಕರ್‍ತಲ್ಯಾ ಪುರಿ! ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ತಿರ್ ಶಾರ್ ಸಗ್ಳ್ಯಾ ನಮುನಿ ಸುಂದರ್ ಹೊವ್ನ್ ಹಾಯ್ ಮನುನ್ ಘೆಟ್ಲೆಯ್ ನ್ಹಯ್! <verse eid="EZK 27:3" /><verse number="4" style="v" sid="EZK 27:4" />ತುಜೊ ವಸ್ತಿ ರಾತಲೊ ಜಾಗೊ ಸಮುಂದರಾಚ್ಯಾ ಮದ್ದಿಚ್, ತುಕಾ ಭಾಂದಲ್ಯಾನಿ ತುಜೆ ಸುಂದರ್ ಪಾನ್ ಫುರಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="EZK 27:4" /><verse number="5" style="v" sid="EZK 27:5" />ಸೆನಿರಾಚ್ಯಾ ತುರಾಯಿ ಝಾಡಾಕ್ನಾ ತುಜ್ಯಾ ಭಾಜುಚಿ ಫಳಿಯಾ ಕರುನ್, ತುಜೊ ಖಾಂಬೊ ರಚನ್ ಕರುಕ್ ಲೆಬೊನಿಕ್ನಾ ದೆವದಾರು ಝಾಡಾ ಹಾನ್ಲ್ಯಾನಿ. <verse eid="EZK 27:5" /><verse number="6" style="v" sid="EZK 27:6" />ಬಾಶಾನಿಚ್ಯಾ ಅಲ್ಲೊನ್ ಝಾಡಾಕ್ನಾ ತುಜಿ ಉಪಾಜಾ ತಯಾರ್ ಕರುನ್, ಕಿತ್ತಿಮ್ ದ್ವಿಪಾಚ್ಯಾ ತಿಲಕಾಚ್ಯಾ ಫಳಿನ್ ತುಜೊ ವಯ್ಲೊ ಮ್ಹಾಳೊ ಭಾಂದುನ್, ದಾತಾನಿ ಕೆತ್ತನೆ ಕರ್ಲ್ಯಾನಿ. <verse eid="EZK 27:6" /><verse number="7" style="v" sid="EZK 27:7" />ತುಜಿ ಹಾಯಿ ತುಕಾ ಝಂಡೊ ಹೊಂವ್ದಿತ್ ಮನುನ್, ತೆ ತೆನಿ ಇಜಿಪ್ತಾಚ್ಯಾ ಹಾತಿನ್ ಸಿಂವಲ್ಲ್ಯಾ ಬರ್ಯಾ ಕಪ್ಡ್ಯಾನಿ ಕರ್ಲ್ಯಾನಿ, ತುಜಿ ವಯ್ಲಿ ಕಟ್ಟ್ ಎಲಿಶಾಚ್ಯಾ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆಚ್ಯಾ ನಿಳೊ ಅನಿ ಝಾಂಬ್ಳೊ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾನಿ ಚಿತ್ತರ್ ಕಾಡಲ್ಲೆ ಹೊತ್ತೆ. <verse eid="EZK 27:7" /><verse number="8" style="v" sid="EZK 27:8" />ಚಿದೊನಿಚಿ ಲೊಕಾ ಅನಿ ಅರ್ವಾದಾಚಿ ಲೊಕಾ, ತುಕಾ ಹುಟ್ಟ್ ಘಾಲುಕ್ ಕಾರನ್ ಹೊತಾತ್. ತಿರ್ ಶಾರಾ ತುಜ್ಯಾಕಲ್ಲಿ ಬುದ್ವಂತ್ ಮಾನ್ಸಾ ತುಜಿ ಢೊನ್ ಚಾಲ್ವುತಾತ್, <verse eid="EZK 27:8" /><verse number="9" style="v" sid="EZK 27:9" />ತುಜ್ಯಾಕ್ಡೆ ಮಿಳಲ್ಲಿ ಗೆಬೆಲಿಚಿ ಜಾಂನ್ತಿ ಲೊಕಾ ಅನಿ ಬುದ್ವಂತಾ, ತುಜಿ ಬಿರ್‍ಕಾ ಧಾಪ್ಲಾತ್.</para>
  <para style="p" vid="EZK 27:9">ಸಮುಂದರಾಚಿ ಸಗ್ಳಿ ಢೊನಾ ಚಾಲ್ವುತಲ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ, ತುಜ್ಯಾಕ್ಡೆ ರ್‍ಹಾವ್ನ್ ತುಕಾ ಸಾಮಾನಾ ಹಾನುನ್ ದಿಯ್ತ್.<verse eid="EZK 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 27:10" />ಪಾರ್ಸಿಯಾ, ಲುದ್ ಅನಿ ಪುಟ್ಯಾ, ಸಯ್ನ್ಯಾಚಿ ಚಾಲ್ವುತಲಿ ಅಧಿಕಾರಿಯಾ ಹೊವ್ನ್ ತುಜ್ಯಾ ಸಯ್ನ್ಯಾತ್ ಹೊತ್ತೆ, ಗುರಾನಿ ಅನಿ ಟಕ್ಲ್ಯಾಚಿ ರಾಕ್ವನಿಚಿ ಆಧಾರಾ ತುಜ್ಯಾಕ್ಡೆ ಲೊಂಬಾತ್ ಘಾಲುನ್ ತುಕಾ ಭೊಶನ್ ಕರಲ್ಲ್ಯಾನಿ. <verse eid="EZK 27:10" /><verse number="11" style="v" sid="EZK 27:11" />ಅರ್ವಾದಿಚಿ ಅನಿ ಹೆಲೆಕ್ಸಾಚಿ ಲೊಕಾ ಅನಿ ತುಜಿ ಸಯ್ನಿಕಾ ವಾಂಗ್ಡಾ ಭೊತ್ಯಾನಿ ತುಜ್ಯಾ ಭಿತ್ತಿಯಾತ್ನಿ ಇಬೆ ಹೊತ್ತ್ಯಾನಿ, ಗಮ್ಮಾದ್ಯಾಚಿ ಲೊಕಾ ತುಜ್ಯಾ ಮ್ಹಾಳ್ಯಾರ್ನಿ ರಾಕ್ವಲಿ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾನಿ, ಸಗ್ಳ್ಯಾನಿ ಅಪ್ನಾಚಿ ಗುರಾನಿಯಾ ಭೊತ್ಯಾನಿ ತುಜ್ಯಾ ಭಿತ್ತಿಯಾಕ್ನಿ ಲೊಂಬಾತ್ ಘಾಲುನ್, ತುಜೆ ಸುಂದರ್ ಪಾನ್ ಫುರಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="EZK 27:11" /><verse number="12" style="v" sid="EZK 27:12" />ಲೈ ದುಶ್ರ್ಯಾ ದುಶ್ರ್ಯಾ ನಮುನ್ಯಾಚಿ ಆಸ್ತಿ ಅನಿ ತುಕಾ ಪಾಜೆ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ತಾರ್ಶಿಸಿಚಿ ಲೊಕಾ ತುಜ್ಯಾ ಭಾಜುಕ್ಲಿ ಯಾವಾರ್ ಕರ್ತಲಿ ಲೊಕಾ ಹೊವ್ನ್ ಚಾಂದಿ, ಲೊಂಗಾಟ್ ಅನಿ ಪಿತ್ತಳ್ ಅನಿ ಸಿಸಾ ತುಕಾ ದಿಲ್ಯಾನಿ.<verse eid="EZK 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 27:13" />ಜಾವಾನಿಚಿ ಲೊಕಾ ಅನಿ ತುಬಾನಿಚಿ ಲೊಕಾ, ಮೆಶೆಕಿಚಿ ಲೊಕಾ ತುಜ್ಯಾ ಭಾಜುಕ್ನಾ ಯಾಪಾರ್ ಕರುನ್, ನರ್ ಮಾನ್ಸಾ, ಜನಾವರಾ ಅನಿ ತಾಂಬ್ಯಾಚಿ ಆಯ್ದಾನಾ ತುಕಾ ದಿಲ್ಯಾನಿ. <verse eid="EZK 27:13" /><verse number="14" style="v" sid="EZK 27:14" />ಬೆತ್ತ್ ತೊಗರ್ಮ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ, ಘೊಡ್ಕೊ, ಅನಿ ಝಗ್ಡ್ಯಾಕ್ ಪಾಜೆ ಹೊಲ್ಲೆ ಘೊಡ್ಕೊ, ವಜ್ಜೆ ವಾವ್ತಲೆ ಕಚ್ಚಡ್ ಗದ್ದೊ ಹೆ ಸಗ್ಳೆ ತುಜ್ಯಾ ಸಾಟ್ನಿ ಹಾನ್ಲ್ಯಾನಿ. <verse eid="EZK 27:14" /><verse number="15" style="v" sid="EZK 27:15" />ರೊದಾನಿಚಿ ಲೊಕಾ ಯಾಪಾರ್ ಕರ್ಲೆ ಹೊವನ್ ಹೊತ್ತೆ, ಲೈ ದ್ವಿಪಾ ತುಜ್ಯಾ ಹಾತಿಚ್ಯಾ ಖಾಲ್ತಿ ಯಾಪಾರ್ ಕರ್ಲ್ಯಾನಿ ಹಾತ್ತಿಯಾಚಿ ದಾತಾ ಅನಿ ಕಾಳಿ ಝಾಡಾ ತುಕಾ ವಾಟೊ ಹೊವ್ನ್ ದಿಲ್ಯಾನಿ. <verse eid="EZK 27:15" /><verse number="16" style="v" sid="EZK 27:16" />ತುಜ್ಯಾ ಕಾಮಾಚಿ ಸಾಮಾನಾ ಲೈ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ಆರಾಮಿಚ್ಯಾ ಲೊಕಾನಿ ತುಜೆ ಹೊವ್ನ್ ಯಾಪಾರ್ ಕರುನ್, ತಾಂಬ್ಡೆ ರಗ್ತಾಂಬರ್, ಹಾತಿಚ್ಯಾ ಕಾಮಾಚೆ ಕಪ್ಡೆ, ಕಿಮ್ತಿಚೊ ಫೊಡೊ, ಮಾನಿಕ್ಯ್, ಲೈ ನಮುನ್ಯಾಚಿ ಸಾಮಾನಾ ತುಕಾ ಹಾನುನ್ ವೊತ್ಲ್ಯಾನಿ. <verse eid="EZK 27:16" /><verse number="17" style="v" sid="EZK 27:17" />ಜುದೆವಾ ಇಜ್ರಾಯೆಲ್ ದೆಶಾಚೆ ತುಜ್ಯಾ ಭಾಜುಕ್ಲಿ ಯಾಪಾರ್ ಕಾರಾ ಹೊವ್ನ್, ಮಿನ್ನಿಥಿಚಿ ಲೊಕಾ ಘಂವ್, ಸಾಕಾರ್, ಮ್ಹಾಂವ್, ತೆಲ್ ಅನಿ ಬರ್ಯಾ ವಾಸೆಚೆ ತೆಲ್ ಹಿ ಸಗ್ಳಿ ಸಾಮಾನಾ ತುಕಾ ದಿಲ್ಯಾನಿ. <verse eid="EZK 27:17" /><verse number="18" style="v" sid="EZK 27:18" />ತುಜ್ಯಾ ಹಾತಿಚ್ಯಾ ಕಾಮಾಚಿ ಸಾಮಾನಾ, ತುಜ್ಯಾಕ್ಡೆ ಲೈ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಅನಿ ಲೈ ನಮುನ್ಯಾಚಿ ಮೆಜುಕ್ ಹೊಯ್ನಾ ತವ್ಡಿ ಆಸ್ತಿ ತುಕಾ ಪಾಜೆ ಹೊಲ್ಲಿ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ದಮಸ್ಕಾಚ್ಯಾನಿಬಿ ತುಜ್ಯಾ ಸಾಟ್ನಿ ಯಾಪಾರ್ ಕರುನ್, ಹೆಲ್ಬೊನಿಚೊ ವಾಯ್ನ್ ಅನಿ ಚಾಹರಿಚಿ ಬಕ್ರ್ಯಾಚಿ ಕೆಸಾ ತುಜ್ಯಾಕ್ಡೆ ಹಾನುನ್ ಭರ್‍ಲ್ಯಾನಿ. <verse eid="EZK 27:18" /><verse number="19" style="v" sid="EZK 27:19" />ವೆದಾನಿಚ್ಯಾನಿ ಅನಿ ರಥ್ ಸವಾರ್ ಕರ್‍ತಲ್ಯಾಕ್ನಿ ತೆಂಕಾ ಬರಿ ದಿಸ್ತಲಿ ಕಪ್ಡೆ ಘೆವ್ನ್ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಯಾಪಾರ್ ಕರಿತ್ ಹೊತ್ತ್ಯಾನಿ. <verse eid="EZK 27:19" /><verse number="20" style="v" sid="EZK 27:20" />ದೆದಾನಿಚಿ ಲೊಕಾ ಅನಿ ಯಾವಾನಾಚೆ, ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಕಪ್ಡ್ಯಾಂಚೆ ಯಾವಾರ್ ಕರ್‍ತಾತ್. <verse eid="EZK 27:20" /><verse number="21" style="v" sid="EZK 27:21" />ಅರಾಬಿಚಿ ಲೊಕಾ ಅನಿ ಕೆದಾರಿಚಿ ಜಾಂನ್ತಿ ಲೊಕಾ ತುಜ್ಯಾ ಖಾಲ್ತಿ ಕಾಮ್ ಕರ್ತಲಿ ಖಬರ್ ಸಾಂಗ್ತಲಿ ಲೊಕಾ, ಬೊಕ್ಡಾ, ಟಗ್ರಾ, ಶೆಳಿ ಅನಿ ಬಯ್ಲಾ ತುಜ್ಯಾ ಸಾಟ್ನಿ ಹಾಂಬ್ಡುನ್ ಹಾನ್ಲ್ಯಾನಿ. <verse eid="EZK 27:21" /><verse number="22" style="v" sid="EZK 27:22" />ಶೆಬಾಚಿ ಅನಿ ರಗ್ಮಾಚಿ ಲೊಕಾ ತುಜ್ಯಾ ಭಾಜುಕ್ಲೆ ಯಾಪಾರಿ ಹೊವ್ನ್ ಕಾನಿಕ್ ಅನಿ ಮುಖ್ಯ್ ಬರ್ಯಾ ವಾಸೆಚಿ ತೆಲಾ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಕಿಮ್ತಿಚೆ ಗುಂಡೆ, ಹಿ ಸಗ್ಳಿ ತುಜ್ಯಾ ಸಾಟ್ನಿ ಹಾನ್ಲ್ಯಾನಿ. <verse eid="EZK 27:22" /><verse number="23" style="v" sid="EZK 27:23" />ಹಾರಾನ್ ದಾಂಡ್ಗೆ ಚೆಡು, ಎದೆನ್ ಜಾಗ್ಯಾಂಚ್ಯಾ ವಯ್ಲಿ ಲೊಕಾ ಶೆಬಾ ಅಸ್ಸಿರಿಯಾ, ಕಿಲ್ಮತ್ ಪ್ರಾಂತ್ಯಾಂಚಿ ತುಜಿ ಯಾಪಾರಿ ಲೊಕಾ ಹೊವ್ನ್, <verse eid="EZK 27:23" /><verse number="24" style="v" sid="EZK 27:24" />ತುಜಿ ಯಾಪಾರಿ ಲೊಕಾ ಹೊವ್ನ್, ಬರ್ಯಾ ಹಾತಿಚ್ಯಾ ಕಾಮಾಚಿ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚೊ ಝಗೊ ಲೈ ನಮುನ್ಯಾಚಿ ಸಾಮಾನಾ ಅನಿ ದೊರಿಯಾನಿ ಘಟ್ ಭಾಂದಲ್ಲ್ಯಾ ಚಮತ್ಕಾರಾಚ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ಕಪ್ಡ್ಯಾಂಚಿ ಗಾಟಿಯಾ ತುಕಾ ಧಾಡ್ಲ್ಯಾನಿ. <verse eid="EZK 27:24" /><verse number="25" style="v" sid="EZK 27:25" />ತಾರ್ಶಿಸಿಚಿ ಢೊನಾ ಸಾಲಾನ್ ತುಕಾ ಪಾಜೆ ಹೊಲ್ಲಿ ಸಾಮಾನಾ ಘೆವ್ನ್ ಯೆಲ್ಯಾನಿ, ತಿಯಾ ಲೈ ಭರುನ್ ಸಮುಂದರಾತ್ ಲೈ ವಜ್ಜೊ ಹೊಲೈ, <verse eid="EZK 27:25" /><verse number="26" style="v" sid="EZK 27:26" />ಢೊನ್ ಚಾಲ್ವುತಲ್ಯಾನಿ ತುಕಾ ಮೊಟ್ಟ್ಯಾ ಲಾಟಾಕ್ನಿ ಸಿರ್ಕುನ್ ಘಾಟ್ಲಾತ್, ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ವಾರ್ಯಾನ್ ತುಕಾ ಮೊಟ್ಟ್ಯಾ ಸಮುಂದರಾಚ್ಯಾ ಮದ್ದಿ ಫೊಡುನ್ ಟಾಕ್ಲಾ. <verse eid="EZK 27:26" /><verse number="27" style="v" sid="EZK 27:27" />ತುಜಿ ಆಸ್ತಿ, ತುಜಿ ಸಾಮಾನಾ, ತುಜಿ ವಸ್ತಾ, ತುಜಿ ಢೊನ್ ಚಾಲ್ವುತಲಿ ಲೊಕಾ, ತುಜಿ ಮಾಸೊಳಿಯಾ ಧರ್ತಲಿ ಲೊಕಾ, ತುಜಿ ವಡ್ಕಾ ಘಟ್ ಕರ್ತಲಿ ಲೊಕಾ, ತುಜಿ ಯಾಪಾರಾಚಿ ಲೊಕಾ ಅನಿ ತುಜ್ಯಾಕ್ಲಿ ಸಗ್ಳಿ ಸಯ್ನಿಕಾ ಒಟ್ಟು ತುಜ್ಯಾಕ್ಡೆ ಹೊತ್ತಿ ತುಜಿ ಸಗ್ಳಿ ಲೊಕಾ ತುಜ್ಯಾ ನಾಶ್ ಹೊತಲ್ಯಾ ದಿಸಾತ್ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಸಮುಂದರಾಚ್ಯಾ ಪೊಟಾತ್ ಬುಡುನ್ ಜಾತಾತ್. <verse eid="EZK 27:27" /><verse number="28" style="v" sid="EZK 27:28" />ತುಜ್ಯಾ ಢೊನ್ ಚಾಲ್ವುತಲ್ಯಾಂಚ್ಯಾ ಬೊಬೆಕ್ ಸಗ್ಳಿ ಗಾಂವಾ ಥರ್ಥರ್ತಾತ್. <verse eid="EZK 27:28" /><verse number="29" style="v" sid="EZK 27:29" />ಢೊನ್ ಚಾಲ್ವುತಲೆ ಸಗ್ಳೆ ಅನಿ ಮಾಸೊಳಿಯಾ ಧರ್ತಲೆ ಸಮುಂದರಾತ್ಲೆ ಸಗ್ಳೆ ಢೊನ್ ಚಾಲ್ವುನಾರೆ, ಅಪಪ್ಲ್ಯಾ ಢೊನಾಂತ್ನಾ ಉತ್ರುನ್ ದಂಡೆಚ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಇಬೆ ರ್‍ಹಾವ್ನ್, <verse eid="EZK 27:29" /><verse number="30" style="v" sid="EZK 27:30" />ತುಜ್ಯಾ ಸಾಟ್ನಿ ಧನ್ ಕಾಡುನ್ ದುಕ್ಕಾನ್ ರಡುನ್, ಅಪ್ನಾಚೆ ದುಕ್ಕ್ ದಾಕ್ವುಕ್ ಸಾಟ್ನಿ, ಟಕ್ಲ್ಯಾಕ್ನಿ ಧುಳ್ ಸಿಪ್ಡುನ್ ಘೆವ್ನ್, ರಕ್ಕಾತ್ನಿ ಪಡುನ್ ಲೊಳುನ್, <verse eid="EZK 27:30" /><verse number="31" style="v" sid="EZK 27:31" />ತುಜ್ಯಾ ಸಾಟ್ನಿ ಟಕ್ಲೆ ಬೊಳ್ ಕರುನ್ಗೆವ್ನ್, ಚಿಲಾಚೆ ಫಟೆ ಲಪ್ಟುನ್ ಘೆವ್ನ್, ಮನಾತ್ ಲೈ ದುಕ್ಕಾನ್ ಅಳಾಪ್ ಕರುನ್, ಮನಾತ್ ದುಕ್ಕಾನ್ ಗೊಳಾಟ್ ಕರುನ್ ತುಜ್ಯಾ ಸಾಟ್ನಿ ಉಸ್ಕಾ ಉಸ್ಕಾರುನ್ ರಡ್ತಾತ್. <verse eid="EZK 27:31" /><verse number="32" style="v" sid="EZK 27:32" />ತೆನಿ ರಡುನ್ಗೆತ್, ತುಜ್ಯಾ ವಿಶಯಾತ್ ದುಕ್ಕಾಚಿ ಗಿತ್ ಸಾಂಗುನ್ಗೆತ್, ಅಸೆ ಸಾಂಗ್ತಾತ್, ಸಮುಂದರಾಚ್ಯಾ ಮದ್ದಿ ಕೊನ್ಬಿ ನಾತ್ ಮನ್ತಲ್ಯಾ ಖಲ್ಯಾ ಶಾರಾಕ್ ಸಮಾ? <verse eid="EZK 27:32" /><verse number="33" style="v" sid="EZK 27:33" />ತುಜಿ ಸಾಮಾನಾ ಸಮುಂದರಾಕ್ನಿ ದಾಟುನ್ ಪಗ್ಳುನ್ ಹಾಯ್, ತೆಂಚ್ಯಾಕ್ನಾ ಲೈ ಲೊಕಾಕ್ನಿ ಭರ್ಲೆಯ್, ತುಜ್ಯಾ ಲೈ ಸಾವ್ಕಾರ್‍ಕಿನ್ ಅನಿ ಯಾಪಾರಾಚ್ಯಾ ಸಾಮಾನಾನಿ ಜಿಮ್ನಿ ವಯ್ಲ್ಯಾ ರಾಜಾಕ್ನಿ ಭರ್ಪುರ್ ಕರ್ಲ್ಯಾಸಿ. <verse eid="EZK 27:33" /><verse number="34" style="v" sid="EZK 27:34" />ಅತ್ತಾತರ್ ತಿಯಾ ಸಮುಂದರಾಕ್ನಾ ಹಾಳ್ ಹೊಲೈ, ತುಜಿ ಸಾಮಾನಾ ತುಜ್ಯಾಕ್ಡೆ ಮಿಳಲ್ಲಿ ಸಗ್ಳಿ ಲೊಕಾ ಲೈ ಖೊಲ್ ಪಾನಿಯಾತ್ ಬುಡುನ್ ಗೆಲಿ. <verse eid="EZK 27:34" /><verse number="35" style="v" sid="EZK 27:35" />ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆಚಿ ಸಗ್ಳಿ ಲೊಕಾ ತುಜ್ಯಾ ಹ್ಯಾ ಗತಿ ಸಾಟ್ನಿ ಭಿಂವ್ಲಾತ್, ರಾಜಾ ಭಿಂವ್ನ್ ಥರ್ಥರುಲಾತ್. <verse eid="EZK 27:35" /><verse number="36" style="v" sid="EZK 27:36" />ಲೊಕಾಂಚಿ ಯಾಪಾರಿಯಾ ತುಕಾ ಬಗುನ್ ಹಾಸ್ತಾತ್, ತಿಯಾ ಲೈ ಹಾಳ್ ಹೊವ್ನ್ ಅನಿ ಕನ್ನಾಬಿ ನಾ ಸಾರ್ಕೊ ಹೊಲೈ.<verse eid="EZK 27:36" /></para>
  <chapter eid="EZK 27" />
  <chapter number="28" style="c" sid="EZK 28" />
  <para style="s">ತಿರ್ ಶಾರಾಚ್ಯಾ ರಾಜಾಚ್ಯಾ ವಿರೊಧ್ ಪರ್‍ವಾದನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 28:1" />ಮಾಕಾ ಸರ್ವೆಸ್ಪರಾನ್ ಅನಿ ಎಗ್ದಾ ಬೊಲ್ಲ್ಯಾನ್, <verse eid="EZK 28:1" /><verse number="2" style="v" sid="EZK 28:2" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ತಿರ್ ಶಾರಾಚ್ಯಾ ರಾಜಾಕ್ ಅಸೆ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ತಿಯಾ ಘರುಕಿಚ್ಯಾ ಮನಾಚೊ ಹೊವ್ನ್, ಅಹಾ, ಮಿಯಾಚ್ ದೆವ್, ಸಮುಂದರಾಚ್ಯಾ ಮದ್ದಿ ದೆವಾಚೆ ಸಿಂವಾಸನುಚ್ ಚಡ್ಲಾ ಮನುನ್ ಘೆಟ್ಲೆಯ್ ತವ್ಡೆಚ್, ತಿಯಾ ತುಜ್ಯಾ ಮನಾಕ್ ದೆವಾಚ್ಯಾ ಮನಾ ತವ್ಡೆ ಲೈ ಪಾನ್ ಕರುನ್ ಘೆಟಲ್ಲೆ ಕಶ್ಯಾಕ್? ತಿಯಾ ಕನ್ನಾಬಿ ದೆವ್ ನ್ಹಯ್, ತಿಯಾ ಮಾನುಸುಚ್. <verse eid="EZK 28:2" /><verse number="3" style="v" sid="EZK 28:3" />ತಿಯಾ ದಾನಿಯೆಲಾಕಿಂತಾಬಿ ಬುದ್ವಂತ್ ಕಾಯ್? ತುಕಾ ದಿಸಿ ನಸ್ತಾನಾ ಹೊತ್ತೊ ಘುಟ್ಟ್ ಖಲೆಬಿ ನಿಪಿನಾ. <verse eid="EZK 28:3" /><verse number="4" style="v" sid="EZK 28:4" />ತುಜ್ಯಾ ಬುದ್ದಿನ್ ಅನಿ ಶಾನ್ಪಾನ್ ತಿಯಾ ಆಸ್ತಿ ಸಂಪಾಳ್ಸುನ್, ತುಜ್ಯಾ ಗೊಳಾಕರುನ್ ಥವ್ತಲ್ಯಾ ಖೊಲಿತ್ ಚಾಂದಿ ಅನಿ ಸೊನೆ ಭರುನ್ ಘೆಟ್ಲೆಯ್. <verse eid="EZK 28:4" /><verse number="5" style="v" sid="EZK 28:5" />ತಿಯಾ ತುಜ್ಯಾ ಲೈ ಬುದ್ದಿನ್ ಅನಿ ಯಾಪಾರಾನ್ ಬದಿಕ್ ಲೈ ಕರುನ್ಗೆವ್ನ್ ರ್‍ಹಾತಾನಾ, ತುಜೊ ಮನ್ ಆಸ್ತಿಚ್ಯಾ ವಯ್ನಾ ಘರುಕಿನ್ ಫುಗ್ಲೆಯ್. <verse eid="EZK 28:5" /><verse number="6" style="v" sid="EZK 28:6" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೆ ಮನ್ತಾ, ತಿಯಾ ತುಕಾ ದೆವಾಕ್ ಸರಾಸರಿ ಕರುನ್ ಘೆಟೈ. <verse eid="EZK 28:6" /><verse number="7" style="v" sid="EZK 28:7" />ಮಿಯಾ ಲೈ ಬುರ್ಶಿ ಲೊಕಾ ಕ್ರುರ್ ದಯಾ ನತ್ತ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿ ತುಜ್ಯಾ ಪಡಿ ಸಾರ್ಕೆ ಕರ್ತಾ, ತೆನಿ ತುಜ್ಯಾ ಬುದ್ದಿಚ್ಯಾ ಘರುಕಿ ವರ್‍ತಿ ತಲ್ವಾರ್ ಬೊಚುನ್ ತುಜಿ ಶೊಬಾ ಬುರ್ಸೆ ಕರ್‍ತಾತ್. <verse eid="EZK 28:7" /><verse number="8" style="v" sid="EZK 28:8" />ತುಕಾ ಪಾತಾಳಾಕ್ ಢಕ್ಲುನ್ ಘಾಲ್ತಾತ್, ಸಮುಂದರಾಚ್ಯಾ ಮದ್ದಿ ತುಜ್ಯಾಕ್ನಾ ತೊಡಲ್ಯಾಂಚಿ ಗತ್ ತುಕಾ ಬಿ ಯೆತಾ. <verse eid="EZK 28:8" /><verse number="9" style="v" sid="EZK 28:9" />ತಿಯಾ ತುಕಾ ಜಿವ್ ಕಾಡ್ತಲ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ಮಿಯಾ ದೆವ್ ಮನುನ್ ಸಾಂಗ್ತೆಯ್ ಕಾಯ್? ಜಿವ್ ಕಾಡ್ತಲ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ತಿಯಾ ಕನ್ನಾಬಿ ದೆವ್ ನ್ಹಯ್, ತಿಯಾ ಖಾಲಿ ನರ್ ಮಾನುಸುಚ್! <verse eid="EZK 28:9" /><verse number="10" style="v" sid="EZK 28:10" />ತಿಯಾ ದುಶ್ರ್ಯಾಂಚ್ಯಾ ಹಾತಿತ್ನಾ ಸುನ್ನತ್ ನಸಲ್ಲ್ಯಾಂಚ್ಯಾ ಮರ್ನಾಕ್ ಗುರಿ ಹೊತೆಯ್, ಮಿಯಾಚ್ ಬೊಲಲ್ಲೆ, ಹೆ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 28:10" /></para>
  <para style="s">ತಿರ್ ಶಾರ್ ಪಡ್ತಲೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 28:11" />ಮಾಕಾ ಸರ್ವೆಸ್ಪರಾನ್ ಅನಿ ಎಗ್ದಾ ಬೊಲ್ಲ್ಯಾನ್, <verse eid="EZK 28:11" /><verse number="12" style="v" sid="EZK 28:12" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ತಿರ್ ಶಾರಾಚ್ಯಾ ರಾಜ್ಯಾಚ್ಯಾ ವಿಶಯಾತ್ ದುಕ್ಕಾಚಿ ಗಿತ್ ಸಾಂಗ್, ತೆಕಾ ಅಸೆ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ತಿಯಾ ಸಗ್ಳ್ಯಾ ಲಕ್ಷನಾನಿ ಭರುನ್ ಹೊತ್ತೊ, ಸಗ್ಳ್ಯಾ ಬುದ್ದಿನ್ ಭರಲ್ಲೊ, ಸಗ್ಳ್ಯಾ ನಮುನಿ ಸುಂದರ್ ಪಾನಾಚೊ. <verse eid="EZK 28:12" /><verse number="13" style="v" sid="EZK 28:13" />ದೆವಾಚೊ ಮ್ಹಳೊ ಎದೆನಾತ್ ತಿಯಾ ಹಾಸ್, ಮಾನಿಕ್ಯ್, ಪುಶ್ಪರಾಗ್, ಪಚ್ಚೆ, ಪಿತರತ್ನ, ಬೆರುಲ್ಲಾ, ವೈಡುರ್ಯ್, ನಿಳೊ ಕೆಂಪರಲು, ಅನಿ ಸ್ಪಟಿಕ್ ಹ್ಯಾ ನ್ಹವ್ ನಮುನ್ಯಾಚ್ಯಾ ರತ್ನಾನಿ ಭರುನ್ ಹಾಸ್, ತುಜ್ಯಾಕ್ಲ್ಯಾ ಹ್ಯಾ ರತ್ನಾಂಚೊ ಘುಡ್ ಅನಿ ಘರಾ, ಸೊನ್ಯಾನ್ ಕರಲ್ಲಿ ಹೊತ್ತಿ, ತುಜ್ಯಾ ರಚ್ನ್ಯಾಚ್ಯಾ ದಿಸಾತ್ ತಯಾರ್ ಹೊಲೆ. <verse eid="EZK 28:13" /><verse number="14" style="v" sid="EZK 28:14" />ತಿಯಾ ರಕುಟೆ ಸೊಡುನ್ ಸಾವ್ಳಿ ದಿತಲಿ ಕೆರುಬಿಯಾ ಹೊಲೈ, ಮಿಯಾ ತುಕಾ ದೆವಾಚ್ಯಾ ನಿತಳ್ ಜಾಗ್ಯಾ ವರ್‍ತಿ ಇಬೆ ಕರ್ಲಾ, ತಿಯಾ ಖೆಂಡಾಂಚ್ಯಾ ಪಾವ್ಸಾತ್ ಚಲುನ್ಗೆತ್ ಹಾಸ್. <verse eid="EZK 28:14" /><verse number="15" style="v" sid="EZK 28:15" />ತುಜ್ಯಾ ರಚ್ನ್ಯಾಚ್ಯಾ ದಿಸಾಕ್ನಾ ತುಜ್ಯಾಕ್ಡೆ ಚುಕ್ ದಿಸಿ ಪತರ್ ತುಜಿ ಚಾಲ್ನುಕ್ ಚುಕ್ ನಸಲ್ಲಿಚ್ ಹೊವ್ನ್ ದಿಸಿ. <verse eid="EZK 28:15" /><verse number="16" style="v" sid="EZK 28:16" />ತುಜ್ಯಾ ಲೆಕ್ಕಾಕ್ ನಸಲ್ಲ್ಯಾ ಯಾಪಾರಾ ವಯ್ನಾ, ತುಜ್ಯಾಕ್ಡೆ ಬಲತ್ಕಾರ್ ಭರುನ್ ತಿಯಾ ಪಾಪಿ ಹೊಲೈ, ತಸೆ ಹೊವ್ನ್, ಮಿಯಾ ತುಕಾ ದೆವಾಚ್ಯಾ ಮಡ್ಡಿಕ್ನಾ ಬುರ್ಸೊ ಮನುನ್ ಡಕ್ಲುನ್ ದಿಲೊ, ಹೊಯ್, ರಾಕ್ವನ್ ದಿತಲ್ಯಾ ಕೆರುಬಿ, ಖೆಂಡಾಂಚ್ಯಾ ಪಾವ್ಸಾಚ್ಯಾ ಮದ್ಲ್ಯಾ ತುಜ್ಯಾ ಜಾಗ್ಯಾ ವಯ್ನಾ, ಮಿಯಾ ತುಕಾ ಕಾಡುನ್ ತುಕಾ ಜಾಳ್ವುನ್ ಟಾಕ್ತಾ. <verse eid="EZK 28:16" /><verse number="17" style="v" sid="EZK 28:17" />ತಿಯಾ ತುಜ್ಯಾ ಸುಂದರ್ ಪಾನಾಚ್ಯಾ ವಯ್ನಾ, ಘರುಕಿಚ್ಯಾ ಫುಗಲ್ಯಾ ಮನಾನ್ ತುಜ್ಯಾ ಫಿರಾಟ್, ತುಜಿ ಬುದ್ದ್ ಹಾಳ್ ಕರುನ್ ಘೆಟೈ, ಹೆಜ್ಯಾ ವಯ್ನಾ ಮಿಯಾ ತುಕಾ, ಜಿಮ್ನಿಕ್ ಡಕ್ಲುನ್ ತಿಯಾ ರಾಜಾಕ್ನಿ ದಿಸಿ ಸಾರ್ಕೆ ತೆಂಚ್ಯಾ ಡೊಳ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಘಾಟ್ಲೊ. <verse eid="EZK 28:17" /><verse number="18" style="v" sid="EZK 28:18" />ತುಜ್ಯಾ ಲೈ ಹೊಲ್ಲ್ಯಾ ಅಪ್ರಾದಾಂಚ್ಯಾ ವಯ್ನಾ ಅನಿ ಅನ್ಯಾಯಾಚ್ಯಾ ಯಾಪಾರಾನ್ ತುಜ್ಯಾಕ್ಲಿ ಪವಿತ್ರ್ ಘರಾ ಬುರ್ಸೆ ಕರ್‍ಲೆ, ತಸೆಹೊವ್ನ್ ಮಿಯಾ ತುಜ್ಯಾಕ್ನಾ ಆಗ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ಲೊ. ತಿನೆ ತುಕಾ ಗಿಳ್ಳಿನ್, ಬಗ್ತಲ್ಯಾಂಚ್ಯಾ ಡೊಳ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಮಿಯಾ ತುಕಾ ರಕ್ಕಾ ಕರ್ಲೊ. <verse eid="EZK 28:18" /><verse number="19" style="v" sid="EZK 28:19" />ಲೊಕಾತ್ನಿ ತುಜೆ ಗೊತ್ತ್ ಹೊತ್ತಿ ಸಗ್ಳಿ ಲೊಕಾ ತುಜಿ ಗತ್ ಬಗುನ್ ಭಿಂವ್ತಾತ್, ತಿಯಾ ಸಗ್ಳೊ ನಾಶ್ ಹೊವ್ನ್ ಅನಿ ಕನ್ನಾಬಿ ದಿಸಿನಾ ಸಾರ್ಕೊ ಹೊತೆಯ್.<verse eid="EZK 28:19" /></para>
  <para style="s">ಸಿದೊನಾಚ್ಯಾ ವಿರೊಧ್ ಪ್ರವಾದನ್</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 28:20" />ಸರ್ವೆಸ್ಪರಾನ್ ಹಿ ಗೊಸ್ಟ್ ಮಾಕಾ ದಿಲಾ, <verse eid="EZK 28:20" /><verse number="21" style="v" sid="EZK 28:21" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಸಿದೊನಾಕ್ಡೆ ತೊಂಡ್ ಕರುನ್, ತೆಜ್ಯಾ ವಿಶಯಾತ್ ಅಸೆ ಬೊಲ್. <verse eid="EZK 28:21" /><verse number="22" style="v" sid="EZK 28:22" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಅಹಾ, ಸಿದೊನಾ, ಮಿಯಾ ತುಕಾ ವಿರೊದ್ ಹೊವ್ನ್ ತುಜ್ಯಾ ಮದ್ದಿ ನಾವ್ ಘೆತಾ, ಮಿಯಾ ಹ್ಯಾ ಶಾರಾಕ್ ನ್ಯಾಯ್ ದಿವ್ನ್, ಮಾಜಿ ಮಾನ್ ರಾಕುನ್ ಘೆಟ್ಲ್ಯಾ ಮಾನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಸಗ್ಳ್ಯಾಕ್ನಿ ಗೊತ್ತ್ ಹೊತಾ. <verse eid="EZK 28:22" /><verse number="23" style="v" sid="EZK 28:23" />ಮಿಯಾ ತ್ಯಾತುರ್ ದುಕ್ನೆ ಅನಿ ತೆಜ್ಯಾ ಚವ್ಕಾತ್ನಿ ಮರಾನ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ತೆಜ್ಯಾ ಭೊತ್ಯಾನಿ ತಲ್ವಾರ್ ಝಳ್ಕುನ್ಗೆತ್ ರ್‍ಹಾತಾನಾ, ತೆಜ್ಯಾ ಮದ್ದಿ ಲೊಕಾ ಮರುನ್ ಪಡ್ತಾತ್, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತೆಂಕಾ ಕಳ್ತಾ. <verse eid="EZK 28:23" /><verse number="24" style="v" sid="EZK 28:24" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಟೊಪ್ತಲೊ ಕಾಟೊ ಹೆಜ್ಯಾನ್ ಫಿಡೆ ರ್‍ಹಾಯ್ನಾ, ಚಾಳ್ವುತಲಿ ಆಜುಭಾಜುಚಿ ಲೊಕಾ ಮನ್ತಲೊ ಸಂಕಟ್ಬಿ ಅನಿ ರ್‍ಹಾಯ್ನಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮನುನ್ ತುಮ್ಕಾ ಕಳ್ತಾ.<verse eid="EZK 28:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 28:25" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಲೊಕಾತ್ನಿ ಪಗ್ಳುನ್ ಗೆಲ್ಲ್ಯಾ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಮಿಯಾ ಗೊಳಾ ಕರುನ್, ಸಗ್ಳ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಡೊಳ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ಮಾಜಿ ಮಾನ್ ರಾಕುನ್ ಘೆಟ್ಲ್ಯಾಮಾನಾ, ತಿ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ, ಅನಿ ಮಾಜೊ ಸೆವಕ್ ಜಾಕೊಬಾಕ್, ಮಿಯಾ ದಿಲ್ಲ್ಯಾ ಅಪ್ನಾಚ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಸಾತ್, ವಸ್ತಿ ರ್‍ಹಾತ್ಯಾತ್. <verse eid="EZK 28:25" /><verse number="26" style="v" sid="EZK 28:26" />ಥೈ ಭಿಂಯ್ಯೆ ನಸ್ತಾನಾ ರ್‍ಹಾತ್ಯಾಸಿ, ಘರಾ ಭಾಂದುನ್ಗೆವ್ನ್, ಮ್ಹಳೆ ಕರುನ್ಗೆವ್ನ್ ಸುಖಾನ್ ವಸ್ತಿ ರ್‍ಹಾತ್ಯಾತ್. ತೆಂಕಾ ತರಾಸ್ ದಿತಲ್ಯಾ ಆಜುಭಾಜುಚ್ಯಾಕ್ನಿ, ಮಿಯಾ ಶಿಕ್ಷ್ಯಾ ದಿಲ್ಯಾ ಮಾನಾ, ಮಿಯಾಚ್ ತೆಂಚೊ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮನುನ್ ತೆಂಕಾ ಕಳ್ತಾ.<verse eid="EZK 28:26" /></para>
  <chapter eid="EZK 28" />
  <chapter number="29" style="c" sid="EZK 29" />
  <para style="s">ಇಜಿಪ್ತಾಚ್ಯಾ ವಿಶಯಾತ್ ಪರ್‍ವಾದನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 29:1" />ಯೆಹೊಯಾಕಿಮ್ ಬಂಧಿ ಹೊವ್ನ್ ಧಾ ವರ್ಸಾಚ್ಯಾ ಧಾವ್ಯಾ ಮ್ಹೈನ್ಯಾಚ್ಯಾ ಬಾರಾವ್ಯಾ ದಿಸಾತ್, ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲ್ಯಾನ್, <verse eid="EZK 29:1" /><verse number="2" style="v" sid="EZK 29:2" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಇಜಿಪ್ತಾಚೊ ರಾಜಾ ಹೊಲ್ಲ್ಯಾ ತೊಂಡ್ ಕರುನ್ ತೆಜ್ಯಾ ವಿಶಯಾತ್ಬಿ ಇಜಿಪ್ತ್ ಕಾರಾಂಚ್ಯಾ ವಿಶಯಾತ್ ಅಸೆ ಸಾಂಗ್, <verse eid="EZK 29:2" /><verse number="3" style="v" sid="EZK 29:3" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಇಜಿಪ್ತಾಚೊ ರಾಜಾ ಫಾರೊವಾ, ತುಜಿ ನ್ಹಯ್ ಫಾಟ್ಯಾಂಚ್ಯಾ ಮದ್ದಿ ಮಾಗುನ್ ಘೆವ್ನ್ , ಹಿ ನ್ಹಯ್ ಮಾಜಿಚ್, ಮಾಜ್ಯಾ ಸಾಟ್ನಿಚ್ ಕರುನ್ಗೆಟಲ್ಲಿ ಮನ್ತಲೊ ಮೊಟೊ ಸಾಪ್, ಅಬಕ್ ಮಿಯಾ ತುಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 29:3" /><verse number="4" style="v" sid="EZK 29:4" />ಮಿಯಾ ತುಜ್ಯಾ ದಾವ್ಡಿಯಾಕ್ನಿ ಬಲಿ ಘಾಲುನ್, ತುಜ್ಯಾ ನ್ಹಯ್ಲ್ ನ್ಹೈಯಿಚಿ ಮಾಸೊಳಿಯಾ ತುಜ್ಯಾ ಡುಬ್ರಿಚ್ಯಾ ಕವ್ಚಿಯಾಕ್ನಿ ಲಾಗುನ್ ರಾಯ್ ಸಾರ್ಕೆ ಕರುನ್ ಲಾಗುನ್ ಹೊತ್ತ್ಯಾ ಮಾಸೊಳಿಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ತುಕಾ ತುಜ್ಯಾ ನ್ಹಯಿತ್ನಾ ಭಾಯ್ರ್ ವೊಡುನ್, <verse eid="EZK 29:4" /><verse number="5" style="v" sid="EZK 29:5" />ತುಕಾ ಅನಿ ತುಜ್ಯಾ ನ್ಹೈಯಿತ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಮಾಸೊಳಿಯಾಕ್ನಿ ಡಂಗ್ಳಿಚೊ ವಾಟೊ ಕರ್ತಾ, ತಿಯಾ ಮ್ಹಾಳ್ ಜಾಗ್ಯಾ ವರ್‍ತಿ ಪಡುನ್ ರ್‍ಹಾತೆಯ್, ತುಕಾ ಕೊನ್ಬಿ ಉಕ್ಲಿನಾತ್, ಮಾಟಿ ಕರಿನಾತ್, ಮಿಯಾ ತುಕಾ ಜಿಮ್ನಿ ವಯ್ಲ್ಯಾ ಜನಾವರಾಕ್ನಿ ಅನಿ ಮಳ್ಬಾತ್ಲ್ಯಾ ಫಾಂಕ್ರಾಕ್ನಿ ಜೆವಾನ್ ಕರ್ಲಾ. <verse eid="EZK 29:5" /><verse number="6" style="v" sid="EZK 29:6" />ತನ್ನಾ ಇಜಿಪ್ತಾಚಿ ಸಗ್ಳಿ ಲೊಕಾ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಅಮಿ ಘಟ್ ನಸಲ್ಲೊ ದಾಂಡ್ಯಾಚಿ ಖಾಟಿ ಹೊಲ್ಯಾಂವ್, ಮನುನ್ ಮರ್ಯಾದ್ ಕರುನ್ಗೆವ್ನ್, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಖರೆಚ್ ಘಟ್ ಕರುನ್ ಘೆತಾತ್. <verse eid="EZK 29:6" /><verse number="7" style="v" sid="EZK 29:7" />ಇಜಿಪ್ತ್ ತುಜ್ಯಾ ವರ್‍ತಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಹಾತ್ ಥವ್ತಾನಾ, ತಿಯಾ ತೆಂಚ್ಯಾ ಸಗ್ಳ್ಯಾಂಚ್ಯಾ ಭುಜೆಕ್ ಟೊಪ್ಲೆಯ್, ಲಾವ್ನ್ ಇಬೆ ರಾವ್ಕ್ ತೆಂಚ್ಯಾ ಸಗ್ಳ್ಯಾಂಚ್ಯಾ ಕಂಬ್ರೆಕ್ ತಿಯಾ ಥರ್ಥರೊ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್‍ಲೆ. <verse eid="EZK 29:7" /><verse number="8" style="v" sid="EZK 29:8" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಆಹಾ, ಮಿಯಾ ತುಜ್ಯಾ ವರ್‍ತಿ ತಲ್ವಾರ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರುನ್ ತುಜ್ಯಾಕ್ನಾ ಲೊಕಾಕ್ನಿ ಅನಿ ಜನಾವರಾಕ್ನಿ ನಾ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 29:8" /><verse number="9" style="v" sid="EZK 29:9" />ಫಾರೊವಾನ್ ಹಿ ನ್ಹಯ್ ಮಾಜಿಚ್, ಮಿಯಾಚ್ ಕರುನ್ಗೆಟಲ್ಲಿ ಮಟಲ್ಯಾ ಸಾಟ್ನಿ, ಇಜಿಪ್ತ್ ಹಾಳ್ ಪಾಳ್ ಹೊತಾ, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ತೆಂಕಾ ಕಳ್ತಾ. <verse eid="EZK 29:9" /><verse number="10" style="v" sid="EZK 29:10" />ಅಬಕ್, ಮಿಯಾ ತುಕಾ ಅನಿ ತುಜ್ಯಾ ನ್ಹೈಯಿಕ್ ವಿರೊದ್ ಹೊವ್ನ್ ಇಜಿಪ್ತ್ ದೆಶ್ ಮಿಗ್ದೊಲಿಕ್ನಾ ಸೆವೆನೆಚ್ಯಾ ಪತರ್, ಕುಶ್ಯಾಚ್ಯಾ ಹದ್ದಾಚ್ಯಾ ಪತರ್ಬಿ ಲೈ ಹಾಳ್ ಕರ್ತಾ. <verse eid="EZK 29:10" /><verse number="11" style="v" sid="EZK 29:11" />ಥೈ ಖಲೊ ಮಾನುಸ್ಬಿ ಪಾಂಯ್ ಥವ್ನ್ ದಾಟುನ್ ಜಾಯ್ನಾ, ಖಲೆ ಜನಾವರ್ಬಿ ತುಡ್ವುನ್ ದಾಟುನ್ ಜಾಯ್ನಾ, ಚಾಳಿಸ್ ವರಿಸ್ ಪತರ್ ಥೈ ಮಾನ್ಸಾ ನಾ ಹೊತಾತ್. <verse eid="EZK 29:11" /><verse number="12" style="v" sid="EZK 29:12" />ಹಾಳ್ ಪಡಲ್ಲ್ಯಾ ದೆಸಾತ್ ಇಜಿಪ್ತ್ ದೆಸಾಕ್ ಹಾಳ್ ಪಾಡ್ವುತಾ, ಹಾಳ್ ಪಡಲ್ಲ್ಯಾ ಶಾರ್‍ಹಾತ್ನಿ ತೆಚಿ ಶಾರಾ ಹಾಳ್ ಪಾಡ್ವುತಾ, ಚಾಳಿಸ್ ವರಿಸ್ ತಸೆಚ್ ರ್‍ಹಾತಾ, ಮಿಯಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ದೆಸಾಕ್ನಿ ಪಳ್ಸುನ್ ಪಗ್ಳುನ್ ಘಾಲ್ತಾ. <verse eid="EZK 29:12" /><verse number="13" style="v" sid="EZK 29:13" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಮಿಯಾ ಚಾಳಿಸ್ ವರ್ಸಾಂಚ್ಯಾ ಮಾನಾ, ಮಿಯಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ತೆನಿ ಪಗ್ಳುನ್ ಗೆಲ್ಲ್ಯಾ ಲೊಕಾಂತ್ನಾ, ತೆಂಕಾ ಗೊಳಾ ಕರುನ್ ಇಜಿಪ್ತಾಚೆ ಬುರ್ಸೆ ಪಾನ್ ಚುಕ್ವುನ್, <verse eid="EZK 29:13" /><verse number="14" style="v" sid="EZK 29:14" />ತೆಂಚಿ ಉಪಾಜಲ್ಲಿ ಜಿಮಿನ್ ಪತ್ರೊಸ್ ದೆಸಾಕ್ ಪರ್‍ತುನ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ತೆನಿ ಕಿಳ್ ಮಟ್ಟಾಚೊ ರಾಜ್ಯ್ ಹೊತಾತ್. <verse eid="EZK 29:14" /><verse number="15" style="v" sid="EZK 29:15" />ತೊ ರಾಜ್ಯ್ ಸಗ್ಳ್ಯಾ ರಾಜ್ಯಾತ್ನಿ ಲೈ ಕಮ್ಮಿಚೊ ರಾಜ್ಯ್ ಹೊತಾತ್, ಹುರಲ್ಲ್ಯಾ ಲೊಕಾತ್ನಿ ಅಪ್ನಿ ಮೊಟೊ ಮನುನ್ ತೆ ಪರ್‍ತುನ್ ಟಕ್ಲೆ ಉಕ್ಲಿನಾ, ತೆ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿ ಅನಿ ಪರ್‍ತುನ್ ರಾಜ್ವಡ್ಕಿ ಕರಿನಾ ಸಾರ್ಕೆ ಮಿಯಾ ತೆಕಾ ಲೈ ಕಮ್ಮಿಚ್ಯಾ ಗತಿಕ್ ಹಾನ್ತಾ. <verse eid="EZK 29:15" /><verse number="16" style="v" sid="EZK 29:16" />ಅತ್ತಾ ಪರ್‍ತುನ್ ಇಜಿಪ್ತ್ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚೆ ಭರೊಸೊ ಹೊವ್ನ್ ರ್‍ಹಾಯ್ನಾ, ಅನಿ ತೆಜ್ಯಾಕ್ಡೆ ಡೊಳೆ ಕಾಡುನ್ ಬಗ್ತಲೆ ದೆವಾಕ್ ದುಶನ್ ಕರ್ತಲಿ ಯಾದ್, ಇಜ್ರಾಯೆಲಾತ್ನಿ ಇಜಿಪ್ತಾಕ್ನಾ ಅನಿ ಪರ್‍ತುನ್ ಯೆಯ್ನಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತೆಂಕಾ ಕಳ್ತಾ.<verse eid="EZK 29:16" /></para>
  <para style="s">ನೆಬುಕದ್ನೆಚರಾನ್ ರಾಜಾನ್ ಇಜಿಪ್ತಾಕ್ ತಾಬೆತ್ ಕರುನ್ ಘೆಟಲ್ಲೆ</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 29:17" />ಯೆಹೊವಾಜಾಕಿಮ್ ಬಂಧಿಹೊಲ್ಲ್ಯಾ ಇಸಾರ್ ಸಾತ್ವೆಚ್ಯಾ ವರ್ಸಾತ್ ಪಯ್ಲೆಚ್ಯಾ ಮ್ಹೈನ್ಯಾಚ್ಯಾ ಪಯ್ಲೆಚ್ಯಾ ದಿಸಾತ್, ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಅಸೆ ಬೊಲ್ಯಾನ್. <verse eid="EZK 29:17" /><verse number="18" style="v" sid="EZK 29:18" />ನರ್ ಮಾನ್ಸಾ, ಬಾಬೆಲೊನಾಚ್ಯಾ ರಾಜಾ ನೆಬುಕದ್ನೆಚರ್ ತಿರ್ ಶಾರಾ ವರ್‍ತಿ ಝಗ್ಡೊ ಕರುನ್ ಅಪ್ನಾಚ್ಯಾ ಸಯ್ನಿಕಾಂಚ್ಯಾಕ್ನಾ ಲೈ ತರಾಸಾಚಿ ಕಾಮಾ ಕರಸ್ಲ್ಯಾನ್, ಹರ್ ಎಕ್ಲ್ಯಾಚೆ ಟಕ್ಲೆ ಬೊಳ್ ಹೊಲಾ, ಹರ್ ಎಕ್ಲ್ಯಾಚಿ ಖಾಂದೊ ಧರುನ್ಗೆಟ್ಲೆ ಸಾರ್ಕೆ ಹೊಲಾ, ಖರೆ ತೆನಿ ತ್ಯಾ ಝಗ್ಡ್ಯಾತ್ ಕರಲ್ಲ್ಯಾ ತರಾಸಾಕ್ ತೆಕಾ ಹೊಂವ್ದಿತ್ ತೆಜ್ಯಾ ಸಯ್ನಿಕಾಕ್ನಿ ಹೊಂವ್ದಿತ್ ಕಾಯ್ಬಿ ಪ್ರತಿ ಫಳ್ ಗಾವ್ಕ್ ನಾ. <verse eid="EZK 29:18" /><verse number="19" style="v" sid="EZK 29:19" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಅಬಕ್ ಮಿಯಾ ಬಾಬೆಲಾಚೊ ರಾಜಾ ನೆಬುಕದ್ನೆಚರಾಕ್ ಇಜಿಪ್ತ್ ದೆಶ್ ದಿತಾ, ತೊ ತ್ಯಾತುರ್ಲಿ ಲೊಕಾ ಅನಿ ಆಸ್ತಿ ನ್ಹೆವ್ನ್, ತ್ಯಾ ದೆಶ್ಯಾಕ್ ಲುಟುನ್ ನಾಶ್ ಕರ್ತಾ, ತೊಚ್ ತೆಜ್ಯಾ ಸಯ್ನಿಕಾಂಚೊ ಪ್ರತಿ ಫಳ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 29:19" /><verse number="20" style="v" sid="EZK 29:20" />ತೆನಿ ಸಯ್ನಿಕಾಕ್ನಿ ಘೆವ್ನ್ ಮಾಜ್ಯಾ ಸಾಟ್ನಿ ಸೆವಾ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ತೆನಿ ಕರಲ್ಲ್ಯಾ ಕಾಮಾಕ್ ಪ್ರತಿ ಫಳ್ ಹೊವ್ನ್ ಮಿಯಾ ಇಜಿಪ್ತ್ ದೆಶ್ ತೆಕಾ ದಿಲಾ, ಹಿ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 29:20" /><verse number="21" style="v" sid="EZK 29:21" />ತ್ಯಾ ದಿಸಾತ್ ಮಿಯಾ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಭೊಂಗೊ ವಾಜ್ವುನ್, ತ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾಂಚ್ಯಾ ಮದ್ದಿ ತುಜೆ ತೊಂಡ್ ಉಗ್ಡಿ ಸಾರ್ಕೆ ಕರ್ತಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತುಕಾ ಖರೆಚ್ ಕಳ್ತಾ.<verse eid="EZK 29:21" /></para>
  <chapter eid="EZK 29" />
  <chapter number="30" style="c" sid="EZK 30" />
  <para style="s">ಸರ್ವೆಸ್ಪರ್ ಇಜಿಪ್ತಾಕ್ ಶಿಕ್ಷ್ಯಾ ದಿತಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 30:1" />ಮಾಕಾ ಸರ್ವೆಸ್ಪರಾನ್ ಅನಿ ಎಗ್ದಾ ಬೊಲ್ಲ್ಯಾನ್, <verse eid="EZK 30:1" /><verse number="2" style="v" sid="EZK 30:2" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಹಿ ದೆವಾಚಿ ಗೊಸ್ಟ್ ಪರ್‍ವಾದನ್ ಕರುನ್ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಅಯ್ಯೊ ಬುರ್ಶಿ ದಿಸಾ ಮನುನ್ ಬೊಬ್ ಮಾರಾ! <verse eid="EZK 30:2" /><verse number="3" style="v" sid="EZK 30:3" />ತೊ ದಿಸ್ ಜಗ್ಗೊಳ್ ಯೆಲೊ, ಹೊಯ್ ತೊ ಸರ್ವೆಸ್ಪರಾಚೊ ದಿಸ್, ಕಾಳ್ಕಾಚ್ಯಾ ಮೊಡಾಚೊ ದಿಸ್ ಜಗ್ಗೊಳ್ ಯೆಲೊ, ತೊ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ಝಡ್ತಿ ಕರ್ತಲೊ ಎಳ್. <verse eid="EZK 30:3" /><verse number="4" style="v" sid="EZK 30:4" />ಇಜಿಪ್ತಾಚ್ಯಾ ವರ್‍ತಿ ತಲ್ವಾರ್ ಪಡ್ತಾ, ಥೈತ್ಲಿ ಲೊಕಾ ಮ್ಹರ್ತಾನಾ ಕುಶಾತ್ಬಿ ತರಾಸ್ ಯೆತಾ, ಇಜಿಪ್ತಾಚ್ಯಾ ಹಾಜಾರ್ ಘಟ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ ನೆವ್ನ್ ಹೊತಾ, ತೆಚಿ ಪಾಯಾ ಹಾಳ್ ಹೊತಾತ್. <verse eid="EZK 30:4" /><verse number="5" style="v" sid="EZK 30:5" />ಕುಶ್ಯಾ, ಪುಟ್ಯಾ, ಲುದ್, ಅರಬ್ಬಿ, ಮನ್ತಲಿ ನಾನಾ ನಮುನ್ಯಾಚಿ ದುಶ್ರ್ಯಾ ದೆಶ್ಯಾಚಿ ಲೊಕಾ ಕುಬ್ಯಾಚಿ ಲೊಕಾ, ಕರಾರ್ ಕರುನ್ಗೆಟಲ್ಲಿ ಸ್ವತಾಚಿ ಲೊಕಾ, ಹೆನಿ ಸಗ್ಳ್ಯಾನಿ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ತಲ್ವಾರಾನಿ ಮರ್ತಾತ್. <verse eid="EZK 30:5" /><verse number="6" style="v" sid="EZK 30:6" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಇಜಿಪ್ತಾಕ್ ಆಧಾರ್ ಹೊಲ್ಲೆ ಪಡ್ತಾತ್, ತೆಚಿ ಬಳ್ ಉತ್ರುನ್ ಜಾತಾ, ಥೈತ್ಲಿ ಲೊಕಾ ಮಿಗ್ದೆಲಿಕ್ನಾ ಸೆವೆನೆಚ್ಯಾ ಪತರ್ ತಲ್ವಾರ್ ಮಾರುನ್ ಹೊತಾತ್, ಹಿ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 30:6" /><verse number="7" style="v" sid="EZK 30:7" />ನಾಶ್ ಹೊಲ್ಲ್ಯಾ ದೆಶ್ಯಾಚ್ಯಾ ವಾಂಗ್ಡಾ ತೊ ದೆಶ್ ನಾಶ್ ಹೊತಾ, ಹಾಳ್ ಪಡಲ್ಲ್ಯಾ ಶಾರಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ತೆಚಿ ಶಾರಾಬಿ ಪಾಡ್ ಪಡ್ತಾತ್. <verse eid="EZK 30:7" /><verse number="8" style="v" sid="EZK 30:8" />ಮಿಯಾ ಇಜಿಪ್ತಾಕ್ ಆಗ್ ಲಾವ್ನ್ ತೆಜ್ಯಾ ಸಗ್ಳ್ಯಾ ಮಜ್ಜತ್ ಕಾರಾಕ್ನಿ ನಾಶ್ ಕರ್ಲ್ಯಾ ಮಾನಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತೆಂಕಾ ಕಳ್ತಾ. <verse eid="EZK 30:8" /><verse number="9" style="v" sid="EZK 30:9" />ತ್ಯಾ ದಿಸಾತ್ನಿ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಖಬ್ರಿಕಾರ್ ಜಾವ್ನ್ ಢೊನಾತ್ನಿ ಪ್ರಯಾನ್ ಕರುನ್ ಚಿಂತಾನಸಲ್ಲ್ಯಾ ಕುಶ್ಯಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಭಿಂವಸ್ತಾತ್, ಇಜಿಪ್ತಾಚ್ಯಾ ನಾಶಾಚ್ಯಾ ದಿಸಾತ್ ಲೊಕಾಕ್ನಿ ಕುಶ್ಯಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಸಂಕಟ್ ಯೆತಾ, ಅಬಕ್ ತೊ ದಿಸ್ ಯೆಲೊ. <verse eid="EZK 30:9" /><verse number="10" style="v" sid="EZK 30:10" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಮಿಯಾ ಬಾಬೆಲೊನಾಚೊ ರಾಜಾ ನೆಬುಕದ್ನೆಚರಾಚ್ಯಾ ಹಾತಿತ್ಲ್ಯಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಮೆಜುಕ್ ಹೊಯ್ನಸಲ್ಲ್ಯಾ ತವ್ಡ್ಯಾ ಸಯ್ನಿಕಾಕ್ನಿ ಆಕ್ರಿ ದಾಕ್ವುತಾ. <verse eid="EZK 30:10" /><verse number="11" style="v" sid="EZK 30:11" />ತ್ಯಾ ದೆಸಾಕ್ ನಾಶ್ ಕರ್ಸುನ್ ತೆಕಾ ಲೈ ಬುರ್ಶಿ ಲೊಕಾ ಹೊಲ್ಲ್ಯಾ ತೆಜ್ಯಾ ಸಯ್ನಿಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ತೊ ಇಜಿಪ್ತಾಚ್ಯಾ ವರ್‍ತಿ ತಲ್ವಾರ್ ಟೊಚುನ್ ಫುರಾ ದೆಶ್ ತಲ್ವಾರಾನ್ ಮರ್‍ನಾಕ್ ಲಾಗುನ್ ಭರಿ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 30:11" /><verse number="12" style="v" sid="EZK 30:12" />ಮಿಯಾ ನ್ಹಯ್ಲ್ ನ್ಹಯಿಚೆ ಫಾಟೆ ವಾಳ್ವುನ್ ಫುರಾ ದೆಶ್ ಬುರ್ಸ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಹಾತಿಕ್ ಇಕ್ತಾ, ಹೊಯ್ ದೆಶ್ ಅನಿ ತ್ಯಾತುರ್‍ಲೆ ಸಗ್ಳೆ ದುಶ್ರ್ಯಾಂಚ್ಯಾ ಹಾತಿನ್ ನಾಶ್ ಕರುನ್ ಟಾಕ್ತಾ, ಹೆ ಸರ್ವೆಸ್ಪರ್ ಹೊಲ್ಲ್ಯಾ ಮಿಯಾಚ್ ಬೊಲ್ಲಾ.<verse eid="EZK 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 30:13" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮಿಯಾ ಮೊಂಪಿಶ್ ಶಾರಾಚ್ಯಾ ಮುರ್ತಿಯಾಕ್ನಿ ಸಗ್ಳೆ ಫೊಡುನ್ ಆಕ್ರಿ ದಾಕ್ವುತಾ, ಇಜಿಪ್ತಾತ್ ಅನಿ ಖಲೊ ರಾಜಾಬಿ ರ್‍ಹಾಯ್ನಾ, ಮಿಯಾ ತ್ಯಾ ದೆಸಾಕ್ ಭಿಂಯೆ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 30:13" /><verse number="14" style="v" sid="EZK 30:14" />ಮಿಯಾ ಪತ್ರೊಸಾಕ್ ಹಾಳ್ ಕರುನ್ ಚೊವನಾಕ್ ಆಗ್ ಲಾವ್ನ್, ತೆಬಿಸಾಕ್ ರಾಜಧಾನಿ ಹೊಲ್ಲ್ಯಾ ಶಾರಾಕ್ ಶಿಕ್ಷ್ಯಾ ದಿತಾ. <verse eid="EZK 30:14" /><verse number="15" style="v" sid="EZK 30:15" />ಇಜಿಪ್ತಾಕ್ ರಾಕ್ವನಿಚೆ ಖಿಲ್ಲೊ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ, ಸಿನಿಚ್ಯಾ ವರ್‍ತಿ ಮಾಜೊ ರಾಗ್ ವೊತುನ್, ಮೊಂಪಿಶ್ ಶಾರಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ಕಾತ್ರುನ್ ಟಾಕ್ತಾ. <verse eid="EZK 30:15" /><verse number="16" style="v" sid="EZK 30:16" />ಮಿಯಾ ಇಜಿಪ್ತಾಕ್ ಆಗ್ ಲಾವ್ತಾನಾ ಪೆಲುಸಿಮಾಕ್ ಮರ್ನಾಚೊ ಅನ್ಬೊಗ್ ಹೊತಾ, ತೆಬಿಸ್ ಮರ್ಯಾದಿಕ್ ವಾಟೊ ಹೊತಾ, ಮೊಂಪಿಶ್ ಶಾರಾಚ್ಯಾ ವರ್‍ತಿ ಶತ್ರು ದೊಪಾರಾಕುಚ್ ಪಡ್ತಾತ್. <verse eid="EZK 30:16" /><verse number="17" style="v" sid="EZK 30:17" />ಒನಾಚಿ ಅನಿ ಪಿಬೆಸೆತಿಚಿ ದಾಂಡ್ಗಿ ಮಾನ್ಸಾ ತಲ್ವಾರಿನ್ ಮರ್ನಾತ್, ಥೈತ್ಲಿ ವಸ್ತಿ ರಾತಲಿ ಲೊಕಾ ಬಂಧಿ ಹೊವ್ನ್ ಜಾತಾತ್. <verse eid="EZK 30:17" /><verse number="18" style="v" sid="EZK 30:18" />ಇಜಿಪ್ತಾನ್ ವಾವಲ್ಲಿ ರಾಜ್ ದಂಡಾ ಮಿಯಾ ತಹಪೆಸಿತ್ ಮೊಡ್ತಾನಾ ಥೈ ದಿಸ್ ಉಗ್ವಿನಾ, ತೆಚಿ ಬಳ್ ಘಮಂಡ್ ನಿಪುನ್ ಜಾತಾ, ಥೈ ಕಾಳೊ ಕಿಟ್ಟ್ ಕಾಳ್ಕಾಚೊ ಮೊಡ್ ತೆಕಾ ಧಾಪ್ತಾ, ತೆಂಚಿ ಚೆಡ್ವಾ ಬಂಧಿ ಕರುನ್ ನ್ಹೆವ್ನ್ ಹೊತಾ. <verse eid="EZK 30:18" /><verse number="19" style="v" sid="EZK 30:19" />ಅಸೆ ಮಿಯಾ ಇಜಿಪ್ತಾಚ್ಯಾಕ್ನಿ ಶಿಕ್ಷ್ಯಾ ದಿವ್ನ್ ಸಾರ್ತಾನಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತೆಂಕಾ ಕಳ್ತಾ.<verse eid="EZK 30:19" /></para>
  <para style="s">ಇಜಿಪ್ತಾಚ್ಯಾ ರಾಜಾಚಿ ಬಳ್ ಕಮ್ಮಿ ಹೊತಲೆ</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 30:20" />ಜೆಹುಜಾಕಿಮ್ ಬಂಧಿ ಹೊಲ್ಲ್ಯಾ ಆಕ್ರಾವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಪಯ್ಲೆಚ್ಯಾ ಮ್ಹೈನ್ಯಾಚ್ಯಾ ಸಾತ್ವ್ಯಾ ದಿಸಾತ್ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಜ್ಯಾಕ್ಡೆ ಬೊಲ್ಲ್ಯಾನ್. <verse eid="EZK 30:20" /><verse number="21" style="v" sid="EZK 30:21" />ನರ್ ಮಾನ್ಸಾ, ಮಿಯಾ ಇಜಿಪ್ತಾಚೊ ರಾಜಾ ಫಾರೊವಾಚೊ ಹಾತ್ ಮೊಡುನ್ ಟಾಕ್ಲಾ, ಅಬಕ್ ತೆಕಾ ಕೊನ್ಬಿ ಭಾಂದುಕ್ನಾತ್, ವಕಾತ್ ಲಾವ್ಕ್ ನಾತ್, ತೆ ತಲ್ವಾರ್ ಧರಿ ಸಾರ್ಕೆ ತವ್ಡೆ ಬಳಾನ್ ಭರುಕ್ ತೆಕಾ ಕೊನಿಬಿ ಕಪ್ಡೆ ಭಾಂದುನ್ ಘಟ್ ಕರುಕ್ನಾತ್. <verse eid="EZK 30:21" /><verse number="22" style="v" sid="EZK 30:22" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮಿಯಾ ಇಜಿಪ್ತಾಚೊ ರಾಜಾಫಾರೊವಾಕ್ ವಿರೊದ್ ಹೊವ್ನ್, ತೆಜ್ಯಾ ದೊನಿ ಬಾವ್ಳ್ಯಾಕ್ನಿ ಮಟ್ಲ್ಯಾರ್ ಸಮಾ ಹೊತ್ತ್ಯಾಕ್ ಅನಿ ಮೊಡಲ್ಲ್ಯಾಕ್ ಅನಿಬಿ ಲೈಚ್ ಮೊಡುನ್ ತೆಜ್ಯಾ ಹಾತಾಕ್ನಿ ತಲ್ವಾರಿನ್ ಪಡಿಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 30:22" /><verse number="23" style="v" sid="EZK 30:23" />ಇಜಿಪ್ತಾಚ್ಯಾಕ್ನಿ ಲೊಕಾಕ್ನಿ ಪಗ್ಳುನ್ ದೆಸಾತ್ನಿ ಹುಡ್ವುನ್ ಟಾಕ್ತಾ. <verse eid="EZK 30:23" /><verse number="24" style="v" sid="EZK 30:24" />ಮಿಯಾ ಬಾಬೆಲಾಚ್ಯಾ ರಾಜಾಚ್ಯಾ ಹಾತಾಕ್ನಿ ಬಳ್ ಹಾನುನ್ ತೆಜ್ಯಾ ಹಾತಿತ್ನಿ ಮಾಜೊ ತಲ್ವಾರ್ ದಿವ್ನ್, ಫಾರೊವಾಚಿ ಹಾತಾ ಮೊಡುಕ್ ಲಾವ್ತಾನಾ, ಘಾವ್ ಹೊವ್ನ್ ಮರ್ನಾಚೊ ತರಾಸ್ ಯೆಲ್ಲ್ಯಾಸಾರ್ಕೆ ಫಾರೊವ್ ತ್ಯಾ ರಾಜ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ನರಳ್ತಾ. <verse eid="EZK 30:24" /><verse number="25" style="v" sid="EZK 30:25" />ಮಿಯಾ ಬಾಬೆಲಾಚ್ಯಾ ರಾಜಾಚಿ ಹಾತಾ ಬಳಾನ್ ಭರ್ತಾ, ಫಾರೊವಾಚಿ ಹಾತ್ ಲೊಂಬಾತ್ ಪಡ್ತಾತ್, ಮಿಯಾ ಮಾಜೊ ತಲ್ವಾರ್ ಬಾಬೆಲಾಚ್ಯಾ ರಾಜಾಕ್ ದಿತಾನಾ, ತೊ ತ್ಯಾ ತಲ್ವಾರಾಕ್ ಇಜಿಪ್ತಾಚ್ಯಾ ವರ್‍ತಿ ಉಕಲ್ತಾ, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಸಗ್ಳ್ಯಾಕ್ನಿ ಕಳ್ತಾ. <verse eid="EZK 30:25" /><verse number="26" style="v" sid="EZK 30:26" />ಮಿಯಾ ಇಜಿಪ್ತಾಚ್ಯಾಕ್ನಿ ಲೊಕಾತ್ನಿ ಪಗ್ಳುನ್, ದೆಶ್ಯಾತ್ನಿ ಹುಡ್ವುನ್ ಟಾಕ್ತಾನಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತೆಂಕಾ ಕಳ್ವುನ್ ಯೆತಾ.<verse eid="EZK 30:26" /></para>
  <chapter eid="EZK 30" />
  <chapter number="31" style="c" sid="EZK 31" />
  <para style="s">ಇಜಿಪ್ತಾನ್ ಎಕ್ ದೆವ್ದಾರ್ ಝಾಡಾಕ್ ಹೊಲ್ಕಿ ಕರಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 31:1" />ಜೆಹುಜಾಕಿಮ್ ಬಂಧಿಹೊಲ್ಲ್ಯಾ ಆಕ್ರಾವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ತಿನ್ವೆಚ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಪಯ್ಲೆಚ್ಯಾ ದಿಸಾತ್, ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಸರ್ವೆಸ್ಪರಾನ್ ಬೊಲ್ಲ್ಯಾನ್. <verse eid="EZK 31:1" /><verse number="2" style="v" sid="EZK 31:2" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಇಜಿಪ್ತಾಚೊ ರಾಜಾ ಫಾರೊವಾಕ್ ಅನಿ ಮ್ಹೆಜುಕ್ ಹೊಯ್ನಾ ತವ್ಡ್ಯಾ ಲೊಕಾಕ್ನಿ ಅಸೆ ಸಾಂಗ್, ಮೊಟೆ ಪಾನಾತ್ ತುಕಾ ಸಮಾ ಕೊನ್? <verse eid="EZK 31:2" /><verse number="3" style="v" sid="EZK 31:3" />ಆಹಾ, ಅಸಿರಿಯಾ ಲೆಬನೊನಿಯಾತ್ಲೆ ಎಕ್ ದೆವಾದಾರಾಚೆ ಝಾಡ್ ಹೊತ್ತೆ, ತೆಚೆ ಫಾಟೆ ಸುಂದರ್, ತೆಚಿ ಸಾವ್ಳಿ ದಾಟ್, ತೆಚಿ ಲಾಂಬ್ ಪಾನಾ ಲೈ ತೆಚಿ ತುದಿ ಮೊಡುಕ್ ಲಾಗ್ತಾ. <verse eid="EZK 31:3" /><verse number="4" style="v" sid="EZK 31:4" />ತೆಕಾ ಪಾನಿಯಾಚ್ಯಾ ಹಂವಾರ್ಯಾನಿ ವಾಡ್ವುಲ್ಯಾನಿ, ಮೊಟ್ಟ್ಯಾ ನ್ಹಯಿನ್ ಮೊಟಿ ಕರ್‍ಲಿನ್, ನ್ಹಯಿಚ್ಯಾ ಫಾಟ್ಯಾನಿ ಥೈ ಹೊತ್ತ್ಯಾ ಮ್ಹಳ್ಯಾಕ್ ಸುತ್ತ್ ಘಾಟ್ಲ್ಯಾನಿ, ಜಿಮ್ನಿಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಝಾಡಾಕ್ನಿ ನ್ಹಯಿನ್ ಅಪ್ನಾಚಿ ಕಾಲ್ಗಿಯಾ ದಿಲ್ಯಾನಿ. <verse eid="EZK 31:4" /><verse number="5" style="v" sid="EZK 31:5" />ಅಸೆ ರ್‍ಹಾತಾನಾ ತೆ ಝಾಡ್ ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಝಾಡಾಂಚ್ಯಾನ್ಬಿ ಲೈ ವರ್‍ತಿ ಹೊತ್ತೆ. ತೆಚಿ ಟಾಂಕಿಯಾ ಲೈ ಬರಿ ಹೊತ್ತಿ ಥೈ ಪಾನಿಯಾಚೊ ಜಾಗೊ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತೆಚೆ ಫಾಟೆ ಲೈ ಲಾಂಬ್ ಹೊಲ್ಲೆ ಅನಿ ಪಗಳಲ್ಲೆ. <verse eid="EZK 31:5" /><verse number="6" style="v" sid="EZK 31:6" />ಸಗ್ಳಿ ಮಳ್ಬಾತ್ಲಿ ಫಾಕ್ರಾ ತೆಜ್ಯಾ ಟಾಂಕಿಯಾ ವಯ್ನಿ ಘುಡ್ ಕರುನ್ಗೆವ್ನ್ ಹೊತ್ತಿ. ಸಗ್ಳಿ ಜಿಮ್ನಿ ವಯ್ನಿ ಜನಾವರಾ ತೆಜ್ಯಾ ಟಾಂಕಿಯಾಂಚ್ಯಾ ಖಾಲ್ತಿ ರ್‍ಹಾವ್ನ್ ಘೆವ್ನ್ ಪೆಟ್ಯಾಕ್ನಿ ಜಲಮ್ ದಿಯ್ತ್ ಮೊಟ್ಟ್ಯಾ ಲೊಕಾನಿ ತೆಜ್ಯಾ ಸಾವ್ಳಿಕ್ ಆಧಾರ್ ಕರುನ್ಗೆವ್ನ್ ಹೊತ್ತ್ಯಾನಿ. <verse eid="EZK 31:6" /><verse number="7" style="v" sid="EZK 31:7" />ತೆಜ್ಯಾ ಮುಳಾಕ್ ಪಾನಿಯಾಚೊ ಆಧಾರ್ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ತೆ ಝಾಡ್ ಲಾಂಬ್ ಅನಿ ಟಾಂಕಿಯಾಂಚ್ಯಾ ಲಾಂಬ್ ಪಾನಾನ್ ಡೊಳ್ಯಾಕ್ ಬರೆ ದಿಸಿತ್. <verse eid="EZK 31:7" /><verse number="8" style="v" sid="EZK 31:8" />ದೆವಾಚ್ಯಾ ಮ್ಹಳ್ಯಾತ್ಲಿ ದೆವಾದಾರು ಝಾಡಾನಿ ತೆಕಾ ಧಾಪುಕ್ ಹೊವ್ಕ್ ನಾ, ತುರಾಯಿಚಿ ಝಾಡಾ ತೆಂಚ್ಯಾ ಟಾಂಕಿಯಾಂಚ್ಯಾ ತವ್ಡಿ ಲಾಂಬ್ ಹೊವ್ಕ್ ನಾತ್, ವಡ್ಡಾಚಿ ಝಾಡಾ ತೆಜ್ಯಾ ಟಾಂಕಿಯಾಂಚ್ಯಾ ತವ್ಡಿ ಮೊಟಿ ಹೊವ್ಕ್ ನಾತ್. ದೆವಾಚ್ಯಾ ಮ್ಹಳ್ಯಾತ್ಲೆ ಎಕ್ ಝಾಡ್ ಬಿ ತೆಜ್ಯಾ ತವ್ಡೆ ಶೊಬಿತ್ ಹೊವ್ಕ್ ನಾ. <verse eid="EZK 31:8" /><verse number="9" style="v" sid="EZK 31:9" />ಮಿಯಾ ತೆಕಾ ಲೈ ಟಾಂಕಿಯಾ ಅನಿ ಬಾರಿಕ್ ಟಾಂಕಿಯಾನಿ ಶಿಂಗಾರ್ ಕರ್ಲೊ, ದೆವಾಚೊ ಮ್ಹಳೊ ಎದೆನಾಚಿ ಸಗ್ಳಿ ಝಾಡಾ ತೆಕಾ ಬಗುನ್ ಕುಸ್ಡೆಪಾನ್ ಕರಿತ್. <verse eid="EZK 31:9" /><verse number="10" style="v" sid="EZK 31:10" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಧನ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಅಸೊ ಮನ್ತಾ, ತೆ ಝಾಡ್ ಲೈ ಲಾಂಬ್ ಹೊವ್ನ್ ವಾಡುನ್ ಅಪ್ನಾಚಿ ತುದಿ ಮೊಡುಕ್ ಲಾವ್ನ್, ಅಪ್ನಾಚ್ಯಾ ಸುಂದರ್ ಪಾನಾಚ್ಯಾ ವಿಶಯಾತ್ ಬಡಾಯ್ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, <verse eid="EZK 31:10" /><verse number="11" style="v" sid="EZK 31:11" />ಮಿಯಾ ತೆಕಾ ಲೊಕಾಕ್ನಿ ಲೈ ಬಲಿಶ್ಟ್ ಮಾನ್ಸಾಚ್ಯಾ ಹಾತಿತ್ ದಿಲಾ, ತೊ ತೆಜ್ಯಾ ಬುರ್ಸ್ಯಾಪಾನಾಕ್ ಸಮಾ ಹೊಯ್ ಸಾರ್ಕೆ ತೆಕಾ ಶಿಕ್ಷ್ಯಾ ದಿತ್ಯಾಚ್. ಮಿಯಾ ತೆಕಾ ಡಕ್ಳುನ್ ಟಾಕ್ಲೊ. <verse eid="EZK 31:11" /><verse number="12" style="v" sid="EZK 31:12" />ಲೈ ಭಯಂಕರ್ ದುಸ್ರ್ಯಾ ದೆಶಾಚ್ಯಾ ಲೊಕಾನಿ ತೆಕಾ ತೊಡುನ್ ಟಾಕುನ್ ಘೆತಾತ್, ತೆಚಿ ಟಾಂಕಿಯಾ ಮಡ್ಡಿಯಾ ವಯ್ನಿ ಅನಿ ಸಗ್ಳ್ಯಾ ನ್ಹಯಾತ್ನಿಬಿ ಪಡ್ಲಾತ್. ಅನಿ ತೆಚಿ ಟಾಂಕಿಯಾ ದೆಶಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಕೊಡ್ಲಾಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ಮೊಡುನ್ ಟಾಕುನ್ ಹೊಲಾತ್, ಸಗ್ಳಿ ಲೊಕಾ ತೆಜ್ಯಾ ಸಾವ್ಳಿಕ್ನಾ ತೆಕಾ ಸೊಡುನ್ ಗೆಲ್ಯಾತ್. <verse eid="EZK 31:12" /><verse number="13" style="v" sid="EZK 31:13" />ಪಡಲ್ಲ್ಯಾ ಬುಡ್ಚಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಸಗ್ಳಿ ಮಳ್ಬಾತ್ಲಿ ಫಾಕ್ರಾ ಭರುನ್ ಹಾತ್, ತೆಜ್ಯಾ ಟಾಂಕಿಯಾಕ್ನಿ ಸಗ್ಳಿ ಜಿಮ್ನಿ ವಯ್ಲಿ ಜನಾವರಾ ತುಡ್ವುತಾತ್. <verse eid="EZK 31:13" /><verse number="14" style="v" sid="EZK 31:14" />ಪಾನಿಯಾಚ್ಯಾ ಜಾಗ್ಯಾ ವಯ್ನಿ ಖಲಿ ಝಾಡಾಬಿ ಅಪ್ನಾಬಿ ಅಪ್ನಾಚಿ ಪಾಟೆ ಲೈ ವಾಡ್ವುನ್ ಘೆಟಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ಅಪ್ನಾಚಿ ತುದಿಯಾ ಮಳ್ಬಾಕ್ ಲಾಯ್ ನಸ್ತಾನಾ ರಾಂವ್ದಿತ್, ಮನುನ್ ಪಾನಿ ವಡುನ್ ಘೆವ್ನ್ ಲಾಗಲ್ಲಿ ಮೊಟಿ ಮೊಟಿ ಝಾಡಾ ಉಂಚ್ಚ್ ಹೊವ್ನ್ ಬಡಾಯ್ ಕರಿನಸ್ತಾನಾ ರಾಂವ್ದಿತ್ ಮನುನ್ ಅಸೆ ಹೊಲೆ, ತಿ ಸಗ್ಳಿ ಮರ್ನಾಕ್ ಗುರಿ ಹೊತಾತ್, ತೆಂಕಾ ನರಕುಚ್ ಗತ್ ಪಾತಾಳಾಕ್ ಉತ್ರುನ್ ಗೆಲ್ಲ್ಯಾಂಚ್ಯಾಕ್ನಾ ಮಿಳುನ್ ನರ್ ಮಾನ್ಸಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಎಕುಚ್ ತಾಂಡೊ ಹೊವ್ನ್ ಮಿಳ್ತಾತ್.<verse eid="EZK 31:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 31:15" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ತೆ ಝಾಡ್ ಪಾತಾಳಾಕ್ ಉತ್ರುನ್ ಗೆಲ್ಲ್ಯಾ ದಿಸಿ ಮಿಯಾ ದುಕ್ಕಾಚಿ ವಳಕ್ ದಾಕ್ವುಲೊ, ತೆಜ್ಯಾ ದುರ್ ಸಾಟ್ನಿ ಮಿಯಾ ಮೊಟ್ಟ್ಯಾ ನ್ಹಯಿಕ್ ಧಾಪ್ಲೊ, ಅನಿ ನ್ಹಯ್ಚ್ಯಾ ಫಾಟ್ಯಾಕ್ನಿ ಇಬೆ ಕರ್ಲೊ. ಪಾನಿಯಾಚೊ ಹೊವಾರೊ ಇಬೆ ರ್‍ಹಾಲೊ, ತೆಜ್ಯಾ ಸಾಟ್ನಿ ಲೆಬನೊನ್ ರಡಿಸಾರ್ಕೆ ಕರ್ಲೊ, ಜಿಮ್ನಿ ವಯ್ಲಿ ಸಗ್ಳಿ ಝಾಡಾಬಿ ತ್ಯಾ ದುಕ್ಕಾ ವಯ್ನಾ ವಾಳುನ್ ಪಡ್ಲಿ. <verse eid="EZK 31:15" /><verse number="16" style="v" sid="EZK 31:16" />ಮಿಯಾ ತೆಕಾ ಗಿರ್‍ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳ್ವುಚೆ ಮನುನ್ ಪಾತಾಳಾಕ್ ಢಕಳಲ್ಲ್ಯಾ ತನ್ನಾ ತೆ ಪಡಲ್ಲ್ಯಾ ಆವಾಜಾಕ್ ಸಗ್ಳಿ ಲೊಕಾ ಥರ್ಥಲಿ, ಅನಿ ಪಯ್ಲೆಚ್ಯಾ ಎಳಾರ್ ಪಾತಾಳಾಚೊ ವಾಟೊ ಹೊಲ್ಲಿ ಸಗ್ಳಿ ಎದೆನಾಚಿ ಝಾಡಾ ಲೆಬೊನಾಚಿ ಬರಿ ಝಾಡಾ ಸಗ್ಳಿ ಪಾನಿಯಾಚ್ಯಾ ದಂಡೆಕ್ ಹೊತ್ತಿ ಝಾಡಾ ಸಗ್ಳಿ ಥೈ ಸಮಾದಾನ್ ಹೊಲ್ಯಾನಿ. <verse eid="EZK 31:16" /><verse number="17" style="v" sid="EZK 31:17" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಭುಜಾಚಿ ಬಳ್ ಹೊವ್ನ್ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ತೆಚೆ ಸಾವ್ಳಿ ಆಧಾರ್ ಕರುನ್ಗೆವ್ನ್ ಹೊತ್ತ್ಯಾನಿ ತೆಜ್ಯಾ ವಾಂಗ್ಡಾ ಪಾತಾಳಾಕ್ ಉತ್ರುನ್ ತಲ್ವಾರಾನ್ ಮರ್ತಲ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳ್ಳ್ಯಾನಿ. <verse eid="EZK 31:17" /><verse number="18" style="v" sid="EZK 31:18" />ಅಸ್ಲ್ಯಾ ವಯ್ಬವಾನ್ ಅನಿ ಮಹಿಮಾನ್ ಭರಲ್ಲೊ, ಜಾಲ್ಯಾರ್ ಎದೆನಾಚ್ಯಾ ಝಾಡಾತ್ನಿ ಖಲ್ಯಾತ್ ಕಮ್ಮಿಚೊ? ಖರೆ ತಿಯಾ ಎದೆನಾಚ್ಯಾ ಝಾಡ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಪಾತಾಳಾಕ್ ಢಕ್ಲುನ್ ಹೊವ್ನ್ ಸುನ್ನತ್ ನಸಲ್ಲ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ತಲ್ವಾರಾನ್ ಮಾರುನ್ ಹೊಲ್ಲ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳುನ್ ರಾತಯ್, ಫಾರೊವಾಕ್ ಅನಿ ತೆಜ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿಬಿ ತುಕಾ ಯೆಲ್ಲಿ ಅನಿ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿಬಿ ಹಿ ಗತುಚ್ ಯೆತಾ. ಹೆ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 31:18" /></para>
  <chapter eid="EZK 31" />
  <chapter number="32" style="c" sid="EZK 32" />
  <para style="s">ಇಜಿಪ್ತಾಚ್ಯಾ ರಾಜಾಕ್ ಸುಸ್ವಾರಾಕ್ ಹೊಲ್ಕಿ ಕರಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 32:1" />ಜೆಹೊವಾಜಾಕಿಮ್ ಬಂದಿ ಹೊಲ್ಲ್ಯಾ ಬಾರಾವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಬಾರಾವ್ಯಾ ಮ್ಹೈನ್ಯಾಚ್ಯಾ ಪಯ್ಲೆಚ್ಯಾ ದಿಸಾತ್ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲ್ಯಾನ್. <verse eid="EZK 32:1" /><verse number="2" style="v" sid="EZK 32:2" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಇಜಿಪ್ತಾಚೊ ರಾಜಾ ಫರೊವಾಚ್ಯಾ ವಿಶಯಾತ್ ದುಕ್ಕಾಚಿ ಗಿತ್ ಸಾಂಗುನ್, ತೆಕಾ ಅಸೆ ಸಾಂಗ್, ತಿಯಾ ಲೊಕಾತ್ನಿ ದಾಂಡ್ಗೊ ಸಿಂವ್ ಸಾರ್ಕೊ ಬಲ್ವಾನ್ ಮನ್ವುನ್ ಘೆತಯ್, ಅಬಕ್ ಮೊಟ್ಟ್ಯಾ ನ್ಹಯಿತ್ಲೊ ಮೊಟೊ ಸಾಂಪ್ ಹೊಲೆಯ್, ತಿಯಾ ಹೊತ್ತಿ ನ್ಹಯಾ ವಾಟೆ ಕರುನ್ಗೆವ್ನ್ ಎವ್ನ್, ತುಜ್ಯಾ ಪಾಂಯಾನಿ ಪಾನಿಯಾಕ್ ಕಾಲ್ವುನ್, ದೆಶಾಂಚಿ ನ್ಹಯಾ ತುಡ್ವುನ್ ಮಾಟಿನ್ ಧಾಪ್ಲೊ. <verse eid="EZK 32:2" /><verse number="3" style="v" sid="EZK 32:3" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ತಾಂಡೊ ಹೊವ್ನ್ ಗೊಳಾ ಹೊವ್ನ್ ಲೈ ಲೊಕಾಂಚ್ಯಾ ಹಾತಿತ್ನಾ, ಮಿಯಾ ಮಾಜೆ ಬಲಿ ತುಜ್ಯಾ ವರ್‍ತಿ ಟಾಕ್ತಾ, ತೆನಿ ತುಕಾ ಬಲಿ ವರ್‍ತಿ ವಡುನ್ಗೆತಾತ್. <verse eid="EZK 32:3" /><verse number="4" style="v" sid="EZK 32:4" />ಮಿಯಾ ತುಕಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಘಾಲ್ತಾ, ತುಕಾ ಮ್ಹಾಳ್ ಜಾಗ್ಯಾವರ್‍ತಿ ಟಾಕುನ್ ಸಗ್ಳಿ ಮಳ್ಬಾತ್ಲಿ ಫಾಂಕ್ರಾ ತುಜ್ಯಾ ವರ್‍ತಿ ಪಡಿ ಸಾರ್ಕೆ ಕರ್ತಾ, ಅನಿ ಸಗ್ಳ್ಯಾ ಜಿಮ್ನಿ ವಯ್ಲ್ಯಾ ಜನಾವರಾಕ್ನಿ ತುಜ್ಯಾ ವಯ್ನಾ ಪೊಟ್ ಭರುನ್ ಘೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 32:4" /><verse number="5" style="v" sid="EZK 32:5" />ತುಜೆ ಮಾಂಸ್ ಮಡ್ಡಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಟಾಕುನ್, ಕೊಳ್ಳಾಕ್ನಿ ತುಜ್ಯಾ ಮ್ಹಡ್ಯಾಚ್ಯಾ ತುಕ್ಡ್ಯಾನಿ ಭರುನ್, <verse eid="EZK 32:5" /><verse number="6" style="v" sid="EZK 32:6" />ತುಜ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಹೊಂವಾರ್ಯ್ಯಾನ್ ಸಗ್ಳ್ಯಾ ದೆಸಾಕ್ ಮಡ್ಡಿಯಾಂಚ್ಯಾ ಪತರ್ ಭಿಜ್ವುತಾ, ತುಜೆನ್ ನ್ಹಯ್ಯಾ ಭರ್ತಾತ್.<verse eid="EZK 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 32:7" />ಫಾರೊವಾ ಮಿಯಾ ತುಜ್ಯಾ ಉಜ್ವೊಡಾಕ್ ಇಜ್ವುತಾನಾ, ಮಳ್ಬಾಕ್ ಧಾಪುನ್, ಥೈ ಹೊತ್ತ್ಯಾ ಚುಕ್ಕಿಯಾಕ್ನಿ ಮಬ್ಬ್ ಕರುನ್, ದಿಸಾಕ್ ಮೊಡಾನಿ ಧಾಪ್ತಾ, ಚಂದಾಮ್ ಬಿ ಉಜ್ವೊಡ್ ದಿಯ್ನಾ. <verse eid="EZK 32:7" /><verse number="8" style="v" sid="EZK 32:8" />ತುಜ್ಯಾ ವರ್‍ತಿ ಮಳ್ಬಾತ್ ಹೊಳಾವ್ತಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಉಜ್ವೊಡಾಕ್ನಿ ಮಿಯಾ ಮಬ್ಬ್ ಕರುನ್, ತುಜ್ಯಾ ದೆಸಾತ್ ಕಾಳೊಕ್ ಕರ್ತಾ, ಹಿ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ. <verse eid="EZK 32:8" /><verse number="9" style="v" sid="EZK 32:9" />ಮಿಯಾ ತುಜ್ಯಾ ನಾಶಾಚಿ ಖಬರ್ ಲೊಕಾತ್ನಿ ತುಕಾ ಕಳಿನಸಲ್ಲ್ಯಾ ದೆಸಾಕ್ನಿಬಿ ಪಾವ್ಸುತಾನಾ, ತೆ ಲೈ ಲೊಕಾಂಚಿ ಮನಾ ಕಳ್ವಳ್ತಾ. <verse eid="EZK 32:9" /><verse number="10" style="v" sid="EZK 32:10" />ಹೊಯ್ ತುಜ್ಯಾ ಗತಿಕ್ ಬಗುನ್ ಲೈ ಲೊಕಾ ಭಿಂಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಮಿಯಾ ಮಾಜೊ ತಲ್ವಾರ್ ತೆಂಚ್ಯಾ ರಾಜಾಚ್ಯಾ ಡೊಳ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ಇಂಜಳ್ತಾನಾ, ತೆನಿ ತುಜಿ ಬುರ್ಶಿ ಗತ್ ಬಗುನ್, ಲೈ ಭಿಂವ್ತಾತ್, ತುಜ್ಯಾ ಹಾರ್ತಲ್ಯಾ ದಿಸಾತ್ನಿ ಹರ್ ಎಕ್ಲೊಬಿ ಅಪ್ನಾ ಅಪ್ನಾಚ್ಯಾ ಜಿವಾಚ್ಯಾ ಭಿಂಯಾಕ್ ಗಡ್ ಗಡ್ ಥರ್ಥರ್ತಾ.<verse eid="EZK 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 32:11" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಬಾಬೆಲಾಚ್ಯಾ ರಾಜಾಚೊ ತಲ್ವಾರ್ ತುಕಾ ವಿರೊದ್ ಹೊವ್ನ್ ವರ್‍ತಿ ಪಡ್ತಾ. <verse eid="EZK 32:11" /><verse number="12" style="v" sid="EZK 32:12" />ಮಿಯಾ ತುಜ್ಯಾ ಲೈ ಲೊಕಾಕ್ನಿ, ಲೈ ಭಯಂಕರ್ ಲೊಕ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ತಾಕ್ತಿಚ್ಯಾ ಮಾನ್ಸಾಂಚ್ಯಾ ಹಾತಿತ್ ತಲ್ವಾರಾನಿ ಮಾರುಕ್ ಲಾವ್ತಾ, ಇಜಿಪ್ತಾಕ್ ಘಮೆಂಡಿ ಹಾನ್ತಲೆ ಸಗ್ಳೆ ತೆನಿ ಲುಟ್ ಕರುನ್ ಘೆವ್ನ್ ಜಾತಾತ್, ತೆಚಿ ಲೊಕಾ ಕನ್ನಾಬಿ ನಾಶ್ ಹೊವ್ನ್ ಜಾತಾತ್. <verse eid="EZK 32:12" /><verse number="13" style="v" sid="EZK 32:13" />ಲೈ ಹೊವಾರೊ ಯೆತಲ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ದಂಡೆಕ್ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಜನಾವರಾಕ್ನಿ ನಾಶ್ ಕರ್ತಾ, ತ್ಯಾ ಪಾನಿಯಾಕ್ ಕಾಲ್ವುಕ್ ಖಲೊ ಮಾನುಸ್ಬಿ ಥೈ ಪಾಂಯ್ ಥೈ ನಾ, ಖಲ್ಯಾ ಜನಾವರಾಚಿ ಗೆಳಾಚ್ಬಿ ಥೈ ಲಾಗಿನಾತ್. <verse eid="EZK 32:13" /><verse number="14" style="v" sid="EZK 32:14" />ತನ್ನಾ ತೆ ಪಾನಿ ಪಾತೊಳ್ ಅನಿ ಹೊಂವಾರೆ ತೆಲಾ ಸಾರ್ಕೆ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಮನ್ತಲಿ ಹಿ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 32:14" /><verse number="15" style="v" sid="EZK 32:15" />ಮಿಯಾ ಇಜಿಪ್ತಾತ್ ಭರಲ್ಲೆ ಸಗ್ಳೆ ಸಾವ್ಕಾರ್ಕಿ ಪಾನ್ ಹಾಳ್ ಕರುನ್, ಥೈ ವಸ್ತಿ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ನಾಶ್ ಕರಲ್ಲ್ಯಾ ತನ್ನಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಸಗ್ಳ್ಯಾಕ್ನಿ ಕಳ್ತಾ. <verse eid="EZK 32:15" /><verse number="16" style="v" sid="EZK 32:16" />ಉದ್ದೆಸ್ ಕಾರಾನಿ ಹಿ ಆಳಾಪಾಚಿ ಗಿತ್ ಗಾವುಚೆ, ಲೊಕಾಂಚಿ ದಾಂಡ್ಗಿ ಚೆಡ್ವಾ ಅಸೆ ಅಳಾಪ್ ಕರುಂದಿತ್, ಇಜಿಪ್ತಾ ಸಾಟ್ನಿ ಅನಿ ಥೈ ಹೊತ್ತ್ಯಾ ಲೈ ಲೊಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಅಳಾಪ್ ಕರುನ್ ಹಿ ಗಿತ್ ಗಾವುಂದಿತ್, ಮನ್ತಲಿ ಹೆ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 32:16" /></para>
  <para style="s">ಮರಲ್ಲ್ಯಾಂಚೊ ಜಗ್</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 32:17" />ಜೆಹೊವಾಜಾಕಿಮ್ ಬಂಧಿ ಹೊಲ್ಲ್ಯಾ ಬಾರಾವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಬಾರಾವ್ಯಾ ಮ್ಹಯ್ನ್ಯಾಚ್ಯಾ ಪಂದ್ರಾವ್ಯಾ ದಿಸಾತ್ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲ್ಯಾನ್. <verse eid="EZK 32:17" /><verse number="18" style="v" sid="EZK 32:18" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಮ್ಹೆಜುಕ್ ಹೊಯ್ನಸಲ್ಲ್ಯಾ ತವ್ಡ್ಯಾ ಸಯ್ನಿಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಅಳಾಪ್ ಕರುನ್ ಲೈ ಬಲಿಸ್ಟ್ ಲೊಕಾಕ್ನಿ ಗಿರ್‍ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಖೊಲಾತ್ಲ್ಯಾ ಜಗಾಕ್ ಡಕ್ಳುನ್ ಟಾಕ್. <verse eid="EZK 32:18" /><verse number="19" style="v" sid="EZK 32:19" />ಅನಿ ತೆಂಕಾ ತಿಯಾ ಸುಂದರ್ಪಾನಾತ್ ಕೊನಾಕಿಂತಾ ಕಮ್ಮಿ ಹಾಸ್? ತಿಯಾ ಮರ್ನಾಚ್ಯಾ ಜಗಾಕ್, ದೆವಾಕ್ ವಳ್ಕಿ ನಸಲ್ಲ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಖಾಲ್ತಿ ಉತ್ರುನ್ ಜಾ. <verse eid="EZK 32:19" /><verse number="20" style="v" sid="EZK 32:20" />ಆಹಾ, ತಲ್ವಾರಾನ್ ಮಾರಾನ್ ಹೊಲ್ಲ್ಯಾಂಚ್ಯಾ ಮದ್ದಿ ಪಡ್ತಾತ್, ತೆನಿ ತಲ್ವಾರಾಚೊ ವಾಟೊ ಹೊವ್ನ್ ಹಾತ್, ನಾಶಾಚ್ಯಾ ಜಗಾಚ್ಯಾ ಲೊಕಾನೊ, ಇಜಿಪ್ತಾಕ್ ಅನಿ ತೆಚ್ಯಾ ಲೈ ಲೊಕಾಕ್ನಿ ವಡುನ್ ಘೆವಾ. <verse eid="EZK 32:20" /><verse number="21" style="v" sid="EZK 32:21" />ಖೊಲಾತ್ಲ್ಯಾ ಜಗಾತ್ಲಿ ಬಲಿಶ್ಟ್ ಕಾರಾ ತೆಂಕಾ ಅನಿ ತೆಂಚ್ಯಾ ಮಜತ್ ಕಾರಾಕ್ನಿ ಬಗುನ್, ಅಬಕ್ ಹಿ ಸುನ್ನತ್ ನಸಲ್ಲಿ ಅನಿ ತಲ್ವಾರಾನ್ ಬಲಿ ಹೊಲ್ಲಿ ಲೊಕಾ ಖಾಲ್ತಿ ಉತ್ರುನ್ ಎವ್ನ್ ಹಿತ್ತೆ ಪಾವ್ಲಿ ಮಟ್ಲ್ಯಾನಿ. <verse eid="EZK 32:21" /><verse number="22" style="v" sid="EZK 32:22" />ಅಸ್ಸಿರಿಯಾಚಿ ಲೊಕಾ ಕನ್ನಾಬಿ ಥೈ ರ್‍ಹಾತ್ಯಾತ್, ಅನಿ ತಲ್ವಾರಾನ್ ಮರಾನ್ ಹೊಲ್ಲ್ಯಾ ತೆಂಚ್ಯಾ ಸೈನಿಕಾಂಚ್ಯಾ ಸಮಾಧಿಯಾ ತೆಂಚ್ಯಾ ಭೊತ್ಯಾನ್ ರ್‍ಹಾತ್ಯಾತ್. <verse eid="EZK 32:22" /><verse number="23" style="v" sid="EZK 32:23" />ತೆಂಚಿ ಸಮಾಧಿಯಾ ಖೊಲಾತ್ಲ್ಯಾ ಜಗಾಚ್ಯಾ ಮರ್ನಾಚ್ಯಾ ಜಾಗ್ಯಾ ವರ್‍ತಿ ಪಗ್ಳುನ್ ಹಾತ್, ಝಿತ್ತೆ ರ್‍ಹಾತಾನಾ ತಲ್ವಾರಾಕ್ ಗಾವ್ನ್ ಲೈ ತರಾಸಾಚೆ ಮರಾನ್ ಹೊಲ್ಲಿ ಅಸ್ಸಿರಿಯಾಚಿ ಸೈನಿಕಾ ತೆಜ್ಯಾ ಭೊತ್ಯಾನ್ ಹಾತ್. <verse eid="EZK 32:23" /><verse number="24" style="v" sid="EZK 32:24" />ಎಲಾಮ್ ಬಿ ಥೈ ಹಾಯ್, ಝಿತ್ತೆ ರ್‍ಹಾತಾನಾ ತಲ್ವಾರಾಕ್ ಗಾವ್ನ್ ಲೈ ಕಠಿನ್ ಮರ್ನಾಕ್ ಗುರಿಹೊಲ್ಲಿ ಸುನ್ನತ್ ನಸಲ್ಲ್ಯಾ ಸೈನಿಕಾಂಚಿ ಸಮಾಧಿಯಾ ತೆಜ್ಯಾ ಭೊತ್ಯಾನ್ ಹಾತ್, ಹೆನಿ ಸಗ್ಳೆ ಖೊಲಾಚ್ಯಾ ಜಗಾತ್ ಉತ್ರುನ್ ಗಿರ್‍ಯಾಂಚ್ಯಾ ಮದ್ದಿ ಅವ್ಮಾನಾಕ್ ಗುರಿ ಹೊಲಾತ್. <verse eid="EZK 32:24" /><verse number="25" style="v" sid="EZK 32:25" />ತೆಜ್ಯಾ ಸಾಟ್ನಿ ಸಗ್ಳ್ಯಾ ಮರಲ್ಲ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ನಿಜುಕ್ ಜಾಗೊ ತಯಾರ್ ಕರಲ್ಲೊ ಹಾಯ್, ತೆಜ್ಯಾ ಭೊತ್ಯಾನ್ ತ್ಯಾ ಲೊಕಾಂಚಿ ಸಮಾಧಿಯಾ ಹಾತ್, ತೆನಿ ಸಗ್ಳೆ ಸುನ್ನತ್ ನಸಲ್ಲೆ ಅನಿ ತಲ್ವಾರಾನ್ ಮರಲ್ಲೆ, ತೆಂಚ್ಯಾ ಜಿವ್ಮಾನಾತ್ ಲೈ ಕ್ರುರ್ ಅನಿ ಖೊಲ್ಲ್ಯಾ ಜಗಾಕ್ ಹೊವ್ನ್ ಹಾತ್, ತೆಂಚ್ಯಾ ಮದ್ದಿ ಎಲಾಮಿಕ್ ಜಾಗೊ ತಯಾರ್ ಕರಲ್ಲೊ ಹಾಯ್. <verse eid="EZK 32:25" /><verse number="26" style="v" sid="EZK 32:26" />ಮೆಶೆಕ್, ತುಬುಲ್ಬಿ ಅನಿ ತೆಂಚಿ ಸಗ್ಳಿ ಲೊಕಾ ಥೈ ರ್‍ಹಾತ್ಯಾತ್, ತ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಸಮಾಧಿಯಾ ತೆಂಕಾ ಭೊತ್ಯಾನ್ ಹಾತ್, ತೆನಿ ಸಗ್ಳೆ ಸುನ್ನತ್ ನಸಲ್ಲೆ ಅನಿ ತಲ್ವಾರಾನ್ ಮರಲ್ಲೆ, ಝಿತ್ತ್ಯಾ ಜಗಾತ್ ಲೈ ತರಾಸಾಚೆ ಹೊವ್ನ್ ಹೊತ್ತೆ. <verse eid="EZK 32:26" /><verse number="27" style="v" sid="EZK 32:27" />ಅದ್ಲ್ಯಾ ಎಳಾರ್ ಸುನ್ನತ್ ನಸಲ್ಲಿ ಬಲಿಶ್ಟ್ ಲೊಕಾ, ಲೈ ಕಟಿನ್ ಹೊವ್ನ್ ರ್‍ಹಾವ್ನ್, ಮರುನ್, ತೆಂಚ್ಯಾ ಹಾತಿಯಾರಾಂಚ್ಯಾ ವಾಂಗ್ಡಾಚ್ ಪಾತಾಳಾಕ್ ಪಡುನ್, ತಲ್ವಾರಾ ಉಸ್ಸೆ ಕರುನ್ಗೆವ್ನ್, ಅಪ್ನಾಚ್ಯಾ ಹಡ್ಡಾಂಚ್ಯಾ ವರ್‍ತಿ ಅಪ್ನಾಚೆ ಬುರ್ಸ್ಯಾ ಕಾಮಾಂಚೆ ವಜನ್ ಉಕ್ಲುನ್ಗೆವ್ನ್ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಮೆಶಿಕಿಚೆ ಅನಿ ತುಬುಲಾಚೆಬಿ ವಟ್ಕುನ್ ರ್‍ಹಾತ್ಯಾತ್.<verse eid="EZK 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 32:28" />ಫಾರೊವ್ ರಾಜಾ ತಿಯಾ ಸುನ್ನತ್ ನಸಲ್ಲ್ಯಾಂಚ್ಯಾ ಮದ್ದಿ ನಾಶ್ ಹೊವ್ನ್, ತಲ್ವಾರಾನ್ ಮಾರಲ್ಲ್ಯಾಂಚ್ಯಾ ಮದ್ದಿ ಪಡುನ್ ರಾತಯ್. <verse eid="EZK 32:28" /><verse number="29" style="v" sid="EZK 32:29" />ಥೈ ಎದೊಮ್ ಅನಿ ರಾಜಾ ಅನಿ ಸಗ್ಳಿ ಮುಂಖಡಾ, ತೆನಿ ಸಗ್ಳೆ ಬಲ್ವಾನ್ ರಾಜಾ, ತಲ್ವಾರಾನ್ ಮರಲ್ಲ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಥೈ ಪಡುನ್ ಹಾತ್. <verse eid="EZK 32:29" /><verse number="30" style="v" sid="EZK 32:30" />ಉತ್ತರ್ ದೆಶಾಚೆ ಸಗ್ಳೆ ರಾಜಾ, ಸಗ್ಳಿ ಚಿದೊನಾಚಿ ಲೊಕಾ, ಮರ್ನಾಕ್ ಗುರಿ ಹೊಲ್ಲ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಥೈ ಹಾತ್, ಅಪ್ನಾಚ್ಯಾ ಲೈ ಕಠಿನ್ ಹೊತ್ತ್ಯಾ ಕಸ್ರತಿಕ್ ಮರ್ಯಾದ್ ಹೊವ್ನ್, ತಲ್ವಾರಾನ್ ಮರಲ್ಯಾಂಚ್ಯಾ ಮದ್ದಿ ಸುನ್ನತ್ ನಸಲ್ಲೆ ಹೊವ್ನ್, ಪಡುನ್ ಖೊಲ್ಯಾ ಜಾಗ್ಯಾರ್ ಮದ್ದಿ ಅವ್ಮಾನ್ ಕರುನ್ಗೆವ್ಲಾತ್.<verse eid="EZK 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EZK 32:31" />ಫಾರೊವ್ ಹೆಂಕಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಬಗುನ್ ಅಪ್ನಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವಿಶಯಾತ್ ಸಮಾಧಾನ್ ಹೊತಾ, ಹೊಯ್ ತಲ್ವಾರಾಕ್ ಗಾವ್ನ್ ಮರಲ್ಲೊ ಫಾರೊವ್ ಅನಿ ತೆಚಿ ಸಗ್ಳಿ ಸಯ್ನಿಕಾ ಹೆ ಬಗುನ್ ಸಮಾಧಾನ್ ಹೊತಾತ್, ಹಿ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 32:31" /><verse number="32" style="v" sid="EZK 32:32" />ಅಬಕ್ ಸಗ್ಳ್ಯಾ ಝಿತ್ತೆ ಹೊತ್ತ್ಯಾ ಲೊಕಾತ್ನಿ ಮಿಯಾ ಮಾಜೆ ಭಿಂಯ್ಯೆ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ಲಾ, ಫಾರೊವ್ ಅನಿ ತೆಚಿ ಸಗ್ಳಿ ಲೊಕಾ ಅನಿ ಸುನ್ನತ್ ನಸಲ್ಯಾಂಚ್ಯಾ ತಲ್ವಾರಾಚ್ಯಾ ಮರ್ನಾಕ್ ಗುರಿ ಹೊಲ್ಲ್ಯಾಂಚ್ಯಾ ಮದ್ದಿ ವಟ್ಕುನ್ ಹಾತ್, ಮನ್ತಲಿ ಹಿ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 32:32" /></para>
  <chapter eid="EZK 32" />
  <chapter number="33" style="c" sid="EZK 33" />
  <para style="s">ದೆವಾನ್ ಎಜ್ಕೆಲಾಕ್ ಬಗುನ್ ಘೆತಲೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 33:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲ್ಯಾನ್, <verse eid="EZK 33:1" /><verse number="2" style="v" sid="EZK 33:2" />“ನರ್ ಮಾನ್ಸಾ, ತುಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಆಯ್ಕಿ ಸಾರ್ಕೆ ತೆಂಕಾ ಅಸೆ ಸಾಂಗ್, ಮಿಯಾ ದೆಶ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ತಲ್ವಾರ್ ಪಡ್ತಾನಾ, ತ್ಯಾ ದೆಶ್ಯಾಚೆ ಅಪ್ನಾಕ್ಡೆ ಎಚುನ್ ಎಗ್ಳುನ್ ಥವಲ್ಲ್ಯಾ ರಾಕ್ವಲ್ಯಾನ್. <verse eid="EZK 33:2" /><verse number="3" style="v" sid="EZK 33:3" />ದೆಶಾಚ್ಯಾ ವರ್‍ತಿ ಪಡ್ತಲ್ಯಾ ತಲ್ವಾರಾಕ್ ಬಗುನ್, ಸಿಂಗಾ ಸಾರ್ಕೊ ಭೊಂಗೊ ವಾಜ್ವುನ್ ಅಪ್ನಾಚ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಹುಶ್ಯಾರ್ಕಿ ದಿಲ್ಯಾರ್ಬಿ, <verse eid="EZK 33:3" /><verse number="4" style="v" sid="EZK 33:4" />ಸಿಂಗಾ ಸಾರ್ಕೊ ಭೊಂಗ್ಯಾಚಿ ಧನ್ ಆಯ್ಕಲ್ಲೊ ಕೊನ್ಬಿ ಹುಶ್ಯಾರ್ ಹೊಯ್ ನಸ್ತಾನಾ ಪಡ್ತಲ್ಯಾ ಕೊಯ್ತ್ಯಾಕ್ ಗಾವ್ನ್ ನಾಶ್ ಹೊಲ್ಯಾರ್, ಅಪ್ನಾಚ್ಯಾ ಮರ್ನಾಕ್ ಅಪ್ನಿಚ್ ಕಾರನ್ ಹೊತಾ. <verse eid="EZK 33:4" /><verse number="5" style="v" sid="EZK 33:5" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೊ ಸಿಂಗಾಚ್ಯಾ ಸಾರ್ಕೊ ಹೊತ್ತೊ ಪಂವ್ಯಾಚೊ ಆವಾಜ್ ಆಯ್ಕುನ್ಬಿ ಹುಶ್ಯಾರ್ ಹೊವ್ಕ್ ನಾ, ಅಪ್ನಾಚ್ಯಾ ಮರ್ನಾಕ್ ಅಪ್ನಿಚ್ ಕಾರನ್, ಹುಶ್ಯಾರ್ ಹೊಲ್ಲೊ ರಾಲ್ಯಾರ್ ಅಪ್ನಾಚೊ ಜಿವ್ ಹುರ್ವುನ್ ಘೆಯ್ ಹೊತ್ತೊ. <verse eid="EZK 33:5" /><verse number="6" style="v" sid="EZK 33:6" />ಖರೆ ರಾಕ್ವಲಿಕಾರಾನ್, ಪಡುಲಾಗಲ್ಲೊ ಕೊಯ್ತೊ ಬಗುನ್ಬಿ ಪಂವ್ವೊ ವಾಜ್ವಿ ನಸ್ತಾನಾ, ಸ್ವತ್ಯಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಹುಶ್ಯಾರ್ಕಿ ದಿಯ್ನಸ್ತಾನಾ ರ್‍ಹಾತಾನಾ, ತಲ್ವಾರ್ ಪಡುನ್ ತ್ಯಾ ಲೊಕಾತ್ನಿ ಕೊನಾಕ್ ತರಿಬಿ ನಾಶ್ ಕರ್ಲ್ಯಾರ್, ಅಪ್ನಾಚ್ಯಾ ಬುರ್ಸ್ಯಾಪಾನಾನ್ ಮಾನ್ಸಾಚ್ಯಾ ಮರ್ನಾಕ್ ಗುರಿ ಹೊಲ್ಲ್ಯಾ ರಾಕ್ವಲ್ಯಾಕ್ ಸೆಡ್ ಕಾಡುನ್ ಘೆತಾ”.<verse eid="EZK 33:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 33:7" />ನರ್ ಮಾನ್ಸಾ, ಮಿಯಾ ತುಕಾ ಇಜ್ರಾಯೆಲಾಕ್ನಿ ರಾಕ್ವಲಿ ಕರುನ್ ನೆಮ್ಲಾ, ತಸೆ ಹೊವ್ನ್, ತಿಯಾ ಮಾಜೊ ಖಬ್ರಿಕಾರ್, ಮಾಜ್ಯಾ ತೊಂಡಾತ್ನಾ ಯೆತಲ್ಯಾ ಗೊಸ್ಟಿಯಾ ಆಯ್ಕುನ್, ತೆಂಕಾ ಜಾಗ್ವು. <verse eid="EZK 33:7" /><verse number="8" style="v" sid="EZK 33:8" />ಮಿಯಾ ಬುರ್ಸ್ಯಾ ಮಾನ್ಸಾಕ್, ಬುರ್ಸ್ಯಾ ಮಾನ್ಸಾ, ತಿಯಾ ಖರೆಚ್ ಮರ್ತೆಯ್, ಮನುನ್ ಬೊಲ್ತಾನಾ, ತಿಯಾ ತ್ಯಾ ಬುರ್ಸ್ಯಾ ಮಾನ್ಸಾಕ್ ಮರುನುಚ್ ಮರ್ತೆಯ್ ಮನುನ್ ಸಾಂಗ್ತಾನಾ, ತಿಯಾ ತ್ಯಾ ಬುರ್ಸ್ಯಾ ಮಾನ್ಸಾಕ್ ಅಪ್ನಾಚ್ಯಾ ಬುರ್ಸ್ಯಾ ವಾಟೆಕ್ನಾ ಚುಕ್ವುಕ್ ತೆಕಾ ಹುಶ್ಯಾರ್ಕಿ ದಿಯ್ನಸ್ತಾನಾ ಗೆಲ್ಯಾರ್, ತೊ ಅಪ್ನಾಚ್ಯಾ ಚುಕೆ ವಯ್ನಾಚ್ ಮರ್ತಲೆ ಹೊತಾ, ತೆಜ್ಯಾ ಮರ್ನಾಕ್ ಕಾರನ್ ಹೊಲ್ಲ್ಯಾ ತುಕಾ ಮಿಯಾ ಶೆಡ್ ಕಾಡುನ್ ಘೆತಾ. <verse eid="EZK 33:8" /><verse number="9" style="v" sid="EZK 33:9" />ಖರೆ ತಿಯಾ ಬುರ್ಸ್ಯಾಕ್ ಬುರ್ಸ್ಯಾ ವಾಟೆಕ್ನಾ ಚುಕ್ವುತಾನಾ ತೆಕಾ ಹುಶ್ಯಾರ್ಕಿ ದಿಲ್ಯಾರ್ಬಿ ತೊ ತೆ ಸೊಡಿನಸ್ತಾನಾ ರಾಲ್ಯಾರ್ ಅಪ್ನಾಚ್ಯಾ ಚುಕೆತುಚ್ ಮರ್ತಾ, ತಿಯಾ ತರ್ ತುಜೊ ಜಿವ್ ಹುರ್ವುನ್ ಘೆಟ್ಲೆಯ್.<verse eid="EZK 33:9" /></para>
  <para style="s">ವಯಕ್ತಿಕ್ ಜವಾಬ್ದಾರಿ</para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 33:10" />ನರ್ ಮಾನ್ಸಾ, ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಅಸೆ ಸಾಂಗ್, ಅಯ್ಯೊ ಅಮ್ಚ್ಯಾ ಚುಕೆಂಚೊ ಅನಿ ಪಾಪಾಂಚೊ ವಜನ್ ಅಮ್ಚ್ಯಾ ವರ್‍ತಿ ಪಡ್ಲಾ, ತೆಂಚ್ಯಾ ವಯ್ನಾ ಅಮಿ ಕರ್ಗುನ್ ಗೆಲ್ಯಾಂವ್, ಅಮಿ ಅಸೆಚ್ ರ್‍ಹಾತಾಂವ್ ಮನುನ್ ಘೆತ್ಯಾಸಿ ನ್ಹಯ್. <verse eid="EZK 33:10" /><verse number="11" style="v" sid="EZK 33:11" />ಮಾಜ್ಯಾ ಜಿವಾವರ್‍ತಿ ಆನ್, ಬುರ್ಸ್ಯಾಚ್ಯಾ ಮರ್ನಾತ್ ಮಾಕಾ ಉಲ್ಲೆಬಿ ಖುಶಿನಾ, ತೊ ಅಪ್ನಾಚಿ ಬುರ್ಶಿ ವಾಟ್ ಸೊಡುನ್ ಸೊಡುಂದಿ, ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾನೊ, ತುಮಿ ಕಶ್ಯಾಕ್ ಮರುಚೆ? ಹೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚೆ ಬೊಲ್ನೆ. <verse eid="EZK 33:11" /><verse number="12" style="v" sid="EZK 33:12" />ನರ್ ಮಾನ್ಸಾ, ಲೊಕಾಕ್ನಿ ಅಸೆ ಸಾಂಗ್, ಬರ್ಯಾ ಮಾನ್ಸಾನ್ ಚುಕ್ ಕರ್ಲ್ಯಾರ್ ತೆಚೆ ಬರೆ ಕಾಮ್ ತೆಕಾ ಉದ್ದಾರ್ ಕರಿನಾ, ಬುರ್ಸ್ಯಾ ಮಾನ್ಸಾನ್ ಅಪ್ನಾಚೆ ಬುರ್ಸೆ ಕಾಮ್ ಸೊಡಲ್ಯಾ ತನ್ನಾ ತೆಜ್ಯಾ ಪಾಪಾಚೆನ್ ತೆಕಾ ಪಾಡ್ವುಕ್ ಹೊಯ್ನಾ, ಬರ್ಯಾ ಮಾನ್ಸಾನ್ ಪಾಪ್ ಕರಲ್ಲ್ಯಾ ತನ್ನಾ ತೆಚಿ ಬರೆಪಾನ್ ತೆಕಾ ಹುರ್ವಿನಾತ್. <verse eid="EZK 33:12" /><verse number="13" style="v" sid="EZK 33:13" />ಮಿಯಾ ಬರ್ಯ್ಯಾ ಮಾನ್ಸಾಕ್ ತಿಯಾ ಬರ್ಯಾನ್ ಬಾಳ್ವಿ ಕರ್‍ತೆ ಮನ್ತಾನಾ, ತೆನಿ ಅಪ್ನಾಚ್ಯಾ ಬರ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ವರ್‍ತಿ ಭರೊಸೊ ಥವ್ನ್, ಪಾಪ್ ಕರ್ಲ್ಯಾರ್, ತೆನಿ ಕರಲ್ಲೆ ಎಕ್ ಬರೆ ಕಾಮ್ಬಿ ತೆಜ್ಯಾ ಮೆಜ್ನಿಕ್ ಮಿಳ್ವುನ್ ಹೊಯ್ನಾ, ತೆನಿ ಕರಲ್ಲ್ಯಾ ಪಾಪಾ ವಯ್ನಾಚ್ ತೊ ಮರ್ತಾ. <verse eid="EZK 33:13" /><verse number="14" style="v" sid="EZK 33:14" />ಮಿಯಾ ಬುರ್ಸ್ಯಾ ಮಾನ್ಸಾಕ್, ತಿಯಾ ಮರುನುಚ್ ಜಾತಯ್ ಮನುನ್ ಸಾಂಗ್ತಾನಾ, ತೆನಿ ಅಪ್ನಾಚಿ ಪಾಪಾಚಿ ಕಾಮಾ ಸೊಡುನ್ ಬರಿ ಕಾಮಾ ಕರಿತ್ ರ್‍ಹಾತಾ. <verse eid="EZK 33:14" /><verse number="15" style="v" sid="EZK 33:15" />ತಸೆ ಮಟ್ಲ್ಯಾರ್, ಬುರ್ಸ್ಯಾ ಮಾನ್ಸಾನ್ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಪಯ್ಸೆ ಕಾಡುನ್ ಘೆಯ್ ನಸ್ತಾನಾ, ಪರ್‍ತುನ್ ದಿವ್ನ್, ಜಿವಾಕ್ ಬರೆ ಹೊತಲಿ ಕಾಮಾ ಕರುನ್, ಸಗ್ಳ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾಕ್ನಿ ಧುರ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾನಾ, ತೊ ಮರಿ ನಸ್ತಾನಾ ಖರೆಚ್ ಬಾಳ್ವಿ ಕರ್ತಾ. <verse eid="EZK 33:15" /><verse number="16" style="v" sid="EZK 33:16" />ತೆನಿ ಕರಲ್ಲಿ ಖಲಿ ಚುಕ್ ಬಿ ತೆಜ್ಯಾ ಮೆಜ್ನಿತ್ ಮಿಳ್ವುನ್ ಹೊಯ್ನಾ; ತೊ ಬರಿ ಕಾಮಾ ಕರುಕ್ ಲಾಗಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಖರೆಚ್ ಬಾಳ್ವಿ ಕರ್ತಾ.<verse eid="EZK 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 33:17" />“ಖರೆ ತುಜಿ ಲೊಕಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ವಾಟ್ ಸಮಾ ನಾ ಮನುನ್ ಸಾಂಗುಲ್ಲಾತ್, ತೆಂಚಿ ವಾಟಾಚ್ ಸಮಾ ನಾತ್. <verse eid="EZK 33:17" /><verse number="18" style="v" sid="EZK 33:18" />ಬರ್ಯಾ ಮಾನ್ಸಾನ್ ಅಪ್ನಾಚೆ ಬರೆ ಪಾನ್ ಸೊಡುನ್ ಬುರ್ಸೆಕಾಮ್ ಕರ್ಲ್ಯಾರ್, ತ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾ ವಯ್ನಾಚ್ ಮರ್ತಾ. <verse eid="EZK 33:18" /><verse number="19" style="v" sid="EZK 33:19" />ಬುರ್ಸೊ ಮಾನುಸ್ ಬುರ್ಸೆ ಕಾಮ್ ಸೊಡುನ್ ಬರಿ ಕಾಮಾ ಕರಲ್ಲೊ ಹೊಲ್ಯಾರ್, ತೆಜ್ಯಾ ವಯ್ನಾ, ಹುರ್ತಾ. <verse eid="EZK 33:19" /><verse number="20" style="v" sid="EZK 33:20" />ಖರೆ ಸರ್ವೆಸ್ಪರಾಚೆ ವಾಟ್ ಸಮಾ ನ್ಹಯ್ ಮನುನ್ ಸಾಂಗ್ತ್ಯಾಶಿ, ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾನೊ, ತುಮ್ಚ್ಯಾ ಹರ್ ಎಕ್ಲ್ಯಾಚ್ಯಾ ಚಾಲ್ನುಕಿಕ್ ಸಮಾ ಮಿಯಾ ತುಮ್ಕಾ ಪ್ರತಿ ಫಳ್ ದಿತಾ”.<verse eid="EZK 33:20" /></para>
  <para style="s">ಜರುಜಲೆಮ್ ಪಡ್ತಲಿ ಖಬರ್</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 33:21" />ಅಮಿ ಬಂಧಿ ಹೊಲ್ಲ್ಯಾ ಬಾರಾವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಧಾವ್ಯಾ ಮ್ಹೆನ್ಯಾಚ್ಯಾ ಪಾಂಚ್ವೆಚ್ಯಾ ದಿಸಾತ್, ಜರುಜಲೆಮಾಕ್ನಾ ಚುಕ್ವುನ್ ಯೆಲ್ಲ್ಯಾತ್ಲ್ಯಾ ಎಕ್ಲ್ಯಾನ್, ಮಾಜೆಕ್ಡೆ ಎವ್ನ್, ಶಾರ್ ವಿರೊಧಿಯಾಂಚ್ಯಾ ಹಾತಿತ್ ಗಾವ್ಲೆ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EZK 33:21" /><verse number="22" style="v" sid="EZK 33:22" />ತೊ ಯೆತಲ್ಯಾ ಅದ್ಲ್ಯಾ ಸಾಂಚೆಕ್ಡೆ ಮಿಯಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಹಾತಿನ್ ಲೈ ಮಾಗ್ನಿ ಕರಿತ್ ರ್‍ಹಾತಾನಾ, ಸರ್ವೆಸ್ಪರಾನ್ ತೆ ಪಳಾಪ್ ಹೊಲೆ ಅನಿ ತೊ ಸಕ್ಕಾಳಿ ಯೆತಾ ಮನುನ್ ಮಾಜ್ಯಾ ತೊಂಡಾನ್ ಸಾಂಗುಕ್ ಲಾವ್ಲ್ಯಾನ್, ಹೊಯ್ ಮಾಜೆ ತೊಂಡ್ ಬೊಲುಕ್ಲಾಗ್ಲೊ ಅನಿ ಮಾಜೆ ಮುಕ್ಕೆ ಪಾನ್ ಗೆಲೆ.<verse eid="EZK 33:22" /></para>
  <para style="s">ಲೊಕಾಂಚಿ ಚುಕಾ</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 33:23" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲ್ಯಾನ್. <verse eid="EZK 33:23" /><verse number="24" style="v" sid="EZK 33:24" />ನರ್ ಮಾನ್ಸಾ, ಇಜ್ರಾಯೆಲ್ ದೆಶಾಚ್ಯಾ ಹಾಳ್ ಜಾಗ್ಯಾ ವಯ್ಲಿ ವಸ್ತಿ ರಾತಲಿ ಲೊಕಾ ಅಬ್ರಾಮ್ ಎಕ್ಲೊ ರಾಲ್ಯಾರ್ಬಿ ಹ್ಯೊ ದೆಶ್ ತೆಕಾ ವಾಟ್ಯಾಕ್ ಗಾವ್ಲೊ ನ್ಹಯ್, ತೆ ಅಮ್ಚ್ಯಾ ಲೊಕಾಕ್ನಿ ವಾಟ್ಯಾಕ್ ಗಾವಲ್ಲೆ ಕಾಯ್ ಮೊಟೆ ನ್ಹಯ್ ಮನುನ್ಗೆತ್ ಹಾತ್. <verse eid="EZK 33:24" /><verse number="25" style="v" sid="EZK 33:25" />ತಸೆ ಹೊವ್ನ್ ತಿಯಾ ತೆಂಕಾ ಅಸೆ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಸಾಂಗ್ತಾ, ರಗ್ತಾಚೆ ಮಾಂಸ್ ಖಾತಲೆ ಅನಿ, ಮುರ್ತಿ ಫುಜ್ಯಾ ಕರ್‍ತಲೆ ಅನಿ ಜಿವ್ ಕಾಡ್ನಾರೆ, ತುಮ್ಚ್ಯಾ ಸಾರ್ಕೆ ಕಸೆ ದೆಶ್ ಅನ್ಬೊಗ್ಸುಕ್ ಹೊತಾ? <verse eid="EZK 33:25" /><verse number="26" style="v" sid="EZK 33:26" />ತುಮಿ ತಲ್ವಾರಾತ್ನಿ ರ್‍ಹಾವ್ನ್, ಅನಿ ಬುರ್ಶಿ ಕಾಮಾ ಕರ್‍ತಲೆ, ತುಮ್ಚ್ಯಾತ್ಲೊ ಹರ್ ಎಕ್ಲೊ ಅಪ್ನಾಚ್ಯಾ ಸೆಜಾರಾಚ್ಯಾ ಬಾಯ್ಕೊಕ್ ಹಾಳ್ ಕರ್ತಾ, ತುಮ್ಚ್ಯಾ ಅಸ್ಲೊ ಕಸೆ ದೆಶ್ ಅನ್ಬೊಗ್ಸುಕ್ ಹೊತಾ? <verse eid="EZK 33:26" /><verse number="27" style="v" sid="EZK 33:27" />ಅನಿ ತೆಂಕಾ ಅಸೆ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಸಾಂಗ್ತಾ, ಮಾಜ್ಯಾ ಜಿವಾ ವರ್‍ತಿ ಆನ್ ಘಾಲುನ್ ಸಾಂಗ್ತಾ, ಹಾಳ್ ಗಾಂವಾತ್ ಹೊತ್ತ್ಯಾಕ್ನಿ ಕೊಯ್ತೊ ಮಾರ್ತಾ, ಮಾಳ್ ಜಾಗ್ಯಾ ವರ್‍ತಿ ಹೊತ್ತ್ಯಾಕ್ನಿ ಮಿಯಾ ಕ್ರುರ್ ಜನಾವರಾಂಚ್ಯಾ ತೊಂಡಾಕ್ ಗಾಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಡೊಂಬಾತ್ನಿ ಅನಿ ಖಿಲ್ಲೊತ್ನಿ ಹೊತ್ತ್ಯಾಕ್ನಿ ದುಕ್ನೆ ಜಿವ್ ಕಾಡ್ತಾ. <verse eid="EZK 33:27" /><verse number="28" style="v" sid="EZK 33:28" />ಮಿಯಾ ದೆಸಾಕ್ ಹಾಳ್ ಪಾಳ್ ಕರ್ತಾ, ತೆಜ್ಯಾ ತಾಕ್ತಿಚಿ ಘಮಂಡ್ ಉತ್ರುನ್ ಜಾತಾ, ಇಜ್ರಾಯೆಲಾಚೆ ಪಾನಿಯಾಚೆ ಜಾಗೆ ಹಾಳ್ ಪಡ್ತಾತ್, ಥೈ ಕೊನ್ಬಿ ದಾಟುನ್ ಜಾಯ್ನಾತ್. <verse eid="EZK 33:28" /><verse number="29" style="v" sid="EZK 33:29" />ತೆನಿ ಅಪ್ನಿ ಕರಲ್ಲ್ಯಾ ಲೈ ಬುರ್ಸ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ವಯ್ನಾ ಮಿಯಾ ದೆಶ್ ಹಾಳ್ ಪಾಡ್ ಕರಲ್ಲ್ಯಾ ತನ್ನಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತೆಂಕಾ ಕಳ್ತಾ.<verse eid="EZK 33:29" /></para>
  <para style="s">ಪ್ರವಾದ್ಯಾಚ್ಯಾ ಖಬ್ರಿಚೆ ಫಳ್</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 33:30" />ನರ್ ಮಾನ್ಸಾ, ತುಜಿ ಲೊಕಾ ಭಿತ್ತಿಯಾಂಚ್ಯಾ ಸಾವ್ಳಿತ್ ಘರಾಚ್ಯಾ ಹುಂಬ್ಡ್ಯಾತ್ನಿ ತುಜಿಚ್ ವಿಶಯಾತ್ ಸಾಂಗುನ್, ಅಪ್ನಾ ಅಪ್ನಾತ್ನಿಚ್ ಎಕಾಮೆಕಾಕ್, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ತೊಂಡಾತ್ನಾ ಯೆಲ್ಲಿ ಗೊಸ್ಟಿಯಾ ಕಾಯ್ ಮನುನ್ ಆಯ್ಕುವಾ ಮನುನ್ ಬೊಲುನ್ಗೆತಾತ್. <verse eid="EZK 33:30" /><verse number="31" style="v" sid="EZK 33:31" />ಪರಸ್ನೆ ಇಚಾರುಕ್ ಯೆತಲ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಸಾರ್ಕೆ ತೆನಿ ತುಜ್ಯಾಕ್ಡೆ ಎವ್ನ್, ಮಾಜಿ ಭಕ್ತಾ ಹೊವ್ನ್ ತುಜ್ಯಾ ಇದ್ರಾಕ್ ಬಸುನ್ ತುಜಿ ಬೊಲ್ನೆ ಆಯ್ಕ್ತಾತ್, ಖರೆ ತೆ ಕಾಮ್ ಕರಿನಾತ್, ತೊಂಡಾತ್ನಾ ಲೈ ಪ್ರೆಮ್ ದಾಕ್ವುತಾತ್, ತೆಂಚೊ ಮನ್ ಅಪ್ನಿ ಚೊರುನ್ ಘೆಟಲ್ಲ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಜಾತಾ. <verse eid="EZK 33:31" /><verse number="32" style="v" sid="EZK 33:32" />ಅಬಕ್ ತುಜಿ ಗೊಸ್ಟ್ ತೆಂಚ್ಯಾ ಮನಾತ್ ಎಕ್ ಗಿತ್ ಕಾರ್, ವಾಜ್ಪಾ ಶಾನೆ ಪಾನಾನ್ ವಾಜ್ವುನ್, ಲೈ ಬರ್ಯಾ ಧನಾನ್ ಸಾಂಗ್ತಲ್ಯಾ ಪ್ರೆಮಾಚ್ಯಾ ಗಿತಿಚ್ಯಾ ಸಾರ್ಕೆ, ತುಜಿ ಗೊಸ್ಟಿಯಾ ಆಯ್ಕ್ತಾತ್, ಖರೆ ಮಾನುನ್ ಚಲಿನ್ಯಾತ್. <verse eid="EZK 33:32" /><verse number="33" style="v" sid="EZK 33:33" />ತಿಯಾ ಫಿಡೆಚ್ ಕಳ್ವಲ್ಲೆ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ, ಅಹಾ ಘಡ್ಲೆ, ಅಪ್ನಾಚ್ಯಾ ಮದ್ದಿ ಹೊತ್ತೊ ಪರ್ವಾದಿಚ್ ಮನುನ್ ತೆಂಕಾ ಕಳ್ಳೆ.<verse eid="EZK 33:33" /></para>
  <chapter eid="EZK 33" />
  <chapter number="34" style="c" sid="EZK 34" />
  <para style="s">ಇಜ್ರಾಯೆಲಾಂಚಿ ಕುರ್‍ಬುರಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 34:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲ್ಯಾನ್. <verse eid="EZK 34:1" /><verse number="2" style="v" sid="EZK 34:2" />ನರ್ ಮಾನ್ಸಾ, ಇಜ್ರಾಯೆಲ್ ಮನ್ತಲ್ಯಾ ಬಕ್ರ್ಯಾಂಚ್ಯಾ ತಾಂಡ್ಯಾಕ್ ರಾಕ್ತಲ್ಯಾ ಕುರ್ಬುರಾಕ್ನಿ ಹಿ ದೆವಾಚಿ ಗೊಸ್ಟಿಯಾ ಸಾಂಗ್, ಪ್ರವಾದನ್ ಕರುನ್ ಅಸಿ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೆ ಸಾಂಗ್ತಾ, ಅಯ್ಯೊ ಸ್ವತ್ಯಾಚ್ಯಾ ಪೊಟಾಕ್ನಿಚ್ ಕಾಪುನ್ಗೆತಲ್ಯಾ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಕುರ್ಬುರಾಂಚಿ ಗತ್ ಕಾಯ್ ಸಾಂಗು! ಕುರ್ಬುರಾಂಚೆ ಕಾಮ್ ಬಕ್ರ್ಯಾಂಚೆ ಪೊಟ್ ಭರ್ತಲೆಚ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 34:2" /><verse number="3" style="v" sid="EZK 34:3" />ತುಮಿ ಮಾಂದ್ಯಾಚೆ ಮಾಂಸ್ ಖಾತ್ಯಾಸಿ, ಬಕ್ರ್ಯಾಚ್ಯಾ ಕೆಸಾಂಚೆ ಕಾಂಬ್ರಾನ್ ಘೆತ್ಯಾಸಿ, ಮಾಂದ್ಯಾಚಿ ಬಕ್ರಿಯಾ ಕಾಪ್ತ್ಯಾಸಿ, ಖರೆ ಬಕ್ರ್ಯಾಕ್ನಿ ಚಾರ್ವಿನ್ಯಾಸಿ. <verse eid="EZK 34:3" /><verse number="4" style="v" sid="EZK 34:4" />ಹಾ, ತುಮಿ ಬಳ್ ನಸಲ್ಲ್ಯಾಕ್ನಿ ಬಳ್ ದಿವ್ಕ್ ನ್ಯಾಸಿ, ರೊಗಾತ್ ಹೊತ್ತ್ಯಾಕ್ನಿ ಆರಾಮ್ ಕರುಕ್ ನಾಸಿ, ತೆಂಚೆ ಕಾಯ್ಬಿ ಮೊಡಲ್ಲೆ ರಾಲ್ಯಾರ್ ಭಾಂದಿನ್ಯಾಸಿ, ಕಳ್ದುನ್ ಗೆಲ್ಲ್ಯಾಕ್ ಹುಡ್ಕಿನ್ಯಾಸಿ, ಪಳಸಲ್ಲ್ಯಾಕ್ನಿ ಪರ್‍ತುನ್ ತಾಂಡ್ಯಾಕ್ ಮಿಳ್ವುಕ್ನಾತ್, ತೆಂಚ್ಯಾ ತರಸಾ ಜಬರ್ದಸ್ತಿನ್ ರಾಜ್ವಡ್ಕಿ ಕರಿತ್ ಯೆಲ್ಯಾಸಿ. <verse eid="EZK 34:4" /><verse number="5" style="v" sid="EZK 34:5" />ಕುರ್ಬುರ್ ನಸ್ತಾನಾ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ, ತಿ ಪಗ್ಳುನ್ ಗೆಲಿ, ಪಗ್ಳುನ್ ಜಾವ್ನ್ ಸಗ್ಳಿ ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಕ್ರುರ್ ಜನಾವರಾಕ್ನಿ ವಾಟೊ ಹೊಲಿ. <verse eid="EZK 34:5" /><verse number="6" style="v" sid="EZK 34:6" />ಮಾಜಿ ಸಗ್ಳಿ ಬಕ್ರಿಯಾ ಪರ್ವತಾಂಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಜಾಗ್ಯಾ ವೈನಿ ಉಪ್ಪರ್ಲ್ಯಾ ಹರ್ ಎಕ್ ಮಡ್ಡಿ ವರ್‍ತಿ ಫಿರುನ್ ಖೆಳುನ್ಗೆತ್ ಹೊತ್ತಿ, ಹೊಯ್, ಮಾಜಿ ಬಕ್ರಿಯಾ ಸಗ್ಳ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಪಗ್ಳುನ್ ಗೆಲಿ, ಕೊನಿಬಿ ತೆಂಚ್ಯಾ ಪಾಟ್ನಾ ಜಾವ್ನ್ ಹುಡ್ಕುಕ್ನಾತ್, ಅನಿ ತೆಂಕಾ ರಾಕುಕ್ನಾತ್. <verse eid="EZK 34:6" /><verse number="7" style="v" sid="EZK 34:7" />ಕುರ್ಬುರಾನೊ, ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಆಯ್ಕಾ.<verse eid="EZK 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 34:8" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಅಯ್ಯೊ ಮಾಜಿ ಬಕ್ರಿಯಾ ಚೊರಿ ಹೊಲಿ, ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಕ್ರುರ್ ಜನಾವರಾಂಚ್ಯಾ ವಾಟ್ಯಾಕ್ ಹೊಲಿ, ಕುರ್ಬುರಾಬಿ ನಾತ್ ನ್ಹಯ್, ಮಾಜ್ಯಾ ಕುರ್ಬುರಾನಿ ಬಕ್ರಿಯಾಕ್ನಿ ಹುಡ್ಕುಕ್ನಾತ್, ತೆನಿ ಅಪ್ನಾಚಿ ಪೊಟಾ ತವ್ಡಿಚ್ ಭರುನ್ ಘೆಟ್ಲ್ಯಾನಿ, ಖರೆ ಬಕ್ರ್ಯಾಂಚಿ ಪೊಟಾ ಭರ್ತಲೆ ಬಗುಕ್ನಾತ್. <verse eid="EZK 34:8" /><verse number="9" style="v" sid="EZK 34:9" />ತಸೆ ಹೊವ್ನ್, ಕುರ್ಬುರಾನೊ ಸರ್ವೆಸ್ಪರಾಚಿ ಧನ್ ಆಯ್ಕಾ. <verse eid="EZK 34:9" /><verse number="10" style="v" sid="EZK 34:10" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮಾಜ್ಯಾ ಜಿವಾ ವರ್‍ತಿ ಆನ್ ಘಾಲುನ್ ಸಾಂಗ್ತಾ, ಮಿಯಾ ಕುರ್ಬುರಾಕ್ನಿ ವಿರೊದ್ ಹೊವ್ನ್ ಹಾಯ್, ತೆನಿ ಮಾಜ್ಯಾ ಬಕ್ರ್ಯಾಂಚೊ ಇಸಬ್ ಮಾಕಾ ದಿವ್ಚೆ, ಮಾಜಿ ಬಕ್ರಿಯಾ ರಾಕ್ತಲ್ಯಾ ಕಾಮಾತ್ನಾ ತೆಂಕಾ ಚುಕ್ವುತಾ, ತ್ಯಾ ಕುರ್ಬುರಾಕ್ನಿ ಅಪ್ನಾಚೆ ಸ್ವತಾಚೆ ಪೊಟ್ ಭರುನ್ಗೆವ್ಕ್ ಹೊಯ್ನಾ, ಮಾಜಿ ಬಕ್ರಿಯಾ ತೆಂಕಾ ಜೆವಾನ್ ಹೊವ್ನ್ ತೆಂಚ್ಯಾ ತೊಂಡಾಕ್ ಗಾಯ್ನಾ ಸಾರ್ಕೆ ಕರ್ತಾ.<verse eid="EZK 34:10" /></para>
  <para style="s">ಸರ್ವೆಶ್ವರುಚ್ ಬರೊ ಕುರ್ಬುರ್</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 34:11" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಆಹಾ, ಮಾಜ್ಯಾ ಬಕ್ರ್ಯಾಕ್ನಿ ಮಿಯಾಚ್ ಫಾಟ್ ಲಾಗುನ್ ಸೊದುನ್ ಕಾಡ್ತಾ. <verse eid="EZK 34:11" /><verse number="12" style="v" sid="EZK 34:12" />ತಾಂಡ್ಯಾಚ್ಯಾ ಕುರ್ಬುರಾನ್ ಭೊತ್ಯಾನಿ ಪಗ್ಳುನ್ ಗೆಲ್ಲ್ಯಾ ಅಪ್ನಾಚ್ಯಾ ಬಕ್ರ್ಯಾಕ್ನಿ ಹುಡಕಲ್ಲ್ಯಾ ಸಾರ್ಕೆ, ಮಿಯಾ ಮಾಜ್ಯಾ ಬಕ್ರ್ಯಾಕ್ನಿ ಹುಡಕ್ತಾ, ಕಾಳಿ ಮೊಡಾ ಹೊವ್ನ್, ಪಗ್ಳುನ್ ಗೆಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಜಾಗ್ಯಾಂಚ್ಯಾ ವಯ್ನಾ ತೆಂಕಾ ಸೊಡಸ್ತಾ. <verse eid="EZK 34:12" /><verse number="13" style="v" sid="EZK 34:13" />ಲೊಕಾಂಚ್ಯಾ ಮದ್ನಾ ಚುಕ್ವುನ್, ಸಗ್ಳ್ಯಾ ದೆಶಾಂಚ್ಯಾಕ್ನಾ ಗೊಳಾ ಕರ್ತಾ. ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಸಾಕ್ ಹಾನ್ತಾ. ಅನಿ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಮಡ್ಡಿಯಾತ್ನಿ ಅನಿ ಕೊಡ್ಲಾಂಚ್ಯಾ ಜಗ್ಗೊಳ್, ಗಾಂವಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಗಡಿಯಾತ್ನಿಬಿ ಚಾರ್ವುತಾ. <verse eid="EZK 34:13" /><verse number="14" style="v" sid="EZK 34:14" />ತೆಂಕಾ ಬರೊ ಚಾರೊ ಚಾರ್ವುತಾ. ತೆಂಚೆ ಗವಾತ್ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಉಪ್ಪರ್ಲ್ಯಾ ಮಡ್ಡಿಯಾ ವಯ್ಲಿ ಹಾಯ್, ಥೈ ಬರ್ಯಾ ಚಾರ್ಯಾತ್ ನಿಜ್ತಾತ್. ಅನಿ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಡಂಗ್ಳಿಯಾತ್ನಿ ಹಿರ್ವೊ ಚಾರೊ ಚರ್ತಾತ್. <verse eid="EZK 34:14" /><verse number="15" style="v" sid="EZK 34:15" />ಮಿಯಾ ಮಾಜ್ಯಾ ಬಕ್ರ್ಯಾಕ್ನಿ ಚಾರ್ವುನ್ ಆರಾಮ್ ನಿಜುನ್ ರಾಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. ಹೆ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 34:15" /><verse number="16" style="v" sid="EZK 34:16" />ಚುಕ್ವುನ್ಗೆವ್ನ್ ಗೆಲ್ಲೆ ಹುಡಕ್ತಾ, ಪಳ್ಸುನ್ ಘಾಟಲ್ಲ್ಯಾಕ್ ಪರ್‍ತುನ್ ತಾಂಡ್ಯಾಕ್ ಮಿಳ್ವುತಾ, ಬಳ್ ನಸಲ್ಲ್ಯಾಕ್ ಬಳ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ತೆಚೆ ಕಾಯ್ಬಿ ಮೊಡಲ್ಲೊ ಭಾಗ್ ರಾಲ್ಯಾರ್ ಭಾಂದುನ್ ಸಮಾ ಕರ್ತಾ. ಲೈ ಮಾಂದ್ಯಾನ್ ವಾಡಲ್ಲ್ಯಾ ಬಕ್ರ್ಯಾಕ್ನಿ ನಾಶ್ ಕರುನ್, ತೆಂಕಾ ಝಡ್ತಿ ಮನ್ತಲೊ ಚಾರೊ ಚಾರ್ವುತಾ.<verse eid="EZK 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 34:17" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮಾಜ್ಯಾ ಹಿಂಡಾ, ಮಿಯಾ ತುಮ್ಚ್ಯಾತ್ಲ್ಯಾ ಬೊಕ್ಡಾ, ಬಕ್ರ್ಯಾಂಚ್ಯಾ ಅನಿ ಬಕ್ರೆ, ಪಾಲ್ವ್ಯಾಂಚ್ಯಾ ಅನಿ ಬಕ್ರೆ, ಟಗ್ರಾಕ್ನಿ ಮದ್ದಿ ಇಬೆ ರ್‍ಹಾವ್ನ್ ಝಡ್ತಿ ಕರ್ತಾ. <verse eid="EZK 34:17" /><verse number="18" style="v" sid="EZK 34:18" />ಟಗ್ರಾ ಬಕ್ರ್ಯಾನೊ, ತುಮಿ ಬರೊ ಚಾರೊ ಚರುನ್ ಹುರಲ್ಲೊ ಚಾರೊ ತುಡ್ವುನ್, ಪಾಂಯಾತ್ಲೊ ಕೆರ್ ಕರುನ್ ಘೆಟಲ್ಲೆ ಕಮ್ಮಿಚೆ ಕಾಮುಚ್ ನ್ಹಯ್ ಕಾಯ್? ನಿತಳ್ ಪಾನಿ ಫಿವ್ನ್ ಹುರಲ್ಲೆ ಪಾನಿ ಪಾಂಯಾನಿ ಕಾಲ್ವುನ್ ರಾಡ್ ಕರಲ್ಲೆ ಬಾರಿಕ್ ಕಾಮ್ ಕಾಯ್? <verse eid="EZK 34:18" /><verse number="19" style="v" sid="EZK 34:19" />ತುಮಿ ಪಾಂಯಾತ್ಲೊ ಕೆರ್ ಕರುನ್ ತುಡ್ವುನ್ ರಾಡ್ ಸೊಡಲ್ಲೊ ಚಾರೊ, ಮಾಜ್ಯಾ ಬಕ್ರ್ಯಾಕ್ನಿ ಚಾರ್ವುಚೆ ಹೊಲೆ. ತುಮಿ ಕಾಲ್ವುನ್ ಕಡೆಕ್ ಕರಲ್ಲೆ ಪಾನಿ ಮಿಯಾ ತೆಂಕಾ ಪಾಜ್ವುತಲೆ ಹೊಲೆ. <verse eid="EZK 34:19" /><verse number="20" style="v" sid="EZK 34:20" />ಅಸೆ ರ್‍ಹಾತಾನಾ, ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಅಬಕ್, ಮಿಯಾಚ್ ಮಾಂದ್ಯಾಚ್ಯಾ ಟಗ್ರಾಕ್ ಅನಿ ಶೆಳಿಯಾ, ಪಾಲ್ವ್ಯಾಕ್ನಿ ಮದ್ದಿ ಝಡ್ತಿ ಕರ್ತಾ. <verse eid="EZK 34:20" /><verse number="21" style="v" sid="EZK 34:21" />ಟಗ್ರಾ ಬಕ್ರ್ಯಾನೊ, ತುಮಿ ಶೆಳಿಯಾ, ಪಾಲ್ವ್ಯಾಕ್ನಿ ಭಾಜುಕ್ನಾ ಅನಿ ಭುಜಾನಿ ಡಕ್ಳುನ್ಗೆತ್ ಬಳ್ ನಸಲ್ಲ್ಯಾಕ್ನಿ ಸಿಂಗಾನಿ ಮಾರುನ್ಗೆತ್ ಮಾಜ್ಯಾ ಹಿಂಡಾಕ್ ಪಗ್ಳುನ್ ಘಾಟ್ಲ್ಯಾಸಿ. <verse eid="EZK 34:21" /><verse number="22" style="v" sid="EZK 34:22" />ತಸೆಹೊವ್ನ್, ಮಾಜೊ ತಾಂಡೊ ಅನಿ ಕನ್ನಾಬಿ ಚೊರಿ ಹೊಯ್ನಾ ಸಾರ್ಕೆ ಮಿಯಾ ತೆಂಕಾ ರಾಕ್ವನ್ ಕರುನ್, ಬೊಕ್ಡು, ಬಕ್ರೆ ಅನಿ ಶೆಳಿ, ಪಾಲ್ವ್ಯಾಕ್ನಿ ಝಡ್ತಿ ಕರ್ತಾ.<verse eid="EZK 34:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 34:23" />ಮಾಜ್ಯಾ ಹಿಂಡಾಕ್ ರಾಕುಕ್ ಎಕುಚ್ ಕುರ್ಬುರಾಕ್ ನೆಮಸ್ಲೊ, ಮಾಜೊ ಸೆವಕ್ ದಾವಿದ್ ಮನ್ತಲೊ ತೊ ಕುರ್ಬುರ್. ತೆಂಕಾ ಚಾರ್ವುತಾ, ಹೊಯ್ ತೊಚ್ ತೆಂಚೊ ಕುರ್ಬುರ್ ಹೊವ್ನ್ ತೆಂಕಾ ಚಾರ್ವುತಾ. <verse eid="EZK 34:23" /><verse number="24" style="v" sid="EZK 34:24" />ಸರ್ವೆಸ್ಪರ್ ಮಿಯಾ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ದೆವ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಮಾಜೊ ಸೆವಕ್ ದಾವಿದ್ ತೆಂಕಾ ರಾಜ್ವಡ್ಕಿ ಕರ್ತಲೊ ರಾಜಾ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಸರ್ವೆಸ್ಪರ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಮಿಯಾಚ್ ಹೆ ಸಾಂಗ್ಲಾ. <verse eid="EZK 34:24" /><verse number="25" style="v" sid="EZK 34:25" />ಮಿಯಾ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಸಮಾಧಾನಾಚೊ ಕರಾರ್ ಕರುನ್ಗೆತಾ, ದೆಸಾತ್ ಬುರ್ಶಿ ಜನಾವರಾ ಅನಿ ಪರ್‍ತುನ್ ನಾ ಕರ್ತಾ, ಮಾಜಿ ಲೊಕಾ ಭಿಂಯ್ಯೆ ನಸ್ತಾನಾ ಡಂಗ್ಳಿತ್ ವಸ್ತಿ ರ್‍ಹಾತ್ಯಾತ್. ಅನಿ ಡಂಗ್ಳಿತ್ ಆರಾಮ್ ನಿಜ್ತಾತ್. <verse eid="EZK 34:25" /><verse number="26" style="v" sid="EZK 34:26" />ಮಿಯಾ ತೆಂಕಾ ಮಾಜ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ಮಡ್ಡಿಯಾಂಚೊ ಜಾಗೊ ಆಶಿರ್ವಾದ್ ಕರುನ್ ಸುಕ್ ದಿತಾ, ಸಮಾ ಎಳಾರ್ ಬರೊ ಪಾವ್ಸ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಅನಿ ಆರ್ಶಿವಾದಾಚೊ ಪಾವ್ಸ್ ಹೊತಾ. <verse eid="EZK 34:26" /><verse number="27" style="v" sid="EZK 34:27" />ಮ್ಹಳ್ಯಾಚಿ ಝಾಡಾ ಹನ್ನಾ ದಿತಾತ್, ಸೆತಾತ್ನಿ ಬರಿ ಪಿಕ್ ಯೆತಾ. ಲೊಕಾ ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಸಾತ್ ಆರಾಮಾನ್ ರ್‍ಹಾತ್ಯಾತ್, ತೆಂಚ್ಯಾ ವರ್‍ತಿ ವಾವಲ್ಲ್ಯಾ ಜುಂವಾಕ್ನಿ ಮಿಯಾ ಮೊಡುನ್ ತೆಂಕಾ ಆಳ್ ಕರುನ್ಗೆಟಲ್ಲ್ಯಾಂಚ್ಯಾ ಹಾತಿತ್ನಾ ಅಧಿಕಾರಾಕ್ನಾ ತೆಂಕಾ ಸೊಡ್ಸುತಾನಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತೆಂಕಾ ಖರೆಚ್ ಕಳ್ತಾ. <verse eid="EZK 34:27" /><verse number="28" style="v" sid="EZK 34:28" />ತೆಂಕಾ ತ್ಯಾ ದಿಸಾಕ್ನಾ ದುಶ್ರಿಲೊಕಾ ಲುಟ್ ಕರಿನಾತ್, ಡಂಗ್ಳಿಚಿ ಜನಾವರಾ ತೆಂಕಾ ಮೊಡಿನಾತ್, ತೆನಿ ಕೊನಾಕ್ಬಿ ಭಿಂಯ್ನಸ್ತಾನಾ ಆರಾಮಾನ್ ವಸ್ತಿ ರ್‍ಹಾತ್ಯಾತ್. <verse eid="EZK 34:28" /><verse number="29" style="v" sid="EZK 34:29" />ಮಿಯಾ ತೆಂಚ್ಯಾ ಸಾಟ್ನಿ ಬರಿ ಫಳಾಂಚಿ ಝಾಡಾ ವಾಡ್ವುತಾ, ತೆಜ್ಯಾ ದೆಶ್ಯಾಕ್ ಬರ್‍ಗಾಲ್ ಅನಿ ಪರ್‍ತುನ್ ಹಾಳ್ ಕರಿನಾ, ತೆನಿ ದುಶ್ರ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ತಿರಸ್ಕಾರಾಕ್ ಗುರಿ ಪಡಿನಾತ್. <verse eid="EZK 34:29" /><verse number="30" style="v" sid="EZK 34:30" />ತನ್ನಾ, ತೆನಿ ಅಪ್ನಾಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೊ ಮಿಯಾ ಅಪ್ನಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಹಾಯ್ ಮನುನ್, ಅನಿ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚೆ ಮಾಜಿ ಲೊಕಾ ಹೊವ್ನ್ ರ್‍ಹಾತ್ಯಾತ್ ಮನುನ್ ಖಾತ್ರಿ ಕರುನ್ಗೆತಾತ್, ಹೆ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 34:30" /><verse number="31" style="v" sid="EZK 34:31" />ತುಮಿ ಮಾಜಿ ಬಕ್ರಿಯಾ, ಮಾಜಿ ರಾಕ್ವನಿಚಿ ಬಕ್ರಿಯಾ, ಮಾನ್ಸಾಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ತುಮ್ಕಾ ಮಿಯಾಚ್ ದೆವ್ ಹೊವ್ನ್ ಹಾಯ್ ಮನುನ್ ಸರ್ವೆಸ್ಪರ್ ಸಾಂಗ್ತಾ.<verse eid="EZK 34:31" /></para>
  <chapter eid="EZK 34" />
  <chapter number="35" style="c" sid="EZK 35" />
  <para style="s">ಎದೊಮಾಕ್ ದೆವಾಚಿ ಶಿಕ್ಷ್ಯಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 35:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲ್ಯಾನ್. <verse eid="EZK 35:1" /><verse number="2" style="v" sid="EZK 35:2" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಸೆಯಿರ್ ಮಡ್ಡಿಕ್ಡೆ ಪರ್‍ತುನ್ ಇಬೆ ರ್‍ಹಾವ್ನ್, ತೆಕಾ ಹಿ ದೆವಾಚಿ ಖಬರ್ ಸಾಂಗ್, <verse eid="EZK 35:2" /><verse number="3" style="v" sid="EZK 35:3" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಸೆಯಿರ್ ಮಡ್ಡಿ, ಅಬಕ್ ಮಿಯಾ ತುಕಾ ವಿರೊದ್ ಹೊವ್ನ್ ಹಾಯ್, ಮಿಯಾ ತುಜ್ಯಾ ಗಾಂವಾಂಚ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕ್ಲುನ್ ನಾಶ್ ಕರ್ತಾ. <verse eid="EZK 35:3" /><verse number="4" style="v" sid="EZK 35:4" />ತುಜಿ ಶಾರಾ ನಾಶ್ ಹೊತಾತ್, ತಿಯಾ ಡಂಗಳ್ ಹೊತೆಯ್, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳ್ವುನ್ಗೆತೆಯ್. <verse eid="EZK 35:4" /><verse number="5" style="v" sid="EZK 35:5" />ತಿಯಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ವರ್‍ತಿ ಲೈ ಯೆಳಾಚ್ಯಾ ಸಗೊಳ್ ರಾಗ್ ಥವ್ನ್, ತೆಂಚ್ಯಾ ಚುಕೆಂಚ್ಯಾ ಆಕ್ರಿಚ್ಯಾ ಎಳಾರ್ ಸಂಕಟ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ, ತೆಂಕಾ ತಲ್ವಾರಾಚ್ಯಾ ತೊಂಡಾಕ್ ಗುರಿ ಕರ್ತಾ. <verse eid="EZK 35:5" /><verse number="6" style="v" sid="EZK 35:6" />ತೆಚ್ಯಾ ವಯ್ನಾ ಮಾಜ್ಯಾ ಜಿವಾಚ್ಯಾ ವರ್‍ತಿ ಆನ್ ಘಾಲುನ್ ಸಾಂಗ್ತಾ, ಮಿಯಾ ತುಕಾ ರಗ್ತಾನ್ ಭರಿಸಾರ್ಕೆ ಕರ್ತಾ, ತಿಯಾ ರಗಾತ್ ಗಳ್ವುಕ್ ಫಾಟಿ ಸರ್ಕಿ ನಸಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ತುಕಾ ರಗ್ತಾಚೊ ಹಂವಾರೊಚ್ ತುಕಾ ಫಾಟ್ ಲಾಗ್ತಾ. ಹೆ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 35:6" /><verse number="7" style="v" sid="EZK 35:7" />ಸೆಯಿರ್ ಮಡ್ಡಿ, ಮಿಯಾ ತುಜ್ಯಾ ಗಾಂವಾಕ್ನಿ ಹಾಳ್ ಪಾಳ್ ಕರುನ್, ತ್ಯಾತುರ್ ಜಾತ ಯೆತಲ್ಯಾಕ್ನಿ ನಾಶ್ ಕರ್ತಾ. <verse eid="EZK 35:7" /><verse number="8" style="v" sid="EZK 35:8" />ತುಜ್ಯಾ ಮಡ್ಡಿಯಾಕ್ನಿ ತುಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಮ್ಹಡ್ಯಾನಿ ಭರಿಸಾರ್ಕೆ ಕರ್ತಾ. ತಲ್ವಾರಾನಿ ಮ್ಹರಲ್ಲಿ ಮ್ಹಡಿ, ತುಜ್ಯಾ ಮಡ್ಡಿಯಾತ್ನಿ, ಖೊಲಾತ್ನಿ ಅನಿ ಕೊಡ್ಲಾತ್ನಿ ಪಡುನ್ ಜಾತಾತ್. <verse eid="EZK 35:8" /><verse number="9" style="v" sid="EZK 35:9" />ಮಿಯಾ ತುಕಾ ಕನ್ನಾಬಿ ಸರಿ ನಸಲ್ಲ್ಯಾ ನಾಶಾಕ್ ಗುರಿ ಕರ್ತಾ, ತುಜಿ ಶಾರಾ ಲೊಕಾ ನತ್ತಿ ಹೊತಾತ್, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತುಮ್ಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಕಳ್ತಾ. <verse eid="EZK 35:9" /><verse number="10" style="v" sid="EZK 35:10" />ತಿಯಾ ಅನಿ ಹಿ ತುಜಿ ಲೊಕಾ ಅನಿ ದೆಶಾ ಮಾಜ್ಯಾ ತಾಬೆತ್ ಹೊತಾತ್, ಅಮಿ ತೆ ಅನ್ಬೊಗ್ ಕರ್ತಾಂವ್ ಮನುನ್ಗೆವ್ನ್, ಥೈ ಮಾಜೆ ಹಾಜಿರ್ಪಾನಾಕ್ ಧ್ಯಾನ್ ದಿಯ್ನಸ್ತಾನಾ ಹೊತ್ತೆ ಹಾಯ್. <verse eid="EZK 35:10" /><verse number="11" style="v" sid="EZK 35:11" />ಮಾಜ್ಯಾ ಜಿವಾಚ್ಯಾ ವರ್‍ತಿ ಆನ್ ಘಾಲುನ್ ಸಾಂಗ್ತಾ, ತಿಯಾ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ದ್ವೆಶ್ ಕರುನ್ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಥವಲ್ಲ್ಯಾ ರಾಗಾಕ್ ಅನಿ ಕುಸ್ಡೆ ಪಾನಾಚ್ಯಾ ವಯ್ನಾ ತುಕಾ ಶಿಕ್ಷ್ಯಾ ದಿತಾನಾ ತೆಂಕಾ ದಿಸ್ತಾ, ಹೆ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 35:11" /><verse number="12" style="v" sid="EZK 35:12" />ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳ್ವುನ್ ಘೆಟಲ್ಲ್ಯಾ ತನ್ನಾ, ತಿಯಾ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಮಡ್ಡಿಯಾಕ್ನಿ ಬಗುನ್, ಹಾಳ್ ಹೊಲ್ಲಿ ಅಮ್ಚ್ಯಾ ವಾಟ್ಯಾಕ್ ಹೊಲಿ, ಮನುನ್ ಚುಕ್ ವಾವಲ್ಲೆ, ಸರ್ವೆಸ್ಪರ್ ಹೊಲ್ಲ್ಯಾ ಮಾಜ್ಯಾ ಕಾನಾಕ್ ಆಯ್ಕೊ ಯೆಲಾತ್, ಮನ್ತಲೆ ತುಕಾ ಕಳ್ತಾ. <verse eid="EZK 35:12" /><verse number="13" style="v" sid="EZK 35:13" />ತುಜ್ಯಾ ಲೊಕಾನಿ ಮೊಟೆ ತೊಂಡ್ ಕರುನ್ ಮಾಜ್ಯಾ ವರ್‍ತಿ ಬೊಲಲ್ಲಿ ಫಾಯ್ದ್ಯಾಕ್ ನಸಲ್ಲಿ ಲೈ ಗೊಸ್ಟಿಯಾ ಆಯ್ಕಲಾ. <verse eid="EZK 35:13" /><verse number="14" style="v" sid="EZK 35:14" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮಿಯಾ ತುಕಾ ಹಾಳ್ ಕರುನ್ ಸಗ್ಳ್ಯಾ ಜಗ್ ಖುಶಿ ಕರ್ತಾ. <verse eid="EZK 35:14" /><verse number="15" style="v" sid="EZK 35:15" />ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಬದಿಕ್ ನಾಶ್ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ತಿಯಾ ಖುಶಿ ಹೊಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತುಜ್ಯಾ ನಾಶಾಚ್ಯಾ ಎಳಾರ್ ಸಗ್ಳಿ ಲೊಕಾ ಖುಶಿ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಸೆಯಿರ್ ಮಡ್ಡಿಯಾನೊ, ತಿಯಾ ಹಾಳ್ ಹೊತೆಯ್, ಹೊಯ್, ಫುರಾ ಎದೊಮ್ ಹಾಳ್ ಹೊತಾ, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳ್ತಾ.<verse eid="EZK 35:15" /></para>
  <chapter eid="EZK 35" />
  <chapter number="36" style="c" sid="EZK 36" />
  <para style="s">ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ವರ್‍ತಿ ದೆವಾಚೊ ಆಶಿರ್ವಾದ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 36:1" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಮಡ್ಡಿಯಾಕ್ನಿ ಹೆ ಪ್ರವಾದನ್ ಕರುನ್ ಅಸೆ ಸಾಂಗ್, ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಮಡ್ಡಿಯಾನೊ, ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಆಯ್ಕಾ. <verse eid="EZK 36:1" /><verse number="2" style="v" sid="EZK 36:2" />ತುಮ್ಕಾ ಬಗುನ್ ವಿರೊಧಿ, ಆಹಾ, ಮನುನ್ಗೆತ್, ಹಿ ಜುನ್ನಿ ಘರಾ ಅಮ್ಚ್ಯಾ ತಾಬೆತ್ ಹೊಲಾತ್, ಮನುನ್ ಬಡಾಯ್ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ಹಿ ಪ್ರವಾದನ್ ಸಾಂಗುಚೆ ಮನುನ್, ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೊ ಹುಕುಮ್ ಹೊಲೊ. <verse eid="EZK 36:2" /><verse number="3" style="v" sid="EZK 36:3" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಸಗ್ಳ್ಯಾಕ್ಡೆ ತುಡ್ವುಕ್ ಗಾವ್ನ್, ಹಾಳ್ ಹೊಲ್ಲೆ ತುಮಿ ಲೊಕಾಂಚ್ಯಾಕ್ಡೆ ಹುರಲ್ಲ್ಯಾಂಚ್ಯಾ ತಾಬೆತ್ ಹೊಲ್ಯಾಸಿ ನ್ಹಯ್! ಝುಟೆ ಬೊಲ್ತಲ್ಯಾಂಚ್ಯಾ ತೊಂಡಾತ್ ಗಾವ್ನ್, ಲೊಕಾಂಚ್ಯಾ ಶರಾಪಾಕ್ ಕಾರನ್ ಹೊಲ್ಯಾಸಿ ನ್ಹಯ್! <verse eid="EZK 36:3" /><verse number="4" style="v" sid="EZK 36:4" />ತಸೆ ಹೊವ್ನ್, ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಮಡ್ಡಿಯಾನೊ, ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಆಯ್ಕಾ, ಮಡ್ಡಿಯಾ, ಖಡ್ಡೆ ಅನಿ ಕೊಡ್ಲಾಕ್ನಿಬಿ, ಅನಿ ಡಂಗಳ್ ವಾಡಲ್ಲ್ಯಾ ಹಾಳ್ ಜಾಗ್ಯಾಕ್ನಿ ಬಿ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾನಿ ಚೊರಿ ಕರುನ್ ಚಾಳ್ವುತಲ್ಯಾ ಶಾರಾಕ್ನಿ ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ. <verse eid="EZK 36:4" /><verse number="5" style="v" sid="EZK 36:5" />ಮಾಜ್ಯಾ ದೆಶ್ಯಾಕ್ ತಾಬೆತ್ ಕರುನ್ಗೆವ್ನ್, ಸಗ್ಳ್ಯಾ ಮನಾನ್ ತಿರಸ್ಕಾರ್ ಕರುನ್, ಚೊರಿಕ್ ಡಕ್ಳುನ್ ಘಾಲುನ್ ಸೊಡ್ಲ್ಯಾರ್ಬಿ, ತೆಂಕಾ ಎದೊಮಾಚ್ಯಾಕ್ನಿ ಮಿಯಾ, ಹುರಲ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ ಲೈ ರಾಗಾನ್ ತಾಪುನ್ ಶರಾಪ್ ದಿಯ್ನಸ್ತಾನಾ ಸೊಡಿನಾ. <verse eid="EZK 36:5" /><verse number="6" style="v" sid="EZK 36:6" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಇಜ್ರಾಯೆಲ್ ದೆಶ್ಯಾಚ್ಯಾ ವಿಶಯಾಚಿ ದೆವಾಚಿ ಗೊಸ್ಟ್ ಹಿ, ತೆಜ್ಯಾ ಮಡ್ಡಿಯಾಕ್ನಿ, ಕೊಡ್ಲಾ, ಖಡ್ಡ್ಯಾಕ್ನಿ ಸಾಂಗುಚೆ ಮನುನ್ ಹುಕುಮ್ ಹೊಲಾ, ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಆಹಾ, ಮಿಯಾ ಲೈ ರಾಗಾನ್ ಅನಿ ರಾಗಾನ್ ಸಾಂಗ್ಲಾ, ತುಮಿ ದುಶ್ರ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಅವ್ಮಾನ್ ಅನ್ಬೊಗ್ ಕರ್ಲ್ಯಾಸಿ ನ್ಹಯ್! <verse eid="EZK 36:6" /><verse number="7" style="v" sid="EZK 36:7" />ತಸೆ ಹೊವ್ನ್ ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ತುಮ್ಚ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತಿ ತಿ ಲೊಕಾಚ್ ಅಪ್ನಾಂಚ್ಯಾ ವರ್‍ತಿ ಪಡಲ್ಲ್ಯಾ ಅವ್ಮಾನಾಕ್ ಅನ್ಭೊಗ್ ಕರ್‍ತಾತ್, ತೆ ಖರೆಚ್ ಹಾಯ್, ಮನುನ್ ಹಾತ್ ಉಕ್ಲುನ್ ಆನ್ ಘಾಲುನ್ ಸಾಂಗ್ತಾ. <verse eid="EZK 36:7" /><verse number="8" style="v" sid="EZK 36:8" />ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಮಡ್ಡಿಯಾನೊ, ತುಮ್ಚಿ ಝಾಡಾ ಟಾಂಕಿಯಾ ಪಗ್ಳುನ್, ಮಾಜ್ಯಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಫಳ್ ದಿತಾತ್, ತೆಚಿ ಯೆನೆ ಜಗ್ಗೊಳ್ ಹಾಯ್. <verse eid="EZK 36:8" /><verse number="9" style="v" sid="EZK 36:9" />ಅಬಕ್, ಮಿಯಾ ತುಮ್ಚ್ಯಾ ಪಕ್ಷಾಚೊ, ತುಮ್ಚ್ಯಾಕ್ಡೆ ಪರತ್ಲೊ, ತುಮ್ಚ್ಯಾಕ್ಡೆ ನಾಂಗರ್ತ್ಯಾಸಿ ಅನಿ ಪೆರ್ತ್ಯಾಸಿ ಬಿ ಹೊಯ್. <verse eid="EZK 36:9" /><verse number="10" style="v" sid="EZK 36:10" />ತುಮ್ಚ್ಯಾಕ್ಡೆ ಲೈ ಲೊಕಾ ಮಟ್ಲ್ಯಾರ್, ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚಿ ಸಗ್ಳಿ ಲೊಕಾ ವಸ್ತಿ ರಾಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಸಗ್ಳಿ ಶಾರಾ ಲೊಕಾನಿ ಭರುನ್ ರ್‍ಹಾತ್ಯಾತ್, ಪಾಡ್ ಪಡಲ್ಲ್ಯಾ ಜಾಗ್ಯಾ ವಯ್ನಾ ಮೊಟಿ ಮೊಟಿ ಘರಾ ಭಾಂದುನ್ ಹೊತಾತ್. <verse eid="EZK 36:10" /><verse number="11" style="v" sid="EZK 36:11" />ತುಮ್ಚ್ಯಾಕ್ಡೆ ಲೈ ಲೊಕಾಕ್ನಿ ಅನಿ ಜನಾವರಾಕ್ನಿ ವಾಡ್ವಳ್ಕಿ ಕರ್ತಾ, ತೆನಿ ವಾಡುನ್ ಲೈ ಹೊತಾತ್, ಅದ್ದಿ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆಚ್ ತುಮ್ಚ್ಯಾಕ್ಡೆ ಲೊಕಾಕ್ನಿ ಭರುನ್, ತುಮ್ಕಾ ಅದ್ದಿ ಹೊತ್ತ್ಯಾಕಿಂತಾಬಿ ಲೈ ಬರ್ಯಾ ಜಾಗ್ಯಾಕ್ ಹಾನ್ತಾ, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತುಮ್ಕಾ ಖರೆಚ್ ಕಳ್ತಾ. <verse eid="EZK 36:11" /><verse number="12" style="v" sid="EZK 36:12" />ಮಡ್ಡಿಯಾಂಚ್ಯಾ ಜಾಗ್ಯಾ ಮಿಯಾ ತುಮ್ಚ್ಯಾಕ್ಡೆ ಲೊಕಾ ಫಿರಿ ಸಾರ್ಕೆ ಕರ್ತಾ, ಮಾಜ್ಯಾ ಇಜ್ರಾಯೆಲ್ ತುಜ್ಯಾಕ್ಡೆ ಲೊಕಾ ಫಿರುನ್ಗೆತ್ ತುಕಾ ಆಸ್ತಿ ಕರುನ್ಗೆತಾತ್, ತಿಯಾ ವಾಂಜ್ಡಿ ಹೊವ್ನ್ ನ್ಹಯ್. <verse eid="EZK 36:12" /><verse number="13" style="v" sid="EZK 36:13" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ತಿಯಾ ಮಾನ್ಸಾಕ್ನಿ ಖಾತಲೊ ಹೊವ್ನ್ ತುಜ್ಯಾ ಲೊಕಾಕ್ನಿ ವಾಂಜ್ಡೊ ತರಾಸ್ ದಿಲ್ಲೆ, ಮನುನ್ ತುಕಾ ಶರಾಪ್ತಾತ್ ನ್ಹಯ್. <verse eid="EZK 36:13" /><verse number="14" style="v" sid="EZK 36:14" />ತಿಯಾ ಹೆಜ್ಯಾನ್ ಫಿಡೆ ಮಾನ್ಸಾಕ್ನಿ ಖೊತಲೊ ಹೊವ್ನ್ ರಾಯ್ ನ್ಹಯ್, ತುಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಹೆಜ್ಯಾನ್ ಫಿಡೆ ಲೆಕಾಚೊ ತರಾಸ್ ದಿಯ್ ನ್ಹಯ್. <verse eid="EZK 36:14" /><verse number="15" style="v" sid="EZK 36:15" />ತುಜ್ಯಾ ಕಾನಾಕ್ನಿ ಭಾಯ್ಲ್ಯಾ ದೆಶಾಚೆ ನಕ್ಕೊ ಮನ್ತಲಿ ಗೊಸ್ಟಿಯಾ ಆಯ್ಕಿನಾತ್, ತಿಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಅನಿ ಪರ್‍ತುನ್ ಅವ್ಮಾನ್ ಕರುನ್ಗೆಯ್ ನ್ಹಯ್, ತಿಯಾ ಅನಿ ಪರ್‍ತುನ್ ತುಜಿ ಲೊಕಾ ಪಡುಕ್ ಕಾರನ್ ಹೊವ್ನ್ ರಾಯ್ ನ್ಹಯ್, ಹೆ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 36:15" /></para>
  <para style="s">ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಲೊಕಾಂಚೊ ನ್ಹವ್ವೊ ಜಿವನ್</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 36:16" />ಮಾಕಾ ಸರ್ವೆಸ್ಪರಾನ್ ಹಿ ಗೊಸ್ಟ್ ದಿಲ್ಯಾನ್, <verse eid="EZK 36:16" /><verse number="17" style="v" sid="EZK 36:17" />ನರ್ ಮಾನ್ಸಾ, ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಸಾತ್ ವಸ್ತಿ ರ್‍ಹಾತಾನಾ, ಅಪ್ನಾಚ್ಯಾ ಬುರ್ಸ್ಯಾ ವಾಟೆನಿ ಅನಿ ಬುರ್ಸ್ಯಾ ಕಾಮಾನಿ ತೆ ಬುರ್ಸೆ ಕರ್ಲ್ಯಾನಿ, ತೆಂಚಿ ಹಿ ಚಾಲ್ನುಕ್ ಭಾಯ್ರ್ ಹೊಲ್ಲಿಚೆ ಬುರ್ಶಿ ಪಾನಾ ಸಾರ್ಕೆ ಮಾಕಾ ಬುರ್ಸೆ ಹೊಲೆ. <verse eid="EZK 36:17" /><verse number="18" style="v" sid="EZK 36:18" />ತೆನಿ ದೆಶಾಚ್ಯಾ ವರ್‍ತಿ ರಗಾತ್ ವೊತುನ್, ತೆಕಾ ಅಪ್ನಾಚ್ಯಾ ಮುರ್ತಿಯಾನಿ ಬುರ್ಸೆ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ಮಿಯಾ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಮಾಜಿ ರಾಗಾಚಿ ಆಗ್ ವೊತ್ ತಾ. <verse eid="EZK 36:18" /><verse number="19" style="v" sid="EZK 36:19" />ತೆಂಕಾ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ಪಗ್ಳುನ್ ಘಾಲುನ್, ತೆಂಚ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾಕ್ನಿ ಅನಿ ಬುರ್ಸ್ಯಾ ಚಾಲ್ನುಕಿಕ್ ಸಮಾ ಶಿಕ್ಷ್ಯಾ ದಿತಾ. <verse eid="EZK 36:19" /><verse number="20" style="v" sid="EZK 36:20" />ತೆನಿ ತ್ಯಾ ಲೊಕಾಚ್ಯಾಂತ್ನಿ ಮಿಳ್ಲ್ಯಾಮಾನಾ, ಒಹೊ, ಹೆನಿ ಸರ್ವೆಸ್ಪರಾಚಿ ಲೊಕಾ, ತೆಜ್ಯಾ ದೆಶ್ಯಾತ್ನಾ ಬುರ್ಸೆ ಹೊವ್ನ್ ಯೆಲಾತ್ ಮನುನ್ಗೆವ್ನ್, ಮಾಜ್ಯಾ ನಿತಳ್ ನಾವಾಕ್ ಅವ್ಮಾನ್ ಕರ್‍ತಾತ್. <verse eid="EZK 36:20" /><verse number="21" style="v" sid="EZK 36:21" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಸಗ್ಳ್ಯಾ ಲೊಕಾಂಚ್ಯಾತ್ನಿ ಮಿಳುನ್ ಮಾಜ್ಯಾ ನಿತಳ್ ನಾವಾಕ್ ಅವ್ಮಾನ್ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಮಿಯಾ ಮನಾತ್ ಲೈ ಬೆಜಾರ್ ಕರುನ್ಗೆಟ್ಲೊ. <verse eid="EZK 36:21" /><verse number="22" style="v" sid="EZK 36:22" />ತಸೆ ಹೊವ್ನ್, ತಿಯಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಅಸೆ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನೊ, ತುಮ್ಚ್ಯಾ ಸಾಟ್ನಿ ನ್ಹಯ್, ತುಮಿ ಲೊಕಾತ್ನಿ ಗುಸುನ್ ಬುರ್ಸೆಪಾನಾಕ್ ಗುರಿ ಕರಲ್ಲ್ಯಾ ಮಾಜ್ಯಾ ನಾವಾಚ್ಯಾ ಸಾಟ್ನಿಚ್, ಮಿಯಾ ಕಾಯ್ತರ್ಬಿ ಕರ್ತಾ. <verse eid="EZK 36:22" /><verse number="23" style="v" sid="EZK 36:23" />ಲೊಕಾತ್ನಿ ಮರ್ಯಾದಿಕ್ ಗುರಿ ಹೊಲ್ಲ್ಯಾ ಮಟ್ಲ್ಯಾರ್, ತುಮಿ ಲೊಕಾತ್ನಿ ಮರ್ಯಾದಿಕ್ ಗುರಿ ಕರಲ್ಲ್ಯಾ ಮಾಜ್ಯಾ ಮೊಟ್ಟ್ಯಾ ನಾವಾಚಿ ಮಾನ್ ಮಿಯಾ ರಾಕುನ್ಗೆತಾ, ಅಸೆ ಮಿಯಾ ತೆಂಚ್ಯಾ ಡೊಳ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ತುಮ್ಕಾ ರಾಕ್ವನ್ ಕರ್‍ತಲ್ಯಾ ವಯ್ನಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ತೆಂಕಾ ಕಳ್ತಾ, ಹೆ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 36:23" /><verse number="24" style="v" sid="EZK 36:24" />ಮಿಯಾ ತುಮ್ಕಾ ಲೊಕಾಚ್ಯಾಂಕ್ನಾ ಸೊಡ್ಸುನ್, ಸಗ್ಳ್ಯಾ ದೆಶಾಂತ್ನಾ ಗೊಳಾ ಕರುನ್, ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಸಾಕ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 36:24" /><verse number="25" style="v" sid="EZK 36:25" />ಮಿಯಾ ತುಮ್ಚ್ಯಾ ವರ್‍ತಿ ನಿತಳ್ ಪಾನಾಚೆ ಪಾನಿ ಸಿಪಡ್ತಾನಾ, ತುಮಿ ನಿತಳ್ ಹೊತ್ಯಾಸಿ, ತುಮ್ಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾಕ್ನಾ ಅನಿ ಬುರ್ಸೆಪಾನಾಕ್ನಾ ತುಮ್ಕಾ ಶುದ್ದ್ ಕರ್ತಾ. <verse eid="EZK 36:25" /><verse number="26" style="v" sid="EZK 36:26" />ಮಿಯಾ ತುಮ್ಕಾ ನ್ಹವ್ವೊ ಮನ್ ದಿವ್ನ್, ತುಮ್ಚ್ಯಾಕ್ಡೆ ನ್ಹವ್ವೊ ಆತ್ಮೊ ಉಪ್ಜಿಸಾರ್ಕೆ ಕರ್ತಾ. ತುಮ್ಚ್ಯಾಕ್ನಾ ಗುಂಡೊಹೊಲ್ಲೊ ಮನ್ ಕಾಡುನ್, ತುಮ್ಕಾ ಮ್ಹಂವ್ವ ಮನ್ ದಿತಾ. <verse eid="EZK 36:26" /><verse number="27" style="v" sid="EZK 36:27" />ಮಾಜೊ ಆತ್ಮೊ ತುಮ್ಚ್ಯಾಕ್ಡೆ ರಾಯ್ ಸಾರ್ಕೆ ದಿವ್ನ್, ತುಮಿ ಮಾಜ್ಯಾ ನೆಮಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಚಲಿ ಸಾರ್ಕೆ ಕರ್ತಾ, ತುಮಿ ಮಾಜ್ಯಾ ಹುಕುಮಾ ಮಾನುನ್ ಚಲ್ತ್ಯಾಸಿ. <verse eid="EZK 36:27" /><verse number="28" style="v" sid="EZK 36:28" />ಮಿಯಾ ತುಮ್ಚ್ಯಾ ಪುರ್ವಜಾಕ್ನಿ ದಿಲ್ಲ್ಯಾ ದೆಸಾತ್ ತುಮಿ ವಸ್ತಿ ರ್‍ಹಾತ್ಯಾಸಿ. ಅನಿ ತುಮಿ ಮಾಜಿ ಲೊಕಾ ಹೊವ್ನ್ ರ್‍ಹಾತ್ಯಾಸಿ, ಮಿಯಾ ತುಮ್ಕಾ ದೆವ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="EZK 36:28" /><verse number="29" style="v" sid="EZK 36:29" />ಮಿಯಾ ತುಮ್ಕಾ ಸಗ್ಳ್ಯಾ ಬುರ್ಸ್ಯಾತ್ನಾ ಉದ್ದಾರ್ ಕರುನ್, ಪಿಕ್ ವಾಡುಂದಿತ್ ಮನುನ್ ಹುಕುಮ್ ದಿವ್ನ್, ತೆ ವಾಡ್ವುತಾ ಅನಿ ತುಮ್ಕಾ ಪರ್‍ತುನ್ ಬರ್‍ಗಾಲ್ ಯೆಯ್ನಾ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 36:29" /><verse number="30" style="v" sid="EZK 36:30" />ತುಮಿ ಬರ್ಗಾಲಾತ್ಲೆ ಮನುನ್ ತುಮ್ಕಾ ಲೊಕಾನಿ ಚಾಳ್ವಿ ನಾ ಸಾರ್ಕೆ ಮಿಯಾ ಝಾಡಾಚಿ ಫಳ್ ಅನಿ ಸೆತಾಚೆ ಪಿಕ್ ವಾಡ್ವುತಾ. <verse eid="EZK 36:30" /><verse number="31" style="v" sid="EZK 36:31" />ತನ್ನಾ ತುಮಿ ತುಮ್ಚಿ ಬುರ್ಶಿ ವಾಟಾ ಅನಿ ಬುರ್ಶಿ ಕಾಮಾ ಯಾದೆಕ್ ಹಾನುನ್ಗೆವ್ನ್, ತುಮ್ಚ್ಯಾ ಚುಕೆಂಚ್ಯಾ ಅನಿ ಬುರ್ಸ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ವಯ್ನಾ, ತುಮ್ಚ್ಯಾ ವರ್‍ತಿ ತುಮ್ಕಾಚ್ ಬುರ್ಸೆ ದಿಸ್ತಾ.<verse eid="EZK 36:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 36:32" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮಿಯಾ ಹೆ ರಾಕ್ವನಿಚೆ ಕಾಮ್ ತುಮ್ಚ್ಯಾ ಸಾಟ್ನಿ ಕರುಲಾಗುಕ್ನಾ ಮನ್ತಲೆ ತುಮ್ಕಾ ಕಳುನ್. ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನೊ, ತುಮ್ಚ್ಯಾ ಬುರ್ಸ್ಯಾ ಚಾಲಿಯಾಕ್ನಿ ಮರ್ಯಾದ್ ಕರುನ್ಗೆವಾ ಅನಿ ಲಜ್ಜ್ಯಾ ಕರುನ್ಗೆವಾ. <verse eid="EZK 36:32" /><verse number="33" style="v" sid="EZK 36:33" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮಿಯಾ ತುಮ್ಕಾ ತುಮ್ಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಚುಕೆಂತ್ನಾ ನಿತಳ್ ಕರ್‍ತಲ್ಯಾ ದಿಸಿ ಸಗ್ಳ್ಯಾ ಶಾರ್‍ಹಾತ್ನಿ ಲೊಕಾನಿ ಭರ್ತಾ. ಹಾಳ್ ಪಡಲ್ಲ್ಯಾ ಜಾಗ್ಯಾ ವೈನಿ ಮೊಟಿ ಮೊಟಿ ಘರಾ ಭಾಂದುನ್ ಹೊತಾತ್. <verse eid="EZK 36:33" /><verse number="34" style="v" sid="EZK 36:34" />ದಾಟುನ್ ಜಾತಲ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಪಾಡ್ ಪಡುನ್ ಡಂಗಳ್ ಹೊಲ್ಲ್ಯಾ ಜಿಮ್ನಿಕ್ ನಾಂಗರ್ತ್ಯಾಸಿ ಕರ್‍ತಾತ್. <verse eid="EZK 36:34" /><verse number="35" style="v" sid="EZK 36:35" />ತನ್ನಾ ಲೊಕಾ, ಡಂಗಳ್ ಹೊಲ್ಲೆ ಹೆ ದೆಶ್ ಎದೆನ್ ಮ್ಹಳ್ಯಾ ಸಾರ್ಕೆ ಹೊಳ್ವುಲ್ಲಾ, ಪಡುನ್ ಜಾವ್ನ್ ಹಾಳ್ ಹೊಲ್ಲಿ ಶಾರಾ, ಮೊಟ್ಟ್ಯಾ ಮೊಟ್ಟ್ಯಾ ಘರಾನಿ ಭರುನ್, ಲೊಕಾನಿ ಭರುನ್ ಹಾಯ್ ನ್ಹಯ್ ಮನುಲ್ಲಾತ್. <verse eid="EZK 36:35" /><verse number="36" style="v" sid="EZK 36:36" />ಮಿಯಾ ಸರ್ವೆಸ್ಪರಾನುಚ್ ಪಡುನ್ ಗೆಲ್ಲೆ ಭಾಂದುನ್, ಹಾಳ್ ಹೊಲ್ಲೆ ವಾಡ್ವುಲಾ ಮನುನ್ ತುಮ್ಚ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ಲೊಕಾಕ್ನಿ ಕಳ್ತಾ, ಹೆ ಮಿಯಾ ಸರ್ವೆಸ್ಪರಾನುಚ್ ಸಾಂಗ್ಲಾ, ಅನಿ ಕರ್ತಾ.<verse eid="EZK 36:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EZK 36:37" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮಿಯಾ ಅನಿ ಎಕ್ ವಿಶಯಾತ್, ಇಜ್ರಾಯೆಲಾಂಚಿ ಮಾಗ್ನಿ ಆಯ್ಕುನ್ ಜವಾಬ್ ದಿತಾ, ಮಟ್ಲ್ಯಾರ್ ತೆಂಚೆ ಅಂಕೆ ಬಕ್ರ್ಯಾಚ್ಯಾ ಹಿಂಡಾ ಸಾರ್ಕೆ ಕರುನ್ ವಾಡ್ವುತಾ. <verse eid="EZK 36:37" /><verse number="38" style="v" sid="EZK 36:38" />ಎಚುನ್ ಥವಲ್ಲ್ಯಾ ತಾಂಡ್ಯಾ ಸಾರ್ಕೆ ಅನಿ ಸನಾತ್ನಿ ಜರುಜಲೆಮಾಕ್ ಎವ್ನ್ ಮಿಳ್ತಲ್ಯಾ ತಾಂಡ್ಯಾಚಿ ಲೊಕಾ ಹಾಳ್ ಪಡಲ್ಲ್ಯಾ ಶಾರ್‍ಹಾತ್ನಿ ತಾಂಡೆ ಹೊವ್ನ್ ಗೊಳಾ ಹೊತಾತ್, ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತೆಂಕಾ ಕಳ್ತಾ.<verse eid="EZK 36:38" /></para>
  <chapter eid="EZK 36" />
  <chapter number="37" style="c" sid="EZK 37" />
  <para style="s">ವಾಳ್ಕ್ಯಾ ಹಡ್ಡಾಂಚೆ ಕೊಳ್ಳ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 37:1" />ಮಿಯಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಮಹಿಮೆನ್ ಭರುನ್ ರ್‍ಹಾತಾನಾ, ತೆನಿ ಅಪ್ನಾಚ್ಯಾ ಆತ್ಮ್ಯಾ ವಯ್ನಾ ಮಾಕಾ ನ್ಹೆವ್ನ್, ಹಡ್ಡಾನಿ ಭರಲ್ಲ್ಯಾ ಎಕ್ ಕೊಳ್ಳಾತ್ ಉತರ್‍ಲ್ಯಾನ್. <verse eid="EZK 37:1" /><verse number="2" style="v" sid="EZK 37:2" />ಅನಿ ಮಿಯಾ ತ್ಯಾ ಕೊಳ್ಳಾತ್ನಾ ಮದ್ನಾ ಹಡ್ಡಾತ್ನಿ ಚಲುನ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್, ಅಬಕ್, ಕೊಳ್ಳಾತ್ ಸಗ್ಳ್ಯಾಕ್ಡೆ ಲೈ ವಾಳುನ್ ಗೆಲ್ಲಿ ಹಡ್ಡಾ ಮೆಜುಕ್ ಹೊಯ್ನಾ ತವ್ಡಿ ಪಡಲ್ಲಿ ಹೊತ್ತಿ. <verse eid="EZK 37:2" /><verse number="3" style="v" sid="EZK 37:3" />ತೆನಿ ಮಾಕಾ, “ನರ್ ಮಾನ್ಸಾ, ಹ್ಯಾ ಹಡ್ಡಾಕ್ನಿ ಜಿವ್ ಯೆತಾ ಕಾಯ್”? ಮನುನ್ ಇಚಾರ್‍ತಾನಾ, ಮಿಯಾ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾ, “ತುಕಾಚ್ ಗೊತ್ತ್”, ಮನುನ್ ಜವಾಬ್ ದಿಲೊ. <verse eid="EZK 37:3" /><verse number="4" style="v" sid="EZK 37:4" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ ಅಸೆ ಹುಕುಮ್ ದಿಲ್ಯಾನ್, ತಿಯಾ ಹಡ್ಡಾಂಚ್ಯಾ ವರ್‍ತಿ ಪರ್‍ವಾದನ್ ಕರುನ್ ಅಸೆ ಸಾಂಗ್, ವಾಳ್ಕ್ಯಾ ಹಡ್ಡಾನೊ, ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಆಯ್ಕಾ. <verse eid="EZK 37:4" /><verse number="5" style="v" sid="EZK 37:5" />ತುಮ್ಕಾ ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಅಬಕ್, ಮಿಯಾ ತುಮ್ಚ್ಯಾ ಭುತ್ತುರ್ ಶ್ವಾಸ್ ಭರಿಸಾರ್ಕೆ ಸಾರ್ಕೆ ಕರ್ತಾ, ತುಮಿ ಝಿತ್ತೆ ಹೊತ್ಯಾಸಿ. <verse eid="EZK 37:5" /><verse number="6" style="v" sid="EZK 37:6" />ಮಿಯಾ ತುಮ್ಚ್ಯಾ ವರ್‍ತಿ ಸಿರಾ ಪಗ್ಳುನ್, ಮಾಂಸ್ ಯೆಯ್ ಸಾರ್ಕೆ, ಚಮ್ಡೆ ಯೆಯ್ ಸಾರ್ಕೆ, ತುಮ್ಕಾ ಉಸಿಲ್ ಭರ್ತಾ. ತನ್ನಾ ತುಮಿ ಝಿತ್ತೆ ಹೊವ್ನ್ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತ್ಯಾಸಿ. <verse eid="EZK 37:6" /><verse number="7" style="v" sid="EZK 37:7" />ಮಾಕಾ ಹುಕುಮ್ ದಿವ್ನ್ ಹೊಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತಿ ದೆವಾಚಿ ಗೊಸ್ಟ್ ಸಾಂಗಿತ್ ರ್‍ಹಾತಾನಾ, ಆವಾಜ್ ಆಯ್ಕೊ ಯೆಲೊ, ಅಬಕ್ ಟಕ್ ಟಕ್ ಮನುನ್ಗೆತ್ ಹಡ್ಡಾಕ್ನಿ ಹಡ್ಡಾ ಜೊಡ್ಸುನ್ ಹೊಲಿ. <verse eid="EZK 37:7" /><verse number="8" style="v" sid="EZK 37:8" />ಮಿಯಾ ಬಗ್ತಾನಾ ಆಹಾ, ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಸಿರಾ ಪಗಳ್ಲಿ, ಮಾಂಸ್ ಯೆಲೆ, ಚಮ್ಡೆ ಕಾಂಬ್ರಾನ್ ಹೊಲೆ, ಉಸಿಲ್ ಮಾತ್ರಾ ನತ್ತೊ. <verse eid="EZK 37:8" /><verse number="9" style="v" sid="EZK 37:9" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ, ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಉಸಿಲಾಕ್ ಸಾಂಗ್, ಶ್ವಾಸಾ, ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ತಿಯಾ ಚಾರಿ ದಿಕ್ಕಾನಿಕ್ನಾ ಮರಲ್ಲಿ ಆಂಗಾ ಝಿತ್ತಿ ಹೊಯ್ ಸಾರ್ಕೆ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಮಾರ್, ಮನುನ್ ಉಸಿಲಾಕ್ ಸಾಂಗ್, ಮನುನ್ ಹುಕುಮ್ ದಿತಾನಾ, ಮಿಯಾ ಹುಕುಮಾಚ್ಯಾ ಸಾರ್ಕೆ ಬೊಲ್ಲೊ.<verse eid="EZK 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 37:10" />ಮಿಯಾ ಹುಕುಮ್ ಕರ್ತಾನಾ, ಅಬಕ್ ತ್ಯಾತುರ್ ಉಸಿಲ್ ಯೆಲೊ, ಝಿತ್ತಿ ಹೊಲಿ, ಪಾಂಯಾ ಲಾವ್ನ್ ಇಬೆ ರಾಲಿ, ಲೈ ಮೊಟೊ ಸಯ್ನ್ ಹೊಲೊ. <verse eid="EZK 37:10" /><verse number="11" style="v" sid="EZK 37:11" />ಮಾನಾ ತೆನಿ ಮಾಕಾ ಅಸೆ ಸಾಂಗ್ಲ್ಯಾನ್, ನರ್ ಮಾನ್ಸಾ, ಹಿ ಹಡ್ಡಾ ಇಜ್ರಾಯೆಲಾಂಚಿ ಫುರಾ ಪಿಳ್ಗಿ, ಅಬಕ್ ತ್ಯಾ ಪಿಳ್ಗಿಚೆ ಅಯ್ಯೊ, ಅಮ್ಚಿ ಹಡ್ಡಾ ವಾಳುನ್ ಗೆಲ್ಲಿ, ಅಮ್ಚೊ ಭರೊಸೊ ಹಾಳ್ ಹೊಲೊ, ಅಮಿ ಮುಳಾಕ್ನಾ ನಾಶ್ ಹೊಲ್ಯಾಂವ್, ಮನುನ್ಗೆತ್ ಹಾತ್. <verse eid="EZK 37:11" /><verse number="12" style="v" sid="EZK 37:12" />ತಸೆ ಹೊವ್ನ್ ತಿಯಾ ಹಿ ದೆವಾಚಿ ಪ್ರವಾದನ್ ತೆಂಕಾ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮಾಜ್ಯಾ ಲೊಕಾನೊ ಬಗಾ, ಮಿಯಾ ತುಮ್ಚಿ ಸಮಾಧಿಯಾ ಉಗ್ಡುನ್, ತುಮ್ಕಾ ತ್ಯಾತುರ್ನಾ ಉಟ್ವುನ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ದೆಸಾಕ್ ಬಲ್ವುನ್ ಹಾನುನ್ ಮಿಳ್ವುತಾ. <verse eid="EZK 37:12" /><verse number="13" style="v" sid="EZK 37:13" />ಮಾಜ್ಯಾ ಲೊಕಾನೊ, ಮಿಯಾ ತುಮ್ಚ್ಯಾ ಸಮಾಧಿಯಾಕ್ನಿ ಉಗ್ಡುನ್, ತ್ಯಾತುರ್ನಾ ತುಮ್ಕಾ ಉಟ್ವುತಾ. ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ತುಮ್ಕಾ ಖರೆಚ್ ಕಳ್ತಾ. <verse eid="EZK 37:13" /><verse number="14" style="v" sid="EZK 37:14" />ಮಿಯಾ ಮಾಜೊ ಉಸಿಲ್ ತುಮ್ಕಾ ದಿವ್ನ್, ತುಮ್ಕಾ ಝಿತ್ತೆ ಕರುನ್ ತುಮ್ಚ್ಯಾ ದೆಸಾತ್ ವಸ್ತಿ ರಾಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೊ ಮಿಯಾಚ್ ಹೆ ಸಾಂಗ್ಲಾ ಮನುನ್ ಕಳ್ವುನ್ಗೆತ್ಯಾಸಿ, ಹಿ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ.<verse eid="EZK 37:14" /></para>
  <para style="s">ಇಜ್ರಾಯೆಲ್ ಅನಿ ಜುದಾ ಎಕುಚ್ ರಾಜ್ಯಾತ್</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 37:15" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲ್ಯಾನ್. <verse eid="EZK 37:15" /><verse number="16" style="v" sid="EZK 37:16" />ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಎಕ್ ದಾಂಡೊ ಘೆವ್ನ್, ತೆಜ್ಯಾ ವರ್‍ತಿ ಜುದಾಚೆ, ಜುದಾಕ್ ಮಿಳಲ್ಲ್ಯಾ ಇಜ್ರಾಯೆಲಾಚೆ ಮನುನ್ ಬಲ್ವುನ್, ಅನಿ ಎಕ್ ದಾಂಡೊ ಕಾಡುನ್, ತ್ಯಾತುರ್ ಜೊಸೆಪಿಚೆ ಎಪ್ರಾಯಿಮಾಚ್ಯಾ ಜೊಸೆಪಿಕ್ ಮಿಳಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಇಜ್ರಾಯೆಲಾಂಚೆ ಮನುನ್ ಲಿವ್. <verse eid="EZK 37:16" /><verse number="17" style="v" sid="EZK 37:17" />ತೆಜ್ಯಾ ಮಾನಾ ತೆ ತುಮ್ಚ್ಯಾ ಹಾತಿತ್ ಎಕ್ ಹೊಯ್ ಸಾರ್ಕೆ ತೆ ಎಕಾ ಮೆಕಾಕ್ ಲಾಂಬ್ ಕರುನ್ ಮಿಳ್ವುನ್ ಧರ್. <verse eid="EZK 37:17" /><verse number="18" style="v" sid="EZK 37:18" />ತುಜಿ ಲೊಕಾ, ಹೆ ಕಾಯ್? ಅಮ್ಕಾ ಸಾಂಗಿ ನ್ಯಾಸಿ ಕಾಯ್ ಮನುನ್ ತುಕಾ ಇಚಾರ್‍ತಾನಾ ತಿಯಾ ತೆಂಕಾ, <verse eid="EZK 37:18" /><verse number="19" style="v" sid="EZK 37:19" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಅಬಕ್, ಎಪ್ರಾಯಿಮಾನ್ ಧರಲ್ಲೊ ದಾಂಡೊ ಮಟ್ಲ್ಯಾರ್ ಜೊಸೆಪಿಚ್ಯಾ ಅನಿ ಜೊಸೆಪಿಕ್ ಮಿಳಲ್ಲ್ಯಾ ಕುಳಿಯಾಂಚೊ ದಾಂಡೊ ಮಿಯಾ ಕಾಡುನ್, ಜುದಾಂಚ್ಯಾ ದಾಂಡ್ಯಾಕ್ ಲಾಂಬಿ ಹೊವ್ನ್ ಮಿಳ್ವುನ್, ತೆ ದೊನಿಬಿ ಮಾಜ್ಯಾ ಹಾತಿತ್ ಎಕುಚ್ ದಾಂಡೊ ಕರುನ್ ಧರುನ್ಗೆತಾ, ಮನುನ್ ಸಾಂಗ್. <verse eid="EZK 37:19" /><verse number="20" style="v" sid="EZK 37:20" />ತಸೆ ಸಾಂಗ್ತಾನಾ, ತಿಯಾ ನಾಂವಾ ಲಿವಲ್ಲೆ ದಾಂಡೆ ತೆಂಚ್ಯಾ ಡೊಳ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ತುಜ್ಯಾ ಹಾತಿತ್ ರಾಂವ್ದಿತ್. <verse eid="EZK 37:20" /><verse number="21" style="v" sid="EZK 37:21" />ತೆಂಕಾ ಅಸೆ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಅಬಕ್, ಇಜ್ರಾಯೆಲಾಚಿ ಲೊಕಾ, ಧರುನ್ ನ್ಹೆವ್ನ್ ಹೊಲ್ಲ್ಯಾ ಲೊಕಾಂತ್ನಾ ಮಿಯಾ ತೆಂಕಾ ಉದ್ದಾರ್ ಕರುನ್, ಸಗ್ಳ್ಯಾ ಭಾಜುಕ್ನಾ ಮಿಳ್ವುನ್ ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಶ್ಯಾಕ್ ಬಲ್ವುನ್ ಹಾನ್ತಾ. <verse eid="EZK 37:21" /><verse number="22" style="v" sid="EZK 37:22" />ಥೈ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಮಡ್ಡಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ, ಎಕುಚ್ ಕುಳಿಚಿ ಲೊಕಾ ಕರ್ತಾ, ತೆಂಕಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಎಕ್ಲೊಚ್ ರಾಜಾ ರ್‍ಹಾತಾ, ತೆನಿ ಅನಿ ಕನ್ನಾಬಿ ಎಗ್ಳೆ ಹೊವ್ನ್ ರಾಯ್ನಸ್ತಾನಾ ಎಕುಚ್ ಹೊವ್ನ್ ರ್‍ಹಾತ್ಯಾಸಿ. <verse eid="EZK 37:22" /><verse number="23" style="v" sid="EZK 37:23" />ಅಪ್ನಾಚ್ಯಾ ಮುರ್ತಿಯಾನಿ ಹೊಂವ್ದಿತ್, ಬುರ್ಸ್ಯಾ ವಸ್ತಾನಿ ಹೊಂವ್ದಿತ್, ಅನಿ ಕಸ್ಲ್ಯಾಬಿ ಬುರ್ಸ್ಯಾ ಕಾಮಾನಿ ಹೊಂವ್ದಿತ್, ಅಪ್ನಾಕ್ನಿ ಹೆಜ್ಯಾನ್ ಫಿಡೆ ಬುರ್ಸೆ ಕರುನ್ಗೆಯ್ನಾತ್, ತೆನಿ ಪಾಪ್ ಕರುನ್, ಚುಕೆತ್ ಗಾವ್ನ್ ಪಡಲ್ಲ್ಯಾ ತನ್ನಾ ಮಿಯಾ ತೆಂಕಾ ಚುಕ್ವುನ್ ನಿತಳ್ ಕರ್ತಾ. ತೆನಿ ಮಾಜಿ ಲೊಕಾ ಹೊವ್ನ್ ರ್‍ಹಾತ್ಯಾತ್. ಅನಿ ಮಿಯಾ ತೆಂಕಾ ದೆವ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="EZK 37:23" /><verse number="24" style="v" sid="EZK 37:24" />ಮಾಜೊ ಸೆವಕ್ ದಾವಿದ್ ತೆಂಕಾ ರಾಜಾ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ತೆಂಕಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಎಕ್ಲೊಚ್ ಕುರ್ಬುರ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ತೆನಿ ಮಾಜಿ ನೆಮಾ ಪಾಳುನ್ ಮಾಜಿ ಕಾಮಾ ಕರುನ್ಗೆವ್ನ್ ರ್‍ಹಾತ್ಯಾತ್. <verse eid="EZK 37:24" /><verse number="25" style="v" sid="EZK 37:25" />ಮಾಜೊ ಸೆವಕ್ ಜಾಕೊಬಾಕ್ ಮಿಯಾ ದಿಲ್ಲ್ಯಾ ದೆಸಾತ್, ತೆನಿ ವಸ್ತಿ ರ್‍ಹಾತ್ಯಾತ್, ಹೊಯ್ ತುಮ್ಚಿ ಪುರ್ವಜಾ ವಸ್ತಿ ಹೊತ್ತ್ಯಾ ದೆಸಾತ್ ತೆನಿ ವಸ್ತಿ ರ್‍ಹಾತ್ಯಾತ್, ಮಾಜೊ ಸೆವಕ್ ದಾವಿದ್ ತೆಂಕಾ ಕನ್ನಾಬಿ ರಾಜಾ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="EZK 37:25" /><verse number="26" style="v" sid="EZK 37:26" />ಅನಿ ಮಿಯಾ ತೆಂಚ್ಯಾಕ್ನಾ, ಸಮಾಧಾನಾಚೊ ಕರಾರ್ ಕರುನ್ಗೆತಾ, ತೊ ಕನ್ನಾಬಿ ರ್‍ಹಾತಾ. ಮಿಯಾ ತೆಂಚ್ಯಾಕ್ಡೆ ವಸ್ತಿ ರ್‍ಹಾವ್ನ್ ವಾಡ್ವಳ್ಕಿ ಕರುನ್ ತೆಂಚ್ಯಾ ಮದ್ದಿ ಮಾಜಿ ನಿತಳ್ ಗುಡಿ ಕನ್ನಾಬಿ ರಾಯ್ ಸಾರ್ಕಿ ಕರುನ್ ಭಾಂದ್ತಾ. <verse eid="EZK 37:26" /><verse number="27" style="v" sid="EZK 37:27" />ಹೊಯ್ ಮಿಯಾ ವಸ್ತಿ ರಾತಲೊ ಜಾಗೊ ತೆಂಚ್ಯಾ ಮದ್ದಿ ರ್‍ಹಾತಾ, ಮಿಯಾ ತೆಂಕಾ ದೆವ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಅನಿ ತೆನಿ ಮಾಜಿ ಲೊಕಾ ಹೊವ್ನ್ ರ್‍ಹಾತ್ಯಾತ್. <verse eid="EZK 37:27" /><verse number="28" style="v" sid="EZK 37:28" />ಮಾಜಿ ನಿತಳ್ ಗುಡಿ ತೆಂಚ್ಯಾ ಮದ್ದಿ ಶಾಶ್ವತಾಕ್ ರ್‍ಹಾತಾನಾ, ಇಜ್ರಾಯೆಲಾಕ್ನಿ ಎಚುನ್ಗೆಟಲ್ಲೊ ಸರ್ವೆಸ್ಪರ್ ಮಿಯಾಚ್ ಮನುನ್ ಲೊಕಾಕ್ನಿ ಗೊತ್ತ್ ಕಳ್ತಾ.<verse eid="EZK 37:28" /></para>
  <chapter eid="EZK 37" />
  <chapter number="38" style="c" sid="EZK 38" />
  <para style="s">ಗೊಗ್ ದೆವಾಚೊ ಹತಿಯಾರ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 38:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲ್ಯಾನ್. <verse eid="EZK 38:1" /><verse number="2" style="v" sid="EZK 38:2" />ನರ್ ಮಾನ್ಸಾ, ಮೆಶಿಕಿಚ್ಯಾಕ್ನಿ ತುಬುಲಿಚ್ಯಾಕ್ನಿ ರಾಜ್ವಡ್ಕಿ ಕರ್ತಲೊ ಮಾಗೊಗ್ ದೆಶಾಚೊ ರಾಜಾ ಗುಗಾಕ್ಡೆ ತೊಂಡ್ ಕರುನ್, ತೆಕಾ ಹೆ ದೆವಾಚೆ ಪ್ರವಾದನ್ ಕರ್. <verse eid="EZK 38:2" /><verse number="3" style="v" sid="EZK 38:3" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮೆಶೆಕ್ ಅನಿ ತುಬುಲ್ ಲೊಕಾಂಚ್ಯಾ ರಾಜಾ ಗುಗ್, ಅಹಾ, ಮಿಯಾ ತುಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 38:3" /><verse number="4" style="v" sid="EZK 38:4" />ತುಕಾ ಪಾಟಿ ಫಿರ್ವುನ್, ತುಜ್ಯಾ ದಾವ್ಡಿಕ್ ಗೊಕ್ಕೊ ಘಾಲುನ್, ತುಜ್ಯಾ ಸಗ್ಳ್ಯಾ ಸಯ್ನ್ಯಾಕ್ ಅನಿ ಘೊಡ್ಕ್ಯಾಕ್ನಿ, ಅನಿ ಘೊಡ್ಕಿಯಾ ಚಾಲ್ವುನಾರ್ಯಾಕ್ನಿ, ಹೆಂಕಾ ಮಾರುಕ್ ಮೊಟೊ ಸಯ್ನ್ ಅಪ್ನಾಚ್ಯಾ ತಲ್ವಾರಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಎಲ್ಯಾನಿ. <verse eid="EZK 38:4" /><verse number="5" style="v" sid="EZK 38:5" />ಕೊನ್ಬಿ ಚುಕಿನಸ್ತಾನಾ, ಖೆಡ್ಯಾ ಅನಿ ಟಕ್ಲ್ಯಾಚ್ಯಾ ರಾಕ್ವನಿಚ್ಯಾ ಸಾಟ್ನಿ ಹೊತ್ತೆ ಪಾರಸಿಯಾ, ಕುಶ್ಯಾ ಅನಿ ಕುಟ್ಯಾ, ಹೆನಿಬಿ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಎಲ್ಯಾನಿ. <verse eid="EZK 38:5" /><verse number="6" style="v" sid="EZK 38:6" />ಹೆಂಕಾ ಗೊಮೆರಾಚ್ಯಾಕ್ನಿ ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾಕ್ನಾ ಯೆಲ್ಲ್ಯಾ ತೊಗರ್ಮೆಚ್ಯಾಕ್ನಿ, ಒಟ್ಟು ಲೈ ಸಯ್ನಿಕಾಕ್ನಿ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 38:6" /><verse number="7" style="v" sid="EZK 38:7" />ತಯಾರ್ ಹೊ, ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳುನ್ ಯೆಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ತಾಂಡ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ, ತುಕಾ ತಯಾರ್ ಕರುನ್ಗೆ, ತೆಂಕಾ ತಿಯಾಚ್ ವಾಟ್ ದಾಕ್ವುನಾರೊ ಹೊವ್ನ್ ರಾ. <verse eid="EZK 38:7" /><verse number="8" style="v" sid="EZK 38:8" />ಲೈ ದಿಸಾಂಚ್ಯಾ ಮಾನಾ, ಮಿಯಾ ತುಕಾ ಬಲ್ವುತಾ, ತಲ್ವಾರಾನ್ ನಾಶ್ ಹೊವ್ನ್, ಪರ್‍ತುನ್ ಝಿತ್ತೆ ಹೊಲ್ಲ್ಯಾ ದೆಶ್ಯಾತ್ ತಿಯಾ ಸಗ್ಳ್ಯಾ ಎಳಾರ್ನಿ ಗುಸುನ್, ಲೈ ಲೊಕಾ ಹೊತ್ತ್ಯಾ ಮಾಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿ ಪಡ್ತೆಯ್. ಹೊಯ್ ಲೊಕಾಂತ್ನಾ ಪಾರ್ ಹೊಲ್ಲಿ ತಿ ಸಗ್ಳಿ ಲೊಕಾ ಲೈ ಯೆಳಾಕ್ನಾ ಹಾಳ್ ಹೊಲ್ಲ್ಯಾ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಮಡ್ಡಿಯಾಂಚ್ಯಾ ಜಾಗ್ಯಾ ವಯ್ನಿ ಆರಾಮಾನ್ ವಸ್ತಿ ರ್‍ಹಾತಾನಾ, ತಿಯಾ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಪಡ್ತೆಯ್. <verse eid="EZK 38:8" /><verse number="9" style="v" sid="EZK 38:9" />ತಿಯಾ ಅನಿ ತುಜಿ ಸಗ್ಳಿ ಸಯ್ನಿಕಾ ತುಜ್ಯಾಕ್ನಾ ಹೊತ್ತಿ ಲೈ ಲೊಕಾ, ಮೊಟೆ ವಾರೆ ವಾದಾಳ್ ಸಾರ್ಕೆ ಎವ್ನ್ ಸೊಡ್ತ್ಯಾಶಿ, ಕಾಳ್ಯಾ ಮೊಡಾನಿ ಭರಲ್ಯಾ ಸಾರ್ಕೆ ತ್ಯಾ ದೆಶ್ಯಾಕ್ ಧಾಪ್ತ್ಯಾಸಿ. <verse eid="EZK 38:9" /><verse number="10" style="v" sid="EZK 38:10" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ತನ್ನಾ ತುಜ್ಯಾ ಮನಾತ್ ಯೆವ್ಜನಿಯಾ ಭರ್ತಾತ್. <verse eid="EZK 38:10" /><verse number="11" style="v" sid="EZK 38:11" />ತಿಯಾ, ಆಹಾ, ಮಿಯಾ ಗಾಂವಾಕ್ ಕುಪ್ಪ್ ನಸಲ್ಲ್ಯಾ ಗಾಂವಾತ್ನಿ ಗುಸುನ್ ದಾರಾಕ್ನಿ ಅಗ್ಳಿ, ಭಿತ್ತಿಯಾ ನಸ್ತಾನಾ, ಆರಾಮಾನ್ ರ್‍ಹಾತಲ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿ ಪಡ್ತಾ ಮನುನ್ಗೆಟ್ಲ್ಯಾನ್. <verse eid="EZK 38:11" /><verse number="12" style="v" sid="EZK 38:12" />ಲುಟ್ ಕರುನ್ ಹಾಳ್ ಕರುಚೆ ಮನುನ್ಗೆವ್ನ್ ಲೊಕಾ ನಸ್ತಾನಾ ರ್‍ಹಾವ್ನ್ ಅತ್ತಾ ಲೊಕಾನಿ ಭರಲ್ಲ್ಯಾ ಜಾಗ್ಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕ್ಲುಚೆ ಮನುನ್ಗೆವ್ನ್, ಲೊಕಾಂತ್ನಿ ಗೊಳಾ ಹೊವ್ನ್ ಗೊರಾಡೊರಾ ಘೆವ್ನ್ ಜಾಗ್ಯಾಚ್ಯಾ ಮದ್ದಿ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾಕ್ನಿ ಜಿವ್ ಕಾಡುಚೆ ಮನುನ್ ಬುರ್ಸೆಪಾನ್ ಚಿಂತುನ್ಗೆತ್ ರ್‍ಹಾತೆಯ್. <verse eid="EZK 38:12" /><verse number="13" style="v" sid="EZK 38:13" />ಶೆಬಾಚೆ ಅನಿ ದೆದಾನಿಚೆ ಅನಿ ತಾರ್ಶಿಸಿಚಿ ಯಾಪಾರ್ ಕರ್‍ತಲೆ, ತೆಚಿ ಸಿಂವಾಚ್ಯಾ ಸಾರ್ಕೆ ವಾಯಾ ಹೊತ್ತಿ ಲೊಕಾ, ತುಕಾ ಬಗುನ್, ತಿಯಾ ಚೊರಿ ಕರುಕ್ ಯೆಲೈ ಕಾಯ್? ಚೊರಿ ಕರುನ್ ಚಾಂದಿ ಅನಿ ಸೊನೆ ಘೆವ್ನ್, ಗೊರಾಡೊರಾ ಸಗ್ಳಿ ಲುಟುನ್, ಲೈ ಬದಿಕ್ ಚೊರುನ್ ನ್ಹೆವ್ಕ್ ತುಜ್ಯಾ ತಾಂಡ್ಯಾಕ್ ಮಿಳ್ವುನ್ ಘೆವ್ನ್ ಯೆಲೈ ಕಾಯ್ ಮನುನ್ ಇಚಾರ್ತಾತ್. <verse eid="EZK 38:13" /><verse number="14" style="v" sid="EZK 38:14" />ಅಸೆ ರ್‍ಹಾತಾನಾ, ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಹಿ ದೆವಾಚಿ ಪ್ರವಾದನ್ ಗೊಗಾಕ್ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮಾಜಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಆರಾಮಾನ್ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾ ಎಳಾರ್, ತೆಂಚೆ ಆರಾಮ್ ಪಾನ್ ತುಕಾಬಿ ಕಳ್ತಾ ನ್ಹಯ್. <verse eid="EZK 38:14" /><verse number="15" style="v" sid="EZK 38:15" />ತಿಯಾ ಹೊತ್ತೊ ಜಾಗೊ ಸೊಡುನ್, ಗೊಳಾಹೊಲ್ಲ್ಯಾ ಲೈ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಘೊಡ್ಕಿಯಾಂಚ್ಯಾ ಮೊಟ್ಟ್ಯಾ ಸಯ್ನ್ಯಾ ವಾಂಗ್ಡಾ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ನಾ ಯೆತೆಯ್. <verse eid="EZK 38:15" /><verse number="16" style="v" sid="EZK 38:16" />ಅನಿ ಮಾಜ್ಯಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿ ಕಾಳಿ ಮೊಡಾ ಗತಿನ್ ಧಾಪ್ತೆಯ್, ಎ ಗುಗ್, ಮಿಯಾ ತುಕಾ ಲೊಕಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ನಾಶ್ ಕರ್‍ತಲ್ಯಾ ವಯ್ನಾ ಮಾಜಿ ಮಾನ್ ರಾಕುನ್ಗೆತಾ. ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ಲೊಕಾಕ್ನಿ ಕಳಿಸಾರ್ಕೆ ತುಕಾ ಸಗ್ಳ್ಯಾ ಎಳಾರ್ನಿ ದೆಶ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಝಗ್ಡ್ಯಾಕ್ ಉಟಿ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 38:16" /><verse number="17" style="v" sid="EZK 38:17" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮಾಜಿ ಸೆವಕಾ ಇಜ್ರಾಯೆಲಾಚಿ ಪರ್ವಾದಿಯಾ ಅದ್ಲ್ಯಾ ಕಾಲಾತ್ ಲೈ ಎಳ್ ಪರ್‍ವಾದನ್ ಕರುನ್, ಮಿಯಾ ಎಕ್ಲ್ಯಾಕ್ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ವರ್‍ತಿ ಝಗ್ಡ್ಯಾಕ್ ಉಟಿ ಸಾರ್ಕೆ ಕರ್ತಾ, ಮನುನ್ ಫಿಡೆ ಹೊತಲೆ ಹೊತ್ತೆ ಅದ್ದಿಚ್ ಸಾಂಗ್ಲೊ. ತನ್ನಾ, ತೆ ಹೊತಲೆ ಹೊತ್ತೆ ಅದ್ದಿಚ್ ತೆಂಚ್ಯಾ ತೊಂಡಾನ್ ಕಳಯಲ್ಲೆ ಮಿಯಾಚ್.<verse eid="EZK 38:17" /></para>
  <para style="s">ಗೊಗಾಚ್ಯಾ ವರ್‍ತಿ ದೆವಾಚಿ ಶಿಕ್ಷ್ಯಾ</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 38:18" />ಸರ್ವೆಸ್ಪರ್ ಸಾಂಗ್ತಾ, ಗೊಗ್ ಇಜ್ರಾಯೆಲ್ ದೆಶಾಚ್ಯಾ ವರ್‍ತಿ ಝಗ್ಡ್ಯಾಕ್ ಉಟ್ತಾನಾ ಮಿಯಾ ರಾಗಾನ್ ತಾಪ್ಲಾ. <verse eid="EZK 38:18" /><verse number="19" style="v" sid="EZK 38:19" />ಮಿಯಾ ರಾಗಾನ್ ಅನಿ ಲೈ ರಾಗಾನ್ ಪೆಟುನ್ಗೆತ್ ಅಸೊ ಸಾಂಗ್ಲೊ, ತ್ಯಾ ದಿಸಾತ್ನಿ ಇಜ್ರಾಯೆಲ್ ದೆಸಾತ್ ಮೊಟೊ ಹಾದರ್ತಲೆ ಹೊತಲೆ ಖರೆಚ್ ಹೊಯ್. <verse eid="EZK 38:19" /><verse number="20" style="v" sid="EZK 38:20" />ತನ್ನಾ ಸಮುಂದರಾತ್ಲಿ ಮಾಸೊಳಿಯಾ, ಮಳ್ಬಾತ್ಲಿ ಫಾಕ್ರಾ ಅನಿ ಡಂಗ್ಳಿತ್ಲಿ ಜನಾವರಾ, ಜಿಮ್ನಿ ವರ್‍ತಿ ತೆವಳ್ತಲೆ ಜಿವ್ದಾನಿಯಾ ಅನಿ ಜಿಮ್ನಿ ವೈಲಿ ಸಗ್ಳಿ ಮಾನ್ಸಾ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಥರ್ಥರ್ತಾತ್, ಮಡ್ಡಿಯಾ ಪರ್‍ತುನ್ ಪಡ್ತಾತ್. ಝರೆ ಮುಜುನ್ ಪಡ್ತಾತ್, ಸಗ್ಳಿ ಬಿತ್ತಿಯಾ ಜಿಮ್ನಿಕ್ ಲಾಗುನ್ ಪಡ್ತಾತ್. <verse eid="EZK 38:20" /><verse number="21" style="v" sid="EZK 38:21" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ತಲ್ವಾರ್ ಅನಿ ಮಾಜಿ ಸಗ್ಳಿ ಮಡ್ಡಿಯಾ ಗೊಗಾಕ್ ಜಿವ್ ಕಾಡುಂದಿತ್ ಮನುನ್ ಹುಕುಮ್ ದಿತಾ. ಹರ್ ಎಕ್ ಮಾನ್ಸಾಚೊ ತಲ್ವಾರಾನಿ ತೆಜ್ಯಾ ಭಾವಾಕ್ ವಿರೊದ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="EZK 38:21" /><verse number="22" style="v" sid="EZK 38:22" />ಮಿಯಾ ಗೊಗಾಚ್ಯಾ ವಾಂಗ್ಡಾ ವಾದ್ ಕರುನ್, ತೆಕಾ ದುಕ್ನೆ ಎವ್ನ್ ಭರಿಸಾರ್ಕೆ ಕರುನ್ ತೆಜ್ಯಾ ವರ್‍ತಿ ಅನಿ ತೆಜ್ಯಾ ಸಯ್ನ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಅನಿ ತೆಜ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿ ಲೈ ಪಾವ್ಸ್ ಅನಿ ಮೊಟಿ ಘಾರ್ಬಿಯಾ, ಆಗ್, ಗಂದಕ್, ಹೆ ಸಗ್ಳೆ ಪಾಡ್ವುತಾ. <verse eid="EZK 38:22" /><verse number="23" style="v" sid="EZK 38:23" />ಮಿಯಾ ಅಸೆ ಮಾಜಿ ಮಹಿಮಾ ದಾಕ್ವುನ್, ಮಾಜಿ ಮಾನ್ ರಾಕುನ್ಗೆವ್ನ್, ಲೈ ಲೊಕಾನಿ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳ್ವುನ್ ಘೆಯ್ ಸಾರ್ಕೆ ತೆಂಚ್ಯಾ ಇದ್ರಾಕ್ ದಾಕ್ವುನ್ ಘೆತಾ.<verse eid="EZK 38:23" /></para>
  <chapter eid="EZK 38" />
  <chapter number="39" style="c" sid="EZK 39" />
  <para style="s">ಗೊಗ್ ಹಾರ್ತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 39:1" />ನರ್ ಮಾನ್ಸಾ, ಅತ್ತಾ ತಿಯಾ ಗೊಗಾಕ್ ವಿರೊದ್ ಹೊವ್ನ್ ಹೆ ಪರ್ವಾದ್ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಮೆಶೆಕ್, ಅನಿ ತುಬುಲ್ ಲೊಕಾಂಚ್ಯಾ ರಾಜಾ ಹೊಲ್ಲ್ಯಾ ಎ ಗೊಗ್, ಮಿಯಾ ತುಕಾ ವಿರೊದ್ ಹೊಲಾ. <verse eid="EZK 39:1" /><verse number="2" style="v" sid="EZK 39:2" />ಮಿಯಾ ತುಕಾ ಬದ್ಲುನ್ ಫಿಡೆ ಚಾಲ್ವುನ್ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ನಾ ಯೆಯ್ ಸಾರ್ಕೆ ಕರುನ್ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಮಡ್ಡಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EZK 39:2" /><verse number="3" style="v" sid="EZK 39:3" />ತುಜ್ಯಾ ಡಾವ್ಯಾಕ್ನಾ ಬಿಲ್ಲಾ ಫೊಡುನ್, ತುಜ್ಯಾ ಉಜ್ವ್ಯಾ ಹಾತಿತ್ನಾ ಬಾನ್ ಪಾಡ್ವುತಾ. <verse eid="EZK 39:3" /><verse number="4" style="v" sid="EZK 39:4" />ತಿಯಾಬಿ ಸಯ್ನ್ಯಾಬಿ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತೊ ಲೊಕ್ಬಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಮಡ್ಡಿಯಾಂಚ್ಯಾ ವಯ್ನಿ ಪಡುನ್ ಜಾತ್ಯಾಸಿ. ಮಿಯಾ ತುಮ್ಕಾ ಮಾಂಸ್ ಖಾತಲ್ಯಾ ದುಸ್ರಿ ದುಸ್ರಿ ಫಾಕ್ರಾಕ್ನಿ ಜಿಮ್ನಿ ವಯ್ಲ್ಯಾ ಜಿವ್ದಾನಿಯಾಕ್ನಿ ಜೆವಾನ್ ಕರ್ತಾ. <verse eid="EZK 39:4" /><verse number="5" style="v" sid="EZK 39:5" />ತಿಯಾ ಉಗ್ಡ್ಯಾ ಮ್ಹಾಳಾತ್ ಪಡ್ತೆಯ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಹೆ ಮಿಯಾಚ್ ಹುಕುಮ್ ದಿಲಾ ನ್ಹಯ್, ಮನುನ್ ಸರ್ವೆಸ್ಪರ್ ಸಾಂಗ್ತಾ. <verse eid="EZK 39:5" /><verse number="6" style="v" sid="EZK 39:6" />ಮಿಯಾ ಮಾಗೊಗ್ ದೆಶಾ ವರ್‍ತಿ ಅನಿ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆಚ್ಯಾ ಕೊಳ್ಳಾಚ್ಯಾ ವರ್‍ತಿ ಭಿಂಯೆ ನಸ್ತಾನಾ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಆಗ್ ಧಾಡ್ತಾ, ತನ್ನಾ ತೆಂಕಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳ್ತಾ. <verse eid="EZK 39:6" /><verse number="7" style="v" sid="EZK 39:7" />ಮಿಯಾ ಮಾಜೆ ಪವಿತ್ರ್ ನಾವ್ ಮಾಜ್ಯಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ದಾಕ್ವುತಾ, ತೆಂಕಾ ಹೆಜ್ಯಾನ್ ಫಿಡೆ ಅವ್ಮಾನ್ ಹೊಯ್ನಾ ಸಾರ್ಕೆ ಬಗುನ್ಗೆತಾ, ತನ್ನಾ ಮಿಯಾಚ್ ಇಜ್ರಾಯೆಲಾಂಚೊ ಪವಿತ್ರ್ ದೆವ್ ಮನ್ತಲೆ ದುಶ್ರ್ಯಾ ಲೊಕಾಕ್ನಿ ಕಳುನ್ ಯೆತಾ. <verse eid="EZK 39:7" /><verse number="8" style="v" sid="EZK 39:8" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಅಬಕ್ ಹೆ ಯೆಲೆ ಅನಿ ಹೆ ಹೊಲೆ ಮಿಯಾ ಅದ್ದಿಚ್ ಸಾಂಗಲೊ ದಿಸ್ ಹ್ಯೊಚ್. <verse eid="EZK 39:8" /><verse number="9" style="v" sid="EZK 39:9" />ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಶಾರಾಂತ್ಲಿ ಲೊಕಾ ಮ್ಹಾಳಾಕ್ ಎವ್ನ್ ವಿರೊದಿಯಾಂಚ್ಯಾ ಹಾತಿಯಾರಾಕ್ನಿ ಆಗ್ ಲಾವ್ನ್ ಜಾಳ್ವುತಾತ್, ಹೊಯ್ ಖೆಡ್ಯಾ, ಗುರಾನಿ, ಬಾನ್ ಅನಿ ಬಿಲ್ಲಾ, ಟೊನೊ ಅನಿ ಭರ್ಚಿ ಹೆ ಸಗ್ಳೆ ಸಾತ್ ವರ್ಸಾ ಪತರ್ಬಿ ಜಾಳ್ವುನ್ಗೆತುಚ್ ರ್‍ಹಾತ್ಯಾತ್. <verse eid="EZK 39:9" /><verse number="10" style="v" sid="EZK 39:10" />ತೆಜ್ಯಾ ಸಾಟ್ನಿ ತೆನಿ ಡಂಗ್ಳಿತ್ನಾ ನಾಕ್ಡಾ ಹಾನ್ತಲೆ ನಾ, ಡಂಗ್ಳಿತ್ ಜಾವ್ನ್ ಝಾಡ್ ತೊಡ್ತಲೆ ನಾ, ಹಾತಿಯಾರಾಚ್ ನಾಕ್ಡಾ ಕರುನ್ ಆಗ್ ಲಾವ್ತಾತ್, ಅಪ್ನಾಕ್ನಿ ಲುಟಲ್ಯಾಕ್ನಿ ತೆನಿ ಲುಟ್ತಾತ್, ಅಪ್ನಾಚೆ ಚೊರಲ್ಯಾಂಚೆಚ್ ತೆನಿಬಿ ಚೊರ್ತಾತ್, ಹೆ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 39:10" /></para>
  <para style="s">ಗೊಗಾಕ್ ಸಮಾದಿ ಕರ್‍ತಲೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 39:11" />ಮಿಯಾ ತ್ಯಾ ದಿಸಾತ್ನಿ ಇಜ್ರಾಯೆಲಾತ್ ಲವನ್ ಸಮುಂದರಾಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾತ್ ಕೊಳ್ಳಾಚಿ ಪರ್ಯಾನ್ ಕರ್‍ತಲ್ಯಾಂಚಿ ವಾಟ್ ಗೊಗಾಚೊ ಮಾಟಿ ಕರ್ತಲೊ ಜಾಗೊ ಕರ್ತಾ, ಥೈ ಪರ್ಯಾನ್ ಕರುಕ್ ಹೊಯ್ನಾ, ಗೊಗಾಕ್ ಅನಿ ತೆಜ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ಥೈಚ್ ಮಾಟಿ ದಿಲ್ಲೆ ರ್‍ಹಾತಾ. ತೆ ಹೆಮೊನ್ ಗೊಗ್ ಕೊಳ್ಳ್ ಮನ್ವುನ್ ಘೆತಾ. <verse eid="EZK 39:11" /><verse number="12" style="v" sid="EZK 39:12" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಗಾಂವಾಕ್ನಿ ನಿತಳ್ ಕರ್‍ತಲ್ಯಾ ಸಾಟ್ನಿ, ಸಾತ್ ಮ್ಹೈನೆ ತೆಂಕಾ ಮಾಟಿ ಕರುನ್ಗೆತುಚ್ ರ್‍ಹಾತ್ಯಾತ್. <verse eid="EZK 39:12" /><verse number="13" style="v" sid="EZK 39:13" />ಹೊಯ್ ದೆಶಾಚಿ ಸಗ್ಳಿ ಲೊಕಾ ತೆಂಕಾ ಮಾಟಿ ಕರ್‍ತಾತ್, ಅಸೆ ತೆನಿ ಮಾಜಿ ಪ್ರಸಿದ್ಧಿ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಯಾದಿಚೊ ದಿಸ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಹೆ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 39:13" /><verse number="14" style="v" sid="EZK 39:14" />ಮಾನಾ ತೆನಿ ದೆಶ್ ಚೊಕ್ ಕರ್‍ತಲ್ಯಾಕ್ನಿ ಎಚುನ್ ಕಾಡುನ್, ತುಮಿ ಸಗ್ಳ್ಯಾ ದೆಸಾತ್ ಫಿರುನ್ಗೆತ್ ಜಿಮ್ನಿ ವರ್‍ತಿ ದಿಸಲ್ಲಿ ಸಗ್ಳಿ ಹಡ್ಡಾ ಪುರಾ, ಮನುನ್ ತೆಂಕಾ ನೆಮ್ತಾತ್, ಅನಿ ಸಾತ್ ಮ್ಹಯ್ನೆ ಕಳದ್ಲ್ಯಾ ಮಾನಾ ತೆನಿ ಹ್ಯಾ ಪುರ್ತಲ್ಯಾ ಕಾಮಾಕ್ ಲಾಗ್ತಾತ್. <verse eid="EZK 39:14" /><verse number="15" style="v" sid="EZK 39:15" />ಕೊನ್ತರ್ಬಿ ಎಕ್ಲೊ ವಾಟೆ ವರ್‍ತಿ ಪರ್ಯಾನ್ ಕರುನ್ಗೆತ್ ರ್‍ಹಾತಾನಾ, ಮಾನ್ಸಾಚಿ ಹಡ್ಡಾ ದಿಸ್ಲ್ಯಾರ್, ಥೈ ಕಾಯ್ತರ್ಬಿ ಎಕ್ ವಳಕ್ ಕರುನ್ ಥವ್ತಾ. ಮಾಟಿ ಕರ್ನಾರಿ ಲೊಕಾ ಎವ್ನ್ ತೆ ಗೊಗಾಚ್ಯಾ ಕೊಳ್ಳಾತ್ ನೆವ್ನ್ ಮಾಟಿ ಕರಿ ಪತರ್ಬಿ ತಿ ವಳಕ್ ತಸಿಚ್ ಇಬೆ ಕರುನ್ ಥವಲ್ಲಿ ರ್‍ಹಾತಾ. <verse eid="EZK 39:15" /><verse number="16" style="v" sid="EZK 39:16" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಎಕ್ ಶಾರಾಕ್ ಹೆಮೊನ್ ಮನ್ತಲೆ ಶಾರಾಚಿ ನಾವ್ ಹೊತಾ, ಅಸೆ ದೆಶ್ ನಿತಳ್ ಕರುನ್ ಹೊತಾ.<verse eid="EZK 39:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 39:17" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚ್ಯಾ ಜನಾವರಾಕ್ನಿ ಅನಿ ಸಗ್ಳ್ಯಾ ಜಿಮ್ನಿ ವಯ್ಲ್ಯಾ ಜಿವ್ದಾನಿಯಾಕ್ನಿ ಅಸೆ ಸಾಂಗ್. ತುಮಿ ಗೊಳಾ ಹೊವ್ನ್ ಎವ್ನ್ ಮಿಯಾ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಮಡ್ಡಿ ವರ್‍ತಿ ಮಿಯಾ ತುಮ್ಚ್ಯಾ ಸಾಟ್ನಿ ಕರ್‍ತಲ್ಯಾ ಬಲಿಸಾಟ್ನಿ ಎವ್ನ್, ಮಾಸ್ ಖಾವ್ನ್ ರಗಾತ್ ಫಿವಾ. <verse eid="EZK 39:17" /><verse number="18" style="v" sid="EZK 39:18" />ಶೆಳಿ, ಟಗರ್, ಬಕ್ರೆ, ಪಾಲ್ವೊ, ಪಾಡೊ, ಅನಿ ಬಾಶಾನಿಚಿ ಸಗ್ಳಿ ಮಾಂದ್ಯಾಚಿ ಜನಾವರಾ ಮಟ್ಲ್ಯಾರ್, ಪುಡಾರಾಂಚೆ ಅನಿ ಬಲಿಶ್ಟ್ ಲೊಕಾ ಹೆಂಚೆ ಸಗ್ಳ್ಯಾಂಚೆ ಮಾಂಸ್ ಅನಿ ರಗ್ತಾ ತುಮ್ಕಾ ಗಾವ್ತಾ. <verse eid="EZK 39:18" /><verse number="19" style="v" sid="EZK 39:19" />ಮಿಯಾ ತುಮ್ಚ್ಯಾ ಸಾಟ್ನಿ ಬಲಿ ಭೆಟ್ವಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಜನಾವರಾಂಚೆ ಮಾಸ್ ಪೊಟ್ಬರ್ ಖಾತ್ಯಾಸಿ, ರಗಾತ್ ನಿಶ್ಯಾ ಹೊಯ್ ಪತರ್ಬಿ ಫಿತ್ಯಾಶಿ. <verse eid="EZK 39:19" /><verse number="20" style="v" sid="EZK 39:20" />ಮಿಯಾ ತಯಾರ್ ಕರಲ್ಲ್ಯಾ ತ್ಯಾ ಜೆವ್ನಾತ್ ಘೊಡ್ಕಿಯಾ ಚಾಲ್ವುನಾರೊ ಅನಿ ರಥಾ ಚಾಲ್ವುನಾರೆ ಅನಿ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಝಗ್ಡ್ಯಾತ್ ಚಾಲು ಹೊತ್ತೆ, ಅನಿ ಸಗ್ಲ್ಯಾ ನಮುನ್ಯಾಚಿ ಸಯ್ನಿಕಾ ಲೊಕಾಕ್ನಿ ತುಮಿ ಆರಾಮಾನ್ ಜೆವಾನ್ ಖಾತ್ಯಾಸಿ ಮನ್ತಲೆ, ಹೆ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 39:20" /></para>
  <para style="s">ಇಜ್ರಾಯೆಲ್ ಪರ್‍ತುನ್ ಭಾಂದ್ತಲೆ</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 39:21" />ಅಸೆ ಮಿಯಾ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ಮಾಜಿ ಮಹಿಮಾ ಸ್ಥಾಪನ್ ಕರಲ್ಯಾ ತನ್ನಾ, ತ್ಯಾ ಸಯ್ನಿಕಾಂಚ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕ್ಲುನ್ ಝಡ್ತಿ ಕರಲ್ಲೊ ಮಿಯಾಚ್ ಮನುನ್ ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ಕಳ್ತಾ. <verse eid="EZK 39:21" /><verse number="22" style="v" sid="EZK 39:22" />ತ್ಯಾ ದಿಸಾಕ್ನಾ ಫಿಡೆ ಸಗ್ಳ್ಯಾ ಎಳಾರ್ಬಿ ಮಿಯಾಚ್ ಸದಾ ಸರ್ವತಾಕ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಕಳ್ವುನ್ಗೆತಾತ್. <verse eid="EZK 39:22" /><verse number="23" style="v" sid="EZK 39:23" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ, ಅಪ್ನಾಚ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ವಯ್ನಾಚ್ ಬಂಧಿಹೊವ್ನ್ ಗೆಲಿ ಅನಿ ತೆನಿ ಮಾಕಾ ವಿರೊದ್ ಹೊವ್ನ್ ಚುಕ್ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿಚ್ ಮಿಯಾ ತೆಂಕಾ ಫಾಟ್ ಕರುನ್ ತೆನಿ ವಿರೊಧಿಯಾಂಚ್ಯಾ ಹಾತಿತ್ ತಲ್ವಾರಾಕ್ ಗಾಯ್ ಸಾರ್ಕೆ ಕರ್ಲೊ ಮನುನ್ ಸಗ್ಳಿ ಲೊಕಾ ಕಳ್ವುನ್ ಘೆತಾತ್. <verse eid="EZK 39:23" /><verse number="24" style="v" sid="EZK 39:24" />ತೆಂಚ್ಯಾ ನಿತಳ್ ನಸಲ್ಲ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾಕ್ನಿ ಸಮಾ ಹೊಯ್ ಸಾರ್ಕೆ ತೆಂಕಾ ಶಿಕ್ಷ್ಯಾ ದಿವ್ನ್ ಮಿಯಾ ತೆಂಕಾ ಫಾಟ್ ಕರ್ಲೊ. <verse eid="EZK 39:24" /><verse number="25" style="v" sid="EZK 39:25" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮಾಜ್ಯಾ ಪವಿತ್ರ್ ನಾವಾಕ್ ಹೆಜ್ಯಾನ್ ಫಿಡೆ ಬುರ್ಸೆ ನಾವ್ ಯೆಯ್ನಾ ಸಾರ್ಕೆ ಮಿಯಾ ಅತ್ತಾ ತೆಂಚ್ಯಾಕ್ಡೆ ಪರ್‍ತುನ್ ಜಾಕೊಬ್ಯಾಂಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಯೆಲ್ಲ್ಯಾ ಬುರ್ಸ್ಯಾ ಕಾಮಾಕ್ನಾ ಚುಕ್ವುನ್, ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾ ಲೊಕಾಕ್ನಿ ದಯಾ ದಾಕ್ವುತಾ. <verse eid="EZK 39:25" /><verse number="26" style="v" sid="EZK 39:26" />ಮಿಯಾ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ದುಶ್ರ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಹಾತಿತ್ನಾ ಚುಕ್ವುನ್, ತ್ಯಾ ವಿರೊಧಿಯಾಂಚ್ಯಾ ದೆಸಾತ್ನಾ ಗೊಳಾ ಕರುನ್, ಲೈ ಲೊಕಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ತೆಂಕಾ ರಾಕ್ವನ್ ಕರ್‍ತಲ್ಯಾ ವಯ್ನಾ ಮಾಜೊ ಮಾನ್ ಲೈ ಕರುನ್ ಘೆತಾ. <verse eid="EZK 39:26" /><verse number="27" style="v" sid="EZK 39:27" />ಮಾನಾ ತೆನಿ ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಸಾತ್ ಕೊನಾಚೆಬಿ ಭಿಂಯೆ ನಸ್ತಾನಾ ವಸ್ತಿ ಹೊತ್ತ್ಯಾ ಎಳಾರ್, ಅಪ್ನಿ ಮಾಕಾ ಕರಲ್ಲ್ಯಾ ಚುಕೆಂಚ್ಯಾ ವಿಶಯಾತ್ ತೆಂಕಾ ಮರ್ಯಾದ್ ದಿಸ್ತಾ. <verse eid="EZK 39:27" /><verse number="28" style="v" sid="EZK 39:28" />ಮಿಯಾ ತೆಂಕಾ ದುಶ್ರ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಹಾತಿತ್ ಬಂಧಿಹೊವ್ನ್ ಜಾಯ್ ಸಾರ್ಕೆ ಕರುನ್ ಅನಿ ಪರ್‍ತುನ್ ಕೊನಾಕ್ಬಿ ಸೊಡಿ ನಸ್ತಾನಾ, ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಸಾಕ್ ಪರ್‍ತುನ್ ಹಾನಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತೆಂಚೊ ಸರ್ವೆಸ್ಪರ್ ಮಿಯಾಚ್ ಮನುನ್ ತೆಂಕಾ ಕಳ್ವುನ್ಗೆತಾತ್. <verse eid="EZK 39:28" /><verse number="29" style="v" sid="EZK 39:29" />ಅನಿ ಕನ್ನಾಬಿ ದೆಸಾತ್ ಪರ್‍ತುನ್ ಮಿಯಾ ತೆಂಕಾ ಫಾಟ್ ಕರುನ್ ರ್‍ಹಾಯ್ನಾ, ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿ ಮಿಯಾ ಮಾಜೊ ಆತ್ಮೊ ವತ್ಲಾ, ಹೆ ರಾಜಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 39:29" /></para>
  <chapter eid="EZK 39" />
  <chapter number="40" style="c" sid="EZK 40" />
  <para style="s">ಎಜ್ಕೆಲಾಕ್ ಜರುಜಲೆಮಾಕ್ ಘೆವ್ನ್ ಗೆಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 40:1" />ಅಮಿ ಬಂಧಿಹೊಲ್ಲ್ಯಾ ಪಂಚಿಸ್ವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಮಟ್ಲ್ಯಾರ್, ಶಾರ್ ನಾಶ್ ಹೊಲ್ಲ್ಯಾ ಚವ್ದಾವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಪಯ್ಲೆಚ್ಯಾ ಮ್ಹಯ್ನ್ಯಾಚ್ಯಾ ಧಾವ್ಯಾ ದಿಸಾತ್, ಹೊಯ್ ತ್ಯಾಚ್ ದಿಸಿ ಮಿಯಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಮಹಿಮೆನ್ ಭರುನ್ ರ್‍ಹಾತಾನಾ, ತೆನಿ ಮಾಕಾ ಥೈ ನ್ಹೆಲ್ಯಾನ್. <verse eid="EZK 40:1" /><verse number="2" style="v" sid="EZK 40:2" />ತೆನಿ ಮಾಕಾ ಇಜ್ರಾಯೆಲ್ ದೆಸಾಕ್ ಹಾನುನ್, ಲೈ ಮೊಟ್ಟ್ಯಾ ಮಡ್ಡಿ ವರ್‍ತಿ ಉತರ್ಸಲ್ಯಾನ್ ಸಾರ್ಕೆ, ಮಾಕಾ ದೆವಾಚ್ಯಾ ದರ್ಶನಾತ್ ದಿಸುನ್ ಯೆಲೆ, ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ಡೆ ತ್ಯಾ ಮಡ್ಡಿಚ್ಯಾ ವರ್‍ತಿ ಶಾರಾ ಸಾರ್ಕೆ ಹೊತ್ತೆ ಎಕ್ ಮೊಟೆ ಘರ್ ದಿಸ್ಲೆ. <verse eid="EZK 40:2" /><verse number="3" style="v" sid="EZK 40:3" />ತೆನಿ ಮಾಕಾ ಥೈ ಹಾನಲ್ಲ್ಯಾ ತನ್ನಾ ಅಬಕ್, ತಾಂಬ್ಯಾ ಗತಿನ್ ಹೊಳಾವ್ತಲೊ ಎಕ್ ಮಾನುಸ್, ದೊರಿ ಅನಿ ಮಾಪಾಚಿ ಖಾಟಿ ಹಾತಿತ್ ಧರುನ್ಗೆವ್ನ್ ದಾರಾತ್ ಇಬೆ ಹೊತ್ತೊ. <verse eid="EZK 40:3" /><verse number="4" style="v" sid="EZK 40:4" />ತ್ಯಾ ಘವ್ಮಾನ್ಸಾನ್ ಮಾಕಾ, ನರ್ ಮಾನ್ಸಾ, ತಿಯಾ ಡೊಳೆ ಲಾವ್ನ್ ಬಗ್, ಕಾನ್ ದಿವ್ನ್ ಆಯ್ಕ್, ಮಿಯಾ ತುಕಾ ದಾಕ್ವಲ್ಲೆ ಸಗ್ಳೆ ಮನ್ ದಿವ್ನ್ ಕಳ್ವುನ್ ಘೆ. ಮಿಯಾ ತುಕಾ ದಾಕ್ವುತಲೆ ತಿಯಾ ಬಗುಚೆ ಮನುನುಚ್ ತುಕಾ ಹಿತ್ತೆ ಹಾನುನ್ ಹೊಲಾ, ತಿಯಾ ಬಗಲ್ಲೆ ಸಗ್ಳೆ ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಪರ್ಗಟ್ ಕರ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="EZK 40:4" /></para>
  <para style="s">ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚೊ ದಡ್ಪೊ</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 40:5" />ಅಬಕ್ ಎಕ್ ಭಿತ್ತ್ ಮೊಟ್ಟ್ಯಾ ಘರಾಕ್ ಭೊತ್ಯಾನಿ ಘಾಟಲ್ಲಿ ಹೊತ್ತಿ, ತ್ಯಾ ಮಾನ್ಸಾಚ್ಯಾ ಹಾತಿತ್, ತಿನ್ ಹಾತ್ ಲಾಂಬಿಚಿ ಮಾಪಾಚಿ ಖಾಟಿ ಹೊತ್ತಿ, ತೆನಿ ತ್ಯಾ ಭಿತ್ತಿಕ್ ರುಂದಿ ತಿನ್ ಹಾತ್ ಅನಿ ಉನ್ಚಿಕ್ ತಿನ್ ಹಾತ್ ಮಾಪ್ಲ್ಯಾನ್. <verse eid="EZK 40:5" /><verse number="6" style="v" sid="EZK 40:6" />ತೆಜ್ಯಾ ಮಾನಾ ತೆನಿ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ಮುಖ್ಯ್ ದಡ್ಪ್ಯಾಕ್ಡೆ ಎವ್ನ್ ಪಯ್ರಿಯಾ ವಯ್ನಿ ಚಡುನ್, ಹುಂಬ್ಡ್ಯಾಕ್ ಎಕ್ ಖಾಟಿ ಮಾಪ್ಲ್ಯಾನ್, ಎಕೆಕ್ ಹುಂಬ್ಡೊ ತಿನ್ ಖಾಟಿ ರುಂದ್ ಹೊತ್ತೊ. <verse eid="EZK 40:6" /><verse number="7" style="v" sid="EZK 40:7" />ಥೈ ಭಿತ್ತಿಕ್ಡೆ ಹೊತ್ತ್ಯಾ ಎಕೆಕ್ ಖೊಲಿಚಿ ಲಾಂಬಿ ಎಕೆಕ್ ಖಾಟಿ, ಅನಿ ರುಂದಿಬಿ ಎಕೆಕ್ ಖಾಟಿ, ತ್ಯಾ ಭಿತ್ತಿಯಾಂಚಿ ಖೊಲಿಯಾ ಎಕಾಕ್ ಎಕ್ ಪಾಚ್ ಪಾಚ್ ಹಾತ್ ಧುರ್ ಹೊತ್ತಿ, ಗುಡಿಚ್ಯಾ ಇದ್ರಾಕ್ ಹೊತ್ತೊ, ದಾರ್ ಮಂಟಪ್, ಎಕ್ ಖಾಟಿ ರುಂದ್ ಹೊತ್ತೊ. <verse eid="EZK 40:7" /><verse number="8" style="v" sid="EZK 40:8" />ಮಾನಾ ತೆನಿ ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ, ದಾರ್ ಮಂಟಪ್ಬಿ ರುಂದಿ ಮಾಪ್ಲ್ಯಾನ್, ತೆ ಎಕ್ ಖಾಟಿ ಲಾಂಬಿಕ್ ಹೊತ್ತೆ. <verse eid="EZK 40:8" /><verse number="9" style="v" sid="EZK 40:9" />ಮಾನಾ ತೆನಿ ಮುಖ್ಯ್ ದಾರಾಚೆ ದಾರ್ ಮಂಟಪಾಚಿ ರುಂದಿ ಮಾಪ್ಲ್ಯಾನ್, ತೆ ಆಟ್ ಹಾತ್ ಅನಿ ಖಾಂಬ್ಯಾಂಚಿ ರುಂದಿ ದೊನ್ ಹಾತ್ ಮನುನ್ ಮಾಪ್ಲ್ಯಾನ್, ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ ದಾರ್ ಮಂಟಪ್ ಗುಡಿಚ್ಯಾ ಇದ್ರಾಕ್ ಹೊವ್ನ್ ಹೊತ್ತೊ. <verse eid="EZK 40:9" /><verse number="10" style="v" sid="EZK 40:10" />ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ ದೊನಿ ಭಾಜುಕ್ನಿ, ತಿನ್ ಭಿತ್ತಿಯಾಂಚಿ ಖೊಲಿಯಾ ಹೊತ್ತಿ, ತ್ಯಾ ತಿನ್ಬಿ ಎಕುಚ್ ಮಾಪಾಚೆ ಹೊತ್ತೆ, ಅನಿ ದೊನಿ ಭಾಜುಚೆ ಖಾಂಬೆಬಿ ಎಕುಚ್ ಮಾಪಾಚೆ ಹೊತ್ತೆ.<verse eid="EZK 40:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 40:11" />ತೆಜ್ಯಾ ಮಾನಾ ತೆನಿ ಮುಖ್ಯ್ ದಡ್ಪೊ ಮಾಪ್ಲ್ಯಾನ್, ತೆಚಿ ರುಂದಿ ಪಾಂಚ್ ಹಾತ್, ಲಾಂಬಿ ಸಾಡೆ ಸಾ ಹಾತ್. <verse eid="EZK 40:11" /><verse number="12" style="v" sid="EZK 40:12" />ದೊನಿ ಭಾಜುಚ್ಯಾ ಭಿತ್ತಿಯಾಂಚ್ಯಾ ಖೊಲಿಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಎಕೆಕ್ ಹಾತ್ ಜಾಗೊ ಹೊತ್ತೊ, ದೊನಿ ಭಾಜುಚ್ಯಾ ಭಿತ್ತಿಯಾಂಚ್ಯಾ ಖೊನಾಂಚಿ ರುಂದಿ ಸಾ ಹಾತ್ ಹೊತ್ತಿ. <verse eid="EZK 40:12" /><verse number="13" style="v" sid="EZK 40:13" />ತೆನಿ ಎಕ್ ಭಾಜುಚ್ಯಾ ಭಿತ್ತಿಚ್ಯಾ ಖೊಲಿಯಾಂಚ್ಯಾ ಮಾಳ್ಯಾಚ್ಯಾ ಭಾಯ್ಲ್ಯಾ, ಅನಿ ಎಕ್ ಭಾಜುಚ್ಯಾ ಭಿತ್ತಿಚ್ಯಾ ಖೊಲಿಚ್ಯಾ ಮಾಳ್ಯಾಚ್ಯಾ ಭಾಯ್ಲ್ಯಾ ತುದಿಕ್ ಮಟ್ಲ್ಯಾರ್, ಎಕ್ ಖೊಲಿಚ್ಯಾ ದಾರಾಕ್ನಾ ಅನಿ ಎಕ್ ಖೊಲಿಚ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಕ್ ರುಂದಿ ಮಾಪ್ತಾನಾ, ತೆ ಪಂಚಿಸ್ ಹಾತ್ ಹೊತ್ತೆ. <verse eid="EZK 40:13" /><verse number="14" style="v" sid="EZK 40:14" />ದಾರಾತ್ಲೆ ಖಾಂಬ್ಯಾಕ್ನಿ ಮಾಪ್ತಾನಾ, ತಿಸ್ ಹಾತ್ ಹೊತ್ತೆ, ಮುಖ್ಯ್ ದಾರಾಕ್ನಿ ಭೊತ್ಯಾನ್ ರ್‍ಹಾತಲ್ಯಾ ಖಾಂಬ್ಯಾಚ್ಯಾ ಸಗೊಳ್ ಮಾಪ್ ಕರ್ಲ್ಯಾನ್. <verse eid="EZK 40:14" /><verse number="15" style="v" sid="EZK 40:15" />ಗುಸ್ತಲ್ಯಾ ವಾಟೆಚ್ಯಾ ಭಾಯ್ಲ್ಯಾ ಭಾಜುಕ್ನಾ, ಭುತ್ತುರ್ ಗುಸ್ತಲ್ಯಾ ಆಕ್ರಿ ಪತರ್ ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ ಪತರ್ ಪಂಚಿಸ್ ಹಾತ್ ಲಾಂಬಿ ಹೊತ್ತೆ. <verse eid="EZK 40:15" /><verse number="16" style="v" sid="EZK 40:16" />ಭಿತ್ತಿಚ್ಯಾ ಖೊಲಿಯಾತ್ನಿ ಅನಿ ಭುತ್ತುರ್ಲ್ಯಾ ದಾರ್ ಮಂಟಪಾಚ್ಯಾ ದೊನಿ ಭಾಜುಚ್ಯಾ ಖಾಂಬ್ಯಾತ್ನಿಬಿ ಉಗ್ಡುಕ್ ಹೊಯ್ನಸಲ್ಲಿ ಕಿಡ್ಕಿಯಾ ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ ಭೊತ್ಯಾನ್ ಹೊತ್ತಿ, ಭಾಯ್ಲ್ಯಾ ಖಾಂಬ್ಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಖಜುರಾಚ್ಯಾ ಝಾಡಾಂಚಿ ಚಿತ್ತಾರ್ ಕಾಡಲ್ಲಿ ಹೊತ್ತಿ.<verse eid="EZK 40:16" /></para>
  <para style="s">ಭಾಯ್ಲೆ ಆಂಗಾನ್</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 40:17" />ಮಾನಾ ತೆನಿ ಮಾಕಾ ಭಾಯ್ಲ್ಯಾ ಆಂಗ್ನಾಕ್ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್; ಅಬಗ್, ಖೊಲಿಯಾ ಅನಿ ದಾರಾಚ್ಯಾ ಭೊತ್ಯಾನ್ ಘಾಟಲ್ಲಿ ಉಸಿ ದಿಸ್ಲಿ, ಸಗ್ಳೆ ಮಿಳುನ್ ಜಿಮ್ನಿ ವರ್‍ತಿ ಉಸಿಚ್ಯಾ ವರ್‍ತಿ ತಿಸ್ ಖೊಲಿಯಾ ಹೊತ್ತಿ. <verse eid="EZK 40:17" /><verse number="18" style="v" sid="EZK 40:18" />ತ್ಯಾ ಖಾಯ್ಲ್ಯಾ ಭಾಜುಚಿ ಉಸಿಯಾ, ಮುಖ್ಯ್ ದಾರಾಂಚ್ಯಾ ಅಜುಭಾಜುಕ್ನಿ ಹಾತ್ರುನ್ ತೆಂಚ್ಯಾ ತವ್ಡಿಚ್ ರುಂದ್ ಹೊತ್ತಿ. <verse eid="EZK 40:18" /><verse number="19" style="v" sid="EZK 40:19" />ತೆನಿ ದಿಸ್ ಉಗಾವ್ಲಾ ದಿಕ್ಕಾಕ್ಬಿ ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ಖಾಯ್ಲ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ ಭುತ್ತುರ್ನಾ, ಭುತ್ತುರ್ಲ್ಯಾ ಅಂಗ್ನಾಚ್ಯಾ ಬಾರ್ಯ್ ಪತರ್ ಮಾಪ್ತಾನಾ ತೆ ಪನ್ನಾಸ್ ಹಾತ್ ಹೊತ್ತೆ.<verse eid="EZK 40:19" /></para>
  <para style="s">ಉತ್ತರ್ ದಿಕ್ಕಾಚೊ ದಡ್ಪೊ</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 40:20" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಭಾಯ್ಲ್ಯಾ ಭಾಗಾಚ್ಯಾ ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಚಿ ರುಂದಿ ಅನಿ ಲಾಂಬಿ ಮಾಪ್ಲ್ಯಾನ್. <verse eid="EZK 40:20" /><verse number="21" style="v" sid="EZK 40:21" />ತ್ಯಾತುರ್ ದೊನಿ ಭಾಜುಕ್ನಿ ತಿನ್ ಭಿತ್ತಿಚಿ ಖೊಲಿಯಾ ಹೊತ್ತಿ, ಥೈತ್ಲೆ ಖಾಂಬೆಬಿ ದಾರ್ ಮಂಟಪ್ಬಿ ಪಯ್ಲೆಚ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ ಮಾಪಾ ತವ್ಡೆಚ್ ಹೊತ್ತೆ, ತ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಚಿ ಲಾಂಬಿ ಪಂಚಿಸ್ ಹಾತ್ ಅನಿ ರುಂದಿ ಸಾಡೆ ಬಾರಾ ಹಾತ್. <verse eid="EZK 40:21" /><verse number="22" style="v" sid="EZK 40:22" />ಥೈತ್ಲಿ ಕಿಡ್ಕಿಯಾ ಅನಿ ದಾರ್ ಮಂಟಪಾಚ್ಯಾ ಚಿತ್ತರಾತ್ನಿ ಹೊತ್ತಿ ಖಜುರಾಚಿ ಝಾಡಾ ಸಗ್ಳೆ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ದಾರಾಚ್ಯಾ ಮಾಪಾ ತವ್ಡೆಚ್ ಹೊತ್ತೆ, ಸಾ ಪಯ್ರಿಯಾ ವಯ್ನಿ ಚಡುನ್ ಥೈ, ಉಸಿಚೊ ಜಾಗೊ ಭುತ್ತುರ್ ಹೊತ್ತೊ. <verse eid="EZK 40:22" /><verse number="23" style="v" sid="EZK 40:23" />ಭಾಯ್ಲ್ಯಾ ದಾರಾಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ಅನಿ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಂಚ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಕ್ನಿ ಇದ್ರಾಕ್ ಭುತ್ತುರ್ಲ್ಯಾ ಮುಖ್ಯ್ ದಾರಾ ಹೊತ್ತಿ, ಎಕ್ ದಾರಾಕ್ನಾ ಅನಿ ಎಕ್ ದಾರಾಕ್ ಪನ್ನಾಸ್ ಹಾತ್ ಮಾಪ್ಲ್ಯಾನ್.<verse eid="EZK 40:23" /></para>
  <para style="s">ದಕ್ಷಿನಾಚೊ ದಡ್ಪೊ</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 40:24" />ಮಾನಾ ತೆನಿ ಮಾಕಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್, ಥೈಬಿ ಎಕ್ ಮುಖ್ಯ್ ದಾರ್ ಹೊತ್ತೆ, ತೆನಿ ಥೈ ಹೊತ್ತ್ಯಾ ದಾರ್ ಮಂಟಪಾಚ್ಯಾ ಖಾಂಬ್ಯಾಕ್ನಿ ಅದ್ದಿ ಮಾಪಲ್ಲ್ಯಾ ಮಾಪಾನ್ ಮಾಪ್ಲ್ಯಾನ್. <verse eid="EZK 40:24" /><verse number="25" style="v" sid="EZK 40:25" />ತ್ಯಾ ತುರ್ ಅನಿ ತೆಜ್ಯಾ ದಾರ್ ಮಂಟಪಾತ್ನಿಬಿ ಸಗ್ಳ್ಯಾ ಭಾಜುಕ್ನಿಬಿ ತಸ್ಲಿಚ್ ಕಿಡ್ಕಿಯಾ ಹೊತ್ತಿ, ಮುಖ್ಯ್ ದಾರಾಚೆ ಲಾಂಬಿ ಪಂಚಿಸ್ ಹಾತ್ ಅನಿ ರುಂದಿ ಸಾಡೆ ಬಾರಾ ಹಾತ್ ಹೊತ್ತೆ. <verse eid="EZK 40:25" /><verse number="26" style="v" sid="EZK 40:26" />ಥೈ ಚಡುಕ್ ಸಾತ್ ಪಯ್ರಿಯಾ ಹೊತ್ತಿ, ದಾರ್ ಮಂಟಪಾಚ್ಯಾ ಭುತ್ತುರ್ ಹೊತ್ತೊ, ದಾರ್ ಮಂಟಪಾಚ್ಯಾ ಇದ್ರಾ ಬದ್ರಾಚ್ಯಾ ಖಾಂಬ್ಯಾತ್ನಿ ಖಜುರಾಚ್ಯಾ ಝಾಡಾಂಚಿ ಚಿತ್ರಾ ಕಾಡಲ್ಲಿ ಹೊತ್ತಿ. <verse eid="EZK 40:26" /><verse number="27" style="v" sid="EZK 40:27" />ಭುತ್ತುರ್ಲ್ಯಾ ಜಾಗ್ಯಾತ್ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ಮುಕ್ಯ್ ದಾರ್ ಹೊತ್ತೆ, ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ಎಕ್ ದಾರಾಕ್ನಾ ಅನಿ ಎಕ್ ದಾರಾಕ್ ಪನ್ನಾಸ್ ಹಾತ್ ಮಾಪ್ಲ್ಯಾನ್.<verse eid="EZK 40:27" /></para>
  <para style="s">ದಕ್ಷಿನಾಚ್ಯಾ ಭಾಗಾಚೊ ಭುತ್ತುರ್ಲೊ ಅಂಗನ್</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 40:28" />ಮಾನಾ ತೆನಿ ಮಾಕಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಚ್ಯಾ ದಾರಾಚ್ಯಾ ವಾಟೆನ್, ಭುತ್ತುರ್ಲ್ಯಾ ಭಾಗಾತ್ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್, ತೆನಿ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಚೆ ದಾರ್, ಥೈ ಹೊತ್ತಿ ಭಿತ್ತಿಯಾಂಚಿ ಖೊಲಿ, ಖಾಂಬೆ ಅನಿ ದಾರ್ ಮಂಟಪ್ ಬಿ ಮಾಪ್ತಾನಾ ಸಮಾ ಹೊವ್ನ್ ಹೊತ್ತೆ. <verse eid="EZK 40:28" /><verse number="29" style="v" sid="EZK 40:29" />ತ್ಯಾತುರ್ಬಿ ಅನಿ ತೆಜ್ಯಾ ದಾರ್ ಮಂಟಪಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಭಾಜುಕ್ ಕಿಡ್ಕಿಯಾ ಹೊತ್ತಿ, ಮುಖ್ಯ್ ದಾರಾಚೆ ಲಾಂಬಿ ಪಂಚಿಸ್ ಹಾತ್ ಅನಿ ರುಂದಿ ಸಾಡೆ ಬಾರಾ ಹಾತ್ ಹೊತ್ತೆ. <verse eid="EZK 40:29" /><verse number="30" style="v" sid="EZK 40:30" />ಭೊತ್ಯಾನ್ ದಾರ್ ಮಂಟಪ್ ಹೊತ್ತೊ, ಹರ್ ಎಕಾಚಿ ಲಾಂಬಿ ಸಾಡೆ ಬಾರಾ ಹಾತ್ ಅನಿ ರುಂದಿ ಸಾಡೆ ದೊನ್ ಹಾತ್ ಹೊತ್ತೆ. <verse eid="EZK 40:30" /><verse number="31" style="v" sid="EZK 40:31" />ತ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಚಿ ದಾರ್ ಮಂಟಪಾಚಿ ವಾಟ್ ಭಾಯ್ಲ್ಯಾ ಭಾಗಾಚ್ಯಾ ಇದ್ರಾಕ್ ಹೊತ್ತೆ, ತೆಚೆ ಖಾಂಬೆ ಖಜುರಾಚ್ಯಾ ಝಾಡಾಂಚಿ ಚಿತ್ತರಾನಿ ಸಿಂಗಾರ್ ಕರಲ್ಲೆ ಹೊತ್ತೆ, ಅನಿ ಥೈ ಚಡುಕ್ ಆಟ್ ಪಯ್ರಿಯಾ ಹೊತ್ತಿ.<verse eid="EZK 40:31" /></para>
  <para style="s">ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಾರಾಚೆ ಭುತ್ತುರ್ಲೊ ಭಾಗ್</para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 40:32" />ತೆನಿ ಮಾಕಾ ಭುತ್ತುರ್ಲ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಬಲ್ವುನ್ ಹಾನುನ್, ಥೈ ಹೊತ್ತೆ ಮುಖ್ಯ್ ದಾರ್ ಅನಿ ತೆಚಿ ಭಿತ್ತಿಯಾಂಚಿ ಖೊಲಿ, ಖಾಂಬೆ, ಅನಿ ದಾರ್ ಮಂಟಪ್ ಹೆ ಸಗ್ಳೆ ಮಾಪ್ತಾನಾ, ಅದ್ದಿ ಹೊತ್ತೆ ತವ್ಡೆಚ್ ಮಾಪ್ ಹೊತ್ತೆ. <verse eid="EZK 40:32" /><verse number="33" style="v" sid="EZK 40:33" />ತ್ಯಾತುರ್ ಅನಿ ತೆಜ್ಯಾ ದಾರ್ ಮಂಟಪಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಭಾಜುಕ್ನಿ ಕಿಡ್ಕಿಯಾ ಹೊತ್ತಿ, ತ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಚಿ ಲಾಂಬಿ ಪಂಚಿಸ್ ಹಾತ್ ಅನಿ ರುಂದಿ ಸಾಡೆ ಬಾರಾ ಹಾತ್ ಹೊತ್ತೆ. <verse eid="EZK 40:33" /><verse number="34" style="v" sid="EZK 40:34" />ತೆಜೊ ದ್ವಾರ್ ಮಂಟಪಾಚ್ಯಾ ಭುತ್ತುರ್ಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಇದ್ರಾಕ್ ಹೊತ್ತೊ, ಫಿರುನ್ ಖೆಳ್ತಲ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ಇದ್ರಾ ಬದ್ರಾಕ್ ಖಾಂಬ್ಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಖಜುರಾಚಿ ಝಾಡಾ ಚಿತ್ತರ್ ಕಾಡಲ್ಲಿ ಹೊತ್ತಿ, ಅನಿ ಥೈ ಚಡುಕ್ ಆಟ್ ಪಯ್ರಿಯಾ ಹೊತ್ತಿ.<verse eid="EZK 40:34" /></para>
  <para style="s">ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ದಡ್ಪ್ಯಾಚೊ ಭುತ್ತುರ್ಲೊ ಭಾಗ್</para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 40:35" />ತೆಜ್ಯಾ ಮಾನಾ, ತೆನಿ ಮಾಕಾ ಉತ್ತರಾಚ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ದಾರಾಕ್ಡೆ ಬಲ್ವುನ್ ಹಾನುನ್, ತೆ ಅನಿ ತೆಚಿ ಭಿತ್ತಿಯಾಂಚಿ ಖೊಲಿ, ಖಾಂಬೆ, ಅನಿ ದಾರ್ ಮಂಟಪ್ ಹೆ ಸಗ್ಳೆ ಮಾಪ್ತಾನಾ ತಿ ಎಕುಚ್ ಮಾಪಾಚ್ ಹೊತ್ತಿ. <verse eid="EZK 40:35" /><verse number="36" style="v" sid="EZK 40:36" />ತ್ಯಾತುರ್ ಸಗ್ಳ್ಯಾಕ್ಡೆ ಕಿಡ್ಕಿಯಾ ಹೊತ್ತಿ, ಅನಿ ತೆಚಿ ಲಾಂಬಿ ಪಂಚಿಸ್ ಹಾತ್, ರುಂದಿ ಸಾಡೆ ಬಾರಾ ಹಾತ್ ಹೊತ್ತೆ. <verse eid="EZK 40:36" /><verse number="37" style="v" sid="EZK 40:37" />ತೆಚೆ ಖಾಂಬೆ ಭಾಯ್ಲ್ಯಾ ಭಾಗಾಕ್ ಇದ್ರಾಕ್ ಹೊತ್ತಿ, ತ್ಯಾ ಇದ್ರಾ ಬದ್ರಾಚ್ಯಾ ಖಾಂಬ್ಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಖಜುರಾಚಿ ಝಾಡಾ ಚಿತ್ತರ್ ಕಾಡಲ್ಲಿ ಹೊತ್ತಿ, ಥೈ ಚಡುಕ್ ಆಟ್ ಪಯ್ರಿಯಾ ಹೊತ್ತಿ.<verse eid="EZK 40:37" /></para>
  <para style="s">ಉತ್ತರಾಚ್ಯಾ ದಡ್ಪ್ಯಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಹೊತ್ತಿ ಘರಾ</para>
  <para style="p">
    <verse number="38" style="v" sid="EZK 40:38" />ಪಿಡ್ಲ್ಯಾ ದಾರಾಚ್ಯಾ ಖಾಂಬ್ಯಾಂಚ್ಯಾ ಭಾಜುಕ್ ಎಕ್ ಖೊಲಿ ಅನಿ ತೆಚೆ ದಾರ್ ದಿಸ್ಲೆ, ತ್ಯಾ ಖೊಲಿಯಾತ್ನಿ ಸಗ್ಳೆ ಅಂಗ್ ಬಲಿ ಕರಲ್ಲ್ಯಾ ಜನಾವರಾಂಚೆ ಮಾಸ್ ಧುವ್ನ್ಗೆತ್ ಹೊತ್ತೆ. <verse eid="EZK 40:38" /><verse number="39" style="v" sid="EZK 40:39" />ಪಿಡ್ಲ್ಯಾ ದಾರಾಚ್ಯಾ ಭಾಜುಚ್ಯಾ ಫಿರುನ್ ಖೆಳ್ತಲ್ಯಾ ಜಾಗ್ಯಾಂಚ್ಯಾ ದೊನಿ ಭಾಜುಕ್ನಿ ದೊನ್ದೊನ್ ಮೆಜ್ ಹೊತ್ತೆ; ತೆಜ್ಯಾ ವರ್‍ತಿ ಸಗ್ಳೆ ಅಂಗ್ ಹೊಮ್ ಬಲಿ ಕರಲ್ಲಿ ಜನಾವರಾ, ಪಾಪ್ ಪರಿಹಾರ್ ಬಲಿ ಭೆಟ್ವಲ್ಲೆ ಜನಾವರ್, ಅನಿ ಪಶ್ಚಾತಾಪಾಚಿ ಬಲಿ ಭೆಟ್ವಲ್ಲೆ ಜನಾವರ್ ಹೆ ಸಗ್ಳೆ ಮಾರಿತ್. <verse eid="EZK 40:39" /><verse number="40" style="v" sid="EZK 40:40" />ಉತ್ತರಾಚ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ಫಿಡ್ಲ್ಯಾ ದಾರಾಚಿ ಗುಸ್ತಲಿ ವಾಟ್ ಹೊಲ್ಲ್ಯಾ ಪಯ್ರಿಯಾಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ತ್ಯಾ ದಾರಾಚ್ಯಾ ಫಿರುನ್ ಖೆಳ್ತಲ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ಭಾಯ್ರ್ ಎಕ್ ಆಕ್ರಿಕ್ ದೊನ್ ಮೆಜಾ, ಅನಿ ಎಕ್ ಭಾಜುಕ್ ದೊನ್ ಮ್ಹನಿಯಾ ಹೊತ್ತಿ. <verse eid="EZK 40:40" /><verse number="41" style="v" sid="EZK 40:41" />ಪಿಡ್ಲ್ಯಾ ದಾರಾಚ್ಯಾ ದೊನಿ ಬಾಜುನ್ ಹಿಕ್ಡಿನ್ ಚಾರ್ ತಿಕ್ಡಿನ್ ಚಾರ್ ಮೆಜಾ ಹೊತ್ತಿ, ಬಲಿಚಿ ಜನಾವರಾ ಭೆಟ್ವುತಲೆ ಆಟ್ ಮೆಜಾ ಹೊತ್ತಿ. <verse eid="EZK 40:41" /><verse number="42" style="v" sid="EZK 40:42" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಸಗ್ಳ್ಯಾ ಅಂಗ್ ಹೊಮ್ ಬಲಿಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ, ಕೊರದಲ್ಲ್ಯಾ ಗುಂಡ್ಯಾಂಚೆ ಚಾರ್ ಮೆಜಾ ತೆಂಚಿ ರುಂದಿ ದೆಡ್ ಹಾತಾ ವಯ್ರ್ ಎಕ್ ಹಿತ್, ಅನಿ ದೆಡ್ ಹಾತಾ ವಯ್ರ್ ಎಕ್ ಹಿತ್, ಉಂಚಿಕ್ ಅರ್ದೊ ಹಾತ್, ತೆಜ್ಯಾ ವರ್‍ತಿ ಜನಾವರಾಂಚೆ ಸಗ್ಳೆ ಅಂಗ್ ಹೊಮ್ ಬಲಿ ಕರ್ತಲಿ ಸಾಮಾನಾ ಥವಲ್ಲಿ ರಾಯ್ತ್. <verse eid="EZK 40:42" /><verse number="43" style="v" sid="EZK 40:43" />ಬುತ್ತುರ್ ಚಾರಿ ಬಾಜುನ್ ಹಾತಿಚ್ಯಾ ರುಂದಿ ತವ್ಡೆ ಅಡ್ಕಳಿಯಾ ಮಾರಲ್ಲೆ ಹೊತ್ತೆ, ಬಲಿಚೆ ಮಾಸ್ ಮೆಜಾಂಚ್ಯಾ ವರ್‍ತಿ ಥವಲ್ಲೆ ಹೊತ್ತೆ.<verse eid="EZK 40:43" /></para>
  <para style="s">ಯಾಜಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಖೊಲಿ</para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 40:44" />ತೆಜ್ಯಾ ಮಾನಾ ತೆನಿ ಮಾಕಾ ಭುತ್ತುರ್ಲ್ಯಾ ಭಾಗಾಕ್ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್, ಅಬಕ್ ಥೈ ದೊನ್ ಖೊಲಿಯಾ ದಿಸ್ಲಿ, ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ ಭಾಜುಕ್ ಎಕ್ ಖೊಲಿ, ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ತೊಂಡ್ ಕರುನ್ ಹೊತ್ತೆ. ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ಫಿಡ್ಲ್ಯಾ ದಾರಾಚ್ಯಾ ಭಾಜುಕ್ ಅನಿ ಎಕ್ ಖೊಲಿ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ತೊಂಡ್ ಕರುನ್ ಹೊತ್ತೆ. <verse eid="EZK 40:44" /><verse number="45" style="v" sid="EZK 40:45" />ಮಾನಾ ತೆನಿ ಮಾಕಾ, ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ತೊಂಡ್ ಕರುನ್ ಹೊತ್ತ್ಯಾ ತಿ ಖೊಲಿ ಗುಡಿಚಿ ಫುಜ್ಯಾ ಕರ್‍ತಲ್ಯಾ ಯಾಜಕಾಕ್ನಿ ಮನುನ್ ನೆಮ್ಸುನ್ ಥವಲ್ಲ್ಯಾ ಖೊಲಿಕ್ ನ್ಹೆವ್ನ್ ಹೊಲೆ. <verse eid="EZK 40:45" /><verse number="46" style="v" sid="EZK 40:46" />ಅನಿ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ ತೊಂಡ್ ಕರುನ್ ಹೊತ್ತ್ಯಾ ತಿ ಖೊಲಿ ಬಲಿ ಭೆಟ್ವುತಲೆ ಕಾಮ್ ಕರ್‍ತಲ್ಯಾ ಯಾಜಕಾಕ್ನಿ ನೆಮ್ಸುನ್ ಥವಲ್ಲಿ ಹಾಯ್, ಚಾದೊಕಾಚ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೆವಿಚ್ಯಾ ಕುಳಿಚಿ ಹಿ ಲೊಕಾ, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಸೆವಕಾ ಹೊವ್ನ್ ಹಾತ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="EZK 40:46" /></para>
  <para style="s">ಭುತ್ತುರ್ಲೊ ಭಾಗ್ ಅನಿ ದೆವಾಚ್ಯಾ ಗುಡಿಚೆ ಭಾಂದಾಪ್</para>
  <para style="p">
    <verse number="47" style="v" sid="EZK 40:47" />ತೆಜ್ಯಾ ಮಾನಾ ತೆನಿ ತೊ ಭುತ್ತುರ್ಲೊ ಭಾಗ್ ಮಾಪ್ ಕರುನ್ ಬಗ್ತಾನಾ, ತೆ ಪನ್ನಾಸ್ ಹಾತ್ ಲಾಂಬ್ ಅನಿ ಪನ್ನಾಸ್ ಹಾತ್ ರುಂದ್ ಹೊವ್ನ್ ಚವ್ಕ್ ಹೊತ್ತೆ, ಅನಿ ಬಲಿಚೊ ಕಟ್ಟೊ ಗುಡಿಚ್ಯಾ ಇದ್ರಾಕ್ ಹೊತ್ತೊ. <verse eid="EZK 40:47" /><verse number="48" style="v" sid="EZK 40:48" />ತನ್ನಾಚ್ ತೆನಿ ಮಾಕಾ ಗುಡಿಚ್ಯಾ ವಾಟೆ ವಯ್ಲ್ಯಾ ದಾರ್ ಮಂಟಪಾಕ್ ಬಲ್ವುನ್ ಹಾನುನ್, ತೆ ಮಾಪುಕ್ ತೆಜ್ಯಾ ಇದ್ರಾ ಬದ್ರಾಚ್ಯಾ ಖಾಂಬ್ಯಾಂಚಿ ಸಾಡೆ ದೊನ್ ಹಾತ್ ಅನಿ ದಾರಾಚ್ಯಾ ದೊನಿ ಭಾಜುವಾಂಚಿ ದೆಡ್ ಹಾತ್ ಹೊತ್ತೆ. <verse eid="EZK 40:48" /><verse number="49" style="v" sid="EZK 40:49" />ದಾರ್ ಮಂಟಪಾಚಿ ಲಾಂಬಿ ಧಾ ಹಾತ್ ಅನಿ, ರುಂದಿ ಸಾ ಹಾತ್ ಹೊತ್ತೆ, ಅನಿ ಇಸ್ ಪಾಯ್ರಿಯಾ ಚಡುನ್ ಥೈ ಪಾವಿತ್, ದೊನೆ ಭಾಜುಕ್ಲ್ಯಾ ಖಾಂಬ್ಯಾಂಚ್ಯಾ ಭಾಜುಕ್ ಎಕ್ ಎಕ್ ಖಾಂಬ್ಯಾ ವಯ್ರ್ ಅನಿ ಎಕ್ ಖಾಂಬೆ ಆಧಾರ್ ಹೊವ್ನ್ ಹೊತ್ತೆ.<verse eid="EZK 40:49" /></para>
  <chapter eid="EZK 40" />
  <chapter number="41" style="c" sid="EZK 41" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 41:1" />ಮಾನಾ ತ್ಯಾ ಘೊ ಮಾನ್ಸಾನ್ ಮಾಕಾ ಪವಿತ್ರ್ ಜಾಗ್ಯಾಕ್ ಹಾನುನ್, ತೆಚ್ಯಾ ದಾರಾಚ್ಯಾ ಖಾಂಬ್ಯಾಚೆ ಮಾಪುಕ್ ಲಾವ್ನ್ ತೆಚ್ಯಾ ದೊನಾಕ್ಡೆಬಿ ತಿ ತಿನ್ ಹಾತ್ ಲಾಂಬಿ, ಅನಿ ರುಂದ್ ಪಾಂಚ್ ಹಾತ್ ಹೊತ್ತೆ. <verse eid="EZK 41:1" /><verse number="2" style="v" sid="EZK 41:2" />ದಾರಾಚೆ ರುಂದಿ ಪಾಂಚ್ ಹಾತ್, ದಾರಾಚ್ಯಾ ದೊನಿಕ್ಲಿ ಭಿತ್ತಿಯಾಂಚಿ ರುಂದಿ ಸಾಡೆ ದೊನ್ ಹಾತ್ ಹೊವ್ನ್ ಹೊತ್ತೆ. ತೊ ತ್ಯಾ ಪವಿತ್ರ್ ಜಾಗ್ಯಾಕ್ ಮಾಪ್ತಾನಾ ತೆಂಚೆ ಲಾಂಬಿ ಇಸ್ ಹಾತ್, ರುಂದಿಕ್ ಧಾ ಹಾತ್ ಹೊವ್ನ್ ಹೊತ್ತೆ. <verse eid="EZK 41:2" /><verse number="3" style="v" sid="EZK 41:3" />ಮಾನಾ ತ್ಯಾ ಘೊ ಮಾನ್ಸಾನ್ ತನಿ ಫಿಡೆ ಜಾವ್ನ್ ಪವಿತ್ರ್ ಜಾಗ್ಯಾಚ್ಯಾ ಆಕ್ರಿಕ್ ಗರ್ಬ್ಗುಡಿ ಮಾಪುಕ್ ದಾರಾಚೆ ಎಕೆಕ್ ಖಾಂಬ್ಯಾಂಚಿ ರುಂದಿಕ್ ಎಕ್ ಹಾತ್, ಅನಿ ದಾರಾಚೆ ರುಂದಿ ತಿನ್ ಹಾತ್. ದಾರಾಚ್ಯಾ ಭಾಜುಕ್ಲ್ಯಾ ಭಿತ್ತಿಂಚಿ ರುಂದಿಕ್ ಸಾಡೆ ತಿನ್ ಹಾತ್. <verse eid="EZK 41:3" /><verse number="4" style="v" sid="EZK 41:4" />ಅನಿ ಗರ್ಬ್ ಗುಡಿಚೆ ಲಾಂಬಿ ಧಾ ಹಾತ್, ರುಂದಿ ಧಾ ಹಾತ್ ಹೊತ್ತಿ. ತನ್ನಾ ತೆನಿ ಮಾಕಾ ಹೆ ಪವಿತ್ರ್ ಜಾಗೊ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="EZK 41:4" /></para>
  <para style="s">ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತಿ ಖೊಲಿಯಾ</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 41:5" />ಮಾನಾ ತ್ಯಾ ಮಾನ್ಸಾನ್, ಮಾಪುಕ್ ದೆವಾಚ್ಯಾ ಗುಡಿಚಿ ಭಿತ್ತಿಚೆ ರುಂದಿಕ್ ತಿನ್ ಹಾತ್, ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಭೊತ್ಯಾನಿ ಸಗ್ಳೆ ತೆಚ್ಯಾ ಭೊತ್ಯಾನಿ ಲಾಗುನ್ ಹೊತ್ತ್ಯಾ ಖೊಲಿಯಾಂಚಿ ರುಂದಿಕ್ ದೊನ್ ಹಾತ್ ಹೊತ್ತಿ. <verse eid="EZK 41:5" /><verse number="6" style="v" sid="EZK 41:6" />ತಿ ಖೊಲಿಯಾ ಎಕಾಚ್ಯಾ ವರ್‍ತಿ ಎಕ್ ತಿನ್ ಮ್ಹಾಳ್ಗಿಯಾ ಹೊತ್ತಿ. ಎಕೆಕ್ ಮ್ಹಾಳ್ಗಿತ್ ತಿಸ್ ತಿಸ್ ಖೊಲಿಯಾ ಹೊತ್ತಿ, ದೆವಾಚಿ ಗುಡಿ ಪಯ್ರಿಯಾನಿ ಭಾಂದಲ್ಲೆ ಹೊತ್ತೆ, ಭಿತ್ತಿಯಾಕ್ನಿ ಡೊಬ್ರೊ ನಸ್ತಾನಾ ತಿಚ್ ಪಯ್ರಿಯಾಚ್ ಭಾಜುಕ್ಲ್ಯಾ ಖೊಲಿಯಾಂಕ್ನಿ ತೊಳಾಕ್ನಿ ಪಯ್ರಿಯಾ ಆಧಾರ್ ಹೊವ್ನ್ ಹೊತ್ತಿ. ಹೊಲ್ಯಾರ್ ಘರಾಚ್ಯಾ ಭಿತ್ತಿಯಾಕ್ನಿಆಧಾರ್ ನತ್ತೊ. <verse eid="EZK 41:6" /><verse number="7" style="v" sid="EZK 41:7" />ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ಮ್ಹಾಳ್ಗಿಚ್ಯಾ ವರ್‍ತಿ ಗೆಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತ್ಯಾ ತ್ಯಾ ಖೊಲಿಯಾಂಚೆ ರುಂದಿ ಲೈ ಹೊವ್ನನ್ಗೆತ್ ಯೆಲೆ, ತಿ ದೆವಾಚ್ಯಾ ಗುಡಿಕ್ ಲಪ್ಟುನ್ ಘೆವ್ನ್ ವರ್‍ತಿ-ವರ್‍ತಿ ಗೆಲ್ಯಾ ಸಾರ್ಕೆ ತೆಕಾ ಬಿಗ್ದುನ್ ಅಪ್ಪ್ ಮಾರುನ್ಗೆವ್ನ್ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆ ಹೊತ್ತಿ, ಅಸಿ ವಯ್ಲ್ಯಾ ವಯ್ಲಿ ಮ್ಹಾಳ್ಗಿ ದೆವಾಚ್ಯಾ ಗುಡಿಕ್ ಲಾಗುನ್ ರುಂದ್ ಹೊವ್ನಗೆತ್ ಯೆಲಿ. ಖಾಯ್ಲ್ಯಾ ಮ್ಹಾಳ್ಗಿಕ್ನಾ ಮದ್ಲ್ಯಾ ಮ್ಹಾಳ್ಗಿಚ್ಯಾ ವಾಟೆನ್ ವಯ್ಲ್ಯಾ ಮ್ಹಾಳ್ಗಿಚ್ಯಾ ಚಡಿತ್ ಹೊತ್ತಿ. <verse eid="EZK 41:7" /><verse number="8" style="v" sid="EZK 41:8" />ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಭೊತ್ಯಾನಿ ಎಕ್ ಜಗ್ಲಿ ದಿಸ್ಲಿ, ತೆ ಖೊಲಿಯಾಕ್ನಿ ಪಾಂಯಾ ಹೊವ್ನ್ ಜಿಮ್ನಿಕ್ನಾ ಸುಮಾರ್ ಸಾ ಹಾತ್ ಮಾಪ್ತಲ್ಯಾ ಖಾಟಿಚ್ಯಾ ಯೆವ್ಡೆ ಉಪ್ಪರ್ ಹೊತ್ತೆ. <verse eid="EZK 41:8" /><verse number="9" style="v" sid="EZK 41:9" />ಖೊಲಿಯಾಂಚ್ಯಾ ಭಾಯ್ಲ್ಯಾ ಭಿತ್ತಿಚೆ ದಾಟ್ ಸಾಡೆ ದೊನ್ ಹಾತ್ ಮಾಪಿಕ್ ಹೊತ್ತೆ. <verse eid="EZK 41:9" /><verse number="10" style="v" sid="EZK 41:10" />ದೆವಾಚ್ಯಾ ಗುಡಿಕ್ ಅಂಟುನ್ ಹೊತ್ತ್ಯಾ ಖೊಲಿಯಾಕ್ನಿ ಮೊಟ್ಯಾ ಯಾಜಕಾಂಚ್ಯಾ ಖೊಲಿಯಾಕ್ಬಿ ಮದ್ದಿ ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಭೊತ್ಯಾನಿ ಧಾ ಹಾತ್ ಲಾಂಬಿನ್ ಧುರ್ ಹೊತ್ತೆ. <verse eid="EZK 41:10" /><verse number="11" style="v" sid="EZK 41:11" />ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಖೊಲಿಯಾಂಚ್ಯಾ ಭುತ್ತುರ್ ಜಾತಲಿ ದೊನ್ ದಾರಾ ಹೊತ್ತಿ, ತಿ ದಾರಾ ಉತ್ತರಾಕ್ ಅನಿ ದಕ್ಷಿನಾಕ್ ಎಕೆಕ್ ಹೊತ್ತಿ, ತಿ ಜಗ್ಲಿ ಹೊತ್ತ್ಯಾಕ್ಡೆ ಹೊತ್ತಿ; ತಿ ಜಗ್ಲಿ ಸಗ್ಳ್ಯಾಕ್ಡೆ ಸಾಡೆ ದೊನ್ ಹಾತ್ ರುಂದ್ ಹೊತ್ತೆ.<verse eid="EZK 41:11" /></para>
  <para style="s">ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ರಾತಲಿ ಖೊಲಿಯಾ</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 41:12" />ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ಅಂಗ್ನಾಚ್ಯಾ ಪಾಟ್ಲ್ಯಾ ಶಾಲೆಚೆ ರುಂದಿಕ್ ತಿಸಾರ್ ಪಾಂಚ್ ಹಾತ್ ಹೊತ್ತಿ, ಲಾಂಬಿಕ್ ಚಾಳಿಸಾರ್ ಪಾಂಚ್ ಹಾತ್ ಹೊತ್ತಿ ತೆಚ್ಯಾ ಭಿತ್ತಿಚೆ ದಾಟ್ ಸಾಡೆ ದೊನ್ ಹಾತ್.<verse eid="EZK 41:12" /></para>
  <para style="s">ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಭಾಂದ್ಪಾಚೆ ಪುರಾ ಮಾಪ್</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 41:13" />ತ್ಯಾ ಘವ್ಮಾನ್ಸಾನ್ ಮಾಪಲ್ಲ್ಯಾ ತನ್ನಾ ದೆವಾಚ್ಯಾ ಗುಡಿಚಿ ಲಾಂಬಿ ಪನ್ನಾಸ್ ಹಾತ್, ಶಾಲೆಚಿ ಭಿತ್ತಿಯಾ, ಹೆಂಚೆ ಸಗ್ಳೆ ಒಟ್ಟು ರುಂದಿಕ್ ಪನ್ನಾಸ್ ಹಾತ್ ಹೊತ್ತಿ. <verse eid="EZK 41:13" /><verse number="14" style="v" sid="EZK 41:14" />ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ದೆವಾಚ್ಯಾ ಗುಡಿಚೆ ತೊಂಡ್ ಖಾಲಿ ಭಾಗಾಕ್, ಹೆಂಚೆ ಗೊಳಾ ರುಂದಿಕ್ ಪನ್ನಾಸ್ ಹಾತ್ ಹೊತ್ತಿ. <verse eid="EZK 41:14" /><verse number="15" style="v" sid="EZK 41:15" />ತೆನಿ ಖಾಲಿ ಭಾಗಾಕ್ ಪಾಟ್ಲ್ಯಾ ಶಾಲೆಕ್ ತ್ಯಾ ಅಂಗ್ನಾಚ್ಯಾ ಆಕ್ರಿಕ್ ಮಾಪ್ತಾನಾ ತೆಚೆ ಲಾಂಬಿ ದೊನ್ ಭಾಜುಕ್ಲ್ಯಾ ಭಿತ್ತಿಕ್ ಪನ್ನಾಸ್ ಹಾತ್ ಹೊತ್ತೆ.<verse eid="EZK 41:15" /></para>
  <para style="s">ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಭಾಂದ್ಪಾಚೆ ಸಗ್ಳೆ ವಿವರನ್</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 41:16" />ತೆಚ್ಯಾ ದಾರಾಚೆ ಖಾಂಬ್ಯಾಕ್ನಿ ಆಡ್ಕಳ್ ಹೊತ್ತ್ಯಾ ಕಿಡ್ಕಿಯಾಕ್ನಿ ಅನಿ ತೆಚ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ತಿನ್ ಮ್ಹಾಳ್ಗಿಯಾಂಚ್ಯಾ ದಾರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಭಾಂದಲ್ಲ್ಯಾ ಭಿತ್ತಿಯಾಕ್ನಿ ಮಾಪ್ಲ್ಯಾನ್. <verse eid="EZK 41:16" /><verse number="17" style="v" sid="EZK 41:17" />ಜಿಮ್ನಿಕ್ನಾ ಕಿಡ್ಕಿಯಾಂಚ್ಯಾ ಪತರ್, ದಾರಾಚ್ಯಾ ವರ್‍ತಿ ಅನಿ ಗರಬ್ ಗುಡಿಚ್ಯಾ ವರ್‍ತಿಬಿ, ಹಿಕುಲ್ಲ್ಯಾ ಘರಾಚ್ಯಾ ಭಿತ್ತಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಸಗ್ಳೆ ಭೊತ್ಯಾನಿ ಫಳಿಯಾ ಚವ್ಕ್ ಕರುನ್ ಧಾಪಲ್ಲಿ ಹೊತ್ತಿ, ಅನಿ ಕಿಕ್ಡಿಯಾಕ್ನಿ ಧಾಪಲ್ಲೆ ಹೊತ್ತೆ. <verse eid="EZK 41:17" /><verse number="18" style="v" sid="EZK 41:18" />ಭಿತ್ತಿಯಾಂಚ್ಯಾ ಚವ್ಕಾತ್ನಿ ಕೆರುಬಿಚೆ ಅನಿ ಖಜುರ್ ಝಾಡಾಚೆ ಚಿತ್ತಾರ್ ಕಾಡಲ್ಲೆ ಹೊತ್ತೆ, ದೊನ್ದೊನ್ ಕೆರುಬಿಯಾಂಚ್ಯಾ ಮದ್ದಿ ಎಕೆಕ್ ಖಜುರಾಚೆ ಝಾಡ್; ಅನಿ ಎಕೆಕ್ ಕೆರುಬಿಕ್ ದೊನ್ ದೊನ್ ತೊಂಡಾ ಹೊತ್ತಿ. <verse eid="EZK 41:18" /><verse number="19" style="v" sid="EZK 41:19" />ಖಜುರಾಚ್ಯಾ ಝಾಡಾಚೊ ಎಕ್ ಭಾಗ್ ಮಾನ್ಸಾಚ್ಯಾ ತೊಂಡಾಚ್ಯಾ ಇದ್ರಾಕ್, ಅನಿ ಎಕ್ ಭಾಗ್ ಸಿಂವಾಚ್ಯಾ ತೊಂಡಾಕ್ ಇದ್ರಾಕ್ ಹೊತ್ತೆ. ಅಸಿ ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಭುತ್ತುರ್ಲೊ ಭಾಗ್ ಸಗ್ಳೊ ಅನಿ ಸಗ್ಳ್ಯಾ ಭೊತ್ಯಾನಿ ಚಿತ್ತರಾನ್ ಭರಲ್ಲೆ ಹೊತ್ತೆ. <verse eid="EZK 41:19" /><verse number="20" style="v" sid="EZK 41:20" />ಜಿಮ್ನಿಕ್ನಾ ದಾರಾಚ್ಯಾ ವರ್‍ತಿ ಪತರ್ ಕೆರುಬಿಯಾಂಚೆ ಅನಿ ಖಜುರಾಚ್ಯಾ ಝಾಡಾಂಚಿ ಚಿತ್ತಾರಾ ಹೊತ್ತಿ.<verse eid="EZK 41:20" /></para>
  <para style="s">ನಾಕ್ಡಾಚಿ ಅಲ್ತಾರ್</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 41:21" />ಪವಿತ್ರ್ ಜಾಗ್ಯಾಚ್ಯಾ ಅನಿ ಎಕ್ ಕಡೆ ಹೊತ್ತೆ ಭಿತ್ತಿಚೆ ದಾರಾಚೆ ಚವ್ಕಟ್ಟ್ ಚವ್ಕ್ ಹೊತ್ತೆ, ಅನಿ ಪವಿತ್ರ್ ಜಾಗ್ಯಾಚ್ಯಾ ಅತ್ತ್ಯಾಚ್ಯಾ ಭಿತ್ತಿಚೆ ಚವ್ಕಟ್ಟ್ ತಸೆಚ್ ಹೊತ್ತೆ. <verse eid="EZK 41:21" /><verse number="22" style="v" sid="EZK 41:22" />ಥೈ ಝಾಡಾಚೆ ಎಕ್ ಮೆಜ್ ಹೊತ್ತೆ, ತೆಚೆ ಉಪ್ಪರ್ ಎಕ್ಬಿ ಅರ್ದೆ ಹಾತ್, ಲಾಂಬಿಕ್ ಎಕ್ ಹಾತ್ ಹೊತ್ತೆ, ತೆಚೆ ಮುಲ್ಲೆ, ಮೆಜ್, ಭಾಜು ಝಾಡಾಚೆಚ್ ಹೊಲ್ಲೆ ಹೊತ್ತೆ. ತ್ಯಾ ಮಾನ್ಸಾನ್ ಮಾಕಾ, ಹೆ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ಲಿ ಮೆಜ್, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="EZK 41:22" /></para>
  <para style="s">ದಾರಾ</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 41:23" />ಪವಿತ್ರ್ ಜಾಗ್ಯಾಕ್ ಅನಿ ಮುಖ್ಯ್ ಪವಿತ್ರ್ ಜಾಗ್ಯಾಕ್ ದೊನ್ ದೊನ್ ದಾರಾ ಹೊತ್ತಿ. <verse eid="EZK 41:23" /><verse number="24" style="v" sid="EZK 41:24" />ಎಕೆಕ್ ದಾರಾಕ್ ದೊನ್ದೊನ್ ಮಡಚ್ತಲಿ ದಾರಾ ಹೊತ್ತಿ. ಹಿಕುಲ್ಯಾ ದಾರಾಕ್ ದೊನ್ ಭಾಗ್, ತಿಕುಲ್ಯಾ ದಾರಾಕ್ ದೊನ್ ಭಾಗಾ ಹೊತ್ತಿ. <verse eid="EZK 41:24" /><verse number="25" style="v" sid="EZK 41:25" />ತ್ಯಾ ದಾರಾತ್ನಿ, ಮಟ್ಲ್ಯಾರ್, ಪವಿತ್ರ್ ಜಾಗ್ಯಾ ವಯ್ಲ್ಯಾ ದಾರಾತ್ನಿ ಕೆರುಬಿಯಾ ಅನಿ ಖಜುರಾಚಿ ಝಾಡಾ ಚಿತ್ತಾರ್ ಭಿತ್ತಿಯಾರ್ನಿ ಚಿತ್ತಾರ್ ಕಾಡಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಹೊತ್ತಿ. ದಾರ್ ಮಾಟ್ವಾಚ್ಯಾ ಭಾಯ್ರ್ ನಾಕ್ಡಾಚಿ ಫಳಿಯಾ ಹೊತ್ತಿ. <verse eid="EZK 41:25" /><verse number="26" style="v" sid="EZK 41:26" />ದಾರಾತ್ ಹೊತ್ತ್ಯಾ ಮಾಟ್ವಾಚ್ಯಾ ಭಾಜುಕ್ಲ್ಯಾ ಭಿತ್ತಿಯಾತ್ನಿ ಉಗ್ಡುಕ್ ಹೊಯ್ ನತ್ತಿ ಕಿಡ್ಕಿಯಾ ಹೊತ್ತಿ. ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಖಜುರಾಚಿ ಝಾಡಾ ಚಿತ್ತಾರ್ ಕಾಡಲ್ಲೆ ಹೊತ್ತೆ. ಖೊಲಿಯಾಂಚ್ಯಾ ಭಾಜುಕ್ ವರ್‍ತಿ ಥಾಟ್ ಹೊತ್ತೆ.<verse eid="EZK 41:26" /></para>
  <chapter eid="EZK 41" />
  <chapter number="42" style="c" sid="EZK 42" />
  <para style="s">ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ಹೊತ್ತಿ ದೊನ್ ಭಾಂದ್ಪಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 42:1" />ಮಾನಾ ತೊ ಮಾಕಾ ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ವಾಟೆನ್ ಬಾರ್ಯ್ ಹೊತ್ತ್ಯಾ ಜಾಗ್ಯಾಕ್ ಯೆವ್ಕ್ ಸಾಂಗುನ್ ಖಾಲಿ ಭಾಗಾತ್, ಹೊತ್ತ್ಯಾ ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ಭಾಂದ್ಪಾಚ್ಯಾ ಫಿಡೆ ಹೊತ್ತ್ಯಾ ಮದ್ಲ್ಯಾ ಖೊಲಿತ್ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್. <verse eid="EZK 42:1" /><verse number="2" style="v" sid="EZK 42:2" />ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ ಹೊತ್ತ್ಯಾ ದಾರಾಚ್ಯಾ ಖೊಲಿಚ್ಯಾ ಸಾಲಾಚ್ಯಾ ಇದ್ರಾಕ್ ನೆವ್ನ್ ಇಬೆ ಕರ್ಲ್ಯಾನ್, ತ್ಯಾ ಸಾಲಿಚಿ ಲಾಂಬಿ ಪನ್ನಾಸ್ ಹಾತ್ ಅನಿ ವಿಸಾರ್ ಪಾಂಚ್ ಹಾತ್ ರುಂದಿ. <verse eid="EZK 42:2" /><verse number="3" style="v" sid="EZK 42:3" />ಭುತ್ತುರ್ಲೆ ಭಾಗಾಕ್ ಧಾ ಹಾತ್ ರುಂದ್, ಜಾಗ್ಯಾಚ್ಯಾ ಫಿಡೆ ಅನಿ ಭಾರ್ಯ್ಲ್ಯಾ ಅಂಗ್ನಾಚ್ಯಾ ಜಿಮ್ನಿಚೊ ತೊ ಜಾಗೊ, ಅನಿ ಥೈತ್ಲಿ ದೊನ್ ಸಾಲಾ ತಿನ್ವೆಚ್ಯಾ ಮಾಳ್ಗಿಚ್ಯಾ ತುದಿಚಿ ಉಸಿಯಾ ಎಕೆಕಾಕ್ ಎಕ್ ಇದ್ರಾ ಬದ್ರಾಕ್ ಹೊತ್ತೆ. <verse eid="EZK 42:3" /><verse number="4" style="v" sid="EZK 42:4" />ತ್ಯಾ ಸಾಲಾಚ್ಯಾ ಮದ್ದಿ ಪನ್ನಾಸ್ ಹಾತ್ ಲಾಂಬಿ, ಪಾಂಚ್ ಹಾತ್ ರುಂದಿಕ್ ಎಕ್ ಫಿರುನ್ ಖೆಳ್ತಲಿ ವಾಟ್ ಹೊತ್ತಿ. ಖೊಲಿಯಾಂಚಿ ದಾರಾ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ ಹೊತ್ತಿ. <verse eid="EZK 42:4" /><verse number="5" style="v" sid="EZK 42:5" />ವಯ್ಲಿ ಖೊಲಿಯಾ ಮದ್ಲಿ ಅನಿ ಖಾಯ್ಲಿ ಖೊಲಿಯಾಂಚ್ಯಾಕಿಂತಾ ಬಾರಿಕ್ ಹೊತ್ತಿ. <verse eid="EZK 42:5" /><verse number="6" style="v" sid="EZK 42:6" />ತಿ ಖೊಲಿಯಾ ತಿನ್ ಮ್ಹಾಳ್ಗಿಚಿ ಹೊವ್ನ್ ಹೊತ್ತಿ; ಬಾರ್ಯ್ ಹೊತ್ತ್ಯಾ ಅಂಗ್ನಾತ್ಲ್ಯಾ ಖೊಲಿಯಾಕ್ನಿ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆ ಹ್ಯಾ ಖೊಲಿಯಾಕ್ನಿ ಖಾಲಿ ಭಾಗ್ ನತ್ತೆ; ತೆಚ್ಯಾ ವಯ್ನಾ ಜಿಮ್ನಿಕ್ನಾ ವರ್‍ತಿ ಹೊತ್ತಿ ಖೊಲಿಯಾ ಖಾಯ್ಲ್ಯಾ ಅನಿ ಮದ್ಲ್ಯಾ ಖೊಲಿಯಾನ್ಕಿ ಬಾರಿಕ್ ಹೊವ್ನ್ ಹೊತ್ತಿ. <verse eid="EZK 42:6" /><verse number="7" style="v" sid="EZK 42:7" />ಭಾಯ್ಲ್ಯಾ ಅಂಗ್ನಾಕ್ಡೆ ಹೊತ್ತ್ಯಾ ಖೊಲಿಯಾಂಚ್ಯಾ ಸಾಲಾಕ್ನಿ ಸಮಾ ಹೊವ್ನ್ ಭಾಯ್ಲಿ ಎಕ್ ಭಿತ್ತ್ ಹೊತ್ತಿ, ತೆ ಪಂಚಿಸ್ ಹಾತ್ ಲಾಂಬಿನ್ ದೊನ್ವೆಚ್ಯಾ ಸಾಲಾಚ್ಯಾ ಇದ್ರಾಕ್ ಹೊತ್ತಿ. <verse eid="EZK 42:7" /><verse number="8" style="v" sid="EZK 42:8" />ಭಾಯ್ಲ್ಯಾ ಅಂಗ್ನಾಕ್ಡೆ ಹೊತ್ತ್ಯಾ ಖೊಲಿಯಾಂಚ್ಯಾ ಸಾಲಾಂಚಿ ಲಾಂಬಿ ಪಂಚಿಸ್ ಹಾತ್, ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾಕ್ಡೆ ಹೊತ್ತ್ಯಾ ಖೊಲಿಯಾಂಚ್ಯಾ ಸಾಲಾಂಚಿ ಲಾಂಬಿ ಪನ್ನಾಸ್ ಹಾತ್. <verse eid="EZK 42:8" /><verse number="9" style="v" sid="EZK 42:9" />ಖಾಯ್ಲ್ಯಾ ಖೊಲಿಯಾಕ್ನಿ ಜಾವ್ಕ್ ಅಂಗ್ನಾಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಎಕ್ ವಾಟ್ ಹೊತ್ತಿ. <verse eid="EZK 42:9" /><verse number="10" style="v" sid="EZK 42:10" />ಅಸಿ ರ್‍ಹಾತಾನಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ಡೆ ಖಾಲಿ ಹೊತ್ತ್ಯಾ ಭಾಗಾಕ್ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ಭಿತ್ತಿಚ್ಯಾ ಮದ್ದಿ ಖೊಲಿಯಾ ಹೊತ್ತಿ. <verse eid="EZK 42:10" /><verse number="11" style="v" sid="EZK 42:11" />ತೆಂಚ್ಯಾ ಇದ್ರಾಕ್ ಎಕ್ ಒನಿ ಹೊತ್ತಿ ತಿ ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ಖೊಲಿಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ದಿಸಿತ್. ಹೆಂಚಿ ರುಂದ್ ಅನಿ ಲಾಂಬಿ ಅನಿ ತೆಂಚೆ ರುಂದ್ ಅನಿ ಲಾಂಬಿ ಎಕುಚ್ ನಮುನಿ ಹೊತ್ತೆ. <verse eid="EZK 42:11" /><verse number="12" style="v" sid="EZK 42:12" />ಖೊಲಿಯಾಚೆ ಅಂಗಾನ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಮಿಳ್ತಲ್ಯಾಕ್ಡೆ, ಭಿತ್ತಿಚ್ಯಾ ಬಾಜುಕ್ ಹೊತ್ತ್ಯಾ ವಾಟೆಚ್ಯಾ ಆಕ್ರಿಕ್ ಎಕ್ ದಾರ್ ಹೊತ್ತೆ. <verse eid="EZK 42:12" /><verse number="13" style="v" sid="EZK 42:13" />ತನ್ನಾ ಮಾಕಾ ತಯಾರ್ ಕರಲ್ಯಾ ಅಂಗ್ನಾಚ್ಯಾ ಉತ್ತರ್ ದಕ್ಷಿನಾಕ್ಡೆ ಹೊತ್ತಿ ಖೊಲಿಯಾ ನಿತಳ್ ಹೊಲಿ; ಥೈ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ಲಿ ಸೆವಕಾ ಹೊಲ್ಲ್ಯಾ ಯಾಜಕಾ ಮುಖ್ಯ್ ಪವಿತ್ರ್ ವಸ್ತಾ ಖಾತಾತ್, ಅನಿ ದಾನ್ಯಾಚಿ ಬಲಿಯಾ, ಪಾಪಾ ಮಾಪಿ ಕರ್ತಲಿ, ಬಲಿಚೆ ತೆಲ್, ಪಚ್ಚಾತಾಪಾಚಿ ಬಲಿಯಾಂಚೆ ತೆಲ್ ಮನ್ತಲೆ ಮುಖ್ಯ್ ಪರಿಶುದ್ದ್ ವಸ್ತಾ ತ್ಯಾತುರ್ ಥವ್ತಾತ್. ತೊ ಪವಿತ್ರ್ ಹೊಲ್ಲೊ ಜಾಗೊ. <verse eid="EZK 42:13" /><verse number="14" style="v" sid="EZK 42:14" />ಯಾಜಕಾ ಪವಿತ್ರ್ ಭಾಗಾಕ್ ಗೆಲ್ಲ್ಯಾ ತನ್ನಾ, ಥೈನಾ ಸೊಡುನ್ ಭಾಯ್ಲ್ಯಾ ಭಾಗಾಕ್ ಜಾವ್ಚೆ ನ್ಹಯ್, ಅಪ್ನಾಚಿ ದಿಕ್ಷಾ ಕಪ್ಡೆ ಥೈಚ್ ಕಾಡುನ್ ಥವಲ್ಲೆ ರ್‍ಹಾವ್ಚೆ, ತಿ ಪರಿಶುದ್ದ್ ಹೊಲ್ಲಿ. ಮಾನಾ ದುಸ್ರಿ ಕಪ್ಡೆ ನೆಸುನ್ ಘೆವ್ನ್ ಹುರಲ್ಲ್ಯಾ ಲೊಕಾಚ್ಯಾಕ್ಡೆ ಯೆವ್ಚೆ, ಮಟ್ಲ್ಯಾನ್.<verse eid="EZK 42:14" /></para>
  <para style="s">ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಜಾಗ್ಯಾಚಿ ಮಾಪ್</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 42:15" />ತಿ ಘವ್ಮಾನ್ಸಾ ಭುತ್ತುರ್ಲಿ ಗುಡಿ ಮಾಪಲ್ಲ್ಯಾ ಮಾನಾ ಮಾಕಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ಇದ್ರಾಕ್ಲ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ ವಾಟೆನ್ ಬಾರ್ಯ್ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಎವ್ನ್, ಗುಡಿಚ್ಯಾ ಭೊತ್ಯಾನಿ ಮಾಪ್ ಕರ್ಲ್ಯಾನ್. <verse eid="EZK 42:15" /><verse number="16" style="v" sid="EZK 42:16" />ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ಲಾಂಬಿಕ್ ಮಾಪ್ ಕರ್‍ತಲ್ಯಾ ಖಾಟಿನ್ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್ ಮಾಪ್ಲ್ಯಾನ್. <verse eid="EZK 42:16" /><verse number="17" style="v" sid="EZK 42:17" />ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ಲಾಂಬಿಕ್ ಮಾಪಿಚ್ಯಾ ಖಾಟಿನ್ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್ ಮಾಪ್ಲ್ಯಾನ್. <verse eid="EZK 42:17" /><verse number="18" style="v" sid="EZK 42:18" />ದಕ್ಷಿನ್ ದಿಕ್ಕಾಚ್ಯಾ ಲಾಂಬಿಕ್ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್ ಮಾಪ್ಲ್ಯಾನ್. <verse eid="EZK 42:18" /><verse number="19" style="v" sid="EZK 42:19" />ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ಭಿತ್ತಿಕ್ಡೆ ಪರ್‍ತುನ್ ಘೆವ್ನ್, ಮಾಪ್ ಕರ್‍ತಲ್ಯಾ ಖಾಟಿನ್ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್ ಮಾಪ್ಲ್ಯಾನ್. <verse eid="EZK 42:19" /><verse number="20" style="v" sid="EZK 42:20" />ಗುಡಿಚ್ಯಾ ಚಾರಿ ಕನ್ನಾಬಿ ಮಾಪ್ಲ್ಯಾನ್. ಪವಿತ್ರ್ ಹೊಲ್ಲ್ಯಾ ಅನಿ ಅಪವಿತ್ರ್ ಹೊಲ್ಲ್ಯಾ ಜಾಗೊ ಎಗ್ಳುಕ್ ಮನುನ್ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್ ಲಾಂಬಿಕ್ ಅನಿ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್ ರುಂದ್ ಹೊವ್ನ್ ಭಿತ್ತ್ ಹೊತ್ತಿ.<verse eid="EZK 42:20" /></para>
  <chapter eid="EZK 42" />
  <chapter number="43" style="c" sid="EZK 43" />
  <para style="s">ಸರ್ವೆಸ್ಪರಾಚಿ ಮಹಿಮಾ ಗುಡಿಕ್ ಪರ್‍ತುನ್ ಎತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 43:1" />ಮಾನಾ ತೊ ಘವ್ಮಾನ್ಸಾನ್ ದಿಸ್ ಉಗವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ದಾರಾಕ್ಡೆ ಬಲ್ವುನ್ ಹಾಲ್ಲ್ಯಾನ್. <verse eid="EZK 43:1" /><verse number="2" style="v" sid="EZK 43:2" />ತನ್ನಾ ಅಬಕ್, ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ದೆವಾಚಿ ಮಹಿಮಾ ದಿಸ್, ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ವಾಟೆನ್ ಯೆಲೊ, ತೆಂಚೊ ಆವಾಜ್ ಪಾನಿಯಾಚ್ಯಾ ಹಂವಾರ್ಯಾಂಚ್ಯಾ ಸಾರ್ಕೊ ಧನ್ ಸಾರ್ಕೆ ಹೊತ್ತೆ. <verse eid="EZK 43:2" /><verse number="3" style="v" sid="EZK 43:3" />ಮಿಯಾ ಬಗಟಲ್ಲ್ಯಾ ದರ್ಶನಾತ್, ಮಿಯಾ ಶಾರ್ ನಾಶ್ ಕರುಕ್ ಎಲ್ಲ್ಯಾ ತನ್ನಾ, ಕಸ್ಲೆ ಬಗಟಲ್ಲೊ ನ್ಹಯ್ ತಸ್ಲೆಚ್ ಬಗಟ್ಲೊ, ಕೆಬಾರ್ ನ್ಹಯ್ಚ್ಯಾ ಜಗ್ಗೊಳ್ ಹೊಲ್ಲ್ಯಾ ದರ್ಶನಾಚ್ಯಾ ಸಾರ್ಕೆ ಅತ್ತಾಬಿ ಮಾಕಾ ಹೊಲೆ, ತನ್ನಾ ಮಿಯಾ ಡಬ್ಬ್ ಪಡ್ಲೊ. <verse eid="EZK 43:3" /><verse number="4" style="v" sid="EZK 43:4" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾಚಿ ಮಹಿಮಾ ದಿಸ್ ಉಗವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ವಾಟೆನ್ ಗುಸುನ್ ದೆವಾಚ್ಯಾ ಗುಡಿತ್ ಗೆಲೊ. <verse eid="EZK 43:4" /><verse number="5" style="v" sid="EZK 43:5" />ದೆವಾಚ್ಯಾ ಆತ್ಮ್ಯಾನ್ ಮಾಕಾ ಉಕ್ಲುನ್ ಘೆವ್ನ್ ಭುತ್ತುರ್ಲ್ಯಾ ಜಾಗ್ಯಾರ್ ಹಾಲ್ಲ್ಯಾನ್. ತನ್ನಾ ಕಾಯ್ ಅಜಾಪ್! ಸರ್ವೆಸ್ಪರಾಚಿ ಮಹಿಮಾ ದೆವಾಚ್ಯಾ ಗುಡಿತ್ ಸಗ್ಳೊ ಭರುನ್ ಹೊತ್ತೊ. <verse eid="EZK 43:5" /><verse number="6" style="v" sid="EZK 43:6" />ತನ್ನಾ ದೆವಾಚ್ಯಾ ಗುಡಿತ್ನಾ ತೆಚೊ ಬೊಲ್ತಲೊ ಆವಾಜ್ ಮಾಜ್ಯಾ ಕಾನಾತ್ ಪಡ್ಲೆ; ತೊ ಘೊಮಾನುಸ್ ಮಾಜ್ಯಾ ಭಾಜುಕುಚ್ ಇಬೆ ಹೊತ್ತೊ. <verse eid="EZK 43:6" /><verse number="7" style="v" sid="EZK 43:7" />ಸಾಂಗ್ತಲ್ಯಾನ್ ಮಾಕಾ ಅಸಿ ಸಾಂಗಟ್ಲ್ಯಾನ್; ನರ್ ಮಾನ್ಸಾ, ಹೆ ಮಾಜೆ ಸಿಂಯಾಸನಾಚೊ ಜಾಗೊ, ಮಾಜೊ ಪಾಂಯ್ ಥವ್ತಲೊ ಮೆಜ್, ಹಿತ್ತೆ ಮಿಯಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಕನ್ನಾಬಿ ವಸ್ತಿ ರ್‍ಹಾತಾ. ಇಜ್ರಾಯೆಲಾಂಚಿ ಪಿಳ್ಗಿ ಹೊಂವ್ದಿತ್, ತೆಂಚಿ ರಾಜಾ ಹೊಂವ್ದಿತ್, ಅಪ್ನಾಚ್ಯಾ ದೆವಾಕ್ ದ್ರೊಹ್ ಕರುನ್ ಹಾಳ್ ಹೊವ್ನ್ ಗೆಲ್ಲ್ಯಾ ರಾಜಾಂಚ್ಯಾ ಮ್ಹಡ್ಯಾನಿ ಮಾಜೆ ಪವಿತ್ರ್ ನಾವ್ ಅಪವಿತ್ರ್ ಕರಿನಾ. <verse eid="EZK 43:7" /><verse number="8" style="v" sid="EZK 43:8" />ಮಾಕಾ ಹೊಂಬ್ಡ್ಯಾಚ್ಯಾ ಭಾಜುಕ್ ಅಪ್ನಾಚ್ಯಾ ಹೊಂಬ್ಡ್ಯಾಕ್ನಿ ಘಾಲುನ್ ಘೆವ್ನ್, ತೆಂಚ್ಯಾ ಘರಾಕ್ಬಿ, ಅಪ್ನಾಚ್ಯಾ ಘಾರ್ಬಿ ಎಕುಚ್ ಭಿತ್ತಿ ಹೊಯ್ ಸಾರ್ಕೆ ಕರುನ್ ಘೆತಲ್ಯಾ ಸಾಟ್ನಿ, ಅಜುನ್ ಮಾಜೊ ಪವಿತ್ರ್ ನಾವಾಕ್ ಅಶುದ್ದ್ ಕರಿನಾತ್. ಹೊಯ್, ಪಾಟಿ ತೆನಿ ಕರಲ್ಲ್ಯಾ ದುಶ್ಟ್ ಕಾಮಾಂಚ್ಯಾ ವಯ್ನಾ ಮಾಜೆ ಪವಿತ್ರ್ ನಾವ್ ಅಪಡ್ ಸಿಪ್ಪಡ್ ಕರಲ್ಯಾನಿ. ತೆಚ್ಯಾ ವಯ್ನಾ ಮಿಯಾ ರಾಗ್ ಎವ್ನ್ ತೆಂಕಾ ನಾಶ್ ಕರ್ಲೊ. <verse eid="EZK 43:8" /><verse number="9" style="v" sid="EZK 43:9" />ಅತ್ತಾ ತರ್ ಅಪ್ನಾಚೆ ದೆವಾಕ್ ದ್ರೊಹ್ ಕರಲ್ಲೊ ಅನಿ ರಾಜಾಂಚಿ ಮ್ಹಡಿಯಾ ಮಾಕಾ ದುರ್ ಕರುಂದಿತ್, ತನ್ನಾ ಮಿಯಾ ತೆಂಚ್ಯಾ ಮದ್ದಿ ಸದಾ ವಸ್ತಿ ಕರ್ತಾ.<verse eid="EZK 43:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 43:10" />ನರ್ ಮಾನ್ಸಾ, ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚೆ ತೆಂಚ್ಯಾ ಪಾಪಾಚ್ಯಾ ವಯ್ನಾ ಮರ್ಯಾದ್ ದಿಸಿ ಸಾರ್ಕೆ ದೆವಾಚಿ ಗುಡಿ ತೆಂಕಾ ದಾಕ್ವು, ತೆನಿ ತೆ ಮಾಪುಂದಿತ್. <verse eid="EZK 43:10" /><verse number="11" style="v" sid="EZK 43:11" />ತೆನಿ ಕರಲ್ಲ್ಯಾ ಬುರ್ಸ್ಯಾಕಾಮಾ ಕರಲ್ಲೆ ಸಗ್ಳೆ ಮರ್ಯಾದ್ ಕರುನ್ ಘೆಟ್ಲ್ಯಾನಿ. ತಿಯಾ ದೆವಾಚ್ಯಾ ಗುಡಿಚೆ ರುಪ್, ತೆಚೆ ಪರಿಸ್ಥಿತಿ ಅನಿ ಯೆನೆ ಅನಿ ಜಾನ್ತ್ಯಾನಿ ನಿಯಮಾ ಸಗ್ಳಿ ರಚಲ್ಲಿ ಪದ್ದತ್, ಸಗ್ಳಿ ವಿದಿಯಾ ಸಗ್ಳೆ ಭಾಂದ್ ಕಾಮಾಚಿ ರಿತಾ, ಸಗ್ಳಿ ಹುಕುಮಾ ಹೆ ಸಗ್ಳೆ ತೆಂಕಾ ಸಾಂಗ್, ತೆನಿ ತೆಚ್ಯಾ ಪುರಾ ಕಾಮಾ ವಿದಿಯಾ ಪಾಳುನ್ಗೆವ್ನ್ ಚಲುಚೆ ಮನುನ್ ತೆಂಚ್ಯಾ ಡೊಳ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಲಿವ್. <verse eid="EZK 43:11" /><verse number="12" style="v" sid="EZK 43:12" />ಹೆಚ್ ದೆವಾಚ್ಯಾ ಗುಡಿಚಿ ನಿಯಮ್, ಮಡ್ಡಿಚ್ಯಾ ವರ್‍ತಿ ಹೊತ್ತ್ಯಾ ತೆಚ್ಯಾ ಜಾತಲೆ ಭೊತ್ಯಾನಿ ಲೈ ಪವಿತ್ರ್ ಹೊವ್ನ್ ರ್‍ಹಾವ್ಚೆ, ಅಬಕ್, ದೆವಾಚ್ಯಾ ಗುಡಿಚಿ ನಿಯಮ್ ಹಿಚ್.<verse eid="EZK 43:12" /></para>
  <para style="s">ಬಲಿಚೊ ಅಲ್ತಾರ್</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 43:13" />ಬಲಿ ಭೆಟ್ವುತಲಿ ಅಲ್ತಾರಿಚೆ ಮಾಪ್ ಅಸಿ ರ್‍ಹಾವ್ಚೆ, ಖಾಯ್ಲ್ಯಾ ಭಾಗಾಚೆ ಉಪ್ಪರ್ ಅರ್ದ್ಯಾ ಹಾತಿ ವರ್‍ತಿ ಚಾರ್ ಬೊಟಾ, ಖಾಯ್ಲ್ಯಾ ಭಾಗಾಚೆ ಉಪ್ಪರ್ ಎಕ್ ಗೆನ್ ಹಾತ್, ವಯ್ಲ್ಯಾ ತುದಿಚಿ ರುಂದಿ ಭೊತ್ಯಾನಿ ದೊನ್ ಹಾತ್ ಭಾಜುಚ್ಯಾ ಮುಲ್ಲ್ಯಾಚಿ ರುಂದಿ ಭೊತ್ಯಾನಿ ದೊನ್ ಹಾತ್, ದಿಂಡೆಚಿ ರುಂದಿ ಎಕ್ ಹೆನ್ನ್; ಹೆಚ್ ಬಲಿಚೆ ಮೆಜ್. <verse eid="EZK 43:13" /><verse number="14" style="v" sid="EZK 43:14" />ಜಿಮ್ನಿಚ್ಯಾ ವರ್‍ತಿ ಮಟ್ಲ್ಯಾರ್ ಖಾಯ್ಲ್ಯಾ ಮ್ಹಾಳ್ಗಿ ಉಪ್ಪರ್ ಎಕ್ ಹಾತ್, ತೆಚ್ಯಾ ವಯ್ಲ್ಯಾ ಮುದ್ದ್ಯಾಚೊ ರುಂದಿ ಅರ್ದೊ ಹಾತ್; ತ್ಯಾ ಬಾರಿಕ್ಲ್ಯಾ ಮ್ಹಾಳ್ಗಿ ವರ್‍ತಿ ಮೊಟ್ಟ್ಯಾ ಮ್ಹಾಳ್ಗಿಚೆ ಉಪ್ಪರ್ ದೊನ್ ಹಾತ್ ವಯ್ಲ್ಯಾ ಮುಲ್ಲ್ಯಾಚಿ ರುಂದಿ ಅರ್ದೊ ಹಾತ್. <verse eid="EZK 43:14" /><verse number="15" style="v" sid="EZK 43:15" />ಹೊಮ್ ಬಲಿಚೊ ಕಟ್ಟೊ ಮ್ಹಾಳ್ಗಿ ಉಪ್ಪರ್ ಚಾರ್ ಹಾತ್; ತ್ಯಾ ಅಲ್ತಾರಿಚ್ಯಾ ವಯ್ಲ್ಯಾ ಭಾಜುನ್ ಚಾರ್ ಶಿಂಗಾ ರ್‍ಹಾವ್ಚೆ. <verse eid="EZK 43:15" /><verse number="16" style="v" sid="EZK 43:16" />ಬಲಿ ಭೆಟ್ವುತಲೊ ಜಾಗೊ ಸಾ ಹಾತ್ ಲಾಂಬಿ, ಸಾ ಹಾತ್ ರುಂದಿ ಚವ್ಕ್ ಚವ್ಕ್ ಹೊವ್ನ್ ರ್‍ಹಾವ್ಚೆ. <verse eid="EZK 43:16" /><verse number="17" style="v" sid="EZK 43:17" />ಮೊಟ್ಟೊ ಮ್ಹಾಳ್ಗಿಚ್ಯಾ ಸಾತ್ ಹಾತ್ ಲಾಂಬಿಕ್ ಸಾತ್ ಹಾತ್ ರುಂದಿಕ್, ಚಾರಿ ಭಾಜುನ್ಬಿ ಸಮಾ ಹೊವ್ನ್ ರ್‍ಹಾವ್ಕ್ ಪಾಜೆ, ಭೊತ್ಯಾನಿ ದಿಂಡೆಚ್ಯಾ ರುಂದಿಕ್ ಅರ್ದೊ ಹಿತ್ತ್, ಖಾಯ್ಲ್ಯಾ ಭಾಗಾಚೊ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ಮುಲ್ಲ್ಯಾಚೊ ರುಂದಿಕ್ ದೊನ್ ಹಾತ್ ಹೊವ್ನ್ ರ್‍ಹಾವ್ಚೆ, ತೆಚಿ ಪಯ್ರಿಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ತೊಂಡ್ ಕರುನ್ ರ್‍ಹಾವ್ಚೆ.<verse eid="EZK 43:17" /></para>
  <para style="s">ಬಲಿಚಿ ಅಲ್ತಾರ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಸಾಟ್ನಿ ನಿತಳ್ ಕರ್‍ತಲೆ</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 43:18" />ತನ್ನಾ ತ್ಯಾ ಘವ್ಮಾನ್ಸಾನ್ ಮಾಕಾ ಅಸಿ ಸಾಂಗ್ಲ್ಯಾನ್, ನರ್ ಮಾನ್ಸಾ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೆ ಮನ್ತಾ, ಸಗ್ಳ್ಯಾ ಆಂಗಾಚ್ಯಾ ಜಾಳ್ವುತಲ್ಯಾ ಬಲಿಕ್ ರಗಾತ್ ಸಿಪಡ್ತಲ್ಯಾ ಪದ್ದತಿಕ್ ಬಲಿ ಭೆಟ್ವುತಲಿ ಅಲ್ತಾರ್ ನಿತಳ್ ಕರ್ತಾನಾ, ಹಿ ಪದ್ದತ್ ಪಾಳುಕ್ ಪಾಜೆ. <verse eid="EZK 43:18" /><verse number="19" style="v" sid="EZK 43:19" />ಲೆವಿಯಾ ಚಾದೊಕಾಚ್ಯಾ ಪಿಳ್ಗಿಚೆ, ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಸೆವಾ ಕರ್‍ತಲೆ ಹೊಲ್ಲ್ಯಾ ಯಾಜಕಾಕ್ನಿ ತಿಯಾ ಎಕ್ ಪಾಡೊ ದೊಶ್ ಪರಿಹಾರಾಕ್ ಬಲಿಕ್ ಮನುನ್ ದಿವ್ಚೆ, ಹೆ ಸರ್ವೆಸ್ಪರಾಚಿ ಗೊಸ್ಟ್. <verse eid="EZK 43:19" /><verse number="20" style="v" sid="EZK 43:20" />ಮಾನಾ ತೆಚ್ಯಾ ರಗ್ತಾತ್ ಉಲ್ಲೆಸೆ ಕಾಡುನ್ ಘೆವ್ನ್, ಬಲಿ ಭೆಟ್ವುತಲ್ಯಾ ಚಾರಿ ಶಿಂಗಾಕ್ನಿ, ಮೊಟ್ಟ್ಯಾ ಮ್ಹಾಳ್ಗಿಚ್ಯಾ ಚಾರಿ ಮುಲ್ಲ್ಯಾಕ್ನಿ, ಭೊತ್ಯಾಚ್ಯಾ ದಿಂಡಾಕ್ಬಿ ಲಾವ್. ಅನಿ ಬಲಿ ಭೆಟ್ವುತ್ತಲ್ಯಾ ಜಾಗ್ಯಾಚೊ ದೊಶ್ ಪರಿಹಾರ್ ಕರುನ್ ತೆ ಶುದ್ದ್ ಕರ್. <verse eid="EZK 43:20" /><verse number="21" style="v" sid="EZK 43:21" />ಚುಕೆಚಿ ಬಲಿ ಸಾಟ್ನಿ ಕಾಡುನ್ ಥವಲ್ಲ್ಯಾ ಪಾಡ್ಯಾಕ್ ಬಲಿ ಭೆಟ್ವಲ್ಲ್ಯಾ ನೆಮಸಲ್ಲೊ, ತನ್ನಾ ಪವಿತ್ರ್ ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಬಾರ್ಯ್, ದೆವಾಚ್ಯಾ ಗುಡಿಕ್ ತೆಕಾ ಸಮಂದ್ ಪಡುನ್ ಗೊತ್ತ್ ಹೊತ್ತ್ಯಾ ಜಾಗ್ಯಾರ್ ತೆ ಜಾಳುಚೆ. <verse eid="EZK 43:21" /><verse number="22" style="v" sid="EZK 43:22" />ದೊನ್ವೆಚ್ಯಾ ದಿಸಿ, ದೊಶ್ ನಸಲ್ಲೊ ಬೊಕ್ಡು ಬಲಿ ಭೆಟ್ವು; ಬಯ್ಲಾಕ್ನಾ ಅಲ್ತಾರಿಕ್ ಶುದ್ದ್ ಕರಲ್ಯಾ ಸಾರ್ಕೆ ಬೊಕ್ಡು ಶುದ್ದ್ ಕರುಚೆ. <verse eid="EZK 43:22" /><verse number="23" style="v" sid="EZK 43:23" />ತಿಯಾ ಅಲ್ತರಿಚೆ ಶುದ್ದಿಕರನಾಚೆ ಕಾಮ್ ಸರಲ್ಲ್ಯಾ ಮಾನಾ ದೊಶ್ ನಸಲ್ಲ್ಯಾ ಪಾಡೊ ಹಿಂಡಾತ್ನಾ ಹಾನುನ್ ದೊಶ್ ನಸಲ್ಲ್ಯಾ ಸಗ್ಳೊ ಅಂಗ್ ಸಮಾ ಹೊತ್ತ್ಯಾ ಟಗ್ರಾಕ್ ಭೆಟ್ವುಚೆ. <verse eid="EZK 43:23" /><verse number="24" style="v" sid="EZK 43:24" />ತಿಯಾ ತೆ ಸಗ್ಳೆ ಸರ್ವೆಸ್ಪರಾಕ್ ಭೆಟ್ವುಲ್ಲ್ಯಾ ತನ್ನಾ ಯಾಜಕಾನಿ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಮಿಟ್ಟ್ ಫಾಪ್ಡುನ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಜಾಳ್ವುತಲಿ ಬಲಿ ದಿವ್ಚೆ. <verse eid="EZK 43:24" /><verse number="25" style="v" sid="EZK 43:25" />ಸಾತ್ ದಿಸಾಬಿ ತಿಯಾ ಸದ್ದಾಬಿ ದೊಶ್ ಪರಿಹಾರಾಕ್ ಮನುನ್ ಎಕೆಕ್ ಶೆಳಿಕ್ ಭೆಟ್ವುಚೆ, ಯಾಜಕಾಬಿ ದೊಶ್ ನಸಲ್ಲ್ಯಾ ಬಯ್ಲಾಕ್ ಹಿಂಡಾತ್ನಾ ಹಾನುನ್ ಅನಿ ದೊಶ್ ನಸಲ್ಲ್ಯಾ ಟಗ್ರಾಕ್ಬಿ ಭೆಟ್ವುಚೆ. <verse eid="EZK 43:25" /><verse number="26" style="v" sid="EZK 43:26" />ಅಸಿಚ್ ಸಾತ್ ದಿಸಾ ಅಲ್ತರಿಚೆ ದೊಶ್ ಪರಿಹಾರ್ ಕರುನ್ಗೆತ್ ತೆ ಶುದ್ದ್ ಕರುನ್ ಮಾನ್ ದಿವ್ಚೆ. <verse eid="EZK 43:26" /><verse number="27" style="v" sid="EZK 43:27" />ಸಾತ್ ದಿಸಾಚಿ ಕಾಮಾ ಸರಲ್ಯಾ ಮಾನಾ, ಆಟ್ವೆಚ್ಯಾ ದಿಸಿಬಿ ಇದ್ರಾಕ್ ಯಾಜಕಾ ಅಲ್ತಾರಿಚ್ಯಾ ವರ್‍ತಿ ತುಮ್ಚ್ಯಾ ಸಾಟ್ನಿ ಮನುನ್ ಸಗ್ಳಿ ಅಂಗ್ ಬಲಿಯಾ ಶಾಂತಿ ಸಮಾಧಾನಾಚಿ ಬಲಿಯಾ ಭೆಟ್ವುಚೆ, ತನ್ನಾ ಮಿಯಾ ತುಮ್ಕಾ ಸ್ವಿಕಾರ್ ಕರ್ತಾ, ಹೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 43:27" /></para>
  <chapter eid="EZK 43" />
  <chapter number="44" style="c" sid="EZK 44" />
  <para style="s">ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ದಡ್ಪ್ಯಾಚೆ ದಾರ್ ವಾಪ್ರುಪ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 44:1" />ಮಾನಾ ಹೊ ಘೊಮಾನುಸ್ ಮಾಕಾ ಪವಿತ್ರ್ ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ದಿಸ್ ಉಗವ್ತಲೊ ದಿಕ್ಕಾಚ್ಯಾ ಬಾರ್ಯ್ಲ್ಯಾ ಮೊಟ್ಟ್ಯಾ ದಡ್ಪ್ಯಾನ್ ಅನಿ ಪರ್‍ತುನ್ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್, ತೆ ಧಾಪ್ಲೆ. <verse eid="EZK 44:1" /><verse number="2" style="v" sid="EZK 44:2" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ, ಹೆ ದಡ್ಪ್ಯಾಚೆ ದಾರ್ ಧಾಪಲ್ಲೊ ರ್‍ಹಾವ್ಚೆ. ಹೆ ಉಗ್ಡುಬಿ ನ್ಹಯ್, ಹ್ಯಾತುರ್‍ನಾ ಕೊನ್ಬಿ ಜಾಯ್ ನಸ್ತಾನಾ ರಾಂವ್ದಿತ್, ಇಜ್ರಾಯೆಲಾಂಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರ್ ಹಿತ್ತೆತ್ನಾ ಯೆಲಾ, ತೆಚ್ಯಾ ಸಾಟ್ನಿ ಹೆ ಧಾಪುನುಚ್ ರ್‍ಹಾವ್ಚೆ. <verse eid="EZK 44:2" /><verse number="3" style="v" sid="EZK 44:3" />ರಾಜಾನಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಜೆವಾನ್ ಕರುಕ್ ಹಿತ್ತೆ ಬಸ್ಲ್ಯಾರ್ ಹೊತಾ, ತೊ ಮುಖ್ಯ್ ದಾರಾಕ್ನಾ ಖಾಲಿ ಭಾಗಾಕ್ನಾ ವಾಟೆನ್ ಎವ್ನ್ ತ್ಯಾಚ್ ವಾಟೆನ್ ಜಾವ್ಚೆ, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="EZK 44:3" /></para>
  <para style="s">ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಭುತ್ತುರ್ ಜಾತಲೆ ನಿಯಮ್</para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 44:4" />ಮಾನಾ ತ್ಯಾ ಘವ್ಮಾನ್ಸಾನ್, ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ ವಾಟೆನ್ ಮಾಕಾ ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಫಿಡೆ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್. ಮಿಯಾ ಬಗಿತುಚ್ ಹೊತ್ತ್ಯಾ ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾಚಿ ಮಹಿಮಾ ದೆವಾಚ್ಯಾ ಗುಡಿತ್ ಸಗ್ಳೊ ಭರ್ಲೊ. ತೆ ಬಗುನ್ ಮಿಯಾ ಡಬ್ಬ್ ಪಡ್ಲೊ. <verse eid="EZK 44:4" /><verse number="5" style="v" sid="EZK 44:5" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ಅಸಿ ಸಾಂಗ್ಲ್ಯಾನ್, ನರ್ ಮಾನ್ಸಾ, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಸಗ್ಳೆ ನೆಮಾ ನಿಯಮಾಂಚ್ಯಾ ವಿಶಯಾತ್ ಮಿಯಾ ತುಮ್ಕಾ ಸಾಂಗಲ್ಲ್ಯಾ ಸಗ್ಳೆ ತಿಯಾ ಕಾನಾನಿ ಆಯ್ಕುನ್, ಡೊಳ್ಯಾನಿ ಬಗುನ್, ಮನಾತುಚ್ ಥವ್ನ್ ಘೆ, ಅನಿ ಪವಿತ್ರ್ ಗುಡಿಚ್ಯಾ ಭುತ್ತುರ್ ಜಾತಲೆ ಅನಿ ಎತಲೆ ಸಗ್ಳೆ ಬರೆ ಕರುನ್ ಬಗ್.<verse eid="EZK 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 44:6" />ಅಸಿ ರ್‍ಹಾತಾನಾ ತಿಯಾ ತ್ಯಾ ಬುರ್ಸ್ಯಾಕ್ನಿ ಮಟ್ಲ್ಯಾರ್, ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಅಸಿ ಸಾಂಗ್. ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, <verse eid="EZK 44:6" /><verse number="7" style="v" sid="EZK 44:7" />ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾನೊ, ತುಮಿ ಮಾಜೆ ಜೆವಾನ್ ಹೊಲ್ಲ್ಯಾ ರಗಾತ್ ಭೆಟ್ವುತಾನಾ, ಪುರಾ ಮನಾನ್ ಅನಿ ಆಂಗಾತ್ ಸುನ್ನತ್ ಕರಿನಸಲ್ಲ್ಯಾ ದುಸ್ರ್ಯಾ ದೆಶಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ, ಮಾಜ್ಯಾ ಪವಿತ್ರ್ ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಭುತ್ತುರ್ ಹಾನುನ್ ಮಾಜ್ಯಾ ಗುಡಿಕ್ ಅಶುದ್ದ್ ಕರ್ಲ್ಯಾಸಿ. <verse eid="EZK 44:7" /><verse number="8" style="v" sid="EZK 44:8" />ತುಮಿ ಮಾಜೆ ಶುದ್ದ್ ಸಾಮಾನಾಕ್ನಿ ರಾಕುಕ್ನ್ಯಾಸಿ, ಮಾಜೆ ಪವಿತ್ರ್ ಗುಡಿತ್ ಸಾಮಾನ್ ಇಚಾರ್ನಿ ಕರುಕ್ ನ್ಯಾಸಿ. ಹ್ಯಾ ದುಸ್ರ್ಯಾ ದೆಶಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಮಾಜ್ಯಾ ಪವಿತ್ರ್ ಜಾಗ್ಯಾರ್ ಮಾಜ್ಯಾ ವಸ್ತ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ರಾಕುಕ್ ಮನುನ್ ನೆಮಕ್ ಕರುನ್ ಘೆಟ್ಲ್ಯಾಸಿ. ತುಮ್ಚಿ ಮೆಜುಕ್ ಹೊಯ್ನಸಲ್ಲಿ ದುಸ್ಟ್ ಕಾಮಾ ಅತ್ತಾ ಫಿರೆ. <verse eid="EZK 44:8" /><verse number="9" style="v" sid="EZK 44:9" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, “ಇಜ್ರಾಯೆಲಾತ್ನಿ ಮಿಳುನ್ ಹೊತ್ತ್ಯಾ ದುಶ್ರ್ಯಾ ದೆಶಾಚ್ಯಾ ಲೊಕಾತ್ನಿ ಪುರಾ ಮನಾತ್ನಿ ಸುನ್ನತ್ ಹೊಯ್ ನಸಲ್ಲೊ ಕೊನ್ಬಿ ಮಾಜ್ಯಾ ಪವಿತ್ರ್ ಗುಡಿತ್ ಯೆವ್ಕ್ ನಕ್ಕೊ”.<verse eid="EZK 44:9" /></para>
  <para style="s">ಲೆವಿಯಾಕ್ನಿ ಯಾಜಕ್ ಕಾಮಾತ್ನಾ ಎಗ್ಳೆ ಕರಲ್ಲೆ</para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 44:10" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಮಾಕಾ ಸೊಡಲ್ಲ್ಯಾ ತನ್ನಾ, ಮಾಜ್ಯಾಕ್ನಾ ಜಾವ್ನ್ ತೆಂಚ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾಕ್ಡೆ ಪರ್‍ತುನ್ ಘೆವ್ನ್ ಮಾಕಾ ದುರ್ ಹೊವ್ನ್ ಗೆಲ್ಲಿ ಲೆವಿಯಾ ತೆಂಚೊ ಚುಕೆಚೊ ಫಳ್ ಅನ್ಬೊಗ್ ಕರ್‍ತಾತ್. <verse eid="EZK 44:10" /><verse number="11" style="v" sid="EZK 44:11" />ತೆನಿ ಮಾಜ್ಯಾ ಪವಿತ್ರ್ ಗುಡಿತ್ ಹಜರಿಕಾರಾ ಅನಿ ಗುಡಿಚೆ ದಾರ್ ರಾಕ್ವಲಿಯಾ ಹೊವ್ನ್ ಗುಡಿತ್ ಸೆವಾ ಕರುಚೆ, ಲೊಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಜಾಳ್ವುತಲಿ ಬಲಿಚೆ ಜನಾವರಾಕ್ ಭೆಟ್ವುನ್ ತೆಂಕಾ ಸೆವಾ ಕರುಕ್ ತಯಾರ್ ಹೊವ್ನ್ ರ್‍ಹಾವ್ಚೆ. <verse eid="EZK 44:11" /><verse number="12" style="v" sid="EZK 44:12" />ತೆನಿ ತೆಂಚ್ಯಾ ಮುರ್ತಿಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಲೊಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಸೆವಾ ಕರುನ್, ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಪಾಪ್ ಪರಿಹಾರಾಚೆ ಅಡ್ಚನ್ ಹೊಲ್ಲ್ಯಾ ವಯ್ನಾ, ಮಿಯಾ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕಲ್ಲಾ. ತೆನಿ ತೆಂಚೆ ಚುಕೆಚಿ ಫಳ್ ಅನ್ಬೊಗ್ ಕರುನುಚ್ ಪಾಜೆ; ಹೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್. <verse eid="EZK 44:12" /><verse number="13" style="v" sid="EZK 44:13" />ಮಾಕಾ ಯಾಜಕಾಂಚೆ ಸೆವಾ ಕರುಕ್ ತೆನಿ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಯೆವ್ಚೆ ನ್ಹಯ್, ಮಾಜಿ ಲೈ ಪವಿತ್ರ್ ಹೊಲ್ಲ್ಯಾ ಪರಿಶುದ್ದ್ ವಸ್ತಾತ್ನಿ ಖಲ್ಯಾಕ್ಬಿ ಜಗ್ಗೊಳ್ ಜಾವ್ಚೆ ನ್ಹಯ್. ತೆಂಕಾ ಹೊಲ್ಲ್ಯಾ ಅವ್ಮಾನಾಕ್ ತೆನಿ ಕರಲ್ಲ್ಯಾ ದುಸ್ಟ್ ಕಾಮಾಚ್ಯಾ ಫಳಾಕ್ನಿ ಅನ್ಬೊಗ್ ಕರ್‍ತಾತ್. <verse eid="EZK 44:13" /><verse number="14" style="v" sid="EZK 44:14" />ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಸೆವಾತ್ನಿ ಅನಿ ಥೈ ಕರ್‍ತಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಕಾಮಾತ್ನಿಬಿ ಸೆವಕಾಚೆ ಕಾಮುಚ್ ತೆಂಕಾ ದಿವ್ಚೆ.<verse eid="EZK 44:14" /></para>
  <para style="s">ಯಾಜಕಾ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 44:15" />ಖರೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಮಾಕಾ ಸೊಡಲ್ಲ್ಯಾ ತನ್ನಾ, ಲೆವಿಯಾ ಚಾದೊಕಾಚ್ಯಾ ಪಿಳ್ಗಿಚೆ ಹೊಲ್ಲಿ ಯಾಜಕಾ ಮಾಜ್ಯಾ ಪವಿತ್ರ್ ಗುಡಿಚ್ಯಾ ಅಧಿಕಾರ್ ಚಾಲ್ವುಲ್ಯಾನಿ, ತೆಚ್ಯಾ ಸಾಟ್ನಿ ತೆನಿ ಮಾಜಿ ಸೆವಾ ಕರುಕ್ ಮಜ್ಯಾ ಇದ್ರಾಕ್ ಯೆತಾತ್. ರಗಾತ್ ಅನಿ ಮಾಂದೆ ಭೆಟ್ವುಕ್ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆ ರ್‍ಹಾತ್ಯಾತ್. ಹೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚಿ ಗೊಸ್ಟ್. <verse eid="EZK 44:15" /><verse number="16" style="v" sid="EZK 44:16" />ತೆನಿ ಮಾಜ್ಯಾ ಪವಿತ್ರ್ ಗುಡಿಕ್ ಭುತ್ತುರ್ ಜಾವ್ನ್, ಮಾಜಿ ಸೆವಾ ಕರುಕ್ ಮನುನ್ ಮೆಜಾಕ್ಡೆ ಜಾವ್ನ್, ಮಾಜ್ಯಾ ಗುಡಿಚೆ ಅಧಿಕಾರಾಚೆ ಕಾಮ್ ವಯ್ಸುನ್ ಘೆತಾತ್. <verse eid="EZK 44:16" /><verse number="17" style="v" sid="EZK 44:17" />ತೆನಿ ಭುತ್ತುರ್ಲ್ಯಾ ಭಾಗಾಚ್ಯಾ ದಾರಾಕ್ನಿ ಯೆತಾನಾ ಕಿಮ್ತಿಚೆ ಕಪ್ಡೆ ನೆಸುಚೆ, ಭುರ್ತುಲ್ಯಾ ಭಾಗಾಚ್ಯಾ ದಾರಾತ್ನಿಬಿ ದೆವಾಚ್ಯಾ ಗುಡಿತ್ಬಿ ಸೆವಾ ಕರಿತ್ ರ್‍ಹಾತಾನಾ, ಖಲೆ ಕಾಪ್ಸಾಚೆ ಕಪ್ಡೆಬಿ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ರ್‍ಹಾವ್ಚೆ ನ್ಹಯ್. <verse eid="EZK 44:17" /><verse number="18" style="v" sid="EZK 44:18" />ತೆನಿ ಟಕ್ಲ್ಯಾಕ್ ಕಿಮ್ತಿಚಿ ಪಾವ್ಡ್ ಅನಿ ಕಂಬ್ರೆಕ್ ಕಿಮ್ತಿಚಿ ಭುತ್ತುರ್ಲೆ ನೆಸಾನ್ ಘಾಲುನ್ ಘೆವ್ನ್ ರಾಂವ್ದಿತ್, ಘಾಮ್ ಯೆತಲೆ ಖಲೆಬಿ ಕಪ್ಡೆ ನೆಸುಚೆ ನ್ಹಯ್. <verse eid="EZK 44:18" /><verse number="19" style="v" sid="EZK 44:19" />ತೆನಿ ಭಾಯ್ಲ್ಯಾ ಭಾಗಾಚ್ಯಾ ಮಟ್ಲ್ಯಾರ್, ಥೈತ್ಯಾ ಲೊಕಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಜಾತಾನಾ, ತೆಂಚಿ ಸುಟ್ಕಾ ದಿತಲೆ ಯಾಜಕಾಚೆ ಕಪ್ಡೆ ತೆಂಕಾ ಲಾವ್ನ್ ತೆಂಕಾ ಪರಿಶುದ್ದ್ ಹೊಯ್ನಾ ಸಾರ್ಕೆ ಕರಿನಾ ಸಾರ್ಕೆ. ಖೊಲಿಯಾತ್ನಿ ಥವ್ ದುಸ್ರಿ ಕಪ್ಡೆ ನೆಸುನ್ ಘೆವುಂದಿತ್. <verse eid="EZK 44:19" /><verse number="20" style="v" sid="EZK 44:20" />ತೆನಿ ಕೆಸಾ ಕಾಡುನ್ ತಾಸ್ಕಿ ಕರುನ್ ಘೆವ್ಚೆ ನ್ಹಯ್, ಕೆಸಾ ವಾಡ್ವು ನ್ಹಯ್, ಕಾತ್ರುನ್ ಘೆವ್ನ್ ರ್‍ಹಾವ್ಚೆ. <verse eid="EZK 44:20" /><verse number="21" style="v" sid="EZK 44:21" />ಭುತ್ತುರ್ಲೊ ಭಾಗಾಕ್ ಜಾತಾನಾ, ಖಲೊ ಯಾಜಕ್ಬಿ ಖಡಕ್ ದರಾಕ್ಷಾಚೊ ರಸ್ ಫಿವ್ಚೆ ನ್ಹಯ್. <verse eid="EZK 44:21" /><verse number="22" style="v" sid="EZK 44:22" />ಯಾಜಕಾ ಘವ್ ಮರಲ್ಲಿ ಹೊವ್ನಂದಿತ್ ಘವ್ ಸೊಡಲ್ಲಿ ಹೊವ್ನ ದಿತ್ ನಗಿನ್ ಹೊವ್ಚೆ ನ್ಹಯ್, ಖರೆ, ಇಜ್ರಾಯೆಲ್ ಪಿಳ್ಗಿಚಿ ಚೆಡು ಹೊವ್ನಂದಿತ್, ಯಾಜಕಾಂಚ್ಯಾ ಘವ್ ಮರಲ್ಯಾ ಬಾಯ್ಕೊ ಮಾನ್ಸಿಕ್ ಹೊವುಂದಿತ್ ನಗಿನ್ ಕರುನ್ ಘೆವುಂದಿತ್. <verse eid="EZK 44:22" /><verse number="23" style="v" sid="EZK 44:23" />ತೆನಿ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಪವಿತ್ರ್ ಹೊಲ್ಲೆಬಿ ಅನಿ ಅಪವಿತ್ರ್ ಹೊಲ್ಲೆಬಿ ಹೊತ್ತಿ ವ್ಯತ್ಯಾಸ್ ಸಾಂಗ್, ತೆಂಕಾ ಶುದ್ದ್ ಅನಿ ಅಶುದ್ದಾಚೆ ಭೆದ್ ಕಳ್ವಾ. <verse eid="EZK 44:23" /><verse number="24" style="v" sid="EZK 44:24" />ವಾದ್ ಹೊತಾನಾ ತೆ ತಿರ್ಸುಕ್ ಇಬೆ ರ್‍ಹಾವ್ನ್, ಮಾಜಿ ನ್ಯಾಯ್ ನಿಯಮಾಕ್ನಿ ತೆಚ್ಯಾ ಸಾರ್ಕೆ ತಿರ್ಸುಚೆ; ಮಿಯಾ ತಯಾರ್ ಕರಲ್ಯಾ ಸನಾಕ್ನಿ ಮಾಜ್ಯಾ ನಿಯಮಾಕ್ನಿ ಮಾನುನ್ ಘೆವ್ನ್ ಚಲುನ್ ಮಾಜ್ಯಾ ಸಬ್ಬತಾ ದಿಸಾ ಪವಿತ್ರ್ ಮನುನ್ ಆಚರನ್ ಕರುಚೆ ಮನುನ್ ಬಗುನ್ ಘೆವಾ. <verse eid="EZK 44:24" /><verse number="25" style="v" sid="EZK 44:25" />ಮರಲ್ಯಾಂಚೆ ಮ್ಹಡಿಯಾ ಜಗ್ಗೊಳ್ ಜಾವ್ನ್ ಅಪ್ನಾಕುಚ್ ಅಶುದ್ದ್ ಕರುನ್ ಘೆವ್ನ್ ನ್ಹಯ್. ಹೊಲ್ಯಾರ್ ಮರಲ್ಲೊ ಬಾಬಾ, ಬಾಯ್, ಲೆಕ್, ಲೆಕಿ, ಬಾರಿಕ್ಲೊ ಭಾವ್, ಲಗಿನ್ ಹೊಯ್ ನಸಲ್ಲಿ ಭೆನ್ ಹೆಂಚ್ಯಾ ಸಾಟ್ನಿ ಎಕ್ಲೊ ಅಪ್ನಾಕುಚ್ ಅಶುದ್ದ್ ಕರುನ್ ಘೆಟ್ಲ್ಯಾರ್ ಹೊತಾ. <verse eid="EZK 44:25" /><verse number="26" style="v" sid="EZK 44:26" />ತಸ್ಲ್ಯಾಕ್ ಶುದ್ದ್ ಹೊಲ್ಯಾರ್ಬಿ ಸಾತ್ ದಿಸಾ ಎಗ್ಳೆ ಥವ್ಚೆ. <verse eid="EZK 44:26" /><verse number="27" style="v" sid="EZK 44:27" />ತೊ ಸೆವಾ ಕರುಕ್ ಪವಿತ್ರ್ ಗುಡಿಕ್ ಜಾವ್ನ್ ಭುತ್ತುರ್ಲ್ಯಾ ಭಾಗಾಕ್ ಯೆತಲ್ಯಾ ದಿಸಿ ತೆಚ್ಯಾ ದೊಶ್ ಪರಿಹಾರಾಕ್ ಮನುನ್ ಬಲಿ ಭೆಟ್ವುಚೆ. ಹೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 44:27" /><verse number="28" style="v" sid="EZK 44:28" />ಯಾಜಾಕಾಕ್ನಿ ಹೊತ್ತೆ ಎಕುಚ್ ಬದಿಕ್ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ಮಿಯಾಚ್ ತೆಂಕಾ ಆಸ್ತಿ, ಇಜ್ರಾಯೆಲಾತ್ ತೆಂಕಾ ಖಲಿಬಿ ಆಸ್ತಿ ದಿವ್ ನ್ಹಯ್, ಮಿಯಾಚ್ ತೆಂಕಾ ಆಸ್ತಿ. <verse eid="EZK 44:28" /><verse number="29" style="v" sid="EZK 44:29" />ತೆನಿ ಧ್ಯಾನ್ ಬಲಿಯಾ ದೊಶ್ ಪರಿಹಾರ್ ಕರ್ತಲಿ ಬಲಿಚಿ ತೆಲಾ ಸಾರ್ಕೆ, ಪಶ್ಚಾತಾಪಾಚಿ ಬಲಿಚಿ ತೆಲಾ ಸಾರ್ಕೆ, ಅನ್ಬೊಗ್ ಕರುನ್ ದಿತ್, ಸರ್ವೆಸ್ಪರಾಚಿಚ್ ರ್‍ಹಾವ್ಚೆ ಮನುನ್ ಇಜ್ರಾಯೆಲಾ ಮಾಗುನ್ ಘೆಟಲ್ಲೆ ಸಗ್ಳೆ ತೆಂಕಾ ದಿವ್ಚೆ. <verse eid="EZK 44:29" /><verse number="30" style="v" sid="EZK 44:30" />ಸಗ್ಳ್ಯಾ ಪಯ್ಲೆಚ್ಯಾ ಫಳಾತ್ನಿ ಬರೆ ಹೊಲ್ಲೆ ಅನಿ ತುಮಿ ಮಾಕಾ ಮನುನ್ ದುಸ್ರೆ ದಿವ್ಚೆ ಮನುನ್ ಕರಲ್ಯಾತ್ಲೆ ಸಗ್ಳೆ ವಸ್ತಾ ತೆಂಚಿ ಹೊವ್ನ್ ರ್‍ಹಾವ್ಚೆ, ತುಮ್ಚ್ಯಾ ಘರಾಚ್ಯಾ ಆರ್ಶಿವಾದಾಕ್ ಘಟ್ ರ್‍ಹಾವ್ಚೆ ಮನುನ್ ತುಮಿ ಪಯ್ಲೆಚೆ ಪಿಟ್ಟ್ ಯಾಜಕಾಕ್ನಿ ದಿವ್ಚೆ. <verse eid="EZK 44:30" /><verse number="31" style="v" sid="EZK 44:31" />ಯಾಜಕಾನಿ ಅಪ್ನಾಕ್ ಮನುನ್ ಮರುನ್ ಪಡಲ್ಲ್ಯಾ ನಾತರ್ ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಜನಾವರಾಚ್ಯಾಕ್ನಾ ಜಿವ್ ಕಾಡಲ್ಯಾ ಫಾಂಕ್ರಾಕ್ನಿ ಹೊಂವ್ದಿತ್ ಜನಾವರ್ ಹೊಂವ್ದಿತ್ ಖಾವ್ ನ್ಹಯ್.<verse eid="EZK 44:31" /></para>
  <chapter eid="EZK 44" />
  <chapter number="45" style="c" sid="EZK 45" />
  <para style="s">ದೆಸಾತ್ಲೆ ಸರ್ವೆಸ್ಪರಾಚೊ ಭಾಗ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 45:1" />ತುಮಿ ದೆಶ್ ಸ್ವತಾಚೆ ಮನುನ್ ವಾಟುನ್ ಘೆತಾನಾ, ಎಕ್ ವಾಟೊ ಎಗ್ಳುನ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಭೆಟ್ವುಚೆ, ತೊ ಜಾಗೊ ಸಾಡೆ ಬಾರಾ ಹಾಜಾರ್ ಹಾತ್ ಲಾಂಬಿ, ಅನಿ ಧಾ ಹಾಜಾರ್ ಹಾತ್ ರುಂದ್ ರ್‍ಹಾವ್ನ್ ಭೊತ್ಯಾನ್ ಪವಿತ್ರ್ ಹೊವ್ನ್ ರ್‍ಹಾವ್ಚೊ. <verse eid="EZK 45:1" /><verse number="2" style="v" sid="EZK 45:2" />ಹ್ಯಾತುರ್ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್ ಲಾಂಬಿ, ಅನಿ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್ ರುಂದಿ, ಚವ್ಕ್ ಜಾಗೊ ಪವಿತ್ರ್ ಗುಡಿಚೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ತೆಜ್ಯಾ ಭೊತ್ಯಾನ್ ಪಂಚಿಸ್ ಹಾತ್ ರುಂದಿ, ಜೊತ್ ಮಾರುಕ್ ನಸಲ್ಲಿ ಜಿಮಿನ್ ರ್‍ಹಾತಾ. <verse eid="EZK 45:2" /><verse number="3" style="v" sid="EZK 45:3" />ಪಯ್ಲೆ ಮೆಜಲ್ಲ್ಯಾ ಜಾಗ್ಯಾತ್ ಸಾಡೆ ಬಾರಾ ಹಾಜಾರ್ ಹಾತ್ ಲಾಂಬಿ, ಅನಿ ಪಾಂಚ್ ಹಾಜಾರ್ ಹಾತ್ ರುಂದಿ ಎಕ್ ಭಾಗ್ ಮೆಜ್, ಅನಿ ಹ್ಯಾತುರ್ ಪವಿತ್ರ್ ಗುಡಿ ರ್‍ಹಾವ್ಚಿ. <verse eid="EZK 45:3" /><verse number="4" style="v" sid="EZK 45:4" />ದೆಸಾತ್ ನಿತಳ್ ಭಾಗ್ ಹೊಚ್ ಹೊವ್ನ್ ಹಾಯ್, ಹೆ ಪವಿತ್ರ್ ಗುಡಿಚ್ಯಾ ಸೆವಕಾಕ್ನಿ ಅನಿ ಯಾಜಕಾಕ್ನಿ ದಿವ್ನ್ ಹೊವ್ಚೆ, ಹೆ ಯಾಜಕಾಂಚ್ಯಾ ಘರಾಕ್ನಿ ಅನಿ ಪವಿತ್ರ್ ಗುಡಿಕ್ ಪವಿತ್ರ್ ಜಾಗೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="EZK 45:4" /><verse number="5" style="v" sid="EZK 45:5" />ಗುಡಿಚಿ ಸೆವಕಾ ಲೆವಿಯಾ ಗಾಂವಾ ಭಾಂದುನ್ಗೆವ್ನ್ ವಸ್ತಿ ಕರಿಸಾರ್ಕೆ ಸಾಡೆ ಬಾರಾ ಹಾಜಾರ್ ಹಾತ್ ಲಾಂಬಿ, ಅನಿ ಪಾಂಚ್ ಹಾಜಾರ್ ಹಾತ್ ರುಂದಿ, ಜಾಗೊ ತೆಂಚೊ ವಾಟೊ ಹೊತಾ. <verse eid="EZK 45:5" /><verse number="6" style="v" sid="EZK 45:6" />ತುಮಿ ಮಾಕಾ ಭೆಟ್ವುತಲ್ಯಾ ನಿತಳ್ ಜಾಗ್ಯಾಚ್ಯಾ ಭಾಜುಕ್ ಸಾಡೆ ದೊನ್ ಹಾಜಾರ್ ಹಾತ್ ರುಂದಿ, ಸಾಡೆ ಬಾರಾ ಹಾಜಾರ್ ಹಾತ್ ಲಾಂಬಿ ಜಾಗೊ ಶಾರಾಕ್ ಸಮಂದ್ ಪಡಲ್ಲೊ ಜಾಗೊ ಕರುನ್ ನೆಮ್ಸುಚೆ, ತ್ಯಾತುರ್ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ವಾಟೊ ರ್‍ಹಾತಾ.<verse eid="EZK 45:6" /></para>
  <para style="s">ರಾಜ್ವಟ್ಕಿ ಚಾಲ್ವುತಲ್ಯಾಂಚೊ ಜಾಗೊ</para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 45:7" />ರಾಜ್ಯಾಚೊ ವಾಟೊ ತುಮಿ ಯೆಗ್ಳುನ್ ಥವ್ನ್ ಭೆಟ್ವುತಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಅನಿ ಶಾರಾಕ್ ಸಮಂದ್ ಪಡಲ್ಲ್ಯಾ ಜಿಮ್ನಿಕ್ ದೊನಿ ಭಾಜುಕ್ನಿ ರ್‍ಹಾತಾ, ತುಮಿ ರಾಜಧಾನಿ ಕರುನ್ ಭೆಟ್ವುತಲ್ಯಾ ಜಿಮ್ನಿಚ್ಯಾ ಅನಿ ರಾಜ್ವಡ್ಕಿ ಕರ್‍ತಲ್ಯಾಕ್ನಿ ಸಮಂದ್ ಪಡಲ್ಲ್ಯಾ ಜಿಮ್ನಿಚ್ಯಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ತೆ ಪಗ್ಳುನ್ ರ್‍ಹಾತಾ, ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ತೆ ತ್ಯಾಚ್ ದಿಕ್ಕಾಕ್ ಪಗ್ಳುನ್ ರ್‍ಹಾತಾ, ತೆಚಿ ಲಾಂಬಿ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಎಕ್ ಕುಳಿಚ್ಯಾ ಆಸ್ತಿ ತವ್ಡೆಚ್ ಲಾಂಬ್ ರ್‍ಹಾತಾ. <verse eid="EZK 45:7" /><verse number="8" style="v" sid="EZK 45:8" />ತೆ ತೆಕಾ ಇಜ್ರಾಯೆಲಾತ್ನಿ ಜಿಮ್ನಿಚಿ ಆಸ್ತಿ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಹೆಜ್ಯಾ ಮಾನಾ ರಾಜಾ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ತರಾಸ್ ದಿಯ್ನಾತ್, ದೆಶಾಚಿ ಜಿಮಿನ್ ಇಜ್ರಾಯೆಲ್ ಹರ್ ಎಕ್ ಕುಳಿಯಾಕ್ನಿ ವಾಟುನ್ ದಿತಾತ್.<verse eid="EZK 45:8" /></para>
  <para style="s">ಮುಖಂಡಾಕ್ನಿ ನಿಯಮಾ</para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 45:9" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೆ ಮನ್ತಾ, ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ರಾಜ್ಯಾನೊ, ಅತ್ತಾ ಫಿರೆ, ಫಿರೆ, ಚೊರಿ ಕರಲ್ಲೆ ಅನಿ ಬಲತ್ಕಾರ್ ಸೊಡಾ, ಅನಿ ಖರೆಪಾನಾನ್ ಚಲಾ, ಮಾಜ್ಯಾ ಲೊಕಾಂಚೊ ವಾಟೊ ಚುಕ್ವುತಲೆ ಅನ್ಯಾಯ್ ಸೊಡುನ್ ಸೊಡಾ, ಹೆ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 45:9" /><verse number="10" style="v" sid="EZK 45:10" />ತುಮ್ಚಿ ದಾನೆ ಮಾಪ್ತಲಿ ತಕ್ಡಿ ಖರೆಪಾನಾನ್ ರ್‍ಹಾವ್ಚಿ, ಅನಿ ತೆಲ್ ಪಾನಿ ಮೆಜ್ತಲೆ ಮಾಪ್ ಬಿ ಖರೆಪಾನಾಚೆ ರ್‍ಹಾವ್ಚೆ. <verse eid="EZK 45:10" /><verse number="11" style="v" sid="EZK 45:11" />ಎಫಾ ಮನ್ತಲೆ ದಾನ್ಯಾಂಚೆ ಮಾಪ್ ಅನಿ ಬತ್ ಮನ್ತಲೆ ತೆಲ್ ಪಾನಿಯಾಚೆ ಮಾಪ್, ಎಕ್ ಮಾಪಾಚೆ ಹೊವ್ನ್ ರ್‍ಹಾವ್ಚೆ, ಬತ್ ಮನ್ತಲೆ ಮಾಪ್ ಕರ್‍ತಲ್ಯಾ ಆಯ್ದಾನಾನ್ ಧಾತ್ಲೊ ಎಕ್ ವಾಟೊ, ಹೊಮೆರಾಚೊ ಧಾತ್ಲೊ ಎಕ್ ವಾಟೊ, ಹೆ ದೊನಿಬಿ ಹೊಮೆರಾಚ್ಯಾ ಮಾಪಾಕ್ ಸಮಾ ಹೊವ್ನ್ ರ್‍ಹಾವ್ಚೆ. <verse eid="EZK 45:11" /><verse number="12" style="v" sid="EZK 45:12" />ಎಕ್ ಸೆಕೆಲ್ ವಿಸ್ ಗೆರಾ ರ್‍ಹಾವ್ಚೆ, ತುಮ್ಚ್ಯಾಕ್ನಾ ಭೆಟ್ವುತಲೆ ಮಿನಾ ವಿಸ್, ವಿಸಾರ್ ಪಾಚ್ ನಾತರ್ ಪಂದ್ರಾ ಸೆಕೆಲಾಚೆ ಹೊವ್ನ್ ರ್‍ಹಾವ್ಚೆ. <verse eid="EZK 45:12" /><verse number="13" style="v" sid="EZK 45:13" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ತುಮಿ ತುಮ್ಚ್ಯಾ ಚುಕೆಂಚ್ಯಾ ಪರಿಹಾರ್ ಸಾಟ್ನಿ, ದಾನೆ ಭೆಟ್ವುತಲೆ ಸಗ್ಳೆ ಅಂಗ್ ಜಾಳ್ವುತಲಿ ಬಲಿ ಅನಿ ಸಮಾಧಾನಾಚಿ ಬಲಿ ಕರುಕ್ ಸಾಟ್ನಿ ಭೆಟ್ವುಚೆ ಹೊಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ಎಕ್ ಹೊಮೆರ್ ಮಾಪಾಚೆ ಘಂವಾತ್ ಎಫಾ ಮಾಪಾಚೆ ಸಾ ತ್ಲೆ ಎಕ್ ವಾಟೊ, ಎಕ್ ಹೊಮೆರ್ ಮಾಪಾಚ್ಯಾ ಜವ್ ಘಂವಾಚ್ಯಾ ಎಫಾ ಮಾಪಾಚ್ಯಾ ಸಾ ತ್ಲೊ ಎಕ್ ವಾಟೊ. <verse eid="EZK 45:13" /><verse number="14" style="v" sid="EZK 45:14" />ಎಕ್ ಬತ್ ತೆಲಾತ್ ಭೆಟ್ವುಚೆ ಹೊಲ್ಲೆ ವಾಟೊ ಕವ್ಡೊ ಮಟ್ಲ್ಯಾರ್, ಎಕ್ ಕೊರ್ ಮಟ್ಲ್ಯಾರ್ ಧಾ ಬತ್ ನಾತರ್ ಎಕ್ ಹೊಮೆರ್ ಮಾಪಾಚ್ಯಾ ತೆಲಾತ್ ಧಾತ್ಲೊ ಎಕ್ ವಾಟೊ ಧಾ ಬತ್ ಮಟ್ಲ್ಯಾರ್ ಎಕ್ ಹೊಮೆರ್. <verse eid="EZK 45:14" /><verse number="15" style="v" sid="EZK 45:15" />ದೊನ್ಸೆ ಬಕ್ರ್ಯಾತ್ನಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಪಾನಿಯಾಚ್ಯಾ ಗವ್ತಾಚ್ಯಾ ಜಾಗ್ಯಾ ವಯ್ಲೆ ಎಕ್ ಬಕ್ರೆ. <verse eid="EZK 45:15" /><verse number="16" style="v" sid="EZK 45:16" />ಹೆ ಸಗ್ಳೆ ಸಗ್ಳ್ಯಾ ದೆಶಾಚ್ಯಾ ಲೊಕಾನಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಮುಖಂಡಾಕ್ ಒಪ್ಸುಚೆ. <verse eid="EZK 45:16" /><verse number="17" style="v" sid="EZK 45:17" />ಸನಾತ್ನಿ ಅನಿ ಆಮ್ಸೆತ್ನಿ, ಸಬ್ಬತಾತ್ನಿ ಅನಿ ಇಜ್ರಾಯೆಲಾಕ್ನಿ ನೆಮ್ಸುನ್ ಹೊಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಸನಾತ್ನಿಬಿ ಜನಾವರಾಚೆ ಸಗ್ಳೆ ಅಂಗ್ ಜಾಳ್ವುತಲಿ ಬಲಿ, ದಾನೆ ಭೆಟ್ವುತಲೆ, ಪಾನಿ ಭೆಟ್ವುತಲೆ, ಹೆ ಸಗ್ಳೆ ಭೆಟ್ವುತಲೆ ಮುಖಂಡಾಚೆ ಕಾಮ್ ಹೊವ್ನ್ ಹಾಯ್, ಇಜ್ರಾಯೆಲ್ ಕುಳಿಚ್ಯಾ ಪಾಪ್ ಮಾಪಿಚೆ ಬಲಿಚೆ ಜನಾವರ್, ದಾನೆ ಭೆಟ್ವುತಲೆ, ಅನಿ ಜನಾವರಾಚೆ ಸಗ್ಳೆ ಅಂಗ್ ಬಲಿ, ಸಮಾದಾನಾಚ್ಯಾ ಬಲಿಚೆ ಜನಾವರ್, ಹೆ ಸಗ್ಳೆ ಭೆಟ್ವುಚೆ.<verse eid="EZK 45:17" /></para>
  <para style="s">ಸನಾ</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 45:18" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ಪಯ್ಲ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಪಯ್ಲೆಚ್ಯಾ ಮಯ್ನ್ಯಾಚ್ಯಾ ಪಯ್ಲ್ಯಾ ದಿಸಿ, ತಿಯಾ ಬಯ್ಲಾಚೆ ಸಗ್ಳೆ ಅಂಗ್ ಬಲಿ ಕರುಕ್ ಎಕ್ ಬಯ್ಲ್ ಎಚುನ್ ಘೆವ್ನ್, ತೆಜ್ಯಾನ್ ಪವಿತ್ರ್ ಗುಡಿ ನಿತಳ್ ಕರುಚೆ. <verse eid="EZK 45:18" /><verse number="19" style="v" sid="EZK 45:19" />ತ್ಯಾ ಯಾಜಕಾನ್ ತ್ಯಾ ಪಾಪ್ ಮಾಪಿಚ್ಯಾ ಬಲಿಚ್ಯಾ ರಗ್ತಾತ್ ಉಲ್ಲೆಸೆ ಘೆವ್ನ್, ಗುಡಿಚ್ಯಾ ದಾರಾಚ್ಯಾ ಚವ್ಕಟ್ಟಾಕ್ ಅನಿ ಬಲಿಚ್ಯಾ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಚಾರಿ ಮುಲ್ಲ್ಯಾಕ್ನಿ ಭುತ್ತುರ್ಲ್ಯಾ ಖೊಲಿಚ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ ಖಾಂಬ್ಯಾಕ್ನಿಬಿ ಲಾವ್ಚೆ. <verse eid="EZK 45:19" /><verse number="20" style="v" sid="EZK 45:20" />ತಸೆಚ್ ಸಾತ್ವ್ಯಾ ಮಯ್ನ್ಯಾಚ್ಯಾ ಪಯ್ಲೆಚ್ಯಾ ದಿಸಿ ತಿಯಾ ಬಲಿ ಭೆಟ್ವುನ್ ಕೊನಿತರಿಬಿ ಕಳಿನಸ್ತಾನಾ, ಆಕಸ್ಮಾತ್ ಕರಲ್ಲ್ಯಾ ಚುಕೆ ಸಾಟ್ನಿ ಬುದ್ದ್ ನಸಲ್ಲ್ಯಾಂಚ್ಯಾ ಕಾಮಾನಿ ಗುಡಿಕ್ ಹೊಲ್ಲ್ಯಾ ಪಾಪಾಕ್ ಪರಿಹಾರ್ ಕರುಚೆ. <verse eid="EZK 45:20" /><verse number="21" style="v" sid="EZK 45:21" />ಪಯ್ಲೆಚ್ಯಾ ಮಯ್ನ್ಯಾಚ್ಯಾ ಚವ್ದಾವ್ಯಾ ದಿಸಾತ್ ಸಾತ್ವ್ಯಾ ದಿಸಾಚೆ ಪಾತ್ಕಾಚೊ ಸನ್ ಕರುಚೆ, ಆಂಬೊಟ್ ನಸಲ್ಲಿ ಬಾರಿಕ್ಲಿಯಾಚ್ ಖಾವ್ಚೆ. <verse eid="EZK 45:21" /><verse number="22" style="v" sid="EZK 45:22" />ತ್ಯಾ ದಿಸಾತ್ ರಾಜಾನ್ ಅಪ್ನಾ ಸಾಟ್ನಿ ಅನಿ ದೆಶ್ಯಾ ಸಾಟ್ನಿ ಅನಿ ಲೊಕಾಂಚ್ಯಾ ಸಾಟ್ನಿಬಿ ಪಾಪ್ ಮಾಪಿಚಿ ಬಲಿ ಸಾಟ್ನಿ ಎಕ್ ಬಯ್ಲ್ ಭೆಟ್ವುಚೆ. <verse eid="EZK 45:22" /><verse number="23" style="v" sid="EZK 45:23" />ಸನಾಚ್ಯಾ ಸಾತ್ ದಿಸಾತ್ನಿಬಿ ಸರ್ವೆಸ್ಪರಾಕ್ ಭೆಟ್ವುಚೆ ಹೊಲ್ಲ್ಯಾ ಸಗ್ಳೆ ಅಂಗ್ ಬಲಿ ಸಾಟ್ನಿ ತೆನಿ ಸಾತ್ ದಿಸಾಂಚ್ಯಾ ಪತರ್ಬಿ ಸಗ್ಳೆ ಅಂಗ್ ಬಲಿ ಸಾಟ್ನಿ ಸಾತ್ ಪಾಡೆ ಅನಿ ಸಾತ್ ಟಗ್ರಾ, ಅನಿ ಸಾತ್ ಪಾಲ್ವೆ ಒಪ್ಸುಚೆ, ಅನಿ ಪಾಪ್ ಮಾಪಿಚಿ ಬಲಿ ಸಾಟ್ನಿ ಹರ್ ಎಕ್ ದಿಸಿಬಿ ಎಕ್ ಬಯ್ಲಾ ಒಪ್ಸುಚೆ. <verse eid="EZK 45:23" /><verse number="24" style="v" sid="EZK 45:24" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಹರ್ ಎಕ್ ಪಾಡ್ಯಾಚ್ಯಾ ಅನಿ ಟಗ್ರಾ, ಅನಿ ಶೆಳಿಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಹರ್ ಎಕಾಕ್ ಎಕೆಕ್ ಎಫಾ ಭರ್ ತೆಲ್, ಅನಿ ಹರ್ ಎಕ್ಲ್ಯಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಎಕ್ ಎಫಾ ಘಂವಾಚೆ ಪಿಟ್ಟ್ ಭೆಟ್ವುಚೆ. <verse eid="EZK 45:24" /><verse number="25" style="v" sid="EZK 45:25" />ಸಾತ್ವ್ಯಾ ಮ್ಹಯ್ನ್ಯಾಚ್ಯಾ ಪಂದ್ರಾವ್ಯಾ ದಿಸಾತ್ ಶುರು ಹೊತಲ್ಯಾ ಸನಾಚ್ಯಾ ಸಾತ್ ದಿಸಾತ್ನಿಬಿ ತೆನಿ ಪಾಪ್ ಮಾಪಿಚೆ ಜನಾವರ್, ಸಗ್ಳೆ ಅಂಗ್ ಬಲಿಚೆ ಜನಾವರ್ ಅನಿ ದಾನ್ಯಾಂಚೆ ಬಲಿ, ತೆಲ್ ಹೆ ಸಗ್ಳೆ ತ್ಯಾಚ್ ನೆಮಾ ಸಾರ್ಕೆ ದಿವ್ಚೆ.<verse eid="EZK 45:25" /></para>
  <chapter eid="EZK 45" />
  <chapter number="46" style="c" sid="EZK 46" />
  <para style="s">ಮುಖಂಡ್ ಅನಿ ಸನಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 46:1" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಅಸೊ ಮನ್ತಾ, ವ್ಹಾರ್‍ಯಾತ್ ಕಾಮ್ ಕರ್‍ತಲ್ಯಾ ಸಾ ದಿಸಾತ್ನಿ ಭುತ್ತುರ್ಲ್ಯಾ ಖೊಲಿಚೆ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚೆ ದಾರ್ ಧಾಪಲ್ಲೆ ರ್‍ಹಾವ್ಚೆ, ಖರೆ ಸಬ್ಬತಾಚ್ಯಾ ಅನಿ ಅಮ್ಸೆಚ್ಯಾ ದಿಸಿ ಉಗಡಲ್ಲೆ ರ್‍ಹಾವ್ಚೆ. <verse eid="EZK 46:1" /><verse number="2" style="v" sid="EZK 46:2" />ಮುಖಂಡ್ ಭಾಯ್ಲ್ಯಾ ವಾಟೆನ್ ಮುಖ್ಯ್ ದಾರ್ ಮಂಟಪ್ ಗುಸುನ್ ದಾರಾಚ್ಯಾ ಪಟ್ಟಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ಇಬೆ ರ್‍ಹಾವ್ನ್, ಅಪ್ನಿ ಭೆಟ್ವಲ್ಲೆ ಜಾಳ್ವುತಲಿ ಬಲಿ ಜನಾವರ್ ಅನಿ ಸಮಾಧಾನಾಚ್ಯಾ ಬಲಿಚೆ ಜನಾವರ್ ಯಾಜಕಾನ್ ಭೆಟ್ವುತಾನಾ, ದಾರಾಚ್ಯಾ ಹುಂಬ್ಡ್ಯಾತ್ ಡಬ್ಬ್ ಪಡುಚೆ, ತೆಜ್ಯಾ ಮಾನಾ ಜಾಂವ್ದಿತ್, ತ್ಯಾ ದಿಸಿ ಸಾಂಜ್ ಪತರ್ಬಿ ದಾರ್ ಧಾಪ್ತಲೆ ನಕ್ಕೊ. <verse eid="EZK 46:2" /><verse number="3" style="v" sid="EZK 46:3" />ಸಬ್ಬತಾಚ್ಯಾ ದಿಸಿ ಅನಿ ಅಮ್ಸೆಚ್ಯಾ ದಿಸಿ ದೆಶ್ಯಾಚಿ ಲೊಕಾ ತ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ ಫಿಡೆ ಸರ್ವೆಸ್ಪರಾಕ್ ಇದ್ರಾಕ್ ಥವ್ನ್ ಘೆವ್ನ್ ಡಬ್ಬ್ ಪಡುನ್ ಆರಾದನ್ ಕರುಚೆ. <verse eid="EZK 46:3" /><verse number="4" style="v" sid="EZK 46:4" />ಸಬ್ಬತಾಚ್ಯಾ ದಿಸಿ ಮುಖಂಡಾನ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಸಾ ಬೊಕ್ಡಾಂಚೆ ಜಾಳ್ವುತಲಿ ಬಲಿ ಅನಿ ಎಕ್ ಟಗ್ರಾಚೆ ಸಗ್ಳೆ ಜಾಳ್ವುತಲಿ ಬಲಿ ಭೆಟ್ವುಚೆ. <verse eid="EZK 46:4" /><verse number="5" style="v" sid="EZK 46:5" />ಟಗ್ರಾಚ್ಯಾ ವಾಂಗ್ಡಾ ತಿಸ್ ಸೆರ್ ಘಂವಾಚೆ ಪಿಟ್ಟ್ ಬೊಕ್ಡಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಕವ್ಡೆ ಹೊತಾ ತವ್ಡೆ ಘಂವಾಚೆ ಪಿಟ್ಟ್ ತಿಸ್ ತಿಸ್ ಸೆರ್ ಘಂವಾಚ್ಯಾ ಪಿಟ್ಟಾಕ್ ಸಾ ಸಾ ಸೆರ್ ತೆಲ್ ಅನಿ ದಾನೆ ಭೆಟ್ವುಚೆ. <verse eid="EZK 46:5" /><verse number="6" style="v" sid="EZK 46:6" />ಅಮ್ಸೆಚ್ಯಾ ದಿಸಿ ತೆನಿ ಪಾಡ್ಯಾಚಿ ಬಲಿ ಅನಿ ಸಾ ಬೊಕ್ಡಾ ಅನಿ ಎಕ್ ಟಗರ್ ಭೆಟ್ವುಚೆ, ತೆಚೆ ಸಗ್ಳೆ ಜಾಳ್ವುತಲಿ ಬಲಿ ಭೆಟ್ವುಚೆ. <verse eid="EZK 46:6" /><verse number="7" style="v" sid="EZK 46:7" />ಅನಿ ಪಾಡ್ಯಾಚ್ಯಾ ವಾಂಗ್ಡಾ ತಿಸ್ ಸೆರ್, ಅನಿ ಟಗ್ರಾಚ್ಯಾ ವಾಂಗ್ಡಾ ತಿಸ್ ಸೆರ್, ಬೊಕ್ಡಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಕವ್ಡೆ ಹೊತಾ ತವ್ಡೆ ಘಂವಾಚೆ ಪಿಟ್ಟ್ ಅನಿ ತಿಸ್ ತಿಸ್ ಸೆರಾಕ್ ಸಾ ಸಾ ಸೆರ್ ಹೊಯ್ ಸಾರ್ಕೆ ತೆಲ್ ಅನಿ ದಾನ್ಯಾಂಚಿ ಬಲಿ ಭೆಟ್ವುಚೆ. <verse eid="EZK 46:7" /><verse number="8" style="v" sid="EZK 46:8" />ಮುಖಂಡ್ ಭುತ್ತುರ್ ಗುಸ್ತಾನಾ, ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ ವಾಟೆನ್ ಗುಸುನ್ ತ್ಯಾಚ್ ವಾಟೆನ್ ಫಾಟಿ ಪರ್‍ತುನ್ ಜಾವ್ಚೊ. <verse eid="EZK 46:8" /><verse number="9" style="v" sid="EZK 46:9" />ತನಿ ಸಗ್ಳಿ ದೆಶಾಚಿ ಲೊಕಾ ಸನಾತ್ನಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ದಿಸ್ತಾನಾ, ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ನಾ ಆರಾದನ್ ಕರುಕ್ ಗುಸಲ್ಲೊ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ನಾ ಭಾಯ್ರ್ ಜಾವ್ಚೊ, ದಕ್ಷಿನ್ ದಿಕ್ಕಾಚ್ಯಾ ವಾಟೆನ್ ಗುಸಲ್ಲೊ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ನಾ ಭಾಯ್ರ್ ಜಾವ್ಚೊ, ಅಪ್ನಿ ಗುಸಲ್ಲ್ಯಾ ದಾರಾನುಚ್ ಫಾಟಿ ಪರ್‍ತಿ ನಸ್ತಾನಾ, ಯೆಲ್ಲ್ಯಾ ವಾಟೆನುಚ್ ಜಾಂವ್ದಿತ್. <verse eid="EZK 46:9" /><verse number="10" style="v" sid="EZK 46:10" />ಲೊಕಾ ಗುಸ್ತಾನಾ, ಮುಖಂಡ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಗುಸುಂದಿತ್, ತೆನಿ ಜಾತಾನಾ ತೊ ಬಿ ಜಾಂವ್ದಿತ್. <verse eid="EZK 46:10" /><verse number="11" style="v" sid="EZK 46:11" />ಮುಖಂಡಾನ್ ಸನಾತ್ನಿ ಅನಿ ಬರ್ಯಾ ದಿಸಾತ್ನಿ ಪಾಡ್ಯಾಚ್ಯಾ ವಾಂಗ್ಡಾ ತಿಸ್ ಸೆರ್ ಅನಿ ಟಗ್ರಾಚ್ಯಾ ವಾಂಗ್ಡಾ ತಿಸ್ ಸೆರ್, ಅನಿ ಬೊಕ್ಡಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಕವ್ಡೆ ಹೊತಾ ತವ್ಡೆ ಘಂವಾಚೆ ಪಿಟ್ಟ್ ತಿಸ್ ಸೆರಾಕ್ ಸಾ ಸಾ ಸೆರ್ ತೆಲ್ ಅನಿ ದಾನ್ಯಾಂಚಿ ಬಲಿ ಭೆಟ್ವುಚೆ. <verse eid="EZK 46:11" /><verse number="12" style="v" sid="EZK 46:12" />ಮುಖಂಡಾನ್ ಅಪ್ನಾಚ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಇಚ್ಚ್ಯಾನ್ ಕಾನಿಕ್ ನಾತರ್ ಸಗ್ಳೆ ಜಾಳ್ವುತಲಿ ಬಲಿ, ನಾತರ್ ಸಮಾಧಾನಾಚಿ ಬಲಿ ಸರ್ವೆಸ್ಪರಾಕ್ ಭೆಟ್ವುತಲೆ ಹೊಲ್ಯಾರ್, ತೆಜ್ಯಾ ಸಾಟ್ನಿ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚೆ ದಾರ್ ಉಗ್ಡುಚೆ, ತೊ ಸಬ್ಬತಾಚ್ಯಾ ದಿಸಿ ಭೆಟ್ವಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಜಾಳ್ವುತಲಿ ಬಲಿ ಅನಿ ಸಮಾಧಾನಾಚಿ ಬಲಿ ಭೆಟ್ವುನ್ ಜಾವ್ಚೊ, ತೊ ಗೆಲ್ಯಾ ಮಾನಾ ದಾರ್ ಧಾಪುಚೆ.<verse eid="EZK 46:12" /></para>
  <para style="s">ಸದ್ದಾಚಿ ಬಲಿ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 46:13" />ತಿಯಾ ಎಕ್ ವರ್ಸಾಚೆ ಬೊಕ್ಡು ಜಾಳ್ವುತಲಿ ಬಲಿ ಸಾಟ್ನಿ ಸದ್ದಾಬಿ ಭೆಟ್ವುಚೆ, ತೆ ಹರ್ ಎಕ್ ದಿಸಾಬಿ ಸಕ್ಕಾಳಿ ಭೆಟ್ವುಚೆ. <verse eid="EZK 46:13" /><verse number="14" style="v" sid="EZK 46:14" />ತೆಜ್ಯಾ ವಾಂಗ್ಡಾ ಹರ್ ಎಕ್ ದಿಸಾಬಿ ಸಕ್ಕಾಳಿ ದಾನ್ಯಾಂಚ್ಯಾ ಬಲಿಕ್ ಪಾಂಚ್ ಸೆರ್ ಘಂವಾಚೆ ಪಿಟ್ಟ್ ಅನಿ ತೆ ಮ್ಹಳುಕ್ ದೊನ್ ಸೆರ್ ತೆಲ್ ಭೆಟ್ವುಚೆ, ಹೆ ಸಗ್ಳೆ ಹರ್ ಎಕ್ ದಿಸಾಬಿ ಸರ್ವೆಸ್ಪರಾಕ್ ದಾನ್ಯಾಂಚಿ ಬಲಿ ಕರುನ್ ಭೆಟ್ವುಚೆ. ಹ್ಯೊ ಶಾಶ್ವತ್ ನೆಮ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 46:14" /><verse number="15" style="v" sid="EZK 46:15" />ಯಾಜಕಾನಿ ಬೊಕ್ಡು ಅನಿ ದಾನ್ಯಾಂಚಿ ಬಲಿ ಅನಿ ತೆಲ್ ಹರ್ ದಿಸಾಚಿ ಸಗ್ಳೆ ಜಾಳ್ವುತಲಿ ಬಲಿ ಕರುನ್ ಸದ್ದಾ ಸಕ್ಕಾಳಿ ಭೆಟ್ವುಚೆ.<verse eid="EZK 46:15" /></para>
  <para style="s">ಮುಖಂಡಾ ಅನಿ ಜಾಗೊ</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 46:16" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಮುಖಂಡಾನ್ ಅಪ್ನಾಚ್ಯಾ ಲೆಕಾತ್ನಿ ಎಕ್ಲ್ಯಾಕ್ ಜಿಮಿನ್ ದಿಲ್ಯಾರ್ ತೆ ಬಾಬಾಚಿ ಆಸ್ತಿ ಹೊಲ್ಲಿ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ಪೊರಾಕ್ನಿಬಿ ವಾಟೊ ಗಾವ್ತಾ. ತಿ ವಾಟೆಕ್ ಗಾವಲ್ಲಿ ಆಸ್ತಿ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 46:16" /><verse number="17" style="v" sid="EZK 46:17" />ಖರೆ ಮುಖಂಡಾನ್ ಅಪ್ನಾಚ್ಯಾ ಸೆವಕಾತ್ನಿ ಎಕ್ಲ್ಯಾಕ್ ದಾನ್ ಕರಲ್ಲೆ ಹೊಲ್ಯಾರ್, ಸಾತ್ ವರ್ಸಾ ಪತರ್ಬಿ ತೆ ತೆಜ್ಯಾ ತಾಬೆತ್ ರ್‍ಹಾತಾ, ಖರೆ ಮುಖಂಡಾನ್ ಅಪ್ನಾಚ್ಯಾ ಲೆಕಾಕ್ನಿ ದಿಲ್ಲಿ ಜಿಮಿನ್ ತೆಂಚ್ಯಾಚ್ ತಾಬೆತ್ ರ್‍ಹಾತಾ. <verse eid="EZK 46:17" /><verse number="18" style="v" sid="EZK 46:18" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಮುಖಂಡಾನ್ ಅಪ್ನಾಚ್ಯಾ ಲೆಕಾಂಚಿ ಬಾಬಾಕ್ನಾ ಯೆಲ್ಲಿ ಆಸ್ತಿ ಸ್ವತಾಕ್ ಕರುನ್ ಘೆವ್ನ್, ತೆಂಚೊ ಹಕ್ಕ್ ಕಾಡುನ್ ಘೆವ್ಚೆ ನ್ಹಯ್, ತೆನಿ ಅಪ್ನಾಚಿ ಸ್ವತಾಚಿ ಜಿಮಿನ್ ವಾಟೆ ಕರುನ್ ಲೆಕಾಕ್ನಿ ದಿವ್ಚೆ, ನಾ ಹೊಲ್ಯಾರ್ ತೆಜ್ಯಾ ಲೆಕಾತ್ನಿ ಹರ್ ಎಕ್ಲೊಬಿ ಅಪ್ನಾ ಅಪ್ನಾಚಿ ಜಿಮಿನ್ ಕಳ್ದುನ್ ಘೆವ್ನ್ ದಿಕ್ಕಾನ್ ದಿವಾಳಿ ಹೊವ್ನ್ ಜಾಯ್ಲ್.<verse eid="EZK 46:18" /></para>
  <para style="s">ಗುಡಿಚಿ ರಾಂದ್ತಲಿ ಖೊನ್</para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 46:19" />ಮಾನಾ ತ್ಯಾ ಮಾನ್ಸಾನ್ ಮಾಕಾ, ಮುಖ್ಯ್ ದಾರಾಚ್ಯಾ ಜಗ್ಗೊಳ್ಲ್ಯಾ ಗುಸ್ತಲ್ಯಾ ವಾಟೆನ್ ಉತ್ತರಾಕ್ ದಿಕ್ಕಾಕ್ ತೊಂಡ್ ಕರುನ್ ಯಾಜಕಾಕ್ನಿ ಮನುನ್ ನೆಮ್ಸುನ್ ಥವಲ್ಲ್ಯಾ ನಿತಳ್ ಖೊಲಿಕ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್. ಅಬಕ್ ತೆಜ್ಯಾ ಫಾಟಿಕ್ಡೆ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಎಕ್ ಜಾಗೊ ಹೊತ್ತೊ. <verse eid="EZK 46:19" /><verse number="20" style="v" sid="EZK 46:20" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ, ಯಾಜಕಾನಿ ಮಾಂಸ್ ಸಿಜ್ವುತಲೊ ಜಾಗೊ ತಯಾರ್ ಹೊಲಾ. ಥೈ ಲೊಕಾಕ್ನಿ ನಿತಳ್ ಕರಿನಾ ಸಾರ್ಕೆ ಪಶ್ಚಾತಾಪಾಚ್ಯಾ ಅನಿ ಪಾಪ್ ಮಾಪಿಚ್ಯಾ ಬಲಿಚ್ಯಾ ಜನಾವರಾಚೆ ಮಾಂಸ್ ಸಿಜ್ವುಕ್ ಅನಿ ದಾನ್ಯಾಂಚಿ ಬಲಿಯಾ ತಯಾರ್ ಕರುಕ್ ಹೊತಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="EZK 46:20" /><verse number="21" style="v" sid="EZK 46:21" />ತೆಜ್ಯಾ ಮಾನಾ ತೆನಿ ಮಾಕಾ ಭಾಯ್ಲ್ಯಾ ಖೊಲಿಕ್ ಬಲ್ವುನ್ ಹಾನುನ್, ಥೈತ್ಲ್ಯಾ ಚಾರಿ ಮುಲ್ಲ್ಯಾಂಚ್ಯಾ ವಾಟೆನ್ ಬಲ್ವುನ್ ನ್ಹೆಲ್ಯಾನ್, ಅಬಕ್ ಖೊಲಿಚ್ಯಾ ಹರ್ ಎಕ್ ಮುಲ್ಲ್ಯಾತ್ ಎಕೆಕ್ ಭುತ್ತುರ್ಲೆ ದಾರ್ ದಿಸ್ಲೆ. <verse eid="EZK 46:21" /><verse number="22" style="v" sid="EZK 46:22" />ಹೊಯ್, ಖೊಲಿಚ್ಯಾ ಚಾರಿ ಮುಲ್ಲ್ಯಾತ್ನಿಬಿ ಇಸ್ ಹಾತ್ ಲಾಂಬಿ, ಅನಿ ಪಂದ್ರಾ ಹಾತ್ ರುಂದಿ ದುಸ್ರಿಚ್ ಅಂಗ್ನಾ ಹೊತ್ತಿ, ಮುಲ್ಲ್ಯಾತ್ನಿ ಚಾರಿ ಅಂಗ್ನಾಬಿ ಎಕುಚ್ ಮಾಪಾಚಿ ಹೊವ್ನ್ ಹೊತ್ತಿ. <verse eid="EZK 46:22" /><verse number="23" style="v" sid="EZK 46:23" />ತೆಂಚ್ಯಾ ಭುತ್ತುರ್ ಭೊತ್ಯಾನಿ ಮಟ್ಲ್ಯಾರ್, ತ್ಯಾ ಚಾರಿ ದಾರಾಂಚ್ಯಾ ಭೊತ್ಯಾನಿಬಿ ಗುಂಡೊ ವಟ್ಕುನ್ ಥವಲ್ಲೆ ಹೊತ್ತೆ, ತೆಜ್ಯಾ ಖಾಲ್ತಿ ಭೊತ್ಯಾನ್ ಚುಲಿಯಾ ಭಾಂದಲ್ಲಿ ಹೊತ್ತಿ. <verse eid="EZK 46:23" /><verse number="24" style="v" sid="EZK 46:24" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ, ಹೆ ಗುಡಿಚ್ಯಾ ಸೆವಕಾನಿ ಬಲಿಚಿ ಜನಾವರಾ ಹಾನಲ್ಲ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ತೆನಿ ಹಾನಲ್ಲೆ ಮಾಂಸ್ ಸಿಜ್ವುತಲಿ ಕೊನಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="EZK 46:24" /></para>
  <chapter eid="EZK 46" />
  <chapter number="47" style="c" sid="EZK 47" />
  <para style="s">ಗುಡಿಕ್ನಾ ಹಂವ್ತಲೊ ಝರು</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 47:1" />ಮಾನಾ ತೆನಿ ಅನಿ ಪರ್‍ತುನ್ ಮಾಕಾ ಗುಡಿಚ್ಯಾ ದಾರಾಕ್ಡೆ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್, ಆಹಾ, ಗುಡಿಚ್ಯಾ ಪಯ್ರಿಯಾಂಚ್ಯಾ ಮುಳಾತ್ನಾ ಪಾನಿ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಹೊಂವ್ಕ್ ಲಾಗಲ್ಲೆ. ತೆ ಪಾನಿ ಗುಡಿಚ್ಯಾ ಉಜ್ವ್ಯಾಕ್ ಖಾಲ್ತಿ ಜಾವ್ನ್ ಬಲಿಚ್ಯಾ ಅಲ್ತಾರಿಚ್ಯಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ಹೊಂವ್ಕ್ ಲಾಗಲ್ಲೆ. <verse eid="EZK 47:1" /><verse number="2" style="v" sid="EZK 47:2" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಚ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಕ್ನಾ ಗುಡಿಚ್ಯಾ ಭಾಯ್ಲ್ಯಾ ವಾಟೆನ್ ಫಿರ್ವುನ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ಮುಖ್ಯ್ ದಾರಾಕ್ಡೆ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್, ಥೈ ಬಗ್ತಾನಾ ತೆಜ್ಯಾ ಉಜ್ವ್ಯಾಭಾಜುಕ್ ಸಾವ್ಕಾ ಸಾವ್ಕಾಸ್ ಹೊಂವ್ತಲೆ ಪಾನಿ ದಿಸ್ಲೆ. <verse eid="EZK 47:2" /><verse number="3" style="v" sid="EZK 47:3" />ತ್ಯಾ ಘವ್ಮಾನ್ಸಾನ್ ಹಾತಿತ್ ಎಕ್ ದೊರಿ ಧರುನ್ಗೆವ್ನ್, ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಜಾವ್ನ್ ಗೆತ್ ಪಾಸ್ಸೆ ಹಾತ್ ಮೆಜುನ್ ಮಾಕಾ ಪಾನಿಯಾಚ್ಯಾ ತಿಕ್ಡಿನ್ ದಾಟ್ವುಲ್ಯಾನ್, ಥೈ ಪಾಂಯಾ ಬುಡಿ ಸಾರ್ಕೆ ತವ್ಡೆ ಪಾನಿ ಹೊತ್ತೆ. <verse eid="EZK 47:3" /><verse number="4" style="v" sid="EZK 47:4" />ತೆನಿ ಪರ್‍ತುನ್ ಪಾಸ್ಸೆ ಹಾತ್ ಮೆಜುನ್ ಮಾಕಾ ಪಾನಿಯಾಚ್ಯಾ ತಿಕ್ಡಿನ್ ದಾಟ್ವುತಾನಾ, ತೆ ಪಾನಿ ಡೊಗ್ಲಾ ಪತರ್ ಹೊತ್ತೆ, ತೆನಿ ಪರ್‍ತುನ್ ಪಾಸ್ಸೆ ಹಾತ್ ಮೆಜುನ್ ಮಾಕಾ ದಾಟ್ವುತಾನಾ, ತೆ ಪಾನಿ ಕಂಬ್ರೆಕ್ ಪಾವಲ್ಲೆ ಹೊತ್ತೆ. <verse eid="EZK 47:4" /><verse number="5" style="v" sid="EZK 47:5" />ತೆನಿ ಅನಿಬಿ ಪರ್‍ತುನ್ ಪಾಸ್ಸೆ ಹಾತ್ ಮೆಜ್ಲ್ಯಾನ್, ತೆ ಮಾಜೆಕ್ನಾ ದಾಟುಕ್ ಹೊವ್ನಸಲೊ ನ್ಹಯ್ ಹೊಲ್ಲೊ. <verse eid="EZK 47:5" /><verse number="6" style="v" sid="EZK 47:6" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ, “ನರ್ ಮಾನ್ಸಾ ಹೆ ಬಗಟ್ಲೆಯ್ ಕಾಯ್”? ಮನುನ್ ಸಾಂಗುನ್ ಮಾಕಾ ಕೊಡ್ಲಾಚ್ಯಾ ದಂಡೆಕ್ ಚಡ್ವುನ್ ಫಾಟಿ ಪರ್‍ತುನ್ ಹಾನ್ಲ್ಯಾನ್.<verse eid="EZK 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 47:7" />ಮಿಯಾ ಫಾಟಿ ಪರ್‍ತುನ್ ಬಗ್ತಾನಾ ಆಹಾ, ನ್ಹಯಚ್ಯಾ ದೊನಿ ದಂಡೆ ವಯ್ನಿಬಿ ಲೈ ಝಾಡಾ ದಿಸ್ಲಿ. <verse eid="EZK 47:7" /><verse number="8" style="v" sid="EZK 47:8" />ತನ್ನಾ ತೆನಿ ಮಾಕಾ ಅಸೆ ಮಟ್ಲ್ಯಾನ್, ಹ್ಯೊ ಹಂವಾರೊ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ಪ್ರಾಂತ್ಯಾಕ್ನಾ ಸುಟುನ್ ಅರಬಾ ಖಡ್ಡ್ಯಾತ್ ಉತ್ರುನ್ ಮರ್ನಾಚ್ಯಾ ಸಮುಂದರಾಕ್ಡೆ ಹೊಂವ್ತಾ, ಗುಡಿಕ್ನಾ ಜಾವ್ಕ್ ಲಾಗಲ್ಲೊ ಹಂವಾರೊ ಲವನ್ ಸಮುಂದರಾಕ್ ಪಾವಲ್ಲ್ಯಾ ತನ್ನಾ ತೆಚೆ ಪಾನಿ ಗೊಡ್ ಹೊತಾ. <verse eid="EZK 47:8" /><verse number="9" style="v" sid="EZK 47:9" />ಹ್ಯೊ ನ್ಹಯ್ ಹೊಂವ್ತಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಜಾಗ್ಯಾ ವಯ್ನಿಬಿ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಫಿರುನ್ ಖೆಳ್ತಲಿ ಪಾನಿಯಾತ್ಲಿ ಜನಾವರಾ ತಾಂಡೆ ತಾಂಡೆ ಹೊವ್ನ್ ವಸ್ತಿ ರ್‍ಹಾತ್ಯಾತ್, ಅನಿ ಮಾಸೊಳಿಯಾಬಿ ತಾಂಡೆ ತಾಂಡೆ ಹೊವ್ನ್ ರ್‍ಹಾತ್ಯಾತ್. ಹೆ ಪಾನಿ ಸಮುಂದರಾತ್ ಪಡ್ತಾನಾ ತೆ ಪಾನಿ ಗೊಡ್ ಹೊತಾ, ಹ್ಯೊ ನ್ಹಯ್ ಹಂವ್ತಲ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ಡೆಬಿ ಥೈ ಜಿವಿ ರ್‍ಹಾತಾ. <verse eid="EZK 47:9" /><verse number="10" style="v" sid="EZK 47:10" />ತನ್ನಾ ಮ್ರತ್ಯು ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆ ವರ್‍ತಿ ಭೊಂಯಿ ಇಬೆ ರ್‍ಹಾತ್ಯಾತ್, ಅನಿ ಎನ್ ಗೆದಿಕ್ನಾ ಎನ್ ಎಗ್ಲ್ಯಿಮಿನ್ ಪತರ್ ಫುರಾ ದಂಡೆ ವರ್‍ತಿ ಜಾಳಿ ಹಾತರ್ತಲೊ ಜಾಗೊ ಹೊತಾ, ನಾನಾ ನಮುನ್ಯಾಚಿ ಮಾಸೊಳ್ಯಾ ಮೆಡಿಟರೆನಿನ್ ಸಮುಂದರಾಚ್ಯಾ ಮಾಸೊಳಿಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ತೆಂಕಾ ತಾಂಡೆ ತಾಂಡೆ ಹೊವ್ನ್ ಗಾವ್ಲಿ. <verse eid="EZK 47:10" /><verse number="11" style="v" sid="EZK 47:11" />ಖರೆ ತೆಜ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ಜವ್ಳ್ ಜಿಮಿನ್ ಅನಿ ಸವ್ಳ್ ಪಾನಿಯಾಚಿ ಫೊಂಡಾ ಗೊಡ್ ಹೊಯ್ನಾತ್, ತೆ ಮಿಟ್ಟಾಚೊ ಖಳೆ ಹೊತಾ. <verse eid="EZK 47:11" /><verse number="12" style="v" sid="EZK 47:12" />ನ್ಹಯಚ್ಯಾ ದೊನಿ ಭಾಜುಚ್ಯಾ ದಂಡೆಕ್ನಿಬಿ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಹನ್ನಾಚಿ ಝಾಡಾ ಉಗಾವ್ತಾತ್, ತೆಂಚಿ ಪಾನಾ ಬಾಡಿ ನಾತ್, ಫಳಾಬಿ ಸರಿನ್ಯಾತ್, ಕೊಡ್ಲಾಚೆ ಪಾನಿ ಪವಿತ್ರ್ ಗುಡಿಕ್ನಾ ಹೊಂವ್ನ್ ಯೆತಲ್ಯಾ ಸಾಟ್ನಿ, ಹರ್ ಎಕ್ ಮ್ಹಯ್ನ್ಯಾಕ್ಬಿ ತಿ ಝಾಡಾ ನ್ಹವೆ ಫಳ್ ದಿತಾತ್, ತೆಂಚೆ ಫಳ್ ಖಾವ್ಕ್ ಅನಿ ಪಾಲೊ ವಕ್ತಾಕ್ ಅನ್ಕುಲ್ ಹೊತಾ.<verse eid="EZK 47:12" /></para>
  <para style="s">ಇಜ್ರಾಯೆಲ್ ದೆಶಾಚಿ ಹದ್ದ್</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 47:13" />ಸರ್ವೆಸ್ಪರ್ ಅಸೊ ಮನ್ತಾ, ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಬಾರಾ ಕುಳಿಯಾಕ್ನಿ ದೆಶ್ ವಾಟೆ ಕರುನ್ ದಿತಾನಾ, ಫಿಡೆ ಸಾಂಗಲ್ಲಿ ನೆಮಾ ವಾಪ್ರುಚೆ, ಯೊಸೆಪಿಕ್ ದೊನ್ ವಾಟೆ ಮಟ್ಲ್ಯಾರ್, ಮನಸ್ಸೆ ಅನಿ ಎಪ್ರಾಯಿಮಾಚ್ಯಾ ಕುಳಿಯಾಕ್ನಿ ಎಕೆಕ್ ಭಾಗ್ ಗಾವ್ಚೆ. <verse eid="EZK 47:13" /><verse number="14" style="v" sid="EZK 47:14" />ಮಿಯಾ ತುಮ್ಚ್ಯಾ ಪುರ್ವಜಾಕ್ನಿ ಆನ್ ಘಾಲುನ್ ಗೊಸ್ಟ್ ದಿಲ್ಲೊ ಹ್ಯೊ ದೆಶ್ ತುಮಿ ಸಗ್ಳ್ಯಾನಿ ಸಮಾಚ್ ವಾಟುನ್ ಘೆತ್ಯಾಸಿ, ಹೆ ತುಮ್ಚಿಚ್ ಆಸ್ತಿ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="EZK 47:14" /><verse number="15" style="v" sid="EZK 47:15" />ತುಮ್ಚ್ಯಾ ದೆಶಾಚಿ ಹದ್ದಾ ಅಸಿ ರ್‍ಹಾವ್ಚಿ, ದಕ್ಷಿನ್ ದಿಕ್ಕಾಚಿ ಹದ್ದ್ ಮೊಟ್ಟ್ಯಾ ಸಮುಂದರಾಕ್ನಾ ಶುರು ಹೊವ್ನ್ ಚೆದಾದಿಚ್ಯಾ ವಾಟೆ ವಯ್ಲ್ಯಾ ಹೆತ್ಲೊನಿಚ್ಯಾ ವಾಟೆನ್ ಎತಾ. <verse eid="EZK 47:15" /><verse number="16" style="v" sid="EZK 47:16" />ಅನಿ ಹಮಾತ್, ಬೆರೊತ್, ದಮಸ್ಕಾಚ್ಯಾ ಘಡಿಕ್ ಅನಿ ಹಾಮಾತಿಚ್ಯಾ ಘಡಿಕ್ ಮದ್ದಿ ಹೊತ್ತ್ಯಾ ಸಿಬ್ರಯಿಮ್ ಮನ್ತಲ್ಯಾ ಗಾಂವಾಂಚ್ಯಾಕ್ನಾ ಹವ್ರಾನಿಚ್ಯಾ ಹದ್ದಿಚ್ಯಾ ಜಗ್ಗೊಳ್ಲ್ಯಾ ಹೆಚೆರ್ ಹತ್ತಿಕೊನಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ಸರುಚಿ. <verse eid="EZK 47:16" /><verse number="17" style="v" sid="EZK 47:17" />ಅಸಿ ಉತ್ತರ್ ದಿಕ್ಕಾಚಿ ಘಡ್ ಸಮುಂದರಾಕ್ನಾ ದಮಸ್ಕಾಚ್ಯಾ ಘಡಿಕ್ಡೆ ಹೊತ್ತ್ಯಾ ಹಚರ್ ಆಯ್ನೊವಿಚ್ಯಾ ಪತರ್ ವಾಡ್ತಾ, ತೆಜ್ಯಾ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ ಹಮಾತಿಚೆ ಪ್ರಾಂತ್ಯಾ ರ್‍ಹಾತಾ. <verse eid="EZK 47:17" /><verse number="18" style="v" sid="EZK 47:18" />ಹಿಚ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚಿ ಘಡ್ ಹೊವ್ನ್ ಹಾಯ್. ಹವ್ರಾನ್, ದಮಸ್ಕ್, ಗಿಲಾದ್ ಹೆಂಚ್ಯಾ ಅನಿ ಇಜ್ರಾಯೆಲ್ ದೆಶಾಚ್ಯಾ ಮದ್ದಿ ಹೊತ್ತ್ಯಾ ಜೊರ್ದಾನ್ ನ್ಹಯ್ ಹದ್ದ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 47:18" /><verse number="19" style="v" sid="EZK 47:19" />ದಕ್ಷಿನಾ ದಿಕ್ಕಾಚಿ ಘಡ್ ತಾಮಾರಿಕ್ನಾ ಜಾವ್ನ್ ಮೆರಿಬೊತ್ ಕಾದೆಶಿಚ್ಯಾ ನ್ಹಯಿಕ್ನಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಪಿಡ್ಲ್ಯಾ ನ್ಹಯಚ್ಯಾ ವಾಟೆನ್, ಮುಖ್ಯ್ ಸಮುಂದರಾಕ್ ಪಾವ್ಚಿ, ಹಿಚ್ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಚಿ ಹದ್ದ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 47:19" /><verse number="20" style="v" sid="EZK 47:20" />ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಚಿ ಘಡ್ ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ಘಡಿಕ್ನಾ ಹಾಮಾತಿಚ್ಯಾ ವಾಟೆಚ್ಯಾ ಇದ್ರಾಕ್ ಹೊತ್ತ್ಯಾ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆ ಪತರ್ ಮೊಟೆ ಸಮುಂದರ್ ಘಡ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಚಿ ಘಡ್ ಹಿಚ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EZK 47:20" /><verse number="21" style="v" sid="EZK 47:21" />ಹ್ಯೊ ದೆಶ್ ತುಮಿ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಹರ್ ಎಕ್ ಕುಳಿಕ್ ವಾಟುನ್ ಘೆವ್ಚೆ.<verse eid="EZK 47:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 47:22" />ತುಮ್ಚ್ಯಾ ಮದ್ದಿ ಪರ್ವಾಸಾಕ್ ಪೊರಾ ಹೊತ್ತ್ಯಾ ದುಸ್ರ್ಯಾ ದೆಶಾಚ್ಯಾಕ್ನಿಬಿ ದೆಶ್ ವಾಟೆ ಕರುನ್ ದಿವ್ಚೆ, ತೆನಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಮದ್ದಿ ತುಮ್ಕಾ ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಶಾಚೆ ಸಾರ್ಕೆಚ್ ಹೊವ್ನ್ ರ್‍ಹಾವ್ಚೆ, ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಕುಳಿಚ್ಯಾ ವಾಂಗ್ಡಾ ತುಮ್ಚ್ಯಾ ಸಾರ್ಕೆಚ್ ತೆಂಕಾಬಿ ಆಸ್ತಿ ರ್‍ಹಾವ್ಚಿ. <verse eid="EZK 47:22" /><verse number="23" style="v" sid="EZK 47:23" />ಖಲ್ಯಾ ಕುಳಿತ್ ದುಸ್ರ್ಯಾ ದೆಶಾಚೊ ರ್‍ಹಾತಾ, ತೆಕಾ ಥೈ ಆಸ್ತಿ ರ್‍ಹಾವ್ಚಿ, ಹೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 47:23" /></para>
  <chapter eid="EZK 47" />
  <chapter number="48" style="c" sid="EZK 48" />
  <para style="s">ಕುಳಿಚ್ಯಾ ಮದ್ದಿ ಜಿಮ್ನಿಚೊ ಭಾಗ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 48:1" />ವಾಟೆ ಕರಲ್ಲ್ಯಾ ಆಧಾರಾ ಸಾರ್ಕೆ ಕುಳಿಯಾಂಚಿ ನಾವಾ ಹಿಚ್. ದೆಶಾಚ್ಯಾ ಉತ್ತರಾಕ್ ತವ್ಡೆಚ್ ಹಮಾತ್ ಸಿಮೆಚ್ಯಾ ಜಗ್ಗೊಳ್ ದಾನಿಕ್ ಎಕ್ ವಾಟೊ, ತೆಚಿ ದಿಸ್ ಉಗ್ತಲಿ ದಿಕ್ಕಾಚಿ ಹದ್ದ್ ಹೆತ್ಲೊನಿಚ್ಯಾ ವಾಟೆಚ್ಯಾ ಭಾಜುಕ್ನಾ ಜಾವ್ನ್, ಹಾಮಾತಿಚಿ ವಾಟ್ ದಾಟುನ್ ದಮಸ್ಕಾಚ್ಯಾ ಹದ್ದಾತ್ ರ್‍ಹಾತಲ್ಯಾ ಹಚರ್ ಎನಾನಿಯಾಚ್ಯಾಕ್ನಿ ಪಗಳ್ತಾ. ತೆಚಿ ಭಾಜುವಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ಅನಿ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಂಚ್ಯಾ ಪತರ್ಬಿ ಪಗ್ಳುನ್ ರ್‍ಹಾತಾ. <verse eid="EZK 48:1" /><verse number="2" style="v" sid="EZK 48:2" />ದಾನಿಚ್ಯಾ ಹದ್ದಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಹೊತ್ತ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾ ಪತರ್ ಅಶೆರಾಕ್ ಎಕ್ ವಾಟೊ. <verse eid="EZK 48:2" /><verse number="3" style="v" sid="EZK 48:3" />ಅಶೆರಿಚ್ಯಾ ಹದ್ದಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾ ಪತರ್ ನಪ್ತಾಲಿಕ್ ಎಕ್ ವಾಟೊ. <verse eid="EZK 48:3" /><verse number="4" style="v" sid="EZK 48:4" />ನಪ್ತಾಲಿಚ್ಯಾ ಹದ್ದಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾ ಪತರ್ ಮನಸ್ಸೆಕ್ ಎಕ್ ವಾಟೊ. <verse eid="EZK 48:4" /><verse number="5" style="v" sid="EZK 48:5" />ಮನಸ್ಸೆಚ್ಯಾ ಹದ್ದಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾ ಪತರ್ ಎಪ್ರಾಯಿಮಾಕ್ ಎಕ್ ವಾಟೊ. <verse eid="EZK 48:5" /><verse number="6" style="v" sid="EZK 48:6" />ಎಪ್ರಾಯಿಮಾಚ್ಯಾ ಹದ್ದಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾ ಪತರ್ ರುಬೆನಿಕ್ ಎಕ್ ವಾಟೊ. <verse eid="EZK 48:6" /><verse number="7" style="v" sid="EZK 48:7" />ರುಬೆನಿಚ್ಯಾ ಹದ್ದಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾ ಪತರ್ ಜುದೆವಾಕ್ನಿ ಎಕ್ ವಾಟೊ. <verse eid="EZK 48:7" /><verse number="8" style="v" sid="EZK 48:8" />ಜುದೆವಾಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾ ಪತರ್ ತುಮಿ ಸರ್ವೆಸ್ಪರಾಕ್ ನೆಮ್ಸುನ್ ಭೆಟ್ವುತಲೊ ಎಕ್ ವಾಟೊ ರ್‍ಹಾತಾ, ತೊ ಸಾಡೆಬಾರಾ ಹಾಜರ್ ಹಾತ್ ರುಂದಿ ಅನಿ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಕುಳಿಯಾಕ್ನಿ ದಿಲ್ಲ್ಯಾ ವಾಟ್ಯಾಚ್ಯಾ ತವ್ಡೆಚ್ ಲಾಂಬಿ ರ್‍ಹಾವ್ನ್ ತೆಜ್ಯಾ ಮದ್ದಿ ಪವಿತ್ರ್ ಗುಡಿಚೊ ಜಾಗೊ ರ್‍ಹಾತಾ. <verse eid="EZK 48:8" /><verse number="9" style="v" sid="EZK 48:9" />ತುಮಿ ನೆಮ್ಸುನ್ ಥವಲ್ಲ್ಯಾ ಜಿಮ್ನಿಚ್ಯಾ ಜಾಗ್ಯಾತ್ ಸರ್ವೆಸ್ಪರಾಕ್ ನೆಮ್ಸುನ್ ಭೆಟ್ವುತಲ್ಯಾ ವಾಟ್ಯಾಚೊ ಜಾಗೊ, ಸಾಡೆ ಬಾರಾ ಹಾತ್ ಲಾಂಬಿ ಅನಿ ಪಾಂಚ್ ಹಾಜಾರ್ ಹಾತ್ ರುಂದಿ ರ್‍ಹಾತಾ. <verse eid="EZK 48:9" /><verse number="10" style="v" sid="EZK 48:10" />ನೆಮ್ಸುನ್ ಥವಲ್ಲೊ ತೊ ಪವಿತ್ರ್ ಜಾಗೊ ಯಾಜಕಾಕ್ನಿ ಸಮಂದ್ ಪಡಲ್ಲೊ ರ್‍ಹಾತಾ. ಉತ್ತರಾಕ್ ದಿಕ್ಕಾಕ್ ತೆಚಿ ಲಾಂಬಿ ಸಾಡೆ ಬಾರಾ ಹಾಜಾರ್ ಹಾತ್, ಅನಿ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಪಾಂಚ್ ಹಾಜಾರ್ ಹಾತ್ ರುಂದಿ, ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ತೆಚಿ ರುಂದಿ ಪಾಂಚ್ ಹಾಜಾರ್ ಹಾತ್, ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ತೆಚಿ ಲಾಂಬಿ ಸಾಡೆಬಾರಾ ಹಾಜಾರ್ ಹಾತ್, ಅನಿ ತೆಜ್ಯಾ ಮದ್ದಿ ಸರ್ವೆಸ್ಪರಾಚಿ ಪವಿತ್ರ್ ಗುಡಿ ರ್‍ಹಾತಾ. <verse eid="EZK 48:10" /><verse number="11" style="v" sid="EZK 48:11" />ತೊ ಜಾಗೊ ಚಾದೊಕಾಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ಅನಿ ಮಾಜ್ಯಾ ಸಾಟ್ನಿ ಯೆಚುನ್ ಕಾಡಲ್ಲ್ಯಾ ಮಾಜ್ಯಾ ಗುಡಿಕ್ ಬಗುನ್ ಘೆತಲ್ಯಾ ಯಾಜಕಾಕ್ನಿ ಪಾವ್ಚೆ ಹೊಲ್ಲೆ ಹಾಯ್, ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಮಾಕಾ ಧುರ್ ಕರಲ್ಲ್ಯಾ ತನ್ನಾ ಲೆವಿನಿ ಕರಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಹೆನಿ ಕರುಕ್ನಾತ್ ನ್ಹಯ್. <verse eid="EZK 48:11" /><verse number="12" style="v" sid="EZK 48:12" />ಲೆವಿಚ್ಯಾ ಕುಳಿಚ್ಯಾ ವಾಟ್ಯಾಚ್ಯಾ ಹದ್ದಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಹೊತ್ತೊ ತೊ ಜಾಗೊ ಅಗ್ದಿ ಪವಿತ್ರ್ ಅನಿ ದೆಸಾತ್ ಎಚುನ್ ಕಾಡಲ್ಯಾತುಚ್ ಎಚುನ್ ಕಾಡಲ್ಲೊ ಜಾಗೊ ಮಾಕಾ ಸಮಂದ್ ಪಡಲ್ಲೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="EZK 48:12" /><verse number="13" style="v" sid="EZK 48:13" />ಅನಿ ಸಾಡೆಬಾರಾ ಹಾಜಾರ್ ಹಾತ್ ಲಾಂಬಿ, ಅನಿ ಪಾಂಚ್ ಹಾಜಾರ್ ಹಾತ್ ರುಂದ್ ಎಕ್ ವಾಟೊ ಯಾಜಕಾಂಚ್ಯಾ ವಾಟ್ಯಾಚ್ಯಾ ಘಡಿಕ್ ಲಾಗುನ್ ಲೆವಿಚ್ಯಾ ಕುಳಿಚ್ಯಾ ವಾಟ್ಯಾಕ್ ಯೆತಾ. ಹ್ಯಾ ದೊನಿ ವಾಟ್ಯಾಂಚಿ ಸಗ್ಳಿ ಮೆಜ್ನಿ ಕವ್ಡಿ ಮಟ್ಲ್ಯಾರ್, ಲಾಂಬಿ ಸಾಡೆ ಬಾರಾ ಹಾಜಾರ್ ಹಾತ್, ರುಂದಿ ಧಾ ಹಜಾರ್ ಹಾತ್. <verse eid="EZK 48:13" /><verse number="14" style="v" sid="EZK 48:14" />ತೊ ಜಾಗೊ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ವಾಟ್ಯಾಕ್ ಕಾಡುನ್ ಥವಲ್ಲೊ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ತ್ಯಾತುರ್ ಖಲೊ ಭಾಗ್ ಬಿ ಇಕಾತ್ ದಿತಲೆ ನಕ್ಕೊ, ಸದ್ಲಾ ಬದ್ಲಿ ಕರ್‍ತಲೆ ನಕ್ಕೊ, ದೆಶಾಚೊ ತೊ ಬರೊ ಭಾಗ್ದುಶ್ಯಾಂಚೊ ವಾಟೊ ಹೊತಲೆ ನಕ್ಕೊ. <verse eid="EZK 48:14" /><verse number="15" style="v" sid="EZK 48:15" />ಸಾಡೆ ಬಾರಾ ಹಾಜಾರ್ ಹಾತ್ ಲಾಂಬಿ ತ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ಜಗ್ಗೊಳ್, ಕಾಡುನ್ ಥವಲ್ಲ್ಯಾ ಒಟ್ಟು ಜಾಗ್ಯಾತ್ ಹುರಲ್ಲ್ಯಾ ಸಾಡೆ ದೊನ್ ಹಾಜಾರ್ ಹಾತ್ ರುಂದಿ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ ಎಚುನ್ ಕಾಡುನ್ ಥವಲ್ಲೊ ನ್ಹಯ್ ಮನುನ್ ಚಿಂತುನ್, ಶಾರ್ ಮಟ್ಲ್ಯಾರ್, ಲೊಕಾಂಚ್ಯಾ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಅನಿ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ಜಾಗ್ಯಾಕ್ಬಿ ಎಚುನ್ ಕಾಡುನ್ ಥವ್ನ್ ಹೊವ್ಚೆ, ಶಾರ್ ತೆಜ್ಯಾ ಮದ್ದಿ ರ್‍ಹಾವ್ಚಿ. <verse eid="EZK 48:15" /><verse number="16" style="v" sid="EZK 48:16" />ಶಾರಾಚಿ ಮಾಪ್ ಅಸೆ ರ್‍ಹಾವ್ಚೆ, ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ನಾ ದೊನ್ ಹಾಜಾರ್ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್, ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ದೊನ್ ಹಾಜಾರ್ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್, ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ದೊನ್ ಹಾಜಾರ್ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್, ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ದೊನ್ ಹಾಜಾರ್ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್. <verse eid="EZK 48:16" /><verse number="17" style="v" sid="EZK 48:17" />ಶಾರಾಕ್ ಭೊತ್ಯಾನಿ ಜಾಗೊ ರ್‍ಹಾವ್ಚೆ. ತೆಚಿ ಲಾಂಬಿ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ ಎಕ್ಸೆ ಪಂಚಿಸ್ ಹಾತ್, ದಕ್ಷಿನಾಕ್ ಎಕ್ಸೆ ಪಂಚಿಸ್ ಹಾತ್, ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಪಂಚಿಸ್ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಎಕ್ಸೆ ಪಂಚಿಸ್ ಹಾತ್ ರ್‍ಹಾವ್ಚೆ. <verse eid="EZK 48:17" /><verse number="18" style="v" sid="EZK 48:18" />ಶಾರಾಕ್ ಸೊಡುನ್ ತೆಕಾ ಸಂಮಂದ್ ಪಡಲ್ಲಿ ಹುರಲ್ಲಿ ಜಿಮ್ನಿಚೆ ಲಾಂಬಿ ಎಚುನ್ ಥವಲ್ಲ್ಯಾ ಪವಿತ್ರ್ ಜಾಗ್ಯಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ಡೆ ಪಾಂಚ್ ಹಾಜಾರ್ ಹಾತ್ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ಡೆ ಪಾಂಚ್ ಹಾಜಾರ್ ಹಾತ್, ತಿ ಜಿಮಿನ್ ಎಚುನ್ ಥವಲ್ಲ್ಯಾ ಜಿಮ್ನಿಚ್ಯಾ ಪವಿತ್ರ್ ಜಾಗ್ಯಾ ಚ್ಯಾ ಹದ್ದಾಕ್ನಾ ಜಾತಾ, ತೆಜ್ಯಾಕ್ಡೆ ಉತ್ಪನ್ ಹೊಲ್ಲೆ ಪಿಕ್ ತ್ಯಾ ಲೊಕಾಕ್ನಿ ಜೆವ್ನಾಖಾನಾಕ್ ವಾಪ್ರುಕ್ ಹೊತಾ. <verse eid="EZK 48:18" /><verse number="19" style="v" sid="EZK 48:19" />ತೆನಿ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಖಲ್ಯಾ ಕುಳಿಚೆ ಹೊಲ್ಯಾರ್ಬಿ ಶಾರ್‍ಹಾತ್ ವಸ್ತಿ ರ್‍ಹಾವ್ನ್, ತಿ ಜಿಮ್ನಿತ್ ಸೆತ್ ಕರುನ್ ಖಾತಾತ್. <verse eid="EZK 48:19" /><verse number="20" style="v" sid="EZK 48:20" />ನೆಮ್ಸುನ್ ಥವಲ್ಲ್ಯಾ ಸಗ್ಳೊ ಜಾಗೊ ಸಾಡೆ ಬಾರಾ ಹಾಜಾರ್ ಹಾತ್ ಲಾಂಬಿ ಅನಿ ಸಾಡೆ ಬಾರಾ ಹಾಜಾರ್ ಹಾತ್ ರುಂದಿ, ತಿ ನೆಮ್ಸುನ್ ಥವಲ್ಲಿ ಜಿಮಿನ್ ರಾಜಧಾನಿಕ್ ಸಮಂದ್ ಪಡಲ್ಲ್ಯಾ ಜಿಮ್ನಿ ವಾಂಗ್ಡಾ ಚವ್ಕ್ ರ್‍ಹಾವ್ಚಿ. <verse eid="EZK 48:20" /><verse number="21" style="v" sid="EZK 48:21" />ಎಚುನ್ ಕಾಡಲ್ಲ್ಯಾ ಪವಿತ್ರ್ ಜಾಗ್ಯಾಚ್ಯಾ ಅನಿ ರಾಜಧಾನಿಕ್ ಸಮಂದ್ ಪಡಲ್ಲ್ಯಾ ಜಿಮ್ನಿಚ್ಯಾ ದೊನಿ ಭಾಜುನಿ ಹುರಲ್ಲಿ ಜಿಮಿನ್ ಮುಖಂಡಾಚೊ ವಾಟೊ ಹೊವ್ನ್ ರಾಂವ್ದಿತ್, ತೊ ವಾಟೊ ನೆಮ್ಸುನ್ ಥವಲ್ಲ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಸಾಡೆ ಬಾರಾ ಹಾಜಾರ್ ಹಾತ್ ಲಾಂಬ್ ಹದ್ದಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಅನಿ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ಡೆ ಸಾಡೆ ಬಾರಾ ಹಾಜಾರ್ ಹಾತ್ ಲಾಂಬ್ ಹದ್ದಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಹರ್ ಎಕ್ ಕುಳಿಚ್ಯಾ ವಾಟ್ಯಾಚ್ಯಾ ತವ್ಡೆ ಲಾಂಬ್ ಪಗ್ಳುನ್ ರ್‍ಹಾತಾ, ತೆ ಮುಖಂಡಾಚೊ ವಾಟೊ ಹೊವ್ನ್ ಹಾಯ್, ನೆಮ್ಸುನ್ ಥವಲ್ಲೊ ಪವಿತ್ರ್ ಜಾಗೊ ಅನಿ ಪವಿತ್ರ್ ಗುಡಿ ತೆಜ್ಯಾ ದೊನಿ ಭಾಗಾಂಚ್ಯಾ ಮದ್ದಿ ರ್‍ಹಾತಾ. <verse eid="EZK 48:21" /><verse number="22" style="v" sid="EZK 48:22" />ಮುಖಂಡಾಚ್ಯಾ ವಾಟ್ಯಾಚ್ಯಾ ದೊನಿ ಭಾಗಾಂಚ್ಯಾ ಮದ್ದಿ ಲೆವಿಯಾಂಚ್ಯಾ ವಾಟ್ಯಾಚ್ಯಾ ಘಡಿಕ್ನಾ ಶಾರಾಚಿ ಜಿಮಿನ್ ಘಡಿ ಪತರ್ ಮಟ್ಲ್ಯಾರ್ ಜುದೆವಾಂಚ್ಯಾ ಘಡಿಚ್ಯಾ ಉತ್ತರಾಕ್ನಾ ಬೆನ್ಯಾಮಿನಾಚ್ಯಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಚ್ಯಾ ಘಡಿ ಪತರ್ ಮುಖಂಡಾಚೊ ವಾಟೊ ಪಗ್ಳುನ್ ರ್‍ಹಾತಾ.<verse eid="EZK 48:22" /></para>
  <para style="s">ಹುರಲ್ಲ್ಯಾ ಕುಳಿಯಾಕ್ನಿ ಜಿಮಿನ್</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 48:23" />ಹುರಲ್ಲ್ಯಾ ಕುಳಿಯಾಂಚ್ಯಾ ವಾಟ್ಯಾಚಿ ರಿತ್ ಮಟ್ಲ್ಯಾರ್, ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾ ಪತರ್ ಬೆಂಜ್ಯಾಮಿನಾಚ್ಯಾ ಕುಳಿಕ್ನಿ ಎಕ್ ವಾಟೊ. <verse eid="EZK 48:23" /><verse number="24" style="v" sid="EZK 48:24" />ಬೆನ್ಯಾಮಿನಾಚ್ಯಾ ಹದ್ದಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾ ಪತರ್ ಸಿಮಿಯೊನಾಕ್ ಎಕ್ ವಾಟೊ. <verse eid="EZK 48:24" /><verse number="25" style="v" sid="EZK 48:25" />ಸಿಮಿಯೊನಿಚ್ಯಾ ಹದ್ದಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾ ಪತರ್ ಇಸ್ಸಾಕಾರಾಕ್ ಎಕ್ ವಾಟೊ. <verse eid="EZK 48:25" /><verse number="26" style="v" sid="EZK 48:26" />ಇಸ್ಸಾಕಾರಿಚ್ಯಾ ಹದ್ದಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾ ಪತರ್ ಜೆಬುಲೊನಿಕ್ ಎಕ್ ವಾಟೊ. <verse eid="EZK 48:26" /><verse number="27" style="v" sid="EZK 48:27" />ಜೆಬುಲೊನಿಚ್ಯಾ ಹದ್ದಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾ ಪತರ್ ಗಾದಾಕ್ನಿ ಎಕ್ ವಾಟೊ. <verse eid="EZK 48:27" /><verse number="28" style="v" sid="EZK 48:28" />ಗಾದ್ ಮನ್ತಲ್ಯಾಚ್ಯಾ ಕುಳಿಚ್ಯಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಚ್ಯಾ ಘಡಿಕ್ ದೆಶಾಚಿ ಹದ್ದ್ ತಾಮಾರಿಕ್ನಾ ಸುಟುನ್ ಮೆರಿಬೊತ್ ಕಾದೆಶಿಚಿ ನ್ಹಯ್ ದಾಟುನ್ ಇಜಿಪ್ತಾಚ್ಯಾ ಫಿಡ್ಲೊ ನ್ಹಯಚ್ಯಾ ವಾಟೆನ್ ಮೊಟ್ಟ್ಯಾ ಸಮುಂದರಾಕ್ ಪಾವ್ತಾ. <verse eid="EZK 48:28" /><verse number="29" style="v" sid="EZK 48:29" />ಹೊಚ್ ತುಮಿ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಕುಳಿಯಾಕ್ನಿ ಸ್ವತಾಕ್ ಕರುನ್ ದಿತಲೊ ಜೊಗೊ, ವಾಟುನ್ ದಿವ್ಚೆ ಹೊಲ್ಲೊ ದೆಶಾಚೊ ಇಸಬ್ ಹೊವ್ನ್ ಹಾಯ್, ಕುಳಿಯಾಂಚೊ ವಾಟೊಬಿ ಹೊಚ್, ಅನಿ ಹೆ ಸರ್ವೆಸ್ಪರಾಚೆ ಬೊಲ್ನೆ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EZK 48:29" /></para>
  <para style="s">ಶಾರಾಚೆ ದಡ್ಪೆ</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 48:30" />ಶಾರಾಕ್ನಾ ಬಾರ್ಯ್ ಜಾತಲಿ ವಾಟ್ ಅಸಿ ರ್‍ಹಾವ್ಚಿ, ಆರಂಬಾಕ್ ಉತ್ತರ್ ದಿಕ್ಕಾಚ್ಯಾ ಲಾಂಬಿ ದೊನ್ ಹಾಜಾರ್ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್. <verse eid="EZK 48:30" /><verse number="31" style="v" sid="EZK 48:31" />ಶಾರಾಚ್ಯಾ ದಾರಾಕ್ನಿ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಕುಳಿಯಾಂಚಿ ನಾವಾ ರಾಂವ್ದಿತ್, ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ ತಿನ್ ದಾರಾ, ಎಕ್ ರುಬೆನಾಚೆ ದಡ್ಪೊ, ಅನಿ ಎಕ್ ಜುದಾಚೆ ದಡ್ಪೊ ಅನಿ ಎಕ್ ಲೆವಿಚೆ ದಡ್ಪೊ. <verse eid="EZK 48:31" /><verse number="32" style="v" sid="EZK 48:32" />ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚಿ ಹದ್ದ್ ದೊನ್ ಹಾಜಾರ್ ಎಕ್ಸೆ ಹಾತ್ ಲಾಂಬ್, ಅನಿ ತ್ಯಾತುರ್ ತಿನ್ ದಾರಾ, ಎಕ್ ಜೊಸೆಪಾಚ್ಯಾ ಕುಳಿಚೊ ದಡ್ಪೊ ಅನಿ ಎಕ್ ಬೆನ್ಯಾಮಿನಾಚ್ಯಾ ಕುಳಿಚೊ ದಡ್ಪೊ ಅನಿ ಎಕ್ ದಾನ್ ಮನ್ತಲ್ಯಾಚ್ಯಾ ಕುಳಿಚೊ ದಡ್ಪೊ. <verse eid="EZK 48:32" /><verse number="33" style="v" sid="EZK 48:33" />ದಕ್ಷಿನ್ ದಿಕ್ಕಾಚಿ ಭಾಜು, ದೊನ್ ಹಾಜಾರ್ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್ ಲಾಂಬ್, ತ್ಯಾತುರ್ ತಿನ್ ದಾರಾ ಎಕ್ ಸಿಮೊನಾಚ್ಯಾ ಕುಳಿಚೊ ದಡ್ಪೊ, ಅನಿ ಎಕ್ ಇಸ್ಸಾಕಾರಾಚ್ಯಾ ಕುಳಿಚೊ ದಡ್ಪೊ, ಅನಿ ಎಕ್ ಜೆಬುಲುನಾಚ್ಯಾ ಕುಳಿಚೊ ದಡ್ಪೊ. <verse eid="EZK 48:33" /><verse number="34" style="v" sid="EZK 48:34" />ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಚಿ ಭಾಜು ದೊನ್ ಹಾಜಾರ್ ದೊನ್ಸೆ ಪನ್ನಾಸ್ ಹಾತ್ ಲಾಂಬ್, ತ್ಯಾತುರ್ ತಿನ್ ದಾರಾ, ಎಕ್ ಗಾದ್ ಮನ್ತಲ್ಯಾಚ್ಯಾ ಕುಳಿಚೊ ದಡ್ಪೊ, ಅನಿ ಎಕ್ ಅಶೆರ್ ಮನ್ತಲ್ಯಾಚ್ಯಾ ಕುಳಿಚೊ ದಡ್ಪೊ, ಅನಿ ಎಕ್ ನಪ್ತಾಲಿನಾಚೆ ದಡ್ಪೊ. <verse eid="EZK 48:34" /><verse number="35" style="v" sid="EZK 48:35" />ಶಾರಾಚಿ ಭೊತ್ಯಾನ್ ಮಾಪ್ ನವ್ ಹಾಜಾರ್ ಹಾತ್, ತೆ ತಯಾರ್ ಕರಲ್ಲ್ಯಾಕ್ನಾ ತ್ಯಾ ಶಾರಾಚೆ ನಾವ್ ಯಾವ್ವಾ ಶಮ್ಮಾ ಮಟ್ಲ್ಯಾರ್, “ಸರ್ವೆಸ್ಪರಾಚೊ ರಾತಲೊ ಟಿಕಾನೊ” ಮನುನ್ ನಾವ್ ಹೊತಾ.<verse eid="EZK 48:35" /></para>
  <chapter eid="EZK 48" />
</usx>