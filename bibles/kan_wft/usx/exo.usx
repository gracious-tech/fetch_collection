<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EXO" style="id">Siddi</book>
  <para style="h">ನಿರ್ಗಮನ್</para>
  <para style="toc3">ನಿರ್ಗ</para>
  <para style="toc2">ನಿರ್ಗಮನ್</para>
  <para style="toc1">ನಿರ್ಗಮನ್ ಪುಸ್ತಕ್</para>
  <para style="mt2">ವಿಮೋಚನ ಕಾಂಡ</para>
  <para style="mt1">ನಿರ್ಗಮನ್ ಪುಸ್ತಕ್</para>
  <para style="imt">ವಳಕ್</para>
  <para style="ip">ನಿರ್ಗಮನಾಚ್ಯಾ ಪುಸ್ತಕಾನ್ ಉತ್ಪತ್ತಿಚ್ಯಾ ಪುಸ್ತಕಾತ್ ಶುರುಹೊಲ್ಲ್ಯಾ ಅಬ್ರಾಹಾಮಾಚ್ಯಾ ಕುಟ್ಮಾಚ್ಯಾ ಗೆರ್ಯಾಚೊ ಇತಿಹಾಸ್ ಫಿಡೆ ಘೆವ್ನ್ ಜಾವ್ಕ್ ಲಾಗ್ಲಾ. ನಿರ್ಗಮನ್ ಮನ್ತಲ್ಯಾ ಶಬ್ದಾಚೊ ಅರ್ಥ್ “ಭಾಯ್ರ್ ಪಡ್ತಲೆ”, ಇಜ್ರಾಯೆಲ್ ದೆಶ್ ಇಜಿಪ್ತ್ ದೆಸಾಕ್ ಅಬ್ರಾಹಾಮ್ ಮನ್ತಲ್ಯಾ ಭರೊಸೊ ದಿತಲ್ಯಾ ದೆಸಾಕ್ ಸೊಡ್ಲಾ ಮನುನ್ ದೆಶ್ ಫಾಟಿ ಪರತತಲ್ಯಾ ವಿಶಯಾತ್ ಸಾಂಗ್ತಾ. ಸಂಪ್ರದಾಯಾಚ್ಯಾ ಪರ್ಕಾರ್ ಲೈ ಬುದ್ವಂತಾ ನಿರ್ಗಮನಾಚೆ ಪುಸ್ತಕ್ ಮೊಯ್ಜೆ ಪರ್ವಾದಿನ್ ಲಿವ್ಲಾ ಮನುನ್ ವಿಶ್ವಾಸ್ ಕರ್‍ತಾತ್, ಅನಿ ಹೆ ಪುಸ್ತಕಾತ್ಬಿ ದಿಸುನ್ ಯೆತಾ. ನಿರ್ಗಮನ್ ಪುಸ್ತಕಾಚ್ಯಾ 24 ಅದ್ಯಾಯಾತ್ 4 ವಚನಾತ್ ಉಲ್ಲಿ ಭಾಗಾ ಕಸಿ ಲಿವ್ತಲಿ ಮನುನ್ ಮೊಯ್ಜೆ ಸಾಂಗ್ತಾ. ಜೊಶುವಾ 8 ಅದ್ಯಾಯ್ 31 ವಚನಾತ್, ಹೆ ನಿರ್ಗಮನ್ 20 ಅದ್ಯಾಯ್ 25 ವಚನಾತ್ ಹುಕುಮಾ ದಾಕ್ವುತಾ ಅನಿ ಹೆ “ಮೊಯ್ಜೆಚ್ಯಾ ಪುಸ್ತಕಾತ್ ಲಿವಲ್ಲೆ ಹಾಯ್” ಮನುನ್ ಸಾಂಗ್ತಾ. ನ್ಹವ್ಯಾ ಕರಾರಾತ್ ಹೆ ಪುಸ್ತಕ್ ಮೊಯ್ಜೆನ್ ಲಿವ್ಲಾ ಮನುನ್ ಲೈದಾ ಲಿವಲ್ಲೆ ಹಾಯ್, ಉದಾರ್ನೆಕ್ ಜಳ್ತಲ್ಯಾ ಝಿಳಿತ್ ಕಾಯ್ ಹೊಲೆ ಮನ್ತಲ್ಯಾ ವಿಶಯಾತ್ ಬೊಲ್ತಲೆ ಅನಿ ಹೆ “ದಿ ಬುಕ್ ಆಪ್ ಮೊಯ್ಜೆಸ್” ಮನ್ತಲ್ಯಾ ಪುಸ್ತಕಾತ್ ಲಿವಲ್ಲೆ ಹಾಯ್ (ಮಾರ್ಕಾನ್ ಲಿವಲ್ಲಿ ಬರಿ ಖಬರ್ 12 ಅದ್ಯಾಯ್ 26 ವಚನ್). ಇಜಿಪ್ತಾಕ್ನಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಭಾಯ್ರ್ ಪಡ್ತಲೊ ಎಳ್ ಕ್ರಿಸ್ತ್ ಉಪ್ಜುಚ್ಯಾ ಅದ್ದಿ 1300 ನಾತರ್ 1400. ಪಯ್ಲೆಚ್ಯಾ ರಾಜಾಂಚೆ ಪುಸ್ತಕ್ 6 ಅದ್ಯಾಯ್ 1 ವಚನಾತ್ ಹೆ ನಿರ್ಗಮನ್ ಪುಸ್ತಕ್ ಕ್ರಿಸ್ತ್ ಉಪ್ಜುಚ್ಯಾ ಅದ್ದಿ 480 ವರ್ಸಾಚ್ಯಾ ಅದ್ದಿ ಇಜ್ರಾಯೆಲಾಚೊ ರಾಜಾ ಸೊಲೊಮೊನಾಚ್ಯಾ ರಾಜ್ವಡ್ಕಿಚ್ಯಾ 4 ವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಅದ್ದಿ ಹೊಲ್ಲೆ ಮನುನ್ ದಾಕ್ವುತಾ.</para>
  <para style="ip">ದೆವಾನ್ ಅಪ್ನಾಚೊ ಕರಾರ್ ಅಬ್ರಾಹಾಮ್, ಇಸಾಕ್ ಅನಿ ಜಾಕೊಬಾಕ್ ಕಸೆ ಥವ್ಲಾ ಮನುನ್ ನಿರ್ಗಮನ್ ಪುಸ್ತಕ್ ದಾಕ್ವುನ್ ಹೊತಾ. ಹೆ ಇಜಿಪ್ತ್ ಜಿಮ್ನಿಕ್ನಾ (ನಿರ್ಗಮನ್ 1 ಅದ್ಯಾಯಾಕ್ನಾ 12 ಅದ್ಯಾಯ್) ಅಬ್ರಾಮಾಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾ ಇಜ್ರಾಯೆಲ್ ದೆಸಾಕ್ ದೆವಾಚಿ ಬಳ್ ಸಾಂಗ್ತಾ. ಥೈತ್ನಾ ದೆವಾನ್ ಅಪ್ನಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಸಿನಾಯ್ ಮಡ್ಡಿಚ್ಯಾ ಬುಡಿ ಬಲ್ವುನ್ ನ್ಹೆಲ್ಯಾನ್, ಥೈ ತೆನಿ ಮೊಯ್ಜೆಕ್ ಇಜ್ರಾಯೆಲಾಕ್ನಿ ಪಾಳುನ್ಗೆವ್ನ್ ಜಾವ್ಕ್ ಲೈ ಖಾಯ್ದೆ ದಿಲ್ಯಾನ್ (ನಿರ್ಗಮನ್ 12 ಅದ್ಯಾಯ್ 19 ವಚನ್). ಹೆ ಖಾಯ್ದೆ ತೆನಿ ಕಸೆ ವರ್ತನ್ ಕರುಚೆ, ತೆ ಕಸೆ ಸೊಡುಚೆ ಅನಿ ಬಿಡಾರ್ ಭಾಂದ್ತಲ್ಯಾಚ್ಯಾ ವಿಶಯಾತ್ ವಿವರನ್ ಕರುನ್ ಹೊಲಾ (ತೆ ತ್ಯಾತುರ್ ದೆವಾಚೊ ಜಾಗೊ ಹೊವ್ನ್ ರಾವ್ಚೊ), ಆರ್ಕ್ ಅನಿ ದೆವಾಚ್ಯಾ ಗುಡಿತ್ ಆರಾದನಾಕ್ ಹುರಲ್ಲಿ ಸಾಮಾನಾ ಅನಿ ಭಾಂದ್ಪಾಕ್ ದಿಲ್ಲಿ ಸುಚ್ನಾ ಅನಿ ಯಾಜಕಾಂಚೆ ಕಪ್ಡೆ ತಯಾರ್ ಕರುಕ್ ವಿಶೆಸ್ ಸುಚ್ನಾ (ನಿರ್ಗಮನ್ 20 ಅದ್ಯಾಯಾಕ್ನಾ 31 ಅದ್ಯಾಯ್). ಇಜ್ರಾಯೆಲಾತ್ ವಾಸ್ರಾಚ್ಯಾ ರುಪಾತ್ ಸೊನ್ಯಾಚಿ ಮುರ್ತಿ ಕರಲ್ಲ್ಯಾ ಲೈ ಮೊಟ್ಟ್ಯಾ ಝಗ್ಡ್ಯಾಚ್ಯಾ ಮಾನಾ, ಮೊಯ್ಜೆ ಅನಿ ಪರ್‍ತುನ್ ದೆವಾಕ್ ಭೆಟ್ಲೊ (ನಿರ್ಗಮನ್ 32 ಅದ್ಯಾಯಾಕ್ನಾ 33 ಅದ್ಯಾಯ್). ಪುಸ್ತಕಾಚ್ಯಾ ಆಕ್ರಿಚ್ಯಾ ಭಾಗಾತ್, ಕಸೆ ಸಗ್ಳ್ಯಾ ವಸ್ತಾಕ್ನಿ ವಿವರನ್ ಕರುನ್ ಹೊಲಾ, ಮನುನ್ ಅದ್ದಿಚ್ ವಿವರನ್ ಕರುನ್ ಹೊಲಾ ಮನುನ್ ಅಮಿ ವಾಚ್ತಾಂವ್ (ನಿರ್ಗಮನ್ 33 ಅದ್ಯಾಯಾಕ್ನಾ 40 ಅದ್ಯಾಯ್).</para>
  <para style="iot">ಭಾಗಾ</para>
  <para style="io1">1. ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಇಜಿಪ್ತಾತ್ ಕಸೆ ಗುಲಾಮಾ ಹೊವ್ನ್ ಹೊತ್ತೆ ಮನುನ್ ಸಾಂಗ್ತಾ. <char style="ior"><ref loc="EXO 1">1</ref> </char></para>
  <para style="io1">2. ಮೊಯ್ಜೆಚಿ ವಳಕ್ ಕರುನ್ ದಿತಾ ಅನಿ ದೆವಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಚುಕ್ವುನ್ ಹಾನುಕ್ ಬಲ್ವುನ್ ಘೆತಲ್ಯಾ ಪತರ್ ದೆವಾಕ್ನಾ ಬಲ್ವುನ್ ಘೆತಲ್ಯಾ ಎಳಾ ಪತರ್ಲೆ ತೆಚೆ ಜಿವನ್ ಸಾಂಗ್ತಾ. <char style="ior"><ref loc="EXO 2-4">2—4</ref> </char></para>
  <para style="io1">3. ಮಾನಾ ಬರ್ವನ್ಗಿಕಾರ್ ಅಪ್ನಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಜಿಮ್ನಿ ವಯ್ನಾ ಅನಿ ಫಾರೊವಾಚ್ಯಾ ಸಯ್ನಾಕ್ನಾ ಚುಕ್ವುತಲ್ಯಾ ಸಾಟ್ನಿ ಇಜಿಪ್ತಾತ್ ಕಸೆ ಬಳಾಚಿ ಕಾಮಾ ಅನಿ ಆಜಾಪಾ ಅನಿ ನಾಶಾ ಕರ್ಲ್ಯಾನ್ ಮನುನ್ ಸಾಂಗಲ್ಲೊ ಲಿವ್ನಾರೊ ವಿವರನ್ ಕರುನ್ ಸಾಂಗ್ತಾ. <char style="ior"><ref loc="EXO 5:15">5:15</ref>; <ref loc="EXO 21:36">21:36</ref> </char></para>
  <para style="io1">4. ಹಿತ್ತೆತ್ನಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಸಿನಾಯ್ ಮಡ್ಡಿಕ್ಡೆ ಪರ್ಯಾನ್ ಕರ್ಲ್ಯಾನಿ. <char style="ior"><ref loc="EXO 15:22-19:25">15:22—19:25</ref> </char></para>
  <para style="io1">5. ದೆವಾನ್ ಮೊಯ್ಜೆಕ್ ಎಕ್ ಖಾಯ್ದೊ ಕಸೆ ದಿಲ್ಯಾನ್ ಮನ್ತಲೆ ಅಮಿ ವಾಚ್ತಾಂವ್, ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ, ಕಸೆ ಜಿವನ್ ಕರುಚೆ ಅನಿ ಆರಾದನ್ ಕರುಚೆ ಮನ್ತಲ್ಯಾಚ್ಯಾ ವಿಶಯಾತ್ ಮನ್ತಲ್ಯಾ ವಿಶಯಾತ್ ಸುಚ್ನಾ ಗಾವಲ್ಲಿ ಹಾತ್. <char style="ior"><ref loc="EXO 15-31">15—31</ref></char></para>
  <para style="io1">6. ಮೊಯ್ಜೆಚೊ ಭಾವ್ ಆರೊನಾಕ್ನಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಕಸೆ ವಾಸ್ರಾಚಿ ಮುರ್ತಿ ಕರುನ್ ಘೆಟ್ಲ್ಯಾನಿ ಅನಿ ಫುಜಾ ಕರ್ಲ್ಯಾನಿ. <char style="ior"><ref loc="EXO 32">32</ref> </char></para>
  <para style="io1">7. ಮೊಯ್ಜೆನ್ ದೆವಾಚ್ಯಾ ಖಾಯ್ದ್ಯಾಂಚ್ಯಾ ವಿಶಯಾತ್ ಇಜ್ರಾಯೆಲಾಕ್ನಿ ಸುಚ್ನಾ ದಿಲ್ಯಾನ್ ಅನಿ ಬಿಡಾರಾ ಅನಿ ಯಾಜಕಾಂಚೆ ಕಪ್ಡೆ ಕಸೆ ತಯಾರ್ ಕರ್‍ತಲೆ ಮನ್ತಲ್ಯಾ ವಿಶಯಾತ್ ಸಾಂಗ್ತಾ. <char style="ior"><ref loc="EXO 33-40">33—40</ref> </char></para>
  <chapter number="1" style="c" sid="EXO 1" />
  <para style="s">ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಇಜಿಪ್ತಾತ್ ತರಾಸ್ ಯೆಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 1:1" />ಅಪ್ಲ್ಯಾ ಕುಟ್ಮಾಚ್ಯಾ ಸಮೆತ್ ಜಾಕೊಬಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಇಜಿಪ್ತಾಕ್ ಗೆಲ್ಲ್ಯಾ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಲೆಕಾಂಚಿ ನಾವಾ ಹಿಚ್, <verse eid="EXO 1:1" /><verse number="2" style="v" sid="EXO 1:2" />ರುಬೆನ್, ಸಿಮೊನ್, ಲೆವಿ, ಅನಿ ಜುದ್, <verse eid="EXO 1:2" /><verse number="3" style="v" sid="EXO 1:3" />ಇಸ್ಸಾಕಾರ್, ಜೆಬುಲುನ್, ಅನಿ ಬೆಂಜ್ಯಾಮಿನ್; <verse eid="EXO 1:3" /><verse number="4" style="v" sid="EXO 1:4" />ದಾನ್, ನೆಪ್ತಾಲಿ, ಗಾದ್, ಅನಿ ಅಶೆರ್, <verse eid="EXO 1:4" /><verse number="5" style="v" sid="EXO 1:5" />ಖರೆ ಜುಜೆ ಅದ್ದಿಚ್ ಇಜಿಪ್ತಾಕ್ ಗೆಲ್ಲೊ, ಜಾಕೊಬಾಚ್ಯಾ ಖಂದಾನಾತ್ ಉಪಾಜಲ್ಲಿ ಒಟ್ಟು ಸತ್ತರ್ ಲೊಕಾ ಹೊತ್ತಿ.<verse eid="EXO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 1:6" />ಮಾನಾ ಜುಜೆ ಅನಿ ತೆಚಿ ಭಾವಾ ಮರ್ಲಿ, ಅನಿ ತಸೆಚ್ ತೆಚ್ಯಾ ಖಂದಾನಾಚಿ ಸಗ್ಳಿ ಲೊಕಾಬಿ ಮರ್ಲಿ. <verse eid="EXO 1:6" /><verse number="7" style="v" sid="EXO 1:7" />ಖರೆ ಇಜ್ರಾಯೆಲಾಂಚೊ ಅಂಕೊ ವಾಡುನ್ ಲೈ ಹೊಲೊ,</para>
  <para style="p" vid="EXO 1:7">ಅನಿ ತೆನಿ ಬಲಿಸ್ಟ್ ಹೊಲೆ, ಲೈ ಮಟ್ಲ್ಯಾರ್ ತೊ ದೆಶ್ ತೆಂಚೆನುಚ್ ಭರುನ್ ಗೆಲೊ.<verse eid="EXO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 1:8" />ಮಾನಾ ಜುಜೆಚಿ ವಳಕ್ ನತ್ತೊ ಎಕ್ ನ್ಹವೊ ರಾಜಾ ಇಜಿಪ್ತಾತ್ ಅಧಿಕಾರಾಕ್ ಯೆಲೊ. <verse eid="EXO 1:8" /><verse number="9" style="v" sid="EXO 1:9" />ತೆನಿ ಅಪ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ; “ಬಗಾ”, ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಖಾಂದಾನಾಚಿ ಲೊಕಾ ಅಮ್ಚ್ಯಾ ಕಿಂತಾಬಿ ಲೈ ಹೊವ್ನ್ ವಾಡುಲ್ಲಾತ್, ಅನಿ ಬಲಿಸ್ಟ್ ಹೊಲಾತ್, <verse eid="EXO 1:9" /><verse number="10" style="v" sid="EXO 1:10" />ಅಮ್ಕಾ ವಿರೊಧ್ ಕೊನ್ ತರಿಬಿ ಝಗ್ಡ್ಯಾಕ್ ಯೆಲ್ಯಾರ್, ತೆನಿ ಅಮ್ಚ್ಯಾ ವಿರೊಧಿಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳುನ್ ಅಮ್ಚೆಕ್ನಾ ಝಗ್ಡೊ ಕರುನ್ ಹ್ಯೊ ದೆಶ್ ಸೊಡುನ್ ಜಾಯ್ಲ್, ತಸೆ ಹೊವ್ನ್ ಯೆವಾ, ತೆನಿ ಅಮ್ಚೆ ದೆಶ್ ಸೊಡುನ್ ಜಾಯ್ನಾ ಸಾರ್ಕೆ ಕಾಯ್ತರಿಬಿ ಯೆವ್ಜನ್ ಹುಡ್ಕುಂವಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 1:10" /><verse number="11" style="v" sid="EXO 1:11" />ತನ್ನಾ ತೆಂಕಾ ಅಪ್ಲ್ಯಾ ಜಬರ್ದಸ್ತಿನ್ ತರಾಸ್ ದಿತಲ್ಯಾ ಸರ್ಕೆ ಕಾಮ್ ಕರಸ್ತಲ್ಯಾ ಅಧಿಕಾರಿಕ್ನಿ ಖಾಲ್ತಿ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನಿ, ತೆನಿ ಫಾರೊವಾಸಾಟ್ನಿ ಪಿತೊಮ್ ರಾಮ್ಸೆಸ್ ಮನ್ತಲೆ ಗುಡಾನಾಂಚೆ ಶಾರ್ ಭಾಂದಸ್ಲ್ಯಾನಿ. <verse eid="EXO 1:11" /><verse number="12" style="v" sid="EXO 1:12" />ಖರೆ ತೆನಿ ಕವ್ಡೆ ತರಾಸ್ ದಿತ್ಯಾತ್ ತವ್ಡೆ ಲೈ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ವಾಡ್ವಳ್ಕಿ ಹೊಲಿ, ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ವಾಡ್ವಳ್ಕಿ ಹೊತಲೆ ಬಗುನ್ ಲೈ ಭಿಂವ್ಲ್ಯಾನಿ. <verse eid="EXO 1:12" /><verse number="13" style="v" sid="EXO 1:13" />ತಸೆ ಹೊವ್ನ್ ಇಜಿಪ್ತಾತ್ಲ್ಯಾ ಲೊಕಾನಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾಕ್ನಾ ಲೈ ಕಟಿನ್ ಕಾಮಾ ಕರ್ಸುನ್ ಘೆಟ್ಲ್ಯಾನಿ. <verse eid="EXO 1:13" /><verse number="14" style="v" sid="EXO 1:14" />ಮಾಟಿಚಿ ಕಾಮಾ, ಇಟಂಗಿಚಿ ಕಾಮಾ, ಅನಿ ಸೆತಾಚಿ ಕಾಮಾ, ಸಗ್ಳ್ಯಾ ನಮುನಿಚ್ಯಾ ಕಾಮಾತ್ನಿಬಿ ಲೈ ತರಾಸ್ ದಿಲ್ಯಾನಿ, ಅನಿ ತೆಂಕಾ ಜಿವಾಚೊ ಲೈ ಬೆಜಾರ್ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನಿ, ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಕರಸಲ್ಲಿ ಸಗ್ಳಿ ಕಾಮಾಬಿ ಲೈ ತರಾಸಾಚಿಚ್ ಹೊತ್ತಿ .<verse eid="EXO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 1:15" />ಮಾನಾ ಇಜಿಪ್ತಾಚ್ಯಾ ರಾಜಾನ್ ಇಬ್ರಿಯಾಂಚ್ಯಾ ಬಾಯ್ಕಾಕ್ನಿ ಮಜ್ಜತ್ ಕರಲ್ಲ್ಯಾ ದೊನ್ ವೈಜಿನಿಯಾ “ಶಿಪ್ರಾ” ಅನಿ “ಪುವಾ” ಮನ್ತಲಿಂಚ್ಯಾಕ್ನಾ ಬೊಲುನ್, <verse eid="EXO 1:15" /><verse number="16" style="v" sid="EXO 1:16" />“ತುಮಿ ಇಬ್ರಿಯಾ ಬಾಯ್ಕೊ ಮಾನ್ಸಾಕ್ನಿ ಪೊರಾ ಉಪಾಜ್ತಾನಾ ಝಿಲ್ಗೊ ಹೊಲ್ಯಾರ್ ತೆಕಾ ಜಿವ್ ಕಾಡಾ, ಅನಿ ಚೆಡು ಹೊಲ್ಯಾರ್ ತವ್ಡೆಚ್ ಝಿತ್ತೆ ರಾವ್ಕ್ ಸೊಡಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 1:16" /><verse number="17" style="v" sid="EXO 1:17" />ಖರೆ ತ್ಯಾ ವೈಜಿನಿಯಾನಿ ದೆವಾಕ್ ಭಿಂವ್ನ್, ಇಜಿಪ್ತಾಚ್ಯಾ ರಾಜಾನ್ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆ ಕರಿನಸ್ತಾನಾ, ಝಿಲ್ಗ್ಯಾಕ್ನಿ ಝಿತ್ತೆ ರಾವ್ಕ್ ಸೊಡ್ಲ್ಯಾನಿ. <verse eid="EXO 1:17" /><verse number="18" style="v" sid="EXO 1:18" />ತನ್ನಾ ತ್ಯಾ ರಾಜಾನ್ ವೈಜಿನಿಯಾಕ್ನಿ ಬಲ್ವುನ್, “ಕಶ್ಯಾಕ್ ಅಸ್ಲೆ ಕಾಮ್ ಕರ್ಲ್ಯಾಸಿ? ಝಿಲ್ಗ್ಯಾಕ್ನಿ ಕಶ್ಯಾಕ್ ಝಿತ್ತೆ ಸೊಡ್ಲ್ಯಾಸಿ?” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 1:18" /><verse number="19" style="v" sid="EXO 1:19" />ತನ್ನಾ ತ್ಯಾ ವೈಜಿನಿಯಾನಿ “ಇಬ್ರಿಯಾಂಚ್ಯಾ ಬಾಯ್ಕೊ ಮಾನ್ಸಿಯಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಬಾಯ್ಕೊಮಾನ್ಸಿಯಾಂಚ್ಯಾ ಗತಿನ್ ನ್ಹಯ್, ತೆನಿ ಲೈ ಹುಶಾರ್ ಹಾತ್, ವೈಜಿನಿಯಾ ತೆಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ಜಾವ್ಚ್ಯಾ ಅದ್ದಿಚ್ ಪೊರಾ ಉಪಾಜ್ತಾತ್” ಮಟ್ಲ್ಯಾನಿ. <verse eid="EXO 1:19" /><verse number="20" style="v" sid="EXO 1:20" />ತೆಚ್ಯಾ ವೈನಾ ದೆವಾನ್ ತ್ಯಾ ವೈಜಿನಿಯಾಕ್ನಿ ದಯಾ ದಾಕ್ವುಲ್ಯಾನ್, ಅನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಲೈ ಹೊವ್ನ್ ವಾಡುನ್ಗೆತ್ ಗೆಲಿ. <verse eid="EXO 1:20" /><verse number="21" style="v" sid="EXO 1:21" />ಅನಿ ತಿ ವೈಜಿನಿಯಾ ದೆವಾಕ್ ಭಿಂವ್ನ್ ಚಲಲ್ಲ್ಯಾಸಾಟ್ನಿ, ತೆನಿ ತೆಂಚಿ ಪಿಳ್ಗಿ ವಾಡ್ವಳ್ಕಿ ಕರ್ಲ್ಯಾನ್, ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಲೈ ಹೊವ್ನ್ ವಾಡ್ವಳ್ಕಿ ಹೊಲಿ.<verse eid="EXO 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 1:22" />ಆಕ್ರಿಕ್ ಫಾರೊವ್ ರಾಜ್ಯಾನ್ ಅಪ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ, “ಇಬ್ರಿಯಾಕ್ನಿ ಉಪಜಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಝಿಲ್ ಬಾಳ್ಸ್ಯಾಕ್ನಿ ನೈಲ್ ನ್ಹಯ್ತ್ ಟಾಕುಚೆ, ಖರೆ ಚೆಡ್ವಾಚ್ಯಾ ಬಾಳ್ಸ್ಯಾಕ್ನಿ ತವ್ಡೆಚ್ ಝಿತ್ತೆ ಸೊಡುಚೆ” ಮನುನ್ ಹುಕುಮ್ ದಿಲ್ಯಾನ್.<verse eid="EXO 1:22" /></para>
  <chapter eid="EXO 1" />
  <chapter number="2" style="c" sid="EXO 2" />
  <para style="s">ಮೊಯ್ಜೆ ಉಪಾಜ್ತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1" />ಮಾನಾ ಲೆವಿಚ್ಯಾ ಘರಾನಾಚ್ಯಾ ಎಕ್ಲ್ಯಾನ್ ಲೆವಿ ಕುಳಿಚ್ಯಾ ಚೆಡ್ವಾಕ್ ಲಗಿನ್ ಕರುನ್ಗೆಟ್ಲ್ಯಾನ್. <verse eid="EXO 2:1" /><verse number="2" style="v" sid="EXO 2:2" />ಅನಿ ತಿ ಬಾಯ್ಕೊ ಮಾನುಸ್ ಗರ್‍ವಾರ್ ರಾವ್ನ್ ತಿಕಾ ಎಕ್ ಝಿಲ್ಗೊ ಉಪಜ್ಲೊ, ಅನಿ ತೊ ಬಗುಕ್ ಲೈ ಸುಂದರ್ ಹೊತ್ತೊ, ತನ್ನಾ ತೆಕಾ ತಿನ್ ಮೈನೆ ನಿಪ್ವುನ್ ಥವ್ಲ್ಯಾನಿ. <verse eid="EXO 2:2" /><verse number="3" style="v" sid="EXO 2:3" />ತೆಕಾ ಅನಿ ಲೈ ನಿಪ್ವುನ್ ಥವ್ಕ್ ಹೊಯ್ನಾ ಹೊತಾನಾ, ಎಕ್ ಬೆತ್ತಾಚಿ ಪೆಟಿ ಘೆವ್ನ್, ತೆಕಾ ಡಾಂಬರ್ ಲಾವ್ನ್ ಬಾಳ್ಸ್ಯಾಕ್ ತ್ಯಾತುರ್ ಥವ್ನ್ ನೈಲ್ ನ್ಹಯ್ಚ್ಯಾ ದಂಡೆಕ್ ಲಾಗುನ್ ಹೊತ್ತ್ಯಾ ಗವ್ತಾ ವರ್‍ತಿ ಥವ್ಲ್ಯಾನಿ. <verse eid="EXO 2:3" /><verse number="4" style="v" sid="EXO 2:4" />ಬಾಳ್ಸ್ಯಾಕ್ ಕಾಯ್ ಹೊತಾಕಿ ಮನುನ್ ಬಗುಕ್ ತೆಚಿ ಅಕ್ಕಾ ಧುರ್ ಇಬೆ ಹೊತ್ತಿ.<verse eid="EXO 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 2:5" />ತನ್ನಾ ಫಾರೊವ್ ರಾಜಾಚಿ ಲೆಕ್ ನೈಲ್ ನ್ಹಯ್ತ್ ಪಾನಿ ನ್ಹಾವ್ಕ್ ಯೆಲಿ, ತಿಜಿ ಸೆವಕಿಯಾ ನ್ಹಯ್ಚ್ಯಾ ದಂಡೆಕ್ ಫಿರುನ್ಗೆತ್ ಹೊತ್ತಿ, ತನ್ನಾ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಲೆಕಿಕ್ ತಿ ಪೆಟಿ ಗವ್ತಾರ್ ಹೊತ್ತಿ ದಿಸ್ತಾ, ಅನಿ ತಿನಿ ಅಪ್ಲ್ಯಾ ಸೆವಕಿಕ್ ಧಾಡುನ್ ತಿ ಪೆಟಿ ಹಾನುಕ್ ಲಾವ್ಲಿನ್. <verse eid="EXO 2:5" /><verse number="6" style="v" sid="EXO 2:6" />ತಿ ಪೆಟಿ ಉಗ್ಡುನ್ ಬಗ್ತಾನಾ, ಎಕ್ ಬಾಳ್ಸೆ ರಡಿತ್ ಹೊತ್ತೆ, ತಿಕಾ ತ್ಯಾ ಬಾಳ್ಸ್ಯಾ ವರ್‍ತಿ ಕಾಳ್ಜಿ ಯೆಲಿ, ತಿನಿ “ಹೆ ಬಾಳ್ಸೆ ಇಬ್ರಿಯಾ ಲೊಕಾಂಚೆ ಹೊವ್ಕ್ ಫಿರೆ” ಮಟ್ಲಿನ್.<verse eid="EXO 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 2:7" />ತನ್ನಾ ತೆಚ್ಯಾ ಅಕ್ಕಾನ್ ಯೆವ್ನ್, ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಲೆಕಿಕ್, “ಮಿಯಾ ಜಾವ್ನ್ ಹ್ಯಾ ಬಾಳ್ಸ್ಯಾಕ್ ದುದ್ ಫಿವ್ಸುಕ್ ಎಕ್ ಇಬ್ರಿಯಾಂಚಿ ಬಾಯ್ಕೊ ಮಾನುಸ್ ಹಾನು ಕಾಯ್?” ಮಟ್ಲಿನ್.<verse eid="EXO 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 2:8" />ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಲೆಕಿನ್, “ಜಾ ಅನಿ ಘೆವ್ನ್ ಯೆ” ಮಟ್ಲಿನ್, ತನ್ನಾ ತ್ಯಾ ಚೆಡ್ವಾನ್ ಜಾವ್ನ್ ತ್ಯಾ ಬಾಳ್ಸ್ಯಾಚ್ಯಾ ಅವ್ಸಿಕುಚ್ ಬಲ್ವುನ್ ಹಾನ್ಲಿನ್. <verse eid="EXO 2:8" /><verse number="9" style="v" sid="EXO 2:9" />ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಲೆಕಿನ್, ತ್ಯಾ ಬಾಯ್ಕೊ ಮಾನ್ಸಿಕ್ “ಹ್ಯಾ ಬಾಳ್ಸ್ಯಾಕ್ ನ್ಹೆವ್ನ್ ಮಾಜ್ಯಾ ಸಾಟ್ನಿ ದುದ್ ದಿವ್ನ್ ಬಾಳಗ್, ಮಿಯಾ ತುಕಾ ಮಜುರಿ ದಿತಾ,” ಮಟ್ಲಿನ್, ತ್ಯಾ ಬಾಯ್ಕೊ ಮಾನ್ಸಿನ್ ತ್ಯಾ ಬಾಳ್ಸ್ಯಾಕ್ ನ್ಹೆವ್ನ್ ಅಪ್ಲೆ ದುದ್ ದಿವ್ನ್ ಬಾಳಗ್ಲಿನ್. <verse eid="EXO 2:9" /><verse number="10" style="v" sid="EXO 2:10" />ತೊ ಝಿಲ್ಗೊ ಮೊಟೊ ಹೊಲೊ ತಿನಿ ತೆಕಾ ಫೊರಾವ್ ರಾಜಾಚ್ಯಾ ಲೆಕಿಕ್ಡೆ ಹಾನುನ್ ದಿಲಿನ್, ತನ್ನಾ ರಾಜಾಚ್ಯಾ ಲೆಕಿನ್ ತೆಕಾ ಅಪ್ಲ್ಯಾ ಲೆಕಾ ಸಾರ್ಕೆ ಬಾಳಗ್ಲಿನ್, ಅನಿ “ಹೆಕಾ ಮಿಯಾ ಪಾನಿಯಾತ್ನಾ ವೈರ್ ಕಾಡ್ಲಾ,” ಮನುನ್, ತೆಕಾ “ಮೊಯ್ಜೆ”<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">ಮೊಯ್ಜೆ, ಮಟ್ಲ್ಯಾರ್ ಪಾನಿಯಾತ್ನಾ ವರ್‍ತಿ ಕಾಡುನ್ ಹೊಲ್ಲೊ.</char></note> ಮನುನ್ ನಾವ್ ಥವ್ಲಿನ್.<verse eid="EXO 2:10" /></para>
  <para style="s">ಮೊಯ್ಜೆ ಮಿದ್ಯಾನಾಕ್ ಪಳುನ್ ಜಾತಲೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11" />ಮೊಯ್ಜೆ ಮೊಟೊ ಹೊಲೊ, ಎಕ್ ದಿಸಿ ತೊ ಅಪ್ಲ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಹೆಬ್ರೊವಾಚ್ಯಾ ಭಾವಾಕ್ನಿ ಭೆಟುಕ್ ಜಾವ್ನ್, ತೆನಿ ತರಾಸಾನ್ ಕಾಮಾ ಕರುಕ್ ವಾಪ್ರುನ್ ಹೊವ್ಲಾ ಮನುನ್ ಬಗ್ಲ್ಯಾನ್, ಅನಿ ಎಕ್ ಇಜಿಪ್ತಾತ್ಲೊ ಮಾನುಸ್, ಅಪ್ನಾಚ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಲೊಕಾಂತ್ಲ್ಯಾ ಹೆಬ್ರೊವಾಕ್ ಜಿವ್ ಕಾಡುಕ್ ಲಾಗಲೆ ಬಗಟ್ಲ್ಯಾನ್. <verse eid="EXO 2:11" /><verse number="12" style="v" sid="EXO 2:12" />ತೆನಿ ಅಜುಭಾಜುಕ್ ಬಗುನ್, ಕೊನ್ಬಿ ನಾ ಮನುನ್ ಕಳ್ವುನ್, ಘೆವ್ನ್ ತ್ಯಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಮಾನ್ಸಾಕ್ ಜಿವ್ ಕಾಡುನ್ ರೆತಿತ್ ಪುರ್ಲ್ಯಾನ್. <verse eid="EXO 2:12" /><verse number="13" style="v" sid="EXO 2:13" />ದುಸ್ರೆಂದಿಸಿ ತೊ ಅನಿಬಿ ಫಿರುಕ್ ಗೆಲ್ಲ್ಯಾ ತನ್ನಾ, ಹೆಬ್ರೊವಾಂಚಿ ದೊನ್ ಮಾನ್ಸಾ ಝಗ್ಡೆ ಕರಿತ್ ಹೊತ್ತ್ಯಾನಿ, ಚುಕ್ ಕರಲ್ಲ್ಯಾ ಮಾನ್ಸಾಕ್ ಮೊಯ್ಜೆನ್, “ಕಶ್ಯಾಕ್ ತಿಯಾ ಅಮ್ಚ್ಯಾ ಇಬ್ರಿಯಾಕ್ ಮಾರ್ತೈಯ್?” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 2:14" />ತೆಕಾ ತ್ಯಾ ಮಾನ್ಸಾನ್, “ಕೊನ್ ತುಕಾ ಅಮ್ಚ್ಯಾ ವರ್‍ತಿ ಧನಿ ಅನಿ ಝಡ್ತಿ ಕರ್ತಲೊ ಮನುನ್ ನೆಮ್ಲಾತ್? ತ್ಯಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಮಾನ್ಸಾಕ್ ಜಿವ್ ಕಾಡ್ಲೆ ಸಾರ್ಕೆ ಮಾಕಾಬಿ ಜಿವ್ ಕಾಡುಚೆ ಮನುನ್ ಕರ್‍ಲೆ ಕಾಯ್?” ಮಟ್ಲ್ಯಾನ್, ತನ್ನಾ ಮೊಯ್ಜೆ ಖರೆಚ್ಬಿ ಹೆ ಕಾಮ್ ಸಗ್ಳ್ಯಾಕ್ನಿ ಕಳುನ್ ಯೆಲೆ ಮನುನ್ ಭಿಂಯಾಲೊ. <verse eid="EXO 2:14" /><verse number="15" style="v" sid="EXO 2:15" />ಫಾರೊವ್ ರಾಜಾಕ್ ಹಿ ಖಬರ್ ಕಳಲ್ಲ್ಯಾ ತನ್ನಾ, ತೆನಿ ಮೊಯ್ಜೆಕ್ ಜಿವ್ ಕಾಡ್ಸುಚೆ ಮನುನ್ಗೆವ್ನ್ ಹೊತ್ತೊ, ತನ್ನಾ ಮೊಯ್ಜೆ ಫಾರೊವ್ ರಾಜಾಕ್ನಾ ಪಳುನ್ ಜಾವ್ನ್, ಮಿದ್ಯಾನ್ ದೆಶ್ಯಾತ್ ಎಕ್ ಭಾಂಯಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ಬಸ್ಲೊ. <verse eid="EXO 2:15" /><verse number="16" style="v" sid="EXO 2:16" />ಮಿದ್ಯಾನಾಚ್ಯಾ ಯಾಜಕಾಕ್ ಸಾತ್ ಲೆಕಿಯಾ ಹೊತ್ತಿ, ಅನಿ ತೆನಿ ಭಾಂಯಿಕ್ಡೆ ಯೆವ್ನ್ ಅಪ್ಲ್ಯಾ ಬಾಬಾಚ್ಯಾ ಶೆಳಿಯಾಕ್ನಿ ಪಾನಿ ಪಾಜ್ವುಕ್ ಸಾಟ್ನಿ ಪಾನಿ ಕಾಡುನ್ ಡೊನ್ಯಾತ್ನಿ ಭರುಕ್ಲಾಗಲೆ. <verse eid="EXO 2:16" /><verse number="17" style="v" sid="EXO 2:17" />ಖರೆ ಬಕ್ರಿ ರಾಕ್ತಲ್ಯಾನಿ ಯೆವ್ನ್ ತೆಂಕಾ ಪಳ್ಸುನ್ ಘಾಟ್ಲ್ಯಾನಿ, ತನ್ನಾ ಮೊಯ್ಜೆ ಜಾವ್ನ್ ತೆಂಕಾ ಮಜ್ಜತ್ ಕರುನ್ ತೆಂಚ್ಯಾ ಶೆಳಿಯಾಕ್ನಿ ಪಾನಿ ಪಾಜ್ವುಲ್ಯಾನ್. <verse eid="EXO 2:17" /><verse number="18" style="v" sid="EXO 2:18" />ತೆನಿ ಅಪ್ಲೊ ಬಾಬಾ ರೆವುಯೆಲಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ, ತೆನಿ ತೆಂಕಾ, “ತುಮಿ ಆಜ್ ಕಶ್ಯಾಕ್ ಯೆವ್ಡ್ಯಾ ಲಗ್ಗುನಾ ಯೆಲ್ಯಾಸಿ?” ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ. <verse eid="EXO 2:18" /><verse number="19" style="v" sid="EXO 2:19" />ತೆನಿ ತನ್ನಾ “ಇಜಿಪ್ತಾಚ್ಯಾ ಎಕ್ ಮಾನ್ಸಾನ್ ಬಕ್ರಿ ರಾಕ್ತಲ್ಯಾಂಚ್ಯಾಕ್ನಾ ಅಮ್ಕಾ ರಾಕುನ್, ಅಮ್ಚ್ಯಾ ಸಾಟ್ನಿ ಪಾನಿ ಕಾಡುನ್ ಶೆಳಿಯಾಕ್ನಿ ಪಾಜ್ವುಲ್ಯಾನ್” ಮಟ್ಲ್ಯಾನಿ.<verse eid="EXO 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 2:20" />ತನ್ನಾ ತೆನಿ ಅಪ್ಲ್ಯಾ ಲೆಕಿಯಾಕ್ನಿ, “ತೊ ಮಾನುಸ್ ಖೈ ಹಾಯ್? ತೆಕಾ ಕಶ್ಯಾಕ್ ಸೊಡುನ್ ಯೆಲ್ಯಾಸಿ? ತೆಕಾ ಬಲ್ವಾ, ತೊ ಅಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಜೆವಾನ್ ಕರುಂದಿತ್,” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 2:21" />ಅಸೆ ಮೊಯ್ಜೆನ್ ತ್ಯಾ ಮಾನ್ಸಾಚ್ಯಾ ಘರ್‍ಹಾತ್ ರಾವ್ಕ್ ನಿರ್ದಾರ್ ಕರ್ಲ್ಯಾನ್, ಅನಿ ತೆನಿ ಅಪ್ಲಿ ಲೆಕ್ ಜಿಪ್ಪೊರಾ ಮನ್ತಲಿಕ್ ಮೊಯ್ಜೆಕ್ ದಿವ್ನ್ ಲಗಿನ್ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 2:21" /><verse number="22" style="v" sid="EXO 2:22" />ತಿಕಾ ಎಕ್ ಝಿಲ್ಗೊ ಉಪಜ್ಲೊ ಅನಿ ತೆನಿ ತೆಕಾ ಗೆರ್ಶೊಮ್<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">ಗೆರ್ಶೊಮ್, ಮಟ್ಲ್ಯಾರ್, ಪರ್ವಾಸಿ </char></note> ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, “ಮಿಯಾ ದುಶ್ರ್ಯಾ ದೆಶ್ಯಾತ್ ಎಕ್ ಪರ್ದೆಶಿ ಹೊವ್ನ್ ಹಾಯ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23" />ಅಸೆ ಹೊವ್ನ್ ಲೈ ದಿಸಾ ಕಳದ್ಲ್ಯಾಮಾನಾ ಇಜಿಪ್ತಾಚೊ ರಾಜಾ ಮರ್ಲೊ, ಖರೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಅನಿಬಿ ಗುಲಾಮ್ ಪಾನಾತ್ ವಳ್ವಳುಲಾಗಲಿ, ತೆನಿ ಅಪ್ನಾಕ್ನಿ ಆದಾರ್ ಪಾಜೆ ಮನುನ್ ಬೊಬ್ ಮಾರ್ಲ್ಯಾನಿ, ತಿ ಬೊಬ್ ದೆವಾಕ್ಡೆ ಪಾವ್ಲಿ. <verse eid="EXO 2:23" /><verse number="24" style="v" sid="EXO 2:24" />ದೆವಾನ್ ತಿ ಬೊಬ್ ಆಯಿಕ್ಲ್ಯಾನ್, ಅನಿ ಅಪ್ನಿ ಅಬ್ರಾಹಾಮ್, ಇಸಾಕ್ ಅನಿ ಜಾಕೊಬಾಕ್ಡೆ ಕರಲ್ಲೊ ಕರಾರ್ ಯಾದೆಕ್ ಹಾನುನ್ ಘೆಟ್ಲ್ಯಾನ್. <verse eid="EXO 2:24" /><verse number="25" style="v" sid="EXO 2:25" />ತನ್ನಾ ದೆವಾನ್ ಇಜ್ರಾಯೆಲ್‌ ಲೊಕಾಕ್ನಿ ಬಗುನ್ ತೆಂಕಾ ದಯಾ ದಾಕ್ವುಲ್ಯಾನ್.<verse eid="EXO 2:25" /></para>
  <chapter eid="EXO 2" />
  <chapter number="3" style="c" sid="EXO 3" />
  <para style="s">ದೆವಾನ್ ಮೊಯ್ಜೆಕ್ ಬಲ್ವಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1" />ಮೊಯ್ಜೆ ಅಪ್ಲೊ ಮಾಮಾ ಮಿದ್ಯಾನಾಚೊ ಯಾಜಕ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಜೆತ್ರೊ ಮನ್ತಲ್ಯಾಚಿ ಬಕ್ರಿ ರಾಕುನ್ಗೆತ್ ತೆಂಕಾ ಡಂಗ್ಳಿಚ್ಯಾ ಫಾಟ್ಲ್ಯಾ ಭಾಜುಕ್ ಚಲ್ಸುನ್ಗೆವ್ನ್ ಜಾವ್ನ್ “ಸಿನಾಯ್” ಮನ್ತಲ್ಯಾ ಪವಿತ್ರ್ ಮಡ್ಡಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆಲೊ. <verse eid="EXO 3:1" /><verse number="2" style="v" sid="EXO 3:2" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚ್ಯಾ ಧುತಾನ್, ಜಳ್ತಲ್ಯಾ ಆಗಿಚ್ಯಾ ಸಾರ್ಕೊ ಕಾಟ್ಯಾಂಚ್ಯಾ ಝಿಳಿತ್ನಾ ದಾಕ್ವುನ್ ಘೆಟ್ಲ್ಯಾನ್, ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಬಗ್ತಾನಾ, ಕಾಟ್ಯಾಂಚ್ಯಾ ಝಿಳಿಕ್ ಆಗ್ ಲಾಗಲಿ; ಖರೆ ಝಿಳ್ ಜಳುನ್ ಜಾವ್ಕ್ ನಾ. <verse eid="EXO 3:2" /><verse number="3" style="v" sid="EXO 3:3" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ “ಝಿಳ್ ಕಶ್ಯಾಕ್ ಜಳಿ ನಾ! ಹೆ ಪವಿತ್ರ್ ದ್ರಶ್ಯಾ ಮಿಯಾ ಜಗ್ಗೊಳ್ ಜಾವ್ನ್ ಬಗುಚೆ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 3:4" />ತೊ ಬಗುಕ್ ಮನುನ್ ಜಗ್ಗೊಳ್ ಯೆವ್ಲಾಗಲೆ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಬಗುನ್ ತೆಕಾ, “ಮೊಯ್ಜೆ, ಮೊಯ್ಜೆ,” ಮನುನ್ ಬಲ್ವುಲ್ಯಾನ್, ತನ್ನಾ ತೆನಿ “ಅಬಕ್, ಮಿಯಾ ಹಿತ್ತೆಚ್ ಹಾಂವ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 3:5" />ತನ್ನಾ ದೆವಾನ್ “ಹಿತ್ತೆ ಜಗ್ಗೊಳ್ ಯೆವ್ ನಕ್ಕೊ! ತುಜ್ಯಾ ಪಾಂಯಾತ್ಲಿ ವ್ಹಾನಯಾ ಕಾಡ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತಿಯಾ ಇಬೆ ಹೊತ್ತೊ ಪವಿತ್ರ್ ಜಾಗೊ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 3:6" />ಅನಿ ದೆವಾನ್ ತೆಕಾ, ಮಿಯಾ ತುಜ್ಯಾ ಪುರ್ವಜಾಂಚೊ ಬಾಬಾ, ಅಬ್ರಾಹಾಮ್, ಇಸಾಕ್, ಅನಿ ಜಾಕೊಬಾಚೊ ದೆವ್ ಹೊವ್ನ್ ಹಾಯ್ ಮಟ್ಲ್ಯಾನ್, ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಅಪ್ನಾಚೆ ತೊಂಡ್ ಧಾಪುನ್ ಘೆಟ್ಲ್ಯಾನ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೊ ದೆವಾಕ್ ಬಗುಕ್ ಭಿಂವ್ಲೊ.<verse eid="EXO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 3:7" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್, “ಮಿಯಾ ಇಜಿಪ್ತಾತ್ ಹೊತ್ತ್ಯಾ ಮಾಜ್ಯಾ ಲೊಕಾಂಚೊ ತರಾಸ್ ಬಗ್ಲಾ, ತೆಂಕಾ ತರಾಸಾನಿ ಕಾಮಾ ಕರಸ್ತಲ್ಯಾಂಚ್ಯಾ ವಿಶಯಾತ್ ತೆಂಚೆ ಅಳಾಪ್ ಮಾಕಾ ಆಯ್ಕ್ಲಾ. ತೆಂಚೊ ದುಖ್ ಮಾಕಾ ಗೊತ್ತ್ ಹಾಯ್. <verse eid="EXO 3:7" /><verse number="8" style="v" sid="EXO 3:8" />ತಸೆ ಹೊವ್ನ್ ತೆಂಕಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಹಾತಿತ್ನಾ ಸೊಡ್ಸುಕ್ ಅನಿ ಥೈತ್ನಾ ಭಾಯ್ರ್ ಹಾನುನ್ ದುದ್ ಅನಿ ಮ್ಹಾಂವ್ ಹೊಂವ್ತಲ್ಯಾ ವಿಶ್ಯಾಲ್ ಹೊತ್ತ್ಯಾ ಬರ್ಯಾ ದೆಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಕಾನಾನ್ ಗಾರಾಂಚ್ಯಾ, ಹಿತ್ತಿಯಾಂಚ್ಯಾ, ಅಮೊರಿತಾಂಚ್ಯಾ, ಪೆರಿಜಿಯಾಂಚ್ಯಾ, ಹಿವ್ವಿಯಾಂಚ್ಯಾ ಅನಿ ಜೆಬುಸಿಯಾಂಚ್ಯಾ ಗಾಂವಾಕ್ ಬಲ್ವುನ್ ನೆವ್ಕ್ ಉತ್ರುನ್ ಯೆಲಾ. <verse eid="EXO 3:8" /><verse number="9" style="v" sid="EXO 3:9" />ಅತ್ತಾ ಆಯ್ಕ್, ಇಜ್ರಾಯೆಲಾಂಚಿ ಬೊಬ್ ಮಾಕಾ ಪಾವ್ಲಾ ಇಜಿಪ್ತಾಚಿ ಲೊಕಾ ತೆಂಕಾ ತರಾಸ್ ದಿತಲೆ ಮಿಯಾ ಬಗಟ್ಲಾ. <verse eid="EXO 3:9" /><verse number="10" style="v" sid="EXO 3:10" />ತಸೆ ಹೊವ್ನ್ ಜಾ; ಮಾಜಿ ಲೊಕಾ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಕ್ನಾ ಭಾಯ್ರ್ ಹಾನುಕ್ ಸಾಟ್ನಿ ತುಕಾ ಫಾರೊವ್ ಮನ್ತಲ್ಯಾ ರಾಜಾಕ್ಡೆ ಧಾಡುನ್ ದಿವ್ಲಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 3:11" />ಮೊಯ್ಜೆನ್ ದೆವಾಕ್, “ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಜಾವ್ಕ್ ಹೊಂವ್ದಿತ್ ನಾತರ್ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಇಜಿಪ್ತಾಕ್ನಾ ಸೊಡ್ಸುನ್ ಹಾನುಕ್ ಹೊಂವ್ದಿತ್ ಮಿಯಾ ಕೊನ್?” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 3:12" />ತನ್ನಾ ದೆವಾನ್ ತೆಕಾ, “ಮಿಯಾಚ್ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾತಾ; ತಿಯಾ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಇಜಿಪ್ತಾಕ್ನಾ ಭಾಯ್ರ್ ಹಾನಲ್ಲ್ಯಾ ತನ್ನಾ ತುಮಿ ಹ್ಯಾ ಮಡ್ಡಿರುಚ್ ದೆವಾಕ್ ಆರಾದನ್ ಕರ್ತ್ಯಾಶಿ, ತುಕಾ ಧಾಡುನ್ ದಿಲ್ಲೆ ಮಿಯಾಚ್ ಮನ್ತಲ್ಯಾಕ್ ಹಿಚ್ ತುಕಾ ವಳಕ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ,” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 3:13" />ಮೊಯ್ಜೆನ್ ದೆವಾಕ್, ಮಿಯಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ಜಾವ್ನ್, ತುಮ್ಚ್ಯಾ ಪುರ್ವಜಾಂಚ್ಯಾ ದೆವಾನ್ ಮಾಕಾ ತುಮ್ಚ್ಯಾ ಜಗ್ಗೊಳ್ ಧಾಡ್ಲಾ; ಮನುನ್ ಸಾಂಗ್ತಾನಾ ತೆನಿ ಎಕ್ ಎಳಾ “ತೆಚೆ ನಾವ್ ಕಾಯ್?” ಮನುನ್ ಇಚಾರ್ಲ್ಯಾರ್ ಮಿಯಾ ಕಾಯ್ ಜವಾಬ್ ದಿವ್ಚೆ? ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="EXO 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 3:14" />ತನ್ನಾ ದೆವಾನ್ “ಜೆ ಹಾಯ್ ತೊಚ್ ಮಿಯಾ” ತಿಯಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಲೊಕಾಕ್ನಿ “ಜೆ ಹಾಯ್” ಹೆನಿ ಮಾಕಾ ತುಮ್ಚ್ಯಾಕ್ಡೆ ಧಾಡ್ಲಾ ಮನುನ್ ಸಾಂಗ್ ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 3:14" /><verse number="15" style="v" sid="EXO 3:15" />ಅನಿ ದೆವಾನ್ ಮೊಯ್ಜೆಕ್; “ತಿಯಾ ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ಪುರ್ವಜ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಅಬ್ರಾಹಾಮಾಚೊ ದೆವ್, ಇಸಾಕಾಚೊ ದೆವ್, ಜಾಕೊಬಾಚೊ ದೆವ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾನ್ ಮಾಕಾ ತುಮ್ಚ್ಯಾಕ್ಡೆ ಧಾಡ್ಲಾ” ಮನುನ್ ಸಾಂಗ್, ಸಗ್ಳ್ಯಾ ಎಳಾಕ್ಬಿ ಹೆಚ್ ಮಾಜೆ ನಾವ್, ಹ್ಯಾ ನಾಂವಾನುಚ್ ಮಾಕಾ ಸದಾಸರ್ವತಾಕ್ ಅನಿ ಫಿಡೆ ಯೆತಲಿ ಸಗ್ಳ್ಯಾ ಪಿಳ್ಗಿಯಾಂಚಿ ಲೊಕಾಬಿ ಯಾದ್ ಕರ್‍ತಾತ್. <verse eid="EXO 3:15" /><verse number="16" style="v" sid="EXO 3:16" />ತಿಯಾ ಜಾವ್ನ್ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಜಾಂನ್ತ್ಯಾ ಲೊಕಾಕ್ನಿ ಗೊಳಾಕರ್, ತೆಂಕಾ ತುಮ್ಚ್ಯಾ ಪುರ್ವಜಾಂಚೊ ದೆವ್ ಮಟ್ಲ್ಯಾರ್, ಅಬ್ರಹಾಮ್, ಇಸಾಕ್, ಅನಿ ಜಾಕೊಬಾಚೊ ದೆವ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ದಾಕ್ವುನ್ಗೆವ್ನ್ ತುಮ್ಚ್ಯಾ ವಿಶಯಾತ್ ಅಸೆ ಮಟ್ಲಾ; ತುಮ್ಕಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾತ್ ಹೊಲ್ಲ್ಯಾ ತರಾಸಾಕ್ನಿ ಮಿಯಾ ಡೊಳ್ಯಾನ್ ಬಗಟ್ಲಾ ಅನಿ ಕಳ್ವುನ್ ಘೆಟ್ಲಾ. <verse eid="EXO 3:16" /><verse number="17" style="v" sid="EXO 3:17" />ಇಜಿಪ್ತಾತ್ ತುಮ್ಕಾ ಹೊಲ್ಲ್ಯಾ ತರಾಸಾಂತ್ನಾ ಸುಟ್ಕಾ ಕರುನ್, ದುದ್ ಅನಿ ಮ್ಹಾಂವ್ ಹೊಂವ್ತಲ್ಯಾ ದೆಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಕಾನಾನ್ ಗಾರಾ, ಹಿತ್ತಿಯಾ, ಅಮೊರಿತಾ, ಪೆರಿಜಿಯಾ, ಹಿವ್ವಿಯಾ ಅನಿ ಜೆಬುಸಿಯಾ ವಸ್ತಿ ಕರ್‍ತಲ್ಯಾ ದೆಶ್ಯಾಕ್ ಹಾನುಚೆ ಮನುನ್ ಸಾಂಗ್.<verse eid="EXO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 3:18" />ತೆನಿ ತುಜ್ಯಾ ಗೊಸ್ಟಿಕ್ ಕಾನ್ ದಿತ್ಯಾತ್, ತಿಯಾ ಅನಿ ಇಜ್ರಾಯೆಲಾಂಚಿ ಜಾಂನ್ತಿ ಲೊಕಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಚ್ಯಾ ರಾಜಾಕ್ಡೆ ಜಾವ್ನ್ ತೆಕಾ, “ಇಬ್ರಿಯಾಂಚೊ ದೆವ್ ಹೊವ್ನ್ ಹೊತ್ತೊ ಸರ್ವೆಸ್ಪರ್ ಅಮ್ಕಾ ದಿಸ್ಲೊ, ತಸೆ ಹೊವ್ನ್ ಅಮಿ ಡಂಗ್ಳಿತ್ ತಿನ್ ದಿಸ್ ಚಲುನ್ ಜಾತಲೆ ತವ್ಡೆ ಧುರ್ ಜಾವ್ನ್, ಅಮ್ಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಬಲಿ ಭೆಟ್ವುಕ್ ಪಾಜೆ ತಿಯಾ ಅಮ್ಕಾ ಒಪ್ಕಿ ದಿ” ಮನುನ್ ಇಚಾರಾ. <verse eid="EXO 3:18" /><verse number="19" style="v" sid="EXO 3:19" />ಖರೆ ತೊ ಇಜಿಪ್ತಾಚೊ ರಾಜಾ ಕವ್ಡೆ ಸಾಂಗ್ಲ್ಯಾರ್ಬಿ ತುಮ್ಕಾ ಸೊಡಿನಾ, ಮನ್ತಲೆ ಮಾಕಾ ಗೊತ್ತ್ ಹಾಯ್. <verse eid="EXO 3:19" /><verse number="20" style="v" sid="EXO 3:20" />ತಸೆ ಹೊವ್ನ್, ಮಾಜೊ ಹಾತ್ ಉಕ್ಲುನ್ ಇಜಿಪ್ತಾತ್ ಅಜಾಪಾಚಿ ಕಾಮಾ ಕರುನ್ ಲೈ ನಮುನ್ಯಾಚಿ ತರಾಸಾ ದಿತಾ, ತೆಚ್ಯಾ ಮಾನಾ ರಾಜಾ ತುಮ್ಕಾ ಸುಟ್ಕಾ ಕರ್ತಾ.<verse eid="EXO 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 3:21" />“ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಇಜಿಪ್ತಾಚಿ ಲೊಕಾ ದಯಾ ದಾಕ್ವಿ ಸಾರ್ಕೆ ಕರ್ತಾ, ತಸೆ ಹೊವ್ನ್ ತುಮಿ ಥೈತ್ನಾ ಜಾತಾನಾ ಖಾಲಿ ಹಾತಾನಿ ಜಾತಲೆ ಹೊಯ್ನಾ. <verse eid="EXO 3:21" /><verse number="22" style="v" sid="EXO 3:22" />ತುಮ್ಚಿ ಹರ್ ಎಕ್ ಬಾಯ್ಕೊ ಮಾನುಸ್ ಅಜುಭಾಜುಚ್ಯಾ ಬಾಯ್ಕಾಂಚ್ಯಾಕ್ನಾ ಅನಿ ತುಮ್ಚ್ಯಾ ಘರಾತ್ನಿ ಹೊತ್ತ್ಯಾ ಬಾಯ್ಕಾ ಮಾನ್ಸಾಂಚ್ಯಾಕ್ನಾಬಿ ಚಾಂದಿ, ಸೊನ್ಯಾಚಿ ವಸ್ತಾ ಅನಿ ಕಪ್ಡೆ ಮಾಗುನ್ ಘೆಂವ್ದಿತ್, ತೆ ತುಮ್ಚ್ಯಾ ಪೊರಾ ಬಾಳಾಕ್ನಿ ನೆಸ್ವಾ ಅಸೆ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಲುಟಿ ಕರುನ್ ಘೆವ್ನ್ ಜಾತ್ಯಾಶಿ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 3:22" /></para>
  <chapter eid="EXO 3" />
  <chapter number="4" style="c" sid="EXO 4" />
  <para style="s">ದೆವಾನ್ ಮೊಯ್ಜೆಕ್ ದಿವ್ನ್ ಹೊಲ್ಲಿ ಚಮತ್ಕಾರಾಂಚಿ ಬಳ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಜವಾಬ್ ದಿವ್ನ್, “ಖರೆ, ತಿ ಲೊಕಾ ಮಾಜೆರ್ ವಿಶ್ವಾಸ್ ಕರಿನಸ್ತಾನಾ ಮಾಜ್ಯಾ ಗೊಸ್ಟಿಕ್ ಕಾನ್ ದಿಯ್ನಸ್ತಾನಾ ಜಾತಾತ್ ಕಿ ಕಾಯ್ಕಿ, ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ತುಕಾ ದಿಸುಕುಚ್ ನಾ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾರ್ ಮಿಯಾ ಕಾಯ್ ಕರುಚೆ?” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 4:2" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ತೆಕಾ, “ತುಜ್ಯಾ ಹಾತಿತ್ ಹೊತ್ತೆ ಕಾಯ್?”</para>
  <para style="p" vid="EXO 4:2">ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ, ತೆನಿ, “ಹ್ಯೊ, ದಾಂಡೊ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 4:2" /><verse number="3" style="v" sid="EXO 4:3" />ಸರ್ವೆಸ್ಪರಾನ್ ತೆಕಾ, “ತೊ ದಾಂಡೊ ಜಿಮ್ನಿ ವರ್‍ತಿ ಟಾಕ್” ಮಟ್ಲ್ಯಾನ್. ಜಿಮ್ನಿ ವರ್‍ತಿ ಟಾಕ್ತಾನಾಚ್ ತೊ ದಾಂಡೊ ಸಾಪ್ ಹೊಲೊ! ತೆ ಬಗುನ್ ಮೊಯ್ಜೆ ಭಿಂವ್ನ್ ಪಳುನ್ ಗೆಲೊ. <verse eid="EXO 4:3" /><verse number="4" style="v" sid="EXO 4:4" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ತೆಕಾ, “ಹಾತ್ ಫಿಡೆ ಕರುನ್ ತೆಚಿ ಸೆಪ್ಡಿ ಧರ್” ಮಟ್ಲ್ಯಾನ್, ತಸೆಚ್ ಧರಲ್ಲ್ಯಾ ತನ್ನಾ ತೊ ದಾಂಡೊ ಹೊಲೊ. <verse eid="EXO 4:4" /><verse number="5" style="v" sid="EXO 4:5" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ತೆಕಾ, “ಹೆಚ್ಯಾ ವೈನಾ ತಿ ಲೊಕಾ ಅಪ್ಲೆ ಪುರ್ವಜ್ ಅಬ್ರಾಹಾಮ್, ಇಸಾಕ್ ಅನಿ ಜಾಕೊಬಾಚೊ ದೆವ್ ಹೊವ್ನ್ ಹೊತ್ತೊ ಸರ್ವೆಸ್ಪರ್ ತುಕಾ ದಿಸಲೊ ಖರೆಚ್ ಮನ್ತಲೆ ವಿಶ್ವಾಸ್ ಕರ್‍ತಾತ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 4:6" />ಅನಿ ಸರ್ವೆಸ್ಪರಾನ್ ತೆಕಾ, “ತುಜೊ ಹಾತ್ ಛಾತಿ ವೈರ್ ತುಜ್ಯಾ ಅಂಗಿತ್ ಘಾಲ್” ಮಟ್ಲ್ಯಾನ್, ತಸೆಚ್ ತೆನಿ ಛಾತಿ ವೈರ್ ಅಂಗಿತ್ ಥವ್ನ್ ಭಾಯ್ರ್ ಕಾಡಲ್ಯಾ ತನ್ನಾ ಹಾತ್ ಖೊಡ್ ಉಜಳಲ್ಲ್ಯಾ ಸಾರ್ಕೊ ಹೊವ್ನ್ ಬರ್ಪ್ ಸಾರ್ಕೊ ಫಾಂಡ್ರೊ ದಿಸ್ಲೊ. <verse eid="EXO 4:6" /><verse number="7" style="v" sid="EXO 4:7" />ಸರ್ವೆಸ್ಪರಾನ್ ತೆಕಾ “ತುಜೊ ಹಾತ್ ಪರ್‍ತುನ್ ಛಾತಿ ವೈರ್ ಅಂಗಿತ್ ಘಾಲ್” ಮಟ್ಲ್ಯಾನ್, ತಸೆಚ್ ತೆನಿ ಛಾತಿ ವೈರ್ ಭುತ್ತುರ್ ಅಂಗಿತ್ ಘಾಲುನ್ ಭಾಯ್ರ್ ಕಾಡುನ್ ಬಗಲ್ಲ್ಯಾ ತನ್ನಾ ತೊ ಹಾತ್ ಹುರಲ್ಲ್ಯಾ ಆಂಗಾ ಸಾರ್ಕೊಚ್ ಹೊಲೊ. <verse eid="EXO 4:7" /><verse number="8" style="v" sid="EXO 4:8" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ತೆಕಾ, “ತಿ ಲೊಕಾ ತುಜ್ಯಾರ್ ವಿಶ್ವಾಸ್ ಕರಿನಸ್ತಾನಾ ಪೈಲೆಚೆ ಅಜಾಪಾಚೆ ಕಾಮ್ ಅರ್ಥ್ ಕರುನ್ ಘೆವ್ಕ್ ನಸ್ಲ್ಯಾರ್ಬಿ, ದೊನ್ವೆಚೆ ಅರ್ಥ್ ಕರುನ್ ಘೆವ್ನ್ ವಿಶ್ವಾಸ್ ಕರ್‍ತಾತ್”. <verse eid="EXO 4:8" /><verse number="9" style="v" sid="EXO 4:9" />“ಹಿ ದೊನ್ ಅಜಾಪಾಚಿ ಕಾಮಾಬಿ ತೆನಿ ಮನಾಕ್ ಲಾವ್ನ್ ಘೆಯ್ನಸ್ತಾನಾ ಅನಿ ತುಜ್ಯಾ ಬೊಲ್ನ್ಯಾಕ್ನಿ ವಿಶ್ವಾಸ್ ಕರಿನಸ್ತಾನಾ ರಾಲ್ಯಾರ್, ನೈಲ್ ಮನ್ತಲ್ಯಾ ನ್ಹಯ್ಚೆ ಪಾನಿ ಘೆವ್ನ್ ವಾಳ್ಕ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ವೊತ್, ತನ್ನಾ ಜಿಮ್ನಿರ್ ವೊತಲೆ ಪಾನಿ ರಗಾತ್ ಹೊತಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10" />ಖರೆ ಮೊಯ್ಜೆನ್ ಸರ್ವೆಸ್ಪರಾಕ್, “ನಕ್ಕೊ ಧನಿಯಾ ಮಾಕಾ ಧಾಡುನಕ್ಕೊ. ಅದ್ದಿಚ್ಯಾನ್ ಮಾಕಾ ಬೊಲುಕ್ ಕಳಿನಾ; ಅನಿ ತುಮಿ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲ್ಯಾ ಮಾನಾಬಿ ತಸೊಚ್ ಹಾಯ್, ಮಿಯಾ ಫಾಟಿ ಸರಕ್ನಾರೊ, ಮಾಜಿ ಬೊಲ್ನಿ ಸವ್ಕಾಸ್, ಅನಿ ಮಾಜಿ ಜಿಬ್ಲಿ ದಾಟ್”, ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 4:11" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ , “ಮಾನ್ಸಾಕ್ನಿ ತೊಂಡ್ ದಿಲ್ಲೆ ಕೊನ್? ಎಕ್ಲ್ಯಾಕ್ ಮುಕ್ಕೊ ಕರುನ್, ಅನಿ ಎಕ್ಲ್ಯಾಕ್ ಕಿವ್ಡೊ ಕರುನ್, ಅನಿ ಎಕ್ಲ್ಯಾಕ್ ಡೊಳೆ ದಿಸ್ತಲೊ ಕರುನ್, ಅನಿ ಎಕ್ಲ್ಯಾಕ್ ಕುಡ್ಡೊ ಕರುನ್ ಥವ್ತಲೆ ಕೊನ್? ಸರ್ವೆಸ್ಪರ್ ಹೊವ್ನ್ ಹೊತ್ತೊ ಮಿಯಾಚ್ ನ್ಹಯ್ ಕಾಯ್?”<verse eid="EXO 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 4:12" />“ತಸೆ ಹೊವ್ನ್ ಅತ್ತ್ಯಾಚ್ ಜಾ; ತುಕಾ ಬೊಲುಕ್ ಮಿಯಾಚ್ ಮಜ್ಜತ್ ಕರ್ತಾ, ಅನಿ ತಿಯಾ ಕಾಯ್ ಬೊಲುಚೆ ಮನ್ತಲೆ ಮಿಯಾಚ್ ತುಕಾ ಸಾಂಗ್ತಾ”, ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 4:13" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, “ಧನಿಯಾ ದಯಾಕರುನ್, ಹ್ಯಾ ಕಾಮಾಕ್ ತಿಯಾ ದುಶ್ರ್ಯಾ ಕೊನಾಕ್ಬಿ ಧಾಡ್”,<verse eid="EXO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 4:14" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಮೊಯ್ಜೆಚೊ ರಾಗ್ ಯೆಲೊ, ಅನಿ ತೆಕಾ, “ತುಜೊ ಭಾವ್ ಲೆವಿ ಆರೊನ್ ನ್ಹಯ್ ಕಾಯ್? ತೊ ಬರೊ ಕರುನ್ ಬೊಲ್ತಾ ಮನ್ತಲೆ ಮಾಕಾ ಗೊತ್ತ್ ಹಾಯ್, ಅಬಕ್, ತೊಚ್ ತುಕಾ ಭೆಟುಕ್ ಯೆವ್ಲಾ, ಅನಿ ತುಕಾ ಬಗ್ತಾನಾ ತೆಕಾ ಮನಾತ್ ಖುಶಿ ಹೊತಾ”.<verse eid="EXO 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 4:15" />“ತಿಯಾ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲುನ್, ಸಾಂಗುಚಿ ಹೊಲ್ಲಿ ಸಂಗ್ತಿಯಾ ಸಾಂಗ್, ಮಿಯಾ ತೆಕಾ ಅನಿ ತುಕಾ ಕಶೆ ಬೊಲುಚೆ ಮನುನ್ ಮಜ್ಜತ್ ಕರ್ತಾ, ಅನಿ ತುಮಿ ಕಾಯ್ ಕರುಚೆ ಮನ್ತಲೆ ಸಾಂಗ್ತಾ”. <verse eid="EXO 4:15" /><verse number="16" style="v" sid="EXO 4:16" />ತುಜ್ಯಾ ನಾವಾರ್ ತೊಚ್ ಲೊಕಾಂಚ್ಯಾಕ್ಡೆ ಬೊಲ್ತಾ ತೊ ತುಕಾ ತೊಂಡ್ ಸಾರ್ಕೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾ ಅನಿ ತಿಯಾ ತೆಕಾ ದೆವ್ ಸಾರ್ಕೊ ಹೊವ್ನ್ ರ್‍ಹಾತೈ‍. <verse eid="EXO 4:16" /><verse number="17" style="v" sid="EXO 4:17" />“ಹ್ಯೊ ದಾಂಡೊ ಹಾತಿತ್ ಘೆವ್ನ್ ಜಾ, ಹೆಚ್ಯಾನುಚ್ ತಿ ಅಜಾಪಾಚಿ ಕಾಮಾ ಕರ್‍ತೆ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 4:17" /></para>
  <para style="s">ಮೊಯ್ಜೆ ಇಜಿಪ್ತಾಕ್ ಪರ್‍ತುನ್ ಯೆತಲೆ</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18" />ಹೆಜ್ಯಾ ಮಾನಾ ಮೊಯ್ಜೆನ್ ಅಪ್ಲ್ಯಾ ಮಾಮಾ ಜೆತ್ರೊಕ್ಡೆ ಪರ್‍ತುನ್ ಯೆವ್ನ್, “ಮಿಯಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾತ್ ಹೊತ್ಯಾ ಮಾಜ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ಡೆ ಜಾವ್ನ್, ತೆನಿ ಝಿತ್ತೆ ಹಾತ್ಕಿ ಕಾಯ್ ಮನುನ್ ಬಗುನ್ ಯೆತಾ”, ಮನುನ್ ಮಾಗುನ್ಗೆಟ್ಲ್ಯಾನ್, ಜೆತ್ರೊನ್ ತೆಕಾ, “ಬರ್ಯಾನ್ ಜಾವ್ನ್ ಯೆ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 4:19" />ಮಿದ್ಯಾನ್ ಮನ್ತಲ್ಯಾ ಗಾಂವಾತ್ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ತಿಯಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಕ್ ಪರ್‍ತುನ್ ಜಾ, ತುಕಾ ಜಿವ್ ಕಾಡುಚೆ ಮನುನ್ಗೆವ್ನ್ ಹೊತ್ತೆ ಸಗ್ಳೆ ಮರುನ್ ಗೆಲೆ”, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 4:19" /><verse number="20" style="v" sid="EXO 4:20" />ತಸೆ ಹೊವ್ನ್ ಮೊಯ್ಜೆನ್, ಅಪ್ಲ್ಯಾ ಬಾಯ್ಕೊ ಪೊರಾಕ್ನಿ ಎಕ್ ಗಾಡ್ವಾವರ್‍ತಿ ಬಸ್ವುನ್ಗೆವ್ನ್ ಇಜಿಪ್ತ್ ದೆಸಾಕ್ ಜಾವ್ಕ್ ಲಾಗ್ಲೊ, ಅನಿ ತೆನಿ ದೆವಾನ್ ಘೆವ್ನ್ ಜಾ ಮನುನ್ ಸಾಂಗಲ್ಲೊ ದಾಂಡೊ ಹಾತಿತ್ ಧರುನ್ಗೆಟ್ಲ್ಯಾನ್.<verse eid="EXO 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 4:21" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, ಅನಿ ಪರ್‍ತುನ್ ಅಸೆ ಮಟ್ಲ್ಯಾನ್, “ತಿಯಾ ಇಜಿಪ್ತಾಕ್ ಪರ್‍ತುನ್ ಗೆಲ್ಲ್ಯಾ ತನ್ನಾ ಮಿಯಾ ತುಕಾ ದಾಕ್ವುನ್ ದಿಲ್ಲಿ ಅಜಾಪಾಚಿ ಕಾಮಾ ಸಗ್ಳಿ ಫಾರೊವ್ ಮನ್ತಲ್ಯಾ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಕರುನ್ ದಾಕ್ವು, ಖರೆ ಮಿಯಾ ತೆಜೊ ಮನ್ ಗುಂಡ್ಯಾ ಸಾರ್ಕೊ ಕರ್ತಾ, ತೊ ಲೊಕಾಕ್ನಿ ಜಾವ್ಕ್ ದಿಯ್ನಾ”. <verse eid="EXO 4:21" /><verse number="22" style="v" sid="EXO 4:22" />ತನ್ನಾ ತಿಯಾ ತೆಕಾ ಕಳ್ವುಚೆ ಹೊಲ್ಲೆ, “ಸರ್ವೆಸ್ಪರ್ ಸಾಂಗ್ತಲೆ ಆಯ್ಕ್; ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಮಾಕಾ ಲೆಕಾಂಚ್ಯಾ ಸಾರ್ಕಿ ಹಾತ್, ತೊ ಮಾಜೊ ಥೊರ್ಲೊ ಲೆಕುಚ್ ಮನುನ್ ಸಾಂಗುಚೆ”. <verse eid="EXO 4:22" /><verse number="23" style="v" sid="EXO 4:23" />“ಮಾಕಾ ಆರಾದನ್ ಕರುಕ್ ಸಾಟ್ನಿ ಮಾಜ್ಯಾ ಥೊರ್ಲ್ಯಾ ಲೆಕಾಕ್ ತುಜ್ಯಾ ದೆಶ್ಯಾತ್ನಾ ಜಾವ್ಕ್ ಸೊಡ್, ಹೆಕಾ ತಿಯಾ ಮಾನಿ ನಸ್ತಾನಾ ರಾಲ್ಯಾರ್, ಮಿಯಾ ತುಜ್ಯಾ ಥೊರ್ಲ್ಯಾ ಲೆಕಾಕ್ ಜಿವಾನಿ ಮಾರ್‍ತಾ”,<verse eid="EXO 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 4:24" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಇಜಿಪ್ತಾಕ್ ಜಾತಲ್ಯಾ ವಾಟೆರ್ ಹೊತ್ತ್ಯಾ ಘರ್‍ಹಾತ್ ಸರ್ವೆಸ್ಪರ್ ಮೊಯ್ಜೆಚ್ಯಾ ಇದ್ರಾಕ್ ಯೆವ್ನ್ ತೆಜೊ ಜಿವ್ ಕಾಡುಚೆ ಮನುನ್ ಹೊತ್ತೊ. <verse eid="EXO 4:24" /><verse number="25" style="v" sid="EXO 4:25" />ತನ್ನಾ ಜಿಪ್ಪೊರಾನ್ ಎಕ್ ಧಾರ್ಲೊ ಗುಂಡೊ ಘೆವ್ನ್ ಅಪ್ಲ್ಯಾ ಲೆಕಾಕ್ ಸುನ್ನತ್ ಕರ್‍ಲಿನ್, ಅನಿ ತೆಜೊ ಕಾತರಲ್ಲೊ ತುಕ್ಡೊ ಘೆವ್ನ್ ಮೊಯ್ಜೆಚ್ಯಾ ಪಾಂಯಾಕ್ನಿ ಲಾವ್ನ್, ತೆಕಾ “ತಿಯಾ ಮಾಜ್ಯಾ ರಗ್ತಾಚೊ ನ್ಹವ್ರೊ” ಮಟ್ಲಿನ್, ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ತೆಕಾ ಹುರ್ವುಲ್ಯಾನ್. <verse eid="EXO 4:25" /><verse number="26" style="v" sid="EXO 4:26" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ತೆಕಾ ಹುರ್ವುಲ್ಯಾನ್, ತಿನಿ ಸುನ್ನತಿ ಸಾಟ್ನಿಚ್, “ತಿಯಾ ರಗ್ತಾ ವೈನಾ ಹೊಲ್ಲೊ ನ್ಹವ್ರೊ” ಮಟಲ್ಲೆ.<verse eid="EXO 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 4:27" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಭೆಟುಕ್ ಸಾಟ್ನಿ ತಿಯಾ ಡಂಗ್ಳಿಕ್ ಜಾ ಮನುನ್ ಆರೊನಾಕ್ ಸಾಂಗ್ಲ್ಯಾನ್, ತನ್ನಾ ತೊ ಜಾವ್ನ್ ದೆವಾಚ್ಯಾ ಮಡ್ಡಿರ್ ಮೊಯ್ಜೆಕ್ ಭೆಟುನ್ ಉಪ್ಪಾದಿಲ್ಯಾನ್. <verse eid="EXO 4:27" /><verse number="28" style="v" sid="EXO 4:28" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, ಆರೊನಾಕ್ ಅಪ್ನಾಕ್ ಧಾಡಲ್ಲ್ಯಾ ಸರ್ವೆಸ್ಪರಾಚಿ ಸಗ್ಳಿ ಬೊಲ್ನಿಯಾ ಅನಿ, ಅಪ್ನಾಕ್ ಕರುಚೆ ಮನುನ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಅಜಾಪಾಚ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ವಿಶಯಾತ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 4:28" /><verse number="29" style="v" sid="EXO 4:29" />ಮಾನಾ ಮೊಯ್ಜೆ ಅನಿ ಆರೊನ್ ದೊಗೆಬಿ ಜಾವ್ನ್ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಜಾಂನ್ತ್ಯಾ ಲೊಕಾಕ್ನಿ ಗೊಳಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 4:29" /><verse number="30" style="v" sid="EXO 4:30" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಸಾಂಗಲ್ಲಿ ಸಗ್ಳಿ ಗೊಸ್ಟಿಯಾ ಆರೊನಾನ್ ತ್ಯಾ ಲೊಕಾಕ್ನಿ ಸಾಂಗ್ಲ್ಯಾನ್, ಮೊಯ್ಜೆನ್ ತೆಂಚ್ಯಾ ಇದ್ರಾಕ್ ತಿ ಆಜಾಪಾಚಿ ಕಾಮಾ ಕರುನ್ ದಾಕ್ವುಲ್ಯಾನ್. <verse eid="EXO 4:30" /><verse number="31" style="v" sid="EXO 4:31" />ತ್ಯಾ ಲೊಕಾನಿ ತೆಕಾ ವಿಶ್ವಾಸ್ ಕರ್ಲ್ಯಾನಿ. ಸರ್ವೆಸ್ಪರಾನ್ ಇಜ್ರಾಯೆಲಾಂಚಿ ತರಾಸಾ ಮನಾಕ್ ಲಾವ್ನ್ ಘೆವ್ನ್ ಬಗಟ್ಲಾ ಮನ್ತಲೆ ತೆನಿ ಆಯಿಕ್ತಾನಾ ಮಾನ್ ಬಾಗ್ವುನ್ ಆರಾದನ್ ಕರ್ಲ್ಯಾನಿ.<verse eid="EXO 4:31" /></para>
  <chapter eid="EXO 4" />
  <chapter number="5" style="c" sid="EXO 5" />
  <para style="s">ಇಜಿಪ್ತಾಚ್ಯಾ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಮೊಯ್ಜೆ ಅನಿ ಆರೊನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1" />ಮಾನಾ ಮೊಯ್ಜೆ ಅನಿ ಆರೊನ್ ಫಾರೊವ್ ಮನ್ತಲ್ಯಾ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಯೆಲೆ, ಅನಿ “ಇಜ್ರಾಯೆಲಾಂಚೊ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಸಾಂಗ್ತಾ; ಮಾಜಿ ಲೊಕಾ ಡಂಗ್ಳಿತ್ ಮಾಕಾ ಮಾನ್ ದಿವ್ಕ್ ಸಾಟ್ನಿ ಎಕ್ ಸನ್ ಕರುಕ್ ಪಾಜೆ, ತೆಕಾ ತಿಯಾ ಒಪ್ಕಿ ದಿವ್ಚೆ” ಮಟ್ಲ್ಯಾನಿ.<verse eid="EXO 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 5:2" />ತನ್ನಾ ಫಾರೊವ್ ರಾಜಾನ್, “ಸರ್ವೆಸ್ಪರ್ ಮಟ್ಲ್ಯಾರ್ ಕೊನ್? ಮಿಯಾ ತೆಚಿ ಗೊಸ್ಟ್ ಆಯ್ಕುನ್ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಜಾವ್ಕ್ ಸೊಡುಚೆ ಕಾಯ್? ತೊ ಸರ್ವೆಸ್ಪರ್ ಕೊನ್ ಕಿ ಮಾಕಾ ಗೊತ್ತ್ ನಾ, ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ಮಿಯಾ ಜಾವ್ಕ್ ಸೊಡಿನಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 5:2" /><verse number="3" style="v" sid="EXO 5:3" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಅನಿ ಆರೊನಾನ್, “ಇಬ್ರಿಯಾ ಲೊಕಾಂಚೊ ದೆವ್ ಅಮ್ಕಾ ಭೆಟಿ ಹೊಲ್ಲೊ ತಿಯಾ ಒಪ್ಕಿ ದಿಲ್ಯಾರ್, ಅಮಿ ಡಂಗ್ಳಿತ್ ತಿನ್ ದಿಸ್ ಚಲ್ತಲ್ಯಾ ತವ್ಡೆ ಧುರ್ ಜಾವ್ನ್ ಅಮ್ಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಬಲಿ ಭೆಟ್ವುನ್ ಯೆತಾಂವ್, ತಸೆ ಕರಿನಸ್ತಾನಾ ರಾಲ್ಯಾರ್ ತೊ ಅಮ್ಕಾ ಮರ್ನಾಚಿ ಪಿಡಾ ಧಾಡ್ತಲೊ ನಾ ತರ್ ಮೊಟ್ಟ್ಯಾ ಕೊಯ್ತ್ಯಾನ್ ಮಾರುನ್ ನಾ ಕರ್ತಿಲ್” ಮಟ್ಲ್ಯಾನಿ.<verse eid="EXO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 5:4" />ತೆಂಕಾ ತ್ಯಾ ಇಜಿಪ್ತಾಚ್ಯಾ ರಾಜಾನ್, “ಯೆ! ಮೊಯ್ಜೆ ಅನಿ ಆರೊನ್ ತುಮಿ ಹ್ಯಾ ಲೊಕಾಕ್ನಿ ಕಾಮ್ ಸೊಡಿ ಸಾರ್ಕೆ ಕಶ್ಯಾಕ್ ಕರ್ತ್ಯಾಶಿ? ಚಲಾ ಅನಿ ತುಮ್ಚೆ ಗುಲಾಮ್ ಪಾನಾಚೆ ಕಾಮ್ ಕರಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 5:4" /><verse number="5" style="v" sid="EXO 5:5" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಫಾರೊವ್ ರಾಜಾನ್ ತೆಂಕಾ, “ಅಬಕಾ, ಗಾಂವಾತ್ ಹ್ಯಾ ಲೊಕಾಂಚೊ ಅಂಕೊ ಲೈ ಹೊಲಾ! ಹೆನಿ ಅಪ್ಲ್ಯಾ ಕಾಮಾಂತ್ನಾ ಚುಕ್ವುನ್ ಘೆವ್ಕ್ ತುಮಿಚ್ ಕಾರನ್ ಹೊವ್ಲ್ಯಾಸಿ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 5:6" />ತ್ಯಾಚ್ ದಿಸಿ ರಾಜಾನ್ ಅಪ್ಲ್ಯಾ ಜಬರ್ದಸ್ತಿನ್ ಕಾಮ್ ಕರಸ್ತಲ್ಯಾ ಮಾನ್ಸಾಕ್ ಅನಿ ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ಬಗುನ್ ಘೆತಲ್ಯಾಕ್ನಿ ಬಲ್ವುನ್ ಹುಕುಮ್ ಕರುನ್, <verse eid="EXO 5:6" /><verse number="7" style="v" sid="EXO 5:7" />ಹೆಚ್ಯಾ ಮಾನಾ ಲೊಕಾಕ್ನಿ ಇಟಂಗಿಯಾ ಕರುಕ್ ಗವಾತ್ ದಿವ್ ನಕಾಸಿ, ತೆನಿಚ್ ಗವಾತ್ ಹಾನುನ್ ಘೆಂವ್ದಿತ್. <verse eid="EXO 5:7" /><verse number="8" style="v" sid="EXO 5:8" />ಖರೆ ಅದ್ದಿ ಕರಲ್ಲಿ ತವ್ಡಿಚ್ ಇಟಂಗಿಯಾ ತೆನಿ ಕರುಕ್ ಪಾಜೆ ಎಕ್ಬಿ ಕಮ್ಮಿ ಕರುಕ್ನಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೆನಿ ಆಳ್ಸಿ ಹೊವ್ಲಾತ್ ತಸೆ ಹೊವ್ನ್, ತೆನಿ ಅಮಿ ದೆವಾಕ್ ಬಲಿ ಭೆಟ್ವುಕ್ ಜಾತಾಂವ್ ಮನುನ್ ಬೊಬ್ ಮರುಲ್ಲಾತ್. <verse eid="EXO 5:8" /><verse number="9" style="v" sid="EXO 5:9" />ತುಮಿ ತೆಂಚ್ಯಾಕ್ನಾ ಅನಿ ಬಿ ತರಾಸಾಚಿ ಕಾಮಾ ಕರ್ಸುಚೆ, ಲೈ ಕಾಮ್ ಪಡ್ಲ್ಯಾರ್ ಅಸ್ಲ್ಯಾ ಝುಟ್ಯಾ ಕಾನಿಯಾಕ್ನಿ ಕಾನ್ ದಿವ್ಕ್ ತೆಂಕಾ ಎಳ್ ರ್‍ಹಾಯ್ನಾ, ಮನುನ್ ಹುಕುಮ್ ದಿಲ್ಯಾನ್.<verse eid="EXO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 5:10" />ತಸೆ ಹೊವ್ನ್, ಕಾಮ್ ಕರಸ್ತಲ್ಯಾ ಮಕಾದಮ್ಮಾನಿ ಅನಿ ತೆಂಚ್ಯಾ ಸಾವ್ಕಾರಾನಿ ಭಾಯ್ರ್ ಜಾವ್ನ್, ತೆಂಕಾ “ತುಮ್ಕಾ ಗವಾತ್ ದಿವ್ ನಕಾಸಿ ಮನುನ್ ಫಾರೊವ್ ರಾಜಾನ್ ಹುಕುಮ್ ಕರುನ್ ಸಾಂಗ್ಲಾ. <verse eid="EXO 5:10" /><verse number="11" style="v" sid="EXO 5:11" />ಖೈ ಗಾವ್ತಾ ಥೈತ್ನಾ ತುಮಿಚ್ ಗವಾತ್ ಹಾನುನ್ ಘೆವಾ, ಖರೆ ತುಮಿ ಕರ್‍ತಲೆ ಕಾಮ್ ಉಲ್ಲೆಬಿ ಕಮ್ಮಿ ಹೊತಲೆ ನಾ, ಬಗಾ”, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 5:11" /><verse number="12" style="v" sid="EXO 5:12" />‍ ಅಸೆ ರ್‍ಹಾತಾನಾ, ತ್ಯಾ ಲೊಕಾನಿ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾತ್ ಫುರಾ ಫಿರುನ್, ಗವಾತ್ ಗಾಯ್ ನಸ್ತಾನಾ ಹುಡಕ್ಲ್ಯಾನಿ. <verse eid="EXO 5:12" /><verse number="13" style="v" sid="EXO 5:13" />ಅನಿ ತೆನಿ ಜಬರ್ದಸ್ತಿನ್ ಕಾಮ್ ಕರಸ್ತಲೊ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾಚ್ ರಾವ್ನ್, “ತುಮ್ಕಾ ಗವಾತ್ ಗಾವ್ತಲ್ಯಾ ಎಳಾರ್ ಕರಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಹರ್ ಎಕ್ ದಿಸಿಬಿ ತ್ಯಾ ದಿಸಾಚೆ ಕಾಮ್ ತ್ಯಾಚ್ ದಿಸಿ ಸಾರುಕ್ ಪಾಜೆ”, ಮನುನ್ ಗಡ್ಬಡಿ ಕರುನ್ಗೆತ್ ಹೊತ್ತೊ. <verse eid="EXO 5:13" /><verse number="14" style="v" sid="EXO 5:14" />“ತುಮಿ ಇಟ್ಟಂಗಿಯಾ ಕರಲೊ ಇಸಬ್ ಅದ್ದಿ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಕಾಲ್ ಅನಿ ಆಜ್ ಕಶ್ಯಾಕ್ ದಿಯ್ನಾ ಹೊಲ್ಯಾಸಿ?” ಮನುನ್ ತ್ಯಾ ಅಧಿಕಾರಿ ಲೊಕಾನಿ ಅಪ್ನಿಚ್ ನೆಮ್ಸುನ್ ಘೆಟಲ್ಯಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಕಾಮ್ ಕರಸ್ತಲ್ಯಾ ಮಕಾದಮ್ಮಾಕ್ನಿ ಮಾರ್ಲ್ಯಾನಿ.<verse eid="EXO 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 5:15" />ತನ್ನಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಕಾಮ್ ಕರಸ್ತಲ್ಯಾ ಮಕಾದಮ್ಮಾನಿ ರಾಜಾಕ್ಡೆ ಜಾವ್ನ್, “ತಿಯಾ ತುಜ್ಯಾ ಗುಲಾಮಾಕ್ನಿ ಅಸೆ ಕಶ್ಯಾಕ್ ಚಾಲ್ವುತೈಯ್?” <verse eid="EXO 5:15" /><verse number="16" style="v" sid="EXO 5:16" />“ಅಧಿಕಾರಿ ಲೊಕಾ ಗಾಂವಾತ್ ಗವಾತ್ ದಿಯ್ನಸ್ತಾನಾ ಇಟಂಗಿಯಾ ಕರುಚೆ ಮನ್ತಾತ್!, ಹೆಚ್ಯಾ ವೈನಾ ಗುಲಾಮ್ ಹೊವ್ನ್ ಹೊತ್ತೆ ಅಮಿ ಮಾರ್ ಖಾತಲೆ ಹೊಲೆ, ಚುಕ್ ತುಜ್ಯಾಚ್ ಲೊಕಾಂಚಿ ಹಾಯ್” ಮಟ್ಲ್ಯಾನಿ. <verse eid="EXO 5:16" /><verse number="17" style="v" sid="EXO 5:17" />ತನ್ನಾ ರಾಜಾನ್, “ತುಮಿ ಖರೆಚ್ಬಿ ಆಳ್ಸಿ ಹಾಸಿ! ತ್ಯಾ ಕಾರನಾ ಸಾಟ್ನಿಚ್ ಅಮಿ ಜಾವ್ನ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಬಲಿ ಭೆಟ್ವುನ್ ಯೆತಾಂವ್ ಮನ್ತ್ಯಾಸಿ. <verse eid="EXO 5:17" /><verse number="18" style="v" sid="EXO 5:18" />ಚಲಾ ಕಾಮ್ ಕರಾ, ತುಮ್ಕಾ ಗವಾತ್ ದಿವ್ಕ್ ಹೊಯ್ನಾ, ಖರೆ ತುಮಿ ಇಟಂಗಿಯಾಂಚೊ ಹಿಸಾಬ್ ಸಮಾಚ್ ದಿವ್ಕ್ ಪಾಜೆ,” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 5:18" /><verse number="19" style="v" sid="EXO 5:19" />ಸದ್ದಾ ಇಟಂಗಿಯಾಂಚೊ ಹಿಸಾಬ್ ಕಮ್ಮಿ ಕರಿನಸ್ತಾನಾ ದಿವ್ಚೆ, ಮನುನ್ ರಾಜಾನ್ ಕಠಿನ್ ಹುಕುಮ್ ದಿಲ್ಯಾ ಸಾಟ್ನಿ, ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಕಾಮಾ ಕರಸ್ತಲ್ಯಾ ಮಕಾದಮ್ಮಾನಿ ಅನಿ ಲೊಕಾನಿ ಅಪ್ನಿ ಲೈ‍ ತರಾಸಾತ್ ಪಡ್ಲಾಂವ್ ಮನ್ತಲೆ ಕಳ್ವುನ್ ಘೆಟ್ಲ್ಯಾನಿ.<verse eid="EXO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 5:20" />ತೆನಿ ಫಾರೊವ್ ರಾಜಾಕ್ನಾ ಪರ್‍ತುನ್ ಜಾತಾನಾ, ಮೊಯ್ಜೆ ಅನಿ ಆರೊನಾನ್ ತೆಂಕಾ ಭೆಟುಕ್ ವಾಟ್ ರಾಕಿತ್ ಹೊತ್ತೆ. <verse eid="EXO 5:20" /><verse number="21" style="v" sid="EXO 5:21" />ತೆಂಕಾ ತ್ಯಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಕಾಮ್ ಕರಸ್ತಲ್ಯಾ ಮಕಾದಮ್ಮಾನಿ, ತುಮಿ ಕರಲ್ಲೆ ಹೆ ಬುರ್ಸೆ ಕಾಮ್ ಬಗುನ್, ಸರ್ವೆಸ್ಪರ್ ತುಮ್ಕಾ ಸಮಾ ಶಿಕ್ಷ್ಯಾ ದಿಂವ್ದಿತ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ರಾಜಾಕ್ ಅನಿ ತೆಚ್ಯಾ ಸೆವಕಾಕ್ನಿ ಅಮ್ಕಾ ಬಗಟ್ಲ್ಯಾರ್ ಕುಸ್ಡೆಪಾನ್ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾಸಿ, ತೆಂಚ್ಯಾ ಹಾತಾತ್ನಿ ಅಮ್ಕಾ ಜಿವ್ ಕಾಡುಕ್ ಕೊಯ್ತೊ ದಿಲೆ ಸಾರ್ಕೆ ಹೊಲಾ; ಮನುನ್ ಚಾಡಿಯಾ ಸಾಂಗ್ಲ್ಯಾನಿ.<verse eid="EXO 5:21" /></para>
  <para style="s">ಮೊಯ್ಜೆನ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಚಾಡಿಯಾ ಸಾಂಗಲ್ಲೆ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಅನಿ ಪರ್‍ತುನ್ ಯೆವ್ನ್, “ಧನಿಯಾ, ಹ್ಯಾ ಲೊಕಾಕ್ನಿ ಅಶೆ ಕಶ್ಯಾಕ್ ಕರ್‍ಲೆ? ಮಾಕಾ ಕಶ್ಯಾಕ್ ಹಿತ್ತೆ ಧಾಡ್ಲೈ? <verse eid="EXO 5:22" /><verse number="23" style="v" sid="EXO 5:23" />ಮಿಯಾ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಜಾವ್ನ್ ತುಜ್ಯಾ ನಾವಾನ್ ಬೊಲಲ್ಯಾ ದಿಸಾಕ್ನಾ ತೊ ಹ್ಯಾ ಲೊಕಾಕ್ನಿ ಬುರ್ಸೆಚ್ ಕರುಲ್ಲಾ, ತಿಯಾ ತರ್ ತೆಂಕಾ ಸುಟ್ಕಾ ಕರುಕ್ ಕಾಯ್ಬಿ ಕರುಕ್ ನ್ಹಯ್,” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 5:23" /></para>
  <chapter eid="EXO 5" />
  <chapter number="6" style="c" sid="EXO 6" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್; “ಮಿಯಾ ಫಾರೊವ್ ರಾಜಾಕ್ ಕಾಯ್ ಕರ್ತಾ ಮನ್ತಲೆ ತಿಯಾ ಲಗ್ಗುನಾಚ್ ಬಗ್ತೈಯ್; ತೊ ಮಾಜ್ಯಾ ಭುಜೆಚಿ ಬಳ್ ಬಗುನ್ ತೆಂಕಾ ಜಾವ್ಕ್ ಸೊಡ್ತಾ, ಮಾಜ್ಯಾ ಹಾತಿಚ್ಯಾ ಬಳಾ ವೈನಾ ತರಾಸಾತ್ ಪಡುನ್ ತೆಂಕಾ ಅಪ್ಲ್ಯಾ ದೆಶ್ಯಾತ್ನಾ ಪಳ್ಸುನ್ ಘಾಲ್ತಾ,” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 6:1" /></para>
  <para style="s">ದೆವಾನ್ ಮೊಯ್ಜೆಕ್ ಬಲ್ವಲ್ಲೆ</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2" />ದೆವಾನ್ ಮೊಯ್ಜೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಪರ್‍ತುನ್ ಬೊಲುನ್, ಮಿಯಾ ಸರ್ವೆಸ್ಪರ್ ,<verse eid="EXO 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 6:3" />ಅಬ್ರಾಹಾಮ್, ಇಸಾಕ್ ಅನಿ ಜಾಕೊಬಾಕ್ನಿ ಮಿಯಾ “ಸಗ್ಳೆಬಿ ಕರುಕ್ ಶಕ್ತ್ ಹೊತ್ತೊ ದೆವ್” ಮನುನ್ ದಾಕ್ವುನ್ ಘೆಟಲ್ಲೊ ತವ್ಡೆಚ್ ಖರೆ ಸರ್ವೆಸ್ಪರ್ ಯಾಹ್ವೆ ಮನ್ತಲ್ಯಾ ನಾವಾನ್ ಮಾಜಿ ವಳಕ್ ಕರುನ್ ದಿವ್ಕ್ ನಾ. <verse eid="EXO 6:3" /><verse number="4" style="v" sid="EXO 6:4" />ಮಿಯಾ, ತೆನಿ ಪರ್ವಾಸಾಕ್ ಗೆಲ್ಲೆ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಕಾನಾನ್ ದೆಶ್ಯಾಕ್ ಸ್ವತಾಚೆ ಕರುನ್ ತೆಂಕಾ ದಿತಾ, ಮನುನ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಕರಾರ್ ಕರುನ್ಗೆಟ್ಲಾ. <verse eid="EXO 6:4" /><verse number="5" style="v" sid="EXO 6:5" />ಅನಿ ಇಜಿಪ್ತಾತ್ಲ್ಯಾ ಲೊಕಾನಿ ಗುಲಾಮ್ ಕರುನ್ ಥವ್ನ್ ಘೆಟಲ್ಯಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚೆ ಅಳಾಪ್ ಮಾಕಾ ಆಯ್ಕ್ಲಾ, ಅನಿ ಮಿಯಾ ದಿಲ್ಲೊ ಕರಾರ್ ಯಾದ್ ಕರುನ್ಗೆಟ್ಲಾ. <verse eid="EXO 6:5" /><verse number="6" style="v" sid="EXO 6:6" />ತಸೆ ಹೊವ್ನ್, ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ಅಸೆ ಸಾಂಗ್ “ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ , ಇಜಿಪ್ತಾಚ್ಯಾನಿ ತುಮ್ಚ್ಯಾ ವರ್‍ತಿ ವಾವಲ್ಲ್ಯಾ ವಜ್ಜ್ಯಾ ಕಾಮಾಂತ್ನಾ ತುಮ್ಕಾ ಭಾಯ್ರ್ ಕಾಡ್ತಾ ಅನಿ ಗುಲಾಮ್ ಗಿರಿತ್ನಾ ಸೊಡ್ಸುತಾ, ಮಾಜೊ ಹಾತ್ ಫಿಡೆ ಕರುನ್ ತೆಂಕಾ ಮೊಟಿ ಶಿಕ್ಷ್ಯಾ ಲಾವ್ನ್ ತುಮ್ಕಾ ಸುಟ್ಕಾ ಕರ್ತಾ. <verse eid="EXO 6:6" /><verse number="7" style="v" sid="EXO 6:7" />ಮಿಯಾ ತುಮ್ಕಾ ಮಾಜಿ ಲೊಕಾ ಕರುನ್ಗೆತಾ, ಅನಿ ಮಿಯಾ ತುಮ್ಚೊ ದೆವ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾನಿ ತುಮ್ಚ್ಯಾ ವರ್‍ತಿ ವಾವಲೆ ವಜ್ಜೆ ಕಾಮ್ ಮನ್ತಲ್ಯಾ ಗುಲಾಮ್ ಗಿರಿತ್ನಾ ಸುಟ್ಕಾ ಕರಲ್ಲ್ಯಾ ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮನ್ತಲೆ ತುಮ್ಕಾ ಕಳುನ್ ಯೆತಾ. <verse eid="EXO 6:7" /><verse number="8" style="v" sid="EXO 6:8" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಅಬ್ರಾಹಾಮ್, ಇಸಾಕ್ ಅನಿ ಜಾಕೊಬಾಕ್ ದಿತಾ ಮನುನ್ ಭಾಸ್ ಥವ್ನ್ ದಿಲ್ಲ್ಯಾ ದೆಶ್ಯಾಕ್ ತುಮ್ಕಾ ಪಾವ್ಸುತಾ, ತೊ ತುಮ್ಕಾ ಸ್ವತಾಚೊ ದೆಶ್ ಕರುನ್ ದಿತಾ, ಸರ್ವೆಸ್ಪರ್ ಮಿಯಾಚ್ ಮನುನ್ ತೆಂಕಾ ಸಾಂಗ್” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 6:8" /><verse number="9" style="v" sid="EXO 6:9" />ಮೊಯ್ಜೆನ್ ಹಿ ಗೊಸ್ಟಿಯಾ ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ಕಳ್ವುಲ್ಯಾನ್, ಹೊಲ್ಯಾರ್ಬಿ ತೆನಿ ತೆಚ್ಯಾ ಬೊಲ್ನ್ಯಾಕ್ನಿ ಕಾನ್ ದಿವ್ಕ್ ನಾತ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೆಂಚೊ ಮನ್ ಮೊಡಲ್ಲೊ ಹೊತ್ತೊ, ಅನಿ ತೆಂಚೆ ಗುಲಾಮ್ ಗಿರಿಚೆ ಕಾಮ್ ತವ್ಡೆಚ್ ಲೈ ಕಠಿನ್ ಹೊಲ್ಲೆ ಹೊತ್ತೆ.<verse eid="EXO 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 6:10" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, <verse eid="EXO 6:10" /><verse number="11" style="v" sid="EXO 6:11" />“ಜಾ ಅನಿ ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ಹ್ಯಾ ದೆಶ್ಯಾತ್ನಾ ಜಾವ್ಕ್ ಸೊಡ್ ಮನುನ್ ಇಜಿಪ್ತಾಚೊ ರಾಜಾ ಫಾರೊವಾಕ್ ಸಾಂಗ್” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 6:12" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ, “ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಚ್ ಮಾಜಿ ಗೊಸ್ಟ್ ಆಯ್ಕಿನಾ ಹೊಲಾತ್, ಅನಿ ಫಾರೊವ್ ರಾಜಾ ಆಯ್ಕ್ತಲೊ ಕಾಯ್? ಮಿಯಾ ಬೊಲ್ನ್ಯಾತ್ನಿ ಬಿ ಕಾಯ್ ತವ್ಡೊ ಹುಶ್ಯಾರ್ ನ್ಹಯ್” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 6:12" /><verse number="13" style="v" sid="EXO 6:13" />ಸರ್ವೆಸ್ಪರಾನ್ , ಮೊಯ್ಜೆ ಅನಿ ಆರೊನಾಕ್ಡೆ ಬೊಲುನ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾಕ್ಡೆ ಅನಿ ಫಾರೊವ್ ರಾಜಾಕ್ಡೆ ಜಾವ್ಚೆ ಅನಿ ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ಇಜಿಪ್ತಾಕ್ನಾ ಭಾಯ್ರ್ ಕಾಡುಚೆ ಮನುನ್ ತೆಂಕಾ ಹುಕುಮ್ ದಿಲ್ಯಾನ್.<verse eid="EXO 6:13" /></para>
  <para style="s">ಮೊಯ್ಜೆ ಅನಿ ಆರೊನಾಚಿ ವಂಶಾವಳಿ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 6:14" />ತೆಂಚ್ಯಾ ಘರಾನಾಚಿ ಮುಳಾಚಿ ಘವ್ಮಾನ್ಸಾ ಹಿಚ್ ತಿ; ಜಾಕೊಬಾಚ್ಯಾ ಥೊರ್ಲ್ಯಾ ಲೆಕಾಚೊ ಲೆಕ್ ರುಬೆನಾಚಿ ಲೆಕಾ, ಹನೊಕ್, ಫಲ್ಲು, ಹೆಚ್ರೊನ್, ಅನಿ ಕಾರ್ಮಿ ಹೆನಿಚ್ ರುಬೆನಾಚ್ಯಾ ಖಂದಾನಾಚಿ ಪುರ್ವಜಾ. <verse eid="EXO 6:14" /><verse number="15" style="v" sid="EXO 6:15" />ಸಿಮೊನಾಚೊ ಲೆಕ್ ಜೆಮುಯೆಲ್, ಜಾಮಿನ್, ಒಹಾದ್, ಜಾಕಿನ್, ಜೊಹರ್ ಅನಿ ಕಾನಾನಾಂಚ್ಯಾ ಬಾಯ್ಕೊಮಾನ್ಸಿಕ್ ಉಪಾಜಲ್ಲೊ ಲೆಕ್ ಸಾವ್ಲ್ ಹೆನಿ ಸಿಮೊನಾಚ್ಯಾ ಖಂದಾನಾಚಿ ಪುರ್ವಜಾ. <verse eid="EXO 6:15" /><verse number="16" style="v" sid="EXO 6:16" />ಲೆವಿಚ್ಯಾ ಲೆಕಾಂಚಿ ಅನಿ ತೆಂಚ್ಯಾ ಖಂದಾನಾ ಪುರ್ವಜಾಂಚಿ ನಾವಾ ಗೆರ್ಶೊನ್‍, ಕೊಹಾತ್ ಅನಿ ಮೆರಾರಿ, ಲೆವಿನ್ 137 ವರಿಸ್ ಜಿವನ್ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 6:16" /><verse number="17" style="v" sid="EXO 6:17" />ಗೆರ್ಶೊನಾಚಿ ಲೆಕಾ ಲಿಬ್ನಿ ಅನಿ ಶಿಮ್ಮಿಯಿ ಅನಿ ತೆಂಚ್ಯಾ ಖಂದಾನಾಚೆ. <verse eid="EXO 6:17" /><verse number="18" style="v" sid="EXO 6:18" />ಕೊಹಾತಾಚಿ ಲೆಕಾ, ಅಮ್ರಾಮ್, ಇಜರಾರ್, ಹೆಬ್ರೊನ್ ಅನಿ ಉಜ್ಜಿಯೆಲ್, ಕೊಹಾತಾನ್ ಎಕ್ಸೆ ತಿಸಾರ್ ತಿನ್ ವರ್ಸಾ ಜಿವನ್ ಕರ್ಲ್ಯಾನ್ . <verse eid="EXO 6:18" /><verse number="19" style="v" sid="EXO 6:19" />ಮೆರಾರಿಚಿ ಲೆಕಾ, ಮ್ಹಾಲಿ ಅನಿ ಮುಶಿ ಹೆನಿ ಲೆವಿಚ್ಯಾ ಕುಳಿಚಿ ಪುರ್ವಜಾ ಹೊವ್ನ್ ಹಾತ್.<verse eid="EXO 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 6:20" />ಅಮ್ರಾಮಾನ್ ಅಪ್ಲ್ಯಾ ಬಾಬಾಚಿ ಭೆನ್ ಚೊಕೆಬೆದಾ ಮನ್ತಲಿಕ್ ಲಗಿನ್ ಕರುನ್ ಘೆಟ್ಲ್ಯಾನ್, ತಿಚ್ಯಾಕ್ನಾ ಆರೊನ್ ಅನಿ ಮೊಯ್ಜೆ ಉಪಾಜ್ಲೆ, ಅಮ್ರಾಮಾನ್ 137 ವರ್ಸಾ ಜಿವನ್ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 6:20" /><verse number="21" style="v" sid="EXO 6:21" />ಇಜ್ಹಾರಾಚಿ ಲೆಕಾ ಕೊರಾ, ನೆಪಾಗ್ ಅನಿ ಜಿಕ್ರಿ. <verse eid="EXO 6:21" /><verse number="22" style="v" sid="EXO 6:22" />ಉಜ್ಜಿಯೆಲಾಚಿ ಲೆಕಾ; ವಿಶಾಯೆಲ್, ಎಲ್ಜಾಫಾನ್ ಅನಿ ಸಿತ್ರಿ.<verse eid="EXO 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 6:23" />ಆರೊನಾನ್ ಅಮ್ಮಿನಾದಾಬಾಚಿ ಲೆಕ್ ಅನಿ ನ್ಹಾಕೊನಾಚಿ ಭೆನ್ ಯೆಲಿಕೆಬ್ ಮನ್ತಲಿಕ್ ಲಗಿನ್ ಕರುನ್ಗೆಟ್ಲ್ಯಾನ್, ಅನಿ ತಿಕಾ ನಾದಬ್ ಅನಿ ಅಬಿಹು, ಎಲಿಯಾಜರ್ ಅನಿ ಇತಾಮಾರ್ ಮನ್ತಲಿ ಪೊರಾ ಉಪಜ್ಲಿ. <verse eid="EXO 6:23" /><verse number="24" style="v" sid="EXO 6:24" />ಕೊರಾಚಿ ಪೊರಾ, ಅಸ್ಸಿರ್, ಎಲ್ಕಾನಾ ಅನಿ ಅಭಿಯಾಸಾಪ್ ಹೆನಿಚ್ ಕೊರಹಿ ಲೊಕಾಂಚ್ಯಾ ಕುಳಿಚಿ ಪುರ್ವಜಾ. <verse eid="EXO 6:24" /><verse number="25" style="v" sid="EXO 6:25" />ಆರೊನಾಚೊ ಲೆಕ್ ಎಲಿಯಾಜರ್ ಮನ್ತಲ್ಯಾನ್ ಪುಟಿಯೆಲಾಚ್ಯಾ ಲೆಕಿಕ್ ಎಕ್ಲಿಕ್ ಲಗಿನ್ ಕರುನ್ಗೆಟ್ಲ್ಯಾನ್, ತಿಕಾ ಫಿನೆಹಾಸನ್ ಮನ್ತಲೊ ಲೆಕ್ ಉಪಜ್ಲೊ, ತೆಂಚ್ಯಾ ಖಂದಾನಾಚ್ಯಾ ಹಿಸಾಬಾ ಸಾರ್ಕೆ ಹೆನಿಚ್ ಲೆವಿಯಾ ಲೊಕಾಂಚಿ ಪುರ್ವಜಾ.<verse eid="EXO 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 6:26" />ಅಪ್ಲ್ಯಾ ಅಪ್ಲ್ಯಾ ಕುಳಿಚ್ಯಾ ಸಾರ್ಕೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಕ್ನಾ ಬಲ್ವುನ್ ಹಾನುಕ್ ಸರ್ವೆಸ್ಪರಾಕ್ನಾ ಹುಕುಮ್ ಘೆಟಲ್ಲೆ ಮೊಯ್ಜೆ ಅನಿ ಆರೊನ್ ಹೆನಿಚ್. <verse eid="EXO 6:26" /><verse number="27" style="v" sid="EXO 6:27" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಇಜಿಪ್ತ್ ದೆಸಾಕ್ನಾ ಭಾಯ್ರ್ ಹಾನುಕ್ ಇಜಿಪ್ತಾಚೊ ರಾಜಾ ಫಾರೊವ್ ಮನ್ತಲ್ಯಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲಲೆ ಮೊಯ್ಜೆ ಅನಿ ಆರೊನ್ ಹೆನಿಚ್.<verse eid="EXO 6:27" /></para>
  <para style="s">ಮೊಯ್ಜೆ ಅನಿ ಆರೊನಾಕ್ ಸರ್ವೆಸ್ಪರಾಚೊ ಹುಕುಮ್</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 6:28" />ಸರ್ವೆಸ್ಪರಾನ್ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಮೊಯ್ಜೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲುನ್, <verse eid="EXO 6:28" /><verse number="29" style="v" sid="EXO 6:29" />“ಮಿಯಾ ಸರ್ವೆಸ್ಪರ್ , ಮಿಯಾ ತುಕಾ ಸಾಂಗ್ತಲೆ ಸಗ್ಳೆ ತಿಯಾ ಇಜಿಪ್ತಾಚೊ ರಾಜಾ ಫಾರೊವ್ ಮನ್ತಲ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ಸಾಂಗುಚೆ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 6:29" /><verse number="30" style="v" sid="EXO 6:30" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, “ಧನಿಯಾ ಮಿಯಾ ಬೊಲ್ತಲ್ಯಾತ್ ತೊದಲ್ತಾ, ಫಾರೊವ್ ಮನ್ತಲೊ ರಾಜಾ ಮಾಜೆ ಬೊಲ್ನೆ ಕಶೆ ಆಯಿಕ್ತಾ?” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 6:30" /></para>
  <chapter eid="EXO 6" />
  <chapter number="7" style="c" sid="EXO 7" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ಅಬಕ್ ಮಿಯಾ ತುಕಾ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ದೆವಾಚೊ ರಾಯಭಾರಿ ಕರುನ್ ಥವ್ಲಾ. ತುಚೊ ಅನ್ನಾ ಆರೊನ್ ತುಜ್ಯಾ ಸಾಟ್ನಿ ಪರ್ವಾದಿ ಹೊವ್ನ್ ಬೊಲ್ತಾ”. <verse eid="EXO 7:1" /><verse number="2" style="v" sid="EXO 7:2" />“ಮಿಯಾ ತುಕಾ ಹುಕುಮ್ ದಿಲ್ಲೆ ಸಗ್ಳೆ ತಿಯಾ ಸಾಂಗುಚೆ. ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ಹ್ಯಾ ದೆಸಾತ್ನಾ ಜಾವ್ಕ್ ಒಪ್ಕಿ ದಿವ್ಚೆ ಮನುನ್ ತುಜೊ ಅನ್ನಾ ಆರೊನಾಚ್ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಬೊಲುಚೊ. <verse eid="EXO 7:2" /><verse number="3" style="v" sid="EXO 7:3" />ಹೊಲ್ಯಾರ್ಬಿ ಮಿಯಾ ಫಾರೊವ್ ರಾಜಾಚೊ ಮನ್ ಕಟಿನ್ ಕರುನ್, ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಲೈ ಅಜಾಪಾಚಿ ಕಾಮಾ ಅನಿ ಚಮತ್ಕಾರ್ ಕರುನ್ ಮಾಜಿ ಬಳ್ ದಾಕ್ವುತಾ. <verse eid="EXO 7:3" /><verse number="4" style="v" sid="EXO 7:4" />ಫಾರೊವ್ ರಾಜಾ ತುಜಿ ಗೊಸ್ಟ್ ಆಯ್ಕಿನಾ, ತನ್ನಾ ಮಿಯಾ ಇಜಿಪ್ತಾಚಾಕ್ನಿ ಲೈ ತರಾಸ್ ಅನಿ ಶಿಕ್ಷ್ಯಾ ದಿವ್ನ್, ಮಾಜ್ಯಾ ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಸೈನಿಕಾಕ್ನಿ ಭಾಯ್ರ್ ಹಾನ್ತಾ. <verse eid="EXO 7:4" /><verse number="5" style="v" sid="EXO 7:5" />ಮಿಯಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ವಿರೊಧ್ ಹೊವ್ನ್ ತೆಂಚ್ಯಾ ಮದ್ನಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಭಾಯ್ರ್ ಹಾನಲ್ಲ್ಯಾ ತನ್ನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ಇಜಿಪ್ತಾಚಿ ಲೊಕಾ ಕಳ್ವುನ್ ಘೆತಾತ್”, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 7:5" /><verse number="6" style="v" sid="EXO 7:6" />ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಹುಕುಮಾ ಸಾರ್ಕೆಚ್ ಮೊಯ್ಜೆನ್ ಅನಿ ಆರೊನಾನ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 7:6" /><verse number="7" style="v" sid="EXO 7:7" />ಫಾರೊವ್ ರಾಜ್ಯಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ತಾನಾ ಮೊಯ್ಜೆಕ್ ಆಯ್ಸಿ ಅನಿ ಆರೊನಾಕ್ ಆಯ್ಸಿರ್ ತಿನ್ ವರ್ಸಾ ಹೊಲ್ಲಿ.<verse eid="EXO 7:7" /></para>
  <para style="s">ಆರೊನಾಚೊ ದಾಂಡೊ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8" />ಮೊಯ್ಜೆ ಅನಿ ಆರೊನ್ ವಾಂಗ್ಡಾ ಸರ್ವೆಸ್ಪರಾನ್ ಬೊಲುನ್, <verse eid="EXO 7:8" /><verse number="9" style="v" sid="EXO 7:9" />“ಫಾರೊವ್ ರಾಜಾನ್ ತುಮ್ಕಾ, ‘ಮಿಯಾ ಸಾಂಗ್ತಲೆ ವಿಶ್ವಾಸ್ ಕರುಚೆ ಹೊಲ್ಯಾರ್ ಅಜಾಪಾಚಿ ಕಾಮಾ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಕರುನ್ ದಾಕ್ವು’ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾರ್, ಮೊಯ್ಜೆನ್ ಆರೊನಾಕ್, ‘ತುಜ್ಯಾ ಹಾತಿತ್ಲೊ ದಾಂಡೊ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಜಿಮ್ನ್ ವರ್‍ತಿ ಟಾಕ್’ ಮನುನ್ ಸಾಂಗುಚೆ, ತೊ ದಾಂಡೊ ಸಾಂಪ್ ಹೊತಾ” <verse eid="EXO 7:9" /><verse number="10" style="v" sid="EXO 7:10" />ಮೊಯ್ಜೆ ಅನಿ ಆರೊನ್ ಫಾರೊವ್ ರಾಜಾಕ್ಡೆ ಗೆಲೆ, ಅನಿ ಸರ್ವೆಸ್ಪರಾನ್ ಅಪ್ನಾಕ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್, ಆರೊನಾನ್ ಅಪ್ನಾಚ್ಯಾ ಹಾತಿತ್ಲೊ ದಾಂಡೊ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಅನಿ ಸೈನಿಕಾಂಚ್ಯಾ ಅನಿ ಅಧಿಕಾರಿಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಜಿಮ್ನಿ ವರ್‍ತಿ ಟಾಕಲ್ಲ್ಯಾ ತನ್ನಾ ತೊ ದಾಂಡೊ ಸಾಂಪ್ ಹೊಲೊ. <verse eid="EXO 7:10" /><verse number="11" style="v" sid="EXO 7:11" />ಫಾರೊವ್ ರಾಜಾನ್ ಇಜಿಪ್ತ್ ದೆಸಾತ್ಲ್ಯಾ ಬುದ್ವಂತಾ ಅನಿ ಮೊಡ್ಗಾರಾಕ್ನಿ ಬಲ್ವುನ್, ತೆನಿಬಿ ಅಪ್ಲ್ಯಾ ಮೊಡಿನ್ ಆರೊನಾಚ್ಯಾ ಸಾರ್ಕೆ ಸಾಂಪ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 7:11" /><verse number="12" style="v" sid="EXO 7:12" />ತೆನಿಬಿ ಅಪ್ಲ್ಯಾ ಹಾತಿತ್ಲೆ ದಾಂಡೆ ಜಿಮ್ನಿ ವರ್‍ತಿ ಟಾಕಲ್ಲ್ಯಾ ತನ್ನಾ ತೆ ದಾಂಡೆಬಿ ಸಾಂಪಾ ಹೊಲಿ, ಖರೆ ಆರೊನಾಚ್ಯಾ ದಾಂಡ್ಯಾನ್ ತೆಂಚ್ಯಾ ದಾಂಡ್ಯಾಕ್ನಿ ಗಿಳ್ಳ್ಯಾನ್. <verse eid="EXO 7:12" /><verse number="13" style="v" sid="EXO 7:13" />ಸರ್ವೆಸ್ಪರಾನ್ ಅದ್ದಿಚ್ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆ ಫಾರೊವ್ ರಾಜಾಚೊ ಮನ್ ಲೈ ಕಠಿನ್ ಹೊಲೊ. ತೆನಿ ತೆಂಚ್ಯಾ ಗೊಸ್ಟಿಯಾಕ್ನಿ ಕಾನ್ ದಿವ್ಕ್ ನಾ.<verse eid="EXO 7:13" /></para>
  <para style="s">ಇಜಿಪ್ತಾಚ್ಯಾ ವರ್‍ತಿ ಯೆಲ್ಲಿ ತರಾಸಾ</para>
  <para style="s1">ರಗಾತ್</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, ಫಾರೊವ್ ರಾಜಾ ಲೈ ಮಂಡ್ ಪನ್ ಕರುಲ್ಲಾ, ತೊ ಲೊಕಾಕ್ನಿ ಜಾವ್ಕ್ ಒಪ್ಕಿ ದಿಯ್ನಾ ಮನುಲ್ಲಾ. <verse eid="EXO 7:14" /><verse number="15" style="v" sid="EXO 7:15" />ತಸೆಹೊವ್ನ್, ಸಕ್ಕಾಳಿ ತಿಯಾ ಫಾರೊವ್ ರಾಜಾಕ್ಡೆ ಜಾ, ನ್ಹಯಿಕ್ಡೆ ಜಾಯ್ತ್ ರ್‍ಹಾತಾನಾ, ತಿಯಾ ತೆಕಾ ಭೆಟುಕ್ ಸಾಟ್ನಿ ನೈಲ್ ಮನ್ತಲ್ಯಾ ನ್ಹಯ್ಚ್ಯಾ ದಂಡೆಕುಚ್ ಜಾವ್ನ್ ಇಬೆ ರಾ, ಸಾಪ್ ಹೊಲ್ಲೊ ದಾಂಡೊ ತುಜ್ಯಾ ಹಾತಿತ್ ರಾಂವ್ದಿತ್. <verse eid="EXO 7:15" /><verse number="16" style="v" sid="EXO 7:16" />ತನ್ನಾ ರಾಜಾಕ್, “ಇಬ್ರಿಯಾಂಚೊ ದೆವ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಸರ್ವೆಸ್ಪರಾನ್ ಸಾಂಗಲಿ ಗೊಸ್ಟ್ ಹಿ; ಡಂಗ್ಳಿತ್ ಜಾವ್ನ್ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಆರಾದನ್ ಕರುಕ್ ಒಪ್ಕಿ ದಿ ಮನುನ್ ತುಕಾ ಹುಕುಮ್ ದಿಲೊ, ಖರೆ ತಿಯಾ ಅಜುನ್ ಪತರ್ ತೆಕಾ ದ್ಯಾನ್ ದಿವ್ಕ್ ನ್ಹಯ್, <verse eid="EXO 7:16" /><verse number="17" style="v" sid="EXO 7:17" />ತಸೆ ಹೊವ್ನ್, ಸರ್ವೆಸ್ಪರ್ ಹೊವ್ನ್ ಹೊತ್ತೊ ಮಿಯಾ ಅನಿಬಿ ಸಾಂಗ್ತಾ; ತಿಯಾ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳ್ವುನ್ ಘೆಯ್ ಸಾರ್ಕೆ ಮಾಜ್ಯಾ ಸೆವಕಾಚ್ಯಾ ಹಾತಿತ್ ಹೊತ್ತ್ಯಾ ದಾಂಡ್ಯಾನ್ ನೈಲ್ ಮನ್ತಲ್ಯಾ ನ್ಹಯಿಚ್ಯಾ ಪಾನಿಯಾಕ್ ಮಾರ್‍ತಾ, ತನ್ನಾ ತೆ ರಗಾತ್ ಹೊತಾ. <verse eid="EXO 7:17" /><verse number="18" style="v" sid="EXO 7:18" />ನೈಲ್ ನ್ಹಯ್ತ್ ಹೊತ್ತಿ ಮಾಸ್ಳಿಯಾ ಮರುನ್ ಜಾತಾತ್, ನ್ಹಯ್ ಬುರ್ಶಿ ಹೊವ್ನ್ ವಾಸ್ ಯೆತಾ, ತೆ ಪಾನಿ ಫಿವ್ಕ್ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಬುರ್ಸೆ ದಿಸ್ತಾ” ಮನುನ್ ಸಾಂಗ್, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 7:18" /><verse number="19" style="v" sid="EXO 7:19" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ತಿಯಾ ಆರೊನಾಕ್ ತುಜೊ ದಾಂಡೊ ಘೆವ್ನ್ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಹೊತ್ತ್ಯಾ, ನ್ಹಯ್, ಝರೊವಾ, ಕಾಲ್ಗಿಯಾ, ತಳೆ ಹ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ಡೆ ಹಾತ್ ವೈರ್ ಕರ್ ತಸೆ ಕರ್ತಾನಾ, ಸಗ್ಳೆ ಪಾನಿ ರಗಾತ್ ಹೊತಾ. ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಚ್ಯಾ ಫುರಾ ಝಾಡಾಚ್ಯಾ ಬೊಡ್ಡ್ಯಾಂಚ್ಯಾ ಢೊನ್ಯಾತ್ನಿ, ಅನಿ ಗುಂಡ್ಯಾನಿ ಭಾಂದಲ್ಲ್ಯಾ ಟಾಕಿಯಾತ್ನಿ ಸಗ್ಳ್ಯಾಕ್ಡೆ ಹೊತ್ತೆ ಪಾನಿ ಫುರಾ ರಗ್ತಾನ್ ಭರುನ್ ರ್‍ಹಾತಾ”, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 7:19" /><verse number="20" style="v" sid="EXO 7:20" />ಮೊಯ್ಜೆನ್ ಅನಿ ಆರೊನಾನ್ ಸರ್ವೆಸ್ಪರಾನ್ ತೆಂಕಾ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಕರ್ಲ್ಯಾನಿ, ಫಾರೊವ್ ರಾಜಾ ಅನಿ ತೆಚ್ಯಾ ಅಧಿಕಾರಿಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ಆರೊನಾನ್ ದಾಂಡೊ ಉಕ್ಲುನ್ ನೈಲ್ ನ್ಹಯ್ತ್ ಹೊತ್ತ್ಯಾ ಪಾನಿಯಾ ವರ್‍ತಿ ಮಾರ್‍ಲ್ಯಾನ್, ತೆ ಸಗ್ಳೆ ರಗಾತ್ ಹೊಲೆ. <verse eid="EXO 7:20" /><verse number="21" style="v" sid="EXO 7:21" />ತ್ಯಾತುರ್ ಹೊತ್ತಿ ಮಾಸೊಳಿಯಾ ಮರುನ್ ಗೆಲಿ, ನೈಲ್ ನ್ಹಯ್ ಬುರ್ಶಿ ಹೊವ್ನ್ ವಾಸ್ ಯೆವ್ಕಲಾಗಲಿ, ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ತೆ ಪಾನಿ ಫಿವ್ಕ್ ಹೊವ್ಕ್ ನಾ, ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಫುರಾ ಪಾನಿ ರಗಾತ್ ಹೊಲೆ.<verse eid="EXO 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 7:22" />ಖರೆ ಇಜಿಪ್ತಾಚ್ಯಾ ಮೊಡ್ಗಾರಾನಿಬಿ ಅಪ್ಲ್ಯಾ ಮೊಡಿಯಾನಿ ತಸೆಚ್ ಕರ್ಲ್ಯಾನಿ, ತಸೆ ಹೊವ್ನ್ ಫಾರೊವ್ ರಾಜಾಚೊ ಮನ್ ಕಟಿನ್ ಹೊಲೊ. ಸರ್ವೆಸ್ಪರಾನ್ ಅದ್ದಿಚ್ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ತೊ ಮೊಯ್ಜೆ ಅನಿ ಆರೊನಾಚಿ ಗೊಸ್ಟಿಯಾ ಆಯ್ಕಿನಾ ಹೊಲೊ. <verse eid="EXO 7:22" /><verse number="23" style="v" sid="EXO 7:23" />ಹ್ಯಾ ಅಜಾಪಾಚ್ಯಾ ಕಾನಿಯಾಕ್ನಿ ದ್ಯಾನ್ ದಿಯ್ನಸ್ತಾನಾ ತೊ ಅಪ್ಲ್ಯಾ ರಾಜಾಚ್ಯಾ ಘರಾಕ್ ಗೆಲೊ. <verse eid="EXO 7:23" /><verse number="24" style="v" sid="EXO 7:24" />ಸಗ್ಳ್ಯಾ ಇಜಿಪ್ತ್ ದೆಶಾಚ್ಯಾ ಲೊಕಾನಿ ನೈಲ್ ನ್ಹಯ್ಚೆ ಪಾನಿ ಪಿವ್ಕ್ ಹೊಯ್ ನಸ್ತಾನಾ, ಫಿತಲ್ಯಾ ಪಾನಿಯಾಚ್ಯಾ ಸಾಟ್ನಿ ಥೈ ನ್ಹಯಿಚ್ಯಾ ದಂಡೆಚ್ಯಾ ಭೊತ್ಯಾನಿ ಖಂಡುನ್ ಬಗ್ಲ್ಯಾನಿ. <verse eid="EXO 7:24" /><verse number="25" style="v" sid="EXO 7:25" />ಸರ್ವೆಸ್ಪರಾನ್ ನೈಲ್ ನ್ಹಯಿಕ್ ಮಾರುನ್ ಸಾತ್ ದಿಸಾ ಕಳದ್ಲಿ.<verse eid="EXO 7:25" /></para>
  <chapter eid="EXO 7" />
  <chapter number="8" style="c" sid="EXO 8" />
  <para style="s">ಬೆಡ್ಕಿಯಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 8:1" />ಮಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಅಸೆ ಮಟ್ಲ್ಯಾನ್, “ತಿಯಾ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಜಾವ್ನ್ ಅಸೆ ಸಾಂಗ್, ಸರ್ವೆಸ್ಪರ್ ತುಕಾ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ‘ಮಾಕಾ ಆರಾದನ್ ಕರುಕ್ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಒಪ್ಕಿ ದಿ’. <verse eid="EXO 8:1" /><verse number="2" style="v" sid="EXO 8:2" />ತಿಯಾ ಜಾವ್ಕ್ ಸೊಡಿನಸ್ಲ್ಯಾರ್ ತುಜ್ಯಾ ದೆಸಾತ್ ಪುರಾ ಬೆಡ್ಕಿಯಾಂಚ್ಯಾಕ್ನಾ ತರಾಸ್ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EXO 8:2" /><verse number="3" style="v" sid="EXO 8:3" />ನೈಲ್ ನ್ಹಯ್ತ್ ಮೆಜುಕ್ ಹೊಯ್ನಾ ತವ್ಡಿ ಬೆಡ್ಕಿಯಾ ಭರುನ್ ಜಾತಾತ್, ತಿ ಥೈನಾ ಯೆವ್ನ್ ತುಜ್ಯಾ ರಾಜಾಚ್ಯಾ ಘರ್‍ಹಾತ್ ನಿಜ್ತಲ್ಯಾ ಖೊಲಿತ್, ತುಜ್ಯಾ ಹಾತ್ರಾನಾತ್, ಅನಿ ತುಜ್ಯಾ ಅಧಿಕಾರಿಯಾಂಚ್ಯಾ ಅನಿ ಲೊಕಾಂಚ್ಯಾ ಘರಾತ್ನಿ ಅನಿ ಚುಲಿಯಾರ್ನಿಬಿ ಅನಿ ರಾಂದ್ತಲ್ಯಾ ಆಯ್ದಾನಾತ್ನಿ ಬಿ ದಿಸ್ತಾತ್. <verse eid="EXO 8:3" /><verse number="4" style="v" sid="EXO 8:4" />ತುಜಾ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿಬಿ ಅನಿ ತುಜ್ಯಾ ಘರಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿಬಿ ಬೆಡ್ಕಿಯಾ ಹುಡಿಯಾ ಮಾರ್‍ತಾತ್”, ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 8:5" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲುನ್, “ತಿಯಾ ಆರೊನಾಕ್, ತುಜೊ ದಾಂಡೊ ಪಾನಿಯಾಚಿ ಕಾಲ್ಗಿಯಾ, ನ್ಹಯಾ, ತಳೆ, ಹ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ಡೆ ಹಾತ್ ವೈರ್ ಕರುನ್ ದಾಕ್ವು, ತನ್ನಾ ಇಜಿಪ್ತ್ ದೆಶಾಚ್ಯಾ ವರ್‍ತಿ ಪುರಾ ಬೆಡ್ಕಿಯಾ ಭರ್ತಾತ್”, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 8:5" /><verse number="6" style="v" sid="EXO 8:6" />ತಸೆಹೊವ್ನ್, ಆರೊನಾನ್ ಇಜಿಪ್ತ್ ದೆಶಾಚ್ಯಾ ಪಾನಿ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಜಾಗ್ಯಾ ವೈನಿ ಹಾತ್ ಉಕ್ಲುನ್ ದಾಕ್ವಿ ಪತರ್ ಬೆಡ್ಕಿಯಾ ಥೈನಾ ಯೆವ್ನ್ ಸಗ್ಳ್ಯಾ ದೆಸಾತ್ ಭರ್ಲಿ. <verse eid="EXO 8:6" /><verse number="7" style="v" sid="EXO 8:7" />ಖರೆ ಮೊಡ್ಗಾರಾನಿ ಅಪ್ಲ್ಯಾ ಮೊಡಿಯಾನಿ ತಸೆಚ್ ಕರುನ್ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾತ್ ಬೆಡ್ಕಿಯಾ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನಿ.<verse eid="EXO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 8:8" />ತನ್ನಾ ಫಾರೊವ್ ರಾಜಾನ್ ಮೊಯ್ಜೆಕ್ ಅನಿ ಆರೊನಾಕ್ ಬಲ್ವುನ್, “ತುಮಿ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಮಾಗ್ನಿ ಕರುನ್ ಹಿ ಬೆಡ್ಕಿಯಾ ಮಾಜ್ಯಾಕ್ನಾ ಅನಿ ಮಾಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ನಾಬಿ ಜಾಯ್ ಸಾರ್ಕೆ ಕರಾ, ತಸೆ ಕರ್ಲ್ಯಾರ್, ಸರ್ವೆಸ್ಪರಾಕ್ ಬಲಿ ಭೆಟ್ವುಕ್ ಜಾವ್ಕ್ ಮಿಯಾ ತುಮ್ಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಒಪ್ಕಿ ದಿತಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 8:8" /><verse number="9" style="v" sid="EXO 8:9" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, “ಹಿ ಬೆಡ್ಕಿಯಾ ತುಮ್ಚ್ಯಾಕ್ನಾ ಅನಿ ತುಮ್ಚ್ಯಾ ಘರಾಕ್ನಿ ಅನಿ ಸೆತಾ ಭಾತಾತ್ನಿ ಸಗ್ಳೆ ಸೊಡುನ್ ಜಾವ್ನ್ ನೈಲ್ ನ್ಹೈಯ್ತ್ ತವ್ಡೆಚ್ ರ್‍ಹಾಯ್ ಸಾರ್ಕೆ ಮಿಯಾ ಕನ್ನಾ ತುಮ್ಚ್ಯಾ ಸಾಟ್ನಿ ಅನಿ ತುಮ್ಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಮಾಗ್ನಿ ಕರುಚೆ? ತುಮ್ಚ್ಯಾ ಮೊಟ್ಟ್ಯಾ ಇಚ್ಚ್ಯಾಕ್ ಸಮಾ ದಿಸಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತುಮಿಚ್ ತೆಕಾ ಎಕ್ ಎಳ್ ನಿರ್ದಾರ್ ಕರಾ”, ಮಟ್ಲ್ಯಾನ್ . <verse eid="EXO 8:9" /><verse number="10" style="v" sid="EXO 8:10" />ತೆನಿ “ಉದ್ದ್ಯಾಚ್ ಹೊವ್ಚೆ” ಮಟ್ಲ್ಯಾನ್. ತನ್ನಾ ಮೊಯ್ಜೆನ್, “ತುಮ್ಚ್ಯಾ ಗೊಸ್ಟಿಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಹೊತಾ; ಹೆಚ್ಯಾ ವೈನಾ ಅಮ್ಚ್ಯಾ ಸರ್ವೆಸ್ಪರ್ ದೆವಾಚ್ಯಾ ಸಮಾ ಕೊನ್ಬಿ ನಾ ಮನ್ತಲೆ ತುಮಿಚ್ ಕಳ್ವುನ್ ಘೆತ್ಯಾಸಿ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 8:10" /><verse number="11" style="v" sid="EXO 8:11" />ಬೆಡ್ಕಿಯಾ ತುಮ್ಕಾ ಅನಿ ತುಮ್ಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಸೊಡುನ್ ನೈಲ್ ನ್ಹಯ್ತ್ ತವ್ಡಿಚ್ ರ್‍ಹಾತಾತ್, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 8:11" /><verse number="12" style="v" sid="EXO 8:12" />ಮೊಯ್ಜೆ ಅನಿ ಆರೊನ್ ಫಾರೊವ್ ರಾಜಾಕ್ನಾ ಗೆಲೆ, ಅನಿ ತೆಚ್ಯಾ ವರ್‍ತಿ ಯೆಲ್ಲಿ ಬೆಡ್ಕಿಯಾ ಕಾಡುಚೆ ಮನುನ್ ಮೊಯ್ಜೆನ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಮಾಗ್ನಿ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 8:12" /><verse number="13" style="v" sid="EXO 8:13" />ಸರ್ವೆಸ್ಪರಾನ್ ತೆಚ್ಯಾ ಮಾಗ್ನಿ ಸಾರ್ಕೆಚ್ ಕರ್ಲ್ಯಾನ್, ಘರಾತ್ನಿ ಅನಿ ದಾರಾತ್ನಿ ಅನಿ ಸೆತಾ ಭಾತಾತ್ನಿ ಹೊತ್ತಿ ಬೆಡ್ಕಿಯಾ ಸಗ್ಳಿ ಮರುನ್ ಗೆಲಿ. <verse eid="EXO 8:13" /><verse number="14" style="v" sid="EXO 8:14" />ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾನಿ ಬೆಡ್ಕಿಯಾ ಗುಂಪೆ ಗುಂಪೆ ಕರುನ್ ಗೊಳಾ ಕರ್ಲ್ಯಾನಿ, ಸಗ್ಳ್ಯಾ ದೆಸಾತ್ ಬುರ್ಶಿ ವಾಸ್ ಭರುನ್ ಗೆಲ್ಲಿ. <verse eid="EXO 8:14" /><verse number="15" style="v" sid="EXO 8:15" />ಖರೆ ತರಾಸ್ ಕಮ್ಮಿ ಹೊಲೊ ಮನುನ್ ಕಳುನ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ, ಫಾರೊವ್ ರಾಜಾನ್ ಅಪ್ಲೊ ಮನ್ ಕಠಿನ್ ಕರುನ್ಗೆಟ್ಲ್ಯಾನ್, ಸರ್ವೆಸ್ಪರಾನ್ ಅದ್ದಿಚ್ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತೊ ತೆಂಚಿ ಗೊಸ್ಟಿಯಾ ಆಯ್ಕಿನಾ ಹೊಲೊ.<verse eid="EXO 8:15" /></para>
  <para style="s">ಉಂವ್ವಾ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16" />ಮಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲುನ್ ಅಸೆ ಮಟ್ಲ್ಯಾನ್, “ತಿಯಾ ಆರೊನಾಕ್, ತುಜ್ಯಾ ದಾಂಡ್ಯಾನ್ ಜಿಮ್ನಿಚ್ಯಾ ವರ್‍ತಿ ಧುಳಿಕ್ ಮಾರ್, ತನ್ನಾ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಹೊತ್ತಿ ಜಿಮ್ನಿ ವೈಲಿ ಧುಳ್ ಪುರಾ ಉಂವ್ವಾ ಹೊತಾತ್ ಮನುನ್ ಸಾಂಗ್”. <verse eid="EXO 8:16" /><verse number="17" style="v" sid="EXO 8:17" />ತೆನಿ ತಸೆಚ್ ಕರ್ಲ್ಯಾನಿ, ಆರೊನಾನ್ ದಾಂಡೊ ಜಿಮ್ನಿ ವರ್‍ತಿ ಧುಳಿಕ್ ಮಾರಲ್ಯಾನ್, ತನ್ನಾ ಉಂವ್ವಾ ಮಾನ್ಸಾಚ್ಯಾ ವರ್‍ತಿ ಅನಿ ಜನಾವರಾಚ್ಯಾ ವರ್‍ತಿಬಿ ಯೆವ್ನ್ ಧಾಪುನ್ ಪಡ್ಲಿ, ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಪುರಾ ಜಿವ್ನಿ ವೈರ್ ಧುಳ್ ಉಂವ್ವಾ ಹೊಲಿ. <verse eid="EXO 8:17" /><verse number="18" style="v" sid="EXO 8:18" />ಖರೆ ಮೊಡ್ಗಾರಾನಿಬಿ ಅಪ್ಲ್ಯಾ ಮೊಡಿಯಾನಿ ತಸೆಚ್ ಕರುಕ್ ಕಟ್ಪಟ್ ಕರ್ಲ್ಯಾನಿ, ಖರೆ ತೆಂಚ್ಯಾಕ್ಡೆ ಹೊವ್ಕ್ ನಾ, ತಿ ಉಂವ್ವಾ ಮಾನ್ಸಾಚ್ಯಾ ವರ್‍ತಿಬಿ ಅನಿ ಜನಾವಾರಾಂಚ್ಯಾ ವರ್‍ತಿಬಿ ಹೊತ್ತಿ. <verse eid="EXO 8:18" /><verse number="19" style="v" sid="EXO 8:19" />ತನ್ನಾ ತ್ಯಾ ಮೊಡ್ಗಾರಾನಿಬಿ, “ಹೆ ದೆವಾಚೆ ಕಾಮ್”, ಮನುನ್ ರಾಜಾಕ್ ಕಳ್ವುಲ್ಯಾನಿ ಹೊಲ್ಯಾರ್ಬಿ ಫಾರೊವ್ ರಾಜಾಚೊ ಮನ್ ಲೈ ಕಠಿನ್ ಹೊಲ್ಲೊ ಹೊತ್ತೊ, ಸರ್ವೆಸ್ಪರಾನ್ ಅದ್ದಿಚ್ ಸಾಂಗಲ್ಯಾ ಸಾರ್ಕೆ ತೊ ತೆಂಚಿ ಗೊಸ್ಟಿಯಾ ಆಯ್ಕಿನಾ ಹೊಲೊ.<verse eid="EXO 8:19" /></para>
  <para style="s">ಮಾಸ್ಕಾ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20" />ಮಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ತಿಯಾ ಸಕ್ಕಾಳಿ ಉಟುನ್ ಫಾರೊವ್ ರಾಜಾ ಸಾಟ್ನಿ ರಾಕುನ್ ಇಬೆ ರಾ, ತೊ ನ್ಹಯ್ ಕಡೆ ಯೆತಾ, ತೆಕಾ ಅಸೆ ಸಾಂಗ್, ‘ಸರ್ವೆಸ್ಪರ್ ತುಕಾ ಹುಕುಮ್ ದಿತಲಿ ಗೊಸ್ಟಿಯಾ ಹಿ ಮಾಕಾ ಆರಾದನ್ ಕರುಕ್ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಒಪ್ಕಿ ದಿ’, <verse eid="EXO 8:20" /><verse number="21" style="v" sid="EXO 8:21" />ತಿಯಾ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಜಾವ್ಕ್ ಸೊಡಿನಸ್ಲ್ಯಾರ್, ತುಕಾ ಅನಿ ತುಜ್ಯಾ ಘರಾಕ್ ಮಾಸ್ಕಾಂಚೊ ತರಾಸ್ ಯೆಯ್ ಸರ್ಕೆ ಕರ್ತಾ, ಇಜಿಪ್ತಾಚಿ ಲೊಕಾ ರ್‍ಹಾತಲ್ಯಾ ಘರಾತ್ನಿ ಬಿ ಅನಿ ತೆನಿ ಪಾಯ್ ಥವ್ತಲ್ಯಾ ಜಿಮ್ನಿಯಾಂಚ್ಯಾ ವರ್‍ತಿಬಿ ಮಾಸ್ಕಾಚ್ ಭರುನ್ ರ್‍ಹಾತಾತ್, ಮನುನ್ ಮಿಯಾ ತುಕಾ ಹುಶ್ಯಾರ್ಕಿ ದಿತಾ. <verse eid="EXO 8:21" /><verse number="22" style="v" sid="EXO 8:22" />ಖರೆ ತ್ಯಾ ದಿಸಾತ್ನಿ ಮಾಜಿ ಲೊಕಾ ಹೊತ್ತ್ಯಾ ಗೊಶೆನ್ ಪ್ರಾಂತ್ಯಾಕ್ ಹ್ಯೊ ಮಾಸ್ಕಾಂಚೊ ತರಾಸ್ ರ್‍ಹಾಯ್ನಾ, ಹೆಚ್ಯಾ ವೈನಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ರಾಜ್ವಡ್ಕಿ ಕರ್ತಲೊ ಸರ್ವೆಸ್ಪರ್ ಮಿಯಾಚ್ ಮನ್ತಲೆ ತಿಯಾ ಕಳ್ವುನ್ ಘೆವ್ಚೆ. <verse eid="EXO 8:22" /><verse number="23" style="v" sid="EXO 8:23" />ಅಸೆ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಅನಿ ತುಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಫರಕ್ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಉದ್ದ್ಯಾಚ್ ಹೆ ಅಜಾಪ್ ಹೊತಾ, ಮನುನ್ ಸಾಂಗ್” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 8:23" /><verse number="24" style="v" sid="EXO 8:24" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಟಿ ಮಾಸ್ಕಾ, ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಘರಾಕ್ ಅನಿ ತೆಚ್ಯಾ ಅಧಿಕಾರಿಯಾಂಚ್ಯಾ ಘರಾಕ್ನಿಬಿ ಧಾಡ್ಲ್ಯಾನ್, ಸಗ್ಳೆ ಇಜಿಪ್ತಾತ್ ದೆಶ್ ಮಾಸ್ಕಾನಿ ನಾಶ್ ಹೊಲೊ. <verse eid="EXO 8:24" /><verse number="25" style="v" sid="EXO 8:25" />ತನ್ನಾ ಫಾರೊವ್ ರಾಜಾನ್ ಮೊಯ್ಜೆಕ್ ಅನಿ ಆರೊನಾಕ್ ಬಲ್ವುನ್, “ತುಮಿ ಜಾವ್ನ್ ಹ್ಯಾ ದೆಶಾತುಚ್ ತುಮ್ಚ್ಯಾ ದೆವಾಕ್ ಬಲಿ ಭೆಟ್ವಾ”, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 8:25" /><verse number="26" style="v" sid="EXO 8:26" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಅನಿ ಆರೊನಾನ್ “ತಸೆ ಕರ್‍ತಲೆ ಸಮಾ ನ್ಹಯ್ , ಅಮ್ಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಅಮಿ ಭೆಟ್ವುತಲಿ ಬಲಿ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ತಿರಸ್ಕಾರ್ ಹೊಲ್ಲಿ, ತೆಂಕಾ ತಿರಸ್ಕಾರ್ ಹೊಲ್ಲಿ ಬಲಿ ಅಮಿ ತೆಂಚ್ಯಾ ಇದ್ರಾಕ್ ಭೆಟ್ವುಲ್ಯಾರ್, ತೆನಿ ಅಮ್ಕಾ ಗುಂಡೆ ಮಾರುನ್ ಜಿವ್ ಕಾಡ್ತಾತ್ ನ್ಹಯ್? <verse eid="EXO 8:26" /><verse number="27" style="v" sid="EXO 8:27" />ಅಮಿ ಡಂಗ್ಳಿತ್ ತಿನ್ ದಿಸ್ ಚಲುನ್ ಜಾತಲ್ಯಾ ತವ್ಡ್ಯಾ ಧುರ್ ಜಾವ್ನ್, ಅಮ್ಚ್ಯಾ ಸರ್ವೆಸ್ಪರಾನ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಬಲಿ ಭೆಟ್ವುತಲೆ ಹಾಯ್”, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 8:27" /><verse number="28" style="v" sid="EXO 8:28" />ತನ್ನಾ ರಾಜಾನ್, “ಬರೆ ಡಂಗ್ಳಿಕ್ ಜಾವ್ನ್ ತುಮ್ಚ್ಯಾ ದೆವಾಕ್ ಬಲಿಭೆಟ್ವುಕ್ ತುಮ್ಕಾ ಒಪ್ಕಿ ದಿತಾ, ಖರೆ ಲೈ ಧುರ್ ಜಾವ್ಕ್ ನಾ, ಅನಿ ಮಾಜ್ಯಾ ಸಾಟ್ನಿಚ್ ಮಾಗ್ನಿ ಕರುಚೆ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 8:28" /><verse number="29" style="v" sid="EXO 8:29" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, “ತುಮ್ಚ್ಯಾಕ್ನಾ ಜಾವ್ಕ್ ಲಾಗಲ್ಲ್ಯಾ ತನ್ನಾಚ್ ಫಾರೊವ್ ರಾಜ್ಯಾಚ್ ತುಕಾಬಿ ಅನಿ ತುಜಾ ಲೊಕಾಕ್ನಿ ಮಾಸ್ಕಾಂಚೊ ತರಾಸ್ ಉದ್ದ್ಯಾಕ್ನಾ ರಾವ್ಚೆ ನ್ಹಯ್ ಮನುನ್ ಮಿಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಮಾಗ್ನಿ ಕರ್ತಾ, ಖರೆ ಸರ್ವೆಸ್ಪರಾಕ್ ಬಲಿ ಭೆಟ್ವುಕ್ ಲೊಕಾಕ್ನಿ ಒಪ್ಕಿ ದಿಯ್ ನಸ್ತಾನಾ ಪಶ್ವು ನ್ಹಯ್”, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 8:29" /><verse number="30" style="v" sid="EXO 8:30" />ಮೊಯ್ಜೆನ್ ಫಾರೊವಾಕ್ನಾ ಜಾವ್ನ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಮಾಗ್ನಿ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 8:30" /><verse number="31" style="v" sid="EXO 8:31" />ತೆನಿ ಮಾಗ್ನಿ ಕರಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಸರ್ವೆಸ್ಪರಾನ್ ಕರ್ಲ್ಯಾನ್, ತಿ ಮಾಸ್ಕಾ ಫಾರೊವ್ ರಾಜಾ ಅನಿ ತೆಚ್ಯಾ ಅಧಿಕಾರಿಯಾಕ್ನಿ ಅನಿ ತೆಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಸೊಡುನ್ ಗೆಲಿ, ಎಕ್ಬಿ ಮಾಸುಕ್ ರಾವ್ಕ್ ನಾ. <verse eid="EXO 8:31" /><verse number="32" style="v" sid="EXO 8:32" />ಖರೆ ಫಾರೊವ್ ರಾಜಾ ಅತ್ತಾಬಿ ಮಂಡ್ ಪಾನ್ ಕರುನ್, ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಜಾವ್ಕ್ ಒಪ್ಕಿ ದಿವ್ಕ್ ನಾ.<verse eid="EXO 8:32" /></para>
  <chapter eid="EXO 8" />
  <chapter number="9" style="c" sid="EXO 9" />
  <para style="s">ಜನಾವರಾಂಚೆ ಮರಾನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1" />ತೆಚ್ಯಾ ಮಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಸಾಂಗಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, “ತಿಯಾ ಫಾರೊವಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಜಾವ್ನ್, ‘ಇಬ್ರಿಯಾಂಚ್ಯಾ ದೆವ್ ಸರ್ವೆಸ್ಪರಾನ್ ಅಪ್ನಾಕ್ ಆರಾದನ್ ಕರುಕ್ ಅಪ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ ತುಮ್ಚ್ಯಾಕ್ನಾ ಜಾವ್ಕ್ ಒಪ್ಕಿ ದಿವ್ಚೆ ಮನುನ್ ಸಾಂಗಲ್ಯಾನ್. <verse eid="EXO 9:1" /><verse number="2" style="v" sid="EXO 9:2" />ತಿಯಾ ತೆಂಕಾ ಒಪ್ಕಿ ದಿಯ್ನಸ್ತಾನಾ ಅಡ್ಡಿ ಕರಲ್ಲೆ ಹೊಲ್ಯಾರ್, <verse eid="EXO 9:2" /><verse number="3" style="v" sid="EXO 9:3" />ಸರ್ವೆಸ್ಪರ್ ತುಜ್ಯಾ ದೆಶ್ಯಾತ್ ಹೊತ್ತ್ಯಾ ಘೊಡ್ಕಿಯಾ, ಗಾಡ್ವಾ, ಒಂಟಿಯಾ, ಗೊರಾ-ಡೊರಾ, ಬಕ್ರಿಯಾ, ಶೆಳಿಯಾ, ತುಮ್ಚ್ಯಾ ಹ್ಯಾ ಸಗ್ಳ್ಯಾ ಜನಾವರಾಂಚ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕ್ಲುನ್ ಮೊಟ್ಟಿ ಶಿಕ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರುನ್, ತುಕಾ ಶಿಕ್ಷ್ಯಾದಿತಾ ಕರ್ತಾ, ಮನ್ತಲೆ ಕಳ್ವುನ್ ಘೆ. <verse eid="EXO 9:3" /><verse number="4" style="v" sid="EXO 9:4" />ಸರ್ವೆಸ್ಪರ್ ಹೊವ್ನ್ ಹೊತ್ತೊ ಮಿಯಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಅನಿ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಜನಾವರಾಕ್ನಿ ಫರಕ್ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಜನಾವರಾತ್ನಿ ಎಕ್ಬಿ ಮರುನ್ ಜಾಯ್ನಾ’ ಮನುನ್ ಸಾಂಗ್. <verse eid="EXO 9:4" /><verse number="5" style="v" sid="EXO 9:5" />ಸರ್ವೆಸ್ಪರ್ ಹೊವ್ನ್ ಹೊತ್ತೊ ಮಿಯಾ ಎಳ್ ನಿರ್ದಾರ್ ಕರುನ್ ಥವ್ಲಾ, ಉದ್ದ್ಯಾಚ್ ಹೆ ಕಾಮ್ ದೆಸಾತ್ ಕರ್ತಾ; ಮನುನ್ ಸಾಂಗ್” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 9:5" /><verse number="6" style="v" sid="EXO 9:6" />ದುಸ್ರೆಂದಿಸಿಚ್ ಸರ್ವೆಸ್ಪರಾನ್ ಹೆ ಕಾಮ್ ಕರ್ಲ್ಯಾನ್, ಇಜಿಪ್ತ್ ಲೊಕಾಂಚಿ ಸಗ್ಳಿ ಜನಾವರಾ ಮರುನ್ ಗೆಲಿ, ಖರೆ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಜನಾವರಾತ್ನಿ ಎಕ್ಬಿ ಮ್ಹರುಕ್ನಾ. <verse eid="EXO 9:6" /><verse number="7" style="v" sid="EXO 9:7" />ಫಾರೊವ್ ರಾಜಾನ್ ಆಳಾಕ್ನಿ ಧಾಡುನ್ ಇಚ್ಯಾರ್ನೆ ಕರ್ಲ್ಯಾನ್, ತನ್ನಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಜನಾವರಾತ್ನಿ ಎಕ್ಬಿ ಮರುನ್ ಜಾವ್ಕನಾ ಮನ್ತಲೆ ಕಳುನ್ ಯೆಲೆ, ಹೊಲ್ಯಾರ್ಬಿ ರಾಜಾನ್ ಮಂಡ್ ಪಾನಾನ್, ತ್ಯಾ ಲೊಕಾಕ್ನಿ ಜಾವ್ಕ್ ಒಪ್ಕಿ ದಿವ್ಕ್ ನಾ.<verse eid="EXO 9:7" /></para>
  <para style="s">ಸಿಜ್ತಲೆ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆ ಅನಿ ಆರೊನಾಕ್, “ತುಮಿ ಚುಲಿತ್ಲಿ ರಕ್ಕಾ ಹಾತ್ ಭರುನ್ ಘೆವಾ, ಅನಿ ಮೊಯ್ಜೆ ತಿ ರಕ್ಕಾ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಮಳ್ಬಾಕ್ಡೆ ವಾರ್ಯಾತ್ ಸಿಪುನ್ದಿತ್, <verse eid="EXO 9:8" /><verse number="9" style="v" sid="EXO 9:9" />ತಿ ರಕ್ಕಾ ಧುಳ್ ಸಾರ್ಕೆ ಹೊವ್ನ್ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾತ್ ಫುರಾ ಪಗ್ಳುನ್ ಮಾನ್ಸಾಂಚ್ಯಾ ಅನಿ ಜನಾವರಾಂಚ್ಯಾ ವರ್‍ತಿ ಪೊಕೆ ಉಟಿಸಾರ್ಕೆ ಕರುನ್ ತೆ ಫುಟುನ್ ದುಕ್ಕಾ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 9:9" /><verse number="10" style="v" sid="EXO 9:10" />ಮೊಯ್ಜೆನ್ ಅನಿ ಆರೊನಾನ್ ಚುಲಿತ್ಲಿ ರಕ್ಕಾ ಘೆವ್ನ್ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆರ್‍ಹಾಲೆ, ಅನಿ ಮೊಯ್ಜೆನ್ ತಿ ರಕ್ಕಾ ಮಳ್ಬಾಕ್ಡೆ ವಾರ್ಯಾತ್ ಸಿಪ್ಲ್ಯಾನ್, ತ್ಯಾ ರಕ್ಕಾನಿ ಮಾನ್ಸಾತ್ನಿ ಅನಿ ಜನಾವರಾತ್ನಿ ಪೊಕೆ ಹೊವ್ನ್ ದುಕ್ಕಾ ಹೊಯ್ ಸಾರ್ಕೆ ಹೊಲೆ. <verse eid="EXO 9:10" /><verse number="11" style="v" sid="EXO 9:11" />ತೆ ಪೊಕೆ ಮೊಡ್ಗಾರಾಕ್ನಿ ಅನಿ ಇಜಿಪ್ತಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾತ್ನಿಬಿ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ತ್ಯಾ ಮೊಡ್ಗಾರಾಕ್ನಿ ಹ್ಯಾ ಪೊಕ್ಯಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಮೊಯ್ಜೆಚ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆ ರಾವ್ಕ್ ಹೊವ್ಕ್ ನಾ. <verse eid="EXO 9:11" /><verse number="12" style="v" sid="EXO 9:12" />ಹೊಲ್ಯಾರ್ಬಿ ಸರ್ವೆಸ್ಪರಾನ್ ಅದ್ದಿಚ್ ಮೊಯ್ಜೆಕ್ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಹೊಲೆ, ಸರ್ವೆಸ್ಪರಾನ್ ಫಾರೊವ್ ರಾಜಾಚೊ ಮನ್ ಮಂಡ್ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ತೆನಿ ತೆಂಚ್ಯಾ ಬೊಲ್ನ್ಯಾಕ್ನಿ ಕಾನ್ ದಿವ್ಕ್ ನಾ.<verse eid="EXO 9:12" /></para>
  <para style="s">ಗಾರ್ಬಿಯಾ</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13" />ಮಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, ತಿಯಾ ಸಕ್ಕಾಳಿ ಉಟುನ್ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆರಾವ್ನ್ ಅಸೆ ಸಾಂಗ್, ಇಬ್ರಿಯಾಂಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರ್ ದಿತಲೆ ಹುಕುಮ್ ಹೆ, ಮಾಕಾ ಆರಾದನ್ ಕರುಕ್ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಒಪ್ಕಿ ದಿವ್ಚೆ, <verse eid="EXO 9:13" /><verse number="14" style="v" sid="EXO 9:14" />ನಾ ಹೊಲ್ಯಾರ್ ಹ್ಯಾ ಪಟಿ ಮಿಯಾ ದಿತಲೊ ತರಾಸ್ ತುಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಅನಿ ಅಧಿಕಾರಿಯಾಕ್ನಿ ತವ್ಡೆಚ್ ನ್ಹಯ್ ತುಕಾಬಿ ಲಾಗ್ತಾ, ಹೆಜ್ಯಾ ವೈನಾ ಸಗ್ಳ್ಯಾ ಜಗಾತುಚ್ ಮಾಜ್ಯಾ ಸಮಾ ಕೊನ್ಬಿ ನಾ ಮನ್ತಲೆ ತುಕಾ ಕಳುನ್ ಯೆತಾ, <verse eid="EXO 9:14" /><verse number="15" style="v" sid="EXO 9:15" />ಮಿಯಾ ಹಾತ್ ಉಕ್ಲುನ್ ತುಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಬುರ್ಸ್ಯಾ ರೊಗಾನಿ ಮಾರುನ್ ಟಾಕಿ ಸಾರ್ಕೆ ಹೊತ್ತೆ, ತನ್ನಾ ತಿಯಾ ಅಜುನ್ ಪತರ್ ಬಿ ಜಿಮ್ನಿ ವರ್‍ತಿ ರಾಯ್ನಸ್ತಾನಾ ನಾಶ್ ಹೊವ್ನ್ ಜಾಯ್ ಹೊತ್ತೈಯ್. <verse eid="EXO 9:15" /><verse number="16" style="v" sid="EXO 9:16" />ಖರೆ ಮಿಯಾ ತುಕಾ ಮಾಜಿ ಬಳ್ ದಾಕ್ವುನ್ ಮಾಜೆ ನಾವ್ ಸಗ್ಳ್ಯಾ ಜಗಾಕ್ ಪರ್ಗಟ್ ಕರುಚೆ ಮನ್ತಲ್ಯಾ ಉದ್ದೆಸಾನ್ ಜಿವ್ ಕಾಡಿ ನಸ್ತಾನಾ ಹುರ್ವುಲಾ. <verse eid="EXO 9:16" /><verse number="17" style="v" sid="EXO 9:17" />ತಿಯಾ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಜಾವ್ಕ್ ದಿಯ್ನಸ್ತಾನಾ ತೆಂಕಾ ಅಡ್ಕಳ್ ಕರುಲೈ ಕಾಯ್? <verse eid="EXO 9:17" /><verse number="18" style="v" sid="EXO 9:18" />ತಸೆ ಹೊಲ್ಯಾರ್ ಉದ್ದ್ಯಾ ಯೆವ್ಡ್ಯಾ ಎಳಾಕ್ ಗಾರ್ಬಿಯಾಂಚೊ ಪಾವ್ಸ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಇಜಿಪ್ತ್ ರಾಜ್ ತಯಾರ್ ಹೊಲ್ಯಾಕ್ನಾ ಆಜ್ ಪತರ್ಬಿ ತಸ್ಲೊ ಪಾವ್ಸ್ ಪಡುಕ್ ನತ್ತೊ, ತಸ್ಲೊ ಗಾರ್ಬಿಯಾಂಚೊ ಪಾವ್ಸ್ ಯೆಯ್ ಸಾರ್ಕೊ ಕರ್ತಾ. <verse eid="EXO 9:18" /><verse number="19" style="v" sid="EXO 9:19" />ತಸೆ ಹೊವ್ನ್, ತಿಯಾ ಆಳಾಕ್ನಿ ಧಾಡುನ್ ತುಜ್ಯಾ ಜನಾವರಾಕ್ನಿ ಅನಿ ಸೆತಾ ಭಾತಾತ್ನಿ ಹೊತ್ತೆ ಸಗ್ಳೆ ಸಮಾ ಕರುನ್ ಥವ್, ಘರಾಕ್ ಯೆಯ್ ನಸ್ತಾನಾ ಮದ್ದಿ ಮಾಳಾತ್ ಹೊತ್ತಿ ಮಾನ್ಸಾ, ಜನಾವರಾ ಸಗ್ಳೆ ಗಾರ್ಬಿಯಾಂಚ್ಯಾ ಪಾವ್ಸಾಚ್ಯಾ ಮಾರಾಕ್ ಮ್ಹರುನ್ ಜಾತಾತ್. <verse eid="EXO 9:19" /><verse number="20" style="v" sid="EXO 9:20" />ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಅಧಿಕಾರಿಯಾತ್ನಿ ಉಲ್ಲ್ಯಾನಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಬೊಲ್ನ್ಯಾಕ್ನಿ ಭಿಂವ್ನ್ ಅಪ್ಲ್ಯಾ ಆಳಾಕ್ನಿ ಅನಿ ಜನಾವರಾಕ್ನಿ ಲಗ್ಗು ಲಗ್ಗುನಾ ಘರಾಕ್ ಬಲ್ವುನ್ಗೆಟ್ಲ್ಯಾನಿ. <verse eid="EXO 9:20" /><verse number="21" style="v" sid="EXO 9:21" />ಹುರಲ್ಯಾನಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಹುಶಾರ್ಕಿಕ್ ಧ್ಯಾನ್ ದಿಯ್ನಸ್ತಾನಾ, ಅಪ್ಲ್ಯಾ ಆಳಾಕ್ನಿ ಅನಿ ಜನಾವರಾಕ್ನಿ ಸೆತಾತ್ನಿಚ್ ಸೊಡ್ಲ್ಯಾನಿ. <verse eid="EXO 9:21" /><verse number="22" style="v" sid="EXO 9:22" />ಅನಿ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ “ತುಜೊ ಹಾತ್ ಮಳ್ಬಾಕ್ಡೆ ಕರ್, ತನ್ನಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾತ್ ಸಗ್ಳೊ ಗಾರ್ಬಿಯಾಂಚೊ ಪಾವ್ಸ್ ಪಡ್ತಾ, ಮಾನ್ಸಾಂಚ್ಯಾ ವರ್‍ತಿ ಅನಿ ಜನಾವರಾಂಚ್ಯಾವರ್‍ತಿ ಅನಿ ಸೆತಾತ್ಲ್ಯಾ ಪಿಕೆ ವರ್‍ತಿಬಿ ತೊ ಪಾವ್ಸ್ ಪಡ್ತಾ”, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 9:22" /><verse number="23" style="v" sid="EXO 9:23" />ತಸೆಚ್ ಮೊಯ್ಜೆನ್ ಅಪ್ಲೊ ದಾಂಡೊ ಉಕಲ್ಲ್ಯಾನ್, ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಗುಡ್ಗುಡೊ ಅನಿ ಗಾರ್ಬಿಯಾಂಚೊ ಪಾವ್ಸ್ ಧಾಡುನ್, ಲಕ್ಲಕೊ ಜಿಮ್ನಿಕ್ ಮಾರ್ಲೊ, ಅನಿ ಗಾರ್ಬಿಯಾಂಚೊ ಪಾವ್ಸ್ ಸಗ್ಳ್ಯಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾ ವರ್‍ತಿ ಪಡ್ಲೊ. <verse eid="EXO 9:23" /><verse number="24" style="v" sid="EXO 9:24" />ತೊ ಗಾರ್ಬಿ ಯಾಂಚೊ ಪಾವ್ಸ್ ಲೈ ಮೊಟೊ ಅನಿ ಬಳಾಚೊ ಹೊತ್ತೊ, ಅನಿ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಲಕ್ಲಕುಲಾಗಲ್ಲೆ, ಇಜಿಪ್ತ್ ಮನ್ತಲೆ ದೆಶ್ ತಯಾರ್ ಹೊಲ್ಲ್ಯಾಕ್ನಾ ಅಸ್ಲೊ ಗಾರ್ಬಿಯಾಂಚೊ ಪಾವ್ಸ್ ಪಡಲೊಚ್ ನತ್ತೊ. <verse eid="EXO 9:24" /><verse number="25" style="v" sid="EXO 9:25" />ತ್ಯಾ ಪಾವ್ಸಾ ವೈನಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾತ್ ಸಗ್ಳ್ಯಾಕ್ಡೆ ಮಾನ್ಸಾ, ಜನಾವರಾ, ಅನಿ ಮಾಳ್ ಜಾಗ್ಯಾರ್ ಹೊತ್ತೆ ಸಗ್ಳೆಬಿ ನಾಸ್ ಹೊಲೆ, ಸೆತಾತ್ನಿ ಹೊತ್ತೆ ಪಿಕ್ ಫುರಾ ಝಡುನ್ ಗೆಲೆ, ಡಂಗ್ಳಿತ್ ಹೊತ್ತಿ ಝಾಡಾ ಸಗ್ಳಿ ಪಡುನ್ ಗೆಲಿ. <verse eid="EXO 9:25" /><verse number="26" style="v" sid="EXO 9:26" />ಇಜ್ರಾಯೆಲಾಂಚಿ ಲೊಕಾ ರ್‍ಹಾತಲ್ಯಾ ಗೊಶೆನ್ ಮನ್ತಲ್ಯಾ ಪ್ರಾಂತ್ಯಾತ್ ತವ್ಡೊಚ್ ಪಾವ್ಸ್ ಪಡುಕ್ನಾ. <verse eid="EXO 9:26" /><verse number="27" style="v" sid="EXO 9:27" />ತನ್ನಾ ಫಾರೊವ್ ರಾಜಾನ್ ಮೊಯ್ಜೆಕ್ ಅನಿ ಆರೊನಾಕ್ ಬಲ್ವುಕ್ ಲಾವ್ನ್, ತೆಂಕಾ, “ಮಿಯಾ ಚುಕ್ ಕರಲ್ಲೊ ಮನುನ್ ಅತ್ತಾ ಒಪ್ಪುನ್ಗೆತಾ, ಸರ್ವೆಸ್ಪರ್ ಖರೊ ಹಾಯ್, ಮಿಯಾ ಅನಿ ಮಾಜಿ ಲೊಕಾ ಚುಕ್ ಕರಲ್ಲೆ ಹೊವ್ನ್ ಹಾತ್, <verse eid="EXO 9:27" /><verse number="28" style="v" sid="EXO 9:28" />ಹ್ಯೊ ಲೈ ಮೊಟೊ ಗುಡ್ಗುಡ್ಯಾಂಚೊ ಅನಿ ಗಾರ್ಬಿಯಾಂಚೊ ಪಾವ್ಸ್ ಅತ್ತಾ ಫಿರೆಚ್ ಫಿರೆ, ಹೆ ಸಗ್ಳೆ ಇಬೆ ಕರಿ ಸಾರ್ಕೆ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಮಾಗ್ನಿ ಕರಾ, ಹ್ಯಾ ದೆಶ್ಯಾಕ್ನಾ ಜಾವ್ಕ್ ಮಿಯಾ ತುಮ್ಕಾ ಒಪ್ಕಿ ದಿತಾ, ಹ್ಯಾನ್ ಫಿಡೆ ತುಮ್ಕಾ ಅಡ್ಡಿ ಕರಿನಾ”, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 9:28" /><verse number="29" style="v" sid="EXO 9:29" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, “ಮಿಯಾ ಹ್ಯಾ ಶಾರ್‍ಹಾತ್ನಾ ತಿಕ್ಡಿನ್ ಗೆಲ್ಲ್ಯಾ ತಸೆಚ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಹಾತ್ ವರ್‍ತಿ ಕರುನ್ ಮಾಗ್ನಿ ಕರ್ತಾ, ತನ್ನಾ ಗುಡ್ಗುಡೊ ಅನಿ ಗಾರ್ಬಿಯಾಂಚೊ ಪಾವ್ಸ್ ಕಮ್ಮಿ ಹೊತಾ, ಹೆಜ್ಯಾ ವೈನಾ ಸಗ್ಳೆ ಜಗ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಖಾಲ್ತಿ ಹಾಯ್ ಮನ್ತಲೆ ತುಮಿ ಕಳ್ವುನ್ ಘೆತ್ಯಾಸಿ. <verse eid="EXO 9:29" /><verse number="30" style="v" sid="EXO 9:30" />ಹೊಲ್ಯಾರ್ಬಿ ತಿಯಾ ಅನಿ ತುಜಿ ಅಧಿಕಾರಿಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಭಿಂಯ್ನ್ಯಾಸಿ ಮನ್ತಲೆ ಮಾಕಾ ಗೊತ್ತ್ ಹಾಯ್” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 9:30" /><verse number="31" style="v" sid="EXO 9:31" />ಘಂವ್ ಅನಿ ಆಗ್ಸಿಚೆ ಪಿಕ್ ನಾಶ್ ಹೊವ್ನ್ ಗೆಲೆ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಘಂವ್ ಕನ್ಸಾ ಯೆಲ್ಲಿ ಹೊತ್ತಿ ಅನಿ ಆಗ್ಸಿಚಿ ಫುಲ್ಲಾ ಹೊಲ್ಲಿ ಹೊತ್ತಿ. <verse eid="EXO 9:31" /><verse number="32" style="v" sid="EXO 9:32" />ಖರೆ ಘಂವ್ ಅನಿ ಚೆನೆ ಫಾಟ್ನಾ ಯೆತಲಿ ಪಿಕ್ ಹೊಲ್ಯಾ ಸಾಟ್ನಿ ತೆಂಕಾ ಕಾಯ್ಬಿ ಹೊವ್ಕ್ ನಾ. <verse eid="EXO 9:32" /><verse number="33" style="v" sid="EXO 9:33" />ಮೊಯ್ಜೆನ್ ಫಾರೊವ್ ರಾಜಾಕ್ನಾ ಸೊಡುನ್ ಶಾರ್‍ಹಾತ್ನಾ ಭಾಯ್ರ್ ಯೆವ್ನ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಹಾತ್ ಉಕ್ಲುನ್ ಮಾಗ್ನಿ ಕರ್ಲ್ಯಾನ್ ಗುಡ್ಗುಡೊ, ಪಾವ್ಸ್ ಅನಿ ಗಾರ್ಬಿಯಾ ಬಂದ್ ಹೊಲೆ. <verse eid="EXO 9:33" /><verse number="34" style="v" sid="EXO 9:34" />ಖರೆ ತೊ ಪಾವ್ಸ್, ಗಾರ್ಬಿಯಾ ಅನಿ ಗುಡ್ಗುಡೊ ಬಂದ್ ಹೊಲ್ಲೆ ಬಗುನ್ ಫಾರೊವ್ ರಾಜಾನ್ ಅನಿ ತೆಚ್ಯಾ ಅಧಿಕಾರಿಯಾನಿ ಪರ್‍ತುನ್ ಅನಿ ಮನ್ ಮಂಡ್ ಕರುನ್ಗೆಟ್ಲ್ಯಾನಿ, ಅನಿ ಪಾಪಾಕ್ ಗುರಿ ಹೊಲೆ. <verse eid="EXO 9:34" /><verse number="35" style="v" sid="EXO 9:35" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಹೊಲೆ, ಫಾರೊವ್ ರಾಜಾಚೊ ಮನ್ ಗುಂಡ್ಯಾ ಸಾರ್ಕೊ ಹೊಲೊ ಅನಿ ತೆನಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಜಾವ್ಕ್ ಸೊಡುಕ್ನಾ.<verse eid="EXO 9:35" /></para>
  <chapter eid="EXO 9" />
  <chapter number="10" style="c" sid="EXO 10" />
  <para style="s">ಠೊಳಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 10:1" />ಮಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ಫಾರೊವಾಚ್ಯಾ ಇದ್ರಾಕ್ ಜಾ, ಮಿಯಾ ತೆಜೊ ಅನಿ ತೆಚ್ಯಾ ಅಧಿಕಾರಿಯಾಂಚಿ ಮನಾ ಕಠಿನ್ ಕರ್ಲಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತೆಂಚ್ಯಾ ಇದ್ರಾಕ್ ಹಿ ಅಜಾಪಾಚಿ ಕಾಮಾ ಕರುಕ್ ಅವ್ಕಾಸ್ ಗಾವ್ಚೆ. <verse eid="EXO 10:1" /><verse number="2" style="v" sid="EXO 10:2" />ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಲೊಕಾನಿ ತೆಂಚ್ಯಾ ಪೊರಾಕ್ನಿ ಅನಿ ನಾತ್ರಾಕ್ನಿ ಹಿ ಅಜಾಪಾ ಸಗ್ಳಿ ಸಾಂಗುಚೆ, ಅನಿ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಮಿಯಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮನ್ ಯೆಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಶಿಕ್ಷ್ಯಾ ದಿಲೊ ಮನುನ್ ಕಳುಚೆ, ಅಸೆ ಹ್ಯಾ ಅಜಾಪಾಚ್ಯಾ ವೈನಾ ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಕಳ್ವುನ್ ಘೆತ್ಯಾಸಿ”, ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 10:3" />ಅಸೆಚ್ ಮೊಯ್ಜೆನ್ ಅನಿ ಆರೊನಾನ್ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಜಾವ್ನ್ ತೆಕಾ, ಇಬ್ರಿಯಾಂಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರ್ ಸಾಂಗುಲಾಗಲ್ಲಿ ಬೊಲ್ನಿಯಾ ಹಿ, ತಿಯಾ ಮಾಕಾ ಖೈ ಪತರ್ ಖಾಲ್ತಿ ಹೊವ್ನ್ ಚಲಿನ್ಹಯ್ ? ಮಾಕಾ ಆರಾದನ್ ಕರುಕ್ ಜಾವ್ಕ್ ಮಾಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಒಪ್ಕಿ ದಿ. <verse eid="EXO 10:3" /><verse number="4" style="v" sid="EXO 10:4" />ನಾ ಹೊಲ್ಯಾರ್ ಉದ್ದ್ಯಾಚ್ ತುಜ್ಯಾ ದೆಶ್ಯಾತ್ ಠೊಳಾ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EXO 10:4" /><verse number="5" style="v" sid="EXO 10:5" />ಜಿಮಿನ್ ಪುರಾ ಕಾಳಿ ದಿಸಿ ಸಾರ್ಕೆ ತವ್ಡಿ ಠೊಳಾ ಯೆತಾತ್, ಗಾರ್ಬಿಯಾಂಚ್ಯಾ ಪಾವ್ಸಾನ್ ನಾಶ್ ಹೊಯ್ ನಸ್ತಾನಾ ಹುರಲ್ಲೆ ಸಗ್ಳೆ ತೆ ಠೊಳಾ ಖಾತಾತ್, ಸೆತಾತ್ ಹೊತ್ತ್ಯಾ ತುಮ್ಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಝಾಡಾಂಚಿ ಪಾನಾ, ಚಿಗರ್ ಸಗ್ಳೆ ಖಾತಾತ್. <verse eid="EXO 10:5" /><verse number="6" style="v" sid="EXO 10:6" />ತುಜ್ಯಾ ಘರ್‍ಹಾತ್ ಅನಿ ತುಜ್ಯಾ ರಾಜಾಚ್ಯಾ ಘರ್‍ಹಾತ್ ಅನಿ ತುಜ್ಯಾ ಅಧಿಕಾರಿಯಾಂಚ್ಯಾ ಅನಿ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಘರಾತ್ನಿಬಿ ತಿ ಠೊಳಾ ಬರ್ತಾತ್, ತುಮ್ಚ್ಯಾ ಪುರ್ವಜಾಂಚ್ಯಾ ಕಾಲಾಕ್ನಾ ಅಜುನ್ ಪತರ್ಬಿ ತಸ್ಲ್ಯಾ ಠೊಳಾಂಚೊ ಹಿಂಡ್ ಕೊನ್ಬಿ ಬಗುಕ್ನಾತ್, ಮನುನ್ ಅಸೆ ಸಾಂಗುನ್ ಫಾರೊವ್ ರಾಜಾಕ್ನಾ ಪರ್‍ತುನ್ ಗೆಲೊ. <verse eid="EXO 10:6" /><verse number="7" style="v" sid="EXO 10:7" />ತನ್ನಾ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಘರಾತ್ಲ್ಯಾ ಅಧಿಕಾರಿಯಾನಿ ತೆಕಾ, “ಹ್ಯೊ ಮಾನುಸ್ ಅನಿ ಕೆವ್ಡೊ ಪತರ್ ಅಸೊ ತರಾಸಾಚೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾಕಿ? ತಿ ಲೊಕಾ ಜಾವ್ನ್ ಅಪ್ಲ್ಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಆರಾದನ್ ಕರುಕ್ ಒಪ್ಕಿ ದಿವ್ನ್ ಸೊಡ್, ಇಜಿಪ್ತ್ ದೆಶುಚ್ ನಾಶ್ ಹೊವ್ಲಾ, ಮನ್ತಲೆ ತುಕಾ ಕಳುಕ್ ನಾ ಕಾಯ್?” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನಿ. <verse eid="EXO 10:7" /><verse number="8" style="v" sid="EXO 10:8" />ಹೆ ಆಯ್ಕಲ್ಲ್ಯಾ ಫಾರೊವ್ ರಾಜಾನ್, ಮಯ್ಜೆಕ್ ಅನಿ ಆರೊನಾಕ್ ಅನಿ ಪರ್‍ತುನ್ ಬಲ್ವುಕ್ ಲಾವ್ನ್, “ತುಮಿ ಜಾವ್ನ್ ತುಮ್ಚ್ಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ ದೆವಾಕ್ ಆರಾದನ್ ಕರುಕ್ ಅಡ್ಡಿನಾ, ಖರೆ ಕೊನ್ ಕೊನ್ ಜಾವ್ಚೆ ಮನುನ್ ಕರ್ಲ್ಯಾಸಿ?” ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ.<verse eid="EXO 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 10:9" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, “ಅಮಿ ಸರ್ವೆಸ್ಪರಾಕ್ ಸನ್ ಕರ್‍ತಲೆ ಹಾಯ್, ತಸೆ ಹೊವ್ನ್ ಪೊರಾ, ಮ್ಹಾತಾರೆ ಸಗ್ಳೆಬಿ ಜಾತಾಂವ್, ಝಿಲ್ಗೆ, ಚೆಡ್ವಾ ಅನಿ ಜನಾವಾರಾ, ಗೊರಾ, ಬೊಕ್ಡಾ ಹೆ ಸಗ್ಳೆ ಘೆವ್ನ್ ಜಾತಾಂವ್” ಮನುನ್ ಜವಾಬ್ ದಿಲ್ಯಾನ್. <verse eid="EXO 10:9" /><verse number="10" style="v" sid="EXO 10:10" />ತನ್ನಾ ಫಾರೊವ್ ರಾಜಾನ್, “ತುಮಿ ತುಮ್ಚ್ಯಾ ಘರಾತ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಂಕ್ನಿ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಜಾವ್ಕ್ ಮಿಯಾ ಒಪ್ಕಿ ದಿಯ್ನಾ, ದಿಲ್ಲೆ ಹೊಲ್ಯಾರ್, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ದಯಾನುಚ್ ತುಮ್ಕಾ ರಾಕುಚೆ ಹೊತಾ, ಬಗಾ, ತುಮಿ ಬುರ್ಶಾ ಯವ್ಜನಿನ್ ಭರಲ್ಲೆ ಮನ್ತಲೆ ಸಮಾಚ್!”. <verse eid="EXO 10:10" /><verse number="11" style="v" sid="EXO 10:11" />ತುಮ್ಚ್ಯಾತ್ಲಿ ಘವ್ಮಾನ್ಸಾ ಯೆವ್ಡಿಚ್ ಜಾವ್ನ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಆರಾದನ್ ಕರುಚೆ, ತುಮಿ ಇಚಾರಲ್ಲೆಬಿ ತವ್ಡೆಚ್ ನೈ‍ಯ್ ಕಾಯ್? ಮನುನ್ ಸಾಂಗುನ್ ತೆಂಕಾ ಅಪ್ಲ್ಯಾ ಇದ್ರಾಕ್ನಾ ಧಾಡುನ್ ದಿಲ್ಯಾನ್. <verse eid="EXO 10:11" /><verse number="12" style="v" sid="EXO 10:12" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಹಾತ್ ಉಕ್ಲುನ್ ಠೊಳಾ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್, ಗಾರ್ಬಿಯಾಂಚ್ಯಾ ಪಾವ್ಸಾನ್ ಹಾಳ್ ಹೊಯ್ ನಸ್ತಾನಾ ಹುರಲ್ಲೆ ಸಗ್ಳೆ ಫಿಕ್ ಠೊಳಾ ಖಾಂವ್ದಿತ್” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 10:12" /><verse number="13" style="v" sid="EXO 10:13" />ತಸೆಚ್ ಮೊಯ್ಜೆನ್ ಅಪ್ನಾಚೊ ದಾಂಡೊ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾ ವರ್‍ತಿ ಉಕಲ್ಲ್ಯಾನ್, ತನ್ನಾ ಸರ್ವಶ್ವರಾನ್ ರ್‍ಹಾತ್ ಅನಿ ದಿಸ್, ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ನಾ ವಾರೆ ಮಾರಿ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್, ತ್ಯಾ ವಾರ್ಯಾ ವಾಂಗ್ಡಾ ನಸ್ಕಾತುಚ್ ಠೊಳಾ ಯೆಯ್ ಸಾರ್ಕೆ ಹೊಲೆ. <verse eid="EXO 10:13" /><verse number="14" style="v" sid="EXO 10:14" />ತಿ ಠೊಳಾ ಲೈ ಹೊತ್ತಿ, ಅನಿ ಸಗ್ಳ್ಯಾ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಪಗಳ್ಲಿ, ತಸ್ಲೆ ಪಾಟಿ ಕನ್ನಾಬಿ ಯೆಲ್ಲೆ ನತ್ತೆ, ಅನಿ ಫಿಡೆಬಿ ಯೆಯ್ ಸಾರ್ಕೆ ನಾ. <verse eid="EXO 10:14" /><verse number="15" style="v" sid="EXO 10:15" />ಪುರಾ ಜಿಮಿನ್ ಕಾಳಿ ದಿಸಿ ಸಾರ್ಕೆ ತಿ ಠೊಳಾ ಭರುನ್ ಹೊತ್ತಿ, ಗಾರ್ಬಿಯಾಂಚ್ಯಾ ಪಾವ್ಸಾನ್ ನಾಶ್ ಹೊಯ್ ನಸ್ತಾನಾ ಹೊತ್ತಿ ಹಿರ್ವಿ ಝಾಡಾ, ಫಿಕ್ ಸಗ್ಳ್ಯಾ ನಮನ್ಯಾಚಿ ಫಳಾ ಸಗ್ಳೆ ಖಾಲ್ಯಾನಿ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಪುರಾ ಹಿರ್ವೆ ಮನ್ತಲೆ ಎಕ್ಬಿ ನಾ ಹೊಲೆ. <verse eid="EXO 10:15" /><verse number="16" style="v" sid="EXO 10:16" />ತನ್ನಾ ಫಾರೊವ್ ರಾಜಾನ್ ಮೊಯ್ಜೆಕ್ ಅನಿ ಆರೊನಾಕ್ ಲಗ್ಗುನಾ ಬಲ್ವುಕ್ ಲಾವ್ನ್, “ಮಿಯಾ ತುಮ್ಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಅನಿ ತುಮ್ಚ್ಯಾ ಇದ್ರಾಕ್ ಚುಕ್ ಕರ್‍ಲೊ. <verse eid="EXO 10:16" /><verse number="17" style="v" sid="EXO 10:17" />ಅನಿ ಅತ್ತಾ ಮಾಕಾ ಎಗ್ದಾ ಕ್ಷಮಾ ಕರಾ, ಅನಿ ಹ್ಯೊ ತರಾಸ್ ಮಾಕಾ ಸೊಡುನ್ ಜಾಯ್ ಸಾರ್ಕೆ ತುಮ್ಚ್ಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಮಾಗ್ನಿ ಕರಾ”. <verse eid="EXO 10:17" /><verse number="18" style="v" sid="EXO 10:18" />ಮೊಯ್ಜೆನ್ ರಾಜಾಕ್ನಾ ಪರ್‍ತುನ್ ಜಾವ್ನ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಮಾಗ್ನಿ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 10:18" /><verse number="19" style="v" sid="EXO 10:19" />ಸರ್ವೆಸ್ಪರಾನ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ವಾರ್ಯಾಕ್ ಲೈ ಬಳಾಚೊ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಚೊ ವಾರೊ ಕರುನ್, ಎಕ್ ಠೊಳ್ ಸೊಡಿನಸ್ತಾನಾ ಫುರಾ ಠೊಳಾ ಹುಡುನ್ ಜಾವ್ನ್ ತಾಂಬ್ಡ್ಯಾ ಸಮುಂದರಾತ್ ಪಡಿ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 10:19" /><verse number="20" style="v" sid="EXO 10:20" />ಖರೆ ಸರ್ವೆಸ್ಪರಾನ್ ರಾಜಾಚೊ ಮನ್ ಮಂಡ್ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತೆನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಜಾವ್ಕ್ ದಿವ್ಕ್ ನಾ.<verse eid="EXO 10:20" /></para>
  <para style="s">ದಾಟ್ಲೊ ಕಾಳೊಕ್</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21" />ಮಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, ಮಳ್ಬಾಕ್ಡೆ ತುಜೊ ಹಾತ್ ಉಕಲ್ ತನ್ನಾ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಮೊಟೊ ಕಾಳೊಕ್ ಹೊತಾ, ಲೊಕಾಕ್ನಿ ಚಲುಕ್ಬಿ ಸುದ್ರಿನಾ ತವ್ಡೊ ಕಾಳೊಕ್ ಹೊತಾ . <verse eid="EXO 10:21" /><verse number="22" style="v" sid="EXO 10:22" />ಮೊಯ್ಜೆನ್ ಮಳ್ಬಾಕ್ಡೆ ಹಾತ್ ಉಕಲಲ್ಲ್ಯಾ ತನ್ನಾ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಪುರಾ ತಿನ್ ದಿಸ್ ಪತರ್ ದಾಟ್ಲೊ ಕಾಳೊಕ್ ಹೊವ್ನ್ ರಾಲೊ. <verse eid="EXO 10:22" /><verse number="23" style="v" sid="EXO 10:23" />ತ್ಯಾ ತಿನ್ ದಿಸಾತ್ನಿ ಎಕಾ ಮೆಕಾಕ್ ಬಗುನ್ ಘೆವ್ಕ್ ಹೊವ್ಕ್ ನಾ, ಅಪ್ನಿ ಹೊತ್ತ್ಯಾ ಜಾಗ್ಯಾ ವೈನಾ ಲೊಕಾ ಉಟುಕ್ ನಾತ್, ಖರೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಹೊತ್ತ್ಯಾಕ್ಡೆ ಉಜ್ವೊಡ್ ಹೊತ್ತೊ. <verse eid="EXO 10:23" /><verse number="24" style="v" sid="EXO 10:24" />ತನ್ನಾ ಫಾರೊವ್ ರಾಜಾನ್ ಮೊಯ್ಜೆಕ್ ಬಲ್ವುನ್, “ತುಮಿ ಜಾವ್ನ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಆರಾದನ್ ಕರಾ, ಜಾತಾನಾ ತುಮ್ಚ್ಯಾ ಬಾಯ್ಕಾ ಪೊರಾಕ್ನಿ ಘೆವ್ನ್ ಜಾವಾ, ಖರೆ ತುಮ್ಚಿ ಜನಾವಾರಾ ಹಿತ್ತೆಚ್ ರಾಂವ್ದಿತ್, ತುಮಿ ತೆ ಸೊಡುನ್ ಜಾವ್ಚೆ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 10:24" /><verse number="25" style="v" sid="EXO 10:25" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, “ಅಮ್ಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಜಾಳ್ವುತಲಿ ಬಲಿ ದಿವ್ಕ್ ಪಾಜೆ, ತೆಕಾ ಪಾಜೆ ಹೊಲ್ಲಿ ಜನಾವರಾ ಅಮ್ಕಾ ದಿ”. <verse eid="EXO 10:25" /><verse number="26" style="v" sid="EXO 10:26" />ಅನಿ ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಅಮ್ಚಿ ಸಗ್ಳಿ ಜನಾವರಾಬಿ ಘೆವ್ನ್ ಜಾವ್ಕ್ ಅವ್ಕಾಸ್ ದಿ, ಎಕ್ ಜನಾವರ್ಬಿ ಅಮಿ ಸೊಡುನ್ ಜಾವ್ಕ್ ಹೊಯ್ನಾ, ಅನಿ ಹ್ಯಾ ಜನಾವಾರಾನಿ ಸರ್ವೆಸ್ಪರಾಕ್ ಬಲಿ ಭೆಟ್ವುತಲೆ ಹಾಯ್, ಖಲಿ ಖಲಿ ಜನಾವಾರಾ ಬಲಿ ಭೆಟ್ವುಚೆ ಮನ್ತಲೆ ಅಮಿ ಥೈ ಜಾವ್ನ್ ಪಾವ್ಚ್ಯಾ ಅದ್ದಿ ಕಳಿನಾ; ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 10:26" /><verse number="27" style="v" sid="EXO 10:27" />ಸರ್ವೆಸ್ಪರಾನ್ ರಾಜಾಚೊ ಮನ್ ಮಂಡ್ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತೆನಿ ತೆಂಕಾ ಜಾವ್ಕ್ ಒಪ್ಕಿ ದಿವ್ಕ್ ನಾ. <verse eid="EXO 10:27" /><verse number="28" style="v" sid="EXO 10:28" />ರಾಜಾನ್ ಮೊಯ್ಜೆಕ್, ಹಿತ್ತೆತ್ನಾ ಜಾ; ಹೆಚ್ಯಾನ್ ಫಿಡೆ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಯೆವ್ ನಕ್ಕೊ, ಹುಶಾರ್! ಪರ್‍ತುನ್ ಮಿಯಾ ತುಕಾ ಬಗಿನಾ ಸಾರ್ಕೆ ರಾ, ಮಿಯಾ ಪರ್‍ತುನ್ ತುಕಾ ಬಗಲ್ಲ್ಯಾ ದಿಸಾಚ್ ತಿಯಾ ಮರ್ತೆಯ್; ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="EXO 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 10:29" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, “ಬರೆ, ತಿಯಾ ಖರೆಚ್ ಸಾಂಗ್ಲೆಯ್, ಅನಿ ಫಿಡೆ ತುಕಾ ಮಿಯಾ ಬಗಿನಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 10:29" /></para>
  <chapter eid="EXO 10" />
  <chapter number="11" style="c" sid="EXO 11" />
  <para style="s">ಥೊರ್ಲಾ ಪೊರಾಚ್ಯಾ ಮರ್ನಾಚ್ಯಾ ವಿಶಯಾತ್ ಮೊಯ್ಜೆಕ್ನಾ ಹುರ್ಶಾಕಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ಫಾರೊವ್ ರಾಜಾಕ್ ಅನಿ ಇಜಿಪ್ತ್ ಲೊಕಾಕ್ನಿ ಅನಿ ಎಕ್ ಶಿಕ್ಷ್ಯಾ ಧಾಡ್ತಾ, ತವ್ಡೆ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ತೊ ತುಮ್ಕಾ ಹಿತ್ತೆತ್ನಾ ಜಾವ್ಕ್ ಒಪ್ಕಿ ದಿತಾ, ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ತುಮ್ಕಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಥೈತ್ನಾ ಪಳ್ಸುನ್ ಘಾಲ್ತಾ. <verse eid="EXO 11:1" /><verse number="2" style="v" sid="EXO 11:2" />ತಸೆ ಹೊವ್ನ್, ಬಾಯ್ಕಾ ಮಾನ್ಸಾ ಅನಿ ಘವ್ಮಾನ್ಸಾ ಸಗ್ಳ್ಯಾನಿಬಿ ಅಪ್ಲ್ಯಾ ಅಪ್ಲ್ಯಾ ಆಜು ಭಾಜುಕ್ನಾ ಸೊನೆ, ಚಾಂದಿಚಿ ವಸ್ತಾ ಸಗ್ಳಿ ಮಾಗುನ್ ಘೆವಾ, ಮನುನ್ ತುಮ್ಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಸಮಾ ಕರುನ್ ಸಾಂಗಾ”, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 11:2" /><verse number="3" style="v" sid="EXO 11:3" />ಅನಿ ಸರ್ವೆಸ್ಪರಾನ್ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಅನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಚ್ಯಾ ವರ್‍ತಿ ದಯಾ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್, ಅನಿ ಇಜಿಪ್ತ್ ದೆಸಾತ್ಲ್ಯಾ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಘರಾತ್ಲ್ಯಾ ಲೊಕಾನಿ ಮೊಯ್ಜೆ ಎಕ್ ಮೊಟೊ ಮಾನುಸ್ ಮನುನ್ ನೆಮ್ಲ್ಯಾನಿ. <verse eid="EXO 11:3" /><verse number="4" style="v" sid="EXO 11:4" />ಮೊಯ್ಜೆನ್ ಫಾರೊವ್ ರಾಜಾಕ್, ಸರ್ವೆಸ್ಪರಾನ್ ಅಸೆ ಹುಕುಮ್ ದಿಲಾ, ಮಿಯಾ ಮದ್ದಿ ರಾತ್ತಿನ್ ಇಜಿಪ್ತಾಕ್ನಾ ದಾಟುನ್ ಜಾತಾ, <verse eid="EXO 11:4" /><verse number="5" style="v" sid="EXO 11:5" />ತನ್ನಾ ಸಿಂವಾಸನಾರ್ ಬಸಲ್ಲ್ಯಾ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಥೊರ್ಲ್ಯಾ ಲೆಕಾಕ್ನಾ, ಜಾತೆ ಧರುನ್ ಬಸಲ್ಲ್ಯಾ ದಾಸಿಚ್ಯಾ ಥೊರ್ಲ್ಯಾ ಪೊರಾ ಪತರ್ಬಿ ಇಜಿಪ್ತ್ ದೆಸಾತ್ಲಿ ಸಗ್ಳಿ ಥೊರ್ಲಿ ಪೊರಾಬಿ ಮರ್ತಾತ್, ಜನಾವಾರಾತ್ನಿಬಿ ಥೊರ್ಲಿ ಹೊತ್ತಿ ಸಗ್ಳಿ ಮರ್ತಾತ್. <verse eid="EXO 11:5" /><verse number="6" style="v" sid="EXO 11:6" />ತನ್ನಾ ಸಗ್ಳ್ಯಾ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಮೊಟೊ ಆಳಾಪ್ ಹೊತಾ, ತಸ್ಲೊ ಅಳಾಪ್ ಅದ್ದಿಬಿ ರಾವ್ಕ್ ನತ್ತೊ ಅನಿ ಫಿಡೆಬಿ ರ್‍ಹಾಯ್ನಾ. <verse eid="EXO 11:6" /><verse number="7" style="v" sid="EXO 11:7" />ಖರೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ವಿರೊಧ್ ಹೊಂವ್ದಿತ್ ನಾತರ್ ಜನಾವರಾಂಚ್ಯಾ ವಿರೊದ್ ಹೊಂವ್ದಿತ್ ಎಕ್ ಕುತ್ರೆಬಿ ಭೊಕಿನಾ, ಹೆಚ್ಯಾ ವೈನಾ ಸರ್ವೆಸ್ಪರಾನ್ ತುಮ್ಕಾ ಅನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಎಗ್ಳೆ ಕರ್ಲ್ಯಾನ್, ಮನ್ತಲೆ ತುಮ್ಕಾ ಕಳ್ತಾ. <verse eid="EXO 11:7" /><verse number="8" style="v" sid="EXO 11:8" />ತನ್ನಾ ತುಜ್ಯಾ ಅಧಿಕಾರಿಯಾ, ಹಿ ಲೊಕಾಬಿ ಮಾಜ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆವ್ನ್ ಅಡ್ವೆ ಪಡುನ್, ತುಮಿ ಅನಿ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತಿ ಸಗ್ಳಿ ಲೊಕಾ ಅಮ್ಕಾ ಸೊಡುನ್ ಜಾವಾ, ಮನುನ್ ಮಾಗುನ್ ಘೆತಾತ್, ಹೆ ಸಗ್ಳೆ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಮಿಯಾ ಜಾತಾ ಮಟ್ಲ್ಯಾನ್, ಹಿ ಬೊಲ್ನಿಯ ಸಗ್ಳಿ ಸಾಂಗುನ್ ಮೊಯ್ಜೆ ಲೈ ರಾಗಾನ್ ಫಾರೊವ್ ರಾಜಾಕ್ನಾ ಗೆಲೊ. <verse eid="EXO 11:8" /><verse number="9" style="v" sid="EXO 11:9" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ಫಾರೊವ್ ತುಮ್ಚ್ಯಾ ಗೊಸ್ಟಿಯಾ ಆಯ್ಕಿನಾ, ತಸೆ ಹೊವ್ನ್ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಅಜಾಪಾಚಿ ಕಾಮಾ ಲೈ ಕರುನ್ ದಾಕ್ವುಕ್ ಆದಾರ್ ಹೊತಾ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 11:9" /><verse number="10" style="v" sid="EXO 11:10" />ಮೊಯ್ಜೆನ್ ಅನಿ ಆರೊನಾನ್ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಇದ್ರಾಕ್ ಹಿ ಅಜಾಪಾಚಿ ಕಾಮಾ ಸಗ್ಳಿ ಕರ್ಲ್ಯಾನಿ, ಖರೆ ಸರ್ವೆಸ್ಪರಾನ್ ಫಾರೊವ್ ರಾಜಾಚೊ ಮನ್ ಮಂಡ್ ಕರ್ಲ್ಯಾನ್, ತೆನಿ ಅಪ್ಲೊ ದೆಶ್ ಸೊಡುನ್ ಜಾವ್ಕ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಒಪ್ಕಿ ದಿವ್ಕ್ ನಾ.<verse eid="EXO 11:10" /></para>
  <chapter eid="EXO 11" />
  <chapter number="12" style="c" sid="EXO 12" />
  <para style="s">ಪಾತ್ಕಾಚೊ ಸನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1" />ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಸರ್ವೆಸ್ಪರಾನ್ , ಮೊಯ್ಜೆ ಅನಿ ಆರೊನಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲುನ್ ಅಸೆ ಮಟ್ಲ್ಯಾನ್, <verse eid="EXO 12:1" /><verse number="2" style="v" sid="EXO 12:2" />ಸಗ್ಳ್ಯಾ ಮೈನ್ಯಾತ್ನಿ ಹೊಚ್ ತುಮ್ಕಾ ವರ್ಸಾಚೊ ಪೈಲೆಚೊ ಮೈನೊ ಹೊವ್ನ್ ರಾವ್ಚೊ. <verse eid="EXO 12:2" /><verse number="3" style="v" sid="EXO 12:3" />ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ಡೆ ಬೊಲುನ್, ತೆಂಕಾ, ಹ್ಯಾ ಮೈನ್ಯಾಚ್ಯಾ ಧಾ ವೆಚ್ಯಾ ದಿಸಿ ತುಮ್ಚ್ಯಾತ್ಲ್ಯಾ ಹರ್ ಎಕ್ಲ್ಯಾನಿಬಿ ಎಕ್ ಶೆಳಿ ಎಚುನ್, ಎಕ್ ಘರ್‍ಹಾತ್ನಾ ಎಕ್ ಶೆಳಿ ನಾತರ್ ಬಕ್ರೆ ಹಾನುಚೆ ಮನುನ್ ಸಾಂಗ್. <verse eid="EXO 12:3" /><verse number="4" style="v" sid="EXO 12:4" />ತಿ ಶೆಳಿ ಖಾವ್ನ್ ಸಾರುಕ್ ಎಕ್ ಘರ್‍ಹಾತ್ನಾ ಹೊಯ್ನಾಸಲ್ಲಿ ಕಮ್ಮಿ ಲೊಕಾ ತ್ಯಾ ಘರ್‍ಹಾತ್ ಹೊತ್ತಿ ಹೊಲ್ಯಾರ್, ಬಾಜುಚ್ಯಾ ಘರಾತ್ಲ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳುನ್ ಎಕ್ ಮಾನ್ಸಾನ್ ಕವ್ಡೆ ಖಾವ್ಕ್ ಹೊತಾ ಮನ್ತಲ್ಯಾ ತವ್ಡೆ ಶೆಳಿಚೊ ಪೆಟೊ ಎಚುನ್ ಘೆಂವ್ದಿತ್. <verse eid="EXO 12:4" /><verse number="5" style="v" sid="EXO 12:5" />ತಿ ಶೆಳಿ ಕಸ್ಲೊಬಿ ದೊಶ್ ನಸಲ್ಲೊ ಎಕ್ ವರ್ಸಾಚೊ ಗಂಡ್ ಪೆಟೊ ಹೊವ್ನ್ ರಾವ್ಚೆ, ತುಮಿ ಬಕ್ರೆ ನಾತರ್ ಶೆಳಿಚೊ ಪೆಟೊ ಘೆವ್ಚೆ. <verse eid="EXO 12:5" /><verse number="6" style="v" sid="EXO 12:6" />ಹ್ಯಾ ಮೈನ್ಯಾಚ್ಯಾ ಚವ್ದಾಚ್ಯಾ ದಿಸಾ ಪತರ್ಬಿ ತೆ ಥವ್ನ್ ಘೆವ್ನ್ ತ್ಯಾ ದಿಸಿ ಸಾಂಚೆಕ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಅಪ್ಲ್ಯಾ ಅಪ್ಲ್ಯಾ ಕುಟ್ಮಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಸನಾಕ್ ಕಾಪುಚೆ. <verse eid="EXO 12:6" /><verse number="7" style="v" sid="EXO 12:7" />ತ್ಯಾ ಶೆಳಿಯಾಂಚ್ಯಾ ರಗ್ತಾತ್ ಉಲ್ಲೆ ಕಾಡುನ್, ಅಪ್ನಿ ಜೆವಾನ್ ಕರ್‍ತಲ್ಯಾ ತ್ಯಾ ಘರಾಚ್ಯಾ ದಾರಾಚ್ಯಾ ದೊನ್ ಪಟ್ಟಿಯಾಕ್ನಿ ಬಿ ಅನಿ ವೈಲ್ಯಾ ದೊನ್ ಪಟ್ಟಿಯಾಂಕ್ನಿಬಿ ಲಾವ್ಚೆ. <verse eid="EXO 12:7" /><verse number="8" style="v" sid="EXO 12:8" />ತ್ಯಾ ದಿಸಿ ರಾತ್ತಿನುಚ್ ತೆ ಮಾಸ್ ಖಾವ್ಚೆ, ತ್ಯಾ ಆಗಿತ್ ಭಾಜುನ್ ಫುಗ್ ನಸಲ್ಲ್ಯಾ ಬಾರಿಕ್ಲಿಯಾಂಚ್ಯಾ ಅನಿ ಕೊಡು ನಿಸ್ತ್ಯಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಜೆವ್ಚೆ. <verse eid="EXO 12:8" /><verse number="9" style="v" sid="EXO 12:9" />ತೆ ಮಾಸ್ ಹಿರ್ವೆ ನಾತರ್ ಪಾನಿ ಘಾಲುನ್ ಸಿಜ್ವುನ್ ಖಾವ್ಚೆ ನ್ಹಯ್ , ಟಕ್ಲೆ, ಪಾಂಯಾ, ಪೊಟಾತ್ಲೆ ಸಗ್ಳೆಬಿ ಆಗಿತುಚ್ ಭಾಜುನ್ ಖಾವ್ಚೆ. <verse eid="EXO 12:9" /><verse number="10" style="v" sid="EXO 12:10" />ದುಸ್ರೆ ದಿಸಿ ಸಕ್ಕಾಳ್ ಪತರ್ ಉಲ್ಲೆಬಿ ಹುರ್ವುಚೆ ನ್ಹಯ್ , ಸಕ್ಕಾಳ್ ಪತರ್ ಹುರಲ್ಲೆ ಆಗಿನ್ ಜಾಳುನ್ ಟಾಕುಚೆ. <verse eid="EXO 12:10" /><verse number="11" style="v" sid="EXO 12:11" />ತೆ ಜೆವಾನ್ ಜೆವ್ತಾನಾ, ಪರ್ಯಾನಾಕ್ ತಯಾರ್ ಹೊಲ್ಲ್ಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ, ತುಮಿ ಕಂಬ್ರೆಚೊ ಪಟ್ಟೊ ಬಾಂದುನ್ ಘೆವ್ನ್, ಹೊನಯಾ ನೆಸುನ್ಗೆನ್, ಹಾತಿತ್ ಎಕ್ ದಾಂಡೊ ಘೆವ್ನ್ ಲಗ್ಗು ಲಗ್ಗುನಾ ಜೆವಾನ್ ಕರುಚೆ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಸರ್ವೆಸ್ಪರಾಕ್ ಮಾನ್ ದಿತಲೊ ಪಾತ್ಕಾಚೊ ಸನ್ ಹ್ಯೊ. <verse eid="EXO 12:11" /><verse number="12" style="v" sid="EXO 12:12" />ತ್ಯಾ ರಾತ್ತಿನ್ ಮಿಯಾ ಇಜಿಪ್ತಾಚ್ಯಾ ಮದ್ನಾ ಜಾತಾ, ಅನಿ ಇಜಿಪ್ತಾಚ್ಯಾ ಮಾನ್ಸಾತ್ನಿ ಹೊಂವ್ದಿತ್ ಜನಾವರಾತ್ನಿ ಹೊಂವ್ದಿತ್ ಪೈಲೆ ಉಪಾಜಲ್ಲೆ ಹೊತ್ತೆ ಮಿಯಾ ಜಿವ್ ಕಾಡ್ತಾ, ಇಜಿಪ್ತಾಚ್ಯಾ ದೆವತೆಕ್ನಿ ನ್ಯಾಯ್ ನಿರ್ನಯ್ ಕರ್ತಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ . <verse eid="EXO 12:12" /><verse number="13" style="v" sid="EXO 12:13" />ಖರೆ ತುಮಿ ದಾರಾಕ್ ಲಾವಲ್ಲ್ಯಾ ರಗ್ತಾ ವೈನಾ ತುಮಿ ಹೊತ್ತೆ ಘರ್ ಮಾಕಾ ಕಳ್ತಾ, ತೆ ಬಗುನ್ ಮಿಯಾ ತುಮ್ಕಾ ಕಾಯ್ಬಿ ಕರಿ ನಸ್ತಾನಾ ಜಾತಾ. ಮಿಯಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಚ್ಯಾಕ್ನಿ ತರಾಸ್ ದಿತಾನಾ ತುಮ್ಕಾ ಕಾಯ್ಬಿ ತರಾಸ್ ಹೊಯ್ನಾ. <verse eid="EXO 12:13" /><verse number="14" style="v" sid="EXO 12:14" />ಹ್ಯೊ ದಿಸ್ ತುಮ್ಕಾ ಯಾದ್ ರಾತಲೊ ದಿಸ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ತ್ಯಾ ದಿಸಾ ತುಮಿ ಸರ್ವೆಸ್ಪರಾಕ್ ಮಾನ್ ದಿತಲೊ ಸನ್ ಕರುನ್ ಸುತ್ತಿ ಕರುಚೆ, ತೊ ಶಾಶ್ವತ್ ನೆಮ್ ಮನುನ್ ಸದಾ ಸರ್ವತಾಕ್ ಸನ್ ಕರುಚೆ.<verse eid="EXO 12:14" /></para>
  <para style="s">ಫುಗ್ ನಸಲ್ಲ್ಯಾ ಬಾರಿಕ್ಲಿಯಾಂಚೊ ಸನ್</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 12:15" />“ಸಾತ್ ದಿಸಾಚ್ಯಾ ಪತರ್ ತುಮಿ ಫುಗ್ ನಸಲ್ಲಿ ಭಾಕ್ರಿಯಾ ಖಾವ್ಚೆ, ಪೈಲೆಚ್ಯಾ ದಿಸಿಚ್ ತುಮ್ಚ್ಯಾ ಘರಾತ್ನಿ ಹೊತ್ತೆ ಫುಗ್ ಹೊತ್ತೆ ಪಿಟ್ಟ್ ಸಗ್ಳೆ ತುಮಿ ಕಾಡುಚೆ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತ್ಯಾ ಸಾತ್ ದಿಸಾತ್ನಿ ಆಂಬೊಟ್ ಮಿಳ್ವಲ್ಲಿ ಭಾಕ್ರಿಯಾ ಕೊನ್ ತರಿಬಿ ಖಾಲ್ಯಾರ್ ತೆಕಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಬಾರ್ಯಾ ಘಾಲುಚೆ. <verse eid="EXO 12:15" /><verse number="16" style="v" sid="EXO 12:16" />ಪೈಲೆಚ್ಯಾ ದಿಸಾ ದೆವಾಕ್ ಆರಾದನ್ ಕರುಕ್ ಗೊಳಾ ಹೊವ್ನ್ ಯೆವ್ಚೆ, ಸಾತ್ವ್ಯಾ ದಿಸಿಬಿ ದೆವಾಕ್ ಆರಾದನ್ ಕರುಕ್ ತಾಂಡೊ ಹೊವ್ನ್ ಮಿಳುನ್ ಯೆವ್ಚೆ. ಹ್ಯಾ ಆರಾದನ್ ಕರ್‍ತಲ್ಯಾ ದೊನ್ ದಿಸಾತ್ನಿ ಕಾಯ್ಬಿ ಕಾಮ್ ಕರುಚೆ ನ್ಹಯ್, ಜೆವ್ನಾಕ್ ಪಾಜೆ ತವ್ಡೆಚ್ ತಯಾರ್ ಕರುನ್ ಘೆವ್ಚೆ. <verse eid="EXO 12:16" /><verse number="17" style="v" sid="EXO 12:17" />ಫುಗ್ ನತ್ತಿ ಭಾಕ್ರಿಯಾ ಖಾತಲೊ ಸನ್ ತುಮಿ ಕರುಚೆ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಮಿಯಾ ತುಮ್ಕಾ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಕ್ನಾ ಬಲ್ವುನ್ ಹಾನಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತುಮಿ ಅನಿ ತುಮ್ಚ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ ಸಗ್ಳ್ಯಾ ಎಳಾರ್ನಿಬಿ ಹ್ಯಾ ದಿಸಾಚೊ ಸನ್ ಕರುಚೆ. <verse eid="EXO 12:17" /><verse number="18" style="v" sid="EXO 12:18" />ಪೈಲೆಚ್ಯಾ ಮೈನ್ಯಾಚ್ಯಾ ಚವ್ದಾವ್ಯಾ ದಿಸಾಚ್ಯಾ ಸಾಂಚೆಕ್ನಾ ವಿಸ್ ಅನಿ ಎಕ್ ದಿಸಾಚ್ಯಾ ಸಾಂಚೆ ಪತರ್ಬಿ ಫುಗ್ ನಸಲ್ಲಿ ಭಾಕ್ರಿಯಾ ಖಾವ್ಚೆ. <verse eid="EXO 12:18" /><verse number="19" style="v" sid="EXO 12:19" />ಸಾತ್ ದಿಸಾ ಪತರ್ ತುಮ್ಚ್ಯಾ ಘರಾತ್ನಿ ಆಂಬೊಟ್ ಪಿಟ್ಟುಚ್ ರಾವ್ಚೆ ನ್ಹಯ್ , ಆಂಬೊಟ್ ಮಿಳ್ವುಲ್ಲೆ ಖಾತಲೊ ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಶಾಚೊ ಹೊಂವ್ದಿ ನಾತರ್ ದುಸ್ರ್ಯಾ ದೆಶಾಚೊ ಹೊಂವ್ದಿ ತೆಕಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂತ್ನಾ ಬಾರ್ಯ ಘಾಲುನ್ ಹೊತಾ. <verse eid="EXO 12:19" /><verse number="20" style="v" sid="EXO 12:20" />ತುಮಿ ತುಮ್ಚ್ಯಾ ಘರಾತ್ನಿ ಫುಗ್ ನಸಲ್ಲಿ ಬಾರಿಕ್ಲಿಯಾಚ್ ಖಾವ್ಚೆ ಅನಿ ಆಂಬೊಟ್ ಮಿಳ್ವಲ್ಲೆ ಕಾಯ್ಬಿ ಖಾವ್ಚೆ ನ್ಹಯ್ ” ಮನುನ್ ತಾಕಿತ್ ದಿಲ್ಯಾನ್.<verse eid="EXO 12:20" /></para>
  <para style="s">ಪೈಲೆಚೊ ಪಾತ್ಕಾಚೊ ಸನ್</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21" />ಮೊಯ್ಜೆನ್ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಜಾಂನ್ತ್ಯಾ ಲೊಕಾಕ್ನಿ ಬಲ್ವುಕ್ ಲಾವ್ನ್ ತೆಂಕಾ, “ತುಮಿ ತುಮ್ಚ್ಯಾ ತುಮ್ಚ್ಯಾ ಕುಟ್ಮಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಬಕ್ರ್ಯಾಂಚ್ಯಾ ತಾಂಡ್ಯಾತ್ನಾ ಪೆಟೆ ಎಚುನ್ ಘೆವ್ನ್ ಪಾತ್ಕಾಚ್ಯಾ ಸನಾಕ್ ಕಾಪಾ. <verse eid="EXO 12:21" /><verse number="22" style="v" sid="EXO 12:22" />ಹಿಸ್ಸೊಪ್ ಝಾಡಾಚಿ ಟಾಳಿ ಆಯ್ದಾನಾತ್ ಹೊತ್ತ್ಯಾ ರಗ್ತಾತ್ ಬುಡ್ವುನ್ ದಾರಾಚ್ಯಾ ಪಟ್ಟಿಯಾಕ್ನಿ ಅನಿ ತೆಚ್ಯಾ ದೊನಿ ಖಾಂಬ್ಯಾಕ್ನಿ ಬಿ ಲಾವಾ, ಅನಿ ತುಮ್ಚ್ಯಾತ್ಲೊ ಎಕ್ಲೊಬಿ ದಿಸ್ ಉಗಾವಿ ಪತರ್ ಬಿ ದಾರಾತ್ನಾ ಭಾಯ್ರ್ ಜಾವ್ಚೆ ನ್ಹಯ್. <verse eid="EXO 12:22" /><verse number="23" style="v" sid="EXO 12:23" />ಸರ್ವೆಸ್ಪರಾನ್ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಮಾರುಕ್ ಜಾತಾನಾ ತ್ಯಾ ದೆಸಾತ್ನಾ ಜಾತಾ, ತನ್ನಾ ತುಮ್ಚ್ಯಾ ಘರಾಚ್ಯಾ ಪೈರಿಯಾರ್ನಿ ಅನಿ ದೊನಿ ಖಾಂಬ್ಯಾರ್ನಿ ತೆ ರಗಾತ್ ಬಗುನ್ ಫಿಡೆ ದಾಟುನ್ ಜಾತಾ. ತುಮ್ಕಾ ಮಾರುನ್ ನಾಶ್ ಕರ್ನಾರೊ ಮರ್ನಾಚೊ ಧುತ್ ತುಮ್ಚ್ಯಾ ಘರಾತ್ನಿ ಯೆವ್ಕ್ ದಿಯ್ನಾ. <verse eid="EXO 12:23" /><verse number="24" style="v" sid="EXO 12:24" />ತುಮಿ ಅನಿ ತುಮ್ಚ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ ಹ್ಯೊ ನೆಮ್ ಶಾಶ್ವತ್ ಕರುಚೆ. <verse eid="EXO 12:24" /><verse number="25" style="v" sid="EXO 12:25" />ಸರ್ವೆಸ್ಪರಾನ್ ಅಪ್ಲ್ಯಾ ಗೊಸ್ಟಿ ಸಾರ್ಕೆ ತುಮ್ಕಾ ದಿತಲ್ಯಾ ದೆಶ್ಯಾಕ್ ತುಮಿ ಪಾವಲ್ಲ್ಯಾ ತನ್ನಾ, ತುಮಿ ಹ್ಯೊ ನೆಮ್ ಕರುಕುಚ್ ಪಾಜೆ. <verse eid="EXO 12:25" /><verse number="26" style="v" sid="EXO 12:26" />ಫಿಡೆ ತುಮ್ಚ್ಯಾ ಪೊರಾಕ್ನಿ, ತುಮಿ ಆಚರನ್ ಕರ್‍ತಲ್ಯಾ ಹ್ಯಾ ನೆಮಾಚೊ ಅರ್ಥ್ ಕಾಯ್? ಮಟ್ಲ್ಯಾರ್ ತುಮಿ ತೆಂಕಾ, <verse eid="EXO 12:26" /><verse number="27" style="v" sid="EXO 12:27" />ಸರ್ವೆಸ್ಪರಾನ್ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಮಾರಲ್ಲ್ಯಾ ತನ್ನಾ ತೆಂಚ್ಯಾ ದೆಸಾತ್ ಹೊತ್ತ್ಯಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ಘರಾಕ್ನಿ ಗುಸಿ ನಸ್ತಾನಾ, ಫಿಡೆ ದಾಟುನ್ ಜಾವ್ನ್ ಅಮ್ಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಹುರ್ವುಲ್ಯಾನ್, ತಸೆ ಹೊವ್ನ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಮಾನ್ ದಿವ್ಕ್ ಸಾಟ್ನಿ ಪಾತ್ಕಾಚ್ಯಾ ಬಲಿಚೊ ಸನ್ ಕರುಲಾಂವ್, ಮನುನ್ ಜವಾಬ್ ದಿವಾ” ಮಟ್ಲ್ಯಾನ್. ತನ್ನಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಡಿಂಬಿಯಾ ಘಾಲುನ್ ಆರಾದನ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 12:27" /><verse number="28" style="v" sid="EXO 12:28" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಅನಿ ಆರೊನಾಕ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಚಲುನ್ ಗೆಲ್ಯಾನಿ.<verse eid="EXO 12:28" /></para>
  <para style="s">ಥೊರ್ಲ್ಯಾ ಪೊರಾಂಚೆ ಮರಾನ್</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29" />ಅರ್ದ್ಯಾ ರಾತ್ತಿನ್ ಸರ್ವೆಸ್ಪರಾನ್ , ಸಿಂವಾಸನಾರ್ ಬಸಲ್ಲ್ಯಾ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಥೊರ್ಲ್ಯಾ ಲೆಕಾಕ್ನಾ ಬಂಧಿಖಾನ್ಯಾತ್ ಹೊತ್ತ್ಯಾಚ್ಯಾ ಥೊರ್ಲ್ಯಾ ಲೆಕಾ ಪತರ್ಬಿ, ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಥೊರ್ಲ್ಯಾ ಪೊರಾಕ್ನಿ ಅನಿ ಜನಾವರಾಂಚ್ಯಾ ಥೊರ್ಲ್ಯಾ ಪೆಟ್ಯಾಕ್ನಿ ಜಿವ್ ಕಾಡ್ಲ್ಯಾನ್. <verse eid="EXO 12:29" /><verse number="30" style="v" sid="EXO 12:30" />ತ್ಯಾ ರಾತ್ತಿನ್ ಫಾರೊವ್ ರಾಜಾ ಅನಿ ತೆಚ್ಯಾ ಅಧಿಕಾರಿ ಲೊಕಾನಿ ಸಗ್ಳ್ಯಾನಿ ಉಟುನ್ ಬಗಲ್ಯಾ ತನ್ನಾ ಮಡೆ ನಸಲ್ಲೆ ಘರ್ ಎಕ್ಬಿ ನತ್ತೆ, ತಸೆ ಹೊವ್ನ್ ತ್ಯಾ ಪುರಾ ದೆಶ್ಯಾತ್ ಮೊಟೊ ಅಳಾಪ್ ಉಟ್ಲೊ.<verse eid="EXO 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 12:31" />ಫಾರೊವ್ ರಾಜಾನ್ ತ್ಯಾ ರಾತ್ತಿನ್ ಮೊಯ್ಜೆಕ್ ಅನಿ ಆರೊನಾಕ್ ಬಲ್ವುಕ್ ಲಾವ್ನ್, “ತುಮಿ ಅಮ್ಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಮದ್ನಾ ಜಾವಾ, ತುಮಿ ಮಾಗುನ್ ಘೆಟಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ತುಮಿ ಅನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಆರಾದನ್ ಕರುಕ್ ಜಾವಾ. <verse eid="EXO 12:31" /><verse number="32" style="v" sid="EXO 12:32" />ತುಮಿ ಮಾಗುನ್ ಘೆಟಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಸರ್ವೆಸ್ಪರಾಕ್ ಆರಾದನ್ ಕರುಕ್, ತುಮಿ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಬಕ್ರಿ, ಶೆಳಿಯಾ ಅನಿ ಗೊರಾಬಿ ಘೆವ್ನ್ ಜಾವಾ, ಮಾಜ್ಯಾ ಬರೆ ಪಾನಾ ಸಾಟ್ನಿಬಿ ಮಾಗ್ನಿ ಕರಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 12:32" /><verse number="33" style="v" sid="EXO 12:33" />ಇಜಿಪ್ತ್ ದೆಶಾಚ್ಯಾ ಲೊಕಾನಿ, “ಅಮಿ ಸಗ್ಳೆ ಮರ್ತಾಂವ್” ಮನುನ್ ಚಿಂತುನ್ಗೆವ್ನ್ ಲಗ್ಗುನಾ ಅಪ್ಲೊ ದೆಶ್ ಸೊಡುನ್ ಜಾವಾ, ಮನುನ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಒತ್ತಾಯ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 12:33" /><verse number="34" style="v" sid="EXO 12:34" />ತಸೆ ಹೊವ್ನ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಆಂಬೊಟ್ ನಸಲ್ಲೆ ಪಿಟ್ ಆಯ್ದಾನಾತ್ನಿ ಭರುನ್ಗೆವ್ನ್, ಕಪ್ಡ್ಯಾತ್ನಿ ಲಪ್ಟುನ್ ಅಪ್ಲ್ಯಾ ಖಾಂಜ್ಯಾರ್ನಿ ಥವ್ನ್ ಘೆವ್ನ್ ಜಾವ್ಕ್ ಲಾಗ್ಲೆ.<verse eid="EXO 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 12:35" />ಜಾತಾನಾ ತೆನಿ ಮೊಯ್ಜೆನ್ ಸಾಂಗುನ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಇಜಿಪ್ತ್ ದೆಶಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಚಾಂದಿ ಅನಿ ಸೊನ್ಯಾಚಿ ವಸ್ತಾ ಅನಿ ಕಪ್ಡೆಬಿ ಮಾಗುನ್ ಘೆಟ್ಲ್ಯಾನಿ. <verse eid="EXO 12:35" /><verse number="36" style="v" sid="EXO 12:36" />ಸರ್ವೆಸ್ಪರಾನ್ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ವರ್‍ತಿ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ದಯಾ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್, ತಸೆ ಹೊವ್ನ್ ತೆನಿ ಮಾಗಲ್ಲೆ ಸಗ್ಳೆ ಇಜಿಪ್ತ್ ದೆಶಾಚ್ಯಾ ಲೊಕಾನಿ ದಿಲ್ಯಾನಿ, ಅಸೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಇಜಿಪ್ತ್ ಲೊಕಾಂಚಿ ಆಸ್ತಿ ಸಗ್ಳಿ ಲುಟುನ್ ಘೆಟ್ಲ್ಯಾನಿ.<verse eid="EXO 12:36" /></para>
  <para style="s">ಇಜಿಪ್ತ್ ದೆಸಾಕ್ನಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಜಾತಲೆ</para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ರಾಮ್ಸೆಸ್ ಶಾರಾಕ್ನಾ ಜಾವ್ನ್ ಸುಕ್ಕೊತ್ ಮನ್ತಲ್ಯಾಕ್ಡೆ ಯೆಲ್ಯಾನಿ, ತೆನಿ ಬಾಯ್ಕಾ ಮನ್ಸಾ ಅನಿ ಪೊರಾ ಸೊಡುನ್ ಬರಿ ಘವ್ಮಾನ್ಸಾ ತವ್ಡಿಚ್ ಲೈ ಕರುನ್ ಸಾ ಲಾಕ್ ಹೊತ್ತಿ. <verse eid="EXO 12:37" /><verse number="38" style="v" sid="EXO 12:38" />ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಲೈ ಲೊಕಾ ದುಸ್ರ್ಯಾ ದೆಶಾಚಿ ಯೆಲ್ಲಿ, ಬಕ್ರಿ, ಶೆಳಿ ಅನಿ ಗೊರಾ ಲೈ ನಮುನ್ಯಾಚಿ ಜನಾವಾರಾ ಬಿ ಜಾವ್ಕ್ ಲಾಗಲ್ಲೆ. <verse eid="EXO 12:38" /><verse number="39" style="v" sid="EXO 12:39" />ಇಜಿಪ್ತ್ ದೆಸಾಕ್ನಾ ಹಾನಲ್ಯಾ ಫಿಟ್ಟಾಚ್ಯಾ ಮುದ್ದ್ಯಾನಿಕ್ನಾ ಆಂಬೊಟ್ ನಸಲ್ಲಿ ಭಾಕ್ರಿಯಾ ಕರುನ್ ಭಾಜ್ಲ್ಯಾನಿ, ತೆನಿ ಇಜಿಪ್ತಾಕ್ನಾ ಯೆತಾನಾ ಯೆಲ್ಲೊಬಿ ಎಳ್ ಗಾವ್ಕ್ ನಸಲ್ಯಾ ಸಾಟ್ನಿ ಪಿಟ್ಟಾತ್ ಆಂಬೊಟ್ ಮಿಳ್ವುಕ್ ಹೊವ್ಕ್ ನಾ, ಅನಿ ದುಸ್ರೆ ರಾಂದಾಪ್ ಕರುಕ್ಬಿ ಹೊವ್ಕ್ ನಾ. <verse eid="EXO 12:39" /><verse number="40" style="v" sid="EXO 12:40" />ಇಜ್ರಾಯೆಲಾಚಿ ಲೊಕಾ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ಚಾರ್ಸೆ ತಿಸ್ ವರ್ಸಾ ಹೊತ್ತಿ. <verse eid="EXO 12:40" /><verse number="41" style="v" sid="EXO 12:41" />ಹಿ ಚಾರ್ಸೆ ತಿಸ್ ವರ್ಸಾ ಕಳ್ದಲ್ಲ್ಯಾ ಮಾನಾ ತ್ಯಾ ದಿಸಿ ಸರ್ವೆಸ್ಪರಾಚಿ ಲೊಕಾ ಅನಿ ಸಗ್ಳ್ಯಾ ಕುಳಿಚಿ ಲೊಕಾ ಇಜಿಪ್ತ್ ದೆಶ್ ಸೊಡುನ್ ಯೆಲ್ಯಾನಿ. <verse eid="EXO 12:41" /><verse number="42" style="v" sid="EXO 12:42" />ಸರ್ವೆಸ್ಪರಾನ್ ಇಜಿಪ್ತ್ ದೆಸಾಕ್ನಾ ತೆಂಕಾ ಬಾರ್ಯ್ ಹಾನಲ್ಲೆ ತ್ಯಾಚ್ ದಿಸಿ, ತಸೆ ಹೊವ್ನ್ ತೆನಿ ತ್ಯಾ ದಿಸಿಚ್ ಸದಾಸರ್ವತಾಕ್ ತೆಕಾ ಮಾನ್ ದಿವ್ಕ್ ಸಾಟ್ನಿ ರಾತ್ತಿನ್ ಜಾಗೆ ರಾವ್ನ್ ಸನ್ ಕರುಚೆ.<verse eid="EXO 12:42" /></para>
  <para style="s">ಪಾತ್ಕಾಚ್ಯಾ ಸನಾಚಿ ನೆಮಾ</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಅನಿ ಆರೊನಾಕ್ ಅಸೆ ಮಟ್ಲ್ಯಾನ್, ಪಾತ್ಕಾಚೊ ಸನ್ ಕರ್ತಲೊ ನೆಮ್ ಹ್ಯೊ, ದುಸ್ರ್ಯಾ ದೆಶ್ಯಾಚೊ ಕೊನ್ಬಿ ಹ್ಯಾ ಜೆವ್ನಾತ್ ವಾಟೊ ಘೆವ್ಚೆ ನ್ಹಯ್ . <verse eid="EXO 12:43" /><verse number="44" style="v" sid="EXO 12:44" />ಖರೆ ತುಮಿ ಖರಿದಿಕ್ ಘೆಟಲ್ಲೊ ಆಳ್ ಹೊಲ್ಯಾರ್, ತೆನಿ ಸುನ್ನತ್ ಕರ್ಸುನ್ಗೆಟಲ್ಲೆ ರಾಲ್ಯಾರ್, ತೊ ತ್ಯಾ ಜೆವ್ನಾಕ್ ವಾಟೊ ಘೆವ್ಕ್ ಹೊತಾ. <verse eid="EXO 12:44" /><verse number="45" style="v" sid="EXO 12:45" />ಉಲ್ಲ್ಯಾ ದಿಸಾಕ್ನಿ ಮನುನ್ ಯೆವ್ನ್ ಹೊತ್ತೊ ನಾತರ್ ದಿಸಾಚ್ಯಾ ಮಜುರಿಚ್ಯಾ ಕಾಮಾಚೊ ಆಳ್ ಹ್ಯಾತುರ್ ವಾಟೊ ಘೆವ್ಚೊ ನ್ಹಯ್ . <verse eid="EXO 12:45" /><verse number="46" style="v" sid="EXO 12:46" />ರಾಂದಾಪ್ ಕರಲ್ಲ್ಯಾ ಘರಾತುಚ್ ತೆ ಜೆವಾನ್ ಕರುಚೆ, ತ್ಯಾತುರ್ ಉಲ್ಲೆಬಿ ಭಾಯ್ರ್ ಘೆವ್ನ್ ಜಾವ್ಚೆ ನ್ಹಯ್ ಬಲಿ ದಿಲ್ಲ್ಯಾ ಜನಾವರಾಚೆ ಎಕ್ಬಿ ಹಡ್ಡ್ ಮೊಡುಚೆ ನ್ಹಯ್ . <verse eid="EXO 12:46" /><verse number="47" style="v" sid="EXO 12:47" />ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾನಿ ಹ್ಯೊ ಸನ್ ಕರುಚೆ. <verse eid="EXO 12:47" /><verse number="48" style="v" sid="EXO 12:48" />ತುಮ್ಚ್ಯಾಕ್ಡೆ ಹೊತ್ತ್ಯಾ ದುಸ್ರ್ಯಾ ದೆಶಾಚೆ ಕೊನಿಬಿ ಹ್ಯೊ ಪಾತ್ಕಾಚೊ ಸನ್ ಕರುಚೆ ಮನ್ತಲಿ ಆಶ್ಯಾ ರಾಲ್ಯಾರ್, ತೊ ಅನಿ ತೆಚ್ಯಾ ಘರಾತ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಘವ್ಮಾನ್ಸಾನಿ ಸುನ್ನತ್ ಕರುನ್ ಘೆವ್ಕ್ ತೆಚ್ಯಾ ಮಾನಾ ಯೆವ್ನ್ ಹ್ಯೊ ಸನ್ ಕರುಚೆ, ತಸ್ಲೊ ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಶಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಸಾರ್ಕೊ ಹೊತಾ. ಖರೆ ಸುನ್ನತ್ ಕರ್ಸುನ್ ಘೆವ್ಕ್ ನಸಲ್ಲೊ ಕೊನ್ಬಿ ಹ್ಯಾ ಜೆವ್ನಾತ್ ಭಾಗಿ ಹೊವ್ಚೆ ನ್ಹಯ್ . <verse eid="EXO 12:48" /><verse number="49" style="v" sid="EXO 12:49" />ಇಜ್ರಾಯೆಲಾಕ್ನಿ, ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಶ್ಯಾಚ್ಯಾಕ್ ಅನಿ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊತ್ತ್ಯಾ ದುಸ್ರಾ ದೆಶಾಚ್ಯಾಕ್ನಿ ಬಿ ಲಾಗು ಹೊತಲೊ ನೆಮ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 12:49" /><verse number="50" style="v" sid="EXO 12:50" />ಮೊಯ್ಜೆಕ್ ಅನಿ ಆರೊನಾಕ್ ಸರ್ವೆಸ್ಪರಾನ್ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಸಗ್ಳ್ಯಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 12:50" /><verse number="51" style="v" sid="EXO 12:51" />ತ್ಯಾ ದಿಸಾ ಸರ್ವೆಸ್ಪರಾನ್ ಇಜ್ರಾಯೆಲ್ ಕುಳಿಚ್ಯಾ ಲೊಕಾಕ್ನಿ ತಾಂಡೊ ತಾಂಡೊ ಹೊವ್ನ್ ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಕ್ನಾ ಭಾಯ್ರ್ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್.<verse eid="EXO 12:51" /></para>
  <chapter eid="EXO 12" />
  <chapter number="13" style="c" sid="EXO 13" />
  <para style="s">ಥೊರ್ಲಿ ಪೊರಾ ಭೆಟ್ವುತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, <verse eid="EXO 13:1" /><verse number="2" style="v" sid="EXO 13:2" />“ಥೊರ್ಲೆ ಹೊವ್ನ್ ಉಪಾಜಲ್ಲೆ ಗಂಡ್ ಸಗ್ಳೆಬಿ ಮಾಕಾ ಎಚುನ್ ಕಾಡುನ್ ಥವಲ್ಲೆ ಹೊವ್ಚೆ; ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಮಾನ್ಸಾತ್ನಿ ಹೊಂವ್ದಿತ್, ನಾತರ್ ಜನಾವರಾತ್ನಿ ಹೊಂವ್ದಿತ್ ಪೈಲೆ ಉಪಾಜಲ್ಲೆ ಮಾಜೆಚ್ ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="EXO 13:2" /></para>
  <para style="s">ಫುಗ್ ನಸಲ್ಲ್ಯಾ ಬಾರಿಕ್ಲಿಯಾಂಚೊ ಸನ್</para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3" />ಮೊಯ್ಜೆನ್ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಲೊಕಾಕ್ನಿ, ಗುಲಾಮ್ ಗಿರಿತ್ ರಾವ್ನ್ ಇಜಿಪ್ತ್ ದೆಸಾಕ್ನಾ ಸುಟ್ಕಾ ಹೊಲ್ಲೊ ಹ್ಯೊ ದಿಸ್ ತುಮಿ ಯಾದ್ ಥವ್ನ್ ಘೆವ್ಚೆ, ತುಮ್ಚ್ಯಾ ಸರ್ವೆಸ್ಪರಾನ್ ಅಪ್ಲೊ ಬಳ್ ವಾಪ್ರುನ್ ಸುಟ್ಕಾ ಕರ್ಲ್ಯಾನ್, ಹ್ಯಾ ದಿಸಾತ್ ತುಮಿ ಆಂಬೊಟ್ ಮಿಸಳ್ ಕರಲ್ಲೆ ಕಾಯ್ಬಿ ಖಾವ್ಚೆ ನ್ಹಯ್ . <verse eid="EXO 13:3" /><verse number="4" style="v" sid="EXO 13:4" />ಚೈತ್ರ್ ಮಾಸ್ ಮೈನ್ಯಾಚ್ಯಾ ದಿಸಿ ತುಮಿ ಯೆಲ್ಲ್ಯಾಸಿ. <verse eid="EXO 13:4" /><verse number="5" style="v" sid="EXO 13:5" />ಸರ್ವೆಸ್ಪರಾನ್ ತುಮ್ಚ್ಯಾ ಪುರ್ವಜಾಕ್ನಿ ಗೊಸ್ಟ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತುಮ್ಕಾ ದುದ್ದ್ ಅನಿ ಮ್ಹಾಂವ್ ಹೊಂವ್ತಲ್ಯಾ ಗಾಂವಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಕಾನಾನಾಚೆ ಅನಿ ಹಿತ್ತಿಯಾಂಚಿ, ಅಮೊರಿಯಾಂಚೆ, ಅನಿ ಹಿವ್ವಿಯಾಂಚಿ, ಜೆಬುಸಿಯಾಂಚಿ ಲೊಕಾ ವಸ್ತಿ ಕರ್‍ತಲ್ಯಾ ಗಾಂವಾಕ್ ಬಲ್ವುನ್ ಹಾನುನ್ ತೆ ತುಮ್ಕಾ ದಿಲ್ಲ್ಯಾ ತನ್ನಾ, ತುಮಿ ಹ್ಯಾ ಮೈನ್ಯಾತ್ ಹ್ಯೊ ಸನ್ ಕರುಚೆ. <verse eid="EXO 13:5" /><verse number="6" style="v" sid="EXO 13:6" />ಸಾತ್ ದಿಸಾಚ್ಯಾ ಪತರ್ ತುಮಿ ಫುಗ್ ನಸಲ್ಲಿ ಭಾಕ್ರಿಯಾ ಖಾವ್ಚೆ, ಸಾತ್ವ್ಯಾ ದಿಸಾ ದಿಸಿ ಸರ್ವೆಸ್ಪರಾಕ್ ಮಾನ್ ದಿತಲ್ಯಾ ಸಾಟ್ನಿ ಸನ್ ಕರುಚೆ. <verse eid="EXO 13:6" /><verse number="7" style="v" sid="EXO 13:7" />ತ್ಯಾ ದಿಸಾತ್ನಿಬಿ ಫುಗ್ ನಸಲ್ಲಿ ಭಾಕ್ರಿಯಾ ಖಾವ್ಚೆ, ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ತುಮ್ಚ್ಯಾಕ್ಡೆ ನಾತರ್ ತುಮ್ಚ್ಯಾ ಗಾಂವಾತ್ ಆಂಬೊಟ್ ಹೊಂವ್ದಿ ನಾತರ್ ಆಂಬೊಟ್ ಪಿಟ್ ಹೊಂವ್ದಿ ರಾವ್ಚೆ ನ್ಹಯ್. <verse eid="EXO 13:7" /><verse number="8" style="v" sid="EXO 13:8" />ತ್ಯಾ ದಿಸಿ ತುಮಿ ತುಮ್ಚ್ಯಾ ಪೊರಾಕ್ನಿ, “ಅಮ್ಚಿ ಲೊಕಾ ಇಜಿಪ್ತ್ ದೆಸಾಕ್ನಾ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ, ಸರ್ವೆಸ್ಪರಾನ್ ತುಮ್ಚ್ಯಾ ಸಾಟ್ನಿ ಕರಲ್ಲೊ ಉಪ್ಕಾರ್ ಯಾದೆಕ್ ಹಾನುನ್ ಘೆವ್ಕ್ ಸಾಟ್ನಿ ಹ್ಯೊ ಸನ್ ಕರುಲಾಂವ್” ಮನುನ್ ಸಾಂಗುಚೆ. <verse eid="EXO 13:8" /><verse number="9" style="v" sid="EXO 13:9" />ಸರ್ವೆಸ್ಪರಾನ್ ಅಪ್ಲೊ ಬಳ್ ದಾಕ್ವುನ್ ಅಮ್ಕಾ ಇಜಿಪ್ತಾತ್ನಾ ಸುಟ್ಕಾ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ತೆಜೊ ನೆಮ್ ಅಮ್ಚ್ಯಾ ತೊಂಡಾತ್ ಸಾಂಗಿತ್ ರಾವ್ಚೆ, ತಸೆ ಹೊವ್ನ್ ಹ್ಯೊ ಸನ್ ಅಮ್ಚಾ ಹಾತಿಕ್ ಬಾಂದಲ್ಯಾ ಕಂಕನಾ ಸಾರ್ಕೆ ಅನಿ ಹುಬ್ಬಾಂಚ್ಯಾ ಮದ್ದಿ ಕಪ್ಳಾಕ್ ಭಾಂದಲ್ಲ್ಯಾ ಯಾದೆಚ್ಯಾ ಪಟ್ಟಿ ಸಾರ್ಕೆ ರ್‍ಹಾತಾ. <verse eid="EXO 13:9" /><verse number="10" style="v" sid="EXO 13:10" />ಸೆ ರ್‍ಹಾತಾನಾ, ಹರ್ ಎಕ್ ವರ್ಸಾಬಿ ಚುಕಿನಸ್ತಾನಾ ಸಮಾ ಎಳಾರ್ ಹ್ಯೊ ಸನ್ ಕರುಚೆ.<verse eid="EXO 13:10" /></para>
  <para style="s">ಪೈಲೆ ಉಪಾಜಲ್ಲೆ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11" />“ಸರ್ವೆಸ್ಪರಾನ್ ತುಮ್ಕಾ ಅನಿ ತುಮ್ಚ್ಯಾ ಪುರ್ವಾಜಾಕ್ನಿ ಗೊಸ್ಟ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತುಮ್ಕಾ ಕಾನಾನಾಚ್ಯಾ ದೆಸಾಕ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರುನ್ ತೆ ತುಮ್ಕಾ ದಿತಾ, <verse eid="EXO 13:11" /><verse number="12" style="v" sid="EXO 13:12" />ತಿಯಾ ಪೈಲೆ ಉಪಾಜಲ್ಲ್ಯಾ ಝಿಲ್ಗ್ಯಾಕ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಭೆಟ್ವುಚೆ, ಅನಿ ಜನಾವರಾಂಚ್ಯಾ ಪೈಲೆ ಉಪಾಜಲ್ಲ್ಯಾ ಗಂಡ್ ಪೆಟ್ಯಾಕ್ನಿಬಿ ಸರ್ವೆಸ್ಪರಾಕ್ ಭೆಟ್ವುಚೆ. <verse eid="EXO 13:12" /><verse number="13" style="v" sid="EXO 13:13" />ಖರೆ ಗಾಡ್ವಾಚ್ಯಾ ಪೈಲೆಚ್ಯಾ ಪೆಟ್ಯಾಚ್ಯಾ ಬದ್ಲಾಕ್ ಬೊಕ್ಡ್ಯಾಚೊ ಪೆಟೊ ದಿವ್ನ್ ತ್ಯಾ ಗಾಡ್ವ್ಯಾಚ್ಯಾ ಪೆಟ್ಯಾಕ್ ಸೊಡ್ಸುನ್ ಘೆವ್ಚೆ; ತಸೆ ಸೊಡ್ಸುನ್ ಘೆವ್ಕ್ ಹೊಯ್ ನಸ್ಲ್ಯಾರ್ ತೆಜೊ ಗಳೊ ಮೊಡುನ್ ಜಿವ್ ಕಾಡುಚೆ, ನಾತರ್ ಮಾನ್ಸಾಚೊ ಪೈಲೆಚೊ ಪೊರ್ ತರಿಬಿ ದಿವ್ನ್ ತೆಕಾ ಸೊಡ್ಸುನ್ ಘೆವ್ಚೆ. <verse eid="EXO 13:13" /><verse number="14" style="v" sid="EXO 13:14" />ಹೆಚ್ಯಾ ಮಾನಾ ತುಮ್ಚ್ಯಾ ಪೊರಾನಿ ಹೆಚೊ ಅರ್ಥ್ ಕಾಯ್? ಮನುನ್ ಇಚಾರ್‍ತಾನಾ, ತುಮಿ ತೆಂಕಾ ಗುಲಾಮ್ ಗಿರಿತ್ ರ್‍ಹಾತಾನಾ ಸೆರ್ವೆಶ್ವರಾನ್ ಅಪ್ಲೊ ಮೊಟೊ ಬಳ್ ದಾಕ್ವುನ್ ಇಜಿಪ್ತಾಕ್ನಾ ಅಮ್ಕಾ ಸೊಡ್ಸುಲಾ. <verse eid="EXO 13:14" /><verse number="15" style="v" sid="EXO 13:15" />ಫಾರೊವ್ ರಾಜಾನ್ ಹಟ್ಟ್ ಧರುನ್ ಅಮ್ಕಾ ಜಾವ್ಕ್ ದಿವ್ಕ್ ನಾ ಹೊಲ್ಲ್ಯಾ ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಇಜಿಪ್ತಾತ್ ಪೈಲೆಚ್ಯಾ ಪೊರಾಕ್ನಿ ಜನಾವರಾಂಚ್ಯಾ ಪೈಲೆಚ್ಯಾ ಪೆಟ್ಯಾಕ್ನಿ ಒಟ್ಟು ತ್ಯಾ ದೆಸಾತ್ ಪೈಲೆ ಉಪಾಜ್ತಲ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಜಿವಾನಿ ಮರ್ಲ್ಯಾನ್. ತಸೆ ಹೊವ್ನ್ ಗಂಡ್ ಹೊವ್ನ್ ಉಪಾಜ್ತಲೆ ಪೈಲೆಚೆ ಫಳ್ ಅಮ್ಚ್ಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಭೆಟ್ವುತಾಂವ್, ಮಾನ್ಸಾಚೆ ಪೈಲೆಚೆ ಫಳ್ ತರಿಬಿ ಬದ್ಲಾಕ್ ದಿವ್ನ್ ಸೊಡ್ಸುನ್ ಘೆತಾಂವ್ ” ಮನುನ್ ಸಾಂಗುಚೆ. <verse eid="EXO 13:15" /><verse number="16" style="v" sid="EXO 13:16" />ಸರ್ವೆಸ್ಪರಾನ್ ಅಪ್ನಾಚಿ ಮೊಟಿ ಬಳ್ ದಾಕ್ವುನ್ ಅಮ್ಕಾ ಇಜಿಪ್ತಾತ್ನಾ ಸೊಡಸ್ಲ್ಯಾಲ್ಯಾನ್, ಹಿ ಖಬರ್ ಅಮಿ ಯಾದೆಕ್ ಥವ್ನ್ ಘೆವ್ಚೆ, ಹೆಕಾ ಹಿ ಪದ್ದತ್ ತುಮ್ಚ್ಯಾ ಹಾತಿತ್ ಭಾಂಧಲ್ಲ್ಯಾ ಕಂಕನಾ ಸಾರ್ಕೆ ರ್‍ಹಾತಾ. ಕಪ್ಳಾಕ್ ಭಾಂದಲ್ಲ್ಯಾ ಪಟ್ಟಿಚ್ಯಾ ಸಾರ್ಕೆ ರ್‍ಹಾತಾ.<verse eid="EXO 13:16" /></para>
  <para style="s">ಮೊಡಾಚೊ ಖಾಂಬೊ ಅನಿ ಆಗಿಚೊ ಖಾಂಬೊ</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17" />ಫಾರೊವ್ ರಾಜಾನ್ ಲೊಕಾಕ್ನಿ ಧಾಡುನ್ ದಿಲ್ಲ್ಯಾ ತನ್ನಾ ಪಿಲಿಸ್ಟಿಯಾಂಚ್ಯಾ ದೆಶ್ಯಾಚಿ ವಾಟ್ ಜಗ್ಗೊಳ್ ರಾಲ್ಯಾರ್ಬಿ ದೆವಾನ್ ತೆಂಕಾ ತಸೊ ಚಾಲ್ವುಕ್ ನಾ; ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತಿ ಲೊಕಾ ಝಗ್ಡೊ ಬಗುನ್ ಮನ್ ಬದ್ಲುನ್ ಘೆವ್ನ್ ಇಜಿಪ್ತಾಕ್ ಪಾಟಿ ಪರ್‍ತುನ್ ಜಾಯ್ಲ್ ಮನುನ್ ಘೆಟ್ಲ್ಯಾನ್. <verse eid="EXO 13:17" /><verse number="18" style="v" sid="EXO 13:18" />ಅಸೆ ಹೊವ್ನ್ ಸರ್ವೆಸ್ಪರಾನ್ ತೆಂಕಾ ತಾಂಬ್ಡ್ಯಾ ಸಮುಂದರಾಚ್ಯಾ ಡಂಗ್ಳಿಚ್ಯಾ ವಾಟೆನ್ ಫಿರುನ್ಗೆತ್ ಜಾಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್, ಹೊಲ್ಯಾರ್ಬಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಝಗ್ಡುಕ್ ತಯಾರಿ ಕರುನ್ ಘೆವ್ನ್ ಇಜಿಪ್ತ್ ದೆಸಾಕ್ನಾ ಗೆಲ್ಯಾನಿ. <verse eid="EXO 13:18" /><verse number="19" style="v" sid="EXO 13:19" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಅಪ್ನಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಜುಜೆಚಿ ಹಡ್ಡಾ ಘೆವ್ನ್ ಗೆಲ್ಲ್ಯಾನ್, ತೆನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ದೆವ್ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾತಾ. ದರ್ಶನ್ ಕರ್ತಾ, ತನ್ನಾ ಮಾಜಿ ಹಡ್ಡಾ ಹಿತ್ನಾ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಘೆವ್ನ್ ಜಾವ್ಚೆ ಮನುನ್, ಘಟ್ ಆನ್ ಕರ್ಸುನ್ ಘೆಟ್ಲ್ಯಾನ್.<verse eid="EXO 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 13:20" />ಅಸೆ ತೆನಿ ಸುಕ್ಕೊತಿಕ್ನಾ ಪರ್ಯಾನ್ ಕರುನ್ ಎತಾಮಿಚ್ಯಾ ಡಂಗ್ಳಿಚ್ಯಾ ಜಗ್ಗೊಳ್ಲ್ಯಾ ಜಾಗ್ಯಾರ್ ರಾಲ್ಯಾನಿ. <verse eid="EXO 13:20" /><verse number="21" style="v" sid="EXO 13:21" />ಯೆವ್ಡೆಚ್ ನಸ್ತಾನಾ ತೆನಿ ರ್‍ಹಾತ್ ಅನಿ ದಿಸ್ ಚಲುನ್ ಜಾವ್ಕ್ ಹೊಯ್ ಸಾರ್ಕೆ, ದೆವಾನ್ ತೆಂಕಾ ದಿಸಾನಿ ವಾಟ್ ದಾಕ್ವುಕ್ ಮೊಡಾಚೊ ಖಾಂಬೊ, ಅನಿ ರಾಚ್ಚೆನ್ ತೆಂಕಾ ಉಜ್ವೊಡ್ ದಿವ್ಕ್ ಆಗಿಚೊ ಖಾಂಬೊ ತೆಂಚ್ಯಾ ಫಿಡೆ ಥವ್ಲ್ಯಾನ್. <verse eid="EXO 13:21" /><verse number="22" style="v" sid="EXO 13:22" />ತೆನಿ ದಿಸಾನ್ ಮೊಡಾಚೊ ಖಾಂಬೊ ಅನಿ ರಾಚ್ಚೆನ್ ಆಗಿಚೊ ಖಾಂಬೊ ಲೊಕಾಂಚ್ಯಾ ಇದ್ರಾಕ್ನಾ ಕಾಡುಕುಚ್ ನಾ.<verse eid="EXO 13:22" /></para>
  <chapter eid="EXO 13" />
  <chapter number="14" style="c" sid="EXO 14" />
  <para style="s">ತಾಂಬ್ಡೆ ಸಮುಂದರ್ ದಾಟ್ತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 14:1" />ದೆವಾನ್ ಮೊಯ್ಜೆ ವಾಂಗ್ಡಾ ಬೊಲುನ್, <verse eid="EXO 14:1" /><verse number="2" style="v" sid="EXO 14:2" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಪಿಹಹಿರೊತಿಕ್ ಇದ್ರಾಕ್ ಹೊವ್ನ್ ಮಿಗ್ದೊಲಿಕ್ ಅನಿ ಸಮುಂದರಾಕ್ ಮದ್ದಿ ಬಾಳ್ಚೆಪೊನಿಚ್ಯಾ ಇದ್ರಾಕ್ ವಸ್ತಿ ರಾವ್ಚೆ ಮನುನ್ ತೆಂಕಾ ಸಾಂಗ್, ತೆಕಾ ಇದ್ರಾಕ್ ತುಮಿ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆರ್ ವಸ್ತಿ ರಾವ್ಚೆ. <verse eid="EXO 14:2" /><verse number="3" style="v" sid="EXO 14:3" />ಫಾರೊವ್ ರಾಜಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ವಿಶಯಾತ್ ತೆನಿ ದೆಸಾತ್ ಗಾವ್ನ್ ಪಡ್ಲೆ, ಡಂಗ್ಳಿನ್ ತೆಂಕಾ ಬುತ್ತುರ್ ಧಾಪುನ್ ಥವ್ಲಿನ್ ಮನುನ್ ಸಾಂಗ್ತಾ. <verse eid="EXO 14:3" /><verse number="4" style="v" sid="EXO 14:4" />ಎವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಫಾರೊವಾನ್ ತೆಂಕಾ ಫಾಟ್ ಲಾಗಿ ಸಾರ್ಕೆ ಮಿಯಾ ತೆಜೊ ಮನ್ ಮಂಡ್ ಕರ್ತಾ; ಫಾರೊವಾಕ್ನಾ ಅನಿ ತೆಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಸೈನ್ಯಾಕ್ನಾ ಮಿಯಾ ಮಾಕಾ ಹೊಗ್ಳಾಪ್ ಘೆತಾ; ತನ್ನಾ ಮಿಯಾಚ್ ದೆವ್ ಮನುನ್ ಇಜಿಪ್ತಾಚಿ ಲೊಕಾ ಕಳ್ವುನ್ ಘೆತಾತ್ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್, ತೆನಿಬಿ ತಸೆಚ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 14:4" /><verse number="5" style="v" sid="EXO 14:5" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಪಳುನ್ ಗೆಲಿ ಮನುನ್ ಇಜಿಪ್ತಾಚ್ಯಾ ರಾಜಾಕ್ ಕಳ್ವುನ್ ಯೆಲೆ; ತನ್ನಾ ಫಾರೊವಾಚೊ ಅನಿ ತೆಚ್ಯಾ ಅಧಿಕಾರಿಯಾಂಚೊ ಮನ್ ಲೊಕಾಕ್ನಿ ವಿರೊಧ್ ಹೊವ್ನ್ ಫಿರ್ಲೊ; ತೆನಿ, “ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಅಪ್ನಿ ಸೆವಾ ಕರ್‍ತಲೆ ಸೊಡುನ್ ಜಾವ್ಕ್ ಕಶ್ಯಾಕ್ ಸೊಡ್ಲಾಂವ್?” ಮಟ್ಲ್ಯಾನಿ. <verse eid="EXO 14:5" /><verse number="6" style="v" sid="EXO 14:6" />ತನ್ನಾ ತೊ ಅಪ್ಲಿ ಘೊಡ್ಕಿಯಾಂಚಿ ಗಾಡಿ ತಯಾರ್ ಕರುನ್ ಘೆವ್ನ್, ಅಪ್ನಾಚ್ಯಾ ಸೈನಿಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಜಾವ್ಕ್ ಲಾಲೊ. <verse eid="EXO 14:6" /><verse number="7" style="v" sid="EXO 14:7" />ಯೆವ್ಡೆಚ್ ನಸ್ತಾನಾ, ತೆನಿ ಸಾ ಸೆಂಬರ್ ಘೊಡ್ಕಿಯಾಂಚಿ ಗಾಡಿಯಾ ಎಚುನ್ ಘೆಟ್ಲ್ಯಾನಿ, ಇಜಿಪ್ತಾಂಚಿ ಘೊಡ್ಕಿಯಾಂಚಿ ಗಾಡಿಯಾ ಅನಿ ತೆಂಕಾ ಚಾಲ್ವುತಲ್ಯಾಕ್ನಿ ಘೆವ್ನ್ ಗೆಲ್ಯಾನ್, ತೆನಿ ಸಗ್ಳಿ ಅಧಿಕಾರಿಯಾ ಹೊಲ್ಲೆ. <verse eid="EXO 14:7" /><verse number="8" style="v" sid="EXO 14:8" />ದೆವಾನ್ ಇಜಿಪ್ತಾಚೊ ರಾಜಾ ಫಾರೊವಾಚೊ ಮನ್ ಮಂಡ್ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ಅನಿ ತೆನಿ ಜಿಕುನ್ ಜಾವ್ಕ್ ಲಾಗಲ್ಲ್ಯಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಫಾಟ್ ಲಾಗ್ಲ್ಯಾನ್. <verse eid="EXO 14:8" /><verse number="9" style="v" sid="EXO 14:9" />ಇಜಿಪ್ತಾಚ್ಯಾ ಫಾರೊವಾಚಿ ಸಗ್ಳಿ ಘೊಡ್ಕಿಯಾ, ಘೊಡ್ಕಿಯಾಂಚಿ ಗಾಡಿಯಾ ಅನಿ ಚಾಲ್ವುತಲೆ ತೆಚೊ ಸೈನ್ ಪಿಹರೊತಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ಹೊತ್ತ್ಯಾ ಬಾಳ್ಚೆಪೊನಿಚ್ಯಾ ಇದ್ರಾಕ್ ಲೊಕಾನಿ ತೆನಿ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆಕ್ ವಸ್ತಿ ಹೊತ್ತ್ಯಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 14:9" /><verse number="10" style="v" sid="EXO 14:10" />ಫಾರೊವ್ ಜಗ್ಗೊಳ್ ಯೆಯ್ತ್ ರ್‍ಹಾತಾನಾ, ಅಬಕ್! ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ನದರ್ ವರ್‍ತಿ ಕರುನ್ ಫಾಟ್ನಾ ಯೆವ್ ಲಾಗಲ್ಲ್ಯಾ ಇಜಿಪ್ತ್ ಕಾರಾಕ್ನಿ ಬಗುನ್ ಲೈ ಬ್ಹಿಂವ್ನ್ ಮಜತ್ತಿಕ್ ಸಾಟ್ನಿ ದೆವಾಕ್ಡೆ ರಡುನ್ ಮಾಗ್ನಿ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 14:10" /><verse number="11" style="v" sid="EXO 14:11" />ತೆನಿ ಮೊಯ್ಜೆಕ್ ಇಜಿಪ್ತಾತ್ ಮಸನ್ಗಿಯಾ ನಸಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಅಮ್ಕಾ ಡಂಗ್ಳಿತ್ ಮರಿ ಸಾರ್ಕೆ ಬಲ್ವುನ್ ಹಾನ್ಲೈ ಕಾಯ್? ತಿಯಾ ಅಸೆ ಕರುನ್ ಕಶ್ಯಾಕ್ ಅಮ್ಕಾ ಇಜಿಪ್ತಾಕ್ನಾ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಯೆಲೈ? <verse eid="EXO 14:11" /><verse number="12" style="v" sid="EXO 14:12" />ಅಮಿ ಇಜಿಪ್ತ್ ದೆಸಾತ್ ರ್‍ಹಾತಾನಾಚ್ ಥೈ ಅಮ್ಚ್ಯಾ ಖಬ್ರಿಕ್ ಯೆವ್ಕ್ ನಕ್ಕೊ; ಅಮಿ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಂಚಿ ಸೆವಾ ಕರ್ತಾಂವ್ ಮನಲ್ಲ್ಯಾಂವ್, ಅಮಿ ಡಂಗ್ಳಿತ್ ಮರ್ತಲ್ಯಾಕಿಂತಾ ಇಜಿಪ್ತ್ ಕಾರಾಕ್ನಿ ಸೆವಾ ಕರ್‍ತಲೆಚ್ ಬರೆ ಮನಲ್ಲ್ಯಾಂವ್, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನಿ. <verse eid="EXO 14:12" /><verse number="13" style="v" sid="EXO 14:13" />ಖರೆ ಮೊಯ್ಜೆನ್ ಲೊಕಾಕ್ನಿ, ತುಮಿ ಭಿಂವ್ ನಕಾಸಿ; ಸರ್ವೆಸ್ಪರ್ ತುಮ್ಕಾ ರಾಕ್ತಲೆ ಬಗಾ, ತುಮಿ ಅತ್ತಾ ಬಗ್ತಲ್ಯಾ ಇಜಿಪ್ತಾಕ್ನಿ ಅನಿ ಕನ್ನಾ ಕನ್ನಾ ಬಗಿನ್ಯಾಸಿ. <verse eid="EXO 14:13" /><verse number="14" style="v" sid="EXO 14:14" />ದೆವ್ ತುಮ್ಚ್ಯಾ ಸಾಟ್ನಿ ಝಗ್ಡೊ ಕರ್ತಾ; ಖರೆ ತುಮಿ ಗಪ್ ರಾವಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 14:14" /><verse number="15" style="v" sid="EXO 14:15" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, ತಿಯಾ ಮಾಜೆಕ್ಡೆ ಕಶ್ಯಾಕ್ ರಡುನ್ ಮಾಗ್ನಿ ಕರ್‍ತೆ? ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಫಿಡೆ ಜಾವ್ಚೆ ಮನುನ್ ಸಾಂಗ್. <verse eid="EXO 14:15" /><verse number="16" style="v" sid="EXO 14:16" />ತಿಯಾ ತುಜೊ ದಾಂಡೊ ಉಕ್ಲುನ್ ಸಮುಂದರಾಕ್ ವಾಟೆ ಕರ್, ತನ್ನಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಸಮುಂದ್ರಾಚ್ಯಾ ವಾಳ್ಕ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಚಲುನ್ ಜಾತಾತ್. <verse eid="EXO 14:16" /><verse number="17" style="v" sid="EXO 14:17" />ಅಬಕ್! ಮಿಯಾ ಇಜಿಪ್ತ್ ಕಾರಾಂಚೊ ಮನ ಮಂಡ್ ಕರ್ತಾ; ತೆನಿ ಹೆಂಕಾ ಫಾಟ್ ಲಾಗ್ತಾತ್, ಯೆವ್ಡೆ ನಸ್ತಾನಾ, ಫಾರೊವ್ ತೆಚೊ ಸಗ್ಳೊ ಸೈನ್ ಅನಿ ತೆಚಿ ಘೊಡ್ಕಿಯಾಂಚಿ ಗಾಡಿಯಾ ಅನಿ ಘೊಡ್ಕಿಯಾ ತೆಂಚಿ ಚಾಲ್ವುತಲಿ ಲೊಕಾ ತೆಂಚ್ಯಾ ಸಗ್ಳ್ಯಾಂಚ್ಯಾ ವೈನಾ ಮಿಯಾ ಹೊಗ್ಳಾಪ್ ಕರುನ್ ಘೆತಾ. <verse eid="EXO 14:17" /><verse number="18" style="v" sid="EXO 14:18" />ಮಿಯಾ, ಫಾರೊವ್ ಅನಿ ತೆಜೊ ಘೊಡ್ಕಿಯಾಂಚೆ ಗಾಡಿಯಾ ಚಾಲ್ವುತಲೆ, ಅನಿ ಘೊಡ್ಕಿಯಾ ಹೆಂಚ್ಯಾ ಸಗ್ಳ್ಯಾಂಚ್ಯಾಕ್ನಾ ಹೊಗ್ಳಾಪ್ ಕರುನ್ ಘೆಟಲ್ಲ್ಯಾ ತನ್ನಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಇಜಿಪ್ತ್ ಕಾರಾಕ್ನಿ ಕಳ್ವುನ್ ಯೆತಾ, ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19" />ತನ್ನಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಚ್ಯಾ ಫಿಡ್ನಾ ಜಾಯ್ತ್ ಹೊತ್ತ್ಯಾ ದೆವ್ ಧುತಾನ್ ಅಪ್ಲೊ ಜಾಗೊ ಸೊಡುನ್, ತೆಂಚ್ಯಾ ಪಾಟಿಕ್ಡೆ ಯೆಲ್ಯಾನ್, ತೆಂಚ್ಯಾ ಫಿಡೆ ಹೊತ್ತ್ಯಾ ಮಳ್ಬಾಚ್ಯಾ ಖಾಂಬ್ಯಾನ್ ಬಿ ಅಪ್ಲೊ ಜಾಗೊ ಸೊಡುನ್ ತೆಂಚ್ಯಾ ಫಾಟಿಕ್ಡೆ ಇಬೆ ರಾಲ್ಯಾನ್. <verse eid="EXO 14:19" /><verse number="20" style="v" sid="EXO 14:20" />ತೆ ಇಜಿಪ್ತಾಚ್ಯಾ ಅನಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಮದ್ದಿ ಯೆಲೆ, ತೆ ತೆಂಕಾ ಮೊಡ್ ಅನಿ ಕಾಳೊಕ್ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ಅನಿ ಇಜ್ರಾಯೆಲಾಕ್ನಿ ರಾಚ್ಚೆನ್ ಉಜ್ವೊಡ್ ದಿತಲೆ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ತ್ಯಾ ರಾತ್ತಿನ್ ಎಕ್ಲ್ಯಾಕ್ ಬಿ ಜಗ್ಗೊಳ್ ಯೆವ್ಕ್ ಹೊವ್ಕ್ ನಾ.<verse eid="EXO 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 14:21" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, ಸಮುಂದ್ರಾಚ್ಯಾ ವರ್‍ತಿ ತೆಚೊ ಹಾತ್ ದಾಕ್ವುತಾನಾ, ದೆವಾನ್ ರಾತ್ತಿನ್ ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ಮೊಟ್ಟ್ಯಾ ವಾರ್‍ಯಾನ್ ಸಮುಂದ್ರಾಕ್ ಪಾಟಿ ಜಾಯ್ ಸಾರ್ಕೆ ಕರುನ್, ತೊ ವಾರೊ ಫುರಾ ರ್‍ಹಾತ್ ಮಾರುನ್ ಸಮುಂದರಾತ್ ವಾಳ್ಕಿ ಜಿಮಿನ್ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್, ತನ್ನಾ ಪಾನಿ ವಾಟೆ ಹೊಲೆ. <verse eid="EXO 14:21" /><verse number="22" style="v" sid="EXO 14:22" />ಅಸೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ವಾಳ್ಕ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಚಲುನ್ ಗೆಲ್ಯಾನಿ, ತೆಂಕಾ ಪಾನಿ ಉಜ್ವ್ಯಾ ಭಾಜುಕ್ ಅನಿ ಧಾವ್ಯಾ ಭಾಜುಕ್ ಭಿತ್ತಿ ಸಾರ್ಕೆ ಇಬೆ ಹೊತ್ತೆ. <verse eid="EXO 14:22" /><verse number="23" style="v" sid="EXO 14:23" />ಇಜಿಪ್ತ್ ಕಾರಾನಿ ಪರೊಹಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಘೊಡ್ಕಿಯಾನಿ ಅನಿ ಘೊಡ್ಕಿಯಾಂಚಿ ಗಾಡಿಯಾ ಚಾಲ್ವುತಲ್ಯಾನಿ ತೆಂಕಾ ಫಾಟ್ ಲಾಗುನ್, ತೆಂಚ್ಯಾ ಫಾಟ್ನಾ ಸಮುಂದ್ರಾಚ್ಯಾ ಮದ್ದಿ ಪಾವ್ಲ್ಯಾನಿ. <verse eid="EXO 14:23" /><verse number="24" style="v" sid="EXO 14:24" />ದಿಸ್ ಉಜ್ವಾಡ್ತಲ್ಯಾ ಎಳಾರ್ ಸರ್ವೆಸ್ಪರಾನ್ ಆಗಿಚೊ ಖಾಂಬೊ ಅನಿ ಮೊಡಾಚೊ ಖಾಂಬೊ ಇಜಿಪ್ತಾಂಚ್ಯಾ ಸೈನ್ಯಾಕ್ಡೆ ದಾಕ್ವುನ್ ತೆಂಕಾ ಕಂಗಾಲ್ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 14:24" /><verse number="25" style="v" sid="EXO 14:25" />ತೆಂಚ್ಯಾ ಘೊಡ್ಕಿಯಾಂಚ್ಯಾ ಗಾಡಿಯಾಂಚಿ ಚಕ್ಕರಾ ಕಾಡುನ್ ಸೊಡಲ್ಯಾ ಸಾಟ್ನಿ ಇಜಿಪ್ತಾಚಿ ಲೊಕಾ ಲೈ ತರಾಸಾನ್ ಜಾಯ್ ಸಾರ್ಕೆ ಹೊಲೆ, ತನ್ನಾ “ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಇದ್ರಾಕ್ನಾ ಪಳುನ್ ಜಾಂವಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ದೆವ್ ಇಜಿಪ್ತ್ ಕಾರಾಕ್ನಿ ವಿರೊಧ್ ಹೊವ್ನ್ ತೆಂಚ್ಯಾ ಸಾಟ್ನಿ ಝಗ್ಡೊ ಕರ್ತಾ” ಮನುನ್ ಘೆಟ್ಲ್ಯಾನಿ. <verse eid="EXO 14:25" /><verse number="26" style="v" sid="EXO 14:26" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ಇಜಿಪ್ತ್ ಕಾರಾಂಚ್ಯಾ ವರ್‍ತಿ ತೆಂಚ್ಯಾ ಘೊಡ್ಕಿಯಾಂಚ್ಯಾ ಗಾಡಿಯಾರ್ನಿ ಅನಿ ತಿ ಚಾಲ್ವುತಲ್ಯಾರ್ನಿ ಪಾನಿ ಪರ್‍ತುನ್ ಯೆಯ್ ಸಾರ್ಕೆ ಸಮುಂದರಾಚ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕಲ್” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 14:26" /><verse number="27" style="v" sid="EXO 14:27" />ತಸೆಚ್ ಮೊಯ್ಜೆನ್ ಸಮುಂದ್ರಾಚ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಉಕಲ್ತಾನಾ, ಸಮುಂದರಾಚೆ ಪಾನಿ ಅದ್ದಿ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆಚ್ ಭರ್ಲೆ, ಇಜಿಪ್ತಾಚಿ ಲೊಕಾ ಸಮುಂದರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಪಳುನ್ ಬುಡುನ್ ಮರ್ಲಿ, ಸರ್ವೆಸ್ಪರಾನ್ ಇಜಿಪ್ತ್ ಕಾರಾಕ್ನಿ ಸಮುಂದ್ರಾಚ್ಯಾ ಮದ್ದಿ ಬುಡ್ವುನ್ ಜಿವ್ ಕಾಡ್ಲ್ಯಾನ್. <verse eid="EXO 14:27" /><verse number="28" style="v" sid="EXO 14:28" />ಪಾನಿ ಪರ್‍ತುನ್ ಯೆವ್ನ್ ಘೊಡ್ಕಿಯಾಂಚಿ ಗಾಡಿಯಾ ಘೊಡ್ಕಿಯಾ ಅನಿ ತಿ ಚಾಲ್ವುತಲೆ ಅನಿ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಸಮುಂದರಾತ್ ಯೆಯ್ತ್ ಹೊತ್ತೆ ಫಾರೊವಾಚೊ ಸಗ್ಳೊ ಸೈನ್ ಎಕ್ಲೊಬಿ ಹುರಿ ನಸ್ತಾನಾ ಬುಡುನ್ ಗೆಲೊ. <verse eid="EXO 14:28" /><verse number="29" style="v" sid="EXO 14:29" />ಖರೆ ಇಜ್ರಾಯೆಲಾಂಚಿ ಲೊಕಾ ಸಮುಂದ್ರಾಚ್ಯಾ ಮದ್ದಿ ವಾಳ್ಕಾ ಜಿಮ್ನಿರ್ ಚಲುನ್ ಗೆಲ್ಯಾನಿ, ಪಾನಿ ತೆಂಚ್ಯಾ ಉಜ್ವ್ಯಾ ಅನಿ ಡಾವ್ಯಾ ಭಾಜುಕ್ನಿ ಭಿತ್ತ್ ಸಾರ್ಕೆ ಇಬೆ ಹೊತ್ತೆ. <verse eid="EXO 14:29" /><verse number="30" style="v" sid="EXO 14:30" />ತ್ಯಾ ದಿಸಿ ಸರ್ವೆಸ್ಪರಾನ್ ಇಜ್ರಾಯೆಲಾಂಕ್ನಿ ಇಜಿಪ್ತ್ ಕಾರಾಂಚ್ಯಾ ಹಾತಿತ್ನಾ ರಾಕ್ವನ್ ಕರ್ಲ್ಯಾನ್, ಇಜ್ರಾಯೆಲಾನಿ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆಕ್ ಇಜಿಪ್ತಾಚಿ ಲೊಕಾ ಮರುನ್ ಪಡಲ್ಲೆ ಬಗಟ್ಲ್ಯಾನಿ. <verse eid="EXO 14:30" /><verse number="31" style="v" sid="EXO 14:31" />ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿ ಸರ್ವೆಸ್ಪರಾನ್ ಕರಲ್ಲೆ ಕಾಮ್ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಲೊಕಾನಿ ಬಗುನ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಬ್ಹಿಂವ್ನ್, ಸರ್ವೆಸ್ಪರ್ ಅನಿ ತೆಜೊ ಸೆವಕ್ ಮೊಯ್ಜೆಚ್ಯಾ ವರ್‍ತಿಬಿ ವಿಶ್ವಾಸ್ ಥವ್ಲ್ಯಾನಿ.<verse eid="EXO 14:31" /></para>
  <chapter eid="EXO 14" />
  <chapter number="15" style="c" sid="EXO 15" />
  <para style="s">ಮೊಯ್ಜೆಚಿ ಗಿತ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಅನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ದೆವಾಕ್ ಹಿ ಗಿತ್ ಗಾವುನ್ ಸಾಂಗಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, “ಮಿಯಾ ದೆವಾಕ್ ಗಾವ್ತಾ;</para>
  <para style="q1" vid="EXO 15:1">ತೊ ಬಳಾನ್ ಜಯ್ ಹೊಲೊ;</para>
  <para style="q2" vid="EXO 15:1">ಘೊಡ್ಕಿಯಾಕ್ನಿ ಅನಿ ತೆಂಕಾ</para>
  <para style="q1" vid="EXO 15:1">ಚಾಲ್ವುತಲ್ಯಾಕ್ನಿ ಸಮುಂದರಾತ್ ಟಾಕ್ಲ್ಯಾನ್.<verse eid="EXO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="EXO 15:2" />ದೆವ್ ಮಾಜೊ ಬಳ್ ಅನಿ ಸ್ತುತಿ ಹೊವ್ನ್ ಹಾಯ್. ತೊ ಮಾಜಿ ರಾಕನ್ ಹೊಲೊ. ತೊ</para>
  <para style="q2" vid="EXO 15:2">ಮಾಜೊ ದೆವ್, ತೆಚ್ಯಾ ಸಾಟ್ನಿ ಮಿಯಾ ಎಕ್ ವಸ್ತಿ ರಾತಲೊ ಜಾಗೊ ತಯಾರ್ ಕರ್ತಾ.</para>
  <para style="q1" vid="EXO 15:2">ತೊ ಮಾಜ್ಯಾ ಬಾಬಾಚೊ ದೆವ್, ಮಿಯಾ ತೆಕಾ ಮಾನ್ ದಿತಾ.<verse eid="EXO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EXO 15:3" />ಸರ್ವೆಸ್ಪರ್ ಯುದ್ದ್ ಕರ್ತಲೊ; ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೆ ತೆಚೆ ನಾವ್”.<verse eid="EXO 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EXO 15:4" />“ತೆನಿ ಫಾರೊವಾಚ್ಯಾ ಘೊಡ್ಕಿಯಾಂಚಿ ಗಾಡಿಯಾ ಅನಿ ತೆಜೊ ಸೈನ್ ಸಮುಂದರಾತ್ ಪಾಡ್ವುಲ್ಲ್ಯಾನ್;</para>
  <para style="q2" vid="EXO 15:4">ಅನಿ ಎಚುನ್ ಘೆಟಲ್ಲೆ ತೆಜ್ಯಾ ಝಗ್ಡ್ಯಾಕ್ ಶ್ರೆಶ್ಟ್ ಹೊತ್ತಿ ಸೈನಿಕಾ ತಾಂಬ್ಡ್ಯಾ ಸಮುಂದರಾತ್ ಬುಡುನ್ ಗೆಲಿ.<verse eid="EXO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EXO 15:5" />ಖೊಲ್ ಸಮುಂದರಾನ್ ತೆಂಕಾ ಧಾಪುನ್ ಘಾಟ್ಲ್ಯಾನ್”,</para>
  <para style="q2" vid="EXO 15:5">ತೆನಿ ಗುಂಡ್ಯಾಚ್ಯಾ ಸಾರ್ಕೆ ಸಮುಂದರಾಚ್ಯಾ ಮುಳಾತ್ ಬುಡುನ್ ಗೆಲೆ.<verse eid="EXO 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EXO 15:6" />“ಎ ಸರ್ವೆಸ್ಪರ್ ದೆವಾ! ತುಜ್ಯಾ ಉಜ್ವ್ಯಾ ಹಾತಿಚೊ ಬಳ್ ಮಹಿಮಾನ್ ಭರಲ್ಲೊ ಹಾಯ್,</para>
  <para style="q2" vid="EXO 15:6">ಎ ಸರ್ವೆಸ್ಪರಾ ತುಜ್ಯಾ ಉಜ್ವ್ಯಾ ಹಾತಿನ್ ವಿರೊಧಿಯಾಕ್ನಿ ಝೆಜ್ರುನ್ ಪುಡ್ ಕರ್ಲ್ಯಾನ್”.<verse eid="EXO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EXO 15:7" />ತುಜ್ಯಾ ಮಹತ್ವಾಚ್ಯಾ ಮೊಟ್ಟ್ಯಾ ಪಾನಾನ್ ತುಕಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಉಟಲ್ಯಾಕ್ನಿ ಪಾಡ್ವುನ್,</para>
  <para style="q1" vid="EXO 15:7">ತುಜ್ಯಾ ರಾಗಾಚ್ಯಾ ಆಗಿನ್ ತೆಂಕಾ ಗವ್ತಾ ಸಾರ್ಕೆ ಜಾಳ್ವುನ್ ಟಾಕ್ಲ್ಯಾ.<verse eid="EXO 15:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="EXO 15:8" />ತುಜ್ಯಾ ನಾಕಾತ್ಲ್ಯಾ ಮೊಟ್ಟ್ಯಾ ವಾರ್ಯಾನ್ ಅನಿ ಉಸ್ಕಾರ್ಯಾನ್ ಪಾನಿ ಗೊಳಾ ಹೊಲೆ ಪ್ರವಾಹ್ ಗೊಳಾ ಹೊವ್ನ್ ಇಬೆರ್‍ಹಾಲೆ;</para>
  <para style="q2" vid="EXO 15:8">ಸಮುದರಾಚ್ಯಾ ಮುಳಾಚಿ ಪಾನಿಯಾಬಿ ಘಟ್ ಹೊಲಿ.<verse eid="EXO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EXO 15:9" />ವಿರೊಧಿಯಾನಿ, ಅಮಿ ತೆಂಕಾ ಫಾಟ್ ಲಾಗುನ್ ಧರುನ್,</para>
  <para style="q1" vid="EXO 15:9">ಕೊಯ್ತೊ ಘೆವ್ನ್ ತಾಕ್ತಿನ್ ತೆಂಕಾ ಮಾರುನ್ ತೆಂಚ್ಯಾಕ್ಡೆ ಹೊತ್ತೆ ಸಗ್ಳೆ ವಾಟುನ್ ಘೆತಾಂವ್ ಮನುನ್ ಬೊಲಿತ್ ಹೊತ್ತೆ.<verse eid="EXO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EXO 15:10" />ಖರೆ ತಿಯಾ ಮೊಟ್ಯಾನ್ ಶ್ವಾಸ್ ಕಾಡಲ್ಲ್ಯಾ ತನ್ನಾ,</para>
  <para style="q2" vid="EXO 15:10">ಸಮುಂದರಾನ್ ತೆಂಕಾ ಧಾಪ್ಲ್ಯಾನ್ ತೆನಿ ಸಿಸಾ ಸಾರ್ಕೆ ಮೊಟ್ಟ್ಯಾ ಸಮುಂದರಾತ್ ಬುಡ್ವುಲ್ಯಾ.<verse eid="EXO 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EXO 15:11" />ಎ ಸರ್ವೆಸ್ಪರಾ, ದೆವಾತ್ನಿ ತುಜ್ಯಾ ಸಾರ್ಕೊ ಕೊನ್ ಹಾಯ್? ತುಜ್ಯಾ ಸಾರ್ಕೊ ನಿತಳ್ ಪಾನಾತ್ ಅನಿ ಆಜಾಪಾಚಿ ಕಾಮಾ ಕರ್ತಲೊ ಕೊನ್?</para>
  <para style="q1" vid="EXO 15:11">ತುಜ್ಯಾ ಸರ್ಕೊ ಚಮತ್ಕಾರಾಚಿ ಅನಿ ಪರಾಕರ್ಮಿಚಿ ಕಾಮಾ ದಾಕ್ವುತಲೊ ಕೊನ್ ಹಾಯ್?<verse eid="EXO 15:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="EXO 15:12" />ತಿಯಾ ತುಜೊ ಉಜ್ವೊ ಹಾತ್ ಉಕಲ್ತಾನಾ ಜಿಮ್ನಿನ್ ವಿರೊದಿಯಾಕ್ನಿ ಗಿಳ್ಳಿನ್.<verse eid="EXO 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EXO 15:13" />ತಿಯಾ ಕರಾರಾನ್ ಸುಟ್ಕಾ ಕರಲ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ ದಯಾನಿ ಚಾಲ್ವುನ್,</para>
  <para style="q2" vid="EXO 15:13">ತೆಂಕಾ ತುಜ್ಯಾ ಬಳಾನಿ ತುಜ್ಯಾ ನಿತಳ್ ಘರಾಕ್ಡೆ ಹಾನ್ಲೆ.<verse eid="EXO 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EXO 15:14" />ದೆಶ್ಯಾತ್ಲಿ ಲೊಕಾ ಸಗ್ಳಿ ಹೆ ಆಯ್ಕುನ್ ಬ್ಹಿಂವ್ತಾತ್,</para>
  <para style="q2" vid="EXO 15:14">ದುಕ್ಕ್ ಮನ್ತಲೆ ಪಿಲಿಸ್ಟಿಯಾತ್ ವಸ್ತಿ ಕರ್‍ತಲ್ಯಾಕ್ನಿ ಧರುನ್ ಘೆತಾ.<verse eid="EXO 15:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="EXO 15:15" />ತನ್ನಾ ಯೆದೊಮಿತ್ಲಿ ಅಧಿಕಾರಿ ಲೊಕಾ ಪಿಶೆ ಸಾರ್ಕೆ ಹೊಲಾತ್;</para>
  <para style="q1" vid="EXO 15:15">ಮೊವಾಬಾತ್ಲಿ ಬಳೆಚಿ ಲೊಕಾ ಬ್ಹಿವ್ನ್ ಕಾಪುಕ್ಲಾಗ್ತಾತ್,</para>
  <para style="q2" vid="EXO 15:15">ಕಾನಾನಾತ್ ವಸ್ತಿ ಕರಲ್ಲೆ ಸಗ್ಳೆ ಧೈರೊ ಕಳ್ದುನ್ ಘೆತಾತ್.<verse eid="EXO 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="EXO 15:16" />ಭಿಂಯಾನ್ ಅನಿ ಗೊಂದಲಾನ್ ತೆಂಕಾ ಧರುನ್ ಘೆಟ್ಲಾ,</para>
  <para style="q2" vid="EXO 15:16">ತುಜ್ಯಾ ಬಳಾನ್ ತೆನಿ ಗುಂಡ್ಯಾ ಸಾರ್ಕೆ ಗಪ್ ಇಬೆ ಹಾತ್,</para>
  <para style="q1" vid="EXO 15:16">ತವ್ಡೆ ಹೊಯ್ ಪತರ್ ದೆವಾ, ತುಜಿ ಲೊಕಾ ಚಲುನ್ ಜಾವ್ನ್ ಅಪ್ಲ್ಯಾ ದೆಶ್ಯಾಕ್ ಪಾವ್ತಾತ್.<verse eid="EXO 15:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="EXO 15:17" />ತಿಯಾ ತೆಂಕಾ ತುಜ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ದೆಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್,</para>
  <para style="q1" vid="EXO 15:17">ಮಡ್ಡಿಚ್ಯಾ ಗಾಂವಾಕ್ ಹಾನುನ್ ಇಬೆ ಕರ್‍ತೆ,</para>
  <para style="q1" vid="EXO 15:17">ಸರ್ವೆಸ್ಪರ್ ದೆವಾ ತಿಯ್ಯಾ ಸ್ವತಾಕ್ ವಸ್ತಿ ರಾವ್ಕ್ ತಯಾರ್ ಕರುನ್ ಘೆಟಲ್ಲೊ ಜಾಗೊ ಅನಿ ದೆವಾ,</para>
  <para style="q2" vid="EXO 15:17">ತಿಯಾ ತಯಾರ್ ಕರುನ್ ಘೆಟಲ್ಲಿ ಪವಿತ್ರ ಗುಡಿ ಹೊತ್ತ್ಯಾ ಕ್ಡೆ ತೆಂಕಾ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತೆ<verse eid="EXO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EXO 15:18" />ಸರ್ವೆಶ್ವರುಚ್ ಸದಾ ಸರ್ವತಾಕ್ ರಾಜ್ವಡ್ಕಿ ಕರ್ತಾ.<verse eid="EXO 15:18" /></para>
  <para style="s">ಮಿರ್ಯಾಮಾಚಿ ಗಿತ್</para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19" />ಫಾರೊವಾಚಿ ಘೊಡ್ಕಿಯಾ, ಘೊಡ್ಕಿಯಾಂಚಿ ಗಾಡಿಯಾ ಅನಿ ತೆ ಚಾಲ್ವುತಲ್ಯಾ ಸಮುಂದರಾತ್ ಗುಸುನ್ ಚಲ್ತಾನಾ, ಸರ್ವೆಸ್ಪರಾನ್ ಸಮುಂದರಾಚೆ ಪಾನಿ ಪರ್‍ತುನ್ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಯೆಯ್ ಸಾರ್ಕೆ ಕರುನ್ ಬುಡ್ವುಲ್ಯಾನ್, ಖರೆ ಇಜ್ರಾಯೆಲಾಚಿ ಲೊಕಾ ಸಮುಂದ್ರಾಚ್ಯಾ ಮದ್ದಿ ವಾಳ್ಕ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಚಲುನ್ ಗೆಲ್ಯಾನಿ. <verse eid="EXO 15:19" /><verse number="20" style="v" sid="EXO 15:20" />ಆರೊನಾಚಿ ಭೆನ್ ಮಿರ್ಯಾಮ್ ಎಕ್ ಪರ್ವಾದಿನಿ ಹೊವ್ನ್ ಹೊತ್ತಿ ವಾಜಾಪ್ ಹಾತಿತ್ ಘೆಟ್ಲಿನ್, ಸಗ್ಳ್ಯಾ ಬಾಯ್ಕಾ ಮನ್ಸಾನಿ ವಾಜ್ಪಾ ಧರುನ್ ಘೆವ್ನ್ ಗಿತ್ ಸಾಂಗಿತ್ ನಾಚುನ್ಗೆತ್ ತಿಚ್ಯಾ ಫಾಟ್ನಾ ಜಾತಾನಾ, <verse eid="EXO 15:20" /><verse number="21" style="v" sid="EXO 15:21" />ಮಿರ್ಯಾಮಾನ್ ಅಸೆ ಗಾವ್ಲಿನ್ “ಸರ್ವೆಸ್ಪರಾ ಸ್ತುತಿ ಕರಾ,</para>
  <para style="q1" vid="EXO 15:21">ತೊ ಮೊಟೊ ಜಯ್ ಸಾಲಿ ಹೊಲಾ.</para>
  <para style="q2" vid="EXO 15:21">ತೆನಿ ಘೊಡ್ಕಿಯಾಕ್ನಿ ಅನಿ ತೆ ಚಾಲ್ವುತಲ್ಯಾಕ್ನಿ ಸಮುಂದರಾತ್,</para>
  <para style="q2" vid="EXO 15:21">ಪಾಡ್ವುನ್ ನಾಸ್ ಕರ್ಲ್ಯಾನ್”.<verse eid="EXO 15:21" /></para>
  <para style="s">ಕೊಡು ಪಾನಿ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22" />ಮಾನಾ ಮೊಯ್ಜೆನ್ ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ತಾಂಬ್ಡ್ಯಾ ಸಮುಂದ್ರಾಚ್ಯಾ ಜಗ್ಗೊಳ್ನಾ ಚಾಲ್ವುಕ್ ಲಾಗಲ್ಯಾ ತನ್ನಾ, ತೆನಿ ಶುರ್ ಮನ್ತಲ್ಯಾ ಡಂಗ್ಳಿತ್ ತಿನ್ ದಿಸ್ ಚಲುನ್ ಗೆಲ್ಯಾನಿ, ಖರೆ ತೆಂಕಾ ಖೈ ಬಿ ಪಾನಿ ಗಾವ್ಕ್ ನಾ. <verse eid="EXO 15:22" /><verse number="23" style="v" sid="EXO 15:23" />ಮಾನಾ “ಮಾರಾ” ಮನ್ತಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಜಾವ್ನ್ ಪಾವ್ಲ್ಯಾನಿ; ಖರೆ ಥೈತ್ಲೆ ಪಾನಿ ಕೊಡು ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ತೆಂಕಾ ತೆ ಪಿವ್ಕ್ ಹೊವ್ಕನಾ, ತಸೆ ಹೊವ್ನ್ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ “ಮಾರಾ” ನಾತರ್ ಕೊಡು ಮನುನ್ ನಾವ್ ಯೆಲೆ. <verse eid="EXO 15:23" /><verse number="24" style="v" sid="EXO 15:24" />ಲೊಕಾನಿ ಅಮಿ ಕಾಯ್ ಪಿವ್ಚೆ? ಮನುನ್ ಮೊಯ್ಜೆ ವರ್‍ತಿ ಗುನ್ಗುಟ್ಟುಕ್ ಲಾಗಲ್ಲೆ ತನ್ನಾ, <verse eid="EXO 15:24" /><verse number="25" style="v" sid="EXO 15:25" />ಮೊಯ್ಜೆನ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಮಾಗ್ನಿ ಕರ್ಲ್ಯಾನ್, ತನ್ನಾ ಸರ್ವೆಸ್ವರಾನ್ ತೆಕಾ ಎಕ್ ಝಾಡ್ ದಾಕ್ವುಲ್ಯಾನ್,</para>
  <para style="p" vid="EXO 15:25">ತೆ ಝಾಡ್ ಪಾನಿಯಾತ್ ಘಾಟಲ್ಲೆ ತನ್ನಾ ಪಾನಿ ಗೊಡ್ ಹೊಲೆ, ಥೈ ಸರ್ವೆಸ್ಪರಾನ್ ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ಎಕ್ ನೆಮ್ ನಿರ್ದಾರ್ ಕರುನ್ ತೆಂಕಾ ಪರಿಕ್ಷಾ ಕರುನ್ ಅಸೆ ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 15:25" /><verse number="26" style="v" sid="EXO 15:26" />ಸರ್ವೆಸ್ಪರಾನ್ ತೆಂಕಾ, ತುಮಿ ಮಾಜ್ಯಾ ಸಗ್ಳ್ಯಾ ಗೊಸ್ಟಿಯಾಕ್ನಿ ಕಾನ್ ದಿವ್ನ್, ಮಾಜ್ಯಾ ದಿಶ್ಟಿಕ್ ಬರೆ ದಿಸ್ತಲೆ ಕರುನ್, ಮಾಜ್ಯಾ ಹುಕುಮಾಕ್ನಿ ಮಾನ್ ದಿವ್ನ್ ಚಲಲ್ಲೆ ಹೊಲ್ಯಾರ್, ಮಿಯಾ ಇಜಿಪ್ತ್ ಕಾರಾಕ್ನಿ ದಿಲ್ಲ್ಯಾ ದುಕ್ನ್ಯಾತ್ನಿ ಎಕ್ಬಿ ತುಮ್ಚಾಕ್ಡೆ ಯೆವ್ಕ್ ದಿಯ್ನಾ, ಸರ್ವೆಸ್ಪರ್ ಮನ್ತಲೊ ಮಿಯಾಚ್ ತುಮ್ಕಾ ಅರಾಮ್ ಥವ್ತಲೊ, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 15:26" /><verse number="27" style="v" sid="EXO 15:27" />ಮಾನಾ ತೆನಿ ಎಲಿಮಿಕ್ ಯೆಲ್ಯಾನಿ, ಥೈ ಬಾರಾ ಪಾನಿಯಾಚಿ ಝರಿಯಾ, ಸತ್ತರ್ ಖಜುರಾಚಿ ಝಾಡಾ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ ತ್ಯಾ ಪಾನಿಯಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಝೊಪ್ಡಿ ಭಾಂದುನ್ ಘೆವ್ನ್ ರಾಲ್ಯಾನಿ.<verse eid="EXO 15:27" /></para>
  <chapter eid="EXO 15" />
  <chapter number="16" style="c" sid="EXO 16" />
  <para style="s">ಮನ್ನಾ ಅನಿ ಲಾವಕ್ಕಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1" />ಇಜ್ರಾಯೆಲಾಂಚೊ ಸಗ್ಳೊ ತಾಂಡೊ ಎಲಿಮಿಕ್ನಾ ಜಾವ್ಕ್ ಲಾಗಲ್ಲ್ಯಾ ಮಾನಾ ತೆನಿ ಇಜಿಪ್ತ್ ದೆಶ್ ಸೊಡುನ್ ದೊನ್ವ್ಯಾ ಮೈನ್ಯಾಚ್ಯಾ ಪಂದ್ರಾವ್ಯಾ ದಿಸಿ ಎಲಿಮಿಕ್ ಅನಿ ಸಿನಾಯ್ ಮಡ್ಡಿಚ್ಯಾ ಮದ್ದಿ ಹೊತ್ತ್ಯಾ ಸಿನ್ ಮನ್ತಲ್ಯಾ ಡಂಗ್ಳಿತ್ ಯೆಲ್ಯಾನಿ. <verse eid="EXO 16:1" /><verse number="2" style="v" sid="EXO 16:2" />ಡಂಗ್ಳಿತ್ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಸಗ್ಳ್ಯಾ ತಾಂಡ್ಯಾನ್, ಮೊಯ್ಜೆ ಅನಿ ಆರೊನಾವರ್‍ತಿ ಗುನ್ಗುಟ್ಟುನ್, <verse eid="EXO 16:2" /><verse number="3" style="v" sid="EXO 16:3" />“ಹೊತ್ತೊ ಪುರಾ ತಾಂಡೊ ಭುಕೆನ್ ಮರುಚೆ ಮನುನ್ ತುಮಿ ಅಮ್ಕಾ ಡಂಗ್ಳಿತ್ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾಸಿ, ಅಮಿ ಇಜಿಪ್ತಾತ್ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಹಾತಿತ್ ಮರ್ತಲೆ ಕವ್ಡೆಕಿ ಬರೆ ಹೊತ್ತೆ, ತನ್ನಾ ಅಮಿ ಮಾಸಾಚ್ಯಾ ಆಯ್ದಾನಾಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ಬಸುನ್ ಪೊಟ್ ಭರ್ ಜೆಯ್ತ್ ಹೊತ್ತ್ಯಾಂವ್ ನ್ಹಯ್” ಮಟ್ಲ್ಯಾನಿ. <verse eid="EXO 16:3" /><verse number="4" style="v" sid="EXO 16:4" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಅಬಕ್ ಮಿಯಾ ಮಳ್ಬಾಕ್ನಾ ಜೆವಾನ್ ದಿತಾ, ಹಿ ಲೊಕಾ ಹ್ಯಾ ಲೊಕಾ ಹರ್ ಎಕ್ ದಿಸಿಬಿ ಭಾಯ್ರ್ ಜಾವ್ನ್ ತ್ಯಾ ದಿಸಾಕ್ ಪಾಜೆ ಹೊಲ್ಲೆ ತವ್ಡೆಚ್ ಗೊಳಾ ಕರುನ್ ಘೆವ್ಚೆ, ಹೆಚ್ಯಾ ವೈನಾ ತೆನಿ ಮಾಜ್ಯಾ ಗೊಸ್ಟಿ ಸಾರ್ಕೆ ಚಲುಲಾತ್ಕಿ ನಾ ಮನುನ್ ಮಿಯಾ ಕಳ್ವುನ್ ಘೆತಾ. <verse eid="EXO 16:4" /><verse number="5" style="v" sid="EXO 16:5" />ಸಾವೆಚ್ಯಾ ದಿಸಿ ತೆನಿ ಹಾನಲ್ಲೆ ತಯಾರ್ ಕರುನ್ ಘೆತಾತ್, ಖರೆ ತೆ ಸದ್ದಾ ಮಿಳ್ವುನ್ ಘೆಟಲ್ಲ್ಯಾಕಿಂತಾ ದೊನ್ ಪಟ್ಟ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 16:5" /><verse number="6" style="v" sid="EXO 16:6" />ಮೊಯ್ಜೆನ್ ಅನಿ ಆರೊನಾನ್ ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ, “ತುಮ್ಕಾ ಇಜಿಪ್ತ್ ದೆಸಾಕ್ನಾ ಸುಟ್ಕಾಕರಲ್ಲೆ ಸರ್ವೆಸ್ಪರಾನುಚ್ ಮನ್ತಲೆ ಸಾಂಚೆಕ್ಡೆ ತುಮ್ಕಾ ಕಳ್ತಾ; <verse eid="EXO 16:6" /><verse number="7" style="v" sid="EXO 16:7" />ಸಕ್ಕಾಳ್ಚೆ ಸರ್ವೆಸ್ಪರಾಚಿ ಮಹಿಮಾ ತುಮ್ಕಾ ದಿಸ್ತಾ, ತುಮಿ ತೆಜ್ಯಾ ವರ್‍ತಿ ಗುನ್ಗುಟ್ತಲಿ ಗೊಸ್ಟಿಯಾ ತೆಕಾ ಆಯಿಕ್ಲಾ, ತುಮಿ ಅಮ್ಚೆ ವರ್‍ತಿ ಕಶ್ಯಾಕ್ ಗುನ್ಗುಟ್ತ್ಯಾಸಿ? ಅಮಿ ಲೈ ಕಮ್ಮಿಚೆ” ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 16:7" /><verse number="8" style="v" sid="EXO 16:8" />ಮೊಯ್ಜೆನ್, “ಸಾಂಚೆಕ್ಡೆ ಸರ್ವೆಸ್ಪರ್ ತುಮ್ಕಾ ಮಾಸೆಚೆ ಜೆವಾನ್ ಅನಿ ಸಕ್ಕಾಳ್ಚೆ ಪಾಜೆ ತವ್ಡಿ ಭಾಕ್ರಿಯಾ ದಿತಾ. ತುಮಿ ಗುನ್ಗುಟ್ತಲೆ ಸರ್ವೆಸ್ಪರಾಕ್ ಪಾವ್ಲೆ, ತೆ ತುಮಿ ಗುನ್ಗುಟ್ತಲೆ ಸರ್ವೆಸ್ಪರಾಕ್ ಖರೆ ಅಮ್ಕಾ ನೈ, ಮಿಯಾ ಅನಿ ಆರೊನ್ ಲೈ ಕಮ್ಮಿಚೆ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 16:8" /><verse number="9" style="v" sid="EXO 16:9" />ಅನಿ ಮೊಯ್ಜೆನ್ ಆರೊನಾಕ್, ತಿಯಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ತಾಂಡ್ಯಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಜಾವ್ನ್, ಸರ್ವೆಸ್ಪರಾನ್ ತುಮಿ ಗುನ್ಗುಟ್ತಲೆ ಆಯ್ಕಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತುಮಿ ಸಗ್ಳೆ ಗೊಳಾ ಹೊವ್ನ್ ತೆಚ್ಯಾ ಇದ್ರಾಕ್ ಯೆವ್ಚೆ ಮನುನ್ ಹುಕುಮ್ ದಿ, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 16:9" /><verse number="10" style="v" sid="EXO 16:10" />ಆರೊನ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ತಾನಾ, ತೆನಿ ಡಂಗ್ಳಿಕ್ಡೆ ಬಗಟ್ಲ್ಯಾನಿ ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾಚಿ ಮಹಿಮಾ ಮಳ್ಬಾತ್ ದಿಸ್ಲಿ.<verse eid="EXO 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 16:11" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲುನ್, <verse eid="EXO 16:11" /><verse number="12" style="v" sid="EXO 16:12" />“ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಗುನ್ಗುಟ್ತಲೆ ಮಾಕಾ ಆಯ್ಕಲಾ, ತಿಯಾ ತೆಂಕಾ, ತುಮಿ ಸಾಂಚೆಕ್ಡೆ ಮಾಸಾಚೆ ಜೆವಾನ್ ಜೆವ್ತ್ಯಾಸಿ, ಸಕ್ಕಾಳಿ ಪಾಜೆ ತೌಡಿ ಭಾಕ್ರಿಯಾ ಖಾತ್ಯಾಸಿ, ಅನಿ ಹೆಚ್ಯಾ ವೈನಾ ಮಿಯಾಚ್ ತುಮ್ಚೊ ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ತುಮ್ಕಾ ಕಳ್ತಾ ಮನುನ್ ತೆಂಕಾ ಸಾಂಗುಚೆ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 16:12" /><verse number="13" style="v" sid="EXO 16:13" />ಸಾಂಜ್ ಹೊತಾನಾ ಲಾವಕ್ಕಿಯಾ ತೆಂಚ್ಯಾ ಬಿಡಾರಾಂಚ್ಯಾ ವರ್‍ತಿ ಧಾಪುನ್ ಪಡ್ಲಿ, ಸಕ್ಕಾಳಿ ಇಬ್ಬನಿ ಬಿಡಾರಾಂಚ್ಯಾ ಭೊತ್ಯಾನಿ ಪಡ್ಲಿ. <verse eid="EXO 16:13" /><verse number="14" style="v" sid="EXO 16:14" />ಇಬ್ಬನಿ ಸುಕುನ್ ಗೆಲ್ಲ್ಯೆ ತನ್ನಾ ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಬಾರಿಕ್ ರವೊ ಗತಿನ್ ಪಡಲ್ಲೆ ದಿಸ್ಲೆ. ತೆ ಪಿಟ್ಟಾ ಸಾರ್ಕೆ ಫಾಂಡ್ರೆ ಹೊತ್ತೆ, <verse eid="EXO 16:14" /><verse number="15" style="v" sid="EXO 16:15" />ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಲೊಕಾನಿ ತೆ ಬಗ್ತಾನಾ, ಎಕಾ ಮೆಕಾಕ್ನಿ ತೆ ಮನ್ನಾ ಮಟ್ಲ್ಯಾನಿ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತೆ ಕಾಯ್ ಮನ್ತಲೆ ತೆಂಕಾ ಕಳುಕ್ನಾ, ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಸರ್ವೆಸ್ಪರಾನ್ ದಿಲ್ಲಿ ಭಾಕ್ರಿಯಾ ಹಿಚ್ ಹೊಯ್, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 16:15" /><verse number="16" style="v" sid="EXO 16:16" />ಸರ್ವೆಸ್ಪರಾನ್ ತೆಂಕಾ ಹುಕುಮ್ ದಿಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ಹರ್ ಎಕ್ಲೊಬಿ ಅಪ್ನಿ ಕವ್ಡೆ ಖಾತಾ ತವ್ಡೆ ಗೊಳಾ ಕರುನ್ ಘೆಂವ್ದಿತ್, ಎಕ್ಲ್ಯಾಕ್ ತಿನ್ ಶೆರ್ ತೌಡೆ ಬಿಡಾರಾತ್ ಹೊತ್ತ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಅಂಕ್ಯಾ ಪ್ರಕಾರ್ ಗೊಳಾ ಕರುನ್ ಘೆವ್ಚೆ ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 16:17" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ತಸೆಚ್ ಕರುನ್ ಉಲ್ಲ್ಯಾನಿ ಲೈ, ಅನಿ ಉಲ್ಲ್ಯಾನಿ ಕಮ್ಮಿ ಗೊಳಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 16:17" /><verse number="18" style="v" sid="EXO 16:18" />ಲೈ ಗೊಳಾ ಕರಲ್ಯಾಕ್ನಿ ಲೈ ಗಾವ್ಕ್ ನಾ, ಅನಿ ಕಮ್ಮಿ ಗೊಳಾ ಕರಲ್ಲ್ಯಾಕ್ನಿಬಿ ಕಮ್ಮಿ ಹೊವ್ಕ್ ನಾ, ಹರ್ ಎಕ್ಲ್ಯಾಕ್ಬಿ ಅಪ್ನಾಚ್ಯಾ ಜೆವ್ನಾಕ್ ಫಿರೆ ಹೊತಾ ತೌಡೆಚ್ ಗಾವ್ಲೆ. <verse eid="EXO 16:18" /><verse number="19" style="v" sid="EXO 16:19" />ಮೊಯ್ಜೆನ್ ತೆಂಕಾ ಹ್ಯಾತುರ್ ಕೊನ್ಬಿ ದುಸ್ರೆಂದಿಸಾ ಪಾತರ್ ಥವ್ನ್ ಘೆವ್ಚೆ ನ್ಹಯ್ ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 16:19" /><verse number="20" style="v" sid="EXO 16:20" />ಹೊಲ್ಯಾರ್ಬಿ ಉಲ್ಲ್ಯಾ ಲೊಕಾನಿ ಮೊಯ್ಜೆಚಿ ಗೊಸ್ಟ್ ಆಯ್ಕಿ ನಸ್ತಾನಾ, ತೆ ಸಕ್ಕಾಳಿ ಪತರ್ ಥವ್ನ್ ಘೆಟಲ್ಲೆ ತನ್ನಾ ತೆ ಕಿಡೆ ಪಡುನ್ ವಾಸ್ ಉಟಲ್ಲಿ, ತನ್ನಾ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಮೊಯ್ಜೆಕ್ ರಾಗ್ ಯೆಲೊ.<verse eid="EXO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 16:21" />ಅಸೆಚ್ ತೆಂಚ್ಯಾತ್ ಹರ್ ಎಕ್ಲೊಬಿ ಖಾತಾ ತವ್ಡೆ ಸದ್ದಾ ಸಕ್ಕಾಳಿ ತೆನಿ ತೆ ಗೊಳಾ ಕರಿತ್, ನಿಂಬಾರ್ ಯೆಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತೆ ಕರ್ಗುನ್ ಜಾಯ್.<verse eid="EXO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 16:22" />ಸಾವೆಚ್ಯಾ ದಿಸಿ ದೊನ್‍ಪಟ್ ಭಾಕ್ರಿಯಾ ಮಟ್ಲ್ಯಾರ್, ಎಕ್ಲ್ಯಾಕ್ ಸಾ ಶೆರ್ ಹೊಯ್ ಸಾರ್ಕೆ ಗೊಳಾ ಕರಲ್ಯಾ ಸಾಟ್ನಿ ತಾಂಡ್ಯಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಮುಖಂಡಾನಿ ಯೆವ್ನ್ ಮೊಯ್ಜೆಕ್ ಕಳ್ವುಲ್ಯಾನಿ. <verse eid="EXO 16:22" /><verse number="23" style="v" sid="EXO 16:23" />ಸರ್ವೆಸ್ಪರಾನ್ ತೆಂಕಾ ಸಾಂಗಲ್ಲಿ ಗೊಸ್ಟ್ ಹಿಚ್, ಉದ್ದ್ಯಾ ಆರಾಮ್ ಕರ್‍ತಲೆ ನಿತಳ್ ಸಬ್ಬಾತಾಚೊ ದಿಸ್ ಹೊವ್ನ್ ಹಾಯ್, ಭಾಜ್ತಲೆ ಹೊತ್ತೆ ಸಗ್ಳೆ ಆಜುಚ್ ಭಾಜುನ್ ಘೆವಾ. ಸಿಜ್ವುತಲೆ ಹೊತ್ತೆ ಸಿಜ್ವುನ್ ಘೆವಾ, ಹ್ಯಾತುರ್ ಹುರಲ್ಲೆ ಸಗ್ಳೆ ಸಕ್ಕಾಳಿ ಪತರ್ ಥವ್ನ್ ಘೆವಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 16:23" /><verse number="24" style="v" sid="EXO 16:24" />ಮೊಯ್ಜೆನ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತೆನಿ ತೆ ದುಸ್ರೆಂದಿಸಾ ಪಾತರ್ ಥವ್ನ್ ಘೆಟಲ್ಲ್ಯಾ ತನ್ನಾ, ತೆಕಾ ವಾಸ್ಬಿ ಯೆವ್ಕನಾ, ಅನಿ ತ್ಯಾತುರ್ ಕಿಡೆಬಿ ಹೊವ್ಕ್ ನಾತ್. <verse eid="EXO 16:24" /><verse number="25" style="v" sid="EXO 16:25" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, ಆಜ್ ಹೆ ಖಾವಾ ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಆಜ್ ಸರ್ವೆಸ್ಪರಾಚೊ ಅರಾಮ್ ಕರ್ತಲೊ ಸಬ್ಬಾತಾಚೊ ದಿಸ್ ಮನುನ್ ನಿರ್ದಾರ್ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತುಮ್ಕಾ ಬಿಡಾರಾಚ್ಯಾ ಭಾಯ್ರ್ ಕಾಯ್ಬಿ ಗಾಯ್ನಾ, <verse eid="EXO 16:25" /><verse number="26" style="v" sid="EXO 16:26" />ಸಾ ದಿಸ್ ತುಮಿ ತೆ ಗೊಳಾ ಕರುಚೆ, ಸಾತ್ವೆಚೊ ದಿಸ್ ಆರಾಮ್ ಕರ್ತಲೊ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಬಾರಿಕ್ಲಿಬಿ ರ್‍ಹಾಯ್ನಾ ಮಟ್ಲ್ಯಾನ್ ತಸೆಚ್ ಹೊಲೆ. <verse eid="EXO 16:26" /><verse number="27" style="v" sid="EXO 16:27" />ಸಾತ್ವೆಚ್ಯಾ ದಿಸಿ ಉಲ್ಲಿ ಲೊಕಾ ಭಾಕ್ರಿಯಾ ಗೊಳಾ ಕರುಕ್ ಮನುನ್ ಬಾರ್ಯಾ ಗೆಲೆ, ಖರೆ ತೆಂಕಾ ಕಾಯ್ಬಿ ಗಾವ್ಕ್ ನಾ. <verse eid="EXO 16:27" /><verse number="28" style="v" sid="EXO 16:28" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ಅನಿ ಕವ್ಡೆ ಪತರ್ ತುಮಿ ಮಾಜಿ ಹುಕುಮಾ ತಿರಸ್ಕಾರ್ ಕರ್ತ್ಯಾಶಿ?” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 16:28" /><verse number="29" style="v" sid="EXO 16:29" />ಸರ್ವೆಸ್ಪರಾನ್ ತುಮ್ಕಾ ಆರಾಮ್ ಕರ್ತಲೊ ದಿಸ್ ದಿಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತುಮ್ಕಾ ಸಾವೆಚ್ಯಾ ದಿಸಾತ್ ದೊನ್ ದಿಸಾಚಿ ಭಾಕ್ರಿಯಾ ದಿಲ್ಯಾನಾಯ್, ಹರ್ ಎಕ್ಲೊಬಿ ಅಪ್ನಿ ಹೊತ್ತ್ಯಾಕ್ಡೆ ರಾವ್ಚೆ ಕೊನ್ಬಿ ಅಪ್ಲೊ ಜಾಗೊ ಸೊಡುನ್ ಜಾವ್ಚೆ ನ್ಹಯ್ , ಯಾದ್ ರಾಂವ್ದಿತ್, <verse eid="EXO 16:29" /><verse number="30" style="v" sid="EXO 16:30" />ತಸೆ ಹೊವ್ನ್ ಲೊಕಾನಿ ಸಾತ್ವ್ಯಾ ದಿಸಿ ಕಾಯ್ಬಿ ಕಾಮ್ ಕರಿ ನಸ್ತಾನಾ ಆರಾಮ್ ಕರ್ಲ್ಯಾನಿ.<verse eid="EXO 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ತ್ಯಾ ಜೆವ್ನಾಕ್ ಮನ್ನಾ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನಿ. ತೆ ಸಾಂಬಾರಾಚ್ಯಾ ದಾನ್ಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಅನಿ ಫಾಂಡ್ರೆ ಹೊತ್ತೆ, ಅನಿ ತೆಚಿ ರುಚ್ ಮ್ಹಾಂವ್ ಮಿಸಳಲ್ಲ್ಯಾ ಪೊಳ್ಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ರುಚಿ ಹೊತ್ತಿ. <verse eid="EXO 16:31" /><verse number="32" style="v" sid="EXO 16:32" />ಮೊಯ್ಜೆನ್ ಲೊಕಾಕ್ನಿ, “ಸರ್ವೆಸ್ಪರ್ ಹ್ಯಾ ವಿಶಯಾತ್ ಹುಕುಮ್ ದಿತಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ಮಿಯಾ ಇಜಿಪ್ತ್ ದೆಸಾತ್ನಾ ತುಮ್ಕಾ ಭಾಯ್ರ್ ಹಾನಲ್ಲ್ಯಾ ತನ್ನಾ ಡಂಗ್ಳಿತ್ ಖಾವ್ಕ್ ದಿಲ್ಲೆ ಜೆವಾನ್ ತುಮ್ಚಾ ತುಮ್ಚ್ಯಾ ಪಿಳ್ಗಿಚೆ ಲೊಕಾ ಬಗಿ ಸಾರ್ಕೆ ತೆಂಚ್ಯಾ ಸಾಟ್ನಿ ಎಕ್ಲೊ ಖಾತಲೆ ತವ್ಡೆ ಮನ್ನಾ ಥವ್ನ್ ಘೆವ್ಚೆ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 16:32" /><verse number="33" style="v" sid="EXO 16:33" />ಮೊಯ್ಜೆನ್ ಆರೊನಾಕ್, “ತಿಯಾ ಎಕ್ ಆಯ್ದಾನ್ ಘೆವ್ನ್ ಎಕ್ಲೊ ಖಾತಲೆ ತವ್ಡೆ ಮನ್ನಾ ತ್ಯಾತುರ್ ಭರುನ್ ತುಮ್ಚ್ಯಾ ಪಿಗ್ಳಿಚ್ಯಾಕ್ನಿ ಬಗುಕ್ ಸಾಟ್ನಿ ಮನುನ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಥವ್” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 16:33" /><verse number="34" style="v" sid="EXO 16:34" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಆರೊನಾನ್ ತೆ ಮನ್ನಾ ಕರಾರಾಚ್ಯಾ ಪೆಟಿಚ್ಯಾ ಫಿಡೆ ಥವ್ಲ್ಯಾನ್. <verse eid="EXO 16:34" /><verse number="35" style="v" sid="EXO 16:35" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾ ದೆಶ್ಯಾಕ್ ಯೆವ್ನ್ ಪಾವಿ ಪಾತರ್ ಚಾಳಿಸ್ ವರಿಸ್ ತೆ ಮನ್ನಾ ಖಾಲ್ಯಾನಿ, ಕಾನಾನ್ ದೆಶ್ಯಾತ್ ರ್‍ಹಾತಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಯೆವ್ನ್ ಪಾವಿ ಪಾತರ್ಬಿ ತೆ ಮನ್ನಾಚ್ ಖಾಲ್ಯಾನಿ. <verse eid="EXO 16:35" /><verse number="36" style="v" sid="EXO 16:36" />ಗೊಮೆರ್ ಮನ್ಲ್ಯಾರ್ ಎಫಾತ್<note caller="+" style="f"><char style="fr" closed="false">16:36 </char><char style="ft" closed="false">ಎಫಾತ್ ಮಟ್ಲ್ಯಾರ್, ಲೈ ಕರುನ್ ತಿಸ್ ಸೆರ್.</char></note> ಧಾತ್ಲೊ ಎಕ್ ವಾಟೊ.<verse eid="EXO 16:36" /></para>
  <chapter eid="EXO 16" />
  <chapter number="17" style="c" sid="EXO 17" />
  <para style="s">ಮೊಟ್ಟ್ಯಾ ಗುಂಡ್ಯಾತ್ನಾ ಪಾನಿ ಯೆತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಸರ್ವೆಸ್ಪರ್ ಹುಕುಮಾ ಸಾರ್ಕೆ ಸಿನ್ ಮನ್ತಲ್ಯಾ ಡಂಗ್ಳಿಕ್ನಾ ಪರ್ಯಾನ್ ಕರುನ್ ರೆಫಿದಿಮಿ ಮನ್ತಲ್ಯಾಕ್ಡೆ ವಸ್ತಿ ರಾಲ್ಯಾನಿ, ಥೈ ತೆಂಕಾ ಪಿವ್ಕ್ ಪಾನಿ ಗಾವ್ಕ್ ನಾ. <verse eid="EXO 17:1" /><verse number="2" style="v" sid="EXO 17:2" />ತಸೆ ಹೊವ್ನ್, ತೆನಿ ಮೊಯ್ಜೆ ವಾಂಗ್ಡಾ ಝಗ್ಡುನ್ ಅಮ್ಕಾ ಪಿವ್ಕ್ ಪಾನಿ ದಾಕ್ವು ಮಟ್ಲ್ಯಾನಿ. ತನ್ನಾ ಮೊಯ್ಜೆನ್, ತುಮಿ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಕಶ್ಯಾಕ್ ಝಗಡ್ತ್ಯಾಸಿ, ಕಶ್ಯಾಕ್ ಸರ್ವೆಸ್ಪರಾಚಿ ಪರಿಕ್ಷಾ ಕರ್ತ್ಯಾಶಿ ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 17:2" /><verse number="3" style="v" sid="EXO 17:3" />ಥೈ ಲೊಕಾನಿ ಪಾನಿ ನಸಲ್ಲ್ಯಾ ತರಾಸಾನಿ, ಲೈ ಸೊಸ್ ಲಾಗುನ್ ಮೊಯ್ಜೆಚ್ಯಾ ವಿರೊಧ್ ಗುನ್ಗುಟ್ಲ್ಯಾನಿ, “ತಿಯಾ ಅಮ್ಚ್ಯಾ ಪೊರಾಕ್ನಿ ಅನಿ ಬಾಯ್ಕಾಕ್ನಿ ಅನಿ ಜನಾವಾರಾಕ್ನಿ ಇಜಿಪ್ತಾಕ್ನಾ ಕಶ್ಯಾಕ್ ಬಲ್ವುನ್ ಹಾನಲೈ ? ಪಾನಿ ನಸ್ತಾನಾ ಮಾರುಕ್ ಕಾಯ್?” ಮನುನ್ ಗಾಳಿಯಾ ದಿಲ್ಯಾನಿ. <verse eid="EXO 17:3" /><verse number="4" style="v" sid="EXO 17:4" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, “ಮಿಯಾ ಹ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಕಾಯ್ ಕರು? ಹೆನಿ ಮಾಕಾ ಗುಂಡೆ ಮಾರುನ್ ಜಿವ್ ಕಾಡ್ತಲ್ಯಾ ಸಾರ್ಕೆ ಹಾತ್”, ಮನುನ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಮಾಗ್ನಿ ಕರ್ಲ್ಯಾನ್.<verse eid="EXO 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ , “ತಿಯಾ ನೈಲ್ ನ್ಹಯಿಕ್ ಮಾರಲ್ಲೊ ಧಾಂಡೊ ಘೆವ್ನ್, ಲೊಕಾಂಚ್ಯಾ ಫಿಡೆ ಮಿಯಾ ದಾಕ್ವುತಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಜಾ. <verse eid="EXO 17:5" /><verse number="6" style="v" sid="EXO 17:6" />ಥೈಚ್ ಹೊತ್ತ್ಯಾ ಎಕ್ ಮೊಟ್ಟ್ಯಾ ಗುಂಡ್ಯಾ ವರ್‍ತಿ ಮಿಯಾಚ್ ತುಜಾ ಫಿಡ್ಯಾತ್ ಇಬೆ ರ್‍ಹಾತಾ, ಅನಿ ತಿಯಾ ತ್ಯಾ ಮೊಟ್ಟ್ಯಾ ಗುಂಡ್ಯಾಕ್ ಮಾರ್, ತ್ಯಾತುರ್ನಾ ಪಾನಿ ಯೆತಾ, ಲೊಕಾ ತೆ ಪಾನಿ ಫಿವುಂದಿತ್” ಮನುನ್ ಹುಕುಮ್ ದಿಲ್ಯಾನ್, ಅಸೆ ಮೊಯ್ಜೆನ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ಜಾಂನ್ತ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕುಚ್ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 17:6" /><verse number="7" style="v" sid="EXO 17:7" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಥೈ ಸರ್ವೆಸ್ಪರ್ ಅಪ್ನಾಚ್ಯಾ ಮದ್ದಿ ಹಾಯ್ ಕಿ ನಾ? ಮನುನ್ ಪರಿಕ್ಷಾ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತ್ಯಾ ಜಾಗ್ಯಾರ್ ಮೊಯ್ಜೆನ್, ಮಸ್ಸಾ ಮನುನ್ ಅನಿ ಲೊಕಾನಿ ಅಪ್ನಾಚ್ಯಾ ವಾಂಗ್ಡಾ ವಾದ್ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಮೆರಿಬಾ ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್.<verse eid="EXO 17:7" /></para>
  <para style="s">ಅಮಲೆಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಲಡಾಯ್</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8" />ರೆಫಿದಿಮ್ ಮನ್ತಲ್ಯಾಕ್ಡೆ ಅಮಾಲೆಕ್ಯಾನಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ವಿರೊಧ್ ಹೊವ್ನ್ ಝಗ್ಡೊ ಕರುಕ್ ಯೆಲ್ಯಾನಿ. <verse eid="EXO 17:8" /><verse number="9" style="v" sid="EXO 17:9" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಜೊಶ್ವಾಕ್, “ಸೈನಿಕಾಕ್ನಿ ಎಚುನ್ ಘೆವ್ನ್ ಉದ್ದ್ಯಾ ಅಮ್ಚ್ಯಾ ಸಾಟ್ನಿ ಹೊರಾಟ್ ಕರಾ ಮಿಯಾ ಧಾಂಡೊ ಧರುನ್ಗೆವ್ನ್ ಮಡ್ಡಿಚ್ಯಾ ವರ್‍ತಿ ಇಬೆ ರ್‍ಹಾತಾ”, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 17:9" /><verse number="10" style="v" sid="EXO 17:10" />ಜೊಶ್ವಾನ್ ಮೊಯ್ಜೆಚ್ಯಾ ಒಪ್ಕಿವೈನಾ ಅಮಾಲೆಕ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಝಗ್ಡೊ ಕರುಕ್ ಜಾವ್ಕ್ ಲಾಲೊ. ಮೊಯ್ಜೆ ಅನಿ ಆರೊನ್ ಅನಿ ಹುರಾ ಹೆನಿ ತಿಗೆಬಿ ಮಡ್ಡಿಚ್ಯಾ ತುದಿಕ್ ವರ್‍ತಿ ಚಡ್ಲ್ಯಾನಿ. <verse eid="EXO 17:10" /><verse number="11" style="v" sid="EXO 17:11" />ಮೊಯ್ಜೆನ್ ಹಾತ್ ವರ್‍ತಿ ಉಕಲ್ತಾನಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಜಿಕುನ್ಗೆತ್ ಹೊತ್ತ್ಯಾನಿ, ಅನಿ ತೊ ಹಾತ್ ಖಾಲ್ತಿ ಉತರ್ತಾನಾ ಅಮಾಲೆಕ್ಯಾನಿ ಜಿಕಿತ್. <verse eid="EXO 17:11" /><verse number="12" style="v" sid="EXO 17:12" />ಅಸೆ ರ್‍ಹಾತಾನಾ, ಮೊಯ್ಜೆಚೊ ಹಾತ್ ಒಳುನ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ, ಆರೊನ್ ಅನಿ ಹುರಾನ್ ಎಕ್ ಗುಂಡೊ ಹಾನುನ್ ಥವ್ನ್ ತೆಚ್ಯಾ ವರ್‍ತಿ ಮೊಯ್ಜೆಕ್ ಬಸ್ವುಲ್ಯಾನಿ. ಎಕ್ಲೊ ಉಜ್ವ್ಯಾಕ್ ಅನಿ ಎಕ್ಲೊ ಡಾವ್ಯಾಕ್ ಇಬೆರಾವ್ನ್ ತೆಚ್ಯಾ ಹಾತಾಕ್ನಿ ಆದಾರ್ ದಿಲ್ಯಾನಿ. ಅಸೆಚ್ ತೆಚಿ ಹಾತಾ ಖಾಲ್ತಿ ಉತ್ರಿ ನಸ್ತಾನಾ ವರ್‍ತಿಚ್ ರ್‍ಹಾಯ್ ಸಾರ್ಕೆ ದಿಸ್ ಬುಡಿ ಪತರ್ ರಾಲ್ಯಾನಿ. <verse eid="EXO 17:12" /><verse number="13" style="v" sid="EXO 17:13" />ಅಸೆ ಜೊಶ್ವಾನ್ ಅಮಾಲೆಕ್ಯಾಚ್ಯಾ ಸೈನ್ಯಾಕ್ನಿ ಕೊಯ್ತ್ಯಾಚೊ ವಾಟೊ ಕರುನ್ ಹಾರ್ವುಲ್ಯಾನ್.<verse eid="EXO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14" />“ಹ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಅಮಾಲೆಕ್ಯಾಚೆ ನಾಂವುಚ್ ನಾ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ, ಮನ್ತಲಿ ಹಿ ಗೊಸ್ಟ್ ಪುಸ್ತಕಾತ್ ಲಿವ್ನ್ ಅನಿ ಜೊಶ್ವಾಕ್ ಕಳಿ ಸಾರ್ಕೆ ಕರ್” ಮನುನ್ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 17:14" /><verse number="15" style="v" sid="EXO 17:15" />ಥೈ ಮೊಯ್ಜೆನ್ ಎಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಜಾಗೊ ತಯಾರ್ ಕರುನ್ ತೆಕಾ, “ಯೆವಾ ನಿಸ್ಸಿ”<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft" closed="false">ಯೆವಾ ನಿಸ್ಸಿ, ಮಟ್ಲ್ಯಾರ್ ಸರ್ವೆಸ್ಪರ್ ಅಮ್ಚೊ ಜಿಕೆಚೊ ಝಂಡೊ.</char></note> ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್. <verse eid="EXO 17:15" /><verse number="16" style="v" sid="EXO 17:16" />ಅನಿ ಮೊಯ್ಜೆನ್</para>
  <para style="q1" vid="EXO 17:16">“ಸರ್ವೆಸ್ಪರಾಚೊ ಝಂಡೊ ಉಕ್ಲುನ್ ಧರಾ,</para>
  <para style="q2" vid="EXO 17:16">ಅನಿ ಸರ್ವೆಸ್ಪರಾಕ್ ಅಮಾಲೆಕ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ</para>
  <para style="q1" vid="EXO 17:16">ಸದಾ ಸರ್ವತಾಕ್ ಝಗ್ಡೊ ರ್‍ಹಾತಾ”, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="EXO 17:16" /></para>
  <chapter eid="EXO 17" />
  <chapter number="18" style="c" sid="EXO 18" />
  <para style="s">ಜೆತ್ರೊ ಮೊಯ್ಜೆಕ್ ಬೆಟ್ತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1" />ಜೆತ್ರೊ ಮನ್ತಲೊ ಮೊಯ್ಜೆಚೊ ಮಾಮಾ, ಅನಿ ಮಿದ್ಯಾನ್ ಲೊಕಾಂಚೊ ಪುಜಾರಿ, ಹೆನಿ ದೆವಾನ್ ಅಪ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ ಕರಲ್ಲ್ಯಾ ಚಮತ್ಕಾರಾಚ್ಯಾ ವಿಶಯಾತ್ ಆಯ್ಕಲ್ಯಾನ್ ಅನಿ ಸರ್ವೆಸ್ಪರಾನ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಇಜಿಪ್ತಾಕ್ನಾ ಕಸೆ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್ ಮನ್ತಲೆ ಬಿ ತೆಕಾ ಕಳಲ್ಲೆ. <verse eid="EXO 18:1" /><verse number="2" style="v" sid="EXO 18:2" />ಹೆನಿ ಯೆತಾನಾ ಅಪ್ಲ್ಯಾಕ್ಡೆ ಧಾಡುನ್ ಹೊಲ್ಲ್ಯಾ ಮೊಯ್ಜೆಚಿ ಬಾಯ್ಕೊ ಜಿಪ್ಪೊರಾ ಮನ್ತಲಿ ಅನಿ ತಿಚ್ಯಾ ದೊನ್ ಲೆಕಾಕ್ನಿ ಬಲ್ವುನ್ ಹಾನ್ಲ್ಯಾನ್. <verse eid="EXO 18:2" /><verse number="3" style="v" sid="EXO 18:3" />ಮೊಯ್ಜೆನ್ ಅಪ್ನಿ ದುಸ್ರ್ಯಾ ದೆಶಾಚೊ ಪರ್ವಾಸಾಕ್ ಯೆಲ್ಲೊ ಮನುನ್ ಥೊರ್ಲಾ ಲೆಕಾಕ್ “ಗೆರ್ಶೊಮ್” ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್. <verse eid="EXO 18:3" /><verse number="4" style="v" sid="EXO 18:4" />ಅನಿ ಅಪ್ನಾಚೊ ಬಾಬಾಚೊ ದೆವ್ ಮಾಕಾ ಮಜತ್ಕಾರಿ ಹೊವ್ನ್ ಮಾಕಾ ಫರೊವ್ ರಾಜಾಚ್ಯಾ ಹಾತಿತ್ನಾ ಚುಕ್ವುಲ್ಯಾನ್ ಮನುನ್ ಘೆವ್ನ್ ಧಾಕ್ಲ್ಯಾ ಲೆಕಾಕ್ “ಎಲಿಯೆಜೆರ್” ಮನುನ್ ನಾವ್ ಥವ್ಲ್ಯಾನ್. <verse eid="EXO 18:4" /><verse number="5" style="v" sid="EXO 18:5" />ಮೊಯ್ಜೆಚೊ ಮಾಮಾ ಜೆತ್ರೊ, ಮೊಯ್ಜೆಚ್ಯಾ ಬಾಯ್ಕೊ ಪೊರಾಕ್ನಿ ಬಲ್ವುನ್ ಘೆವ್ನ್ ಡಂಗ್ಳಿತ್ಲ್ಯಾ ದೆವಾಚ್ಯಾ ಮಡ್ಡಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ವಸ್ತಿ ಹೊತ್ತ್ಯಾ ಮೊಯ್ಜೆಕ್ಡೆ ಯೆಲೊ. <verse eid="EXO 18:5" /><verse number="6" style="v" sid="EXO 18:6" />ಅನಿ ತೆನಿ ಮೊಯ್ಜೆಕ್ “ಮಿಯಾ ತುಜೊ ಮಾಮಾ, ಜೆತ್ರೊ ತುಜ್ಯಾ ಬಾಯ್ಕೊ ಪೊರಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಯೆಲಾ”, ಮನುನ್ ಸಾಂಗುನ್ ಧಾಡ್ಲ್ಯಾನ್. <verse eid="EXO 18:6" /><verse number="7" style="v" sid="EXO 18:7" />ಮೊಯ್ಜೆನ್ ಭಾಯ್ರ್ ಯೆವ್ನ್ ಅಪ್ಲ್ಯಾ ಮಾಮಾಕ್ ನಮಸ್ಕಾರ್ ಕರುನ್, ಅಪ್ಪುನ್ ಘೆವ್ನ್, ಮಾನಾ ಎಕಾ ಮೆಕಾಕ್ ಇಚಾರ್‍ನಿ ಕರುನ್ ಘೆವ್ನ್ ಮಾನಾ ತೆನಿ ಬಿಡಾರಾತ್ ಗೆಲ್ಯಾನಿ. <verse eid="EXO 18:7" /><verse number="8" style="v" sid="EXO 18:8" />ಮೊಯ್ಜೆನ್ ಅಪ್ನಾಕ್ ಅನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಮಜತ್ ಕರುನ್ ಫಾರೊವಾಕ್ ಅನಿ ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ತರಾಸ್ ದಿಲ್ಲೆ ಅನಿ ಅಪ್ನಾಕ್ ವಾಟೆ ವರ್‍ತಿ ಯೆಲ್ಲಿ ತರಾಸಾ ಸಗ್ಳಿಬಿ ತ್ಯಾತುರ್ ಸರ್ವೆಸ್ಪರಾನ್ ಕಸೆ ಪಾರ್ ಕರ್ಲ್ಯಾನ್ ಮನ್ತಲೆಬಿ ಅಪ್ನಾಚ್ಯಾ ಮಾಮಾಕ್ ಸಾಂಗ್ಲ್ಯಾನ್ . <verse eid="EXO 18:8" /><verse number="9" style="v" sid="EXO 18:9" />ಸರ್ವೆಸ್ಪರಾನ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಸುಟ್ಕಾ ಕರುನ್ ತೆಂಕಾ ಯೆವ್ಡೆ ಲೈ ಮಜತ್ ಕರಲ್ಲೆ ಆಯ್ಕುನ್ ಜೆತ್ರೊಕ್, ಲೈ ಖುಶಿ ಹೊಲಿ. <verse eid="EXO 18:9" /><verse number="10" style="v" sid="EXO 18:10" />ಅನಿ ತೆನಿ, “ಇಜಿಪ್ತಾತ್ನಾ ಅನಿ ಫಾರೊವ್ ರಾಜಾಚ್ಯಾ ಹಾತಿತ್ನಾ ತುಮ್ಕಾ ಸುಟ್ಕಾ ಕರಲ್ಲ್ಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಸ್ತುತಿ ಹೊಂವ್ದಿತ್!, ಅಪ್ನಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಗುಲಾಮ್ ಗಿರಿತ್ನಾ ರಾಕ್ವನ್ ಕರಲ್ಲ್ಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಸ್ತುತಿ ಹೊಂವ್ದಿತ್. <verse eid="EXO 18:10" /><verse number="11" style="v" sid="EXO 18:11" />ತೆನಿ ಅಪ್ಲ್ಯಾ ಲೊಕಾಕ್ನಿ ತೆಂಚ್ಯಾ ಹಾತಿತ್ನಾ ಸುಟ್ಕಾ ಕರುನ್, ತಿ ಇಜಿಪ್ತಾಚಿ ಲೊಕಾ ಬಡಾಯ್ ಕರ್‍ತಲ್ಯಾ ವಿಶಯಾತ್ ತೆಂಕಾ ಖಾಲ್ತಿ ಕರ್ಲ್ಯಾನ್, ತಸೆ ಹೊವ್ನ್ ಸಗ್ಳ್ಯಾ ದೆವಾಂಚ್ಯಾಕಿಂತಾಬಿ ಸರ್ವೆಸ್ಪರ್ ದೆವುಚ್ ಮೊಟೊ ಮನ್ತಲೆ ಅತ್ತಾ ಮಾಕಾ ಕಳುನ್ ಯೆಲಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 18:11" /><verse number="12" style="v" sid="EXO 18:12" />ಅನಿ ಯೆವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಮೊಯ್ಜೆಚೊ ಮಾಮಾ ಜೆತ್ರೊನ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಜಾಳ್ವುತಲಿ ಬಲಿ ಅನಿ ಹುರಲ್ಲಿ ಬಲಿ ಭೆಟ್ವುಲ್ಯಾನ್, ಆರೊನ್ ಅನಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಜಾಂನ್ತ್ಯಾ ಲೊಕಾನಿ ಯೆವ್ನ್ ದೆವಾಚ್ಯಾ ಇದ್ರಾಕ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಜೆವಾನ್ ಕರ್ಲ್ಯಾನಿ.<verse eid="EXO 18:12" /></para>
  <para style="s">ನ್ಯಾಯ್ ನಿರ್ನಯ್ ಕರ್‍ತಲ್ಯಾಕ್ನಿ ನೆಮಸ್ತಲೆ</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13" />ದುಸ್ರೆ ದಿಸಿ ಮೊಯ್ಜೆ ಲೊಕಾಕ್ನಿ ನ್ಯಾಯ್ ನಿರ್ನಯ್ ಕರುಕ್ ಬಸಲ್ಲೊ; ಲೊಕಾ ಸಕ್ಕಾಳಿಕ್ನಾ ಸಾಂಜ್ ಪತರ್ಬಿ ತೆಜ್ಯಾಕ್ಡೆ ಇಬೆ ಹೊತ್ತಿ. <verse eid="EXO 18:13" /><verse number="14" style="v" sid="EXO 18:14" />ಮೊಯ್ಜೆ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲುನ್ಗೆತ್ ಹೊತ್ತೆ ಸಗ್ಳೆ ತೆಜ್ಯಾ ಮಾಮಾನ್ ಬಗುನ್, “ತಿಯಾ ಕಶ್ಯಾಕ್ ಲೊಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಯೆವ್ಡೆ ಲೈ ತರಾಸ್ ಕರುನ್ ಘೆತೆಯ್?, ಲೊಕಾ ಬಗಟ್ಲ್ಯಾರ್ ಸಕ್ಕಾಳಾಕ್ನಾ ಸಾಂಜ್ ಪತರ್ಬಿ ತಿಯಾ ಎಕ್ಲೊಚ್ ಇಬೆರಾವ್ನ್ ನ್ಯಾಯ್ ನಿರ್ನಯ್ ಕರುಲೈ ಕಾಯ್?” ಮನುನ್ ಇಚಾರ್‍ಲ್ಯಾನಿ. <verse eid="EXO 18:14" /><verse number="15" style="v" sid="EXO 18:15" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, “ಹಿ ಲೊಕಾ ದೆವಾಚೊ ನಿರ್ದಾರ್ ಆಯ್ಕುಕ್ ಸಾಟ್ನಿ ಮಾಜಾಕ್ಡೆ ಯೆತಾತ್; <verse eid="EXO 18:15" /><verse number="16" style="v" sid="EXO 18:16" />ತೆಂಚ್ಯಾತ್ ಕಾಯ್ಬಿ ಝಗ್ಡೊ ಉಟ್ಲ್ಯಾರ್ ತೆನಿ ಮಾಜ್ಯಾಕ್ಡೆ ಯೆತಾತ್, ಮಿಯಾ ಇಚಾರ್ ಕರುನ್, ತೆಂಕಾ ನ್ಯಾಯ್ ನಿರ್ನಯ್ ಕರುನ್, ಸರ್ವೆಸ್ಪರಾಚೊ ಹುಕುಮ್ ತೆಂಕಾ ಸಾಂಗ್ತಾ” ಮನುನ್ ಜವಾಬ್ ದಿಲ್ಯಾನ್. <verse eid="EXO 18:16" /><verse number="17" style="v" sid="EXO 18:17" />ತೆ ಆಯ್ಕುನ್ ಜೆತ್ರೊನ್ ಮೊಯ್ಜೆಕ್, “ಹೆ ತಿಯಾ ಕರುಕ್ ಲಾಗಲ್ಲೆ ಸಮಾ ನಾ. <verse eid="EXO 18:17" /><verse number="18" style="v" sid="EXO 18:18" />ಹೆ ಕಾಮ್ ಲೈ ತರಾಸಾಚೆ ಹಾಯ್, ಹೆ ತುಜ್ಯಾನ್ ಎಕ್ಲ್ಯಾಚ್ಯಾನ್ ಚಾಲ್ವುಕ್ ಹೊಯ್ನಾ, ತಿಯಾ ಅನಿ ಲೊಕಾ ಖರೆಚ್ಬಿ ಲೈ ತರಾಸಾತ್ ಪಡ್ತ್ಯಾಸಿ. <verse eid="EXO 18:18" /><verse number="19" style="v" sid="EXO 18:19" />ತಸೆ ಹೊವ್ನ್, ಮಾಜೆ ಬೊಲ್ನೆ ಆಯ್ಕ್, ಅನಿ ಮಾಜ್ಯಾ ಸಲಹಾಕ್ನಿ ಕಾನ್ ದಿ, ಸರ್ವೆಸ್ಪರ್ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾತಾ, ಅನಿ ತಿಯಾ ಹ್ಯಾ ಲೊಕಾಂಚೊ ಝಗ್ಡೊ ಹೆಂಚ್ಯಾ ಅನಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಮದ್ದಿ ಇಬೆ ರಾವ್ನ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಹಾನ್ತೆಯ್, ತೆ ಸಮಾ ಹಾಯ್. <verse eid="EXO 18:19" /><verse number="20" style="v" sid="EXO 18:20" />ಅನಿ ದೆವಾಚಿ ಹುಕುಮಾ ಲೊಕಾಕ್ನಿ ಶಿಕ್ವುನ್ ತೆನಿ ಚಲುಚಿ ಹೊಲ್ಲಿ ವಾಟ್ ಅನಿ ಕರುಚೆ ಹೊಲ್ಲಿ ಕಾಮಾ ಕಳ್ವುಕುಚ್ ಪಾಜೆ. <verse eid="EXO 18:20" /><verse number="21" style="v" sid="EXO 18:21" />ಖರೆ ತಿಯಾ ಹ್ಯಾ ಲೊಕಾತ್ನಿ ಶಕ್ತ್ ಹೊತ್ತೆ, ದೆವಾಚಿ ಭಕ್ತಿ ಹೊತ್ತೆ, ವಿಶ್ವಾಸಾಚೆ ಅನಿ ಲಂಚ್ ಅಪ್ಡಿನಸಲ್ಲೆ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾಕ್ನಿ ಎಚುನ್ ಘೆ, ತೆಂಕಾ ಹಜಾರ್, ಸೆಂಬರ್ ಪನ್ನಾಸ್ ಅನಿ ಧಾ ಲೊಕಾಂಚೆ ಅಧಿಕಾರಿ ಕರುನ್ ನೆಮಸ್. <verse eid="EXO 18:21" /><verse number="22" style="v" sid="EXO 18:22" />ತೆನಿಚ್ ಕನ್ನಾಬಿ ಲೊಕಾಂಕ್ನಿ ನ್ಯಾಯ್ ನಿರ್ನಯ್ ಕರುಂದಿತ್, ಅನಿ ಲೈ ಮೊಟೆ ಮೊಟೆ ಝಗ್ಡೆ ಎಕುಚ್ ತುಜ್ಯಾ ಇದ್ರಾಕ್ ಹಾನುಂದಿ, ತೆನಿ ಅಸೆ ತುಜೆ ವಜ್ಜೆ ಘೆಂವ್ದಿತ್, ತನ್ನಾ ತುಜೆ ವಜ್ಜೆ ಕಮ್ಮಿ ಹೊತಾ. <verse eid="EXO 18:22" /><verse number="23" style="v" sid="EXO 18:23" />ತುಕಾ ಅಸೆ ಕರುಕ್ ದೆವ್ ಒಪ್ಕಿ ದಿಂವ್ದಿತ್, ಅಸೆ ಕರಲ್ಲ್ಯಾಕ್ ತಿಯಾ ಹೆ ಕಾಮ್ ಕರುಕ್ ಶಕ್ತ್ ಹೊತೈಯ್, ಅನಿ ಹಿ ಲೊಕಾಬಿ ಸಮಾಧಾನ್ ಹೊವ್ನ್ ಅಪಪ್ಲ್ಯಾ ಘರಾಕ್ನಿ ಜಾತಾತ್”, ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24" />ಮೊಯ್ಜೆನ್ ಅಪ್ಲ್ಯಾ ಮಾಮಾಚ್ಯಾ ಸಲಹಾಕ್ನಿ ಒಪ್ಕಿ ದಿಲ್ಯಾನ್, ಅನಿ ತೆನಿ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 18:24" /><verse number="25" style="v" sid="EXO 18:25" />ಮೊಯ್ಜೆನ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಶಕ್ತ್ ಹೊತ್ತ್ಯಾಕ್ನಿ ಎಚುನ್ ಘೆವ್ನ್, ಹಜಾರ್, ಸೆಂಬರ್, ಪನ್ನಾಸ್ ಅನಿ ಧಾ ಲೊಕಾಚ್ಯಾ ವರ್‍ತಿ ಅಧಿಕಾರಿ ಕರುನ್ ನೆಮಸ್ಲ್ಯಾನ್. <verse eid="EXO 18:25" /><verse number="26" style="v" sid="EXO 18:26" />ಹೆನಿಚ್ ಲೊಕಾಕ್ನಿ ಕನ್ನಾಬಿ ನ್ಯಾಯ್ ನಿರ್ನಯ್ ಕರ್‍ತಲೆ ಹೊಲೆ, ಅನಿ ಲೈ ತರಾಸಾಚೆ ಹೊತ್ತೆ ಝಗ್ಡೆ ಮೊಯ್ಜೆಕ್ಡೆ ಹಾನ್ಲ್ಯಾನಿ, ಅನಿ ತರಾಸಾಚೆ ನತ್ತೆ ಝಗ್ಡೆ ಸಗ್ಳೆ ಅಪ್ನಿಚ್ ನಿರ್ನಯ್ ಕರ್ಲ್ಯಾನಿ.<verse eid="EXO 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 18:27" />ಮಾನಾ ಮೊಯ್ಜೆನ್ ಅಪ್ಲ್ಯಾ ಮಾಮಾಕ್ ಧಾಡುನ್ ದಿಲ್ಯಾನ್, ಅನಿ ತೊ ತೆಚ್ಯಾ ಗಾಂವಾಕ್ ಪರ್‍ತುನ್ ಗೆಲೊ.<verse eid="EXO 18:27" /></para>
  <chapter eid="EXO 18" />
  <chapter number="19" style="c" sid="EXO 19" />
  <para style="s">ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಸಿನಾಯ್ ಮಡ್ಡಿವರ್‍ತಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಇಜಿಪ್ತಾಕ್ನಾ ಜಾವ್ಕ್ ಲಾಗಲ್ಲ್ಯಾ ತಿನ್ವ್ಯಾ ಮ್ಹಯಿನ್ಯಾತ್ ಸಿನಾಯ್ ಡಂಗ್ಳಿಕ್ ಪಾವ್ಲ್ಯಾನಿ. <verse eid="EXO 19:1" /><verse number="2" style="v" sid="EXO 19:2" />ತೆನಿ ರೆಫಿದಿಮ್ ಮನ್ತಲೊ ಜಾಗೊ ಸೊಡುನ್, ತ್ಯಾ ಡಂಗ್ಳಿಕ್ ಯೆವ್ನ್ ಥೈತ್ಲ್ಯಾ ಮಡ್ಡಿಚ್ಯಾ ಇದ್ರಾಕ್ ವಸ್ತಿ ರಾಲ್ಯಾನಿ. <verse eid="EXO 19:2" /><verse number="3" style="v" sid="EXO 19:3" />ಮೊಯ್ಜೆ ತ್ಯಾ ಮಡ್ಡಿ ವರ್‍ತಿ ಚಡುನ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆಲೊ. ಸರ್ವೆಸ್ಪರಾನ್ ತೆಕಾ ಮಡ್ಡಿ ವೈನಾ ಬಲ್ವುನ್, “ತಿಯಾ ಜಾಕೊಬಾಚ್ಯಾ ಘರಾನಾಚ್ಯಾ ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ಹಿ ಗೊಸ್ಟ್ ಸಾಂಗ್; <verse eid="EXO 19:3" /><verse number="4" style="v" sid="EXO 19:4" />ಮಿಯಾ ಇಜಿಪ್ತ್ ಕಾರಾಕ್ನಿ ಕರಲ್ಲೆ ತುಮಿ ಬಗಟ್ಲ್ಯಾಸಿ, ಎಕ್ ಹದ್ದ್ ಕಸೆ ಅಪ್ನಾಚ್ಯಾ ಪೆಟ್ಯಾಕ್ನಿ ಫಾಂಕುಟ್ಯಾ ವೈನಿ ಉಕ್ಲುನ್ ಘೆತಾ, ತಸೆ ಮಿಯಾ ತುಮ್ಕಾ ಉಕ್ಲುನ್ ಘೆವ್ನ್ ಮಾಜ್ಯಾ ಜಾಗ್ಯಾಕ್ ಪಾವಸ್ಲೊ, ಮನ್ತಲೆ ತುಮ್ಕಾ ಗೊತ್ತ್ ಹಾಯ್. <verse eid="EXO 19:4" /><verse number="5" style="v" sid="EXO 19:5" />ಅಸೆ ರ್‍ಹಾತಾನಾ, ಮಾಜೆ ಬೊಲ್ನೆ ತುಮಿ ಲೈ ದೆವಸ್ಪಾನಾನ್ ಆಯ್ಕುನ್, ಮಾಜಿ ಕರಾರಾ ಪಾಳುನ್ಗೆವ್ನ್ ಚಲಲ್ಲೆ ಹೊಲ್ಯಾರ್, ಸಗ್ಳೆ ಜಗ್ ಮಾಜೆ ಹೊವ್ನ್ ರಾಲ್ಯಾರ್ಬಿ ತುಮಿ ಸಗ್ಳ್ಯಾ ಲೊಕಾತ್ನಿ ಮಾಜಿ ಸ್ವತಾಚಿ ಲೊಕಾ ಹೊವ್ನ್ ರ್‍ಹಾತ್ಯಾಸಿ. <verse eid="EXO 19:5" /><verse number="6" style="v" sid="EXO 19:6" />ಅನಿ ತುಮಿ ಮಾಜ್ಯಾ ಯಾಜಕಾಂಚ್ಯಾ ಘರಾನಾಚೆ ಅನಿ ನಿತಳ್ ಲೊಕಾ ಹೊತ್ಯಾಸಿ, ಮನುನ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ತಿಯಾ ಕಳ್ವುಚಿ ಹೊಲ್ಲಿ ಗೊಸ್ಟ್ ಹಿ”, ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 19:7" />ಮೊಯ್ಜೆ ತ್ಯಾ ಮಡ್ಡಿ ವೈನಾ ಉತ್ರುನ್ ಯೆವ್ನ್, ಇಜ್ರಾಯೆಲಾತ್ನಿ ಜಾಂನ್ತ್ಯಾಕ್ನಿ ಗೊಳಾ ಕರುನ್, ತೆಂಕಾ ಸರ್ವೆಸ್ಪರಾನ್ ಹುಕುಮ್ ದಿಲ್ಲಿ ಸಗ್ಳಿ ಗೊಸ್ಟಿಯಾ ಕಳ್ವುಲ್ಯಾನ್. <verse eid="EXO 19:7" /><verse number="8" style="v" sid="EXO 19:8" />ತನ್ನಾ ಸಗ್ಳ್ಯಾ ಲೊಕಾನಿ, “ಅಮಿ ಸರ್ವೆಸ್ಪರಾನ್ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಕರ್ತಾಂವ್” ಮನುನ್ ಎಕುಚ್ ಮನಾನ್ ಜವಾಬ್ ದಿಲ್ಯಾನಿ, ಮೊಯ್ಜೆನ್ ತಿ ಗೊಸ್ಟ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಜಾವ್ನ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="EXO 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 19:9" />ಅನಿ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, ಅಬಕ್ ಮಿಯಾ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ತಲೆ ಲೊಕಾಕ್ನಿ ಆಯ್ಕುನ್ ತುಕಾ ಕನ್ನಾಬಿ ವಿಶ್ವಾಸ್ ಕರಿಸಾರ್ಕೆ ಮಿಯಾ ಮೊಡಾತ್ನಾ ತುಜ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆತಾ ಮಟ್ಲ್ಯಾನ್, ಅನಿ ಮೊಯ್ಜೆನ್ ಲೊಕಾಂಚೆ ಜವಾಬ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 19:9" /><verse number="10" style="v" sid="EXO 19:10" />ಮೊಯ್ಜೆನ್ ಲೊಕಾಂಚಿ ಬೊಲ್ನಿಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಸಾಂಗ್ತಾನಾ, ಸರ್ವೆಸ್ಪರಾನ್ ತೆಕಾ, “ತಿಯಾ ಲೊಕಾಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ಜಾವ್ನ್ ತೆಂಕಾ ಆಜ್ ಅನಿ ಉದ್ದ್ಯಾ ನಿತಳ್ ಕರ್, ತೆನಿ ಅಪ್ನಾಚೆ ಕಪ್ಡೆ ನಿತಳ್ ಕರುನ್ ಘೆಂವ್ದಿತ್, <verse eid="EXO 19:10" /><verse number="11" style="v" sid="EXO 19:11" />ಅನಿ ತಿನ್ವ್ಯಾ ದಿಸಿ ತೆನಿ ತಯಾರ್ ಹೊವ್ನ್ ರಾಂವ್ದಿತ್, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತ್ಯಾ ದಿಸಿ ಮಿಯಾ ಸರ್ವೆಸ್ಪರ್ , ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ದಾಕ್ವುನ್ ಘೆವ್ಕ್ ಸಿನಾಯ್ ಮಡ್ಡಿ ವರ್‍ತಿ ಉತ್ರುನ್ ಯೆತಾ, ಥೈ ತುಮಿ ಮಾಕಾ ಬಗ್ತ್ಯಾಸಿ. <verse eid="EXO 19:11" /><verse number="12" style="v" sid="EXO 19:12" />ತಿಯಾ ಲೊಕಾ ಮಡ್ಡಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆಯ್ನಾ ಸಾರ್ಕೆ ಮಡ್ಡಿಚ್ಯಾ ಭೊತ್ಯಾನ್ ಕುಪ್ಪ್ ಘಾಲುನ್ ವಳಕ್ ಕರ್, ಅನಿ ಲೊಕಾಕ್ನಿ ತುಮಿ ಮಡ್ಡಿ ಚಡುಚೆ ನ್ಹಯ್, ಅನಿ ಕುಪ್ಪಾಕ್ಬಿ ಅಪ್ಡು ನ್ಹಯ್, ಕೊನಿ ತರ್ಬಿ ಅಪಡಲ್ಲ್ಯಾಕ್ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ಹೊತಾ, <verse eid="EXO 19:12" /><verse number="13" style="v" sid="EXO 19:13" />ತಸ್ಲ್ಯಾಕ್ನಿ ಕೊನಿಬಿ ಹಾತ್ ಲಾವಿನಸ್ತಾನಾ, ಗುಂಡ್ಯಾನಿ ನಾತರ್ ಭರ್ಚಿಯಾನಿ ಮಾರುನ್, ಜಿವ್ ಕಾಡುಚೆ, ಮಡ್ಡಿಕ್ ಅಪಡಲ್ಲೊ ಮಾನುಸ್ ಹೊಂವ್ದಿತ್ ನಾತರ್ ಜನಾವರ್, ಕೊನಾಕ್ ಹೊಲ್ಯಾರ್ಬಿ ಹುರ್ವುಚೆ ನ್ಹಯ್, ಖರೆ ಪಂವ್ವೊ ವಾಜಲ್ಲ್ಯಾ ತನ್ನಾ ಮಡ್ಡಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆವ್ಚೆ ಮನುನ್ ಹುಶಾರ್ಕಿ ದಿವ್ನ್ ಸಾಂಗ್” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 19:13" /><verse number="14" style="v" sid="EXO 19:14" />ಮೊಯ್ಜೆನ್ ಮಡ್ಡಿ ವೈನಾ ಉತ್ರುನ್ ಯೆವ್ನ್ ತಸೆಚ್ ಆರಾದನ್ ಕರುಕ್ ಲೊಕಾಕ್ನಿ ತಯಾರ್ ಕರ್ಲ್ಯಾನ್, ಅನಿ ತೆನಿ ಅಪ್ನಾಚೆ ಕಪ್ಡೆಬಿ ಧುವ್ನ್ ಘೆವ್ನ್ ನಿತಳ್ ಹೊಲ್ಯಾನಿ. <verse eid="EXO 19:14" /><verse number="15" style="v" sid="EXO 19:15" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಲೊಕಾಕ್ನಿ, “ತಿನ್ವ್ಯಾ ದಿಸಾ ಸಾಟ್ನಿ ತಯಾರ್ ಹೊವಾ, ಹ್ಯಾ ದಿಸಾತ್ನಿ ಖಲ್ಯಾ ಘವ್ಮಾನ್ಸಾನ್ಬಿ ಬಾಯ್ಕೊ ಮನ್ಸಿ ವಾಂಗ್ಡಾ ಮಿಳುಚೆ ನ್ಹಯ್”, ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16" />ತಿನ್ವೊ ದಿಸಿ ಉಜ್ವಾಡ್ತಾನಾ, ತ್ಯಾ ಮಡ್ಡಿ ವರ್‍ತಿ ಗುಡ್ಗುಡೆ, ಲಕ್ಲಕೊ, ಕಾಳೊ ಮೊಡ್, ಅನಿ ಪಂವ್ವ್ಯಾಂಚೊ ಮೊಟೊ ಧನ್ ಆಯ್ಕೊ ಯೆಲೊ, ತನ್ನಾ ಬಿಡಾರಾತ್ನಿ ಹೊತ್ತಿ ಸಗ್ಳಿ ಲೊಕಾ ಭಿಂವ್ನ್ ಖಾಪುಕ್ ಲಾಗ್ಲಿ. <verse eid="EXO 19:16" /><verse number="17" style="v" sid="EXO 19:17" />ಮೊಯ್ಜೆನ್ ಲೊಕಾಕ್ನಿ, ಸರ್ವೆಸ್ಪರಾಕ್ ಬಗುಕ್ ಮನುನ್ ಬಿಡಾರಾಂಚ್ಯಾ ಭಾಯ್ರ್ ಹಾನ್ಲ್ಯಾನ್, ಅನಿ ತೆನಿ ಸಗ್ಳೆ ಯೆವ್ನ್ ಮಡ್ಡಿಚ್ಯಾ ಬುಡಿ ಇಬೆರಾಲ್ಯಾನಿ. <verse eid="EXO 19:17" /><verse number="18" style="v" sid="EXO 19:18" />ತನ್ನಾ ಸಗ್ಳಿ ಸಿನಾಯ್ ಮಡ್ಡಿ ಡುಕ್ಟಾನ್ ಭರಲ್ಲಿ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಸರ್ವೆಸ್ಪರ್ ಸಾಯ್ಬ್ ಆಗಿಚ್ಯಾ ರುಪಾರ್ ತ್ಯಾ ಮಡ್ಡಿ ವರ್‍ತಿ ಉತ್ರುನ್ ಯೆಲ್ಲೊ, ತೊ ಡುಕೊಟ್ ಆವಿಗೆಚೊ ಸಾರ್ಕೊ ವರ್‍ತಿ ಚಡ್ಲೊ, ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ತಿ ಮಡ್ಡಿ ಹಾಲ್ಲಿ. <verse eid="EXO 19:18" /><verse number="19" style="v" sid="EXO 19:19" />ಪಂವ್ವ್ಯಾಂಚೊ ಧನ್ ಲೈ ಲೈ ಹೊವ್ಕ್ ಲಾಗ್ಲೊ, ಮೊಯ್ಜೆನ್ ಬೊಲಲ್ಯಾ ತನ್ನಾ, ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಟ್ಟ್ಯಾ ಘಜ್ನಿ ಸಾರ್ಕೆ ಜವಾಬ್ ದಿವ್ನ್ ಬೊಲ್ಲ್ಯಾನ್. <verse eid="EXO 19:19" /><verse number="20" style="v" sid="EXO 19:20" />ಸರ್ವೆಸ್ಪರ್ ಸಿನಾಯ್ ಮಡ್ಡಿಚ್ಯಾ ಶಿಖರಾಕ್ ಉತ್ರುನ್ ಯೆಲೊ, ತೆನಿ “ಮಡ್ಡಿಚ್ಯಾ ತುದಿಕ್ ಯೆ” ಮನುನ್ ಮೊಯ್ಜೆಕ್ ಬಲ್ವುತಾನಾ ತೊ ಮಡ್ಡಿ ವರ್‍ತಿ ತುದಿಕ್ ಚಡ್ಲೊ. <verse eid="EXO 19:20" /><verse number="21" style="v" sid="EXO 19:21" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ತಿಯಾ ಜಾವ್ನ್ ಲೊಕಾಕ್ನಿ ಹುಶಾರ್ಕಿ ದಿ, ತೆನಿ ಮಾಕಾ ಮಟ್ಲ್ಯಾರ್, ಸರ್ವೆಸ್ಪರಾಕ್ ಬಗುಚೆ ಮನುನ್, ಮಡ್ಡಿಕ್ ಕರಲ್ಲಿ ವಳಕ್ ದಾಟುನ್ ಯೆತಿಲ್, ತಸೆ ಕಾಯ್ತರ್ಬಿ ಹೊಲ್ಯಾರ್ ಲೈ ಲೊಕಾ ಮರ್ತಾತ್. <verse eid="EXO 19:21" /><verse number="22" style="v" sid="EXO 19:22" />ಮಾಜೆಕ್ಡೆ ಯೆತಲ್ಯಾ ಯಾಜಕಾನಿಬಿ ಅಪ್ನಾಕ್ ನಿತಳ್ ಕರುನ್ ಘೆವ್ಚೆ, ನಾತರ್ ಮಿಯಾ ತೆಂಕಾ ಲೈ ಲಗ್ಗುನಾ ನಾಶ್ ಕರ್ತಾ”, ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 19:23" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಸರ್ವೆಸ್ಪರಾಕ್, “ಲೊಕಾಕ್ನಿ ಸಿನಾಯ್ ಮಡ್ಡಿ ಚಡುಕ್ ಹೊಯ್ನಾ, ತಿಯಾ ಸಾಂಗಟಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಮಡ್ಡಿಚ್ಯಾ ಭೊತ್ಯಾನ್ ಕುಪ್ಪಾಚಿ ವಳಕ್ ಕರುನ್ ತುಜ್ಯಾ ಸಾಟ್ನಿ ಎಗ್ಳುನ್ ಥವ್ಲಾ”, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 19:23" /><verse number="24" style="v" sid="EXO 19:24" />ತೆಕಾ ಸರ್ವೆಸ್ಪರಾನ್ , “ತಿಯಾ ಜಾವ್ನ್ ಆರೊನಾಕ್ ಬಲ್ವುನ್ಗೆವ್ನ್ ವರ್‍ತಿ ಯೆ, ಖರೆ ಯಾಜಕಾ ಅನಿ ಹುರಲ್ಲಿ ಲೊಕಾ ತಿ ವಳಕ್ ದಾಟುನ್ ಮಾಜೆಕ್ಡೆ ಯೆತಲೆ ನಕ್ಕೊ, ದಾಟುನ್ ಯೆಲ್ಯಾರ್ ಮಿಯಾ ತೆಂಕಾ ಲೈ ಲಗ್ಗುನಾ ನಾಶ್ ಕರ್ತಾ ಮನುನ್ ಸಾಂಗ್”, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 19:24" /><verse number="25" style="v" sid="EXO 19:25" />ತಸೆಚ್ ಮೊಯ್ಜೆನ್ ಖಾಲ್ತಿ ಉತ್ರುನ್ ಜಾವ್ನ್, ಸರ್ವೆಶ್ಚರಾಚಿ ಬೊಲ್ನಿಯಾ ಲೊಕಾಕ್ನಿ ತಸೆಚ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="EXO 19:25" /></para>
  <chapter eid="EXO 19" />
  <chapter number="20" style="c" sid="EXO 20" />
  <para style="s">ಧಾ ಹುಕುಮಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1" />ದೆವಾನ್ ಹಿ ಸಗ್ಳಿ ಹುಕುಮಾ ದಿಲ್ಯಾನ್, <verse eid="EXO 20:1" /><verse number="2" style="v" sid="EXO 20:2" />ತುಕಾ ಗುಲಾಮ್ ಗಿರಿತ್ನಾ ಮಟ್ಲ್ಯಾರ್, ಇಜಿಪ್ತ್ ದೆಶ್ಯಾಕ್ನಾ ಸೊಡ್ಸುನ್ ಭಾಯ್ರ್ ಹಾನಲ್ಲೊ ಮಿಯಾಚ್ ತುಮ್ಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರ್ .<verse eid="EXO 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 20:3" />ತುಕಾ ಮಾಕಾ ಸೊಡುನ್ ದುಸ್ರಿ ದೆವಾ ರಾವ್ಚಿ ನ್ಹಯ್ , <verse eid="EXO 20:3" /><verse number="4" style="v" sid="EXO 20:4" />ಮಳ್ಬಾತ್ಲ್ಯಾ ಹೊಂವ್ದಿ, ನಾತರ್ ಜಿಮ್ನಿ ವೈನಾ ಹೊಂವ್ದಿ, ಜಮ್ನಿಚ್ಯಾ ಖಾಲ್ತಿ ಹೊತ್ತ್ಯಾ ಪಾನಿಯಾತ್ ಹೊಂವ್ದಿ ಹೊತ್ತ್ಯಾ ಕಸ್ಲ್ಯಾಚೊಬಿ ರುಪ್ ನಾತರ್ ಮುರ್ತಿ ಕರುನ್ ಘೆವ್ ನಕ್ಕೊ, <verse eid="EXO 20:4" /><verse number="5" style="v" sid="EXO 20:5" />ಅನಿ ತೆಕಾ ಪಾಂಯ್ ಪಡುನಕ್ಕೊ, ತೆಕಾ ಆರಾದನ್ ಕರುನಕ್ಕೊ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಮಿಯಾಚ್ ತುಜೊ ದೆವ್ ಸರ್ವೆಸ್ಪರ್ , ಮಾಕಾ ಪಾವುಚಿ ಹೊಲ್ಲಿ ಮರ್ಯಾದ್ ಮಿಯಾ ದುಸ್ರಾಕ್ನಿ ಪಾವುಕ್ ದಿಯ್ನಾ, ಮಾಕಾ ದ್ವೆಶ್ ಕರ್‍ತಲ್ಯಾಕ್ನಿ ಮಿಯಾ ಶಿಕ್ಷ್ಯಾ ದಿತಾ. ಬಾಬಾನಿ ಕರಲ್ಲ್ಯಾ ಚುಕೆಚೊ ಫಳ್ ಮಿಯಾ ತೆಂಚ್ಯಾ ಪೊರಾಂಚ್ಯಾ ವರ್‍ತಿ ತಿನ್ ಚಾರ್ ಟಕ್ಲ್ಯಾ ಪತರ್ಬಿ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EXO 20:5" /><verse number="6" style="v" sid="EXO 20:6" />ಖರೆ ಮಾಕಾ ಪ್ರೆಮ್ ಕರುನ್ ಮಾಜ್ಯಾ ಹುಕುಮಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಚಲ್ತಲ್ಯಾಕ್ನಿ, ಹಜಾರ್ ಟಕ್ಲ್ಯಾ ಪತರ್ ಬಿ ಮಾಜೆ ಪ್ರೆಮ್ ದಾಕ್ವುತಾ.<verse eid="EXO 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 20:7" />“ತಿಯಾ ತುಜ್ಯಾ ಸರ್ವೆಸ್ಪರಾಚೆ ನಾವ್ ಬುರ್ಸ್ಯಾ ಕಾಮಾಕ್ ವಾಪ್ರುನಕ್ಕೊ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಮಿಯಾ ಸರ್ವೆಸ್ಪರ್ ಮಾಜೆ ನಾವ್ ಬುರ್ಸ್ಯಾಕ್ ವಾಪರ್ತಲ್ಯಾಕ್ನಿ ಶಿಕ್ಷ್ಯಾ ದಿಯ್ನಸ್ತಾನಾ ಸೊಡಿನಾ”, <verse eid="EXO 20:7" /><verse number="8" style="v" sid="EXO 20:8" />“ತುಮ್ಕಾ ಯಾದ್ ರಾಂವ್ದಿತ್, ಸಬ್ಬಾತಾಚೊ ದಿಸ್ ದೆವಾಚೊ ದಿಸ್ ಮನುನ್ ಕಳ್ವುನ್ ಘೆವ್ನ್, ಪವಿತ್ರ್ ಮನುನ್ ಆಚರನ್ ಕರ್. <verse eid="EXO 20:8" /><verse number="9" style="v" sid="EXO 20:9" />ಸಾ ದಿಸಾ ಘೊಳುನ್, ತುಜೆ ಸಗ್ಳೆ ಕಾಮ್ ಕರುನ್ ಘೆ. <verse eid="EXO 20:9" /><verse number="10" style="v" sid="EXO 20:10" />ಖರೆ ಸಾತ್ವೆಚೊ ದಿಸ್ ತುಜ್ಯಾ ದೆವಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಮನುನ್ ನೆಮ್ಸುನ್ ಥವಲ್ಲೊ ಆರಾಮ್ ಕರ್ತಲೊ ದಿಸ್, ತ್ಯಾ ದಿಸಿ ತಿಯಾ ಕಸ್ಲೆ ಕಾಮ್ ಬಿ ಕರುಚೆ ನ್ಹಯ್, ತುಜಿ ಲೆಕಾ, ಲೆಕಿಯಾ ಅನಿ ಗಂಡ್, ಅನಿ ಹೆನ್ನ್ ಆಳಾ ಜನಾವರಾ ಅನಿ ತುಜ್ಯಾ ಗಾಂವಾತ್ ಹೊತ್ತಿ ದುಸ್ರ್ಯಾ ದೆಶ್ಯಾಚಿ ಲೊಕಾಬಿ ಕಸ್ಲೆ ಕಾಮ್ ಕರುಕ್ ನಾ. <verse eid="EXO 20:10" /><verse number="11" style="v" sid="EXO 20:11" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಮಿಯಾ ಸರ್ವೆಸ್ಪರಾನ್ ಸಾ ದಿಸಾ ಜಿಮಿನ್ ಮಳಬ್, ಸಮುಂದರಾ ಅನಿ ತ್ಯಾತುರ್ನಿ ಹೊತ್ತೆ ಸಗ್ಳೆಬಿ ರಚುನ್, ಸಾತ್ವ್ಯಾದಿಸಿ ಆರಾಮ್ ಘೆಟಲ್ಲೊ, ತಸೆ ಹೊವ್ನ್ ತೊ ದಿಸ್ ಮಿಯಾ ಸರ್ವೆಸ್ಪರಾಚೊ ಆರಾಮ್ ಕರ್ತಲೊ ದಿಸ್ ಕರುನ್ ಆಶಿರ್ವಾದ್ ದಿವ್ನ್ ಪವಿತ್ರ್ ಕರ್‍ಲೊ”. <verse eid="EXO 20:11" /><verse number="12" style="v" sid="EXO 20:12" />ತುಜ್ಯಾ ಬಾಯ್ ಬಾಬಾಕ್ನಿ ಮಾನ್ ದಿ, ತೆಚ್ಯಾ ವೈನಾ ತುಜೊ ದೆವ್ ಅನಿ ಸರ್ವೆಸ್ಪರ್ ಮಿಯಾ ತುಕಾ ದಿತಲ್ಯಾ ದೆಶ್ಯಾತ್ ತಿಯಾ ಲೈ ಯೆಳಾ ಪತರ್ ಝಿತ್ತೊ ರ್‍ಹಾತೆಯ್. <verse eid="EXO 20:12" /><verse number="13" style="v" sid="EXO 20:13" />ಖುನ್ ಕರುನಕ್ಕೊ, <verse eid="EXO 20:13" /><verse number="14" style="v" sid="EXO 20:14" />ತಿಯಾ ವ್ಯಭಿಚ್ಯಾರ್ ಕರುನಕ್ಕೊ, <verse eid="EXO 20:14" /><verse number="15" style="v" sid="EXO 20:15" />ತಿಯಾ ಚೊರು ನಕ್ಕೊ, <verse eid="EXO 20:15" /><verse number="16" style="v" sid="EXO 20:16" />ತಿಯಾ ಕೊನಾಕ್ಬಿ ವಿರೊಧ್ ಹೊವ್ನ್ ಝುಟಿ ಸಾಕ್ಷಿ ಸಾಂಗುನಕ್ಕೊ. <verse eid="EXO 20:16" /><verse number="17" style="v" sid="EXO 20:17" />“ತಿಯಾ ಕೊನಾಚ್ಯಾಬಿ ಘರಾಚಿ ಆಶ್ಯಾ ಕರುನಕ್ಕೊ, ನಾತರ್ ಕೊನಾಚ್ಯಾಬಿ ಬಾಯ್ಕೊಚಿ ಆಶ್ಯಾ ಕರುನಕ್ಕೊ, ಅನಿ ಕೊನಾಚ್ಯಾಬಿ ಆಳಾ ನಾತರ್ ಬೈಲಾ, ಗಾಡ್ವಾ ನಾತರ್ ಕೊನಾಚ್ಯಾಬಿ ಕಸ್ಲ್ಯಾಬಿ ವಸ್ತಾಚಿ ಆಶ್ಯಾ ಕರು ನಕ್ಕೊ”.<verse eid="EXO 20:17" /></para>
  <para style="s">ಲೊಕಾಂಚೆ ಭಿಂಯೆ</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18" />ಅನಿ ಸಗ್ಳ್ಯಾಲೊಕಾನಿ ಗುಡ್ಗುಡೊ, ಲಕ್ಲಕೊ ಅನಿ ಪೊವ್ಯಾಂಚೊ ಆವಾಜ್ ಆಯಿಕ್ಲ್ಯಾನಿ, ಅನಿ ಮಡ್ಡಿತ್ನಾ ಯೆವ್ಲಾಗಲ್ಲೊ ಡುಕೊಟ್ ಬಗ್ಲ್ಯಾನಿ, ಅನಿ ತೆ ಬಗುನ್ ಥರ್ಥರುನ್ಗೆತ್ ಧುರುಚ್ ಇಬೆರಾಲ್ಯಾನಿ. <verse eid="EXO 20:18" /><verse number="19" style="v" sid="EXO 20:19" />ಅನಿ ತೆನಿ ಮೊಯ್ಜೆಕ್, “ನಾತರ್ ತಿಯಾಚ್ ಅಮ್ಚೆಕ್ಡೆ ಬೊಲ್, ತನ್ನಾ ಅಮಿ ಆಯ್ಕುಕ್ ಹೊತಾ, ಖರೆ ಸರ್ವೆಸ್ಪರಾನ್ ಬೊಲ್ತಲೆ ನಕ್ಕೊ ಅಮಿ ಮರುನ್ ಜಾತಾಂವ್” ಮಟ್ಲ್ಯಾನಿ. <verse eid="EXO 20:19" /><verse number="20" style="v" sid="EXO 20:20" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಲೊಕಾಕ್ನಿ, “ಭಿಂವ್ ನಕಾಸಿ ಸರ್ವೆಸ್ಪರ್ ತುಮ್ಕಾ ಪರಿಕ್ಷಾ ಕರುಕ್ ಯೆಲಾ, ಅನಿ ತುಮ್ಚ್ಯಾ ಮನಾತ್ನಿ ದೆವಾಚಿ ಭಕ್ತಿ ರಾವ್ನ್, ತುಮಿ ಪಾಪ್ ಕರಿನಸ್ತಾನಾ ರ್‍ಹಾತ್ಯಾಸಿ”, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 20:20" /><verse number="21" style="v" sid="EXO 20:21" />ಮೊಯ್ಜೆ ಎಕ್ಲೊಚ್ ಮೊಡಾಚ್ಯಾ ಕಾಳ್ಕಾತ್ ದೆವ್ ಹೊತ್ತ್ಯಾಕ್ಡೆ ಜಗ್ಗೊಳ್ ಪಾವಲ್ಲೊ, ಅನಿ ಲೊಕಾ ಸಗ್ಳಿ ಧುರುಚ್ ಇಬೆ ಹೊತ್ತಿ.<verse eid="EXO 20:21" /></para>
  <para style="s">ಬಲಿ ಭೆಟ್ವುತಲ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ವಿಶಯಾತ್ ನೆಮಾ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, ತಿಯಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಮಾಜಿ ಹಿ ಗೊಸ್ಟ್ ಸಾಂಗ್, ಮಿಯಾ ಮಳ್ಬಾತ್ನಾ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ತಾ ಮನ್ತಲೆ ತುಮ್ಕಾ ಗೊತ್ತ್ ಹಾಯ್, <verse eid="EXO 20:22" /><verse number="23" style="v" sid="EXO 20:23" />ತಸೆ ಹೊವ್ನ್ ತುಮಿ ಮಾಜ್ಯಾ ಬದ್ಲಾಕ್ ಚಾಂದಿಚೊ ನಾತರ್ ಸೊನ್ಯಾಚೊ ದೆವ್ ಕರುನ್ ಘೆವ್ಕ್ ನಾ. <verse eid="EXO 20:23" /><verse number="24" style="v" sid="EXO 20:24" />ಅನಿ ಮಾಜ್ಯಾ ಸಾಟ್ನಿ ತುಮಿ ಮಾಟಿನ್ ಎಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ತಯಾರ್ ಕರುಚೆ, ತೆಜ್ಯಾವರ್‍ತಿ ಸಮಾಧಾನಾಚಿ ಬಲಿ ಅನಿ ಜಾಳ್ವುಕ್ ಜನಾವರಾಚಿ ಬಲಿ ಭೆಟ್ವುಚೆ, ಮಾಜೆ ನಾವ್ ತುಮ್ಚ್ಯಾ ಯಾದೆಕ್ ಯೆಯ್ ಸಾರ್ಕೆ ಕರ್‍ತಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಜಾಗ್ಯಾ ವೈನಿಬಿ ಮಿಯಾ ತುಮ್ಚ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆವ್ನ್ ತುಮ್ಕಾ ಆಶಿರ್ವಾದ್ ದಿತಾ. <verse eid="EXO 20:24" /><verse number="25" style="v" sid="EXO 20:25" />ತುಮಿ ಮಾಕಾ ಗುಂಡ್ಯಾಚೊ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ತಯಾರ್ ಕರ್ತಾನಾ, ಕಾತರಲ್ಯಾ ಗುಂಡ್ಯಾನಿ ಭಾಂದುನಕಾಸಿ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಉಳಿಯಾನಿ ಮಾರುನ್ ತೊ ಗುಂಡೊ ಅಶುದ್ದ್ ಹೊಲ್ಲೊ ರ್‍ಹಾತಾ. <verse eid="EXO 20:25" /><verse number="26" style="v" sid="EXO 20:26" />ಅನಿ ತುಮಿ ಬಲಿಭೆಟ್ವುಕ್ ಯೆತಾನಾ ಪೈರಿಯಾವೈನಿ ಚಡುನ್ ಯೆವ್ ನಕಾಸಿ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತುಮ್ಚೆ ನಾಗ್ಡೆ ಪಾನ್ ಮಾಕಾ ದಿಸ್ತಲೆ ನಕ್ಕೊ.<verse eid="EXO 20:26" /></para>
  <chapter eid="EXO 20" />
  <chapter number="21" style="c" sid="EXO 21" />
  <para style="s">ಗುಲಾಮಾಕ್ನಿ ಚಾಲ್ವುನ್ಗೆವ್ನ್ ಜಾತಲಿ ರಿತ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1" />ಅನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಹಿ ನಿಯಮಾ ದಿ; <verse eid="EXO 21:1" /><verse number="2" style="v" sid="EXO 21:2" />ತುಮ್ಚ್ಯಾತ್ ಕೊನ್ ತರ್ಬಿ ಎಕ್ಲೊ ಹೆಬ್ರೊವಾಕ್ ಗುಲಾಮ್ ಕರುನ್ ಇಕಾತ್ ಘೆಟಲ್ಲೊ ಹೊಲ್ಯಾರ್, ತೊ ಮಾನುಸ್ ಸಾ ವರಿಸ್ ಗುಲಾಮ್ ಹೊವ್ನ್ ಕಾಮ್ ಕರುನ್, ಸಾತ್ವ್ಯಾ ವರ್ಸಾತ್ ಕಾಯ್ಬಿ ದಿಯ್ ನಸ್ತಾನಾ ಸುಟ್ಕಾ ಹೊವ್ನ್ ಜಾವ್ಚೊ. <verse eid="EXO 21:2" /><verse number="3" style="v" sid="EXO 21:3" />ತೊ ಯೆತಾನಾ ಲಗಿನ್ ಹೊಯ್ ನಸ್ತಾನಾ ಯೆಲ್ಲೊ ಹೊಲ್ಯಾರ್, ಎಕ್ಲೊಚ್ ಜಾಂವ್ದಿತ್, ಅನಿ ಬಾಯ್ಕೊ ಘೆವ್ನ್ ಯೆಲ್ಲೊ ಹೊಲ್ಯಾರ್ ಬಾಯ್ಕೊಬಿ ತೆಜ್ಯಾ ವಾಂಗ್ಡಾ ಜಾಂವ್ದಿತ್. <verse eid="EXO 21:3" /><verse number="4" style="v" sid="EXO 21:4" />ಅನಿ ತೆಜ್ಯಾ ಯಜ್ಮಾನಾನ್ ತೆಕಾ ಲಗಿನ್ ಕರ್ಸುನ್ ತೆಕಾ ಪೊರಾ ಹೊಲ್ಲಿ ರಾಲ್ಯಾರ್, ತಿ ಪೊರಾ ಅನಿ ತಿ ಬಾಯ್ಕೊ ತ್ಯಾ ಯಜ್ಮಾನಾಚಿ ಆಸ್ತಿ ಹೊತಾತ್, ಅನಿ ತೊ ಗುಲಾಮ್ ಎಕ್ಲೊಚ್ ಜಾವ್ಚೊ. <verse eid="EXO 21:4" /><verse number="5" style="v" sid="EXO 21:5" />ಖರೆ ತ್ಯಾ ಗುಲಾಮಾನ್, “ಮಿಯಾ ಮಾಜ್ಯಾ ಯೆಜ್ಮಾನಾಕ್ ಅನಿ ಬಾಯ್ಕೊ ಪೊರಾಕ್ನಿ ಪ್ರೆಮ್ ಕರ್ತಾ, ತಸೆ ಹೊವ್ನ್, ಮಾಕಾ ಸೊಡುನ್ ಜಾವ್ಕ್ ಮನ್ ನಾ”, ಮನುನ್ ಘಟ್ ಮನಾನ್ ಸಾಂಗಲ್ಲೆ ಹೊಲ್ಯಾರ್, <verse eid="EXO 21:5" /><verse number="6" style="v" sid="EXO 21:6" />ತನ್ನಾ ತೆಜ್ಯಾ ಯಜ್ಮಾನಾನ್ ತೆಕಾ ದೆವಾಚ್ಯಾ ಇದ್ರಾಕ್ ಬಲ್ವುನ್ ಹಾನುನ್, ದಾರಾಚ್ಯಾ ನಾತರ್ ದಾರಾಚ್ಯಾ ಪಟ್ಟಿಯಾಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ಇಬೆ ಕರುನ್, ತೆಚಿ ಕಾನಾ ಟೊಪುಚಿ ತ್ಯಾ ದಿಸಾಕ್ನಾ ತೊ ಯಜ್ಮಾನಾಕ್ ಶಾಶ್ವತ್ ಗುಲಾಮ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ.<verse eid="EXO 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 21:7" />ಕೊನ್ ತರ್ಬಿ ಅಪ್ನಾಚ್ಯಾ ಲೆಕಿಕ್ ಗುಲಾಮ್ ಕರುನ್ ಇಕಲ್ಲೆ ಹೊಲ್ಯಾರ್, ತಿ ಘವ್ಮಾನ್ಸಾನ್ ಗುಲಾಮ್ ಗಿರಿತ್ನಾ ಸುಟ್ಕಾ ಹೊವ್ನ್ ಗೆಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಜಾವ್ಕ್ ನಾ. <verse eid="EXO 21:7" /><verse number="8" style="v" sid="EXO 21:8" />ಅಪ್ನಾಕ್ ಮನುನ್ ಗೊತ್ತ್ ಕರುನ್ಗೆಟಲ್ಲ್ಯಾ ಯಜ್ಮಾನಾಕ್ ತಿ ಮನಾಕ್ ಯೆವ್ಕ್ ನಸ್ಲ್ಯಾರ್, ತೆಜ್ಯಾಕ್ನಾ ಸುಟ್ಕಾ ಕರುನ್ ಘೆವ್ಕ್ ತಿಕಾ ಅವ್ಕಾಸ್ ದಿವ್ಚೆ, ತಿಕಾ ದುಸ್ರ್ಯಾ ಕ್ನಿ ಇಕಾತ್ ದಿವ್ಕ್ ತೆಕಾ ಅವ್ಕಾಸ್ ನಾ. <verse eid="EXO 21:8" /><verse number="9" style="v" sid="EXO 21:9" />ತೆನಿ ತಿಕಾ ಅಪ್ನಾಚ್ಯಾ ಲೆಕಾಕ್ ಗೊಸ್ಟ್ ಕರುನ್ಗೆಟಲ್ಲೆ ಹೊಲ್ಯಾರ್, ತಿಕಾ ಲೆಕಿ ಸಾರ್ಕೆ ಚಿಂತುಚೆ. <verse eid="EXO 21:9" /><verse number="10" style="v" sid="EXO 21:10" />ಯಜ್ಮಾನಾನ್ ಅನಿ ಎಕ್ಲಿಕ್ ಮಿಳ್ವುನ್ ಘೆಟಲ್ಲೆ ಹೊಲ್ಯಾರ್ಬಿ ಪೈಲೆಚಿಕ್ ಜೆವಾನ್, ಕಪ್ಡೆ ಅನಿ ಸಂಸಾರಾಚಿ ಹಕ್ಕಾ ಕಮ್ಮಿ ಕರುಚೆ ನ್ಹಯ್. <verse eid="EXO 21:10" /><verse number="11" style="v" sid="EXO 21:11" />ಹ್ಯಾ ತಿನಾತ್ಲೆ ಖಲೆಬಿ ಚಾಲ್ವಿನಸ್ತಾನಾ ಗೆಲ್ಯಾರ್, ತಿನೆ ಕಾಯ್ಬಿ ದಿಯ್ನಸ್ತಾನಾ ಸುಟ್ಕಾ ಹೊವ್ನ್ ಜಾವ್ಕ್ ಹೊತಾ.<verse eid="EXO 21:11" /></para>
  <para style="s">ತರಾಸ್ ದಿತಲ್ಯಾಂಚ್ಯಾ ವಿಶಯಾತ್ ನೆಮಾ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12" />ಕೊನಿ ತರ್ಬಿ ಮಾನ್ಸಾಕ್ ಮಾರುನ್ ಜಿವ್ ಕಾಡಲ್ಲ್ಯಾಕ್ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ಹೊವ್ಚಿ. <verse eid="EXO 21:12" /><verse number="13" style="v" sid="EXO 21:13" />ಖರೆ ಜಿವ್ ಕಾಡುಚೆ ಮನ್ತಲಿ ಯವ್ಜನ್ ನಸ್ತಾನಾ, ದೆವಾಚ್ಯಾ ಇಚ್ಚ್ಯಾ ಸಾರ್ಕೆ ಜಿವ್ ಕಾಡಲ್ಲೆ ಹೊಲ್ಯಾರ್, ತ್ಯಾ ಮರ್ನಾಕ್ ಕಾರನ್ ಹೊಲ್ಲೊ ನಿಪುಕ್ ಮನುನ್ ವಳಕ್ ಕರುನ್ಗೆಟಲ್ಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಪಳುನ್ ಜಾವ್ಕ್ ಹೊತಾ. <verse eid="EXO 21:13" /><verse number="14" style="v" sid="EXO 21:14" />ಅನಿ ಜಿವ್ ಕಾಡುಚೆ ಮನ್ತಲ್ಯಾ ಉದ್ದೆಶಾನ್ ದುಸ್ರ್ಯಾ ಎಕ್ಲ್ಯಾಕ್ ಪಶ್ವುನ್ ಜಿವ್ ಕಾಡಲ್ಲೊ ಹೊಲ್ಯಾರ್, ತೊ ಮಾಜ್ಯಾ ಬಲಿಭೆಟ್ವುತಲ್ಯಾ ಜಾಗ್ಯಾರ್ ರಾಲ್ಯಾರ್ಬಿ ತೆಕಾ ವಡುನ್ ಹಾನುನ್ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ದಿವ್ಚೆ. <verse eid="EXO 21:14" /><verse number="15" style="v" sid="EXO 21:15" />ಕೊನಿ ತರ್ಬಿ ಅಪ್ನಾಚ್ಯಾ ಬಾಬಾಕ್ ನಾತರ್ ಬಾಯ್ಕ್ ಮಾರಲ್ಲ್ಯಾಕ್ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ಹೊವ್ಚಿ. <verse eid="EXO 21:15" /><verse number="16" style="v" sid="EXO 21:16" />ಎಕ್ಲ್ಯಾನ್ ಅನಿ ಎಕ್ಲ್ಯಾಕ್ ಚೊರುನ್ ನ್ಹೆವ್ನ್ ಇಕ್ಲ್ಯಾರ್ ನಾತರ್ ಅಪ್ನಾಕ್ಡೆಚ್ ಥವ್ನ್ ಘೆಟ್ಲ್ಯಾರ್ ತಸ್ಲ್ಯಾಕ್ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ಹೊವ್ಚಿ. <verse eid="EXO 21:16" /><verse number="17" style="v" sid="EXO 21:17" />ಕೊನ್ ತರ್ಬಿ ಬಾಬಾಕ್ ನಾತರ್ ಬಾಯ್ಕ್ ಶರಾಪ್ಲ್ಯಾರ್, ತೆಕಾ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ಹೊವ್ಚಿ. <verse eid="EXO 21:17" /><verse number="18" style="v" sid="EXO 21:18" />ದೊಗೆ ಝಗ್ಡೊ ಕರಿತ್ ರ್‍ಹಾತಾನಾ, ಎಕ್ಲ್ಯಾನ್ ಅನಿ ಎಕ್ಲ್ಯಾಕ್ ಗುಂಡ್ಯಾನ್ ನಾತರ್ ಮುಟ್ಕ್ಯಾನ್ ಮಾರುನ್ ತೊ ಮರಿನಸ್ತಾನಾ, ದುಕ್ಕಾ ಹೊಲ್ಯಾರ್ಬಿ ಉಲ್ಲೊ ಎಳ್ ಹಾತ್ರಾನಾತ್ ರಾಯ್ಲ್, <verse eid="EXO 21:18" /><verse number="19" style="v" sid="EXO 21:19" />ಅನಿ ಮಾನಾ ಉಟುನ್ ದಾಂಡೊ ಧರುನ್ಗೆವ್ನ್ ಚಲ್ತಾ ಹೊವ್ಕ್ ಫಿರೆ, ಅಸ್ಲ್ಯಾ ಎಳಾರ್ ಮಾರಲ್ಲ್ಯಾಕ್ ಶಿಕ್ಷ್ಯಾ ಹೊತಲಿ ನಕ್ಕೊ, ಖರೆ ಮಾರ್ ಬಸಲ್ಲ್ಯಾ ಮಾನ್ಸಾನ್ ಕಾಮ್ ಕರುಕ್ ಹೊಯ್ ನಸ್ತಾನಾ ರಾಲ್ಯಾರ್, ತೆಕಾ ಪಾಜೆ ತವ್ಡೆ ಪೈಸೆ ದಿವ್ಚೆ ಅನಿ ತೊ ಫುರಾ ಗುನ್ ಹೊಯ್ ಪತರ್ಬಿ ತೆಕಾ ಬಗುನ್ಗೆವ್ಚೆ. <verse eid="EXO 21:19" /><verse number="20" style="v" sid="EXO 21:20" />ಎಕ್ಲ್ಯಾನ್ ಅಪ್ನಾಚ್ಯಾ ಗಂಡ್ ಆಳಾಕ್ ನಾತರ್, ಹೆನ್ನ್ ಆಳಾಕ್ ದಾಂಡ್ಯಾನ್ ಮಾರುನ್ ತೊ ಥೈಚ್ ಮರುನ್ ಗೆಲ್ಯಾರ್, ತೆಕಾ ಸಮಾ ಶಿಕ್ಷ್ಯಾ ದಿವ್ಚೆ. <verse eid="EXO 21:20" /><verse number="21" style="v" sid="EXO 21:21" />ಅನಿ ತೊ ಆಳ್ ದೊನ್ ತಿನ್ ದಿಸ್ ಪತರ್ ಝಿತ್ತೊ ರಾಲ್ಯಾರ್, ತ್ಯಾ ಯಜ್ಮಾನಾಕ್ ಶಿಕ್ಷ್ಯಾ ದಿತಲಿ ನಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಆಳಾ ತೆಚಿಚ್ ಆಸ್ತಿ ಹೊವ್ನ್ ರ್‍ಹಾತಾತ್. <verse eid="EXO 21:21" /><verse number="22" style="v" sid="EXO 21:22" />ಲೊಕಾನಿ ಝಗ್ಡೆ ಕರ್ತಾನಾ, ಗರ್‍ವಾರ್ ಬಾಯ್ಕೊ ಮಾನ್ಸಿಕ್ ಮಾರ್ ಲಾಗ್ಲ್ಯಾರ್, ಅನಿ ತಿಕಾ ರಗಾತ್ ಜಾವ್ನ್ ಅನಿ ಕಾಯ್ಬಿ ತರಾಸ್ ಹೊವ್ಕ್ ನಸ್ಲ್ಯಾರ್, ತಿಚ್ಯಾ ಘವಾನ್ ನ್ಯಾಯ್ ನಿರ್ನಯ್ ಕರ್‍ತಲ್ಯಾಚ್ಯಾ ಒಪ್ಕಿವೈನಾ ಕವ್ಡೆ ಪೈಸೆ ಸಾಂಗ್ತಾ ತವ್ಡೆ ಮಾರಲ್ಲ್ಯಾ ಮಾನ್ಸಾಕ್ನಾ ಘೆವ್ಚೆ. <verse eid="EXO 21:22" /><verse number="23" style="v" sid="EXO 21:23" />ಅನಿ ದುಸ್ರೊ ತರಾಸ್ ಹೊಲ್ಲೊ ರಾಲ್ಯಾರ್ ಜಿವಾಕ್ ಬದಲ್ ಜಿವ್, <verse eid="EXO 21:23" /><verse number="24" style="v" sid="EXO 21:24" />ಡೊಳ್ಯಾಕ್ ಬದಲ್ ಡೊಳೊ, ದಾತಾಕ್ ಬದಲ್ ದಾತ್, ಹಾತಿಕ್ ಬದಲ್ ಹಾತ್, ಪಾಂಯಾಕ್ ಬದಲ್ ಪಾಂಯ್, <verse eid="EXO 21:24" /><verse number="25" style="v" sid="EXO 21:25" />ಬರೊ ವಡಲ್ಲೊ ರಾಲ್ಯಾರ್ ತೆಜ್ಯಾ ಬದ್ಲಾಕ್ ಬರೊ, ದುಕ್ಕ್ ಕರಲ್ಲೆ ರಾಲ್ಯಾರ್ ತೆಜ್ಯಾ ಬದ್ಲಾಕ್ ದುಕ್ಕ್, ಮಾರಾಕ್ ಪರ್‍ತುನ್ ಮಾರ್ ಅಸೆಚ್ ಹರ್ ಎಕಾಕ್ಬಿ ಪರ್‍ತುನ್ ಶಿಕ್ಷ್ಯಾ ಹೊವ್ಚಿ. <verse eid="EXO 21:25" /><verse number="26" style="v" sid="EXO 21:26" />ಕೊನ್ ತರ್ ಎಕ್ಲ್ಯಾನ್ ಅಪ್ನಾಚ್ಯಾ ಗಂಡ್ ಗುಲಾಮಾಕ್ ನಾತರ್ ಹೆನ್ನ್ ಗುಲಾಮಾಚ್ಯಾ ಡೊಳ್ಯಾಕ್ ಮಾರುನ್ ನಾಶ್ ಕರಲ್ಲೆ ಹೊಲ್ಯಾರ್, ತ್ಯಾ ಡೊಳ್ಯಾಚ್ಯಾ ಬದ್ಲಾಕ್ ತೆಕಾ ಗುಲಾಮ್ ಗಿರಿತ್ನಾ ಸುಟ್ಕಾ ಕರುಚೆ. <verse eid="EXO 21:26" /><verse number="27" style="v" sid="EXO 21:27" />ಗುಲಾಮಾಚ್ಯಾ ದಾತಾಕ್ನಿ ಮಾರುನ್ ದಾತ್ ಕಾಡಲ್ಲೆ ಹೊಲ್ಯಾರ್, ತ್ಯಾ ಯಜ್ಮಾನಾನ್ ಗುಲಾಮಾಕ್ ಸುಟ್ಕಾ ಕರುಚೆ.<verse eid="EXO 21:27" /></para>
  <para style="s">ಯಜ್ಮಾನಾಂಚಿ ಜವಾಬ್ದಾರಿಯಾ</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28" />ಘವ್ಮಾನ್ಸಾಕ್ ನಾತರ್ ಬಾಯ್ಕೊ ಮಾನ್ಸಿಕ್ ಬೈಲಾನ್ ಮಾರುನ್ ಜಿವ್ ಕಾಡ್ಲ್ಯಾರ್, ತ್ಯಾ ಬೈಲಾಕ್ ಗುಂಡ್ಯಾನ್ ಮಾರುನ್ ಜಿವ್ ಕಾಡುಚೆ, ಅನಿ ತ್ಯಾ ಬೈಲಾಚೆ ಮಾಂಸ್ ಖಾವ್ಚೆ ನ್ಹಯ್, ತ್ಯಾ ಬೈಲಾಚೊ ಯೆಜ್ಮಾನ್ ಚುಕಿದಾರ್ ಹೊಯ್ನಾ. <verse eid="EXO 21:28" /><verse number="29" style="v" sid="EXO 21:29" />ಖರೆ ತೊ ಬೈಲ್ ಪೈಲೆಚ್ಯಾನ್ಬಿ ಮಾರುಕ್ ಯೆತಲೊ ಮನುನ್ ಗೊತ್ತ್ ರಾವ್ನ್, ತೆಜ್ಯಾ ವಿಶಯಾತ್ ಯೆಜ್ಮಾನಾಕ್ ಹುಶಾರ್ಕಿ ದಿಲ್ಲೆ ರಾಲ್ಯಾರ್ಬಿ, ತೆನಿ ತ್ಯಾ ಬೈಲಾಕ್ ಭಾಂದುನ್ ಥವ್ಕ್ ನಸಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ತ್ಯಾ ಬೈಲಾನ್ ಘವ್ಮಾನ್ಸಾಕ್ ನಾತರ್ ಬಾಯ್ಕೊಮಾನ್ಸಿಕ್ ಮಾರುನ್ ಜಿವ್ ಕಾಡಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ತ್ಯಾ ಬೈಲಾಕ್ ಮಾರುನ್ ಜಿವ್ ಕಾಡುಚೆ, ಅನಿ ತೆಜೊ ಯಜ್ಮಾನ್ ಬಿ ಮರ್ನಾಚ್ಯಾ ಶಿಕ್ಷ್ಯಾಕ್ ಗುರಿ ಹೊವ್ಚೆ. <verse eid="EXO 21:29" /><verse number="30" style="v" sid="EXO 21:30" />ಖರೆ ತ್ಯಾ ಯಜ್ಮಾನಾನ್ ಅಪ್ನಾಚೊ ಜಿವ್ ಹುರ್ವುನ್ಗೆವ್ಕ್ ಪೈಸೆ ದಿವ್ಚೆ ಮನುನ್ ಚಿಂತ್ಲ್ಯಾರ್, ನೆಮಲ್ಲೆ ತವ್ಡೆ ಪೈಸೆ ದಿವ್ನ್ ಅಪ್ನಾಚೊ ಜಿವ್ ಹುರ್ವುನ್ ಘೆವ್ಕ್ ಹೊತಾ. <verse eid="EXO 21:30" /><verse number="31" style="v" sid="EXO 21:31" />ತ್ಯಾ ಬೈಲಾನ್ ಮಾರುನ್ ಮರಲ್ಲೊ ಝಿಲ್ಗೊ ನಾತರ್ ಚೆಡು ಹೊಲ್ಯಾರ್ಬಿ ಹ್ಯಾಚ್ ನೆಮಾ ಸಾರ್ಕೆ ನಿರ್ದಾರ್ ಕರುಚೆ. <verse eid="EXO 21:31" /><verse number="32" style="v" sid="EXO 21:32" />ಅನಿ ಮಾರುನ್ಗೆವ್ನ್ ಮರಲ್ಲೊ ಗುಲಾಮ್ ಹೊಲ್ಯಾರ್, ತೆಂಚ್ಯಾ ಯಜ್ಮಾನಾಕ್ ತಿಸ್ ಚಾಂದಿಚೆ ಪೈಸೆ ದಿವ್ಚೆ, ಅನಿ ತ್ಯಾ ಬೈಲಾಕ್ ಗುಂಡೆ ಮಾರುನ್ ಜಿವ್ ಕಾಡುಚೆ. <verse eid="EXO 21:32" /><verse number="33" style="v" sid="EXO 21:33" />ಕೊನ್ ತರ್ ಎಕ್ಲ್ಯಾನ್ ಖಡ್ಡೊ ಕಾಡುನ್ ಥವ್ನ್, ತೊ ಧಾಪುಕ್ ನಸಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ಅನಿ ಎಕ್ಲ್ಯಾಚೊ ಬೈಲ್ ನಾತರ್ ಗಾಡಾವ್ ತ್ಯಾತುರ್ ಪಡುನ್ ಮರ್ಲ್ಯಾರ್, <verse eid="EXO 21:33" /><verse number="34" style="v" sid="EXO 21:34" />ತೊ ಖಡ್ಡೊ ಕಾಡಸಲ್ಲ್ಯಾನ್ ಥೈ ಹೊಲ್ಲ್ಯಾ ಲುಕ್ಷಾನಾಕ್ ಬದ್ಲಾಚೆ ದಿವ್ಚೆ, ತ್ಯಾ ಜನಾವರಾಚ್ಯಾ ಯೆಜ್ಮಾನಾಕ್ ತೆಜೊ ಪೈಸೊ ದಿವ್ಚೆ, ಅನಿ ತ್ಯಾ ಮರಲ್ಲ್ಯಾ ಜನಾವರಾಕ್ ಅಪ್ನಿಚ್ ಘೆವ್ಕ್ ಹೊತಾ. <verse eid="EXO 21:34" /><verse number="35" style="v" sid="EXO 21:35" />ಎಕ್ಲ್ಯಾಚ್ಯಾ ಬೈಲಾನ್ ಅನಿ ಎಕ್ಲ್ಯಾಚ್ಯಾ ಬೈಲಾಕ್ ಮಾರುನ್ ಜಿವ್ ಕಾಡಲ್ಲೆ ಹೊಲ್ಯಾರ್, ಝಿತ್ತೊ ಹೊತ್ತ್ಯಾ ಬೈಲಾಕ್ ಸಮಾಧಾನಾನ್ ವಾಟೆ ಕರುನ್ಗೆವ್ಚೆ. <verse eid="EXO 21:35" /><verse number="36" style="v" sid="EXO 21:36" />ಖರೆ ತೊ ಬೈಲ್ ಮಾರುಕ್ ಯೆತಲೊ ಮನುನ್ ಅದ್ದಿಚ್ ಗೊತ್ತ್ ರಾಲ್ಯಾರ್ಬಿ, ತೆಕಾ ಭಾಂದುನ್ ಥವ್ಕ್ ನಸಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತೆನಿ ಬೈಲಾಕ್ ಬದಲ್ ಬೈಲ್ ದಿವ್ಚೆ, ಅನಿ ಮರಲ್ಲ್ಯಾ ಬೈಲಾಕ್ ಅಪ್ನಿಚ್ ಘೆವ್ಚೆ.<verse eid="EXO 21:36" /></para>
  <chapter eid="EXO 21" />
  <chapter number="22" style="c" sid="EXO 22" />
  <para style="s">ಬದ್ಲಿ ದಿತಲಿ ವಿಶಯಾತ್ ನೆಮಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1" />ಕೊನ್ ತರ್ಬಿ ಎಕ್ಲ್ಯಾನ್ ಬಕ್ರೆನಾತರ್ ಬೈಲ್ ಚೊರುನ್ ಕಾಪ್ಲ್ಯಾರ್ ನಾತರ್ ಇಕ್ಲ್ಯಾರ್, ತೆನಿ ಎಕ್ ಬೈಲಾಕ್ ಬದ್ಲಿ ಪಾಂಚ್ ಬೈಲಾ ಅನಿ ಎಕ್ ಬಕ್ರ್ಯಾಕ್ ಬದ್ಲಿ ಚಾರ್ ಬಕ್ರಿಯಾ ದಿವ್ಚೆ. <verse eid="EXO 22:1" /><verse number="2" style="v" sid="EXO 22:2" />ಚೊರ್ ಚೊರಿ ಕರುನ್ಗೆತ್ ರ್‍ಹಾತಾನಾ ಗಾವ್ನ್ ಪಡುನ್ ಮರುನ್ಗೆಲ್ಯಾರ್, ತೆ ಮಾನ್ಸಾಚೊ ಹಾತ್ತೊ ಮನುಕ್ ಹೊಯ್ನಾ. <verse eid="EXO 22:2" /><verse number="3" style="v" sid="EXO 22:3" />ದಿಸ್ ಉಗಾವ್ಲ್ಯಾ ಮಾನಾ ಕೊನ್ ತರಿಬಿ ಚೊರಾಕ್ ರಗ್ತಾಚೊ ದೊಶ್ ಹೊಲ್ಯಾರ್ ತೆ ಮಾನ್ಸಾಚೊ ಹತ್ತೊ ಕರಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್, ಚೊರಾನ್ ಅಪ್ನಿ ಚೊರಲ್ಲೆ ಸಗ್ಳೆಬಿ ದಿವ್ಚೆ, ಅನಿ ತೆಜ್ಯಾಕ್ಡೆ ಕಾಯ್ಬಿ ದಿವ್ಕ್ ನಾ ಹೊಲ್ಯಾರ್ ಚೊರಿ ಕರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತೆಕಾ ಗುಲಾಮ್ ಕರುನ್ ಇಕುಚೆ. <verse eid="EXO 22:3" /><verse number="4" style="v" sid="EXO 22:4" />ಚೊರಾನ್ ಚೊರಲ್ಲೊ ಬೈಲ್ ನಾತರ್ ಗಾಡಾವ್ ನಾತರ್ ಶೆಳಿ ಹೊವ್ನ್ ರಾಲ್ಯಾರ್, ಅನಿ ತೆ ಝಿತ್ತೆಚ್ ತೆಂಚ್ಯಾಕ್ಡೆ ಗಾವ್ಲ್ಯಾರ್, ತೆನಿ ದೊನ್ ಪಟ್ಟ್ ಬದ್ಲಿ ದಿವ್ಚೆ. <verse eid="EXO 22:4" /><verse number="5" style="v" sid="EXO 22:5" />ಕೊನ್ ತರ್ಬಿ ಎಕ್ಲ್ಯಾನ್ ಅಪ್ನಾಚ್ಯಾ ಸೆತಾಕ್ ನಾತರ್, ದರಾಕ್ಷಿಚ್ಯಾ ಮ್ಹಳ್ಯಾತ್ ಬೈಲಾಕ್ ಚಾರ್ವುನ್ ತೆ ದುಶ್ರ್ಯಾಚ್ಯಾ ಸೆತಾಕ್ ಜಾವ್ನ್ ಚರ್ವುಲ್ಯಾರ್, ಅಪ್ನಾಚ್ಯಾ ಸೆತಾಚಿ ಬರಿ ಫಳಾ ನಾತರ್ ಪಿಕಾ ಬದ್ಲಿಕ್ ದಿವ್ಚೆ. <verse eid="EXO 22:5" /><verse number="6" style="v" sid="EXO 22:6" />ಕೊನ್ ತರ್ಬಿ ಎಕ್ಲ್ಯಾನ್ ಲಾವಲ್ಲಿ ಆಗ್ ಅಕಸ್ಮಾತ್ ಕಾಟ್ಯಾಂಚ್ಯಾ ಝಿಳಿಕ್ ಲಾಗುನ್ ಅನಿ ಎಕ್ಲ್ಯಾಚ್ಯಾ ಪಿಕಾಕ್ ನಾತರ್ ಸೆತಾಕ್ ಲಾಗುನ್ ಜಳುನ್ ಗೆಲ್ಯಾರ್, ತೆಚಿ ಬದ್ಲಿ ಆಗ್ ಲಾವಲ್ಯಾನ್ ದಿವ್ಚೆ. <verse eid="EXO 22:6" /><verse number="7" style="v" sid="EXO 22:7" />ಕೊನ್ ತರ್ಬಿ ಎಕ್ಲ್ಯಾನ್ ಅನಿ ಎಕ್ಲ್ಯಾಕ್ಡೆ ಬರೆ ಕರುನ್ ಥವ್ಕ್ ಪೈಸೆ ನಾತರ್ ವಸ್ತಾ ಕಾಯ್ತರ್ಬಿ ದಿಲ್ಯಾರ್, ತೆ ತೆಂಚ್ಯಾ ಘರ್‍ಹಾತ್ ಚೊರಿ ಹೊಲ್ಯಾರ್, ತೊ ಚೊರ್ ಗಾವ್ನ್ ಪಡ್ಲ್ಯಾರ್ ದೊನ್ ಪಟ್ಟ್ ಬದ್ಲಿ ದಿವ್ಚೆ. <verse eid="EXO 22:7" /><verse number="8" style="v" sid="EXO 22:8" />ಅನಿ ಚೊರ್ ಗಾವ್ಕ್ ನಸ್ಲ್ಯಾರ್, ತ್ಯಾ ಘರಾಚೊ ಯೆಜ್ಮಾನ್ ಅಪ್ನಿ ಚೊರಿ ಕರುಕ್ ನಾ ಮನುನ್ ದಾಕ್ವು ಸಾಟ್ನಿ ದೆವಾಚ್ಯಾ ಇದ್ರಾಕ್ ಆರಾದನ್ ಕರ್‍ತಲ್ಯಾ ಜಾಗ್ಯಾರ್ ದಾಕ್ವುನ್ ಘೆವ್ಚೊ. <verse eid="EXO 22:8" /><verse number="9" style="v" sid="EXO 22:9" />ಬೈಲ್, ಗಾಡಾವ್ ನಾತರ್ ಕಪ್ಡೆ ಕಾಯ್ ಹೊಲ್ಯಾರ್ಬಿ ನಾತರ್ ದುಸ್ರೆ ಸಾಮಾನ್ ಕಳ್ದುನ್ ಘೆಟಲ್ಲೆ ರಾಲ್ಯಾರ್, ತೆಜ್ಯಾ ವಿಶಯಾತ್ ಪಸ್ಲೊ ಮನ್ತಲೊ ಅನ್ಮಾನ್ ಹೊಲ್ಲೊ ರಾಲ್ಯಾರ್, ಅನಿ ದೊನ್ ಮಾನ್ಸಾ ತೆ ಮಾಜೆ ಮನುನ್ ಝಗ್ಡಿತ್ ರ್‍ಹಾತಾನಾ, ತೊ ಝಗ್ಡೊ ದೆವಾಚ್ಯಾ ಇದ್ರಾಕ್ ಹಾನುಚೆ, ಸರ್ವೆಸ್ಪರಾಕ್ನಾ ಕೊನ್ ಪಸ್ವಲ್ಲೆ ಮನುನ್ ನಿರ್ದಾರ್ ಯೆತಾ ತೆನಿ ದೊನ್ ಪಟ್ಟ್ ಬದ್ಲಿ ದಿವ್ಚೆ. <verse eid="EXO 22:9" /><verse number="10" style="v" sid="EXO 22:10" />ಎಕ್ಲ್ಯಾನ್ ಅನಿ ಎಕ್ಲ್ಯಾಚೆ ಬಕ್ರೆ, ಗಾಡಾವ್, ಬೈಲ್ ನಾತರ್ ದುಸ್ರೆ ಕಸ್ಲೆಬಿ ಜನಾವರ್ ಹೊಂವ್ದಿತ್ ಅಪ್ನಾಕ್ಡೆ ಬರೆಕರುನ್ ಥವ್ನ್ ಘೆವ್ಕ್ ಒಪ್ಸುನ್ ಮಾನಾ ತೆ ಮರ್ಲ್ಯಾರ್ ನಾತರ್ ತೆಕಾ ದುಕ್ಕ್ ಕರ್ಲ್ಯಾರ್ ನಾತರ್ ಕೊನಾಕ್ಬಿ ಗೊತ್ತ್ ನಸ್ತಾನಾ ಚೊರಿ ಹೊಲ್ಯಾರ್, <verse eid="EXO 22:10" /><verse number="11" style="v" sid="EXO 22:11" />ತ್ಯಾ ಮಾನ್ಸಾನ್ ತೆಜ್ಯಾ ವಿಶಯಾತ್ ಪಸ್ವುಕ್ನಾ ಮನುನ್ ದಾಕ್ವು ಸಾಟ್ನಿ ಸರ್ವೆಸ್ಪರಾ ವರ್‍ತಿ ಆನ್ ಘಾಲುಚೆ, ಅನಿ ತ್ಯಾ ಜನಾವರಾಚ್ಯಾ ಯೆಜ್ಮಾನಾಕ್ ತೆ ಆನ್ ವಿಶ್ವಾಸಾಕ್ ಯೆವ್ಚೆ, ತನ್ನಾ ಆನ್ ಕರಲ್ಲ್ಯಾನ್ ಬದ್ಲಿ ದಿತಲೆ ರ್‍ಹಾಯ್ನಾ. <verse eid="EXO 22:11" /><verse number="12" style="v" sid="EXO 22:12" />ಖರೆ ಜನಾವರ್ ಚೊರಿ ಹೊಲ್ಲೆ ರಾಲ್ಯಾರ್, ತ್ಯಾ ಮಾನ್ಸಾನ್ ಯೆಜ್ಮಾನಾಕ್ ಬದ್ಲಿ ದಿವ್ಚೆ. <verse eid="EXO 22:12" /><verse number="13" style="v" sid="EXO 22:13" />ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಜನಾವರಾನ್ ತೆ ಜಿವ್ ಕಾಡಲ್ಲೆ ಹೊಲ್ಯಾರ್, ತೆಜೊ ಎಕ್ ತರ್ಬಿ ಭಾಗ್ ಸಾಕ್ಷಿಕ್ ದಾಕ್ವುಚೆ, ಡಂಗ್ಳಿತ್ಲ್ಯಾ ಜನಾವರಾನ್ ಜಿವ್ ಕಾಡಲ್ಲ್ಯಾಕ್ ಬದ್ಲಿ ದಿತಲೆ ರ್‍ಹಾಯ್ನಾ. <verse eid="EXO 22:13" /><verse number="14" style="v" sid="EXO 22:14" />ಎಕ್ಲ್ಯಾಚೆ ಜನಾವರ್ ಅನಿ ಎಕ್ಲ್ಯಾನ್ ಉಲ್ಲ್ಯಾ ದಿಸಾಂಚ್ಯಾ ಸಾಟ್ನಿ ರಿನಾನ್ ಘೆಟಲ್ಲೆ ರಾಲ್ಯಾರ್, ತೆ ಜನಾವರ್ ಅಪ್ನಾಚೊ ಯೆಜ್ಮಾನ್ ಜಗ್ಗೊಳ್ ನತ್ತ್ಯಾ ತನ್ನಾ ದುಕ್ ಕರುನ್ಗೆಟ್ಲ್ಯಾರ್, ನಾತರ್ ಮರುನ್ ಗೆಲ್ಯಾರ್, ರಿನ್ ಘೆಟಲ್ಲ್ಯಾನ್ ಬದ್ಲಿ ದಿವ್ಕ್ ಪಾಜೆ. <verse eid="EXO 22:14" /><verse number="15" style="v" sid="EXO 22:15" />ಅನಿ ತೆಜೊ ಯೆಜ್ಮಾನ್ ಜಗ್ಗೊಳ್ ಹೊತ್ತ್ಯಾ ತನ್ನಾ ಕಾಯ್ತರ್ಬಿ ಹೊಲ್ಯಾರ್, ತೆಕಾ ಬದ್ಲಿ ದಿತಲೆ ನಕ್ಕೊ, ತೆ ಭಾಡ್ಯಾಕ್ ಘೆಟಲ್ಲೆ ಹೊಲ್ಯಾರ್ ತೆಕಾ ಹೊಲ್ಲೆ ಲುಕ್ಷಾನ್ ತೆಜ್ಯಾ ಭಾಡ್ಯಾ ವಾಂಗ್ಡಾಚ್ ಮ್ಹೆಜುನ್ ಹೊವ್ಚೆ.<verse eid="EXO 22:15" /></para>
  <para style="s">ಲೊಕಾಂಚ್ಯಾ ವಿಶಯಾತ್ ಜವಾಬ್ದಾರಿಯಾ</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16" />ಇಡೆ ಹೊವ್ಕ್ ನಸಲ್ಲ್ಯಾ ಚೆಡ್ವಾಕ್ ಕೊನ್ ತರ್ಬಿ ಎಕ್ಲ್ಯಾನ್ ಟಕ್ಲೆ ಹಾಳ್ ಕರುನ್, ತಿಚೆಕ್ನಾ ನಿಜ್ಲ್ಯಾರ್ ತಿಚ್ಯಾ ಮರ್ಯಾದಿ ಸಾಟ್ನಿ ದಿತಲೆ ಮೊಹರ್ ಭರುನ್ ತಿಕಾ ಲಗಿನ್ ಕರುನ್ಗೆವ್ಚೆ. <verse eid="EXO 22:16" /><verse number="17" style="v" sid="EXO 22:17" />ಖರೆ ತಿಜೊ ಬಾಬಾ ತಿಕಾ ಲಗಿನ್ ಕರುನ್ ದಿವ್ಕ್ ಒಪ್ಪಿ ನಸ್ಲ್ಯಾರ್, ತೆನಿ ತೊ ಮರ್ಯಾದಿಕ್ ಸಾಟ್ನಿ ದಿತಲೆ ಮೊಹರ್ ದಿವ್ಕುಚ್ ಪಾಜೆ. <verse eid="EXO 22:17" /><verse number="18" style="v" sid="EXO 22:18" />ಮೊಡಿ ಕಾರ್ನಿಕ್ ಝಿತ್ತೆ ರಾವ್ಕ್ ಸೊಡುಚೆ ನ್ಹಯ್, <verse eid="EXO 22:18" /><verse number="19" style="v" sid="EXO 22:19" />ಜನಾವರಾಕ್ನಾ ಮಿಳಲ್ಲ್ಯಾಕ್ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ಹೊವ್ಚಿ. <verse eid="EXO 22:19" /><verse number="20" style="v" sid="EXO 22:20" />ಸರ್ವೆಸ್ಪರಾಕ್ ಸೊಡುನ್ ದುಸ್ರ್ಯಾ ದೆವಾಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ನಾಶ್ ಹೊವ್ಕ್ ಪಾಜೆ. <verse eid="EXO 22:20" /><verse number="21" style="v" sid="EXO 22:21" />ದುಸ್ರ್ಯಾ ದೆಶಾಚ್ಯಾಕ್ನಿ ಅನ್ಯಾಯ್ ಕರುಚೆ ನ್ಹಯ್, ತೆಕಾ ತರಾಸ್ ದಿವ್ಚೆ ನ್ಹಯ್, ತುಮಿಬಿ ಇಜಿಪ್ತಾತ್ ದುಸ್ರ್ಯಾ ದೆಶಾಚೆ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾಸಿ ನ್ಹಯ್. <verse eid="EXO 22:21" /><verse number="22" style="v" sid="EXO 22:22" />ಘವ್ಮರಲ್ಲಿಕ್ ನಾತರ್, ಕೊನ್ ಬಿ ಗತಿ ನತ್ತ್ಯಾ ಪೊರಾಕ್ನಿ ತರಾಸ್ ದಿವ್ಚೆ ನ್ಹಯ್. <verse eid="EXO 22:22" /><verse number="23" style="v" sid="EXO 22:23" />ತುಮಿ ಅಸ್ಲ್ಯಾಕ್ನಿ ತರಾಸ್ ದಿಲ್ಲೆ ಹೊಲ್ಯಾರ್ ತೆನಿ ಮಾಜೆಕ್ಡೆ ರಡ್ತಾತ್, ಮಿಯಾ ತೆಂಚ್ಯಾ ರಡ್ನ್ಯಾಕ್ ಕಾನ್ ದಿಯ್ ನಸ್ತಾನಾ ರ್‍ಹಾಯ್ನಾ ಮನ್ತಲೆ ತುಮ್ಕಾ ಗೊತ್ತ್ ರಾವ್ಚೆ. <verse eid="EXO 22:23" /><verse number="24" style="v" sid="EXO 22:24" />ಮಿಯಾ ರಾಗ್ ಹೊವ್ನ್ ತುಮ್ಕಾ ವಿರೊದ್ಯಾಂಚ್ಯಾ ಹಾತಿತ್ನಾ ನಾಶ್ ಕರಸ್ತಾ, ತುಮ್ಚಿ ಬಾಯ್ಕಾ ಘವ್ಮರಲ್ಲಿ ಹೊತಾತ್, ಅನಿ ತುಮ್ಚಿ ಪೊರಾ ಕೊನ್ಬಿ ನತ್ತೆ ಹೊತಾತ್. <verse eid="EXO 22:24" /><verse number="25" style="v" sid="EXO 22:25" />ಮಾಜ್ಯಾ ಲೊಕಾತ್ನಿ ಎಕ್ ಗರಿಬ್ ಮಾನ್ಸಾಕ್ ತಿಯಾ ರಿನ್ ದಿಲ್ಲೆ ಹೊಲ್ಯಾರ್, ತೆಕಾ ರಿನ್ ಕಾರಿನಾಸಾರ್ಕೆ ಬಗುಚೆ ನ್ಹಯ್, ಅನಿ ತೆಜ್ಯಾಕ್ನಾ ಬಡ್ಡಿ ಮಾಗುಚೆ ನ್ಹಯ್. <verse eid="EXO 22:25" /><verse number="26" style="v" sid="EXO 22:26" />ತಿಯಾ ಎಕ್ಲ್ಯಾಚೆ ಕಂಬ್ಳೆ ಆಡು ಥವ್ನ್ ಘೆಟಲ್ಲೆ ಹೊಲ್ಯಾರ್, ದಿಸ್ ಬುಡುಚ್ಯಾ ಅದ್ದಿ ತೆ ಫಾಟಿ ಪರ್‍ತುನ್ ದಿವ್ಚೆ. <verse eid="EXO 22:26" /><verse number="27" style="v" sid="EXO 22:27" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೆಕಾ ತೆ ಎಕುಚ್ ಕಾಂಬ್ರಾನ್ ಹೊವ್ನ್ ಹಾಯ್, ತೆನಿ ತೆಚ್ ಆಂಗಾಕ್ ಲಪ್ಟುನ್ ಘೆವ್ಚೆ, ಅನಿ ದುಸ್ರೆ ಕಾಯ್ಬಿ ಕಾಂಬ್ರಾನ್ ಘೆವ್ನ್ ನಿಜಿನಾ, ತೆನಿ ಮಾಜೆಕ್ಡೆ ಮಾಗ್ಲ್ಯಾರ್ ಮಿಯಾ ಆಯಿಕ್ತಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಮಿಯಾ ದಯಾ ಮಯಿ ಹೊವ್ನ್ ಹಾಂವ್. <verse eid="EXO 22:27" /><verse number="28" style="v" sid="EXO 22:28" />ದೆವಾಕ್ ಗಾಳಿಯಾ ದಿವ್ ನಕಾಸಿ, ತುಮ್ಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಜಾಂನ್ತ್ಯಾಕ್ ಶರಾಪ್ ದಿವ್ ನಕಾಸಿ. <verse eid="EXO 22:28" /><verse number="29" style="v" sid="EXO 22:29" />ತುಮ್ಚ್ಯಾ ಖಳ್ಯಾತ್ನಾ ಅನಿ ಕಳಂಜಾತ್ನಾ ಮಾಕಾ ಪಾಜೆ ಹೊಲ್ಲೆ ದಿವ್ಕ್ ತಡೊ ಕರುನಕಾಸಿ. <verse eid="EXO 22:29" /><verse number="30" style="v" sid="EXO 22:30" />ತುಮ್ಚ್ಯಾ ಥೊರ್ಲ್ಯಾ ಝಿಲ್ ಬಾಳ್ಸ್ಯಾಕ್ನಿ ಮಾಕಾ ಒಪ್ಸುನ್ ದಿವಾ, ತಸೆಚ್ ತುಮ್ಚ್ಯಾ ಜನಾವರಾಂಚ್ಯಾ ಥೊರ್ಲ್ಯಾ ವಾಂಸ್ರಾಕ್ನಿ ಮಾಕಾ ಒಪ್ಸುಚೆ, ತೆ ವಾಂಸ್ರು ಸಾತ್ ದಿಸಾಂಚ್ಯಾ ಪತರ್ ಅಪ್ನಾಚ್ಯಾ ಅವ್ಸಿಕ್ಡೆ ರಾಂವ್ದಿತ್, ಆಟ್ವೆ ದಿಸಿ ತೆ ಮಾಕಾ ಒಪ್ಸುನ್ ಹೊವ್ಚೆ. <verse eid="EXO 22:30" /><verse number="31" style="v" sid="EXO 22:31" />ತುಮಿ ಮಾಜಿ ನಿತಳ್ ಲೊಕಾ ಹೊವ್ನ್ ರಾವ್ಚೆ, ತಸೆ ಹೊವ್ನ್ ಡಂಗ್ಳಿಚ್ಯಾ ಜನಾವರಾನ್ ಜಿವ್ ಕಾಡಲ್ಲೆ ಖಾವ್ಚೆ ನ್ಹಯ್, ತೆ ಕುತ್ರ್ಯಾಂಚ್ಯಾ ವಾಟ್ಯಾಕ್ ಸೊಡುಚೆ.<verse eid="EXO 22:31" /></para>
  <chapter eid="EXO 22" />
  <chapter number="23" style="c" sid="EXO 23" />
  <para style="s">ನ್ಯಾಯ್ ಅನಿ ಬರೆಪಾನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1" />ಝುಟಿ ಖಬರ್ ಪಗ್ಳುಚೆ ನ್ಹಯ್, ತುಮಿ ಸಾಂಗ್ತಲಿ ಸಾಕ್ಷಿ ಖರ್ಯಾಕ್ ವಿರೊಧ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾಕ್ ಅನಿ ಬುರ್ಸ್ಯಾಕ್ ಮಜ್ಜತ್ ಕರುಕ್ ಸಾಟ್ನಿ ಹೊವ್ನ್ ರಾವ್ಚಿ ನ್ಹಯ್. <verse eid="EXO 23:1" /><verse number="2" style="v" sid="EXO 23:2" />ಬುರ್ಶಿ ಕಾಮಾ ಕರ್ತಲಿ ಲೊಕಾ ಲೈ ಹಾತ್, ಹೊಲ್ಯಾರ್ಬಿ ತುಮಿ ತೆಂಚೆ ವಾಂಗ್ಡಿ ಹೊವ್ ನಕಾಸಿ, ಲೈ ಲೊಕಾಂಚ್ಯಾ ಬೊಲ್ನ್ಯಾಕ್ನಿ ಒಪ್ಪುನ್ ಖರೆಪಾನ್ ನಾಶ್ ಕರ್ತಲಿ ಸಾಕ್ಷಿ ಹೊವ್ ನಕಾಸಿ. <verse eid="EXO 23:2" /><verse number="3" style="v" sid="EXO 23:3" />ಅನಿ ಗರಿಬಾಚ್ಯಾ ವೈಲ್ಯಾ ದಯಾವೈನಾ ತೆಜ್ಯಾ ಪಕ್ಷಾನ್ ರಾವ್ಚೆ ನ್ಹಯ್.<verse eid="EXO 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4" />ತುಜ್ಯಾ ವಿರೊಧಿಚೊ ಬೈಲ್ ನಾತರ್ ಗಾಡಾವ್ ಚುಕುನ್ ಜಾವ್ನ್ ಫಿರುನ್ಗೆತ್ ರ್‍ಹಾತಾನಾ ತುಕಾ ದಿಸ್ಲ್ಯಾರ್ ತೆ ಹಾಂಬ್ಡುನ್ ನ್ಹೆವ್ನ್ ತೆಜ್ಯಾಕ್ಡೆ ಪರ್‍ತುನ್ ದಿ. <verse eid="EXO 23:4" /><verse number="5" style="v" sid="EXO 23:5" />ತುಕಾ ಬೆಜಾರ್ ಹೊತ್ತ್ಯಾ ಮಾನ್ಸಾಚೆ ಗಾಡಾವ್ ವಾವಲ್ಲೆ ವಜ್ಜೆ ಲೈ ಝಡ್ ಹೊವ್ನ್, ಖಾಲ್ತಿ ಪಡಲ್ಲ್ಯಾ ತನ್ನಾ ತುಕಾ ತೆ ಉಟ್ವುಕ್ ಮನ್ ನಸ್ಲ್ಯಾರ್ಬಿ ತ್ಯಾ ಮಾನ್ಸಾಕ್ ತೆ ಉಟ್ವುಕ್ ಮಜ್ಜತ್ ಕರುಕುಚ್ ಪಾಜೆ. <verse eid="EXO 23:5" /><verse number="6" style="v" sid="EXO 23:6" />ತುಮ್ಚ್ಯಾಕ್ಡೆ ಹೊತ್ತಿ ಗರಿಬ್ ಲೊಕಾ ನ್ಯಾಯ್ ಮಾಗುನ್ಗೆತ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ, ತೆಂಕಾ ನ್ಯಾಯ್ ದಿಯ್ನ ಸ್ತಾನಾ ರಾವ್ಚೆ ನ್ಹಯ್. <verse eid="EXO 23:6" /><verse number="7" style="v" sid="EXO 23:7" />ಪಸ್ವುತಲ್ಯಾ ಕಾಮಾಂತ್ನಾ ಧುರ್ ರಾವ್ಚೆ, ಚುಕ್ ನಸಲ್ಲ್ಯಾ ಅನಿ ನಿತಿವಂತ್ ಮಾನ್ಸಾಕ್ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ದಿವ್ಚೆ ನ್ಹಯ್, ತಸ್ಲೆ ಬುರ್ಸೆ ಕಾಮ್ ಕರಲ್ಯಾ ಮಾನ್ಸಾಕ್ ಮಿಯಾ ಶಿಕ್ಷ್ಯಾ ದಿಯ್ನಸ್ತಾನಾ ಸೊಡಿನಾ. <verse eid="EXO 23:7" /><verse number="8" style="v" sid="EXO 23:8" />ಲಂಚ್ ಘೆವ್ಚೆ ನ್ಹಯ್, ಲಂಚ್ ಡೊಳೆ ಹೊತ್ತ್ಯಾಕ್ನಿಬಿ ಕುಡ್ಡೆ ಕರ್ತಾ, ಅನಿ ಚುಕ್ ನಸಲ್ಲ್ಯಾಕ್ ಗಾವ್ಚೆ ಹೊಲ್ಲೆ ನ್ಯಾಯ್ ನಾಶ್ ಕರ್ತಾ. <verse eid="EXO 23:8" /><verse number="9" style="v" sid="EXO 23:9" />ದುಸ್ರ್ಯಾ ದೆಶಾಚ್ಯಾಕ್ನಿ ತರಾಸ್ ದಿವ್ಚೆ ನ್ಹಯ್, ತುಮಿಬಿ ಇಜಿಪ್ತಾತ್ ದುಸ್ರ್ಯಾ ದೆಶಾಚೆ ಹೊಲ್ಲ್ಯಾಸಿ ನ್ಹಯ್? ತೆಂಚ್ಯಾ ಮನಾತ್ಲೊ ತರಾಸ್ ತುಮ್ಕಾ ಗೊತ್ತುಚ್ ಹಾಯ್.<verse eid="EXO 23:9" /></para>
  <para style="s">ಸಾತ್ವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಅನಿ ಸಾತ್ವ್ಯಾ ದಿಸಾಚ್ಯಾ ವಿಶಯಾತ್</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10" />ತುಮ್ಚ್ಯಾ ಸೆತಾತ್ನಿ ಸಾ ವರಿಸ್ ಪೆರುನ್ ಪಿಕ್ ಕಾಡುನ್ಗೆವಾ. <verse eid="EXO 23:10" /><verse number="11" style="v" sid="EXO 23:11" />ಖರೆ ಸಾತ್ವ್ಯಾ ವರ್ಸಾತ್ ತ್ಯಾ ಸೆತಾತ್ ಕಾಯ್ಬಿ ಪೆರಿನಸ್ತಾನಾ ಬಿಳ್ ಸೊಡಾ, ತ್ಯಾತುರ್ ಅಪ್ನಿಚ್ ಉಗ್ವುನ್ ಯೆಲ್ಲೆ ತುಮ್ಚ್ಯಾ ಗಾಂವಾತ್ನಿ ಗರಿಬ್ ಹೊತ್ತಿ ಲೊಕಾ ಖಾಂವ್ದಿತ್, ಅನಿ ಹುರಲ್ಲೆ ಡಂಗ್ಳಿತ್ಲಿ ಜನಾವರಾ ಚರುಂದಿತ್, ಅನಿ ತುಮ್ಚ್ಯಾ ದರಾಕ್ಷಾಚ್ಯಾ ಮ್ಹಳ್ಯಾತ್ನಿ ಅನಿ ತೆಲಾಚ್ಯಾ ಝಾಡಾಂಚ್ಯಾ ಮ್ಹಳ್ಯಾತ್ನಿಬಿ ತಸೆಚ್ ಕರಾ.<verse eid="EXO 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 23:12" />ಎಕ್ ವ್ಹಾರ್‍ಯಾತ್ ತುಮಿ ಸಾ ದಿಸ್ ಕಾಮ್ ಕರುನ್ ಸಾತ್ವ್ಯಾದಿಸಿ ಕಸ್ಲೆಬಿ ಕಾಮ್ ಕರುನಕಾಸಿ, ತ್ಯಾ ದಿಸಿ ತುಮ್ಚಿ ಬೈಲಾ, ಗಾಡ್ವಾ ಅನಿ ಆಳಾಬಿ ಆರಾಮ್ ಕರುಂದಿತ್, ಅನಿ ತುಮ್ಚ್ಯಾ ದೆಸಾತ್ ಹೊತ್ತಿ ದುಶ್ರ್ಯಾ ದೆಶಾಚಿ ಲೊಕಾಬಿ ಆರಾಮ್ ಕರುಂದಿತ್. <verse eid="EXO 23:12" /><verse number="13" style="v" sid="EXO 23:13" />ಮಿಯಾ ತುಮ್ಕಾ ಸಾಂಗಲ್ಲೆ ಹೆ ಸಗ್ಳೆ ಲೈ ಹುಶಾರ್ಕಿನ್ ಚಾಲ್ವುನ್ಗೆವ್ನ್ ಜಾವಾ, ಅನಿ ದುಶ್ರ್ಯಾ ಖಲ್ಯಾಬಿ ದೆವಾಚೆ ನಾವ್ ಯಾದ್ ಕರುನಕಾಸಿ, ಅನಿ ಸಾಂಗುಬಿ ನಕಾಸಿ.<verse eid="EXO 23:13" /></para>
  <para style="s">ತಿನ್ ಮೊಟಿ ಸನಾ</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14" />ತುಮಿ ವರ್ಸಾತ್ ಮಾಜೆಸಾಟ್ನಿ ತಿನ್ ಸನಾ ಕರುಚೆ. <verse eid="EXO 23:14" /><verse number="15" style="v" sid="EXO 23:15" />ಎಕ್ ಫುಗ್ ನಸಲ್ಲಿ ಭಾಕ್ರಿಯಾ ಖಾತಲೊ ಸನ್, ಮಿಯಾ ತುಮ್ಕಾ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ, ನೆಮಲ್ಲ್ಯಾ ಎಳಾರ್ ಸಾತ್ ದಿಸಾ ಪತರ್ ಫುಗ್ ನಸಲ್ಲಿ ಭಾಕ್ರಿಯಾ ಖಾವ್ಚೆ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತುಮಿ ಇಜಿಪ್ತ್ ದೆಸಾಕ್ನಾ ಯೆಲ್ಲೆ ತ್ಯಾಚ್ ದಿಸಾತ್ನಿ, ಅನಿ ಮಾಜೆಕ್ಡೆ ಯೆತಲೊ ಹರ್ ಎಕ್ಲೊಬಿ ಕಾನಿಕ್ ನಸ್ತಾನಾ ಖಾಲಿ ಹಾತಿನ್ ಯೆವ್ಚೆ ನ್ಹಯ್. <verse eid="EXO 23:15" /><verse number="16" style="v" sid="EXO 23:16" />ಅನಿ ತುಮಿ ಪೆರಲ್ಲ್ಯಾ ಸೆತಾತ್ನಾ ಪೈಲೆಚೆ ಫಳ್ ಗಾವಲ್ಲ್ಯಾ ತನ್ನಾ ಕಾತ್ರನಿಚೊ ಸನ್ ಕರುಚೆ, ಅನಿ ವರಿಸ್ ಸರ್ತಾನಾ ಮಟ್ಲ್ಯಾರ್ ತುಮ್ಚ್ಯಾ ಸೆತಾಂತ್ನಾ ಅನಿ ಮ್ಹಳ್ಯಾಂತ್ನಾ ಪಿಕ್ ಗೊಳಾ ಕರ್ತಾನಾ ಮ್ಹಳ್ತಲೊ ಸನ್ ಕರುಚೆ. <verse eid="EXO 23:16" /><verse number="17" style="v" sid="EXO 23:17" />ಅಸೆ ಸಗ್ಳಿ ಘವ್ಮಾನ್ಸಾ ಎಕ್ ವರ್ಸಾತ್ ತಿನ್ ದಾ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಯೆವ್ಚೆ. <verse eid="EXO 23:17" /><verse number="18" style="v" sid="EXO 23:18" />ಮಾಕಾ ಬಲಿ ಭೆಟ್ವುತಾನಾ ಭೆಟ್ವಲ್ಲ್ಯಾ ಜನಾವರಾಚ್ಯಾ ರಕ್ತಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಫುಗ್ ನಸಲ್ಲೆ ಪಿಟ್ ದಿವ್ಚೆ ನ್ಹಯ್, ಮಾಜ್ಯಾ ಸನಾತ್ ಮಾಕಾ ಭೆಟ್ವಲ್ಲ್ಯಾ ಜನಾವರಾಚೆ ಮಾಂದೆ ದುಸ್ರ್ಯಾ ದಿಸಾ ಪತರ್ಬಿ ಥವ್ತಲೆ ನಕ್ಕೊ. <verse eid="EXO 23:18" /><verse number="19" style="v" sid="EXO 23:19" />ತುಮ್ಚ್ಯಾ ಪಿಕೆಚ್ಯಾ ಪೈಲ್ಯಾ ವಾಟ್ಯಾತ್ ಲೈ ಬರೆ ಹೊತ್ತೆ, ತುಮ್ಚೊ ದೆವ್ ಅನಿ ಸರ್ವೆಸ್ಪರ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಮಾಕಾ ಭೆಟ್ವುಕ್ ಹಾನುಚೆ, “ಬಕ್ರ್ಯಾಚ್ಯಾ ಪೆಟ್ಯಾಕ್ ತೆಜ್ಯಾ ಅವ್ಸಿಚ್ಯಾ ದುದ್ದಾತ್ ಸಿಜ್ವುಚೆ ನ್ಹಯ್”.<verse eid="EXO 23:19" /></para>
  <para style="s">ಗೊಸ್ಟಿಯಾಂಚ್ಯಾ ವಿಶಯಾತ್</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20" />ಅಬಕ್! ತುಮ್ಕಾ ವಾಟೆವರ್‍ತಿ ರಾಕುಕ್, ಅನಿ ಮಿಯಾ ವಳಕ್ ಕರಲ್ಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ತುಮ್ಕಾ ಬಲ್ವುನ್ ಹಾನುಕ್ ಮನುನ್ ತುಮ್ಚ್ಯಾ ಫಿಡೆ ಎಕ್ ಧುತ್ ಧಾಡ್ತಾ. <verse eid="EXO 23:20" /><verse number="21" style="v" sid="EXO 23:21" />ತುಮಿ ತೆಜ್ಯಾಕ್ಡೆ ಧ್ಯಾನ್ ದಿವ್ನ್ ತೆಜ್ಯಾ ಗೊಸ್ಟಿಯಾಕ್ನಿ ಕಾನ್ ದಿವ್ಚೆ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತೊ ಮಾಜ್ಯಾ ನಾವಾರ್ ಯೆತಲೊ ತಸೆ ಮನುನ್ ತುಮಿ ತೆಕಾ ಖಾಲ್ತಿ ಹೊಯ್ನಸ್ತಾನಾ ರಾವ್ನಕಾಸಿ, ತುಮಿ ಖಾಲ್ತಿ ಹೊಯ್ ನಸ್ತಾನಾ ರಾಲ್ಯಾರ್ ತೊ ತುಮ್ಕಾ ಶಿಕ್ಷ್ಯಾ ದಿತಾ. <verse eid="EXO 23:21" /><verse number="22" style="v" sid="EXO 23:22" />ತುಮಿ ತೆಚೆ ಬೊಲ್ನೆ ಲೈ ಭಕ್ತಿನ್ ಆಯ್ಕುನ್, ಮಾಜಿ ಆಶ್ಯಾ ಫುರಾ ಕರ್ಲ್ಯಾರ್ ಮಿಯಾ ತುಮ್ಚ್ಯಾ ವಿರೊಧಿಯಾಕ್ನಿ ವಿರೊಧಿ ಅನಿ ತುಮ್ಕಾ ತರಾಸ್ ದಿತಲ್ಯಾಕ್ನಿ ತರಾಸ್ ದಿತಲೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾ.<verse eid="EXO 23:22" /></para>
  <para style="s">ಗೊಸ್ಟಿಯಾ ಅನಿ ವಾಟ್ ದಾಕ್ವುತಲೆ</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 23:23" />ಮಾಜೊ ಧುತ್ ತುಮ್ಚ್ಯಾನ್ ಫಿಡೆ ಚಲುಂಗೆತ್, ಅಮೊರಿತಾ, ಹಿತ್ತಿಯಾ, ಪೆರಿಜಿಯಾ ಅನಿ ಕಾನಾನ್, ಹಿವ್ವಿಯಾ, ಜೆಬುಸಿಯಾ ಹೆಂಚಿ ಲೊಕಾ ರ್‍ಹಾತಲ್ಯಾ ಗಾಂವಾಕ್ ತುಮ್ಕಾ ಪಾವಸ್ತಾ, ಮಿಯಾ ತೆಂಕಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ನಾಶ್ ಕರ್ತಾ. <verse eid="EXO 23:23" /><verse number="24" style="v" sid="EXO 23:24" />ತುಮಿ ತೆಂಚ್ಯಾ ದೆವಾಕ್ನಿ ನಮಸ್ಕಾರ್ ಕರುಚೆ ನ್ಹಯ್, ಫುಜ್ಯಾ ಕರುಚೆ ನ್ಹಯ್, ಅನಿ ತೆನಿ ಕರಲ್ಲಿ ನೆಮಾ ಪಾಳುಚೆ ನ್ಹಯ್, ತ್ಯಾ ಲೊಕಾಕ್ನಿ ನಾಶ್ ಕರುನ್ ತೆಂಚಿ ಮುರ್ತಿಯಾ ನಾಶ್ ಕರುಚೆ. <verse eid="EXO 23:24" /><verse number="25" style="v" sid="EXO 23:25" />ತುಮ್ಚೊ ದೆವ್ ಅನಿ ಸರ್ವೆಸ್ಪರ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಮಾಕಾ ಎಕ್ಲ್ಯಾಕುಚ್ ಆರಾದನ್ ಕರುಚೆ, ತನ್ನಾ ತುಮ್ಚ್ಯಾ ಜೆವ್ನಾ, ಖಾನಾಕ್ ಮಿಯಾ ಆಶಿರ್ವಾದ್ ಕರ್ತಾ, ಅನಿ ತುಮ್ಚ್ಯಾಕ್ಡೆ ಕಸ್ಲೆ ದುಕ್ನೆಬಿ ನಾ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EXO 23:25" /><verse number="26" style="v" sid="EXO 23:26" />ತುಮ್ಚ್ಯಾ ಗಾಂವಾತ್ ಗರಬ್ ಪಡುನ್ ಜಾತಲೆ ಹೊಂವ್ದಿತ್, ಪೊರಾ ಹೊಯ್ನಸಲ್ಲೆ ಹೊಂವ್ದಿತ್ ರ್‍ಹಾಯ್ನಾ, ತುಮ್ಕಾ ಫುರಾ ಆಯಿಸ್ ದಿತಾ.<verse eid="EXO 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 23:27" />ತುಮಿ ಜಾತಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಕಡೆ ಮಿಯಾ ಲೊಕಾಂಚ್ಯಾ ಮನಾತ್ನಿ ಭಿಂಯೆ ಹಾನುನ್ ತಳ್ಮಳೊ ಹೊಯ್ ಸಾರ್ಕೆ ಕರುನ್, ತುಮ್ಕಾ ವಿರೊದ್ ಕರ್‍ತಲ್ಯಾಕ್ನಿ ಪಳುನ್ ಜಾಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EXO 23:27" /><verse number="28" style="v" sid="EXO 23:28" />ಮಿಯಾ ತುಮ್ಚ್ಯಾನ್ ಫಿಡೆ ಗಾಂಜ್ಡಾಚಿ ಮಾಸ್ಕಾ ಧಾಡುನ್ ತ್ಯಾ ಹಿವ್ವಿಯಾಕ್ನಿ, ಕಾನಾನ್ಯಾಕ್ನಿ ಅನಿ ಹಿತ್ತಿಯಾಕ್ನಿ ತುಮ್ಚ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆರಾಯ್ನಸ್ತಾನಾ ಪಳುನ್ ಜಾಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ. <verse eid="EXO 23:28" /><verse number="29" style="v" sid="EXO 23:29" />ಖರೆ ಮಿಯಾ ತೆಂಕಾ ಥೈತ್ನಾ ಎಕುಚ್ ವರ್ಸಾತ್ ಪಳ್ಸಿನಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಥೈ ಲೊಕಾ ಕಮ್ಮಿ ಹೊಲ್ಲ್ಯಾ ವೈನಾ ಡಂಗ್ಳಿಚಿ ಜನಾವರಾ ತುಮ್ಕಾ ತರಾಸ್ ದಿತಿಲ್ . <verse eid="EXO 23:29" /><verse number="30" style="v" sid="EXO 23:30" />ತುಮಿ ವಾಡುನ್ ಸಗ್ಳ್ಯಾಗಾಂವಾತ್ ಪಗ್ಳಿಪತರ್ ತೆಂಕಾ ಉಲ್ಲ್ಯಾ ಉಲ್ಲ್ಯಾಚ್ ಲೊಕಾಕ್ನಿ ಧಾಡುನ್ಗೆತ್ ರ್‍ಹಾತಾ. <verse eid="EXO 23:30" /><verse number="31" style="v" sid="EXO 23:31" />ತಾಂಬ್ಡ್ಯಾ ಸಮುಂದರಾಕ್ನಾ ಪಿಲಿಸ್ಟಿಯಾಂಚ್ಯಾ ದೆಸಾಕ್ನಾ ಜಗ್ಗೊಳ್ಲ್ಯಾ ಸಮುಂದರಾ ಪತರ್ ಅನಿ ಹ್ಯಾ ಡಂಗ್ಳಿಕ್ನಾ ಯುಪ್ರೆಟಿಸ್ ಮನ್ತಲ್ಯಾ ಮೊಟ್ಟ್ಯಾ ನ್ಹಯ್ ಪತರ್ಬಿ ಹೊತ್ತೆ ಸಗ್ಳೆ ಗಾಂವಾ ತುಮ್ಕಾ ಮನುನ್ ನೆಮ್ಸುನ್ ಥೈ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾ ಲೊಕಾಕ್ನಿ ತುಮ್ಚ್ಯಾ ಖಾಲ್ತಿ ಕರುನ್ ದಿತಾ. <verse eid="EXO 23:31" /><verse number="32" style="v" sid="EXO 23:32" />ತುಮಿ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊಂವ್ದಿತ್ ನಾತರ್ ತೆಂಚ್ಯಾ ದೆವಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಹೊಂವ್ದಿತ್ ಕಸ್ಲೆಬಿ ಕರಾರ್ ಕರುನ್ ಘೆವ್ಕ್ ನ್ಹಯ್. <verse eid="EXO 23:32" /><verse number="33" style="v" sid="EXO 23:33" />ತೆನಿ ತುಮ್ಚ್ಯಾ ಗಾಂವಾತ್ ವಸ್ತಿ ರ್‍ಹಾತಲೆ ನಕ್ಕೊ, ತೆನಿ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ರಾಲ್ಯಾರ್ ಮಾಜ್ಯಾ ವಿಶಯಾತ್ ತುಮಿ ವಿರೊದ್ ಹೊವ್ನ್ ಬುರ್ಶಿ ಬುದ್ದ್ ಕರಿಸಾರ್ಕೆ ಹೊಯ್ಲ್, ತುಮಿ ತೆಂಚ್ಯಾ ದೆವಾಕ್ನಿ ಫುಜ್ಯಾ ಕರ್ಲ್ಯಾರ್ ತಿ ಫುಜ್ಯಾ ತುಮ್ಕಾ ಪಾಸೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾ.<verse eid="EXO 23:33" /></para>
  <chapter eid="EXO 23" />
  <chapter number="24" style="c" sid="EXO 24" />
  <para style="s">ನೆಮಾಂಚೆ ಧೃಡಿಕರನ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1" />ಮೊಯ್ಜೆಕ್ ಸರ್ವೆಸ್ಪರ್ ಸಾಯ್ಬಾನ್, ತಿಯಾ ಆರೊನ್, ನಾದಾಬ್ ಅನಿ ಅಬಿಹು ಅನಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಜಾಂನ್ತ್ಯಾತ್ನಿ ಸತ್ತರ್ ಲೊಕಾ ಹಿ ಮಡ್ಡಿ ಚಡುನ್ ಸರ್ವೆಸ್ಪರ್ ಹೊವ್ನ್ ಹೊತ್ತ್ಯಾ ಮಾಜೆಕ್ಡೆ ಯೆವ್ನ್ ಧುರುಚ್ ಇಬೆರಾವ್ನ್ ಮಾಕಾ ಪಾಂಯ್ ಪಡುಚೆ. <verse eid="EXO 24:1" /><verse number="2" style="v" sid="EXO 24:2" />ಮೊಯ್ಜೆ ಎಕ್ಲೊ ಸೊಡುನ್ ಅನಿ ತೆಚೆ ವಾಂಗ್ಡಿ ಕೊನ್ಬಿ ಮಾಜ್ಯಾ ಜಗ್ಗೊಳ್ ಎವ್ಚೆ ನ್ಹಯ್, ಹಿ ಹುರಲ್ಲಿ ಲೊಕಾ ಮಡ್ಡಿ ವರ್‍ತಿ ಚಡ್ತಲೆಚ್ ನಕ್ಕೊ, ಮನುನ್ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 24:2" /><verse number="3" style="v" sid="EXO 24:3" />ಮೊಯ್ಜೆನ್ ಸರ್ವೆಸ್ಪರಾಚಿ ನೆಮಾ ಅನಿ ಹುಕುಮಾ ಲೊಕಾಂಚ್ಯಾಕ್ಡೆ ಯೆವ್ನ್ ಸಾಂಗ್ಲ್ಯಾನ್, ಸಗ್ಳ್ಯಾ ಲೊಕಾನಿ ಅಮಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಹುಕುಮಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಕರುನ್ ಘೆವ್ನ್ ಚಲ್ತಾಂವ್ ಮನುನ್ ಎಕುಚ್ ಧನಾನ್ ಸಾಂಗ್ಲ್ಯಾನಿ. <verse eid="EXO 24:3" /><verse number="4" style="v" sid="EXO 24:4" />ಮೊಯ್ಜೆನ್ ಸರ್ವೆಸ್ಪರಾಚಿ ಹುಕುಮಾ ಸಗ್ಳಿ ಲಿವ್ನ್ ಥವ್ಲ್ಯಾನ್; ಅನಿ ಸಕ್ಕಾಳಿ ಉಟುನ್ ಮಡ್ಡಿಚ್ಯಾ ಬುಡಿ ಎಕ್ ಬಲಿಭೆಟ್ವುತಲೊ ಜಾಗೊ ಭಾಂದ್ಲ್ಯಾನ್, ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಬಾರಾ ಘರಾನಾಕ್ನಿ ಬಾರಾ ಗುಂಡ್ಯಾಂಚೆ ಖಾಂಬೆ ತಯಾರ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 24:4" /><verse number="5" style="v" sid="EXO 24:5" />ಅನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ದಾಂಡ್ಗ್ಯಾ ಮಾನ್ಸಾಕ್ನಿ ಸರ್ವೆಸ್ಪರಾ ಸಾಟ್ನಿ ಜಾಳ್ವುತಲಿ ಬಲಿಯಾ ಭೆಟ್ವು ಸಾರ್ಕೆ ಅನಿ ಸಮಾಧಾನಾಚ್ಯಾ ಬಲಿಸಾಟ್ನಿ ಪಾಡೆ ಬಲಿ ಭೆಟ್ವುಕ್ ಒಪ್ಕಿ ದಿಲ್ಯಾನ್. <verse eid="EXO 24:5" /><verse number="6" style="v" sid="EXO 24:6" />ಅನಿ ತ್ಯಾ ಬಲಿ ಭೆಟ್ವಲ್ಲ್ಯಾ ರಕ್ತಾತ್ಲೊ ಅರ್ದೊಭಾಗ್ ಕಾಡುನ್ ಆಯ್ದಾನಾತ್ನಿ ಭರಲ್ಲ್ಯಾನ್, ಅನಿ ಹುರಲ್ಲೆ ಅರ್ದೆ ಬಲಿಭೆಟ್ವುತಲ್ಯಾ ಜಾಗ್ಯಾ ವರ್‍ತಿ ಸಿಪಡ್ಲ್ಯಾನ್. <verse eid="EXO 24:6" /><verse number="7" style="v" sid="EXO 24:7" />ಮಾನಾ ನೆಮಾಂಚೆ ಪುಸ್ತಕ್ ಘೆವ್ನ್ ಲೊಕಾಕ್ನಿ ಆಯ್ಕಿಸಾರ್ಕೆ ವಾಚ್ಲ್ಯಾನ್, ತೆನಿ ತೆ ಆಯ್ಕ್ ಲ್ಲ್ಯಾ ಮಾನಾ ಅಮಿ ಸರ್ವೆಸ್ಪರಾಚಿ ಹುಕುಮಾ ಸಗ್ಳಿ ಪಾಳ್ತಾಂವ್, ಅನಿ ತೆಂಕಾ ಖಾಲ್ತಿ ಹೊತಾವ್, ಮಟ್ಲ್ಯಾನಿ. <verse eid="EXO 24:7" /><verse number="8" style="v" sid="EXO 24:8" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಆಯ್ದಾನಾಂತ್ಲೆ ರಗಾತ್ ಘೆವ್ನ್ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿ ಸಿಪ್ಡುನ್, ಅಬಕಾ, ಹೆಚ್ ರಗಾತ್ ತೆ ಹ್ಯಾ ಪುಸ್ತಕಾತ್ ಸಾಂಗಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಹುಕುಮಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಸರ್ವೆಸ್ಪರಾನ್ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಕರುನ್ಗೆಟಲ್ಲ್ಯಾ ಕರಾರಾಕ್ನಿ ಘಟ್ ಕರಲ್ಲೆ ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 24:8" /><verse number="9" style="v" sid="EXO 24:9" />ಮೊಯ್ಜೆ, ಆರೊನ್, ನಾದಾಬ್ ಅನಿ ಅಬಿಹು ವಾಂಗ್ಡಾ ಇಜ್ರಾಯೆಲಾಂಚಿ ಸತ್ತರ್ ಲೊಕಾ ಮಡ್ಡಿ ವರ್‍ತಿ ಚಡ್ಲಿ. <verse eid="EXO 24:9" /><verse number="10" style="v" sid="EXO 24:10" />ತೆಂಕಾ ಇಜ್ರಾಯೆಲಾಂಚೊ ಸರ್ವೆಸ್ಪರ್ ದಿಸ್ಲೊ, ಮಳ್ಬಾಂಚ್ಯಾ ತಾಂಡ್ಯಾ ಸಾರ್ಕೆ ಲೈ ನಿತಳ್ ಹೊತ್ತೆ, ಇಂದ್ರನಿಳ್ ಮನಿಚೊ ಜಾಗೊ ತೆಂಚೊ ಪಾಯ್ ಥವ್ತಲಿ ಮ್ಹನಿ ಹೊಲ್ಲಿ. <verse eid="EXO 24:10" /><verse number="11" style="v" sid="EXO 24:11" />ತೆನಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಜಾಂನ್ತ್ಯಾಕ್ನಿ ಕಾಯ್ಬಿ ನಾಶ್ ಕರುಕ್ನಾ, ತ್ಯಾ ಜಾಂನ್ತ್ಯಾನಿ ದೆವಾಕ್ ಬಗ್ಲ್ಯಾನಿ, ಅನಿ ಮಾನಾ ಜೆವಾನ್ ಕರ್ಲ್ಯಾನಿ.<verse eid="EXO 24:11" /></para>
  <para style="s">ಸಿನಾಯ್ ಮಡ್ಡಿರ್ ಮೊಯ್ಜೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, ತಿಯಾ ಮಡ್ಡಿ ಚಡುನ್ ಯೆವ್ನ್ ಮಾಜ್ಯಾ ಜಗ್ಗೊಳುಚ್ ರಾ, ತಿ ಶಾಸ್ತರಾ ಅನಿ ಮಾಜಿ ಹುಕುಮಾ ತಿಯಾ ಲೊಕಾಕ್ನಿ ಶಿಕಾಪ್ ಕರುಕ್ ಸಾಟ್ನಿ ಗುಂಡ್ಯಾ ವೈನಿ ಲಿವಲ್ಲೆ ಹೊತ್ತೆ ಮಿಯಾ ತುಕಾ ದಿತಾ ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 24:12" /><verse number="13" style="v" sid="EXO 24:13" />ಮೊಯ್ಜೆನ್ ಅಪ್ನಾಚೊ ಶಿಸ್ ಜೊಶ್ವಾಕ್ ಘೆವ್ನ್ ದೆವಾಚ್ಯಾ ಮಡ್ಡಿಚ್ಯಾ ತುದಿಕ್ ಗೆಲೊ. <verse eid="EXO 24:13" /><verse number="14" style="v" sid="EXO 24:14" />ಹೆಜ್ಯಾನ್ ಅದ್ದಿ ತೆನಿ ಜಾಂನ್ತ್ಯಾ ಲೊಕಾಕ್ನಿ, ಮಿಯಾ ಪರ್‍ತುನ್ ತುಮ್ಚ್ಯಾಕ್ಡೆ ಯೆಯ್ ಪತರ್ಬಿ ತುಮಿ ಹಿತ್ತೆಚ್ ರಾಕುನ್ಗೆತ್ ರಾವಾ, ಆರೊನ್ ಅನಿ ಹುರಲ್ಲಿ ಲೊಕಾ ತುಮ್ಚ್ಯಾಕ್ಡೆಚ್ ರ್‍ಹಾತಾತ್, ತುಮ್ಚ್ಯಾಕ್ಡೆ ಹೊಯ್ನಸಲ್ಲಿ ಕಾಯ್ತರ್ಬಿ ವಿಶಯ್ ರಾಲ್ಯಾರ್ ತೆಂಚ್ಯಾಕ್ಡೆ ಜಾವ್ನ್ ಸಾಂಗಾ, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 24:14" /><verse number="15" style="v" sid="EXO 24:15" />ಮಾನಾ ಮೊಯ್ಜೆ ಮಡ್ಡಿ ವರ್‍ತಿ ಚಡ್ಲೊ ಅನಿ ಮೊಡಾನ್ ತೆಕಾ ಧಾಪ್ಲ್ಯಾನ್. <verse eid="EXO 24:15" /><verse number="16" style="v" sid="EXO 24:16" />ಅನಿ ಸರ್ವೆಸ್ಪರಾಚೊ ಉಜ್ವೊಡ್ ಸಿನಾಯ್ ಮಡ್ಡಿ ವರ್‍ತಿ ಇಬೆ ರ್‍ಹಾಲೊ, ತ್ಯಾ ಮೊಡಾನ್ ಸಾ ದಿಸ್ ಪತರ್ಬಿ ಮಡ್ಡಿಕ್ ಧಾಪ್ಲ್ಯಾನ್, ಸಾತ್ವ್ಯಾ ದಿಸಿ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಮೊಡಾಂತ್ನಾ ಬಲ್ವುಲ್ಯಾನ್. <verse eid="EXO 24:16" /><verse number="17" style="v" sid="EXO 24:17" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಸರ್ವೆಸ್ಪರಾಚೊ ಉಜ್ವೊಡ್ ಮಡ್ಡಿ ವರ್‍ತಿ ಲೈ ಹೊಳಾವ್ತಲ್ಯಾ ಆಗಿ ಸಾರ್ಕೆ ದಿಸ್ಲೆ. <verse eid="EXO 24:17" /><verse number="18" style="v" sid="EXO 24:18" />ಮೊಯ್ಜೆನ್ ತ್ಯಾ ಮೊಡಾತ್ ಗುಸುನ್ ಮಡ್ಡಿ ವರ್‍ತಿ ಚಡ್ಲ್ಯಾನ್, ತೊ ತ್ಯಾ ಮಡ್ಡಿ ವರ್‍ತಿ ಚಾಳಿಸ್ ರ್‍ಹಾತ್ ಅನಿ ದಿಸ್ ರಾಲೊ.<verse eid="EXO 24:18" /></para>
  <chapter eid="EXO 24" />
  <chapter number="25" style="c" sid="EXO 25" />
  <para style="s">ದೆವಾಚ್ಯಾ ಗುಡಿಕ್ ಕಾನಿಕ್ ಭೆಟ್ವುತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಅಸೆ ಮಟ್ಲ್ಯಾನ್, <verse eid="EXO 25:1" /><verse number="2" style="v" sid="EXO 25:2" />ಮಾಜ್ಯಾ ಸಾಟ್ನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಕಾನಿಕ್ ಕಾಡುನ್ ಥವ್ಚೆ ಮನುನ್ ಸಾಂಗ್, ಫುರಾ ಮನಾನ್ ದಿತಲ್ಯಾಕ್ನಾಚ್ ತಿ ಕಾನಿಕ್ ಘೆವ್ಚೆ. <verse eid="EXO 25:2" /><verse number="3" style="v" sid="EXO 25:3" />ತಿಯಾ ತೆಂಚ್ಯಾಕ್ನಾ ಘೆವ್ಚಿ ಹೊಲ್ಲಿ ಕಾನಿಕ್ ಹಿಚ್, ಚಾಂದಿ, ಸೊನೆ, ತಾಂಬೆ, <verse eid="EXO 25:3" /><verse number="4" style="v" sid="EXO 25:4" />ನಿಲಿ, ದುದ್, ಲೈ ತಾಂಬ್ಡ್ಯಾ ಬನ್ನಾಚೆ ದೊರೆ, ನಿತಳ್ ಲಪಾಟಿಯಾ, ತುಪ್ಪಟಾಚೆ ಕಪ್ಡೆ. <verse eid="EXO 25:4" /><verse number="5" style="v" sid="EXO 25:5" />ಹಾದಾಕ್ ಹಾನಲ್ಲಿ ತಾಂಬ್ಡ್ಯಾ ಬನ್ನಾಚಿ ಬಕ್ರ್ಯಾಚಿ ಕೆಸಾ, ಸಮುಂದರಾಚ್ಯಾ ಡುಕ್ರಾಚಿ ಕೆಸಾ, ಜಾಲಿಚೆ ಝಾಡ್, <verse eid="EXO 25:5" /><verse number="6" style="v" sid="EXO 25:6" />ದಿವ್ಯಾಕ್ ಪಾಜೆ ಹೊಲ್ಲೆ ತೆಲ್, ಅಭಿಶೆಕ್ ತೆಲಾಕ್ ಅನಿ ಬರ್ಯಾವಾಸೆಚ್ಯಾ ಧುಪಾಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ಬರ್ಯಾ ವಾಸೆಚಿ ತೆಲಾ.<verse eid="EXO 25:6" /></para>
  <para style="s">ಕರಾರಾಚಿ ಪೆಟಿ</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 25:7" />ಮೊಟ್ಟ್ಯಾ ಯಾಜಕಾಚ್ಯಾ ಕವ್ಚಿಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ಗೊಮೆದಿಕ್ ರತ್ನಾ, ಅನಿ ಪದಕಾಚ್ಯಾ ಚಿಲಾತ್ ಕಾತ್ರುಚಿ ಹೊಲ್ಲಿ ಲೈ ನಮುನ್ಯಾಚಿ ರತ್ನಾ. <verse eid="EXO 25:7" /><verse number="8" style="v" sid="EXO 25:8" />ಅನಿ ಮಿಯಾ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ವಸ್ತಿ ರಾವ್ಕ್ ಮಾಕಾ ಎಕ್ ಬಿಡಾರ್ ಭಾಂದ್ಸುಚೆ. <verse eid="EXO 25:8" /><verse number="9" style="v" sid="EXO 25:9" />ಥೈತ್ಲಿ ಫುರಾ ಸಾಮಾನಾ ಅನಿ ತೆ ಬಿಡಾರ್ ಮಿಯಾ ತುಮ್ಕಾ ದಾಕ್ವುತಲ್ಯಾ ನಮುನಿಚ್ ತಯಾರ್ ಕರ್ಸುಚೆ.<verse eid="EXO 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10" />ತಿಯಾ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಎಕ್ ಕರಾರಾಚಿ ಪೆಟಿ ತಯಾರ್ ಕರುಚೆ, ಸಾಡೆ ದೊನ್ ಹಾತ್ ಲಾಂಬ್, ಸಾಡೆ ಎಕ್ ಹಾತ್ ರುಂದ್ ಅನಿ ಸಾಡೆ ಎಕ್ ಹಾತ್ ಉಪ್ಪರ್ ರಾಂವ್ದಿತ್. <verse eid="EXO 25:10" /><verse number="11" style="v" sid="EXO 25:11" />ತೆಜ್ಯಾ ಭಾಯ್ರ್ ಅನಿ ಭುತ್ತುರ್ ಚೊಕ್ಕ್ ಸೊನ್ಯಾಚ್ಯಾ ತಗ್ಡಾನಿ ಧಾಪುಚೆ ತೆಜ್ಯಾ ವರ್‍ತಿ ಸಗ್ಳ್ಯಾ ಭೊತ್ಯಾನಿ ಭಾಂದುಚೆ. <verse eid="EXO 25:11" /><verse number="12" style="v" sid="EXO 25:12" />ಚಾರ್ ಸೊನ್ಯಾಚಿ ಕಾಕ್ನಾ ಲಾವ್ನ್, ತೆಜ್ಯಾ ಚಾರಿ ಮುಲ್ಲ್ಯಾಕ್ನಿಬಿ ಎಕೆಕ್ ಕಡೆ ದೊದೊನ್ ಕಾಕ್ನಾ ಥವ್ಚೆ. <verse eid="EXO 25:12" /><verse number="13" style="v" sid="EXO 25:13" />ಅನಿ ತಿ ಪೆಟಿ ಉಕ್ಲುಕ್ ಜಾಲಿಚ್ಯಾ ಝಾಡಾಚೆ ದಾಂಡೆ ಕರ್ಸುನ್ ತೆಕಾ ಸೊನ್ಯಾಚಿ ತಗ್ಡಾ ನೆಸ್ವುನ್, <verse eid="EXO 25:13" /><verse number="14" style="v" sid="EXO 25:14" />ಕರಾರಾಚ್ಯಾ ಪೆಟಿಚ್ಯಾ ದೊನಿ ಭಾಜುಕ್ನಿ ಕಾಕ್ನಾ ಮಿಳ್ವುಚೆ. <verse eid="EXO 25:14" /><verse number="15" style="v" sid="EXO 25:15" />ತ್ಯಾ ದಾಂಡ್ಯಾಕ್ನಿ ಕರಾರಾಚ್ಯಾ ಪೆಟಿತ್ನಾ ಕಾಡಿನಸ್ತಾನಾ ತ್ಯಾತುರ್ನಿಚ್ ಥವ್ಚೆ. <verse eid="EXO 25:15" /><verse number="16" style="v" sid="EXO 25:16" />ಅನಿ ತ್ಯಾ ಕರಾರಾಚ್ಯಾ ಪೆಟಿಚ್ಯಾ ಭುತ್ತುರ್ ಮಿಯಾ ತುಕಾ ದಿತಲೆ ಹುಕುಮಾಂಚೆ ಗುಂಡೆ ಥವ್ಚೆ. <verse eid="EXO 25:16" /><verse number="17" style="v" sid="EXO 25:17" />ಹೆ ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಆಗ್ದಿ ನಿತಳ್ ಸೊನ್ಯಾನ್ ಎಕ್ ಕೃಪಾಸನ್ ಕರ್ಸುಚೆ, ತೆ ಸಾಡೆ ದೊನ್ ಹಾತ್ ಲಾಂಬ್ ಅನಿ ಸಾಡೆ ಎಕ್ ಹಾತ್ ರುಂದ್ ರಾವ್ಚೆ. <verse eid="EXO 25:17" /><verse number="18" style="v" sid="EXO 25:18" />ಕೃಪಾಸನಾಚ್ಯಾ ದೊನಿ ತುದಿಯಾಕ್ನಿ ಎಕೆಕ್ ಕೆರುಬಿಯಾಂಚಿ ದೊನ್ ಸೊನ್ಯಾಚಿ ಆಕಾರಾ ನಕಾಸಿಚ್ಯಾ ಕಾಮಾನಿ ಕರ್ಸುಚೆ. <verse eid="EXO 25:18" /><verse number="19" style="v" sid="EXO 25:19" />ಕೃಪಾಸನಾಚ್ಯಾ ಎಕೆಕ್ ತುದಿಕ್ಬಿ ಎಕೆಕ್ ಕೆರುಬಿ ಕರುನ್ ತೆಜ್ಯಾ ತುದಿಕ್ ಜೊಡ್ಸುಚೆ. <verse eid="EXO 25:19" /><verse number="20" style="v" sid="EXO 25:20" />ತೆ ಕೆರುಬಿಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಅಪ್ನಾಚೆ ಫಾಂಕುಟೆ ಪಗಳಲ್ಲ್ಯಾ ಗತಿನ್ ಅನಿ ಕೃಪಾಸನಾಕ್ ಅಪ್ನಾಚ್ಯಾ ಫಾಂಕುಟ್ಯಾನಿ ಧಾಪಲ್ಲ್ಯಾ ಗತಿನ್ ರಾವ್ಚೆ, ತೆಂಚಿ ತೊಂಡಾ ಇದ್ರಾ ಬದ್ರಾಕ್ ಹೊವ್ನ್ ಎಕಾಮೆಕಾಕ್ ಬಗುಲಾಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ರಾವ್ಚೆ. <verse eid="EXO 25:20" /><verse number="21" style="v" sid="EXO 25:21" />ತೆ ಕೃಪಾಸನ್ ಕರಾರಾಚ್ಯಾ ಪೆಟಿಚ್ಯಾ ವರ್‍ತಿ ಥವ್ಚೆ, ಮಿಯಾ ತುಕಾ ದಿತಲೆ ಹುಕುಮಾಂಚೆ ಗುಂಡೆ ತ್ಯಾ ಕರಾರಾಚ್ಯಾ ಪೆಟಿತ್ ಥವ್ಚೆ. <verse eid="EXO 25:21" /><verse number="22" style="v" sid="EXO 25:22" />ಮಿಯಾ ತುಮ್ಕಾ ದಿಸ್ತಲೊ ತ್ಯಾಚ್ ಜಾಗ್ಯಾರ್, ಕೃಪಾಸನಾಚ್ಯಾ ವರ್‍ತಿ ಹುಕುಮಾಂಚೆ ಗುಂಡೆ ಥವಲ್ಲ್ಯಾ ಕರಾರಾಚ್ಯಾ ಪೆಟಿ ವೈಲ್ಯಾ ದೊನ್ ಕೆರುಬಿಯಾಂಚ್ಯಾ ಮದ್ದಿ ಮಿಯಾ ರಾವ್ನ್ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ತಾ, ಅನಿ ಇಜ್ರಾಯೆಲ್‌ಕಾರಾಕ್ನಿ ದಿವ್ಚಿ ಹೊಲ್ಲಿ ಹುಕುಮಾ ಕಳ್ವುತಾ.<verse eid="EXO 25:22" /></para>
  <para style="s">ಬಾರಿಕ್ಲಿಚೊ ಮಾಂಚೊ</para>
  <para style="r">
    <ref loc="EXO 37:10-16">37:10-16</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23" />ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಎಕ್ ಮಾಂಚೊ ಕರಸ್, ತೆ ದೊನ್ ಹಾತ್ ಲಾಂಬ್, ಎಕ್ ಹಾತ್ ರುಂದ್ ಅನಿ ಸಾಡೆ ಎಕ್ ಹಾತ್ ಉಪ್ಪರ್ ರಾಂವ್ದಿತ್. <verse eid="EXO 25:23" /><verse number="24" style="v" sid="EXO 25:24" />ತೆಕಾ ನಿತಳ್ ಸೊನ್ಯಾಚೆ ತಗಾಡ್ ಲಪ್ಟುನ್ ಭೊತ್ಯಾನ್ ತೊರಾನ್ ಭಾಂದ್ಸುಚೆ. <verse eid="EXO 25:24" /><verse number="25" style="v" sid="EXO 25:25" />ಮಾಂಚ್ಯಾಕ್ ಭೊತ್ಯಾನ್ ಅರ್ದ್ಯಾ ಹಾತಿ ತವ್ಡಿ ಲಾಂಬ್ ಆಡ್ವಿ ಪಟ್ಟಿ ಕರ್ಸುನ್ ತೆಕಾಬಿ ಸೊನ್ಯಾಚೆ ತೊರಾನ್ ಭಾಂದ್ಸುಚೆ. <verse eid="EXO 25:25" /><verse number="26" style="v" sid="EXO 25:26" />ಚಾರ್ ಸೊನ್ಯಾಚಿ ಕಾಕ್ನಾ ಕರ್ಸುನ್, ಮಾಂಚ್ಯಾಚ್ಯಾ ಚಾರಿ ಪಾಂಯಾಕ್ನಿಬಿ ಘಾಲ್ಸುಚೆ. <verse eid="EXO 25:26" /><verse number="27" style="v" sid="EXO 25:27" />ತಿ ಕಾಕ್ನಾ ಅಡ್ವಿ ಹೊತ್ತ್ಯಾ ಪಟ್ಟಿಕ್ ಲಾಗುನ್ ರಾವ್ಚಿ, ಅನಿ ತೊ ಮಾಂಚೊ ಉಕ್ಲುಕ್ ಸಾಟ್ನಿ ದಾಂಡೆ ಮಿಳ್ವುನ್ ಥವ್ಚೆ. <verse eid="EXO 25:27" /><verse number="28" style="v" sid="EXO 25:28" />ತೆ ದಾಂಡೆ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಕರ್ಸುನ್ ತೆಂಕಾ ಸೊನ್ಯಾಚ್ಯಾ ತಗ್ಡಾನ್ ಲಪ್ಟುಚೆ ಅನಿ ಮಾಂಚೊ ಹೆಜ್ಯಾನುಚ್ ಉಕ್ಲುಚೆ. <verse eid="EXO 25:28" /><verse number="29" style="v" sid="EXO 25:29" />ಮಾಚ್ಯಾ ವರ್‍ತಿ ಥವ್ತಲಿ ವಾಟ್ಕಿಯಾ, ಧುಪಾಚೆ ದಿವೆ, ಹುಜಿ ಅನಿ ಪಾನಿ ಭೆಟ್ವುಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ಆಯ್ದಾನಾ, ಹೆ ಸಗ್ಳೆ ನಿತಳ್ ಸೊನ್ಯಾನುಚ್ ಕರ್ಸುಚೆ. <verse eid="EXO 25:29" /><verse number="30" style="v" sid="EXO 25:30" />ತೆಜ್ಯಾ ಜಗ್ಗೊಳ್ ಕನ್ನಾಬಿ ಭಾಕ್ರಿಯಾ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಮಾಂಚ್ಯಾ ವರ್‍ತಿ ಥವಲ್ಲಿ ರಾವ್ಚಿ.<verse eid="EXO 25:30" /></para>
  <para style="s">ದಿವ್ಯಾಂಚೆ ಝಾಡ್</para>
  <para style="r">
    <ref loc="EXO 37:17-24">37:17-24</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31" />ಅಗ್ದಿ ನಿತಳ್ ಸೊನ್ಯಾನ್ ಎಕ್ ದಿವ್ಯಾಂಚೆ ಝಾಡ್ ಕರ್ಸುಚೆ, ತೆಚೆ ಮುಳ್ ಅನಿ ಮದ್ಲೊ ಭಾಗ್ ನಕಾಸಿಚ್ಯಾ ಕಾಮಾನಿ ಕರ್ಸುಚೆ, ತೆ ದಿವ್ಯಾಂಚೆ ಝಾಡ್ ಅಖಂಡ್ ರಾವ್ಚೆ, ತೆ ತಾಸ್ತಾನಾ ಕರ್ತಾನಾ, ಪುಲ್ಲಾಂಚಿ ಅನಿ ಕಳ್ಯಾಂಚಿ ಚಿತ್ರಾ ಕಾಡುಚೆ. <verse eid="EXO 25:31" /><verse number="32" style="v" sid="EXO 25:32" />ತ್ಯಾ ಝಾಡಾಕ್ ಎಕೆಕ್ ಭಾಜುಕ್ ತಿತಿನ್ ಟಾಂಕಿಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಸಾ ಟಾಂಕಿಯಾ ರಾವ್ಚಿ. <verse eid="EXO 25:32" /><verse number="33" style="v" sid="EXO 25:33" />ಹರ್ ಎಕ್ ಟಾಂಕಿಕ್ಬಿ ಬಾದಾಮಿ ಫುಲ್ಲಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಹೊತ್ತಿ ತಿತಿನ್ ಫುಲ್ಲಾಂಚಿ ಸಿಂಗಾರಾ ರಾವ್ಚಿ, ಹರ್ ಎಕ್ ಸಿಂಗಾರಾಕ್ಬಿ ಎಕ್ ಫುಲ್ಲ್ ಅನಿ ಎಕ್ ಮೊಗ್ಗೊ ರಾವ್ಚೊ, ಸಾ ಟಾಂಕಿ ಯಾಕ್ನಿಬಿ ತಸೆಚ್ ಕರ್ಸುಚೆ. <verse eid="EXO 25:33" /><verse number="34" style="v" sid="EXO 25:34" />ದಿವ್ಯಾಂಚ್ಯಾ ಝಾಡಾಚ್ಯಾ ಮದ್ಲ್ಯಾ ಭಾಗಾತ್ ಕಳೆ ಅನಿ ಫುಲ್ಲಾನಿ ಭರಲ್ಲೆ ಬಾದಾಮಿಚ್ಯಾ ಫುಲ್ಲಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಚಾರ್ ಫುಲ್ಲಾಂಚೆ ಸಿಂಗಾರ್ ರಾವ್ಚೆ. <verse eid="EXO 25:34" /><verse number="35" style="v" sid="EXO 25:35" />ದೊನ್ ಟಾಂಕಿಯಾಕ್ನಿ ಫಾಟೆ ಫುಟಲ್ಲ್ಯಾಕ್ಡೆ ಎಕೆಕ್ ಮೊಗ್ಗೊ ರಾವ್ಚೊ. <verse eid="EXO 25:35" /><verse number="36" style="v" sid="EXO 25:36" />ಕಳೆ ಅನಿ ಫುಲ್ಲಾಂಚೆ ಝಾಡ್ ಫುರಾ ನಿತಳ್ ಸೊನ್ಯಾನಿ ಕರಸಲ್ಲೆ ರಾವ್ಚೆ. <verse eid="EXO 25:36" /><verse number="37" style="v" sid="EXO 25:37" />ಅನಿ ತೆಕಾ ಸಾತ್ ದಿವೆ ಪೆಟ್ವುತಲಿ ಆಯ್ದಾನಾ ಕರ್ಸುಚೆ, ತ್ಯಾ ಆಯ್ದಾನಾತ್ನಿ ದಿವೆ ಪೆಟಲ್ಲ್ಯಾ ತನ್ನಾ ತೆಜೊ ಉಜ್ವೊಡ್ ತೆಂಚ್ಯಾ ಫಿಡ್ಲ್ಯಾ ಭಾಗಾತ್ ಹೊಳಾವ್ತಾ. <verse eid="EXO 25:37" /><verse number="38" style="v" sid="EXO 25:38" />ದಿವ್ಯಾಂಚಿ ಕುಡಿ ಕಾಡ್ತಲಿ ಕತ್ರಿಯಾ ಅನಿ ಆಯ್ದಾನಾ ನಿತಳ್ ಸೊನ್ಯಾನ್ ಕರಸಲ್ಲಿ ರಾವ್ಚಿ. <verse eid="EXO 25:38" /><verse number="39" style="v" sid="EXO 25:39" />ಫುರಾ ತಿಸಾರ್ ಪಾಂಚ್ ಕಿಲೊ ನಿತಳ್ ಸೊನೆ ವಾಪ್ರುನ್ ತೆ ದಿವ್ಯಾಂಚೆ ಝಾಡ್ ಅನಿ ತೆಚಿ ಸಾಮಾನಾ ತಯಾರ್ ಕರ್ಸುಚೆ. <verse eid="EXO 25:39" /><verse number="40" style="v" sid="EXO 25:40" />ಮಿಯಾ ತುಕಾ ಡಂಗ್ಳಿತ್ ದಾಕ್ವಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಸಗ್ಳೆಬಿ ಹುಶ್ಯಾರ್ಕಿನ್ ಕರ್ಸುಚೆ.<verse eid="EXO 25:40" /></para>
  <chapter eid="EXO 25" />
  <chapter number="26" style="c" sid="EXO 26" />
  <para style="s">ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಗುಡಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1" />ಮಾಕಾ ವಸ್ತಿ ರಾವ್ಕ್ ಮನುನ್ ಧಾ ಕಪ್ಡ್ಯಾನಿ ಜಾಗೊ ತಯಾರ್ ಕರುಚೆ, ತೆ ಕಪ್ಡೆ ನ್ಹವೆ ರಾವ್ಚೆ, ತ್ಯಾತುರ್ನಿ ಝಾಂಬ್ಳ್ಯಾ ಬನ್ನಾಚೆ ಅನಿ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚೆ ಕೆರುಬಿಯಾ ಹಾತಿನಿ ಚಮತ್ಕಾರಾಚೆ ಕಾಮ್ ಕರುನ್ ರಾವ್ಚೆ. <verse eid="EXO 26:1" /><verse number="2" style="v" sid="EXO 26:2" />ಹರ್ ಎಕ್ ಕಪ್ಡೊಬಿ ವಿಸಾರ್ ಆಟ್ ಹಾತ್ ಲಾಂಬ್ ಅನಿ ಚಾರ್ ಹಾತ್ ರುಂದ್ ರಾವ್ಚೆ, ಸಗ್ಳೆ ಕಪ್ಡೆಬಿ ಎಕುಚ್ ಅಳ್ತಿಚೆ ರಾವ್ಚೆ. <verse eid="EXO 26:2" /><verse number="3" style="v" sid="EXO 26:3" />ಪಾಂಚ್ ಪಾಂಚ್ ಕಪ್ಡೆ ಎಕೆಕ್ ಕರುನ್ ಜೊಡ್ಸುನ್ ರಾವ್ಚೆ. <verse eid="EXO 26:3" /><verse number="4" style="v" sid="EXO 26:4" />ಹ್ಯಾ ದೊನಿ ಜೊಡಸಲ್ಲ್ಯಾತ್ನಿಬಿ ಹರ್ ಎಕಾಚ್ಯಾ ತುದಿಕ್ ಝಾಂಬ್ಳ್ಯಾ ದೊರ್ಯಾನ್ ಕೊಂಡಿಯಾ ಕರುಚೆ. <verse eid="EXO 26:4" /><verse number="5" style="v" sid="EXO 26:5" />ತಿ ಕೊಂಡಿಯಾ ಪನ್ನಾಸಾಕ್ ಎಕಾ ಸಾರ್ಕೆ ಹರ್ ಎಕಾಚ್ಯಾಬಿ ಇದ್ರಾಕ್ ಥವ್ನ್ ರಾವ್ಚೆ. <verse eid="EXO 26:5" /><verse number="6" style="v" sid="EXO 26:6" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಪನ್ನಾಸ್ ಸೊನ್ಯಾಚಿ ಕೊಂಡಿಯಾ ಕರುನ್ ತೆ ಕಪ್ಡೆ ಹರ್ ಎಕಾಕ್ಬಿ ಮಿಳ್ವುಚೆ, ಅಸೆ ಎಕ್ ಬಿಡಾರ್ ಹೊತಾ.<verse eid="EXO 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7" />ಬಕ್ರ್ಯಾಚ್ಯಾ ಕೆಸಾಂಚೆ ಆಕ್ರಾ ತುಕ್ಡೆ ಕಪ್ಡೆ ಹ್ಯಾ ಬಿಡಾರಾ ವರ್‍ತಿ ಕಾಂಬ್ರುಕ್ ಸಾಟ್ನಿ ಕರುಚೆ. <verse eid="EXO 26:7" /><verse number="8" style="v" sid="EXO 26:8" />ಹರ್ ಎಕ್ ಕಪ್ಡೆಬಿ ತಿಸ್ ಹಾತ್ ಲಾಂಬ್ ಅನಿ ಚಾರ್ ಹಾತ್ ರುಂದ್ ರಾವ್ಚೆ, ಸಗ್ಳೆ ಕಪ್ಡೆಬಿ ಎಕುಚ್ ಅಳ್ತಿ ರಾವ್ಚೆ. <verse eid="EXO 26:8" /><verse number="9" style="v" sid="EXO 26:9" />ಎಕೆಕ್ ಕರುನ್ ಪಾಂಚ್ ಕಪ್ಡೆ ಮಿಳ್ವುನ್ ಹುರಲ್ಲ್ಯಾ ಸಾ ಕಪ್ಡ್ಯಾಕ್ನಿ ಎಕೆಕ್ ಕರುನ್ ಮಿಳ್ವುನ್ ಸಾವೆಚ್ಯಾ ಕಪ್ಡ್ಯಾಕ್ ಬಿಡಾರಾಚ್ಯಾ ಫಿಡೆ ಮುದ್ದಾಕರುನ್ ಲೊಂಬಾತ್ ಘಾಲುಚೆ. <verse eid="EXO 26:9" /><verse number="10" style="v" sid="EXO 26:10" />ಎಕೆಕ್ ಕಪ್ಡ್ಯಾಚ್ಯಾ ತುದಿಕ್ ಪನ್ನಾಪನ್ನಾಸ್ ಡೊಬ್ರೆ ಕರ್ಸುಚೆ. <verse eid="EXO 26:10" /><verse number="11" style="v" sid="EXO 26:11" />ಪನ್ನಾಸ್ ತಾಂಬ್ಯಾಚಿ ಕೊಂಡಿಯಾ ಕರ್ಸುನ್ ಎಕುಚ್ ಬಿಡಾರ್ ಹೊಯ್ಸಾರ್ಕೆ ತಿ ಕೊಂಡಿಯಾ ಸಿರ್ಕುನ್ ಸಗ್ಳೆಬಿ ಮಿಳ್ವುಚೆ. <verse eid="EXO 26:11" /><verse number="12" style="v" sid="EXO 26:12" />ಕಾಂಬರಲ್ಲ್ಯಾ ಕಪ್ಡ್ಯಾತ್ನಿ ಅರ್ದೆಕಪ್ಡೆ ಜಾಸ್ತಿ ಹೊವ್ನ್ ರ್‍ಹಾತಾ, ತೆ ಹುರಲ್ಲೆ ಕಪ್ಡೆ ಬಿಡಾರಾಚ್ಯಾ ಫಾಟ್ಲ್ಯಾ ಭಾಜುಕ್ ಮುದ್ದಾಕರುನ್ ಲೊಂಬಾತ್ ಸೊಡುಚೆ. <verse eid="EXO 26:12" /><verse number="13" style="v" sid="EXO 26:13" />ಕಾಂಬರಲ್ಲೆ ಕಪ್ಡೆ ಹಿಕ್ಡಿನ್ ಎಕ್ ಹಾತ್ ಅನಿ ತಿಕ್ಡಿನ್ ಎಕ್ ಹಾತ್ ಜಾಸ್ತಿಚೆ ರ್‍ಹಾತಾ, ತೆ ಭುತ್ತುರ್ಲೊ ಭಾಗ್ ಧಾಪಿಸಾರ್ಕೆ ಹಿಕ್ಡಿನ್ ಅನಿ ತಿಕ್ಡಿನ್ ರಾಂವ್ದಿತ್.<verse eid="EXO 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 26:14" />ಹ್ಯಾ ಕಾಂಬ್ರಾನಾಕ್ ಕಾಂಬ್ರುಕ್ ಹಾದಾಕರಲ್ಲೆ ತಾಂಬ್ಡ್ಯಾ ಬನ್ನಾಚೆ ಬಕ್ರ್ಯಾಚ್ಯಾ ಕೆಸಾನಿ ಎಕ್ ವೈಲೆ ಕಾಂಬ್ರಾನ್ ಅನಿ ಸಮುಂದರಾಚ್ಯಾ ಡುಕ್ರಾಚ್ಯಾ ಕೆಸಾನಿ ಅನಿ ಎಕ್ ವೈಲೆ ಕಾಂಬ್ರಾನ್ ಕರ್ಸುಚೆ.<verse eid="EXO 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 26:15" />ಬಿಡಾರಾಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ಚವ್ಕಟಾ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಕರ್ಸುಚೆ. <verse eid="EXO 26:15" /><verse number="16" style="v" sid="EXO 26:16" />ಹರ್ ಎಕ್ ಚವ್ಕಟ್ಬಿ ಧಾ ಹಾತ್ ಲಾಂಬಿ ಅನಿ ಎಕ್ಬಿ ಅರ್ದೆ ಹಾತ್ ರುಂದ್ ರಾವ್ಚೆ. <verse eid="EXO 26:16" /><verse number="17" style="v" sid="EXO 26:17" />ಹರ್ ಎಕ್ ಚವ್ಕಟ್ಬಿ ಅಡ್ವ್ಯಾ ಪಟ್ಟಿಯಾನಿ ಜೊಡಸಲ್ಲ್ಯಾ ದೊನ್ ನಿಲುವು ಪಟ್ಟಿಯಾಂಚೆ ರಾವ್ಚೆ, ಬಿಡಾರಾಚಿ ಸಗ್ಳಿ ಚವ್ಕಟಾಬಿ ತಸೆಚ್ ಕರಸಲ್ಲಿ ರಾವ್ಚಿ. <verse eid="EXO 26:17" /><verse number="18" style="v" sid="EXO 26:18" />ಬಿಡಾರಾಚ್ಯಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ವಿಸ್ ಚವ್ಕಟಾ ಇಬೆ ಕರ್ಸುಚೆ. <verse eid="EXO 26:18" /><verse number="19" style="v" sid="EXO 26:19" />ಚಾಳಿಸ್ ಚಾಂದಿಚೆ ಗುಂಡೆ ಕರ್ಸುನ್ ತ್ಯಾ ವಿಸ್ ಚವ್ಕಟಾಂಚ್ಯಾ ಖಾಲ್ತಿ ಥವ್ಚೆ ದೊದೊನ್ ಚವ್ಕಟಾಚ್ಯಾ ಪಟ್ಟಿಯಾಕ್ನಿ ಎಕೆಕ್ ಗುಂಡೊ ಥವ್ಚೆ. <verse eid="EXO 26:19" /><verse number="20" style="v" sid="EXO 26:20" />ತಸೆಚ್ ಬಿಡಾರಾಚ್ಯಾ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ ವಿಸ್ ಚವ್ಕಟಾ ಅನಿ <verse eid="EXO 26:20" /><verse number="21" style="v" sid="EXO 26:21" />ಹರ್ ಎಕ್ ಚವ್ಕಟಾಕ್ ದೊದೊನ್ ಚಾಂದಿಚೆ ಗುಂಡೆ ರಾವ್ಚೆ. <verse eid="EXO 26:21" /><verse number="22" style="v" sid="EXO 26:22" />ಬಿಡಾರಾಚ್ಯಾ ಫಾಟಿಕ್ಡೆ ಮಟ್ಲ್ಯಾರ್ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಸಾ ಚವ್ಕಟಾ ಕರ್ಸುಚೆ. <verse eid="EXO 26:22" /><verse number="23" style="v" sid="EXO 26:23" />ಬಿಡಾರಾಚ್ಯಾ ಫಾಟ್ಲ್ಯಾ ದೊನಿ ಮುಲ್ಲ್ಯಾಕ್ನಿ ದೊದೊನ್ ಚವ್ಕಟಾ ಕರ್ಸುಚೆ. <verse eid="EXO 26:23" /><verse number="24" style="v" sid="EXO 26:24" />ತೆ ಬುಡ್ನಾ ತುದಿಪತರ್ ಮಟ್ಲ್ಯಾರ್ ಪೈಲೆಚ್ಯಾ ಕಾಕ್ನಾ ಪತರ್ ಜೊಡ್ಸುಚೆ, ತಸೆಚ್ ದೊನಿ ಮುಲ್ಲ್ಯಾಕ್ನಿಬಿ ಕರ್ಸುಚೆ. <verse eid="EXO 26:24" /><verse number="25" style="v" sid="EXO 26:25" />ಅಸೆ ಫಾಟಿಕ್ಡೆ ಆಟ್ ಚವ್ಕಟಾ ಅನಿ ಹರ್ ಎಕ್ ಚವ್ಕಟಾಕ್ ದೊದೊನ್ ಚಾಂದಿಚೆ ಗುಂಡೆ ರಾವ್ನ್ ಒಟ್ಟು ಸೊಳಾ ಚಾಂದಿಚೆ ಗುಂಡೆ ರ್‍ಹಾತ್ಯಾತ್. <verse eid="EXO 26:25" /><verse number="26" style="v" sid="EXO 26:26" />ಅಗ್ಳಿಯಾ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಕರ್ಸುಚೆ, ಬಿಡಾರಾಚ್ಯಾ ದೊನಿ ಭಾಜುಚ್ಯಾ ಚವ್ಕಟಾಕ್ನಿ ಅನಿ, <verse eid="EXO 26:26" /><verse number="27" style="v" sid="EXO 26:27" />ತೆಜ್ಯಾ ಫಾಟ್ಲ್ಯಾ, ಮಟ್ಲ್ಯಾರ್, ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ಚವ್ಕಟಾಕ್ನಿ ಪಾಂಚ್ ಪಾಂಚ್ ಅಗ್ಳಿಯಾ ಕರ್ಸುಚೆ. <verse eid="EXO 26:27" /><verse number="28" style="v" sid="EXO 26:28" />ಚವ್ಕಟಾಚಿ ಸರ್ ಮದ್ದಿ ಹೊತ್ತಿ ಅಗ್ಳಿ ಎಕ್ ತುದಿಕ್ನಾ ಅನಿಎಕ್ ತುದಿ ಪತರ್ಬಿ ಪಾವಿ ಸಾರ್ಕಿ ರಾವ್ಚೆ. <verse eid="EXO 26:28" /><verse number="29" style="v" sid="EXO 26:29" />ತ್ಯಾ ಚವ್ಕಟಾಕ್ನಿ ಸೊನ್ಯಾಚಿ ತಗ್ಡಾ ಕಾಂಬ್ರುನ್, ತ್ಯಾತುರ್ ತ್ಯಾ ಅಗ್ಳಿಯಾಕ್ನಿ ಸೊನ್ಯಾಚಿ ಕಾಕ್ನಾ ಕರ್ಸುಚೆ. <verse eid="EXO 26:29" /><verse number="30" style="v" sid="EXO 26:30" />ತ್ಯಾ ಅಗ್ಳಿಯಾಕ್ನಿ ಸೊನ್ಯಾಚ್ಯಾ ತಗ್ಡಾನಿ ಕಾಂಬ್ರುಚೆ, ತುಕಾ ಮಿಯಾ ಡಂಗ್ಳಿತ್ ದಾಕ್ವಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಬಿಡಾರ್ ಇಬೆ ಕರ್ಸುಚೆ.<verse eid="EXO 26:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31" />ಪುಂಡಿಚ್ಯಾ ದೊರಿಯಾಂಚ್ಯಾ ಕಪ್ಡ್ಯಾತ್ನಿ ಝಾಂಬ್ಳ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ ಕೆರುಬಿಯಾ ಚಮತ್ಕಾರಾಚ್ಯಾ ಕಾಮಾನಿ ಹಾತಿಚಿ ಸಿವನ್ ಘಾಲುನ್ ಎಕ್ ಪರ್ದೊ ಕರ್ಸುಚೆ. <verse eid="EXO 26:31" /><verse number="32" style="v" sid="EXO 26:32" />ಚಾರ್ ಖಾಂಬೆ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಕರ್ಸುನ್, ಸೊನ್ಯಾಚ್ಯಾ ತಗ್ಡಾನಿ ಕಾಂಬ್ರುನ್, ತೆ ಚಾರ್ ಚಾಂದಿಚ್ಯಾ ಗುಂಡ್ಯಾ ವೈನಿ ಇಬೆ ಕರುನ್, ಸೊನ್ಯಾಚ್ಯಾ ಕೊಂಡಿಯಾನಿ ತೊ ಪರ್ದೊ ಚಾರ್ ಖಾಂಬ್ಯಾಕ್ನಿ ಸಿರ್ಕುಚೆ. <verse eid="EXO 26:32" /><verse number="33" style="v" sid="EXO 26:33" />ತೊ ಪರ್ದೊ ಕೊಂಡಿಯಾಕ್ನಿ ಸಿರಕಲ್ಲ್ಯಾ ತನ್ನಾ ತ್ಯಾತುರ್ ಕರಾರಾಚಿ ಪೆಟಿ ಹಾನುನ್ ಥವ್ಚೆ, ತೊ ಪರ್ದೊ ನಿತಳ್ ಜಾಗೊ ಅನಿ ಅಗ್ದಿ ನಿತಳ್ ಜಾಗೊ ಮನ್ತಲೆ ಎಗ್ಳೆ ಎಗ್ಳೆ ಕರ್ತಾ. <verse eid="EXO 26:33" /><verse number="34" style="v" sid="EXO 26:34" />ಅಗ್ದಿ ನಿತಳ್ ಜಾಗ್ಯಾ ವರ್‍ತಿ ಕರಾರಾಂಚ್ಯಾ ಪೆಟಿ ವರ್‍ತಿ ಕೃಪಾಸನ್ ಹಾನುನ್ ಥವ್ಚೆ. <verse eid="EXO 26:34" /><verse number="35" style="v" sid="EXO 26:35" />ಪರ್ದ್ಯಾಚ್ಯಾ ಭಾಯ್ರ್ ಮಾಚೊ ಅನಿ ಮಾಚ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ಬಿಡಾರಾಚ್ಯಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ದಿವ್ಯಾಚೊ ಖಾಂಬೊಬಿ ಥವ್ಚೆ, ಮಾಚೊ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ಡೆ ರಾವ್ಚೊ.<verse eid="EXO 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 26:36" />ಬಿಡಾರಾಚ್ಯಾ ದಾರಾಕ್ ಪುಂಡಿಚ್ಯಾ ದೊರ್ಯಾಚ್ಯಾ ಕಪ್ಡ್ಯಾನ್ ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ ಚಮತ್ಕಾರಾಚ್ಯಾ ಕಾಮಾನಿ ಹಾತಿಚಿ ಸಿವನ್ ಘಾಲುನ್ ಪರ್ದೊ ಕರ್ಸುಚೆ. <verse eid="EXO 26:36" /><verse number="37" style="v" sid="EXO 26:37" />ತೊ ಪರ್ದೊ ಸರ್ಕುಕ್ ಸಾಟ್ನಿ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಪಾಂಚ್ ಖಾಂಬೆ ಕರ್ಸುನ್ ಸೊನ್ಯಾಚಿ ತಗ್ಡಾ ಕಾಂಬ್ರುಚೆ, ತೆಚಿ ಕೊಂಡಿಯಾ ಸೊನ್ಯಾನ್ ಕರ್ಸುನ್ ತೆಜ್ಯಾ ಸಾಟ್ನಿ ಪಾಂಚ್ ತಾಂಬ್ಯಾಚೆ ಗುಂಡೆ ಕರ್ಸುಚೆ.<verse eid="EXO 26:37" /></para>
  <chapter eid="EXO 26" />
  <chapter number="27" style="c" sid="EXO 27" />
  <para style="s">ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1" />ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಪಾಂಚ್ ಹಾತ್ ಲಾಂಬ್ ಅನಿ ಪಾಂಚ್ ಹಾತ್ ರುಂದ್ ಚವ್ಕ್ ಕರ್ಸುಚೆ, ತೆ ತಿನ್ ಹಾತ್ ಉಪ್ಪರ್ ರಾವ್ಚೆ. <verse eid="EXO 27:1" /><verse number="2" style="v" sid="EXO 27:2" />ತೆಜ್ಯಾ ಚಾರಿ ಮುಲ್ಲ್ಯಾಕ್ನಿ ಚಾರ್ ಖಾಂಬೆ ಕರ್ಸುಚೆ, ತೆ ಬಲಿಚ್ಯಾ ಕಟ್ಟ್ಯಾಕ್ ಲಾಗುನ್ ರಾವ್ಚೆ, ತ್ಯಾ ಕಟ್ಟ್ಯಾಕ್ ತಾಂಬ್ಯಾಚಿ ತಗ್ಡಾ ಕಾಂಬ್ರುಚೆ. <verse eid="EXO 27:2" /><verse number="3" style="v" sid="EXO 27:3" />ತ್ಯಾತುರ್ಲಿ ರಕ್ಕಾ ಕಾಡುಕ್ ಆಯ್ದಾನಾ ಕರ್ಸುಚೆ, ಸಲ್ಕಿಯಾ, ಟೊಪಾ, ಕಾಟೆ ಅನಿ ಅಗಿಪೆಟಿಯಾ ಕರ್ಸುಚೆ, ತೆ ಸಗ್ಳೆಬಿ ತಾಂಬ್ಯಾಚೆ ಹೊವ್ನ್ ರಾವ್ಚೆ. <verse eid="EXO 27:3" /><verse number="4" style="v" sid="EXO 27:4" />ಬಲಿಚ್ಯಾ ಕಟ್ಟ್ಯಾಕ್ ಎನ್ತಲ್ಯಾ ಕಾಮಾನಿ ತಾಂಬ್ಯಾಚಿ ಜಾಳ್ಗಿಯಾ ಕರ್ಸುಚೆ, ತ್ಯಾ ಜಾಳ್ಗಿಚ್ಯಾ ಚಾರಿ ಮುಲ್ಲ್ಯಾಕ್ನಿ ತಾಂಬ್ಯಾಚಿ ಕಾಕ್ನಾ ಘಾಲ್ಸುಚೆ. <verse eid="EXO 27:4" /><verse number="5" style="v" sid="EXO 27:5" />ತಿ ಜಾಳ್ಗಿ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಭೊತ್ಯಾನಿ ಖಾಲ್ತಿ ರಾವ್ನ್, ಕಟ್ಟ್ಯಾಚ್ಯಾ ಬುಡ್ನಾ ಮದ್ದಿ ಪತರ್ ರಾಯ್ ಸಾರ್ಕೆ ಘಾಲ್ಸುಚೆ. <verse eid="EXO 27:5" /><verse number="6" style="v" sid="EXO 27:6" />ಕಟ್ಟ್ಯಾಕ್ ಉಕಲ್ತಲೆ ದಾಂಡೆ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಕರ್ಸುನ್ ತಾಂಬ್ಯಾಚಿ ತಗ್ಡಾ ಕಾಂಬ್ರುಚೆ. <verse eid="EXO 27:6" /><verse number="7" style="v" sid="EXO 27:7" />ತೆ ದಾಂಡೆ ತ್ಯಾ ಕಾಕ್ನಾಕ್ನಿ ಮಿಳ್ವುತಾನಾ, ತೆ ಬಲಿಚೊ ಕಟ್ಟೊ ಉಕ್ಲು ಸಾಟ್ನಿ ತೆಜ್ಯಾ ದೊನಿ ಭಾಜುಕ್ನಿಬಿ ರ್‍ಹಾತಾತ್. <verse eid="EXO 27:7" /><verse number="8" style="v" sid="EXO 27:8" />ತ್ಯಾ ಕಟ್ಟ್ಯಾಕ್ ಫಳಿಯಾನಿ ಪೆಟಿ ಸಾರ್ಕೆ ಕರ್ಸುಚೆ, ತುಕಾ ಮಿಯಾ ಡಂಗ್ಳಿತ್ ದಾಕ್ವುಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ತೆ ಕರ್ಸುಚೆ.<verse eid="EXO 27:8" /></para>
  <para style="s">ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಇದ್ರಾಚೊ ಜಾಗೊ</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9" />ಅನಿ ಬಿಡಾರಾಕ್ ದಾರ್ ಕರುಚೆ, ತ್ಯಾ ದಾರಾಚ್ಯಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ಪರ್ದೆ ರಾವ್ಚೆ, ತೆ ಪರ್ದೆ ಪುಂಡಿಚ್ಯಾ ದೊರಿಚ್ಯಾ ಕಪ್ಡ್ಯಾನಿ ಕರುನ್, ಸೆಂಬರ್ ಹಾತ್ ಲಾಂಬ್ ರಾವ್ಚೆ. <verse eid="EXO 27:9" /><verse number="10" style="v" sid="EXO 27:10" />ತ್ಯಾ ಭಾಜುಕ್ ವಿಸ್ ಖಾಂಬೆ ಅನಿ ತೆಕಾ ವಿಸ್ ತಾಂಬ್ಯಾಚೆ ಗುಂಡೆ ರಾವ್ಚೆ. <verse eid="EXO 27:10" /><verse number="11" style="v" sid="EXO 27:11" />ಖಾಂಬ್ಯಾಕ್ನಿ ಚಾಂದಿಚಿ ಕೊಂಡಿಯಾ ರಾವ್ಚಿ, ತಸೆಚ್ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ ಸೆಂಬರ್ ಹಾತ್ ಲಾಂಬ್ ಪರ್ದೆ, ವಿಸ್ ಖಾಂಬೆ ಅನಿ ವಿಸ್ ತಾಂಬ್ಯಾಚೆ ಗುಂಡೆಬಿ ರಾವ್ಚೆ, ಖಾಂಬ್ಯಾಂಚಿ ಕಟ್ಟಾ ಅನಿ ಕೊಂಡಿಯಾ ಚಾಂದಿಚಿ ರಾವ್ಚಿ. <verse eid="EXO 27:11" /><verse number="12" style="v" sid="EXO 27:12" />ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ದಾರಾಚ್ಯಾ ರುಂದಿ ಪನ್ನಾಸ್ ಹಾತ್ ಲಾಂಬ್ ಪರ್ದೆ ಅನಿ ಧಾ ಖಾಂಬೆ ಧಾ ಗುಂಡೆಬಿ ರಾವ್ಚೆ. <verse eid="EXO 27:12" /><verse number="13" style="v" sid="EXO 27:13" />ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ಬಿ ದಾರಾಚೆ ರುಂದಿ ಪನ್ನಾಸ್ ಹಾತ್ ರಾವ್ಚೆ. <verse eid="EXO 27:13" /><verse number="14" style="v" sid="EXO 27:14" />ಥೈ ದಾರಾಚ್ಯಾ ದೊನಿ ಭಾಜುಕ್ನಿಬಿ ಪಂದ್ರಾ ಹಾತ್ ಲಾಂಬ್ ಪರ್ದೆ, <verse eid="EXO 27:14" /><verse number="15" style="v" sid="EXO 27:15" />ತೆಕಾ ತಿ ತಿನ್ ಖಾಂಬೆ ಅನಿ ಮುಳಾಚೆ ಗುಂಡೆ ರಾವ್ಚೆ. <verse eid="EXO 27:15" /><verse number="16" style="v" sid="EXO 27:16" />ದಾರಾಚ್ಯಾ ಇದ್ರಾಕುಚ್ ವಿಸ್ ಹಾತಿಚೊ ಪರ್ದೊ ರಾವ್ಚೊ, ತೆ ಪುಂಡಿಚ್ಯಾ ದೊರಿಚ್ಯಾ ಕಪ್ಡ್ಯಾನ್ ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ, ಹಾತಿಚ್ಯಾ ಕಾಮಾನಿ ಕರ್ಸುಚೆ, ದಾರಾಕ್ ಚಾರ್ ಖಾಂಬೆ ಅನಿ ಗುಂಡೆ ರಾವ್ಚೆ. <verse eid="EXO 27:16" /><verse number="17" style="v" sid="EXO 27:17" />ದಾರಾಚ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಖಾಂಬ್ಯಾಕ್ನಿಬಿ ಚಾಂದಿಚಿ ಕಟ್ಟಾ ಅನಿ ಚಾಂದಿಚಿ ಕೊಂಡಿಯಾ ಅನಿ ತಾಂಬ್ಯಾಚೆ ಗುಂಡೆ ರಾವ್ಚೆ. <verse eid="EXO 27:17" /><verse number="18" style="v" sid="EXO 27:18" />ದಾರ್ ಸೆಂಬರ್ ಹಾತ್ ಲಾಂಬ್ ಅನಿ ಪನ್ನಾಸ್ ಹಾತ್ ರುಂದ್ ರಾವ್ಚೆ, ತೆಜ್ಯಾ ಭೊತ್ಯಾನ್ ಹೊತ್ತೊ ಪರ್ದೊ ಪುಂಡಿಚ್ಯಾ ದೊರ್ಯಾಚ್ಯಾ ಕಪ್ಡ್ಯಾನಿ ಕರುನ್ ಪಾಂಚ್ ಹಾತ್ ಉಪ್ಪರ್ ರಾವ್ಚೆ, ತೆಕಾ ಸಮಂದ್ ಪಡಲ್ಲೆ ಗುಂಡೆ ತಾಂಬ್ಯಾಚೆ ಹೊವ್ನ್ ರಾವ್ಚೆ. <verse eid="EXO 27:18" /><verse number="19" style="v" sid="EXO 27:19" />ಬಿಡಾರಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚ್ಯಾ ಕಾಮಾಕ್ನಿ ಪಾಜೆ ಹೊಲ್ಲಿ ಸಾಮಾನಾ ಅನಿ ಬಿಡಾರಾಚೆ ಖಾಂಬೆ ದಾರಾತ್ಲೆ ಖಾಂಬೆಬಿ ತಾಂಬ್ಯಾಚೆ ಹೊವ್ನ್ ರಾವ್ಚೆ.<verse eid="EXO 27:19" /></para>
  <para style="s">ದಿವ್ಯಾಚಿ ಕಾಳ್ಜಿ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20" />ಕನ್ನಾಬಿ ದಿವೊ ಪೆಟಿ ಸಾರ್ಕೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ತೆಲಾಚ್ಯಾ ಝಾಡಾಚಿ ಫಾಳಾ ಕಾಂಡುನ್ ಚೊಕ್ಕ್ ತೆಲ್ ಕಾಡುನ್ಗೆವ್ಚೆ ಮನುನ್ ತೆಂಕಾ ಹುಕುಮ್ ದಿ. <verse eid="EXO 27:20" /><verse number="21" style="v" sid="EXO 27:21" />ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಬಿಡಾರಾತ್ ಕರಾರಾಚ್ಯಾ ಪೆಟಿಚ್ಯಾ ಫಿಡೆ ಹೊತ್ತ್ಯಾ ಪರ್ದ್ಯಾಚ್ಯಾ ಭಾಯ್ರ್ ಆರೊನ್ ಅನಿ ತೆಚಿ ಲೆಕಾ ಸಾಂಜೆಕ್ನಾ ಸಕ್ಕಾಳ್ ಪತರ್ಬಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ತೆ ದಿವೆ ಸಮಾ ಕರುನ್ಗೆತ್ ರಾವ್ಚೆ, ಇಜ್ರಾಯೆಲ್ ಅನಿ ತೆಂಚ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ ಸದಾ ಸರ್ವತಾಕ್ ಹೊ ನೆಮ್ ಪಾಳುಚೆ.<verse eid="EXO 27:21" /></para>
  <chapter eid="EXO 27" />
  <chapter number="28" style="c" sid="EXO 28" />
  <para style="s">ಯಾಜಕಾನ್ ನೆಸ್ತಲ್ಯಾ ಕಪ್ಡ್ಯಾಂಚ್ಯಾ ವಿಶಯಾತ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಸಾಂಗಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ತುಜೊ ಭಾವ್ ಆರೊನ್ ಅನಿ ತುಜಿ ಲೆಕಾ ನಾದಾಬ್, ಅಬಿಹು, ಎಲಿಯಾಜರ್ ಅನಿ ಇತಾಮಾರ್ ಹೆಂಕಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾಕ್ನಾ ತುಜ್ಯಾಕ್ಡೆ ಯೆವ್ಕ್ ಸಾಂಗ್, ತೆನಿ ಯಾಜಕಾ ಹೊವ್ನ್ ಮಾಜಿ ಸೆವಾ ಕರುಕ್ ಪಾಜೆ. <verse eid="EXO 28:1" /><verse number="2" style="v" sid="EXO 28:2" />ತುಜೊ ಭಾವ್ ಆರೊನಾಕ್ ಬರೆ ಶಿಂಗಾರ್ ಅನಿ ಮಾನ್ ಗಾವಿ ಸಾರ್ಕೆ ಕಪ್ಡೆ ತಯಾರ್ ಕರ್ಸುಚೆ. <verse eid="EXO 28:2" /><verse number="3" style="v" sid="EXO 28:3" />ಮಿಯಾ ಶಾನೆಪಾನಾಚೆ ವರು ದಿಲ್ಲ್ಯಾ ಮಾನ್ಸಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲುನ್, ತೆಂಚ್ಯಾ ಹಾತಾನಿ ಕಪ್ಡೆ ತಯಾರ್ ಕರ್ಸುಚೆ, ಆರೊನ್ ತೆ ಕಪ್ಡೆ ನೆಸುನ್ಗೆವ್ನ್ ಮಾಜಿ ಯಾಜಕ್ ಸೆವಾ ಕರುಕ್ ನೆಮಕ್ ಹೊತಾ. <verse eid="EXO 28:3" /><verse number="4" style="v" sid="EXO 28:4" />ಕರ್ಸುಚೆ ಹೊಲ್ಲೆ ಕಪ್ಡೆ ಖಲೆ ಮಟ್ಲ್ಯಾರ್, ಪದಕಾಚಿ ಪಿಶ್ವಿ, ಮೊಟ್ಯಾಯಾಜಕಾಚಿ ಕವ್ಚಿಸಾರ್ಕಿ ವೈಲಿ ಅಂಗಿ, ಝಗೊ, ಪಾವ್ಡ್, ಕಂಬ್ರೆಚೊ ಪಟ್ಟೊ, ಅನಿ ತುಜೊ ಭಾವ್ ಆರೊನಾಚಿ ಲೆಕಾ ಯಾಜಕಾ ಹೊವ್ಕ್ ಸಾಟ್ನಿ ತೆಂಕಾಬಿ ಕಪ್ಡೆ ತಯಾರ್ ಕರ್ಸುಚೆ. <verse eid="EXO 28:4" /><verse number="5" style="v" sid="EXO 28:5" />ಲೊಕಾನಿ ಕಾನಿಕ್ ದಿಲ್ಲೆ ಸೊನೆ, ಅನಿ ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾಚೆ ಕಪ್ಡೆ ತ್ಯಾ ಕಾಮಾಕ್ ವಾಪ್ರುಚೆ.<verse eid="EXO 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 28:6" />ಎಫೊದ್ ಮನ್ತಲ್ಯಾ ಮೊಟ್ಟ್ಯಾ ಯಾಜಕಾಚೆ ಕವ್ಚಿ ಪುಂಡಿಚ್ಯಾ ದೊರಿಚ್ಯಾ ಕಪ್ಡ್ಯಾನಿ ಕರ್ಸುನ್, ಸೊನ್ಯಾಚ್ಯಾ ದೊರ್ಯಾನ್ ಅನಿ ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನ್ ಹಾತಿಚೆ ಕಾಮ್ ಕರ್‍ತಲ್ಯಾಂಚ್ಯಾಕ್ನಾ ಶಿಂಗಾರ್ ಕರ್ಸುಚೆ. <verse eid="EXO 28:6" /><verse number="7" style="v" sid="EXO 28:7" />ತ್ಯಾ ಕವ್ಚಿಚ್ಯಾ ಖಾಂಜ್ಯಾ ವರ್‍ತಿ ದೊನ್ ಪಟ್ಟಿಯಾ ರಾವ್ಚಿ, ಅನಿ ತೆಚಿ ದೊನಿ ತುದಿಯಾಬಿ ಜೊಡ್ಸುನ್ ರಾವ್ಚೆ. <verse eid="EXO 28:7" /><verse number="8" style="v" sid="EXO 28:8" />ಕವ್ಚಿಚ್ಯಾ ವರ್‍ತಿ ಹೊತ್ತೆ ಕಾಮ್, ಕಂಬ್ರೆಚ್ಯಾ ಕವ್ಚಿಕ್ ಮಿಳುನ್ ರಾವ್ನ್, ತಸೆಚ್ ಪುಂಡಿಚ್ಯಾ ದೊರ್ಯಾಚ್ಯಾ ಕಪ್ಡ್ಯಾನಿ ಕರಲ್ಲೆ ಹೊವ್ನ್, ಸೊನ್ಯಾಚ್ಯಾ ದೊರ್ಯಾನ್ ಅನಿ ಝಾಂಬ್ಳ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ ಶಿಂಗಾರ್ ಕರುನ್ ರಾವ್ಚೆ. <verse eid="EXO 28:8" /><verse number="9" style="v" sid="EXO 28:9" />ಅನಿ ತಿಯಾ ದೊನ್ ಗುಂಡೆ ಘೆವ್ನ್, ತೆಜ್ಯಾ ವರ್‍ತಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಕುಳಿಯಾಂಚಿ ನಾವಾ ಲಿವ್ಸುಚೆ. <verse eid="EXO 28:9" /><verse number="10" style="v" sid="EXO 28:10" />ಎಕ್ ಗುಂಡ್ಯಾವರ್‍ತಿ ಸಾ ನಾಂವಾ ಅನಿ ಎಕ್ ಗುಂಡ್ಯಾ ವರ್‍ತಿ ಸಾ ನಾವಾ ತೆಂಚ್ಯಾ ಉಪಾಜಲ್ಲ್ಯಾ ಇಸಬಾ ಸಾರ್ಕೆ ಲಿವ್ಚೆ. <verse eid="EXO 28:10" /><verse number="11" style="v" sid="EXO 28:11" />ಛಪ್ಪ್ಯಾಚೊ ಗುಂಡೊ ಲಿವಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಹ್ಯಾ ದೊನಿಬಿ ಗುಂಡ್ಯಾ ವೈನಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಕುಳಿಯಾಂಚಿ ನಾವಾ ಲಿವ್ಸುನ್, ಗುಂಡ್ಯಾಕ್ನಿ ಕುಂದನಾತ್ ಥವ್ಚೆ. <verse eid="EXO 28:11" /><verse number="12" style="v" sid="EXO 28:12" />ತ್ಯಾ ಗುಂಡ್ಯಾಕ್ನಿ ಖಾಂಜ್ಯಾ ವೈಲ್ಯಾ ಕವ್ಚಿಚ್ಯಾ ಪಟ್ಟಿಯಾವೈನಿ ಭಾಂದುಚೆ, ಹೆ ಗುಂಡೆ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಯಾದಿಚೆ ಗುಂಡೆ ಹೊವ್ನ್ ರ್‍ಹಾತ್ಯಾತ್, ಆರೊನ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಜಾತಾನಾ, ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಕುಳಿಯಾಂಚಿ ನಾವಾ ತೆಜ್ಯಾ ಯಾದೆಕ್ ಹಾನು ಸಾಟ್ನಿ ಹೆ ಅಪ್ನಾಚ್ಯಾ ದೊನಿ ಖಾಂಜ್ಯಾ ವೈನಿ ನೆಸುನ್ಗೆವ್ನ್ ಜಾತಾ.<verse eid="EXO 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 28:13" />ತೆ ಗುಂಡೆ ಬರೆ ಕರುನ್ ಥವ್ಕ್ ಸೊನ್ಯಾಚಿ ಸರ್ಪಳಿ ಕರುನ್ ಪೆಟಿಯಾ ಕರ್ಸುಚೆ. <verse eid="EXO 28:13" /><verse number="14" style="v" sid="EXO 28:14" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಎನ್ತಲ್ಯಾ ಕಾಮಾನಿ ದೊರಿಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ದೊನ್ ಶುದ್ದ್ ಸೊನ್ಯಾಚಿ ಸರ್ಪೊಳಿಯಾ ಕರುನ್ ಗುಂಡ್ಯಾಂಚ್ಯಾ ಪೆಟಿಯಾಕ್ನಿ ಸಿರ್ಕುಚೆ.<verse eid="EXO 28:14" /></para>
  <para style="s">ಛಾತಿಚೊ ಕವ್ಚಿ</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15" />ಅನಿ ಛಾತಿಚೊ ಪದ್ಕಾಚೊ ಕವ್ಚಿ<note caller="+" style="f"><char style="fr" closed="false">28:15 </char><char style="ft" closed="false">ಛಾತಿಚ್ಯಾ ಪದ್ಕಾಚೊ ಕವ್ಚಿ ಮಟ್ಲ್ಯಾರ್, “ದೆವಾಚೊ ನಿರ್ದಾರ್” </char></note> ಹಾತಿಚ್ಯಾ ಕಾಮಾನಿ ಕರ್ಸುಚೆ, ತೆ ಕವ್ಚಿಚ್ಯಾ ಸಾರ್ಕೆಚ್ ಸೊನ್ಯಾಚ್ಯಾ ದೊರ್ಯಾನ್ ಅನಿ ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ ಕರ್ಸುಚೆ. <verse eid="EXO 28:15" /><verse number="16" style="v" sid="EXO 28:16" />ತೆ ಎಕ್ ಗೆನ್ ಲಾಂಬಿ ಅನಿ ಎಕ್ ಗೆನ್ ರುಂದ್ ಅನಿ ದೊನ್ ಪರ್ದ್ಯಾನಿ ಚವ್ಕ್ ಆಕಾರಾಚೆ ರಾವ್ಚೆ. <verse eid="EXO 28:16" /><verse number="17" style="v" sid="EXO 28:17" />ತೆಜ್ಯಾ ಫಿಡ್ಲ್ಯಾ ಭಾಗಾತ್ ಚಾರ್ ಸಾಲಾನಿ ಜವೆಚ್ಯಾ ಗುಂಡ್ಯಾನಿ ರತ್ನಾ ಕರ್ಸುಚೆ, ಅನಿ ಪೈಲೆಚ್ಯಾ ಸಾಲಾತ್, ಮಾನಿಕ್ಯ, ಪುಶ್ಪರಾಗ್, ಸ್ಪಟಿಕ್, <verse eid="EXO 28:17" /><verse number="18" style="v" sid="EXO 28:18" />ದೊನ್ವೆಚ್ಯಾ ಸಾಲಾತ್ ಪಚ್ಚೆ, ಇಂದ್ರನಿಳ್, ವಜ್ರ, <verse eid="EXO 28:18" /><verse number="19" style="v" sid="EXO 28:19" />ತಿನ್ವೆಚ್ಯಾ ಸಾಲಾತ್, ಸುವರ್ನ್ ರತ್ನ್, ಸುರ್ಯಕಾಂತ್, ಪದ್ಮ್ ರಾಗ್, <verse eid="EXO 28:19" /><verse number="20" style="v" sid="EXO 28:20" />ಚಾರ್ವೆಚ್ಯಾ ಸಾಲಾತ್, ಪಿತರತ್ನ, ಬೆರುಲ್ಲ, ವೈಡುರ್ಯ, ಸೊನ್ಯಾಚ್ಯಾ ಜವೆಚ್ಯಾ ಗುಂಡ್ಯಾತ್ನಿ ಮಿಳ್ವುಚೆ. <verse eid="EXO 28:20" /><verse number="21" style="v" sid="EXO 28:21" />ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಕುಳಿಯಾಂಚ್ಯಾ ಅಂಕ್ಯಾಕ್ ಸಮಾ ಹೊಯ್ಸಾರ್ಕೆ ಬಾರಾ ಗುಂಡೆ ರಾವ್ಚೆ, ಮುದ್ರಾ ರತ್ನಾತ್ ಕೊರದಲ್ಲೆ ಸಾರ್ಕೆ ಹರ್ ಎಕ್ ಗುಂಡ್ಯಾ ವರ್‍ತಿ ಎಕೆಕ್ ಕುಳಿಚೆ ನಾವ್ ಕೊರ್ದುಚೆ.<verse eid="EXO 28:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 28:22" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ತ್ಯಾ ಪದಕಾಚ್ಯಾ ವರ್‍ತಿ ದೊರಿಯಾಂಚ್ಯಾ ಸಾರ್ಕೆ ನಿತಳ್ ಸೊನ್ಯಾನ್ ಎನ್ತಲ್ಯಾ ಕಾಮಾನ್ ಸರ್ಪೊಳಿಯಾ ಕರ್ಸುಚೆ. <verse eid="EXO 28:22" /><verse number="23" style="v" sid="EXO 28:23" />ದೊನ್ ಸೊನ್ಯಾಚಿ ಮುದ್ದಿಯಾ ಕರ್ಸುನ್ ಪದಕಾಚ್ಯಾ ದೊನಿ ಮುಲ್ಲ್ಯಾಕ್ನಿ ಲಾವ್ಚೆ. <verse eid="EXO 28:23" /><verse number="24" style="v" sid="EXO 28:24" />ಅನಿ ತಿ ದೊನಿ ಸರ್ಪೊಳಿಯಾ ಪದಕಾಚ್ಯಾ ಮುಲ್ಲ್ಯಾತ್ಲ್ಯಾ ಮುದ್ದಿಯಾಕ್ನಿ ಸಿರ್ಕುಚೆ. <verse eid="EXO 28:24" /><verse number="25" style="v" sid="EXO 28:25" />ತ್ಯಾ ಸರ್ಪೊಳಿಯಾಂಚ್ಯಾ ತುದಿಕ್ನಿ ಕವ್ಚಿಚ್ಯಾ ಭುಜೆಚ್ಯಾ ಪಟ್ಟಿಯಾವೈನಿ ಹೊತ್ತ್ಯಾ ದೊನಿ ಜವೆಂಚ್ಯಾ ಫಿಡ್ಲ್ಯಾ ಭಾಗಾತ್ ಸಿರ್ಕುಚೆ. <verse eid="EXO 28:25" /><verse number="26" style="v" sid="EXO 28:26" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ದೊನ್ ಸೊನ್ಯಾಚಿ ಮುದ್ದಿಯಾ ಕರ್ಸುನ್ ಪದಕಾಚ್ಯಾ ಭುತ್ತರ್ಲ್ಯಾ ಮುಲ್ಲ್ಯಾತ್ ಕವ್ಚಿಚ್ಯಾ ಜಗ್ಗೊಳುಚ್ ಥವ್ಚೆ. <verse eid="EXO 28:26" /><verse number="27" style="v" sid="EXO 28:27" />ಅನಿ ದೊನ್ ಸೊನ್ಯಾಚಿ ಮುದ್ದಿಯಾ ಕರ್ಸುನ್ ಕವ್ಚಿಚ್ಯಾ ದೊನಿ ಭುಜಾಂಚ್ಯಾ ಪಟ್ಟಿಯಾಂಚ್ಯಾ ಖಾಲ್ತಿ, ಅನಿ ಕವ್ಚಿ ಜೊಡಸಲ್ಲ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ಜಗ್ಗೊಳ್, ಅನಿ ಕಂಬ್ರೆಚ್ಯಾ ಪಟ್ಟ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಥವ್ಚೆ. <verse eid="EXO 28:27" /><verse number="28" style="v" sid="EXO 28:28" />ಪದಕ್ ಕಂಬ್ರೆಚ್ಯಾ ಪಟ್ಟ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಬಿಗುಹೊವ್ನ್ ರಾಯ್ಸಾರ್ಕೆ ಅನಿ ಕವ್ಚಿಕ್ನಾ ಸುಟುನ್ ಪಡಿನಾ ಸಾರ್ಕೆ ತೆಚಿ ಮುದ್ದಿಯಾ ಕವ್ಚಿಚ್ಯಾ ಮುದ್ದಿಯಾಕ್ನಿ ನಿಳ್ಯಾ ದೊರ್ಯಾನಿ ಭಾಂದುಚೆ.<verse eid="EXO 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 28:29" />ದೆವಾಚ್ಯಾ ನಿರ್ದಾರಾಚ್ಯಾ ಪದಕಾ ವರ್‍ತಿ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಕುಳಿಯಾಂಚಿ ನಾವಾ ಲಿವಲ್ಲಿ ಹೊತ್ತ್ಯಾ ಸಾಟ್ನಿ, ಆರೊನ್ ಸದ್ದಾ ನಿತಳ್ ಜಾಗ್ಯಾ ವರ್‍ತಿ ಜಾತಾನಾ, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಯಾದೆಕ್ ಹಾನುಸಾಟ್ನಿ ತಿ ನಾವಾ ಅಪ್ನಾಚ್ಯಾ ಛಾತಿ ವರ್‍ತಿ ಥವ್ನ್ ಘೆವ್ನ್ ಜಾವ್ಚೊ. <verse eid="EXO 28:29" /><verse number="30" style="v" sid="EXO 28:30" />ದೆವಾಚೊ ನಿರ್ದಾರ್ ಕಳ್ವುತಲಿ ಉರಿಮ್, ತುಮ್ಮಿಮ್ ಮನ್ತಲಿ ವಸ್ತಾ ತ್ಯಾ ಛಾತಿಚ್ಯಾ ಕವ್ಚಿತ್ ಥವ್ಚೆ, ಆರೊನ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಜಾತಾನಾ ತೆ ತೆಜ್ಯಾ ಛಾತಿ ವರ್‍ತಿ ರ್‍ಹಾತಾ, ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಕರುಚೆ ಹೊಲ್ಲ್ಯಾ ಕಾಮಾಚೆ ದೆವಾಚೊ ನಿರ್ದಾರ್ ಆರೊನಾನ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಕನ್ನಾಬಿ ನೆಸುನ್ಗೆವ್ನ್ ರಾವ್ಚೆ.<verse eid="EXO 28:30" /></para>
  <para style="s">ಯಾಜಕಾಂಚೆ ಹುರಲ್ಲೆ ಕಪ್ಡೆ</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31" />ತಿಯಾ ಮೊಟ್ಟ್ಯಾ ಯಾಜಕಾನ್ ಕವ್ಚಿಚ್ಯಾ ವಾಂಗ್ಡಾ ನೆಸುಚಿ ಹೊಲ್ಲಿ ವೈಲಿ ಅಂಗಿ ಝಾಂಬ್ಳ್ಯಾ ಬನ್ನಾಚ್ಯಾ ಕಪ್ಡ್ಯಾನುಚ್ ಕರ್ಸುಚೆ. <verse eid="EXO 28:31" /><verse number="32" style="v" sid="EXO 28:32" />ತೆಕಾ ಟಕ್ಲೆ ಗುಸ್ವುಕ್ ಜಾಗೊ ರಾವ್ಚೊ, ತೆ ಪಿಂಜುನ್ ಜಾಯ್ನಾ ಸಾರ್ಕೆ ಯುದ್ದಾಚ್ಯಾ ಕವ್ಚಿಚ್ಯಾ ಗತಿನ್ ತ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ಭೊತ್ಯಾನ್ ಹಾತಿಚಿ ಸಿವನ್ ಘಾಲ್ಸುಚೆ. <verse eid="EXO 28:32" /><verse number="33" style="v" sid="EXO 28:33" />ವೈಲ್ಯಾ ಅಂಗಿಚ್ಯಾ ಭೊತ್ಯಾನ್ ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ ದಾಳಿಂಬ್ರ್ ಹನ್ನಾ ಸಾರ್ಕೆ ಚಂಡಾ ಅನಿ ತೆಜ್ಯಾ ಮದ್ದಿ ಗೆಜ್ಜಿ ಲಾವ್ಚೆ. <verse eid="EXO 28:33" /><verse number="34" style="v" sid="EXO 28:34" />ಎಕಾಚ್ಯಾ ಮಾನಾ ಎಕ್ ದಾಳಿಂಬ್ರಾಚಿ ಚಂಡಾ ಅನಿ ಸೊನ್ಯಾಚೆ ಗೆಜ್ಜಿ ತ್ಯಾ ವೈಲ್ಯಾ ಅಂಗಿಚ್ಯಾ ಭೊತ್ಯಾನಿ ರಾವ್ಚೆ. <verse eid="EXO 28:34" /><verse number="35" style="v" sid="EXO 28:35" />ಆರೊನಾನ್ ಸೆವಾ ಕರ್ತಾನಾ ತಿ ಅಂಗಿ ನೆಸುನ್ಗೆವ್ಚೆ, ತೊ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಪವಿತ್ರ್ ಜಾಗ್ಯಾಕ್ ಜಾತಾನಾ ಅನಿ ಯೆತಾನಾ ಮರಿನಾ ಸಾರ್ಕೆ ತ್ಯಾ ಗೆಜ್ಜ್ಯಾಂಚೊ ನಾದ್ ಆಯ್ಕೊ ಯೆವ್ಚೊ. <verse eid="EXO 28:35" /><verse number="36" style="v" sid="EXO 28:36" />ನಿತಳ್ ಸೊನ್ಯಾನ್ ಪಟ್ಟೊ ಕರ್ಸುನ್ ಮುದ್ರೆ ಕೊರದಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತೆಜ್ಯಾ ವರ್‍ತಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ವಾಟ್ಯಾಚೆ ಮನುನ್ ಕೊರ್ದುಚೆ. <verse eid="EXO 28:36" /><verse number="37" style="v" sid="EXO 28:37" />ತೆ ಪಾವ್ಡಾಕ್ ಭಾಂದುಸಾಟ್ನಿ ತೆಕಾ ಝಾಂಬ್ಳ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನ್ ಭಾಂದುಚೆ, ಅನಿ ತೆ ಪಾವ್ಡಾಚ್ಯಾ ಫಿಡ್ಲ್ಯಾ ಭಾಜುಕ್ ರಾವ್ಚೆ. <verse eid="EXO 28:37" /><verse number="38" style="v" sid="EXO 28:38" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಕಾನಿಕ್ ದಿಲ್ಲ್ಯಾ ದೆವಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಸಾಮಾನಾತ್ನಿ ಕಾಯ್ತರಿಬಿ ದೊಶ್ ರಾಲ್ಯಾರ್, ಆರೊನಾನ್ ತೊ ಪಟ್ಟೊ ಅಪ್ನಾಚ್ಯಾ ಕಪ್ಳಾ ವರ್‍ತಿ ನೆಸುನ್ಗೆವ್ನ್ ದೊಶ್ ಅಪ್ನಿ ವಯ್ಸುನ್ ಘೆಟಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತೆಂಕಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಸ್ವಿಕಾರ್ ಕರುನ್ ಹೊತಾ. <verse eid="EXO 28:38" /><verse number="39" style="v" sid="EXO 28:39" />ಆರೊನಾನ್ ನೆಸುಚಿ ಹೊಲ್ಲಿ ಅಂಗಿ ದೊರ್ಯಾನಿ ಕರ್ಸುಚೆ, ಅನಿ ತೆಜೊ ಪಾವ್ಡೊ ದೊರ್ಯಾನಿ ಕರ್ಸುಚೆ, ತೆಜೊ ಕಂಬ್ರೆಚೊ ಪಟ್ಟೊ ಕಸುತಿಚ್ಯಾ ಕಾಮಾನಿ ಕರ್ಸುಚೆ.<verse eid="EXO 28:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 28:40" />ಆರೊನಾಚ್ಯಾ ಲೆಕಾಕ್ನಿ ಸಮಾ ಮಾನ್ ಅನಿ ಶಿಂಗಾರ್ ಹೊಯ್ಸಾರ್ಕೆ ತೆಂಕಾ ಝಗೆ ಅನಿ ಪಾವ್ಡೆ ಕರ್ಸುಚೆ. <verse eid="EXO 28:40" /><verse number="41" style="v" sid="EXO 28:41" />ತೆ ಕಪ್ಡೆ ತುಜೊ ಭಾವ್ ಆರೊನ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾಕ್ನಿ ನೆಸ್ವುನ್ ಅಭಿಶೆಕ್ ಕರ್ಸುನ್ ಕಾಮಾಕ್ ನೆಮ್ಸುಚೆ, ತನ್ನಾ ತೆನಿ ಮಾಜಿ ಯಾಜಕಾ ಹೊತಾತ್. <verse eid="EXO 28:41" /><verse number="42" style="v" sid="EXO 28:42" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ತೆಂಚೆ ನಾಗ್ಡೆ ಪಾನ್ ಧಾಪುಕ್ ಸಾಟ್ನಿ ಕಂಬ್ರೆಕ್ನಾ ಜಾಂಗೆ ಪತರ್ ದೊರ್ಯಾಚಿ ಚೆಡ್ಡಿಯಾ ಕರ್ಸುಚೆ. <verse eid="EXO 28:42" /><verse number="43" style="v" sid="EXO 28:43" />ಆರೊನಾನ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾನಿ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಬಿಡಾರಾತ್ ಜಾತಾನಾ ಅನಿ ಪವಿತ್ರ್ ಜಾಗ್ಯಾರ್ ಸೆವಾ ಕರುಕ್ ಜಾತಾನಾಬಿ ಹೆ ಕಪ್ಡೆ ನೆಸುನ್ ಘೆವ್ಚೆ, ನಾಹೊಲ್ಯಾರ್ ಪಾಪಾ ಸಾಟ್ನಿ ಮರುನ್ ಜಾತಿಲ್, ಹ್ಯೊ ನೆಮ್ ತೆಕಾ ಅನಿ ತೆಜ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಶಾಶ್ವತಾಚೊ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EXO 28:43" /></para>
  <chapter eid="EXO 28" />
  <chapter number="29" style="c" sid="EXO 29" />
  <para style="s">ಯಾಜಕಾಕ್ನಿ ನೆಮ್ತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1" />ತೆನಿ ಮಾಜಿ ಯಾಜಕಾ ಹೊವ್ಕ್ ತೆಂಕಾ ಎಚುಕ್ ತಿಯಾ ಕರುಚೆ ಹೊಲ್ಲೆ ಕಾಮ್ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ಎಕ್ ಬೈಲಾಚೊ ಪಾಡೊ ಅನಿ ದೊಶ್ ನತ್ತಿ ಟಗರಾ ಘೆವ್ಚಿ. <verse eid="EXO 29:1" /><verse number="2" style="v" sid="EXO 29:2" />ಅನಿ ಫುಗ್ ನಸಲ್ಲಿ ಭಾಕ್ರಿಯಾ, ತೆಲ್ ಮಿಳ್ವಲ್ಲಿ ಫುಗ್ ನಸಲ್ಲಿ ಹೊಳ್ಗಿಯಾ, ಅನಿ ಘಂವಾಚ್ಯಾ ಪಿಟ್ಟಾಚಿ ತೆಲ್ ಮಿಳ್ವಲ್ಲಿ ಫುಗ್ ನಸಲ್ಲಿ ಕಡ್ಮಾ ಕರುನ್ ಎಕುಚ್ ಭುಟ್ಟಿತ್ ಭರುನ್ ಘೆವ್ಚೆ. <verse eid="EXO 29:2" /><verse number="3" style="v" sid="EXO 29:3" />ತೆಜ್ಯಾ ಮಾನಾ ತಿ ಭುಟ್ಟಿ, ಅನಿ ಬೈಲಾಚೊ ಪಾಡೊ ಅನಿ ಟಗರಾ ಹಾನುನ್ ಥವ್ಚೆ. <verse eid="EXO 29:3" /><verse number="4" style="v" sid="EXO 29:4" />ತನ್ನಾ ಆರೊನಾಕ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾಕ್ನಿ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಬಿಡಾರಾಚ್ಯಾ ದಾರಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಬಲ್ವುನ್ ಹಾನುನ್ ಪಾನಿಯಾನ್ ನಾವ್ಸುನ್, <verse eid="EXO 29:4" /><verse number="5" style="v" sid="EXO 29:5" />ತೊ ಲಾಂಬ್ಲೊ ಝಗೊ ಅನಿ ಕವ್ಚಿಚ್ಯಾ ವಾಂಗ್ಡಾ ನೆಸ್ತಲಿ ವೈಲಿ ಅಂಗಿ ಅನಿ ಕವ್ಚಿ ಅನಿ ಸೊನ್ಯಾಚೊ ಪದಕ್ ಆರೊನಾಕ್ ನೆಸ್ವುನ್, ಚಮತ್ಕಾರಾಚೊ ಕಂಬ್ರೆಚೊ ಪಟ್ಟೊ ಭಾಂದುನ್, <verse eid="EXO 29:5" /><verse number="6" style="v" sid="EXO 29:6" />ತೆಜ್ಯಾ ಟಕ್ಲ್ಯಾಕ್ ಪಾವ್ಡೊ ಭಾಂದುನ್, ಪಾವ್ಡಾ ವರ್‍ತಿ ದೆವಾಕ್ ನೆಮ್ಸುನ್ ಥವಲ್ಲೊ ನಿತಳ್ ಪಟ್ಟೊ ಭಾಂದ್ವುನ್, <verse eid="EXO 29:6" /><verse number="7" style="v" sid="EXO 29:7" />ಅಭಿಶೆಕಾಚೆ ತೆಲ್ ತೆಜ್ಯಾ ಟಕ್ಲ್ಯಾ ವರ್‍ತಿ ವೊತುನ್ ಅಭಿಶೆಕ್ ಕರುಚೆ.<verse eid="EXO 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 29:8" />ತೆಜ್ಯಾ ಮಾನಾ ತೆಜ್ಯಾ ಲೆಕಾಕ್ನಿಬಿ ಜಗ್ಗೊಳ್ ಬಲ್ವುನ್ ತೆಂಕಾಬಿ ಲಾಂಬ್ಲೆ ಝಗೆ ನೆಸ್ವುಚೆ. <verse eid="EXO 29:8" /><verse number="9" style="v" sid="EXO 29:9" />ಆರೊನಾಕ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾಕ್ನಿ ಕಂಬ್ರೆಚೆ ಪಟ್ಟೆ ಭಾಂದುನ್, ಪಾವ್ಡೆ ಭಾಂದ್ವುಚೆ. ತೆಂಕಾ ತೆಜ್ಯಾ ಮಾನಾ ಸದಾ ಸರ್ವತಾಚೊ ನೆಮ್ ಹೊವ್ನ್ ಯಾಜಕ್ ಪಾನ್ ಯೆತಾ, ಅಸೆ ಆರೊನಾಕ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾಕ್ನಿ ಯಾಜಕಾಚ್ಯಾ ಕಾಮಾಕ್ ನೆಮ್ಸುಚೆ.<verse eid="EXO 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 29:10" />ತೆಜ್ಯಾ ಮಾನಾ ತಿಯಾ ತ್ಯಾ ಪಾಡ್ಯಾಕ್ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಬಿಡಾರಾಕ್ಡೆ ಹಾನುನ್, ಆರೊನಾನ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾನಿ ತೆಜ್ಯಾ ವರ್‍ತಿ ಹಾತ್ ಥವ್ಲ್ಯಾ ಮಾನಾ, <verse eid="EXO 29:10" /><verse number="11" style="v" sid="EXO 29:11" />ತ್ಯಾ ಪಾಡ್ಯಾಕ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಇದ್ರಾಕ್ ತಿಯಾ ಬಲಿ ಭೆಟ್ವುಚೆ. <verse eid="EXO 29:11" /><verse number="12" style="v" sid="EXO 29:12" />ತ್ಯಾ ಪಾಡ್ಯಾಚ್ಯಾ ರಗ್ತಾತ್ಲೆ ಉಲ್ಲೆ ಘೆವ್ನ್, ಹಾತಿಚ್ಯಾ ಬೊಟಾನಿ ಬಲಿಭೆಟ್ವುತಲ್ಯಾ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಸಿಂಗಾಕ್ನಿ ಲಾವ್ನ್, ಹುರಲ್ಲೆ ರಗಾತ್ ಬಲಿಭೆಟ್ವುತಲ್ಯಾ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಮುಳಾಕ್ ವೊತುಚೆ. <verse eid="EXO 29:12" /><verse number="13" style="v" sid="EXO 29:13" />ಭುತ್ತುರ್ಲಿ ಭಾಗಾ, ಅನಿ ಕಾಳಿಂಜ್, ದೊನಿ ಕಿಡ್ನಿಯಾ ಅನಿ ತೆಂಚ್ಯಾ ವರ್‍ತಿ ಹೊತ್ತೆ ಮಾಂದೆ ಘೆವ್ನ್ ಬಲಿಭೆಟ್ವುತಲ್ಯಾ ಕಟ್ಟ್ಯಾ ವರ್‍ತಿ ಜಾಳ್ವುಚೆ. <verse eid="EXO 29:13" /><verse number="14" style="v" sid="EXO 29:14" />ಪಾಡ್ಯಾಚೆ ಮಾಸ್ ಅನಿ ಚಮ್ಡೆ ಅನಿ ಆಂತ್ಡಾ, ಗಾಂವ್ಚ್ಯಾ ಭಾಯ್ರ್ ನೆವ್ನ್ ಆಗಿನ್ ಜಾಳ್ವುಚೆ, ಹಿ ಪಾಪ್ ಪರಿಹಾರಾಚಿ ಬಲಿ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EXO 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 29:15" />ತೆಜ್ಯಾ ಮಾನಾ ತಿಯಾ ತ್ಯಾ ಟಗರಾಂತ್ಲೆ ಎಕ್ ಘೆವ್ನ್ ಆರೊನಾನ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾನಿ ತೆಚೆ ವರ್‍ತಿ ಹಾತಾ ಥವ್ಲ್ಯಾ ಮಾನಾ, <verse eid="EXO 29:15" /><verse number="16" style="v" sid="EXO 29:16" />ತೆಕಾ ತಿಯಾ ಬಲಿ ಭೆಟ್ವುನ್ ತೆಚೆ ರಗಾತ್ ಬಲಿಭೆಟ್ವುತಲ್ಯಾ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಚಾರಿ ಮುಲ್ಲ್ಯಾಕ್ನಿ ವೊತುಚೆ. <verse eid="EXO 29:16" /><verse number="17" style="v" sid="EXO 29:17" />ತನ್ನಾ ತಿಯಾ ತೆ ಟಗರ್ ಕಾಪುನ್ ತೆಚಿ ಅಂತ್ಡಾ ಅನಿ ಪಾಂಯಾ ಧುವ್ನ್ ಟಕ್ಲ್ಯಾಚ್ಯಾ ವಾಂಗ್ಡಾ ಥವ್ನ್, <verse eid="EXO 29:17" /><verse number="18" style="v" sid="EXO 29:18" />ತೆ ಸಗ್ಳೆ ಬಲಿಭೆಟ್ವುತಲ್ಯಾ ಕಟ್ಟ್ಯಾರ್, ಸರ್ವೆಸ್ಪರಾಕ್ ಫುರಾ ಆಂಗ್ ಬಲಿ ಕರುನ್ ಭೆಟ್ವುಚೆ, ಹೆ ಸರ್ವೆಸ್ಪರಾಕ್ ಬರ್ಯಾ ವಾಸೆಚಿ ಬಲಿ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EXO 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 29:19" />ತೆಜ್ಯಾ ಮಾನಾ ತಿಯಾ ದೊನ್ವೆಚೆ ಟಗರ್ ಘೆವ್ನ್ ಆರೊನಾನ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾನಿ ತೆಜ್ಯಾ ವರ್‍ತಿ ಹಾತಾ ಥವ್ಲ್ಯಾ ಮಾನಾ, <verse eid="EXO 29:19" /><verse number="20" style="v" sid="EXO 29:20" />ತಿಯಾ ತೆ ಟಗರ್ ಮಾರುನ್ ತೆಜ್ಯಾ ರಗ್ತಾತ್ ಉಲ್ಲೆ ಆರೊನಾಚ್ಯಾ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾಂಚ್ಯಾ ಉಜ್ವ್ಯಾಭಾಜುಚ್ಯಾ ಕಾನಾಂಚ್ಯಾ ತುದಿಕ್ನಿ ಅನಿ ಉಜ್ವ್ಯಾ ಹಾತಿಚ್ಯಾ ಥೊರ್ಲ್ಯಾ ಬೊಟಾಕ್ನಿ ಅನಿ ಉಜ್ವ್ಯಾ ಪಾಂಯಾಚ್ಯಾ ಥೊರ್ಲ್ಯಾ ಬೊಟಾಕ್ಬಿ ಲಾವ್ನ್, ಹುರಲ್ಲೆ ರಗಾತ್ ಬಲಿ ಭೆಟ್ವುತಲ್ಯಾ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಚಾರಿ ಮುಲ್ಲ್ಯಾಕ್ನಿ ವೊತುಚೆ. <verse eid="EXO 29:20" /><verse number="21" style="v" sid="EXO 29:21" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ತಿಯಾ ಬಲಿಭೆಟ್ವುತಲ್ಯಾ ಕಟ್ಟ್ಯಾಚ್ಯಾ ವೈಲ್ಯಾ ರಗ್ತಾತ್ ಅನಿ ಅಭಿಶೆಕಾಚ್ಯಾ ತೆಲಾತ್ ಉಲ್ಲೆ ಕಾಡುನ್ಗೆವ್ನ್ ಆರೊನ್ ಅನಿ ತೆಜ್ಯಾ ಕಪ್ಡ್ಯಾ ವೈನಿ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾಂಚ್ಯಾ ಕಪ್ಡ್ಯಾ ವೈನಿ ಸಿಪ್ಡುಚೆ, ಅಸೆ ತೊ ಅನಿ ತೆಚಿ ಪೊರಾ ಕಪ್ಡ್ಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ನಿತಳ್ ಹೊತಾತ್.<verse eid="EXO 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 29:22" />ಮಾನಾ ಪಟ್ಟಾಭಿಶೆಕಾಕ್ ಭೆಟ್ವಲ್ಲ್ಯಾ ಟಗರಾಚೆ ಮಾಂದೆ, ಸೆಪ್ಡಿಚೆ ಮಾಂದೆ ಅನಿ ಕಾಳಿಂಜಿ ವೈಲೆ ಮಾಂದೆ, ಅನಿ ದೊನಿ ಕಿಡ್ನಿಯಾ ಅನಿ ತೆಂಚ್ಯಾ ವೈಲೆ ಮಾಂದೆ, <verse eid="EXO 29:22" /><verse number="23" style="v" sid="EXO 29:23" />ಉಜ್ವಿ ಜಾಂಗ್ ಅನಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಬುಟ್ಟಿತ್ ಥವಲ್ಲಿ ಫುಗ್ ನಸಲ್ಲಿ ಸಾಮಾನಾ ಅನಿ ಎಕ್ ಬಾರಿಕ್ಲಿ, ತೆಲ್ ಮಿಸಳಲ್ಲಿ ಎಕ್ ಹೊಳ್ಗಿ ಅನಿ ಎಕ್ ಕಡಂ ಘೆವ್ನ್, <verse eid="EXO 29:23" /><verse number="24" style="v" sid="EXO 29:24" />ತೆ ಸಗ್ಳೆ ಆರೊನ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾಂಚ್ಯಾ ಹಾತಿತ್ ದಿವ್ನ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಉವ್ವಾಳುಚೆ. <verse eid="EXO 29:24" /><verse number="25" style="v" sid="EXO 29:25" />ಮಾನಾ ತೆ ತೆಂಚ್ಯಾ ಹಾತಿತ್ನಾ ಕಾಡುನ್ಗೆವ್ನ್ ಬಿಲಿ ಕಟ್ಟ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಸಗ್ಳೆ ಆಂಗ್ ಬಲಿಚ್ಯಾ ವಾಂಗ್ಡಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಜಾಳ್ವುತಲಿ ಬಲಿ ಭೆಟ್ವುಚೆ, ಸರ್ವೆಸ್ಪರಾಕ್ ತೆ ಬರ್ಯಾ ವಾಸೆಚಿ ಬಲಿ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EXO 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 29:26" />ಅನಿ ಆರೊನಾಚ್ಯಾ ಪಟ್ಟಾಬಿಶೆಕಾಕ್ ಭೆಟ್ವಲ್ಲ್ಯಾ ಟಗರಾಚ್ಯಾ ಛಾತಿಚೊ ಭಾಗ್ ಘೆವ್ನ್ ಕರುನ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಉವ್ವಾಳುಚೆ. ತುಕಾ ಪಾವುಚೊ ಹೊಲ್ಲೊ ವಾಟೊ ತೊಚ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EXO 29:26" /><verse number="27" style="v" sid="EXO 29:27" />ಆರೊನಾಕ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾಕ್ನಿ ಬಲಿಚಿ ದಿಕ್ಷಾ ದಿತಾನಾ, ಭೆಟ್ವಲ್ಲ್ಯಾ ಟಗರಾಚ್ಯಾ ಮಾಂಸಾತ್, ಉವ್ವಾಳಲ್ಲ್ಯಾ ಛಾತಿಚೊ ಭಾಗ್ ಯಾಜಕಾಂಚ್ಯಾ ವಾಟ್ಯಾಕ್ ಎಗ್ಳುನ್ ಥವಲ್ಲ್ಯಾ ಜಾಂಗೆಕ್ ದೆವಾಚೆ ಕರುನ್ ನೆಮುಚೆ. <verse eid="EXO 29:27" /><verse number="28" style="v" sid="EXO 29:28" />ತೆ ಆರೊನಾಕ್ ಅನಿ ತೆಜ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಸದಾ ಸರ್ವತಾಚೊ ನೆಮ್ ಕರುನ್ ದಿವ್ಚೆ, ತೆ ಯಾಜಕಾಂಚ್ಯಾ ವಾಟ್ಯಾಕ್ ನೆಮುನ್ ಹೊಲ್ಲೆ ಹಾಯ್, ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಸಮಾಧಾನಾಚಿ ಬಲಿ ಕರುನ್ ಜನಾವರಾ ಭೆಟ್ವುತಾನಾ ತೊ ಭಾಗ್ ಯಾಜಕಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಎಗ್ಳುನ್ ಥವ್ಚೆ.<verse eid="EXO 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 29:29" />ಆರೊನಾಚ್ಯಾ ಮಾನಾ ತೆಜ್ಯಾ ಲೆಕಾಕ್ನಿಬಿ ತೆಚೆ ಯಾಜಕಾಚೆ ಕಪ್ಡೆಚ್ ವಾಪ್ರುಚೆ, ತೆನಿ ಪಟ್ಟಾಬಿಶೆಕ್ ಹೊವ್ನ್ ಮೊಟ್ಟ್ಯಾ ಯಾಜಕಾಚ್ಯಾ ಕಾಮಾಕ್ ನೆಮುನ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ ತೆ ಕಪ್ಡೆ ನೆಸುಚೆ. <verse eid="EXO 29:29" /><verse number="30" style="v" sid="EXO 29:30" />ತೆಜ್ಯಾ ಲೆಕಾತ್ನಿ ತೆಜ್ಯಾ ಬದ್ಲಾಕ್ ಮೊಟೊಯಾಜಕ್ ಹೊವ್ನ್ ನೆಮಲ್ಲೊ ನಿತಳ್ ಜಾಗ್ಯಾರ್ ಸರ್ವೆಸ್ಪರಾಚಿ ಸೆವಾ ಕರುಕ್ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಬಿಡಾರಾಚ್ಯಾ ಬಿತ್ತುರ್ ಗುಸಲ್ಲ್ಯಾಕ್ನಾ ಸಾತ್ ದಿಸಾಂಚ್ಯಾ ಪತರ್ ತೆಚ್ ಕಪ್ಡೆ ನೆಸುನ್ಗೆವ್ನ್ ರಾವ್ಚೆ.<verse eid="EXO 29:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 29:31" />ಆರೊನಾಚ್ಯಾ ಅಬಿಶೆಕಾಕ್ ಭೆಟ್ವಲ್ಲ್ಯಾ ಟಗರಾಚೆ ಮಾಂಸ್ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಚ್ಯಾ ಸುರಾತುಚ್ ಸಿಜ್ವುಚೆ. <verse eid="EXO 29:31" /><verse number="32" style="v" sid="EXO 29:32" />ಅರೊನಾನ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾನಿ ತ್ಯಾ ಟಗರಾಚೆ ಮಾಂಸ್ ಅನಿ ಭುಟ್ಟಿತ್ಲಿ ಭಾಕ್ರಿಯಾ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಚ್ಯಾ ದಾರಾತುಚ್ ಜೆವಾನ್ ಕರುಚೆ. <verse eid="EXO 29:32" /><verse number="33" style="v" sid="EXO 29:33" />ತೆಂಕಾ ಯಾಜಕಾಚ್ಯಾ ಕಾಮಾಕ್ ಮಿಳ್ವುಕ್ ಅನಿ ದೆವಾಚ್ಯಾ ಕಾಮಾಕ್ ನೆಮುಕ್ ಪಾಪ್ ಪರಿಹಾರ್ ಕರುಕ್ ಭೆಟ್ವಲ್ಲ್ಯಾ ಬಲಿಚೆ ಜೆವಾನುಚ್ ತೆನಿ ಜೆವ್ಚೆ ಅನಿ ಕೊನಿಬಿ ತೆ ಜೆವಾನ್ ಜೆವ್ಚೆ ನ್ಹಯ್ , ತೆ ನೆಮುನ್ ಥವಲ್ಲೆ ಜೆವಾನ್. <verse eid="EXO 29:33" /><verse number="34" style="v" sid="EXO 29:34" />ಬಲಿ ಭೆಟ್ವಲ್ಲೆ ಜೆವಾನ್ ನಾತರ್ ಮಾಂಸ್ ಕಾಯ್ತರಿಬಿ ದುಶ್ರ್ಯಾ ದಿಸಿ ಸಕ್ಕಾಳಿ ಪತರ್ ಹೊಲ್ಲ್ಯಾರ್, ತೆ ದೆವಾಚೊ ಸಾಮಾನ್ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಕೊನಿಬಿ ಖಾಯ್ನಸ್ತಾನಾ ಜಾಳ್ವುಚೆ. <verse eid="EXO 29:34" /><verse number="35" style="v" sid="EXO 29:35" />ಮಿಯಾ ತುಮ್ಕಾ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಸಾತ್ ದಿಸ್ ಪತರ್ ಹ್ಯೊ ನೆಮ್ ಕರುನ್ ಆರೊನಾಕ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾಕ್ನಿ, ಯಾಜಕ್ ಕಾಮಾಕ್ ನೆಮ್ಸುಚೆ. <verse eid="EXO 29:35" /><verse number="36" style="v" sid="EXO 29:36" />ಹರ್ ಎಕ್ ದಿಸಾಬಿ ಪಾಪ್ ಪರಿಹಾರ್ ಸಾಟ್ನಿ ಎಕ್ ಬೈಲ್ ಭೆಟ್ವುಚೆ.</para>
  <para style="p" vid="EXO 29:36">ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಬಲಿಚೊ ಕಟ್ಟೊ ನಿತಳ್ ಕರುಕ್ ಸಾಟ್ನಿ ತೆಜ್ಯಾ ವರ್‍ತಿ ಪಾಪ್ ನಿತಳ್ ಕರ್ತಲಿ ಬಲಿ ಭೆಟ್ವುನ್, ತೆ ದೆವಾಚ್ಯಾ ಸೆವಾ ಸಾಟ್ನಿ ನೆಮ್ಸುಚೆ. <verse eid="EXO 29:36" /><verse number="37" style="v" sid="EXO 29:37" />ಅಸೆಚ್ ಬಲಿಭೆಟ್ವುತಲ್ಯಾ ಕಟ್ಟ್ಯಾ ಸಾಟ್ನಿ ಸಾತ್ ದಿಸಾಬಿ ಪಾಪ್ ಪರಿಹಾರ್ ಕರ್ತಲೊ ಸನ್ ಕರುನ್ ತೆ ಪರ್ತಿಸ್ಟೆ ಕರುಚೆ, ಬಲಿಚೊ ಕಟ್ಟೊ ನಿತಳ್ ರಾವ್ಚೊ, ಬಲಿಚ್ಯಾ ಕಟ್ಟ್ಯಾಕ್ ಲಾಗ್ತಲೆ ಸಗ್ಳೆಬಿ ನಿತಳ್ ರಾವ್ಚೆ.<verse eid="EXO 29:37" /></para>
  <para style="s">ಹರ್ ಎಕ್ ದಿಸಾಬಿ ಕರುಚೆ ಹೊಲ್ಲ್ಯಾ ಸಗ್ಳೆ ಆಂಗ್ ಜಾಳ್ವುತಲ್ಯಾ ಬಲಿಚೊ ನೆಮ್</para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38" />ಹರ್ ಎಕ್ ದಿಸಿಬಿ ಬಲಿಚ್ಯಾ ಕಟ್ಟ್ಯಾರ್ ಭೆಟ್ವುಚೆ ಹೊಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ಎಕ್ ವರ್ಸಾಚಿ ದೊನ್ ಬಕ್ರಿ ಸದ್ದಾಬಿ ಬಲಿ ಭೆಟ್ವುಚೆ. <verse eid="EXO 29:38" /><verse number="39" style="v" sid="EXO 29:39" />ತ್ಯಾತುರ್ ಎಕ್ ಸಕ್ಕಾಳಿ ಅನಿ ಎಕ್ ಸಾಂಚೆಕ್ಡೆ ಬಲಿ ಭೆಟ್ವುಚೆ. <verse eid="EXO 29:39" /><verse number="40" style="v" sid="EXO 29:40" />ಎಕ್ ಅನಿ ಅರ್ದೊ ಸೆರ್ ಒಲಿವಾಚೆ ತೆಲ್ ಅನಿ ತಿನ್ ಸೆರ್ ಘಂವಾಚೆ ಪಿಟ್ಟ್ ಮಿಳ್ವುನ್, ದಾನೆ ಭೆಟ್ವುಕ್ ಸಾಟ್ನಿ ಪೈಲೆಚ್ಯಾ ಬಕ್ರ್ಯಾ ವಾಂಗ್ಡಾ ಜಾಳ್ವುಚೆ, ಪಾನಿ ಭೆಟ್ವುಸಾಟ್ನಿ ಎಕ್ಬಿ ಅರ್ದೊ ಸೆರ್ ವಾಯ್ನ್ ಜಾಳ್ವುಚೆ. <verse eid="EXO 29:40" /><verse number="41" style="v" sid="EXO 29:41" />ಸಾಂಜೆಕ್ಡೆ ದೊನ್ವೆಚೆ ಬಕ್ರೆ ಜಾಳ್ವುತಾನಾ, ದಿಸಾನಿ ಕರಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ತೆಜ್ಯಾ ವಾಂಗ್ಡಾ ದಾನೆ ಅನಿ ವಾಯ್ನ್ ಭೆಟ್ವುಚೆ, ಸರ್ವೆಸ್ಪರಾಕ್ ತೆ ಬರ್ಯಾ ವಾಸೆಚಿ ಬಲಿ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="EXO 29:41" /><verse number="42" style="v" sid="EXO 29:42" />ತುಮಿ ಅನಿ ತುಮ್ಚ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ ಹಿ ಸಗ್ಳೆ ಅಂಗ್ ಬಲಿ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಚ್ಯಾ ಇದ್ರಾಕ್ ಹರ್ ಎಕ್ ದಿಸಾಬಿ ಕರುಚೆ, ಮಿಯಾ ತ್ಯಾ ಗುಡಿತ್ ತುಮ್ಕಾ ದಿಸುನ್ ತುಮ್ಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ತಾ. <verse eid="EXO 29:42" /><verse number="43" style="v" sid="EXO 29:43" />ಮಿಯಾ ಇಜ್ರಾಯೆಲಾಕ್ನಿ ದಿಸ್ತಲೊ ಥೈಚ್, ಮಿಯಾ ಥೈ ದಿಸ್ತಲ್ಯಾ ಪರ್ಬಾವಾ ಸಾಟ್ನಿ ತೊ ಜಾಗೊ ನಿತಳ್ ಹೊತಾ. <verse eid="EXO 29:43" /><verse number="44" style="v" sid="EXO 29:44" />ಮಿಯಾ ದೆವಾಕ್ ಬಗ್ತಲೆ ಬಿಡಾರ್ ಅನಿ ಬಲಿಚೊ ಕಟ್ಟೊ ನಿತಳ್ ಜಾಗೊ ಕರ್ತಾ, ಆರೊನಾಕ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾಕ್ನಿ ಮಾಜಿ ಯಾಜಕಾ ಕರುನ್ಗೆತಾ. <verse eid="EXO 29:44" /><verse number="45" style="v" sid="EXO 29:45" />ಮಿಯಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಮದ್ದಿ ವಸ್ತಿ ರಾವ್ನ್ ತೆಂಕಾ ದೆವ್ ಹೊತಾ. <verse eid="EXO 29:45" /><verse number="46" style="v" sid="EXO 29:46" />ಮಿಯಾಚ್ ತೆಂಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರ್ , ತೆಂಚ್ಯಾ ಮದ್ದಿ ವಸ್ತಿರಾವ್ಕ್ ಮನುನ್ ತೆಂಕಾ ಇಜಿಪ್ತಾಕ್ನಾ ಭಾಯ್ರ್ ಹಾನಲ್ಲೊ ಅಪ್ನಾಚೊ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಮಿಯಾಚ್ ಮನುನ್ ತೆನಿ ಕಳ್ವುನ್ ಘೆತಾತ್.<verse eid="EXO 29:46" /></para>
  <chapter eid="EXO 29" />
  <chapter number="30" style="c" sid="EXO 30" />
  <para style="s">ಧುಪ್ ಜಾಳ್ವುತಲೊ ಕಟ್ಟೊ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1" />ಅನಿ ಬರ್ಯಾ ವಾಸೆಚ್ಯಾ ಪಾನಿಯಾನಿ ಧುಪ್ ಜಾಳ್ವುಕ್ ಸಾಟ್ನಿ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಎಕ್ ಕಟ್ಟೊ ಕರುಚೆ. <verse eid="EXO 30:1" /><verse number="2" style="v" sid="EXO 30:2" />ತೆಚಿ ಲಾಂಬಿ ಎಕ್ ಹಾತ್, ಅನಿ ರುಂದ್ ಎಕ್ ಹಾತ್ ಅನಿ ಉಪ್ಪರ್ ದೊನ್ ಹಾತ್ ರಾವ್ನ್ ಚವ್ಕ್ ರಾವ್ಚೆ, ಅನಿ ತೆಕಾ ಶಿಂಗಾಬಿ ತೆಜ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳ್ವುನ್ ಕರುಚೆ. <verse eid="EXO 30:2" /><verse number="3" style="v" sid="EXO 30:3" />ತೆಚ್ಯಾ ವೈಲ್ಯಾ ಭಾಗಾಕ್ ಭೊತ್ಯಾನಿ ಅನಿ, ಶಿಂಗಾಕ್ನಿ ನಿತಳ್ ಸೊನ್ಯಾನ್ ಧಾಪುಚೆ, ಅನಿ ತೆಚ್ಯಾ ಭೊತ್ಯಾನಿ ಸೊನ್ಯಾಚೆ ಖಾಂಬೆ ಕರುಚೆ. <verse eid="EXO 30:3" /><verse number="4" style="v" sid="EXO 30:4" />ಅನಿ ತೆಚ್ಯಾ ಖಾಂಬ್ಯಾಂಚ್ಯಾ ದೊನ್ ಮುಲ್ಲ್ಯಾಚ್ಯಾ ಖಾಲ್ತಿ ದೊನ್ ಸೊನ್ಯಾಚಿ ಕಾಕ್ನಾ ಕರುಚೆ, ಕಟ್ಟ್ಯಾಕ್ ವಾವುನ್ ನ್ಹೆವ್ಕ್ ತ್ಯಾ ಕಾಕ್ನಾತ್ನಿ ದಾಂಡೆ ಶಿರ್ಕುಚೆ. <verse eid="EXO 30:4" /><verse number="5" style="v" sid="EXO 30:5" />ಅನಿ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ದಾಂಡೆ ಕರುನ್ ತೆಂಕಾ ಸೊನ್ಯಾನಿ ಧಾಪುಚೆ. <verse eid="EXO 30:5" /><verse number="6" style="v" sid="EXO 30:6" />ತೆ ಕರಾರಾಚ್ಯಾ ಪೆಟಿಚ್ಯಾ ಇದ್ರಾಕ್ ಮಟ್ಲ್ಯಾರ್, ಕರಾರಾಚ್ಯಾ ಪೆಟಿಚ್ಯಾ ವರ್‍ತಿ ಮಿಯಾ ತುಕಾ ದಿಸ್ತಲ್ಯಾ ಕರ್ಪಾಸನಾಚ್ಯಾ ಇದ್ರಾಕ್ ಥವ್ಚೆ. <verse eid="EXO 30:6" /><verse number="7" style="v" sid="EXO 30:7" />ಹರ್ ಎಕ್ ದಿಸಿ ಸಕ್ಕಾಳಾಕ್ ಆರೊನಾನ್ ತೆಜ್ಯಾ ವರ್‍ತಿ ಬರ್ಯಾ ವಾಸೆಚೊ ಧುಪ್ ಜಾಳ್ವುಚೆ. <verse eid="EXO 30:7" /><verse number="8" style="v" sid="EXO 30:8" />ಅನಿ ಸಾಂಚೆಕ್ಡೆ ದಿವೊ ಪೆಟ್ವುತಲ್ಯಾ ಎಳಾರ್, ಬರ್ಯಾ ವಾಸೆಚ್ಯಾ ತೆಲಾನಿ ಧುಪ್ ಜಾಳ್ವುಚೆ, ಅಸೆ ತುಮ್ಚೆಕ್ನಾ ಅನಿ ತುಮ್ಚ್ಯಾ ಪಿಳ್ಗಿಕ್ನಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಸದ್ದಾಚೆ ಧುಪ್ ಜಾಳ್ವುನ್ ಹೊವ್ಚೆ. <verse eid="EXO 30:8" /><verse number="9" style="v" sid="EXO 30:9" />ತುಮಿ ದುಸ್ರೆ ಖಲೆಬಿ ಧುಪ್ ಹೊಂವ್ದಿತ್, ಜಾಳ್ವುತಲಿ ಬಲಿ ಹೊಂವ್ದಿತ್, ಖಾತಲಿ ಬಲಿ ಹೊಂವ್ದಿತ್, ತೆಚ್ಯಾ ವರ್‍ತಿ ಭೆಟ್ವು ನ್ಹಯ್ , ಅನಿ ತೆಚ್ಯಾ ವರ್‍ತಿ ಪಾನಿಯಾಚಿ ಬಲಿಬಿ ಭೆಟ್ವುಚೆ ನ್ಹಯ್ . <verse eid="EXO 30:9" /><verse number="10" style="v" sid="EXO 30:10" />ಆರೊನಾನ್ ಅನಿ ತೆಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾನಿ ತೆಜ್ಯಾ ಶಿಂಗಾಕ್ನಿ ವರ್ಸಾಕ್ ಎಗ್ದಾ ಬಲಿ ಭೆಟ್ವಲ್ಲ್ಯಾ ಜನಾವರಾಚೆ ರಗಾತ್ ಲಾವ್ನ್ ಪಾಪ್ ಮಾಪಿ ಕರುನ್ ಘೆವ್ಚೆ, ತೆಚ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಅಗ್ದಿ ನಿತಳ್ ಹೊಲ್ಲೆ ರ್‍ಹಾತಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 30:10" /></para>
  <para style="s">ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗುಡಿಚಿ ತೆರ್ಗಿ</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲುನ್ ಸಾಂಗಟಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, <verse eid="EXO 30:11" /><verse number="12" style="v" sid="EXO 30:12" />“ತಿಯಾ ಮೆಜ್ನಿ ಕರ್‍ತಲ್ಯಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ಪೊರಾಕ್ನಿ ಕಾಯ್ಬಿ ದುಕ್ನೆ ಯೆವ್ಚೆ ನ್ಹಯ್ ಸಾರ್ಕೆ, ಹರ್ ಎಕ್ಲ್ಯಾನ್ಬಿ ಅಪ್ನಾಚ್ಯಾ ಜಿವಾಕ್ ರಾಕುನ್ಗೆವ್ಕ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಕಾನಿಕ್ ದಿವ್ಚೆ. <verse eid="EXO 30:12" /><verse number="13" style="v" sid="EXO 30:13" />ಮೆಜಲ್ಯಾತ್ಲೊ ಹರ್ ಎಕ್ ಮಾನುಸ್ಬಿ ಸರ್ವೆಸ್ಪರಾಕ್ ದಿತಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ವಿಸ್ ಗೆರಾ ಚಾಂದಿಚ್ಯಾ ಪೈಸ್ಯಾ ಸಾರ್ಕೆ, ಅರ್ದೆ ಶೆಕೆಲ್ ಪೈಸೆ, ಕಾನಿಕ್ ದಿವ್ಚೆ, ತೆ ಸರ್ವೆಸ್ಪರಾಕ್ ನಿತಳ್ ಕಾನಿಕ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EXO 30:13" /><verse number="14" style="v" sid="EXO 30:14" />ಮೆಜ್ನಿತ್ಲ್ಯಾ ಇಸ್ ವರ್ಸಾಚ್ಯಾ ಅನಿ ತೆಜ್ಯಾ ವೈಲ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಹರ್ ಎಕ್ ಮಾನ್ಸಾನಿ ಸರ್ವೆಸ್ಪರಾಕ್ ಕಾನಿಕ್ ದಿವ್ಚೆ. <verse eid="EXO 30:14" /><verse number="15" style="v" sid="EXO 30:15" />ಅನಿ ಲೈ ಬದಿಕ್ ಹೊತ್ತ್ಯಾನಿ ತುಮ್ಚ್ಯಾ ಜಿವಾಚ್ಯಾ ಮಾಪಿಯಾಕ್ನಿ ಸರ್ವೆಸ್ಪರಾಕ್ ದಿತಲಿ ಕಾನಿಕ್ ಅರ್ದ್ಯಾ ಶೆಕೆಲಾಕಿಂತಾ ಲೈ ದಿವ್ಚೆ ನ್ಹಯ್ , ಅನಿ ತ್ಯಾತುರುಚ್ ಗರಿಬ್ ಹೊತ್ತೆ ಕಮ್ಮಿ ದಿವ್ಚೆ ನ್ಹಯ್ . <verse eid="EXO 30:15" /><verse number="16" style="v" sid="EXO 30:16" />ಖರೆ ಚುಕ್ ಮಾಪಿ ಕರಲ್ಲೆ ಪೈಸೆ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾಕ್ನಾ ಘೆವ್ನ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಸೆವಾಕ್ ವಾಪ್ರುಚೆ, ಹೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಯಾದೆಕ್ ಅನಿ ಪಚ್ಚಾತಾಪಾಚ್ಯಾ ವಿಶಯಾತ್ ರ್‍ಹಾತಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 30:16" /></para>
  <para style="s">ತಾಂಬ್ಯಾಚಿ ಮೊಟಿ ವಾಟ್ಲಿ</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, <verse eid="EXO 30:17" /><verse number="18" style="v" sid="EXO 30:18" />ಎಕ್ ತಾಂಬ್ಯಾಚಿ ಮೊಟಿ ವಾಟ್ಲಿ ಅನಿ ತೆ ಥವ್ಕ್ ಎಕ್ ಮ್ಹನಿ ಕರುನ್, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಅನಿ ಬಲಿ ಭೆಟ್ವುತಲ್ಯಾ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಮದ್ದಿ ಥವ್ನ್ ತ್ಯಾತುರ್ ಪಾನಿ ಭರುಚೆ. <verse eid="EXO 30:18" /><verse number="19" style="v" sid="EXO 30:19" />ಆರೊನ್ ಅನಿ ತೆಚಿ ಲೆಕಾ ತ್ಯಾತುರ್ ಹಾತ್ ಪಾಂಯ್ ಧುವ್ನ್ ಘೆವ್ಚೆ. <verse eid="EXO 30:19" /><verse number="20" style="v" sid="EXO 30:20" />ತೆನಿ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಬಿಡಾರಾಚ್ಯಾ ಭುತ್ತುರ್ ಜಾತಾನಾ, ಅನಿ ಸರ್ವೆಸ್ಪರಾಚಿ ಸೆವಾ ಕರುಕ್, ಅನಿ ಬಲಿ ಭೆಟ್ವುಕ್ ಮನುನ್ ಬಲಿ ಭೆಟ್ವುತಲ್ಯಾ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆತಾನಾ, ತಸೆಚ್ ಯೆಲ್ಯಾರ್ ಮರುನ್ ಜಾತಿಲ್, ತಸೆ ಹೊವ್ನ್ ಝಿತ್ತೆ ರಾವ್ಚೆ ಹೊಲ್ಯಾರ್ ಹಾತಿ ಪಾಂಯಾ ಧುವ್ನ್ ಘೆವ್ನ್ ಯೆವ್ಚೆ. <verse eid="EXO 30:20" /><verse number="21" style="v" sid="EXO 30:21" />ಧುವ್ನ್ ಘೆವ್ನ್ ಜಾಯ್ ನಸ್ಲ್ಯಾರ್, ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ಹೊತಾ, ಹೆ ತೆಕಾ ಅನಿ ತೆಜ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಶಾಶ್ವತ್ ನಿಯಮ್ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EXO 30:21" /></para>
  <para style="s">ಅಭಿಶೆಕಾಚೆ ತೆಲ್</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಸಾಂಗಟಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, <verse eid="EXO 30:22" /><verse number="23" style="v" sid="EXO 30:23" />ತಿಯಾ ಬರ್ಯಾ ವಾಸೆಚ್ಯಾ ತೆಲಾತ್ನಿ, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಸೆವಾಕ್ ನೆಮಲ್ಲ್ಯಾ ಮಾಪಾಕ್ ಸಮಾ ಹೊಯ್ ಸಾರ್ಕೆ, ಸಾ ಕಿಲೊ ರಗತ್ಬೊಳ್, ತಿನ್ ಕಿಲೊ ಬರೆ ಲಂವ್ಗಾಚೆ ಚೆಕ್ಕೆ, ತಿನ್ ಕಿಲೊ ಬರ್ಯಾ ವಾಸೆಚೆ ಬಜೆ, ಸಾ ಕಿಲೊ ದಾಲ್ಚಿನ್ನಿ, <verse eid="EXO 30:23" /><verse number="24" style="v" sid="EXO 30:24" />ಸಾ ಕಿಲೊ ಒಲಿವಾಚೆ ತೆಲ್, ಹೆ ಸಗ್ಳೆ ಘೆವ್ನ್, <verse eid="EXO 30:24" /><verse number="25" style="v" sid="EXO 30:25" />ಬರ್ಯಾ ವಾಸೆಚ್ಯಾ ತೆಲಾತ್ ಮಿಳ್ವುನ್, ನಿತಳ್ ಅಭಿಶೆಕ್ ತೆಲ್ ತಯಾರ್ ಕರುಕ್ ಲಾವ್ಚೆ. <verse eid="EXO 30:25" /><verse number="26" style="v" sid="EXO 30:26" />ತೆಚೆ ವೈನಾ ದೆವಾಕ್ ಬಗ್ತಲಿ ಗುಡಿ, ಹುಕುಮಾಂಚ್ಯಾ ಕರಾರಾಂಚಿ ಪೆಟಿಕ್ ಅಭಿಶೆಕ್ ಕರುಕ್ ಸಾಟ್ನಿ, ತೆ ತೆಲ್ ವಾಪ್ರುಚೆ. <verse eid="EXO 30:26" /><verse number="27" style="v" sid="EXO 30:27" />ಅಲ್ತಾರಿ, ಅನಿ ತೆಜ್ಯಾ ವರ್‍ತಿ ಥವ್ತಲಿ ಸಾಮಾನಾ, ದಿವ್ಯಾಚೊ ಖಾಂಬೊ, ಅನಿ ತೆಜ್ಯಾ ವೈಲಿ ಸಾಮಾನಾ, ಧುಪ್ ಜಾಳ್ವುತಲೊ ಕಟ್ಟೊ, <verse eid="EXO 30:27" /><verse number="28" style="v" sid="EXO 30:28" />ಬಲಿಚೊ ಕಟ್ಟೊ, ಅನಿ ತೆಚಿ ಸಾಮಾನಾ ಮೊಟಿ ವಾಟ್ಲಿ, ಅನಿ ತಿ ಥವ್ತಲಿ ಮ್ಹನಿ, ಹೆ ಸಗ್ಳೆ ನಿತಳ್ ಕರುನ್ ಪರ್ತಿಸ್ಟೆ ಕರುಚೆ. <verse eid="EXO 30:28" /><verse number="29" style="v" sid="EXO 30:29" />ತೆ ಅಗ್ದಿ ನಿತಳ್ ಹೊವ್ನ್ ರಾವ್ಚೆ, ಹೆಕಾ ಲಾಗ್ತಲೆ ಸಗ್ಳೆಬಿ ನಿತಳ್ ಹೊವ್ನ್ ರಾವ್ಚೆ. <verse eid="EXO 30:29" /><verse number="30" style="v" sid="EXO 30:30" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಆರೊನ್ ಅನಿ ತೆಚಿ ಲೆಕಾ ಮಾಜಿ ಯಾಜಕಾ ಹೊವ್ನ್ ರಾಯ್ ಸಾರ್ಕೆ ತೆಂಕಾ ಅಭಿಶೆಕ್ ಕರುನ್ ನೆಮ್ಸುಚೆ. <verse eid="EXO 30:30" /><verse number="31" style="v" sid="EXO 30:31" />ತಿಯಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಹುಕುಮ್ ದಿವ್ಚೆ ಹೊಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್; ತುಮಿ ಅನಿ ತುಮ್ಚ್ಯಾ ಪಿಳ್ಗಿಚಿ ಲೊಕಾ ಹೆ ತೆಲ್ ಮಾಜ್ಯಾ ಸೆವಾಕ್ ನೆಮಲ್ಲೆ ನಿತಳ್ ಅಭಿಶೆಕ್ ತೆಲ್ ಮನುನ್ ಕಳ್ವುನ್ ಘೆವ್ಚೆ. <verse eid="EXO 30:31" /><verse number="32" style="v" sid="EXO 30:32" />ಅನಿ ಹೆ ತೆಲ್ ಆಂಗಾಕ್ ಲಾವ್ಕ್ ವಾಪ್ರುಚೆ ನ್ಹಯ್ , ಹೆಜೆನ್ ಖಾವ್ಕ್ ಮನುನ್ ದುಸ್ರ್ಯಾ ಕಾಮಾಕ್ನಿ ತೆಲ್ ಕರುಚೆ ನ್ಹಯ್ , ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಹೆ ಸರ್ವೆಸ್ಪರಾಕ್ ನೆಮಲ್ಲೆ, ಅನಿ ನಿತಳ್ ಮನುನ್ ಕಳ್ವುನ್ ಘೆವಾ. <verse eid="EXO 30:32" /><verse number="33" style="v" sid="EXO 30:33" />ಹೆಚ್ಯಾ ಸಾರ್ಕೆಚ್ ತೆಲ್ ಕರ್‍ತಲೆ ಹೊಂವ್ದಿತ್, ಅನಿ ಹೆ ಯಾಜಕ್ ನ್ಹಯ್ ಹೊಲ್ಲ್ಯಾಕ್ನಿ ಲಾವ್ತಲೆ ಹೊಂವ್ದಿತ್ ಕರಲ್ಲ್ಯಾಕ್ ಅಪ್ನಾಚ್ಯಾ ಕುಳಿತ್ನಾ ಭಾಯ್ರ್ ಕಾಡುನ್ ಹೊತಾ.<verse eid="EXO 30:33" /></para>
  <para style="s">ಧುಪಾಚೆ ತೆಲ್</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ದುದ್ದಾಚಿ ಮಡ್ಡಿ, ಗುಗ್ಗುಲ್, ಗಂಧಕಾಚೆ ಚೆಕ್ಕೆ, ಅನಿ ಬರ್ಯಾ ವಾಸೆಚಿ ತೆಲಾ, ನಿತಳ್ ಧುಪ್ ಹೆ ಸಗ್ಳೆ ಎಕುಚ್ ಮಾಪಾನ್ ಘೆವ್ನ್, <verse eid="EXO 30:34" /><verse number="35" style="v" sid="EXO 30:35" />ಬರ್ಯಾ ವಾಸೆಚೆ ತೆಲ್ ತಯಾರ್ ಕರ್‍ತಲ್ಯಾಂಚ್ಯಾ ಬುದ್ದಿ ಸಾರ್ಕೆ ಕಾಲ್ವುನ್ ತ್ಯಾತುರ್ ಮಿಟ್ಟ್ ಘಾಲುನ್, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಸೆವೆಕ್ ಪವಿತ್ರ್ ಧುಪಾಚೆ ತೆಲ್ ಕರುಕ್ ಲಾವ್ಚೆ. <verse eid="EXO 30:35" /><verse number="36" style="v" sid="EXO 30:36" />ತ್ಯಾತರ್ಲೆ ಉಲ್ಲೆ ಪುಡ್ ಕರುನ್, ಮಿಯಾ ತುಮ್ಕಾ ದಿಸ್ತಲ್ಯಾ ಜಾಗ್ಯಾರ್ ಕರಾರಾಂಚ್ಯಾ ಪೆಟಿಚ್ಯಾ ಇದ್ರಾಕ್ ಥವ್ಚೆ, ಅನಿ ತೆ ಅಗ್ದಿ ನಿತಳ್ ಮನ್ತಲೆ ತುಮ್ಕಾ ಗೊತ್ತ್ ರಾವ್ಚೆ. <verse eid="EXO 30:36" /><verse number="37" style="v" sid="EXO 30:37" />ತುಮಿ ತುಮ್ಕಾ ಸ್ವತಾಕ್ ತ್ಯಾ ಧುಪಾಚ್ಯಾ ತೆಲಾಚ್ಯಾ ಸಾರ್ಕೆ ತಯಾರ್ ಕರುನ್ ಘೆವ್ಚೆ ನ್ಹಯ್ , ತೆ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಸೆವಾಕ್ ಯೆವ್ಡೆಚ್ ವಾಪರ್ತಲೆ ಅನಿ ನಿತಳ್ ನೆಮ್ಸುನ್ ಥವಲ್ಲೆ ಮನುನ್ ಚಿಂತುಚೆ. <verse eid="EXO 30:37" /><verse number="38" style="v" sid="EXO 30:38" />ಕೊನ್ ತರ್ಬಿ ಬರ್ಯಾ ವಾಸೆಕ್ ಸಾಟ್ನಿ ಅಸ್ಲೆ ತಯಾರ್ ಕರ್ಸುನ್ ಘೆಟಲ್ಲೊ ರಾಲ್ಯಾರ್, ತೆಕಾ ಕುಳಿತ್ನಾ ಭಾಯ್ರ್ ಘಾಲುನ್ ಹೊತಾ.<verse eid="EXO 30:38" /></para>
  <chapter eid="EXO 30" />
  <chapter number="31" style="c" sid="EXO 31" />
  <para style="s">ದೆವಾಚ್ಯಾ ಇದ್ರಾಕ್ ಗುಡಿ ಕರ್ತಲಿ ಕಾಮ್ ಕಾರಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಅಸೆ ಮನುನ್, <verse eid="EXO 31:1" /><verse number="2" style="v" sid="EXO 31:2" />ಮಿಯಾ ಜುದೆಯಾ ಕುಳಿಚ್ಯಾ ಹುರಾಚೊ ನಾತು ಅನಿ ಉರಿಚೊ ಲೆಕ್ ಬೆಚೆಲಾಕ್ ಎಚುನ್ ಘೆಟ್ಲಾ. <verse eid="EXO 31:2" /><verse number="3" style="v" sid="EXO 31:3" />ಬೆಚೆಲ್ ಚಿತ್ರಾಂಚಿ ನುಂಪ್ ಕಾಮಾ ಕರುಕ್ ಅನಿ ಸೊನೆ ಚಾಂದಿ, ಅನಿ ತಾಂಬ್ಯಾಚಿ ಕಾಮಾ ಕರುಕ್, ತೆಕಾ ದಿವ್ಯಾಚೊ ಆತ್ಮೊ ದಿವ್ನ್, ಬುದ್ದ್, ಶಿಕ್ಷನ್ ಅನಿ ಚಿಂತ್ತಲಿ ಬುದ್ದ್ ಅನಿ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚೆ ಶಿಲ್ಪಕಲಾಚೆ ಬುದ್ದ್ ದಿಲಾ. <verse eid="EXO 31:3" /><verse number="4" style="v" sid="EXO 31:4" />ಬೆಚೆಲ್ ನುಂಪ್ ಕಾಮಾ ಕರುಕ್ ಅನಿ ಸೊನೆ ಚಾಂದಿ, ಅನಿ ತಾಂಬ್ಯಾಚಿ ಕಾಮಾ ಕರುಕ್, ಹಿ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಶಿಂಗಾರಾಚಿ ಕಾಮಾ ಕರ್ತಾ. <verse eid="EXO 31:4" /><verse number="5" style="v" sid="EXO 31:5" />ರತ್ನಾ ಕೊರ್ದುಕ್ ಬರಿ ಸಾಮಾನಾ ಕರ್ತಾ, ಅನಿ ಝಾಡಾಚಿ ಕಾಮಾ ಕರ್ತಾ ಅನಿ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಕಾಮಾ ಕರ್ತಾ. <verse eid="EXO 31:5" /><verse number="6" style="v" sid="EXO 31:6" />ತೆಜ್ಯಾ ವಾಂಗ್ಡಾ ದಾನ್ ಕುಳಿಚೊ ಅಹಿಸಾಮಾಕಾಚೊ ಲೆಕ್ ಒಹೊಲಿಬಾಮಾಕ್ ನೆಮ್ಲಾ, ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಮಿಯಾ ತುಕಾ ಹುಕುಮ್ ದಿಲ್ಲೆ ಸಗ್ಳೆ ಕರುಕ್ ಬುದ್ವಂತಾಂಚ್ಯಾ ಮನಾತ್ ಬುದ್ ದಿಲಾ. <verse eid="EXO 31:6" /><verse number="7" style="v" sid="EXO 31:7" />ದೆವಾಕ್ ಬಗ್ತಲಿ ಗುಡಿ, ಹುಕುಮಾಂಚೆ ಗುಂಡೆ ಥವಲ್ಲಿ ಕರಾರಾಚಿ ಪೆಟಿ, ತೆಜ್ಯಾ ವೈಲೊ ಕರ್ಪಾಸನ್, ಅನಿ ಗುಡಿಚಿ ಸಗ್ಳಿ ಸಾಮಾನಾ, <verse eid="EXO 31:7" /><verse number="8" style="v" sid="EXO 31:8" />ಮಾಚೊ ಅನಿ ತೆಚಿ ಸಾಮಾನಾ, ಚೊಕ್ಕ್ ಸೊನ್ಯಾಚೊ ದಿವ್ಯಾಚೊ ಖಾಂಬೊ, ತೆಚಿ ಸಾಮಾನಾ, <verse eid="EXO 31:8" /><verse number="9" style="v" sid="EXO 31:9" />ದುಪಾಚೊ ಕಟ್ಟೊ, ಬಲಿಚೊ ಕಟ್ಟೊ, ಅನಿ ತೆಚಿ ಸಾಮಾನಾ, ಮೊಟಿ ವಾಟ್ಲಿ, ತೆಜೊ ಕಟ್ಟೊ, <verse eid="EXO 31:9" /><verse number="10" style="v" sid="EXO 31:10" />ಶಿಂಗಾರಾಚಿ ದಿಕ್ಷಾ ಕಪ್ಡೆ ಮಟ್ಲ್ಯಾರ್, ಮೊಟೊ ಯಾಜಕ್ ಆರೊನ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾಕ್ನಿ ಪಾಜೆ ಹೊಲ್ಲಿ ಯಾಜಕಾಚೆ ಕಪ್ಡೆ, <verse eid="EXO 31:10" /><verse number="11" style="v" sid="EXO 31:11" />ಪಟ್ಟಾಬಿಶೆಕಾಚೆ ತೆಲ್, ಪವಿತ್ರ್ ಜಾಗ್ಯಾಚ್ಯಾ ಸೆವಾಕ್ ಪಾಜೆ ಹೊಲ್ಲೆ ಬರ್ಯಾ ವಾಸೆಚೆ ದುಪ್, ಹೆ ಸಗ್ಳೆ ಮಿಯಾ ತುಕಾ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ತೆನಿ ಕರ್‍ತಾತ್.<verse eid="EXO 31:11" /></para>
  <para style="s">ಸಾಬ್ಬಾತ್, ಆರಾಮಾಚೊ ದಿಸ್</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಅಸೆ ಮನುನ್, <verse eid="EXO 31:12" /><verse number="13" style="v" sid="EXO 31:13" />ತಿಯಾ ಇಜ್ರಾಯೆಲಾಕ್ನಿ ಹುಕುಮ್ ದಿವ್ಚೆ ಹೊಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ಮಿಯಾ ನೆಮಲ್ಲೊ ಸಬ್ಬಾತಾಚಿ ದಿಸಾ ತುಮಿ ಚುಕಿನಸ್ತಾನಾ ಆಚರನ್ ಕರುಚೆ, ತುಮ್ಕಾ ದೆವಾಚಿ ಲೊಕಾ ಕರಲ್ಲೊ ಸರ್ವೆಸ್ಪರ್ ಮಿಯಾಚ್ ಮನುನ್ ತುಮಿ ಕಳ್ವುನ್ ಘೆಯ್ ಸಾರ್ಕೆ, ತುಮ್ಕಾ ಅನಿ ಮಾಕಾ ಅನಿ ತುಮ್ಚ್ಯಾ ಪಿಳ್ಗಿಕ್ ಹೊತ್ತಿ ವಳಕ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EXO 31:13" /><verse number="14" style="v" sid="EXO 31:14" />ತೆಜ್ಯಾ ಸಾಟ್ನಿ, ತುಮಿ ಸಬ್ಬಾತಾಚೊ ದಿಸ್ ನಿತಳ್ ದಿಸ್ ಮನುನ್ ಆಚರನ್ ಕರುಚೆ, ತೆ ನಿತಳ್ ನ್ಹಯ್ ಮನುನ್ ಚಿಂತುನ್ ಚಲಲ್ಯಾಕ್ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ಹೊವ್ಕ್ ಪಾಜೆ, ತ್ಯಾ ದಿಸಾತ್ನಿ ಕಾಮ್ ಕರಲ್ಲ್ಯಾ ಮಾನ್ಸಾಕ್ ಲೊಕಾಂತ್ನಾ ಕಾಡುನ್ ಟಾಕುನ್ ಹೊತಾ. <verse eid="EXO 31:14" /><verse number="15" style="v" sid="EXO 31:15" />ಸಾ ದಿಸ್ ಪತರ್ ಕಾಮ್ ಕರುಚೆ, ಸಾತ್ವ್ಯಾ ದಿಸಿ ಫುರಾ ಕಾಮ್ ಇಬೆ ಕರ್ತಲೊ ಸಬ್ಬಾತಾಚೊ ದಿಸ್ ಹೊವ್ನ್ ಹಾಯ್, ತೊ ಸರ್ವೆಸ್ಪರಾಚೊ ನಿತಳ್ ದಿಸ್, ಅಸ್ಲ್ಯಾ ಸಬ್ಬತಾಚ್ಯಾ ದಿಸಿ ಕಾಯ್ತರ್ ಕಾಮ್ ಕರಲ್ಲ್ಯಾಕ್ ಮರ್ನಾಚಿ ಶಿಕ್ಷ್ಯಾ ಹೊವ್ಚಿ. <verse eid="EXO 31:15" /><verse number="16" style="v" sid="EXO 31:16" />ತಸೆ ಹೊವ್ನ್, ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಸಬ್ಬಾತಾಚೊ ದಿಸ್ ಆಚರನ್ ಕರುಚೆ, ಹೆ ಆಚರನ್ ತೆಂಕಾ ಅನಿ ತೆಂಚ್ಯಾ ಪಿಳ್ಗಿಚ್ಯಾಕ್ನಿ ಶಾಶ್ವತಾಚೊ ಕರಾರ್ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EXO 31:16" /><verse number="17" style="v" sid="EXO 31:17" />ಮಾಜ್ಯಾ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಮದ್ದಿ ಹಿ ಸದಾ ಸರ್ವತಾಚಿ ವಳಕ್, ಸರ್ವೆಸ್ಪರಾನ್ ಸಾ ದಿಸ್ ಕಾಮ್ ಕರುನ್ ಮಳಬ್ ಅನಿ ಜಿಮಿನ್ ರಚುನ್, ಸಾತ್ವ್ಯಾ ದಿಸಿ ಆರಾಮ್ ಕರ್ಲ್ಯಾನ್ ನ್ಹಯ್ . <verse eid="EXO 31:17" /><verse number="18" style="v" sid="EXO 31:18" />ಸರ್ವೆಸ್ಪರಾನ್ ಸಿನಾಯ್ ಮಡ್ಡಿ ವರ್‍ತಿ ಮೊಯ್ಜೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ತಲೆ ಸಾರುನ್, ಮಾನಾ ತೆಕಾ ದೊನ್ ಹುಕುಮಾಂಚೆ ಗುಂಡೆ ದಿಲ್ಯಾನ್, ತೆ ದೆವಾನ್ ಅಪ್ನಾಚ್ಯಾ ಹಾತಿನಿ ಕೊರದಲ್ಲೆ ಗುಂಡೆ.<verse eid="EXO 31:18" /></para>
  <chapter eid="EXO 31" />
  <chapter number="32" style="c" sid="EXO 32" />
  <para style="s">ಸೊನ್ಯಾಚೊ ಬೈಲ್</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1" />ಮೊಯ್ಜೆನ್ ಮಡ್ಡಿ ವೈನಾ ಉತ್ರುನ್ ಯೆವ್ಕ್ ತಡೊ ಕರಲ್ಲೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಬಗುನ್, ತೆನಿ ಸಗ್ಳೆ ಗೊಳಾ ಹೊವ್ನ್ ಆರೊನಾಕ್ಡೆ ಯೆವ್ನ್, “ಉಟ್ ಅನಿ ಅಮ್ಕಾ ಫಿಡೆ ಚಾಲ್ವುಕ್ ದೆವಾ ಕರುನ್ ದಿ, ಅಮ್ಕಾ ಇಜಿಪ್ತಾಕ್ನಾ ಬಲ್ವುನ್ ಹಾನಲ್ಲೊ ಮೊಯ್ಜೆ ಕಾಯ್ ಹೊಲೊಕಿ ಗೊತ್ತ್ ನಾ” ಮಟ್ಲ್ಯಾನಿ. <verse eid="EXO 32:1" /><verse number="2" style="v" sid="EXO 32:2" />ತನ್ನಾ ಆರೊನಾನ್, “ತುಮ್ಚ್ಯಾ ಬಾಯ್ಕಾ ಪೊರಾಂಚ್ಯಾ ಕಾನಾಕ್ನಿ ಹೊತ್ತಿ ಸೊನ್ಯಾಚಿ ವಸ್ತಾ ಕಾಡುನ್ ಮಾಕಾ ದಿವಾ” ಮನ್ತಾನಾ, <verse eid="EXO 32:2" /><verse number="3" style="v" sid="EXO 32:3" />ತಸೆಚ್ ಸಗ್ಳ್ಯಾ ಲೊಕಾನಿ ಅಪ್ನಾಚ್ಯಾ ಕಾನಾತ್ನಿ ಹೊತ್ತೆ ಸೊನೆ ಕಾಡುನ್ ಆರೊನಾಕ್ಡೆ ಹಾನುನ್ ದಿಲ್ಯಾನಿ. <verse eid="EXO 32:3" /><verse number="4" style="v" sid="EXO 32:4" />ತೆನಿ ತೆ ಸೊನೆ ಘೆವ್ನ್, ಉಳಿಯಾನಿ ಬೈಲಾಚ್ಯಾ ಪಾಡ್ಯಾಚೊ ಆಕಾರ್ ಕರುನ್ ದಿತಾನಾ, ತ್ಯಾ ಲೊಕಾನಿ “ಇಜ್ರಾಯೆಲಾನೊ, ಅಬಕಾ, ತುಮ್ಕಾ ಇಜಿಪ್ತಾಕ್ನಾ ಬಲ್ವುನ್ ಹಾನಲ್ಲೊ ದೆವ್ ಹ್ಯೊಚ್” ಮಟ್ಲ್ಯಾನಿ.<verse eid="EXO 32:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 32:5" />ಆರೊನಾನ್ ತೆ ಬಗುನ್, ಬೈಲಾಚ್ಯಾ ಪಾಡ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಭಾಂದುನ್,</para>
  <para style="p" vid="EXO 32:5">“ಉದ್ದ್ಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ ಮಾನ್ ದಿವ್ಕ್ ಸನ್ ಕರುಚೆ” ಮನುನ್ ಪರ್ಗಟ್ಲ್ಯಾನ್. <verse eid="EXO 32:5" /><verse number="6" style="v" sid="EXO 32:6" />ತಸೆ ಹೊವ್ನ್ ಲೊಕಾನಿ ದುಸ್ರೆಂದಿಸಿ ಉಟುನ್ ಸಗ್ಳೆ ಅಂಗ್ ಬಲಿ ಅನಿ ಸಮಾದಾನಾಚಿ ಬಲಿಯಾ ಭೆಟ್ವುಲ್ಯಾನಿ, ಲೊಕಾನಿ ಬಸುನ್ ಜೆವ್ನ್, ಫಿವ್ನ್ ಮಾನಾ ಉಟುನ್ ನಾಚುನ್ ಮಜ್ಯಾ ಕರ್ಲ್ಯಾನಿ.<verse eid="EXO 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 32:7" />ಅಸೆ ರ್‍ಹಾತಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, ತಿಯಾ ಮಡ್ಡಿ ವೈನಾ ಉತ್ರುನ್ ಜಾ, ತಿಯಾ ಇಜಿಪ್ತಾಕ್ನಾ ಬಲ್ವುನ್ ಹಾನಲ್ಲಿ ತುಜಿ ಲೊಕಾ ಪಾಪ್ ಕರುನ್ ಮಾಜೆಕ್ನಾ ತಿರಸ್ಕಾರ್ ಹೊಲಾತ್.<verse eid="EXO 32:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 32:8" />ಮಿಯಾ ತೆಂಕಾ ಹುಕುಮ್ ದಿಲ್ಲಿ ವಾಟ್ ತೆನಿ ಲಗ್ಗುನಾ ಇಸ್ರುನ್ ಅಪ್ನಾಕ್ನಿ ಪಾಜೆ ಹೊಲ್ಲಿ ಸೊನ್ಯಾಚ್ಯಾ ಬೈಲಾಚ್ಯಾ ಪಾಡ್ಯಾಚಿ ಮುರ್ತಿ ಕರುನ್ ಘೆವ್ನ್ ತೆಕಾ ಪಾಂಯ್ ಪಡುನ್ ಬಲಿ ಭೆಟ್ವುನ್, “ಅಬಕಾ ಇಜ್ರಾಯೆಲಾನೊ ತುಮ್ಕಾ ಇಜಿಪ್ತಾಕ್ನಾ ಹಾನಲ್ಲೊ ದೆವ್ ಹ್ಯೊಚ್” ಮನುಕ್ ಲಾಗ್ಲಾತ್.<verse eid="EXO 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 32:9" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ಹಿ ಲೊಕಾ ಕವ್ಡೆ ಮೊಂಡ್ ಹಾತ್ ಮನುನ್ ಮಾಕಾ ಗೊತ್ತ್ ಹಾಯ್, <verse eid="EXO 32:9" /><verse number="10" style="v" sid="EXO 32:10" />ತಸೆಹೊವ್ನ್ ತಿಯಾ ಮಾಕಾ ಅಡ್ವುನಕ್ಕೊ, ಮಾಜೊ ರಾಗ್ ಪೆಟುಂದಿತ್, ತೆಂಕಾ ಜಾಳ್ವುನ್ ಟಾಕ್ತಾ, ಅನಿ ಮಾನಾ ತುಜೆಕ್ನಾಚ್ ಲೊಕಾಂಚೊ ಮೊಟೊ ತಾಂಡೊ ಹೊಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಅಪ್ನಾಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಮಾಗುನ್ ಘೆವ್ನ್ , “ಸರ್ವೆಸ್ಪರಾ ತಿಯಾ ಮೊಟ್ಟ್ಯಾ ಬಳಾನ್ ಅನಿ ಭುಜೆಚ್ಯಾ ಬಳಾನ್ ಇಜಿಪ್ತಾಕ್ನಾ ಸೊಡ್ಸುನ್ ಹಾನಲ್ಲ್ಯಾ ತುಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವರ್‍ತಿ ಕಶ್ಯಾಕ್ ರಾಗಾನ್ ಪೆಟ್ತೆಯ್?” <verse eid="EXO 32:11" /><verse number="12" style="v" sid="EXO 32:12" />ಇಜಿಪ್ತಾಚ್ಯಾ ಲೊಕಾನಿ, “ತುಜ್ಯಾ ವಿಶಯಾತ್, ಸರ್ವೆಸ್ಪರಾನ್ ತರಾಸ್ ದಿವ್ಚೆ ಮನುನುಚ್ ಇಜ್ರಾಯೆಲಾಕ್ನಿ ಹಿತ್ತೆತ್ನಾ ಬಲ್ವುನ್ ನ್ಹೆಲ್ಯಾನ್, ತೆಂಕಾ ಡಂಗ್ಳಿತ್ ಮಾರುನ್ ಜಿಮ್ನಿ ವೈನಾ ನಾಶ್ ಕರುಕುಚ್ ಬಲ್ವುನ್ ನ್ಹೆಲ್ಯಾನ್, ಮನುನ್ ಸಾಂಗಿ ಸಾರ್ಕೆ ಹೊವ್ಚೆ ಕಾಯ್? ತಿಯಾ ಪೆಟ್ತಲೊ ರಾಗ್ ಸೊಡುನ್ ತುಜ್ಯಾ ಲೊಕಾಕ್ನಿ ಬುರ್ಸೆ ಕರಿನಸ್ತಾನಾ ಮನ್ ಬದ್ಲುನ್ ಘೆ”. <verse eid="EXO 32:12" /><verse number="13" style="v" sid="EXO 32:13" />“ತುಜಿ ಸೆವಕಾ ಅಬ್ರಾಹಾಮ್, ಇಸಾಕ್ ಅನಿ ಜಾಕೊಬಾಕ್ ಯಾದ್ ಕರುನ್ಗೆ, ತಿಯಾ ತೆಂಕಾ ಆನ್ ಘಾಲುನ್, ಮಿಯಾ ತುಮ್ಚಿ ಪಿಳ್ಗಿ ವಾಡ್ವುನ್ ಮಳ್ಬಾತ್ಲ್ಯಾ ಚುಕ್ಕಿಯಾಂಚ್ಯಾ ತವ್ಡೆ ಕರ್ತಾ, ಅನಿ ಮಿಯಾ ಸಾಂಗ್ತಲಿ ಹಿ ಸಗ್ಳಿ ಗಾಂವಾ ತುಮ್ಚ್ಯಾ ಪಿಳ್ಗಿಕ್ ದಿತಾ ಮನುನ್, ಅನಿ ತೆನಿ ಹ್ಯೊ ದೆಶ್ ಸದಾ ಸರ್ವತಾಕ್ ತುಮ್ಕಾ ಅಧಿನ್ ಕರುನ್ ದಿತಾ ಮನುನ್ ಗೊಸ್ಟ್ ದಿಲೆಯ್”, ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 32:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 32:14" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ , ಅಪ್ನಾಚ್ಯಾ ಲೊಕಾಕ್ನಿ ಅಪ್ನಿ ಕರ್ತಾ ಮನುನ್ ಸಾಂಗಲ್ಲ್ಯಾ ಬುರ್ಸ್ಯಾಚ್ಯಾ ವಿಶಯಾತ್ ಮನ್ ಬದ್ಲುನ್ ಘೆಟ್ಲ್ಯಾನ್.<verse eid="EXO 32:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 32:15" />ಹುಕುಮಾಂಚೆ ತೆ ದೊನ್ ಗುಂಡೆ ಹಾತಿತ್ನಿ ಧರುನ್ಗೆವ್ನ್ ಮೊಯ್ಜೆ ಮಡ್ಡಿವೈನಾ ಉತ್ರುನ್ ಯೆಲೊ, ತ್ಯಾ ಗುಂಡ್ಯಾಂಚ್ಯಾ ದೊನಿ ಆಂಗಾನಿಬಿ ಹುಕುಮಾ ಲಿವಲ್ಲಿ ಹೊತ್ತಿ, ದೊನಿ ಭಾಜುಕ್ನಿಬಿ ಲಿವಲ್ಲೆ ಹೊತ್ತೆ. <verse eid="EXO 32:15" /><verse number="16" style="v" sid="EXO 32:16" />ತೆ ಗುಂಡೆ ದೆವಾಚೆ ಕಾಮ್ ಹೊಲ್ಲೆ, ತೆಜ್ಯಾ ವರ್‍ತಿ ಲಿವಲ್ಲೆ ದೆವಾನ್ ಕೊರ್ದುನ್ ಲಿವಲ್ಲಿ ಅಕ್ಷರಾಚ್ ಹೊಲ್ಲಿ.<verse eid="EXO 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 32:17" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಲೈ ಕುಶಿನಿ ಬೊಬ್ ಮಾರುನ್ಗೆತ್ ರ್‍ಹಾತಾನಾ, ಜೊಶ್ವಾನ್ ತಿ ಧನ್ ಆಯ್ಕುನ್, “ಬಿಡಾರಾಂಚ್ಯಾಕ್ನಾ ಯುದ್ದಾಚಿ ಧನ್ ಆಯ್ಕುಲ್ಲಾ” ಮನುನ್ ಮೊಯ್ಜೆಕ್ ಸಾಂಗ್ಲ್ಯಾನ್.<verse eid="EXO 32:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 32:18" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, “ಮಾಕಾ ಆಯ್ಕು ಲಾಗಲ್ಲಿ ಜಿಕೆಚಿ ಬೊಬ್ ಬಿ ನ್ಹಯ್ , ಹಾರಲ್ಲಿ ಬೊಬ್ ಬಿ ನ್ಹಯ್ , ಗಿತ್ ಸಾಂಗ್ತಲ್ಲ್ಯಾಂಚಿ ಬೊಬುಚ್” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 32:18" /><verse number="19" style="v" sid="EXO 32:19" />ತೆನಿ ಬಿಡಾರಾಂಚ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ, ಪಾಡೊ ಅನಿ ಲೊಕಾ ನಾಚು ಲಾಗಲ್ಲೆ ಬಗುನ್, ಲೈ ರಾಗಾನ್, ಹಾತಿತ್ಲೆ ಕರಾರಾಚೆ ಗುಂಡೆ ಮಡ್ಡಿಚ್ಯಾ ಬುಡ್ಲ್ಯಾ ಜಿಮ್ನಿ ವರ್‍ತಿ ಟಾಕುನ್ ಫೊಡ್ಲ್ಯಾನ್. <verse eid="EXO 32:19" /><verse number="20" style="v" sid="EXO 32:20" />ಲೊಕಾನಿ ಕರ್ಸುನ್ ಘೆಟಲ್ಲೊ ಪಾಡೊ ಆಗಿನ್ ಜಾಳ್ವುನ್ ಪುಡ್ ಪುಡ್ ಕರುನ್ ಪಾನಿಯಾವರ್‍ತಿ ವೊತುನ್ ತೆ ಪಾನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಫಿವ್ಸುಲ್ಯಾನ್.<verse eid="EXO 32:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 32:21" />ಅನಿ ತನ್ನಾ ತೆನಿ ಆರೊನಾಕ್ “ತಿಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಮೊಟೊ ಪಾಪ್ ಕರಸ್ಲೈ ನ್ಹಯ್ ? ತಿಯಾ ಅಸೆ ಕರುಕ್ ತೆನಿ ತುಕಾ ಕಾಯ್ ಕರ್ಲ್ಯಾನಿ?” ಮನುನ್ ಇಚಾರ್‍ತಾನಾ, <verse eid="EXO 32:21" /><verse number="22" style="v" sid="EXO 32:22" />ಆರೊನಾನ್, “ಸಾಯ್ಬಾ ತಿಯಾ ಬೆಜಾರ್ ಹೊವ್ ನಕ್ಕೊ, ಹಿ ಲೊಕಾ ಬುರ್ಸ್ಯಾ ಚಾಲಿಚಿ ಮನುನ್ ತುಕಾ ಗೊತ್ತ್ ಹಾಯ್, <verse eid="EXO 32:22" /><verse number="23" style="v" sid="EXO 32:23" />ತೆನಿ ಮಾಜೆಕ್ಡೆ ಯೆವ್ನ್, ‘ಅಮ್ಚ್ಯಾ ಫಿಡೆ ಚಾಲ್ವುಕ್ ದೆವಾ ಕರುನ್ ದಿ, ಇಜಿಪ್ತಾಕ್ನಾ ಅಮ್ಕಾ ಬಲ್ವುನ್ ಹಾನಲ್ಲೊ ಮೊಯ್ಜೆ ಕಾಯ್ ಹೊಲೊಕಿ ಗೊತ್ತ್ ನಾ’, ಮಟ್ಲ್ಯಾನಿ. <verse eid="EXO 32:23" /><verse number="24" style="v" sid="EXO 32:24" />ತನ್ನಾ ಮಿಯಾ ಸೊನ್ಯಾಚಿ ವಸ್ತಾ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ಕಾಡುನ್ ದಿವಾ ಮನ್ತಾನಾ, ತೆನಿ ದಿಲ್ಯಾನಿ ಮಿಯಾತೆ ಘೆವ್ನ್ ಆಗಿತ್ ಘಾಲ್ತಾನಾ, ಪಾಡೊ ಹೊಲೊ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 32:25" />ಲೊಕಾನಿ ದಿಕ್ ಚುಕುನ್ ಅಪ್ನಾಚ್ಯಾ ಮನಾಕ್ ಯೆಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಕರುಕ್ ಆರೊನಾನ್ ಸೊಡಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ತೆಂಚ್ಯಾ ವಿರೊದಿಯಾಕ್ನಿ ಹಾಸುಕ್ ವಾಟ್ ಹೊಲಿ. <verse eid="EXO 32:25" /><verse number="26" style="v" sid="EXO 32:26" />ತೆನಿ ರಿತ್ ನಸ್ತಾನಾ ಕರುಲಾಗಲ್ಲಿ ಕಾಮಾ ಮೊಯ್ಜೆನ್ ಬಿಡಾರಾಚ್ಯಾ ದಾರಾತ್ ಇಬೆರಾವ್ನ್ ಬಗುನ್, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಪಕ್ಷಾಚೆ ಮಾಜೆಕ್ಡೆ ಯೆವ್ಚೆ ಮಟ್ಲ್ಯಾನ್, ತನ್ನಾ ಲೆವಿಚ್ಯಾ ಕುಳಿಚೆ ಸಗ್ಳೆ ತೆಜ್ಯಾಕ್ಡೆ ಯೆಲೆ. <verse eid="EXO 32:26" /><verse number="27" style="v" sid="EXO 32:27" />ಮೊಯ್ಜೆನ್ ತೆಂಕಾ, “ಇಜ್ರಾಯೆಲಾಂಚೊ ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ಹುಕುಮ್ ದಿತಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ತುಮ್ಚ್ಯಾತ್ಲೊ ಹರ್ ಎಕ್ಲೊಬಿ ಕಂಬ್ರೆಕ್ ಕೊಯ್ತೊ ಭಾಂದುನ್ಗೆವ್ನ್, ಬಿಡಾರಾಂಚ್ಯಾ ಮದ್ದಿ ಎಕ್ ದಾರಾಕ್ನಾ ಅನಿ ಎಕ್ ದಾರಾಕ್ಡೆ ಫಿರುನ್ಗೆತ್, ಭಾವ್, ವಾಂಗ್ಡಿ, ಸೆಜಾರಿ ಮನುನ್ ಬಗಿನಸ್ತಾನಾ, ಲೊಕಾಕ್ನಿ ನಾಶ್ ಕರುಚೆ”, ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 32:28" />ಲೆವಿಚ್ಯಾ ಕುಳಿಚ್ಯಾನಿ ಮೊಯ್ಜೆಚ್ಯಾ ಹುಕುಮಾ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನಿ, ತ್ಯಾ ದಿಸಿ ಲೊಕಾತ್ನಿ ಲೈ ಕರುನ್ ತಿನ್ ಹಾಜಾರ್ ಲೊಕಾ ಮರ್ಲಿ. <verse eid="EXO 32:28" /><verse number="29" style="v" sid="EXO 32:29" />ಮೊಯ್ಜೆನ್ ಲೆವಿಕ್ನಿ, ಆಜ್ ತುಮ್ಚ್ಯಾತ್ಲೊ ಹರ್ ಎಕ್ಲೊಬಿ, ಲೆಕಾಕ್ ಅನಿ ಭಾವಾಕ್ ದ್ಯಾನ್ ದಿಯ್ ನಸ್ತಾನಾ, ತುಮ್ಕಾ ತುಮಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಸೆವಾಕ್ ಒಪ್ಸುನ್ ದಿವ್ಚೆ, ತಸೆ ಹೊಲ್ಯಾರ್ ತೊ ತುಮ್ಕಾ ಆಜುಚ್ ಆಶಿರ್ವಾದ್ ದಿತಾ, ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30" />ದುಸ್ರೆಂದಿಸಿ ಮೊಯ್ಜೆನ್ ಲೊಕಾಕ್ನಿ, ತುಮಿ ಮೊಟಿ ಚುಕ್ ಕರ್ಲ್ಯಾಸಿ, ಹೊಲ್ಯಾರ್ಬಿ ಮಿಯಾ ಮಡ್ಡಿಚಡುನ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಜಾತಾ, ಖರೆ ಮಾಜೆ ವೈನಾ ತುಮಿ ಕರಲ್ಲ್ಯಾ ಪಾಪಾಕ್ನಿ ಮಾಪಿ ಗಾವ್ತಿಲ್, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 32:30" /><verse number="31" style="v" sid="EXO 32:31" />ತನ್ನಾ ಮೊಯ್ಜೆನ್ ಪರ್‍ತುನ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಜಾವ್ನ್, “ಅಯ್ಯೊ, ಅಯ್ಯೊ ಹ್ಯಾ ಲೊಕಾನಿ ಮೊಟೊ ಪಾಪಾ ಕರ್ಲಾತ್, ಸೊನ್ಯಾಚೊ ದೆವ್ ಕರುನ್ಗೆಟ್ಲಾತ್. <verse eid="EXO 32:31" /><verse number="32" style="v" sid="EXO 32:32" />ಖರೆ ತಿಯಾ ದಯಾಕರುನ್ ತೆಂಚೊ ಪಾಪ್ ಮಾಪಿ ಕರುಚೆ, ನಾ ಹೊಲ್ಯಾರ್ ತಿಯಾ ಲಿವಲ್ಲ್ಯಾ ಝಿತ್ತ್ಯಾಂಚ್ಯಾ ಪಟ್ಟಿತ್ನಾ ಮಾಜೆ ನಾವ್ಬಿ ಪುಸುನ್ ಟಾಕ್, ಮನುನ್ ಮಾಗ್ತಾ” ಮನುನ್ ಮಾಗ್ನಿ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 32:32" /><verse number="33" style="v" sid="EXO 32:33" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ , ಮಾಜಿ ಗೊಸ್ಟ್ ಚುಕುನ್ ಕೊನಿ ಕೊನಿ ಚುಕ್ ಕರ್ಲಾತ್ ತೆಂಚಿ ನಾಂವಾಚ್ ಮಾಜೆಕ್ಲ್ಯಾ ಪಟ್ಟಿತ್ನಾ ಪುಸುನ್ ಟಾಕ್ತಾ. <verse eid="EXO 32:33" /><verse number="34" style="v" sid="EXO 32:34" />ತಿಯಾ ಹಿತ್ತೆತ್ನಾ ಜಾವ್ನ್ ಮಿಯಾ ತುಕಾ ಸಾಂಗಲ್ಲ್ಯಾ ದೆಶ್ಯಾಕ್ ತೆಂಕಾ ಚಾಲ್ವುನ್ಗೆವ್ನ್ ಜಾ, ತುಜ್ಯಾ ಫಿಡೆ ಮಾಜೊ ಧುತ್ ಜಾತಾ, ಖರೆ ಮಿಯಾ ತೆಂಕಾ ಶಿಕ್ಷ್ಯಾ ದಿತಾನಾ ತೆಂಚ್ಯಾ ಪಾಪಾಂಚ್ಯಾ ಸಮಾಚ್ ಶಿಕ್ಷ್ಯಾದಿತಾ.<verse eid="EXO 32:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 32:35" />ಇಜ್ರಾಯೆಲಾನಿ ಆರೊನಾಚ್ಯಾ ಹಾತಿತ್ನಾ ಸೊನ್ಯಾಚೊ ಪಾಡೊ ಕರ್ಸುನ್ ಘೆಟಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಸರ್ವೆಸ್ಪರಾನ್ ತೆಂಕಾ ಶಿಕ್ಷ್ಯಾ ದಿಲ್ಯಾನ್.<verse eid="EXO 32:35" /></para>
  <chapter eid="EXO 32" />
  <chapter number="33" style="c" sid="EXO 33" />
  <para style="s">ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಸರ್ವೆಸ್ಪರಾನ್ ಸಿನಾಯ್ ಮಡ್ಡಿ ಸೊಡುನ್ ಜಾವ್ಕ್ ಹುಕುಮ್ ದಿಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ತಿಯಾ ಅನಿ ತುಜ್ಯಾ ವಾಂಗ್ಡಾ ಇಜಿಪ್ತಾತ್ನಾ ಭಾಯ್ರ್ ಹಾನಲ್ಲಿ ಲೊಕಾ ಹೊ ಜಾಗೊ ಸೊಡುನ್ ಮಿಯಾ ಅಬ್ರಾಹಾಮಾಕ್, ಇಸಾಕಾಕ್, ಜಾಕೊಬ್ ಅನಿ ತೆಂಚ್ಯಾ ಪುರ್ವಜಾಕ್ನಿ ಭಾಸ್ ದಿಲ್ಲ್ಯಾ ಜಾಗ್ಯಾಕ್ ಜಾ”, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 33:1" /><verse number="2" style="v" sid="EXO 33:2" />ಮಿಯಾ ಎಕ್ ದುತಾಕ್ ಧಾಡ್ತಾ, ತೊ ತುಕಾ ವಾಟ್ ದಾಕ್ವುತಾ, ಅನಿ ಮಿಯಾ ಕಾನಾನ್ ಕಾರಾಕ್ನಿ, ಅಮೊರಿಯಾಕ್ನಿ, ಹಿತ್ತಿಯಾಕ್ನಿ, ಹಿವ್ವಿಯಾಕ್ನಿ, ಪೆರಿಜಿಯಾಕ್ನಿ, ಅನಿ ಜೆಬುಸಿಯಾಕ್ನಿ ಹಾರ್ವುತಾ, <verse eid="EXO 33:2" /><verse number="3" style="v" sid="EXO 33:3" />ತಿಯಾ, ಮ್ಹಾವ್ ಅನಿ ದುದ್ದ್ ಹೊಂವ್ತಲ್ಯಾ ಜಾಗ್ಯಾರ್ ಜಾವ್ಲೆಯ್, ಖರೆ ಮಿಯ್ಯಾ ತುಜೆಕ್ನಾ ಯೆಯ್ನಾ ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತುಮಿ ಮಾಜ್ಯಾ ಹುಕುಮಾಕ್ನಿ ಆಯ್ಕಿನಾಶಿ ಆಶಿ ಹೊವ್ನ್ ಮಿಯಾ ತುಮ್ಕಾ ವಾಟೆರ್ ನಾಸ್ ಕರುಕ್ ಸಕ್ತಾ.<verse eid="EXO 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 33:4" />ಲೊಕಾನಿ ಹೆ ಆಯ್ಕಲ್ಲೆ ತನ್ನಾ ಗುನ್ಗುಟ್ಟುಕ್ ಚಾಲು ಕರ್ಲ್ಯಾನಿ, ಅನಿ ಸೊನೆ ಚಾಂದಿ ನೆಸ್ತಲೆ ಸೊಡ್ಲ್ಯಾನಿ. <verse eid="EXO 33:4" /><verse number="5" style="v" sid="EXO 33:5" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಲೊಕಾಕ್ನಿ ಆಶೆ ಸಾಂಗುಕ್ ಹುಕುಮ್ ದಿಲ್ಯಾನ್, “ತುಮಿ ಕೊನಾಕ್ ಬಿ ಆಯ್ಕಿ ನಸಲ್ಲ್ಯಾ ಲೊಕಾನು, ಮಿಯ್ಯಾ ತುಮ್ಚೆಕ್ನಾ ಉಲ್ಲೊ ಎಳ್ ರಾಲ್ಯಾರ್ ಬಿ ತುಮ್ಕಾ ನಾಶ್ ಕರ್ತಾ, ಅತ್ತಾ ತುಮ್ಚೆ ಸೊನೆ ಕಾಡಾ, ಮಿಯಾ ತುಮ್ಕಾ ಕಾಯ್ ಕರುಚೆ ಮನುನ್ ನಿರ್ದಾರ್ ಕರುನ್ ಸಾಂಗ್ತಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 33:5" /><verse number="6" style="v" sid="EXO 33:6" />ತಸೆ ಹೊವ್ನ್, ತೆನಿ ಸಿನಾಯ್<note caller="+" style="f"><char style="fr" closed="false">33:6 </char><char style="ft" closed="false">ಹೆಕಾ ಹೊರೆಬ್ ಮನುನ್ ಅನಿ ಎಕ್ ನಾವ್ ಹಾಯ್</char></note> ಮಡ್ಡಿ ದಾಟಲ್ಲೆ ತನ್ನಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಕೊನಿಬಿ ಸೊನೆ ನೆಸುಕ್ ನಸಲ್ಲ್ಯಾನಿ.<verse eid="EXO 33:6" /></para>
  <para style="s">ಸರ್ವೆಸ್ಪರಾಚೆ ಹಾಜಿರ್ಪಾನಾಚಿ ಗುಡಿ</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7" />ಇಜ್ರಾಯೆಲಾಚಿ ಲೊಕಾ ರಾವ್ಕ್ ಜಾಗೊ ಕರಿತ್, ತನ್ನಾ ಮೊಯ್ಜೆ ಪವಿತ್ರ್ ಜಾಗೊ ಹುಡ್ಕುನ್ ತೆಂಚೆಕ್ನಾ ಉಲ್ಲೆ ಧುರ್ ಜಾಗೊ ಕರಿ, ತ್ಯಾ ಜಾಗ್ಯಾಕ್ ಸರ್ವೆಸ್ಪರಾಚೆ ಹಾಜಿರ್ಪಾನಾಚಿ ಗುಡಿ ಮನಿತ್, ಕೊನಾಕ್ ಬಿ ಕಾಯ್ತರ್ ತರಾಸ್ ರಾಲ್ಯಾರ್ ತ್ಯಾ ಜಾಗ್ಯಾರ್ ಜಾವ್ನ್ ದಾಕುನ್ ಘೆಯ್ತ್. <verse eid="EXO 33:7" /><verse number="8" style="v" sid="EXO 33:8" />ಮೊಯ್ಜೆ ಭಾಯ್ರ್ ಗೆಲ್ಲ್ಯಾ ತನ್ನಾ, ಸಗ್ಳಿ ಲೊಕಾ ಅಪಾಪ್ಲ್ಯಾ ಬಿಡಾರಾಚ್ಯಾ ದಾರಾಕ್ಡೆ ಇಬೆ ರಾವ್ನ್ ತೊ ಭಿತ್ತುರ್ ಜಾಯ್ ಪತರ್ ತೆಕಾ ಬಗಿತ್. <verse eid="EXO 33:8" /><verse number="9" style="v" sid="EXO 33:9" />ಮೊಯ್ಜೆ ಬಿಡಾರಾಚ್ಯಾ ಭುತ್ತುರ್ ಗೆಲ್ಯಾ ಮಾನಾ, ಮೊಡಾಚೊ ಖಾಂಬೊ ಉತ್ರುನ್ ತ್ಯಾ ಬಿಡಾರಾಚ್ಯಾ ದಾರಾತ್ ಇಬೆರಾಯ್, ಅಸೆ ಸರ್ವೆಸ್ಪರ್ ಮೊಯ್ಜೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲಿ. <verse eid="EXO 33:9" /><verse number="10" style="v" sid="EXO 33:10" />ಮೊಡಾಚೊ ಖಾಂಬೊ ಬಿಡಾರಾಚ್ಯಾ ದಾರಾತ್ ಇಬೆ ಹೊತ್ತೆ ಬಗಲ್ಲ್ಯಾ ತನ್ನಾ ಸಗ್ಳಿ ಲೊಕಾ ಅಪಾಪ್ಲ್ಯಾ ಬಿಡಾರಾಂಚ್ಯಾ ದಾರಾತ್ನಿಚ್ ಡಬ್ಬ್ ಪಡಿತ್. <verse eid="EXO 33:10" /><verse number="11" style="v" sid="EXO 33:11" />ಸರ್ವೆಸ್ಪರ್ ಮೊಯ್ಜೆಚ್ಯಾ ಇದ್ರಾಕ್ ಯೆವ್ನ್ ದೊಸ್ತಾಕ್ಡೆ ಬೊಲಲ್ಯಾ ಸಾರ್ಕೆ ಇದ್ರಾ ಬದ್ರಾಕ್ ರಾವ್ನ್ ಬೊಲಿ, ಅನಿ ಮೊಯ್ಜೆ ಥೈತ್ನಾ ಗೆಲ್ಲೆ ತನ್ನಾ ನುನಾಚೊ ಲೆಕ್ ಮೊಯ್ಜೆಚೊ ಸೆವಕ್, ಹೊಲ್ಲೊ ಜೊಶುವಾ ಮನ್ತಲೊ ದಾಂಡ್ಗೊ ಮಾನುಸ್, ಬಿಡಾರಾತ್ ರಾಯ್.<verse eid="EXO 33:11" /></para>
  <para style="s">ಸರ್ವೆಸ್ಪರಾನ್ ಅಪ್ನಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ರ್‍ಹಾತಾ ಮನುನ್ ಗೊಸ್ಟ್ ದಿಲ್ಲೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12" />ಮೊಯ್ಜೆನ್ ಸರ್ವೆಸ್ಪರಾಕ್, “ತಿಯಾ ಮಾಕಾ ಹ್ಯಾ ಲೊಕಾಕ್ನಿ ತ್ಯಾ ಜಾಗ್ಯಾಕ್ ಚಾಲ್ವುನ್ ಘೆವ್ನ್ ಜಾ ಮನುನ್ ಹುಕುಮ್ ದಿಲೈ, ಖರೆ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಕೊನಾಕ್ ಧಾಡ್ತೆಯ್ ಮನುನ್ ಸಾಂಗುಕ್ ನ್ಹಯ್ , ತುಜೆ ನಾವ್ ವಳಕ್ಲೈ ಅನಿ ತುಕಾ ಮಾಜಿ ದಯಾ ಗಾವ್ಲಾ, ಮನುನ್ ತಿಯಾ ಮಾಕಾ ಸಾಂಗಲೈ ನ್ಹಯ್ . <verse eid="EXO 33:12" /><verse number="13" style="v" sid="EXO 33:13" />ಮಾಕಾ ತುಜಿ ದಯಾ ಗಾವಲ್ಲಿ ಹೊಯ್ ಹೊಲ್ಯಾರ್, ಮಿಯಾ ತುಕಾ ವಳಕಲ್ಲೊ ಹೊಯ್ ಹೊವ್ನ್ ರಾಯ್ ಸಾರ್ಕೆ ಮಾಕಾ ತುಜಿ ವಾಟ್ ದಾಕ್ವು, ತನ್ನಾ ಮಾಕಾ ತುಜಿ ದಯಾ ಗಾವ್ಲಾ ಮನುನ್ ಮಿಯಾ ಕಳ್ವುನ್ ಘೆತಾ, ಅನಿ ಹಿ ಲೊಕಾ ತುಜಿಚ್ ಮನ್ತಲೆ ಯಾದೆಕ್ ಹಾನುನ್ ಘೆ” ಮನುನ್ ಮಾಗ್ನಿ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 33:13" /><verse number="14" style="v" sid="EXO 33:14" />ಸರ್ವೆಸ್ಪರಾನ್ , “ಮಿಯಾ ತುಜೆಕ್ನಾ ಯೆತಾ, ಅನಿ ತುಕಾ ಆರಾಮ್ ಥವ್ತಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 33:14" /><verse number="15" style="v" sid="EXO 33:15" />ಮೊಯ್ಜೆನ್ ಜವಾಬ್ ದಿವ್ನ್, ತಿಯಾ ಅಮ್ಚೆಕ್ನಾ ಯೆಯ್ ನಸ್ಲ್ಯಾರ್, ಅಮ್ಕಾ ಹೊ ಜಾಗೊ ಸೊಡುಕ್ ಲಾವ್ ನಕ್ಕೊ, <verse eid="EXO 33:15" /><verse number="16" style="v" sid="EXO 33:16" />ತಿಯಾ ಅಮ್ಚೆಕ್ನಾ ಯೆಯ್ ನಸ್ಲ್ಯಾರ್, “ತಿಯಾ ತುಜ್ಯಾ ಲೊಕಾನಿಕ್ನಾ ಅನಿ ಮಾಜೆಕ್ನಾ ಖುಶಿನ್ ಹಾಸ್ ಮನುನ್ ತುಜೆ ಹಾಜಿರ್ ಪಾನ್ ಅಮ್ಕಾ ಹುರಲ್ಲ್ಯಾ ಜಿಮ್ನಿ ವೈಲ್ಯಾ ಲೊಕಾನಿಕ್ನಾ ಯೆಗ್ಳೆಚ್ ಕರ್ತಾ ಮನುನ್ ಕೊನಾಕ್ ಕಶಿ ಕಳ್ತಾ ಕಿ?” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 33:16" /><verse number="17" style="v" sid="EXO 33:17" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ತುಕಾ ಮಾಜಿ ದಯಾ ಗಾವಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಅನಿ ಮಿಯಾ ತುಜೆ ನಾವ್ ವಳಕಲ್ಲ್ಯಾಸಾಟ್ನಿ, ಮಿಯಾ ಹೆ ಕಾಮ್ ತುಜ್ಯಾ ಸಾಟ್ನಿ ಕರ್ತಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18" />ತನ್ನಾ ಮೊಯ್ಜೆನ್, “ಸರ್ವೆಸ್ಪರಾಕ್ ದಯಾಕರುನ್ ಮಾಕಾ ತುಜ್ಯಾ ಮಹಿಮಾ ದಾಕ್ವು” ಮನುನ್ ಮಾಗ್ಲ್ಯಾನ್.<verse eid="EXO 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 33:19" />ಸರ್ವೆಸ್ಪರಾನ್ , ಮಾಜಿ ಮಹಿಮಾ ತುಜ್ಯಾ ಇದ್ರಾಕ್ನಾ ದಾಟುನ್ ಜಾಯ್ ಸಾರ್ಕೆ ಕರ್ತಾ ಅನಿ ತುಜ್ಯಾ ಇದ್ರಾಕ್ ಮಿಯಾ ಮಾಜೆ ಪವಿತ್ರ್ ನಾವ್ ಸಾಂಗ್ತಾ, ಮಿಯಾಚ್ ಸರ್ವೆಸ್ಪರ್ ಅನಿ ಮಿಯಾ ಎಚುನ್ ಘೆಟಲ್ಲ್ಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಮಾಜಿ ದಯಾ ಅನಿ ಕಾಳ್ಜಿ ದಾಕ್ವುತಾ. <verse eid="EXO 33:19" /><verse number="20" style="v" sid="EXO 33:20" />ಖರೆ ತುಮಿ ಮಾಜೆ ತೊಂಡ್ ಬಗುಕ್ ಹೊಯ್ನಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಮಾಕಾ ಬಗಟಲ್ಲೊ ಝಿತ್ತೊ ರ್‍ಹಾಯ್ನಾ. <verse eid="EXO 33:20" /><verse number="21" style="v" sid="EXO 33:21" />ಖರೆ ಹಿತ್ತೆ ಮಾಜ್ಯಾ ಬಾಜುಕ್ ಎಕ್ ಮೊಟೊ ಗುಂಡೊ ಹಾಯ್ ತೆಚೆರ್ ತಿಯಾ ಇಬೆರಾ. <verse eid="EXO 33:21" /><verse number="22" style="v" sid="EXO 33:22" />ಮಾಜಿ ಮಹಿಮಾ ತುಜ್ಯಾ ಇದ್ರಾಕ್ನಾ ದಾಟುನ್ ಜಾತಾನಾ, ಮಿಯಾ ತುಕಾ ಹ್ಯಾ ಗುಂಡ್ಯಾಚ್ಯಾ ಸಂದ್ಡಿತ್ ಇಬೆ ಕರುನ್, ಮಿಯಾ ದಾಟಿ ಪತರ್ಬಿ ತುಕಾ ಮಾಜ್ಯಾ ಹಾತಿನ್ ಧಾಪ್ತಾ. <verse eid="EXO 33:22" /><verse number="23" style="v" sid="EXO 33:23" />ಮಾನಾ ಮಿಯಾ ಮಾಜೊ ಹಾತ್ ಪಾಟಿ ಘೆತಾ, ತಿಯಾ ಮಾಜಿ ಫಾಟ್ ಬಗ್ತೆಯ್, ಖರೆ ಮಾಜೆ ತೊಂಡ್ ಬಗುಕ್ ಹೊಯ್ನಾ ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 33:23" /></para>
  <chapter eid="EXO 33" />
  <chapter number="34" style="c" sid="EXO 34" />
  <para style="s">ಅನಿಬಿ ದೊನ್ ಗುಂಡ್ಯಾಚಿ ಫಳಿಯಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ಪಯ್ಲ್ಯಾ ಸಾರ್ಕೆ ಅನಿಬಿ ದೊನ್ ಗುಂಡ್ಯಾಚಿ ಫಳಿಯಾ ತಯಾರ್ ಕರುನ್ಗೆ, ಅನಿ ಪಯ್ಲೆ ತಿಯ್ಯಾ ಪೊಡಲ್ಯಾ ಗುಂಡ್ಯಾ ವೈನಿ ಗೊಸ್ಟಿಯಾ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆ, ಮಿಯ್ಯಾ ತೆಂಚೆರ್ ಲಿವ್ತಾ. <verse eid="EXO 34:1" /><verse number="2" style="v" sid="EXO 34:2" />ಉದ್ದ್ಯಾ ಸಕ್ಕಾಳಿ ತಯಾರ್ ಹೊವ್ನ್, ಸಿನಾಯ್ ಮಡ್ಡಿಚ್ಯಾ ತುದಿರ್ ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಯೆವ್ನ್ ಇಬೆರಾ. <verse eid="EXO 34:2" /><verse number="3" style="v" sid="EXO 34:3" />ತುಜಾ ವಾಂಗ್ಡಾ ಕೊನ್ ಬಿ ಯೆವ್ಚೆ ನ್ಹಯ್ , ಹ್ಯಾ ಮಡ್ಡಿಚ್ಯಾ ಜಗ್ಗೊಳ್ ಕೊನ್ಬಿ ದಿಸುಚೆ ನ್ಹಯ್ , ಬಕ್ರೆ, ನಾತರ್ ಗೊರಾ ಡೊರಾ ಸೈತ್ ಮಡ್ಡಿಚ್ಯಾ ಫಿಡೆ ಚರುಚೆ ನ್ಹಯ್ ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 34:3" /><verse number="4" style="v" sid="EXO 34:4" />ಸರ್ವೆಸ್ಪರಾನ್ ಹುಕುಮ್ ದಿಲ್ಯಾ ಸಾರ್ಕೆ, ಮೊಯ್ಜೆನ್ ದೊನ್ ಗುಂಡ್ಯಾಚಿ ಫಳಿಯಾ ತಯಾರ್ ಕರುನ್ ಘೆವ್ನ್ ಸಕ್ಕಾಳಿ ನಸ್ಕಾತ್ ತೆ ಘೆವ್ನ್ ಸಿನಾಯ್ ಮಡ್ಡಿರ್ ಗೆಲೊ. <verse eid="EXO 34:4" /><verse number="5" style="v" sid="EXO 34:5" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ಮಳ್ಬಾನ್ ಧಾಪುನ್ಗೆವ್ನ್ ಖಾಲ್ತಿ ಯೆವ್ನ್ ತೆಚೆಕ್ಡೆ ಇಬೆ ರಾವ್ನ್, ಅಪ್ನಾಚೆ ಪವಿತ್ರ್ ನಾವ್, ಸರ್ವೆಸ್ಪರ್ ಮನುನ್ ಪರ್ಗಟ್ಲ್ಯಾನ್. <verse eid="EXO 34:5" /><verse number="6" style="v" sid="EXO 34:6" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ತೆಚ್ಯಾ ಇದ್ರಾಕ್ ಯೆವ್ನ್,</para>
  <para style="q1" vid="EXO 34:6">ಮಿಯಾ, ದಯಾ ಅನಿ ಕಾಳಜಿ ಹೊತ್ತೊ ದೆವ್,</para>
  <para style="q1" vid="EXO 34:6">ಕಮ್ಮಿ ರಾಗಾಚೊ,</para>
  <para style="q2" vid="EXO 34:6">ಪ್ರೆಮ್ ಅನಿ ವಿಶ್ವಾಸಾಚೊ ದೆವ್,<verse eid="EXO 34:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 34:7" />ಹಾಜಾರ್ ಟಕ್ಲ್ಯಾಂಚ್ಯಾ ಪತರ್ಬಿ ತುಜ್ಯಾ ಪಿಳ್ಗಿಕ್ ಪ್ರೆಮ್ ದಾಕ್ವುತಾ, ಪಾಪಾಚಿ ಅಪ್ರಾದಾ ಮಾಪ್ ಕರ್ತಾ, ಖರೆ ಮಿಯಾ ಚುಕ್ ಕರಲ್ಯಾಂಚ್ಯಾ ಪೊರಾಕ್ನಿ ಅನಿ ನಾತ್ರಾಕ್ನಿ ತೆಂಚ್ಯಾ ತಿನ್ವಾ ಅನಿ ಚಾರ್ವ್ಯಾ ಪಿಳ್ಗಿಕ್ ಶಿಕ್ಷ್ಯಾ ದಿವ್ಕ್ ಇಸ್ರಿನಾ, ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 34:7" /><verse number="8" style="v" sid="EXO 34:8" />ಮೊಯ್ಜೆನ್ ಎಕ್ದಮ್ ಅಡ್ವೆ ಪಡುನ್ ಆರಾದನ್ ಕರುನ್, <verse eid="EXO 34:8" /><verse number="9" style="v" sid="EXO 34:9" />“ಸರ್ವೆಸ್ಪರಾ ತುಜಿ ದಯಾ ಮಾಕಾ ಗಾವಲ್ಲಿ ಹೊಯ್ ಹೊಲ್ಯಾರ್, ತಿಯಾಚ್ ಮಾಜ್ಯಾ ವಾಂಗ್ಡಾ ಯೆವ್ಚೆ, ಅಮ್ಚಿ ಲೊಕಾ ಮಂಡ್ ಹಾತ್, ಖರೆ ತಿಯಾ ಅಮ್ಚಿ ಪಾಪಾ ಅನಿ ಬುರ್ಶಿ ಕಾಮಾ ಕ್ಷಮಾ ಕರುನ್, ತುಜಿ ಸ್ವತಾಚಿ ಲೊಕಾ ಕರುನ್ ಅಮ್ಕಾ ಮಾನುನ್ ಘೆವ್ಚೆ”, ಮನುನ್ ಮಾಗ್ನಿ ಕರ್ಲ್ಯಾನ್.<verse eid="EXO 34:9" /></para>
  <para style="s">ಕರಾರ್ ನವಿ ಕರ್‍ತಲೆ</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, ಆಯ್ಕ್, ಮಿಯಾ ಎಕ್ ಕರಾರ್ ಕರ್ತಾ, ಹ್ಯಾ ಜಗಾತ್ ಖೈ ಬಿ ಖಲ್ಯಾಬಿ ಲೊಕಾತ್ನಿ ಹೊವ್ಕ್ ನಸಲ್ಲೆ ಮೊಟಿ ಕಾಮಾ ತುಜಿ ಲೊಕಾ ಬಗಿ ಸಾರ್ಕೆ ಕರ್ತಾ, ತುಜ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತಿ ಸಗ್ಳಿ ಲೊಕಾ ಸರ್ವೆಸ್ಪರಾಚೆ ಚಮತ್ಕಾರ್ ಬಗ್ತಾತ್, ಮಿಯಾ ತುಮ್ಚ್ಯಾ ವಿಶಯಾತ್ ಕರುಚೆ ಮನುನ್ ಚಿಂತಲ್ಲೆ ಲೈ ಮೊಟೆ ಹಾಯ್. <verse eid="EXO 34:10" /><verse number="11" style="v" sid="EXO 34:11" />ಮಿಯಾ ಅತ್ತಾ ಹುಕುಮ್ ದಿತಲ್ಯಾಕ್ ತುಮಿ ಮಾನ್ ದಿವ್ನ್ ಚಲುಚೆ, ಅಬಕ್, ಮಿಯಾ ಅಮೊರಿಯ, ಕಾನಾನ್ ಕಾರಾ, ಹಿತ್ತಿಯಾ ಅನಿ ಪರಿಜಿಯಾ, ಹಿವ್ವಿಯಾ, ಅನಿ ಜೆಬುಸಿಯಾಕ್ನಿ ತುಮ್ಚ್ಯಾ ಇದ್ರಾಕ್ ಪಳಸ್ತಾ. <verse eid="EXO 34:11" /><verse number="12" style="v" sid="EXO 34:12" />ಬಗಾ, ತುಮಿ ಜಾವ್ನ್ ಪಾವ್ತಲ್ಯಾ ದೆಶಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಕಸ್ಲೊಬಿ ಕರಾರ್ ಕರುನ್ ಘೆವ್ಕ್ ನ್ಹಯ್ , ತೊ ಕರಾರ್ ತುಮ್ಕಾ ಪಾಸೊ ಹೊವ್ನ್ ರಾತಿಲ್. <verse eid="EXO 34:12" /><verse number="13" style="v" sid="EXO 34:13" />ತಸೆಹೊವ್ನ್, ತುಮಿ ತೆಂಚೆ ಬಲಿ ಭೆಟ್ವುತಲೆ ಕಟ್ಟೆ ಪಾಡ್ವುನ್, ತೆಂಚೆ ಗುಂಡ್ಯಾಚೆ ಖಾಂಬೆ ಪಾಡ್ವುನ್ ಅಶೆರ್ ಮನ್ತಲೆ ಮುರ್ತಿಯಾಂಚೆ ಖಾಂಬೆ ತೊಡುನ್ ಟಾಕುಚೆ. <verse eid="EXO 34:13" /><verse number="14" style="v" sid="EXO 34:14" />ಸ್ವತಾಚಿ ಮಾನ್ ರಾಕುನ್ ಘೆತಲೊ ಮನ್ತಲ್ಯಾ ನಾವಾಚೊ ಸರ್ವೆಸ್ಪರ್ , ಅಪ್ನಾಚೆ ಮಾನ್ ದುಶ್ರ್ಯಾಕ್ನಿ ಜಾವ್ಕ್ ದಿಯ್ ನಸಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ತುಮಿ ದುಶ್ರ್ಯಾ ಖಲ್ಯಾಬಿ ದೆವಾಚ್ಯಾ ಫಿಡೆ ಡಬ್ಬ್ ಪಡುಚೆ ನ್ಹಯ್ . <verse eid="EXO 34:14" /><verse number="15" style="v" sid="EXO 34:15" />ತುಮಿ ತ್ಯಾ ದೆಶ್ಯಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಕರಾರ್ ಕರುನ್ಗೆಯ್ ನಸ್ತಾನಾ ಹುಶಾರ್ಕಿನ್ ರಾವಾ, ತಸೆ ಹೊಲ್ಯಾರ್ ತೆನಿ ಅಪ್ನಾಚ್ಯಾ ದೆವಾಕ್ನಿ ಫುಜ್ಯಾ ಕರುನ್ ಬಲಿ ಭೆಟ್ವಲ್ಲ್ಯಾ ತನ್ನಾ ತೆಂಚ್ಯಾತ್ಲೊ ಕೊನ್ ತರ್ಬಿ ತುಮ್ಕಾ ಜೆವ್ನಾಕ್ ಬಲ್ವುತಲೊ, ಅನಿ ತುಮಿ ಜಾವ್ನ್ ಜೆವ್ಸಿಲಾ ಬಗಾ; <verse eid="EXO 34:15" /><verse number="16" style="v" sid="EXO 34:16" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ತುಮಿ ತೆಂಚ್ಯಾಕ್ನಾ ಚೆಡ್ವಾ, ಝಿಲ್ಗೆ ಹಾನ್ತಲೆ ನಾತರ್ ದಿತಲೆ ಹೊಯ್ಲ್, ಮಾನಾ ತಿ ಸುನ್ನಾ ಅವ್ಸಿಚ್ಯಾ ಘರಾಚ್ಯಾ ದೆವಾಕ್ನಿ ಫುಜ್ಯಾ ಕರ್‍ತಲೆ ಹೊವ್ನ್ ತುಮ್ಚ್ಯಾ ಪೊರಾಕ್ನಿ ದುಶ್ರ್ಯಾ ದೆವಾಂಚ್ಯಾ ಫುಜ್ಯಾಚ್ಯಾ ಪಾಪಾತ್ ಘಾಲ್ತಿಲ್, ಹುಶ್ಯಾರ್ಕಿನ್ ರಾವಾ. <verse eid="EXO 34:16" /><verse number="17" style="v" sid="EXO 34:17" />ಮುರ್ತಿಯಾ ದೆವ್ ಮನುನ್ ಕರುನ್ ಘೆವ್ ನಕಾಸಿ. <verse eid="EXO 34:17" /><verse number="18" style="v" sid="EXO 34:18" />ಫುಗ್ ನಸಲ್ಲಿ ಭಾಕ್ರಿಯಾ ಖಾತಲಿ ಜಾತ್ರಾ ಕರುಚೆ, ಮಿಯಾ ತುಮ್ಕಾ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಪೈಲ್ಯಾ ಮೈನ್ಯಾತ್ ಸಾತ್ ದಿಸಾ ಫುಗ್ ನಸಲ್ಲಿ ಭಾಕ್ರಿಯಾ ಖಾವ್ಚೆ, ತುಮಿ ಇಜಿಪ್ತಾಕ್ನಾ ಸುಟ್ಕಾ ಹೊವ್ನ್ ಯೆಲ್ಲೆ ಪೈಲೆಚ್ಯಾ ಮೈನ್ಯಾತುಚ್ ನ್ಹಯ್ .<verse eid="EXO 34:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 34:19" />ತುಮ್ಚ್ಯಾತ್ ಮಾನ್ಸಾಚೆ ಹೊಂವ್ದಿತ್, ಗೊರಾ-ಡೊರಾಂಚೆ ಹೊಂವ್ದಿತ್ ಪೈಲೆ ಉಪಾಜಲ್ಲೆ ಗಂಡ್ ಹೊತ್ತೆ ಸಗ್ಳೆ ಮಾಜೆಚ್. <verse eid="EXO 34:19" /><verse number="20" style="v" sid="EXO 34:20" />ಗಾಡ್ವಾಚ್ಯಾ ಪೆಟ್ಯಾಚ್ಯಾ ಬದ್ಲಾಕ್ ಬಕ್ರ್ಯಾಚೊ ಪೆಟೊ ದಿವ್ನ್ ತ್ಯಾ ಗಾಡ್ವಾಚ್ಯಾ ಪೆಟ್ಯಾಕ್ ಸೊಡ್ಸುನ್ ಘೆವ್ಚೆ, ತಸೆ ಸೊಡ್ಸುನ್ ಘೆವ್ಕ್ ಹೊವ್ಕ್ ನಸ್ಲ್ಯಾರ್, ತೆಜೊ ಗಳೊ ಚಿರ್ಡುನ್ ಜಿವ್ ಕಾಡುಚೆ, ಖರೆ ತುಮ್ಚ್ಯಾ ಥೊರ್ಲ್ಯಾ ಝಿಲ್ಗ್ಯಾಕ್ ಜಿವ್ ಕಾಡಿನಸ್ತಾನಾ ಬದ್ಲಿಕ್ ದಿವ್ನ್ ಸೊಡ್ಸುನ್ ಘೆವ್ಚೆ,</para>
  <para style="p" vid="EXO 34:20">ಮಾಜ್ಯಾ ಇದ್ರಾಕ್ ಯೆತಾನಾ ಎಕ್ಲೊಬಿ ಕಾನಿಕ್ ನಸ್ತಾನಾ ದಿಸುಚೆ ನ್ಹಯ್ .<verse eid="EXO 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21" />ಸಾ ದಿಸ್ ತುಮ್ಚೆ ಕಾಮ್ ಕರುನ್ ಸಾತ್ವ್ಯಾದಿಸಿ ಕಾಯ್ಬಿ ಕಾಮ್ ಕರಿನಸ್ತಾನಾ ರಾವ್ಚೆ, ಪೆರ್ತಲ್ಯಾ ಅನಿ ಕಾತರ್ತಲ್ಯಾ ಎಳಾರ್ಬಿ ತಸೆಚ್ ಸಾತ್ವ್ಯಾ ದಿಸಾತ್ ಕಾಯ್ಬಿ ಕಾಮ್ ಕರುಚೆ ನ್ಹಯ್ . <verse eid="EXO 34:21" /><verse number="22" style="v" sid="EXO 34:22" />ಪಾತ್ಕಾಚೊ ಸನ್ ಹೊಲ್ಲ್ಯಾ ಉಲ್ಲಿ ವಾರಾಂಚ್ಯಾ ಮಾನಾ ಘಂವಾಚ್ಯಾ ಪಿಕೆಚಿ ಪೈಲೆಚಿ ಭೆಟ್ವುತಲಿ ಜಾತ್ರಾ, ಅನಿ ಮೈನ್ಯಾಚ್ಯಾ ಆಕ್ರಿಕ್ ಪಿಕ್ ಗೊಳಾ ಕರ್ತಲಿ ಜಾತ್ರಾ ಕರುಚೆ. <verse eid="EXO 34:22" /><verse number="23" style="v" sid="EXO 34:23" />ತುಮ್ಚ್ಯಾತ್ಲಿ ಫುರಾ ಘವ್ಮಾನ್ಸಾ ವರ್ಸಾಕ್ ತಿನ್ದಾ ಇಜ್ರಾಯೆಲಾಂಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಆರಾದನ್ ಕರುಚೆ. <verse eid="EXO 34:23" /><verse number="24" style="v" sid="EXO 34:24" />ಮಿಯಾ ತುಮ್ಚ್ಯಾ ಇದ್ರಾಕ್ನಾ ದುಶ್ರ್ಯಾ ದೆಶ್ಯಾಚ್ಯಾಕ್ನಿ ಪಳ್ಸುನ್ ತುಮ್ಚೊ ದೆಶ್ ವಾಡ್ವುತಾ, ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ತುಮಿ ವರ್ಸಾಕ್ ತಿನ್ದಾ ತುಮ್ಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಜಾತಾನಾ, ಕೊನಾಚೆನ್ಬಿ ತುಮ್ಚಿ ಜಿಮಿನ್ ಕಾಡುನ್ಗೆವ್ಕ್ ಹೊಯ್ನಾ.<verse eid="EXO 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25" />ಮಾಕಾ ಬಲಿ ಭೆಟ್ವುತಾನಾ, ಬಲಿಚ್ಯಾ ಜನಾವರಾಚ್ಯಾ ರಗ್ತಾ ವಾಂಗ್ಡಾ ಆಂಬೊಟ್ ಪಿಟ್ಟ್ ಭೆಟ್ವುಚೆ ನ್ಹಯ್ , ಪಾತ್ಕಾಚ್ಯಾ ಸನಾತ್ ತುಮಿ ಭೆಟ್ವಲ್ಲೆ ಮಾಂಸ್ ದುಸ್ರೆಂದಿಸಾ ಪತರ್ಬಿ ಥವ್ಚೆ ನ್ಹಯ್ . <verse eid="EXO 34:25" /><verse number="26" style="v" sid="EXO 34:26" />ಜಿಮ್ನಿಚ್ಯಾ ಪೈಲೆಚ್ಯಾ ಫಳಾತ್ ಬರೆ ಹೊತ್ತೆ, ತುಮ್ಚೊ ದೆವ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗುಡಿಕ್ ಹಾನುಚೆ, ಶೆಳಿಚ್ಯಾ ಪೆಟ್ಯಾಕ್ ತೆಜ್ಯಾ ಅವ್ಸಿಚ್ಯಾ ದುದ್ದಾತ್ ಸಿಜ್ವುಚೆ ನ್ಹಯ್ . <verse eid="EXO 34:26" /><verse number="27" style="v" sid="EXO 34:27" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್, “ತಿಯಾ ಹಿ ಗೊಸ್ಟಿಯಾ ಲಿವ್, ಹ್ಯಾ ಗೊಸ್ಟಿಯಾಂಚ್ಯಾ ವೈನಾ ತುಜೆಕ್ನಾ ಅನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಕರಾರ್ ಕರುನ್ಗೆಟ್ಲಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 34:27" /><verse number="28" style="v" sid="EXO 34:28" />ಮೊಯ್ಜೆನ್, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಮಡ್ಡಿ ವರ್‍ತಿ ಚಾಳಿಸ್ ರ್‍ಹಾತ್ ಅನಿ ದಿಸ್ ಕಾಯ್ಬಿ ಖಾಯ್ ನಸ್ತಾನಾ, ಅನಿ ಕಾಯ್ಬಿ ಫಿಯ್ ನಸ್ತಾನಾ ರಾವ್ನ್, ಸರ್ವೆಸ್ಪರಾಚಿ ಕರಾರಾಚಿ ಹುಕುಮಾ ಗುಂಡ್ಯಾಂಚ್ಯಾ ವರ್‍ತಿ ಲಿವ್ಲ್ಯಾನ್.<verse eid="EXO 34:28" /></para>
  <para style="s">ಮೊಯ್ಜೆ ಸಿನಾಯ್ ಮಡ್ಡಿಕ್ನಾ ಖಾಲ್ತಿ ಯೆತಲೆ</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 34:29" />ಮೊಯ್ಜೆ ತೆ ದೊನ್ ಹುಕುಮಾಂಚೆ ಗುಂಡೆ ಹಾತಿತ್ನಿ ಧರುನ್ಗೆವ್ನ್, ಸಿನಾಯ್ ಮಡ್ಡಿ ಉತ್ರುನ್ ಯೆತಾನಾ, ತೆನಿ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಬೊಲುನ್ ಯೆಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ತೆಚೆ ತೊಂಡ್ ಹೊಳ್ವುಲಾಗಲ್ಲೆ, ಖರೆ ತೆಕಾ ತೆ ಕಳುಕ್ ನಾ. <verse eid="EXO 34:29" /><verse number="30" style="v" sid="EXO 34:30" />ಮೊಯ್ಜೆಚೆ ತೊಂಡ್ ಹೊಳ್ವುಲಾಗಲ್ಲೆ ಆರೊನ್ ಅನಿ ಹುರಲ್ಲ್ಯಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಬಗುನ್ ತೆಜ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆವ್ಕ್ ಭಿಂವ್ಲ್ಯಾನಿ. <verse eid="EXO 34:30" /><verse number="31" style="v" sid="EXO 34:31" />ಖರೆ ಮೊಯ್ಜೆನ್ ತೆಂಕಾ ಬಲ್ವುತಾನಾ, ಆರೊನ್ ಅನಿ ತೆಂಚ್ಯಾ ತಾಂಡ್ಯಾಚೆ ಸಗ್ಳೆ ಅಧಿಪತಿ ತೆಜ್ಯಾ ಜಗ್ಗೊಳ್ ಯೆಲೆ, ಅನಿ ಮೊಯ್ಜೆನ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಬೊಲ್ಲ್ಯಾನ್. <verse eid="EXO 34:31" /><verse number="32" style="v" sid="EXO 34:32" />ಮಾನಾ ಸಗ್ಳಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಜಗ್ಗೊಳ್ ಯೆಲಿ, ಮೊಯ್ಜೆನ್ ಅಪ್ನಿ ಸಿನಾಯ್ ಮಡ್ಡಿ ವರ್‍ತಿ ಸರ್ವೆಸ್ಪರಾಕ್ನಾ ಘೆಟಲ್ಲಿ ಸಗ್ಳಿ ಹುಕುಮಾ ತೆಂಕಾ ಸಾಂಗ್ಲ್ಯಾನ್. <verse eid="EXO 34:32" /><verse number="33" style="v" sid="EXO 34:33" />ಮೊಯ್ಜೆನ್ ತೆಂಚ್ಯಾಕ್ನಾ ಬೊಲುನ್ ಹೊಲ್ಯಾ ಮಾನಾ ಅಪ್ನಾಚ್ಯಾ ತೊಂಡಾ ವರ್‍ತಿ ಮುಸ್ಕೊ ಘಾಲುನ್ ಘೆಟ್ಲ್ಯಾನ್. <verse eid="EXO 34:33" /><verse number="34" style="v" sid="EXO 34:34" />ತೊ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಬೊಲುಕ್ ಜಾತಾನಾ, ತೊ ಮುಸ್ಕೊ ಕಾಡುನ್ ಥವ್ತಾ, ಅನಿ ಅಪ್ನಿ ಭಾಯ್ರ್ ಯೆತಾನಾ ಸರ್ವೆಸ್ಪರಾಚಿ ಹುಕುಮಾ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ ಕಳ್ವುತಾ. <verse eid="EXO 34:34" /><verse number="35" style="v" sid="EXO 34:35" />ಮೊಯ್ಜೆಚೆ ತೊಂಡ್ ಹೊಳ್ವುಲಾಗಲ್ಲೆ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಬಗಿತ್, ತಸೆ ಹೊವ್ನ್, ತೊ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಬೊಲುಕ್ ಜಾಯ್ ಪತರ್ಬಿ ಅಪ್ನಾಚ್ಯಾ ತೊಂಡಾ ವೈಲೊ ಮುಸ್ಕೊ ಧಾಪುನ್ ಘೆವ್ನುಚ್ ಹೊತ್ತೊ.<verse eid="EXO 34:35" /></para>
  <chapter eid="EXO 34" />
  <chapter number="35" style="c" sid="EXO 35" />
  <para style="s">ಸಬ್ಬಾತಾಚಿ ನೆಮಾ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1" />ಮೊಯ್ಜೆನ್ ಇಜ್ರಾಯೆಲಾಂಚಿ ಸಗ್ಳಿ ಲೊಕಾ ಎಕಾಕ್ಡೆ ಗೊಳಾ ಕರುನ್ “ಸರ್ವೆಸ್ಪರಾನ್ ತುಮ್ಕಾ ಹುಕುಮ್ ದಿಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, <verse eid="EXO 35:1" /><verse number="2" style="v" sid="EXO 35:2" />ತುಮಿ ಸಾ ದಿಸ್ ಕಾಮ್ ಕರುಚೆ, ಖರೆ ಸಾತ್ವೊ ದಿಸ್ ನಿತಳ್ ಅನಿ ದೆವಾಕ್ ಮನುನ್ ಸಾಬ್ಬಾತಾಚೊ ದಿಸ್ ಹೊಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ಜೆ ಕೊನ್ ಹ್ಯಾ ದಿಸಿ ಕಾಮ್ ಕರ್ತಾ ತೊ ಮರ್ತಾ. <verse eid="EXO 35:2" /><verse number="3" style="v" sid="EXO 35:3" />ಸಾಬ್ಬಾತಾ ದಿಸಿ ತುಮ್ಚಾ ಘರ್‍ಹಾತ್ ತುಮಿ ಆಗ್ ಬಿ ಪೆಟ್ವಿ ಸಾರ್ಕೆ ನಾ” ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 35:3" /></para>
  <para style="s">ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ಸಾಮಾನಾ</para>
  <para style="r">
    <ref loc="EXO 25:1-9">25:1-9</ref></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4" />ಮೊಯ್ಜೆನ್ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ, ಸರ್ವೆಸ್ಪರಾನ್ ಅಶೆ ಹುಕುಮ್ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, <verse eid="EXO 35:4" /><verse number="5" style="v" sid="EXO 35:5" />ತುಮಿ ತುಮ್ಚ್ಯಾಕ್ನಾ ಕಾನಿಕ್ ಹಾನುನ್ ಸರ್ವೆಸ್ಪರಾಕ್ ಕಾನಿಕ್ ದಿವ್ಚೆ, ಫುರಾ ಮನಾನ್ ಕಾನಿಕ್ ದಿತಲ್ಯಾನ್ ತವ್ಡೆಚ್ ದಿವ್ಚೆ, ಸರ್ವೆಸ್ಪರಾಕ್ ದಿತಲಿ ಕಾನಿಕ್ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, ಸೊನೆ, ಚಾಂದಿ, ಅನಿ ಪಿತ್ಳಿ, <verse eid="EXO 35:5" /><verse number="6" style="v" sid="EXO 35:6" />ಝಾಂಬ್ಳ್ಯಾ ರಕ್ತಾಚ್ಯಾ ಬನ್ನಾಚೊ ದೊರೊ, ಅನಿ ಶುದ್ದ್ ಕಪ್ಡೆ, ಶೆಳಿಯಾಂಚ್ಯಾ ಕೆಸಾಂಚೆ ಕಪ್ಡೆ, <verse eid="EXO 35:6" /><verse number="7" style="v" sid="EXO 35:7" />ಹಾದಾಕ್ ಹಾನಲ್ಲಿ ತಾಂಬ್ಡ್ಯಾ ಬನ್ನಾಚ್ಯಾ ಬಕ್ರ್ಯಾಚಿ ಕೆಸಾ ಅನಿ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆ ವೈಲ್ಯಾ ಡುಕ್ರಾಚೆ ಚಮ್ಡೆ, ಅನಿ ಜಾಲಿ ಝಡಾಚೆ ನಾಕುಡ್. <verse eid="EXO 35:7" /><verse number="8" style="v" sid="EXO 35:8" />ದಿವ್ಯಾಕ್ನಿ ಪಾಜೆ ಹೊಲ್ಲೆ ತೆಲ್, ಅಭಿಶೆಕಾಚೆ ತೆಲ್ ಅನಿ ಬರ್ಯಾ ವಾಸೆಚೆ ಧುಪ್ ಅನಿ ಪಾಜೆ ಹೊಲ್ಲಿ ಬರ್ಯಾ ವಾಸೆಚಿ ಪಾನಿಯಾ, <verse eid="EXO 35:8" /><verse number="9" style="v" sid="EXO 35:9" />ತಸೆಚ್ ಮೊಟ್ಟ್ಯಾ ಯಾಜಕಾಂಚ್ಯಾ ಛಾತಿಚ್ಯಾ ಕವ್ಚಿಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ರತ್ನಾ ಅನಿ ಪಿಸ್ವಿಚ್ಯಾ ಪದ್ಕಾತ್ ಕೊರದ್ತಲಿ ರತ್ನಾ ಹೆ ಸಗ್ಳೆ ದಿವ್ಚೆ.<verse eid="EXO 35:9" /></para>
  <para style="s">ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಬಿಡಾರಾಚಿ ಲಿವಲ್ಲಿ ಸಾಮಾನಾ</para>
  <para style="r">
    <ref loc="EXO 39:32-43">39:32-43</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10" />ತುಮ್ಚ್ಯಾತ್ಲಿ ಬುದ್ವಂತ್ ಲೊಕಾ ಯೆವ್ನ್, ಸರ್ವೆಸ್ಪರಾನ್ ಹುಕುಮ್ ದಿಲ್ಲೆ ಹೆ ಸಗ್ಳೆ ಕರುಚೆ, <verse eid="EXO 35:10" /><verse number="11" style="v" sid="EXO 35:11" />ತೆನಿ ಕರುಚೆ ಹೊಲ್ಲಿ ಕಾಮಾ ಖಲಿ ಮಟ್ಲ್ಯಾರ್, ದೆವಾಕ್ ಬಗ್ತಲೆ ಬಿಡಾರ್, ತೆಚ್ಯಾ ವೈಲಿ ಕಾಂಬ್ರಾನ್, ತೆಚಿ ಕೊಂಡಿಯಾ, ಚವ್ಕಟಾ, ಅಗ್ಳಿಯಾ, ಖಾಂಬೆ ಅನಿ ಪಾಯಾಚೆ ಗುಂಡೆ, <verse eid="EXO 35:11" /><verse number="12" style="v" sid="EXO 35:12" />ಕರಾಂಚೆ ಗುಂಡೆ ಹೊತ್ತಿ ಪೆಟಿ, ತೆ ಉಕಲ್ತಲೆ ದಾಂಡೆ, ಕ್ರಪಾಸನ್ ಅನಿ ತೆ ಧಾಪ್ತಲೊ ಪರ್ದೊ. <verse eid="EXO 35:12" /><verse number="13" style="v" sid="EXO 35:13" />ಮಾಚೊ, ತೆಚೆ ದಾಂಡೆ, ತೆಚಿ ಸಾಮಾನಾ ಅನಿ ತೆಜ್ಯಾ ವರ್‍ತಿ ಭೆಟ್ವುತಲಿ ಭಾಕ್ರಿಯಾ, <verse eid="EXO 35:13" /><verse number="14" style="v" sid="EXO 35:14" />ದಿವ್ಯಾಚೊ ಖಾಂಬೊ, ತೆಚಿ ಸಾಮಾನಾ, ದಿವೆ, ದಿವ್ಯಾಕ್ನಿ ಪಾಜೆ ಹೊಲ್ಲೆ ತೆಲ್, <verse eid="EXO 35:14" /><verse number="15" style="v" sid="EXO 35:15" />ಧುಪಾಚೆ ಕಟ್ಟೊ ಅನಿ ತೆಚೆ ದಾಂಡೆ, ಅಭಿಶೆಕಾಚೆ ತೆಲ್, ಬರ್ಯಾ ವಾಸೆಚ್ಯಾ ಧುಪಾಚೆ ತೆಲ್, ಬಿಡಾರಾಚ್ಯಾ ದಾರಾಚೊ ಪರ್ದೊ, <verse eid="EXO 35:15" /><verse number="16" style="v" sid="EXO 35:16" />ಬಲಿಚೊ ಕಟ್ಟೊ, ತಾಂಬ್ಯಾಚಿ ಚಾಳನ್, ದಾಂಡೆ, ಸಾಮಾನಾ, ಮೊಟಿ ವಾಟ್ಲಿ ಅನಿ ತೆಚೊ ಕಟ್ಟೊ. <verse eid="EXO 35:16" /><verse number="17" style="v" sid="EXO 35:17" />ದಾರಾಚೆ ಪರ್ದೆ, ಖಾಂಬೆ, ಪಾಯಾಚೆ ಗುಂಡೆ ಅನಿ ಭಾಯ್ಲ್ಯಾ ದಾರಾಚೆ ಪರ್ದೆ, <verse eid="EXO 35:17" /><verse number="18" style="v" sid="EXO 35:18" />ಬಿಡಾರಾಚೆ ಖಾಂಬೆ, ದಾರಾಚೆ ಖಾಂಬೆ ಅನಿ ಹೆಂಚಿ ದೊರಿಯಾ, <verse eid="EXO 35:18" /><verse number="19" style="v" sid="EXO 35:19" />ಪವಿತ್ರ ಜಾಗ್ಯಾಕ್ ಪಾಜೆ ಹೊಲ್ಲೆ ಸುಂದರ್ ಕಪ್ಡೆ ಮಟ್ಲ್ಯಾರ್, ಮೊಟೊ ಯಾಜಕ್ ಅರೊನ್ ಅನಿ ತೆಚ್ಯಾ ಲೆಕಾಕ್ನಿ ಪಾಜೆ ಹೊಲ್ಲೆ ಕಪ್ಡೆ ಹೆಚ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 35:19" /></para>
  <para style="s">ಲೊಕಾನಿ ಹಾನಲ್ಲಿ ಅಪ್ನಾಚಿ ಕಾನಿಕಾ</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20" />ಸಗ್ಳಿ ಇಜ್ರಾಯೆಲಾಚಿ ಲೊಕಾ ಮೊಯ್ಜೆಚ್ಯಾ ಇದ್ರಾಕ್ನಾ ಗೆಲ್ಲ್ಯಾ ಮಾನಾ, <verse eid="EXO 35:20" /><verse number="21" style="v" sid="EXO 35:21" />ಕೊನಾಚ್ಯಾ ಮನಾಕ್ ಯೆತಾ, ಅನಿ ಕೊನಾಚೊ ಮನ್ ದಿವ್ಕ್ ತಯಾರ್ ಹೊತ್ತೊ, ಹೆನಿ ಸಗ್ಳ್ಯಾನಿ ಯೆವ್ನ್ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಚ್ಯಾ ಕಾಮಾಕ್ ಅನಿ ತೆಜ್ಯಾ ಸೆವಾಕ್ ಅನಿ ಯಾಜಕಾಂಚ್ಯಾ ಕಪ್ಡ್ಯಾಂಚ್ಯಾ ಸಾಟ್ನಿ ಸರ್ವೆಸ್ಪರಾಕ್ ಕಾನಿಕ್ ದಿಲ್ಯಾನಿ. <verse eid="EXO 35:21" /><verse number="22" style="v" sid="EXO 35:22" />ಬರ್ಯಾ ಮನಾಚ್ಯಾ ಘವ್ಮಾನ್ಸಾನಿ ಅನಿ ಬಾಯ್ಕೊಮನ್ಸಾನಿ ಸರ್ವೆಸ್ಪರಾ ಸಾಟ್ನಿ ಹಾತಿತ್ಲಿ ಖಡ್ಗಾ, ಕಾನಾತ್ಲಿ ಫುಲ್ಲಾ, ಛಪ್ಪ್ಯಾಚಿ ಮುದ್ದಿ, ಗಳ್ಯಾತ್ಲೆ ಹಾರ್ ಅನಿ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಸೊನ್ಯಾಚಿ ವಸ್ತಾ ಹಾನುಕ್ ದಿಲ್ಯಾನಿ. <verse eid="EXO 35:22" /><verse number="23" style="v" sid="EXO 35:23" />ಝಾಂಬ್ಳ್ಯಾ ರಕ್ತಾಚ್ಯಾ ಬನ್ನಾಚೆ ದೊರೆ, ಶುದ್ದ್ ಕಪ್ಡೆ, ಶೆಳಿಚ್ಯಾ ಕೆಸಾಂಚೆ ಕಪ್ಡೆ, ತಾಂಬ್ಡ್ಯಾ ಬನ್ನಾಚೆ ಬಕ್ರ್ಯಾಚೆ ಹದಾ ಕರಲ್ಲಿ ಕೆಸಾ, ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆ ವೈಲ್ಯಾ ಡುಕ್ರಾಚೆ ಚಮ್ಡೆ ಹೊತ್ಯಾ ಸಗ್ಳ್ಯಾನಿ ತೆ ಹಾನುನ್ ದಿಲ್ಯಾನಿ. <verse eid="EXO 35:23" /><verse number="24" style="v" sid="EXO 35:24" />ಚಾಂದಿ ನಾತರ್ ತಾಂಬೆ ಹೊತ್ತ್ಯಾ ಸಗ್ಳ್ಯಾನಿ ತೆ ಹಾನುನ್ ಸರ್ವೆಸ್ವರಾಕ್ ದಿಲ್ಯಾನಿ, ಬಿಡಾರ್ ಭಾಂದುಕ್ ಪಾಜೆ ಹೊಲ್ಲ್ಯಾ ಜಾಲಿಚ್ಯಾ ಝಾಡಾಚಿ ನಾಕ್ಡಾ ಹೊತ್ತ್ಯಾನಿಬಿ ಹಾನುನ್ ದಿಲ್ಯಾನಿ. <verse eid="EXO 35:24" /><verse number="25" style="v" sid="EXO 35:25" />ಸಗ್ಳ್ಯಾ ಬುದ್ವಂತ್ ಬಾಯ್ಕೊಮಾನ್ಸಾನಿ ಅಪ್ನಾಚ್ಯಾ ಸ್ವತ್ಯಾಚ್ಯಾ ಹಾತಾನಿ ಝಾಂಬ್ಳ್ಯಾ ರಕ್ತಾಚ್ಯಾ ಬನ್ನಾಚೆ ದೊರೆ ತಯಾರ್ ಕರುನ್, ಹಾನುನ್ ದಿಲ್ಯಾನಿ. <verse eid="EXO 35:25" /><verse number="26" style="v" sid="EXO 35:26" />ಅನಿ ಹುರಲ್ಲ್ಯಾ ಬುದ್ವಂತ್ ಬಾಯ್ಕಾಮನ್ಸಿಯಾನಿ ಶೆಳಿಯಾಂಚೆ ಕೆಸಾಂಚೆ ದೊರೆ ಕರುನ್ ಹಾನುನ್ ದಿಲ್ಯಾನಿ. <verse eid="EXO 35:26" /><verse number="27" style="v" sid="EXO 35:27" />ಅಧಿಪತಿಯಾನಿ ಮೊಟ್ಟ್ಯಾ ಯಾಜಕಾಚ್ಯಾ ಛಾತಿಚ್ಯಾ ಕವ್ಚಿಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ಗೊಮೆದಿಕ್, ರತ್ನಾ, ಅನಿ ಛಾತಿಚ್ಯಾ ಪದ್ಕಾಕ್ ಕೊರ್ದುಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ರತ್ನಾ, <verse eid="EXO 35:27" /><verse number="28" style="v" sid="EXO 35:28" />ದಿವ್ಯಾಕ್ ಪಾಜೆ ಹೊಲ್ಲೆ ತೆಲ್, ಅಭಿಶೆಕ್ ತೆಲಾಕ್ ಅನಿ ಬರ್ಯಾ ವಾಸೆಚೆ ಧುಪಾಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ಬರ್ಯಾ ವಾಸೆಚಿ ಪಾನಿಯಾ ಹಾನುನ್ ದಿಲ್ಯಾನಿ. <verse eid="EXO 35:28" /><verse number="29" style="v" sid="EXO 35:29" />ಮೊಯ್ಜೆ ವೈನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಘವ್ಮಾನ್ಸಾ ಅನಿ ಬಾಯ್ಕೊಮನ್ಸಾ ತೆ ಪುರಾ ಮನಾನ್ ಹಾನುನ್ ದಿಲ್ಯಾನಿ.<verse eid="EXO 35:29" /></para>
  <para style="s">ಸರ್ವೆಸ್ಪರಾಚಿ ಗುಡಿ ಭಾಂದುಕ್ ಕಾಮ್ ಕರ್ತಲಿ ಲೊಕಾ</para>
  <para style="r">
    <ref loc="EXO 31:1-11">31:1-11</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30" />ಅನಿ ಮೊಯ್ಜೆನ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಕ್ನಿ, ಸರ್ವೆಸ್ಪರಾನ್ ಜುದಾ ಕುಳಿಚ್ಯಾ ಹುರಾಚೊ ನಾತು ಉರಿಚೊ ಲೆಕ್ ಬೆಚೆಲಾಕ್ ತಯಾರ್ ಕರುನ್ ನೆಮ್ಲಾ. <verse eid="EXO 35:30" /><verse number="31" style="v" sid="EXO 35:31" />ತೆಕಾ ಉಜ್ವೊಡಾಚೊ ಆತ್ಮೊ ದಿವ್ನ್ ಪಾಜೆ ಹೊಲ್ಲಿ ಬುದ್ದ್, ಶಿಕಾಪ್ ಅನಿ ಶಾನೆಪಾನ್ ಅನಿ ಸಗ್ಳ್ಯಾ ನಮುನಾಚಿ ಕೊರದ್ತಲಿ ಬುದ್ದ್ ದಿಲಾ, <verse eid="EXO 35:31" /><verse number="32" style="v" sid="EXO 35:32" />ಸೊನೆ, ಚಾಂದಿ ಅನಿ ತಾಂಬ್ಯಾಚೆ ಕಾಮಾ ಕರುಕ್, <verse eid="EXO 35:32" /><verse number="33" style="v" sid="EXO 35:33" />ರತ್ನಾ ಕೊರ್ದುಕ್ ಅನಿ ಝಾಡಾಂಚಿ ಚಮತ್ಕಾರಾಚಿ ಕಾಮಾ ಕರುಕ್, ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚಿ ಕಾಮಾ ಲಾವ್ಲಾ. <verse eid="EXO 35:33" /><verse number="34" style="v" sid="EXO 35:34" />ಅನಿ ತೌವ್ಡೆಚ್ ನಸ್ತಾನಾ ದುಸ್ರ್ಯಾಕ್ನಿ ಶಿಕ್ವುಕ್ಬಿ ತೆಕಾ ಅನಿ ದಾನ್ ಕುಳಿಚ್ಯಾ ಅಹಿಸಾಮಾಕಾಚೊ ಲೆಕ್ ಒಹೊಲಿಬಾಮಾಕ್ಬಿ ವರು ದಿಲಾ. <verse eid="EXO 35:34" /><verse number="35" style="v" sid="EXO 35:35" />ಗುಂಡೆ ಚಮತ್ಕಾರಾಚೆ ಕಾಮ್ ಕರ್‍ತಲೆ ಝಾಂಬ್ಳ್ಯಾ ರಕ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ ಅನಿ ಶುದ್ದ್ ಕಪ್ಡ್ಯಾನಿ ಹಾತಿಚೆ ಕಾಮಾ ಕರ್‍ತಲೆ, ಸಿವ್ತಲೆ ಒಟ್ಟು ಸಗ್ಳ್ಯಾ ನಮುನಿಚಿ ಕಾಮಾ ಕರ್ಸುಕ್, ಅನಿ ಕರುಕ್ ಸರ್ವೆಸ್ಪರಾನ್ ತೆಂಕಾ ಬುದ್ದ್ ದಿಲಾ.<verse eid="EXO 35:35" /></para>
  <chapter eid="EXO 35" />
  <chapter number="36" style="c" sid="EXO 36" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 36:1" />ಬೆಚಲ್ ಅನಿ ಒಹೊಲಿಬಾಮಾನ್, ಸಗ್ಳೆಬಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಹುಕುಮಾ ಸಾರ್ಕೆಚ್ ಕರುಚೆ, ಅನಿ ಹುರಲ್ಲಿ ಸಗ್ಳಿ ಬುದ್ವಂತಾ ಮಟ್ಲ್ಯಾರ್, ಸರ್ವೆಸ್ಪರಾಕ್ನಾ ಬುದ್ದ್ ಪಾವುನ್ ಘೆವ್ನ್, ದೆವಾಕ್ ಬಗ್ತಲಿ ಗುಡಿ ತಯಾರ್ ಕರ್‍ತಲ್ಯಾ ಕಾಮಾ ಸಾಟ್ನಿ ಪಾಜೆ ಹೊಲ್ಲಿ ಸಾಮಾನಾ ಕಸಿ ತಯಾರ್ ಕರ್‍ತಲೆ ಮನ್ತಲೆ ಕಳ್ವುನ್ ಘೆವ್ನ್ ತೆಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಕಾಮ್ ಕರ್‍ತಾತ್ ಮಟ್ಲ್ಯಾನ್.<verse eid="EXO 36:1" /></para>
  <para style="s">ಲೊಕಾನಿ ಹಾನಲ್ಲಿ ಲೈ ಕಾನಿಕಾ</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2" />ಮೊಯ್ಜೆನ್ ಬೆಚೆಲಾಕ್, ಒಹೊಲಿಬಾಮಾಕ್, ಅನಿ ಕೊನ್ ಕೊನಾಚ್ಯಾ ಮನಾತ್ನಿ ಸರ್ವೆಸ್ಪರಾನ್ ಬುದ್ದ್ ದಿಲಾ, ಅನಿ ಕೊನಾಕ್ ಕಾಮ್ ಕರುಕ್ ಮನ್ ಹಾಯ್ ತ್ಯಾ ಸಗ್ಳ್ಯಾ ಬುದ್ವಂತಾಕ್ನಿ ಅಪ್ನಾಕ್ಡೆ ಬಲ್ವುಲ್ಯಾನ್. <verse eid="EXO 36:2" /><verse number="3" style="v" sid="EXO 36:3" />ತೆನಿ ದೆವಾಚಿ ಗುಡಿ ಬಾಂದ್ತಲ್ಯಾ ಕಾಮಾ ಸಾಟ್ನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ಮೊಯ್ಜೆಕ್ಡೆ ಹಾನುನ್ ದಿಲ್ಲಿ ಸಗ್ಳಿ ಕಾನಿಕಾ ಘೆಟ್ಲ್ಯಾನಿ. ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಹರ್ ಎಕ್ ದಿಸಾಬಿ ಸಕ್ಕಾಳಿ ಮೊಯ್ಜೆಕ್ಡೆ ಯೆವ್ನ್ ಬರ್ಯಾ ಮನಾನ್ ಕಾನಿಕ್ ದಿಯ್ತ್. <verse eid="EXO 36:3" /><verse number="4" style="v" sid="EXO 36:4" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಗುಡಿಚಿ ಕಾಮ್ ಕರುಲಾಗಲ್ಲ್ಯಾ ಸಗ್ಳ್ಯಾ ಬುದ್ವಂತಾನಿ ಅಪ್ನಾಚಿ ಕಾಮಾ ಸೊಡುನ್, <verse eid="EXO 36:4" /><verse number="5" style="v" sid="EXO 36:5" />ಮೊಯ್ಜೆಕ್ಡೆ ಯೆವ್ನ್, ತೆಕಾ ಸರ್ವೆಸ್ಪರಾನ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಕಾಮಾಕ್ ಪಾಜೆ ಹೊಲ್ಲ್ಯಾಕಿಂತಾಬಿ ಲೈ ಕಾನಿಕಾ ಲೊಕಾ ಹಾನುಲಾತ್,<verse eid="EXO 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 36:6" />ಮನ್ತಾನಾ ಮೊಯ್ಜೆನ್, ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಕಾಮಾಚ್ಯಾ ಸಾಟ್ನಿ ಖಲ್ಯಾಬಿ ಘವ್ಮಾನ್ಸಾನ್ ನಾತರ್ ಬಾಯ್ಕೊಮಾನ್ಸಿನ್ ಹೆಚ್ಯಾನ್ ಫಿಡೆ ಕಾಯ್ಬಿ ತಯಾರ್ ಕರ್‍ತಲೆ ನಕ್ಕೊ, ಮನುನ್ ಹುಕುಮ್ ದಿವ್ನ್, ಕಾನಿಕ್ ಹಾನ್ತಲೆ ಇಬೆ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 36:6" /><verse number="7" style="v" sid="EXO 36:7" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ಕಾಮಾಕ್ ಪಾಜೆ ಹೊಲ್ಲ್ಯಾಕಿಂತಾಬಿ ಜಾಸ್ತಿಚೆ ಸಾಮಾನ್ ಹೊತ್ತೆ.<verse eid="EXO 36:7" /></para>
  <para style="s">ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಗುಡಿ ತಯಾರ್ ಕರ್‍ತಲೆ</para>
  <para style="r">
    <ref loc="EXO 26:1-37">26:1-37</ref></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8" />ತ್ಯಾ ಕಾಮಾಕ್ ಹೊತ್ತ್ಯಾ ಬುದ್ವಂತಾನಿ ಧಾ ಪರ್ದೆ ಪುಂಡಿಚ್ಯಾ ದೊರ್ಯಾಚ್ಯಾ ಕಪ್ಡ್ಯಾನಿ ಬಿಡಾರ್ ಕರುನ್, ತ್ಯಾ ಕಪ್ಡ್ಯಾಕ್ನಿ ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ ಚಮತ್ಕಾರಾಚಿ ಕೆರುಬಿಯಾ ಹಾತಿಚ್ಯಾ ಕಾಮಾನ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:8" /><verse number="9" style="v" sid="EXO 36:9" />ಹರ್ ಎಕ್ ಕಪ್ಡೆಬಿ ವಿಸಾರ್ ಆಟ್ ಹಾತ್ ಲಾಂಬಿ, ಚಾರ್ ಹಾತ್ ರುಂದಿ ಹೊತ್ತೆ, ಸಗ್ಳೆ ಪರ್ದೆಬಿ ಎಕುಚ್ ಮಾಪಾಚೆ ಹೊತ್ತೆ. <verse eid="EXO 36:9" /><verse number="10" style="v" sid="EXO 36:10" />ಪಾಚ್ ಕಪ್ಡೆ ಎಕಾಮೆಕಾಕ್ ಜೊಡಸ್ಲ್ಯಾನಿ. <verse eid="EXO 36:10" /><verse number="11" style="v" sid="EXO 36:11" />ಹ್ಯಾ ದೊನಿ ಕಡೆ ಜೊಡಸ್ತಾನಾಬಿ ಹರ್ ಎಕಾಚ್ಯಾ ತುದಿಕ್ ಕಪ್ಡ್ಯಾಚ್ಯಾ ಮುಲ್ಲ್ಯಾಕ್ ಝಾಂಬ್ಳ್ಯಾ ದೊರ್ಯಾಚೊ ನಾಡೊ ಲಾವ್ಲ್ಯಾನಿ. <verse eid="EXO 36:11" /><verse number="12" style="v" sid="EXO 36:12" />ತೆ ದೊರೆ ಹರ್ ಎಕಾಕ್ ಪನ್ನಾಪನ್ನಾಸ್ ಹೊಯ್ ಸಾರ್ಕೆ ಅನಿ ಎಕಾಚ್ಯಾ ಇದ್ರಾಕ್ ಥವ್ಲ್ಯಾನಿ. <verse eid="EXO 36:12" /><verse number="13" style="v" sid="EXO 36:13" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ ಪನ್ನಾಸ್ ಸೊನ್ಯಾಚಿ ಕೊಂಡಿಯಾ ಕರುನ್ ತೆ ಪರ್ದೆ ಎಕಾಕ್ ಅನಿ ಎಕ್ ಜೊಡ್ಲ್ಯಾನಿ ಅಸೆ ಎಕುಚ್ ಗುಡಿ ಹೊಲಿ.<verse eid="EXO 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 36:14" />ಹ್ಯಾ ಗುಡಿ ವರ್‍ತಿ ಕಾಂಬ್ರುಕ್ ಸಾಟ್ನಿ ಶೆಳಿಯಾಂಚ್ಯಾ ಕೆಸಾಂಚೆ ಆಕ್ರಾ ಕಪ್ಡ್ಯಾಚೆ ಪರ್ದೆ ಕರುನ್ ಬಿಡಾರಾಚ್ಯಾ ವರ್‍ತಿ ಧಾಪ್ಲ್ಯಾನಿ. <verse eid="EXO 36:14" /><verse number="15" style="v" sid="EXO 36:15" />ಹರ್ ಎಕ್ ಪರ್ದೊಬಿ ತಿಸ್ ಹಾತ್ ಲಾಂಬಿ ಅನಿ ಚಾರ್ ಹಾತ್ ರುಂದಿ ಹೊತ್ತೆ, ಸಗ್ಳೆ ಪರ್ದೆಬಿ ಎಕುಚ್ ಮಾಪಾಚೆ ಹೊವ್ನ್ ಹೊತ್ತೆ. <verse eid="EXO 36:15" /><verse number="16" style="v" sid="EXO 36:16" />ಪಾಂಚ್ ಪರ್ದ್ಯಾಕ್ನಿ ಎಕಾಕ್ಡೆ ಜೊಡ್ಸುನ್ ಹುರಲ್ಲ್ಯಾ ಸಾ ಪರ್ದ್ಯಾತ್ನಿ ಅನಿ ಎಕಾಕ್ಡೆ ಜೊಡಸ್ಲ್ಯಾನಿ. <verse eid="EXO 36:16" /><verse number="17" style="v" sid="EXO 36:17" />ಹರ್ ಎಕ್ ಕಪ್ಡ್ಯಾಚ್ಯಾ ಮುಲ್ಲ್ಯಾತ್ ಪನ್ನಾ ಪನ್ನಾಸ್ ನಾಡೆ ಕರ್ಲ್ಯಾನಿ, <verse eid="EXO 36:17" /><verse number="18" style="v" sid="EXO 36:18" />ಎಕುಚ್ ಗುಡಿಕ್ ಮಿಳು ಸಾಟ್ನಿ ಪನ್ನಾಸ್ ತಾಂಬ್ಯಾಚಿ ಕೊಂಡಿಯಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:18" /><verse number="19" style="v" sid="EXO 36:19" />ತವ್ಡೆ ನಸ್ತಾನಾ, ಹದಾಕ್ ಹಾನಲ್ಲೆ ಬಕ್ರ್ಯಾಚೆ ಚಮ್ಡ್ಯಾನ್ ಎಕ್ ಕಾಂಬ್ರಾನ್ ಅನಿ ಸಮುಂದ್ರಾಚ್ಯಾ ದಂಡೆಚ್ಯಾ ಡುಕ್ರಾಚ್ಯಾ ಚಮ್ಡ್ಯಾನ್ ಅನಿ ಎಕ್ ವೈಲೆ ಕಾಂಬ್ರಾನ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:19" /><verse number="20" style="v" sid="EXO 36:20" />ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಬಿಡಾರಾಕ್ ಚವ್ಕಟಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:20" /><verse number="21" style="v" sid="EXO 36:21" />ಹರ್ ಎಕ್ ಚವ್ಕಟ್ ಬಿ ಧಾ ಹಾತ್ ಲಾಂಬಿ, ಅನಿ ಸಾಡೆ ಎಕ್ ಹಾತ್ ರುಂದಿ ಹೊತ್ತೆ. <verse eid="EXO 36:21" /><verse number="22" style="v" sid="EXO 36:22" />ಹರ್ ಎಕ್ ಚವ್ಕಟ್ಬಿ ಅಡ್ವ್ಯಾ ಪಟ್ಟಿಯಾನಿ ಜೊಡಸಲ್ಲ್ಯಾ ದೊನ್ ಇಬೆ ಪಟ್ಟಿಯಾನಿ ಹೊಲ್ಲಿ ಹೊತ್ತೆ, ಬಿಡಾರಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಚವ್ಕಟಾಕ್ನಿಬಿ ತಸೆಚ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:22" /><verse number="23" style="v" sid="EXO 36:23" />ಬಿಡಾರಾಚ್ಯಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ವಿಸ್ ಚವ್ಕಟಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:23" /><verse number="24" style="v" sid="EXO 36:24" />ಚಾಳಿಸ್ ಚಾದಿಂಚೆ ಪಾಯಾಚೆ ಗುಂಡೆ ಕರುನ್, ತ್ಯಾ ವಿಸ್ ಚವ್ಕಟಾಂಚ್ಯಾ ಖಾಲ್ತಿ ಥವ್ಲ್ಯಾನಿ, ಹರ್ ಎಕ್ ಚವ್ಕಟಾಚ್ಯಾ ದೊನಿ ಇಬ್ಯಾ ಪಟ್ಟಿಯಾಂಚ್ಯಾ ಖಾಲ್ತಿ ಎಕೆಕ್ ಪಾಯಾಚೊ ಗುಂಡೊ ಥವ್ಲ್ಯಾನಿ. <verse eid="EXO 36:24" /><verse number="25" style="v" sid="EXO 36:25" />ತಸೆಚ್ ಬಿಡಾರಾಚ್ಯಾ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ ವಿಸ್ ಚವ್ಕಟಾ, <verse eid="EXO 36:25" /><verse number="26" style="v" sid="EXO 36:26" />ಅನಿ ಹರ್ ಎಕ್ ಚವ್ಕಟಾಕ್ ದೊದೊನ್ ಪಾಯಾಚೆ ಗುಂಡೆ ಹೊಯ್ ಸಾರ್ಕೆ, ಚಾಳಿಸ್ ಪಾಯಾಚೆ ಗುಂಡೆ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:26" /><verse number="27" style="v" sid="EXO 36:27" />ಬಿಡಾರಾಚ್ಯಾ ಫಾಟಿಕ್ಡೆ ಮಟ್ಲ್ಯಾರ್, ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಸಾ ಚವ್ಕಟಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:27" /><verse number="28" style="v" sid="EXO 36:28" />ಬಿಡಾರಾಚ್ಯಾ ಫಾಟ್ಲ್ಯಾ ದೊನ್ ಮುಲ್ಲ್ಯಾಕ್ನಿ ಅನಿ ದೊನ್ ಚವ್ಕಟಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:28" /><verse number="29" style="v" sid="EXO 36:29" />ತೆ ಬುಡ್ನಾ ತುದಿ ಪತರ್ ಮಟ್ಲ್ಯಾರ್, ಪೈಲೆಚ್ಯಾ ಕಾಕ್ನಾ ಪಾತರ್ ಬಿ ಜೊಡಸಲ್ಲೆ ಹೊತ್ತೆ, ದೊನಿ ಮುಲ್ಲ್ಯಾಕ್ನಿಬಿ ಅಸೆಚ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:29" /><verse number="30" style="v" sid="EXO 36:30" />ಅಶೆ ಆಟ್ ಚವ್ಕಟಾ ಅನಿ ಹರ್ ಎಕ್ ಚವ್ಕಟಾಕ್ ದೊದೊನ್ ಚಾಂದಿಚಿ ಪಾಯಚೆ ಗುಂಡೆ ಸಗ್ಳೆ ಮಿಳುನ್ ಸೊಳಾ ಗುಂಡೆ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:30" /><verse number="31" style="v" sid="EXO 36:31" />ಜಾಲಿಚ್ಯಾ ಝಾಡಾನಿ ಅಗ್ಳಿಯಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:31" /><verse number="32" style="v" sid="EXO 36:32" />ಬಿಡಾರಾಚ್ಯಾ ದೊನಿ ಬಾಜುಚ್ಯಾ ಚವ್ಕಟಾಕ್ನಿ ಅನಿ ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಚ್ಯಾ ಚವ್ಕಟಾಕ್ನಿ ಪಾಂಚ್ ಪಾಂಚ್ ಅಗ್ಳಿಯಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:32" /><verse number="33" style="v" sid="EXO 36:33" />ಚವ್ಕಟಾಚ್ಯಾ ಮದ್ದಿ ಹೊತ್ತಿ ಅಗ್ಳಿಯಾ ಎಕ್ ತುದಿಕ್ನಾ ಅನಿ ಎಕ್ ತುದಿ ಪಾತರ್ ಪಾವಿ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:33" /><verse number="34" style="v" sid="EXO 36:34" />ಚವ್ಕಟಾಕ್ನಿ ಸೊನ್ಯಾಚಿ ತಗ್ಡಾ ಮಾರುನ್, ತೆಜ್ಯಾನಿ ಅಗ್ಳಿಯಾಕ್ನಿ ಸೊನ್ಯಾಚಿ ಕಾಕ್ನಾ ಕರ್ಲ್ಯಾನಿ, ಅನಿ ಪಟ್ಟಿಯಾಕ್ನಿ ಸೊನ್ಯಾಚಿ ತಗ್ಡಾ ಮಾರ್ಲ್ಯಾನಿ.<verse eid="EXO 36:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35" />ಪುಂಡಿಚ್ಯಾ ದೊರ್ಯಾಚ್ಯಾ ಕಪ್ಡ್ಯಾನ್ ಅನಿ ಝಾಂಬ್ಳ್ಯಾ ರಕ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ಶೆಳಿಚ್ಯಾ ಕಪ್ಡ್ಯಾಚ್ಯಾ ದೊರ್ಯಾನ್, ಸುಂದರ್ ಕೆರುಬಿಯಾ ಹಾತಿಚ್ಯಾ ಕಾಮಾನಿ ಕರುನ್ ಎಕ್ ಪರ್ದೊ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 36:35" /><verse number="36" style="v" sid="EXO 36:36" />ತೆಕಾ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಚಾರ್ ಖಾಂಬೆ ಕರುನ್ ಸೊನ್ಯಾಚಿ ತಗ್ಡಾ ಮಾರ್ಲ್ಯಾನಿ, ಅನಿ ತೆಂಕಾ ಸೊನ್ಯಾಚಿ ಕೊಂಡಿಯಾ ಕರುನ್ ಚಾಂದಿಚೆ ಪಾಯಾಚೆ ಗುಂಡೆ ಥವ್ಲ್ಯಾನಿ. <verse eid="EXO 36:36" /><verse number="37" style="v" sid="EXO 36:37" />ಬಿಡಾರಾಚ್ಯಾ ದಾರಾತ್ ಝಾಂಬ್ಳ್ಯಾ ರಕ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ ಚಮತ್ಕಾರಾಚಿ ಹಾತಿಚಿ ಕಾಮಾ ಕರುನ್ ಪರ್ದೊ ಘಾಟ್ಲ್ಯಾನಿ. <verse eid="EXO 36:37" /><verse number="38" style="v" sid="EXO 36:38" />ತೊ ಪರ್ದೊ ಸರ್ಕುಕ್ ಸಾಟ್ನಿ ಪಾಂಚ್ ಖಾಂಬೆ ಕರುನ್, ತೆಕಾ ಕೊಂಡಿಯಾ ಕರುನ್ ಖಾಂಬ್ಯಾಕ್ನಿ ಅನಿ ತೆಚ್ಯಾ ಕಟ್ನಾಕ್ನಿ ಸೊನ್ಯಾಚಿ ತಗ್ಡಾ ಮಾರ್ಲ್ಯಾನಿ, ಅನಿ ತೆಚೆ ಪಾಂಚ್ ಪಾಯಾಚೆ ಗುಂಡೆ ತಾಂಬ್ಯಾನಿ ಕರ್ಲ್ಯಾನಿ.<verse eid="EXO 36:38" /></para>
  <chapter eid="EXO 36" />
  <chapter number="37" style="c" sid="EXO 37" />
  <para style="s">ಕರಾರಾಚಿ ಪೆಟಿ ತಯಾರ್ ಕರ್‍ತಲೆ</para>
  <para style="r">
    <ref loc="EXO 25:10-22">25:10-22</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1" />ಬೆಚೆಲಾನ್ ಜಾಲಿಚ್ಯಾ ನಾಕ್ಡಾನ್ ಕರಾರಾಚಿ ಪೆಟ್ ಕರ್ಲ್ಯಾನ್, ತೆ ಸಾಡೆ ದೊನ್ ಹಾತ್ ಲಾಂಬಿ ಸಾಡೆ ಎಕ್ ಹಾತ್ ರುಂದ್ ಅನಿ ಸಾಡೆ ಎಕ್ ಹಾತ್ ಉಪ್ಪರ್ ಹೊತ್ತೆ. <verse eid="EXO 37:1" /><verse number="2" style="v" sid="EXO 37:2" />ತೆಕಾ ಶುದ್ದ್ ಸೊನ್ಯಾಚಿ ತಗ್ಡಾ ಭಾಯ್ರ್ ಅನಿ ಭಿತ್ತುರ್ ಮಾರ್ಲ್ಯಾನಿ, ತೆಚ್ಯಾ ಭೊತ್ಯಾನಿ ಸೊನ್ಯಾಚೆ ಮುಕುಟ್ ಭಾಂದಸ್ಲ್ಯಾನಿ. <verse eid="EXO 37:2" /><verse number="3" style="v" sid="EXO 37:3" />ಚಾರ್ ಸೊನ್ಯಾಚಿ ಕಾಕ್ನಾ ಕರುನ್, ತೆಚ್ಯಾ ಚಾರಿ ಮುಲ್ಯಾಕ್ನಿ ಎಕೆಕ್ ಭಾಜುನ್ ದೊ ದೊನ್ ಕಾಕ್ನಾ ಥವ್ಲ್ಯಾನಿ. <verse eid="EXO 37:3" /><verse number="4" style="v" sid="EXO 37:4" />ಅನಿ ಜಾಲಿಚ್ಯಾ ಝಾಡಾಚೆ ದಾಂಡೆ ಕರುನ್, ತೆಕಾ ಸೊನ್ಯಾಚಿ ತಗ್ಡಾ ಮಾರುನ್, <verse eid="EXO 37:4" /><verse number="5" style="v" sid="EXO 37:5" />ಕರಾರಾಚಿ ಪೆಟಿ ಉಕ್ಲುಕ್ ಸಾಟ್ನಿ ತೆಚ್ಯಾ ದೊನಿ ಕಡೆ ಹೊತ್ತ್ಯಾ ಕಾಕಾತ್ನಿ ಘಾಟ್ಲ್ಯಾನಿ. <verse eid="EXO 37:5" /><verse number="6" style="v" sid="EXO 37:6" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಶುದ್ದ್ ಸೊನ್ಯಾನ್ ಕ್ರಪಾಸನ್ ಕರ್ಲ್ಯಾನ್, ತೆ ಸಾಡೆ ದೊನ್ ಹಾತ್ ಲಾಂಬಿ, ಸಾಡೆ ಎಕ್ ಹಾತ್ ರುಂದಿ ಹೊತ್ತೆ. <verse eid="EXO 37:6" /><verse number="7" style="v" sid="EXO 37:7" />ಕ್ರಪಾಸನಾಚಿ ದೊನಿ ತುದಿಯಾಕ್ನಿ ಸೊನ್ಯಾಚಿ ದೊನ್ ಕೆರುಬಿಯಾಂಚಿ ಆಕಾರಾ ನಕಾಸಿಚ್ಯಾ ಕಾಮಾನ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 37:7" /><verse number="8" style="v" sid="EXO 37:8" />ಕ್ರಪಾಸನಾಚ್ಯಾ ಎಕೆಕ್ ತುದಿಕ್ ಎಕೆಕ್ ಕೆರುಬಿ ಕರುನ್ ಜೊಡಸ್ಲ್ಯಾನಿ. <verse eid="EXO 37:8" /><verse number="9" style="v" sid="EXO 37:9" />ತಿ ಕೆರುಬಿಯಾ ಫಾಕುಟೆ ವರ್‍ತಿ ಪಗಳಲ್ಲೆ ಅನಿ ಕ್ರಪಾಸನ್ ಅಪ್ನಾಚ್ಯಾ ಫಾಕುಟ್ಯಾನಿ ಧಾಪಿ ಸಾರ್ಕೆ ಹೊತ್ತೆ, ತೆಂಚಿ ತೊಂಡಾ ಇದ್ರಾಬದ್ರಾಕ್ ರಾವ್ನ್ ಕರ್ಪಾಸನಾಕ್ ಬಗುಲಾಗಲ್ಲಿ.<verse eid="EXO 37:9" /></para>
  <para style="s">ಸರ್ವೆಸ್ಪರಾಕ್ ಬಾರಿಕ್ಲಿ ಭೆಟ್ವುಕ್ ಮಾಚೊ ತಯಾರ್ ಕರ್‍ತಲೆ</para>
  <para style="r">
    <ref loc="EXO 25:23-30">25:23-30</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10" />ಅನಿ ತೆನಿ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಮಾಚೊ ಕರ್ಲ್ಯಾನ್, ತೊ ದೊನ್ ಹಾತ್ ಲಾಂಬಿ, ಎಕ್ ಹಾತ್ ರುಂದಿ ಅನಿ ಸಾಡೆ ಎಕ್ ಹಾತ್ ಉಪ್ಪರ್ ಹೊತ್ತೊ. <verse eid="EXO 37:10" /><verse number="11" style="v" sid="EXO 37:11" />ತೆಕಾ ಶುದ್ದ್ ಸೊನ್ಯಾಚಿ ತಗ್ಡಾ ಮಾರುನ್, ಭೊತ್ಯಾನಿ ಸೊನ್ಯಾಚಿ ಮುಕುಟಾ ಭಾಂದ್ಲ್ಯಾನ್. <verse eid="EXO 37:11" /><verse number="12" style="v" sid="EXO 37:12" />ಮಾಚ್ಯಾಚ್ಯಾ ಭೊತ್ಯಾನ್ ಅರ್ದೊ ಹಾತ್ ರುಂದ್ ಅಡ್ವಿ ಪಟ್ಟಿ ಕರುನ್ ತೆಕಾಬಿ ಸೊನಾಚೊ ಮುಕುಟ್ ಭಾಂದ್ಲ್ಯಾನ್, <verse eid="EXO 37:12" /><verse number="13" style="v" sid="EXO 37:13" />ಮಾಚ್ಯಾಕ್ ಉಕಲ್ತಲೆ ದಾಂಡೆ ಮಿಳ್ವುಕ್ ಸಾಟ್ನಿ, ತೆಕಾ ಚಾರ್ ಸೊನ್ಯಾಚಿ ಕಾಕ್ನಾ ಕರ್ಸುನ್, ತೆಚ್ಯಾ ಚಾರಿ ಪಾಯಾಕ್ನಿಬಿ ಲಾವ್ಲ್ಯಾನ್. <verse eid="EXO 37:13" /><verse number="14" style="v" sid="EXO 37:14" />ತಿ ಕಾಕ್ನಾ ಅಡ್ವ್ಯಾ ಪಟ್ಟಿಕ್ ಲಾಗಲ್ಲಿ ಹೊತ್ತಿ. <verse eid="EXO 37:14" /><verse number="15" style="v" sid="EXO 37:15" />ಮಾಚೊ ಉಕ್ಲುಕ್ ಜಾಲಿಚ್ಯಾ ಝಾಡಾಚೆ ದಾಂಡೆ ಕರುನ್, ತೆಂಕಾ ಸೊನ್ಯಾಚಿ ತಗ್ಡಾ ಮಾರ್‍ಲ್ಯಾನ್. <verse eid="EXO 37:15" /><verse number="16" style="v" sid="EXO 37:16" />ಮಾಚ್ಯಾ ವರ್‍ತಿ ಥವ್ತಲಿ ಸಾಮಾನಾ ಮಟ್ಲ್ಯಾರ್, ಮೊಟಿ ಆಯ್ದಾನಾ, ಧುಪಾಚಿ ಆರತ್, ಹುಜಿಯಾ, ವಾಯ್ನಾ ಭೆಟುಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ಆಯ್ದಾನಾ, ಹೆ ಸಗ್ಳೆ ಶುದ್ದ್ ಸೊನ್ಯಾನಿ ಕರ್ಲ್ಯಾನ್.<verse eid="EXO 37:16" /></para>
  <para style="s">ದಿವ್ಯಾಚೊ ಖಾಂಬೊ ತಯಾರ್ ಕರ್‍ತಲೆ</para>
  <para style="r">
    <ref loc="EXO 25:31-40">25:31-40</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17" />ಶುದ್ದ್ ಸೊನ್ಯಾಚೊ ದಿವ್ಯಾಚೊ ಖಾಂಬೊ ಕರ್ಲ್ಯಾನಿ, ಅನಿ ತೆಚೊ ಮುಳ್ ಅನಿ ಖಾಂಬೊ ನಕಾಸಾಚ್ಯಾ ಕಾಮಾನ್ ಕರ್ಲ್ಯಾನ್, ತ್ಯಾ ದಿವ್ಯಾಚ್ಯಾ ಖಾಂಬ್ಯಾರ್ ಫುಲ್ಲ್ಯಾಚ್ಯಾ ಆಯ್ದಾನಾಚ್ಯಾ ಸಾರ್ಕೆ ಅನಿ ಫುಲ್ಲಾಂಚ್ಯಾ ಸಾರ್ಕೆ ಶಿಂಗಾರ್ ಹೊತ್ತೆ. <verse eid="EXO 37:17" /><verse number="18" style="v" sid="EXO 37:18" />ಖಾಂಬ್ಯಾಚ್ಯಾ ಎಕೆಕ್ ಬಾಜುಕ್ ತಿತಿನ್ ಟಾಂಕಿಯಾ ಸಗ್ಳಿ ಮಿಳುನ್ ಸಾ ಟಾಂಕಿಯಾ ಹೊತ್ತಿ. <verse eid="EXO 37:18" /><verse number="19" style="v" sid="EXO 37:19" />ಹರ್ ಎಕ್ ಟಾಂಕಿಕ್ ಬಾದಾಮಿಚ್ಯಾ ಫುಲ್ಲಾ ಸಾರ್ಕೆ ತಿತಿನ್ ಫುಲ್ಲಾಂಚೊ ಶಿಂಗಾರ್ ಹೊತ್ತೆ, ಎಕೆಕ್ ಶಿಂಗಾರಾಕ್ ಎಕ್ ಫುಲ್ಲಾಚೆ ಆಯ್ದಾನ್ ಅನಿ ಫುಲ್ಲಾ ಹೊತ್ತಿ, ಸಾ ಟಾಂಕಿಯಾಬಿ ತಸೆಚ್ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 37:19" /><verse number="20" style="v" sid="EXO 37:20" />ದಿವ್ಯಾಚ್ಯಾ ಖಾಂಬ್ಯಾಚ್ಯಾ ಟಾಂಕಿಕ್ ಫುಲ್ಲಾಚಿ ಆಯ್ದಾನಾ ಅನಿ ಫುಲ್ಲಾಚೆ ಮೊಗ್ಗೆ ಹೊತ್ತೆ, ಬಾದಾಮಿ ಫುಲ್ಲಾ ಸಾರ್ಕೆ ಚಾರ್ ಫುಲ್ಲಾಚಿ ಶಿಂಗಾರ್ ಹೊತ್ತಿ. <verse eid="EXO 37:20" /><verse number="21" style="v" sid="EXO 37:21" />ದೊದೊನ್ ಟಾಂಕಿಯಾ ಫಾಟೆ ಫುಟಲ್ಲ್ಯಾ ಜಾಗ್ಯಾನಿ, ಎಕೆಕ್ ಫುಲ್ಲಾಚೆ ಆಯ್ದಾನ್ ಹೊತ್ತೆ. <verse eid="EXO 37:21" /><verse number="22" style="v" sid="EXO 37:22" />ಫುಲ್ಲಾಚ್ಯಾ ಆಯ್ದಾನಾನಿ ಅನಿ ಟಾಂಕಿಯಾ ಹೊತ್ತೊ ದಿವ್ಯಾಚೊ ಖಾಂಬೊ ಶುದ್ದ್ ಸೊನ್ಯಾನ್ ಅನಿ ನಕಾಸಿಚ್ಯಾ ಕಾಮಾನ್ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 37:22" /><verse number="23" style="v" sid="EXO 37:23" />ತೆಚೆ ಸಾತ್ ದಿವೆ ಅನಿ ತೆಕಾ ಕಾರ್ತಲೆ ಅನಿ ದಿವ್ಯಾಚೆ ಕುಡಿ ಕಾಡ್ತಲೆ ಆಯ್ದಾನ್ ಶುದ್ದ್ ಸೊನ್ಯಾನ್ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 37:23" /><verse number="24" style="v" sid="EXO 37:24" />ದಿವ್ಯಾಚೊ ಖಾಂಬೊ ಅನಿ ತೆಚಿ ಸಾಮಾನಾ ತಿಸಾರ್ ಚಾರ್ ಕಿಲೊ ಶುದ್ದ್ ಸೊನ್ಯಾಚಿ ಹೊತ್ತಿ.<verse eid="EXO 37:24" /></para>
  <para style="s">ಧುಪ್ ಜಾಳ್ವುಕ್ ಧುಪಾಚೊ ಕಟ್ಟೊ ತಯಾರ್ ಕರ್‍ತಲೆ</para>
  <para style="r">
    <ref loc="EXO 30:1-5">30:1-5</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25" />ತೆನಿ ಹಾತ್ ಎಕ್ ಲಾಂಬಿ ಅನಿ ಎಕ್ ಹಾತ್ ರುಂದಿ ಚಾರಿ ಮುಲ್ಲ್ಯಾನಿ ಚವ್ಕ್ ಅನಿ ದೊನ್ ಹಾತ್ ಉಪ್ಪರ್ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಧುಪ್ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 37:25" /><verse number="26" style="v" sid="EXO 37:26" />ತೆಚಿ ಶಿಂಗಾ ತೆಚ್ಯಾ ವಾಂಗ್ಡಾ ಮಿಳುನ್ ಹೊತ್ತಿ, ತೆಚ್ಯಾ ಚಾರಿ ಮುಲ್ಲ್ಯಾಕ್ನಿಬಿ ಅನಿ ಶಿಂಗಾಕ್ನಿಬಿ ಶುದ್ದ್ ಸೊನ್ಯಾಚಿ ತಗ್ಡಾ ಮಾರ್‍ಲ್ಯಾನ್, ಅನಿ ಭೊತ್ಯಾನ್ ಸೊನ್ಯಾಚಿ ತೊರ್ನಾ ಸಾರ್ಕೆ ಶಿಂಗಾರ್ ಭಾಂದಸ್ಲ್ಯಾನ್. <verse eid="EXO 37:26" /><verse number="27" style="v" sid="EXO 37:27" />ತೆ ಉಕಲ್ತಲೆ ದಾಂಡೆ ಮಿಳ್ವುಕ್ ಸಾಟ್ನಿ, ತೆಜ್ಯಾ ಖಾಲ್ತಿ ಕಟ್ಟ್ಯಾಚ್ಯಾ ದೊನಿ ಭಾಜುಚ್ಯಾ ಮುಲ್ಲ್ಯಾಕ್ನಿ ದೊದೊನ್ ಸೊನ್ಯಾಚಿ ಕಾಕ್ನಾ ಭಾಂದ್ಲ್ಯಾನ್. <verse eid="EXO 37:27" /><verse number="28" style="v" sid="EXO 37:28" />ಕಟ್ಟೊ ಉಕ್ಲುಕ್ ಜಾಲಿಚ್ಯಾ ಝಾಡಾಚೆ ದಾಂಡೆ ಕರುನ್, ತೆಂಕಾ ಸೊನ್ಯಾಚಿ ತಗ್ಡಾ ಮಾರ್‍ಲ್ಯಾನ್.<verse eid="EXO 37:28" /></para>
  <para style="s">ಅಭಿಶೆಕಾಚೆ ತೆಲ್ ಅನಿ ಧುಪ್ ತಯಾರ್ ಕರ್‍ತಲೆ</para>
  <para style="r">
    <ref loc="EXO 30:22-38">30:22-38</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ತೆನಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಸೆವಾಕ್ ನೆಮಲ್ಲ್ಯಾ ಅಭಿಶೆಕಾಚೆ ತೆಲ್ ಅನಿ ಬರ್ಯಾ ವಾಸೆಚ್ಯಾ ಪಾನಿಯಾನಿ ಕರಲ್ಲೆ ಶುದ್ದ್ ಧುಪಾಚೆ ಪಾನಿ, ಬರ್ಯಾ ವಾಸೆಚೆ ಪಾನಿ ತಯಾರ್ ಕರ್‍ತಲ್ಯಾಂಚ್ಯಾ ಶಿಕಾಪಾ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್.<verse eid="EXO 37:29" /></para>
  <chapter eid="EXO 37" />
  <chapter number="38" style="c" sid="EXO 38" />
  <para style="s">ಜಾಳ್ವುತಲಿ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ತಯಾರ್ ಕರ್‍ತಲೆ</para>
  <para style="r">
    <ref loc="EXO 27:1-8">27:1-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1" />ತೆನಿ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಜಾಲಿಚ್ಯಾ ಝಾಡಾನ್ ಕರ್ಲ್ಯಾನ್, ತೆ ಪಾಂಚ್ ಹಾತ್ ಲಾಂಬ್, ಪಾಂಚ್ ಹಾತ್ ರುಂದ್ ಅನಿ ಚವ್ಕ್ ಹೊತ್ತೆ, ಅನಿ ತೆ ತಿನ್ ಹಾತ್ ಉಪ್ಪರ್ ಹೊತ್ತೆ. <verse eid="EXO 38:1" /><verse number="2" style="v" sid="EXO 38:2" />ತೆಜ್ಯಾ ಚಾರಿ ಮುಲ್ಲ್ಯಾಕ್ನಿ ಸಿಂಗಾ ಕರಸ್ಲ್ಯಾನ್, ತೆ ಬಲಿಚ್ಯಾ ಕಟ್ಟ್ಯಾಕ್ ಲಾಗುನ್ ಹೊತ್ತೆ, ತ್ಯಾ ಕಟ್ಟ್ಯಾಕ್ ತಾಂಬ್ಯಾಚಿ ತಗ್ಡಾ ಕಾಂಬರ್ಲ್ಯಾನ್. <verse eid="EXO 38:2" /><verse number="3" style="v" sid="EXO 38:3" />ಕಟ್ಟ್ಯಾಚಿ ಸಾಮಾನಾ ಮಟ್ಲ್ಯಾರ್, ವಾಟ್ಲಿಯಾ, ಸಲ್ಕಿಯಾ, ಟೊಪಾ, ಕಾಟೆ ಅನಿ ಆಗಿಪೆಟಿಯಾ ಹೆ ಸಗ್ಳೆ ತಾಂಬ್ಯಾನ್ ಕರಸ್ಲ್ಯಾನ್. <verse eid="EXO 38:3" /><verse number="4" style="v" sid="EXO 38:4" />ಕಟ್ಟ್ಯಾಕ್ ಎನ್ತಲ್ಯಾ ಕಾಮಾನಿ ತಾಂಬ್ಯಾಚಿ ಚಾಳನ್ ಕರಸ್ಲ್ಯಾನ್, ತೆ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಭೊತ್ಯಾನಿ ಹೊತ್ತ್ಯಾ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಖಾಲ್ತಿ ತೆಜ್ಯಾ ಬುಡ್ನಾ ಮದ್ದಿ ಪತರ್ ರಾಯ್ ಸಾರ್ಕೆ ಘಾಟ್ಲ್ಯಾನ್. <verse eid="EXO 38:4" /><verse number="5" style="v" sid="EXO 38:5" />ದಾಂಡೆ ಘಾಲುಕ್ ಚಾರ್ ಕಾಕ್ನಾ ಕರ್ಲ್ಯಾನ್, ಅನಿ ತಿ ತಾಂಬ್ಯಾಚ್ಯಾ ಚಾಳ್ನಿಚ್ಯಾ ಚಾರಿ ಮುಲ್ಲ್ಯಾಕ್ನಿ ಬಸ್ವುಲ್ಯಾನ್. <verse eid="EXO 38:5" /><verse number="6" style="v" sid="EXO 38:6" />ಜಾಲಿಚ್ಯಾ ಝಾಡಾಚೆ ದಾಂಡೆ ಕರುನ್ ತೆಕಾ ತಾಂಬ್ಯಾಚಿ ತಗ್ಡಾ ಮಾರ್‍ಲ್ಯಾನ್. <verse eid="EXO 38:6" /><verse number="7" style="v" sid="EXO 38:7" />ಬಲಿಚೊ ಕಟ್ಟೊ ಉಕ್ಲುನ್ ನ್ಹೆವ್ಕ್ ಸಾಟ್ನಿ ತೆ ದಾಂಡೆ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಕಾಕ್ನಾತ್ನಿ ಘಾಟ್ಲ್ಯಾನ್, ಅನಿ ತೊ ಕಟ್ಟೊ ಫಳಿಯಾ ಘೆವ್ನ್ ಪೆಟಿ ಗತಿನ್ ಕರ್ಲ್ಯಾನ್.<verse eid="EXO 38:7" /></para>
  <para style="s">ತಾಂಬ್ಯಾಚಿ ಮೊಟಿ ವಾಟ್ಲಿ ತಯಾರ್ ಕರ್‍ತಲೆ</para>
  <para style="r">
    <ref loc="EXO 30:18">30:18</ref></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8" />ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಚ್ಯಾ ಇದ್ರಾಕ್ ಸೆವಾ ಕರ್‍ತಲ್ಯಾ ಬಾಯ್ಕೊ ಮಾನ್ಸಿಯಾನಿ ದಿಲ್ಲ್ಯಾ ತಾಂಬ್ಯಾಚ್ಯಾ ಆರ್ಸ್ಯಾನಿ ಮೊಟೆ ಆಯ್ದಾನ್ ಅನಿ ತೆಜೊ ಕಟ್ಟೊ ಕರ್ಲ್ಯಾನ್.<verse eid="EXO 38:8" /></para>
  <para style="s">ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಬಿಡಾರಾಚೆ ಆವರನ್</para>
  <para style="r">
    <ref loc="EXO 27:9-19">27:9-19</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9" />ತೆನಿ ಎಕ್ ಆವರನ್ ಕರ್ಲ್ಯಾನ್, ದಾರಾಚ್ಯಾ ದಕ್ಷಿನ್ ದಿಕ್ಕಾಕ್ ಪುಂಡಿಚ್ಯಾ ದೊರ್ಯಾಚೆ ಪರ್ದೆ ಕರ್ಲ್ಯಾನ್, ತೆ ಸೆಂಬರ್ ಹಾತ್ ಲಾಂಬ್ ಹೊತ್ತೆ. <verse eid="EXO 38:9" /><verse number="10" style="v" sid="EXO 38:10" />ತೆನಿ ತಾಂಬ್ಯಾಚೆ ವಿಸ್ ಖಾಂಬೆ ಅನಿ ವಿಸ್ ಪಾಯಾ ಕರ್ಲ್ಯಾನ್, ತೆಚಿ ಕೊಂಡಿಯಾ ಅನಿ ಖಾಂಬೆ ಚಾಂದಿನ್ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 38:10" /><verse number="11" style="v" sid="EXO 38:11" />ಆವರನಾಚ್ಯಾ ಉತ್ತರಾಕ್ ಸೆಂಬರ್ ಹಾತ್ ಲಾಂಬ್ ಪರ್ದೆ ಅನಿ ವಿಸ್ ಖಾಂಬೆ ಅನಿ ವಿಸ್ ತಾಂಬ್ಯಾಚೆ ಪಾಯಾ ಬಸ್ವುಲ್ಯಾನ್, ಖಾಂಬ್ಯಾಂಚಿ ಕೊಂಡಿಯಾ ಚಾಂದಿಚಿ ಹೊತ್ತಿ. <verse eid="EXO 38:11" /><verse number="12" style="v" sid="EXO 38:12" />ದಿಸ್ ಬುಡ್ತಲ್ಯಾ ದಿಕ್ಕಾಕ್ ಪನ್ನಾಸ್ ಹಾತ್ ಲಾಂಬ್ ಪರ್ದೆ ಅನಿ ಧಾ ಪಾಯಾ ಹೊತ್ತಿ, ಖಾಂಬೆ, ಕಟ್ನಾ ಅನಿ ಕೊಂಡಿಯಾ ಚಾಂದಿಚಿ ಕರಲ್ಲ್ಯಾನ್. <verse eid="EXO 38:12" /><verse number="13" style="v" sid="EXO 38:13" />ದಿಸ್ ಉಗಾವ್ತಲ್ಯಾ ದಿಕ್ಕಾಚೆ ರುಂದಿ ಪನ್ನಾಸ್ ಹಾತ್ ಹೊತ್ತೆ. <verse eid="EXO 38:13" /><verse number="14" style="v" sid="EXO 38:14" />ಥೈತ್ಲ್ಯಾ ದಾರಾಚ್ಯಾ ದೊನಿ ಭಾಜುಕ್ನಿ ಪಂದ್ರಾಹಾತ್ ಲಾಂಬ್ ಪರ್ದೆ, <verse eid="EXO 38:14" /><verse number="15" style="v" sid="EXO 38:15" />ಅನಿ ತೆಂಕಾ ತಿತಿನ್ ಖಾಂಬೆ ಅನಿ ತಿತಿನ್ ಪಾಯ್ ಹೊತ್ತೆ. <verse eid="EXO 38:15" /><verse number="16" style="v" sid="EXO 38:16" />ಆವರನಾಚ್ಯಾ ಭೊತ್ಯಾನ್ ದೊರಿಯಾಂಚ್ಯಾ ಕಪ್ಡ್ಯಾಂಚೆ ಪರ್ದೆ ಹೊತ್ತೆ. <verse eid="EXO 38:16" /><verse number="17" style="v" sid="EXO 38:17" />ಖಾಂಬ್ಯಾಕ್ನಿ ತಾಂಬ್ಯಾಚೆ ಪಾಯಾ ಗುಂಡೆ ಹೊತ್ತೆ, ಖಾಂಬ್ಯಾಚಿ ಕೊಂಡಿಯಾ, ಅನಿ ಕಟ್ನಾ ಚಾಂದಿಚಿ, ತೆಚಿ ಅಡ್ವಿ ಪಟ್ಟಿಯಾ ಚಾಂದಿಚಿ ತಗ್ಡಾ ಮಾರಲ್ಲಿ, ಅನಿ ದಾರಾಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಖಾಂಬ್ಯಾಕ್ನಿಬಿ ಚಾಂದಿಚಿ ಕಟ್ನಾ ಹೊತ್ತಿ. <verse eid="EXO 38:17" /><verse number="18" style="v" sid="EXO 38:18" />ಆವರನಾತ್ ಹೊತ್ತೊ ಪರ್ದೊ ದೊರಿಯಾಂಚ್ಯಾ ಕಪ್ಡ್ಯಾನ್ ಅನಿ ಝಾಂಬ್ಳೆ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ಕಪ್ಡ್ಯಾನಿ ಅನಿ ಹಾತಿಚ್ಯಾ ಕಾಮಾನಿ ಕರಸಲ್ಲೆ ಹೊತ್ತೆ, ತೆ ವಿಸ್ ಹಾತ್ ಲಾಂಬ್ ಅನಿ ಹುರಲ್ಲ್ಯಾ ಪರ್ದ್ಯಾಂಚ್ಯಾ ಸಾರ್ಕೆಚ್ ಪಾಂಚ್ ಹಾತ್ ರುಂದ್ ಹೊತ್ತೆ. <verse eid="EXO 38:18" /><verse number="19" style="v" sid="EXO 38:19" />ಆವರನಾಚೆ ಚಾರ್ ಖಾಂಬೆ ಅನಿ ಚಾರ್ ತಾಂಬ್ಯಾಚಿ ಪಾಯಾ ಹೊತ್ತೆ, ಖಾಂಬ್ಯಾಂಚಿ ಕೊಂಡಿಯಾ ಕಟ್ನಾ, ಅನಿ ಧಾಪ್ನ್ಯಾಕ್ ಮಾರಲ್ಲೆ ಚಾಂದಿಚಿ ತಗ್ಡಾ ಹೊತ್ತಿ. <verse eid="EXO 38:19" /><verse number="20" style="v" sid="EXO 38:20" />ಬಿಡಾರಾಚೆ ಖಾಂಬೆ ಅನಿ ದಾರಾಚೆ ಖಾಂಬೆ ಸಗ್ಳೆ ತಾಂಬ್ಯಾಚೆ ಹೊತ್ತೆ.<verse eid="EXO 38:20" /></para>
  <para style="s">ಸರ್ವೆಸ್ಪರಾಚೆ ಬಿಡಾರ್ ಭಾಂದ್ತಾನಾ ವಾಪರಲ್ಲಿ ಸಾಮಾನಾ</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21" />ದೆವಾಕ್ ಬಗ್ತಲಿ ಗುಡಿ ಭಾಂದ್ತಾನಾ ವಾಪರಲ್ಲ್ಯಾ ಸಾಮಾನಾಂಚೊ ಇಸಬ್, ಮೊಯ್ಜೆಚ್ಯಾ ಹುಕುಮಾ ಸಾರ್ಕೆ ಮೊಟೊ ಯಾಜಕ್ ಆರೊನಾಚೊ ಲೆಕ್ ಇತಾಮಾರಾನ್ ಲೆವಿಂಚ್ಯಾಕ್ನಾ ಇಸಬ್ ಕರಸಲ್ಲೆ.<verse eid="EXO 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 38:22" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಲೆ ಸಗ್ಳೆ ಕರಲ್ಲೆ ಕೊನಿ ಮಟ್ಲ್ಯಾರ್, ಜುದ್ ಕುಳಿಚ್ಯಾ ಹುರಾಚೊ ನಾತು ಉರಿಚೊ ಲೆಕ್ ಬೆಚೆಲಾನುಚ್. <verse eid="EXO 38:22" /><verse number="23" style="v" sid="EXO 38:23" />ಅನಿ ತೆಜ್ಯಾ ವಾಂಗ್ಡಾ ದಾನ್ ಕುಳಿಚೊ ಅಹಿಸಾಮಾಕಾಚೊ ಲೆಕ್ ಒಹೊಲಿಬಾಮ್ ಬಿ ಹೊತ್ತೊ, ಹ್ಯೊ ಕೊರದ್ತಲೆ ಕಾಮ್ ಗೊತ್ತ್ ಹೊತ್ತೊ ಅನಿ ಚಮತ್ಕಾರಾಚಿ ಕಾಮಾ ಕರ್ತಲೊ ಅನಿ ದೊರಿಯಾಂಚ್ಯಾ ಕಪ್ಡ್ಯಾನಿ ಅನಿ ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ ಹಾತೆಚೆ ಕಾಮ್ ಕರ್ತಲೊ ಹೊವ್ನ್ ರ್‍ಹಾತಾ. <verse eid="EXO 38:23" /><verse number="24" style="v" sid="EXO 38:24" />ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಸಗ್ಳ್ಯಾ ನಮುನ್ಯಾಚ್ಯಾ ಕಾಮಾಕ್ ವಾಪರಲ್ಲ್ಯಾ ಸೊನ್ಯಾಚೆ ವಜನ್ ಹಾಜಾರ್ ಕಿಲೊ ಅನಿ ಸಾತ್ ಸೆಂಬರಾತ್ ತಿಸ್ ಶೆಕೆಲ್ ಹೊವ್ನ್ ಹಾಯ್.<verse eid="EXO 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 38:25" />ಲೊಕಾಂಚಿ ಮೆಜ್ನಿ ಕರಲ್ಲ್ಯಾ ಎಳಾರ್ ಲೊಕಾಂಚ್ಯಾಕ್ನಾ ಜಮಾ ಕರಲ್ಲಿ ಚಾಂದಿ ಪವಿತ್ರ್ ಜಾಗ್ಯಾಚ್ಯಾ ಮಾಪಾನ್ ಚಾರ್ ಹಾಜಾರ್ ಕಿಲೊ, ಅನಿ ಎಕ್ ಹಜಾರ್ ತಿನ್ಸೆ ಪನ್ನಾಸ್ ಸೆಕೆಲ್. <verse eid="EXO 38:25" /><verse number="26" style="v" sid="EXO 38:26" />ಲೊಕಾಂಚಿ ಮೆಜ್ನಿ ಕರಲ್ಲ್ಯಾ ಎಳಾರ್ ಎಕ್ಲ್ಯಾನ್ ಎಕ್ ಬೆಕಾಚ್ಯಾ ಇಸಬಾನ್ ಪವಿತ್ರ್ ಸನಾಚ್ಯಾ ಮಾಪಾಚ್ಯಾ ಇಸಬಾನ್ ವಿಸ್ ವರಿಸ್ ಹೊಲ್ಲ್ಯಾನಿ ಸಾ ಲಾಕ್ ತಿನ್ ಹಾಜಾರ್ ಪಾಂಸೆ ಪನ್ನಾಸ್ ಲೊಕಾನಿ ದಿಲ್ಲೊ ಇಸಬ್ ತೊ. <verse eid="EXO 38:26" /><verse number="27" style="v" sid="EXO 38:27" />ದೆವಾಚ್ಯಾ ಗುಡಿಚ್ಯಾ ಪಾಯಾಚೆ ಗುಂಡೆ ಅನಿ ಖಾಂಬ್ಯಾಂಚೆ ಪಾಯಾಚೆ ಗುಂಡೆ ತಯಾರ್ ಕರ್ತಾನಾ ವಾಪರಲ್ಲಿ ಚಾಂದಿ ತಿನ್ ಹಾಜಾರ್ ಚಾರ್ಸೆ ವಿಸ್ ಕಿಲೊ ಹೊವ್ನ್ ಹಾಯ್. <verse eid="EXO 38:27" /><verse number="28" style="v" sid="EXO 38:28" />ಹುರಲ್ಲ್ಯಾ ತಿಸ್ ಕಿಲೊನಿ ಖಾಂಬ್ಯಾಕ್ನಿ ಕೊಂಡಿಯಾ ಅನಿ ಕಟ್ನಾ ಕರುನ್ ತೆಜ್ಯಾ ತುದಿಕ್ನಿ ತಗ್ಡಾ ಮಾರ್ಲ್ಯಾನಿ. <verse eid="EXO 38:28" /><verse number="29" style="v" sid="EXO 38:29" />ಲೊಕಾನಿ ದಿಲ್ಲ್ಯಾ ಕಾನಿಕಾಚ್ಯಾ ತಾಂಬ್ಯಾಚೊ ಇಸಬ್, ದೊನ್ ಹಾಜಾರ್ ಚಾರ್ಸೆ ಕಿಲೊ. <verse eid="EXO 38:29" /><verse number="30" style="v" sid="EXO 38:30" />ಹೆಜ್ಯಾನ್ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಚ್ಯಾ ದಾರಾಕ್ ಪಾಯಾಚೆ ಗುಂಡೆ ಅನಿ ತಾಂಬ್ಯಾಚೊ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಅನಿ ತಾಂಬ್ಯಾಚಿ ಚಾಳನ್, <verse eid="EXO 38:30" /><verse number="31" style="v" sid="EXO 38:31" />ಬಲಿ ಭೆಟ್ವುತಲ್ಯಾ ಕಟ್ಟ್ಯಾಚಿ ಸಗ್ಳಿ ಸಾಮಾನಾ ಅನಿ ದಾರಾಚ್ಯಾ ಭೊತ್ಯಾನ್ ಪಾಯಾಚೆ ಗುಂಡೆ, ದಾರಾಚೆ ಪಾಯಾಚೆ ಗುಂಡೆ ಅನಿ ದಾರಾಚೆ ಸಗ್ಳೆ ಖಾಂಬೆ ಕರ್ಲ್ಯಾನ್.<verse eid="EXO 38:31" /></para>
  <chapter eid="EXO 38" />
  <chapter number="39" style="c" sid="EXO 39" />
  <para style="s">ಯಾಜಕಾಕ್ನಿ ದಿಕ್ಷಾಚೆ ಕಪ್ಡೆ ತಯಾರ್ ಕರಲ್ಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ, ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ ದೆವಾಚ್ಯಾ ಗುಡಿಚಿ ಸೆವಾ ಕರುಕ್ ಆರೊನಾಕ್ ಶಿಂಗಾರಾಚೆ, ದಿಕ್ಷಾಚೆ ಕಪ್ಡೆ ಕರಸ್ಲ್ಯಾನ್. <verse eid="EXO 39:1" /><verse number="2" style="v" sid="EXO 39:2" />ಮೊಟ್ಟ್ಯಾ ಯಾಜಕಾಚೆ ಎಪೊದ್ ಮನ್ತಲೊ ಛಾತಿಚೊ ಕವ್ಚಿ ಪುಂಡಿಚ್ಯಾ ದೊರ್ಯಾಚ್ಯಾ ಕಪ್ಡ್ಯಾನಿ ಅನಿ ಸೊನ್ಯಾಚ್ಯಾ ದೊರಾನಿ ಅನಿ ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 39:2" /><verse number="3" style="v" sid="EXO 39:3" />ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನ್ ಅನಿ ದೊರ್ಯಾಚ್ಯಾ ಕಪ್ಡ್ಯಾನ್ ಚಮತ್ಕಾರಾಚೆ ಹಾತಿಚೆ ಕಾಮ್ ಕರ್‍ತಲ್ಯಾಂಚ್ಯಾ ಪದ್ದತಿ ಸರ್ಕೆ ಕರುಕ್ ಸಾಟ್ನಿ ಸೊನ್ಯಾ ತಗ್ಡಾಚೆ ಬಾರಿ ಬಾರಿಕ್ ತುಕ್ಡೆ ಕಾತರ್ಲ್ಯಾನಿ. <verse eid="EXO 39:3" /><verse number="4" style="v" sid="EXO 39:4" />ತ್ಯಾ ಛಾತಿಚ್ಯಾ ಕವ್ಚಿಚ್ಯಾ ಭುಜೆ ವರ್‍ತಿ ದೊನ್ ಪಟ್ಟಿಯಾ ಕರ್ಲ್ಯಾನಿ; ತೆಚಿ ದೊನ್ ತುದಿಯಾ ಜೊಡಸಲ್ಲಿ ಹೊತ್ತಿ. <verse eid="EXO 39:4" /><verse number="5" style="v" sid="EXO 39:5" />ಕವ್ಚಿಚ್ಯಾ ವರ್‍ತಿ ಹೊತ್ತೆ ಚಮತ್ಕಾರಾಚೆ ಕಾಮ್ ಕಂಬ್ರೆಚ್ಯಾ ಕವ್ಚಿಕ್ ಮಿಳುನ್ ತಸೆಚ್ ಪುಂಡಿಚ್ಯಾ ದೊರ್ಯಾಚ್ಯಾ ಕಪ್ಡ್ಯಾನ್ ಅನಿ ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ ಕರ್ಲ್ಲೆ ಹೊತ್ತೆ, ತೆ ಸಗ್ಳೆ ಮೊಯ್ಜೆಕ್ ಸರ್ವೆಸ್ಪರಾನ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಕರಲ್ಯಾನಿ. <verse eid="EXO 39:5" /><verse number="6" style="v" sid="EXO 39:6" />ಛಪ್ಪ್ಯಾಚೊ ಕೊರದ್ತಲ್ಯಾ ಸಾರ್ಕೆ ಗೊಮೆದಿಕ್ ಗುಂಡ್ಯಾ ವೈನಿ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ಬಾರಾ ಕುಳಿಯಾಂಚಿ ನಾವಾ ಕೊರದ್ಲ್ಯಾನಿ. <verse eid="EXO 39:6" /><verse number="7" style="v" sid="EXO 39:7" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ, ತೆ ದೊನಿ ಗುಂಡೆ ಇಜ್ರಾಯೆಲಾಂಚ್ಯಾ ಯಾದೆಚೆ ಹೊಯ್ ಸಾರ್ಕೆ ಕವ್ಚಿಚ್ಯಾ ಭುಜೆ ವೈಲ್ಯಾ ಪಟ್ಟಿಯಾಕ್ನಿ ಭಾಂದ್ಲ್ಯಾನ್.<verse eid="EXO 39:7" /></para>
  <para style="s">ಛಾತಿಚೆ ಕವ್ಚಿ ಕರಸಲ್ಲೆ</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8" />ಛಾತಿಚ್ಯಾ ಕವ್ಚಿಚ್ಯಾ ಸಾರ್ಕೆಚ್ ಹಾತಿಚ್ಯಾ ಕಾಮಾನಿ ಅನಿ ಸೊನ್ಯಾಚ್ಯಾ ದೊರ್ಯಾನಿ ಅನಿ ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನಿ ಪುಂಡಿಚ್ಯಾ ದೊರ್ಯಾಚ್ಯಾ ಕಪ್ಡ್ಯಾನಿ ಪಿಸ್ವಿ ಸಾರ್ಕೆ ಪದಕ್ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 39:8" /><verse number="9" style="v" sid="EXO 39:9" />ತೆ ಚವ್ಕ್ ಅನಿ ತಿಚೆ ಪದಕ್ ದೊನ್ ಕಾನ್ಯಾಂಚೆ ಹೊತ್ತೆ, ತೆ ಎಕ್ ಗೆನ್ ಲಾಂಬಿ ಅನಿ ಎಕ್ ಗೆನ್ ರುಂದಿ ಹೊತ್ತೆ. <verse eid="EXO 39:9" /><verse number="10" style="v" sid="EXO 39:10" />ತೆಚ್ಯಾ ಪಿಡ್ಲ್ಯಾ ಭಾಗಾತ್ ಚಾರ್ ಸಾಲ್ ಕರುನ್, ಪೈಲೆಚ್ಯಾ ಸಾಲಿತ್ ಮಾನಿಕ್ಯಾ, ಪುಶ್ಪರಾಗ್ ಅನಿ ಸ್ಪಟಿಕ್, <verse eid="EXO 39:10" /><verse number="11" style="v" sid="EXO 39:11" />ದೊನ್ವೆಚ್ಯಾ ಸಾಲಿತ್, ಪಚ್ಚೆ, ನಿಲಮನಿ ಅನಿ ವಜ್ರ, <verse eid="EXO 39:11" /><verse number="12" style="v" sid="EXO 39:12" />ತಿನ್ವೆಚ್ಯಾ ಸಾಲಿತ್ ಸೊನ್ಯಾಚೊ ಗುಂಡೊ, ಅನಿ ಗೊಮೆದಿ, ಪದ್ಮರಾಗಾ, <verse eid="EXO 39:12" /><verse number="13" style="v" sid="EXO 39:13" />ಅನಿ ಚಾರ್ವೆಚ್ಯಾ ಸಾಲಾಕ್ ಪಿತರತ್ನ, ಬೆರುಲ್ಲಾ, ಅನಿ ವೈಡುರ್ಯ, ಸೊನ್ಯಾಚ್ಯಾ ಸರ್ಗಿಯಾತ್ನಿ ಮಿಳುಲ್ಯಾನ್. <verse eid="EXO 39:13" /><verse number="14" style="v" sid="EXO 39:14" />ಇಜ್ರಾಯೆಲಾಚ್ಯಾ ಕುಳಿಯಾಂಚ್ಯಾ ಅಂಕ್ಯಾಕ್ ಸಮಾ ಹೊಯ್ ಸಾರ್ಕೆ ಬಾರಾ ಗುಂಡೆ ಹೊತ್ತೆ, ಛಪ್ಪ್ಯಾಚ್ಯಾ ಗುಂಡ್ಯಾ ವರ್‍ತಿ ಕೊರ್ದಲ್ಯಾ ಸಾರ್ಕೆ ಎಕೆಕ್ ಗುಂಡ್ಯಾ ವರ್‍ತಿ ಎಕೆಕ್ ಕುಳಿಚೆ ನಾವ್ ಕೊರದಲ್ಲೆ ಹೊತ್ತೆ. <verse eid="EXO 39:14" /><verse number="15" style="v" sid="EXO 39:15" />ಪದಕಾಚ್ಯಾ ವರ್‍ತಿ ದೊರ್ಯಾಚ್ಯಾ ಸಾರ್ಕೆ ಶುದ್ದ್ ಸೊನ್ಯಾಚಿ ಸೊರ್ಪೊಳಿಯಾ ಎನ್ತಲ್ಯಾ ಕಾಮಾನಿ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 39:15" /><verse number="16" style="v" sid="EXO 39:16" />ದೊನ್ ಸೊನ್ಯಾಚಿ ಕಾಕ್ನಾ ಅನಿ ದೊನ್ ಮುದ್ದಿಯಾ ಕರುನ್ ತಿ ಮುದ್ದಿಯಾ ಛಾತಿಚ್ಯಾ ಪದಕಾಚ್ಯಾ ದೊನಿ ಮುಲ್ಲ್ಯಾಕ್ನಿ ಲಾವ್ಲ್ಯಾನ್. <verse eid="EXO 39:16" /><verse number="17" style="v" sid="EXO 39:17" />ಎನಲ್ಲಿ ತಿ ದೊನ್ ಸೊನ್ಯಾಚಿ ಸರ್ಪಳಿಯಾ ಪದಕಾಚ್ಯಾ ಮುಲ್ಲ್ಯಾತ್ಲ್ಯಾ ಮುದ್ದಿಯಾಕ್ನಿ ಲಾವ್ಲ್ಯಾನ್. <verse eid="EXO 39:17" /><verse number="18" style="v" sid="EXO 39:18" />ಎನಲ್ಲ್ಯಾ ಸರ್ಪೊಳಿಯಾಂಚಿ ತುದಿಯಾ ಕವ್ಚಿಚ್ಯಾ ಭುಜೆವೈಲ್ಯಾ ಪಟ್ಟಿಯಾಕ್ನಿ ಹೊತ್ತ್ಯಾ ದೊನ್ ಕಾಕ್ನಾಚ್ಯಾ ಫಿಡೆ ಸಿರಕ್ಲ್ಯಾನಿ. <verse eid="EXO 39:18" /><verse number="19" style="v" sid="EXO 39:19" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ದೊನ್ ಸೊನ್ಯಾಚಿ ಮುದ್ದಿಯಾ ಕರುನ್, ಪದಕಾಚ್ಯಾ ಭುತ್ತುರ್ಲ್ಯಾ ಅಂಗಾಚ್ಯಾ ಮುಲ್ಲ್ಯಾತ್ನಿ ಛಾತಿಚ್ಯಾ ಕವ್ಚಿಚ್ಯಾ ಜಗ್ಗೊಳುಚ್ ಥವ್ಲ್ಯಾನಿ. <verse eid="EXO 39:19" /><verse number="20" style="v" sid="EXO 39:20" />ಅನಿ ದೊನ್ ಸೊನ್ಯಾಚಿ ಮುದ್ದಿಯಾ ಕರುನ್, ಕವ್ಚಿಚ್ಯಾ ಭುಜುವೈಲ್ಯಾ ದೊನಿ ಪಟ್ಟಿಯಾಂಚಿ ಫಿಡ್ಲಾ ಭಾಗಾಚ್ಯಾ ಮುಳಾತ್ ಅನಿ ಕವ್ಚಿಚ್ಯಾ ಜೊಡಸಲ್ಲ್ಯಾ ಚಮತ್ಕಾರಾಚ್ಯಾ ಕಂಬ್ರೆಚ್ಯಾ ಪಟ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ಥವ್ಲ್ಯಾನಿ. <verse eid="EXO 39:20" /><verse number="21" style="v" sid="EXO 39:21" />ಪದಕ್ ಚಮತ್ಕಾರಾಚ್ಯಾ ಕಂಬ್ರೆಚ್ಯಾ ಪಟ್ಟಿಚ್ಯಾ ವರ್‍ತಿ, ಘಟ್ ಅನಿ ಕಳ್ಚುನ್ ಪಡಿನಾ ಸಾರ್ಕೆ, ತೆಚಿ ಮುದ್ದಿಯಾ ಕವ್ಚಿಚ್ಯಾ ಮುದ್ದಿಯಾಕ್ನಿ ಝಾಂಬ್ಳ್ಯಾ ದೊರ್ಯಾನಿ ಭಾಂದ್ಲ್ಯಾನಿ, ಅಸೆ ಕರುಚೆ ಮನುನ್ ಸರ್ವೆಸ್ವರಾನ್ ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಯಾನ್.<verse eid="EXO 39:21" /></para>
  <para style="s">ಯಾಜಕಾಂಚೆ ಹುರಲ್ಲೆ ಕಪ್ಡೆ ತಯಾರ್ ಕರ್‍ತಲೆ</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22" />ಕವ್ಚಿಚ್ಯಾ ವಾಂಗ್ಡಾ ನೆಸ್ತಲಿ ವೈಲಿ ಅಂಗಿ ಝಾಂಬ್ಳ್ಯಾ ಬನ್ನಾಚ್ಯಾ ಕಪ್ಡ್ಯಾನ್ ಹಾತಿಚ್ಯಾ ಕಾಮಾನುಚ್ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 39:22" /><verse number="23" style="v" sid="EXO 39:23" />ತೆಕಾ ಟಕ್ಲೆ ಗುಸ್ವುಕ್ ಜಾಗೊ ಸೊಡುನ್, ಥೈ ಪಿಂಜಿನಾ ಸಾರ್ಕೆ, ಯುದ್ದಾಚ್ಯಾ ಕವ್ಚಿ ಗತಿನ್ ತ್ಯಾ ಜಾಗ್ಯಾಚ್ಯಾ ಭೊತ್ಯಾನ್ ಹಾತಿಚಿ ಸಿವ್ನಿಯಾ ಘಾಲಸ್ಲ್ಯಾನ್. <verse eid="EXO 39:23" /><verse number="24" style="v" sid="EXO 39:24" />ವೈಲ್ಯಾ ಅಂಗಿಚ್ಯಾ ತುದಿಚ್ಯಾ ಭೊತ್ಯಾನಿ, ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚ್ಯಾ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನ್ ದಾಳಿಂಬ್ರಾಚ್ಯಾ ಹನ್ನಾ ಗತಿನ್ ಚಂಡಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 39:24" /><verse number="25" style="v" sid="EXO 39:25" />ಅನಿ ಶುದ್ದ್ ಸೊನ್ಯಾನಿ ಗೆಜ್ಜಿಯಾ ಕರುನ್, ವೈಲ್ಯಾ ಅಗಿಚ್ಯಾ ತುದಿಕ್ ತ್ಯಾ ಚಂಡಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಥವ್ಲ್ಯಾನಿ. <verse eid="EXO 39:25" /><verse number="26" style="v" sid="EXO 39:26" />ಸರ್ವೆಸ್ವರಾಚ್ಯಾ ಸೆವಾ ಸಾಟ್ನಿ ನೆಮಲ್ಲ್ಯಾ ವೈಲ್ಯಾ ಅಂಗಿಚ್ಯಾ ತುದಿಚ್ಯಾ ಭೊತ್ಯಾನಿ ಸೊನ್ಯಾಚಿ ಗೆಜ್ಜಿ, ದಾಳಿಂಬರಾ ಸಾರ್ಕೆ ಚಂಡಾ ಎಕ್ ಹೊಲ್ಲ್ಯಾ ಮಾನಾ ಎಕ್ ಹೊತ್ತಿ, ಸರ್ವೆಸ್ವರಾನ್ ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ತೆ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 39:26" /><verse number="27" style="v" sid="EXO 39:27" />ಆರೊನಾಕ್ ಅನಿ ತೆಚ್ಯಾ ಲೆಕಾಕ್ನಿ ಬಾರಿಕ್ ದೊರ್ಯಾನ್ ಎನಲ್ಲಿ ಅಂಗಿಯಾ, <verse eid="EXO 39:27" /><verse number="28" style="v" sid="EXO 39:28" />ದೊರ್ಯಾನಿ ಮೊಟ್ಟ್ಯಾ ಯಾಜಕಾಚೊ ಪಾವ್ಡ್ ಅನಿ ದೊರ್ಯಾನಿ ತೆಜೊ ಶಿಂಗಾರಾಚೊ ಪಾವ್ಡ್, ಪುಂಡಿಚ್ಯಾ ದೊರ್ಯಾನಿ ಭುತ್ತುರ್ಲೆ ಕಪ್ಡೆ, <verse eid="EXO 39:28" /><verse number="29" style="v" sid="EXO 39:29" />ಅನಿ ಪುಂಡಿಚ್ಯಾ ದೊರ್ಯಾನ್ ಅನಿ ನಿಳ್ಯಾ ಝಾಂಬ್ಳ್ಯಾ ರಗ್ತಾಚೊ ಬನ್ನಾಚ್ಯಾ ದೊರ್ಯಾನ್ ಹಾತಿಚ್ಯಾ ಸಿವ್ನಿಚ್ಯಾ ಕಾಮಾನ್ ಕಂಬ್ರೆಚೊ ಪಟ್ಟೊ ಕರ್ಲ್ಯಾನಿ, ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಯಾ ಸಾರ್ಕೆಚ್ ತೆ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 39:29" /><verse number="30" style="v" sid="EXO 39:30" />ಅನಿ ಶುದ್ದ್ ಸೊನ್ಯಾನಿ ನಿತಳ್ ಮುಕುಟಾಚೊ ಪಟ್ಟೊ ಕರುನ್ ಛಪ್ಪೊ ಗತಿನ್ ತೆಜ್ಯಾ ವರ್‍ತಿ “ಸರ್ವೆಸ್ಪರಾ ಸಾಟ್ನಿ ನಿತಳ್” ಮನುನ್ ಲಿವ್ಲ್ಯಾನಿ. <verse eid="EXO 39:30" /><verse number="31" style="v" sid="EXO 39:31" />ತೆ ಪಾವ್ಡಾಕ್ ಲಾವ್ಕ್ ಸಾಟ್ನಿ ಝಾಂಬ್ಳ್ಯೊ ದೊರೊ ಭಾಂದ್ಲ್ಯಾನಿ, ಮೊಯ್ಜೆನ್ ಸರ್ವೆಸ್ವರಾನ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್.<verse eid="EXO 39:31" /></para>
  <para style="s">ಕಾಮಾಚಿ ಸರ್ನಿ</para>
  <para style="r">
    <ref loc="EXO 35:10-19">35:10-19</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32" />ಅಸೆ ಸರ್ವೆಸ್ವರಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಚೆ ಸಗ್ಳೆ ಕಾಮ್ ಕರುನ್ ಸರ್ಲೆ, ಸರ್ವೆಸ್ವರಾನ್ ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ತೆ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 39:32" /><verse number="33" style="v" sid="EXO 39:33" />ತನ್ನಾ ತೆನಿ ತೆ ಬಿಡಾರ್ ಮೊಯ್ಜೆಕ್ಡೆ ಹಾನ್ಲ್ಯಾನಿ, ತೆ ಖಲೆ ಮಟ್ಲ್ಯಾರ್, ಬಿಡಾರ್ ಅನಿ ತೆಕಾ ಸಮಂದ್ ಪಡಲ್ಲಿ ಸಾಮಾನಾ, ಕೊಂಡಿಯಾ, ಚವ್ಕಟಾ, ಅಗ್ಳಿಯಾ, ಖಾಂಬೆ ಅನಿ ಪಾಂಯಾಚೆ ಗುಂಡೆ. <verse eid="EXO 39:33" /><verse number="34" style="v" sid="EXO 39:34" />ತಾಂಬ್ಡ್ಯಾ ಬನ್ನಾಚೆ ಹದಾ ಕರಲ್ಲೆ ಬಕ್ರ್ಯಾಚೆ ಚಮ್ಡ್ಯಾಚೆ ವೈಲೆ ಕಾಂಬ್ರಾನ್, ಅನಿ ಸಮುಂದರಾಚ್ಯಾ ದಂಡೆ ವೈಲೆ ಡುಕ್ರಾಚ್ಯಾ ಚಮ್ಡ್ಯಾನ್ ಕರಲ್ಲೆ ವೈಲೆ ಕಾಂಬ್ರಾನ್, ಅಗ್ದಿ ಪವಿತ್ರ್ ಜಾಗೊ ಧಾಪ್ತಲೊ ಪರ್ದೊ, <verse eid="EXO 39:34" /><verse number="35" style="v" sid="EXO 39:35" />ಕರಾರಾಂಚಿ ಪೆಟಿ, ತಿಚೆ ದಾಂಡೆ ಅನಿ ಕ್ರಪಾಸನಾಚೆ ಸಗ್ಳೆ, <verse eid="EXO 39:35" /><verse number="36" style="v" sid="EXO 39:36" />ಮಾಚೊ ಅನಿ ತೆಚಿ ಸಗ್ಳಿ ಸಾಮಾನಾ, ಭೆಟ್ವುಚಿ ಹೊಲ್ಲಿ ಭಾಕ್ರಿಯಾ, <verse eid="EXO 39:36" /><verse number="37" style="v" sid="EXO 39:37" />ಶುದ್ದ್ ಸೊನ್ಯಾಚೊ ದಿವ್ಯಾಂಚೊ ಖಾಂಬೊ, ತೆಚ್ಯಾ ವರ್‍ತಿ ಥವ್ತಲೆ ದಿವೆ, ತೆಚಿ ಸಾಮಾನಾ ಅನಿ ದಿವ್ಯಾಕ್ನಿ ಪಾಜೆ ಹೊಲ್ಲೆ ತೆಲ್, <verse eid="EXO 39:37" /><verse number="38" style="v" sid="EXO 39:38" />ಸೊನ್ಯಾಚೊ ಧುಪಾಚೊ ಕಟ್ಟೊ, ಅಭಿಶೆಕಾಚೆ ತೆಲ್ ಅನಿ ಬರ್ಯಾ ವಾಸೆಚೊ ಧುಪ್, ಬಿಡಾರಾಚ್ಯಾ ದಾರಾಚೊ ಪರ್ದೆ, <verse eid="EXO 39:38" /><verse number="39" style="v" sid="EXO 39:39" />ತಾಂಬ್ಯಾಚೊ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಅನಿ ತಿಜಿ ತಾಂಬ್ಯಾಚಿ ಚಾಳನ್, ತೆಚೆ ದಾಂಡೆ, ತೆಚಿ ಸಾಮಾನಾ, ಮೊಟಿ ವಾಟ್ಲಿ ಅನಿ ತಿಚೊ ಕಟ್ಟೊ. <verse eid="EXO 39:39" /><verse number="40" style="v" sid="EXO 39:40" />ಆವರನಾಚೆ ಪರ್ದೆ, ಖಾಂಬೆ, ಪಾಯಾಚೆ ಗುಂಡೆ ಭಾಯ್ಲ್ಯಾ ದಾರಾಚೆ ಪರ್ದೆ ಅನಿ ತೆಚಿ ದೊರಿಯಾ ಅನಿ ಖಾಂಬೆ ಪವಿತ್ರ್ ಜಾಗ್ಯಾಚ್ಯಾ ಸೆವಾಕ್ ಪಾಜೆ ಹೊಲ್ಲಿ ಸಗ್ಳಿ ಸಾಮಾನಾ. <verse eid="EXO 39:40" /><verse number="41" style="v" sid="EXO 39:41" />ದೆವಾಚ್ಯಾ ಪವಿತ್ರ್ ಜಾಗ್ಯಾಚಿ ಸೆವಾ ಕರ್‍ತಲ್ಯಾಕ್ನಿ ಪಾಜೆ ಹೊಲ್ಲೆ ಶಿಂಗಾರಾಚೆ ಕಪ್ಡೆ ಮಟ್ಲ್ಯಾರ್, ಆರೊನಾಚೊ ಯಾಜಕ್ ಸೆವಾಚೆ ಕಪ್ಡೆ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾಂಚ್ಯಾ ಯಾಜಕ್ ಸೆವಾಂಚೆ ಕಪ್ಡೆ ಹೆ ಸಗ್ಳೆ ಹಾನ್ಲ್ಯಾನಿ. <verse eid="EXO 39:41" /><verse number="42" style="v" sid="EXO 39:42" />ಸರ್ವೆಸ್ವರಾನ್ ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಇಜ್ರಾಯೆಲ್ ಲೊಕಾನಿ ತಿ ಸಗ್ಳಿ ಕಾಮಾ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 39:42" /><verse number="43" style="v" sid="EXO 39:43" />ತೆನಿ ಕರಲ್ಲಿ ಸಗ್ಳಿ ಕಾಮಾ ಮೊಯ್ಜೆನ್ ಪರಿಕ್ಷ್ಯಾ ಕರುನ್ ಬಗ್ತಾನಾ, ಸರ್ವೆಸ್ವರಾಚ್ಯಾ ಹುಕುಮಾ ಸಾರ್ಕೆಚ್ ತೆನಿ ಸಗ್ಳೆಬಿ ಕರುನ್ ಸಾರ್ಲಾತ್ ಮನುನ್ ಕಳ್ವುನ್ ತೆಂಕಾ ಆಶಿರ್ವಾದ್ ದಿಲ್ಯಾನ್.<verse eid="EXO 39:43" /></para>
  <chapter eid="EXO 39" />
  <chapter number="40" style="c" sid="EXO 40" />
  <para style="s">ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಗುಡಿ ವರ್‍ತಿ ಇಬೆಕರುನ್, ನೆಮಸ್ತಲೆ</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಸಾಂಗಲ್ಲೆ ಕಾಯ್ ಮಟ್ಲ್ಯಾರ್, <verse eid="EXO 40:1" /><verse number="2" style="v" sid="EXO 40:2" />ತಿಯಾ ಪೈಲ್ಯಾ ಮೈನ್ಯಾಚ್ಯಾ ಪೈಲೆಚ್ಯಾ ದಿಸಿ ದೆವಾಕ್ ಬಗ್ತಲಿ ಗುಡಿ ಉಕ್ಲುನ್ ಇಬೆ ಕರುಚೆ. <verse eid="EXO 40:2" /><verse number="3" style="v" sid="EXO 40:3" />ಧಾ ಹುಕುಮಾಂಚಿ ಕರಾರಾಂಚಿ ಪೆಟಿ ತ್ಯಾತುರ್ ಥವ್ನ್, ತೆ ಪಡ್ದ್ಯಾನ್ ಧಾಪುಚೆ. <verse eid="EXO 40:3" /><verse number="4" style="v" sid="EXO 40:4" />ಮಾನಾ ಮಾಚೊ ಹಾನುನ್, ತೆಚೆ ವರ್‍ತಿ ಥವ್ಚೆ ಹೊಲ್ಲೆ ಸಗ್ಳೆ ಸಮಾ ಕರುನ್ ಥವ್ನ್, ದಿವ್ಯಾಚೊ ಖಾಂಬೊ ಹಾನುನ್, ತೆಚೆ ದಿವೆ ಸಮಾ ಕರುನ್ ಥವ್ಚೆ. <verse eid="EXO 40:4" /><verse number="5" style="v" sid="EXO 40:5" />ಕರಾರಾಂಚ್ಯಾ ಪೆಟಿಚ್ಯಾ ಇದ್ರಾಕ್ ಸೊನ್ಯಾಚೊ ಧುಪಾಚಿ ಆಲ್ತಾರ್ ಥವ್ನ್, ಗುಡಿಚ್ಯಾ ದಾರಾಕ್ ಪಡ್ದೊ ಭಾಂದುಚೆ. <verse eid="EXO 40:5" /><verse number="6" style="v" sid="EXO 40:6" />ದೆವ್ ದಿಸ್ತಲ್ಯಾ ಬಗ್ತಲ್ಯಾ ಗುಡಿಚ್ಯಾ ದಾರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಥೌವ್ಚೆ. <verse eid="EXO 40:6" /><verse number="7" style="v" sid="EXO 40:7" />ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಚ್ಯಾ ಅನಿ ಬಲಿಚ್ಯಾ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ಆಯ್ದಾನ್ ಥವ್ನ್, ತ್ಯಾತುರ್ ಪಾನಿ ಭರುಚೆ. <verse eid="EXO 40:7" /><verse number="8" style="v" sid="EXO 40:8" />ದಾರಾಚ್ಯಾ ಭೊತ್ಯಾನ್ ಆವರನ್ ಇಬೆಕರುನ್ ತೆಜ್ಯಾ ದಾರಾಕ್ ಪರ್ದೊ ಲೊಂಬಾತ್ ಘಾಲುಚೆ.<verse eid="EXO 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 40:9" />ಅನಿ ತನ್ನಾ ಅಭಿಶೆಕ್ ಕರಲ್ಲೆ ತೆಲ್ ಘೆವ್ನ್ ಗುಡಿ ಅನಿ ತ್ಯಾತುರ್ ಹೊತ್ತೆ ಸಗ್ಳಿ ಸಾಮಾನಾ ಅಭಿಶೆಕ್ ಕರುನ್ ನೆಮ್ಸುಚೆ, ತ್ಯಾ ದಿಸಾಕ್ನಾ ತಿ ನಿತಳ್ ಹೊತಾತ್. <verse eid="EXO 40:9" /><verse number="10" style="v" sid="EXO 40:10" />ಬಲಿಚೊ ಕಟ್ಟೊ ಅನಿ ತೆಚಿ ಸಾಮಾನಾ ಅಭಿಶೆಕ್ ಕರುನ್ ಕಟ್ಟ್ಯಾಕ್ ನೆಮ್ಸುಚೆ, ತೊ ಕಟ್ಟೊ ಲೈ ನಿತಳ್ ಹೊವ್ನ್ ರಾವ್ಚೊ. <verse eid="EXO 40:10" /><verse number="11" style="v" sid="EXO 40:11" />ಆಯ್ದಾನ್ ಅನಿ ತೆ ಥವ್ತಲೊ ಜಾಗೊ ಅಭಿಶೆಕ್ ಕರುನ್ ನೆಮ್ಸುಚೆ.<verse eid="EXO 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 40:12" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, “ಆರೊನಾಕ್ ಅನಿ ತೆಜ್ಯಾ ಲೆಕಾಕ್ನಿ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಚ್ಯಾ ದಾರಾಕ್ಡೆ ಜಗ್ಗೊಳ್ ಹಾನುನ್, ನ್ಹಾವ್ಸುನ್, <verse eid="EXO 40:12" /><verse number="13" style="v" sid="EXO 40:13" />ಆರೊನ್ ಮಾಜೊ ಯಾಜಕ್ ಹೊಯ್ ಸಾರ್ಕೆ ತೆಕಾ ನೆಮಲ್ಲೆ ದಿಕ್ಷಾಚೆ ಕಪ್ಡೆ ನೆಸ್ವುನ್, ತೆಕಾ ಅಭಿಶೆಕ್ ಕರುನ್ ನೆಮ್ಸುಚೆ. <verse eid="EXO 40:13" /><verse number="14" style="v" sid="EXO 40:14" />ಮಾನಾ ಆರೊನಾಚ್ಯಾ ಲೆಕಾಕ್ನಿ ಬಲ್ವುನ್ ತೆಂಕಾ ದಿಕ್ಷಾಚೆ ಕಪ್ಡೆ ನೆಸ್ವುನ್, <verse eid="EXO 40:14" /><verse number="15" style="v" sid="EXO 40:15" />ಮಾಜೊ ಯಾಜಕ್ ಹೊವ್ಕ್ ಸಾಟ್ನಿ ತೆಂಚ್ಯಾ ಬಾಬಾಕ್ ಅಭಿಶೆಕ್ ಕರಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ತೆಂಕಾಬಿ ಅಭಿಶೆಕ್ ಕರುಚೆ, ಅಸೆ ಕರಲ್ಲ್ಯಾ ವೈನಾ ಯಾಜಕ್ ಪಾನ್ ತೆಂಕಾ ಅನಿ ತೆಂಚ್ಯಾ ಪಿಳ್ಗಿಕ್ ಶಾಶ್ವತ್ ಹೊವ್ನ್ ರ್‍ಹಾತಾ” ಮಟ್ಲ್ಯಾನ್. <verse eid="EXO 40:15" /><verse number="16" style="v" sid="EXO 40:16" />ಸರ್ವೆಸ್ಪರಾನ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಮೊಯ್ಜೆನ್ ಸಗ್ಳೆಬಿ ಕರ್ಲ್ಯಾನ್.<verse eid="EXO 40:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 40:17" />ದೊನ್ವ್ಯಾ ವರ್ಸಾಚ್ಯಾ ಪೈಲ್ಯಾ ಮೈನ್ಯಾಚ್ಯಾ ಪೈಲ್ಯಾ ದಿಸಾತ್ ಮೊಯ್ಜೆನ್ ಗುಡಿ ಉಕ್ಲುನ್ ಇಬೆ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 40:17" /><verse number="18" style="v" sid="EXO 40:18" />ತೆನಿ ಗುಡಿ ಉಕ್ಲುನ್ ತೆಚೆ ಪಾಯಾಚೆ ಗುಂಡೆ ಘಾಲುನ್, ಚವ್ಕಟಾ ಇಬೆ ಕರುನ್, ಅಗ್ಳಿಯಾ ದಿವ್ನ್, ಖಾಂಬೆ ಇಬೆ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 40:18" /><verse number="19" style="v" sid="EXO 40:19" />ಗುಡಿ ವರ್‍ತಿ ಪರ್ದೆ ಕಾಂಬ್ರುನ್, ತೆಚೆ ವೈಲೆ ಕಾಂಬ್ರಾನ್ ಘಾಟ್ಲ್ಯಾನ್, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಹುಕುಮಾ ಸಾರ್ಕೆ ಮೊಯ್ಜೆನ್ ಹೆ ಸಗ್ಳೆ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 40:19" /><verse number="20" style="v" sid="EXO 40:20" />ಹುಕುಮಾಂಚೆ ಗುಂಡೆ ಪೆಟಿತ್ ಥವ್ನ್, ಪೆಟಿಕ್ ದಾಂಡೆ ಲಾವ್ನ್, ತೆಜ್ಯಾ ವರ್‍ತಿ ಕರ್ಪಾಸನ್ ಥವ್ನ್, <verse eid="EXO 40:20" /><verse number="21" style="v" sid="EXO 40:21" />ಕರಾರಾಚಿ ಪೆಟಿ ಗುಡಿತ್ ಹಾನುನ್, ತೆಜ್ಯಾ ಇದ್ರಾಕ್ ಪರ್ದೊ ಲೊಂಬಾತ್ ಘಾಲುನ್, ಸರ್ವೆಸ್ಪರಾನ್ ಸಾಂಗಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್ ಕರಾರಾಚಿ ಪೆಟಿ ದಿಸಿನಾ ಸಾರ್ಕೆ ಕರ್ಲ್ಯಾನ್. <verse eid="EXO 40:21" /><verse number="22" style="v" sid="EXO 40:22" />ತವ್ಡೆಚ್ ನಸ್ತಾನಾ, ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಹುಕುಮಾ ಸಾರ್ಕೆ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಚ್ಯಾ ಉತ್ತರ್ ದಿಕ್ಕಾಕ್ಡೆ ಪರ್ದ್ಯಾಚ್ಯಾ ಭಾಯ್ರ್ ಮಾಚೊ ಥವ್ಲ್ಯಾನ್. <verse eid="EXO 40:22" /><verse number="23" style="v" sid="EXO 40:23" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್, ಮಾಚ್ಯಾ ವರ್‍ತಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಸಮಾ ಕರುನ್ ಭಾಕ್ರಿಯಾ ಥವ್ಲ್ಯಾನ್. <verse eid="EXO 40:23" /><verse number="24" style="v" sid="EXO 40:24" />ಅನಿ ತೆನಿ ದಿವ್ಯಾಂಚೊ ಖಾಂಬೊ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿತ್ ಮಾಚ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ಗುಡಿಚ್ಯಾ ದಕ್ಷಿನ್ ಭಾಗಾಕ್ ಥವ್ನ್, <verse eid="EXO 40:24" /><verse number="25" style="v" sid="EXO 40:25" />ಅನಿ ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ, ತೆಚೆ ದಿವೆ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಸಮಾ ಕರುನ್ ಥವ್ಲ್ಯಾನ್. <verse eid="EXO 40:25" /><verse number="26" style="v" sid="EXO 40:26" />ಅನಿ ಸೊನ್ಯಾಚೊ ಧುಪಾಚೊ ಕಟ್ಟೊ ಗುಡಿಚ್ಯಾ ಪರ್ದ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ಥವ್ನ್, <verse eid="EXO 40:26" /><verse number="27" style="v" sid="EXO 40:27" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆ, ತೆಜ್ಯಾ ವರ್‍ತಿ ಬರ್ಯಾ ವಾಸೆಚ್ಯಾ ತೆಲಾಂಚೆ ಧುಪ್ ಘಾಟ್ಲ್ಯಾನ್. <verse eid="EXO 40:27" /><verse number="28" style="v" sid="EXO 40:28" />ಅನಿ ತೆನಿ ಗುಡಿಚ್ಯಾ ದಾರಾಕ್ ಪರ್ದೊ ಘಾಟ್ಲ್ಯಾನ್. <verse eid="EXO 40:28" /><verse number="29" style="v" sid="EXO 40:29" />ಸರ್ವೆಸ್ಪರಾನ್ ಮೊಯ್ಜೆಕ್ ಹುಕುಮ್ ದಿಲ್ಲ್ಯಾ ಸಾರ್ಕೆಚ್, ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಚ್ಯಾ ದಾರಾಚ್ಯಾ ಇದ್ರಾಕ್ ಬಲಿ ಭೆಟ್ವುತಲೊ ಕಟ್ಟೊ ಥವ್ನ್ ತೆಜ್ಯಾ ವರ್‍ತಿ ಸಗ್ಳೆ ಆಂಗ್ ಬಲಿ ಅನಿ ದಾನ್ಯಾಂಚಿ ಬಲಿ ಭೆಟ್ವುಲ್ಯಾನ್. <verse eid="EXO 40:29" /><verse number="30" style="v" sid="EXO 40:30" />ಮೊಯ್ಜೆನ್ ಗುಡಿಚ್ಯಾ ಅನಿ ಬಲಿಚ್ಯಾ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಮದ್ದಿ ಆಯ್ದಾನ್ ಥವ್ನ್, ಧುವ್ನ್ ಘೆವ್ಕ್ ಸಾಟ್ನಿ ತ್ಯಾತುರ್ ಪಾನಿ ಥವ್ಲ್ಯಾನ್. <verse eid="EXO 40:30" /><verse number="31" style="v" sid="EXO 40:31" />ತ್ಯಾತುರ್ ಮೊಯ್ಜೆ, ಆರೊನ್ ಅನಿ ತೆಚಿ ಲೆಕಾ ಹಾತ್, ಪಾಂಯ್ ಧುವ್ನ್ ಘೆಯ್ತ್, <verse eid="EXO 40:31" /><verse number="32" style="v" sid="EXO 40:32" />ಅನಿ ತೆನಿ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಹುಕುಮಾ ಸಾರ್ಕೆ ಗುಡಿಚ್ಯಾ ಭುತ್ತುರ್ ಜಾತಾನಾ ಅನಿ ಬಲಿ ಭೆಟ್ವುತಲ್ಯಾ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಸೆವಾಕ್ ಯೆಲ್ಲ್ಯಾ ತನ್ನಾ ತೆನಿ ತಸೆ ಕರ್ಲ್ಯಾನಿ. <verse eid="EXO 40:32" /><verse number="33" style="v" sid="EXO 40:33" />ಗುಡಿಚ್ಯಾ ಅನಿ ಬಲಿಚ್ಯಾ ಕಟ್ಟ್ಯಾಚ್ಯಾ ಭೊತ್ಯಾನ್ ಆವರನಾ ಇಬೆ ಕರುನ್, ಮ್ಹಾಳ್ ಜಾಗ್ಯಾಚ್ಯಾ ದಾರಾಕ್ ಪರ್ದೆ ಘಾಟ್ಲ್ಯಾನ್, ಅಸೆ ಮೊಯ್ಜೆನ್ ತೆ ಸಗ್ಳೆ ಕಾಮ್ ಕರುನ್ ಸಾರ್ಲ್ಯಾನ್.<verse eid="EXO 40:33" /></para>
  <para style="s">ಸರ್ವೆಸ್ಪರಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಕ್ ಮೊಡಾನ್ ಧಾಪಲ್ಲೆ</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34" />ತನ್ನಾ ದೆವಾಕ್ ಬಗ್ತಲ್ಯಾ ಗುಡಿಕ್ ಮೊಡಾನ್ ಧಾಪ್ಲ್ಯಾನ್, ಅನಿ ಸರ್ವೆಸ್ಪರಾಚಿ ಮಹಿಮಾ ಗುಡಿತ್ ಭರ್ಲಿ. <verse eid="EXO 40:34" /><verse number="35" style="v" sid="EXO 40:35" />ಗುಡಿ ವರ್‍ತಿ ಮೊಡ್ ಧಾಪಲ್ಲ್ಯಾ ಸಾಟ್ನಿ ಅನಿ ಸರ್ವೆಸ್ಪರಾಚಿ ಮಹಿಮಾ ಗುಡಿತ್ ಭರಲ್ಲ್ಯಾ ಸಾಟ್ನಿ, ಮೊಯ್ಜೆಕ್ ಗುಡಿತ್ ಜಾವ್ಕ್ ಹೊವ್ಕ್ ನಾ. <verse eid="EXO 40:35" /><verse number="36" style="v" sid="EXO 40:36" />ತೊ ಮೊಡ್ ಗುಡಿಕ್ ಸೊಡುನ್ ವರ್‍ತಿ ಗೆಲ್ಲ್ಯಾ ತನ್ನಾ, ಇಜ್ರಾಯೆಲ್ ಲೊಕಾ ಫಿಡೆ ಪರ್ಯಾನ್ ಕರಿತ್. <verse eid="EXO 40:36" /><verse number="37" style="v" sid="EXO 40:37" />ತೊ ಮೊಡ್ ಸೊಡಿನಸ್ತಾನಾ ರ್‍ಹಾತಾನಾ, ಸೊಡಿ ಪತರ್ ಪರ್ಯಾನ್ ಕರಿನಸ್ತಾನಾ ರಾಯ್ತ್. <verse eid="EXO 40:37" /><verse number="38" style="v" sid="EXO 40:38" />ಇಜ್ರಾಯೆಲ್ ಲೊಕಾಂಚ್ಯಾ ಸಗ್ಳ್ಯಾ ಪರ್ಯಾನಾತ್ನಿಬಿ ತೆಂಚ್ಯಾ ಡೊಳ್ಯಾಂಚ್ಯಾ ಇದ್ರಾಕ್ ದಿಸ್ ಉಜ್ವೊಡಿಚ್ ಸರ್ವೆಸ್ಪರಾಚೊ ಮೊಡ್ ಗುಡಿಚ್ಯಾ ವರ್‍ತಿ ಹೊತ್ತೊ, ಅನಿ ರಾತ್ತಿನ್ ಮೊಡಾತ್ ಆಗ್ ಹೊಳ್ವಳು ಲಾಗಲ್ಲಿ.<verse eid="EXO 40:38" /></para>
  <chapter eid="EXO 40" />
</usx>