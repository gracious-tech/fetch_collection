<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Siddi</book>
  <para style="h">ಹಬಕ್ಕುಕ್</para>
  <para style="toc3">ಹಬಕುಕ್ಕ್</para>
  <para style="toc2">ಹಬ</para>
  <para style="toc1">ಹಬಕ್ಕುಕ್ ಪರ್‍ವಾದ್ಯಾಚೆ ಪುಸ್ತಕ್</para>
  <para style="mt2">ಹಬಕ್ಕುಕ್ ಪರ್‍ವಾದ್ಯಾಚೆ ಪುಸ್ತಕ್</para>
  <para style="mt1">ಹಬಕ್ಕುಕ್ ಪರ್‍ವಾದ್ಯಾಚೆ ಪುಸ್ತಕ್</para>
  <para style="iot">ವಳಕ್</para>
  <para style="ip">ಹ್ಯಾ ಪುಸ್ತಕಾತ್ ಹಬಕುಕ್ಕಾಚೆ ಪರ್‍ವಾದನ್ ಹಾಯ್. ಹಬಕುಕ್ಕಾಚ್ಯಾ ಪುಸ್ತಕಾತ್ ಇಜ್ರಾಯೆಲಾಕ್ನಿಚ್ ಮನುನ್ ಸಾಂಗಲ್ಲೆ ಕಾಯ್ ದಿಸುನ್ ಯೆಯ್ನಾ. ಹೆಚ್ಯಾ ಬದ್ಲಾಕ್ ಹಬಕುಕ್ಕಾಚಿ ದೊನ್ ಫಿರ್‍ಯಾದಿಯಾ ಸಾಂಗ್ತಲೆ ದಿಸುನ್ ಯೆತಾ. ಅನಿ ಎಕ್ ಮಾಗ್ನಿ ಹಾಯ್. ದೆವ್ ಹ್ಯಾ ಫಿರ್‍ಯಾದಿಯಾಕ್ನಿ ಜವಾಬ್ ದಿತಾ. ಹಬಕುಕ್ಕಾ ಜೆರೆಮಿಯಾನ್ ಜಿವನ್ ಕರಲ್ಲ್ಯಾ ಎಳಾರುಚ್ ರಾಜಾ ಜೊಶಿಯಾ ಅನಿ ಜೆಹೊವಾಜಾಕಿಮಾಚ್ಯಾ ರಾಜ್ವಡ್ಕಿತ್ ಜಿವನ್ ಕರಲ್ಲ್ಯಾನ್ ಹೊವ್ಕ್ ಫಿರೆ ಮನುನ್ ಬುದ್ವಂತ್ ಲೊಕಾ ಚಿಂತಾತ್. ಖರೆ ಹಬಕುಕ್ಕಾಚ್ಯಾ ಪುಸ್ತಕಾತ್ ನಾತರ್ ದುಶ್ರ್ಯಾ ಖಲ್ಯಾಬಿ ಪವಿತ್ರ್ ಪುಸ್ತಕಾತ್ಬಿ ತೊ ಖಲ್ಯಾ ಎಳಾರ್ ಜಿವನ್ ಕರಿತ್ ಹೊತ್ತೊ ಮನ್ತಲೆ ಸಮಾ ಸಾಂಗಲ್ಲೆ ನಾ.</para>
  <para style="ip">ಹಬಕುಕ್ಕಾನ್ ಪಯ್ಲೆ ದೆವಾಕ್ಡೆ ಫಿರ್‍ಯಾದ್ ಸಾಂಗಲ್ಲ್ಯಾನ್, ಅಪ್ನಿ ತರಾಸಾ ಅನಿ ಆಕ್ರಮನ್ ಬಗಿತ್ ರಾಲ್ಯಾರ್ಬಿ, ದೆವ್ ಅಪ್ನಾಚ್ಯಾ ಮಾಗ್ನಿಯಾಕ್ನಿ ಜವಾಬ್ ದಿಯ್ನಾ ಹೊಲಾ ಮನುನ್ ಹಿ ಘಟ್ನಾ ಲೈ ಕರುನ್ ಜುದಾಚ್ಯಾ ದೆಸಾತ್ ಚಲಿತ್ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆ ದಿಸುನ್ ಯೆತಾ. ಜುದಾಕ್ ನಾಶ್ ಕರುಕ್ ಸಾಟ್ನಿ ಮಿಯಾ ಬಾಬಿಲೊನಾಕ್ ಇಬೆ ಕರ್ತಾ. ಮನ್ತಲ್ಯಾ ವಯ್ನಾ ಸರ್ವೆಸ್ಪರ್ ಹಬಕ್ಕುಕಾಚ್ಯಾ ಮಾಗ್ನಿಕ್ ಜವಾಬ್ ದಿತಾ. ಹಬಕ್ಕುಕ್ ಅನಿ ಎಗ್ದಾ ಫಿರ್‍ಯಾದ್ ಸಾಂಗ್ತಾ. ಕಮ್ಮಿ ಬುರ್ಸೆ ಹೊತ್ತ್ಯಾಕ್ನಿ ನಾಶ್ ಕರುಕ್ ಸಾಟ್ನಿ ಲೈ ಬುರ್ಸೆ ಹೊತ್ತ್ಯಾ ಲೊಕಾಕ್ನಿ ವಾಪ್ರುಕ್ ಲಾಗ್ಲಾ ಮನುನ್ ಫಿರ್‍ಯಾದ್ ಸಾಂಗ್ತಾ.ಮಾನಾ ಬಾಬಿಲೊನಾಚ್ಯಾಕ್ನಿ ಝಡ್ತಿ ಕರುನ್ ಹೊತಾ ಮನುನ್ ಸರ್ವೆಸ್ಪರಾನ್ ಜವಾಬ್ ದಿಲ್ಯಾನ್. ಆಕ್ರಿಕ್ ಹಬಕ್ಕುಕಾನ್ ದೆವಾಕ್ಡೆ ಮಾಗ್ನಿ ಕರುನ್, ಮಾಗ್ನಿಯಾತ್ನಿ ದಯಾ ದಾಕ್ವುಚೆ ಅನಿ ಕಾಮ್ ಕರುಚೆ ಮನುನ್ ಮಾಗ್ಲ್ಯಾನ್. ತೊ ದೆವಾನ್ ಕಳದಲ್ಲ್ಯಾ ದಿಸಾತ್ನಿ ಕರಲ್ಲ್ಯಾ ಲೈ ಕಾಮಾಕ್ನಿ ಮೊಟ್ಯಾ ದೆವಾಚಿ ಸ್ತುತಿ ಕರ್ತಾ.</para>
  <para style="iot">ಭಾಗಾ</para>
  <para style="io1">1. ಹಬಕುಕ್ಕಾಚಿ ಪಯ್ಲೆಚಿ ಫಿರ್‍ಯಾದ್ <char style="ior"><ref loc="HAB 1:1-4">1:1-4</ref> </char></para>
  <para style="io1">2. ದೆವಾಚೊ ಪಯ್ಲೊ ಜವಾಬ್ <char style="ior"><ref loc="HAB 1:5-11">1:5-11</ref> </char></para>
  <para style="io1">3. ಹಬಕುಕ್ಕಾಚಿ ದೊನ್ವೆಚಿ ಫಿರ್‍ಯಾದ್ <char style="ior"><ref loc="HAB 1:12-2:1">1:12—2:1</ref> </char></para>
  <para style="io1">4. ದೆವಾಚೊ ದೊನ್ವೆಚೊ ಜವಾಬ್ <char style="ior"><ref loc="HAB 2:2-20">2:2-20</ref> </char></para>
  <para style="io1">5. ಹಬಕುಕ್ಕಾಚಿ ಮಾಗ್ನಿ <char style="ior"><ref loc="HAB 3">3</ref> </char></para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />ಹಬಕ್ಕುಕ್ ಪರ್‍ವಾದ್ಯಾಕ್ ಗಾವಲ್ಲೆ ಸರ್ವೆಸ್ಪರಾಚೆ ದರ್ಶನ್.<verse eid="HAB 1:1" /></para>
  <para style="s">ಅನ್ಯೊವಾಚ್ಯಾ ವಿಶಯಾತ್ ಹಬಕ್ಕುಕಾಚಿ ಫಿರ್‍ಯಾದ್</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 1:2" />ಸರ್ವೆಸ್ಪರಾ, ಮಿಯಾ ಕವ್ಡ್ಯಾ ಪತರ್ ಮಜ್ಜತಿ ಸಾಟ್ನಿ ಮಾಗುಚೆ, ತಿಯಾ ಕಶ್ಯಾಕ್ ಆಯ್ಕಿ ನಾ ಹೊಲೆಯ್? ತರಾಸ್ ಮನುನ್ ತುಜ್ಯಾಕ್ಡೆಬಿ ಬೊಬ್ ಮಾರುನ್ ಘೆಟ್ಲ್ಯಾರ್ಬಿ ರಾಕ್ವನ್ ಕರಿ ನಸ್ತಾನಾ ರಾತೈ. <verse eid="HAB 1:2" /><verse number="3" style="v" sid="HAB 1:3" />ಬುರ್ಸೆಪಾನ್ ಮಾಜ್ಯಾ ಡೊಳ್ಯಾಕುಚ್ ದಿಸಿ ಸಾರ್ಕೆ ಕಶ್ಯಾಕ್ ಕರ್ತಯ್? ಕಶ್ಟ್ ಕಶ್ಯಾಕ್ ಮಾಕಾ ದಾಕ್ವುಲಾಗಲ್ಲೆ? ತರಾಸ್ ಕಸ್ಟಾ ಮಾಜ್ಯಾ ಡೊಳ್ಯಾಚ್ಯಾ ಇದ್ರಾಕ್ ಹಾತುಚ್ ಹಾತ್; ತಂಟೆ ಹೊವ್ಲಾತ್ ಝಗ್ಡೆ ಉಟುಲ್ಲಾತ್. <verse eid="HAB 1:3" /><verse number="4" style="v" sid="HAB 1:4" />ಅಸೆ ರ್‍ಹಾತಾನಾ ನ್ಯಾಯಾಚಿ ಝಡ್ತಿ ಕರುನ್ ಹೊತಾ, ನ್ಯಾಯ್ ಕನ್ನಾಬಿ ಸೊಡಿನಾ. ಬುರ್ಶಿ ಲೊಕಾ ಬರ್ಯಾ ಲೊಕಾಕ್ನಿ ತಾಬೆತ್ ಕರುನ್ ಘೆಟ್ಲಾ. ತೆಚ್ಯಾ ಸಾಟ್ನಿ ಚುಕೆಚಿ ಝಡ್ತಿ ಬಾರ್ಯ್ ಯೆತಾ.<verse eid="HAB 1:4" /></para>
  <para style="s">ಸರ್ವೆಸ್ಪರಾಚೆ ಜಾಬ್</para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 1:5" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರ್ ಅಪ್ನಾಚ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ಮದ್ದಿ ಚಲ್ತಲೆ ನದರ್ ಲಾವ್ನ್ ಬಗಾ. ಅಜಿಬ್ ಹೊತ್ಯಾಸಿ! ತುಮ್ಚ್ಯಾ ಎಳಾರ್ ಮಿಯಾ ಎಕ್ ಕಾಮ್ ಕರ್ತಾ, ತೆ ತುಮ್ಕಾ ಕಳ್ವುನ್ ಸಾಂಗ್ಲ್ಯಾರ್ಬಿ ತುಮಿ ತೆ ವಿಶ್ವಾಸ್ ಕರಿನ್ಯಾಸಿ. <verse eid="HAB 1:5" /><verse number="6" style="v" sid="HAB 1:6" />ಅಬಕ್, ಭಯಂಕರ್ ಅನಿ ಆರ್ಮುಟ್ ಕಸ್ದಿಯಾ ಲೊಕಾಕ್ನಿ ಉಟ್ವುತಾ. ತೆನಿ ಅಪ್ನಾಚೆ ನ್ಹಯ್ ಹೊಲ್ಲೆ ಜಾಗೆ ಸಗ್ಳೆ ತೆಂಚ್ಯಾ ತಾಬೆತ್ ಕರುನ್ ಘೆವ್ನ್ ಸಗ್ಳ್ಯಾ ಜಗಾತ್ ಫಿರುನ್ ಖೆಳ್ತಾತ್. <verse eid="HAB 1:6" /><verse number="7" style="v" sid="HAB 1:7" />ತೆನಿ ಕ್ರುರ್, ಭಯಂಕರ್ ಲೊಕಾ; ಅಪ್ನಾಕುಚ್ ಅಪ್ನಿ ಮಾನ್ ಕರುನ್ ಘೆತಾತ್, ಮೊಟೆ ಪಾನ್ ದಾಕ್ವುತಲಿ ಲೊಕಾ.<verse eid="HAB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HAB 1:8" />ತೆಂಚೆ ಘೊಡ್ಕೆ ಕಿರ್ಬಾಟಾಂಚ್ಯಾ ಕಿಂತಾ ಭಿರುಸ್, ಝುಲ್ ಕುತ್ರ್ಯಾಂಚ್ಯಾನ್ಕಿ ಚುರುಕ್, ತೆಂಚೆ ಘೊಡ್ಕೆ ಚಾಲ್ವುನಾರೆ ಲೈ ಹುಡುನ್ ಯೆತಾತ್, ಶಿಕಾರಿಕ್ ಖಾವ್ಕ್ ಲೈ ಗಡ್ಬಡಿನ್ ಹುಡುನ್ ಯೆತಲ್ಯಾ ಘಾರಿಚ್ಯಾ ಗತಿನ್ ಹುಡುನ್ ಯೆತಾತ್.<verse eid="HAB 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HAB 1:9" />ತೆನಿ ತರಾಸ್ ದಿವ್ಚೆ ಮನುನ್ ಗುಸುನ್ ಫಿಡೆ ಯೆತಾತ್, ರೆತಿ ಸಾರ್ಕೆ ಮೆಜುಕ್ ಹೊಯ್ನಾ ತವ್ಡ್ಯಾ ಲೊಕಾಕ್ನಿ ಬಂಧಿ ಕರ್‍ತಾತ್. <verse eid="HAB 1:9" /><verse number="10" style="v" sid="HAB 1:10" />ತೆನಿ ರಾಜಾಕ್ನಿ ದಿಕ್ಕಾರ್ ಕರುನ್ ಎಡ್ಸಡ್ತಾತ್, ಅಧಿಕಾರಿಯಾ ತೆಂಚ್ಯಾ ಎಡ್ಸಡ್ತಲ್ಯಾಕ್ ಗುರಿ ಹೊತಾತ್. ಎಕೆಕ್ ಖಿಲ್ಲ್ಯಾಕ್ನಿ ಬಂಧಿ ಕರುನ್ ಧುಳಿಚ್ಯಾ ಸಾರ್ಕೆ ಹುಡ್ವುನ್ ಟಾಕ್ತಾತ್. <verse eid="HAB 1:10" /><verse number="11" style="v" sid="HAB 1:11" />ವ್ಹಾರೆ ವಾದಾಳಾ ಸಾರ್ಕೆ ನಾಪತ್ತೊ ಹೊತಾತ್; ಅಪ್ನಾಚಿ ತಾಕತುಚ್ ದೆವ್ ಮನ್ತಲೆ ಅಪ್ವಾದಿ ತೆನಿ.<verse eid="HAB 1:11" /></para>
  <para style="s">ಹಬಕ್ಕುಕ್ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ ಅನಿ ಪರ್‍ತುನ್ ಫಿರ್‍ಯಾದ್ ಸಾಂಗ್ತಲೆ</para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 1:12" />ಸರ್ವೆಸ್ಪರ್ ಮಾಜ್ಯಾ ದೆವಾ, ಮಾಜ್ಯಾ ನಿತಳ್ಲ್ಯಾ ದೆವಾ, ತಿಯಾ ಕನ್ನಾಬಿ ಝಿತ್ತೊ ರ್‍ಹಾತೆ, ಹೊಯ್ ಸರ್ವೆಸ್ಪರಾ, ತಿಯಾ ತೆಂಕಾ ಶಿಕ್ಷ್ಯಾ ದಿಯ್ ಸಾರ್ಕೆ ನೆಮ್ಲೆ, ತಿಯಾ ಮಾಜೊ ಖಡಾಪ್. ಸರ್ವೆಸ್ಪರಾ, ಅಮ್ಚ್ಯಾ ನ್ಯಾಯ್ ಕರ್‍ತಲ್ಯಾ ಝಡ್ತಿತ್ ತೆಂಕಾ ನೆಮಸ್ಲೆ. <verse eid="HAB 1:12" /><verse number="13" style="v" sid="HAB 1:13" />ಬುರ್ಸೆ ಬಗಿನಸಲ್ಲ್ಯಾ ತವ್ಡೆ ಚುಕ್ ನಸಲ್ಲೆ ತುಜೆ ಡೊಳೆ, ಬುರ್ಸೆ ಪಾನ್ ಸೊಸುಕ್ ಹೊಯ್ ನಸಲ್ಲೊ ತವ್ಡೊ ನಿತಳ್ ತಿಯಾ.ಅಸೆ ರಾತಾನಾ ಬುರ್ಸ್ಯಾ ಮಾನ್ಸಾಕ್ ಬಗುನ್ ಕಶ್ಯಾಕ್ ಗಪ್ ಹಾಸ್? ಅಪ್ನಾಚ್ಯಾನ್ಕಿ ಬರ್‍ಯಾಕ್ನಿ ಲೈ ಬುರ್ಶಿ ಲೊಕಾ ಗಿಳಿ ಪತರ್ ತಿಯಾ ಕಶ್ಯಾಕ್ ಗಪ್ ರ್‍ಹಾತೆ?<verse eid="HAB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HAB 1:14" />ಮಾನ್ಸಾಕ್ನಿ ಸಮುಂದರಾಚ್ಯಾ ಮಾಸೊಳ್ಯಾಂಚ್ಯಾ ಸ್ಥಿತಿಕ್ ಕಶ್ಯಾಕ್ ಹಾನ್ಲೆ, ರಾಜ್ವಟ್ಕಿಕಾರ್ ನಸಲ್ಲ್ಯಾ ಕಿಡ್ಯಾಂಚ್ಯಾ ಗತಿಕ್ ಕಶ್ಯಾಕ್ ಹಾನ್ಲೆ. <verse eid="HAB 1:14" /><verse number="15" style="v" sid="HAB 1:15" />ಆಹಾ, ತೆಂಕಾ ಸಗ್ಳೆ ಅಪ್ನಾಚ್ಯಾ ಗರಿತ್ನಾ ವರ್‍ತಿ ವಡ್ತಾ, ತೆಚ್ಯಾ ಜಾಳ್ಯಾತ್ನಾ ಧರ್‍ತಾ, ಅನಿ ತೆಂಕಾ ಗೊಳಾ ಕರ್ತಾ;ಅನಿ ತೆನಿ ಲೈ ಖುಸಿ ಹೊತಾತ್. <verse eid="HAB 1:15" /><verse number="16" style="v" sid="HAB 1:16" />ತೆಂಚ್ಯಾ ಜಾಳ್ಯಾಕ್ ಬಲಿ ದಿತಾತ್, ಧುಪ್ ಘಾಲ್ತಾತ್; ತೆಚ್ಯಾ ವೈಯ್ ತೆಂಚಿ ಜಿವನ್ ಘಟ್, ತೆಂಚೆ ಜೆವಾನ್ ಸಾವ್ಕಾರ್ಕಿಚೆ.<verse eid="HAB 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HAB 1:17" />ಅಸೆ ರ್‍ಹಾತಾನಾ, ತೆನಿ ಅಪ್ನಾಚ್ಯಾ ಜಾಳೆ ಕನ್ನಾಬಿ ಸಾರಿನಸ್ತಾನಾ, ದಯಾ ನಸ್ತಾನಾ ದೆಸಾಕ್ನಿ ಸದ್ದಾಬಿ ಜಿವ್ ಕಾಡಿತ್ ರ್‍ಹಾವ್ಚೆ ಕಾಯ್?<verse eid="HAB 1:17" /></para>
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="s">ಹಬಕ್ಕುಕಾಕ್ ಸರ್ವೆಸ್ಪರಾಚೆ ಜವಾಬ್</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 2:1" />ಮಾಜ್ಯಾ ರಾಕ್ತಲ್ಯಾ ಜಾಗ್ಯಾರ್ ಇಬೆ ರ್‍ಹಾತಾ, ಖಿಲ್ಲ್ಯಾಚ್ಯಾ ವರ್‍ತಿ ವಸ್ತಿ ರ್‍ಹಾತಾ, ಸರ್ವೆಸ್ಪರ್ ಮಾಕಾ ಕಾಯ್ ಸಾಂಗ್ತಾ, ಕಾಯ್ ಜವಾಬ್ ದಿವ್ಚೆ ಮನುನ್ ರಾಕುನ್ಗೆತ್ ರ್‍ಹಾತಾ. <verse eid="HAB 2:1" /><verse number="2" style="v" sid="HAB 2:2" />ತನ್ನಾ ಸರ್ವೆಸ್ಪರಾನ್ ಮಾಕಾ ದಿಲ್ಲೊ ಜವಾಬ್ ಹ್ಯೊ; ತುಕಾ ದಿಸಲ್ಲಿ ದರ್ಶನಾ ಲಿವ್; ವಾಚುಕ್ ಸಸಾರ್ ಹೊಯ್ ಸಾರ್ಕೆ ಫಳಿಚ್ಯಾ ವರ್‍ತಿ ಲಿವ್. <verse eid="HAB 2:2" /><verse number="3" style="v" sid="HAB 2:3" />ತೆ ಸಮಾ ಎಳಾರ್ ತಿ ದರ್ಶನಾ ಘಡ್ತಾತ್, ತೆಚೆ ಆಕ್ರಿಚೆ ಪರಿನಾಮ್ ಲಗ್ಗುನಾಚ್ ಗೊತ್ತ್ ಹೊತಾ, ತಡೊ ಹೊಲ್ಯಾರ್ಬಿ ರಾಕುನ್ ರಾ; ಪಸ್ವಿನಾ, ತೆ ಖರೆಚ್ ಹೊತಾ, ತಡೊ ಹೊಯ್ನಾ. <verse eid="HAB 2:3" /><verse number="4" style="v" sid="HAB 2:4" />ಅಬಕ್, ವಿರೊಧಿ ಬಡಾಯ್ ಕರುಕ್ ಲಾಗ್ಲಾ, ತೆಚಿ ಆಶ್ಯಾ ಸಮಾ ನ್ಹಯ್, ಖರೆ ಬರೊ ಮಾನುಸ್ ಅಪ್ನಾಚ್ಯಾ ನಿತಿಚ್ಯಾ ವೈನಾ ಝಿತ್ತೊ ರ್‍ಹಾತಾ.<verse eid="HAB 2:4" /></para>
  <para style="s">ಬುರ್ಸ್ಯಾಕ್ನಿ ಹೊತಲೊ ತರಾಸ್</para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 2:5" />“ಸಾವ್ಕಾರ್ಕಿಪಾನ್ ತೆಕಾ ಘಾತ್ ಕರ್ತಾ, ತೊ ನಿಶ್ಯಾ ಚಡಲ್ಲೊ ಸಾರ್ಕೊ ಹೊವ್ನ್ ಎಕ್ಡೆ ಇಬೆ ರ್‍ಹಾಯ್ನಾ, ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್, ತೆನಿ ಅಪ್ನಾಚಿ ಆಶ್ಯಾ ಪಾತಾಳಾಚ್ಯಾ ಗತಿನ್ ಲೈ ಕರುನ್ಗೆಟ್ಲಾ, ತೆನಿ ದೆಸಾಕ್ನಿ ಅಪ್ನಾಚ್ಯಾ ಸಾಟ್ನಿ ಗೊಳಾ ಕರುನ್ಗೆತಾ, ಅನಿ ಸಗ್ಳ್ಯಾ ಲೊಕಾಕ್ನಿ ಬಂಧಿ ಕರ್ತಾ.” <verse eid="HAB 2:5" /><verse number="6" style="v" sid="HAB 2:6" />ತೆಜ್ಯಾ ಪಾಶಾಕ್ ಗಾವ್ನ್ ಪಡಲ್ಲೆ ಸಗ್ಳೆ ತೆಕಾ ಹೆಡ್ಸಡುನ್ ಗಿತಾ ಗಾವ್ತಾತ್, ದುಶ್ರ್ಯಾಂಚಿ ವಸ್ತಾ ಕಾಡುನ್ಗೆವ್ನ್ ಸಾವ್ಕಾರ್ ಹೊಲ್ಲ್ಯಾಚಿ ಗತ್ ಕಾಯ್ ಸಾಂಗು, ತೊ ಅನಿ ಕವ್ಡೊ ಎಳ್ ಅಸೊ ಕರ್ತಿಲ್?<verse eid="HAB 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HAB 2:7" />ತುಜಿ ರಿನ್ ಕಾರಾ ತುಜ್ಯಾ ಇದ್ರಾಕ್ ಇಬೆ ರ್‍ಹಾತಾತ್, ತಿಯಾ ಬಾಕಿ ದಿತಲಿ ಹೊತ್ತಿ ಲೊಕಾ ತುಕಾ ಪರ್‍ತುನ್ ಪಡಿನಾತ್ ಕಾಯ್? ತನ್ನಾ ತೆನಿ ತುಕಾ ಚೊರುನ್ ಲುಟ್ತಾತ್. <verse eid="HAB 2:7" /><verse number="8" style="v" sid="HAB 2:8" />ಕಶ್ಯಾಕ್ ಮಟ್ಲ್ಯಾರ್ ತಿಯಾ ಲೈ ಲೊಕಾಕ್ನಿ ಲುಟ್ಲೆ, ತೆಂಚೆ ರಗಾತ್ ವೊತ್ಲೆ, ಗಾವಾ, ಶಾರಾ, ಅನಿ ತ್ಯಾತುರ್ಲ್ಯಾ ದೆಸಾಕ್ನಿ ತರಾಸ್ ದಿಲೆಯ್.<verse eid="HAB 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HAB 2:9" />ತ್ಯಾ ತರಾಸಾತ್ನಾ ಚುಕ್ವುನ್ ಘೆವ್ಕ್ ಸಾಟ್ನಿ ತುಜೆ ಘರ್ ಲೈ ಉಪ್ಪರ್ಲ್ಯಾ ಜಾಗ್ಯಾ ವರ್‍ತಿ ಬಾಂದುನ್ಗೆಟ್ಲೆ, ತುಜ್ಯಾ ಕುಟ್ಮಾಸಾಟ್ನಿ ದುಶ್ರ್ಯಾಂಚಿ ಆಸ್ತಿ ಚೊರಲ್ಲ್ಯಾ, ತುಜಿ ಗತ್ ಕಾಯ್ ಸಾಂಗು! <verse eid="HAB 2:9" /><verse number="10" style="v" sid="HAB 2:10" />ತುಜ್ಯಾ ಯೆವ್ಜನಿಯಾಂಚ್ಯಾ ವಯ್ನಾ ತುಜ್ಯಾ ಘರಾನಾಕ್ ಅವ್ಮಾನ್ ಹಾನುನ್ಗೆಟ್ಲೆಯ್, ಲೈ ಗಾಂವಾಕ್ನಿ ನಾಶ್ ಕರುನ್, ತುಜ್ಯಾ ಪಿಳ್ಗಿಕ್ ನಾಶ್ ಹಾನುನ್ಗೆಟ್ಲೆಯ್. <verse eid="HAB 2:10" /><verse number="11" style="v" sid="HAB 2:11" />ಭಿತ್ತಿತ್ನಾ ಗುಂಡೆ ತುಜ್ಯಾ ವರ್‍ತಿ ಚುಕ್ ವಾವುನ್ ಬೊಬ್ ಮಾರ್‍ತಾತ್, ನಾಕ್ಡಾಚಿ ವಸ್ತಾ ಪರ್‍ತುನ್ ಧನ್ ಕರ್‍ತಾತ್.<verse eid="HAB 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HAB 2:12" />ಮಾನ್ಸಾಚೊ ಜಿವ್ ಕಾಡುನ್ ಶಾರಾ ಭಾಂದುನ್ ಘೆಟಲ್ಲ್ಯಾ, ಅನ್ಯಾಯಾಚ್ಯಾ ಪಾಯಾವರ್‍ತಿ ಶಾರ್ ಭಾಂದ್ತಲ್ಯಾಚಿ ಗತ್ ಕಾಯ್ ಸಾಂಗು! <verse eid="HAB 2:12" /><verse number="13" style="v" sid="HAB 2:13" />ಲೊಕಾಂಚೆ ಘೊಳಾಪ್ ಆಗಿಚೊ ವಾಟೊ, ಅನಿ ಮಾನ್ಸಾಂಚೆ ತರಾಸ್ ವ್ಯರ್ಥ್, ಹೆ ಸಗ್ಳೆ ಮಹೊನ್ನತ್ ಸರ್ವೆಸ್ಪರಾಚಿ ಇಚ್ಚಾ ನ್ಹಯ್ ಕಾಯ್? <verse eid="HAB 2:13" /><verse number="14" style="v" sid="HAB 2:14" />ಸಮುಂದರ್ ಪಾನಿಯಾನ್ ಭರುನ್ ಹೊತ್ತ್ಯಾ ಸಾರ್ಕೆ, ಜಿಮಿನ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಮಹಿಮಾಚ್ಯಾ ಜ್ಞಾನಾನ್ ಭರುನ್ ರ್‍ಹಾತಾ.<verse eid="HAB 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HAB 2:15" />ತುಜೊ ರಾಗ್ ವಾಯ್ನಾರ್ ಘಾಲುನ್, ತುಜ್ಯಾ ಸೆಜಾರಾಕ್ ನಿಶೆಡಿ ಕರುನ್, ತೆಂಚೆ ನಾಗ್ಡೆಪಾನ್ ಬಗುಚೆ ಮನುನ್ ಹೊತ್ತ್ಯಾ ತುಜಿ ಗತ್ ಕಾಯ್ ಸಾಂಗು! <verse eid="HAB 2:15" /><verse number="16" style="v" sid="HAB 2:16" />ತಿಯಾ ಮರ್ಯಾದಿಚೊ ನ್ಹಯ್, ಅವ್ಮಾನಾನ್ ಭರುನ್ ಹಾಸ್, ತಿಯಾ ಫಿವ್ ಫಿವ್ನ್ ನಾಗ್ಡೊ ಹೊ, ಮಹೊನ್ನತ್ ಸರ್ವೆಸ್ಪರಾಚ್ಯಾ ಉಜ್ವೊ ಹಾತಿತ್ಲೊ ರಾಗಾಚೊ ಬಿಂದ್ಗೊ ತುಜ್ಯಾ ವಾಟ್ಯಾಕ್ ಹಾಯ್, ಅವ್ಮಾನುಚ್ ತುಜ್ಯಾ ಮರ್ಯಾದಿಕ್ ಧಾಪುನ್ ರ್‍ಹಾತಾ. <verse eid="HAB 2:16" /><verse number="17" style="v" sid="HAB 2:17" />ತಿಯಾ ಮಾನ್ಸಾಂಚೆ ರಗಾತ್ ಪಾಡ್ವುಲೆ, ದೆಶ್, ಶಾರ್, ಅನಿ ತ್ಯಾತುರ್ ವಸ್ತಿ ರ್‍ಹಾತಲ್ಯಾ ಸಗ್ಳ್ಯಾಕ್ನಿ ತರಾಸ್ ದಿಲೆಯ್, ಲೆಬೊನಾಚ್ಯಾ ಡಂಗ್ಳಿಯಾಕ್ನಿ ತೊಡ್ಲೆಯ್, ಅತ್ತಾ ತುಕಾಚ್ ತೊಡುನ್ ಹೊತಾ, ತೆಜ್ಯಾ ಕ್ರುರ್ ಜನಾವರಾಕ್ನಿ ನಾಶ್ ಕರ್‍ಲೆಯ್ ಆತ್ತಾ ತಿ ತುಕಾಚ್ ಭಯಾನಕ್ ಹೊವ್ನ್ ಹಾತ್.<verse eid="HAB 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HAB 2:18" />ಕೊರದಲ್ಲ್ಯಾ ಮುರ್ತಿಯಾನಿ ಕಾಯ್ ಫಾಯ್ದೊ? ತೆ ಮಾನ್ಸಾಚೆ ಕಾಮ್, ಝುಟೆ ಭವಿಶ್ಯ್ ಸಾಂಗುಕ್ ಸಾಟ್ನಿ ಥವ್ನ್ ಘೆಟಲ್ಲಿ ಮುರ್ತಿಯಾ, ತೆ ರಚಲ್ಲ್ಯಾ ಮಾನ್ಸಾಕ್ ತೆ ಕಾಯ್ ಬರೆಪಾನ್ ಹಾನ್ತಾ? ತಿ ಬೊಲಿ ನಸಲ್ಲಿ ಮುಕ್ಕಿ ಗೊಂಬಿಚ್. <verse eid="HAB 2:18" /><verse number="19" style="v" sid="HAB 2:19" />ಝಾಡಾಂಚ್ಯಾ ತುಕ್ಡ್ಯಾಕ್ನಿ ಧ್ಯಾನ್ ದಿ, ಜಿವ್ ನಸಲ್ಲ್ಯಾ ಗುಂಡ್ಯಾಕ್ ಉಟ್, ಮನುನ್ ಹುಕುಮ್ ದಿನಾರೊ ಖರೆಚ್ಬಿ ಅಕ್ಕಲ್ ಗೆಡಿ, ಗೊಂಬಿಯಾ ಶಿಕಾಪ್ ಕರ್‍ತಾತ್ ಕಾಯ್? ಸೊನೆ ಚಾಂದಿ ತೆಕಾ ನೆಸ್ವುತಲೆ ಖರೆ ಹಾಯ್, ಖರೆ ತೆಕಾ ಉಸಿಲುಚ್ ನಾ.<verse eid="HAB 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HAB 2:20" />ಖರೆ, ಸರ್ವೆಸ್ಪರ್ ಅಪ್ನಾಚ್ಯಾ ಪರಿಶುದ್ದ್ ಗುಡಿತ್ ಹಾಯ್; ಜಿಮಿನ್ ಸಗ್ಳಿ ತೆಚ್ಯಾ ಇದ್ರಾಕ್ ಗಪ್ ರ್‍ಹಾಂವ್ದಿತ್.<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s">ಹಬಕ್ಕುಕಾಚಿ ಮಾಗ್ನಿ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1" />ಹಿ ಹಬಕ್ಕುಕ್ ಪರ್ವಾದ್ಯಾಚಿ ಮಾಗ್ನಿ.<verse eid="HAB 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2" />ಸರ್ವೆಸ್ಪರಾ, ತುಜ್ಯಾ ಕಾಮಾಂಚ್ಯಾ ವಿಶಯಾತ್ ಮಿಯಾ ಲೈ ಆಯಿಕ್ಲೊ,</para>
  <para style="q2" vid="HAB 3:2">ಮಿಯಾ ತುಜ್ಯಾ ಭಿಂಯ್ಯಾತ್ ಇಬೆ ಹಾಂವ್,</para>
  <para style="q1" vid="HAB 3:2">ಅನಿ ಪರ್‍ತುನ್ ಕರ್ ಅಮ್ಚ್ಯಾ ಕಾಳಾತ್ ತೆ ಸಗ್ಳೆ.</para>
  <para style="q2" vid="HAB 3:2">ಪಯ್ಲೆ ಕರಲ್ಲೆ ಕಾಮ್ ಜಗಾಚ್ಯಾ ಮದ್ದಿ ತುಜೆ ರಾಕ್ವನಿಚೆ ಕಾಮ್ ಜಗಾಚ್ಯಾ ಮದ್ದಿ ತೆ ಮ್ಹಾಳಾಕ್ ಹಾನ್;</para>
  <para style="q1" vid="HAB 3:2">ರಾಗ್ ಹೊಲ್ಯಾರ್ಬಿ ಇಸ್ರುನಕ್ಕೊ ದಯಾ ಕರ್‍ತಲೆ .<verse eid="HAB 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3" />ಸರ್ವೆಸ್ಪರ್ ತೆಮಾನಿಕ್ನಾ ಯೆಲೊ,</para>
  <para style="q2" vid="HAB 3:3">ಪವಿತ್ರ್ ಸರ್ವೆಸ್ಪರ್ ಪಾರಾನ್ ಮಡ್ಡಿ ವಯ್ನಾ;</para>
  <para style="q1" vid="HAB 3:3">ತೆಚಿ ಮಹಿಮಾ ಮಳ್ಬಾಚ್ಯಾ ವರ್‍ತಿ ಪಗ್ಳುಲಾಗ್ಲಾ,</para>
  <para style="q2" vid="HAB 3:3">ಭರ್ಲಾ ತೆಜ್ಯಾ ಮಹಿಮಾನ್ ಜಿಮ್ನಿ ವರ್‍ತಿ.<verse eid="HAB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4" />ತೆಚ್ಯಾ ಹಾತಾನಿತ್ನಾ ಉಜ್ವೊಡಾಚಿ ಕಿರ್ನಾ ಭಾಯ್ರ್ ಪಡ್ತಾತ್,</para>
  <para style="q2" vid="HAB 3:4">ನಿಪುನ್ ಹಾಯ್ ಥೈಚ್ ತೆಚಿ ಬಳ್.<verse eid="HAB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5" />ದುಕ್ನೆ ತೆಜ್ಯಾ ಫಿಡೆ, ಫಿಡೆ ಜಾತಾ,</para>
  <para style="q2" vid="HAB 3:5">ಪಿಡಾ ತೆಚ್ಯಾ ಪಾಟ್ನಾ-ಪಾಟ್ನಾ ಯೆತಾ.<verse eid="HAB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6" />ಹಾದರ್ತಾ ಜಿಮಿನ್ ತೊ ಇಬೆ ರ್‍ಹಾತಾನಾ,</para>
  <para style="q2" vid="HAB 3:6">ಖಾಪ್ತಾ ಜಿಮಿನ್ ತೆನಿ ದಿಸ್ಟ್ ಲಾವ್ತಾನಾ,</para>
  <para style="q1" vid="HAB 3:6">ಚಿರುನ್ ಜಾತಾತ್ ಜುನ್ನಿ ಮಡ್ಡಿಯಾ,</para>
  <para style="q2" vid="HAB 3:6">ಕೊಸ್ಳು ಪಡ್ತಾತ್ ಜುನ್ನಿ ಡೊಂಗ್ರಾ,</para>
  <para style="q2" vid="HAB 3:6">ಪಯ್ಲೆಚ್ಯಾನ್ಬಿ ತೆಚೆ ಯೆನೆ ತಸೆಚ್.<verse eid="HAB 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7" />ಮಾಕಾ ಅಸೆ ದಿಸ್ಲೆ,</para>
  <para style="q2" vid="HAB 3:7">ಅಬಕ್, ಕುಶಾನಿಚಿ ಝೊಪ್ಡಿಯಾ ತಳ್ಮಳುಲ್ಲಾತ್, ಥರ್ಥರುಲ್ಲಾತ್ ಮಿದ್ಯಾನ್ ದೆಶಾಚೆ ಬಿರಾಡಾ.<verse eid="HAB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8" />ತುಜ್ಯಾ ಜಿಕೆಚ್ಯಾ ರಥಾಂಚ್ಯಾ ವರ್‍ತಿ ತುಜ್ಯಾ ಘೊಡ್ಕಿಯಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಸವಾರ್ ಕರುನ್ ತಿಯಾ ಯೆತಾನಾ ನ್ಹಯ್ಚ್ಯಾ ವಿರೊಧ್ ರಾಗ್ ನಾತರ್ ಸಮುಂದರಾಚ್ಯಾ ವಿರೊಧ್ ರಾಗ್ ಕಾಯ್?</para>
  <para style="q2" vid="HAB 3:8">ತುಕಾ ನ್ಹಯ್ಯಾಂಚ್ಯಾ ವರ್‍ತಿ ರಾಗ್ ಕಾಯ್ ಒ ಸರ್ವೆಸ್ಪರಾ?<verse eid="HAB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9" />ಕಾಡ್ಲೆ ಬಿಲ್ಲ್ ಬಾವ್ಳ್ಯಾತ್ನಾ,</para>
  <para style="q2" vid="HAB 3:9">ಸೊಡ್ಲೆ ಬಾನಾ ತ್ಯಾತುರ್‍ನಾ,</para>
  <para style="q2" vid="HAB 3:9">ಚಿರ್ಲೆ ಜಿಮಿನ್ ನ್ಹಯಾಂಚ್ಯಾ ವಯ್ನಾ,<verse eid="HAB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 3:10" />ತುಕಾ ಬಗುನ್ ಡೊಂಗ್ರಾ ತಳ್ಮಳೊ,</para>
  <para style="q2" vid="HAB 3:10">ಮಳ್ಬಾಕ್ನಾ ಹೊಂವ್ತಾ ಮೊಟೊ ಹೊಂವಾರೊ,</para>
  <para style="q1" vid="HAB 3:10">ಲಾಟಾ ವಯ್ರ್ ಉಟಿ ಸಾರ್ಕೆ ಕರ್ತಾ ದರ್ಯೊ.<verse eid="HAB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11" />ಹುಡುನ್ ಪಳ್ತಲ್ಯಾ ತುಜ್ಯಾ ಬಾನಾಂಚ್ಯಾ ಉಜ್ವೊಡಾಕ್,</para>
  <para style="q2" vid="HAB 3:11">ಹೊಳಾವ್ತಲ್ಯಾ ತುಜ್ಯಾ ಭರ್ಚಿಯಾಂಚ್ಯಾ ಲಕ್ಲಕ್ಯಾಕ್,</para>
  <para style="q2" vid="HAB 3:11">ದಿಸ್ ಅನಿ ಚಂದಾಮ್ ನಿಪ್ತಾತ್ ಗುಡಾತ್ .<verse eid="HAB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12" />ಜಿಮಿನ್ ತಿಯಾ ದಾಟುನ್ ಜಾತೆ ಆರ್ಭಾಟಾನ್,</para>
  <para style="q2" vid="HAB 3:12">ದೆಸಾಕ್ನಿ ತಿಯಾ ತುಡ್ವುತೆಯ್ ಮೊಟ್ಯಾ ರಾಗಾನ್.<verse eid="HAB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13" />ಜಾವ್ಕ್ ಲಾಗ್ಲೆ ತುಜ್ಯಾ ಲೊಕಾಂಚ್ಯಾ ರಾಕ್ವನಿಕ್ ಸಾಟ್ನಿ,</para>
  <para style="q2" vid="HAB 3:13">ತುಜ್ಯಾ ಅಭಿಶಿಕ್ತಾಚೊ ಜಿವಾಚ್ಯಾ ರಾಕ್ವನಿಕ್,</para>
  <para style="q2" vid="HAB 3:13">ಫೊಡುನ್ ಟಾಕ್ಲೆ ಬುರ್ಶಾಪಾನಾಚ್ಯಾ ವಡಿಲಾಚೆ ಟಕ್ಲೆ,</para>
  <para style="q2" vid="HAB 3:13">ತೆಕಾ ಉಪ್ಳುನ್ ಕಾಡ್ಲೆ ತೆಚೆ ಘರ್ ಮುಳಾತ್ನಾ.<verse eid="HAB 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14" />ಖಾಯ್ಬಿ ನತ್ತ್ಯಾ ಮಾನ್ಸಾಕ್ನಿ ಘುಟ್ಟಾನ್ ಗಿಳುಕ್ ಲಾವ್ನ್ ಲೈ ಹೊಯ್ ಸಾರ್ಕೆ ಕರುನ್</para>
  <para style="q2" vid="HAB 3:14">ಮಾಕಾ ಪಗ್ಳುಕ್ ಯೆಲಿ ತೆಚಿ ಸಯ್ನಿಕಾ ವ್ಹಾರೆ ವಾದಾಳಾ ಸಾರ್ಕೆ, ತೆಜ್ಯಾ ಹಾತಿಯಾರಾನಿಚ್ ತೆಚೆ ಟಕ್ಲೆ ತಿಯಾ ಫೊಡ್ಲೆ.<verse eid="HAB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15" />ಘೊಡ್ಯಾ ವೈನಿ ಚಡುನ್ ತಿಯಾ ಸಮುಂದರ್ ದಾಟ್ಲೆಯ್,</para>
  <para style="q2" vid="HAB 3:15">ಬುರಕ್ ಉಟ್ತಲ್ಯಾ ಪಾನಿಯಾಚ್ಯಾ ರಾಶಿಕ್ನಾ ದಾಟುನ್ ಗೆಲೆಯ್.<verse eid="HAB 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16" />ಹೆ ಆಯ್ಕುನ್ ಖಾಪ್ಲೊ ಮಾಜೊ ಹೊಟ್ಟೊ,</para>
  <para style="q2" vid="HAB 3:16">ಹಾದರ್ಲಿ ತ್ಯಾ ಆವಾಜಾಕ್ ಮಾಜಿ ಹೊಟ್ಟಾ,</para>
  <para style="q2" vid="HAB 3:16">ಕುಸಲ್ಲ್ಯಾ ಗತಿನ್ ಹೊಲಿ ಮಾಜಿ ಹಡ್ಡಾ,</para>
  <para style="q2" vid="HAB 3:16">ಇಬೆ ಹೊತ್ತ್ಯಾಕ್ಡೆಚ್ ಥರ್ತಲಿ ಮಾಜಿ ಪಾಂಯಾ,</para>
  <para style="q2" vid="HAB 3:16">ತರಾಸ್ ಯೆವ್ನ್ ಪಾವ್ತಾ ಮಾಕಾ ಘೆರೊ ಘಾಲ್ತಲ್ಯಾಕ್ನಿ,</para>
  <para style="q2" vid="HAB 3:16">ರಾಕುನ್ ರ್‍ಹಾತಾ ಮಿಯಾ ಥಂಡ್ ಮನಾನ್ ತ್ಯಾ ದಿಸಾ ಪತರ್.<verse eid="HAB 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17" />ಆಹಾ, ಅಂಜುರಾಚೆ ಝಾಡ್ ಚಿಗ್ರಿ ನಸ್ಲ್ಯಾರ್‍ಬಿ,</para>
  <para style="q2" vid="HAB 3:17">ದರಾಕ್ಷಾಚ್ಯಾ ಎಲಿತ್ನಿ ಫಳ್ ದಿಸಿ ನಸ್ಲ್ಯಾರ್‍ಬಿ,</para>
  <para style="q2" vid="HAB 3:17">ತೆಲಾಚ್ಯಾ ಝಾಡಾತ್ನಿ ಕಾಯ್ಬಿ ಗಾಯ್ ನಸ್ಲ್ಯಾರ್‍ಬಿ,</para>
  <para style="q2" vid="HAB 3:17">ಸೆತಾಬಾತಾತ್ನಿ ಫಿಕ್ ದಿ ನಸ್ಲ್ಯಾರ್‍ಬಿ,</para>
  <para style="q2" vid="HAB 3:17">ಬಕ್ರಾಚ್ಯಾ ಗೊಟ್ಯಾತ್ನಿ ಕಾಯ್ ನಸ್ಲ್ಯಾರ್‍ಬಿ,</para>
  <para style="q2" vid="HAB 3:17">ಗೊಟ್ಯಾತ್ನಿ ಗೊರಾಡೊರಾ ನಸ್ಲ್ಯಾರ್‍ಬಿ,<verse eid="HAB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18" />ಖುಶಿ ಹೊತಾ ಮಿಯಾ ಸರ್ವೆಸ್ಪರಾಕ್ಡೆ,</para>
  <para style="q2" vid="HAB 3:18">ಆನಂದ್ ಹೊತಾ ಮಾಜ್ಯಾ ಸುಟ್ಕಾ ಕರ್‍ತಲ್ಯಾ ದೆವಾಕ್ಡೆ.<verse eid="HAB 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19" />ಸರ್ವೆಸ್ಪರ್ ದೆವ್ ದಿತಾ ಮಾಕಾ ಧೈರ್ಯೊ,</para>
  <para style="q2" vid="HAB 3:19">ಮಾಜಿ ಪಾಂಯಾ ಚಿತ್ಳಾಚ್ಯಾ ಗತಿನ್ ಸುಡ್ಸುಡಿತ್ ಕರ್ತಾ ತೊ,</para>
  <para style="q2" vid="HAB 3:19">ಮಡ್ಡಿಯಾ ಡೊಂಗ್ರಾಂಚ್ಯಾ ವರ್‍ತಿ ಪಳಿ ಸಾರ್ಕೆ ಕರ್ತಾ ತೊ. ಮುಕ್ಯ್ ಗಾವ್ಪ್ಯಾಕ್ :ಅನಿ ತಂತಿಚ್ಯಾ ವಾಜ್ಪಾಂಚ್ಯಾ ವಾಂಗ್ಡಾ ಗಿತ್ ಗಾವ್ತಲೆ.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>