<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CO" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">1 कुरिन्थियों</para>
  <para style="toc1">1 कुरिन्थियों</para>
  <para style="toc2">1 कुरि</para>
  <para style="toc3">1 कुरि</para>
  <para style="mt">कुरिन्थियों के नाम पौलुस रसूल का पहला ख़त</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">1 पौलूस को इस किताब का मुसन्निफ़ बतौर तस्लीम किया गया है। (1 कुरिन्थियों 1:1 — 2; 16:21) पौलूस रसूल का ख़त बतौर भी जाना गया है। कुछ अर्सा पहले या फिर पौलूस जब इफ़सुस में था तो उस ने कुरिन्थियों को एक ख़त लिखा जो 1 कुरिन्थियों 5:10 1 — 2; 11 को तरजीह देता था और कुरिन्थ लोग इस ख़त की बाबत ग़लत फ़हमी में थे और बद क़िसमती से वह ख़त महफ़ूज़ न रह पाया। इस पहले ख़त का मज़्मून था (जैसे बुलाए गए थे) जिस की बाबत पूरी तरह से उन्हें मा‘लूम नहीं था। इस ख़त से पहले कुरिन्थ की कलीसिया के लोगों ने भी पौलूस को एक ख़त लिखा जिसे पौलूस ने हासिल किया था उसी के जवाब का यह पहला कुरिन्थियों का ख़त है।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इस के तस्नीफ़ की तारीख़ तक़रीबन 55 - 56 ईस्वी है।</para>
  <para style="ip">इस ख़त को इफ़सुस से लिखा गया (1 कुरिन्थियों 16:8)।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">पहला कुरिन्थियों के मख़सूस शुदा क़ारिईन ख़ुदा की कलीसिया जो कुरिन्थ में थी उस के अर्कान थे (1 कुरिन्थियों 1:2) हालांकि पौलूस ख़ुद ही मख़्सूस शुदा क़ारिईन को इस बतौर लिखते हुए शामिल करता है कि ख़ुदा की उस कलीसिया के नाम जो कुरिन्थिस में है, यानी उन के नाम जो मसीह येसू में पाक किए गये हैं (1:2)।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">पौलूस ने कई एक ज़रायों से कुरिन्थ की कलीसिया की मौजूदा हालात की बाबत माःलूमात हासिल कर रखी थी तब उन्हें नसीहत देने के लिए उस ने यह ख़त लिखा। इस ख़त के लिखने का मक़सद था कि उन्हें नसीहत दे, उन की ज़िन्दगियों में जहां कमियाँ पाई जाती थीं वहाँ उन्हें बहाल करे, सुधारे, ख़ास तौर से तफरिक़ों के मुग़ालते दूर करे (1 कुरिन्थियों 1:10 — 4:21) और क़्यामत की बाबत जो ग़लत ता‘लीम दी गई थी उस की तसीह करे। (1 कुरिन्थियों 15 बाब) बे दीनी के खि़लाफ उन्हें नसीहत दे (1 कुरिन्थियों 5, 6:12 — 20) और अशा — ए — रब्बानी के ग़लत इस्ते‘माल की बाबत होशियार करे (1 कुरिन्थियों 11:17 — 34) कुरिन्थियों की कलीसिया ख़ुदा की ने‘मतों से सरफ़राज़ थी (1:4 — 7) मगर ना कामिल और ग़ैर रूहानी थी (3:1 — 4) सो पौलूस ने एक अहम नमूने का किरदार निभाया कि कलीसिया अपने बीच गुनाह के मसले को अपने हाथ में ले और उन का हल करे। इलाक़ाई तफ़रिक़े और सब तरह की बेदीनी की तरफ़ आंखमचोली खेलने के बनिस्बत उस ने मस्लाजात की तरफ़ ध्यान देने को कहा।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">ईमान्दार की सीरत।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. तआरुफ़ — 1:1-9</para>
  <para style="io1">2. कुरिन्थ की कलीसिया में तफ़रिक़े — 1:10-4:21</para>
  <para style="io1">3. अख़लाकी ना मुवाफ़िक़त — 5:1-6:20</para>
  <para style="io1">4. शादी के उसूल — 7:1-40</para>
  <para style="io1">5. शागिर्दी की आज़ादी — 8:1-11:1</para>
  <para style="io1">6. इबादत के लिए हिदायात — 11:2-34</para>
  <para style="io1">7. रूहाऩी तौहफ़े — 12:1-14:40</para>
  <para style="io1">8. क़्यामत के लिए इल्म — ए — इलाही — 15:1-16:24</para>
  <chapter number="1" style="c" sid="1CO 1"/>
  <para style="s">पौलुस का सलाम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1"/>पौलुस रसूल की तरफ़ से, जो ख़ुदा की मर्ज़ी से ईसा मसीह का रसूल होने के लिए बुलाया गया है और भाई सोस्थिनेस की तरफ़ से, ये ख़त, <verse eid="1CO 1:1"/><verse number="2" style="v" sid="1CO 1:2"/>ख़ुदा की उस कलीसिया के नाम जो कुरिन्थुस शहर में है, या'नी उन के नाम जो मसीह ईसा में पाक किए गए, और मुक़द्दस होने के लिए बुलाए गए हैं, और उन सब के नाम भी जो हर जगह हमारे और अपने ख़ुदावन्द ईसा मसीह का नाम लेते हैं। <verse eid="1CO 1:2"/><verse number="3" style="v" sid="1CO 1:3"/>हमारे बाप ख़ुदा और ख़ुदावन्द ईसा मसीह की तरफ़ से तुम्हें फ़ज़ल और इत्मीनान हासिल होता रहे।<verse eid="1CO 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4"/>मैं तुम्हारे बारे में ख़ुदा के उस फ़ज़ल के ज़रिए जो मसीह ईसा में तुम पर हुआ हमेशा अपने ख़ुदा का शुक्र करता हूँ। <verse eid="1CO 1:4"/><verse number="5" style="v" sid="1CO 1:5"/>कि तुम उस में होकर सब बातों में कलाम और इल्म की हर तरह की दौलत से दौलतमन्द हो गए, हो। <verse eid="1CO 1:5"/><verse number="6" style="v" sid="1CO 1:6"/>चुनाँचे मसीह की गवाही तुम में क़ाईम हुई।<verse eid="1CO 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 1:7"/>यहाँ तक कि तुम किसी ने'मत में कम नहीं, और हमारे ख़ुदावन्द ईसा मसीह के ज़हूर के मुन्तज़िर हो। <verse eid="1CO 1:7"/><verse number="8" style="v" sid="1CO 1:8"/>जो तुम को आख़िर तक क़ाईम भी रख्खेगा, ताकि तुम हमारे ख़ुदावन्द 'ईसा' मसीह के दिन बे'इल्ज़ाम ठहरो। <verse eid="1CO 1:8"/><verse number="9" style="v" sid="1CO 1:9"/>ख़ुदा सच्चा है जिसने तुम्हें अपने बेटे हमारे ख़ुदावन्द 'ईसा मसीह की शराकत के लिए बुलाया है।<verse eid="1CO 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10"/>अब ऐ भाइयों! ईसा मसीह जो हमारा ख़ुदावन्द है, उसके नाम के वसीले से मैं तुम से इल्तिमास करता हूँ कि सब एक ही बात कहो, और तुम में तफ़्रक़े न हों, बल्कि एक साथ एक दिल और एक राय हो कर कामिल बने रहो। <verse eid="1CO 1:10"/><verse number="11" style="v" sid="1CO 1:11"/>क्यूँकि ऐ भाइयों! तुम्हारे ज़रिए मुझे ख़लोए के घर वालों से मा'लूम हुआ कि तुम में झगड़े हो रहे हैं।<verse eid="1CO 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 1:12"/>मेरा ये मतलब है कि तुम में से कोई तो अपने आपको पौलुस का कहता है कोई अपुल्लोस का कोई कैफ़ा का कोई मसीह का। <verse eid="1CO 1:12"/><verse number="13" style="v" sid="1CO 1:13"/>क्या मसीह बट गया? क्या पौलुस तुम्हारी ख़ातिर मस्लूब हुआ? या तुम ने पौलुस के नाम पर बपतिस्मा लिया?<verse eid="1CO 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14"/>ख़ुदा का शुक्र करता हूँ कि क्रिसपुस और गयुस के सिवा मैंने तुम में से किसी को बपतिस्मा नहीं दिया। <verse eid="1CO 1:14"/><verse number="15" style="v" sid="1CO 1:15"/>ताकि कोई ये न कहे कि तुम ने मेरे नाम पर बपतिस्मा लिया। <verse eid="1CO 1:15"/><verse number="16" style="v" sid="1CO 1:16"/>हाँ स्तिफ़नास के ख़ानदान को भी मैंने बपतिस्मा दिया बाक़ी नहीं जानता कि मैंने किसी और को बपतिस्मा दिया हो।<verse eid="1CO 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 1:17"/>क्यूँकि मसीह ने मुझे बपतिस्मा देने को नहीं भेजा बल्कि ख़ुशख़बरी सुनाने को और वो भी कलाम की हिक्मत से नहीं ताकि मसीह की सलीबी मौत बे'ताशीर न हो।<verse eid="1CO 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18"/>क्यूँकि सलीब का पैग़ाम हलाक होने वालों के नज़दीक तो बे'वक़ूफ़ी है मगर हम नजात पानेवालों के नज़दीक ख़ुदा की क़ुदरत है। <verse eid="1CO 1:18"/><verse number="19" style="v" sid="1CO 1:19"/>क्यूँकि लिखा है,</para>
  <para style="q" vid="1CO 1:19">“मैं हकीमों की हिक्मत को नेस्त</para>
  <para style="q" vid="1CO 1:19">और अक़्लमन्दों की अक़्ल को रद्द करूँगा।”<verse eid="1CO 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20"/>कहाँ का हकीम? कहाँ का आलिम? कहाँ का इस जहान का बहस करनेवाला? क्या ख़ुदा ने दुनिया की हिक्मत को बे'वक़ूफ़ी नहीं ठहराया? <verse eid="1CO 1:20"/><verse number="21" style="v" sid="1CO 1:21"/>इसलिए कि जब ख़ुदा की हिक्मत के मुताबिक़ दुनियाँ ने अपनी हिक्मत से ख़ुदा को न जाना तो ख़ुदा को ये पसन्द आया कि इस मनादी की बेवक़ूफ़ी के वसीले से ईमान लानेवालों को नजात दे।<verse eid="1CO 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 1:22"/>चुनाँचे यहूदी निशान चाहते हैं और यूनानी हिक्मत तलाश करते हैं। <verse eid="1CO 1:22"/><verse number="23" style="v" sid="1CO 1:23"/>मगर हम उस मसीह मस्लूब का ऐलान करते हैं जो यहूदियों के नज़दीक ठोकर और ग़ैर क़ौमों के नज़दीक बेवक़ूफ़ी है।<verse eid="1CO 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 1:24"/>लेकिन जो बुलाए हुए हैं यहूदी हों या यूनानी उन के नज़दीक मसीह ख़ुदा की क़ुदरत और ख़ुदा की हिक्मत है। <verse eid="1CO 1:24"/><verse number="25" style="v" sid="1CO 1:25"/>क्यूँकि ख़ुदा की बेवक़ूफ़ी आदमियों की हिक्मत से ज़्यादा हिक्मत वाली है और ख़ुदा की कमज़ोरी आदमियों के ज़ोर से ज़्यादा ताक़तवर है।<verse eid="1CO 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26"/>ऐ भाइयों! अपने बुलाए जाने पर तो निगाह करो कि जिस्म के लिहाज़ से बहुत से हकीम बहुत से इख़्तियार वाले बहुत से अशराफ़ नहीं बुलाए गए। <verse eid="1CO 1:26"/><verse number="27" style="v" sid="1CO 1:27"/>बल्कि ख़ुदा ने दुनिया के बेवक़ूफ़ों चुन लिया कि हकीमों को शर्मिन्दा करे और ख़ुदा ने दुनिया के कमज़ोरों को चुन लिया कि ज़ोरआवरों को शर्मिन्दा करे।<verse eid="1CO 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CO 1:28"/>और ख़ुदा ने दुनिया के कमीनों और हक़ीरों को बल्कि बे वजूदों को चुन लिया कि मौजूदों को नेस्त करे। <verse eid="1CO 1:28"/><verse number="29" style="v" sid="1CO 1:29"/>ताकि कोई बशर ख़ुदा के सामने फ़ख़्र न करे।<verse eid="1CO 1:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1CO 1:30"/>लेकिन तुम उसकी तरफ़ से मसीह ईसा में हो, जो हमारे लिए ख़ुदा की तरफ़ से हिक्मत ठहरा, या'नी रास्तबाज़ी और पाकीज़गी और मख़्लसी। <verse eid="1CO 1:30"/><verse number="31" style="v" sid="1CO 1:31"/>ताकि जैसा लिखा है “वैसा ही हो जो फ़ख़्र करे वो ख़ुदावन्द पर फ़ख़्र करे।”<verse eid="1CO 1:31"/></para>
  <chapter eid="1CO 1"/>
  <chapter number="2" style="c" sid="1CO 2"/>
  <para style="s">पौलुस का दानिशमन्दि भरा पैगाम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1"/>ऐ भाइयों! जब मैं तुम्हारे पास आया और तुम में ख़ुदा के भेद की मनादी करने लगा तो आ'ला दर्जे की तक़रीर या हिक्मत के साथ नहीं आया। <verse eid="1CO 2:1"/><verse number="2" style="v" sid="1CO 2:2"/>क्यूँकि मैंने ये इरादा कर लिया था कि तुम्हारे दर्मियान ईसा मसीह, मसलूब के सिवा और कुछ न जानूंगा।<verse eid="1CO 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 2:3"/>और मैं कमज़ोरी और ख़ौफ़ और बहुत थर थराने की हालत में तुम्हारे पास रहा। <verse eid="1CO 2:3"/><verse number="4" style="v" sid="1CO 2:4"/>और मेरी तक़रीर और मेरी मनादी में हिक्मत की लुभाने वाली बातें न थीं बल्कि वो रूह और क़ुदरत से साबित होती थीं। <verse eid="1CO 2:4"/><verse number="5" style="v" sid="1CO 2:5"/>ताकि तुम्हारा ईमान इंसान की हिक्मत पर नहीं बल्कि ख़ुदा की क़ुदरत पर मौक़ूफ़ हो।<verse eid="1CO 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6"/>फिर भी कामिलों में हम हिक्मत की बातें कहते हैं लेकिन इस जहान की और इस जहान के नेस्त होनेवाले हाकिमों की अक़्ल नहीं। <verse eid="1CO 2:6"/><verse number="7" style="v" sid="1CO 2:7"/>बल्कि हम ख़ुदा के राज़ की हक़ीक़त बातों के तौर पर बयान करते हैं, जो ख़ुदा ने जहान के शुरू से पहले हमारे जलाल के वास्ते मुक़र्रर की थी।<verse eid="1CO 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 2:8"/>जिसे इस दुनिया के सरदारों में से किसी ने न समझा क्यूँकि अगर समझते तो जलाल के ख़ुदावन्द को मस्लूब न करते। <verse eid="1CO 2:8"/><verse number="9" style="v" sid="1CO 2:9"/>“बल्कि जैसा लिखा है वैसा ही हुआ</para>
  <para style="q" vid="1CO 2:9">जो चीज़ें न आँखों ने देखीं</para>
  <para style="q" vid="1CO 2:9">न कानों ने सुनी</para>
  <para style="q" vid="1CO 2:9">न आदमी के दिल में आईं वो सब</para>
  <para style="q" vid="1CO 2:9">ख़ुदा ने अपने मुहब्बत रखनेवालों के लिए तैयार कर दीं।”<verse eid="1CO 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 2:10"/>लेकिन हम पर ख़ुदा ने उसको रूह के ज़रिए से ज़ाहिर किया क्यूँकि रूह सब बातें बल्कि ख़ुदा की तह की बातें भी दरियाफ़्त कर लेता है। <verse eid="1CO 2:10"/><verse number="11" style="v" sid="1CO 2:11"/>क्यूँकि इंसान ों में से कौन किसी इंसान की बातें जानता है सिवा इंसान की अपनी रूह के जो उस में है? उसी तरह ख़ुदा के रूह के सिवा कोई ख़ुदा की बातें नहीं जानता।<verse eid="1CO 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 2:12"/>मगर हम ने न दुनिया की रूह बल्कि वो रूह पाया जो ख़ुदा की तरफ़ से है; ताकि उन बातों को जानें जो ख़ुदा ने हमें इनायत की हैं। <verse eid="1CO 2:12"/><verse number="13" style="v" sid="1CO 2:13"/>और हम उन बातों को उन अल्फ़ाज़ में नहीं बयान करते जो इंसानी हिक्मत ने हम को सिखाए हों बल्कि उन अल्फ़ाज़ में जो रूह ने सिखाए हैं और रूहानी बातों का रूहानी बातों से मुक़ाबिला करते हैं।<verse eid="1CO 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 2:14"/>मगर जिस्मानी आदमी ख़ुदा के रूह की बातें क़ुबूल नहीं करता क्यूँकि वो उस के नज़दीक बेवक़ूफ़ी की बातें हैं और न वो इन्हें समझ सकता है क्यूँकि वो रूहानी तौर पर परखी जाती हैं। <verse eid="1CO 2:14"/><verse number="15" style="v" sid="1CO 2:15"/>लेकिन रूहानी शख़्स सब बातों को परख लेता है; मगर ख़ुदा किसी से परखा नहीं जाता।<verse eid="1CO 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="1CO 2:16"/>“ख़ुदावन्द की अक़्ल को किसने जाना कि उसको ता'लीम दे सके?</para>
  <para style="m" vid="1CO 2:16">मगर हम में मसीह की अक़्ल है।”<verse eid="1CO 2:16"/></para>
  <chapter eid="1CO 2"/>
  <chapter number="3" style="c" sid="1CO 3"/>
  <para style="s">पौलुस और अप्पुल्लोस, येसु के ख़ादिम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1"/>ऐ भाइयों! मैं तुम से उस तरह कलाम न कर सका जिस तरह रूहानियों से बल्कि जैसे जिस्मानियों से और उन से जो मसीह में बच्चे हैं। <verse eid="1CO 3:1"/><verse number="2" style="v" sid="1CO 3:2"/>मैने तुम्हें दूध पिलाया और खाना न खिलाया क्यूँकि तुम को उसकी बर्दाश्त न थी, बल्कि अब भी नहीं।<verse eid="1CO 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 3:3"/>क्यूँकि अभी तक जिस्मानी हो इसलिए कि जब तुम मैं हसद और झगड़ा है तो क्या तुम जिस्मानी न हुए और इंसानी तरीक़े पर न चले? <verse eid="1CO 3:3"/><verse number="4" style="v" sid="1CO 3:4"/>इसलिए कि जब एक कहता है “मैं पौलुस का हूँ” और दूसरा कहता है मैं अपुल्लोस का हूँ तो क्या तुम इंसान न हुए?<verse eid="1CO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5"/>अपुल्लोस क्या चीज़ है? और पौलुस क्या? ख़ादिम जिनके वसीले से तुम ईमान लाए और हर एक को वो हैसियत है जो ख़ुदावन्द ने उसे बख़्शी।<verse eid="1CO 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 3:6"/>मैंने दरख़्त लगाया और अपुल्लोस ने पानी दिया मगर बढ़ाया ख़ुदा ने। <verse eid="1CO 3:6"/><verse number="7" style="v" sid="1CO 3:7"/>पस न लगाने वाला कुछ चीज़ है न पानी देनेवाला मगर ख़ुदा जो बढ़ाने वाला है।<verse eid="1CO 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 3:8"/>लगानेवाला और पानी देनेवाला दोनों एक हैं लेकिन हर एक अपना अज्र अपनी मेहनत के मुवाफ़िक़ पाएगा। <verse eid="1CO 3:8"/><verse number="9" style="v" sid="1CO 3:9"/>क्यूँकि हम ख़ुदा के साथ काम करनेवाले हैं तुम ख़ुदा की खेती और ख़ुदा की इमारत हो। <verse eid="1CO 3:9"/><verse number="10" style="v" sid="1CO 3:10"/>मैने उस तौफ़ीक़ के मुवाफ़िक़ जो ख़ुदा ने मुझे बख़्शी अक़्लमंद मिस्त्री की तरह नींव रख्खी, और दूसरा उस पर इमारत उठाता है पस हर एक ख़बरदार रहे, कि वो कैसी इमारत उठाता है। <verse eid="1CO 3:10"/><verse number="11" style="v" sid="1CO 3:11"/>क्यूँकि सिवा उस नींव के जो पड़ी हुई है और वो ईसा मसीह है कोई शख़्स दूसरी नहीं रख सकता।<verse eid="1CO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 3:12"/>और अगर कोई उस नींव पर सोना या चाँदी या बेशक़ीमती पत्थरों या लकड़ी या घास या भूसे का रद्दा रख्खे। <verse eid="1CO 3:12"/><verse number="13" style="v" sid="1CO 3:13"/>तो उस का काम ज़ाहिर हो जाएगा क्यूँकि जो दिन आग के साथ ज़ाहिर होगा वो उस काम को बता देगा और वो आग ख़ुद हर एक का काम आज़मा लेगी कि कैसा है।<verse eid="1CO 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 3:14"/>जिस का काम उस पर बना हुआ बाक़ी रहेगा, वो अज्र पाएगा। <verse eid="1CO 3:14"/><verse number="15" style="v" sid="1CO 3:15"/>और जिस का काम जल जाएगा, वो नुक़्सान उठाएगा; लेकिन ख़ुद बच जाएगा मगर जलते जलते।<verse eid="1CO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16"/>क्या तुम नहीं जानते कि तुम ख़ुदा का मक़दिस हो और ख़ुदा का रूह तुम में बसा हुआ है? <verse eid="1CO 3:16"/><verse number="17" style="v" sid="1CO 3:17"/>अगर कोई ख़ुदा के मक़दिस को बरबाद करेगा तो ख़ुदा उसको बरबाद करेगा, क्यूँकि ख़ुदा का मक़दिस पाक है और वो तुम हो।<verse eid="1CO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18"/>कोई अपने आप को धोखा न दे अगर कोई तुम में अपने आप को इस जहान में हकीम समझे, तो बेवक़ूफ़ बने ताकि हकीम हो जाए। <verse eid="1CO 3:18"/><verse number="19" style="v" sid="1CO 3:19"/>क्यूँकि दुनियाँ की हिक्मत ख़ुदा के नज़दीक बेवक़ूफ़ी है: चुनाँचे लिखा है,</para>
  <para style="q" vid="1CO 3:19">“वो हकीमों को उन ही की चालाकी में फँसा देता है।”<verse eid="1CO 3:19"/></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 3:20"/>और ये भी, ख़ुदावन्द हकीमों के ख़यालों को जानता है “कि बातिल हैं।”<verse eid="1CO 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 3:21"/>पस आदमियों पर कोई फ़ख़्र न करो क्यूँकि सब चीज़ें तुम्हारी हैं। <verse eid="1CO 3:21"/><verse number="22" style="v" sid="1CO 3:22"/>चाहे पौलुस हो, चाहे अपुल्लोस, चाहे कैफ़ा, चाहे दुनिया, चाहे ज़िन्दगी, चाहे मौत, चाहे हाल, की चीज़ें, चाहे इस्तक़बाल की, <verse eid="1CO 3:22"/><verse number="23" style="v" sid="1CO 3:23"/>सब तुम्हारी हैं और तुम मसीह के हो, और मसीह ख़ुदा का है।<verse eid="1CO 3:23"/></para>
  <chapter eid="1CO 3"/>
  <chapter number="4" style="c" sid="1CO 4"/>
  <para style="s">कुरिन्थ के साथ पौलुस का रिश्ता</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1"/>आदमी हम को मसीह का ख़ादिम और ख़ुदा के हिक्मत का मुख़्तार समझे। <verse eid="1CO 4:1"/><verse number="2" style="v" sid="1CO 4:2"/>और यहाँ मुख़्तार में ये बात देखी जाती है के दियानतदार निकले।<verse eid="1CO 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 4:3"/>लेकिन मेरे नज़दीक ये निहायत छोटी बात है कि तुम या कोई इंसानी अदालत मुझे परखे:बल्कि मैं ख़ुद भी अपने आप को नहीं परखता। <verse eid="1CO 4:3"/><verse number="4" style="v" sid="1CO 4:4"/>क्यूँकि मेरा दिल तो मुझे मलामत नहीं करता मगर इस से मैं रास्तबाज़ नहीं ठहरता, बल्कि मेरा परखने वाला ख़ुदावन्द है।<verse eid="1CO 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 4:5"/>पस जब तक ख़ुदावन्द न आए, वक़्त से पहले किसी बात का फ़ैसला न करो; वही तारीकी की पोशीदा बातें रौशन कर देगा और दिलों के मन्सूबे ज़ाहिर कर देगा और उस वक़्त हर एक की ता'रीफ़ ख़ुदा की तरफ़ से होगी।<verse eid="1CO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6"/>ऐ भाइयों! मैने इन बातों में तुम्हारी ख़ातिर अपना और अपुल्लोस का ज़िक्र मिसाल के तौर पर किया है,</para>
  <para style="q" vid="1CO 4:6">ताकि तुम हमारे वसीले से ये सीखो कि लिखे हुए से बढ़ कर न करो</para>
  <para style="m" vid="1CO 4:6">और एक की ताईद में दूसरे के बरख़िलाफ़ शेख़ी न मारो। <verse eid="1CO 4:6"/><verse number="7" style="v" sid="1CO 4:7"/>तुझ में और दूसरे में कौन फ़र्क़ करता है? और तेरे पास कौन सी ऐसी चीज़ है जो तू ने दूसरे से नहीं पाई? और जब तूने दूसरे से पाई तो फ़ख़्र क्यूँ करता है कि गोया नहीं पाई?<verse eid="1CO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8"/>तुम तो पहले ही से आसूदा हो और पहले ही से दौलतमन्द हो और तुम ने हमारे बग़ैर बादशाही की: और क़ाश कि तुम बादशाही करते ताकि हम भी तुम्हारे साथ बादशाही करते। <verse eid="1CO 4:8"/><verse number="9" style="v" sid="1CO 4:9"/>मेरी दानिस्त में ख़ुदा ने हम रसूलों को सब से अदना ठहराकर उन लोगों की तरह पेश किया है जिनके क़त्ल का हुक्म हो चुका हो; क्यूँकि हम दुनिया और फ़रिश्तों और आदमियों के लिए एक तमाशा ठहरे।<verse eid="1CO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 4:10"/>हम मसीह की ख़ातिर बेवक़ूफ़ हैं मगर तुम मसीह में अक़्लमन्द हो: हम कमज़ोर हैं और तुम ताक़तवर तुम इज़्ज़त दार हो: और हम बे'इज़्ज़त। <verse eid="1CO 4:10"/><verse number="11" style="v" sid="1CO 4:11"/>हम इस वक़्त तक भुखे प्यासे नंगे हैं और मुक्के खाते और आवारा फिरते हैं।<verse eid="1CO 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 4:12"/>और अपने हाथों से काम करके मशक़्क़त उठाते हैं लोग बुरा कहते हैं हम दुआ देते हैं वो सताते हैं हम सहते हैं। <verse eid="1CO 4:12"/><verse number="13" style="v" sid="1CO 4:13"/>वो बदनाम करते हैं हम मिन्नत समाजत करते हैं हम आज तक दुनिया के कूड़े और सब चीज़ों की झड़न की तरह हैं।<verse eid="1CO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14"/>मैं तुम्हें शर्मिन्दा करने के लिए ये नहीं लिखता: बल्कि अपना प्यारा बेटा जानकर तुम को नसीहत करता हूँ। <verse eid="1CO 4:14"/><verse number="15" style="v" sid="1CO 4:15"/>क्यूँकि अगर मसीह में तुम्हारे उस्ताद दस हज़ार भी होते तोभी तुम्हारे बाप बहुत से नहीं: इसलिए कि मैं ही इन्जील के वसीले से मसीह ईसा में तुम्हारा बाप बना। <verse eid="1CO 4:15"/><verse number="16" style="v" sid="1CO 4:16"/>पस मैं तुम्हारी मिन्नत करता हूँ कि मेरी तरह बनो।<verse eid="1CO 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 4:17"/>इसी वास्ते मैंने तीमुथियुस को तुम्हारे पास भेजा; कि वो ख़ुदावन्द में मेरा प्यारा और दियानतदार बेटा है और मेरे उन तरीक़ों को जो मसीह में हैं तुम्हें याद दिलाएगा; जिस तरह मैं हर जगह हर कलीसिया में ता'लीम देता हूँ। <verse eid="1CO 4:17"/><verse number="18" style="v" sid="1CO 4:18"/>कुछ ऐसी शेख़ी मारते हैं गोया कि तुम्हारे पास आने ही का नहीं।<verse eid="1CO 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 4:19"/>लेकिन ख़ुदावन्द ने चाहा तो मैं तुम्हारे पास जल्द आऊँगा और शेख़ी बाज़ों की बातों को नहीं, बल्कि उनकी क़ुदरत को मा'लूम करूँगा। <verse eid="1CO 4:19"/><verse number="20" style="v" sid="1CO 4:20"/>क्यूँकि ख़ुदा की बादशाही बातों पर नहीं, बल्कि क़ुदरत पर मौक़ूफ़ है। <verse eid="1CO 4:20"/><verse number="21" style="v" sid="1CO 4:21"/>तुम क्या चाहते हो कि मैं लकड़ी लेकर तुम्हारे पास आऊँ या मुहब्बत और नर्म मीज़ाजी से?<verse eid="1CO 4:21"/></para>
  <chapter eid="1CO 4"/>
  <chapter number="5" style="c" sid="1CO 5"/>
  <para style="s">पौलुस का रूहानी घमंड पर इल्ज़ाम लगाना</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1"/>यहाँ तक कि सुनने में आया है कि तुम में हरामकारी होती है बल्कि ऐसी हरामकारी जो ग़ैर क़ौमों में भी नहीं होती:चुनाँचे तुम में से एक शख़्स अपने बाप की दूसरी बीवी को रखता है। <verse eid="1CO 5:1"/><verse number="2" style="v" sid="1CO 5:2"/>और तुम अफ़सोस तो करते नहीं ताकि जिस ने ये काम किया वो तुम में से निकाला जाए बल्कि शेख़ी मारते हो।<verse eid="1CO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 5:3"/>लेकिन मैं अगरचे जिस्म के ऐ'तिबार से मौजूद न था, मगर रूह के ऐ'तिबार से हाज़िर होकर गोया बहालत' — ए — मौजूदगी ऐसा करने वाले पर ये हुक्म दे चुका हूँ। <verse eid="1CO 5:3"/><verse number="4" style="v" sid="1CO 5:4"/>कि जब तुम और मेरी रूह हमारे ख़ुदावन्द ईसा मसीह की क़ुदरत के साथ जमा हो तो ऐसा शख़्स हमारे ख़ुदावन्द 'ईसा के नाम से। <verse eid="1CO 5:4"/><verse number="5" style="v" sid="1CO 5:5"/>जिस्म की हलाकत के लिए शैतान के हवाले किया जाए ताकि उस की रूह ख़ुदावन्द ईसा के दिन नजात पाए।<verse eid="1CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6"/>तुम्हारा फ़ख़्र करना ख़ूब नहीं क्या तुम नहीं जानते कि थोड़ा सा ख़मीर सारे गुंधे हुए आटे को ख़मीर कर देता है। <verse eid="1CO 5:6"/><verse number="7" style="v" sid="1CO 5:7"/>पुराना ख़मीर निकाल कर अपने आप को पाक कर लो ताकि ताज़ा गुंधा हुआ आटा बन जाओ चुनाँचे तुम बे ख़मीर हो क्यूँकि हमारा भी फ़सह या'नी मसीह क़ुर्बान हुआ। <verse eid="1CO 5:7"/><verse number="8" style="v" sid="1CO 5:8"/>पस आओ हम ईद करें न पुराने ख़मीर से और न बदी और शरारत के ख़मीर से, बल्कि साफ़ दिली और सच्चाई की बे ख़मीर रोटी से।<verse eid="1CO 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9"/>मैंने अपने ख़त में तुम को ये लिखा था कि हरामकारों से सुहबत न रखना। <verse eid="1CO 5:9"/><verse number="10" style="v" sid="1CO 5:10"/>ये तो नहीं कि बिल्कुल दुनिया के हरामकारों या लालचियों या ज़ालिमों या बुतपरस्तों से मिलना ही नहीं; क्यूँकि इस सूरत में तो तुम को दुनिया ही से निकल जाना पड़ता।<verse eid="1CO 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 5:11"/>यहाँ तक कि सुनने में आया है कि तुम में हरामकारी होती है बल्कि ऐसी हरामकारी जो ग़ैर क़ौमों में भी नहीं होती:चुनाँचे तुम में से एक शख़्स अपने बाप की बीवी को रखता है। लेकिन मैने तुम को दर हक़ीक़त ये लिखा था कि अगर कोई भाई कहलाकर हरामकार या लालची या बुतपरस्त या गाली देने वाला शराबी या ज़ालिम हो तो उस से सुहबत न रखो; बल्कि ऐसे के साथ खाना तक न खाना। <verse eid="1CO 5:11"/><verse number="12" style="v" sid="1CO 5:12"/>क्यूँकि मुझे कलीसिया के बाहर वालों पर हुक्म करने से क्या वास्ता? क्या ऐसा नहीं है कि तुम तो कलीसिया के अन्दर वालों पर हुक्म करते हो। <verse eid="1CO 5:12"/><verse number="13" style="v" sid="1CO 5:13"/>मगर बाहर वालों पर ख़ुदा हुक्म करता है, पस उस शरीर आदमी को अपने दर्मियान से निकाल दो।<verse eid="1CO 5:13"/></para>
  <chapter eid="1CO 5"/>
  <chapter number="6" style="c" sid="1CO 6"/>
  <para style="s">मसीहियों के साथ मुकद्दमें करने से टलना</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1"/>क्या तुम में से किसी को ये जुर'अत है कि जब दूसरे के साथ मुक़द्दमा हो तो फ़ैसले के लिए बेदीन आदिलों के पास जाए; और मुक़द्दसों के पास न जाए। <verse eid="1CO 6:1"/><verse number="2" style="v" sid="1CO 6:2"/>क्या तुम नहीं जानते कि मुक़द्दस लोग दुनिया का इन्साफ़ करेंगे? पस जब तुम को दुनिया का इन्साफ़ करना है तो क्या छोटे से छोटे झगड़ों के भी फ़ैसले करने के लायक़ नहीं हो? <verse eid="1CO 6:2"/><verse number="3" style="v" sid="1CO 6:3"/>क्या तुम नहीं जानते कि हम फ़रिश्तों का इन्साफ़ करेंगे? तो क्या हम दुनियावी मु'आमिले के फ़ैसले न करें?<verse eid="1CO 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 6:4"/>पस अगर तुम में दुनियावी मुक़द्दमे हों तो क्या उन को मुंसिफ़ मुक़र्रर करोगे जो कलीसिया में हक़ीर समझे जाते हैं। <verse eid="1CO 6:4"/><verse number="5" style="v" sid="1CO 6:5"/>मैं तुम्हें शर्मिन्दा करने के लिए ये कहता हूँ; क्या वाक़'ई तुम में एक भी समझदार नहीं मिलता जो अपने भाइयों का फ़ैसला कर सके। <verse eid="1CO 6:5"/><verse number="6" style="v" sid="1CO 6:6"/>बल्कि भाई भाइयों में मुक़द्दमा होता है और वो भी बेदीनों के आगे!<verse eid="1CO 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7"/>लेकिन दर'असल तुम में बड़ा नुक़्स ये है कि आपस में मुक़द्दमा बाज़ी करते हो; ज़ुल्म उठाना क्यूँ नहीं बेहतर जानते? अपना नुक़्सान क्यूँ नहीं क़ुबूल करते? <verse eid="1CO 6:7"/><verse number="8" style="v" sid="1CO 6:8"/>बल्कि तुम ही ज़ुल्म करते और नुक़्सान पहुँचाते हो और वो भी भाइयों को।<verse eid="1CO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9"/>क्या तुम नहीं जानते कि बदकार ख़ुदा की बादशाही के वारिस न होंगे धोखा न खाओ न हरामकार ख़ुदा की बादशाही के वारिस होंगे न बुतपरस्त, न ज़िनाकार, न अय्याश, न लौंडे बाज़, <verse eid="1CO 6:9"/><verse number="10" style="v" sid="1CO 6:10"/>न चोर, न लालची, न शराबी, न गालियाँ बकने वाले, न ज़ालिम, <verse eid="1CO 6:10"/><verse number="11" style="v" sid="1CO 6:11"/>और कुछ तुम में ऐसे ही थे भी, 'मगर तुम ख़ुदावन्द ईसा मसीह के नाम से और हमारे ख़ुदा के रूह से धूल गए और पाक हुए और रास्तबाज़ भी ठहरे।<verse eid="1CO 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12"/>सब चीज़ें मेरे लिए जायज़ तो हैं मगर सब चीज़ें मुफ़ीद नहीं; सब चीज़ें मेरे लिए जायज़ तो हैं; लेकिन मैं किसी चीज़ का पाबन्द न हूँगा। <verse eid="1CO 6:12"/><verse number="13" style="v" sid="1CO 6:13"/>खाना पेट के लिए हैं और पेट खाने के लिए लेकिन ख़ुदा उसको और इनको नेस्त करेगा मगर बदन हरामकारी के लिए नहीं बल्कि ख़ुदावन्द के लिए है और ख़ुदावन्द बदन के लिए।<verse eid="1CO 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 6:14"/>और ख़ुदा ने ख़ुदावन्द को भी जिलाया और हम को भी अपनी क़ुदरत से जिलाएगा। <verse eid="1CO 6:14"/><verse number="15" style="v" sid="1CO 6:15"/>क्या तुम नहीं जानते कि तुम्हारे बदन मसीह के आ'ज़ा है? पस क्या मैं मसीह के आ'ज़ा लेकर कस्बी के आ'ज़ा बनाऊँ हरगिज़ नहीं।<verse eid="1CO 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 6:16"/>क्या तुम नहीं जानते कि जो कोई कस्बी से सुहबत करता है वो उसके साथ एक तन होता है? क्यूँकि वो फ़रमाता है, “वो दोनों एक तन होंगे।” <verse eid="1CO 6:16"/><verse number="17" style="v" sid="1CO 6:17"/>और जो ख़ुदावन्द की सुहबत में रहता है वो उसके साथ एक रूह होता है।<verse eid="1CO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18"/>हरामकारी से भागो जितने गुनाह आदमी करता है वो बदन से बाहर हैं; मगर हरामकार अपने बदन का भी गुनाहगार है।<verse eid="1CO 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 6:19"/>क्या तुम नहीं जानते कि तुम्हारा बदन रूह — उल — क़ुद्दूस का मक़दिस है जो तुम में बसा हुआ है और तुम को ख़ुदा की तरफ़ से मिला है? और तुम अपने नहीं। <verse eid="1CO 6:19"/><verse number="20" style="v" sid="1CO 6:20"/>क्यूँकि क़ीमत से ख़रीदे गए हो; पस अपने बदन से ख़ुदा का जलाल ज़ाहिर करो।<verse eid="1CO 6:20"/></para>
  <chapter eid="1CO 6"/>
  <chapter number="7" style="c" sid="1CO 7"/>
  <para style="s">निकाह करने पर हिदायत</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1"/>जो बातें तुम ने लिखी थीं उनकी वजह ये हैं मर्द के लिए अच्छा है कि औरत को न छुए। <verse eid="1CO 7:1"/><verse number="2" style="v" sid="1CO 7:2"/>लेकिन हरामकारी के अन्देशे से हर मर्द अपनी बीवी और हर औरत अपना शौहर रख्खे।<verse eid="1CO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 7:3"/>शौहर बीवी का हक़ अदा करे और वैसे ही बीवी शौहर का। <verse eid="1CO 7:3"/><verse number="4" style="v" sid="1CO 7:4"/>बीवी अपने बदन की मुख़्तार नहीं बल्कि शौहर है इसी तरह शौहर भी अपने बदन का मुख़्तार नहीं बल्कि बीवी।<verse eid="1CO 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 7:5"/>तुम एक दूसरे से जुदा न रहो मगर थोड़ी मुद्दत तक आपस की रज़ामन्दी से, ताकि दुआ के लिए वक़्त मिले और फिर इकट्ठे हो जाओ ऐसा न हो कि ग़ल्बा — ए — नफ़्स की वजह से शैतान तुम को आज़माए।<verse eid="1CO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6"/>लेकिन मैं ये इजाज़त के तौर पर कहता हूँ हुक्म के तौर पर नहीं। <verse eid="1CO 7:6"/><verse number="7" style="v" sid="1CO 7:7"/>और मैं तो ये चाहता हूँ कि जैसा मैं हूँ वैसे ही सब आदमी हों लेकिन हर एक को ख़ुदा की तरफ़ से ख़ास तौफ़ीक़ मिली है किसी को किसी तरह की किसी को किसी तरह की।<verse eid="1CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8"/>पस मैं बे'ब्याहों और बेवाओं के हक़ में ये कहता हूँ; कि उनके लिए ऐसा ही रहना अच्छा है जैसा मैं हूँ। <verse eid="1CO 7:8"/><verse number="9" style="v" sid="1CO 7:9"/>लेकिन अगर सब्र न कर सकें तो शादी कर लें; क्यूँकि शादी करना मस्त होने से बेहतर है।<verse eid="1CO 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10"/>मगर जिनकी शादी हो गई है उनको मैं नहीं बल्कि ख़ुदावन्द हुक्म देता है कि बीवी अपने शौहर से जुदा न हो। <verse eid="1CO 7:10"/><verse number="11" style="v" sid="1CO 7:11"/>(और अगर जुदा हो तो बे'निकाह रहे या अपने शौहर से फिर मिलाप कर ले) न शौहर बीवी को छोड़े।<verse eid="1CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12"/>बाक़ियों से मैं ही कहता हूँ न ख़ुदावन्द कि अगर किसी भाई की बीवी बा ईमान न हो और उस के साथ रहने को राज़ी हो तो वो उस को न छोड़े। <verse eid="1CO 7:12"/><verse number="13" style="v" sid="1CO 7:13"/>और जिस 'औरत का शौहर बा'ईमान न हो और उसके साथ रहने को राज़ी हो तो वो शौहर को न छोड़े। <verse eid="1CO 7:13"/><verse number="14" style="v" sid="1CO 7:14"/>क्यूँकि जो शौहर बाईमान नहीं वो बीवी की वजह से पाक ठहरता है; और जो बीवी बाईमान नहीं वो मसीह शौहर के ज़रिए पाक ठहरती है वर्ना तुम्हारे बेटे नापाक होते मगर अब पाक हैं।<verse eid="1CO 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 7:15"/>लेकिन मर्द जो बा'ईमान न हो अगर वो जुदा हो तो जुदा होने दो ऐसी हालत में कोई भाई या बहन पाबन्द नहीं और ख़ुदा ने हम को मेल मिलाप के लिए बुलाया है। <verse eid="1CO 7:15"/><verse number="16" style="v" sid="1CO 7:16"/>क्यूँकि ऐ 'औरत तुझे क्या ख़बर है कि शायद तू अपने शौहर को बचा ले? और ऐ मर्द तुझे क्या ख़बर है कि शायद तू अपनी बीवी को बचा ले।<verse eid="1CO 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17"/>मगर जैसा ख़ुदावन्द ने हर एक को हिस्सा दिया है और जिस तरह ख़ुदा ने हर एक को बुलाया है उसी तरह वो चले; और मैं सब कलीसियाओं में ऐसा ही मुक़र्रर करता हूँ। <verse eid="1CO 7:17"/><verse number="18" style="v" sid="1CO 7:18"/>जो मख़्तून बुलाया गया वो नामख़्तून न हो जाए जो नामख़्तूनी की हालत में बुलाया गया वो मख़्तून न हो जाए। <verse eid="1CO 7:18"/><verse number="19" style="v" sid="1CO 7:19"/>न ख़तना कोई चीज़ है नामख़्तूनी बल्कि ख़ुदा के हुक्मों पर चलना ही सब कुछ है।<verse eid="1CO 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 7:20"/>हर शख़्स जिस हालत में बुलाया गया हो उसी में रहे। <verse eid="1CO 7:20"/><verse number="21" style="v" sid="1CO 7:21"/>अगर तू ग़ुलामी की हालत में बुलाया गया तो फ़िक्र न कर लेकिन अगर तू आज़ाद हो सके तो इसी को इख़्तियार कर। <verse eid="1CO 7:21"/><verse number="22" style="v" sid="1CO 7:22"/>क्यूँकि जो शख़्स ग़ुलामी की हालत में ख़ुदावन्द में बुलाया गया है वो ख़ुदावन्द का आज़ाद किया हुआ है; इसी तरह जो आज़ादी की हालत में बुलाया गया है वो मसीह का ग़ुलाम है। <verse eid="1CO 7:22"/><verse number="23" style="v" sid="1CO 7:23"/>तुम मसीह के ज़रिए ख़ास क़ीमत से ख़रीदे गए हो आदमियों के ग़ुलाम न बनो। <verse eid="1CO 7:23"/><verse number="24" style="v" sid="1CO 7:24"/>ऐ भाइयों! जो कोई जिस हालत में बुलाया गया हो वो उसी हालत में ख़ुदा के साथ रहे।<verse eid="1CO 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25"/>कुँवारियों के हक़ में मेरे पास ख़ुदावन्द का कोई हुक्म नहीं लेकिन दियानतदार होने के लिए जैसा ख़ुदावन्द की तरफ़ से मुझ पर रहम हुआ उसके मुवाफ़िक़ अपनी राय देता हूँ। <verse eid="1CO 7:25"/><verse number="26" style="v" sid="1CO 7:26"/>पस मौजूदा मुसीबत के ख़याल से मेरी राय में आदमी के लिए यही बेहतर है कि जैसा है वैसा ही रहे।<verse eid="1CO 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 7:27"/>अगर तेरी बीवी है तो उस से जुदा होने की कोशीश न कर और अगर तेरी बीवी नहीं तो बीवी की तलाश न कर। <verse eid="1CO 7:27"/><verse number="28" style="v" sid="1CO 7:28"/>लेकिन तू शादी करे भी तो गुनाह नहीं और अगर कुँवारी ब्याही जाए तो गुनाह नहीं मगर ऐसे लोग जिस्मानी तकलीफ़ पाएँगे, और मैं तुम्हें बचाना चाहता हूँ।<verse eid="1CO 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29"/>मगर ऐ भाइयों! मैं ये कहता हूँ कि वक़्त तंग है पस आगे को चाहिए कि बीवी वाले ऐसे हों कि गोया उनकी बीवियाँ नहीं। <verse eid="1CO 7:29"/><verse number="30" style="v" sid="1CO 7:30"/>और रोने वाले ऐसे हों गोया नहीं रोते; और ख़ुशी करने वाले ऐसे हों गोया ख़ुशी नहीं करते; और ख़रीदने वाले ऐसे हों गोया माल नहीं रखते। <verse eid="1CO 7:30"/><verse number="31" style="v" sid="1CO 7:31"/>और दुनियावी कारोबार करनेवाले ऐसे हों कि दुनिया ही के न हो जाएँ; क्यूँकि दुनिया की शक्ल बदलती जाती है।<verse eid="1CO 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32"/>पस मैं ये चाहता हूँ कि तुम बेफ़िक्र रहो, बे ब्याहा शख़्स ख़ुदावन्द की फ़िक्र में रहता है कि किस तरह ख़ुदावन्द को राज़ी करे। <verse eid="1CO 7:32"/><verse number="33" style="v" sid="1CO 7:33"/>मगर शादी हुआ शख़्स दुनिया की फ़िक्र में रहता है कि किस तरह अपनी बीवी को राज़ी करे। <verse eid="1CO 7:33"/><verse number="34" style="v" sid="1CO 7:34"/>शादी और बेशादी में भी फ़र्क़ है बे शादी ख़ुदावन्द की फ़िक्र में रहती है ताकि उसका जिस्म और रूह दोनों पाक हों मगर ब्याही हुई औरत दुनिया की फ़िक्र में रहती है कि किस तरह अपने शौहर को राज़ी करे।<verse eid="1CO 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35"/>ये तुम्हारे फ़ाइदे के लिए कहता हूँ न कि तुम्हें फ़साने के लिए; बल्कि इसलिए कि जो ज़ेबा है वही अमल में आए और तुम ख़ुदावन्द की ख़िदमत में बिना शक किए मशग़ूल रहो।<verse eid="1CO 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36"/>अगर कोई ये समझे कि मैं अपनी उस कुँवारी लड़की की हक़तल्फ़ी करता हूँ जिसकी जवानी ढल चली है और ज़रूरत भी मा'लूम हो तो इख़्तियार है इस में गुनाह नहीं वो उसकी शादी होने दे। <verse eid="1CO 7:36"/><verse number="37" style="v" sid="1CO 7:37"/>मगर जो अपने दिल में पुख़्ता हो और इस की कुछ ज़रूरत न हो बल्कि अपने इरादे के अंजाम देने पर क़ादिर हो और दिल में अहद कर लिया हो कि मैं अपनी लड़की को बेनिकाह रखूँगा वो अच्छा करता है। <verse eid="1CO 7:37"/><verse number="38" style="v" sid="1CO 7:38"/>पस जो अपनी कुँवारी लड़की को शादी कर देता है वो अच्छा करता है और जो नहीं करता वो और भी अच्छा करता है।<verse eid="1CO 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39"/>जब तक कि 'औरत का शौहर जीता है वो उस की पाबन्द है पर जब उसका शौहर मर जाए तो जिससे चाहे शादी कर सकती है मगर सिर्फ़ ख़ुदावन्द में। <verse eid="1CO 7:39"/><verse number="40" style="v" sid="1CO 7:40"/>लेकिन जैसी है अगर वैसी ही रहे तो मेरी राय में ज़्यादा ख़ुश नसीब है और मैं समझता हूँ कि ख़ुदा का रूह मुझ में भी है।<verse eid="1CO 7:40"/></para>
  <chapter eid="1CO 7"/>
  <chapter number="8" style="c" sid="1CO 8"/>
  <para style="s">बुतों को चढ़ाए जाने वाला खाना</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1"/>अब बुतों की कुर्बानियों के बारे में ये है हम जानते हैं कि हम सब इल्म रखते हैं इल्म ग़ुरूर पैदा करता है लेकिन मुहब्बत तरक़्क़ी का ज़रिया है। <verse eid="1CO 8:1"/><verse number="2" style="v" sid="1CO 8:2"/>अगर कोई गुमान करे कि मैं कुछ जानता हूँ तो जैसा जानना चाहिए वैसा अब तक नहीं जानता। <verse eid="1CO 8:2"/><verse number="3" style="v" sid="1CO 8:3"/>लेकिन जो कोई ख़ुदा से मुहब्बत रखता है उस को ख़ुदा पहचानता है।<verse eid="1CO 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4"/>पस बुतों की कुर्बानियों के गोश्त खाने के ज़रिए हम जानते हैं कि बुत दुनिया में कोई चीज़ नहीं और सिवा एक के और कोई ख़ुदा नहीं। <verse eid="1CO 8:4"/><verse number="5" style="v" sid="1CO 8:5"/>अगरचे आसमान — ओ — ज़मीन में बहुत से ख़ुदा कहलाते हैं चुनाँचे बहुत से ख़ुदा और बहुत से ख़ुदावन्द हैं।<verse eid="1CO 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="1CO 8:6"/>लेकिन हमारे नज़दीक तो एक ही ख़ुदा है</para>
  <para style="q" vid="1CO 8:6">या'नी बाप जिसकी तरफ़ से सब चीज़ें हैं और हम उसी के लिए हैं</para>
  <para style="q" vid="1CO 8:6">और एक ही ख़ुदावन्द है या'नी 'ईसा मसीह</para>
  <para style="q" vid="1CO 8:6">जिसके वसीले से सब चीज़ें मौजूद हुईं और हम भी उसी के वसीले से हैं।<verse eid="1CO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7"/>लेकिन सब को ये इल्म नहीं बल्कि कुछ को अब तक बुतपरस्ती की आदत है इसलिए उस गोश्त को बुत की क़ुर्बानी जान कर खाते हैं और उसका दिल, चुँकि कमज़ोर है, गन्दा हो जाता है।<verse eid="1CO 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 8:8"/>खाना हमें ख़ुदा से नहीं मिलाएगा; अगर न खाएँ तो हमारा कुछ नुक़्सान नहीं और अगर खाएँ तो कुछ फ़ाइदा नहीं। <verse eid="1CO 8:8"/><verse number="9" style="v" sid="1CO 8:9"/>लेकिन होशियार रहो ऐसा न हो कि तुम्हारी आज़ादी कमज़ोरों के लिए ठोकर का ज़रिया हो जाए। <verse eid="1CO 8:9"/><verse number="10" style="v" sid="1CO 8:10"/>क्यूँकि अगर कोई तुझ साहिब'ऐ इल्म को बुत खाने में खाना खाते देखे और वो कमज़ोर शख़्स हो तो क्या उस का दिल बुतों की क़ुर्बानी खाने पर मज़बूत न हो जाएगा?<verse eid="1CO 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 8:11"/>ग़रज़ तेरे इल्म की वजह से वो कमज़ोर शख़्स या'नी वो भाई जिसकी ख़ातिर मसीह मरा, हलाक हो जाएगा। <verse eid="1CO 8:11"/><verse number="12" style="v" sid="1CO 8:12"/>और तुम इस तरह भाइयों के गुनाहगार होकर और उनके कमज़ोर दिल को घायल करके मसीह के गुनाहगार ठहरते हो। <verse eid="1CO 8:12"/><verse number="13" style="v" sid="1CO 8:13"/>इस वजह से अगर खाना मेरे भाई को ठोकर खिलाए तो मैं कभी हरगिज़ गोश्त न खाऊँगा, ताकि अपने भाई के लिए ठोकर की वजह न बनूँ।<verse eid="1CO 8:13"/></para>
  <chapter eid="1CO 8"/>
  <chapter number="9" style="c" sid="1CO 9"/>
  <para style="s">पौलुस का अपने हक को छोड़ना</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1"/>क्या मैं आज़ाद नहीं? क्या मैं रसूल नहीं? क्या मैंने 'ईसा को नहीं देखा जो हमारा ख़ुदावन्द है? क्या तुम ख़ुदावन्द में मेरे बनाए हुए नहीं? <verse eid="1CO 9:1"/><verse number="2" style="v" sid="1CO 9:2"/>अगर मैं औरों के लिए रसूल नहीं तो तुम्हारे लिए बे'शक हूँ क्यूँकि तुम ख़ुदावन्द में मेरी रिसालत पर मुहर हो।<verse eid="1CO 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3"/>जो मेरा इम्तिहान करते हैं उनके लिए मेरा यही जवाब है। <verse eid="1CO 9:3"/><verse number="4" style="v" sid="1CO 9:4"/>क्या हमें खाने पीने का इख़्तियार नहीं? <verse eid="1CO 9:4"/><verse number="5" style="v" sid="1CO 9:5"/>क्या हम को ये इख़्तियार नहीं कि किसी मसीह बहन को शादी कर के लिए फिरें, जैसा और रसूल और ख़ुदावन्द के भाई और कैफ़ा करते हैं। <verse eid="1CO 9:5"/><verse number="6" style="v" sid="1CO 9:6"/>या सिर्फ़ मुझे और बरनबास को ही मेहनत मुश्क़्क़त से बाज़ रहने का इख़्तियार नहीं।<verse eid="1CO 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 9:7"/>कौन सा सिपाही कभी अपनी गिरह से खाकर जंग करता है? कौन बाग़ लगाकर उसका फल नहीं खाता या कौन भेड़ों को चरा कर उन भेड़ों का दूध नहीं पीता? <verse eid="1CO 9:7"/><verse number="8" style="v" sid="1CO 9:8"/>क्या मैं ये बातें इंसानी अंदाज़ ही के मुताबिक़ कहता हूँ? क्या तौरेत भी यही नहीं कहती?<verse eid="1CO 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 9:9"/>चुनाँचे मूसा की तौरेत में लिखा है “दाएँ में चलते हुए बैल का मुँह न बाँधना” क्या ख़ुदा को बैलों की फ़िक्र है? <verse eid="1CO 9:9"/><verse number="10" style="v" sid="1CO 9:10"/>या ख़ास हमारे वास्ते ये फ़रमाता है हाँ ये हमारे वास्ते लिखा गया क्यूँकि मुनासिब है कि जोतने वाला उम्मीद पर जोते और दाएँ चलाने वाला हिस्सा पाने की उम्मीद पर दाएँ चलाए। <verse eid="1CO 9:10"/><verse number="11" style="v" sid="1CO 9:11"/>पस जब हम ने तुम्हारे लिए रूहानी चीज़ें बोईं तो क्या ये कोई बड़ी बात है कि हम तुम्हारी जिस्मानी चीज़ों की फ़सल काटें।<verse eid="1CO 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 9:12"/>जब औरों का तुम पर ये इख़्तियार है, तो क्या हमारा इस से ज़्यादा न होगा? लेकिन हम ने इस इख़्तियार से काम नहीं किया; बल्कि हर चीज़ की बर्दाश्त करते हैं, ताकि हमारी वजह मसीह की ख़ुशख़बरी में हर्ज न हो। <verse eid="1CO 9:12"/><verse number="13" style="v" sid="1CO 9:13"/>क्या तुम नहीं जानते कि जो मुक़द्दस चीज़ों की ख़िदमत करते हैं वो हैकल से खाते हैं? और जो क़ुर्बानगाह के ख़िदमत गुज़ार हैं वो क़ुर्बानगाह के साथ हिस्सा पाते हैं? <verse eid="1CO 9:13"/><verse number="14" style="v" sid="1CO 9:14"/>इस तरह ख़ुदावन्द ने भी मुक़र्रर किया है कि ख़ुशख़बरी सुनाने ख़ुशख़बरी वाले के वसीले से गुज़ारा करें।<verse eid="1CO 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15"/>लेकिन मैंने इन में से किसी बात पर अमल नहीं किया और न इस ग़रज़ से ये लिखा कि मेरे वास्ते ऐसा किया जाए; क्यूँकि मेरा मरना ही इस से बेहतर है कि कोई मेरा फ़ख़्र खो दे। <verse eid="1CO 9:15"/><verse number="16" style="v" sid="1CO 9:16"/>अगर ख़ुशख़बरी सुनाऊँ तो मेरा कुछ फ़ख़्र नहीं क्यूँकि ये तो मेरे लिए ज़रूरी बात है बल्कि मुझ पर अफ़सोस है अगर ख़ुशख़बरी न सुनाऊँ।<verse eid="1CO 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 9:17"/>क्यूँकि अगर अपनी मर्ज़ी से ये करता हूँ तो मेरे लिए अज्र है और अगर अपनी मर्ज़ी से नहीं करता तो मुख़्तारी मेरे सुपुर्द हुई है। <verse eid="1CO 9:17"/><verse number="18" style="v" sid="1CO 9:18"/>पस मुझे क्या अज्र मिलता है? ये कि जब इंजील का ऐलान करूँ तो ख़ुशख़बरी को मुफ़्त कर दूँ ताकि जो इख़्तियार मुझे ख़ुशख़बरी के बारे में हासिल है उसके मुवाफ़िक़ पूरा अमल न करूँ।<verse eid="1CO 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19"/>अगरचे मैं सब लोगों से आज़ाद हूँ फिर भी मैंने अपने आपको सबका ग़ुलाम बना दिया है ताकि और भी ज़्यादा लोगों को खींच लाऊँ। <verse eid="1CO 9:19"/><verse number="20" style="v" sid="1CO 9:20"/>मैं यहूदियों के लिए यहूदी बना, ताकि यहूदियों को खींच लाऊँ, जो लोग शरी'अत के मातहत हैं उन के लिए मैं शरी'अत के मातहत हुआ; ताकि शरी'अत के मातहतों को खींच लाऊँ अगरचे ख़ुद शरी'अत के मातहत न था।<verse eid="1CO 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 9:21"/>बेशरा लोगों के लिए बेशरा' बना ताकि बेशरा' लोगों को खींच लाऊँ; (अगरचे ख़ुदा के नज़दीक बेशरा' न था; बल्कि मसीह की शरी'अत के ताबे था) <verse eid="1CO 9:21"/><verse number="22" style="v" sid="1CO 9:22"/>कमज़ोरों के लिए कमज़ोर बना, ताकि कमज़ोरों को खींच लाऊँ; मैं सब आदमियों के लिए सब कुछ बना हुआ हूँ; ताकि किसी तरह से कुछ को बचाऊँ। <verse eid="1CO 9:22"/><verse number="23" style="v" sid="1CO 9:23"/>मैं सब कुछ इन्जील की ख़ातिर करता हूँ, ताकि औरों के साथ उस में शरीक हूँ।<verse eid="1CO 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24"/>क्या तुम नहीं जानते कि दौड़ में दौड़ने वाले दौड़ते तो सभी हैं मगर इन'आम एक ही ले जाता है? तुम भी ऐसा ही दौड़ो ताकि जीतो। <verse eid="1CO 9:24"/><verse number="25" style="v" sid="1CO 9:25"/>हर पहलवान सब तरह का परहेज़ करता है वो लोग तो मुरझाने वाला सेहरा<note caller="+" style="f"><char style="fr" closed="false">9:25 </char><char style="fq" closed="false">सेहरा </char></note> पाने के लिए ये करते हैं मगर हम उस सेहरे के लिए ये करते हैं जो नहीं मुरझाता। <verse eid="1CO 9:25"/><verse number="26" style="v" sid="1CO 9:26"/>पस मैं भी इसी तरह दौड़ता हूँ या'नी बेठिकाना नहीं; मैं इसी तरह मुक्कों से लड़ता हूँ; यानी उस की तरह नहीं जो हवा को मारते हैं। <verse eid="1CO 9:26"/><verse number="27" style="v" sid="1CO 9:27"/>बल्कि मैं अपने बदन को मारता कूटता और उसे क़ाबू में रखता हूँ; ऐसा न हो कि औरों में ऐलान कर के आप ना मक़बूल ठहरूँ।<verse eid="1CO 9:27"/></para>
  <chapter eid="1CO 9"/>
  <chapter number="10" style="c" sid="1CO 10"/>
  <para style="s">इस्राईल की बुतपरस्ती से सीख लेना</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1"/>ऐ भाइयों! मैं तुम्हारा इस से नावाक़िफ़ रहना नहीं चाहता कि हमारे सब बाप दादा बादल के नीचे थे; और सब के सब लाल समुन्दर में से गुज़रे। <verse eid="1CO 10:1"/><verse number="2" style="v" sid="1CO 10:2"/>और सब ही ने उस बादल और समुन्दर में मूसा का बपतिस्मा लिया। <verse eid="1CO 10:2"/><verse number="3" style="v" sid="1CO 10:3"/>और सब ने एक ही रूहानी ख़ुराक खाई। <verse eid="1CO 10:3"/><verse number="4" style="v" sid="1CO 10:4"/>और सब ने एक ही रूहानी पानी पिया क्यूँकि वो उस रूहानी चट्टान में से पानी पीते थे जो उन के साथ साथ चलती थी और वो चट्टान मसीह था।<verse eid="1CO 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 10:5"/>मगर उन में अक्सरों से ख़ुदा राज़ी न हुआ चुनाँचे वो वीराने में ढेर हो गए। <verse eid="1CO 10:5"/><verse number="6" style="v" sid="1CO 10:6"/>ये बातें हमारे लिए इबरत ठहरीं, ताकि हम बुरी चीज़ों की ख़्वाहिश न करें, जैसे उन्हों ने की।<verse eid="1CO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 10:7"/>और तुम बुतपरस्त न बनो जिस तरह कुछ उनमें से बन गए थे चुनाँचे लिखा है। “लोग खाने पीने को बैठे फिर नाचने कूदने को उठे।” <verse eid="1CO 10:7"/><verse number="8" style="v" sid="1CO 10:8"/>और हम हरामकारी न करें जिस तरह उनमें से कुछ ने की, और एक ही दिन में तेईस हज़ार मर गए।<verse eid="1CO 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 10:9"/>और हम ख़ुदा वन्द की आज़माइश न करें जैसे उन में से कुछ ने की और साँपों ने उन्हें हलाक किया। <verse eid="1CO 10:9"/><verse number="10" style="v" sid="1CO 10:10"/>और तुम बड़बड़ाओ नहीं जिस तरह उन में से कुछ बड़बड़ाए और हलाक करने वाले से हलाक हुए।<verse eid="1CO 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11"/>ये बातें उन पर 'इबरत के लिए वाक़े' हुईं और हम आख़री ज़माने वालों की नसीहत के वास्ते लिखी गईं। <verse eid="1CO 10:11"/><verse number="12" style="v" sid="1CO 10:12"/>पस जो कोई अपने आप को क़ाईम समझता है, वो ख़बरदार रहे के गिर न पड़े। <verse eid="1CO 10:12"/><verse number="13" style="v" sid="1CO 10:13"/>तुम किसी ऐसी आज़माइश में न पड़े जो इंसान की आज़माइश से बाहर हो ख़ुदा सच्चा है वो तुम को तुम्हारी ताक़त से ज़्यादा आज़माइश में पड़ने न देगा, बल्कि आज़माइश के साथ निकलने की राह भी पैदा कर देगा, ताकि तुम बर्दाश्त कर सको।<verse eid="1CO 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14"/>इस वजह से ऐ मेरे प्यारो! बुतपरस्ती से भागो। <verse eid="1CO 10:14"/><verse number="15" style="v" sid="1CO 10:15"/>मैं अक़्लमन्द जानकर तुम से कलाम करता हूँ; जो मैं कहता हूँ, तुम आप उसे परखो। <verse eid="1CO 10:15"/><verse number="16" style="v" sid="1CO 10:16"/>वो बर्क़त का प्याला जिस पर हम बर्क़त चाहते हैं क्या मसीह के ख़ून की शराकत नहीं? वो रोटी जिसे हम तोड़ते हैं क्या मसीह के बदन की शराकत नहीं? <verse eid="1CO 10:16"/><verse number="17" style="v" sid="1CO 10:17"/>चूँकि रोटी एक ही है इस लिए हम जो बहुत से हैं एक बदन हैं क्यूँकि हम सब उसी एक रोटी में शरीक होते हैं।<verse eid="1CO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18"/>जो जिस्म के ऐ'तिबार से इस्राईली हैं उन पर नज़र करो क्या क़ुर्बानी का गोश्त खानेवाले क़ुर्बानगाह के शरीक नहीं? <verse eid="1CO 10:18"/><verse number="19" style="v" sid="1CO 10:19"/>पस मैं क्या ये कहता हूँ कि बुतों की क़ुर्बानी कुछ चीज़ है या बुत कुछ चीज़ है?<verse eid="1CO 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 10:20"/>नहीं बल्कि मैं ये कहता हूँ कि जो क़ुर्बानी ग़ैर क़ौमें करती हैं शयातीन के लिए क़ुर्बानी करती हैं; न कि ख़ुदा के लिए, और मैं नहीं चाहता कि तुम शयातीन के शरीक हो। <verse eid="1CO 10:20"/><verse number="21" style="v" sid="1CO 10:21"/>तुम ख़ुदावन्द के प्याले और शयातीन के प्याले दोनों में से नहीं पी सकते; ख़ुदावन्द के दस्तरख़्वान और शयातीन के दस्तरख़्वान दोनों पर शरीक नहीं हो सकते। <verse eid="1CO 10:21"/><verse number="22" style="v" sid="1CO 10:22"/>क्या हम ख़ुदावन्द की ग़ैरत को जोश दिलाते हैं? क्या हम उस से ताक़तवर हैं?<verse eid="1CO 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23"/>सब चीज़ें जाएज़ तो हैं, मगर सब चीज़ें मुफ़ीद नहीं; जाएज़ तो हैं मगर तरक़्क़ी का ज़रिया नहीं। <verse eid="1CO 10:23"/><verse number="24" style="v" sid="1CO 10:24"/>कोई अपनी बेहतरी न ढूँडे बल्कि दूसरे की।<verse eid="1CO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25"/>जो कुछ क़स्साबों की दुकानों में बिकता है वो खाओ और दीनी इम्तियाज़ की वजह से कुछ न पूछो। <verse eid="1CO 10:25"/><verse number="26" style="v" sid="1CO 10:26"/>“क्यूँकि ज़मीन और उसकी मा'मूरी ख़ुदावन्द की है।” <verse eid="1CO 10:26"/><verse number="27" style="v" sid="1CO 10:27"/>अगर बे'ईमानों में से कोई तुम्हारी दा'वत करे और तुम जाने पर राज़ी हो तो जो कुछ तुम्हारे आगे रख्खा जाए उसे खाओ और दीनी इम्तियाज़ की वजह से कुछ न पूछो।<verse eid="1CO 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CO 10:28"/>लेकिन अगर कोई तुम से कहे; ये क़ुर्बानी का गोश्त है, तो उस की वजह से न खाओ। <verse eid="1CO 10:28"/><verse number="29" style="v" sid="1CO 10:29"/>दीनी इम्तियाज़ से मेरा मतलब तेरा इम्तियाज़ नहीं बल्कि उस दूसरे का; भला मेरी आज़ादी दूसरे शख़्स के इम्तियाज़ से क्यूँ परखी जाए? <verse eid="1CO 10:29"/><verse number="30" style="v" sid="1CO 10:30"/>अगर मैं शुक्र कर के खाता हूँ तो जिस चीज़ पर शुक्र करता हूँ उसकी वजह से किस लिए बदनाम किया जाता हूँ?<verse eid="1CO 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31"/>पस तुम खाओ या पियो जो कुछ करो ख़ुदा के जलाल के लिए करो। <verse eid="1CO 10:31"/><verse number="32" style="v" sid="1CO 10:32"/>तुम न यहूदियों के लिए ठोकर का ज़रिया बनो; न यूनानियों के लिए, न ख़ुदा की कलीसिया के लिए। <verse eid="1CO 10:32"/><verse number="33" style="v" sid="1CO 10:33"/>चुनाँचे मैं भी सब बातों में सब को ख़ुश करता हूँ और अपना नहीं बल्कि बहुतों का फ़ाइदा ढूँडता हूँ, ताकि वो नजात पाएँ।<verse eid="1CO 10:33"/></para>
  <chapter eid="1CO 10"/>
  <chapter number="11" style="c" sid="1CO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1"/>तुम मेरी तरह बनो जैसा मैं मसीह की तरह बनता हूँ।<verse eid="1CO 11:1"/></para>
  <para style="s">परस्तिश के लिये हिदायतें</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2"/>मैं तुम्हारी ता'रीफ़ करता हूँ कि तुम हर बात में मुझे याद रखते हो और जिस तरह मैंने तुम्हें रिवायतें पहुँचा दीं, उसी तरह उन को बरक़रार रखो। <verse eid="1CO 11:2"/><verse number="3" style="v" sid="1CO 11:3"/>पस मैं तुम्हें ख़बर करना चाहता हूँ कि हर मर्द का सिर मसीह और 'औरत का सिर मर्द और मसीह का सिर ख़ुदा है। <verse eid="1CO 11:3"/><verse number="4" style="v" sid="1CO 11:4"/>जो मर्द सिर ढके हुए दुआ या नबुव्वत करता है वो अपने सिर को बेहुरमत करता है।<verse eid="1CO 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 11:5"/>और जो 'औरत बे सिर ढके दुआ या नबुव्वत करती है वो अपने सिर को बेहुरमत करती है; क्यूँकि वो सिर मुंडी के बराबर है। <verse eid="1CO 11:5"/><verse number="6" style="v" sid="1CO 11:6"/>अगर 'औरत ओढ़नी न ओढ़े तो बाल भी कटाए; अगर 'औरत का बाल कटाना या सिर मुंडाना शर्म की बात है तो औढ़नी ओढ़े।<verse eid="1CO 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 11:7"/>अलबत्ता मर्द को अपना सिर ढाँकना न चाहिए क्यूँकि वो ख़ुदा की सूरत और उसका जलाल है, मगर 'औरत मर्द का जलाल है। <verse eid="1CO 11:7"/><verse number="8" style="v" sid="1CO 11:8"/>इसलिए कि मर्द 'औरत से नहीं बल्कि 'औरत मर्द से है।<verse eid="1CO 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 11:9"/>और मर्द 'औरत के लिए नहीं बल्कि 'औरत मर्द के लिए पैदा हुई है। <verse eid="1CO 11:9"/><verse number="10" style="v" sid="1CO 11:10"/>पस फ़रिश्तों की वजह से 'औरत को चाहिए कि अपने सिर पर महकूम होने की अलामत<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false">ये सर ढकना इख़्तियार के अन्दर रहने को दिखाता है </char></note> रख्खे।<verse eid="1CO 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 11:11"/>तोभी ख़ुदावन्द में न 'औरत मर्द के बग़ैर है न मर्द 'औरत के बग़ैर। <verse eid="1CO 11:11"/><verse number="12" style="v" sid="1CO 11:12"/>क्यूँकि जैसे 'औरत मर्द से है वैसे ही मर्द भी 'औरत के वसीले से है मगर सब चीज़ें ख़ुदा की तरफ़ से हैं।<verse eid="1CO 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13"/>तुम आप ही इन्साफ़ करो; क्या 'औरत का बे सिर ढाँके ख़ुदा से दुआ करना मुनासिब है। <verse eid="1CO 11:13"/><verse number="14" style="v" sid="1CO 11:14"/>क्या तुम को तब'ई तौर पर भी मा'लूम नहीं कि अगर मर्द लम्बे बाल रख्खे तो उस की बेहुरमती है। <verse eid="1CO 11:14"/><verse number="15" style="v" sid="1CO 11:15"/>अगर 'औरत के लम्बे बाल हों तो उसकी ज़ीनत है, क्यूँकि बाल उसे पर्दे के लिए दिए गए हैं। <verse eid="1CO 11:15"/><verse number="16" style="v" sid="1CO 11:16"/>लेकिन अगर कोई हुज्जती निकले तो ये जान ले कि न हमारा ऐसा दस्तूर है न ख़ुदावन्द की कलीसियाओं का।<verse eid="1CO 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17"/>लेकिन ये हुक्म जो देता हूँ उस में तुम्हारी ता'रीफ़ नहीं करता इसलिए कि तुम्हारे जमा होने से फ़ाइदा नहीं, बल्कि नुक़्सान होता है। <verse eid="1CO 11:17"/><verse number="18" style="v" sid="1CO 11:18"/>क्यूँकि अव्वल तो मैं ये सुनता हूँ कि जिस वक़्त तुम्हारी कलीसिया जमा होती है तो तुम में तफ़्रक़े होते हैं और मैं इसका किसी क़दर यक़ीन भी करता हूँ। <verse eid="1CO 11:18"/><verse number="19" style="v" sid="1CO 11:19"/>क्यूँकि तुम में बिद'अतों का भी होना ज़रूरी है ताकि ज़ाहिर हो जाए कि तुम में मक़बूल कौन से हैं।<verse eid="1CO 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 11:20"/>पस तुम सब एक साथ जमा होते हो तो तुम्हारा वो खाना अशा'ए — रब्बानी नहीं हो सकता। <verse eid="1CO 11:20"/><verse number="21" style="v" sid="1CO 11:21"/>क्यूँकि खाने के वक़्त हर शख़्स दूसरे से पहले अपना हिस्सा खा लेता है और कोई तो भूखा रहता है और किसी को नशा हो जाता है। <verse eid="1CO 11:21"/><verse number="22" style="v" sid="1CO 11:22"/>क्यूँ? खाने पीने के लिए तुम्हारे पास घर नहीं? या ख़ुदा की कलीसिया को ना चीज़ जानते और जिनके पास नहीं उन को शर्मिन्दा करते हो? मैं तुम से क्या कहूँ? क्या इस बात में तुम्हारी ता'रीफ़ करूँ? मैं ता'रीफ़ नहीं करता।<verse eid="1CO 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23"/>क्यूँकि ये बात मुझे ख़ुदावन्द से पहुँची और मैंने तुमको भी पहुँचा दी कि ख़ुदावन्द ईसा ने जिस रात वो पकड़वाया गया रोटी ली। <verse eid="1CO 11:23"/><verse number="24" style="v" sid="1CO 11:24"/>और शुक्र करके तोड़ी और कहा; <char style="wj">लो खाओ ये मेरा बदन है, जो तुम्हारे लिए तोड़ा गया है; मेरी यादगारी के वास्ते यही किया करो।</char><verse eid="1CO 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 11:25"/>इसी तरह उस ने खाने के बाद प्याला भी लिया और कहा, <char style="wj">ये प्याला मेरे ख़ून में नया अहद है जब कभी पियो मेरी यादगारी के लिए यही किया करो।</char> <verse eid="1CO 11:25"/><verse number="26" style="v" sid="1CO 11:26"/>क्यूँकि जब कभी तुम ये रोटी खाते और इस प्याले में से पीते हो तो ख़ुदावन्द की मौत का इज़हार करते हो; जब तक वो न आए।<verse eid="1CO 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27"/>इस वास्ते जो कोई नामुनासिब तौर पर ख़ुदावन्द की रोटी खाए या उसके प्याले में से पिए; वो ख़ुदा वन्द के बदन और ख़ून के बारे में क़ुसूरवार होगा। <verse eid="1CO 11:27"/><verse number="28" style="v" sid="1CO 11:28"/>पस आदमी अपने आप को आज़मा ले और इसी तरह उस रोटी में से खाए और उस प्याले में से पिए। <verse eid="1CO 11:28"/><verse number="29" style="v" sid="1CO 11:29"/>क्यूँकि जो खाते पीते वक़्त ख़ुदा वन्द के बदन को न पहचाने वो इस खाने पीने से सज़ा पाएगा। <verse eid="1CO 11:29"/><verse number="30" style="v" sid="1CO 11:30"/>इसी वजह से तुम में बहुत सारे कमज़ोर और बीमार हैं और बहुत से सो भी गए।<verse eid="1CO 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 11:31"/>अगर हम अपने आप को जाँचते तो सज़ा न पाते। <verse eid="1CO 11:31"/><verse number="32" style="v" sid="1CO 11:32"/>लेकिन ख़ुदा हमको सज़ा देकर तरबियत करता है, ताकि हम दुनिया के साथ मुजरिम न ठहरें।<verse eid="1CO 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33"/>पस ऐ मेरे भाइयों! जब तुम खाने को जमा हो तो एक दूसरे की राह देखो। <verse eid="1CO 11:33"/><verse number="34" style="v" sid="1CO 11:34"/>अगर कोई भूखा हो तो अपने घर में खाले, ताकि तुम्हारा जमा होना सज़ा का ज़रिया न हो; बाक़ी बातों को मैं आकर दुरुस्त कर दूँगा।<verse eid="1CO 11:34"/></para>
  <chapter eid="1CO 11"/>
  <chapter number="12" style="c" sid="1CO 12"/>
  <para style="s">रूहानी तोहफे़</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1"/>ऐ भाइयों! मैं नहीं चाहता कि तुम पाक रूह की ने'मतों के बारे में बेख़बर रहो। <verse eid="1CO 12:1"/><verse number="2" style="v" sid="1CO 12:2"/>तुम जानते हो कि जब तुम ग़ैर क़ौम थे, तो गूँगे बुतों के पीछे जिस तरह कोई तुम को ले जाता था; उसी तरह जाते थे। <verse eid="1CO 12:2"/><verse number="3" style="v" sid="1CO 12:3"/>पस मैं तुम्हें बताता हूँ कि जो कोई ख़ुदा के रूह की हिदायत से बोलता है; वो नहीं कहता कि ईसा मला'ऊन है; और न कोई रूह उल — क़ुद्दूस के बग़ैर कह सकता है कि ईसा ख़ुदावन्द है।<verse eid="1CO 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4"/>नेअ'मतें तो तरह तरह की हैं मगर रूह एक ही है। <verse eid="1CO 12:4"/><verse number="5" style="v" sid="1CO 12:5"/>और ख़िदमतें तो तरह तरह की हैं मगर ख़ुदावन्द एक ही है। <verse eid="1CO 12:5"/><verse number="6" style="v" sid="1CO 12:6"/>और तासीरें भी तरह तरह की हैं मगर ख़ुदा एक ही है जो सब में हर तरह का असर पैदा करता है।<verse eid="1CO 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 12:7"/>लेकिन हर शख़्स में पाक रूह का ज़ाहिर होना फ़ाइदा पहुँचाने के लिए होता है। <verse eid="1CO 12:7"/><verse number="8" style="v" sid="1CO 12:8"/>क्यूँकि एक को रूह के वसीले से हिक्मत का कलाम इनायत होता है और दूसरे को उसी रूह की मर्ज़ी के मुवाफ़िक़ इल्मियत का कलाम।<verse eid="1CO 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 12:9"/>किसी को उसी रूह से ईमान और किसी को उसी रूह से शिफ़ा देने की तौफ़ीक़। <verse eid="1CO 12:9"/><verse number="10" style="v" sid="1CO 12:10"/>किसी को मोजिज़ों की क़ुदरत, किसी को नबुव्वत, किसी को रूहों का इम्तियाज़, किसी को तरह तरह की ज़बाने, किसी को ज़बानों का तर्जुमा करना। <verse eid="1CO 12:10"/><verse number="11" style="v" sid="1CO 12:11"/>लेकिन ये सब तासीरें वही एक रूह करता है; और जिस को जो चाहता है बाँटता है,<verse eid="1CO 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12"/>क्यूँकि जिस तरह बदन एक है और उस के आ'ज़ा बहुत से हैं, और बदन के सब आ'ज़ा गरचे बहुत से हैं, मगर हमसब मिलकर एक ही बदन हैं; उसी तरह मसीह भी है। <verse eid="1CO 12:12"/><verse number="13" style="v" sid="1CO 12:13"/>क्यूँकि हम सब में चाहे यहूदी हों, चाहे यूनानी, चाहे ग़ुलाम, चाहे आज़ाद, एक ही रूह के वसीले से एक बदन होने के लिए बपतिस्मा लिया और हम सब को एक ही रूह पिलाया गया।<verse eid="1CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14"/>चुनाँचे बदन में एक ही आ'ज़ा नहीं बल्कि बहुत से हैं <verse eid="1CO 12:14"/><verse number="15" style="v" sid="1CO 12:15"/>अगर पाँव कहे चुँकि मैं हाथ नहीं इसलिए बदन का नहीं तो वो इस वजह से बदन से अलग तो नहीं। <verse eid="1CO 12:15"/><verse number="16" style="v" sid="1CO 12:16"/>और अगर कान कहे चुँकि मैं आँख नहीं इसलिए बदन का नहीं तो वो इस वजह से बदन से अलग तो नहीं। <verse eid="1CO 12:16"/><verse number="17" style="v" sid="1CO 12:17"/>अगर सारा बदन आँख ही होता तो सुनना कहाँ होता? अगर सुनना ही सुनना होता तो सूँघना कहाँ होता?<verse eid="1CO 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 12:18"/>मगर हक़ीक़त में ख़ुदा ने हर एक 'उज़्व को बदन में अपनी मर्ज़ी के मुवाफ़िक़ रख्खा है। <verse eid="1CO 12:18"/><verse number="19" style="v" sid="1CO 12:19"/>अगर वो सब एक ही 'उज़्व होते तो बदन कहाँ होता? <verse eid="1CO 12:19"/><verse number="20" style="v" sid="1CO 12:20"/>मगर अब आ'ज़ा तो बहुत हैं लेकिन बदन एक ही है।<verse eid="1CO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21"/>पस आँख हाथ से नहीं कह सकती, “मैं तेरी मोहताज नहीं,” और न सिर पाँव से कह सकता है, “मैं तेरा मोहताज नहीं।” <verse eid="1CO 12:21"/><verse number="22" style="v" sid="1CO 12:22"/>बल्कि बदन के वो आ'ज़ा जो औरों से कमज़ोर मा'लूम होते हैं बहुत ही ज़रूरी हैं। <verse eid="1CO 12:22"/><verse number="23" style="v" sid="1CO 12:23"/>और बदन के वो आ'ज़ा जिन्हें हम औरों की तरह ज़लील जानते हैं उन्हीं को ज़्यादा इज़्ज़त देते हैं और हमारे नाज़ेबा आ'ज़ा बहुत ज़ेबा हो जाते हैं। <verse eid="1CO 12:23"/><verse number="24" style="v" sid="1CO 12:24"/>हालाँकि हमारे ज़ेबा आ'ज़ा मोहताज नहीं मगर ख़ुदा ने बदन को इस तरह मुरक्कब किया है, कि जो 'उज़्व मोहताज है उसी को ज़्यादा 'इज़्ज़त दी जाए।<verse eid="1CO 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 12:25"/>ताकि बदन में जुदाई न पड़े, बल्कि आ'ज़ा एक दूसरे की बराबर फ़िक्र रख्खें। <verse eid="1CO 12:25"/><verse number="26" style="v" sid="1CO 12:26"/>पस अगर एक 'उज़्व दुःख पाता है तो सब आ'ज़ा उस के साथ दुःख पाते हैं। <verse eid="1CO 12:26"/><verse number="27" style="v" sid="1CO 12:27"/>इसी तरह तुम मिल कर मसीह का बदन हो और फ़र्दन आ'ज़ा हो।<verse eid="1CO 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CO 12:28"/>और ख़ुदा ने कलीसिया में अलग अलग शख़्स मुक़र्रर किए पहले रसूल दूसरे नबी तीसरे उस्ताद फिर मोजिज़े दिखाने वाले फिर शिफ़ा देने वाले मददगार मुन्तज़िम तरह तरह की ज़बाने बोलने वाले। <verse eid="1CO 12:28"/><verse number="29" style="v" sid="1CO 12:29"/>क्या सब रसूल हैं? क्या सब नबी हैं? क्या सब उस्ताद हैं? क्या सब मोजिज़े दिखानेवाले हैं?<verse eid="1CO 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1CO 12:30"/>क्या सब को शिफ़ा देने की ताक़त हासिल हुई? क्या सब तरह की ज़बाने बोलते हैं? क्या सब तर्जुमा करते हैं? <verse eid="1CO 12:30"/><verse number="31" style="v" sid="1CO 12:31"/>तुम बड़ी से बड़ी ने'मत की आरज़ू रख्खो, लेकिन और भी सब से उम्दा तरीक़ा तुम्हें बताता हूँ।<verse eid="1CO 12:31"/></para>
  <chapter eid="1CO 12"/>
  <chapter number="13" style="c" sid="1CO 13"/>
  <para style="s">महब्बत सबसे बड़ी है</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1"/>अगर मैं आदमियों और फ़रिश्तों की ज़बाने बोलूँ और मुहब्बत न रख्खूँ, तो मैं ठनठनाता पीतल या झनझनाती झाँझ हूँ। <verse eid="1CO 13:1"/><verse number="2" style="v" sid="1CO 13:2"/>और अगर मुझे नबुव्वत मिले और सब भेदों और कुल इल्म की वाक़फ़ियत हो और मेरा ईमान यहाँ तक कामिल हो कि पहाड़ों को हटा दूँ और मुहब्बत न रख़ूँ तो मैं कुछ भी नहीं। <verse eid="1CO 13:2"/><verse number="3" style="v" sid="1CO 13:3"/>और अगर अपना सारा माल ग़रीबों को खिला दूँ या अपना बदन जलाने को दूँ और मुहब्बत न रख्खूँ तो मुझे कुछ भी फ़ाइदा नहीं।<verse eid="1CO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4"/>मुहब्बत साबिर है और मेहरबान, मुहब्बत हसद नहीं करती, मुहब्बत शेख़ी नहीं मारती और फ़ूलती नहीं; <verse eid="1CO 13:4"/><verse number="5" style="v" sid="1CO 13:5"/>नाज़ेबा काम नहीं करती, अपनी बेहतरी नहीं चाहती, झुँझलाती नहीं, बदगुमानी नहीं करती; <verse eid="1CO 13:5"/><verse number="6" style="v" sid="1CO 13:6"/>बदकारी में ख़ुश नहीं होती, बल्कि रास्ती से ख़ुश होती है; <verse eid="1CO 13:6"/><verse number="7" style="v" sid="1CO 13:7"/>सब कुछ सह लेती है, सब कुछ यक़ीन करती है, सब बातों की उम्मीद रखती है, सब बातों में बर्दाश्त करती है।<verse eid="1CO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8"/>मुहब्बत को ज़वाल नहीं, नबुव्वतें हों तो मौक़ूफ़ हो जाएँगी, ज़बाने हों तो जाती रहेंगी; इल्म हो तो मिट जाँएगे। <verse eid="1CO 13:8"/><verse number="9" style="v" sid="1CO 13:9"/>क्यूँकि हमारा इल्म नाक़िस है और हमारी नबुव्वत ना तमाम। <verse eid="1CO 13:9"/><verse number="10" style="v" sid="1CO 13:10"/>लेकिन जब कामिल आएगा तो नाक़िस जाता रहेगा।<verse eid="1CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11"/>जब मैं बच्चा था तो बच्चों की तरह बोलता था बच्चों की सी तबियत थी बच्चो सी समझ थी; लेकिन जब जवान हुआ तो बचपन की बातें तर्क कर दीं। <verse eid="1CO 13:11"/><verse number="12" style="v" sid="1CO 13:12"/>अब हम को आइने में धुन्धला सा दिखाई देता है, मगर जब मसीह दुबारा आएगा तो उस वक़्त रू ब रू देखेंगे; इस वक़्त मेरा इल्म नाक़िस है, मगर उस वक़्त ऐसे पूरे तौर पर पहचानूँगा जैसे मैं पहचानता आया हूँ। <verse eid="1CO 13:12"/><verse number="13" style="v" sid="1CO 13:13"/>ग़रज़ ईमान, उम्मीद, मुहब्बत ये तीनों हमेशा हैं; मगर अफ़ज़ल इन में मुहब्बत है।<verse eid="1CO 13:13"/></para>
  <chapter eid="1CO 13"/>
  <chapter number="14" style="c" sid="1CO 14"/>
  <para style="s">बेगाना ज़बान और नबुवत</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1"/>मुहब्बत के तालिब हो और रूहानी ने'मतों की भी आरज़ू रखो खुसूसन इसकी नबुव्वत करो। <verse eid="1CO 14:1"/><verse number="2" style="v" sid="1CO 14:2"/>क्यूँकि जो बेगाना ज़बान में बातें करता है वो आदमियों से बातें नहीं करता, बल्कि ख़ुदा से; इस लिए कि उसकी कोई नहीं समझता, हालाँकि वो अपनी पाक रूह के वसीले से राज़ की बातें करता है। <verse eid="1CO 14:2"/><verse number="3" style="v" sid="1CO 14:3"/>लेकिन जो नबुव्वत करता है वो आदमियों से तरक़्क़ी और नसीहत और तसल्ली की बातें करता है। <verse eid="1CO 14:3"/><verse number="4" style="v" sid="1CO 14:4"/>जो बेगाना ज़बान में बातें करता है वो अपनी तरक़्क़ी करता है और जो नबुव्वत करता है वो कलीसिया की तरक़्क़ी करता है।<verse eid="1CO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5"/>अगरचे मैं ये चाहता हूँ कि तुम सब बेगाना ज़बान में बातें करो, लेकिन ज़्यादा तर यही चाहता हूँ कि नबुव्वत करो; और अगर बेगाना ज़बाने बोलने वाला कलीसिया की तरक़्क़ी के लिए तर्जुमा न करे, तो नबुव्वत करने वाला उससे बड़ा है।<verse eid="1CO 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6"/>पस ऐ भाइयों! अगर मैं तुम्हारे पास आकर बेगाना ज़बानों में बातें करूँ और मुक़ाशिफ़ा या इल्म या नबुव्वत या ता'लीम की बातें तुम से न कहूँ; तो तुम को मुझ से क्या फ़ाइदा होगा? <verse eid="1CO 14:6"/><verse number="7" style="v" sid="1CO 14:7"/>चुनाँचे बे'जान चीज़ों में से भी जिन से आवाज़ निकलती है, मसलन बाँसुरी या बरबत अगर उनकी आवाज़ों में फ़र्क़ न हो तो जो फूँका या बजाए जाता है वो क्यूँकर पहचाना जाए? <verse eid="1CO 14:7"/><verse number="8" style="v" sid="1CO 14:8"/>और अगर तुरही की आवाज़ साफ़ न हो तो कौन लड़ाई के लिए तैयारी करेगा? <verse eid="1CO 14:8"/><verse number="9" style="v" sid="1CO 14:9"/>ऐसे ही तुम भी अगर ज़बान से कुछ बात न कहो तो जो कहा जाता है क्यूँकर समझा जाएगा? तुम हवा से बातें करनेवाले ठहरोगे।<verse eid="1CO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 14:10"/>दुनिया में चाहे कितनी ही मुख़्तलिफ़ ज़बाने हों उन में से कोई भी बे'मानी न होगी।<verse eid="1CO 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 14:11"/>पस अगर मैं किसी ज़बान के मा' ने ना समझूँ, तो बोलने वाले के नज़दीक मैं अजनबी ठहरूँगा और बोलने वाला मेरे नज़दीक अजनबी ठहरेगा। <verse eid="1CO 14:11"/><verse number="12" style="v" sid="1CO 14:12"/>पस जब तुम रूहानी नेअ'मतों की आरज़ू रखते हो तो ऐसी कोशिश करो, कि तुम्हारी नेअ'मतों की अफ़ज़ूनी से कलीसिया की तरक़्क़ी हो। <verse eid="1CO 14:12"/><verse number="13" style="v" sid="1CO 14:13"/>इस वजह से जो बेगाना ज़बान से बातें करता है वो दुआ करे कि तर्जुमा भी कर सके। <verse eid="1CO 14:13"/><verse number="14" style="v" sid="1CO 14:14"/>इसलिए कि अगर मैं किसी बेगाना ज़बान में दुआ करूँ तो मेरी रूह तो दुआ करती है मगर मेरी अक़्ल बेकार है।<verse eid="1CO 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 14:15"/>पस क्या करना चाहिए? मैं रूह से भी दुआ करूँगा और अक़्ल से भी दुआ करूँगा; रूह से भी गाऊँगा और अक़्ल से भी गाऊँगा। <verse eid="1CO 14:15"/><verse number="16" style="v" sid="1CO 14:16"/>वर्ना अगर तू रूह ही से हम्द करेगा तो नावाक़िफ़ आदमी तेरी शुक्र गुज़ारी पर “आमीन” क्यूँकर कहेगा? इस लिए कि वो नहीं जानता कि तू क्या कहता है।<verse eid="1CO 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 14:17"/>तू तो बेशक अच्छी तरह से शुक्र करता है, मगर दूसरे की तरक़्क़ी नहीं होती। <verse eid="1CO 14:17"/><verse number="18" style="v" sid="1CO 14:18"/>मैं ख़ुदा का शुक्र करता हूँ, कि तुम सब से ज़्यादा ज़बाने बोलता हूँ। <verse eid="1CO 14:18"/><verse number="19" style="v" sid="1CO 14:19"/>लेकिन कलीसिया में बेगाना ज़बान में दस हज़ार बातें करने से मुझे ये ज़्यादा पसन्द है, कि औरों की ता'लीम के लिए पाँच ही बातें अक़्ल से कहूँ।<verse eid="1CO 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20"/>ऐ भाइयों! तुम समझ में बच्चे न बनो; बदी में बच्चे रहो, मगर समझ में जवान बनो। <verse eid="1CO 14:20"/><verse number="21" style="v" sid="1CO 14:21"/>पाक कलाम में लिखा है</para>
  <para style="q" vid="1CO 14:21">ख़ुदावन्द फ़रमाता है,</para>
  <para style="q" vid="1CO 14:21">“मैं बेगाना ज़बान और बेगाना होंटों से</para>
  <para style="q" vid="1CO 14:21">इस उम्मत से बातें करूँगा</para>
  <para style="q" vid="1CO 14:21">तोभी वो मेरी न सुनेंगे।”<verse eid="1CO 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22"/>पस बेगाना ज़बाने ईमानदारों के लिए नहीं बल्कि बे'ईमानों के लिए निशान हैं और नबुव्वत बे'ईमानों के लिए नहीं, बल्कि ईमानदारों के लिए निशान है। <verse eid="1CO 14:22"/><verse number="23" style="v" sid="1CO 14:23"/>पस अगर सारी कलीसिया एक जगह जमा हो और सब के सब बेगाना ज़बाने बोलें और नावाक़िफ़ या बे'ईमान लोग अन्दर आ जाएँ, तो क्या वो तुम को दिवाना न कहेंगे।<verse eid="1CO 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 14:24"/>लेकिन अगर जब नबुव्वत करें और कोई बे'ईमान या नावाक़िफ़ अन्दर आ जाए, तो सब उसे क़ायल कर देंगे और सब उसे परख लेंगे; <verse eid="1CO 14:24"/><verse number="25" style="v" sid="1CO 14:25"/>और उसके दिल के राज़ ज़ाहिर हो जाएँगे; तब वो मुँह के बल गिर कर सज्दा करेगा, और इक़रार करेगा कि बेशक ख़ुदा तुम में है।<verse eid="1CO 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26"/>पस ऐ भाइयों! क्या करना चाहिए? जब तुम जमा होते हो, तो हर एक के दिल में मज़्मूर या ता'लीम या मुक़ाशिफ़ा, या बेगाना, ज़बान या तर्जुमा होता है; सब कुछ रूहानी तरक़्क़ी के लिए होना चाहिए। <verse eid="1CO 14:26"/><verse number="27" style="v" sid="1CO 14:27"/>अगर बेगाना ज़बान में बातें करना हो तो दो दो या ज़्यादा से ज़्यादा तीन तीन शख़्स बारी बारी से बोलें और एक शख़्स तर्जुमा करे। <verse eid="1CO 14:27"/><verse number="28" style="v" sid="1CO 14:28"/>और अगर कोई तर्जुमा करने वाला न हो तो बेगाना ज़बान बोलनेवाला कलीसिया में चुप रहे और अपने दिल से और ख़ुदा से बातें करे।<verse eid="1CO 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29"/>नबियों में से दो या तीन बोलें और बाक़ी उनके कलाम को परखें। <verse eid="1CO 14:29"/><verse number="30" style="v" sid="1CO 14:30"/>लेकिन अगर दूसरे पास बैठने वाले पर वही उतरे तो पहला ख़ामोश हो जाए।<verse eid="1CO 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 14:31"/>क्यूँकि तुम सब के सब एक एक करके नबुव्वत करते हो, ताकि सब सीखें और सब को नसीहत हो। <verse eid="1CO 14:31"/><verse number="32" style="v" sid="1CO 14:32"/>और नबियों की रूहें नबियों के ताबे हैं। <verse eid="1CO 14:32"/><verse number="33" style="v" sid="1CO 14:33"/>क्यूँकि ख़ुदा अबतरी का नहीं, बल्कि सुकून का बानी है</para>
  <para style="p" vid="1CO 14:33">जैसा मुक़द्दसों की सब कलीसियाओं में है। <verse eid="1CO 14:33"/><verse number="34" style="v" sid="1CO 14:34"/>औरतें कलीसिया के मज्मे में ख़ामोश रहें, क्यूँकि उन्हें बोलने का हुक्म नहीं बल्कि ताबे रहें जैसा तौरेत में भी लिखा है। <verse eid="1CO 14:34"/><verse number="35" style="v" sid="1CO 14:35"/>और अगर कुछ सीखना चाहें तो घर में अपने अपने शौहर से पूछें, क्यूँकि औरत का कलीसिया के मज्मे में बोलना शर्म की बात है। <verse eid="1CO 14:35"/><verse number="36" style="v" sid="1CO 14:36"/>क्या ख़ुदा का कलाम तुम में से निकला या सिर्फ़ तुम ही तक पहुँचा है।<verse eid="1CO 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="1CO 14:37"/>अगर कोई अपने आपको नबी या रूहानी समझे तो ये जान ले कि जो बातें मैं तुम्हें लिखता हूँ वो ख़ुदावन्द के हुक्म हैं। <verse eid="1CO 14:37"/><verse number="38" style="v" sid="1CO 14:38"/>और अगर कोई न जाने तो न जानें।<verse eid="1CO 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39"/>पस ऐ भाइयों! नबुव्वत करने की आरज़ू रख्खो और ज़बाने बोलने से मनह न करो। <verse eid="1CO 14:39"/><verse number="40" style="v" sid="1CO 14:40"/>मगर सब बातें शाइस्तगी और क़रीने के साथ अमल में लाएँ।<verse eid="1CO 14:40"/></para>
  <chapter eid="1CO 14"/>
  <chapter number="15" style="c" sid="1CO 15"/>
  <para style="s">मसीह का फिर से ज़िन्दा होना</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1"/>ऐ भाइयों! मैं तुम्हें वही ख़ुशख़बरी बताए देता हूँ जो पहले दे चुका हूँ जिसे तुम ने क़बूल भी कर लिया था और जिस पर क़ाईम भी हो। <verse eid="1CO 15:1"/><verse number="2" style="v" sid="1CO 15:2"/>उसी के वसीले से तुम को नजात भी मिली है बशर्ते कि वो ख़ुशख़बरी जो मैंने तुम्हें दी थी याद रखते हो वर्ना तुम्हारा ईमान लाना बेफ़ाइदा हुआ।<verse eid="1CO 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3"/>चुनाँचे मैंने सब से पहले तुम को वही बात पहुँचा दी जो मुझे पहुँची थी; कि मसीह किताब — ए — 'मुक़द्दस के मुताबिक़ हमारे गुनाहों के लिए मरा। <verse eid="1CO 15:3"/><verse number="4" style="v" sid="1CO 15:4"/>और दफ़्न हुआ और तीसरे दिन किताब ऐ'मुक़द्दस के मुताबिक़ जी उठा।<verse eid="1CO 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 15:5"/>और कैफ़ा और उस के बाद उन बारह को दिखाई दिया। <verse eid="1CO 15:5"/><verse number="6" style="v" sid="1CO 15:6"/>फिर पाँच सौ से ज़्यादा भाइयों को एक साथ दिखाई दिया जिन में अक्सर अब तक मौजूद हैं और कुछ सो गए। <verse eid="1CO 15:6"/><verse number="7" style="v" sid="1CO 15:7"/>फिर या'क़ूब को दिखाई दिया फिर सब रसूलों को।<verse eid="1CO 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8"/>और सब से पीछे मुझ को जो गोया अधूरे दिनों की पैदाइश हूँ दिखाई दिया। <verse eid="1CO 15:8"/><verse number="9" style="v" sid="1CO 15:9"/>क्यूँकि मैं रसूलों में सब से छोटा हूँ, बल्कि रसूल कहलाने के लायक़ नहीं इसलिए कि मैने ख़ुदा की कलीसिया को सताया था।<verse eid="1CO 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 15:10"/>लेकिन जो कुछ हूँ ख़ुदा के फ़ज़ल से हूँ और उसका फ़ज़ल जो मुझ पर हुआ वो बेफ़ाइदा नहीं हुआ बल्कि मैंने उन सब से ज़्यादा मेहनत की और ये मेरी तरफ़ से नहीं हुई बल्कि ख़ुदा के फ़ज़ल से जो मुझ पर था। <verse eid="1CO 15:10"/><verse number="11" style="v" sid="1CO 15:11"/>पस चाहे मैं हूँ चाहे वो हों हम यही ऐलान करते हैं और इसी पर तुम ईमान भी लाए।<verse eid="1CO 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12"/>पस जब मसीह की ये मनादी की जाती है कि वो मुर्दों में से जी उठा तो तुम में से कुछ इस तरह कहते हैं कि मुर्दों की क़यामत है ही नहीं। <verse eid="1CO 15:12"/><verse number="13" style="v" sid="1CO 15:13"/>अगर मुर्दों की क़यामत नहीं तो मसीह भी नहीं जी उठा है। <verse eid="1CO 15:13"/><verse number="14" style="v" sid="1CO 15:14"/>और अगर मसीह नहीं जी उठा तो हमारी मनादी भी बेफ़ाइदा है और तुम्हारा ईमान भी बेफ़ाइदा है।<verse eid="1CO 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 15:15"/>बल्कि हम ख़ुदा के झूठे गवाह ठहरे क्यूँकि हम ने ख़ुदा के बारे में ये गवाही दी कि उसने मसीह को जिला दिया हालाँकि नहीं जिलाया अगर बिलफ़र्ज़ मुर्दे नहीं जी उठते। <verse eid="1CO 15:15"/><verse number="16" style="v" sid="1CO 15:16"/>और अगर मुर्दे नहीं जी उठते तो मसीह भी नहीं जी उठा। <verse eid="1CO 15:16"/><verse number="17" style="v" sid="1CO 15:17"/>और अगर मसीह नहीं जी उठा तो तुम्हारा ईमान बे'फ़ाइदा है तुम अब तक अपने गुनाहों में गिरफ़्तार हो।<verse eid="1CO 15:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 15:18"/>बल्कि जो मसीह में सो गए हैं वो भी हलाक हुए। <verse eid="1CO 15:18"/><verse number="19" style="v" sid="1CO 15:19"/>अगर हम सिर्फ़ इसी ज़िन्दगी में मसीह में उम्मीद रखते हैं तो सब आदमियों से ज़्यादा बदनसीब हैं।<verse eid="1CO 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20"/>लेकिन फ़िलवक़्त मसीह मुर्दों में से जी उठा है और जो सो गए हैं उन में पहला फल हुआ। <verse eid="1CO 15:20"/><verse number="21" style="v" sid="1CO 15:21"/>क्यूँकि अब आदमी की वजह से मौत आई तो आदमी की वजह से मुर्दों की क़यामत भी आई।<verse eid="1CO 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 15:22"/>और जैसे आदम में सब मरते हैं वैसे ही मसीह में सब ज़िन्दा किए जाएँगे। <verse eid="1CO 15:22"/><verse number="23" style="v" sid="1CO 15:23"/>लेकिन हर एक अपनी अपनी बारी से; पहला फल मसीह फिर मसीह के आने पर उसके लोग।<verse eid="1CO 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 15:24"/>इसके बाद आख़िरत होगी; उस वक़्त वो सारी हुकूमत और सारा इख़्तियार और क़ुदरत नेस्त करके बादशाही को ख़ुदा या'नी बाप के हवाले कर देगा। <verse eid="1CO 15:24"/><verse number="25" style="v" sid="1CO 15:25"/>क्यूँकि जब तक कि वो सब दुश्मनों को अपने पाँव तले न ले आए उस को बादशाही करना ज़रूरी है। <verse eid="1CO 15:25"/><verse number="26" style="v" sid="1CO 15:26"/>सब से पिछला दुश्मन जो नेस्त किया जाएगा वो मौत है।<verse eid="1CO 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 15:27"/>क्यूँकि ख़ुदा ने सब कुछ उसके पाँव तले कर दिया है; मगर जब वो फ़रमाता है कि सब कुछ उसके ताबे' कर दिया गया तो ज़ाहिर है कि जिसने सब कुछ उसके ताबे कर दिया; वो अलग रहा। <verse eid="1CO 15:27"/><verse number="28" style="v" sid="1CO 15:28"/>और जब सब कुछ उसके ताबे' कर दिया जाएगा तो बेटा ख़ुद उसके ताबे' हो जाएगा जिसने सब चीज़ें उसके ताबे' कर दीं ताकि सब में ख़ुदा ही सब कुछ है।<verse eid="1CO 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29"/>वर्ना जो लोग मुर्दों के लिए बपतिस्मा लेते हैं; वो क्या करेंगे? अगर मुर्दे जी उठते ही नहीं तो फिर क्यूँ उन के लिए बपतिस्मा लेते हो? <verse eid="1CO 15:29"/><verse number="30" style="v" sid="1CO 15:30"/>और हम क्यूँ हर वक़्त ख़तरे में पड़े रहते हैं?<verse eid="1CO 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 15:31"/>ऐ भाइयों! उस फ़ख़्र की क़सम जो हमारे ईसा मसीह में तुम पर है में हर रोज़ मरता हूँ। <verse eid="1CO 15:31"/><verse number="32" style="v" sid="1CO 15:32"/>जैसा कि कलाम में लिखा है कि अगर मैं इंसान की तरह इफ़िसुस में दरिन्दों से लड़ा तो मुझे क्या फ़ाइदा? अगर मुर्दे न जिलाए जाएँगे “तो आओ खाएँ पीएँ क्यूँकि कल तो मर ही जाएँगे।”<verse eid="1CO 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33"/>धोखा न खाओ “बुरी सोहबतें अच्छी आदतों को बिगाड़ देती हैं।”<verse eid="1CO 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CO 15:34"/>रास्तबाज़ होने के लिए होश में आओ और गुनाह न करो, क्यूँकि कुछ ख़ुदा से नावाक़िफ़ हैं; मैं तुम्हें शर्म दिलाने को ये कहता हूँ।<verse eid="1CO 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35"/>अब कोई ये कहेगा, “मुर्दे किस तरह जी उठते हैं? और कैसे जिस्म के साथ आते हैं?” <verse eid="1CO 15:35"/><verse number="36" style="v" sid="1CO 15:36"/>ऐ, नादान! तू ख़ुद जो कुछ बोता है जब तक वो न मरे ज़िन्दा नहीं किया जाता।<verse eid="1CO 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="1CO 15:37"/>और जो तू बोता है, ये वो जिस्म नहीं जो पैदा होने वाला है बल्कि सिर्फ़ दाना है; चाहे गेहूँ का चाहे किसी और चीज़ का। <verse eid="1CO 15:37"/><verse number="38" style="v" sid="1CO 15:38"/>मगर ख़ुदा ने जैसा इरादा कर लिया वैसा ही उसको जिस्म देता है और हर एक बीज को उसका ख़ास जिस्म। <verse eid="1CO 15:38"/><verse number="39" style="v" sid="1CO 15:39"/>सब गोश्त एक जैसा गोश्त नहीं; बल्कि आदमियों का गोश्त और है, चौपायों का गोश्त और; परिन्दों का गोश्त और है मछलियों का गोश्त और।<verse eid="1CO 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40"/>आसमानी भी जिस्म हैं, और ज़मीनी भी मगर आसमानियों का जलाल और है, और ज़मीनियों का और। <verse eid="1CO 15:40"/><verse number="41" style="v" sid="1CO 15:41"/>आफ़ताब का जलाल और है, माहताब का जलाल और, सितारों का जलाल और, क्यूँकि सितारे सितारे के जलाल में फ़र्क़ है।<verse eid="1CO 15:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42"/>मुर्दों की क़यामत भी ऐसी ही है; जिस्म फ़ना की हालत में बोया जाता है, और हमेशा की हालत में जी उठता है। <verse eid="1CO 15:42"/><verse number="43" style="v" sid="1CO 15:43"/>बेहुरमती की हालत में बोया जाता है, और जलाल की हालत में जी उठता है, कमज़ोरी की हालत में बोया जाता है और क़ुव्वत की हालत में जी उठता है। <verse eid="1CO 15:43"/><verse number="44" style="v" sid="1CO 15:44"/>नफ़्सानी जिस्म बोया जाता है, और रूहानी जिस्म जी उठता है जब नफ़्सानी जिस्म है तो रूहानी जिस्म भी है।<verse eid="1CO 15:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1CO 15:45"/>चुनाँचे कलाम लिखा भी है, “पहला आदमी या'नी आदम ज़िन्दा नफ़्स बना पिछला आदम ज़िन्दगी बख़्शने वाली रूह बना।” <verse eid="1CO 15:45"/><verse number="46" style="v" sid="1CO 15:46"/>लेकिन रूहानी पहले न था बल्कि नफ़्सानी था इसके बाद रूहानी हुआ।<verse eid="1CO 15:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="1CO 15:47"/>पहला आदमी ज़मीन से या'नी ख़ाकी था दूसरा आदमी आसमानी है। <verse eid="1CO 15:47"/><verse number="48" style="v" sid="1CO 15:48"/>जैसा वो ख़ाकी था वैसे ही और ख़ाकी भी हैं और जैसा वो आसमानी है वैसे ही और आसमानी भी हैं। <verse eid="1CO 15:48"/><verse number="49" style="v" sid="1CO 15:49"/>और जिस तरह हम इस ख़ाकी की सूरत पर हुए उसी तरह उस आसमानी की सूरत पर भी होंगे।<verse eid="1CO 15:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50"/>ऐ भाइयों! मेरा मतलब ये है कि गोश्त और ख़ून ख़ुदा की बादशाही के वारिस नहीं हो सकते और न फ़ना बक़ा की वारिस हो सकती है। <verse eid="1CO 15:50"/><verse number="51" style="v" sid="1CO 15:51"/>देखो मैं तुम से राज़ की बात कहता हूँ हम सब तो नहीं सोएँगे मगर सब बदल जाएँगे।<verse eid="1CO 15:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="1CO 15:52"/>और ये एक दम में, एक पल में पिछला नरसिंगा फूँकते ही होगा क्यूँकि नरसिंगा फूँका जाएगा और मुर्दे ग़ैर फ़ानी हालत में उठेंगे और हम बदल जाएँगे। <verse eid="1CO 15:52"/><verse number="53" style="v" sid="1CO 15:53"/>क्यूँकि ज़रूरी है कि ये फ़ानी जिस्म बक़ा का जामा पहने और ये मरने वाला जिस्म हमेशा की ज़िन्दगी का जामा पहने।<verse eid="1CO 15:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="1CO 15:54"/>जब ये फ़ानी जिस्म बक़ा का जामा पहन चुकेगा और ये मरने वाला जिस्म हमेशा हमेशा का जामा पहन चुकेगा तो वो क़ौल पूरा होगा जो कलाम लिखा है</para>
  <para style="q" vid="1CO 15:54">“मौत फ़तह का लुक़्मा हो जाएगी।<verse eid="1CO 15:54"/></para>
  <para style="q">
    <verse number="55" style="v" sid="1CO 15:55"/>ऐ मौत तेरी फ़तह कहाँ रही?</para>
  <para style="q" vid="1CO 15:55">ऐ मौत तेरा डंक कहाँ रहा?”<verse eid="1CO 15:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="1CO 15:56"/>मौत का डंक गुनाह है और गुनाह का ज़ोर शरी'अत है। <verse eid="1CO 15:56"/><verse number="57" style="v" sid="1CO 15:57"/>मगर ख़ुदा का शुक्र है, जो हमारे ख़ुदावन्द 'ईसा मसीह के वसीले से हम को फ़तह बख्शता है।<verse eid="1CO 15:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58"/>पस ऐ मेरे अज़ीज़ भाइयों! साबित क़दम और क़ाईम रहो और ख़ुदावन्द के काम में हमेशा बढ़ते रहो क्यूँकि ये जानते हो कि तुम्हारी मेहनत ख़ुदावन्द में बेफ़ाइदा नहीं है।<verse eid="1CO 15:58"/></para>
  <chapter eid="1CO 15"/>
  <chapter number="16" style="c" sid="1CO 16"/>
  <para style="s">यरुशलेम के लिये हदिया इकठ्ठा करना</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1"/>अब उस चन्दे के बारे में जो मुक़द्दसों के लिए किया जाता है; जैसा मैं ने ग़लतिया की कलीसियाओं को हुक्म दिया वैसे ही तुम भी करो। <verse eid="1CO 16:1"/><verse number="2" style="v" sid="1CO 16:2"/>हफ़्ते के पहले दिन तुम में से हर शख़्स अपनी आमदनी के मुवाफ़िक़ कुछ अपने पास रख छोड़ा करे ताकि मेरे आने पर चन्दा न करना पड़े।<verse eid="1CO 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 16:3"/>और जब मैं आऊँगा तो जिन्हें तुम मंज़ूर करोगे उनको मैं ख़त देकर भेज दूँगा कि तुम्हारी ख़ैरात येरूशलेम को पहुँचा दें। <verse eid="1CO 16:3"/><verse number="4" style="v" sid="1CO 16:4"/>अगर मेरा भी जाना मुनासिब हुआ तो वो मेरे साथ जाएँगे।<verse eid="1CO 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5"/>मैं मकिदुनिया होकर तुम्हारे पास आऊँगा; क्यूँकि मुझे मकिदुनिया हो कर जाना तो है ही। <verse eid="1CO 16:5"/><verse number="6" style="v" sid="1CO 16:6"/>मगर रहूँगा शायद तुम्हारे पास और जाड़ा भी तुम्हारे पास ही काटूँ ताकि जिस तरफ़ मैं जाना चाहूँ तुम मुझे उस तरफ़ रवाना कर दो।<verse eid="1CO 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 16:7"/>क्यूँकि मैं अब राह में तुम से मुलाक़ात करना नहीं चाहता बल्कि मुझे उम्मीद है कि ख़ुदावन्द ने चाहा तो कुछ अरसे तुम्हारे पास रहूँगा। <verse eid="1CO 16:7"/><verse number="8" style="v" sid="1CO 16:8"/>लेकिन मैं ईद'ए पिन्तेकुस्त तक इफ़िसुस में रहूँगा। <verse eid="1CO 16:8"/><verse number="9" style="v" sid="1CO 16:9"/>क्यूँकि मेरे लिए एक वसी' और कार आमद दरवाज़ा खुला है और मुख़ालिफ़ बहुत से हैं।<verse eid="1CO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10"/>अगर तीमुथियुस आ जाए तो ख्याल रखना कि वो तुम्हारे पास बेख़ौफ़ रहे क्यूँकि वो मेरी तरह ख़ुदावन्द का काम करता है। <verse eid="1CO 16:10"/><verse number="11" style="v" sid="1CO 16:11"/>पस कोई उसे हक़ीर न जाने बल्कि उसको सही सलामत इस तरफ़ रवाना करना कि मेरे पास आजाए क्यूँकि मैं मुन्तज़िर हूँ कि वो भाइयों समेत आए। <verse eid="1CO 16:11"/><verse number="12" style="v" sid="1CO 16:12"/>और भाई अपुल्लोस से मैंने बहुत इल्तिमास किया कि तुम्हारे पास भाइयों के साथ जाए; मगर इस वक़्त जाने पर वो अभी राज़ी न हुआ लेकिन जब उस को मौक़ा मिलेगा तो जाएगा।<verse eid="1CO 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13"/>जागते रहो ईमान में क़ाईम रहो मर्दानगी करो मज़बूत हो। <verse eid="1CO 16:13"/><verse number="14" style="v" sid="1CO 16:14"/>जो कुछ करते हो मुहब्बत से करो।<verse eid="1CO 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15"/>ऐ भाइयों! तुम स्तिफ़नास के ख़ानदान को जानते हो कि वो अख़िया के पहले फल हैं और मुक़द्दसों की ख़िदमत के लिए तैयार रहते हैं। <verse eid="1CO 16:15"/><verse number="16" style="v" sid="1CO 16:16"/>पस मैं तुम से इल्तिमास करता हूँ कि ऐसे लोगों के ताबे रहो बल्कि हर एक के जो इस काम और मेहनत में शरीक हैं।<verse eid="1CO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17"/>और मैं स्तिफ़नास और फ़रतूनातूस और अख़ीकुस के आने से ख़ुश हूँ क्यूँकि जो तुम में से रह गया था उन्होंने पूरा कर दिया। <verse eid="1CO 16:17"/><verse number="18" style="v" sid="1CO 16:18"/>और उन्होंने मेरी और तुम्हारी रूह को ताज़ा किया पस ऐसों को मानो।<verse eid="1CO 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19"/>आसिया की कलीसिया तुम को सलाम कहती है अक्विला और प्रिस्का उस कलीसिया समेत जो उन के घर में हैं, तुम्हें ख़ुदावन्द में बहुत बहुत सलाम कहते हैं। <verse eid="1CO 16:19"/><verse number="20" style="v" sid="1CO 16:20"/>सब भाई तुम्हें सलाम कहते हैं पाक बोसा लेकर आपस में सलाम करो।<verse eid="1CO 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21"/>मैं पौलुस अपने हाथ से सलाम लिखता हूँ। <verse eid="1CO 16:21"/><verse number="22" style="v" sid="1CO 16:22"/>जो कोई ख़ुदावन्द को अज़ीज़ नहीं रखता मला'ऊन हो हमारा ख़ुदावन्द आने वाला है। <verse eid="1CO 16:22"/><verse number="23" style="v" sid="1CO 16:23"/>ख़ुदावन्द ईसा मसीह का फ़ज़ल तुम पर होता रहे। <verse eid="1CO 16:23"/><verse number="24" style="v" sid="1CO 16:24"/>मेरी मुहब्बत ईसा मसीह में तुम सब से रहे। आमीन।<verse eid="1CO 16:24"/></para>
  <chapter eid="1CO 16"/>
</usx>
