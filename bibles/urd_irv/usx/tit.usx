<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="TIT" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">तितुस</para>
  <para style="toc1">तितुस</para>
  <para style="toc2">तितु</para>
  <para style="toc3">तितु</para>
  <para style="mt">तितुस के नाम पौलुस रसूल का ख़त</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">1 पौलूस ने ख़ुद ही तितुस के नाम ख़त के लिए मुसन्निफ़ होने की पहचान कराई इस बतौर कि पौलूस की तरफ़ से जो “ख़ुदा का बन्दा और येसू मसीह का रसूल है।” (1:1) तितुस के साथ पौलूस के शुरूआती रिश्ते को भेद बतौर पर्दे में रखा गया था। हालांकि हम इसे जमा कर सकते हैं कि वह पीलूस की खि़दमत का फल है पौलूस की मनादी के ज़रिए वह मसीह में आया था। चुनांचि वह कहता है ईमान की शिर्कत के रू से सच्चे फ़र्ज़न्द तितुस के नाम (1:4) पौलूस साफ़ तौर से तीतुस को एक ओहदे में लेकर एक दोस्त और इन्जील की मनादी में साथ काम करने वाला बतौर कहकर उसे बड़ी इज़्ज़त देता हें उसकी शफ़क़त, मुस्तअदी, और दूसरों को तसल्ली देने वाला बतौर उसकी तारीफ़ करता है।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इसके लिखे जाने की तारीख़ तक़रीबन 63 - 65 ईस्वी के बीच है।</para>
  <para style="ip">असल मक़सूद पौलूस ने तितुस के नाम अपना ख़त पहली बार रोम के क़ैद से छूटने के बाद लिखा।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">यह ख़त तितुस को लिखा गया, एक और पौलूस का हम खि़दमत, मसीह में उसका फ़र्ज़न्द जिस को उस ने करेते में छोड़ा था।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">करेते की नई कलीसियाओं में जो कमियां थीं उन्हें सुधारने की बाबत तीतुस को नसीहत देने के लिए, कलीसिया नये बुज़ूर्गों की तक़र्रुरी के लिए, करेते में ग़ैर ईमान्दारों के सामने ईमान की अच्छी गवाही के वासते तैयार करने के लिए।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">चालचलन का किताब।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. सलाम — 1:1-4</para>
  <para style="io1">2. बुज़ुर्गों की तक़र्रूरी — 1:5-16</para>
  <para style="io1">3. फ़रक़ फ़रक़ उम्र वालां को हिदायात — 2:1-3:11</para>
  <para style="io1">4. इख़तितामी मुलाहज़ा — 3:12-15</para>
  <chapter number="1" style="c" sid="TIT 1"/>
  <para style="s">पौलुस का सलाम</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1"/>पौलुस की तरफ़ से तीतुस को ख़त, जो ख़ुदा का बन्दा और 'ईसा मसीह का रसूल है। ख़ुदा के बरगुज़ीदों के ईमान और उस हक़ की पहचान के मुताबिक़ जो दीनदारी के मुताबिक़ है। <verse eid="TIT 1:1"/><verse number="2" style="v" sid="TIT 1:2"/>उस हमेशा की ज़िन्दगी की उम्मीद पर जिसका वा'दा शुरू ही से ख़ुदा ने किया है जो झूठ नहीं बोल सकता। <verse eid="TIT 1:2"/><verse number="3" style="v" sid="TIT 1:3"/>और उस ने मुनासिब वक़्तों पर अपने कलाम को जो हमारे मुन्जी ख़ुदा के हुक्म के मुताबिक़ मेरे सुपुर्द हुआ।<verse eid="TIT 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4"/>ईमान की शिरकत के रूह से सच्चे फ़र्ज़न्द तितुस के नाम फ़ज़ल और इत्मीनान ख़ुदा बाप और हमारे मुन्जी 'ईसा मसीह की तरफ़ से तुझे हासिल होता रहे।<verse eid="TIT 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5"/>मैंने तुझे करेते में इस लिए छोड़ा था, कि तू बक़िया बातों को दुरुस्त करे और मेरे हुक्म के मुताबिक़ शहर बा शहर ऐसे बुज़ुर्गों को मुक़र्रर करे।<verse eid="TIT 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 1:6"/>जो बे इल्ज़ाम और एक एक बीवी के शौहर हों और उन के बच्चे ईमान्दार और बदचलनी और सरकशी के इल्ज़ाम से पाक हों। <verse eid="TIT 1:6"/><verse number="7" style="v" sid="TIT 1:7"/>क्यूँकि निगहबान को ख़ुदा का मुख़्तार होने की वजह से बेइल्ज़ाम होना चाहिए; न ख़ुदराय हो न ग़ुस्सावर, न नशे में ग़ुल मचानेवाला, न मार पीट करने वाला और न नाजायज़ नफ़े का लालची;<verse eid="TIT 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="TIT 1:8"/>बल्कि मुसाफ़िर परवर, ख़ैर दोस्त, परहेज़गार, मुन्सिफ़ मिज़ाज, पाक और सब्र करने वाला हो; <verse eid="TIT 1:8"/><verse number="9" style="v" sid="TIT 1:9"/>और ईमान के कलाम पर जो इस ता'लीम के मुवाफ़िक़ है क़ाईम हो ताकि सही ता'लीम के साथ नसीहत भी कर सके और मुख़ालिफ़ों को क़ायल भी कर सके।<verse eid="TIT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10"/>क्यूँकि बहुत से लोग सरकश और बेहूदा गो और दग़ाबाज़ हैं ख़ासकर ईमानदार यहूदी मख़्तूनों में से। <verse eid="TIT 1:10"/><verse number="11" style="v" sid="TIT 1:11"/>इन का मुँह बन्द करना चाहिए ये लोग नाजायज़ नफ़े की ख़ातिर नशाइस्ता बातें सीखकर घर के घर तबाह कर देते हैं।<verse eid="TIT 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 1:12"/>उन ही में से एक शख़्स ने कहा है, जो ख़ास उन का नबी था “करेती हमेशा झूठे, मूज़ी जानवर, वादा ख़िलाफ़ होते हैं।” <verse eid="TIT 1:12"/><verse number="13" style="v" sid="TIT 1:13"/>ये गवाही सच है, पस, उन्हें सख़्त मलामत किया कर ताकि उन का ईमान दुरुस्त होजाए।<verse eid="TIT 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="TIT 1:14"/>और वो यहूदियों की कहानियों और उन आदमियों के हुक्मों पर तवज्जह न करें, जो हक़ से गुमराह होते हैं।<verse eid="TIT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 1:15"/>पाक लोगों के लिए सब चीज़ें पाक हैं, मगर गुनाह आलूदा और बेईमान लोगों के लिए कुछ भी पाक नहीं, बल्कि उन की 'अक़्ल और दिल दोनों गुनाह आलूदा हैं। <verse eid="TIT 1:15"/><verse number="16" style="v" sid="TIT 1:16"/>वो ख़ुदा की पहचान का दा'वा तो करते है, मगर अपने कामों से उसका इन्कार करते हैं क्यूँकि वो मकरूह और नाफ़रमान हैं, और किसी नेक काम के काबिल नहीं।<verse eid="TIT 1:16"/></para>
  <chapter eid="TIT 1"/>
  <chapter number="2" style="c" sid="TIT 2"/>
  <para style="s">सही ता'लीम को बढ़ाना</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1"/>और तू वो बातें बयान कर जो सही ता'लीम के मुनासिब हैं। <verse eid="TIT 2:1"/><verse number="2" style="v" sid="TIT 2:2"/>या'नी ये कि बूढ़े मर्द परहेज़गार, सन्जीदा और मुहाबती हों और उन का ईमान और मुहब्बत और सब्र दुरुस्त हो।<verse eid="TIT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 2:3"/>इसी तरह बूढ़ी 'औरतों की भी वज़'अ मुक़द्दसों सी हों, इल्ज़ाम लगाने वाली और ज़्यादा मय पीने में मशग़ूल न हों, बल्कि अच्छी बातें सिखाने वाली हों; <verse eid="TIT 2:3"/><verse number="4" style="v" sid="TIT 2:4"/>ताकि जवान 'औरतों को सिखाएँ कि अपने शौहरों को प्यार करें बच्चों को प्यार करें; <verse eid="TIT 2:4"/><verse number="5" style="v" sid="TIT 2:5"/>और परहेज़गार और पाक दामन और घर का कारोबार करने वाली, और मेहरबान हों अपने और अपने शौहर के ताबे रहें, ताकि ख़ुदा का कलाम बदनाम न हो।<verse eid="TIT 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6"/>जवान आदमियों को भी इसी तरह नसीहत कर कि परहेज़गार बनें। <verse eid="TIT 2:6"/><verse number="7" style="v" sid="TIT 2:7"/>सब बातों में अपने आप को नेक कामों का नमूना बना तेरी ता'लीम में सफ़ाई और सन्जीदगी <verse eid="TIT 2:7"/><verse number="8" style="v" sid="TIT 2:8"/>और ऐसी सेहत कलामी पाई जाए जो मलामत के लायक़ न हो ताकि मुख़ालिफ़ हम पर 'ऐब लगाने की कोई वजह न पाकर शर्मिन्दा होजाए।<verse eid="TIT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9"/>नौकरों को नसीहत कर कि अपने मालिकों के ताबे' रहें और सब बातों में उन्हें ख़ुश रखें, और उनके हुक्म से कुछ इन्कार न करें, <verse eid="TIT 2:9"/><verse number="10" style="v" sid="TIT 2:10"/>चोरी चालाकी न करें बल्कि हर तरह की ईमानदारी अच्छी तरह ज़ाहिर करें, ताकि उन से हर बात में हमारे मुन्जी ख़ुदा की ता'लीम को रौनक़ हो।<verse eid="TIT 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11"/>क्यूँकि ख़ुदा का वो फ़ज़ल ज़ाहिर हुआ है, जो सब आदमियों की नजात का ज़रिया है, <verse eid="TIT 2:11"/><verse number="12" style="v" sid="TIT 2:12"/>और हमें तालीम देता है ताकि बेदीनी और दुनियावी ख़्वाहिशों का इन्कार करके इस मौजूदा जहान में परहेज़गारी और रास्तबाज़ी और दीनदारी के साथ ज़िन्दगी गुज़ारें; <verse eid="TIT 2:12"/><verse number="13" style="v" sid="TIT 2:13"/>और उस मुबारिक़ उम्मीद या'नी अपने बुज़ुर्ग ख़ुदा और मुन्जी ईसा मसीह के जलाल के ज़ाहिर होने के मुन्तज़िर रहें।<verse eid="TIT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="TIT 2:14"/>जिस ने अपने आपको हमारे लिए दे दिया, ताकि फ़िदया होकर हमें हर तरह की बेदीनी से छुड़ाले, और पाक करके अपनी ख़ास मिल्कियत के लिए ऐसी उम्मत बनाए जो नेक कामों में सरगर्म हो।<verse eid="TIT 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15"/>पूरे इख़्तियार के साथ ये बातें कह और नसीहत दे और मलामत कर। कोई तेरी हिक़ारत न करने पाए।<verse eid="TIT 2:15"/></para>
  <chapter eid="TIT 2"/>
  <chapter number="3" style="c" sid="TIT 3"/>
  <para style="s">अच्छि चीज़ें करो</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1"/>उनको याद दिला कि हाकिमों और इख़्तियारवालों के ताबे रहें और उनका हुक्म मानें, और हर नेक काम के लिए मुस्त'इद रहें, <verse eid="TIT 3:1"/><verse number="2" style="v" sid="TIT 3:2"/>किसी की बुराई न करें तकरारी न हों; बल्कि नर्म मिज़ाज हों और सब आदमियों के साथ कमाल हलीमी से पेश आएँ।<verse eid="TIT 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 3:3"/>क्यूँकि हम भी पहले नादान नाफ़रमान फ़रेब खाने वाले रंग बिरंग की ख़्वाहिशों और ऐश — ओ — अशरत के बन्दे थे, और बदख़्वाही और हसद में ज़िन्दगी गुज़ारते थे, नफ़रत के लायक़ थे और आपस में जलन रखते थे।<verse eid="TIT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 3:4"/>मगर जब हमारे मुन्जी ख़ुदा की मेहरबानी और इंसान के साथ उसकी उल्फ़त ज़ाहिर हुई। <verse eid="TIT 3:4"/><verse number="5" style="v" sid="TIT 3:5"/>तो उस ने हम को नजात दी; मगर रास्तबाज़ी के कामों के ज़रिए से नहीं जो हम ने ख़ुद किए, बल्कि अपनी रहमत के मुताबिक़ पैदाइश के ग़ुस्ल और रूह — उल — क़ुद्दूस के हमें नया बनाने के वसीले से।<verse eid="TIT 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 3:6"/>जिसे उस ने हमारे मुन्जी 'ईसा मसीह के ज़रिए हम पर इफ़रात से नाज़िल किया, <verse eid="TIT 3:6"/><verse number="7" style="v" sid="TIT 3:7"/>ताकि हम उसके फ़ज़ल से रास्तबाज़ ठहर कर हमेशा की ज़िन्दगी की उम्मीद के मुताबिक़ वारिस बनें।<verse eid="TIT 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="TIT 3:8"/>ये बात सच है, और मैं चाहता हूँ, कि तू इन बातों का याक़ीनी तौर से दावा कर ताकि जिन्होंने ख़ुदा का यक़ीन किया है, वो अच्छे कामों में लगे रहने का ख़याल रख्खें ये बातें भली और आदमियों के लिए फ़ाइदामन्द हैं।<verse eid="TIT 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 3:9"/>मगर बेवक़ूफ़ी की हुज्जतों और नसबनामों और झगड़ों और उन लड़ाइयों से जो शरी'अत के बारे में हों परहेज़ करे इसलिए कि ये ला हासिल और बेफ़ाइदा हैं। <verse eid="TIT 3:9"/><verse number="10" style="v" sid="TIT 3:10"/>एक दो बार नसीहत करके झूठी ता'लीम देने वाले शख़्स से किनारा कर, <verse eid="TIT 3:10"/><verse number="11" style="v" sid="TIT 3:11"/>ये जान कर कि ऐसा शख़्स मुड़ गया है और अपने आपको मुजरिम ठहरा कर गुनाह करता रहता है।<verse eid="TIT 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12"/>जब मैं तेरे पास अरतिमास या तुख़िकुस को भेजूँ तो मेरे पास नीकुपुलिस शहर आने की कोशीश करना कयूँकि मैंने वहीं जाड़ा काटने का इरादा कर लिया है। <verse eid="TIT 3:12"/><verse number="13" style="v" sid="TIT 3:13"/>ज़ेनास आलिम — ए — शरा और अपुल्लोस को कोशिश करके रवाना कर दे इस तौर पर कि उन को किसी चीज़ की कमी न रही।<verse eid="TIT 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="TIT 3:14"/>और हमारे लोग भी ज़रूरतों को रफ़ा करने के लिए अच्छे कामों में लगे रहना सीखें ताकि बेफल न रहें।<verse eid="TIT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15"/>मेरे सब साथी तुझे सलाम कहते हैं। जो ईमान के रूह से हमें 'अज़ीज़ रखते हैं उन से सलाम कह। तुम सब पर फ़ज़ल होता रहे।<verse eid="TIT 3:15"/></para>
  <chapter eid="TIT 3"/>
</usx>
