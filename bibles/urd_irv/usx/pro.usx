<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">अम्साल</para>
  <para style="toc1">अम्साल</para>
  <para style="toc2">अम्सा</para>
  <para style="toc3">अम्सा</para>
  <para style="mt">अम्साल</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">अम्साल का ख़ास लिखने वाला बादशाह सुलेमान है। सुलेमान का नाम 1:1, 10:1 और 25:1 में ज़ाहिर होता है। दीगर मज़्मून निगार लोगों की एक जमाअत को शामिल करते हैं जैसे अक़लमन्द लोग; आक़िल, आगुर, और लमुएल बादशाह कलाम की दीगर किताबों की तरह ही अम्साल की किताब भी नजात के लिए ख़ुदा के मन्सूबे की तरफ़ इशारा करती है, लेकिन शायद ज़्यादा लताफ़त के साथ। इस किताब ने बनी इस्राईल को जीने का सही रास्ता दिखाया, जो ख़ुदा का रास्ता है। यह हो सकता है कि ख़ुदा ने सुलेमान को इस हिस्से के क़लम्बन्द करने के लिए इलहाम दिया हो जो समझ की बातों की बिना पर है जिन को उसने अपनी सारी ज़िन्दगी में ज़ाहिर करता रहा हो।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इस के तस्नीफ़ की तारीख़ तक़रीबन 971 - 686 क़ब्ल मसीह के बीच में है।</para>
  <para style="ip">कुछ हज़ार साल पहले बादशाह बतौर सुलेमान की हुकूमत के दौरान इस्राईल में अम्साल की किताब लिखी गई थी, इस की हिक्मत, किसी भी ज़माने में, किसी भी तहज़ीब में नाफ़िज़ कया जा सकता है।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">अम्साल की किताब के नाज़रीन व सामईन कई एक हैं। यह वालिदेन को मुख़ातिब है कि वे अपनी औलाद को सिखाए यह किताब जवान मर्दों और औरतों के लिए भी नाफ़िज़ होती है जो हिक्मत की तलाश कर रहे हैं और आखि़र — ए — कार मौजूदा कलाम के क़ारिईन के लिए जो दीन्दारी और परहेज़गारी की ज़िन्दगी जीना चाहते हैं यह अमली जामा नसीहत, मुहय्या करती है।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">अम्साल की किताब में सुलेमान के लिए ख़ुदा की हिक्मत बुलन्द व आला मर्तबा रखता है जिस को वह मुशतरिक व मा‘मूली और रोज़ाना की हालत बतौर पेश करता है। ऐसा नज़र आता है कि सुलेमान बादशाह के ध्यान और तवज्जोह से कोई मज़्मून बचा ही नहीं। वह तमाम ज़रूरी मुआमलात जो शख़्सी चाल चलन से सरोकार रखता है। जैसे जिन्सी ता‘लुक़ात, कारोबार, दौलत सख़ावत, पक्का इरादा, तरबियत, क़र्ज़ा, बच्चों की परवरिश, इंसानी सीख व ख़सलत शराब नोशी सियासत, इन्तक़ाम, दीनदारी, परहेज़गारी जैसे कई एक मज़ामीन शामिल किए गये हैं।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">हिक्मत</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. हिकमत की तासीरें — 1:1-9:18</para>
  <para style="io1">2. सुलेमान के अम्साल — 10:1-22:16</para>
  <para style="io1">3. आक़िल की कहावतें — 22:17-29:27</para>
  <para style="io1">4. आगुर के कलाम — 30:1-33</para>
  <para style="io1">5. लेमुएल के कलाम — 31:1-31</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="s">अस्माल का मकसद</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1"/>इस्राईल के बादशाह सुलेमान बिन दाऊद की अम्साल:<verse eid="PRO 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 1:2"/>हिकमत और तरबियत हासिल करने,</para>
  <para style="q" vid="PRO 1:2">और समझ की बातों का फ़र्क़ करने के लिए,<verse eid="PRO 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 1:3"/>'अक़्लमंदी और सदाक़त और 'अद्ल, और रास्ती में तरबियत हासिल करने के लिए;<verse eid="PRO 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 1:4"/>सादा दिलों को होशियारी,</para>
  <para style="q" vid="PRO 1:4">जवान को 'इल्म और तमीज़ बख़्शने के लिए,<verse eid="PRO 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 1:5"/>ताकि 'अक़्लमंद आदमी सुनकर 'इल्म में तरक़्क़ी करे</para>
  <para style="q" vid="PRO 1:5">और समझदार आदमी दुरुस्त मश्वरत तक पहुँचे,<verse eid="PRO 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 1:6"/>जिस से मसल और तम्सील को,</para>
  <para style="q" vid="PRO 1:6">'अक़्लमंदों की बातों और उनके पोशीदा राज़ो को समझ सके।<verse eid="PRO 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 1:7"/>ख़ुदावन्द का ख़ौफ़ 'इल्म की शुरू'आत है;</para>
  <para style="q" vid="PRO 1:7">लेकिन बेवक़ूफ़ हिकमत और तरबियत की हिक़ारत करते हैं।<verse eid="PRO 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 1:8"/>ऐ मेरे बेटे, अपने बाप की तरबियत पर कान लगा,</para>
  <para style="q" vid="PRO 1:8">और अपनी माँ की ता'लीम को न छोड़;<verse eid="PRO 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 1:9"/>क्यूँकि वह तेरे सिर के लिए ज़ीनत का सेहरा,</para>
  <para style="q" vid="PRO 1:9">और तेरे गले के लिए तौक़ होंगी।<verse eid="PRO 1:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 1:10"/>ऐ मेरे बेटे, अगर गुनहगार तुझे फुसलाएँ, तू रज़ामंद न होना।<verse eid="PRO 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 1:11"/>अगर वह कहें, हमारे साथ चल, हम खू़न करने के लिए ताक में बैठे,</para>
  <para style="q" vid="PRO 1:11">और छिपकर बेगुनाह के लिए नाहक़ घात लगाएँ,<verse eid="PRO 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 1:12"/>हम उनको इस तरह ज़िन्दा और पूरा निगल जाएँ जिस तरह पाताल मुर्दों को निगल जाता है।<verse eid="PRO 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 1:13"/>हम को हर क़िस्म का 'उम्दा माल मिलेगा,</para>
  <para style="q" vid="PRO 1:13">हम अपने घरों को लूट से भर लेंगे;<verse eid="PRO 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 1:14"/>तू हमारे साथ मिल जा,</para>
  <para style="q" vid="PRO 1:14">हम सबकी एक ही थैली होगी,<verse eid="PRO 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 1:15"/>तो ऐ मेरे बेटे, तू उनके साथ न जाना,</para>
  <para style="q" vid="PRO 1:15">उनकी राह से अपना पाँव रोकना।<verse eid="PRO 1:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 1:16"/>क्यूँकि उनके पाँव बदी की तरफ़ दौड़ते हैं,</para>
  <para style="q" vid="PRO 1:16">और खू़न बहाने के लिए जल्दी करते हैं।<verse eid="PRO 1:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 1:17"/>क्यूँकि परिंदे की आँखों के सामने,</para>
  <para style="q" vid="PRO 1:17">जाल बिछाना बेकार है।<verse eid="PRO 1:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 1:18"/>और यह लोग तो अपना ही खू़न करने के लिए ताक में बैठते हैं,</para>
  <para style="q" vid="PRO 1:18">और छिपकर अपनी ही जान की घात लगाते हैं।<verse eid="PRO 1:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 1:19"/>नफ़े' के लालची की राहें ऐसी ही हैं,</para>
  <para style="q" vid="PRO 1:19">ऐसा नफ़ा' उसकी जान लेकर ही छोड़ता है।<verse eid="PRO 1:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 1:20"/>हिकमत कूचे में ज़ोर से पुकारती है,</para>
  <para style="q" vid="PRO 1:20">वह रास्तों में अपनी आवाज़ बलन्द करती है;<verse eid="PRO 1:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 1:21"/>वह बाज़ार की भीड़ में चिल्लाती है;</para>
  <para style="q" vid="PRO 1:21">वह फाटकों के दहलीज़ पर और शहर में यह कहती है:<verse eid="PRO 1:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 1:22"/>“ऐ नादानो, तुम कब तक नादानी को दोस्त रख्खोगे?</para>
  <para style="q" vid="PRO 1:22">और ठट्ठाबाज़ कब तक ठठ्ठाबाज़ी से और बेवक़ूफ़ कब तक 'इल्म से 'अदावत रख्खेंगे?<verse eid="PRO 1:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 1:23"/>तुम मेरी मलामत को सुनकर बाज़ आओ,</para>
  <para style="q" vid="PRO 1:23">देखो, मैं अपनी रूह तुम पर उँडेलूँगी,</para>
  <para style="q" vid="PRO 1:23">मैं तुम को अपनी बातें बताऊँगी।<verse eid="PRO 1:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 1:24"/>चूँकि मैंने बुलाया और तुम ने इंकार किया मैंने हाथ फैलाया और किसी ने ख़याल न किया,<verse eid="PRO 1:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 1:25"/>बल्कि तुम ने मेरी तमाम मश्वरत को नाचीज़ जाना,</para>
  <para style="q" vid="PRO 1:25">और मेरी मलामत की बेक़द्री की;<verse eid="PRO 1:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 1:26"/>इसलिए मैं भी तुम्हारी मुसीबत के दिन हसूँगी;</para>
  <para style="q" vid="PRO 1:26">और जब तुम पर दहशत छा जाएगी तो ठठ्ठा मारूँगी।<verse eid="PRO 1:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 1:27"/>या'नी जब दहशत तूफ़ान की तरह आ पड़ेगी,</para>
  <para style="q" vid="PRO 1:27">और आफ़त बगोले की तरह तुम को आ लेगी,</para>
  <para style="q" vid="PRO 1:27">जब मुसीबत और जाँकनी तुम पर टूट पड़ेगी।<verse eid="PRO 1:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 1:28"/>तब वह मुझे पुकारेंगे, लेकिन मैं जवाब न दूँगी;</para>
  <para style="q" vid="PRO 1:28">और दिल ओ जान से मुझे ढूंडेंगे, लेकिन न पाएँगे।<verse eid="PRO 1:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 1:29"/>इसलिए कि उन्होंने 'इल्म से 'अदावत रख्खी,</para>
  <para style="q" vid="PRO 1:29">और ख़ुदावन्द के ख़ौफ़ को इख़्तियार न किया।<verse eid="PRO 1:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 1:30"/>उन्होंने मेरी तमाम मश्वरत की बेक़द्री की,</para>
  <para style="q" vid="PRO 1:30">और मेरी मलामत को बेकार जाना।<verse eid="PRO 1:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 1:31"/>तब वह अपनी ही चाल चलन का फल खाएँगे,</para>
  <para style="q" vid="PRO 1:31">और अपने ही मन्सूबों से पेट भरेंगे।<verse eid="PRO 1:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 1:32"/>क्यूँकि नादानों की नाफ़रमानी, उनको क़त्ल करेगी,</para>
  <para style="q" vid="PRO 1:32">और बेवक़ूफ़ों की बेवक़ूफ़ी उनकी हलाकत का ज़रिया' होगी।<verse eid="PRO 1:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 1:33"/>लेकिन जो मेरी सुनता है, वह महफ़ूज़ होगा,</para>
  <para style="q" vid="PRO 1:33">और आफ़त से निडर होकर इत्मिनान से रहेगा।”<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s">अक्लमंदी के फायदे</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 2:1"/>ऐ मेरे बेटे, अगर तू मेरी बातों को क़ुबूल करे,</para>
  <para style="q" vid="PRO 2:1">और मेरे फ़रमान को निगाह में रख्खे,<verse eid="PRO 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 2:2"/>ऐसा कि तू हिकमत की तरफ़ कान लगाए,</para>
  <para style="q" vid="PRO 2:2">और समझ से दिल लगाए,<verse eid="PRO 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 2:3"/>बल्कि अगर तू 'अक़्ल को पुकारे,</para>
  <para style="q" vid="PRO 2:3">और समझ के लिए आवाज़ बलन्द करे<verse eid="PRO 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 2:4"/>और उसको ऐसा ढूँढे जैसे चाँदी को,</para>
  <para style="q" vid="PRO 2:4">और उसकी ऐसी तलाश करे जैसी पोशीदा ख़ज़ानों की;<verse eid="PRO 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 2:5"/>तो तू ख़ुदावन्द के ख़ौफ़ को समझेगा,</para>
  <para style="q" vid="PRO 2:5">और ख़ुदा के ज़रिए' को हासिल करेगा।<verse eid="PRO 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 2:6"/>क्यूँकि ख़ुदावन्द हिकमत बख़्शता है;</para>
  <para style="q" vid="PRO 2:6">'इल्म — ओ — समझ उसी के मुँह से निकलते हैं।<verse eid="PRO 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 2:7"/>वह रास्तबाज़ों के लिए मदद तैयार रखता है,</para>
  <para style="q" vid="PRO 2:7">और रास्तरौ के लिए सिपर है।<verse eid="PRO 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 2:8"/>ताकि वह 'अद्ल की राहों की निगहबानी करे,</para>
  <para style="q" vid="PRO 2:8">और अपने मुक़द्दसों की राह को महफ़ूज़ रख्खे।<verse eid="PRO 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 2:9"/>तब तू सदाक़त और 'अद्ल और रास्ती को,</para>
  <para style="q" vid="PRO 2:9">बल्कि हर एक अच्छी राह को समझेगा।<verse eid="PRO 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 2:10"/>क्यूँकि हिकमत तेरे दिल में दाख़िल होगी,</para>
  <para style="q" vid="PRO 2:10">और 'इल्म तेरी जान को पसंद होगा,<verse eid="PRO 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 2:11"/>तमीज़ तेरी निगहबान होगी,</para>
  <para style="q" vid="PRO 2:11">समझ तेरी हिफ़ाज़त करेगा;<verse eid="PRO 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 2:12"/>ताकि तुझे शरीर की राह से,</para>
  <para style="q" vid="PRO 2:12">और कजगो से बचाएँ।<verse eid="PRO 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 2:13"/>जो रास्तबाज़ी की राह को छोड़ते हैं,</para>
  <para style="q" vid="PRO 2:13">ताकि तारीकी की राहों में चलें,<verse eid="PRO 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 2:14"/>जो बदकारी से ख़ुश होते हैं,</para>
  <para style="q" vid="PRO 2:14">और शरारत की कजरवी में खु़श रहते हैं,<verse eid="PRO 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 2:15"/>जिनका चाल चलन ना हमवार,</para>
  <para style="q" vid="PRO 2:15">और जिनकी राहें टेढ़ी हैं।<verse eid="PRO 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 2:16"/>ताकि तुझे बेगाना 'औरत से बचाएँ,</para>
  <para style="q" vid="PRO 2:16">या'नी चिकनी चुपड़ी बातें करने वाली पराई 'औरत से,<verse eid="PRO 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 2:17"/>जो अपनी जवानी के साथी को छोड़ देती है,</para>
  <para style="q" vid="PRO 2:17">और अपने ख़ुदा के 'अहद को भूल जाती है।<verse eid="PRO 2:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 2:18"/>क्यूँकि उसका घर मौत की उतराई पर है,</para>
  <para style="q" vid="PRO 2:18">और उसकी राहें पाताल को जाती हैं।<verse eid="PRO 2:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 2:19"/>जो कोई उसके पास जाता है, वापस नहीं आता;</para>
  <para style="q" vid="PRO 2:19">और ज़िन्दगी की राहों तक नहीं पहुँचता।<verse eid="PRO 2:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 2:20"/>ताकि तू नेकों की राह पर चले,</para>
  <para style="q" vid="PRO 2:20">और सादिक़ों की राहों पर क़ाईम रहे।<verse eid="PRO 2:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 2:21"/>क्यूँकि रास्तबाज़ मुल्क में बसेंगे,</para>
  <para style="q" vid="PRO 2:21">और कामिल उसमें आबाद रहेंगे।<verse eid="PRO 2:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 2:22"/>लेकिन शरीर ज़मीन पर से काट डाले जाएँगे,</para>
  <para style="q" vid="PRO 2:22">और दग़ाबाज़ उससे उखाड़ फेंके जाएँगे।<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s">ख़ुदावन्द में भरोसा करना</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 3:1"/>ऐ मेरे बेटे, मेरी ता'लीम को फ़रामोश न कर,</para>
  <para style="q" vid="PRO 3:1">बल्कि तेरा दिल मेरे हुक्मों को माने,<verse eid="PRO 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 3:2"/>क्यूँकि तू इनसे उम्र की दराज़ी और बुढ़ापा,</para>
  <para style="q" vid="PRO 3:2">और सलामती हासिल करेगा।<verse eid="PRO 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 3:3"/>शफ़क़त और सच्चाई तुझ से जुदा न हों,</para>
  <para style="q" vid="PRO 3:3">तू उनको अपने गले का तौक़ बनाना,</para>
  <para style="q" vid="PRO 3:3">और अपने दिल की तख़्ती पर लिख लेना।<verse eid="PRO 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 3:4"/>यूँ तू ख़ुदा और इंसान की नज़र में,</para>
  <para style="q" vid="PRO 3:4">मक़्बूलियत और 'अक़्लमन्दी हासिल करेगा।<verse eid="PRO 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 3:5"/>सारे दिल से ख़ुदावन्द पर भरोसा कर,</para>
  <para style="q" vid="PRO 3:5">और अपनी समझ पर इत्मिनान न कर।<verse eid="PRO 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 3:6"/>अपनी सब राहों में उसको पहचान,</para>
  <para style="q" vid="PRO 3:6">और वह तेरी रहनुमाई करेगा।<verse eid="PRO 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 3:7"/>तू अपनी ही निगाह में 'अक़्लमन्द न बन,</para>
  <para style="q" vid="PRO 3:7">ख़ुदावन्द से डर और बदी से किनारा कर।<verse eid="PRO 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 3:8"/>ये तेरी नाफ़ की सिहत,</para>
  <para style="q" vid="PRO 3:8">और तेरी हड़िडयों की ताज़गी होगी।<verse eid="PRO 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 3:9"/>अपने माल से और अपनी सारी पैदावार के पहले फलों से,</para>
  <para style="q" vid="PRO 3:9">ख़ुदावन्द की ता'ज़ीम कर।<verse eid="PRO 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 3:10"/>यूँ तेरे खत्ते भरे रहेंगे,</para>
  <para style="q" vid="PRO 3:10">और तेरे हौज़ नई मय से लबरेज़ होंगे।<verse eid="PRO 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 3:11"/>ऐ मेरे बेटे, ख़ुदावन्द की तम्बीह को हक़ीर न जान,</para>
  <para style="q" vid="PRO 3:11">और उसकी मलामत से बेज़ार न हो;<verse eid="PRO 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 3:12"/>क्यूँकि ख़ुदावन्द उसी को मलामत करता है जिससे उसे मुहब्बत है,</para>
  <para style="q" vid="PRO 3:12">जैसे बाप उस बेटे को जिससे वह ख़ुश है।<verse eid="PRO 3:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 3:13"/>मुबारक है वह आदमी जो हिकमत को पाता है,</para>
  <para style="q" vid="PRO 3:13">और वह जो समझ हासिल करता है,<verse eid="PRO 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 3:14"/>क्यूँकि इसका हासिल चाँदी के हासिल से,</para>
  <para style="q" vid="PRO 3:14">और इसका नफ़ा' कुन्दन से बेहतर है।<verse eid="PRO 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 3:15"/>वह मरजान से ज़्यादा बेशबहा है,</para>
  <para style="q" vid="PRO 3:15">और तेरी पसंदीदा चीज़ों में बेमिसाल।<verse eid="PRO 3:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 3:16"/>उसके दहने हाथ में उम्र की दराज़ी है,</para>
  <para style="q" vid="PRO 3:16">और उसके बाएँ हाथ में दौलत ओ — 'इज़्ज़त।<verse eid="PRO 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 3:17"/>उसकी राहें खु़श गवार राहें हैं,</para>
  <para style="q" vid="PRO 3:17">और उसके सब रास्ते सलामती के हैं।<verse eid="PRO 3:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 3:18"/>जो उसे पकड़े रहते हैं, वह उनके लिए ज़िन्दगी का दरख़्त है,</para>
  <para style="q" vid="PRO 3:18">और हर एक जो उसे लिए रहता है, मुबारक है।<verse eid="PRO 3:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 3:19"/>ख़ुदावन्द ने हिकमत से ज़मीन की बुनियाद डाली;</para>
  <para style="q" vid="PRO 3:19">और समझ से आसमान को क़ाईम किया।<verse eid="PRO 3:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 3:20"/>उसी के 'इल्म से गहराओ के सोते फूट निकले,</para>
  <para style="q" vid="PRO 3:20">और अफ़लाक शबनम टपकाते हैं।<verse eid="PRO 3:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 3:21"/>ऐ मेरे बेटे, 'अक़्लमंदी और तमीज़ की हिफ़ाज़त कर,</para>
  <para style="q" vid="PRO 3:21">उनको अपनी आँखों से ओझल न होने दे;<verse eid="PRO 3:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 3:22"/>यूँ वह तेरी जान की हयात,</para>
  <para style="q" vid="PRO 3:22">और तेरे गले की ज़ीनत होंगी।<verse eid="PRO 3:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 3:23"/>तब तू बेखटके अपने रास्ते पर चलेगा,</para>
  <para style="q" vid="PRO 3:23">और तेरे पाँव को ठेस न लगेगी।<verse eid="PRO 3:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 3:24"/>जब तू लेटेगा तो ख़ौफ़ न खाएगा,</para>
  <para style="q" vid="PRO 3:24">बल्कि तू लेट जाएगा और तेरी नींद मीठी होगी।<verse eid="PRO 3:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 3:25"/>अचानक दहशत से ख़ौफ़ न खाना,</para>
  <para style="q" vid="PRO 3:25">और न शरीरों की हलाकत से, जब वह आए;<verse eid="PRO 3:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 3:26"/>क्यूँकि ख़ुदावन्द तेरा सहारा होगा,</para>
  <para style="q" vid="PRO 3:26">और तेरे पाँव को फँस जाने से महफ़ूज़ रख्खेगा।<verse eid="PRO 3:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 3:27"/>भलाई के हक़दार से उसे किनारा न करना जब तेरे मुक़द्दर में हो।<verse eid="PRO 3:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 3:28"/>जब तेरे पास देने को कुछ हो,</para>
  <para style="q" vid="PRO 3:28">तो अपने पड़ोसी से यह न कहना,</para>
  <para style="q" vid="PRO 3:28">अब जा, फिर आना मैं तुझे कल दूँगा।<verse eid="PRO 3:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 3:29"/>अपने पड़ोसी के खि़लाफ़ बुराई का मन्सूबा न बाँधना,</para>
  <para style="q" vid="PRO 3:29">जिस हाल कि वह तेरे पड़ोस में बेखटके रहता है।<verse eid="PRO 3:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 3:30"/>अगर किसी ने तुझे नुक़सान न पहुँचाया हो,</para>
  <para style="q" vid="PRO 3:30">तू उससे बे वजह झगड़ा न करना।<verse eid="PRO 3:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 3:31"/>तुन्दख़ू आदमी पर जलन न करना,</para>
  <para style="q" vid="PRO 3:31">और उसके किसी चाल चलन को इख़्तियार न करना;<verse eid="PRO 3:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 3:32"/>क्यूँकि कजरौ से ख़ुदावन्द को नफ़रत लेकिन रास्तबाज़ उसके महरम — ए — राज़ हैं।<verse eid="PRO 3:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 3:33"/>शरीरों के घर पर ख़ुदावन्द की ला'नत है,</para>
  <para style="q" vid="PRO 3:33">लेकिन सादिक़ों के मस्कन पर उसकी बरकत है।<verse eid="PRO 3:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 3:34"/>यक़ीनन वह ठठ्ठाबाज़ों पर ठठ्ठे मारता है,</para>
  <para style="q" vid="PRO 3:34">लेकिन फ़रोतनों पर फ़ज़ल करता है।<verse eid="PRO 3:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 3:35"/>'अक़्लमंद जलाल के वारिस होंगे,</para>
  <para style="q" vid="PRO 3:35">लेकिन बेवक़ूफ़ों की तरक़्क़ी शर्मिन्दगी होगी।<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s">एक बाप की खास सलाह</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 4:1"/>ऐ मेरे बेटो, बाप की तरबियत पर कान लगाओ,</para>
  <para style="q" vid="PRO 4:1">और समझ हासिल करने के लिए तवज्जुह करो।<verse eid="PRO 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 4:2"/>क्यूँकि मैं तुम को अच्छी तल्क़ीन करता तुम मेरी ता'लीम को न छोड़ना।<verse eid="PRO 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 4:3"/>क्यूँकि मैं भी अपने बाप का बेटा था,</para>
  <para style="q" vid="PRO 4:3">और अपनी माँ की निगाह में नाज़ुक और अकेला लाडला।<verse eid="PRO 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 4:4"/>बाप ने मुझे सिखाया और मुझ से कहा,</para>
  <para style="q" vid="PRO 4:4">“मेरी बातें तेरे दिल में रहें, मेरे फ़रमान बजा ला और ज़िन्दा रह।<verse eid="PRO 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 4:5"/>हिकमत हासिल कर, समझ हासिल कर,</para>
  <para style="q" vid="PRO 4:5">भूलना मत और मेरे मुँह की बातों से नाफ़रमान न होना।<verse eid="PRO 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 4:6"/>हिकमत को न छोड़ना, वह तेरी हिफ़ाज़त करेगी;</para>
  <para style="q" vid="PRO 4:6">उससे मुहब्बत रखना, वह तेरी निगहबान होगी।<verse eid="PRO 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 4:7"/>हिकमत अफ़ज़ल असल है, फिर हिकमत हासिल कर;</para>
  <para style="q" vid="PRO 4:7">बल्किअपने तमाम हासिलात से समझ हासिल कर;<verse eid="PRO 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 4:8"/>उसकी ता'ज़ीम कर, वह तुझे सरफ़राज़ करेगी;</para>
  <para style="q" vid="PRO 4:8">जब तू उसे गले लगाएगा, वह तुझे 'इज़्ज़त बख़्शेगी।<verse eid="PRO 4:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 4:9"/>वह तेरे सिर पर ज़ीनत का सेहरा बाँधेगी;</para>
  <para style="q" vid="PRO 4:9">और तुझ को ख़ूबसूरती का ताज 'अता करेगी।”<verse eid="PRO 4:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 4:10"/>ऐ मेरे बेटे, सुन और मेरी बातों को कु़बूल कर,</para>
  <para style="q" vid="PRO 4:10">और तेरी ज़िन्दगी के दिन बहुत से होंगे।<verse eid="PRO 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 4:11"/>मैंने तुझे हिकमत की राह बताई है;</para>
  <para style="q" vid="PRO 4:11">और राह — ए — रास्त पर तेरी राहनुमाई की है।<verse eid="PRO 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 4:12"/>जब तू चलेगा तेरे क़दम कोताह न होंगे;</para>
  <para style="q" vid="PRO 4:12">और अगर तू दौड़े तो ठोकर न खाएगा।<verse eid="PRO 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 4:13"/>तरबियत को मज़बूती से पकड़े रह, उसे जाने न दे;</para>
  <para style="q" vid="PRO 4:13">उसकी हिफ़ाज़त कर क्यूँकि वह तेरी ज़िन्दगी है।<verse eid="PRO 4:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 4:14"/>शरीरों के रास्ते में न जाना,</para>
  <para style="q" vid="PRO 4:14">और बुरे आदमियों की राह में न चलना।<verse eid="PRO 4:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 4:15"/>उससे बचना, उसके पास से न गुज़रना,</para>
  <para style="q" vid="PRO 4:15">उससे मुड़कर आगे बढ़ जाना;<verse eid="PRO 4:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 4:16"/>क्यूँकि वह जब तक बुराई न कर लें सोते नहीं;</para>
  <para style="q" vid="PRO 4:16">और जब तक किसी को गिरा न दें उनकी नींद जाती रहती है।<verse eid="PRO 4:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 4:17"/>क्यूँकि वह शरारत की रोटी खाते,</para>
  <para style="q" vid="PRO 4:17">और जु़ल्म की मय पीते हैं।<verse eid="PRO 4:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 4:18"/>लेकिन सादिक़ों की राह सुबह की रोशनी की तरह है,</para>
  <para style="q" vid="PRO 4:18">जिसकी रोशनी दो पहर तक बढ़ती ही जाती है।<verse eid="PRO 4:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 4:19"/>शरीरों की राह तारीकी की तरह है;</para>
  <para style="q" vid="PRO 4:19">वह नहीं जानते कि किन चीज़ों से उनको ठोकर लगती है।<verse eid="PRO 4:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 4:20"/>ऐ मेरे बेटे, मेरी बातों पर तवज्जुह कर,</para>
  <para style="q" vid="PRO 4:20">मेरे कलाम पर कान लगा।<verse eid="PRO 4:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 4:21"/>उसको अपनी आँख से ओझल न होने दे,</para>
  <para style="q" vid="PRO 4:21">उसको अपने दिल में रख।<verse eid="PRO 4:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 4:22"/>क्यूँकि जो इसको पा लेते हैं, यह उनकी ज़िन्दगी,</para>
  <para style="q" vid="PRO 4:22">और उनके सारे जिस्म की सिहत है।<verse eid="PRO 4:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 4:23"/>अपने दिल की खू़ब हिफ़ाज़त कर;</para>
  <para style="q" vid="PRO 4:23">क्यूँकि ज़िन्दगी का सर चश्मा वही हैं।<verse eid="PRO 4:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 4:24"/>कजगो मुँह तुझ से अलग रहे,</para>
  <para style="q" vid="PRO 4:24">दरोग़गो लब तुझ से दूर हों।<verse eid="PRO 4:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 4:25"/>तेरी आँखें सामने ही नज़र करें,</para>
  <para style="q" vid="PRO 4:25">और तेरी पलके सीधी रहें।<verse eid="PRO 4:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 4:26"/>अपने पाँव के रास्ते को हमवार बना,</para>
  <para style="q" vid="PRO 4:26">और तेरी सब राहें क़ाईम रहें।<verse eid="PRO 4:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 4:27"/>न दहने मुड़ न बाएँ;</para>
  <para style="q" vid="PRO 4:27">और पाँव को बदी से हटा ले।<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s">ज़बून औरत से बचना</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 5:1"/>ऐ मेरे बेटे! मेरी हिकमत पर तवज्जुह कर,</para>
  <para style="q" vid="PRO 5:1">मेरे समझ पर कान लगा;<verse eid="PRO 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 5:2"/>ताकि तू तमीज़ को महफ़ूज़ रख्खें,</para>
  <para style="q" vid="PRO 5:2">और तेरे लब 'इल्म के निगहबान हों:<verse eid="PRO 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 5:3"/>क्यूँकि बेगाना 'औरत के होटों से शहद टपकता है,</para>
  <para style="q" vid="PRO 5:3">और उसका मुँह तेल से ज़्यादा चिकना है;<verse eid="PRO 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 5:4"/>लेकिन उसका अन्जाम अज़दहे की तरह तल्ख़,</para>
  <para style="q" vid="PRO 5:4">और दो धारी तलवार की तरह तेज़ है।<verse eid="PRO 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 5:5"/>उसके पाँव मौत की तरफ़ जाते हैं,</para>
  <para style="q" vid="PRO 5:5">उसके क़दम पाताल तक पहुँचते हैं।<verse eid="PRO 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 5:6"/>इसलिए उसे ज़िन्दगी का हमवार रास्ता नहीं मिलता;</para>
  <para style="q" vid="PRO 5:6">उसकी राहें बेठिकाना हैं, पर वह बेख़बर है।<verse eid="PRO 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 5:7"/>इसलिए ऐ मेरे बेटो, मेरी सुनो,</para>
  <para style="q" vid="PRO 5:7">और मेरे मुँह की बातों से नाफ़रमान न हो।<verse eid="PRO 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 5:8"/>उस 'औरत से अपनी राह दूर रख,</para>
  <para style="q" vid="PRO 5:8">और उसके घर के दरवाज़े के पास भी न जा;<verse eid="PRO 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 5:9"/>ऐसा न हो कि तू अपनी आबरू किसी गै़र के,</para>
  <para style="q" vid="PRO 5:9">और अपनी उम्र बेरहम के हवाले करे।<verse eid="PRO 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 5:10"/>ऐसा न हो कि बेगाने तेरी कु़व्वत से सेर हों,</para>
  <para style="q" vid="PRO 5:10">और तेरी कमाई किसी गै़र के घर जाए;<verse eid="PRO 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 5:11"/>और जब तेरा गोश्त और तेरा जिस्म घुल जाये तो तू अपने अन्जाम पर नोहा करे;<verse eid="PRO 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 5:12"/>और कहे, “मैंने तरबियत से कैसी 'अदावत रख्खी,</para>
  <para style="q" vid="PRO 5:12">और मेरे दिल ने मलामत को हक़ीर जाना।<verse eid="PRO 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 5:13"/>न मैंने अपने उस्तादों का कहा माना,</para>
  <para style="q" vid="PRO 5:13">न अपने तरबियत करने वालों की सुनी।<verse eid="PRO 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 5:14"/>मैं जमा'अत और मजलिस के बीच,</para>
  <para style="q" vid="PRO 5:14">क़रीबन सब बुराइयों में मुब्तिला हुआ।”<verse eid="PRO 5:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 5:15"/>तू पानी अपने ही हौज़ से और बहता पानी अपने ही चश्मे से पीना<verse eid="PRO 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 5:16"/>क्या तेरे चश्मे बाहर बह जाएँ,</para>
  <para style="q" vid="PRO 5:16">और पानी की नदियाँ कूचों में?<verse eid="PRO 5:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 5:17"/>वह सिर्फ़ तेरे ही लिए हों,</para>
  <para style="q" vid="PRO 5:17">न तेरे साथ गै़रों के लिए भी।<verse eid="PRO 5:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 5:18"/>तेरा सोता मुबारक हो और तू अपनी जवानी की बीवी के साथ ख़ुश रह।<verse eid="PRO 5:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 5:19"/>प्यारी हिरनी और दिल फ़रेब गजाला की तरह उसकी छातियाँ तुझे हर वक़्त आसूदह करें</para>
  <para style="q" vid="PRO 5:19">और उसकी मुहब्बत तुझे हमेशा फ़रेफ्ता रखे।<verse eid="PRO 5:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 5:20"/>ऐ मेरे बेटे, तुझे बेगाना 'औरत क्यों फ़रेफ्ता करे</para>
  <para style="q" vid="PRO 5:20">और तू ग़ैर 'औरत से क्यों हम आग़ोश हो?<verse eid="PRO 5:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 5:21"/>क्यूँकि इंसान की राहें ख़ुदावन्द कीआँखों के सामने हैं</para>
  <para style="q" vid="PRO 5:21">और वही सब रास्तों को हमवार बनाता है।<verse eid="PRO 5:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 5:22"/>शरीर को उसी की बदकारी पकड़ेगी,</para>
  <para style="q" vid="PRO 5:22">और वह अपने ही गुनाह की रस्सियों से जकड़ा जाएगा।<verse eid="PRO 5:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 5:23"/>वह तरबियत न पाने की वजह से मर जायेगा और अपनी सख़्त बेवक़ूफ़ी की वजह से गुमराह हो जायेगा।<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s">रोज़ाना की ज़िन्दगी से सीख लेना</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 6:1"/>ऐ मेरे बेटे, अगर तू अपने पड़ोसी का ज़ामिन हुआ है,</para>
  <para style="q" vid="PRO 6:1">अगर तू हाथ पर हाथ मारकर किसी बेगाने का ज़िम्मेदार हुआ है,<verse eid="PRO 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 6:2"/>तो तू अपने ही मुँह की बातों में फंसा,</para>
  <para style="q" vid="PRO 6:2">तू अपने ही मुँह की बातों से पकड़ा गया।<verse eid="PRO 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 6:3"/>इसलिए ऐ मेरे बेटे, क्यूँकि तू अपने पड़ोसी के हाथ में फँस गया है,</para>
  <para style="q" vid="PRO 6:3">अब यह कर और अपने आपको बचा ले, जा, ख़ाकसार बनकर अपने पड़ोसी से इसरार कर।<verse eid="PRO 6:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 6:4"/>तू न अपनी आँखों में नींद आने दे,</para>
  <para style="q" vid="PRO 6:4">और न अपनी पलकों में झपकी।<verse eid="PRO 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 6:5"/>अपने आपको हरनी की तरह और सय्याद के हाथ से,</para>
  <para style="q" vid="PRO 6:5">और चिड़िया की तरह चिड़ीमार के हाथ से छुड़ा।<verse eid="PRO 6:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 6:6"/>ऐ काहिल, चींटी के पास जा,</para>
  <para style="q" vid="PRO 6:6">चाल चलन पर ग़ौर कर और 'अक़्लमंद बन।<verse eid="PRO 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 6:7"/>जो बावजूद यह कि उसका न कोई सरदार,</para>
  <para style="q" vid="PRO 6:7">न नाज़िर न हाकिम है,<verse eid="PRO 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 6:8"/>गर्मी के मौसिम में अपनी खू़राक मुहय्या करती है,</para>
  <para style="q" vid="PRO 6:8">और फ़सल कटने के वक़्त अपनी ख़ुराक जमा' करती है।<verse eid="PRO 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 6:9"/>ऐ काहिल, तू कब तक पड़ा रहेगा?</para>
  <para style="q" vid="PRO 6:9">तू नींद से कब उठेगा?<verse eid="PRO 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 6:10"/>थोड़ी सी नींद, एक और झपकी,</para>
  <para style="q" vid="PRO 6:10">ज़रा पड़े रहने को हाथ पर हाथ:<verse eid="PRO 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 6:11"/>इसी तरह तेरी ग़रीबी राहज़न की तरह,</para>
  <para style="q" vid="PRO 6:11">और तेरी तंगदस्ती हथियारबन्द आदमी की तरह आ पड़ेगी।<verse eid="PRO 6:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 6:12"/>ख़बीस — ओ — बदकार आदमी,</para>
  <para style="q" vid="PRO 6:12">टेढ़ी तिरछी ज़बान लिए फिरता है।<verse eid="PRO 6:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 6:13"/>वह आँख मारता है, वह पाँव से बातें,</para>
  <para style="q" vid="PRO 6:13">और ऊँगलियों से इशारा करता है।<verse eid="PRO 6:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 6:14"/>उसके दिल में कजी है, वह बुराई के मन्सूबे बाँधता रहता है,</para>
  <para style="q" vid="PRO 6:14">वह फ़ितना अंगेज़ है।<verse eid="PRO 6:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 6:15"/>इसलिए आफ़त उस पर अचानक आ पड़ेगी,</para>
  <para style="q" vid="PRO 6:15">वह एकदम तोड़ दिया जाएगा और कोई चारा न होगा।<verse eid="PRO 6:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 6:16"/>छ: चीजें हैं जिनसे ख़ुदावन्द को नफ़रत है,</para>
  <para style="q" vid="PRO 6:16">बल्कि सात हैं जिनसे उसे नफ़रत है:<verse eid="PRO 6:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 6:17"/>ऊँची आँखें, झूटी ज़बान,</para>
  <para style="q" vid="PRO 6:17">बेगुनाह का खू़न बहाने वाले हाथ,<verse eid="PRO 6:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 6:18"/>बुरे मन्सूबे बाँधने वाला दिल,</para>
  <para style="q" vid="PRO 6:18">शरारत के लिए तेज़ रफ़्तार पाँव,<verse eid="PRO 6:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 6:19"/>झूटा गवाह जो दरोग़गोई करता है,</para>
  <para style="q" vid="PRO 6:19">और जो भाइयों में निफ़ाक़ डालता है।<verse eid="PRO 6:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 6:20"/>ऐ मेरे बेटे, अपने बाप के फ़रमान को बजा ला,</para>
  <para style="q" vid="PRO 6:20">और अपनी माँ की ता'लीम को न छोड़।<verse eid="PRO 6:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 6:21"/>इनको अपने दिल पर बाँधे रख,</para>
  <para style="q" vid="PRO 6:21">और अपने गले का तौक़ बना ले।<verse eid="PRO 6:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 6:22"/>यह चलते वक़्त तेरी रहबरी,</para>
  <para style="q" vid="PRO 6:22">और सोते वक़्त तेरी निगहबानी,</para>
  <para style="q" vid="PRO 6:22">और जागते वक़्त तुझ से बातें करेगी।<verse eid="PRO 6:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 6:23"/>क्यूँकि फ़रमान चिराग़ है और ता'लीम नूर,</para>
  <para style="q" vid="PRO 6:23">और तरबियत की मलामत ज़िन्दगी की राह है,<verse eid="PRO 6:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 6:24"/>ताकि तुझ को बुरी 'औरत से बचाए,</para>
  <para style="q" vid="PRO 6:24">या'नी बेगाना 'औरत की ज़बान की चापलूसी से।<verse eid="PRO 6:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 6:25"/>तू अपने दिल में उसके हुस्न पर 'आशिक़ न हो,</para>
  <para style="q" vid="PRO 6:25">और वह तुझ को अपनी पलकों से शिकार न करे।<verse eid="PRO 6:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 6:26"/>क्यूँकि धोके की वजह से आदमी टुकड़े का मुहताज हो जाता है,</para>
  <para style="q" vid="PRO 6:26">और ज़ानिया क़ीमती जान का शिकार करती है।<verse eid="PRO 6:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 6:27"/>क्या मुम्किन है कि आदमी अपने सीने में आग रख्खे,</para>
  <para style="q" vid="PRO 6:27">और उसके कपड़े न जलें?<verse eid="PRO 6:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 6:28"/>या कोई अंगारों पर चले,</para>
  <para style="q" vid="PRO 6:28">और उसके पाँव न झुलसें?<verse eid="PRO 6:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 6:29"/>वह भी ऐसा है जो अपने पड़ोसी की बीवी के पास जाता है;</para>
  <para style="q" vid="PRO 6:29">जो कोई उसे छुए बे सज़ा न रहेगा।<verse eid="PRO 6:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 6:30"/>चोर अगर भूक के मारे अपना पेट भरने को चोरी करे,</para>
  <para style="q" vid="PRO 6:30">तो लोग उसे हक़ीर नहीं जानते;<verse eid="PRO 6:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 6:31"/>लेकिन अगर वह पकड़ा जाए तो सात गुना भरेगा,</para>
  <para style="q" vid="PRO 6:31">उसे अपने घर का सारा माल देना पड़ेगा।<verse eid="PRO 6:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 6:32"/>जो किसी 'औरत से ज़िना करता है वह बे'अक़्ल है;</para>
  <para style="q" vid="PRO 6:32">वही ऐसा करता है जो अपनी जान को हलाक करना चाहता है।<verse eid="PRO 6:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 6:33"/>वह ज़ख़्म और ज़िल्लत उठाएगा,</para>
  <para style="q" vid="PRO 6:33">और उसकी रुस्वाई कभी न मिटेगी।<verse eid="PRO 6:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 6:34"/>क्यूँकि गै़रत से आदमी ग़ज़बनाक होता है,</para>
  <para style="q" vid="PRO 6:34">और वह इन्तिक़ाम के दिन नहीं छोड़ेगा।<verse eid="PRO 6:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 6:35"/>वह कोई फ़िदिया मंजूर नहीं करेगा,</para>
  <para style="q" vid="PRO 6:35">और चाहे तू बहुत से इन'आम भी दे तोभी वह राज़ी न होगा।<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s">ज़बून और से बचने के लिये दुसरी बार ख़बरदार करना</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 7:1"/>ऐ मेरे बेटे, मेरी बातों को मान,</para>
  <para style="q" vid="PRO 7:1">और मेरे फ़रमान को निगाह में रख।<verse eid="PRO 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 7:2"/>मेरे फ़रमान को बजा ला और ज़िन्दा रह,</para>
  <para style="q" vid="PRO 7:2">और मेरी ता'लीम को अपनी आँख की पुतली जानः<verse eid="PRO 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 7:3"/>उनको अपनी उँगलियों पर बाँध ले,</para>
  <para style="q" vid="PRO 7:3">उनको अपने दिल की तख़्ती पर लिख ले।<verse eid="PRO 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 7:4"/>हिकमत से कह, तू मेरी बहन है,</para>
  <para style="q" vid="PRO 7:4">और समझ को अपना रिश्तेदार क़रार दे;<verse eid="PRO 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 7:5"/>ताकि वह तुझ को पराई 'औरत से बचाएँ,</para>
  <para style="q" vid="PRO 7:5">या'नी बेगाना 'औरत से जो चापलूसी की बातें करती है।<verse eid="PRO 7:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 7:6"/>क्यूँकि मैंने अपने घर की खिड़की से,</para>
  <para style="q" vid="PRO 7:6">या'नी झरोके में से बाहर निगाह की,<verse eid="PRO 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 7:7"/>और मैंने एक बे'अक़्ल जवान को नादानों के बीच देखा,</para>
  <para style="q" vid="PRO 7:7">या'नी नौजवानों के बीच वह मुझे नज़रआया,<verse eid="PRO 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 7:8"/>कि उस 'औरत के घर के पास गली के मोड़ से जा रहा है,</para>
  <para style="q" vid="PRO 7:8">और उसने उसके घर का रास्ता लिया;<verse eid="PRO 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 7:9"/>दिन छिपे शाम के वक़्त,</para>
  <para style="q" vid="PRO 7:9">रात के अंधेरे और तारीकी में।<verse eid="PRO 7:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 7:10"/>और देखो, वहाँ उससे एक 'औरत आ मिली,</para>
  <para style="q" vid="PRO 7:10">जो दिल की चालाक और कस्बी का लिबास पहने थी।<verse eid="PRO 7:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 7:11"/>वह गौग़ाई और ख़ुदसर है,</para>
  <para style="q" vid="PRO 7:11">उसके पाँव अपने घर में नहीं टिकते;<verse eid="PRO 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 7:12"/>अभी वह गली में है, अभी बाज़ारों में,</para>
  <para style="q" vid="PRO 7:12">और हर मोड़ पर घात में बैठती है।<verse eid="PRO 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 7:13"/>इसलिए उसने उसको पकड़ कर चूमा,</para>
  <para style="q" vid="PRO 7:13">और बेहया मुँह से उससे कहने लगी,<verse eid="PRO 7:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 7:14"/>“सलामती की कु़र्बानी के ज़बीहे मुझ पर फ़र्ज़ थे,</para>
  <para style="q" vid="PRO 7:14">आज मैंने अपनी नज्रे़ अदा की हैं।<verse eid="PRO 7:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 7:15"/>इसीलिए मैं तेरी मुलाक़ात को निकली,</para>
  <para style="q" vid="PRO 7:15">कि किसी तरह तेरा दीदार हासिल करूँ, इसलिए तू मुझे मिल गया।<verse eid="PRO 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 7:16"/>मैंने अपने पलंग पर कामदार गालीचे,</para>
  <para style="q" vid="PRO 7:16">और मिस्र के सूत के धारीदार कपड़े बिछाए हैं।<verse eid="PRO 7:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 7:17"/>मैंने अपने बिस्तर को मुर और ऊद,</para>
  <para style="q" vid="PRO 7:17">और दारचीनी से मु'अत्तर किया है।<verse eid="PRO 7:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 7:18"/>आ हम सुबह तक दिल भर कर इश्क़ बाज़ी करें</para>
  <para style="q" vid="PRO 7:18">और मुहब्बत की बातों से दिल बहलाएँ<verse eid="PRO 7:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 7:19"/>क्यूँकि मेरा शौहर घर में नहीं,</para>
  <para style="q" vid="PRO 7:19">उसने दूर का सफ़र किया है।<verse eid="PRO 7:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 7:20"/>वह अपने साथ रुपये की थैली ले गया;</para>
  <para style="q" vid="PRO 7:20">और पूरे चाँद के वक़्त घर आएगा।”<verse eid="PRO 7:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 7:21"/>उसने मीठी मीठी बातों से उसको फुसला लिया,</para>
  <para style="q" vid="PRO 7:21">और अपने लबों की चापलूसी से उसको बहका लिया।<verse eid="PRO 7:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 7:22"/>वह फ़ौरन उसके पीछे हो लिया,</para>
  <para style="q" vid="PRO 7:22">जैसे बैल ज़बह होने को जाता है;</para>
  <para style="q" vid="PRO 7:22">या बेड़ियों में बेवक़ूफ़ सज़ा पाने को।<verse eid="PRO 7:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 7:23"/>जैसे परिन्दा जाल की तरफ़ तेज़ जाता है,</para>
  <para style="q" vid="PRO 7:23">और नहीं जानता कि वह उसकी जान के लिए है,</para>
  <para style="q" vid="PRO 7:23">हत्ता कि तीर उसके जिगर के पार हो जाएगा।<verse eid="PRO 7:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 7:24"/>इसलिए अब ऐ बेटो, मेरी सुनो,</para>
  <para style="q" vid="PRO 7:24">और मेरे मुँह की बातों पर तवज्जुह करो।<verse eid="PRO 7:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 7:25"/>तेरा दिल उसकी राहों की तरफ़ मायल न हो,</para>
  <para style="q" vid="PRO 7:25">तू उसके रास्तों में गुमराह न होना;<verse eid="PRO 7:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 7:26"/>क्यूँकि उसने बहुतों को ज़ख़्मी करके गिरा दिया है,</para>
  <para style="q" vid="PRO 7:26">बल्कि उसके मक़्तूल बेशुमार हैं।<verse eid="PRO 7:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 7:27"/>उसका घर पाताल का रास्ता है,</para>
  <para style="q" vid="PRO 7:27">और मौत की कोठरियों को जाता है।<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s">अक्लमंदी सुनने के लिये पुकारती है</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 8:1"/>क्या हिकमत पुकार नहीं रही,</para>
  <para style="q" vid="PRO 8:1">और समझ आवाज़ बलंद नहीं कर रहा?<verse eid="PRO 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 8:2"/>वह राह के किनारे की ऊँची जगहों की चोटियों पर,</para>
  <para style="q" vid="PRO 8:2">जहाँ सड़कें मिलती हैं, खड़ी होती है।<verse eid="PRO 8:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 8:3"/>फाटकों के पास शहर के दहलीज़ पर,</para>
  <para style="q" vid="PRO 8:3">या'नी दरवाज़ों के मदख़ल पर वह ज़ोर से पुकारती है,<verse eid="PRO 8:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 8:4"/>“ऐ आदमियो, मैं तुम को पुकारती हूँ,</para>
  <para style="q" vid="PRO 8:4">और बनी आदम को आवाज़ देती<verse eid="PRO 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 8:5"/>ऐ सादा दिली होशियारी सीखो;</para>
  <para style="q" vid="PRO 8:5">और ऐ बेवकुफ़ों 'अक़्ल दिल बनो।<verse eid="PRO 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 8:6"/>सुनो, क्यूँकि मैं लतीफ़ बातें कहूँगी,</para>
  <para style="q" vid="PRO 8:6">और मेरे लबों से रास्ती की बातें निकलेगी;<verse eid="PRO 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 8:7"/>इसलिए कि मेरा मुँह सच्चाई को बयान करेगा;</para>
  <para style="q" vid="PRO 8:7">और मेरे होंटों को शरारत से नफ़रत है।<verse eid="PRO 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 8:8"/>मेरे मुँह की सब बातें सदाक़त की हैं,</para>
  <para style="q" vid="PRO 8:8">उनमें कुछ टेढ़ा तिरछा नहीं है।<verse eid="PRO 8:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 8:9"/>समझने वाले के लिए वह सब साफ़ हैं,</para>
  <para style="q" vid="PRO 8:9">और 'इल्म हासिल करने वालों के लिए रास्त हैं।<verse eid="PRO 8:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 8:10"/>चाँदी को नहीं, बल्कि मेरी तरबियत को कु़बूल करो,</para>
  <para style="q" vid="PRO 8:10">और कुंदन से बढ़कर 'इल्म को;<verse eid="PRO 8:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 8:11"/>क्यूँकि हिकमत मरजान से अफ़ज़ल है,</para>
  <para style="q" vid="PRO 8:11">और सब पसन्दीदा चीज़ों में बेमिसाल।<verse eid="PRO 8:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 8:12"/>मुझ हिकमत ने होशियारी को अपना मस्कन बनाया है,</para>
  <para style="q" vid="PRO 8:12">और 'इल्म और तमीज़ को पा लेती हूँ।<verse eid="PRO 8:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 8:13"/>ख़ुदावन्द का ख़ौफ़ बदी से 'अदावत है।</para>
  <para style="q" vid="PRO 8:13">गु़रूर और घमण्ड और बुरी राह,</para>
  <para style="q" vid="PRO 8:13">और टेढ़ी बात से मुझे नफ़रत है।<verse eid="PRO 8:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 8:14"/>मशवरत और हिमायत मेरी है,</para>
  <para style="q" vid="PRO 8:14">समझ मैं ही हूँ मुझ में क़ुदरत है।<verse eid="PRO 8:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 8:15"/>मेरी बदौलत बादशाह सल्तनत करते,</para>
  <para style="q" vid="PRO 8:15">और उमरा इन्साफ़ का फ़तवा देते हैं।<verse eid="PRO 8:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 8:16"/>मेरी ही बदौलत हाकिम हुकूमत करते हैं,</para>
  <para style="q" vid="PRO 8:16">और सरदार या'नी दुनिया के सब काज़ी भी।<verse eid="PRO 8:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 8:17"/>जो मुझ से मुहब्बत रखते हैं मैं उनसे मुहब्बत रखती हूँ,</para>
  <para style="q" vid="PRO 8:17">और जो मुझे दिल से ढूंडते हैं, वह मुझे पा लेंगे।<verse eid="PRO 8:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 8:18"/>दौलत — ओ — 'इज़्ज़त मेरे साथ हैं,</para>
  <para style="q" vid="PRO 8:18">बल्कि हमेशा दौलत और सदाक़त भी।<verse eid="PRO 8:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 8:19"/>मेरा फल सोने से बल्कि कुन्दन से भी बेहतर है,</para>
  <para style="q" vid="PRO 8:19">और मेरा हासिल ख़ालिस चाँदी से।<verse eid="PRO 8:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 8:20"/>मैं सदाक़त की राह पर,</para>
  <para style="q" vid="PRO 8:20">इन्साफ़ के रास्तों में चलती हूँ।<verse eid="PRO 8:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 8:21"/>ताकि मैं उनको जो मुझ से मुहब्बत रखते हैं,</para>
  <para style="q" vid="PRO 8:21">माल के वारिस बनाऊँ, और उनके ख़ज़ानों को भर दूँ।<verse eid="PRO 8:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 8:22"/>“ख़ुदावन्द ने इन्तिज़ाम — ए — 'आलम के शुरू' में,</para>
  <para style="q" vid="PRO 8:22">अपनी क़दीमी सन'अतों से पहले मुझे पैदा किया।<verse eid="PRO 8:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 8:23"/>मैं अज़ल से या'नी इब्तिदा ही से मुक़र्रर हुई, इससे पहले के ज़मीन थी।<verse eid="PRO 8:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 8:24"/>मैं उस वक़्त पैदा हुई जब गहराओ न थे;</para>
  <para style="q" vid="PRO 8:24">जब पानी से भरे हुए चश्मे भी न थे।<verse eid="PRO 8:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 8:25"/>मैं पहाड़ों के क़ाईम किए जाने से पहले,</para>
  <para style="q" vid="PRO 8:25">और टीलों से पहले पैदा हुई।<verse eid="PRO 8:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 8:26"/>जब कि उसने अभी न ज़मीन को बनाया था न मैदानों को,</para>
  <para style="q" vid="PRO 8:26">और न ज़मीन की ख़ाक की शुरु'आत थी।<verse eid="PRO 8:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 8:27"/>जब उसने आसमान को क़ाईम किया मैं वहीं थी;</para>
  <para style="q" vid="PRO 8:27">जब उसने समुन्दर की सतह पर दायरा खींचा;<verse eid="PRO 8:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 8:28"/>जब उसने ऊपर अफ़लाक को बराबर किया,</para>
  <para style="q" vid="PRO 8:28">और गहराओ के सोते मज़बूत हो गए;<verse eid="PRO 8:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 8:29"/>जब उसने समुन्दर की हद ठहराई,</para>
  <para style="q" vid="PRO 8:29">ताकि पानी उसके हुक्म को न तोड़े;</para>
  <para style="q" vid="PRO 8:29">जब उसने ज़मीन की बुनियाद के निशान लगाए।<verse eid="PRO 8:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 8:30"/>उस वक़्त माहिर कारीगर की तरह मैं उसके पास थी,</para>
  <para style="q" vid="PRO 8:30">और मैं हर रोज़ उसकी ख़ुशनूदी थी,</para>
  <para style="q" vid="PRO 8:30">और हमेशा उसके सामने शादमान रहती थी।<verse eid="PRO 8:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 8:31"/>आबादी के लायक़ ज़मीन से शादमान थी,</para>
  <para style="q" vid="PRO 8:31">और मेरी ख़ुशनूदी बनी आदम की सुहबत में थी।<verse eid="PRO 8:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 8:32"/>“इसलिए ऐ बेटो, मेरी सुनो,</para>
  <para style="q" vid="PRO 8:32">क्यूँकि मुबारक हैं वह जो मेरी राहों पर चलते हैं।<verse eid="PRO 8:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 8:33"/>तरबियत की बात सुनो, और 'अक़्लमंद बनो,</para>
  <para style="q" vid="PRO 8:33">और इसको रद्द न करो।<verse eid="PRO 8:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 8:34"/>मुबारक है वह आदमी जो मेरी सुनता है,</para>
  <para style="q" vid="PRO 8:34">और हर रोज़ मेरे फाटकों पर इन्तिज़ार करता है,</para>
  <para style="q" vid="PRO 8:34">और मेरे दरवाज़ों की चौखटों पर ठहरा रहता है।<verse eid="PRO 8:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 8:35"/>क्यूँकि जो मुझ को पाता है, ज़िन्दगी पाता है,</para>
  <para style="q" vid="PRO 8:35">और वह ख़ुदावन्द का मक़बूल होगा।<verse eid="PRO 8:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PRO 8:36"/>लेकिन जो मुझ से भटक जाता है, अपनी ही जान को नुक़सान पहुँचाता है;</para>
  <para style="q" vid="PRO 8:36">मुझ से 'अदावत रखने वाले, सब मौत से मुहब्बत रखते हैं।”<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 9:1"/>हिकमत ने अपना घर बना लिया,</para>
  <para style="q" vid="PRO 9:1">उसने अपने सातों सुतून तराश लिए हैं।<verse eid="PRO 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 9:2"/>उसने अपने जानवरों को ज़बह कर लिया,</para>
  <para style="q" vid="PRO 9:2">और अपनी मय मिला कर तैयार कर ली;</para>
  <para style="q" vid="PRO 9:2">उसने अपना दस्तरख़्वान भी चुन लिया।<verse eid="PRO 9:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 9:3"/>उसने अपनी सहेलियों को रवाना किया है;</para>
  <para style="q" vid="PRO 9:3">वह ख़ुद शहर की ऊँची जगहों पर पुकारती है,<verse eid="PRO 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 9:4"/>“जो सादा दिल है,</para>
  <para style="q" vid="PRO 9:4">इधर आ जाए!” और बे'अक़्ल से वह यह कहती है,<verse eid="PRO 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 9:5"/>“आओ, मेरी रोटी में से खाओ,</para>
  <para style="q" vid="PRO 9:5">और मेरी मिलाई हुई मय में से पियो।<verse eid="PRO 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 9:6"/>ऐ सादा दिलो, बाज़ आओ और ज़िन्दा रहो,</para>
  <para style="q" vid="PRO 9:6">और समझ की राह पर चलो।”<verse eid="PRO 9:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 9:7"/>ठठ्ठा बाज़ को तम्बीह करने वाला ला'नतान उठाएगा,</para>
  <para style="q" vid="PRO 9:7">और शरीर को मलामत करने वाले पर धब्बा लगेगा।<verse eid="PRO 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 9:8"/>ठठ्ठाबाज़ को मलामत न कर, ऐसा न हो कि वह तुझ से 'अदावत रखने लगे;</para>
  <para style="q" vid="PRO 9:8">'अक़्लमंद को मलामत कर, और वह तुझ से मुहब्बत रख्खेगा।<verse eid="PRO 9:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 9:9"/>'अक़्लमंद की तरबियत कर, और वह और भी 'अक़्लमंद बन जाएगा;</para>
  <para style="q" vid="PRO 9:9">सादिक़ को सिखा और वह 'इल्म में तरक़्क़ी करेगा।<verse eid="PRO 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 9:10"/>ख़ुदावन्द का ख़ौफ़ हिकमत का शुरू' है,</para>
  <para style="q" vid="PRO 9:10">और उस क़ुद्दुस की पहचान समझ है।<verse eid="PRO 9:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 9:11"/>क्यूँकि मेरी बदौलत तेरे दिन बढ़ जाएँगे,</para>
  <para style="q" vid="PRO 9:11">और तेरी ज़िन्दगी के साल ज़्यादा होंगे।<verse eid="PRO 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 9:12"/>अगर तू 'अक़्लमंद है तो अपने लिए,</para>
  <para style="q" vid="PRO 9:12">और अगर तू ठठ्ठाबाज़ है तो ख़ुद ही भुगतेगा।<verse eid="PRO 9:12"/></para>
  <para style="s">नादान औरत का पुकारना</para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 9:13"/>बेवक़ूफ़ 'औरत गौग़ाई है;</para>
  <para style="q" vid="PRO 9:13">वह नादान है और कुछ नहीं जानती।<verse eid="PRO 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 9:14"/>वह अपने घर के दरवाज़े पर,</para>
  <para style="q" vid="PRO 9:14">शहर की ऊँची जगहों में बैठ जाती है;<verse eid="PRO 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 9:15"/>ताकिआने जाने वालों को बुलाए,</para>
  <para style="q" vid="PRO 9:15">जो अपने अपने रास्ते पर सीधे जा रहें हैं,<verse eid="PRO 9:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 9:16"/>“सादा दिल इधर आ जाएँ,”</para>
  <para style="q" vid="PRO 9:16">और बे'अक़्ल से वह यह कहती है,<verse eid="PRO 9:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 9:17"/>“चोरी का पानी मीठा है,</para>
  <para style="q" vid="PRO 9:17">और पोशीदगी की रोटी लज़ीज़।”<verse eid="PRO 9:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 9:18"/>लेकिन वह नहीं जानता कि वहाँ मुर्दे पड़े हैं,</para>
  <para style="q" vid="PRO 9:18">और उस 'औरत के मेहमान पाताल की तह में हैं।<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="s">सुलेमान की अस्माल</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1"/>सुलेमान की अम्साल।</para>
  <para style="q" vid="PRO 10:1">अक़्लमंद बेटा बाप को ख़ुश रखता है,</para>
  <para style="q" vid="PRO 10:1">लेकिन बेवक़ूफ़ बेटा अपनी माँ का ग़म है।<verse eid="PRO 10:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 10:2"/>शरारत के ख़ज़ाने बेकार हैं,</para>
  <para style="q" vid="PRO 10:2">लेकिन सदाक़त मौत से छुड़ाती है।<verse eid="PRO 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 10:3"/>ख़ुदावन्द सादिक़ की जान को फ़ाक़ा न करने देगा,</para>
  <para style="q" vid="PRO 10:3">लेकिन शरीरों की हवस को दूर — ओ — दफ़ा' करेगा।<verse eid="PRO 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 10:4"/>जो ढीले हाथ से काम करता है, कंगाल हो जाता है;</para>
  <para style="q" vid="PRO 10:4">लेकिेन मेहनती का हाथ दौलतमंद बना देता है।<verse eid="PRO 10:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 10:5"/>वह जो गर्मी में जमा' करता है, 'अक़्लमंद बेटा है;</para>
  <para style="q" vid="PRO 10:5">लेकिन वह बेटा जो दिरौ के वक़्त सोता रहता है, शर्म का ज़रिया' है।<verse eid="PRO 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 10:6"/>सादिक़ के सिर पर बरकतें होती हैं,</para>
  <para style="q" vid="PRO 10:6">लेकिन शरीरों के मुँह को जु़ल्म ढाँकता है।<verse eid="PRO 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 10:7"/>रास्त आदमी की यादगार मुबारक है,</para>
  <para style="q" vid="PRO 10:7">लेकिन शरीरों का नाम सड़ जाएगा।<verse eid="PRO 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 10:8"/>'अक़्लमंद दिल फ़रमान बजा लाएगा, लेकिन बकवासी बेवक़ूफ़ पछाड़ खाएगा।<verse eid="PRO 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 10:9"/>रास्त रौ बेखट के चलता है,</para>
  <para style="q" vid="PRO 10:9">लेकिन जो कजरवी करता है ज़ाहिर हो जाएगा।<verse eid="PRO 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 10:10"/>आँख मारने वाला रंज पहुँचाता है,</para>
  <para style="q" vid="PRO 10:10">और बकवासी बेवक़ूफ़ पछाड़ खाएगा।<verse eid="PRO 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 10:11"/>सादिक़ का मुँह ज़िन्दगी का चश्मा है,</para>
  <para style="q" vid="PRO 10:11">लेकिन शरीरों के मुँह को जु़ल्म ढाँकता है।<verse eid="PRO 10:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 10:12"/>'अदावत झगड़े पैदा करती है,</para>
  <para style="q" vid="PRO 10:12">लेकिन मुहब्बत सब ख़ताओं को ढाँक देती है।<verse eid="PRO 10:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 10:13"/>'अक़्लमंद के लबों पर हिकमत है,</para>
  <para style="q" vid="PRO 10:13">लेकिन बे'अक़्ल की पीठ के लिए लठ है।<verse eid="PRO 10:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 10:14"/>'अक़्लमंद आदमी 'इल्म जमा' करते हैं,</para>
  <para style="q" vid="PRO 10:14">लेकिन बेवक़ूफ़ का मुँह क़रीबी हलाकत है।<verse eid="PRO 10:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 10:15"/>दौलतमंद की दौलत उसका मज़बूत शहर है,</para>
  <para style="q" vid="PRO 10:15">कंगाल की हलाकत उसी की तंगदस्ती है।<verse eid="PRO 10:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 10:16"/>सादिक़ की मेहनत ज़िन्दगानी का ज़रिया' है,</para>
  <para style="q" vid="PRO 10:16">शरीर की इक़बालमंदी गुनाह कराती है।<verse eid="PRO 10:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 10:17"/>तरबियत पज़ीर ज़िन्दगी की राह पर है,</para>
  <para style="q" vid="PRO 10:17">लेकिन मलामत को छोड़ने वाला गुमराह हो जाता है।<verse eid="PRO 10:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 10:18"/>'अदावत को छिपाने वाला दरोग़गो है,</para>
  <para style="q" vid="PRO 10:18">और तोहमत लगाने वाला बेवक़ूफ़है।<verse eid="PRO 10:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 10:19"/>कलाम की कसरत ख़ता से ख़ाली नहीं,</para>
  <para style="q" vid="PRO 10:19">लेकिन होंटों को क़ाबू में रखने वाला 'अक़्लमंद है।<verse eid="PRO 10:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 10:20"/>सादिक़ की ज़बान खालिस चाँदी है;</para>
  <para style="q" vid="PRO 10:20">शरीरों के दिल बेक़द्र हैं<verse eid="PRO 10:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 10:21"/>सादिक़ के होंट बहुतों को गिज़ा पहुँचाते है लेकिन बेवक़ूफ़ बे'अक़्ली से मरते हैं।<verse eid="PRO 10:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 10:22"/>ख़ुदावन्द ही की बरकत दौलत बख़्शती है,</para>
  <para style="q" vid="PRO 10:22">और वह उसके साथ दुख नहीं मिलाता।<verse eid="PRO 10:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 10:23"/>बेवक़ूफ़ के लिए शरारत खेल है,</para>
  <para style="q" vid="PRO 10:23">लेकिन हिकमत 'अक़्लमंद के लिए है।<verse eid="PRO 10:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 10:24"/>शरीर का ख़ौफ़ उस पर आ पड़ेगा,</para>
  <para style="q" vid="PRO 10:24">और सादिक़ों की मुराद पूरी होगी।<verse eid="PRO 10:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 10:25"/>जब बगोला गुज़रता है तो शरीर हलाक हो जाता है,</para>
  <para style="q" vid="PRO 10:25">लेकिन सादिक़ हमेशा की बुनियाद है।<verse eid="PRO 10:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 10:26"/>जैसा दाँतों के लिए सिरका,</para>
  <para style="q" vid="PRO 10:26">और आँखों के लिए धुआँ वैसा ही काहिल अपने भेजने वालों के लिए है।<verse eid="PRO 10:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 10:27"/>ख़ुदावन्द का ख़ौफ़' उम्र की दराज़ी बख़्शता है लेकिन शरीरों की ज़िन्दगी कोताह कर दी जायेगी।<verse eid="PRO 10:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 10:28"/>सादिक़ो की उम्मीद ख़ुशी लाएगी लेकिन शरीरों की उम्मीद ख़ाक में मिल जाएगी।<verse eid="PRO 10:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 10:29"/>ख़ुदावन्द की राह रास्तबाज़ों के लिए पनाहगाह लेकिन बदकिरादारों के लिए हलाक़त है,<verse eid="PRO 10:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 10:30"/>सादिक़ों को कभी जुम्बिश न होगी लेकिन शरीर ज़मीन पर क़ाईम नहीं रहेंगे।<verse eid="PRO 10:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 10:31"/>सादिक़ के मुँह से हिकमत निकलती है लेकिन झूठी ज़बान काट डाली जायेगी।<verse eid="PRO 10:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 10:32"/>सादिक़ के होंट पसन्दीदा बात से आशना है लेकिन शरीरों के मुंह झूट से।<verse eid="PRO 10:32"/></para>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 11:1"/>दग़ा के तराजू़ से ख़ुदावन्द को नफ़रत है,</para>
  <para style="q" vid="PRO 11:1">लेकिन पूरा तौल बाट उसकी खु़शी है।<verse eid="PRO 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 11:2"/>तकब्बुर के साथ बुराई आती है,</para>
  <para style="q" vid="PRO 11:2">लेकिन ख़ाकसारों के साथ हिकमत है।<verse eid="PRO 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 11:3"/>रास्तबाज़ों की रास्ती उनकी राहनुमा होगी,</para>
  <para style="q" vid="PRO 11:3">लेकिन दग़ाबाज़ों की टेढ़ी राह उनको बर्बाद करेगी।<verse eid="PRO 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 11:4"/>क़हर के दिन माल काम नहीं आता,</para>
  <para style="q" vid="PRO 11:4">लेकिन सदाक़त मौत से रिहाई देती है।<verse eid="PRO 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 11:5"/>कामिल की सदाक़त उसकी राहनुमाई करेगी लेकिन शरीर अपनी ही शरारत से गिर पड़ेगा।<verse eid="PRO 11:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 11:6"/>रास्तबाज़ों की सदाक़त उनको रिहाई देगी,</para>
  <para style="q" vid="PRO 11:6">लेकिन दग़ाबाज़ अपनी ही बद नियती में फँस जाएँगे।<verse eid="PRO 11:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 11:7"/>मरने पर शरीर का उम्मीद ख़ाक में मिल जाता है,</para>
  <para style="q" vid="PRO 11:7">और ज़ालिमों की उम्मीद बर्बाद हो जाती है।<verse eid="PRO 11:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 11:8"/>सादिक़ मुसीबत से रिहाई पाता है,</para>
  <para style="q" vid="PRO 11:8">और शरीर उसमें पड़ जाता है।<verse eid="PRO 11:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 11:9"/>बेदीन अपनी बातों से अपने पड़ोसी को हलाक करता है</para>
  <para style="q" vid="PRO 11:9">लेकिन सादिक़ 'इल्म के ज़रिए' से रिहाई पाएगा।<verse eid="PRO 11:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 11:10"/>सादिक़ों की खु़शहाली से शहर ख़ुश होता है।</para>
  <para style="q" vid="PRO 11:10">और शरीरों की हलाकत पर ख़ुशी की ललकार होती है।<verse eid="PRO 11:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 11:11"/>रास्तबाज़ों की दुआ से शहर सरफ़राज़ी पाता है,</para>
  <para style="q" vid="PRO 11:11">लेकिन शरीरों की बातों से बर्बाद होता है।<verse eid="PRO 11:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 11:12"/>अपने पड़ोसी की बे'इज़्ज़ती करने वाला बे'अक़्ल है,</para>
  <para style="q" vid="PRO 11:12">लेकिन समझदार ख़ामोश रहता है।<verse eid="PRO 11:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 11:13"/>जो कोई लुतरापन करता फिरता है राज़ खोलता है,</para>
  <para style="q" vid="PRO 11:13">लेकिन जिसमें वफ़ा की रूह है वह राज़दार है।<verse eid="PRO 11:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 11:14"/>नेक सलाह के बगै़र लोग तबाह होते हैं,</para>
  <para style="q" vid="PRO 11:14">लेकिन सलाहकारों की कसरत में सलामती है।<verse eid="PRO 11:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 11:15"/>जो बेगाने का ज़ामिन होता है सख़्त नुक़्सान उठाएगा,</para>
  <para style="q" vid="PRO 11:15">लेकिन जिसको ज़मानत से नफ़रत है वह बेख़तर है।<verse eid="PRO 11:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 11:16"/>नेक सीरत 'औरत 'इज़्ज़त पाती है,</para>
  <para style="q" vid="PRO 11:16">और तुन्दखू़ आदमी माल हासिल करते हैं।<verse eid="PRO 11:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 11:17"/>रहम दिल अपनी जान के साथ नेकी करता है,</para>
  <para style="q" vid="PRO 11:17">लेकिन बे रहम अपने जिस्म को दुख देता है।<verse eid="PRO 11:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 11:18"/>शरीर की कमाई बेकार है,</para>
  <para style="q" vid="PRO 11:18">लेकिन सदाक़त बोलने वाला हक़ीक़ी अज्र पता है।<verse eid="PRO 11:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 11:19"/>सदाक़त पर क़ाईम रहने वाला ज़िन्दगी हासिल करता है,</para>
  <para style="q" vid="PRO 11:19">और बदी का हिमायती अपनी मौत को पहुँचता है।<verse eid="PRO 11:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 11:20"/>कज दिलों से ख़ुदावन्द को नफ़रत है,</para>
  <para style="q" vid="PRO 11:20">लेकिन कामिल रफ़्तार उसकी ख़ुशनूदी हैं।<verse eid="PRO 11:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 11:21"/>यक़ीनन शरीर बे सज़ा न छूटेगा,</para>
  <para style="q" vid="PRO 11:21">लेकिन सादिक़ों की नसल रिहाई पाएगी।<verse eid="PRO 11:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 11:22"/>बेतमीज़ 'औरत में खू़बसूरती,</para>
  <para style="q" vid="PRO 11:22">जैसे सूअर की नाक में सोने की नथ है।<verse eid="PRO 11:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 11:23"/>सादिक़ों की तमन्ना सिर्फ़ नेकी है;</para>
  <para style="q" vid="PRO 11:23">लेकिन शरीरों की उम्मीद ग़ज़ब है।<verse eid="PRO 11:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 11:24"/>कोई तो बिथराता है, लेकिन तो भी तरक़्क़ी करता है;</para>
  <para style="q" vid="PRO 11:24">और कोई सही ख़र्च से परहेज़ करता है,</para>
  <para style="q" vid="PRO 11:24">लेकिन तोभी कंगाल है।<verse eid="PRO 11:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 11:25"/>सख़ी दिल मोटा हो जाएगा,</para>
  <para style="q" vid="PRO 11:25">और सेराब करने वाला ख़ुद भी सेराब होगा।<verse eid="PRO 11:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 11:26"/>जो ग़ल्ला रोक रखता है, लोग उस पर ला'नत करेंगे;</para>
  <para style="q" vid="PRO 11:26">लेकिन जो उसे बेचता है उसके सिर पर बरकत होगी।<verse eid="PRO 11:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 11:27"/>जो दिल से नेकी की तलाश में है मक़्बूलियत का तालिब है,</para>
  <para style="q" vid="PRO 11:27">लेकिन जो बदी की तलाश में है वह उसी के आगे आएगी।<verse eid="PRO 11:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 11:28"/>जो अपने माल पर भरोसा करता है गिर पड़ेगा,</para>
  <para style="q" vid="PRO 11:28">लेकिन सादिक़ हरे पत्तों की तरह सरसब्ज़ होंगे।<verse eid="PRO 11:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 11:29"/>जो अपने घराने को दुख देता है, हवा का वारिस होगा,</para>
  <para style="q" vid="PRO 11:29">और बेवक़ूफ़ अक़्ल दिल का ख़ादिम बनेगा।<verse eid="PRO 11:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 11:30"/>सादिक़ का फल ज़िन्दगी का दरख़्त है,</para>
  <para style="q" vid="PRO 11:30">और जो 'अक़्लमंद है दिलों को मोह लेता है।<verse eid="PRO 11:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 11:31"/>देख, सादिक़ को ज़मीन पर बदला दिया जाएगा,</para>
  <para style="q" vid="PRO 11:31">तो कितना ज़्यादा शरीर और गुनहगार को।<verse eid="PRO 11:31"/></para>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 12:1"/>जो तरबियत को दोस्त रखता है, वह 'इल्म को दोस्त रखता है;</para>
  <para style="q" vid="PRO 12:1">लेकिन जो तम्बीह से नफ़रत रखता है, वह हैवान है।<verse eid="PRO 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 12:2"/>नेक आदमी ख़ुदावन्द का मक़बूल होगा,</para>
  <para style="q" vid="PRO 12:2">लेकिन बुरे मन्सूबे बाँधने वाले को वह मुजरिम ठहराएगा।<verse eid="PRO 12:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 12:3"/>आदमी शरारत से पायेदार नहीं होगा</para>
  <para style="q" vid="PRO 12:3">लेकिन सादिक़ों की जड़ को कभी जुम्बिश न होगी।<verse eid="PRO 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 12:4"/>नेक 'औरत अपने शौहर के लिए ताज है</para>
  <para style="q" vid="PRO 12:4">लेकिन नदामत लाने वाली उसकी हड्डियों में बोसीदगी की तरह है।<verse eid="PRO 12:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 12:5"/>सादिक़ों के ख़यालात दुरुस्त हैं,</para>
  <para style="q" vid="PRO 12:5">लेकिन शरीरों की मश्वरत धोखा है।<verse eid="PRO 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 12:6"/>शरीरों की बातें यही हैं कि खू़न करने के लिए ताक में बैठे,</para>
  <para style="q" vid="PRO 12:6">लेकिन सादिक़ों की बातें उनको रिहाई देंगी।<verse eid="PRO 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 12:7"/>शरीर पछाड़ खाते और हलाक होते हैं,</para>
  <para style="q" vid="PRO 12:7">लेकिन सादिक़ों का घर क़ाईम रहेगा।<verse eid="PRO 12:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 12:8"/>आदमी की ता'रीफ़ उसकी 'अक़्लमंदी के मुताबिक़ की जाती है,</para>
  <para style="q" vid="PRO 12:8">लेकिन बे'अक़्ल ज़लील होगा।<verse eid="PRO 12:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 12:9"/>जो छोटा समझा जाता है लेकिन उसके पास एक नौकर है,</para>
  <para style="q" vid="PRO 12:9">उससे बेहतर है जो अपने आप को बड़ा जानता और रोटी का मोहताज है।<verse eid="PRO 12:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 12:10"/>सादिक़ अपने चौपाए की जान का ख़याल रखता है,</para>
  <para style="q" vid="PRO 12:10">लेकिन शरीरों की रहमत भी 'ऐन जु़ल्म है।<verse eid="PRO 12:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 12:11"/>जो अपनी ज़मीन में काश्तकारी करता है, रोटी से सेर होगा;</para>
  <para style="q" vid="PRO 12:11">लेकिन बेकारी का हिमायती बे'अक़्ल है।<verse eid="PRO 12:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 12:12"/>शरीर बदकिरदारों के दाम का मुश्ताक़ है,</para>
  <para style="q" vid="PRO 12:12">लेकिन सादिक़ों की जड़ फलती है।<verse eid="PRO 12:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 12:13"/>लबों की ख़ताकारी में शरीर के लिए फंदा है,</para>
  <para style="q" vid="PRO 12:13">लेकिन सादिक़ मुसीबत से बच निकलेगा।<verse eid="PRO 12:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 12:14"/>आदमी के कलाम का फल उसको नेकी से आसूदा करेगा,</para>
  <para style="q" vid="PRO 12:14">और उसके हाथों के किए का बदला उसको मिलेगा।<verse eid="PRO 12:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 12:15"/>बेवक़ूफ़ का चाल चलन उसकी नज़र में दुरस्त है,</para>
  <para style="q" vid="PRO 12:15">लेकिन 'अक़्लमंद नसीहत को सुनता है।<verse eid="PRO 12:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 12:16"/>बेवक़ूफ़ का ग़ज़ब फ़ौरन ज़ाहिर हो जाता है,</para>
  <para style="q" vid="PRO 12:16">लेकिन होशियार शर्मिन्दगी को छिपाता है।<verse eid="PRO 12:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 12:17"/>रास्तगो सदाक़त ज़ाहिर करता है,</para>
  <para style="q" vid="PRO 12:17">लेकिन झूटा गवाह दग़ाबाज़ी।<verse eid="PRO 12:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 12:18"/>बिना समझे बोलने वाले की बातें तलवार की तरह छेदती हैं,</para>
  <para style="q" vid="PRO 12:18">लेकिन 'अक़्लमंद की ज़बान सेहत बख़्श है।<verse eid="PRO 12:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 12:19"/>सच्चे होंट हमेशा तक क़ाईम रहेंगे</para>
  <para style="q" vid="PRO 12:19">लेकिन झूटी ज़बान सिर्फ़ दम भर की है।<verse eid="PRO 12:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 12:20"/>बदी के मन्सूबे बाँधने वालों के दिल में दग़ा है,</para>
  <para style="q" vid="PRO 12:20">लेकिन सुलह की मश्वरत देने वालों के लिए ख़ुशी है।<verse eid="PRO 12:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 12:21"/>सादिक़ पर कोई आफ़त नहीं आएगी,</para>
  <para style="q" vid="PRO 12:21">लेकिन शरीर बला में मुब्तिला होंगे।<verse eid="PRO 12:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 12:22"/>झूटे लबों से ख़ुदावन्द को नफ़रत है,</para>
  <para style="q" vid="PRO 12:22">लेकिन रास्तकार उसकी ख़ुशनूदी, हैं।<verse eid="PRO 12:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 12:23"/>होशियार आदमी 'इल्म को छिपाता है,</para>
  <para style="q" vid="PRO 12:23">लेकिन बेवक़ूफ़ का दिल बेवक़ूफ़ी का 'ऐलान करता है।<verse eid="PRO 12:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 12:24"/>मेहनती आदमी का हाथ हुक्मराँ होगा,</para>
  <para style="q" vid="PRO 12:24">लेकिन सुस्त आदमी बाज गुज़ार बनेगा।<verse eid="PRO 12:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 12:25"/>आदमी का दिल फ़िक्रमंदी से दब जाता है,</para>
  <para style="q" vid="PRO 12:25">लेकिन अच्छी बात से ख़ुश होता है।<verse eid="PRO 12:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 12:26"/>सादिक़ अपने पड़ोसी की रहनुमाई करता है,</para>
  <para style="q" vid="PRO 12:26">लेकिन शरीरों का चाल चलन उनको गुमराह कर देता है।<verse eid="PRO 12:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 12:27"/>सुस्त आदमी शिकार पकड़ कर कबाब नहीं करता,</para>
  <para style="q" vid="PRO 12:27">लेकिन इंसान की गिरानबहा दौलत मेहनती पाता है।<verse eid="PRO 12:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 12:28"/>सदाक़त की राह में ज़िन्दगी है,</para>
  <para style="q" vid="PRO 12:28">और उसके रास्ते में हरगिज़ मौत नहीं।<verse eid="PRO 12:28"/></para>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 13:1"/>'अक़्लमंद बेटा अपने बाप की ता'लीम को सुनता है,</para>
  <para style="q" vid="PRO 13:1">लेकिन ठठ्ठा बाज़ सरज़निश पर कान नहीं लगाता।<verse eid="PRO 13:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 13:2"/>आदमी अपने कलाम के फल से अच्छा खाएगा,</para>
  <para style="q" vid="PRO 13:2">लेकिन दग़ाबाज़ों की जान के लिए सितम है।<verse eid="PRO 13:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 13:3"/>अपने मुँह की निगहबानी करने वाला अपनी जान की हिफ़ाज़त करता है</para>
  <para style="q" vid="PRO 13:3">लेकिन जो अपने होंट पसारता है, हलाक होगा।<verse eid="PRO 13:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 13:4"/>सुस्त आदमी आरजू़ करता है लेकिन कुछ नहीं पाता,</para>
  <para style="q" vid="PRO 13:4">लेकिन मेहनती की जान सेर होगी।<verse eid="PRO 13:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 13:5"/>सादिक़ को झूट से नफ़रत है,</para>
  <para style="q" vid="PRO 13:5">लेकिन शरीर नफरत अंगेज़ — ओ — रुस्वा होता है।<verse eid="PRO 13:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 13:6"/>सदाक़त रास्तरौ की हिफाज़त करती है,</para>
  <para style="q" vid="PRO 13:6">लेकिन शरारत शरीर को गिरा देती है।<verse eid="PRO 13:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 13:7"/>कोई अपने आप को दौलतमंद जताता है लेकिन ग़रीब है,</para>
  <para style="q" vid="PRO 13:7">और कोई अपने आप को कंगाल बताता है लेकिन बड़ा मालदार है।<verse eid="PRO 13:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 13:8"/>आदमी की जान का कफ़्फ़ारा उसका माल है,</para>
  <para style="q" vid="PRO 13:8">लेकिन कंगाल धमकी को नहीं सुनता।<verse eid="PRO 13:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 13:9"/>सादिक़ों का चिराग़ रोशन रहेगा,</para>
  <para style="q" vid="PRO 13:9">लेकिन शरीरों का दिया बुझाया जाएगा।<verse eid="PRO 13:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 13:10"/>तकब्बुर से सिर्फ़ झगड़ा पैदा होताहै,</para>
  <para style="q" vid="PRO 13:10">लेकिन मश्वरत पसंद के साथ हिकमत है।<verse eid="PRO 13:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 13:11"/>जो दौलत बेकारी से हासिल की जाए कम हो जाएगी,</para>
  <para style="q" vid="PRO 13:11">लेकिन मेहनत से जमा' करने वाले की दौलत बढ़ती रहेगी।<verse eid="PRO 13:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 13:12"/>उम्मीद के पूरा होने में ताख़ीर दिल को बीमार करती है,</para>
  <para style="q" vid="PRO 13:12">लेकिन आरजू़ का पूरा होना ज़िन्दगी का दरख़्त है।<verse eid="PRO 13:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 13:13"/>जो कलाम की तहक़ीर करता है,</para>
  <para style="q" vid="PRO 13:13">अपने आप पर हलाकत लाता है; लेकिन जो फ़रमान से डरता है, अज्र पाएगा।<verse eid="PRO 13:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 13:14"/>'अक़्लमंद की ता'लीम ज़िन्दगी का चश्मा है,</para>
  <para style="q" vid="PRO 13:14">जो मौत के फंदो से छुटकारे का ज़रिया' हो।<verse eid="PRO 13:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 13:15"/>समझ की दुरुस्ती मक़्बूलियत बख़्शती है,</para>
  <para style="q" vid="PRO 13:15">लेकिन दग़ाबाज़ों की राह कठिन है।<verse eid="PRO 13:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 13:16"/>हर एक होशियार आदमी 'अक़्लमंदी से काम करता है,</para>
  <para style="q" vid="PRO 13:16">पर बेवक़ूफ़ अपनी बेवक़ूफ़ी को फैला देता है।<verse eid="PRO 13:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 13:17"/>शरीर क़ासिद बला में गिरफ़्तार होता है,</para>
  <para style="q" vid="PRO 13:17">लेकिन ईमानदार एल्ची सिहत बख़्श है।<verse eid="PRO 13:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 13:18"/>तरबियत को रद्द करने वाला कंगालऔर रुस्वा होगा,</para>
  <para style="q" vid="PRO 13:18">लेकिन वह जो तम्बीह का लिहाज़ रखता है, 'इज़्ज़त पाएगा।<verse eid="PRO 13:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 13:19"/>जब मुराद पूरी होती है तब जी बहुत ख़ुश होता है,</para>
  <para style="q" vid="PRO 13:19">लेकिन बदी को छोड़ने से बेवक़ूफ़ को नफ़रत है।<verse eid="PRO 13:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 13:20"/>वह जो 'अक़्लमंदों के साथ चलता है 'अक़्लमंद होगा,</para>
  <para style="q" vid="PRO 13:20">पर बेवक़ूफ़ों का साथी हलाक किया जाएगा।<verse eid="PRO 13:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 13:21"/>बदी गुनहगारों का पीछा करती है,</para>
  <para style="q" vid="PRO 13:21">लेकिन सादिक़ों को नेक बदला मिलेगा।<verse eid="PRO 13:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 13:22"/>नेक आदमी अपने पोतों के लिए मीरास छोड़ता है,</para>
  <para style="q" vid="PRO 13:22">लेकिन गुनहगार की दौलत सादिक़ों के लिए फ़राहम की जाती है<verse eid="PRO 13:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 13:23"/>कंगालों की खेती में बहुत ख़ुराक होती है,</para>
  <para style="q" vid="PRO 13:23">लेकिन ऐसे लोग भी हैं जो बे इन्साफ़ी से बर्बाद हो जाते हैं।<verse eid="PRO 13:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 13:24"/>वह जो अपनी छड़ी को बाज़ रखता है, अपने बेटे से नफ़रत रखता है,</para>
  <para style="q" vid="PRO 13:24">लेकिन वह जो उससे मुहब्बत रखता है, बरवक़्त उसको तम्बीह करता है।<verse eid="PRO 13:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 13:25"/>सादिक़ खाकर सेर हो जाता है,</para>
  <para style="q" vid="PRO 13:25">लेकिन शरीर का पेट नहीं भरता।<verse eid="PRO 13:25"/></para>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 14:1"/>'अक़्लमंद 'औरत अपना घर बनाती है,</para>
  <para style="q" vid="PRO 14:1">लेकिन बेवक़ूफ़ उसे अपने ही हाथों से बर्बाद करती है।<verse eid="PRO 14:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 14:2"/>रास्तरौ ख़ुदावन्द से डरता है,</para>
  <para style="q" vid="PRO 14:2">लेकिन कजरौ उसकी हिक़ारत करता है।<verse eid="PRO 14:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 14:3"/>बेवक़ूफ़ में से गु़रूर फूट निकलता है,</para>
  <para style="q" vid="PRO 14:3">लेकिन 'अक़्लमंदों के लब उनकी निगहबानी करते हैं।<verse eid="PRO 14:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 14:4"/>जहाँ बैल नहीं, वहाँ चरनी साफ़ है,</para>
  <para style="q" vid="PRO 14:4">लेकिन ग़ल्ला की अफ़ज़ा इस बैल के ज़ोर से है।<verse eid="PRO 14:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 14:5"/>ईमानदार गवाह झूट नहीं बोलता,</para>
  <para style="q" vid="PRO 14:5">लेकिन झूटा गवाह झूटी बातें बयान करता है।<verse eid="PRO 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 14:6"/>ठठ्ठा बाज़ हिकमत की तलाश करता और नहीं पाता,</para>
  <para style="q" vid="PRO 14:6">लेकिन समझदार को 'इल्म आसानी से हासिल होता है।<verse eid="PRO 14:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 14:7"/>बेवक़ूफ़ से किनारा कर,</para>
  <para style="q" vid="PRO 14:7">क्यूँकि तू उस में 'इल्म की बातें नहीं पाएगा।<verse eid="PRO 14:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 14:8"/>होशियार की हिकमत यह है कि अपनी राह पहचाने,</para>
  <para style="q" vid="PRO 14:8">लेकिन बेवक़ूफ़ की बेवक़ूफ़ी धोखा है।<verse eid="PRO 14:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 14:9"/>बेवक़ूफ़ गुनाह करके हँसते हैं,</para>
  <para style="q" vid="PRO 14:9">लेकिन रास्तकारों में रज़ामंदी है।<verse eid="PRO 14:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 14:10"/>अपनी तल्ख़ी को दिल ही खू़ब जानता है,</para>
  <para style="q" vid="PRO 14:10">और बेगाना उसकी खु़शी में दख़्ल नहीं रखता।<verse eid="PRO 14:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 14:11"/>शरीर का घर बर्बाद हो जाएगा,</para>
  <para style="q" vid="PRO 14:11">लेकिन रास्त आदमी का खे़मा आबाद रहेगा।<verse eid="PRO 14:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 14:12"/>ऐसी राह भी है जो इंसान को सीधी मा'लूम होती है,</para>
  <para style="q" vid="PRO 14:12">लेकिन उसकी इन्तिहा में मौत की राहें हैं।<verse eid="PRO 14:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 14:13"/>हँसने में भी दिल ग़मगीन है,</para>
  <para style="q" vid="PRO 14:13">और शादमानी का अंजाम ग़म है।<verse eid="PRO 14:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 14:14"/>नाफ़रमान दिल अपने चाल चलन का बदला पाता है,</para>
  <para style="q" vid="PRO 14:14">और नेक आदमी अपने काम का।<verse eid="PRO 14:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 14:15"/>नादान हर बात का यक़ीन कर लेता है,</para>
  <para style="q" vid="PRO 14:15">लेकिन होशियार आदमी अपने चाल चलन को देखता भालता है।<verse eid="PRO 14:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 14:16"/>'अक़्लमंद डरता है और बदी से अलग रहता है,</para>
  <para style="q" vid="PRO 14:16">लेकिन बेवक़ूफ़ झुंझलाता है और बेख़ौफ़ रहता है।<verse eid="PRO 14:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 14:17"/>जूद रंज बेवक़ूफ़ी करता है,</para>
  <para style="q" vid="PRO 14:17">और बुरे मन्सुबे बाँधने वाला घिनौना है।<verse eid="PRO 14:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 14:18"/>नादान हिमाक़त की मीरास पाते हैं,</para>
  <para style="q" vid="PRO 14:18">लेकिन होशियारों के सिर लेकिन 'इल्म का ताज है।<verse eid="PRO 14:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 14:19"/>शरीर नेकों के सामने झुकते हैं,</para>
  <para style="q" vid="PRO 14:19">और ख़बीस सादिक़ों के दरवाज़ों पर।<verse eid="PRO 14:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 14:20"/>कंगाल से उसका पड़ोसी भी बेज़ार है,</para>
  <para style="q" vid="PRO 14:20">लेकिन मालदार के दोस्त बहुत हैं।<verse eid="PRO 14:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 14:21"/>अपने पड़ोसी को हक़ीर जानने वाला गुनाह करता है,</para>
  <para style="q" vid="PRO 14:21">लेकिन कंगाल पर रहम करने वाला मुबारक है।<verse eid="PRO 14:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 14:22"/>क्या बदी के मूजिद गुमराह नहीं होते?</para>
  <para style="q" vid="PRO 14:22">लेकिन शफ़क़त और सच्चाई नेकी के मूजिद के लिए हैं।<verse eid="PRO 14:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 14:23"/>हर तरह की मेहनत में नफ़ा' है,</para>
  <para style="q" vid="PRO 14:23">लेकिन मुँह की बातों में महज़ मुहताजी है।<verse eid="PRO 14:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 14:24"/>'अक़्लमंदों का ताज उनकी दौलत है,</para>
  <para style="q" vid="PRO 14:24">लेकिन बेवक़ूफ़ की बेवक़ूफ़ी ही बेवक़ूफ़ी है।<verse eid="PRO 14:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 14:25"/>सच्चा गवाह जान बचाने वाला है,</para>
  <para style="q" vid="PRO 14:25">लेकिन झूठा गवाह दग़ाबाज़ी करता है।<verse eid="PRO 14:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 14:26"/>ख़ुदावन्द के ख़ौफ़ में क़वी उम्मीद है,</para>
  <para style="q" vid="PRO 14:26">और उसके फ़र्ज़न्दों को पनाह की जगह मिलती है।<verse eid="PRO 14:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 14:27"/>ख़ुदावन्द का ख़ौफ़ ज़िन्दगी का चश्मा है,</para>
  <para style="q" vid="PRO 14:27">जो मौत के फंदों से छुटकारे का ज़रिया' है।<verse eid="PRO 14:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 14:28"/>रि'आया की कसरत में बादशाह की शान है,</para>
  <para style="q" vid="PRO 14:28">लेकिन लोगों की कमी में हाकिम की तबाही है।<verse eid="PRO 14:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 14:29"/>जो क़हर करने में धीमा है,</para>
  <para style="q" vid="PRO 14:29">बड़ा 'अक़्लमन्द है लेकिन वह जो बेवक़ूफ़ है हिमाकत को बढ़ाता है।<verse eid="PRO 14:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 14:30"/>मुत्मइन दिल, जिस्म की जान है,</para>
  <para style="q" vid="PRO 14:30">लेकिन जलन हड्डियों की बूसीदिगी है।<verse eid="PRO 14:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 14:31"/>ग़रीब पर जु़ल्म करने वाला उसके ख़ालिक़ की इहानत करता है,</para>
  <para style="q" vid="PRO 14:31">लेकिन उसकी ता'ज़ीम करने वाला मुहताजों पर रहम करता है।<verse eid="PRO 14:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 14:32"/>शरीर अपनी शरारत में पस्त किया जाता है,</para>
  <para style="q" vid="PRO 14:32">लेकिन सादिक़ मरने पर भी उम्मीदवार है।<verse eid="PRO 14:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 14:33"/>हिकमत 'अक़्लमंद के दिल में क़ाईम रहती है,</para>
  <para style="q" vid="PRO 14:33">लेकिन बेवक़ूफ़ों का दिली राज़ खुल जाता है।<verse eid="PRO 14:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 14:34"/>सदाक़त कौम को सरफ़राज़ी बख़्शती है,</para>
  <para style="q" vid="PRO 14:34">लकिन गुनाह से उम्मतों की रुस्वाई है।<verse eid="PRO 14:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 14:35"/>'अक़्लमंद ख़ादिम पर बादशाह की नज़र — ए — इनायत है,</para>
  <para style="q" vid="PRO 14:35">लेकिन उसका क़हर उस पर है जो रुस्वाई का ज़रिया' है।<verse eid="PRO 14:35"/></para>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 15:1"/>नर्म जवाब क़हर को दूर कर देता है,</para>
  <para style="q" vid="PRO 15:1">लेकिन कड़वी बातें ग़ज़ब अंगेज़ हैं।<verse eid="PRO 15:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 15:2"/>'अक़्लमंदों की ज़बान 'इल्म का दुरुस्त बयान करती है,</para>
  <para style="q" vid="PRO 15:2">लेकिन बेवक़ूफ़ का मुँह हिमाक़त उगलता है।<verse eid="PRO 15:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 15:3"/>ख़ुदावन्द की आँखें हर जगह हैं</para>
  <para style="q" vid="PRO 15:3">और नेकों और बदों की निगरान हैं।<verse eid="PRO 15:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 15:4"/>सिहत बख़्श ज़बान ज़िन्दगी का दरख़्त है,</para>
  <para style="q" vid="PRO 15:4">लेकिन उसकी कजगोई रूह की शिकस्तगी का ज़रिया है।<verse eid="PRO 15:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 15:5"/>बेवक़ूफ़ अपने बाप की तरबियत को हक़ीर जानता है,</para>
  <para style="q" vid="PRO 15:5">लेकिन तम्बीह का लिहाज़ रखने वाला होशियार हो जाता है।<verse eid="PRO 15:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 15:6"/>सादिक़ के घर में बड़ा ख़ज़ाना है,</para>
  <para style="q" vid="PRO 15:6">लेकिन शरीर की आमदनी में परेशानी है।<verse eid="PRO 15:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 15:7"/>'अक़्लमंदों के लब 'इल्म फैलाते हैं,</para>
  <para style="q" vid="PRO 15:7">लेकिन बेवक़ूफ़ों के दिल ऐसे नहीं।<verse eid="PRO 15:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 15:8"/>शरीरों के ज़बीहे से ख़ुदावन्द को नफ़रत है,</para>
  <para style="q" vid="PRO 15:8">लेकिन रास्तकार की दुआ उसकी ख़ुशनूदी है।<verse eid="PRO 15:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 15:9"/>शरीरों का चाल चलन से ख़ुदावन्द को नफ़रत है,</para>
  <para style="q" vid="PRO 15:9">लेकिन वह सदाकत के पैरौ से मुहब्बत रखता है।<verse eid="PRO 15:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 15:10"/>राह से भटकने वाले के लिए सख़्त तादीब है,</para>
  <para style="q" vid="PRO 15:10">और तम्बीह से नफ़रत करने वाला मरेगा।<verse eid="PRO 15:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 15:11"/>जब पाताल और जहन्नुम ख़ुदावन्द के सामने खुले हैं,</para>
  <para style="q" vid="PRO 15:11">तो बनी आदम के दिल का क्या ज़िक्र?<verse eid="PRO 15:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 15:12"/>ठठ्ठाबाज़ तम्बीह को दोस्त नहीं रखता,</para>
  <para style="q" vid="PRO 15:12">और 'अक़्लमंदों की मजलिस में हरगिज़ नहीं जाता।<verse eid="PRO 15:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 15:13"/>ख़ुश दिली चेहरे की रौनक पैदा करती है,</para>
  <para style="q" vid="PRO 15:13">लेकिन दिल की ग़मगीनी से इंसान शिकस्ता ख़ातिर होता है।<verse eid="PRO 15:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 15:14"/>समझदार का दिल 'इल्म का तालिब है,</para>
  <para style="q" vid="PRO 15:14">लेकिन बेवक़ूफ़ों की ख़ुराक बेवक़ूफ़ी है।<verse eid="PRO 15:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 15:15"/>मुसीबत ज़दा के तमाम दिन बुरे हैं,</para>
  <para style="q" vid="PRO 15:15">लेकिन ख़ुश दिल हमेशा जश्न करता है।<verse eid="PRO 15:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 15:16"/>थोड़ा जो ख़ुदावन्द के ख़ौफ़ के साथ हो,</para>
  <para style="q" vid="PRO 15:16">उस बड़े ख़ज़ाने से जो परेशानी के साथ हो, बेहतर है।<verse eid="PRO 15:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 15:17"/>मुहब्बत वाले घर में ज़रा सा सागपात,</para>
  <para style="q" vid="PRO 15:17">'अदावत वाले घर में पले हुए बैल से बेहतर है।<verse eid="PRO 15:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 15:18"/>ग़ज़बनाक आदमी फ़ितना खड़ा करता है,</para>
  <para style="q" vid="PRO 15:18">लेकिन जो क़हर में धीमा है झगड़ा मिटाता है।<verse eid="PRO 15:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 15:19"/>काहिल की राह काँटो की आड़ सी है,</para>
  <para style="q" vid="PRO 15:19">लेकिन रास्तकारों का चाल चलन शाहराह की तरह है।<verse eid="PRO 15:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 15:20"/>'अक़्लमंद बेटा बाप को ख़ुश रखता है,</para>
  <para style="q" vid="PRO 15:20">लेकिन बेवक़ूफ़ अपनी माँ की तहक़ीर करता है।<verse eid="PRO 15:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 15:21"/>बे'अक़्ल के लिए बेवक़ूफ़ी शादमानी का ज़रिया' है,</para>
  <para style="q" vid="PRO 15:21">लेकिन समझदार अपने चाल चलन को दुरुस्त करता है<verse eid="PRO 15:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 15:22"/>सलाह के बगै़र इरादे पूरे नहीं होते,</para>
  <para style="q" vid="PRO 15:22">लेकिन सलाहकारों की कसरत से क़याम पाते हैं।<verse eid="PRO 15:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 15:23"/>आदमी अपने मुँह के जवाब से ख़ुश होता है,</para>
  <para style="q" vid="PRO 15:23">और बामौक़ा' बात क्या खू़ब है।<verse eid="PRO 15:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 15:24"/>'अक़्लमंद के लिए ज़िन्दगी की राह ऊपर को जाती है,</para>
  <para style="q" vid="PRO 15:24">ताकि वह पाताल में उतरने से बच जाए।<verse eid="PRO 15:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 15:25"/>ख़ुदावन्द मग़रूरों का घर ढा देता है,</para>
  <para style="q" vid="PRO 15:25">लेकिन वह बेवा के सिवाने को क़ाईम करता है।<verse eid="PRO 15:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 15:26"/>बुरे मन्सूबों से ख़ुदावन्द को नफ़रत है</para>
  <para style="q" vid="PRO 15:26">लेकिन पाक लोगों का कलाम पसंदीदा है।<verse eid="PRO 15:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 15:27"/>नफ़े' का लालची अपने घराने को परेशान करता है,</para>
  <para style="q" vid="PRO 15:27">लेकिन वह जिसकी रिश्वत से नफ़रत है ज़िन्दा रहेगा।<verse eid="PRO 15:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 15:28"/>सादिक़ का दिल सोचकर जवाब देता है,</para>
  <para style="q" vid="PRO 15:28">लेकिन शरीरों का मुँह बुरी बातें उगलता है।<verse eid="PRO 15:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 15:29"/>ख़ुदावन्द शरीरों से दूर है,</para>
  <para style="q" vid="PRO 15:29">लेकिन वह सादिक़ों की दुआ सुनता है।<verse eid="PRO 15:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 15:30"/>आँखों का नूर दिल को ख़ुश करता है,</para>
  <para style="q" vid="PRO 15:30">और ख़ुश ख़बरी हड्डियों में फ़रबही पैदा करती है।<verse eid="PRO 15:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 15:31"/>जो ज़िन्दगी बख़्श तम्बीह पर कान लगाता है,</para>
  <para style="q" vid="PRO 15:31">'अक़्लमंदों के बीच सुकूनत करेगा।<verse eid="PRO 15:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 15:32"/>तरबियत को रद्द करने वाला अपनी ही जान का दुश्मन है,</para>
  <para style="q" vid="PRO 15:32">लेकिन तम्बीह पर कान लगाने वाला समझ हासिल करता है।<verse eid="PRO 15:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 15:33"/>ख़ुदावन्द का ख़ौफ़ हिकमत की तरबियत है,</para>
  <para style="q" vid="PRO 15:33">और सरफ़राज़ी से पहले फ़रोतनी है।<verse eid="PRO 15:33"/></para>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 16:1"/>दिल की तदबीरें इंसान से हैं,</para>
  <para style="q" vid="PRO 16:1">लेकिन ज़बान का जवाब ख़ुदावन्द की तरफ़ से है।<verse eid="PRO 16:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 16:2"/>इंसान की नज़र में उसके सब चाल चलन पाक हैं,</para>
  <para style="q" vid="PRO 16:2">लेकिन ख़ुदावन्द रूहों को जाँचता है।<verse eid="PRO 16:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 16:3"/>अपने सब काम ख़ुदावन्द पर छोड़ दे,</para>
  <para style="q" vid="PRO 16:3">तो तेरे इरादे क़ाईम रहेंगे।<verse eid="PRO 16:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 16:4"/>ख़ुदावन्द ने हर एक चीज़ ख़ास मक़सद के लिए बनाई,</para>
  <para style="q" vid="PRO 16:4">हाँ शरीरों को भी उसने बुरे दिन के लिए बनाया।<verse eid="PRO 16:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 16:5"/>हर एक से जिसके दिल में गु़रूर है,</para>
  <para style="q" vid="PRO 16:5">ख़ुदावन्द को नफ़रत है; यक़ीनन वह बे सज़ा न छूटेगा।<verse eid="PRO 16:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 16:6"/>शफ़क़त और सच्चाई से बदी का और लोग ख़ुदावन्द के ख़ौफ़ की वजह से बदी से बाज़ आते हैं।<verse eid="PRO 16:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 16:7"/>जब इंसान का चाल चलन ख़ुदावन्द को पसंद आता है तो वह उसके दुश्मनों को भी उसके दोस्त बनाता है।<verse eid="PRO 16:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 16:8"/>सदाक़त के साथ थोड़ा सा माल,</para>
  <para style="q" vid="PRO 16:8">बे इन्साफ़ी की बड़ी आमदनी से बेहतर है।<verse eid="PRO 16:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 16:9"/>आदमी का दिल आपनी राह ठहराता है</para>
  <para style="q" vid="PRO 16:9">लेकिन ख़ुदावन्द उसके क़दमों की रहनुमाई करता है।<verse eid="PRO 16:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 16:10"/>कलाम — ए — रब्बानी बादशाह के लबों से निकलता है,</para>
  <para style="q" vid="PRO 16:10">और उसका मुँह 'अदालत करने में ख़ता नहीं करता।<verse eid="PRO 16:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 16:11"/>ठीक तराजू़ और पलड़े ख़ुदावन्द के हैं,</para>
  <para style="q" vid="PRO 16:11">थैली के सब तौल बाट उसका काम हैं।<verse eid="PRO 16:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 16:12"/>शरारत करने से बादशाहों को नफ़रत है,</para>
  <para style="q" vid="PRO 16:12">क्यूँकि तख़्त का क़याम सदाक़त से है।<verse eid="PRO 16:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 16:13"/>सादिक़ लब बादशाहों की ख़ुशनूदी हैं,</para>
  <para style="q" vid="PRO 16:13">और वह सच बोलने वालों को दोस्त रखते हैं।<verse eid="PRO 16:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 16:14"/>बादशाह का क़हर मौत का क़ासिद है,</para>
  <para style="q" vid="PRO 16:14">लेकिन 'अक़्लमंद आदमी उसे ठंडा करता है।<verse eid="PRO 16:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 16:15"/>बादशाह के चेहरे के नूर में ज़िन्दगी है,</para>
  <para style="q" vid="PRO 16:15">और उसकी नज़र — ए — 'इनायत आख़री बरसात के बादल की तरह है।<verse eid="PRO 16:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 16:16"/>हिकमत का हुसूल सोने से बहुत बेहतर है,</para>
  <para style="q" vid="PRO 16:16">और समझ का हुसूल चाँदी से बहुत पसन्दीदा है।<verse eid="PRO 16:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 16:17"/>रास्तकार आदमी की शाहराह यह है कि बदी से भागे,</para>
  <para style="q" vid="PRO 16:17">और अपनी राह का निगहबान अपनी जान की हिफ़ाजत करता है।<verse eid="PRO 16:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 16:18"/>हलाकत से पहले तकब्बुर,</para>
  <para style="q" vid="PRO 16:18">और ज़वाल से पहले ख़ुदबीनी है।<verse eid="PRO 16:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 16:19"/>ग़रीबों के साथ फ़रोतन बनना,</para>
  <para style="q" vid="PRO 16:19">मुतकब्बिरों के साथ लूट का माल तक़सीम करने से बेहतर है।<verse eid="PRO 16:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 16:20"/>जो कलाम पर तवज्जुह करता है,</para>
  <para style="q" vid="PRO 16:20">भलाई देखेगा:और जिसका भरोसा ख़ुदावन्द पर है, मुबारक है।<verse eid="PRO 16:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 16:21"/>'अक़्लमंद दिल होशियार कहलाएगा,</para>
  <para style="q" vid="PRO 16:21">और शीरीन ज़बानी से 'इल्म की फ़िरावानी होती है।<verse eid="PRO 16:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 16:22"/>'अक्लमंद के लिए 'अक़्ल हयात का चश्मा है,</para>
  <para style="q" vid="PRO 16:22">लेकिन बेवक़ूफ़ की तरबियत बेवक़ूफ़ ही है।<verse eid="PRO 16:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 16:23"/>'अक़्लमंद का दिल उसके मुँह की तरबियत करता है,</para>
  <para style="q" vid="PRO 16:23">और उसके लबों को 'इल्म बख़्शता है।<verse eid="PRO 16:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 16:24"/>दिलपसंद बातें शहद का छत्ता हैं,</para>
  <para style="q" vid="PRO 16:24">वह जी को मीठी लगती हैं और हड्डियों के लिए शिफ़ा हैं।<verse eid="PRO 16:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 16:25"/>ऐसी राह भी है, जो इंसान को सीधी मा'लूम होती है;</para>
  <para style="q" vid="PRO 16:25">लेकिन उसकी इन्तिहा में मौत की राहें हैं।<verse eid="PRO 16:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 16:26"/>मेहनत करने वाले की ख़्वाहिश उससे काम कराती है,</para>
  <para style="q" vid="PRO 16:26">क्यूँकि उसका पेट उसको उभारता है।<verse eid="PRO 16:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 16:27"/>ख़बीस आदमी शरारत को ख़ुद कर निकालता है,</para>
  <para style="q" vid="PRO 16:27">और उसके लबों में जैसे जलाने वाली आग है।<verse eid="PRO 16:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 16:28"/>टेढ़ा आदमी फ़ितना ओंगेज़ है,</para>
  <para style="q" vid="PRO 16:28">और ग़ीबत करने वाला दोस्तों में जुदाई डालता है।<verse eid="PRO 16:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 16:29"/>तुन्दखू़ आदमी अपने पड़ोसियों को वरग़लाता है,</para>
  <para style="q" vid="PRO 16:29">और उसको बुरी राह पर ले जाता है।<verse eid="PRO 16:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 16:30"/>आँख मारने वाला कजी ईजाद करता है,</para>
  <para style="q" vid="PRO 16:30">और लब चबाने वाला फ़साद खड़ा करता है।<verse eid="PRO 16:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 16:31"/>सफ़ेद सिर शौकत का ताज है;</para>
  <para style="q" vid="PRO 16:31">वह सदाक़त की राह पर पाया जाएगा।<verse eid="PRO 16:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 16:32"/>जो क़हर करने में धीमा है पहलवान से बेहतर है,</para>
  <para style="q" vid="PRO 16:32">और वह जो अपनी रूह पर ज़ाबित है उस से जो शहर को ले लेता है।<verse eid="PRO 16:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 16:33"/>पर्ची गोद में डाली जाती है,</para>
  <para style="q" vid="PRO 16:33">लेकिन उसका सारा इन्तिज़ाम ख़ुदावन्द की तरफ़ से है।<verse eid="PRO 16:33"/></para>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 17:1"/>सलामती के साथ ख़ुश्क निवाला इस से बेहतर है,</para>
  <para style="q" vid="PRO 17:1">कि घर ने'मत से भरा हो और उसके साथ झगड़ा हो।<verse eid="PRO 17:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 17:2"/>'अक्लमन्द नौकर उस बेटे पर जी रुस्वा करता है हुक्मरान होगा,</para>
  <para style="q" vid="PRO 17:2">और भाइयों में शमिल होकर मीरास का हिस्सा लेगा।<verse eid="PRO 17:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 17:3"/>चाँदी के लिए कुठाली है और सोने केलिए भट्टी,</para>
  <para style="q" vid="PRO 17:3">लेकिन दिलों को ख़ुदावन्द जांचता है।<verse eid="PRO 17:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 17:4"/>बदकिरदार झूटे लबों की सुनता है,</para>
  <para style="q" vid="PRO 17:4">और झूठा मुफ़सिद ज़बान का शनवा होता है।<verse eid="PRO 17:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 17:5"/>गरीब पर हँसने वाला, उसके ख़ालिक की बेक़द्री करता है;</para>
  <para style="q" vid="PRO 17:5">और जो औरों की मुसीबत से ख़ुश होता है, बे सज़ा न छूटेगा।<verse eid="PRO 17:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 17:6"/>बेटों के बेटे बूढ़ों के लिए ताज हैं;</para>
  <para style="q" vid="PRO 17:6">और बेटों के फ़ख़्र का ज़रिया' उनके बाप — दादा हैं।<verse eid="PRO 17:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 17:7"/>ख़ुश गोई बेवक़ूफ़ को नहीं सजती,</para>
  <para style="q" vid="PRO 17:7">तो किस क़दर कमदरोग़गोई शरीफ़ को सजेगी।<verse eid="PRO 17:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 17:8"/>रिश्वत जिसके हाथ में है उसकी नज़रमें गिरान बहा जवाहर है,</para>
  <para style="q" vid="PRO 17:8">और वह जिधर तवज्जुह करता है कामयाब होता है।<verse eid="PRO 17:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 17:9"/>जो ख़ता पोशी करता है मुहब्बत का तालिब है,</para>
  <para style="q" vid="PRO 17:9">लेकिन जो ऐसी बात को बार बार छेड़ता है, दोस्तों में जुदाई डालता है।<verse eid="PRO 17:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 17:10"/>समझदार पर एक झिड़की,</para>
  <para style="q" vid="PRO 17:10">बेवक़ूफ़ों पर सौ कोड़ों से ज़्यादा असर करती है।<verse eid="PRO 17:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 17:11"/>शरीर महज़ सरकशी का तालिब है,</para>
  <para style="q" vid="PRO 17:11">उसके मुक़ाबले में संगदिल क़ासिद भेजा जाएगा।<verse eid="PRO 17:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 17:12"/>जिस रीछनी के बच्चे पकड़े गए हों आदमी का उस से दो चार होना,</para>
  <para style="q" vid="PRO 17:12">इससे बेहतर है के बेवक़ूफ़ की बेवक़ूफ़ी में उसके सामने आए।<verse eid="PRO 17:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 17:13"/>जो नेकी के बदले में बदी करता है, उसके घर से बदी हरगिज़ जुदा न होगी।<verse eid="PRO 17:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 17:14"/>झगड़े का शुरू' पानी के फूट निकलने की तरह है,</para>
  <para style="q" vid="PRO 17:14">इसलिए लड़ाई से पहले झगड़े को छोड़ दे।<verse eid="PRO 17:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 17:15"/>जो शरीर को सादिक़ और जो सादिक़ को शरीर ठहराता है,</para>
  <para style="q" vid="PRO 17:15">ख़ुदावन्द को उन दोनों से नफ़रत है।<verse eid="PRO 17:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 17:16"/>हिकमत ख़रीदने को बेवक़ूफ़ के हाथ में क़ीमत से क्या फ़ाइदा है,</para>
  <para style="q" vid="PRO 17:16">हालाँकि उसका दिल उसकी तरफ़ नहीं?<verse eid="PRO 17:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 17:17"/>दोस्त हर वक़्त मुहब्बत दिखाता है,</para>
  <para style="q" vid="PRO 17:17">और भाई मुसीबत के दिन के लिए पैदा हुआ है।<verse eid="PRO 17:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 17:18"/>बे'अक़्ल आदमी हाथ पर हाथ मारता है,</para>
  <para style="q" vid="PRO 17:18">और अपने पड़ोसी के सामने ज़ामिन होता है।<verse eid="PRO 17:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 17:19"/>फ़साद पसंद ख़ता पसंद है,</para>
  <para style="q" vid="PRO 17:19">और अपने दरवाज़े को बलन्द करने वाला हलाकत का तालिब।<verse eid="PRO 17:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 17:20"/>कजदिला भलाई को न देखेगा,</para>
  <para style="q" vid="PRO 17:20">और जिसकी ज़बान कजगो है मुसीबत में पड़ेगा।<verse eid="PRO 17:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 17:21"/>बेवकूफ़ के वालिद के लिए ग़म है,</para>
  <para style="q" vid="PRO 17:21">क्यूँकि बेवक़ूफ़ के बाप को ख़ुशी नहीं।<verse eid="PRO 17:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 17:22"/>शादमान दिल शिफ़ा बख़्शता है,</para>
  <para style="q" vid="PRO 17:22">लेकिन अफ़सुर्दा दिली हड्डियों को ख़ुश्क कर देती है।<verse eid="PRO 17:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 17:23"/>शरीर बगल में रिश्वत रख लेता है,</para>
  <para style="q" vid="PRO 17:23">ताकि 'अदालत की राहें बिगाड़े।<verse eid="PRO 17:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 17:24"/>हिकमत समझदार के आमने सामने है,</para>
  <para style="q" vid="PRO 17:24">लेकिन बेवक़ूफ़ की आँख ज़मीन के किनारों पर लगी हैं।<verse eid="PRO 17:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 17:25"/>बेवक़ूफ़ बेटा अपने बाप के लिए ग़म,</para>
  <para style="q" vid="PRO 17:25">और अपनी माँ के लिए तल्ख़ी है।<verse eid="PRO 17:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 17:26"/>सादिक़ को सज़ा देना,</para>
  <para style="q" vid="PRO 17:26">और शरीफ़ों को उनकी रास्ती की वजह से मारना, खूब नहीं।<verse eid="PRO 17:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 17:27"/>साहिब — ए — इल्म कमगो है,</para>
  <para style="q" vid="PRO 17:27">और समझदार मतीन है।<verse eid="PRO 17:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 17:28"/>बेवक़ूफ़ भी जब तक ख़ामोश है, 'अक्लमन्द गिना जाता है;</para>
  <para style="q" vid="PRO 17:28">जो अपने लब बलंद रखता है, होशियार है।<verse eid="PRO 17:28"/></para>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 18:1"/>जो अपने आप को सब से अलग रखता है, अपनी ख़्वाहिश का तालिब है,</para>
  <para style="q" vid="PRO 18:1">और हर मा'कूल बात से बरहम होता है।<verse eid="PRO 18:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 18:2"/>बेवक़ूफ़ समझ से ख़ुश नहीं होता,</para>
  <para style="q" vid="PRO 18:2">लेकिन सिर्फ़ इस से कि अपने दिल का हाल ज़ाहिर करे।<verse eid="PRO 18:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 18:3"/>शरीर के साथ हिकारत आती है,</para>
  <para style="q" vid="PRO 18:3">और रुस्वाई के साथ ना क़द्री।<verse eid="PRO 18:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 18:4"/>इंसान के मुँह की बातें गहरे पानी की तरह है</para>
  <para style="q" vid="PRO 18:4">और हिकमत का चश्मा बहता नाला है।<verse eid="PRO 18:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 18:5"/>शरीर की तरफ़दारी करना,</para>
  <para style="q" vid="PRO 18:5">या 'अदालत में सादिक़ से बेइन्साफ़ी करना, अच्छा नहीं।<verse eid="PRO 18:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 18:6"/>बेवक़ूफ़ के होंट फ़ितनाअंगेज़ी करते हैं,</para>
  <para style="q" vid="PRO 18:6">और उसका मुँह तमाँचों के लिए पुकारता है।<verse eid="PRO 18:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 18:7"/>बेवक़ूफ़ का मुँह उसकी हलाकत है,</para>
  <para style="q" vid="PRO 18:7">और उसके होंट उसकी जान के लिए फन्दा हैं।<verse eid="PRO 18:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 18:8"/>ग़ैबतगो की बातें लज़ीज़ निवाले हैं</para>
  <para style="q" vid="PRO 18:8">और वह खू़ब हज़्म हो जाती हैं।<verse eid="PRO 18:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 18:9"/>काम में सुस्ती करने वाला,</para>
  <para style="q" vid="PRO 18:9">फ़ुज़ूल ख़र्च का भाई है।<verse eid="PRO 18:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 18:10"/>ख़ुदावन्द का नाम मज़बूत बुर्ज है,</para>
  <para style="q" vid="PRO 18:10">सादिक़ उस में भाग जाता है और अम्न में रहता है<verse eid="PRO 18:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 18:11"/>दौलतमन्द आदमी का माल उसका मज़बूत शहर,</para>
  <para style="q" vid="PRO 18:11">और उसके तसव्वुर में ऊँची दीवार की तरह है।<verse eid="PRO 18:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 18:12"/>आदमी के दिल में तकब्बुर हलाकत का पेशरौ है,</para>
  <para style="q" vid="PRO 18:12">और फ़रोतनी 'इज़्ज़त की पेशवा।<verse eid="PRO 18:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 18:13"/>जो बात सुनने से पहले उसका जवाब दे,</para>
  <para style="q" vid="PRO 18:13">यह उसकी बेवक़ूफ़ी और शर्मिन्दगी है।<verse eid="PRO 18:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 18:14"/>इंसान की रूह उसकी नातवानी में उसे संभालेगी,</para>
  <para style="q" vid="PRO 18:14">लेकिन अफ़सुर्दा दिली को कौन बर्दाश्त कर सकता है?<verse eid="PRO 18:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 18:15"/>होशियार का दिल 'इल्म हासिल करता है,</para>
  <para style="q" vid="PRO 18:15">और 'अक़्लमन्द के कान 'इल्म के तालिब हैं।<verse eid="PRO 18:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 18:16"/>आदमी का नज़राना उसके लिए जगह कर लेता है,</para>
  <para style="q" vid="PRO 18:16">और बड़े आदमियों के सामने उसकी रसाई कर देता है।<verse eid="PRO 18:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 18:17"/>जो पहले अपना दा'वा बयान करता है रास्त मा'लूम होता है,</para>
  <para style="q" vid="PRO 18:17">लेकिन दूसरा आकर उसकी हक़ीक़त ज़ाहिर करता है।<verse eid="PRO 18:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 18:18"/>पर्ची झगड़ों को ख़त्म करती है,</para>
  <para style="q" vid="PRO 18:18">और ज़बरदस्तों के बीच फ़ैसला कर देती है।<verse eid="PRO 18:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 18:19"/>नाराज़ भाई को राज़ी करना मज़बूत शहर ले लेने से ज़्यादा मुश्किल है,</para>
  <para style="q" vid="PRO 18:19">और झगड़े क़िले' के बेंडों की तरह हैं।<verse eid="PRO 18:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 18:20"/>आदमी की पेट उसके मुँह के फल से भरता है,</para>
  <para style="q" vid="PRO 18:20">और वहअपने लबों की पैदावार से सेर होता है।<verse eid="PRO 18:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 18:21"/>मौत और ज़िन्दगी ज़बान के क़ाबू में हैं,</para>
  <para style="q" vid="PRO 18:21">और जो उसे दोस्त रखते हैं उसका फल खाते हैं।<verse eid="PRO 18:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 18:22"/>जिसको बीवी मिली उसने तोहफ़ा पाया,</para>
  <para style="q" vid="PRO 18:22">और उस पर ख़ुदावन्द का फ़ज़ल हुआ।<verse eid="PRO 18:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 18:23"/>मुहताज मिन्नत समाजत करता है,</para>
  <para style="q" vid="PRO 18:23">लेकिन दौलतमन्द सख़्त जवाब देता है।<verse eid="PRO 18:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 18:24"/>जो बहुतों से दोस्ती करता है अपनी बर्बादी के लिए करता है,</para>
  <para style="q" vid="PRO 18:24">लेकिन ऐसा दोस्त भी है जो भाई से ज़्यादा मुहब्बत रखता है।<verse eid="PRO 18:24"/></para>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 19:1"/>रास्तरौ ग़रीब, कजगो और बेवक़ूफ़ से बेहतर है।<verse eid="PRO 19:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 19:2"/>ये भी अच्छा नहीं कि रूह 'इल्म से खाली रहे?</para>
  <para style="q" vid="PRO 19:2">जो चलने में जल्द बाज़ी करता है, भटक जाता है।<verse eid="PRO 19:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 19:3"/>आदमी की बेवक़ूफ़ी उसे गुमराह करती है,</para>
  <para style="q" vid="PRO 19:3">और उसका दिल ख़ुदावन्द से बेज़ार होता है।<verse eid="PRO 19:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 19:4"/>दौलत बहुत से दोस्त पैदा करती है,</para>
  <para style="q" vid="PRO 19:4">लेकिन ग़रीब अपने ही दोस्त से बेगाना है।<verse eid="PRO 19:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 19:5"/>झूटा गवाह बे सज़ा न छूटेगा,</para>
  <para style="q" vid="PRO 19:5">और झूट बोलने वाला रिहाई न पाएगा।<verse eid="PRO 19:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 19:6"/>बहुत से लोग सख़ी की ख़ुशामद करते हैं,</para>
  <para style="q" vid="PRO 19:6">और हर एक आदमी इना'म देने वाले का दोस्त है।<verse eid="PRO 19:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 19:7"/>जब मिस्कीन के सब भाई ही उससे नफ़रत करते है,</para>
  <para style="q" vid="PRO 19:7">तो उसके दोस्त कितने ज़्यादा उससे दूर भागेंगे।</para>
  <para style="q" vid="PRO 19:7">वह बातों से उनका पीछा करता है, लेकिन उनको नहीं पाता।<verse eid="PRO 19:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 19:8"/>जो हिकमत हासिल करता है अपनी जान को 'अज़ीज़ रखता है;</para>
  <para style="q" vid="PRO 19:8">जो समझ की मुहाफ़िज़त करता है फ़ाइदा उठाएगा।<verse eid="PRO 19:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 19:9"/>झूटा गवाह बे सज़ा न छूटेगा,</para>
  <para style="q" vid="PRO 19:9">और जो झूठ बोलता है फ़ना होगा।<verse eid="PRO 19:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 19:10"/>जब बेवक़ूफ़ के लिए नाज़ — ओ — ने'मत ज़ेबा नहीं तो ख़ादिम का शहज़ादों पर हुक्मरान होनाऔर भी मुनासिब नहीं।<verse eid="PRO 19:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 19:11"/>आदमी की तमीज़ उसको क़हर करने में धीमा बनाती है,</para>
  <para style="q" vid="PRO 19:11">और ख़ता से दरगुज़र करने में उसकी शान है।<verse eid="PRO 19:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 19:12"/>बादशाह का ग़ज़ब शेर की गरज की तरह है,</para>
  <para style="q" vid="PRO 19:12">और उसकी नज़र — ए — 'इनायत घास पर शबनम की तरह।<verse eid="PRO 19:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 19:13"/>बेवक़ूफ़ बेटा अपने बाप के लिए बला है,</para>
  <para style="q" vid="PRO 19:13">और बीवी का झगड़ा रगड़ा सदा का टपका।<verse eid="PRO 19:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 19:14"/>घर और माल तो बाप दादा से मीरास में मिलते हैं,</para>
  <para style="q" vid="PRO 19:14">लेकिन अक़्लमंद बीवी ख़ुदावन्द से मिलती है।<verse eid="PRO 19:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 19:15"/>काहिली नींद में गर्क़ कर देती है,</para>
  <para style="q" vid="PRO 19:15">और काहिल आदमी भूका रहेगा।<verse eid="PRO 19:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 19:16"/>जो फ़रमान बजा लाता है अपनी जान की मुहाफ़ज़त पर जो अपनी राहों से ग़ाफ़िल है, मरेगा।<verse eid="PRO 19:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 19:17"/>जो ग़रीबों पर रहम करता है, ख़ुदावन्द को क़र्ज़ देता है,</para>
  <para style="q" vid="PRO 19:17">और वह अपनी नेकी का बदला पाएगा।<verse eid="PRO 19:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 19:18"/>जब तक उम्मीद है अपने बेटे की तादीब किए जा</para>
  <para style="q" vid="PRO 19:18">और उसकी बर्बादी पर दिल न लगा।<verse eid="PRO 19:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 19:19"/>ग़ुस्सावर आदमी सज़ा पाएगा;</para>
  <para style="q" vid="PRO 19:19">क्यूँकि अगर तू उसे रिहाई दे तो तुझे बार बार ऐसा ही करना होगा।<verse eid="PRO 19:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 19:20"/>मश्वरत को सुन और तरबियत पज़ीर हो,</para>
  <para style="q" vid="PRO 19:20">ताकि तू आख़िर कार 'अक़्लमन्द हो जाए।<verse eid="PRO 19:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 19:21"/>आदमी के दिल में बहुत से मन्सूबे हैं,</para>
  <para style="q" vid="PRO 19:21">लेकिन सिर्फ़ ख़ुदावन्द का इरादा ही क़ाईम रहेगा।<verse eid="PRO 19:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 19:22"/>आदमी की मक़बूलियत उसके एहसान से है,</para>
  <para style="q" vid="PRO 19:22">और कंगाल झूठे आदमी से बेहतर है।<verse eid="PRO 19:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 19:23"/>ख़ुदावन्द का ख़ौफ़ ज़िन्दगी बख़्श है,</para>
  <para style="q" vid="PRO 19:23">और ख़ुदा तरस सेर होगा, और बदी से महफ़ूज़ रहेगा।<verse eid="PRO 19:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 19:24"/>सुस्त आदमी अपना हाथ थाली में डालता है,</para>
  <para style="q" vid="PRO 19:24">और इतना भी नहीं करता की फिर उसे अपने मुँह तक लाए।<verse eid="PRO 19:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 19:25"/>ठट्ठा करने वाले को मार, इससे सादा दिल होशियार हो जाएगा,</para>
  <para style="q" vid="PRO 19:25">और समझदार को तम्बीह कर, वह 'इल्म हासिल करेगा।<verse eid="PRO 19:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 19:26"/>जो अपने बाप से बदसुलूकी करता और माँ को निकाल देता है,</para>
  <para style="q" vid="PRO 19:26">शर्मिन्दगी का ज़रिया'और रुस्वाई लाने वाला बेटा है।<verse eid="PRO 19:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 19:27"/>ऐ मेरे बेटे, अगर तू 'इल्म से बरगश्ता होता है,</para>
  <para style="q" vid="PRO 19:27">तो ता'लीम सुनने से क्या फ़ायदा?<verse eid="PRO 19:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 19:28"/>ख़बीस गवाह 'अद्ल पर हँसता है,</para>
  <para style="q" vid="PRO 19:28">और शरीर का मुँह बदी निगलता रहता है।<verse eid="PRO 19:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 19:29"/>ठठ्ठा करने वालों के लिए सज़ाएँ ठहराई जाती हैं,</para>
  <para style="q" vid="PRO 19:29">और बेवक़ूफ़ों की पीठ के लिए कोड़े हैं।<verse eid="PRO 19:29"/></para>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 20:1"/>मय मसख़रा और शराब हंगामा करने वाली है,</para>
  <para style="q" vid="PRO 20:1">और जो कोई इनसे फ़रेब खाता है, 'अक़्लमन्द नहीं।<verse eid="PRO 20:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 20:2"/>बादशाह का रो'ब शेर की गरज की तरह है: जो कोई उसे गु़स्सा दिलाता है,</para>
  <para style="q" vid="PRO 20:2">अपनी जान से बदी करता है।<verse eid="PRO 20:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 20:3"/>झगड़े से अलग रहने में आदमी की 'इज्ज़त है,</para>
  <para style="q" vid="PRO 20:3">लेकिन हर एक बेवक़ूफ़ झगड़ता रहता है,<verse eid="PRO 20:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 20:4"/>काहिल आदमी जाड़े की वजह हल नहीं चलाता;</para>
  <para style="q" vid="PRO 20:4">इसलिए फ़सल काटने के वक़्त वह भीक माँगेगा, और कुछ न पाएगा।<verse eid="PRO 20:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 20:5"/>आदमी के दिल की बात गहरे पानी की तरह है,</para>
  <para style="q" vid="PRO 20:5">लेकिन समझदार आदमी उसे खींच निकालेगा।<verse eid="PRO 20:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 20:6"/>अक्सर लोग अपना अपना एहसान जताते हैं,</para>
  <para style="q" vid="PRO 20:6">लेकिन वफ़ादार आदमी किसको मिलेगा?<verse eid="PRO 20:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 20:7"/>रास्तरौ सादिक़ के बा'द,</para>
  <para style="q" vid="PRO 20:7">उसके बेटे मुबारक होते हैं।<verse eid="PRO 20:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 20:8"/>बादशाह जो तख़्त — ए — 'अदालत पर बैठता है,</para>
  <para style="q" vid="PRO 20:8">खुद देखकर हर तरह की बदी को फटकता है।<verse eid="PRO 20:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 20:9"/>कौन कह सकता है कि मैंने अपने दिल को साफ़ कर लिया है;</para>
  <para style="q" vid="PRO 20:9">और मैं अपने गुनाह से पाक हो गया हूँ?<verse eid="PRO 20:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 20:10"/>दो तरह के तौल बाट और दो तरह के पैमाने,</para>
  <para style="q" vid="PRO 20:10">इन दोनों से ख़ुदा को नफ़रत है।<verse eid="PRO 20:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 20:11"/>बच्चा भी अपनी हरकतों से पहचाना जाता है,</para>
  <para style="q" vid="PRO 20:11">कि उसके काम नेक — ओ — रास्त हैं कि नहीं।<verse eid="PRO 20:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 20:12"/>सुनने वाले कान और देखने वाली आँख दोनों को ख़ुदावन्द ने बनाया है।<verse eid="PRO 20:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 20:13"/>ख़्वाब दोस्त न हो, कहीं ऐसा तू कंगाल हो जाए;</para>
  <para style="q" vid="PRO 20:13">अपनी आँखें खोल कि तू रोटी से सेर होगा।<verse eid="PRO 20:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 20:14"/>ख़रीदार कहता है, रद्दी है, रद्दी,</para>
  <para style="q" vid="PRO 20:14">लेकिन जब चल पड़ता है तो फ़ख़्र करता है।<verse eid="PRO 20:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 20:15"/>ज़र — ओ — मरजान की तो कसरत है,</para>
  <para style="q" vid="PRO 20:15">लेकिन बेशबहा सरमाया 'इल्म वाले होंट हैं।<verse eid="PRO 20:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 20:16"/>जो बेगाने का ज़ामिन हो, उसके कपड़े छीन ले,</para>
  <para style="q" vid="PRO 20:16">और जो अजनबी का ज़ामिन हो, उससे कुछ गिरवी रख ले।<verse eid="PRO 20:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 20:17"/>दग़ा की रोटी आदमी को मीठी लगती है,</para>
  <para style="q" vid="PRO 20:17">लेकिन आख़िर को उसका मुँह कंकरों से भरा जाता है।<verse eid="PRO 20:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 20:18"/>हर एक काम मश्वरत से ठीक होता है,</para>
  <para style="q" vid="PRO 20:18">और तू नेक सलाह लेकर जंग कर।<verse eid="PRO 20:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 20:19"/>जो कोई लुतरापन करता फिरता है,</para>
  <para style="q" vid="PRO 20:19">राज़ खोलता है; इसलिए तू मुँहफट से कुछ वास्ता न रख<verse eid="PRO 20:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 20:20"/>जो अपने बाप या अपनी माँ पर ला'नत करता है,</para>
  <para style="q" vid="PRO 20:20">उसका चिराग़ गहरी तारीकी में बुझाया जाएगा।<verse eid="PRO 20:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 20:21"/>अगरचे 'इब्तिदा में मीरास यकलख़्त हासिल हो,</para>
  <para style="q" vid="PRO 20:21">तो भी उसका अन्जाम मुबारक न होगा।<verse eid="PRO 20:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 20:22"/>तू यह न कहना, कि मैं बदी का बदला लूँगा।</para>
  <para style="q" vid="PRO 20:22">ख़ुदावन्द की आस रख और वह तुझे बचाएगा।<verse eid="PRO 20:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 20:23"/>दो तरह के तौल बाट से ख़ुदावन्द को नफ़रत है,</para>
  <para style="q" vid="PRO 20:23">और दग़ा के तराजू ठीक नहीं।<verse eid="PRO 20:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 20:24"/>आदमी की रफ़्तार ख़ुदावन्द की तरफ़ से है,</para>
  <para style="q" vid="PRO 20:24">लेकिन इंसान अपनी राह को क्यूँकर जान सकता है?<verse eid="PRO 20:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 20:25"/>जल्द बाज़ी से किसी चीज़ को मुक़द्दस ठहराना,</para>
  <para style="q" vid="PRO 20:25">और मिन्नत मानने के बाद दरियाफ़्त करना, आदमी के लिए फंदा है।<verse eid="PRO 20:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 20:26"/>'अक़्लमन्द बादशाह शरीरों को फटकता है,</para>
  <para style="q" vid="PRO 20:26">और उन पर दावने का पहिया फिरवाता है।<verse eid="PRO 20:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 20:27"/>आदमी का ज़मीर ख़ुदावन्द का चिराग़ है: जो उसके तमाम अन्दरूनी हाल को दरियाफ़्त करता है।<verse eid="PRO 20:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 20:28"/>शफ़क़त और सच्चाई बादशाह की निगहबान हैं,</para>
  <para style="q" vid="PRO 20:28">बल्कि शफ़क़त ही से उसका तख़्त क़ाईम रहता है।<verse eid="PRO 20:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 20:29"/>जवानों का ज़ोर उनकी शौकत है,</para>
  <para style="q" vid="PRO 20:29">और बूढ़ों के सफ़ेद बाल उनकी ज़ीनत हैं।<verse eid="PRO 20:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 20:30"/>कोड़ों के ज़ख़्म से बदी दूर होती है,</para>
  <para style="q" vid="PRO 20:30">और मार खाने से दिल साफ़ होता।<verse eid="PRO 20:30"/></para>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 21:1"/>बादशाह क़ा दिल ख़ुदावन्द के हाथ में है वह उसको पानी के नालों की तरह जिधर चाहता है फेरता है।<verse eid="PRO 21:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 21:2"/>इंसान का हर एक चाल चलन उसकी नज़र में रास्त है,</para>
  <para style="q" vid="PRO 21:2">लेकिन ख़ुदावन्द दिलों को जाँचता है।<verse eid="PRO 21:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 21:3"/>सदाक़त और 'अद्ल, ख़ुदावन्द के नज़दीक कु़र्बानी से ज़्यादा पसन्दीदा हैं।<verse eid="PRO 21:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 21:4"/>बलन्द नज़री और दिल का तकब्बुर, है।</para>
  <para style="q" vid="PRO 21:4">और शरीरों की इक़बालमंदी गुनाह है।<verse eid="PRO 21:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 21:5"/>मेहनती की तदबीरें यक़ीनन फ़िरावानी की वजह हैं,</para>
  <para style="q" vid="PRO 21:5">लेकिन हर एक जल्दबाज़ का अंजाम मोहताजी है।<verse eid="PRO 21:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 21:6"/>दरोग़गोई से ख़ज़ाने हासिल करना,</para>
  <para style="q" vid="PRO 21:6">बेठिकाना बुख़ारात और उनके तालिब मौत के तालिब हैं।<verse eid="PRO 21:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 21:7"/>शरीरों का जु़ल्म उनको उड़ा ले जाएगा,</para>
  <para style="q" vid="PRO 21:7">क्यूँकि उन्होंने इन्साफ़ करने से इंकार किया है।<verse eid="PRO 21:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 21:8"/>गुनाह आलूदा आदमी की राह बहुत टेढ़ी है,</para>
  <para style="q" vid="PRO 21:8">लेकिन जो पाक है उसका काम ठीक है।<verse eid="PRO 21:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 21:9"/>घर की छत पर एक कोने में रहना,</para>
  <para style="q" vid="PRO 21:9">झगड़ालू बीवी के साथ बड़े घर में रहने से बेहतर है।<verse eid="PRO 21:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 21:10"/>शरीर की जान बुराई की मुश्ताक़ है,</para>
  <para style="q" vid="PRO 21:10">उसका पड़ोसी उसकी निगाह में मक़्बूल नहीं होता<verse eid="PRO 21:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 21:11"/>जब ठठ्ठा करने वाले को सज़ा दी जाती है,</para>
  <para style="q" vid="PRO 21:11">तो सादा दिल हिकमत हासिल करता है,</para>
  <para style="q" vid="PRO 21:11">और जब 'अक़्लमंद तरबियत पाता है, तो 'इल्म हासिल करता है।<verse eid="PRO 21:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 21:12"/>सादिक़ शरीर के घर पर ग़ौर करता है;</para>
  <para style="q" vid="PRO 21:12">शरीर कैसे गिर कर बर्बाद हो गए हैं।<verse eid="PRO 21:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 21:13"/>जो ग़रीब की आह सुन कर अपने कान बंद कर लेता है,</para>
  <para style="q" vid="PRO 21:13">वह आप भी आह करेगा और कोई न सुनेगा।<verse eid="PRO 21:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 21:14"/>पोशीदगी में हदिया देना क़हर को ठंडा करता है,</para>
  <para style="q" vid="PRO 21:14">और इना'म बग़ल में दे देना ग़ज़ब — ए — शदीद को।<verse eid="PRO 21:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 21:15"/>इन्साफ़ करने में सादिक़ की शादमानी है,</para>
  <para style="q" vid="PRO 21:15">लेकिन बदकिरदारों की हलाकत।<verse eid="PRO 21:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 21:16"/>जो समझ की राह से भटकता है, मुर्दों के ग़ोल में पड़ा रहेगा।<verse eid="PRO 21:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 21:17"/>'अय्याश कंगाल रहेगा;</para>
  <para style="q" vid="PRO 21:17">जो मय और तेल का मुश्ताक है मालदार न होगा।<verse eid="PRO 21:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 21:18"/>शरीर सादिक़ का फ़िदिया होगा,</para>
  <para style="q" vid="PRO 21:18">और दग़ाबाज़ रास्तबाज़ों के बदले में दिया जाएगा।<verse eid="PRO 21:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 21:19"/>वीराने में रहना,</para>
  <para style="q" vid="PRO 21:19">झगड़ालू और चिड़चिड़ी बीवी के साथ रहने से बेहतर है।<verse eid="PRO 21:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 21:20"/>क़ीमती ख़ज़ाना और तेल 'अक़्लमन्दों के घर में हैं,</para>
  <para style="q" vid="PRO 21:20">लेकिन बेवक़ूफ़ उनको उड़ा देता है।<verse eid="PRO 21:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 21:21"/>जो सदाक़त और शफ़क़त की पैरवी करता है,</para>
  <para style="q" vid="PRO 21:21">ज़िन्दगी और सदाक़त — ओ — 'इज़्ज़त पाता है।<verse eid="PRO 21:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 21:22"/>'अक़्लमन्द आदमी ज़बरदस्तों के शहर पर चढ़ जाता है,</para>
  <para style="q" vid="PRO 21:22">और जिस कु़व्वत पर उनका भरोसा है, उसे गिरा देता है।<verse eid="PRO 21:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 21:23"/>जो अपने मुँह और अपनी ज़बान की निगहबानी करता है,</para>
  <para style="q" vid="PRO 21:23">अपनी जान को मुसीबतों से महफ़ूज़ रखता है।<verse eid="PRO 21:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 21:24"/>मुतकब्बिर — ओ — मग़रूर शख़्स जो बहुत तकब्बुर से काम करता है।<verse eid="PRO 21:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 21:25"/>काहिल की तमन्ना उसे मार डालती है,</para>
  <para style="q" vid="PRO 21:25">क्यूँकि उसके हाथ मेहनत से इंकार करते हैं।<verse eid="PRO 21:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 21:26"/>वह दिन भर तमन्ना में रहता है,</para>
  <para style="q" vid="PRO 21:26">लेकिन सादिक़ देता है और दरेग़ नहीं करता।<verse eid="PRO 21:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 21:27"/>शरीर की कु़र्बानी क़ाबिले नफ़रत है,</para>
  <para style="q" vid="PRO 21:27">ख़ासकर जब वह बुरी नियत से लाता है।<verse eid="PRO 21:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 21:28"/>झूटा गवाह हलाक होगा</para>
  <para style="q" vid="PRO 21:28">, लेकिन जिस शख़्स ने बात सुनी है, वह ख़ामोश न रहेगा।<verse eid="PRO 21:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 21:29"/>शरीर अपने चहरे को सख़्त करता है,</para>
  <para style="q" vid="PRO 21:29">लेकिन सादिक़ अपनी राह पर ग़ौर करता है।<verse eid="PRO 21:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 21:30"/>कोई हिकमत, कोई समझ और कोई मश्वरत नहीं,</para>
  <para style="q" vid="PRO 21:30">जो ख़ुदावन्द के सामने ठहर सके।<verse eid="PRO 21:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 21:31"/>जंग के दिन के लिए घोड़ा तो तैयार किया जाता है,</para>
  <para style="q" vid="PRO 21:31">लेकिन फ़तहयाबी ख़ुदावन्द की तरफ़ से है।<verse eid="PRO 21:31"/></para>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 22:1"/>नेक नाम बेक़यास ख़ज़ाने से और एहसान सोने चाँदी से बेहतर है।<verse eid="PRO 22:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 22:2"/>अमीर — ओ — ग़रीब एक दूसरे से मिलते हैं;</para>
  <para style="q" vid="PRO 22:2">उन सबका ख़ालिक़ ख़ुदावन्द ही है।<verse eid="PRO 22:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 22:3"/>होशियार बला को देख कर छिप जाता है;</para>
  <para style="q" vid="PRO 22:3">लेकिन नादान बढ़े चले जाते और नुक़्सान उठाते हैं।<verse eid="PRO 22:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 22:4"/>दौलत और 'इज़्ज़त — ओ — हयात,</para>
  <para style="q" vid="PRO 22:4">ख़ुदावन्द के ख़ौफ़ और फ़रोतनी का अज्र हैं।<verse eid="PRO 22:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 22:5"/>टेढ़े आदमी की राह में काँटे और फन्दे हैं;</para>
  <para style="q" vid="PRO 22:5">जो अपनी जान की निगहबानी करता है, उनसे दूर रहेगा।<verse eid="PRO 22:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 22:6"/>लड़के की उस राह में तरबियत कर जिस पर उसे जाना है;</para>
  <para style="q" vid="PRO 22:6">वह बूढ़ा होकर भी उससे नहीं मुड़ेगा।<verse eid="PRO 22:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 22:7"/>मालदार ग़रीब पर हुक्मरान होता है,</para>
  <para style="q" vid="PRO 22:7">और क़र्ज़ लेने वाला कर्ज़ देने वाले का नौकर है।<verse eid="PRO 22:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 22:8"/>जो बदी बोता है मुसीबत काटेगा,</para>
  <para style="q" vid="PRO 22:8">और उसके क़हर की लाठी टूट जाएगी।<verse eid="PRO 22:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 22:9"/>जो नेक नज़र है बरकत पाएगा,</para>
  <para style="q" vid="PRO 22:9">क्यूँकि वह अपनी रोटी में से ग़रीबों को देता है।<verse eid="PRO 22:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 22:10"/>ठठ्ठा करने वाले को निकाल दे तो फ़साद जाता रहेगा;</para>
  <para style="q" vid="PRO 22:10">हाँ झगड़ा रगड़ा और रुस्वाई दूर हो जाएँगे।<verse eid="PRO 22:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 22:11"/>जो पाक दिली को चाहता है उसके होंटों में लुत्फ़ है,</para>
  <para style="q" vid="PRO 22:11">और बादशाह उसका दोस्तदार होगा।<verse eid="PRO 22:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 22:12"/>ख़ुदावन्द की आँखें 'इल्म की हिफ़ाज़त करती हैं;</para>
  <para style="q" vid="PRO 22:12">वह दग़ाबाज़ों के कलाम को उलट देता है।<verse eid="PRO 22:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 22:13"/>सुस्त आदमी कहता है बाहर शेर खड़ा है!</para>
  <para style="q" vid="PRO 22:13">मैं गलियों में फाड़ा जाऊँगा।<verse eid="PRO 22:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 22:14"/>बेगाना 'औरत का मुँह गहरा गढ़ा है;</para>
  <para style="q" vid="PRO 22:14">उसमें वह गिरता है जिससे ख़ुदावन्द को नफ़रत है।<verse eid="PRO 22:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 22:15"/>हिमाक़त लड़के के दिल से वाबस्ता है,</para>
  <para style="q" vid="PRO 22:15">लेकिन तरबियत की छड़ी उसको उससे दूर कर देगी।<verse eid="PRO 22:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 22:16"/>जो अपने फ़ायदे के लिए ग़रीब पर ज़ुल्म करता है,</para>
  <para style="q" vid="PRO 22:16">और जो मालदार को देता है, यक़ीनन मोहताज हो जाएगा।<verse eid="PRO 22:16"/></para>
  <para style="s">समझदार शख्स के जुमले</para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 22:17"/>अपना कान झुका और 'अक़्लमंदों की बातें सुन,</para>
  <para style="q" vid="PRO 22:17">और मेरी ता'लीम पर दिल लगा;<verse eid="PRO 22:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 22:18"/>क्यूँकि यह पसंदीदा है कि तू उनको अपने दिल में रख्खे,</para>
  <para style="q" vid="PRO 22:18">और वह तेरे लबों पर क़ाईम रहें;<verse eid="PRO 22:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 22:19"/>ताकि तेरा भरोसा ख़ुदावन्द पर हो,</para>
  <para style="q" vid="PRO 22:19">मैंने आज के दिन तुझ को हाँ तुझ ही को जता दिया है।<verse eid="PRO 22:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 22:20"/>क्या मैंने तेरे लिए मश्वरत और 'इल्म की लतीफ़ बातें इसलिए नहीं लिखी हैं, कि<verse eid="PRO 22:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 22:21"/>सच्चाई की बातों की हक़ीक़त तुझ पर ज़ाहिर कर दूँ,</para>
  <para style="q" vid="PRO 22:21">ताकि तू सच्ची बातें हासिल करके अपने भेजने वालों के पास वापस जाए?<verse eid="PRO 22:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 22:22"/>ग़रीब को इसलिए न लूट की वह ग़रीब है,</para>
  <para style="q" vid="PRO 22:22">और मुसीबत ज़दा पर 'अदालत गाह में ज़ुल्म न कर;<verse eid="PRO 22:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 22:23"/>क्यूँकि ख़ुदावन्द उनकी वकालत करेगा,</para>
  <para style="q" vid="PRO 22:23">और उनके ग़ारतगरों की जान को ग़ारत करेगा।<verse eid="PRO 22:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 22:24"/>गु़स्से वर आदमी से दोस्ती न कर,</para>
  <para style="q" vid="PRO 22:24">और ग़ज़बनाक शख़्स के साथ न जा,<verse eid="PRO 22:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 22:25"/>ऐसा ना हो तू उसका चाल चलन सीखे,</para>
  <para style="q" vid="PRO 22:25">और अपनी जान को फंदे में फंसाए। —<verse eid="PRO 22:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 22:26"/>तू उनमें शामिल न हो जो हाथ पर हाथ मारते हैं,</para>
  <para style="q" vid="PRO 22:26">और न उनमें जो क़र्ज़ के ज़ामिन होते हैं।<verse eid="PRO 22:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 22:27"/>क्यूँकि अगर तेरे पास अदा करने को कुछ न हो,</para>
  <para style="q" vid="PRO 22:27">तो वह तेरा बिस्तर तेरे नीचे से क्यूँ खींच ले जाए?<verse eid="PRO 22:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 22:28"/>उन पुरानी हदों को न सरका,</para>
  <para style="q" vid="PRO 22:28">जो तेरे बाप — दादा ने बाँधी हैं।<verse eid="PRO 22:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 22:29"/>तू किसी को उसके काम में मेहनती देखता है,</para>
  <para style="q" vid="PRO 22:29">वह बादशाहों के सामने खड़ा होगा;</para>
  <para style="q" vid="PRO 22:29">वह कम क़द्र लोगों की ख़िदमत न करेगा।<verse eid="PRO 22:29"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 23:1"/>जब तू हाकिम के साथ खाने बैठे,</para>
  <para style="q" vid="PRO 23:1">तो खू़ब ग़ौर कर, कि तेरे सामने कौन है?<verse eid="PRO 23:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 23:2"/>अगर तू खाऊ है, तो अपने गले पर छुरी रख दे।<verse eid="PRO 23:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 23:3"/>उसके मज़ेदार खानों की तमन्ना न कर,</para>
  <para style="q" vid="PRO 23:3">क्यूँकि वह दग़ा बाज़ी का खाना है।<verse eid="PRO 23:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 23:4"/>मालदार होने के लिए परेशान न हो;</para>
  <para style="q" vid="PRO 23:4">अपनी इस 'अक़्लमन्दी से बाज़ आ।<verse eid="PRO 23:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 23:5"/>क्या तू उस चीज़ पर आँख लगाएगा जो है ही नहीं?</para>
  <para style="q" vid="PRO 23:5">लेकिन लगा कर आसमान की तरफ़ उड़ जाती है?<verse eid="PRO 23:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 23:6"/>तू तंग चश्म की रोटी न खा,</para>
  <para style="q" vid="PRO 23:6">और उसके मज़ेदार खानों की तमन्ना न कर;<verse eid="PRO 23:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 23:7"/>क्यूँकि जैसे उसके दिल के ख़याल हैं वह वैसा ही है। वह तुझ से कहता है खा और पी,</para>
  <para style="q" vid="PRO 23:7">लेकिन उसका दिल तेरी तरफ़ नहीं<verse eid="PRO 23:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 23:8"/>जो निवाला तूने खाया है तू उसे उगल देगा,</para>
  <para style="q" vid="PRO 23:8">और तेरी मीठी बातें बे मतलब होंगी<verse eid="PRO 23:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 23:9"/>अपनी बातें बेवक़ूफ़ को न सुना,</para>
  <para style="q" vid="PRO 23:9">क्यूँकि वह तेरे 'अक़्लमंदी के कलाम की ना क़द्री करेगा।<verse eid="PRO 23:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 23:10"/>पुरानी हदों को न सरका,</para>
  <para style="q" vid="PRO 23:10">और यतीमों के खेतों में दख़ल न कर,<verse eid="PRO 23:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 23:11"/>क्यूँकि उनका रिहाई बख़्शने वाला ज़बरदस्त है;</para>
  <para style="q" vid="PRO 23:11">वह खुद ही तेरे ख़िलाफ़ उनकी वक़ालत करेगा।<verse eid="PRO 23:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 23:12"/>तरबियत पर दिल लगा,</para>
  <para style="q" vid="PRO 23:12">और 'इल्म की बातें सुन।<verse eid="PRO 23:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 23:13"/>लड़के से तादीब को दरेग़ न कर;</para>
  <para style="q" vid="PRO 23:13">अगर तू उसे छड़ी से मारेगा तो वह मर न जाएगा।<verse eid="PRO 23:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 23:14"/>तू उसे छड़ी से मारेगा,</para>
  <para style="q" vid="PRO 23:14">और उसकी जान को पाताल से बचाएगा।<verse eid="PRO 23:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 23:15"/>ऐ मेरे बेटे, अगर तू 'अक़्लमंद दिल है,</para>
  <para style="q" vid="PRO 23:15">तो मेरा दिल, हाँ मेरा दिल ख़ुश होगा।<verse eid="PRO 23:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 23:16"/>और जब तेरे लबों से सच्ची बातें निकलेंगी,</para>
  <para style="q" vid="PRO 23:16">तो मेरा दिल शादमान होगा।<verse eid="PRO 23:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 23:17"/>तेरा दिल गुनहगारों पर रश्क न करे,</para>
  <para style="q" vid="PRO 23:17">बल्कि तू दिन भर ख़ुदावन्द से डरता रह।<verse eid="PRO 23:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 23:18"/>क्यूँकि बदला यक़ीनी है,</para>
  <para style="q" vid="PRO 23:18">और तेरी आस नहीं टूटेगी।<verse eid="PRO 23:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 23:19"/>ऐ मेरे बेटे, तू सुन और 'अक़्लमंद बन,</para>
  <para style="q" vid="PRO 23:19">और अपने दिल की रहबरी कर।<verse eid="PRO 23:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 23:20"/>तू शराबियों में शामिल न हो,</para>
  <para style="q" vid="PRO 23:20">और न हरीस कबाबियों में,<verse eid="PRO 23:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 23:21"/>क्यूँकि शराबी और खाऊ कंगाल हो जाएँगे और नींद उनको चीथड़े पहनाएगी।<verse eid="PRO 23:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 23:22"/>अपने बाप का जिससे तू पैदा हुआ सुनने वाला हो,</para>
  <para style="q" vid="PRO 23:22">और अपनी माँ को उसके बुढ़ापे में हक़ीर न जान।<verse eid="PRO 23:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 23:23"/>सच्चाई की मोल ले और उसे बेच न डाल;</para>
  <para style="q" vid="PRO 23:23">हिकमत और तरबियत और समझ को भी।<verse eid="PRO 23:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 23:24"/>सादिक़ का बाप निहायत ख़ुश होगा;</para>
  <para style="q" vid="PRO 23:24">और अक़्लमंद का बाप उससे शादमानी करेगा।<verse eid="PRO 23:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 23:25"/>अपने माँ बाप को ख़ुश कर,</para>
  <para style="q" vid="PRO 23:25">अपनी वालिदा को शादमान रख।<verse eid="PRO 23:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 23:26"/>ऐ मेरे बेटे, अपना दिल मुझ को दे,</para>
  <para style="q" vid="PRO 23:26">और मेरी राहों से तेरी आँखें ख़ुश हों।<verse eid="PRO 23:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 23:27"/>क्यूँकि फ़ाहिशा गहरी ख़न्दक़ है,</para>
  <para style="q" vid="PRO 23:27">और बेगाना 'औरत तंग गढ़ा है।<verse eid="PRO 23:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 23:28"/>वह राहज़न की तरह घात में लगी है,</para>
  <para style="q" vid="PRO 23:28">और बनी आदम में बदकारों का शुमार बढ़ाती है।<verse eid="PRO 23:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 23:29"/>कौन अफ़सोस करता है? कौन ग़मज़दा है? कौन झगड़ालू है?</para>
  <para style="q" vid="PRO 23:29">कौन शाकी है? कौन बे वजह घायल है? और किसकी आँखों में सुर्ख़ी है?<verse eid="PRO 23:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 23:30"/>वही जो देर तक मयनोशी करते हैं;</para>
  <para style="q" vid="PRO 23:30">वही जो मिलाई हुई मय की तलाश में रहते हैं।<verse eid="PRO 23:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 23:31"/>जब मय लाल लाल हो,</para>
  <para style="q" vid="PRO 23:31">जब उसका बर'अक्स जाम पर पड़े,</para>
  <para style="q" vid="PRO 23:31">और जब वह रवानी के साथ नीचे उतरे, तो उस पर नज़र न कर।<verse eid="PRO 23:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 23:32"/>क्यूँकि अन्जाम कार वह साँप की तरह काटती,</para>
  <para style="q" vid="PRO 23:32">और अज़दहे की तरह डस जाती है।<verse eid="PRO 23:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 23:33"/>तेरी आँखें 'अजीब चीज़ें देखेंगी,</para>
  <para style="q" vid="PRO 23:33">और तेरे मुँह से उलटी सीधी बातें निकलेगी।<verse eid="PRO 23:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 23:34"/>बल्कि तू उसकी तरह होगा जो समन्दर के बीच में लेट जाए,</para>
  <para style="q" vid="PRO 23:34">या उसकी तरह जो मस्तूल के सिरे पर सो रहे।<verse eid="PRO 23:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PRO 23:35"/>तू कहेगा उन्होंने तो मुझे मारा है,</para>
  <para style="q" vid="PRO 23:35">लेकिन मुझ को चोट नहीं लगी; उन्होंने मुझे पीटा है लेकिन मुझे मा'लूम भी नहीं हुआ।</para>
  <para style="q" vid="PRO 23:35">मैं कब बेदार हूँगा? मैं फिर उसका तालिब हूँगा।<verse eid="PRO 23:35"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 24:1"/>तू शरीरों पर रश्क न करना,</para>
  <para style="q" vid="PRO 24:1">और उनकी सुहबत की ख़्वाहिश न रखना;<verse eid="PRO 24:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 24:2"/>क्यूँकि उनके दिल जुल्म की फ़िक्र करते हैं,</para>
  <para style="q" vid="PRO 24:2">और उनके लब शरारत का ज़िक्र।<verse eid="PRO 24:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 24:3"/>हिकमत से घर ता'मीर किया जाता है,</para>
  <para style="q" vid="PRO 24:3">और समझ से उसको क़याम होता है।<verse eid="PRO 24:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 24:4"/>और 'इल्म के वसीले से कोठरियाँ,</para>
  <para style="q" vid="PRO 24:4">नफ़ीस — ओ — लतीफ़ माल से मा'मूर की जाती हैं।<verse eid="PRO 24:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 24:5"/>'अक़्लमंद आदमी ताक़तवर है,</para>
  <para style="q" vid="PRO 24:5">बल्कि साहिब — ए — 'इल्म का ताक़त बढ़ती रहती है।<verse eid="PRO 24:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 24:6"/>क्यूँकि तू नेक सलाह लेकर जंग कर सकता है,</para>
  <para style="q" vid="PRO 24:6">और सलाहकारों की कसरत में सलामती है।<verse eid="PRO 24:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 24:7"/>हिकमत बेवक़ूफ़ के लिए बहुत बलन्द है;</para>
  <para style="q" vid="PRO 24:7">वह फाटक पर मुँह नहीं खोल सकता।<verse eid="PRO 24:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 24:8"/>जो बदी के मन्सूबे बाँधता है,</para>
  <para style="q" vid="PRO 24:8">फ़ितनाअंगेज़ कहलाएगा।<verse eid="PRO 24:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 24:9"/>बेवक़ूफ़ी का मन्सूबा भी गुनाह है,</para>
  <para style="q" vid="PRO 24:9">और ठठ्ठा करने वाले से लोगों को नफ़रत है।<verse eid="PRO 24:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 24:10"/>अगर तू मुसीबत के दिन बेदिल हो जाए,</para>
  <para style="q" vid="PRO 24:10">तो तेरी ताक़त बहुत कम है।<verse eid="PRO 24:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 24:11"/>जो क़त्ल के लिए घसीटे जाते हैं, उनको छुड़ा;</para>
  <para style="q" vid="PRO 24:11">जो मारे जाने को हैं उनको हवाले न कर।<verse eid="PRO 24:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 24:12"/>अगर तू कहे, देखो, हम को यह मा'लूम न था,</para>
  <para style="q" vid="PRO 24:12">तो क्या दिलों को जाँचने वाला यह नहीं समझता?</para>
  <para style="q" vid="PRO 24:12">और क्या तेरी जान का निगहबान यह नहीं जानता?</para>
  <para style="q" vid="PRO 24:12">और क्या वह हर शख़्स को उसके काम के मुताबिक़ बदला न देगा?<verse eid="PRO 24:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 24:13"/>ऐ मेरे बेटे, तू शहद खा, क्यूँकि वह अच्छा है,</para>
  <para style="q" vid="PRO 24:13">और शहद का छत्ता भी क्यूँकि वह तुझे मीठा लगता है।<verse eid="PRO 24:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 24:14"/>हिकमत भी तेरी जान के लिए ऐसी ही होगी;</para>
  <para style="q" vid="PRO 24:14">अगर वह तुझे मिल जाए तो तेरे लिए बदला होगा,</para>
  <para style="q" vid="PRO 24:14">और तेरी उम्मीद नहीं टूटेगी।<verse eid="PRO 24:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 24:15"/>ऐ शरीर, तू सादिक़ के घर की घात में न बैठना,</para>
  <para style="q" vid="PRO 24:15">उसकी आरामगाह को ग़ारत न करना;<verse eid="PRO 24:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 24:16"/>क्यूँकि सादिक़ सात बार गिरता है और फिर उठ खड़ा होता है;</para>
  <para style="q" vid="PRO 24:16">लेकिन शरीर बला में गिर कर पड़ा ही रहता है।<verse eid="PRO 24:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 24:17"/>जब तेरा दुश्मन गिर पड़े तो ख़ुशी न करना,</para>
  <para style="q" vid="PRO 24:17">और जब वह पछाड़ खाए तो दिलशाद न होना।<verse eid="PRO 24:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 24:18"/>ऐसा न हो ख़ुदावन्द इसे देखकर नाराज़ हो,</para>
  <para style="q" vid="PRO 24:18">और अपना क़हर उस पर से उठा ले।<verse eid="PRO 24:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 24:19"/>तू बदकिरदारों की वजह से बेज़ार न हो,</para>
  <para style="q" vid="PRO 24:19">और शरीरों पे रश्क न कर;<verse eid="PRO 24:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 24:20"/>क्यूँकि बदकिरदार के लिए कुछ बदला नहीं।</para>
  <para style="q" vid="PRO 24:20">शरीरों का चिराग़ बुझा दिया जाएगा।<verse eid="PRO 24:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 24:21"/>ऐ मेरे बेटे, ख़ुदावन्द से और बादशाह से डर;</para>
  <para style="q" vid="PRO 24:21">और मुफ़सिदों के साथ सुहबत न रख;<verse eid="PRO 24:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 24:22"/>क्यूँकि उन पर अचानक आफ़त आएगी,</para>
  <para style="q" vid="PRO 24:22">और उन दोनों की तरफ़ से आने वाली हलाकत को कौन जानता है?<verse eid="PRO 24:22"/></para>
  <para style="s">समझदार शख्स के और भी कहावते</para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 24:23"/>ये भी 'अक़्लमंदों की बातें हैं: 'अदालत में तरफ़दारी करना अच्छा नहीं।<verse eid="PRO 24:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 24:24"/>जो शरीर से कहता है तू सादिक़ है,</para>
  <para style="q" vid="PRO 24:24">लोग उस पर ला'नत करेंगे और उम्मतें उस से नफ़रत रख्खेंगी;<verse eid="PRO 24:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 24:25"/>लेकिन जो उसको डाँटते हैं ख़ुश होंगे,</para>
  <para style="q" vid="PRO 24:25">और उनकी बड़ी बरकत मिलेगी।<verse eid="PRO 24:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 24:26"/>जो हक़ बात कहता है,</para>
  <para style="q" vid="PRO 24:26">लबों पर बोसा देता है।<verse eid="PRO 24:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 24:27"/>अपना काम बाहर तैयार कर,</para>
  <para style="q" vid="PRO 24:27">उसे अपने लिए खेत में दुरूस्त कर ले;</para>
  <para style="q" vid="PRO 24:27">और उसके बाद अपना घर बना।<verse eid="PRO 24:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 24:28"/>बेवजह अपने पड़ोसी के ख़िलाफ़ गावाही न देना,</para>
  <para style="q" vid="PRO 24:28">और अपने लबों से धोखा न देना।<verse eid="PRO 24:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 24:29"/>यूँ न कह, “मैं उससे वैसा ही करूंगा जैसा उसने मुझसे किया;</para>
  <para style="q" vid="PRO 24:29">मैं उस आदमी से उसके काम के मुताबिक़ सुलूक करूँगा।”<verse eid="PRO 24:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 24:30"/>मैं काहिल के खेत के और बे'अक़्ल के ताकिस्तान के पास से गुज़रा,<verse eid="PRO 24:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 24:31"/>और देखो, वह सब का सब काँटों से भरा था,</para>
  <para style="q" vid="PRO 24:31">और बिच्छू बूटी से ढका था;</para>
  <para style="q" vid="PRO 24:31">और उसकी संगीन दीवार गिराई गई थी।<verse eid="PRO 24:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 24:32"/>तब मैंने देखा और उस पर ख़ूब ग़ौर किया;</para>
  <para style="q" vid="PRO 24:32">हाँ, मैंने उस पर निगह की और 'इब्रत पाई।<verse eid="PRO 24:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 24:33"/>थोड़ी सी नींद, एक और झपकी,</para>
  <para style="q" vid="PRO 24:33">ज़रा पड़े रहने को हाथ पर हाथ,<verse eid="PRO 24:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PRO 24:34"/>इसी तरह तेरी मुफ़लिसी राहज़न की तरह,</para>
  <para style="q" vid="PRO 24:34">और तेरी तंगदस्ती हथियारबंद आदमी की तरह, आ पड़ेगी।<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="s">सुलेमान की और भी अस्माल</para>
  <para style="q">
    <verse number="1" style="v" sid="PRO 25:1"/>ये भी सुलेमान की अम्साल हैं;</para>
  <para style="q" vid="PRO 25:1">जिनकी शाह — ए — यहूदाह हिज़क़ियाह के लोगों ने नक़ल की थी:<verse eid="PRO 25:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 25:2"/>ख़ुदा का जलाल राज़दारी में है,</para>
  <para style="q" vid="PRO 25:2">लेकिन बादशाहों का जलाल मुआ'मिलात की तफ़्तीश में।<verse eid="PRO 25:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 25:3"/>आसमान की ऊँचाई और ज़मीन की गहराई,</para>
  <para style="q" vid="PRO 25:3">और बादशाहों के दिल की इन्तिहा नहीं मिलती।<verse eid="PRO 25:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 25:4"/>चाँदी की मैल दूर करने से,</para>
  <para style="q" vid="PRO 25:4">सुनार के लिए बर्तन बन जाता है।<verse eid="PRO 25:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 25:5"/>शरीरों को बादशाह के सामने से दूर करने से,</para>
  <para style="q" vid="PRO 25:5">उसका तख़्त सदाक़त पर क़ाईम हो जाएगा।<verse eid="PRO 25:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 25:6"/>बादशाह के सामने अपनी बड़ाई न करना,</para>
  <para style="q" vid="PRO 25:6">और बड़े आदमियों की जगह खड़ा न होना;<verse eid="PRO 25:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 25:7"/>क्यूँकिये बेहतर है कि हाकिम के आमने — सामने जिसको तेरी आँखों ने देखा है,</para>
  <para style="q" vid="PRO 25:7">तुझ से कहा जाए, आगे बढ़ कर बैठ। न कि तू पीछे हटा दिया जाए।<verse eid="PRO 25:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 25:8"/>झगड़ा करने में जल्दी न कर,</para>
  <para style="q" vid="PRO 25:8">आख़िरकार जब तेरा पड़ोसी तुझको ज़लील करे,</para>
  <para style="q" vid="PRO 25:8">तब तू क्या करेगा?<verse eid="PRO 25:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 25:9"/>तू पड़ोसी के साथ अपने दा'वे का ज़िक्र कर,</para>
  <para style="q" vid="PRO 25:9">लेकिन किसी दूसरे का राज़ न खोल;<verse eid="PRO 25:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 25:10"/>ऐसा न हो जो कोई उसे सुने तुझे रुस्वा करे,</para>
  <para style="q" vid="PRO 25:10">और तेरी बदनामी होती रहे।<verse eid="PRO 25:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 25:11"/>बामौक़ा' बातें,</para>
  <para style="q" vid="PRO 25:11">रूपहली टोकरियों में सोने के सेब हैं।<verse eid="PRO 25:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 25:12"/>'अक़्लमंद मलामत करने वाले की बात,</para>
  <para style="q" vid="PRO 25:12">सुनने वाले के कान में सोने की बाली और कुन्दन का ज़ेवर है।<verse eid="PRO 25:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 25:13"/>वफ़ादार क़ासिद अपने भेजने वालों के लिए,</para>
  <para style="q" vid="PRO 25:13">ऐसा है जैसे फ़सल काटने के दिनों में बर्फ़ की ठंडक,</para>
  <para style="q" vid="PRO 25:13">क्यूँकि वह अपने मालिकों की जान को ताज़ा दम करता है।<verse eid="PRO 25:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 25:14"/>जो किसी झूटी लियाक़त पर फ़ख़्र करता है,</para>
  <para style="q" vid="PRO 25:14">वह बेबारिश बादल और हवा की तरह है।<verse eid="PRO 25:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 25:15"/>तहम्मुल करने से हाकिम राज़ी हो जाता है,</para>
  <para style="q" vid="PRO 25:15">और नर्म ज़बान हड्डी को भी तोड़ डालती है।<verse eid="PRO 25:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 25:16"/>क्या तूने शहद पाया? तू इतना खा जितना तेरे लिए काफ़ी है।</para>
  <para style="q" vid="PRO 25:16">ऐसा न हो तू ज़्यादा खा जाए और उगल डाल्ले<verse eid="PRO 25:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 25:17"/>अपने पड़ोसी के घर बार बार जाने से अपने पाँवों को रोक,</para>
  <para style="q" vid="PRO 25:17">ऐसा न हो कि वह दिक़ होकर तुझ से नफ़रत करे।<verse eid="PRO 25:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 25:18"/>जो अपने पड़ोसी के खिलाफ़ झूटी गवाही देता है वह गुर्ज़ और तलवार और तेज़ तीर है।<verse eid="PRO 25:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 25:19"/>मुसीबत के वक़्त बेवफ़ा आदमी पर 'ऐतमाद,</para>
  <para style="q" vid="PRO 25:19">टूटा दाँत और उखड़ा पाँव है।<verse eid="PRO 25:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 25:20"/>जो किसी ग़मगीन के सामने गीत गाता है,</para>
  <para style="q" vid="PRO 25:20">वह गोया जाड़े में किसी के कपड़े उतारता और सज्जी पर सिरका डालता है।<verse eid="PRO 25:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 25:21"/>अगर तेरा दुश्मन भूका हो तो उसे रोटी खिला,</para>
  <para style="q" vid="PRO 25:21">और अगर वह प्यासा हो तो उसे पानी पिला;<verse eid="PRO 25:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 25:22"/>क्यूँकि तू उसके सिर पर अंगारों का ढेर लगाएगा,</para>
  <para style="q" vid="PRO 25:22">और ख़ुदावन्द तुझ को बदला देगा।<verse eid="PRO 25:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 25:23"/>उत्तरी हवा मेह को लाती है,</para>
  <para style="q" vid="PRO 25:23">और ग़ैबत गो ज़बान तुर्शरूई को।<verse eid="PRO 25:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 25:24"/>घर की छत पर एक कोने में रहना,</para>
  <para style="q" vid="PRO 25:24">झगड़ालू बीवी के साथ कुशादा मकान में रहने से बेहतर है।<verse eid="PRO 25:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 25:25"/>वह ख़ुशख़बरी जो दूर के मुल्क से आए,</para>
  <para style="q" vid="PRO 25:25">ऐसी है जैसे थके मांदे की जान के लिए ठंडा पानी।<verse eid="PRO 25:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 25:26"/>सादिक़ का शरीर के आगे गिरना,</para>
  <para style="q" vid="PRO 25:26">गोया गन्दा नाला और नापाक सोता है।<verse eid="PRO 25:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 25:27"/>बहुत शहद खाना अच्छा नहीं,</para>
  <para style="q" vid="PRO 25:27">और अपनी बुज़ुर्गी का तालिब होना ज़ेबा नहीं है।<verse eid="PRO 25:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 25:28"/>जो अपने नफ़्स पर ज़ाबित नहीं,</para>
  <para style="q" vid="PRO 25:28">वह बेफ़सील और मिस्मारशुदा शहर की तरह है।<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 26:1"/>जिस तरह गर्मी के दिनों में बर्फ़ और दिरौ के वक्त बारिश,</para>
  <para style="q" vid="PRO 26:1">उसी तरह बेवक़ूफ़ को 'इज़्ज़त ज़ेब नहीं देती।<verse eid="PRO 26:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 26:2"/>जिस तरह गौरय्या आवारा फिरती और अबाबील उड़ती रहती है,</para>
  <para style="q" vid="PRO 26:2">उसी तरह बे वजह ला'नत बेमतलब है।<verse eid="PRO 26:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 26:3"/>घोड़े के लिए चाबुक और गधे के लिए लगाम,</para>
  <para style="q" vid="PRO 26:3">लेकिन बेवक़ूफ़ की पीठ के लिए छड़ी है।<verse eid="PRO 26:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 26:4"/>बेवक़ूफ़ को उसकी हिमाक़त के मुताबिक़ जवाब न दे,</para>
  <para style="q" vid="PRO 26:4">मबादा तू भी उसकी तरह हो जाए।<verse eid="PRO 26:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 26:5"/>बेवक़ूफ़ को उसकी हिमाक़त के मुताबिक जवाब दे,</para>
  <para style="q" vid="PRO 26:5">ऐसा न हो कि वह अपनी नज़र में 'अक़्लमंद ठहरे।<verse eid="PRO 26:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 26:6"/>जो बेवक़ूफ़ के हाथ पैग़ाम भेजता है,</para>
  <para style="q" vid="PRO 26:6">अपने पाँव पर कुल्हाड़ा मारता और नुक़सान का प्याला पीता है।<verse eid="PRO 26:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 26:7"/>जिस तरह लंगड़े की टाँग लड़खड़ाती है,</para>
  <para style="q" vid="PRO 26:7">उसी तरह बेवक़ूफ़ के मुँह में तमसील है।<verse eid="PRO 26:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 26:8"/>बेवक़ूफ़ की ता'ज़ीम करने वाला,</para>
  <para style="q" vid="PRO 26:8">गोया जवाहिर को पत्थरों के ढेर में रखता है।<verse eid="PRO 26:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 26:9"/>बेवक़ूफ़ के मुँह में तमसील,</para>
  <para style="q" vid="PRO 26:9">शराबी के हाथ में चुभने वाले काँटे की तरह है।<verse eid="PRO 26:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 26:10"/>जो बेवक़ूफ़ों और राहगुज़रों को मज़दूरी पर लगाता है,</para>
  <para style="q" vid="PRO 26:10">उस तीरंदाज़ की तरह है जो सबको ज़ख़्मी करता है।<verse eid="PRO 26:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 26:11"/>जिस तरह कुत्ता अपने उगले हुए को फिर खाता है,</para>
  <para style="q" vid="PRO 26:11">उसी तरह बेवक़ूफ़ अपनी बेवक़ूफ़ी को दोहराता है।<verse eid="PRO 26:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 26:12"/>क्या तू उसको जो अपनी नज़र में 'अक़्लमंद है देखता है?</para>
  <para style="q" vid="PRO 26:12">उसके मुक़ाबिले में बेवक़ूफ़ से ज़्यादा उम्मीद है।<verse eid="PRO 26:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 26:13"/>सुस्त आदमी कहता है,</para>
  <para style="q" vid="PRO 26:13">राह में शेर है, शेर — ए — बबर गलियों में है!<verse eid="PRO 26:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 26:14"/>जिस तरह दरवाज़ा अपनी चूलों पर फिरता है,</para>
  <para style="q" vid="PRO 26:14">उसी तरह सुस्त आदमी अपने बिस्तर पर करवट बदलता रहता है।<verse eid="PRO 26:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 26:15"/>सुस्त आदमी अपना हाथ थाली में डालता है,</para>
  <para style="q" vid="PRO 26:15">और उसे फिर मुँह तक लाना उसको थका देता है।<verse eid="PRO 26:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 26:16"/>काहिल अपनी नज़र में 'अक़्लमंद है,</para>
  <para style="q" vid="PRO 26:16">बल्कि दलील लाने वाले सात शख्सों से बढ़ कर।<verse eid="PRO 26:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 26:17"/>जो रास्ता चलते हुए पराए झगड़े में दख़्ल देता है,</para>
  <para style="q" vid="PRO 26:17">उसकी तरह है जो कुत्ते को कान से पकड़ता है।<verse eid="PRO 26:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 26:18"/>जैसा वह दीवाना जो जलती लकड़ियाँ और मौत के तीर फेंकता है,<verse eid="PRO 26:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 26:19"/>वैसा ही वह शख़्स है जो अपने पड़ोसी को दग़ा देता है,</para>
  <para style="q" vid="PRO 26:19">और कहता है, मैं तो दिल्लगी कर रहा था।<verse eid="PRO 26:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 26:20"/>लकड़ी न होने से आग बुझ जाती है,</para>
  <para style="q" vid="PRO 26:20">इसलिए जहाँ चुगलख़ोर नहीं वहाँ झगड़ा मौकूफ़ हो जाता है।<verse eid="PRO 26:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 26:21"/>जैसे अंगारों पर कोयले और आग पर ईंधन है,</para>
  <para style="q" vid="PRO 26:21">वैसे ही झगड़ालू झगड़ा खड़ा करने के लिए है।<verse eid="PRO 26:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 26:22"/>चुगलख़ोरकी बातें लज़ीज़ निवाले हैं,</para>
  <para style="q" vid="PRO 26:22">और वह खूब हज़म हो जाती हैं।<verse eid="PRO 26:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 26:23"/>उलफ़ती, लब बदख़्वाह दिल के साथ,</para>
  <para style="q" vid="PRO 26:23">उस ठीकरे की तरह है जिस पर खोटी चाँदी मेंढ़ी हो।<verse eid="PRO 26:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 26:24"/>कीनावर दिल में दग़ा रखता है,</para>
  <para style="q" vid="PRO 26:24">लेकिन अपनी बातों से छिपाता है;<verse eid="PRO 26:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 26:25"/>जब वह मीठी मीठी बातें करे तो उसका यक़ीन न कर,</para>
  <para style="q" vid="PRO 26:25">क्यूँकि उसके दिल में कमाल नफ़रत है।<verse eid="PRO 26:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 26:26"/>अगरचे उसकी बदख़्वाही मक्र में छिपी है,</para>
  <para style="q" vid="PRO 26:26">तो भी उसकी बदी जमा'अत के आमने सामने खोल दी जाएगी।<verse eid="PRO 26:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 26:27"/>जो गढ़ा खोदता है, आप ही उसमें गिरेगा;</para>
  <para style="q" vid="PRO 26:27">और जो पत्थर ढलकाता है, वह पलटकर उसी पर पड़ेगा।<verse eid="PRO 26:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 26:28"/>झूटी ज़बान उनका कीना रखती है जिनको उस ने घायल किया है,</para>
  <para style="q" vid="PRO 26:28">और चापलूस मुँह तबाही करता है।<verse eid="PRO 26:28"/></para>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 27:1"/>कल की बारे में घमण्ड़ न कर,</para>
  <para style="q" vid="PRO 27:1">क्यूँकि तू नहीं जानता कि एक ही दिन में क्या होगा।<verse eid="PRO 27:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 27:2"/>ग़ैर तेरी सिताइश करे न कि तेरा ही मुँह,</para>
  <para style="q" vid="PRO 27:2">बेगाना करे न कि तेरे ही लब।<verse eid="PRO 27:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 27:3"/>पत्थर भारी है और रेत वज़नदार है,</para>
  <para style="q" vid="PRO 27:3">लेकिन बेवक़ूफ़ का झुंझलाना इन दोनों से गिरॉतर है।<verse eid="PRO 27:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 27:4"/>ग़ुस्सा सख़्त बेरहमी और क़हर सैलाब है,</para>
  <para style="q" vid="PRO 27:4">लेकिन जलन के सामने कौन खड़ा रह सकता है?<verse eid="PRO 27:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 27:5"/>छिपी मुहब्बत से, खुली मलामत बेहतर है।<verse eid="PRO 27:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 27:6"/>जो ज़ख़्म दोस्त के हाथ से लगें वफ़ा से भरे है,</para>
  <para style="q" vid="PRO 27:6">लेकिन दुश्मन के बोसे बाइफ़्रात हैं।<verse eid="PRO 27:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 27:7"/>आसूदा जान को शहद के छत्ते से भी नफ़रत है,</para>
  <para style="q" vid="PRO 27:7">लेकिन भूके के लिए हर एक कड़वी चीज़ मीठी है।<verse eid="PRO 27:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 27:8"/>अपने मकान से आवारा इंसान,</para>
  <para style="q" vid="PRO 27:8">उस चिड़िया की तरह है जो अपने आशियाने से भटक जाए।<verse eid="PRO 27:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 27:9"/>जैसे तेल और इत्र से दिल को फ़रहत होती है,</para>
  <para style="q" vid="PRO 27:9">वैसे ही दोस्त की दिली मश्वरत की शीरीनी से।<verse eid="PRO 27:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 27:10"/>अपने दोस्त और अपने बाप के दोस्त को छोड़ न दे,</para>
  <para style="q" vid="PRO 27:10">और अपनी मुसीबत के दिन अपने भाई के घर न जा;</para>
  <para style="q" vid="PRO 27:10">क्यूँकि पड़ोसी जो नज़दीक हो उस भाई से जो दूर हो बेहतर है।<verse eid="PRO 27:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 27:11"/>ऐ मेरे बेटे, 'अक़्लमंद बन और मेरे दिल को शाद कर,</para>
  <para style="q" vid="PRO 27:11">ताकि मैं अपने मलामत करने वाले को जवाब दे सकूं।<verse eid="PRO 27:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 27:12"/>होशियार बला को देखकर छिप जाता है;</para>
  <para style="q" vid="PRO 27:12">लेकिन नादान बढ़े चले जाते और नुक़सान उठाते हैं।<verse eid="PRO 27:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 27:13"/>जो बेगाने का ज़ामिन हो उसके कपड़े छीन ले,</para>
  <para style="q" vid="PRO 27:13">और जो अजनबी का ज़ामिन हो उससे कुछ गिरवी रख ले।<verse eid="PRO 27:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 27:14"/>जो सुबह सवेरे उठकर अपने दोस्त के लिए बलन्द आवाज़ से दु'आ — ए — ख़ैर करता है,</para>
  <para style="q" vid="PRO 27:14">उसके लिए यह ला'नत महसूब होगी।<verse eid="PRO 27:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 27:15"/>झड़ी के दिन का लगातार टपका,</para>
  <para style="q" vid="PRO 27:15">और झगड़ालू बीवी यकसाँ हैं;<verse eid="PRO 27:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 27:16"/>जो उसको रोकता है, हवा को रोकता है;</para>
  <para style="q" vid="PRO 27:16">और उसका दहना हाथ तेल को पकड़ता है।<verse eid="PRO 27:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 27:17"/>जिस तरह लोहा लोहे को तेज़ करता है,</para>
  <para style="q" vid="PRO 27:17">उसी तरह आदमी के दोस्त के चहरे की आब उसी से है।<verse eid="PRO 27:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 27:18"/>जो अंजीर के दरख़्त की निगहबानी करता है उसका मेवा खाएगा,</para>
  <para style="q" vid="PRO 27:18">और जो अपने आक़ा की खिदमत करता है 'इज़्ज़त पाएगा।<verse eid="PRO 27:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 27:19"/>जिस तरह पानी में चेहरा चेहरे से मुशाबह है,</para>
  <para style="q" vid="PRO 27:19">उसी तरह आदमी का दिल आदमी से।<verse eid="PRO 27:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 27:20"/>जिस तरह पाताल और हलाकत को आसूदगी नहीं,</para>
  <para style="q" vid="PRO 27:20">उसी तरह इंसान की आँखे सेर नहीं होतीं।<verse eid="PRO 27:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 27:21"/>जैसे चाँदी के लिए कुठाली और सोने के लिए भट्टी है,</para>
  <para style="q" vid="PRO 27:21">वैसे ही आदमी के लिए उसकी ता'रीफ़ है।<verse eid="PRO 27:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 27:22"/>अगरचे तू बेवक़ूफ़ को अनाज के साथ उखली में डाल कर मूसल से कूटे,</para>
  <para style="q" vid="PRO 27:22">तोभी उसकी हिमाक़त उससे कभी जुदा न होगी।<verse eid="PRO 27:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 27:23"/>अपने रेवड़ों का हाल दरियाफ़त करने में दिल लगा,</para>
  <para style="q" vid="PRO 27:23">और अपने ग़ल्लों को अच्छी तरह से देख;<verse eid="PRO 27:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 27:24"/>क्यूँकि दौलत हमेशा नहीं रहती;</para>
  <para style="q" vid="PRO 27:24">और क्या ताजवरी नसल — दर — नसल क़ाईम रहती है?<verse eid="PRO 27:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 27:25"/>सूखी घास जमा' की जाती है, फिर सब्ज़ा नुमायाँ होता है;</para>
  <para style="q" vid="PRO 27:25">और पहाड़ों पर से चारा काट कर जमा' किया जाता है।<verse eid="PRO 27:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 27:26"/>बरें तेरी परवरिश के लिए हैं,</para>
  <para style="q" vid="PRO 27:26">और बक़रियाँ तेरे मैदानों की क़ीमत हैं,<verse eid="PRO 27:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 27:27"/>और बकरियों का दूध तेरी और तेरे ख़ान्दान की खू़राक</para>
  <para style="q" vid="PRO 27:27">और तेरी लौंडियों की गुज़ारा के लिए काफ़ी है।<verse eid="PRO 27:27"/></para>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 28:1"/>अगरचे कोई शरीर का पीछा न करे तोभी वह भागता है,</para>
  <para style="q" vid="PRO 28:1">लेकिन सादिक़ शेर — ए — बबर की तरह दिलेर है।<verse eid="PRO 28:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 28:2"/>मुल्क की ख़ताकारी की वजह से हाकिम बहुत से हैं,</para>
  <para style="q" vid="PRO 28:2">लेकिन साहिब — ए — 'इल्म — ओ — समझ से इन्तिज़ाम बहाल रहेगा।<verse eid="PRO 28:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 28:3"/>ग़रीब पर ज़ुल्म करने वाला कंगाल,</para>
  <para style="q" vid="PRO 28:3">मूसलाधार मेंह है जो एक 'अक़्लमंद भी नहीं छोड़ता।<verse eid="PRO 28:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 28:4"/>शरी'अत को छोड़ने वाले,</para>
  <para style="q" vid="PRO 28:4">शरीरों की तारीफ़ करते हैं लेकिन शरी'अत पर 'अमल करनेवाले, उनका मुक़ाबला करते हैं<verse eid="PRO 28:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 28:5"/>शरीर 'अद्ल से आगाह नहीं,</para>
  <para style="q" vid="PRO 28:5">लेकिन ख़ुदावन्द के तालिब सब कुछ समझते हैं।<verse eid="PRO 28:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 28:6"/>रास्तरौ ग़रीब,</para>
  <para style="q" vid="PRO 28:6">टेढ़ा आदमी दौलतमंद से बेहतर है।<verse eid="PRO 28:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 28:7"/>ता'लीम पर 'अमल करने वाला 'अक़्लमंद बेटा है,</para>
  <para style="q" vid="PRO 28:7">लेकिन फ़ुज़ूलख़र्चों का दोस्त अपने बाप को रुस्वा करता है।<verse eid="PRO 28:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 28:8"/>जो नाजाइज़ सूद और नफ़े' से अपनी दौलत बढ़ाता है,</para>
  <para style="q" vid="PRO 28:8">वह ग़रीबों पर रहम करने वाले के लिए जमा' करता है।<verse eid="PRO 28:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 28:9"/>जो कान फेर लेता है कि शरी'अत को न सुने,</para>
  <para style="q" vid="PRO 28:9">उसकी दुआ भी नफ़रतअंगेज़ है।<verse eid="PRO 28:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 28:10"/>जो कोई सादिक़ को गुमराह करता है,</para>
  <para style="q" vid="PRO 28:10">ताकि वह बुरी राह पर चले, वह अपने गढ़े में आप ही गिरेगा;</para>
  <para style="q" vid="PRO 28:10">लेकिन कामिल लोग अच्छी चीज़ों के वारिस होंगे।<verse eid="PRO 28:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 28:11"/>मालदार अपनी नज़र में 'अक़्लमंद है,</para>
  <para style="q" vid="PRO 28:11">लेकिन 'अक्लमंद ग़रीब उसे परख लेता है।<verse eid="PRO 28:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 28:12"/>जब सादिक़ फ़तहयाब होते हैं, तो बड़ी धूमधाम होती है;</para>
  <para style="q" vid="PRO 28:12">लेकिन जब शरीर खड़े होते हैं, तो आदमी ढूँडे नहीं मिलते।<verse eid="PRO 28:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 28:13"/>जो अपने गुनाहों को छिपाता है, कामयाब न होगा;</para>
  <para style="q" vid="PRO 28:13">लेकिन जो उनका इक़रार करके, उनको छोड़ देता है; उस पर रहमत होगी।<verse eid="PRO 28:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 28:14"/>मुबारक है वह आदमी जो सदा डरता रहता है,</para>
  <para style="q" vid="PRO 28:14">लेकिन जो अपने दिल को सख़्त करता है, मुसीबत में पड़ेगा।<verse eid="PRO 28:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 28:15"/>गरीबों पर शरीर हाकिम,</para>
  <para style="q" vid="PRO 28:15">गरजते हुए शेर और शिकार के तालिब रीछ की तरह है।<verse eid="PRO 28:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 28:16"/>बे'अक़्ल हाकिम भी बड़ा ज़ालिम है,</para>
  <para style="q" vid="PRO 28:16">लेकिन जो लालच से नफ़रत रखता है, उसकी उम्र दराज़ होगी।<verse eid="PRO 28:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 28:17"/>जिसके सिर पर किसी का खू़न है,</para>
  <para style="q" vid="PRO 28:17">वह गढ़े की तरफ़ भागेगा, उसे कोई न रोके।<verse eid="PRO 28:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 28:18"/>जो रास्तरौ है रिहाई पाएगा,</para>
  <para style="q" vid="PRO 28:18">लेकिन टेढ़ा आदमी नागहान गिर पड़ेगा।<verse eid="PRO 28:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 28:19"/>जो अपनी ज़मीन में काश्तकारी करता है, रोटी से सेर होगा,</para>
  <para style="q" vid="PRO 28:19">लेकिन बेमतलब के पीछे चलने वाला बहुत कंगाल हो जाएगा।<verse eid="PRO 28:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 28:20"/>दियानतदार आदमी बरकतों से मा'मूर होगा,</para>
  <para style="q" vid="PRO 28:20">लेकिन जो दौलतमंद होने के लिए जल्दी करता है, बे सज़ा न छूटेगा।<verse eid="PRO 28:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 28:21"/>तरफ़दारी करना अच्छा नहीं;</para>
  <para style="q" vid="PRO 28:21">और न यह कि आदमी रोटी के टुकड़े के लिए गुनाह करे।<verse eid="PRO 28:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 28:22"/>तंग चश्म दौलत जमा' करने में जल्दी करता है,</para>
  <para style="q" vid="PRO 28:22">और यह नहीं जानता कि मुफ़लिसी उसे आ दबाएगा।<verse eid="PRO 28:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 28:23"/>आदमी को सरज़निश करनेवाला आखिरकार,</para>
  <para style="q" vid="PRO 28:23">ज़बानी ख़ुशामद करनेवाले से ज़्यादा मक्बूल ठहरेगा।<verse eid="PRO 28:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 28:24"/>जो कोई अपने वालिदैन को लूटता हैऔर कहता है,</para>
  <para style="q" vid="PRO 28:24">कि यह गुनाह नहीं, वह गारतगर का साथी है।<verse eid="PRO 28:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 28:25"/>जिसके दिल में लालच है वह झगड़ा खड़ा करता है,</para>
  <para style="q" vid="PRO 28:25">लेकिन जिसका भरोसा ख़ुदावन्द पर है वह तारो — ताज़ा किया जाएगा।<verse eid="PRO 28:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 28:26"/>जो अपने ही दिल पर भरोसा रखता है, बेवक़ूफ़ है;</para>
  <para style="q" vid="PRO 28:26">लेकिन जो 'अक़्लमंदी से चलता है, रिहाई पाएगा।<verse eid="PRO 28:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 28:27"/>जो ग़रीबों को देता है, मुहताज न होगा;</para>
  <para style="q" vid="PRO 28:27">लेकिन जो आँख चुराता है, बहुत मला'ऊन होगा।<verse eid="PRO 28:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 28:28"/>जब शरीर खड़े होते हैं, तो आदमी ढूँडे नहीं मिलते,</para>
  <para style="q" vid="PRO 28:28">लेकिन जब वह फ़ना होते हैं, तो सादिक़ तरक़्क़ी करते हैं।<verse eid="PRO 28:28"/></para>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q">
    <verse number="1" style="v" sid="PRO 29:1"/>जो बार बार तम्बीह पाकर भी गर्दनकशी करता है,</para>
  <para style="q" vid="PRO 29:1">अचानक बर्बाद किया जाएगा, और उसका कोई चारा न होगा।<verse eid="PRO 29:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 29:2"/>जब सादिक़ इकबालमंद होते हैं,</para>
  <para style="q" vid="PRO 29:2">तो लोग ख़ुश होते हैं लेकिन जब शरीर इख़्तियार पाते हैं तो लोग आहें भरते हैं।<verse eid="PRO 29:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 29:3"/>जो कोई हिकमत से उलफ़त रखता है, अपने बाप को ख़ुश करता है,</para>
  <para style="q" vid="PRO 29:3">लेकिन जो कस्बियों से सुहबत रखता है, अपना माल उड़ाता है।<verse eid="PRO 29:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 29:4"/>बादशाह 'अद्ल से अपनी ममलुकत को क़याम बख़्शता है</para>
  <para style="q" vid="PRO 29:4">लेकिन रिश्वत सितान उसको वीरान करता है।<verse eid="PRO 29:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 29:5"/>जो अपने पड़ोसी की ख़ुशामद करता है,</para>
  <para style="q" vid="PRO 29:5">उसके पाँव के लिए जाल बिछाता है।<verse eid="PRO 29:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 29:6"/>बदकिरदार के गुनाह में फंदा है,</para>
  <para style="q" vid="PRO 29:6">लेकिन सादिक़ गाता और ख़ुशी करता है।<verse eid="PRO 29:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 29:7"/>सादिक़ ग़रीबों के मु'आमिले का ख़याल रखता है,</para>
  <para style="q" vid="PRO 29:7">लेकिन शरीर में उसको जानने की लियाकत नहीं।<verse eid="PRO 29:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 29:8"/>ठठ्टेबाज़ शहर में आग लगाते हैं,</para>
  <para style="q" vid="PRO 29:8">लेकिन 'अक़्लमंद क़हर को दूर कर देते हैं।<verse eid="PRO 29:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 29:9"/>अगर 'अक़्लमंद बेवक़ूफ़ से बहस करे,</para>
  <para style="q" vid="PRO 29:9">तो ख़्वाह वह क़हर करे ख़्वाह हँसे, कुछ इत्मिनान होगा।<verse eid="PRO 29:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 29:10"/>खू़ँरेज़ लोग कामिल आदमी से कीना रखते हैं,</para>
  <para style="q" vid="PRO 29:10">लेकिन रास्तकार उसकी जान बचाने का इरादा करते हैं।<verse eid="PRO 29:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 29:11"/>बेवक़ूफ़ अपना क़हर उगल देता है,</para>
  <para style="q" vid="PRO 29:11">लेकिन 'अक़्लमंद उसको रोकता और पी जाता है।<verse eid="PRO 29:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 29:12"/>अगर कोई हाकिम झूट पर कान लगाता है,</para>
  <para style="q" vid="PRO 29:12">तो उसके सब ख़ादिम शरीर हो जाते हैं।<verse eid="PRO 29:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 29:13"/>ग़रीब और ज़बरदस्त एक दूसरे से मिलते हैं,</para>
  <para style="q" vid="PRO 29:13">और ख़ुदावन्द दोनों की आँखे रोशन करता है।<verse eid="PRO 29:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 29:14"/>जो बादशाह ईमानदारी से गरीबों की 'अदालत करता है,</para>
  <para style="q" vid="PRO 29:14">उसका तख़्त हमेशा क़ाईम रहता है।<verse eid="PRO 29:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 29:15"/>छड़ी और तम्बीह हिकमत बख़्शती हैं,</para>
  <para style="q" vid="PRO 29:15">लेकिन जो लड़का बेतरबियत छोड़ दिया जाता है,</para>
  <para style="q" vid="PRO 29:15">अपनी माँ को रुस्वा करेगा।<verse eid="PRO 29:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 29:16"/>जब शरीर कामयाब होते हैं, तो बदी ज़्यादा होती है;</para>
  <para style="q" vid="PRO 29:16">लेकिन सादिक़ उनकी तबाही देखेंगे।<verse eid="PRO 29:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 29:17"/>अपने बेटे की तरबियत कर;</para>
  <para style="q" vid="PRO 29:17">और वह तुझे आराम देगा, और तेरी जान को शादमान करेगा।<verse eid="PRO 29:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 29:18"/>जहाँ रोया नहीं वहाँ लोग बेकैद हो जाते हैं,</para>
  <para style="q" vid="PRO 29:18">लेकिन शरी'अत पर 'अमल करने वाला मुबारक है।<verse eid="PRO 29:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 29:19"/>नौकर बातों ही से नहीं सुधरता,</para>
  <para style="q" vid="PRO 29:19">क्यूँकि अगरचे वह समझता है तो भी परवा नहीं करता।<verse eid="PRO 29:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 29:20"/>क्या तू बेताम्मुल बोलने वाले को देखता है?</para>
  <para style="q" vid="PRO 29:20">उसके मुक़ाबले में बेवक़ूफ़ से ज़्यादा उम्मीद है।<verse eid="PRO 29:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 29:21"/>जो अपने घर के लड़के को लड़कपन से नाज़ में पालता है,</para>
  <para style="q" vid="PRO 29:21">वह आखिरकार उसका बेटा बन बैठेगा।<verse eid="PRO 29:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 29:22"/>क़हर आलूदा आदमी फ़ितना खड़ा करता है,</para>
  <para style="q" vid="PRO 29:22">और ग़ज़बनाक गुनाह में ज़ियादती करता है।<verse eid="PRO 29:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 29:23"/>आदमी का ग़ुरूर उसको पस्त करेगा,</para>
  <para style="q" vid="PRO 29:23">लेकिन जो दिल से फ़रोतन है 'इज़्ज़त हासिल करेगा।<verse eid="PRO 29:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 29:24"/>जो कोई चोर का शरीक होता है, अपनी जान से दुश्मनी रखता है;</para>
  <para style="q" vid="PRO 29:24">वह हल्फ़ उठाता है और हाल बयान नहीं करता।<verse eid="PRO 29:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 29:25"/>इंसान का डर फंदा है,</para>
  <para style="q" vid="PRO 29:25">लेकिन जो कोई ख़ुदावन्द पर भरोसा करता है महफ़ूज़ रहेगा।<verse eid="PRO 29:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 29:26"/>हाकिम की मेहरबानी के तालिब बहुत हैं,</para>
  <para style="q" vid="PRO 29:26">लेकिन इंसान का फैसला ख़ुदावन्द की तरफ़ से है।<verse eid="PRO 29:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 29:27"/>सादिक़ को बेइन्साफ़ से नफ़रत है,</para>
  <para style="q" vid="PRO 29:27">और शरीर को रास्तरौ से।<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="s">अज़ूर की अस्माल</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>याक़ा के बेटे अज़ूर के पैग़ाम की बातें: उस आदमी ने एतीएल,</para>
  <para style="q" vid="PRO 30:1">हाँ इतीएलऔर उकाल से कहा:।<verse eid="PRO 30:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 30:2"/>यक़ीनन मैं हर एक इंसान से ज़्यादा</para>
  <para style="q" vid="PRO 30:2">और इंसान का सा समझ मुझ में नहीं<verse eid="PRO 30:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 30:3"/>मैंने हिकमत नहीं सीखी</para>
  <para style="q" vid="PRO 30:3">और न मुझे उस क़ुद्दूस का 'इरफ़ान हासिल है।<verse eid="PRO 30:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 30:4"/>कौन आसमान पर चढ़ा और फिर नीचे उतरा?</para>
  <para style="q" vid="PRO 30:4">किसने हवा को अपनी मुट्ठी में जमा'कर लिया?</para>
  <para style="q" vid="PRO 30:4">किसने पानी की चादर में बाँधा? किसने ज़मीन की हदें ठहराई?</para>
  <para style="q" vid="PRO 30:4">अगर तू जानता है, तो बता उसका क्या नाम है,</para>
  <para style="q" vid="PRO 30:4">और उसके बेटे का क्या नाम है?<verse eid="PRO 30:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 30:5"/>ख़ुदा का हर एक बात पाक है,</para>
  <para style="q" vid="PRO 30:5">वह उनकी सिपर है जिनका भरोसा उस पर है।<verse eid="PRO 30:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 30:6"/>तू उसके कलाम में कुछ न बढ़ाना,</para>
  <para style="q" vid="PRO 30:6">ऐसा न हो वह तुझ को तम्बीह करे और तू झूटा ठहरे।<verse eid="PRO 30:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 30:7"/>मैंने तुझ से दो बातों की दरख़्वास्त की है,</para>
  <para style="q" vid="PRO 30:7">मेरे मरने से पहले उनको मुझ से दरेग न कर।<verse eid="PRO 30:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 30:8"/>बतालत और दरोग़गोई को मुझ से दूर कर दे;</para>
  <para style="q" vid="PRO 30:8">और मुझ को न कंगाल कर न दौलतमंद, मेरी ज़रूरत के मुताबिक़ मुझे रोज़ी दे।<verse eid="PRO 30:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 30:9"/>ऐसा न हो कि मैं सेर होकर इन्कार करूं और कहूँ, ख़ुदावन्द कौन है?</para>
  <para style="q" vid="PRO 30:9">या ऐसा न हो मुहताज होकर चोरी करूं, और अपने ख़ुदा के नाम की तकफ़ीर करूं।<verse eid="PRO 30:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 30:10"/>ख़ादिम पर उसके आक़ा के सामने तोहमत न लगा,</para>
  <para style="q" vid="PRO 30:10">ऐसा न हो कि वह तुझ पर ला'नत करे, और तू मुजरिम ठहरे।<verse eid="PRO 30:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 30:11"/>एक नसल ऐसी है, जो अपने बाप पर ला'नत करती है</para>
  <para style="q" vid="PRO 30:11">और अपनी माँ को मुबारक नहीं कहती।<verse eid="PRO 30:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 30:12"/>एक नसल ऐसी है, जो अपनी निगाह में पाक है,</para>
  <para style="q" vid="PRO 30:12">लेकिन उसकी गंदगी उससे धोई नहीं गई।<verse eid="PRO 30:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 30:13"/>एक नसल ऐसी है, कि वाह क्या ही बलन्द नज़र है,</para>
  <para style="q" vid="PRO 30:13">और उनकी पलकें ऊपर को उठी रहती हैं।<verse eid="PRO 30:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 30:14"/>एक नसल ऐसी है, जिसके दाँत तलवारें है,</para>
  <para style="q" vid="PRO 30:14">और डाढ़े छुरियाँ ताकि ज़मीन के ग़रीबों और बनी आदम के कंगालों को खा जाएँ।<verse eid="PRO 30:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 30:15"/>जोंक की दो बेटियाँ हैं, जो “दे दे” चिल्लाती हैं;</para>
  <para style="q" vid="PRO 30:15">तीन हैं जो कभी सेर नहीं होतीं, बल्कि चार हैं जो कभी “बस” नहीं कहतीं।<verse eid="PRO 30:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 30:16"/>पाताल और बाँझ का रिहम,</para>
  <para style="q" vid="PRO 30:16">और ज़मीन जो सेराब नहीं हुई,</para>
  <para style="q" vid="PRO 30:16">और आग जो कभी “बस” नहीं कहती।<verse eid="PRO 30:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 30:17"/>वह आँख जो अपने बाप की हँसी करती है,</para>
  <para style="q" vid="PRO 30:17">और अपनी माँ की फ़रमाँबरदारी को हक़ीर जानती है,</para>
  <para style="q" vid="PRO 30:17">वादी के कौवे उसको उचक ले जाएँगे,</para>
  <para style="q" vid="PRO 30:17">और गिद्ध के बच्चे उसे खाएँगे।<verse eid="PRO 30:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 30:18"/>तीन चीज़े मेरे नज़दीक़ बहुत ही 'अजीब हैं,</para>
  <para style="q" vid="PRO 30:18">बल्कि चार हैं, जिनको मैं नहीं जानता:<verse eid="PRO 30:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 30:19"/>'उकाब की राह हवा में, और साँप की राह चटान पर,</para>
  <para style="q" vid="PRO 30:19">और जहाज़ की राह समन्दर में, और मर्द का चाल चलन जवान 'औरत के साथ।<verse eid="PRO 30:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 30:20"/>ज़ानिया की राह ऐसी ही है;</para>
  <para style="q" vid="PRO 30:20">वह खाती है और अपना मुँह पोंछती है,</para>
  <para style="q" vid="PRO 30:20">और कहती है, मैंने कुछ बुराई नहीं की।<verse eid="PRO 30:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 30:21"/>तीन चीज़ों से ज़मीन लरज़ाँ है;</para>
  <para style="q" vid="PRO 30:21">बल्कि चार हैं, जिनकी वह बर्दाश्त नहीं कर सकती:<verse eid="PRO 30:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 30:22"/>गुलाम से जो बादशाही करने लगे,</para>
  <para style="q" vid="PRO 30:22">और बेवक़ूफ़ से जब उसका पेट भरे,<verse eid="PRO 30:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 30:23"/>और नामक़बूल 'औरत से जब वह ब्याही जाए,</para>
  <para style="q" vid="PRO 30:23">और लौंडी से जो अपनी बीबी की वारिस हो।<verse eid="PRO 30:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 30:24"/>चार हैं, जो ज़मीन पर ना चीज़ हैं,</para>
  <para style="q" vid="PRO 30:24">लेकिन बहुत 'अक़्लमंद हैं:<verse eid="PRO 30:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 30:25"/>चीटियाँ कमज़ोर मख़लूक़ हैं,</para>
  <para style="q" vid="PRO 30:25">तौ भी गर्मी में अपने लिए ख़ुराक जमा' कर रखती हैं;<verse eid="PRO 30:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 30:26"/>और साफ़ान अगरचे नातवान मख़्लूक़ हैं,</para>
  <para style="q" vid="PRO 30:26">तो भी चटानों के बीच अपने घर बनाते हैं;<verse eid="PRO 30:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 30:27"/>और टिड्डियाँ जिनका कोई बादशाह नहीं,</para>
  <para style="q" vid="PRO 30:27">तोभी वह परे बाँध कर निकलती हैं;<verse eid="PRO 30:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 30:28"/>और छिपकली जो अपने हाथों से पकड़ती है,</para>
  <para style="q" vid="PRO 30:28">और तोभी शाही महलों में है।<verse eid="PRO 30:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 30:29"/>तीन ख़ुश रफ़्तार हैं,</para>
  <para style="q" vid="PRO 30:29">बल्कि चार जिनका चलना ख़ुश नुमा है:<verse eid="PRO 30:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 30:30"/>एक तो शेर — ए — बबर जो सब हैवानात में बहादुर है,</para>
  <para style="q" vid="PRO 30:30">और किसी को पीठ नहीं दिखाता:<verse eid="PRO 30:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 30:31"/>जंगली घोड़ा और बकरा, और बादशाह,</para>
  <para style="q" vid="PRO 30:31">जिसका सामना कोई न करे।<verse eid="PRO 30:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PRO 30:32"/>अगर तूने बेवक़ूफ़ी से अपने आपको बड़ा ठहराया है,</para>
  <para style="q" vid="PRO 30:32">या तूने कोई बुरा मन्सूबा बाँधा है, तो हाथ अपने मुँह पर रख।<verse eid="PRO 30:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PRO 30:33"/>क्यूँकि यक़ीनन दूध बिलोने से मक्खन निकलता है,</para>
  <para style="q" vid="PRO 30:33">और नाक मरोड़ने से लहू, इसी तरह क़हर भड़काने से फ़साद खड़ा होता है।<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="s">लमविएल की अस्माल</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>लमविएल बादशाह के पैग़ाम की बातें जो उसकी माँ ने उसको सिखाई:<verse eid="PRO 31:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PRO 31:2"/>ऐ मेरे बेटे, ऐ मेरे रिहम के बेटे,</para>
  <para style="q" vid="PRO 31:2">तुझे, जिसे मैंने नज़्रे माँग कर पाया क्या कहूँ?<verse eid="PRO 31:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PRO 31:3"/>अपनी क़ुव्वत 'औरतों को न दे,</para>
  <para style="q" vid="PRO 31:3">और अपनी राहें बादशाहों को बिगाड़ने वालियों की तरफ़ न निकाल।<verse eid="PRO 31:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PRO 31:4"/>बादशाहों को ऐ लमविएल, बादशाहों को मयख़्वारी ज़ेबा नहीं,</para>
  <para style="q" vid="PRO 31:4">और शराब की तलाश हाकिमों को शायान नहीं।<verse eid="PRO 31:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PRO 31:5"/>ऐसा न हो वह पीकर क़वानीन को भूल जाए,</para>
  <para style="q" vid="PRO 31:5">और किसी मज़लूम की हक़ तलफ़ी करें।<verse eid="PRO 31:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PRO 31:6"/>शराब उसको पिलाओ जो मरने पर है,</para>
  <para style="q" vid="PRO 31:6">और मय उसको जो तल्ख़ जान है<verse eid="PRO 31:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PRO 31:7"/>ताकि वह पिए और अपनी तंगदस्ती फ़रामोश करे,</para>
  <para style="q" vid="PRO 31:7">और अपनी तबाह हाली को फिर याद न करे<verse eid="PRO 31:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PRO 31:8"/>अपना मुँह गूँगे के लिए खोल उन सबकी वकालत को जो बेकस हैं।<verse eid="PRO 31:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PRO 31:9"/>अपना मुँह खोल, रास्ती से फ़ैसलाकर,</para>
  <para style="q" vid="PRO 31:9">और ग़रीबों और मुहताजों का इन्साफ़ कर।<verse eid="PRO 31:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PRO 31:10"/>नेकोकार बीवी किसको मिलती है?</para>
  <para style="q" vid="PRO 31:10">क्यूँकि उसकी क़द्र मरजान से भी बहुत ज़्यादा है।<verse eid="PRO 31:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PRO 31:11"/>उसके शौहर के दिल को उस पर भरोसा है,</para>
  <para style="q" vid="PRO 31:11">और उसे मुनाफ़े' की कमी न होगी।<verse eid="PRO 31:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PRO 31:12"/>वह अपनी उम्र के तमाम दिनों में,</para>
  <para style="q" vid="PRO 31:12">उससे नेकी ही करेगी, बदी न करेगी।<verse eid="PRO 31:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PRO 31:13"/>वह ऊन और कतान ढूंडती है,</para>
  <para style="q" vid="PRO 31:13">और ख़ुशी के साथ अपने हाथों से काम करती है।<verse eid="PRO 31:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PRO 31:14"/>वह सौदागरों के जहाज़ों की तरह है,</para>
  <para style="q" vid="PRO 31:14">वह अपनी ख़ुराक दूर से ले आती है।<verse eid="PRO 31:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PRO 31:15"/>वह रात ही को उठ बैठती है,</para>
  <para style="q" vid="PRO 31:15">और अपने घराने को खिलाती है, और अपनी लौंडियों को काम देती है।<verse eid="PRO 31:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PRO 31:16"/>वह किसी खेत की बारे में सोचती हैऔर उसे ख़रीद लेती है;</para>
  <para style="q" vid="PRO 31:16">और अपने हाथों के नफ़े' से ताकिस्तान लगाती है।<verse eid="PRO 31:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PRO 31:17"/>वह मज़बूती से अपनी कमर बाँधती है,</para>
  <para style="q" vid="PRO 31:17">और अपने बाज़ुओं को मज़बूत करती है।<verse eid="PRO 31:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PRO 31:18"/>वह अपनी सौदागरी को सूदमंद पाती है।</para>
  <para style="q" vid="PRO 31:18">रात को उसका चिराग़ नहीं बुझता।<verse eid="PRO 31:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PRO 31:19"/>वह तकले पर अपने हाथ चलाती है,</para>
  <para style="q" vid="PRO 31:19">और उसके हाथ अटेरन पकड़ते हैं।<verse eid="PRO 31:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PRO 31:20"/>वह ग़रीबों की तरफ़ अपना हाथ बढ़ाती है, हाँ,</para>
  <para style="q" vid="PRO 31:20">वह अपने हाथ मोहताजों की तरफ़ बढ़ाती है।<verse eid="PRO 31:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PRO 31:21"/>वह अपने घराने के लिए बर्फ़ से नहीं डरती,</para>
  <para style="q" vid="PRO 31:21">क्यूँकि उसके ख़ान्दान में हर एक सुर्ख पोश है।<verse eid="PRO 31:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PRO 31:22"/>वह अपने लिए निगारीन बाला पोश बनाती है;</para>
  <para style="q" vid="PRO 31:22">उसकी पोशाक महीन कतानी और अर्गवानी है।<verse eid="PRO 31:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PRO 31:23"/>उसका शौहर फाटक में मशहूर है,</para>
  <para style="q" vid="PRO 31:23">जब वह मुल्क के बुज़ुगों के साथ बैठता है।<verse eid="PRO 31:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PRO 31:24"/>वह महीन कतानी कपड़े बनाकर बेचती है;</para>
  <para style="q" vid="PRO 31:24">और पटके सौदागरों के हवाले करती है।<verse eid="PRO 31:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PRO 31:25"/>'इज़्ज़त और हुर्मत उसकी पोशाक हैं,</para>
  <para style="q" vid="PRO 31:25">और वह आइंदा दिनों पर हँसती है।<verse eid="PRO 31:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PRO 31:26"/>उसके मुँह से हिकमत की बातें निकलती हैं,</para>
  <para style="q" vid="PRO 31:26">उसकी ज़बान पर शफ़क़त की ता'लीम है।<verse eid="PRO 31:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PRO 31:27"/>वह अपने घराने पर बख़ूबी निगाह रखती है,</para>
  <para style="q" vid="PRO 31:27">और काहिली की रोटी नहीं खाती।<verse eid="PRO 31:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PRO 31:28"/>उसके बेटे उठते हैं और उसे मुबारक कहते हैं;</para>
  <para style="q" vid="PRO 31:28">उसका शौहर भी उसकी ता'रीफ़ करता है:<verse eid="PRO 31:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PRO 31:29"/>“कि बहुतेरी बेटियों ने फ़ज़ीलत दिखाई है,</para>
  <para style="q" vid="PRO 31:29">लेकिन तू सब से आगे बढ़ गई।”<verse eid="PRO 31:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PRO 31:30"/>हुस्न, धोका और जमाल बेसबात है,</para>
  <para style="q" vid="PRO 31:30">लेकिन वह 'औरत जो ख़ुदावन्द से डरती है, सतुदा होगी।<verse eid="PRO 31:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PRO 31:31"/>उसकी मेहनत का बदला उसे दो,</para>
  <para style="q" vid="PRO 31:31">और उसके कामों से मजलिस में उसकी ता'रीफ़ हो।<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
