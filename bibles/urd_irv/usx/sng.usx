<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="SNG" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">गज़लुल गज़लियात</para>
  <para style="toc1">गज़लुल गज़लियात</para>
  <para style="toc2">गज़लुल</para>
  <para style="toc3">गज़लुल</para>
  <para style="mt">गज़लुल गज़लियात</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">ग़ज़लुल गज़लियात का जो मज़्मून है वह इस किताब की पहली आयत से लिया गया है जो यह बयान करता है कि यह ग़ज़ल कहां से लाया गया है। 1:1 गज़लूल गज़लियात जो सुलेमान की तरफ़ से है। किताब का मज़्मून आखि़र — ए — कार सुलेमान के नाम से लिया गया क्योंकि उसके नाम का ज़िक्र पूरी किताब में किया गया है (1:5; 3:7, 9, 11; 8:11-12)।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इस किताब की तस्नीफ़ की तारीख़ तक़रीबन 971 - 965 क़ब्ल मसीह के बीच है।</para>
  <para style="ip">इस किताब को सुलेमान ने इस्राईल का बादशाह बतौर उसकी हकूमत के दौरान लिखी, उलमा‘ जो उस के मुसन्निफ़ होने से राज़ी हैं उन का मानना है कि यह ग़ज़ल उस के दौर — ए — हुकूमत के आग़ाज़ में लिखे गये न सिर्फ़ उस के जवानी के गज़लों के सबब नहीं बल्कि इस लिए भी कि मुसन्निफ़ ने अपने मुल्क के शुमाल और जुनूब के इलाक़ों का भी अपने गज़लों में ज़िक्र किया है साथ में लेबनान और मिस्त्र का भी।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">शादी शुदः जोड़े और मुजरिद मर्द, बिनबियाही औरत जो शादी का तसव्वुर कर रहे होते हैं।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">ग़ज़्लुल ग़ज़लियात एक ग़नाई गज़ल है जो मुहब्बत की नेकी के ता‘रीफ़ के पुल बांधता है और यह साफ़ तौर से शादी को पेश करती है जिस तरह ख़ुदा ने मख़्सूस किया है। एक शादी शुदा मर्द और औरत को शादी की हालत में एक साथ रहने की ज़रूरत है और एक दूसरे से रूहानी तौर से, जज़बाती तौर से और जिसमानी तौर से मुहब्बत करने की ज़रूरत है।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">मुहब्बत और शादी।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. दुल्हन सुलेमान की बाबत सोचती है। — 1:1-3:5</para>
  <para style="io1">2. मंगनी के लिए दुल्हन की क़ुबूलियत और शादी का इन्तज़ार — 3:6-5:1</para>
  <para style="io1">3. दुल्हन दुल्हे के छूट जाने का ख़्वाब देखती है — 5:2-6:3</para>
  <para style="io1">4. दुल्हन और दुलहा एक दूसरे की तारीफ़ करते हैं। — 6:4-8:14</para>
  <chapter number="1" style="c" sid="SNG 1"/>
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1"/>सुलेमान की ग़ज़ल — उल — ग़ज़लात।<verse eid="SNG 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 1:2"/>वह अपने मुँह के लबों से मुझे चूमे,</para>
  <para style="q" vid="SNG 1:2">क्यूँकि तेरा इश्क़ मय से बेहतर है।<verse eid="SNG 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 1:3"/>तेरे 'इत्र की खु़श्बू ख़ुशगवार है तेरा नाम 'इत्र रेख़्ता है;</para>
  <para style="q" vid="SNG 1:3">इसीलिए कुँवारियाँ तुझ पर आशिक़ हैं।<verse eid="SNG 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 1:4"/>मुझे खींच ले, हम तेरे पीछे दौड़ेंगी।</para>
  <para style="q" vid="SNG 1:4">बादशाह मुझे अपने महल में ले आया।</para>
  <para style="q" vid="SNG 1:4">हम तुझ में शादमान और मसरूर होंगी, हम तेरे 'इश्क़ का बयान मय से ज़्यादा करेंगी।</para>
  <para style="q" vid="SNG 1:4">वह सच्चे दिल से तुझ पर 'आशिक़ हैं।<verse eid="SNG 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 1:5"/>ऐ येरूशलेम की बेटियो,</para>
  <para style="q" vid="SNG 1:5">मैं सियाहफ़ाम लेकिन खू़बसूरत हूँ क़ीदार के खे़मों और सुलेमान के पर्दों की तरह।<verse eid="SNG 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 1:6"/>मुझे मत देखो कि मैं सियाहफ़ाम हूँ,</para>
  <para style="q" vid="SNG 1:6">क्यूँकि मैं धूप की जली हूँ। मेरी माँ के बेटे मुझ से नाख़ुश थे,</para>
  <para style="q" vid="SNG 1:6">उन्होंने मुझ से खजूर के बाग़ों की निगाहबानी कराई;</para>
  <para style="q" vid="SNG 1:6">लेकिन मैंने अपने खजूर के बाग़ की निगहबानी नहीं की<verse eid="SNG 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 1:7"/>ऐ मेरी जान के प्यारे! मुझे बता,</para>
  <para style="q" vid="SNG 1:7">तू अपने ग़ल्ले को कहाँ चराता है,</para>
  <para style="q" vid="SNG 1:7">और दोपहर के वक़्त कहाँ बिठाता है?</para>
  <para style="q" vid="SNG 1:7">क्यूँकि मैं तेरे दोस्तों के ग़ल्लों के पास क्यूँ मारी — मारी फिरूँ?<verse eid="SNG 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 1:8"/>ऐ 'औरतों में सब से ख़ूबसूरत,</para>
  <para style="q" vid="SNG 1:8">अगर तू नहीं जानती तो ग़ल्ले के नक़्श — ए — क़दम पर चली जा,</para>
  <para style="q" vid="SNG 1:8">और अपने बुज़ग़ालों को चरवाहों के खे़मों के पास पास चरा।<verse eid="SNG 1:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="SNG 1:9"/>ऐ मेरी प्यारी, मैंने तुझे फ़िर'औन के रथ की घोड़ियों में से एक के साथ मिसाल दी है।<verse eid="SNG 1:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 1:10"/>तेरे गाल लगातार जु़ल्फ़ों में खु़शनुमाँ हैं,</para>
  <para style="q" vid="SNG 1:10">और तेरी गर्दन मोतियों के हारों में।<verse eid="SNG 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 1:11"/>हम तेरे लिए सोने के तौक़ बनाएँगे, और उनमें चाँदी के फूल जड़ेंगे।<verse eid="SNG 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 1:12"/>जब तक बादशाह तनावुल फ़रमाता रहा,</para>
  <para style="q" vid="SNG 1:12">मेरे सुम्बुल की महक उड़ती रही।<verse eid="SNG 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 1:13"/>मेरा महबूब मेरे लिए दस्ता — ए — मुर है,</para>
  <para style="q" vid="SNG 1:13">जो रात भर मेरी सीने के बीच पड़ा रहता है।<verse eid="SNG 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 1:14"/>मेरा महबूब मेरे लिए ऐनजदी के अंगूरिस्तान से मेहन्दी के फूलों का गुच्छा है।<verse eid="SNG 1:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="SNG 1:15"/>देख, तू खू़बसूरत है ऐ मेरी प्यारी,</para>
  <para style="q" vid="SNG 1:15">देख तू ख़ूबसूरत है। तेरी आँखें दो कबूतर हैं।<verse eid="SNG 1:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 1:16"/>देख, तू ही खू़बसूरत है ऐ मेरे महबूब, बल्कि दिल पसन्द है;</para>
  <para style="q" vid="SNG 1:16">हमारा पलंग भी सब्ज़ है।<verse eid="SNG 1:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 1:17"/>हमारे घर के शहतीर देवदार के और हमारी कड़ियाँ सनोबर की हैं।<verse eid="SNG 1:17"/></para>
  <chapter eid="SNG 1"/>
  <chapter number="2" style="c" sid="SNG 2"/>
  <para style="sp">जवान औरत</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 2:1"/>मैं शारून की नर्गिस,</para>
  <para style="q" vid="SNG 2:1">और वादियों की सोसन हूँ।<verse eid="SNG 2:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="SNG 2:2"/>जैसी सोसन झाड़ियों में,</para>
  <para style="q" vid="SNG 2:2">वैसी ही मेरी महबूबा कुँवारियों में है।<verse eid="SNG 2:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="SNG 2:3"/>जैसा सेब का दरख़्त जंगल के दरख़्तों में,</para>
  <para style="q" vid="SNG 2:3">वैसा ही मेरा महबूब नौजवानों में है।</para>
  <para style="q" vid="SNG 2:3">मैं निहायत शादमानी से उसके साये में बैठी,</para>
  <para style="q" vid="SNG 2:3">और उसका फल मेरे मुँह में मीठा लगा।<verse eid="SNG 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 2:4"/>वह मुझे मयख़ाने के अंदर लाया,</para>
  <para style="q" vid="SNG 2:4">और उसकी मुहब्बत का झंडा मेरे ऊपर था।<verse eid="SNG 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 2:5"/>किशमिश से मुझे क़रार दो, सेबों से मुझे ताज़ादम करो,</para>
  <para style="q" vid="SNG 2:5">क्यूँकि मैं इश्क की बीमार हूँ।<verse eid="SNG 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 2:6"/>उसका बायाँ हाथ मेरे सिर के नीचे है,</para>
  <para style="q" vid="SNG 2:6">और उसका दहना हाथ मुझे गले से लगाता है।<verse eid="SNG 2:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="SNG 2:7"/>ऐ येरूशलेम की बेटियो,</para>
  <para style="q" vid="SNG 2:7">मैं तुम को ग़ज़ालों और मैदान की हिरनीयों की क़सम देती हूँ तुम मेरे प्यारे को न जगाओ न उठाओ,</para>
  <para style="q" vid="SNG 2:7">जब तक कि वह उठना न चाहे।<verse eid="SNG 2:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="SNG 2:8"/>मेरे महबूब की आवाज़! देख, वह आ रहा है।</para>
  <para style="q" vid="SNG 2:8">पहाड़ों पर से कूदता और टीलों पर से फाँदता हुआ चला आता है।<verse eid="SNG 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 2:9"/>मेरा महबूब आहू या जवान ग़ज़ाल की तरह है।</para>
  <para style="q" vid="SNG 2:9">देख, वह हमारी दीवार के पीछे खड़ा है,</para>
  <para style="q" vid="SNG 2:9">वह खिड़कियों से झाँकता है, वह झाड़ियों से ताकता है।<verse eid="SNG 2:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="SNG 2:10"/>“मेरे महबूब ने मुझ से बातें कीं और कहा,</para>
  <para style="q" vid="SNG 2:10">उठ मेरी प्यारी, मेरी नाज़नीन चली आ!<verse eid="SNG 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 2:11"/>क्यूँकि देख जाड़ा गुज़र गया,</para>
  <para style="q" vid="SNG 2:11">मेंह बरस चुका और निकल गया।<verse eid="SNG 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 2:12"/>ज़मीन पर फूलों की बहार है,</para>
  <para style="q" vid="SNG 2:12">परिन्दों के चहचहाने का वक़्त आ पहुँचा,</para>
  <para style="q" vid="SNG 2:12">और हमारी सरज़मीन में कुमरियों की आवाज़ सुनाई देने लगी।<verse eid="SNG 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 2:13"/>अंजीर के दरख़्तों में हरे अंजीर पकने लगे,</para>
  <para style="q" vid="SNG 2:13">और ताकें फूलने लगीं; उनकी महक फैल रही है।</para>
  <para style="q" vid="SNG 2:13">इसलिए उठ मेरी प्यारी, मेरी जमीला, चली आ।<verse eid="SNG 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 2:14"/>ऐ मेरी कबूतरी, जो चट्टानों की दरारों में और कड़ाड़ों की आड़ में छिपी है;</para>
  <para style="q" vid="SNG 2:14">मुझे अपना चेहरा दिखा, मुझे अपनी आवाज़ सुना,</para>
  <para style="q" vid="SNG 2:14">क्यूँकि तू माहजबीन और तेरी आवाज़ मीठी है।<verse eid="SNG 2:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="SNG 2:15"/>हमारे लिए लोमड़ियों को पकड़ो,</para>
  <para style="q" vid="SNG 2:15">उन लोमड़ी बच्चों को जो खजूर के बाग़ को ख़राब करते हैं;</para>
  <para style="q" vid="SNG 2:15">क्यूँकि हमारी ताकों में फूल लगे हैं।”<verse eid="SNG 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 2:16"/>मेरा महबूब मेरा है और मैं उसकी हूँ,</para>
  <para style="q" vid="SNG 2:16">वह सोसनों के बीच चराता है।<verse eid="SNG 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 2:17"/>जब तक दिन ढले और साया बढ़े, तू फिर आ ऐ मेरे महबूब।</para>
  <para style="q" vid="SNG 2:17">तू ग़ज़ाल या जवान हिरन की तरह होकर आ, जो बातर के पहाड़ों पर है।<verse eid="SNG 2:17"/></para>
  <chapter eid="SNG 2"/>
  <chapter number="3" style="c" sid="SNG 3"/>
  <para style="sp">जवान औरत</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 3:1"/>मैंने रात को अपने पलंग पर उसे ढूँडा जो मेरी जान का प्यारा है;</para>
  <para style="q" vid="SNG 3:1">मैंने उसे ढूँडा पर न पाया।<verse eid="SNG 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 3:2"/>अब मैं उठूँगी और शहर में फिरूँगी,</para>
  <para style="q" vid="SNG 3:2">गलियों में और बाज़ारों में, उसको ढूँडूंगी जो मेरी जान का प्यारा है।</para>
  <para style="q" vid="SNG 3:2">मैंने उसे ढूँडा पर न पाया।<verse eid="SNG 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 3:3"/>पहरेवाले जो शहर में फिरते हैं मुझे मिले। मैंने पूछा,</para>
  <para style="q" vid="SNG 3:3">“क्या तुम ने उसे देखा है, जो मेरी जान का प्यारा है?”<verse eid="SNG 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 3:4"/>अभी मैं उनसे थोड़ा ही आगे बढ़ी थी,</para>
  <para style="q" vid="SNG 3:4">कि मेरी जान का प्यारा मुझे मिल गया। मैंने उसे पकड़ रख्खा और उसे न छोड़ा;</para>
  <para style="q" vid="SNG 3:4">जब तक कि मैं उसे अपनी माँ के घर में और अपनी वालिदा के आरामगाह में न ले गई।<verse eid="SNG 3:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="SNG 3:5"/>ऐ येरूशलेम की बेटियो,</para>
  <para style="q" vid="SNG 3:5">मैं तुम को ग़ज़ालों और मैदान की हिरनीयों की क़सम देती हूँ कि तुम मेरे प्यारे को न जगाओ न उठाओ,</para>
  <para style="q" vid="SNG 3:5">जब तक कि वह उठना न चाहे।<verse eid="SNG 3:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="SNG 3:6"/>यह कौन है जो मुर और लुबान से और सौदागरों के तमाम 'इत्रों से मु'अत्तर होकर,</para>
  <para style="q" vid="SNG 3:6">बियाबान से धुंवे के खम्बे की तरह चला आता है।<verse eid="SNG 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 3:7"/>देखो, यह सुलेमान की पालकी है!</para>
  <para style="q" vid="SNG 3:7">जिसके साथ इस्राईली बहादुरों में से साठ पहलवान हैं।<verse eid="SNG 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 3:8"/>वह सब के सब शमशीरज़न और जंग में माहिर हैं।</para>
  <para style="q" vid="SNG 3:8">रात के ख़तरे की वजह से हर एक की तलवार उसकी रान पर लटक रही है।<verse eid="SNG 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 3:9"/>सुलेमान बादशाह ने लुबनान की लकड़ियों से अपने लिए एक पालकी बनवाई।<verse eid="SNG 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 3:10"/>उसके डंडे चाँदी के बनवाए,</para>
  <para style="q" vid="SNG 3:10">उसके बैठने की जगह सोने की और गद्दीअर्ग़वानी बनवाई;</para>
  <para style="q" vid="SNG 3:10">और उसके अंदर का फ़र्श, येरूशलेम की बेटियों ने इश्क से आरास्ता किया।<verse eid="SNG 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 3:11"/>ऐ सिय्यून की बेटियो,</para>
  <para style="q" vid="SNG 3:11">बाहर निकलो और सुलेमान बादशाह को देखो;</para>
  <para style="q" vid="SNG 3:11">उस ताज के साथ जो उसकी माँ ने उसके शादी के दिन और उसके दिल की शादमानी के दिन उसके सिर पर रख्खा।<verse eid="SNG 3:11"/></para>
  <chapter eid="SNG 3"/>
  <chapter number="4" style="c" sid="SNG 4"/>
  <para style="sp">जवान मर्द</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 4:1"/>देख, तू ख़ूबसूरत है ऐ मेरी प्यारी!</para>
  <para style="q" vid="SNG 4:1">देख, तू ख़ूबसूरत है; तेरी आँखें तेरे नक़ाब के नीचे दो कबूतर हैं,</para>
  <para style="q" vid="SNG 4:1">तेरे बाल बकरियों के गल्ले की तरह हैं,</para>
  <para style="q" vid="SNG 4:1">जो कोह — ए — जिल्'आद पर बैठी हों।<verse eid="SNG 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 4:2"/>तेरे दाँत भेड़ों के ग़ल्ले की तरह हैं,</para>
  <para style="q" vid="SNG 4:2">जिनके बाल कतरे गए हों और जिनको गु़स्ल दिया गया हो,</para>
  <para style="q" vid="SNG 4:2">जिनमें से हर एक ने दो बच्चे दिए हों, और उनमें एक भी बाँझ न हो।<verse eid="SNG 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 4:3"/>तेरे होंठ किर्मिज़ी डोरे हैं,</para>
  <para style="q" vid="SNG 4:3">तेरा मुँह दिल फ़रेब है,</para>
  <para style="q" vid="SNG 4:3">तेरी कनपटियाँ तेरे नक़ाब के नीचे अनार के टुकड़ों की तरह हैं।<verse eid="SNG 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 4:4"/>तेरी गर्दन दाऊद का बुर्ज है जो सिलाहख़ाने के लिए बना जिस पर हज़ार ढाल लटकाई गई हैं,</para>
  <para style="q" vid="SNG 4:4">वह सब की सब पहलवानों की ढालें हैं।<verse eid="SNG 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 4:5"/>तेरी दोनों छातियाँ दो तोअम आहू बच्चे हैं,</para>
  <para style="q" vid="SNG 4:5">जो सोसनों में चरते हैं।<verse eid="SNG 4:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="SNG 4:6"/>जब तक दिन ढले और साया बढ़े,</para>
  <para style="q" vid="SNG 4:6">मैं मुर के पहाड़ और लुबान के टीले पर जा रहूँगा।<verse eid="SNG 4:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="SNG 4:7"/>ऐ मेरी प्यारी, तू सरापा जमाल है;</para>
  <para style="q" vid="SNG 4:7">तुझ में कोई 'ऐब नहीं।<verse eid="SNG 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 4:8"/>लुबनान से मेरे साथ, ऐ दुल्हन!</para>
  <para style="q" vid="SNG 4:8">तू लुबनान से मेरे साथ चली आ।</para>
  <para style="q" vid="SNG 4:8">अमाना की चोटी पर से,</para>
  <para style="q" vid="SNG 4:8">सनीर और हरमून की चोटी पर से,</para>
  <para style="q" vid="SNG 4:8">शेरों की मांदों से, और चीतों के पहाड़ों पर से नज़र दौड़ा।<verse eid="SNG 4:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 4:9"/>ऐ मेरी प्यारी, मेरी ज़ोजा, तू ने मेरा दिल लूट लिया।</para>
  <para style="q" vid="SNG 4:9">अपनी एक नज़र से,</para>
  <para style="q" vid="SNG 4:9">अपनी गर्दन के एक तौक़ से तू ने मेरा दिल ग़ारत कर लिया।<verse eid="SNG 4:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 4:10"/>ऐ मेरी प्यारी, मेरी ज़ौजा, तेरा 'इश्क क्या ख़ूब है।</para>
  <para style="q" vid="SNG 4:10">तेरी मुहब्बत मय से ज़्यादा लज़ीज़ है,</para>
  <para style="q" vid="SNG 4:10">और तेरे इत्रों की महक हर तरह की ख़ुश्बू से बढ़कर है।<verse eid="SNG 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 4:11"/>ऐ मेरी ज़ोजा, तेरे होटों से शहद टपकता है;</para>
  <para style="q" vid="SNG 4:11">शहद — ओ — शीर तेरे ज़बान तले है तेरी पोशाक की खु़श्बू लुबनान की जैसी है।<verse eid="SNG 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 4:12"/>मेरी प्यारी, मेरी ज़ोजा एक महफ़ूज़ बाग़ीचा है;</para>
  <para style="q" vid="SNG 4:12">वह महफ़ूज़ सोता और सर बमुहर चश्मा है।<verse eid="SNG 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 4:13"/>तेरे बाग़ के पौधे लज़ीज़ मेवादार अनार हैं,</para>
  <para style="q" vid="SNG 4:13">मेहन्दी और सुम्बुल भी हैं।<verse eid="SNG 4:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 4:14"/>जटामासी और ज़ा'फ़रान,</para>
  <para style="q" vid="SNG 4:14">बेदमुश्क और दारचीनी और लोबान के तमाम दरख़्त,</para>
  <para style="q" vid="SNG 4:14">मुर और ऊद और हर तरह की ख़ास खु़श्बू।<verse eid="SNG 4:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 4:15"/>तू बाग़ों में एक मम्बा', आब — ए — हयात का चश्मा,</para>
  <para style="q" vid="SNG 4:15">और लुबनान का झरना है।<verse eid="SNG 4:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="SNG 4:16"/>ऐ शिमाली हवा बेदार हो, ऐ दख्खिनी हवा चली आ!</para>
  <para style="q" vid="SNG 4:16">मेरे बाग़ पर से गुज़र, ताकि उसकी ख़ुशबू फैले।</para>
  <para style="q" vid="SNG 4:16">मेरा महबूब अपने बाग़ में आए,</para>
  <para style="q" vid="SNG 4:16">और अपने लज़ीज़ मेवे खाए।<verse eid="SNG 4:16"/></para>
  <chapter eid="SNG 4"/>
  <chapter number="5" style="c" sid="SNG 5"/>
  <para style="sp">जवान मर्द</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 5:1"/>मै अपने बाग़ में आया हूँ ऐ मेरी प्यारी ऐ मेरी ज़ौजा;</para>
  <para style="q" vid="SNG 5:1">मैंने अपना मुर अपने बलसान समेत जमा' कर लिया;</para>
  <para style="q" vid="SNG 5:1">मैंने अपना शहद छत्ते समेत खा लिया,</para>
  <para style="q" vid="SNG 5:1">मैंने अपनी मय दूध समेत पी ली है। ऐ दोस्तो, खाओ, पियो। पियो!</para>
  <para style="q" vid="SNG 5:1">हाँ, ऐ 'अज़ीज़ो, खू़ब जी भर के पियो!<verse eid="SNG 5:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="SNG 5:2"/>मैं सोती हूँ, लेकिन मेरा दिल जागता है।</para>
  <para style="q" vid="SNG 5:2">मेरे महबूब की आवाज़ है जो खटखटाता है,</para>
  <para style="q" vid="SNG 5:2">और कहता है, “मेरे लिए दरवाज़ा खोल, मेरी महबूबा,</para>
  <para style="q" vid="SNG 5:2">मेरी प्यारी! मेरी कबूतरी, मेरी पाकीज़ा, क्यूँकि मेरा सिर शबनम से तर है,</para>
  <para style="q" vid="SNG 5:2">और मेरी जु़ल्फे़ रात की बूँदों से भरी हैं।”<verse eid="SNG 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 5:3"/>मैं तो कपड़े उतार चुकी, अब फिर कैसे पहनूँ?</para>
  <para style="q" vid="SNG 5:3">मैं तो अपने पाँव धो चुकी, अब उनको क्यूँ मैला करूँ?<verse eid="SNG 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 5:4"/>मेरे महबूब ने अपना हाथ सूराख़ से अन्दर किया,</para>
  <para style="q" vid="SNG 5:4">और मेरे दिल — ओ — जिगर में उसके लिए हरकत हुई।<verse eid="SNG 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 5:5"/>मैं अपने महबूब के लिए दरवाज़ा खोलने को उठी,</para>
  <para style="q" vid="SNG 5:5">और मेरे हाथों से मुर टपका, और मेरी उँगलियों से रक़ीक़ मुर टपका,</para>
  <para style="q" vid="SNG 5:5">और कु़फ़्ल के दस्तों पर पड़ा।<verse eid="SNG 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 5:6"/>मैंने अपने महबूब के लिए दरवाज़ा खोला,</para>
  <para style="q" vid="SNG 5:6">लेकिन मेरा महबूब मुड़ कर चला गया था। जब वह बोला,</para>
  <para style="q" vid="SNG 5:6">तो मैं बदहवास हो गई। मैंने उसे ढूँडा पर न पाया;</para>
  <para style="q" vid="SNG 5:6">मैंने उसे पुकारा पर उसने मुझे कुछ जवाब न दिया।<verse eid="SNG 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 5:7"/>पहरेवाले जो शहर में फिरते हैं, मुझे मिले;</para>
  <para style="q" vid="SNG 5:7">उन्होंने मुझे मारा और घायल किया;</para>
  <para style="q" vid="SNG 5:7">शहरपनाह के मुहाफ़िज़ों ने मेरी चादर मुझ से छीन ली।<verse eid="SNG 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 5:8"/>ऐ येरूशलेम की बेटियो!</para>
  <para style="q" vid="SNG 5:8">मैं तुम को क़सम देती हूँ कि अगर मेरा महबूब तुम को मिल जाए,</para>
  <para style="q" vid="SNG 5:8">तो उससे कह देना कि मैं इश्क की बीमार हूँ।<verse eid="SNG 5:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="SNG 5:9"/>तेरे महबूब को किसी दूसरे महबूब पर क्या फ़ज़ीलत है, ऐ 'औरतों में सब से जमीला?</para>
  <para style="q" vid="SNG 5:9">तेरे महबूब को किसी दूसरे महबूब पर क्या फ़ौकियत है?</para>
  <para style="q" vid="SNG 5:9">जो तू हम को इस तरह क़सम देती है।<verse eid="SNG 5:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="SNG 5:10"/>मेरा महबूब सुर्ख़ — ओ — सफ़ेद है,</para>
  <para style="q" vid="SNG 5:10">वह दस हज़ार में मुम्ताज़ है।<verse eid="SNG 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 5:11"/>उसका सिर ख़ालिस सोना है,</para>
  <para style="q" vid="SNG 5:11">उसकी जुल्फें पेच — दर — पेचऔर कौवे सी काली हैं।<verse eid="SNG 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 5:12"/>उसकी आँखें उन कबूतरों की तरह हैं,</para>
  <para style="q" vid="SNG 5:12">जो दूध में नहाकर लब — ए — दरिया तमकनत से बैठे हों।<verse eid="SNG 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 5:13"/>उसके गाल फूलों के चमन और बलसान की उभरी हुई क्यारियाँ हैं।</para>
  <para style="q" vid="SNG 5:13">उसके होंट सोसन हैं, जिनसे रक़ीक़ मुर टपकता है।<verse eid="SNG 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 5:14"/>उसके हाथ ज़बरजद से आरास्ता सोने के हल्के हैं।</para>
  <para style="q" vid="SNG 5:14">उसका पेट हाथी दाँत का काम है, जिस पर नीलम के फूल बने हो।<verse eid="SNG 5:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 5:15"/>उसकी टांगे कुन्दन के पायों पर संग — ए — मरमर के खम्बे हैं।</para>
  <para style="q" vid="SNG 5:15">वह देखने में लुबनान और खू़बी में रश्क — ए — सरो है।<verse eid="SNG 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 5:16"/>उसका मुँह अज़ बस शीरीन है; हाँ, वह सरापा 'इश्क अंगेज़ है।</para>
  <para style="q" vid="SNG 5:16">ऐ येरूशलेम की बेटियो, यह है मेरा महबूब, यह है मेरा प्यारा।<verse eid="SNG 5:16"/></para>
  <chapter eid="SNG 5"/>
  <chapter number="6" style="c" sid="SNG 6"/>
  <para style="sp">यरूशलेम की जवान औरत</para>
  <para style="b"/>
  <para style="q">
    <verse number="1" style="v" sid="SNG 6:1"/>तेरा महबूब कहाँ गया ऐ 'औरतों में सब से जमीला?</para>
  <para style="q" vid="SNG 6:1">तेरा महबूब किस तरफ़ को निकला कि हम तेरे साथ उसकी तलाश में जाएँ?<verse eid="SNG 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 6:2"/>मेरा महबूब अपने बोस्तान में बलसान की क्यारियों की तरफ़ गया है,</para>
  <para style="q" vid="SNG 6:2">ताकि बागों में चराये और सोसन जमा' करे।<verse eid="SNG 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 6:3"/>मैं अपने महबूब की हूँ और मेरा महबूब मेरा है।</para>
  <para style="q" vid="SNG 6:3">वह सोसनों में चराता है।<verse eid="SNG 6:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="SNG 6:4"/>ऐ मेरी प्यारी, तू तिर्ज़ा की तरह खू़बसूरत है।</para>
  <para style="q" vid="SNG 6:4">येरूशलेम की तरह खु़शमंज़र और 'अलमदार लश्कर की तरह दिल पसन्द है।<verse eid="SNG 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 6:5"/>अपनी आँखें मेरी तरफ़ से फेर ले,</para>
  <para style="q" vid="SNG 6:5">क्यूँकि वह मुझे घबरा देती हैं;</para>
  <para style="q" vid="SNG 6:5">तेरे बाल बकरियों के गल्ले की तरह हैं,</para>
  <para style="q" vid="SNG 6:5">जो कोह — ए — जिल्आद पर बैठी हों।<verse eid="SNG 6:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 6:6"/>तेरे दाँत भेड़ों के गल्ले की तरह हैं,</para>
  <para style="q" vid="SNG 6:6">जिनको गु़स्ल दिया गया हो;</para>
  <para style="q" vid="SNG 6:6">जिनमें से हर एक ने दो बच्चे दिए हों,</para>
  <para style="q" vid="SNG 6:6">और उनमें एक भी बाँझ न हो।<verse eid="SNG 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 6:7"/>तेरी कनपटियाँ तेरे नक़ाब के नीचे,</para>
  <para style="q" vid="SNG 6:7">अनार के टुकड़ों की तरह हैं।<verse eid="SNG 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 6:8"/>साठ रानियाँ और अस्सी हरमें,</para>
  <para style="q" vid="SNG 6:8">और बेशुमार कुंवारियाँ भी हैं;<verse eid="SNG 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 6:9"/>लेकिन मेरी कबूतरी, मेरी पाकीज़ा बेमिसाल है;</para>
  <para style="q" vid="SNG 6:9">वह अपनी माँ की इकलौती, वह अपनी वालिदा की लाडली है।</para>
  <para style="q" vid="SNG 6:9">बेटियों ने उसे देखा और उसे मुबारक कहा।</para>
  <para style="q" vid="SNG 6:9">रानियों और हरमों ने देखकर उसकी बड़ाई की।<verse eid="SNG 6:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="SNG 6:10"/>यह कौन है जिसका ज़हूर सुबह की तरह है,</para>
  <para style="q" vid="SNG 6:10">जो हुस्न में माहताब, और नूर में आफ़ताब,</para>
  <para style="q" vid="SNG 6:10">'अलमदार लश्कर की तरह दिल पसन्द है?<verse eid="SNG 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 6:11"/>मैं चिलगोज़ों के बाग में गया,</para>
  <para style="q" vid="SNG 6:11">कि वादी की नबातात पर नज़र करूँ,</para>
  <para style="q" vid="SNG 6:11">और देखें कि ताक में गुंचे,</para>
  <para style="q" vid="SNG 6:11">और अनारों में फूल निकलें हैं कि नहीं।<verse eid="SNG 6:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 6:12"/>मुझे अभी ख़बर भी न थी कि मेरे दिल ने मुझे मेरे उमरा के रथों पर चढ़ा दिया।<verse eid="SNG 6:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="SNG 6:13"/>लौट आ, लौट आ, ऐ शूलिमीत!</para>
  <para style="q" vid="SNG 6:13">लौट आ, लौट आ कि हम तुझ पर नज़र करें।</para>
  <para style="q" vid="SNG 6:13">तुम शूलिमीत पर क्यूँ नज़र करोगे,</para>
  <para style="q" vid="SNG 6:13">जैसे वह दो लश्करों का नाच है।<verse eid="SNG 6:13"/></para>
  <chapter eid="SNG 6"/>
  <chapter number="7" style="c" sid="SNG 7"/>
  <para style="q">
    <verse number="1" style="v" sid="SNG 7:1"/>ऐ अमीरज़ादी तेरे पाँव जूतियों में कैसे खू़बसूरत हैं!</para>
  <para style="q" vid="SNG 7:1">तेरी रानों की गोलाई उन ज़ेवरों की तरह है,</para>
  <para style="q" vid="SNG 7:1">जिनको किसी उस्ताद कारीगर ने बनाया हो।<verse eid="SNG 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 7:2"/>तेरी नाफ़ गोल प्याला है, जिसमें मिलाई हुई मय की कमी नहीं।</para>
  <para style="q" vid="SNG 7:2">तेरा पेट गेहूँ का अम्बार है, जिसके आस — पास सोसन हों।<verse eid="SNG 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 7:3"/>तेरी दोनों छातियाँ दो आहू बच्चे हैं जो तोअम पैदा हुए हों।<verse eid="SNG 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 7:4"/>तेरी गर्दन हाथी दाँत का बुर्ज है।</para>
  <para style="q" vid="SNG 7:4">तेरी आँखें बैत — रबीम के फाटक के पास हस्बून के चश्मे हैं।</para>
  <para style="q" vid="SNG 7:4">तेरी नाक लुबनान के बुर्ज की मिसाल है जो दमिश्क़ के रुख़ बना है।<verse eid="SNG 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 7:5"/>तेरा सिर तुझ पर कर्मिल की तरह है,</para>
  <para style="q" vid="SNG 7:5">और तेरे सिर के बाल अर्ग़वानी हैं;</para>
  <para style="q" vid="SNG 7:5">बादशाह तेरी जुल्फ़ों में क़ैदी है।<verse eid="SNG 7:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 7:6"/>ऐ महबूबा ऐश — ओ — इश्रत के लिए तू कैसी जमीला और जाँफ़ज़ा है।<verse eid="SNG 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 7:7"/>यह तेरी क़ामत खजूर की तरह है,</para>
  <para style="q" vid="SNG 7:7">और तेरी छातियाँ अंगूर के गुच्छे हैं।<verse eid="SNG 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 7:8"/>मैंने कहा, मैं इस खजूर पर चढूँगा, और इसकी शाख़ों को पकड़ूँगा।</para>
  <para style="q" vid="SNG 7:8">तेरी छातियाँ अंगूर के गुच्छे हों और तेरे साँस की ख़ुशबू सेब के जैसी हो,<verse eid="SNG 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 7:9"/>और तेरा मुँह' बेहतरीन शराब की तरह हो जो मेरे महबूब की तरफ़ सीधी चली जाती है,</para>
  <para style="q" vid="SNG 7:9">और सोने वालों के होंटों पर से आहिस्ता आहिस्ता बह जाती है।<verse eid="SNG 7:9"/></para>
  <para style="sp">जवान औरत</para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="SNG 7:10"/>मैं अपने महबूब की हूँऔर वह मेरा मुश्ताक़ है।<verse eid="SNG 7:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 7:11"/>ऐ मेरे महबूब, चल हम खेतों में सैर करेंऔर गाँव में रात काटें।<verse eid="SNG 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 7:12"/>फिर तड़के अंगूरिस्तानों में चलें,</para>
  <para style="q" vid="SNG 7:12">और देखें कि आया ताक शिगुफ़्ता है,</para>
  <para style="q" vid="SNG 7:12">और उसमे फूल निकले हैं,</para>
  <para style="q" vid="SNG 7:12">और अनार की कलियाँ खिली हैं या नहीं।</para>
  <para style="q" vid="SNG 7:12">वहाँ मैं तुझे अपनी मुहब्बत दिखाउंगी।<verse eid="SNG 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 7:13"/>मर्दुमग्याह की ख़ुशबू फ़ैल रही है,</para>
  <para style="q" vid="SNG 7:13">और हमारे दरवाज़ों पर हर क़िस्म के तर — ओ — ख़ुश्क मेवे हैं जो मैंने तेरे लिए जमा' कर रख्खे हैं, ऐ मेरे महबूब।<verse eid="SNG 7:13"/></para>
  <chapter eid="SNG 7"/>
  <chapter number="8" style="c" sid="SNG 8"/>
  <para style="sp">जवान औरत</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 8:1"/>काश कि तू मेरे भाई की तरह होता,</para>
  <para style="q" vid="SNG 8:1">जिसने मेरी माँ की छातियों से दूध पिया। मैं जब तुझे बाहर पाती,</para>
  <para style="q" vid="SNG 8:1">तो तेरी मच्छियाँ लेती, और कोई मुझे हक़ीर न जानता।<verse eid="SNG 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 8:2"/>मैं तुझ को अपनी माँ के घर में ले जाती, वह मुझे सिखाती।</para>
  <para style="q" vid="SNG 8:2">मैं अपने अनारों के रस से तुझे मम्जूज मय पिलाती।<verse eid="SNG 8:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 8:3"/>उसका बायाँ हाथ मेरे सिर के नीचे होता,</para>
  <para style="q" vid="SNG 8:3">और दहना मुझे गले से लगाता!<verse eid="SNG 8:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="SNG 8:4"/>ऐ येरूशलेम की बेटियो,</para>
  <para style="q" vid="SNG 8:4">मैं तुम को क़सम देती हूँ कि तुम मेरे प्यारे को न जगाओ न उठाओ,</para>
  <para style="q" vid="SNG 8:4">जब तक कि वह उठना न चाहे।<verse eid="SNG 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 8:5"/>यह कौन है जो वीराने से,</para>
  <para style="q" vid="SNG 8:5">अपने महबूब पर तकिया किए चली आती है?</para>
  <para style="q" vid="SNG 8:5">मैंने तुझे सेब के दरख़्त के नीचे जगाया। जहाँ तेरी पैदाइश हुई,</para>
  <para style="q" vid="SNG 8:5">जहाँ तेरी माँ ने तुझे पैदा किया।<verse eid="SNG 8:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="SNG 8:6"/>नगीन की तरह मुझे अपने दिल में लगा रख और तावीज़ की तरह अपने बाज़ू पर,</para>
  <para style="q" vid="SNG 8:6">क्यूँकि इश्क मौत की तरह ज़बरदस्त है,</para>
  <para style="q" vid="SNG 8:6">और गै़रत पाताल सी बेमुरव्वत है उसके शो'ले आग के शोले हैं,</para>
  <para style="q" vid="SNG 8:6">और ख़ुदावन्द के शोले की तरह।<verse eid="SNG 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 8:7"/>सैलाब 'इश्क़ को बुझा नहीं सकता,</para>
  <para style="q" vid="SNG 8:7">बाढ़ उसको डुबा नहीं सकती,</para>
  <para style="q" vid="SNG 8:7">अगर आदमी मुहब्बत के बदले अपना सब कुछ दे डाले तो वह सरासर हिकारत के लायक़ ठहरेगा।<verse eid="SNG 8:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="SNG 8:8"/>हमारी एक छोटी बहन है,</para>
  <para style="q" vid="SNG 8:8">अभी उसकी छातियाँ नहीं उठीं। जिस रोज़ उसकी बात चले,</para>
  <para style="q" vid="SNG 8:8">हम अपनी बहन के लिए क्या करें?<verse eid="SNG 8:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="SNG 8:9"/>अगर वह दीवार हो,</para>
  <para style="q" vid="SNG 8:9">तो हम उस पर चाँदी का बुर्ज बनाएँगेऔर अगर वह दरवाज़ा हो;</para>
  <para style="q" vid="SNG 8:9">हम उस पर देवदार के तख़्ते लगाएँगे।<verse eid="SNG 8:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="SNG 8:10"/>मैं दीवार हूँ और मेरी छातियाँ बुर्ज हैं</para>
  <para style="q" vid="SNG 8:10">और मैं उसकी नज़र में सलामती याफ़्ता, की तरह थी।<verse eid="SNG 8:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 8:11"/>बाल हामून में सुलेमान का खजूर का बाग़ था</para>
  <para style="q" vid="SNG 8:11">उसने उस खजूर के बाग़ को बाग़बानों के सुपुर्द किया कि उनमें से हर एक उसके फल के बदले हज़ार मिस्क़ाल चाँदी अदा करे।<verse eid="SNG 8:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 8:12"/>मेरा खजूर का बाग़ जो मेरा ही है मेरे सामने है ऐ सुलेमान तू तो हज़ार ले,</para>
  <para style="q" vid="SNG 8:12">और उसके फल के निगहबान दो सौ पाएँ।<verse eid="SNG 8:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="SNG 8:13"/>ऐ बूस्तान में रहनेवाली,</para>
  <para style="q" vid="SNG 8:13">दोस्त तेरी आवाज़ सुनते हैं;</para>
  <para style="q" vid="SNG 8:13">मुझ को भी सुना।<verse eid="SNG 8:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="SNG 8:14"/>ऐ मेरे महबूब जल्दी कर</para>
  <para style="q" vid="SNG 8:14">और उस ग़ज़ाल या आहू बच्चे की तरह हो जा,</para>
  <para style="q" vid="SNG 8:14">जो बलसानी पहाड़ियों पर है।<verse eid="SNG 8:14"/></para>
  <chapter eid="SNG 8"/>
</usx>
