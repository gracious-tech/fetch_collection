<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">या'क़ूब</para>
  <para style="toc1">या'क़ूब</para>
  <para style="toc2">या'क़ूब</para>
  <para style="toc3">या'क़ूब</para>
  <para style="mt">या'क़ूब का 'आम ख़त</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">इस ख़त का मुसन्निफ़ याक़ूब है। (1:1), यरूशलेम की कलीसिया का ख़ास रहनुमा और येसू मसही का भाई। येसू मसीह के कई एक भाइयों में से याक़ूब भी एक भाई था, ग़ालिबन वह तमाम भाइयों में से बड़ा था इस लिए मत्ती 13:55, 56 में मत्ती उस के चार भाइयों के नाम पेश करता है और उसकी बहनों का भी ज़िक्र करता है। शुरू शुरू में याक़ूब येसू पर ईमान नहीं लाया था और यहां तक कि ख़ुदा का बेटा न होने का दावा भी किया था और उस की खि़दमतगुज़ारी की बाबत कुछ ग़लतफ़हमी भी थी। (यूहन्ना 7:2 — 5) बाद में उस ने येसू पर पूरी तरह से ईमान लाया और कलीसिया में मश्हूर — ओ — मा‘रूफ़ हो गया। जो लोग शख़्सी तौर से खि़दमत के लिए चुने गये थे उन में से याक़ूब भी एक था। येसू अपनी क़यामत के बाद उस पर ज़ाहिर हुआ था (1 कुरिन्थियों 15:7), पौलूस ने उसे कलीसिया का खम्बा (सरबराह) कहा (गलतियों 2:9)।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इस ख़त को तक़रीबन 40 - 50 ईस्वी के बीच लिखा गया।</para>
  <para style="ip">50 ईस्वी में यरूशलेम की कौनसिल के क़ायम होने से पहले और 70 ईस्वी में हैकल (मंदिर) की बर्बादी से पहले लिखा गया।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">इस ख़त के क़बूल कुनिन्दा पाने वाले (पाने वाले) अक्सर ग़ालिबन यहूदी ईमान्दार थे जो कि सारे यहूदिया और सामरिया में फैले हुए थे। इसके बावजूद भी याक़ूब के पहले सलाम की इबारत (1:1) की बिना पर इस्राईल के बारह क़बीलों को जो जगह जगह बसे हुए हैं” यह इलाक़े याक़ूब के लिए हर मुमकिन तौर से असली क़ारिईन व नाज़रीन हैं।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">याकूब के ख़त के लिखने के अज़ हद ज़रूरी मक़्सद को याक़ूब 1:2 — 4 में देखा जा सकता है। उस के शुरूआती अल्फ़ाज़ में याक़ूब ने अपने क़ारिईन को बताया, मेरे भाइयों और बहनों! जब तुम तरह तरह की मुसीबतों से दो चार होते हो तो इसे बड़ी ख़ुशी की बात समझो, क्योंकि तुम जानते हो कि तुम्हारे ईमान का इम्तहान तुम्हारे अन्दर सब्र पैदा करता है। यह इबारत इशारा करता है कि याक़ूब की ख़त के क़ारिईन तरह तरह की आज़्मायशों का सामना कर रहे थे। याक़ूब ने अपने नाज़रीन व क़ारिईन से अर्ज़ किया कि वह ख़ुदा से समझ बूझ हासिल करें ताकि वह अपनी आज़्माइशों के दौरान भी ख़ुशी को अपनाए रखें। याक़ूब के क़ारिईन में से कुछ थे जो ईमान से बरगुश्ता हो चुके थे। और याक़ूब ने उन्हें ख़बरदार किया कि यह दुनिया से दोस्ती करने के बराबर है। (याक़ूब 4:4) याक़ूब ने ईमान्दारों की रहनुमाई की, (उन्हें) हिदायत दी कि ख़ुद को हलीम करे ताकि ख़ुदा (उन्हें) सही वक़्त पर सरफ़राज़ करे। उस ने सिखाया कि खुदा के हुज़ूर हलीमी एक हिकमत का रास्ता है (4:8-10)।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">असली ईमान।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. सलाम के अल्फ़ाज़ — 1:1-27</para>
  <para style="io1">2. असल मज़्हब पर याक़ूब के हिदायात — 2:1-3:12</para>
  <para style="io1">3. इख़ितियारी समझबूझ ख़ुदा की तरफ़ से आती है। — 3:13-5:20</para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="s">याकूब का सलाम</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>ख़ुदा के और ख़ुदावन्द 'ईसा मसीह के बन्दे या'क़ूब की तरफ़ से उन बारह ईमानदारों के क़बीलों को जो जगह — ब — जगह रहते हैं सलाम पहुँचे। <verse eid="JAS 1:1"/><verse number="2" style="v" sid="JAS 1:2"/>ऐ, मेरे भाइयों जब तुम तरह तरह की आज़माइशों में पड़ो। <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>तो इसको ये जान कर कमाल ख़ुशी की बात समझना कि तुम्हारे ईमान की आज़माइश सब्र पैदा करती है।<verse eid="JAS 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 1:4"/>और सब्र को अपना पूरा काम करने दो ताकि तुम पूरे और कामिल हो जाओ और तुम में किसी बात की कमी न रहे। <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>लेकिन अगर तुम में से किसी में हिक्मत की कमी हो तो ख़ुदा से माँगे जो बग़ैर मलामत किए सब को बहुतायत के साथ देता है। उसको दी जाएगी।<verse eid="JAS 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JAS 1:6"/>मगर ईमान से माँगे और कुछ शक न करे क्यूँकि शक करने वाला समुन्दर की लहरों की तरह होता है जो हवा से बहती और उछलती हैं। <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>ऐसा आदमी ये न समझे कि मुझे ख़ुदावन्द से कुछ मिलेगा। <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>वो शख़्स दो दिला है और अपनी सब बातों में बे'क़याम।<verse eid="JAS 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>अदना भाई अपने आ'ला मर्तबे पर फ़ख़्र करे। <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>और दौलतमन्द अपनी हलीमी हालत पर इसलिए कि घास के फ़ूलों की तरह जाता रहेगा। <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>क्यूँकि सूरज निकलते ही सख़्त धूप पड़ती और घास को सुखा देती है और उसका फ़ूल गिर जाता है और उसकी ख़ुबसूरती जाती रहती है इस तरह दौलतमन्द भी अपनी राह पर चलते चलते ख़ाक में मिल जाएगा।<verse eid="JAS 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>मुबारिक़ वो शख़्स है जो आज़माइश की बर्दाश्त करता है क्यूँकि जब मक़बूल ठहरा तो ज़िन्दगी का वो ताज<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">ज़िन्दगी का ताज — हमेशा की ज़िन्दगी है </char></note> हासिल करेगा जिसका ख़ुदावन्द ने अपने मुहब्बत करने वालों से वा'दा किया है <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>जब कोई आज़माया जाए तो ये न कहे कि मेरी आज़माइश ख़ुदा की तरफ़ से होती है क्यूँ कि न तो ख़ुदा बदी से आज़माया जा सकता है और न वो किसी को आज़माता है।<verse eid="JAS 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 1:14"/>हाँ हर शख़्स अपनी ही ख़्वाहिशों में खिंचकर और फ़ँस कर आज़माया जाता है। <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>फिर ख़्वाहिश हामिला हो कर गुनाह को पैदा करती है और गुनाह जब बढ़ गया तो मौत पैदा करता है। <verse eid="JAS 1:15"/><verse number="16" style="v" sid="JAS 1:16"/>ऐ, मेरे प्यारे भाइयों धोखा न खाना।<verse eid="JAS 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 1:17"/>हर अच्छी बख़्शिश और कामिल इनाम ऊपर से है और नूरों के बाप की तरफ़ से मिलता है जिस में न कोई तब्दीली हो सकती है और न गरदिश के वजह से उस पर साया पड़ता है। <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>उसने अपनी मर्ज़ी से हमें कलाम — ऐ — हक़ के वसीले से पैदा किया ताकि उसकी मुख़ालिफ़त में से हम एक तरह के फल हो।<verse eid="JAS 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ऐ, मेरे प्यारे भाइयों ये बात तुम जानते हो; पस हर आदमी सुनने में तेज़ और बोलने में धीमा और क़हर में धीमा हो। <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>क्यूँकि इंसान का क़हर ख़ुदा की रास्तबाज़ी का काम नहीं करता। <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>इसलिए सारी नजासत और बदी की गंदगी को दूर करके उस कलाम को नर्मदिल से क़ुबूल कर लो जो दिल में बोया गया और तुम्हारी रूहों को नजात दे सकता है।<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>लेकिन कलाम पर अमल करने वाले बनो, न महज़ सुनने वाले जो अपने आपको धोखा देते हैं। <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>क्यूँकि जो कोई कलाम का सुनने वाला हो और उस पर अमल करने वाला न हो वो उस शख़्स की तरह है जो अपनी क़ुदरती सूरत आइँना में देखता है। <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>इसलिए कि वो अपने आप को देख कर चला जाता और भूल जाता है कि मैं कैसा था। <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>लेकिन जो शख़्स आज़ादी की कामिल शरी'अत पर ग़ौर से नज़र करता रहता है वो अपने काम में इसलिए बर्क़त पाएगा कि सुनकर भूलता नहीं बल्कि अमल करता है।<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>अगर कोई अपने आपको दीनदार समझे और अपनी ज़बान को लगाम न दे बल्कि अपने दिल को धोखा दे तो उसकी दीनदारी बातिल है। <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>हमारे ख़ुदा और बाप के नज़दीक ख़ालिस और बेऐब दीनदारी ये है कि यतीमों और बेवाओं की मुसीबत के वक़्त उनकी ख़बर लें; और अपने आप को दुनिया से बे'दाग़ रखें।<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s">अफ़वाहों के ख़िलाफ़ खबरदार करना</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>ऐ, मेरे भाइयों; हमारे ख़ुदावन्द ज़ुल्जलाल 'ईसा मसीह का ईमान तुम पर तरफ़दारी के साथ न हो। <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>क्यूँकि अगर एक शख़्स तो सोने की अँगूठी और 'उम्दा पोशाक पहने हुए तुम्हारी जमाअत में आए और एक ग़रीब आदमी मैले कुचेले पहने हुए आए। <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>और तुम उस 'उम्दा पोशाक वाले का लिहाज़ कर के कहो तू यहाँ अच्छी जगह बैठ और उस ग़रीब शख़्स से कहो तू वहाँ खड़ा रह या मेरे पाँव की चौकी के पास बैठ। <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>तो क्या तुम ने आपस में तरफ़दारी न की और बद नियत मुन्सिफ़ न बने?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ऐ, मेरे प्यारे भाइयों सुनो; क्या ख़ुदा ने इस जहान के ग़रीबों को ईमान में दौलतमन्द और उस बादशाही के वारिस होने के लिए बरगुज़ीदा नहीं किया जिसका उसने अपने मुहब्बत करने वालों से वा'दा किया है। <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>लेकिन तुम ने ग़रीब आदमी की बे'इज़्ज़ती की; क्या दौलतमन्द तुम पर ज़ुल्म नहीं करते और वही तुम्हें आदालतों में घसीट कर नहीं ले जाते। <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>क्या वो उस बुज़ुर्ग नाम पर कुफ़्र नहीं बकते जिससे तुम नाम ज़द हो।<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>तोभी अगर तुम इस लिखे हुए के मुताबिक़ अपने पड़ोसी से अपनी तरह मुहब्बत रखो उस बादशाही शरी'अत को पूरा करते हो तो अच्छा करते हो। <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>लेकिन अगर तुम तरफ़दारी करते हो तो गुनाह करते हो और शरी'अत तुम को क़सूरवार ठहराती है<verse eid="JAS 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 2:10"/>क्यूँकि जिसने सारी शरी'अत पर अमल किया और एक ही बात में ख़ता की वो सब बातों में क़सूरवार ठहरा। <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>इसलिए कि जिसने ये फ़रमाया कि ज़िना न कर उसी ने ये भी फ़रमाया कि ख़ून न कर पस अगर तू ने ज़िना तो न किया मगर ख़ून किया तोभी तू शरी'अत का इन्कार करने वाला ठहरा।<verse eid="JAS 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 2:12"/>तुम उन लोगों की तरह कलाम भी करो और काम भी करो जिनका आज़ादी की शरी'अत के मुवाफ़िक़ इन्साफ़ होगा। <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>क्यूँकि जिसने रहम नहीं किया उसका इन्साफ़ बग़ैर रहम के होगा रहम इन्साफ़ पर ग़ालिब आता है।<verse eid="JAS 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>ऐ, मेरे भाइयों; अगर कोई कहे कि मैं ईमानदार हूँ मगर अमल न करता हो तो क्या फ़ाइदा? क्या ऐसा ईमान उसे नजात दे सकता है। <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>अगर कोई भाई या बहन नंगे हो और उनको रोज़ाना रोटी की कमी हो। <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>और तुम में से कोई उन से कहे कि सलामती के साथ जाओ गर्म और सेर रहो मगर जो चीज़ें तन के लिए ज़रूरी हैं वो उन्हें न दे तो क्या फ़ाइदा। <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>इसी तरह ईमान भी अगर उसके साथ आ'माल न हों तो अपनी ज़ात से मुर्दा है।<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>बल्कि कोई कह सकता है कि तू तो ईमानदार है और मैं अमल करने वाला हूँ अपना ईमान बग़ैर आ'माल के मुझे दिखा और मैं अपना ईमान आ'माल से तूझे दिखाऊँगा। <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>तू इस बात पर ईमान रखता है कि ख़ुदा एक ही है ख़ैर अच्छा करता है शियातीन भी ईमान रखते और थर थराते हैं। <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>मगर ऐ, निकम्मे आदमी क्या तू ये भी नहीं जानता कि ईमान बग़ैर आ'माल के बेकार है।<verse eid="JAS 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JAS 2:21"/>जब हमारे बाप अब्रहाम ने अपने बेटे इज़्हाक़ को क़ुर्बानगाह पर क़ुर्बान किया तो क्या वो आ'माल से रास्तबाज़ न ठहरा। <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>पस तूने देख लिया कि ईमान ने उसके आ'माल के साथ मिल कर असर किया और आ'माल से ईमान कामिल हुआ। <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>और ये लिखा पूरा हुआ कि अब्रहाम ख़ुदा पर ईमान लाया और ये उसके लिए रास्तबाज़ी गिना गया और वो ख़ुदा का दोस्त कहलाया। <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>पस तुम ने देख लिया के इंसान सिर्फ़ ईमान ही से नहीं बल्कि आ'माल से रास्तबाज़ ठहरता है।<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>इसी तरह राहब फ़ाहिशा भी जब उसने क़ासिदों को अपने घर में उतारा और दूसरे रास्ते से रुख़्सत किया तो क्या काम से रास्तबाज़ न ठहरी। <verse eid="JAS 2:25"/><verse number="26" style="v" sid="JAS 2:26"/>ग़रज़ जैसे बदन बग़ैर रूह के मुर्दा है वैसे ही ईमान भी बग़ैर आ'माल के मुर्दा है।<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s">ज़ुबान को सम्भाल कर रखना</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>ऐ, मेरे भाइयों; तुम में से बहुत से उस्ताद न बनें क्यूँकि जानते हो कि हम जो उस्ताद हैं ज़्यादा सज़ा पाएँगे। <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>इसलिए कि हम सब के सब अक्सर ख़ता करते हैं; कामिल शख़्स वो है जो बातों में ख़ता न करे वो सारे बदन को भी क़ाबू में रख सकता है;<verse eid="JAS 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JAS 3:3"/>देखो हम अपने क़ाबू में करने के लिए घोड़ों के मुँह में लगाम देते हैं तो उनके सारे बदन को भी घुमा सकते हैं। <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>और जहाज़ भी अगरचे बड़े बड़े होते हैं और तेज़ हवाओं से चलाए जाते हैं तोभी एक निहायत छोटी सी पतवार के ज़रिए माँझी की मर्ज़ी के मुवाफ़िक़ घुमाए जाते हैं।<verse eid="JAS 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 3:5"/>इसी तरह ज़बान भी एक छोटा सा 'उज़्व है और बड़ी शेख़ी मारती है। देखो थोड़ी सी आग से कितने बड़े जंगल में आग लग जाती है। <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>ज़बान भी एक आग है ज़बान हमारे आज़ा में शरारत का एक आ'लम है और सारे जिस्म को दाग़ लगाती है और दाइरा दुनिया को आग लगा देती है और जहन्नुम की आग से जलती रहती है।<verse eid="JAS 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7"/>क्यूँकि हर क़िस्म के चौपाए और परिन्दे और कीड़े मकोड़े और दरियाई जानवर तो इंसान के क़ाबू में आ सकते हैं और आए भी हैं। <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>मगर ज़बान को कोई क़ाबू में नहीं कर सकता वो एक बला है जो कभी रुकती ही नहीं ज़हर — ए — क़ातिल से भरी हुई है।<verse eid="JAS 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 3:9"/>इसी से हम ख़ुदावन्द अपने बाप की हम्द करते हैं और इसी से आदमियों को जो ख़ुदा की सूरत पर पैदा हुए हैं बद्दुआ देते हैं। <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>एक ही मुँह से मुबारिक़ बाद और बद्दुआ निकलती है! ऐ मेरे भाइयों; ऐसा न होना चाहिए।<verse eid="JAS 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 3:11"/>क्या चश्मे के एक ही मुँह से मीठा और खारा पानी निकलता है। <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>ऐ, मेरे भाइयों! क्या अंजीर के दरख़्त में ज़ैतून और अँगूर में अंजीर पैदा हो सकते हैं? इसी तरह खारे चश्मे से मीठा पानी नहीं निकल सकता।<verse eid="JAS 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>तुम में दाना और फ़हीम कौन है? जो ऐसा हो वो अपने कामों को नेक चाल चलन के वसीले से उस हलीमी के साथ ज़ाहिर करें जो हिक्मत से पैदा होता है। <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>लेकिन अगर तुम अपने दिल में सख़्त हसद और तफ़्रक़े रखते हो तो हक़ के ख़िलाफ़ न शेख़ी मारो न झूठ बोलो।<verse eid="JAS 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JAS 3:15"/>ये हिक्मत वो नहीं जो ऊपर से उतरती है बल्कि दुनियावी और नफ़सानी और शैतानी है। <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>इसलिए कि जहाँ हसद और तफ़्रक़ा होता है फ़साद और हर तरह का बुरा काम भी होता है। <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>मगर जो हिक्मत ऊपर से आती है अव्वल तो वो पाक होती है फिर मिलनसार नर्मदिल और तरबियत पज़ीर रहम और अच्छे फलों से लदी हुई बेतरफ़दार और बे — रिया होती है। <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>और सुलह करने वालों के लिए रास्तबाज़ी का फल सुलह के साथ बोया जाता है।<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s">ख़ुदा के करीब आना</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>तुम में लड़ाइयाँ और झगड़े कहाँ से आ गए? क्या उन ख़्वाहिशों से नहीं जो तुम्हारे आज़ा में फ़साद करती हैं। <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>तुम ख़्वाहिश करते हो, और तुम्हें मिलता नहीं, ख़ून और हसद करते हो और कुछ हासिल नहीं कर सकते; तुम लड़ते और झगड़ते हो। तुम्हें इसलिए नहीं मिलता कि माँगते नहीं। <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>तुम माँगते हो और पाते नहीं इसलिए कि बुरी नियत से माँगते हो: ताकि अपनी ऐश — ओ — अशरत में ख़र्च करो।<verse eid="JAS 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4"/>ऐ, नाफ़रमानी करने वालो क्या तुम्हें नहीं मा'लूम कि दुनिया से दोस्ती रखना ख़ुदा से दुश्मनी करना है? पस जो कोई दुनिया का दोस्त बनना चाहता है वो अपने आप को ख़ुदा का दुश्मन बनाता है। <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>क्या तुम ये समझते हो कि किताब — ऐ — मुक़द्दस बे'फ़ाइदा कहती है? जिस पाक रूह को उसने हमारे अन्दर बसाया है क्या वो ऐसी आरज़ू करती है जिसका अन्जाम हसद हो।<verse eid="JAS 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JAS 4:6"/>वो तो ज़्यादा तौफ़ीक़ बख़्शता है इसी लिए ये आया है कि ख़ुदा मग़रुरों का मुक़ाबिला करता है मगर फ़िरोतनों को तौफ़ीक़ बख़्शता है। <verse eid="JAS 4:6"/><verse number="7" style="v" sid="JAS 4:7"/>पस ख़ुदा के ताबे हो जाओ और इबलीस का मुक़ाबिला करो तो वो तुम से भाग जाएगा।<verse eid="JAS 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 4:8"/>ख़ुदा के नज़दीक जाओ तो वो तुम्हारे नज़दीक आएगा; ऐ, गुनाहगारो अपने हाथों को साफ़ करो और ऐ, दो दिलो अपने दिलों को पाक करो। <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>अफ़सोस करो और रोओ तुम्हारी हँसी मातम से बदल जाए और तुम्हारी ख़ुशी ऊदासी से। <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ख़ुदावन्द के सामने फ़िरोतनी करो, वो तुम्हें सरबलन्द करेगा।<verse eid="JAS 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>ऐ, भाइयों एक दूसरे की बुराई न करो जो अपने भाई की बुराई करता या भाई पर इल्ज़ाम लगाता है; वो शरी'अत की बुराई करता और शरी'अत पर इल्ज़ाम लगाता है और अगर तू शरी'अत पर इल्ज़ाम लगाता है तो शरी'अत पर अमल करने वाला नहीं बल्कि उस पर हाकिम ठहरा। <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>शरी'अत का देने वाला और हाकिम तो एक ही है जो बचाने और हलाक करने पर क़ादिर है तू कौन है जो अपने पड़ोसी पर इल्ज़ाम लगाता है।<verse eid="JAS 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>तुम जो ये कहते हो कि हम आज या कल फ़लाँ शहर में जा कर वहाँ एक बरस ठहरेंगे और सौदागरी करके नफ़ा उठाएँगे। <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>और ये जानते नहीं कि कल क्या होगा; ज़रा सुनो तो; तुम्हारी ज़िन्दगी चीज़ ही क्या है? बुख़ारात का सा हाल है अभी नज़र आए अभी ग़ायब हो गए।<verse eid="JAS 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JAS 4:15"/>यूँ कहने की जगह तुम्हें ये कहना चाहिए अगर ख़ुदावन्द चाहे तो हम ज़िन्दा भी रहेंगे और ये और वो काम भी करेंगे। <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>मगर अब तुम अपनी शेख़ी पर फ़ख़्र करते हो; ऐसा सब फ़ख़्र बुरा है। <verse eid="JAS 4:16"/><verse number="17" style="v" sid="JAS 4:17"/>पस जो कोई भलाई करना जानता है और नहीं करता उसके लिए ये गुनाह है।<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s">अमीरों को खबरदार करना</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>ऐ, दौलतमन्दों ज़रा सुनो; तुम अपनी मुसीबतों पर जो आने वाली हैं रोओ; और मातम करो; <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>तुम्हारा माल बिगड़ गया और तुम्हारी पोशाकों को कीड़ा खा गया। <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>तुम्हारे सोने चाँदी को ज़ँग लग गया और वो ज़ँग तुम पर गवाही देगा और आग की तरह तुम्हारा गोश्त खाएगा; तुम ने आख़िर ज़माने में ख़ज़ाना जमा किया है।<verse eid="JAS 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 5:4"/>देखो जिन मज़दूरों ने तुम्हारे खेत काटे उनकी वो मज़दूरी जो तुम ने धोखा करके रख छोड़ी चिल्लाती है और फ़सल काटने वालों की फ़रियाद रब्ब'उल अफ़्वाज के कानों तक पहुँच गई है। <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>तुम ने ज़मीन पर ऐश'ओ — अशरत की और मज़े उड़ाए तुम ने अपने दिलों को ज़बह के दिन मोटा ताज़ा किया। <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>तुम ने रास्तबाज़ शख़्स को क़ुसूरवार ठहराया और क़त्ल किया वो तुम्हारा मुक़ाबिला नहीं करता।<verse eid="JAS 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>पस, ऐ भाइयों; ख़ुदावन्द की आमद तक सब्र करो देखो किसान ज़मीन की क़ीमती पैदावार के इन्तज़ार में पहले और पिछले बारिश के बरसने तक सब्र करता रहता है। <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>तुम भी सब्र करो और अपने दिलों को मज़बूत रखो, क्यूँकि ख़ुदावन्द की आमद क़रीब है।<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>ऐ, भाइयों! एक दूसरे की शिकायत न करो ताकि तुम सज़ा न पाओ, देखो मुन्सिफ़ दरवाज़े पर खड़ा है। <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>ऐ, भाइयों! जिन नबियों ने ख़ुदावन्द के नाम से कलाम किया उनको दु:ख उठाने और सब्र करने का नमूना समझो। <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>देखो सब्र करने वालों को हम मुबारिक़ कहते हैं; तुम ने अय्यूब के सब्र का हाल तो सुना ही है और ख़ुदावन्द की तरफ़ से जो इसका अन्जाम हुआ उसे भी मा'लूम कर लिया जिससे ख़ुदावन्द का बहुत तरस और रहम ज़ाहिर होता है।<verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>मगर ऐ, मेरे भाइयों; सब से बढ़कर ये है क़सम न खाओ, न आसमान की न ज़मीन की न किसी और चीज़ की बल्कि हाँ की जगह हाँ करो और नहीं की जगह नहीं ताकि सज़ा के लायक़ न ठहरो।<verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>अगर तुम में कोई मुसीबत ज़दा हो तो दुआ करे, अगर ख़ुश हो तो हम्द के गीत गाए। <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>अगर तुम में कोई बीमार हो तो कलीसिया के बुज़ुर्गों को बुलाए और वो ख़ुदावन्द के नाम से उसको तेल मलकर उसके लिए दु:आ करें। <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>जो दु:आ ईमान के साथ होगी उसके ज़रिए बीमार बच जाएगा; और ख़ुदावन्द उसे उठा कर खड़ा करेगा, और अगर उसने गुनाह किए हों, तो उनकी भी मु'आफ़ी हो जाएगी।<verse eid="JAS 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 5:16"/>पस तुम आपस में एक दूसरे से अपने अपने गुनाहों का इक़रार करो और एक दूसरे के लिए दु:आ करो ताकि शिफ़ा पाओ रास्तबाज़ की दु:आ के असर से बहुत कुछ हो सकता है। <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>एलियाह हमारी तरह इंसान था, उसने बड़े जोश से दु:आ की कि पानी न बरसे, चुनाँचे साढ़े तीन बरस तक ज़मीन पर पानी न बरसा। <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>फिर उसी ने दु:आ की तो आसमान से पानी बरसा और ज़मीन में पैदावार हुई।<verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>ऐ, मेरे भाइयों! अगर तुम में कोई राहे हक़ से गुमराह हो जाए और कोई उसको वापस लाए। <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>तो वो ये जान ले कि जो कोई किसी गुनाहगार को उसकी गुमराही से फेर लाएगा; वो एक जान को मौत से बचा लेगा और बहुत से गुनाहों पर पर्दा डालेगा।<verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
