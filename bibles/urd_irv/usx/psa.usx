<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">ज़बूर</para>
  <para style="toc1">ज़बूर</para>
  <para style="toc2">ज़बूर</para>
  <para style="toc3">ज़बूर</para>
  <para style="mt">ज़बूर</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">ज़बूर की किताब शायराना अंदाज़ के गानों का एक मजमूआ है — ये पुराने अहदनामे की एक ऐसी किताब है जिस में मुख्तलिफ़ मुसन्निफों की मुरक्कब तसनीफ़ पाई जाती है — इस को मुख्तलिफ़ म्मुसंनिफों ने लिखा है जिन के नाम हैं: दाऊद जिसने 73 ज़बुरें लिखीं, आसफ ने 12, बनी क़ोरह ने 9, सुलैमान ने 3, इथान और मूसा ने एक एक ज़बूर लिखे — ज़बूर 90 और 51 एक जैसे ज़बूर हैं — सुलेमान और मूसा के ज़बुरों को छोड़ दीगर मुसन्निफों की ज़बुरों के लिए काहिनों और लावियों की ज़िम्मेदारी थी कि दाऊद के दौर — ए — हुकूमत में मकदिस में इबादत के दौरान खुदा की हम्द — ओ — सिताइश के लिए नाग्मसराई का इंतज़ाम करे।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इस किताब की तसनीफ़ की तारीख 1440 - 430 क़ब्ल मसीह के बीच है।</para>
  <para style="ip">मूसा के ज़माने की तारीख में शख्सी ज़बुर लिखे गए थे — दाऊद आसफ और सुलेमान के ज़माने से लेकर एज्रा कातिब के पीछे चलने वालों तक जो गालिबन बाबुल की बंधवाई के बाद रहते थे, मतलब ये कि ज़बूर की किताब की तसनीफ़ का अरसा एक हज़ार साल का है।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">बनी इस्राईल कौम जिन की याददाश्त के लिए कि खुदा ने उन के लिए क्या कुछ किया था और पूरी तारिख के ईमानदारों के लिए।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">ज़बूर की किताब कई एक मौज़ुआत को समझने में मदद करती है: जैसे खुदा और उसकी तखलीक, जंग, इबादत, हिकमत, बुराई, खुदा की अदालत, इंसाफ़ और मसीह की दुबारा आमद वगैरा — इस के कईएक सफ्हात इस के कारीईन को खुदा की हमद — ओ — सिताइश के लिए हौसला अफज़ाई करते हैं क्योंकि वह मौजूद है और उसने क्या कुछ किया है — ज़बूर की किताब हमारे खुदा की अजमत को चमकाता और मुसीबतों और तकलीफों के औक़ात में अपनी वफ़ादारी की तौसीक़ करता, और अपने कलाम की म्कामिल मरकज़ीयत को याद दिलाता है।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">हम्द — ओ — सिताइश।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. मसीहा की किताब — 1:1-41:13</para>
  <para style="io1">2. ख़ाहिश की किताब — 42:1-72:20</para>
  <para style="io1">3. बनी इस्राईल की किताब — 73:1-89:52</para>
  <para style="io1">4. खुदा के क़ानून की किताब — 90:1-106:48</para>
  <para style="io1">5. हम्द — ओ — सिताइश की किताब — 107:1-150:6</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">पहली किताब</para>
  <para style="mr">(<ref loc="PSA 1:-1-41">ज़बूर 1-41</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 1:1"/>मुबारक है वह आदमी जो शरीरों की सलाह पर नहीं चलता,</para>
  <para style="q" vid="PSA 1:1">और ख़ताकारों की राह में खड़ा नहीं होता;</para>
  <para style="q" vid="PSA 1:1">और ठट्ठा बाज़ों की महफ़िल में नहीं बैठता।<verse eid="PSA 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2"/>बल्कि ख़ुदावन्द की शरी'अत में ही उसकी ख़ुशी है;</para>
  <para style="q" vid="PSA 1:2">और उसी की शरी'अत पर दिन रात उसका ध्यान रहता है।<verse eid="PSA 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3"/>वह उस दरख़्त की तरह होगा, जो पानी की नदियों के पास लगाया गया है।</para>
  <para style="q" vid="PSA 1:3">जो अपने वक़्त पर फलता है, और जिसका पत्ता भी नहीं मुरझाता।</para>
  <para style="q" vid="PSA 1:3">इसलिए जो कुछ वह करे फलदार होगा।<verse eid="PSA 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 1:4"/>शरीर ऐसे नहीं, बल्कि वह भूसे की तरह हैं,</para>
  <para style="q" vid="PSA 1:4">जिसे हवा उड़ा ले जाती है।<verse eid="PSA 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5"/>इसलिए शरीर 'अदालत में क़ाईम न रहेंगे,</para>
  <para style="q" vid="PSA 1:5">न ख़ताकार सादिक़ों की जमा'अत में।<verse eid="PSA 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6"/>क्यूँकि ख़ुदावन्द सादिक़ो की राह जानता है</para>
  <para style="q" vid="PSA 1:6">लेकिन शरीरों की राह बर्बाद हो जाएगी।<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1"/>क़ौमें किस लिए ग़ुस्से में है</para>
  <para style="q" vid="PSA 2:1">और लोग क्यूँ बेकार ख़याल बाँधते हैं<verse eid="PSA 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2"/>ख़ुदावन्द और उसके मसीह के ख़िलाफ़ ज़मीन के बादशाह एक हो कर,</para>
  <para style="q" vid="PSA 2:2">और हाकिम आपस में मशवरा करके कहते हैं,<verse eid="PSA 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3"/>“आओ, हम उनके बन्धन तोड़ डालें,</para>
  <para style="q" vid="PSA 2:3">और उनकी रस्सियाँ अपने ऊपर से उतार फेंके।”<verse eid="PSA 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4"/>वह जो आसमान पर तख़्त नशीन है हँसेगा,</para>
  <para style="q" vid="PSA 2:4">ख़ुदावन्द उनका मज़ाक़ उड़ाएगा।<verse eid="PSA 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5"/>तब वह अपने ग़ज़ब में उनसे कलाम करेगा,</para>
  <para style="q" vid="PSA 2:5">और अपने ग़ज़बनाक ग़ुस्से में उनको परेशान कर देगा,<verse eid="PSA 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6"/>“मैं तो अपने बादशाह को,</para>
  <para style="q" vid="PSA 2:6">अपने पाक पहाड़ सिय्यून पर बिठा चुका हूँ।”<verse eid="PSA 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7"/>मैं उस फ़रमान को बयान करूँगा:ख़ुदावन्द ने मुझ से कहा,</para>
  <para style="q" vid="PSA 2:7">“तू मेरा बेटा है। आज तू मुझ से पैदा हुआ।<verse eid="PSA 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8"/>मुझ से माँग, और मैं क़ौमों को तेरी मीरास के लिए,</para>
  <para style="q" vid="PSA 2:8">और ज़मीन के आख़िरी हिस्से तेरी मिल्कियत के लिए तुझे बख़्शूँगा।<verse eid="PSA 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9"/>तू उनको लोहे के 'असा से तोड़ेगा,</para>
  <para style="q" vid="PSA 2:9">कुम्हार के बर्तन की तरह तू उनको चकनाचूर कर डालेगा।”<verse eid="PSA 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10"/>इसलिए अब ऐ बादशाहो,</para>
  <para style="q" vid="PSA 2:10">अक़्लमंद बनो; ऐ ज़मीन की 'अदालत करने वालो, तरबियत पाओ।<verse eid="PSA 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 2:11"/>डरते हुए ख़ुदावन्द की इबादत करो,</para>
  <para style="q" vid="PSA 2:11">काँपते हुए ख़ुशी मनाओ।<verse eid="PSA 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 2:12"/>बेटे को चूमो, ऐसा न हो कि वह क़हर में आए,</para>
  <para style="q" vid="PSA 2:12">और तुम रास्ते में हलाक हो जाओ,</para>
  <para style="q" vid="PSA 2:12">क्यूँकि उसका ग़ज़ब जल्द भड़कने को है।</para>
  <para style="q" vid="PSA 2:12">मुबारक हैं वह सब जिनका भरोसा उस पर है।<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="s">मुसीबत के वक्त आखरी भरोसा</para>
  <para style="d">दाऊद का ज़बूर जब वह अपने बेटे अबीसलोम के सामने से भागा गया था।</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 3:1"/>ऐ ख़ुदावन्द मेरे सताने वाले कितने बढ़ गए,</para>
  <para style="q" vid="PSA 3:1">वह जो मेरे ख़िलाफ़ उठते हैं बहुत हैं।<verse eid="PSA 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 3:2"/>बहुत से मेरी जान के बारे में कहते हैं,</para>
  <para style="q" vid="PSA 3:2">कि ख़ुदा की तरफ़ से उसकी मदद न होगी। सिलाह<verse eid="PSA 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 3:3"/>लेकिन तू ऐ ख़ुदावन्द, हर तरफ़ मेरी सिपर है।</para>
  <para style="q" vid="PSA 3:3">मेरा फ़ख़्र और सरफ़राज़ करने वाला।<verse eid="PSA 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 3:4"/>मैं बुलन्द आवाज़ से ख़ुदावन्द के सामने फ़रियाद करता हूँ</para>
  <para style="q" vid="PSA 3:4">और वह अपने पाक पहाड़ पर से मुझे जवाब देता है। सिलाह<verse eid="PSA 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 3:5"/>मैं लेट कर सो गया;</para>
  <para style="q" vid="PSA 3:5">मैं जाग उठा, क्यूँकि ख़ुदावन्द मुझे संभालता है।<verse eid="PSA 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 3:6"/>मैं उन दस हज़ार आदमियों से नहीं डरने का,</para>
  <para style="q" vid="PSA 3:6">जो चारों तरफ़ मेरे ख़िलाफ़ इकठ्ठा हैं।<verse eid="PSA 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 3:7"/>उठ ऐ ख़ुदावन्द, ऐ मेरे ख़ुदा, मुझे बचा ले!</para>
  <para style="q" vid="PSA 3:7">क्यूँकि तूने मेरे सब दुश्मनों को जबड़े पर मारा है। तूने शरीरों के दाँत तोड़ डाले हैं।<verse eid="PSA 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 3:8"/>नजात ख़ुदावन्द की तरफ़ से है।</para>
  <para style="q" vid="PSA 3:8">तेरे लोगों पर तेरी बरकत हो!<verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 4:1"/>जब मै पुकारूँ तो मुझे जबाब दे ऐ मेरी सदाक़त के ख़ुदा!</para>
  <para style="q" vid="PSA 4:1">तंगी में तूने मुझे कुशादगी बख़्शी, मुझ पर रहम कर और मेरी दुआ सुन ले।<verse eid="PSA 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 4:2"/>ऐ बनी आदम! कब तक मेरी 'इज़्ज़त के बदले रुस्वाई होगी?</para>
  <para style="q" vid="PSA 4:2">तुम कब तक बकवास से मुहब्बत रखोगे और झूट के दर पे रहोगे?<verse eid="PSA 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 4:3"/>जान लो कि ख़ुदावन्द ने दीनदार को अपने लिए अलग कर रखा है;</para>
  <para style="q" vid="PSA 4:3">जब मैं ख़ुदावन्द को पुकारूँगा तो वह सुन लेगा।<verse eid="PSA 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 4:4"/>थरथराओ और गुनाह न करो;</para>
  <para style="q" vid="PSA 4:4">अपने अपने बिस्तर पर दिल में सोचो और ख़ामोश रहो।<verse eid="PSA 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 4:5"/>सदाक़त की कु़र्बानियाँ पेश करो,</para>
  <para style="q" vid="PSA 4:5">और ख़ुदावन्द पर भरोसा करो।<verse eid="PSA 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 4:6"/>बहुत से कहते हैं कौन हम को कुछ भलाई दिखाएगा?</para>
  <para style="q" vid="PSA 4:6">ऐ ख़ुदावन्द तू अपने चेहरे का नूर हम पर जलवह गर फ़रमा।<verse eid="PSA 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 4:7"/>तूने मेरे दिल को उससे ज़्यादा खु़शी बख़्शी है,</para>
  <para style="q" vid="PSA 4:7">जो उनको ग़ल्ले और मय की बहुतायत से होती थी।<verse eid="PSA 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 4:8"/>मैं सलामती से लेट जाऊँगा और सो रहूँगाः क्यूँकि ऐ ख़ुदावन्द!</para>
  <para style="q" vid="PSA 4:8">सिर्फ़ तू ही मुझे मुत्मईन रखता है!<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 5:1"/>ऐ ख़ुदावन्द मेरी बातो पर कान लगा!</para>
  <para style="q" vid="PSA 5:1">मेरी आहों पर तवज्जुह कर!<verse eid="PSA 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 5:2"/>ऐ मेरे बादशाह! ऐ मेरे ख़ुदा! मेरी फ़रियाद की आवाज़ की तरफ़ मुतवज्जिह हो,</para>
  <para style="q" vid="PSA 5:2">क्यूँकि मैं तुझ ही से दुआ करता हूँ।<verse eid="PSA 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 5:3"/>ऐ ख़ुदावन्द तू सुबह को मेरी आवाज़ सुनेगा।</para>
  <para style="q" vid="PSA 5:3">मैं सवेरे ही तुझ से दुआ करके इन्तिज़ार करूँगा।<verse eid="PSA 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 5:4"/>क्यूँकि तू ऐसा ख़ुदा नहीं जो शरारत से खु़श हो।</para>
  <para style="q" vid="PSA 5:4">गुनाह तेरे साथ नहीं रह सकता।<verse eid="PSA 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 5:5"/>घमंडी तेरे सामने खड़े न होंगे।</para>
  <para style="q" vid="PSA 5:5">तुझे सब बदकिरदारों से नफ़रत है।<verse eid="PSA 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 5:6"/>तू उनको जो झूट बोलते हैं हलाक करेगा।</para>
  <para style="q" vid="PSA 5:6">ख़ुदावन्द को खू़ँख़्वार और दग़ाबाज़ आदमी से नफ़रत है।<verse eid="PSA 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 5:7"/>लेकिन मैं तेरी शफ़क़त की कसरत से तेरे घर में आऊँगा।</para>
  <para style="q" vid="PSA 5:7">मैं तेरा रौ'ब मानकर तेरी पाक हैकल की तरफ़ रुख़ करके सिज्दा करूँगा।<verse eid="PSA 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 5:8"/>ऐ ख़ुदावन्द! मेरे दुश्मनों की वजह से मुझे अपनी सदाक़त में चला;</para>
  <para style="q" vid="PSA 5:8">मेरे आगे आगे अपनी राह को साफ़ कर दे।<verse eid="PSA 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 5:9"/>क्यूँकि उनके मुँह में ज़रा सच्चाई नहीं, उनका बातिन सिर्फ़ बुराई है।</para>
  <para style="q" vid="PSA 5:9">उनका गला खुली क़ब्र है, वह अपनी ज़बान से ख़ुशामद करते हैं।<verse eid="PSA 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 5:10"/>ऐ ख़ुदा तू उनको मुजरिम ठहरा;</para>
  <para style="q" vid="PSA 5:10">वह अपने ही मश्वरों से तबाह हों।</para>
  <para style="q" vid="PSA 5:10">उनको उनके गुनाहों की ज़्यादती की वजह से ख़ारिज कर दे;</para>
  <para style="q" vid="PSA 5:10">क्यूँकि उन्होंने तुझ से बग़ावत की है।<verse eid="PSA 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 5:11"/>लेकिन वह सब जो तुझ पर भरोसा रखते हैं, शादमान हों,</para>
  <para style="q" vid="PSA 5:11">वह सदा ख़ुशी से ललकारें, क्यूँकि तू उनकी हिमायत करता है।</para>
  <para style="q" vid="PSA 5:11">और जो तेरे नाम से मुहब्बत रखते हैं, तुझ में ख़ुश रहें।<verse eid="PSA 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 5:12"/>क्यूँकि तू सादिक़ को बरकत बख़्शेगा।</para>
  <para style="q" vid="PSA 5:12">ऐ ख़ुदावन्द! तू उसे करम से ढाल की तरह ढाँक लेगा।<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 6:1"/>ऐ ख़ुदा तू मुझे अपने क़हर में न झिड़क,</para>
  <para style="q" vid="PSA 6:1">और अपने ग़ज़बनाक ग़ुस्से में मुझे तम्बीह न दे।<verse eid="PSA 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 6:2"/>ऐ ख़ुदावन्द, मुझ पर रहम कर, क्यूँकि मैं अधमरा हो गया हूँ।</para>
  <para style="q" vid="PSA 6:2">ऐ ख़ुदवन्द, मुझे शिफ़ा दे, क्यूँकि मेरी हडिडयों में बेक़रारी है।<verse eid="PSA 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 6:3"/>मेरी जान भी बहुत ही बेक़रार है;</para>
  <para style="q" vid="PSA 6:3">और तू ऐ ख़ुदावन्द, कब तक?<verse eid="PSA 6:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 6:4"/>लौट ऐ ख़ुदावन्द, मेरी जान को छुड़ा।</para>
  <para style="q" vid="PSA 6:4">अपनी शफ़क़त की ख़ातिर मुझे बचा ले।<verse eid="PSA 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 6:5"/>क्यूँकि मौत के बाद तेरी याद नहीं होती,</para>
  <para style="q" vid="PSA 6:5">क़ब्र में कौन तेरी शुक्रगुज़ारी करेगा?<verse eid="PSA 6:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 6:6"/>मैं कराहते कराहते थक गया,</para>
  <para style="q" vid="PSA 6:6">मैं अपना पलंग आँसुओं से भिगोता हूँ हर रात मेरा बिस्तर तैरता है।<verse eid="PSA 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 6:7"/>मेरी आँख ग़म के मारे बैठी जाती हैं,</para>
  <para style="q" vid="PSA 6:7">और मेरे सब मुख़ालिफ़ों की वजह से धुंधलाने लगीं।<verse eid="PSA 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 6:8"/>ऐ सब बदकिरदारो, मेरे पास से दूर हो;</para>
  <para style="q" vid="PSA 6:8">क्यूँकि ख़ुदावन्द ने मेरे रोने की आवाज़ सुन ली है।<verse eid="PSA 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 6:9"/>खूदावन्द ने मेरी मिन्नत सुन ली;</para>
  <para style="q" vid="PSA 6:9">ख़ुदावन्द मेरी दुआ क़ुबूल करेगा।<verse eid="PSA 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 6:10"/>मेरे सब दुश्मन शर्मिन्दा और बहुत ही बेक़रार होंगे;</para>
  <para style="q" vid="PSA 6:10">वह लौट जाएँगे, वह अचानक शर्मिन्दा होंगे।<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 7:1"/>ऐ ख़ुदावन्द मेरे ख़ुदा, मेरा भरोसा तुझ पर है;</para>
  <para style="q" vid="PSA 7:1">सब पीछा करने वालों से मुझे बचा और छुड़ा,<verse eid="PSA 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 7:2"/>ऐसा न हो कि वह शेर — ए — बबर की तरह मेरी जान को फाड़े;</para>
  <para style="q" vid="PSA 7:2">वह उसे टुकड़े टुकड़े कर दे और कोई छुड़ाने वाला न हो।<verse eid="PSA 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 7:3"/>ऐ ख़ुदावन्द मेरे ख़ुदा,</para>
  <para style="q" vid="PSA 7:3">अगर मैंने यह किया हो, अगर मेरे हाथों से बुराई हुई हो;<verse eid="PSA 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 7:4"/>अगर मैंने अपने मेल रखने वाले से भलाई के बदले बुराई की हो,</para>
  <para style="q" vid="PSA 7:4">बल्कि मैंने तो उसे जो नाहक़ मेरा मुखालिफ़ था, बचाया है;<verse eid="PSA 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 7:5"/>तो दुश्मन मेरी जान का पीछा करके उसे आ पकड़े,</para>
  <para style="q" vid="PSA 7:5">बल्कि वह मेरी ज़िन्दगी को बर्बाद करके मिट्टी में,</para>
  <para style="q" vid="PSA 7:5">और मेरी 'इज़्ज़त को ख़ाक में मिला दे। सिलाह<verse eid="PSA 7:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 7:6"/>ऐ ख़ुदावन्द, अपने क़हर में उठ;</para>
  <para style="q" vid="PSA 7:6">मेरे मुख़ालिफ़ों के ग़ज़ब के मुक़ाबिले में तू खड़ा हो जा;</para>
  <para style="q" vid="PSA 7:6">और मेरे लिए जाग! तूने इन्साफ़ का हुक्म तो दे दिया है।<verse eid="PSA 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 7:7"/>तेरे चारों तरफ़ क़ौमों का इजितमा'अ हो;</para>
  <para style="q" vid="PSA 7:7">और तू उनके ऊपर 'आलम — ए — बाला को लौट जा<verse eid="PSA 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 7:8"/>ख़ुदावन्द, क़ौमों का इन्साफ़ करता है;</para>
  <para style="q" vid="PSA 7:8">ऐ ख़ुदावन्द, उस सदाक़त — ओ — रास्ती के मुताबिक़ जो मुझ में है मेरी'अदालत कर।<verse eid="PSA 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 7:9"/>काश कि शरीरों की बदी का ख़ात्मा हो जाए,</para>
  <para style="q" vid="PSA 7:9">लेकिन सादिक़ को तू क़याम बख़्श;</para>
  <para style="q" vid="PSA 7:9">क्यूँकि ख़ुदा — ए — सादिक़ दिलों और गुर्दों को जाँचता है।<verse eid="PSA 7:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 7:10"/>मेरी ढाल ख़ुदा के हाथ में है,</para>
  <para style="q" vid="PSA 7:10">जो रास्त दिलों को बचाता है।<verse eid="PSA 7:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 7:11"/>ख़ुदा सादिक़ मुन्सिफ़ है,</para>
  <para style="q" vid="PSA 7:11">बल्कि ऐसा ख़ुदा जो हर रोज़ क़हर करता है।<verse eid="PSA 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 7:12"/>अगर आदमी बाज़ न आए तो वहअपनी तलवार तेज़ करेगा;</para>
  <para style="q" vid="PSA 7:12">उसने अपनी कमान पर चिल्ला चढ़ाकर उसे तैयार कर लिया है।<verse eid="PSA 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 7:13"/>उसने उसके लिए मौत के हथियार भी तैयार किए हैं;</para>
  <para style="q" vid="PSA 7:13">वह अपने तीरों को आतिशी बनाता है।<verse eid="PSA 7:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 7:14"/>देखो, उसे बुराई की पैदाइश का दर्द लगा है!</para>
  <para style="q" vid="PSA 7:14">बल्कि वह शरारत से फलदार हुआ और उससे झूट पैदा हुआ।<verse eid="PSA 7:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 7:15"/>उसने गढ़ा खोद कर उसे गहरा किया,</para>
  <para style="q" vid="PSA 7:15">और उस ख़न्दक में जो उसने बनाई थी ख़ुद गिरा।<verse eid="PSA 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 7:16"/>उसकी शरारत उल्टी उसी के सिर पर आएगी;</para>
  <para style="q" vid="PSA 7:16">उसका ज़ुल्म उसी की खोपड़ी पर नाज़िल होगा।<verse eid="PSA 7:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 7:17"/>ख़ुदावन्द की सदाक़त के मुताबिक़ मैं उसका शुक्र करूँगा,</para>
  <para style="q" vid="PSA 7:17">और ख़ुदावन्द ताला के नाम की तारीफ़ गाऊँगा।<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 8:1"/>ऐ ख़ुदावन्द हमारे रब तेरा नाम तमाम ज़मीन पर कैसा बुज़ु़र्ग़ है!</para>
  <para style="q" vid="PSA 8:1">तूने अपना जलाल आसमान पर क़ाईम किया है।<verse eid="PSA 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 8:2"/>तूने अपने मुखालिफ़ों की वजह से बच्चों और शीरख़्वारों के मुँह से कु़दरत को क़ाईम किया,</para>
  <para style="q" vid="PSA 8:2">ताकि तू दुश्मन और इन्तक़ाम लेने वाले को ख़ामोश कर दे।<verse eid="PSA 8:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 8:3"/>जब मैं तेरे आसमान पर जो तेरी दस्तकारी है,</para>
  <para style="q" vid="PSA 8:3">और चाँद और सितारों पर जिनको तूने मुक़र्रर किया, ग़ौर करता हूँ।<verse eid="PSA 8:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 8:4"/>तो फिर इंसान क्या है कि तू उसे याद रख्खे,</para>
  <para style="q" vid="PSA 8:4">और बनी आदम क्या है कि तू उसकी ख़बर ले?<verse eid="PSA 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 8:5"/>क्यूँकि तूने उसे ख़ुदा से कुछ ही कमतर बनाया है,</para>
  <para style="q" vid="PSA 8:5">और जलाल और शौकत से उसे ताजदार करता है।<verse eid="PSA 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 8:6"/>तूने उसे अपनी दस्तकारी पर इख़्तियार बख़्शा है;</para>
  <para style="q" vid="PSA 8:6">तूने सब कुछ उसके क़दमों के नीचे कर दिया है।<verse eid="PSA 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 8:7"/>सब भेड़ — बकरियाँ,</para>
  <para style="q" vid="PSA 8:7">गाय — बैल बल्कि सब जंगली जानवर<verse eid="PSA 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 8:8"/>हवा के परिन्दे और समन्दर की</para>
  <para style="q" vid="PSA 8:8">और जो कुछ समन्दरों के रास्ते में चलता फिरता है।<verse eid="PSA 8:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 8:9"/>ऐ ख़ुदावन्द, हमारे रब्ब!</para>
  <para style="q" vid="PSA 8:9">तेरा नाम पूरी ज़मीन पर कैसा बुज़ु़र्ग़ है!<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 9:1"/>मैं अपने पूरे दिल से ख़ुदावन्द की शुक्रगुज़ारी करूँगा;</para>
  <para style="q" vid="PSA 9:1">मैं तेरे सब 'अजीब कामों का बयान करूँगा।<verse eid="PSA 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 9:2"/>मैं तुझ में ख़ुशी मनाऊँगा और मसरूर हूँगा;</para>
  <para style="q" vid="PSA 9:2">ऐ हक़ता'ला, मैं तेरी सिताइश करूँगा।<verse eid="PSA 9:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 9:3"/>जब मेरे दुश्मन पीछे हटते हैं,</para>
  <para style="q" vid="PSA 9:3">तो तेरी हुजू़री की वजह से लग़ज़िश खाते और हलाक हो जाते हैं।<verse eid="PSA 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 9:4"/>क्यूँकि तूने मेरे हक़ की और मेरे मु'आमिले की ताईद की है।</para>
  <para style="q" vid="PSA 9:4">तूने तख़्त पर बैठकर सदाक़त से इन्साफ़ किया।<verse eid="PSA 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 9:5"/>तूने क़ौमों को झिड़का, तूने शरीरों को हलाक किया है;</para>
  <para style="q" vid="PSA 9:5">तूने उनका नाम हमेशा से हमेशा के लिए मिटा डाला है।<verse eid="PSA 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 9:6"/>दुश्मन ख़त्म हुए, वह हमेशा के लिए बर्बाद हो गए;</para>
  <para style="q" vid="PSA 9:6">और जिन शहरों को तूने ढा दिया, उनकी यादगार तक मिट गई।<verse eid="PSA 9:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 9:7"/>लेकिन ख़ुदावन्द हमेशा तक तख़्त नशीन है,</para>
  <para style="q" vid="PSA 9:7">उसने इन्साफ़ के लिए अपना तख़्त तैयार किया है;<verse eid="PSA 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 9:8"/>और वही सदाक़त से जहान की 'अदालत करेगा,</para>
  <para style="q" vid="PSA 9:8">और रास्ती से कौमों का इन्साफ़ करेगा।<verse eid="PSA 9:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 9:9"/>ख़ुदावन्द मज़लूमों के लिए ऊँचा बुर्ज होगा,</para>
  <para style="q" vid="PSA 9:9">मुसीबत के दिनों में ऊँचा बुर्ज।<verse eid="PSA 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 9:10"/>और वह जो तेरा नाम जानते हैं तुझ पर भरोसा करेंगे,</para>
  <para style="q" vid="PSA 9:10">क्यूँकि ऐ ख़ुदावन्द, तूने अपने चाहनें वालो को नहीं छोड़ा।<verse eid="PSA 9:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 9:11"/>ख़ुदावन्द की सिताइश करो, जो सिय्यूनमें रहता है!</para>
  <para style="q" vid="PSA 9:11">लोगों के बीच उसके कामों का बयान करो<verse eid="PSA 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 9:12"/>क्यूँकि खू़न का पूछताछ करने वाला उनको याद रखता है;</para>
  <para style="q" vid="PSA 9:12">वह ग़रीबों की फ़रियाद को नहीं भूलता।<verse eid="PSA 9:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 9:13"/>ऐ ख़ुदावन्द, मुझ पर रहम कर।</para>
  <para style="q" vid="PSA 9:13">तू जो मौत के फाटकों से मुझे उठाता है,</para>
  <para style="q" vid="PSA 9:13">मेरे उस दुख को देख जो मेरे नफ़रत करने वालों की तरफ़ से है।<verse eid="PSA 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 9:14"/>ताकि मैं तेरी कामिल सिताइश का इज़हार करूँ।</para>
  <para style="q" vid="PSA 9:14">सिय्यून की बेटी के फाटकों पर, मैं तेरी नजात से ख़ुश हूँगा<verse eid="PSA 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 9:15"/>क़ौमें खु़द उस गढ़े में गिरी हैं जिसे उन्होंने खोदा था;</para>
  <para style="q" vid="PSA 9:15">जो जाल उन्होंने लगाया था उसमें उन ही का पाँव फंसा।<verse eid="PSA 9:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 9:16"/>ख़ुदावन्द की शोहरत फैल गई, उसने इन्साफ़ किया है;</para>
  <para style="q" vid="PSA 9:16">शरीर अपने ही हाथ के कामों में फंस गया है। हरगायून, सिलाह<verse eid="PSA 9:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 9:17"/>शरीर पाताल में जाएँगे,</para>
  <para style="q" vid="PSA 9:17">या'नी वह सब क़ौमें जो ख़ुदा को भूल जाती हैं<verse eid="PSA 9:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 9:18"/>क्यूँकि ग़रीब सदा भूले बिसरे न रहेंगे,</para>
  <para style="q" vid="PSA 9:18">न ग़रीबों की उम्मीद हमेशा के लिए टूटेगी।<verse eid="PSA 9:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 9:19"/>उठ, ऐ ख़ुदावन्द! इंसान ग़ालिब न होने पाए।</para>
  <para style="q" vid="PSA 9:19">क़ौमों की 'अदालत तेरे सामने हो।<verse eid="PSA 9:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 9:20"/>ऐ ख़ुदावन्द! उनको ख़ौफ़ दिला।</para>
  <para style="q" vid="PSA 9:20">क़ौमें अपने आपको इंसान ही जानें।<verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1"/>ऐ ख़ुदावन्द तू क्यूँ दूर खड़ा रहता है?</para>
  <para style="q" vid="PSA 10:1">मुसीबत के वक़्त तू क्यूँ छिप जाता है?<verse eid="PSA 10:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2"/>शरीर के गु़रूर की वजह से ग़रीब का तेज़ी से पीछा किया जाता है;</para>
  <para style="q" vid="PSA 10:2">जो मन्सूबे उन्होंने बाँधे हैं, वह उन ही में गिरफ़्तार हो जाएँ।<verse eid="PSA 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3"/>क्यूँकि शरीर अपनी जिस्मानी ख़्वाहिश पर फ़ख़्र करता है,</para>
  <para style="q" vid="PSA 10:3">और लालची ख़ुदावन्द को छोड़ देता बल्कि उसकी नाक़द्री करता है।<verse eid="PSA 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4"/>शरीर अपने तकब्बुर में कहता है कि वह पूछताछ नहीं करेगा;</para>
  <para style="q" vid="PSA 10:4">उसका ख़याल सरासर यही है कि कोई ख़ुदा नहीं।<verse eid="PSA 10:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5"/>उसकी राहें हमेशा बराबर हैं,</para>
  <para style="q" vid="PSA 10:5">तेरे अहकाम उसकी नज़र से दूर — ओ — बुलन्द हैं;</para>
  <para style="q" vid="PSA 10:5">वह अपने सब मुख़ालिफ़ों पर फूंकारता है।<verse eid="PSA 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6"/>वह अपने दिल में कहता है, “मैं जुम्बिश नहीं खाने का;</para>
  <para style="q" vid="PSA 10:6">नसल दर नसल मुझ पर कभी मुसीबत न आएगी।”<verse eid="PSA 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7"/>उसका मुँह ला'नत — ओ — दग़ा और ज़ुल्म से भरा है;</para>
  <para style="q" vid="PSA 10:7">शरारत और बदी उसकी ज़बान पर हैं।<verse eid="PSA 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8"/>वह देहात की घातों में बैठता है,</para>
  <para style="q" vid="PSA 10:8">वह पोशीदा मक़ामों में बेगुनाह को क़त्ल करता है;</para>
  <para style="q" vid="PSA 10:8">उसकी आँखें बेकस की घात में लगी रहती हैं।<verse eid="PSA 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9"/>वह पोशीदा मक़ाम में शेर — ए — बबर की तरह दुबक कर बैठता है;</para>
  <para style="q" vid="PSA 10:9">वह ग़रीब को पकड़ने की घात लगाए रहता है;</para>
  <para style="q" vid="PSA 10:9">वह ग़रीब को अपने जाल में फंसा कर पकड़ लेता है।<verse eid="PSA 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10"/>वह दुबकता है, वह झुक जाता है;</para>
  <para style="q" vid="PSA 10:10">और बेकस उसके पहलवानों के हाथ से मारे जाते हैं।<verse eid="PSA 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11"/>वह अपने दिल में कहता है, “ख़ुदा भूल गया है, वह अपना मुँह छिपाता है;</para>
  <para style="q" vid="PSA 10:11">वह हरगिज़ नहीं देखेगा।”<verse eid="PSA 10:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12"/>उठ ऐ ख़ुदावन्द! ऐ ख़ुदा अपना हाथ बुलंद कर!</para>
  <para style="q" vid="PSA 10:12">ग़रीबों को न भूल।<verse eid="PSA 10:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13"/>शरीर किस लिए ख़ुदा की नाक़द्री करता है</para>
  <para style="q" vid="PSA 10:13">और अपने दिल में कहता है कि तू पूछताछ ना करेगा?<verse eid="PSA 10:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14"/>तूने देख लिया है क्यूँकि तू शरारत और बुग्ज़ देखता है ताकि अपने हाथ से बदला दे।</para>
  <para style="q" vid="PSA 10:14">बेकस अपने आप को तेरे सिपुर्द करता है तू ही यतीम का मददगार रहा है।<verse eid="PSA 10:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15"/>शरीर का बाज़ू तोड़ दे।</para>
  <para style="q" vid="PSA 10:15">और बदकार की शरारत को जब तक बर्बाद न हो ढूँढ़ — ढूँढ़ कर निकाल।<verse eid="PSA 10:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16"/>ख़ुदावन्द हमेशा से हमेशा बादशाह है।</para>
  <para style="q" vid="PSA 10:16">क़ौमें उसके मुल्क में से हलाक हो गयीं।<verse eid="PSA 10:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17"/>ऐ ख़ुदावन्द तूने हलीमों का मुद्दा'सुन लिया है</para>
  <para style="q" vid="PSA 10:17">तू उनके दिल को तैयार करेगा — तू कान लगा कर सुनेगा<verse eid="PSA 10:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18"/>कि यतीम और मज़लूम का इन्साफ़ करे</para>
  <para style="q" vid="PSA 10:18">ताकि इंसान जो ख़ाक से है फिर ना डराए।<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 11:1"/>मेरा भरोसा ख़ुदावन्द पर है तुम क्यूँकर मेरी जान से कहते हो कि चिड़िया की तरह अपने पहाड़ पर उड़ जा?<verse eid="PSA 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2"/>क्यूँकि देखो! शरीर कमान खींचते हैं वह तीर को चिल्ले पर रखते हैं ताकि अँधेरे में रास्त दिलों पर चलायें।<verse eid="PSA 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3"/>अगर बुनयाद ही उखाड़ दी जाये तो सादिक़ क्या कर सकता है।<verse eid="PSA 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4"/>ख़ुदावन्द अपनी पाक हैकल में है ख़ुदावन्द का तख़्त आसमान पर है। उसकी आँखें बनी आदम को देखती और उसकी पलकें उनको जाँचती हैं।<verse eid="PSA 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5"/>ख़ुदावन्द सादिक़ को परखता है लेकिन शरीर और ज़ुल्म को पसन्द करने वाले से उसकी रूह को नफ़रत है<verse eid="PSA 11:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6"/>वह शरीरों पर फंदे बरसायेगा आग और गंधक और लू उनके प्याले का हिस्सा होगा।<verse eid="PSA 11:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7"/>क्यूँकि ख़ुदावन्द सादिक़ है वह सच्चाई को पसंद करता है रास्त बाज़ उसका दीदार हासिल करेंगे।<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 12:1"/>ऐ ख़ुदावन्द! बचा ले क्यूँकि कोई दीनदार नहीं रहा</para>
  <para style="q" vid="PSA 12:1">और अमानत दार लोग बनी आदम में से मिट गये।<verse eid="PSA 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 12:2"/>वह अपने अपने पड़ोसी से झूठ बोलते हैं</para>
  <para style="q" vid="PSA 12:2">वह ख़ुशामदी लबों से दो रंगी बातें करते हैं<verse eid="PSA 12:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 12:3"/>ख़ुदावन्द सब ख़ुशामदी लबों को</para>
  <para style="q" vid="PSA 12:3">और बड़े बोल बोलने वाली ज़बान को काट डालेगा।<verse eid="PSA 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 12:4"/>वह कहते हैं, “हम अपनी ज़बान से जीतेंगे,</para>
  <para style="q" vid="PSA 12:4">हमारे होंट हमारे ही हैं; हमारा मालिक कौन है?”<verse eid="PSA 12:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 12:5"/>ग़रीबों की तबाही और ग़रीबों कीआह की वजह से,</para>
  <para style="q" vid="PSA 12:5">ख़ुदावन्द फ़रमाता है, कि अब मैं उठूँगा</para>
  <para style="q" vid="PSA 12:5">और जिस पर वह फुंकारते हैं उसे अम्न — ओ — अमान में रख्खूँगा।<verse eid="PSA 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 12:6"/>ख़ुदावन्द का कलाम पाक है,</para>
  <para style="q" vid="PSA 12:6">उस चाँदी की तरह जो भट्टी में मिट्टी पर ताई गई,</para>
  <para style="q" vid="PSA 12:6">और सात बार साफ़ की गई हो।<verse eid="PSA 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 12:7"/>तू ही ऐ ख़ुदावन्द उनकी हिफ़ाज़त करेगा,</para>
  <para style="q" vid="PSA 12:7">तू ही उनको इस नसल से हमेशा तक बचाए रखेगा।<verse eid="PSA 12:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 12:8"/>जब बनी आदम में पाजीपन की क़द्र होती है,</para>
  <para style="q" vid="PSA 12:8">तो शरीर हर तरफ़ चलते फिरते हैं।<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 13:1"/>ऐ ख़ुदावन्द, कब तक? क्या तू हमेशा मुझे भूला रहेगा?</para>
  <para style="q" vid="PSA 13:1">तू कब तक अपना चेहरा मुझ से छिपाए रख्खेगा?<verse eid="PSA 13:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 13:2"/>कब तक मैं जी ही जी में मन्सूबा बाँधता रहूँ,</para>
  <para style="q" vid="PSA 13:2">और सारे दिन अपने दिल में ग़म किया करू?</para>
  <para style="q" vid="PSA 13:2">कब तक मेरा दुश्मन मुझ पर सर बुलन्द रहेगा?<verse eid="PSA 13:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 13:3"/>ऐ ख़ुदावन्द मेरे ख़ुदा, मेरी तरफ़ तवज्जुह कर और मुझे जवाब दे।</para>
  <para style="q" vid="PSA 13:3">मेरी आँखे रोशन कर, ऐसा न हो कि मुझे मौत की नींद आ जाए<verse eid="PSA 13:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 13:4"/>ऐसा न हो कि मेरा दुश्मन कहे,</para>
  <para style="q" vid="PSA 13:4">कि मैं इस पर ग़ालिब आ गया। ऐसा न हो कि जब मैं जुम्बिश खाऊँ तो मेरे मुखालिफ़ ख़ुश हों।<verse eid="PSA 13:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 13:5"/>लेकिन मैंने तो तेरी रहमत पर भरोसा किया है;</para>
  <para style="q" vid="PSA 13:5">मेरा दिल तेरी नजात से खु़श होगा।<verse eid="PSA 13:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 13:6"/>मैं ख़ुदावन्द का हम्द गाऊँगा</para>
  <para style="q" vid="PSA 13:6">क्यूँकि उसने मुझ पर एहसान किया है।<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 14:1"/>बेवकू़फ़ ने अपने दिल में कहा है, कि कोई ख़ुदा नहीं। वह बिगड़ गए,</para>
  <para style="q" vid="PSA 14:1">उन्होंने नफ़रतअंगेज़ काम किए हैं;</para>
  <para style="q" vid="PSA 14:1">कोई नेकोकार नहीं।<verse eid="PSA 14:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2"/>ख़ुदावन्द ने आसमान पर से बनी आदम पर निगाह की ताकि देखे कि कोई अक़्लमन्द,</para>
  <para style="q" vid="PSA 14:2">कोई ख़ुदा का तालिब है या नहीं।<verse eid="PSA 14:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3"/>वह सब के सब गुमराह हुए, वह एक साथ नापाक हो गए,</para>
  <para style="q" vid="PSA 14:3">कोई नेकोकार नहीं, एक भी नहीं।<verse eid="PSA 14:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4"/>क्या उन सब बदकिरदारों को कुछ'इल्म नहीं,</para>
  <para style="q" vid="PSA 14:4">जो मेरे लोगों को ऐसे खा जाते हैं जैसे रोटी,</para>
  <para style="q" vid="PSA 14:4">और ख़ुदावन्द का नाम नहीं लेते?<verse eid="PSA 14:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5"/>वहाँ उन पर बड़ा ख़ौफ़ छा गया,</para>
  <para style="q" vid="PSA 14:5">क्यूँकि ख़ुदा सादिक़ नसल के साथ है।<verse eid="PSA 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6"/>तुम ग़रीब की मश्वरत की हँसी उड़ाते हो;</para>
  <para style="q" vid="PSA 14:6">इसलिए के ख़ुदावन्द उसकी पनाह है।<verse eid="PSA 14:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7"/>काश कि इस्राईल की नजात सिय्यून में से होती!</para>
  <para style="q" vid="PSA 14:7">जब ख़ुदावन्द अपने लोगों को ग़ुलामी से लौटा लाएगा,</para>
  <para style="q" vid="PSA 14:7">तो या'क़ूब ख़ुश और इस्राईल शादमान होगा।<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 15:1"/>ऐ ख़ुदावन्द तेरे ख़ेमे में कौन रहेगा?</para>
  <para style="q" vid="PSA 15:1">तेरे पाक पहाड़ पर कौन सुकूनत करेगा?<verse eid="PSA 15:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2"/>वह जो रास्ती से चलता और सदाक़त का काम करता,</para>
  <para style="q" vid="PSA 15:2">और दिल से सच बोलता है।<verse eid="PSA 15:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3"/>वह जो अपनी ज़बान से बुहतान नहीं बांधता,</para>
  <para style="q" vid="PSA 15:3">और अपने दोस्त से बदी नहीं करता,</para>
  <para style="q" vid="PSA 15:3">और अपने पड़ोसी की बदनामी नहीं सुनता।<verse eid="PSA 15:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4"/>वह जिसकी नज़र में रज़ील आदमी हक़ीर है,</para>
  <para style="q" vid="PSA 15:4">लेकिन जो ख़ुदावन्द से डरते हैं उनकी 'इज़्ज़त करता है;</para>
  <para style="q" vid="PSA 15:4">वह जो क़सम खाकर बदलता नहीं चाहे नुक़्सान ही उठाए।<verse eid="PSA 15:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5"/>वह जो अपना रुपया सूद पर नहीं देता,</para>
  <para style="q" vid="PSA 15:5">और बेगुनाह के ख़िलाफ़ रिश्वत नहीं लेता।</para>
  <para style="q" vid="PSA 15:5">ऐसे काम करने वाला कभी जुम्बिश न खाएगा।<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 16:1"/>ऐ ख़ुदा मेरी हिफ़ाज़त कर,</para>
  <para style="q" vid="PSA 16:1">क्यूँकि मैं तुझ ही में पनाह लेता हूँ।<verse eid="PSA 16:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2"/>मैंने ख़ुदावन्द से कहा</para>
  <para style="q" vid="PSA 16:2">“तू ही रब है तेरे अलावा मेरी भलाई नहीं।”<verse eid="PSA 16:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3"/>ज़मीन के पाक लोग वह बरगुज़ीदा हैं,</para>
  <para style="q" vid="PSA 16:3">जिनमें मेरी पूरी ख़ुशनूदी है।<verse eid="PSA 16:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4"/>गै़र मा'बूदों के पीछे दौड़ने वालों का ग़म बढ़ जाएगा;</para>
  <para style="q" vid="PSA 16:4">मैं उनके से खू़न वाले तपावन नहीं तपाऊँगा और अपने होटों से उनके नाम नहीं लूँगा।<verse eid="PSA 16:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5"/>ख़ुदावन्द ही मेरी मीरास और मेरे प्याले का हिस्सा है;</para>
  <para style="q" vid="PSA 16:5">तू मेरे बख़रे का मुहाफ़िज़ है।<verse eid="PSA 16:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6"/>जरीब मेरे लिए दिलपसंद जगहों में पड़ी,</para>
  <para style="q" vid="PSA 16:6">बल्कि मेरी मीरास खू़ब है।<verse eid="PSA 16:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7"/>मैं ख़ुदावन्द की हम्द करूँगा,</para>
  <para style="q" vid="PSA 16:7">जिसने, मुझे नसीहत दी है;</para>
  <para style="q" vid="PSA 16:7">बल्कि मेरा दिल रात को मेरी तरबियत करता है<verse eid="PSA 16:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8"/>मैंने ख़ुदावन्द को हमेशा अपने सामने रख्खा है;</para>
  <para style="q" vid="PSA 16:8">चूँकि वह मेरे दहने हाथ है,</para>
  <para style="q" vid="PSA 16:8">इसलिए मुझे जुम्बिश न होगी।<verse eid="PSA 16:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9"/>इसी वजह से मेरा दिल खु़श और मेरी रूह शादमान है;</para>
  <para style="q" vid="PSA 16:9">मेरा जिस्म भी अम्न — ओ — अमान में रहेगा।<verse eid="PSA 16:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10"/>क्यूँकि तू न मेरी जान को पाताल में रहने देगा,</para>
  <para style="q" vid="PSA 16:10">न अपने मुक़द्दस को सड़ने देगा।<verse eid="PSA 16:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11"/>तू मुझे ज़िन्दगी की राह दिखाएगा;</para>
  <para style="q" vid="PSA 16:11">तेरे हुज़ूरमें कामिल शादमानी है।</para>
  <para style="q" vid="PSA 16:11">तेरे दहने हाथ में हमेशा की खु़शी है।<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 17:1"/>ऐ ख़ुदावन्द, हक़ को सुन, मेरी फ़रियाद पर तवज्जुह कर।</para>
  <para style="q" vid="PSA 17:1">मेरी दुआ पर, जो दिखावे के होंटों से निकलती है कान लगा।<verse eid="PSA 17:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2"/>मेरा फ़ैसला तेरे सामने से ज़ाहिर हो!</para>
  <para style="q" vid="PSA 17:2">तेरी आँखें रास्ती को देखें!<verse eid="PSA 17:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3"/>तूने मेरे दिल को आज़मा लिया है, तूने रात को मेरी निगरानी की;</para>
  <para style="q" vid="PSA 17:3">तूने मुझे परखा और कुछ खोट न पाया,</para>
  <para style="q" vid="PSA 17:3">मैंने ठान लिया है कि मेरा मुँह ख़ता न करे।<verse eid="PSA 17:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4"/>इंसानी कामों में तेरे लबों के कलाम की मदद से</para>
  <para style="q" vid="PSA 17:4">मैं ज़ालिमों की राहों से बाज़ रहा हूँ।<verse eid="PSA 17:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5"/>मेरे कदम तेरे रास्तों पर क़ाईम रहे हैं,</para>
  <para style="q" vid="PSA 17:5">मेरे पाँव फिसले नहीं।<verse eid="PSA 17:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6"/>ऐ ख़ुदा, मैंने तुझ से दुआ की है क्यूँकि तू मुझे जवाब देगा।</para>
  <para style="q" vid="PSA 17:6">मेरी तरफ़ कान झुका और मेरी 'अर्ज़ सुन ले।<verse eid="PSA 17:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7"/>तू जो अपने दहने हाथ से अपने भरोसा करने वालों को उनके मुखालिफ़ों से बचाता है,</para>
  <para style="q" vid="PSA 17:7">अपनी'अजीब शफ़क़त दिखा।<verse eid="PSA 17:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8"/>मुझे आँख की पुतली की तरह महफूज़ रख;</para>
  <para style="q" vid="PSA 17:8">मुझे अपने परों के साये में छिपा ले,<verse eid="PSA 17:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9"/>उन शरीरों से जो मुझ पर ज़ुल्म करते हैं,</para>
  <para style="q" vid="PSA 17:9">मेरे जानी दुश्मनों से जो मुझे घेरे हुए हैं।<verse eid="PSA 17:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10"/>उन्होंने अपने दिलों को सख़्त किया है;</para>
  <para style="q" vid="PSA 17:10">वह अपने मुँह से बड़ा बोल बोलते हैं।<verse eid="PSA 17:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11"/>उन्होंने कदम कदम पर हम को घेरा है;</para>
  <para style="q" vid="PSA 17:11">वह ताक लगाए हैं कि हम को ज़मीन पर पटक दें।<verse eid="PSA 17:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12"/>वह उस बबर की तरह है जो फाड़ने पर लालची हो,</para>
  <para style="q" vid="PSA 17:12">वह जैसे जवान बबर है जो पोशीदा जगहों में दुबका हुआ है।<verse eid="PSA 17:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13"/>उठ, ऐ ख़ुदावन्द! उसका सामना कर,</para>
  <para style="q" vid="PSA 17:13">उसे पटक दे! अपनी तलवार से मेरी जान को शरीर से बचा ले।<verse eid="PSA 17:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14"/>अपने हाथ से ऐ ख़ुदावन्द! मुझे लोगों से बचा। या'नी दुनिया के लोगों से,</para>
  <para style="q" vid="PSA 17:14">जिनका बख़रा इसी ज़िन्दगी में है, और जिनका पेट तू अपने ज़ख़ीरे से भरता है।</para>
  <para style="q" vid="PSA 17:14">उनकी औलाद भी हस्ब — ए — मुराद है;</para>
  <para style="q" vid="PSA 17:14">वह अपना बाक़ी माल अपने बच्चों के लिए छोड़ जाते हैं<verse eid="PSA 17:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15"/>लेकिन मैं तो सदाक़त में तेरा दीदार हासिल करूँगा;</para>
  <para style="q" vid="PSA 17:15">मैं जब जागूँगा तो तेरी शबाहत से सेर हूँगा।<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 18:1"/>ऐ ख़ुदावन्द, ऐ मेरी ताक़त!</para>
  <para style="q" vid="PSA 18:1">मैं तुझसे मुहब्बत रखता हूँ।<verse eid="PSA 18:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 18:2"/>ख़ुदावन्द मेरी चट्टान, और मेरा किला और मेरा छुड़ाने वाला है;</para>
  <para style="q" vid="PSA 18:2">मेरा ख़ुदा, मेरी चट्टान जिस पर मैं भरोसा रखूँगा,</para>
  <para style="q" vid="PSA 18:2">मेरी ढाल और मेरी नजात का सींग, मेरा ऊँचा बुर्ज।<verse eid="PSA 18:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 18:3"/>मैं ख़ुदावन्द को, जो सिताइश के लायक़ है पुकारूँगा।</para>
  <para style="q" vid="PSA 18:3">यूँ मैं अपने दुश्मनों से बचाया जाऊँगा।<verse eid="PSA 18:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 18:4"/>मौत की रस्सियों ने मुझे घेर लिया,</para>
  <para style="q" vid="PSA 18:4">और बेदीनी के सैलाबों ने मुझे डराया;<verse eid="PSA 18:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 18:5"/>पाताल की रस्सियाँ मेरे चारों तरफ़ थीं,</para>
  <para style="q" vid="PSA 18:5">मौत के फंदे मुझ पर आ पड़े थे।<verse eid="PSA 18:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 18:6"/>अपनी मुसीबत में मैंने ख़ुदावन्द को पुकाराः और अपने ख़ुदा से फ़रियाद की;</para>
  <para style="q" vid="PSA 18:6">उसने अपनी हैकल में से मेरी आवाज़ सुनी,</para>
  <para style="q" vid="PSA 18:6">और मेरी फ़रियाद जो उसके सामने थी,</para>
  <para style="q" vid="PSA 18:6">उसके कान में पहुँची।<verse eid="PSA 18:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 18:7"/>तब ज़मीन हिल गई और कॉप उठी,</para>
  <para style="q" vid="PSA 18:7">पहाड़ों की बुनियादों ने जुम्बिश खाई और हिल गई,</para>
  <para style="q" vid="PSA 18:7">इसलिए कि वह ग़ज़बनाक हुआ।<verse eid="PSA 18:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 18:8"/>उसके नथनों से धुवाँ उठा,</para>
  <para style="q" vid="PSA 18:8">और उसके मुँह से आग निकलकर भसम करने लगी;</para>
  <para style="q" vid="PSA 18:8">कोयले उससे दहक उठे।<verse eid="PSA 18:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 18:9"/>उसने आसमानों को भी झुका दिया और नीचे उतर आया;</para>
  <para style="q" vid="PSA 18:9">और उसके पाँव तले गहरी तारीकी थी।<verse eid="PSA 18:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 18:10"/>वह करूबी पर सवार होकर उड़ा,</para>
  <para style="q" vid="PSA 18:10">बल्कि वह तेज़ी से हवा के बाजू़ओं पर उड़ा।<verse eid="PSA 18:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 18:11"/>उसने ज़ुल्मत या'नी बादल की तारीकी</para>
  <para style="q" vid="PSA 18:11">और आसमान के दलदार बादलों को अपने चारों तरफ़अपने छिपने की जगह</para>
  <para style="q" vid="PSA 18:11">और अपना शामियाना बनाया।<verse eid="PSA 18:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 18:12"/>उसकी हुज़ूरी की झलक से उसके दलदार बादल फट गए,</para>
  <para style="q" vid="PSA 18:12">ओले और अंगारे।<verse eid="PSA 18:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 18:13"/>और ख़ुदावन्द आसमान में गरजा,</para>
  <para style="q" vid="PSA 18:13">हक़ ता'ला ने अपनी आवाज़ सुनाई,</para>
  <para style="q" vid="PSA 18:13">ओले और अंगारे।<verse eid="PSA 18:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 18:14"/>उसने अपने तीर चलाकर उनको तितर बितर किया,</para>
  <para style="q" vid="PSA 18:14">बल्कि ताबड़ तोड़ बिजली से उनको शिकस्त दी।<verse eid="PSA 18:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 18:15"/>तब तेरी डाँट से ऐ ख़ुदावन्द!</para>
  <para style="q" vid="PSA 18:15">तेरे नथनों के दम के झोंके से,</para>
  <para style="q" vid="PSA 18:15">पानी की थाह दिखाई देने लगीऔर जहान की बुनियादें नमूदार हुई।<verse eid="PSA 18:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 18:16"/>उसने ऊपर से हाथ बढ़ाकर मुझे थाम लिया,</para>
  <para style="q" vid="PSA 18:16">और मुझे बहुत पानी में से खींचकर बाहर निकाला।<verse eid="PSA 18:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 18:17"/>उसने मेरे ताक़तवर दुश्मन और मेरे'अदावत रखने वालों से मुझे छुड़ा लिया,</para>
  <para style="q" vid="PSA 18:17">क्यूँकि वह मेरे लिए बहुत ही ज़बरदस्त थे।<verse eid="PSA 18:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 18:18"/>वह मेरी मुसीबत के दिन मुझ पर आ पड़े;</para>
  <para style="q" vid="PSA 18:18">लेकिन ख़ुदावन्द मेरा सहारा था।<verse eid="PSA 18:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 18:19"/>वह मुझे कुशादा जगह में निकाल भी लाया।</para>
  <para style="q" vid="PSA 18:19">उसने मुझे छुड़ाया, इसलिए कि वह मुझ से ख़ुश था।<verse eid="PSA 18:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 18:20"/>ख़ुदावन्द ने मेरी रास्ती के मुवाफ़िक़ मुझे बदला दिया:</para>
  <para style="q" vid="PSA 18:20">और मेरे हाथों की पाकीज़गी के मुताबिक़ मुझे बदला दिया।<verse eid="PSA 18:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 18:21"/>क्यूँकि मैं ख़ुदावन्द की राहों पर चलता रहा,</para>
  <para style="q" vid="PSA 18:21">और शरारत से अपने ख़ुदा से अलग न हुआ।<verse eid="PSA 18:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 18:22"/>क्यूँकि उसके सब फ़ैसले मेरे सामने रहे,</para>
  <para style="q" vid="PSA 18:22">और मैं उसके आईन से नाफ़रमान न हुआ।<verse eid="PSA 18:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 18:23"/>मैं उसके सामने कामिल भी रहा,</para>
  <para style="q" vid="PSA 18:23">और अपने को अपनी बदकारी से रोके रख्खा।<verse eid="PSA 18:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 18:24"/>ख़ुदावन्द ने मुझे मेरी रास्ती के मुवाफ़िक़</para>
  <para style="q" vid="PSA 18:24">और मेरे हाथों की पाकीज़गी के मुताबिक़ जो उसके सामने थी बदला दिया।<verse eid="PSA 18:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 18:25"/>रहम दिल के साथ तू रहीम होगा,</para>
  <para style="q" vid="PSA 18:25">और कामिल आदमी के साथ कामिल।<verse eid="PSA 18:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 18:26"/>नेकोकार के साथ नेक होगा,</para>
  <para style="q" vid="PSA 18:26">और कजरों के साथ टेढ़ा।<verse eid="PSA 18:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 18:27"/>क्यूँकि तू मुसीबत ज़दा लोगों को बचाएगा;</para>
  <para style="q" vid="PSA 18:27">लेकिन मग़रूरों की आँखों को नीचा करेगा।<verse eid="PSA 18:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 18:28"/>इसलिए के तू मेरे चराग़ को रौशन करेगा:</para>
  <para style="q" vid="PSA 18:28">ख़ुदावन्द मेरा ख़ुदा मेरे अंधेरे को उजाला कर देगा।<verse eid="PSA 18:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 18:29"/>क्यूँकि तेरी बदौलत मैं फ़ौज पर धावा करता हूँ।</para>
  <para style="q" vid="PSA 18:29">और अपने ख़ुदा की बदौलत दीवार फाँद जाता हूँ।<verse eid="PSA 18:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 18:30"/>लेकिन ख़ुदा की राह कामिल है;</para>
  <para style="q" vid="PSA 18:30">ख़ुदावन्द का कलाम ताया हुआ है;</para>
  <para style="q" vid="PSA 18:30">वह उन सबकी ढाल है जो उस पर भरोसा रखते हैं।<verse eid="PSA 18:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 18:31"/>क्यूँकि ख़ुदावन्द के अलावा और कौन ख़ुदा है?</para>
  <para style="q" vid="PSA 18:31">और हमारे ख़ुदा को छोड़कर और कौन चट्टान है?<verse eid="PSA 18:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 18:32"/>ख़ुदा ही मुझे ताक़त से कमर बस्ता करता है,</para>
  <para style="q" vid="PSA 18:32">और मेरी राह को कामिल करता है।<verse eid="PSA 18:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 18:33"/>वही मेरे पाँव हिरनीयों के से बना देता है,</para>
  <para style="q" vid="PSA 18:33">और मुझे मेरी ऊँची जगहों में क़ाईम करता है।<verse eid="PSA 18:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 18:34"/>वह मेरे हाथों को जंग करना सिखाता है,</para>
  <para style="q" vid="PSA 18:34">यहाँ तक कि मेरे बाजू़ पीतल की कमान को झुका देते हैं।<verse eid="PSA 18:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 18:35"/>तूने मुझ को अपनी नजात की ढाल बख़्शी,</para>
  <para style="q" vid="PSA 18:35">और तेरे दहने हाथ ने मुझे संभाला, और तेरी नमी ने मुझे बुज़ूर्ग बनाया है।<verse eid="PSA 18:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 18:36"/>तूने मेरे नीचे, मेरे क़दम कुशादा कर दिए;</para>
  <para style="q" vid="PSA 18:36">और मेरे पाँव नहीं फिसले।<verse eid="PSA 18:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 18:37"/>मैं अपने दुश्मनों का पीछा करके उनको जा लूँगा;</para>
  <para style="q" vid="PSA 18:37">और जब तक वह फ़ना न हो जाएँ, वापस नहीं आऊँगा।<verse eid="PSA 18:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 18:38"/>मैं उनको ऐसा छेदुँगा कि वह उठ न सकेंगे;</para>
  <para style="q" vid="PSA 18:38">वह मेरे पाँव के नीचे गिर पड़ेंगे।<verse eid="PSA 18:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 18:39"/>क्यूँकि तूने लड़ाई के लिए मुझे ताक़त से कमरबस्ता किया;</para>
  <para style="q" vid="PSA 18:39">और मेरे मुख़ालिफ़ों को मेरे सामने नीचा दिखाया।<verse eid="PSA 18:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 18:40"/>तूने मेरे दुश्मनों की नसल मेरी तरफ़ फेर दी,</para>
  <para style="q" vid="PSA 18:40">ताकि मैं अपने 'अदावत रखने वालों को काट डालूँ।<verse eid="PSA 18:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 18:41"/>उन्होंने दुहाई दी लेकिन कोई न था जो बचाए,</para>
  <para style="q" vid="PSA 18:41">ख़ुदावन्द को भी पुकारा लेकिन उसने उनको जवाब न दिया।<verse eid="PSA 18:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 18:42"/>तब मैंने उनको कूट कूट कर हवा में उड़ती हुई गर्द की तरह कर दिया;</para>
  <para style="q" vid="PSA 18:42">मैंने उनको गली कूचों की कीचड़ की तरह निकाल फेंका<verse eid="PSA 18:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 18:43"/>तूने मुझे क़ौम के झगड़ों से भी छुड़ाया;</para>
  <para style="q" vid="PSA 18:43">तूने मुझे क़ौमों का सरदार बनाया है;</para>
  <para style="q" vid="PSA 18:43">जिस क़ौम से मैं वाक़िफ़ भी नहीं वह मेरी फ़र्माबरदार होगी।<verse eid="PSA 18:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 18:44"/>मेरा नाम सुनते ही वह मेरी फ़रमाबरदारी करेंगे;</para>
  <para style="q" vid="PSA 18:44">परदेसी मेरे ताबे' हो जाएँगे।<verse eid="PSA 18:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 18:45"/>परदेसी मुरझा जाएँगे,</para>
  <para style="q" vid="PSA 18:45">और अपने क़िले' से थरथराते हुए निकलेंगे।<verse eid="PSA 18:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 18:46"/>ख़ुदावन्द ज़िन्दा है! मेरी चट्टान मुबारक हो,</para>
  <para style="q" vid="PSA 18:46">और मेरा नजात देने वाला ख़ुदा मुम्ताज़ हो।<verse eid="PSA 18:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 18:47"/>वही ख़ुदा जो मेरा इन्तक़ाम लेता है;</para>
  <para style="q" vid="PSA 18:47">और उम्मतों को मेरे सामने नीचा करता है।<verse eid="PSA 18:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 18:48"/>वह मुझे मेरे दुश्मनों से छुड़ाता है;</para>
  <para style="q" vid="PSA 18:48">बल्कि तू मुझे मेरे मुख़ालिफ़ों पर सरफ़राज़ करता है।</para>
  <para style="q" vid="PSA 18:48">तू मुझे टेढ़े आदमी से रिहाई देता है।<verse eid="PSA 18:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 18:49"/>इसलिए ऐ ख़ुदावन्द! मैं क़ौमों के बीच तेरी शुक्रगुज़ारी,</para>
  <para style="q" vid="PSA 18:49">और तेरे नाम की मदहसराई करूँगा।<verse eid="PSA 18:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 18:50"/>वह अपने बादशाह को बड़ी नजात 'इनायत करता है,</para>
  <para style="q" vid="PSA 18:50">और अपने मम्सूह दाऊद</para>
  <para style="q" vid="PSA 18:50">और उसकी नसल पर हमेशा शफ़क़त करता है।<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 19:1"/>आसमान ख़ुदा का जलाल ज़ाहिर करता है;</para>
  <para style="q" vid="PSA 19:1">और फ़ज़ा उसकी दस्तकारी दिखाती है।<verse eid="PSA 19:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 19:2"/>दिन से दिन बात करता है,</para>
  <para style="q" vid="PSA 19:2">और रात को रात हिकमत सिखाती है।<verse eid="PSA 19:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 19:3"/>न बोलना है न कलाम,</para>
  <para style="q" vid="PSA 19:3">न उनकी आवाज़ सुनाई देती है।<verse eid="PSA 19:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 19:4"/>उनका सुर सारी ज़मीन पर,</para>
  <para style="q" vid="PSA 19:4">और उनका कलाम दुनिया की इन्तिहा तक पहुँचा है।</para>
  <para style="q" vid="PSA 19:4">उसने आफ़ताब के लिए उनमें ख़ेमा लगाया है।<verse eid="PSA 19:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 19:5"/>जो दुल्हे की तरह अपने ख़िलवतख़ाने से निकलता है।</para>
  <para style="q" vid="PSA 19:5">और पहलवान की तरह अपनी दौड़ में दौड़ने को खु़श है।<verse eid="PSA 19:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 19:6"/>वह आसमान की इन्तिहा से निकलता है,</para>
  <para style="q" vid="PSA 19:6">और उसकी गश्त उसके किनारों तक होती है;</para>
  <para style="q" vid="PSA 19:6">और उसकी हरारत से कोई चीज़ बे बहरा नहीं।<verse eid="PSA 19:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 19:7"/>ख़ुदावन्द की शरी'अत कामिल है,</para>
  <para style="q" vid="PSA 19:7">वह जान को बहाल करती है;</para>
  <para style="q" vid="PSA 19:7">ख़ुदावन्द कि शहादत बरहक़ है नादान को दानिश बख़्शती है।<verse eid="PSA 19:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 19:8"/>ख़ुदावन्द के क़वानीन रास्त हैं,</para>
  <para style="q" vid="PSA 19:8">वह दिल को फ़रहत पहुँचाते हैं;</para>
  <para style="q" vid="PSA 19:8">ख़ुदावन्द का हुक्म बे'ऐब है, वह आँखों की रौशन करता है।<verse eid="PSA 19:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 19:9"/>ख़ुदावन्द का ख़ौफ़ पाक है, वह अबद तक क़ाईम रहता है;</para>
  <para style="q" vid="PSA 19:9">ख़ुदावन्द के अहकाम बरहक़ और बिल्कुल रास्त हैं।<verse eid="PSA 19:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 19:10"/>वह सोने से बल्कि बहुत कुन्दन से ज़्यादा पसंदीदा हैं;</para>
  <para style="q" vid="PSA 19:10">वह शहद से बल्कि छत्ते के टपकों से भी शीरीन हैं।<verse eid="PSA 19:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 19:11"/>नीज़ उन से तेरे बन्दे को आगाही मिलती है;</para>
  <para style="q" vid="PSA 19:11">उनको मानने का अज्र बड़ा है।<verse eid="PSA 19:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 19:12"/>कौन अपनी भूलचूक को जान सकता है?</para>
  <para style="q" vid="PSA 19:12">तू मुझे पोशीदा 'ऐबों से पाक कर।<verse eid="PSA 19:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 19:13"/>तू अपने बंदे को बे — बाकी के गुनाहों से भी बाज़ रख;</para>
  <para style="q" vid="PSA 19:13">वह मुझ पर ग़ालिब न आएँ तो मैं कामिल हूँगा, और बड़े गुनाह से बचा रहूँगा।<verse eid="PSA 19:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 19:14"/>मेरे मुँह का कलाम और मेरे दिल का ख़याल तेरे सामने मक़्बूल ठहरे;</para>
  <para style="q" vid="PSA 19:14">ऐ ख़ुदावन्द! ऐ मेरी चट्टान और मेरे फ़िदिया देने वाले!<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 20:1"/>मुसीबत के दिन ख़ुदावन्द तेरी सुने।</para>
  <para style="q" vid="PSA 20:1">या'क़ूब के ख़ुदा का नाम तुझे बुलन्दी पर क़ाईम करे!<verse eid="PSA 20:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 20:2"/>वह मक़दिस से तेरे लिए मदद भेजे,</para>
  <para style="q" vid="PSA 20:2">और सिय्यून से तुझे क़ुव्वत बख़्शे!<verse eid="PSA 20:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 20:3"/>वह तेरे सब हदियों को याद रख्खे,</para>
  <para style="q" vid="PSA 20:3">और तेरी सोख़्तनी क़ुर्बानी को क़ुबूल करे! सिलाह<verse eid="PSA 20:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 20:4"/>वह तेरे दिल की आरज़ू पूरी करे,</para>
  <para style="q" vid="PSA 20:4">और तेरी सब मश्वरत पूरी करे!<verse eid="PSA 20:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 20:5"/>हम तेरी नजात पर ख़ुशी मनाएंगे,</para>
  <para style="q" vid="PSA 20:5">और अपने ख़ुदा के नाम पर झंडे खड़े करेंगे।</para>
  <para style="q" vid="PSA 20:5">ख़ुदावन्द तेरी तमाम दरख़्वास्तें पूरी करे!<verse eid="PSA 20:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 20:6"/>अब मैं जान गया कि ख़ुदावन्द अपने मम्सूह को बचा लेता है;</para>
  <para style="q" vid="PSA 20:6">वह अपने दहने हाथ की नजात बख़्श ताक़त से अपने पाक आसमान पर से उसे जवाब देगा।<verse eid="PSA 20:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 20:7"/>किसी को रथों का और किसी को घोड़ों का भरोसा है,</para>
  <para style="q" vid="PSA 20:7">लेकिन हम तो ख़ुदावन्द अपने ख़ुदा ही का नाम लेंगे।<verse eid="PSA 20:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 20:8"/>वह तो झुके और गिर पड़े;</para>
  <para style="q" vid="PSA 20:8">लेकिन हम उठे और सीधे खड़े हैं।<verse eid="PSA 20:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 20:9"/>ऐ ख़ुदावन्द! बचा ले;</para>
  <para style="q" vid="PSA 20:9">जिस दिन हम पुकारें, तो बादशाह हमें जवाब दे।<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 21:1"/>ऐ ख़ुदावन्द! तेरी ताक़त से बादशाह खु़श होगा;</para>
  <para style="q" vid="PSA 21:1">और तेरी नजात से उसे बहुत ख़ुशी होगी।<verse eid="PSA 21:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 21:2"/>तूने उसके दिल की आरज़ू पूरी की है,</para>
  <para style="q" vid="PSA 21:2">और उसके मुँह की दरख़्वास्त को नामंजूर नहीं किया। सिलाह;<verse eid="PSA 21:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 21:3"/>क्यूँकि तू उसे 'उम्दा बरकतें बख़्शने में पेश कदमी करता,</para>
  <para style="q" vid="PSA 21:3">और ख़ालिस सोने का ताज उसके सिर पर रखता है।<verse eid="PSA 21:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 21:4"/>उसने तुझ से ज़िन्दगी चाही और तूने बख़्शी;</para>
  <para style="q" vid="PSA 21:4">बल्कि उम्र की दराज़ी हमेशा के लिए।<verse eid="PSA 21:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 21:5"/>तेरी नजात की वजह से उसकी शौकत 'अज़ीम है;</para>
  <para style="q" vid="PSA 21:5">तू उसे हश्मत — ओ — जलाल से आरास्ता करता है।<verse eid="PSA 21:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 21:6"/>क्यूँकि तू हमेशा के लिए उसे बरकतों से मालामाल करता है;</para>
  <para style="q" vid="PSA 21:6">और अपने सामने उसे ख़ुश — ओ — ख़ुर्रम रखता है।<verse eid="PSA 21:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 21:7"/>क्यूँकि बादशाह का भरोसा ख़ुदावन्द पर है;</para>
  <para style="q" vid="PSA 21:7">और हक़ता'ला की शफ़क़त की बदौलत उसे हरगिज़ जुम्बिश न होगी।<verse eid="PSA 21:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 21:8"/>तेरा हाथ तेरे सब दुश्मनों को ढूंड निकालेगा,</para>
  <para style="q" vid="PSA 21:8">तेरा दहना हाथ तुझ से कीना रखने वालों का पता लगा लेगा।<verse eid="PSA 21:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 21:9"/>तू अपने क़हर के वक़्त उनको जलते तनूर की तरह कर देगा।</para>
  <para style="q" vid="PSA 21:9">ख़ुदावन्द अपने ग़ज़ब में उनको निगल जाएगा,</para>
  <para style="q" vid="PSA 21:9">और आग उनको खा जाएगी।<verse eid="PSA 21:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 21:10"/>तू उनके फल को ज़मीन पर से बर्बाद कर देगा,</para>
  <para style="q" vid="PSA 21:10">और उनकी नसल को बनी आदम में से।<verse eid="PSA 21:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 21:11"/>क्यूँकि उन्होंने तुझ से बदी करना चाहा,</para>
  <para style="q" vid="PSA 21:11">उन्होंने ऐसा मन्सूबा बाँधा जिसे वह पूरा नहीं कर सकते।<verse eid="PSA 21:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 21:12"/>क्यूँकि तू उनका मुँह फेर देगा,</para>
  <para style="q" vid="PSA 21:12">तू उनके मुक़ाबले में अपने चिल्ले चढ़ाएगा।<verse eid="PSA 21:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 21:13"/>ऐ ख़ुदावन्द, तू अपनी ही ताक़त में सरबुलन्द हो!</para>
  <para style="q" vid="PSA 21:13">और हम गाकर तेरी क़ुदरत की सिताइश करेंगे।<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 22:1"/>ऐ मेरे ख़ुदा! ऐ मेरे ख़ुदा! तूने मुझे क्यूँ छोड़ दिया?</para>
  <para style="q" vid="PSA 22:1">तू मेरी मदद और मेरे नाला — ओ — फ़रियाद से क्यूँ दूर रहता है?<verse eid="PSA 22:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 22:2"/>ऐ मेरे ख़ुदा! मै दिन को पुकारता हूँ लेकिन तू जवाब नहीं देता</para>
  <para style="q" vid="PSA 22:2">और रात को भी और ख़ामोश नहीं होता।<verse eid="PSA 22:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 22:3"/>लेकिन तू पाक है</para>
  <para style="q" vid="PSA 22:3">तू जो इस्राईल के हम्दो — ओ — सना पर तख़्तनशीन है।<verse eid="PSA 22:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 22:4"/>हमारे बाप दादा ने तुझ पर भरोसा किया;</para>
  <para style="q" vid="PSA 22:4">उन्होंने भरोसा किया और तूने उसको छुड़ाया।<verse eid="PSA 22:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 22:5"/>उन्होंने तुझ से फ़रियाद की और रिहाई पाई;</para>
  <para style="q" vid="PSA 22:5">उन्होंने तुझ पर भरोसा किया और शर्मिंदा न हुए।<verse eid="PSA 22:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 22:6"/>लेकिन मै तो कीड़ा हूँ, इंसान नहीं;</para>
  <para style="q" vid="PSA 22:6">आदमियों में अन्गुश्तनुमा हूँ और लोगों में हक़ीर।<verse eid="PSA 22:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 22:7"/>वह सब जो मुझे देखते हैं, मेरा मज़ाक़ उड़ाते हैं;</para>
  <para style="q" vid="PSA 22:7">वह मुँह चिड़ाते, वह सर हिलाकर कहते हैं,<verse eid="PSA 22:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 22:8"/>“अपने को ख़ुदावन्द के सुपुर्द कर दे वही उसे छुड़ाए,</para>
  <para style="q" vid="PSA 22:8">जब कि वह उससे ख़ुश है तो वही उसे छुड़ाए।”<verse eid="PSA 22:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 22:9"/>लेकिन तु ही मुझे पेट से बहार लाया;</para>
  <para style="q" vid="PSA 22:9">जब मैं छोटा बच्चा ही था, तूने मुझे भरोसा करना सिखाया।<verse eid="PSA 22:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 22:10"/>मैं पैदाइश ही से तुझ पर छोड़ा गया, मेरी माँ के पेट ही से तू मेरा ख़ुदा है।<verse eid="PSA 22:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 22:11"/>मुझ से दूर न रह क्यूँकि मुसीबत क़रीब है, इसलिए कि कोई मददगार नहीं।<verse eid="PSA 22:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 22:12"/>बहुत से साँडों ने मुझे घेर लिया है, बसन के ताक़तवर साँड मुझे घेरे हुए हैं।<verse eid="PSA 22:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 22:13"/>वह फाड़ने और गरजने वाले बबर की तरह मुझ पर अपना मूंह पसारे हुए हैं।<verse eid="PSA 22:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 22:14"/>मैं पानी की तरह बह गया मेरी सब हड्डियाँ उखड़ गईं।</para>
  <para style="q" vid="PSA 22:14">मेरा दिल मोम की तरह हो गया,</para>
  <para style="q" vid="PSA 22:14">वह मेरे सीने में पिघल गया।<verse eid="PSA 22:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 22:15"/>मेरी ताक़त ठीकरे की तरह ख़ुश्क हो गई,</para>
  <para style="q" vid="PSA 22:15">और मेरी ज़बान मेरे तालू से चिपक गई;</para>
  <para style="q" vid="PSA 22:15">और तूने मुझे मौत की ख़ाक में मिला दिया।<verse eid="PSA 22:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 22:16"/>क्यूँकि कुत्तो ने मुझे घेर लिया है;</para>
  <para style="q" vid="PSA 22:16">बदकारो की गिरोह मुझे घेरे हुए है;</para>
  <para style="q" vid="PSA 22:16">वह हाथ और मेरे पाँव छेदते हैं।<verse eid="PSA 22:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 22:17"/>मैं अपनी सब हड्डियाँ गिन सकता हूँ;</para>
  <para style="q" vid="PSA 22:17">वह मुझे ताकते और घूरते हैं।<verse eid="PSA 22:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 22:18"/>वह मेरे कपड़े आपस में बाँटते हैं,</para>
  <para style="q" vid="PSA 22:18">और मेरी पोशाक पर पर्ची डालते हैं।<verse eid="PSA 22:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 22:19"/>लेकिन तू ऐ ख़ुदावन्द, दूर न रह!</para>
  <para style="q" vid="PSA 22:19">ऐ मेरे चारासाज़, मेरी मदद के लिए जल्दी कर!<verse eid="PSA 22:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 22:20"/>मेरी जान को तलवार से बचा,</para>
  <para style="q" vid="PSA 22:20">मेरी जान को कुत्ते के क़ाबू से।<verse eid="PSA 22:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 22:21"/>मुझे बबर के मुँह से बचा,</para>
  <para style="q" vid="PSA 22:21">बल्कि तूने साँडों के सींगों में से मुझे छुड़ाया है।<verse eid="PSA 22:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 22:22"/>मैं अपने भाइयों से तेरे नाम का इज़हार करूँगा;</para>
  <para style="q" vid="PSA 22:22">जमा'अत में तेरी सिताइश करूँगा।<verse eid="PSA 22:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 22:23"/>ऐ ख़ुदावन्द से डरने वालों, उसकी सिताइश करो!</para>
  <para style="q" vid="PSA 22:23">ऐ या'क़ूब की औलाद, सब उसकी तम्जीद करो!</para>
  <para style="q" vid="PSA 22:23">और ऐ इस्राईल की नसल, सब उसका डर मानो!<verse eid="PSA 22:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 22:24"/>क्यूँकि उसने न तो मुसीबत ज़दा की मुसीबत को हक़ीर जाना न उससे नफ़रत की,</para>
  <para style="q" vid="PSA 22:24">न उससे अपना मुँह छिपाया;</para>
  <para style="q" vid="PSA 22:24">बल्कि जब उसने ख़ुदा से फ़रियाद की तो उसने सुन ली।<verse eid="PSA 22:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 22:25"/>बड़े मजमे' में मेरी सना ख़्वानी का जरिया' तू ही है;</para>
  <para style="q" vid="PSA 22:25">मैं उस से डरने वालों के सामने अपनी नज़्रे अदा करूँगा।<verse eid="PSA 22:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 22:26"/>हलीम खाएँगे और सेर होंगे;</para>
  <para style="q" vid="PSA 22:26">ख़ुदावन्द के तालिब उसकी सिताइश करेंगे।</para>
  <para style="q" vid="PSA 22:26">तुम्हारा दिल हमेशा तक ज़िन्दा रहे।<verse eid="PSA 22:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 22:27"/>सारी दुनिया ख़ुदावन्द को याद करेगी</para>
  <para style="q" vid="PSA 22:27">और उसकी तरफ़ रूजू' लाएगी;</para>
  <para style="q" vid="PSA 22:27">और क़ौमों के सब घराने तेरे सामने सिज्दा करेंगे।<verse eid="PSA 22:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 22:28"/>क्यूँकि सल्तनत ख़ुदावन्द की है,</para>
  <para style="q" vid="PSA 22:28">वही क़ौमों पर हाकिम है।<verse eid="PSA 22:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 22:29"/>दुनिया के सब आसूदा हाल लोग खाएँगे और सिज्दा करेंगे;</para>
  <para style="q" vid="PSA 22:29">वह सब जो ख़ाक में मिल जाते हैं उसके सामने झुकेंगे,</para>
  <para style="q" vid="PSA 22:29">बल्कि वह भी जो अपनी जान को ज़िन्दा नहीं रख सकता।<verse eid="PSA 22:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 22:30"/>एक नसल उसकी बन्दगी करेगी;</para>
  <para style="q" vid="PSA 22:30">दूसरी नसल को ख़ुदावन्द की ख़बर दी जाएगी।<verse eid="PSA 22:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 22:31"/>वह आएँगे और उसकी सदाक़त को एक क़ौम पर जो पैदा होगी</para>
  <para style="q" vid="PSA 22:31">यह कहकर ज़ाहिर करेंगे कि उसने यह काम किया है।<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 23:1"/>ख़ुदावन्द मेरा चौपान है,</para>
  <para style="q" vid="PSA 23:1">मुझे कमी न होगी।<verse eid="PSA 23:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2"/>वह मुझे हरी हरी चरागाहों में बिठाता है;</para>
  <para style="q" vid="PSA 23:2">वह मुझे राहत के चश्मों के पास ले जाता है;<verse eid="PSA 23:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3"/>वह मेरी जान को बहाल करता है।</para>
  <para style="q" vid="PSA 23:3">वह मुझे अपने नाम की ख़ातिर सदाकत की राहों पर ले चलता है।<verse eid="PSA 23:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4"/>बल्कि चाहे मौत के साये की वादी में से मेरा गुज़र हो,</para>
  <para style="q" vid="PSA 23:4">मैं किसी बला से नहीं डरूंगा, क्यूँकि तू मेरे साथ है;</para>
  <para style="q" vid="PSA 23:4">तेरे 'असा और तेरी लाठी से मुझे तसल्ली है।<verse eid="PSA 23:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5"/>तू मेरे दुश्मनों के सामने मेरे आगे दस्तरख़्वान बिछाता है;</para>
  <para style="q" vid="PSA 23:5">तूने मेरे सिर पर तेल मला है, मेरा प्याला लबरेज़ होता है।<verse eid="PSA 23:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6"/>यक़ीनन भलाई और रहमत उम्र भर मेरे साथ साथ रहेंगी:</para>
  <para style="q" vid="PSA 23:6">और मैं हमेशा ख़ुदावन्द के घर में सकूनत करूँगा।<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 24:1"/>ज़मीन और उसकी मा'मुरी ख़ुदावन्द ही की है,</para>
  <para style="q" vid="PSA 24:1">जहान और उसके बाशिन्दे भी।<verse eid="PSA 24:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2"/>क्यूँकि उसने समन्दरों पर उसकी बुनियाद रख्खी</para>
  <para style="q" vid="PSA 24:2">और सैलाबों पर उसे क़ाईम किया।<verse eid="PSA 24:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3"/>ख़ुदावन्द के पहाड़ पर कौन चढ़ेगा?</para>
  <para style="q" vid="PSA 24:3">और उसके पाक मक़ाम पर कौन खड़ा होगा?<verse eid="PSA 24:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4"/>वही जिसके हाथ साफ़ हैं और जिसका दिल पाक है,</para>
  <para style="q" vid="PSA 24:4">जिसने बकवास पर दिल नहीं लगाया,</para>
  <para style="q" vid="PSA 24:4">और मक्र से क़सम नहीं खाई।<verse eid="PSA 24:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5"/>वह ख़ुदावन्द की तरफ़ से बरकत पाएगा,</para>
  <para style="q" vid="PSA 24:5">हाँ अपने नजात देने वाले ख़ुदा की तरफ़ से सदाक़त।<verse eid="PSA 24:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6"/>यही उसके तालिबों की नसल है,</para>
  <para style="q" vid="PSA 24:6">यही तेरे दीदार के तलबगार हैं या'नी या'क़ूब। सिलाह<verse eid="PSA 24:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7"/>ऐ फाटको, अपने सिर बुलन्द करो।</para>
  <para style="q" vid="PSA 24:7">ऐ अबदी दरवाज़ो, ऊँचे हो जाओ!</para>
  <para style="q" vid="PSA 24:7">और जलाल का बादशाह दाख़िल होगा।<verse eid="PSA 24:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8"/>यह जलाल का बादशाह कौन है?</para>
  <para style="q" vid="PSA 24:8">ख़ुदावन्द जो क़वी और क़ादिर है,</para>
  <para style="q" vid="PSA 24:8">ख़ुदावन्द जो जंग में ताक़तवर है!<verse eid="PSA 24:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9"/>ऐ फाटको, अपने सिर बुलन्द करो!</para>
  <para style="q" vid="PSA 24:9">ऐ अबदी दरवाज़ो, उनको बुलन्द करो!</para>
  <para style="q" vid="PSA 24:9">और जलाल का बादशाह दाख़िल होगा।<verse eid="PSA 24:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10"/>यह जलाल का बादशाह कौन है?</para>
  <para style="q" vid="PSA 24:10">लश्करों का ख़ुदावन्द, वही जलाल का बादशाह है। सिलाह।<verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 25:1"/>ऐ ख़ुदावन्द!</para>
  <para style="q" vid="PSA 25:1">मैं अपनी जान तेरी तरफ़ उठाता हूँ।<verse eid="PSA 25:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2"/>ऐ मेरे ख़ुदा, मैंने तुझ पर भरोसा किया है,</para>
  <para style="q" vid="PSA 25:2">मुझे शर्मिन्दा न होने दे:मेरे दुश्मन मुझ पर ख़ुशी न मनाएँ।<verse eid="PSA 25:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3"/>बल्कि जो तेरे मुन्तज़िर हैं उनमें से कोई शर्मिन्दा न होगा;</para>
  <para style="q" vid="PSA 25:3">लेकिन जो नाहक़ बेवफ़ाई करते हैं वही शर्मिन्दा होंगे।<verse eid="PSA 25:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4"/>ऐ ख़ुदावन्द, अपनी राहें मुझे दिखा;</para>
  <para style="q" vid="PSA 25:4">अपने रास्ते मुझे बता दे।<verse eid="PSA 25:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5"/>मुझे अपनी सच्चाई पर चला और ता'लीम दे,</para>
  <para style="q" vid="PSA 25:5">क्यूँकि तू मेरा नजात देने वाला ख़ुदा है;</para>
  <para style="q" vid="PSA 25:5">मैं दिन भर तेरा ही मुन्तज़िर रहता हूँ।<verse eid="PSA 25:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6"/>ऐ ख़ुदावन्द, अपनी रहमतों और शफ़क़तों को याद फ़रमा;</para>
  <para style="q" vid="PSA 25:6">क्यूँकि वह शुरू' से हैं।<verse eid="PSA 25:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7"/>मेरी जवानी की ख़ताओं और मेरे गुनाहों को याद न कर;</para>
  <para style="q" vid="PSA 25:7">ऐ ख़ुदावन्द, अपनी नेकी की ख़ातिर अपनी शफ़क़त के मुताबिक मुझे याद फ़रमा।<verse eid="PSA 25:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8"/>ख़ुदावन्द नेक और रास्त है;</para>
  <para style="q" vid="PSA 25:8">इसलिए वह गुनहगारों को राह — ए — हक़ की ता'लीम देगा।<verse eid="PSA 25:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9"/>वह हलीमों को इन्साफ़ की हिदायत करेगा,</para>
  <para style="q" vid="PSA 25:9">हाँ, वह हलीमों को अपनी राह बताएगा।<verse eid="PSA 25:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10"/>जो ख़ुदावन्द के 'अहद और उसकी शहादतों को मानते हैं,</para>
  <para style="q" vid="PSA 25:10">उनके लिए उसकी सब राहें शफ़क़त और सच्चाई हैं।<verse eid="PSA 25:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11"/>ऐ ख़ुदावन्द, अपने नाम की ख़ातिर</para>
  <para style="q" vid="PSA 25:11">मेरी बदकारी मु'आफ़ कर दे क्यूँकि वह बड़ी है।<verse eid="PSA 25:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12"/>वह कौन है जो ख़ुदावन्द से डरता है?</para>
  <para style="q" vid="PSA 25:12">ख़ुदावन्द उसको उसी राह की ता'लीम देगा जो उसे पसंद है।<verse eid="PSA 25:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13"/>उसकी जान राहत में रहेगी,</para>
  <para style="q" vid="PSA 25:13">और उसकी नसल ज़मीन की वारिस होगी।<verse eid="PSA 25:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14"/>ख़ुदावन्द के राज़ को वही जानते हैं जो उससे डरते हैं,</para>
  <para style="q" vid="PSA 25:14">और वह अपना 'अहद उनको बताएगा।<verse eid="PSA 25:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15"/>मेरी आँखें हमेशा ख़ुदावन्द की तरफ़ लगी रहती हैं,</para>
  <para style="q" vid="PSA 25:15">क्यूँकि वही मेरा पाँव दाम से छुड़ाएगा।<verse eid="PSA 25:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16"/>मेरी तरफ़ मुतवज्जिह हो और मुझ पर रहम कर,</para>
  <para style="q" vid="PSA 25:16">क्यूँकि मैं बेकस और मुसीबत ज़दा हूँ।<verse eid="PSA 25:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17"/>मेरे दिल के दुख बढ़ गए,</para>
  <para style="q" vid="PSA 25:17">तू मुझे मेरी तकलीफ़ों से रिहाई दे।<verse eid="PSA 25:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18"/>तू मेरी मुसीबत और जॉफ़िशानी को देख,</para>
  <para style="q" vid="PSA 25:18">और मेरे सब गुनाह मु'आफ़ फ़रमा।<verse eid="PSA 25:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19"/>मेरे दुश्मनों को देख क्यूँकि वह बहुत हैं</para>
  <para style="q" vid="PSA 25:19">और उनको मुझ से सख़्त 'अदावत है।<verse eid="PSA 25:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20"/>मेरी जान की हिफ़ाज़त कर, और मुझे छुड़ा;</para>
  <para style="q" vid="PSA 25:20">मुझे शर्मिन्दा न होने दे,</para>
  <para style="q" vid="PSA 25:20">क्यूँकि मेरा भरोसा तुझ ही पर है।<verse eid="PSA 25:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21"/>दियानतदारी और रास्तबाज़ी मुझे सलामत रख्खें,</para>
  <para style="q" vid="PSA 25:21">क्यूँकि मुझे तेरी ही आस है।<verse eid="PSA 25:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22"/>ऐ ख़ुदा, इस्राईल को उसके सब दुखों से छुड़ा ले।<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 26:1"/>ऐ ख़ुदावन्द, मेरा इन्साफ़ कर,</para>
  <para style="q" vid="PSA 26:1">क्यूँकि मैं रास्ती से चलता रहा हूँ,</para>
  <para style="q" vid="PSA 26:1">और मैंने ख़ुदावन्द पर बे लग़ज़िश भरोसा किया है।<verse eid="PSA 26:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2"/>ऐ ख़ुदावन्द, मुझे जाँच और आज़मा;</para>
  <para style="q" vid="PSA 26:2">मेरे दिल — ओ — दिमाग़ को परख।<verse eid="PSA 26:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3"/>क्यूँकि तेरी शफ़क़त मेरी आँखों के सामने है,</para>
  <para style="q" vid="PSA 26:3">और मैं तेरी सच्चाई की राह पर चलता रहा हूँ।<verse eid="PSA 26:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4"/>मैं बेहूदा लोगों के साथ नहीं बैठा,</para>
  <para style="q" vid="PSA 26:4">मैं रियाकारों के साथ कहीं नहीं जाऊँगा।<verse eid="PSA 26:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5"/>बदकिरदारों की जमा'अत से मुझे नफ़रत है,</para>
  <para style="q" vid="PSA 26:5">मैं शरीरों के साथ नहीं बैठूँगा।<verse eid="PSA 26:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6"/>मैं बेगुनाही में अपने हाथ धोऊँगा,</para>
  <para style="q" vid="PSA 26:6">और ऐ ख़ुदावन्द, मैं तेरे मज़बह का तवाफ़ करूँगा;<verse eid="PSA 26:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7"/>ताकि शुक्रगुज़ारी की आवाज़ बुलन्द करूँ,</para>
  <para style="q" vid="PSA 26:7">और तेरे सब 'अजीब कामों को बयान करूँ।<verse eid="PSA 26:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8"/>ऐ ख़ुदावन्द, मैं तेरी सकूनतगाह,</para>
  <para style="q" vid="PSA 26:8">और तेरे जलाल के ख़ेमे को 'अज़ीज़ रखता हूँ।<verse eid="PSA 26:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9"/>मेरी जान को गुनहगारों के साथ,</para>
  <para style="q" vid="PSA 26:9">और मेरी ज़िन्दगी को ख़ूनी आदमियों के साथ न मिला।<verse eid="PSA 26:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10"/>जिनके हाथों में शरारत है,</para>
  <para style="q" vid="PSA 26:10">और जिनका दहना हाथ रिश्वतों से भरा है।<verse eid="PSA 26:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11"/>लेकिन मैं तो रास्ती से चलता रहूँगा।</para>
  <para style="q" vid="PSA 26:11">मुझे छुड़ा ले और मुझ पर रहम कर।<verse eid="PSA 26:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12"/>मेरा पाँव हमवार जगह पर क़ाईम है।</para>
  <para style="q" vid="PSA 26:12">मैं जमा'अतों में ख़ुदावन्द को मुबारक कहूँगा।<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 27:1"/>ख़ुदावन्द मेरी रोशनी और मेरी नजात मुझे किसकी दहशत?</para>
  <para style="q" vid="PSA 27:1">ख़ुदावन्द मेरी ज़िन्दगी की ताक़त है, मुझे किसका डर?<verse eid="PSA 27:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2"/>जब शरीर या'नी मेरे मुख़ालिफ़ और मेरे दुश्मन,</para>
  <para style="q" vid="PSA 27:2">मेरा गोश्त खाने को मुझ पर चढ़ आए तो वह ठोकर खाकर गिर पड़े।<verse eid="PSA 27:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3"/>चाहे मेरे ख़िलाफ़ लश्कर ख़ेमाज़न हो,</para>
  <para style="q" vid="PSA 27:3">मेरा दिल नहीं डरेगा।</para>
  <para style="q" vid="PSA 27:3">चाहे मेरे मुक़ाबले में जंग खड़ी हो, तोभी मैं मुतम'इन रहूँगा।<verse eid="PSA 27:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4"/>मैंने ख़ुदावन्द से एक दरख़्वास्त की है,</para>
  <para style="q" vid="PSA 27:4">मैं इसी का तालिब रहूँगा;</para>
  <para style="q" vid="PSA 27:4">कि मैं उम्र भर ख़ुदावन्द के घर में रहूँ,</para>
  <para style="q" vid="PSA 27:4">ताकि ख़ुदावन्द के जमाल को देखूँ</para>
  <para style="q" vid="PSA 27:4">और उसकी हैकल में इस्तिफ़्सार किया करूँ।<verse eid="PSA 27:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5"/>क्यूँकि मुसीबत के दिन वह मुझे अपने शामियाने में पोशीदा रख्खेगा;</para>
  <para style="q" vid="PSA 27:5">वह मुझे अपने ख़ेमे के पर्दे में छिपा लेगा,</para>
  <para style="q" vid="PSA 27:5">वह मुझे चट्टान पर चढ़ा देगा<verse eid="PSA 27:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6"/>अब मैं अपने चारों तरफ़ के दुश्मनों पर सरफराज़ किया जाऊँगा;</para>
  <para style="q" vid="PSA 27:6">मैं उसके ख़ेमे में ख़ुशी की क़ुर्बानियाँ पेश करूँगा;</para>
  <para style="q" vid="PSA 27:6">मैं गाऊँगा, मैं ख़ुदावन्द की मदहसराई करूँगा।<verse eid="PSA 27:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7"/>ऐ ख़ुदावन्द, मेरी आवाज़ सुन! मैं पुकारता हूँ।</para>
  <para style="q" vid="PSA 27:7">मुझ पर रहम कर और मुझे जवाब दे।<verse eid="PSA 27:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8"/>जब तूने फ़रमाया, कि मेरे दीदार के तालिब हो;</para>
  <para style="q" vid="PSA 27:8">तो मेरे दिल ने तुझ से कहा,</para>
  <para style="q" vid="PSA 27:8">ऐ ख़ुदावन्द, मैं तेरे दीदार का तालिब रहूँगा।<verse eid="PSA 27:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9"/>मुझ से चेहरा न छिपा।</para>
  <para style="q" vid="PSA 27:9">अपने बन्दे को क़हर से न निकाल।</para>
  <para style="q" vid="PSA 27:9">तू मेरा मददगार रहा है;</para>
  <para style="q" vid="PSA 27:9">न मुझे तर्क कर, न मुझे छोड़, ऐ मेरे नजात देने वाले ख़ुदा!।<verse eid="PSA 27:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10"/>जब मेरा बाप और मेरी माँ मुझे छोड़ दें,</para>
  <para style="q" vid="PSA 27:10">तो ख़ुदावन्द मुझे संभाल लेगा।<verse eid="PSA 27:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11"/>ऐ ख़ुदावन्द, मुझे अपनी राह बता,</para>
  <para style="q" vid="PSA 27:11">और मेरे दुश्मनों की वजह से मुझे हमवार रास्ते पर चला।<verse eid="PSA 27:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12"/>मुझे मेरे मुख़ालिफ़ों की मर्ज़ी पर न छोड़,</para>
  <para style="q" vid="PSA 27:12">क्यूँकि झूटे गवाह और बेरहमी से पुंकारने वाले मेरे ख़िलाफ़ उठे हैं।<verse eid="PSA 27:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13"/>अगर मुझे यक़ीन न होता कि ज़िन्दों की</para>
  <para style="q" vid="PSA 27:13">ज़मीन में ख़ुदावन्द के एहसान को देखूँगा,</para>
  <para style="q" vid="PSA 27:13">तो मुझे ग़श आ जाता।<verse eid="PSA 27:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14"/>ख़ुदावन्द की उम्मीद रख;</para>
  <para style="q" vid="PSA 27:14">मज़बूत हो और तेरा दिल क़वी हो;</para>
  <para style="q" vid="PSA 27:14">हाँ, ख़ुदावन्द ही की उम्मीद रख।<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 28:1"/>ऐ ख़ुदावन्द, मैं तुझ ही को पुकारूँगा;</para>
  <para style="q" vid="PSA 28:1">ऐ मेरी चट्टान, तू मेरी तरफ़ से कान बन्द न कर;</para>
  <para style="q" vid="PSA 28:1">ऐसा न हो कि अगर तू मेरी तरफ़ से खामोश रहे तो मैं उनकी तरह बन जाऊँ,</para>
  <para style="q" vid="PSA 28:1">जो पाताल में जाते हैं।<verse eid="PSA 28:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2"/>जब मैं तुझ से फ़रियाद करूँ,</para>
  <para style="q" vid="PSA 28:2">और अपने हाथ तेरी मुक़द्दस हैकल की तरफ़ उठाऊँ,</para>
  <para style="q" vid="PSA 28:2">तो मेरी मिन्नत की आवाज़ को सुन ले।<verse eid="PSA 28:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3"/>मुझे उन शरीरों और बदकिरदारों के साथ घसीट न ले जा;</para>
  <para style="q" vid="PSA 28:3">जो अपने पड़ोसियों से सुलह की बातें करते हैं,</para>
  <para style="q" vid="PSA 28:3">मगर उनके दिलों में बदी है।<verse eid="PSA 28:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4"/>उनके अफ़'आल — ओ — आ'माल की बुराई के मुवाफ़िक़ उनको बदला दे,</para>
  <para style="q" vid="PSA 28:4">उनके हाथों के कामों के मुताबिक़ उनसे सुलूक कर;</para>
  <para style="q" vid="PSA 28:4">उनके किए का बदला उनको दे।<verse eid="PSA 28:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5"/>वह ख़ुदावन्द के कामों</para>
  <para style="q" vid="PSA 28:5">और उसकी दस्तकारी पर ध्यान नहीं करते,</para>
  <para style="q" vid="PSA 28:5">इसलिए वह उनको गिरा देगा और फिर नहीं उठाएगा।<verse eid="PSA 28:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6"/>ख़ुदावन्द मुबारक हो,</para>
  <para style="q" vid="PSA 28:6">इसलिए के उसने मेरी मिन्नत की आवाज़ सुन ली।<verse eid="PSA 28:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7"/>ख़ुदावन्द मेरी ताक़त और मेरी ढाल है;</para>
  <para style="q" vid="PSA 28:7">मेरे दिल ने उस पर भरोसा किया है, और मुझे मदद मिली है।</para>
  <para style="q" vid="PSA 28:7">इसलिए मेरा दिल बहुत ख़ुश है;</para>
  <para style="q" vid="PSA 28:7">और मैं गीत गाकर उसकी सिताइश करूँगा।<verse eid="PSA 28:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8"/>ख़ुदावन्द उनकी ताक़त है,</para>
  <para style="q" vid="PSA 28:8">वह अपने मम्सूह के लिए नजात का क़िला' है।<verse eid="PSA 28:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9"/>अपनी उम्मत को बचा, और अपनी मीरास को बरकत दे;</para>
  <para style="q" vid="PSA 28:9">उनकी पासबानी कर, और उनको हमेशा तक संभाले रह।<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 29:1"/>ऐ फ़रिश्तों की जमा'त ख़ुदावन्द की,</para>
  <para style="q" vid="PSA 29:1">ख़ुदावन्द ही की तम्जीद — ओ — ता'ज़ीम करो।<verse eid="PSA 29:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2"/>ख़ुदावन्द की ऐसी तम्जीद करो, जो उसके नाम के शायाँ है।</para>
  <para style="q" vid="PSA 29:2">पाक आराइश के साथ ख़ुदावन्द को सिज्दा करो।<verse eid="PSA 29:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3"/>ख़ुदावन्द की आवाज़ बादलों पर है;</para>
  <para style="q" vid="PSA 29:3">ख़ुदा — ए — जुलजलाल गरजता है,</para>
  <para style="q" vid="PSA 29:3">ख़ुदावन्द पानी से भरे बादलों पर है।<verse eid="PSA 29:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4"/>ख़ुदावन्द की आवाज़ में क़ुदरत है;</para>
  <para style="q" vid="PSA 29:4">ख़ुदावन्द की आवाज़ में जलाल है।<verse eid="PSA 29:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5"/>ख़ुदावन्द की आवाज़ देवदारों को तोड़ डालती है;</para>
  <para style="q" vid="PSA 29:5">बल्कि ख़ुदावन्द लुबनान के देवदारों को टुकड़े टुकड़े कर देता है।<verse eid="PSA 29:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6"/>वह उनको बछड़े की तरह,</para>
  <para style="q" vid="PSA 29:6">लुबनान और सिरयून को जंगली बछड़े की तरह कुदाता है।<verse eid="PSA 29:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7"/>ख़ुदावन्द की आवाज़ आग के शो'लों को चीरती है।<verse eid="PSA 29:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8"/>ख़ुदावन्द की आवाज़ वीरान को हिला देती है;</para>
  <para style="q" vid="PSA 29:8">ख़ुदावन्द क़ादिस के वीरान को हिला डालता है।<verse eid="PSA 29:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9"/>ख़ुदावन्द की आवाज़ से हिरनीयों के हमल गिर जाते हैं;</para>
  <para style="q" vid="PSA 29:9">और वह जंगलों को बेबर्ग कर देती है;</para>
  <para style="q" vid="PSA 29:9">उसकी हैकल में हर एक जलाल ही जलाल पुकारता है।<verse eid="PSA 29:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10"/>ख़ुदावन्द तूफ़ान के वक़्त तख़्तनशीन था;</para>
  <para style="q" vid="PSA 29:10">बल्कि ख़ुदावन्द हमेशा तक तख़्तनशीन है।<verse eid="PSA 29:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11"/>ख़ुदावन्द अपनी उम्मत को ज़ोर बख़्शेगा;</para>
  <para style="q" vid="PSA 29:11">ख़ुदावन्द अपनी उम्मत को सलामती की बरकत देगा।<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 30:1"/>ऐ ख़ुदावन्द, मैं तेरी तम्जीद करूँगा;</para>
  <para style="q" vid="PSA 30:1">क्यूँकि तूने मुझे सरफ़राज़ किया है;</para>
  <para style="q" vid="PSA 30:1">और मेरे दुश्मनों को मुझ पर खु़श होने न दिया।<verse eid="PSA 30:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 30:2"/>ऐ ख़ुदावन्द मेरे ख़ुदा!,</para>
  <para style="q" vid="PSA 30:2">मैंने तुझ से फ़रियाद की और तूने मुझे शिफ़ा बख़्शी।<verse eid="PSA 30:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 30:3"/>ऐ ख़ुदावन्द, तू मेरी जान को पाताल से निकाल लाया है;</para>
  <para style="q" vid="PSA 30:3">तूने मुझे ज़िन्दा रख्खा है कि क़ब्र में न जाऊँ।<verse eid="PSA 30:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 30:4"/>ख़ुदावन्द की सिताइश करो,</para>
  <para style="q" vid="PSA 30:4">ऐ उसके पाक लोगों!</para>
  <para style="q" vid="PSA 30:4">और उसके पाकीज़गी को याद करके शुक्रगुज़ारी करो।<verse eid="PSA 30:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 30:5"/>क्यूँकि उसका क़हर दम भर का है,</para>
  <para style="q" vid="PSA 30:5">उसका करम उम्र भर का।</para>
  <para style="q" vid="PSA 30:5">रात को शायद रोना पड़े पर सुबह को ख़ुशी की नौबत आती है।<verse eid="PSA 30:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 30:6"/>मैंने अपनी इक़बालमंदी के वक़्त यह कहा था,</para>
  <para style="q" vid="PSA 30:6">कि मुझे कभी जुम्बिश न होगी।<verse eid="PSA 30:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 30:7"/>ऐ ख़ुदावन्द, तूने अपने करम से मेरे पहाड़ को क़ाईम रख्खा था;</para>
  <para style="q" vid="PSA 30:7">जब तूने अपना चेहरा छिपाया तो मैं घबरा उठा।<verse eid="PSA 30:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 30:8"/>ऐ ख़ुदावन्द, मैंने तुझ से फ़रियाद की;</para>
  <para style="q" vid="PSA 30:8">मैंने ख़ुदावन्द से मिन्नत की,<verse eid="PSA 30:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 30:9"/>जब मैं क़ब्र में जाऊँ तो मेरी मौत से क्या फ़ायदा?</para>
  <para style="q" vid="PSA 30:9">क्या ख़ाक तेरी सिताइश करेगी?</para>
  <para style="q" vid="PSA 30:9">क्या वह तेरी सच्चाई को बयान करेगी?<verse eid="PSA 30:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 30:10"/>सुन ले ऐ ख़ुदावन्द, और मुझ पर रहम कर;</para>
  <para style="q" vid="PSA 30:10">ऐ ख़ुदावन्द, तू मेरा मददगार हो।<verse eid="PSA 30:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 30:11"/>तूने मेरे मातम को नाच से बदल दिया;</para>
  <para style="q" vid="PSA 30:11">तूने मेरा टाट उतार डाला और मुझे ख़ुशी से कमरबस्ता किया,<verse eid="PSA 30:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 30:12"/>ताकि मेरी रूह तेरी मदहसराई करे और चुप न रहे।</para>
  <para style="q" vid="PSA 30:12">ऐ ख़ुदावन्द मेरे ख़ुदा,</para>
  <para style="q" vid="PSA 30:12">मैं हमेशा तेरा शुक्र करता रहूँगा।<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 31:1"/>ऐ ख़ुदावन्द! मेरा भरोसा तुझ पर,</para>
  <para style="q" vid="PSA 31:1">मुझे कभी शर्मिन्दा न होने दे;</para>
  <para style="q" vid="PSA 31:1">अपनी सदाक़त की ख़ातिर मुझे रिहाई दे।<verse eid="PSA 31:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 31:2"/>अपना कान मेरी तरफ़ झुका, जल्द मुझे छुड़ा!</para>
  <para style="q" vid="PSA 31:2">तू मेरे लिए मज़बूत चट्टान, मेरे बचाने को पनाहगाह हो!<verse eid="PSA 31:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 31:3"/>क्यूँकि तू ही मेरी चट्टान और मेरा किला है;</para>
  <para style="q" vid="PSA 31:3">इसलिए अपने नाम की ख़ातिर मेरी राहबरीऔर रहनुमाई कर।<verse eid="PSA 31:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 31:4"/>मुझे उस जाल से निकाल ले जो उन्होंने छिपकर मेरे लिए बिछाया है,</para>
  <para style="q" vid="PSA 31:4">क्यूँकि तू ही मेरा मज़बूत क़िला' है।<verse eid="PSA 31:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 31:5"/>मैं अपनी रूह तेरे हाथ में सौंपता हूँ: ऐ ख़ुदावन्द!</para>
  <para style="q" vid="PSA 31:5">सच्चाई के ख़ुदा; तूने मेरा फ़िदिया दिया है।<verse eid="PSA 31:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 31:6"/>मुझे उनसे नफ़रत है जो झूटे मा'बूदों को मानते हैं:</para>
  <para style="q" vid="PSA 31:6">मेरा भरोसा तो ख़ुदावन्द ही पर है।<verse eid="PSA 31:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 31:7"/>मैं तेरी रहमत से ख़ुश — ओ — ख़ुर्रम रहूँगा,</para>
  <para style="q" vid="PSA 31:7">क्यूँकि तूने मेरा दुख: देख लिया है;</para>
  <para style="q" vid="PSA 31:7">तू मेरी जान की मुसीबतों से वाक़िफ़ है।<verse eid="PSA 31:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 31:8"/>तूने मुझे दुश्मन के हाथ में क़ैद नहीं छोड़ा;</para>
  <para style="q" vid="PSA 31:8">तूने मेरे पाँव कुशादा जगह में रख्खे हैं।<verse eid="PSA 31:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 31:9"/>ऐ ख़ुदावन्द, मुझ पर रहम कर क्यूँकि मैं मुसीबत में हूँ।</para>
  <para style="q" vid="PSA 31:9">मेरी आँख बल्कि मेरी जान और मेरा जिस्म सब रंज के मारे घुले जाते हैं।<verse eid="PSA 31:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 31:10"/>क्यूँकि मेरी जान ग़म में और मेरी उम्र कराहने में फ़ना हुई;</para>
  <para style="q" vid="PSA 31:10">मेरा ज़ोर मेरी बदकारी के वजह से जाता रहा,</para>
  <para style="q" vid="PSA 31:10">और मेरी हड्डियाँ घुल गई।<verse eid="PSA 31:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 31:11"/>मैं अपने सब मुख़ालिफ़ों की वजह से अपने पड़ोसियों के लिए,</para>
  <para style="q" vid="PSA 31:11">अज़ बस अन्गुश्तनुमा और अपने जान पहचानों के लिए</para>
  <para style="q" vid="PSA 31:11">ख़ौफ़ का ज़रिया' हूँ जिन्होंने मुझको बाहर देखा, मुझ से दूर भागे।<verse eid="PSA 31:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 31:12"/>मैं मुर्दे की तरह भुला दिया गया हूँ;</para>
  <para style="q" vid="PSA 31:12">मैं टूटे बर्तन की तरह हूँ।<verse eid="PSA 31:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 31:13"/>क्यूँकि मैंने बहुतों से अपनी बदनामी सुनी है,</para>
  <para style="q" vid="PSA 31:13">हर तरफ़ ख़ौफ़ ही ख़ौफ़ है।</para>
  <para style="q" vid="PSA 31:13">जब उन्होंने मिलकर मेरे ख़िलाफ़ मश्वरा किया,</para>
  <para style="q" vid="PSA 31:13">तो मेरी जान लेने का मन्सूबा बाँधा।<verse eid="PSA 31:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 31:14"/>लेकिन ऐ ख़ुदावन्द, मेरा भरोसा तुझ पर है।</para>
  <para style="q" vid="PSA 31:14">मैंने कहा, “तू मेरा ख़ुदा है।”<verse eid="PSA 31:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 31:15"/>मेरे दिन तेरे हाथ में हैं;</para>
  <para style="q" vid="PSA 31:15">मुझे मेरे दुश्मनों और सताने वालों के हाथ से छुड़ा।<verse eid="PSA 31:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 31:16"/>अपने चेहरे को अपने बन्दे पर जलवागर फ़रमा;</para>
  <para style="q" vid="PSA 31:16">अपनी शफ़क़त से मुझे बचा ले।<verse eid="PSA 31:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 31:17"/>ऐ ख़ुदावन्द, मुझे शर्मिन्दा न होने दे क्यूँकि मैंने तुझ से दुआ की है;</para>
  <para style="q" vid="PSA 31:17">शरीर शर्मिन्दा हो जाएँ और पाताल में ख़ामोश हों।<verse eid="PSA 31:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 31:18"/>झूटे होंट बन्द हो जाएँ, जो सादिकों के ख़िलाफ़ ग़ुरूर</para>
  <para style="q" vid="PSA 31:18">और हिक़ारत से तकब्बुर की बातें बोलते हैं।<verse eid="PSA 31:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 31:19"/>आह! तूने अपने डरने वालों के लिए</para>
  <para style="q" vid="PSA 31:19">कैसी बड़ी ने'मत रख छोड़ी है:</para>
  <para style="q" vid="PSA 31:19">जिसे तूने बनी आदम के सामने अपने,</para>
  <para style="q" vid="PSA 31:19">भरोसा करने वालों के लिए तैयार किया।<verse eid="PSA 31:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 31:20"/>तू उनको इंसान की बन्दिशों से अपनी हुज़ूरी के पर्दे में छिपाएगा;</para>
  <para style="q" vid="PSA 31:20">तू उनको ज़बान के झगड़ों से शामियाने में पोशीदा रख्खेगा।<verse eid="PSA 31:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 31:21"/>ख़ुदावन्द मुबारक हो!</para>
  <para style="q" vid="PSA 31:21">क्यूँकि उसने मुझ को मज़बूत शहर में अपनी 'अजीब शफ़क़त दिखाई।<verse eid="PSA 31:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 31:22"/>मैंने तो जल्दबाज़ी से कहा था,</para>
  <para style="q" vid="PSA 31:22">कि मैं तेरे सामने से काट डाला गया।</para>
  <para style="q" vid="PSA 31:22">तोभी जब मैंने तुझ से फ़रियाद की तो तूने मेरी मिन्नत की आवाज़ सुन ली।<verse eid="PSA 31:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 31:23"/>ख़ुदावन्द से मुहब्बत रखो,</para>
  <para style="q" vid="PSA 31:23">ऐ उसके सब पाक लोगों!</para>
  <para style="q" vid="PSA 31:23">ख़ुदावन्द ईमानदारों को सलामत रखता है;</para>
  <para style="q" vid="PSA 31:23">और मग़रूरों को ख़ूब ही बदला देता है<verse eid="PSA 31:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 31:24"/>ऐ ख़ुदावन्द पर उम्मीद रखने वालो!</para>
  <para style="q" vid="PSA 31:24">सब मज़बूत हो और तुम्हारा दिल क़वी रहे।<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 32:1"/>मुबारक है वह जिसकी ख़ता बख़्शी गई,</para>
  <para style="q" vid="PSA 32:1">और जिसका गुनाह ढाँका गया।<verse eid="PSA 32:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2"/>मुबारक है वह आदमी जिसकी बदकारी को ख़ुदावन्द हिसाब में नहीं लाता,</para>
  <para style="q" vid="PSA 32:2">और जिसके दिल में दिखावा नहीं।<verse eid="PSA 32:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3"/>जब मैं ख़ामोश रहा</para>
  <para style="q" vid="PSA 32:3">तो दिन भर के कराहने से मेरी हड्डियाँ घुल गई।<verse eid="PSA 32:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4"/>क्यूँकि तेरा हाथ रात दिन मुझ पर भारी था;</para>
  <para style="q" vid="PSA 32:4">मेरी तरावट गर्मियों की खु़श्की से बदल गई। सिलाह<verse eid="PSA 32:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5"/>मैंने तेरे सामने अपने गुनाह को मान लिया और अपनी बदकारी को न छिपाया,</para>
  <para style="q" vid="PSA 32:5">मैंने कहा, मैं ख़ुदावन्द के सामने अपनी ख़ताओं का इक़रार करूँगा</para>
  <para style="q" vid="PSA 32:5">और तूने मेरे गुनाह की बुराई को मु'आफ़ किया। सिलाह<verse eid="PSA 32:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6"/>इसीलिए हर दीनदार तुझ से ऐसे वक़्त में दुआ करे जब तू मिल सकता है।</para>
  <para style="q" vid="PSA 32:6">यक़ीनन जब सैलाब आए तो उस तक नहीं पहुँचेगा।<verse eid="PSA 32:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7"/>तू मेरे छिपने की जगह है; तू मुझे दुख से बचाये रख्खेगा;</para>
  <para style="q" vid="PSA 32:7">तू मुझे रिहाई के नाग़मों से घेर लेगा। सिलाह<verse eid="PSA 32:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8"/>मैं तुझे ता'लीम दूँगा, और जिस राह पर तुझे चलना होगा तुझे बताऊँगा;</para>
  <para style="q" vid="PSA 32:8">मैं तुझे सलाह दूँगा, मेरी नज़र तुझ पर होगी।<verse eid="PSA 32:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9"/>तुम घोड़े या खच्चर की तरह न बनो जिनमें समझ नहीं,</para>
  <para style="q" vid="PSA 32:9">जिनको क़ाबू में रखने का साज़ दहाना और लगाम है,</para>
  <para style="q" vid="PSA 32:9">वर्ना वह तेरे पास आने के भी नहीं।<verse eid="PSA 32:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10"/>शरीर पर बहुत सी मुसीबतें आएँगी;</para>
  <para style="q" vid="PSA 32:10">पर जिसका भरोसा ख़ुदावन्द पर है,</para>
  <para style="q" vid="PSA 32:10">रहमत उसे घेरे रहेगी।<verse eid="PSA 32:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11"/>ऐ सादिक़ो, ख़ुदावन्द में ख़ुश — ओ — बुर्रम रहो;</para>
  <para style="q" vid="PSA 32:11">और ऐ रास्तदिलो, खु़शी से ललकारो!<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1"/>ऐ सादिक़ो, ख़ुदावन्द में ख़ुश रहो।</para>
  <para style="q" vid="PSA 33:1">हम्द करना रास्तबाज़ों की ज़ेबा है।<verse eid="PSA 33:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2"/>सितार के साथ ख़ुदावन्द का शुक्र करो,</para>
  <para style="q" vid="PSA 33:2">दस तार की बरबत के साथ उसकी सिताइश करो।<verse eid="PSA 33:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3"/>उसके लिए नया गीत गाओ,</para>
  <para style="q" vid="PSA 33:3">बुलन्द आवाज़ के साथ अच्छी तरह बजाओ।<verse eid="PSA 33:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4"/>क्यूँकि ख़ुदावन्द का कलाम रास्त है;</para>
  <para style="q" vid="PSA 33:4">और उसके सब काम बावफ़ा हैं।<verse eid="PSA 33:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5"/>वह सदाक़त और इन्साफ़ को पसंद करता है;</para>
  <para style="q" vid="PSA 33:5">ज़मीन ख़ुदावन्द की शफ़क़त से मा'मूर है।<verse eid="PSA 33:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6"/>आसमान ख़ुदावन्द के कलाम से,</para>
  <para style="q" vid="PSA 33:6">और उसका सारा लश्कर उसके मुँह के दम से बना।<verse eid="PSA 33:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7"/>वह समन्दर का पानी तूदे की तरह जमा' करता है;</para>
  <para style="q" vid="PSA 33:7">वह गहरे समन्दरों को मख़ज़नों में रखता है।<verse eid="PSA 33:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8"/>सारी ज़मीन ख़ुदावन्द से डरे,</para>
  <para style="q" vid="PSA 33:8">जहान के सब बाशिन्दे उसका ख़ौफ़ रख्खें।<verse eid="PSA 33:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9"/>क्यूँकि उसने फ़रमाया और हो गया;</para>
  <para style="q" vid="PSA 33:9">उसने हुक्म दिया और वाके' हुआ।<verse eid="PSA 33:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10"/>ख़ुदावन्द क़ौमों की मश्वरत को बेकार कर देता है;</para>
  <para style="q" vid="PSA 33:10">वह उम्मतों के मन्सूबों को नाचीज़ बना देता है।<verse eid="PSA 33:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11"/>ख़ुदावन्द की मसलहत हमेशा तक क़ाईम रहेगी,</para>
  <para style="q" vid="PSA 33:11">और उसके दिल के ख़याल नसल दर नसल।<verse eid="PSA 33:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12"/>मुबारक है वह क़ौम जिसका ख़ुदा ख़ुदावन्द है,</para>
  <para style="q" vid="PSA 33:12">और वह उम्मत जिसको उसने अपनी ही मीरास के लिए बरगुज़ीदा किया।<verse eid="PSA 33:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13"/>ख़ुदावन्द आसमान पर से देखता है,</para>
  <para style="q" vid="PSA 33:13">सब बनी आदम पर उसकी निगाह है।<verse eid="PSA 33:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14"/>अपनी सुकूनत गाह से</para>
  <para style="q" vid="PSA 33:14">वह ज़मीन के सब बाशिन्दों को देखता है।<verse eid="PSA 33:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15"/>वही है जो उन सबके दिलों को बनाता,</para>
  <para style="q" vid="PSA 33:15">और उनके सब कामों का ख़याल रखता है।<verse eid="PSA 33:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16"/>किसी बादशाह को फ़ौज की कसरत न बचाएगी;</para>
  <para style="q" vid="PSA 33:16">और किसी ज़बरदस्त आदमी को उसकी बड़ी ताक़त रिहाई न देगी।<verse eid="PSA 33:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17"/>बच निकलने के लिए घोड़ा बेकार है,</para>
  <para style="q" vid="PSA 33:17">वह अपनी शहज़ोरी से किसी को नबचाएगा।<verse eid="PSA 33:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18"/>देखो ख़ुदावन्द की निगाह उन पर है जो उससे डरते हैं;</para>
  <para style="q" vid="PSA 33:18">जो उसकी शफ़क़त के उम्मीदवार हैं,<verse eid="PSA 33:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19"/>ताकि उनकी जान मौत से बचाए,</para>
  <para style="q" vid="PSA 33:19">और सूखे में उनको ज़िन्दा रख्खे।<verse eid="PSA 33:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20"/>हमारी जान को ख़ुदावन्द की उम्मीद है;</para>
  <para style="q" vid="PSA 33:20">वही हमारी मदद और हमारी ढाल है।<verse eid="PSA 33:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21"/>हमारा दिल उसमें ख़ुश रहेगा,</para>
  <para style="q" vid="PSA 33:21">क्यूँकि हम ने उसके पाक नाम पर भरोसा किया है।<verse eid="PSA 33:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22"/>ऐ ख़ुदावन्द, जैसी तुझ पर हमारी उम्मीद है,</para>
  <para style="q" vid="PSA 33:22">वैसी ही तेरी रहमत हम पर हो।<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 34:1"/>मैं हर वक़्त ख़ुदावन्द को मुबारक कहूँगा,</para>
  <para style="q" vid="PSA 34:1">उसकी सिताइश हमेशा मेरी ज़बान पर रहेगी।<verse eid="PSA 34:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 34:2"/>मेरी रूह ख़ुदावन्द पर फ़ख़्र करेगी;</para>
  <para style="q" vid="PSA 34:2">हलीम यह सुनकर ख़ुश होंगे।<verse eid="PSA 34:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 34:3"/>मेरे साथ ख़ुदावन्द की बड़ाई करो,</para>
  <para style="q" vid="PSA 34:3">हम मिलकर उसके नाम की तम्जीद करें।<verse eid="PSA 34:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 34:4"/>मैं ख़ुदावन्द का तालिब हुआ, उसने मुझे जवाब दिया,</para>
  <para style="q" vid="PSA 34:4">और मेरी सारी दहशत से मुझे रिहाई बख़्शी।<verse eid="PSA 34:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 34:5"/>उन्होंने उसकी तरफ़ नज़र की और मुनव्वर हो गए;</para>
  <para style="q" vid="PSA 34:5">और उनके मुँह पर कभी शर्मिन्दगी न आएगी।<verse eid="PSA 34:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 34:6"/>इस ग़रीब ने दुहाई दी, ख़ुदावन्द ने इसकी सुनी,</para>
  <para style="q" vid="PSA 34:6">और इसे इसके सब दुखों से बचा लिया।<verse eid="PSA 34:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 34:7"/>ख़ुदावन्द से डरने वालों के चारों तरफ़ उसका फ़रिश्ता ख़ेमाज़न होता है</para>
  <para style="q" vid="PSA 34:7">और उनको बचाता है।<verse eid="PSA 34:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 34:8"/>आज़माकर देखो, कि ख़ुदावन्द कैसा मेहरबान है!</para>
  <para style="q" vid="PSA 34:8">वह आदमी जो उस पर भरोसा करता है।<verse eid="PSA 34:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 34:9"/>ख़ुदावन्द से डरो, ऐ उसके पाक लोगों!</para>
  <para style="q" vid="PSA 34:9">क्यूँकि जो उससे डरते हैं उनको कुछ कमी नहीं।<verse eid="PSA 34:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 34:10"/>बबर के बच्चे तो हाजतमंद और भूके होते हैं,</para>
  <para style="q" vid="PSA 34:10">लेकिन ख़ुदावन्द के तालिब किसी ने'मत के मोहताज न हाँगे।<verse eid="PSA 34:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 34:11"/>ऐ बच्चो, आओ मेरी सुनो,</para>
  <para style="q" vid="PSA 34:11">मैं तुम्हें ख़ुदा से डरना सिखाऊँगा।<verse eid="PSA 34:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 34:12"/>वह कौन आदमी है जो ज़िन्दगी का मुश्ताक़ है,</para>
  <para style="q" vid="PSA 34:12">और बड़ी उम्र चाहता है ताकि भलाई देखें?<verse eid="PSA 34:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 34:13"/>अपनी ज़बान को बदी से बाज़ रख,</para>
  <para style="q" vid="PSA 34:13">और अपने होंटों को दग़ा की बात से।<verse eid="PSA 34:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 34:14"/>बुराई को छोड़ और नेकी कर;</para>
  <para style="q" vid="PSA 34:14">सुलह का तालिब हो और उसी की पैरवी कर।<verse eid="PSA 34:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 34:15"/>ख़ुदावन्द की निगाह सादिकों पर है,</para>
  <para style="q" vid="PSA 34:15">और उसके कान उनकी फ़रियाद पर लगे रहते हैं।<verse eid="PSA 34:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 34:16"/>ख़ुदावन्द का चेहरा बदकारों के ख़िलाफ़ है,</para>
  <para style="q" vid="PSA 34:16">ताकि उनकी याद ज़मीन पर से मिटा दे।<verse eid="PSA 34:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 34:17"/>सादिक़ चिल्लाए, और ख़ुदावन्द ने सुना;</para>
  <para style="q" vid="PSA 34:17">और उनको उनके सब दुखों से छुड़ाया।<verse eid="PSA 34:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 34:18"/>ख़ुदावन्द शिकस्ता दिलों के नज़दीक है,</para>
  <para style="q" vid="PSA 34:18">और ख़स्ता ज़ानों को बचाता है।<verse eid="PSA 34:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 34:19"/>सादिक की मुसीबतें बहुत हैं,</para>
  <para style="q" vid="PSA 34:19">लेकिन ख़ुदावन्द उसको उन सबसे रिहाई बख्शता है।<verse eid="PSA 34:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 34:20"/>वह उसकी सब हड्डियों को महफूज़ रखता है;</para>
  <para style="q" vid="PSA 34:20">उनमें से एक भी तोड़ी नहीं जाती।<verse eid="PSA 34:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 34:21"/>बुराई शरीर को हलाक कर देगी;</para>
  <para style="q" vid="PSA 34:21">और सादिक़ से 'अदावत रखने वाले मुजरिम ठहरेंगे।<verse eid="PSA 34:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 34:22"/>ख़ुदावन्द अपने बन्दों की जान का फ़िदिया देता है;</para>
  <para style="q" vid="PSA 34:22">और जो उस पर भरोसा करते हैं उनमें से कोई मुजरिम न ठहरेगा।<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 35:1"/>ऐ ख़ुदावन्द, जो मुझ से झगड़ते हैं तू उनसे झगड़;</para>
  <para style="q" vid="PSA 35:1">जो मुझ से लड़ते हैं तू उनसे लड़।<verse eid="PSA 35:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2"/>ढाल और सिपर लेकर मेरी मदद के लिए खड़ा हो।<verse eid="PSA 35:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3"/>भाला भी निकाल और मेरा पीछा करने वालों का रास्ता बंद कर दे;</para>
  <para style="q" vid="PSA 35:3">मेरी जान से कह, मैं तेरी नजात हूँ।<verse eid="PSA 35:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4"/>जो मेरी जान के तलबगार हैं,</para>
  <para style="q" vid="PSA 35:4">वह शर्मिन्दा और रुस्वा हों।</para>
  <para style="q" vid="PSA 35:4">जो मेरे नुक़्सान का मन्सूबा बाँधते हैं,</para>
  <para style="q" vid="PSA 35:4">वह पसपा और परेशान हों।<verse eid="PSA 35:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5"/>वह ऐसे हो जाएँ जैसे हवा के आगे भूसा,</para>
  <para style="q" vid="PSA 35:5">और ख़ुदावन्द का फ़रिश्ता उनको हाँकता रहे।<verse eid="PSA 35:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6"/>उनकी राह अँधेरी और फिसलनी हो जाए,</para>
  <para style="q" vid="PSA 35:6">और ख़ुदावन्द का फ़रिश्ता उनको दौड़ाता जाए।<verse eid="PSA 35:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7"/>क्यूँकि उन्होंने बे वजह मेरे लिए गढ़े में जाल बिछाया,</para>
  <para style="q" vid="PSA 35:7">और नाहक़ मेरी जान के लिए गढ़ा खोदा है।<verse eid="PSA 35:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8"/>उस पर अचानक तबाही आ पड़े!</para>
  <para style="q" vid="PSA 35:8">और जिस जाल को उसने बिछाया है उसमें आप ही फसे;</para>
  <para style="q" vid="PSA 35:8">और उसी हलाकत में गिरफ़्तार हो।<verse eid="PSA 35:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9"/>लेकिन मेरी जान ख़ुदावन्द में खु़श रहेगी,</para>
  <para style="q" vid="PSA 35:9">और उसकी नजात से शादमान होगी।<verse eid="PSA 35:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10"/>मेरी सब हड्डियाँ कहेंगी, “ऐ ख़ुदावन्द तुझ सा कौन है,</para>
  <para style="q" vid="PSA 35:10">जो ग़रीब को उसके हाथ से जो उससे ताक़तवर है,</para>
  <para style="q" vid="PSA 35:10">और ग़रीब — ओ — मोहताज को ग़ारतगर से छुड़ाता है?”<verse eid="PSA 35:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11"/>झूटे गवाह उठते हैं;</para>
  <para style="q" vid="PSA 35:11">और जो बातें मैं नहीं जानता, वह मुझ से पूछते हैं।<verse eid="PSA 35:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12"/>वह मुझ से नेकी के बदले बदी करते हैं,</para>
  <para style="q" vid="PSA 35:12">यहाँ तक कि मेरी जान बेकस हो जाती है।<verse eid="PSA 35:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13"/>लेकिन मैंने तो उनकी बीमारी में जब वह बीमार थे,</para>
  <para style="q" vid="PSA 35:13">टाट ओढ़ा और रोज़े रख कर अपनी जान को दुख दिया;</para>
  <para style="q" vid="PSA 35:13">और मेरी दुआ मेरे ही सीने में वापस आई।<verse eid="PSA 35:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14"/>मैंने तो ऐसा किया जैसे वह मेरा दोस्त या मेरा भाई था;</para>
  <para style="q" vid="PSA 35:14">मैंने सिर झुका कर ग़म किया जैसे कोई अपनी माँ के लिए मातम करता हो।<verse eid="PSA 35:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15"/>लेकिन जब मैं लंगड़ाने लगा तो वह ख़ुश होकर इकट्ठे हो गए,</para>
  <para style="q" vid="PSA 35:15">कमीने मेरे ख़िलाफ़ इकट्ठा हुए और मुझे मा'लूम न था;</para>
  <para style="q" vid="PSA 35:15">उन्होंने मुझे फाड़ा और बाज़ न आए।<verse eid="PSA 35:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16"/>ज़ियाफ़तों के बदतमीज़ मसखरों की तरह,</para>
  <para style="q" vid="PSA 35:16">उन्होंने मुझ पर दाँत पीसे।<verse eid="PSA 35:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17"/>ऐ ख़ुदावन्द, तू कब तक देखता रहेगा?</para>
  <para style="q" vid="PSA 35:17">मेरी जान को उनकी ग़ारतगरी से,</para>
  <para style="q" vid="PSA 35:17">मेरी जान को शेरों से छुड़ा।<verse eid="PSA 35:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18"/>मैं बड़े मजमे' में तेरी शुक्रगुज़ारी करूँगा</para>
  <para style="q" vid="PSA 35:18">मैं बहुत से लोगों में तेरी सिताइश करूँगा।<verse eid="PSA 35:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19"/>जो नाहक़ मेरे दुश्मन हैं, मुझ पर ख़ुशी न मनाएँ;</para>
  <para style="q" vid="PSA 35:19">और जो मुझ से बे वजह 'अदावत रखते हैं,</para>
  <para style="q" vid="PSA 35:19">चश्मक ज़नी न करें।<verse eid="PSA 35:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20"/>क्यूँकि वह सलामती की बातें नहीं करते,</para>
  <para style="q" vid="PSA 35:20">बल्कि मुल्क के अमन पसंद लोगों के ख़िलाफ़,</para>
  <para style="q" vid="PSA 35:20">मक्र के मन्सूबे बाँधते हैं।<verse eid="PSA 35:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21"/>यहाँ तक कि उन्होंने ख़ूब मुँह फाड़ा और कहा,</para>
  <para style="q" vid="PSA 35:21">“अहा! अहा! हम ने अपनी आँख से देख लिया है!”<verse eid="PSA 35:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22"/>ऐ ख़ुदावन्द, तूने ख़ुद यह देखा है;</para>
  <para style="q" vid="PSA 35:22">ख़ामोश न रह! ऐ ख़ुदावन्द, मुझ से दूर न रह!<verse eid="PSA 35:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23"/>उठ, मेरे इन्साफ़ के लिए जाग,</para>
  <para style="q" vid="PSA 35:23">और मेरे मु'आमिले के लिए,</para>
  <para style="q" vid="PSA 35:23">ऐ मेरे ख़ुदा! ऐ मेरे ख़ुदावन्द!<verse eid="PSA 35:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24"/>अपनी सदाक़त के मुताबिक़ मेरी'अदालत कर,</para>
  <para style="q" vid="PSA 35:24">ऐ ख़ुदावन्द, मेरे ख़ुदा! और उनको मुझ पर ख़ुशी न मनाने दे।<verse eid="PSA 35:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25"/>वह अपने दिल में यह न कहने पाएँ,</para>
  <para style="q" vid="PSA 35:25">“अहा! हम तो यही चाहते थे!”</para>
  <para style="q" vid="PSA 35:25">वह यह न कहें, कि हम उसे निगल गए।<verse eid="PSA 35:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26"/>जो मेरे नुक़सान से ख़ुश होते हैं,</para>
  <para style="q" vid="PSA 35:26">वह आपस में शर्मिन्दा और परेशान हों!</para>
  <para style="q" vid="PSA 35:26">जो मेरे मुक़ाबले में तकब्बुर करते हैं वह शर्मिन्दगी और रुस्वाई से मुलब्बस हों।<verse eid="PSA 35:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27"/>जो मेरे सच्चे मु'आमिले की ताईद करते हैं,</para>
  <para style="q" vid="PSA 35:27">वह ख़ुशी से ललकारें और ख़ुशहों;</para>
  <para style="q" vid="PSA 35:27">वह हमेशा यह कहें, ख़ुदावन्द की तम्जीद हो,</para>
  <para style="q" vid="PSA 35:27">जिसकी ख़ुशनूदी अपने बन्दे की इक़बालमन्दी में है!<verse eid="PSA 35:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28"/>तब मेरी ज़बान से तेरी सदाकत का ज़िक्र होगा,</para>
  <para style="q" vid="PSA 35:28">और दिन भर तेरी ता'रीफ़ होगी।<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 36:1"/>शरीर की बदी से मेरे दिल में ख़याल आता है,</para>
  <para style="q" vid="PSA 36:1">कि ख़ुदा का ख़ौफ़ उसके सामने नहीं।<verse eid="PSA 36:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 36:2"/>क्यूँकि वह अपने आपको अपनी नज़र में इस ख़याल से तसल्ली देता है,</para>
  <para style="q" vid="PSA 36:2">कि उसकी बदी न तो फ़ाश होगी, न मकरूह समझी जाएगी।<verse eid="PSA 36:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 36:3"/>उसके मुँह में बदी और फ़रेब की बातें हैं;</para>
  <para style="q" vid="PSA 36:3">वह 'अक़्ल और नेकी से दस्तबरदार हो गया है।<verse eid="PSA 36:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 36:4"/>वह अपने बिस्तर पर बदी के मन्सूबे बाँधता है;</para>
  <para style="q" vid="PSA 36:4">वह ऐसी राह इख़्तियार करता है जो अच्छी नहीं;</para>
  <para style="q" vid="PSA 36:4">वह बुराई से नफ़रत नहीं करता।<verse eid="PSA 36:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 36:5"/>ऐ ख़ुदावन्द, आसमान में तेरी शफ़क़त है,</para>
  <para style="q" vid="PSA 36:5">तेरी वफ़ादारी फ़लाक तक बुलन्द है।<verse eid="PSA 36:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 36:6"/>तेरी सदाक़त ख़ुदा के पहाड़ों की तरह है,</para>
  <para style="q" vid="PSA 36:6">तेरे अहकाम बहुत गहरे हैं; ऐ ख़ुदावन्द,</para>
  <para style="q" vid="PSA 36:6">तू इंसान और हैवान दोनों को महफ़ूज़ रखता है।<verse eid="PSA 36:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 36:7"/>ऐ ख़ुदा, तेरी शफ़क़त क्या ही बेशक़ीमत है!</para>
  <para style="q" vid="PSA 36:7">बनी आदम तेरे बाज़ुओं के साये में पनाह लेते हैं।<verse eid="PSA 36:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 36:8"/>वह तेरे घर की ने'मतों से ख़ूब आसूदा होंगे,</para>
  <para style="q" vid="PSA 36:8">तू उनको अपनी ख़ुशनूदी के दरिया में से पिलाएगा।<verse eid="PSA 36:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 36:9"/>क्यूँकि ज़िन्दगी का चश्मा तेरे पास है;</para>
  <para style="q" vid="PSA 36:9">तेरे नूर की बदौलत हम रोशनी देखेंगे।<verse eid="PSA 36:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 36:10"/>तेरे पहचानने वालों पर तेरी शफ़क़त हमेशा की हो,</para>
  <para style="q" vid="PSA 36:10">और रास्त दिलों पर तेरी सदाकत!<verse eid="PSA 36:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 36:11"/>मग़रूर आदमी मुझ पर लात न उठाने पाए,</para>
  <para style="q" vid="PSA 36:11">और शरीर का हाथ मुझे हाँक न दे।<verse eid="PSA 36:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 36:12"/>बदकिरदार वहाँ गिरे पड़े हैं;</para>
  <para style="q" vid="PSA 36:12">वह गिरा दिए गए हैं और फिर उठ न सकेंगे।<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 37:1"/>तू बदकिरदारों की वजह से बेज़ार न हो,</para>
  <para style="q" vid="PSA 37:1">और बदी करने वालों पर रश्क न कर!<verse eid="PSA 37:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2"/>क्यूँकि वह घास की तरह जल्द काट डाले जाएँगे,</para>
  <para style="q" vid="PSA 37:2">और हरियाली की तरह मुरझा जाएँगे।<verse eid="PSA 37:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3"/>ख़ुदावन्द पर भरोसा कर, और नेकी कर;</para>
  <para style="q" vid="PSA 37:3">मुल्क में आबाद रह, और उसकी वफ़ादारी से परवरिश पा।<verse eid="PSA 37:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4"/>ख़ुदावन्द में मसरूर रह,</para>
  <para style="q" vid="PSA 37:4">और वह तेरे दिल की मुरादें पूरी करेगा।<verse eid="PSA 37:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5"/>अपनी राह ख़ुदावन्द पर छोड़ दे:</para>
  <para style="q" vid="PSA 37:5">और उस पर भरोसा कर,</para>
  <para style="q" vid="PSA 37:5">वही सब कुछ करेगा।<verse eid="PSA 37:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6"/>वह तेरी रास्तबाज़ी को नूर की तरह,</para>
  <para style="q" vid="PSA 37:6">और तेरे हक़ को दोपहर की तरह रोशन करेगा।<verse eid="PSA 37:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7"/>ख़ुदावन्द में मुतम'इन रह, और सब्र से उसकी आस रख;</para>
  <para style="q" vid="PSA 37:7">उस आदमी की वजह से जो अपनी राह में कामयाब होता</para>
  <para style="q" vid="PSA 37:7">और बुरे मन्सूबों को अंजाम देता है, बेज़ार न हो।<verse eid="PSA 37:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8"/>क़हर से बाज़ आ और ग़ज़ब को छोड़ दे!</para>
  <para style="q" vid="PSA 37:8">बेज़ार न हो, इससे बुराई ही निकलती है।<verse eid="PSA 37:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9"/>क्यूँकि बदकार काट डाले जाएँगे;</para>
  <para style="q" vid="PSA 37:9">लेकिन जिनको ख़ुदावन्द की आस है,</para>
  <para style="q" vid="PSA 37:9">मुल्क के वारिस होंगे।<verse eid="PSA 37:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10"/>क्यूँकि थोड़ी देर में शरीर नाबूद हो जाएगा;</para>
  <para style="q" vid="PSA 37:10">तू उसकी जगह को ग़ौर से देखेगा पर वह न होगा।<verse eid="PSA 37:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11"/>लेकिन हलीम मुल्क के वारिस होंगे,</para>
  <para style="q" vid="PSA 37:11">और सलामती की फ़िरावानी से ख़ुश रहेंगे।<verse eid="PSA 37:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12"/>शरीर रास्तबाज़ के ख़िलाफ़ बन्दिशें बाँधता है,</para>
  <para style="q" vid="PSA 37:12">और उस पर दाँत पीसता है;<verse eid="PSA 37:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13"/>ख़ुदावन्द उस पर हंसेगा,</para>
  <para style="q" vid="PSA 37:13">क्यूँकि वह देखता है कि उसका दिनआता है।<verse eid="PSA 37:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14"/>शरीरों ने तलवार निकाली और कमान खींची है,</para>
  <para style="q" vid="PSA 37:14">ताकि ग़रीब और मुहताज को गिरा दें,</para>
  <para style="q" vid="PSA 37:14">और रास्तरों को क़त्ल करें।<verse eid="PSA 37:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15"/>उनकी तलवार उन ही के दिल को छेदेगी,</para>
  <para style="q" vid="PSA 37:15">और उनकी कमानें तोड़ी जाएँगी।<verse eid="PSA 37:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16"/>सादिक़ का थोड़ा सा माल,</para>
  <para style="q" vid="PSA 37:16">बहुत से शरीरों की दौलत से बेहतर है।<verse eid="PSA 37:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17"/>क्यूँकि शरीरों के बाज़ू तोड़े जाएँगे,</para>
  <para style="q" vid="PSA 37:17">लेकिन ख़ुदावन्द सादिकों को संभालता है।<verse eid="PSA 37:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18"/>कामिल लोगों के दिनों को ख़ुदावन्द जानता है,</para>
  <para style="q" vid="PSA 37:18">उनकी मीरास हमेशा के लिए होगी।<verse eid="PSA 37:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19"/>वह आफ़त के वक़्त शर्मिन्दा न होंगे,</para>
  <para style="q" vid="PSA 37:19">और काल के दिनों में आसूदा रहेंगे।<verse eid="PSA 37:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20"/>लेकिन शरीर हलाक होंगे,</para>
  <para style="q" vid="PSA 37:20">ख़ुदावन्द के दुश्मन चरागाहों की सरसब्ज़ी की तरह होंगे;</para>
  <para style="q" vid="PSA 37:20">वह फ़ना हो जाएँगे,</para>
  <para style="q" vid="PSA 37:20">वह धुएँ की तरह जाते रहेंगे।<verse eid="PSA 37:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21"/>शरीर क़र्ज़ लेता है और अदा नहीं करता,</para>
  <para style="q" vid="PSA 37:21">लेकिन सादिक़ रहम करता है और देता है।<verse eid="PSA 37:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22"/>क्यूँकि जिनको वह बरकत देता है,</para>
  <para style="q" vid="PSA 37:22">वह ज़मीन के वारिस होंगे;</para>
  <para style="q" vid="PSA 37:22">और जिन पर वह ला'नत करता है,</para>
  <para style="q" vid="PSA 37:22">वह काट डाले जाएँगे।<verse eid="PSA 37:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23"/>इंसान की चाल चलन ख़ुदावन्द की तरफ़ से क़ाईम हैं,</para>
  <para style="q" vid="PSA 37:23">और वह उसकी राह से ख़ुश है;<verse eid="PSA 37:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24"/>अगर वह गिर भी जाए तो पड़ा न रहेगा,</para>
  <para style="q" vid="PSA 37:24">क्यूँकि ख़ुदावन्द उसे अपने हाथ से संभालता है।<verse eid="PSA 37:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25"/>मैं जवान था और अब बूढ़ा हूँ तोभी मैंने सादिक़ को बेकस,</para>
  <para style="q" vid="PSA 37:25">और उसकी औलाद को टुकड़े माँगते नहीं देखा।<verse eid="PSA 37:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26"/>वह दिन भर रहम करता है और क़र्ज़ देता है,</para>
  <para style="q" vid="PSA 37:26">और उसकी औलाद को बरकत मिलती है।<verse eid="PSA 37:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27"/>बदी को छोड़ दे और नेकी कर;</para>
  <para style="q" vid="PSA 37:27">और हमेशा तक आबाद रह।<verse eid="PSA 37:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28"/>क्यूँकि ख़ुदावन्द इन्साफ़ को पसंद करता है:</para>
  <para style="q" vid="PSA 37:28">और अपने पाक लोगों को नहीं छोड़ता।</para>
  <para style="q" vid="PSA 37:28">वह हमेशा के लिए महफ़ूज़ हैं,</para>
  <para style="q" vid="PSA 37:28">लेकिन शरीरों की नसल काट डाली जाएगी।<verse eid="PSA 37:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29"/>सादिक़ ज़मीन के वारिस होंगे,</para>
  <para style="q" vid="PSA 37:29">और उसमें हमेशा बसे रहेंगे।<verse eid="PSA 37:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30"/>सादिक़ के मुँह से दानाई निकलती है,</para>
  <para style="q" vid="PSA 37:30">और उसकी ज़बान से इन्साफ़ की बातें।<verse eid="PSA 37:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31"/>उसके ख़ुदा की शरी'अत उसके दिल में है,</para>
  <para style="q" vid="PSA 37:31">वह अपनी चाल चलन में फिसलेगा नहीं।<verse eid="PSA 37:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32"/>शरीर सादिक़ की ताक में रहता है;</para>
  <para style="q" vid="PSA 37:32">और उसे क़त्ल करना चाहता है।<verse eid="PSA 37:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33"/>ख़ुदावन्द उसे उसके हाथ में नहीं छोड़ेगा,</para>
  <para style="q" vid="PSA 37:33">और जब उसकी 'अदालत हो तो उसे मुजरिम न ठहराएगा।<verse eid="PSA 37:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34"/>ख़ुदावन्द की उम्मीद रख,</para>
  <para style="q" vid="PSA 37:34">और उसी की राह पर चलता रह,</para>
  <para style="q" vid="PSA 37:34">और वह तुझे सरफ़राज़ करके ज़मीन का वारिस बनाएगा;</para>
  <para style="q" vid="PSA 37:34">जब शरीर काट डाले जाएँगे, तो तू देखेगा।<verse eid="PSA 37:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35"/>मैंने शरीर को बड़े इक्तिदार में और ऐसा फैलता देखा,</para>
  <para style="q" vid="PSA 37:35">जैसे कोई हरा दरख़्त अपनी असली ज़मीन में फैलता है।<verse eid="PSA 37:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36"/>लेकिन जब कोई उधर से गुज़राऔर देखा तो वह था ही नहीं;</para>
  <para style="q" vid="PSA 37:36">बल्कि मैंने उसे ढूंढा लेकिन वह न मिला।<verse eid="PSA 37:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37"/>कामिल आदमी पर निगाह कर और रास्तबाज़ को देख,</para>
  <para style="q" vid="PSA 37:37">क्यूँकि सुलह दोस्त आदमी के लिए अज्र है।<verse eid="PSA 37:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38"/>लेकिन ख़ताकार इकट्ठे मर मिटेंगे;</para>
  <para style="q" vid="PSA 37:38">शरीरों का अंजाम हलाकत है।<verse eid="PSA 37:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39"/>लेकिन सादिकों की नजात ख़ुदावन्द की तरफ़ से है;</para>
  <para style="q" vid="PSA 37:39">मुसीबत के वक़्त वह उनका मज़बूत क़िला है।<verse eid="PSA 37:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40"/>और ख़ुदावन्द उनकी मदद करताऔर उनको बचाता है;</para>
  <para style="q" vid="PSA 37:40">वह उनको शरीरों से छुड़ाता और बचा लेता है,</para>
  <para style="q" vid="PSA 37:40">इसलिए कि उन्होंने उसमें पनाह ली है।<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 38:1"/>ऐ ख़ुदावन्द, अपने क़हर में मुझे झिड़क न दे,</para>
  <para style="q" vid="PSA 38:1">और अपने ग़ज़ब में मुझे तम्बीह न कर।<verse eid="PSA 38:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 38:2"/>क्यूँकि तेरे दुख मुझ में लगे हैं,</para>
  <para style="q" vid="PSA 38:2">और तेरा हाथ मुझ पर भारी है।<verse eid="PSA 38:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 38:3"/>तेरे क़हर की वजह से मेरे जिस्म में सिहत नहीं;</para>
  <para style="q" vid="PSA 38:3">और मेरे गुनाह की वजह से मेरी हड्डियों को आराम नहीं।<verse eid="PSA 38:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 38:4"/>क्यूँकि मेरी बदी मेरे सिर से गुज़र गई,</para>
  <para style="q" vid="PSA 38:4">और वह बड़े बोझ की तरह मेरे लिए बहुत भारी है।<verse eid="PSA 38:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 38:5"/>मेरी बेवक़ूफ़ी की वजह से,</para>
  <para style="q" vid="PSA 38:5">मेरे ज़ख़्मों से बदबू आती है, वह सड़ गए हैं।<verse eid="PSA 38:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 38:6"/>मैं पुरदर्द और बहुत झुका हुआ हूँ;</para>
  <para style="q" vid="PSA 38:6">मैं दिन भर मातम करता फिरता हूँ।<verse eid="PSA 38:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 38:7"/>क्यूँकि मेरी कमर में दर्द ही दर्द है,</para>
  <para style="q" vid="PSA 38:7">और मेरे जिस्म में कुछ सिहत नहीं।<verse eid="PSA 38:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 38:8"/>मैं कमज़ोर और बहुत कुचला हुआ हूँ</para>
  <para style="q" vid="PSA 38:8">और दिल की बेचैनी की वजह से कराहता रहा।<verse eid="PSA 38:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 38:9"/>ऐ ख़ुदावन्द, मेरी सारी तमन्ना तेरे सामने है,</para>
  <para style="q" vid="PSA 38:9">और मेरा कराहना तुझ से छिपा नहीं।<verse eid="PSA 38:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 38:10"/>मेरा दिल धड़कता है, मेरी ताक़त घटी जाती है;</para>
  <para style="q" vid="PSA 38:10">मेरी आँखों की रोशनी भी मुझ से जाती रही।<verse eid="PSA 38:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 38:11"/>मेरे 'अज़ीज़ और दोस्त मेरी बला में अलग हो गए,</para>
  <para style="q" vid="PSA 38:11">और मेरे रिश्तेदार दूर जा खड़े हुए।<verse eid="PSA 38:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 38:12"/>मेरी जान के तलबगार मेरे लिए जाल बिछाते हैं,</para>
  <para style="q" vid="PSA 38:12">और मेरे नुक़सान के तालिब शरारत की बातें बोलते,</para>
  <para style="q" vid="PSA 38:12">और दिन भर मक्र — ओ — फ़रेब के मन्सूबे बाँधते हैं।<verse eid="PSA 38:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 38:13"/>लेकिन मैं बहरे की तरह सुनता ही नहीं,</para>
  <para style="q" vid="PSA 38:13">मैं गूँगे की तरह मुँह नहीं खोलता।<verse eid="PSA 38:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 38:14"/>बल्कि मैं उस आदमी की तरह हूँ जिसे सुनाई नहीं देता,</para>
  <para style="q" vid="PSA 38:14">और जिसके मुँह में मलामत की बातें नहीं।<verse eid="PSA 38:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 38:15"/>क्यूँकि ऐ ख़ुदावन्द,</para>
  <para style="q" vid="PSA 38:15">मुझे तुझ से उम्मीद है,</para>
  <para style="q" vid="PSA 38:15">ऐ ख़ुदावन्द, मेरे ख़ुदा!</para>
  <para style="q" vid="PSA 38:15">तू जवाब देगा।<verse eid="PSA 38:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 38:16"/>क्यूँकि मैंने कहा,</para>
  <para style="q" vid="PSA 38:16">कि कहीं वह मुझ पर ख़ुशी न मनाएँ,</para>
  <para style="q" vid="PSA 38:16">जब मेरा पाँव फिसलता है,</para>
  <para style="q" vid="PSA 38:16">तो वह मेरे ख़िलाफ़ तकब्बुर करते हैं।<verse eid="PSA 38:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 38:17"/>क्यूँकि मैं गिरने ही को हूँ,</para>
  <para style="q" vid="PSA 38:17">और मेरा ग़म बराबर मेरे सामने है।<verse eid="PSA 38:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 38:18"/>इसलिए कि मैं अपनी बदी को ज़ाहिर करूँगा,</para>
  <para style="q" vid="PSA 38:18">और अपने गुनाह की वजह से ग़मगीन रहूँगा।<verse eid="PSA 38:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 38:19"/>लेकिन मेरे दुश्मन चुस्त और ज़बरदस्त हैं,</para>
  <para style="q" vid="PSA 38:19">और मुझ से नाहक 'अदावत रखने वाले बहुत हो गए हैं।<verse eid="PSA 38:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 38:20"/>जो नेकी के बदले बदी करते हैं,</para>
  <para style="q" vid="PSA 38:20">वह भी मेरे मुख़ालिफ़ हैं;</para>
  <para style="q" vid="PSA 38:20">क्यूँकि मैं नेकी की पैरवी करता हूँ।<verse eid="PSA 38:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 38:21"/>ऐ ख़ुदावन्द, मुझे छोड़ न दे!</para>
  <para style="q" vid="PSA 38:21">ऐ मेरे ख़ुदा, मुझ से दूर न हो!<verse eid="PSA 38:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 38:22"/>ऐ ख़ुदावन्द! ऐ मेरी नजात!</para>
  <para style="q" vid="PSA 38:22">मेरी मदद के लिए जल्दी कर!<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 39:1"/>मैंने कहा “मैं अपनी राह की निगरानी करूँगा,</para>
  <para style="q" vid="PSA 39:1">ताकि मेरी ज़बान से ख़ता न हो;</para>
  <para style="q" vid="PSA 39:1">जब तक शरीर मेरे सामने है,</para>
  <para style="q" vid="PSA 39:1">मैं अपने मुँह को लगाम दिए रहूँगा।”<verse eid="PSA 39:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 39:2"/>मैं गूंगा बनकर ख़ामोश रहा,</para>
  <para style="q" vid="PSA 39:2">और नेकी की तरफ़ से भी ख़ामोशी इख़्तियार की;</para>
  <para style="q" vid="PSA 39:2">और मेरा ग़म बढ़ गया।<verse eid="PSA 39:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 39:3"/>मेरा दिल अन्दर ही अन्दर जल रहा था।</para>
  <para style="q" vid="PSA 39:3">सोचते सोचते आग भड़क उठी,</para>
  <para style="q" vid="PSA 39:3">तब मैं अपनी ज़बान से कहने लगा,<verse eid="PSA 39:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 39:4"/>“ऐ ख़ुदावन्द! ऐसा कर कि मैं अपने अंजाम से वाकिफ़ हो जाऊँ,</para>
  <para style="q" vid="PSA 39:4">और इससे भी कि मेरी उम्र की मी'आद क्या है;</para>
  <para style="q" vid="PSA 39:4">मैं जान लूँ कि कैसा फ़ानी हूँ!<verse eid="PSA 39:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 39:5"/>देख, तूने मेरी उम्र बालिश्त भर की रख्खी है,</para>
  <para style="q" vid="PSA 39:5">और मेरी ज़िन्दगी तेरे सामने बे हक़ीक़त है।</para>
  <para style="q" vid="PSA 39:5">यक़ीनन हर इंसान बेहतरीन हालत में भी बिल्कुल बेसबात है सिलाह<verse eid="PSA 39:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 39:6"/>दर हक़ीकत इंसान साये की तरह चलता फिरता है;</para>
  <para style="q" vid="PSA 39:6">यक़ीनन वह फ़जूल घबराते हैं;</para>
  <para style="q" vid="PSA 39:6">वह ज़ख़ीरा करता है और यह नहीं जानता के उसे कौन लेगा!<verse eid="PSA 39:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 39:7"/>“ऐ ख़ुदावन्द! अब मैं किस बात के लिए ठहरा हूँ?</para>
  <para style="q" vid="PSA 39:7">मेरी उम्मीद तुझ ही से है।<verse eid="PSA 39:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 39:8"/>मुझ को मेरी सब ख़ताओं से रिहाई दे।</para>
  <para style="q" vid="PSA 39:8">बेवक़ूफ़ों को मुझ पर अंगुली न उठाने दे।<verse eid="PSA 39:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 39:9"/>मैं गूंगा बना,</para>
  <para style="q" vid="PSA 39:9">मैंने मुँह न खोला क्यूँकि तू ही ने यह किया है।<verse eid="PSA 39:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 39:10"/>मुझ से अपनी बला दूर कर दे;</para>
  <para style="q" vid="PSA 39:10">मैं तो तेरे हाथ की मार से फ़ना हुआ जाता हूँ।<verse eid="PSA 39:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 39:11"/>जब तू इंसान को बदी पर मलामत करके तम्बीह करता है;</para>
  <para style="q" vid="PSA 39:11">तो उसके हुस्न को पतंगे की तरह फ़ना कर देता है;</para>
  <para style="q" vid="PSA 39:11">यक़ीनन हर इंसान बेसबात है। सिलाह<verse eid="PSA 39:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 39:12"/>“ऐ ख़ुदावन्द! मेरी दुआ सुन और मेरी फ़रियाद पर कान लगा;</para>
  <para style="q" vid="PSA 39:12">मेरे आँसुओं को देखकर ख़ामोश न रह!</para>
  <para style="q" vid="PSA 39:12">क्यूँकि मैं तेरे सामने परदेसी और मुसाफ़िर हूँ,</para>
  <para style="q" vid="PSA 39:12">जैसे मेरे सब बाप — दादा थे।<verse eid="PSA 39:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 39:13"/>आह! मुझ से नज़र हटा ले ताकि ताज़ा दम हो जाऊँ,</para>
  <para style="q" vid="PSA 39:13">इससे पहले के मर जाऊँ और हलाक हो जाऊँ।”<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 40:1"/>मैंने सब्र से ख़ुदावन्द पर उम्मीद रख्खी</para>
  <para style="q" vid="PSA 40:1">उसने मेरी तरफ़ माइल होकर मेरी फ़रियाद सुनी।<verse eid="PSA 40:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 40:2"/>उसने मुझे हौलनाक गढ़े</para>
  <para style="q" vid="PSA 40:2">और दलदल की कीचड़ में से निकाला,</para>
  <para style="q" vid="PSA 40:2">और उसने मेरे पाँव चट्टान पर रख्खे</para>
  <para style="q" vid="PSA 40:2">और मेरी चाल चलन क़ाईम की<verse eid="PSA 40:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 40:3"/>उसने हमारे ख़ुदा की सिताइश का नया हम्द मेरे मुँह में डाला।</para>
  <para style="q" vid="PSA 40:3">बहुत से देखेंगे और डरेंगे,</para>
  <para style="q" vid="PSA 40:3">और ख़ुदावन्द पर भरोसा करेंगे।<verse eid="PSA 40:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 40:4"/>मुबारक है वह आदमी,</para>
  <para style="q" vid="PSA 40:4">जो ख़ुदावन्द पर भरोसा करता है,</para>
  <para style="q" vid="PSA 40:4">और मग़रूर और झूठे दोस्तों की तरफ़ माइल नहीं होता।<verse eid="PSA 40:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 40:5"/>ऐ ख़ुदावन्द मेरे ख़ुदा! जो 'अजीब काम तूने किए,</para>
  <para style="q" vid="PSA 40:5">और तेरे ख़याल जो हमारी तरफ़ हैं, वह बहुत से हैं।</para>
  <para style="q" vid="PSA 40:5">मैं उनको तेरे सामने तरतीब नहीं दे सकता;</para>
  <para style="q" vid="PSA 40:5">अगर मैं उनका ज़िक्र और बयान करना चाहूँ तो वह शुमार से बाहर हैं।<verse eid="PSA 40:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 40:6"/>क़ुर्बानी और नज़्र को तू पसंद नहीं करता,</para>
  <para style="q" vid="PSA 40:6">तूने मेरे कान खोल दिए हैं।</para>
  <para style="q" vid="PSA 40:6">सोख़्तनी क़ुर्बानी तूने तलब नहीं की।<verse eid="PSA 40:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 40:7"/>तब मैंने कहा, “देख! मैं आया हूँ।</para>
  <para style="q" vid="PSA 40:7">किताब के तूमार में मेरे बारे लिखा है।<verse eid="PSA 40:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 40:8"/>ऐ मेरे ख़ुदा, मेरी ख़ुशी तेरी मर्ज़ी पूरी करने में है;</para>
  <para style="q" vid="PSA 40:8">बल्कि तेरी शरी'अत मेरे दिल में है।”<verse eid="PSA 40:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 40:9"/>मैंने बड़े मजमे' में सदाक़त की बशारत दी है;</para>
  <para style="q" vid="PSA 40:9">देख! मैं अपना मुँह बंद नहीं करूँगा, ऐ ख़ुदावन्द!</para>
  <para style="q" vid="PSA 40:9">तू जानता है।<verse eid="PSA 40:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 40:10"/>मैंने तेरी सदाक़त अपने दिल में छिपा नहीं रखी;</para>
  <para style="q" vid="PSA 40:10">मैंने तेरी वफ़ादारी और नजात का इज़हार किया है;</para>
  <para style="q" vid="PSA 40:10">मैंने तेरी शफ़क़त और सच्चाई बड़े मजमा' से नहीं छिपाई।<verse eid="PSA 40:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 40:11"/>ऐ ख़ुदावन्द! तू मुझ पर रहम करने में दरेग़ न कर;</para>
  <para style="q" vid="PSA 40:11">तेरी शफ़क़त और सच्चाई बराबर मेरी हिफ़ाज़त करें!<verse eid="PSA 40:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 40:12"/>क्यूँकि बेशुमार बुराइयों ने मुझे घेर लिया है;</para>
  <para style="q" vid="PSA 40:12">मेरी बदी ने मुझे आ पकड़ा है, ऐसा कि मैं आँख नहीं उठा सकता;</para>
  <para style="q" vid="PSA 40:12">वह मेरे सिर के बालों से भी ज़्यादा हैं: इसलिए मेरा जी छूट गया।<verse eid="PSA 40:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 40:13"/>ऐ ख़ुदावन्द! मेहरबानी करके मुझे छुड़ा।</para>
  <para style="q" vid="PSA 40:13">ऐ ख़ुदावन्द! मेरी मदद के लिए जल्दी कर।<verse eid="PSA 40:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 40:14"/>जो मेरी जान को हलाक करने के दर पै हैं,</para>
  <para style="q" vid="PSA 40:14">वह सब शर्मिन्दा और ख़जिल हों;</para>
  <para style="q" vid="PSA 40:14">जो मेरे नुक्सान से ख़ुश हैं, वह पस्पा और रुस्वा हो।<verse eid="PSA 40:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 40:15"/>जो मुझ पर अहा हा हा करते हैं,</para>
  <para style="q" vid="PSA 40:15">वह अपनी रुस्वाई की वजह से तबाह हो जाएँ।<verse eid="PSA 40:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 40:16"/>तेरे सब तालिब तुझ में ख़ुश — ओ — खुर्रम हों;</para>
  <para style="q" vid="PSA 40:16">तेरी नजात के आशिक हमेशा कहा करें “ख़ुदावन्द की तम्जीद हो!”<verse eid="PSA 40:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 40:17"/>लेकिन मैं ग़रीब और मोहताज हूँ,</para>
  <para style="q" vid="PSA 40:17">ख़ुदावन्द मेरी फ़िक्र करता है।</para>
  <para style="q" vid="PSA 40:17">मेरा मददगार और छुड़ाने वाला तू ही है;</para>
  <para style="q" vid="PSA 40:17">ऐ मेरे ख़ुदा! देर न कर।<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 41:1"/>मुबारक, है वह जो ग़रीब का ख़याल रखता है</para>
  <para style="q" vid="PSA 41:1">ख़ुदावन्द मुसीबत के दिन उसे छुड़ाएगा।<verse eid="PSA 41:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 41:2"/>ख़ुदावन्द उसे महफू़ज़ और ज़िन्दा रख्खेगा,</para>
  <para style="q" vid="PSA 41:2">और वह ज़मीन पर मुबारक होगा।</para>
  <para style="q" vid="PSA 41:2">तू उसे उसके दुश्मनों की मर्ज़ी पर न छोड़।<verse eid="PSA 41:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 41:3"/>ख़ुदावन्द उसे बीमारी के बिस्तर पर संभालेगा;</para>
  <para style="q" vid="PSA 41:3">तू उसकी बीमारी में उसके पूरे बिस्तर को ठीक करता है।<verse eid="PSA 41:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 41:4"/>मैंने कहा, “ऐ ख़ुदावन्द, मुझ पर रहम कर!</para>
  <para style="q" vid="PSA 41:4">मेरी जान को शिफ़ा दे,</para>
  <para style="q" vid="PSA 41:4">क्यूँकि मैं तेरा गुनहगार हूँ।”<verse eid="PSA 41:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 41:5"/>मेरे दुश्मन यह कहकर मेरी बुराई करते हैं,</para>
  <para style="q" vid="PSA 41:5">कि वह कब मरेगा और उसका नाम कब मिटेगा?<verse eid="PSA 41:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 41:6"/>जब वह मुझ से मिलने को आता है,</para>
  <para style="q" vid="PSA 41:6">तो झूटी बातें बकता है;</para>
  <para style="q" vid="PSA 41:6">उसका दिल अपने अन्दर बदी समेटता है;</para>
  <para style="q" vid="PSA 41:6">वह बाहर जाकर उसी का ज़िक्र करता है।<verse eid="PSA 41:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 41:7"/>मुझ से 'अदावत रखने वाले सब मिलकर मेरी ग़ीबत करते हैं;</para>
  <para style="q" vid="PSA 41:7">वह मेरे ख़िलाफ़ मेरे नुक़सान के मन्सूबे बाँधते हैं।<verse eid="PSA 41:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 41:8"/>वह कहते हैं, “इसे तो बुरा रोग लग गया है;</para>
  <para style="q" vid="PSA 41:8">अब जो वह पड़ा है तो फिर उठने का नहीं।”<verse eid="PSA 41:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 41:9"/>बल्कि मेरे दिली दोस्त ने जिस पर मुझे भरोसा था,</para>
  <para style="q" vid="PSA 41:9">और जो मेरी रोटी खाता था, मुझ पर लात उठाई है।<verse eid="PSA 41:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 41:10"/>लेकिन तू ऐ ख़ुदावन्द!</para>
  <para style="q" vid="PSA 41:10">मुझ पर रहम करके मुझे उठा खड़ा कर,</para>
  <para style="q" vid="PSA 41:10">ताकि मैं उनको बदला दूँ।<verse eid="PSA 41:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 41:11"/>इससे मैं जान गया कि तू मुझ से ख़ुश है,</para>
  <para style="q" vid="PSA 41:11">कि मेरा दुश्मन मुझ पर फ़तह नहीं पाता।<verse eid="PSA 41:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 41:12"/>मुझे तो तू ही मेरी रास्ती में क़याम बख्शता है</para>
  <para style="q" vid="PSA 41:12">और मुझे हमेशा अपने सामने क़ाईम रखता है।<verse eid="PSA 41:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 41:13"/>ख़ुदावन्द इस्राईल का ख़ुदा,</para>
  <para style="q" vid="PSA 41:13">इब्तिदा से हमेशा तक मुबारक हो!</para>
  <para style="q" vid="PSA 41:13">आमीन, सुम्म आमीन।<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">दुसरी किताब</para>
  <para style="r">(<ref loc="PSA 42:-1-72">ज़बूर 42-72</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 42:1"/>जैसे हिरनी पानी के नालों को तरसती है,</para>
  <para style="q" vid="PSA 42:1">वैसे ही ऐ ख़ुदा! मेरी रूह तेरे लिए तरसती है।<verse eid="PSA 42:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 42:2"/>मेरी रूह, ख़ुदा की, ज़िन्दा ख़ुदा की प्यासी है।</para>
  <para style="q" vid="PSA 42:2">मैं कब जाकर ख़ुदा के सामने हाज़िर हूँगा?<verse eid="PSA 42:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 42:3"/>मेरे आँसू दिन रात मेरी खू़राक हैं;</para>
  <para style="q" vid="PSA 42:3">जिस हाल कि वह मुझ से बराबर कहते हैं, तेरा ख़ुदा कहाँ है?<verse eid="PSA 42:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 42:4"/>इन बातों को याद करके मेरा दिल भरआता है,</para>
  <para style="q" vid="PSA 42:4">कि मैं किस तरह भीड़ या'नी 'ईद मनाने वाली जमा'अत के साथ,</para>
  <para style="q" vid="PSA 42:4">खु़शी और हम्द करता हुआ उनको ख़ुदा के घर में ले जाता था।<verse eid="PSA 42:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 42:5"/>ऐ मेरी जान, तू क्यूँ गिरी जाती है?</para>
  <para style="q" vid="PSA 42:5">तू अन्दर ही अन्दर क्यूँ बेचैन है?</para>
  <para style="q" vid="PSA 42:5">ख़ुदा से उम्मीद रख, क्यूँकि उसके नजात बख़्श दीदार की ख़ातिर</para>
  <para style="q" vid="PSA 42:5">मैं फिर उसकी सिताइश करूँगा।<verse eid="PSA 42:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 42:6"/>ऐ मेरे ख़ुदा! मेरी जान मेरे अंदर गिरी जाती है,</para>
  <para style="q" vid="PSA 42:6">इसलिए मैं तुझे यरदन की सरज़मीन से और हरमून</para>
  <para style="q" vid="PSA 42:6">और कोह — ए — मिस्फ़ार पर से याद करता हूँ।<verse eid="PSA 42:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 42:7"/>तेरे आबशारों की आवाज़ से गहराव को पुकारता है।</para>
  <para style="q" vid="PSA 42:7">तेरी सब मौजें और लहरें मुझ पर से गुज़र गई।<verse eid="PSA 42:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 42:8"/>तोभी दिन को ख़ुदावन्द अपनी शफ़क़त दिखाएगा;</para>
  <para style="q" vid="PSA 42:8">और रात को मैं उसका हम्द गाऊँगा,</para>
  <para style="q" vid="PSA 42:8">बल्कि अपनी ज़िन्दगी के ख़ुदा से दुआ करूँगा।<verse eid="PSA 42:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 42:9"/>मैं ख़ुदा से जो मेरी चट्टान है कहूँगा, “तू मुझे क्यूँ भूल गया?</para>
  <para style="q" vid="PSA 42:9">मैं दुश्मन के ज़ुल्म की वजह से,</para>
  <para style="q" vid="PSA 42:9">क्यूँ मातम करता फिरता हूँ?”<verse eid="PSA 42:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 42:10"/>मेरे मुख़ालिफ़ों की मलामत,</para>
  <para style="q" vid="PSA 42:10">जैसे मेरी हड्डियों में तलवार है,</para>
  <para style="q" vid="PSA 42:10">क्यूँकि वह मुझ से बराबर कहते हैं, “तेरा ख़ुदा कहाँ है?”<verse eid="PSA 42:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 42:11"/>ऐ मेरी जान! तू क्यूँ गिरी जाती है?</para>
  <para style="q" vid="PSA 42:11">तू अंदर ही अंदर क्यूँ बेचैन है?</para>
  <para style="q" vid="PSA 42:11">ख़ुदा से उम्मीद रख, क्यूँकि वह मेरे चेहरे की रौनक और मेरा ख़ुदा है;</para>
  <para style="q" vid="PSA 42:11">मैं फिर उसकी सिताइश करूँगा।<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1"/>ऐ ख़ुदा, मेरा इन्साफ़ कर</para>
  <para style="q" vid="PSA 43:1">और बेदीन क़ौम के मुक़ाबले में मेरी वकालत कर,</para>
  <para style="q" vid="PSA 43:1">और दग़ाबाज़ और बेइन्साफ़ आदमी से मुझे छुड़ा।<verse eid="PSA 43:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2"/>क्यूँकि तू ही मेरी ताक़त का ख़ुदा है,</para>
  <para style="q" vid="PSA 43:2">तूने क्यूँ मुझे छोड़ दिया?</para>
  <para style="q" vid="PSA 43:2">मैं दुश्मन के ज़ुल्म की वजह से क्यूँ मातम करता फिरता हूँ?<verse eid="PSA 43:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3"/>अपने नूर, अपनी सच्चाई को भेज,</para>
  <para style="q" vid="PSA 43:3">वही मेरी रहबरी करें,</para>
  <para style="q" vid="PSA 43:3">वही मुझ को तेरे पाक पहाड़ और तेरे घर तक पहुँचाए।<verse eid="PSA 43:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4"/>तब मैं ख़ुदा के मज़बह के पास जाऊँगा,</para>
  <para style="q" vid="PSA 43:4">ख़ुदा के सामने जो मेरी कमाल ख़ुशी है;</para>
  <para style="q" vid="PSA 43:4">ऐ ख़ुदा! मेरे ख़ुदा! मैं सितार बजा कर तेरी सिताइश करूँगा।<verse eid="PSA 43:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5"/>ऐ मेरी जान! तू क्यूँ गिरी जाती है?</para>
  <para style="q" vid="PSA 43:5">तू अन्दर ही अन्दर क्यूँ बेचैन है?</para>
  <para style="q" vid="PSA 43:5">ख़ुदा से उम्मीद रख, क्यूँकि वह मेरे चेहरे की रौनक़ और मेरा ख़ुदा है;</para>
  <para style="q" vid="PSA 43:5">मैं फिर उसकी सिताइश करूँगा।<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 44:1"/>ऐ ख़ुदा, हम ने अपने कानों से सुना;</para>
  <para style="q" vid="PSA 44:1">हमारे बाप — दादा ने हम से बयान किया,</para>
  <para style="q" vid="PSA 44:1">कि तूने उनके दिनों में पिछले ज़माने में क्या क्या काम किए।<verse eid="PSA 44:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 44:2"/>तूने क़ौमों को अपने हाथ से निकाल दिया,</para>
  <para style="q" vid="PSA 44:2">और उनको बसाया: तूने उम्मतों को तबाह किया,</para>
  <para style="q" vid="PSA 44:2">और इनको चारों तरफ़ फैलाया;<verse eid="PSA 44:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 44:3"/>क्यूँकि न तो यह अपनी तलवार से इस मुल्क पर क़ाबिज़ हुए,</para>
  <para style="q" vid="PSA 44:3">और न इनकी ताक़त ने इनको बचाया;</para>
  <para style="q" vid="PSA 44:3">बल्कि तेरे दहने हाथ और तेरी ताक़त</para>
  <para style="q" vid="PSA 44:3">और तेरे चेहरे के नूर ने इनको फ़तह बख़्शी क्यूँकि तू इनसे ख़ुश था।<verse eid="PSA 44:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 44:4"/>ऐ ख़ुदा! तू मेरा बादशाह है;</para>
  <para style="q" vid="PSA 44:4">या'क़ूब के हक़ में नजात का हुक्म सादिर फ़रमा।<verse eid="PSA 44:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 44:5"/>तेरी बदौलत हम अपने मुख़ालिफ़ों को गिरा देंगे;</para>
  <para style="q" vid="PSA 44:5">तेरे नाम से हम अपने ख़िलाफ़ उठने वालों को पस्त करेंगे।<verse eid="PSA 44:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 44:6"/>क्यूँकि न तो मैं अपनी कमान पर भरोसा करूँगा,</para>
  <para style="q" vid="PSA 44:6">और न मेरी तलवार मुझे बचाएगी।<verse eid="PSA 44:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 44:7"/>लेकिन तूने हम को हमारे मुख़ालिफ़ों से बचाया है,</para>
  <para style="q" vid="PSA 44:7">और हम से 'अदावत रखने वालों को शर्मिन्दा किया।<verse eid="PSA 44:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 44:8"/>हम दिन भर ख़ुदा पर फ़ख़्र करते रहे हैं,</para>
  <para style="q" vid="PSA 44:8">और हमेशा हम तेरे ही नाम का शुक्रिया अदा करते रहेंगे।<verse eid="PSA 44:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 44:9"/>लेकिन तूने तो अब हम को छोड़ दिया</para>
  <para style="q" vid="PSA 44:9">और हम को रुस्वा किया,</para>
  <para style="q" vid="PSA 44:9">और हमारे लश्करों के साथ नहीं जाता।<verse eid="PSA 44:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 44:10"/>तू हम को मुख़ालिफ़ के आगे पस्पा करता है,</para>
  <para style="q" vid="PSA 44:10">और हम से 'अदावत रखने वाले लूट मार करते हैं<verse eid="PSA 44:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 44:11"/>तूने हम को ज़बह होने वाली भेड़ों की तरह कर दिया,</para>
  <para style="q" vid="PSA 44:11">और क़ौमों के बीच हम को तितर बितर किया।<verse eid="PSA 44:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 44:12"/>तू अपने लोगों को मुफ़्त बेच डालता है,</para>
  <para style="q" vid="PSA 44:12">और उनकी क़ीमत से तेरी दौलत नहीं बढ़ती।<verse eid="PSA 44:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 44:13"/>तू हम को हमारे पड़ोसियों की मलामत का निशाना,</para>
  <para style="q" vid="PSA 44:13">और हमारे आसपास के लोगों के तमसखु़र</para>
  <para style="q" vid="PSA 44:13">और मज़ाक़ का जरिया' बनाता है।<verse eid="PSA 44:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 44:14"/>तू हम को क़ौमों के बीच एक मिसाल,</para>
  <para style="q" vid="PSA 44:14">और उम्मतों में सिर हिलाने की वजह ठहराता है।<verse eid="PSA 44:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 44:15"/>मेरी रुस्वाई दिन भर मेरे सामने रहती है,</para>
  <para style="q" vid="PSA 44:15">और मेरे मुँह पर शर्मिन्दी छा गई।<verse eid="PSA 44:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 44:16"/>मलामत करने वाले और कुफ़्र बकने वाले की बातों की वजह से,</para>
  <para style="q" vid="PSA 44:16">और मुख़ालिफ़ और इन्तक़ाम लेने वाले की वजह।<verse eid="PSA 44:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 44:17"/>यह सब कुछ हम पर बीता तोभी हम तुझ को नहीं भूले,</para>
  <para style="q" vid="PSA 44:17">न तेरे 'अहद से बेवफ़ाई की;<verse eid="PSA 44:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 44:18"/>न हमारे दिल नाफ़रमान हुए,</para>
  <para style="q" vid="PSA 44:18">न हमारे क़दम तेरी राह से मुड़े;<verse eid="PSA 44:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 44:19"/>जो तूने हम को गीदड़ों की जगह में खू़ब कुचला,</para>
  <para style="q" vid="PSA 44:19">और मौत के साये में हम को छिपाया।<verse eid="PSA 44:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 44:20"/>अगर हम अपने ख़ुदा के नाम को भूले,</para>
  <para style="q" vid="PSA 44:20">या हम ने किसी अजनबी मा'बूद के आगे अपने हाथ फैलाए हों:<verse eid="PSA 44:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 44:21"/>तो क्या ख़ुदा इसे दरियाफ़्त न कर लेगा?</para>
  <para style="q" vid="PSA 44:21">क्यूँकि वह दिलों के राज़ जानता है।<verse eid="PSA 44:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 44:22"/>बल्कि हम तो दिन भर तेरी ही ख़ातिर जान से मारे जाते हैं,</para>
  <para style="q" vid="PSA 44:22">और जैसे ज़बह होने वाली भेड़ें समझे जाते हैं।<verse eid="PSA 44:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 44:23"/>ऐ ख़ुदावन्द, जाग! तू क्यूँ सोता है?</para>
  <para style="q" vid="PSA 44:23">उठ! हमेशा के लिए हम को न छोड़।<verse eid="PSA 44:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 44:24"/>तू अपना मुँह क्यूँ छिपाता है,</para>
  <para style="q" vid="PSA 44:24">और हमारी मुसीबत और मज़लूमी को भूलता है?<verse eid="PSA 44:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 44:25"/>क्यूँकि हमारी जान ख़ाक में मिल गई,</para>
  <para style="q" vid="PSA 44:25">हमारा जिस्म मिट्टी हो गया।<verse eid="PSA 44:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 44:26"/>हमारी मदद के लिए उठ</para>
  <para style="q" vid="PSA 44:26">और अपनी शफ़क़त की ख़ातिर, हमारा फ़िदिया दे।<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 45:1"/>मेरे दिल में एक नफ़ीस मज़मून जोश मार रहा है,</para>
  <para style="q" vid="PSA 45:1">मैं वही मज़ामीन सुनाऊँगा जो मैंने बादशाह के हक़ में लिखे हैं,</para>
  <para style="q" vid="PSA 45:1">मेरी ज़बान माहिर लिखने वाले का क़लम है।<verse eid="PSA 45:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 45:2"/>तू बनी आदम में सबसे हसीन है;</para>
  <para style="q" vid="PSA 45:2">तेरे होंटों में लताफ़त भरी है;</para>
  <para style="q" vid="PSA 45:2">इसलिए ख़ुदा ने तुझे हमेशा के लिए मुबारक किया।<verse eid="PSA 45:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 45:3"/>ऐ ज़बरदस्त! तू अपनी तलवार को जो तेरी हशमत — ओ — शौकत है,</para>
  <para style="q" vid="PSA 45:3">अपनी कमर से लटका ले।<verse eid="PSA 45:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 45:4"/>और सच्चाई और हिल्म और सदाक़त की ख़ातिर,</para>
  <para style="q" vid="PSA 45:4">अपनी शान — ओ — शौकत में इक़बालमंदी से सवार हो;</para>
  <para style="q" vid="PSA 45:4">और तेरा दहना हाथ तुझे अजीब काम दिखाएगा।<verse eid="PSA 45:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 45:5"/>तेरे तीर तेज़ हैं,</para>
  <para style="q" vid="PSA 45:5">वह बादशाह के दुश्मनों के दिल में लगे हैं,</para>
  <para style="q" vid="PSA 45:5">उम्मतें तेरे सामने पस्त होती हैं।<verse eid="PSA 45:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 45:6"/>ऐ ख़ुदा, तेरा तख़्त हमेशा से हमेशा तक है;</para>
  <para style="q" vid="PSA 45:6">तेरी सल्तनत का 'असा रास्ती का 'असा है।<verse eid="PSA 45:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 45:7"/>तूने सदाक़त से मुहब्बत रखी और बदकारी से नफ़रत,</para>
  <para style="q" vid="PSA 45:7">इसीलिए ख़ुदा, तेरे ख़ुदा ने ख़ुशी के तेल से,</para>
  <para style="q" vid="PSA 45:7">तुझ को तेरे हमसरों से ज़्यादा मसह किया है।<verse eid="PSA 45:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 45:8"/>तेरे हर लिबास से मुर और 'ऊद और तंज की खु़शबू आती है,</para>
  <para style="q" vid="PSA 45:8">हाथी दाँत के महलों में से तारदार साज़ों ने तुझे ख़ुश किया है।<verse eid="PSA 45:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 45:9"/>तेरी ख़ास ख़्वातीन में शाहज़ादियाँ हैं;</para>
  <para style="q" vid="PSA 45:9">मलिका तेरे दहने हाथ,</para>
  <para style="q" vid="PSA 45:9">ओफ़ीर के सोने से सजी खड़ी है।<verse eid="PSA 45:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 45:10"/>ऐ बेटी, सुन! ग़ौर कर और कान लगा;</para>
  <para style="q" vid="PSA 45:10">अपनी क़ौम और अपने बाप के घर को भूल जा;<verse eid="PSA 45:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 45:11"/>और बादशाह तेरे हुस्न का मुश्ताक़ होगा।</para>
  <para style="q" vid="PSA 45:11">क्यूँकि वह तेरा ख़ुदावन्द है, तू उसे सिज्दा कर!<verse eid="PSA 45:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 45:12"/>और सूर की बेटी हदिया लेकर हाज़िर होगी,</para>
  <para style="q" vid="PSA 45:12">क़ौम के दौलतमंद तेरी ख़ुशी की तलाश करेंगे।<verse eid="PSA 45:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 45:13"/>बादशाह की बेटी महल में सरापा हुस्न अफ़रोज़ है,</para>
  <para style="q" vid="PSA 45:13">उसका लिबास ज़रबफ़्त का है;<verse eid="PSA 45:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 45:14"/>वह बेल बूटे दार लिबास में बादशाह के सामने पहुँचाई जाएगी।</para>
  <para style="q" vid="PSA 45:14">उसकी कुंवारी सहेलियाँ जो उसके पीछे — पीछे चलती हैं,</para>
  <para style="q" vid="PSA 45:14">तेरे सामने हाज़िर की जाएँगी।<verse eid="PSA 45:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 45:15"/>वह उनको ख़ुशी और ख़ुर्रमी से ले आएँगे,</para>
  <para style="q" vid="PSA 45:15">वह बादशाह के महल में दाख़िल होंगी।<verse eid="PSA 45:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 45:16"/>तेरे बेटे तेरे बाप दादा के जाँ नशीन होंगे;</para>
  <para style="q" vid="PSA 45:16">जिनको तू पूरी ज़मीन पर सरदार मुक़र्रर करेगा।<verse eid="PSA 45:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 45:17"/>मैं तेरे नाम की याद को नसल दर नसल क़ाईम रखूँगा</para>
  <para style="q" vid="PSA 45:17">इसलिए उम्मतें हमेशा से हमेशा तक तेरी;</para>
  <para style="q" vid="PSA 45:17">शुक्रगुज़ारी करेंगी।<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 46:1"/>ख़ुदावन्द हमारी पनाह और ताक़त है;</para>
  <para style="q" vid="PSA 46:1">मुसीबत में मुस्त'इद मददगार।<verse eid="PSA 46:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 46:2"/>इसलिए हम को कुछ ख़ौफ़ नहीं चाहे ज़मीन उलट जाए,</para>
  <para style="q" vid="PSA 46:2">और पहाड़ समुन्दर की तह में डाल दिए जाए<verse eid="PSA 46:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 46:3"/>चाहे उसका पानी शोर मचाए और तूफ़ानी हो,</para>
  <para style="q" vid="PSA 46:3">और पहाड़ उसकी लहरों से हिल जाएँ। सिलह<verse eid="PSA 46:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 46:4"/>एक ऐसा दरिया है जिसकी शाख़ो से ख़ुदा के</para>
  <para style="q" vid="PSA 46:4">शहर को या'नी हक़ ता'ला के पाक घर को फ़रहत होती है।<verse eid="PSA 46:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 46:5"/>ख़ुदा उसमें है, उसे कभी जुम्बिश न होगी;</para>
  <para style="q" vid="PSA 46:5">ख़ुदा सुबह सवेरे उसकी मदद करेगा।<verse eid="PSA 46:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 46:6"/>क़ौमे झुंझलाई, सल्तनतों ने जुम्बिश खाई;</para>
  <para style="q" vid="PSA 46:6">वह बोल उठा, ज़मीन पिघल गई।<verse eid="PSA 46:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 46:7"/>लश्करों का ख़ुदावन्द हमारे साथ है;</para>
  <para style="q" vid="PSA 46:7">या'क़ूब का ख़ुदा हमारी पनाह है सिलाह।<verse eid="PSA 46:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 46:8"/>आओ, ख़ुदावन्द के कामों को देखो,</para>
  <para style="q" vid="PSA 46:8">कि उसने ज़मीन पर क्या क्या वीरानियाँ की हैं।<verse eid="PSA 46:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 46:9"/>वह ज़मीन की इन्तिहा तक जंग बंद कराता है;</para>
  <para style="q" vid="PSA 46:9">वह कमान को तोड़ता, और नेज़े के टुकड़े कर डालता है।</para>
  <para style="q" vid="PSA 46:9">वह रथों को आग से जला देता है।<verse eid="PSA 46:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 46:10"/>“ख़ामोश हो जाओ, और जान लो कि मैं ख़ुदा हूँ।</para>
  <para style="q" vid="PSA 46:10">मैं क़ौमों के बीच सरबुलंद हूँगा।</para>
  <para style="q" vid="PSA 46:10">मैं सारी ज़मीन पर सरबुलंद हूँगा।”<verse eid="PSA 46:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 46:11"/>लश्करों का ख़ुदावन्द हमारे साथ है;</para>
  <para style="q" vid="PSA 46:11">या'क़ूब का ख़ुदा हमारी पनाह है। सिलाह<verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 47:1"/>ऐ सब उम्मतों, तालियाँ बजाओ!</para>
  <para style="q" vid="PSA 47:1">ख़ुदा के लिए ख़ुशी की आवाज़ से ललकारो!<verse eid="PSA 47:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 47:2"/>क्यूँकि ख़ुदावन्द ता'ला बड़ा है,</para>
  <para style="q" vid="PSA 47:2">वह पूरी ज़मीन का शहंशाह है।<verse eid="PSA 47:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 47:3"/>वह उम्मतों को हमारे सामने पस्त करेगा,</para>
  <para style="q" vid="PSA 47:3">और क़ौमें हमारे क़दमों तले हो जायेंगी।<verse eid="PSA 47:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 47:4"/>वह हमारे लिए हमारी मीरास को चुनेगा,</para>
  <para style="q" vid="PSA 47:4">जो उसके महबूब या'क़ूब की हश्मत है। सिलाह<verse eid="PSA 47:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 47:5"/>ख़ुदा ने बुलन्द आवाज़ के साथ,</para>
  <para style="q" vid="PSA 47:5">ख़ुदावन्द ने नरसिंगे की आवाज़ के साथ सु'ऊद फ़रमाया।<verse eid="PSA 47:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 47:6"/>मदहसराई करो, ख़ुदा की मदहसराई करो!</para>
  <para style="q" vid="PSA 47:6">मदहसराई करो, हमारे बादशाह की मदहसराई करो!<verse eid="PSA 47:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 47:7"/>क्यूँकि ख़ुदा सारी ज़मीन का बादशाह है;</para>
  <para style="q" vid="PSA 47:7">'अक़्ल से मदहसराई करो।<verse eid="PSA 47:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 47:8"/>ख़ुदा क़ौमों पर सल्तनत करता है;</para>
  <para style="q" vid="PSA 47:8">ख़ुदा अपने पाक तख़्त पर बैठा है।<verse eid="PSA 47:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 47:9"/>उम्मतों के सरदार इकट्ठे हुए हैं,</para>
  <para style="q" vid="PSA 47:9">ताकि अब्रहाम के ख़ुदा की उम्मत बन जाएँ;</para>
  <para style="q" vid="PSA 47:9">क्यूँकि ज़मीन की ढालें ख़ुदा की हैं,</para>
  <para style="q" vid="PSA 47:9">वह बहुत बुलन्द है।<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 48:1"/>हमारे ख़ुदा के शहर में,</para>
  <para style="q" vid="PSA 48:1">अपने पाक पहाड़ पर ख़ुदावन्द बुज़ु़र्ग़</para>
  <para style="q" vid="PSA 48:1">और बेहद सिताइश के लायक़ है!<verse eid="PSA 48:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 48:2"/>उत्तर की जानिब कोह — ए — सिय्यून,</para>
  <para style="q" vid="PSA 48:2">जो बड़े बादशाह का शहर है,</para>
  <para style="q" vid="PSA 48:2">वह बुलन्दी में खु़शनुमा और तमाम ज़मीन का फ़ख़्र है।<verse eid="PSA 48:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 48:3"/>उसके महलों में ख़ुदा पनाह माना जाता है।<verse eid="PSA 48:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 48:4"/>क्यूँकि देखो, बादशाह इकट्ठे हुए,</para>
  <para style="q" vid="PSA 48:4">वह मिलकर गुज़रे।<verse eid="PSA 48:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 48:5"/>वह देखकर दंग हो गए,</para>
  <para style="q" vid="PSA 48:5">वह घबराकर भागे।<verse eid="PSA 48:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 48:6"/>वहाँ कपकपी ने उनको आ दबाया,</para>
  <para style="q" vid="PSA 48:6">और ऐसे दर्द ने जैसा पैदाइश का दर्द।<verse eid="PSA 48:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 48:7"/>तू पूरबी हवा से तरसीस के</para>
  <para style="q" vid="PSA 48:7">जहाज़ों को तोड़ डालता है।<verse eid="PSA 48:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 48:8"/>लश्करों के ख़ुदावन्द के शहर में,</para>
  <para style="q" vid="PSA 48:8">या'नी अपने ख़ुदा के शहर में,</para>
  <para style="q" vid="PSA 48:8">जैसा हम ने सुना था वैसा ही हम ने देखा:</para>
  <para style="q" vid="PSA 48:8">ख़ुदा उसे हमेशा बरक़रार रखेगा।<verse eid="PSA 48:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 48:9"/>ऐ ख़ुदा, तेरी हैकल के अन्दर हम ने</para>
  <para style="q" vid="PSA 48:9">तेरी शफ़क़त पर ग़ौर किया है<verse eid="PSA 48:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 48:10"/>ऐ ख़ुदा, जैसा तेरा नाम है</para>
  <para style="q" vid="PSA 48:10">वैसी ही तेरी सिताइश ज़मीन की इन्तिहा तक है।</para>
  <para style="q" vid="PSA 48:10">तेरा दहना हाथ सदाक़त से मा'मूर है।<verse eid="PSA 48:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 48:11"/>तेरे अहकाम की वजह से:कोह — ए — सिय्यून शादमान हो</para>
  <para style="q" vid="PSA 48:11">यहूदाह की बेटियाँ ख़ुशी मनाए,<verse eid="PSA 48:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 48:12"/>सिय्यून के गिर्द फिरो</para>
  <para style="q" vid="PSA 48:12">और उसका तवाफ़ करो उसके बुर्जों को गिनों,<verse eid="PSA 48:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 48:13"/>उसकी शहर पनाह को खू़ब देख लो,</para>
  <para style="q" vid="PSA 48:13">उसके महलों पर ग़ौर करो;</para>
  <para style="q" vid="PSA 48:13">ताकि तुम आने वाली नसल को उसकी ख़बर दे सको।<verse eid="PSA 48:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 48:14"/>क्यूँकि यही ख़ुदा हमेशा से हमेशा तक हमारा ख़ुदा है;</para>
  <para style="q" vid="PSA 48:14">यही मौत तक हमारा रहनुमा रहेगा।<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 49:1"/>ऐ सब उम्मतो, यह सुनो।</para>
  <para style="q" vid="PSA 49:1">ऐ जहान के सब बाशिन्दो, कान लगाओ!<verse eid="PSA 49:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 49:2"/>क्या अदना क्या आ'ला,</para>
  <para style="q" vid="PSA 49:2">क्या अमीर क्या फ़कीर।<verse eid="PSA 49:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 49:3"/>मेरे मुँह से हिकमत की बातें निकलेंगी,</para>
  <para style="q" vid="PSA 49:3">और मेरे दिल का ख़याल पुर ख़िरद होगा।<verse eid="PSA 49:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 49:4"/>मैं तम्सील की तरफ़ कान लगाऊँगा,</para>
  <para style="q" vid="PSA 49:4">मैं अपना राज़ सितार पर बयान करूँगा।<verse eid="PSA 49:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 49:5"/>मैं मुसीबत के दिनों में क्यूँ डरूं,</para>
  <para style="q" vid="PSA 49:5">जब मेरा पीछा करने वाली बदी मुझे घेरे हो?<verse eid="PSA 49:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 49:6"/>जो अपनी दौलत पर भरोसा रखते,</para>
  <para style="q" vid="PSA 49:6">और अपने माल की कसरत पर फ़ख़्र करते हैं;<verse eid="PSA 49:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 49:7"/>उनमें से कोई किसी तरह अपने भाई का फ़िदिया नहीं दे सकता,</para>
  <para style="q" vid="PSA 49:7">न ख़ुदा को उसका मु'आवज़ा दे सकता है।<verse eid="PSA 49:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 49:8"/>क्यूँकि उनकी जान का फ़िदिया बेश क़ीमत है;</para>
  <para style="q" vid="PSA 49:8">वह हमेशा तक अदा न होगा।<verse eid="PSA 49:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 49:9"/>ताकि वह हमेशा तक ज़िन्दा रहे और क़ब्र को न देखे।<verse eid="PSA 49:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 49:10"/>क्यूँकि वह देखता है, कि दानिशमंद मर जाते हैं,</para>
  <para style="q" vid="PSA 49:10">बेवकू़फ़ व हैवान ख़सलत एक साथ हलाक होते हैं,</para>
  <para style="q" vid="PSA 49:10">और अपनी दौलत औरों के लिए छोड़ जाते हैं।<verse eid="PSA 49:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 49:11"/>उनका दिली ख़याल यह है कि उनके घर हमेशा तक,</para>
  <para style="q" vid="PSA 49:11">और उनके घर नसल दर नसल बने रहेंगे;</para>
  <para style="q" vid="PSA 49:11">वह अपनी ज़मीन अपने ही नाम नामज़द करते हैं।<verse eid="PSA 49:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 49:12"/>पर इंसान इज़्ज़त की हालत में क़ाईम नहीं रहता वह जानवरों की तरह है,</para>
  <para style="q" vid="PSA 49:12">जो फ़ना हो, जाते हैं।<verse eid="PSA 49:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 49:13"/>उनकी यह चाल उनकी बेवक़ूफ़ी है,</para>
  <para style="q" vid="PSA 49:13">तोभी उनके बाद लोग उनकी बातों को पसंद करते हैं। सिलाह<verse eid="PSA 49:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 49:14"/>वह जैसे पाताल का रेवड़ ठहराए गए हैं;</para>
  <para style="q" vid="PSA 49:14">मौत उनकी पासबान होगी;</para>
  <para style="q" vid="PSA 49:14">दियानतदार सुबह को उन पर मुसल्लत होगा,</para>
  <para style="q" vid="PSA 49:14">और उनका हुस्न पाताल का लुक़्मा होकर बेठिकाना होगा।<verse eid="PSA 49:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 49:15"/>लेकिन ख़ुदा मेरी जान को पाताल के इख़्तियार से छुड़ा लेगा,</para>
  <para style="q" vid="PSA 49:15">क्यूँकि वही मुझे कु़बूल करेगा। सिलाह<verse eid="PSA 49:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 49:16"/>जब कोई मालदार हो जाए जब उसके घर की हश्मत बढ़े,</para>
  <para style="q" vid="PSA 49:16">तो तू ख़ौफ़ न कर।<verse eid="PSA 49:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 49:17"/>क्यूँकि वह मरकर कुछ साथ न ले जाएगा;</para>
  <para style="q" vid="PSA 49:17">उसकी हश्मत उसके साथ न जाएगी।<verse eid="PSA 49:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 49:18"/>चाहे जीते जी वह अपनी जान को मुबारक कहता रहा हो</para>
  <para style="q" vid="PSA 49:18">और जब तू अपना भला करता है तो लोग तेरी तारीफ़ करते हैं<verse eid="PSA 49:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 49:19"/>तोभी वह अपने बाप दादा की गिरोह से जा मिलेगा,</para>
  <para style="q" vid="PSA 49:19">वह रोशनी को हरगिज़ न देखेंगे।<verse eid="PSA 49:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 49:20"/>आदमी जो 'इज़्ज़त की हालत में रहता है,</para>
  <para style="q" vid="PSA 49:20">लेकिन 'अक़्ल नहीं रखता जानवरों की तरह है,</para>
  <para style="q" vid="PSA 49:20">जो फ़ना हो जाते हैं।<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 50:1"/>रब ख़ुदावन्द ख़ुदा ने कलाम किया,</para>
  <para style="q" vid="PSA 50:1">और पूरब से पश्चिम तक दुनिया को बुलाया।<verse eid="PSA 50:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2"/>सिय्यून से जो हुस्न का कमाल है,</para>
  <para style="q" vid="PSA 50:2">ख़ुदा जलवागर हुआ है।<verse eid="PSA 50:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3"/>हमारा ख़ुदा आएगा और ख़ामोश नहीं रहेगा;</para>
  <para style="q" vid="PSA 50:3">आग उसके आगे आगे भसम करती जाएगी,<verse eid="PSA 50:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4"/>अपनी उम्मत की 'अदालत करने के लिए</para>
  <para style="q" vid="PSA 50:4">वह आसमान — ओ — ज़मीन को तलब करेगा,<verse eid="PSA 50:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5"/>कि मेरे पाक लोगों को मेरे सामने जमा' करो,</para>
  <para style="q" vid="PSA 50:5">जिन्होंने कु़र्बानी के ज़रिये' से मेरे साथ 'अहद बाँधा है।<verse eid="PSA 50:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6"/>और आसमान उसकी सदाक़त बयान करेंगे,</para>
  <para style="q" vid="PSA 50:6">क्यूँकि ख़ुदा आप ही इन्साफ़ करने वाला है।<verse eid="PSA 50:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7"/>“ऐ मेरी उम्मत, सुन, मैं कलाम करूँगा,</para>
  <para style="q" vid="PSA 50:7">और ऐ इस्राईल, मैं तुझ पर गवाही दूँगा।</para>
  <para style="q" vid="PSA 50:7">ख़ुदा, तेरा ख़ुदा मैं ही हूँ।<verse eid="PSA 50:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8"/>मैं तुझे तेरी कु़र्बानियों की वजह से मलामत नहीं करूँगा,</para>
  <para style="q" vid="PSA 50:8">और तेरी सोख़्तनी क़ुर्बानियाँ बराबर मेरे सामने रहती हैं;<verse eid="PSA 50:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9"/>न मैं तेरे घर से बैल लूँगा न तेरे बाड़े से बकरे।<verse eid="PSA 50:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10"/>क्यूँकि जंगल का एक एक जानवर,</para>
  <para style="q" vid="PSA 50:10">और हज़ारों पहाड़ों के चौपाये मेरे ही हैं।<verse eid="PSA 50:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11"/>मैं पहाड़ों के सब परिन्दों को जानता हूँ,</para>
  <para style="q" vid="PSA 50:11">और मैदान के दरिन्दे मेरे ही हैं।<verse eid="PSA 50:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12"/>“अगर मैं भूका होता तो तुझ से न कहता,</para>
  <para style="q" vid="PSA 50:12">क्यूँकि दुनिया और उसकी मा'मूरी मेरी ही है।<verse eid="PSA 50:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13"/>क्या मैं साँडों का गोश्त खाऊँगा,</para>
  <para style="q" vid="PSA 50:13">या बकरों का खू़न पियूँगा?<verse eid="PSA 50:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14"/>ख़ुदा के लिए शुक्रगुज़ारी की कु़र्बानी पेश करें,</para>
  <para style="q" vid="PSA 50:14">और हक़ता'ला के लिए अपनी मन्नतें पूरी कर;<verse eid="PSA 50:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15"/>और मुसीबत के दिन मुझ से फ़रियाद कर</para>
  <para style="q" vid="PSA 50:15">मैं तुझे छुड़ाऊँगा और तू मेरी तम्जीद करेगा।”<verse eid="PSA 50:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16"/>लेकिन ख़ुदा शरीर से कहता है,</para>
  <para style="q" vid="PSA 50:16">तुझे मेरे क़ानून बयान करने से क्या वास्ता?</para>
  <para style="q" vid="PSA 50:16">और तू मेरे 'अहद को अपनी ज़बान पर क्यूँ लाता है?<verse eid="PSA 50:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17"/>जबकि तुझे तर्बियत से 'अदावत है,</para>
  <para style="q" vid="PSA 50:17">और मेरी बातों को पीठ पीछे फेंक देता है।<verse eid="PSA 50:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18"/>तू चोर को देखकर उससे मिल गया,</para>
  <para style="q" vid="PSA 50:18">और ज़ानियों का शरीक रहा है।<verse eid="PSA 50:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19"/>“तेरे मुँह से बदी निकलती है,</para>
  <para style="q" vid="PSA 50:19">और तेरी ज़बान फ़रेब गढ़ती है।<verse eid="PSA 50:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20"/>तू बैठा बैठा अपने भाई की ग़ीबत करता है;</para>
  <para style="q" vid="PSA 50:20">और अपनी ही माँ के बेटे पर तोहमत लगाता है।<verse eid="PSA 50:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21"/>तूने यह काम किए और मैं ख़ामोश रहा;</para>
  <para style="q" vid="PSA 50:21">तूने गुमान किया, कि मैं बिल्कुल तुझ ही सा हूँ।</para>
  <para style="q" vid="PSA 50:21">लेकिन मैं तुझे मलामत करके इनको तेरी आँखों के सामने तरतीब दूँगा।<verse eid="PSA 50:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22"/>“अब ऐ ख़ुदा को भूलने वालो, इसे सोच लो,</para>
  <para style="q" vid="PSA 50:22">ऐसा न हो कि मैं तुम को फाड़ डालूँ,</para>
  <para style="q" vid="PSA 50:22">और कोई छुड़ाने वाला न हो।<verse eid="PSA 50:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23"/>जो शुक्रगुज़ारी की क़ुर्बानी पेश करता है वह मेरी तम्जीद करता है;</para>
  <para style="q" vid="PSA 50:23">और जो अपना चालचलन दुरुस्त रखता है,</para>
  <para style="q" vid="PSA 50:23">उसको मैं ख़ुदा की नजात दिखाऊँगा।”<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 51:1"/>ऐ ख़ुदा! अपनी शफ़क़त के मुताबिक़ मुझ पर रहम कर;</para>
  <para style="q" vid="PSA 51:1">अपनी रहमत की कसरत के मुताबिक़ मेरी ख़ताएँ मिटा दे।<verse eid="PSA 51:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 51:2"/>मेरी बदी को मुझ से धो डाल,</para>
  <para style="q" vid="PSA 51:2">और मेरे गुनाह से मुझे पाक कर!<verse eid="PSA 51:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 51:3"/>क्यूँकि मैं अपनी ख़ताओं को मानता हूँ,</para>
  <para style="q" vid="PSA 51:3">और मेरा गुनाह हमेशा मेरे सामने है।<verse eid="PSA 51:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 51:4"/>मैंने सिर्फ़ तेरा ही गुनाह किया है,</para>
  <para style="q" vid="PSA 51:4">और वह काम किया है जो तेरी नज़र में बुरा है;</para>
  <para style="q" vid="PSA 51:4">ताकि तू अपनी बातों में रास्त ठहरे,</para>
  <para style="q" vid="PSA 51:4">और अपनी 'अदालत में बे'ऐब रहे।<verse eid="PSA 51:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 51:5"/>देख, मैंने बदी में सूरत पकड़ी,</para>
  <para style="q" vid="PSA 51:5">और मैं गुनाह की हालत में माँ के पेट में पड़ा।<verse eid="PSA 51:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 51:6"/>देख, तू बातिन की सच्चाई पसंद करता है,</para>
  <para style="q" vid="PSA 51:6">और बातिन ही में मुझे दानाई सिखाएगा।<verse eid="PSA 51:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 51:7"/>ज़ूफ़े से मुझे साफ़ कर, तो मैं पाक हूँगा;</para>
  <para style="q" vid="PSA 51:7">मुझे धो, और मैं बर्फ़ से ज़्यादा सफ़ेद हूँगा।<verse eid="PSA 51:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 51:8"/>मुझे ख़ुशी और ख़ुर्रमी की ख़बर सुना,</para>
  <para style="q" vid="PSA 51:8">ताकि वह हड्डियाँ जो तूने तोड़ डाली, हैं, ख़ुश हों।<verse eid="PSA 51:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 51:9"/>मेरे गुनाहों की तरफ़ से अपना मुँह फेर ले,</para>
  <para style="q" vid="PSA 51:9">और मेरी सब बदकारी मिटा डाल।<verse eid="PSA 51:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 51:10"/>ऐ ख़ुदा! मेरे अन्दर पाक दिल पैदा कर,</para>
  <para style="q" vid="PSA 51:10">और मेरे बातिन में शुरू' से सच्ची रूह डाल।<verse eid="PSA 51:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 51:11"/>मुझे अपने सामने से ख़ारिज न कर,</para>
  <para style="q" vid="PSA 51:11">और अपनी पाक रूह को मुझ से जुदा न कर।<verse eid="PSA 51:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 51:12"/>अपनी नजात की शादमानी मुझे फिर'इनायत कर,</para>
  <para style="q" vid="PSA 51:12">और मुस्त'इद रूह से मुझे संभाल।<verse eid="PSA 51:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 51:13"/>तब मैं ख़ताकारों को तेरी राहें सिखाऊँगा,</para>
  <para style="q" vid="PSA 51:13">और गुनहगार तेरी तरफ़ रुजू' करेंगे।<verse eid="PSA 51:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 51:14"/>ऐ ख़ुदा! ऐ मेरे नजात बख़्श ख़ुदा,</para>
  <para style="q" vid="PSA 51:14">मुझे खू़न के जुर्म से छुड़ा,</para>
  <para style="q" vid="PSA 51:14">तो मेरी ज़बान तेरी सदाक़त का हम्द गाएगी।<verse eid="PSA 51:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 51:15"/>ऐ ख़ुदावन्द! मेरे होंटों को खोल दे,</para>
  <para style="q" vid="PSA 51:15">तो मेरे मुँह से तेरी सिताइश निकलेगी।<verse eid="PSA 51:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 51:16"/>क्यूँकि कु़र्बानी में तेरी ख़ुशी नहीं,</para>
  <para style="q" vid="PSA 51:16">वरना मैं देता;</para>
  <para style="q" vid="PSA 51:16">सोख़्तनी कु़र्बानी से तुझे कुछ ख़ुशी नहीं।<verse eid="PSA 51:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 51:17"/>शिकस्ता रूह ख़ुदा की कु़र्बानी है;</para>
  <para style="q" vid="PSA 51:17">ऐ ख़ुदा! तू शिकस्ता और ख़स्तादिल को हक़ीर न जानेगा।<verse eid="PSA 51:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 51:18"/>अपने करम से सिय्यून के साथ भलाई कर,</para>
  <para style="q" vid="PSA 51:18">येरूशलेम की फ़सील को तामीर कर,<verse eid="PSA 51:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 51:19"/>तब तू सदाक़त की कु़र्बानियों</para>
  <para style="q" vid="PSA 51:19">और सोख़्तनी कु़र्बानी और पूरी सोख़्तनी कु़र्बानी से खु़श होगा;</para>
  <para style="q" vid="PSA 51:19">और वह तेरे मज़बह पर बछड़े चढ़ाएँगे।<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 52:1"/>ऐ ज़बरदस्त, तू शरारत पर क्यूँ फ़ख़्र करता है?</para>
  <para style="q" vid="PSA 52:1">ख़ुदा की शफ़क़त हमेशा की है।<verse eid="PSA 52:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 52:2"/>तेरी ज़बान महज़ शरारत ईजाद करती है;</para>
  <para style="q" vid="PSA 52:2">ऐ दग़ाबाज़, वह तेज़ उस्तरे की तरह है।<verse eid="PSA 52:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 52:3"/>तू बदी को नेकी से ज़्यादा पसंद करता है,</para>
  <para style="q" vid="PSA 52:3">और झूट को सदाक़त की बात से।<verse eid="PSA 52:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 52:4"/>ऐ दग़ाबाज़ ज़बान!</para>
  <para style="q" vid="PSA 52:4">तू मुहलिक बातों को पसंद करती है।<verse eid="PSA 52:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 52:5"/>ख़ुदा भी तुझे हमेशा के लिए हलाक कर डालेगा;</para>
  <para style="q" vid="PSA 52:5">वह तुझे पकड़ कर तेरे ख़ेमे से निकाल फेंकेगा,</para>
  <para style="q" vid="PSA 52:5">और ज़िन्दों की ज़मीन से तुझे उखाड़ डालेगा। सिलाह<verse eid="PSA 52:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 52:6"/>सादिक़ भी इस बात को देख कर डर जाएँगे,</para>
  <para style="q" vid="PSA 52:6">और उस पर हँसेंगे,<verse eid="PSA 52:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 52:7"/>कि देखो, यह वही आदमी है जिसने ख़ुदा को अपनी पनाहगाह न बनाया,</para>
  <para style="q" vid="PSA 52:7">बल्कि अपने माल की ज़यादती पर भरोसा किया,</para>
  <para style="q" vid="PSA 52:7">और शरारत में पक्का हो गया।<verse eid="PSA 52:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 52:8"/>लेकिन मैं तो ख़ुदा के घर में जैतून के हरे दरख़्त की तरह हूँ।</para>
  <para style="q" vid="PSA 52:8">मेरा भरोसा हमेशा से हमेशा तक ख़ुदा की शफ़क़त पर है।<verse eid="PSA 52:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 52:9"/>मैं हमेशा तेरी शुक्रगुज़ारी करता रहूँगा,</para>
  <para style="q" vid="PSA 52:9">क्यूँकि तू ही ने यह किया है;</para>
  <para style="q" vid="PSA 52:9">और मुझे तेरे ही नाम की आस होगी,</para>
  <para style="q" vid="PSA 52:9">क्यूँकि वह तेरे पाक लोगों के नज़दीक खू़ब है।<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 53:1"/>बेवकू़फ़ ने अपने दिल में कहा है,</para>
  <para style="q" vid="PSA 53:1">कि कोई ख़ुदा नहीं। वह बिगड़ गये उन्होंने नफ़रत अंगेज़ बदी की है।</para>
  <para style="q" vid="PSA 53:1">कोई नेकोकार नहीं।<verse eid="PSA 53:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 53:2"/>ख़ुदा ने आसमान पर से बनी आदम पर निगाह की</para>
  <para style="q" vid="PSA 53:2">ताकि देखे कि कोई दानिशमंद,</para>
  <para style="q" vid="PSA 53:2">कोई ख़ुदा का तालिब है या नहीं।<verse eid="PSA 53:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 53:3"/>वह सब के सब फिर गए हैं,</para>
  <para style="q" vid="PSA 53:3">वह एक साथ नापाक हो गए;</para>
  <para style="q" vid="PSA 53:3">कोई नेकोकार नहीं, एक भी नहीं।<verse eid="PSA 53:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 53:4"/>क्या उन सब बदकिरदारों को कुछ 'इल्म नहीं,</para>
  <para style="q" vid="PSA 53:4">जो मेरे लोगों को ऐसे खाते हैं जैसे रोटी,</para>
  <para style="q" vid="PSA 53:4">और ख़ुदा का नाम नहीं लेते?<verse eid="PSA 53:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 53:5"/>वहाँ उन पर बड़ा ख़ौफ़ छा गया जबकि ख़ौफ़ की कोई बात न थी।</para>
  <para style="q" vid="PSA 53:5">क्यूँकि ख़ुदा ने उनकी हड्डियाँ जो तेरे ख़िलाफ़ खै़माज़न थे,</para>
  <para style="q" vid="PSA 53:5">बिखेर दीं। तूने उनको शर्मिन्दा कर दिया,</para>
  <para style="q" vid="PSA 53:5">इसलिए कि ख़ुदा ने उनको रद्द कर दिया है।<verse eid="PSA 53:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 53:6"/>काश कि इस्राईल की नजात सिय्यून में से होती!</para>
  <para style="q" vid="PSA 53:6">जब ख़ुदा अपने लोगों को ग़ुलामी से लौटा लाएगा;</para>
  <para style="q" vid="PSA 53:6">तो या'कू़ब ख़ुश और इस्राईल शादमान होगा।<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 54:1"/>ऐ ख़ुदा! अपने नाम के वसीले से मुझे बचा,</para>
  <para style="q" vid="PSA 54:1">और अपनी कु़दरत से मेरा इन्साफ़ कर।<verse eid="PSA 54:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 54:2"/>ऐ ख़ुदा मेरी दुआ सुन ले;</para>
  <para style="q" vid="PSA 54:2">मेरे मुँह की बातों पर कान लगा।<verse eid="PSA 54:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 54:3"/>क्यूँकि बेगाने मेरे ख़िलाफ़ उठे हैं,</para>
  <para style="q" vid="PSA 54:3">और टेढ़े लोग मेरी जान के तलबगार हुए हैं;</para>
  <para style="q" vid="PSA 54:3">उन्होंने ख़ुदा को अपने सामने नहीं रख्खा।<verse eid="PSA 54:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 54:4"/>देखो, ख़ुदा मेरा मददगार है!</para>
  <para style="q" vid="PSA 54:4">ख़ुदावन्द मेरी जान को संभालने वालों में है।<verse eid="PSA 54:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 54:5"/>वह बुराई को मेरे दुश्मनों ही पर लौटा देगा;</para>
  <para style="q" vid="PSA 54:5">तू अपनी सच्चाई की रूह से उनको फ़ना कर!<verse eid="PSA 54:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 54:6"/>मैं तेरे सामने रज़ा की कु़र्बानी चढ़ाऊँगा;</para>
  <para style="q" vid="PSA 54:6">ऐ ख़ुदावन्द! मैं तेरे नाम की शुक्रगु़ज़ारी करूँगा</para>
  <para style="q" vid="PSA 54:6">क्यूँकि वह खू़ब है।<verse eid="PSA 54:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 54:7"/>क्यूँकि उसने मुझे सब मुसीबतों से छुड़ाया है,</para>
  <para style="q" vid="PSA 54:7">और मेरी आँख ने मेरे दुश्मनों को देख लिया है।<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 55:1"/>ऐ खु़दा! मेरी दुआ पर कान लगा;</para>
  <para style="q" vid="PSA 55:1">और मेरी मिन्नत से मुँह न फेर।<verse eid="PSA 55:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 55:2"/>मेरी तरफ़ मुतवज्जिह हो और मुझे जवाब दे;</para>
  <para style="q" vid="PSA 55:2">मैं ग़म से बेक़रार होकर कराहता हूँ।<verse eid="PSA 55:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 55:3"/>दुश्मन की आवाज़ से,</para>
  <para style="q" vid="PSA 55:3">और शरीर के जु़ल्म की वजह;</para>
  <para style="q" vid="PSA 55:3">क्यूँकि वह मुझ पर बदी लादते,</para>
  <para style="q" vid="PSA 55:3">और क़हर में मुझे सताते हैं।<verse eid="PSA 55:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 55:4"/>मेरा दिल मुझ में बेताब है;</para>
  <para style="q" vid="PSA 55:4">और मौत का हौल मुझ पर छा गया है।<verse eid="PSA 55:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 55:5"/>ख़ौफ़ और कपकपी मुझ पर तारी है,</para>
  <para style="q" vid="PSA 55:5">डर ने मुझे दबा लिया है;<verse eid="PSA 55:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 55:6"/>और मैंने कहा, “काश कि कबूतर की तरह मेरे पर होते</para>
  <para style="q" vid="PSA 55:6">तो मैं उड़ जाता और आराम पाता!<verse eid="PSA 55:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 55:7"/>फिर तो मैं दूर निकल जाता,</para>
  <para style="q" vid="PSA 55:7">और वीरान में बसेरा करता। सिलाह<verse eid="PSA 55:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 55:8"/>मैं आँधी के झोंके और तूफ़ान से,</para>
  <para style="q" vid="PSA 55:8">किसी पनाह की जगह में भाग जाता।”<verse eid="PSA 55:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 55:9"/>ऐ ख़ुदावन्द! उनको हलाक कर,</para>
  <para style="q" vid="PSA 55:9">और उनकी ज़बान में तफ़रिक़ा डाल;</para>
  <para style="q" vid="PSA 55:9">क्यूँकि मैंने शहर में जु़ल्म और झगड़ा देखा है।<verse eid="PSA 55:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 55:10"/>दिन रात वह उसकी फ़सील पर गश्त लगाते हैं;</para>
  <para style="q" vid="PSA 55:10">बदी और फ़साद उसके अंदर हैं।<verse eid="PSA 55:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 55:11"/>शरारत उसके बीच में बसी हुई है;</para>
  <para style="q" vid="PSA 55:11">सितम और फ़रेब उसके कूचों से दूर नहीं होते।<verse eid="PSA 55:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 55:12"/>जिसने मुझे मलामत की वह दुश्मन न था,</para>
  <para style="q" vid="PSA 55:12">वरना मैं उसको बर्दाश्त कर लेता;</para>
  <para style="q" vid="PSA 55:12">और जिसने मेरे ख़िलाफ़ तकब्बुर किया वह मुझ से 'अदावत रखने वाला न था,</para>
  <para style="q" vid="PSA 55:12">नहीं तो मैं उससे छिप जाता।<verse eid="PSA 55:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 55:13"/>बल्कि वह तो तू ही था जो मेरा हमसर,</para>
  <para style="q" vid="PSA 55:13">मेरा रफ़ीक और दिली दोस्त था।<verse eid="PSA 55:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 55:14"/>हमारी आपसी गुफ़्तगू शीरीन थी;</para>
  <para style="q" vid="PSA 55:14">और हुजूम के साथ ख़ुदा के घर में फिरते थे।<verse eid="PSA 55:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 55:15"/>उनकी मौत अचानक आ दबाए;</para>
  <para style="q" vid="PSA 55:15">वह जीते जी पाताल में उतर जाएँ:</para>
  <para style="q" vid="PSA 55:15">क्यूँकि शरारत उनके घरों में और उनके अन्दर है।<verse eid="PSA 55:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 55:16"/>लेकिन मैं तो ख़ुदा को पुकारूँगा;</para>
  <para style="q" vid="PSA 55:16">और ख़ुदावन्द मुझे बचा लेगा।<verse eid="PSA 55:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 55:17"/>सुबह — ओ — शाम और दोपहर को</para>
  <para style="q" vid="PSA 55:17">मैं फ़रियाद करूँगा और कराहता रहूँगा,</para>
  <para style="q" vid="PSA 55:17">और वह मेरी आवाज़ सुन लेगा।<verse eid="PSA 55:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 55:18"/>उसने उस लड़ाई से जो मेरे ख़िलाफ़ थी,</para>
  <para style="q" vid="PSA 55:18">मेरी जान को सलामत छुड़ा लिया।</para>
  <para style="q" vid="PSA 55:18">क्यूँकि मुझसे झगड़ा करने वाले बहुत थे।<verse eid="PSA 55:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 55:19"/>ख़ुदा जो क़दीम से है,</para>
  <para style="q" vid="PSA 55:19">सुन लेगा और उनको जवाब देगा।</para>
  <para style="q" vid="PSA 55:19">यह वह हैं जिनके लिए इन्क़लाब नहीं,</para>
  <para style="q" vid="PSA 55:19">और जो ख़ुदा से नहीं डरते।<verse eid="PSA 55:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 55:20"/>उस शख़्स ने ऐसों पर हाथ बढ़ाया है,</para>
  <para style="q" vid="PSA 55:20">जो उससे सुल्ह रखते थे।</para>
  <para style="q" vid="PSA 55:20">उसने अपने 'अहद को तोड़ दिया है।<verse eid="PSA 55:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 55:21"/>उसका मुँह मख्खन की तरह चिकना था,</para>
  <para style="q" vid="PSA 55:21">लेकिन उसके दिल में जंग थी।</para>
  <para style="q" vid="PSA 55:21">उसकी बातें तेल से ज़्यादा मुलायम,</para>
  <para style="q" vid="PSA 55:21">लेकिन नंगी तलवारें थीं।<verse eid="PSA 55:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 55:22"/>अपना बोझ ख़ुदावन्द पर डाल दे,</para>
  <para style="q" vid="PSA 55:22">वह तुझे संभालेगा।</para>
  <para style="q" vid="PSA 55:22">वह सादिक़ को कभी जुम्बिश न खाने देगा।<verse eid="PSA 55:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 55:23"/>लेकिन ऐ ख़ुदा! तू उनको हलाकत के गढ़े में उतारेगा।</para>
  <para style="q" vid="PSA 55:23">खू़नी और दग़ाबाज़ अपनी आधी उम्र तक भी ज़िन्दा न रहेंगे।</para>
  <para style="q" vid="PSA 55:23">लेकिन मैं तुझ पर भरोसा करूँगा।<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 56:1"/>ऐ ख़ुदा! मुझ पर रहम फ़रमा,</para>
  <para style="q" vid="PSA 56:1">क्यूँकि इंसान मुझे निगलना चाहता है;</para>
  <para style="q" vid="PSA 56:1">वह दिन भर लड़कर मुझे सताता है।<verse eid="PSA 56:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 56:2"/>मेरे दुश्मन दिन भर मुझे निगलना चाहते हैं,</para>
  <para style="q" vid="PSA 56:2">क्यूँकि जो गु़रूर करके मुझ से लड़ते हैं, वह बहुत हैं।<verse eid="PSA 56:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 56:3"/>जिस वक़्त मुझे डर लगेगा,</para>
  <para style="q" vid="PSA 56:3">मैं तुझ पर भरोसा करूँगा।<verse eid="PSA 56:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 56:4"/>मेरा फ़ख़्र ख़ुदा पर और उसके कलाम पर है।</para>
  <para style="q" vid="PSA 56:4">मेरा भरोसा ख़ुदा पर है,</para>
  <para style="q" vid="PSA 56:4">मैं डरने का नहीं:बशर मेरा क्या कर सकता है?<verse eid="PSA 56:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 56:5"/>वह दिन भर मेरी बातों को मरोड़ते रहते हैं;</para>
  <para style="q" vid="PSA 56:5">उनके ख़याल सरासर यही हैं, कि मुझ से बदी करें।<verse eid="PSA 56:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 56:6"/>वह इकठ्ठे होकर छिप जाते हैं;</para>
  <para style="q" vid="PSA 56:6">वह मेरे नक्श — ए — क़दम को देखते भालते हैं,</para>
  <para style="q" vid="PSA 56:6">क्यूँकि वह मेरी जान की घात में हैं।<verse eid="PSA 56:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 56:7"/>क्या वह बदकारी करके बच जाएँगे?</para>
  <para style="q" vid="PSA 56:7">ऐ ख़ुदा, क़हर में उम्मतों को गिरा दे!<verse eid="PSA 56:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 56:8"/>तू मेरी आवारगी का हिसाब रखता है;</para>
  <para style="q" vid="PSA 56:8">मेरे आँसुओं को अपने मश्कीज़े में रख ले।</para>
  <para style="q" vid="PSA 56:8">क्या वह तेरी किताब में लिखे नहीं हैं?<verse eid="PSA 56:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 56:9"/>तब तो जिस दिन मैं फ़रियाद करूँगा,</para>
  <para style="q" vid="PSA 56:9">मेरे दुश्मन पस्पा होंगे।</para>
  <para style="q" vid="PSA 56:9">मुझे यह मा'लूम है कि ख़ुदा मेरी तरफ़ है।<verse eid="PSA 56:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 56:10"/>मेरा फ़ख़्र ख़ुदा पर और उसके कलाम पर है;</para>
  <para style="q" vid="PSA 56:10">मेरा फ़ख़्र ख़ुदावन्द पर और उसके कलाम पर है।<verse eid="PSA 56:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 56:11"/>मेरा भरोसा ख़ुदा पर है, मैं डरने का नहीं।</para>
  <para style="q" vid="PSA 56:11">इंसान मेरा क्या कर सकता है?<verse eid="PSA 56:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 56:12"/>ऐ ख़ुदा! तेरी मन्नतें मुझ पर हैं;</para>
  <para style="q" vid="PSA 56:12">मैं तेरे हुजू़र शुक्रगुज़ारी की कु़र्बानियाँ पेश करूँगा।<verse eid="PSA 56:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 56:13"/>क्यूँकि तूने मेरी जान को मौत से छुड़ाया;</para>
  <para style="q" vid="PSA 56:13">क्या तूने मेरे पाँव को फिसलने से नहीं बचाया,</para>
  <para style="q" vid="PSA 56:13">ताकि मैं ख़ुदा के सामने ज़िन्दों के नूर में चलूँ?<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 57:1"/>मुझ पर रहम कर, ऐ ख़ुदा! मुझ पर रहम कर,</para>
  <para style="q" vid="PSA 57:1">क्यूँकि मेरी जान तेरी पनाह लेती है।</para>
  <para style="q" vid="PSA 57:1">मैं तेरे परों के साये में पनाह लूँगा,</para>
  <para style="q" vid="PSA 57:1">जब तक यह आफ़तें गुज़र न जाएँ।<verse eid="PSA 57:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 57:2"/>मैं ख़ुदा ता'ला से फ़रियाद करूँगा;</para>
  <para style="q" vid="PSA 57:2">ख़ुदा से, जो मेरे लिए सब कुछ करता है।<verse eid="PSA 57:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 57:3"/>वह मेरी नजात के लिए आसमान से भेजेगा;</para>
  <para style="q" vid="PSA 57:3">जब वह जो मुझे निगलना चाहता है,</para>
  <para style="q" vid="PSA 57:3">मलामत करता हो। सिलाह ख़ुदा अपनी शफ़क़त</para>
  <para style="q" vid="PSA 57:3">और सच्चाई को भेजेगा।<verse eid="PSA 57:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 57:4"/>मेरी जान बबरों के बीच है,</para>
  <para style="q" vid="PSA 57:4">मैं आतिश मिज़ाज लोगों में पड़ा हूँ</para>
  <para style="q" vid="PSA 57:4">या'नी ऐसे लोगों में जिनके दाँत बर्छियाँऔर तीर हैं,</para>
  <para style="q" vid="PSA 57:4">जिनकी ज़बान तेज़ तलवार है।<verse eid="PSA 57:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 57:5"/>ऐ ख़ुदा! तू आसमान पर सरफ़राज़ हो,</para>
  <para style="q" vid="PSA 57:5">तेरा जलाल सारी ज़मीन पर हो!<verse eid="PSA 57:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 57:6"/>उन्होंने मेरे पाँव के लिए जाल लगाया है;</para>
  <para style="q" vid="PSA 57:6">मेरी जान 'आजिज़ आ गई।</para>
  <para style="q" vid="PSA 57:6">उन्होंने मेरे आगे गढ़ा खोदा,</para>
  <para style="q" vid="PSA 57:6">वह ख़ुद उसमें गिर पड़े। सिलाह<verse eid="PSA 57:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 57:7"/>मेरा दिल क़ाईम है, ऐ ख़ुदा! मेरा दिल क़ाईम है;</para>
  <para style="q" vid="PSA 57:7">मैं गाऊँगा बल्कि मैं मदह सराई करूँगा।<verse eid="PSA 57:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 57:8"/>ऐ मेरी शौकत, बेदार हो! ऐ बर्बत और सितार जागो!</para>
  <para style="q" vid="PSA 57:8">मैं ख़ुद सुबह सवेरे जाग उठूँगा।<verse eid="PSA 57:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 57:9"/>ऐ ख़ुदावन्द! मैं लोगों में तेरा शुक्र करूँगा।</para>
  <para style="q" vid="PSA 57:9">मैं उम्मतों में तेरी मदहसराई करूँगा।<verse eid="PSA 57:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 57:10"/>क्यूँकि तेरी शफ़क़त आसमान के,</para>
  <para style="q" vid="PSA 57:10">और तेरी सच्चाई फ़लाक के बराबर बुलन्द है।<verse eid="PSA 57:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 57:11"/>ऐ ख़ुदा! तू आसमान पर सरफ़राज़ हो!</para>
  <para style="q" vid="PSA 57:11">तेरा जलाल सारी ज़मीन पर हो!<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 58:1"/>ऐ बुज़ुर्गों! क्या तुम दर हक़ीक़त रास्तगोई करते हो?</para>
  <para style="q" vid="PSA 58:1">ऐ बनी आदम! क्या तुम ठीक 'अदालत करते हो?<verse eid="PSA 58:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 58:2"/>बल्कि तुम तो दिल ही दिल में शरारत करते हो;</para>
  <para style="q" vid="PSA 58:2">और ज़मीन पर अपने हाथों से जु़ल्म पैमाई करते हैं।<verse eid="PSA 58:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 58:3"/>शरीर पैदाइश ही से कजरवी इख़्तियार करते हैं;</para>
  <para style="q" vid="PSA 58:3">वह पैदा होते ही झूट बोलकर गुमराह हो जाते हैं।<verse eid="PSA 58:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 58:4"/>उनका ज़हर साँप का सा ज़हर है;</para>
  <para style="q" vid="PSA 58:4">वह बहरे अज़दहे की तरह हैं जो कान बंद कर लेता है;<verse eid="PSA 58:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 58:5"/>जो मन्तर पढ़ने वालों की आवाज़ ही नहीं सुनता,</para>
  <para style="q" vid="PSA 58:5">जो चाहे वह कितनी ही होशियारी से मन्तर पढ़ें।<verse eid="PSA 58:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 58:6"/>ऐ ख़ुदा! तू उनके दाँत उनके मुँह में तोड़ दे,</para>
  <para style="q" vid="PSA 58:6">ऐ ख़ुदावन्द! बबर के बच्चों की दाढ़ें तोड़ डाल।<verse eid="PSA 58:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 58:7"/>वह घुलकर बहते पानी की तरह हो जाएँ जब वह अपने तीर चलाए,</para>
  <para style="q" vid="PSA 58:7">तो वह जैसे कुन्द पैकान हों।<verse eid="PSA 58:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 58:8"/>वह ऐसे हो जाएँ जैसे घोंघा, जो गल कर फ़ना हो जाता है;</para>
  <para style="q" vid="PSA 58:8">और जैसे 'औरत का इस्कात जिसने सूरज को देखा ही नहीं।<verse eid="PSA 58:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 58:9"/>इससे पहले कि तुम्हारी हड्डियों को काँटों की आंच लगे</para>
  <para style="q" vid="PSA 58:9">वह हरे और जलते दोनों को यकसाँ बगोले से उड़ा ले जाएगा।<verse eid="PSA 58:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 58:10"/>सादिक़ इन्तक़ाम को देखकर खु़श होगा;</para>
  <para style="q" vid="PSA 58:10">वह शरीर के खू़न से अपने पाँव तर करेगा।<verse eid="PSA 58:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 58:11"/>तब लोग कहेंगे, यक़ीनन सादिक़ के लिए अज्र है;</para>
  <para style="q" vid="PSA 58:11">बेशक ख़ुदा है, जो ज़मीन पर 'अदालत करता है।<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 59:1"/>ऐ मेरे खु़दा मुझे मेरे दुश्मनों से छुड़ा</para>
  <para style="q" vid="PSA 59:1">मेरे ख़िलाफ़ उठने वालों पर सरफ़राज़ कर।<verse eid="PSA 59:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 59:2"/>मुझे बदकिरदारों से छुड़ा,</para>
  <para style="q" vid="PSA 59:2">और खूंख़्वार आदमियों से मुझे बचा।<verse eid="PSA 59:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 59:3"/>क्यूँकि देख, वह मेरी जान की घात में हैं।</para>
  <para style="q" vid="PSA 59:3">ऐ ख़ुदावन्द! मेरी ख़ता या मेरे गुनाह के बगै़र ज़बरदस्त लोग मेरे ख़िलाफ़ इकठ्ठे होते हैं।<verse eid="PSA 59:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 59:4"/>वह मुझ बेक़सूर पर दौड़ दौड़कर तैयार होते हैं;</para>
  <para style="q" vid="PSA 59:4">मेरी मदद के लिए जाग और देख!<verse eid="PSA 59:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 59:5"/>ऐ ख़ुदावन्द, लश्करों के ख़ुदा! इस्राईल के ख़ुदा!</para>
  <para style="q" vid="PSA 59:5">सब कौमों के मुहासिबे के लिए उठ;</para>
  <para style="q" vid="PSA 59:5">किसी दग़ाबाज़ ख़ताकार पर रहम न कर। सिलाह<verse eid="PSA 59:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 59:6"/>वह शाम को लौटते और कुत्ते की तरह भौंकते हैं</para>
  <para style="q" vid="PSA 59:6">और शहर के गिर्द फिरते हैं।<verse eid="PSA 59:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 59:7"/>देख! वह अपने मुँह से डकारते हैं,</para>
  <para style="q" vid="PSA 59:7">उनके लबों के अन्दर तलवारें हैं;</para>
  <para style="q" vid="PSA 59:7">क्यूँकि वह कहते हैं, “कौन सुनता है?”<verse eid="PSA 59:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 59:8"/>लेकिन ऐ ख़ुदावन्द! तू उन पर हँसेगा;</para>
  <para style="q" vid="PSA 59:8">तू तमाम क़ौमों को ठट्ठों में उड़ाएगा।<verse eid="PSA 59:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 59:9"/>ऐ मेरी कु़व्वत, मुझे तेरी ही आस होगी,</para>
  <para style="q" vid="PSA 59:9">क्यूँकि ख़ुदा मेरा ऊँचा बुर्ज है।<verse eid="PSA 59:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 59:10"/>मेरा ख़ुदा अपनी शफ़क़त से मेरा अगुवा होगा,</para>
  <para style="q" vid="PSA 59:10">ख़ुदा मुझे मेरे दुश्मनों की पस्ती दिखाएगा।<verse eid="PSA 59:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 59:11"/>उनको क़त्ल न कर, ऐसा न हो मेरे लोग भूल जाएँ</para>
  <para style="q" vid="PSA 59:11">ऐ ख़ुदावन्द, ऐ हमारी ढाल!,</para>
  <para style="q" vid="PSA 59:11">अपनी कु़दरत से उनको तितर बितर करके पस्त कर दे।<verse eid="PSA 59:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 59:12"/>वह अपने मुँह के गुनाह,</para>
  <para style="q" vid="PSA 59:12">और अपने होंटों की बातों और अपनी लान तान और झूट बोलने के वजह से,</para>
  <para style="q" vid="PSA 59:12">अपने गु़रूर में पकड़े जाएँ।<verse eid="PSA 59:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 59:13"/>क़हर में उनको फ़ना कर दे,</para>
  <para style="q" vid="PSA 59:13">फ़ना कर दे ताकि वह बर्बाद हो जाएँ,</para>
  <para style="q" vid="PSA 59:13">और वह ज़मीन की इन्तिहा तक जान लें,</para>
  <para style="q" vid="PSA 59:13">कि ख़ुदा या'क़ूब पर हुक्मरान है।<verse eid="PSA 59:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 59:14"/>फिर शाम को वह लौटें और कुत्ते की तरह भौंकें</para>
  <para style="q" vid="PSA 59:14">और शहर के गिर्द फिरें।<verse eid="PSA 59:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 59:15"/>वह खाने की तलाश में मारे मारे फिरें,</para>
  <para style="q" vid="PSA 59:15">और अगर आसूदा न हों तो सारी रात ठहरे रहे।<verse eid="PSA 59:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 59:16"/>लेकिन मैं तेरी कु़दरत का हम्द गाऊँगा,</para>
  <para style="q" vid="PSA 59:16">बल्कि सुबह को बुलन्द आवाज़ से तेरी शफ़क़त का हम्द गाऊँगा।</para>
  <para style="q" vid="PSA 59:16">क्यूँकि तू मेरा ऊँचा बुर्ज है,</para>
  <para style="q" vid="PSA 59:16">और मेरी मुसीबत के दिन मेरी पनाहगाह।<verse eid="PSA 59:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 59:17"/>ऐ मेरी ताक़त, मै तेरी मदहसराई करूँगा;</para>
  <para style="q" vid="PSA 59:17">क्यूँकि ख़ुदा मेरा शफ़ीक़ ख़ुदा मेरा ऊँचाबुर्ज है।<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 60:1"/>ऐ ख़ुदा, तूने हमें रद्द किया;</para>
  <para style="q" vid="PSA 60:1">तूने हमें शिकस्ता हाल कर दिया।</para>
  <para style="q" vid="PSA 60:1">तू नाराज़ रहा है। हमें फिर बहाल कर।<verse eid="PSA 60:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 60:2"/>तूने ज़मीन को लरज़ा दिया;</para>
  <para style="q" vid="PSA 60:2">तूने उसे फाड़ डाला है।</para>
  <para style="q" vid="PSA 60:2">उसके रख़्ने बन्द कर दे क्यूँकि वह लरज़ाँ है।<verse eid="PSA 60:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 60:3"/>तूने अपने लोगों को सख़्तियाँ दिखाई,</para>
  <para style="q" vid="PSA 60:3">तूने हमको लड़खड़ा देने वाली मय पिलाई।<verse eid="PSA 60:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 60:4"/>जो तुझ से डरते हैं, तूने उनको एक झंडा दिया है;</para>
  <para style="q" vid="PSA 60:4">ताकि वह हक़ की ख़ातिर बुलन्द किया जाएं। सिलाह<verse eid="PSA 60:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 60:5"/>अपने दहने हाथ से बचा और हमें जवाब दे,</para>
  <para style="q" vid="PSA 60:5">ताकि तेरे महबूब बचाए जाएँ।<verse eid="PSA 60:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 60:6"/>ख़ुदा ने अपनी पाकीज़गी में फ़रमाया है, “मैं ख़ुशी करूँगा;</para>
  <para style="q" vid="PSA 60:6">मैं सिकम को तक़सीम करूँगा, और सुकात की वादी को बाटूँगा।<verse eid="PSA 60:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 60:7"/>जिल'आद मेरा है, मनस्सी भी मेरा है;</para>
  <para style="q" vid="PSA 60:7">इफ़्राईम मेरे सिर का खू़द है,</para>
  <para style="q" vid="PSA 60:7">यहूदाह मेरा 'असा है।<verse eid="PSA 60:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 60:8"/>मोआब मेरी चिलमची है,</para>
  <para style="q" vid="PSA 60:8">अदोम पर मैं जूता फेफूँगा;</para>
  <para style="q" vid="PSA 60:8">ऐ फ़िलिस्तीन, मेरी वजह से ललकार।”<verse eid="PSA 60:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 60:9"/>मुझे उस मुहकम शहर में कौन पहुँचाएगा?</para>
  <para style="q" vid="PSA 60:9">कौन मुझे अदोम तक ले गया है?<verse eid="PSA 60:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 60:10"/>ऐ ख़ुदा, क्या तूने हमें रद्द नहीं कर दिया?</para>
  <para style="q" vid="PSA 60:10">ऐ ख़ुदा, तू हमारे लश्करों के साथ नहीं जाता।<verse eid="PSA 60:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 60:11"/>मुख़ालिफ़ के मुक़ाबले में हमारी मदद कर,</para>
  <para style="q" vid="PSA 60:11">क्यूँकि इंसानी मदद बेकार है।<verse eid="PSA 60:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 60:12"/>ख़ुदा की मदद से हम बहादुरी करेंगे,</para>
  <para style="q" vid="PSA 60:12">क्यूँकि वही हमारे मुख़ालिफ़ों को पस्त करेगा।<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 61:1"/>ऐ ख़ुदा, मेरी फ़रियाद सुन!</para>
  <para style="q" vid="PSA 61:1">मेरी दुआ पर तवज्जुह कर।<verse eid="PSA 61:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 61:2"/>मैं अपनी अफ़सुर्दा दिली में ज़मीन की इन्तिहा से तुझे पुकारूँगा;</para>
  <para style="q" vid="PSA 61:2">तू मुझे उस चट्टान पर ले चल जो मुझसे ऊँची है;<verse eid="PSA 61:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 61:3"/>क्यूँकि तू मेरी पनाह रहा है,</para>
  <para style="q" vid="PSA 61:3">और दुश्मन से बचने के लिए ऊँचा बुर्ज।<verse eid="PSA 61:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 61:4"/>मैं हमेशा तेरे खे़मे में रहूँगा।</para>
  <para style="q" vid="PSA 61:4">मैं तेरे परों के साये में पनाह लूँगा।<verse eid="PSA 61:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 61:5"/>क्यूँकि ऐ ख़ुदा तूने मेरी मिन्नतें क़ुबूल की हैं</para>
  <para style="q" vid="PSA 61:5">तूने मुझे उन लोगों की सी मीरास बख़्शी है जो तेरे नाम से डरते हैं।<verse eid="PSA 61:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 61:6"/>तू बादशाह की उम्र दराज़ करेगा;</para>
  <para style="q" vid="PSA 61:6">उसकी उम्र बहुत सी नसलों के बराबर होगी।<verse eid="PSA 61:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 61:7"/>वह ख़ुदा के सामने हमेशा क़ाईम रहेगा;</para>
  <para style="q" vid="PSA 61:7">तू शफ़क़त और सच्चाई को उसकी हिफ़ाज़त के लिए मुहय्या कर।<verse eid="PSA 61:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 61:8"/>यूँ मैं हमेशा तेरी मदहसराई करूँगा,</para>
  <para style="q" vid="PSA 61:8">ताकि रोज़ाना अपनी मिन्नतें पूरी करूँ।<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 62:1"/>मेरी जान को ख़ुदा ही की उम्मीद है,</para>
  <para style="q" vid="PSA 62:1">मेरी नजात उसी से है।<verse eid="PSA 62:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 62:2"/>वही अकेला मेरी चट्टान और मेरी नजात है,</para>
  <para style="q" vid="PSA 62:2">वही मेरा ऊँचा बुर्ज है, मुझे ज़्यादा जुम्बिश न होगी।<verse eid="PSA 62:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 62:3"/>तुम कब तक ऐसे शख़्स पर हमला करते रहोगे,</para>
  <para style="q" vid="PSA 62:3">जो झुकी हुई दीवार और हिलती बाड़ की तरह है;</para>
  <para style="q" vid="PSA 62:3">ताकि सब मिलकर उसे क़त्ल करो?<verse eid="PSA 62:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 62:4"/>वह उसको उसके मर्तबे से गिरा देने ही का मश्वरा करते रहते हैं;</para>
  <para style="q" vid="PSA 62:4">वह झूट से ख़ुश होते हैं।</para>
  <para style="q" vid="PSA 62:4">वह अपने मुँह से तो बरकत देते हैं लेकिन दिल में ला'नत करते हैं।<verse eid="PSA 62:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 62:5"/>ऐ मेरी जान, ख़ुदा ही की आस रख,</para>
  <para style="q" vid="PSA 62:5">क्यूँकि उसी से मुझे उम्मीद है।<verse eid="PSA 62:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 62:6"/>वही अकेला मेरी चट्टान और मेरी नजात है;</para>
  <para style="q" vid="PSA 62:6">वही मेरा ऊँचा बुर्ज है, मुझे जुम्बिश न होगी।<verse eid="PSA 62:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 62:7"/>मेरी नजात और मेरी शौकत ख़ुदा की तरफ़ से है;</para>
  <para style="q" vid="PSA 62:7">ख़ुदा ही मेरी ताक़त की चट्टान और मेरी पनाह है।<verse eid="PSA 62:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 62:8"/>ऐ लोगो। हर वक़्त उस पर भरोसा करो;</para>
  <para style="q" vid="PSA 62:8">अपने दिल का हाल उसके सामने खोल दो।</para>
  <para style="q" vid="PSA 62:8">ख़ुदा हमारी पनाहगाह है। सिलाह<verse eid="PSA 62:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 62:9"/>यक़ीनन अदना लोग बेसबात हैं</para>
  <para style="q" vid="PSA 62:9">और आला आदमी झूटे; वह तराजू़ में हल्के निकलेंगे;</para>
  <para style="q" vid="PSA 62:9">वह सब के सब बेसबाती से भी कमज़ोर हैं<verse eid="PSA 62:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 62:10"/>जु़ल्म पर तकिया न करो,</para>
  <para style="q" vid="PSA 62:10">लूटमार करने पर न फूलो;</para>
  <para style="q" vid="PSA 62:10">अगर माल बढ़ जाए तो उस पर दिल न लगाओ।<verse eid="PSA 62:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 62:11"/>ख़ुदा ने एक बार फ़रमाया;</para>
  <para style="q" vid="PSA 62:11">मैंने यह दो बार सुना,</para>
  <para style="q" vid="PSA 62:11">कि कु़दरत ख़ुदा ही की है।<verse eid="PSA 62:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 62:12"/>शफ़क़त भी ऐ ख़ुदावन्द तेरी ही है;</para>
  <para style="q" vid="PSA 62:12">क्यूँकि तू हर शख़्स को उसके 'अमल के मुताबिक़ बदला देता है।<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 63:1"/>ऐ ख़ुदा, तू मेरा ख़ुदा है,</para>
  <para style="q" vid="PSA 63:1">मै दिल से तेरा तालिब हूँगा;</para>
  <para style="q" vid="PSA 63:1">ख़ुश्क और प्यासी ज़मीन में जहाँ पानी नहीं,</para>
  <para style="q" vid="PSA 63:1">मेरी जान तेरी प्यासी और मेरा जिस्म तेरा मुशताक़ है<verse eid="PSA 63:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 63:2"/>इस तरह मैंने मक़दिस में तुझ पर निगाह की</para>
  <para style="q" vid="PSA 63:2">ताकि तेरी कु़दरत और हश्मत को देखूँ।<verse eid="PSA 63:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 63:3"/>क्यूँकि तेरी शफ़क़त ज़िन्दगी से बेहतर है</para>
  <para style="q" vid="PSA 63:3">मेरे होंट तेरी ता'रीफ़ करेंगे।<verse eid="PSA 63:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 63:4"/>इसी तरह मैं उम्र भर तुझे मुबारक कहूँगा;</para>
  <para style="q" vid="PSA 63:4">और तेरा नाम लेकर अपने हाथ उठाया करूँगा;<verse eid="PSA 63:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 63:5"/>मेरी जान जैसे गूदे और चर्बी से सेर होगी,</para>
  <para style="q" vid="PSA 63:5">और मेरा मुँह मसरूर लबों से तेरी ता'रीफ़ करेगा।<verse eid="PSA 63:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 63:6"/>जब मैं बिस्तर पर तुझे याद करूँगा,</para>
  <para style="q" vid="PSA 63:6">और रात के एक एक पहर में तुझ पर ध्यान करूँगा;<verse eid="PSA 63:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 63:7"/>इसलिए कि तू मेरा मददगार रहा है,</para>
  <para style="q" vid="PSA 63:7">और मैं तेरे परों के साये में ख़ुशी मनाऊँगा।<verse eid="PSA 63:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 63:8"/>मेरी जान को तेरी ही धुन है;</para>
  <para style="q" vid="PSA 63:8">तेरा दहना हाथ मुझे संभालता है।<verse eid="PSA 63:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 63:9"/>लेकिन जो मेरी जान की हलाकत के दर पै हैं,</para>
  <para style="q" vid="PSA 63:9">वह ज़मीन के तह में चले जाएँगे।<verse eid="PSA 63:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 63:10"/>वह तलवार के हवाले होंगे,</para>
  <para style="q" vid="PSA 63:10">वह गीदड़ों का लुक्मा बनेंगे।<verse eid="PSA 63:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 63:11"/>लेकिन बादशाह खु़दा में ख़ुश होगा;</para>
  <para style="q" vid="PSA 63:11">जो उसकी क़सम खाता है वह फ़ख़्र करेगा;</para>
  <para style="q" vid="PSA 63:11">क्यूँकि झूट बोलने वालों का मुँह बन्द कर दिया जाएगा<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 64:1"/>ऐ ख़ुदा मेरी फ़रियाद की आवाज़ सुन ले मेरी जान को</para>
  <para style="q" vid="PSA 64:1">दुश्मन के ख़ौफ़ से बचाए रख।<verse eid="PSA 64:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 64:2"/>शरीरों के ख़ुफ़िया मश्वरे से,</para>
  <para style="q" vid="PSA 64:2">और बदकिरदारों के हँगामे से मुझे छिपा ले<verse eid="PSA 64:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 64:3"/>जिन्होंने अपनी ज़बान तलवार की तरह तेज़ की,</para>
  <para style="q" vid="PSA 64:3">और तल्ख़ बातों के तीरों का निशाना लिया है;<verse eid="PSA 64:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 64:4"/>ताकि उनको ख़ुफ़िया मक़ामों में कामिल आदमी पर चलाएँ;</para>
  <para style="q" vid="PSA 64:4">वह उनको अचानक उस पर चलाते हैं और डरते नहीं।<verse eid="PSA 64:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 64:5"/>वह बुरे काम का मज़बूत इरादा करते हैं;</para>
  <para style="q" vid="PSA 64:5">वह फंदे लगाने की सलाह करते हैं,</para>
  <para style="q" vid="PSA 64:5">वह कहते हैं, “हम को कौन देखेगा?”<verse eid="PSA 64:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 64:6"/>वह शरारतों को खोज खोज कर निकालते हैं;</para>
  <para style="q" vid="PSA 64:6">वह कहते हैं, “हमने खू़ब खोज लगाया।”</para>
  <para style="q" vid="PSA 64:6">उनमें से हर एक का बातिन और दिल 'अमीक है।<verse eid="PSA 64:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 64:7"/>लेकिन ख़ुदा उन पर तीर चलाएगा;</para>
  <para style="q" vid="PSA 64:7">वह अचानक तीर से ज़ख़्मी हो जाएँगे।<verse eid="PSA 64:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 64:8"/>और उन ही की ज़बान उनको तबाह करेगी;</para>
  <para style="q" vid="PSA 64:8">जितने उनको देखेंगे सब सिर हिलाएँगे।<verse eid="PSA 64:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 64:9"/>और सब लोग डर जाएँगे,</para>
  <para style="q" vid="PSA 64:9">और ख़ुदा के काम का बयान करेंगे;</para>
  <para style="q" vid="PSA 64:9">और उसके तरीक़ — ए — 'अमल को बख़ूबी समझ लेंगे।<verse eid="PSA 64:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 64:10"/>सादिक़ ख़ुदावन्द में ख़ुश होगा,</para>
  <para style="q" vid="PSA 64:10">और उस पर भरोसा करेगा,</para>
  <para style="q" vid="PSA 64:10">और जितने रास्तदिल हैं सब फ़ख़्र करेंगे।<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 65:1"/>ऐ ख़ुदा, सिय्यून में ता'रीफ़ तेरी मुन्तज़िर है;</para>
  <para style="q" vid="PSA 65:1">और तेरे लिए मिन्नत पूरी की जाएगी।<verse eid="PSA 65:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 65:2"/>ऐ दुआ के सुनने वाले!</para>
  <para style="q" vid="PSA 65:2">सब बशर तेरे पास आएँगे।<verse eid="PSA 65:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 65:3"/>बद आ'माल मुझ पर ग़ालिब आ जाते हैं;</para>
  <para style="q" vid="PSA 65:3">लेकिन हमारी ख़ताओं का कफ़्फ़ारा तू ही देगा।<verse eid="PSA 65:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 65:4"/>मुबारक है वह आदमी जिसे तू बरगुज़ीदा करता और अपने पास आने देता है,</para>
  <para style="q" vid="PSA 65:4">ताकि वह तेरी बारगाहों में रहे।</para>
  <para style="q" vid="PSA 65:4">हम तेरे घर की खू़बी से, या'नी तेरी पाक हैकल से आसूदा होंगे।<verse eid="PSA 65:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 65:5"/>ऐ हमारे नजात देने वाले ख़ुदा!</para>
  <para style="q" vid="PSA 65:5">तू जो ज़मीन के सब किनारों का और समन्दर पर दूर दूर रहने वालों का तकिया है;</para>
  <para style="q" vid="PSA 65:5">ख़ौफ़नाक बातों के ज़रिए' से तू हमें सदाक़त से जवाब देगा।<verse eid="PSA 65:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 65:6"/>तू कु़दरत से कमरबस्ता होकर,</para>
  <para style="q" vid="PSA 65:6">अपनी ताक़त से पहाड़ों को मज़बूती बख़्शता है।<verse eid="PSA 65:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 65:7"/>तू समन्दर के और उसकी मौजों के शोर को,</para>
  <para style="q" vid="PSA 65:7">और उम्मतों के हँगामे को ख़त्म कर देता है।<verse eid="PSA 65:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 65:8"/>ज़मीन की इन्तिहा के रहने वाले, तेरे मु'मुअजिज़ों से डरते हैं;</para>
  <para style="q" vid="PSA 65:8">तू मतला' — ए — सुबह को और शाम को ख़ुशी बख़्शता है।<verse eid="PSA 65:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 65:9"/>तू ज़मीन पर तवज्जुह करके उसे सेराब करता है,</para>
  <para style="q" vid="PSA 65:9">तू उसे खू़ब मालामाल कर देता है;</para>
  <para style="q" vid="PSA 65:9">ख़ुदा का दरिया पानी से भरा है;</para>
  <para style="q" vid="PSA 65:9">जब तू ज़मीन को यूँ तैयार कर लेता है तो उनके लिए अनाज मुहय्या करता है।<verse eid="PSA 65:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 65:10"/>उसकी रेघारियों को खू़ब सेराब उसकी मेण्डों को बिठा देता उसे बारिश से नर्म करता है,</para>
  <para style="q" vid="PSA 65:10">उसकी पैदावार में बरकत देता<verse eid="PSA 65:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 65:11"/>तू साल को अपने लुत्फ़ का ताज पहनाता है;</para>
  <para style="q" vid="PSA 65:11">और तेरी राहों से रौग़न टपकता है।<verse eid="PSA 65:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 65:12"/>वह बियाबान की चरागाहों पर टपकता है,</para>
  <para style="q" vid="PSA 65:12">और पहाड़ियाँ ख़ुशी से कमरबस्ता हैं।<verse eid="PSA 65:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 65:13"/>चरागाहों में झुंड के झुंड फैले हुए हैं,</para>
  <para style="q" vid="PSA 65:13">वादियाँ अनाज से ढकी हुई हैं,</para>
  <para style="q" vid="PSA 65:13">वह ख़ुशी के मारे ललकारती और गाती हैं।<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 66:1"/>ऐ सारी ज़मीन ख़ुदा के सामने ख़ुशी का ना'रा मार।<verse eid="PSA 66:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2"/>उसके नाम के जलाल का हम्द गाओ;</para>
  <para style="q" vid="PSA 66:2">सिताइश करते हुए उसकी तम्जीद करो।<verse eid="PSA 66:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3"/>ख़ुदा से कहो, “तेरे काम क्या ही बड़े हैं!</para>
  <para style="q" vid="PSA 66:3">तेरी बड़ी क़ुदरत के ज़रिए' तेरे दुश्मन आजिज़ी करेंगे।<verse eid="PSA 66:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4"/>सारी ज़मीन तुझे सिज्दा करेगी,</para>
  <para style="q" vid="PSA 66:4">और तेरे सामने गाएगी; वह तेरे नाम के हम्द गाएँगे।”<verse eid="PSA 66:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5"/>आओ और ख़ुदा के कामों को देखो;</para>
  <para style="q" vid="PSA 66:5">बनी आदम के साथ वह अपने सुलूक में बड़ा है।<verse eid="PSA 66:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6"/>उसने समन्दर को खु़श्क ज़मीन बना दिया:</para>
  <para style="q" vid="PSA 66:6">वह दरिया में से पैदल गुज़र गए।</para>
  <para style="q" vid="PSA 66:6">वहाँ हम ने उसमें ख़ुशी मनाई।<verse eid="PSA 66:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7"/>वह अपनी कु़दरत से हमेशा तक सल्तनत करेगा,</para>
  <para style="q" vid="PSA 66:7">उसकी आँखें क़ौमों को देखती रहती हैं।</para>
  <para style="q" vid="PSA 66:7">सरकश लोग तकब्बुर न करें।<verse eid="PSA 66:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8"/>ऐ लोगो, हमारे ख़ुदा को मुबारक कहो,</para>
  <para style="q" vid="PSA 66:8">और उसकी तारीफ़ में आवाज़ बुलंद करो।<verse eid="PSA 66:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9"/>वही हमारी जान को ज़िन्दा रखता है;</para>
  <para style="q" vid="PSA 66:9">और हमारे पाँव को फिसलने नहीं देता<verse eid="PSA 66:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10"/>क्यूँकि ऐ ख़ुदा, तूने हमें आज़मा लिया है;</para>
  <para style="q" vid="PSA 66:10">तूने हमें ऐसा ताया जैसे चाँदी ताई जाती है।<verse eid="PSA 66:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11"/>तूने हमें जाल में फँसाया,</para>
  <para style="q" vid="PSA 66:11">और हमारी कमर पर भारी बोझ रख्खा।<verse eid="PSA 66:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12"/>तूने सवारों को हमारे सिरों पर से गुज़ारा हम आग में से</para>
  <para style="q" vid="PSA 66:12">और पानी में से होकर गुज़रे;</para>
  <para style="q" vid="PSA 66:12">लेकिन तू हम को अफ़रात की जगह में निकाल लाया।<verse eid="PSA 66:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13"/>मैं सोख़्तनी कु़र्बानियाँ लेकर तेरे घर में दाख़िल हूँगा;</para>
  <para style="q" vid="PSA 66:13">और अपनी मिन्नतें तेरे सामने अदा करूँगा।<verse eid="PSA 66:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14"/>जो मुसीबत के वक़्त मेरे लबों से निकलीं,</para>
  <para style="q" vid="PSA 66:14">और मैंने अपने मुँह से मानें।<verse eid="PSA 66:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15"/>मैं मोटे मोटे जानवरों की सोख़्तनी क़ुर्बानियाँ</para>
  <para style="q" vid="PSA 66:15">मेंढों की खु़शबू के साथ अदा करूँगा।</para>
  <para style="q" vid="PSA 66:15">मैं बैल और बकरे पेश करूँगा।<verse eid="PSA 66:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16"/>ऐ ख़ुदा से डरने वालो, सब आओ, सुनो;</para>
  <para style="q" vid="PSA 66:16">और मैं बताऊँगा कि उसने मेरी जान के लिए क्या क्या किया है।<verse eid="PSA 66:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 66:17"/>मैंने अपने मुँह से उसको पुकारा,</para>
  <para style="q" vid="PSA 66:17">उसकी तम्जीद मेरी ज़बान से हुई।<verse eid="PSA 66:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18"/>अगर मैं बदी को अपने दिल में रखता,</para>
  <para style="q" vid="PSA 66:18">तो ख़ुदावन्द मेरी न सुनता।<verse eid="PSA 66:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19"/>लेकिन ख़ुदा ने यक़ीनन सुन लिया है;</para>
  <para style="q" vid="PSA 66:19">उसने मेरी दुआ की आवाज़ पर कान लगाया है।<verse eid="PSA 66:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20"/>ख़ुदा मुबारक हो,</para>
  <para style="q" vid="PSA 66:20">जिसने न तो मेरी दुआ को रद्द किया,</para>
  <para style="q" vid="PSA 66:20">और न अपनी शफ़क़त को मुझ से बाज़ रख्खा!<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 67:1"/>ख़ुदा हम पर रहम करे और हम को बरक़त बख़्शे;</para>
  <para style="q" vid="PSA 67:1">और अपने चेहरे को हम पर जलवागर फ़रमाए, सिलाह<verse eid="PSA 67:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 67:2"/>ताकि तेरी राह ज़मीन पर ज़ाहिर हो जाए,</para>
  <para style="q" vid="PSA 67:2">और तेरी नजात सब क़ौमों पर।<verse eid="PSA 67:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 67:3"/>ऐ ख़ुदा! लोग तेरी ता'रीफ़ करें;</para>
  <para style="q" vid="PSA 67:3">सब लोग तेरी ता'रीफ़ करें।<verse eid="PSA 67:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 67:4"/>उम्मते ख़ुश हों और ख़ुशी से ललकारें,</para>
  <para style="q" vid="PSA 67:4">क्यूँकि तू रास्ती से लोगों की 'अदालत करेगा,</para>
  <para style="q" vid="PSA 67:4">और ज़मीन की उम्मतों पर हुकूमत करेगा सिलाह<verse eid="PSA 67:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 67:5"/>ऐ ख़ुदा! लोग तेरी ता'रीफ़ करें;</para>
  <para style="q" vid="PSA 67:5">सब लोग तेरी ता'रीफ़ करें।<verse eid="PSA 67:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 67:6"/>ज़मीन ने अपनी पैदावार दे दी,</para>
  <para style="q" vid="PSA 67:6">ख़ुदा या'नी हमारा ख़ुदा हम को बरकत देगा।<verse eid="PSA 67:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 67:7"/>ख़ुदा हम को बरकत देगा;</para>
  <para style="q" vid="PSA 67:7">और ज़मीन की इन्तिहा तक सब लोग उसका डर मानेंगे।<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 68:1"/>ख़ुदा उठे, उसके दुश्मन तितर बितर हों,</para>
  <para style="q" vid="PSA 68:1">उससे 'अदावत रखने वाले उसके सामने से भाग जाएँ।<verse eid="PSA 68:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 68:2"/>जैसे धुवाँ उड़ जाता है, वैसे ही तू उनको उड़ा दे;</para>
  <para style="q" vid="PSA 68:2">जैसे मोम आग के सामने पिघला जाता, वैसे ही शरीर ख़ुदा के सामने फ़ना हो जाएँ।<verse eid="PSA 68:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 68:3"/>लेकिन सादिक़ ख़ुशी मनाएँ, वह ख़ुदा के सामने ख़ुश हों,</para>
  <para style="q" vid="PSA 68:3">बल्कि वह खु़शी से फूले न समाएँ।<verse eid="PSA 68:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 68:4"/>ख़ुदा के लिए गाओ, उसके नाम की मदहसराई करो;</para>
  <para style="q" vid="PSA 68:4">सहरा के सवार के लिए शाहराह तैयार करो;</para>
  <para style="q" vid="PSA 68:4">उसका नाम याह है, और तुम उसके सामने ख़ुश हो।<verse eid="PSA 68:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 68:5"/>ख़ुदा अपने मुक़द्दस मकान में,</para>
  <para style="q" vid="PSA 68:5">यतीमों का बाप और बेवाओं का दादरस है।<verse eid="PSA 68:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 68:6"/>खु़दा तन्हा को ख़ान्दान बख़्शता है;</para>
  <para style="q" vid="PSA 68:6">वह कैदियों को आज़ाद करके इक़बालमंद करता है;</para>
  <para style="q" vid="PSA 68:6">लेकिन सरकश ख़ुश्क ज़मीन में रहते हैं।<verse eid="PSA 68:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 68:7"/>ऐ ख़ुदा, जब तू अपने लोगों के आगे — आगे चला,</para>
  <para style="q" vid="PSA 68:7">जब तू वीरान में से गुज़रा, सिलाह<verse eid="PSA 68:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 68:8"/>तो ज़मीन काँप उठी;</para>
  <para style="q" vid="PSA 68:8">ख़ुदा के सामने आसमान गिर पड़े, बल्कि पाक पहाड़ भी ख़ुदा के सामने,</para>
  <para style="q" vid="PSA 68:8">इस्राईल के ख़ुदा के सामने काँप उठा।<verse eid="PSA 68:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 68:9"/>ऐ ख़ुदा, तूने खू़ब मेंह बरसाया:</para>
  <para style="q" vid="PSA 68:9">तूने अपनी खु़श्क मीरास को ताज़गी बख़्शी।<verse eid="PSA 68:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 68:10"/>तेरे लोग उसमें बसने लगे;</para>
  <para style="q" vid="PSA 68:10">ऐ ख़ुदा, तूने अपने फ़ैज़ से ग़रीबों के लिए उसे तैयार किया।<verse eid="PSA 68:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 68:11"/>ख़ुदावन्द हुक्म देता है;</para>
  <para style="q" vid="PSA 68:11">ख़ुशख़बरी देने वालियाँ फ़ौज की फ़ौज हैं।<verse eid="PSA 68:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 68:12"/>लश्करों के बादशाह भागते हैं, वह भाग जाते हैं;</para>
  <para style="q" vid="PSA 68:12">और 'औरत घर में बैठी बैठी लूट का माल बाँटती है।<verse eid="PSA 68:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 68:13"/>जब तुम भेड़ सालों में पड़े रहते हो,</para>
  <para style="q" vid="PSA 68:13">तो उस कबूतर की तरह होगे जिसके बाज़ू जैसे चाँदी से,</para>
  <para style="q" vid="PSA 68:13">और पर ख़ालिस सोने से मंढ़े हुए हों।<verse eid="PSA 68:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 68:14"/>जब क़ादिर — ए — मुतलक ने बादशाहों को उसमें परागंदा किया,</para>
  <para style="q" vid="PSA 68:14">तो ऐसा हाल हो गया, जैसे सलमोन पर बर्फ़ पड़ रही थी।<verse eid="PSA 68:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 68:15"/>बसन का पहाड़ ख़ुदा का पहाड़ है;</para>
  <para style="q" vid="PSA 68:15">बसन का पहाड़ ऊँचा पहाड़ है।<verse eid="PSA 68:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 68:16"/>ऐ ऊँचे पहाड़ो, तुम उस पहाड़ को क्यूँ ताकते हो,</para>
  <para style="q" vid="PSA 68:16">जिसे ख़ुदा ने अपनी सुकूनत के लिए पसन्द किया है,</para>
  <para style="q" vid="PSA 68:16">बल्कि ख़ुदावन्द उसमें हमेशा तक रहेगा?<verse eid="PSA 68:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 68:17"/>ख़ुदा के रथ बीस हज़ार, बल्कि हज़ारहा हज़ार हैं;</para>
  <para style="q" vid="PSA 68:17">ख़ुदावन्द जैसा पाक पहाड़ में वैसा ही उनके बीच हैकल में है।<verse eid="PSA 68:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 68:18"/>तूने 'आलम — ए — बाला को सु'ऊद फ़रमाया,</para>
  <para style="q" vid="PSA 68:18">तू कैदियों को साथ ले गया;</para>
  <para style="q" vid="PSA 68:18">तुझे लोगों से बल्कि सरकशों से भी हदिए मिले,</para>
  <para style="q" vid="PSA 68:18">ताकि ख़ुदावन्द ख़ुदा उनके साथ रहे।<verse eid="PSA 68:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 68:19"/>ख़ुदावन्द मुबारक हो, जो हर रोज़ हमारा बोझ उठाता है;</para>
  <para style="q" vid="PSA 68:19">वही हमारा नजात देने वाला ख़ुदा है।<verse eid="PSA 68:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 68:20"/>ख़ुदा हमारे लिए छुड़ाने वाला ख़ुदा है</para>
  <para style="q" vid="PSA 68:20">और मौत से बचने की राहें भी ख़ुदावन्द ख़ुदा की हैं।<verse eid="PSA 68:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 68:21"/>लेकिन ख़ुदावन्द अपने दुश्मनों के सिर को,</para>
  <para style="q" vid="PSA 68:21">और लगातार गुनाह करने वाले की बालदार खोपड़ी को चीर डालेगा।<verse eid="PSA 68:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 68:22"/>ख़ुदावन्द ने फ़रमाया, “मैं उनको बसन से निकाल लाऊँगा;</para>
  <para style="q" vid="PSA 68:22">मैं उनको समन्दर की तह से निकाल लाऊँगा।<verse eid="PSA 68:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 68:23"/>ताकि तू अपना पाँव ख़ून से तर करे,</para>
  <para style="q" vid="PSA 68:23">और तेरे दुश्मन तेरे कुत्तों के मुँह का निवाला बनें।”<verse eid="PSA 68:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 68:24"/>ऐ ख़ुदा! लोगों ने तेरी आमद देखी,</para>
  <para style="q" vid="PSA 68:24">मक़दिस में मेरे ख़ुदा, मेरे बादशाह की 'आमद<verse eid="PSA 68:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 68:25"/>गाने वाले आगे आगे और बजाने वाले पीछे पीछे चले,</para>
  <para style="q" vid="PSA 68:25">दफ़ बजाने वाली जवान लड़कियाँ बीच में।<verse eid="PSA 68:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 68:26"/>तुम जो इस्राईल के चश्मे से हो,</para>
  <para style="q" vid="PSA 68:26">ख़ुदावन्द को मुबारक कहो, हाँ,</para>
  <para style="q" vid="PSA 68:26">मजमे' में ख़ुदा को मुबारक कहो।<verse eid="PSA 68:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 68:27"/>वहाँ छोटा बिनयमीन उनका हाकिम है,</para>
  <para style="q" vid="PSA 68:27">यहूदाह के उमरा और उनके मुशीर,</para>
  <para style="q" vid="PSA 68:27">ज़बूलून के उमरा और नफ़्ताली के उमरा हैं।<verse eid="PSA 68:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 68:28"/>तेरे ख़ुदा ने तेरी पायदारी का हुक्म दिया है,</para>
  <para style="q" vid="PSA 68:28">ऐ ख़ुदा, जो कुछ तूने हमारे लिए किया है, उसे पायदारी बख़्श।<verse eid="PSA 68:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 68:29"/>तेरी हैकल की वजह से जो येरूशलेम में है,</para>
  <para style="q" vid="PSA 68:29">बादशाह तेरे पास हदिये लाएँगे।<verse eid="PSA 68:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 68:30"/>तू नेसतान के जंगली जानवरों को धमका दे,</para>
  <para style="q" vid="PSA 68:30">साँडों के ग़ोल को, और क़ौमों के बछड़ों को।</para>
  <para style="q" vid="PSA 68:30">जो चाँदी के सिक्कों को पामाल करते हैं:</para>
  <para style="q" vid="PSA 68:30">उसने जंगजू क़ौमों को परागंदा कर दिया है।<verse eid="PSA 68:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 68:31"/>उमरा मिस्र से आएँगे;</para>
  <para style="q" vid="PSA 68:31">कूश ख़ुदा की तरफ़ अपने हाथ बढ़ाने में जल्दी करेगा।<verse eid="PSA 68:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 68:32"/>ऐ ज़मीन की ममलुकतो, ख़ुदा के लिए गाओ;</para>
  <para style="q" vid="PSA 68:32">ख़ुदावन्द की मदहसराई करो।<verse eid="PSA 68:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 68:33"/>सिलाह उसी की जो क़दीम आसमान नहीं बल्कि आसमानों पर सवार है;</para>
  <para style="q" vid="PSA 68:33">देखो वह अपनी आवाज़ बुलंद करता है, उसकी आवाज़ में कु़दरत है।<verse eid="PSA 68:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 68:34"/>ख़ुदा ही की ताज़ीम करो,</para>
  <para style="q" vid="PSA 68:34">उसकी हश्मत इस्राईल में है,</para>
  <para style="q" vid="PSA 68:34">और उसकी क़ुदरत आसमानों पर।<verse eid="PSA 68:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 68:35"/>ऐ ख़ुदा, तू अपने मक़दिसों में मुहीब है,</para>
  <para style="q" vid="PSA 68:35">इस्राईल का ख़ुदा ही अपने लोगों को ज़ोर और तवानाई बख़्शता है।</para>
  <para style="q" vid="PSA 68:35">खु़दा मुबारक हो।<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 69:1"/>ऐ ख़ुदा मुझ को बचा ले, क्यूँकि पानी मेरी जान तक आ पहुँचा है।<verse eid="PSA 69:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 69:2"/>मैं गहरी दलदल में धंसा जाता हूँ, जहाँ खड़ा नहीं रहा जाता;</para>
  <para style="q" vid="PSA 69:2">मैं गहरे पानी में आ पड़ा हूँ, जहाँ सैलाब मेरे सिर पर से गुज़रता है।<verse eid="PSA 69:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 69:3"/>मैं चिल्लाते चिल्लाते थक गया, मेरा गला सूख गया;</para>
  <para style="q" vid="PSA 69:3">मेरी आँखें अपने ख़ुदा के इन्तिज़ार में पथरा गई।<verse eid="PSA 69:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 69:4"/>मुझ से बे वजह 'अदावत रखने वाले, मेरे सिर के बालों से ज़्यादा हैं;</para>
  <para style="q" vid="PSA 69:4">मेरी हलाकत के चाहने वाले और नाहक़ दुश्मन ज़बरदस्त हैं,</para>
  <para style="q" vid="PSA 69:4">तब जो मैंने छीना नहीं मुझे देना पड़ा।<verse eid="PSA 69:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 69:5"/>ऐ ख़ुदा, तू मेरी बेवक़ूफ़ी से वाक़िफ़ है,</para>
  <para style="q" vid="PSA 69:5">और मेरे गुनाह तुझ से पोशीदा नहीं हैं।<verse eid="PSA 69:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 69:6"/>ऐ ख़ुदावन्द, लश्करों के ख़ुदा, तेरी उम्मीद रखने वाले मेरी वजह से शर्मिन्दा न हों,</para>
  <para style="q" vid="PSA 69:6">ऐ इस्राईल के ख़ुदा, तेरे तालिब मेरी वजह से रुस्वा न हों।<verse eid="PSA 69:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 69:7"/>क्यूँकि तेरे नाम की ख़ातिर मैंने मलामत उठाई है,</para>
  <para style="q" vid="PSA 69:7">शर्मिन्दगी मेरे मुँह पर छा गई है।<verse eid="PSA 69:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 69:8"/>मैं अपने भाइयों के नज़दीक बेगाना बना हूँ,</para>
  <para style="q" vid="PSA 69:8">और अपनी माँ के फ़रज़न्दों के नज़दीक अजनबी।<verse eid="PSA 69:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 69:9"/>क्यूँकि तेरे घर की गै़रत मुझे खा गई,</para>
  <para style="q" vid="PSA 69:9">और तुझ को मलामत करने वालों की मलामतें मुझ पर आ पड़ीं हैं।<verse eid="PSA 69:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 69:10"/>मेरे रोज़ा रखने से मेरी जान ने ज़ारी की,</para>
  <para style="q" vid="PSA 69:10">और यह भी मेरी मलामत का ज़रिए' हुआ।<verse eid="PSA 69:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 69:11"/>जब मैं ने टाट ओढ़ा,</para>
  <para style="q" vid="PSA 69:11">तो उनके लिए ज़र्ब — उल — मसल ठहरा।<verse eid="PSA 69:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 69:12"/>फाटक पर बैठने वालों में मेरा ही ज़िक्र रहता है,</para>
  <para style="q" vid="PSA 69:12">और मैं नशे बाज़ों का हम्द हूँ।<verse eid="PSA 69:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 69:13"/>लेकिन ऐ ख़ुदावन्द, तेरी ख़ुशनूदी के वक़्त मेरी दुआ तुझ ही से है;</para>
  <para style="q" vid="PSA 69:13">ऐ ख़ुदा, अपनी शफ़क़त की फ़िरावानी से,</para>
  <para style="q" vid="PSA 69:13">अपनी नजात की सच्चाई में जवाब दे।<verse eid="PSA 69:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 69:14"/>मुझे दलदल में से निकाल ले और धसने न दे:मुझ से 'अदावत रखने वालों,</para>
  <para style="q" vid="PSA 69:14">और गहरे पानी से मुझे बचा ले।<verse eid="PSA 69:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 69:15"/>मैं सैलाब में डूब न जाऊँ,</para>
  <para style="q" vid="PSA 69:15">और गहराव मुझे निगल न जाए,</para>
  <para style="q" vid="PSA 69:15">और पाताल मुझ पर अपना मुँह बन्द न कर ले<verse eid="PSA 69:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 69:16"/>ऐ ख़ुदावन्द, मुझे जवाब दे, क्यूँकि मेरी शफ़क़त ख़ूब है</para>
  <para style="q" vid="PSA 69:16">अपनी रहमतों की कसरत के मुताबिक़ मेरी तरफ़ मुतवज्जिह हो।<verse eid="PSA 69:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 69:17"/>अपने बन्दे से रूपोशी न कर;</para>
  <para style="q" vid="PSA 69:17">क्यूँकि मैं मुसीबत में हूँ, जल्द मुझे जवाब दे।<verse eid="PSA 69:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 69:18"/>मेरी जान के पास आकर उसे छुड़ा ले</para>
  <para style="q" vid="PSA 69:18">मेरे दुश्मनों के सामने मेरा फ़िदिया दे।<verse eid="PSA 69:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 69:19"/>तू मेरी मलामत और शर्मिन्दगी और रुस्वाई से वाक़िफ़ है;</para>
  <para style="q" vid="PSA 69:19">मेरे दुश्मन सब के सब तेरे सामने हैं।<verse eid="PSA 69:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 69:20"/>मलामत ने मेरा दिल तोड़ दिया, मैं बहुत उदास हूँ</para>
  <para style="q" vid="PSA 69:20">और मैं इसी इन्तिज़ार में रहा कि कोई तरस खाए लेकिन कोई न था;</para>
  <para style="q" vid="PSA 69:20">और तसल्ली देने वालों का मुन्तज़िर रहा लेकिन कोई न मिला।<verse eid="PSA 69:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 69:21"/>उन्होंने मुझे खाने को इन्द्रायन भी दिया,</para>
  <para style="q" vid="PSA 69:21">और मेरी प्यास बुझाने को उन्होंने मुझे सिरका पिलाया।<verse eid="PSA 69:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 69:22"/>उनका दस्तरख़्वान उनके लिए फंदा हो जाए।</para>
  <para style="q" vid="PSA 69:22">और जब वह अमन से हों तो जाल बन जाए।<verse eid="PSA 69:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 69:23"/>उनकी आँखें तारीक हो जाएँ, ताकि वह देख न सके,</para>
  <para style="q" vid="PSA 69:23">और उनकी कमरें हमेशा काँपती रहें।<verse eid="PSA 69:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 69:24"/>अपना ग़ज़ब उन पर उँडेल दे,</para>
  <para style="q" vid="PSA 69:24">और तेरा शदीद क़हर उन पर आ पड़े।<verse eid="PSA 69:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 69:25"/>उनका घर उजड़ जाए,</para>
  <para style="q" vid="PSA 69:25">उनके खे़मों में कोई न बसे।<verse eid="PSA 69:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 69:26"/>क्यूँकि वह उसको जिसे तूने मारा है और जिनको तूने जख़्मी किया है,</para>
  <para style="q" vid="PSA 69:26">उनके दुख का ज़िक्र करते हैं।<verse eid="PSA 69:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 69:27"/>उनके गुनाह पर गुनाह बढ़ा;</para>
  <para style="q" vid="PSA 69:27">और वह तेरी सदाक़त में दाख़िल न हों।<verse eid="PSA 69:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 69:28"/>उनके नाम किताब — ए — हयात से मिटा</para>
  <para style="q" vid="PSA 69:28">और सादिकों के साथ मुन्दर्ज न हों।<verse eid="PSA 69:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 69:29"/>लेकिन मैं तो ग़रीब और ग़मगीन हूँ।</para>
  <para style="q" vid="PSA 69:29">ऐ ख़ुदा तेरी नजात मुझे सर बुलन्द करे।<verse eid="PSA 69:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 69:30"/>मैं हम्द गाकर ख़ुदा के नाम की ता'रीफ़ करूँगा,</para>
  <para style="q" vid="PSA 69:30">और शुक्रगुज़ारी के साथ उसकी तम्जीद करूँगा।<verse eid="PSA 69:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 69:31"/>यह ख़ुदावन्द को बैल से ज़्यादा पसन्द होगा,</para>
  <para style="q" vid="PSA 69:31">बल्कि सींग और खुर वाले बछड़े से ज़्यादा।<verse eid="PSA 69:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 69:32"/>हलीम इसे देख कर ख़ुश हुए हैं;</para>
  <para style="q" vid="PSA 69:32">ऐ ख़ुदा के तालिबो, तुम्हारे दिल ज़िन्दा रहें।<verse eid="PSA 69:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 69:33"/>क्यूँकि ख़ुदावन्द मोहताजों की सुनता है,</para>
  <para style="q" vid="PSA 69:33">और अपने क़ैदियों को हक़ीर नहीं जानता।<verse eid="PSA 69:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 69:34"/>आसमान और ज़मीन उसकी ता'रीफ़ करें,</para>
  <para style="q" vid="PSA 69:34">और समन्दर और जो कुछ उनमें चलता फिरता है।<verse eid="PSA 69:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 69:35"/>क्यूँकि ख़ुदा सिय्यून को बचाएगा,</para>
  <para style="q" vid="PSA 69:35">और यहूदाह के शहरों को बनाएगा;</para>
  <para style="q" vid="PSA 69:35">और वह वहाँ बसेंगे और उसके वारिस होंगे।<verse eid="PSA 69:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 69:36"/>उसके बन्दों की नसल भी उसकी मालिक होगी,</para>
  <para style="q" vid="PSA 69:36">और उसके नाम से मुहब्बत रखने वाले उसमें बसेंगे।<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 70:1"/>ऐ ख़ुदा! मुझे छुड़ाने के लिए, ऐ ख़ुदावन्द, मेरी मदद के लिए कर जल्दी कर!<verse eid="PSA 70:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 70:2"/>जो मेरी जान को हलाक करने के दर पै हैं,</para>
  <para style="q" vid="PSA 70:2">वह सब शर्मिन्दा और रुस्वा हों।</para>
  <para style="q" vid="PSA 70:2">जो मेरे नुक़्सान से ख़ुश हैं,</para>
  <para style="q" vid="PSA 70:2">वह पस्पा और रुस्वा हों।<verse eid="PSA 70:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 70:3"/>अहा! हा! हा!</para>
  <para style="q" vid="PSA 70:3">करने वाले अपनी रुस्वाई के वजह से पस्पा हों।<verse eid="PSA 70:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 70:4"/>तेरे सब तालिब तुझ में ख़ुश — ओ — ख़ुर्रम हों;</para>
  <para style="q" vid="PSA 70:4">तेरी नजात के 'आशिक़ हमेशा कहा करें, “ख़ुदा की तम्जीद हो!”<verse eid="PSA 70:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 70:5"/>लेकिन मैं ग़रीब और मोहताज हूँ; ऐ ख़ुदा,</para>
  <para style="q" vid="PSA 70:5">मेरे पास जल्द आ!</para>
  <para style="q" vid="PSA 70:5">मेरा मददगार और छुड़ाने वाला तू ही है;</para>
  <para style="q" vid="PSA 70:5">ऐ ख़ुदावन्द, देर न कर!<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 71:1"/>ऐ ख़ुदावन्द तू ही मेरी पनाह है;</para>
  <para style="q" vid="PSA 71:1">मुझे कभी शर्मिन्दा न होने दे!<verse eid="PSA 71:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2"/>अपनी सदाक़त में मुझे रिहाई दे और छुड़ा;</para>
  <para style="q" vid="PSA 71:2">मेरी तरफ़ कान लगा, और मुझे बचा ले।<verse eid="PSA 71:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3"/>तू मेरे लिए ठहरने की चट्टान हो, जहाँ मैं बराबर जा सकूँ;</para>
  <para style="q" vid="PSA 71:3">तूने मेरे बचाने का हुक्म दे दिया है,</para>
  <para style="q" vid="PSA 71:3">क्यूँकि मेरी चट्टान और मेरा क़िला' तू ही है।<verse eid="PSA 71:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4"/>ऐ मेरे ख़ुदा, मुझे शरीर के हाथ से,</para>
  <para style="q" vid="PSA 71:4">नारास्त और बेदर्द आदमी के हाथ से छुड़ा।<verse eid="PSA 71:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5"/>क्यूँकि ऐ ख़ुदावन्द ख़ुदा, तू ही मेरी उम्मीद है;</para>
  <para style="q" vid="PSA 71:5">लड़कपन से मेरा भरोसा तुझ ही पर है।<verse eid="PSA 71:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6"/>तू पैदाइश ही से मुझे संभालता आया है</para>
  <para style="q" vid="PSA 71:6">तू मेरी माँ के बतन ही से मेरा शफ़ीक़ रहा है;</para>
  <para style="q" vid="PSA 71:6">इसलिए मैं हमेशा तेरी सिताइश करता रहूँगा।<verse eid="PSA 71:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7"/>मैं बहुतों के लिए हैरत की वजह हूँ।</para>
  <para style="q" vid="PSA 71:7">लेकिन तू मेरी मज़बूत पनाहगाह है।<verse eid="PSA 71:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8"/>मेरा मुँह तेरी सिताइश से,</para>
  <para style="q" vid="PSA 71:8">और तेरी ता'ज़ीम से दिन भर पुर रहेगा।<verse eid="PSA 71:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9"/>बुढ़ापे के वक़्त मुझे न छोड़;</para>
  <para style="q" vid="PSA 71:9">मेरी ज़ईफ़ी में मुझे छोड़ न दे।<verse eid="PSA 71:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10"/>क्यूँकि मेरे दुश्मन मेरे बारे में बातें करते हैं,</para>
  <para style="q" vid="PSA 71:10">और जो मेरी जान की घात में हैं</para>
  <para style="q" vid="PSA 71:10">वह आपस में मशवरा करते हैं,<verse eid="PSA 71:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11"/>और कहते हैं, कि ख़ुदा ने उसे छोड़ दिया है;</para>
  <para style="q" vid="PSA 71:11">उसका पीछा करो और पकड़ लो, क्यूँकि छुड़ाने वाला कोई नहीं।<verse eid="PSA 71:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12"/>ऐ ख़ुदा, मुझ से दूर न रह! ऐ मेरे ख़ुदा,</para>
  <para style="q" vid="PSA 71:12">मेरी मदद के लिए जल्दी कर!<verse eid="PSA 71:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13"/>मेरी जान के मुख़ालिफ़ शर्मिन्दा और फ़ना हो जाएँ;</para>
  <para style="q" vid="PSA 71:13">मेरा नुक़्सान चाहने वाले मलामत</para>
  <para style="q" vid="PSA 71:13">और रुस्वाई से मुलब्बस हो।<verse eid="PSA 71:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14"/>लेकिन मैं हमेशा उम्मीद रख्खूंगा,</para>
  <para style="q" vid="PSA 71:14">और तेरी ता'रीफ़ और भी ज़्यादा किया करूँगा।<verse eid="PSA 71:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15"/>मेरा मुँह तेरी सदाक़त का,</para>
  <para style="q" vid="PSA 71:15">और तेरी नजात का बयान दिन भर करेगा;</para>
  <para style="q" vid="PSA 71:15">क्यूँकि मुझे उनका शुमार मा'लूम नहीं।<verse eid="PSA 71:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16"/>मैं ख़ुदावन्द ख़ुदा की क़ुदरत के कामों का इज़हार करूँगा;</para>
  <para style="q" vid="PSA 71:16">मैं सिर्फ़ तेरी ही सदाक़त का ज़िक्र करूँगा।<verse eid="PSA 71:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17"/>ऐ ख़ुदा, तू मुझे बचपन से सिखाता आया है,</para>
  <para style="q" vid="PSA 71:17">और मैं अब तक तेरे 'अजायब का बयान करता रहा हूँ।<verse eid="PSA 71:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18"/>ऐ ख़ुदा, जब मैं बुड्ढा और सिर सफ़ेद हो जाऊँ</para>
  <para style="q" vid="PSA 71:18">तो मुझे न छोड़ना; जब तक कि मैं तेरी क़ुदरत आइंदा नसल पर,</para>
  <para style="q" vid="PSA 71:18">और तेरा ज़ोर हर आने वाले पर ज़ाहिर न कर दूँ।<verse eid="PSA 71:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19"/>ऐ ख़ुदा, तेरी सदाक़त भी बहुत बलन्द है।</para>
  <para style="q" vid="PSA 71:19">ऐ ख़ुदा, तेरी तरह कौन है जिसने बड़े बड़े काम किए हैं?<verse eid="PSA 71:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20"/>तू जिसने हम को बहुत और सख़्त तकलीफ़ें दिखाई हैं</para>
  <para style="q" vid="PSA 71:20">फिर हम को ज़िन्दा करेगा;</para>
  <para style="q" vid="PSA 71:20">और ज़मीन की तह से हमें फिर ऊपर ले आएगा।<verse eid="PSA 71:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21"/>तू मेरी 'अज़मत को बढ़ा,</para>
  <para style="q" vid="PSA 71:21">और फिर कर मुझे तसल्ली दे।<verse eid="PSA 71:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22"/>ऐ मेरे ख़ुदा, मैं बरबत पर तेरी, हाँ तेरी सच्चाई की हम्द करूँगा;</para>
  <para style="q" vid="PSA 71:22">ऐ इस्राईल के पाक! मैं सितार के साथ तेरी मदहसराई करूँगा।<verse eid="PSA 71:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23"/>जब मैं तेरी मदहसराई करूँगा, तो मेरे होंट बहुत ख़ुश होंगे;</para>
  <para style="q" vid="PSA 71:23">और मेरी जान भी जिसका तूने फ़िदिया दिया है।<verse eid="PSA 71:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24"/>और मेरी ज़बान दिन भर तेरी सदाक़त का ज़िक्र करेगी;</para>
  <para style="q" vid="PSA 71:24">क्यूँकि मेरा नुक़्सान चाहने वाले शर्मिन्दा और पशेमान हुए हैं।<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 72:1"/>ऐ ख़ुदा! बादशाह को अपने अहकाम</para>
  <para style="q" vid="PSA 72:1">और शहज़ादे को अपनी सदाक़त 'अता फ़रमा।<verse eid="PSA 72:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2"/>वह सदाक़त से तेरे लोगों की,</para>
  <para style="q" vid="PSA 72:2">और इन्साफ़ से तेरे ग़रीबों की 'अदालत करेगा।<verse eid="PSA 72:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3"/>इन लोगों के लिए पहाड़ों से सलामती के,</para>
  <para style="q" vid="PSA 72:3">और पहाड़ियों से सदाक़त के फल पैदा होंगे।<verse eid="PSA 72:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4"/>वह इन लोगों के गरीबों की 'अदालत करेगा;</para>
  <para style="q" vid="PSA 72:4">वह मोहताजों की औलाद को बचाएगा,</para>
  <para style="q" vid="PSA 72:4">और ज़ालिम को टुकड़े टुकड़े कर डालेगा।<verse eid="PSA 72:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5"/>जब तक सूरज और चाँद क़ाईम हैं,</para>
  <para style="q" vid="PSA 72:5">लोग नसल — दर — नसल तुझ से डरते रहेंगे।<verse eid="PSA 72:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6"/>वह कटी हुई घास पर मेंह की तरह,</para>
  <para style="q" vid="PSA 72:6">और ज़मीन को सेराब करने वाली बारिश की तरह नाज़िल होगा।<verse eid="PSA 72:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7"/>उसके दिनों में सादिक बढ़ेंगे,</para>
  <para style="q" vid="PSA 72:7">और जब तक चाँद क़ाईम है ख़ूब अमन रहेगा।<verse eid="PSA 72:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8"/>उसकी सल्तनत समन्दर से समन्दर तक</para>
  <para style="q" vid="PSA 72:8">और दरिया — ए — फ़रात से ज़मीन की इन्तिहा तक होगी।<verse eid="PSA 72:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9"/>वीरान के रहने वाले उसके आगे झुकेंगे,</para>
  <para style="q" vid="PSA 72:9">और उसके दुश्मन ख़ाक चाटेंगे।<verse eid="PSA 72:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10"/>तरसीस के और जज़ीरों के बादशाह नज़रें पेश करेंगे,</para>
  <para style="q" vid="PSA 72:10">सबा और सेबा के बादशाह हदिये लाएँगे।<verse eid="PSA 72:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11"/>बल्कि सब बादशाह उसके सामने सर्नगूँ होंगे कुल क़ौमें उसकी फरमाबरदार होंगी।<verse eid="PSA 72:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12"/>क्यूँकि वह मोहताज को जब वह फ़रियाद करे,</para>
  <para style="q" vid="PSA 72:12">और ग़रीब की जिसका कोई मददगार नहीं छुड़ाएगा।<verse eid="PSA 72:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13"/>वह ग़रीब और मुहताज पर तरस खाएगा,</para>
  <para style="q" vid="PSA 72:13">और मोहताजों की जान को बचाएगा।<verse eid="PSA 72:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14"/>वह फ़िदिया देकर उनकी जान को ज़ुल्म और जब्र से छुड़ाएगा</para>
  <para style="q" vid="PSA 72:14">और उनका खू़न उसकी नज़र में बेशक़ीमत होगा।<verse eid="PSA 72:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15"/>वह ज़िन्दा रहेंगे और सबा का सोना उसको दिया जाएगा।</para>
  <para style="q" vid="PSA 72:15">लोग बराबर उसके हक़ में दुआ करेंगे:</para>
  <para style="q" vid="PSA 72:15">वह दिनभर उसे दुआ देंगे।<verse eid="PSA 72:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16"/>ज़मीन में पहाड़ों की चोटियों पर अनाज को अफ़रात होगी;</para>
  <para style="q" vid="PSA 72:16">उनका फल लुबनान के दरख़्तों की तरह झूमेगा;</para>
  <para style="q" vid="PSA 72:16">और शहर वाले ज़मीन की घास की तरह हरे भरे होंगे।<verse eid="PSA 72:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17"/>उसका नाम हमेशा क़ाईम रहेगा,</para>
  <para style="q" vid="PSA 72:17">जब तक सूरज है उसका नाम रहेगा;</para>
  <para style="q" vid="PSA 72:17">और लोग उसके वसीले से बरकत पाएँगे,</para>
  <para style="q" vid="PSA 72:17">सब क़ौमें उसे खु़शनसीब कहेंगी।<verse eid="PSA 72:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18"/>खु़दावन्द ख़ुदा इस्राईल का खु़दा,</para>
  <para style="q" vid="PSA 72:18">मुबारक हो! वही 'अजीब — ओ — ग़रीब काम करता है।<verse eid="PSA 72:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19"/>उसका जलील नाम हमेशा के लिए सारी ज़मीन उसके जलाल से मा'मूर हो।</para>
  <para style="q" vid="PSA 72:19">आमीन सुम्मा आमीन!<verse eid="PSA 72:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 72:20"/>दाऊद बिन यस्सी की दु'आएँ तमाम हुई।<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">तिसरी किताब</para>
  <para style="mr">(<ref loc="PSA 73:-1-89">ज़बूर 73-89</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 73:1"/>बेशक ख़ुदा इस्राईल पर, या'नी पाक दिलों पर मेहरबान है।<verse eid="PSA 73:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2"/>लेकिन मेरे पाँव तो फिसलने को थे,</para>
  <para style="q" vid="PSA 73:2">मेरे क़दम क़रीबन लग़ज़िश खा चुके थे।<verse eid="PSA 73:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3"/>क्यूँकि जब मैं शरीरों की इक़बालमंदी देखता,</para>
  <para style="q" vid="PSA 73:3">तो मग़रूरों पर हसद करता था।<verse eid="PSA 73:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4"/>इसलिए के उनकी मौत में दर्द नहीं,</para>
  <para style="q" vid="PSA 73:4">बल्कि उनकी ताक़त बनी रहती है।<verse eid="PSA 73:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5"/>वह और आदमियों की तरह मुसीबत में नहीं पड़ते;</para>
  <para style="q" vid="PSA 73:5">न और लोगों की तरह उन पर आफ़त आती है।<verse eid="PSA 73:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6"/>इसलिए गु़रूर उनके गले का हार है,</para>
  <para style="q" vid="PSA 73:6">जैसे वह ज़ुल्म से मुलब्बस हैं।<verse eid="PSA 73:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7"/>उनकी आँखें चर्बी से उभरी हुई हैं,</para>
  <para style="q" vid="PSA 73:7">उनके दिल के ख़यालात हद से बढ़ गए हैं।<verse eid="PSA 73:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8"/>वह ठट्ठा मारते, और शरारत से जु़ल्म की बातें करते हैं;</para>
  <para style="q" vid="PSA 73:8">वह बड़ा बोल बोलते हैं।<verse eid="PSA 73:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9"/>उनके मुँह आसमान पर हैं,</para>
  <para style="q" vid="PSA 73:9">और उनकी ज़बाने ज़मीन की सैर करती हैं।<verse eid="PSA 73:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10"/>इसलिए उसके लोग इस तरफ़ रुजू' होते हैं,</para>
  <para style="q" vid="PSA 73:10">और जी भर कर पीते हैं।<verse eid="PSA 73:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 73:11"/>वह कहते हैं, “ख़ुदा को कैसे मा'लूम है?</para>
  <para style="q" vid="PSA 73:11">क्या हक़ ता'ला को कुछ 'इल्म है?”<verse eid="PSA 73:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12"/>इन शरीरों को देखो,</para>
  <para style="q" vid="PSA 73:12">यह हमेशा चैन से रहते हुए दौलत बढ़ाते हैं।<verse eid="PSA 73:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13"/>यक़ीनन मैने बेकार अपने दिल को साफ़,</para>
  <para style="q" vid="PSA 73:13">और अपने हाथों को पाक किया;<verse eid="PSA 73:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14"/>क्यूँकि मुझ पर दिन भर आफ़त रहती है,</para>
  <para style="q" vid="PSA 73:14">और मैं हर सुबह तम्बीह पाता हूँ।<verse eid="PSA 73:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15"/>अगर मैं कहता, कि यूँ कहूँगा;</para>
  <para style="q" vid="PSA 73:15">तो तेरे फ़र्ज़न्दों की नसल से बेवफ़ाई करता।<verse eid="PSA 73:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16"/>जब मैं सोचने लगा कि इसे कैसे समझूँ,</para>
  <para style="q" vid="PSA 73:16">तो यह मेरी नज़र में दुश्वार था,<verse eid="PSA 73:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17"/>जब तक कि मैंने ख़ुदा के मक़दिस में जाकर,</para>
  <para style="q" vid="PSA 73:17">उनके अंजाम को न सोचा।<verse eid="PSA 73:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18"/>यक़ीनन तू उनको फिसलनी जगहों में रखता है,</para>
  <para style="q" vid="PSA 73:18">और हलाकत की तरफ़ ढकेल देता है।<verse eid="PSA 73:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19"/>वह दम भर में कैसे उजड़ गए!</para>
  <para style="q" vid="PSA 73:19">वह हादिसों से बिल्कुल फ़ना हो गए।<verse eid="PSA 73:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20"/>जैसे जाग उठने वाला ख़्वाब को,</para>
  <para style="q" vid="PSA 73:20">वैसे ही तू ऐ ख़ुदावन्द, जाग कर उनकी सूरत को नाचीज़ जानेगा।<verse eid="PSA 73:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21"/>क्यूँकि मेरा दिल रंजीदा हुआ,</para>
  <para style="q" vid="PSA 73:21">और मेरा जिगर छिद गया था;<verse eid="PSA 73:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22"/>मैं बे'अक्ल और जाहिल था,</para>
  <para style="q" vid="PSA 73:22">मैं तेरे सामने जानवर की तरह था।<verse eid="PSA 73:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23"/>तोभी मैं बराबर तेरे साथ हूँ।</para>
  <para style="q" vid="PSA 73:23">तूने मेरा दाहिना हाथ पकड़ रखा है।<verse eid="PSA 73:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24"/>तू अपनी मसलहत से मेरी रहनुमाई करेगा,</para>
  <para style="q" vid="PSA 73:24">और आख़िरकार मुझे जलाल में कु़बूल फ़रमाएगा।<verse eid="PSA 73:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25"/>आसमान पर तेरे अलावा मेरा कौन है?</para>
  <para style="q" vid="PSA 73:25">और ज़मीन पर मैं तेरे अलावा किसी का मुश्ताक़ नहीं।<verse eid="PSA 73:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26"/>जैसे मेरा जिस्म और मेरा दिल ज़ाइल हो जाएँ,</para>
  <para style="q" vid="PSA 73:26">तोभी ख़ुदा हमेशा मेरे दिल की ताक़त और मेरा हिस्सा है।<verse eid="PSA 73:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27"/>क्यूँकि देख, वह जो तुझ से दूर हैं फ़ना हो जाएँगे;</para>
  <para style="q" vid="PSA 73:27">तूने उन सबको जिन्होंने तुझ से बेवफ़ाई की,</para>
  <para style="q" vid="PSA 73:27">हलाक कर दिया है।<verse eid="PSA 73:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28"/>लेकिन मेरे लिए यही भला है कि ख़ुदा की नज़दीकी हासिल करूँ;</para>
  <para style="q" vid="PSA 73:28">मैंने ख़ुदावन्द ख़ुदा को अपनी पनाहगाह बना लिया है</para>
  <para style="q" vid="PSA 73:28">ताकि तेरे सब कामों का बयान करूँ।<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 74:1"/>ऐ ख़ुदा! तूने हम को हमेशा के लिए क्यूँ छोड़ दिया?</para>
  <para style="q" vid="PSA 74:1">तेरी चरागाह की भेड़ों पर तेरा क़हर क्यूँ भड़क रहा है?<verse eid="PSA 74:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2"/>अपनी जमा'अत को जिसे तूने पहले से ख़रीदा है,</para>
  <para style="q" vid="PSA 74:2">जिसका तूने फ़िदिया दिया ताकि तेरी मीरास का क़बीला हो,</para>
  <para style="q" vid="PSA 74:2">और कोह — ए — सिय्यून को जिस पर तूने सुकूनत की है, याद कर।<verse eid="PSA 74:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3"/>अपने क़दम दाइमी खण्डरों की तरफ़ बढ़ा;</para>
  <para style="q" vid="PSA 74:3">या'नी उन सब ख़राबियों की तरफ़ जो दुश्मन ने मक़दिस में की हैं।<verse eid="PSA 74:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4"/>तेरे मजमे' में तेरे मुख़ालिफ़ गरजते रहे हैं;</para>
  <para style="q" vid="PSA 74:4">निशान के लिए उन्होंने अपने ही झंडे खड़े किए हैं।<verse eid="PSA 74:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5"/>वह उन आदमियों की तरह थे,</para>
  <para style="q" vid="PSA 74:5">जो गुनजान दरख़्तों पर कुल्हाड़े चलाते हैं;<verse eid="PSA 74:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6"/>और अब वह उसकी सारी नक़्शकारी को,</para>
  <para style="q" vid="PSA 74:6">कुल्हाड़ी और हथौड़ों से बिल्कुल तोड़े डालते हैं।<verse eid="PSA 74:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7"/>उन्होंने तेरे हैकल में आग लगा दी है,</para>
  <para style="q" vid="PSA 74:7">और तेरे नाम के घर को ज़मीन तक मिस्मार करके नापाक किया है।<verse eid="PSA 74:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8"/>उन्होंने अपने दिल में कहा है, “हम उनको बिल्कुल वीरान कर डालें;”</para>
  <para style="q" vid="PSA 74:8">उन्होंने इस मुल्क में ख़ुदा के सब 'इबादतख़ानों को जला दिया है।<verse eid="PSA 74:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9"/>हमारे निशान नज़र नहीं आते;</para>
  <para style="q" vid="PSA 74:9">और कोई नबी नहीं रहा,</para>
  <para style="q" vid="PSA 74:9">और हम में कोई नहीं जानता कि यह हाल कब तक रहेगा।<verse eid="PSA 74:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10"/>ऐ ख़ुदा, मुख़ालिफ़ कब तक ता'नाज़नी करता रहेगा?</para>
  <para style="q" vid="PSA 74:10">क्या दुश्मन हमेशा तेरे नाम पर कुफ़्र बकता रहेगा?<verse eid="PSA 74:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11"/>तू अपना हाथ क्यूँ रोकता है?</para>
  <para style="q" vid="PSA 74:11">अपना दहना हाथ बाल से निकाल और फ़ना कर।<verse eid="PSA 74:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12"/>ख़ुदा क़दीम से मेरा बादशाह है,</para>
  <para style="q" vid="PSA 74:12">जो ज़मीन पर नजात बख़्शता है।<verse eid="PSA 74:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 74:13"/>तूने अपनी क़ुदरत से समन्दर के दो हिस्से कर दिए</para>
  <para style="q" vid="PSA 74:13">तू पानी में अज़दहाओं के सिर कुचलता है।<verse eid="PSA 74:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 74:14"/>तूने लिवियातान के सिर के टुकड़े किए,</para>
  <para style="q" vid="PSA 74:14">और उसे वीरान के रहने वालों की खू़राक बनाया।<verse eid="PSA 74:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 74:15"/>तूने चश्मे और सैलाब जारी किए;</para>
  <para style="q" vid="PSA 74:15">तूने बड़े बड़े दरियाओं को ख़ुश्क कर डाला।<verse eid="PSA 74:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16"/>दिन तेरा है, रात भी तेरी ही है;</para>
  <para style="q" vid="PSA 74:16">नूर और आफ़ताब को तू ही ने तैयार किया।<verse eid="PSA 74:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17"/>ज़मीन की तमाम हदें तू ही ने ठहराई हैं;</para>
  <para style="q" vid="PSA 74:17">गर्मी और सर्दी के मौसम तू ही ने बनाए।<verse eid="PSA 74:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18"/>ऐ ख़ुदावन्द, इसे याद रख के दुश्मन ने ता'नाज़नी की है,</para>
  <para style="q" vid="PSA 74:18">और बेवकूफ़ क़ौम ने तेरे नाम की तक्फ़ीर की है।<verse eid="PSA 74:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19"/>अपनी फ़ाख़्ता की जान की जंगली जानवर के हवाले न कर;</para>
  <para style="q" vid="PSA 74:19">अपने ग़रीबों की जान को हमेशा के लिए भूल न जा।<verse eid="PSA 74:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20"/>अपने 'अहद का ख़याल फ़रमा,</para>
  <para style="q" vid="PSA 74:20">क्यूँकि ज़मीन के तारीक मक़ाम जु़ल्म के घरों से भरे हैं।<verse eid="PSA 74:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21"/>मज़लूम शर्मिन्दा होकर न लौटे;</para>
  <para style="q" vid="PSA 74:21">ग़रीब और मोहताज तेरे नाम की ता'रीफ़ करें।<verse eid="PSA 74:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22"/>उठ ऐ ख़ुदा, आप ही अपनी वकालत कर;</para>
  <para style="q" vid="PSA 74:22">याद कर कि अहमक़ दिन भर तुझ पर कैसी ता'नाज़नी करता है।<verse eid="PSA 74:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23"/>अपने दुश्मनों की आवाज़ को भूल न</para>
  <para style="q" vid="PSA 74:23">मुख़ालिफ़ों का हंगामा खड़ा होता रहता।<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 75:1"/>ऐ ख़ुदा, हम तेरा शुक्र करते हैं, हम तेरा शुक्र करते हैं;</para>
  <para style="q" vid="PSA 75:1">क्यूँकि तेरा नाम नज़दीक है, लोग तेरे 'अजीब कामों का ज़िक्र करते हैं।<verse eid="PSA 75:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 75:2"/>जब मेरा मु'अय्यन वक़्त आएगा,</para>
  <para style="q" vid="PSA 75:2">तो मैं रास्ती से 'अदालत करूँगा।<verse eid="PSA 75:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 75:3"/>ज़मीन और उसके सब बाशिन्दे गुदाज़ हो गए हैं,</para>
  <para style="q" vid="PSA 75:3">मैंने उसके सुतूनों को क़ाईम कर दिया।<verse eid="PSA 75:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 75:4"/>मैंने मग़रूरों से कहा, गु़रूर न करो,</para>
  <para style="q" vid="PSA 75:4">और शरीरों से, कि सींग ऊँचा न करो।<verse eid="PSA 75:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 75:5"/>अपना सींग ऊँचा न करो,</para>
  <para style="q" vid="PSA 75:5">बग़ावत से बात न करो।<verse eid="PSA 75:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 75:6"/>क्यूँकि सरफ़राज़ी न तो पूरब से न पश्चिम से,</para>
  <para style="q" vid="PSA 75:6">और न दख्खिन से आती है;<verse eid="PSA 75:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 75:7"/>बल्कि ख़ुदा ही 'अदालत करने वाला है;</para>
  <para style="q" vid="PSA 75:7">वह किसी को पस्त करता है और किसी को सरफ़राज़ी बख़्शता है।<verse eid="PSA 75:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 75:8"/>क्यूँकि ख़ुदावन्द के हाथ में प्याला है, और मय झाग वाली है;</para>
  <para style="q" vid="PSA 75:8">वह मिली हुई शराब से भरा है, और ख़ुदावन्द उसी में से उंडेलता है;</para>
  <para style="q" vid="PSA 75:8">बेशक उसकी तलछट ज़मीन के सब शरीर निचोड़ निचोड़ कर पिएँगे।<verse eid="PSA 75:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 75:9"/>लेकिन मैं तो हमेशा ज़िक्र करता रहूँगा,</para>
  <para style="q" vid="PSA 75:9">मैं या'क़ूब के ख़ुदा की मदहसराई करूँगा।<verse eid="PSA 75:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 75:10"/>और मैं शरीरों के सब सींग काट डालूँगा</para>
  <para style="q" vid="PSA 75:10">लेकिन सादिकों के सींग ऊँचे किए जाएंगे।<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 76:1"/>ख़ुदा यहूदाह में मशहूर है,</para>
  <para style="q" vid="PSA 76:1">उसका नाम इस्राईल में बुजु़र्ग है।<verse eid="PSA 76:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 76:2"/>सालिम में उसका खे़मा है,</para>
  <para style="q" vid="PSA 76:2">और सिय्यून में उसका घर।<verse eid="PSA 76:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 76:3"/>वहाँ उसने बर्क़ — ए — कमान की और ढाल और तलवार,</para>
  <para style="q" vid="PSA 76:3">और सामान — ए — जंग को तोड़ डाला।<verse eid="PSA 76:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 76:4"/>तू जलाली है, और शिकार के पहाड़ों से शानदार है।<verse eid="PSA 76:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 76:5"/>मज़बूत दिल लुट गए, वह गहरी नींद में पड़े हैं,</para>
  <para style="q" vid="PSA 76:5">और ज़बरदस्त लोगों में से किसी का हाथ काम न आया।<verse eid="PSA 76:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 76:6"/>ऐ या'क़ूब के ख़ुदा, तेरी झिड़की से,</para>
  <para style="q" vid="PSA 76:6">रथ और घोड़े दोनों पर मौत की नींद तारी है।<verse eid="PSA 76:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 76:7"/>सिर्फ़ तुझ ही से डरना चाहिए;</para>
  <para style="q" vid="PSA 76:7">और तेरे क़हर के वक़्त कौन तेरे सामने खड़ा रह सकता है?<verse eid="PSA 76:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 76:8"/>तूने आसमान पर से फ़ैसला सुनाया;</para>
  <para style="q" vid="PSA 76:8">ज़मीन डर कर चुप हो गई।<verse eid="PSA 76:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 76:9"/>जब ख़ुदा 'अदालत करने को उठा,</para>
  <para style="q" vid="PSA 76:9">ताकि ज़मीन के सब हलीमों को बचा ले। सिलाह<verse eid="PSA 76:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 76:10"/>बेशक इंसान का ग़ज़ब तेरी सिताइश का ज़रिए' होगा,</para>
  <para style="q" vid="PSA 76:10">और तू ग़ज़ब के बक़िये से कमरबस्ता होगा।<verse eid="PSA 76:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 76:11"/>ख़ुदावन्द अपने ख़ुदा के लिए मन्नत मानो, और पूरी करो,</para>
  <para style="q" vid="PSA 76:11">और सब जो उसके गिर्द हैं वह उसी के लिए जिससे डरना वाजिब है, हदिए लाएँ।<verse eid="PSA 76:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 76:12"/>वह हाकिम की रूह को क़ब्ज़ करेगा;</para>
  <para style="q" vid="PSA 76:12">वह ज़मीन के बादशाहों के लिए बड़ा है।<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 77:1"/>मैं बुलन्द आवाज़ से ख़ुदा के सामने फ़रियाद करूँगा ख़ुदा ही के सामने बुलन्द आवाज़ से,</para>
  <para style="q" vid="PSA 77:1">और वह मेरी तरफ़ कान लगाएगा।<verse eid="PSA 77:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 77:2"/>अपनी मुसीबत के दिन मैंने ख़ुदावन्द को ढूँढा,</para>
  <para style="q" vid="PSA 77:2">मेरे हाथ रात को फैले रहे और ढीले न हुए;</para>
  <para style="q" vid="PSA 77:2">मेरी जान को तस्कीन न हुई।<verse eid="PSA 77:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 77:3"/>मैं ख़ुदा को याद करता हूँ</para>
  <para style="q" vid="PSA 77:3">और बेचैन हूँ मैं वावैला करता हूँ और मेरी जान निढाल है।<verse eid="PSA 77:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 77:4"/>तू मेरी आँखें खुली रखता है;</para>
  <para style="q" vid="PSA 77:4">मैं ऐसा बेताब हूँ कि बोल नहीं सकता।<verse eid="PSA 77:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 77:5"/>मैं गुज़रे दिनों पर,</para>
  <para style="q" vid="PSA 77:5">या'नी क़दीम ज़माने के बरसों पर सोचता रहा।<verse eid="PSA 77:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 77:6"/>मुझे रात को अपना हम्द याद आता है;</para>
  <para style="q" vid="PSA 77:6">मैं अपने दिल ही में सोचता हूँ।</para>
  <para style="q" vid="PSA 77:6">मेरी रूह बड़ी तफ़्तीश में लगी है:<verse eid="PSA 77:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 77:7"/>“क्या ख़ुदावन्द हमेशा के लिए छोड़ देगा?</para>
  <para style="q" vid="PSA 77:7">क्या वह फिर कभी मेंहरबान न होगा?<verse eid="PSA 77:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 77:8"/>क्या उसकी शफ़क़त हमेशा के लिए जाती रही?</para>
  <para style="q" vid="PSA 77:8">क्या उसका वा'दा हमेशा तक बातिल हो गया?<verse eid="PSA 77:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 77:9"/>क्या ख़ुदा करम करना भूल गया?</para>
  <para style="q" vid="PSA 77:9">क्या उसने क़हर से अपनी रहमत रोक ली?” सिलाह<verse eid="PSA 77:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 77:10"/>फिर मैंने कहा, “यह मेरी ही कमज़ोरी है;</para>
  <para style="q" vid="PSA 77:10">मैं तो हक़ ता'ला की कुदरत के ज़माने को याद करूँगा।”<verse eid="PSA 77:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 77:11"/>मैं ख़ुदावन्द के कामों का ज़िक्र करूँगा;</para>
  <para style="q" vid="PSA 77:11">क्यूँकि मुझे तेरे क़दीम 'अजाईब यादआएँगे।<verse eid="PSA 77:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 77:12"/>मैं तेरी सारी सन'अत पर ध्यान करूँगा,</para>
  <para style="q" vid="PSA 77:12">और तेरे कामों को सोचूँगा।<verse eid="PSA 77:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 77:13"/>ऐ ख़ुदा, तेरी राह मक़दिस में है।</para>
  <para style="q" vid="PSA 77:13">कौन सा देवता ख़ुदा की तरह बड़ा है।<verse eid="PSA 77:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 77:14"/>तू वह ख़ुदा है जो 'अजीब काम करता है,</para>
  <para style="q" vid="PSA 77:14">तूने क़ौमों के बीच अपनी क़ुदरत ज़ाहिर की।<verse eid="PSA 77:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 77:15"/>तूने अपने ही बाज़ू से अपनी क़ौम,</para>
  <para style="q" vid="PSA 77:15">बनी या'क़ूब और बनी यूसुफ़ को फ़िदिया देकर छुड़ाया है।<verse eid="PSA 77:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 77:16"/>ऐ ख़ुदा, समन्दरों ने तुझे देखा,</para>
  <para style="q" vid="PSA 77:16">समन्दर तुझे देख कर डर गए,</para>
  <para style="q" vid="PSA 77:16">गहराओ भी काँप उठे।<verse eid="PSA 77:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 77:17"/>बदलियों ने पानी बरसाया,</para>
  <para style="q" vid="PSA 77:17">आसमानों से आवाज़ आई,</para>
  <para style="q" vid="PSA 77:17">तेरे तीर भी चारों तरफ़ चले।<verse eid="PSA 77:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 77:18"/>बगोले में तेरे गरज़ की आवाज़ थी,</para>
  <para style="q" vid="PSA 77:18">बर्क़ ने जहान को रोशन कर दिया,</para>
  <para style="q" vid="PSA 77:18">ज़मीन लरज़ी और काँपी।<verse eid="PSA 77:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 77:19"/>तेरी राह समन्दर में है,</para>
  <para style="q" vid="PSA 77:19">तेरे रास्ते बड़े समुन्दरों में हैं;</para>
  <para style="q" vid="PSA 77:19">और तेरे नक़्श — ए — क़दम ना मा'लूम हैं।<verse eid="PSA 77:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 77:20"/>तूने मूसा और हारून के वसीले से,</para>
  <para style="q" vid="PSA 77:20">क़ि'ला की तरह अपने लोगों की रहनुमाई की।<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 78:1"/>ऐ मेरे लोगों मेरी शरी'अत को सुनो</para>
  <para style="q" vid="PSA 78:1">मेरे मुँह की बातों पर कान लगाओ।<verse eid="PSA 78:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2"/>मैं तम्सील में कलाम करूँगा,</para>
  <para style="q" vid="PSA 78:2">और पुराने पोशीदा राज़ कहूँगा,<verse eid="PSA 78:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3"/>जिनको हम ने सुना और जान लिया,</para>
  <para style="q" vid="PSA 78:3">और हमारे बाप — दादा ने हम को बताया।<verse eid="PSA 78:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4"/>और जिनको हम उनकी औलाद से पोशीदा नहीं रख्खेंगे;</para>
  <para style="q" vid="PSA 78:4">बल्कि आइंदा नसल को भी ख़ुदावन्द की ता'रीफ़,</para>
  <para style="q" vid="PSA 78:4">और उसकी कु़दरत और 'अजाईब जो उसने किए बताएँगे।<verse eid="PSA 78:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5"/>क्यूँकि उसने या'कू़ब में एक शहादत क़ाईम की,</para>
  <para style="q" vid="PSA 78:5">और इस्राईल में शरी'अत मुक़र्रर की,</para>
  <para style="q" vid="PSA 78:5">जिनके बारे में उसने हमारे बाप दादा को हुक्म दिया,</para>
  <para style="q" vid="PSA 78:5">कि वह अपनी औलाद को उनकी ता'लीम दें,<verse eid="PSA 78:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6"/>ताकि आइंदा नसल, या'नी वह फ़र्ज़न्द जो पैदा होंगे,</para>
  <para style="q" vid="PSA 78:6">उनको जान लें:और वह बड़े होकर अपनी औलाद को सिखाएँ,<verse eid="PSA 78:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7"/>कि वह ख़ुदा पर उम्मीद रखें, और उसके कामों को भूल न जाएँ,</para>
  <para style="q" vid="PSA 78:7">बल्कि उसके हुक्मों पर 'अमल करें;<verse eid="PSA 78:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8"/>और अपने बाप — दादा की तरह,</para>
  <para style="q" vid="PSA 78:8">सरकश और बाग़ी नसल न बनें:ऐसी नसल जिसने अपना दिल दुरुस्त न किया</para>
  <para style="q" vid="PSA 78:8">और जिसकी रूह ख़ुदा के सामने वफ़ादार न रही।<verse eid="PSA 78:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9"/>बनी इफ़्राईम हथियार बन्द होकर</para>
  <para style="q" vid="PSA 78:9">और कमाने रखते हुए लड़ाई के दिन फिर गए।<verse eid="PSA 78:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10"/>उन्होंने ख़ुदा के 'अहद को क़ाईम न रख्खा,</para>
  <para style="q" vid="PSA 78:10">और उसकी शरी'अत पर चलने से इन्कार किया।<verse eid="PSA 78:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11"/>और उसके कामों को और उसके'अजायब को,</para>
  <para style="q" vid="PSA 78:11">जो उसने उनको दिखाए थे भूल गए।<verse eid="PSA 78:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12"/>उसने मुल्क — ए — मिस्र में जुअन के इलाके में,</para>
  <para style="q" vid="PSA 78:12">उनके बाप — दादा के सामने 'अजीब — ओ — ग़रीब काम किए।<verse eid="PSA 78:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13"/>उसने समुन्दर के दो हिस्से करके उनको पार उतारा,</para>
  <para style="q" vid="PSA 78:13">और पानी को तूदे की तरह खड़ा कर दिया।<verse eid="PSA 78:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14"/>उसने दिन को बादल से उनकी रहबरी की,</para>
  <para style="q" vid="PSA 78:14">और रात भर आग की रोशनी से।<verse eid="PSA 78:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15"/>उसने वीरान में चट्टानों को चीरा,</para>
  <para style="q" vid="PSA 78:15">और उनको जैसे बहर से खू़ब पिलाया।<verse eid="PSA 78:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16"/>उसने चट्टान में से नदियाँ जारी कीं,</para>
  <para style="q" vid="PSA 78:16">और दरियाओं की तरह पानी बहाया।<verse eid="PSA 78:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17"/>तोभी वह उसके ख़िलाफ़ गुनाह करते ही गए,</para>
  <para style="q" vid="PSA 78:17">और वीरान में हक़ता'ला से सरकशी करते रहे।<verse eid="PSA 78:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18"/>और उन्होंने अपनी ख़्वाहिश के मुताबिक़ खाना मांग कर अपने दिल में ख़ुदा को आज़माया।<verse eid="PSA 78:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19"/>बल्कि वह ख़ुदा के खि़लाफ़ बकने लगे, और कहा,</para>
  <para style="q" vid="PSA 78:19">“क्या ख़ुदा वीरान में दस्तरख़्वान बिछा सकता है?<verse eid="PSA 78:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20"/>देखो, उसने चट्टान को मारा तो पानी फूट निकला,</para>
  <para style="q" vid="PSA 78:20">और नदियाँ बहने लगीं क्या वह रोटी भी दे सकता है?</para>
  <para style="q" vid="PSA 78:20">क्या वह अपने लोगों के लिए गोश्त मुहय्या कर देगा?”<verse eid="PSA 78:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21"/>तब ख़ुदावन्द सुन कर गज़बनाक हुआ,</para>
  <para style="q" vid="PSA 78:21">और या'कू़ब के ख़िलाफ़ आग भड़क उठी,</para>
  <para style="q" vid="PSA 78:21">और इस्राईल पर क़हर टूट पड़ा;<verse eid="PSA 78:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22"/>इसलिए कि वह ख़ुदा पर ईमान न लाए,</para>
  <para style="q" vid="PSA 78:22">और उसकी नजात पर भरोसा न किया।<verse eid="PSA 78:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23"/>तोभी उसने आसमानों को हुक्म दिया,</para>
  <para style="q" vid="PSA 78:23">और आसमान के दरवाज़े खोले:<verse eid="PSA 78:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24"/>और खाने के लिए उन पर मन्न बरसाया,</para>
  <para style="q" vid="PSA 78:24">और उनको आसमानी खू़राक बख़्शी।<verse eid="PSA 78:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25"/>इंसान ने फ़रिश्तों की गिज़ा खाई:</para>
  <para style="q" vid="PSA 78:25">उसने खाना भेजकर उनको आसूदा किया।<verse eid="PSA 78:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26"/>उसने आसमान में पुर्वा चलाई,</para>
  <para style="q" vid="PSA 78:26">और अपनी कु़दरत से दखना बहाई।<verse eid="PSA 78:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27"/>उसने उन पर गोश्त को ख़ाक की तरह बरसाया,</para>
  <para style="q" vid="PSA 78:27">और परिन्दों को समन्दर की रेत की तरह;<verse eid="PSA 78:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28"/>जिनको उसने उनकी खे़मागाह में,</para>
  <para style="q" vid="PSA 78:28">उनके घरों के आसपास गिराया।<verse eid="PSA 78:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29"/>तब वह खाकर खू़ब सेर हुए,</para>
  <para style="q" vid="PSA 78:29">और उसने उनकी ख़्वाहिश पूरी की।<verse eid="PSA 78:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30"/>वह अपनी ख्वाहिश से बाज़ न आए,</para>
  <para style="q" vid="PSA 78:30">और उनका खाना उनके मुँह ही में था।<verse eid="PSA 78:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 78:31"/>कि ख़ुदा का ग़ज़ब उन पर टूट पड़ा,</para>
  <para style="q" vid="PSA 78:31">और उनके सबसे मोटे ताज़े आदमी क़त्ल किए,</para>
  <para style="q" vid="PSA 78:31">और इस्राईली जवानों को मार गिराया।<verse eid="PSA 78:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32"/>बावुजूद इन सब बातों कि वह गुनाह करते ही रहे;</para>
  <para style="q" vid="PSA 78:32">और उसके 'अजीब — ओ — ग़रीब कामों पर ईमान न लाए।<verse eid="PSA 78:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33"/>इसलिए उसने उनके दिनों को बतालत से,</para>
  <para style="q" vid="PSA 78:33">और उनके बरसों को दहशत से तमाम कर दिया।<verse eid="PSA 78:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34"/>जब वह उनको कत्ल करने लगा, तो वह उसके तालिब हुए;</para>
  <para style="q" vid="PSA 78:34">और रुजू होकर दिल — ओ — जान से ख़ुदा को ढूंडने लगे।<verse eid="PSA 78:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35"/>और उनको याद आया कि ख़ुदा उनकी चट्टान,</para>
  <para style="q" vid="PSA 78:35">और ख़ुदा ता'ला उनका फ़िदिया देने वाला है।<verse eid="PSA 78:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36"/>लेकिन उन्होंने अपने मुँह से उसकी ख़ुशामद की,</para>
  <para style="q" vid="PSA 78:36">और अपनी ज़बान से उससे झूट बोला।<verse eid="PSA 78:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37"/>क्यूँकि उनका दिल उसके सामने दुरुस्त</para>
  <para style="q" vid="PSA 78:37">और वह उसके 'अहद में वफ़ादार न निकले।<verse eid="PSA 78:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 78:38"/>लेकिन वह रहीम होकर बदकारी मु'आफ़ करता है, और हलाक नहीं करता;</para>
  <para style="q" vid="PSA 78:38">बल्कि बारहा अपने क़हर को रोक लेता है,</para>
  <para style="q" vid="PSA 78:38">और अपने पूरे ग़ज़ब को भड़कने नहीं देता।<verse eid="PSA 78:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39"/>और उसे याद रहता है कि यह महज़ बशर है।</para>
  <para style="q" vid="PSA 78:39">या'नी हवा जो चली जाती है और फिर नहीं आती।<verse eid="PSA 78:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40"/>कितनी बार उन्होंने वीरान में उससे सरकशी की</para>
  <para style="q" vid="PSA 78:40">और सेहरा में उसे दुख किया।<verse eid="PSA 78:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41"/>और वह फिर ख़ुदा को आज़माने लगे</para>
  <para style="q" vid="PSA 78:41">और उन्होंने इस्राईल के ख़ुदा को नाराज़ किया।<verse eid="PSA 78:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42"/>उन्होंने उसके हाथ को याद न रखा,</para>
  <para style="q" vid="PSA 78:42">न उस दिन की जब उसने फ़िदिया देकर उनको मुख़ालिफ़ से रिहाई बख़्शी।<verse eid="PSA 78:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43"/>उसने मिस्र में अपने निशान दिखाए,</para>
  <para style="q" vid="PSA 78:43">और जुअन के 'इलाके में अपने अजायब।<verse eid="PSA 78:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44"/>और उनके दरियाओं को खू़न बना दिया</para>
  <para style="q" vid="PSA 78:44">और वह अपनी नदियों से पी न सके।<verse eid="PSA 78:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45"/>उसने उन पर मच्छरों के ग़ोल भेजे जो उनको खा गए</para>
  <para style="q" vid="PSA 78:45">और मेंढ़क जिन्होंने उनको तबाह कर दिया।<verse eid="PSA 78:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46"/>उसने उनकी पैदावार कीड़ों को</para>
  <para style="q" vid="PSA 78:46">और उनकी मेहनत का फल टिड्डियों को दे दिया।<verse eid="PSA 78:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47"/>उसने उनकी ताकों को ओलों से</para>
  <para style="q" vid="PSA 78:47">और उनके गूलर के दरख़्तों को पाले से मारा।<verse eid="PSA 78:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48"/>उसने उनके चौपायों को ओलों के हवाले किया,</para>
  <para style="q" vid="PSA 78:48">और उनकी भेड़ बकरियों को बिजली के।<verse eid="PSA 78:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49"/>उसने 'ऐज़ाब के फ़रिश्तों की फ़ौज भेज कर अपनी क़हर की शिद्दत ग़ैज़ — ओ — ग़जब और बला को उन पर नाज़िल किया।<verse eid="PSA 78:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50"/>उसने अपने क़हर के लिए रास्ता बनाया,</para>
  <para style="q" vid="PSA 78:50">और उनकी जान मौत से न बचाई,</para>
  <para style="q" vid="PSA 78:50">बल्कि उनकी ज़िन्दगी वबा के हवाले की।<verse eid="PSA 78:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51"/>उसने मिस्र के सब पहलौठों को,</para>
  <para style="q" vid="PSA 78:51">या'नी हाम के घरों में उनकी ताक़त के पहले फल को मारा:<verse eid="PSA 78:51"/></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52"/>लेकिन वह अपने लोगों को भेड़ों की तरह ले चला,</para>
  <para style="q" vid="PSA 78:52">और वीरान में ग़ल्ले की तरह उनकी रहनुमाई की।<verse eid="PSA 78:52"/></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53"/>और वह उनको सलामत ले गया और वह न डरे,</para>
  <para style="q" vid="PSA 78:53">लेकिन उनके दुश्मनों को समन्दर ने छिपा लिया।<verse eid="PSA 78:53"/></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54"/>और वह उनको अपने मक़दिस की सरहद तक लाया,</para>
  <para style="q" vid="PSA 78:54">या'नी उस पहाड़ तक जिसे उसके दहने हाथ ने हासिल किया था।<verse eid="PSA 78:54"/></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55"/>उसने और क़ौमों को उनके सामने से निकाल दिया;</para>
  <para style="q" vid="PSA 78:55">जिनकी मीरास जरीब डाल कर उनको बाँट दी;</para>
  <para style="q" vid="PSA 78:55">और जिनके खे़मों में इस्राईल के क़बीलों को बसाया।<verse eid="PSA 78:55"/></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56"/>तोभी उन्होंने ख़ुदाता'ला को आज़मायाऔर उससे सरकशी की,</para>
  <para style="q" vid="PSA 78:56">और उसकी शहादतों को न माना;<verse eid="PSA 78:56"/></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57"/>बल्कि नाफ़रमान होकर अपने बाप दादा की तरह बेवफ़ाई की</para>
  <para style="q" vid="PSA 78:57">और धोका देने वाली कमान की तरह एक तरफ़ को झुक गए।<verse eid="PSA 78:57"/></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58"/>क्यूँकि उन्होंने अपने ऊँचे मक़ामों के वजह से उसका क़हर भड़काया,</para>
  <para style="q" vid="PSA 78:58">और अपनी खोदी हुई मूरतों से उसे गै़रत दिलाई।<verse eid="PSA 78:58"/></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59"/>ख़ुदा यह सुनकर गज़बनाक हुआ,</para>
  <para style="q" vid="PSA 78:59">और इस्राईल से सख़्त नफ़रत की।<verse eid="PSA 78:59"/></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60"/>फिर उसने शीलोह के घर को छोड़ दिया,</para>
  <para style="q" vid="PSA 78:60">या'नी उस खे़मे को जो बनी आदम के बीच खड़ा किया था।<verse eid="PSA 78:60"/></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61"/>और उसने अपनी ताक़त को ग़ुलामी में,</para>
  <para style="q" vid="PSA 78:61">और अपनी हश्मत को मुख़ालिफ़ के हाथ में दे दिया।<verse eid="PSA 78:61"/></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62"/>उसने अपने लोगों को तलवार के हवाले कर दिया,</para>
  <para style="q" vid="PSA 78:62">और वह अपनी मीरास से ग़ज़बनाक हो गया।<verse eid="PSA 78:62"/></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63"/>आग उनके जवानों को खा गई,</para>
  <para style="q" vid="PSA 78:63">और उनकी कुँवारियों के सुहाग न गाए गए।<verse eid="PSA 78:63"/></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64"/>उनके काहिन तलवार से मारे गए,</para>
  <para style="q" vid="PSA 78:64">और उनकी बेवाओं ने नौहा न किया।<verse eid="PSA 78:64"/></para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65"/>तब ख़ुदावन्द जैसे नींद से जाग उठा,</para>
  <para style="q" vid="PSA 78:65">उस ज़बरदस्त आदमी की तरह जो मय की वजह से ललकारता हो।<verse eid="PSA 78:65"/></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66"/>और उसने अपने मुख़ालिफ़ों को मार कर पस्पा कर दिया;</para>
  <para style="q" vid="PSA 78:66">उसने उनको हमेशा के लिए रुस्वा किया।<verse eid="PSA 78:66"/></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67"/>और उसने यूसुफ़ के ख़मे को छोड़ दिया;</para>
  <para style="q" vid="PSA 78:67">और इफ़्राईम के क़बीले को न चुना;<verse eid="PSA 78:67"/></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68"/>बल्कि यहूदाह के क़बीले को चुना!</para>
  <para style="q" vid="PSA 78:68">उसी कोह — ए — सिय्यून को जिससे उसको मुहब्बत थी।<verse eid="PSA 78:68"/></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69"/>और अपने मक़दिस को पहाड़ों की तरह तामीर किया,</para>
  <para style="q" vid="PSA 78:69">और ज़मीन की तरह जिसे उसने हमेशा के लिए क़ाईम किया है।<verse eid="PSA 78:69"/></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70"/>उसने अपने बन्दे दाऊद को भी चुना,</para>
  <para style="q" vid="PSA 78:70">और भेड़सालों में से उसे ले लिया;<verse eid="PSA 78:70"/></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71"/>वह उसे बच्चे वाली भेड़ों की चौपानी से हटा लाया,</para>
  <para style="q" vid="PSA 78:71">ताकि उसकी क़ौम या'कू़ब और उसकी मीरास इस्राईल की ग़ल्लेबानी करे।<verse eid="PSA 78:71"/></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72"/>फिर उसने ख़ुलूस — ए — दिल से उनकी पासबानी की</para>
  <para style="q" vid="PSA 78:72">और अपने माहिर हाथों से उनकी रहनुमाई करता रहा।<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 79:1"/>ऐ ख़ुदा, क़ौमें तेरी मीरास में घुस आई हैं;</para>
  <para style="q" vid="PSA 79:1">उन्होंने तेरी पाक हैकल को नापाक किया है;</para>
  <para style="q" vid="PSA 79:1">उन्होंने येरूशलेम को खण्डर बना दिया<verse eid="PSA 79:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2"/>उन्होंने तेरे बन्दों की लाशों को आसमान के परिन्दों की,</para>
  <para style="q" vid="PSA 79:2">और तेरे पाक लोगों के गोश्त को ज़मीन के दरिंदों की खू़राक बना दिया है।<verse eid="PSA 79:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3"/>उन्होंने उनका खू़न येरूशलेम के गिर्द पानी की तरह बहाया,</para>
  <para style="q" vid="PSA 79:3">और कोई उनको दफ़्न करने वाला न था।<verse eid="PSA 79:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4"/>हम अपने पड़ोसियों की मलामत का निशाना हैं;</para>
  <para style="q" vid="PSA 79:4">और अपने आसपास के लोगों के तमसख़ुरऔर मज़ाक की वजह।<verse eid="PSA 79:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5"/>ऐ ख़ुदावन्द, कब तक? क्या तू हमेशा के लिए नाराज़ रहेगा?</para>
  <para style="q" vid="PSA 79:5">क्या तेरी गै़रत आग की तरह भड़कती रहेगी?<verse eid="PSA 79:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6"/>अपना क़हर उन क़ौमों पर जो तुझे नहीं पहचानतीं,</para>
  <para style="q" vid="PSA 79:6">और उन ममलुकतों पर जो तेरा नाम नहीं लेतीं, उँडेल दे।<verse eid="PSA 79:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7"/>क्यूँकि उन्होंने या'क़ूब को खा लिया,</para>
  <para style="q" vid="PSA 79:7">और उसके घर को उजाड़ दिया है।<verse eid="PSA 79:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8"/>हमारे बाप — दादा के गुनाहों को हमारे ख़िलाफ़ याद न कर;</para>
  <para style="q" vid="PSA 79:8">तेरी रहमत जल्द हम तक पहुँचे, क्यूँकि हम बहुत पस्त हो गए हैं।<verse eid="PSA 79:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9"/>ऐ हमारे नजात देने वाले ख़ुदा, अपने नाम के जलाल की ख़ातिर हमारी मदद कर;</para>
  <para style="q" vid="PSA 79:9">अपने नाम की ख़ातिर हम को छुड़ाऔर हमारे गुनाहों का कफ़्फ़ारा दे।<verse eid="PSA 79:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10"/>क़ौमें क्यूँ कहें कि उनका ख़ुदा कहाँ है?</para>
  <para style="q" vid="PSA 79:10">तेरे बन्दों के बहाए हुए खू़न का बदला,</para>
  <para style="q" vid="PSA 79:10">हमारी आँखों के सामने क़ौमों पर ज़ाहिर हो जाए।<verse eid="PSA 79:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11"/>कै़दी की आह तेरे सामने तक पहुँचे:</para>
  <para style="q" vid="PSA 79:11">अपनी बड़ी कु़दरत से मरने वालों को बचा ले।<verse eid="PSA 79:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12"/>ऐ ख़ुदावन्द, हमारे पड़ोसियों की ता'नाज़नी,</para>
  <para style="q" vid="PSA 79:12">जो वह तुझ पर करते रहे हैं, उल्टी सात गुना उन्ही के दामन में डाल दे।<verse eid="PSA 79:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13"/>तब हम जो तेरे लोग और तेरी चरागाह की भेड़ें हैं,</para>
  <para style="q" vid="PSA 79:13">हमेशा तेरी शुक्रगुज़ारी करेंगे;</para>
  <para style="q" vid="PSA 79:13">हम नसल दर नसल तेरी सिताइश करेंगे।<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 80:1"/>ऐ इस्राईल के चौपान! तू जो ग़ल्ले की तरह यूसुफ़ को ले चलता है,</para>
  <para style="q" vid="PSA 80:1">कान लगा! तू जो करूबियों पर बैठा है, जलवागर हो!<verse eid="PSA 80:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 80:2"/>इफ़्राईम — ओ — बिनयमीन और मनस्सी के सामने अपनी कु़व्वत को बेदार कर,</para>
  <para style="q" vid="PSA 80:2">और हमें बचाने को आ!<verse eid="PSA 80:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 80:3"/>ऐ ख़ुदा, हम को बहाल कर;</para>
  <para style="q" vid="PSA 80:3">और अपना चेहरा चमका, तो हम बच जाएँगे।<verse eid="PSA 80:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 80:4"/>ऐ ख़ुदावन्द लश्करों के ख़ुदा,</para>
  <para style="q" vid="PSA 80:4">तू कब तक अपने लोगों की दुआ से नाराज़ रहेगा?<verse eid="PSA 80:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 80:5"/>तूने उनको आँसुओं की रोटी खिलाई,</para>
  <para style="q" vid="PSA 80:5">और पीने को कसरत से आँसू ही दिए।<verse eid="PSA 80:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 80:6"/>तू हम को हमारे पड़ोसियों के लिए झगड़े का ज़रिए' बनाता है,</para>
  <para style="q" vid="PSA 80:6">और हमारे दुश्मन आपस में हँसते हैं।<verse eid="PSA 80:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 80:7"/>ऐ लश्करों के ख़ुदा, हम को बहाल कर;</para>
  <para style="q" vid="PSA 80:7">और अपना चेहरा चमका, तो हम बच जाएँगे।<verse eid="PSA 80:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 80:8"/>तू मिस्र से एक ताक लाया;</para>
  <para style="q" vid="PSA 80:8">तूने क़ौमों को ख़ारिज करके उसे लगाया।<verse eid="PSA 80:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 80:9"/>तूने उसके लिए जगह तैयार की;</para>
  <para style="q" vid="PSA 80:9">उसने गहरी जड़ पकड़ी और ज़मीन को भर दिया।<verse eid="PSA 80:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 80:10"/>पहाड़ उसके साये में छिप गए,</para>
  <para style="q" vid="PSA 80:10">और उसकी डालियाँ ख़ुदा के देवदारों की तरह थीं।<verse eid="PSA 80:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 80:11"/>उसने अपनी शाख़ समन्दर तक फैलाई,</para>
  <para style="q" vid="PSA 80:11">और अपनी टहनियाँ दरिया — ए — फरात तक।<verse eid="PSA 80:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 80:12"/>फिर तूने उसकी बाड़ों को क्यूँ तोड़ डाला,</para>
  <para style="q" vid="PSA 80:12">कि सब आने जाने वाले उसका फल तोड़ते हैं?<verse eid="PSA 80:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 80:13"/>जंगली सूअर उसे बरबाद करता है,</para>
  <para style="q" vid="PSA 80:13">और जंगली जानवर उसे खा जातेहैं।<verse eid="PSA 80:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 80:14"/>ऐ लश्करों के ख़ुदा, हम तेरी मिन्नत करते हैं, फिर मुतक्ज्जिह हो!</para>
  <para style="q" vid="PSA 80:14">आसमान पर से निगाह कर और देख, और इस ताक की निगहबानी फ़रमा।<verse eid="PSA 80:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 80:15"/>और उस पौदे की भी जिसे तेरे दहने हाथ ने लगाया है,</para>
  <para style="q" vid="PSA 80:15">और उस शाख़ की जिसे तूने अपने लिए मज़बूत किया है।<verse eid="PSA 80:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 80:16"/>यह आग से जली हुई है, यह कटी पड़ी है;</para>
  <para style="q" vid="PSA 80:16">वह तेरे मुँह की झिड़की से हलाक हो जाते हैं।<verse eid="PSA 80:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 80:17"/>तेरा हाथ तेरी दहनी तरफ़ के इंसान पर हो,</para>
  <para style="q" vid="PSA 80:17">उस इब्न — ए — आदम पर जिसे तूने अपने लिए मज़बूत किया है।<verse eid="PSA 80:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 80:18"/>फिर हम तुझ से नाफ़रमान न होंगे:</para>
  <para style="q" vid="PSA 80:18">तू हम को फिर ज़िन्दा कर और हम तेरा नाम लिया करेंगे।<verse eid="PSA 80:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 80:19"/>ऐ ख़ुदा वन्द लश्करों के ख़ुदा! हम को बहाल कर;</para>
  <para style="q" vid="PSA 80:19">अपना चेहरा चमका तो हम बच जाएँगे!<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 81:1"/>ख़ुदा के सामने जो हमारी ताक़त है, बुलन्द आवाज़ से गाओ;</para>
  <para style="q" vid="PSA 81:1">या'क़ूब के ख़ुदा के सामने ख़ुशी का नारा मारो!<verse eid="PSA 81:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 81:2"/>नग़मा छेड़ो, और दफ़ लाओ और दिलनवाज़ सितार और बरबत।<verse eid="PSA 81:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 81:3"/>नए चाँद और पूरे चाँद के वक़्त,</para>
  <para style="q" vid="PSA 81:3">हमारी 'ईद के दिन नरसिंगा फूँको।<verse eid="PSA 81:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 81:4"/>क्यूँकि यह इस्राईल के लिए क़ानून,</para>
  <para style="q" vid="PSA 81:4">और या'क़ूब के ख़ुदा का हुक्म है।<verse eid="PSA 81:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 81:5"/>इसको उसने यूसुफ़ में शहादत ठहराया,</para>
  <para style="q" vid="PSA 81:5">जब वह मुल्क — ए — मिस्र के ख़िलाफ़ निकला। मैंने उसका कलाम सुना,</para>
  <para style="q" vid="PSA 81:5">जिसको मैं जानता न था<verse eid="PSA 81:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 81:6"/>'मैंने उसके कंधे पर से बोझ उतार दिया;</para>
  <para style="q" vid="PSA 81:6">उसके हाथ टोकरी ढोने से छूट गए।<verse eid="PSA 81:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 81:7"/>तूने मुसीबत में पुकारा और मैंने तुझे छुड़ाया;</para>
  <para style="q" vid="PSA 81:7">मैंने राद के पर्दे में से तुझे जवाब दिया;</para>
  <para style="q" vid="PSA 81:7">मैंने तुझे मरीबा के चश्मे पर आज़माया। सिलाह<verse eid="PSA 81:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 81:8"/>ऐ मेरे लोगो, सुनो, मैं तुम को होशियार करता हूँ!</para>
  <para style="q" vid="PSA 81:8">ऐ इस्राईल, काश के तू मेरी सुनता!<verse eid="PSA 81:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 81:9"/>तेरे बीच कोई गै़र ख़ुदावन्द का मा'बूद न हो;</para>
  <para style="q" vid="PSA 81:9">और तू किसी गै़रख़ुदावन्द के मा'बूद को सिज्दा न करना<verse eid="PSA 81:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 81:10"/>ख़ुदावन्द तेरा ख़ुदा मैं हूँ,</para>
  <para style="q" vid="PSA 81:10">जो तुझे मुल्क — ए — मिस्र से निकाल लाया।</para>
  <para style="q" vid="PSA 81:10">तू अपना मुँह खू़ब खोल और मैं उसे भर दूँगा।<verse eid="PSA 81:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 81:11"/>“लेकिन मेरे लोगों ने मेरी बात न सुनी,</para>
  <para style="q" vid="PSA 81:11">और इस्राईल मुझ से रज़ामंद न हुआ।<verse eid="PSA 81:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 81:12"/>तब मैंने उनको उनके दिल की हट पर छोड़ दिया,</para>
  <para style="q" vid="PSA 81:12">ताकि वह अपने ही मश्वरों पर चलें।<verse eid="PSA 81:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 81:13"/>काश कि मेरे लोग मेरी सुनते,</para>
  <para style="q" vid="PSA 81:13">और इस्राईल मेरी राहों पर चलता!<verse eid="PSA 81:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 81:14"/>मैं जल्द उनके दुश्मनों को मग़लूब कर देता,</para>
  <para style="q" vid="PSA 81:14">और उनके मुखालिफ़ों पर अपना हाथ चलाता।<verse eid="PSA 81:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 81:15"/>ख़ुदावन्द से 'अदावत रखने वाले उसके ताबे हो जाते,</para>
  <para style="q" vid="PSA 81:15">और इनका ज़माना हमेशा तक बना रहता।<verse eid="PSA 81:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 81:16"/>वह इनको अच्छे से अच्छा गेहूँ खिलाता</para>
  <para style="q" vid="PSA 81:16">और मैं तुझे चट्टान में के शहद से शेर करता।”<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 82:1"/>ख़ुदा की जमा'अत में ख़ुदा मौजूद है।</para>
  <para style="q" vid="PSA 82:1">वह इलाहों के बीच 'अदालत करता है:<verse eid="PSA 82:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2"/>“तुम कब तक बेइन्साफ़ी से 'अदालत करोगे,</para>
  <para style="q" vid="PSA 82:2">और शरीरों की तरफ़दारी करोगे? सिलाह<verse eid="PSA 82:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3"/>ग़रीब और यतीम का इन्साफ़ करो,</para>
  <para style="q" vid="PSA 82:3">ग़मज़दा और मुफ़लिस के साथ इन्साफ़ से पेश आओ।<verse eid="PSA 82:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4"/>ग़रीब और मोहताज को बचाओ;</para>
  <para style="q" vid="PSA 82:4">शरीरों के हाथ से उनको छुड़ाओ।”<verse eid="PSA 82:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5"/>वह न तो कुछ जानते हैं न समझते हैं,</para>
  <para style="q" vid="PSA 82:5">वह अंधेरे में इधर उधर चलते हैं;</para>
  <para style="q" vid="PSA 82:5">ज़मीन की सब बुनियादें हिल गई हैं।<verse eid="PSA 82:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6"/>मैंने कहा था, “तुम इलाह हो,</para>
  <para style="q" vid="PSA 82:6">और तुम सब हक़ता'ला के फ़र्ज़न्द हो;<verse eid="PSA 82:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7"/>तोभी तुम आदमियों की तरह मरोगे,</para>
  <para style="q" vid="PSA 82:7">और 'उमरा में से किसी की तरह गिर जाओगे।”<verse eid="PSA 82:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8"/>ऐ ख़ुदा! उठ ज़मीन की 'अदालत कर</para>
  <para style="q" vid="PSA 82:8">क्यूँकि तू ही सब क़ौमों का मालिक होगा।<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 83:1"/>ऐ ख़ुदा! ख़ामोश न रह; ऐ ख़ुदा!</para>
  <para style="q" vid="PSA 83:1">चुपचाप न हो और ख़ामोशी इख़्तियार न कर।<verse eid="PSA 83:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 83:2"/>क्यूँकि देख तेरे दुश्मन ऊधम मचाते हैं</para>
  <para style="q" vid="PSA 83:2">और तुझ से 'अदावत रखने वालों ने सिर उठाया है।<verse eid="PSA 83:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 83:3"/>क्यूँकि वह तेरे लोगों के ख़िलाफ़ मक्कारी से मन्सूबा बाँधते हैं,</para>
  <para style="q" vid="PSA 83:3">और उनके ख़िलाफ़ जो तेरी पनाह में हैं मशवरा करते हैं।<verse eid="PSA 83:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 83:4"/>उन्होंने कहा, “आओ, हम इनको काट डालें कि उनकी क़ौम ही न रहे;</para>
  <para style="q" vid="PSA 83:4">और इस्राईल के नाम का फिर ज़िक्र न हो।”<verse eid="PSA 83:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 83:5"/>क्यूँकि उन्होंने एक हो कर के आपस में मश्वरा किया है,</para>
  <para style="q" vid="PSA 83:5">वह तेरे ख़िलाफ़ 'अहद बाँधते हैं।<verse eid="PSA 83:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 83:6"/>या'नी अदोम के अहल — ए — ख़ैमा</para>
  <para style="q" vid="PSA 83:6">और इस्माईली मोआब और हाजरी,<verse eid="PSA 83:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 83:7"/>जबल और'अम्मून और 'अमालीक़,</para>
  <para style="q" vid="PSA 83:7">फ़िलिस्तीन और सूर के बाशिन्दे,<verse eid="PSA 83:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 83:8"/>असूर भी इनसे मिला हुआ है;</para>
  <para style="q" vid="PSA 83:8">उन्होंने बनी लूत की मदद की है।<verse eid="PSA 83:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 83:9"/>तू उनसे ऐसा कर जैसा मिदियान से,</para>
  <para style="q" vid="PSA 83:9">और जैसा वादी — ए — कैसून में सीसरा और याबीन से किया था।<verse eid="PSA 83:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 83:10"/>जो 'ऐन दोर में हलाक हुए,</para>
  <para style="q" vid="PSA 83:10">वह जैसे ज़मीन की खाद हो गए<verse eid="PSA 83:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 83:11"/>उनके सरदारों को 'ओरेब और ज़ईब की तरह,</para>
  <para style="q" vid="PSA 83:11">बल्कि उनके शाहज़ादों को ज़िबह और ज़िलमना' की तरह बना दे;<verse eid="PSA 83:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 83:12"/>जिन्होंने कहा है,</para>
  <para style="q" vid="PSA 83:12">“आओ, हम ख़ुदा की बस्तियों पर कब्ज़ा कर लें।”<verse eid="PSA 83:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 83:13"/>ऐ मेरे ख़ुदा, उनको बगोले की गर्द की तरह बना दे,</para>
  <para style="q" vid="PSA 83:13">और जैसे हवा के आगे डंठल।<verse eid="PSA 83:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 83:14"/>उस आग की तरह जो जंगल को जला देती है,</para>
  <para style="q" vid="PSA 83:14">उस शो'ले की तरह जो पहाड़ों मेंआग लगा देता है;<verse eid="PSA 83:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 83:15"/>तू इसी तरह अपनी आँधी से उनका पीछा कर,</para>
  <para style="q" vid="PSA 83:15">और अपने तूफ़ान से उनको परेशान कर दे।<verse eid="PSA 83:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 83:16"/>ऐ ख़ुदावन्द! उनके चेहरों पर रुस्वाई तारी कर,</para>
  <para style="q" vid="PSA 83:16">ताकि वह तेरे नाम के तालिब हों।<verse eid="PSA 83:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 83:17"/>वह हमेशा शर्मिन्दा और परेशान रहें,</para>
  <para style="q" vid="PSA 83:17">बल्कि वह रुस्वा होकर हलाक हो जाएँ<verse eid="PSA 83:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 83:18"/>ताकि वह जान लें कि तू ही जिसका यहोवा है,</para>
  <para style="q" vid="PSA 83:18">ज़मीन पर बुलन्द — ओ — बाला है।<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 84:1"/>ऐ लश्करों के ख़ुदावन्द! तेरे घर क्या ही दिलकश हैं!<verse eid="PSA 84:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 84:2"/>मेरी जान ख़ुदावन्द की बारगाहों की मुश्ताक़ है,</para>
  <para style="q" vid="PSA 84:2">बल्कि गुदाज़ हो चली, मेरा दिल और मेरा जिस्म ज़िन्दा ख़ुदा के लिए ख़ुशी से ललकारते हैं।<verse eid="PSA 84:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 84:3"/>ऐ लश्करों के ख़ुदावन्द! ऐ मेरे बादशाहऔर मेरे ख़ुदा!</para>
  <para style="q" vid="PSA 84:3">तेरे मज़बहों के पास गौरया ने अपना आशियाना,</para>
  <para style="q" vid="PSA 84:3">और अबाबील ने अपने लिए घोंसला बना लिया,</para>
  <para style="q" vid="PSA 84:3">जहाँ वह अपने बच्चों को रख्खे।<verse eid="PSA 84:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 84:4"/>मुबारक हैं वह जो तेरे घर में रहते हैं,</para>
  <para style="q" vid="PSA 84:4">वह हमेशा तेरी ता'रीफ़ करेंगे। मिलाह<verse eid="PSA 84:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 84:5"/>मुबारक है वह आदमी, जिसकी ताक़त तुझ से है,</para>
  <para style="q" vid="PSA 84:5">जिसके दिल में सिय्यून की शाह राहें हैं।<verse eid="PSA 84:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 84:6"/>वह वादी — ए — बुका से गुज़र कर उसे चश्मों की जगह बना लेते हैं,</para>
  <para style="q" vid="PSA 84:6">बल्कि पहली बारिश उसे बरकतों से मा'मूर कर देती है।<verse eid="PSA 84:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 84:7"/>वह ताक़त पर ताक़त पाते हैं;</para>
  <para style="q" vid="PSA 84:7">उनमें से हर एक सिय्यून में ख़ुदा के सामने हाज़िर होता है।<verse eid="PSA 84:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 84:8"/>ऐ ख़ुदावन्द, लश्करों के ख़ुदा,</para>
  <para style="q" vid="PSA 84:8">मेरी दुआ सुन ऐ या'क़ूब के ख़ुदा! कान लगा! सिलाह<verse eid="PSA 84:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 84:9"/>ऐ ख़ुदा! ऐ हमारी सिपर! देख;</para>
  <para style="q" vid="PSA 84:9">और अपने मम्सूह के चेहरे पर नजर कर।<verse eid="PSA 84:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 84:10"/>क्यूँकि तेरी बारगाहों में एक दिन हज़ार से बेहतर है।</para>
  <para style="q" vid="PSA 84:10">मैं अपने ख़ुदा के घर का दरबान होना,</para>
  <para style="q" vid="PSA 84:10">शरारत के खे़मों में बसने से ज़्यादा पसंद करूँगा।<verse eid="PSA 84:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 84:11"/>क्यूँकि ख़ुदावन्द ख़ुदा, आफ़ताब और ढाल है;</para>
  <para style="q" vid="PSA 84:11">ख़ुदावन्द फ़ज़ल और जलाल बख़्शेगा वह रास्तरू से कोई ने'मत बाज़ न रख्खेगा।<verse eid="PSA 84:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 84:12"/>ऐ लश्करों के ख़ुदावन्द!</para>
  <para style="q" vid="PSA 84:12">मुबारक है वह आदमी जिसका भरोसा तुझ पर है।<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 85:1"/>ऐ ख़ुदावन्द तू अपने मुल्क पर मेहरबान रहा है।</para>
  <para style="q" vid="PSA 85:1">तू या'क़ूब को ग़ुलामी से वापस लाया है।<verse eid="PSA 85:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 85:2"/>तूने अपने लोगों की बदकारी मु'आफ़ कर दी है;</para>
  <para style="q" vid="PSA 85:2">तूने उनके सब गुनाह ढाँक दिए हैं।<verse eid="PSA 85:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 85:3"/>तूने अपना ग़ज़ब बिल्कुल उठा लिया;</para>
  <para style="q" vid="PSA 85:3">तू अपने क़हर — ए — शदीद से बाज़ आया है।<verse eid="PSA 85:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 85:4"/>ऐ हमारे नजात देने वाले ख़ुदा!</para>
  <para style="q" vid="PSA 85:4">हम को बहाल कर, अपना ग़ज़ब हम से दूर कर!<verse eid="PSA 85:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 85:5"/>क्या तू हमेशा हम से नाराज़ रहेगा?</para>
  <para style="q" vid="PSA 85:5">क्या तू अपने क़हर को नसल दर नसल जारी रख्खेगा?<verse eid="PSA 85:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 85:6"/>क्या तू हम को फिर ज़िन्दा न करेगा,</para>
  <para style="q" vid="PSA 85:6">ताकि तेरे लोग तुझ में ख़ुश हों?<verse eid="PSA 85:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 85:7"/>ऐ ख़ुदावन्द! तू अपनी शफ़क़त हमको दिखा,</para>
  <para style="q" vid="PSA 85:7">और अपनी नजात हम को बख़्श।<verse eid="PSA 85:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 85:8"/>मैं सुनूँगा कि ख़ुदावन्द ख़ुदा क्या फ़रमाता है।</para>
  <para style="q" vid="PSA 85:8">क्यूँकि वह अपने लोगों और अपने पाक लोगों से सलामती की बातें करेगा;</para>
  <para style="q" vid="PSA 85:8">लेकिन वह फिर हिमाक़त की तरफ़ रुजू न करें।<verse eid="PSA 85:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 85:9"/>यक़ीनन उसकी नजात उससे डरने वालों के क़रीब है,</para>
  <para style="q" vid="PSA 85:9">ताकि जलाल हमारे मुल्क में बसे।<verse eid="PSA 85:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 85:10"/>शफ़क़त और रास्ती एक साथ मिल गई हैं,</para>
  <para style="q" vid="PSA 85:10">सदाक़त और सलामती ने एक दूसरे का बोसा लिया है।<verse eid="PSA 85:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 85:11"/>रास्ती ज़मीन से निकलती है,</para>
  <para style="q" vid="PSA 85:11">और सदाक़त आसमान पर से झाँकती हैं।<verse eid="PSA 85:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 85:12"/>जो कुछ अच्छा है वही ख़ुदावन्द अता फ़रमाएगा</para>
  <para style="q" vid="PSA 85:12">और हमारी ज़मीन अपनी पैदावार देगी।<verse eid="PSA 85:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 85:13"/>सदाक़त उसके आगे — आगे चलेगी,</para>
  <para style="q" vid="PSA 85:13">उसके नक़्श — ए — क़दम को हमारी राह बनाएगी।<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 86:1"/>ऐ ख़ुदावन्द! अपना कान झुका और मुझे जवाब दे,</para>
  <para style="q" vid="PSA 86:1">क्यूँकि मैं ग़रीब और मोहताज हूँ।<verse eid="PSA 86:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2"/>मेरी जान की हिफ़ाज़त कर, क्यूँकि मैं दीनदार हूँ,</para>
  <para style="q" vid="PSA 86:2">ऐ मेरे ख़ुदा! अपने बन्दे को,</para>
  <para style="q" vid="PSA 86:2">जिसका भरोसा तुझ पर है, बचा ले।<verse eid="PSA 86:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3"/>या रब्ब, मुझ पर रहम कर,</para>
  <para style="q" vid="PSA 86:3">क्यूँकि मैं दिन भर तुझ से फ़रियाद करता हूँ।<verse eid="PSA 86:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4"/>या रब्ब, अपने बन्दे की जान को ख़ुश कर दे,</para>
  <para style="q" vid="PSA 86:4">क्यूँकि मैं अपनी जान तेरी तरफ़ उठाता हूँ।<verse eid="PSA 86:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5"/>इसलिए कि तू या रब्ब, नेक और मु'आफ़ करने को तैयार है,</para>
  <para style="q" vid="PSA 86:5">और अपने सब दुआ करने वालों पर शफ़क़त में ग़नी है।<verse eid="PSA 86:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6"/>ऐ ख़ुदावन्द, मेरी दुआ पर कान लगा,</para>
  <para style="q" vid="PSA 86:6">और मेरी मिन्नत की आवाज़ पर तवज्जुह फ़रमा।<verse eid="PSA 86:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7"/>मैं अपनी मुसीबत के दिन तुझ से दुआ करूँगा,</para>
  <para style="q" vid="PSA 86:7">क्यूँकि तू मुझे जवाब देगा।<verse eid="PSA 86:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8"/>या रब्ब, मा'मूदों में तुझ सा कोई नहीं,</para>
  <para style="q" vid="PSA 86:8">और तेरी कारीगरी बेमिसाल हैं।<verse eid="PSA 86:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9"/>या रब्ब, सब क़ौमें जिनको तूने बनाया,</para>
  <para style="q" vid="PSA 86:9">आकर तेरे सामने सिज्दा करेंगी और तेरे नाम की तम्जीद करेंगी।<verse eid="PSA 86:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10"/>क्यूँकि तू बुजु़र्ग है और 'अजीब — ओ — ग़रीब काम करता है,</para>
  <para style="q" vid="PSA 86:10">तू ही अकेला ख़ुदा है।<verse eid="PSA 86:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11"/>ऐ ख़ुदावन्द, मुझ को अपनी राह की ता'लीम दे, मैं तेरी रास्ती में चलूँगा;</para>
  <para style="q" vid="PSA 86:11">मेरे दिल को यकसूई बख़्श, ताकि तेरे नाम का ख़ौफ़ मानूँ।<verse eid="PSA 86:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12"/>या रब्ब! मेरे ख़ुदा, मैं पूरे दिल से तेरी ता'रीफ़ करूँगा;</para>
  <para style="q" vid="PSA 86:12">मैं हमेशा तक तेरे नाम की तम्जीद करूँगा।<verse eid="PSA 86:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13"/>क्यूँकि मुझ पर तेरी बड़ी शफ़क़त है;</para>
  <para style="q" vid="PSA 86:13">और तूने मेरी जान को पाताल की तह से निकाला है।<verse eid="PSA 86:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14"/>ऐ ख़ुदा, मग़रूर मेरे ख़िलाफ़ उठे हैं,</para>
  <para style="q" vid="PSA 86:14">और टेढ़े लोगों जमा'अत मेरी जान के पीछे पड़ी है,</para>
  <para style="q" vid="PSA 86:14">और उन्होंने तुझे अपने सामने नहीं रख्खा।<verse eid="PSA 86:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15"/>लेकिन तू या रब्ब, रहीम — ओ — करीम ख़ुदा है,</para>
  <para style="q" vid="PSA 86:15">क़हर करने में धीमा और शफ़क़त — ओ — रास्ती में ग़नी।<verse eid="PSA 86:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16"/>मेरी तरफ़ मुतवज्जिह हो और मुझ पर रहम कर;</para>
  <para style="q" vid="PSA 86:16">अपने बन्दे को अपनी ताक़त बख़्श,</para>
  <para style="q" vid="PSA 86:16">और अपनी लौंडी के बेटे को बचा ले।<verse eid="PSA 86:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17"/>मुझे भलाई का कोई निशान दिखा,</para>
  <para style="q" vid="PSA 86:17">ताकि मुझ से 'अदावत रखने वाले इसे देख कर शर्मिन्दा हों क्यूँकि तूने ऐ ख़ुदावन्द,</para>
  <para style="q" vid="PSA 86:17">मेरी मदद की, और मुझे तसल्ली दी है।<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 87:1"/>उसकी बुनियाद पाक पहाड़ों में है।<verse eid="PSA 87:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2"/>ख़ुदावन्द सिय्यून के फाटकों को या'क़ूब के सब घरों से ज़्यादा 'अज़ीज़ रखता है।<verse eid="PSA 87:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3"/>ऐ ख़ुदा के शहर!</para>
  <para style="q" vid="PSA 87:3">तेरी बड़ी बड़ी खू़बियाँ बयान की जाती हैं। सिलाह<verse eid="PSA 87:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4"/>मैं रहब और बाबुल का यूँ ज़िक्र करूँगा,</para>
  <para style="q" vid="PSA 87:4">कि वह मेरे जानने वालों में हैं;</para>
  <para style="q" vid="PSA 87:4">फ़िलिस्तीन और सूर और कूश को देखो, यह वहाँ पैदा हुआ था।<verse eid="PSA 87:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5"/>बल्कि सिय्यून के बारे में कहा जाएगा,</para>
  <para style="q" vid="PSA 87:5">कि फ़लाँ फ़लाँ आदमी उसमें पैदा हुए।</para>
  <para style="q" vid="PSA 87:5">और हक़ता'ला ख़ुद उसको क़याम बख़्शेगा।<verse eid="PSA 87:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6"/>ख़ुदावन्द क़ौमों के शुमार के वक़्त दर्ज करेगा,</para>
  <para style="q" vid="PSA 87:6">कि यह शख़्स वहाँ पैदा हुआ था।<verse eid="PSA 87:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7"/>गाने वाले और नाचने वाले यही कहेंगे कि</para>
  <para style="q" vid="PSA 87:7">मेरे सब चश्में तुझ ही में हैं।<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 88:1"/>ऐ ख़ुदावन्द, मेरी नजात देने वाले ख़ुदा,</para>
  <para style="q" vid="PSA 88:1">मैंने रात दिन तेरे सामने फ़रियाद की है।<verse eid="PSA 88:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 88:2"/>मेरी दुआ तेरे सामने पहुँचे,</para>
  <para style="q" vid="PSA 88:2">मेरी फ़रियाद पर कान लगा!<verse eid="PSA 88:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 88:3"/>क्यूँकि मेरा दिल दुखों से भरा है,</para>
  <para style="q" vid="PSA 88:3">और मेरी जान पाताल के नज़दीक पहुँच गई है।<verse eid="PSA 88:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 88:4"/>मैं क़ब्र में उतरने वालों के साथ गिना जाता हूँ।</para>
  <para style="q" vid="PSA 88:4">मैं उस शख़्स की तरह हूँ, जो बिल्कुल बेकस हो।<verse eid="PSA 88:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 88:5"/>जैसे मक़्तूलो की तरह जो क़ब्र में पड़े हैं,</para>
  <para style="q" vid="PSA 88:5">मुर्दों के बीच डाल दिया गया हूँ,</para>
  <para style="q" vid="PSA 88:5">जिनको तू फिर कभी याद नहीं करता</para>
  <para style="q" vid="PSA 88:5">और वह तेरे हाथ से काट डाले गए।<verse eid="PSA 88:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 88:6"/>तूने मुझे गहराओ में, अँधेरी जगह में,</para>
  <para style="q" vid="PSA 88:6">पाताल की तह में रख्खा है।<verse eid="PSA 88:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 88:7"/>मुझ पर तेरा क़हर भारी है,</para>
  <para style="q" vid="PSA 88:7">तूने अपनी सब मौजों से मुझे दुख दिया है। सिलाह<verse eid="PSA 88:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 88:8"/>तूने मेरे जान पहचानों को मुझ से दूर कर दिया;</para>
  <para style="q" vid="PSA 88:8">तूने मुझे उनके नज़दीक घिनौना बना दिया।</para>
  <para style="q" vid="PSA 88:8">मैं बन्द हूँ और निकल नहीं सकता।<verse eid="PSA 88:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 88:9"/>मेरी आँख दुख से धुंधला चली।</para>
  <para style="q" vid="PSA 88:9">ऐ ख़ुदावन्द, मैंने हर रोज़ तुझ से दुआ की है;</para>
  <para style="q" vid="PSA 88:9">मैंने अपने हाथ तेरी तरफ़ फैलाए हैं।<verse eid="PSA 88:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 88:10"/>क्या तू मुर्दों को 'अजायब दिखाएगा?</para>
  <para style="q" vid="PSA 88:10">क्या वह जो मर गए हैं उठ कर तेरी ता'रीफ़ करेंगे? सिलाह<verse eid="PSA 88:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 88:11"/>क्या तेरी शफ़क़त का ज़िक्र क़ब्र में होगा,</para>
  <para style="q" vid="PSA 88:11">या तेरी वफ़ादारी का जहन्नुम में?<verse eid="PSA 88:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 88:12"/>क्या तेरे 'अजायब को अंधेरे में पहचानेंगे,</para>
  <para style="q" vid="PSA 88:12">और तेरी सदाक़त को फ़रामोशी की सरज़मीन में?<verse eid="PSA 88:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 88:13"/>लेकिन ऐ ख़ुदावन्द, मैंने तो तेरी दुहाई दी है;</para>
  <para style="q" vid="PSA 88:13">और सुबह को मेरी दुआ तेरे सामने पहुँचेगी।<verse eid="PSA 88:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 88:14"/>ऐ ख़ुदावन्द, तू क्यूँ। मेरी जान को छोड़ देता है?</para>
  <para style="q" vid="PSA 88:14">तू अपना चेहरा मुझ से क्यूँ छिपाता है?<verse eid="PSA 88:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 88:15"/>मैं लड़कपन ही से मुसीबतज़दा</para>
  <para style="q" vid="PSA 88:15">और मौत के क़रीब हूँ मैं तेरे डर के मारे बद हवास हो गया।<verse eid="PSA 88:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 88:16"/>तेरा क़हर — ए — शदीद मुझ पर आ पड़ा:</para>
  <para style="q" vid="PSA 88:16">तेरी दहशत ने मेरा काम तमाम कर दिया।<verse eid="PSA 88:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 88:17"/>उसने दिनभर सैलाब की तरह मेरा घेराव किया;</para>
  <para style="q" vid="PSA 88:17">उसने मुझे बिल्कुल घेर लिया।<verse eid="PSA 88:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 88:18"/>तूने दोस्त व अहबाब को मुझ से दूर किया</para>
  <para style="q" vid="PSA 88:18">और मेरे जान पहचानों को अंधेरे में डाल दिया है।<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 89:1"/>मैं हमेशा ख़ुदावन्द की शफ़क़त के हम्द गाऊँगा।</para>
  <para style="q" vid="PSA 89:1">मैं नसल दर नसल अपने मुँह से तेरी वफ़ादारी का 'ऐलान करूँगा।<verse eid="PSA 89:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 89:2"/>क्यूँकि मैंने कहा कि शफ़क़त हमेशा तक बनी रहेगी,</para>
  <para style="q" vid="PSA 89:2">तू अपनी वफ़ादारी को आसमान में क़ाईम रखेगा।<verse eid="PSA 89:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 89:3"/>“मैंने अपने बरगुज़ीदा के साथ</para>
  <para style="q" vid="PSA 89:3">'अहद बाँधा है मैंने अपने बन्दे दाऊद से क़सम खाई है;<verse eid="PSA 89:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 89:4"/>मैं तेरी नसल को हमेशा के लिए क़ाईम करूँगा,</para>
  <para style="q" vid="PSA 89:4">और तेरे तख़्त को नसल दर नसल बनाए रखूँगा।” सिलाह<verse eid="PSA 89:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 89:5"/>ऐ ख़ुदावन्द, आसमान तेरे 'अजायब की ता'रीफ़ करेगा;</para>
  <para style="q" vid="PSA 89:5">पाक लोगों के मजमे' में तेरी वफ़ादारी की ता'रीफ़ होगी।<verse eid="PSA 89:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 89:6"/>क्यूँकि आसमान पर ख़ुदावन्द का नज़ीर कौन है?</para>
  <para style="q" vid="PSA 89:6">फ़रिश्तों की जमा'त में कौन ख़ुदावन्द की तरह है?<verse eid="PSA 89:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 89:7"/>ऐसा मा'बूद जो पाक लोगो की महफ़िल में बहुत ता'ज़ीम के लायक़ ख़ुदा है,</para>
  <para style="q" vid="PSA 89:7">और अपने सब चारों तरफ़ वालों से ज़्यादा बड़ा है।<verse eid="PSA 89:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 89:8"/>ऐ ख़ुदावन्द लश्करों के ख़ुदा, ऐ याह!</para>
  <para style="q" vid="PSA 89:8">तुझ सा ज़बरदस्त कौन है?</para>
  <para style="q" vid="PSA 89:8">तेरी वफ़ादारी तेरे चारों तरफ़ है।<verse eid="PSA 89:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 89:9"/>समन्दर के जोश — ओ — ख़रोश पर तू हुक्मरानी करता है;</para>
  <para style="q" vid="PSA 89:9">तू उसकी उठती लहरों को थमा देता है।<verse eid="PSA 89:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 89:10"/>तूने रहब को मक़्तूल की तरह टुकड़े टुकड़े किया;</para>
  <para style="q" vid="PSA 89:10">तूने अपने क़वी बाज़ू से अपने दुश्मनों को तितर बितर कर दिया।<verse eid="PSA 89:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 89:11"/>आसमान तेरा है, ज़मीन भी तेरी है;</para>
  <para style="q" vid="PSA 89:11">जहान और उसकी मा'मूरी को तू ही ने क़ाईम किया है।<verse eid="PSA 89:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 89:12"/>उत्तर और दाख्खिन का पैदा करने वाला तू ही है;</para>
  <para style="q" vid="PSA 89:12">तबूर और हरमून तेरे नाम से ख़ुशी मनाते हैं।<verse eid="PSA 89:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 89:13"/>तेरा बाज़ू कु़दरत वाला है;</para>
  <para style="q" vid="PSA 89:13">तेरा हाथ क़वी और तेरा दहना हाथ बुलंद है।<verse eid="PSA 89:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 89:14"/>सदाक़त और 'अद्ल तेरे तख़्त की बुनियाद हैं;</para>
  <para style="q" vid="PSA 89:14">शफ़क़त और वफ़ादारी तेरे आगे आगे चलती हैं।<verse eid="PSA 89:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 89:15"/>मुबारक है वह क़ौम, जो खु़शी की ललकार को पहचानती है,</para>
  <para style="q" vid="PSA 89:15">वह ऐ ख़ुदावन्द, जो तेरे चेहरे के नूर में चलते हैं;<verse eid="PSA 89:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 89:16"/>वह दिनभर तेरे नाम से ख़ुशी मनाते हैं,</para>
  <para style="q" vid="PSA 89:16">और तेरी सदाक़त से सरफराज़ होते हैं।<verse eid="PSA 89:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 89:17"/>क्यूँकि उनकी ताक़त की शान तू ही है</para>
  <para style="q" vid="PSA 89:17">और तेरे करम से हमारा सींग बुलन्द होगा।<verse eid="PSA 89:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 89:18"/>क्यूँकि हमारी ढाल ख़ुदावन्द की तरफ़ से है,</para>
  <para style="q" vid="PSA 89:18">और हमारा बादशाह इस्राईल के क़ुद्दूस की तरफ़ से।<verse eid="PSA 89:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 89:19"/>उस वक़्त तूने ख़्वाब में अपने पाक लोगों से कलाम किया,</para>
  <para style="q" vid="PSA 89:19">और फ़रमाया, मैंने एक ज़बरदस्त को मददगार बनाया है,</para>
  <para style="q" vid="PSA 89:19">और क़ौम में से एक को चुन कर सरफ़राज़ किया है।<verse eid="PSA 89:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 89:20"/>मेरा बन्दा दाऊद मुझे मिल गया,</para>
  <para style="q" vid="PSA 89:20">अपने पाक तेल से मैंने उसे मसह किया है।<verse eid="PSA 89:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 89:21"/>मेरा हाथ उसके साथ रहेगा,</para>
  <para style="q" vid="PSA 89:21">मेरा बाजू़ उसे तक़वियत देगा।<verse eid="PSA 89:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 89:22"/>दुश्मन उस पर जब्र न करने पाएगा,</para>
  <para style="q" vid="PSA 89:22">और शरारत का फ़र्ज़न्द उसे न सताएगा।<verse eid="PSA 89:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 89:23"/>मैं उसके मुख़ालिफ़ों को उसके सामने मग़लूब करूँगा</para>
  <para style="q" vid="PSA 89:23">और उससे 'अदावत रखने वालों को मारूँगा।<verse eid="PSA 89:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 89:24"/>लेकिन मेरी वफ़ादारी और शफ़क़त उसके साथ रहेंगी,</para>
  <para style="q" vid="PSA 89:24">और मेरे नाम से उसका सींग बुलन्द होगा।<verse eid="PSA 89:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 89:25"/>मैं उसका हाथ समन्दर तक बढ़ाऊँगा,</para>
  <para style="q" vid="PSA 89:25">और उसके दहने हाथ को दरियाओं तक।<verse eid="PSA 89:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 89:26"/>वह मुझे पुकार कर कहेगा,</para>
  <para style="q" vid="PSA 89:26">'तू मेराबाप, मेरा ख़ुदा, और मेरी नजात की चट्टान है।<verse eid="PSA 89:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 89:27"/>और मैं उसको अपना पहलौठा बनाऊँगा</para>
  <para style="q" vid="PSA 89:27">और दुनिया का शहंशाह।<verse eid="PSA 89:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 89:28"/>मैं अपनी शफ़क़त को उसके लिए हमेशा तक क़ाईम रखूँगा</para>
  <para style="q" vid="PSA 89:28">और मेरा 'अहद उसके साथ लातब्दील रहेगा।<verse eid="PSA 89:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 89:29"/>मैं उसकी नसल को हमेशा तक क़ाईम रख्खूंगा,</para>
  <para style="q" vid="PSA 89:29">और उसके तख़्त को जब तक आसमानहै।<verse eid="PSA 89:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 89:30"/>अगर उसके फ़र्ज़न्द मेरी शरी'अत को छोड़ दें,</para>
  <para style="q" vid="PSA 89:30">और मेरे अहकाम पर न चलें,<verse eid="PSA 89:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 89:31"/>अगर वह मेरे क़ानून को तोड़ें,</para>
  <para style="q" vid="PSA 89:31">और मेरे फ़रमान को न मानें,<verse eid="PSA 89:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 89:32"/>तो मैं उनको छड़ी से ख़ता की,</para>
  <para style="q" vid="PSA 89:32">और कोड़ों से बदकारी की सज़ा दूँगा।<verse eid="PSA 89:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 89:33"/>लेकिन मैं अपनी शफ़क़त उस पर से हटा न लूँगा,</para>
  <para style="q" vid="PSA 89:33">और अपनी वफ़ादारी को बेकार न होने न दूँगा।<verse eid="PSA 89:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 89:34"/>मैं अपने 'अहद को न तोडूँगा,</para>
  <para style="q" vid="PSA 89:34">और अपने मुँह की बात को न बदलूँगा।<verse eid="PSA 89:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 89:35"/>मैं एक बार अपनी पाकी की क़सम खा चुका हूँ</para>
  <para style="q" vid="PSA 89:35">मैं दाऊद से झूट न बोलूँगा।<verse eid="PSA 89:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 89:36"/>उसकी नसल हमेशा क़ाईम रहेगी,</para>
  <para style="q" vid="PSA 89:36">और उसका तख़्त आफ़ताब की तरह मेरे सामने क़ाईम रहेगा।<verse eid="PSA 89:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 89:37"/>वह हमेशा चाँद की तरह,</para>
  <para style="q" vid="PSA 89:37">और आसमान के सच्चे गवाह की तरह क़ाईम रहेगा। मिलाह<verse eid="PSA 89:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 89:38"/>लेकिन तूने तो तर्क कर दिया और छोड़ दिया,</para>
  <para style="q" vid="PSA 89:38">तू अपने मम्सूह से नाराज़ हुआ है।<verse eid="PSA 89:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 89:39"/>तूने अपने ख़ादिम के 'अहद को रद्द कर दिया,</para>
  <para style="q" vid="PSA 89:39">तूने उसके ताज को ख़ाक में मिला दिया।<verse eid="PSA 89:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 89:40"/>तूने उसकी सब बाड़ों को तोड़ डाला,</para>
  <para style="q" vid="PSA 89:40">तूने उसके क़िलों' को खण्डर बना दिया।<verse eid="PSA 89:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 89:41"/>सब आने जाने वाले उसे लूटते हैं,</para>
  <para style="q" vid="PSA 89:41">वह अपने पड़ोसियों की मलामत का निशाना बन गया।<verse eid="PSA 89:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 89:42"/>तूने उसके मुख़ालिफ़ों के दहने हाथ को बुलन्द किया;</para>
  <para style="q" vid="PSA 89:42">तूने उसके सब दुश्मनों को ख़ुश किया।<verse eid="PSA 89:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 89:43"/>बल्कि तू उसकी तलवार की धार को मोड़ देता है,</para>
  <para style="q" vid="PSA 89:43">और लड़ाई में उसके पाँव को जमने नहीं दिया।<verse eid="PSA 89:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 89:44"/>तूने उसकी रौनक़ उड़ा दी,</para>
  <para style="q" vid="PSA 89:44">और उसका तख़्त ख़ाक में मिला दिया।<verse eid="PSA 89:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 89:45"/>तूने उसकी जवानी के दिन घटा दिए,</para>
  <para style="q" vid="PSA 89:45">तूने उसे शर्मिन्दा कर दिया है। सिलाह<verse eid="PSA 89:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 89:46"/>ऐ ख़ुदावन्द, कब तक? क्या तू हमेशा तक पोशीदा रहेगा?</para>
  <para style="q" vid="PSA 89:46">तेरे क़हर की आग कब तक भड़कती रहेगी?<verse eid="PSA 89:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 89:47"/>याद रख मेरा क़याम ही क्या है,</para>
  <para style="q" vid="PSA 89:47">तूने कैसी बतालत के लिए कुल बनी आदम को पैदा किया।<verse eid="PSA 89:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 89:48"/>वह कौन सा आदमी है जो ज़िन्दा ही रहेगा और मौत को न देखेगा,</para>
  <para style="q" vid="PSA 89:48">और अपनी जान को पाताल के हाथ से बचा लेगा? सिलाह<verse eid="PSA 89:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 89:49"/>या रब्ब, तेरी वह पहली शफ़क़त क्या हुई,</para>
  <para style="q" vid="PSA 89:49">जिसके बारे में तूने दाऊद से अपनी वफ़ादारी की क़सम खाई थी?<verse eid="PSA 89:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 89:50"/>या रब्ब, अपने बन्दों की रुस्वाई को याद कर;</para>
  <para style="q" vid="PSA 89:50">मैं तो सब ज़बरदस्त क़ौमों की ता'नाज़नी, अपने सीने में लिए फिरता हूँ।<verse eid="PSA 89:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 89:51"/>ऐ ख़ुदावन्द, तेरे दुश्मनों ने कैसे ता'ने मारे,</para>
  <para style="q" vid="PSA 89:51">तेरे मम्सूह के क़दम क़दम पर कैसी ता'नाज़नी की है।<verse eid="PSA 89:51"/></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 89:52"/>ख़ुदावन्द हमेशा से हमेशा तक मुबारक हो! आमीन सुम्मा आमीन।<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">चौथी किताब</para>
  <para style="mr">(<ref loc="PSA 90:-1-106">ज़बूर 90-106</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 90:1"/>या रब्ब, नसल दर नसल, तू ही हमारी पनाहगाह रहा है।<verse eid="PSA 90:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2"/>इससे पहले के पहाड़ पैदा हुए,</para>
  <para style="q" vid="PSA 90:2">या ज़मीन और दुनिया को तूने बनाया,</para>
  <para style="q" vid="PSA 90:2">इब्तिदा से हमेशा तक तू ही ख़ुदा है।<verse eid="PSA 90:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3"/>तू इंसान को फिर ख़ाक में मिला देता है,</para>
  <para style="q" vid="PSA 90:3">और फ़रमाता है, “ऐ बनी आदम, लौट आओ!”<verse eid="PSA 90:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4"/>क्यूँकि तेरी नज़र में हज़ार बरस ऐसे हैं,</para>
  <para style="q" vid="PSA 90:4">जैसे कल का दिन जो गुज़र गया,</para>
  <para style="q" vid="PSA 90:4">और जैसे रात का एक पहर।<verse eid="PSA 90:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5"/>तू उनको जैसे सैलाब से बहा ले जाता है;</para>
  <para style="q" vid="PSA 90:5">वह नींद की एक झपकी की तरह हैं,</para>
  <para style="q" vid="PSA 90:5">वह सुबह को उगने वाली घास की तरह हैं।<verse eid="PSA 90:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6"/>वह सुबह को लहलहाती और बढ़ती है,</para>
  <para style="q" vid="PSA 90:6">वह शाम को कटती और सूख जातीहै।<verse eid="PSA 90:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7"/>क्यूँकि हम तेरे क़हर से फ़ना हो गए;</para>
  <para style="q" vid="PSA 90:7">और तेरे ग़ज़ब से परेशान हुए।<verse eid="PSA 90:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8"/>तूने हमारी बदकिरदारी को अपने सामने रख्खा,</para>
  <para style="q" vid="PSA 90:8">और हमारे छुपे हुए गुनाहों को अपने चेहरे की रोशनी में।<verse eid="PSA 90:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9"/>क्यूँकि हमारे तमाम दिन तेरे क़हर में गुज़रे,</para>
  <para style="q" vid="PSA 90:9">हमारी उम्र ख़याल की तरह जाती रहती है।<verse eid="PSA 90:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10"/>हमारी उम्र की मी'आद सत्तर बरस है,</para>
  <para style="q" vid="PSA 90:10">या कु़व्वत हो तो अस्सी बरस;</para>
  <para style="q" vid="PSA 90:10">तो भी उनकी रौनक़ महज़ मशक्क़त और ग़म है,</para>
  <para style="q" vid="PSA 90:10">क्यूँकि वह जल्द जाती रहती है और हम उड़ जाते हैं।<verse eid="PSA 90:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11"/>तेरे क़हर की शिद्दत को कौन जानता है,</para>
  <para style="q" vid="PSA 90:11">और तेरे ख़ौफ़ के मुताबिक़ तेरे ग़ज़ब को?<verse eid="PSA 90:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12"/>हम को अपने दिन गिनना सिखा,</para>
  <para style="q" vid="PSA 90:12">ऐसा कि हम अक़्ल दिल हासिल करें।<verse eid="PSA 90:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13"/>ऐ ख़ुदावन्द, बाज़ आ! कब तक?</para>
  <para style="q" vid="PSA 90:13">और अपने बन्दों पर रहम फ़रमा!<verse eid="PSA 90:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14"/>सुबह को अपनी शफ़क़त से हम को आसूदा कर,</para>
  <para style="q" vid="PSA 90:14">ताकि हम उम्र भर ख़ुश — ओ — ख़ुर्रम रहें।<verse eid="PSA 90:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15"/>जितने दिन तूने हम को दुख दिया,</para>
  <para style="q" vid="PSA 90:15">और जितने बरस हम मुसीबत में रहे,</para>
  <para style="q" vid="PSA 90:15">उतनी ही ख़ुशी हम को 'इनायत कर।<verse eid="PSA 90:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16"/>तेरा काम तेरे बन्दों पर,</para>
  <para style="q" vid="PSA 90:16">और तेरा जलाल उनकी औलाद पर ज़ाहिर हो।<verse eid="PSA 90:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17"/>और रब्ब हमारे ख़ुदा का करम हम पर साया करे।</para>
  <para style="q" vid="PSA 90:17">हमारे हाथों के काम को हमारे लिए क़याम बख़्श हाँ</para>
  <para style="q" vid="PSA 90:17">हमारे हाथों के काम को क़याम बख़्श दे।<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 91:1"/>जो हक़ता'ला के पर्दे में रहता है,</para>
  <para style="q" vid="PSA 91:1">वह क़ादिर — ए — मुतलक़ के साये में सुकूनत करेगा।<verse eid="PSA 91:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2"/>मैं ख़ुदावन्द के बारे में कहूँगा, “वही मेरी पनाह और मेरा गढ़ है;</para>
  <para style="q" vid="PSA 91:2">वह मेरा ख़ुदा है, जिस पर मेरा भरोसा है।”<verse eid="PSA 91:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3"/>क्यूँकि वह तुझे सय्याद के फंदे से,</para>
  <para style="q" vid="PSA 91:3">और मुहलिक वबा से छुड़ाएगा।<verse eid="PSA 91:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4"/>वह तुझे अपने परों से छिपा लेगा,</para>
  <para style="q" vid="PSA 91:4">और तुझे उसके बाजु़ओं के नीचे पनाह मिलेगी,</para>
  <para style="q" vid="PSA 91:4">उसकी सच्चाई ढाल और सिपर है।<verse eid="PSA 91:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5"/>तू न रात के ख़ौफ़ से डरेगा,</para>
  <para style="q" vid="PSA 91:5">न दिन को उड़ने वाले तीर से।<verse eid="PSA 91:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6"/>न उस वबा से जो अंधेरे में चलती है,</para>
  <para style="q" vid="PSA 91:6">न उस हलाकत से जो दोपहर को वीरान करती है।<verse eid="PSA 91:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7"/>तेरे आसपास एक हज़ार गिर जाएँगे,</para>
  <para style="q" vid="PSA 91:7">और तेरे दहने हाथ की तरफ़ दस हज़ार;</para>
  <para style="q" vid="PSA 91:7">लेकिन वह तेरे नज़दीक न आएगी।<verse eid="PSA 91:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8"/>लेकिन तू अपनी आँखों से निगाह करेगा,</para>
  <para style="q" vid="PSA 91:8">और शरीरों के अंजाम को देखेगा।<verse eid="PSA 91:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9"/>लेकिन तू ऐ ख़ुदावन्द, मेरी पनाह है।</para>
  <para style="q" vid="PSA 91:9">तूने हक़ता'ला को अपना घर बना लिया है।<verse eid="PSA 91:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10"/>तुझ पर कोई आफ़त नहीं आएगी,</para>
  <para style="q" vid="PSA 91:10">और कोई वबा तेरे ख़ेमे के नज़दीक न पहुँचेगी।<verse eid="PSA 91:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11"/>क्यूँकि वह तेरे बारे में अपने फ़रिश्तों को हुक्म देगा,</para>
  <para style="q" vid="PSA 91:11">कि तेरी सब राहों में तेरी हिफ़ाज़त करें।<verse eid="PSA 91:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12"/>वह तुझे अपने हाथों पर उठा लेंगे,</para>
  <para style="q" vid="PSA 91:12">ताकि ऐसा न हो कि तेरे पाँव को पत्थर से ठेस लगे।<verse eid="PSA 91:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13"/>तू शेर — ए — बबर और अज़दहा को रौंदेगा,</para>
  <para style="q" vid="PSA 91:13">तू जवान शेर और अज़दह को पामाल करेगा।<verse eid="PSA 91:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14"/>चूँकि उसने मुझ से दिल लगाया है, इसलिए मैं उसे छुड़ाऊँगा;</para>
  <para style="q" vid="PSA 91:14">मैं उसे सरफ़राज़ करूँगा, क्यूँकि उसने मेरा नाम पहचाना है।<verse eid="PSA 91:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15"/>वह मुझे पुकारेगा और मैं उसे जवाब दूँगा,</para>
  <para style="q" vid="PSA 91:15">मैं मुसीबत में उसके साथ रहूँगा,</para>
  <para style="q" vid="PSA 91:15">मैं उसे छुड़ाऊँगा और 'इज़्ज़त बख़्शूँगा।<verse eid="PSA 91:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16"/>मैं उसे उम्र की दराज़ी से आसूदा कर दूँगा</para>
  <para style="q" vid="PSA 91:16">और अपनी नजात उसे दिखाऊँगा।<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 92:1"/>क्या ही भला है, ख़ुदावन्द का शुक्र करना,</para>
  <para style="q" vid="PSA 92:1">और तेरे नाम की मदहसराई करना; ऐ हक़ ता'ला!<verse eid="PSA 92:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 92:2"/>सुबह को तेरी शफ़क़त का इज़्हार करना,</para>
  <para style="q" vid="PSA 92:2">और रात को तेरी वफ़ादारी का,<verse eid="PSA 92:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 92:3"/>दस तार वाले साज़ और बर्बत पर,</para>
  <para style="q" vid="PSA 92:3">और सितार पर गूंजती आवाज़ के साथ।<verse eid="PSA 92:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 92:4"/>क्यूँकि, ऐ ख़ुदावन्द, तूने मुझे अपने काम से ख़ुश किया;</para>
  <para style="q" vid="PSA 92:4">मैं तेरी कारीगरी की वजह से ख़ुशी मनाऊँगा।<verse eid="PSA 92:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 92:5"/>ऐ ख़ुदावन्द, तेरी कारीगरी कैसी बड़ी हैं।</para>
  <para style="q" vid="PSA 92:5">तेरे ख़याल बहुत 'अमीक़ हैं।<verse eid="PSA 92:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 92:6"/>हैवान ख़सलत नहीं जानता</para>
  <para style="q" vid="PSA 92:6">और बेवक़ूफ़ इसको नहीं समझता,<verse eid="PSA 92:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 92:7"/>जब शरीर घास की तरह उगते हैं,</para>
  <para style="q" vid="PSA 92:7">और सब बदकिरदार फूलते फलते हैं,</para>
  <para style="q" vid="PSA 92:7">तो यह इसी लिए है कि वह हमेशा के लिए फ़ना हों।<verse eid="PSA 92:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 92:8"/>लेकिन तू ऐ ख़ुदावन्द, हमेशा से हमेशा तक बुलन्द है।<verse eid="PSA 92:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 92:9"/>क्यूँकि देख, ऐ ख़ुदावन्द, तेरे दुश्मन;</para>
  <para style="q" vid="PSA 92:9">देख, तेरे दुश्मन हलाक हो जाएँगे;</para>
  <para style="q" vid="PSA 92:9">सब बदकिरदार तितर बितर कर दिए जाएँगे।<verse eid="PSA 92:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 92:10"/>लेकिन तूने मेरे सींग को जंगली साँड के सींग की तरह बलन्द किया है;</para>
  <para style="q" vid="PSA 92:10">मुझ पर ताज़ा तेल मला गया है।<verse eid="PSA 92:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 92:11"/>मेरी आँख ने मेरे दुश्मनों को देख लिया,</para>
  <para style="q" vid="PSA 92:11">मेरे कानों ने मेरे मुख़ालिफ़ बदकारों का हाल सुन लिया है।<verse eid="PSA 92:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 92:12"/>सादिक़ खजूर के दरख़्त की तरह सरसब्ज़ होगा।</para>
  <para style="q" vid="PSA 92:12">वह लुबनान के देवदार की तरह बढ़ेगा।<verse eid="PSA 92:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 92:13"/>जो ख़ुदावन्द के घर में लगाए गए हैं,</para>
  <para style="q" vid="PSA 92:13">वह हमारे ख़ुदा की बारगाहों में सरसब्ज़ होंगे।<verse eid="PSA 92:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 92:14"/>वह बुढ़ापे में भी कामयाब होंगे,</para>
  <para style="q" vid="PSA 92:14">वह तर — ओ — ताज़ा और सरसब्ज़ रहेंगे;<verse eid="PSA 92:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 92:15"/>ताकि वाज़ह करें कि ख़ुदावन्द रास्त है</para>
  <para style="q" vid="PSA 92:15">वही मेरी चट्टान है और उसमें न रास्ती नहीं।<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 93:1"/>ख़ुदावन्द सलतनत करता है वह शौकत से मुलब्बस है</para>
  <para style="q" vid="PSA 93:1">ख़ुदावन्द कु़दरत से मुलब्बस है, वह उससे कमर बस्ता है</para>
  <para style="q" vid="PSA 93:1">इस लिए जहान क़ाईम है और उसे जुम्बिश नहीं।<verse eid="PSA 93:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2"/>तेरा तख़्त पहले से क़ाईम है, तू इब्तिदा से है।<verse eid="PSA 93:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3"/>सैलाबों ने, ऐ ख़ुदावन्द!</para>
  <para style="q" vid="PSA 93:3">सैलाबों ने शोर मचा रख्खा है, सैलाब मौजज़न हैं।<verse eid="PSA 93:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4"/>बहरों की आवाज़ से,</para>
  <para style="q" vid="PSA 93:4">समन्दर की ज़बरदस्त मौजों से भी,</para>
  <para style="q" vid="PSA 93:4">ख़ुदावन्द बलन्द — ओ — क़ादिर है।<verse eid="PSA 93:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5"/>तेरी शहादतें बिल्कुल सच्ची हैं;</para>
  <para style="q" vid="PSA 93:5">ऐ ख़ुदावन्द हमेशा से हमेशा तक के लिए</para>
  <para style="q" vid="PSA 93:5">पाकीज़गी तेरे घर को ज़ेबा है।<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 94:1"/>ऐ ख़ुदावन्द! ऐ इन्तक़ाम लेने वाले</para>
  <para style="q" vid="PSA 94:1">ख़ुदा ऐ इन्तक़ाम लेने वाले ख़ुदा! जलवागर हो!<verse eid="PSA 94:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2"/>ऐ जहान का इन्साफ़ करने वाले! उठ;</para>
  <para style="q" vid="PSA 94:2">मग़रूरों को बदला दे!<verse eid="PSA 94:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3"/>ऐ ख़ुदावन्द, शरीर कब तक;</para>
  <para style="q" vid="PSA 94:3">शरीर कब तक ख़ुशी मनाया करेंगे?<verse eid="PSA 94:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4"/>वह बकवास करते और बड़ा बोल बोलत हैं,</para>
  <para style="q" vid="PSA 94:4">सब बदकिरदार लाफ़ज़नी करते हैं।<verse eid="PSA 94:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5"/>ऐ ख़ुदावन्द! वह तेरे लोगों को पीसे डालते हैं,</para>
  <para style="q" vid="PSA 94:5">और तेरी मीरास को दुख देते हैं।<verse eid="PSA 94:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6"/>वह बेवा और परदेसी को क़त्ल करते,</para>
  <para style="q" vid="PSA 94:6">और यतीम को मार डालते हैं;<verse eid="PSA 94:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7"/>और कहते है “ख़ुदावन्द नहीं देखेगा</para>
  <para style="q" vid="PSA 94:7">और या'क़ूब का ख़ुदा ख़याल नहीं करेगा।”<verse eid="PSA 94:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8"/>ऐ क़ौम के हैवानो! ज़रा ख़याल करो;</para>
  <para style="q" vid="PSA 94:8">ऐ बेवक़ूफ़ों! तुम्हें कब 'अक़्ल आएगी?<verse eid="PSA 94:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9"/>जिसने कान दिया, क्या वह ख़ुद नहीं सुनता?</para>
  <para style="q" vid="PSA 94:9">जिसने आँख बनाई, क्या वह देख नहीं सकता?<verse eid="PSA 94:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10"/>क्या वह जो क़ौमों को तम्बीह करता है,</para>
  <para style="q" vid="PSA 94:10">और इंसान को समझ सिखाता है, सज़ा न देगा?<verse eid="PSA 94:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11"/>ख़ुदावन्द इंसान के ख़यालों को जानता है, कि वह बेकार हैं।<verse eid="PSA 94:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12"/>ऐ ख़ुदावन्द, मुबारक है वह आदमी जिसे तू तम्बीह करता,</para>
  <para style="q" vid="PSA 94:12">और अपनी शरी'अत की ता'लीम देता है।<verse eid="PSA 94:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13"/>ताकि उसको मुसीबत के दिनों में आराम बख्शे,</para>
  <para style="q" vid="PSA 94:13">जब तक शरीर के लिए गढ़ा न खोदा जाए।<verse eid="PSA 94:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14"/>क्यूँकि ख़ुदावन्द अपने लोगों को नहीं छोड़ेगा,</para>
  <para style="q" vid="PSA 94:14">और वह अपनी मीरास को नहीं छोड़ेगा;<verse eid="PSA 94:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15"/>क्यूँकि 'अद्ल सदाक़त की तरफ़ रुजू' करेगा,</para>
  <para style="q" vid="PSA 94:15">और सब रास्त दिल उसकी पैरवी करेंगे।<verse eid="PSA 94:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16"/>शरीरों के मुक़ाबले में कौन मेरे लिए उठेगा?</para>
  <para style="q" vid="PSA 94:16">बदकिरदारों के ख़िलाफ़ कौन मेरे लिए खड़ा होगा?<verse eid="PSA 94:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17"/>अगर ख़ुदावन्द मेरा मददगार न होता,</para>
  <para style="q" vid="PSA 94:17">तो मेरी जान कब की 'आलम — ए — ख़ामोशी में जा बसी होती।<verse eid="PSA 94:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18"/>जब मैंने कहा, मेरा पाँव फिसल चला,</para>
  <para style="q" vid="PSA 94:18">तो ऐ ख़ुदावन्द! तेरी शफ़क़त ने मुझे संभाल लिया।<verse eid="PSA 94:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19"/>जब मेरे दिल में फ़िक्रों की कसरत होती है,</para>
  <para style="q" vid="PSA 94:19">तो तेरी तसल्ली मेरी जान को ख़ुश करती है।<verse eid="PSA 94:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20"/>क्या शरारत के तख़्त से तुझे कुछ वास्ता होगा,</para>
  <para style="q" vid="PSA 94:20">जो क़ानून की आड़ में बदी गढ़ता है?<verse eid="PSA 94:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21"/>वह सादिक़ की जान लेने को इकट्ठे होते हैं,</para>
  <para style="q" vid="PSA 94:21">और बेगुनाह पर क़त्ल का फ़तवा देते हैं।<verse eid="PSA 94:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22"/>लेकिन ख़ुदावन्द मेरा ऊँचा बुर्ज,</para>
  <para style="q" vid="PSA 94:22">और मेरा ख़ुदा मेरी पनाह की चट्टान रहा है।<verse eid="PSA 94:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23"/>वह उनकी बदकारी उन ही पर लाएगा,</para>
  <para style="q" vid="PSA 94:23">और उन ही की शरारत में उनको काट डालेगा।</para>
  <para style="q" vid="PSA 94:23">ख़ुदावन्द हमारा उनको काट डालेगा।<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1"/>आओ हम ख़ुदावन्द के सामने नग़मासराई करे!</para>
  <para style="q" vid="PSA 95:1">अपनी नजात की चट्टान के सामने खु़शी से ललकारें।<verse eid="PSA 95:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2"/>शुक्रगुज़ारी करते हुए उसके सामने में हाज़िर हों,</para>
  <para style="q" vid="PSA 95:2">मज़मूर गाते हुए उसके आगे ख़ुशी से ललकारें।<verse eid="PSA 95:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3"/>क्यूँकि ख़ुदावन्द ख़ुदा — ए — 'अज़ीम है,</para>
  <para style="q" vid="PSA 95:3">और सब इलाहों पर शाह — ए — 'अज़ीम है।<verse eid="PSA 95:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4"/>ज़मीन के गहराव उसके क़ब्ज़े में हैं;</para>
  <para style="q" vid="PSA 95:4">पहाड़ों की चोटियाँ भी उसी की हैं।<verse eid="PSA 95:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5"/>समन्दर उसका है, उसी ने उसको बनाया,</para>
  <para style="q" vid="PSA 95:5">और उसी के हाथों ने खु़श्की को भी तैयार किया।<verse eid="PSA 95:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6"/>आओ हम झुकें और सिज्दा करें,</para>
  <para style="q" vid="PSA 95:6">और अपने खालिक़ ख़ुदावन्द के सामने घुटने टेकें!<verse eid="PSA 95:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7"/>क्यूँकि वह हमारा ख़ुदा है,</para>
  <para style="q" vid="PSA 95:7">और हम उसकी चरागाह के लोग,</para>
  <para style="q" vid="PSA 95:7">और उसके हाथ की भेड़ें हैं।</para>
  <para style="q" vid="PSA 95:7">काश कि आज के दिन तुम उसकी आवाज़ सुनते!<verse eid="PSA 95:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8"/>तुम अपने दिल को सख़्त न करो जैसा मरीबा में,</para>
  <para style="q" vid="PSA 95:8">जैसा मस्साह के दिन वीरान में किया था,<verse eid="PSA 95:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9"/>उस वक़्त तुम्हारे बाप — दादा ने मुझे आज़माया,</para>
  <para style="q" vid="PSA 95:9">और मेरा इम्तिहान किया और मेरे काम को भी देखा।<verse eid="PSA 95:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10"/>चालीस बरस तक मैं उस नसल से बेज़ार रहा,</para>
  <para style="q" vid="PSA 95:10">और मैने कहा, कि “ये वह लोग हैं जिनके दिल आवारा हैं,</para>
  <para style="q" vid="PSA 95:10">और उन्होंने मेरी राहों को नहीं पहचाना।”<verse eid="PSA 95:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11"/>चुनाँचे मैने अपने ग़ज़ब में क़सम खाई कि</para>
  <para style="q" vid="PSA 95:11">यह लोग मेरे आराम में दाख़िल न होंगे।<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1"/>ख़ुदावन्द के सामने नया हम्द गाओ!</para>
  <para style="q" vid="PSA 96:1">ऐ सब अहल — ए — ज़मीन! ख़ुदावन्द के सामने गाओ।<verse eid="PSA 96:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2"/>ख़ुदावन्द के सामने गाओ, उसके नाम को मुबारक कहो;</para>
  <para style="q" vid="PSA 96:2">रोज़ ब रोज़ उसकी नजात की बशारत दो।<verse eid="PSA 96:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3"/>क़ौमों में उसके जलाल का,</para>
  <para style="q" vid="PSA 96:3">सब लोगों में उसके 'अजायब का बयान करो।<verse eid="PSA 96:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4"/>क्यूँकि ख़ुदावन्द बुज़ु़र्ग़ और बहुत। सिताइश के लायक़ है;</para>
  <para style="q" vid="PSA 96:4">वह सब मा'बूदों से ज़्यादा ता'ज़ीम के लायक़ है।<verse eid="PSA 96:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5"/>इसलिए कि और क़ौमों के सब मा'बूद सिर्फ़ बुत हैं;</para>
  <para style="q" vid="PSA 96:5">लेकिन ख़ुदावन्द ने आसमानों को बनाया।<verse eid="PSA 96:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6"/>अज़मत और जलाल उसके सामने में हैं,</para>
  <para style="q" vid="PSA 96:6">क़ुदरत और जमाल उसके मक़दिस में।<verse eid="PSA 96:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7"/>ऐ क़ौमों के क़बीलो! ख़ुदावन्द की,</para>
  <para style="q" vid="PSA 96:7">ख़ुदावन्द ही की तम्जीद — ओ — ताज़ीम करो!<verse eid="PSA 96:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8"/>ख़ुदावन्द की ऐसी तम्जीद करो जो उसके नाम की शायान है;</para>
  <para style="q" vid="PSA 96:8">हदिया लाओ और उसकी बारगाहों में आओ!<verse eid="PSA 96:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9"/>पाक आराइश के साथ ख़ुदावन्द को सिज्दा करो;</para>
  <para style="q" vid="PSA 96:9">ऐ सब अहल — ए — ज़मीन! उसके सामने काँपते रहो!<verse eid="PSA 96:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10"/>क़ौमों में 'ऐलान करो, “ख़ुदावन्द सल्तनत करता है!</para>
  <para style="q" vid="PSA 96:10">जहान क़ाईम है, और उसे जुम्बिश नहीं;</para>
  <para style="q" vid="PSA 96:10">वह रास्ती से कौमों की 'अदालत करेगा।”<verse eid="PSA 96:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11"/>आसमान ख़ुशी मनाए, और ज़मीन ख़ुश हो;</para>
  <para style="q" vid="PSA 96:11">समन्दर और उसकी मा'मूरी शोर मचाएँ;<verse eid="PSA 96:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12"/>मैदान और जो कुछ उसमें है, बाग़ — बाग़ हों;</para>
  <para style="q" vid="PSA 96:12">तब जंगल के सब दरख़्त खु़शी से गाने लगेंगे।<verse eid="PSA 96:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13"/>ख़ुदावन्द के सामने, क्यूँकि वह आ रहा है;</para>
  <para style="q" vid="PSA 96:13">वह ज़मीन की 'अदालत करने को रहा है।</para>
  <para style="q" vid="PSA 96:13">वह सदाक़त से जहान की, और अपनी सच्चाई से क़ौमों की 'अदालत करेगा।<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1"/>ख़ुदावन्द सल्तनत करता है, ज़मीन ख़ुश हो;</para>
  <para style="q" vid="PSA 97:1">बेशुमार जज़ीरे ख़ुशी मनाएँ।<verse eid="PSA 97:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2"/>बादल और तारीकी उसके चारों तरफ़ हैं;</para>
  <para style="q" vid="PSA 97:2">सदाक़त और अदल उसके तख़्त की बुनियाद हैं।<verse eid="PSA 97:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3"/>आग उसके आगे आगे चलती है,</para>
  <para style="q" vid="PSA 97:3">और चारों तरफ़ उसके मुख़ालिफ़ो को भसम कर देती है।<verse eid="PSA 97:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4"/>उसकी बिजलियों ने जहान को रोशन कर दिया</para>
  <para style="q" vid="PSA 97:4">ज़मीन ने देखा और काँप गई।<verse eid="PSA 97:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5"/>ख़ुदावन्द के सामने पहाड़ मोम की तरह पिघल गए,</para>
  <para style="q" vid="PSA 97:5">या'नी सारी ज़मीन के ख़ुदावन्द के सामने।<verse eid="PSA 97:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6"/>आसमान उसकी सदाक़त ज़ाहिर करता सब क़ौमों ने उसका जलाल देखा है।<verse eid="PSA 97:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7"/>खुदी हुई मूरतों के सब पूजने वाले,</para>
  <para style="q" vid="PSA 97:7">जो बुतों पर फ़ख़्र करते हैं, शर्मिन्दा हों,</para>
  <para style="q" vid="PSA 97:7">ऐ मा'बूद! सब उसको सिज्दा करो।<verse eid="PSA 97:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8"/>ऐ ख़ुदावन्द! सिय्यून ने सुना और खु़श हुई</para>
  <para style="q" vid="PSA 97:8">और यहूदाह की बेटियाँ तेरे अहकाम से ख़ुश हुई।<verse eid="PSA 97:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9"/>क्यूँकि ऐ ख़ुदावन्द! तू तमाम ज़मीन पर बुलंद — ओ — बाला है;</para>
  <para style="q" vid="PSA 97:9">तू सब मा'बूदों से बहुत आला है।<verse eid="PSA 97:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10"/>ऐ ख़ुदावन्द से मुहब्बत रखने वालों, बदी से नफ़रत करो,</para>
  <para style="q" vid="PSA 97:10">वह अपने पाक लोगों की जानों को महफ़ूज़ रखता है,</para>
  <para style="q" vid="PSA 97:10">वह उनको शरीरों के हाथ से छुड़ाता है।<verse eid="PSA 97:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11"/>सादिक़ों के लिए नूर बोया गया है,</para>
  <para style="q" vid="PSA 97:11">और रास्त दिलों के लिए खु़शी।<verse eid="PSA 97:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12"/>ऐ सादिक़ों! ख़ुदावन्द में खु़श रहो;</para>
  <para style="q" vid="PSA 97:12">उसके पाक नाम का शुक्र करो।<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 98:1"/>ख़ुदावन्द के सामने नया हम्द गाओ</para>
  <para style="q" vid="PSA 98:1">क्यूँकि उसने 'अजीब काम किए हैं।</para>
  <para style="q" vid="PSA 98:1">उसके दहने हाथ और उसके पाक बाज़ू ने उसके लिए फ़तह हासिल की है।<verse eid="PSA 98:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2"/>ख़ुदावन्द ने अपनी नजात ज़ाहिर की है,</para>
  <para style="q" vid="PSA 98:2">उसने अपनी सदाक़त क़ौमों के सामने ज़ाहिर की है।<verse eid="PSA 98:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3"/>उसने इस्राईल के घराने के हक़ में अपनी शफ़क़त — ओ — वफ़ादारी याद की है,</para>
  <para style="q" vid="PSA 98:3">इन्तिहाई ज़मीन के लोगों ने हमारे ख़ुदा की नजात देखी है।<verse eid="PSA 98:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4"/>ऐ तमाम अहल — ए — ज़मीन! ख़ुदावन्द के सामने ख़ुशी का नारा मारो;</para>
  <para style="q" vid="PSA 98:4">ललकारो और खु़शी से गाओ और मदहसराई करो।<verse eid="PSA 98:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5"/>ख़ुदावन्द की सिताइश सितार पर करो,</para>
  <para style="q" vid="PSA 98:5">सितार और सुरीली आवाज़ से।<verse eid="PSA 98:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6"/>नरसिंगे और करना की आवाज़ से,</para>
  <para style="q" vid="PSA 98:6">बादशाह या'नी ख़ुदावन्द के सामने खु़शी का नारा मारो।<verse eid="PSA 98:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7"/>समन्दर और उसकी मा'मूरी शोर मचाएँ</para>
  <para style="q" vid="PSA 98:7">और जहान और उसके बाशिंदे।<verse eid="PSA 98:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8"/>सैलाब तालियाँ बजाएँ;</para>
  <para style="q" vid="PSA 98:8">पहाड़ियाँ मिलकर ख़ुशी से गाएँ।<verse eid="PSA 98:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 98:9"/>ख़ुदावन्द के सामने, क्यूँकि वह ज़मीन की 'अदालत करने आ रहा है।</para>
  <para style="q" vid="PSA 98:9">वह सदाक़त से जहान की,</para>
  <para style="q" vid="PSA 98:9">रास्ती से क़ौमों की 'अदालत करेगा।<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1"/>ख़ुदावन्द सलतनत करता है,</para>
  <para style="q" vid="PSA 99:1">क़ौमें काँपी। वह करूबियों पर बैठता है, ज़मीन लरज़े।<verse eid="PSA 99:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2"/>ख़ुदावन्द सिय्यून में बुज़ु़र्ग़ है;</para>
  <para style="q" vid="PSA 99:2">और वह सब क़ौमों पर बुलंद — ओ — बाला है।<verse eid="PSA 99:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3"/>वह तेरे बुज़ुर्ग और बड़े नाम की ता'रीफ़ करें वह पाक हैं।<verse eid="PSA 99:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4"/>बादशाह की ताक़त इन्साफ़ पसन्द है</para>
  <para style="q" vid="PSA 99:4">तू रास्ती को क़ाईम करता है तू ही ने 'अद्ल</para>
  <para style="q" vid="PSA 99:4">और सदाक़त को या'क़ूब, में रायज किया।<verse eid="PSA 99:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5"/>तुम ख़ुदावन्द हमारे ख़ुदा की तम्जीद करो,</para>
  <para style="q" vid="PSA 99:5">और उसके पाँव की चौकी पर सिज्दा वह पाक है।<verse eid="PSA 99:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6"/>उसके काहिनों में से मूसा और हारून ने,</para>
  <para style="q" vid="PSA 99:6">और उसका नाम लेनेवालों में से समुएल ने ख़ुदावन्द से दुआ की और उसने उनको जवाब दिया।<verse eid="PSA 99:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7"/>उसने बादल के सुतून में से उनसे कलाम किया;</para>
  <para style="q" vid="PSA 99:7">उन्होंने उसकी शहादतों को और उस क़ानून को जो उनको दिया था, माना।<verse eid="PSA 99:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8"/>ऐ ख़ुदावन्द हमारे ख़ुदा, तू उनको जवाब देता था;</para>
  <para style="q" vid="PSA 99:8">तू वह ख़ुदा है जो उनको मु'आफ करता रहा,</para>
  <para style="q" vid="PSA 99:8">अगरचे तूने उनके आ'माल का बदला भी दिया।<verse eid="PSA 99:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9"/>तुम ख़ुदावन्द हमारे ख़ुदा की तम्जीद करो,</para>
  <para style="q" vid="PSA 99:9">और उसके पाक पहाड़ पर सिज्दा करो;</para>
  <para style="q" vid="PSA 99:9">क्यूँकि ख़ुदावन्द हमारा ख़ुदा क़ुददूस है।<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 100:1"/>ऐ अहले ज़मीन, सब ख़ुदावन्द के सामने ख़ुशी का ना'रा मारो!<verse eid="PSA 100:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2"/>ख़ुशी से ख़ुदावन्द की इबादत करो!</para>
  <para style="q" vid="PSA 100:2">गाते हुए उसके सामने हाज़िर हों!<verse eid="PSA 100:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3"/>जान रखों ख़ुदावन्द ही ख़ुदा है!</para>
  <para style="q" vid="PSA 100:3">उसी ने हम को बनाया और हम उसी के है;</para>
  <para style="q" vid="PSA 100:3">हम उसके लोग और उसकी चरागाह की भेड़े हैं।<verse eid="PSA 100:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4"/>शुक्रगुज़ारी करते हुए उसके फाटकों में</para>
  <para style="q" vid="PSA 100:4">और हम्द करते हुए उसकी बारगाहों में दाख़िल हो;</para>
  <para style="q" vid="PSA 100:4">उसका शुक्र करो और उसके नाम को मुबारक कहो!<verse eid="PSA 100:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5"/>क्यूँकि ख़ुदावन्द भला है, उसकी शफ़क़त हमेशा की है,</para>
  <para style="q" vid="PSA 100:5">और उसकी वफ़ादारी नसल दर नसल रहती है।<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 101:1"/>मैं शफ़क़त और 'अदल का हम्द गाऊँगा;</para>
  <para style="q" vid="PSA 101:1">ऐ ख़ुदावन्द, मैं तेरी मदह सराई करूँगा।<verse eid="PSA 101:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2"/>मैं 'अक़्लमंदी से कामिल राह पर चलूँगा,</para>
  <para style="q" vid="PSA 101:2">तू मेरे पास कब आएगा?</para>
  <para style="q" vid="PSA 101:2">घर में मेरा चाल चलन सच्चे दिल से होगा।<verse eid="PSA 101:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3"/>मैं किसी ख़बासत को मद्द — ए — नज़र नहीं रखूँगा;</para>
  <para style="q" vid="PSA 101:3">मुझे कज रफ़तारों के काम से नफ़रत है;</para>
  <para style="q" vid="PSA 101:3">उसको मुझ से कुछ मतलब न होगा।<verse eid="PSA 101:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4"/>कजदिली मुझ से दूर हो जाएगी;</para>
  <para style="q" vid="PSA 101:4">मैं किसी बुराई से आशना न हूँगा।<verse eid="PSA 101:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5"/>जो दर पर्दा अपने पड़ोसी की बुराई करे,</para>
  <para style="q" vid="PSA 101:5">मैं उसे हलाक कर डालूँगा;</para>
  <para style="q" vid="PSA 101:5">मैं बुलन्द नज़र और मग़रूर दिल की बर्दाश्त न करूँगा।<verse eid="PSA 101:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6"/>मुल्क के ईमानदारों पर मेरी निगाह होगी ताकि वह मेरे साथ रहें;</para>
  <para style="q" vid="PSA 101:6">जो कामिल राह पर चलता है वही मेरी ख़िदमत करेगा।<verse eid="PSA 101:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7"/>दग़ाबाज़ मेरे घर में रहने न पाएगा;</para>
  <para style="q" vid="PSA 101:7">दरोग़ गो को मेरे सामने क़याम न होगा।<verse eid="PSA 101:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8"/>मैं हर सुबह मुल्क के सब शरीरों को हलाक किया करूँगा,</para>
  <para style="q" vid="PSA 101:8">ताकि ख़ुदावन्द के शहर से बदकारों को काट डालूँ।<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 102:1"/>ऐ ख़ुदावन्द! मेरी दुआ सुन</para>
  <para style="q" vid="PSA 102:1">और मेरी फ़रियाद तेरे सामने पहुँचे।<verse eid="PSA 102:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 102:2"/>मेरी मुसीबत के दिन मुझ से चेहरा न छिपा,</para>
  <para style="q" vid="PSA 102:2">अपना कान मेरी तरफ़ झुका,</para>
  <para style="q" vid="PSA 102:2">जिस दिन मैं फ़रियाद करूँ मुझे जल्द जवाब दे।<verse eid="PSA 102:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 102:3"/>क्यूँकि मेरे दिन धुएँ की तरह उड़े जाते हैं,</para>
  <para style="q" vid="PSA 102:3">और मेरी हड्डियाँ ईधन की तरह जल गई।<verse eid="PSA 102:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 102:4"/>मेरा दिल घास की तरह झुलस कर सूख गया;</para>
  <para style="q" vid="PSA 102:4">क्यूँकि मैं अपनी रोटी खाना भूल जाता हूँ।<verse eid="PSA 102:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 102:5"/>कराहते कराहते मेरी हड्डियाँ मेरे गोश्त से जा लगीं।<verse eid="PSA 102:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 102:6"/>मैं जंगली हवासिल की तरह हूँ,</para>
  <para style="q" vid="PSA 102:6">मैं वीराने का उल्लू बन गया।<verse eid="PSA 102:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 102:7"/>मैं बेख़्वाब और उस गौरे की तरह हो गया हूँ,</para>
  <para style="q" vid="PSA 102:7">जो छत पर अकेला हो।<verse eid="PSA 102:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 102:8"/>मेरे दुश्मन मुझे दिन भर मलामत करते हैं;</para>
  <para style="q" vid="PSA 102:8">मेरे मुख़ालिफ़ दीवाना होकर मुझ पर ला'नत करते हैं।<verse eid="PSA 102:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 102:9"/>क्यूँकि मैंने रोटी की तरह राख खाई,</para>
  <para style="q" vid="PSA 102:9">और आँसू मिलाकर पानी पिया।<verse eid="PSA 102:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 102:10"/>यह तेरे ग़ज़ब और क़हर की वजह से है,</para>
  <para style="q" vid="PSA 102:10">क्यूँकि तूने मुझे उठाया और फिर पटक दिया।<verse eid="PSA 102:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 102:11"/>मेरे दिन ढलने वाले साये की तरह हैं,</para>
  <para style="q" vid="PSA 102:11">और मैं घास की तरह मुरझा गया<verse eid="PSA 102:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 102:12"/>लेकिन तू ऐ ख़ुदावन्द, हमेशा तक रहेगा;</para>
  <para style="q" vid="PSA 102:12">और तेरी यादगार नसल — दर — नसल रहेगी।<verse eid="PSA 102:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 102:13"/>तू उठेगा और सिय्यून पर रहम करेगाः</para>
  <para style="q" vid="PSA 102:13">क्यूँकि उस पर तरस खाने का वक़्त है, हाँ उसका मु'अय्यन वक़्त आ गया है।<verse eid="PSA 102:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 102:14"/>इसलिए कि तेरे बन्दे उसके पत्थरों को चाहते,</para>
  <para style="q" vid="PSA 102:14">और उसकी ख़ाक पर तरस खाते हैं।<verse eid="PSA 102:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 102:15"/>और क़ौमों को ख़ुदावन्द के नाम का,</para>
  <para style="q" vid="PSA 102:15">और ज़मीन के सब बादशाहों को तेरे जलाल का ख़ौफ़ होगा।<verse eid="PSA 102:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 102:16"/>क्यूँकि ख़ुदावन्द ने सिय्यून को बनाया है;</para>
  <para style="q" vid="PSA 102:16">वह अपने जलाल में ज़ाहिर हुआ है।<verse eid="PSA 102:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 102:17"/>उसने बेकसों की दुआ पर तवज्जुह की,</para>
  <para style="q" vid="PSA 102:17">और उनकी दुआ को हक़ीर न जाना।<verse eid="PSA 102:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 102:18"/>यह आने वाली नसल के लिए लिखा जाएगा,</para>
  <para style="q" vid="PSA 102:18">और एक क़ौम पैदा होगी जो ख़ुदावन्द की सिताइश करेगी।<verse eid="PSA 102:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 102:19"/>क्यूँकि उसने अपने हैकल की बुलन्दी पर से निगाह की,</para>
  <para style="q" vid="PSA 102:19">ख़ुदावन्द ने आसमान पर से ज़मीन पर नज़र की;<verse eid="PSA 102:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 102:20"/>ताकि ग़ुलाम का कराहना सुने,</para>
  <para style="q" vid="PSA 102:20">और मरने वालों को छुड़ा ले;<verse eid="PSA 102:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 102:21"/>ताकि लोग सिय्यून में ख़ुदावन्द के नाम का इज़हार,</para>
  <para style="q" vid="PSA 102:21">और येरूशलेम में उसकी ता'रीफ़ करें,<verse eid="PSA 102:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 102:22"/>जब ख़ुदावन्द की इबादत के लिए, हों।<verse eid="PSA 102:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 102:23"/>उसने राह में मेरा ज़ोर घटा दिया,</para>
  <para style="q" vid="PSA 102:23">उसने मेरी उम्र कोताह कर दी।<verse eid="PSA 102:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 102:24"/>मैंने कहा, ऐ मेरे ख़ुदा, मुझे आधी उम्र में न उठा,</para>
  <para style="q" vid="PSA 102:24">तेरे बरस नसल दर नसल हैं।<verse eid="PSA 102:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 102:25"/>तूने इब्तिदा से ज़मीन की बुनियाद डाली;</para>
  <para style="q" vid="PSA 102:25">आसमान तेरे हाथ की कारीगरी है।<verse eid="PSA 102:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 102:26"/>वह हलाक हो जाएँगे, लेकिन तू बाक़ी रहेगा;</para>
  <para style="q" vid="PSA 102:26">बल्कि वह सब पोशाक की तरह पुराने हो जाएँगे।</para>
  <para style="q" vid="PSA 102:26">तू उनको लिबास की तरह बदलेगा, और वह बदल जाएँगे;<verse eid="PSA 102:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 102:27"/>लेकिन तू बदलने वाला नहीं है,</para>
  <para style="q" vid="PSA 102:27">और तेरे बरस बेइन्तिहा होंगे।<verse eid="PSA 102:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 102:28"/>तेरे बन्दों के फ़र्ज़न्द बरकरार रहेंगे;</para>
  <para style="q" vid="PSA 102:28">और उनकी नसल तेरे सामने क़ाईम रहेगी।<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 103:1"/>ऐ मेरी जान! ख़ुदावन्द को मुबारक़ कह;</para>
  <para style="q" vid="PSA 103:1">और जो कुछ मुझमें है उसके पाक नाम को मुबारक़ कहें<verse eid="PSA 103:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2"/>ऐ मेरी जान! ख़ुदावन्द को मुबारक़ कह</para>
  <para style="q" vid="PSA 103:2">और उसकी किसी ने'मत को फ़रामोश न कर।<verse eid="PSA 103:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3"/>वह तेरी सारी बदकारी को बख़्शता है</para>
  <para style="q" vid="PSA 103:3">वह तुझे तमाम बीमारियों से शिफ़ा देता है<verse eid="PSA 103:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4"/>वह तेरी जान हलाकत से बचाता है,</para>
  <para style="q" vid="PSA 103:4">वह तेरे सर पर शफ़क़त व रहमत का ताज रखता है।<verse eid="PSA 103:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5"/>वह तुझे उम्र भर अच्छी अच्छी चीज़ों से आसूदा करता है,</para>
  <para style="q" vid="PSA 103:5">तू 'उक़ाब की तरह नए सिरे नौजवान होता है।<verse eid="PSA 103:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6"/>ख़ुदावन्द सब मज़लूमों के लिए सदाक़त</para>
  <para style="q" vid="PSA 103:6">और अदल के काम करता है।<verse eid="PSA 103:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7"/>उसने अपनी राहें मूसा पर</para>
  <para style="q" vid="PSA 103:7">और अपने काम बनी इस्राईल पर ज़ाहीर किए।<verse eid="PSA 103:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8"/>ख़ुदावन्द रहीम व करीम है,</para>
  <para style="q" vid="PSA 103:8">क़हर करने में धीमा और शफ़क़त में गनी।<verse eid="PSA 103:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9"/>वह सदा झिड़कता न रहेगा</para>
  <para style="q" vid="PSA 103:9">वह हमेशा ग़ज़बनाक न रहेगा।<verse eid="PSA 103:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10"/>उस ने हमारे गुनाहों के मुवाफ़िक़ हम से सुलूक नहीं किया</para>
  <para style="q" vid="PSA 103:10">और हमारी बदकारियों के मुताबिक़ हमको बदला नहीं दिया।<verse eid="PSA 103:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11"/>क्यूँकि जिस क़द्र आसमान ज़मीन से बुलन्द,</para>
  <para style="q" vid="PSA 103:11">उसी क़द्र उसकी शफ़क़त उन पर है, जो उससे डरते हैं।<verse eid="PSA 103:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12"/>जैसे पूरब पच्छिम से दूर है,</para>
  <para style="q" vid="PSA 103:12">वैसे ही उसने हमारी ख़ताएँ हम सेदूर कर दीं।<verse eid="PSA 103:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13"/>जैसे बाप अपने बेटों पर तरस खाता है,</para>
  <para style="q" vid="PSA 103:13">वैसे ही ख़ुदावन्द उन पर जो उससे डरते हैं, तरस खाता है।<verse eid="PSA 103:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14"/>क्यूँकि वह हमारी सरिश्त से वाक़िफ़ है,</para>
  <para style="q" vid="PSA 103:14">उसे याद है कि हम ख़ाक हैं।<verse eid="PSA 103:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15"/>इंसान की उम्र तो घास की तरह है,</para>
  <para style="q" vid="PSA 103:15">वह जंगली फूल की तरह खिलता है,<verse eid="PSA 103:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16"/>कि हवा उस पर चली और वह नहीं,</para>
  <para style="q" vid="PSA 103:16">और उसकी जगह उसे फिर न देखेगी<verse eid="PSA 103:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17"/>लेकिन ख़ुदावन्द की शफ़क़त उससे डरने वालों पर अज़ल से हमेशा तक,</para>
  <para style="q" vid="PSA 103:17">और उसकी सदाक़त नसल — दर — नसल है<verse eid="PSA 103:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18"/>या'नी उन पर जो उसके 'अहद पर क़ाईम रहते हैं,</para>
  <para style="q" vid="PSA 103:18">और उसके क़वानीन पर 'अमल करनायाद रखते हैं।<verse eid="PSA 103:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19"/>ख़ुदावन्द ने अपना तख़्त आसमान पर क़ाईम किया है,</para>
  <para style="q" vid="PSA 103:19">और उसकी सल्तनत सब पर मुसल्लत है।<verse eid="PSA 103:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20"/>ऐ ख़ुदावन्द के फ़िरिश्तो, उसको मुबारक कहो,</para>
  <para style="q" vid="PSA 103:20">तुम जो ज़ोर में बढ़ कर हो और उसके कलाम की आवाज़ सुन कर उस पर 'अमल करते हो।<verse eid="PSA 103:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21"/>ऐ ख़ुदावन्द के लश्करो, सब उसको मुबारक कहो!</para>
  <para style="q" vid="PSA 103:21">तुम जो उसके ख़ादिम हो और उसकी मर्ज़ी बजा लाते हो।<verse eid="PSA 103:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22"/>ऐ ख़ुदावन्द की मख़लूक़ात, सब उसको मुबारक कहो!</para>
  <para style="q" vid="PSA 103:22">तुम जो उसके तसल्लुत के सब मकामों में ही। ऐ मेरी जान,</para>
  <para style="q" vid="PSA 103:22">तू ख़ुदावन्द को मुबारक कह!<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1"/>ऐ मेरी जान, तू ख़ुदावन्द को मुबारक कह,</para>
  <para style="q" vid="PSA 104:1">ऐ ख़ुदावन्द मेरे ख़ुदा तू बहुत बुज़ुर्ग है,</para>
  <para style="q" vid="PSA 104:1">तू हश्मत और जलाल से मुलब्बस है!<verse eid="PSA 104:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2"/>तू नूर को पोशाक की तरह पहनता है,</para>
  <para style="q" vid="PSA 104:2">और आसमान को सायबान की तरह तानता है।<verse eid="PSA 104:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3"/>तू अपने बालाख़ानों के शहतीर पानी पर टिकाता है;</para>
  <para style="q" vid="PSA 104:3">तू बादलों को अपना रथ बनाता है;</para>
  <para style="q" vid="PSA 104:3">तू हवा के बाज़ुओं पर सैर करता है;<verse eid="PSA 104:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4"/>तू अपने फ़रिश्तों को हवाएँ</para>
  <para style="q" vid="PSA 104:4">और अपने ख़ादिमों की आग के शो'ले बनाता है।<verse eid="PSA 104:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5"/>तूने ज़मीन को उसकी बुनियाद पर क़ाईम किया,</para>
  <para style="q" vid="PSA 104:5">ताकि वह कभी जुम्बिश न खाए।<verse eid="PSA 104:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6"/>तूने उसको समन्दर से छिपाया जैसे लिबास से;</para>
  <para style="q" vid="PSA 104:6">पानी पहाड़ों से भी बुलन्द था।<verse eid="PSA 104:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7"/>वह तेरी झिड़की से भागा वह</para>
  <para style="q" vid="PSA 104:7">तेरी गरज की आवाज़ से जल्दी — जल्दी चला।<verse eid="PSA 104:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8"/>उस जगह पहुँच गया जो तूने उसके लिए तैयार की थी;</para>
  <para style="q" vid="PSA 104:8">पहाड़ उभर आए, वादियाँ बैठ गई।<verse eid="PSA 104:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9"/>तूने हद बाँध दी ताकि वह आगे न बढ़ सके,</para>
  <para style="q" vid="PSA 104:9">और फिर लौटकर ज़मीन को न छिपाए।<verse eid="PSA 104:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10"/>वह वादियों में चश्मे जारी करता है,</para>
  <para style="q" vid="PSA 104:10">जो पहाड़ों में बहते हैं।<verse eid="PSA 104:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11"/>सब जंगली जानवर उनसे पीते हैं;</para>
  <para style="q" vid="PSA 104:11">गोरखर अपनी प्यास बुझाते हैं।<verse eid="PSA 104:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12"/>उनके आसपास हवा के परिन्दे बसेरा करते,</para>
  <para style="q" vid="PSA 104:12">और डालियों में चहचहाते हैं।<verse eid="PSA 104:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13"/>वह अपने बालाख़ानों से पहाड़ों को सेराब करता है।</para>
  <para style="q" vid="PSA 104:13">तेरी कारीगरी के फल से ज़मीन आसूदा है।<verse eid="PSA 104:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14"/>वह चौपायों के लिए घास उगाता है,</para>
  <para style="q" vid="PSA 104:14">और इंसान के काम के लिए सब्ज़ा</para>
  <para style="q" vid="PSA 104:14">, ताकि ज़मीन से ख़ुराक पैदा करे।<verse eid="PSA 104:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15"/>और मय जो इंसान के दिल कोऔर रोग़न जो उसके चेहरे को चमकाता है,</para>
  <para style="q" vid="PSA 104:15">और रोटी जो आदमी के दिल को तवानाई बख्शती है।<verse eid="PSA 104:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16"/>ख़ुदावन्द के दरख़्त शादाब रहते हैं,</para>
  <para style="q" vid="PSA 104:16">या'नी लुबनान के देवदार जो उसने लगाए।<verse eid="PSA 104:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17"/>जहाँ परिन्दे अपने घोंसले बनाते हैं;</para>
  <para style="q" vid="PSA 104:17">सनोबर के दरख़्तों में लकलक का बसेरा है।<verse eid="PSA 104:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18"/>ऊँचे पहाड़ जंगली बकरों के लिए हैं;</para>
  <para style="q" vid="PSA 104:18">चट्टानें साफ़ानों की पनाह की जगह हैं।<verse eid="PSA 104:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19"/>उसने चाँद को ज़मानों के फ़र्क़ के लिए मुक़र्रर किया;</para>
  <para style="q" vid="PSA 104:19">आफ़ताब अपने ग़ुरुब की जगह जानता है।<verse eid="PSA 104:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20"/>तू अँधेरा कर देता है तो रात हो जाती है,</para>
  <para style="q" vid="PSA 104:20">जिसमें सब जंगली जानवर निकल आते हैं।<verse eid="PSA 104:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21"/>जवान शेर अपने शिकार की तलाश में गरजते हैं,</para>
  <para style="q" vid="PSA 104:21">और ख़ुदा से अपनी खू़राक माँगते हैं।<verse eid="PSA 104:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22"/>आफ़ताब निकलते ही वह चल देते हैं,</para>
  <para style="q" vid="PSA 104:22">और जाकर अपनी माँदों में पड़े रहते हैं।<verse eid="PSA 104:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23"/>इंसान अपने काम के लिए,</para>
  <para style="q" vid="PSA 104:23">और शाम तक अपनी मेहनत करने के लिए निकलता है।<verse eid="PSA 104:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24"/>ऐ ख़ुदावन्द, तेरी कारीगरी कैसी बेशुमार हैं।</para>
  <para style="q" vid="PSA 104:24">तूने यह सब कुछ हिकमत से बनाया;</para>
  <para style="q" vid="PSA 104:24">ज़मीन तेरी मख़लूक़ात से मा'मूर है।<verse eid="PSA 104:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25"/>देखो, यह बड़ा और चौड़ा समन्दर,</para>
  <para style="q" vid="PSA 104:25">जिसमें बेशुमार रेंगने वाले जानदार हैं;</para>
  <para style="q" vid="PSA 104:25">या'नी छोटे और बड़े जानवर।<verse eid="PSA 104:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26"/>जहाज़ इसी में चलते हैं; इसी में लिवियातान है,</para>
  <para style="q" vid="PSA 104:26">जिसे तूने इसमें खेलने को पैदा किया।<verse eid="PSA 104:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27"/>इन सबको तेरी ही उम्मीद है,</para>
  <para style="q" vid="PSA 104:27">ताकि तू उनको वक़्त पर ख़ूराक दे।<verse eid="PSA 104:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28"/>जो कुछ तू देता है, यह ले लेते हैं;</para>
  <para style="q" vid="PSA 104:28">तू अपनी मुट्ठी खोलता है और यह अच्छी चीज़ों से सेर होते हैं<verse eid="PSA 104:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29"/>तू अपना चेहरा छिपा लेता है, और यह परेशान हो जाते हैं;</para>
  <para style="q" vid="PSA 104:29">तू इनका दम रोक लेता है, और यह मर जाते हैं,</para>
  <para style="q" vid="PSA 104:29">और फिर मिट्टी में मिल जाते हैं।<verse eid="PSA 104:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30"/>तू अपनी रूह भेजता है, और यह पैदा होते हैं;</para>
  <para style="q" vid="PSA 104:30">और तू इस ज़मीन को नया बना देता है।<verse eid="PSA 104:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31"/>ख़ुदावन्द का जलाल हमेशा तक रहे,</para>
  <para style="q" vid="PSA 104:31">ख़ुदावन्द अपनी कारीगरी से खु़श हो।<verse eid="PSA 104:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32"/>वह ज़मीन पर निगाह करता है, और वह काँप जाती है</para>
  <para style="q" vid="PSA 104:32">; वह पहाड़ों को छूता है, और उनसे से धुआँ निकलने लगता है।<verse eid="PSA 104:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33"/>मैं उम्र भर ख़ुदावन्द की ता'रीफ़ गाऊँगा;</para>
  <para style="q" vid="PSA 104:33">जब तक मेरा वुजूद है मैं अपने ख़ुदा की मदहसराई करूँगा।<verse eid="PSA 104:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34"/>मेरा ध्यान उसे पसन्द आए,</para>
  <para style="q" vid="PSA 104:34">मैं ख़ुदावन्द में ख़ुश रहूँगा।<verse eid="PSA 104:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35"/>गुनहगार ज़मीन पर से फ़ना हो जाएँ,</para>
  <para style="q" vid="PSA 104:35">और शरीर बाक़ी न रहें!</para>
  <para style="q" vid="PSA 104:35">ऐ मेरी जान, ख़ुदावन्द को मुबारक कह!</para>
  <para style="q" vid="PSA 104:35">ख़ुदावन्द की हम्द करो!<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1"/>ख़ुदावन्द का शुक्र करो, उसके नाम से दुआ करो;</para>
  <para style="q" vid="PSA 105:1">क़ौमों में उसके कामों का बयान करो!<verse eid="PSA 105:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2"/>उसकी ता'रीफ़ में गाओ, उसकी मदहसराई करो;</para>
  <para style="q" vid="PSA 105:2">उसके तमाम 'अजायब का चर्चा करो!<verse eid="PSA 105:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3"/>उसके पाक नाम पर फ़ख़्र करो,</para>
  <para style="q" vid="PSA 105:3">ख़ुदावन्द के तालिबों के दिल ख़ुश हों!<verse eid="PSA 105:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4"/>ख़ुदावन्द और उसकी ताक़त के तालिब हो,</para>
  <para style="q" vid="PSA 105:4">हमेशा उसके दीदार के तालिब रहो!<verse eid="PSA 105:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 105:5"/>उन 'अजीब कामों को जो उसने किए,</para>
  <para style="q" vid="PSA 105:5">उसके 'अजायब और मुँह केअहकाम को याद रख्खो!<verse eid="PSA 105:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 105:6"/>ऐ उसके बन्दे अब्रहाम की नसल!</para>
  <para style="q" vid="PSA 105:6">ऐ बनी या'क़ूब उसके बरगुज़ीदो!<verse eid="PSA 105:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7"/>वही ख़ुदावन्द हमारा ख़ुदा है;</para>
  <para style="q" vid="PSA 105:7">उसके अहकाम तमाम ज़मीन पर हैं।<verse eid="PSA 105:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8"/>उसने अपने 'अहद को हमेशा याद रख्खा,</para>
  <para style="q" vid="PSA 105:8">या'नी उस कलाम को जो उसने हज़ार नसलों के लिए फ़रमाया;<verse eid="PSA 105:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9"/>उसी 'अहद को जो उसने अब्रहाम से बाँधा,</para>
  <para style="q" vid="PSA 105:9">और उस क़सम को जो उसने इस्हाक़ से खाई,<verse eid="PSA 105:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10"/>और उसी को उसने या'क़ूब के लिए क़ानून,</para>
  <para style="q" vid="PSA 105:10">या'नी इस्राईल के लिए हमेशा का 'अहद ठहराया,<verse eid="PSA 105:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11"/>और कहा, “मैं कनान का मुल्क तुझे दूँगा,</para>
  <para style="q" vid="PSA 105:11">कि तुम्हारा मौरूसी हिस्सा हो।”<verse eid="PSA 105:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12"/>उस वक़्त वह शुमार में थोड़े थे,</para>
  <para style="q" vid="PSA 105:12">बल्कि बहुत थोड़े और उस मुल्क में मुसाफ़िर थे।<verse eid="PSA 105:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13"/>और वह एक क़ौम से दूसरी क़ौम में,</para>
  <para style="q" vid="PSA 105:13">और एक सल्तनत से दूसरी सल्तनत में फिरते रहे।<verse eid="PSA 105:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14"/>उसने किसी आदमी को उन पर ज़ुल्म न करने दिया,</para>
  <para style="q" vid="PSA 105:14">बल्कि उनकी ख़ातिर उसने बादशाहों को धमकाया,<verse eid="PSA 105:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15"/>और कहा, “मेरे मम्सूहों को हाथ न लगाओ,</para>
  <para style="q" vid="PSA 105:15">और मेरे नबियों को कोई नुक़सान न पहुँचाओ!”<verse eid="PSA 105:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16"/>फिर उसने फ़रमाया, कि उस मुल्क पर क़हत नाज़िल हो</para>
  <para style="q" vid="PSA 105:16">और उसने रोटी का सहारा बिल्कुल तोड़ दिया।<verse eid="PSA 105:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17"/>उसने उनसे पहले एक आदमी को भेजा,</para>
  <para style="q" vid="PSA 105:17">यूसुफ़ गु़लामी में बेचा गया।<verse eid="PSA 105:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18"/>उन्होंने उसके पाँव को बेड़ियों से दुख दिया;</para>
  <para style="q" vid="PSA 105:18">वह लोहे की ज़न्जीरों में जकड़ा रहा;<verse eid="PSA 105:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19"/>जब तक के उसका बात पूरा न हुआ,</para>
  <para style="q" vid="PSA 105:19">ख़ुदावन्द का कलाम उसे आज़माता रहा।<verse eid="PSA 105:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20"/>बादशाह ने हुक्म भेज कर उसे छुड़ाया,</para>
  <para style="q" vid="PSA 105:20">हाँ क़ौमों के फ़रमान रवा ने उसे आज़ाद किया।<verse eid="PSA 105:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21"/>उसने उसको अपने घर का मुख़्तार</para>
  <para style="q" vid="PSA 105:21">और अपनी सारी मिलिकयत पर हाकिम बनाया,<verse eid="PSA 105:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22"/>ताकि उसके हाकिमों को जब चाहे कै़द करे,</para>
  <para style="q" vid="PSA 105:22">और उसके बुज़ुर्गों को अक़्ल सिखाए।<verse eid="PSA 105:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23"/>इस्राईल भी मिस्र में आया,</para>
  <para style="q" vid="PSA 105:23">और या'क़ूब हाम की सरज़मीन में मुसाफ़िर रहा।<verse eid="PSA 105:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24"/>और ख़ुदा ने अपने लोगों को खू़ब बढ़ाया,</para>
  <para style="q" vid="PSA 105:24">और उनको उनके मुख़ालिफ़ों से ज़्यादा मज़बूत किया।<verse eid="PSA 105:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25"/>उसने उनके दिल को नाफ़रमान किया,</para>
  <para style="q" vid="PSA 105:25">ताकि उसकी क़ौम से 'अदावत रख्खें,</para>
  <para style="q" vid="PSA 105:25">और उसके बन्दों से दग़ाबाजी करें।<verse eid="PSA 105:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26"/>उसने अपने बन्दे मूसा को,</para>
  <para style="q" vid="PSA 105:26">और अपने बरगुज़ीदा हारून को भेजा।<verse eid="PSA 105:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27"/>उसने उनके बीच निशान और मुअजिज़ात,</para>
  <para style="q" vid="PSA 105:27">और हाम की सरज़मीन में 'अजायब दिखाए।<verse eid="PSA 105:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28"/>उसने तारीकी भेजकर अँधेरा कर दिया;</para>
  <para style="q" vid="PSA 105:28">और उन्होंने उसकी बातों से सरकशी न की।<verse eid="PSA 105:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29"/>उसने उनकी नदियों को लहू बना दिया,</para>
  <para style="q" vid="PSA 105:29">और उनकी मछलियाँ मार डालीं।<verse eid="PSA 105:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30"/>उनके मुल्क और बादशाहों के बालाख़ानों में,</para>
  <para style="q" vid="PSA 105:30">मेंढक ही मेंढक भर गए।<verse eid="PSA 105:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31"/>उसने हुक्म दिया, और मच्छरों के ग़ोल आए,</para>
  <para style="q" vid="PSA 105:31">और उनकी सब हदों में जूएं आ गई<verse eid="PSA 105:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32"/>उसने उन पर मेंह की जगह ओले बरसाए,</para>
  <para style="q" vid="PSA 105:32">और उनके मुल्क पर दहकती आग नाज़िल की।<verse eid="PSA 105:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33"/>उसने उनके अँगूर और अंजीर के दरख़तों को भी बर्बाद कर डाला,</para>
  <para style="q" vid="PSA 105:33">और उनकी हद के पेड़ तोड़ डाले।<verse eid="PSA 105:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34"/>उसने हुक्म दिया तो बेशुमार टिड्डियाँऔर कीड़े आ गए,<verse eid="PSA 105:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35"/>और उनके मुल्क की तमाम चीज़े चट कर गए,</para>
  <para style="q" vid="PSA 105:35">और उनकी ज़मीन की पैदावार खा गए।<verse eid="PSA 105:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36"/>उसने उनके मुल्क के सब पहलौठों को भी मार डाला,</para>
  <para style="q" vid="PSA 105:36">जो उनकी पूरी ताक़त के पहले फल थे।<verse eid="PSA 105:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37"/>और इस्राईल को चाँदी और सोने के साथ निकाल लाया,</para>
  <para style="q" vid="PSA 105:37">और उसके क़बीलों में एक भी कमज़ोर आदमी न था।<verse eid="PSA 105:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38"/>उनके चले जाने से मिस्र खु़श हो गया,</para>
  <para style="q" vid="PSA 105:38">क्यूँकि उनका ख़ौफ़ मिस्रियों पर छा गया था।<verse eid="PSA 105:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39"/>उसने बादल को सायबान होने के लिए फैला दिया,</para>
  <para style="q" vid="PSA 105:39">और रात को रोशनी के लिए आग दी।<verse eid="PSA 105:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40"/>उनके माँगने पर उसने बटेरें भेजीं,</para>
  <para style="q" vid="PSA 105:40">और उनको आसमानी रोटी से सेर किया।<verse eid="PSA 105:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41"/>उसने चट्टान को चीरा, और पानी फूट निकलाः</para>
  <para style="q" vid="PSA 105:41">और ख़ुश्क ज़मीन पर नदी की तरह बहने लगा।<verse eid="PSA 105:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42"/>क्यूँकि उसने अपने पाक क़ौल को,</para>
  <para style="q" vid="PSA 105:42">और अपने बन्दे अब्रहाम को याद किया।<verse eid="PSA 105:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43"/>और वह अपनी क़ौम को ख़ुशी के साथ,</para>
  <para style="q" vid="PSA 105:43">और अपने बरगुज़ीदों को हम्द गाते हुए निकाल लाया।<verse eid="PSA 105:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44"/>और उसने उनको क़ौमों के मुल्क दिए,</para>
  <para style="q" vid="PSA 105:44">और उन्होंने उम्मतों की मेहनत के फल पर कब्ज़ा किया।<verse eid="PSA 105:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45"/>ताकि वह उसके क़ानून पर चलें,</para>
  <para style="q" vid="PSA 105:45">और उसकी शरी'अत को मानें। ख़ुदावन्द की हम्द करो!<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1"/>ख़ुदावन्द की हम्द करो, ख़ुदावन्द का शुक्र करो, क्यूँकि वह भला है;</para>
  <para style="q" vid="PSA 106:1">और उसकी शफ़क़त हमेशा की है!<verse eid="PSA 106:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2"/>कौन ख़ुदावन्द की कु़दरत के कामों काबयान कर सकता है,</para>
  <para style="q" vid="PSA 106:2">या उसकी पूरी सिताइश सुना सकता है?<verse eid="PSA 106:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3"/>मुबारक हैं वह जो 'अद्ल करते हैं,</para>
  <para style="q" vid="PSA 106:3">और वह जो हर वक़्त सदाक़त के काम करता है।<verse eid="PSA 106:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4"/>ऐ ख़ुदावन्द, उस करम से जो तू अपने लोगों पर करता है मुझे याद कर,</para>
  <para style="q" vid="PSA 106:4">अपनी नजात मुझे इनायत फ़रमा,<verse eid="PSA 106:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5"/>ताकि मैं तेरे बरगुज़ीदों की इक़बालमंदी देखें</para>
  <para style="q" vid="PSA 106:5">और तेरी क़ौम की ख़ुशी में ख़ुश रहूँ।</para>
  <para style="q" vid="PSA 106:5">और तेरी मीरास के लोगों के साथ फ़ख़्र करूँ।<verse eid="PSA 106:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6"/>हम ने और हमारे बाप दादा ने गुनाह किया;</para>
  <para style="q" vid="PSA 106:6">हम ने बदकारी की, हम ने शरारत के काम किए!<verse eid="PSA 106:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7"/>हमारे बाप — दादा मिस्र में तेरे 'अजायब न समझे;</para>
  <para style="q" vid="PSA 106:7">उन्होंने तेरी शफ़क़त की कसरत को याद न किया;</para>
  <para style="q" vid="PSA 106:7">बल्कि समन्दर पर या'नी बहर — ए — कु़लजु़म पर बाग़ी हुए।<verse eid="PSA 106:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8"/>तोभी उसने उनको अपने नाम की ख़ातिर बचाया,</para>
  <para style="q" vid="PSA 106:8">ताकि अपनी कु़दरत ज़ाहिर करे<verse eid="PSA 106:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9"/>उसने बहर — ए — कु़लजु़म को डाँटा और वह सूख गया।</para>
  <para style="q" vid="PSA 106:9">वह उनकी गहराव में से ऐसे निकाल ले गया जैसे वीरान में से,<verse eid="PSA 106:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10"/>और उसने उनको 'अदावत रखने वाले के हाथ से बचाया,</para>
  <para style="q" vid="PSA 106:10">और दुश्मन के हाथ से छुड़ाया।<verse eid="PSA 106:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11"/>समन्दर ने उनके मुख़ालिफ़ों को छिपा लियाः</para>
  <para style="q" vid="PSA 106:11">उनमें से एक भी न बचा।<verse eid="PSA 106:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12"/>तब उन्होंने उसके क़ौल का यक़ीन किया;</para>
  <para style="q" vid="PSA 106:12">और उसकी मदहसराई करने लगे।<verse eid="PSA 106:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13"/>फिर वह जल्द उसके कामों को भूल गए,</para>
  <para style="q" vid="PSA 106:13">और उसकी मश्वरत का इन्तिज़ार न किया।<verse eid="PSA 106:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14"/>बल्कि वीरान में बड़ी हिर्स की,</para>
  <para style="q" vid="PSA 106:14">और सेहरा में ख़ुदा को आज़माया।<verse eid="PSA 106:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15"/>फिर उसने उनकी मुराद तो पूरी कर दी,</para>
  <para style="q" vid="PSA 106:15">लेकिन उनकी जान को सुखा दिया।<verse eid="PSA 106:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16"/>उन्होंने ख़ेमागाह में मूसा पर,</para>
  <para style="q" vid="PSA 106:16">और ख़ुदावन्द के पाक मर्द हारून पर हसद किया।<verse eid="PSA 106:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17"/>फिर ज़मीन फटी और दातन को निगल गई,</para>
  <para style="q" vid="PSA 106:17">और अबीराम की जमा'अत को खा गई,<verse eid="PSA 106:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18"/>और उनके जत्थे में आग भड़क उठी,</para>
  <para style="q" vid="PSA 106:18">और शो'लों ने शरीरों को भसम कर दिया।<verse eid="PSA 106:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19"/>उन्होंने होरिब में एक बछड़ा बनाया,</para>
  <para style="q" vid="PSA 106:19">और ढाली हुई मूरत को सिज्दा किया।<verse eid="PSA 106:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20"/>यूँ उन्होंने ख़ुदा के जलाल को,</para>
  <para style="q" vid="PSA 106:20">घास खाने वाले बैल की शक्ल से बदल दिया।<verse eid="PSA 106:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21"/>वह अपने मुनज्जी ख़ुदा को भूल गए,</para>
  <para style="q" vid="PSA 106:21">जिसने मिस्र में बड़े बड़े काम किए,<verse eid="PSA 106:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22"/>और हाम की सरज़मीन में 'अजायब,</para>
  <para style="q" vid="PSA 106:22">और बहर — ए — कु़लजु़म पर दहशत अंगेज़ काम किए।<verse eid="PSA 106:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23"/>इसलिए उसने फ़रमाया, मैं उनको हलाक कर डालता,</para>
  <para style="q" vid="PSA 106:23">अगर मेरा बरगुज़ीदा मूसा मेरे सामने बीच में न आता कि मेरे क़हर को टाल दे,</para>
  <para style="q" vid="PSA 106:23">ऐसा न हो कि मैं उनको हलाक करूँ।<verse eid="PSA 106:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24"/>और उन्होंने उस सुहाने मुल्क को हक़ीर जाना,</para>
  <para style="q" vid="PSA 106:24">और उसके क़ौल का यक़ीन न किया।<verse eid="PSA 106:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25"/>बल्कि वह अपने डेरों में बड़बड़ाए,</para>
  <para style="q" vid="PSA 106:25">और ख़ुदावन्द की बात न मानी।<verse eid="PSA 106:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26"/>तब उसने उनके ख़िलाफ़ क़सम खाई कि</para>
  <para style="q" vid="PSA 106:26">मैं उनको वीरान में पस्त करूँगा,<verse eid="PSA 106:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27"/>और उनकी नसल की क़ौमों के बीच</para>
  <para style="q" vid="PSA 106:27">और उनको मुल्क मुल्क में तितर बितर करूँगा।<verse eid="PSA 106:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28"/>वह बा'ल फ़गू़र को पूजने लगे,</para>
  <para style="q" vid="PSA 106:28">और बुतों की कु़र्बानियाँ खाने लगे।<verse eid="PSA 106:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29"/>यूँ उन्होंने अपने आ'माल से उसको ना ख़ुश किया,</para>
  <para style="q" vid="PSA 106:29">और वबा उनमें फूट निकली।<verse eid="PSA 106:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30"/>तब फ़ीन्हास उठा और बीच में आया,</para>
  <para style="q" vid="PSA 106:30">और वबा रुक गई।<verse eid="PSA 106:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31"/>और यह काम उसके हक़ में नसल दर नसल,</para>
  <para style="q" vid="PSA 106:31">हमेशा के लिए रास्तबाज़ी गिना गया।<verse eid="PSA 106:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32"/>उन्होंने उसकी मरीबा के चश्मे पर भी नाख़ुश किया,</para>
  <para style="q" vid="PSA 106:32">और उनकी ख़ातिर मूसा को नुक़सान पहुँचा;<verse eid="PSA 106:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33"/>इसलिए कि उन्होंने उसकी रूह से सरकशी की,</para>
  <para style="q" vid="PSA 106:33">और मूसा बे सोचे बोल उठा।<verse eid="PSA 106:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34"/>उन्होंने उन क़ौमों को हलाक न किया,</para>
  <para style="q" vid="PSA 106:34">जैसा ख़ुदावन्द ने उनको हुक्म दिया था,<verse eid="PSA 106:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35"/>बल्कि उन कौमों के साथ मिल गए,</para>
  <para style="q" vid="PSA 106:35">और उनके से काम सीख गए;<verse eid="PSA 106:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36"/>और उनके बुतों की परस्तिश करने लगे,</para>
  <para style="q" vid="PSA 106:36">जो उनके लिए फंदा बन गए।<verse eid="PSA 106:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37"/>बल्कि उन्होंने अपने बेटे बेटियों को,</para>
  <para style="q" vid="PSA 106:37">शयातीन के लिए कु़र्बान किया:<verse eid="PSA 106:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38"/>और मासूमों का या'नी अपने बेटे बेटियों का खू़न बहाया,</para>
  <para style="q" vid="PSA 106:38">जिनको उन्होंने कनान के बुतों के लिए कु़र्बान कर दियाः</para>
  <para style="q" vid="PSA 106:38">और मुल्क खू़न से नापाक हो गया।<verse eid="PSA 106:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39"/>यूँ वह अपने ही कामों से आलूदा हो गए,</para>
  <para style="q" vid="PSA 106:39">और अपने फ़े'लों से बेवफ़ा बने।<verse eid="PSA 106:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40"/>इसलिए ख़ुदावन्द का क़हर अपने लोगों पर भड़का,</para>
  <para style="q" vid="PSA 106:40">और उसे अपनी मीरास से नफ़रत हो गई;<verse eid="PSA 106:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41"/>और उसने उनकी क़ौमों के क़ब्ज़े में कर दिया,</para>
  <para style="q" vid="PSA 106:41">और उनसे 'अदावत रखने वाले उन पर हुक्मरान हो गए।<verse eid="PSA 106:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42"/>उनके दुशमनों ने उन पर ज़ुल्म किया,</para>
  <para style="q" vid="PSA 106:42">और वह उनके महकूम हो गए।<verse eid="PSA 106:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43"/>उसने तो बारहा उनको छुड़ाया,</para>
  <para style="q" vid="PSA 106:43">लेकिन उनका मश्वरा बग़ावत वाला ही रहा</para>
  <para style="q" vid="PSA 106:43">और वह अपनी बदकारी के वजह से पस्त हो गए।<verse eid="PSA 106:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44"/>तोभी जब उसने उनकी फ़रियाद सुनी,</para>
  <para style="q" vid="PSA 106:44">तो उनके दुख पर नज़र की।<verse eid="PSA 106:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45"/>और उसने उनके हक़ में अपने 'अहद को याद किया,</para>
  <para style="q" vid="PSA 106:45">और अपनी शफ़क़त की कसरत के मुताबिक़ तरस खाया।<verse eid="PSA 106:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46"/>उसने उनकी ग़ुलाम करने वालों के दिलमें उनके लिए रहम डाला।<verse eid="PSA 106:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47"/>ऐ ख़ुदावन्द, हमारे ख़ुदा! हम को बचा ले,</para>
  <para style="q" vid="PSA 106:47">और हम को क़ौमों में से इकट्ठा कर ले,</para>
  <para style="q" vid="PSA 106:47">ताकि हम तेरे पाक नाम का शुक्र करें,</para>
  <para style="q" vid="PSA 106:47">और ललकारते हुए तेरी सिताइश करें।<verse eid="PSA 106:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48"/>ख़ुदावन्द इस्राईल का ख़ुदा,</para>
  <para style="q" vid="PSA 106:48">इब्तिदा से हमेशा तक मुबारक हो!</para>
  <para style="q" vid="PSA 106:48">ख़ुदावन्द की हम्द करो।<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">पांचवी किताब</para>
  <para style="mr">(<ref loc="PSA 107:-1-150">ज़बूर 107-150</ref>)</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1"/>ख़ुदा का शुक्र करो, क्यूँकि वह भला है;</para>
  <para style="q" vid="PSA 107:1">और उसकी शफ़क़त हमेशा की है!<verse eid="PSA 107:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2"/>ख़ुदावन्द के छुड़ाए हुए यही कहें,</para>
  <para style="q" vid="PSA 107:2">जिनको फ़िदिया देकर मुख़ालिफ़ के हाथ से छुड़ा लिया,<verse eid="PSA 107:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3"/>और उनको मुल्क — मुल्क से जमा' किया;</para>
  <para style="q" vid="PSA 107:3">पूरब से और पच्छिम से, उत्तर से और दक्खिन से।<verse eid="PSA 107:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4"/>वह वीरान में सेहरा के रास्ते पर भटकते फिरे;</para>
  <para style="q" vid="PSA 107:4">उनको बसने के लिए कोई शहर न मिला।<verse eid="PSA 107:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5"/>वह भूके और प्यासे थे,</para>
  <para style="q" vid="PSA 107:5">और उनका दिल बैठा जाता था।<verse eid="PSA 107:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6"/>तब अपनी मुसीबत में उन्होंने ख़ुदावन्द से फ़रियाद की,</para>
  <para style="q" vid="PSA 107:6">और उसने उनको उनके दुखों से रिहाई बख़्शी।<verse eid="PSA 107:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7"/>वह उनको सीधी राह से ले गया,</para>
  <para style="q" vid="PSA 107:7">ताकि बसने के लिए किसी शहर में जा पहुँचें।<verse eid="PSA 107:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8"/>काश के लोग ख़ुदावन्द की शफ़क़त की ख़ातिर,</para>
  <para style="q" vid="PSA 107:8">और बनी आदम के लिए उसके 'अजायब की ख़ातिर उसकी सिताइश करते।<verse eid="PSA 107:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9"/>क्यूँकि वह तरसती जान को सेर करता है,</para>
  <para style="q" vid="PSA 107:9">और भूकी जान को ने 'मतों से मालामाल करता है।<verse eid="PSA 107:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10"/>जो अंधेरे और मौत के साये में बैठे,</para>
  <para style="q" vid="PSA 107:10">मुसीबत और लोहे से जकड़े हुएथे;<verse eid="PSA 107:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11"/>चूँके उन्होंने ख़ुदा के कलाम से सरकशी की</para>
  <para style="q" vid="PSA 107:11">और हक़ ता'ला की मश्वरत को हक़ीर जाना।<verse eid="PSA 107:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12"/>इसलिए उसने उनका दिल मशक़्क़त से'आजिज़ कर दिया;</para>
  <para style="q" vid="PSA 107:12">वह गिर पड़े और कोई मददगार न था।<verse eid="PSA 107:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13"/>तब अपनी मुसीबत में उन्होंने ख़ुदावन्द से फ़रियाद की,</para>
  <para style="q" vid="PSA 107:13">और उसने उनको उनके दुखों से रिहाई बख़्शी।<verse eid="PSA 107:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14"/>वह उनको अंधेरे और मौत के साये से निकाल लाया,</para>
  <para style="q" vid="PSA 107:14">और उनके बंधन तोड़ डाले।<verse eid="PSA 107:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15"/>काश के लोग ख़ुदावन्द की शफ़क़त की खातिर,</para>
  <para style="q" vid="PSA 107:15">और बनी आदम के लिए उसके 'अजायब की ख़ातिर उसकी सिताइश करते!<verse eid="PSA 107:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16"/>क्यूँकि उसने पीतल के फाटक तोड़ दिए,</para>
  <para style="q" vid="PSA 107:16">और लोहे के बेण्डों को काट डाला।<verse eid="PSA 107:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17"/>बेवक़ूफ़ अपनी ख़ताओं की वजह से,</para>
  <para style="q" vid="PSA 107:17">और अपनी बदकारी के ज़रिए' मुसीबत में पड़ते हैं।<verse eid="PSA 107:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18"/>उनके जी को हर तरह के खाने से नफ़रत हो जाती है,</para>
  <para style="q" vid="PSA 107:18">और वह मौत के फाटकों के नज़दीक पहुँच जाते हैं।<verse eid="PSA 107:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19"/>तब वह अपनी मुसीबत में ख़ुदावन्द से फ़रियाद करते है</para>
  <para style="q" vid="PSA 107:19">और वह उनको उनके दुखों से रिहाई बख़्शता है।<verse eid="PSA 107:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20"/>वह अपना कलाम नाज़िल फ़रमा कर उनको शिफ़ा देता है,</para>
  <para style="q" vid="PSA 107:20">और उनको उनकी हलाकत से रिहाई बख्शता है।<verse eid="PSA 107:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21"/>काश के लोग ख़ुदावन्द की शफ़क़त की खातिर,</para>
  <para style="q" vid="PSA 107:21">और बनी आदम के लिए उसके 'अजायब की ख़ातिर उसकी सिताइश करते!<verse eid="PSA 107:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22"/>वह शुक्रगुज़ारी की क़ुर्बानियाँ पेश करें,</para>
  <para style="q" vid="PSA 107:22">और गाते हुए उसके कामों को बयान करें।<verse eid="PSA 107:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23"/>जो लोग जहाज़ों में बहर पर जाते हैं,</para>
  <para style="q" vid="PSA 107:23">और समन्दर पर कारोबार में लगे रहते हैं;<verse eid="PSA 107:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24"/>वह समन्दर में ख़ुदावन्द के कामों को,</para>
  <para style="q" vid="PSA 107:24">और उसके 'अजायब को देखते हैं।<verse eid="PSA 107:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25"/>क्यूँकि वह हुक्म देकर तुफ़ानी हवा चलाता जो उसमें लहरें उठाती है।<verse eid="PSA 107:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26"/>वह आसमान तक चढ़ते और गहराओ में उतरते हैं;</para>
  <para style="q" vid="PSA 107:26">परेशानी से उनका दिल पानी पानी हो जाता है;<verse eid="PSA 107:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27"/>वह झूमते और मतवाले की तरह लड़खड़ाते,</para>
  <para style="q" vid="PSA 107:27">और बदहवास हो जाते हैं।<verse eid="PSA 107:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28"/>तब वह अपनी मुसीबत में ख़ुदावन्द से फ़रियाद करते है</para>
  <para style="q" vid="PSA 107:28">और वह उनको उनके दुखों से रिहाई बख़्शता है।<verse eid="PSA 107:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29"/>वह आँधी को थमा देता है, और लहरें ख़त्म हो जाती हैं।<verse eid="PSA 107:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30"/>तब वह उसके थम जाने से ख़ुश होते हैं,</para>
  <para style="q" vid="PSA 107:30">यूँ वह उनको बन्दरगाह — ए — मक़सूद तक पहुँचा देता है।<verse eid="PSA 107:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31"/>काश के लोग ख़ुदावन्द की शफ़क़त की खातिर,</para>
  <para style="q" vid="PSA 107:31">और बनी आदम के लिए उसके 'अजायब की ख़ातिर उसकी सिताइश करते!<verse eid="PSA 107:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32"/>वह लोगों के मजमे' में उसकी बड़ाई करें,</para>
  <para style="q" vid="PSA 107:32">और बुज़ुगों की मजलिस में उसकी हम्द।<verse eid="PSA 107:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33"/>वह दरियाओं को वीरान बना देता है,</para>
  <para style="q" vid="PSA 107:33">और पानी के चश्मों को ख़ुश्क ज़मीन।<verse eid="PSA 107:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34"/>वह ज़रखेज़ ज़मीन की सैहरा — ए — शोर कर देता है,</para>
  <para style="q" vid="PSA 107:34">इसलिए कि उसके बाशिंदे शरीर हैं।<verse eid="PSA 107:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35"/>वह वीरान की झील बना देता है,</para>
  <para style="q" vid="PSA 107:35">और ख़ुश्क ज़मीन को पानी के चश्मे।<verse eid="PSA 107:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36"/>वहाँ वह भूकों को बसाता है,</para>
  <para style="q" vid="PSA 107:36">ताकि बसने के लिए शहर तैयार करें;<verse eid="PSA 107:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37"/>और खेत बोएँ, और ताकिस्तान लगाएँ,</para>
  <para style="q" vid="PSA 107:37">और पैदावार हासिल करें।<verse eid="PSA 107:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38"/>वह उनको बरकत देता है, और वह बहुत बढ़ते हैं,</para>
  <para style="q" vid="PSA 107:38">और वह उनके चौपायों को कम नहीं होने देता।<verse eid="PSA 107:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39"/>फिर ज़ुल्म — ओ — तकलीफ़ और ग़म के मारे,</para>
  <para style="q" vid="PSA 107:39">वह घट जाते और पस्त हो जाते हैं,<verse eid="PSA 107:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40"/>वह उमरा पर ज़िल्लत उंडेल देता है,</para>
  <para style="q" vid="PSA 107:40">और उनको बेराह वीराने में भटकाता है।<verse eid="PSA 107:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41"/>तोभी वह मोहताज को मुसीबत से निकालकर सरफ़राज़ करता है,</para>
  <para style="q" vid="PSA 107:41">और उसके ख़ान्दान को रेवड़ की तरह बढ़ाता है।<verse eid="PSA 107:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42"/>रास्तबाज़ यह देखकर ख़ुश होंगे;</para>
  <para style="q" vid="PSA 107:42">और सब बदकारों का मुँह बन्द हो जाएगा।<verse eid="PSA 107:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43"/>'अक्लमंद इन बातों पर तवज्जुह करेगा,</para>
  <para style="q" vid="PSA 107:43">और वह ख़ुदावन्द की शफ़क़त पर ग़ौर करेंगे।<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 108:1"/>ऐ ख़ुदा, मेरा दिल क़ाईम है;</para>
  <para style="q" vid="PSA 108:1">मैं गाऊँगा और दिल से मदहसराई करूँगा।<verse eid="PSA 108:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 108:2"/>ऐ बरबत और सितार जागो!</para>
  <para style="q" vid="PSA 108:2">मैं ख़ुद भी सुबह सवेरे जाग उठूँगा।<verse eid="PSA 108:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 108:3"/>ऐ ख़ुदावन्द, मैं लोगों में तेरा शुक्र करूँगा,</para>
  <para style="q" vid="PSA 108:3">मैं उम्मतों में तेरी मदहसराई करूँगा।<verse eid="PSA 108:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 108:4"/>क्यूँकि तेरी शफ़क़त आसमान से बुलन्द है,</para>
  <para style="q" vid="PSA 108:4">और तेरी सच्चाई आसमानों के बराबर है।<verse eid="PSA 108:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 108:5"/>ऐ ख़ुदा, तू आसमानों पर सरफ़राज़ हो!</para>
  <para style="q" vid="PSA 108:5">और तेरा जलाल सारी ज़मीन पर हो<verse eid="PSA 108:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 108:6"/>अपने दहने हाथ से बचा और हमें जवाब दे,</para>
  <para style="q" vid="PSA 108:6">ताकि तेरे महबूब बचाए जाएँ।<verse eid="PSA 108:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 108:7"/>ख़ुदा ने अपनी पाकिज़गी में यह फ़रमाया है “मैं खु़शी करूँगा,</para>
  <para style="q" vid="PSA 108:7">मैं सिकम को तक़्सीम करूँगा और सुकात की वादी को बाटुँगा।<verse eid="PSA 108:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 108:8"/>जिल'आद मेरा है, मनस्सी मेरा है;</para>
  <para style="q" vid="PSA 108:8">इफ़्राईम मेरे सिर का खू़द है; यहूदाह मेरा 'असा है।<verse eid="PSA 108:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 108:9"/>मोआब मेरी चिलपची है, अदोम पर मैं जूता फेकूँगा,</para>
  <para style="q" vid="PSA 108:9">मैं फ़िलिस्तीन पर ललकारूँगा।”<verse eid="PSA 108:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 108:10"/>मुझे उस फ़सीलदार शहर में कौन पहुँचाएगा?</para>
  <para style="q" vid="PSA 108:10">कौन मुझे अदोम तक ले गया है?<verse eid="PSA 108:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 108:11"/>ऐ ख़ुदा, क्या तूने हमें रद्द नहीं कर दिया?</para>
  <para style="q" vid="PSA 108:11">ऐ ख़ुदा, तू हमारे लश्करों के साथ नहीं जाता।<verse eid="PSA 108:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 108:12"/>मुख़ालिफ़ के मुक़ाबिले में हमारी मदद कर,</para>
  <para style="q" vid="PSA 108:12">क्यूँकि इंसानी मदद 'बेकार है।<verse eid="PSA 108:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 108:13"/>ख़ुदा की बदौलत हम दिलावरी करेगी;</para>
  <para style="q" vid="PSA 108:13">क्यूँकि वही हमारे मुख़ालिफ़ों को पामाल करेगा।<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 109:1"/>ऐ ख़ुदा मेरे महमूद ख़ामोश न रह!<verse eid="PSA 109:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2"/>क्यूँकि शरीरों और दग़ाबाज़ों ने मेरे ख़िलाफ़ मुँह खोला है,</para>
  <para style="q" vid="PSA 109:2">उन्होंने झूठी ज़बान से मुझ से बातें की हैं।<verse eid="PSA 109:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3"/>उन्होंने 'अदावत की बातों से मुझे घेर लिया,</para>
  <para style="q" vid="PSA 109:3">और बे वजह मुझ से लड़े हैं।<verse eid="PSA 109:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4"/>वह मेरी मुहब्बत की वजह से मेरे मुख़ालिफ़ हैं,</para>
  <para style="q" vid="PSA 109:4">लेकिन मैं तो बस दुआ करता हूँ।<verse eid="PSA 109:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5"/>उन्होंने नेकी के बदले मुझ से बदी की है,</para>
  <para style="q" vid="PSA 109:5">और मेरी मुहब्बत के बदले' अदावत।<verse eid="PSA 109:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6"/>तू किसी शरीर आदमी को उस पर मुक़र्रर कर दे</para>
  <para style="q" vid="PSA 109:6">और कोई मुख़ालिफ़ उनके दहने हाथ खड़ा रहे<verse eid="PSA 109:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7"/>जब उसकी 'अदालत हो तो वह मुजरिम ठहरे,</para>
  <para style="q" vid="PSA 109:7">और उसकी दुआ भी गुनाह गिनी जाए!<verse eid="PSA 109:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8"/>उसकी उम्र कोताह हो जाए,</para>
  <para style="q" vid="PSA 109:8">और उसका मन्सब कोई दूसरा ले ले!<verse eid="PSA 109:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9"/>उसके बच्चे यतीम हो जाएँ,</para>
  <para style="q" vid="PSA 109:9">और उसकी बीवी बेवा हो जाए!<verse eid="PSA 109:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10"/>उसके बच्चे आवारा होकर भीक माँगे;</para>
  <para style="q" vid="PSA 109:10">उनको अपने वीरान मकामों से दूर जाकर टुकड़े माँगना पड़ें!<verse eid="PSA 109:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11"/>क़र्ज़ के तलबगार उसका सब कुछ छीन ले,</para>
  <para style="q" vid="PSA 109:11">और परदेसी उसकी कमाई लूट लें।<verse eid="PSA 109:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12"/>कोई न हो जो उस पर शफ़क़त करे,</para>
  <para style="q" vid="PSA 109:12">न कोई उसके यतीम बच्चों पर तरस खाए!<verse eid="PSA 109:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13"/>उसकी नसल कट जाए,</para>
  <para style="q" vid="PSA 109:13">और दूसरी नसल में उनका नाम मिटा दिया जाए!<verse eid="PSA 109:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14"/>उसके बाप — दादा की बदी ख़ुदावन्द के सामने याद रहे,</para>
  <para style="q" vid="PSA 109:14">और उसकी माँ का गुनाह मिटाया न जाए!<verse eid="PSA 109:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15"/>वह बराबर ख़ुदावन्द के सामने रहें,</para>
  <para style="q" vid="PSA 109:15">ताकि वह ज़मीन पर से उनका ज़िक्र मिटा दे!<verse eid="PSA 109:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16"/>इसलिए कि उसने रहम करना याद नरख्खा,</para>
  <para style="q" vid="PSA 109:16">लेकिन ग़रीब और मुहताज और शिकस्तादिल को सताया,</para>
  <para style="q" vid="PSA 109:16">ताकि उनको मार डाले।<verse eid="PSA 109:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17"/>बल्कि ला'नत करना उसे पसंद था,</para>
  <para style="q" vid="PSA 109:17">इसलिए वही उस पर आ पड़ी;</para>
  <para style="q" vid="PSA 109:17">और दुआ देना उसे पसन्द न था,</para>
  <para style="q" vid="PSA 109:17">इसलिए वह उससे दूर रही<verse eid="PSA 109:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18"/>उसने ला'नत को अपनी पोशाक की तरह पहना,</para>
  <para style="q" vid="PSA 109:18">और वह पानी की तरह उसके बातिन में,</para>
  <para style="q" vid="PSA 109:18">और तेल की तरह उसकी हड़िडयों में समा गई।<verse eid="PSA 109:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19"/>वह उसके लिए उस पोशाक की तरह हो जिसे वह पहनता है,</para>
  <para style="q" vid="PSA 109:19">और उस पटके की जगह, जिससे वह अपनी कमर कसे रहता है।<verse eid="PSA 109:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20"/>ख़ुदावन्द की तरफ़ से मेरे मुख़ालिफ़ों का,</para>
  <para style="q" vid="PSA 109:20">और मेरी जान को बुरा कहने वालों का यही बदला है!<verse eid="PSA 109:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21"/>लेकिन ऐ मालिक ख़ुदावन्द,</para>
  <para style="q" vid="PSA 109:21">अपने नाम की ख़ातिर मुझ पर एहसान कर;</para>
  <para style="q" vid="PSA 109:21">मुझे छुड़ा क्यूँकि तेरी शफ़क़त खू़ब है!<verse eid="PSA 109:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22"/>इसलिए कि मैं ग़रीब और मुहताज हूँ,</para>
  <para style="q" vid="PSA 109:22">और मेरा दिल मेरे पहलू में ज़ख़्मी है।<verse eid="PSA 109:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23"/>मैं ढलते साये की तरह जाता रहा;</para>
  <para style="q" vid="PSA 109:23">मैंटिड्डी की तरह उड़ा दिया गया।<verse eid="PSA 109:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24"/>फ़ाक़ा करते करते मेरे घुटने कमज़ोर हो गए,</para>
  <para style="q" vid="PSA 109:24">और चिकनाई की कमी से मेरा जिस्म सूख गया।<verse eid="PSA 109:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25"/>मैं उनकी मलामत का निशाना बन गया हूँ</para>
  <para style="q" vid="PSA 109:25">जब वह मुझे देखते हैं तो सिर हिलाते हैं।<verse eid="PSA 109:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26"/>ऐ ख़ुदावन्द मेरे ख़ुदा, मेरी मदद कर!</para>
  <para style="q" vid="PSA 109:26">अपनी शफ़क़त के मुताबिक़ मुझे बचा ले।<verse eid="PSA 109:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27"/>ताकि वह जान लें कि इसमें तेरा हाथ है,</para>
  <para style="q" vid="PSA 109:27">और तू ही ने ऐ ख़ुदावन्द, यह किया है!<verse eid="PSA 109:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28"/>वह ला'नत करते रहें, लेकिन तू बरकत दे!</para>
  <para style="q" vid="PSA 109:28">वह जब उठेगे तो शर्मिन्दा होंगे, लेकिन तेरा बन्दा ख़ुश होगा!<verse eid="PSA 109:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29"/>मेरे मुख़ालिफ़ ज़िल्लत से मुलब्बस हो जाएँ</para>
  <para style="q" vid="PSA 109:29">और अपनी ही शर्मिन्दगी की चादर की तरह ओढ़ लें।<verse eid="PSA 109:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30"/>मैं अपने मुँह से ख़ुदावन्द का बड़ा शुक्र करूँगा,</para>
  <para style="q" vid="PSA 109:30">बल्कि बड़ी भीड़ में उसकी हम्द करूँगा।<verse eid="PSA 109:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31"/>क्यूँकि वह मोहताज के दहने हाथ खड़ा होगा,</para>
  <para style="q" vid="PSA 109:31">ताकि उसकी जान पर फ़तवा देने वालों से उसे रिहाई दे।<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 110:1"/>यहोवा ने मेरे ख़ुदावन्द से कहा,</para>
  <para style="q" vid="PSA 110:1">“जब तक कि मैं तेरे दुश्मनों को तेरे पाँव की चौकी न कर दूँ।”<verse eid="PSA 110:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2"/>ख़ुदावन्द तेरे ज़ोर का 'असा सिय्यून से भेजेगा।</para>
  <para style="q" vid="PSA 110:2">तू अपने दुश्मनों में हुक्मरानी कर।<verse eid="PSA 110:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3"/>लश्करकशी के दिन तेरे लोग ख़ुशी से अपने आप को पेश करते हैं;</para>
  <para style="q" vid="PSA 110:3">तेरे जवान पाक आराइश में हैं,</para>
  <para style="q" vid="PSA 110:3">और सुबह के बत्न से शबनम की तरह।<verse eid="PSA 110:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4"/>ख़ुदावन्द ने क़सम खाई है और फिरेगा नहीं,</para>
  <para style="q" vid="PSA 110:4">“तू मलिक — ए — सिद्क के तौर पर हमेशा तक काहिन है।”<verse eid="PSA 110:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5"/>ख़ुदावन्द तेरे दहने हाथ पर</para>
  <para style="q" vid="PSA 110:5">अपने कहर के दिन बादशाहों को छेद डालेगा।<verse eid="PSA 110:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6"/>वह क़ौमों में 'अदालत करेगा,</para>
  <para style="q" vid="PSA 110:6">वह लाशों के ढेर लगा देगा; और बहुत से मुल्कों में सिरों को कुचलेगा।<verse eid="PSA 110:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7"/>वह राह में नदी का पानी पिएगा;</para>
  <para style="q" vid="PSA 110:7">इसलिए वह सिर को बुलन्द करेगा।<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1"/>ख़ुदावन्द की हम्द करो! मैं रास्तबाज़ों की मजलिस में और जमा'अत में,</para>
  <para style="q" vid="PSA 111:1">अपने सारे दिल से ख़ुदावन्द का शुक्र करूँगा।<verse eid="PSA 111:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2"/>ख़ुदावन्द के काम 'अज़ीम हैं,</para>
  <para style="q" vid="PSA 111:2">जो उनमें मसरूर हैं उनकी तलाश। में रहते हैं।<verse eid="PSA 111:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3"/>उसके काम जलाली और पुर हश्मत हैं,</para>
  <para style="q" vid="PSA 111:3">और उसकी सदाकत हमेशा तक क़ाईम है।<verse eid="PSA 111:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4"/>उसने अपने 'अजायब की यादगार क़ाईम की है;</para>
  <para style="q" vid="PSA 111:4">ख़ुदावन्द रहीम — ओ — करीम है।<verse eid="PSA 111:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5"/>वह उनको जो उससे डरते हैं खू़राक देता है;</para>
  <para style="q" vid="PSA 111:5">वह अपने 'अहद को हमेशा याद रख्खेगा।<verse eid="PSA 111:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6"/>उसने कौमों की मीरास अपने लोगों को देकर,</para>
  <para style="q" vid="PSA 111:6">अपने कामों का ज़ोर उनकी दिखाया।<verse eid="PSA 111:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7"/>उसके हाथों के काम बरहक़ और इन्साफ भरे हैं;</para>
  <para style="q" vid="PSA 111:7">उसके तमाम क़वानीन रास्त है,<verse eid="PSA 111:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8"/>वह हमेशा से हमेशा तक क़ाईम रहेंगे,</para>
  <para style="q" vid="PSA 111:8">वह सच्चाई और रास्ती से बनाए गए हैं।<verse eid="PSA 111:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9"/>उसने अपने लोगों के लिए फ़िदिया दिया;</para>
  <para style="q" vid="PSA 111:9">उसने अपना 'अहद हमेशा के लिए ठहराया है।</para>
  <para style="q" vid="PSA 111:9">उसका नाम पाक और बड़ा है।<verse eid="PSA 111:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10"/>ख़ुदावन्द का ख़ौफ़ समझ का शुरू' है;</para>
  <para style="q" vid="PSA 111:10">उसके मुताबिक 'अमल करने वाले अक़्लमंद हैं।</para>
  <para style="q" vid="PSA 111:10">उसकी सिताइश हमेशा तक क़ाईम है।<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1"/>ख़ुदावन्द की हम्द करो!</para>
  <para style="q" vid="PSA 112:1">मुबारक है वह आदमी जो ख़ुदावन्द से डरता है,</para>
  <para style="q" vid="PSA 112:1">और उसके हुक्मों में खू़ब मसरूर रहता है!<verse eid="PSA 112:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2"/>उसकी नसल ज़मीन पर ताक़तवर होगी;</para>
  <para style="q" vid="PSA 112:2">रास्तबाज़ों की औलाद मुबारक होगी।<verse eid="PSA 112:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3"/>माल — ओ — दौलत उसके घर में है;</para>
  <para style="q" vid="PSA 112:3">और उसकी सदाकत हमेशा तक क़ाईम है।<verse eid="PSA 112:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4"/>रास्तबाज़ों के लिए तारीकी में नूर चमकता है;</para>
  <para style="q" vid="PSA 112:4">वह रहीम — ओ — करीम और सादिक है।<verse eid="PSA 112:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5"/>रहम दिल और क़र्ज़ देने वाला आदमी फ़रमाँबरदार है;</para>
  <para style="q" vid="PSA 112:5">वह अपना कारोबार रास्ती से करेगा।<verse eid="PSA 112:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6"/>उसे कभी जुम्बिश न होगी:</para>
  <para style="q" vid="PSA 112:6">सादिक की यादगार हमेशा रहेगी।<verse eid="PSA 112:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7"/>वह बुरी ख़बर से न डरेगा;</para>
  <para style="q" vid="PSA 112:7">ख़ुदावन्द पर भरोसा करने से उसका दिल क़ाईम है।<verse eid="PSA 112:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8"/>उसका दिल बरकरार है, वह डरने का नहीं,</para>
  <para style="q" vid="PSA 112:8">यहाँ तक कि वह अपने मुख़ालिफ़ों को देख लेगा।<verse eid="PSA 112:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9"/>उसने बाँटा और मोहताजों को दिया,</para>
  <para style="q" vid="PSA 112:9">उसकी सदाक़त हमेशा क़ाईम रहेगी;</para>
  <para style="q" vid="PSA 112:9">उसका सींग इज़्ज़त के साथ बलन्द किया जाएगा।<verse eid="PSA 112:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10"/>शरीर यह देखेगा और कुढ़ेगा;</para>
  <para style="q" vid="PSA 112:10">वह दाँत पीसेगा और घुलेगा;</para>
  <para style="q" vid="PSA 112:10">शरीरों की मुराद बर्बाद होगी।<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1"/>ख़ुदावन्द की हम्द करो! ऐ ख़ुदावन्द के बन्दों,</para>
  <para style="q" vid="PSA 113:1">हम्द करो! ख़ुदावन्द के नाम की हम्द करो!<verse eid="PSA 113:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2"/>अब से हमेशा तक,</para>
  <para style="q" vid="PSA 113:2">ख़ुदावन्द का नाम मुबारक हो!<verse eid="PSA 113:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3"/>आफ़ताब के निकलने' से डूबने तक,</para>
  <para style="q" vid="PSA 113:3">ख़ुदावन्द के नाम की हम्द हो!<verse eid="PSA 113:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4"/>ख़ुदावन्द सब क़ौमों पर बुलन्द — ओ — बाला है;</para>
  <para style="q" vid="PSA 113:4">उसका जलाल आसमान से बरतर है।<verse eid="PSA 113:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5"/>ख़ुदावन्द हमारे ख़ुदा की तरह कौन है?</para>
  <para style="q" vid="PSA 113:5">जो 'आलम — ए — बाला पर तख़्तनशीन है,<verse eid="PSA 113:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6"/>जो फ़रोतनी से,</para>
  <para style="q" vid="PSA 113:6">आसमान — ओ — ज़मीन पर नज़र करता है।<verse eid="PSA 113:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7"/>वह ग़रीब को खाक से,</para>
  <para style="q" vid="PSA 113:7">और मोहताज को मज़बले पर से उठा लेता है,<verse eid="PSA 113:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8"/>ताकि उसे उमरा के साथ,</para>
  <para style="q" vid="PSA 113:8">या'नी अपनी कौम के उमरा के साथ बिठाए।<verse eid="PSA 113:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9"/>वह बाँझ का घर बसाता है, और उसे बच्चों वाली बनाकर दिलखुश करता है।</para>
  <para style="q" vid="PSA 113:9">ख़ुदावन्द की हम्द करो!<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1"/>जब इस्राईल मिस्र से निकलआया,</para>
  <para style="q" vid="PSA 114:1">या'नी या'क़ूब का घराना अजनबी ज़बान वाली क़ौम में से;<verse eid="PSA 114:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2"/>तो यहूदाह उसका हैकल,</para>
  <para style="q" vid="PSA 114:2">और इस्राईल उसकी ममलुकत ठहरा।<verse eid="PSA 114:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3"/>यह देखते ही समन्दर भागा;</para>
  <para style="q" vid="PSA 114:3">यरदन पीछे हट गया।<verse eid="PSA 114:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4"/>पहाड़ मेंढों की तरह उछले,</para>
  <para style="q" vid="PSA 114:4">पहाड़ियाँ भेड़ के बच्चों की तरह कूदे।<verse eid="PSA 114:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5"/>ऐ समन्दर, तुझे क्या हुआ के तू भागता है?</para>
  <para style="q" vid="PSA 114:5">ऐ यरदन, तुझे क्या हुआ कि तू पीछे हटता है?<verse eid="PSA 114:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6"/>ऐ पहाड़ो, तुम को क्या हुआ के तुम मेंढों की तरह उछलते हो?</para>
  <para style="q" vid="PSA 114:6">ऐ पहाड़ियो, तुम को क्या हुआ के तुम भेड़ के बच्चों की तरह कूदती हो?<verse eid="PSA 114:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7"/>ऐ ज़मीन, तू रब्ब के सामने,</para>
  <para style="q" vid="PSA 114:7">या'क़ूब के ख़ुदा के सामने थरथरा;<verse eid="PSA 114:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8"/>जो चट्टान को झील,</para>
  <para style="q" vid="PSA 114:8">और चक़माक़ की पानी का चश्मा बना देता है।<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1"/>हमको नहीं, ऐ ख़ुदावन्द बल्कि तू अपने ही नाम को अपनी शफ़क़त</para>
  <para style="q" vid="PSA 115:1">और सच्चाई की ख़ातिर जलाल बख़्श।<verse eid="PSA 115:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2"/>क़ौमें क्यूँ कहें, “अब उनका ख़ुदा कहाँ है?”<verse eid="PSA 115:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3"/>हमारा ख़ुदा तो आसमान पर है;</para>
  <para style="q" vid="PSA 115:3">उसने जो कुछ चाहा वही किया।<verse eid="PSA 115:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4"/>उनके बुत चाँदी और सोना हैं,</para>
  <para style="q" vid="PSA 115:4">या'नी आदमी की दस्तकारी।<verse eid="PSA 115:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5"/>उनके मुँह हैं लेकिन वह बोलते नहीं;</para>
  <para style="q" vid="PSA 115:5">आँखें हैं लेकिन वह देखते नहीं।<verse eid="PSA 115:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6"/>उनके कान हैं लेकिन वह सुनते नहीं;</para>
  <para style="q" vid="PSA 115:6">नाक हैं लेकिन वह सूघते नहीं।<verse eid="PSA 115:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7"/>पाँव हैं लेकीन वह चलते नहीं,</para>
  <para style="q" vid="PSA 115:7">और उनके गले से आवाज़ नहीं निकलती।<verse eid="PSA 115:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8"/>उनके बनाने वाले उन ही की तरह हो जाएँगे;</para>
  <para style="q" vid="PSA 115:8">बल्कि वह सब जो उन पर भरोसा रखते हैं।<verse eid="PSA 115:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9"/>ऐ इस्राईल, ख़ुदावन्द पर भरोसा कर!</para>
  <para style="q" vid="PSA 115:9">वही उनकी मदद और उनकी ढाल है।<verse eid="PSA 115:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10"/>ऐ हारून के घराने, ख़ुदावन्द पर भरोसा करो।</para>
  <para style="q" vid="PSA 115:10">वही उनकी मदद और उनकी ढाल है।<verse eid="PSA 115:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11"/>ऐ ख़ुदावन्द से डरने वालो, ख़ुदावन्द पर भरोसा करो!</para>
  <para style="q" vid="PSA 115:11">वही उनकी मदद और उनकी ढाल है।<verse eid="PSA 115:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12"/>ख़ुदावन्द ने हम को याद रखा,</para>
  <para style="q" vid="PSA 115:12">वह बरकत देगाः वह इस्राईल के घराने को बरकत देगा;</para>
  <para style="q" vid="PSA 115:12">वह हारून के घराने को बरकत देगा।<verse eid="PSA 115:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13"/>जो ख़ुदावन्द से डरते हैं, क्या छोटे क्या बड़े,</para>
  <para style="q" vid="PSA 115:13">वह उन सबको बरकत देगा।<verse eid="PSA 115:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14"/>ख़ुदावन्द तुम को बढ़ाए, तुम को और तुम्हारी औलाद को!<verse eid="PSA 115:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15"/>तुम ख़ुदावन्द की तरफ़ से मुबारक हो,</para>
  <para style="q" vid="PSA 115:15">जिसने आसमान और ज़मीन को बनाया।<verse eid="PSA 115:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16"/>आसमान तो ख़ुदावन्द का आसमान है,</para>
  <para style="q" vid="PSA 115:16">लेकिन ज़मीन उसने बनी आदम को दी है।<verse eid="PSA 115:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17"/>मुर्दे ख़ुदावन्द की सिताइश नहीं करते,</para>
  <para style="q" vid="PSA 115:17">न वह जो ख़ामोशी के 'आलम में उतर जाते हैं:<verse eid="PSA 115:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18"/>लेकिन हम अब से हमेशा तक,</para>
  <para style="q" vid="PSA 115:18">ख़ुदावन्द को मुबारक कहेंगे।</para>
  <para style="q" vid="PSA 115:18">ख़ुदावन्द की हम्द करो।<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1"/>मैं ख़ुदावन्द से मुहब्बत रखता हूँ क्यूँकि उसने मेरी फ़रियाद और मिन्नत सुनी है<verse eid="PSA 116:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2"/>चुँकि उसने मेरी तरफ़ कान लगाया,</para>
  <para style="q" vid="PSA 116:2">इसलिए मैं उम्र भर उससे दू'आ करूँगा<verse eid="PSA 116:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3"/>मौत की रस्सियों ने मुझे जकड़ लिया,</para>
  <para style="q" vid="PSA 116:3">और पाताल के दर्द मुझ पर आ पड़े;</para>
  <para style="q" vid="PSA 116:3">मैं दुख और ग़म में गिरफ़्तार हुआ।<verse eid="PSA 116:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4"/>तब मैंने ख़ुदावन्द से दुआ की,</para>
  <para style="q" vid="PSA 116:4">ऐ ख़ुदावन्द, मैं तेरी मिन्नत करता हूँ मेरी जान की रिहाई बख्श!<verse eid="PSA 116:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5"/>ख़ुदावन्द सादिक़ और करीम है;</para>
  <para style="q" vid="PSA 116:5">हमारा ख़ुदा रहीम है।<verse eid="PSA 116:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6"/>ख़ुदावन्द सादा लोगों की हिफ़ाज़त करता है;</para>
  <para style="q" vid="PSA 116:6">मैं पस्त हो गया था, उसी ने मुझे बचा लिया।<verse eid="PSA 116:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7"/>ऐ मेरी जान, फिर मुत्मइन हो;</para>
  <para style="q" vid="PSA 116:7">क्यूँकि ख़ुदावन्द ने तुझ पर एहसान किया है।<verse eid="PSA 116:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8"/>इसलिए के तूने मेरी जान को मौत से,</para>
  <para style="q" vid="PSA 116:8">मेरी आँखों को आँसू बहाने से,</para>
  <para style="q" vid="PSA 116:8">और मेरे पाँव को फिसलने से बचाया है।<verse eid="PSA 116:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9"/>मैं ज़िन्दों की ज़मीन में,</para>
  <para style="q" vid="PSA 116:9">ख़ुदावन्द के सामने चलता रहूँगा।<verse eid="PSA 116:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10"/>मैं ईमान रखता हूँ इसलिए यह कहूँगा,</para>
  <para style="q" vid="PSA 116:10">मैं बड़ी मुसीबत में था।<verse eid="PSA 116:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11"/>मैंने जल्दबाज़ी से कह दिया,</para>
  <para style="q" vid="PSA 116:11">कि “सब आदमी झूटे हैं।”<verse eid="PSA 116:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12"/>ख़ुदावन्द की सब ने'मतें जो मुझे मिलीं,</para>
  <para style="q" vid="PSA 116:12">मैं उनके बदले में उसे क्या दूँ?<verse eid="PSA 116:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13"/>मैं नजात का प्याला उठाकर,</para>
  <para style="q" vid="PSA 116:13">ख़ुदावन्द से दुआ करूँगा।<verse eid="PSA 116:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14"/>मैं ख़ुदावन्द के सामने अपनी मन्नतें,</para>
  <para style="q" vid="PSA 116:14">उसकी सारी क़ौम के सामने पूरी करूँगा।<verse eid="PSA 116:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15"/>ख़ुदावन्द की निगाह में,</para>
  <para style="q" vid="PSA 116:15">उसके पाक लोगों की मौत गिरा क़द्र है।<verse eid="PSA 116:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16"/>आह! ऐ ख़ुदावन्द, मैं तेरा बन्दा हूँ।</para>
  <para style="q" vid="PSA 116:16">मैं तेरा बन्दा, तेरी लौंडी का बेटा हूँ।</para>
  <para style="q" vid="PSA 116:16">तूने मेरे बन्धन खोले हैं।<verse eid="PSA 116:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17"/>मैं तेरे सामने शुक्रगुज़ारी की कु़र्बानी पेश करूँगा</para>
  <para style="q" vid="PSA 116:17">और ख़ुदावन्द से दुआ करूँगा।<verse eid="PSA 116:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 116:18"/>मैं ख़ुदावन्द के सामने अपनी मन्नतें,</para>
  <para style="q" vid="PSA 116:18">उसकी सारी क़ौम के सामने पूरी करूँगा।<verse eid="PSA 116:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 116:19"/>ख़ुदावन्द के घर की बारगाहों में,</para>
  <para style="q" vid="PSA 116:19">तेरे अन्दर ऐ येरूशलेम!</para>
  <para style="q" vid="PSA 116:19">ख़ुदावन्द की हम्द करो।<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1"/>ऐ क़ौमो सब ख़ुदावन्द की हम्द करो! करो!</para>
  <para style="q" vid="PSA 117:1">ऐ उम्मतो! सब उसकी सिताइश करो!<verse eid="PSA 117:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2"/>क्यूँकि हम पर उसकी बड़ी शफ़क़त है;</para>
  <para style="q" vid="PSA 117:2">और ख़ुदावन्द की सच्चाई हमेशा है ख़ुदावन्द की हम्द करो।<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1"/>ख़ुदावन्द का शुक्र करो, क्यूँकि वह भला है;</para>
  <para style="q" vid="PSA 118:1">और उसकी शफ़क़त हमेशा की है!<verse eid="PSA 118:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2"/>इस्राईल अब कहे,</para>
  <para style="q" vid="PSA 118:2">उसकी शफ़क़त हमेशा की है।<verse eid="PSA 118:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3"/>हारून का घराना अब कहे,</para>
  <para style="q" vid="PSA 118:3">उसकी शफ़क़त हमेशा की है।<verse eid="PSA 118:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4"/>ख़ुदावन्द से डरने वाले अब कहें,</para>
  <para style="q" vid="PSA 118:4">उसकी शफ़क़त हमेशा की है।<verse eid="PSA 118:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5"/>मैंने मुसीबत में ख़ुदावन्द से दुआ की,</para>
  <para style="q" vid="PSA 118:5">ख़ुदावन्द ने मुझे जवाब दिया और कुशादगी बख़्शी।<verse eid="PSA 118:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6"/>ख़ुदावन्द मेरी तरफ़ है, मैं नहीं डरने का;</para>
  <para style="q" vid="PSA 118:6">इंसान मेरा क्या कर सकता है?<verse eid="PSA 118:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7"/>ख़ुदावन्द मेरी तरफ़ मेरे मददगारों में है,</para>
  <para style="q" vid="PSA 118:7">इसलिए मैं अपने 'अदावत रखने वालों को देख लूँगा।<verse eid="PSA 118:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8"/>ख़ुदावन्द पर भरोसा करना,</para>
  <para style="q" vid="PSA 118:8">इंसान पर भरोसा रखने से बेहतर है।<verse eid="PSA 118:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9"/>ख़ुदावन्द पर भरोसा करना,</para>
  <para style="q" vid="PSA 118:9">उमरा पर भरोसा रखने से बेहतर है।<verse eid="PSA 118:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10"/>सब क़ौमों ने मुझे घेर लिया;</para>
  <para style="q" vid="PSA 118:10">मैं ख़ुदावन्द के नाम से उनको काट डालूँगा!<verse eid="PSA 118:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11"/>उन्होंने मुझे घेर लिया, बेशक घेर लिया;</para>
  <para style="q" vid="PSA 118:11">मैं ख़ुदावन्द के नाम से उनको काट डालूँगा!<verse eid="PSA 118:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12"/>उन्होंने शहद की मक्खियों की तरह मुझे घेर लिया,</para>
  <para style="q" vid="PSA 118:12">वह काँटों की आग की तरह बुझ गए;</para>
  <para style="q" vid="PSA 118:12">मैं ख़ुदावन्द के नाम से उनको काट डालूँगा।<verse eid="PSA 118:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13"/>तूने मुझे ज़ोर से धकेल दिया कि गिर पडू लेकिन ख़ुदावन्द ने मेरी मदद की।<verse eid="PSA 118:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14"/>ख़ुदावन्द मेरी ताक़त और मेरी हम्द है;</para>
  <para style="q" vid="PSA 118:14">वही मेरी नजात हुआ।<verse eid="PSA 118:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15"/>सादिकों के खे़मों में ख़ुशी और नजात की रागनी है,</para>
  <para style="q" vid="PSA 118:15">ख़ुदावन्द का दहना हाथ दिलावरी करता है।<verse eid="PSA 118:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16"/>ख़ुदावन्द का दहना हाथ बुलन्द हुआ है,</para>
  <para style="q" vid="PSA 118:16">ख़ुदावन्द का दहना हाथ दिलावरी करता है।<verse eid="PSA 118:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17"/>मैं मरूँगा नहीं बल्कि जिन्दा रहूँगा,</para>
  <para style="q" vid="PSA 118:17">और ख़ुदावन्द के कामों का बयान करूँगा।<verse eid="PSA 118:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18"/>ख़ुदावन्द ने मुझे सख़्त तम्बीह तो की,</para>
  <para style="q" vid="PSA 118:18">लेकिन मौत के हवाले नहीं किया।<verse eid="PSA 118:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19"/>सदाक़त के फाटकों को मेरे लिए खोल दो,</para>
  <para style="q" vid="PSA 118:19">मैं उनसे दाख़िल होकर ख़ुदावन्द का शुक्र करूँगा।<verse eid="PSA 118:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20"/>ख़ुदावन्द का फाटक यही है,</para>
  <para style="q" vid="PSA 118:20">सादिक इससे दाख़िल होंगे।<verse eid="PSA 118:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21"/>मैं तेरा शुक्र करूँगा क्यूँकि तूने मुझे जवाब दिया,</para>
  <para style="q" vid="PSA 118:21">और ख़ुद मेरी नजात बना है।<verse eid="PSA 118:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22"/>जिस पत्थर की मे'मारों ने रद्द किया,</para>
  <para style="q" vid="PSA 118:22">वही कोने के सिरे का पत्थर हो गया।<verse eid="PSA 118:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23"/>यह ख़ुदावन्द की तरफ़ से हुआ,</para>
  <para style="q" vid="PSA 118:23">और हमारी नज़र में 'अजीब है।<verse eid="PSA 118:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24"/>यह वही दिन है जिसे ख़ुदावन्द ने मुक़र्रर किया,</para>
  <para style="q" vid="PSA 118:24">हम इसमें ख़ुश होंगे और ख़ुशी मनाएँगे।<verse eid="PSA 118:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25"/>आह! ऐ ख़ुदावन्द बचा ले!</para>
  <para style="q" vid="PSA 118:25">आह! ऐ ख़ुदावन्द खु़शहाली बख़्श!<verse eid="PSA 118:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26"/>मुबारक है वह जो ख़ुदावन्द के नाम से आता है!</para>
  <para style="q" vid="PSA 118:26">हम ने तुम को ख़ुदावन्द के घर से दुआ दी है।<verse eid="PSA 118:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27"/>यहोवा ही ख़ुदा है, और उसी ने हम को नूर बख़्शा है।</para>
  <para style="q" vid="PSA 118:27">कु़र्बानी को मज़बह के सींगों से रस्सियों से बाँधो!<verse eid="PSA 118:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28"/>तू मेरा ख़ुदा है, मैं तेरा शुक्र करूँगा;</para>
  <para style="q" vid="PSA 118:28">तू मेरा ख़ुदा है, मैं तेरी तम्जीद करूँगा।<verse eid="PSA 118:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29"/>ख़ुदावन्द का शुक्र करो, क्यूँकि वह भला है;</para>
  <para style="q" vid="PSA 118:29">और उसकी शफ़क़त हमेशा की है!<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="d">आलेफ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1"/>मुबारक हैं वह जो कामिल रफ़्तार है,</para>
  <para style="q" vid="PSA 119:1">जो ख़ुदा की शरी'अत पर 'अमल करते हैं!<verse eid="PSA 119:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2"/>मुबारक हैं वह जो उसकी शहादतों को मानते हैं,</para>
  <para style="q" vid="PSA 119:2">और पूरे दिल से उसके तालिब हैं!<verse eid="PSA 119:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3"/>उन से नारास्ती नहीं होती,</para>
  <para style="q" vid="PSA 119:3">वह उसकी राहों पर चलते हैं।<verse eid="PSA 119:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4"/>तूने अपने क़वानीन दिए हैं,</para>
  <para style="q" vid="PSA 119:4">ताकि हम दिल लगा कर उनकी मानें।<verse eid="PSA 119:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5"/>काश कि तेरे क़ानून मानने के लिए,</para>
  <para style="q" vid="PSA 119:5">मेरी चाल चलन दुरुस्त हो जाएँ!<verse eid="PSA 119:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6"/>जब मैं तेरे सब अहकाम का लिहाज़ रख्खूँगा,</para>
  <para style="q" vid="PSA 119:6">तो शर्मिन्दा न हूँगा।<verse eid="PSA 119:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7"/>जब मैं तेरी सदाक़त के अहकाम सीख लूँगा,</para>
  <para style="q" vid="PSA 119:7">तो सच्चे दिल से तेरा शुक्र अदा करूँगा।<verse eid="PSA 119:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8"/>मैं तेरे क़ानून मानूँगा;</para>
  <para style="q" vid="PSA 119:8">मुझे बिल्कुल छोड़ न दे!</para>
  <para style="d" vid="PSA 119:8">बेथ<verse eid="PSA 119:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9"/>जवान अपने चाल चलन किस तरह पाक रख्खे?</para>
  <para style="q" vid="PSA 119:9">तेरे कलाम के मुताबिक़ उस पर निगाह रखने से।<verse eid="PSA 119:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10"/>मैं पूरे दिल से तेरा तालिब हुआ हूँ:</para>
  <para style="q" vid="PSA 119:10">मुझे अपने फ़रमान से भटकने न दे।<verse eid="PSA 119:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11"/>मैंने तेरे कलाम को अपने दिल में रख लिया है</para>
  <para style="q" vid="PSA 119:11">ताकि मैं तेरे ख़िलाफ़ गुनाह न करूँ।<verse eid="PSA 119:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12"/>ऐ ख़ुदावन्द! तू मुबारक है;</para>
  <para style="q" vid="PSA 119:12">मुझे अपने क़ानून सिखा!<verse eid="PSA 119:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13"/>मैंने अपने लबों से,</para>
  <para style="q" vid="PSA 119:13">तेरे फ़रमूदा अहकाम को बयान किया।<verse eid="PSA 119:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14"/>मुझे तेरी शहादतों की राह से ऐसी ख़ुशी हुई,</para>
  <para style="q" vid="PSA 119:14">जैसी हर तरह की दौलत से होती है।<verse eid="PSA 119:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15"/>मैं तेरे क़वानीन पर ग़ौर करूँगा,</para>
  <para style="q" vid="PSA 119:15">और तेरी राहों का लिहाज़ रख्खूँगा।<verse eid="PSA 119:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16"/>मैं तेरे क़ानून में मसरूर रहूँगा;</para>
  <para style="q" vid="PSA 119:16">मैं तेरे कलाम को न भूलूँगा।</para>
  <para style="d" vid="PSA 119:16">गिमेल<verse eid="PSA 119:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17"/>अपने बन्दे पर एहसान कर ताकि मैं जिन्दा रहूँ</para>
  <para style="q" vid="PSA 119:17">और तेरे कलाम को मानता रहूँ।<verse eid="PSA 119:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18"/>मेरी आँखे खोल दे,</para>
  <para style="q" vid="PSA 119:18">ताकि मैं तेरी शरीअत के 'अजायब देखूँ।<verse eid="PSA 119:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19"/>मैं ज़मीन पर मुसाफ़िर हूँ,</para>
  <para style="q" vid="PSA 119:19">अपने फ़रमान मुझ से छिपे न रख।<verse eid="PSA 119:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20"/>मेरा दिल तेरे अहकाम के इश्तियाक में,</para>
  <para style="q" vid="PSA 119:20">हर वक़्त तड़पता रहता है।<verse eid="PSA 119:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21"/>तूने उन मला'ऊन मग़रूरों को झिड़क दिया,</para>
  <para style="q" vid="PSA 119:21">जो तेरे फ़रमान से भटकते रहते हैं।<verse eid="PSA 119:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22"/>मलामत और हिक़ारत को मुझ से दूर कर दे,</para>
  <para style="q" vid="PSA 119:22">क्यूँकि मैंने तेरी शहादतें मानी हैं।<verse eid="PSA 119:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23"/>उमरा भी बैठकर मेरे ख़िलाफ़ बातें करते रहे,</para>
  <para style="q" vid="PSA 119:23">लेकिन तेरा बंदा तेरे क़ानून पर ध्यान लगाए रहा।<verse eid="PSA 119:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24"/>तेरी शहादतें मुझे पसन्द, और मेरी मुशीर हैं।</para>
  <para style="d" vid="PSA 119:24">दाल्थ<verse eid="PSA 119:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25"/>मेरी जान ख़ाक में मिल गई:</para>
  <para style="q" vid="PSA 119:25">तू अपने कलाम के मुताबिक़ मुझे ज़िन्दा कर।<verse eid="PSA 119:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26"/>मैंने अपने चाल चलन का इज़हार किया और तूने मुझे जवाब दिया;</para>
  <para style="q" vid="PSA 119:26">मुझे अपने क़ानून की ता'लीम दे।<verse eid="PSA 119:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27"/>अपने क़वानीन की राह मुझे समझा दे,</para>
  <para style="q" vid="PSA 119:27">और मैं तेरे 'अजायब पर ध्यान करूँगा।<verse eid="PSA 119:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28"/>ग़म के मारे मेरी जान घुली जाती है;</para>
  <para style="q" vid="PSA 119:28">अपने कलाम के मुताबिक़ मुझे ताक़त दे।<verse eid="PSA 119:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29"/>झूट की राह से मुझे दूर रख,</para>
  <para style="q" vid="PSA 119:29">और मुझे अपनी शरी'अत इनायत फ़रमा।<verse eid="PSA 119:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30"/>मैंने वफ़ादारी की राह इख़्तियार की है,</para>
  <para style="q" vid="PSA 119:30">मैंने तेरे अहकाम अपने सामने रख्खे हैं।<verse eid="PSA 119:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31"/>मैं तेरी शहादतों से लिपटा हुआ हूँ,</para>
  <para style="q" vid="PSA 119:31">ऐ ख़ुदावन्द! मुझे शर्मिन्दा न होने दे!<verse eid="PSA 119:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32"/>जब तू मेरा हौसला बढ़ाएगा,</para>
  <para style="q" vid="PSA 119:32">तो मैं तेरे फ़रमान की राह में दौड़ूँगा।</para>
  <para style="d" vid="PSA 119:32">हे<verse eid="PSA 119:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33"/>ऐ ख़ुदावन्द, मुझे अपने क़ानून की राह बता,</para>
  <para style="q" vid="PSA 119:33">और मैं आख़िर तक उस पर चलूँगा।<verse eid="PSA 119:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34"/>मुझे समझ 'अता कर और मैं तेरी शरी'अत पर चलूँगा,</para>
  <para style="q" vid="PSA 119:34">बल्कि मैं पूरे दिल से उसको मानूँगा।<verse eid="PSA 119:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35"/>मुझे अपने फ़रमान की राह पर चला,</para>
  <para style="q" vid="PSA 119:35">क्यूँकि इसी में मेरी ख़ुशी है।<verse eid="PSA 119:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36"/>मेरे दिल की अपनी शहादतों की तरफ़ रुजू' दिला;</para>
  <para style="q" vid="PSA 119:36">न कि लालच की तरफ़।<verse eid="PSA 119:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37"/>मेरी आँखों को बेकारी पर नज़र करने से बाज़ रख,</para>
  <para style="q" vid="PSA 119:37">और मुझे अपनी राहों में ज़िन्दा कर।<verse eid="PSA 119:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38"/>अपने बन्दे के लिए अपना वह क़ौल पूरा कर,</para>
  <para style="q" vid="PSA 119:38">जिस से तेरा खौफ़ पैदा होता है।<verse eid="PSA 119:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39"/>मेरी मलामत को जिस से मैं डरता हूँ दूर कर दे;</para>
  <para style="q" vid="PSA 119:39">क्यूँकि तेरे अहकाम भले हैं।<verse eid="PSA 119:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40"/>देख, मैं तेरे क़वानीन का मुश्ताक़ रहा हूँ;</para>
  <para style="q" vid="PSA 119:40">मुझे अपनी सदाक़त से ज़िन्दा कर।</para>
  <para style="d" vid="PSA 119:40">वाव<verse eid="PSA 119:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41"/>ऐ ख़ुदावन्द, तेरे क़ौल के मुताबिक़,</para>
  <para style="q" vid="PSA 119:41">तेरी शफ़क़त और तेरी नजात मुझे नसीब हों,<verse eid="PSA 119:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42"/>तब मैं अपने मलामत करने वाले को जवाब दे सकूँगा,</para>
  <para style="q" vid="PSA 119:42">क्यूँकि मैं तेरे कलाम पर भरोसा रखता हूँ।<verse eid="PSA 119:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43"/>और हक़ बात को मेरे मुँह से हरगिज़ जुदा न होने दे,</para>
  <para style="q" vid="PSA 119:43">क्यूँकि मेरा भरोसा तेरे अहकाम पर है।<verse eid="PSA 119:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44"/>फिर मैं हमेशा से हमेशा तक,</para>
  <para style="q" vid="PSA 119:44">तेरी शरी'अत को मानता रहूँगा<verse eid="PSA 119:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45"/>और मैं आज़ादी से चलूँगा,</para>
  <para style="q" vid="PSA 119:45">क्यूँकि मैं तेरे क़वानीन का तालिब रहा हूँ।<verse eid="PSA 119:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46"/>मैं बादशाहों के सामने तेरी शहादतों का बयान करूँगा,</para>
  <para style="q" vid="PSA 119:46">और शर्मिन्दा न हूँगा।<verse eid="PSA 119:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47"/>तेरे फ़रमान मुझे अज़ीज़ हैं,</para>
  <para style="q" vid="PSA 119:47">मैं उनमें मसरूर रहूँगा।<verse eid="PSA 119:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48"/>मैं अपने हाथ तेरे फ़रमान की तरफ़ जो मुझे 'अज़ीज़ है उठाऊँगा,</para>
  <para style="q" vid="PSA 119:48">और तेरे क़ानून पर ध्यान करूँगा।</para>
  <para style="d" vid="PSA 119:48">ज़ैन<verse eid="PSA 119:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49"/>जो कलाम तूने अपने बन्दे से किया उसे याद कर,</para>
  <para style="q" vid="PSA 119:49">क्यूँकि तूने मुझे उम्मीद दिलाई है।<verse eid="PSA 119:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50"/>मेरी मुसीबत में यही मेरी तसल्ली है,</para>
  <para style="q" vid="PSA 119:50">कि तेरे कलाम ने मुझे ज़िन्दा किया<verse eid="PSA 119:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51"/>मग़रूरों ने मुझे बहुत ठठ्ठों में उड़ाया,</para>
  <para style="q" vid="PSA 119:51">तोभी मैंने तेरी शरी'अत से किनारा नहीं किया<verse eid="PSA 119:51"/></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52"/>ऐ ख़ुदावन्द! मैं तेरे क़दीम अहकाम को याद करता,</para>
  <para style="q" vid="PSA 119:52">और इत्मीनान पाता रहा हूँ।<verse eid="PSA 119:52"/></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53"/>उन शरीरों की वजह से जो तेरी शरी'अत को छोड़ देते हैं,</para>
  <para style="q" vid="PSA 119:53">मैं सख़्त ग़ुस्से में आ गया हूँ।<verse eid="PSA 119:53"/></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54"/>मेरे मुसाफ़िर ख़ाने में,</para>
  <para style="q" vid="PSA 119:54">तेरे क़ानून मेरी हम्द रहे हैं।<verse eid="PSA 119:54"/></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55"/>ऐ ख़ुदावन्द, रात को मैंने तेरा नाम याद किया है,</para>
  <para style="q" vid="PSA 119:55">और तेरी शरी'अत पर 'अमल किया है।<verse eid="PSA 119:55"/></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56"/>यह मेरे लिए इसलिए हुआ,</para>
  <para style="q" vid="PSA 119:56">कि मैंने तेरे क़वानीन को माना।</para>
  <para style="d" vid="PSA 119:56">हेथ<verse eid="PSA 119:56"/></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57"/>ख़ुदावन्द मेरा बख़रा है;</para>
  <para style="q" vid="PSA 119:57">मैंने कहा है मैं तेरी बातें मानूँगा।<verse eid="PSA 119:57"/></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58"/>मैं पूरे दिल से तेरे करम का तलब गार हुआ;</para>
  <para style="q" vid="PSA 119:58">अपने कलाम के मुताबिक़ मुझ पर रहम कर!<verse eid="PSA 119:58"/></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59"/>मैंने अपनी राहों पर ग़ौर किया,</para>
  <para style="q" vid="PSA 119:59">और तेरी शहादतों की तरफ़ अपने कदम मोड़े।<verse eid="PSA 119:59"/></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60"/>मैंने तेरे फ़रमान मानने में,</para>
  <para style="q" vid="PSA 119:60">जल्दी की और देर न लगाई।<verse eid="PSA 119:60"/></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61"/>शरीरों की रस्सियों ने मुझे जकड़ लिया,</para>
  <para style="q" vid="PSA 119:61">लेकिन मैं तेरी शरी'अत को न भूला।<verse eid="PSA 119:61"/></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62"/>तेरी सदाकत के अहकाम के लिए,</para>
  <para style="q" vid="PSA 119:62">मैं आधी रात को तेरा शुक्र करने को उठूँगा।<verse eid="PSA 119:62"/></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63"/>मैं उन सबका साथी हूँ जो तुझ से डरते हैं,</para>
  <para style="q" vid="PSA 119:63">और उनका जो तेरे क़वानीन को मानते हैं।<verse eid="PSA 119:63"/></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64"/>ऐ ख़ुदावन्द, ज़मीन तेरी शफ़क़त से मा'मूर है;</para>
  <para style="q" vid="PSA 119:64">मुझे अपने क़ानून सिखा!</para>
  <para style="d" vid="PSA 119:64">टेथ<verse eid="PSA 119:64"/></para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65"/>ऐ ख़ुदावन्द! तूने अपने कलाम के मुताबिक़,</para>
  <para style="q" vid="PSA 119:65">अपने बन्दे के साथ भलाई की है।<verse eid="PSA 119:65"/></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66"/>मुझे सही फ़र्क़ और 'अक़्ल सिखा,</para>
  <para style="q" vid="PSA 119:66">क्यूँकि मैं तेरे फ़रमान पर ईमान लाया हूँ।<verse eid="PSA 119:66"/></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67"/>मैं मुसीबत उठाने से पहले गुमराह था;</para>
  <para style="q" vid="PSA 119:67">लेकिन अब तेरे कलाम को मानता हूँ।<verse eid="PSA 119:67"/></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68"/>तू भला है और भलाई करता है;</para>
  <para style="q" vid="PSA 119:68">मुझे अपने क़ानून सिखा।<verse eid="PSA 119:68"/></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69"/>मग़रूरों ने मुझ पर बहुतान बाँधा है;</para>
  <para style="q" vid="PSA 119:69">मैं पूरे दिल से तेरे क़वानीन को मानूँगा।<verse eid="PSA 119:69"/></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70"/>उनके दिल चिकनाई से फ़र्बा हो गए,</para>
  <para style="q" vid="PSA 119:70">लेकिन मैं तेरी शरी'अत में मसरूर हूँ।<verse eid="PSA 119:70"/></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71"/>अच्छा हुआ कि मैंने मुसीबत उठाई,</para>
  <para style="q" vid="PSA 119:71">ताकि तेरे क़ानून सीख लूँ।<verse eid="PSA 119:71"/></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72"/>तेरे मुँह की शरी'अत मेरे लिए,</para>
  <para style="q" vid="PSA 119:72">सोने चाँदी के हज़ारों सिक्कों से बेहतर है।</para>
  <para style="d" vid="PSA 119:72">योध<verse eid="PSA 119:72"/></para>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73"/>तेरे हाथों ने मुझे बनाया और तरतीब दी;</para>
  <para style="q" vid="PSA 119:73">मुझे समझ 'अता कर ताकि तेरे फ़रमान सीख लें।<verse eid="PSA 119:73"/></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74"/>तुझ से डरने वाले मुझे देख कर</para>
  <para style="q" vid="PSA 119:74">इसलिए कि मुझे तेरे कलाम पर भरोसा है।<verse eid="PSA 119:74"/></para>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75"/>ऐ ख़ुदावन्द, मैं तेरे अहकाम की सदाक़त को जानता हूँ,</para>
  <para style="q" vid="PSA 119:75">और यह कि वफ़ादारी ही से तूने मुझे दुख; में डाला।<verse eid="PSA 119:75"/></para>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76"/>उस कलाम के मुताबिक़ जो तूनेअपने बन्दे से किया,</para>
  <para style="q" vid="PSA 119:76">तेरी शफ़क़त मेरी तसल्ली का ज़रिया' हो।<verse eid="PSA 119:76"/></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77"/>तेरी रहमत मुझे नसीब हो ताकि मैं ज़िन्दा रहूँ।</para>
  <para style="q" vid="PSA 119:77">क्यूँकि तेरी शरी'अत मेरी ख़ुशनूदी है।<verse eid="PSA 119:77"/></para>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78"/>मग़रूर शर्मिन्दा हों, क्यूँकि उन्होंने नाहक़ मुझे गिराया,</para>
  <para style="q" vid="PSA 119:78">लेकिन मैं तेरे क़वानीन पर ध्यान करूँगा।<verse eid="PSA 119:78"/></para>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79"/>तुझ से डरने वाले मेरी तरफ़ रुजू हों,</para>
  <para style="q" vid="PSA 119:79">तो वह तेरी शहादतों को जान लेंगे।<verse eid="PSA 119:79"/></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80"/>मेरा दिल तेरे क़ानून मानने में कामिल रहे,</para>
  <para style="q" vid="PSA 119:80">ताकि मैं शर्मिन्दगी न उठाऊँ।</para>
  <para style="d" vid="PSA 119:80">क़ाफ<verse eid="PSA 119:80"/></para>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81"/>मेरी जान तेरी नजात के लिए बेताब है,</para>
  <para style="q" vid="PSA 119:81">लेकिन मुझे तेरे कलाम पर भरोसा है।<verse eid="PSA 119:81"/></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82"/>तेरे कलाम के इन्तिज़ार में मेरी आँखें रह गई,</para>
  <para style="q" vid="PSA 119:82">मैं यही कहता रहा कि तू मुझे कब तसल्ली देगा?<verse eid="PSA 119:82"/></para>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83"/>मैं उस मश्कीज़े की तरह हो गया जो धुएँ में हो,</para>
  <para style="q" vid="PSA 119:83">तोभी मैं तेरे क़ानून को नहीं भूलता।<verse eid="PSA 119:83"/></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84"/>तेरे बन्दे के दिन ही कितने हैं?</para>
  <para style="q" vid="PSA 119:84">तू मेरे सताने वालों पर कब फ़तवा देगा?<verse eid="PSA 119:84"/></para>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85"/>मग़रूरों ने जो तेरी शरी'अत के पैरौ नहीं,</para>
  <para style="q" vid="PSA 119:85">मेरे लिए गढ़े खोदे हैं।<verse eid="PSA 119:85"/></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86"/>तेरे सब फ़रमान बरहक़ हैं: वह नाहक़ मुझे सताते हैं;</para>
  <para style="q" vid="PSA 119:86">तू मेरी मदद कर!<verse eid="PSA 119:86"/></para>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87"/>उन्होंने मुझे ज़मीन पर से फ़नाकर ही डाला था,</para>
  <para style="q" vid="PSA 119:87">लेकिन मैंने तेरे कवानीन को न छोड़ा।<verse eid="PSA 119:87"/></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88"/>तू मुझे अपनी शफ़क़त के मुताबिक़ ज़िन्दा कर,</para>
  <para style="q" vid="PSA 119:88">तो मैं तेरे मुँह की शहादत को मानूँगा।</para>
  <para style="d" vid="PSA 119:88">लामेध<verse eid="PSA 119:88"/></para>
  <para style="q">
    <verse number="89" style="v" sid="PSA 119:89"/>ऐ ख़ुदावन्द! तेरा कलाम,</para>
  <para style="q" vid="PSA 119:89">आसमान पर हमेशा तक क़ाईम है।<verse eid="PSA 119:89"/></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90"/>तेरी वफ़ादारी नसल दर नसल है;</para>
  <para style="q" vid="PSA 119:90">तूने ज़मीन को क़याम बख़्शा और वह क़ाईम है।<verse eid="PSA 119:90"/></para>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91"/>वह आज तेरे अहकाम के मुताबिक़ क़ाईम हैं</para>
  <para style="q" vid="PSA 119:91">क्यूँकि सब चीजें तेरी ख़िदमत गुज़ार हैं।<verse eid="PSA 119:91"/></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92"/>अगर तेरी शरी'अत मेरी ख़ुशनूदी न होती,</para>
  <para style="q" vid="PSA 119:92">तो मैं अपनी मुसीबत में हलाक हो जाता।<verse eid="PSA 119:92"/></para>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93"/>मैं तेरे क़वानीन को कभी न भूलूँगा,</para>
  <para style="q" vid="PSA 119:93">क्यूँकि तूने उन्ही के वसीले से मुझे ज़िन्दा किया है।<verse eid="PSA 119:93"/></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94"/>मैं तेरा ही हूँ मुझे बचा ले,</para>
  <para style="q" vid="PSA 119:94">क्यूँकि मैं तेरे क़वानीन का तालिब रहा हूँ।<verse eid="PSA 119:94"/></para>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95"/>शरीर मुझे हलाक करने को घात में लगे रहे,</para>
  <para style="q" vid="PSA 119:95">लेकिन मैं तेरी शहादतों पर ग़ौर करूँगा।<verse eid="PSA 119:95"/></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96"/>मैंने देखा कि हर कमाल की इन्तिहा है,</para>
  <para style="q" vid="PSA 119:96">लेकिन तेरा हुक्म बहुत वसी'अ है।</para>
  <para style="d" vid="PSA 119:96">मीम<verse eid="PSA 119:96"/></para>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97"/>आह! मैं तेरी शरी'अत से कैसी मुहब्बत रखता हूँ,</para>
  <para style="q" vid="PSA 119:97">मुझे दिन भर उसी का ध्यान रहता है।<verse eid="PSA 119:97"/></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98"/>तेरे फ़रमान मुझे मेरे दुश्मनों से ज़्यादा 'अक़्लमंद बनाते हैं,</para>
  <para style="q" vid="PSA 119:98">क्यूँकि वह हमेशा मेरे साथ हैं।<verse eid="PSA 119:98"/></para>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99"/>मैं अपने सब उस्तादों से 'अक़्लमंद हैं,</para>
  <para style="q" vid="PSA 119:99">क्यूँकि तेरी शहादतों पर मेरा ध्यान रहता है।<verse eid="PSA 119:99"/></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100"/>मैं उम्र रसीदा लोगों से ज़्यादा समझ रखता हूँ</para>
  <para style="q" vid="PSA 119:100">क्यूँकि मैंने तेरे क़वानीन को माना है।<verse eid="PSA 119:100"/></para>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101"/>मैंने हर बुरी राह से अपने क़दम रोक रख्खें हैं,</para>
  <para style="q" vid="PSA 119:101">ताकि तेरी शरी'अत पर 'अमल करूँ।<verse eid="PSA 119:101"/></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102"/>मैंने तेरे अहकाम से किनारा नहीं किया,</para>
  <para style="q" vid="PSA 119:102">क्यूँकि तूने मुझे ता'लीम दी है।<verse eid="PSA 119:102"/></para>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103"/>तेरी बातें मेरे लिए कैसी शीरीन हैं,</para>
  <para style="q" vid="PSA 119:103">वह मेरे मुँह को शहद से भी मीठी मा'लूम होती हैं!<verse eid="PSA 119:103"/></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104"/>तेरे क़वानीन से मुझे समझ हासिल होता है,</para>
  <para style="q" vid="PSA 119:104">इसलिए मुझे हर झूटी राह से नफ़रत है।</para>
  <para style="d" vid="PSA 119:104">नून<verse eid="PSA 119:104"/></para>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105"/>तेरा कलाम मेरे क़दमों के लिए चराग़,</para>
  <para style="q" vid="PSA 119:105">और मेरी राह के लिए रोशनी है।<verse eid="PSA 119:105"/></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106"/>मैंने क़सम खाई है और उस पर क़ाईम हूँ,</para>
  <para style="q" vid="PSA 119:106">कि तेरी सदाक़त के अहकाम पर'अमल करूँगा।<verse eid="PSA 119:106"/></para>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107"/>मैं बड़ी मुसीबत में हूँ। ऐ ख़ुदावन्द!</para>
  <para style="q" vid="PSA 119:107">अपने कलाम के मुताबिक़ मुझे ज़िन्दा कर।<verse eid="PSA 119:107"/></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108"/>ऐ ख़ुदावन्द, मेरे मुँह से रज़ा की क़ुर्बानियाँ क़ुबूल फ़रमा</para>
  <para style="q" vid="PSA 119:108">और मुझे अपने अहकाम की ता'लीम दे।<verse eid="PSA 119:108"/></para>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109"/>मेरी जान हमेशा हथेली पर है,</para>
  <para style="q" vid="PSA 119:109">तोभी मैं तेरी शरी'अत को नहीं भूलता।<verse eid="PSA 119:109"/></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110"/>शरीरों ने मेरे लिए फंदा लगाया है,</para>
  <para style="q" vid="PSA 119:110">तोभी मैं तेरे क़वानीन से नहीं भटका।<verse eid="PSA 119:110"/></para>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111"/>मैंने तेरी शहादतों को अपनी हमेशा की मीरास बनाया है,</para>
  <para style="q" vid="PSA 119:111">क्यूँकि उनसे मेरे दिल को ख़ुशी होती है।<verse eid="PSA 119:111"/></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112"/>मैंने हमेशा के लिए आख़िर तक,</para>
  <para style="q" vid="PSA 119:112">तेरे क़ानून मानने पर दिल लगाया है।</para>
  <para style="d" vid="PSA 119:112">सामेख<verse eid="PSA 119:112"/></para>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113"/>मुझे दो दिलों से नफ़रत है,</para>
  <para style="q" vid="PSA 119:113">लेकिन तेरी शरी'अत से मुहब्बत रखता हूँ।<verse eid="PSA 119:113"/></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114"/>तू मेरे छिपने की जगह और मेरी ढाल है;</para>
  <para style="q" vid="PSA 119:114">मुझे तेरे कलाम पर भरोसा है।<verse eid="PSA 119:114"/></para>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115"/>ऐ बदकिरदारो! मुझ से दूर हो जाओ,</para>
  <para style="q" vid="PSA 119:115">ताकि मैं अपने ख़ुदा के फ़रमान पर'अमल करूँ!<verse eid="PSA 119:115"/></para>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116"/>तू अपने कलाम के मुताबिक़ मुझे संभाल ताकि ज़िन्दा रहूँ,</para>
  <para style="q" vid="PSA 119:116">और मुझे अपने भरोसा से शर्मिन्दगी न उठाने दे।<verse eid="PSA 119:116"/></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117"/>मुझे संभाल और मैं सलामत रहूँगा,</para>
  <para style="q" vid="PSA 119:117">और हमेशा तेरे क़ानून का लिहाज़ रखूँगा।<verse eid="PSA 119:117"/></para>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118"/>तूने उन सबको हक़ीर जाना है,</para>
  <para style="q" vid="PSA 119:118">जो तेरे क़ानून से भटक जाते हैं;</para>
  <para style="q" vid="PSA 119:118">क्यूँकि उनकी दग़ाबाज़ी 'बेकार है।<verse eid="PSA 119:118"/></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119"/>तू ज़मीन के सब शरीरों को मैल की तरह छाँट देता है;</para>
  <para style="q" vid="PSA 119:119">इसलिए में तेरी शहादतों को 'अज़ीज़ रखता हूँ।<verse eid="PSA 119:119"/></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120"/>मेरा जिस्म तेरे ख़ौफ़ से काँपता है,</para>
  <para style="q" vid="PSA 119:120">और मैं तेरे अहकाम से डरता हूँ।</para>
  <para style="d" vid="PSA 119:120">ऐन<verse eid="PSA 119:120"/></para>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121"/>मैंने 'अद्ल और इन्साफ़ किया है;</para>
  <para style="q" vid="PSA 119:121">मुझे उनके हवाले न कर जो मुझ पर ज़ुल्म करते हैं।<verse eid="PSA 119:121"/></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122"/>भलाई के लिए अपने बन्दे का ज़ामिन हो,</para>
  <para style="q" vid="PSA 119:122">मग़रूर मुझ पर ज़ुल्म न करें।<verse eid="PSA 119:122"/></para>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123"/>तेरी नजात और तेरी सदाक़त के कलाम के इन्तिज़ार में मेरी आँखें रह गई।<verse eid="PSA 119:123"/></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124"/>अपने बन्दे से अपनी शफ़क़त के मुताबिक़ सुलूक कर,</para>
  <para style="q" vid="PSA 119:124">और मुझे अपने क़ानून सिखा।<verse eid="PSA 119:124"/></para>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125"/>मैं तेरा बन्दा हूँ! मुझ को समझ 'अता कर,</para>
  <para style="q" vid="PSA 119:125">ताकि तेरी शहादतों को समझ लूँ।<verse eid="PSA 119:125"/></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126"/>अब वक़्त आ गया, कि ख़ुदावन्द काम करे,</para>
  <para style="q" vid="PSA 119:126">क्यूँकि उन्होंने तेरी शरी'अत को बेकार कर दिया है।<verse eid="PSA 119:126"/></para>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127"/>इसलिए मैं तेरे फ़रमान को सोने से बल्कि कुन्दन से भी ज़्यादा अज़ीज़ रखता हूँ।<verse eid="PSA 119:127"/></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128"/>इसलिए मैं तेरे सब कवानीन को बरहक़ जानता हूँ,</para>
  <para style="q" vid="PSA 119:128">और हर झूटी राह से मुझे नफ़रत है।</para>
  <para style="d" vid="PSA 119:128">पे<verse eid="PSA 119:128"/></para>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129"/>तेरी शहादतें 'अजीब हैं,</para>
  <para style="q" vid="PSA 119:129">इसलिए मेरा दिल उनको मानता है।<verse eid="PSA 119:129"/></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130"/>तेरी बातों की तशरीह नूर बख़्शती है,</para>
  <para style="q" vid="PSA 119:130">वह सादा दिलों को 'अक़्लमन्द बनाती है।<verse eid="PSA 119:130"/></para>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131"/>मैं खू़ब मुँह खोलकर हाँपता रहा,</para>
  <para style="q" vid="PSA 119:131">क्यूँकि मैं तेरे फ़रमान का मुश्ताक़ था।<verse eid="PSA 119:131"/></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132"/>मेरी तरफ़ तवज्जुह कर और मुझ पर रहम फ़रमा,</para>
  <para style="q" vid="PSA 119:132">जैसा तेरे नाम से मुहब्बत रखने वालों का हक़ है।<verse eid="PSA 119:132"/></para>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133"/>अपने कलाम में मेरी रहनुमाई कर,</para>
  <para style="q" vid="PSA 119:133">कोई बदकारी मुझ पर तसल्लुत न पाए।<verse eid="PSA 119:133"/></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134"/>इंसान के ज़ुल्म से मुझे छुड़ा ले,</para>
  <para style="q" vid="PSA 119:134">तो तेरे क़वानीन पर 'अमल करूँगा।<verse eid="PSA 119:134"/></para>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135"/>अपना चेहरा अपने बन्दे पर जलवागर फ़रमा,</para>
  <para style="q" vid="PSA 119:135">और मुझे अपने क़ानून सिखा।<verse eid="PSA 119:135"/></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136"/>मेरी आँखों से पानी के चश्मे जारी हैं,</para>
  <para style="q" vid="PSA 119:136">इसलिए कि लोग तेरी शरी'अत को नहीं मानते।</para>
  <para style="d" vid="PSA 119:136">सांदे<verse eid="PSA 119:136"/></para>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137"/>ऐ ख़ुदावन्द तू सादिक़ है,</para>
  <para style="q" vid="PSA 119:137">और तेरे अहकाम बरहक़ हैं।<verse eid="PSA 119:137"/></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138"/>तूने सदाक़त और कमाल वफ़ादारी से,</para>
  <para style="q" vid="PSA 119:138">अपनी शहादतों को ज़ाहिर फ़रमाया है।<verse eid="PSA 119:138"/></para>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139"/>मेरी गै़रत मुझे खा गई,</para>
  <para style="q" vid="PSA 119:139">क्यूँकि मेरे मुख़ालिफ़ तेरी बातें भूल गए।<verse eid="PSA 119:139"/></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140"/>तेरा कलाम बिल्कुल ख़ालिस है,</para>
  <para style="q" vid="PSA 119:140">इसलिए तेरे बन्दे को उससे मुहब्बत है।<verse eid="PSA 119:140"/></para>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141"/>मैं अदना और हक़ीर हूँ,</para>
  <para style="q" vid="PSA 119:141">तौ भी मैं तेरे क़वानीन को नहीं भूलता।<verse eid="PSA 119:141"/></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142"/>तेरी सदाक़त हमेशा की सदाक़त है,</para>
  <para style="q" vid="PSA 119:142">और तेरी शरी'अत बरहक़ है।<verse eid="PSA 119:142"/></para>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143"/>मैं तकलीफ़ और ऐज़ाब में मुब्तिला,</para>
  <para style="q" vid="PSA 119:143">हूँ तोभी तेरे फ़रमान मेरी ख़ुशनूदी हैं।<verse eid="PSA 119:143"/></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144"/>तेरी शहादतें हमेशा रास्त हैं;</para>
  <para style="q" vid="PSA 119:144">मुझे समझ 'अता कर तो मैं ज़िन्दा रहूँगा।</para>
  <para style="d" vid="PSA 119:144">क़ाफ<verse eid="PSA 119:144"/></para>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145"/>मैं पूरे दिल से दुआ करता हूँ,</para>
  <para style="q" vid="PSA 119:145">ऐ ख़ुदावन्द, मुझे जवाब दे।</para>
  <para style="q" vid="PSA 119:145">मैं तेरे क़ानून पर 'अमल करूँगा।<verse eid="PSA 119:145"/></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146"/>मैंने तुझ से दुआ की है, मुझे बचा ले,</para>
  <para style="q" vid="PSA 119:146">और मैं तेरी शहादतों को मानूँगा।<verse eid="PSA 119:146"/></para>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147"/>मैंने पौ फटने से पहले फ़रियाद की;</para>
  <para style="q" vid="PSA 119:147">मुझे तेरे कलाम पर भरोसा है।<verse eid="PSA 119:147"/></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148"/>मेरी आँखें रात के हर पहर से पहले खुल गई,</para>
  <para style="q" vid="PSA 119:148">ताकि तेरे कलाम पर ध्यान करूँ।<verse eid="PSA 119:148"/></para>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149"/>अपनी शफ़क़त के मुताबिक़ मेरी फ़रियाद सुन:</para>
  <para style="q" vid="PSA 119:149">ऐ ख़ुदावन्द! अपने अहकाम के मुताबिक़ मुझे ज़िन्दा कर।<verse eid="PSA 119:149"/></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150"/>जो शरारत के दर पै रहते हैं, वह नज़दीक आ गए;</para>
  <para style="q" vid="PSA 119:150">वह तेरी शरी'अत से दूर हैं।<verse eid="PSA 119:150"/></para>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151"/>ऐ ख़ुदावन्द, तू नज़दीक है,</para>
  <para style="q" vid="PSA 119:151">और तेरे सब फ़रमान बरहक़ हैं।<verse eid="PSA 119:151"/></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152"/>तेरी शहादतों से मुझे क़दीम से मा'लूम हुआ,</para>
  <para style="q" vid="PSA 119:152">कि तूने उनको हमेशा के लिए क़ाईम किया है।</para>
  <para style="d" vid="PSA 119:152">रेश<verse eid="PSA 119:152"/></para>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153"/>मेरी मुसीबत का ख़याल करऔर मुझे छुड़ा,</para>
  <para style="q" vid="PSA 119:153">क्यूँकि मैं तेरी शरी'अत को नहीं भूलता।<verse eid="PSA 119:153"/></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154"/>मेरी वकालत कर और मेरा फ़िदिया दे:</para>
  <para style="q" vid="PSA 119:154">अपने कलाम के मुताबिक़ मुझे ज़िन्दा कर।<verse eid="PSA 119:154"/></para>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155"/>नजात शरीरों से दूर है,</para>
  <para style="q" vid="PSA 119:155">क्यूँकि वह तेरे क़ानून के तालिब नहीं हैं।<verse eid="PSA 119:155"/></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156"/>ऐ ख़ुदावन्द! तेरी रहमत बड़ी है;</para>
  <para style="q" vid="PSA 119:156">अपने अहकाम के मुताबिक़ मुझे ज़िन्दा कर।<verse eid="PSA 119:156"/></para>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157"/>मेरे सताने वाले और मुखालिफ़ बहुत हैं,</para>
  <para style="q" vid="PSA 119:157">तोभी मैंने तेरी शहादतों से किनारा न किया।<verse eid="PSA 119:157"/></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158"/>मैं दग़ाबाज़ों को देख कर मलूल हुआ,</para>
  <para style="q" vid="PSA 119:158">क्यूँकि वह तेरे कलाम को नहीं मानते।<verse eid="PSA 119:158"/></para>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159"/>ख़याल फ़रमा कि मुझे तेरे क़वानीन से कैसी मुहब्बत है!</para>
  <para style="q" vid="PSA 119:159">ऐ ख़ुदावन्द! अपनी शफ़क़त के मुताबिक मुझे ज़िन्दा कर।<verse eid="PSA 119:159"/></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160"/>तेरे कलाम का ख़ुलासा सच्चाई है,</para>
  <para style="q" vid="PSA 119:160">तेरी सदाक़त के कुल अहकाम हमेशा के हैं।</para>
  <para style="d" vid="PSA 119:160">शीन<verse eid="PSA 119:160"/></para>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161"/>उमरा ने मुझे बे वजह सताया है,</para>
  <para style="q" vid="PSA 119:161">लेकिन मेरे दिल में तेरी बातों का ख़ौफ़ है।<verse eid="PSA 119:161"/></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162"/>मैं बड़ी लूट पाने वाले की तरह,</para>
  <para style="q" vid="PSA 119:162">तेरे कलाम से ख़ुश हूँ।<verse eid="PSA 119:162"/></para>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163"/>मुझे झूट से नफ़रत और कराहियत है,</para>
  <para style="q" vid="PSA 119:163">लेकिन तेरी शरी'अत से मुहब्बत है।<verse eid="PSA 119:163"/></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164"/>मैं तेरी सदाक़त के अहकाम की वजह से,</para>
  <para style="q" vid="PSA 119:164">दिन में सात बार तेरी सिताइश करता हूँ।<verse eid="PSA 119:164"/></para>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165"/>तेरी शरी'अत से मुहब्बत रखने वाले मुत्मइन हैं;</para>
  <para style="q" vid="PSA 119:165">उनके लिए ठोकर खाने का कोई मौक़ा' नहीं।<verse eid="PSA 119:165"/></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166"/>ऐ ख़ुदावन्द! मैं तेरी नजात का उम्मीदवार रहा हूँ</para>
  <para style="q" vid="PSA 119:166">और तेरे फ़रमान बजा लाया हूँ।<verse eid="PSA 119:166"/></para>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167"/>मेरी जान ने तेरी शहादतें मानी हैं,</para>
  <para style="q" vid="PSA 119:167">और वह मुझे बहुत 'अज़ीज़ हैं।<verse eid="PSA 119:167"/></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168"/>मैंने तेरे क़वानीन और शहादतों को माना है,</para>
  <para style="q" vid="PSA 119:168">क्यूँकि मेरे सब चाल चलन तेरे सामने हैं।</para>
  <para style="d" vid="PSA 119:168">ताव<verse eid="PSA 119:168"/></para>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169"/>ऐ ख़ुदावन्द! मेरी फ़रियाद तेरे सामने पहुँचे;</para>
  <para style="q" vid="PSA 119:169">अपने कलाम के मुताबिक़ मुझे समझ 'अता कर।<verse eid="PSA 119:169"/></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170"/>मेरी इल्तिजा तेरे सामने पहुँचे,</para>
  <para style="q" vid="PSA 119:170">अपने कलाम के मुताबिक़ मुझे छुड़ा।<verse eid="PSA 119:170"/></para>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171"/>मेरे लबों से तेरी सिताइश हो।</para>
  <para style="q" vid="PSA 119:171">क्यूँकि तू मुझे अपने क़ानून सिखाता है।<verse eid="PSA 119:171"/></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172"/>मेरी ज़बान तेरे कलाम का हम्द गाए,</para>
  <para style="q" vid="PSA 119:172">क्यूँकि तेरे सब फ़रमान बरहक़ हैं।<verse eid="PSA 119:172"/></para>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173"/>तेरा हाथ मेरी मदद को तैयार है</para>
  <para style="q" vid="PSA 119:173">क्यूँकि मैंने तेरे क़वानीन इख़्तियार, किए हैं।<verse eid="PSA 119:173"/></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174"/>ऐ ख़ुदावन्द! मैं तेरी नजात का मुश्ताक़ रहा हूँ,</para>
  <para style="q" vid="PSA 119:174">और तेरी शरी'अत मेरी ख़ुशनूदी है।<verse eid="PSA 119:174"/></para>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175"/>मेरी जान ज़िन्दा रहे तो वह तेरी सिताइश करेगी,</para>
  <para style="q" vid="PSA 119:175">और तेरे अहकाम मेरी मदद करें।<verse eid="PSA 119:175"/></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176"/>मैं खोई हुई भेड़ की तरह भटक गया हूँ</para>
  <para style="q" vid="PSA 119:176">अपने बन्दे की तलाश कर,</para>
  <para style="q" vid="PSA 119:176">क्यूँकि मैं तेरे फ़रमान को नहीं भूलता।<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 120:1"/>मैंने मुसीबत में ख़ुदावन्द से फ़रियाद की,</para>
  <para style="q" vid="PSA 120:1">और उसने मुझे जवाब दिया।<verse eid="PSA 120:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2"/>झूटे होंटों और दग़ाबाज़ ज़बान से,</para>
  <para style="q" vid="PSA 120:2">ऐ ख़ुदावन्द, मेरी जान को छुड़ा।<verse eid="PSA 120:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3"/>ऐ दग़ाबाज़ ज़बान, तुझे क्या दिया जाए?</para>
  <para style="q" vid="PSA 120:3">और तुझ से और क्या किया जाए?<verse eid="PSA 120:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4"/>ज़बरदस्त के तेज़ तीर,</para>
  <para style="q" vid="PSA 120:4">झाऊ के अंगारों के साथ।<verse eid="PSA 120:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5"/>मुझ पर अफ़सोस कि मैं मसक में बसता,</para>
  <para style="q" vid="PSA 120:5">और क़ीदार के ख़ैमों में रहता हूँ।<verse eid="PSA 120:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6"/>सुलह के दुश्मन के साथ रहते हुए,</para>
  <para style="q" vid="PSA 120:6">मुझे बड़ी मुद्दत हो गई।<verse eid="PSA 120:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7"/>मैं तो सुलह दोस्त हूँ।</para>
  <para style="q" vid="PSA 120:7">लेकिन जब बोलता हूँ तो वह जंग पर आमादा हो जाते हैं।<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 121:1"/>मैं अपनी आँखें पहाड़ों की तरफ उठाऊगा;</para>
  <para style="q" vid="PSA 121:1">मेरी मदद कहाँ से आएगी?<verse eid="PSA 121:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2"/>मेरी मदद ख़ुदावन्द से है,</para>
  <para style="q" vid="PSA 121:2">जिसने आसमान और ज़मीन को बनाया।<verse eid="PSA 121:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3"/>वह तेरे पाँव को फिसलने न देगा;</para>
  <para style="q" vid="PSA 121:3">तेरा मुहाफ़िज़ ऊँघने का नहीं।<verse eid="PSA 121:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4"/>देख! इस्राईल का मुहाफ़िज़,</para>
  <para style="q" vid="PSA 121:4">न ऊँघेगा, न सोएगा।<verse eid="PSA 121:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5"/>ख़ुदावन्द तेरा मुहाफ़िज़ है;</para>
  <para style="q" vid="PSA 121:5">ख़ुदावन्द तेरे दहने हाथ पर तेरा सायबान है।<verse eid="PSA 121:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6"/>न आफ़ताब दिन को तुझे नुक़सान पहुँचाएगा,</para>
  <para style="q" vid="PSA 121:6">न माहताब रात को।<verse eid="PSA 121:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7"/>ख़ुदावन्द हर बला से तुझे महफूज़ रख्खेगा,</para>
  <para style="q" vid="PSA 121:7">वह तेरी जान को महफूज़ रख्खेगा।<verse eid="PSA 121:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8"/>ख़ुदावन्द तेरी आमद — ओ — रफ़्त में,</para>
  <para style="q" vid="PSA 121:8">अब से हमेशा तक तेरी हिफ़ाज़त करेगा।<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 122:1"/>मैं ख़ुश हुआ जब वह मुझ से कहने लगे</para>
  <para style="q" vid="PSA 122:1">“आओ ख़ुदावन्द के घर चलें।”<verse eid="PSA 122:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2"/>ऐ येरूशलेम! हमारे क़दम,</para>
  <para style="q" vid="PSA 122:2">तेरे फाटकों के अन्दर हैं।<verse eid="PSA 122:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3"/>ऐ येरूशलेम तू ऐसे शहर के तरह है जो गुनजान बना हो।<verse eid="PSA 122:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4"/>जहाँ क़बीले या'नी ख़ुदावन्द के क़बीले,</para>
  <para style="q" vid="PSA 122:4">इस्राईल की शहादत के लिए, ख़ुदावन्द के नाम का शुक्र करने को जातें हैं।<verse eid="PSA 122:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5"/>क्यूँकि वहाँ 'अदालत के तख़्त,</para>
  <para style="q" vid="PSA 122:5">या'नी दाऊद के ख़ान्दान के तख़्त क़ाईम हैं।<verse eid="PSA 122:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6"/>येरूशलेम की सलामती की दुआ करो,</para>
  <para style="q" vid="PSA 122:6">वह जो तुझ से मुहब्बत रखते हैं इकबालमंद होंगे।<verse eid="PSA 122:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7"/>तेरी फ़सील के अन्दर सलामती,</para>
  <para style="q" vid="PSA 122:7">और तेरे महलों में इकबालमंदी हो।<verse eid="PSA 122:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8"/>मैं अपने भाइयों और दोस्तों की ख़ातिर,</para>
  <para style="q" vid="PSA 122:8">अब कहूँगा तुझ में सलामती रहे!<verse eid="PSA 122:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9"/>ख़ुदावन्द अपने ख़ुदा के घर की ख़ातिर,</para>
  <para style="q" vid="PSA 122:9">मैं तेरी भलाई का तालिब रहूँगा।<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 123:1"/>तू जो आसमान पर तख़्तनशीन है,</para>
  <para style="q" vid="PSA 123:1">मैं अपनी आँखें तेरी तरफ़ उठाता हूँ!<verse eid="PSA 123:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2"/>देख, जिस तरह गुलामों की आँखेंअपने आका के हाथ की तरफ़,</para>
  <para style="q" vid="PSA 123:2">और लौंडी की आँखें अपनी बीबी के हाथ की तरफ़ लगी रहती है</para>
  <para style="q" vid="PSA 123:2">उसी तरह हमारी आँखे ख़ुदावन्द अपने ख़ुदा की तरफ़ लगी है</para>
  <para style="q" vid="PSA 123:2">जब तक वह हम पर रहम न करे।<verse eid="PSA 123:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3"/>हम पर रहम कर! ऐ ख़ुदावन्द, हम पर रहम कर,</para>
  <para style="q" vid="PSA 123:3">क्यूँकि हम ज़िल्लत उठाते उठाते तंग आ गए।<verse eid="PSA 123:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4"/>आसूदा हालों के तमसख़ुर,</para>
  <para style="q" vid="PSA 123:4">और माग़रूरों की हिक़ारत से, हमारी जान सेर हो गई।<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 124:1"/>अब इस्राईल यूँ कहे,</para>
  <para style="q" vid="PSA 124:1">अगर ख़ुदावन्द हमारी तरफ़ न होता,<verse eid="PSA 124:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2"/>अगर ख़ुदावन्द उस वक़्त हमारी तरफ़ न होता,</para>
  <para style="q" vid="PSA 124:2">जब लोग हमारे ख़िलाफ़ उठे,<verse eid="PSA 124:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3"/>तो जब उनका क़हर हम पर भड़का था,</para>
  <para style="q" vid="PSA 124:3">वह हम को ज़िन्दा ही निगल जाते।<verse eid="PSA 124:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4"/>उस वक़्त पानी हम को डुबो देता,</para>
  <para style="q" vid="PSA 124:4">और सैलाब हमारी जान पर से गुज़र जाता।<verse eid="PSA 124:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5"/>उस वक़्त मौजज़न,</para>
  <para style="q" vid="PSA 124:5">पानी हमारी जान पर से गुज़र जाता।<verse eid="PSA 124:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6"/>ख़ुदावन्द मुबारक हो,</para>
  <para style="q" vid="PSA 124:6">जिसने हमें उनके दाँतों का शिकार न होने दिया।<verse eid="PSA 124:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7"/>हमारी जान चिड़िया की तरह चिड़ीमारों के जाल से बच निकली,</para>
  <para style="q" vid="PSA 124:7">जाल तो टूट गया और हम बच निकले।<verse eid="PSA 124:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8"/>हमारी मदद ख़ुदावन्द के नाम से है,</para>
  <para style="q" vid="PSA 124:8">जिसने आसमान और ज़मीन को बनाया।<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 125:1"/>जो ख़ुदावन्द पर भरोसा करते वह कोह — ए — सिय्यून की तरह हैं,</para>
  <para style="q" vid="PSA 125:1">जो अटल बल्कि हमेशा क़ाईम है।<verse eid="PSA 125:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2"/>जैसे येरूशलेम पहाड़ों से घिरा है,</para>
  <para style="q" vid="PSA 125:2">वैसे ही अब से हमेशा तक ख़ुदावन्द अपने लोगों को घेरे रहेगा।<verse eid="PSA 125:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3"/>क्यूँकि शरारत का 'असा सादिकों की मीरास पर क़ाईम न होगा,</para>
  <para style="q" vid="PSA 125:3">ताकि सादिक बदकारी की तरफ़ अपने हाथ न बढ़ाएँ।<verse eid="PSA 125:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4"/>ऐ ख़ुदावन्द! भलों के साथ भलाई कर,</para>
  <para style="q" vid="PSA 125:4">और उनके साथ भी जो रास्त दिल हैं।<verse eid="PSA 125:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5"/>लेकिन जो अपनी टेढ़ी राहों की तरफ़ मुड़ते हैं,</para>
  <para style="q" vid="PSA 125:5">उनको ख़ुदावन्द बदकिरदारों के साथ निकाल ले जाएगा। इस्राईल की सलामती हो!<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 126:1"/>जब ख़ुदावन्द सिय्यून के गुलामों को वापस लाया,</para>
  <para style="q" vid="PSA 126:1">तो हम ख़्वाब देखने वालों की तरह थे।<verse eid="PSA 126:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2"/>उस वक़्त हमारे मुँह में हँसी,</para>
  <para style="q" vid="PSA 126:2">और हमारी ज़बान पर रागनी थी;</para>
  <para style="q" vid="PSA 126:2">तब क़ौमों में यह चर्चा होने लगा,</para>
  <para style="q" vid="PSA 126:2">“ख़ुदावन्द ने इनके लिए बड़े बड़े काम किए हैं।”<verse eid="PSA 126:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3"/>ख़ुदावन्द ने हमारे लिए बड़े बड़े काम किए हैं,</para>
  <para style="q" vid="PSA 126:3">और हम ख़ुश हैं!<verse eid="PSA 126:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4"/>ऐ ख़ुदावन्द! दखिन की नदियों की तरह,</para>
  <para style="q" vid="PSA 126:4">हमारे गुलामों को वापस ला।<verse eid="PSA 126:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5"/>जो आँसुओं के साथ बोते हैं,</para>
  <para style="q" vid="PSA 126:5">वह खु़शी के साथ काटेंगे।<verse eid="PSA 126:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6"/>जो रोता हुआ बीज बोने जाता है,</para>
  <para style="q" vid="PSA 126:6">वह अपने पूले लिए हुए ख़ुश लौटेगा।<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 127:1"/>अगर ख़ुदावन्द ही घर न बनाए,</para>
  <para style="q" vid="PSA 127:1">तो बनाने वालों की मेहनत' बेकार है।</para>
  <para style="q" vid="PSA 127:1">अगर ख़ुदावन्द ही शहर की हिफ़ाज़त न करे,</para>
  <para style="q" vid="PSA 127:1">तो निगहबान का जागना 'बेकार है।<verse eid="PSA 127:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2"/>तुम्हारे लिए सवेरे उठना और देर में आराम करना,</para>
  <para style="q" vid="PSA 127:2">और मशक़्क़त की रोटी खाना 'बेकार है;</para>
  <para style="q" vid="PSA 127:2">क्यूँकि वह अपने महबूब को तो नींद ही में दे देता है।<verse eid="PSA 127:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3"/>देखो, औलाद ख़ुदावन्द की तरफ़ से मीरास है,</para>
  <para style="q" vid="PSA 127:3">और पेट का फल उसी की तरफ़ से अज्र है,<verse eid="PSA 127:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4"/>जवानी के फ़र्ज़न्द ऐसे हैं,</para>
  <para style="q" vid="PSA 127:4">जैसे ज़बरदस्त के हाथ में तीर।<verse eid="PSA 127:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5"/>ख़ुश नसीब है वह आदमी जिसका तरकश उनसे भरा है।</para>
  <para style="q" vid="PSA 127:5">जब वह अपने दुश्मनों से फाटक पर बातें करेंगे तो शर्मिन्दा न होंगे।<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 128:1"/>मुबारक है हर एक जो ख़ुदावन्द से डरता,</para>
  <para style="q" vid="PSA 128:1">और उसकी राहों पर चलता है।<verse eid="PSA 128:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2"/>तू अपने हाथों की कमाई खाएगा;</para>
  <para style="q" vid="PSA 128:2">तू मुबारक और फ़र्माबरदार होगा।<verse eid="PSA 128:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3"/>तेरी बीवी तेरे घर के अन्दर मेवादार ताक की तरह होगी,</para>
  <para style="q" vid="PSA 128:3">और तेरी औलाद तेरे दस्तरख़्वान पर ज़ैतून के पौदों की तरह।<verse eid="PSA 128:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4"/>देखो! ऐसी बरकत उसी आदमी को मिलेगी,</para>
  <para style="q" vid="PSA 128:4">जो ख़ुदावन्द से डरता है।<verse eid="PSA 128:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5"/>ख़ुदावन्द सिय्यून में से तुझ को बरकत दे,</para>
  <para style="q" vid="PSA 128:5">और तू उम्र भर येरूशलेम की भलाई देखे।<verse eid="PSA 128:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6"/>बल्कि तू अपने बच्चों के बच्चे देखे।</para>
  <para style="q" vid="PSA 128:6">इस्राईल की सलामती हो!<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 129:1"/>इस्राईल अब यूँ कहे,</para>
  <para style="q" vid="PSA 129:1">“उन्होंने मेरी जवानी से अब तक मुझे बार बार सताया,<verse eid="PSA 129:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2"/>हाँ, उन्होंने मेरी जवानी से अब तक मुझे बार बार सताया,</para>
  <para style="q" vid="PSA 129:2">तोभी वह मुझ पर ग़ालिब न आए।<verse eid="PSA 129:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3"/>हलवाहों ने मेरी पीठ पर हल चलाया,</para>
  <para style="q" vid="PSA 129:3">और लम्बी लम्बी रेघारियाँ बनाई।”<verse eid="PSA 129:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4"/>ख़ुदावन्द सादिक़ है;</para>
  <para style="q" vid="PSA 129:4">उसने शरीरों की रसियाँ काट डालीं।<verse eid="PSA 129:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5"/>सिय्यून से नफ़रत रखने वाले,</para>
  <para style="q" vid="PSA 129:5">सब शर्मिन्दा और पस्पा हों।<verse eid="PSA 129:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6"/>वह छत पर की घास की तरह हों,</para>
  <para style="q" vid="PSA 129:6">जो बढ़ने से पहले ही सूख जाती है;<verse eid="PSA 129:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7"/>जिससे फ़सल काटने वाला अपनी मुट्ठी को,</para>
  <para style="q" vid="PSA 129:7">और पूले बाँधने वाला अपने दामन को नहीं भरता,<verse eid="PSA 129:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8"/>न आने जाने वाले यह कहते हैं,</para>
  <para style="q" vid="PSA 129:8">“तुम पर ख़ुदावन्द की बरकत हो!</para>
  <para style="q" vid="PSA 129:8">हम ख़ुदावन्द के नाम से तुम को दुआ देते हैं!”<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 130:1"/>ऐ ख़ुदावन्द! मैंने गहराओ में से तेरे सामने फ़रियाद की है!<verse eid="PSA 130:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2"/>ऐ ख़ुदावन्द! मेरी आवाज़ सुन ले!</para>
  <para style="q" vid="PSA 130:2">मेरी इल्तिजा की आवाज़ पर, तेरे कान लगे रहें।<verse eid="PSA 130:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3"/>ऐ ख़ुदावन्द! अगर तू बदकारी को हिसाब में लाए,</para>
  <para style="q" vid="PSA 130:3">तो ऐ ख़ुदावन्द कौन क़ाईम रह सकेगा?<verse eid="PSA 130:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4"/>लेकिन मग़फ़िरत तेरे हाथ में है,</para>
  <para style="q" vid="PSA 130:4">ताकि लोग तुझ से डरें।<verse eid="PSA 130:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5"/>मैं ख़ुदावन्द का इन्तिज़ार करता हूँ।</para>
  <para style="q" vid="PSA 130:5">मेरी जान मुन्तज़िर है, और मुझे उसके कलाम पर भरोसा है।<verse eid="PSA 130:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6"/>सुबह का इन्तिज़ार करने वालों से ज़्यादा,</para>
  <para style="q" vid="PSA 130:6">हाँ, सुबह का इन्तिज़ार करने वालों से कहीं ज़्यादा,</para>
  <para style="q" vid="PSA 130:6">मेरी जान ख़ुदावन्द की मुन्तज़िर है।<verse eid="PSA 130:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7"/>ऐ इस्राईल! ख़ुदावन्द पर भरोसा कर;</para>
  <para style="q" vid="PSA 130:7">क्यूँकि ख़ुदावन्द के हाथ में शफ़क़त है</para>
  <para style="q" vid="PSA 130:7">, उसी के हाथ में फ़िदिए की कसरत है।<verse eid="PSA 130:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8"/>और वही इस्राईल का फ़िदिया देकर,</para>
  <para style="q" vid="PSA 130:8">उसको सारी बदकारी से छुड़ाएगा।<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 131:1"/>ऐ ख़ुदावन्द! मेरा दिल मग़रूर नहीं</para>
  <para style="q" vid="PSA 131:1">और मै बुलंद नज़र नहीं हूँ</para>
  <para style="q" vid="PSA 131:1">न मुझे बड़े बड़े मु'आमिलो से कोई सरोकार है,</para>
  <para style="q" vid="PSA 131:1">न उन बातों से जो मेरी समझ से बाहर हैं,<verse eid="PSA 131:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2"/>यक़ीनन मैंने अपने दिल को तिस्कीन देकर मुत्मइन कर दिया है,</para>
  <para style="q" vid="PSA 131:2">मेरा दिल मुझ में दूध छुड़ाए हुए बच्चे की तरह है;</para>
  <para style="q" vid="PSA 131:2">हाँ, जैसे दूध छुड़ाया हुआ बच्चा माँ की गोद में।<verse eid="PSA 131:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3"/>ऐ इस्राईल! अब से हमेशा तक, ख़ुदावन्द पर भरोसा कर!<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 132:1"/>ऐ ख़ुदावन्द! दाऊद कि ख़ातिर उसकी सब मुसीबतों को याद कर;<verse eid="PSA 132:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2"/>कि उसने किस तरह ख़ुदावन्द से क़सम खाई,</para>
  <para style="q" vid="PSA 132:2">और या'क़ूब के क़ादिर के सामने मन्नत मानी,<verse eid="PSA 132:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3"/>“यक़ीनन मैं न अपने घर में दाख़िल हूँगा,</para>
  <para style="q" vid="PSA 132:3">न अपने पलंग पर जाऊँगा;<verse eid="PSA 132:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4"/>और न अपनी आँखों में नींद,</para>
  <para style="q" vid="PSA 132:4">न अपनी पलकों में झपकी आने दूँगा;<verse eid="PSA 132:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5"/>जब तक ख़ुदावन्द के लिए कोई जगह,</para>
  <para style="q" vid="PSA 132:5">और या'क़ूब के क़ादिर के लिए घर न हो।”<verse eid="PSA 132:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6"/>देखो, हम ने उसकी ख़बर इफ़्राता में सुनी;</para>
  <para style="q" vid="PSA 132:6">हमें यह जंगल के मैदान में मिली।<verse eid="PSA 132:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7"/>हम उसके घरों में दाखि़ल होंगे,</para>
  <para style="q" vid="PSA 132:7">हम उसके पाँव की चौकी के सामने सिजदा करेंगे!<verse eid="PSA 132:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8"/>उठ, ऐ ख़ुदावन्द! अपनी आरामगाह में दाखि़ल हो!</para>
  <para style="q" vid="PSA 132:8">तू और तेरी कु़दरत का संदूक़।<verse eid="PSA 132:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9"/>तेरे काहिन सदाक़त से मुलब्बस हों,</para>
  <para style="q" vid="PSA 132:9">और तेरे पाक ख़ुशी के नारे मारें।<verse eid="PSA 132:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10"/>अपने बन्दे दाऊद की ख़ातिर,</para>
  <para style="q" vid="PSA 132:10">अपने मम्सूह की दुआ ना — मन्जूर न कर।<verse eid="PSA 132:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11"/>ख़ुदावन्द ने सच्चाई के साथ दाऊद से क़सम खाई है;</para>
  <para style="q" vid="PSA 132:11">वह उससे फिरने का नहीं:कि “मैं तेरी औलाद में से किसी को तेरे तख़्त पर बिठाऊँगा।<verse eid="PSA 132:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12"/>अगर तेरे फ़र्ज़न्द मेरे 'अहद और मेरी शहादत पर,</para>
  <para style="q" vid="PSA 132:12">जो मैं उनको सिखाऊँगा 'अमल करें;</para>
  <para style="q" vid="PSA 132:12">तो उनके फ़र्ज़न्द भी हमेशा तेरे तख़्त पर बैठेगें।”<verse eid="PSA 132:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13"/>क्यूँकि ख़ुदावन्द ने सिय्यून को चुना है,</para>
  <para style="q" vid="PSA 132:13">उसने उसे अपने घर के लिए पसन्द किया है:<verse eid="PSA 132:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14"/>“यह हमेशा के लिए मेरी आरामगाह है;</para>
  <para style="q" vid="PSA 132:14">मै यहीं रहूँगा क्यूँकि मैंने इसे पसंद किया है।<verse eid="PSA 132:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15"/>मैं इसके रिज़क़ में ख़ूब बरकत दूँगा;</para>
  <para style="q" vid="PSA 132:15">मैं इसके ग़रीबों को रोटी से सेर करूँगा<verse eid="PSA 132:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16"/>इसके काहिनों को भी मैं नजात से मुलव्वस करूँगा</para>
  <para style="q" vid="PSA 132:16">और उसके पाक बुलन्द आवाज़ से ख़ुशी के नारे मारेंगे।<verse eid="PSA 132:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17"/>वहीं मैं दाऊद के लिए एक सींग निकालूँगा मैंने</para>
  <para style="q" vid="PSA 132:17">अपने मम्सूह के लिए चराग़ तैयार किया है।<verse eid="PSA 132:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18"/>मैं उसके दुश्मनों को शर्मिन्दगी का लिबास पहनाऊँगा,</para>
  <para style="q" vid="PSA 132:18">लेकिन उस पर उसी का ताज रोनक अफ़रोज़ होगा।”<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 133:1"/>देखो! कैसी अच्छी और खु़शी की बात है,</para>
  <para style="q" vid="PSA 133:1">कि भाई एक साथ मिलकर रहें!<verse eid="PSA 133:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2"/>यह उस बेशक़ीमत तेल की तरह है,</para>
  <para style="q" vid="PSA 133:2">जो सिर पर लगाया गया, और बहता हुआ दाढ़ी पर,</para>
  <para style="q" vid="PSA 133:2">या'नी हारून की दाढ़ी पर आ गया;</para>
  <para style="q" vid="PSA 133:2">बल्कि उसके लिबास के दामन तक जा पहुँचा।<verse eid="PSA 133:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3"/>या हरमून की ओस की तरह है,</para>
  <para style="q" vid="PSA 133:3">जो सिय्यून के पहाड़ों पर पड़ती है!</para>
  <para style="q" vid="PSA 133:3">क्यूँकि वहीं ख़ुदावन्द ने बरकत का,</para>
  <para style="q" vid="PSA 133:3">या'नी हमेशा की ज़िन्दगी का हुक्म फ़रमाया।<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 134:1"/>ऐ ख़ुदावन्द के बन्दो! आओ सब ख़ुदावन्द को मुबारक कहो!</para>
  <para style="q" vid="PSA 134:1">तुम जो रात को ख़ुदावन्द के घर में खड़े रहते हो!<verse eid="PSA 134:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2"/>हैकल की तरफ़ अपने हाथ उठाओ,</para>
  <para style="q" vid="PSA 134:2">और ख़ुदावन्द को मुबारक कहो!<verse eid="PSA 134:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3"/>ख़ुदावन्द, जिसने आसमान और ज़मीन को बनाया,</para>
  <para style="q" vid="PSA 134:3">सिय्यून में से तुझे बरकत बख़्शे।<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1"/>ख़ुदावन्द की हम्द करो!</para>
  <para style="q" vid="PSA 135:1">ख़ुदावन्द के नाम की हम्द करो!</para>
  <para style="q" vid="PSA 135:1">ऐ ख़ुदावन्द के बन्दो! उसकी हम्द करो।<verse eid="PSA 135:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2"/>तुम जो ख़ुदावन्द के घर में,</para>
  <para style="q" vid="PSA 135:2">हमारे ख़ुदा के घर की बारगाहों में खड़े रहते हो!<verse eid="PSA 135:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3"/>ख़ुदावन्द की हम्द करो, क्यूँकि ख़ुदावन्द भला है;</para>
  <para style="q" vid="PSA 135:3">उसके नाम की मदहसराई करो कि यह दिल पसंद है!<verse eid="PSA 135:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4"/>क्यूँकि ख़ुदावन्द ने या'क़ूब को अपने लिए,</para>
  <para style="q" vid="PSA 135:4">और इस्राईल को अपनी ख़ास मिल्कियत के लिए चुन लिया है।<verse eid="PSA 135:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5"/>इसलिए कि मैं जानता हूँ कि ख़ुदावन्द बुजुर्ग़ है</para>
  <para style="q" vid="PSA 135:5">और हमारा रब्ब सब मा'बूदों से बालातर है।<verse eid="PSA 135:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6"/>आसमान और ज़मीन में, समन्दर और गहराओ में;</para>
  <para style="q" vid="PSA 135:6">ख़ुदावन्द ने जो कुछ चाहा वही किया।<verse eid="PSA 135:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7"/>वह ज़मीन की इन्तिहा से बुख़ारात उठाता है,</para>
  <para style="q" vid="PSA 135:7">वह बारिश के लिए बिजलियाँ बनाता है,</para>
  <para style="q" vid="PSA 135:7">और अपने मख़ज़नों से आँधी निकालता है।<verse eid="PSA 135:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8"/>उसी ने मिस्र के पहलौठों को मारा,</para>
  <para style="q" vid="PSA 135:8">क्या इंसान के क्या हैवान के।<verse eid="PSA 135:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9"/>ऐ मिस्र, उसी ने तुझ में फ़िर'औन और उसके सब ख़ादिमो पर,</para>
  <para style="q" vid="PSA 135:9">निशान और 'अजायब ज़ाहिर किए।<verse eid="PSA 135:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10"/>उसने बहुत सी क़ौमों को मारा,</para>
  <para style="q" vid="PSA 135:10">और ज़बरदस्त बादशाहों को क़त्ल किया।<verse eid="PSA 135:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11"/>अमोरियों के बादशाह सीहोन को,</para>
  <para style="q" vid="PSA 135:11">और बसन के बादशाह 'ओज को,</para>
  <para style="q" vid="PSA 135:11">और कनान की सब मम्लुकतों को;<verse eid="PSA 135:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12"/>और उनकी ज़मीन मीरास कर दी,</para>
  <para style="q" vid="PSA 135:12">या'नी अपनी क़ौम इस्राईल की मीरास।<verse eid="PSA 135:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13"/>ऐ ख़ुदावन्द! तेरा नाम हमेशा का है,</para>
  <para style="q" vid="PSA 135:13">और तेरी यादगार,</para>
  <para style="q" vid="PSA 135:13">ऐ ख़ुदावन्द, नसल दर नसल क़ाईम है।<verse eid="PSA 135:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14"/>क्यूँकि ख़ुदावन्द अपनी क़ौम की 'अदालत करेगा,</para>
  <para style="q" vid="PSA 135:14">और अपने बन्दों पर तरस खाएगा।<verse eid="PSA 135:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15"/>क़ौमों के बुत चाँदी और सोना हैं,</para>
  <para style="q" vid="PSA 135:15">या'नी आदमी की दस्तकारी।<verse eid="PSA 135:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16"/>उनके मुँह हैं, लेकिन वह बोलते नहीं;</para>
  <para style="q" vid="PSA 135:16">आँखें हैं लेकिन वह देखते नहीं।<verse eid="PSA 135:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17"/>उनके कान हैं, लेकिन वह सुनते नहीं;</para>
  <para style="q" vid="PSA 135:17">और उनके मुँह में साँस नहीं।<verse eid="PSA 135:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18"/>उनके बनाने वाले उन ही की तरह हो जाएँगे;</para>
  <para style="q" vid="PSA 135:18">बल्कि वह सब जो उन पर भरोसा रखते हैं।<verse eid="PSA 135:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19"/>ऐ इस्राईल के घराने! ख़ुदावन्द को मुबारक कहो!</para>
  <para style="q" vid="PSA 135:19">ऐ हारून के घराने! ख़ुदावन्द को मुबारक कहो।<verse eid="PSA 135:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20"/>ऐ लावी के घराने! ख़ुदावन्द को मुबारक कहो!</para>
  <para style="q" vid="PSA 135:20">ऐ ख़ुदावन्द से डरने वालो! ख़ुदावन्द को मुबारक कहो!<verse eid="PSA 135:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21"/>सिय्यून में ख़ुदावन्द मुबारक हो!</para>
  <para style="q" vid="PSA 135:21">वह येरूशलेम में सुकूनत करता है ख़ुदावन्द की हम्द करो।<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1"/>ख़ुदावन्द का शुक्र करो,</para>
  <para style="q" vid="PSA 136:1">क्यूँकि वह भला है,</para>
  <para style="q" vid="PSA 136:1">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2"/>इलाहों के ख़ुदा का शुक्र करो,</para>
  <para style="q" vid="PSA 136:2">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3"/>मालिकों के मालिक का शुक्र करो,</para>
  <para style="q" vid="PSA 136:3">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4"/>उसी का जो अकेला बड़े बड़े 'अजीब काम करता है,</para>
  <para style="q" vid="PSA 136:4">कि उसकी शफ़क़त हमेशा कीहै।<verse eid="PSA 136:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5"/>उसी का जिसने 'अक़्लमन्दी से आसमान बनाया,</para>
  <para style="q" vid="PSA 136:5">कि उसकी शफ़क़त हमेशा कीहै।<verse eid="PSA 136:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6"/>उसी का जिसने ज़मीन को पानी पर फैलाया,</para>
  <para style="q" vid="PSA 136:6">कि उसकी शफ़क़त हमेशा कीहै।<verse eid="PSA 136:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7"/>उसी का जिसने बड़े — बड़े सितारे बनाए,</para>
  <para style="q" vid="PSA 136:7">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 136:8"/>दिन को हुकूमत करने के लिए आफ़ताब,</para>
  <para style="q" vid="PSA 136:8">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 136:9"/>रात को हुकूमत करने के लिए माहताब और सितारे,</para>
  <para style="q" vid="PSA 136:9">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10"/>उसी का जिसने मिस्र के पहलौठों को मारा,</para>
  <para style="q" vid="PSA 136:10">कि उसकी शफ़क़त हमेशाकी है।<verse eid="PSA 136:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 136:11"/>और इस्राईल को उनमें से निकाल लाया,</para>
  <para style="q" vid="PSA 136:11">कि उसकी शफ़क़त हमेशा कीहै।<verse eid="PSA 136:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 136:12"/>क़वी हाथ और बलन्द बाज़ू से,</para>
  <para style="q" vid="PSA 136:12">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13"/>उसी का जिसने बहर — ए — कु़लजु़म को दो हिस्से कर दिया,</para>
  <para style="q" vid="PSA 136:13">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14"/>और इस्राईल को उसमें से पार किया,</para>
  <para style="q" vid="PSA 136:14">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15"/>लेकिन फ़िर'औन और उसके लश्कर को बहर — ए — कु़लजु़म में डाल दिया,</para>
  <para style="q" vid="PSA 136:15">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16"/>उसी का जो वीरान में अपने लोगों का राहनुमा हुआ,</para>
  <para style="q" vid="PSA 136:16">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17"/>उसी का जिसने बड़े — बड़े बादशाहों को मारा,</para>
  <para style="q" vid="PSA 136:17">कि उसकी शफ़क़त हमेशा की है;<verse eid="PSA 136:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18"/>और नामवर बादशाहों को क़त्ल किया,</para>
  <para style="q" vid="PSA 136:18">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19"/>अमोरियों के बादशाह सीहोन को,</para>
  <para style="q" vid="PSA 136:19">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20"/>और बसन के बादशाह 'ओज की,</para>
  <para style="q" vid="PSA 136:20">कि उसकी शफ़क़त हमेशा की है;<verse eid="PSA 136:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 136:21"/>और उनकी ज़मीन मीरास कर दी,</para>
  <para style="q" vid="PSA 136:21">कि उसकी शफ़क़त हमेशा की है;<verse eid="PSA 136:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 136:22"/>या'नी अपने बन्दे इस्राईल की मीरास,</para>
  <para style="q" vid="PSA 136:22">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23"/>जिसने हमारी पस्ती में हम को याद किया,</para>
  <para style="q" vid="PSA 136:23">कि उसकी शफ़क़त हमेशा की है;<verse eid="PSA 136:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24"/>और हमारे मुख़ालिफ़ों से हम को छुड़ाया,</para>
  <para style="q" vid="PSA 136:24">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25"/>जो सब बशर को रोज़ी देता है,</para>
  <para style="q" vid="PSA 136:25">कि उसकी शफ़क़त हमेशा की है।<verse eid="PSA 136:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26"/>आसमान के ख़ुदा का शुक्र करो,</para>
  <para style="q" vid="PSA 136:26">कि उसकी सफ़कत हमेशा की है।<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1"/>हम बाबुल की नदियों पर बैठे,</para>
  <para style="q" vid="PSA 137:1">और सिय्यून को याद करके रोए।<verse eid="PSA 137:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2"/>वहाँ बेद के दरख़्तों पर उनके वस्त में,</para>
  <para style="q" vid="PSA 137:2">हम ने अपने सितारों को टाँग दिया।<verse eid="PSA 137:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3"/>क्यूँकि वहाँ हम को ग़ुलाम करने वालों ने हम्द गाने का हुक्म दिया,</para>
  <para style="q" vid="PSA 137:3">और तबाह करने वालों ने खु़शी करने का,</para>
  <para style="q" vid="PSA 137:3">और कहा, “सिय्यून के हम्दों में से हमको कोई हम्द सुनाओ!”<verse eid="PSA 137:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4"/>हम परदेस में,</para>
  <para style="q" vid="PSA 137:4">ख़ुदावन्द का हम्द कैसे गाएँ?<verse eid="PSA 137:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5"/>ऐ येरूशलेम! अगर मैं तुझे भूलूँ,</para>
  <para style="q" vid="PSA 137:5">तो मेरा दहना हाथ अपना हुनर भूल जाए।<verse eid="PSA 137:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6"/>अगर मैं तुझे याद न रख्खूँ, अगर मैं येरूशलेम को,</para>
  <para style="q" vid="PSA 137:6">अपनी बड़ी से बड़ी ख़ुशी पर तरजीह न दूँ मेरी ज़बान मेरे तालू से चिपक जाए!<verse eid="PSA 137:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7"/>ऐ ख़ुदावन्द! येरूशलेम के दिन को,</para>
  <para style="q" vid="PSA 137:7">बनी अदोम के ख़िलाफ़ याद कर,</para>
  <para style="q" vid="PSA 137:7">जो कहते थे, “इसे ढा दो, इसे बुनियाद तक ढा दो!”<verse eid="PSA 137:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8"/>ऐ बाबुल की बेटी! जो हलाक होने वाली है,</para>
  <para style="q" vid="PSA 137:8">वह मुबारक होगा, जो तुझे उस सुलूक का,</para>
  <para style="q" vid="PSA 137:8">जो तूने हम से किया बदला दे।<verse eid="PSA 137:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9"/>वह मुबारक होगा, जो तेरे बच्चों को लेकर,</para>
  <para style="q" vid="PSA 137:9">चट्टान पर पटक दे!<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 138:1"/>मैं पूरे दिल से तेरा शुक्र करूँगा;</para>
  <para style="q" vid="PSA 138:1">मा'बूदों के सामने तेरी मदहसराई करूँगा।<verse eid="PSA 138:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2"/>मैं तेरी पाक हैकल की तरफ़ रुख़ कर के सिज्दा करूँगा,</para>
  <para style="q" vid="PSA 138:2">और तेरी शफ़क़त औए सच्चाई की ख़ातिर तेरे नाम का शुक्र करूँगा।</para>
  <para style="q" vid="PSA 138:2">क्यूँकि तूने अपने कलाम को अपने हरनाम से ज़्यादा 'अज़मत दी है।<verse eid="PSA 138:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3"/>जिस दिन मैंने तुझ से दुआ की, तूने मुझे जवाब दिया,</para>
  <para style="q" vid="PSA 138:3">और मेरी जान की ताक़त देकर मेरा हौसला बढ़ाया।<verse eid="PSA 138:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4"/>ऐ ख़ुदावन्द! ज़मीन के सब बादशाह तेरा शुक्र करेंगे,</para>
  <para style="q" vid="PSA 138:4">क्यूँकि उन्होंने तेरे मुँह का कलाम सुना है;<verse eid="PSA 138:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5"/>बल्कि वह ख़ुदावन्द की राहों का हम्द गाएंगे</para>
  <para style="q" vid="PSA 138:5">क्यूँकि ख़ुदावन्द का जलाल बड़ा है।<verse eid="PSA 138:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6"/>क्यूँकि ख़ुदावन्द अगरचे बुलन्द — ओ — बाला है,</para>
  <para style="q" vid="PSA 138:6">तोभी ख़ाकसार का ख़याल रखता है;</para>
  <para style="q" vid="PSA 138:6">लेकिन मग़रूर को दूर ही से पहचान लेता है।<verse eid="PSA 138:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7"/>चाहे मैं दुख में से गुज़रूं तू मुझे ताज़ादम करेगा,</para>
  <para style="q" vid="PSA 138:7">तू मेरे दुश्मनों के क़हर के ख़िलाफ़ हाथ बढ़ाएगा,</para>
  <para style="q" vid="PSA 138:7">और तेरा दहना हाथ मुझे बचा लेगा।<verse eid="PSA 138:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8"/>ख़ुदावन्द मेरे लिए सब कुछ करेगा;</para>
  <para style="q" vid="PSA 138:8">ऐ ख़ुदावन्द! तेरी शफ़क़त हमेशा की है।</para>
  <para style="q" vid="PSA 138:8">अपनी दस्तकारी को न छोड़।<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 139:1"/>ऐ ख़ुदावन्द! तूने मुझे जाँच लिया और पहचान लिया।<verse eid="PSA 139:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2"/>तू मेरा उठना बैठना जानता है;</para>
  <para style="q" vid="PSA 139:2">तू मेरे ख़याल को दूर से समझ लेता है।<verse eid="PSA 139:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3"/>तू मेरे रास्ते की और मेरी ख़्वाबगाह की छान बीन करता है,</para>
  <para style="q" vid="PSA 139:3">और मेरे सब चाल चलन से वाक़िफ़ है।<verse eid="PSA 139:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4"/>देख! मेरी ज़बान पर कोई ऐसी बात नहीं,</para>
  <para style="q" vid="PSA 139:4">जिसे तू ऐ ख़ुदावन्द पूरे तौर पर न जानता हो।<verse eid="PSA 139:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5"/>तूने मुझे आगे पीछे से घेर रखा है,</para>
  <para style="q" vid="PSA 139:5">और तेरा हाथ मुझ पर है।<verse eid="PSA 139:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6"/>यह इरफ़ान मेरे लिए बहुत 'अजीब है;</para>
  <para style="q" vid="PSA 139:6">यह बुलन्द है, मैं इस तक पहुँच नहीं सकता।<verse eid="PSA 139:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7"/>मैं तेरी रूह से बचकर कहाँ जाऊँ?</para>
  <para style="q" vid="PSA 139:7">या तेरे सामने से किधर भागूँ?<verse eid="PSA 139:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8"/>अगर आसमान पर चढ़ जाऊँ, तो तू वहाँ है।</para>
  <para style="q" vid="PSA 139:8">अगर मैं पाताल में बिस्तर बिछाऊँ, तो देख तू वहाँ भी है!<verse eid="PSA 139:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9"/>अगर मैं सुबह के पर लगाकर,</para>
  <para style="q" vid="PSA 139:9">समन्दर की इन्तिहा में जा बसूँ,<verse eid="PSA 139:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10"/>तो वहाँ भी तेरा हाथ मेरी राहनुमाई करेगा,</para>
  <para style="q" vid="PSA 139:10">और तेरा दहना हाथ मुझे संभालेगा।<verse eid="PSA 139:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11"/>अगर मैं कहूँ कि यक़ीनन तारीकी मुझे छिपा लेगी,</para>
  <para style="q" vid="PSA 139:11">और मेरी चारों तरफ़ का उजाला रात बन जाएगा।<verse eid="PSA 139:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12"/>तो अँधेरा भी तुझ से छिपा नहीं सकता,</para>
  <para style="q" vid="PSA 139:12">बल्कि रात भी दिन की तरह रोशन है;</para>
  <para style="q" vid="PSA 139:12">अँधेरा और उजाला दोनों एक जैसे हैं।<verse eid="PSA 139:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13"/>क्यूँकि मेरे दिल को तू ही ने बनाया;</para>
  <para style="q" vid="PSA 139:13">मेरी माँ के पेट में तू ही ने मुझे सूरत बख़्शी।<verse eid="PSA 139:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14"/>मैं तेरा शुक्र करूँगा, क्यूँकि मैं 'अजीबओ — ग़रीब तौर से बना हूँ।</para>
  <para style="q" vid="PSA 139:14">तेरे काम हैरत अंगेज़ हैं मेरा दिल इसे खू़ब जानता है।<verse eid="PSA 139:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15"/>जब मैं पोशीदगी में बन रहा था,</para>
  <para style="q" vid="PSA 139:15">और ज़मीन के तह में 'अजीब तौर से मुरतब हो रहा था,</para>
  <para style="q" vid="PSA 139:15">तो मेरा क़ालिब तुझ से छिपा न था।<verse eid="PSA 139:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16"/>तेरी आँखों ने मेरे बेतरतीब माद्दे को देखा,</para>
  <para style="q" vid="PSA 139:16">और जो दिन मेरे लिए मुक़र्रर थे, वह सब तेरी किताब में लिखे थे;</para>
  <para style="q" vid="PSA 139:16">जब कि एक भी वुजूद में न आया था।<verse eid="PSA 139:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17"/>ऐ ख़ुदा! तेरे ख़याल मेरे लिए कैसे बेशबहा हैं।</para>
  <para style="q" vid="PSA 139:17">उनका मजमूआ कैसा बड़ा है!<verse eid="PSA 139:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18"/>अगर मैं उनको गिनूँ तो वह शुमार में रेत से भी ज़्यादा हैं।</para>
  <para style="q" vid="PSA 139:18">जाग उठते ही तुझे अपने साथ पाता हूँ।<verse eid="PSA 139:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19"/>ऐ ख़ुदा! काश के तू शरीर को क़त्ल करे।</para>
  <para style="q" vid="PSA 139:19">इसलिए ऐ ख़ूनख़्वारो! मेरे पास से दूर हो जाओ।<verse eid="PSA 139:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20"/>क्यूँकि वह शरारत से तेरे ख़िलाफ़ बातें करते हैं:</para>
  <para style="q" vid="PSA 139:20">और तेरे दुश्मन तेरा नाम बेफ़ायदा लेते हैं।<verse eid="PSA 139:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21"/>ऐ ख़ुदावन्द! क्या मैं तुझ से 'अदावत रखने वालों से 'अदावत नहीं रखता,</para>
  <para style="q" vid="PSA 139:21">और क्या मैं तेरे मुख़ालिफ़ों से बेज़ार नहीं हूँ?<verse eid="PSA 139:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22"/>मुझे उनसे पूरी 'अदावत है,</para>
  <para style="q" vid="PSA 139:22">मैं उनको अपने दुश्मन समझता हूँ।<verse eid="PSA 139:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23"/>ऐ ख़ुदा, तू मुझे जाँच और मेरे दिल को पहचान।</para>
  <para style="q" vid="PSA 139:23">मुझे आज़मा और मेरे ख़यालों को जान ले!<verse eid="PSA 139:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24"/>और देख कि मुझ में कोई बुरा चाल चलन तो नहीं,</para>
  <para style="q" vid="PSA 139:24">और मुझ को हमेशा की राह में ले चल!<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 140:1"/>ऐ ख़ुदावन्द! मुझे बुरे आदमी से रिहाई बख़्श;</para>
  <para style="q" vid="PSA 140:1">मुझे टेढ़े आदमी से महफूज़ रख।<verse eid="PSA 140:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 140:2"/>जो दिल में शरारत के मन्सूबे बाँधते हैं;</para>
  <para style="q" vid="PSA 140:2">वह हमेशा मिलकर जंग के लिए जमा' हो जाते हैं।<verse eid="PSA 140:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 140:3"/>उन्होंने अपनी ज़बान साँप की तरह तेज़ कर रखी है।</para>
  <para style="q" vid="PSA 140:3">उनके होटों के नीचे अज़दहा का ज़हर है।<verse eid="PSA 140:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 140:4"/>ऐ ख़ुदावन्द! मुझे शरीर के हाथ से बचा मुझे टेढ़े आदमी से महफूज़ रख,</para>
  <para style="q" vid="PSA 140:4">जिनका इरादा है कि मेरे पाँव उखाड़ दें।<verse eid="PSA 140:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 140:5"/>मग़रूरों ने मेरे लिए फंदे और रस्सियों को छिपाया है,</para>
  <para style="q" vid="PSA 140:5">उन्होंने राह के किनारे जाल लगाया है;</para>
  <para style="q" vid="PSA 140:5">उन्होंने मेरे लिए दाम बिछा रख्खे हैं। सिलाह<verse eid="PSA 140:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 140:6"/>मैंने ख़ुदावन्द से कहा,</para>
  <para style="q" vid="PSA 140:6">मेरा ख़ुदा तू ही है। ऐ ख़ुदावन्द,</para>
  <para style="q" vid="PSA 140:6">मेरी इल्तिजा की आवाज़ पर कान लगा।<verse eid="PSA 140:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 140:7"/>ऐ ख़ुदावन्द मेरे मालिक, ऐ मेरी नजात की ताक़त,</para>
  <para style="q" vid="PSA 140:7">तूने जंग के दिन मेरे सिर पर साया किया है।<verse eid="PSA 140:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 140:8"/>ऐ ख़ुदावन्द, शरीर की मुराद पूरी न कर,</para>
  <para style="q" vid="PSA 140:8">उसके बुरे मन्सूबे को अंजाम न दे ताकि वह डींग न मारे। सिलाह<verse eid="PSA 140:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 140:9"/>मुझे घेरने वालों की मुँह के शरारत,</para>
  <para style="q" vid="PSA 140:9">उन्हीं के सिर पर पड़े।<verse eid="PSA 140:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 140:10"/>उन पर अंगारे गिरें! वह आग में डाले जाएँ!</para>
  <para style="q" vid="PSA 140:10">और ऐसे गढ़ों में कि फिर न उठे।<verse eid="PSA 140:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 140:11"/>बदज़बान आदमी की ज़मीन पर क़याम न होगा।</para>
  <para style="q" vid="PSA 140:11">आफ़त टेढ़े आदमी को दौड़ा कर हलाक करेगी।<verse eid="PSA 140:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 140:12"/>मैं जानता हूँ कि ख़ुदावन्द मुसीब तज़दा के मु'आमिले की,</para>
  <para style="q" vid="PSA 140:12">और मोहताज के हक़ की ताईद करेगा।<verse eid="PSA 140:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 140:13"/>यक़ीनन सादिक़ तेरे नाम का शुक्र करेंगे,</para>
  <para style="q" vid="PSA 140:13">और रास्तबाज़ तेरे सामने में रहेंगे।<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 141:1"/>ऐ ख़ुदावन्द! मैने तेरी दुहाई दी मेरी तरफ़ जल्द आ!</para>
  <para style="q" vid="PSA 141:1">जब मैं तुझ से दुआ करूँ, तो मेरी आवाज़ पर कान लगा!<verse eid="PSA 141:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2"/>मेरी दुआ तेरे सामने ख़ुशबू की तरह हो,</para>
  <para style="q" vid="PSA 141:2">और मेरा हाथ उठाना शाम की कु़र्बानी की तरह!<verse eid="PSA 141:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3"/>ऐ ख़ुदावन्द! मेरे मुँह पर पहरा बिठा;</para>
  <para style="q" vid="PSA 141:3">मेरे लबों के दरवाजे़ की निगहबानी कर।<verse eid="PSA 141:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4"/>मेरे दिल को किसी बुरी बात की तरफ़ माइल न होने दे;</para>
  <para style="q" vid="PSA 141:4">कि बदकारों के साथ मिलकर, शरारत के कामों में मसरूफ़ हो जाए,</para>
  <para style="q" vid="PSA 141:4">और मुझे उनके नफ़ीस खाने से दूर रख।<verse eid="PSA 141:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5"/>सादिक़ मुझे मारे तो मेहरबानी होगी,</para>
  <para style="q" vid="PSA 141:5">वह मुझे तम्बीह करे तो जैसे सिर पर रौग़न होगा।</para>
  <para style="q" vid="PSA 141:5">मेरा सिर इससे इंकार न करे,</para>
  <para style="q" vid="PSA 141:5">क्यूँकि उनकी शरारत में भी मैं दुआ करता रहूँगा।<verse eid="PSA 141:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6"/>उनके हाकिम चट्टान के किनारों पर से गिरा दिए गए हैं,</para>
  <para style="q" vid="PSA 141:6">और वह मेरी बातें सुनेंगे, क्यूँकि यह शीरीन हैं।<verse eid="PSA 141:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7"/>जैसे कोई हल चलाकर ज़मीन को तोड़ता है,</para>
  <para style="q" vid="PSA 141:7">वैसे ही हमारी हड्डियाँ पाताल के मुँह पर बिखरी पड़ी हैं।<verse eid="PSA 141:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8"/>क्यूँकि ऐ मालिक ख़ुदावन्द! मेरी आँखें तेरी तरफ़ हैं;</para>
  <para style="q" vid="PSA 141:8">मेरा भरोसा तुझ पर है, मेरी जान को बेकस न छोड़!<verse eid="PSA 141:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9"/>मुझे उस फंदे से जो उन्होंने मेरे लिए लगाया है,</para>
  <para style="q" vid="PSA 141:9">और बदकिरदारों के दाम से बचा।<verse eid="PSA 141:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10"/>शरीर आप अपने जाल में फंसें,</para>
  <para style="q" vid="PSA 141:10">और मैं सलामत बच निकलूँ।<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 142:1"/>मैं अपनी ही आवाज़ बुलंद करके ख़ुदावन्द से फ़रियाद करता हूँ</para>
  <para style="q" vid="PSA 142:1">मै अपनी ही आवाज़ से ख़ुदावन्द से मिन्नत करता हूँ।<verse eid="PSA 142:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 142:2"/>मैं उसके सामने फ़रियाद करता हूँ,</para>
  <para style="q" vid="PSA 142:2">मैं अपना दुख उसके सामने बयान करता हूँ।<verse eid="PSA 142:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 142:3"/>जब मुझ में मेरी जान निढाल थी,</para>
  <para style="q" vid="PSA 142:3">तू मेरी राह से वाक़िफ़ था!</para>
  <para style="q" vid="PSA 142:3">जिस राह पर मैं चलता हूँ उसमे उन्होंने मेरे लिए फंदा लगाया है।<verse eid="PSA 142:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 142:4"/>दहनी तरफ़ निगाह कर और देख,</para>
  <para style="q" vid="PSA 142:4">मुझे कोई नहीं पहचानता। मेरे लिए कहीं पनाह न रही,</para>
  <para style="q" vid="PSA 142:4">किसी को मेरी जान की फ़िक्र नहीं।<verse eid="PSA 142:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 142:5"/>ऐ ख़ुदावन्द, मैंने तुझ से फ़रियाद की;</para>
  <para style="q" vid="PSA 142:5">मैंने कहा, तू मेरी पनाह है,</para>
  <para style="q" vid="PSA 142:5">और ज़िन्दों की ज़मीन में मेरा बख़रा।<verse eid="PSA 142:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 142:6"/>मेरी फ़रियाद पर तवज्जुह कर,</para>
  <para style="q" vid="PSA 142:6">क्यूँकि मैं बहुत पस्त हो गया हूँ!</para>
  <para style="q" vid="PSA 142:6">मेरे सताने वालों से मुझे रिहाई बख़्श,</para>
  <para style="q" vid="PSA 142:6">क्यूँकि वह मुझ से ताक़तवर हैं।<verse eid="PSA 142:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 142:7"/>मेरी जान को कै़द से निकाल,</para>
  <para style="q" vid="PSA 142:7">ताकि तेरे नाम का शुक्र करूँ सादिक़ मेरे गिर्द जमा होंगे</para>
  <para style="q" vid="PSA 142:7">क्यूँकि तू मुझ पर एहसान करेगा।<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 143:1"/>ऐ ख़ुदावन्द, मेरी दू'आ सुन,</para>
  <para style="q" vid="PSA 143:1">मेरी इल्तिजा पर कान लगा।</para>
  <para style="q" vid="PSA 143:1">अपनी वफ़ादारी और सदाक़त में मुझे जवाब दे,<verse eid="PSA 143:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2"/>और अपने बन्दे को 'अदालत में न ला,</para>
  <para style="q" vid="PSA 143:2">क्यूँकि तेरी नज़र में कोई आदमी रास्तबाज़ नहीं ठहर सकता।<verse eid="PSA 143:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3"/>इसलिए कि दुश्मन ने मेरी जान को सताया है;</para>
  <para style="q" vid="PSA 143:3">उसने मेरी ज़िन्दगी को ख़ाक में मिला दिया,</para>
  <para style="q" vid="PSA 143:3">और मुझे अँधेरी जगहों में उनकी तरह बसाया है जिनको मरे मुद्दत हो गई हो।<verse eid="PSA 143:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4"/>इसी वजह से मुझ में मेरी जान निढाल है;</para>
  <para style="q" vid="PSA 143:4">और मेरा दिल मुझ में बेकल है।<verse eid="PSA 143:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5"/>मैं पिछले ज़मानों को याद करता हूँ,</para>
  <para style="q" vid="PSA 143:5">मैं तेरे सब कामों पर ग़ौर करता हूँ,</para>
  <para style="q" vid="PSA 143:5">और तेरी दस्तकारी पर ध्यान करता हूँ।<verse eid="PSA 143:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6"/>मैं अपने हाथ तेरी तरफ़ फैलाता हूँ</para>
  <para style="q" vid="PSA 143:6">मेरी जान खु़श्क ज़मीन की तरह तेरी प्यासी है।<verse eid="PSA 143:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7"/>ऐ ख़ुदावन्द, जल्द मुझे जवाब दे:मेरी रूह गुदाज़ हो चली!</para>
  <para style="q" vid="PSA 143:7">अपना चेहरा मुझ से न छिपा,</para>
  <para style="q" vid="PSA 143:7">ऐसा न हो कि मैं क़ब्र में उतरने वालों की तरह हो जाऊँ।<verse eid="PSA 143:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8"/>सुबह को मुझे अपनी शफ़क़त की ख़बर दे,</para>
  <para style="q" vid="PSA 143:8">क्यूँकि मेरा भरोसा तुझ पर है।</para>
  <para style="q" vid="PSA 143:8">मुझे वह राह बता जिस पर मैं चलूं,</para>
  <para style="q" vid="PSA 143:8">क्यूँकि मैं अपना दिल तेरी ही तरफ़ लगाता हूँ।<verse eid="PSA 143:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9"/>ऐ ख़ुदावन्द, मुझे मेरे दुश्मनों से रिहाई बख्श;</para>
  <para style="q" vid="PSA 143:9">क्यूँकि मैं पनाह के लिए तेरे पास भाग आया हूँ।<verse eid="PSA 143:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10"/>मुझे सिखा के तेरी मर्ज़ी पर चलूँ, इसलिए कि तू मेरा ख़ुदा है!</para>
  <para style="q" vid="PSA 143:10">तेरी नेक रूह मुझे रास्ती के मुल्क में ले चले!<verse eid="PSA 143:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11"/>ऐ ख़ुदावन्द, अपने नाम की ख़ातिर मुझे ज़िन्दा कर!</para>
  <para style="q" vid="PSA 143:11">अपनी सदाक़त में मेरी जान को मुसीबत से निकाल!<verse eid="PSA 143:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12"/>अपनी शफ़क़त से मेरे दुश्मनों को काट डाल,</para>
  <para style="q" vid="PSA 143:12">और मेरी जान के सब दुख देने वालों को हलाक कर दे,</para>
  <para style="q" vid="PSA 143:12">क्यूँकि मैं तेरा बन्दा हूँ।<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 144:1"/>ख़ुदावन्द मेरी चट्टान मुबारक हो,</para>
  <para style="q" vid="PSA 144:1">जो मेरे हाथों को जंग करना,</para>
  <para style="q" vid="PSA 144:1">और मेरी उँगलियों को लड़ना सिखाता है।<verse eid="PSA 144:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2"/>वह मुझ पर शफ़क़त करने वाला, और मेरा क़िला' है;</para>
  <para style="q" vid="PSA 144:2">मेरा ऊँचा बुर्ज और मेरा छुड़ाने वाला,</para>
  <para style="q" vid="PSA 144:2">वह मेरी ढाल और मेरी पनाहगाह है;</para>
  <para style="q" vid="PSA 144:2">जो मेरे लोगों को मेरे ताबे' करता है।<verse eid="PSA 144:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3"/>ऐ ख़ुदावन्द, इंसान क्या है कि तू उसे याद रख्खे?</para>
  <para style="q" vid="PSA 144:3">और आदमज़ाद क्या है कि तू उसका ख़याल करे?<verse eid="PSA 144:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4"/>इंसान बुतलान की तरह है;</para>
  <para style="q" vid="PSA 144:4">उसके दिन ढलते साये की तरह हैं।<verse eid="PSA 144:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5"/>ऐ ख़ुदावन्द, आसमानों को झुका कर उतर आ!</para>
  <para style="q" vid="PSA 144:5">पहाड़ों को छू, तो उनसे धुआँ उठेगा!<verse eid="PSA 144:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6"/>बिजली गिराकर उनको तितर बितर कर दे,</para>
  <para style="q" vid="PSA 144:6">अपने तीर चलाकर उनको शिकस्त दे!<verse eid="PSA 144:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7"/>ऊपर से हाथ बढ़ा, मुझे रिहाई दे और बड़े सैलाब,</para>
  <para style="q" vid="PSA 144:7">या'नी परदेसियों के हाथ से छुड़ा।<verse eid="PSA 144:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8"/>जिनके मुँह से बेकारी निकलती रहती है,</para>
  <para style="q" vid="PSA 144:8">और जिनका दहना हाथ झूट का दहना हाथ है।<verse eid="PSA 144:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9"/>ऐ ख़ुदा! मैं तेरे लिए नया हम्द गाऊँगा;</para>
  <para style="q" vid="PSA 144:9">दस तार वाली बरबत पर मैं तेरी मदहसराई करूँगा।<verse eid="PSA 144:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 144:10"/>वही बादशाहों को नजात बख़्शता है;</para>
  <para style="q" vid="PSA 144:10">और अपने बन्दे दाऊद को हलाक़त की तलवार से बचाता है।<verse eid="PSA 144:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 144:11"/>मुझे बचा और परदेसियों के हाथ से छुड़ा,</para>
  <para style="q" vid="PSA 144:11">जिनके मुँह से बेकारी निकलती रहती है,</para>
  <para style="q" vid="PSA 144:11">और जिनका दहना हाथ झूट का दहना हाथ है।<verse eid="PSA 144:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12"/>जब हमारे बेटे जवानी में क़दआवर पौदों की तरह हों</para>
  <para style="q" vid="PSA 144:12">और हमारी बेटियाँ महल के कोने के लिए तराशे हुए पत्थरों की तरह हों,<verse eid="PSA 144:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13"/>जब हमारे खत्ते भरे हों, जिनसे हर किस्म की जिन्स मिल सके,</para>
  <para style="q" vid="PSA 144:13">और हमारी भेड़ बकरियाँ हमारे कूचों में हज़ारों और लाखों बच्चे दें:<verse eid="PSA 144:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14"/>जब हमारे बैल खू़ब लदे हों,</para>
  <para style="q" vid="PSA 144:14">जब न रखना हो न ख़ुरूज,</para>
  <para style="q" vid="PSA 144:14">और न हमारे कूचों में वावैला हो।<verse eid="PSA 144:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15"/>मुबारक है वह क़ौम जिसका यह हाल है।</para>
  <para style="q" vid="PSA 144:15">मुबारक है वह क़ौम जिसका ख़ुदा ख़ुदावन्द है।<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 145:1"/>ऐ मेरे ख़ुदा, मेरे बादशाह! मैं तेरी तम्जीद करूँगा।</para>
  <para style="q" vid="PSA 145:1">और हमेशा से हमेशा तक तेरे नाम को मुबारक कहूँगा।<verse eid="PSA 145:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2"/>मैं हर दिन तुझे मुबारक कहूँगा,</para>
  <para style="q" vid="PSA 145:2">और हमेशा से हमेशा तक तेरे नाम की सिताइश करूँगा।<verse eid="PSA 145:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3"/>ख़ुदावन्द बुजु़र्ग और बेहद सिताइश के लायक़ है;</para>
  <para style="q" vid="PSA 145:3">उसकी बुजु़र्गी बयान से बाहर है।<verse eid="PSA 145:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4"/>एक नसल दूसरी नसल से तेरे कामों की ता'रीफ़,</para>
  <para style="q" vid="PSA 145:4">और तेरी कु़दरत के कामों का बयान करेगी।<verse eid="PSA 145:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5"/>मैं तेरी 'अज़मत की जलाली शान पर,</para>
  <para style="q" vid="PSA 145:5">और तेरे 'अजायब पर ग़ौर करूँगा।<verse eid="PSA 145:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6"/>और लोग तेरी कु़दरत के हौलनाक कामों का ज़िक्र करेंगे,</para>
  <para style="q" vid="PSA 145:6">और मैं तेरी बुजु़र्गी बयान करूँगा।<verse eid="PSA 145:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7"/>वह तेरे बड़े एहसान की यादगार का बयान करेंगे,</para>
  <para style="q" vid="PSA 145:7">और तेरी सदाक़त का हम्द गाएँगे।<verse eid="PSA 145:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8"/>ख़ुदावन्द रहीम — ओ — करीम है;</para>
  <para style="q" vid="PSA 145:8">वह कहर करने में धीमा और शफ़क़त में ग़नी है।<verse eid="PSA 145:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9"/>ख़ुदावन्द सब पर मेहरबान है,</para>
  <para style="q" vid="PSA 145:9">और उसकी रहमत उसकी सारी मख़लूक पर है।<verse eid="PSA 145:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10"/>ऐ ख़ुदावन्द, तेरी सारी मख़लूक़ तेरा शुक्र करेगी,</para>
  <para style="q" vid="PSA 145:10">और तेरे पाक लोग तुझे मुबारक कहेंगे!<verse eid="PSA 145:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11"/>वह तेरी सल्तनत के जलाल का बयान,</para>
  <para style="q" vid="PSA 145:11">और तेरी कु़दरत का ज़िक्र करेंगे;<verse eid="PSA 145:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12"/>ताकि बनी आदम पर उसके कुदरत के कामों को,</para>
  <para style="q" vid="PSA 145:12">और उसकी सल्तनत के जलाल की शान को ज़ाहिर करें।<verse eid="PSA 145:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13"/>तेरी सल्तनत हमेशा की सल्तनत है,</para>
  <para style="q" vid="PSA 145:13">और तेरी हुकूमत नसल — दर — नसल।<verse eid="PSA 145:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14"/>ख़ुदावन्द गिरते हुए को संभालता,</para>
  <para style="q" vid="PSA 145:14">और झुके हुए को उठा खड़ा करता है।<verse eid="PSA 145:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15"/>सब की आँखें तुझ पर लगी हैं,</para>
  <para style="q" vid="PSA 145:15">तू उनको वक़्त पर उनकी ख़ुराक देता है।<verse eid="PSA 145:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16"/>तू अपनी मुट्ठी खोलता है,</para>
  <para style="q" vid="PSA 145:16">और हर जानदार की ख़्वाहिश पूरी करता है।<verse eid="PSA 145:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17"/>ख़ुदावन्द अपनी सब राहों में सादिक़,</para>
  <para style="q" vid="PSA 145:17">और अपने सब कामों में रहीम है।<verse eid="PSA 145:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18"/>ख़ुदावन्द उन सबके क़रीब है जो उससे दुआ करते हैं,</para>
  <para style="q" vid="PSA 145:18">या'नी उन सबके जो सच्चाई से दुआ करते हैं।<verse eid="PSA 145:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19"/>जो उससे डरते हैं वह उनकी मुराद पूरी करेगा,</para>
  <para style="q" vid="PSA 145:19">वह उनकी फ़रियाद सुनेगा और उनको बचा लेगा।<verse eid="PSA 145:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20"/>ख़ुदावन्द अपने सब मुहब्बत रखने वालों की हिफ़ाज़त करेगा;</para>
  <para style="q" vid="PSA 145:20">लेकिन सब शरीरों को हलाक कर डालेगा।<verse eid="PSA 145:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21"/>मेरे मुँह से ख़ुदावन्द की सिताइश होगी,</para>
  <para style="q" vid="PSA 145:21">और हर बशर उसके पाक नाम को हमेशा से हमेशा तक मुबारक कहे।<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1"/>ख़ुदावन्द की हम्द करो ऐ मेरी जान,</para>
  <para style="q" vid="PSA 146:1">ख़ुदावन्द की हम्द कर!<verse eid="PSA 146:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2"/>मैं उम्र भर ख़ुदावन्द की हम्द करूँगा,</para>
  <para style="q" vid="PSA 146:2">जब तक मेरा वुजूद है मैं अपने ख़ुदा की मदहसराई करूँगा।<verse eid="PSA 146:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3"/>न उमरा पर भरोसा करो न आदमज़ाद पर,</para>
  <para style="q" vid="PSA 146:3">वह बचा नहीं सकता।<verse eid="PSA 146:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4"/>उसका दम निकल जाता है तो वह मिट्टी में मिल जाता है;</para>
  <para style="q" vid="PSA 146:4">उसी दिन उसके मन्सूबे फ़ना हो जाते हैं।<verse eid="PSA 146:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5"/>खु़श नसीब है वह, जिसका मददगार या'क़ूब का ख़ुदा है,</para>
  <para style="q" vid="PSA 146:5">और जिसकी उम्मीद ख़ुदावन्द उसके ख़ुदा से है।<verse eid="PSA 146:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6"/>जिसने आसमान और ज़मीन और समन्दर को,</para>
  <para style="q" vid="PSA 146:6">और जो कुछ उनमें है बनाया;</para>
  <para style="q" vid="PSA 146:6">जो सच्चाई को हमेशा क़ाईम रखता है।<verse eid="PSA 146:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7"/>जो मज़लूमों का इन्साफ़ करता है;</para>
  <para style="q" vid="PSA 146:7">जो भूकों को खाना देता है।</para>
  <para style="q" vid="PSA 146:7">ख़ुदावन्द कैदियों को आज़ाद करता है;<verse eid="PSA 146:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8"/>ख़ुदावन्द अन्धों की आँखें खोलता है;</para>
  <para style="q" vid="PSA 146:8">ख़ुदावन्द झुके हुए को उठा खड़ा करता है;</para>
  <para style="q" vid="PSA 146:8">ख़ुदावन्द सादिक़ों से मुहब्बत रखता है।<verse eid="PSA 146:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9"/>ख़ुदावन्द परदेसियों की हिफ़ाज़त करता है;</para>
  <para style="q" vid="PSA 146:9">वह यतीम और बेवा को संभालता है;</para>
  <para style="q" vid="PSA 146:9">लेकिन शरीरों की राह टेढ़ी कर देता है।<verse eid="PSA 146:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10"/>ख़ुदावन्द, हमेशा तक सल्तनत करेगा,</para>
  <para style="q" vid="PSA 146:10">ऐ सिय्यून! तेरा ख़ुदा नसल दर नसल।</para>
  <para style="q" vid="PSA 146:10">ख़ुदावन्द की हम्द करो!<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1"/>ख़ुदावन्द की हम्द करो!</para>
  <para style="q" vid="PSA 147:1">क्यूँकि ख़ुदा की मदहसराई करना भला है;</para>
  <para style="q" vid="PSA 147:1">इसलिए कि यह दिलपसंद और सिताइश ज़ेबा है।<verse eid="PSA 147:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2"/>ख़ुदावन्द येरूशलेम को ता'मीर करता है;</para>
  <para style="q" vid="PSA 147:2">वह इस्राईल के जिला वतनों को जमा' करता है।<verse eid="PSA 147:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3"/>वह शिकस्ता दिलों को शिफ़ा देता है,</para>
  <para style="q" vid="PSA 147:3">और उनके ज़ख़्म बाँधता है।<verse eid="PSA 147:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4"/>वह सितारों को शुमार करता है,</para>
  <para style="q" vid="PSA 147:4">और उन सबके नाम रखता है।<verse eid="PSA 147:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5"/>हमारा ख़ुदावन्द बुजु़र्ग और कु़दरत में 'अज़ीम है;</para>
  <para style="q" vid="PSA 147:5">उसके समझ की इन्तिहा नहीं।<verse eid="PSA 147:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6"/>ख़ुदावन्द हलीमों को संभालता है,</para>
  <para style="q" vid="PSA 147:6">वह शरीरों को ख़ाक में मिला देता है।<verse eid="PSA 147:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7"/>ख़ुदावन्द के सामने शुक्रगुज़ारी का हम्द गाओ,</para>
  <para style="q" vid="PSA 147:7">सितार पर हमारे ख़ुदा की मदहसराई करो।<verse eid="PSA 147:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8"/>जो आसमान को बादलों से मुलब्बस करता है;</para>
  <para style="q" vid="PSA 147:8">जो ज़मीन के लिए मेंह तैयार करता है; जो पहाड़ों पर घास उगाता है।<verse eid="PSA 147:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9"/>जो हैवानात को ख़ुराक देता है,</para>
  <para style="q" vid="PSA 147:9">और कव्वे के बच्चे को जो काएँ काएँ करते हैं।<verse eid="PSA 147:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10"/>घोड़े के ज़ोर में उसकी खु़शनूदी नहीं न आदमी की टाँगों से उसे कोई ख़ुशी है;<verse eid="PSA 147:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11"/>ख़ुदावन्द उनसे ख़ुश है जो उससे डरते हैं,</para>
  <para style="q" vid="PSA 147:11">और उनसे जो उसकी शफ़क़त के उम्मीदवार हैं।<verse eid="PSA 147:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12"/>ऐ येरूशलेम! ख़ुदावन्द की सिताइश कर!,</para>
  <para style="q" vid="PSA 147:12">ऐ सिय्यून! अपने ख़ुदा की सिताइश कर।<verse eid="PSA 147:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13"/>क्यूँकि उसने तेरे फाटकों के बेंडों को मज़बूत किया है,</para>
  <para style="q" vid="PSA 147:13">उसने तेरे अन्दर तेरी औलाद को बरकत दी है।<verse eid="PSA 147:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14"/>वह तेरी हद में अम्न रखता है!</para>
  <para style="q" vid="PSA 147:14">वह तुझे अच्छे से अच्छे गेहूँ से आसूदा करता है।<verse eid="PSA 147:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15"/>वह अपना हुक्म ज़मीन पर भेजता है,</para>
  <para style="q" vid="PSA 147:15">उसका कलाम बहुत तेज़ रौ है।<verse eid="PSA 147:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16"/>वह बर्फ़ को ऊन की तरह गिराता है,</para>
  <para style="q" vid="PSA 147:16">और पाले को राख की तरह बिखेरता है।<verse eid="PSA 147:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17"/>वह यख़ को लुक़मों की तरह फेंकता</para>
  <para style="q" vid="PSA 147:17">उसकी ठंड कौन सह सकता है?<verse eid="PSA 147:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18"/>वह अपना कलाम नाज़िल करके उनको पिघला देता है</para>
  <para style="q" vid="PSA 147:18">; वह हवा चलाता है और पानी बहने लगता है।<verse eid="PSA 147:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19"/>वह अपना कलाम या'क़ूब पर ज़ाहिर करता है,</para>
  <para style="q" vid="PSA 147:19">और अपने आईन — ओ — अहकाम इस्राईल पर।<verse eid="PSA 147:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20"/>उसने किसी और क़ौम से ऐसा सुलूक नहीं किया;</para>
  <para style="q" vid="PSA 147:20">और उनके अहकाम को उन्होंने नहीं जाना।</para>
  <para style="q" vid="PSA 147:20">ख़ुदावन्द की हम्द करो!<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1"/>ख़ुदावन्द की हम्द करो!</para>
  <para style="q" vid="PSA 148:1">आसमान पर से ख़ुदावन्द की हम्द करो,</para>
  <para style="q" vid="PSA 148:1">बुलंदियों पर उसकी हम्द करो!<verse eid="PSA 148:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2"/>ऐ उसके फ़िरिश्तो! सब उसकी हम्द करो।</para>
  <para style="q" vid="PSA 148:2">ऐ उसके लश्करो! सब उसकी हम्द करो!<verse eid="PSA 148:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3"/>ऐ सूरज! ऐ चाँद! उसकी हम्द करो।</para>
  <para style="q" vid="PSA 148:3">ऐ नूरानी सितारों! सब उसकी हम्द करो<verse eid="PSA 148:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4"/>ऐ फ़लक — उल — फ़लाक! उसकी हम्द करो!</para>
  <para style="q" vid="PSA 148:4">और तू भी ऐ फ़ज़ा पर के पानी!<verse eid="PSA 148:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5"/>यह सब ख़ुदावन्द के नाम की हम्द करें,</para>
  <para style="q" vid="PSA 148:5">क्यूँकि उसने हुक्म दिया और यह पैदा हो गए।<verse eid="PSA 148:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6"/>उसने इनको हमेशा से हमेशा तक के लिए क़ाईम किया है;</para>
  <para style="q" vid="PSA 148:6">उसने अटल क़ानून मुक़र्रर कर दिया है।<verse eid="PSA 148:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7"/>ज़मीन पर से ख़ुदावन्द की हम्द करो</para>
  <para style="q" vid="PSA 148:7">ऐ अज़दहाओं और सब गहरे समन्दरो!<verse eid="PSA 148:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8"/>ऐ आग और ओलो! ऐ बर्फ़ और कुहर ऐ तूफ़ानी हवा!</para>
  <para style="q" vid="PSA 148:8">जो उसके कलाम की ता'लीम करती है।<verse eid="PSA 148:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9"/>ऐ पहाड़ो और सब टीलो!</para>
  <para style="q" vid="PSA 148:9">ऐ मेवादार दरख़्तो और सब देवदारो!<verse eid="PSA 148:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10"/>ऐ जानवरो और सब चौपायो!</para>
  <para style="q" vid="PSA 148:10">ऐ रेंगने वालो और परिन्दो!<verse eid="PSA 148:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11"/>ऐ ज़मीन के बादशाहो और सब उम्मतों!</para>
  <para style="q" vid="PSA 148:11">ऐ उमरा और ज़मीन के सब हाकिमों!<verse eid="PSA 148:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12"/>ऐ नौजवानो और कुंवारियो!</para>
  <para style="q" vid="PSA 148:12">ऐ बूढ़ों और बच्चो!<verse eid="PSA 148:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13"/>यह सब ख़ुदावन्द के नाम की हम्द करें,</para>
  <para style="q" vid="PSA 148:13">क्यूँकि सिर्फ़ उसी का नाम मुम्ताज़ है।</para>
  <para style="q" vid="PSA 148:13">उसका जलाल ज़मीन और आसमान से बुलन्द है।<verse eid="PSA 148:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14"/>और उसने अपने सब पाक लोगों या'नी</para>
  <para style="q" vid="PSA 148:14">अपनी मुक़र्रब क़ौम बनी इस्राईल के फ़ख़्र के लिए,</para>
  <para style="q" vid="PSA 148:14">अपनी क़ौम का सींग बुलन्द किया।</para>
  <para style="q" vid="PSA 148:14">ख़ुदावन्द की हम्द करो!<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1"/>ख़ुदावन्द की हम्द करो।</para>
  <para style="q" vid="PSA 149:1">ख़ुदावन्द के सामने नया हम्द गाओ,</para>
  <para style="q" vid="PSA 149:1">और पाक लोगों के मजमे' में उसकी मदहसराई करो!<verse eid="PSA 149:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2"/>इस्राईल अपने ख़ालिक में ख़ुश रहे,</para>
  <para style="q" vid="PSA 149:2">फ़र्ज़न्दान — ए — सिय्यून अपने बादशाह की वजह से ख़ुश हों!<verse eid="PSA 149:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3"/>वह नाचते हुए उसके नाम की सिताइश करें,</para>
  <para style="q" vid="PSA 149:3">वह दफ़ और सितार पर उसकी मदहसराई करें!<verse eid="PSA 149:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4"/>क्यूँकि ख़ुदावन्द अपने लोगों से खू़शनूद रहता है;</para>
  <para style="q" vid="PSA 149:4">वह हलीमों को नजात से ज़ीनत बख़्शेगा।<verse eid="PSA 149:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5"/>पाक लोग जलाल पर फ़ख़्र करें,</para>
  <para style="q" vid="PSA 149:5">वह अपने बिस्तरों पर ख़ुशी से नग़मा सराई करें।<verse eid="PSA 149:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6"/>उनके मुँह में ख़ुदा की तम्जीद,</para>
  <para style="q" vid="PSA 149:6">और हाथ में दोधारी तलवार हो,<verse eid="PSA 149:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7"/>ताकि क़ौमों से इन्तक़ाम लें,</para>
  <para style="q" vid="PSA 149:7">और उम्मतों को सज़ा दें:<verse eid="PSA 149:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8"/>उनके बादशाहों को ज़ंजीरों से जकड़ें,</para>
  <para style="q" vid="PSA 149:8">और उनके सरदारों को लोहे की बेड़ियाँ पहनाएं।<verse eid="PSA 149:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9"/>ताकि उनको वह सज़ा दें जो लिखी हैं!</para>
  <para style="q" vid="PSA 149:9">उसके सब पाक लोगों को यह मक़ाम हासिल है।</para>
  <para style="q" vid="PSA 149:9">ख़ुदावन्द की हम्द करो!<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="q">
    <verse number="1" style="v" sid="PSA 150:1"/>ख़ुदावन्द की हम्द करो!</para>
  <para style="q" vid="PSA 150:1">तुम ख़ुदा के हैकल में उसकी हम्द करो;</para>
  <para style="q" vid="PSA 150:1">उसकी कु़दरत के फ़लक पर उसकी हम्द करो!<verse eid="PSA 150:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2"/>उसकी कु़दरत के कामों की वजह से उसकी हम्द करो;</para>
  <para style="q" vid="PSA 150:2">उसकी बड़ी 'अज़मत के मुताबिक़ उसकी हम्द करो!<verse eid="PSA 150:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3"/>नरसिंगे की आवाज़ के साथ उसकी हम्द करो;</para>
  <para style="q" vid="PSA 150:3">बरबत और सितार पर उसकी हम्द करो!<verse eid="PSA 150:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4"/>दफ़ बजाते और नाचते हुए उसकी हम्द करो;</para>
  <para style="q" vid="PSA 150:4">तारदार साज़ों और बांसली के साथ उसकी हम्द करो!<verse eid="PSA 150:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5"/>बुलन्द आवाज़ झाँझ के साथ उसकी हम्द करो!</para>
  <para style="q" vid="PSA 150:5">ज़ोर से इंझनाती झाँझ के साथ उसकी हम्द करो!<verse eid="PSA 150:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6"/>हर शख़्स ख़ुदावन्द की हम्द करे!</para>
  <para style="q" vid="PSA 150:6">ख़ुदावन्द की हम्द करो!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
