<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ACT" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">रसूलों के आ'माल</para>
  <para style="toc1">रसूलों के आ'माल</para>
  <para style="toc2">रसूलों</para>
  <para style="toc3">रसूलों</para>
  <para style="mt">रसूलों के आ'माल</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">1 लूक़ा जो डाक्टर है वह इस किताब का मुसन्निफ़ है आमाल की किताब के कई एक वाक़ियात के लिए लूक़ा आँखों देखी गवाह था जिन्हें वह इन हावालाजात में पेश करता है। (16:10 — 17; 20:5 — 21:18; 27:1 — 28:16) रिवायतन उस ने ख़ुद को एक ग़ैर यहूदी बतौर साबित किया, मगर शुरू में वह एक मन्नाद था।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इस के लिखे जाने की तारीख़ तक़रीबन ईस्वी 60 - 63 के बीच है।</para>
  <para style="ip">इसे लिखे जाने की ख़ास जगहें यरूशलेम, सामरिया लिद्दा, याफ़ा, अन्ताकिया, इकूनियम, लुस्तरा दरिबे, फ़िलिप्पी, थिसलुनीका, बीरिया, एथन्ज़ कुरिन्थुस, इफ़िसुस, कै़सरिया, मालटा और रोम है।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">लूक़ा ने थियोफ़ुलुस को लिखा (आमाल 1:1) बद क़िस्मती से थियोफ़ुलुस की बाबत हम ज़्यादा नहीं जानते। कुछ हद तक मुमकिन है कि वह लूक़ा का सरपरस्त या हामी रहा होगा। या फिर थियोफिलुस नाम के मायने जो “खुदा का प्यारा” है यह आलमगीर लक़ब बतोर तमाम मसीहियों के लिए इस्तेमाल किया गया है।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">आमाल की किताब लिखने का मक़्सद था कि इब्तिदाई कलीसिया की पैदाइश और उसकी तरक़्क़ी की कहानी बताए। इस के अलावा यूहन्ना इस्तबाग़ी येसू और उसके बारह शागिर्दों ने जो पैग़ाम लोगों को सुनाया था उसे जारी रखा जाए। पेन्तीकुस्त के दिन रूह — उल — क़ुदुस के नाज़िल होने के ज़रिए मसीहियत का जो फैलाव हुआ, उसे यह किताब क़लम्बन्द करती है।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">इन्जील का फैलाव।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. रूह'उल'कुदुस का वादा — 1:1-26</para>
  <para style="io1">2. पेन्तीकुस्त के दिन रूह — उल — कुदुस का मज़ाहिरा — 2:1-4</para>
  <para style="io1">3. पतरस के कलाम की खि़दमतगुज़ारी के वसीले से कलीसिया की पैदाइश — 2:5-8:3</para>
  <para style="io1">4. पौलूस के वसीले से यहुदिया और सामरिया मे कलीसिया के रसूलों का इज़ाफ़ा — 8:4-12:25</para>
  <para style="io1">5. मसीहियत का दुनिया के आख़री हिस्से तक फैल जाना — 13:1-28:31</para>
  <chapter number="1" style="c" sid="ACT 1"/>
  <para style="s">पाक रूह मिलने का वादा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1"/>ऐ थियुफ़िलुस मैने पहली किताब<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">पहली किताब </char><char style="ft" closed="false">लूक़ा की इन्जील है </char></note> उन सब बातों के बयान में लिखी जो ईसा शुरू; में करता और सिखाता रहा। <verse eid="ACT 1:1"/><verse number="2" style="v" sid="ACT 1:2"/>उस दिन तक जिसमें वो उन रसूलों को जिन्हें उसने चुना था रूह — उल — क़ुद्दूस के वसीले से हुक्म देकर ऊपर उठाया गया। <verse eid="ACT 1:2"/><verse number="3" style="v" sid="ACT 1:3"/>ईसा ने तकलीफ़ सहने के बाद बहुत से सबूतों से अपने आपको उन पर ज़िन्दा ज़ाहिर भी किया, चुनाँचे वो चालीस दिन तक उनको नज़र आता और ख़ुदा की बादशाही की बातें कहता रहा।<verse eid="ACT 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 1:4"/>और उनसे मिलकर उन्हें हुक्म दिया, <char style="wj">“येरूशलेम से बाहर न जाओ, बल्कि बाप के उस वा'दे के पूरा होने का इन्तिज़ार करो, जिसके बारे में तुम मुझ से सुन चुके हो,</char> <verse eid="ACT 1:4"/><verse number="5" style="v" sid="ACT 1:5"/><char style="wj">क्यूँकि युहन्ना ने तो पानी से बपतिस्मा दिया मगर तुम थोड़े दिनों के बाद रूह — उल — क़ुद्दूस से बपतिस्मा पाओगे।”</char><verse eid="ACT 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6"/>पस उन्होंने इकट्ठा होकर पूछा, “ऐ ख़ुदावन्द! क्या तू इसी वक़्त इस्राईल को बादशाही फिर' अता करेगा?” <verse eid="ACT 1:6"/><verse number="7" style="v" sid="ACT 1:7"/>उसने उनसे कहा, <char style="wj">“उन वक़्तों और मी'आदों का जानना, जिन्हें बाप ने अपने ही इख़्तियार में रख्खा है, तुम्हारा काम नहीं।</char> <verse eid="ACT 1:7"/><verse number="8" style="v" sid="ACT 1:8"/><char style="wj">लेकिन जब रूह — उल — क़ुद्दूस तुम पर नाज़िल होगा तो तुम ताक़त पाओगे; और येरूशलेम और तमाम यहूदिया और सामरिया में, बल्कि ज़मीन के आख़ीर तक मेरे गवाह होगे।”</char><verse eid="ACT 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9"/>ये कहकर वो उनको देखते देखते ऊपर उठा लिया गया, और बादलों ने उसे उनकी नज़रों से छिपा लिया। <verse eid="ACT 1:9"/><verse number="10" style="v" sid="ACT 1:10"/>उसके जाते वक़्त वो आसमान की तरफ़ ग़ौर से देख रहे थे, तो देखो, दो मर्द सफ़ेद पोशाक पहने उनके पास आ खड़े हुए, <verse eid="ACT 1:10"/><verse number="11" style="v" sid="ACT 1:11"/>और कहने लगे, “ऐ गलीली मर्दो। तुम क्यूँ खड़े आसमान की तरफ़ देखते हो? यही ईसा जो तुम्हारे पास से आसमान पर उठाया गया है, इसी तरह फिर आएगा जिस तरह तुम ने उसे आसमान पर जाते देखा है।”<verse eid="ACT 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12"/>तब वो उस पहाड़ से जो ज़ैतून का कहलाता है और येरूशलेम के नज़दीक सबत की मन्ज़िल के फ़ासले<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="fq" closed="false">मन्ज़िल के फ़ासले </char><char style="ft" closed="false">ज़ैतून का पहाड़ येरूशलेम से 3:219 क़िलो मीटर की दूर है </char></note> पर है येरूशलेम को फिरे। <verse eid="ACT 1:12"/><verse number="13" style="v" sid="ACT 1:13"/>और जब उसमें दाख़िल हुए तो उस बालाख़ाने पर चढ़े जिस में वो या'नी पतरस और यूहन्ना, और या'क़ूब और अन्द्रियास और फ़िलिप्पुस, तोमा, बरतुल्माई, मत्ती, हलफ़ी का बेटा या'क़ूब, शमौन ज़ेलोतेस और या'क़ूब का बेटा यहूदाह रहते थे। <verse eid="ACT 1:13"/><verse number="14" style="v" sid="ACT 1:14"/>ये सब के सब चन्द 'औरतों और ईसा की माँ मरियम और उसके भाइयों के साथ एक दिल होकर दुआ में मशग़ूल रहे।<verse eid="ACT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15"/>उन्हीं दिनों पतरस भाइयों में जो तक़रीबन एक सौ बीस शख़्सों की जमा'अत थी खड़ा होकर कहने लगा, <verse eid="ACT 1:15"/><verse number="16" style="v" sid="ACT 1:16"/>“ऐ भाइयों उस नबुव्वत का पूरा होना ज़रूरी था जो रूह — उल — क़ुद्दूस ने दाऊद के ज़बानी उस यहूदा के हक़ में पहले कहा था, जो ईसा के पकड़ने वालों का रहनुमा हुआ।<verse eid="ACT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 1:17"/>क्यूँकि वो हम में शुमार किया गया और उस ने इस ख़िदमत का हिस्सा पाया।” <verse eid="ACT 1:17"/><verse number="18" style="v" sid="ACT 1:18"/>उस ने बदकारी की कमाई से एक खेत ख़रीदा, और सिर के बल गिरा और उसका पेट फट गया और उसकी सब आँतड़ीयां निकल पड़ीं। <verse eid="ACT 1:18"/><verse number="19" style="v" sid="ACT 1:19"/>और ये येरूशलेम के सब रहने वालों को मा'लूम हुआ, यहाँ तक कि उस खेत का नाम उनकी ज़बान में हैक़लेदमा पड़ गया या'नी [ख़ून का खेत]।<verse eid="ACT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20"/>क्यूँकि ज़बूर में लिखा है,</para>
  <para style="q" vid="ACT 1:20">'उसका घर उजड़ जाए,</para>
  <para style="q" vid="ACT 1:20">और उसमें कोई बसने वाला न रहे</para>
  <para style="q" vid="ACT 1:20">और उसका मर्तबा दुसरा ले ले।<verse eid="ACT 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21"/>पस जितने 'अर्से तक ख़ुदावन्द ईसा हमारे साथ आता जाता रहा, यानी यूहन्ना के बपतिस्मे से लेकर ख़ुदावन्द के हमारे पास से उठाए जाने तक — जो बराबर हमारे साथ रहे, <verse eid="ACT 1:21"/><verse number="22" style="v" sid="ACT 1:22"/>चाहिए कि उन में से एक आदमी हमारे साथ उसके जी उठने का गवाह बने। <verse eid="ACT 1:22"/><verse number="23" style="v" sid="ACT 1:23"/>फिर उन्होंने दो को पेश किया। एक यूसुफ़ को जो बरसब्बा कहलाता है और जिसका लक़ब यूसतुस है। दूसरा मत्तय्याह को।<verse eid="ACT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 1:24"/>और ये कह कर दुआ की, “ऐ ख़ुदावन्द! तू जो सब के दिलों को जानता है, ये ज़ाहिर कर कि इन दोनों में से तूने किस को चुना है <verse eid="ACT 1:24"/><verse number="25" style="v" sid="ACT 1:25"/>ताकि वह इस ख़िदमत और रसूलों की जगह ले, जिसे यहूदाह छोड़ कर अपनी जगह गया।” <verse eid="ACT 1:25"/><verse number="26" style="v" sid="ACT 1:26"/>फिर उन्होंने उनके बारे में पर्ची डाली, और पर्ची मत्तय्याह के नाम की निकली। पस वो उन ग्यारह रसूलों के साथ शुमार किया गया।<verse eid="ACT 1:26"/></para>
  <chapter eid="ACT 1"/>
  <chapter number="2" style="c" sid="ACT 2"/>
  <para style="s">पाक रूह का आना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1"/>जब ईद — ए — पन्तिकुस्त<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">ईद — ए — पन्तिकुस्त </char><char style="ft" closed="false">ईद फ़सह के पचास इन बाद पेन्तिकुस्त का दिन है </char></note> का दिन आया। तो वो सब एक जगह जमा थे। <verse eid="ACT 2:1"/><verse number="2" style="v" sid="ACT 2:2"/>एकाएक आस्मान से ऐसी आवाज़ आई जैसे ज़ोर की आँधी का सन्नाटा होता है। और उस से सारा घर जहां वो बैठे थे गूँज गया। <verse eid="ACT 2:2"/><verse number="3" style="v" sid="ACT 2:3"/>और उन्हें आग के शो'ले की सी फ़टती हुई ज़बाने दिखाई दीं और उन में से हर एक पर आ ठहरीं। <verse eid="ACT 2:3"/><verse number="4" style="v" sid="ACT 2:4"/>और वो सब रूह — उल — क़ुद्दूस से भर गए और ग़ैर ज़बान बोलने लगे, जिस तरह रूह ने उन्हें बोलने की ताक़त बख़्शी।<verse eid="ACT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5"/>और हर क़ौम में से जो आसमान के नीचे ख़ुदा तरस यहूदी येरूशलेम में रहते थे। <verse eid="ACT 2:5"/><verse number="6" style="v" sid="ACT 2:6"/>जब यह आवाज़ आई तो भीड़ लग गई और लोग दंग हो गए, क्यूँकि हर एक को यही सुनाई देता था कि ये मेरी ही बोली बोल रहे हैं। <verse eid="ACT 2:6"/><verse number="7" style="v" sid="ACT 2:7"/>और सब हैरान और ता'ज्जुब हो कर कहने लगे, देखो ये बोलने वाले क्या सब गलीली नहीं?<verse eid="ACT 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 2:8"/>फिर क्यूँकर हम में से हर एक कैसे अपने ही वतन की बोली सुनता है। <verse eid="ACT 2:8"/><verse number="9" style="v" sid="ACT 2:9"/>हालाँकि हम हैं: पार्थि, मादि, ऐलामी, मसोपोतामिया, यहूदिया, और कप्पदुकिया, और पुन्तुस, और आसिया, <verse eid="ACT 2:9"/><verse number="10" style="v" sid="ACT 2:10"/>और फ़रूगिया, और पम्फ़ीलिया, और मिस्र और लिबुवा, के इलाक़े के रहने वाले हैं, जो कुरेने की तरफ़ है और रोमी मुसाफ़िर <verse eid="ACT 2:10"/><verse number="11" style="v" sid="ACT 2:11"/>चाहे यहूदी चाहे उनके मुरीद, करेती और 'अरब हैं। मगर अपनी अपनी ज़बान में उन से ख़ुदा के बड़े बड़े कामों का बयान सुनते हैं।<verse eid="ACT 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 2:12"/>और सब हैरान हुए और घबराकर एक दूसरे से कहने लगे, “ये क्या हुआ चाहता है?” <verse eid="ACT 2:12"/><verse number="13" style="v" sid="ACT 2:13"/>और कुछ ने ठठ्ठा मार कर कहा, “ये तो ताज़ा मय के नशे में हैं।”<verse eid="ACT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14"/>लेकिन पतरस उन ग्यारह रसूलों के साथ खड़ा हूआ और अपनी आवाज़ बुलन्द करके लोगों से कहा कि ऐ यहूदियो और ऐ येरूशलेम के सब रहने वालो ये जान लो, और कान लगा कर मेरी बातें सुनो! <verse eid="ACT 2:14"/><verse number="15" style="v" sid="ACT 2:15"/>कि जैसा तुम समझते हो ये नशे में नहीं। क्यूँकि अभी तो सुबह के नौ ही बजे है। <verse eid="ACT 2:15"/><verse number="16" style="v" sid="ACT 2:16"/>बल्कि ये वो बात है जो योएल नबी के ज़रिए कही गई है कि,<verse eid="ACT 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ACT 2:17"/>ख़ुदा फ़रमाता है, कि आख़िरी दिनों में ऐसा होगा कि</para>
  <para style="q" vid="ACT 2:17">मैं अपनी रूह में से हर आदमियों पर डालूँगा और</para>
  <para style="q" vid="ACT 2:17">तुम्हारे बेटे और तुम्हारी बेटियाँ नुबुव्वत करें गी और</para>
  <para style="q" vid="ACT 2:17">तुम्हारे जवान रोया</para>
  <para style="q" vid="ACT 2:17">और तुम्हारे बुड्ढे ख़्वाब देखेंगे।<verse eid="ACT 2:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ACT 2:18"/>बल्कि मै अपने बन्दों पर और अपनी बन्दियों पर भी उन दिनों में</para>
  <para style="q" vid="ACT 2:18">अपने रूह में से डालूँगा और वह नुबुव्वत करेंगी।<verse eid="ACT 2:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ACT 2:19"/>और मैं ऊपर आस्मान पर 'अजीब काम</para>
  <para style="q" vid="ACT 2:19">और नीचे ज़मीन पर निशानियां या'नी</para>
  <para style="q" vid="ACT 2:19">ख़ून और आग और धुएँ का बादल दिखाऊँगा।<verse eid="ACT 2:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ACT 2:20"/>सूरज तारीक</para>
  <para style="q" vid="ACT 2:20">और, चाँद ख़ून हो जाएगा पहले इससे कि</para>
  <para style="q" vid="ACT 2:20">ख़ुदावन्द का अज़ीम और जलील दिन आए।<verse eid="ACT 2:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ACT 2:21"/>और यूँ होगा कि जो कोई ख़ुदावन्द का नाम लेगा, नजात पाएगा।<verse eid="ACT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22"/>ऐ इस्राईलियों! ये बातें सुनो ईसा नासरी एक शख़्स था जिसका ख़ुदा की तरफ़ से होना तुम पर उन मोजिज़ों और 'अजीब कामों और निशानों से साबित हुआ; जो ख़ुदा ने उसके ज़रिए तुम में दिखाए। चुनाँचे तुम आप ही जानते हो। <verse eid="ACT 2:22"/><verse number="23" style="v" sid="ACT 2:23"/>जब वो ख़ुदा के मुक़र्ररा इन्तिज़ाम और इल्में साबिक़ के मुवाफ़िक़ पकड़वाया गया तो तुम ने बेशरा लोगों के हाथ से उसे मस्लूब करवा कर मार डाला। <verse eid="ACT 2:23"/><verse number="24" style="v" sid="ACT 2:24"/>लेकिन ख़ुदा ने मौत के बंद खोल कर उसे जिलाया क्यूँकि मुम्किन ना था कि वो उसके क़ब्ज़े में रहता।<verse eid="ACT 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 2:25"/>क्यूँकि दाऊद उसके हक़ में कहता है। कि</para>
  <para style="q" vid="ACT 2:25">मैं ख़ुदावन्द को हमेशा अपने सामने देखता रहा;</para>
  <para style="q" vid="ACT 2:25">क्यूँकि वो मेरी दहनी तरफ़ है ताकि मुझे जुम्बिश ना हो।<verse eid="ACT 2:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 2:26"/>इसी वजह से मेरा दिल ख़ुश हुआ; और मेरी ज़बान शाद,</para>
  <para style="q" vid="ACT 2:26">बल्कि मेरा जिस्म भी उम्मीद में बसा रहेगा।<verse eid="ACT 2:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 2:27"/>इसलिए कि तू मेरी जान को 'आलम — ए — अर्वाह में ना छोड़ेगा,</para>
  <para style="q" vid="ACT 2:27">और ना अपने पाक के सड़ने की नौबत पहुँचने देगा।<verse eid="ACT 2:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="ACT 2:28"/>तू ने मुझे ज़िन्दगी की राहें बताईं</para>
  <para style="q" vid="ACT 2:28">तू मुझे अपने दीदार के ज़रिए ख़ुशी से भर देगा।<verse eid="ACT 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29"/>ऐ भाइयों! मैं क़ौम के बुज़ुर्ग, दाऊद के हक़ में तुम से दिलेरी के साथ कह सकता हूँ कि वो मरा और दफ़्न भी हुआ; और उसकी क़ब्र आज तक हम में मौजूद है। <verse eid="ACT 2:29"/><verse number="30" style="v" sid="ACT 2:30"/>पस नबी होकर और ये जान कर कि ख़ुदा ने मुझ से क़सम खाई है कि तेरी नस्ल से एक शख़्स को तेरे तख़्त पर बिठाऊँगा। <verse eid="ACT 2:30"/><verse number="31" style="v" sid="ACT 2:31"/>उसने नबुव्वत के तौर पर मसीह के जी उठने का ज़िक्र किया कि ना वो' आलम' ए' अर्वाह में छोड़ेगा, ना उसके जिस्म के सड़ने की नौबत पहुँचेगी।<verse eid="ACT 2:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 2:32"/>इसी ईसा को ख़ुदा ने जिलाया; जिसके हम सब गवाह हैं। <verse eid="ACT 2:32"/><verse number="33" style="v" sid="ACT 2:33"/>पस ख़ुदा के दहने हाथ से सर बलन्द होकर, और बाप से वो रूह — उल — क़ुद्‍दुस हासिल करके जिसका वा'दा किया गया था, उसने ये नाज़िल किया जो तुम देखते और सुनते हो।<verse eid="ACT 2:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 2:34"/>क्यूँकी दाऊद बादशाह तो आस्मान पर नहीं चढ़ा, लेकिन वो ख़ुद कहता है,</para>
  <para style="q" vid="ACT 2:34">कि ख़ुदावन्द ने मेरे ख़ुदा से कहा, मेरी दहनी तरफ़ बैठ।<verse eid="ACT 2:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="ACT 2:35"/>जब तक मैं तेरे दुश्मनों को तेरे पाँओ तले की चौकी न कर दूँ।’<verse eid="ACT 2:35"/></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 2:36"/>“पस इस्राईल का सारा घराना यक़ीन जान ले कि ख़ुदा ने उसी ईसा को जिसे तुम ने मस्लूब किया ख़ुदावन्द भी किया और मसीह भी।”<verse eid="ACT 2:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37"/>जब उन्हों ने ये सुना तो उनके दिलों पर चोट लगी, और पतरस और बाक़ी रसूलों से कहा, “ऐ भाइयों हम क्या करें?” <verse eid="ACT 2:37"/><verse number="38" style="v" sid="ACT 2:38"/>पतरस ने उन से कहा, तौबा करो और तुम में से हर एक अपने गुनाहों की मु'आफ़ी के लिए ईसा मसीह के नाम पर बपतिस्मा ले तो तुम रूह — उल — क़ुद्दूस इनाम में पाओ गे। <verse eid="ACT 2:38"/><verse number="39" style="v" sid="ACT 2:39"/>इसलिए कि ये वा'दा तुम और तुम्हारी औलाद और उन सब दूर के लोगों से भी है; जिनको ख़ुदावन्द हमारा ख़ुदा अपने पास बुलाएगा।<verse eid="ACT 2:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40"/>उसने और बहुत सी बातें जता जता कर उन्हें ये नसीहत की, कि अपने आपको इस टेढ़ी क़ौम से बचाओ। <verse eid="ACT 2:40"/><verse number="41" style="v" sid="ACT 2:41"/>पस जिन लोगों ने उसका कलाम क़ुबूल किया, उन्होंने बपतिस्मा लिया और उसी रोज़ तीन हज़ार आदमियों के क़रीब उन में मिल गए।<verse eid="ACT 2:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42"/>और ये रसूलों से तालीम पाने और रिफ़ाक़त रखने में, और रोटी तोड़ने और दुआ करने में मशग़ूल रहे।<verse eid="ACT 2:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43"/>और हर शख़्स पर ख़ौफ़ छा गया और बहुत से 'अजीब काम और निशान रसूलों के ज़रिए से ज़ाहिर होते थे। <verse eid="ACT 2:43"/><verse number="44" style="v" sid="ACT 2:44"/>और जो ईमान लाए थे वो सब एक जगह रहते थे और सब चीज़ों में शरीक थे। <verse eid="ACT 2:44"/><verse number="45" style="v" sid="ACT 2:45"/>और अपना माल — ओर अस्बाब बेच बेच कर हर एक की ज़रुरत के मुवाफ़िक़ सब को बाँट दिया करते थे।<verse eid="ACT 2:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 2:46"/>और हर रोज़ एक दिल होकर हैकल में जमा हुआ करते थे, और घरों में रोटी तोड़कर ख़ुशी और सादा दिली से खाना खाया करते थे। <verse eid="ACT 2:46"/><verse number="47" style="v" sid="ACT 2:47"/>और ख़ुदा की हम्द करते और सब लोगों को अज़ीज़ थे; और जो नजात पाते थे उनको ख़ुदावन्द हर रोज़ जमाअत में मिला देता था।<verse eid="ACT 2:47"/></para>
  <chapter eid="ACT 2"/>
  <chapter number="3" style="c" sid="ACT 3"/>
  <para style="s">पतरस का एक लंगड़े आदमी को ठीक करना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1"/>पतरस और यूहन्ना दुआ के वक़्त या'नी दो पहर तीन बजे हैकल को जा रहे थे। <verse eid="ACT 3:1"/><verse number="2" style="v" sid="ACT 3:2"/>और लोग एक पैदाइशी लंगड़े को ला रहे थे, जिसको हर रोज़ हैकल के उस दरवाज़े पर बिठा देते थे, जो ख़ूबसूरत कलहाता है ताकि हैकल में जाने वालों से भीख माँगे। <verse eid="ACT 3:2"/><verse number="3" style="v" sid="ACT 3:3"/>जब उस ने पतरस और यूहन्ना को हैकल जाते देखा तो उन से भीख माँगी।<verse eid="ACT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 3:4"/>पतरस और यूहन्ना ने उस पर ग़ौर से नज़र की और पतरस ने कहा, “हमारी तरफ़ देख।” <verse eid="ACT 3:4"/><verse number="5" style="v" sid="ACT 3:5"/>वो उन से कुछ मिलने की उम्मीद पर उनकी तरफ़ मुतवज्जह हुआ। <verse eid="ACT 3:5"/><verse number="6" style="v" sid="ACT 3:6"/>पतरस ने कहा, “चांदी सोना तो मेरे पास है नहीं! मगर जो मेरे पास है वो तुझे दे देता हूँ ईसा मसीह नासरी के नाम से चल फिर।”<verse eid="ACT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 3:7"/>और उसका दाहिना हाथ पकड़ कर उसको उठाया, और उसी दम उसके पाँव और टख़ने मज़बूत हो गए। <verse eid="ACT 3:7"/><verse number="8" style="v" sid="ACT 3:8"/>और वो कूद कर खड़ा हो गया और चलने फिरने लगा; और चलता और कूदता और ख़ुदा की हम्द करता हुआ उनके साथ हैकल में गया।<verse eid="ACT 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 3:9"/>और सब लोगों ने उसे चलते फिरते और ख़ुदा की हम्द करते देख कर। <verse eid="ACT 3:9"/><verse number="10" style="v" sid="ACT 3:10"/>उसको पहचाना, कि ये वही है जो हैकल के ख़ूबसूरत दरवाज़े पर बैठ कर भीख माँगा करता था; और उस माजरे से जो उस पर वाक़े' हुआ था, बहुत दंग ओर हैरान हुए।<verse eid="ACT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11"/>जब वो पतरस और यूहन्ना को पकड़े हुए था, तो सब लोग बहुत हैरान हो कर उस बरामदह की तरफ़ जो सुलैमान का कहलाता है; उनके पास दौड़े आए। <verse eid="ACT 3:11"/><verse number="12" style="v" sid="ACT 3:12"/>पतरस ने ये देख कर लोगों से कहा; “ऐ इस्राईलियों इस पर तुम क्यूँ ताअ'ज्जुब करते हो और हमें क्यूँ इस तरह देख रहे हो; कि गोया हम ने अपनी क़ुदरत या दीनदारी से इस शख़्स को चलता फिरता कर दिया?<verse eid="ACT 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 3:13"/>अब्रहाम, इज़्हाक़ और याक़ूब के ख़ुदा या'नी हमारे बाप दादा के ख़ुदा ने अपने ख़ादिम ईसा को जलाल दिया, जिसे तुम ने पकड़वा दिया और जब पीलातुस ने उसे छोड़ देने का इरादा किया तो तुम ने उसके सामने उसका इन्कार किया। <verse eid="ACT 3:13"/><verse number="14" style="v" sid="ACT 3:14"/>तुम ने उस क़ुद्दूस और रास्तबाज़ का इन्कार किया; और पीलातुस से दरख़्वास्त की कि एक खताकार तुम्हारी ख़ातिर छोड़ दिया जाए।<verse eid="ACT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 3:15"/>मगर ज़िन्दगी के मालिक को क़त्ल किया जाए; जिसे ख़ुदा ने मुर्दों में से जिलाया; इसके हम गवाह हैं।<verse eid="ACT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 3:16"/>उसी के नाम से उस ईमान के वसीले से जो उसके नाम पर है, इस शख़्स को मज़बूत किया जिसे तुम देखते और जानते हो। बेशक उसी ईमान ने जो उसके वसीला से है ये पूरी तरह से तन्दरूस्ती तुम सब के सामने उसे दी। <verse eid="ACT 3:16"/><verse number="17" style="v" sid="ACT 3:17"/>ऐ भाइयों! मैं जानता हूँ कि तुम ने ये काम नादानी से किया; और ऐसा ही तुम्हारे सरदारों ने भी। <verse eid="ACT 3:17"/><verse number="18" style="v" sid="ACT 3:18"/>मगर जिन बातों की ख़ुदा ने सब नबियो की ज़बानी पहले ख़बर दी थी, कि उसका मसीह दुःख उठाएगा; वो उसने इसी तरह पूरी कीं।<verse eid="ACT 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 3:19"/>पस तौबा करो और फिर जाओ ताकि तुम्हारे गुनाह मिटाए जाऐं, और इस तरह ख़ुदावन्द के हुज़ूर से ताज़गी के दिन आएँ। <verse eid="ACT 3:19"/><verse number="20" style="v" sid="ACT 3:20"/>और वो उस मसीह को जो तुम्हारे वास्ते मुक़र्रर हुआ है, या'नी ईसा को भेजे।<verse eid="ACT 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 3:21"/>ज़रूरी है कि वो असमान में उस वक़्त तक रहे; जब तक कि वो सब चीज़ें बहाल न की जाएँ, जिनका ज़िक्र ख़ुदा ने अपने पाक नबियों की ज़बानी किया है; जो दुनिया के शुरू से होते आए हैं। <verse eid="ACT 3:21"/><verse number="22" style="v" sid="ACT 3:22"/>चुनाँचे मूसा ने कहा, कि ख़ुदावन्द ख़ुदा तुम्हारे भाइयों में से तुम्हारे लिए मुझसा एक नबी पैदा करेगा जो कुछ वो तुम से कहे उसकी सुनना।<verse eid="ACT 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 3:23"/>और यूँ होगा कि जो शख़्स उस नबी की न सुनेगा वो उम्मत में से नेस्त — ओ — नाबूद कर दिया जाएगा।<verse eid="ACT 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24"/>बल्कि समुएल से लेकर पिछलों तक जितने नबियों ने कलाम किया, उन सब ने इन दिनों की ख़बर दी है। <verse eid="ACT 3:24"/><verse number="25" style="v" sid="ACT 3:25"/>तुम नबियों की औलाद और उस अहद के शरीक हो, जो ख़ुदा ने तुम्हारे बाप दादा से बाँधा, जब इब्राहीम से कहा, कि तेरी औलाद से दुनिया के सब घराने बर्क़त पाएँगे।<verse eid="ACT 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 3:26"/>ख़ुदा ने अपने ख़ादिम को उठा कर पहले तुम्हारे पास भेजा; ताकि तुम में से हर एक को उसकी बुराइयों से हटाकर उसे बर्क़त दे।”<verse eid="ACT 3:26"/></para>
  <chapter eid="ACT 3"/>
  <chapter number="4" style="c" sid="ACT 4"/>
  <para style="s">पतरस और यूहन्ना कचहरी में</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1"/>जब वो लोगों से ये कह रहे थे तो काहिन और हैकल का मालिक और सदूक़ी उन पर चढ़ आए। <verse eid="ACT 4:1"/><verse number="2" style="v" sid="ACT 4:2"/>वो ग़मगीन हुए क्यूँकि यह लोगों को ता'लीम देते और ईसा की मिसाल देकर मुर्दों के जी उठने का ऐलान करते थे। <verse eid="ACT 4:2"/><verse number="3" style="v" sid="ACT 4:3"/>और उन्होंने उन को पकड़ कर दुसरे दिन तक हवालात में रख्खा; क्यूँकि शाम हो गेई थी। <verse eid="ACT 4:3"/><verse number="4" style="v" sid="ACT 4:4"/>मगर कलाम के सुनने वालों में से बहुत से ईमान लाए; यहाँ तक कि मर्दो की ता'दाद पाँच हज़ार के क़रीब हो गेई।<verse eid="ACT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5"/>दुसरे दिन यूँ हुआ कि उनके सरदार और बुज़ुर्ग और आलिम। <verse eid="ACT 4:5"/><verse number="6" style="v" sid="ACT 4:6"/>और सरदार काहिन हन्ना और काइफ़ा, यूहन्ना, और इस्कन्दर और जितने सरदार काहिन के घराने के थे, येरूशलेम में जमा हुए। <verse eid="ACT 4:6"/><verse number="7" style="v" sid="ACT 4:7"/>और उनको बीच में खड़ा करके पूछने लगे कि तुम ने ये काम किस क़ुदरत और किस नाम से किया?<verse eid="ACT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8"/>उस वक़्त पतरस ने रूह — उल — कुददूस से भरपूर होकर उन से कहा। <verse eid="ACT 4:8"/><verse number="9" style="v" sid="ACT 4:9"/>ऐ उम्मत के सरदारों और बुज़ुर्गों; अगर आज हम से उस एहसान के बारे में पूछ — ताछ की जाती है, जो एक कमज़ोर आदमी पर हुआ; कि वो क्यूँकर अच्छा हो गया? <verse eid="ACT 4:9"/><verse number="10" style="v" sid="ACT 4:10"/>तो तुम सब और इस्राईल की सारी उम्मत को मा'लूम हो कि ईसा मसीह नासरी जिसको तुम ने मस्लूब किया, उसे ख़ुदा ने मुर्दों में से जिलाया, उसी के नाम से ये शख़्स तुम्हारे सामने तन्दरुस्त खड़ा है।<verse eid="ACT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 4:11"/>ये वही पत्थर है जिसे तुमने हक़ीर जाना और वो कोने के सिरे का पत्थर हो गया। <verse eid="ACT 4:11"/><verse number="12" style="v" sid="ACT 4:12"/>और किसी दूसरे के वसीले से नजात नहीं, क्यूँकि आसमान के तले आदमियों को कोई दुसरा नाम नहीं बख़्शा गया, जिसके वसीले से हम नजात पा सकें।<verse eid="ACT 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13"/>जब उन्होंने पतरस और यूहन्ना की हिम्मत देखी, और मा'लूम किया कि ये अनपढ़ और नावाक़िफ़ आदमी हैं, तो ता'अज्जुब किया; फिर ऊन्हें पहचाना कि ये ईसा के साथ रहे हैं।<verse eid="ACT 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 4:14"/>और उस आदमी को जो अच्छा हुआ था, उनके साथ खड़ा देखकर कुछ ख़िलाफ़ न कह सके।<verse eid="ACT 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 4:15"/>मगर उन्हें सद्रे — ए — अदालत से बाहर जाने का हुक्म देकर आपस में मशवरा करने लगे। <verse eid="ACT 4:15"/><verse number="16" style="v" sid="ACT 4:16"/>“कि हम इन आदमियों के साथ क्या करें? क्यूँकि येरूशलेम के सब रहने वालों पर यह रोशन है। कि उन से एक खुला मोजिज़ा ज़ाहिर हुआ और हम इस का इन्कार नहीं कर सकते। <verse eid="ACT 4:16"/><verse number="17" style="v" sid="ACT 4:17"/>लेकिन इसलिए कि ये लोगों में ज़्यादा मशहूर न हो, हम उन्हें धमकाएं कि फिर ये नाम लेकर किसी से बात न करें।” <verse eid="ACT 4:17"/><verse number="18" style="v" sid="ACT 4:18"/>पस उन्हें बुला कर ताकीद की कि ईसा का नाम लेकर हरगिज़ बात न करना और न तालीम देना।<verse eid="ACT 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 4:19"/>मगर पतरस और यूहन्ना ने जवाब में उनसे कहा, कि तुम ही इन्साफ़ करो, आया ख़ुदा के नज़दीक ये वाजिब है कि हम ख़ुदा की बात से तुम्हारी बात ज़्यादा सुनें? <verse eid="ACT 4:19"/><verse number="20" style="v" sid="ACT 4:20"/>क्यूँकि मुम्किन नहीं कि जो हम ने देखा और सुना है वो न कहें।<verse eid="ACT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21"/>उन्होंने उनको और धमकाकर छोड़ दिया; क्यूँकि लोगों कि वजह से उनको सज़ा देने का कोई मौक़ा; न मिला इसलिए कि सब लोग उस माजरे कि वजह से ख़ुदा की बड़ाई करते थे। <verse eid="ACT 4:21"/><verse number="22" style="v" sid="ACT 4:22"/>क्यूँकि वो शख़्स जिस पर ये शिफ़ा देने का मोजिज़ा हुआ था, चालीस बरस से ज़्यादा का था।<verse eid="ACT 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23"/>वो छूटकर अपने लोगों के पास गए, और जो कुछ सरदार काहिनों और बुज़ुर्गों ने उन से कहा था बयान किया। <verse eid="ACT 4:23"/><verse number="24" style="v" sid="ACT 4:24"/>जब उन्होंने ये सुना तो एक दिल होकर बुलन्द आवाज़ से ख़ुदा से गुज़ारिश की, 'ऐ' मालिक तू वो है जिसने आसमान और ज़मीन और समुन्दर और जो कुछ उन में है पैदा किया। <verse eid="ACT 4:24"/><verse number="25" style="v" sid="ACT 4:25"/>तूने रूह — उल — क़ुद्दूस के वसीले से हमारे बाप अपने ख़ादिम दाऊद की ज़बानी फ़रमाया कि, क़ौमों ने क्यूँ धूम मचाई? और उम्मतों ने क्यूँ बातिल ख़याल किए? <verse eid="ACT 4:25"/><verse number="26" style="v" sid="ACT 4:26"/>ख़ुदावन्द और उसके मसीह की मुख़ालिफ़त को ज़मीन के बादशाह उठ खड़े हुए, और सरदार जमा हो गए।’<verse eid="ACT 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27"/>क्यूँकि वाक़'ई तेरे पाक ख़ादिम ईसा के बरख़िलाफ़ जिसे तूने मसह किया। हेरोदेस, और, पुनित्युस पीलातुस, ग़ैर क़ौमों और इस्राईलियों के साथ इस शहर में जमा हुए। <verse eid="ACT 4:27"/><verse number="28" style="v" sid="ACT 4:28"/>ताकि जो कुछ पहले से तेरी क़ुदरत और तेरी मसलेहत से ठहर गया था, वही 'अमल में लाएँ।<verse eid="ACT 4:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 4:29"/>अब, ऐ ख़ुदावन्द “उनकी धमकियों को देख, और अपने बन्दों को ये तौफ़ीक़ दे, कि वो तेरा कलाम कमाल दिलेरी से सुनाएँ। <verse eid="ACT 4:29"/><verse number="30" style="v" sid="ACT 4:30"/>और तू अपना हाथ शिफ़ा देने को बढ़ा और तेरे पाक ख़ादिम ईसा के नाम से मोजिज़े और अजीब काम ज़हूर में आएँ।” <verse eid="ACT 4:30"/><verse number="31" style="v" sid="ACT 4:31"/>जब वो दुआ कर चुके, तो जिस मकान में जमा थे, वो हिल गया और वो सब रूह — उल — क़ुद्दूस से भर गए, और ख़ुदा का कलाम दिलेरी से सुनाते रहे।<verse eid="ACT 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32"/>और ईमानदारों की जमा'अत एक दिल और एक जान थी; और किसी ने भी अपने माल को अपना न कहा, बल्कि उनकी सब चीज़ें मुश्तरका थीं। <verse eid="ACT 4:32"/><verse number="33" style="v" sid="ACT 4:33"/>और रसूल बड़ी क़ुदरत से ख़ुदावन्द ईसा के जी उठने की गवाही देते रहे, और उन सब पर बड़ा फ़ज़ल था।<verse eid="ACT 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 4:34"/>क्यूँकि उन में कोई भी मुहताज न था, इसलिए कि जो लोग ज़मीनों और घरों के मालिक थे, उनको बेच बेच कर बिकी हुई चीज़ों की क़ीमत लाते। <verse eid="ACT 4:34"/><verse number="35" style="v" sid="ACT 4:35"/>और रसूलों के पाँव में रख देते थे, फिर हर एक को उसकी ज़रुरत के मुवाफ़िक़ बाँट दिया जाता था।<verse eid="ACT 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36"/>और यूसुफ़ नाम एक लावी था, जिसका लक़ब रसूलों ने बरनबास: या'नी नसीहत का बेटा रख्खा था, और जिसकी पैदाइश कुप्रुस टापू की थी। <verse eid="ACT 4:36"/><verse number="37" style="v" sid="ACT 4:37"/>उसका एक खेत था, जिसको उसने बेचा और क़ीमत लाकर रसूलों के पाँव में रख दी।<verse eid="ACT 4:37"/></para>
  <chapter eid="ACT 4"/>
  <chapter number="5" style="c" sid="ACT 5"/>
  <para style="s">हननियाह और सफ़ीरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1"/>और एक शख़्स हननियाह नाम और उसकी बीवी सफ़ीरा ने जायदाद बेची। <verse eid="ACT 5:1"/><verse number="2" style="v" sid="ACT 5:2"/>और उसने अपनी बीवी के जानते हुए क़ीमत में से कुछ रख छोड़ा और एक हिस्सा लाकर रसूलों के पाँव में रख दिया।<verse eid="ACT 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3"/>मगर पतरस ने कहा, ऐ हननियाह! क्यूँ शैतान ने तेरे दिल में ये बात डाल दी, कि तू रूह — उल — क़ुद्दूस से झूठ बोले और ज़मीन की क़ीमत में से कुछ रख छोड़े। <verse eid="ACT 5:3"/><verse number="4" style="v" sid="ACT 5:4"/>क्या जब तक वो तेरे पास थी वो तेरी न थी? और जब बेची गई तो तेरे इख़्तियार में न रही, तूने क्यूँ अपने दिल में इस बात का ख़याल बाँधा? तू आदमियों से नहीं बल्कि ख़ुदा से झूठ बोला। <verse eid="ACT 5:4"/><verse number="5" style="v" sid="ACT 5:5"/>ये बातें सुनते ही हननियाह गिर पड़ा, और उसका दम निकल गया, और सब सुनने वालों पर बड़ा ख़ौफ़ छा गया। <verse eid="ACT 5:5"/><verse number="6" style="v" sid="ACT 5:6"/>कुछ जवानों ने उठ कर उसे कफ़्नाया और बाहर ले जाकर दफ़्न किया।<verse eid="ACT 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7"/>तक़रीबन तीन घंटे गुज़र जाने के बाद उसकी बीवी इस हालात से बेख़बर अन्दर आई। <verse eid="ACT 5:7"/><verse number="8" style="v" sid="ACT 5:8"/>पतरस ने उस से कहा, मुझे बता; क्या तुम ने इतने ही की ज़मीन बेची थी? उसने कहा हाँ इतने ही की।<verse eid="ACT 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9"/>पतरस ने उससे कहा, “तुम ने क्यूँ ख़ुदावन्द की रूह को आज़माने के लिए ये क्या किया? देख तेरे शौहर को दफ़्न करने वाले दरवाज़े पर खड़े हैं, और तुझे भी बाहर ले जाएँगे।” <verse eid="ACT 5:9"/><verse number="10" style="v" sid="ACT 5:10"/>वो उसी वक़्त उसके क़दमों पर गिर पड़ी और उसका दम निकल गया, और जवानों ने अन्दर आकर उसे मुर्दा पाया और बाहर ले जाकर उसके शौहर के पास दफ़्न कर दिया। <verse eid="ACT 5:10"/><verse number="11" style="v" sid="ACT 5:11"/>और सारी कलीसिया बल्कि इन बातों के सब सुननेवालों पर बड़ा ख़ौफ़ छा गया।<verse eid="ACT 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12"/>और रसूलों के हाथों से बहुत से निशान और अजीब काम लोगों में ज़ाहिर होते थे, और वो सब एक दिल होकर सुलैमान के बरामदेह में जमा हुआ करते थे। <verse eid="ACT 5:12"/><verse number="13" style="v" sid="ACT 5:13"/>लेकिन बे ईमानों में से किसी को हिम्मत न हुई, कि उन में जा मिले, मगर लोग उनकी बड़ाई करते थे।<verse eid="ACT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 5:14"/>और ईमान लाने वाले मर्द — ओ — औरत ख़ुदावन्द की कलीसिया में और भी कसरत से आ मिले। <verse eid="ACT 5:14"/><verse number="15" style="v" sid="ACT 5:15"/>यहाँ तक कि लोग बीमारों को सड़कों पर ला लाकर चार पाइयों और ख़टोलो पर लिटा देते थे, ताकि जब पतरस आए तो उसका साया ही उन में से किसी पर पड़ जाए। <verse eid="ACT 5:15"/><verse number="16" style="v" sid="ACT 5:16"/>और येरूशलेम के चारों तरफ़ के कस्बों से भी लोग बीमारों और नापाक रूहों के सताए हुवों को लाकर कसरत से जमा होते थे, और वो सब अच्छे कर दिए जाते थे।<verse eid="ACT 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17"/>फिर सरदार काहिन और उसके सब साथी जो सदूक़ियों के फ़िरक़े के थे, हसद के मारे उठे। <verse eid="ACT 5:17"/><verse number="18" style="v" sid="ACT 5:18"/>और रसूलों को पकड़ कर हवालात में रख दिया।<verse eid="ACT 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 5:19"/>मगर ख़ुदावन्द के एक फ़रिश्ते ने रात को क़ैदख़ाने के दरवाज़े खोले और उन्हें बाहर लाकर कहा कि। <verse eid="ACT 5:19"/><verse number="20" style="v" sid="ACT 5:20"/>“जाओ, हैकल में खड़े होकर इस ज़िन्दगी की सब बातें लोगों को सुनाओ।” <verse eid="ACT 5:20"/><verse number="21" style="v" sid="ACT 5:21"/>वो ये सुनकर सुबह होते ही हैकल में गए, और ता'लीम देने लगे; मगर सरदार काहिन और उसके साथियों ने आकर सद्रे — ऐ — अदालत वालों और बनी इस्राईल के सब बुज़ुर्गों को जमा किया, और क़ैद खाने में कहला भेजा उन्हें लाएँ।<verse eid="ACT 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 5:22"/>लेकिन सिपाहियों ने पहुँच कर उन्हें क़ैद खाने में न पाया, और लौट कर ख़बर दी <verse eid="ACT 5:22"/><verse number="23" style="v" sid="ACT 5:23"/>“हम ने क़ैद खाने को तो बड़ी हिफ़ाज़त से बन्द किया हुआ, और पहरेदारों को दरवाज़ों पर खड़े पाया; मगर जब खोला तो अन्दर कोई न मिला!”<verse eid="ACT 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 5:24"/>जब हैकल के सरदार और सरदार काहिनों ने ये बातें सुनी तो उनके बारे में हैरान हुए, कि इसका क्या अंजाम होगा? <verse eid="ACT 5:24"/><verse number="25" style="v" sid="ACT 5:25"/>इतने में किसी ने आकर उन्हें ख़बर दी कि देखो, वो आदमी जिन्हें तुम ने क़ैद किया था; हैकल में खड़े लोगों को ता'लीम दे रहे हैं।<verse eid="ACT 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 5:26"/>तब सरदार सिपाहियों के साथ जाकर उन्हें ले आया; लेकिन ज़बरदस्ती नहीं, क्यूँकि लोगों से डरते थे, कि हम पर पथराव न करें। <verse eid="ACT 5:26"/><verse number="27" style="v" sid="ACT 5:27"/>फिर उन्हें लाकर 'अदालत में खड़ा कर दिया, और सरदार काहिन ने उन से ये कहा। <verse eid="ACT 5:27"/><verse number="28" style="v" sid="ACT 5:28"/>“हम ने तो तुम्हें सख़्त ताकीद की थी, कि ये नाम लेकर ता'लीम न देना; मगर देखो तुम ने तमाम येरूशलेम में अपनी ता'लीम फैला दी, और उस शख़्स का ख़ून हमारी गर्दन पर रखना चहते हो।”<verse eid="ACT 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29"/>पतरस और रसूलों ने जवाब में कहा, कि; “हमें आदमियों के हुक्म की निस्बत ख़ुदा का हुक्म मानना ज़्यादा फ़र्ज़ है। <verse eid="ACT 5:29"/><verse number="30" style="v" sid="ACT 5:30"/>हमारे बाप दादा के ख़ुदा ने ईसा को जिलाया, जिसे तुमने सलीब पर लटका कर मार डाला था। <verse eid="ACT 5:30"/><verse number="31" style="v" sid="ACT 5:31"/>उसी को ख़ुदा ने मालिक और मुन्जी ठहराकर अपने दहने हाथ से सर बलन्द किया, ताकि इस्राईल को तौबा की तौफ़ीक़ और गुनाहों की मु'आफ़ी बख़्शे। <verse eid="ACT 5:31"/><verse number="32" style="v" sid="ACT 5:32"/>और हम इन बातों के गवाह हैं; रूह — उल — क़ुद्‍दुस भी जिसे ख़ुदा ने उन्हें बख़्शा है जो उसका हुक्म मानते हैं।”<verse eid="ACT 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33"/>वो ये सुनकर जल गए, और उन्हें क़त्ल करना चाहा। <verse eid="ACT 5:33"/><verse number="34" style="v" sid="ACT 5:34"/>मगर गमलीएल नाम एक फ़रीसी ने जो शरा' का मु'अल्लिम और सब लोगों में इज़्ज़तदार था; अदालत में खड़े होकर हुक्म दिया कि इन आदमियों को थोड़ी देर के लिए बाहर कर दो।<verse eid="ACT 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 5:35"/>फिर उस ने कहा, ऐ इस्राईलियो; इन आदमियों के साथ जो कुछ करना चाहते हो होशियारी से करना। <verse eid="ACT 5:35"/><verse number="36" style="v" sid="ACT 5:36"/>क्यूँकि इन दिनों से पहले थियूदास ने उठ कर दा'वा किया था, कि मैं भी कुछ हूँ; और तक़रीबन चार सौ आदमी उसके साथ हो गए थे, मगर वो मारा गया और जितने उसके मानने वाले थे, सब इधर उधर हुए; और मिट गए। <verse eid="ACT 5:36"/><verse number="37" style="v" sid="ACT 5:37"/>इस शख़्स के बाद यहूदाह गलीली नाम लिखवाने के दिनों में उठा; और उस ने कुछ लोग अपनी तरफ़ कर लिए; वो भी हलाक हुआ और जितने उसके मानने वाले थे सब इधर उधर हो गए।<verse eid="ACT 5:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 5:38"/>पस अब में तुम से कहता हूँ कि इन आदमियों से किनारा करो और उन से कुछ काम न रख्खो, कहीं ऐसा न हो कि ख़ुदा से भी लड़ने वाले ठहरो क्यूँकि ये तदबीर या काम अगर आदमियों की तरफ़ से है तो आप बरबाद हो जाएगा। <verse eid="ACT 5:38"/><verse number="39" style="v" sid="ACT 5:39"/>लेकिन अगर ख़ुदा की तरफ़ से है तो तुम इन लोगों को मग़लूब न कर सकोगे।<verse eid="ACT 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40"/>उन्होंने उसकी बात मानी और रसूलों को पास बुला उनको पिटवाया और ये हुक्म देकर छोड़ दिया कि ईसा का नाम लेकर बात न करना <verse eid="ACT 5:40"/><verse number="41" style="v" sid="ACT 5:41"/>पस वो अदालत से इस बात पर ख़ुश होकर चले गए; कि हम उस नाम की ख़ातिर बेइज़्ज़त होने के लायक़ तो ठहरे। <verse eid="ACT 5:41"/><verse number="42" style="v" sid="ACT 5:42"/>और वो हैकल में और घरों में हर रोज़ ता'लीम देने और इस बात की ख़ुशख़बरी सुनाने से कि ईसा ही मसीह है बाज़ न आए।<verse eid="ACT 5:42"/></para>
  <chapter eid="ACT 5"/>
  <chapter number="6" style="c" sid="ACT 6"/>
  <para style="s">सात आदमियों का खिदमत करने के लिए चुना जाना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1"/>उन दिनों में जब शागिर्द बहुत होते जाते थे, तो यूनानी माइल यहूदी इब्रानियों की शिकायत करने लगे; इसलिए कि रोज़ाना ख़बरगीरी में उनकी बेवाओं के बारे में लापरवाही होती थी।<verse eid="ACT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 6:2"/>और उन बारह ने शागिर्दों की जमा'अत को अपने पास बुलाकर कहा, मुनासिब नहीं कि हम ख़ुदा के कलाम को छोड़कर खाने पीने का इन्तिज़ाम करें। <verse eid="ACT 6:2"/><verse number="3" style="v" sid="ACT 6:3"/>पस, ऐ भाइयों! अपने में से सात नेक नाम शख़्सों को चुन लो जो रूह और दानाई से भरे हुए हों; कि हम उनको इस काम पर मुक़र्रर करें। <verse eid="ACT 6:3"/><verse number="4" style="v" sid="ACT 6:4"/>लेकिन हम तो दुआ में और कलाम की ख़िदमत में मशग़ूल रहेंगे।<verse eid="ACT 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5"/>ये बात सारी जमा'अत को पसन्द आई, पस उन्होंने स्तिफ़नुस नाम एक शख़्स को जो ईमान और रूह — उल — क़ुद्दूस से भरा हुआ था और फ़िलिप्पुस, व प्रुख़ुरुस, और नीकानोर, और तीमोन, और पर्मिनास और नीकुलाउस। को जो नौ मुरीद यहूदी अन्ताकी था, चुन लिया। <verse eid="ACT 6:5"/><verse number="6" style="v" sid="ACT 6:6"/>और उन्हें रसूलों के आगे खड़ा किया; उन्होंने दुआ करके उन पर हाथ रखे।<verse eid="ACT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7"/>और ख़ुदा का कलाम फैलता रहा, और येरूशलेम में शागिर्दों का शुमार बहुत ही बढ़ता गया, और काहिनों की बड़ी गिरोह इस दीन के तहत में हो गई।<verse eid="ACT 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8"/>स्तिफ़नुस फ़ज़ल और क़ुव्वत से भरा हुआ लोगों में बड़े बड़े अजीब काम और निशान ज़ाहिर किया करता था; <verse eid="ACT 6:8"/><verse number="9" style="v" sid="ACT 6:9"/>कि उस इबादतख़ाने से जो लिबिरतीनों का कहलाता है; और कुरेनियों शहर और इस्कन्दरियों क़स्बा और उन में से जो किलकिया और आसिया सूबे के थे, ये कुछ लोग उठ कर स्तिफ़नुस से बहस करने लगे।<verse eid="ACT 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 6:10"/>मगर वो उस दानाई और रूह का जिससे वो कलाम करता था, मुक़ाबिला न कर सके। <verse eid="ACT 6:10"/><verse number="11" style="v" sid="ACT 6:11"/>इस पर उन्होंने कुछ आदमियों को सिखाकर कहलवा दिया “हम ने इसको मूसा और ख़ुदा के बर — ख़िलाफ़ कुफ़्र की बातें करते सुना।”<verse eid="ACT 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 6:12"/>फिर वो 'अवाम और बुज़ुर्गों और आलिमों को उभार कर उस पर चढ़ गए; और पकड़ कर सद्रे — ए — 'अदालत में ले गए। <verse eid="ACT 6:12"/><verse number="13" style="v" sid="ACT 6:13"/>और झूठे गवाह खड़े किए जिन्होंने कहा, ये शख़्स इस पाक मुक़ाम और शरी'अत के बरख़िलाफ़ बोलने से बाज़ नहीं आता। <verse eid="ACT 6:13"/><verse number="14" style="v" sid="ACT 6:14"/>क्यूँकि हम ने उसे ये कहते सुना है; कि वही ईसा नासरी इस मुक़ाम को बरबाद कर देगा, और उन रस्मों को बदल डालेगा, जो मूसा ने हमें सौंपी हैं। <verse eid="ACT 6:14"/><verse number="15" style="v" sid="ACT 6:15"/>और उन सब ने जो अदालत में बैठे थे, उस पर ग़ौर से नज़र की तो देखा कि उसका चेहरा फ़रिश्ते के जैसा है।<verse eid="ACT 6:15"/></para>
  <chapter eid="ACT 6"/>
  <chapter number="7" style="c" sid="ACT 7"/>
  <para style="s">स्तिफ़नुस का कचहरी से बात करना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1"/>फिर सरदार काहिन ने कहा, “क्या ये बातें इसी तरह पर हैं?” <verse eid="ACT 7:1"/><verse number="2" style="v" sid="ACT 7:2"/>उस ने कहा,</para>
  <para style="p" vid="ACT 7:2">“ऐ भाइयों! और बुज़ुर्गों, सुनें। ख़ुदा ऐ' ज़ुल — जलाल हमारे बुज़ुर्ग अब्रहाम पर उस वक़्त ज़ाहिर हुआ जब वो हारान शहर में बसने से पहले मसोपोतामिया मुल्क में था।“ <verse eid="ACT 7:2"/><verse number="3" style="v" sid="ACT 7:3"/>और उस से कहा कि 'अपने मुल्क और अपने कुन्बे से निकल कर उस मुल्क में चला जा'जिसे मैं तुझे दिखाऊँगा।<verse eid="ACT 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 7:4"/>इस पर वो कसदियों के मुल्क से निकल कर हारान में जा बसा; और वहाँ से उसके बाप के मरने के बाद ख़ुदा ने उसको इस मुल्क में लाकर बसा दिया, जिस में तुम अब बसते हो। <verse eid="ACT 7:4"/><verse number="5" style="v" sid="ACT 7:5"/>और उसको कुछ मीरास बल्कि क़दम रखने की भी उस में जगह न दी मगर वा'दा किया कि में ये ज़मीन तेरे और तेरे बाद तेरी नस्ल के क़ब्ज़े में कर दूँगा, हालाँकि उसके औलाद न थी।<verse eid="ACT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 7:6"/>और ख़ुदा ने ये फ़रमाया, तेरी नस्ल ग़ैर मुल्क में परदेसी होगी, वो उसको ग़ुलामी में रख्खेंगे और चार सौ बरस तक उन से बदसुलूकी करेंगे। <verse eid="ACT 7:6"/><verse number="7" style="v" sid="ACT 7:7"/>फिर ख़ुदा ने कहा, जिस क़ौम की वो ग़ुलामी में रहेंगे उसको मैं सज़ा दूँगा; और उसके बाद वो निकलकर इसी जगह मेरी इबादत करेंगे। <verse eid="ACT 7:7"/><verse number="8" style="v" sid="ACT 7:8"/>और उसने उससे ख़तने का 'अहद बाँधा; और इसी हालत में अब्रहाम से इज़्हाक़ पैदा हुआ, और आठवें दिन उसका ख़तना किया गया; और इज़्हाक़ से या'क़ूब और याक़ूब से बारह क़बीलों के बुज़ुर्ग पैदा हुए।<verse eid="ACT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9"/>और बुज़ुर्गों ने हसद में आकर युसूफ़ को बेचा कि मिस्र में पहुँच जाए; मगर ख़ुदा उसके साथ था। <verse eid="ACT 7:9"/><verse number="10" style="v" sid="ACT 7:10"/>और उसकी सब मुसीबतों से उसने उसको छुड़ाया; और मिस्र के बादशाह फिर'औन के नज़दीक उसको मक़बूलियत और हिक्मत बख़्शी, और उसने उसे मिस्र और अपने सारे घर का सरदार कर दिया।<verse eid="ACT 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11"/>फिर मिस्र के सारे मुल्क और कनान में काल पड़ा, और बड़ी मुसीबत आई; और हमारे बाप दादा को खाना न मिलता था। <verse eid="ACT 7:11"/><verse number="12" style="v" sid="ACT 7:12"/>लेकिन याक़ूब ने ये सुनकर कि, मिस्र में अनाज है; हमारे बाप दादा को पहली बार भेजा। <verse eid="ACT 7:12"/><verse number="13" style="v" sid="ACT 7:13"/>और दूसरी बार यूसुफ़ अपने भाइयों पर ज़ाहिर हो गया और यूसुफ़ की क़ौमियत फिर'औन को मा'लूम हो गई।<verse eid="ACT 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 7:14"/>फिर यूसुफ़ ने अपने बाप याक़ूब और सारे कुन्बे को जो पछहत्तर जाने थीं; बुला भेजा। <verse eid="ACT 7:14"/><verse number="15" style="v" sid="ACT 7:15"/>और याक़ूब मिस्र में गया वहाँ वो और हमारे बाप दादा मर गए। <verse eid="ACT 7:15"/><verse number="16" style="v" sid="ACT 7:16"/>और वो शहर ऐ सिकम में पहुँचाए गए और उस मक़्बरे में दफ़्न किए गए' जिसको अब्रहाम ने सिक्म में रुपऐ देकर बनी हमूर से मोल लिया था।<verse eid="ACT 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17"/>लेकिन जब उस वादे की मी'आद पुरी होने को थी, जो ख़ुदा ने अब्रहाम से फ़रमाया था तो मिस्र में वो उम्मत बढ़ गई; और उनका शुमार ज़्यादा होता गया। <verse eid="ACT 7:17"/><verse number="18" style="v" sid="ACT 7:18"/>उस वक़्त तक कि दूसरा बादशाह मिस्र पर हुक्मरान हुआ; जो यूसुफ़ को न जानता था। <verse eid="ACT 7:18"/><verse number="19" style="v" sid="ACT 7:19"/>उसने हमारी क़ौम से चालाकी करके हमारे बाप दादा के साथ यहाँ तक बदसुलूकी की कि उन्हें अपने बच्चे फेंकने पड़े ताकि ज़िन्दा न रहें। <verse eid="ACT 7:19"/><verse number="20" style="v" sid="ACT 7:20"/>इस मौक़े पर मूसा पैदा हुआ; जो निहायत ख़ूबसूरत था, वो तीन महीने तक अपने बाप के घर में पाला गया। <verse eid="ACT 7:20"/><verse number="21" style="v" sid="ACT 7:21"/>मगर जब फेंक दिया गया, तो फिर'औन की बेटी ने उसे उठा लिया और अपना बेटा करके पाला। <verse eid="ACT 7:21"/><verse number="22" style="v" sid="ACT 7:22"/>और मूसा ने मिस्रियों के, तमाम इल्मो की ता'लीम पाई, और वो कलाम और काम में ताक़त वाला था।<verse eid="ACT 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23"/>और जब वो तक़रीबन चालीस बरस का हुआ, तो उसके जी में आया कि मैं अपने भाइयों बनी इस्राईल का हाल देखूँ। <verse eid="ACT 7:23"/><verse number="24" style="v" sid="ACT 7:24"/>चुनाँचे उन में से एक को ज़ुल्म उठाते देखकर उसकी हिमायत की, और मिस्री को मार कर मज़्लूम का बदला लिया। <verse eid="ACT 7:24"/><verse number="25" style="v" sid="ACT 7:25"/>उसने तो ख़याल किया कि मेरे भाई समझ लेंगे, कि ख़ुदा मेरे हाथों उन्हें छुटकारा देगा, मगर वो न समझे।<verse eid="ACT 7:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 7:26"/>फिर दूसरे दिन वो उन में से दो लड़ते हुओं के पास आ निकला और ये कहकर उन्हें सुलह करने की तरग़ीब दी कि ‘ऐ जवानों तुम तो भाई भाई हो, क्यूँ एक दूसरे पर ज़ुल्म करते हो?’ <verse eid="ACT 7:26"/><verse number="27" style="v" sid="ACT 7:27"/>लेकिन जो अपने पड़ोसी पर ज़ुल्म कर रहा था, उसने ये कह कर उसे हटा दिया तुझे किसने हम पर हाकिम और क़ाज़ी मुक़र्रर किया? <verse eid="ACT 7:27"/><verse number="28" style="v" sid="ACT 7:28"/>क्या तू मुझे भी क़त्ल करना चहता है? जिस तरह कल उस मिस्री को क़त्ल किया था।<verse eid="ACT 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 7:29"/>मूसा ये बात सुन कर भाग गया, और मिदियान के मुल्क में परदेसी रहा, और वहाँ उसके दो बेटे पैदा हुए।<verse eid="ACT 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30"/>और जब पूरे चालीस बरस हो गए, तो कोह-ए-सीना के वीराने में जलती हुई झाड़ी के शो'ले में उसको एक फ़रिश्ता दिखाई दिया। <verse eid="ACT 7:30"/><verse number="31" style="v" sid="ACT 7:31"/>जब मूसा ने उस पर नज़र की तो उस नज़ारे से ताज़्जुब किया, और जब देखने को नज़दीक गया तौ ख़ुदावन्द की आवाज़ आई कि <verse eid="ACT 7:31"/><verse number="32" style="v" sid="ACT 7:32"/>मैं तेरे बाप दादा का ख़ुदा या'नी अब्रहाम इज़्हाक़ और याक़ूब का ख़ुदा हूँ तब मूसा काँप गया और उसको देखने की हिम्मत न रही। <verse eid="ACT 7:32"/><verse number="33" style="v" sid="ACT 7:33"/>ख़ुदावन्द ने उससे कहा कि अपने पाँव से जूती उतार ले, क्यूँकि जिस जगह तू खड़ा है, वो पाक ज़मीन है। <verse eid="ACT 7:33"/><verse number="34" style="v" sid="ACT 7:34"/>मैंने वाक़'ई अपनी उस उम्मत की मुसीबत देखी जो मिस्र में है। और उनका आह — व नाला सुना पस उन्हें छुड़ाने उतरा हूँ, अब आ मैं तुझे मिस्र में भेजूँगा।<verse eid="ACT 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35"/>जिस मूसा का उन्होंने ये कह कर इन्कार किया था, तुझे किसने हाकिम और क़ाज़ी मुक़र्रर किया 'उसी को ख़ुदा ने हाकिम और छुड़ाने वाला ठहरा कर, उस फ़रिश्ते के ज़रिए से भेजा जो उस झाड़ी में नज़र आया था। <verse eid="ACT 7:35"/><verse number="36" style="v" sid="ACT 7:36"/>यही शख़्स उन्हें निकाल लाया और मिस्र और बहर — ए — क़ुलज़ूम और वीराने में चालीस बरस तक अजीब काम और निशान दिखाए। <verse eid="ACT 7:36"/><verse number="37" style="v" sid="ACT 7:37"/>ये वही मूसा है, जिसने बनी इस्राईल से कहा, ख़ुदा तुम्हारे भाइयों में से तुम्हारे लिए मुझ सा एक नबी पैदा करेगा।<verse eid="ACT 7:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 7:38"/>ये वही है, जो वीराने की कलीसिया में उस फ़रिश्ते के साथ जो कोह-ए-सीना पर उससे हम कलाम हुआ, और हमारे बाप दादा के साथ था उसी को ज़िन्दा कलाम मिला कि हम तक पहुँचा दे। <verse eid="ACT 7:38"/><verse number="39" style="v" sid="ACT 7:39"/>मगर हमारे बाप दादा ने उसके फ़रमाँबरदार होना न चाहा, बल्कि उसको हटा दिया और उनके दिल मिस्र की तरफ़ माइल हुए। <verse eid="ACT 7:39"/><verse number="40" style="v" sid="ACT 7:40"/>और उन्होंने हारून से कहा, हमारे लिए ऐसे मा'बूद बना जो हमारे आगे आगे चलें, क्यूँकि ये मूसा जो हमें मुल्क — ए मिस्र से निकाल लाया, हम नहीं जानते कि वो क्या हुआ।<verse eid="ACT 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 7:41"/>और उन दिनों में उन्होंने एक बछड़ा बनाया, और उस बुत को क़ुर्बानी चढ़ाई, और अपने हाथों के कामों की ख़ुशी मनाई। <verse eid="ACT 7:41"/><verse number="42" style="v" sid="ACT 7:42"/>पस ख़ुदा ने मुँह मोड़कर उन्हें छोड़ दिया कि आसमानी फ़ौज को पूजें चुनाँचे नबियों की किताबों में लिखा है ऐ इस्राईल के घराने क्या तुम ने वीराने में चालीस बरस मुझको ज़बीहे और क़ुर्बानियाँ गुज़रानी? <verse eid="ACT 7:42"/><verse number="43" style="v" sid="ACT 7:43"/>बल्कि तुम मोलक के ख़ेमे और रिफ़ान देवता के तारे को लिए फिरते थे, या'नी उन मूरतों को जिन्हें तुम ने सज्दा करने के लिए बनाया था। पस में तुम्हें बाबुल के परे ले जाकर बसाऊँगा।<verse eid="ACT 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44"/>शहादत का ख़ेमा वीराने में हमारे बाप दादा के पास था, जैसा कि मूसा से कलाम करने वाले ने हुक्म दिया था, जो नमूना तूने देखा है, उसी के मुवाफ़िक़ इसे बना। <verse eid="ACT 7:44"/><verse number="45" style="v" sid="ACT 7:45"/>उसी ख़ेमे को हमारे बाप दादा अगले बुज़ुर्गों से हासिल करके ईसा के साथ लाए जिस वक़्त उन क़ौमों की मिल्कियत पर क़ब्ज़ा किया जिनको ख़ुदा ने हमारे बाप दादा के सामने निकाल दिया, और वो दाऊद के ज़माने तक रहा। <verse eid="ACT 7:45"/><verse number="46" style="v" sid="ACT 7:46"/>उस पर ख़ुदा की तरफ़ से फ़ज़ल हुआ, और उस ने दरख़्वास्त की, कि में याक़ूब के ख़ुदा के वास्ते घर तैयार करूँ।<verse eid="ACT 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="ACT 7:47"/>मगर सुलैमान ने उस के लिए घर बनाया।<verse eid="ACT 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48"/>लेकिन ख़ुदा हाथ के बनाए हुए घरों में नहीं रहता चुनाँचे नबी कहता है कि<verse eid="ACT 7:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="ACT 7:49"/>ख़ुदावन्द फ़रमाता है, आसमान मेरा तख़्त</para>
  <para style="q" vid="ACT 7:49">और ज़मीन मेरे पाँव तले की चौकी है,</para>
  <para style="q" vid="ACT 7:49">तुम मेरे लिए कैसा घर बनाओगे,</para>
  <para style="q" vid="ACT 7:49">या मेरी आरामगाह कौन सी है?<verse eid="ACT 7:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="ACT 7:50"/>क्या ये सब चीज़ें मेरे हाथ से नहीं बनी<verse eid="ACT 7:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51"/>ऐ गर्दन कशो, दिल और कान के नामख़्तूनों, तुम हर वक़्त रूह — उल — क़ुद्दूस की मुख़ालिफ़त करते हो; जैसे तुम्हारे बाप दादा करते थे, वैसे ही तुम भी करते हो। <verse eid="ACT 7:51"/><verse number="52" style="v" sid="ACT 7:52"/>नबियों में से किसको तुम्हारे बाप दादा ने नहीं सताया? उन्हों ने तो उस रास्तबाज़ के आने की पेश — ख़बरी देनेवालों को क़त्ल किया, और अब तुम उसके पकड़वाने वाले और क़ातिल हुए। <verse eid="ACT 7:52"/><verse number="53" style="v" sid="ACT 7:53"/>तुम ने फ़रिश्तों के ज़रिए से शरी'अत तो पाई, पर अमल नहीं किया।<verse eid="ACT 7:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54"/>जब उन्होंने ये बातें सुनीं तो जी में जल गए, और उस पर दाँत पीसने लगे। <verse eid="ACT 7:54"/><verse number="55" style="v" sid="ACT 7:55"/>मगर उस ने रूह — उल — क़ुद्दूस से भरपूर होकर आसमान की तरफ़ ग़ौर से नज़र की, और ख़ुदा का जलाल और ईसा को ख़ुदा की दहनी तरफ़ खड़ा देख कर कहा। <verse eid="ACT 7:55"/><verse number="56" style="v" sid="ACT 7:56"/>“देखो मैं आसमान को खुला, और इबने — आदम को ख़ुदा की दहनी तरफ़ खड़ा देखता हूँ”<verse eid="ACT 7:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57"/>मगर उन्होंने बड़े ज़ोर से चिल्लाकर अपने कान बन्द कर लिए, और एक दिल होकर उस पर झपटे। <verse eid="ACT 7:57"/><verse number="58" style="v" sid="ACT 7:58"/>और शहर से बाहर निकाल कर उस पर पथराव करने लगे, और गवाहों ने अपने कपड़े साऊल नाम एक जवान के पाँव के पास रख दिए।<verse eid="ACT 7:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59"/>पस स्तिफ़नुस पर पथराव करते रहे, और वो ये कह कर दुआ करता रहा “ऐ ख़ुदावन्द ईसा मेरी रूह को क़ुबूल कर।” <verse eid="ACT 7:59"/><verse number="60" style="v" sid="ACT 7:60"/>फिर उस ने घुटने टेक कर बड़ी आवाज़ से पुकारा, “ऐ ख़ुदावन्द ये गुनाह इन के ज़िम्मे न लगा।” और ये कह कर सो गया।<verse eid="ACT 7:60"/></para>
  <chapter eid="ACT 7"/>
  <chapter number="8" style="c" sid="ACT 8"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1"/>और साऊल उस के क़त्ल में शामिल था। उसी दिन उस कलीसिया पर जो येरूशलेम में थी, बड़ा ज़ुल्म बर्पा हुआ,</para>
  <para style="s" vid="ACT 8:1">ज़ुलमों से मोमीनों के का बिखर जाना</para>
  <para style="p" vid="ACT 8:1">और रसूलों के सिवा सब लोग यहूदिया और सामरिया के चारों तरफ़ फैल गए। <verse eid="ACT 8:1"/><verse number="2" style="v" sid="ACT 8:2"/>और दीनदार लोग स्तिफ़नुस को दफ़्न करने कि लिए ले गए, और उस पर बड़ा मातम किया। <verse eid="ACT 8:2"/><verse number="3" style="v" sid="ACT 8:3"/>और साऊल कलीसिया को इस तरह तबाह करता रहा, कि घर घर घुसकर और ईमानदार मर्दों और औरतों को घसीट कर क़ैद करता था,<verse eid="ACT 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4"/>जो इधर उधर हो गए थे, वो कलाम की ख़ुशख़बरी देते फिरे। <verse eid="ACT 8:4"/><verse number="5" style="v" sid="ACT 8:5"/>और फ़िलिप्पुस सूब — ए सामरिया में जाकर लोगों में मसीह का ऐलान करने लगा।<verse eid="ACT 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 8:6"/>और जो मोजिज़े फ़िलिप्पुस दिखाता था, लोगों ने उन्हें सुनकर और देख कर बिल — इत्तफ़ाक़ उसकी बातों पर जी लगाया। <verse eid="ACT 8:6"/><verse number="7" style="v" sid="ACT 8:7"/>क्यूँकि बहुत सारे लोगों में से बदरूहें बड़ी आवाज़ से चिल्ला चिल्लाकर निकल गईं, और बहुत से मफ़्लूज और लंगड़े अच्छे किए गए। <verse eid="ACT 8:7"/><verse number="8" style="v" sid="ACT 8:8"/>और उस शहर में बड़ी ख़ुशी हुई।<verse eid="ACT 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9"/>उस से पहले शामा'ऊन नाम का एक शख़्स उस शहर में जादूगरी करता था, और सामरिया के लोगों को हैरान रखता और ये कहता था, कि मैं भी कोई बड़ा शख़्स हूँ। <verse eid="ACT 8:9"/><verse number="10" style="v" sid="ACT 8:10"/>और छोटे से बड़े तक सब उसकी तरफ़ मुतवज्जह होते और कहते थे, ये शख़्स ख़ुदा की वो क़ुदरत है, जिसे बड़ी कहते हैं। <verse eid="ACT 8:10"/><verse number="11" style="v" sid="ACT 8:11"/>वह इस लिए उस की तरफ़ मुतवज्जह होते थे, कि उस ने बड़ी मुद्दत से अपने जादू की वजह से उनको हैरान कर रखा था,<verse eid="ACT 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 8:12"/>लेकिन जब उन्होंने फ़िलिप्पुस का यक़ीन किया जो ख़ुदा की बादशाही और ईसा मसीह के नाम की ख़ुशख़बरी देता था, तो सब लोग चाहे मर्द हो चाहे औरत बपतिस्मा लेने लगे। <verse eid="ACT 8:12"/><verse number="13" style="v" sid="ACT 8:13"/>और शामा'ऊन ने ख़ुद भी यक़ीन किया और बपतिस्मा लेकर फ़िलिप्पुस के साथ रहा, और निशान और मोजिज़े देखकर हैरान हुआ।<verse eid="ACT 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14"/>जब रसूलों ने जो येरूशलेम में थे सुना, कि सामरियों ने ख़ुदा का कलाम क़ुबूल कर लिया है, तो पतरस और यूहन्ना को उन के पास भेजा। <verse eid="ACT 8:14"/><verse number="15" style="v" sid="ACT 8:15"/>उन्हों ने जाकर उनके लिए दुआ की कि रूह — उल — क़ुद्दूस पाएँ। <verse eid="ACT 8:15"/><verse number="16" style="v" sid="ACT 8:16"/>क्यूँकि वो उस वक़्त तक उन में से किसी पर नाज़िल ना हुआ था, उन्होंने सिर्फ़ ख़ुदावन्द ईसा के नाम पर बपतिस्मा लिया था। <verse eid="ACT 8:16"/><verse number="17" style="v" sid="ACT 8:17"/>फिर उन्होंने उन पर हाथ रख्खे, और उन्होंने रूह — उल — क़ुद्दूस पाया।<verse eid="ACT 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18"/>जब शामा'ऊन ने देखा कि रसूलों के हाथ रखने से रूह — उल — क़ुद्दूस दिया जाता है, तो उनके पास रुपऐ लाकर कहा, <verse eid="ACT 8:18"/><verse number="19" style="v" sid="ACT 8:19"/>“मुझे भी यह इख़्तियार दो, कि जिस पर मैं हाथ रख्खूँ, वो रूह — उल — क़ुद्दूस पाए।”<verse eid="ACT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20"/>पतरस ने उस से कहा, तेरे रुपऐ तेरे साथ ख़त्म हो, इस लिए कि तू ने ख़ुदा की बख़्शिश को रुपऐऊँ से हासिल करने का ख़याल किया। <verse eid="ACT 8:20"/><verse number="21" style="v" sid="ACT 8:21"/>तेरा इस काम में न हिस्सा है न बख़रा क्यूँकि तेरा दिल ख़ुदा के नज़दीक ख़ालिस नहीं। <verse eid="ACT 8:21"/><verse number="22" style="v" sid="ACT 8:22"/>पस अपनी इस बुराई से तौबा कर और ख़ुदा से दुआ कर शायद तेरे दिल के इस ख़याल की मु'आफ़ी हो।<verse eid="ACT 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 8:23"/>क्यूँकि मैं देखता हूँ कि तू पित की सी कड़वाहट और नारास्ती के बन्द में गिरफ़्तार है। <verse eid="ACT 8:23"/><verse number="24" style="v" sid="ACT 8:24"/>शमौन ने जवाब में कहा, तुम मेरे लिए ख़ुदावन्द से दुआ करो कि जो बातें तुम ने कही उन में से कोई मुझे पेश ना आए।<verse eid="ACT 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25"/>फिर वो गवाही देकर और ख़ुदावन्द का कलाम सुना कर येरूशलेम को वापस हुए, और सामरियों के बहुत से गाँव में ख़ुशख़बरी देते गए।<verse eid="ACT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26"/>फिर ख़ुदावन्द के फ़रिश्ते ने फ़िलिप्पुस से कहा, उठ कर दक्खिन की तरफ़ उस राह तक जा जो येरूशलेम से ग़ज़्ज़ा शहर को जाती है, और जंगल में है, <verse eid="ACT 8:26"/><verse number="27" style="v" sid="ACT 8:27"/>वो उठ कर रवाना हुआ, तो देखो एक हब्शी ख़ोजा आ रहा था, वो हब्शियों की मलिका कन्दाके का एक वज़ीर और उसके सारे ख़ज़ाने का मुख़्तार था, और येरूशलेम में इबादत के लिए आया था।<verse eid="ACT 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 8:28"/>वो अपने रथ पर बैठा हुआ और यसा'याह नबी के सहीफ़े को पढ़ता हुआ वापस जा रहा था। <verse eid="ACT 8:28"/><verse number="29" style="v" sid="ACT 8:29"/>पाक रूह ने फ़िलिप्पुस से कहा, नज़दीक जाकर उस रथ के साथ होले। <verse eid="ACT 8:29"/><verse number="30" style="v" sid="ACT 8:30"/>पस फ़िलिप्पुस ने उस तरफ़ दौड़ कर उसे यसा'याह नबी का सहीफ़ा पढ़ते सुना और कहा, “जो तू पढ़ता है उसे समझता भी है?” <verse eid="ACT 8:30"/><verse number="31" style="v" sid="ACT 8:31"/>ये मुझ से क्यूँ कर हो सकता है जब तक कोई मुझे हिदायत ना करे? और उसने फ़िलिप्पुस से दरख़्वास्त की कि मेरे साथ आ बैठ।<verse eid="ACT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 8:32"/>किताब — ए — मुक़द्दस की जो इबारत वो पढ़ रहा था, ये थी:</para>
  <para style="q" vid="ACT 8:32">“लोग उसे भेड़ की तरह ज़बह करने को ले गए,</para>
  <para style="q" vid="ACT 8:32">और जिस तरह बर्रा अपने बाल कतरने वाले के सामने बे — ज़बान होता है।”</para>
  <para style="q" vid="ACT 8:32">उसी तरह वो अपना मुँह नहीं खोलता।<verse eid="ACT 8:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="ACT 8:33"/>उसकी पस्तहाली में उसका इन्साफ़ न हुआ,</para>
  <para style="q" vid="ACT 8:33">और कौन उसकी नस्ल का हाल बयान करेगा?</para>
  <para style="q" vid="ACT 8:33">क्यूँकि ज़मीन पर से उसकी ज़िन्दगी मिटाई जाती है।<verse eid="ACT 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34"/>ख़ोजे ने फ़िलिप्पुस से कहा, “मैं तेरी मिन्नत करके पुछता हूँ, कि नबी ये किस के हक़ में कहता है, अपने या किसी दूसरे के हक़ में?” <verse eid="ACT 8:34"/><verse number="35" style="v" sid="ACT 8:35"/>फ़िलिप्पुस ने अपनी ज़बान खोलकर उसी लिखे हुए से शुरू किया और उसे ईसा की ख़ुशख़बरी दी।<verse eid="ACT 8:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36"/>और राह में चलते चलते किसी पानी की जगह पर पहूँचे; ख़ोजे ने कहा, “देख पानी मौजूद है अब मुझे बपतिस्मा लेने से कौन सी चीज़ रोकती है?” <verse eid="ACT 8:36"/><verse number="37" style="v" sid="ACT 8:37"/>फ़िलिप्पुस ने कहा, अगर तू दिल ओ — जान से ईमान लाए तो बपतिस्मा ले सकता है। उसने जवाब में कहा, में ईमान लाता हूँ कि ईसा मसीह ख़ुदा का बेटा है। <verse eid="ACT 8:37"/><verse number="38" style="v" sid="ACT 8:38"/>पस उसने रथ को खड़ा करने का हुक्म दिया और फ़िलिप्पुस और ख़ोजा दोनों पानी में उतर पड़े और उसने उसको बपतिस्मा दिया।<verse eid="ACT 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 8:39"/>जब वो पानी में से निकल कर उपर आए तो ख़ुदावन्द का रूह फ़िलिप्पुस को उठा ले गया और ख़ोजा ने उसे फिर न देखा, क्यूँकि वो ख़ुशी करता हुआ अपनी राह चला गया। <verse eid="ACT 8:39"/><verse number="40" style="v" sid="ACT 8:40"/>और फ़िलिप्पुस अश्दूद क़स्बा में आ निकला और क़ैसरिया शहर में पहुँचने तक सब शहरों में ख़ुशख़बरी सुनाता गया।<verse eid="ACT 8:40"/></para>
  <chapter eid="ACT 8"/>
  <chapter number="9" style="c" sid="ACT 9"/>
  <para style="s">साऊल का मसीही बनना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1"/>और साऊल जो अभी तक ख़ुदावन्द के शागिर्दों को धमकाने और क़त्ल करने की धुन में था। सरदार काहिन के पास गया। <verse eid="ACT 9:1"/><verse number="2" style="v" sid="ACT 9:2"/>और उस से दमिश्क़ के इबादतख़ानों के लिए इस मज़्मून के ख़त माँगे कि जिनको वो इस तरीक़े पर पाए, मर्द चाहे औरत, उनको बाँधकर येरूशलेम में लाए।<verse eid="ACT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3"/>जब वो सफ़र करते करते दमिश्क़ के नज़दीक पहुँचा तो ऐसा हुआ कि यकायक आसमान से एक नूर उसके पास आ, चमका। <verse eid="ACT 9:3"/><verse number="4" style="v" sid="ACT 9:4"/>और वो ज़मीन पर गिर पड़ा और ये आवाज़ सुनी <char style="wj">“ऐ साऊल, ऐ साऊल, तू मुझे क्यूँ सताता है?”</char><verse eid="ACT 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5"/>उस ने पूछा, “ऐ ख़ुदावन्द, तू कौन हैं?” उस ने कहा,, <char style="wj">“मैं ईसा हूँ जिसे तू सताता है।</char> <verse eid="ACT 9:5"/><verse number="6" style="v" sid="ACT 9:6"/><char style="wj">मगर उठ शहर में जा, और जो तुझे करना चाहिए वो तुझसे कहा जाएगा।”</char> <verse eid="ACT 9:6"/><verse number="7" style="v" sid="ACT 9:7"/>जो आदमी उसके हमराह थे, वो ख़ामोश खड़े रह गए, क्यूँकि आवाज़ तो सुनते थे, मगर किसी को देखते न थे।<verse eid="ACT 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 9:8"/>और साऊल ज़मीन पर से उठा, लेकिन जब आँखें खोलीं तो उसको कुछ दिखाई न दिया, और लोग उसका हाथ पकड़ कर दमिश्क़ शहर में ले गए। <verse eid="ACT 9:8"/><verse number="9" style="v" sid="ACT 9:9"/>और वो तीन दिन तक न देख सका, और न उसने खाया न पिया।<verse eid="ACT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10"/>दमिश्क़ में हननियाह नाम एक शागिर्द था, उस से ख़ुदावन्द ने रोया में कहा, <char style="wj">“ऐ हननियाह”</char> उस ने कहा, “ऐ ख़ुदावन्द, मैं हाज़िर हूँ।” <verse eid="ACT 9:10"/><verse number="11" style="v" sid="ACT 9:11"/>ख़ुदावन्द ने उस से कहा, <char style="wj">“उठ, उस गली में जा जो सीधा' कहलाता है। और यहूदाह के घर में साऊल नाम तर्सुसी शहरी को पूछ ले क्यूँकि देख वो दुआ कर रहा है।</char> <verse eid="ACT 9:11"/><verse number="12" style="v" sid="ACT 9:12"/><char style="wj">और उस ने हननियाह नाम एक आदमी को अन्दर आते और अपने ऊपर हाथ रखते देखा है, ताकि फिर बीना हो।”</char><verse eid="ACT 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13"/>हननियाह ने जावाब दिया कि ऐ ख़ुदावन्द, मैं ने बहुत से लोगों से इस शख़्स का ज़िक्र सुना है, कि इस ने येरूशलेम में तेरे मुक़द्दसों के साथ कैसी कैसी बुराइयां की हैं। <verse eid="ACT 9:13"/><verse number="14" style="v" sid="ACT 9:14"/>और यहाँ उसको सरदार काहिनों की तरफ़ से इख़्तियार मिला है, कि जो लोग तेरा नाम लेते हैं, उन सब को बाँध ले। <verse eid="ACT 9:14"/><verse number="15" style="v" sid="ACT 9:15"/>मगर ख़ुदावन्द ने उस से कहा कि <char style="wj">“तू जा, क्यूँकि ये क़ौमों, बादशाहों और बनी इस्राईल पर मेरा नाम ज़ाहिर करने का मेरा चुना हुआ वसीला है।</char> <verse eid="ACT 9:15"/><verse number="16" style="v" sid="ACT 9:16"/><char style="wj">और में उसे जता दूँगा कि उसे मेरे नाम के ख़ातिर किस क़दर दुःख उठाना पड़ेगा”</char><verse eid="ACT 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17"/>पस हननियाह जाकर उस घर में दाख़िल हुआ और अपने हाथ उस पर रखकर कहा, “ऐ भाई शाऊल उस ख़ुदावन्द या'नी ईसा जो तुझ पर उस राह में जिस से तू आया ज़ाहिर हुआ था, उसने मुझे भेजा है, कि तू बीनाई पाए, और रूहे पाक से भर जाए।” <verse eid="ACT 9:17"/><verse number="18" style="v" sid="ACT 9:18"/>और फ़ौरन उसकी आँखों से छिल्के से गिरे और वो बीना हो गया, और उठ कर बपतिस्मा लिया। <verse eid="ACT 9:18"/><verse number="19" style="v" sid="ACT 9:19"/>फिर कुछ खाकर ताक़त पाई,</para>
  <para style="p" vid="ACT 9:19">और वो कई दिन उन शागिर्दों के साथ रहा, जो दमिश्क़ में थे।<verse eid="ACT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20"/>और फ़ौरन इबादतख़ानों में ईसा का ऐलान करने लगा, कि वो ख़ुदा का बेटा है। <verse eid="ACT 9:20"/><verse number="21" style="v" sid="ACT 9:21"/>और सब सुनने वाले हैरान होकर कहने लगे कि “क्या ये वो शख़्स नहीं है, जो येरूशलेम में इस नाम के लेने वालों को तबाह करता था, और यहाँ भी इस लिए आया था, कि उनको बाँध कर सरदार काहिनों के पास ले जाए?” <verse eid="ACT 9:21"/><verse number="22" style="v" sid="ACT 9:22"/>लेकिन साऊल को और भी ताक़त हासिल होती गई, और वो इस बात को साबित करके कि मसीह यही है दमिश्क़ के रहने वाले यहूदियों को हैरत दिलाता रहा।<verse eid="ACT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23"/>और जब बहुत दिन गुज़र गए, तो यहूदियों ने उसे मार डालने का मशवरा किया। <verse eid="ACT 9:23"/><verse number="24" style="v" sid="ACT 9:24"/>मगर उनकी साज़िश साऊल को मालूम हो गई, वो तो उसे मार डालने के लिए रात दिन दरवाज़ों पर लगे रहे। <verse eid="ACT 9:24"/><verse number="25" style="v" sid="ACT 9:25"/>लेकिन रात को उसके शागिर्दों ने उसे लेकर टोकरे में बिठाया और दीवार पर से लटका कर उतार दिया।<verse eid="ACT 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26"/>उस ने येरूशलेम में पहुँच कर शागिर्दों में मिल जाने की कोशिश की और सब उस से डरते थे, क्यूँकि उनको यक़ीन न आता था, कि ये शागिर्द है। <verse eid="ACT 9:26"/><verse number="27" style="v" sid="ACT 9:27"/>मगर बरनबास ने उसे अपने साथ रसूलों के पास ले जाकर उन से बयान किया कि इस ने इस तरह राह में ख़ुदावन्द को देखा और उसने इस से बातें की और उस ने दमिश्क़ में कैसी दिलेरी के साथ ईसा के नाम से एलान किया।<verse eid="ACT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 9:28"/>पस वो येरूशलेम में उनके साथ जाता रहा। <verse eid="ACT 9:28"/><verse number="29" style="v" sid="ACT 9:29"/>और दिलेरी के साथ ख़ुदावन्द के नाम का ऐलान करता था, और यूनानी माइल यहूदियों के साथ गुफ़्तगू और बहस भी करता था, मगर वो उसे मार डालने के दर पै थे। <verse eid="ACT 9:29"/><verse number="30" style="v" sid="ACT 9:30"/>और भाइयों को जब ये मा'लूम हुआ, तो उसे क़ैसरिया में ले गए, और तरसुस को रवाना कर दिया।<verse eid="ACT 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31"/>पस तमाम यहूदिया और गलील और सामरिया में कलीसिया को चैन हो गया और उसकी तरक़्क़ी होती गई और वो दावन्द के ख़ौफ़ और रूह — उल — क़ुद्दूस की तसल्ली पर चलती और बढ़ती जाती थी।<verse eid="ACT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32"/>और ऐसा हुआ कि पतरस हर जगह फिरता हुआ उन मुक़द्दसों के पास भी पहुँचा जो लुद्दा में रहते थे।<verse eid="ACT 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 9:33"/>वहाँ ऐनियास नाम एक मफ़्लूज को पाया जो आठ बरस से चारपाई पर पड़ा था। <verse eid="ACT 9:33"/><verse number="34" style="v" sid="ACT 9:34"/>पतरस ने उस से कहा, ऐ ऐनियास, ईसा मसीह तुझे शिफ़ा देता है। उठ आप अपना बिस्तरा बिछा। वो फ़ौरन उठ खड़ा हुआ। <verse eid="ACT 9:34"/><verse number="35" style="v" sid="ACT 9:35"/>तब लुद्दा और शारून के सब रहने वाले उसे देखकर ख़ुदावन्द की तरफ़ रुजू लाए।<verse eid="ACT 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36"/>और याफ़ा शहर में एक शागिर्द थी, तबीता नाम जिसका तर्जुमा हरनी है, वो बहुत ही नेक काम और ख़ैरात किया करती थी। <verse eid="ACT 9:36"/><verse number="37" style="v" sid="ACT 9:37"/>उन्हीं दिनों में ऐसा हुआ कि वो बीमार होकर मर गई, और उसे नहलाकर बालाख़ाने में रख दिया।<verse eid="ACT 9:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 9:38"/>और चूँकि लुद्दा याफ़ा के नज़दीक था, शागिर्दों ने ये सुन कर कि पतरस वहाँ है दो आदमी भेजे और उस से दरख़्वास्त की कि हमारे पास आने में देर न कर। <verse eid="ACT 9:38"/><verse number="39" style="v" sid="ACT 9:39"/>पतरस उठकर उनके साथ हो लिया, जब पहुँचा तो उसे बालाख़ाने में ले गए, और सब बेवाएँ रोती हुई उसके पास आ खड़ी हुईं और जो कुरते और कपड़े हरनी ने उनके साथ में रह कर बनाए थे, दिखाने लगीं।<verse eid="ACT 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 9:40"/>पतरस ने सब को बाहर कर दिया और घुटने टेक कर दुआ की, फिर लाश की तरफ़ मुतवज्जह होकर कहा, ऐ तबीता उठ पस उसने आँखें खोल दीं और पतरस को देखकर उठ बैठी। <verse eid="ACT 9:40"/><verse number="41" style="v" sid="ACT 9:41"/>उस ने हाथ पकड़ कर उसे उठाया और मुक़द्दसों और बेवाओं को बुला कर उसे ज़िन्दा उनके सुपुर्द किया। <verse eid="ACT 9:41"/><verse number="42" style="v" sid="ACT 9:42"/>ये बात सारे याफ़ा में मशहूर हो गई, और बहुत सारे ख़ुदावन्द पर ईमान ले आए। <verse eid="ACT 9:42"/><verse number="43" style="v" sid="ACT 9:43"/>और ऐसा हुआ कि वो बहुत दिन याफ़ा में शमौन नाम दब्बाग़ के यहाँ रहा।<verse eid="ACT 9:43"/></para>
  <chapter eid="ACT 9"/>
  <chapter number="10" style="c" sid="ACT 10"/>
  <para style="s">कुरनेलियुस का पतरस को बुलाना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1"/>क़ैसरिया शहर में कुर्नेलियुस नाम एक शख़्स था। वह सौ फ़ौजियोंका सूबेदार था, जो अतालियानी कहलाती है। <verse eid="ACT 10:1"/><verse number="2" style="v" sid="ACT 10:2"/>वो दीनदार था, और अपने सारे घराने समेत ख़ुदा से डरता था, और यहूदियों को बहुत ख़ैरात देता और हर वक़्त ख़ुदा से दुआ करता था<verse eid="ACT 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 10:3"/>उस ने तीसरे पहर के क़रीब रोया में साफ़ साफ़ देखा कि ख़ुदा का फ़रिश्ता मेरे पास आकर कहता है, “कुर्नेलियुस!” <verse eid="ACT 10:3"/><verse number="4" style="v" sid="ACT 10:4"/>उसने उस को ग़ौर से देखा और डर कर कहा ख़ुदावन्द क्या है? उस ने उस से कहा, तेरी दु'आएँ और तेरी ख़ैरात यादगारी के लिए ख़ुदा के हुज़ूर पहुँची। <verse eid="ACT 10:4"/><verse number="5" style="v" sid="ACT 10:5"/>अब याफ़ा में आदमी भेजकर शमौन को जो पतरस कहलाता है, बुलवा ले। <verse eid="ACT 10:5"/><verse number="6" style="v" sid="ACT 10:6"/>वो शमौन दब्बाग़ के यहाँ मेहमान है, जिसका घर समुन्दर के किनारे है।<verse eid="ACT 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7"/>और जब वो फ़रिश्ता चला गया जिस ने उस से बातें की थी, तो उस ने दो नौकरों को और उन में से जो उसके पास हाज़िर रहा करते थे, एक दीनदार सिपाही को बुलाया। <verse eid="ACT 10:7"/><verse number="8" style="v" sid="ACT 10:8"/>और सब बातें उन से बयान कर के उन्हें याफ़ा में भेजा।<verse eid="ACT 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9"/>दूसरे दिन जब वो राह में थे, और शहर के नज़दीक पहुँचे तो पतरस दोपहर के क़रीब छत पर दुआ करने को चढ़ा। <verse eid="ACT 10:9"/><verse number="10" style="v" sid="ACT 10:10"/>और उसे भूख लगी, और कुछ खाना चहता था, लेकिन जब लोग तैयारी कर रहे थे, तो उस पर बेख़ुदी छा गई। <verse eid="ACT 10:10"/><verse number="11" style="v" sid="ACT 10:11"/>और उस ने देखा कि आस्मान खुल गया और एक चीज़ बड़ी चादर की तरह चारों कोनों से लटकती हुई ज़मीन की तरफ़ उतर रही है। <verse eid="ACT 10:11"/><verse number="12" style="v" sid="ACT 10:12"/>जिसमें ज़मीन के सब क़िस्म के चौपाए, कीड़े मकोड़े और हवा के परिन्दे हैं।<verse eid="ACT 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 10:13"/>और उसे एक आवाज़ आई कि ऐ पतरस, <char style="wj">“उठ ज़बह कर और खा,”</char> <verse eid="ACT 10:13"/><verse number="14" style="v" sid="ACT 10:14"/>मगर पतरस ने कहा, “ऐ ख़ुदावन्द हरगिज़ नहीं क्यूँकि में ने कभी कोई हराम या नापाक चीज़ नहीं खाई।” <verse eid="ACT 10:14"/><verse number="15" style="v" sid="ACT 10:15"/>फिर दूसरी बार उसे आवाज़ आई, कि <char style="wj">“जिनको ख़ुदा ने पाक ठहराया है तू उन्हें हराम न कह”</char> <verse eid="ACT 10:15"/><verse number="16" style="v" sid="ACT 10:16"/>तीन बार ऐसा ही हुआ, और फ़ौरन वो चीज़ आसमान पर उठा ली गई।<verse eid="ACT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17"/>जब पतरस अपने दिल में हैरान हो रहा था, कि ये रोया जो में ने देखी क्या है, तो देखो वो आदमी जिन्हें कुर्नेलियुस ने भेजा था, शमौन के घर पूछ कर के दरवाज़े पर आ खड़े हुए। <verse eid="ACT 10:17"/><verse number="18" style="v" sid="ACT 10:18"/>और पुकार कर पूछने लगे कि शमौन जो पतरस कहलाता है? “यही मेहमान है।”<verse eid="ACT 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19"/>जब पतरस उस ख़्वाब को सोच रहा था, तो रूह ने उस से कहा देख तीन आदमी तुझे पूछ रहे हैं। <verse eid="ACT 10:19"/><verse number="20" style="v" sid="ACT 10:20"/>पस, उठ कर नीचे जा और बे — खटके उनके साथ हो ले; क्यूँकि मैं ने ही उनको भेजा है। <verse eid="ACT 10:20"/><verse number="21" style="v" sid="ACT 10:21"/>पतरस ने उतर कर उन आदमियों से कहा, “देखो जिसको तुम पूछते हो वो मैं ही हूँ तुम किस वजह से आये हो।”<verse eid="ACT 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22"/>उन्होंने कहा, “कुर्नेलियुस सूबेदार जो रास्तबाज़ और ख़ुदा तरस आदमी और यहूदियों की सारी क़ौम में नेक नाम है उस ने पाक फ़रिश्ते से हिदायत पाई कि तुझे अपने घर बुलाकर तुझ से कलाम सुने।” <verse eid="ACT 10:22"/><verse number="23" style="v" sid="ACT 10:23"/>पस उस ने उन्हें अन्दर बुला कर उनकी मेहमानी की, और दूसरे दिन वो उठ कर उनके साथ रवाना हुआ,</para>
  <para style="p" vid="ACT 10:23">और याफ़ा में से कुछ भाई उसके साथ हो लिए।<verse eid="ACT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24"/>वो दूसरे रोज़ क़ैसरिया में दाख़िल हुए, और कुर्नेलियुस अपने रिश्तेदारों और दिली दोस्तों को जमा कर के उनकी राह देख रहा था।<verse eid="ACT 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 10:25"/>जब पतरस अन्दर आने लगा तो ऐसा हुआ कि कुर्नेलियुस ने उसका इस्तक़बाल किया और उसके क़दमों में गिर कर सिज्दा किया। <verse eid="ACT 10:25"/><verse number="26" style="v" sid="ACT 10:26"/>लेकिन पतरस ने उसे उठा कर कहा, “खड़ा हो, मैं भी तो इंसान हूँ।”<verse eid="ACT 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27"/>और उससे बातें करता हुआ अन्दर गया और बहुत से लोगों को इकट्ठा पा कर। <verse eid="ACT 10:27"/><verse number="28" style="v" sid="ACT 10:28"/>उनसे कहा तुम तो जानते हो कि यहूदी को ग़ैर क़ौम वाले से सोहबत रखना या उसके यहाँ जाना ना जायज़ है मगर ख़ुदा ने मुझ पर ज़ाहिर किया कि मैं किसी आदमी को नजिस या नापाक न कहूँ। <verse eid="ACT 10:28"/><verse number="29" style="v" sid="ACT 10:29"/>इसी लिए जब मैं बुलाया गया तो बे' उज़्र चला आया, पस अब मैं पूछता हूँ कि मुझे किस बात के लिए बुलाया है?<verse eid="ACT 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30"/>कुर्नेलियुस ने कहा “इस वक़्त पूरे चार रोज़ हुए कि मैं अपने घर तीसरे पहर दुआ कर रहा था। और क्या देखता हूँ। कि एक शख़्स चमकदार पोशाक पहने हुए मेरे सामने खड़ा हुआ।” <verse eid="ACT 10:30"/><verse number="31" style="v" sid="ACT 10:31"/>और कहा कि ऐ'कुर्नेलियुस तेरी दुआ सुन ली गई और तेरी ख़ैरात की ख़ुदा के हुज़ूर याद हुई। <verse eid="ACT 10:31"/><verse number="32" style="v" sid="ACT 10:32"/>पस किसी को याफ़ा में भेज कर शमौन को जो पतरस कहलाता है अपने पास बुला, वो समुन्दर के किनारे शमौन दब्बाग़ के घर में मेहमान है। <verse eid="ACT 10:32"/><verse number="33" style="v" sid="ACT 10:33"/>पस उसी दम में ने तेरे पास आदमी भेजे और तूने ख़ूब किया जो आ गया, अब हम सब ख़ुदा के हुज़ूर हाज़िर हैं ताकि जो कुछ ख़ुदावन्द ने फ़रमाया है उसे सुनें।<verse eid="ACT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34"/>पतरस ने ज़बान खोल कर कहा,</para>
  <para style="p" vid="ACT 10:34">अब मुझे पूरा यक़ीन हो गया कि ख़ुदा किसी का तरफ़दार नहीं। <verse eid="ACT 10:34"/><verse number="35" style="v" sid="ACT 10:35"/>बल्कि हर क़ौम में जो उस से डरता और रास्तबाज़ी करता है, वो उसको पसन्द आता है।<verse eid="ACT 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 10:36"/>जो कलाम उस ने बनी इस्राईल के पास भेजा, जब कि ईसा मसीह के ज़रिए जो सब का ख़ुदा है, सुलह की ख़ुशख़बरी दी। <verse eid="ACT 10:36"/><verse number="37" style="v" sid="ACT 10:37"/>इस बात को तुम जानते हो जो यूहन्ना के बपतिस्मे की मनादी के बाद गलील से शुरू होकर तमाम यहूदिया सूबा में मशहूर हो गई। <verse eid="ACT 10:37"/><verse number="38" style="v" sid="ACT 10:38"/>कि ख़ुदा ने ईसा नासरी को रूह — उल — क़ुद्दूस और क़ुदरत से किस तरह मसह किया, वो भलाई करता और उन सब को जो इब्लीस के हाथ से ज़ुल्म उठाते थे शिफ़ा देता फिरा, क्यूँकि ख़ुदा उसके साथ था।<verse eid="ACT 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39"/>और हम उन सब कामों के गवाह हैं, जो उस ने यहूदियों के मुल्क और येरूशलेम में किए, और उन्हों ने उस को सलीब पर लटका कर मार डाला। <verse eid="ACT 10:39"/><verse number="40" style="v" sid="ACT 10:40"/>उस को ख़ुदा ने तीसरे दिन जिलाया और ज़ाहिर भी कर दिया। <verse eid="ACT 10:40"/><verse number="41" style="v" sid="ACT 10:41"/>न कि सारी उम्मत पर बल्कि उन गवाहों पर जो आगे से ख़ुदा के चुने हुए थे, या'नी हम पर जिन्हों ने उसके मुर्दों में से जी उठने कि बाद उसके साथ खाया पिया।<verse eid="ACT 10:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 10:42"/>और उस ने हमें हुक्म दिया कि उम्मत में ऐलान करो और गवाही दो कि ये वही है जो ख़ुदा की तरफ़ से ज़िन्दों और मुर्दों का मुन्सिफ़ मुक़र्रर किया गया। <verse eid="ACT 10:42"/><verse number="43" style="v" sid="ACT 10:43"/>इस शख़्स की सब नबी गवाही देते हैं, कि जो कोई उस पर ईमान लाएगा, उस के नाम से गुनाहों की मु'आफ़ी हासिल करेगा।<verse eid="ACT 10:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44"/>पतरस ये बातें कह ही रहा था, कि रूह — उल — क़ुद्दूस उन सब पर नाज़िल हुआ, जो कलाम सुन रहे थे। <verse eid="ACT 10:44"/><verse number="45" style="v" sid="ACT 10:45"/>और पतरस के साथ जितने मख़्तून ईमानदार आए थे, वो सब हैरान हुए कि ग़ैर क़ौमों पर भी रूह — उल — क़ुद्दूस की बख़्शिश जारी हुई।<verse eid="ACT 10:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 10:46"/>क्यूँकि उन्हें तरह तरह की ज़बाने बोलते और ख़ुदा की तारीफ़ करते सुना; पतरस ने जवाब दिया। <verse eid="ACT 10:46"/><verse number="47" style="v" sid="ACT 10:47"/>“क्या कोई पानी से रोक सकता है, कि बपतिस्मा न पाएँ, जिन्हों ने हमारी तरह रूह — उल — क़ुद्दूस पाया?” <verse eid="ACT 10:47"/><verse number="48" style="v" sid="ACT 10:48"/>और उस ने हुक्म दिया कि उन्हें ईसा मसीह के नाम से बपतिस्मा दिया जाए इस पर उन्हों ने उस से दरख़्वास्त की कि चन्द रोज़ हमारे पास रह।<verse eid="ACT 10:48"/></para>
  <chapter eid="ACT 10"/>
  <chapter number="11" style="c" sid="ACT 11"/>
  <para style="s">पतरस का अपने कामों का बखान करना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1"/>रसूलों और भाइयों ने जो यहूदिया में थे, सुना कि ग़ैर क़ौमों ने भी ख़ुदा का कलाम क़ुबूल किया है। <verse eid="ACT 11:1"/><verse number="2" style="v" sid="ACT 11:2"/>जब पतरस येरूशलेम में आया तो मख़्तून ईमानदार उस से ये बहस करने लगे <verse eid="ACT 11:2"/><verse number="3" style="v" sid="ACT 11:3"/>“तू, ना मख़्तून ईमानदारों के पास गया और उन के साथ खाना खाया।”<verse eid="ACT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4"/>पतरस ने शुरू से वो काम तरतीबवार उन से बयान किया कि। <verse eid="ACT 11:4"/><verse number="5" style="v" sid="ACT 11:5"/>मै याफ़ा शहर में दुआ कर रहा था, और बेख़ुदी की हालत में एक ख़्वाब देखा। कि कोई चीज़ बड़ी चादर की तरह चारों कोनों से लटकती हुई आसमान से उतर कर मुझ तक आई। <verse eid="ACT 11:5"/><verse number="6" style="v" sid="ACT 11:6"/>उस पर जब मैने ग़ौर से नज़र की तो ज़मीन के चौपाए और जंगली जानवर और कीड़े मकोड़े और हवा के परिन्दे देखे।<verse eid="ACT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 11:7"/>और ये आवाज़ भी सुनी कि <char style="wj">“ऐ पतरस उठ ज़बह कर और खा!”</char> <verse eid="ACT 11:7"/><verse number="8" style="v" sid="ACT 11:8"/>लेकिन मै ने कहा “ऐ ख़ुदावन्द हरगिज़ नहीं 'क्यूँकि कभी कोई हराम या नापाक चीज़ खाया ही नहीं।” <verse eid="ACT 11:8"/><verse number="9" style="v" sid="ACT 11:9"/>इसके जावाब में दूसरी बार आसमान से आवाज़ आई; <char style="wj">“जिनको ख़ुदा ने पाक ठहराया है; तू उन्हें हराम न कह।”</char> <verse eid="ACT 11:9"/><verse number="10" style="v" sid="ACT 11:10"/>तीन बार ऐसा ही हुआ, फिर वो सब चीज़ें आसमान की तरफ़ खींच ली गई।<verse eid="ACT 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11"/>और देखो' उसी वक़्त तीन आदमी जो क़ैसरिया से मेरे पास भेजे गए थे, उस घर के पास आ खड़े हुए जिस में हम थे। <verse eid="ACT 11:11"/><verse number="12" style="v" sid="ACT 11:12"/>रूह ने मुझ से कहा कि तू बिला इम्तियाज़ उनके साथ चला जा और ये छे:भाई भी मेरे साथ हो लिए और हम उस शख़्स के घर में दाख़िल हुए। <verse eid="ACT 11:12"/><verse number="13" style="v" sid="ACT 11:13"/>उस ने हम से बयान किया कि मैने फ़रिश्ते को अपने घर में खड़े हुए देखा'जिसने मुझ से कहा, याफ़ा में आदमी भेजकर शमौन को बुलवा ले जो पतरस कहलाता है। <verse eid="ACT 11:13"/><verse number="14" style="v" sid="ACT 11:14"/>वो तुझ से ऐसी बातें कहेगा जिससे तू और तेरा सारा घराना नजात पाएगा।<verse eid="ACT 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15"/>जब मै कलाम करने लगा तो रूह — उल — क़ुद्दूस उन पर इस तरह नाज़िल हुआ जिस तरह शुरू में हम पर नाज़िल हुआ था। <verse eid="ACT 11:15"/><verse number="16" style="v" sid="ACT 11:16"/>और मुझे ख़ुदावन्द की वो बात याद आई, जो उसने कही थी <char style="wj">“यूहन्ना ने तो पानी से बपतिस्मा दिया मगर तुम रूह — उल — क़ुद्दूस से बपतिस्मा पाओगे।”</char><verse eid="ACT 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 11:17"/>पस जब ख़ुदा ने उस को भी वही ने'मत दी जो हम को ख़ुदावन्द ईसा मसीह पर ईमान लाकर मिली थी? तो मै कौन था कि ख़ुदा को रोक सकता। <verse eid="ACT 11:17"/><verse number="18" style="v" sid="ACT 11:18"/>वो ये सुनकर चुप रहे और ख़ुदा की बड़ाई करके कहने लगे, “फिर तो बेशक ख़ुदा ने ग़ैर क़ौमों को भी ज़िन्दगी के लिए तौबा की तौफ़ीक़ दी है।”<verse eid="ACT 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19"/>पस, जो लोग उस मुसीबत से इधर उधर हो गए थे जो स्तिफ़नुस कि ज़रिए पड़ी थी वो फिरते फिरते फ़ीनिके सूबा और कुप्रुस टापू और आन्ताकिया शहर में पहूँचे; मगर यहूदियों के सिवा और किसी को कलाम न सुनाते थे। <verse eid="ACT 11:19"/><verse number="20" style="v" sid="ACT 11:20"/>लेकिन उन में से चन्द कुप्रुसी और कुरेनी थे, जो आन्ताकिया में आकर यूनानियों को भी ख़ुदावन्द ईसा मसीह की ख़ुशख़बरी की बातें सुनाने लगे। <verse eid="ACT 11:20"/><verse number="21" style="v" sid="ACT 11:21"/>और ख़ुदावन्द का हाथ उन पर था और बहुत से लोग ईमान लाकर ख़ुदावन्द की तरफ़ रुजू हुए।<verse eid="ACT 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22"/>उन लोगों की ख़बर येरूशलेम की कलीसिया के कानों तक पहूँची और उन्हों ने बरनबास को आन्ताकिया तक भेजा। <verse eid="ACT 11:22"/><verse number="23" style="v" sid="ACT 11:23"/>वो पहूँचकर और ख़ुदा का फ़ज़ल देख कर ख़ुश हुआ, और उन सब को नसीहत की कि दिली इरादे से ख़ुदावन्द से लिपटे रहो। <verse eid="ACT 11:23"/><verse number="24" style="v" sid="ACT 11:24"/>क्यूँकि वो नेक मर्द और रूह — उल — क़ुद्दूस और ईमान से मा'मूर था, और बहुत से लोग ख़ुदावन्द की कलीसिया में आ मिले।<verse eid="ACT 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25"/>फिर वो साऊल की तलाश में तरसुस को चला गया। <verse eid="ACT 11:25"/><verse number="26" style="v" sid="ACT 11:26"/>और जब वो मिला तो उसे आन्ताकिया में लाया और ऐसा हुआ कि वो साल भर तक कलीसिया की जमा'अत में शामिल होते और बहुत से लोगों को ता'लीम देते रहे और शागिर्द पहले आन्ताकिया में ही मसीही कहलाए।<verse eid="ACT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27"/>उन ही दिनों में चन्द नबी येरूशलेम से आन्ताकिया में आए। <verse eid="ACT 11:27"/><verse number="28" style="v" sid="ACT 11:28"/>उन में से एक जिसका नाम अग्बुस था खड़े होकर रूह की हिदायत से ज़ाहिर किया कि तमाम दुनियाँ में बड़ा काल पड़ेगा और क्लोदियुस के अहद में वाक़े हुआ। <note caller="+" style="f"><char style="fr" closed="false">11:28 </char><char style="ft" closed="false">ये वाकया मसीह की सलीबी मौत के 41 से 54 में हुआ </char></note><verse eid="ACT 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 11:29"/>पस, शागिर्दों ने तजवीज़ की अपने अपने हैसियत कि मुवाफ़िक़ यहूदिया में रहने वाले भाइयों की ख़िदमत के लिए कुछ भेजें। <verse eid="ACT 11:29"/><verse number="30" style="v" sid="ACT 11:30"/>चुनाँचे उन्होंने ऐसा ही किया और बरनबास और साऊल के हाथ बुज़ुर्गों के पास भेजा।<verse eid="ACT 11:30"/></para>
  <chapter eid="ACT 11"/>
  <chapter number="12" style="c" sid="ACT 12"/>
  <para style="s">याकूब का मारा जाना और पतरस को कैद करना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1"/>तक़रीबन उसी वक़्त हेरोदेस बादशाह ने सताने के लिए कलीसिया में से कुछ पर हाथ डाला<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">बादशाह हेरोद बादशाह अग्रिपा जो बड़ा हेरोद का पहला पोता था </char></note>। <verse eid="ACT 12:1"/><verse number="2" style="v" sid="ACT 12:2"/>और यूहन्ना के भाई या'क़ूब को तलवार से क़त्ल किया।<verse eid="ACT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 12:3"/>जब देखा कि ये बात यहूदी अगुवों को पसन्द आई, तो पतरस को भी गिरफ़्तार कर लिया। ये ईद 'ए फ़तीर के दिन थे। <verse eid="ACT 12:3"/><verse number="4" style="v" sid="ACT 12:4"/>और उसको पकड़ कर क़ैद किया और निगहबानी के लिए चार चार सिपाहियों के चार पहरों में रखा इस इरादे से कि फ़सह के बाद उसको लोगों के सामने पेश करे।<verse eid="ACT 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 12:5"/>पस, क़ैद खाने में तो पतरस की निगहबानी हो रही थी, मगर कलीसिया उसके लिए दिलो' जान से ख़ुदा से दुआ कर रही थी। <verse eid="ACT 12:5"/><verse number="6" style="v" sid="ACT 12:6"/>और जब हेरोदेस उसे पेश करने को था, तो उसी रात पतरस दो ज़ंजीरों से बँधा हुआ दो सिपाहियों के बीच सोता था, और पहरे वाले दरवाज़े पर क़ैदख़ाने की निगहबानी कर रहे थे।<verse eid="ACT 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 12:7"/>कि देखो, ख़ुदावन्द का एक फ़रिश्ता खड़ा हुआ और उस कोठरी में नूर चमक गया और उस ने पतरस की पसली पर हाथ मार कर उसे जगाया और कहा कि जल्द उठ! और ज़ंजीरें उसके हाथ से खुल पड़ीं। <verse eid="ACT 12:7"/><verse number="8" style="v" sid="ACT 12:8"/>फिर फ़रिश्ते ने उस से कहा, “कमर बाँध और अपनी जूती पहन ले।” उस ने ऐसा ही किया, फिर उस ने उस से कहा, “अपना चोग़ा पहन कर मेरे पीछे हो ले।”<verse eid="ACT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 12:9"/>वो निकल कर उसके पीछे हो लिया, और ये न जाना कि जो कुछ फ़रिश्ते की तरफ़ से हो रहा है वो वाक़'ई है बल्कि ये समझा कि ख़्वाब देख रहा हूँ। <verse eid="ACT 12:9"/><verse number="10" style="v" sid="ACT 12:10"/>पस, वो पहले और दूसरे हल्क़े में से निकलकर उस लोहे के फाटक पर पहुँचे, जो शहर की तरफ़ है। वो आप ही उन के लिए खुल गया, पस वो निकलकर गली के उस किनारे तक गए; और फ़ौरन फ़रिश्ता उस के पास से चला गया।<verse eid="ACT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11"/>और पतरस ने होश में आकर कहा कि अब मैने सच जान लिया कि ख़ुदावन्द ने अपना फ़रिश्ता भेज कर मुझे हेरोदेस के हाथों से छुड़ा लिया, और यहूदी क़ौम की सारी उम्मीद तोड़ दी। <verse eid="ACT 12:11"/><verse number="12" style="v" sid="ACT 12:12"/>और इस पर ग़ौर कर के उस यूहन्ना की माँ मरियम के घर आया, जो मरकुस कहलाता है, वहाँ बहुत से आदमी जमा हो कर दुआ कर रहे थे।<verse eid="ACT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 12:13"/>जब उस ने फाटक की खिड़की खटखटाई, तो रुदी नाम एक लौंडी आवाज़ सुनने आई। <verse eid="ACT 12:13"/><verse number="14" style="v" sid="ACT 12:14"/>और पतरस की आवाज़ पहचान कर ख़ुशी के मारे फाटक न खोला, बल्कि दौड़कर अन्दर ख़बर की कि पतरस फाटक पर खड़ा है! <verse eid="ACT 12:14"/><verse number="15" style="v" sid="ACT 12:15"/>उन्हों ने उस से कहा, “तू दिवानी है लेकिन वो यक़ीन से कहती रही कि यूँ ही है! उन्होंने कहा कि उसका फ़रिश्ता होगा।”<verse eid="ACT 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16"/>मगर पतरस खटखटाता रहा पस, उन्हों ने खिड़की खोली और उस को देख कर हैरान हो गए। <verse eid="ACT 12:16"/><verse number="17" style="v" sid="ACT 12:17"/>उस ने उन्हें हाथ से इशारा किया कि चुप रहें। और उन से बयान किया कि ख़ुदावन्द ने मुझे इस तरह क़ैदख़ाने से निकाला फिर कहा कि या'क़ूब और भाइयों को इस बात की ख़बर देना, और रवाना होकर दूसरी जगह चला गया।<verse eid="ACT 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18"/>जब सुबह हुई तो सिपाही बहुत घबराए, कि पतरस क्या हुआ। <verse eid="ACT 12:18"/><verse number="19" style="v" sid="ACT 12:19"/>जब हेरोदेस ने उस की तलाश की और न पाया तो पहरे वालों की तहक़ीक़ात करके उनके क़त्ल का हुक्म दिया; और यहूदिया सूबे को छोड़ कर क़ैसरिया शहर में जा बसा।<verse eid="ACT 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20"/>और वो सूर और सैदा के लोगों से निहायत नाख़ुश था, पस वो एक दिल हो कर उसके पास आए, और बादशाह के दरबान बलस्तुस को अपनी तरफ़ करके सुलह चाही, इसलिए कि उन के मुल्क को बादशाह के मुल्क से इम्दाद पहुँचती थी। <verse eid="ACT 12:20"/><verse number="21" style="v" sid="ACT 12:21"/>पस, हेरोदेस एक दिन मुक़र्रर करके और शाहाना पोशाक पहन कर तख़्त — ए, अदालत पर बैठा, और उन से कलाम करने लगा।<verse eid="ACT 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 12:22"/>लोग पुकार उठे कि ये तो ख़ुदा की आवाज़ है न इंसान की, “यह ख़ुदावन्द की आवाज़ है, इन्सान की नहीं।” <verse eid="ACT 12:22"/><verse number="23" style="v" sid="ACT 12:23"/>उसी वक़्त ख़ुदा के फ़रिश्ते ने उसे मारा; इसलिए कि उस ने ख़ुदा की बड़ाई नहीं की और वो कीड़े पड़ कर मर गया।<verse eid="ACT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24"/>मगर ख़ुदा का कलाम तरक़्क़ी करता और फैलता गया।<verse eid="ACT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25"/>और बरनबास और साऊल अपनी ख़िदमत पूरी करके और यूहन्ना को जो मरकुस कहलाता है साथ लेकर, येरूशलेम से वापस आए।<verse eid="ACT 12:25"/></para>
  <chapter eid="ACT 12"/>
  <chapter number="13" style="c" sid="ACT 13"/>
  <para style="s">बरनाबास और साऊल को हुकम देना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1"/>अन्ताकिया में उस कलीसिया के मुता'ल्लिक़ जो वहाँ थी, कई नबी और मु'अल्लिम थे या'नी बरनबास और शमौन जो काला कहलाता है, और लुकियुस कुरेनी और मनाहेम जो चौथाई मुल्क के हाकिम हेरोदेस के साथ पला था, और साऊल। <verse eid="ACT 13:1"/><verse number="2" style="v" sid="ACT 13:2"/>जब वो ख़ुदावन्द की इबादत कर रहे और रोज़े रख रहे थे, तो रूह — उल — क़ुद्दूस ने कहा, “मेरे लिए बरनबास और साऊल को उस काम के वास्ते मख़्सूस कर दो जिसके वास्ते में ने उनको बुलाया है।” <verse eid="ACT 13:2"/><verse number="3" style="v" sid="ACT 13:3"/>तब उन्हों ने रोज़ा रख कर और दुआ करके और उन पर हाथ रखकर उन्हें रुख़्सत किया।<verse eid="ACT 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4"/>पस, वो रूह — उल — क़ुद्दूस के भेजे हुए सिलोकिया को गए, और वहाँ से जहाज़ पर कुप्रुस को चले। <verse eid="ACT 13:4"/><verse number="5" style="v" sid="ACT 13:5"/>और सलमीस शहर में पहुँचकर यहूदियों के इबादतख़ानों में ख़ुदा का कलाम सुनाने लगे और यूहन्ना उनका ख़ादिम था।<verse eid="ACT 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6"/>और उस तमाम टापू में होते हुए पाफ़ुस शहर तक पहुँचे वहाँ उन्हें एक यहूदी जादूगर और झूठा नबी बरयिसू नाम का मिला। <verse eid="ACT 13:6"/><verse number="7" style="v" sid="ACT 13:7"/>वो सिरगियुस पौलुस सूबेदार के साथ था जो सहिब — ए — तमीज़ आदमी था, इस ने बरनबास और साऊल को बुलाकर ख़ुदा का कलाम सुनना चाहा। <verse eid="ACT 13:7"/><verse number="8" style="v" sid="ACT 13:8"/>मगर इलीमास जादूगर ने (यही उसके नाम का तर्जुमा है), उनकी मुख़ालिफ़त की और सूबेदार को ईमान लाने से रोकना चाहा।<verse eid="ACT 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 13:9"/>और साऊल<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="fq" closed="false">साऊल </char><char style="ft" closed="false">इब्रानी नाम है और पौलुस यूनानी नाम है </char></note> ने जिसका नाम पौलुस भी है रूह — उल — क़ुद्दूस से भर कर उस पर ग़ौर से देखा। <verse eid="ACT 13:9"/><verse number="10" style="v" sid="ACT 13:10"/>और कहा ऐ इब्लीस की औलाद तू तमाम मक्कारी और शरारत से भरा हुआ और हर तरह की नेकी का दुश्मन है। क्या दावन्द के सीधे रास्तों को बिगाड़ने से बाज़ न आएगा<verse eid="ACT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 13:11"/>अब देख तुझ पर ख़ुदावन्द का ग़ज़ब है और तू अन्धा होकर कुछ मुद्दत तक सूरज को न देखे गा। उसी वक़्त अँधेरा उस पर छा गया, और वो ढूँडता फिरा कि कोई उसका हाथ पकड़कर ले चले। <verse eid="ACT 13:11"/><verse number="12" style="v" sid="ACT 13:12"/>तब सूबेदार ये माजरा देखकर और ख़ुदावन्द की तालीम से हैरान हो कर ईमान ले आया।<verse eid="ACT 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13"/>फिर पौलुस और उसके साथी पाफ़ुस शहर से जहाज़ पर रवाना होकर पम्फ़ीलिया मुल्क के पिरगा शहर में आए; और यूहन्ना उनसे जुदा होकर येरूशलेम को वापस चला गया। <verse eid="ACT 13:13"/><verse number="14" style="v" sid="ACT 13:14"/>और वो पिरगा शहर से चलकर पिसदिया मुल्क के अन्ताकिया शहर में पहुँचे, और सबत के दिन इबादतख़ाने में जा बैठे। <verse eid="ACT 13:14"/><verse number="15" style="v" sid="ACT 13:15"/>फिर तौरेत और नबियों की किताब पढ़ने के बाद इबादतख़ाने के सरदारों ने उन्हें कहला भेजा “ऐ भाइयों अगर लोगों की नसीहत के वास्ते तुम्हारे दिल में कोई बात हो तो बयान करो।”<verse eid="ACT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16"/>पस, पौलुस ने खड़े होकर और हाथ से इशारा करके कहा, ऐ इस्राईलियो और ऐ ख़ुदा से डरनेवाले सुनो! <verse eid="ACT 13:16"/><verse number="17" style="v" sid="ACT 13:17"/>इस उम्मत इस्राईल के ख़ुदा ने हमारे बाप दादा को चुन लिया और जब ये उम्मत मुल्के मिस्र में परदेसियों की तरह रहती थी, उसको सरबलन्द किया और ज़बरदस्त हाथ से उन्हें वहाँ से निकाल लाया। <verse eid="ACT 13:17"/><verse number="18" style="v" sid="ACT 13:18"/>और कोई चालीस बरस तक वीरानों में<note caller="+" style="f"><char style="fr" closed="false">13:18 </char><char style="fq" closed="false">चालीस बरस तक वीरानों में </char><char style="ft" closed="false">पौलुस को ख़ुदा ने वीरान में घटना और बढ़ना सिखाया — रेगिस्तान </char></note> उनकी आदतों की बर्दाश्त करता रहा,<verse eid="ACT 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 13:19"/>और कनान के मुल्क में सात क़ौमों को लूट करके तक़रीबन साढ़े चार सौ बरस में उनका मुल्क इन की मीरास कर दिया। <verse eid="ACT 13:19"/><verse number="20" style="v" sid="ACT 13:20"/>और इन बातों के बाद शमुएल नबी के ज़माने तक उन में क़ाज़ी मुक़र्रर किए।<verse eid="ACT 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 13:21"/>इस के बाद उन्हों ने बादशाह के लिए दरख़्वास्त की और ख़ुदा ने बिनयामीन के क़बीले में से एक शख़्स साऊल क़ीस के बेटे को चालीस बरस के लिए उन पर मुक़र्रर किया।<verse eid="ACT 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 13:22"/>फिर उसे हटा करके दाऊद को उन का बादशाह बनाया। जिसके बारे में उस ने ये गवाही दी कि मुझे एक शख़्स यस्सी का बेटा दाऊद मेरे दिल के मु'वाफ़िक़ मिल गया। वही मेरी तमाम मर्ज़ी को पूरा करेगा।<verse eid="ACT 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23"/>इसी की नस्ल में से ख़ुदा ने अपने वा'दे के मुताबिक़ इस्राईल के पास एक मुन्जी या'नी ईसा को भेज दिया। <verse eid="ACT 13:23"/><verse number="24" style="v" sid="ACT 13:24"/>जिस के आने से पहले यहून्ना ने इस्राईल की तमाम उम्मत के सामने तौबा के बपतिस्मे का ऐलान किया। <verse eid="ACT 13:24"/><verse number="25" style="v" sid="ACT 13:25"/>और जब युहन्ना अपना दौर पूरा करने को था, तो उस ने कहा कि तुम मुझे क्या समझते हो? में वो नहीं बल्कि देखो मेरे बाद वो शख़्स आने वाला है, जिसके पाँव की जूतियों का फ़ीता मैं खोलने के लायक़ नहीं।<verse eid="ACT 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26"/>ऐ भाइयों! अब्रहाम के बेटो और ऐ ख़ुदा से डरने वालों इस नजात का कलाम हमारे पास भेजा गया। <verse eid="ACT 13:26"/><verse number="27" style="v" sid="ACT 13:27"/>क्यूँकि येरूशलेम के रहने वालों और उन के सरदारों ने न उसे पहचाना और न नबियों की बातें समझीं, जो हर सबत को सुनाई जाती हैं। इस लिए उस पर फ़तवा देकर उनको पूरा किया।<verse eid="ACT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 13:28"/>और अगरचे उस के क़त्ल की कोई वजह न मिली तोभी उन्हों ने पीलातुस से उसके क़त्ल की दरख़्वास्त की। <verse eid="ACT 13:28"/><verse number="29" style="v" sid="ACT 13:29"/>और जो कुछ उसके हक़ में लिखा था, जब उसको तमाम कर चुके तो उसे सलीब पर से उतार कर क़ब्र में रख्खा।<verse eid="ACT 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 13:30"/>लेकिन ख़ुदा ने उसे मुर्दों में से जिलाया। <verse eid="ACT 13:30"/><verse number="31" style="v" sid="ACT 13:31"/>और वो बहुत दिनों तक उनको दिखाई दिया, जो उसके साथ गलील से येरूशलेम आए थे, उम्मत के सामने अब वही उसके गवाह हैं।<verse eid="ACT 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32"/>और हम तुमको उस वा'दे के बारे में जो बाप दादा से किया गया था, ये ख़ुशख़बरी देते हैं। <verse eid="ACT 13:32"/><verse number="33" style="v" sid="ACT 13:33"/>कि ख़ुदा ने ईसा को जिला कर हमारी औलाद के लिए उसी वा'दे को पूरा किया‘ चुनाँचे दूसरे मज़मूर में लिखा है, कि तू मेरा बेटा है, आज तू मुझ से पैदा हुआ। <verse eid="ACT 13:33"/><verse number="34" style="v" sid="ACT 13:34"/>और उसके इस तरह मुर्दों में से जिलाने के बारे में फिर कभी न मरे और उस ने यूँ कहा, कि मैं दाऊद की पाक और सच्ची ने'अमतें तुम्हें दूँगा।’<verse eid="ACT 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 13:35"/>चुनाँचे वो एक और मज़मूर में भी कहता है,</para>
  <para style="q" vid="ACT 13:35">कि तू अपने मुक़द्दस के सड़ने की नौबत पहुँचने न देगा‘।’ <verse eid="ACT 13:35"/><verse number="36" style="v" sid="ACT 13:36"/>क्यूँकि दाऊद तो अपने वक़्त में ख़ुदा की मर्ज़ी के ताबे' दार रह कर सो गया, और अपने बाप दादा से जा मिला, और उसके सड़ने की नौबत पहुँची। <verse eid="ACT 13:36"/><verse number="37" style="v" sid="ACT 13:37"/>मगर जिसको ख़ुदा ने जिलाया उसके सड़ने की नौबत न पहुँची।<verse eid="ACT 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38"/>पस, ऐ भाइयों! तुम्हें मा' लूम हो कि उसी के वसीले से तुम को गुनाहों की मु'आफ़ी की ख़बर दी जाती है। <verse eid="ACT 13:38"/><verse number="39" style="v" sid="ACT 13:39"/>और मूसा की शरी' अत के ज़रिए जिन बातों से तुम बरी नहीं हो सकते थे, उन सब से हर एक ईमान लाने वाला उसके ज़रिए बरी होता है।<verse eid="ACT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 13:40"/>पस, ख़बरदार! ऐसा न हो कि जो नबियों की किताब में आया है वो तुम पर सच आए।<verse eid="ACT 13:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="ACT 13:41"/>ऐ तहकीर करने वालों, देखो, तअ'ज्जुब करो और मिट जाओ:</para>
  <para style="q" vid="ACT 13:41">क्यूँकि में तुम्हारे ज़माने में एक काम करता हूँ ऐसा काम कि अगर कोई तुम से बयान करे तो कभी उसका यक़ीन न करोगे।<verse eid="ACT 13:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42"/>उनके बाहर जाते वक़्त लोग मिन्नत करने लगे कि अगले सबत को भी ये बातें सुनाई जाएँ। <verse eid="ACT 13:42"/><verse number="43" style="v" sid="ACT 13:43"/>जब मजलिस ख़त्म हुई तो बहुत से यहूदी और ख़ुदा परस्त नए मुरीद यहूदी पौलुस और बरनबास के पीछे हो लिए, उन्हों ने उन से कलाम किया और तरग़ीब दी कि ख़ुदा के फ़ज़ल पर क़ाईम रहो।<verse eid="ACT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44"/>दूसरे सबत को तक़रीबन सारा शहर ख़ुदा का कलाम सुनने को इकट्ठा हुआ। <verse eid="ACT 13:44"/><verse number="45" style="v" sid="ACT 13:45"/>मगर यहूदी इतनी भीड़ देखकर हसद से भर गए, और पौलुस की बातों की मुख़ालिफ़त करने और कुफ़्र बकने लगे।<verse eid="ACT 13:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46"/>पौलुस और बरनबास दिलेर होकर कहने लगे, ज़रूर था, कि ख़ुदा का कलाम पहले तुम्हें सुनाया जाए; लेकिन चूँकि तुम उसको रद्द करते हो। और अपने आप को हमेशा की ज़िन्दगी के नाक़ाबिल ठहराते हो, तो देखो हम ग़ैर क़ौमों की तरफ़ मुतवज्जह होते हैं। <verse eid="ACT 13:46"/><verse number="47" style="v" sid="ACT 13:47"/>क्यूँकि ख़ुदा ने हमें ये हुक्म दिया है कि</para>
  <para style="q" vid="ACT 13:47">“मैने तुझ को ग़ैर क़ौमों के लिए नूर मुक़र्रर किया</para>
  <para style="q" vid="ACT 13:47">'ताकि तू ज़मीन की इन्तिहा तक नजात का ज़रिया हो।”<verse eid="ACT 13:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48"/>ग़ैर क़ौम वाले ये सुनकर ख़ुश हुए और ख़ुदा के कलाम की बड़ाई करने लगे, और जितने हमेशा की ज़िन्दगी के लिए मुक़र्रर किए गए थे, ईमान ले आए। <verse eid="ACT 13:48"/><verse number="49" style="v" sid="ACT 13:49"/>और उस तमाम इलाक़े में ख़ुदा का कलाम फैल गया।<verse eid="ACT 13:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="ACT 13:50"/>मगर यहूदियों ने ख़ुदा परस्त और इज़्ज़त दार औरतों और शहर के रईसों को उभारा और पौलुस और बरनबास को सताने पर आमादा करके उन्हें अपनी सरहदों से निकाल दिया। <verse eid="ACT 13:50"/><verse number="51" style="v" sid="ACT 13:51"/>ये अपने पाँव की ख़ाक उनके सामने झाड़ कर इकुनियुम शहर को गए। <verse eid="ACT 13:51"/><verse number="52" style="v" sid="ACT 13:52"/>मगर शागिर्द ख़ुशी और रूह — उल — क़ुद्दूस से भरते रहे।<verse eid="ACT 13:52"/></para>
  <chapter eid="ACT 13"/>
  <chapter number="14" style="c" sid="ACT 14"/>
  <para style="s">पौलुस और बरनाबस इकुनियुम में</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1"/>और इकुनियुम में ऐसा हुआ कि वो साथ साथ यहूदियों के इबादत खाने में गए। और ऐसी तक़रीर की कि यहूदियों और यूनानियों दोनों की एक बड़ी जमा'अत ईमान ले आई। <verse eid="ACT 14:1"/><verse number="2" style="v" sid="ACT 14:2"/>मगर नाफ़रमान यहूदियों ने ग़ैर क़ौमों के दिलों में जोश पैदा करके उनको भाइयों की तरफ़ बदगुमान कर दिया।<verse eid="ACT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 14:3"/>पस, वो बहुत ज़माने तक वहाँ रहे, और ख़ुदावन्द के भरोसे पर हिम्मत से कलाम करते थे, और वो उनके हाथों से निशान और अजीब काम कराकर, अपने फ़ज़ल के कलाम की गवाही देता था। <verse eid="ACT 14:3"/><verse number="4" style="v" sid="ACT 14:4"/>लेकिन शहर के लोगों में फ़ूट पड़ गई। कुछ यहूदियों की तरफ़ हो गए। कुछ रसूलों की तरफ़।<verse eid="ACT 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5"/>मगर जब ग़ैर क़ौम वाले और यहूदी उन्हें बे'इज़्ज़त और पथराव करने को अपने सरदारों समेत उन पर चढ़ आए। <verse eid="ACT 14:5"/><verse number="6" style="v" sid="ACT 14:6"/>तो वो इस से वाक़िफ़ होकर लुकाउनिया मुल्क के शहरों लुस्तरा और दिरबे और उनके आस — पास में भाग गए। <verse eid="ACT 14:6"/><verse number="7" style="v" sid="ACT 14:7"/>और वहाँ ख़ुशख़बरी सुनाते रहे।<verse eid="ACT 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8"/>और लुस्तरा में एक शख़्स बैठा था, जो पाँव से लाचार था। वो पैदाइशी लंगड़ा था, और कभी न चला था। <verse eid="ACT 14:8"/><verse number="9" style="v" sid="ACT 14:9"/>वो पौलुस को बातें करते सुन रहा था। और जब इस ने उसकी तरफ़ ग़ौर करके देखा कि उस में शिफ़ा पाने के लायक़ ईमान है। <verse eid="ACT 14:9"/><verse number="10" style="v" sid="ACT 14:10"/>तो बड़ी आवाज़ से कहा कि, “अपने पाँव के बल सीधा खड़ा हो पस, वो उछल कर चलने फिरने लगा।”<verse eid="ACT 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11"/>लोगों ने पौलुस का ये काम देखकर लुकाउनिया की बोली में बुलन्द आवाज़ से कहा “कि आदमियों की सूरत में देवता उतर कर हमारे पास आए हैं <verse eid="ACT 14:11"/><verse number="12" style="v" sid="ACT 14:12"/>और उन्होंने बरनबास को ज़ियूस<note caller="+" style="f"><char style="fr" closed="false">14:12 </char><char style="fq" closed="false">ज़ियूस </char><char style="ft" closed="false">ये बड़ा ख़ुदा है और हरमेस छोटा ख़ुदा या उसका पैग़म्बर यहूदी और यूनानी लोग जियूस को बड़ा ख़ुदा कहते थे </char></note> कहा, और पौलुस को हरमेस इसलिए कि ये कलाम करने में सबक़त रखता था। <verse eid="ACT 14:12"/><verse number="13" style="v" sid="ACT 14:13"/>और ज़ियूस कि उस मन्दिर का पुजारी जो उनके शहर के सामने था, बैल और फ़ूलों के हार फाटक पर लाकर लोगों के साथ क़ुर्बानी करना चहता था।”<verse eid="ACT 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14"/>जब बरनबास और पौलुस रसूलों ने ये सुना तो अपने कपड़े फाड़ कर लोगों में जा कूदे, और पुकार पुकार कर। <verse eid="ACT 14:14"/><verse number="15" style="v" sid="ACT 14:15"/>कहने लगे, लोगो तुम ये क्या करते हो? हम भी तुम्हारी हम तबी'अत इंसान हैं और तुम्हें ख़ुशख़बरी सुनाते हैं ताकि इन बातिल चीज़ों से किनारा करके ज़िन्दा ख़ुदा की तरफ़ फिरो, जिस ने आसमान और ज़मीन और समुन्दर और जो कुछ उन में है, पैदा किया। <verse eid="ACT 14:15"/><verse number="16" style="v" sid="ACT 14:16"/>उस ने अगले ज़माने में सब क़ौमों को अपनी अपनी राह पर चलने दिया।<verse eid="ACT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 14:17"/>तोभी उस ने अपने आप को बेगवाह न छोड़ा। चुनाँचे, उस ने महरबानियाँ कीं और आसमान से तुम्हारे लिए पानी बरसाया और बड़ी बड़ी पैदावार के मौसम अता' किए और तुम्हारे दिलों को ख़ुराक और ख़ुशी से भर दिया। <verse eid="ACT 14:17"/><verse number="18" style="v" sid="ACT 14:18"/>ये बातें कहकर भी लोगों को मुश्किल से रोका कि उन के लिए क़ुर्बानी न करें।<verse eid="ACT 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19"/>फिर कुछ यहूदी अन्ताकिया और इकुनियुम से आए और लोगों को अपनी तरफ़ करके पौलुस पर पथराव किया और उसको मुर्दा समझकर शहर के बाहर घसीट ले गए। <verse eid="ACT 14:19"/><verse number="20" style="v" sid="ACT 14:20"/>मगर जब शागिर्द उसके आस पास आ खड़े हुए, तो वो उठ कर शहर में आया, और दूसरे दिन बरनबास के साथ दिरबे शहर को चला गया।<verse eid="ACT 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21"/>और वो उस शहर में ख़ुशख़बरी सुना कर और बहुत से शागिर्द करके लुस्तरा और इकुनियुम और अन्ताकिया को वापस आए। <verse eid="ACT 14:21"/><verse number="22" style="v" sid="ACT 14:22"/>और शागिर्दों के दिलों को मज़बूत करते, और ये नसीहत देते थे, कि ईमान पर क़ाईम रहो और कहते थे “ज़रूर है कि हम बहुत मुसीबतें सहकर ख़ुदा की बादशाही में दाख़िल हों।”<verse eid="ACT 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 14:23"/>और उन्होंने हर एक कलीसिया में उनके लिए बुज़ुर्गों को मुक़र्रर किया और रोज़ा रखकर और दुआ करके उन्हें दावन्द के सुपुर्द किया, जिस पर वो ईमान लाए थे। <verse eid="ACT 14:23"/><verse number="24" style="v" sid="ACT 14:24"/>और पिसदिया मुल्क में से होते हुए पम्फ़ीलिया मुल्क में पहुँचे। <verse eid="ACT 14:24"/><verse number="25" style="v" sid="ACT 14:25"/>और पिरगे में कलाम सुनाकर अत्तलिया को गए।<verse eid="ACT 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 14:26"/>और वहाँ से जहाज़ पर उस अन्ताकिया में आए, जहाँ उस काम के लिए जो उन्होंने अब पूरा किया ख़ुदा के फ़ज़ल के सुपुर्द किए गए थे। <verse eid="ACT 14:26"/><verse number="27" style="v" sid="ACT 14:27"/>वहाँ पहुँचकर उन्होंने कलीसिया को जमा किया और उन के सामने बयान किया कि ख़ुदा ने हमारे ज़रिए क्या कुछ किया और ये कि उस ने ग़ैर क़ौमों के लिए ईमान का दरवाज़ा खोल दिया। <verse eid="ACT 14:27"/><verse number="28" style="v" sid="ACT 14:28"/>और वो ईमानदारों के पास मुद्दत तक रहे।<verse eid="ACT 14:28"/></para>
  <chapter eid="ACT 14"/>
  <chapter number="15" style="c" sid="ACT 15"/>
  <para style="s">यरुशलेम की शरी'अत</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1"/>फिर कुछ लोग यहूदिया से आ कर भाइयों को यह तालीम देने लगे, “ज़रूरी है कि आप का मूसा की शरी'अत के मुताबिक़ ख़तना किया जाए, वर्ना आप नजात नहीं पा सकेंगे।” <verse eid="ACT 15:1"/><verse number="2" style="v" sid="ACT 15:2"/>पस, जब पौलुस और बरनबास की उन से बहुत तकरार और बहस हुई तो कलीसिया ने ये ठहराया कि पौलुस और बरनबास और उन में से चन्द शख़्स इस मस्ले के लिए रसूलों और बुज़ुर्गों के पास येरूशलेम जाएँ।<verse eid="ACT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3"/>पस, कलीसिया ने उनको रवाना किया और वो ग़ैर क़ौमों को रुजू लाने का बयान करते हुए फ़ीनिके और सामरिया सूबे से गुज़रे और सब भाइयों को बहुत ख़ुश करते गए। <verse eid="ACT 15:3"/><verse number="4" style="v" sid="ACT 15:4"/>जब येरूशलेम में पहुँचे तो कलीसिया और रसूल और बुज़ुर्ग उन से ख़ुशी के साथ मिले। और उन्हों ने सब कुछ बयान किया जो ख़ुदा ने उनके ज़रिए किया था।<verse eid="ACT 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 15:5"/>मगर फ़रीसियों के फ़िर्के में से जो ईमान लाए थे, उन में से कुछ ने उठ कर कहा “कि उनका ख़तना कराना और उनको मूसा की शरी'अत पर अमल करने का हुक्म देना ज़रूरी है।” <verse eid="ACT 15:5"/><verse number="6" style="v" sid="ACT 15:6"/>पस, रसूल और बुज़ुर्ग इस बात पर ग़ौर करने के लिए जमा हुए।<verse eid="ACT 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 15:7"/>और बहुत बहस के बाद पतरस ने खड़े होकर उन से कहा कि</para>
  <para style="p" vid="ACT 15:7">ऐ भाइयों तुम जानते हो कि बहुत अर्सा हुआ जब ख़ुदा ने तुम लोगों में से मुझे चुना कि ग़ैर क़ौमें मेरी ज़बान से ख़ुशख़बरी का कलाम सुनकर ईमान लाएँ। <verse eid="ACT 15:7"/><verse number="8" style="v" sid="ACT 15:8"/>और ख़ुदा ने जो दिलों को जानता है उनको भी हमारी तरह रूह — उल — क़ुद्दूस दे कर उन की गवाही दी। <verse eid="ACT 15:8"/><verse number="9" style="v" sid="ACT 15:9"/>और ईमान के वसीले से उन के दिल पाक करके हम में और उन में कुछ फ़र्क़ न रख्खा।<verse eid="ACT 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 15:10"/>पस, अब तुम शागिर्दों की गर्दन पर ऐसा जुआ रख कर जिसको न हमारे बाप दादा उठा सकते थे, न हम ख़ुदा को क्यूँ आज़माते हो? <verse eid="ACT 15:10"/><verse number="11" style="v" sid="ACT 15:11"/>हालाँकि हम को यक़ीन है कि जिस तरह वो ख़ुदावन्द ईसा के फ़ज़ल ही से नजात पाएँगे, उसी तरह हम भी पाएँगे।<verse eid="ACT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12"/>फिर सारी जमा'अत चुप रही और पौलुस और बरनबास का बयान सुनने लगी, कि ख़ुदा ने उनके ज़रिए ग़ैर क़ौमों में कैसे कैसे निशान और अजीब काम ज़हिर किए।<verse eid="ACT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 15:13"/>जब वो ख़ामोश हुए तो या'क़ूब कहने लगा कि,</para>
  <para style="p" vid="ACT 15:13">“ऐ भाइयों मेरी सुनो!” <verse eid="ACT 15:13"/><verse number="14" style="v" sid="ACT 15:14"/>शमौन ने बयान किया कि ख़ुदा ने पहले ग़ैर क़ौमों पर किस तरह तवज्जह की ताकि उन में से अपने नाम की एक उम्मत बना ले।<verse eid="ACT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 15:15"/>और नबियों की बातें भी इस के मुताबिक़ हैं। चुनाँचे लिखा है कि।<verse eid="ACT 15:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ACT 15:16"/>इन बातों के बाद मैं फिर आकर दाऊद के गिरे हुए खेमों को उठाऊँगा,</para>
  <para style="q" vid="ACT 15:16">और उस के फ़टे टूटे की मरम्मत करके</para>
  <para style="q" vid="ACT 15:16">उसे खड़ा करूँगा।<verse eid="ACT 15:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ACT 15:17"/>ताकि बाक़ी आदमी या'नी सब क़ौमें जो मेरे नाम की कहलाती हैं ख़ुदावन्द को तलाश करें'<verse eid="ACT 15:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ACT 15:18"/>ये वही ख़ुदावन्द फ़रमाता है जो दुनिया के शुरू से इन बातों की ख़बर देता आया है।<verse eid="ACT 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19"/>पस, मेरा फ़ैसला ये है, कि जो ग़ैर क़ौमों में से ख़ुदा की तरफ़ रुजू होते हैं हम उन्हें तकलीफ़ न दें। <verse eid="ACT 15:19"/><verse number="20" style="v" sid="ACT 15:20"/>मगर उन को लिख भेजें कि बुतों की मकरूहात और हरामकारी और गला घोंटे हुए जानवरों और लहू से परहेज़ करें। <verse eid="ACT 15:20"/><verse number="21" style="v" sid="ACT 15:21"/>क्यूँकि पुराने ज़माने से हर शहर में मूसा की तौरेत का ऐलान करने वाले होते चले आए हैं: और वो हर सबत को इबादतख़ानों में सुनाई जाती हैं।<verse eid="ACT 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22"/>इस पर रसूलों और बुज़ुर्गों ने सारी कलीसिया समेत मुनासिब जाना कि अपने में से चन्द शख़्स चुन कर पौलुस और बरनबास के साथ अन्ताकिया को भेजें, या'नी यहूदाह को जो बरसब्बा कहलाता है। और सीलास को ये शख़्स भाइयों में मुक़द्दम थे। <verse eid="ACT 15:22"/><verse number="23" style="v" sid="ACT 15:23"/>और उनके हाथ ये लिख भेजा कि “अन्ताकिया और सूरिया और किलकिया के रहने वाले भाइयों को जो ग़ैर क़ौमों में से हैं। रसूलों और बुज़ुर्ग भाइयों का सलाम पहूँचे।”<verse eid="ACT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 15:24"/>चूँकि हम ने सुना है, कि कुछ ने हम में से जिनको हम ने हुक्म न दिया था, वहाँ जाकर तुम्हें अपनी बातों से घबरा दिया। और तुम्हारे दिलों को उलट दिया। <verse eid="ACT 15:24"/><verse number="25" style="v" sid="ACT 15:25"/>इसलिए हम ने एक दिल होकर मुनासिब जाना कि कुछ चुने हुए आदमियों को अपने अज़ीज़ों बरनबास और पौलुस के साथ तुम्हारे पास भेजें। <verse eid="ACT 15:25"/><verse number="26" style="v" sid="ACT 15:26"/>ये दोनों ऐसे आदमी हैं, जिन्होंने अपनी जानें हमारे ख़ुदावन्द ईसा मसीह के नाम पर निसार कर रख्खी हैं।<verse eid="ACT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 15:27"/>चुनाँचे हम ने यहूदाह और सीलास को भेजा है, वो यही बातें ज़बानी भी बयान करेंगे। <verse eid="ACT 15:27"/><verse number="28" style="v" sid="ACT 15:28"/>क्यूँकि रूह — उल — क़ुद्दूस ने और हम ने मुनासिब जाना कि इन ज़रूरी बातों के सिवा तुम पर और बोझ न डालें <verse eid="ACT 15:28"/><verse number="29" style="v" sid="ACT 15:29"/>कि तुम बुतों की क़ुर्बानियों के गोश्त से और लहू और गला घोंटे हुए जानवरों और हरामकारी से परहेज़ करो। अगर तुम इन चीज़ों से अपने आप को बचाए रख्खोगे, तो सलामत रहोगे, वस्सलामत।<verse eid="ACT 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30"/>पस, वो रुख़्सत होकर अन्ताकिया में पहुँचे और जमा'अत को इकट्ठा करके ख़त दे दिया। <verse eid="ACT 15:30"/><verse number="31" style="v" sid="ACT 15:31"/>वो पढ़ कर उसके तसल्ली बख़्श मज़्मून से ख़ुश हुए। <verse eid="ACT 15:31"/><verse number="32" style="v" sid="ACT 15:32"/>और यहूदाह और सीलास ने जो ख़ुद भी नबी थे, भाइयों को बहुत सी नसीहत करके मज़बूत कर दिया।<verse eid="ACT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 15:33"/>वो चन्द रोज़ रह कर और भाइयों से सलामती की दुआ लेकर अपने भेजने वालों के पास रुख़्सत कर दिए गए। <verse eid="ACT 15:33"/><verse number="34" style="v" sid="ACT 15:34"/>[लेकिन सीलास को वहाँ ठहरना अच्छा लगा]। <verse eid="ACT 15:34"/><verse number="35" style="v" sid="ACT 15:35"/>मगर पौलुस और बरनबास अन्ताकिया ही में रहे:और बहुत से और लोगों के साथ ख़ुदावन्द का कलाम सिखाते और उस का ऐलान करते रहे।<verse eid="ACT 15:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36"/>चन्द रोज़ बाद पौलुस ने बरनबास से कहा “कि जिन जिन शहरों में हम ने ख़ुदा का कलाम सुनाया था, आओ फिर उन में चलकर भाइयों को देखें कि कैसे हैं।” <verse eid="ACT 15:36"/><verse number="37" style="v" sid="ACT 15:37"/>और बरनबास की सलाह थी कि यूहन्ना को जो मरकुस कहलाता है। अपने साथ ले चलें। <verse eid="ACT 15:37"/><verse number="38" style="v" sid="ACT 15:38"/>मगर पौलुस ने ये मुनासिब न जाना, कि जो शख़्स पम्फ़ीलिया में किनारा करके उस काम के लिए उनके साथ न गया था; उस को हमराह ले चलें।<verse eid="ACT 15:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 15:39"/>पस, उन में ऐसी सख़्त तकरार हुई; कि एक दूसरे से जुदा हो गए। और बरनबास मरकुस को ले कर जहाज़ पर कुप्रुस को रवाना हुआ।<verse eid="ACT 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 15:40"/>मगर पौलुस ने सीलास को पसन्द किया, और भाइयों की तरफ़ से ख़ुदावन्द के फ़ज़ल के सुपुर्द हो कर रवाना किया। <verse eid="ACT 15:40"/><verse number="41" style="v" sid="ACT 15:41"/>और कलीसिया को मज़बूत करता हुआ सूरिया और किलकिया से गुज़रा।<verse eid="ACT 15:41"/></para>
  <chapter eid="ACT 15"/>
  <chapter number="16" style="c" sid="ACT 16"/>
  <para style="s">पौलुस का दुसरी तबलिघी सफ़र</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1"/>फिर वो दिरबे और लुस्तरा में भी पहूँचा। तो देखो वहाँ तीमुथियुस नाम का एक शागिर्द था। उसकी माँ तो यहूदी थी जो ईमान ले आई थी, मगर उसका बाप यूनानी था। <verse eid="ACT 16:1"/><verse number="2" style="v" sid="ACT 16:2"/>वो लुस्तरा और इकुनियुम के भाइयों में नेक नाम था। <verse eid="ACT 16:2"/><verse number="3" style="v" sid="ACT 16:3"/>पौलुस ने चाहा कि ये मेरे साथ चले। पस, उसको लेकर उन यहूदियों की वजह से जो उस इलाक़े में थे, उसका ख़तना कर दिया क्यूँकि वो सब जानते थे, कि इसका बाप यूनानी है।<verse eid="ACT 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 16:4"/>और वो जिन जिन शहरों में से गुज़रते थे, वहाँ के लोगों को वो अहकाम अमल करने के लिए पहुँचाते जाते थे, जो येरूशलेम के रसूलों और बुज़ुर्गों ने जारी किए थे। <verse eid="ACT 16:4"/><verse number="5" style="v" sid="ACT 16:5"/>पस, कलीसियाएँ ईमान में मज़बूत और शुमार में रोज़ — ब — रोज़ ज़्यादा होती गईं।<verse eid="ACT 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6"/>और वो फ़रोगिया और ग़लतिया सूबे के इलाक़े में से गुज़रे, क्यूँकि रूह — उल — क़ुद्दूस ने उन्हें आसिया<note caller="+" style="f"><char style="fr" closed="false">16:6 </char><char style="fq" closed="false">आसिया </char><char style="ft" closed="false">आज के ज़माने में तुर्की इ नाम से जानते है </char></note> में कलाम सुनाने से मनह किया। <verse eid="ACT 16:6"/><verse number="7" style="v" sid="ACT 16:7"/>और उन्होंने मूसिया के क़रीब पहुँचकर बितूनिया सूबे में जाने की कोशिश की मगर ईसा की रूह ने उन्हें जाने न दिया। <verse eid="ACT 16:7"/><verse number="8" style="v" sid="ACT 16:8"/>पस, वो मूसिया से गुज़र कर त्रोआस शहर में आए।<verse eid="ACT 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 16:9"/>और पौलुस ने रात को ख़्वाब में देखा कि एक मकिदुनी आदमी खड़ा हुआ, उस की मिन्नत करके कहता है कि पार उतर कर मकिदुनिया में आ, और हमारी मदद कर! <verse eid="ACT 16:9"/><verse number="10" style="v" sid="ACT 16:10"/>उस का ख़्वाब देखते ही हम ने फ़ौरन मकिदुनिया में जाने का ईरादा किया, क्यूँकि हम इस से ये समझे कि ख़ुदा ने उन्हें ख़ुशख़बरी देने के लिए हम को बुलाया है।<verse eid="ACT 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11"/>पस, त्रोआस शहर से जहाज़ पर रवाना होकर हम सीधे सुमत्राकि टापू में और दूसरे दिन नियापुलिस शहर में आए। <verse eid="ACT 16:11"/><verse number="12" style="v" sid="ACT 16:12"/>और वहाँ से फ़िलिप्पी शहर में पहुँचे, जो मकिदुनिया का सूबा में है और उस क़िस्मत का सद्र और रोमियों की बस्ती है और हम चन्द रोज़ उस शहर में रहे। <verse eid="ACT 16:12"/><verse number="13" style="v" sid="ACT 16:13"/>और सबत के दिन शहर के दरवाज़े के बाहर नदी के किनारे गए, जहाँ समझे कि दुआ करने की जगह होगी और बैठ कर उन औरतों से जो इकट्ठी हुई थीं, कलाम करने लगे।<verse eid="ACT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 16:14"/>और थुवातीरा शहर की एक ख़ुदा परस्त औरत लुदिया नाम की, क़िरमिज़ी बेचने वाली भी सुनती थी, उसका दिल ख़ुदावन्द ने खोला ताकि पौलुस की बातों पर तवज्जुह करे। <verse eid="ACT 16:14"/><verse number="15" style="v" sid="ACT 16:15"/>और जब उस ने अपने घराने समेत बपतिस्मा लिया तो मिन्नत कर के कहा कि “अगर तुम मुझे ख़ुदावन्द की ईमानदार बन्दी समझते हो तो चल कर मेरे घर में रहो” पस, उसने हमें मजबूर किया।<verse eid="ACT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16"/>जब हम दुआ करने की जगह जा रहे थे, तो ऐसा हुआ कि हमें एक लौंडी मिली जिस में पोशीदा रूहें थी, वो ग़ैब गोई से अपने मालिकों के लिए बहुत कुछ कमाती थी। <verse eid="ACT 16:16"/><verse number="17" style="v" sid="ACT 16:17"/>वो पौलुस के, और हमारे पीछे आकर चिल्लाने लगी “कि ये आदमी ख़ुदा के बन्दे हैं जो तुम्हें नजात की राह बताते हैं।” <verse eid="ACT 16:17"/><verse number="18" style="v" sid="ACT 16:18"/>वो बहुत दिनों तक ऐसा ही करती रही। आख़िर पौलुस सख़्त रंजीदा हुआ और फिर कर उस रूह से कहा कि “मैं तुझे ईसा मसीह के नाम से हुक्म देता हूँ कि इस में से निकल जा!” वो उसी वक़्त निकल गई।<verse eid="ACT 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19"/>जब उस के मालिकों ने देखा कि हमारी कमाई की उम्मीद जाती रही तो पौलुस और सीलास को पकड़कर हाकिमों के पास चौक में खींच ले गए। <verse eid="ACT 16:19"/><verse number="20" style="v" sid="ACT 16:20"/>और उन्हें फ़ौजदारी के हाकिमों के आगे ले जा कर कहा कि ये आदमी जो यहूदी हैं हमारे शहर में बड़ी खलबली डालते हैं। <verse eid="ACT 16:20"/><verse number="21" style="v" sid="ACT 16:21"/>और “ऐसी रस्में बताते हैं, जिनको क़ुबूल करना और अमल में लाना हम रोमियों को पसन्द नहीं।”<verse eid="ACT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22"/>और आम लोग भी मुत्तफ़िक़ होकर उनकी मुख़ालिफ़त पर आमादा हुए, और फ़ौजदारी के हाकिमों ने उन के कपड़े फाड़कर उतार डाले और बेंत लगाने का हुक्म दिया <verse eid="ACT 16:22"/><verse number="23" style="v" sid="ACT 16:23"/>और बहुत से बेंत लगवाकर उन्हें क़ैद खाने में डाल दिया, और दरोग़ा को ताकीद की कि बड़ी होशियारी से उनकी निगहबानी करे। <verse eid="ACT 16:23"/><verse number="24" style="v" sid="ACT 16:24"/>उस ने ऐसा हुक्म पाकर उन्हें अन्दर के क़ैद खाने में डाल दिया, और उनके पाँव काठ में ठोंक दिए।<verse eid="ACT 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25"/>आधी रात के क़रीब पौलुस और सीलास दुआ कर रहे और ख़ुदा की हम्द के गीत गा रहे थे, और क़ैदी सुन रहे थे। <verse eid="ACT 16:25"/><verse number="26" style="v" sid="ACT 16:26"/>कि यकायक बड़ा भुन्चाल आया, यहाँ तक कि क़ैद खाने की नींव हिल गई और उसी वक़्त सब दरवाज़े खुल गए और सब की बेड़ियाँ खुल पड़ीं।<verse eid="ACT 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 16:27"/>और दरोग़ा जाग उठा, और क़ैद खाने के दरवाज़े खुले देखकर समझा कि क़ैदी भाग गए, पस, तलवार खींचकर अपने आप को मार डालना चाहा। <verse eid="ACT 16:27"/><verse number="28" style="v" sid="ACT 16:28"/>लेकिन पौलुस ने बड़ी आवाज़ से पुकार कर कहा “अपने को नुक़्सान न पहुँचा! क्यूँकि हम सब मौजूद हैं।”<verse eid="ACT 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29"/>वो चराग़ मँगवा कर अन्दर जा कूदा। और काँपता हुआ पौलुस और सीलास के आगे गिरा।<verse eid="ACT 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 16:30"/>और उन्हें बाहर ला कर कहा “ऐ साहिबो में क्या करूँ कि नजात पाऊँ?” <verse eid="ACT 16:30"/><verse number="31" style="v" sid="ACT 16:31"/>उन्होंने कहा, ख़ुदावन्द ईसा पर ईमान ला “तो तू और तेरा घराना नजात पाएगा।”<verse eid="ACT 16:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 16:32"/>और उन्हों ने उस को और उस के सब घरवालों को ख़ुदावन्द का कलाम सुनाया। <verse eid="ACT 16:32"/><verse number="33" style="v" sid="ACT 16:33"/>और उस ने रात को उसी वक़्त उन्हें ले जा कर उनके ज़ख़्म धोए और उसी वक़्त अपने सब लोगों के साथ बपतिस्मा लिया। <verse eid="ACT 16:33"/><verse number="34" style="v" sid="ACT 16:34"/>और उन्हें ऊपर घर में ले जा कर दस्तरख़्वान बिछाया, और अपने सारे घराने समेत ख़ुदा पर ईमान ला कर बड़ी ख़ुशी की।<verse eid="ACT 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35"/>जब दिन हुआ, तो फ़ौजदारी के हाकिमों ने हवालदारों के ज़रिए कहला भेजा कि उन आदमियों को छोड़ दे। <verse eid="ACT 16:35"/><verse number="36" style="v" sid="ACT 16:36"/>और दरोग़ा ने पौलुस को इस बात की ख़बर दी कि फ़ौजदारी के हाकिमों ने तुम्हारे छोड़ देने का हुक्म भेज दिया है “पस अब निकल कर सलामत चले जाओ।”<verse eid="ACT 16:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37"/>मगर पौलुस ने उससे कहा, उन्होंने हम को जो रोमी<note caller="+" style="f"><char style="fr" closed="false">16:37 </char><char style="fq" closed="false">रोमी </char><char style="ft" closed="false">रोमी दौरे हुकूमत में वो लोग ओ रोमी नहीं थे मगर वहाँ रहते थे उन्हें भी शाहियात का शरफ़ हासिल था </char></note> हैं क़ुसूर साबित किए बग़ैर “ऐलानिया पिटवाकर क़ैद में डाला। और अब हम को चुपके से निकालते हैं? ये नहीं हो सकता; बल्कि वो आप आकर हमें बाहर ले जाएँ।” <verse eid="ACT 16:37"/><verse number="38" style="v" sid="ACT 16:38"/>हवालदारों ने फ़ौजदारी के हाकिमों को इन बातों की ख़बर दी। जब उन्हों ने सुना कि ये रोमी हैं तो डर गए। <verse eid="ACT 16:38"/><verse number="39" style="v" sid="ACT 16:39"/>और आकर उन की मिन्नत की और बाहर ले जाकर दरख़्वास्त की कि शहर से चले जाएँ।<verse eid="ACT 16:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 16:40"/>पस वो क़ैद खाने से निकल कर लुदिया के यहाँ गए और भाइयों से मिलकर उन्हें तसल्ली दी। और रवाना हुए।<verse eid="ACT 16:40"/></para>
  <chapter eid="ACT 16"/>
  <chapter number="17" style="c" sid="ACT 17"/>
  <para style="s">पौलुस का थिस्सलुनीकियों के शहर में तलकीन करना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1"/>फिर वो अम्फ़िपुलिस और अपुल्लोनिया होकर थिस्सलुनीकियों शहर में आए, जहाँ यहूदियों का इबादतख़ाना था। <verse eid="ACT 17:1"/><verse number="2" style="v" sid="ACT 17:2"/>और पौलुस अपने दस्तूर के मुवाफ़िक़ उनके पास गया, और तीन सबतों को किताब — ए — मुक़द्दस से उनके साथ बहस की।<verse eid="ACT 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 17:3"/>और उनके मतलब खोल खोलकर दलीलें पेश करता था, कि मसीह को दुःख उठाना और मुर्दों में से जी उठना ज़रूर था और ईसा जिसकी मैं तुम्हें ख़बर देता हूँ मसीह है। <verse eid="ACT 17:3"/><verse number="4" style="v" sid="ACT 17:4"/>उनमें से कुछ ने मान लिया और पौलुस और सीलास के शरीक हुए और ख़ुदा परस्त यूनानियों की एक बड़ी जमा'अत और बहुत सी शरीफ़ औरतें<note caller="+" style="f"><char style="fr" closed="false">17:4 </char><char style="fq" closed="false">शरीफ़ औरतें </char><char style="ft" closed="false">ये हाकिमों की बीवियाँ थी </char></note> भी उन की शरीक हुईं।<verse eid="ACT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5"/>मगर यहूदियों ने हसद में आकर बाज़ारी आदमियों में से कई बदमाशों को अपने साथ लिया और भीड़ लगा कर शहर में फ़साद करने लगे। और यासोन का घर घेरकर उन्हें लोगों के सामने लाना चाहा। <verse eid="ACT 17:5"/><verse number="6" style="v" sid="ACT 17:6"/>और जब उन्हें न पाया तो यासोन और कई और भाइयों को शहर के हाकिमों के पास चिल्लाते हुए खींच ले गए कि वो शख़्स जिन्हों ने जहान को बा'ग़ी कर दिया, यहाँ भी आए हैं।<verse eid="ACT 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 17:7"/>और यासोन ने उन्हें अपने यहाँ उतारा है और ये सब के सब क़ैसर के अहकाम की मुख़ालिफ़त करके कहते हैं, कि बादशाह तो और ही है या'नी ईसा, <verse eid="ACT 17:7"/><verse number="8" style="v" sid="ACT 17:8"/>ये सुन कर आम लोग और शहर के हाकिम घबरा गए। <verse eid="ACT 17:8"/><verse number="9" style="v" sid="ACT 17:9"/>और उन्हों ने यासोन और बाक़ियों की ज़मानत लेकर उन्हें छोड़ दिया।<verse eid="ACT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10"/>लेकिन भाइयों ने फ़ौरन रातों रात पौलुस और सीलास को बिरिया क़स्बा में भेज दिया, वो वहाँ पहुँचकर यहूदियों के इबादतख़ाने में गए। <verse eid="ACT 17:10"/><verse number="11" style="v" sid="ACT 17:11"/>ये लोग थिस्सलुनीकियों के यहूदियों से नेक ज़ात थे, क्यूँकि उन्हों ने बड़े शौक़ से कलाम को क़ुबूल किया और रोज़ — ब — रोज़ किताब ऐ मुक़द्दस में तहक़ीक़ करते थे, कि आया ये बातें इस तरह हैं? <verse eid="ACT 17:11"/><verse number="12" style="v" sid="ACT 17:12"/>पस, उन में से बहुत सारे ईमान लाए और यूनानियों में से भी बहुत सी 'इज़्ज़तदार 'औरतें और मर्द ईमान लाए।<verse eid="ACT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13"/>जब थिस्सलुनीकियों के यहूदियों को मा'लूम हुआ कि पौलुस बिरिया में भी ख़ुदा का कलाम सुनाता है, तो वहाँ भी जाकर लोगों को उभारा और उन में खलबली डाली। <verse eid="ACT 17:13"/><verse number="14" style="v" sid="ACT 17:14"/>उस वक़्त भाइयों ने फ़ौरन पौलुस को रवाना किया कि समुन्दर के किनारे तक चला जाए, लेकिन सीलास और तीमुथियुस वहीं रहे। <verse eid="ACT 17:14"/><verse number="15" style="v" sid="ACT 17:15"/>और पौलुस के रहबर उसे अथेने तक ले गए। और सीलास और तीमुथियुस के लिए ये हुक्म लेकर रवाना हुए। कि जहाँ तक हो सके जल्द मेरे पास आओ।<verse eid="ACT 17:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16"/>जब पौलुस अथेने में उन की राह देख रहा था, तो शहर को बुतों से भरा हुआ देख कर उस का जी जल गया। <verse eid="ACT 17:16"/><verse number="17" style="v" sid="ACT 17:17"/>इस लिए वो इबादतख़ाने में यहूदियों और ख़ुदा परस्तों से और चौक में जो मिलते थे, उन से रोज़ बहस किया करता था।<verse eid="ACT 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 17:18"/>और चन्द इपकूरी और स्तोइकी फ़ैलसूफ़ उसका मुक़ाबिला करने लगे कुछ ने कहा, ये बकवासी क्या कहना चाहता है? औरों ने कहा ये ग़ैर मा'बूदों की ख़बर देने वाला मा'लूम होता है इस लिए कि वो ईसा और क़यामत की ख़ुशख़बरी देता है।<verse eid="ACT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 17:19"/>पस, वो उसे अपने साथ अरियुपगुस जगह पर ले गए और कहा, आया हमको मा'लूम हो सकता है। कि ये नई ता'लीम जो तू देता है, क्या है? <verse eid="ACT 17:19"/><verse number="20" style="v" sid="ACT 17:20"/>क्यूँकि तू हमें अनोखी बातें सुनाता है पस, हम जानना चाहते हैं। कि इन से ग़रज़ क्या है, <verse eid="ACT 17:20"/><verse number="21" style="v" sid="ACT 17:21"/>(इस लिए कि सब अथेनवी और परदेसी जो वहाँ मुक़ीम थे, अपनी फ़ुरसत का वक़्त नई नई बातें करने सुनने के सिवा और किसी काम में सर्फ़ न करते थे)<verse eid="ACT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22"/>पौलुस ने अरियुपगुस के बीच में खड़े हो कर कहा।</para>
  <para style="p" vid="ACT 17:22">ऐ अथेने वालो, मैं देखता हूँ कि तुम हर बात में देवताओं के बड़े मानने वाले हो। <verse eid="ACT 17:22"/><verse number="23" style="v" sid="ACT 17:23"/>चुनाँचे मैंने सैर करते और तुम्हारे मा'बूदों पर ग़ौर करते वक़्त एक ऐसी क़ुर्बानगाह भी पाई, जिस पर लिखा था, ना मा'लूम ख़ुदा के लिए पस, जिसको तुम बग़ैर मा'लूम किए पूजते हो, मैं तुम को उसी की ख़बर देता हूँ।<verse eid="ACT 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 17:24"/>जिस ख़ुदा ने दुनिया और उस की सब चीज़ों को पैदा किया वो आसमान और ज़मीन का मालिक होकर हाथ के बनाए हुए मक़दिस में नहीं रहता। <verse eid="ACT 17:24"/><verse number="25" style="v" sid="ACT 17:25"/>न किसी चीज़ का मुहताज होकर आदमियों के हाथों से ख़िदमत लेता है। क्यूँकि वो तो ख़ुद सबको ज़िन्दगी और साँस और सब कुछ देता है।<verse eid="ACT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 17:26"/>और उस ने एक ही नस्ल से आदमियों की हर एक क़ौम तमाम रूए ज़मीन पर रहने के लिए पैदा की और उन की 'तहदाद और रहने की हदें मुक़र्रर कीं। <verse eid="ACT 17:26"/><verse number="27" style="v" sid="ACT 17:27"/>ताकि ख़ुदा को ढूँडें, शायद कि टटोलकर उसे पाएँ, हर वक़्त वो हम में से किसी से दूर नहीं।<verse eid="ACT 17:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 17:28"/>क्यूँकि उसी में हम जीते और चलते फिरते और मौजूद हैं, जैसा कि तुम्हारे शा'यरों में से भी कुछ ने कहा है।</para>
  <para style="p" vid="ACT 17:28">हम तो उस की नस्ल भी हैं। <verse eid="ACT 17:28"/><verse number="29" style="v" sid="ACT 17:29"/>पस, ख़ुदा की नस्ल होकर हम को ये ख़याल करना मुनासिब नहीं कि ज़ात — ए — इलाही उस सोने या रुपऐ या पत्थर की तरह है जो आदमियों के हुनर और ईजाद से गढ़े गए हों।<verse eid="ACT 17:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 17:30"/>पस, ख़ुदा जिहालत के वक़्तों से चश्म पोशी करके अब सब आदमियों को हर जगह हुक्म देता है। कि तौबा करें। <verse eid="ACT 17:30"/><verse number="31" style="v" sid="ACT 17:31"/>क्यूँकि उस ने एक दिन ठहराया है, जिस में वो रास्ती से दुनिया की अदालत उस आदमी<note caller="+" style="f"><char style="fr" closed="false">17:31 </char><char style="fq" closed="false">आदमी </char><char style="ft" closed="false">(ईसा) जो इंसान बना </char></note> के ज़रिए करेगा, जिसे उस ने मुक़र्रर किया है और उसे मुर्दों में से जिला कर ये बात सब पर साबित कर दी है।<verse eid="ACT 17:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32"/>जब उन्हों ने मुर्दों की क़यामत का ज़िक्र सुना तो कुछ ठठ्ठा मारने लगे, और कुछ ने कहा कि ये बात हम तुझ से फिर कभी सुनेंगे। <verse eid="ACT 17:32"/><verse number="33" style="v" sid="ACT 17:33"/>इसी हालत में पौलुस उनके बीच में से निकल गया <verse eid="ACT 17:33"/><verse number="34" style="v" sid="ACT 17:34"/>मगर कुछ आदमी उसके साथ मिल गए और ईमान ले आए, उन में दियुनुसियुस, अरियुपगुस, का एक हाकिम और दमरिस नाम की एक औरत थी, और कुछ और भी उन के साथ थे।<verse eid="ACT 17:34"/></para>
  <chapter eid="ACT 17"/>
  <chapter number="18" style="c" sid="ACT 18"/>
  <para style="s">पौलुस का कुरिन्थ में प्रिस्किल्ला और अक्विल्ला से मिलना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1"/>इन बातों के बाद पौलुस अथेने से रवाना हो कर कुरिन्थुस शहर में आया। <verse eid="ACT 18:1"/><verse number="2" style="v" sid="ACT 18:2"/>और वहाँ उसको अक्विला नाम का एक यहूदी मिला जो पुन्तुस शहर की पैदाइश था, और अपनी बीवी प्रिस्किल्ला समेत इतालिया से नया नया आया था; क्यूँकि क्लोदियुस ने हुक्म दिया था, कि सब यहूदी रोमा से निकल जाएँ। पस, वो उसके पास गया। <note caller="+" style="f"><char style="fr" closed="false">18:2 </char><char style="ft" closed="false">ये वाकया ईसा के सलीबी मौत के बाद 49 में हुआ </char></note> <verse eid="ACT 18:2"/><verse number="3" style="v" sid="ACT 18:3"/>और चूँकि उनका हम पेशा था, उन के साथ रहा और वो काम करने लगे; और उन का पेशा ख़ेमा दोज़ी था।<verse eid="ACT 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 18:4"/>और वो हर सबत को इबादतख़ाने में बहस करता और यहूदियों और यूनानियों को तैयार करता था। <verse eid="ACT 18:4"/><verse number="5" style="v" sid="ACT 18:5"/>और जब सीलास और तीमुथियुस मकिदुनिया से आए, तो पौलुस कलाम सुनाने के जोश से मजबूर हो कर यहूदियों के आगे गवाही दे रहा था कि ईसा ही मसीह है। <verse eid="ACT 18:5"/><verse number="6" style="v" sid="ACT 18:6"/>जब लोग मुख़ालिफ़त करने और कुफ़्र बकने लगे, तो उस ने अपने कपड़े झाड़ कर उन से कहा, तुम्हारा ख़ून तुम्हारी गर्दन पर मैं पाक हूँ, अब से ग़ैर क़ौमों के पास जाऊँगा।<verse eid="ACT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7"/>पस, वहाँ से चला गया, और तितुस युस्तुस नाम के एक ख़ुदा परस्त के घर चला गया, जो इबादतख़ाने से मिला हुआ था।<verse eid="ACT 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 18:8"/>और इबादतख़ाने का सरदार क्रिसपुस अपने तमाम घराने समेत ख़ुदावन्द पर ईमान लाया; और बहुत से कुरिन्थी सुनकर ईमान लाए, और बपतिस्मा लिया। <verse eid="ACT 18:8"/><verse number="9" style="v" sid="ACT 18:9"/>और ख़ुदावन्द ने रात को रोया में पौलुस से कहा, <char style="wj">“ख़ौफ़ न कर, बल्कि कहे जा और चुप न रह।</char> <verse eid="ACT 18:9"/><verse number="10" style="v" sid="ACT 18:10"/><char style="wj">इसलिए कि मैं तेरे साथ हूँ, और कोई शख़्स तुझ पर हमला कर के तकलीफ़ न पहुँचा सकेगा; क्यूँकि इस शहर में मेरे बहुत से लोग हैं।”</char> <verse eid="ACT 18:10"/><verse number="11" style="v" sid="ACT 18:11"/>पस, वो डेढ़ बरस उन में रहकर ख़ुदा का कलाम सिखाता रहा।<verse eid="ACT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12"/>जब गल्लियो अख़िया सूबे का सुबेदार था, यहूदी एका करके पौलुस पर चढ़ आए, और उसे अदालत में ले जा कर। <verse eid="ACT 18:12"/><verse number="13" style="v" sid="ACT 18:13"/>कहने लगे “कि ये शख़्स लोगों को तरग़ीब देता है, कि शरी'अत के बरख़िलाफ़ ख़ुदा की इबादत करें।”<verse eid="ACT 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14"/>जब पौलुस ने बोलना चाहा, तो गल्लियो ने यहूदियों से कहा, ऐ यहूदियो, अगर कुछ ज़ुल्म या बड़ी शरारत की बात होती तो वाजिब था, कि मैं सब्र करके तुम्हारी सुनता। <verse eid="ACT 18:14"/><verse number="15" style="v" sid="ACT 18:15"/>लेकिन जब ये ऐसे सवाल हैं जो लफ़्ज़ों और नामों और ख़ास तुम्हारी शरी'अत से तअ'ल्लुक रखते हैं तो तुम ही जानो। मैं ऐसी बातों का मुन्सिफ़ बनना नहीं चाहता।<verse eid="ACT 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 18:16"/>और उस ने उन्हें अदालत से निकला दिया। <verse eid="ACT 18:16"/><verse number="17" style="v" sid="ACT 18:17"/>फिर सब लोगों ने इबादतख़ाने के सरदार सोस्थिनेस को पकड़ कर अदालत के सामने मारा, मगर गल्लियो ने इन बातों की कुछ परवाह न की।<verse eid="ACT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18"/>पस, पौलुस बहुत दिन वहाँ रहकर भाइयों से रुख़्सत हुआ; चूँकि उस ने मन्नत मानी थी, इसलिए किन्ख़रिया शहर में सिर मुंडवाया और जहाज़ पर सूरिया सूबे को रवाना हुआ; और प्रिस्किल्ला और अक्विला उस के साथ थे। <verse eid="ACT 18:18"/><verse number="19" style="v" sid="ACT 18:19"/>और इफ़िसुस में पहुँच कर उस ने उन्हें वहाँ छोड़ा और आप इबादतख़ाने में जाकर यहूदियों से बहस करने लगा।<verse eid="ACT 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 18:20"/>जब उन्होंने उस से दरख़्वास्त की, और कुछ अरसे हमारे साथ रह तो उस ने मंज़ूर न किया। <verse eid="ACT 18:20"/><verse number="21" style="v" sid="ACT 18:21"/>बल्कि ये कह कर उन से रुख़्सत हुआ अगर ख़ुदा ने चाहा तो तुम्हारे पास फिर आऊँगा और इफ़िसुस से जहाज़ पर रवाना हुआ।<verse eid="ACT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22"/>फिर क़ैसरिया में उतर कर येरूशलेम को गया, और कलीसिया को सलाम करके अन्ताकिया में आया।<verse eid="ACT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 18:23"/>और चन्द रोज़ रह कर वहाँ से रवाना हुआ, और तरतीब वार ग़लतिया सूबे के इलाक़े और फ्रूगिया सूबे से गुज़रता हुआ सब शागिर्दों को मज़बूत करता गया।<verse eid="ACT 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24"/>फिर अपुल्लोस नाम के एक यहूदी इसकन्दरिया शहर की पैदाइश ख़ुशतक़रीर किताब — ए — मुक़द्दस का माहिर इफ़िसुस में पहुँचा। <verse eid="ACT 18:24"/><verse number="25" style="v" sid="ACT 18:25"/>इस शख़्स ने ख़ुदावन्द की राह की ता'लीम पाई थी, और रूहानी जोश से कलाम करता और ईसा की वजह से सहीह सहीह ता'लीम देता था। मगर सिर्फ़ यूहन्ना के बपतिस्मे से वाक़िफ़ था। <verse eid="ACT 18:25"/><verse number="26" style="v" sid="ACT 18:26"/>वो इबादतख़ाने में दिलेरी से बोलने लगा, मगर प्रिस्किल्ला और अक्विला उसकी बातें सुनकर उसे अपने घर ले गए। और उसको ख़ुदा की राह और अच्छी तरह से बताई।<verse eid="ACT 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27"/>जब उस ने इरादा किया कि पार उतर कर अख़िया को जाए तो भाइयों ने उसकी हिम्मत बढ़ाकर शागिर्दों को लिखा कि उससे अच्छी तरह मिलना। उस ने वहाँ पहुँचकर उन लोगों की बड़ी मदद की जो फ़ज़ल की वजह से ईमान लाए थे। <verse eid="ACT 18:27"/><verse number="28" style="v" sid="ACT 18:28"/>क्यूँकि वो किताब — ए — मुक़द्दस से ईसा का मसीह होना साबित करके बड़े ज़ोर शोर से यहूदियों को ऐलानिया क़ायल करता रहा।<verse eid="ACT 18:28"/></para>
  <chapter eid="ACT 18"/>
  <chapter number="19" style="c" sid="ACT 19"/>
  <para style="s">पौलुस का तिसरा सफ़र</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1"/>और जब अपुल्लोस कुरिन्थुस में था, तो ऐसा हुआ कि पौलुस ऊपर के पहाड़ी मुल्कों से गुज़र कर इफ़िसुस में आया और कई शागिर्दों को देखकर। <verse eid="ACT 19:1"/><verse number="2" style="v" sid="ACT 19:2"/>उन से कहा “क्या तुमने ईमान लाते वक़्त रूह — उल — क़ुद्दूस पाया?” उन्हों ने उस से कहा “कि हम ने तो सुना नहीं। कि रूह — उल — क़ुद्दूस नाज़िल हुआ है।”<verse eid="ACT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3"/>उस ने कहा “तुम ने किस का बपतिस्मा लिया?” उन्हों ने कहा “यूहन्ना का बपतिस्मा।” <verse eid="ACT 19:3"/><verse number="4" style="v" sid="ACT 19:4"/>पौलुस ने कहा, यूहन्ना ने लोगों को ये कह कर तौबा का बपतिस्मा दिया कि जो मेरे पीछे आने वाला है उस पर या'नी ईसा पर ईमान लाना।<verse eid="ACT 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5"/>उन्हों ने ये सुनकर ख़ुदावन्द ईसा के नाम का बपतिस्मा लिया। <verse eid="ACT 19:5"/><verse number="6" style="v" sid="ACT 19:6"/>जब पौलुस ने अपने हाथ उन पर रखे तो रूह — उल — क़ुद्दूस उन पर नाज़िल हुआ, और वह तरह तरह की ज़बाने बोलने और नबुव्वत करने लगे। <verse eid="ACT 19:6"/><verse number="7" style="v" sid="ACT 19:7"/>और वो सब तक़रीबन बारह आदमी थे।<verse eid="ACT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8"/>फिर वो इबादतख़ाने में जाकर तीन महीने तक दिलेरी से बोलता और ख़ुदा की बादशाही के बारे में बहस करता और लोगों को क़ायल करता रहा। <verse eid="ACT 19:8"/><verse number="9" style="v" sid="ACT 19:9"/>लेकिन जब कुछ सख़्त दिल और नाफ़रमान हो गए। बल्कि लोगों के सामने इस तरीक़े को बुरा कहने लगे, तो उस ने उन से किनारा करके शागिर्दों को अलग कर लिया, और हर रोज़ तुरन्नुस के मदरसे में बहस किया करता था। <verse eid="ACT 19:9"/><verse number="10" style="v" sid="ACT 19:10"/>दो बरस तक यही होता रहा, यहाँ तक कि आसिया के रहने वालों क्या यहूदी क्या यूनानी सब ने ख़ुदावन्द का कलाम सुना।<verse eid="ACT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11"/>और ख़ुदा पौलुस के हाथों से ख़ास ख़ास मोजिज़े दिखाता था। <verse eid="ACT 19:11"/><verse number="12" style="v" sid="ACT 19:12"/>यहाँ तक कि रूमाल और पटके उसके बदन से छुआ कर बीमारों पर डाले जाते थे, और उन की बीमारियाँ जाती रहती थीं, और बदरूहें उन में से निकल जाती थीं।<verse eid="ACT 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13"/>मगर कुछ यहूदियों ने जो झाड़ फूँक करते फिरते थे। ये इख़्तियार किया कि जिन में बदरूहें हों “उन पर ख़ुदावन्द ईसा का नाम ये कह कर फूँकें। कि जिस ईसा की पौलुस ऐलान करता है, मैं तुम को उसकी क़सम देता हूँ” <verse eid="ACT 19:13"/><verse number="14" style="v" sid="ACT 19:14"/>और सिकवा, यहूदी सरदार काहिन, के सात बेटे ऐसा किया करते थे।<verse eid="ACT 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15"/>बदरूह ने जवाब में उन से कहा, ईसा को तो मै जानती हूँ, और पौलुस से भी वाक़िफ़ हूँ “मगर तुम कौन हो?” <verse eid="ACT 19:15"/><verse number="16" style="v" sid="ACT 19:16"/>और वो शख़्स जिस में बदरूह थी, कूद कर उन पर जा पड़ा और दोनों पर ग़ालिब आकर ऐसी ज़्यादती की कि वो नंगे और ज़ख़्मी होकर उस घर से निकल भागे। <verse eid="ACT 19:16"/><verse number="17" style="v" sid="ACT 19:17"/>और ये बात इफ़िसुस के सब रहने वाले यहूदियों और यूनानियों को मा'लूम हो गई। पस, सब पर ख़ौफ़ छा गया, और ख़ुदावन्द ईसा के नाम की बड़ाई हुई।<verse eid="ACT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 19:18"/>और जो ईमान लाए थे, उन में से बहुतों ने आकर अपने अपने कामों का इक़रार और इज़हार किया। <verse eid="ACT 19:18"/><verse number="19" style="v" sid="ACT 19:19"/>और बहुत से जादूगरों ने अपनी अपनी किताबें इकट्ठी करके सब लोगों के सामने जला दीं, जब उन की क़ीमत का हिसाब हुआ तो पचास हज़ार रुपऐ की निकली। <verse eid="ACT 19:19"/><verse number="20" style="v" sid="ACT 19:20"/>इसी तरह ख़ुदा का कलाम ज़ोर पकड़ कर फैलता और ग़ालिब होता गया।<verse eid="ACT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21"/>जब ये हो चुका तो पौलुस ने पाक रूह में हिम्मत पाई कि मकिदुनिया और अख़िया से हो कर येरूशलेम को जाऊँगा। और कहा, “वहाँ जाने के बाद मुझे रोमा भी देखना ज़रूर है।”<verse eid="ACT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 19:22"/>पस, अपने ख़िदमतगुज़ारों में से दो शख़्स या'नी तीमुथियुस और इरास्तुस को मकिदुनिया में भेजकर आप कुछ अर्सा, आसिया में रहा।<verse eid="ACT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23"/>उस वक़्त इस तरीक़े की वजह से बड़ा फ़साद हुआ। <verse eid="ACT 19:23"/><verse number="24" style="v" sid="ACT 19:24"/>क्यूँकि देमेत्रियुस नाम एक सुनार था, जो अरतमिस कि रूपहले मन्दिर बनवा कर उस पेशेवालों को बहुत काम दिलवा देता था। <verse eid="ACT 19:24"/><verse number="25" style="v" sid="ACT 19:25"/>उस ने उन को और उनके मुता'ल्लिक़ और पेशेवालों को जमा कर के कहा, ऐ लोगों! तुम जानते हो कि हमारी आसूदगी इसी काम की बदौलत है। <verse eid="ACT 19:25"/><verse number="26" style="v" sid="ACT 19:26"/>तुम देखते और सुनते हो कि सिर्फ़ इफ़िसुस ही में नहीं बल्कि तक़रीबन तमाम आसिया में इस पौलुस ने बहुत से लोगों को ये कह कर समझा बुझा कर और गुमराह कर दिया है, कि हाथ के बनाए हुए हैं, ख़ुदा “नहीं हैं। <verse eid="ACT 19:26"/><verse number="27" style="v" sid="ACT 19:27"/>पस, सिर्फ़ यही ख़तरा नहीं कि हमारा पेशा बेक़द्र हो जाएगा, बल्कि बड़ी देवी अरतमिस का मन्दिर भी नाचीज़ हो जाएगा, और जिसे तमाम आसिया और सारी दुनिया पूजती है, ख़ुद उसकी अज़मत भी जाती रहेगी।”<verse eid="ACT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28"/>वो ये सुन कर क़हर से भर गए और चिल्ला चिल्ला कर कहने लगे, कि इफ़िसियों की अरतमिस बड़ी है! <verse eid="ACT 19:28"/><verse number="29" style="v" sid="ACT 19:29"/>और तमाम शहर में हलचल पड़ गई, और लोगों ने गयुस और अरिस्तरख़ुस मकिदुनिया वालों को जो पौलुस के हम — सफ़र थे, पकड़ लिया और एक दिल हो कर तमाशा गाह को दौड़े।<verse eid="ACT 19:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 19:30"/>जब पौलुस ने मज्मे में जाना चाहा तो शागिर्दों ने जाने न दिया। <verse eid="ACT 19:30"/><verse number="31" style="v" sid="ACT 19:31"/>और आसिया के हाकिमों में से उस के कुछ दोस्तों ने आदमी भेजकर उसकी मिन्नत की कि तमाशा गाह में जाने की हिम्मत न करना। <verse eid="ACT 19:31"/><verse number="32" style="v" sid="ACT 19:32"/>और कुछ चिल्लाए और मजलिस दरहम बरहम हो गई थी, और अक्सर लोगों को ये भी ख़बर न थी, कि हम किस लिए इकटठे हुए हैं।<verse eid="ACT 19:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 19:33"/>फिर उन्हों ने इस्कन्दर को जिसे यहूदी पेश करते थे, भीड़ में से निकाल कर आगे कर दिया, और इस्कन्दर ने हाथ से इशारा करके मज्मे कि सामने उज़्र बयान करना चाहा।<verse eid="ACT 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 19:34"/>जब उन्हें मा'लूम हुआ कि ये यहूदी है, तो सब हम आवाज़ होकर कोई दो घंटे तक चिल्लाते रहे “कि इफ़िसियों की अरतमिस बड़ी है!” <verse eid="ACT 19:34"/><verse number="35" style="v" sid="ACT 19:35"/>फिर शहर के मुहर्रिर ने लोगों को ठन्डा करके कहा, ऐ इफ़िसियो! कौन सा आदमी नहीं जानता कि इफ़िसियों का शहर बड़ी देवी अरतमिस के मन्दिर और उस मूरत का मुहाफ़िज़ है, जो ज़्यूस की तरफ़ से गिरी थी। <verse eid="ACT 19:35"/><verse number="36" style="v" sid="ACT 19:36"/>पस, जब कोई इन बातों के ख़िलाफ़ नहीं कह सकता तो वाजिब है कि तुम इत्मीनान से रहो, और बे सोचे कुछ न करो। <verse eid="ACT 19:36"/><verse number="37" style="v" sid="ACT 19:37"/>क्यूँकि ये लोग जिन को तुम यहाँ लाए हो न मन्दिर को लूटने वाले हैं, न हमारी देवी की बदगोई करनेवाले।<verse eid="ACT 19:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 19:38"/>पस, अगर देमेत्रियुस और उसके हम पेशा किसी पर दा'वा रखते हों तो अदालत खुली है, और सुबेदार मौजूद हैं, एक दूसरे पर नालिश करें। <verse eid="ACT 19:38"/><verse number="39" style="v" sid="ACT 19:39"/>और अगर तुम किसी और काम की तहक़ीक़ात चाहते हो तो बाज़ाब्ता मजलिस में फ़ैसला होगा। <verse eid="ACT 19:39"/><verse number="40" style="v" sid="ACT 19:40"/>क्यूँकि आज के बवाल की वजह से हमें अपने ऊपर नालिश होने का अन्देशा है, इसलिए कि इसकी कोई वजह नहीं है, और इस सूरत में हम इस हँगामे की जवाबदेही न कर सकेंगे। <verse eid="ACT 19:40"/><verse number="41" style="v" sid="ACT 19:41"/>ये कह कर उसने मजलिस को बरख़ास्त किया।<verse eid="ACT 19:41"/></para>
  <chapter eid="ACT 19"/>
  <chapter number="20" style="c" sid="ACT 20"/>
  <para style="s">पौलुस का मकिदुनिया को जाना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1"/>जब बवाल कम हो गया तो पौलुस ने ईमानदारों को बुलवा कर नसीहत की, और उन से रुख़्सत हो कर मकिदुनिया को रवाना हुआ। <verse eid="ACT 20:1"/><verse number="2" style="v" sid="ACT 20:2"/>और उस इलाक़े से गुज़र कर और उन्हें बहुत नसीहत करके यूनान में आया। <verse eid="ACT 20:2"/><verse number="3" style="v" sid="ACT 20:3"/>जब तीन महीने रह कर सूरिया की तरफ़ जहाज़ पर रवाना होने को था, तो यहूदियों ने उस के बरख़िलाफ़ साज़िश की, फिर उसकी ये सलाह हुई कि मकिदुनिया होकर वापस जाए।<verse eid="ACT 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 20:4"/>और पुरुस का बेटा सोपत्रुस जो बिरिया कसबे का था, और थिस्सलुनीकियों में से अरिस्तरख़ुस और सिकुन्दुस और गयुस जो दिरबे शहर का था, और तीमुथियुस और आसिया का तुख़िकुस और त्रुफ़िमुस आसिया तक उसके साथ गए। <verse eid="ACT 20:4"/><verse number="5" style="v" sid="ACT 20:5"/>ये आगे जा कर त्रोआस में हमारी राह देखते रहे। <verse eid="ACT 20:5"/><verse number="6" style="v" sid="ACT 20:6"/>और ईद — ए — फ़तीर के दिनों के बाद हम फ़िलिप्पी से जहाज़ पर रवाना होकर पाँच दिन के बाद त्रोआस में उन के पास पहुँचे और सात दिन वहीं रहे।<verse eid="ACT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7"/>सबत की शाम जब हम रोटी तोड़ने के लिए जमा हुए, तो पौलुस ने दूसरे दिन रवाना होने का इरादा करके उन से बातें कीं और आधी रात तक कलाम करता रहा। <verse eid="ACT 20:7"/><verse number="8" style="v" sid="ACT 20:8"/>जिस बालाख़ाने पर हम जमा थे, उस में बहुत से चराग़ जल रहे थे।<verse eid="ACT 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 20:9"/>और यूतुख़ुस नाम एक जवान खिड़की में बैठा था, उस पर नींद का बड़ा ग़ल्बा था, और जब पौलुस ज़्यादा देर तक बातें करता रहा तो वो नींद के ग़ल्बे में तीसरी मंज़िल से गिर पड़ा, और उठाया गया तो मुर्दा था। <verse eid="ACT 20:9"/><verse number="10" style="v" sid="ACT 20:10"/>पौलुस उतर कर उस से लिपट गया, और गले लगा कर कहा, घबराओ नहीं इस में जान है।<verse eid="ACT 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 20:11"/>फिर ऊपर जा कर रोटी तोड़ी और खा कर इतनी देर तक बातें करता रहा कि सुबह हो गई, फिर वो रवाना हो गया।<verse eid="ACT 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 20:12"/>और वो उस लड़के को ज़िंदा लाए और उनको बड़ा इत्मीनान हुआ।<verse eid="ACT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13"/>हम जहाज़ तक आगे जाकर इस इरादा से अस्सुस शहर को रवाना हुए कि वहाँ पहुँच कर पौलुस को चढ़ा लें, क्यूँकि उस ने पैदल जाने का इरादा करके यही तज्वीज़ की थी। <verse eid="ACT 20:13"/><verse number="14" style="v" sid="ACT 20:14"/>पस, जब वो अस्सुस में हमें मिला तो हम उसे चढ़ा कर मितुलेने शहर में आए।<verse eid="ACT 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 20:15"/>वहाँ से जहाज़ पर रवाना होकर दूसरे दिन ख़ियुस टापू के सामने पहुँचे और तीसरे दिन सामुस टापू तक आए और अगले दिन मिलेतुस शहर में आ गए। <verse eid="ACT 20:15"/><verse number="16" style="v" sid="ACT 20:16"/>क्यूँकि पौलुस ने ये ठान लिया था, कि इफ़िसुस के पास से गुज़रे, ऐसा न हो कि उसे आसिया में देर लगे; इसलिए कि वो जल्दी करता था, कि अगर हो सके तो पिन्तेकुस्त के दिन येरूशलेम में हो।<verse eid="ACT 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17"/>और उस ने मिलेतुस से इफ़िसुस में कहला भेजा, और कलीसिया के बुज़ुर्गों को बुलाया। <verse eid="ACT 20:17"/><verse number="18" style="v" sid="ACT 20:18"/>जब वो उस के पास आए तो उन से कहा,</para>
  <para style="p" vid="ACT 20:18">तुम ख़ुद जानते हो कि पहले ही दिन से कि मैंने आसिया में क़दम रख्खा हर वक़्त तुम्हारे साथ किस तरह रहा। <verse eid="ACT 20:18"/><verse number="19" style="v" sid="ACT 20:19"/>या'नी कमाल फ़रोतनी से और आँसू बहा बहा कर और उन आज़माइशों में जो यहूदियों की साज़िश की वजह से मुझ पर वा'के हुई ख़ुदावन्द की ख़िदमत करता रहा। <verse eid="ACT 20:19"/><verse number="20" style="v" sid="ACT 20:20"/>और जो जो बातें तुम्हारे फ़ाइदे की थीं उनके बयान करने और एलानिया और घर घर सिखाने से कभी न झिझका। <verse eid="ACT 20:20"/><verse number="21" style="v" sid="ACT 20:21"/>बल्कि यहूदियों और यूनानियों के रू — ब — रू गवाही देता रहा कि ख़ुदा के सामने तौबा करना और हमारे ख़ुदावन्द ईसा मसीह पर ईमान लाना चाहिए।<verse eid="ACT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22"/>और अब देखो में रूह में बँधा हुआ येरूशलेम को जाता हूँ, और न मा'लूम कि वहाँ मुझ पर क्या क्या गुज़रे। <verse eid="ACT 20:22"/><verse number="23" style="v" sid="ACT 20:23"/>सिवा इसके कि रूह — उल — क़ुद्दूस हर शहर में गवाही दे दे कर मुझ से कहता है। कि क़ैद और मुसीबतें तेरे लिए तैयार हैं। <verse eid="ACT 20:23"/><verse number="24" style="v" sid="ACT 20:24"/>लेकिन मैं अपनी जान को अज़ीज़ नहीं समझता कि उस की कुछ क़द्र करूँ; बावजूद इसके कि अपना दौर और वो ख़िदमत जो ख़ुदावन्द ईसा से पाई है, पूरी करूँ। या'नी ख़ुदा के फ़ज़ल की ख़ुशख़बरी की गवाही दूँ।<verse eid="ACT 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25"/>और अब देखो मैं जानता हूँ कि तुम सब जिनके दर्मियान मैं बादशाही का एलान करता फिरा, मेरा मुँह फिर न देखोगे। <verse eid="ACT 20:25"/><verse number="26" style="v" sid="ACT 20:26"/>पस, मैं आज के दिन तुम्हें क़तई कहता हूँ कि सब आदमियों के ख़ून से पाक हूँ। <verse eid="ACT 20:26"/><verse number="27" style="v" sid="ACT 20:27"/>क्यूँकि मैं ख़ुदा की सारी मर्ज़ी तुम से पूरे तौर से बयान करने से न झिझका। <verse eid="ACT 20:27"/><verse number="28" style="v" sid="ACT 20:28"/>पस, अपनी और उस सारे गल्ले की ख़बरदारी करो जिसका रूह — उल क़ुद्दूस ने तुम्हें निगहबान ठहराया ताकि ख़ुदा की कलीसिया की गल्ले कि रख वाली करो, जिसे उस ने ख़ास अपने ख़ून से ख़रीद लिया। <verse eid="ACT 20:28"/><verse number="29" style="v" sid="ACT 20:29"/>मैं ये जानता हूँ कि मेरे जाने के बाद फाड़ने वाले भेड़िये तुम में आएंगे जिन्हें गल्ले पर कुछ तरस न आएगा; <verse eid="ACT 20:29"/><verse number="30" style="v" sid="ACT 20:30"/>आप के बीच से भी आदमी उठ कर सच्चाई को तोड़ — मरोड़ कर बयान करेंगे ताकि शागिर्दों को अपने पीछे लगा लें।<verse eid="ACT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 20:31"/>इसलिए जागते रहो, और याद रखो कि मैं तीन बरस तक रात दिन आँसू बहा बहा कर हर एक को समझाने से बा'ज़ न आया। <verse eid="ACT 20:31"/><verse number="32" style="v" sid="ACT 20:32"/>अब मैं तुम्हें ख़ुदा और उसके फ़ज़ल के कलाम के सुपुर्द करता हूँ, जो तुम्हारी तरक़्क़ी कर सकता है, और तमाम मुक़द्दसों में शरीक करके मीरास दे सकता है।<verse eid="ACT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 20:33"/>मैंने किसी के पैसे या कपड़े का लालच नहीं किया। <verse eid="ACT 20:33"/><verse number="34" style="v" sid="ACT 20:34"/>तुम आप जानते हो कि इन्हीं हाथों ने मेरी और मेरे साथियों की हाजतपूरी कीं। <verse eid="ACT 20:34"/><verse number="35" style="v" sid="ACT 20:35"/>मैंने तुम को सब बातें करके दिखा दीं कि इस तरह मेहनत करके कमज़ोरों को संभालना और ख़ुदावन्द ईसा की बातें याद रखना चाहिए, उस ने ख़ुद कहा, <char style="wj">“देना लेने से मुबारिक़ है।”</char><verse eid="ACT 20:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36"/>उस ने ये कह कर घुटने टेके और उन सब के साथ दुआ की। <verse eid="ACT 20:36"/><verse number="37" style="v" sid="ACT 20:37"/>और वो सब बहुत रोए और पौलुस के गले लग लगकर उसके बोसे लिए। <verse eid="ACT 20:37"/><verse number="38" style="v" sid="ACT 20:38"/>और ख़ास कर इस बात पर ग़मगीन थे, जो उस ने कही थी, कि तुम फिर मेरा मुँह न देखोगे फिर उसे जहाज़ तक पहुँचाया।<verse eid="ACT 20:38"/></para>
  <chapter eid="ACT 20"/>
  <chapter number="21" style="c" sid="ACT 21"/>
  <para style="s">पौलुस का यरुशलेम को जाना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1"/>जब हम उनसे बमुश्किल जुदा हो कर जहाज़ पर रवाना हुए, तो ऐसा हुआ की सीधी राह से कोस टापू में आए, और दूसरे दिन रूदुस में, और वहाँ से पतरा शहर में। <verse eid="ACT 21:1"/><verse number="2" style="v" sid="ACT 21:2"/>फिर एक जहाज़ सीधा फ़ीनिके को जाता हुआ मिला, और उस पर सवार होकर रवाना हुए।<verse eid="ACT 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 21:3"/>जब कुप्रुस शहर नज़र आया तो उसे बाएँ हाथ छोड़कर सुरिया को चले, और सूर शहर में उतरे, क्यूँकि वहाँ जहाज़ का माल उतारना था। <verse eid="ACT 21:3"/><verse number="4" style="v" sid="ACT 21:4"/>जब शागिर्दों को तलाश कर लिया तो हम सात रोज़ वहाँ रहे; उन्हों ने रूह के ज़रिए पौलुस से कहा, कि येरूशलेम में क़दम न रखना।<verse eid="ACT 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 21:5"/>और जब वो दिन गुज़र गए, तो ऐसा हुआ कि हम निकल कर रवाना हुए, और सब ने बीवियों बच्चों समेत हम को शहर से बाहर तक पहुँचाया। फिर हम ने समुन्दर के किनारे घुटने टेककर दुआ की। <verse eid="ACT 21:5"/><verse number="6" style="v" sid="ACT 21:6"/>और एक दूसरे से विदा होकर हम तो जहाज़ पर चढ़े, और वो अपने अपने घर वापस चले गए।<verse eid="ACT 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7"/>और हम सूर से जहाज़ का सफ़र पूरा कर के पतुलिमयिस सूबा में पहुँचे, और भाइयों को सलाम किया, और एक दिन उनके साथ रहे। <verse eid="ACT 21:7"/><verse number="8" style="v" sid="ACT 21:8"/>दूसरे दिन हम रवाना होकर क़ैसरिया में आए, और फ़िलिप्पुस मुबश्शिर के घर जो उन सातों में से था, उतर कर उसके साथ रहे, <verse eid="ACT 21:8"/><verse number="9" style="v" sid="ACT 21:9"/>उस की चार कुँवारी बेटियाँ थीं, जो नबुव्वत करती थीं।<verse eid="ACT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10"/>जब हम वहाँ बहुत रोज़ रहे, तो अगबुस नाम एक नबी यहूदिया से आया। <verse eid="ACT 21:10"/><verse number="11" style="v" sid="ACT 21:11"/>उस ने हमारे पास आकर पौलुस का कमरबन्द लिया और अपने हाथ पाँव बाँध कर कहा, रूह — उल — क़ुद्दूस यूँ फ़रमाता है “कि जिस शख़्स का ये कमरबन्द है उस को यहूदी येरूशलेम में इसी तरह बाँधेगे और ग़ैर क़ौमों के हाथ में सुपुर्द करेंगे।”<verse eid="ACT 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12"/>जब ये सुना तो हम ने और वहाँ के लोगों ने उस की मिन्नत की, कि येरूशलेम को न जाए। <verse eid="ACT 21:12"/><verse number="13" style="v" sid="ACT 21:13"/>मगर पौलुस ने जवाब दिया, कि तुम क्या करते हो? क्यूँ रो रो कर मेरा दिल तोड़ते हो? में तो येरूशलेम में ख़ुदावन्द ईसा मसीह “के नाम पर न सिर्फ़ बाँधे जाने बल्कि मरने को भी तैयार हूँ।” <verse eid="ACT 21:13"/><verse number="14" style="v" sid="ACT 21:14"/>जब उस ने न माना तो हम ये कह कर चुप हो गए “कि ख़ुदावन्द की मर्ज़ी पूरी हो।”<verse eid="ACT 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15"/>उन दिनों के बाद हम अपने सफ़र का सामान तैयार करके येरूशलेम को गए। <verse eid="ACT 21:15"/><verse number="16" style="v" sid="ACT 21:16"/>और क़ैसरिया से भी कुछ शागिर्द हमारे साथ चले और एक पुराने शागिर्द मनासोन कुप्रीस के रहने वाले को साथ ले आए, ताकि हम उस के मेहमान हों।<verse eid="ACT 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17"/>जब हम येरूशलेम में पहुँचे तो ईमानदार भाई बड़ी ख़ुशी के साथ हम से मिले। <verse eid="ACT 21:17"/><verse number="18" style="v" sid="ACT 21:18"/>और दूसरे दिन पौलुस हमारे साथ या'क़ूब के पास गया, और सब बुज़ुर्ग वहाँ हाज़िर थे। <verse eid="ACT 21:18"/><verse number="19" style="v" sid="ACT 21:19"/>उस ने उन्हें सलाम करके जो कुछ ख़ुदा ने उस की ख़िदमत से ग़ैर क़ौमों में किया था, एक एक कर के बयान किया।<verse eid="ACT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20"/>उन्होंने ये सुन कर ख़ुदा की तारीफ़ की फिर उस से कहा, ऐ भाई तू देखता है, कि यहूदियों में हज़ारों आदमी ईमान ले आए हैं, और वो सब शरी'अत के बारे में सरगर्म हैं। <verse eid="ACT 21:20"/><verse number="21" style="v" sid="ACT 21:21"/>और उन को तेरे बारे में सिखा दिया गया है, कि तू ग़ैर क़ौमों में रहने वाले सब यहूदियों को ये कह कर मूसा से फिर जाने की ता'लीम देता है, कि न अपने लड़कों का ख़तना करो न मूसा की रस्मों पर चलो।<verse eid="ACT 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 21:22"/>पस, क्या किया जाए? लोग ज़रूर सुनेंगे, कि तू आया है। <verse eid="ACT 21:22"/><verse number="23" style="v" sid="ACT 21:23"/>इसलिए जो हम तुझ से कहते हैं वो कर; हमारे यहाँ चार आदमी ऐसे हैं, जिन्हों ने मन्नत मानी है। <verse eid="ACT 21:23"/><verse number="24" style="v" sid="ACT 21:24"/>उन्हें ले कर अपने आपको उन के साथ पाक कर और उनकी तरफ़ से कुछ ख़र्च कर, ताकि वो सिर मुंडाएँ, तो सब जान लेंगे कि जो बातें उन्हें तेरे बारे में सिखाई गई हैं, उन की कुछ असल नहीं बल्कि तू ख़ुद भी शरी'अत पर अमल करके दुरुस्ती से चलता है।<verse eid="ACT 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 21:25"/>मगर ग़ैर क़ौमों में से जो ईमान लाए उनके बारे में हम ने ये फ़ैसला करके लिखा था, कि वो सिर्फ़ बुतों की क़ुर्बानी के गोश्त से और लहू और गला घोंटे हुए जानवरों और हरामकारी से अपने आप को बचाए रखें। <verse eid="ACT 21:25"/><verse number="26" style="v" sid="ACT 21:26"/>इस पर पौलुस उन आदमियों को लेकर और दूसरे दिन अपने आपको उनके साथ पाक करके हैकल में दाख़िल हुआ और ख़बर दी कि जब तक हम में से हर एक की नज़्र न चढ़ाई जाए तक़द्दुस के दिन पूरे करेंगे।<verse eid="ACT 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27"/>जब वो सात दिन पूरे होने को थे, तो आसिया के यहूदियों ने उसे हैकल में देखकर सब लोगों में हलचल मचाई और यूँ चिल्लाकर उस को पकड़ लिया। <verse eid="ACT 21:27"/><verse number="28" style="v" sid="ACT 21:28"/>कि “ऐ इस्राईलियो; मदद करो ये वही आदमी है, जो हर जगह सब आदमियों को उम्मत और शरी'अत और इस मुक़ाम के ख़िलाफ़ ता'लीम देता है, बल्कि उस ने यूनानियों को भी हैकल में लाकर इस पाक मुक़ाम को नापाक किया है।” <verse eid="ACT 21:28"/><verse number="29" style="v" sid="ACT 21:29"/>(उन्होंने उस से पहले त्रुफ़िमुस इफ़िसी को उसके साथ शहर में देखा था। उसी के बारे में उन्होंने ख़याल किया कि पौलुस उसे हैकल में ले आया है)।<verse eid="ACT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30"/>और तमाम शहर में हलचल मच गई, और लोग दौड़ कर जमा हुए, और पौलुस को पकड़ कर हैकल के दरवाज़े के फाटक से बाहर घसीट कर ले गए, और फ़ौरन दरवाज़े बन्द कर लिए गए। <verse eid="ACT 21:30"/><verse number="31" style="v" sid="ACT 21:31"/>जब वो उसे क़त्ल करना चहते थे, तो ऊपर सौ फ़ौजियों के सरदार के पास ख़बर पहुँची “कि तमाम येरूशलेम में खलबली पड़ गई है।”<verse eid="ACT 21:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 21:32"/>वो उसी वक़्त सिपाहियों और सूबेदारों को ले कर उनके पास नीचे दौड़ा आया। और वो पलटन के सरदार और सिपाहियों को देख कर पौलुस की मार पीट से बाज़ आए। <verse eid="ACT 21:32"/><verse number="33" style="v" sid="ACT 21:33"/>इस पर पलटन के सरदार ने नज़दीक आकर उसे गिरफ़्तार किया “और दो ज़ंजीरों से बाँधने का हुक्म देकर पूछने लगा, ये कौन है, और इस ने क्या किया है?”<verse eid="ACT 21:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 21:34"/>भीड़ में से कुछ चिल्लाए और कुछ पस जब हुल्लड़ की वजह से कुछ हक़ीक़त दरियाफ़्त न कर सका, तो हुक्म दिया कि उसे क़िले में ले जाओ। <verse eid="ACT 21:34"/><verse number="35" style="v" sid="ACT 21:35"/>जब सीढ़ियों पर पहुँचा तो भीड़ की ज़बरदस्ती की वजह से सिपाहियों को उसे उठाकर ले जाना पड़ा। <verse eid="ACT 21:35"/><verse number="36" style="v" sid="ACT 21:36"/>क्यूँकि लोगों की भीड़ ये चिल्लाती हुई उसके पीछे पड़ी “कि उसका काम तमाम कर।”<verse eid="ACT 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37"/>“और जब पौलुस को क़िले के अन्दर ले जाने को थे? उस ने पलटन के सरदार से कहा क्या मुझे इजाज़त है कि तुझ से कुछ कहूँ? उस ने कहा तू यूनानी जानता है? <verse eid="ACT 21:37"/><verse number="38" style="v" sid="ACT 21:38"/>क्या तू वो मिस्री नहीं? जो इस से पहले ग़ाज़ियों में से चार हज़ार आदमियों को बाग़ी करके जंगल में ले गया।”<verse eid="ACT 21:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39"/>पौलुस ने कहा “मैं यहूदी आदमी किलकिया के मशहूर सूबा तरसुस शहर का बाशिन्दा हूँ, मैं तेरी मिन्नत करता हूँ कि मुझे लोगों से बोलने की इजाज़त दे।” <verse eid="ACT 21:39"/><verse number="40" style="v" sid="ACT 21:40"/>जब उस ने उसे इजाज़त दी तो पौलुस ने सीढ़ियों पर खड़े होकर लोगों को इशारा किया। जब वो चुप चाप हो गए, तो इब्रानी ज़बान में यूँ कहने लगा।<verse eid="ACT 21:40"/></para>
  <chapter eid="ACT 21"/>
  <chapter number="22" style="c" sid="ACT 22"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1"/>ऐ भाइयों और बुज़ुर्गो, मेरी बात सुनो, जो अब तुम से बयान करता हूँ।<verse eid="ACT 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2"/>जब उन्होंने सुना कि हम से इब्रानी ज़बान में बोलता है तो और भी चुप चाप हो गए। पस उस ने कहा।<verse eid="ACT 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3"/>मैं यहूदी हूँ, और किलकिया के शहर तरसुस में पैदा हुआ हूँ, मगर मेरी तरबियत इस शहर में गमलीएल के क़दमों में हुई, और मैंने बा'प दादा की शरी'अत की ख़ास पाबन्दी की ता'लीम पाई, और ख़ुदा की राह में ऐसा सरगर्म रहा था, जैसे तुम सब आज के दिन हो। <verse eid="ACT 22:3"/><verse number="4" style="v" sid="ACT 22:4"/>चुनाँचे मैंने मर्दों और औरतों को बाँध बाँधकर और क़ैदख़ाने में डाल डालकर मसीही तरीक़े वालों को यहाँ तक सताया है कि मरवा भी डाला। <verse eid="ACT 22:4"/><verse number="5" style="v" sid="ACT 22:5"/>चुनाँचे सरदार काहिन और सब बुज़ुर्ग मेरे गवाह हैं, कि उन से मैं भाइयों के नाम ख़त ले कर दमिश्क़ को रवाना हुआ, ताकि जितने वहाँ हों उन्हें भी बाँध कर येरूशलेम में सज़ा दिलाने को लाऊँ।<verse eid="ACT 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6"/>जब में सफ़र करता करता दमिश्क़ शहर के नज़दीक पहुँचा तो ऐसा हुआ कि दोपहर के क़रीब यकायक एक बड़ा नूर आसमान से मेरे आस — पास आ चमका। <verse eid="ACT 22:6"/><verse number="7" style="v" sid="ACT 22:7"/>और में ज़मीन पर गिर पड़ा, और ये आवाज़ सुनी कि <char style="wj">“ऐ साऊल, ऐ साऊल। तू मुझे क्यूँ सताता है?”</char> <verse eid="ACT 22:7"/><verse number="8" style="v" sid="ACT 22:8"/>मैं ने जवाब दिया कि ‘ऐ ख़ुदावन्द, तू कौन हैं?’ उस ने मुझ से कहा <char style="wj">“मैं ईसा नासरी हूँ जिसे तू सताता है।”</char><verse eid="ACT 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 22:9"/>और मेरे साथियों ने नूर तो देखा लेकिन जो मुझ से बोलता था, उस की आवाज़ न समझ सके। <verse eid="ACT 22:9"/><verse number="10" style="v" sid="ACT 22:10"/>मैं ने कहा, 'ऐ ख़ुदावन्द, मैं क्या करूँ? ख़ुदावन्द ने मुझ से कहा, <char style="wj">“उठ कर दमिश्क़ में जा। और जो कुछ तेरे करने के लिए मुक़र्रर हुआ है, वहाँ तुझ से सब कहा जाए गा।”</char> <verse eid="ACT 22:10"/><verse number="11" style="v" sid="ACT 22:11"/>जब मुझे उस नूर के जलाल की वजह से कुछ दिखाई न दिया तो मेरे साथी मेरा हाथ पकड़ कर मुझे दमिश्क़ में ले गए।<verse eid="ACT 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12"/>और हननियाह नाम एक शख़्स जो शरी'अत के मुवाफ़िक़ दीनदार और वहाँ के सब रहने वाले यहूदियों के नज़दीक नेक नाम था <verse eid="ACT 22:12"/><verse number="13" style="v" sid="ACT 22:13"/>मेरे पास आया और खड़े होकर मुझ से कहा, 'भाई साऊल फिर बीना हो, उसी वक़्त बीना हो कर मैंने उस को देखा।<verse eid="ACT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14"/>उस ने कहा, 'हमारे बाप दादा के ख़ुदा ने तुझ को इसलिए मुक़र्रर किया है कि तू उस की मर्ज़ी को जाने और उस रास्तबाज़ को देखे और उस के मुँह की आवाज़ सुने। <verse eid="ACT 22:14"/><verse number="15" style="v" sid="ACT 22:15"/>क्यूँकि तू उस की तरफ़ से सब आदमियों के सामने उन बातों का गवाह होगा, जो तूने देखी और सुनी हैं। <verse eid="ACT 22:15"/><verse number="16" style="v" sid="ACT 22:16"/>अब क्यूँ देर करता है? उठ बपतिस्मा ले, और उस का नाम ले कर अपने गुनाहों को धो डाल।<verse eid="ACT 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17"/>जब मैं फिर येरूशलेम में आकर हैकल में दुआ कर रहा था, तो ऐसा हुआ कि मैं बेख़ुद हो गया। <verse eid="ACT 22:17"/><verse number="18" style="v" sid="ACT 22:18"/>और उस को देखा कि मुझ से कहता है, <char style="wj">“जल्दी कर और फ़ौरन येरूशलेम से निकल जा, क्यूँकि वो मेरे हक़ में तेरी गवाही क़ुबूल न करेंगे।”</char><verse eid="ACT 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19"/>मैंने कहा, 'ऐ ख़ुदावन्द! वो ख़ुद जानते हैं, कि जो तुझ पर ईमान लाए हैं, उन को क़ैद कराता और जा'बजा इबादतख़ानों में पिटवाता था। <verse eid="ACT 22:19"/><verse number="20" style="v" sid="ACT 22:20"/>और जब तेरे शहीद स्तिफ़नुस का ख़ून बहाया जाता था, तो मैं भी वहाँ खड़ा था। और उसके क़त्ल पर राज़ी था, और उसके क़ातिलों के कपड़ों की हिफ़ाज़त करता था। <verse eid="ACT 22:20"/><verse number="21" style="v" sid="ACT 22:21"/>उस ने मुझ से कहा, <char style="wj">“जा मैं तुझे ग़ैर क़ौमों के पास दूर दूर भेजूँगा।”</char><verse eid="ACT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22"/>वो इस बात तक तो उसकी सुनते रहे फिर बुलन्द आवाज़ से चिल्लाए कि ऐसे शख़्स को ज़मीन पर से ख़त्म कर दे! उस का ज़िन्दा रहना मुनासिब नहीं, <verse eid="ACT 22:22"/><verse number="23" style="v" sid="ACT 22:23"/>जब वो चिल्लाते और अपने कपड़े फ़ेंकते और ख़ाक उड़ाते थे।<verse eid="ACT 22:23"/></para>
  <para style="s">पौलुस का अपनी रोमी हक शहरीयत दिख़ाना</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 22:24"/>तो पलटन के सरदार ने हुक्म दे कर कहा, कि उसे क़िले में ले जाओ, और कोड़े मार कर उस का इज़हार लो ताकि मुझे मा'लूम हो कि वो किस वजह से उसकी मुख़ालिफ़त में यूँ चिल्लाते हैं।<verse eid="ACT 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 22:25"/>जब उन्होंने उसे रस्सियों से बाँध लिया तो, पौलुस ने उस सिपाही से जो पास खड़ा था कहा, “ख़ुदावन्द क्या तुम्हें जायज़ है कि एक रोमी आदमी को कोड़े मारो और वो भी क़ुसूर साबित किए बग़ैर?” <verse eid="ACT 22:25"/><verse number="26" style="v" sid="ACT 22:26"/>सिपाही ये सुन कर पलटन के सरदार के पास गया और उसे ख़बर दे कर कहा, तू क्या करता है? ये तो रोमी आदमी है।<verse eid="ACT 22:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27"/>पलटन के सरदार ने उस के पास आकर कहा, मुझे बता तो क्या तू रोमी है? उस ने कहा, हाँ। <verse eid="ACT 22:27"/><verse number="28" style="v" sid="ACT 22:28"/>पलटन के सरदार ने जवाब दिया कि मैं ने बड़ी रक़म दे कर रोमी होने का रुत्बा हासिल किया पौलुस ने कहा, “मैं तो पैदाइशी हूँ।” <verse eid="ACT 22:28"/><verse number="29" style="v" sid="ACT 22:29"/>पस, जो उस का इज़हार लेने को थे, फ़ौरन उस से अलग हो गए। और पलटन का सरदार भी ये मा'लूम करके डर गया, कि जिसको मैंने बाँधा है, वो रोमी है।<verse eid="ACT 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30"/>सुबह को ये हक़ीक़त मा'लूम करने के इरादे से कि यहूदी उस पर क्या इल्ज़ाम लगाते हैं। उस ने उस को खोल दिया। और सरदार काहिन और सब सद्र — ए — आदालत वालों को जमा होने का हुक्म दिया, और पौलुस को नीचे ले जाकर उनके सामने खड़ा कर दिया।<verse eid="ACT 22:30"/></para>
  <chapter eid="ACT 22"/>
  <chapter number="23" style="c" sid="ACT 23"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1"/>पौलुस ने सद्र — ऐ आदालत वालों को ग़ौर से देख कर कहा “ऐ भाइयों, मैंने आज तक पूरी नेक निती से ख़ुदा के वास्ते अपनी उम्र गुज़ारी है।” <verse eid="ACT 23:1"/><verse number="2" style="v" sid="ACT 23:2"/>सरदार काहिन हननियाह ने उन को जो उस के पास खड़े थे, हुक्म दिया कि उस के मुँह पर तमाचा मारो। <verse eid="ACT 23:2"/><verse number="3" style="v" sid="ACT 23:3"/>पौलुस ने उस से कहा, ऐ सफ़ेदी फिरी हुई दीवार! ख़ुदा “तुझे मारेगा! तू शरी'अत के मुवाफ़िक़ मेरा इन्साफ़ करने को बैठा है, और क्या शरी'अत के बर — ख़िलाफ़ मुझे मारने का हुक्म देता है।”<verse eid="ACT 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4"/>जो पास खड़े थे, उन्होंने कहा, “क्या तू ख़ुदा के सरदार काहिन को बुरा कहता है?” <verse eid="ACT 23:4"/><verse number="5" style="v" sid="ACT 23:5"/>पौलुस ने कहा, ऐ भाइयों, मुझे मालूम न था कि ये सरदार काहिन है, क्यूँकि लिखा है कि,</para>
  <para style="q" vid="ACT 23:5">अपनी क़ौम के सरदार को बुरा न कह।<verse eid="ACT 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6"/>जब पौलुस ने ये मा'लूम किया कि कुछ सदूक़ी हैं और कुछ फ़रीसी तो अदालत में पुकार कर कहा, ऐ भाइयों, मैं फ़रीसी और फ़रीसियों की औलाद हूँ। मुर्दों की उम्मीद और क़यामत के बारे में मुझ पर मुक़द्दमा हो रहा है, <verse eid="ACT 23:6"/><verse number="7" style="v" sid="ACT 23:7"/>जब उस ने ये कहा तो फ़रीसियों और सदूक़ियों में तकरार हुई, और मजमें में फ़ूट पड़ गई। <verse eid="ACT 23:7"/><verse number="8" style="v" sid="ACT 23:8"/>क्यूँकि सदूक़ी तो कहते हैं कि न क़यामत होगी, न कोई फ़रिश्ता है, न रूह मगर फ़रीसी दोनों का इक़रार करते हैं।<verse eid="ACT 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 23:9"/>पस, बड़ा शोर हुआ। और फ़रीसियों के फ़िरक़े के कुछ आलिम उठे “और यूँ कह कर झगड़ने लगे कि हम इस आदमी में कुछ बुराई नहीं पाते और अगर किसी रूह या फ़रिश्ते ने इस से कलाम किया हो तो फिर क्या?” <verse eid="ACT 23:9"/><verse number="10" style="v" sid="ACT 23:10"/>और जब बड़ी तकरार हुई तो पलटन के सरदार ने इस ख़ौफ़ से कि उस वक़्त पौलुस के टुकड़े कर दिए जाएँ, फ़ौज को हुक्म दिया कि उतर कर उसे उन में से ज़बरदस्ती निकालो और क़िले में ले जाओ।<verse eid="ACT 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11"/>उसी रात ख़ुदावन्द उसके पास आ खड़ा हुआ, और कहा, <char style="wj">“इत्मीनान रख; कि जैसे तू ने मेरे बारे में येरूशलेम में गवाही दी है वैसे ही तुझे रोमा में भी गवाही देनी होगी।”</char><verse eid="ACT 23:11"/></para>
  <para style="s">पौलुस को मारने की चाल</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12"/>जब दिन हुआ तो यहूदियों ने एका कर के और ला'नत की क़सम खाकर कहा “कि जब तक हम पौलुस को क़त्ल न कर लें न कुछ खाएँगे न पीएँगे।” <verse eid="ACT 23:12"/><verse number="13" style="v" sid="ACT 23:13"/>और जिन्हों ने आपस में ये साज़िश की वो चालीस से ज़्यादा थे।<verse eid="ACT 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 23:14"/>पस, उन्हों ने सरदार काहिनों और बुज़ुर्गों के पास जाकर कहा “कि हम ने सख़्त ला'नत की क़सम खाई है कि जब तक हम पौलुस को क़त्ल न कर लें कुछ न चखेंगे। <verse eid="ACT 23:14"/><verse number="15" style="v" sid="ACT 23:15"/>पस, अब तुम सद्र — ए — अदालत वालों से मिलकर पलटन के सरदार से अर्ज़ करो कि उसे तुम्हारे पास लाए। गोया तुम उसके मु'अमिले की हक़ीक़त ज़्यादा मालूम करना चाहते हो, और हम उसके पहुँचने से पहले उसे मार डालने को तैयार हैं”<verse eid="ACT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16"/>लेकिन पौलुस का भांजा उनकी घात का हाल सुन कर आया और क़िले में जाकर पौलुस को ख़बर दी। <verse eid="ACT 23:16"/><verse number="17" style="v" sid="ACT 23:17"/>पौलुस ने सुबेदारों में से एक को बुला कर कहा “इस जवान को पलटन के सरदार के पास ले जाऐ उस से कुछ कहना चाहता है।”<verse eid="ACT 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 23:18"/>उस ने उस को पलटन के सरदार के पास ले जा कर कहा कि पौलुस क़ैदी ने मुझे बुला कर दरख़्वास्त की कि जवान को तेरे पास लाऊँ। कि तुझ से कुछ कहना चाहता है। <verse eid="ACT 23:18"/><verse number="19" style="v" sid="ACT 23:19"/>पलटन के सरदार ने उसका हाथ पकड़ कर और अलग जा कर पूछा “कि मुझ से क्या कहना चाहता है?”<verse eid="ACT 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20"/>उस ने कहा “यहूदियों ने मशवरा किया है, कि तुझ से दरख़्वास्त करें कि कल पौलुस को सद्र — ए — अदालत में लाए। गोया तू उस के हाल की और भी तहक़ीक़ात करना चाहता है। <verse eid="ACT 23:20"/><verse number="21" style="v" sid="ACT 23:21"/>लेकिन तू उन की न मानना, क्यूँकि उन में चालीस शख़्स से ज़्यादा उस की घात में हैं जिन्होंने ला'नत की क़सम खाई है, कि जब तक उसे मार न डालें न खाएँगे न पिएँगे और अब वो तैयार हैं, सिर्फ़ तेरे वादे का इन्तज़ार है।”<verse eid="ACT 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22"/>पस, सरदार ने जवान को ये हुक्म दे कर रुख़्सत किया कि किसी से न कहना कि तू ने मुझ पर ये ज़ाहिर किया।<verse eid="ACT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23"/>और दो सुबेदारों को पास बुला कर कहा कि “दो सौ सिपाही और सत्तर सवार और दो सौ नेज़ा बरदार पहर रात गए, क़ैसरिया जाने को तैयार कर रखना। <verse eid="ACT 23:23"/><verse number="24" style="v" sid="ACT 23:24"/>और हुक्म दिया पौलुस की सवारी के लिए जानवरों को भी हाज़िर करें, ताकि उसे फ़ेलिक्स हाकिम के पास सहीह सलामत पहुँचा दें।”<verse eid="ACT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 23:25"/>और इस मज़्मून का ख़त लिखा।<verse eid="ACT 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26"/>क्लोदियुस लूसियास का फ़ेलिक्स बहादुर हाकिम को सलाम। <verse eid="ACT 23:26"/><verse number="27" style="v" sid="ACT 23:27"/>इस शख़्स को यहूदियों ने पकड़ कर मार डालना चाहा मगर जब मुझे मा'लूम हुआ कि ये रोमी है तो फ़ौज समेत चढ़ गया, और छुड़ा लाया।<verse eid="ACT 23:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 23:28"/>और इस बात की दरियाफ़्त करने का इरादा करके कि वो किस वजह से उस पर ला'नत करते हैं; उसे उन की सद्र — ए — अदालत में ले गया। <verse eid="ACT 23:28"/><verse number="29" style="v" sid="ACT 23:29"/>और मा'लूम हुआ कि वो अपनी शरी'अत के मस्लों के बारे में उस पर नालिश करते हैं; लेकिन उस पर कोई ऐसा इल्ज़ाम नहीं लगाया गया कि क़त्ल या क़ैद के लायक़ हो। <verse eid="ACT 23:29"/><verse number="30" style="v" sid="ACT 23:30"/>और जब मुझे इत्तला हुई कि इस शख़्स के बर — ख़िलाफ़ साज़िश होने वाली है, तो मैंने इसे फ़ौरन तेरे पास भेज दिया है और इस के मुद्द, इयों को भी हुक्म दे दिया है कि तेरे सामने इस पर दा'वा करें।<verse eid="ACT 23:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31"/>पस, सिपाहियों ने हुक्म के मुवाफ़िक़ पौलुस को लेकर रातों रात अन्तिपत्रिस में पहुँचा दिया। <verse eid="ACT 23:31"/><verse number="32" style="v" sid="ACT 23:32"/>और दूसरे दिन सवारों को उसके साथ जाने के लिए छोड़ कर आप क़िले की तरफ़ मुड़े। <verse eid="ACT 23:32"/><verse number="33" style="v" sid="ACT 23:33"/>उन्हों ने क़ैसरिया में पहुँच कर हाकिम को ख़त दे दिया, और पौलुस को भी उस के आगे हाज़िर किया।<verse eid="ACT 23:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 23:34"/>उस ने ख़त पढ़ कर पूछा कि ये किस सूबे का है और ये मा'लूम करके कि किलकिया का है। <verse eid="ACT 23:34"/><verse number="35" style="v" sid="ACT 23:35"/>उस से कहा “कि जब तेरे मुद्द'ई भी हाज़िर होंगे; मैं तेरा मुक़द्दमा करूँगा।” और उसे हेरोदेस के क़िले में क़ैद रखने का हुक्म दिया।<verse eid="ACT 23:35"/></para>
  <chapter eid="ACT 23"/>
  <chapter number="24" style="c" sid="ACT 24"/>
  <para style="s">पौलुस का फिलिक्स के सामने पेश होना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1"/>पाँच दिन के बाद हननियाह सरदार काहिन के कुछ बुज़ुर्गों और तिरतुलुस नाम एक वकील को साथ ले कर वहाँ आया, और उन्होंने हाकिम के सामने पौलुस के ख़िलाफ़ फ़रियाद की। <verse eid="ACT 24:1"/><verse number="2" style="v" sid="ACT 24:2"/>जब वो बुलाया गया तो तिरतुलुस इल्ज़ाम लगा कर कहने लगा कि ऐ फ़ेलिक्स बहादुर चूँकि तेरे वसीले से हम बड़े अमन में हैं और तेरी दूर अन्देशी से इस क़ौम के फ़ाइदे के लिए ख़राबियों की इस्लाह होती है।<verse eid="ACT 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 24:3"/>हम हर तरह और हर जगह कमाल शुक्र गुज़ारी के साथ तेरा एहसान मानते हैं।<verse eid="ACT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 24:4"/>मगर इस लिए कि तुझे ज़्यादा तकलीफ़ न दूँ, मैं तेरी मिन्नत करता हूँ कि तू मेहरबानी से दो एक बातें हमारी सुन ले। <verse eid="ACT 24:4"/><verse number="5" style="v" sid="ACT 24:5"/>क्यूँकि हम ने इस शख़्स को फ़साद करने वाला और दुनिया के सब यहूदियों में फ़ितना अंगेज़ और नासरियों की बिद'अती फ़िरक़े का सरगिरोह पाया। <verse eid="ACT 24:5"/><verse number="6" style="v" sid="ACT 24:6"/>इस ने हैकल को नापाक करने की भी कोशिश की थी, और हम ने इसे पकड़ा। और हम ने चाहा कि अपनी शरी'अत के मुवाफ़िक़ इस की अदालत करें।<verse eid="ACT 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 24:7"/>लेकिन लूसियास सरदार आकर बड़ी ज़बरदस्ती से उसे हमारे हाथ से छीन ले गया। <verse eid="ACT 24:7"/><verse number="8" style="v" sid="ACT 24:8"/>और उसके मुद्दइयों को हुक्म दिया कि तेरे पास जाएँ इसी से तहक़ीक़ करके तू आप इन सब बातों को मालूम कर सकता है, जिनका हम इस पर इल्ज़ाम लगाते हैं। <verse eid="ACT 24:8"/><verse number="9" style="v" sid="ACT 24:9"/>और दूसरे यहूदियों ने भी इस दा'वे में मुत्तफ़िक़ हो कर कहा कि ये बातें इसी तरह हैं।<verse eid="ACT 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10"/>जब हाकिम ने पौलुस को बोलने का इशारा किया तो उस ने जवाब दिया, चूँकि मैं जानता हूँ, कि तू बहुत बरसों से इस क़ौम की अदालत करता है, इसलिए मैं ख़ुद से अपना उज़्र बयान करता हूँ। <verse eid="ACT 24:10"/><verse number="11" style="v" sid="ACT 24:11"/>तू मालूम कर सकता है, कि बारह दिन से ज़्यादा नहीं हुए कि मैं येरूशलेम में इबादत करने गया था। <verse eid="ACT 24:11"/><verse number="12" style="v" sid="ACT 24:12"/>और उन्होंने मुझे न हैकल में किसी के साथ बहस करते या लोगों में फ़साद कराते पाया न इबादतख़ानों में न शहर में। <verse eid="ACT 24:12"/><verse number="13" style="v" sid="ACT 24:13"/>और न वो इन बातों को जिन का मुझ पर अब इल्ज़ाम लगाते हैं, तेरे सामने साबित कर सकते हैं।<verse eid="ACT 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 24:14"/>लेकिन तेरे सामने ये इक़रार करता हूँ, कि जिस तरीक़े को वो बिद'अत कहते हैं, उसी के मुताबिक़ मैं अपने बाप दादा के ख़ुदा की इबादत करता हूँ, और जो कुछ तौरेत और नबियों के सहीफ़ों में लिखा है, उस सब पर मेरा ईमान है। <verse eid="ACT 24:14"/><verse number="15" style="v" sid="ACT 24:15"/>और ख़ुदा से उसी बात की उम्मीद रखता हूँ, जिसके वो ख़ुद भी मुन्तज़िर हैं, कि रास्तबाज़ों और नारास्तों दोनों की क़यामत होगी। <verse eid="ACT 24:15"/><verse number="16" style="v" sid="ACT 24:16"/>इसलिए मैं ख़ुद भी कोशिश में रहता हूँ, कि ख़ुदा और आदमियों के बारे में मेरा दिल मुझे कभी मलामत न करे।<verse eid="ACT 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17"/>बहुत बरसों के बाद मैं अपनी क़ौम को ख़ैरात पहुँचाने और नज़्रें चढ़ाने आया था। <verse eid="ACT 24:17"/><verse number="18" style="v" sid="ACT 24:18"/>उन्होंने बग़ैर हँगामे या बवाल के मुझे तहारत की हालत में ये काम करते हुए हैकल में पाया, यहाँ आसिया के चन्द यहूदी थे। <verse eid="ACT 24:18"/><verse number="19" style="v" sid="ACT 24:19"/>और अगर उन का मुझ पर कुछ दा'वा था, तो उन्हें तेरे सामने हाज़िर हो कर फ़रियाद करना वाजिब था।<verse eid="ACT 24:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 24:20"/>या यही ख़ुद कहें, कि जब मैं सद्र — ए — अदालत के सामने खड़ा था, तो मुझ में क्या बुराई पाई थी। <verse eid="ACT 24:20"/><verse number="21" style="v" sid="ACT 24:21"/>सिवा इस बात के कि मैं ने उन में खड़े हो कर बुलन्द आवाज़ से कहा था कि मुर्दों की क़यामत के बारे में आज मुझ पर मुक़द्दमा हो रहा है।<verse eid="ACT 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22"/>फ़ेलिक्स ने जो सहीह तौर पर इस तरीक़े से वाक़िफ़ था “ये कह कर मुक़द्दमे को मुल्तवी कर दिया कि जब पलटन का सरदार लूसियास आएगा तो मैं तुम्हारा मुक़द्दमा फ़ैसला करूँगा।” <verse eid="ACT 24:22"/><verse number="23" style="v" sid="ACT 24:23"/>और सुबेदार को हुक्म दिया कि उस को क़ैद तो रख मगर आराम से रखना और इसके दोस्तों में से किसी को इसकी ख़िदमत करने से मनह' न करना।<verse eid="ACT 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24"/>और चन्द रोज़ के बाद फ़ेलिक्स अपनी बीवी दुसिल्ला को जो यहूदी थी, साथ ले कर आया, और पौलुस को बुलवा कर उस से मसीह ईसा के दीन की कैफ़ियत सुनी। <verse eid="ACT 24:24"/><verse number="25" style="v" sid="ACT 24:25"/>और जब वो रास्तबाज़ी और परहेज़गारी और आइन्दा अदालत का बयान कर रहा था, तो फ़ेलिक्स ने दहशत खाकर जवाब दिया, कि इस वक़्त तू जा; फ़ुरसत पाकर तुझे फिर बुलाउँगा।<verse eid="ACT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 24:26"/>उसे पौलुस से कुछ रुपऐ मिलने की उम्मीद भी थी, इसलिए उसे और भी बुला बुला कर उस के साथ गुफ़्तगू किया करता था। <verse eid="ACT 24:26"/><verse number="27" style="v" sid="ACT 24:27"/>लेकिन जब दो बरस गुज़र गए तो पुरकियुस फ़ेस्तुस फ़ेलिक्स की जगह मुक़र्रर हुआ और फ़ेलिक्स यहूदियों को अपना एहसान मन्द करने की ग़रज़ से पौलुस को क़ैद ही में छोड़ गया।<verse eid="ACT 24:27"/></para>
  <chapter eid="ACT 24"/>
  <chapter number="25" style="c" sid="ACT 25"/>
  <para style="s">पौलुस का फेस्तुस के सामने पेश होना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1"/>पस, फ़ेस्तुस सूबे में दाख़िल होकर तीन रोज़ के बाद क़ैसरिया से येरूशलेम को गया। <verse eid="ACT 25:1"/><verse number="2" style="v" sid="ACT 25:2"/>और सरदार काहिनों और यहूदियों के रईसों ने उस के यहाँ पौलुस के ख़िलाफ़ फ़रियाद की। <verse eid="ACT 25:2"/><verse number="3" style="v" sid="ACT 25:3"/>और उस की मुख़ालिफ़त में ये रि'आयत चाही कि उसे येरूशलेम में बुला भेजे; और घात में थे, कि उसे राह में मार डालें।<verse eid="ACT 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 25:4"/>मगर फ़ेस्तुस ने जवाब दिया कि पौलुस तो क़ैसरिया में क़ैद है और मैं आप जल्द वहाँ जाऊँगा। <verse eid="ACT 25:4"/><verse number="5" style="v" sid="ACT 25:5"/>पस तुम में से जो इख़्तियार वाले हैं वो साथ चलें और अगर इस शख़्स में कुछ बेजा बात हो तो उस की फ़रियाद करें।<verse eid="ACT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6"/>वो उन में आठ दस दिन रह कर क़ैसरिया को गया, और दूसरे दिन तख़्त — ए — अदालत पर बैठकर पौलुस के लाने का हुक्म दिया। <verse eid="ACT 25:6"/><verse number="7" style="v" sid="ACT 25:7"/>जब वो हाज़िर हुआ तो जो यहूदी येरूशलेम से आए थे, वो उस के आस पास खड़े होकर उस पर बहुत सख़्त इल्ज़ाम लगाने लगे, मगर उन को साबित न कर सके। <verse eid="ACT 25:7"/><verse number="8" style="v" sid="ACT 25:8"/>लेकिन पौलुस ने ये उज़्र किया “मैंने न तो कुछ यहूदियों की शरी'अत का गुनाह किया है, न हैकल का न क़ैसर का।”<verse eid="ACT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9"/>मगर फ़ेस्तुस ने यहूदियों को अपना एहसानमन्द बनाने की ग़रज़ से पौलुस को जवाब दिया “क्या तुझे येरूशलेम जाना मन्ज़ूर है? कि तेरा ये मुक़द्दमा वहाँ मेरे सामने फ़ैसला हो”<verse eid="ACT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10"/>पौलुस ने कहा, मैं क़ैसर के तख़्त — ए — अदालत के सामने खड़ा हूँ, मेरा मुक़द्दमा यहीं फ़ैसला होना चाहिए यहूदियों का मैं ने कुछ क़ुसूर नहीं किया। चुनाँचे तू भी ख़ूब जानता है।<verse eid="ACT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 25:11"/>अगर बदकार हूँ, या मैंने क़त्ल के लायक़ कोई काम किया है तो मुझे मरने से इन्कार नहीं! लेकिन जिन बातों का वो मुझ पर इल्ज़ाम लगाते हैं अगर उनकी कुछ अस्ल नहीं तो उनकी रि'आयत से कोई मुझ को उनके हवाले नहीं कर सकता। मैं क़ैसर के यहाँ दरख़्वास्त करता हूँ। <verse eid="ACT 25:11"/><verse number="12" style="v" sid="ACT 25:12"/>फिर फ़ेस्तुस ने सलाहकारों से मशवरा करके जवाब दिया, “तू ने क़ैसर के यहाँ फ़रियाद की है, तो क़ैसर ही के पास जाएगा।”<verse eid="ACT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13"/>और कुछ दिन गुज़रने के बाद अग्रिप्पा बादशाह और बिरनीकि ने क़ैसरिया में आकर फ़ेस्तुस से मुलाक़ात की। <verse eid="ACT 25:13"/><verse number="14" style="v" sid="ACT 25:14"/>और उनके कुछ अर्से वहाँ रहने के बाद फ़ेस्तुस ने पौलुस के मुक़द्दमे का हाल बादशाह से ये कह कर बयान किया। कि एक शख़्स को फ़ेलिक्स क़ैद में छोड़ गया है। <verse eid="ACT 25:14"/><verse number="15" style="v" sid="ACT 25:15"/>जब मैं येरूशलेम में था, तो सरदार काहिनों और यहूदियों के बुज़ुर्गों ने उसके ख़िलाफ़ फ़रियाद की; और सज़ा के हुक्म की दरख़्वास्त की। <verse eid="ACT 25:15"/><verse number="16" style="v" sid="ACT 25:16"/>उनको मैंने जवाब दिया'कि “रोमियों का ये दस्तूर नहीं कि किसी आदमियों को रि'आयतन सज़ा के लिए हवाले करें, जब कि मुद्द'अलिया को अपने मुद्द'इयों के रू — ब — रू हो कर दा, वे के जवाब देने का मौक़ा न मिले।”<verse eid="ACT 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 25:17"/>पस, जब वो यहाँ जमा हुए तो मैंने कुछ देर न की बल्कि दूसरे ही दिन तख़्त — ए अदालत पर बैठ कर उस आदमी को लाने का हुक्म दिया। <verse eid="ACT 25:17"/><verse number="18" style="v" sid="ACT 25:18"/>मगर जब उसके मुद्द'ई खड़े हुए तो जिन बुराइयों का मुझे गुमान था, उनमें से उन्होंने किसी का इल्ज़ाम उस पर न लगाया। <verse eid="ACT 25:18"/><verse number="19" style="v" sid="ACT 25:19"/>बल्कि अपने दीन और किसी शख़्स ईसा के बारे में उस से बहस करते थे, जो मर गया था, और पौलुस उसको ज़िन्दा बताता है। <verse eid="ACT 25:19"/><verse number="20" style="v" sid="ACT 25:20"/>चूँकि मैं इन बातों की तहक़ीक़ात के बारे में उलझन में था, इस लिए उस से पूछा क्या तू येरूशलेम जाने को राज़ी है, कि वहाँ इन बातों का फ़ैसला हो?<verse eid="ACT 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 25:21"/>मगर जब पौलुस ने फ़रियाद की, कि मेरा मुक़द्दमा शहन्शाह की अदालत में फ़ैसला हो तो, मैंने हुक्म दिया कि जब तक उसे क़ैसर के पास न भेजूँ, क़ैद में रहे। <verse eid="ACT 25:21"/><verse number="22" style="v" sid="ACT 25:22"/>अग्रिप्पा ने फ़ेस्तुस से कहा, मैं भी उस आदमी की सुनना चाहता हूँ, उस ने कहा “तू कल सुन लेगा।”<verse eid="ACT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23"/>पस, दूसरे दिन जब अग्रिप्पा और बिरनीकि बड़ी शान — ओ शौकत से पलटन के सरदारों और शहर के र'ईसों के साथ दिवान खाने में दाख़िल हुए। तो फ़ेस्तुस के हुक्म से पौलुस हाज़िर किया गया। <verse eid="ACT 25:23"/><verse number="24" style="v" sid="ACT 25:24"/>फिर फ़ेस्तुस ने कहा, ऐ अग्रिप्पा बादशाह और ऐ सब हाज़रीन तुम इस शख़्स को देखते हो, जिसके बारे में यहूदियों के सारे गिरोह ने येरूशलेम में और यहाँ भी चिल्ला चिल्ला कर मुझ से अर्ज़ की कि इस का आगे को ज़िन्दा रहना मुनासिब नहीं।<verse eid="ACT 25:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 25:25"/>लेकिन मुझे मा'लूम हुआ कि उस ने क़त्ल के लायक़ कुछ नहीं किया; और जब उस ने ख़ुद शहन्शाह के यहाँ फ़रियाद की तो मैं ने उस को भेजने की तज्वीज़ की। <verse eid="ACT 25:25"/><verse number="26" style="v" sid="ACT 25:26"/>उसके बारे में मुझे कोई ठीक बात मा'लूम नहीं कि सरकार — ए — आली को लिखूँ इस वास्ते मैंने उस को तुम्हारे आगे और ख़ासकर — ऐ — अग्रिप्पा बादशाह तेरे हुज़ूर हाज़िर किया है, ताकि तहक़ीक़ात के बाद लिखने के काबिल कोई बात निकले। <verse eid="ACT 25:26"/><verse number="27" style="v" sid="ACT 25:27"/>क्यूँकि क़ैदी के भेजते वक़्त उन इल्ज़ामों को जो उस पर लगाए गए है, ज़ाहिर न करना मुझे ख़िलाफ़ — ए — अक़्ल मा'लूम होता है।<verse eid="ACT 25:27"/></para>
  <chapter eid="ACT 25"/>
  <chapter number="26" style="c" sid="ACT 26"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1"/>अग्रिप्पा ने पौलुस से कहा, तुझे अपने लिए बोलने की इजाज़त है; पौलुस अपना हाथ बढ़ाकर अपना जवाब यूँ पेश करने लगा कि,<verse eid="ACT 26:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2"/>ऐ अग्रिप्पा बादशाह जितनी बातों की यहूदी मुझ पर ला'नत करते हैं; आज तेरे सामने उनकी जवाबदेही करना अपनी ख़ुशनसीबी जानता हूँ। <verse eid="ACT 26:2"/><verse number="3" style="v" sid="ACT 26:3"/>ख़ासकर इसलिए कि तू यहूदियों की सब रस्मों और मसलों से वाक़िफ़ है; पस, मैं मिन्नत करता हूँ, कि तहम्मील से मेरी सुन ले।<verse eid="ACT 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4"/>सब यहूदी जानते हैं कि अपनी क़ौम के दर्मियान और येरूशलेम में शुरू जवानी से मेरा चालचलन कैसा रहा है। <verse eid="ACT 26:4"/><verse number="5" style="v" sid="ACT 26:5"/>चूँकि वो शुरू से मुझे जानते हैं, अगर चाहें तो गवाह हो सकते हैं, कि में फ़रीसी होकर अपने दीन के सब से ज़्यादा पाबन्द मज़हबी फ़िरक़े की तरह ज़िन्दगी गुज़ारता था।<verse eid="ACT 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 26:6"/>और अब उस वा'दे की उम्मीद की वजह से मुझ पर मुक़द्दमा हो रहा है, जो ख़ुदा ने हमारे बाप दादा से किया था। <verse eid="ACT 26:6"/><verse number="7" style="v" sid="ACT 26:7"/>उसी वा'दे के पूरा होने की उम्मीद पर हमारे बारह के बारह क़बीले दिल'ओ जान से रात दिन इबादत किया करते हैं, इसी उम्मीद की वजह से ऐ बादशाह यहूदी मुझ पर नालिश करते हैं। <verse eid="ACT 26:7"/><verse number="8" style="v" sid="ACT 26:8"/>जब कि ख़ुदा मुर्दों को जिलाता है, तो ये बात तुम्हारे नज़दीक क्यूँ ग़ैर मो'तबर समझी जाती है?<verse eid="ACT 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9"/>मैंने भी समझा था, कि ईसा नासरी के नाम की तरह तरह से मुख़ालिफ़त करना मुझ पर फ़र्ज़ है। <verse eid="ACT 26:9"/><verse number="10" style="v" sid="ACT 26:10"/>चुनाँचे मैंने येरूशलेम में ऐसा ही किया, और सरदार काहिनों की तरफ़ से इख़्तियार पाकर बहुत से मुक़द्दसों को क़ैद में डाला और जब वो क़त्ल किए जाते थे, तो मैं भी यही मशवरा देता था। <verse eid="ACT 26:10"/><verse number="11" style="v" sid="ACT 26:11"/>और हर इबादत खाने में उन्हें सज़ा दिला दिला कर ज़बरदस्ती उन से कूफ़्र कहलवाता था, बल्कि उन की मुख़ालिफ़त में ऐसा दिवाना बना कि ग़ैर शाहरों में भी जाकर उन्हें सताता था।<verse eid="ACT 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12"/>इसी हाल में सरदार काहिनों से इख़्तियार और परवाने लेकर दमिश्क़ को जाता था। <verse eid="ACT 26:12"/><verse number="13" style="v" sid="ACT 26:13"/>तो ऐ बादशाह मैंने दो पहर के वक़्त राह में ये देखा कि सूरज के नूर से ज़्यादा एक नूर आसमान से मेरे और मेरे हमसफ़रों के गिर्द आ चमका। <verse eid="ACT 26:13"/><verse number="14" style="v" sid="ACT 26:14"/>जब हम सब ज़मीन पर गिर पड़े तो मैंने इब्रानी ज़बान में ये आवाज़ सुनी' कि <char style="wj">“ऐ साऊल, ऐ साऊल, तू मुझे क्यूँ सताता है? अपने आप पर लात मारना तेरे लिए मुश्किल है।”</char><verse eid="ACT 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15"/>मैं ने कहा 'ऐ ख़ुदावन्द, तू कौन हैं? 'ख़ुदावन्द ने फ़रमाया <char style="wj">“मैं ईसा हूँ, जिसे तू सताता है।</char> <verse eid="ACT 26:15"/><verse number="16" style="v" sid="ACT 26:16"/><char style="wj">लेकिन उठ अपने पाँव पर खड़ा हो, क्यूँकि मैं इस लिए तुझ पर ज़ाहिर हुआ हूँ, कि तुझे उन चीज़ों का भी ख़ादिम और गवाह मुक़र्रर करूँ जिनकी गवाही के लिए तू ने मुझे देखा है, और उन का भी जिनकी गवाही के लिए में तुझ पर ज़ाहिर हुआ करूँगा।</char> <verse eid="ACT 26:16"/><verse number="17" style="v" sid="ACT 26:17"/><char style="wj">और मैं तुझे इस उम्मत और ग़ैर क़ौमों से बचाता रहूँगा। जिन के पास तुझे इसलिए भेजता हूँ।</char> <verse eid="ACT 26:17"/><verse number="18" style="v" sid="ACT 26:18"/><char style="wj">कि तू उन की आँखें खोल दे ताकि अन्धेरे से रोशनी की तरफ़ और शैतान के इख़्तियार से ख़ुदा की तरफ़ रुजू लाएँ, और मुझ पर ईमान लाने के ज़रिए गुनाहों की मु'आफ़ी और मुक़द्दसों में शरीक हो कर मीरास पाएँ।”</char><verse eid="ACT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19"/>इसलिए ऐ अग्रिप्पा बादशाह! मैं उस आसमानी रोया का नाफ़रमान न हुआ। <verse eid="ACT 26:19"/><verse number="20" style="v" sid="ACT 26:20"/>बल्कि पहले दमिश्क़ियों को फिर येरूशलेम और सारे मुल्क यहूदिया के बाशिन्दों को और ग़ैर क़ौमों को समझाता रहा। कि तौबा करें और ख़ुदा की तरफ़ रजू लाकर तौबा के मुवाफ़िक़ काम करें। <verse eid="ACT 26:20"/><verse number="21" style="v" sid="ACT 26:21"/>इन्ही बातों की वजह से कुछ यहूदियों ने मुझे हैकल में पकड़ कर मार डालने की कोशिश की।<verse eid="ACT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 26:22"/>लेकिन ख़ुदा की मदद से मैं आज तक क़ाईम हूँ, और छोटे बड़े के सामने गवाही देता हूँ, और उन बातों के सिवा कुछ नहीं कहता जिनकी पेशीनगोई नबियों और मूसा ने भी की है। <verse eid="ACT 26:22"/><verse number="23" style="v" sid="ACT 26:23"/>कि “मसीह को दुःख: उठाना ज़रूर है और सब से पहले वही मुर्दों में से ज़िन्दा हो कर इस उम्मत को और ग़ैर क़ौमों को भी नूर का इश्तिहार देगा।”<verse eid="ACT 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24"/>जब वो इस तरह जवाबदेही कर रहा था, तो फ़ेस्तुस ने बड़ी आवाज़ से कहा “ऐ पौलुस तू दिवाना है; बहुत इल्म ने तुझे दिवाना कर दिया है।” <verse eid="ACT 26:24"/><verse number="25" style="v" sid="ACT 26:25"/>पौलुस ने कहा, ऐ फ़ेस्तुस बहादुर; मैं दिवाना नहीं बल्कि सच्चाई और होशियारी की बातें कहता हूँ। <verse eid="ACT 26:25"/><verse number="26" style="v" sid="ACT 26:26"/>चुनाँचे बादशाह जिससे मैं दिलेराना कलाम करता हूँ, ये बातें जानता है और मुझे यक़ीन है कि इन बातों में से कोई उस से छिपी नहीं। क्यूँकि ये माजरा कहीं कोने में नहीं हुआ।<verse eid="ACT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 26:27"/>ऐ अग्रिप्पा बादशाह, क्या तू नबियों का यक़ीन करता है? मैं जानता हूँ, कि तू यक़ीन करता है। <verse eid="ACT 26:27"/><verse number="28" style="v" sid="ACT 26:28"/>अग्रिप्पा ने पौलुस से कहा, तू तो थोड़ी ही सी नसीहत कर के मुझे मसीह कर लेना चाहता है। <verse eid="ACT 26:28"/><verse number="29" style="v" sid="ACT 26:29"/>पौलुस ने कहा, मैं तो ख़ुदा से चाहता हूँ, कि थोड़ी नसीहत से या बहुत से सिर्फ़ तू ही नहीं बल्कि जितने लोग आज मेरी सुनते हैं, मेरी तरह हो जाएँ, सिवा इन ज़ंजीरों के।<verse eid="ACT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30"/>तब बादशाह और हाकिम और बरनीकि और उनके हमनशीन उठ खड़े हुए, <verse eid="ACT 26:30"/><verse number="31" style="v" sid="ACT 26:31"/>और अलग जाकर एक दूसरे से बातें करने और कहने लगे, कि ये आदमी ऐसा तो कुछ नहीं करता जो क़त्ल या क़ैद के लायक़ हो। <verse eid="ACT 26:31"/><verse number="32" style="v" sid="ACT 26:32"/>अग्रिप्पा ने फ़ेस्तुस से कहा, कि अगर ये आदमी क़ैसर के यहाँ फ़रियाद न करता तो छूट सकता था।<verse eid="ACT 26:32"/></para>
  <chapter eid="ACT 26"/>
  <chapter number="27" style="c" sid="ACT 27"/>
  <para style="s">पौलुस का रोम को जाना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1"/>जब जहाज़ पर इतालिया को हमारा जाना ठहराया गया तो उन्होंने पौलुस और कुछ और क़ैदियों को शहन्शाही पलटन के एक सुबेदार अगस्तुस ने यूलियुस नाम के हवाले किया। <verse eid="ACT 27:1"/><verse number="2" style="v" sid="ACT 27:2"/>और हम अद्रमुतय्युस के एक जहाज़ पर जो आसिया के किनारे के बन्दरगाहों में जाने को था। सवार होकर रवाना हुए और थिस्सलुनीकियों का अरिस्तरख़ुस मकिदुनी हमारे साथ था।<verse eid="ACT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3"/>दूसरे दिन सैदा में जहाज़ ठहराया, और यूलियुस ने पौलुस पर मेहरबानी करके दोस्तों के पास जाने की इजाज़त दी। ताकि उस की ख़ातिरदारी हो। <verse eid="ACT 27:3"/><verse number="4" style="v" sid="ACT 27:4"/>वहाँ से हम रवाना हुए और कुप्रुस की आड़ में होकर चले इसलिए कि हवा मुख़ालिफ़ थी। <verse eid="ACT 27:4"/><verse number="5" style="v" sid="ACT 27:5"/>फिर किलकिया और पम्फ़ीलिया सूबे के समुन्दर से गुज़र कर लूकिया के शहर मूरा में उतरे। <verse eid="ACT 27:5"/><verse number="6" style="v" sid="ACT 27:6"/>वहाँ सुबेदार को इस्कन्दरिया का एक जहाज़ इतालिया जाता हुआ, मिला पस, हमको उस में बैठा दिया।<verse eid="ACT 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7"/>और हम बहुत दिनों तक आहिस्ता आहिस्ता चलकर मुश्किल से कनिदुस शहर के सामने पहुँचे तो इसलिए कि हवा हम को आगे बढ़ने न देती थी सलमूने के सामने से हो कर करेते टापू की आड़ में चले। <verse eid="ACT 27:7"/><verse number="8" style="v" sid="ACT 27:8"/>और बमुश्किल उसके किनारे किनारे चलकर हसीन — बन्दर नाम एक मक़ाम में पहुँचे जिस से लसया शहर नज़दीक था।<verse eid="ACT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9"/>जब बहुत अरसा गुज़र गया और जहाज़ का सफ़र इसलिए ख़तरनाक हो गया कि रोज़ा का दिन गुज़र चुका था। तो पौलुस ने उन्हें ये कह कर नसीहत की। <verse eid="ACT 27:9"/><verse number="10" style="v" sid="ACT 27:10"/>कि ऐ साहिबो। मुझे मालूम होता है, कि इस सफ़र में तकलीफ़ और बहुत नुक़्सान होगा, न सिर्फ़ माल और जहाज़ का बल्कि हमारी जानों का भी। <verse eid="ACT 27:10"/><verse number="11" style="v" sid="ACT 27:11"/>मगर सुबेदार ने नाख़ुदा और जहाज़ के मालिक की बातों पर पौलुस की बातों से ज़्यादा लिहाज़ किया।<verse eid="ACT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 27:12"/>और चूँकि वो बन्दरगाह जाड़ों में रहने कि लिए अच्छा न था, इसलिए अक्सर लोगों की सलाह ठहरी कि वहाँ से रवाना हों, और अगर हो सके तो फ़ेनिक्स शहर में पहुँच कर जाड़ा काटें; वो करेते का एक बन्दरगाह है जिसका रुख शिमाल मशरिक़ और जुनूब मशरिक़ को है।<verse eid="ACT 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13"/>जब कुछ कुछ दक्खिना हवा चलने लगी तो उन्हों ने ये समझ कर कि हमारा मतलब हासिल हो गया लंगर उठाया और करेते के किनारे के क़रीब क़रीब चले।<verse eid="ACT 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 27:14"/>लेकिन थोड़ी देर बाद एक बड़ी तुफ़ानी हवा जो यूरकुलोन कहलाती है करेते पर से जहाज़ पर आई। <verse eid="ACT 27:14"/><verse number="15" style="v" sid="ACT 27:15"/>और जब जहाज़ हवा के क़ाबू में आ गया, और उस का सामना न कर सका, तो हम ने लाचार होकर उसको बहने दिया। <verse eid="ACT 27:15"/><verse number="16" style="v" sid="ACT 27:16"/>और कौदा नाम एक छोटे टापू की आड़ में बहते बहते हम बड़ी मुश्किल से डोंगी को क़ाबू में लाए।<verse eid="ACT 27:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 27:17"/>और जब मल्लाह उस को उपर चढ़ा चुके तो जहाज़ की मज़बूती की तदबीरें करके उसको नीचे से बाँधा, और सूरतिस के चोर बालू में धंस जाने के डर से जहाज़ का साज़ो सामान उतार लिया। और उसी तरह बहते चले गए। <verse eid="ACT 27:17"/><verse number="18" style="v" sid="ACT 27:18"/>मगर जब हम ने आँधी से बहुत हिचकोले खाए तो दूसरे दिन वो जहाज़ का माल फेंकने लगे।<verse eid="ACT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 27:19"/>और तीसरे दिन उन्हों ने अपने ही हाथों से जहाज़ के कुछ आलात — ओ — 'असबाब भी फेंक दिए। <verse eid="ACT 27:19"/><verse number="20" style="v" sid="ACT 27:20"/>जब बहुत दिनों तक न सूरज नज़र आया न तारे और शिद्दत की आँधी चल रही थी, तो आख़िर हम को बचने की उम्मीद बिल्कुल न रही।<verse eid="ACT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21"/>और जब बहुत फ़ाक़ा कर चुके तो पौलुस ने उन के बीच में खड़े हो कर कहा, ऐ साहिबो; लाज़िम था, कि तुम मेरी बात मान कर करेते से रवाना न होते और ये तकलीफ़ और नुक़्सान न उठाते।<verse eid="ACT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 27:22"/>मगर अब मैं तुम को नसीहत करता हूँ कि इत्मीनान रख्खो; क्यूँकि तुम में से किसी का नुक़्सान न होगा मगर जहाज़ का। <verse eid="ACT 27:22"/><verse number="23" style="v" sid="ACT 27:23"/>क्यूँकि ख़ुदा जिसका मैं हूँ, और जिसकी इबादत भी करता हूँ, उसके फ़रिश्ते ने इसी रात को मेरे पास आकर। <verse eid="ACT 27:23"/><verse number="24" style="v" sid="ACT 27:24"/>कहा, पौलुस, न डर। ज़रूरी है कि तू क़ैसर के सामने हाज़िर हो, और देख जितने लोग तेरे साथ जहाज़ में सवार हैं, उन सब की ख़ुदा ने तेरी ख़ातिर जान बख़्शी की। <verse eid="ACT 27:24"/><verse number="25" style="v" sid="ACT 27:25"/>इसलिए “ऐ साहिबो; इत्मीनान रख्खो; क्यूँकि मैं ख़ुदा का यक़ीन करता हूँ, कि जैसा मुझ से कहा गया है, वैसा ही होगा। <verse eid="ACT 27:25"/><verse number="26" style="v" sid="ACT 27:26"/>लेकिन ये ज़रूर है कि हम किसी टापू में जा पड़ें”<verse eid="ACT 27:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27"/>जब चौधवीं रात हुई और हम बहर — ए — अद्रिया में टकराते फिरते थे, तो आधी रात के क़रीब मल्लाहों ने अंदाज़े से मा'लूम किया कि किसी मुल्क के नज़दीक पहुँच गए। <verse eid="ACT 27:27"/><verse number="28" style="v" sid="ACT 27:28"/>और पानी की थाह लेकर बीस पुर्सा पाया और थोड़ा आगे बढ़ कर और फिर थाह लेकर पन्द्रह पुर्सा पाया। <verse eid="ACT 27:28"/><verse number="29" style="v" sid="ACT 27:29"/>और इस डर से कि पथरीली चट्टानों पर जा पड़ें, जहाज़ के पीछे से चार लंगर डाले और सुबह होने के लिए दुआ करते रहे।<verse eid="ACT 27:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 27:30"/>और जब मल्लाहों ने चाहा कि जहाज़ पर से भाग जाएँ, और इस बहाने से कि गलही से लंगर डालें, डोंगी को समुन्दर में उतारें। <verse eid="ACT 27:30"/><verse number="31" style="v" sid="ACT 27:31"/>तो पौलुस ने सुबेदार और सिपाहियों से कहा “अगर ये जहाज़ पर न रहेंगे तो तुम नहीं बच सकते।” <verse eid="ACT 27:31"/><verse number="32" style="v" sid="ACT 27:32"/>इस पर सिपाहियों ने डोंगी की रस्सियाँ काट कर उसे छोड़ दिया।<verse eid="ACT 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33"/>और जब दिन निकलने को हुआ तो पौलुस ने सब की मिन्नत की कि खाना खालो और कहा कि तुम को इन्तज़ार करते करते और फ़ाक़ा करते करते आज चौदह दिन हो गए; और तुम ने कुछ नहीं खाया। <verse eid="ACT 27:33"/><verse number="34" style="v" sid="ACT 27:34"/>इसलिए तुम्हारी मिन्नत करता हूँ कि खाना खालो, इसी में तुम्हारी बहतरी मौक़ूफ़ है, और तुम में से किसी के सिर का बाल बाका न होगा। <verse eid="ACT 27:34"/><verse number="35" style="v" sid="ACT 27:35"/>ये कह कर उस ने रोटी ली और उन सब के सामने ख़ुदा का शुक्र किया, और तोड़ कर खाने लगा।<verse eid="ACT 27:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 27:36"/>फिर उन सब की ख़ातिर जमा हुई, और आप भी खाना खाने लगे। <verse eid="ACT 27:36"/><verse number="37" style="v" sid="ACT 27:37"/>और हम सब मिलकर जहाज़ में दो सौ छिहत्तर आदमी थे। <verse eid="ACT 27:37"/><verse number="38" style="v" sid="ACT 27:38"/>जब वो खा कर सेर हुए तो गेहूँ को समुन्दर में फेंक कर जहाज़ को हल्का करने लगे।<verse eid="ACT 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39"/>जब दिन निकल आया तो उन्होंने उस मुल्क को न पहचाना, मगर एक खाड़ी देखी, जिसका किनारा साफ़ था, और सलाह की कि अगर हो सके तो जहाज़ को उस पर चढ़ा लें। <verse eid="ACT 27:39"/><verse number="40" style="v" sid="ACT 27:40"/>पस, लंगर खोल कर समुन्दर में छोड़ दिए, और पत्वारों की भी रस्सियाँ खोल दी; और अगला पाल हवा के रुख पर चढ़ा कर उस किनारे की तरफ़ चले। <verse eid="ACT 27:40"/><verse number="41" style="v" sid="ACT 27:41"/>लेकिन एक ऐसी जगह जा पड़े जिसके दोनों तरफ़ समुन्दर का ज़ोर था; और जहाज़ ज़मीन पर टिक गया, पस गलही तो धक्का खाकर फ़ँस गई; मगर दुम्बाला लहरों के ज़ोर से टूटने लगा।<verse eid="ACT 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42"/>और सिपाहियों की ये सलाह थी, कि क़ैदियों को मार डालें, कि ऐसा न हो कोई तैर कर भाग जाए। <verse eid="ACT 27:42"/><verse number="43" style="v" sid="ACT 27:43"/>लेकिन सुबेदार ने पौलुस को बचाने की ग़रज़ से उन्हें इस इरादे से बाज़ रख्खा; और हुक्म दिया कि जो तैर सकते हैं, पहले कूद कर किनारे पर चले जाएँ। <verse eid="ACT 27:43"/><verse number="44" style="v" sid="ACT 27:44"/>बाक़ी लोग कुछ तख़्तों पर और कुछ जहाज़ की और चीज़ों के सहारे से चले जाएँ; इसी तरह सब के सब ख़ुश्की पर सलामत पहुँच गए।<verse eid="ACT 27:44"/></para>
  <chapter eid="ACT 27"/>
  <chapter number="28" style="c" sid="ACT 28"/>
  <para style="s">पौलुस माल्टा के टापू पर</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1"/>जब हम पहुँच गए तो जाना कि इस टापू का नाम मिलिते है, <verse eid="ACT 28:1"/><verse number="2" style="v" sid="ACT 28:2"/>और उन अजनबियों ने हम पर ख़ास महरबानी की, क्यूँकि बारिश की झड़ी और जाड़े की वजह से उन्होंने आग जलाकर हम सब की ख़ातिर की।<verse eid="ACT 28:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 28:3"/>जब पौलुस ने लकड़ियों का गट्ठा जमा करके आग में डाला तो एक साँप गर्मी पा कर निकला और उसके हाथ पर लिपट गया। <verse eid="ACT 28:3"/><verse number="4" style="v" sid="ACT 28:4"/>जिस वक़्त उन अजनबियों ने वो कीड़ा उसके हाथ से लटका हुआ देखा तो एक दूसरे से कहने लगे, बेशक ये आदमी ख़ूनी है: अगरचे समुन्दर से बच गया तो भी अदल उसे जीने नहीं देता।<verse eid="ACT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 28:5"/>पस, उस ने कीड़े को आग में झटक दिया और उसे कुछ तकलीफ़ न पहुँची। <verse eid="ACT 28:5"/><verse number="6" style="v" sid="ACT 28:6"/>मगर वो मुन्तज़िर थे, कि इस का बदन सूज जाएगा:या ये मरकर यकायक गिर पड़ेगा लेकिन जब देर तक इन्तज़ार किया और देखा कि उसको कुछ तकलीफ़ न पहुँची तो और ख़याल करके कहा, ये तो कोई देवता है।<verse eid="ACT 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7"/>वहाँ से क़रीब पुबलियुस नाम उस टापू के सरदार की मिल्कियत थी; उस ने घर लेजाकर तीन दिन तक बड़ी महरबानी से हमारी मेहमानी की। <verse eid="ACT 28:7"/><verse number="8" style="v" sid="ACT 28:8"/>और ऐसा हुआ, कि पुबलियुस का बाप बुख़ार और पेचिश की वजह से बीमार पड़ा था; पौलुस ने उसके पास जाकर दुआ की और उस पर हाथ रखकर शिफ़ा दी। <verse eid="ACT 28:8"/><verse number="9" style="v" sid="ACT 28:9"/>जब ऐसा हुआ तो बाक़ी लोग जो उस टापू में बीमार थे, आए और अच्छे किए गए। <verse eid="ACT 28:9"/><verse number="10" style="v" sid="ACT 28:10"/>और उन्होंने हमारी बड़ी 'इज़्ज़त की और चलते वक़्त जो कुछ हमें दरकार था; जहाज़ पर रख दिया।<verse eid="ACT 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11"/>तीन महीने के बाद हम इसकन्दरिया के एक जहाज़ पर रवाना हुए जो जाड़े भर 'उस टापू में रहा था जिसका निशान दियुसकूरी था <verse eid="ACT 28:11"/><verse number="12" style="v" sid="ACT 28:12"/>और सुरकूसा में जहाज़ ठहरा कर तीन दिन रहे।<verse eid="ACT 28:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 28:13"/>और वहाँ से फेर खाकर रेगियूम बन्दरगाह में आए। एक रोज़ बाद दक्खिन हवा चली तो दूसरे दिन पुतियुली शहर में आए। <verse eid="ACT 28:13"/><verse number="14" style="v" sid="ACT 28:14"/>वहाँ हम को भाई मिले, और उनकी मिन्नत से हम सात दिन उन के पास रहे; और इसी तरह रोमा तक गए। <verse eid="ACT 28:14"/><verse number="15" style="v" sid="ACT 28:15"/>वहाँ से भाई हमारी ख़बर सुनकर अप्पियुस के चौक और तीन सराय तक हमारे इस्तक़बाल को आए। पौलुस ने उन्हें देखकर ख़ुदा का शुक्र किया और उसके ख़ातिर जमा हुई।<verse eid="ACT 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16"/>जब हम रोम में पहुँचे तो पौलुस को इजाज़त हुई, कि अकेला उस सिपाही के साथ रहे, जो उस पर पहरा देता था।<verse eid="ACT 28:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17"/>तीन रोज़ के बाद ऐसा हुआ कि उस ने यहूदियों के रईसों को बुलवाया और जब जमा हो गए, तो उन से कहा, ऐ भाइयों हर वक़्त पर मैंने उम्मत और बाप दादा की रस्मों के ख़िलाफ़ कुछ नहीं किया। तोभी येरूशलेम से क़ैदी होकर रोमियों के हाथ हवाले किया गया। <verse eid="ACT 28:17"/><verse number="18" style="v" sid="ACT 28:18"/>उन्होंने मेरी तहक़ीक़ात करके मुझे छोड़ देना चाहा; क्यूँकि मेरे क़त्ल की कोई वजह न थी।<verse eid="ACT 28:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 28:19"/>मगर जब यहूदियों ने मुख़ालिफ़त की तो मैंने लाचार होकर क़ैसर के यहाँ फ़रियाद की मगर इस वास्ते नहीं कि अपनी क़ौम पर मुझे कुछ इल्ज़ाम लगाना है, <verse eid="ACT 28:19"/><verse number="20" style="v" sid="ACT 28:20"/>पस, इसलिए मैंने तुम्हें बुलाया है कि तुम से मिलूँ और गुफ़्तगू करूँ, क्यूँकि इस्राईल की उम्मीद की वजह से मैं इस ज़ंजीर से जकड़ा हुआ हूँ,<verse eid="ACT 28:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21"/>उन्होंने कहा “न हमारे पास यहूदिया से तेरे बारे में ख़त आए, न भाइयों में से किसी ने आ कर तेरी कुछ ख़बर दी न बुराई बयान की। <verse eid="ACT 28:21"/><verse number="22" style="v" sid="ACT 28:22"/>मगर हम मुनासिब जानते हैं कि तुझ से सुनें, कि तेरे ख़यालात क्या हैं; क्यूँकि इस फ़िर्के की वजह हम को मा'लूम है कि हर जगह इसके ख़िलाफ़ कहते हैं।”<verse eid="ACT 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23"/>और वो उस से एक दिन ठहरा कर कसरत से उसके यहाँ जमा हुए, और वो ख़ुदा की बादशाही की गवाही दे दे कर और मूसा की तौरेत और नबियों के सहीफ़ों से ईसा की वजह समझा समझा कर सुबह से शाम तक उन से बयान करता रहा। <verse eid="ACT 28:23"/><verse number="24" style="v" sid="ACT 28:24"/>और कुछ ने उसकी बातों को मान लिया, और कुछ ने न माना।<verse eid="ACT 28:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 28:25"/>जब आपस में मुत्तफ़िक़ न हुए, तो पौलुस की इस एक बात के कहने पर रुख़्सत हुए; कि रूह — उल क़ुद्दूस ने यसा'याह नबी के ज़रिए तुम्हारे बाप दादा से ख़ूब कहा कि। <verse eid="ACT 28:25"/><verse number="26" style="v" sid="ACT 28:26"/>इस उम्मत के पास जाकर कह</para>
  <para style="q" vid="ACT 28:26">कि तुम कानों से सुनोगे और हर्गिज़ न समझोगे</para>
  <para style="q" vid="ACT 28:26">और आँखों से देखोगे और हर्गिज़ मा'लूम न करोगे।<verse eid="ACT 28:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 28:27"/>क्यूँकि इस उम्मत के दिल पर चर्बी छा गई है,</para>
  <para style="q" vid="ACT 28:27">'और वो कानों से ऊँचा सुनते हैं,</para>
  <para style="q" vid="ACT 28:27">और उन्होंने अपनी आँखें बन्द कर ली हैं,</para>
  <para style="q" vid="ACT 28:27">कहीं ऐसा न हो कि आँखों से मा'लूम करें,</para>
  <para style="q" vid="ACT 28:27">और कानों से सुनें,</para>
  <para style="q" vid="ACT 28:27">और दिल से समझें,</para>
  <para style="q" vid="ACT 28:27">और रुजू लाएँ,</para>
  <para style="q" vid="ACT 28:27">और मैं उन्हें शिफ़ा बख़्शूँ।<verse eid="ACT 28:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28"/>“पस, तुम को मा'लूम हो कि ख़ुदा! की इस नजात का पैग़ाम ग़ैर क़ौमों के पास भेजा गया है, और वो उसे सुन भी लेंगी”<verse eid="ACT 28:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 28:29"/>[जब उस ने ये कहा तो यहूदी आपस में बहुत बहस करते चले गए।]<verse eid="ACT 28:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30"/>और वो पूरे दो बरस अपने किराए के घर में रहा। <verse eid="ACT 28:30"/><verse number="31" style="v" sid="ACT 28:31"/>और जो उसके पास आते थे, उन सब से मिलता रहा; और कमाल दिलेरी से बग़ैर रोक टोक के ख़ुदा की बादशाही का ऐलान करता और ख़ुदावन्द ईसा मसीह की बातें सिखाता रहा।<verse eid="ACT 28:31"/></para>
  <chapter eid="ACT 28"/>
</usx>
