<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TH" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">1 थिस्सलुनीकियों</para>
  <para style="toc1">1 थिस्सलुनीकियों</para>
  <para style="toc2">1 थिस्स</para>
  <para style="toc3">1 थिस्स</para>
  <para style="mt">थिस्सलुनीकियों के नाम पौलुस रसूल पहला का ख़त</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">1 दो बार पौलूस रसूल इस ख़त का मुसन्निफ़ होने बतौर पहचाना गया है; (1:1; 2:18) सिलास और तीमुथियुस (3:2, 6) पौलूस के दूसरे मिश्नरी सफ़र में हमसफ़र थे उस वक़्त इस कलीसिया की बुनियाद डली थी (आमाल 17:1, 9) सो पौलूस ने थिसलुनीका छोड़ने के कुछ ही महिने बाद इस ख़त को लिखा। वाज़ेह तौर से थिसलुनी के में पौलूस की खि़दमत गुज़ारी ने न सिर्फ़ यहूदियों पर बल्कि ग़ैर यहूदियों पर भी असर डाला था। कलीसिया में कई एक ग़ैर क़ौम वाले बुतपरस्ती से बाहर आये थे इस के बावजूद भी उस वक़्त के यहूदियों के लिए यह कोई ख़ास मसला नहीं था (1 थिसलुनीकियों 1:9)।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इस ख़त को तक़रीबन 51 ईस्वी के बीच लिखा गया था।</para>
  <para style="ip">पौलूस ने 1 थिसलुनीकियों के ख़त को जो वहां की कलीसिया के नाम थी कुरिन्थ शहर से लिखा।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">1 थिसलुनीकियों 1:1 का हवाला इस कलीसिया के लिए पहले ख़त के क़ारिईन बतौर पहचान करती है जबकि आम तौर से देखा जाए तो यह ख़त तमाम मसीहियों के लिए है।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">इस ख़त को लिखने का पौलस का मक़्सद यह था कि नए मसीहियों की उनकी आज़्मायशों के दौरान हौसला अफ़्ज़ाई करें (3:4 — 5) उन्हें परहेज़गारी की ज़िन्दगी की बाबत नसीहत दे (4:1 — 12) और जो मसीह की दुबारा आमद से पहले मरते हैं उन्हें मुस्तक़बिल की ज़िन्दगी का यक़ीन दिलाने के लिए (4:13 — 18) और दीगर अख़लाक़ी और अमली मुआमलों को सुधारने के लिए।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">कलीसिया के लिए फ़िक्र।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. शुक्रगुज़ारी — 1:1-10</para>
  <para style="io1">2. रिसालती अमल का बचाव — 2:1-3:13</para>
  <para style="io1">3. थिसलुनीके की कलीसिया के लिए नसीहत — 4:1-5:22</para>
  <para style="io1">4. इख़तितामी दुआ और बर्कत के कलिमात — 5:23-28</para>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="s">पौलुस का सलाम</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1"/>पौलुस और सिलास और तीमुथियुस की तरफ़ से थिस्सलुनीकियों शहर की कलीसिया के नाम ख़त, जो ख़ुदा बाप और ख़ुदा वन्द ईसा मसीह में है, फ़ज़ल और इत्मीनान तुम्हें हासिल होता रहे।<verse eid="1TH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>तुम सब के बारे में हम ख़ुदा का शुक्र बजा लाते हैं और अपनी दु'आओं में तुम्हें याद करते हैं। <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>और अपने ख़ुदा और बाप के हज़ूर तुम्हारे ईमान के काम और मुहब्बत की मेहनत और उस उम्मीद के सब्र को बिला नाग़ा याद करते हैं जो हमारे ख़ुदावन्द ईसा मसीह की वजह से है।<verse eid="1TH 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4"/>और ऐ भाइयों! ख़ुदा के प्यारों हम को मा'लूम है; कि तुम चुने हुए हो। <verse eid="1TH 1:4"/><verse number="5" style="v" sid="1TH 1:5"/>इसलिए कि हमारी ख़ुशख़बरी तुम्हारे पास न फ़क़त लफ़ज़ी तौर पर पहुँची बल्कि क़ुदरत और रूह — उल — क़ुद्दूस और पूरे यक़ीन के साथ भी चुनाँचे तुम जानते हो कि हम तुम्हारी ख़ातिर तुम में कैसे बन गए थे।<verse eid="1TH 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 1:6"/>और तुम कलाम को बड़ी मुसीबत में रूह — उल — क़ुद्दूस की ख़ुशी के साथ क़ुबूल करके हमारी और ख़ुदावन्द की मानिन्द बने। <verse eid="1TH 1:6"/><verse number="7" style="v" sid="1TH 1:7"/>यहाँ तक कि मकिदुनिया और अख़िया के सब ईमानदारों के लिए नमूना बने।<verse eid="1TH 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TH 1:8"/>क्यूँकि तुम्हारे हाँ से न फ़क़त मकिदुनिया और अख़िया में ख़ुदावन्द के कलाम का चर्चा फैला है, बल्कि तुम्हारा ईमान जो ख़ुदा पर है हर जगह ऐसा मशहूर हो गया है कि हमारे कहने की कुछ ज़रुरत नहीं। <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>इसलिए कि वो आप हमारा ज़िक्र करते हैं कि तुम्हारे पास हमारा आना कैसा हुआ और तुम बुतों से फिर कर ख़ुदा की तरफ़ मुख़ातिब हुए ताकि ज़िन्दा और हक़ीक़ी ख़ुदा की बन्दगी करो। <verse eid="1TH 1:9"/><verse number="10" style="v" sid="1TH 1:10"/>और उसके बेटे के आसमान पर से आने के इन्तिज़ार में रहो, जिसे उस ने मुर्दों में से जिलाया या'नी ईसा मसीह के जो हम को आने वाले ग़ज़ब से बचाता है।<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="s">पौलुस का अपने आने को याद रखना</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>ऐ भाइयों! तुम आप जानते हो कि हमारा तुम्हारे पास आना बेफ़ाइदा न हुआ। <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/>बल्कि तुम को मा'लूम ही है कि बावजूद पहले फ़िलिप्पी में दु:ख उठाने और बेइज़्ज़त होने के हम को अपने ख़ुदा में ये दिलेरी हासिल हुई कि ख़ुदा की ख़ुशख़बरी बड़ी जाँफ़िशानी से तुम्हें सुनाएँ।<verse eid="1TH 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 2:3"/>क्यूँकि हमारी नसीहत न गुमराही से है न नापाकी से न धोखे के साथ। <verse eid="1TH 2:3"/><verse number="4" style="v" sid="1TH 2:4"/>बल्कि जैसे ख़ुदा ने हम को मक़्बूल करके ख़ुशख़बरी हमारे सुपुर्द की वैसे ही हम बयान करते हैं; आदमियों को नहीं बल्कि ख़ुदा को ख़ुश करने के लिए जो हमारे दिलों को आज़माता है।<verse eid="1TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1TH 2:5"/>क्यूँकि तुम को मा'लूम ही है कि न कभी हमारे कलाम में ख़ुशामद पाई गई न लालच का पर्दा बना ख़ुदा इसका गवाह है! <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>और हम न आदमियों से इज़्ज़त चाहते हैं न तुम से न औरों से अगरचे मसीह के रसूल होने की वजह तुम पर बोझ डाल सकते थे।<verse eid="1TH 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 2:7"/>बल्कि जिस तरह माँ अपने बच्चों को पालती है उसी तरह हम तुम्हारे दर्मियान नर्मी के साथ रहे। <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>और उसी तरह हम तुम्हारे बहुत अहसानमंद होकर न फ़क़त ख़ुदा की ख़ुशख़बरी बल्कि अपनी जान तक भी तुम्हें देने को राज़ी थे; इस वास्ते कि तुम हमारे प्यारे हो गए थे! <verse eid="1TH 2:8"/><verse number="9" style="v" sid="1TH 2:9"/>क्यूँकि ऐ भाइयों! तुम को हमारी मेहनत और मशक़्क़त याद होगी कि हम ने तुम में से किसी पर बोझ न डालने की ग़रज़ से रात दिन मेहनत मज़दूरी करके तुम्हें ख़ुदा की ख़ुशख़बरी की मनादी की।<verse eid="1TH 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10"/>तुम भी गवाह हो और ख़ुदा भी कि तुम से जो ईमान लाए हो हम कैसी पाकीज़गी और रास्तबाज़ी और बे'ऐबी के साथ पेश आए। <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>चुनाँचे तुम जानते हो। कि जिस तरह बाप अपने बच्चों के साथ करता है उसी तरह हम भी तुम में से हर एक को नसीहत करते और दिलासा देते और समझाते रहे। <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>ताकि तुम्हारा चालचलन ख़ुदा के लायक़ हो जो तुम्हें अपनी बादशाही और जलाल में बुलाता है।<verse eid="1TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>इस वास्ते हम भी बिला नाग़ा ख़ुदा का शुक्र करते हैं कि जब ख़ुदा का पैग़ाम हमारे ज़रिए तुम्हारे पास पहुँचा तो तुम ने उसे आदमियों का कलाम समझ कर नहीं बल्कि जैसा हक़ीक़त में है ख़ुदा का कलाम जान कर क़ुबूल किया और वो तुम में जो ईमान लाए हो असर भी कर रहा है।<verse eid="1TH 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 2:14"/>इसलिए कि तुम ऐ भाइयों!, ख़ुदा की उन कलीसियाओं की तरह बन गए जो यहूदिया में मसीह ईसा में हैं क्यूँकि तुम ने भी अपनी क़ौम वालों से वही तकलीफ़ें उठाईं जो उन्होंने यहूदियों से। <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/>जिन्होंने ख़ुदावन्द ईसा को भी मार डाला और हम को सता सता कर निकाल दिया वो ख़ुदा को पसन्द नहीं आते और सब आदमियों के ख़िलाफ़ हैं। <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>और वो हमें ग़ैर क़ौमों को उनकी नजात के लिए कलाम सुनाने से मनह करते हैं ताकि उन के गुनाहों का पैमाना हमेशा भरता रहे; लेकिन उन पर इन्तिहा का ग़ज़ब आ गया।<verse eid="1TH 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>ऐ भाइयों! जब हम थोड़े अर्से के लिए ज़ाहिर में न कि दिल से तुम से जुदा हो गए तो हम ने कमाल आरज़ू से तुम्हारी सूरत देखने की और भी ज़्यादा कोशिश की। <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>इस वास्ते हम ने या'नी मुझ पौलुस ने एक दफ़ा' नहीं बल्कि दो दफ़ा' तुम्हारी पास आना चाहा मगर शैतान ने हमें रोके रखा। <verse eid="1TH 2:18"/><verse number="19" style="v" sid="1TH 2:19"/>भला हमारी उम्मीद और ख़ुशी और फ़ख़्र का ताज क्या है? क्या वो हमारे ख़ुदावन्द के सामने उसके आने के वक़्त तुम ही न होगे। <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>हमारा जलाल और ख़ुशी तुम्हीं तो हो।<verse eid="1TH 2:20"/></para>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>इस वास्ते जब हम ज़्यादा बर्दाश्त न कर सके तो अथेने शहर में अकेले रह जाना मन्ज़ूर किया। <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>और हम ने तीमुथियुस को जो हमारा भाई और मसीह की ख़ुशख़बरी में ख़ुदा का ख़ादिम है इसलिए भेजा कि वो तुम्हें मज़बूत करे और तुम्हारे ईमान के बारे में तुम्हें नसीहत करे। <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>कि इन मुसीबतों के ज़रिए से कोई न घबराए, क्यूँकि तुम आप जानते हो कि हम इन ही के लिए मुक़र्रर हुए हैं।<verse eid="1TH 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 3:4"/>बल्कि पहले भी जब हम तुम्हारे पास थे, तो तुम से कहा करते थे; कि हमें मुसीबत उठाना होगा, चुनाँचे ऐसा ही हुआ और तुम्हें मा'लूम भी है। <verse eid="1TH 3:4"/><verse number="5" style="v" sid="1TH 3:5"/>इस वास्ते जब मैं और ज़्यादा बर्दाश्त न कर सका तो तुम्हारे ईमान का हाल दरियाफ़्त करने को भेजा; कहीं ऐसा न हो कि आज़माने वाले ने तुम्हें आज़माया हो और हमारी मेहनत बेफ़ाइदा रह गई हो।<verse eid="1TH 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6"/>मगर अब जो तीमुथियुस ने तुम्हारे पास से हमारे पास आकर तुम्हारे ईमान और मुहब्बत की और इस बात की ख़ुशख़बरी दी कि तुम हमारा ज़िक्र ख़ैर हमेशा करते हो और हमारे देखने के ऐसे मुश्ताक़ हो जैसे कि हम तुम्हारे। <verse eid="1TH 3:6"/><verse number="7" style="v" sid="1TH 3:7"/>इसलिए ऐ भाइयों! हम ने अपनी सारी एहतियाज और मुसीबत में तुम्हारे ईमान के ज़रिए से तुम्हारे बारे में तसल्ली पाई।<verse eid="1TH 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TH 3:8"/>क्यूँकि अब अगर तुम ख़ुदावन्द में क़ाईम हो तो हम ज़िन्दा हैं। <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>तुम्हारी वजह से अपने ख़ुदा के सामने हमें जिस क़दर ख़ुशी हासिल है, उस के बदले में किस तरह तुम्हारे ज़रिए ख़ुदा का शुक्र अदा करें। <verse eid="1TH 3:9"/><verse number="10" style="v" sid="1TH 3:10"/>हम रात दिन बहुत ही दुआ करते रहते हैं कि तुम्हारी सूरत देखें और तुम्हारे ईमान की कमी पूरी करें।<verse eid="1TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>अब हमारा ख़ुदा और बाप ख़ुद हमारा ख़ुदावन्द ईसा तुम्हारी तरफ़ से हमारी रहनुमाई करे। <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>और ख़ुदावन्द ऐसा करे कि जिस तरह हम को तुम से मुहब्बत है उसी तरह तुम्हारी मुहब्बत भी आपस में और सब आदमियों के साथ ज़्यादा हो और बढ़े <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>ताकि वो तुम्हारे दिलों को ऐसा मज़बूत कर दे कि जब हमारा ख़ुदावन्द ईसा अपने सब मुक़द्दसों के साथ आए तो वो हमारे ख़ुदा और बाप के सामने पाकीज़गी में बेऐब हों।<verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="s">ख़ुदा को ख़ुश करने के लिये जियो</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>ग़रज़ ऐ भाइयों!, हम तुम से दरख़्वास्त करते हैं और ख़ुदावन्द ईसा में तुम्हें नसीहत करते हैं कि जिस तरह तुम ने हम से मुनासिब चाल चलने और ख़ुदा को ख़ुश करने की ता'लीम पाई और जिस तरह तुम चलते भी हो उसी तरह और तरक़्क़ी करते जाओ। <verse eid="1TH 4:1"/><verse number="2" style="v" sid="1TH 4:2"/>क्यूँकि तुम जानते हो कि हम ने तुम को ख़ुदावन्द ईसा की तरफ़ से क्या क्या हुक्म पहुँचाए।<verse eid="1TH 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3"/>चुनाँचे ख़ुदा की मर्ज़ी ये है कि तुम पाक बनो, या'नी हरामकारी से बचे रहो। <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>और हर एक तुम में से पाकीज़गी और इज़्ज़त के साथ अपने ज़र्फ़ को हासिल करना जाने। <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>न बुरी ख़्वाहिश के जोश से उन क़ौमों की तरह जो ख़ुदा को नहीं जानतीं <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>और कोई शख़्स अपने भाई के साथ इस काम में ज़्यादती और दग़ा न करे क्यूँकि ख़ुदावन्द इन सब कामों का बदला लेने वाला है चुनाँचे हम ने पहले भी तुम को करके जता दिया था।<verse eid="1TH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 4:7"/>इसलिए कि ख़ुदा ने हम को नापाकी के लिए नहीं बल्कि पाकीज़गी के लिए बुलाया। <verse eid="1TH 4:7"/><verse number="8" style="v" sid="1TH 4:8"/>पस, जो नहीं मानता वो आदमी को नहीं बल्कि ख़ुदा को नहीं मानता जो तुम को अपना पाक रूह देता है।<verse eid="1TH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>मगर भाई — चारे की मुहब्बत के ज़रिए तुम्हें कुछ लिखने की हाजत नहीं क्यूँकि तुम ने आपस में मुहब्बत करने की ख़ुदा से ता'लीम पा चुके हो। <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>और तमाम मकिदुनिया के सब भाइयों के साथ ऐसा ही करते हो लेकिन ऐ भाइयों! हम तुम्हें नसीहत करते हैं कि तरक़्क़ी करते जाओ। <verse eid="1TH 4:10"/><verse number="11" style="v" sid="1TH 4:11"/>और जिस तरह हम ने तुम को हुक्म दिया चुप चाप रहने और अपना कारोबार करने और अपने हाथों से मेहनत करने की हिम्मत करो। <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>ताकि बाहर वालों के साथ संजीदगी से बरताव करो और किसी चीज़ के मोहताज न हो।<verse eid="1TH 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>ऐ भाइयों! हम नहीं चाहते कि जो सोते है उनके बारे में तुम नावाक़िफ़ रहो ताकि औरों की तरह जो ना उम्मीद है ग़म ना करो। <verse eid="1TH 4:13"/><verse number="14" style="v" sid="1TH 4:14"/>क्यूँकि जब हमें ये यक़ीन है कि ईसा मर गया और जी उठा तो उसी तरह ख़ुदा उन को भी जो सो गए हैं ईसा के वसीले से उसी के साथ ले आएगा। <verse eid="1TH 4:14"/><verse number="15" style="v" sid="1TH 4:15"/>चुनाँचे हम तुम से दावन्द के कलाम के मुताबिक़ कहते हैं कि हम जो ज़िन्दा हैं और दावन्द के आने तक बाक़ी रहेंगे सोए हुओं से हरगिज़ आगे न बढ़ेंगे।<verse eid="1TH 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 4:16"/>क्यूँकि ख़ुदावन्द ख़ुद आसमान से लल्कार और ख़ास फ़रिश्ते की आवाज़ और ख़ुदा के नरसिंगे के साथ उतर आएगा और पहले तो वो जो मसीह में मरे जी उठेंगे। <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>फिर हम जो ज़िन्दा बाक़ी होंगे उनके साथ बादलों पर उठा लिए जाएँगे; ताकि हवा में ख़ुदावन्द का इस्तक़बाल करें और इसी तरह हमेशा दावन्द के साथ रहेंगे। <verse eid="1TH 4:17"/><verse number="18" style="v" sid="1TH 4:18"/>पस, तुम इन बातों से एक दूसरे को तसल्ली दिया करो।<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>मगर ऐ भाइयों! इसकी कुछ ज़रूरत नहीं कि वक़्तों और मौक़ों के ज़रिए तुम को कुछ लिखा जाए। <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/>इस वास्ते कि तुम आप ख़ुद जानते हो कि ख़ुदावन्द का दिन इस तरह आने वाला है जिस तरह रात को चोर आता है। <verse eid="1TH 5:2"/><verse number="3" style="v" sid="1TH 5:3"/>जिस वक़्त लोग कहते होंगे कि सलामती और अम्न है उस वक़्त उन पर इस तरह हलाकत आएगी जिस तरह हामिला को दर्द होता हैं और वो हरगिज़ न बचेंगे।<verse eid="1TH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4"/>लेकिन तुम ऐ भाइयों, अंधेरे में नहीं हो कि वो दिन चोर की तरह तुम पर आ पड़े। <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>क्यूँकि तुम सब नूर के फ़र्ज़न्द और दिन के फ़र्ज़न्द हो, हम न रात के हैं न तारीकी के। <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>पस, औरों की तरह सोते न रहो, बल्कि जागते और होशियार रहो। <verse eid="1TH 5:6"/><verse number="7" style="v" sid="1TH 5:7"/>क्यूँकि जो सोते हैं रात ही को सोते हैं और जो मतवाले होते हैं रात ही को मतवाले होते हैं।<verse eid="1TH 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TH 5:8"/>मगर हम जो दिन के हैं ईमान और मुहब्बत का बख़्तर लगा कर और निजात की उम्मीद कि टोपी पहन कर होशियार रहें। <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>क्यूँकि ख़ुदा ने हमें ग़ज़ब के लिए नहीं बल्कि इसलिए मुक़र्रर किया कि हम अपने ख़ुदावन्द ईसा मसीह के वसीले से नजात हासिल करें। <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>वो हमारी ख़ातिर इसलिए मरा, कि हम जागते हों या सोते हों सब मिलकर उसी के साथ जिएँ। <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>पस, तुम एक दूसरे को तसल्ली दो और एक दूसरे की तरक़्क़ी की वजह बनो चुनाँचे तुम ऐसा करते भी हो।<verse eid="1TH 5:11"/></para>
  <para style="s">पौलुस की आखिरी सलाह</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>और ऐ भाइयों, हम तुम से दरख़्वास्त करते हैं, कि जो तुम में मेहनत करते और ख़ुदावन्द में तुम्हारे पेशवा हैं और तुम को नसीहत करते हैं उन्हें मानो। <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>और उनके काम की वजह से मुहब्बत के साथ उन की बड़ी इज़्ज़त करो; आपस में मेल मिलाप रख्खो। <verse eid="1TH 5:13"/><verse number="14" style="v" sid="1TH 5:14"/>और ऐ भाइयों, हम तुम्हें नसीहत करते हैं कि बे क़ाइदा चलने वालों को समझाओ कम हिम्मतों को दिलासा दो कमज़ोरों को संभालो सब के साथ तहम्मील से पेश आओ।<verse eid="1TH 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 5:15"/>ख़बरदार कोई किसी से बदी के बदले बदी न करे बल्कि हर वक़्त नेकी करने के दर पै रहो आपस में भी और सब से। <verse eid="1TH 5:15"/><verse number="16" style="v" sid="1TH 5:16"/>हर वक़्त ख़ुश रहो। <verse eid="1TH 5:16"/><verse number="17" style="v" sid="1TH 5:17"/>बिला नाग़ा दुआ करो। <verse eid="1TH 5:17"/><verse number="18" style="v" sid="1TH 5:18"/>हर एक बात में शुक्र गुज़ारी करो क्यूँकि मसीह ईसा में तुम्हारे बारे में ख़ुदा की यही मर्ज़ी है।<verse eid="1TH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19"/>रूह को न बुझाओ। <verse eid="1TH 5:19"/><verse number="20" style="v" sid="1TH 5:20"/>नबुव्वतों की हिक़ारत न करो। <verse eid="1TH 5:20"/><verse number="21" style="v" sid="1TH 5:21"/>सब बातों को आज़माओ, जो अच्छी हो उसे पकड़े रहो। <verse eid="1TH 5:21"/><verse number="22" style="v" sid="1TH 5:22"/>हर क़िस्म की बदी से बचे रहो।<verse eid="1TH 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>ख़ुदा जो इत्मीनान का चश्मा है आप ही तुम को बिल्कुल पाक करे, और तुम्हारी रूह और जान और बदन हमारे ख़ुदावन्द ईसा मसीह के आने तक पूरे पूरे और बेऐब महफ़ूज़ रहें। <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>तुम्हारा बुलाने वाला सच्चा है वो ऐसा ही करेगा।<verse eid="1TH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>ऐ भाइयों! हमारे वास्ते दुआ करो।<verse eid="1TH 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26"/>पाक बोसे के साथ सब भाइयों को सलाम करो। <verse eid="1TH 5:26"/><verse number="27" style="v" sid="1TH 5:27"/>मैं तुम्हें ख़ुदावन्द की क़सम देता हूँ, कि ये ख़त सब भाइयों को सुनाया जाए।<verse eid="1TH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>हमारे ख़ुदावन्द ईसा मसीह का फ़ज़ल तुम पर होता रहे।<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
