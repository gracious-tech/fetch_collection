<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">फ़िलेमोन</para>
  <para style="toc1">फ़िलेमोन</para>
  <para style="toc2">फ़िले</para>
  <para style="toc3">फ़िले</para>
  <para style="mt">फ़िलेमोन के नाम पौलुस रसूल का ख़त</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">फ़िलेमोन की किताब का मुसन्निफ़ पौलूस रसूल था (1:1) फ़िलेमोन को लिखे गए ख़त में पौलूस कहता है वह उनेसमुस को वापस फ़िलेमोन के पास भेज रहा है और कुलुस्सियों 4:9 में उनेसमुस को इस बतौर पहचाना गया है कि उस को तखि़कुस के साथ कुलुस्से भेजा गया है। (तखि़कुस के हाथ कुलुस्से की कलीसिया के लिए ख़त भेजा गया था)। यह दिलचस्प है कि पौलूस ख़ुद ही अपने हाथों से इस ख़त को लिखा यह जताने के लिए कि उनेसमुस उस के लिए कितना अहम था।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इस ख़त के लिखे जाने की तारीख़ तक़रीबन ईस्वी 60 के बीच है।</para>
  <para style="ip">पौलूस ने रोम में फ़िलेमोन को ख़त लिखा। जब वह इस ख़त को लिख रहा था तो उस वक़्त वह रोम के हवालात में बन्द था।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">पौलूस ने फ़िलेमोन, अफ़िया, अरखि़पुस और कलीसिया को लिखा जो अरखि़पुस के घर में जमा‘ होती थी। ख़त के मज़्मून से यह साफ़ हो जाता है कि फ़िलेमोन सब से पहला मख़्तूबा क़ारी था।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">पौलूस ने फ़िलेमोन को क़ायल करने के लिए लिखा कि उनेसमुस को वापस अपने घर में रख ले। (इस उनेसमुस ने फ़िलेमोन के घर के सामान की चोरी की थी और भाग गया था वह गुलाम था और उसने ख़म्याज़ा भी नाहीं भरा था); (10 — 12, 17) इस के अलावा पौलूस चाहता था कि फ़िलेमोन उनेसमुस के साथ गुलाम की तरह बर्ताव न करे बल्कि अज़ीज़ भाई की तरह (15 — 16) उनेसमुस अभी भी फ़िलेमोन की जायेदाद था क्योंकि वह उसका ग़ुलाम था। और पौलूस ने फ़िलेमोन को इतनी नर्मी से लिखा कि उनेसमुस वापस अपने मालिक के पास चला जाए। पौलूस के इस तरह से सिफ़ारिश करने के ज़रिए उनेसमुस एक मसीही बन गया था (1:10)।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">मुआफ़ी</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. सलाम — 1:1-3</para>
  <para style="io1">2. शुकरिया अदा करना — 1:4-7</para>
  <para style="io1">3. उनेसमुस के लिए सिफ़रिश — 1:8-22</para>
  <para style="io1">4. आख़री अल्फ़ाज़ — 1:23-25</para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="s">पौलुस का सलाम</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>पौलुस की तरफ़ से जो मसीह ईसा का क़ैदी है, और भाई तीमुथियुस की तरफ़ से अपने 'अज़ीज़ और हम ख़िदमत फिलेमोन, <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>और बहन अफ़िया, और अपने हम सफ़र आर्ख़िप्पुस और फिलेमोन के घर की कलीसिया के नाम ख़त: <verse eid="PHM 1:2"/><verse number="3" style="v" sid="PHM 1:3"/>फ़ज़ल और इत्मीनान हमारे बाप ख़ुदा और ख़ुदावन्द 'ईसा मसीह की तरफ़ से तुम्हें हासिल होता रहे।<verse eid="PHM 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>मैं तेरी उस मुहब्बत का और ईमान का हाल सुन कर, जो सब मुक़द्दसों के साथ और ख़ुदावन्द ईसा पर है' <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>हमेशा अपने ख़ुदा का शुक्र करता हूँ, और अपनी दु'आओं में तुझे याद करता हूँ। <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>ताकि तेरे ईमान की शिराकत तुम्हारी हर ख़ूबी की पहचान में मसीह के वास्ते मु' अस्सिर हो। <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>क्यूँकि ऐ भाई! मुझे तेरी मुहब्बत से बहुत ख़ुशी और तसल्ली हुई, इसलिए कि तेरी वजह से मुक़द्दसों के दिल ताज़ा हुए हैं।<verse eid="PHM 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>पस अगरचे मुझे मसीह में बड़ी दिलेरी तो है कि तुझे मुनासिब हुक्म दूँ। <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>मगर मुझे ये ज़्यादा पसन्द है कि मैं बूढ़ा पौलुस, बल्कि इस वक़्त मसीह 'ईसा का क़ैदी भी होकर मुहब्बत की राह से इल्तिमास करूँ।<verse eid="PHM 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="PHM 1:10"/>सो अपने फ़र्ज़न्द उनेसिमुस के बारे में जो क़ैद की हालत में मुझ से पैदा हुआ, तुझसे इल्तिमास करता हूँ। <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>पहले तो तेरे कुछ काम का ना था मगर अब तेरे और मेरे दोनों के काम का है। <verse eid="PHM 1:11"/><verse number="12" style="v" sid="PHM 1:12"/>ख़ुद उसी को या'नी अपने कलेजे के टुकड़े को, मैने तेरे पास वापस भेजा है। <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>उसको मैं अपने ही पास रखना चाहता था, ताकि तेरी तरफ़ से इस क़ैद में जो ख़ुशख़बरी के ज़रिए है मेरी ख़िदमत करे।<verse eid="PHM 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="PHM 1:14"/>लेकिन तेरी मर्ज़ी के बग़ैर में ने कुछ करना न चाहा, ताकि तेरे नेक काम लाचारी से नहीं बल्कि ख़ुशी से हों। <verse eid="PHM 1:14"/><verse number="15" style="v" sid="PHM 1:15"/>क्यूँकि मुम्किन है कि वो तुझ से इसलिए थोड़ी देर के वास्ते जुदा हुआ हो कि हमेशा तेरे पास रहे। <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>मगर अब से ग़ुलाम की तरह नहीं बल्कि ग़ुलाम से बेहतर होकर या'नी ऐसे भाई की तरह रहे जो जिस्म में भी और ख़ुदावन्द में भी मेरा निहायत 'अज़ीज़ हो और तेरा इससे भी कही ज़्यादा।<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>पस अगर तू मुझे शरीक जानता है, तो उसे इस तरह क़ुबूल करना जिस तरह मुझे। <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>और अगर उस ने तेरा कुछ नुक़्सान किया है, या उस पर तेरा कुछ आता है, तो उसे मेरे नाम से लिख ले। <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>मैं पौलुस अपने हाथ से लिखता हूँ कि ख़ुद अदा करूँगा, इसके कहने की कुछ ज़रूरत नहीं कि मेरा क़र्ज़ जो तुझ पर है वो तू ख़ुद है <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>ऐ भाई! मैं चाहता हूँ कि मुझे तेरी तरफ़ से ख़ुदावन्द में ख़ुशी हासिल हो। मसीह में मेरे दिल को ताज़ा कर।<verse eid="PHM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21"/>मैं तेरी फ़रमाँबरदारी का यक़ीन करके तुझे लिखता हूँ, और जानता हूँ कि जो कुछ मैं कहता हूँ, तू उस से भी ज़्यादा करेगा। <verse eid="PHM 1:21"/><verse number="22" style="v" sid="PHM 1:22"/>इसके सिवा मेरे लिए ठहरने की जगह तैयार कर, क्यूँकि मुझे उम्मीद है कि मैं तुम्हारी दु' आओं के वसीले से तुम्हें बख़्शा जाऊँगा।<verse eid="PHM 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>इपफ़्रास जो मसीह ईसा में मेरे साथ क़ैद है, <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>और मरकुस और अरिस्तरख़ुस और दोमास और लुक़ा, जो मेरे हम ख़िदमत हैं तुझे सलाम कहते है।<verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>हमारे ख़ुदावन्द ईसा मसीह का फ़ज़ल तुम्हारी रूह पर होता रहे। आमीन।<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
