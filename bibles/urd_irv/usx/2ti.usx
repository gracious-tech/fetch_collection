<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">2 तीमुथियुस</para>
  <para style="toc1">2 तीमुथियुस</para>
  <para style="toc2">2 तीमु</para>
  <para style="toc3">2 तीमु</para>
  <para style="mt">तीमुथियुस के नाम पौलुस रसूल का दूसरा ख़त</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">मुसन्निफ़ की पहचान रोम में पौलूस की क़ैद से रिहाई के बाद और उसकी चैथी मिश्नरी सफ़र के बाद उसने 1 तीमुथियुस लिखा था। फिर से नीरो बादशाह के तहत कैद में डाला गया। यह वह वक़्त था जब उसने दूसरा ख़त तीमुथियुस के नाम लिखा। पौलूस की पहली क़ैद में ज बवह रोम में था तो उस को एक किराये के मकान में रहना पड़ा था (आमाल 28:30) इस के मुक़ाबले में यह दूसरी क़ैद जो नीरो के तहत थी इस में उसको ईज़ाऐं देकर कम्ज़ोर कर दिया गया, एक ठंडे तहख़ाने में रखा गया (4:13) और एक आम मुजरिम की तरह ज़न्जीरों से बंधा हुआ था (1:16; 2:9) पौलूस जानता था कि उसने अपनी खि़दमत पूरी कर ली थी और उस के कूच का वक़्त आ गया था (4:6-8)।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इसके लिखे जाने की तारीख़ तक़रीबत ईस्वी 66 - 67 के बीच है।</para>
  <para style="ip">पौलूस जब दूसरी बार हवालात में था तो उसने इस ख़त को लिखा जबकि वह शहादत का जाम पीने के इन्तज़ार में था।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">इस ख़त को सब से पढ़ने वाला शख़्स तीमुथियुस था और यक़ीनी तौर से उस ने इस ख़त को अपनी कलीसिया में पढ़ कर सुनाया।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">तीमुथियुस के पास एक आख़री हौसला अफ़्ज़ाई और नसीहत छोड़ने के लिए ताकि पौलूस ने जिस काम को उसके भरोसे छोड़ रखा था वह उसे बा — अज़्म और दिलेरी से पूरा कर सके (1:13 — 14), पूरे ध्यान के साथ (2:1 — 26) और साबित क़दमी और इस्तिक़लाल के साथ करे (3:14-17)।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">1 एक ईमान्दार खि़दमत का सौंपा जाना।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. ख़िदमत करने की तश़वीश — 1:1-18</para>
  <para style="io1">2. ख़िदमत का नमूना — 2:1-26</para>
  <para style="io1">3. झुठे उस्तादों के ख़िलाफ़ आगाह करना — 3:1-17</para>
  <para style="io1">4. हौंसला अफ़्ज़ाही के अल्फ़ाज़ और बरकतें — 4:1-22</para>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="s">पौलुस का सलाम</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1"/>पौलुस की तरफ़ से जो उस ज़िन्दगी के वा'दे के मुताबिक़ जो मसीह ईसा में है ख़ुदा की मर्ज़ी से मसीह 'ईसा का रसूल है। <verse eid="2TI 1:1"/><verse number="2" style="v" sid="2TI 1:2"/>प्यारे बेटे तीमुथियुस के नाम ख़त:फ़ज़ल रहम और इत्मीनान ख़ुदा बाप और हमारे ख़ुदावन्द 'ईसा मसीह की तरफ़ से तुझे हासिल होता रहे।<verse eid="2TI 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>जिस ख़ुदा की इबादत में साफ़ दिल से बाप दादा के तौर पर करता हूँ; उसका शुक्र है कि अपनी दुआओं में बिला नाग़ा तुझे याद रखता हूँ। <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>और तेरे आँसुओं को याद करके रात दिन तेरी मुलाक़ात का मुश्ताक़ रहता हूँ ताकि ख़ुशी से भर जाऊँ। <verse eid="2TI 1:4"/><verse number="5" style="v" sid="2TI 1:5"/>और मुझे तेरा वो बे रिया ईमान याद दिलाया गया है जो पहले तेरी नानी लूइस और तेरी माँ यूनीके रखती थीं और मुझे यक़ीन है कि तू भी रखता है।<verse eid="2TI 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6"/>इसी वजह से मै तुझे याद दिलाता हूँ कि तू ख़ुदा की उस ने'अमत को चमका दे जो मेरे हाथ रखने के ज़रिए तुझे हासिल है। <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>क्यूँकि ख़ुदा ने हमें दहशत की रूह नहीं बल्कि क़ुदरत और मुहब्बत और तरबियत की रूह दी है।<verse eid="2TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8"/>पस, हमारे ख़ुदावन्द की गवाही देने से और मुझ से जो उसका क़ैदी हूँ शर्म न कर बल्कि ख़ुदा की क़ुदरत के मुताबिक़ ख़ुशख़बरी की ख़ातिर मेरे साथ दु:ख उठा। <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>जिस ने हमें नजात दी और पाक बुलावे से बुलाया हमारे कामों के मुताबिक़ नहीं बल्कि अपने ख़ास इरादा और उस फ़ज़ल के मुताबिक़ जो मसीह 'ईसा में हम पर शुरू से हुआ। <verse eid="2TI 1:9"/><verse number="10" style="v" sid="2TI 1:10"/>मगर अब हमारे मुन्जी मसीह 'ईसा के आने से ज़ाहिर हुआ जिस ने मौत को बरबाद और बाक़ी ज़िन्दगी को उस ख़ुशख़बरी के वसीले से रौशन कर दिया। <verse eid="2TI 1:10"/><verse number="11" style="v" sid="2TI 1:11"/>जिस के लिए मैं ऐलान करने वाला और रसूल और उस्ताद मुक़र्रर हुआ। <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>इसी वजह से मैं ये दु:ख भी उठाता हूँ, लेकिन शर्माता नहीं क्यूँकि जिसका मैं ने यक़ीन किया है उसे जानता हूँ और मुझे यक़ीन है कि वो मेरी अमानत की उस दिन तक हिफ़ाज़त कर सकता है।<verse eid="2TI 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13"/>जो सही बातें तू ने मुझ से सुनी उस ईमान और मुहब्बत के साथ जो मसीह ईसा में है उन का ख़ाका याद रख। <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>रूह — उल — क़ुद्दुस के वसीले से जो हम में बसा हुआ है इस अच्छी अमानत की हिफ़ाज़त कर।<verse eid="2TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15"/>तू ये जानता है कि आसिया सूबे के सब लोग मुझ से ख़फ़ा हो गए; जिन में से फ़ूगलुस और हरमुगिनेस हैं। <verse eid="2TI 1:15"/><verse number="16" style="v" sid="2TI 1:16"/>ख़ुदावन्द उनेस्फिरुस के घराने पर रहम करे क्यूँकि उस ने बहुत मर्तबा मुझे ताज़ा दम किया और मेरी क़ैद से शर्मिन्दा न हुआ। <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>बल्कि जब वो रोमा शहर में आया तो कोशिश से तलाश करके मुझ से मिला। <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>ख़ुदावन्द उसे ये बख़्शे कि उस दिन उस पर ख़ुदावन्द का रहम हो और उस ने इफ़िसुस में जो जो ख़िदमतें कीं तू उन्हें ख़ूब जानता है।<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="s">येसु का एक अच्छा सिपाही</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>पस, ऐ मेरे बेटे, तू उस फ़ज़ल से जो मसीह 'ईसा में है मज़बूत बन। <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>और जो बातें तू ने बहुत से गवाहों के सामने मुझ से सुनी हैं उनको ऐसे ईमानदार आदमियों के सुपुर्द कर जो औरों को भी सिखाने के काबिल हों।<verse eid="2TI 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3"/>पस मसीह 'ईसा के अच्छे सिपाही की तरह मेरे साथ दु:ख उठा। <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>कोई सिपाही जब लड़ाई को जाता है अपने आपको दुनिया के मु'आमिलों में नहीं फँसाता ताकि अपने भरती करने वाले को ख़ुश करे। <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>दँगल में मुक़ाबिला करने वाला भी अगर उस ने बा' क़ाइदा मुक़ाबिला न किया हो तो सेहरा नहीं पाता।<verse eid="2TI 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 2:6"/>जो किसान मेहनत करता है, पैदावार का हिस्सा पहले उसी को मिलना चाहिए। <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>जो मैं कहता हूँ उस पर ग़ौर कर क्यूँकि ख़ुदावन्द तुझे सब बातों की समझ देगा।<verse eid="2TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8"/>'ईसा मसीह को याद रख जो मुर्दों में से जी उठा है और दाऊद की नस्ल से है मेरी उस ख़ुशख़बरी के मुवाफ़िक़। <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>जिसके लिए मैं बदकार की तरह दुःख उठाता हूँ यहाँ तक कि क़ैद हूँ मगर ख़ुदा का कलाम क़ैद नहीं। <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>इसी वजह से मैं नेक लोगों की ख़ातिर सब कुछ सहता हूँ ताकि वो भी उस नजात को जो मसीह 'ईसा में है अबदी जलाल समेत हासिल करें।<verse eid="2TI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11"/>ये बात सच है कि</para>
  <para style="q" vid="2TI 2:11">जब हम उस के साथ मर गए तो उस के साथ जिएँगे भी।<verse eid="2TI 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="2TI 2:12"/>अगर हम दु:ख सहेंगे तो उस के साथ बादशाही भी करेंगे</para>
  <para style="q" vid="2TI 2:12">अगर हम उसका इन्कार करेंगे; तो वो भी हमारा इन्कार करेगा।<verse eid="2TI 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="2TI 2:13"/>अगर हम बेवफ़ा हो जाएँगे तो भी वो वफ़ादार रहेगा,</para>
  <para style="m" vid="2TI 2:13">क्यूँकि वो अपने आप का इन्कार नहीं कर सकता।<verse eid="2TI 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>ये बातें उन्हें याद दिला और ख़ुदावन्द के सामने नसीहत कर के लफ़्ज़ी तकरार न करें जिस से कुछ हासिल नहीं बल्कि सुनने वाले बिगड़ जाते हैं। <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>अपने आपको ख़ुदा के सामने मक़बूल और ऐसे काम करने वाले की तरह पेश करने की कोशिश कर; जिसको शर्मिन्दा होना न पड़े, और जो हक़ के कलाम को दुरुस्ती से काम में लाता हो।<verse eid="2TI 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 2:16"/>लेकिन बेकार बातों से परहेज़ कर क्यूँकि ऐसे शख़्स और भी बेदीनी में तरक़्क़ी करेंगे। <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>और उन का कलाम सड़े घाव की तरह फैलता चला जाएगा; हुमिनयुस और फ़िलेतुस उन ही में से हैं। <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>वो ये कह कर कि क़यामत हो चुकी है; हक़ से गुमराह हो गए हैं और कुछ का ईमान बिगाड़ते हैं। <verse eid="2TI 2:18"/><verse number="19" style="v" sid="2TI 2:19"/>तो भी ख़ुदा की मज़बूत बुनियाद क़ाईम रहती है और उस पर ये मुहर है, “ख़ुदावन्द अपनों को पहचानता है,” और “जो कोई ख़ुदावन्द का नाम लेता है नारास्ती से बाज़ रहे।” <verse eid="2TI 2:19"/><verse number="20" style="v" sid="2TI 2:20"/>बड़े घर में न सिर्फ़ सोने चाँदी ही के बरतन होते हैं बल्कि लकड़ी और मिट्टी के भी कुछ 'इज़्ज़त और कुछ ज़िल्लत के लिए। <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>पस, जो कोई इन से अलग होकर अपने आप को पाक करेगा वो 'इज़्ज़त का बरतन और मुक़द्दस बनेगा और मालिक के काम के लायक़ और हर नेक काम के लिए तैयार होगा। <verse eid="2TI 2:21"/><verse number="22" style="v" sid="2TI 2:22"/>जवानी की ख़्वाहिशों से भाग और जो पाक दिल के साथ ख़ुदावन्द से दुआ करते हैं; उन के साथ रास्तबाज़ी और ईमान और मुहब्बत और मेलमिलाप की चाहत हो। <verse eid="2TI 2:22"/><verse number="23" style="v" sid="2TI 2:23"/>लेकिन बेवक़ूफ़ी और नादानी की हुज्जतों से किनारा कर क्यूँकि तू जानता है; कि उन से झगड़े पैदा होते हैं।<verse eid="2TI 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2TI 2:24"/>और मुनासिब नहीं कि ख़ुदावन्द का बन्दा झगड़ा करे बल्कि सब के साथ रहम करे और ता'लीम देने के लायक़ और हलीम हो। <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>और मुख़ालिफ़ों को हलीमी से सिखाया करे शायद ख़ुदा उन्हें तौबा की तौफ़ीक़ बख़्शे ताकि वो हक़ को पहचानें <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>और ख़ुदावन्द के बन्दे के हाथ से ख़ुदा की मर्ज़ी के क़ैदी हो कर इब्लीस के फन्दे से छूटें।<verse eid="2TI 2:26"/></para>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="s">आखिरी दिनों के ख़तरे</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>लेकिन ये जान रख कि आख़िरी ज़माने में बुरे दिन आएँगे। <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>क्यूँकि आदमी ख़ुदग़र्ज़ एहसान फ़रामोश, शेख़ीबाज़, मग़रूर बदग़ो, माँ बाप का नाफ़रमान' नाशुक्र, नापाक, <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>ज़ाती मुहब्बत से ख़ाली संगदिल तोहमत लगानेवाले बेज़ब्त तुन्द मिज़ाज नेकी के दुश्मन। <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>दग़ाबाज़, ढीठ, घमण्ड करने वाले, ख़ुदा की निस्बत ऐश — ओ — अशरत को ज़्यादा दोस्त रखने वाले होंगे।<verse eid="2TI 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TI 3:5"/>वो दीनदारी का दिखावा तो रखेंगे मगर उस पर अमल न करेंगे ऐसों से भी किनारा करना। <verse eid="2TI 3:5"/><verse number="6" style="v" sid="2TI 3:6"/>इन ही में से वो लोग हैं जो घरों में दबे पाँव घुस आते हैं और उन बद चलन 'औरतों को क़ाबू कर लेते हैं जो गुनाहों में दबी हुई हैं और तरह तरह की ख़्वाहिशों के बस में हैं। <verse eid="2TI 3:6"/><verse number="7" style="v" sid="2TI 3:7"/>और हमेशा ता'लीम पाती रहती हैं मगर हक़ की पहचान उन तक कभी नहीं पहुँचती।<verse eid="2TI 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 3:8"/>और जिस तरह के यत्रेस और यम्ब्रेस ने मूसा की मुख़ालिफ़त की थी ये ऐसे आदमी हैं जिनकी अक़्ल बिगड़ी हुई है और वो ईमान के ऐ'तिबार से ख़ाली हैं। <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>मगर इस से ज़्यादा न बढ़ सकेंगे इस वास्ते कि इन की नादानी सब आदमियों पर ज़ाहिर हो जाएगी जैसे उन<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">ये दोनों जमबीस और जन्नीस दो जादूगर थे जो मूसा के ख़िलाफ़ खड़े हुए थे </char></note> की भी हो गई थी।<verse eid="2TI 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>लेकिन तू ने ता'लीम, चाल चलन, इरादा, ईमान, तहम्मील, मुहब्बत, सब्र, सताए जाने और दु:ख उठाने में मेरी पैरवी की। <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>या'नी ऐसे दु:खों में जो अन्ताकिया और इकुनियुस और लुस्तरा शहरों में मुझ पर पड़े दीगर दु:खों में भी जो मैने उठाए हैं मगर ख़ुदावन्द ने मुझे उन सब से छुड़ा लिया। <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>बल्कि जितने मसीह ईसा में दीनदारी के साथ ज़िन्दगी गुज़ारना चाहते हैं वो सब सताए जाएँगे। <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>और बुरे और धोखेबाज़ आदमी फ़रेब देते और फ़रेब खाते हुए बिगड़ते चले जाएँगे।<verse eid="2TI 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14"/>मगर तू उन बातों पर जो तू ने सीखी थीं, और जिनका यक़ीन तुझे दिलाया गया था, ये जान कर क़ाईम रह कि तू ने उन्हें किन लोगों से सीखा था। <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>और तू बचपन से उन पाक नविश्तों से वाक़िफ़ है, जो तुझे मसीह 'ईसा पर ईमान लाने से नजात हासिल करने के लिए दानाई बख़्श सकते हैं।<verse eid="2TI 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 3:16"/>हर एक सहीफ़ा जो ख़ुदा के इल्हाम से है ता'लीम और इल्ज़ाम और इस्लाह और रास्तबाज़ी में तरबियत करने के लिए फ़ाइदे मन्द भी है। <verse eid="2TI 3:16"/><verse number="17" style="v" sid="2TI 3:17"/>ताकि मर्दे ख़ुदा कामिल बने और हर एक नेक काम के लिए बिल्कुल तैयार हो जाए।<verse eid="2TI 3:17"/></para>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>ख़ुदा और मसीह 'ईसा को जो ज़िन्दों और मुर्दों की अदालत करेगा; गवाह करके और उस के ज़हूर और बादशाही को याद दिला कर मैं तुझे नसीहत करता हूँ। <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>कि तू कलाम की मनादी कर वक़्त और बे वक़्त मुस्त'इद रह, हर तरह के तहम्मील और ता'लीम के साथ समझा दे और मलामत और नसीहत कर।<verse eid="2TI 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 4:3"/>क्यूँकि ऐसा वक़्त आएगा कि लोग सही ता'लीम की बर्दाश्त न करेंगे; बल्कि कानों की खुजली के ज़रिए अपनी अपनी ख़्वाहिशों के मुवाफ़िक़ बहुत से उस्ताद बना लेंगे। <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>और अपने कानों को हक़ की तरफ़ से फ़ेर कर कहानियों पर मुतवज्जह होंगे। <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>मगर तू सब बातों में होशियार रह, दु:ख उठा बशारत का काम अन्जाम दे अपनी ख़िदमत को पूरा कर।<verse eid="2TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6"/>क्यूँकि मैं अब क़ुर्बान हो रहा हूँ, और मेरे जाने का वक़्त आ पहुँचा है। <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>मैं अच्छी कुश्ती लड़ चुका, मैंने दौड़ को ख़त्म कर लिया, मैंने ईमान को महफ़ूज़ रख्खा। <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>आइन्दा के लिए मेरे वास्ते रास्तबाज़ी का वो ताज रखा हुआ है, जो आदिल मुन्सिफ़ या'नी ख़ुदावन्द मुझे उस दिन देगा और सिर्फ़ मुझे ही नहीं बल्कि उन सब को भी जो उस के ज़हूर के आरज़ूमन्द हों।<verse eid="2TI 4:8"/></para>
  <para style="s">पौलुस के आखिरी अल्फ़ाज़</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>मेरे पास जल्द आने की कोशिश कर। <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>क्यूँकि देमास ने इस मौजूदा जहान को पसन्द करके मुझे छोड़ दिया और थिस्सलुनीकियों के शहर को चला गया और क्रेसकेन्स ग़लतिया सूबे को और तितुस दलमतिया सूबे को।<verse eid="2TI 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 4:11"/>सिर्फ़ लूक़ा मेरे पास है मरकुस को साथ लेकर आजा; क्यूँकि ख़िदमत के लिए वो मेरे काम का है। <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>तुख़िकुस को में ने इफ़िसुस भेज दिया है। <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>जो चोग़ा में त्रोआस में करपुस के यहाँ छोड़ आया हूँ जब तू आए तो वो और किताबें ख़ास कर रक़्क़ के तुमार लेता आइये।<verse eid="2TI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14"/>सिकन्दर ठठेरे ने मुझ से बहुत बुराइयां कीं ख़ुदावन्द उसे उसके कामों के मुवाफ़िक़ बदला देगा। <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>उस से तू भी ख़बरदार रह, क्यूँकि उस ने हमारी बातों की बड़ी मुख़ालिफ़त की। <verse eid="2TI 4:15"/><verse number="16" style="v" sid="2TI 4:16"/>मेरी पहली जवाबदेही के वक़्त किसी ने मेरा साथ न दिया; बल्कि सब ने मुझे छोड़ दिया क़ाश कि उन्हें इसका हिसाब देना न पड़े।<verse eid="2TI 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2TI 4:17"/>मगर ख़ुदावन्द मेरा मददगार था, और उस ने मुझे ताक़त बख़्शी ताकि मेरे ज़रिए पैग़ाम की पूरी मनादी हो जाए और सब ग़ैर क़ौमें सुन लें और मैं शेर के मुँह से छुड़ाया गया। <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>ख़ुदावन्द मुझे हर एक बुरे काम से छुड़ाएगा और अपनी आसमानी बादशाही में सही सलामत पहुँचा देगा उसकी बड़ाई हमेशा से हमेशा तक होती रहे आमीन।<verse eid="2TI 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>प्रिस्का और अक्विला से और अनेसफ़ुरुस के ख़ानदान से सलाम कह। <verse eid="2TI 4:19"/><verse number="20" style="v" sid="2TI 4:20"/>इरास्तुस कुरिन्थुस शहर में रहा, और त्रुफ़िमुस को मैंने मीलेतुस टापू में बीमार छोड़ा। <verse eid="2TI 4:20"/><verse number="21" style="v" sid="2TI 4:21"/>जाड़ों से पहले मेरे पास आ जाने की कोशिश कर यूबूलुस और पूदेंस और लीनुस और क्लोदिया और सब भाई तुझे सलाम कहते हैं।<verse eid="2TI 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22"/>ख़ुदावन्द तेरी रूह के साथ रहे तुम पर फ़ज़ल होता रहे।<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
