<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">नोहा</para>
  <para style="toc1">नोहा</para>
  <para style="toc2">नोहा</para>
  <para style="toc3">नोहा</para>
  <para style="mt">नोहा</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">नोहा की किताब के मुसन्निफ़ का नाम किताब के अन्दर दर्ज नहीं है (यह बेनाम है) यहूदी और मसीही रिवायात यर्मयाह को किताब का मुसन्निफ़ बतौर मंसूब करते हैं। किताब के मुसन्निफ़ ने यरूशलेम की बर्बादी के अंजाम की गवाही दी। ऐसा लगता है कि नबी ने ख़ुद यरूशेलम पर हमला होते हुए देखा था (नोहा 1:13-15) दोनों हमलों के वाक़ियात पर यर्मयाह मौजूद था। यहूदा ने ख़ुदा के खि़लाफ़ बग़ावत की और उसके साथ के अहद को तोड़ा ख़ुदा ने बाबुल के लोगों को ज़मानत बतौर, इस्ते‘माल करते हुए अपने लोगों की तरबियत की। इस किताब में कड़ी मुसीबत सहने की बाबत ज़िक्र है इसके बावजूद भी तीन बाब एक उम्मीद के वायदे के साथ ख़लल अन्दाज़ होता है। यर्मयाह ख़ुदा की भलाई को याद करता है। वह ख़ुदा की वफ़ादारी की सच्चाई के वसीले से तसल्ली और दिलासा देता है, अपने क़ारिईन को यह कहते हुए कि ख़ुदावन्द रहमत करने वाला और अपनी मुहब्बत में कभी न बदलने वाला है।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इसके तस्नीफ़ की तारीख़ तक़रीबन 586 - 584 क़ब्ल मसीह के बीच है।</para>
  <para style="ip">यरूशलेम में बाबुल के हमलावरों के ज़रीये मुहासरा करने और शहर को बर्बाद किए जाने की आँखों देखी गवाही का यर्मयाह नबी इस किताब में पेश करता है।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">जिलावतनी के दौरान जो इब्री लोग ज़िन्दा थे और यरूशलेम वापस आये और तमाम कारईन — ए — बाइबल।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">क़ौम के लोगां का और शख़्सी गुनाह ख़ुदा के गज़ब के लिए नतीजा ज़ाहिर करता है। ख़ुदा अपने लोगों को अपने पास वापस फिरने के लिए हालात और लोगों का औज़ार बतौर इस्तेमाल किया। उम्मीद सिर्फ़ ख़ुदा पर ही मुन्हसर करती है। जिलावतनी में बचे कुचे यहूदियों को जिस तरह उसने दरगुज़र किया। गुनाह अब्दी मौत ले आता है। इसके बावजूद भी उस की नजात के मन्सूबे के ज़रीये हमेशा की ज़िन्दगी एक गुनहगार को हासिल होती है। नोहा की किताब यह बात साफ करती है कि गुनाह और बग़ावत ख़ुदा का गज़ब नाज़िल होने के लिए सबब बनता है। (1:8 — 9; 4:13; 5:16)।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">नोहा करना।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. यर्मयाह यरूशलेम के लिए रंजीदा होता है। — 1:1-22</para>
  <para style="io1">2. गुनाह ख़ुदा का ग़ज़ब ले आता है — 2:1-22</para>
  <para style="io1">3. ख़ुदा कभी भी अपने लोगों को नहीं छोड़ता — 3:1-66</para>
  <para style="io1">4. यरूशलेम की शान — ओ — शौकत का खो देना — 4:1-22</para>
  <para style="io1">5. यर्मयाह लोगों के लिए शिफ़ाअत व सिफ़ारिश करता है — 5:1-22</para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="s">यरुशलेम में मातम</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 1:1"/>वह बस्ती जो लोगों से भरी थी, कैसी ख़ाली पड़ी है!</para>
  <para style="q" vid="LAM 1:1">वह क़ौमों की 'ख़ातून बेवा की तरह हो गई!</para>
  <para style="q" vid="LAM 1:1">वह कुछ गुज़ारे के लिए मुल्क की मलिका बन गई!<verse eid="LAM 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 1:2"/>वह रात को ज़ार — ज़ार रोती है, उसके आँसू चेहरे पर बहते हैं;</para>
  <para style="q" vid="LAM 1:2">उसके चाहने वालों में कोई नहीं जो उसे तसल्ली दे;</para>
  <para style="q" vid="LAM 1:2">उसके सब दोस्तों ने उसे धोका दिया, वह उसके दुश्मन हो गए।<verse eid="LAM 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 1:3"/>यहूदाह ज़ुल्म और सख़्त मेहनत की वजह से जिलावतन हुआ,</para>
  <para style="q" vid="LAM 1:3">वह क़ौमों के बीच रहते और बे — आराम है,</para>
  <para style="q" vid="LAM 1:3">उसके सब सताने वालों ने उसे घाटियों में जा लिए।<verse eid="LAM 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 1:4"/>सिय्यून के रास्ते मातम करते हैं,</para>
  <para style="q" vid="LAM 1:4">क्यूँकि ख़ुशी के लिए कोई नहीं आता;</para>
  <para style="q" vid="LAM 1:4">उसके सब दरवाज़े सुनसान हैं,</para>
  <para style="q" vid="LAM 1:4">उसके काहिन आहें भरते हैं;</para>
  <para style="q" vid="LAM 1:4">उसकी कुँवारियाँ मुसीबत ज़दा हैं और वह ख़ुद ग़मगीन है।<verse eid="LAM 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 1:5"/>उसके मुख़ालिफ़ ग़ालिब आए और दुश्मन खु़शहाल हुए;</para>
  <para style="q" vid="LAM 1:5">क्यूँकि ख़ुदावन्द ने उसके गुनाहों की ज़्यादती के ज़रिए' उसे ग़म में डाला;</para>
  <para style="q" vid="LAM 1:5">उसकी औलाद को दुश्मन ग़ुलामी में पकड़ ले गए।<verse eid="LAM 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 1:6"/>सिय्यून की बेटियों की सब शान — ओ — शौकत जाती रही;</para>
  <para style="q" vid="LAM 1:6">उसके हाकिम उन हिरनों की तरह हो गए हैं, जिनको चरागाह नहीं मिलती,</para>
  <para style="q" vid="LAM 1:6">और शिकारियों के सामने बे बस हो जाते हैं।<verse eid="LAM 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 1:7"/>येरूशलेम को अपने ग़म — ओ — मुसीबत के दिनों में,</para>
  <para style="q" vid="LAM 1:7">जब उसके रहने वाले दुश्मन का शिकार हुए, और किसी ने मदद न की,</para>
  <para style="q" vid="LAM 1:7">अपने गुज़रे ज़माने की सब ने'मतें याद आईं,</para>
  <para style="q" vid="LAM 1:7">दुश्मनों ने उसे देखकर उसकी बर्बादी पर हँसी उड़ाई।<verse eid="LAM 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 1:8"/>येरूशलेम सख़्त गुनाह करके नापाक हो गया;</para>
  <para style="q" vid="LAM 1:8">जो उसकी 'इज़्ज़त करते थे, सब उसे हक़ीर जानते हैं,</para>
  <para style="q" vid="LAM 1:8">हाँ, वह ख़ुद आहें भरता, और मुँह फेर लेता है।<verse eid="LAM 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 1:9"/>उसकी नापाकी उसके दामन में है,</para>
  <para style="q" vid="LAM 1:9">उसने अपने अंजाम का ख़्याल न किया;</para>
  <para style="q" vid="LAM 1:9">इसलिए वह बहुत बेहाल हुआ;</para>
  <para style="q" vid="LAM 1:9">और उसे तसल्ली देने वाला कोई न रहा;</para>
  <para style="q" vid="LAM 1:9">ऐ ख़ुदावन्द, मेरी मुसीबत पर नज़र कर;</para>
  <para style="q" vid="LAM 1:9">क्यूँकि दुश्मन ने ग़ुरूर किया है।<verse eid="LAM 1:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 1:10"/>दुश्मन ने उसकी तमाम 'उम्दा चीज़ों पर हाथ बढ़ाया है;</para>
  <para style="q" vid="LAM 1:10">उसने अपने मक़्दिस में क़ौमों को दाख़िल होते देखा है।</para>
  <para style="q" vid="LAM 1:10">जिनके बारे में तू ने फ़रमाया था, कि वह तेरी जमा'अत में दाख़िल न हों।<verse eid="LAM 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 1:11"/>उसके सब रहने वाले कराहते और रोटी ढूंडते हैं,</para>
  <para style="q" vid="LAM 1:11">उन्होंने अपनी 'उम्दा चीज़े दे डालीं, ताकि रोटी से ताज़ा दम हों;</para>
  <para style="q" vid="LAM 1:11">ऐ ख़ुदावन्द, मुझ पर नज़र कर;</para>
  <para style="q" vid="LAM 1:11">क्यूँकि मैं ज़लील हो गया<verse eid="LAM 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 1:12"/>ऐ सब आने जाने वालों, क्या तुम्हारे नज़दीक ये कुछ नहीं?</para>
  <para style="q" vid="LAM 1:12">नज़र करो और देखो; क्या कोई ग़म मेरे ग़म की तरह है, जो मुझ पर आया है जिसे ख़ुदावन्द ने अपने बड़े ग़ज़ब के वक़्त नाज़िल किया।<verse eid="LAM 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 1:13"/>उसने 'आलम — ए — बाला से मेरी हड्डियों में आग भेजी,</para>
  <para style="q" vid="LAM 1:13">और वह उन पर ग़ालिब आई;</para>
  <para style="q" vid="LAM 1:13">उसने मेरे पैरों के लिए जाल बिछाया,</para>
  <para style="q" vid="LAM 1:13">उस ने मुझे पीछे लौटाया: उसने मुझे दिन भर वीरान — ओ — बेताब किया।<verse eid="LAM 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 1:14"/>मेरी ख़ताओं का बोझ उसी के हाथ से बाँधा गया है;</para>
  <para style="q" vid="LAM 1:14">वह बाहम पेचीदा मेरी गर्दन पर हैं उसने मुझे कमज़ोर कर दिया है;</para>
  <para style="q" vid="LAM 1:14">ख़ुदावन्द ने मुझे उनके हवाले किया है, जिनके मुक़ाबिले की मुझ में हिम्मत नहीं।<verse eid="LAM 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 1:15"/>ख़ुदावन्द ने मेरे अन्दर ही मेरे बहादुरों को नाचीज़ ठहराया;</para>
  <para style="q" vid="LAM 1:15">उसने मेंरे ख़िलाफ़ एक ख़ास जमा'अत को बुलाया, कि मेरे बहादुरों को कुचले;</para>
  <para style="q" vid="LAM 1:15">ख़ुदावन्द ने यहूदाह की कुँवारी बेटी को गोया कोल्हू में कुचल डाला।<verse eid="LAM 1:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 1:16"/>इसीलिए मैं रोती हूँ, मेरी आँखें आँसू से भरी हैं,</para>
  <para style="q" vid="LAM 1:16">जो मेरी रूह को ताज़ा करे, मुझ से दूर है;</para>
  <para style="q" vid="LAM 1:16">मेरे बाल — बच्चे बे सहारा हैं, क्यूँकि दुश्मन ग़ालिब आ गया।<verse eid="LAM 1:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 1:17"/>सिय्यून ने हाथ फैलाए; उसे तसल्ली देने वाला कोई नहीं;</para>
  <para style="q" vid="LAM 1:17">या'क़ूब के बारे में ख़ुदावन्द ने हुक्म दिया है,</para>
  <para style="q" vid="LAM 1:17">कि उसके इर्दगिर्द वाले उसके दुश्मन हों,</para>
  <para style="q" vid="LAM 1:17">येरूशलेम उनके बीच नजासत की तरह है।<verse eid="LAM 1:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 1:18"/>ख़ुदावन्द सच्चा है, क्यूँकि मैंने उसके हुक्म से नाफ़रमानी की है;</para>
  <para style="q" vid="LAM 1:18">ऐ सब लोगों, मैं मिन्नत करता हूँ, सुनो, और मेरे दुख़ पर नज़र करो, मेरी कुँवारिया और जवान ग़ुलाम होकर चले गए।<verse eid="LAM 1:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 1:19"/>मैंने अपने दोस्तों को पुकारा, उन्होंने मुझे धोका दिया;</para>
  <para style="q" vid="LAM 1:19">मेरे काहिन और बुज़ुर्ग अपनी रूह को ताज़ा करने के लिए,</para>
  <para style="q" vid="LAM 1:19">शहर में खाना ढूंडते — ढूंडते हलाक हो गए।<verse eid="LAM 1:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 1:20"/>ऐ ख़ुदावन्द देख: मैं तबाह हाल हूँ, मेरे अन्दर पेच — ओ — ताब है;</para>
  <para style="q" vid="LAM 1:20">मेरा दिल मेरे अन्दर मुज़तरिब है;</para>
  <para style="q" vid="LAM 1:20">क्यूँकि मैंने सख़्त बग़ावत की है;</para>
  <para style="q" vid="LAM 1:20">बाहर तलवार बे — औलाद करती है और घर में मौत का सामना है।<verse eid="LAM 1:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 1:21"/>उन्होंने मेरी आहें सुनी हैं;</para>
  <para style="q" vid="LAM 1:21">मुझे तसल्ली देनेवाला कोई नहीं;</para>
  <para style="q" vid="LAM 1:21">मेरे सब दुश्मनों ने मेरी मुसीबत सुनी;</para>
  <para style="q" vid="LAM 1:21">वह ख़ुश हैं कि तू ने ऐसा किया;</para>
  <para style="q" vid="LAM 1:21">तू वह दिन लाएगा, जिसका तू ने 'ऐलान किया है, और वह मेरी तरह हो जाएँगे।<verse eid="LAM 1:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 1:22"/>उनकी तमाम शरारत तेरे सामने आयें;</para>
  <para style="q" vid="LAM 1:22">उनसे वही कर जो तू ने मेरी तमाम ख़ताओं के ज़रिए' मुझसे किया है;</para>
  <para style="q" vid="LAM 1:22">क्यूँकि मेरी आहें बेशुमार हैं और मेरा दिल बेबस है।<verse eid="LAM 1:22"/></para>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="s">गुनाह के लिये ख़ुदा का गुस्सा</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 2:1"/>ख़ुदावन्द ने अपने क़हर में सिय्यून की बेटी को कैसे बादल से छिपा दिया!</para>
  <para style="q" vid="LAM 2:1">उसने इस्राईल की खू़बसूरती को आसमान से ज़मीन पर गिरा दिया,</para>
  <para style="q" vid="LAM 2:1">और अपने ग़ज़ब के दिन भी अपने पैरों की चौकी को याद न किया।<verse eid="LAM 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 2:2"/>ख़ुदावन्द ने या'क़ूब के तमाम घर हलाक किए, और रहम न किया;</para>
  <para style="q" vid="LAM 2:2">उसने अपने क़हर में यहूदाह की बेटी के तमाम क़िले' गिराकर ख़ाक में मिला दिए उसने मुल्कों और उसके हाकिमों को नापाक ठहराया।<verse eid="LAM 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 2:3"/>उसने बड़े ग़ज़ब में इस्राईल का सींग बिल्कुल काट डाला;</para>
  <para style="q" vid="LAM 2:3">उसने दुश्मन के सामने से दहना हाथ खींच लिया;</para>
  <para style="q" vid="LAM 2:3">और उसने जलाने वाली आग की तरह, जो चारों तरफ़ ख़ाक करती है, या'कू़ब को जला दिया।<verse eid="LAM 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 2:4"/>उसने दुश्मन की तरह कमान खींची, मुख़ालिफ़ की तरह दहना हाथ बढ़ाया,</para>
  <para style="q" vid="LAM 2:4">और सिय्यून की बेटी के खे़में में सब हसीनों को क़त्ल किया!</para>
  <para style="q" vid="LAM 2:4">उसने अपने क़हर की आग को उँडेल दिया।<verse eid="LAM 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 2:5"/>ख़ुदावन्द दुश्मन की तरह हो गया, वह इस्राईल को निगल गया,</para>
  <para style="q" vid="LAM 2:5">वह उसके तमाम महलों को निगल गया, उसने उसके क़िले' मिस्मार कर दिए,</para>
  <para style="q" vid="LAM 2:5">और उसने दुख़्तर — ए — यहूदाह में मातम — ओ नौहा बहुतायत से कर दिया।<verse eid="LAM 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 2:6"/>और उसने अपने घर को एक बार में ही बर्बाद कर दिया,</para>
  <para style="q" vid="LAM 2:6">गोया ख़ैमा — ए — बाग़ था; और अपने मजमे' के मकान को बर्बाद कर दिया;</para>
  <para style="q" vid="LAM 2:6">ख़ुदावन्द ने मुक़द्दस 'ईदों और सबतों को सिय्यून से फ़रामोश करा दिया,</para>
  <para style="q" vid="LAM 2:6">और अपने क़हर के जोश में बादशाह और काहिन को ज़लील किया।<verse eid="LAM 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 2:7"/>ख़ुदावन्द ने अपने मज़बह को रद्द किया,</para>
  <para style="q" vid="LAM 2:7">उसने अपने मक़दिस से नफ़रत की,</para>
  <para style="q" vid="LAM 2:7">उसके महलों की दीवारों को दुश्मन के हवाले कर दिया;</para>
  <para style="q" vid="LAM 2:7">उन्होंने ख़ुदावन्द के घर में ऐसा शोर मचाया, जैसा 'ईद के दिन।<verse eid="LAM 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 2:8"/>ख़ुदावन्द ने दुख़्तर — ए — सिय्यून की दीवार गिराने का इरादा किया है;</para>
  <para style="q" vid="LAM 2:8">उसने डोरी डाली है, और बर्बाद करने से दस्तबरदार नहीं हुआ;</para>
  <para style="q" vid="LAM 2:8">उसने फ़सील और दीवार को मग़मूम किया; वह एक साथ मातम करती हैं।<verse eid="LAM 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 2:9"/>उसके दरवाज़े ज़मीन में गर्क़ हो गए;</para>
  <para style="q" vid="LAM 2:9">उसने उसके बेन्डों को तोड़कर बर्बाद कर दिया;</para>
  <para style="q" vid="LAM 2:9">उसके बादशाह और उमरा बे — शरी'अत क़ौमों में हैं;</para>
  <para style="q" vid="LAM 2:9">उसके नबी भी ख़ुदावन्द की तरफ़ से कोई ख़्वाब नहीं देखते।<verse eid="LAM 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 2:10"/>दुख़्तर — ए — सिय्यून के बुज़ुर्ग ख़ाक नशीन और ख़ामोश हैं;</para>
  <para style="q" vid="LAM 2:10">वह अपने सिरों पर ख़ाक डालते और टाट ओढ़ते हैं;</para>
  <para style="q" vid="LAM 2:10">येरूशलेम की कुँवारियाँ ज़मीन पर सिर झुकाए हैं।<verse eid="LAM 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 2:11"/>मेरी आँखें रोते — रोते धुंदला गईं,</para>
  <para style="q" vid="LAM 2:11">मेरे अन्दर पेच — ओ — ताब है,</para>
  <para style="q" vid="LAM 2:11">मेरी दुख़्तर — ए — क़ौम की बर्बादी के ज़रिए' मेरा कलेजा निकल आया;</para>
  <para style="q" vid="LAM 2:11">क्यूँकि छोटे बच्चे और दूध पीने वाले शहर की गलियों में बेहोश हैं।<verse eid="LAM 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 2:12"/>जब वह शहर की गलियों में के ज़ख्मियों की तरह ग़श खाते,</para>
  <para style="q" vid="LAM 2:12">और जब अपनी माँओं की गोद में जाँ बलब होते हैं;</para>
  <para style="q" vid="LAM 2:12">तो उनसे कहते हैं, कि ग़ल्ला और मय कहाँ है?<verse eid="LAM 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 2:13"/>ऐ दुख़्तर — ए — येरूशलेम, मैं तुझे क्या नसीहत करूँ, और किससे मिसाल दूँ?</para>
  <para style="q" vid="LAM 2:13">ऐ कुँवारी दुख्त़र — ए — सिय्यून, तुझे किस की तरह जान कर तसल्ली दूँ?</para>
  <para style="q" vid="LAM 2:13">क्यूँकि तेरा ज़ख़्म समुन्दर सा बड़ा है; तुझे कौन शिफ़ा देगा?<verse eid="LAM 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 2:14"/>तेरे नबियों ने तेरे लिए, बातिल और बेहूदा ख़्वाब देखे:और तेरी बदकिरदारी ज़ाहिर न की,</para>
  <para style="q" vid="LAM 2:14">ताकि तुझे ग़ुलामी से वापस लाते:बल्कि तेरे लिए झूटे पैग़ाम और जिलावतनी के सामान देखे।<verse eid="LAM 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 2:15"/>सब आने जानेवाले तुझ पर तालियाँ बजाते हैं;</para>
  <para style="q" vid="LAM 2:15">वह दुख़्तर — ए — येरूशलेम पर सुसकारते और सिर हिलाते हैं,</para>
  <para style="q" vid="LAM 2:15">के क्या, ये वही शहर है,</para>
  <para style="q" vid="LAM 2:15">जिसे लोग कमाल — ए — हुस्न और फ़रहत — ए — जहाँ कहते थे?<verse eid="LAM 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 2:16"/>तेरे सब दुश्मनों ने तुझ पर मुँह पसारा है;</para>
  <para style="q" vid="LAM 2:16">वह सुसकारते और दाँत पीसते हैं; वो कहते हैं, हम उसे निगल गए;</para>
  <para style="q" vid="LAM 2:16">बेशक हम इसी दिन के मुन्तज़िर थे;</para>
  <para style="q" vid="LAM 2:16">इसलिए आ पहुँचा, और हम ने देख लिया<verse eid="LAM 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 2:17"/>ख़ुदावन्द ने जो तय किया वही किया;</para>
  <para style="q" vid="LAM 2:17">उसने अपने कलाम को, जो पुराने दिनों में फ़रमाया था, पूरा किया;</para>
  <para style="q" vid="LAM 2:17">उसने गिरा दिया, और रहम न किया; और उसने दुश्मन को तुझ पर शादमान किया,</para>
  <para style="q" vid="LAM 2:17">उसने तेरे मुख़ालिफ़ों का सींग बलन्द किया।<verse eid="LAM 2:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 2:18"/>उनके दिलों ने ख़ुदावन्द से फ़रियाद की,</para>
  <para style="q" vid="LAM 2:18">ऐ दुख़्तर — ए — सिय्यून की फ़सील,</para>
  <para style="q" vid="LAM 2:18">शब — ओ — रोज़ ऑसू नहर की तरह जारी रहें;</para>
  <para style="q" vid="LAM 2:18">तू बिल्कुल आराम न ले; तेरी आँख की पुतली आराम न करे।<verse eid="LAM 2:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 2:19"/>उठ रात को पहरों के शुरू' में फ़रियाद कर;</para>
  <para style="q" vid="LAM 2:19">ख़ुदावन्द के हुजू़र अपना दिल पानी की तरह उँडेल दे;</para>
  <para style="q" vid="LAM 2:19">अपने बच्चों की ज़िन्दगी के लिए, जो सब गलियों में भूक से बेहोश पड़े हैं,</para>
  <para style="q" vid="LAM 2:19">उसके सामने में दस्त — ए — दु'आ बलन्द कर।<verse eid="LAM 2:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 2:20"/>ऐ ख़ुदावन्द, नज़र कर, और देख, कि तू ने किससे ये किया!</para>
  <para style="q" vid="LAM 2:20">क्या 'औरतें अपने फल या'नी अपने लाडले बच्चों को खाएँ?</para>
  <para style="q" vid="LAM 2:20">क्या काहिन और नबी ख़ुदावन्द के मक़्दिस में क़त्ल किए जाएँ?<verse eid="LAM 2:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 2:21"/>बुज़ुर्ग — ओ — जवान गलियों में ख़ाक पर पड़े हैं;</para>
  <para style="q" vid="LAM 2:21">मेरी कुँवारियाँ और मेरे जवान तलवार से क़त्ल हुए;</para>
  <para style="q" vid="LAM 2:21">तू ने अपने क़हर के दिन उनको क़त्ल किया;</para>
  <para style="q" vid="LAM 2:21">तूने उनको काट डाला, और रहम न किया।<verse eid="LAM 2:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 2:22"/>तूने मेरी दहशत को हर तरफ से गोया 'ईद के दिन बुला लिया,</para>
  <para style="q" vid="LAM 2:22">और ख़ुदावन्द के क़हर के दिन न कोई बचा, न बाक़ी रहा;</para>
  <para style="q" vid="LAM 2:22">जिनको मैंने गोद में खिलाया और पला पोसा, मेरे दुश्मनों ने फ़ना कर दिया।<verse eid="LAM 2:22"/></para>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="s">ख़ुदा की भरोसेमंदी में उम्मीद</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 3:1"/>मैं ही वह शख़्स हूँ जिसने उसके ग़ज़ब की लाठी से दुख पाया।<verse eid="LAM 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 3:2"/>वह मेरा रहबर हुआ, और मुझे रौशनी में नहीं, बल्कि तारीकी में चलाया;<verse eid="LAM 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 3:3"/>यक़ीनन उसका हाथ दिन भर मेरी मुख़ालिफ़त करता रहा।<verse eid="LAM 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 3:4"/>उसने मेरा गोश्त और चमड़ा ख़ुश्क कर दिया,</para>
  <para style="q" vid="LAM 3:4">और मेरी हड्डियाँ तोड़ डालीं,<verse eid="LAM 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 3:5"/>उसने मेरे चारों तरफ़ दीवार खेंची</para>
  <para style="q" vid="LAM 3:5">और मुझे कड़वाहट और — मशक़्क़त से घेर लिया;<verse eid="LAM 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 3:6"/>उसने मुझे लम्बे वक़्त से मुर्दों की तरह तारीक मकानों में रख्खा।<verse eid="LAM 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 3:7"/>उसने मेरे गिर्द अहाता बना दिया, कि मैं बाहर नहीं निकल सकता;</para>
  <para style="q" vid="LAM 3:7">उसने मेरी ज़ंजीर भारी कर दी।<verse eid="LAM 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 3:8"/>बल्कि जब मैं पुकारता और दुहाई देता हूँ,</para>
  <para style="q" vid="LAM 3:8">तो वह मेरी फ़रियाद नहीं सुनता।<verse eid="LAM 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 3:9"/>उसने तराशे हुए पत्थरों से मेरे रास्तेबन्द कर दिए,</para>
  <para style="q" vid="LAM 3:9">उसने मेरी राहें टेढ़ी कर दीं।<verse eid="LAM 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 3:10"/>वह मेरे लिए घात में बैठा हुआ रीछ और कमीनगाह का शेर — ए — बब्बर है।<verse eid="LAM 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 3:11"/>उसने मेरी राहें तंग कर दीं और मुझे रेज़ा — रेज़ा करके बर्बाद कर दिया।<verse eid="LAM 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 3:12"/>उसने अपनी कमान खींची और मुझे अपने तीरों का निशाना बनाया।<verse eid="LAM 3:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 3:13"/>उसने अपने तर्कश के तीरों से मेरे गुर्दों को छेद डाला।<verse eid="LAM 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 3:14"/>मैं अपने सब लोगों के लिए मज़ाक़, और दिन भर उनका चर्चा हूँ।<verse eid="LAM 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 3:15"/>उसने मुझे तल्ख़ी से भर दिया और नाग़दोने से मदहोश किया।<verse eid="LAM 3:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 3:16"/>उसने संगरेज़ों से मेरे दाँत तोड़े और मुझे ज़मीन की तह में लिटाया।<verse eid="LAM 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 3:17"/>तू ने मेरी जान को सलामती से दूरकर दिया,</para>
  <para style="q" vid="LAM 3:17">मैं ख़ुशहाली को भूल गया;<verse eid="LAM 3:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 3:18"/>और मैंने कहा, “मैं नातवाँ हुआ,</para>
  <para style="q" vid="LAM 3:18">और ख़ुदावन्द से मेरी उम्मीद जाती रही।”<verse eid="LAM 3:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 3:19"/>मेरे दुख का ख़्याल कर; मेरी मुसीबत,</para>
  <para style="q" vid="LAM 3:19">या'नी तल्ख़ी और नाग़दोने को याद कर।<verse eid="LAM 3:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 3:20"/>इन बातों की याद से मेरी जान मुझ में बेताब है।<verse eid="LAM 3:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 3:21"/>मैं इस पर सोचता रहता हूँ, इसीलिए मैं उम्मीदवार हूँ।<verse eid="LAM 3:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 3:22"/>ये ख़ुदावन्द की शफ़क़त है, कि हम फ़ना नहीं हुए, क्यूँकि उसकी रहमत ला ज़वाल है।<verse eid="LAM 3:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="LAM 3:23"/>वह हर सुबह ताज़ा है; तेरी वफ़ादारी 'अज़ीम है<verse eid="LAM 3:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="LAM 3:24"/>मेरी जान ने कहा, “मेरा हिस्सा ख़ुदावन्द है, इसलिए मेरी उम्मीद उसी से है।”<verse eid="LAM 3:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="LAM 3:25"/>ख़ुदावन्द उन पर महरबान है, जो उसके मुन्तज़िर हैं; उस जान पर जो उसकी तालिब है।<verse eid="LAM 3:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="LAM 3:26"/>ये खू़ब है कि आदमी उम्मीदवार रहे और ख़ामोशी से ख़ुदावन्द की नजात का इन्तिज़ार करे।<verse eid="LAM 3:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="LAM 3:27"/>आदमी के लिए बेहतर है कि अपनी जवानी के दिनों में फ़रमॉबरदारी करे।<verse eid="LAM 3:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="LAM 3:28"/>वह तन्हा बैठे और ख़ामोश रहे, क्यूँकि ये ख़ुदा ही ने उस पर रख्खा है।<verse eid="LAM 3:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="LAM 3:29"/>वह अपना मुँह ख़ाक पर रख्खे, कि शायद कुछ उम्मीद की सूरत निकले।<verse eid="LAM 3:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="LAM 3:30"/>वह अपना गाल उसकी तरफ़ फेर दे, जो उसे तमाँचा मारता है और मलामत से खू़ब सेर हो<verse eid="LAM 3:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="LAM 3:31"/>क्यूँकि ख़ुदावन्द हमेशा के लिए रद्द न करेगा,<verse eid="LAM 3:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="LAM 3:32"/>क्यूँकि अगरचे वह दुख़ दे, तोभी अपनी शफ़क़त की दरयादिली से रहम करेगा।<verse eid="LAM 3:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="LAM 3:33"/>क्यूँकि वह बनी आदम पर खु़शी से दुख़ मुसीबत नहीं भेजता।<verse eid="LAM 3:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="LAM 3:34"/>रू — ए — ज़मीन के सब कै़दियों को पामाल करना<verse eid="LAM 3:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="LAM 3:35"/>हक़ ताला के सामने किसी इंसान की हक़ तल्फ़ी करना,<verse eid="LAM 3:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="LAM 3:36"/>और किसी आदमी का मुक़द्दमा बिगाड़ना,</para>
  <para style="q" vid="LAM 3:36">ख़ुदावन्द देख नहीं सकता।<verse eid="LAM 3:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="LAM 3:37"/>वह कौन है जिसके कहने के मुताबिक़ होता है,</para>
  <para style="q" vid="LAM 3:37">हालाँकि ख़ुदावन्द नहीं फ़रमाता?<verse eid="LAM 3:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="LAM 3:38"/>क्या भलाई और बुराई हक़ ताला ही के हुक्म से नहीं हैं?<verse eid="LAM 3:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="LAM 3:39"/>इसलिए आदमी जीते जी क्यूँ शिकायत करे,</para>
  <para style="q" vid="LAM 3:39">जब कि उसे गुनाहों की सज़ा मिलती हो?<verse eid="LAM 3:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="LAM 3:40"/>हम अपनी राहों को ढूंडें और जाँचें,</para>
  <para style="q" vid="LAM 3:40">और ख़ुदावन्द की तरफ़ फिरें।<verse eid="LAM 3:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="LAM 3:41"/>हम अपने हाथों के साथ दिलों को भी ख़ुदा के सामने आसमान की तरफ़ उठाएँ:<verse eid="LAM 3:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="LAM 3:42"/>हम ने ख़ता और सरकशी की,</para>
  <para style="q" vid="LAM 3:42">तूने मु'आफ़ नहीं किया।<verse eid="LAM 3:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="LAM 3:43"/>तू ने हम को क़हर से ढाँपा और रगेदा;</para>
  <para style="q" vid="LAM 3:43">तूने क़त्ल किया, और रहम न किया।<verse eid="LAM 3:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="LAM 3:44"/>तू बादलों में मस्तूर हुआ, ताकि हमारी दुआ तुझ तक न पहुँचे।<verse eid="LAM 3:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="LAM 3:45"/>तूने हम को क़ौमों के बीच कूड़े करकट और नजासत सा बना दिया।<verse eid="LAM 3:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="LAM 3:46"/>हमारे सब दुश्मन हम पर मुँह पसारते हैं;<verse eid="LAM 3:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="LAM 3:47"/>ख़ौफ़ — और — दहशत और वीरानी — और — हलाकत ने हम को आ दबाया।<verse eid="LAM 3:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="LAM 3:48"/>मेरी दुख़्तर — ए — क़ौम की तबाही के ज़रिए' मेरी आँखों से आँसुओं की नहरें जारी हैं।<verse eid="LAM 3:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="LAM 3:49"/>मेरी ऑखें अश्कबार हैं और थमती नहीं, उनको आराम नहीं,<verse eid="LAM 3:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="LAM 3:50"/>जब तक ख़ुदावन्द आसमान पर से नज़र करके न देखे;<verse eid="LAM 3:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="LAM 3:51"/>मेरी आँखें मेरे शहर की सब बेटियों के लिए मेरी जान को आज़ुर्दा करती हैं।<verse eid="LAM 3:51"/></para>
  <para style="q">
    <verse number="52" style="v" sid="LAM 3:52"/>मेरे दुश्मनों ने बे वजह मुझे परिन्दे की तरह दौड़ाया;<verse eid="LAM 3:52"/></para>
  <para style="q">
    <verse number="53" style="v" sid="LAM 3:53"/>उन्होंने चाह — ए — ज़िन्दान में मेरी जान लेने को मुझ पर पत्थर रख्खा;<verse eid="LAM 3:53"/></para>
  <para style="q">
    <verse number="54" style="v" sid="LAM 3:54"/>पानी मेरे सिर से गुज़र गया, मैंने कहा, 'मैं मर मिटा।<verse eid="LAM 3:54"/></para>
  <para style="q">
    <verse number="55" style="v" sid="LAM 3:55"/>ऐ ख़ुदावन्द, मैंने तह दिल से तेरे नाम की दुहाई दी;<verse eid="LAM 3:55"/></para>
  <para style="q">
    <verse number="56" style="v" sid="LAM 3:56"/>तू ने मेरी आवाज़ सुनी है, मेरी आह — ओ — फ़रियाद से अपना कान बन्द न कर।<verse eid="LAM 3:56"/></para>
  <para style="q">
    <verse number="57" style="v" sid="LAM 3:57"/>जिस रोज़ मैने तुझे पुकारा, तू नज़दीक आया; और तू ने फ़रमाया, “परेशान न हो!”<verse eid="LAM 3:57"/></para>
  <para style="q">
    <verse number="58" style="v" sid="LAM 3:58"/>ऐ ख़ुदावन्द, तूने मेरी जान की हिमायत की और उसे छुड़ाया।<verse eid="LAM 3:58"/></para>
  <para style="q">
    <verse number="59" style="v" sid="LAM 3:59"/>ऐ ख़ुदावन्द, तू ने मेरी मज़लूमी देखी; मेरा इन्साफ़ कर।<verse eid="LAM 3:59"/></para>
  <para style="q">
    <verse number="60" style="v" sid="LAM 3:60"/>तूने मेरे ख़िलाफ़ उनके तमाम इन्तक़ामऔर सब मन्सूबों को देखा है।<verse eid="LAM 3:60"/></para>
  <para style="q">
    <verse number="61" style="v" sid="LAM 3:61"/>ऐ ख़ुदावन्द, तूने मेरे ख़िलाफ़ उनकी मलामत और उनके सब मन्सूबों को सुना है;<verse eid="LAM 3:61"/></para>
  <para style="q">
    <verse number="62" style="v" sid="LAM 3:62"/>जो मेरी मुख़ालिफ़त को उठे उनकी बातें और दिन भर मेरी मुख़ालिफ़त में उनके मन्सूबे।<verse eid="LAM 3:62"/></para>
  <para style="q">
    <verse number="63" style="v" sid="LAM 3:63"/>उनकी महफ़िल — ओ — बरख़ास्त को देख कि मेरा ही ज़िक्र है।<verse eid="LAM 3:63"/></para>
  <para style="q">
    <verse number="64" style="v" sid="LAM 3:64"/>ऐ ख़ुदावन्द, उनके 'आमाल के मुताबिक़ उनको बदला दे।<verse eid="LAM 3:64"/></para>
  <para style="q">
    <verse number="65" style="v" sid="LAM 3:65"/>उनको कोर दिल बना कि तेरी ला'नत उन पर हो।<verse eid="LAM 3:65"/></para>
  <para style="q">
    <verse number="66" style="v" sid="LAM 3:66"/>हे यहोवा, क़हर से उनको भगा और रू — ए — ज़मीन से नेस्त — ओ — नाबूद कर दे।<verse eid="LAM 3:66"/></para>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="s">ख़ुदा का गुस्सा पूरा होना</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 4:1"/>सोना कैसा बेआब हो गया! कुन्दन कैसा बदल गया!</para>
  <para style="q" vid="LAM 4:1">मक़्दिस के पत्थर तमाम गली कूचों में पड़े हैं!<verse eid="LAM 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 4:2"/>सिय्यून के 'अज़ीज़ फ़र्ज़न्द, जो ख़ालिस सोने की तरह थे,</para>
  <para style="q" vid="LAM 4:2">कैसे कुम्हार के बनाए हुए बर्तनों के बराबर ठहरे!<verse eid="LAM 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 4:3"/>गीदड़ भी अपनी छातियों से अपने बच्चों को दूध पिलाते हैं;</para>
  <para style="q" vid="LAM 4:3">लेकिन मेरी दुख़्तर — ए — क़ौम वीरानी शुतरमुर्ग़ की तरह बे — रहम है।<verse eid="LAM 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 4:4"/>दूध पीते बच्चों की ज़बान प्यास के मारे तालू से जा लगी;</para>
  <para style="q" vid="LAM 4:4">बच्चे रोटी मांगते हैं लेकिन उनको कोई नहीं देता।<verse eid="LAM 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 4:5"/>जो नाज़ पर्वरदा थे, गलियों में तबाह हाल हैं;</para>
  <para style="q" vid="LAM 4:5">जो बचपन से अर्ग़वानपोश थे, मज़बलों पर पड़े हैं।<verse eid="LAM 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 4:6"/>क्यूँकि मेरी दुख़्तर — ए — क़ौम की बदकिरदारी सदूम के गुनाह से बढ़कर है,</para>
  <para style="q" vid="LAM 4:6">जो एक लम्हे में बर्बाद हुआ, और किसी के हाथ उस पर दराज़ न हुए।<verse eid="LAM 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 4:7"/>उसके शुर्फ़ा बर्फ़ से ज़्यादा साफ़ और दूध से सफ़ेद थे,</para>
  <para style="q" vid="LAM 4:7">उनके बदन मूंगे से ज़्यादा सुर्ख थे, उन की झलक नीलम की सी थी;<verse eid="LAM 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 4:8"/>अब उनके चेहरे सियाही से भी काले हैं; वह बाज़ार में पहचाने नहीं जाते;</para>
  <para style="q" vid="LAM 4:8">उनका चमड़ा हड्डियों से सटा है; वह सूख कर लकड़ी सा हो गया।<verse eid="LAM 4:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 4:9"/>तलवार से क़त्ल होने वाले, भूकों मरने वालों से बहतर हैं;</para>
  <para style="q" vid="LAM 4:9">क्यूँकि ये खेत का हासिल न मिलने से कुढ़कर हलाक होते हैं।<verse eid="LAM 4:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 4:10"/>रहमदिल 'औरतों के हाथों ने अपने बच्चों को पकाया;</para>
  <para style="q" vid="LAM 4:10">मेरी दुख़्तर — ए — क़ौम की तबाही में वही उनकी खू़राक हुए।<verse eid="LAM 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 4:11"/>ख़ुदावन्द ने अपने ग़ज़ब को अन्जाम दिया;</para>
  <para style="q" vid="LAM 4:11">उसने अपने क़हर — ए — शदीद को नाज़िल किया।</para>
  <para style="q" vid="LAM 4:11">और उसने सिय्यून में आग भड़काई जो उसकी बुनियाद को चट कर गई।<verse eid="LAM 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 4:12"/>रू — ए — ज़मीन के बादशाह और दुनिया के बाशिन्दे बावर नहीं करते थे,</para>
  <para style="q" vid="LAM 4:12">कि मुख़ालिफ़ और दुश्मन येरूशलेम के फाटकों से घुस आएँगे।<verse eid="LAM 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 4:13"/>ये उसके नबियों के गुनाहों और काहिनों की बदकिरदारी की वजह से हुआ,</para>
  <para style="q" vid="LAM 4:13">जिन्होंने उसमें सच्चों का खू़न बहाया।<verse eid="LAM 4:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 4:14"/>वह अन्धों की तरह गलियों में भटकते,</para>
  <para style="q" vid="LAM 4:14">और खू़न से आलूदा होते हैं, ऐसा कि कोई उनके लिबास को भी छू नहीं सकता।<verse eid="LAM 4:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 4:15"/>वह उनको पुकार कर कहते थे, दूर रहो! नापाक, दूर रहो! दूर रहो, छूना मत!</para>
  <para style="q" vid="LAM 4:15">“जब वह भाग जाते और आवारा फिरते, तो लोग कहते थे, 'अब ये यहाँ न रहेंगे।”<verse eid="LAM 4:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 4:16"/>ख़ुदावन्द के क़हर ने उनको पस्त किया, अब वह उन पर नज़र नहीं करेगा;</para>
  <para style="q" vid="LAM 4:16">उन्होंने काहिनों की 'इज़्ज़त न की, और बुज़ुगों का लिहाज़ न किया।<verse eid="LAM 4:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 4:17"/>हमारी आँखें बातिल मदद के इन्तिज़ार में थक गईं,</para>
  <para style="q" vid="LAM 4:17">हम उस क़ौम का इन्तिज़ार करते रहे जो बचा नहीं सकती थी।<verse eid="LAM 4:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 4:18"/>उन्होंने हमारे पाँव ऐसे बाँध रख्खे हैं, कि हम बाहर नहीं निकल सकते;</para>
  <para style="q" vid="LAM 4:18">हमारा अन्जाम नज़दीक है, हमारे दिन पूरे हो गए; हमारा वक़्त आ पहुँचा।<verse eid="LAM 4:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 4:19"/>हम को दौड़ाने वाले आसमान के उक़ाबों से भी तेज़ हैं;</para>
  <para style="q" vid="LAM 4:19">उन्होंने पहाड़ों पर हमारा पीछा किया; वह वीराने में हमारी घात में बैठे।<verse eid="LAM 4:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 4:20"/>हमारी ज़िन्दगी का दम ख़ुदावन्द का मम्सूह,</para>
  <para style="q" vid="LAM 4:20">उनके गढ़ों में गिरफ़्तार हो गया;</para>
  <para style="q" vid="LAM 4:20">जिसकी वजह हम कहते थे, कि उसके साये तले हम क़ौमों के बीच ज़िन्दगी बसर करेंगे।<verse eid="LAM 4:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 4:21"/>ऐ दुख़्तर — ए — अदोम, जो 'ऊज़ की सरज़मीन में बसती है,</para>
  <para style="q" vid="LAM 4:21">ख़ुश — और — ख़ुर्रम हो; ये प्याला तुझ तक भी पहुँचेगा;</para>
  <para style="q" vid="LAM 4:21">तू मस्त और बरहना हो जाएगी।<verse eid="LAM 4:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 4:22"/>ऐ दुख़्तर — ए — सिय्यून, तेरी बदकिरदारी की सज़ा तमाम हुई;</para>
  <para style="q" vid="LAM 4:22">वह मुझे फिर ग़ुलाम करके नहीं ले जाएगा;</para>
  <para style="q" vid="LAM 4:22">ऐ दुख़्तर — ए — अदोम, वह तेरी बदकिरदारी की सज़ा देगा; वह तेरे गुनाह वाश करेगा।<verse eid="LAM 4:22"/></para>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="s">दुआ और तजदीद</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 5:1"/>ऐ ख़ुदावन्द, जो कुछ हम पर गुज़रा उसे याद कर;</para>
  <para style="q" vid="LAM 5:1">नज़र कर और हमारी रुस्वाई को देख।<verse eid="LAM 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 5:2"/>हमारी मीरास अजनबियों के हवाले की गई, हमारे घर बेगानों ने ले लिए।<verse eid="LAM 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 5:3"/>हम यतीम हैं, हमारे बाप नहीं,</para>
  <para style="q" vid="LAM 5:3">हमारी माँए बेवाओं की तरह हैं।<verse eid="LAM 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 5:4"/>हम ने अपना पानी मोल लेकर पिया;</para>
  <para style="q" vid="LAM 5:4">अपनी लकड़ी भी हम ने दाम देकर ली।<verse eid="LAM 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 5:5"/>हम को रगेदने वाले हमारे सिर पर हैं;</para>
  <para style="q" vid="LAM 5:5">हम थके हारे और बेआराम हैं।<verse eid="LAM 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 5:6"/>हम ने मिस्रियों और असूरियों की इता'अत क़ुबूल की ताकि रोटी से सेर और आसूदा हों।<verse eid="LAM 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 5:7"/>हमारे बाप दादा गुनाह करके चल बसे,</para>
  <para style="q" vid="LAM 5:7">और हम उनकी बदकिरदारी की सज़ा पा रहे हैं।<verse eid="LAM 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 5:8"/>गु़लाम हम पर हुक्मरानी करते हैं;</para>
  <para style="q" vid="LAM 5:8">उनके हाथ से छुड़ाने वाला कोई नहीं।<verse eid="LAM 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 5:9"/>सहरा नशीनों की तलवार के ज़रिए', हम जान पर खेलकर रोटी हासिल करते हैं।<verse eid="LAM 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 5:10"/>क़हत की झुलसाने वाली आग के ज़रिए',</para>
  <para style="q" vid="LAM 5:10">हमारा चमड़ा तनूर की तरह सियाह हो गया है।<verse eid="LAM 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 5:11"/>उन्होंने सिय्यून में 'औरतों को बेहुरमत किया और यहूदाह के शहरों में कुँवारी लड़कियों को।<verse eid="LAM 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 5:12"/>हाकिम को उनके हाथों से लटका दिया;</para>
  <para style="q" vid="LAM 5:12">बुज़ुगों की रू — दारी न की गई।<verse eid="LAM 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 5:13"/>जवानों ने चक्की पीसी,</para>
  <para style="q" vid="LAM 5:13">और बच्चों ने गिरते पड़ते लकड़ियाँ ढोईं।<verse eid="LAM 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 5:14"/>बुज़ुर्ग फाटकों पर दिखाई नहीं देते, जवानों की नग़मा परदाज़ी सुनाई नहीं देती।<verse eid="LAM 5:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 5:15"/>हमारे दिलों से खुशी जाती रही;</para>
  <para style="q" vid="LAM 5:15">हमारा रक़्स मातम से बदल गया।<verse eid="LAM 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 5:16"/>ताज हमारे सिर पर से गिर पड़ा;</para>
  <para style="q" vid="LAM 5:16">हम पर अफ़सोस! कि हम ने गुनाह किया।<verse eid="LAM 5:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 5:17"/>इसीलिए हमारे दिल बेताब हैं;</para>
  <para style="q" vid="LAM 5:17">इन्हीं बातों के ज़रिए' हमारी आँखें धुंदला गई,<verse eid="LAM 5:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 5:18"/>कोह — ए — सिय्यून की वीरानी के ज़रिए',</para>
  <para style="q" vid="LAM 5:18">उस पर गीदड़ फिरते हैं।<verse eid="LAM 5:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 5:19"/>लेकिन तू, ऐ ख़ुदावन्द, हमेशा तक क़ायम है;</para>
  <para style="q" vid="LAM 5:19">और तेरा तख़्त नसल — दर — नसल।<verse eid="LAM 5:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 5:20"/>फिर तू क्यूँ हम को हमेशा के लिए भूल जाता है,</para>
  <para style="q" vid="LAM 5:20">और हम को लम्बे वक़्त तक तर्क करता है?<verse eid="LAM 5:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 5:21"/>ऐ ख़ुदावन्द, हम को अपनी तरफ़ फिरा, तो हम फिरेंगे;</para>
  <para style="q" vid="LAM 5:21">हमारे दिन बदल दे, जैसे पहले से थे।<verse eid="LAM 5:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 5:22"/>क्या तू ने हमको बिल्कुल रद्द कर दिया है?</para>
  <para style="q" vid="LAM 5:22">क्या तू हमसे शख़्त नाराज़ है?<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
