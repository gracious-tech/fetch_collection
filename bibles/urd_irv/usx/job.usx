<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOB" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">अय्यूब</para>
  <para style="toc1">अय्यूब</para>
  <para style="toc2">अय्यू</para>
  <para style="toc3">अय्यू</para>
  <para style="mt">अय्यूब</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">हकीक़त में कोई नहीं जानता कि अय्यूब की किताब का मुसंन्फ़ कौन है किसी मुसन्निफ़ की पहचान नहीं हुई है गालिबन इस के दो मुसन्निफ़ हो सकते हैं हो सकता हैकिय्युब की किताब बाइबिल की सब से पुरानी किताब हो अय्यूब एकदीनदार शख्स था जिस ने अपने जिस्म में शादी और न क़ाबिल — ए — बर्दाश्त अलमिया का तजुर्बा किया और उसके दोस्त लोग ये जान्ने की कोशिश करते थे कि अय्यूब ने इस तरह की मुसीबतों और आफतों का सामना क्यूँ किया? इस किताब की ख़ास शख्सियतें हैं: अय्यूब, एलिफज़ तीमानी, बिल्दद सूक़ी, नामाती जूफ़र और एलीहू बुज़ीत थे।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">ना — मा’लूम किताब के ज़्यादा तर हिस्से इशारा करते हैं कि जिलावतनी के कई अर्से बाद या जिलावतनी के फ़ौरन बाद ये किताब लिखी गई है और एलीहू के हिस्से और बाद में लिखे गए हैं।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले 1</para>
  <para style="ip">क़दीम यहूदी और मुस्तकबिल के तमाम क़ारिईन यह भी एत्काद किया जाता है किअय्यूब की किताब के असली नाज़रीन व सामईन गुलामशुदा बनी इस्राईल थे — यह भी एत्काद किया जाता है कि मूसा ने इरादा किया था कि उन्हें कुछ तसल्ली की बातें पेश करे क्यूंकि उनहोंने मिस्रियों के मातहत रहकर दुःख उठाया था।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">ज़ेल की बातें अय्यूब की किताब को समझनेमें मदद करेंगी:शैतान माली और जिस्मानी बार्बादी, नहीं ला सकता, शैतान जो कर सकता है और जो नहीं कर सकता उस पर खुदा क़ुदरत रखता है दुनया में जितनी भी दुःख मुसीबतें बनी इंसान पर आती हैं उन के लिए क्यूँ? के सवाल को समझना इंसानी क़ाबिलियत से बाहर है — शारीर किसी दिन अपने किए का बदला ज़रूर पाएगा दुःख मुसीबत हमारी जिंदगियों में कभी कभी इसलिए लाया जाता है कि हम को पाक करे, हमारा इम्तिहान ले, हमें सिखाए या हमारी जान को कुव्वत बखशे।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">मुसीबतोंके ज़रिए बरकतें।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. त आरुफ़ और शैतान का हमला — 1:1-2:13</para>
  <para style="io1">2. अय्यूब की मुसीबतों का बयान उस के तीन दोस्तों के साथ — 3:1-31:40</para>
  <para style="io1">3. एलीहू खुदा की भलाई का एलान करता है — 32:1-37:24</para>
  <para style="io1">4. खुदा अय्यूब को अपनी बरतरी का इन्किशाफ करता है — 38:1-41:34</para>
  <para style="io1">5. खुदा अय्यूब को बहाल करता है — 42:1-17</para>
  <chapter number="1" style="c" sid="JOB 1"/>
  <para style="s">तारूफ़ी तकरीर</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 1:1"/>ऊज़ की सर ज़मीन में अय्यूब नाम का एक शख़्स था। वह शख़्स कामिल और रास्तबाज़ था और ख़ुदा से डरता और गुनाह से दूर रहता था। <verse eid="JOB 1:1"/><verse number="2" style="v" sid="JOB 1:2"/>उसके यहाँ सात बेटे और तीन बेटियाँ पैदा हुईं। <verse eid="JOB 1:2"/><verse number="3" style="v" sid="JOB 1:3"/>उसके पास सात हज़ार भेंड़े और तीन हज़ार ऊँट और पाँच सौ जोड़ी बैल और पाँच सौ गधियाँ और बहुत से नौकर चाकर थे, ऐसा कि अहल — ए — मशरिक़ में वह सबसे बड़ा आदमी था। <verse eid="JOB 1:3"/><verse number="4" style="v" sid="JOB 1:4"/>उसके बेटे एक दूसरे के घर जाया करते थे और हर एक अपने दिन पर मेहमान नवाज़ी करते थे, और अपने साथ खाने — पीने को अपनी तीनों बहनों को बुलवा भेजते थे। <verse eid="JOB 1:4"/><verse number="5" style="v" sid="JOB 1:5"/>और जब उनकी मेहमान नवाज़ी के दिन पूरे हो जाते, तो अय्यूब उन्हें बुलवाकर पाक करता और सुबह को सवेरे उठकर उन सभों की ता'दाद के मुताबिक़ सोख़्तनी क़ुर्बानियाँ अदा करता था, क्यूँकि अय्यूब कहता था, कि “शायद मेरे बेटों ने कुछ ख़ता की हो और अपने दिल में ख़ुदा की बुराई की हो।” अय्यूब हमेशा ऐसा ही किया करता था। <verse eid="JOB 1:5"/><verse number="6" style="v" sid="JOB 1:6"/>और एक दिन ख़ुदा के बेटे आए कि ख़ुदावन्द के सामने हाज़िर हों, और उनके बीच शैतान भी आया। <verse eid="JOB 1:6"/><verse number="7" style="v" sid="JOB 1:7"/>और ख़ुदावन्द ने शैतान से पूछा, कि “तू कहाँ से आता है?” शैतान ने ख़ुदावन्द को जवाब दिया, कि “ज़मीन पर इधर — उधर घूमता फिरता और उसमें सैर करता हुआ आया हूँ।” <verse eid="JOB 1:7"/><verse number="8" style="v" sid="JOB 1:8"/>ख़ुदावन्द ने शैतान से कहा, “क्या तू ने मेरे बन्दे अय्यूब के हाल पर भी कुछ ग़ौर किया? क्यूँकि ज़मीन पर उसकी तरह कामिल और रास्तबाज़ आदमी, जो ख़ुदा से डरता, और गुनाह से दूर रहता हो, कोई नहीं।” <verse eid="JOB 1:8"/><verse number="9" style="v" sid="JOB 1:9"/>शैतान ने ख़ुदावन्द को जवाब दिया, “क्या अय्यूब यूँ ही ख़ुदा से डरता' है? <verse eid="JOB 1:9"/><verse number="10" style="v" sid="JOB 1:10"/>क्या तू ने उसके और उसके घर के चारों तरफ़, और जो कुछ उसका है उस सबके चारों तरफ़ बाड़ नहीं बनाई है? तू ने उसके हाथ के काम में बरकत बख़्शी है, और उसके गल्ले मुल्क में बढ़ गए हैं। <verse eid="JOB 1:10"/><verse number="11" style="v" sid="JOB 1:11"/>लेकिन तू ज़रा अपना हाथ बढ़ा कर जो कुछ उसका है उसे छू ही दे; तो क्या वह तेरे मुँह पर तेरी बुराई न करेगा?” <verse eid="JOB 1:11"/><verse number="12" style="v" sid="JOB 1:12"/>ख़ुदावन्द ने शैतान से कहा, “देख, उसका सब कुछ तेरे इख़्तियार में है, सिर्फ़ उसको हाथ न लगाना।” तब शैतान ख़ुदावन्द के सामने से चला गया। <verse eid="JOB 1:12"/><verse number="13" style="v" sid="JOB 1:13"/>और एक दिन जब उसके बेटे और बेटियाँ अपने बड़े भाई के घर में खाना खा रहे और मयनोशी कर रहे थे। <verse eid="JOB 1:13"/><verse number="14" style="v" sid="JOB 1:14"/>तो एक क़ासिद ने अय्यूब के पास आकर कहा, कि “बैल हल में जुते थे और गधे उनके पास चर रहे थे, <verse eid="JOB 1:14"/><verse number="15" style="v" sid="JOB 1:15"/>कि सबा के लोग उन पर टूट पड़े और उन्हें ले गए, और नौकरों को हलाक किया और सिर्फ़ मैं ही अकेला बच निकला कि तुझे ख़बर दूँ।” <verse eid="JOB 1:15"/><verse number="16" style="v" sid="JOB 1:16"/>वह अभी यह कह ही रहा था कि एक और भी आकर कहने लगा, कि “ख़ुदा की आग आसमान से नाज़िल हुई और भेड़ों और नौकरों को जलाकर भस्म कर दिया, और सिर्फ़ मैं ही अकेला बच निकला कि तुझे ख़बर दूँ।” <verse eid="JOB 1:16"/><verse number="17" style="v" sid="JOB 1:17"/>वह अभी यह कह ही रहा था कि एक और भी आकर कहने लगा, 'कसदी तीन ग़ोल होकर ऊँटों पर आ गिरे और उन्हें ले गए, और नौकरों को हलाक किया और सिर्फ़ मैं ही अकेला बच निकला कि तुझे ख़बर दूँ। <verse eid="JOB 1:17"/><verse number="18" style="v" sid="JOB 1:18"/>वह अभी यह कह ही रहा था कि एक और भी आकर कहने लगा, कि “तेरे बेटे बेटियाँ अपने बड़े भाई के घर में खाना खा रहे और मयनोशी कर रहे थे, <verse eid="JOB 1:18"/><verse number="19" style="v" sid="JOB 1:19"/>और देख, वीरान से एक बड़ी आँधी चली और उस घर के चारों कोनों पर ऐसे ज़ोर से टकराई कि वह उन जवानों पर गिर पड़ा, और वह मर गए और सिर्फ़ मैं ही अकेला बच निकला कि तुझे ख़बर दूँ।” <verse eid="JOB 1:19"/><verse number="20" style="v" sid="JOB 1:20"/>तब अय्यूब ने उठकर अपना लिबास चाक किया और सिर मुंडाया और ज़मीन पर गिरकर सिज्दा किया <verse eid="JOB 1:20"/><verse number="21" style="v" sid="JOB 1:21"/>और कहा, “नंगा मैं अपनी माँ के पेट से निकला, और नंगा ही वापस जाऊँगा। ख़ुदावन्द ने दिया और ख़ुदावन्द ने ले लिया। ख़ुदावन्द का नाम मुबारक हो।” <verse eid="JOB 1:21"/><verse number="22" style="v" sid="JOB 1:22"/>इन सब बातों में अय्यूब ने न तो गुनाह किया और न ख़ुदा पर ग़लत काम का 'ऐब लगाया।<verse eid="JOB 1:22"/></para>
  <chapter eid="JOB 1"/>
  <chapter number="2" style="c" sid="JOB 2"/>
  <para style="s">अय्यूब की दुसरी परख</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 2:1"/>फिर एक दिन ख़ुदा के बेटे आए कि ख़ुदावन्द के सामने हाज़िर हों, और शैतान भी उनके बीच आया कि ख़ुदावन्द के आगे हाज़िर हो। <verse eid="JOB 2:1"/><verse number="2" style="v" sid="JOB 2:2"/>और ख़ुदावन्द ने शैतान से पूछा, कि “तू कहाँ से आता है?” शैतान ने ख़ुदावन्द को जवाब दिया, कि “ज़मीन पर इधर — उधर घूमता फिरता और उसमें सैर करता हुआ आया हूँ।” <verse eid="JOB 2:2"/><verse number="3" style="v" sid="JOB 2:3"/>ख़ुदावन्द ने शैतान से कहा, “क्या तू ने मेरे बन्दे अय्यूब के हाल पर भी कुछ ग़ौर किया; क्यूँकि ज़मीन पर उसकी तरह कामिल और रास्तबाज़ आदमी जो ख़ुदा से डरता और गुनाह से दूर रहता हो, कोई नहीं और गो तू ने मुझको उभारा कि बे वजह उसे हलाक करूँ, तोभी वह अपनी रास्तबाज़ी पर क़ाईम है?” <verse eid="JOB 2:3"/><verse number="4" style="v" sid="JOB 2:4"/>शैतान ने ख़ुदावन्द को जवाब दिया, “कि 'खाल के बदले खाल, बल्कि इंसान अपना सारा माल अपनी जान के लिए दे डालेगा। <verse eid="JOB 2:4"/><verse number="5" style="v" sid="JOB 2:5"/>अब सिर्फ़ अपना हाथ बढ़ाकर उसकी हड्डी और उसके गोश्त को छू दे, तो वह तेरे मुँह पर तेरी बुराई करेगा।” <verse eid="JOB 2:5"/><verse number="6" style="v" sid="JOB 2:6"/>ख़ुदावन्द ने शैतान से कहा, कि “देख, वह तेरे इख़्तियार में है, सिर्फ़ उसकी जान महफ़ूज़ रहे।” <verse eid="JOB 2:6"/><verse number="7" style="v" sid="JOB 2:7"/>तब शैतान ख़ुदावन्द के सामने से चला गया और अय्यूब को तलवे से चाँद तक दर्दनाक फोड़ों से दुख दिया। <verse eid="JOB 2:7"/><verse number="8" style="v" sid="JOB 2:8"/>और वहअपने को खुजलाने के लिए एक ठीकरा लेकर राख पर बैठ गया। <verse eid="JOB 2:8"/><verse number="9" style="v" sid="JOB 2:9"/>तब उसकी बीवी उससे कहने लगी, कि “क्या तू अब भी अपनी रास्ती पर क़ाईम रहेगा? ख़ुदा की बुराई कर और मर जा।” <verse eid="JOB 2:9"/><verse number="10" style="v" sid="JOB 2:10"/>लेकिन उसने उससे कहा, कि “तू नादान 'औरतों की जैसी बातें करती है; क्या हम ख़ुदा के हाथ से सुख पाएँ और दुख न पाएँ?” इन सब बातों में अय्यूब ने अपने लबों से ख़ता न की। <verse eid="JOB 2:10"/><verse number="11" style="v" sid="JOB 2:11"/>जब अय्यूब के तीन दोस्तों, तेमानी इलिफ़ज़ और सूखी बिलदद और नामाती जूफ़र, ने उस सारी आफ़त का हाल जो उस पर आई थीं सुना, तो वह अपनी — अपनी जगह से चले और उन्होंने आपस में 'अहद किया कि जाकर उसके साथ रोएँ और उसे तसल्ली दें। <verse eid="JOB 2:11"/><verse number="12" style="v" sid="JOB 2:12"/>और जब उन्होंने दूर से निगाह की और उसे न पहचाना, तो वह चिल्ला — चिल्ला कर रोने लगे और हर एक ने अपना लिबास चाक किया और अपने सिर के ऊपर आसमान की तरफ़ धूल उड़ाई। <verse eid="JOB 2:12"/><verse number="13" style="v" sid="JOB 2:13"/>और वह सात दिन और सात रात उसके साथ ज़मीन पर बेठे रहे और किसी ने उससे एक बात न कही क्यूँकि उन्होंने देखा कि उसका ग़म बहुत बड़ा।<verse eid="JOB 2:13"/></para>
  <chapter eid="JOB 2"/>
  <chapter number="3" style="c" sid="JOB 3"/>
  <para style="s">अय्यूब का पहला बयान</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 3:1"/>इसके बाद अय्यूब ने अपना मुँह खोल कर अपने पैदाइश के दिन पर ला'नत की।<verse eid="JOB 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 3:2"/>और अय्यूब कहने लगा:<verse eid="JOB 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 3:3"/>“मिट जाए वह दिन जिसमें मैं पैदा हुआ,</para>
  <para style="q" vid="JOB 3:3">और वह रात भी जिसमें कहा गया, 'कि देखो, बेटा हुआ।”<verse eid="JOB 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 3:4"/>वह दिन अँधेरा हो जाए।</para>
  <para style="q" vid="JOB 3:4">ख़ुदा ऊपर से उसका लिहाज़ न करे,</para>
  <para style="q" vid="JOB 3:4">और न उस पर रोशनी पड़े।<verse eid="JOB 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 3:5"/>अँधेरा और मौत का साया उस पर क़ाबिज़ हो।</para>
  <para style="q" vid="JOB 3:5">बदली उस पर छाई रहे</para>
  <para style="q" vid="JOB 3:5">और दिन को तारीक कर देनेवाली चीज़ें उसे दहशत ज़दा करें।<verse eid="JOB 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 3:6"/>गहरी तारीकी उस रात को दबोच ले।</para>
  <para style="q" vid="JOB 3:6">वह साल के दिनों के बीच ख़ुशी न करने पाए,</para>
  <para style="q" vid="JOB 3:6">और न महीनों की ता'दाद में आए।<verse eid="JOB 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 3:7"/>वह रात बाँझ हो जाए;</para>
  <para style="q" vid="JOB 3:7">उसमें ख़ुशी की कोई आवाज़ न आए।<verse eid="JOB 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 3:8"/>दिन पर ला'नत करने वाले उस पर ला'नत करें</para>
  <para style="q" vid="JOB 3:8">और वह भी जो अज़दह “को छेड़ने को तैयार हैं।<verse eid="JOB 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 3:9"/>उसकी शाम के तारे तारीक हो जाएँ,</para>
  <para style="q" vid="JOB 3:9">वह रोशनी की राह देखे, जबकि वह है नहीं,</para>
  <para style="q" vid="JOB 3:9">और न वह सुबह की पलकों को देखे।<verse eid="JOB 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 3:10"/>क्यूँकि उसने मेरी माँ के रहम के दरवाज़ों को बंद न किया</para>
  <para style="q" vid="JOB 3:10">और दुख को मेरी आँखों से छिपा न रख्खा।<verse eid="JOB 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 3:11"/>मैं रहम ही में क्यूँ न मर गया?</para>
  <para style="q" vid="JOB 3:11">मैंने पेट से निकलते ही जान क्यूँ न दे दी?<verse eid="JOB 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 3:12"/>मुझे क़ुबूल करने को घुटने क्यूँ थे,</para>
  <para style="q" vid="JOB 3:12">और छातियाँ कि मैं उनसे पियूँ?<verse eid="JOB 3:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 3:13"/>नहीं तो इस वक़्त मैं पड़ा होता, और बेख़बर रहता,</para>
  <para style="q" vid="JOB 3:13">मैं सो जाता। तब मुझे आराम मिलता।<verse eid="JOB 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 3:14"/>ज़मीन के बादशाहों और सलाहकारों के साथ,</para>
  <para style="q" vid="JOB 3:14">जिन्होंने अपने लिए मक़बरे बनाए।<verse eid="JOB 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JOB 3:15"/>या उन शाहज़ादों के साथ होता, जिनके पास सोना था।</para>
  <para style="q" vid="JOB 3:15">जिन्होंने अपने घर चाँदी से भर लिए थे;<verse eid="JOB 3:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 3:16"/>या पोशीदा गिरते हमल की तरह,</para>
  <para style="q" vid="JOB 3:16">मैं वजूद में न आता या उन बच्चों की तरह जिन्होंने रोशनी ही न देखी।<verse eid="JOB 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 3:17"/>वहाँ शरीर फ़साद से बाज़ आते हैं,</para>
  <para style="q" vid="JOB 3:17">और थके मांदे राहत पाते हैं।<verse eid="JOB 3:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 3:18"/>वहाँ क़ैदी मिलकर आराम करते हैं,</para>
  <para style="q" vid="JOB 3:18">और दरोग़ा की आवाज़ सुनने में नहीं आती।<verse eid="JOB 3:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 3:19"/>छोटे और बड़े दोनों वहीं हैं,</para>
  <para style="q" vid="JOB 3:19">और नौकर अपने मालिक से आज़ाद है।”<verse eid="JOB 3:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 3:20"/>“दुखियारे को रोशनी,</para>
  <para style="q" vid="JOB 3:20">और तल्ख़जान को ज़िन्दगी क्यूँ मिलती है?<verse eid="JOB 3:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 3:21"/>जो मौत की राह देखते हैं लेकिन वह आती नहीं,</para>
  <para style="q" vid="JOB 3:21">और छिपे ख़ज़ाने से ज़्यादा उसकी तलाश करते हैं।<verse eid="JOB 3:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 3:22"/>जो निहायत शादमान और ख़ुश होते हैं, जब क़ब्र को पा लेते हैं।<verse eid="JOB 3:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 3:23"/>ऐसे आदमी को रोशनी क्यूँ मिलती है,</para>
  <para style="q" vid="JOB 3:23">जिसकी राह छिपी है,</para>
  <para style="q" vid="JOB 3:23">और जिसे ख़ुदा ने हर तरफ़ से बंद कर दिया है?<verse eid="JOB 3:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 3:24"/>क्यूँकि मेरे खाने की जगह मेरी आहें हैं,</para>
  <para style="q" vid="JOB 3:24">और मेरा कराहना पानी की तरह जारी है।<verse eid="JOB 3:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 3:25"/>क्यूँकि जिस बात से मैं डरता हूँ, वही मुझ पर आती है,</para>
  <para style="q" vid="JOB 3:25">और जिस बात का मुझे ख़ौफ़ होता है, वही मुझ पर गुज़रती है।<verse eid="JOB 3:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 3:26"/>क्यूँकि मुझे न चैन है, न आराम है, न मुझे कल पड़ती है;</para>
  <para style="q" vid="JOB 3:26">बल्कि मुसीबत ही आती है।”<verse eid="JOB 3:26"/></para>
  <chapter eid="JOB 3"/>
  <chapter number="4" style="c" sid="JOB 4"/>
  <para style="s">इलिफ़ज़ का अय्यूब को पहला जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 4:1"/>तब तेमानी इलिफ़ज़ कहने लगा,<verse eid="JOB 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 4:2"/>अगर कोई तुझ से बात चीत करने की कोशिश करे तो क्या तू अफ़सोस करेगा?,</para>
  <para style="q" vid="JOB 4:2">लेकिन बोले बगै़र कौन रह सकता है?<verse eid="JOB 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 4:3"/>देख, तू ने बहुतों को सिखाया,</para>
  <para style="q" vid="JOB 4:3">और कमज़ोर हाथों को मज़बूत किया।<verse eid="JOB 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 4:4"/>तेरी बातों ने गिरते हुए को संभाला,</para>
  <para style="q" vid="JOB 4:4">और तू ने लड़खड़ाते घुटनों को मज़बूत किया।<verse eid="JOB 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 4:5"/>लेकिन अब तो तुझी पर आ पड़ी और तू कमज़ोर हुआ जाता है।</para>
  <para style="q" vid="JOB 4:5">उसने तुझे छुआ और तू घबरा उठा।<verse eid="JOB 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 4:6"/>क्या तेरे ख़ुदा का डर ही तेरा भरोसा नहीं?</para>
  <para style="q" vid="JOB 4:6">क्या तेरी राहों की रास्ती तेरी उम्मीद नहीं?<verse eid="JOB 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 4:7"/>क्या तुझे याद है कि कभी कोई मा'सूम भी हलाक हुआ है?</para>
  <para style="q" vid="JOB 4:7">या कहीं रास्तबाज़ भी काट डाले गए?<verse eid="JOB 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 4:8"/>मेरे देखने में तो जो गुनाह को जोतते</para>
  <para style="q" vid="JOB 4:8">और दुख बोते हैं, वही उसको काटते हैं।<verse eid="JOB 4:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 4:9"/>वह ख़ुदा के दम से हलाक होते,</para>
  <para style="q" vid="JOB 4:9">और उसके ग़ुस्से के झोंके से भस्म होते हैं।<verse eid="JOB 4:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 4:10"/>बबर की ग़रज़ और खू़ँख़्वार बबर की दहाड़,</para>
  <para style="q" vid="JOB 4:10">और बबर के बच्चों के दाँत, यह सब तोड़े जाते हैं।<verse eid="JOB 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 4:11"/>शिकार न पाने से बूढ़ा बबर हलाक होता,</para>
  <para style="q" vid="JOB 4:11">और शेरनी के बच्चे तितर — बितर हो जाते हैं।<verse eid="JOB 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 4:12"/>एक बात चुपके से मेरे पास पहुँचाई गई,</para>
  <para style="q" vid="JOB 4:12">उसकी भनक मेरे कान में पड़ी।<verse eid="JOB 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 4:13"/>रात के ख़्वाबों के ख़्यालों के बीच,</para>
  <para style="q" vid="JOB 4:13">जब लोगों को गहरी नींद आती है।<verse eid="JOB 4:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 4:14"/>मुझे ख़ौफ़ और कपकपी ने ऐसा पकड़ा,</para>
  <para style="q" vid="JOB 4:14">कि मेरी सब हड्डियों को हिला डाला।<verse eid="JOB 4:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 4:15"/>तब एक रूह मेरे सामने से गुज़री,</para>
  <para style="q" vid="JOB 4:15">और मेरे रोंगटे खड़े हो गए।<verse eid="JOB 4:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 4:16"/>वह चुपचाप खड़ी हो गई लेकिन मैं उसकी शक्ल पहचान न सका;</para>
  <para style="q" vid="JOB 4:16">एक सूरत मेरी आँखों के सामने थी और सन्नाटा था।</para>
  <para style="q" vid="JOB 4:16">फिर मैंने एक आवाज़ सुनी:<verse eid="JOB 4:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 4:17"/>कि क्या फ़ानी इंसान ख़ुदा से ज़्यादा होगा?</para>
  <para style="q" vid="JOB 4:17">क्या आदमी अपने ख़ालिक़ से ज़्यादा पाक ठहरेगा?<verse eid="JOB 4:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 4:18"/>देख, उसे अपने ख़ादिमों का 'ऐतबार नहीं,</para>
  <para style="q" vid="JOB 4:18">और वह अपने फ़रिश्तों पर हिमाक़त को 'आइद करता है।<verse eid="JOB 4:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 4:19"/>फिर भला उनकी क्या हक़ीक़त है, जो मिट्टी के मकानों में रहते हैं।</para>
  <para style="q" vid="JOB 4:19">जिनकी बुन्नियाद ख़ाक में है,</para>
  <para style="q" vid="JOB 4:19">और जो पतंगे से भी जल्दी पिस जाते हैं।<verse eid="JOB 4:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 4:20"/>वह सुबह से शाम तक हलाक होते हैं,</para>
  <para style="q" vid="JOB 4:20">वह हमेशा के लिए फ़ना हो जाते हैं,</para>
  <para style="q" vid="JOB 4:20">और कोई उनका ख़याल भी नहीं करता।<verse eid="JOB 4:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 4:21"/>क्या उनके ख़ेमे की डोरी उनके अन्दर ही अन्दर तोड़ी नहीं जाती?</para>
  <para style="q" vid="JOB 4:21">वह मरते हैं और यह भी बगै़र दानाई के।<verse eid="JOB 4:21"/></para>
  <chapter eid="JOB 4"/>
  <chapter number="5" style="c" sid="JOB 5"/>
  <para style="s">इलिफ़ज़ के जवाब का जारी रहना</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 5:1"/>ज़रा पुकार क्या कोई है जो तुझे जवाब देगा?</para>
  <para style="q" vid="JOB 5:1">और मुक़द्दसों में से तू किसकी तरफ़ फिरेगा?<verse eid="JOB 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 5:2"/>क्यूँकि कुढ़ना बेवक़ूफ़ को मार डालता है,</para>
  <para style="q" vid="JOB 5:2">और जलन बेवक़ूफ़ की जान ले लेती है।<verse eid="JOB 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 5:3"/>मैंने बेवक़ूफ़ को जड़ पकड़ते देखा है,</para>
  <para style="q" vid="JOB 5:3">लेकिन बराबर उसके घर पर ला'नत की।<verse eid="JOB 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 5:4"/>उसके बाल — बच्चे सलामती से दूर हैं;</para>
  <para style="q" vid="JOB 5:4">वह फाटक ही पर कुचले जाते हैं,</para>
  <para style="q" vid="JOB 5:4">और कोई नहीं जो उन्हें छुड़ाए।<verse eid="JOB 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 5:5"/>भूका उसकी फ़सल को खाता है,</para>
  <para style="q" vid="JOB 5:5">बल्कि उसे काँटों में से भी निकाल लेता है।</para>
  <para style="q" vid="JOB 5:5">और प्यासा उसके माल को निगल जाता है।<verse eid="JOB 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 5:6"/>क्यूँकि मुसीबत मिट्टी में से नहीं उगती।</para>
  <para style="q" vid="JOB 5:6">न दुख ज़मीन में से निकलता है।<verse eid="JOB 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 5:7"/>बस जैसे चिंगारियाँ ऊपर ही को उड़ती हैं,</para>
  <para style="q" vid="JOB 5:7">वैसे ही इंसान दुख के लिए पैदा हुआ है।<verse eid="JOB 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 5:8"/>लेकिन मैं तो ख़ुदा ही का तालिब रहूँगा,</para>
  <para style="q" vid="JOB 5:8">और अपना मु'आमिला ख़ुदा ही पर छोड़ूँगा।<verse eid="JOB 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 5:9"/>जो ऐसे बड़े बड़े काम जो बयान नहीं हो सकते,</para>
  <para style="q" vid="JOB 5:9">और बेशुमार 'अजीब काम करता है।<verse eid="JOB 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 5:10"/>वही ज़मीन पर पानी बरसाता,</para>
  <para style="q" vid="JOB 5:10">और खेतों में पानी भेजता है।<verse eid="JOB 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 5:11"/>इसी तरह वह हलीमों को ऊँची जगह पर बिठाता है,</para>
  <para style="q" vid="JOB 5:11">और मातम करनेवाले सलामती की सरफ़राज़ी पाते हैं।<verse eid="JOB 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 5:12"/>वह 'अय्यारों की तदबीरों को बातिल कर देता है।</para>
  <para style="q" vid="JOB 5:12">यहाँ तक कि उनके हाथ उनके मक़सद को पूरा नहीं कर सकते।<verse eid="JOB 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 5:13"/>वह होशियारों की उन ही की चालाकियों में फसाता है,</para>
  <para style="q" vid="JOB 5:13">और टेढ़े लोगों की मशवरत जल्द जाती रहती है।<verse eid="JOB 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 5:14"/>उन्हें दिन दहाड़े अँधेरे से पाला पड़ता है,</para>
  <para style="q" vid="JOB 5:14">और वह दोपहर के वक़्त ऐसे टटोलते फिरते हैं जैसे रात को।<verse eid="JOB 5:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 5:15"/>लेकिन मुफ़लिस को उनके मुँह की तलवार,</para>
  <para style="q" vid="JOB 5:15">और ज़बरदस्त के हाथ से वह बचालेता है।<verse eid="JOB 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 5:16"/>जो ग़रीब को उम्मीद रहती है,</para>
  <para style="q" vid="JOB 5:16">और बदकारी अपना मुँह बंद कर लेती है।<verse eid="JOB 5:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 5:17"/>देख, वह आदमी जिसे ख़ुदा तम्बीह देता है ख़ुश क़िस्मत है।</para>
  <para style="q" vid="JOB 5:17">इसलिए क़ादिर — ए — मुतलक़ की तादीब को बेकार न जान।<verse eid="JOB 5:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 5:18"/>क्यूँकि वही मजरूह करता और पट्टी बाँधता है।</para>
  <para style="q" vid="JOB 5:18">वही ज़ख़्मी करता है और उसी के हाथ शिफ़ा देते हैं।<verse eid="JOB 5:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 5:19"/>वह तुझे छ: मुसीबतों से छुड़ाएगा,</para>
  <para style="q" vid="JOB 5:19">बल्कि सात में भी कोई आफ़त तुझे छूने न पाएगी।<verse eid="JOB 5:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 5:20"/>काल में वह तुझ को मौत से बचाएगा,</para>
  <para style="q" vid="JOB 5:20">और लड़ाई में तलवार की धार से।<verse eid="JOB 5:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 5:21"/>तू ज़बान के कोड़े से महफ़ूज़ “रखा जाएगा,</para>
  <para style="q" vid="JOB 5:21">और जब हलाकत आएगी तो तुझे डर नहीं लगेगा।<verse eid="JOB 5:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 5:22"/>तू हलाकत और ख़ुश्क साली पर हँसेगा,</para>
  <para style="q" vid="JOB 5:22">और ज़मीन के दरिन्दों से तुझे कुछ ख़ौफ़ न होगा।<verse eid="JOB 5:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 5:23"/>मैदान के पत्थरों के साथ तेरा एका होगा,</para>
  <para style="q" vid="JOB 5:23">और जंगली जानवर तुझ से मेल रखेंगे।<verse eid="JOB 5:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 5:24"/>और तू जानेगा कि तेरा ख़ेमा महफ़ूज़ है,</para>
  <para style="q" vid="JOB 5:24">और तू अपने घर में जाएगा और कोई चीज़ ग़ाएब न पाएगा।<verse eid="JOB 5:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 5:25"/>तुझे यह भी मा'लूम होगा कि तेरी नसल बड़ी,</para>
  <para style="q" vid="JOB 5:25">और तेरी औलाद ज़मीन की घास की तरह बढ़ेगी।<verse eid="JOB 5:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 5:26"/>तू पूरी उम्र में अपनी क़ब्र में जाएगा,</para>
  <para style="q" vid="JOB 5:26">जैसे अनाज के पूले अपने वक़्त पर जमा' किए जाते हैं।<verse eid="JOB 5:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 5:27"/>देख, हम ने इसकी तहक़ीक़ की और यह बात यूँ ही है।</para>
  <para style="q" vid="JOB 5:27">इसे सुन ले और अपने फ़ायदे के लिए इसे याद रख।”<verse eid="JOB 5:27"/></para>
  <chapter eid="JOB 5"/>
  <chapter number="6" style="c" sid="JOB 6"/>
  <para style="s">अय्यूब का दुसरा बयान: इलिफ़ज़ को जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 6:1"/>तब अय्यूब ने जवाब दिया<verse eid="JOB 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 6:2"/>काश कि मेरा कुढ़ना तोला जाता,</para>
  <para style="q" vid="JOB 6:2">और मेरी सारी मुसीबत तराजू़ में रख्खी जाती!<verse eid="JOB 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 6:3"/>तो वह समन्दर की रेत से भी भारी होती;</para>
  <para style="q" vid="JOB 6:3">इसी लिए मेरी बातें घबराहट की हैं।<verse eid="JOB 6:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 6:4"/>क्यूँकि क़ादिर — ए — मुतलक़ के तीर मेरे अन्दर लगे हुए हैं;</para>
  <para style="q" vid="JOB 6:4">मेरी रूह उन ही के ज़हर को पी रही हैं'</para>
  <para style="q" vid="JOB 6:4">ख़ुदा की डरावनी बातें मेरे ख़िलाफ़ सफ़ बाँधे हुए हैं।<verse eid="JOB 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 6:5"/>क्या जंगली गधा उस वक़्त भी चिल्लाता है जब उसे घास मिल जाती है?</para>
  <para style="q" vid="JOB 6:5">या क्या बैल चारा पाकर डकारता है?<verse eid="JOB 6:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 6:6"/>क्या फीकी चीज़ बे नमक खायी जा सकता है?</para>
  <para style="q" vid="JOB 6:6">या क्या अंडे की सफ़ेदी में कोई मज़ा है?<verse eid="JOB 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 6:7"/>मेरी रूह को उनके छूने से भी इंकार है,</para>
  <para style="q" vid="JOB 6:7">वह मेरे लिए मकरूह गिज़ा हैं।<verse eid="JOB 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 6:8"/>काश कि मेरी दरख़्वास्त मंज़ूर होती,</para>
  <para style="q" vid="JOB 6:8">और ख़ुदा मुझे वह चीज़ बख़्शता जिसकी मुझे आरजू़ है।<verse eid="JOB 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 6:9"/>या'नी ख़ुदा को यही मंज़ूर होता कि मुझे कुचल डाले,</para>
  <para style="q" vid="JOB 6:9">और अपना हाथ चलाकर मुझे काट डाले।<verse eid="JOB 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 6:10"/>तो मुझे तसल्ली होती,</para>
  <para style="q" vid="JOB 6:10">बल्कि मैं उस अटल दर्द में भी शादमान रहता;</para>
  <para style="q" vid="JOB 6:10">क्यूँकि मैंने उस पाक बातों का इन्कार नहीं किया।<verse eid="JOB 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 6:11"/>मेरी ताक़त ही क्या है जो मैं ठहरा रहूँ?</para>
  <para style="q" vid="JOB 6:11">और मेरा अन्जाम ही क्या है जो मैं सब्र करूँ?<verse eid="JOB 6:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 6:12"/>क्या मेरी ताक़त पत्थरों की ताक़त है?</para>
  <para style="q" vid="JOB 6:12">या मेरा जिस्म पीतल का है?<verse eid="JOB 6:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 6:13"/>क्या बात यही नहीं कि मैं लाचार हूँ,</para>
  <para style="q" vid="JOB 6:13">और काम करने की ताक़त मुझ से जाती रही है?<verse eid="JOB 6:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 6:14"/>उस पर जो कमज़ोर होने को है उसके दोस्त की तरफ़ से मेहरबानी होनी चाहिए,</para>
  <para style="q" vid="JOB 6:14">बल्कि उस पर भी जो क़ादिर — ए — मुतलक़ का ख़ौफ़ छोड़ देता है।<verse eid="JOB 6:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 6:15"/>मेरे भाइयों ने नाले की तरह दग़ा की,</para>
  <para style="q" vid="JOB 6:15">उन वादियों के नालों की तरह जो सूख जाते हैं।<verse eid="JOB 6:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 6:16"/>जो जड़ की वजह से काले हैं,</para>
  <para style="q" vid="JOB 6:16">और जिनमें बर्फ़ छिपी है।<verse eid="JOB 6:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 6:17"/>जिस वक़्त वह गर्म होते हैं तो ग़ायब हो जाते हैं,</para>
  <para style="q" vid="JOB 6:17">और जब गर्मी पड़ती है तो अपनी</para>
  <para style="q" vid="JOB 6:17">जगह से उड़ जाते हैं।<verse eid="JOB 6:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 6:18"/>क़ाफ़िले अपने रास्ते से मुड़ जाते हैं,</para>
  <para style="q" vid="JOB 6:18">और वीराने में जाकर हलाक हो जाते हैं।<verse eid="JOB 6:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 6:19"/>तेमा के क़ाफ़िले देखते रहे,</para>
  <para style="q" vid="JOB 6:19">सबा के कारवाँ उनके इन्तिज़ार में रहे।<verse eid="JOB 6:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 6:20"/>वह शर्मिन्दा हुए क्यूँकि उन्होंने उम्मीद की थी,</para>
  <para style="q" vid="JOB 6:20">वह वहाँ आए और पशेमान हुए।<verse eid="JOB 6:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 6:21"/>इसलिए तुम्हारी भी कोई हक़ीक़त नहीं;</para>
  <para style="q" vid="JOB 6:21">तुम डरावनी चीज़ देख कर डर जाते हो।<verse eid="JOB 6:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 6:22"/>क्या मैंने कहा, 'कुछ मुझे दो?</para>
  <para style="q" vid="JOB 6:22">'या 'अपने माल में से मेरे लिए रिश्वत दो?'<verse eid="JOB 6:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 6:23"/>या 'मुख़ालिफ़ के हाथ से मुझे बचाओ?</para>
  <para style="q" vid="JOB 6:23">' या' ज़ालिमों के हाथ से मुझे छुड़ाओ?'<verse eid="JOB 6:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 6:24"/>मुझे समझाओ और मैं ख़ामोश रहूँगा,</para>
  <para style="q" vid="JOB 6:24">और मुझे समझाओ कि मैं किस बात में चूका।<verse eid="JOB 6:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 6:25"/>रास्ती की बातों में कितना असर होता है,</para>
  <para style="q" vid="JOB 6:25">बल्कि तुम्हारी बहस से क्या फ़ायदा होता है।<verse eid="JOB 6:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 6:26"/>क्या तुम इस ख़्याल में हो कि लफ़्ज़ों की तक़रार' करो?</para>
  <para style="q" vid="JOB 6:26">इसलिए कि मायूस की बातें हवा की तरह होती हैं।<verse eid="JOB 6:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 6:27"/>हाँ, तुम तो यतीमों पर कुर'आ डालने वाले,</para>
  <para style="q" vid="JOB 6:27">और अपने दोस्त को तिजारत का माल बनाने वाले हो।<verse eid="JOB 6:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 6:28"/>इसलिए ज़रा मेरी तरफ़ निगाह करो,</para>
  <para style="q" vid="JOB 6:28">क्यूँकि तुम्हारे मुँह पर मैं हरगिज़ झूट न बोलूँगा।<verse eid="JOB 6:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 6:29"/>मैं तुम्हारी मिन्नत करता हूँ बाज़ आओ बे इन्साफ़ी न करो।</para>
  <para style="q" vid="JOB 6:29">मैं हक़ पर हूँ।<verse eid="JOB 6:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 6:30"/>क्या मेरी ज़बान पर बे इन्साफ़ी है?</para>
  <para style="q" vid="JOB 6:30">क्या फ़ितना अंगेज़ी की बातों के पहचानने का मुझे सलीक़ा नहीं?<verse eid="JOB 6:30"/></para>
  <chapter eid="JOB 6"/>
  <chapter number="7" style="c" sid="JOB 7"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 7:1"/>“क्या इंसान के लिए ज़मीन पर जंग — ओ — जदल नहीं?</para>
  <para style="q" vid="JOB 7:1">और क्या उसके दिन मज़दूर के जैसे नहीं होते?<verse eid="JOB 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 7:2"/>जैसे नौकर साये की बड़ी आरज़ू करता है,</para>
  <para style="q" vid="JOB 7:2">और मज़दूर अपनी उजरत का मुंतज़िर रहता है;<verse eid="JOB 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 7:3"/>वैसे ही मैं बुतलान के महीनों का मालिक बनाया गया हूँ,</para>
  <para style="q" vid="JOB 7:3">और मुसीबत की रातें मेरे लिए ठहराई गई हैं।<verse eid="JOB 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 7:4"/>जब मैं लेटता हूँ तो कहता हूँ,</para>
  <para style="q" vid="JOB 7:4">'कब उठूँगा?' लेकिन रात लम्बी होती है;</para>
  <para style="q" vid="JOB 7:4">और दिन निकलने तक इधर — उधर करवटें बदलता रहता हूँ।<verse eid="JOB 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 7:5"/>मेरा जिस्म कीड़ों और मिट्टी के ढेलों से ढका है।</para>
  <para style="q" vid="JOB 7:5">मेरी खाल सिमटती और फिर नासूर हो जाती है।<verse eid="JOB 7:5"/></para>
  <para style="s">अय्यूब का ख़ुदा की दुहाई देना</para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 7:6"/>मेरे दिन जुलाहे की ढरकी से भी तेज़</para>
  <para style="q" vid="JOB 7:6">और बगै़र उम्मीद के गुज़र जाते हैं।<verse eid="JOB 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 7:7"/>'आह, याद कर कि मेरी ज़िन्दगी हवा है,</para>
  <para style="q" vid="JOB 7:7">और मेरी आँख ख़ुशी को फिर न देखेगी।<verse eid="JOB 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 7:8"/>जो मुझे अब देखता है उसकी आँख मुझे फिर न देखेगी।</para>
  <para style="q" vid="JOB 7:8">तेरी आँखें तो मुझ पर होंगी लेकिन मैं न हूँगा।<verse eid="JOB 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 7:9"/>जैसे बादल फटकर ग़ायब हो जाता है,</para>
  <para style="q" vid="JOB 7:9">वैसे ही वह जो क़ब्र में उतरता है फिर कभी ऊपर नहीं आता;<verse eid="JOB 7:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 7:10"/>वह अपने घर को फिर न लौटेगा, न उसकी जगह उसे फिर पहचानेगी।<verse eid="JOB 7:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 7:11"/>इसलिए मैं अपना मुँह बंद नहीं रख्खूँगा;</para>
  <para style="q" vid="JOB 7:11">मैं अपनी रूह की तल्ख़ी में बोलता जाऊँगा।</para>
  <para style="q" vid="JOB 7:11">मैं अपनी जान के 'ऐज़ाब में शिकवा करूँगा।<verse eid="JOB 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 7:12"/>क्या मैं समन्दर हूँ या मगरमच्छ',</para>
  <para style="q" vid="JOB 7:12">जो तू मुझ पर पहरा बिठाता है?<verse eid="JOB 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 7:13"/>जब मैं कहता हूँ। मेरा बिस्तर मुझे आराम पहुँचाएगा,</para>
  <para style="q" vid="JOB 7:13">मेरा बिछौना मेरे दुख को हल्का करेगा।<verse eid="JOB 7:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 7:14"/>तो तू ख़्वाबों से मुझे डराता,</para>
  <para style="q" vid="JOB 7:14">और दीदार से मुझे तसल्ली देता है;<verse eid="JOB 7:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 7:15"/>यहाँ तक कि मेरी जान फाँसी,</para>
  <para style="q" vid="JOB 7:15">और मौत को मेरी इन हड्डियों पर तरजीह देती है।<verse eid="JOB 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 7:16"/>मुझे अपनी जान से नफ़रत है;</para>
  <para style="q" vid="JOB 7:16">मैं हमेशा तक ज़िन्दा रहना नहीं चाहता।</para>
  <para style="q" vid="JOB 7:16">मुझे छोड़ दे क्यूँकि मेरे दिन ख़राब हैं।<verse eid="JOB 7:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 7:17"/>इंसान की औकात ही क्या है जो तू उसे सरफ़राज़ करे,</para>
  <para style="q" vid="JOB 7:17">और अपना दिल उस पर लगाए;<verse eid="JOB 7:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 7:18"/>और हर सुबह उसकी ख़बर ले,</para>
  <para style="q" vid="JOB 7:18">और हर लम्हा उसे आज़माए?<verse eid="JOB 7:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 7:19"/>तू कब तक अपनी निगाह मेरी तरफ़ से नहीं हटाएगा,</para>
  <para style="q" vid="JOB 7:19">और मुझे इतनी भी मोहलत नहीं देगा कि अपना थूक निगल लें?<verse eid="JOB 7:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 7:20"/>ऐ बनी आदम के नाज़िर, अगर मैंने गुनाह किया है तो तेरा क्या बिगाड़ता हूँ?</para>
  <para style="q" vid="JOB 7:20">तूने क्यूँ मुझे अपना निशाना बना लिया है,</para>
  <para style="q" vid="JOB 7:20">यहाँ तक कि मैं अपने आप पर बोझ हूँ?<verse eid="JOB 7:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 7:21"/>तू मेरा गुनाह क्यूँ नहीं मु'आफ़ करता,</para>
  <para style="q" vid="JOB 7:21">और मेरी बदकारी क्यूँ नहीं दूर कर देता?</para>
  <para style="q" vid="JOB 7:21">अब तो मैं मिट्टी में सो जाऊँगा,</para>
  <para style="q" vid="JOB 7:21">और तू मुझे ख़ूब ढूँडेगा लेकिन मैं न हूँगा।”<verse eid="JOB 7:21"/></para>
  <chapter eid="JOB 7"/>
  <chapter number="8" style="c" sid="JOB 8"/>
  <para style="s">बिलदद का अय्यूब को पहला जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 8:1"/>तब बिलदद सूखी कहने लगा,<verse eid="JOB 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 8:2"/>तू कब तक ऐसे ही बकता रहेगा,</para>
  <para style="q" vid="JOB 8:2">और तेरे मुँह की बातें कब तक आँधी की तरह होंगी?<verse eid="JOB 8:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 8:3"/>क्या ख़ुदा बेइन्साफ़ी करता है?</para>
  <para style="q" vid="JOB 8:3">क्या क़ादिर — ए — मुतलक़ इन्साफ़ का खू़न करता है?<verse eid="JOB 8:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 8:4"/>अगर तेरे फ़र्ज़न्दों ने उसका गुनाह किया है,</para>
  <para style="q" vid="JOB 8:4">और उसने उन्हें उन ही की ख़ता के हवाले कर दिया।<verse eid="JOB 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 8:5"/>तोभी अगर तू ख़ुदा को खू़ब ढूँडता,</para>
  <para style="q" vid="JOB 8:5">और क़ादिर — ए — मुतलक़ के सामने मिन्नत करता,<verse eid="JOB 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 8:6"/>तो अगर तू पाक दिल और रास्तबाज़ होता,</para>
  <para style="q" vid="JOB 8:6">तो वह ज़रूर अब तेरे लिए बेदार हो जाता,</para>
  <para style="q" vid="JOB 8:6">और तेरी रास्तबाज़ी के घर को बढ़ाता।<verse eid="JOB 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 8:7"/>और अगरचे तेरा आग़ाज़ छोटा सा था,</para>
  <para style="q" vid="JOB 8:7">तोभी तेरा अंजाम बहुत बड़ा होता<verse eid="JOB 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 8:8"/>ज़रा पिछले ज़माने के लोंगों से पू छ</para>
  <para style="q" vid="JOB 8:8">और जो कुछ उनके बाप दादा ने तहक़ीक़ की है उस पर ध्यान कर।<verse eid="JOB 8:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 8:9"/>क्यूँकि हम तो कल ही के हैं,</para>
  <para style="q" vid="JOB 8:9">और कुछ नहीं जानते और हमारे दिन ज़मीन पर साये की तरह हैं।<verse eid="JOB 8:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 8:10"/>क्या वह तुझे न सिखाएँगे और न बताएँगे</para>
  <para style="q" vid="JOB 8:10">और अपने दिल की बातें नहीं करेंगे?<verse eid="JOB 8:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 8:11"/>क्या नागरमोंथा बग़ैर कीचड़ के उग सकता है</para>
  <para style="q" vid="JOB 8:11">क्या सरकंडों को बिना पानी के बढ़ा किया जा सकता है?<verse eid="JOB 8:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 8:12"/>जब वह हरा ही है और काटा भी नहीं गया तोभी</para>
  <para style="q" vid="JOB 8:12">और पौदों से पहले सूख जाता है।<verse eid="JOB 8:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 8:13"/>ऐसी ही उन सब की राहें हैं,</para>
  <para style="q" vid="JOB 8:13">जो ख़ुदा को भूल जाते हैं बे ख़ुदा आदमी की उम्मीद टूट जाएगी<verse eid="JOB 8:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 8:14"/>उसका ऐतमा'द जाता रहेगा</para>
  <para style="q" vid="JOB 8:14">और उसका भरोसा मकड़ी का जाला है।<verse eid="JOB 8:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 8:15"/>वह अपने घर पर टेक लगाएगा लेकिन वह खड़ा न रहेगा,</para>
  <para style="q" vid="JOB 8:15">वह उसे मज़बूती से थामेगा लेकिन वह क़ाईम न रहेगा।<verse eid="JOB 8:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 8:16"/>वह धूप पाकर हरा भरा हो जाता है</para>
  <para style="q" vid="JOB 8:16">और उसकी डालियाँ उसी के बाग़ में फैलतीं हैं<verse eid="JOB 8:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 8:17"/>उसकी जड़ें ढेर में लिपटी हुई रहती हैं,</para>
  <para style="q" vid="JOB 8:17">वह पत्थर की जगह को देख लेता है।<verse eid="JOB 8:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 8:18"/>अगर वह अपनी जगह से हलाक किया जाए तो वह उसका इन्कार करके कहने लगेंगी,</para>
  <para style="q" vid="JOB 8:18">कि मैंने तुझे देखा ही नहीं।<verse eid="JOB 8:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 8:19"/>देख उसके रस्ते की ख़ुशी इतनी ही है,</para>
  <para style="q" vid="JOB 8:19">और मिटटी में से दूसरे उग आएगें।<verse eid="JOB 8:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 8:20"/>देख ख़ुदा कामिल आदमी को छोड़ न देगा,</para>
  <para style="q" vid="JOB 8:20">न वह बदकिरदारों को सम्भालेगा।<verse eid="JOB 8:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 8:21"/>वह अब भी तेरे मुँह को हँसी से भर देगा</para>
  <para style="q" vid="JOB 8:21">और तेरे लबों की ललकार की आवाज़ से।<verse eid="JOB 8:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 8:22"/>तेरे नफ़रत करने वाले शर्म का जामा' पहनेंगे</para>
  <para style="q" vid="JOB 8:22">और शरीरों का ख़ेमा क़ाईम न रहेगा<verse eid="JOB 8:22"/></para>
  <chapter eid="JOB 8"/>
  <chapter number="9" style="c" sid="JOB 9"/>
  <para style="s">अय्यूब का तिसरा बयान: बिलदद को जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 9:1"/>फ़िर अय्यूब ने जवाब दिया<verse eid="JOB 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 9:2"/>दर हक़ीक़त में मैं जानता हूँ कि बात यूँ ही है,</para>
  <para style="q" vid="JOB 9:2">लेकिन इंसान ख़ुदा के सामने कैसे रास्तबाज़ ठहरे।<verse eid="JOB 9:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 9:3"/>अगर वह उससे बहस करने को राज़ी भी हो,</para>
  <para style="q" vid="JOB 9:3">यह तो हज़ार बातों में से उसे एक का भी जवाब न दे सकेगा।<verse eid="JOB 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 9:4"/>वह दिल का 'अक़्लमन्द और ताक़त में ज़ोरआवर है,</para>
  <para style="q" vid="JOB 9:4">किसी ने हिम्मत करके उसका सामना किया है और बढ़ा हो।<verse eid="JOB 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 9:5"/>वह पहाड़ों को हटा देता है</para>
  <para style="q" vid="JOB 9:5">और उन्हें पता भी नहीं लगता वह अपने क़हर में उलट देता है।<verse eid="JOB 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 9:6"/>वह ज़मीन को उसकी जगह से हिला देता है,</para>
  <para style="q" vid="JOB 9:6">और उसके सुतून काँपने लगते हैं।<verse eid="JOB 9:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 9:7"/>वह सूरज को हुक्म करता है और वह तुलू' नहीं होता है,</para>
  <para style="q" vid="JOB 9:7">और सितारों पर मुहर लगा देता है<verse eid="JOB 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 9:8"/>वह आसमानों को अकेला तान देता है,</para>
  <para style="q" vid="JOB 9:8">और समन्दर की लहरों पर चलता है<verse eid="JOB 9:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 9:9"/>उसने बनात — उन — नाश और जब्बार और</para>
  <para style="q" vid="JOB 9:9">सुरैया और जुनूब के बुजों' को बनाया।<verse eid="JOB 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 9:10"/>वह बड़े बड़े काम जो बयान नहीं हो सकते,</para>
  <para style="q" vid="JOB 9:10">और बेशुमार अजीब काम करता है।<verse eid="JOB 9:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 9:11"/>देखो, वह मेरे पास से गुज़रता है लेकिन मुझे दिखाई नहीं देता;</para>
  <para style="q" vid="JOB 9:11">वह आगे भी बढ़ जाता है लेकिन मैं उसे नहीं देखता।<verse eid="JOB 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 9:12"/>देखो, वह शिकार पकड़ता है; कौन उसे रोक सकता है?</para>
  <para style="q" vid="JOB 9:12">कौन उससे कहेगा कि तू क्या करता है?<verse eid="JOB 9:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 9:13"/>“ख़ुदा अपने ग़ुस्से को नहीं हटाएगा।</para>
  <para style="q" vid="JOB 9:13">रहब' के मददगार उसके नीचे झुकजाते हैं।<verse eid="JOB 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 9:14"/>फिर मेरी क्या हक़ीक़त है कि मैं उसे जवाब दूँ</para>
  <para style="q" vid="JOB 9:14">और उससे बहस करने को अपने लफ़्ज़ छाँट छाँट कर निकालूँ?<verse eid="JOB 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 9:15"/>उसे तो मैं अगर सादिक़ भी होता तो जवाब न देता।</para>
  <para style="q" vid="JOB 9:15">मैं अपने मुख़ालिफ़ की मिन्नत करता।<verse eid="JOB 9:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 9:16"/>अगर वह मेरे पुकारने पर मुझे जवाब भी देता,</para>
  <para style="q" vid="JOB 9:16">तोभी मैं यक़ीन न करता कि उसने मेरी आवाज़ सुनी।<verse eid="JOB 9:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 9:17"/>वह तूफ़ान से मुझे तोड़ता है,</para>
  <para style="q" vid="JOB 9:17">और बे वजह मेरे ज़ख़्मों को ज़्यादा करता है।<verse eid="JOB 9:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 9:18"/>वह मुझे दम नहीं लेने देता,</para>
  <para style="q" vid="JOB 9:18">बल्कि मुझे तल्ख़ी से भरपूर करता है।<verse eid="JOB 9:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 9:19"/>अगर ज़ोरआवर की ताक़त का ज़िक्र हो, तो देखो वह है।</para>
  <para style="q" vid="JOB 9:19">और अगर इन्साफ़ का, तो मेरे लिए वक़्त कौन ठहराएगा?<verse eid="JOB 9:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 9:20"/>अगर मैं सच्चा भी हूँ, तोभी मेरा ही मुँह मुझे मुल्ज़िम ठहराएगा।</para>
  <para style="q" vid="JOB 9:20">और अगर मैं कामिल भी हूँ तोभी यह मुझे आलसी साबित करेगा।<verse eid="JOB 9:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 9:21"/>मैं कामिल तो हूँ, लेकिन अपने को कुछ नहीं समझता;</para>
  <para style="q" vid="JOB 9:21">मैं अपनी ज़िन्दगी को बेकार जानता हूँ।<verse eid="JOB 9:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 9:22"/>यह सब एक ही बात है, इसलिए मैं कहता हूँ</para>
  <para style="q" vid="JOB 9:22">कि वह कामिल और शरीर दोनों को हलाक कर देता है।<verse eid="JOB 9:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 9:23"/>अगर वबा अचानक हलाक करने लगे,</para>
  <para style="q" vid="JOB 9:23">तो वह बेगुनाह की आज़माइश का मज़ाक़ उड़ाता है।<verse eid="JOB 9:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 9:24"/>ज़मीन शरीरों को हवाले कर दी गई है।</para>
  <para style="q" vid="JOB 9:24">वह उसके हाकिमों के मुँह ढाँक देता है।</para>
  <para style="q" vid="JOB 9:24">अगर वही नहीं तो और कौन है?<verse eid="JOB 9:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 9:25"/>मेरे दिन हरकारों से भी तेज़रू हैं।</para>
  <para style="q" vid="JOB 9:25">वह उड़े चले जाते हैं और ख़ुशी नहीं देखने पाते।<verse eid="JOB 9:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 9:26"/>वह तेज़ जहाज़ों की तरह निकल गए,</para>
  <para style="q" vid="JOB 9:26">और उस उक़ाब की तरह जो शिकार पर झपटता हो।<verse eid="JOB 9:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 9:27"/>अगर मैं कहूँ, कि 'मैं अपना ग़म भुला दूँगा,</para>
  <para style="q" vid="JOB 9:27">और उदासी छोड़कर दिलशाद हूँगा,<verse eid="JOB 9:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 9:28"/>तो मैं अपने दुखों से डरता हूँ,</para>
  <para style="q" vid="JOB 9:28">मैं जानता हूँ कि तू मुझे बेगुनाह न ठहराएगा।<verse eid="JOB 9:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 9:29"/>मैं तो मुल्ज़िम ठहरूँगा;</para>
  <para style="q" vid="JOB 9:29">फिर मैं 'तो मैं ज़हमत क्यूँ उठाऊँ?<verse eid="JOB 9:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 9:30"/>अगर मैं अपने को बर्फ़ के पानी से धोऊँ,</para>
  <para style="q" vid="JOB 9:30">और अपने हाथ कितने ही साफ़ करूँ।<verse eid="JOB 9:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 9:31"/>तोभी तू मुझे खाई में ग़ोता देगा,</para>
  <para style="q" vid="JOB 9:31">और मेरे ही कपड़े मुझ से घिन खाएँगे।<verse eid="JOB 9:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 9:32"/>क्यूँकि वह मेरी तरह आदमी नहीं कि मैं उसे जवाब दूँ,</para>
  <para style="q" vid="JOB 9:32">और हम 'अदालत में एक साथ हाज़िर हों।<verse eid="JOB 9:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 9:33"/>हमारे बीच कोई बिचवानी नहीं,</para>
  <para style="q" vid="JOB 9:33">जो हम दोनों पर अपना हाथ रख्खे।<verse eid="JOB 9:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 9:34"/>वह अपनी लाठी मुझ से हटा ले,</para>
  <para style="q" vid="JOB 9:34">और उसकी डरावनी बात मुझे परेशान न करे।<verse eid="JOB 9:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 9:35"/>तब मैं कुछ कहूँगा और उससे डरने का नहीं,</para>
  <para style="q" vid="JOB 9:35">क्यूँकि अपने आप में तो मैं ऐसा नहीं हूँ।<verse eid="JOB 9:35"/></para>
  <chapter eid="JOB 9"/>
  <chapter number="10" style="c" sid="JOB 10"/>
  <para style="s">अय्यूब का ख़ुदा से दरख्वास्त करना</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 10:1"/>“मेरी रूह मेरी ज़िन्दगी से परेशान है;</para>
  <para style="q" vid="JOB 10:1">मैं अपना शिकवा ख़ूब दिल खोल कर करूँगा।</para>
  <para style="q" vid="JOB 10:1">मैं अपने दिल की तल्ख़ी में बोलूँगा।<verse eid="JOB 10:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 10:2"/>मैं ख़ुदा से कहूँगा, मुझे मुल्ज़िम न ठहरा;</para>
  <para style="q" vid="JOB 10:2">मुझे बता कि तू मुझ से क्यूँ झगड़ता है।<verse eid="JOB 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 10:3"/>क्या तुझे अच्छा लगता है, कि अँधेर करे,</para>
  <para style="q" vid="JOB 10:3">और अपने हाथों की बनाई हुई चीज़ को बेकार जाने,</para>
  <para style="q" vid="JOB 10:3">और शरीरों की बातों की रोशनी करे?<verse eid="JOB 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 10:4"/>क्या तेरी आँखें गोश्त की हैं?</para>
  <para style="q" vid="JOB 10:4">या तू ऐसे देखता है जैसे आदमी देखता है?<verse eid="JOB 10:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 10:5"/>क्या तेरे दिन आदमी के दिन की तरह,</para>
  <para style="q" vid="JOB 10:5">और तेरे साल इंसान के दिनों की तरह हैं,<verse eid="JOB 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 10:6"/>कि तू मेरी बदकारी को पूछता,</para>
  <para style="q" vid="JOB 10:6">और मेरा गुनाह ढूँडता है?<verse eid="JOB 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 10:7"/>क्या तुझे मा'लूम है कि मैं शरीर नहीं हूँ,</para>
  <para style="q" vid="JOB 10:7">और कोई नहीं जो तेरे हाथ से छुड़ा सके?<verse eid="JOB 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 10:8"/>तेरे ही हाथों ने मुझे बनाया और सरासर जोड़ कर कामिल किया।</para>
  <para style="q" vid="JOB 10:8">फिर भी तू मुझे हलाक करता है।<verse eid="JOB 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 10:9"/>याद कर कि तूने गुंधी हुई मिट्टी की तरह मुझे बनाया,</para>
  <para style="q" vid="JOB 10:9">और क्या तू मुझे फिर ख़ाक में मिलाएगा?<verse eid="JOB 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 10:10"/>क्या तूने मुझे दूध की तरह नहीं उंडेला,</para>
  <para style="q" vid="JOB 10:10">और पनीर की तरह नहीं जमाया?<verse eid="JOB 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 10:11"/>फिर तूने मुझ पर चमड़ा और गोश्त चढ़ाया,</para>
  <para style="q" vid="JOB 10:11">और हड्डियों और नसों से मुझे जोड़ दिया।<verse eid="JOB 10:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 10:12"/>तूने मुझे जान बख़्शी और मुझ पर करम किया,</para>
  <para style="q" vid="JOB 10:12">और तेरी निगहबानी ने मेरी रूह सलामत रख्खी।<verse eid="JOB 10:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 10:13"/>तोभी तूने यह बातें तूने अपने दिल में छिपा रख्खी थीं।</para>
  <para style="q" vid="JOB 10:13">मैं जानता हूँ कि तेरा यही इरादा है कि<verse eid="JOB 10:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 10:14"/>अगर मैं गुनाह करूँ, तो तू मुझ पर निगरान होगा;</para>
  <para style="q" vid="JOB 10:14">और तू मुझे मेरी बदकारी से बरी नहीं करेगा।<verse eid="JOB 10:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 10:15"/>अगर मैं गुनाह करूँ तो मुझ पर अफ़सोस!</para>
  <para style="q" vid="JOB 10:15">अगर मैं सच्चा बनूँ तोभी अपना सिर नहीं उठाने का,</para>
  <para style="q" vid="JOB 10:15">क्यूँकि मैं ज़िल्लत से भरा हूँ,</para>
  <para style="q" vid="JOB 10:15">और अपनी मुसीबत को देखता रहता हूँ।<verse eid="JOB 10:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 10:16"/>और अगर सिर उठाऊँ, तो तू शेर की तरह मुझे शिकार करता है</para>
  <para style="q" vid="JOB 10:16">और फिर 'अजीब सूरत में मुझ पर ज़ाहिर होता है।<verse eid="JOB 10:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 10:17"/>तू मेरे ख़िलाफ़ नए नए गवाह लाता है,</para>
  <para style="q" vid="JOB 10:17">और अपना क़हर मुझ पर बढ़ाता है;</para>
  <para style="q" vid="JOB 10:17">नई नई फ़ौजें मुझ पर चढ़ आती हैं।<verse eid="JOB 10:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 10:18"/>इसलिए तूने मुझे रहम से निकाला ही क्यूँ?</para>
  <para style="q" vid="JOB 10:18">मैं जान दे देता और कोई आँख मुझे देखने न पाती।<verse eid="JOB 10:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 10:19"/>मैं ऐसा होता कि गोया मैं था ही नहीं मैं रहम ही से क़ब्र में पहुँचा दिया जाता।<verse eid="JOB 10:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 10:20"/>क्या मेरे दिन थोड़े से नहीं? बाज़ आ,</para>
  <para style="q" vid="JOB 10:20">और मुझे छोड़ दे ताकि मैं कुछ राहत पाऊँ।<verse eid="JOB 10:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 10:21"/>इससे पहले कि मैं वहाँ जाऊँ,</para>
  <para style="q" vid="JOB 10:21">जहाँ से फिर न लौटूँगा या'नी तारीकी और मौत और साये की सर ज़मीन को:<verse eid="JOB 10:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 10:22"/>गहरी तारीकी की सर ज़मीन जो खु़द तारीकी ही है;</para>
  <para style="q" vid="JOB 10:22">मौत के साये की सर ज़मीन जो बे तरतीब है,</para>
  <para style="q" vid="JOB 10:22">और जहाँ रोशनी भी ऐसी है जैसी तारीकी।”<verse eid="JOB 10:22"/></para>
  <chapter eid="JOB 10"/>
  <chapter number="11" style="c" sid="JOB 11"/>
  <para style="s">जूफ़र का पहला जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 11:1"/>तब जूफ़र नामाती ने जवाब दिया,<verse eid="JOB 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 11:2"/>क्या इन बहुत सी बातों का जवाब न दिया जाए?</para>
  <para style="q" vid="JOB 11:2">और क्या बकवासी आदमी रास्त ठहराया जाए?<verse eid="JOB 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 11:3"/>क्या तेरे बड़े बोल लोगों को ख़ामोश करदे?</para>
  <para style="q" vid="JOB 11:3">और जब तू ठठ्ठा करे तो क्या कोई तुझे शर्मिन्दा न करे?<verse eid="JOB 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 11:4"/>क्यूँकि तू कहता है, 'मेरी ता'लीम पाक है,</para>
  <para style="q" vid="JOB 11:4">और मैं तेरी निगाह में बेगुनाह हूँ।<verse eid="JOB 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 11:5"/>काश ख़ुदा ख़ुद बोले,</para>
  <para style="q" vid="JOB 11:5">और तेरे ख़िलाफ़ अपने लबों को खोले।<verse eid="JOB 11:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 11:6"/>और हिकमत के आसार तुझे दिखाए कि वह तासीर में बहुत बड़ा है।</para>
  <para style="q" vid="JOB 11:6">इसलिए जान ले कि तेरी बदकारी जिस लायक़ है उससे कम ही ख़ुदा तुझ से मुतालबा करता है।<verse eid="JOB 11:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 11:7"/>क्या तू तलाश से ख़ुदा को पा सकता है?</para>
  <para style="q" vid="JOB 11:7">क्या तू क़ादिर — ए — मुतलक़ का राज़ पूरे तौर से बयान कर सकता है?<verse eid="JOB 11:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 11:8"/>वह आसमान की तरह ऊँचा है, तू क्या कर सकता है?</para>
  <para style="q" vid="JOB 11:8">वह पाताल सा गहरा है, तू क्या जान सकता है?<verse eid="JOB 11:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 11:9"/>उसकी नाप ज़मीन से लम्बी</para>
  <para style="q" vid="JOB 11:9">और समन्दर से चौड़ी है<verse eid="JOB 11:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 11:10"/>अगर वह बीच से गुज़र कर बंद कर दे,</para>
  <para style="q" vid="JOB 11:10">और 'अदालत में बुलाए तो कौन उसे रोक सकता है?<verse eid="JOB 11:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 11:11"/>क्यूँकि वह बेहूदा आदमियों को पहचानता है,</para>
  <para style="q" vid="JOB 11:11">और बदकारी को भी देखता है, चाहे उसका ख़्याल न करे?<verse eid="JOB 11:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 11:12"/>लेकिन बेहूदा आदमी समझ से ख़ाली होता है,</para>
  <para style="q" vid="JOB 11:12">बल्कि इंसान गधे के बच्चे की तरह पैदा होता है।<verse eid="JOB 11:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 11:13"/>अगर तू अपने दिल को ठीक करे,</para>
  <para style="q" vid="JOB 11:13">और अपने हाथ उसकी तरफ़ फैलाए,<verse eid="JOB 11:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 11:14"/>अगर तेरे हाथ में बदकारी हो तो उसे दूर करे,</para>
  <para style="q" vid="JOB 11:14">और नारास्ती को अपने ख़ेमों में रहने न दे,<verse eid="JOB 11:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 11:15"/>तब यक़ीनन तू अपना मुँह बे दाग़ उठाएगा,</para>
  <para style="q" vid="JOB 11:15">बल्कि तू साबित क़दम हो जाएगा और डरने का नहीं।<verse eid="JOB 11:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 11:16"/>क्यूँकि तू अपनी ख़स्ताहाली को भूल जाएगा,</para>
  <para style="q" vid="JOB 11:16">तू उसे उस पानी की तरह याद करेगा जो बह गया हो।<verse eid="JOB 11:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 11:17"/>और तेरी ज़िन्दगी दोपहर से ज़्यादा रोशन होगी,</para>
  <para style="q" vid="JOB 11:17">और अगर तारीकी हुई तो वह सुबह की तरह होगी।<verse eid="JOB 11:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 11:18"/>और तू मुतम'इन रहेगा,</para>
  <para style="q" vid="JOB 11:18">क्यूँकि उम्मीद होगी और अपने चारों तरफ़ देख देख कर सलामती से आराम करेगा।<verse eid="JOB 11:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 11:19"/>और तू लेट जाएगा,</para>
  <para style="q" vid="JOB 11:19">और कोई तुझे डराएगा नहीं बल्कि बहुत से लोग तुझ से फ़रियाद करेंगे।<verse eid="JOB 11:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 11:20"/>लेकिन शरीरों की आँखें रह जाएँगी,</para>
  <para style="q" vid="JOB 11:20">उनके लिए भागने को भी रास्ता न होगा,</para>
  <para style="q" vid="JOB 11:20">और जान दे देना ही उनकी उम्मीद होगी।”<verse eid="JOB 11:20"/></para>
  <chapter eid="JOB 11"/>
  <chapter number="12" style="c" sid="JOB 12"/>
  <para style="s">अय्यूब का चौथा बयान: जूफ़र को जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 12:1"/>तब अय्यूब ने जवाब दिया,<verse eid="JOB 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 12:2"/>बेशक आदमी तो तुम ही हो “</para>
  <para style="q" vid="JOB 12:2">और हिकमत तुम्हारे ही साथ मरेगी।<verse eid="JOB 12:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 12:3"/>लेकिन मुझ में भी समझ है,</para>
  <para style="q" vid="JOB 12:3">जैसे तुम में है, मैं तुम से कम नहीं।</para>
  <para style="q" vid="JOB 12:3">भला ऐसी बातें जैसी यह हैं, कौन नहीं जानता?<verse eid="JOB 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 12:4"/>मैं उस आदमी की तरह हूँ जो अपने पड़ोसी के लिए हँसी का निशाना बना है।</para>
  <para style="q" vid="JOB 12:4">मैं वह आदमी था जो ख़ुदा से दुआ करता और वह उसकी सुन लेता था।</para>
  <para style="q" vid="JOB 12:4">रास्तबाज़ और कामिल आदमी हँसी का निशाना होता ही है।<verse eid="JOB 12:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 12:5"/>जो चैन से है उसके ख़्याल में दुख के लिए हिकारत होती है;</para>
  <para style="q" vid="JOB 12:5">यह उनके लिए तैयार रहती है जिनका पाँव फिसलता है।<verse eid="JOB 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 12:6"/>डाकुओं के ख़ेमे सलामत रहते हैं,</para>
  <para style="q" vid="JOB 12:6">और जो ख़ुदा को गु़स्सा दिलाते हैं, वह महफू़ज़ रहते हैं;</para>
  <para style="q" vid="JOB 12:6">उन ही के हाथ को ख़ुदा ख़ूब भरता है।<verse eid="JOB 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 12:7"/>हैवानों से पूछ और वह तुझे सिखाएँगे,</para>
  <para style="q" vid="JOB 12:7">और हवा के परिन्दों से दरियाफ़्त कर और वह तुझे बताएँगे।<verse eid="JOB 12:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 12:8"/>या ज़मीन से बात कर, वह तुझे सिखाएगी;</para>
  <para style="q" vid="JOB 12:8">और समन्दर की मछलियाँ तुझ से बयान करेंगी।<verse eid="JOB 12:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 12:9"/>कौन नहीं जानता</para>
  <para style="q" vid="JOB 12:9">कि इन सब बातों में ख़ुदावन्द ही का हाथ है जिसने यह सब बनाया?<verse eid="JOB 12:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 12:10"/>उसी के हाथ में हर जानदार की जान,</para>
  <para style="q" vid="JOB 12:10">और कुल बनी आदम की जान ताक़त है।<verse eid="JOB 12:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 12:11"/>क्या कान बातों को नहीं परख लेता,</para>
  <para style="q" vid="JOB 12:11">जैसे ज़बान खाने को चख लेती है?<verse eid="JOB 12:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 12:12"/>बुड्ढों में समझ होती है</para>
  <para style="q" vid="JOB 12:12">, और उम्र की दराज़ी में समझदारी।<verse eid="JOB 12:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 12:13"/>ख़ुदा में समझ और कु़व्वत है,</para>
  <para style="q" vid="JOB 12:13">उसके पास मसलहत और समझ है।<verse eid="JOB 12:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 12:14"/>देखो, वह ढा देता है तो फिर बनता नहीं।</para>
  <para style="q" vid="JOB 12:14">वह आदमी को बंद कर देता है, तो फिर खुलता नहीं।<verse eid="JOB 12:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 12:15"/>देखो, वह मेंह को रोक लेता है, तो पानी सूख जाता है।</para>
  <para style="q" vid="JOB 12:15">फिर जब वह उसे भेजता है, तो वह ज़मीन को उलट देता है।<verse eid="JOB 12:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 12:16"/>उसमें ताक़त और ता'सीर की कु़व्वत है।</para>
  <para style="q" vid="JOB 12:16">धोका खाने वाला और धोका देने वाला दोनों उसी के हैं।<verse eid="JOB 12:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 12:17"/>वह सलाहकारों को लुटवा कर ग़ुलामी में ले जाता है,</para>
  <para style="q" vid="JOB 12:17">और 'अदालत करने वालों को बेवकू़फ़ बना देता है।<verse eid="JOB 12:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 12:18"/>वह शाही बन्धनों को खोल डालता है,</para>
  <para style="q" vid="JOB 12:18">और बादशाहों की कमर पर पटका बाँधता है।<verse eid="JOB 12:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 12:19"/>वह काहिनों को लुटवाकर ग़ुलामी में ले जाता,</para>
  <para style="q" vid="JOB 12:19">और ज़बरदस्तों को पछाड़ देता है।<verse eid="JOB 12:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 12:20"/>वह 'ऐतमाद वाले की क़ुव्वत — ए — गोयाई दूर करता</para>
  <para style="q" vid="JOB 12:20">और बुज़ुर्गों की समझदारी को' छीन लेता है।<verse eid="JOB 12:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 12:21"/>वह हाकिमों पर हिकारत बरसाता,</para>
  <para style="q" vid="JOB 12:21">और ताक़तवरों की कमरबंद को खोल डालता' है।<verse eid="JOB 12:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 12:22"/>वह अँधेरे में से गहरी बातों को ज़ाहिर करता,</para>
  <para style="q" vid="JOB 12:22">और मौत के साये को भी रोशनी में ले आता है<verse eid="JOB 12:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 12:23"/>वह क़ौमों को बढ़ाकर उन्हें हलाक कर डालता है;</para>
  <para style="q" vid="JOB 12:23">वह क़ौमों को फैलाता और फिर उन्हें समेट लेता है।<verse eid="JOB 12:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 12:24"/>वह ज़मीन की क़ौमों के सरदारों की 'अक़्ल उड़ा देता</para>
  <para style="q" vid="JOB 12:24">और उन्हें ऐसे वीरान में भटका देता है जहाँ रास्ता नहीं।<verse eid="JOB 12:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 12:25"/>वह रोशनी के बगै़र तारीकी में टटोलते फिरते हैं,</para>
  <para style="q" vid="JOB 12:25">और वह उन्हें ऐसा बना देता है कि मतवाले</para>
  <para style="q" vid="JOB 12:25">की तरह लड़खड़ाते हुए चलते हैं।<verse eid="JOB 12:25"/></para>
  <chapter eid="JOB 12"/>
  <chapter number="13" style="c" sid="JOB 13"/>
  <para style="s">अय्यूब का अपने हालात को लेकर ख़ुदा से झगड़ना</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 13:1"/>“मेरी आँख ने तो यह सब कुछ देखा है,</para>
  <para style="q" vid="JOB 13:1">मेरे कान ने यह सुना और समझ भी लिया है।<verse eid="JOB 13:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 13:2"/>जो कुछ तुम जानते हो उसे मैं भी जानता हूँ,</para>
  <para style="q" vid="JOB 13:2">मैं तुम से कम नहीं।<verse eid="JOB 13:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 13:3"/>मैं तो क़ादिर — ए — मुतलक़ से गुफ़्तगू करना चाहता हूँ,</para>
  <para style="q" vid="JOB 13:3">मेरी आरज़ू है कि ख़ुदा के साथ बहस करूँ<verse eid="JOB 13:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 13:4"/>लेकिन तुम लोग तो झूटी बातों के गढ़ने वाले हो;</para>
  <para style="q" vid="JOB 13:4">तुम सब के सब निकम्मे हकीम हो।<verse eid="JOB 13:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 13:5"/>काश तुम बिल्कुल ख़ामोश हो जाते,</para>
  <para style="q" vid="JOB 13:5">यही तुम्हारी 'अक़्लमन्दी होती।<verse eid="JOB 13:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 13:6"/>अब मेरी दलील सुनो,</para>
  <para style="q" vid="JOB 13:6">और मेरे मुँह के दा'वे पर कान लगाओ।<verse eid="JOB 13:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 13:7"/>क्या तुम ख़ुदा के हक़ में नारास्ती से बातें करोगे,</para>
  <para style="q" vid="JOB 13:7">और उसके हक़ में धोके से बोलोगे?<verse eid="JOB 13:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 13:8"/>क्या तुम उसकी तरफ़दारी करोगे?</para>
  <para style="q" vid="JOB 13:8">क्या तुम ख़ुदा की तरफ़ से झगड़ोगे?<verse eid="JOB 13:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 13:9"/>क्या यह अच्छ होगा कि वह तुम्हारा जाएज़ा करें?</para>
  <para style="q" vid="JOB 13:9">क्या तुम उसे धोका दोगे जैसे आदमी को?<verse eid="JOB 13:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 13:10"/>वह ज़रूर तुम्हें मलामत करेगा</para>
  <para style="q" vid="JOB 13:10">जो तुम ख़ुफ़िया तरफ़दारी करो,<verse eid="JOB 13:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 13:11"/>क्या उसका जलाल तुम्हें डरा न देगा,</para>
  <para style="q" vid="JOB 13:11">और उसका रौ'ब तुम पर छा न जाएगा?<verse eid="JOB 13:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 13:12"/>तुम्हारी छुपी बातें राख की कहावतें हैं,</para>
  <para style="q" vid="JOB 13:12">तुम्हारी दीवारें मिटटी की दीवारें हैं।<verse eid="JOB 13:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 13:13"/>तुम चुप रहो, मुझे छोड़ो ताकि मैं बोल सकूँ,</para>
  <para style="q" vid="JOB 13:13">और फिर मुझ पर जो बीते सो बीते।<verse eid="JOB 13:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 13:14"/>मैं अपना ही गोश्त अपने दाँतों से क्यूँ चबाऊँ;</para>
  <para style="q" vid="JOB 13:14">और अपनी जान अपनी हथेली पर क्यूँ रख्खूँ?<verse eid="JOB 13:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 13:15"/>देखो, वह मुझे क़त्ल करेगा, मैं इन्तिज़ार नहीं करूँगा।</para>
  <para style="q" vid="JOB 13:15">बहर हाल मैं अपनी राहों की ता'ईद उसके सामने करूँगा।<verse eid="JOB 13:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 13:16"/>यह भी मेरी नजात के ज़रिए' होगा,</para>
  <para style="q" vid="JOB 13:16">क्यूँकि कोई बेख़ुदा उसके बराबर आ नहीं सकता।<verse eid="JOB 13:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 13:17"/>मेरी तक़रीर को ग़ौर से सुनो,</para>
  <para style="q" vid="JOB 13:17">और मेरा बयान तुम्हारे कानों में पड़े।<verse eid="JOB 13:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 13:18"/>देखो, मैंने अपना दा'वा दुरुस्त कर लिया है;</para>
  <para style="q" vid="JOB 13:18">मैं जानता हूँ कि मैं सच्चा हूँ।<verse eid="JOB 13:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 13:19"/>कौन है जो मेरे साथ झगड़ेगा?</para>
  <para style="q" vid="JOB 13:19">क्यूँकि फिर तो मैं चुप हो कर अपनी जान दे दूँगा।<verse eid="JOB 13:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 13:20"/>सिर्फ़ दो ही काम मुझ से न कर,</para>
  <para style="q" vid="JOB 13:20">तब मैं तुझ से नहीं छि पू गा:<verse eid="JOB 13:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 13:21"/>अपना हाथ मुझ से दूर हटाले,</para>
  <para style="q" vid="JOB 13:21">और तेरी हैबत मुझे ख़ौफ़ ज़दा न करे।<verse eid="JOB 13:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 13:22"/>तब तेरे बुलाने पर मैं जवाब दूँगा;</para>
  <para style="q" vid="JOB 13:22">या मैं बोलूँ और तू मुझे जवाब दे।<verse eid="JOB 13:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 13:23"/>मेरी बदकारियाँ और गुनाह कितने हैं?</para>
  <para style="q" vid="JOB 13:23">ऐसा कर कि मैं अपनी ख़ता और गुनाह को जान लूँ।<verse eid="JOB 13:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 13:24"/>तू अपना मुँह क्यूँ छिपाता है,</para>
  <para style="q" vid="JOB 13:24">और मुझे अपना दुश्मन क्यूँ जानता है?<verse eid="JOB 13:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 13:25"/>क्या तू उड़ते पत्ते को परेशान करेगा?</para>
  <para style="q" vid="JOB 13:25">क्या तू सूखे डंठल के पीछे पड़ेगा?<verse eid="JOB 13:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 13:26"/>क्यूँकि तू मेरे ख़िलाफ़ तल्ख़ बातें लिखता है,</para>
  <para style="q" vid="JOB 13:26">और मेरी जवानी की बदकारियाँ मुझ पर वापस लाता है।”<verse eid="JOB 13:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 13:27"/>तू मेरे पाँव काठ में ठोंकता,</para>
  <para style="q" vid="JOB 13:27">और मेरी सब राहों की निगरानी करता है;</para>
  <para style="q" vid="JOB 13:27">और मेरे पाँव के चारों तरफ़ बाँध खींचता है।<verse eid="JOB 13:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 13:28"/>अगरचे मैं सड़ी हुई चीज़ की तरह हूँ, जो फ़ना हो जाती है।</para>
  <para style="q" vid="JOB 13:28">या उस कपड़े की तरह हूँ जिसे कीड़े ने खा लिया हो।<verse eid="JOB 13:28"/></para>
  <chapter eid="JOB 13"/>
  <chapter number="14" style="c" sid="JOB 14"/>
  <para style="q">
    <verse number="1" style="v" sid="JOB 14:1"/>इंसान जो 'औरत से पैदा होता है थोड़े दिनों का है,</para>
  <para style="q" vid="JOB 14:1">और दुख से भरा है।<verse eid="JOB 14:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 14:2"/>वह फूल की तरह निकलता, और काट डाला जाता है।</para>
  <para style="q" vid="JOB 14:2">वह साए की तरह उड़ जाता है और ठहरता नहीं।<verse eid="JOB 14:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 14:3"/>इसलिए क्या तू ऐसे पर अपनी आँखें खोलता है;</para>
  <para style="q" vid="JOB 14:3">और मुझे अपने साथ 'अदालत में घसीटता है?<verse eid="JOB 14:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 14:4"/>नापाक चीज़ में से पाक चीज़ कौन निकाल सकता है?</para>
  <para style="q" vid="JOB 14:4">कोई नहीं।<verse eid="JOB 14:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 14:5"/>उसके दिन तो ठहरे हुए हैं,</para>
  <para style="q" vid="JOB 14:5">और उसके महीनों की ता'दाद तेरे पास है;</para>
  <para style="q" vid="JOB 14:5">और तू ने उसकी हदों को मुक़र्रर कर दिया है, जिन्हें वह पार नहीं कर सकता।<verse eid="JOB 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 14:6"/>इसलिए उसकी तरफ़ से नज़र हटा ले ताकि वह आराम करे,</para>
  <para style="q" vid="JOB 14:6">जब तक वह मज़दूर की तरह अपना दिन पूरा न कर ले।<verse eid="JOB 14:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 14:7"/>“क्यूँकि दरख़्त की तो उम्मीद रहती है कि अगर वह काटा जाए तो फिर फूट निकलेगा,</para>
  <para style="q" vid="JOB 14:7">और उसकी नर्म नर्म डालियाँ ख़त्म न होंगी।<verse eid="JOB 14:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 14:8"/>अगरचे उसकी जड़ ज़मीन में पुरानी हो जाए,</para>
  <para style="q" vid="JOB 14:8">और उसका तना मिट्टी में गल जाए,<verse eid="JOB 14:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 14:9"/>तोभी पानी की बू पाते ही वह नए अखुवे लाएगा,</para>
  <para style="q" vid="JOB 14:9">और पौदे की तरह शाख़ें निकालेगा।<verse eid="JOB 14:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 14:10"/>लेकिन इंसान मर कर पड़ा रहता है,</para>
  <para style="q" vid="JOB 14:10">बल्कि इंसान जान छोड़ देता है, और फिर वह कहाँ रहा?<verse eid="JOB 14:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 14:11"/>जैसे झील का पानी ख़त्म हो जाता,</para>
  <para style="q" vid="JOB 14:11">और दरिया उतरता और सूख जाता है,<verse eid="JOB 14:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 14:12"/>वैसे आदमी लेट जाता है और उठता नहीं;</para>
  <para style="q" vid="JOB 14:12">जब तक आसमान टल न जाए, वह बेदार न होंगे;</para>
  <para style="q" vid="JOB 14:12">और न अपनी नींद से जगाए जाएँगे।<verse eid="JOB 14:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 14:13"/>काश कि तू मुझे पाताल में छिपा दे,</para>
  <para style="q" vid="JOB 14:13">और जब तक तेरा क़हर टल न जाए, मुझे पोशीदा रख्खे;</para>
  <para style="q" vid="JOB 14:13">और कोई मुक़र्ररा वक़्त मेरे लिए ठहराए और मुझे याद करे।<verse eid="JOB 14:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 14:14"/>अगर आदमी मर जाए तो क्या वह फिर जिएगा?</para>
  <para style="q" vid="JOB 14:14">मैं अपनी जंग के सारे दिनों में मुन्तज़िर रहता जब तक मेरा छुटकारा न होता।<verse eid="JOB 14:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 14:15"/>तू मुझे पुकारता और मैं तुझे जवाब देता;</para>
  <para style="q" vid="JOB 14:15">तुझे अपने हाथों की सन'अत की तरफ़ ख्वाहिश होती।<verse eid="JOB 14:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 14:16"/>लेकिन अब तो तू मेरे क़दम गिनता है;</para>
  <para style="q" vid="JOB 14:16">क्या तू मेरे गुनाह की ताक में लगा नहीं रहता?<verse eid="JOB 14:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 14:17"/>मेरी ख़ता थैली में सरब — मुहर है,</para>
  <para style="q" vid="JOB 14:17">तू ने मेरे गुनाह को सी रख्खा है।<verse eid="JOB 14:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 14:18"/>यक़ीनन पहाड़ गिरते गिरते ख़त्म हो जाता है,</para>
  <para style="q" vid="JOB 14:18">और चट्टान अपनी जगह से हटा दी जाती है।<verse eid="JOB 14:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 14:19"/>पानी पत्थरों को घिसा डालता है,</para>
  <para style="q" vid="JOB 14:19">उसकी बाढ़ ज़मीन की ख़ाक को बहाले जाती है;</para>
  <para style="q" vid="JOB 14:19">इसी तरह तू इंसान की उम्मीद को मिटा देता है।<verse eid="JOB 14:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 14:20"/>तू हमेशा उस पर ग़ालिब होता है, इसलिए वह गुज़र जाता है।</para>
  <para style="q" vid="JOB 14:20">तू उसका चेहरा बदल डालता और उसे ख़ारिज कर देता है।<verse eid="JOB 14:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 14:21"/>उसके बेटों की 'इज़्ज़त होती है, लेकिन उसे ख़बर नहीं।</para>
  <para style="q" vid="JOB 14:21">वह ज़लील होते हैं लेकिन वह उनका हाल‘ नहीं जानता।<verse eid="JOB 14:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 14:22"/>बल्कि उसका गोश्त जो उसके ऊपर है, दुखी रहता;</para>
  <para style="q" vid="JOB 14:22">और उसकी जान उसके अन्दर ही अन्दर ग़म खाती रहती है।”<verse eid="JOB 14:22"/></para>
  <chapter eid="JOB 14"/>
  <chapter number="15" style="c" sid="JOB 15"/>
  <para style="s">इलिफ़ज़ का अय्यूब को दुसरा जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 15:1"/>तब इलिफ़ज़ तेमानी ने जवाब दिया,<verse eid="JOB 15:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 15:2"/>क्या 'अक़्लमन्द को चाहिए कि फ़ुज़ूल बातें जोड़ कर जवाब दे,</para>
  <para style="q" vid="JOB 15:2">और पूरबी हवा से अपना पेट भरे?<verse eid="JOB 15:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 15:3"/>क्या वह बेफ़ाइदा बक़वास से बहस करे</para>
  <para style="q" vid="JOB 15:3">या ऐसी तक़रीरों से जो बे फ़ाइदा हैं?<verse eid="JOB 15:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 15:4"/>बल्कि तू ख़ौफ़ को नज़र अन्दाज़ करके,</para>
  <para style="q" vid="JOB 15:4">ख़ुदा के सामने इबादत को ज़ायल करता है।<verse eid="JOB 15:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 15:5"/>क्यूँकि तेरा गुनाह तेरे मुँह को सिखाता है,</para>
  <para style="q" vid="JOB 15:5">और तू रियाकारों की ज़बान इख़्तियार करता है।<verse eid="JOB 15:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 15:6"/>तेरा ही मुँह तुझे मुल्ज़िम ठहराता है न कि मैं,</para>
  <para style="q" vid="JOB 15:6">बल्कि तेरे ही होंट तेरे ख़िलाफ़ गवाही देते हैं।<verse eid="JOB 15:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 15:7"/>क्या पहला इंसान तू ही पैदा हुआ?</para>
  <para style="q" vid="JOB 15:7">या पहाड़ों से पहले तेरी पैदाइश हुई?<verse eid="JOB 15:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 15:8"/>क्या तू ने ख़ुदा की पोशीदा मसलहत सुन ली है,</para>
  <para style="q" vid="JOB 15:8">और अपने लिए 'अक़्लमन्दी का ठेका ले रख्खा है?<verse eid="JOB 15:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 15:9"/>तू ऐसा क्या जानता है, जो हम नहीं जानते?</para>
  <para style="q" vid="JOB 15:9">तुझ में ऐसी क्या समझ है जो हम में नहीं?<verse eid="JOB 15:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 15:10"/>हम लोगों में सिर सफ़ेद बाल वाले और बड़े बूढ़े भी हैं,</para>
  <para style="q" vid="JOB 15:10">जो तेरे बाप से भी बहुत ज़्यादा उम्र के हैं।<verse eid="JOB 15:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 15:11"/>क्या ख़ुदा की तसल्ली तेरे नज़दीक कुछ कम है,</para>
  <para style="q" vid="JOB 15:11">और वह कलाम जो तुझ से नरमी के साथ किया जाता है?<verse eid="JOB 15:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 15:12"/>तेरा दिल तुझे क्यूँ खींच ले जाता है,</para>
  <para style="q" vid="JOB 15:12">और तेरी आँखें क्यूँ इशारा करती हैं?<verse eid="JOB 15:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 15:13"/>क्या तू अपनी रूह को ख़ुदा की मुख़ालिफ़त पर आमादा करता है,</para>
  <para style="q" vid="JOB 15:13">और अपने मुँह से ऐसी बातें निकलने देता है?<verse eid="JOB 15:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 15:14"/>इंसान है क्‍या कि वह पाक हो?</para>
  <para style="q" vid="JOB 15:14">और वह जो 'औरत से पैदा हुआ क्‍या है, कि सच्चा हो।<verse eid="JOB 15:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 15:15"/>देख, वह अपने फ़रिर्श्तों का 'ऐतबार नहीं करता</para>
  <para style="q" vid="JOB 15:15">बल्कि आसमान भी उसकी नज़र में पाक नहीं।<verse eid="JOB 15:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 15:16"/>फ़िर भला उसका क्या ज़िक्र जो घिनौना</para>
  <para style="q" vid="JOB 15:16">और ख़राब है या'नी वह आदमी जो बुराई को पानी की तरह पीता है।<verse eid="JOB 15:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 15:17"/>“मैं तुझे बताता हूँ, तू मेरी सुन;</para>
  <para style="q" vid="JOB 15:17">और जो मैंने देखा है उसका बयान करूँगा।<verse eid="JOB 15:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 15:18"/>जिसे 'अक़्लमन्दों ने अपने बाप — दादा से सुनकर बताया है,</para>
  <para style="q" vid="JOB 15:18">और उसे छिपाया नहीं;<verse eid="JOB 15:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 15:19"/>सिर्फ़ उन ही को मुल्क दिया गया था,</para>
  <para style="q" vid="JOB 15:19">और कोई परदेसी उनके बीच नहीं आया<verse eid="JOB 15:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 15:20"/>शरीर आदमी अपनी सारी उम्र दर्द से कराहता है,</para>
  <para style="q" vid="JOB 15:20">या'नी सब बरस जो ज़ालिम के लिए रख्खे गए हैं।<verse eid="JOB 15:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 15:21"/>डरावनी आवाजें उसके कान में गूँजती रहती हैं,</para>
  <para style="q" vid="JOB 15:21">इक़बालमंदी के वक़्त ग़ारतगर उस पर आ पड़ेगा।<verse eid="JOB 15:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 15:22"/>उसे यक़ीन नहीं कि वह अँधेरे से बाहर निकलेगा,</para>
  <para style="q" vid="JOB 15:22">और तलवार उसकी मुन्तज़िर है।<verse eid="JOB 15:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 15:23"/>वह रोटी के लिए मारा मारा फिरता है कि कहाँ मिलेगी।</para>
  <para style="q" vid="JOB 15:23">वह जानता है, कि अँधेरे के दिन मेरे पास ही है।<verse eid="JOB 15:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 15:24"/>मुसीबत और सख़्त तकलीफ़ उसे डराती है;</para>
  <para style="q" vid="JOB 15:24">ऐसे बादशाह की तरह जो लड़ाई के लिए तैयार हो, वह उस पर ग़ालिब होते है।<verse eid="JOB 15:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 15:25"/>इसलिए कि उसने ख़ुदा के ख़िलाफ़ अपना हाथ बढ़ाया</para>
  <para style="q" vid="JOB 15:25">और क़ादिर — ए — मुतलक़ के ख़िलाफ़ फ़ख़्र करता है;<verse eid="JOB 15:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 15:26"/>वह अपनी ढालों की मोटी — मोटी</para>
  <para style="q" vid="JOB 15:26">गुलमैखों के साथ बाग़ी होकर उसपर हमला करता है:<verse eid="JOB 15:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 15:27"/>इसलिए कि उसके मुँह पर मोटापा छा गया है,</para>
  <para style="q" vid="JOB 15:27">और उसके पहलुओं पर चर्बी की तहें जम गई हैं।<verse eid="JOB 15:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 15:28"/>और वह वीरान शहरों में बस गया है,</para>
  <para style="q" vid="JOB 15:28">ऐसे मकानों में जिनमें कोई आदमी न बसा और जो वीरान होने को थे।<verse eid="JOB 15:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 15:29"/>वह दौलतमन्द न होगा, उसका माल बना न रहेगा</para>
  <para style="q" vid="JOB 15:29">और ऐसों की पैदावार ज़मीन की तरफ़ न झुकेगी।<verse eid="JOB 15:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 15:30"/>वह अँधेरे से कभी न निकलेगा,</para>
  <para style="q" vid="JOB 15:30">और शोले उसकी शाखों को ख़ुश्क कर देंगे,</para>
  <para style="q" vid="JOB 15:30">और वह ख़ुदा के मुँह से ताक़त से जाता रहेगा।<verse eid="JOB 15:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 15:31"/>वह अपने आप को धोका देकर बतालत का भरोसा न करे,</para>
  <para style="q" vid="JOB 15:31">क्यूँकि बतालत ही उसका मज़दूरी ठहरेगी।<verse eid="JOB 15:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 15:32"/>यह उसके वक़्त से पहले पूरा हो जाएगा</para>
  <para style="q" vid="JOB 15:32">, और उसकी शाख़ हरी न रहेगी।<verse eid="JOB 15:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 15:33"/>ताक की तरह उसके अंगूर कच्चे ही</para>
  <para style="q" vid="JOB 15:33">और जै़तून की तरह उसके फूल गिर जाएँगे।<verse eid="JOB 15:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 15:34"/>क्यूँकि बे ख़ुदा लोगों की जमा'अत बेफल रहेगी,</para>
  <para style="q" vid="JOB 15:34">और रिशवत के ख़ेमों को आग भस्म कर देगी।<verse eid="JOB 15:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 15:35"/>वह शरारत से ताक़तवर होते हैं और गुनाह पैदा होता है,</para>
  <para style="q" vid="JOB 15:35">और उनका पेट धोखा को तैयार करता है।”<verse eid="JOB 15:35"/></para>
  <chapter eid="JOB 15"/>
  <chapter number="16" style="c" sid="JOB 16"/>
  <para style="s">अय्यूब का पांचवा बयान: इलिफ़स को जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 16:1"/>तब अय्यूब ने जवाब दिया,<verse eid="JOB 16:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 16:2"/>“ऐसी बहुत सी बातें मैं सुन चुका हूँ,</para>
  <para style="q" vid="JOB 16:2">तुम सब के सब निकम्मे तसल्ली देने वाले हो।<verse eid="JOB 16:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 16:3"/>क्या बेकार बातें कभी ख़त्म होंगी?</para>
  <para style="q" vid="JOB 16:3">तू कौन सी बात से झिड़क कर जवाब देता है?<verse eid="JOB 16:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 16:4"/>मैं भी तुम्हारी तरह बात बना सकता हूँ:</para>
  <para style="q" vid="JOB 16:4">अगर तुम्हारी जान मेरी जान की जगह होती तो मैं तुम्हारे ख़िलाफ़ बातें बना सकता,</para>
  <para style="q" vid="JOB 16:4">और तुम पर अपना सिर हिला सकता।<verse eid="JOB 16:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 16:5"/>बल्कि मैं अपनी ज़बान से तुम्हें ताक़त देता,</para>
  <para style="q" vid="JOB 16:5">और मेरे लबों की तकलीफ़ तुम को तसल्ली देती।<verse eid="JOB 16:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 16:6"/>“अगर्चे मैं बोलता हूँ लेकिन मुझ को तसल्ली नहीं होती,</para>
  <para style="q" vid="JOB 16:6">और मैं चुप भी हो जाता हूँ, लेकिन मुझे क्या राहत होती है।<verse eid="JOB 16:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 16:7"/>लेकिन उसने तो मुझे दुखी कर डाला है,</para>
  <para style="q" vid="JOB 16:7">तूने मेरे सारे गिरोह को तबाह कर दिया है।<verse eid="JOB 16:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 16:8"/>तूने मुझे मज़बूती से पकड़ लिया है, यही मुझ पर गवाह है।</para>
  <para style="q" vid="JOB 16:8">मेरी लाचारी मेरे ख़िलाफ़ खड़ी होकर मेरे मुँह पर गवाही देती है।<verse eid="JOB 16:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 16:9"/>उसने अपने ग़ुस्से से मुझे फाड़ा और मेरा पीछा किया है;</para>
  <para style="q" vid="JOB 16:9">उसने मुझ पर दाँत पीसे,</para>
  <para style="q" vid="JOB 16:9">मेरा मुख़ालिफ़ मुझे आँखें दिखाता है।<verse eid="JOB 16:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 16:10"/>उन्होंने मुझ पर मुँह पसारा हैं,</para>
  <para style="q" vid="JOB 16:10">उन्होंने तनज़न मुझे गाल पर मारा है;</para>
  <para style="q" vid="JOB 16:10">वह मेरे ख़िलाफ़ इकट्ठे होते हैं।<verse eid="JOB 16:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 16:11"/>ख़ुदा मुझे बेदीनों के हवाले करता है,</para>
  <para style="q" vid="JOB 16:11">और शरीरों के हाथों में मुझे हवाले करता है।<verse eid="JOB 16:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 16:12"/>मैं आराम से था, और उसने मुझे चूर चूरकर डाला;</para>
  <para style="q" vid="JOB 16:12">उसने मेरी गर्दन पकड़ ली और मुझे पटक कर टुकड़े टुकड़े कर दिया:</para>
  <para style="q" vid="JOB 16:12">और उसने मुझे अपना निशाना बनाकर खड़ा किया है।<verse eid="JOB 16:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 16:13"/>उसके तीर अंदाज़ मुझे चारों तरफ़ से घेर लेते हैं,</para>
  <para style="q" vid="JOB 16:13">वह मेरे गुर्दों को चीरता है, और रहम नहीं करता,</para>
  <para style="q" vid="JOB 16:13">और मेरे पित को ज़मीन पर बहा देता है।<verse eid="JOB 16:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 16:14"/>वह मुझे ज़ख़्म पर ज़ख़्म लगा कर खस्ता करता है</para>
  <para style="q" vid="JOB 16:14">वह पहलवान की तरह मुझ पर हमला करता है:<verse eid="JOB 16:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 16:15"/>मैंने अपनी खाल पर टाट को सी लिया है,</para>
  <para style="q" vid="JOB 16:15">और अपना सींग ख़ाक में रख दिया है।<verse eid="JOB 16:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 16:16"/>मेरा मुँह रोते रोते सूज गया है,</para>
  <para style="q" vid="JOB 16:16">और मेरी पलकों पर मौत का साया है।<verse eid="JOB 16:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 16:17"/>अगर्चे मेरे हाथों ज़ुल्म नहीं,</para>
  <para style="q" vid="JOB 16:17">और मेरी दुआ बुराई से पाक है।<verse eid="JOB 16:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 16:18"/>ऐ ज़मीन, मेरे ख़ून को न ढाँकना,</para>
  <para style="q" vid="JOB 16:18">और मेरी फ़रियाद को आराम की जगह न मिले।<verse eid="JOB 16:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 16:19"/>अब भी देख, मेरा गवाह आसमान पर है,</para>
  <para style="q" vid="JOB 16:19">और मेरा ज़ामिन 'आलम — ए — बाला पर है।<verse eid="JOB 16:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 16:20"/>मेरे दोस्त मेरी हिकारत करते हैं,</para>
  <para style="q" vid="JOB 16:20">लेकिन मेरी आँख ख़ुदा के सामने आँसू बहाती है;<verse eid="JOB 16:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 16:21"/>जिस तरह एक आदमी अपने दौसत कि वकालत करता है</para>
  <para style="q" vid="JOB 16:21">उसी तरह वह ख़ुदा से आदमी कि वकालत करता है<verse eid="JOB 16:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 16:22"/>क्यूँकि जब चंद साल निकल जाएँगे,</para>
  <para style="q" vid="JOB 16:22">तो मैं उस रास्ते से चला जाऊँगा जिससे फिर लौटने का नहीं।<verse eid="JOB 16:22"/></para>
  <chapter eid="JOB 16"/>
  <chapter number="17" style="c" sid="JOB 17"/>
  <para style="s">अय्यूब का लगातार अपने बेकसूर होने के लिये झगड़ना</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 17:1"/>मेरी जान तबाह हो गई मेरे दिन हो चुके क़ब्र मेरे लिए तैय्यार है।<verse eid="JOB 17:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 17:2"/>यक़ीनन हँसी उड़ाने वाले मेरे साथ साथ हैं,</para>
  <para style="q" vid="JOB 17:2">और मेरी आँख उनकी छेड़छाड़ पर लगी रहती है।<verse eid="JOB 17:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 17:3"/>ज़मानत दे, अपने और मेरे बीच में तू ही ज़ामिन हो।</para>
  <para style="q" vid="JOB 17:3">कौन है जो मेरे हाथ पर हाथ मारे?<verse eid="JOB 17:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 17:4"/>क्यूँकि तूने इनके दिल को समझ से रोका है,</para>
  <para style="q" vid="JOB 17:4">इसलिए तू इनको सरफ़राज़ न करेगा।<verse eid="JOB 17:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 17:5"/>जो लूट की ख़ातिर अपने दोस्तों को मुल्ज़िम ठहराता है,</para>
  <para style="q" vid="JOB 17:5">उसके बच्चों की आँखें भी जाती रहेंगी।<verse eid="JOB 17:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 17:6"/>उसने मुझे लोगों के लिए ज़रबुल मिसाल बना दिया हैं:</para>
  <para style="q" vid="JOB 17:6">और मैं ऐसा हो गया कि लोग मेरे मुँह पर थूकें।<verse eid="JOB 17:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 17:7"/>मेरी आँखे ग़म के मारे धुंदला गई,</para>
  <para style="q" vid="JOB 17:7">और मेरे सब 'आज़ा परछाईं की तरह है।<verse eid="JOB 17:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 17:8"/>रास्तबाज़ आदमी इस बात से हैरान होंगे</para>
  <para style="q" vid="JOB 17:8">और मा'सूम आदमी बे ख़ुदा लोगों के ख़िलाफ़ जोश में आएगा<verse eid="JOB 17:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 17:9"/>तोभी सच्चा अपनी राह में साबित क़दम रहेगा और जिसके हाथ साफ़ हैं,</para>
  <para style="q" vid="JOB 17:9">वह ताक़तवर ही होता जाएगा<verse eid="JOB 17:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 17:10"/>लेकिन तुम सब के सब आते हो तो आओ,</para>
  <para style="q" vid="JOB 17:10">मुझे तुम्हारे बीच एक भी आदमी 'अक़्लमन्द न मिलेगा।<verse eid="JOB 17:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 17:11"/>मेरे दिन तो बीत चुके, और मेरे मक़सद मिट गए</para>
  <para style="q" vid="JOB 17:11">और जो मेरे दिल में था, वह बर्बाद हुआ है।<verse eid="JOB 17:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 17:12"/>वह रात को दिन से बदलते हैं,</para>
  <para style="q" vid="JOB 17:12">वह कहतें है रोशनी तारीकी के नज़दीक है।<verse eid="JOB 17:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 17:13"/>अगर में उम्मीद करूँ कि पाताल मेरा घर है,</para>
  <para style="q" vid="JOB 17:13">अगर मैंने अँधेरे में अपना बिछौना बिछा लिया है।<verse eid="JOB 17:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 17:14"/>अगर मैंने सड़ाहट से कहा है कि तू मेरा बाप है,</para>
  <para style="q" vid="JOB 17:14">और कीड़े से कि तू मेरी माँ और बहन है<verse eid="JOB 17:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 17:15"/>तोमेरी उम्मीद कहाँ रही,</para>
  <para style="q" vid="JOB 17:15">और जो मेरी उम्मीद है, उसे कौन देखेगा<verse eid="JOB 17:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 17:16"/>वह पाताल के फाटकों तक नीचे उतर जाएगी</para>
  <para style="q" vid="JOB 17:16">जब हम मिलकर ख़ाक में आराम पाएँगे।”<verse eid="JOB 17:16"/></para>
  <chapter eid="JOB 17"/>
  <chapter number="18" style="c" sid="JOB 18"/>
  <para style="s">बिलदद का अय्यूब को दुसरा जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 18:1"/>तब बिलदद शूखी ने जवाब दिया,<verse eid="JOB 18:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 18:2"/>तुम कब तक लफ़्ज़ों की जुस्तुजू में रहोगे</para>
  <para style="q" vid="JOB 18:2">ग़ौर कर लो फ़िर हम बोलेंगे<verse eid="JOB 18:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 18:3"/>हम क्यूँ जानवरों की तरह समझे जाते हैं,</para>
  <para style="q" vid="JOB 18:3">और तुम्हारी नज़र में नापाक ठहरे हैं।<verse eid="JOB 18:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 18:4"/>तू जो अपने क़हर में अपने को फाड़ता है</para>
  <para style="q" vid="JOB 18:4">तो क्या ज़मीन तेरी वजह से उजड़ जाएगी</para>
  <para style="q" vid="JOB 18:4">या चट्टान अपनी जगह से हटा दी जाएगी<verse eid="JOB 18:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 18:5"/>बल्कि शरीर का चराग़ गुल कर दिया जाएगा</para>
  <para style="q" vid="JOB 18:5">और उसकी आग का शो'ला बे नूर हो जाएगा<verse eid="JOB 18:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 18:6"/>रोशनी उसके ख़ेमे में तरीकी हो जाएगी</para>
  <para style="q" vid="JOB 18:6">और जो चराग ऊसके उपर है, बुझा दिया जाएगा<verse eid="JOB 18:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 18:7"/>उसकी क़ुव्वत के क़दम छोटे किए जाएँगे</para>
  <para style="q" vid="JOB 18:7">और उसी की मसलहत उसे नेचे गिराएगी।<verse eid="JOB 18:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 18:8"/>क्यूँकि वह अपने ही पाँव से जाल में फँसता है</para>
  <para style="q" vid="JOB 18:8">और फँदों पर चलता है<verse eid="JOB 18:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 18:9"/>दाम उसकी एड़ी को पकड़ेगा,</para>
  <para style="q" vid="JOB 18:9">और जाल उसको फँसा लेगा।<verse eid="JOB 18:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 18:10"/>कमन्द उसके लिए ज़मीन में छिपा दी गई है,</para>
  <para style="q" vid="JOB 18:10">और फंदा उसके लिए रास्ते में रख्खा गया है।<verse eid="JOB 18:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 18:11"/>दहशत नाक चीज़ें हर तरफ़ से उसे डराएँगी,</para>
  <para style="q" vid="JOB 18:11">और उसके दर पे होकर उसे भगाएंगी।<verse eid="JOB 18:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 18:12"/>उसका ज़ोर भूक का मारा होगा</para>
  <para style="q" vid="JOB 18:12">और आफ़त उसके शामिल — ए — हाल रहेगी।<verse eid="JOB 18:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 18:13"/>वह उसके जिस्म के आ'ज़ा को खा जाएगी</para>
  <para style="q" vid="JOB 18:13">बल्कि मौत का पहलौठा उसके आ'ज़ा को चट कर जाएगी।<verse eid="JOB 18:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 18:14"/>वह अपने ख़ेमे से जिस पर उसको भरोसा है उखाड़ दिया जाएगा,</para>
  <para style="q" vid="JOB 18:14">और दहशत के बादशाह के पास पहुंचाया जाएगा।<verse eid="JOB 18:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 18:15"/>और वह जो उसका नहीं, उसके ख़ेमे में बसेगा;</para>
  <para style="q" vid="JOB 18:15">उसके मकान पर गंधक छितराई जाएगी।<verse eid="JOB 18:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 18:16"/>नीचे उसकी जड़ें सुखाई जाएँगी,</para>
  <para style="q" vid="JOB 18:16">और ऊपर उसकी डाली काटी जाएगी।<verse eid="JOB 18:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 18:17"/>उसकी यादगार ज़मीन पर से मिट जाएगी,</para>
  <para style="q" vid="JOB 18:17">और कूचों' में उसका नाम न होगा।<verse eid="JOB 18:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 18:18"/>वह रोशनी से अंधेरे में हँका दिया जाएगा,</para>
  <para style="q" vid="JOB 18:18">और दुनिया से खदेड़ दिया जाएगा।<verse eid="JOB 18:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 18:19"/>उसके लोगों में उसका न कोई बेटा होगा न पोता,</para>
  <para style="q" vid="JOB 18:19">और जहाँ वह टिका हुआ था, वहाँ कोई उसका बाक़ी न रहेगा।<verse eid="JOB 18:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 18:20"/>वह जो पीछे आनेवाले हैं, उसके दिन पर हैरान होंगे,</para>
  <para style="q" vid="JOB 18:20">जैसे वह जो पहले हुए डर गए थे।<verse eid="JOB 18:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 18:21"/>नारास्तों के घर यक़ीनन ऐसे ही हैं,</para>
  <para style="q" vid="JOB 18:21">और जो ख़ुदा को नहीं पहचानता उसकी जगह ऐसी ही है।<verse eid="JOB 18:21"/></para>
  <chapter eid="JOB 18"/>
  <chapter number="19" style="c" sid="JOB 19"/>
  <para style="s">अय्यूब का छठवां जवाब: बिलदद को जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 19:1"/>तब अय्यूब ने जवाब दिया<verse eid="JOB 19:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 19:2"/>तुम कब तक मेरी जान खाते रहोगे,</para>
  <para style="q" vid="JOB 19:2">और बातों से मुझे चूर — चूर करोगे?<verse eid="JOB 19:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 19:3"/>अब दस बार तुम ने मुझे मलामत ही की;</para>
  <para style="q" vid="JOB 19:3">तुम्हें शर्म नहीं आती की तुम मेरे साथ सख़्ती से पेश आते हो।<verse eid="JOB 19:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 19:4"/>और माना कि मुझ से ख़ता हुई;</para>
  <para style="q" vid="JOB 19:4">मेरी ख़ता मेरी ही है।<verse eid="JOB 19:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 19:5"/>अगर तुम मेरे सामने में अपनी बड़ाई करते हो,</para>
  <para style="q" vid="JOB 19:5">और मेरे नंग को मेरे ख़िलाफ़ पेश करते हो;<verse eid="JOB 19:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 19:6"/>तो जान लो कि ख़ुदा ने मुझे पस्त किया,</para>
  <para style="q" vid="JOB 19:6">और अपने जाल से मुझे घेर लिया है।<verse eid="JOB 19:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 19:7"/>देखो, मैं जु़ल्म जु़ल्म पुकारता हूँ, लेकिन मेरी सुनी नहीं जाती।</para>
  <para style="q" vid="JOB 19:7">मैं मदद के लिए दुहाई देता हूँ, लेकिन कोई इन्साफ़ नहीं होता।<verse eid="JOB 19:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 19:8"/>उसने मेरा रास्ता ऐसा शख़्त कर दिया है, कि मैं गुज़र नहीं सकता।</para>
  <para style="q" vid="JOB 19:8">उसने मेरी राहों पर तारीकी को बिठा दिया है।<verse eid="JOB 19:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 19:9"/>उसने मेरी हशमत मुझ से छीन ली,</para>
  <para style="q" vid="JOB 19:9">और मेरे सिर पर से ताज उतार लिया।<verse eid="JOB 19:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 19:10"/>उसने मुझे हर तरफ़ से तोड़कर नीचे गिरा दिया, बस मैं तो हो लिया,</para>
  <para style="q" vid="JOB 19:10">और मेरी उम्मीद को उसने पेड़ की तरह उखाड़ डाला है।<verse eid="JOB 19:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 19:11"/>उसने अपने ग़ज़ब को भी मेरे ख़िलाफ़ भड़काया है,</para>
  <para style="q" vid="JOB 19:11">और वह मुझे अपने मुख़ालिफ़ों में शुमार करता है।<verse eid="JOB 19:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 19:12"/>उसकी फ़ौजें इकट्ठी होकर आती और मेरे ख़िलाफ़ अपनी राह तैयार करती</para>
  <para style="q" vid="JOB 19:12">और मेरे ख़ेमे के चारों तरफ़ ख़ेमा ज़न होती हैं।<verse eid="JOB 19:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 19:13"/>उसने मेरे भाइयों को मुझ से दूर कर दिया है,</para>
  <para style="q" vid="JOB 19:13">और मेरे जान पहचान मुझ से बेगाना हो गए हैं।<verse eid="JOB 19:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 19:14"/>मेरे रिश्तेदार काम न आए,</para>
  <para style="q" vid="JOB 19:14">और मेरे दिली दोस्त मुझे भूल गए हैं।<verse eid="JOB 19:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 19:15"/>मैं अपने घर के रहनेवालों और अपनी लौंडियों की नज़र में अजनबी हूँ।</para>
  <para style="q" vid="JOB 19:15">मैं उनकी निगाह में परदेसी हो गया हूँ।<verse eid="JOB 19:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 19:16"/>मैं अपने नौकर को बुलाता हूँ और वह मुझे जवाब नहीं देता,</para>
  <para style="q" vid="JOB 19:16">अगरचे मैं अपने मुँह से उसकी मिन्नत करता हूँ।<verse eid="JOB 19:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 19:17"/>मेरी साँस मेरी बीवी के लिए मकरूह है,</para>
  <para style="q" vid="JOB 19:17">और मेरी मित्रत मेरी माँ की औलाद “के लिए।<verse eid="JOB 19:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 19:18"/>छोटे बच्चे भी मुझे हक़ीर जानते हैं;</para>
  <para style="q" vid="JOB 19:18">जब मैं खड़ा होता हूँ तो वह मुझ पर आवाज़ कसते हैं।<verse eid="JOB 19:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 19:19"/>मेरे सब हमराज़ दोस्त मुझ से नफ़रत करते हैं</para>
  <para style="q" vid="JOB 19:19">और जिनसे मैं मुहब्बत करता था वह मेरे ख़िलाफ़ हो गए हैं।<verse eid="JOB 19:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 19:20"/>मेरी खाल और मेरा गोश्त मेरी हड्डियों से चिमट गए हैं,</para>
  <para style="q" vid="JOB 19:20">और मैं बाल बाल बच निकला हूँ।<verse eid="JOB 19:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 19:21"/>ऐ मेरे दोस्तो! मुझ पर तरस खाओ, तरस खाओ,</para>
  <para style="q" vid="JOB 19:21">क्यूँकि ख़ुदा का हाथ मुझ पर भारी है!<verse eid="JOB 19:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 19:22"/>तुम क्यूँ ख़ुदा की तरह मुझे सताते हो?</para>
  <para style="q" vid="JOB 19:22">और मेरे गोश्त पर कना'अत नहीं करते?<verse eid="JOB 19:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 19:23"/>काश कि मेरी बातें अब लिख ली जातीं,</para>
  <para style="q" vid="JOB 19:23">काश कि वह किसी किताब में लिखी होतीं;<verse eid="JOB 19:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 19:24"/>काश कि वह लोहे के क़लम और सीसे से,</para>
  <para style="q" vid="JOB 19:24">हमेशा के लिए चट्टान पर खोद दी जातीं।<verse eid="JOB 19:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 19:25"/>लेकिन मैं जानता हूँ कि मेरा छुड़ाने वाला ज़िन्दा है।</para>
  <para style="q" vid="JOB 19:25">और आ़खिर कार ज़मीन पर खड़ा होगा।<verse eid="JOB 19:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 19:26"/>और अपनी खाल के इस तरह बर्बाद हो जाने के बाद भी,</para>
  <para style="q" vid="JOB 19:26">मैं अपने इस जिस्म में से ख़ुदा को देखूँगा।<verse eid="JOB 19:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 19:27"/>जिसे मैं खुद देखूँगा, और मेरी ही आँखें देखेंगी न कि ग़ैर की;</para>
  <para style="q" vid="JOB 19:27">मेरे गुर्दे मेरे अंदर ही फ़ना हो गए हैं।<verse eid="JOB 19:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 19:28"/>अगर तुम कहो हम उसे कैसा — कैसा सताएँगे;</para>
  <para style="q" vid="JOB 19:28">हालाँकि असली बात मुझ में पाई गई है।<verse eid="JOB 19:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 19:29"/>तो तुम तलवार से डरो,</para>
  <para style="q" vid="JOB 19:29">क्यूँकि क़हर तलवार की सज़ाओं को लाता है</para>
  <para style="q" vid="JOB 19:29">ताकि तुम जान लो कि इन्साफ़ होगा।”<verse eid="JOB 19:29"/></para>
  <chapter eid="JOB 19"/>
  <chapter number="20" style="c" sid="JOB 20"/>
  <para style="s">जूफ़र का दुसरा जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 20:1"/>तब जूफ़र नामाती ने जवाब दिया।<verse eid="JOB 20:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 20:2"/>इसीलिए मेरे ख़्याल मुझे जवाब सिखाते हैं,</para>
  <para style="q" vid="JOB 20:2">उस जल्दबाज़ी की वजह से जो मुझ में है।<verse eid="JOB 20:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 20:3"/>मैंने वह झिड़की सुन ली जो मुझे शर्मिन्दा करती है,</para>
  <para style="q" vid="JOB 20:3">और मेरी 'अक़्ल की रूह मुझे जवाब देती है।<verse eid="JOB 20:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 20:4"/>क्या तू पुराने ज़माने की यह बात नहीं जानता,</para>
  <para style="q" vid="JOB 20:4">जब से इंसान ज़मीन पर बसाया गया,<verse eid="JOB 20:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 20:5"/>कि शरीरों की फ़तह चंद रोज़ा है,</para>
  <para style="q" vid="JOB 20:5">और बेदीनों की ख़ुशी दम भर की है?<verse eid="JOB 20:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 20:6"/>चाहे उसका जाह — ओ — जलाल आसमान तक बुलन्द हो जाए,</para>
  <para style="q" vid="JOB 20:6">और उसका सिर बादलों तक पहुँचे।<verse eid="JOB 20:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 20:7"/>तोभी वह अपने ही फुज़ले की तरह हमेशा के लिए बर्बाद हो जाएगा;</para>
  <para style="q" vid="JOB 20:7">जिन्होंने उसे देखा है कहेंगे, वह कहाँ है?<verse eid="JOB 20:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 20:8"/>वह ख़्वाब की तरह उड़ जाएगा और फिर न मिलेगा,</para>
  <para style="q" vid="JOB 20:8">जो वह रात को रोये की तरह दूर कर दिया जाएगा।<verse eid="JOB 20:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 20:9"/>जिस आँख ने उसे देखा, वह उसे फिर न देखेगी;</para>
  <para style="q" vid="JOB 20:9">न उसका मकान उसे फिर कभी देखेगा।<verse eid="JOB 20:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 20:10"/>उसकी औलाद ग़रीबों की ख़ुशामद करेगी,</para>
  <para style="q" vid="JOB 20:10">और उसी के हाथ उसकी दौलत को वापस देंगे।<verse eid="JOB 20:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 20:11"/>उसकी हड्डियाँ उसकी जवानी से पुर हैं,</para>
  <para style="q" vid="JOB 20:11">लेकिन वह उसके साथ ख़ाक में मिल जाएँगी।<verse eid="JOB 20:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 20:12"/>“चाहे शरारत उसको मीठी लगे,</para>
  <para style="q" vid="JOB 20:12">चाहे वह उसे अपनी ज़बान के नीचे छिपाए।<verse eid="JOB 20:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 20:13"/>चाहे वह उसे बचा रख्खे और न छोड़े,</para>
  <para style="q" vid="JOB 20:13">बल्कि उसे अपने मुँह के अंदर दबा रख्खे,<verse eid="JOB 20:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 20:14"/>तोभी उसका खाना उसकी अंतड़ियों में बदल गया है;</para>
  <para style="q" vid="JOB 20:14">वह उसके अंदर अज़दहा का ज़हर है।<verse eid="JOB 20:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 20:15"/>वह दौलत को निगल गया है, लेकिन वह उसे फिर उगलेगा;</para>
  <para style="q" vid="JOB 20:15">ख़ुदा उसे उसके पेट से बाहर निकाल देगा।<verse eid="JOB 20:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 20:16"/>वह अज़दहा का ज़हर चूसेगा;</para>
  <para style="q" vid="JOB 20:16">अज़दहा की ज़बान उसे मार डालेगी।<verse eid="JOB 20:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 20:17"/>वह दरियाओं को देखने न पाएगा,</para>
  <para style="q" vid="JOB 20:17">या'नी शहद और मख्खन की बहती नदियों को।<verse eid="JOB 20:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 20:18"/>जिस चीज़ के लिए उसने मशक़्क़त खींची, उसे वह वापस करेगा और निगलेगा नहीं;</para>
  <para style="q" vid="JOB 20:18">जो माल उसने जमा' किया उसके मुताबिक़ वह ख़ुशी न करेगा।<verse eid="JOB 20:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 20:19"/>क्यूँकि उसने ग़रीबों पर जु़ल्म किया और उन्हें छोड़ दिया,</para>
  <para style="q" vid="JOB 20:19">उसने ज़बरदस्ती घर छीना लेकिन वह उसे बताने न पाएगा।<verse eid="JOB 20:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 20:20"/>इस वजह से कि वह अपने बातिन में आसूदगी से वाक़िफ़ न हुआ,</para>
  <para style="q" vid="JOB 20:20">वह अपनी दिलपसंद चीज़ों में से कुछ नहीं बचाएगा।<verse eid="JOB 20:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 20:21"/>कोई चीज़ ऐसी बाक़ी न रही जिसको उसने निगला न हो।</para>
  <para style="q" vid="JOB 20:21">इसलिए उसकी इक़बालमन्दी क़ाईम न रहेगी।<verse eid="JOB 20:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 20:22"/>अपनी अमीरी में भी वह तंगी में होगा;</para>
  <para style="q" vid="JOB 20:22">हर दुखियारे का हाथ उस पर पड़ेगा।<verse eid="JOB 20:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 20:23"/>जब वह अपना पेट भरने पर होगा तो ख़ुदा अपना क़हर — ए — शदीद उस पर नाज़िल करेगा,</para>
  <para style="q" vid="JOB 20:23">और जब वह खाता होगा तब यह उसपर बरसेगा।<verse eid="JOB 20:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 20:24"/>वह लोहे के हथियार से भागेगा,</para>
  <para style="q" vid="JOB 20:24">लेकिन पीतल की कमान उसे छेद डालेगी।<verse eid="JOB 20:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 20:25"/>वह तीर निकालेगा और वह उसके जिस्म से बाहर आएगा,</para>
  <para style="q" vid="JOB 20:25">उसकी चमकती नोक उसके पित्ते से निकलेगी;</para>
  <para style="q" vid="JOB 20:25">दहशत उस पर छाई हुई है।<verse eid="JOB 20:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 20:26"/>सारी तारीकी उसके ख़ज़ानों के लिए रख्खी हुई है।</para>
  <para style="q" vid="JOB 20:26">वह आग जो किसी इंसान की सुलगाई हुई नहीं,</para>
  <para style="q" vid="JOB 20:26">उसे खा जाएगी। वह उसे जो उसके ख़ेमे में बचा हुआ होगा, भस्म कर देगी।<verse eid="JOB 20:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 20:27"/>आसमान उसके गुनाह को ज़ाहिर कर देगा,</para>
  <para style="q" vid="JOB 20:27">और ज़मीन उसके ख़िलाफ़ खड़ी हो जाएगी।<verse eid="JOB 20:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 20:28"/>उसके घर की बढ़ती जाती रहेगी,</para>
  <para style="q" vid="JOB 20:28">ख़ुदा के ग़ज़ब के दिन उसका माल जाता रहेगा।<verse eid="JOB 20:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 20:29"/>ख़ुदा की तरफ़ से शरीर आदमी का हिस्सा,</para>
  <para style="q" vid="JOB 20:29">और उसके लिए ख़ुदा की मुक़र्रर की हुई मीरास यही है।”<verse eid="JOB 20:29"/></para>
  <chapter eid="JOB 20"/>
  <chapter number="21" style="c" sid="JOB 21"/>
  <para style="s">अय्यूब का सातवां बयान: ज़ूफर को जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 21:1"/>तब अय्यूब ने जवाब दिया,<verse eid="JOB 21:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 21:2"/>ग़ौर से मेरी बात सुनो,</para>
  <para style="q" vid="JOB 21:2">और यही तुम्हारा तसल्ली देना हो।<verse eid="JOB 21:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 21:3"/>मुझे इजाज़त दो तो मैं भी कुछ कहूँगा,</para>
  <para style="q" vid="JOB 21:3">और जब मैं कह चुकूँ तो ठठ्ठा मारलेना।<verse eid="JOB 21:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 21:4"/>लेकिन मैं, क्या मेरी फ़रियाद इंसान से है?</para>
  <para style="q" vid="JOB 21:4">फिर मैं बेसब्री क्यूँ न करूँ?<verse eid="JOB 21:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 21:5"/>मुझ पर ग़ौर करो और मुत'अजीब हो,</para>
  <para style="q" vid="JOB 21:5">और अपना हाथ अपने मुँह पर रखो।<verse eid="JOB 21:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 21:6"/>जब मैं याद करता हूँ तो घबरा जाता हूँ,</para>
  <para style="q" vid="JOB 21:6">और मेरा जिस्म थर्रा उठता है।<verse eid="JOB 21:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 21:7"/>शरीर क्यूँ जीते रहते, उम्र रसीदा होते,</para>
  <para style="q" vid="JOB 21:7">बल्कि कु़व्वत में ज़बरदस्त होते हैं?<verse eid="JOB 21:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 21:8"/>उनकी औलाद उनके साथ उनके देखते देखते,</para>
  <para style="q" vid="JOB 21:8">और उनकी नसल उनकी आँखों के सामने क़ाईम हो जाती है।<verse eid="JOB 21:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 21:9"/>उनके घर डर से महफ़ूज़ हैं,</para>
  <para style="q" vid="JOB 21:9">और ख़ुदा की छड़ी उन पर नहीं है।<verse eid="JOB 21:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 21:10"/>उनका साँड बरदार कर देता है और चूकता नहीं,</para>
  <para style="q" vid="JOB 21:10">उनकी गाय ब्याती है और अपना बच्चा नहीं गिराती।<verse eid="JOB 21:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 21:11"/>वह अपने छोटे छोटे बच्चों को रेवड़ की तरह बाहर भेजते हैं,</para>
  <para style="q" vid="JOB 21:11">और उनकी औलाद नाचती है।<verse eid="JOB 21:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 21:12"/>वह ख़जरी और सितार के ताल पर गाते,</para>
  <para style="q" vid="JOB 21:12">और बाँसली की आवाज़ से ख़ुश होते हैं।<verse eid="JOB 21:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 21:13"/>वह ख़ुशहाली में अपने दिन काटते,</para>
  <para style="q" vid="JOB 21:13">और दम के दम में पाताल में उतर जाते हैं।<verse eid="JOB 21:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 21:14"/>हालाँकि उन्होंने ख़ुदा से कहा था, कि 'हमारे पास से चला जा;</para>
  <para style="q" vid="JOB 21:14">क्यूँकि हम तेरी राहों के 'इल्म के ख़्वाहिशमन्द नहीं।<verse eid="JOB 21:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 21:15"/>क़ादिर — ए — मुतलक़ है क्या कि हम उसकी इबादत करें?</para>
  <para style="q" vid="JOB 21:15">और अगर हम उससे दुआ करें तो हमें क्या फ़ायदा होगा?<verse eid="JOB 21:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 21:16"/>देखो, उनकी इक़बालमन्दी उनके हाथ में नहीं है।</para>
  <para style="q" vid="JOB 21:16">शरीरों की मशवरत मुझ से दूर है।<verse eid="JOB 21:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 21:17"/>कितनी बार शरीरों का चराग़ बुझ जाता है?</para>
  <para style="q" vid="JOB 21:17">और उनकी आफ़त उन पर आ पड़ती है?</para>
  <para style="q" vid="JOB 21:17">और ख़ुदा अपने ग़ज़ब में उन्हें ग़म पर ग़म देता है?<verse eid="JOB 21:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 21:18"/>और वह ऐसे हैं जैसे हवा के आगे डंठल,</para>
  <para style="q" vid="JOB 21:18">और जैसे भूसा जिसे आँधी उड़ा ले जाती है?<verse eid="JOB 21:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 21:19"/>'ख़ुदा उसका गुनाह उसके बच्चों के लिए रख छोड़ता है,</para>
  <para style="q" vid="JOB 21:19">वह उसका बदला उसी को दे ताकि वह जान ले।<verse eid="JOB 21:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 21:20"/>उसकी हलाकत को उसी की आँखें देखें,</para>
  <para style="q" vid="JOB 21:20">और वह क़ादिर — ए — मुतलक के ग़ज़ब में से पिए।<verse eid="JOB 21:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 21:21"/>क्यूँकि अपने बाद उसको अपने घराने से क्या ख़ुशी है,</para>
  <para style="q" vid="JOB 21:21">जब उसके महीनों का सिलसिला ही काट डाला गया?<verse eid="JOB 21:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 21:22"/>क्या कोई ख़ुदा को 'इल्म सिखाएगा?</para>
  <para style="q" vid="JOB 21:22">जिस हाल की वह सरफ़राज़ों की 'अदालत करता है।<verse eid="JOB 21:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 21:23"/>कोई तो अपनी पूरी ताक़त में,</para>
  <para style="q" vid="JOB 21:23">चैन और सुख से रहता हुआ मर जाता है।<verse eid="JOB 21:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 21:24"/>उसकी दोहिनियाँ दूध से भरी हैं,</para>
  <para style="q" vid="JOB 21:24">और उसकी हड्डियों का गूदा तर है;<verse eid="JOB 21:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 21:25"/>और कोई अपने जी में कुढ़ कुढ़ कर मरता है,</para>
  <para style="q" vid="JOB 21:25">और कभी सुख नहीं पाता।<verse eid="JOB 21:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 21:26"/>वह दोनों मिट्टी में यकसाँ पड़ जाते हैं,</para>
  <para style="q" vid="JOB 21:26">और कीड़े उन्हें ढाँक लेते हैं।<verse eid="JOB 21:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 21:27"/>देखो, मैं तुम्हारे ख़यालों को जानता हूँ,</para>
  <para style="q" vid="JOB 21:27">और उन मंसूबों को भी जो तुम बे इन्साफ़ी से मेरे ख़िलाफ़ बाँधते हो।<verse eid="JOB 21:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 21:28"/>क्यूँकि तुम कहते हो, 'अमीर का घर कहाँ रहा?</para>
  <para style="q" vid="JOB 21:28">और वह ख़ेमा कहाँ है जिसमें शरीर बसते थे?<verse eid="JOB 21:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 21:29"/>क्या तुम ने रास्ता चलने वालों से कभी नहीं पूछा?</para>
  <para style="q" vid="JOB 21:29">और उनके निशान — आत नहीं पहचानते<verse eid="JOB 21:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 21:30"/>कि शरीर आफ़त के दिन के लिए रख्खा जाता है,</para>
  <para style="q" vid="JOB 21:30">और ग़ज़ब के दिन तक पहुँचाया जाता है?<verse eid="JOB 21:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 21:31"/>कौन उसकी राह को उसके मुँह पर बयान करेगा?</para>
  <para style="q" vid="JOB 21:31">और उसके किए का बदला कौन उसे देगा?<verse eid="JOB 21:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 21:32"/>तोभी वह क़ब्र में पहुँचाया जाएगा,</para>
  <para style="q" vid="JOB 21:32">और उसकी क़ब्र पर पहरा दिया जाएगा।<verse eid="JOB 21:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 21:33"/>वादी के ढेले उसे पसंद हैं;</para>
  <para style="q" vid="JOB 21:33">और सब लोग उसके पीछे चले जाएँगे,</para>
  <para style="q" vid="JOB 21:33">जैसे उससे पहले बेशुमार लोग गए।<verse eid="JOB 21:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 21:34"/>इसलिए तुम क्यूँ मुझे झूठी तसल्ली देते हो,</para>
  <para style="q" vid="JOB 21:34">जिस हाल कि तुम्हारी बातों में झूँठ ही झूँठ है।<verse eid="JOB 21:34"/></para>
  <chapter eid="JOB 21"/>
  <chapter number="22" style="c" sid="JOB 22"/>
  <para style="s">इलिफ़ज़ को तिसरा जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 22:1"/>तब इलिफ़ज़ तेमानी ने जवाब दिया,<verse eid="JOB 22:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 22:2"/>क्या कोई इंसान ख़ुदा के काम आ सकता है?</para>
  <para style="q" vid="JOB 22:2">यक़ीनन 'अक़्लमन्द अपने ही काम का है।<verse eid="JOB 22:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 22:3"/>क्या तेरे सादिक़ होने से क़ादिर — ए — मुतलक को कोई ख़ुशी है?</para>
  <para style="q" vid="JOB 22:3">या इस बात से कि तू अपनी राहों को कामिल करता है उसे कुछ फ़ायदा है?<verse eid="JOB 22:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 22:4"/>क्या इसलिए कि तुझे उसका ख़ौफ़ है,</para>
  <para style="q" vid="JOB 22:4">वह तुझे झिड़कता और तुझे 'अदालत में लाता है?<verse eid="JOB 22:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 22:5"/>क्या तेरी शरारत बड़ी नहीं?</para>
  <para style="q" vid="JOB 22:5">क्या तेरी बदकारियों की कोई हद है?<verse eid="JOB 22:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 22:6"/>क्यूँकि तू ने अपने भाई की चीज़ें बे वजह गिरवी रख्खी,</para>
  <para style="q" vid="JOB 22:6">नंगों का लिबास उतार लिया।<verse eid="JOB 22:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 22:7"/>तूने थके माँदों को पानी न पिलाया,</para>
  <para style="q" vid="JOB 22:7">और भूखों से रोटी को रोक रखा।<verse eid="JOB 22:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 22:8"/>लेकिन ज़बरदस्त आदमी ज़मीन का मालिक बना,</para>
  <para style="q" vid="JOB 22:8">और 'इज़्ज़तदार आदमी उसमें बसा।<verse eid="JOB 22:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 22:9"/>तू ने बेवाओं को ख़ाली चलता किया,</para>
  <para style="q" vid="JOB 22:9">और यतीमों के बाज़ू तोड़े गए।<verse eid="JOB 22:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 22:10"/>इसलिए फंदे तेरी चारों तरफ़ हैं,</para>
  <para style="q" vid="JOB 22:10">और नागहानी ख़ौफ़ तुझे सताता है।<verse eid="JOB 22:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 22:11"/>या ऐसी तारीकी कि तू देख नहीं सकता,</para>
  <para style="q" vid="JOB 22:11">और पानी की बाढ़ तुझे छिपाए लेती है।<verse eid="JOB 22:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 22:12"/>क्या आसमान की बुलन्दी में ख़ुदा नहीं?</para>
  <para style="q" vid="JOB 22:12">और तारों की बुलन्दी को देख वह कैसे ऊँचे हैं।<verse eid="JOB 22:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 22:13"/>फिर तू कहता है, कि 'ख़ुदा क्या जानता है?</para>
  <para style="q" vid="JOB 22:13">क्या वह गहरी तारीकी में से 'अदालत करेगा?<verse eid="JOB 22:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 22:14"/>पानी से भरे हुए बादल उसके लिए पर्दा हैं कि वह देख नहीं सकता;</para>
  <para style="q" vid="JOB 22:14">वह आसमान के दाइरे में सैर करता फिरता है।<verse eid="JOB 22:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 22:15"/>क्या तू उसी पुरानी राह पर चलता रहेगा,</para>
  <para style="q" vid="JOB 22:15">जिस पर शरीर लोग चले हैं?<verse eid="JOB 22:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 22:16"/>जो अपने वक़्त से पहले उठा लिए गए,</para>
  <para style="q" vid="JOB 22:16">और सैलाब उनकी बुनियाद को बहा ले गया।<verse eid="JOB 22:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 22:17"/>जो ख़ुदा से कहते थे, 'हमारे पास से चला जा,</para>
  <para style="q" vid="JOB 22:17">'और यह कि, 'क़ादिर — ए — मुतलक़ हमारे लिए कर क्या सकता है?'<verse eid="JOB 22:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 22:18"/>तोभी उसने उनके घरों को अच्छी अच्छी चीज़ों से भर दिया —</para>
  <para style="q" vid="JOB 22:18">लेकिन शरीरों की मशवरत मुझ से दूर है।<verse eid="JOB 22:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 22:19"/>सादिक़ यह देख कर ख़ुश होते हैं,</para>
  <para style="q" vid="JOB 22:19">और बे गुनाह उनकी हँसी उड़ाते हैं।<verse eid="JOB 22:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 22:20"/>और कहते हैं, कि यक़ीनन वह जो हमारे ख़िलाफ़ उठे थे कट गए,</para>
  <para style="q" vid="JOB 22:20">और जो उनमें से बाक़ी रह गए थे, उनको आग ने भस्म कर दिया है।<verse eid="JOB 22:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 22:21"/>“उससे मिला रह, तो सलामत रहेगा;</para>
  <para style="q" vid="JOB 22:21">और इससे तेरा भला होगा।<verse eid="JOB 22:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 22:22"/>मैं तेरी मिन्नत करता हूँ,</para>
  <para style="q" vid="JOB 22:22">कि शरी'अत को उसी की ज़बानी क़ुबूल कर और उसकी बातों को अपने दिल में रख ले।<verse eid="JOB 22:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 22:23"/>अगर तू क़ादिर — ए — मुतलक़ की तरफ़ फिरे तो बहाल किया जाएगा।</para>
  <para style="q" vid="JOB 22:23">बशर्ते कि तू नारास्ती को अपने ख़ेमों से दूर कर दे।<verse eid="JOB 22:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 22:24"/>तू अपने ख़ज़ाने' को मिट्टी में,</para>
  <para style="q" vid="JOB 22:24">और ओफ़ीर के सोने को नदियों के पत्थरों में डाल दे,<verse eid="JOB 22:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 22:25"/>तब क़ादिर — ए — मुतलक़ तेरा ख़ज़ाना,</para>
  <para style="q" vid="JOB 22:25">और तेरे लिए बेश क़ीमत चाँदी होगा।<verse eid="JOB 22:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 22:26"/>क्यूँकि तब ही तू क़ादिर — ए — मुतलक़ में मसरूर रहेगा,</para>
  <para style="q" vid="JOB 22:26">और ख़ुदा की तरफ़ अपना मुँह उठाएगा।<verse eid="JOB 22:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 22:27"/>तू उससे दुआ करेगा, वह तेरी सुनेगा;</para>
  <para style="q" vid="JOB 22:27">और तू अपनी मिन्नतें पूरी करेगा।<verse eid="JOB 22:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 22:28"/>जिस बात को तू कहेगा,</para>
  <para style="q" vid="JOB 22:28">वह तेरे लिए हो जाएगी और नूर तेरी राहों को रोशन करेगा।<verse eid="JOB 22:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 22:29"/>जब वह पस्त करेंगे, तू कहेगा, 'बुलन्दी होगी।</para>
  <para style="q" vid="JOB 22:29">और वह हलीम आदमी को बचाएगा।<verse eid="JOB 22:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 22:30"/>वह उसको भी छुड़ा लेगा, जो बेगुनाह नहीं है;</para>
  <para style="q" vid="JOB 22:30">हाँ वह तेरे हाथों की पाकीज़गी की वजह से छुड़ाया जाएगा।”<verse eid="JOB 22:30"/></para>
  <chapter eid="JOB 22"/>
  <chapter number="23" style="c" sid="JOB 23"/>
  <para style="s">अय्यूब का आठवां बयान: इलिफ़स को जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 23:1"/>तब अय्यूब ने जवाब दिया,<verse eid="JOB 23:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 23:2"/>मेरी शिकायत आज भी तल्ख़ है;</para>
  <para style="q" vid="JOB 23:2">मेरी मार मेरे कराहने से भी भारी है।<verse eid="JOB 23:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 23:3"/>काश कि मुझे मा'लूम होता कि वह मुझे कहाँ मिल सकता है</para>
  <para style="q" vid="JOB 23:3">ताकि मैं ऐन उसकी मसनद तक पहुँच जाता।<verse eid="JOB 23:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 23:4"/>मैं अपना मु'आमिला उसके सामने पेश करता,</para>
  <para style="q" vid="JOB 23:4">और अपना मुँह दलीलों से भर लेता।<verse eid="JOB 23:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 23:5"/>मैं उन लफ़्ज़ों को जान लेता जिनमें वह मुझे जवाब देता</para>
  <para style="q" vid="JOB 23:5">और जो कुछ वह मुझ से कहता मैं समझ लेता।<verse eid="JOB 23:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 23:6"/>क्या वह अपनी क़ुदरत की 'अज़मत में मुझ से लड़ता?</para>
  <para style="q" vid="JOB 23:6">नहीं, बल्कि वह मेरी तरफ़ तवज्जुह करता।<verse eid="JOB 23:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 23:7"/>रास्तबाज़ वहाँ उसके साथ बहस कर सकते,</para>
  <para style="q" vid="JOB 23:7">यूँ मैं अपने मुन्सिफ़ के हाथ से हमेशा के लिए रिहाई पाता।<verse eid="JOB 23:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 23:8"/>देखो, मैं आगे जाता हूँ लेकिन वह वहाँ नहीं,</para>
  <para style="q" vid="JOB 23:8">और पीछे हटता हूँ लेकिन मैं उसे देख नहीं सकता।<verse eid="JOB 23:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 23:9"/>बाएँ हाथ फिरता हूँ जब वह काम करता है, लेकिन वह मुझे दिखाई नहीं देता;</para>
  <para style="q" vid="JOB 23:9">वह दहने हाथ की तरफ़ छिप जाता है, ऐसा कि मैं उसे देख नहीं सकता।<verse eid="JOB 23:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 23:10"/>लेकिन वह उस रास्ते को जिस पर मैं चलता हूँ जानता है;</para>
  <para style="q" vid="JOB 23:10">जब वह मुझे पालेगा तो मैं सोने के तरह निकल आऊँगा।<verse eid="JOB 23:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 23:11"/>मेरा पाँव उसके क़दमों से लगा रहा है।</para>
  <para style="q" vid="JOB 23:11">मैं उसके रास्ते पर चलता रहा हूँ और नाफ़रमान नहीं हुआ।<verse eid="JOB 23:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 23:12"/>मैं उसके लबों के हुक्म से हटा नहीं;</para>
  <para style="q" vid="JOB 23:12">मैंने उसके मुँह की बातों को अपनी ज़रूरी ख़ुराक से भी ज़्यादा ज़ख़ीरा किया।<verse eid="JOB 23:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 23:13"/>लेकिन वह एक ख़याल में रहता है,</para>
  <para style="q" vid="JOB 23:13">और कौन उसको फिरा सकता है?</para>
  <para style="q" vid="JOB 23:13">और जो कुछ उसका जी चाहता है करता है।<verse eid="JOB 23:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 23:14"/>क्यूँकि जो कुछ मेरे लिए मुक़र्रर है,</para>
  <para style="q" vid="JOB 23:14">वह पूरा करता है;</para>
  <para style="q" vid="JOB 23:14">और बहुत सी ऐसी बातें उसके हाथ में हैं।<verse eid="JOB 23:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 23:15"/>इसलिए मैं उसके सामने घबरा जाता हूँ,</para>
  <para style="q" vid="JOB 23:15">मैं जब सोचता हूँ तो उससे डर जाता हूँ।<verse eid="JOB 23:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 23:16"/>क्यूँकि ख़ुदा ने मेरे दिल को बूदा कर डाला है,</para>
  <para style="q" vid="JOB 23:16">और क़ादिर — ए — मुतलक़ ने मुझ को घबरा दिया है।<verse eid="JOB 23:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 23:17"/>इसलिए कि मैं इस ज़ुल्मत से पहले काट डाला न गया</para>
  <para style="q" vid="JOB 23:17">और उसने बड़ी तारीकी को मेरे सामने से न छिपाया।<verse eid="JOB 23:17"/></para>
  <chapter eid="JOB 23"/>
  <chapter number="24" style="c" sid="JOB 24"/>
  <para style="s">अय्यूब का पूछना कि बदी करने वालों को सज़ा क्यों नही मिलती</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 24:1"/>“क़ादिर — ए — मुतलक़ ने वक़्त क्यूँ नहीं ठहराए,</para>
  <para style="q" vid="JOB 24:1">और जो उसे जानते हैं वह उसके दिनों को क्यूँ नहीं देखते?<verse eid="JOB 24:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 24:2"/>ऐसे लोग भी हैं जो ज़मीन की हदों को सरका देते हैं,</para>
  <para style="q" vid="JOB 24:2">वह रेवड़ों को ज़बरदस्ती ले जाते और उन्हें चराते हैं।<verse eid="JOB 24:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 24:3"/>वह यतीम के गधे को हाँक ले जाते हैं;</para>
  <para style="q" vid="JOB 24:3">वह बेवा के बैल को गिरा लेते हैं।<verse eid="JOB 24:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 24:4"/>वह मोहताज को रास्ते से हटा देते हैं,</para>
  <para style="q" vid="JOB 24:4">ज़मीन के ग़रीब इकट्ठे छिपते हैं।<verse eid="JOB 24:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 24:5"/>देखो, वह वीरान के गधों की तरह अपने काम को जाते</para>
  <para style="q" vid="JOB 24:5">और मशक़्क़त उठाकर' ख़ुराक ढूँडते हैं।</para>
  <para style="q" vid="JOB 24:5">वीरान उनके बच्चों के लिए ख़ुराक बहम पहुँचाता है।<verse eid="JOB 24:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 24:6"/>वह खेत में अपना चारा काटते हैं,</para>
  <para style="q" vid="JOB 24:6">और शरीरों के अंगूर की खू़शा चीनी करते हैं।<verse eid="JOB 24:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 24:7"/>वह सारी रात बे कपड़े नंगे पड़े रहते हैं,</para>
  <para style="q" vid="JOB 24:7">और जाड़ों में उनके पास कोई ओढ़ना नहीं होता।<verse eid="JOB 24:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 24:8"/>वह पहाड़ों की बारिश से भीगे रहते हैं,</para>
  <para style="q" vid="JOB 24:8">और किसी आड़ के न होने से चट्टान से लिपट जाते हैं।<verse eid="JOB 24:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 24:9"/>ऐसे लोग भी हैं जो यतीम को छाती पर से हटा लेते हैं</para>
  <para style="q" vid="JOB 24:9">और ग़रीबों से गिरवी लेते हैं।<verse eid="JOB 24:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 24:10"/>इसलिए वह बेकपड़े नंगे फिरते,</para>
  <para style="q" vid="JOB 24:10">और भूक के मारे पौले ढोते हैं।<verse eid="JOB 24:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 24:11"/>वह इन लोगों के अहातों में तेल निकालते हैं।</para>
  <para style="q" vid="JOB 24:11">वह उनके कुण्डों में अंगूर रौदते और प्यासे रहते हैं।<verse eid="JOB 24:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 24:12"/>आबाद शहर में से निकल कर लोग कराहते हैं,</para>
  <para style="q" vid="JOB 24:12">और ज़ख्मियों की जान फ़रियाद करती है।</para>
  <para style="q" vid="JOB 24:12">तोभी ख़ुदा इस हिमाक़त' का ख़्याल नहीं करता।<verse eid="JOB 24:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 24:13"/>“यह उनमें से हैं जो नूर से बग़ावत करते हैं;</para>
  <para style="q" vid="JOB 24:13">वह उसकी राहों को नहीं जानते,</para>
  <para style="q" vid="JOB 24:13">न उसके रास्तों पर क़ाईम रहते हैं।<verse eid="JOB 24:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 24:14"/>खू़नी रोशनी होते ही उठता है।</para>
  <para style="q" vid="JOB 24:14">वह ग़रीबों और मोहताजों को मारडालता है,</para>
  <para style="q" vid="JOB 24:14">और रात को वह चोर की तरह है।<verse eid="JOB 24:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 24:15"/>ज़ानी की आँख भी शाम की मुन्तज़िर रहती है।</para>
  <para style="q" vid="JOB 24:15">वह कहता है किसी की नज़र मुझ पर न पड़ेगी,</para>
  <para style="q" vid="JOB 24:15">और वह अपना मुँह ढाँक लेता है।<verse eid="JOB 24:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 24:16"/>अंधेरे में वह घरों में सेंध मारते हैं,</para>
  <para style="q" vid="JOB 24:16">वह दिन के वक़्त छिपे रहते हैं;</para>
  <para style="q" vid="JOB 24:16">वह नूर को नहीं जानते।<verse eid="JOB 24:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 24:17"/>क्यूँकि सुबह उन लोगों के लिए ऐसी है</para>
  <para style="q" vid="JOB 24:17">जैसे मौत का साया इसलिए कि उन्हें मौत के साये की दहशत मा'लूम है।<verse eid="JOB 24:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 24:18"/>वह पानी की सतह पर तेज़ रफ़्तार हैं,</para>
  <para style="q" vid="JOB 24:18">ज़मीन पर उनके ज़मीन पर उनका हिस्सा मलऊन हैं वह ताकिस्तानों की राह पर नहीं चलते।<verse eid="JOB 24:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 24:19"/>ख़ुश्की और गर्मी बरफ़ानी पानी के नालों को सुखा देती हैं,</para>
  <para style="q" vid="JOB 24:19">ऐसा ही क़ब्र गुनहगारों के साथ करती है।<verse eid="JOB 24:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 24:20"/>रहम उसे भूल जाएगा,</para>
  <para style="q" vid="JOB 24:20">कीड़ा उसे मज़े सिखाएगा,</para>
  <para style="q" vid="JOB 24:20">उसकी याद फिर न होगी;</para>
  <para style="q" vid="JOB 24:20">नारास्ती दरख़्त की तरह तोड़ दी जाएगी।<verse eid="JOB 24:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 24:21"/>वह बाँझ को जो जनती नहीं, निगल जाता है,</para>
  <para style="q" vid="JOB 24:21">और बेवा के साथ भलाई नहीं करता।<verse eid="JOB 24:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 24:22"/>ख़ुदा अपनी कु़व्वत से बहादुरको भी खींच लेता है;</para>
  <para style="q" vid="JOB 24:22">वह उठता है, और किसी को ज़िन्दगी का यक़ीन नहीं रहता।<verse eid="JOB 24:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 24:23"/>ख़ुदा उन्हें अम्न बख़्शता है और वह उसी में क़ाईम रहते हैं,</para>
  <para style="q" vid="JOB 24:23">और उसकी आँखें उनकी राहों पर लगी रहती हैं।<verse eid="JOB 24:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 24:24"/>वह सरफ़राज़ तो होते हैं, लेकिन थोड़ी ही देर में जाते रहते हैं;</para>
  <para style="q" vid="JOB 24:24">बल्कि वह पस्त किए जाते हैं और सब दूसरों की तरह रास्ते से उठा लिए जाते,</para>
  <para style="q" vid="JOB 24:24">और अनाज की बालों की तरह काट डाले जाते हैं।<verse eid="JOB 24:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 24:25"/>और अगर यह यूँ ही नहीं है,</para>
  <para style="q" vid="JOB 24:25">तो कौन मुझे झूटा साबित करेगा और मेरी तकरीर को नाचीज़ ठहराएगा?”<verse eid="JOB 24:25"/></para>
  <chapter eid="JOB 24"/>
  <chapter number="25" style="c" sid="JOB 25"/>
  <para style="s">बिलदद का अय्यूब को तिसरा जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 25:1"/>तब बिलदद सूखी ने जवाब दिया<verse eid="JOB 25:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 25:2"/>“हुकूमत और दबदबा उसके साथ है</para>
  <para style="q" vid="JOB 25:2">वह अपने बुलन्द मक़ामों में अमन रखता है।<verse eid="JOB 25:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 25:3"/>क्या उसकी फ़ौजों की कोई ता'दाद है?</para>
  <para style="q" vid="JOB 25:3">और कौन है जिस पर उसकी रोशनी नहीं पड़ती?<verse eid="JOB 25:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 25:4"/>फिर इंसान क्यूँकर ख़ुदा के सामने रास्त ठहर सकता है?</para>
  <para style="q" vid="JOB 25:4">या वह जो 'औरत से पैदा हुआ है क्यूँकर पाक हो सकता है?<verse eid="JOB 25:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 25:5"/>देख, चाँद में भी रोशनी नहीं,</para>
  <para style="q" vid="JOB 25:5">और तारे उसकी नज़र में पाक नहीं।<verse eid="JOB 25:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 25:6"/>फिर भला इंसान का जो महज़ कीड़ा है,</para>
  <para style="q" vid="JOB 25:6">और आदमज़ाद जो सिर्फ़ किरम है क्या ज़िक्र।”<verse eid="JOB 25:6"/></para>
  <chapter eid="JOB 25"/>
  <chapter number="26" style="c" sid="JOB 26"/>
  <para style="s">अय्यूब का नौवां बयान: बिलदद को जवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 26:1"/>तब अय्यूब ने जवाब दिया,<verse eid="JOB 26:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 26:2"/>“जो बे ताक़त उसकी तूने कैसी मदद की;</para>
  <para style="q" vid="JOB 26:2">जिस बाज़ू में कु़व्वत न थी, उसको तू ने कैसा संभाला।<verse eid="JOB 26:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 26:3"/>नादान को तूने कैसी सलाह दी,</para>
  <para style="q" vid="JOB 26:3">और हक़ीक़ी पहचान ख़ूब ही बताई।<verse eid="JOB 26:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 26:4"/>तू ने जो बातें कहीं?</para>
  <para style="q" vid="JOB 26:4">इसलिए किस से और किसकी रूह तुझ में से हो कर निकली?”<verse eid="JOB 26:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 26:5"/>“मुर्दों की रूहें पानी और उसके रहने वालों के नीचे काँपती हैं।<verse eid="JOB 26:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 26:6"/>पाताल उसके सामने खुला है,</para>
  <para style="q" vid="JOB 26:6">और जहन्नुम बेपर्दा है।<verse eid="JOB 26:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 26:7"/>वह शिमाल को फ़ज़ा में फैलाता है,</para>
  <para style="q" vid="JOB 26:7">और ज़मीन को ख़ला में लटकाता है।<verse eid="JOB 26:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 26:8"/>वह अपने पानी से भरे हुए बादलों पानी को बाँध देता</para>
  <para style="q" vid="JOB 26:8">और बादल उसके बोझ से फटता नहीं।<verse eid="JOB 26:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 26:9"/>वह अपने तख़्त को ढांक लेता है</para>
  <para style="q" vid="JOB 26:9">और उसके ऊपर अपने बादल को तान देता है।<verse eid="JOB 26:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 26:10"/>उसने रोशनी और अंधेरे के मिलने की जगह तक,</para>
  <para style="q" vid="JOB 26:10">पानी की सतह पर हद बाँध दी है।<verse eid="JOB 26:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 26:11"/>आसमान के सुतून काँपते,</para>
  <para style="q" vid="JOB 26:11">और और झिड़की से हैरान होते हैं।<verse eid="JOB 26:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 26:12"/>वह अपनी क़ुदरत से समन्दर को तूफ़ानी करता,</para>
  <para style="q" vid="JOB 26:12">और अपने फ़हम से रहब को छेद देता है।<verse eid="JOB 26:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 26:13"/>उसके दम से आसमान आरास्ता होता है,</para>
  <para style="q" vid="JOB 26:13">उसके हाथ ने तेज़रू साँप को छेदा है।<verse eid="JOB 26:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 26:14"/>देखो, यह तो उसकी राहों के सिर्फ़ किनारे हैं,</para>
  <para style="q" vid="JOB 26:14">और उसकी कैसी धीमी आवाज़ हम सुनते हैं।</para>
  <para style="q" vid="JOB 26:14">लेकिन कौन उसकी क़ुदरत की गरज़ को समझ सकता है?”<verse eid="JOB 26:14"/></para>
  <chapter eid="JOB 26"/>
  <chapter number="27" style="c" sid="JOB 27"/>
  <para style="s">अय्यूब का आखिरी बयान</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 27:1"/>और अय्यूब ने फिर अपनी मिसाल शुरू' की और कहने लगा,<verse eid="JOB 27:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 27:2"/>“ज़िन्दा ख़ुदा की क़सम, जिसने मेरा हक़ छीन लिया;</para>
  <para style="q" vid="JOB 27:2">और क़ादिर — ए — मुतलक़ की क़सम, जिसने मेरी जान को दुख दिया है।<verse eid="JOB 27:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 27:3"/>क्यूँकि मेरी जान मुझ में अब तक सालिम है</para>
  <para style="q" vid="JOB 27:3">और ख़ुदा का रूह मेरे नथनों में है।<verse eid="JOB 27:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 27:4"/>यक़ीनन मेरे लब नारास्ती की बातें न कहेंगे,</para>
  <para style="q" vid="JOB 27:4">न मेरी ज़बान से फ़रेब की बात निकलेगी।<verse eid="JOB 27:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 27:5"/>ख़ुदा न करे कि मैं तुम्हें रास्त ठहराऊँ,</para>
  <para style="q" vid="JOB 27:5">मैं मरते दम तक अपनी रास्ती को छोड़ूँगा।<verse eid="JOB 27:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 27:6"/>मैं अपनी सदाक़त पर क़ाईम हूँ और उसे न छोड़ूँगा,</para>
  <para style="q" vid="JOB 27:6">जब तक मेरी ज़िन्दगी है, मेरा दिल मुझे मुजरिम न ठहराएगा।<verse eid="JOB 27:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 27:7"/>“मेरा दुश्मन शरीरों की तरह हो,</para>
  <para style="q" vid="JOB 27:7">और मेरे ख़िलाफ़ उठने वाला नारास्तों की तरह।<verse eid="JOB 27:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 27:8"/>क्यूँकि गो बे दीन दौलत हासिल कर ले तोभी उसकी क्या उम्मीद है?</para>
  <para style="q" vid="JOB 27:8">जब ख़ुदा उसकी जान ले ले,<verse eid="JOB 27:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 27:9"/>क्या ख़ुदा उसकी फ़रियाद सुनेगा,</para>
  <para style="q" vid="JOB 27:9">जब मुसीबत उस पर आए?<verse eid="JOB 27:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 27:10"/>क्या वह क़ादिर — ए — मुतलक में ख़ुश रहेगा,</para>
  <para style="q" vid="JOB 27:10">और हर वक़्त ख़ुदा से दुआ करेगा?<verse eid="JOB 27:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 27:11"/>मैं तुम्हें ख़ुदा के बर्ताव “की तालीम दूँगा,</para>
  <para style="q" vid="JOB 27:11">और क़ादिर — ए — मुतलक़ की बात न छिपाऊँगा।<verse eid="JOB 27:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 27:12"/>देखो, तुम सभों ने ख़ुद यह देख चुके हो,</para>
  <para style="q" vid="JOB 27:12">फिर तुम ख़ुद बीन कैसे हो गए।”<verse eid="JOB 27:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 27:13"/>“ख़ुदा की तरफ़ से शरीर आदमी का हिस्सा,</para>
  <para style="q" vid="JOB 27:13">और ज़ालिमों की मीरास जो वह क़ादिर — ए — मुतलक़ की तरफ़ से पाते हैं, यही है।<verse eid="JOB 27:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 27:14"/>अगर उसके बच्चे बहुत हो जाएँ तो वह तलवार के लिए हैं,</para>
  <para style="q" vid="JOB 27:14">और उसकी औलाद रोटी से सेर न होगी।<verse eid="JOB 27:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 27:15"/>उसके बाक़ी लोग मर कर दफ़्न होंगे,</para>
  <para style="q" vid="JOB 27:15">और उसकी बेवाएँ नौहा न करेंगी।<verse eid="JOB 27:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 27:16"/>चाहे वह ख़ाक की तरह चाँदी जमा' कर ले,</para>
  <para style="q" vid="JOB 27:16">और कसरत से लिबास तैयार कर रख्खें<verse eid="JOB 27:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 27:17"/>वह तैयार कर ले, लेकिन जो रास्त हैं वह उनको पहनेंगे</para>
  <para style="q" vid="JOB 27:17">और जो बेगुनाह हैं वह उस चाँदी को बाँट लेंगे।<verse eid="JOB 27:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 27:18"/>उसने मकड़ी की तरह अपना घर बनाया,</para>
  <para style="q" vid="JOB 27:18">और उस झोंपड़ी की तरह जिसे रखवाला बनाता है।<verse eid="JOB 27:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 27:19"/>वह लेटता है दौलतमन्द, लेकिन वह दफ़न न किया जाएगा।</para>
  <para style="q" vid="JOB 27:19">वह अपनी आँख खोलता है और वह है ही नहीं।<verse eid="JOB 27:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 27:20"/>दहशत उसे पानी की तरह आ लेती है;</para>
  <para style="q" vid="JOB 27:20">रात को तूफ़ान उसे उड़ा ले जाता है।<verse eid="JOB 27:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 27:21"/>पूरबी हवा उसे उड़ा ले जाती है, और वह जाता रहता है।</para>
  <para style="q" vid="JOB 27:21">वह उसे उसकी जगह से उखाड़ फेंकती है।<verse eid="JOB 27:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 27:22"/>क्यूँकि ख़ुदा उस पर बरसाएगा</para>
  <para style="q" vid="JOB 27:22">और छोड़ने का नहीं वह उसके हाथ से निकल भागना चाहेगा।<verse eid="JOB 27:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 27:23"/>लोग उस पर तालियाँ बजाएँगे,</para>
  <para style="q" vid="JOB 27:23">और सुस्कार कर उसे उसकी जगह से निकाल देंगे।<verse eid="JOB 27:23"/></para>
  <chapter eid="JOB 27"/>
  <chapter number="28" style="c" sid="JOB 28"/>
  <para style="s">अय्यूब का समझदारी के बारे में बात करना</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 28:1"/>“यक़ीनन चाँदी की कान होती है,</para>
  <para style="q" vid="JOB 28:1">और सोने के लिए जगह होती है, जहाँ ताया जाता है।<verse eid="JOB 28:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 28:2"/>लोहा ज़मीन से निकाला जाता है,</para>
  <para style="q" vid="JOB 28:2">और पीतल पत्थर में से गलाया जाता है।<verse eid="JOB 28:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 28:3"/>इंसान तारीकी की तह तक पहुँचता है,</para>
  <para style="q" vid="JOB 28:3">और ज़ुल्मात और मौत के साए की इन्तिहा तक पत्थरों की तलाश करता है।<verse eid="JOB 28:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 28:4"/>आबादी से दूर वह सुरंग लगाता है,</para>
  <para style="q" vid="JOB 28:4">आने जाने वालों के पाँव से बे ख़बर और लोगों से दूर वह लटकते और झूलते हैं।<verse eid="JOB 28:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 28:5"/>और ज़मीन उस से ख़ूराक पैदा होती है,</para>
  <para style="q" vid="JOB 28:5">और उसके अन्दर गोया आग से इन्क़लाब होता रहता है।<verse eid="JOB 28:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 28:6"/>उसके पत्थरों में नीलम है,</para>
  <para style="q" vid="JOB 28:6">और उसमें सोने के ज़र्रे हैं<verse eid="JOB 28:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 28:7"/>उस राह को कोई शिकारी परिन्दा नहीं जानता</para>
  <para style="q" vid="JOB 28:7">न कुछ की आँख ने उसे देखा है।<verse eid="JOB 28:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 28:8"/>न मुतक़ब्बिर जानवर उस पर चले हैं,</para>
  <para style="q" vid="JOB 28:8">न खू़नख़्वार बबर उधर से गुज़रा है।<verse eid="JOB 28:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 28:9"/>वह चकमक की चट्टान पर हाथ लगाता है,</para>
  <para style="q" vid="JOB 28:9">वह पहाड़ों को जड़ ही से उखाड़ देता है।<verse eid="JOB 28:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 28:10"/>वह चट्टानों में से नालियाँ काटता है,</para>
  <para style="q" vid="JOB 28:10">उसकी आँख हर एक बेशक़ीमत चीज़ को देख लेती है।<verse eid="JOB 28:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 28:11"/>वह नदियों को मसदूद करता है,</para>
  <para style="q" vid="JOB 28:11">कि वह टपकती भी नहीं और छिपी चीज़ को वह रोशनी में निकाल लाता है।<verse eid="JOB 28:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 28:12"/>लेकिन हिकमत कहाँ मिलेगी?</para>
  <para style="q" vid="JOB 28:12">और 'अक़्लमन्दी की जगह कहाँ है<verse eid="JOB 28:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 28:13"/>न इंसान उसकी क़द्र जानता है,</para>
  <para style="q" vid="JOB 28:13">न वह ज़िन्दों की सर ज़मीन में मिलती है।<verse eid="JOB 28:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 28:14"/>गहराव कहता है, वह मुझ में नहीं है,</para>
  <para style="q" vid="JOB 28:14">और समन्दर भी कहता है वह मेरे पास नहीं है।<verse eid="JOB 28:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 28:15"/>न वह सोने के बदले मिल सकती है,</para>
  <para style="q" vid="JOB 28:15">न चाँदी उसकी क़ीमत के लिए तुलेगी।<verse eid="JOB 28:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 28:16"/>न ओफ़ीर का सोना उसका मोल हो सकता है</para>
  <para style="q" vid="JOB 28:16">और न क़ीमती सुलैमानी पत्थर या नीलम।<verse eid="JOB 28:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 28:17"/>न सोना और काँच उसकी बराबरी कर सकते हैं,</para>
  <para style="q" vid="JOB 28:17">न चोखे सोने के ज़ेवर उसका बदल ठहरेंगे।<verse eid="JOB 28:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 28:18"/>मोंगे और बिल्लौर का नाम भी नहीं लिया जाएगा,</para>
  <para style="q" vid="JOB 28:18">बल्कि हिकमत की क़ीमत मरजान से बढ़कर है।<verse eid="JOB 28:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 28:19"/>न कूश का पुखराज उसके बराबर ठहरेगा न चोखा सोना उसका मोल होगा।<verse eid="JOB 28:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 28:20"/>फिर हिकमत कहाँ से आती है,</para>
  <para style="q" vid="JOB 28:20">और 'अक़्लमन्दी की जगह कहाँ है।<verse eid="JOB 28:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 28:21"/>जिस हाल कि वह सब ज़िन्दों की आँखों से छिपी है,</para>
  <para style="q" vid="JOB 28:21">और हवा के परिंदों से पोशीदा रख्खी गई है<verse eid="JOB 28:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 28:22"/>हलाकत और मौत कहती है,</para>
  <para style="q" vid="JOB 28:22">'हम ने अपने कानों से उसकी अफ़वाह तो सुनी है।”<verse eid="JOB 28:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 28:23"/>“ख़ुदा उसकी राह को जानता है,</para>
  <para style="q" vid="JOB 28:23">और उसकी जगह से वाक़िफ़ है।<verse eid="JOB 28:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 28:24"/>क्यूँकि वह ज़मीन की इन्तिहा तक नज़र करता है,</para>
  <para style="q" vid="JOB 28:24">और सारे आसमान के नीचे देखता है;<verse eid="JOB 28:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 28:25"/>ताकि वह हवा का वज़न ठहराए,</para>
  <para style="q" vid="JOB 28:25">बल्कि वह पानी को पैमाने से नापता है।<verse eid="JOB 28:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 28:26"/>जब उसने बारिश के लिए क़ानून,</para>
  <para style="q" vid="JOB 28:26">और रा'द की बर्क़ के लिए रास्ता ठहराया,<verse eid="JOB 28:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 28:27"/>तब ही उसने उसे देखा और उसका बयान किया,</para>
  <para style="q" vid="JOB 28:27">उसने उसे क़ाईम और ढूँड निकाला।<verse eid="JOB 28:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 28:28"/>और उसने इंसान से कहा,</para>
  <para style="q" vid="JOB 28:28">देख, ख़ुदावन्द का ख़ौफ़ ही हिकमत है;</para>
  <para style="q" vid="JOB 28:28">और बदी से दूर रहना यही 'अक़्लमन्दी है।”<verse eid="JOB 28:28"/></para>
  <chapter eid="JOB 28"/>
  <chapter number="29" style="c" sid="JOB 29"/>
  <para style="s">अय्यूब का अपमनी पहले की बरकतों के बारे में बात करना</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 29:1"/>और अय्यूब फिर अपनी मिसाल लाकर कहने लगा,<verse eid="JOB 29:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 29:2"/>“काश कि मैं ऐसा होता जैसे गुज़रे महीनों में,</para>
  <para style="q" vid="JOB 29:2">या'नी जैसा उन दिनों में जब ख़ुदा मेरी हिफ़ाज़त करता था।<verse eid="JOB 29:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 29:3"/>जब उसका चराग़ मेरे सिर पर रोशन रहता था,</para>
  <para style="q" vid="JOB 29:3">और मैं अँधेरे में उसके नूर के ज़रिए' से चलता था।<verse eid="JOB 29:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 29:4"/>जैसा में अपनी बरोमन्दी के दिनों में था,</para>
  <para style="q" vid="JOB 29:4">जब ख़ुदा की ख़ुशनूदी मेरे ख़ेमे पर थी।<verse eid="JOB 29:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 29:5"/>जब क़ादिर — ए — मुतलक़ भी मेरे साथ था,</para>
  <para style="q" vid="JOB 29:5">और मेरे बच्चे मेरे साथ थे।<verse eid="JOB 29:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 29:6"/>जब मेरे क़दम मख्खन से धुलते थे,</para>
  <para style="q" vid="JOB 29:6">और चट्टान मेरे लिए तेल की नदियाँ बहाती थी।<verse eid="JOB 29:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 29:7"/>जब मैं शहर के फाटक पर जाता</para>
  <para style="q" vid="JOB 29:7">और अपने लिए चौक में बैठक तैयार करता था;<verse eid="JOB 29:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 29:8"/>तो जवान मुझे देखते और छिप जाते,</para>
  <para style="q" vid="JOB 29:8">और उम्र रसीदा उठ खड़े होते थे।<verse eid="JOB 29:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 29:9"/>हाकिम बोलना बंद कर देते,</para>
  <para style="q" vid="JOB 29:9">और अपने हाथ अपने मुँह पर रख लेते थे।<verse eid="JOB 29:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 29:10"/>रईसों की आवाज़ थम जाती,</para>
  <para style="q" vid="JOB 29:10">और उनकी ज़बान तालू से चिपक जाती थी।<verse eid="JOB 29:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 29:11"/>क्यूँकि कान जब मेरी सुन लेता तो मुझे मुबारक कहता था,</para>
  <para style="q" vid="JOB 29:11">और आँख जब मुझे देख लेती तो मेरी गावाही देती थी;<verse eid="JOB 29:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 29:12"/>क्यूँकि मैं ग़रीब को जब वह फ़रियाद करता छुड़ाता था</para>
  <para style="q" vid="JOB 29:12">और यतीमों को भी जिसका कोई मददगार न था।<verse eid="JOB 29:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 29:13"/>हलाक होनेवाला मुझे दुआ देता था,</para>
  <para style="q" vid="JOB 29:13">और मैं बेवा के दिल को ऐसा ख़ुश करता था कि वह गाने लगती थी।<verse eid="JOB 29:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 29:14"/>मैंने सदाक़त को पहना और उससे मुलब्बस हुआ:</para>
  <para style="q" vid="JOB 29:14">मेरा इन्साफ़ गोया जुब्बा और 'अमामा था।<verse eid="JOB 29:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 29:15"/>मैं अंधों के लिए आँखें था,</para>
  <para style="q" vid="JOB 29:15">और लंगड़ों के लिए पाँव।<verse eid="JOB 29:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 29:16"/>मैं मोहताज का बाप था,</para>
  <para style="q" vid="JOB 29:16">और मैं अजनबी के मु'आमिले की भी तहक़ीक़ करता था।<verse eid="JOB 29:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 29:17"/>मैं नारास्त के जबड़ों को तोड़ डालता,</para>
  <para style="q" vid="JOB 29:17">और उसके दाँतों से शिकार छुड़ालेता था।<verse eid="JOB 29:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 29:18"/>तब मैं कहता था, कि मैं अपने आशियाने में हूँगा</para>
  <para style="q" vid="JOB 29:18">और मैं अपने दिनों को रेत की तरह बे शुमार करूँगा,<verse eid="JOB 29:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 29:19"/>मेरी जड़ें पानी तक फैल गई हैं,</para>
  <para style="q" vid="JOB 29:19">और रात भर ओस मेरी शाखों पर रहती है;<verse eid="JOB 29:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 29:20"/>मेरी शौकत मुझ में ताज़ा है,</para>
  <para style="q" vid="JOB 29:20">और मेरी कमान मेरे हाथ में नई की जाती है।<verse eid="JOB 29:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 29:21"/>'लोग मेरी तरफ़ कान लगाते और मुन्तज़िर रहते,</para>
  <para style="q" vid="JOB 29:21">और मेरी मशवरत के लिए ख़ामोश हो जाते थे।<verse eid="JOB 29:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 29:22"/>मेरी बातों के बा'द, वह फिर न बोलते थे;</para>
  <para style="q" vid="JOB 29:22">और मेरी तक़रीर उन पर टपकती थी<verse eid="JOB 29:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 29:23"/>वह मेरा ऐसा इन्तिज़ार करते थे जैसा बारिश का;</para>
  <para style="q" vid="JOB 29:23">और अपना मुँह ऐसा फैलाते थे जैसे पिछले मेंह के लिए।<verse eid="JOB 29:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 29:24"/>जब वह मायूस होते थे तो मैं उन पर मुस्कराता था,</para>
  <para style="q" vid="JOB 29:24">और मेरे चेहरे की रोनक की उन्होंने कभी न बिगाड़ा।<verse eid="JOB 29:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 29:25"/>मैं उनकी राह को चुनता, और सरदार की तरह बैठता,</para>
  <para style="q" vid="JOB 29:25">और ऐसे रहता था जैसे फ़ौज में बादशाह,</para>
  <para style="q" vid="JOB 29:25">और जैसे वह जो ग़मज़दों को तसल्ली देता है।<verse eid="JOB 29:25"/></para>
  <chapter eid="JOB 29"/>
  <chapter number="30" style="c" sid="JOB 30"/>
  <para style="s">अय्यूब का अपने दर्द के बारे में बात करना</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 30:1"/>“लेकिन अब तो वह जो मुझ से कम उम्र हैं मेरा मज़ाक़ करते हैं,</para>
  <para style="q" vid="JOB 30:1">जिनके बाप — दादा को अपने गल्ले के कुत्तों के साथ रखना भी मुझे नागवार था।<verse eid="JOB 30:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 30:2"/>बल्कि उनके हाथों की ताक़त मुझे किस बात का फ़ायदा पहुँचाएगी?</para>
  <para style="q" vid="JOB 30:2">वह ऐसे आदमी हैं जिनकी जवानी का ज़ोर ज़ाइल हो गया।<verse eid="JOB 30:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 30:3"/>वह ग़ुरबत और क़हत के मारे दुबले हो गए हैं,</para>
  <para style="q" vid="JOB 30:3">वह वीरानी और सुनसानी की तारीकी में ख़ाक चाटते हैं।<verse eid="JOB 30:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 30:4"/>वह झाड़ियों के पास लोनिये का साग तोड़ते हैं,</para>
  <para style="q" vid="JOB 30:4">और झाऊ की जड़ें उनकी ख़ूराक है।<verse eid="JOB 30:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 30:5"/>वह लोगों के बीच दौड़ाये गए हैं,</para>
  <para style="q" vid="JOB 30:5">लोग उनके पीछे ऐसे चिल्लाते हैं जैसे चोर के पीछे।<verse eid="JOB 30:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 30:6"/>उनको वादियों के दरख़्तों में,</para>
  <para style="q" vid="JOB 30:6">और ग़ारों और ज़मीन के भट्टों में रहना पड़ता है।<verse eid="JOB 30:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 30:7"/>वह झाड़ियों के बीच रैंकते,</para>
  <para style="q" vid="JOB 30:7">और झंकाड़ों के नीचे इकट्ठे पड़े रहते हैं।<verse eid="JOB 30:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 30:8"/>वह बेवक़ूफ़ों बल्कि कमीनों की औलाद हैं,</para>
  <para style="q" vid="JOB 30:8">वह मुल्क से मार — मार कर निकाले गए थे।<verse eid="JOB 30:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 30:9"/>और अब मैं उनका गीत बना हूँ,</para>
  <para style="q" vid="JOB 30:9">बल्कि उनके लिए एक मिसाल की तरह हूँ।<verse eid="JOB 30:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 30:10"/>वह मुझ से नफ़रत करते;</para>
  <para style="q" vid="JOB 30:10">वह मुझ से दूर खड़े होते,</para>
  <para style="q" vid="JOB 30:10">और मेरे मुँह पर थूकने से बाज़ नहीं रहते हैं।<verse eid="JOB 30:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 30:11"/>क्यूँकि खु़दा ने मेरा चिल्ला ढीला कर दिया और मुझ पर आफ़त भेजी,</para>
  <para style="q" vid="JOB 30:11">इसलिए वह मेरे सामने बेलगाम हो गए हैं।<verse eid="JOB 30:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 30:12"/>मेरे दहने हाथ पर लोगों का मजमा' उठता है;</para>
  <para style="q" vid="JOB 30:12">वह मेरे पाँव को एक तरफ़ सरका देते हैं,</para>
  <para style="q" vid="JOB 30:12">और मेरे ख़िलाफ़ अपनी मुहलिक राहें निकालते हैं।<verse eid="JOB 30:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 30:13"/>ऐसे लोग भी जिनका कोई मददगार नहीं,</para>
  <para style="q" vid="JOB 30:13">मेरे रास्ते को बिगाड़ते,</para>
  <para style="q" vid="JOB 30:13">और मेरी मुसीबत को बढ़ाते हैं'।<verse eid="JOB 30:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 30:14"/>वह गोया बड़े सुराख़ में से होकर आते हैं,</para>
  <para style="q" vid="JOB 30:14">और तबाही में मुझ पर टूट पड़ते हैं।<verse eid="JOB 30:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 30:15"/>दहशत मुझ पर तारी हो गई'।</para>
  <para style="q" vid="JOB 30:15">वह हवा की तरह मेरी आबरू को उड़ाती है।</para>
  <para style="q" vid="JOB 30:15">मेरी 'आफ़ियत बादल की तरह जाती रही।<verse eid="JOB 30:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 30:16"/>“अब तो मेरी जान मेरे अंदर गुदाज़ हो गई,</para>
  <para style="q" vid="JOB 30:16">दुख के दिनों ने मुझे जकड़ लिया है।<verse eid="JOB 30:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 30:17"/>रात के वक़्त मेरी हड्डियाँ मेरे अंदर छिद जाती हैं</para>
  <para style="q" vid="JOB 30:17">और वह दर्द जो मुझे खाए जाते हैं, दम नहीं लेते।<verse eid="JOB 30:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 30:18"/>मेरे मरज़ की शिद्दत से मेरी पोशाक बदनुमा हो गयी;</para>
  <para style="q" vid="JOB 30:18">वह मेरे पैराहन के गिरेबान की तरह मुझ से लिपटी हुई है।<verse eid="JOB 30:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 30:19"/>उसने मुझे कीचड़ में धकेल दिया है,</para>
  <para style="q" vid="JOB 30:19">मैं ख़ाक और राख की तरह हो गया हूँ।<verse eid="JOB 30:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 30:20"/>मैं तुझ से फ़रियाद करता हूँ, और तू मुझे जवाब नहीं देता;</para>
  <para style="q" vid="JOB 30:20">मैं खड़ा होता हूँ, और तू मुझे घूरने लगता है।<verse eid="JOB 30:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 30:21"/>तू बदल कर मुझ पर बे रहम हो गया है;</para>
  <para style="q" vid="JOB 30:21">अपने बाज़ू की ताक़त से तू मुझे सताता है।<verse eid="JOB 30:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 30:22"/>तू मुझे ऊपर उठाकर हवा पर सवार करता है,</para>
  <para style="q" vid="JOB 30:22">और मुझे आँधी में घुला देता है।<verse eid="JOB 30:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 30:23"/>क्यूँकि मैं जानता हूँ कि तू मुझे मौत</para>
  <para style="q" vid="JOB 30:23">और उस घर तक जो सब ज़िन्दों के लिए मुक़र्रर है।<verse eid="JOB 30:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 30:24"/>'तोभी क्या तबाही के वक़्त कोई अपना हाथ न बढ़ाएगा,</para>
  <para style="q" vid="JOB 30:24">और मुसीबत में फ़रियाद न करेगा?<verse eid="JOB 30:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 30:25"/>क्या मैं दर्दमन्द के लिए रोता न था?</para>
  <para style="q" vid="JOB 30:25">क्या मेरी जान मोहताज के लिए ग़मग़ीन न होती थी?<verse eid="JOB 30:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 30:26"/>जब मैं भलाई का मुन्तज़िर था,</para>
  <para style="q" vid="JOB 30:26">तो बुराई पेश आई जब मैं रोशनी के लिए ठहरा था, तो तारीकी आई।<verse eid="JOB 30:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 30:27"/>मेरी अंतड़ियाँ उबल रही हैं और आराम नहीं पातीं;</para>
  <para style="q" vid="JOB 30:27">मुझ पर मुसीबत के दिन आ पड़े हैं।<verse eid="JOB 30:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 30:28"/>मैं बगै़र धूप के काला हो गया हूँ।</para>
  <para style="q" vid="JOB 30:28">मैं मजमे' में खड़ा होकर मदद के लिए फ़रियाद करता हूँ।<verse eid="JOB 30:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 30:29"/>मैं गीदड़ों का भाई,</para>
  <para style="q" vid="JOB 30:29">और शुतर मुर्ग़ों का साथी हूँ।<verse eid="JOB 30:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 30:30"/>मेरी खाल काली होकर मुझ पर से गिरती जाती है</para>
  <para style="q" vid="JOB 30:30">और मेरी हड्डियाँ हरारत से जल गई।<verse eid="JOB 30:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 30:31"/>इसी लिए मेरे सितार से मातम,</para>
  <para style="q" vid="JOB 30:31">और मेरी बाँसली से रोने की आवाज़ निकलती है।<verse eid="JOB 30:31"/></para>
  <chapter eid="JOB 30"/>
  <chapter number="31" style="c" sid="JOB 31"/>
  <para style="s">अय्यूब का अपने बेकसूर होने के बारे में आखिरी बार कहना</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 31:1"/>“मैंने अपनी आँखों से 'अहद किया है।</para>
  <para style="q" vid="JOB 31:1">फिर मैं किसी कुँवारी पर क्यूँकर नज़र करूँ।<verse eid="JOB 31:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 31:2"/>क्यूँकि ऊपर से ख़ुदा की तरफ़ से क्या हिस्सा है</para>
  <para style="q" vid="JOB 31:2">और 'आलम — ए — बाला से क़ादिर — ए — मुतलक़ की तरफ़ से क्या मीरास है?<verse eid="JOB 31:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 31:3"/>क्या वह नारास्तों के लिए आफ़त</para>
  <para style="q" vid="JOB 31:3">और बदकिरदारों के लिए तबाही नहीं है।<verse eid="JOB 31:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 31:4"/>क्या वह मेरी राहों को नहीं देखता,</para>
  <para style="q" vid="JOB 31:4">और मेरे सब क़दमों को नहीं गिनता?<verse eid="JOB 31:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 31:5"/>अगर मैं बतालत से चला हूँ,</para>
  <para style="q" vid="JOB 31:5">और मेरे पाँव ने दग़ा के लिए जल्दी की है।<verse eid="JOB 31:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 31:6"/>तो मैं ठीक तराज़ू में तोला जाऊँ,</para>
  <para style="q" vid="JOB 31:6">ताकि ख़ुदा मेरी रास्ती को जान ले।<verse eid="JOB 31:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 31:7"/>अगर मेरा क़दम रास्ते से फिरा हुआ है,</para>
  <para style="q" vid="JOB 31:7">और मेरे दिल ने मेरी आँखों की पैरवी की है,</para>
  <para style="q" vid="JOB 31:7">और अगर मेरे हाथों पर दाग़ लगा है;<verse eid="JOB 31:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 31:8"/>तो मैं बोऊँ और दूसरा खाए,</para>
  <para style="q" vid="JOB 31:8">और मेरे खेत की पैदावार उखाड़ दी जाए।<verse eid="JOB 31:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 31:9"/>“अगर मेरा दिल किसी 'औरत पर फ़रेफ़्ता हुआ,</para>
  <para style="q" vid="JOB 31:9">और मैं अपने पड़ोसी के दरवाज़े पर घात में बैठा;<verse eid="JOB 31:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 31:10"/>तो मेरी बीवी दूसरे के लिए पीसे,</para>
  <para style="q" vid="JOB 31:10">और गै़र मर्द उस पर झुकें।<verse eid="JOB 31:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 31:11"/>क्यूँकि यह बहुत बड़ा जुर्म होता,</para>
  <para style="q" vid="JOB 31:11">बल्कि ऐसी बुराई होती जिसकी सज़ा क़ाज़ी देते हैं।<verse eid="JOB 31:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 31:12"/>क्यूँकि वह ऐसी आग है जो जलाकर भस्म कर देती है,</para>
  <para style="q" vid="JOB 31:12">और मेरे सारे हासिल को जड़ से बर्बाद कर डालती है।<verse eid="JOB 31:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 31:13"/>“अगर मैंने अपने ख़ादिम या अपनी ख़ादिमा का हक़ मारा हो,</para>
  <para style="q" vid="JOB 31:13">जब उन्होंने मुझ से झगड़ा किया;<verse eid="JOB 31:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 31:14"/>तो जब ख़ुदा उठेगा, तब मैं क्या करूँगा?</para>
  <para style="q" vid="JOB 31:14">और जब वह आएगा, तो मैं उसे क्या जवाब दूँगा?<verse eid="JOB 31:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 31:15"/>क्या वही उसका बनाने वाला नहीं, जिसने मुझे पेट में बनाया?</para>
  <para style="q" vid="JOB 31:15">और क्या एक ही ने हमारी सूरत रहम में नहीं बनाई?<verse eid="JOB 31:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 31:16"/>अगर मैंने मोहताज से उसकी मुराद रोक रखी,</para>
  <para style="q" vid="JOB 31:16">या ऐसा किया कि बेवा की आँखें रह गई<verse eid="JOB 31:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 31:17"/>या अपना निवाला अकेले ही खाया हो,</para>
  <para style="q" vid="JOB 31:17">और यतीम उसमें से खाने न पाया<verse eid="JOB 31:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 31:18"/>नहीं, बल्कि मेरे लड़कपन से वह मेरे साथ ऐसे पला जैसे बाप के साथ,</para>
  <para style="q" vid="JOB 31:18">और मैं अपनी माँ के बतन ही से बेवा का रहनुमा रहा हूँ।<verse eid="JOB 31:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 31:19"/>अगर मैंने देखा कि कोई बेकपड़े मरता है,</para>
  <para style="q" vid="JOB 31:19">या किसी मोहताज के पास ओढ़ने को नहीं;<verse eid="JOB 31:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 31:20"/>अगर उसकी कमर ने मुझ को दुआ न दी हो,</para>
  <para style="q" vid="JOB 31:20">और अगर वह मेरी भेड़ों की ऊन से गर्म न हुआ हो।<verse eid="JOB 31:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 31:21"/>अगर मैंने किसी यतीम पर हाथ उठाया हो,</para>
  <para style="q" vid="JOB 31:21">क्यूँकि फाटक पर मुझे अपनी मदद दिखाई दी;<verse eid="JOB 31:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 31:22"/>तो मेरा कंधा मेरे शाने से उतर जाए,</para>
  <para style="q" vid="JOB 31:22">और मेरे बाज़ू की हड्डी टूट जाए।<verse eid="JOB 31:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 31:23"/>क्यूँकि मुझे ख़ुदा की तरफ़ से आफ़त का ख़ौफ़ था,</para>
  <para style="q" vid="JOB 31:23">और उसकी बुजु़र्गी की वजह से मैं कुछ न कर सका।<verse eid="JOB 31:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 31:24"/>“अगर मैंने सोने पर भरोसा किया हो,</para>
  <para style="q" vid="JOB 31:24">और ख़ालिस सोने से कहा, मेरा ऐ'तिमाद तुझ पर है।<verse eid="JOB 31:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 31:25"/>अगर मैं इसलिए कि मेरी दौलत फ़िरावान थी,</para>
  <para style="q" vid="JOB 31:25">और मेरे हाथ ने बहुत कुछ हासिल कर लिया था, नाज़ाँ हुआ।<verse eid="JOB 31:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 31:26"/>अगर मैंने सूरज पर जब वह चमकता है,</para>
  <para style="q" vid="JOB 31:26">नज़र की हो या चाँद पर जब वह आब — ओ — ताब में चलता है,<verse eid="JOB 31:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 31:27"/>और मेरा दिल चुपके से 'आशिक़ हो गया हो,</para>
  <para style="q" vid="JOB 31:27">और मेरे मुँह ने मेरे हाथ को चूम लिया हो;<verse eid="JOB 31:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 31:28"/>तो यह भी ऐसा गुनाह है जिसकी सज़ा क़ाज़ी देते हैं</para>
  <para style="q" vid="JOB 31:28">क्यूँकि यूँ मैंने ख़ुदा का जो 'आलम — ए — बाला पर है, इंकार किया होता।<verse eid="JOB 31:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 31:29"/>'अगर मैं अपने नफ़रत करने वाले की हलाकत से ख़ुश हुआ,</para>
  <para style="q" vid="JOB 31:29">या जब उस पर आफ़त आई तो ख़ुश हुआ;<verse eid="JOB 31:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 31:30"/>हाँ, मैंने तो अपने मुँह को इतना भी गुनाह न करने दिया के ला'नत दे कर उसकी मौत के लिए दुआ करता;<verse eid="JOB 31:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 31:31"/>अगर मेरे ख़ेमे के लोगों ने यह न कहा हो,</para>
  <para style="q" vid="JOB 31:31">'ऐसा कौन है जो उसके यहाँ गोश्त से सेर न हुआ?'<verse eid="JOB 31:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 31:32"/>परदेसी को गली कूचों में टिकना न पड़ा,</para>
  <para style="q" vid="JOB 31:32">बल्कि मैं मुसाफ़िर के लिए अपने दरवाज़े खोल देता था।<verse eid="JOB 31:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 31:33"/>अगर आदम की तरह अपने गुनाह अपने सीने में छिपाकर,</para>
  <para style="q" vid="JOB 31:33">मैंने अपनी ग़लतियों पर पर्दा डाला हो;<verse eid="JOB 31:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 31:34"/>इस वजह से कि मुझे 'अवाम के लोगों का ख़ौफ़ था,</para>
  <para style="q" vid="JOB 31:34">और मैं ख़ान्दानों की हिकारत से डर गया,</para>
  <para style="q" vid="JOB 31:34">यहाँ तक कि मैं ख़ामोश हो गया और दरवाज़े से बाहर न निकला<verse eid="JOB 31:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 31:35"/>काश कि कोई मेरी सुनने वाला होता!</para>
  <para style="q" vid="JOB 31:35">यह लो मेरा दस्तख़त। क़ादिर — ए — मुतलक़ मुझे जवाब दे।</para>
  <para style="q" vid="JOB 31:35">काश कि मेरे मुख़ालिफ़ के दा'वे का सुबूत होता।<verse eid="JOB 31:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="JOB 31:36"/>यक़ीनन मैं उसे अपने कंधे पर लिए फिरता;</para>
  <para style="q" vid="JOB 31:36">और उसे अपने लिए 'अमामे की तरह बाँध लेता।<verse eid="JOB 31:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JOB 31:37"/>मैं उसे अपने क़दमों की ता'दाद बताता;</para>
  <para style="q" vid="JOB 31:37">अमीर की तरह मैं उसके पास जाता।<verse eid="JOB 31:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="JOB 31:38"/>“अगर मेरी ज़मीन मेरे ख़िलाफ़ फ़रियाद करती हों,</para>
  <para style="q" vid="JOB 31:38">और उसकी रेघारियाँ मिलकर रोती हों,<verse eid="JOB 31:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="JOB 31:39"/>अगर मैंने बेदाम उसके फल खाए हों,</para>
  <para style="q" vid="JOB 31:39">या ऐसा किया कि उसके मालिकों की जान गई;<verse eid="JOB 31:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="JOB 31:40"/>तो गेहूँ के बदले ऊँट कटारे,</para>
  <para style="q" vid="JOB 31:40">और जौ के बदले कड़वे दाने उगें।”</para>
  <para style="q" vid="JOB 31:40">अय्यूब की बातें तमाम हुई।<verse eid="JOB 31:40"/></para>
  <chapter eid="JOB 31"/>
  <chapter number="32" style="c" sid="JOB 32"/>
  <para style="s">इलीहू का अय्यूब के दोस्तों को जवाब देना</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 32:1"/>तब उन तीनों आदमी ने अय्यूब को जवाब देना छोड़ दिया, इसलिए कि वह अपनी नज़र में सच्चा था। <verse eid="JOB 32:1"/><verse number="2" style="v" sid="JOB 32:2"/>तब इलीहू बिन — बराकील बूज़ी का, जुराम के ख़ान्दान से था, क़हर से भड़का। उसका क़हर अय्यूब पर भड़का, इसलिए कि उसने ख़ुदा को नहीं बल्कि अपने आप को रास्त ठहराया। <verse eid="JOB 32:2"/><verse number="3" style="v" sid="JOB 32:3"/>और उसके तीनों दोस्तों पर भी उसका क़हर भड़का, इसलिए कि उन्हें जवाब तो सूझा नहीं, तोभी उन्होंने अय्यूब को मुजरिम ठहराया। <verse eid="JOB 32:3"/><verse number="4" style="v" sid="JOB 32:4"/>और इलीहू अय्यूब से बात करने से इसलिए रुका रहा कि वह उससे बड़े थे। <verse eid="JOB 32:4"/><verse number="5" style="v" sid="JOB 32:5"/>जब इलीहू ने देखा कि उन तीनों के मुँह में जवाब न रहा, तो उसका क़हर भड़क उठा।<verse eid="JOB 32:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 32:6"/>और बराकील बूज़ी का बेटा इलीहू कहने लगा,</para>
  <para style="q" vid="JOB 32:6">मैं जवान हूँ और तुम बहुत बुज़ुर्ग हो,</para>
  <para style="q" vid="JOB 32:6">इसलिए मैं रुका रहा और अपनी राय देने की हिम्मत न की।<verse eid="JOB 32:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 32:7"/>मैं कहा साल खूरदह लोग बोलें</para>
  <para style="q" vid="JOB 32:7">और उम्र रसीदा हिकमत से खायें<verse eid="JOB 32:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 32:8"/>लेकिन इंसान में रूह है,</para>
  <para style="q" vid="JOB 32:8">और क़ादिर — ए — मुतलक़ का दम अक़्ल बख़्शता है।<verse eid="JOB 32:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 32:9"/>बड़े आदमी ही 'अक़्लमन्द नहीं होते,</para>
  <para style="q" vid="JOB 32:9">और बुज़ुर्ग ही इन्साफ़ को नहीं समझते।<verse eid="JOB 32:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 32:10"/>इसलिए मैं कहता हूँ,</para>
  <para style="q" vid="JOB 32:10">'मेरी सुनो, मैं भी अपनी राय दूँगा।<verse eid="JOB 32:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 32:11"/>“देखो, मैं तुम्हारी बातों के लिए रुका रहा,</para>
  <para style="q" vid="JOB 32:11">जब तुम अल्फ़ाज़ की तलाश में थे;</para>
  <para style="q" vid="JOB 32:11">मैं तुम्हारी दलीलों का मुन्तज़िर रहा।<verse eid="JOB 32:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 32:12"/>बल्कि मैं तुम्हारी तरफ़ तवज्जुह करता रहा,</para>
  <para style="q" vid="JOB 32:12">और देखो, तुम में कोई न था जो अय्यूब को क़ायल करता,</para>
  <para style="q" vid="JOB 32:12">या उसकी बातों का जवाब देता।<verse eid="JOB 32:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 32:13"/>ख़बरदार, यह न कहना कि हम ने हिकमत को पा लिया है,</para>
  <para style="q" vid="JOB 32:13">ख़ुदा ही उसे लाजवाब कर सकता है न कि इंसान।<verse eid="JOB 32:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 32:14"/>क्यूँकि न उसने मुझे अपनी बातों का निशाना बनाया,</para>
  <para style="q" vid="JOB 32:14">न मैं तुम्हारी तरह तक़रीरों से उसे जवाब दूँगा।<verse eid="JOB 32:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 32:15"/>वह हैरान हैं, वह अब जवाब नहीं देते;</para>
  <para style="q" vid="JOB 32:15">उनके पास कहने को कोई बात न रही।<verse eid="JOB 32:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 32:16"/>और क्या मैं रुका रहूँ, इसलिए कि वह बोलते नहीं?</para>
  <para style="q" vid="JOB 32:16">इसलिए कि वह चुपचाप खड़े हैं और अब जवाब नहीं देते?<verse eid="JOB 32:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 32:17"/>मैं भी अपनी बात कहूँगा,</para>
  <para style="q" vid="JOB 32:17">मैं भी अपनी राय दूँगा।<verse eid="JOB 32:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 32:18"/>क्यूँकि मैं बातों से भरा हूँ,</para>
  <para style="q" vid="JOB 32:18">और जो रूह मेरे अंदर है वह मुझे मज़बूर करती है।<verse eid="JOB 32:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 32:19"/>देखो, मेरा पेट बेनिकास शराब की तरह है,</para>
  <para style="q" vid="JOB 32:19">वह नई मश्कों की तरह फटने ही को है।<verse eid="JOB 32:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 32:20"/>मैं बोलूँगा ताकि तुझे तसल्ली हो:</para>
  <para style="q" vid="JOB 32:20">मैं अपने लबों को खोलूँगा और जवाब दूँगा।<verse eid="JOB 32:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 32:21"/>न मैं किसी आदमी की तरफ़दारी करूँगा,</para>
  <para style="q" vid="JOB 32:21">न मैं किसी शख़्स को ख़ुशामद के ख़िताब दूँगा।<verse eid="JOB 32:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 32:22"/>क्यूँकि मुझे ख़ुश करने का ख़िताब देना नहीं आता,</para>
  <para style="q" vid="JOB 32:22">वर्ना मेरा बनाने वाला मुझे जल्द उठा लेता।<verse eid="JOB 32:22"/></para>
  <chapter eid="JOB 32"/>
  <chapter number="33" style="c" sid="JOB 33"/>
  <para style="s">एलीहू का अय्यूब के ख़िलाफ़ बोलना</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 33:1"/>“तोभी ऐ अय्यूब ज़रा मेरी तक़रीर सुन ले,</para>
  <para style="q" vid="JOB 33:1">और मेरी सब बातों पर कान लगा।<verse eid="JOB 33:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 33:2"/>देख, मैंने अपना मुँह खोला है;</para>
  <para style="q" vid="JOB 33:2">मेरी ज़बान ने मेरे मुँह में सुखन आराई की है।<verse eid="JOB 33:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 33:3"/>मेरी बातें मेरे दिल की रास्तबाज़ी को ज़ाहिर करेंगी।</para>
  <para style="q" vid="JOB 33:3">और मेरे लब जो कुछ जानते हैं, उसी को सच्चाई से कहेंगे।<verse eid="JOB 33:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 33:4"/>ख़ुदा की रूह ने मुझे बनाया है,</para>
  <para style="q" vid="JOB 33:4">और क़ादिर — ए — मुतलक़ का दम मुझे ज़िन्दगी बख़्शता है।<verse eid="JOB 33:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 33:5"/>अगर तू मुझे जवाब दे सकता है तो दे,</para>
  <para style="q" vid="JOB 33:5">और अपनी बातों को मेरे सामने तरतीब देकर खड़ा हो जा।<verse eid="JOB 33:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 33:6"/>देख, ख़ुदा के सामने मैं तेरे बराबर हूँ।</para>
  <para style="q" vid="JOB 33:6">मैं भी मिट्टी से बना हूँ।<verse eid="JOB 33:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 33:7"/>देख, मेरा रौ'ब तुझे परेशान न करेगा,</para>
  <para style="q" vid="JOB 33:7">मेरा दबाव तुझ पर भारी न होगा।<verse eid="JOB 33:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 33:8"/>“यक़ीनन तू मेरे सुनते ही कहा है,</para>
  <para style="q" vid="JOB 33:8">और मैंने तेरी बातें सुनी हैं,<verse eid="JOB 33:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 33:9"/>कि 'मैं साफ़ और में बे तकसीर हूँ,</para>
  <para style="q" vid="JOB 33:9">मैं बे गुनाह हूँ, और मुझ में गुनाह नहीं।<verse eid="JOB 33:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 33:10"/>वह मेरे ख़िलाफ़ मौक़ा' ढूँडता है,</para>
  <para style="q" vid="JOB 33:10">वह मुझे अपना दुश्मन समझता है;<verse eid="JOB 33:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 33:11"/>वह मेरे दोनों पाँव को काठ में ठोंक देता है,</para>
  <para style="q" vid="JOB 33:11">वह मेरी सब राहों की निगरानी करता है।<verse eid="JOB 33:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 33:12"/>“देख, मैं तुझे जवाब देता हूँ, इस बात में तू हक़ पर नहीं।</para>
  <para style="q" vid="JOB 33:12">क्यूँकि ख़ुदा इंसान से बड़ा है।<verse eid="JOB 33:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 33:13"/>तू क्यूँ उससे झगड़ता है?</para>
  <para style="q" vid="JOB 33:13">क्यूँकि वह अपनी बातों में से किसी का हिसाब नहीं देता।<verse eid="JOB 33:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 33:14"/>क्यूँकि ख़ुदा एक बार बोलता है, बल्कि दो बार,</para>
  <para style="q" vid="JOB 33:14">चाहे इंसान इसका ख़याल न करे।<verse eid="JOB 33:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 33:15"/>ख़्वाब में, रात के ख़्वाब में,</para>
  <para style="q" vid="JOB 33:15">जब लोगों को गहरी नींद आती है,</para>
  <para style="q" vid="JOB 33:15">और बिस्तर पर सोते वक़्त;<verse eid="JOB 33:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 33:16"/>तब वह लोगों के कान खोलता है,</para>
  <para style="q" vid="JOB 33:16">और उनकी ता'लीम पर मुहर लगाता है,<verse eid="JOB 33:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 33:17"/>ताकि इंसान को उसके मक़सद से रोके,</para>
  <para style="q" vid="JOB 33:17">और गु़रूर को इंसान में से दूर करे।<verse eid="JOB 33:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 33:18"/>वह उसकी जान को गढ़े से बचाता है,</para>
  <para style="q" vid="JOB 33:18">और उसकी ज़िन्दगी तलवार की मार से।<verse eid="JOB 33:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 33:19"/>“वह अपने बिस्तर पर दर्द से तम्बीह पाता है,</para>
  <para style="q" vid="JOB 33:19">और उसकी हड्डियों में दाइमी जंग है।<verse eid="JOB 33:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 33:20"/>यहाँ तक कि उसका जी रोटी से,</para>
  <para style="q" vid="JOB 33:20">और उसकी जान लज़ीज़ खाने से नफ़रत करने लगती है।<verse eid="JOB 33:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 33:21"/>उसका गोश्त ऐसा सूख जाता है कि दिखाई नहीं देता;</para>
  <para style="q" vid="JOB 33:21">और उसकी हड्डियाँ जो दिखाई नहीं देती थीं, निकल आती हैं'।<verse eid="JOB 33:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 33:22"/>बल्कि उसकी जान गढ़े के क़रीब पहुँचती है,</para>
  <para style="q" vid="JOB 33:22">और उसकी ज़िन्दगी हलाक करने वालों के नज़दीक।<verse eid="JOB 33:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 33:23"/>वहाँ अगर उसके साथ कोई फ़रिश्ता हो,</para>
  <para style="q" vid="JOB 33:23">या हज़ार में एक ता'बीर करने वाला,</para>
  <para style="q" vid="JOB 33:23">जो इंसान को बताए कि उसके लिए क्या ठीक है;<verse eid="JOB 33:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 33:24"/>तो वह उस पर रहम करता और कहता है,</para>
  <para style="q" vid="JOB 33:24">कि 'उसे गढ़े में जाने से बचा ले; मुझे फ़िदिया मिल गया है।<verse eid="JOB 33:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 33:25"/>तब उसका जिस्म बच्चे के जिस्म से भी ताज़ा होगा;</para>
  <para style="q" vid="JOB 33:25">और उसकी जवानी के दिन लौट आते हैं।<verse eid="JOB 33:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 33:26"/>वह ख़ुदा से दुआ करता है।</para>
  <para style="q" vid="JOB 33:26">और वह उस पर महेरबान होता है, ऐसा कि वह ख़ुशी से उसका मुँह देखता है;</para>
  <para style="q" vid="JOB 33:26">और वह इंसान की सच्चाई को बहाल कर देता है।<verse eid="JOB 33:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 33:27"/>वह लोगों के सामने गाने और कहने लगता है,</para>
  <para style="q" vid="JOB 33:27">कि'मैंने गुनाह किया और हक़ को उलट दिया,</para>
  <para style="q" vid="JOB 33:27">और इससे मुझे फ़ायदा न हुआ।<verse eid="JOB 33:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 33:28"/>उसने मेरी जान को गढ़े में जाने से बचाया,</para>
  <para style="q" vid="JOB 33:28">और मेरी ज़िन्दगी रोशनी को देखेगी।<verse eid="JOB 33:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 33:29"/>“देखो, ख़ुदा आदमी के साथ यह सब काम,</para>
  <para style="q" vid="JOB 33:29">दो बार बल्कि तीन बार करता है;<verse eid="JOB 33:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 33:30"/>ताकि उसकी जान को गढ़े से लौटा लाए,</para>
  <para style="q" vid="JOB 33:30">और वह ज़िन्दों के नूर से मुनव्वर हो।<verse eid="JOB 33:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 33:31"/>ऐ अय्यूब! ग़ौर से मेरी सुन;</para>
  <para style="q" vid="JOB 33:31">ख़ामोश रह और मैं बोलूँगा।<verse eid="JOB 33:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 33:32"/>अगर तुझे कुछ कहना है तो मुझे जवाब दे;</para>
  <para style="q" vid="JOB 33:32">बोल, क्यूँकि मैं तुझे रास्त ठहराना चाहता हूँ।<verse eid="JOB 33:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 33:33"/>अगर नहीं, तो मेरी सुन;</para>
  <para style="q" vid="JOB 33:33">ख़ामोश रह और मैं तुझे समझ सिखाऊँगा।”<verse eid="JOB 33:33"/></para>
  <chapter eid="JOB 33"/>
  <chapter number="34" style="c" sid="JOB 34"/>
  <para style="s">इलीहू का अय्यूब पर बदज़ुबानी का इल्ज़ाम लगाना</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 34:1"/>इसके 'अलावा इलीहू ने यह भी कहा,<verse eid="JOB 34:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 34:2"/>“ऐ तुम 'अक़्लमन्द लोगों, मेरी बातें सुनो,</para>
  <para style="q" vid="JOB 34:2">और ऐ तुम जो अहल — ए — 'इल्म हो, मेरी तरफ़ कान लगाओ;<verse eid="JOB 34:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 34:3"/>क्यूँकि कान बातों को परखता है,</para>
  <para style="q" vid="JOB 34:3">जैसे ज़बान' खाने को चखती है।<verse eid="JOB 34:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 34:4"/>जो कुछ ठीक है, हम अपने लिए चुन लें,</para>
  <para style="q" vid="JOB 34:4">जो भला है, हम आपस में जान लें।<verse eid="JOB 34:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 34:5"/>क्यूँकि अय्यूब ने कहा, 'मैं सादिक़ हूँ,</para>
  <para style="q" vid="JOB 34:5">और ख़ुदा ने मेरी हक़ तल्फ़ी की है।<verse eid="JOB 34:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 34:6"/>अगरचे मैं हक़ पर हूँ,</para>
  <para style="q" vid="JOB 34:6">तोभी झूटा ठहरता हूँ जबकि मैं बेक़ुसूर हूँ,</para>
  <para style="q" vid="JOB 34:6">मेरा ज़ख़्म ला 'इलाज है।<verse eid="JOB 34:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 34:7"/>अय्यूब जैसा बहादुर कौन है,</para>
  <para style="q" vid="JOB 34:7">जो मज़ाक़ को पानी की तरह पी जाता है?<verse eid="JOB 34:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 34:8"/>जो बदकिरदारों की रफ़ाफ़त में चलता है,</para>
  <para style="q" vid="JOB 34:8">और शरीर लोगों के साथ फिरता है।<verse eid="JOB 34:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 34:9"/>क्यूँकि उसने कहा है,</para>
  <para style="q" vid="JOB 34:9">कि 'आदमी को कुछ फ़ायदा नहीं कि वह ख़ुदा में ख़ुश है।”<verse eid="JOB 34:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 34:10"/>“इसलिए ऐ अहल — ए — अक़्ल मेरी सुनो,</para>
  <para style="q" vid="JOB 34:10">यह हरगिज़ हो नहीं सकता कि ख़ुदा शरारत का काम करे,</para>
  <para style="q" vid="JOB 34:10">और क़ादिर — ए — मुतलक़ गुनाह करे।<verse eid="JOB 34:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 34:11"/>वह इंसान को उसके आ'माल के मुताबिक़ बदला देगा,</para>
  <para style="q" vid="JOB 34:11">वह ऐसा करेगा कि हर किसी को अपनी ही राहों के मुताबिक़ बदला मिलेगा।<verse eid="JOB 34:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 34:12"/>यक़ीनन ख़ुदा बुराई नहीं करेगा;</para>
  <para style="q" vid="JOB 34:12">क़ादिर — ए — मुतलक़ से बेइन्साफ़ी न होगी।<verse eid="JOB 34:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 34:13"/>किसने उसको ज़मीन पर इख़्तियार दिया?</para>
  <para style="q" vid="JOB 34:13">या किसने सारी दुनिया का इन्तिज़ाम किया है?<verse eid="JOB 34:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 34:14"/>अगर वह इंसान से अपना दिल लगाए,</para>
  <para style="q" vid="JOB 34:14">अगर वह अपनी रूह और अपने दम को वापस ले ले;<verse eid="JOB 34:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 34:15"/>तो तमाम बशर इकट्ठे फ़ना हो जाएँगे,</para>
  <para style="q" vid="JOB 34:15">और इंसान फिर मिट्टी में मिल जाएगा।<verse eid="JOB 34:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 34:16"/>“इसलिए अगर तुझ में समझ है तो इसे सुन ले,</para>
  <para style="q" vid="JOB 34:16">और मेरी बातों पर तवज्जुह कर।<verse eid="JOB 34:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 34:17"/>क्या वह जो हक़ से 'अदावत रखता है, हुकूमत करेगा?</para>
  <para style="q" vid="JOB 34:17">और क्या तू उसे जो 'आदिल और क़ादिर है, मुल्ज़िम ठहराएगा?<verse eid="JOB 34:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 34:18"/>वह तो बादशाह से कहता है, 'तू रज़ील है';</para>
  <para style="q" vid="JOB 34:18">और शरीफ़ों से, कि 'तुम शरीर हो'।<verse eid="JOB 34:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 34:19"/>वह उमर की तरफ़दारी नहीं करता,</para>
  <para style="q" vid="JOB 34:19">और अमीर को ग़रीब से ज़्यादा नहीं मानता,</para>
  <para style="q" vid="JOB 34:19">क्यूँकि वह सब उसी के हाथ की कारीगरी हैं।<verse eid="JOB 34:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 34:20"/>वह दम भर में आधी रात को मर जाते हैं,</para>
  <para style="q" vid="JOB 34:20">लोग हिलाए जाते हैं और गुज़र जाते हैं</para>
  <para style="q" vid="JOB 34:20">और बहादुर लोग बगै़र हाथ लगाए उठा लिए जाते हैं।<verse eid="JOB 34:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 34:21"/>“क्यूँकि उसकी आँखें आदमी की राहों पर लगीं हैं,</para>
  <para style="q" vid="JOB 34:21">और वह उसकी आदतों को देखता है;<verse eid="JOB 34:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 34:22"/>न कोई ऐसी तारीकी न मौत का साया है,</para>
  <para style="q" vid="JOB 34:22">जहाँ बद किरदार छिप सकें।<verse eid="JOB 34:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 34:23"/>क्यूँकि उसे ज़रूरी नहीं कि आदमी का ज़्यादा ख़याल करे ताकि वह ख़ुदा के सामने 'अदालत में जाए।<verse eid="JOB 34:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 34:24"/>वह बिला तफ़तीश ज़बरदस्तों को टुकड़े — टुकड़े करता,</para>
  <para style="q" vid="JOB 34:24">और उनकी जगह औरों को खड़ा करता है।<verse eid="JOB 34:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 34:25"/>इसलिए वह उनके कामों का ख़याल रखता है,</para>
  <para style="q" vid="JOB 34:25">और वह उन्हें रात को उलट देता है ऐसा कि वह हलाक हो जाते हैं।<verse eid="JOB 34:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 34:26"/>वह औरों को देखते हुए, उनको ऐसा मारता है जैसा शरीरों को;<verse eid="JOB 34:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 34:27"/>इसलिए कि वह उसकी पैरवी से फिर गए,</para>
  <para style="q" vid="JOB 34:27">और उसकी किसी राह का ख़याल न किया।<verse eid="JOB 34:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 34:28"/>यहाँ तक कि उनकी वजह से ग़रीबों की फ़रियाद उसके सामने पहुँची</para>
  <para style="q" vid="JOB 34:28">और उसने मुसीबत ज़दों की फ़रियाद सुनी।<verse eid="JOB 34:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 34:29"/>जब वह राहत बख़्शे तो कौन मुल्ज़िम ठहरा सकता है?</para>
  <para style="q" vid="JOB 34:29">जब वह मुँह छिपा ले तो कौन उसे देख सकता है?</para>
  <para style="q" vid="JOB 34:29">चाहे कोई क़ौम हो या आदमी, दोनों के साथ यकसाँ सुलूक है।<verse eid="JOB 34:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 34:30"/>ताकि बेदीन आदमी सल्तनत न करे,</para>
  <para style="q" vid="JOB 34:30">और लोगों को फंदे में फंसाने के लिए कोई न हो।<verse eid="JOB 34:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 34:31"/>“क्यूँकि क्या किसी ने ख़ुदा से कहा है,</para>
  <para style="q" vid="JOB 34:31">मैंने सज़ा उठा ली है, मैं अब बुराई न करूँगा;<verse eid="JOB 34:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 34:32"/>जो मुझे दिखाई नहीं देता, वह तू मुझे सिखा;</para>
  <para style="q" vid="JOB 34:32">अगर मैंने गुनाह किया है तो अब ऐसा नहीं करूँगा'?<verse eid="JOB 34:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 34:33"/>क्या उसका बदला तेरी मर्ज़ी पर हो कि तू उसे ना मंज़ूर करता है?</para>
  <para style="q" vid="JOB 34:33">क्यूँकि तुझे फ़ैसला करना है न कि मुझे;</para>
  <para style="q" vid="JOB 34:33">इसलिए जो कुछ तू जानता है, कह दे।<verse eid="JOB 34:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 34:34"/>अहल — ए — अक़्ल मुझ से कहेंगे,</para>
  <para style="q" vid="JOB 34:34">बल्कि हर 'अक़्लमन्द जो मेरी सुनता है कहेगा,<verse eid="JOB 34:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 34:35"/>'अय्यूब नादानी से बोलता है,</para>
  <para style="q" vid="JOB 34:35">और उसकी बातें हिकमत से ख़ाली हैं।<verse eid="JOB 34:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="JOB 34:36"/>काश कि अय्यूब आख़िर तक आज़माया जाता,</para>
  <para style="q" vid="JOB 34:36">क्यूँकि वह शरीरों की तरह जवाब देता है।<verse eid="JOB 34:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JOB 34:37"/>इसलिए कि वह अपने गुनाहों पर बग़ावत को बढ़ाता है;</para>
  <para style="q" vid="JOB 34:37">वह हमारे बीच तालियाँ बजाता है,</para>
  <para style="q" vid="JOB 34:37">और ख़ुदा के ख़िलाफ़ बहुत बातें बनाता है।”<verse eid="JOB 34:37"/></para>
  <chapter eid="JOB 34"/>
  <chapter number="35" style="c" sid="JOB 35"/>
  <para style="s">इलीहू का अय्यूब को ख़ुदा के ईन्साफ़ के बारे में याद दिलाना</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 35:1"/>इसके 'अलावा इलीहू ने यह भी कहा,<verse eid="JOB 35:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 35:2"/>“क्या तू इसे अपना हक़ समझता है,</para>
  <para style="q" vid="JOB 35:2">या यह दा'वा करता है कि तेरी सदाक़त ख़ुदा की सदाक़त से ज़्यादा है?<verse eid="JOB 35:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 35:3"/>जो तू कहता है कि मुझे इससे क्या फ़ायदा मिलेगा?</para>
  <para style="q" vid="JOB 35:3">और मुझे इसमें गुनहगार न होने की निस्बत कौन सा ज़्यादा फ़ायदा होगा?<verse eid="JOB 35:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 35:4"/>मैं तुझे और तेरे साथ तेरे दोस्तों को जवाब दूँगा।<verse eid="JOB 35:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 35:5"/>आसमान की तरफ़ नज़र कर और देख;</para>
  <para style="q" vid="JOB 35:5">और आसमानों पर जो तुझ से बलन्द हैं, निगाह कर।<verse eid="JOB 35:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 35:6"/>अगर तू गुनाह करता है तो उसका क्या बिगाड़ता है?</para>
  <para style="q" vid="JOB 35:6">और अगर तेरी ख़ताएँ बढ़ जाएँ तो तू उसका क्या करता है?<verse eid="JOB 35:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 35:7"/>अगर तू सादिक़ है तो उसको क्या दे देता है?</para>
  <para style="q" vid="JOB 35:7">या उसे तेरे हाथ से क्या मिल जाता है?<verse eid="JOB 35:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 35:8"/>तेरी शरारत तुझ जैसे आदमी के लिए है,</para>
  <para style="q" vid="JOB 35:8">और तेरी सदाक़त आदमज़ाद के लिए।<verse eid="JOB 35:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 35:9"/>“जु़ल्म की कसरत की वजह से वह चिल्लाते हैं;</para>
  <para style="q" vid="JOB 35:9">ज़बरदस्त के बाज़ू की वजह से वह मदद के लिए दुहाई देतें हैं।<verse eid="JOB 35:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 35:10"/>लेकिन कोई नहीं कहता, कि 'ख़ुदा मेरा ख़ालिक़ कहाँ है,</para>
  <para style="q" vid="JOB 35:10">जो रात के वक़्त नगमें 'इनायत करता है?<verse eid="JOB 35:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 35:11"/>जो हम को ज़मीन के जानवरों से ज़्यादा ता'लीम देता है,</para>
  <para style="q" vid="JOB 35:11">और हमें हवा के परिन्दों से ज़्यादा 'अक़्लमन्द बनाता है?'<verse eid="JOB 35:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 35:12"/>वह दुहाई देते हैं लेकिन कोई जवाब नहीं देता,</para>
  <para style="q" vid="JOB 35:12">यह बुरे आदमियों के ग़ुरूर की वजह से है।<verse eid="JOB 35:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 35:13"/>यक़ीनन ख़ुदा बतालत को नहीं सुनेगा,</para>
  <para style="q" vid="JOB 35:13">और क़ादिर — ए — मुतलक़ उसका लिहाज़ न करेगा।<verse eid="JOB 35:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 35:14"/>ख़ासकर जब तू कहता है, कि तू उसे देखता नहीं।</para>
  <para style="q" vid="JOB 35:14">मुकद्दमा उसके सामने है और तू उसके लिए ठहरा हुआ है।<verse eid="JOB 35:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 35:15"/>लेकिन अब चूँकि उसने अपने ग़ज़ब में सज़ा न दी,</para>
  <para style="q" vid="JOB 35:15">और वह गु़रूर का ज़्यादा ख़याल नहीं करता;<verse eid="JOB 35:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 35:16"/>इसलिए अय्यूब ख़ुदबीनी की वजह से अपना मुँह खोलता है और नादानी से बातें बनाता है।”<verse eid="JOB 35:16"/></para>
  <chapter eid="JOB 35"/>
  <chapter number="36" style="c" sid="JOB 36"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 36:1"/>फ़िर इलीहू ने यह भी कहा,<verse eid="JOB 36:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 36:2"/>मुझे ज़रा इजाज़त दे और मैं तुझे बताऊँगा,</para>
  <para style="q" vid="JOB 36:2">क्यूँकि ख़ुदा की तरफ़ से मुझे कुछ और भी कहना है<verse eid="JOB 36:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 36:3"/>मैं अपने 'इल्म को दूर से लाऊँगा</para>
  <para style="q" vid="JOB 36:3">और रास्ती अपने खालिक़ से मनसूब करूँगा<verse eid="JOB 36:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 36:4"/>क्यूँकि हक़ीक़त में मेरी बातें झूटी नहीं हैं,</para>
  <para style="q" vid="JOB 36:4">और जो तेरे साथ है 'इल्म में कामिल हैं।<verse eid="JOB 36:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 36:5"/>देख ख़ुदा क़ादिर है, और किसी को बेकार नहीं जानता</para>
  <para style="q" vid="JOB 36:5">वह समझ की क़ुव्वत में ग़ालिब है।<verse eid="JOB 36:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 36:6"/>वह शरीरों की जिंदगी को बरक़रार नहीं रखता</para>
  <para style="q" vid="JOB 36:6">, बल्कि मुसीबत ज़दों को उनका हक़ अदा करता है।<verse eid="JOB 36:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 36:7"/>वह सादिक़ों से अपनी आँखे नहीं फेरता,</para>
  <para style="q" vid="JOB 36:7">बल्कि उन्हें बादशाहों के साथ हमेशा के लिए तख़्त पर बिठाता है।<verse eid="JOB 36:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 36:8"/>और वह सरफ़राज़ होते हैं और अगर वह बेड़ियों से जकड़े जाएं</para>
  <para style="q" vid="JOB 36:8">और मुसीबत की रस्सियों से बंधें,<verse eid="JOB 36:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 36:9"/>तो वह उन्हें उनका 'अमल और उनकी तक्सीरें दिखाता है,</para>
  <para style="q" vid="JOB 36:9">कि उन्होंने घमण्ड किया है।<verse eid="JOB 36:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 36:10"/>वह उनके कान को ता'लीम के लिए खोलता है,</para>
  <para style="q" vid="JOB 36:10">और हुक्म देता है कि वह गुनाह से बाज़ आयें।<verse eid="JOB 36:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 36:11"/>अगर वह सुन लें और उसकी इबादत करें तो अपने दिन इक़बालमंदी में</para>
  <para style="q" vid="JOB 36:11">और अपने बरस खु़शहाली में बसर करेंगे<verse eid="JOB 36:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 36:12"/>लेकिन अगर न सुनें तो वह तलवार से हलाक होंगे,</para>
  <para style="q" vid="JOB 36:12">और जिहालत में मरेंगे।<verse eid="JOB 36:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 36:13"/>लेकिन वह जो दिल में बे दीन हैं,</para>
  <para style="q" vid="JOB 36:13">ग़ज़ब को रख छोड़ते जब वह उन्हें बांधता है तो वह मदद के लिए दुहाई नहीं देते,<verse eid="JOB 36:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 36:14"/>वह जवानी में मरतें हैं</para>
  <para style="q" vid="JOB 36:14">और उनकी ज़िन्दगी छोटों के बीच में बर्बाद होता है।<verse eid="JOB 36:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 36:15"/>वह मुसीबत ज़दह को मुसीबत से छुड़ाता है,</para>
  <para style="q" vid="JOB 36:15">और ज़ुल्म में उनके कान खोलता है।<verse eid="JOB 36:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 36:16"/>बल्कि वह तुझे भी दुख से छुटकारा दे कर ऐसी वसी' जगह में जहाँ तंगी नहीं है पहुँचा देता</para>
  <para style="q" vid="JOB 36:16">और जो कुछ तेरे दस्तरख़्वान पर चुना जाता है वह चिकनाई से पुर होता है।<verse eid="JOB 36:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 36:17"/>लेकिन तू तो शरीरों के मुक़द्दमा की ता'ईद करता है,</para>
  <para style="q" vid="JOB 36:17">इसलिए 'अदल और इन्साफ़ तुझ पर क़ाबिज़ हैं।<verse eid="JOB 36:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 36:18"/>ख़बरदार तेरा क़हर तुझ से तक्फ़ीर न कराए</para>
  <para style="q" vid="JOB 36:18">और फ़िदया की फ़रादानी तुझे गुमराह न करे।<verse eid="JOB 36:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 36:19"/>क्या तेरा रोना या तेरा ज़ोर व तवानाई इस बात के लिए काफ़ी है कि तू मुसीबत में न पड़े।<verse eid="JOB 36:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 36:20"/>उस रात की ख़्वाहिश न कर,</para>
  <para style="q" vid="JOB 36:20">जिसमें क़ौमें अपने घरों से उठा ली जाती हैं।<verse eid="JOB 36:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 36:21"/>होशियार रह, गुनाह की तरफ़ राग़िब न हो,</para>
  <para style="q" vid="JOB 36:21">क्यूँकि तू ने मुसीबत को नहीं बल्कि इसी को चुना है।<verse eid="JOB 36:21"/></para>
  <para style="s">इलीहू का अय्यूब को ख़ुदा की ताकत का याद दिलाना</para>
  <para style="p">
    <verse number="22" style="v" sid="JOB 36:22"/>देख, ख़ुदा अपनी क़ुदरत से बड़े — बड़े काम करता है।</para>
  <para style="q" vid="JOB 36:22">कौन सा उस्ताद उसकी तरह है?<verse eid="JOB 36:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 36:23"/>किसने उसे उसका रास्ता बताया?</para>
  <para style="q" vid="JOB 36:23">या कौन कह सकता है कि तू ने नारास्ती की है?<verse eid="JOB 36:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 36:24"/>'उसके काम की बड़ाई करना याद रख,</para>
  <para style="q" vid="JOB 36:24">जिसकी ता'रीफ़ लोग करते रहे हैं।<verse eid="JOB 36:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 36:25"/>सब लोगों ने इसको देखा है,</para>
  <para style="q" vid="JOB 36:25">इंसान उसे दूर से देखता है।<verse eid="JOB 36:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 36:26"/>देख, ख़ुदा बुज़ुर्ग है और हम उसे नहीं जानते,</para>
  <para style="q" vid="JOB 36:26">उसके बरसों का शुमार दरियाफ़्त से बाहर है।<verse eid="JOB 36:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 36:27"/>क्यूँकि वह पानी के क़तरों को ऊपर खींचता है,</para>
  <para style="q" vid="JOB 36:27">जो उसी के अबख़िरात से मेंह की सूरत में टपकते हैं;<verse eid="JOB 36:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 36:28"/>जिनकी फ़लाक उंडेलते,</para>
  <para style="q" vid="JOB 36:28">और इंसान पर कसरत से बरसाते हैं।<verse eid="JOB 36:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 36:29"/>बल्कि क्या कोई बादलों के फैलाव,</para>
  <para style="q" vid="JOB 36:29">और उसके शामियाने की गरजों को समझ सकता है?<verse eid="JOB 36:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 36:30"/>देख, वह अपने नूर को अपने चारों तरफ़ फैलाता है,</para>
  <para style="q" vid="JOB 36:30">और समन्दर की तह को ढाँकता है।<verse eid="JOB 36:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 36:31"/>क्यूँकि इन्हीं से वह क़ौमों का इन्साफ़ करता है,</para>
  <para style="q" vid="JOB 36:31">और ख़ूराक इफ़रात से 'अता फ़रमाता है।<verse eid="JOB 36:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 36:32"/>वह बिजली को अपने हाथों में लेकर,</para>
  <para style="q" vid="JOB 36:32">उसे हुक्म देता है कि दुश्मन पर गिरे।<verse eid="JOB 36:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 36:33"/>इसकी कड़क उसी की ख़बर देती है,</para>
  <para style="q" vid="JOB 36:33">चौपाये भी तूफ़ान की आमद बताते हैं।<verse eid="JOB 36:33"/></para>
  <chapter eid="JOB 36"/>
  <chapter number="37" style="c" sid="JOB 37"/>
  <para style="q">
    <verse number="1" style="v" sid="JOB 37:1"/>इस बात से भी मेरा दिल काँपता है</para>
  <para style="q" vid="JOB 37:1">और अपनी जगह से उछल पड़ता है।<verse eid="JOB 37:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 37:2"/>ज़रा उसके बोलने की आवाज़ को सुनो,</para>
  <para style="q" vid="JOB 37:2">और उस ज़मज़मा को जो उसके मुँह से निकलता है।<verse eid="JOB 37:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 37:3"/>वह उसे सारे आसमान के नीचे,</para>
  <para style="q" vid="JOB 37:3">और अपनी बिजली को ज़मीन की इन्तिहा तक भेजता है।<verse eid="JOB 37:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 37:4"/>इसके बाद कड़क की आवाज़ आती है;</para>
  <para style="q" vid="JOB 37:4">वह अपने जलाल की आवाज़ से गरजता है,</para>
  <para style="q" vid="JOB 37:4">और जब उसकी आवाज़ सुनाई देती है तो वह उसे रोकता है।<verse eid="JOB 37:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 37:5"/>ख़ुदा 'अजीब तौर पर अपनी आवाज़ से गरजता है।</para>
  <para style="q" vid="JOB 37:5">वह बड़े बड़े काम करता है जिनको हम समझ नहीं सकते।<verse eid="JOB 37:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 37:6"/>क्यूँकि वह बर्फ़ को फ़रमाता है कि तू ज़मीन पर गिर,</para>
  <para style="q" vid="JOB 37:6">इसी तरह वह बारिश से और मूसलाधार मेह से कहता है।<verse eid="JOB 37:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 37:7"/>वह हर आदमी के हाथ पर मुहर कर देता है,</para>
  <para style="q" vid="JOB 37:7">ताकि सब लोग जिनको उसने बनाया है, इस बात को जान लें।<verse eid="JOB 37:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 37:8"/>तब दरिन्दे ग़ारों में घुस जाते,</para>
  <para style="q" vid="JOB 37:8">और अपनी अपनी माँद में पड़े रहते हैं।<verse eid="JOB 37:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 37:9"/>ऑधी दख्खिन की कोठरी से,</para>
  <para style="q" vid="JOB 37:9">और सर्दी उत्तर से आती है।<verse eid="JOB 37:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 37:10"/>ख़ुदा के दम से बर्फ़ जम जाती है,</para>
  <para style="q" vid="JOB 37:10">और पानी का फैलाव तंग हो जाता है।<verse eid="JOB 37:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 37:11"/>बल्कि वह घटा पर नमी को लादता है,</para>
  <para style="q" vid="JOB 37:11">और अपने बिजली वाले बादलों को दूर तक फैलाता है।<verse eid="JOB 37:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 37:12"/>उसी की हिदायत से वह इधर उधर फिराए जाते हैं,</para>
  <para style="q" vid="JOB 37:12">ताकि जो कुछ वह उन्हें फ़रमाए,</para>
  <para style="q" vid="JOB 37:12">उसी को वह दुनिया के आबाद हिस्से पर अंजाम दें।<verse eid="JOB 37:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 37:13"/>चाहे तम्बीह के लिए या अपने मुल्क के लिए,</para>
  <para style="q" vid="JOB 37:13">या रहमत के लिए वह उसे भेजे।<verse eid="JOB 37:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 37:14"/>“ऐ अय्यूब, इसको सुन ले; चुपचाप खड़ा रह,</para>
  <para style="q" vid="JOB 37:14">और ख़ुदा के हैरतअंगेज़ कामों पर ग़ौर कर।<verse eid="JOB 37:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 37:15"/>क्या तुझे मा'लूम है कि ख़ुदा क्यूँकर उन्हें ताकीद करता है</para>
  <para style="q" vid="JOB 37:15">और अपने बादल की बिजली को चमकाता है?<verse eid="JOB 37:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 37:16"/>क्या तू बादलों के मुवाज़ने से वाक़िफ़ है?</para>
  <para style="q" vid="JOB 37:16">यह उसी के हैरतअंगेज़ काम हैं जो 'इल्म में कामिल है।<verse eid="JOB 37:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 37:17"/>जब ज़मीन पर दख्खिनी हवा की वजह से सन्नाटा होता है तो तेरे कपड़े क्यूँ गर्म हो जाते हैं?<verse eid="JOB 37:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 37:18"/>क्या तू उसके साथ फ़लक को फैला सकता है जो ढले हुए आइने की तरह मज़बूत है?<verse eid="JOB 37:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 37:19"/>हम को सिखा कि हम उस से क्या कहें,</para>
  <para style="q" vid="JOB 37:19">क्यूँकि अंधेरे की वजह से हम अपनी तक़रीर को दुरुस्त नहीं कर सकते?<verse eid="JOB 37:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 37:20"/>क्या उसको बताया जाए कि मैं बोलना चाहता हूँ?</para>
  <para style="q" vid="JOB 37:20">या क्या कोई आदमी यह ख़्वाहिश करे कि वह निगल लिया जाए?<verse eid="JOB 37:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 37:21"/>“अभी तो आदमी उस नूर को नहीं देखते जो असमानों पर रोशन है,</para>
  <para style="q" vid="JOB 37:21">लेकिन हवा चलती है और उन्हें साफ़ कर देती है।<verse eid="JOB 37:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 37:22"/>दख्खिनी से सुनहरी रोशनी आती है,</para>
  <para style="q" vid="JOB 37:22">ख़ुदा मुहीब शौकत से मुलब्बस है।<verse eid="JOB 37:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 37:23"/>हम क़ादिर — ए — मुतलक़ को पा नहीं सकते,</para>
  <para style="q" vid="JOB 37:23">वह क़ुदरत और 'अद्ल में शानदार है,</para>
  <para style="q" vid="JOB 37:23">और इन्साफ़ की फ़िरावानी में ज़ुल्म न करेगा।<verse eid="JOB 37:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 37:24"/>इसीलिए लोग उससे डरते हैं;</para>
  <para style="q" vid="JOB 37:24">वह अक़्लमन्ददिलों की परवाह नहीं करता।”<verse eid="JOB 37:24"/></para>
  <chapter eid="JOB 37"/>
  <chapter number="38" style="c" sid="JOB 38"/>
  <para style="s">ख़ुदावन्द का अय्यूब को ललकारना</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 38:1"/>तब ख़ुदावन्द ने अय्यूब को बगोले में से यूँ जवाब दिया,<verse eid="JOB 38:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 38:2"/>“यह कौन है जो नादानी की बातों से,</para>
  <para style="q" vid="JOB 38:2">मसलहत पर पर्दा डालता है?”<verse eid="JOB 38:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 38:3"/>मर्द की तरह अब अपनी कमर कस ले,</para>
  <para style="q" vid="JOB 38:3">क्यूँकि मैं तुझ से सवाल करता हूँ और तू मुझे बता।<verse eid="JOB 38:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 38:4"/>“तू कहाँ था, जब मैंने ज़मीन की बुनियाद डाली?</para>
  <para style="q" vid="JOB 38:4">तू 'अक़्लमन्द है तो बता।<verse eid="JOB 38:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 38:5"/>क्या तुझे मा'लूम है किसने उसकी नाप ठहराई?</para>
  <para style="q" vid="JOB 38:5">या किसने उस पर सूत खींचा?<verse eid="JOB 38:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 38:6"/>किस चीज़ पर उसकी बुनियाद डाली गई',</para>
  <para style="q" vid="JOB 38:6">या किसने उसके कोने का पत्थर बिठाया,<verse eid="JOB 38:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 38:7"/>जब सुबह के सितारे मिलकर गाते थे,</para>
  <para style="q" vid="JOB 38:7">और ख़ुदा के सब बेटे ख़ुशी से ललकारते थे?<verse eid="JOB 38:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 38:8"/>“या किसने समन्दर को दरवाज़ों से बंद किया,</para>
  <para style="q" vid="JOB 38:8">जब वह ऐसा फूट निकला जैसे रहम से,<verse eid="JOB 38:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 38:9"/>जब मैंने बादल को उसका लिबास बनाया,</para>
  <para style="q" vid="JOB 38:9">और गहरी तारीकी को उसका लपेटने का कपड़ा,<verse eid="JOB 38:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 38:10"/>और उसके लिए हद ठहराई,</para>
  <para style="q" vid="JOB 38:10">और बेन्डू और किवाड़ लगाए,<verse eid="JOB 38:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 38:11"/>और कहा, 'यहाँ तक तू आना, लेकिन आगे नहीं,</para>
  <para style="q" vid="JOB 38:11">और यहाँ तक तेरी बिछड़ती हुई मौजें रुक जाएँगी'?<verse eid="JOB 38:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 38:12"/>“क्या तू ने अपनी उम्र में कभी सुबह पर हुकमरानी की,</para>
  <para style="q" vid="JOB 38:12">दिया और क्या तूने फ़ज्र को उसकी जगह बताई,<verse eid="JOB 38:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 38:13"/>ताकि वह ज़मीन के किनारों पर क़ब्ज़ा करे,</para>
  <para style="q" vid="JOB 38:13">और शरीर लोग उसमें से झाड़ दिए जाएँ?<verse eid="JOB 38:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 38:14"/>वह ऐसे बदलती है जैसे मुहर के नीचे चिकनी मिटटी<verse eid="JOB 38:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 38:15"/>और तमाम चीज़ें कपड़े की तरह नुमाया हो जाती हैं,</para>
  <para style="q" vid="JOB 38:15">और और शरीरों से उसकी बन्दगी रुक जाती है और बुलन्द बाज़ू तोड़ा जाता है।<verse eid="JOB 38:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 38:16"/>“क्या तू समन्दर के सोतों में दाख़िल हुआ है?</para>
  <para style="q" vid="JOB 38:16">या गहराव की थाह में चला है?<verse eid="JOB 38:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 38:17"/>क्या मौत के फाटक तुझ पर ज़ाहिर कर दिए गए हैं?</para>
  <para style="q" vid="JOB 38:17">या तू ने मौत के साये के फाटकों को देख लिया है?<verse eid="JOB 38:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 38:18"/>क्या तू ने ज़मीन की चौड़ाई को समझ लिया है?</para>
  <para style="q" vid="JOB 38:18">अगर तू यह सब जानता है तो बता।<verse eid="JOB 38:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 38:19"/>“नूर के घर का रास्ता कहाँ है?</para>
  <para style="q" vid="JOB 38:19">रही तारीकी, इसलिए उसका मकान कहाँ है?<verse eid="JOB 38:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 38:20"/>ताकि तू उसे उसकी हद तक पहुँचा दे,</para>
  <para style="q" vid="JOB 38:20">और उसके मकान की राहों को पहचाने?<verse eid="JOB 38:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 38:21"/>बेशक तू जानता होगा; क्यूँकि तू उस वक़्त पैदा हुआ था,</para>
  <para style="q" vid="JOB 38:21">और तेरे दिनों का शुमार बड़ा है।<verse eid="JOB 38:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 38:22"/>क्या तू बर्फ़ के मख़ज़नों में दाख़िल हुआ है,</para>
  <para style="q" vid="JOB 38:22">या ओलों के मखज़नों को तूने देखा है,<verse eid="JOB 38:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 38:23"/>जिनको मैंने तकलीफ़ के वक़्त के लिए,</para>
  <para style="q" vid="JOB 38:23">और लड़ाई और जंग के दिन की ख़ातिर रख छोड़ा है?<verse eid="JOB 38:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 38:24"/>रोशनी किस तरीक़े से तक़सीम होती है,</para>
  <para style="q" vid="JOB 38:24">या पूरबी हवा ज़मीन पर फैलाई जाती है?<verse eid="JOB 38:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 38:25"/>सैलाब के लिए किसने नाली काटी,</para>
  <para style="q" vid="JOB 38:25">या कड़क की बिजली के लिए रास्ता,<verse eid="JOB 38:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 38:26"/>ताकि उसे गै़र आबाद ज़मीन पर बरसाए और वीरान पर जिसमें इंसान नहीं बसता,<verse eid="JOB 38:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 38:27"/>ताकि उजड़ी और सूनी ज़मीन को सेराब करे, और नर्म — नर्म घास उगाए?<verse eid="JOB 38:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 38:28"/>क्या बारिश का कोई बाप है,</para>
  <para style="q" vid="JOB 38:28">या शबनम के क़तरे किससे तवल्लुद हुए?<verse eid="JOB 38:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 38:29"/>यख़ किस के बतन निकला से निकला है,</para>
  <para style="q" vid="JOB 38:29">और आसमान के सफ़ेद पाले को किसने पैदा किया?<verse eid="JOB 38:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 38:30"/>पानी पत्थर सा हो जाता है,</para>
  <para style="q" vid="JOB 38:30">और गहराव की सतह जम जाती है।<verse eid="JOB 38:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 38:31"/>“क्या तू 'अक़्द — ए — सुरैया को बाँध सकता,</para>
  <para style="q" vid="JOB 38:31">या जब्बार के बंधन को खोल सकता है,<verse eid="JOB 38:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 38:32"/>क्या तू मिन्तक़्तू — उल — बुरूज को उनके वक़्तों पर निकाल सकता है?</para>
  <para style="q" vid="JOB 38:32">या बिनात — उन — ना'श की उनकी सहेलियों के साथ रहबरी कर सकता है?<verse eid="JOB 38:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 38:33"/>क्या तू आसमान के क़वानीन को जानता है,</para>
  <para style="q" vid="JOB 38:33">और ज़मीन पर उनका इख़्तियार क़ाईम कर सकता है?<verse eid="JOB 38:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 38:34"/>क्या तू बादलों तक अपनी आवाज़ बुलन्द कर सकता है,</para>
  <para style="q" vid="JOB 38:34">ताकि पानी की फ़िरावानी तुझे छिपा ले?<verse eid="JOB 38:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 38:35"/>क्या तू बिजली को रवाना कर सकता है कि वह जाए,</para>
  <para style="q" vid="JOB 38:35">और तुझ से कहे मैं हाज़िर हूँ?<verse eid="JOB 38:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="JOB 38:36"/>बातिन में हिकमत किसने रख्खी,</para>
  <para style="q" vid="JOB 38:36">और दिल को अक़्ल किसने बख़्शी?<verse eid="JOB 38:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JOB 38:37"/>बादलों को हिकमत से कौन गिन सकता है?</para>
  <para style="q" vid="JOB 38:37">या कौन आसमान की मश्कों को उँडेल सकता है,<verse eid="JOB 38:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="JOB 38:38"/>जब गर्द मिलकर तूदा बन जाती है,</para>
  <para style="q" vid="JOB 38:38">और ढेले एक साथ मिल जाते हैं?”<verse eid="JOB 38:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="JOB 38:39"/>“क्या तू शेरनी के लिए शिकार मार देगा,</para>
  <para style="q" vid="JOB 38:39">या बबर के बच्चों को सेर करेगा,<verse eid="JOB 38:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="JOB 38:40"/>जब वह अपनी माँदों में बैठे हों,</para>
  <para style="q" vid="JOB 38:40">और घात लगाए आड़ में दुबक कर बैठे हों?<verse eid="JOB 38:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="JOB 38:41"/>पहाड़ी कौवे के लिए कौन ख़ूराक मुहैया करता है, जब उसके बच्चे ख़ुदा से फ़रियाद करते,</para>
  <para style="q" vid="JOB 38:41">और ख़ूराक न मिलने से उड़ते फिरते हैं?”<verse eid="JOB 38:41"/></para>
  <chapter eid="JOB 38"/>
  <chapter number="39" style="c" sid="JOB 39"/>
  <para style="s">ख़ुदावन्द का ललकारना जारी रहता है</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 39:1"/>क्या तू जनता है कि पहाड़ पर की जंगली बकरियाँ कब बच्चे देती हैं?</para>
  <para style="q" vid="JOB 39:1">या जब हिरनीयाँ बियाती हैं, तो क्या तू देख सकता है?<verse eid="JOB 39:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 39:2"/>क्या तू उन महीनों को जिन्हें वह पूरा करती हैं, गिन सकता है?</para>
  <para style="q" vid="JOB 39:2">या तुझे वह वक़्त मा'लूम है जब वह बच्चे देती हैं?<verse eid="JOB 39:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 39:3"/>वह झुक जाती हैं;</para>
  <para style="q" vid="JOB 39:3">वह अपने बच्चे देती हैं, और अपने दर्द से रिहाई पाती हैं।<verse eid="JOB 39:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 39:4"/>उनके बच्चे मोटे ताज़े होते हैं; वह खुले मैदान में बढ़ते हैं।</para>
  <para style="q" vid="JOB 39:4">वह निकल जाते हैं और फिर नहीं लौटते।<verse eid="JOB 39:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 39:5"/>गधे को किसने आज़ाद किया?</para>
  <para style="q" vid="JOB 39:5">जंगली गधे के बंद किसने खोले?<verse eid="JOB 39:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 39:6"/>वीरान को मैंने उसका मकान बनाया,</para>
  <para style="q" vid="JOB 39:6">और ज़मीन — ए — शोर को उसका घर।<verse eid="JOB 39:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 39:7"/>वह शहर के शोर — ओ — गु़ल को हेच समझता है,</para>
  <para style="q" vid="JOB 39:7">और हाँकने वाले की डॉट को नहीं सुनता।<verse eid="JOB 39:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 39:8"/>पहाड़ों का सिलसिला उसकी चरागाह है,</para>
  <para style="q" vid="JOB 39:8">और वह हरियाली की तलाश में रहता है।<verse eid="JOB 39:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 39:9"/>“क्या जंगली साँड तेरी ख़िदमत पर राज़ी होगा?</para>
  <para style="q" vid="JOB 39:9">क्या वह तेरी चरनी के पास रहेगा?<verse eid="JOB 39:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 39:10"/>क्या तू जंगली साँड को रस्से से बाँधकर रेघारी में चला सकता है?</para>
  <para style="q" vid="JOB 39:10">या वह तेरे पीछे — पीछे वादियों में हेंगा फेरेगा?<verse eid="JOB 39:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 39:11"/>क्या तू उसकी बड़ी ताक़त की वजह से उस पर भरोसा करेगा?</para>
  <para style="q" vid="JOB 39:11">या क्या तू अपना काम उस पर छोड़ देगा?<verse eid="JOB 39:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 39:12"/>क्या तू उस पर भरोसा करेगा कि वह तेरा ग़ल्ला घर ले आए,</para>
  <para style="q" vid="JOB 39:12">और तेरे खलीहान का अनाज इकट्ठा करे?<verse eid="JOB 39:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 39:13"/>“शुतरमुर्ग़ के बाज़ू आसूदा हैं,</para>
  <para style="q" vid="JOB 39:13">लेकिन क्या उसके पर — ओ — बाल से शफ़क़त ज़ाहिर होती है?<verse eid="JOB 39:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 39:14"/>क्यूँकि वह तो अपने अंडे ज़मीन पर छोड़ देती है,</para>
  <para style="q" vid="JOB 39:14">और रेत से उनको गर्मी पहुँचाती है;<verse eid="JOB 39:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 39:15"/>और भूल जाती है कि वह पाँव से कुचले जाएँगे,</para>
  <para style="q" vid="JOB 39:15">या कोई जंगली जानवर उनको रौंद डालेगा।<verse eid="JOB 39:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 39:16"/>वह अपने बच्चों से ऐसी सख़्तदिली करती है कि जैसे वह उसके नहीं।</para>
  <para style="q" vid="JOB 39:16">चाहे उसकी मेहनत रायगाँ जाए उसे कुछ ख़ौफ़ नहीं।<verse eid="JOB 39:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 39:17"/>क्यूँकि ख़ुदा ने उसे 'अक़्ल से महरूम रखा,</para>
  <para style="q" vid="JOB 39:17">और उसे समझ नहीं दी।<verse eid="JOB 39:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 39:18"/>जब वह तनकर सीधी खड़ी हो जाती है,</para>
  <para style="q" vid="JOB 39:18">तो घोड़े और उसके सवार दोनों को नाचीज़ समझती हैं।<verse eid="JOB 39:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 39:19"/>“क्या घोड़े को उसका ताक़त तू ने दी है?</para>
  <para style="q" vid="JOB 39:19">क्या उसकी गर्दन की लहराती अयाल से तूने मुलब्बस किया?<verse eid="JOB 39:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 39:20"/>क्या उसे टिड्डी की तरह तूने कुदाया है?</para>
  <para style="q" vid="JOB 39:20">उसके फ़राने की शान मुहीब है।<verse eid="JOB 39:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 39:21"/>वह वादी में टाप मारता है और अपने ज़ोर में ख़ुश है।</para>
  <para style="q" vid="JOB 39:21">वह हथियारबंद आदमियों का सामना करने को निकलता है।<verse eid="JOB 39:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 39:22"/>वह ख़ौफ़ को नाचीज़ जानता है और घबराता नहीं,</para>
  <para style="q" vid="JOB 39:22">और वह तलवार से मुँह नहीं मोड़ता।<verse eid="JOB 39:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 39:23"/>तर्कश उस पर खड़खड़ाता है,</para>
  <para style="q" vid="JOB 39:23">चमकता हुआ भाला और साँग भी;<verse eid="JOB 39:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 39:24"/>वह तुन्दी और क़हर में ज़मीन पैमाई करता है,</para>
  <para style="q" vid="JOB 39:24">और उसे यक़ीन नहीं होता कि यह तुर ही की आवाज़ है।<verse eid="JOB 39:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 39:25"/>जब जब तुरही बजती है, वह हिन हिन करता है,</para>
  <para style="q" vid="JOB 39:25">और लड़ाई को दूर से सूँघ लेता है; सरदारों की गरज़ और ललकार को भी।<verse eid="JOB 39:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 39:26"/>“क्या बा'ज़ तेरी हिकमत से उड़ता है,</para>
  <para style="q" vid="JOB 39:26">और दख्खिन की तरफ़ अपने बाज़ू फैलाता है?<verse eid="JOB 39:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 39:27"/>क्या 'उक़ाब तेरे हुक्म से ऊपर चढ़ता है,</para>
  <para style="q" vid="JOB 39:27">और बुलन्दी पर अपना घोंसला बनाता है?<verse eid="JOB 39:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 39:28"/>वह चट्टान पर रहता और वहीं बसेरा करता है;</para>
  <para style="q" vid="JOB 39:28">या'नी चट्टान की चोटी पर और पनाह की जगह में।<verse eid="JOB 39:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 39:29"/>वहीं से वह शिकार ताड़ लेता है</para>
  <para style="q" vid="JOB 39:29">, उसकी आँखें उसे दूर से देख लेती हैं।<verse eid="JOB 39:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 39:30"/>उसके बच्चे भी खू़न चूसते हैं,</para>
  <para style="q" vid="JOB 39:30">और जहाँ मक़्तूल हैं वहाँ वह भी है।”<verse eid="JOB 39:30"/></para>
  <chapter eid="JOB 39"/>
  <chapter number="40" style="c" sid="JOB 40"/>
  <para style="q">
    <verse number="1" style="v" sid="JOB 40:1"/>ख़ुदावन्द ने अय्यूब से यह भी कहा,<verse eid="JOB 40:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 40:2"/>“क्या जो फु़जू़ल हुज्जत करता है वह क़ादिर — ए — मुतलक़ से झगड़ा करे?</para>
  <para style="q" vid="JOB 40:2">जो ख़ुदा से बहस करता है, वह इसका जवाब दे।”<verse eid="JOB 40:2"/></para>
  <para style="s">अय्यूब का ख़ुदावन्द से बात करना</para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 40:3"/>अय्यूब का जवाब तब अय्यूब ने ख़ुदावन्द को जवाब दिया,<verse eid="JOB 40:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 40:4"/>“देख, मैं नाचीज़ हूँ! मैं तुझे क्या जवाब दूँ?</para>
  <para style="q" vid="JOB 40:4">मैं अपना हाथ अपने मुँह पर रखता हूँ।<verse eid="JOB 40:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 40:5"/>अब जवाब न दूँगा; एक बार मैं बोल चुका,</para>
  <para style="q" vid="JOB 40:5">बल्कि दो बार लेकिन अब आगे न बढ़ूँगा।”<verse eid="JOB 40:5"/></para>
  <para style="s">ख़ुदावन्द का अय्यूब को फिर से ललकारना</para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 40:6"/>तब ख़ुदावन्द ने अय्यूब को बगोले में से जवाब दिया,<verse eid="JOB 40:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 40:7"/>मर्द की तरह अब अपनी कमर कस ले,</para>
  <para style="q" vid="JOB 40:7">मैं तुझ से सवाल करता हूँ और तू मुझे बता।<verse eid="JOB 40:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 40:8"/>क्या तू मेरे इन्साफ़ को भी बातिल ठहराएगा?<verse eid="JOB 40:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 40:9"/>क्या तू मुझे मुजरिम ठहराएगा ताकि ख़ुद रास्त ठहरे?</para>
  <para style="q" vid="JOB 40:9">या क्या तेरा बाज़ू ख़ुदा के जैसा है?</para>
  <para style="q" vid="JOB 40:9">और क्या तू उसकी तरह आवाज़ से गरज़ सकता है?<verse eid="JOB 40:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 40:10"/>'अब अपने को शान — ओ — शौकत से आरास्ता कर,</para>
  <para style="q" vid="JOB 40:10">और 'इज़्जत — ओ — जलाल से मुलब्बस हो जा।<verse eid="JOB 40:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 40:11"/>अपने क़हर के सैलाबों को बहा दे,</para>
  <para style="q" vid="JOB 40:11">और हर मग़रूर को देख और ज़लील कर।<verse eid="JOB 40:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 40:12"/>हर मग़रूर को देख और उसे नीचा कर,</para>
  <para style="q" vid="JOB 40:12">और शरीरों को जहाँ खड़े हों पामाल कर दे।<verse eid="JOB 40:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 40:13"/>उनको इकट्ठा मिट्टी में छिपा दे,</para>
  <para style="q" vid="JOB 40:13">और उस पोशीदा मक़ाम में उनके मुँह बाँध दे।<verse eid="JOB 40:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 40:14"/>तब मैं भी तेरे बारे में मान लूँगा,</para>
  <para style="q" vid="JOB 40:14">कि तेरा ही दहना हाथ तुझे बचा सकता है।<verse eid="JOB 40:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 40:15"/>'अब हिप्पो पोटीमस' को देख, जिसे मैंने तेरे साथ बनाया;</para>
  <para style="q" vid="JOB 40:15">वह बैल की तरह घास खाता है।<verse eid="JOB 40:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 40:16"/>देख, उसकी ताक़त उसकी कमर में है,</para>
  <para style="q" vid="JOB 40:16">और उसका ज़ोर उसके पेट के पट्ठों में।<verse eid="JOB 40:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 40:17"/>वह अपनी दुम को देवदार की तरह हिलाता है,</para>
  <para style="q" vid="JOB 40:17">उसकी रानों की नसे एक साथ पैवस्ता हैं।<verse eid="JOB 40:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 40:18"/>उसकी हड्डियाँ पीतल के नलों की तरह हैं,</para>
  <para style="q" vid="JOB 40:18">उसके आ'ज़ा लोहे के बेन्डों की तरह हैं।<verse eid="JOB 40:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 40:19"/>वह ख़ुदा की ख़ास सन'अत' है;</para>
  <para style="q" vid="JOB 40:19">उसके ख़ालिक़ ही ने उसे तलवार बख़्शी है।<verse eid="JOB 40:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 40:20"/>यक़ीनन टीले उसके लिए ख़ूराक एक साथ पहुँचाते हैं</para>
  <para style="q" vid="JOB 40:20">जहाँ मैदान के सब जानवर खेलते कूदते हैं।<verse eid="JOB 40:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 40:21"/>वह कंवल के दरख़्त के नीचे लेटता है,</para>
  <para style="q" vid="JOB 40:21">सरकंडों की आड़ और दलदल में।<verse eid="JOB 40:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 40:22"/>कंवल के दरख़्त उसे अपने साये के नीचे छिपा लेते हैं।</para>
  <para style="q" vid="JOB 40:22">नाले के बीदे उसे घेर लेतीं हैं।<verse eid="JOB 40:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 40:23"/>देख, अगर दरिया में बाढ़ हो तो वह नहीं काँपता चाहे यरदन उसके मुँह तक चढ़ आये वह बे खौफ़ है।<verse eid="JOB 40:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 40:24"/>जब वह होशियार हो, तो क्या कोई उसे पकड़ लेगा;</para>
  <para style="q" vid="JOB 40:24">या फंदा लगाकर उसकी नाक को छेदेगा?<verse eid="JOB 40:24"/></para>
  <chapter eid="JOB 40"/>
  <chapter number="41" style="c" sid="JOB 41"/>
  <para style="s">ख़ुदावन्द का ललकारना जारी रहना</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 41:1"/>क्या तू मगर कोशिस्त से बाहर निकाल सकता है</para>
  <para style="q" vid="JOB 41:1">या रस्सी से उसकी ज़बान को दबा सकता है?<verse eid="JOB 41:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 41:2"/>क्या तू उसकी नाक में रस्सी डाल सकता है?</para>
  <para style="q" vid="JOB 41:2">या उसका जबड़ा मेख़ से छेद सकता है?<verse eid="JOB 41:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 41:3"/>क्या वह तेरी बहुत मिन्नत समाजत करेगा?</para>
  <para style="q" vid="JOB 41:3">या तुझ से मीठी मीठी बातें कहेगा?<verse eid="JOB 41:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 41:4"/>क्या वह तेरे साथ 'अहद बांधेगा,</para>
  <para style="q" vid="JOB 41:4">कि तू उसे हमेशा के लिए नौकर बना ले?<verse eid="JOB 41:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 41:5"/>क्या तू उससे ऐसे खेलेगा जैसे परिन्दे से?</para>
  <para style="q" vid="JOB 41:5">या क्या तू उसे अपनी लड़कियों के लिए बाँध देगा?<verse eid="JOB 41:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 41:6"/>क्या लोग उसकी तिजारत करेंगे?</para>
  <para style="q" vid="JOB 41:6">क्या वह उसे सौदागरों में तक़सीम करेंगे?<verse eid="JOB 41:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 41:7"/>क्या तू उसकी खाल को भालों से,</para>
  <para style="q" vid="JOB 41:7">या उसके सिर को माहीगीर के तरसूलों से भर सकता है?<verse eid="JOB 41:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 41:8"/>तू अपना हाथ उस पर धरे,</para>
  <para style="q" vid="JOB 41:8">तो लड़ाई को याद रख्खेगा और फिर ऐसा न करेगा।<verse eid="JOB 41:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 41:9"/>देख, उसके बारे में उम्मीद बेफ़ायदा है।</para>
  <para style="q" vid="JOB 41:9">क्या कोई उसे देखते ही गिर न पड़ेगा?<verse eid="JOB 41:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 41:10"/>कोई ऐसा तुन्दख़ू नहीं जो उसे छेड़ने की हिम्मत न करे।</para>
  <para style="q" vid="JOB 41:10">फिर वह कौन है जो मेरे सामने खड़ा होसके?<verse eid="JOB 41:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 41:11"/>किस ने मुझे पहले कुछ दिया है कि मैं उसे अदा करूँ?</para>
  <para style="q" vid="JOB 41:11">जो कुछ सारे आसमान के नीचे है वह मेरा है।<verse eid="JOB 41:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 41:12"/>न मैं उसके 'आज़ा के बारे में ख़ामोश रहूँगा न उसकी ताक़त</para>
  <para style="q" vid="JOB 41:12">और ख़ूबसूरत डील डोल के बारे में।<verse eid="JOB 41:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 41:13"/>उसके ऊपर का लिबास कौन उतार सकता है?</para>
  <para style="q" vid="JOB 41:13">उसके जबड़ों के बीच कौन आएगा?<verse eid="JOB 41:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 41:14"/>उसके मुँह के किवाड़ों को कौन खोल सकता है?</para>
  <para style="q" vid="JOB 41:14">उसके दाँतों का दायरा दहशत नाक है।<verse eid="JOB 41:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 41:15"/>उसकी ढालें उसका फ़ख़्र हैं;</para>
  <para style="q" vid="JOB 41:15">जो जैसा सख़्त मुहर से पैवस्ता की गई हैं।<verse eid="JOB 41:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 41:16"/>वह एक दूसरी से ऐसी जुड़ी हुई हैं,</para>
  <para style="q" vid="JOB 41:16">कि उनके बीच हवा भी नहीं आ सकती।<verse eid="JOB 41:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 41:17"/>वह एक दूसरी से एक साथ पैवस्ता हैं;</para>
  <para style="q" vid="JOB 41:17">वह आपस में ऐसी जुड़ी हैं कि जुदा नहीं हो सकतीं।<verse eid="JOB 41:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 41:18"/>उसकी छींकें नूर अफ़्शानी करती हैं</para>
  <para style="q" vid="JOB 41:18">उसकी आँखें सुबह के पपोटों की तरह हैं।<verse eid="JOB 41:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 41:19"/>उसके मुँह से जलती मश'अलें निकलती हैं,</para>
  <para style="q" vid="JOB 41:19">और आग की चिंगारियाँ उड़ती हैं।<verse eid="JOB 41:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 41:20"/>उसके नथनों से धुवाँ निकलता है,</para>
  <para style="q" vid="JOB 41:20">जैसे खौलती देग और सुलगते सरकंडे से।<verse eid="JOB 41:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 41:21"/>उसका साँस से कोयलों को दहका देता है,</para>
  <para style="q" vid="JOB 41:21">और उसके मुँह से शो'ले निकलते हैं।<verse eid="JOB 41:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 41:22"/>ताक़त उसकी गर्दन में बसती है,</para>
  <para style="q" vid="JOB 41:22">और दहशत उसके आगे आगे चलती “है।<verse eid="JOB 41:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 41:23"/>उसके गोश्त की तहें आपस में जुड़ी हुई हैं;</para>
  <para style="q" vid="JOB 41:23">वह उस पर ख़ूब जुड़ी हैं और हट नहीं सकतीं।<verse eid="JOB 41:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 41:24"/>उसका दिल पत्थर की तरह मज़बूत है,</para>
  <para style="q" vid="JOB 41:24">बल्कि चक्की के निचले पाट की तरह।<verse eid="JOB 41:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 41:25"/>जब ख़ुदा उठ खड़ा होता है, तो ज़बरदस्त लोग डर जाते हैं,</para>
  <para style="q" vid="JOB 41:25">और घबराकर ख़ौफ़ज़दा हो जाते हैं।<verse eid="JOB 41:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 41:26"/>अगर कोई उस पर तलवार चलाए,</para>
  <para style="q" vid="JOB 41:26">तो उससे कुछ नहीं बनता: न भाले, न तीर, न बरछी से।<verse eid="JOB 41:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 41:27"/>वह लोहे को भूसा समझता है,</para>
  <para style="q" vid="JOB 41:27">और पीतल को गली हुई लकड़ी।<verse eid="JOB 41:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 41:28"/>तीर उसे भगा नहीं सकता,</para>
  <para style="q" vid="JOB 41:28">फ़लाख़न के पत्थर उस पर तिनके से हैं।<verse eid="JOB 41:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 41:29"/>लाठियाँ जैसे तिनके हैं,</para>
  <para style="q" vid="JOB 41:29">वह बर्छी के चलने पर हँसता है।<verse eid="JOB 41:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 41:30"/>उसके नीचे के हिस्से तेज़ ठीकरों की तरह हैं;</para>
  <para style="q" vid="JOB 41:30">वह कीचड़ पर जैसे हेंगा फेरता है।<verse eid="JOB 41:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 41:31"/>वह गहराव को देग की तरह खौलाता,</para>
  <para style="q" vid="JOB 41:31">और समुन्दर को मरहम की तरह बना देता है।<verse eid="JOB 41:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 41:32"/>वह अपने पीछे चमकीला निशान छोड़ जाता है;</para>
  <para style="q" vid="JOB 41:32">गहराव गोया सफ़ेद नज़र आने लगता है।<verse eid="JOB 41:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 41:33"/>ज़मीन पर उसका नज़ीर नहीं,</para>
  <para style="q" vid="JOB 41:33">जो ऐसा बेख़ौफ़ पैदा हुआ हो।<verse eid="JOB 41:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 41:34"/>वह हर ऊँची चीज़ को देखता है,</para>
  <para style="q" vid="JOB 41:34">और सब मग़रूरों का बादशाह है।”<verse eid="JOB 41:34"/></para>
  <chapter eid="JOB 41"/>
  <chapter number="42" style="c" sid="JOB 42"/>
  <para style="s">अय्यूब का खु़दावन्द को जवाब देना</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 42:1"/>तब अय्यूब ने ख़ुदावन्द यूँ जवाब दिया<verse eid="JOB 42:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 42:2"/>“मैं जानता हूँ कि तू सब कुछ कर सकता है,</para>
  <para style="q" vid="JOB 42:2">और तेरा कोई इरादा रुक नहीं सकता।<verse eid="JOB 42:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 42:3"/>यह कौन है जो नादानी से मसलहत पर पर्दा डालता है?”</para>
  <para style="q" vid="JOB 42:3">लेकिन मैंने जो न समझा वही कहा,</para>
  <para style="q" vid="JOB 42:3">या'नी ऐसी बातें जो मेरे लिए बहुत 'अजीब थीं जिनको मैं जानता न था।<verse eid="JOB 42:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 42:4"/>'मैं तेरी मिन्नत करता हूँ सुन,</para>
  <para style="q" vid="JOB 42:4">मैं कुछ कहूँगा। मैं तुझ से सवाल करूँगा, तू मुझे बता।<verse eid="JOB 42:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 42:5"/>मैंने तेरी ख़बर कान से सुनी थी,</para>
  <para style="q" vid="JOB 42:5">लेकिन अब मेरी आँख तुझे देखती है;<verse eid="JOB 42:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 42:6"/>इसलिए मुझे अपने आप से नफ़रत है,</para>
  <para style="q" vid="JOB 42:6">और मैं ख़ाक और राख में तौबा करता हूँ।”<verse eid="JOB 42:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 42:7"/>और ऐसा हुआ कि जब ख़ुदावन्द यह बातें अय्यूब से कह चुका, तो उसने इलिफ़ज़ तेमानी से कहा कि “मेरा ग़ज़ब तुझ पर और तेरे दोनों दोस्तों पर भड़का है, क्यूँकि तुम ने मेरे बारे में वह बात न कही जो हक़ है, जैसे मेरे बन्दे अय्यूब ने कही। <verse eid="JOB 42:7"/><verse number="8" style="v" sid="JOB 42:8"/>इसलिए अब अपने लिए सात बैल और सात मेंढे लेकर, मेरे बन्दे अय्यूब के पास जाओ और अपने लिए सोख़्तनी कु़र्बानी पेश करो, और मेरा बन्दा अय्यूब तुम्हारे लिए दुआ करेगा; क्यूँकि उसे तो मैं क़ुबूल करूँगा ताकि तुम्हारी जिहालत के मुताबिक़ तुम्हारे साथ सुलूक न करूँ, क्यूँकि तुम ने मेरे बारे में वह बात न कही जो हक़ है, जैसे मेरे बन्दे अय्यूब ने कही।” <verse eid="JOB 42:8"/><verse number="9" style="v" sid="JOB 42:9"/>इसलिए इलिफ़ज़ तेमानी, और बिलदद सूखी और जूफ़र ना'माती ने जाकर जैसा ख़ुदावन्द ने उनको फ़रमाया था किया, और ख़ुदावन्द ने अय्यूब को क़ुबूल किया। <verse eid="JOB 42:9"/><verse number="10" style="v" sid="JOB 42:10"/>और ख़ुदावन्द ने अय्यूब की ग़ुलामी को जब उसने अपने दोस्तों के लिए दुआ की बदल दिया और ख़ुदावन्द ने अय्यूब को जितने उसके पास पहले था उसका दो गुना दे दिया। <verse eid="JOB 42:10"/><verse number="11" style="v" sid="JOB 42:11"/>तब उसके सब भाई और सब बहनें और उसके सब अगले जान — पहचान उसके पास आए, और उसके घर में उसके साथ खाना खाया; और उस पर नौहा किया और उन सब बलाओं के बारे में, जो ख़ुदावन्द ने उस पर नाज़िल की थीं, उसे तसल्ली दी। हर शख़्स ने उसे एक सिक्का भी दिया और हर एक ने सोने की एक बाली। <verse eid="JOB 42:11"/><verse number="12" style="v" sid="JOB 42:12"/>यूँ ख़ुदावन्द ने अय्यूब के आख़िरी दिनों में शुरू'आत की निस्बत ज़्यादा बरकत बख़्शी; और उसके पास चौदह हज़ार भेड़ बकरियाँ, और छ: हज़ार ऊँट, और हज़ार जोड़ी बैल, और हज़ार गधियाँ, हो गईं। <verse eid="JOB 42:12"/><verse number="13" style="v" sid="JOB 42:13"/>उसके सात बेटे और तीन बेटियाँ भी हुई। <verse eid="JOB 42:13"/><verse number="14" style="v" sid="JOB 42:14"/>और उसने पहली का नाम यमीमा और दूसरी का नाम क़स्याह और तीसरी का नाम क़रन — हप्पूक रख्खा। <verse eid="JOB 42:14"/><verse number="15" style="v" sid="JOB 42:15"/>और उस सारी सर ज़मीन में ऐसी 'औरतें कहीं न थीं, जो अय्यूब की बेटियों की तरह ख़ूबसूरत हों, और उनके बाप ने उनको उनके भाइयों के बीच मीरास दी। <verse eid="JOB 42:15"/><verse number="16" style="v" sid="JOB 42:16"/>और इसके बाद अय्यूब एक सौ चालीस बरस ज़िन्दा रहा, और अपने बेटे और पोते चौथी पुश्त तक देखे। <verse eid="JOB 42:16"/><verse number="17" style="v" sid="JOB 42:17"/>और अय्यूब ने बुड्ढा और बुज़ुर्ग होकर वफ़ात पाई।<verse eid="JOB 42:17"/></para>
  <chapter eid="JOB 42"/>
</usx>
