<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">मत्ती</para>
  <para style="toc1">मत्ती</para>
  <para style="toc2">मत्त</para>
  <para style="toc3">मत्त</para>
  <para style="mt">मुक़द्दस मत्ती की मा'रिफ़त इन्जील</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">मत्ती जो इस किताब का मुसन्निफ़ है एक महसूल लेने वाला था जिस ने येसू के पीछे चलने के लिए अपना पेशा छोड़ दिया था (मत्ती 9:9, 13) मरक़ुम और लूक़ा अपनी किताबों में उसको लावी करके हवाला पेश करते हैं। उसके नाम के मायने हैं ख़ुदावन्द का इनाम! इब्तिदाई कलीसिया के बुज़ुर्ग एक साथ मिलकर मत्ती को इस किताब का मुसन्निफ़ होने और बारह रसूलों में से एक होने को मंजूरी देते हैं। मत्ती येसू के वाक़िआत का आँखों देखी गवाह था, यानी कि उसकी खि़दमत गुज़ारी का। मत्ती की इन्जील का मवाज़िना दीगर अनाजील के साथ करके मुताला करने पर वाक़िआत साबित करते हैं कि मसीह की पैग़म्बराना गवाही को तक़सीम नहीं किया गया था।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इस की तस्नीफ़ की तारीख़ तक़रीबन 50 - 70 ईस्वी के आस पास है।</para>
  <para style="ip">मत्ती की इनजील जो यहूदियों के तर्ज पर है ग़ौर करने पर मालूम पड़ता है कि यह फ़लसतीन या सीरिया में लिखी गई है, हालांकि बहुत से उलमा इस को अन्ताकिया में लिखे जाने पर इत्तफ़ाक़ रखते हैं।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">चूंकि मत्ती की इन्जील इब्रानी जुबान में लिखी गई थी तो मत्ती ने ऐसे क़ारिईन को इस की तरफ़ मायल किया जो इब्रानी बोलने वाले यहूदी क़ौम के लोग थे। इन्जील के कई एक इब्तिदाई उसूल यहूदी मतन में आलिम होने की तरफ़ इशारा करते हैं। मत्ती ने पुराने अहदनामे की बातें मसीह में पूरा होने की तरफ़ ध्यान दिया। उसका येसू के नसबनामे में अब्राहम को शामिल करना; (1:1, 17) उसका यहूदी इसतिलाहियात का इस्तेमाल करना (मिसाल बतौर, आस्मान की बादशाही, जहां यहूदी लोग ख़ुदा के नाम को बे फ़ाइदा लेने से गुरेज़ करते हैं और येसू को ख़ुदा का बेटा कहने के बदले इब्न — ए — दाऊद का इस्तेमाल करना; 1:1; 9:27; 12:23; 15:22; 20:30, 31; 21, 21:9, 15; 22:41, 45) यह सब इस बात की तरफ़ इशारा करते हैं कि मत्ती ने ज़्यादातर यहूदी क़ौम की तरफ़ ध्यान दिया।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">इस इन्जील को मत्ती जब लिख रहा था तो उस का मुद्दा यहूदी क़ारिईन को बा ज़ाबिता एलान करना था कि येसू ही मसीहा है। यहां पूरा ध्यान इस तरफ़ दिया गया है कि ख़ुदा की बादशाही को बनी इंसान के लिए लाए जाने का दा‘वा करे। अपनी इन्जील में मत्ती येसू को बादशाह बतौर होने पर ज़ोर देता है जो पुराने अहदनामे की नबुवतों और तवक़्क़ों को पूरा करता है (मत्ती 1:1; 16:16; 20:28)।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">येसू — यहूदियों का बादशाह।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. येसू की पैदाइश — 1:1-2:23</para>
  <para style="io1">2. येसू की गलील की खि़दमतगुज़ारी — 3:1-18:35</para>
  <para style="io1">3. येसू की यहूदिया की खि़दमतगुज़ारी — 19:1-20:34</para>
  <para style="io1">4. यहूदिया में आख़री अय्याम — 21:1-27:66</para>
  <para style="io1">5. आख़री वाक़िआत — 28:1-20</para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s">ईसा मसीह का नसबनामा</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>ईसा मसीह इबने दाऊद इबने इब्राहीम का नसबनामा। <verse eid="MAT 1:1"/><verse number="2" style="v" sid="MAT 1:2"/>इब्राहीम से इज़्हाक़ पैदा हुआ, और इज़्हाक़ से याक़ूब पैदा हुआ, और या'क़ूब से यहूदा और उस के भाई पैदा हुए; <verse eid="MAT 1:2"/><verse number="3" style="v" sid="MAT 1:3"/>और यहूदा से फ़ारस और ज़ारह तमर से पैदा हुए, और फ़ारस से हसरोंन पैदा हुआ, और हसरोंन से राम पैदा हुआ; <verse eid="MAT 1:3"/><verse number="4" style="v" sid="MAT 1:4"/>और राम से अम्मीनदाब पैदा हुआ, और अम्मीनदाब से नह्सोन पैदा हुआ, और नह्सोन से सलमोन पैदा हुआ; <verse eid="MAT 1:4"/><verse number="5" style="v" sid="MAT 1:5"/>और सलमोन से बो'अज़ राहब से पैदा हुआ, और बो'अज़ से ओबेद रूत से पैदा हुआ, और ओबेद से यस्सी पैदा हुआ; <verse eid="MAT 1:5"/><verse number="6" style="v" sid="MAT 1:6"/>और यस्सी से दाऊद बादशाह पैदा हुआ। और दाऊद से सुलैमान उस 'औरत से पैदा हुआ जो पहले ऊरिय्याह की बीवी थी; <verse eid="MAT 1:6"/><verse number="7" style="v" sid="MAT 1:7"/>और सुलैमान से रहुब'आम पैदा हुआ, और रहुब'आम से अबिय्याह पैदा हुआ, और अबिय्याह से आसा पैदा हुआ; <verse eid="MAT 1:7"/><verse number="8" style="v" sid="MAT 1:8"/>और आसा से यहूसफ़त पैदा हुआ, और यहूसफ़त से यूराम पैदा हुआ, और यूराम से उज़्ज़ियाह पैदा हुआ; <verse eid="MAT 1:8"/><verse number="9" style="v" sid="MAT 1:9"/>उज़्ज़ियाह से यूताम पैदा हुआ, और यूताम से आख़ज़ पैदा हुआ, और आख़ज़ से हिज़क़ियाह पैदा हुआ; <verse eid="MAT 1:9"/><verse number="10" style="v" sid="MAT 1:10"/>और हिज़क़ियाह से मनस्सी पैदा हुआ, और मनस्सी से अमून पैदा हुआ, और अमून से यूसियाह पैदा हुआ; <verse eid="MAT 1:10"/><verse number="11" style="v" sid="MAT 1:11"/>और गिरफ़्तार होकर बाबुल जाने के ज़माने में यूसियाह से यकुनियाह और उस के भाई पैदा हुए; <verse eid="MAT 1:11"/><verse number="12" style="v" sid="MAT 1:12"/>और गिरफ़्तार होकर बाबुल जाने के बाद यकुनियाह से सियालतीएल पैदा हुआ, और सियालतीएल से ज़रुब्बाबुल पैदा हुआ। <verse eid="MAT 1:12"/><verse number="13" style="v" sid="MAT 1:13"/>और ज़रुब्बाबुल से अबीहूद पैदा हुआ, और अबीहूद से इलियाक़ीम पैदा हुआ, और इलियाक़ीम से आज़ोर पैदा हुआ; <verse eid="MAT 1:13"/><verse number="14" style="v" sid="MAT 1:14"/>और आज़ोर से सदोक़ पैदा हुआ, और सदोक़ से अख़ीम पैदा हुआ, और अख़ीम से इलीहूद पैदा हुआ; <verse eid="MAT 1:14"/><verse number="15" style="v" sid="MAT 1:15"/>और इलीहूद से इलीअज़र पैदा हुआ, और अलीअज़र से मत्तान पैदा हुआ, और मत्तान से याक़ूब पैदा हुआ; <verse eid="MAT 1:15"/><verse number="16" style="v" sid="MAT 1:16"/>और याक़ूब से यूसुफ़ पैदा हुआ, ये उस मरियम का शौहर था जिस से ईसा पैदा हुआ, जो मसीह कहलाता है। <verse eid="MAT 1:16"/><verse number="17" style="v" sid="MAT 1:17"/>पस सब पुश्तें इब्राहीम से दाऊद तक चौदह पुश्तें हुईं, और दाऊद से लेकर गिरफ़्तार होकर बाबुल जाने तक चौदह पुश्तें, और गिरफ़्तार होकर बाबुल जाने से लेकर मसीह तक चौदह पुश्तें हुईं।<verse eid="MAT 1:17"/></para>
  <para style="s">ईसा मसीह की पैदाइश</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>अब ईसा मसीह की पैदाइश इस तरह हुई कि जब उस की माँ मरियम की मंगनी यूसुफ़ के साथ हो गई: तो उन के एक साथ होने से पहले वो रूह — उल क़ुद्दूस की क़ुदरत से हामिला पाई गई। <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>पस उस के शौहर यूसुफ़ ने जो रास्तबाज़ था, और उसे बदनाम नहीं करना चाहता था। उसे चुपके से छोड़ देने का इरादा किया। <verse eid="MAT 1:19"/><verse number="20" style="v" sid="MAT 1:20"/>वो ये बातें सोच ही रहा था, कि ख़ुदावन्द के फ़रिश्ते ने उसे ख़्वाब में दिखाई देकर कहा, ऐ यूसुफ़ “इबने दाऊद अपनी बीवी मरियम को अपने यहाँ ले आने से न डर; क्यूँकि जो उस के पेट में है, वो रूह — उल — क़ुद्दूस की क़ुदरत से है। <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>उस के बेटा होगा और तू उस का नाम ईसा रखना, क्यूँकि वह अपने लोगों को उन के गुनाहों से नजात देगा।” <verse eid="MAT 1:21"/><verse number="22" style="v" sid="MAT 1:22"/>यह सब कुछ इस लिए हुआ कि जो ख़ुदावन्द ने नबी के ज़रिए कहा था, वो पूरा हो कि। <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>“देखो एक कुँवारी हामिला होगी। और बेटा जनेंगी और उस का नाम इम्मानुएल रखेंगे,” जिसका मतलब है — ख़ुदा हमारे साथ। <verse eid="MAT 1:23"/><verse number="24" style="v" sid="MAT 1:24"/>पस यूसुफ़ ने नींद से जाग कर वैसा ही किया जैसा ख़ुदावन्द के फ़रिश्ते ने उसे हुक्म दिया था, और अपनी बीवी को अपने यहाँ ले गया। <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>और उस को न जाना जब तक उस के बेटा न हुआ और उस का नाम ईसा रख्खा।<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s">मजूसियों की आमद</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>जब ईसा हेरोदेस बादशाह के ज़माने में यहूदिया के बैत — लहम में पैदा हुआ। तो देखो कई मजूसी पूरब से येरूशलेम में ये कहते हुए आए। <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>“यहूदियों का बादशाह जो पैदा हुआ है, वो कहाँ है? क्यूँकि पूरब में उस का सितारा देखकर हम उसे सज्दा करने आए हैं।” <verse eid="MAT 2:2"/><verse number="3" style="v" sid="MAT 2:3"/>यह सुन कर हेरोदेस बादशाह और उस के साथ येरूशलेम के सब लोग घबरा गए। <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>और उस ने क़ौम के सब सरदार काहिनों और आलिमों को जमा करके उन से पूछा, “मसीह की पैदाइश कहाँ होनी चाहिए?” <verse eid="MAT 2:4"/><verse number="5" style="v" sid="MAT 2:5"/>उन्हों ने उस से कहा, यहूदिया के बैत-लहम में, क्यूँकि नबी के ज़रिए यूँ लिखा गया है कि,<verse eid="MAT 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 2:6"/>“ऐ बैत-लहम, यहूदिया के 'इलाक़े तू यहूदाह के हाकिमों में हरगिज़ सब से छोटा नहीं। क्यूँकि तुझ में से एक सरदार निकलेगा जो मेरी क़ौम इस्राईल की निगहबानी करेगा।” <verse eid="MAT 2:6"/><verse number="7" style="v" sid="MAT 2:7"/>इस पर हेरोदेस ने मजूसियों को चुपके से बुला कर उन से मालूम किया कि वह सितारा किस वक़्त दिखाई दिया था। <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>और उन्हें ये कह कर “बैतलहम भेजा कि जा कर उस बच्चे के बारे में ठीक — ठीक मालूम करो और जब वो मिले तो मुझे ख़बर दो ताकि मैं भी आ कर उसे सिज्दा करूँ।” <verse eid="MAT 2:8"/><verse number="9" style="v" sid="MAT 2:9"/>वो बादशाह की बात सुनकर रवाना हुए और देखो, जो सितारा उन्होंने पूरब में देखा था; वो उनके आगे — आगे चला; यहाँ तक कि उस जगह के ऊपर जाकर ठहर गया जहाँ वो बच्चा था। <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>वो सितारे को देख कर निहायत ख़ुश हुए। <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>और उस घर में पहुँचकर बच्चे को उस की माँ मरियम के पास देखा; और उसके आगे गिर कर सिज्दा किया। और अपने डिब्बे खोल कर सोना, और लुबान और मुर उसको नज़्र किया। <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>और हेरोदेस के पास फिर न जाने की हिदायत ख़्वाब में पाकर दूसरी राह से अपने मुल्क को रवाना हुए।<verse eid="MAT 2:12"/></para>
  <para style="s">मिस्र के मुल्क को जाना</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>जब वो रवाना हो गए तो देखो ख़ुदावन्द के फ़रिश्ते ने यूसुफ़ को ख़्वाब में दिखाई देकर कहा, “उठ बच्चे और उस की माँ को साथ लेकर मिस्र को भाग जा: और जब तक कि मैं तुझ से न कहूँ वहीं रहना; क्यूँकि हेरोदेस इस बच्चे को तलाश करने को है, ताकि इसे हलाक करे।” <verse eid="MAT 2:13"/><verse number="14" style="v" sid="MAT 2:14"/>पस वो उठा और रात के वक़्त बच्चे और उस की माँ को साथ ले कर मिस्र के लिए रवाना हो गया। <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>और हेरोदेस के मरने तक वहीं रहा ताकि जो ख़ुदावन्द ने नबी के ज़रिए कहा था, वो पूरा हो “कि मिस्र से मैंने अपने बेटे को बुलाया।”<verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>जब हेरोदेस ने देखा कि मजूसियों ने मेरे साथ हँसी की तो निहायत ग़ुस्सा हुआ और आदमी भेजकर बैतलहम और उसकी सब सरहदों के अन्दर के उन सब लड़कों को क़त्ल करवा दिया जो दो — दो बरस के या इस से छोटे थे, उस वक़्त के हिसाब से जो उसने मजूसियों से तहक़ीक़ की थी। <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>उस वक़्त वो बात पूरी हुई जो यर्मियाह नबी के ज़रिए कही गई थी। <verse eid="MAT 2:17"/><verse number="18" style="v" sid="MAT 2:18"/>“रामा में आवाज़ सुनाई दी, रोना और बड़ा मातम। राख़िल अपने बच्चे को रो रही है और तसल्ली क़बूल नहीं करती, इसलिए कि वो नहीं हैं।”<verse eid="MAT 2:18"/></para>
  <para style="s">मिस्र से वापसी</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>जब हेरोदेस मर गया, तो देखो ख़ुदावन्द के फ़रिश्ते ने मिस्र में यूसुफ़ को ख़्वाब में दिखाई देकर कहा कि। <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>उठ इस बच्चे और इसकी माँ को लेकर इस्राईल के मुल्क में चला जा, क्यूँकि जो बच्चे की जान लेने वाले थे वो मर गए <verse eid="MAT 2:20"/><verse number="21" style="v" sid="MAT 2:21"/>पस वो उठा और बच्चे और उस की माँ को ले कर मुल्क — ए — इस्राईल में लौट आया। <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>मगर जब सुना कि अर्ख़िलाउस अपने बाप हेरोदेस की जगह यहूदिया में बादशाही करता है तो वहाँ जाने से डरा, और ख़्वाब में हिदायत पाकर गलील के 'इलाक़े को रवाना हो गया। <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>और नासरत नाम एक शहर में जा बसा, ताकि जो नबियों की मारिफ़त कहा गया था वो पूरा हो, “वह नासरी कहलाएगा।”<verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s">यूहन्ना बपतिस्मा देने वाला</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>उन दिनों में युहन्ना बपतिस्मा देने वाला आया और यहूदिया के वीराने में ये ऐलान करने लगा कि, <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>“तौबा करो, क्यूँकि आस्मान की बादशाही नज़दीक आ गई है।” <verse eid="MAT 3:2"/><verse number="3" style="v" sid="MAT 3:3"/>ये वही है जिस का ज़िक्र यसायाह नबी के ज़रिए यूँ हुआ कि वीराने में पुकारने वाले की आवाज़ आती है, कि ख़ुदावन्द की राह तैयार करो! उसके रास्ते सीधे बनाओ।<verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>ये यूहन्ना ऊँटों के बालों की पोशाक पहने और चमड़े का पटका अपनी कमर से बाँधे रहता था। और इसकी ख़ुराक टिड्डियाँ और जंगली शहद था। <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>उस वक़्त येरूशलेम, और सारे यहूदिया और यरदन और उसके आस पास के सब लोग निकल कर उस के पास गए। <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>और अपने गुनाहों का इक़रार करके। यरदन नदी में उस से बपतिस्मा लिया? <verse eid="MAT 3:6"/><verse number="7" style="v" sid="MAT 3:7"/>मगर जब उसने बहुत से फ़रीसियों और सदूक़ियों को बपतिस्मे के लिए अपने पास आते देखा तो उनसे कहा कि, ऐ साँप के बच्चो तुम को किस ने बता दिया कि आने वाले ग़ज़ब से भागो? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>पस तौबा के मुताबिक़ फल लाओ। <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>और अपने दिलों में ये कहने का ख़याल न करो कि अब्रहाम हमारा बाप है क्यूँकि मैं तुम से कहता हूँ, कि ख़ुदा “इन पत्थरों से अब्रहाम के लिए औलाद पैदा कर सकता है। <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>अब दरख़्तों की जड़ पर कुल्हाड़ा रख्खा हुआ है पस, जो दरख़्त अच्छा फल नहीं लाता वो काटा और आग में डाला जाता है।<verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>“मैं तो तुम को तौबा के लिए पानी से बपतिस्मा देता हूँ, लेकिन जो मेरे बाद आता है मुझ से बड़ा है; मैं उसकी जूतियाँ उठाने के लायक़ नहीं। वो तुम को रूह — उल कुददूस और आग से बपतिस्मा देगा। <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>उस का छाज उसके हाथ में है और वो अपने खलियान को ख़ूब साफ़ करेगा, और अपने गेहूँ को तो खित्ते में जमा करेगा, मगर भूसी को उस आग में जलाएगा जो बुझने वाली नहीं।”<verse eid="MAT 3:12"/></para>
  <para style="s">यूहन्ना के ज़रिए ईसा का बपतिस्मा</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>उस वक़्त ईसा गलील से यर्दन के किनारे यूहन्ना के पास उस से बपतिस्मा लेने आया। <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>मगर यूहन्ना ये कह कर उसे मनह करने लगा, “मैं आप तुझ से बपतिस्मा लेने का मोहताज हूँ, और तू मेरे पास आया है?” <verse eid="MAT 3:14"/><verse number="15" style="v" sid="MAT 3:15"/>ईसा ने जवाब में उस से कहा, <char style="wj">“अब तू होने ही दे, क्यूँकि हमें इसी तरह सारी रास्तबाज़ी पूरी करना मुनासिब है।</char> इस पर उस ने होने दिया।” <verse eid="MAT 3:15"/><verse number="16" style="v" sid="MAT 3:16"/>और ईसा बपतिस्मा लेकर फ़ौरन पानी के ऊपर आया। और देखो, उस के लिए आस्मान खुल गया और उस ने ख़ुदा की रूह को कबूतर की शक्ल में उतरते और अपने ऊपर आते देखा। <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>और देखो आसमान से ये आवाज़ आई: “ये मेरा प्यारा बेटा है जिससे मैं ख़ुश हूँ।”<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s">ईसा की आज़माइश</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>उस वक़्त रूह ईसा को जंगल में ले गया ताकि इब्लीस से आज़माया जाए। <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>और चालीस दिन और चालीस रात फ़ाक़ा कर के आख़िर को उसे भूख लगी। <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>और आज़माने वाले ने पास आकर उस से कहा “अगर तू ख़ुदा का बेटा है तो फ़रमा कि ये पत्थर रोटियाँ बन जाएँ।” <verse eid="MAT 4:3"/><verse number="4" style="v" sid="MAT 4:4"/>उस ने जवाब में कहा, <char style="wj">“लिखा है आदमी सिर्फ़ रोटी ही से ज़िन्दा न रहेगा; बल्कि हर एक बात से जो ख़ुदा के मुँह से निकलती है।”</char><verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>तब इब्लीस उसे मुक़द्दस शहर में ले गया और हैकल के कंगूरे पर खड़ा करके उस से कहा। <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>“अगर तू ख़ुदा का बेटा है तो अपने आपको नीचे गिरा दे; क्यूँकि लिखा है कि वह तेरे बारे में अपने फ़रिश्तों को हुक्म देगा, और वह तुझे अपने हाथों पर उठा लेंगे ताकि ऐसा न हो कि तेरे पैर को पत्थर से ठेस लगे’।” <verse eid="MAT 4:6"/><verse number="7" style="v" sid="MAT 4:7"/>ईसा ने उस से कहा, <char style="wj">“ये भी लिखा है; तू ख़ुदावन्द अपने ख़ुदा की आज़माइश न कर।”</char> <verse eid="MAT 4:7"/><verse number="8" style="v" sid="MAT 4:8"/>फिर इब्लीस उसे एक बहुत ऊँचे पहाड़ पर ले गया, और दुनिया की सब सल्तनतें और उन की शान — ओ शौकत उसे दिखाई। <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>और उससे कहा कि अगर तू झुक कर मुझे सज्दा करे तो ये सब कुछ तुझे दे दूँगा <verse eid="MAT 4:9"/><verse number="10" style="v" sid="MAT 4:10"/>ईसा ने उस से कहा, <char style="wj">“ऐ शैतान दूर हो क्यूँकि लिखा है, तू ख़ुदावन्द अपने ख़ुदा को सज्दा कर और सिर्फ़ उसी की इबादत कर।”</char> <verse eid="MAT 4:10"/><verse number="11" style="v" sid="MAT 4:11"/>तब इब्लीस उस के पास से चला गया; और देखो फ़रिश्ते आ कर उस की ख़िदमत करने लगे।<verse eid="MAT 4:11"/></para>
  <para style="s">ईसा की मनादी का आग़ाज़</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>जब उस ने सुना कि यूहन्ना पकड़वा दिया गया तो गलील को रवाना हुआ; <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>और नासरत को छोड़ कर कफ़रनहूम में जा बसा जो झील के किनारे ज़बलून और नफ़्ताली की सरहद पर है। <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>ताकि जो यसा'याह नबी की मारिफ़त कहा गया था, वो पूरा हो। <verse eid="MAT 4:14"/><verse number="15" style="v" sid="MAT 4:15"/>“ज़बलून का इलाक़ा, और नफ़्ताली का इलाक़ा, दरिया की राह यर्दन के पार, ग़ैर क़ौमों की गलील: <verse eid="MAT 4:15"/><verse number="16" style="v" sid="MAT 4:16"/>या'नी जो लोग अन्धेरे में बैठे थे, उन्होंने बड़ी रौशनी देखी; और जो मौत के मुल्क और साए में बैठे थे, उन पर रोशनी चमकी।”<verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>उस वक़्त से ईसा ने एलान करना और ये कहना शुरू किया <char style="wj">“तौबा करो, क्यूँकि आस्मान की बादशाही नज़दीक आ गई है।”</char><verse eid="MAT 4:17"/></para>
  <para style="s">पहले शागिर्दों का बुलाया जाना</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>उस ने गलील की झील के किनारे फिरते हुए दो भाइयों या'नी शमौन को जो पतरस कहलाता है; और उस के भाई अन्द्रियास को। झील में जाल डालते देखा, क्यूँकि वह मछली पकड़ने वाले थे। <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>और उन से कहा, <char style="wj">“मेरे पीछे चले आओ, मैं तुम को आदमी पकड़ने वाला बनाऊँगा।”</char> <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>वो फ़ौरन जाल छोड़ कर उस के पीछे हो लिए। <verse eid="MAT 4:20"/><verse number="21" style="v" sid="MAT 4:21"/>वहाँ से आगे बढ़ कर उस ने और दो भाइयों या'नी, ज़ब्दी के बेटे याक़ूब और उस के भाई यूहन्ना को देखा। कि अपने बाप ज़ब्दी के साथ नाव पर अपने जालों की मरम्मत कर रहे हैं। और उन को बुलाया। <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>वह फ़ौरन नाव और अपने बाप को छोड़ कर उस के पीछे हो लिए।<verse eid="MAT 4:22"/></para>
  <para style="s">ईसा बीमारों को शिफ़ा देते हैं</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>ईसा पुरे गलील में फिरता रहा, और उनके इबादतख़ानों में तालीम देता, और बादशाही की ख़ुशख़बरी का एलान करता और लोगों की हर तरह की बीमारी और हर तरह की कमज़ोरी को दूर करता रहा। <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>और उस की शोहरत पूरे सूब — ए — सूरिया में फैल गई, और लोग सब बिमारों को जो तरह — तरह की बीमारियों और तकलीफ़ों में गिरफ़्तार थे; और उन को जिन में बदरूहें थी, और मिर्गी वालों और मफ़्लूजों को उस के पास लाए और उसने उन को अच्छा किया। <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>और गलील, और दिकपुलिस, और येरूशलेम, और यहूदिया और यर्दन के पार से बड़ी भीड़ उसके पीछे हो ली।<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s">ईसा का पहाड़ी वा'ज़</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>वो इस भीड़ को देख कर ऊँची जगह पर चढ़ गया। और जब बैठ गया तो उस के शागिर्द उस के पास आए। <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>और वो अपनी ज़बान खोल कर उन को यूँ ता'लीम देने लगा।<verse eid="MAT 5:2"/></para>
  <para style="s">मुबारिक़बादियाँ</para>
  <para style="q">
    <verse number="3" style="v" sid="MAT 5:3"/>
    <char style="wj">मुबारिक़ हैं वो जो दिल के ग़रीब हैं क्यूँकि आस्मान की बादशाही उन्हीं की है।</char><verse eid="MAT 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="MAT 5:4"/>
    <char style="wj">मुबारिक़ हैं वो जो ग़मगीन हैं, क्यूँकि वो तसल्ली पाएँगे।</char><verse eid="MAT 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 5:5"/>
    <char style="wj">मुबारिक़ हैं वो जो हलीम हैं, क्यूँकि वो ज़मीन के वारिस होंगे।</char><verse eid="MAT 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 5:6"/>
    <char style="wj">मुबारिक़ हैं वो जो रास्तबाज़ी के भूखे और प्यासे हैं, क्यूँकि वो सेर होंगे।</char><verse eid="MAT 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="MAT 5:7"/>
    <char style="wj">मुबारिक़ हैं वो जो रहमदिल हैं, क्यूँकि उन पर रहम किया जाएगा।</char><verse eid="MAT 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 5:8"/>
    <char style="wj">मुबारिक़ हैं वो जो पाक दिल हैं, क्यूँकि वह ख़ुदा को देखेंगे।</char><verse eid="MAT 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 5:9"/>
    <char style="wj">मुबारिक़ हैं वो जो सुलह कराते हैं, क्यूँकि वह ख़ुदा के बेटे कहलाएँगे।</char><verse eid="MAT 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 5:10"/>
    <char style="wj">मुबारिक़ हैं वो जो रास्तबाज़ी की वजह से सताए गए हैं, क्यूँकि आस्मान की बादशाही उन्हीं की है।</char><verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>
    <char style="wj">जब लोग मेरी वजह से तुम को लान — तान करेंगे, और सताएँगे; और हर तरह की बुरी बातें तुम्हारी निस्बत नाहक़ कहेंगे; तो तुम मुबारिक़ होगे।</char> <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/><char style="wj">ख़ुशी करना और निहायत शादमान होना क्यूँकि आस्मान पर तुम्हारा अज्र बड़ा है। इसलिए कि लोगों ने उन नबियों को जो तुम से पहले थे, इसी तरह सताया था।</char><verse eid="MAT 5:12"/></para>
  <para style="s">नमक और नूर</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>
    <char style="wj">तुम ज़मीन के नमक हो। लेकिन अगर नमक का मज़ा जाता रहे तो वो किस चीज़ से नमकीन किया जाएगा? फिर वो किसी काम का नहीं सिवा इस के कि बाहर फेंका जाए और आदमियों के पैरों के नीचे रौंदा जाए।</char> <verse eid="MAT 5:13"/><verse number="14" style="v" sid="MAT 5:14"/><char style="wj">तुम दुनिया के नूर हो। जो शहर पहाड़ पर बसा है वो छिप नहीं सकता।</char> <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/><char style="wj">और चिराग़ जलाकर पैमाने के नीचे नहीं बल्कि चिराग़दान पर रखते हैं; तो उस से घर के सब लोगों को रोशनी पहुँचती है।</char> <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/><char style="wj">इसी तरह तुम्हारी रोशनी आदमियों के सामने चमके, ताकि वो तुम्हारे नेक कामों को देखकर तुम्हारे बाप की जो आसमान पर है बड़ाई करें।</char><verse eid="MAT 5:16"/></para>
  <para style="s">शरी'अत के मुता'ल्लिक़ ता'लीम</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>
    <char style="wj">“ये न समझो कि मैं तौरेत या नबियों की किताबों को मन्सूख़ करने आया हूँ, मन्सूख़ करने नहीं बल्कि पूरा करने आया हूँ।</char> <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/><char style="wj">क्यूँकि मैं तुम से सच कहता हूँ, जब तक आस्मान और ज़मीन टल न जाएँ, एक नुक़्ता या एक शोशा तौरेत से हरगिज़ न टलेगा जब तक सब कुछ पूरा न हो जाए।</char> <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/><char style="wj">पस जो कोई इन छोटे से छोटे हुक्मों में से किसी भी हुक्म को तोड़ेगा, और यही आदमियों को सिखाएगा। वो आसमान की बादशाही में सब से छोटा कहलाएगा; लेकिन जो उन पर अमल करेगा, और उन की ता'लीम देगा; वो आसमान की बादशाही में बड़ा कहलाएगा।</char> <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/><char style="wj">क्यूँकि मैं तुम से कहता हूँ, कि अगर तुम्हारी रास्तबाज़ी आलिमों और फ़रीसियों की रास्तबाज़ी से ज़्यादा न होगी, तो तुम आसमान की बादशाही में हरगिज़ दाख़िल न होगे।”</char><verse eid="MAT 5:20"/></para>
  <para style="s">ग़ुस्सा और क़त्ल</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>
    <char style="wj">तुम सुन चुके हो कि अगलों से कहा गया था कि ख़ून ना करना जो कोई ख़ून करेगा वो 'अदालत की सज़ा के लायक़ होगा।</char> <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/><char style="wj">लेकिन मैं तुम से ये कहता हूँ कि, 'जो कोई अपने भाई पर ग़ुस्सा होगा, वो 'अदालत की सज़ा के लायक़ होगा; कोई अपने भाई को पाग़ल कहेगा, वो सद्रे — ऐ अदालत की सज़ा के लायक़ होगा; और जो उसको बेवक़ूफ़ कहेगा, वो जहन्नुम की आग का सज़ावार होगा।</char> <verse eid="MAT 5:22"/><verse number="23" style="v" sid="MAT 5:23"/><char style="wj">पस अगर तू क़ुर्बानगाह पर अपनी क़ुर्बानी करता है और वहाँ तुझे याद आए कि मेरे भाई को मुझ से कुछ शिकायत है।</char> <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/><char style="wj">तो वहीं क़ुर्बानगाह के आगे अपनी नज़्र छोड़ दे और जाकर पहले अपने भाई से मिलाप कर तब आकर अपनी क़ुर्बानी कर।</char> <verse eid="MAT 5:24"/><verse number="25" style="v" sid="MAT 5:25"/><char style="wj">जब तक तू अपने मुद्द'ई के साथ रास्ते में है, उससे जल्द सुलह कर ले, कहीं ऐसा न हो कि मुद्द'ई तुझे मुन्सिफ़ के हवाले कर दे और मुन्सिफ़ तुझे सिपाही के हवाले कर दे; और तू क़ैद खाने में डाला जाए।</char> <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/><char style="wj">मैं तुझ से सच कहता हूँ, कि जब तक तू कौड़ी — कौड़ी अदा न करेगा वहाँ से हरगिज़ न छूटेगा।</char><verse eid="MAT 5:26"/></para>
  <para style="s">ज़िना</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>
    <char style="wj">“तुम सुन चुके हो कि कहा गया था, ‘ज़िना न करना।’</char> <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/><char style="wj">लेकिन मैं तुम से ये कहता हूँ कि जिस किसी ने बुरी ख़्वाहिश से किसी 'औरत पर निगाह की वो अपने दिल में उस के साथ ज़िना कर चुका।</char> <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/><char style="wj">पस अगर तेरी दहनी आँख तुझे ठोकर खिलाए तो उसे निकाल कर अपने पास से फेंक दे; क्यूँकि तेरे लिए यही बेहतर है; कि तेरे आ'ज़ा में से एक जाता रहे और तेरा सारा बदन जहन्नुम में न डाला जाए।</char> <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/><char style="wj">और अगर तेरा दाहिना हाथ तुझे ठोकर खिलाए तो उस को काट कर अपने पास से फेंक दे। क्यूँकि तेरे लिए यही बेहतर है; कि तेरे आ'ज़ा में से एक जाता रहे और तेरा सारा बदन जहन्नुम में न जाए।”</char><verse eid="MAT 5:30"/></para>
  <para style="s">तलाक़</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>
    <char style="wj">ये भी कहा गया था,, जो कोई अपनी बीवी को छोड़े उसे तलाक़नामा लिख दे।</char> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/><char style="wj">लेकिन मैं तुम से ये कहता हूँ, कि जो कोई अपनी बीवी को हरामकारी के सिवा किसी और वजह से छोड़ दे वो उस से ज़िना करता है; और जो कोई उस छोड़ी हुई से शादी करे वो भी ज़िना करता है।</char><verse eid="MAT 5:32"/></para>
  <para style="s">क़सम</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>
    <char style="wj">“फिर तुम सुन चुके हो कि अगलों से कहा गया था ‘झूठी क़सम न खाना; बल्कि अपनी क़समें ख़ुदावन्द के लिए पूरी करना।’</char> <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/><char style="wj">लेकिन मैं तुम से ये कहता हूँ कि बिल्कुल क़सम न खाना न तो आस्मान की क्यूँकि वो ख़ुदा का तख़्त है,</char> <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/><char style="wj">न ज़मीन की, क्यूँकि वो उस के पैरों की चौकी है। न येरूशलेम की क्यूँकि वो बुज़ुर्ग बादशाह का शहर है।</char> <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/><char style="wj">न अपने सर की क़सम खाना क्यूँकि तू एक बाल को भी सफ़ेद या काला नहीं कर सकता।</char> <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/><char style="wj">बल्कि तुम्हारा कलाम ‘हाँ — हाँ’ या ‘नहीं — नहीं में’ हो क्यूँकि जो इस से ज़्यादा है वो बदी से है।”</char><verse eid="MAT 5:37"/></para>
  <para style="s">इन्तिक़ाम</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>
    <char style="wj">“तुम सुन चुके हो कि कहा गया था, आँख के बदले आँख, और दाँत के बदले दाँत।</char> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/><char style="wj">लेकिन मैं तुम से ये कहता हूँ कि शरीर का मुक़ाबिला न करना बल्कि जो कोई तेरे दहने गाल पर तमाचा मारे दूसरा भी उसकी तरफ़ फेर दे।</char> <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/><char style="wj">और अगर कोई तुझ पर नालिश कर के तेरा कुरता लेना चाहे; तो चोग़ा भी उसे ले लेने दे।</char> <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/><char style="wj">और जो कोई तुझे एक कोस बेग़ार में ले जाए; उस के साथ दो कोस चला जा।</char> <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/><char style="wj">जो कोई तुझ से माँगे उसे दे; और जो तुझ से क़र्ज़ चाहे उस से मुँह न मोड़।”</char><verse eid="MAT 5:42"/></para>
  <para style="s">दुश्मनों से प्यार</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>
    <char style="wj">“तुम सुन चुके हो कि कहा गया था, अपने पड़ोसी से मुँह रख और अपने दुश्मन से दुश्मनी।</char> <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/><char style="wj">लेकिन मैं तुम से ये कहता हूँ, अपने दुश्मनों से मुहब्बत रखो और अपने सताने वालों के लिए दुआ करो।</char> <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/><char style="wj">ताकि तुम अपने बाप के जो आसमान पर है, बेटे ठहरो; क्यूँकि वो अपने सूरज को बदों और नेकों दोनों पर चमकाता है; और रास्तबाज़ों और नारास्तों दोनों पर मेंह बरसाता है।</char> <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/><char style="wj">क्यूँकि अगर तुम अपने मुहब्बत रखने वालों ही से मुहब्बत रख्खो तो तुम्हारे लिए क्या अज्र है? क्या महसूल लेने वाले भी ऐसा नहीं करते।”</char><verse eid="MAT 5:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 5:47"/>
    <char style="wj">अगर तुम सिर्फ़ अपने भाइयों को सलाम करो; तो क्या ज़्यादा करते हो? क्या ग़ैर क़ौमों के लोग भी ऐसा नहीं करते?</char> <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/><char style="wj">पस चाहिए कि तुम कामिल हो जैसा तुम्हारा आस्मानी बाप कामिल है।</char><verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s">ज़रूरतमंद को देने के बारे में ता'लीम</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>
    <char style="wj">“ख़बरदार! अपने रास्तबाज़ी के काम आदमियों के सामने दिखावे के लिए न करो, नहीं तो तुम्हारे बाप के पास जो आसमान पर है; तुम्हारे लिए कुछ अज्र नहीं है।”</char><verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>
    <char style="wj">पस जब तुम ख़ैरात करो तो अपने आगे नरसिंगा न बजाओ, जैसा रियाकार 'इबादतख़ानों और कूचों में करते हैं; ताकि लोग उनकी बड़ाई करें मैं तुम से सच कहता हूँ, कि वो अपना अज्र पा चुके।</char> <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/><char style="wj">बल्कि जब तू ख़ैरात करे तो जो तेरा दहना हाथ करता है; उसे तेरा बाँया हाथ न जाने।</char> <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/><char style="wj">ताकि तेरी ख़ैरात पोशीदा रहे, इस सूरत में तेरा आसमानी बाप जो पोशीदगी में देखता है तुझे बदला देगा।</char><verse eid="MAT 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>
    <char style="wj">जब तुम दुआ करो तो रियाकारों की तरह न बनो; क्यूँकि वो 'इबादतख़ानों में और बाज़ारों के मोड़ों पर खड़े होकर दुआ करना पसन्द करते हैं; ताकि लोग उन को देखें; मैं तुम से सच कहता हूँ, कि वो अपना बदला पा चुके।</char> <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/><char style="wj">बल्कि जब तू दुआ करे तो अपनी कोठरी में जा और दरवाज़ा बंद करके अपने आसमानी बाप से जो पोशीदगी में है; दुआ कर इस सूरत में तेरा आसमानी बाप जो पोशीदगी में देखता है तुझे बदला देगा।</char> <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/><char style="wj">और दुआ करते वक़्त ग़ैर क़ौमों के लोगों की तरह बक — बक न करो क्यूँकि वो समझते हैं; कि हमारे बहुत बोलने की वजह से हमारी सुनी जाएगी।</char> <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/><char style="wj">पस उन की तरह न बनो; क्यूँकि तुम्हारा आसमानी बाप तुम्हारे माँगने से पहले ही जानता है कि तुम किन — किन चीज़ों के मोहताज हो।</char><verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>
    <char style="wj">पस तुम इस तरह दुआ किया करो,</char></para>
  <para style="q" vid="MAT 6:9">
    <char style="wj">“ऐ हमारे बाप, तू जो आसमान पर है तेरा नाम पाक माना जाए।</char><verse eid="MAT 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 6:10"/>
    <char style="wj">तेरी बादशाही आए। तेरी मर्ज़ी जैसी आस्मान पर पूरी होती है ज़मीन पर भी हो।</char><verse eid="MAT 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="MAT 6:11"/>
    <char style="wj">हमारी रोज़ की रोटी आज हमें दे।</char><verse eid="MAT 6:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="MAT 6:12"/>
    <char style="wj">और जिस तरह हम ने अपने क़ुसूरवारों को मु'आफ़ किया है; तू भी हमारे क़ुसूरों को मु'आफ़ कर।</char><verse eid="MAT 6:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="MAT 6:13"/>
    <char style="wj">और हमें आज़्माइश में न ला, बल्कि बुराई से बचा; क्यूँकि बादशाही और क़ुदरत और जलाल हमेशा तेरे ही हैं; आमीन।”</char><verse eid="MAT 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14"/>
    <char style="wj">इसलिए कि अगर तुम आदमियों के क़ुसूर मु'आफ़ करोगे तो तुम्हारा आसमानी बाप भी तुम को मु'आफ़ करेगा।</char> <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/><char style="wj">और अगर तुम आदमियों के क़ुसूर मु'आफ़ न करोगे तो तुम्हारा आसमानी बाप भी तुम को मु'आफ़ न करेगा।</char><verse eid="MAT 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>
    <char style="wj">जब तुम रोज़ा रख्खो तो रियाकारों की तरह अपनी सूरत उदास न बनाओ; क्यूँकि वो अपना मुँह बिगाड़ते हैं; ताकि लोग उन को रोज़ादार जाने। मैं तुम से सच कहता हूँ कि वो अपना अज्र पा चुके।</char> <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/><char style="wj">बल्कि जब तू रोज़ा रख्खे तो अपने सिर पर तेल डाल और मुँह धो।</char> <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/><char style="wj">ताकि आदमी नहीं बल्कि तेरा बाप जो पोशीदगी में है तुझे रोज़ादार जाने। इस सूरत में तेरा बाप जो पोशीदगी में देखता है तुझे बदला देगा।</char><verse eid="MAT 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>
    <char style="wj">अपने वास्ते ज़मीन पर माल जमा न करो, जहाँ पर कीड़ा और ज़ँग ख़राब करता है; और जहाँ चोर नक़ब लगाते और चुराते हैं।</char> <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/><char style="wj">बल्कि अपने लिए आसमान पर माल जमा करो; जहाँ पर न कीड़ा ख़राब करता है; न ज़ँग और न वहाँ चोर नक़ब लगाते और चुराते हैं।</char> <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/><char style="wj">क्यूँकि जहाँ तेरा माल है वहीं तेरा दिल भी लगा रहेगा।</char><verse eid="MAT 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>
    <char style="wj">बदन का चराग़ आँख है। पस अगर तेरी आँख दुरुस्त हो तो तेरा पूरा बदन रोशन होगा।</char> <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/><char style="wj">अगर तेरी आँख ख़राब हो तो तेरा सारा बदन तारीक होगा। पस अगर वो रोशनी जो तुझ में है तारीक हो तो तारीकी कैसी बड़ी होगी।</char><verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>
    <char style="wj">कोई आदमी दो मालिकों की ख़िदमत नहीं कर सकता; क्यूँकि या तो एक से दुश्मनी रख्खे और दूसरे से मुहब्बत या एक से मिला रहेगा और दूसरे को नाचीज़ जानेगा; तुम ख़ुदा और दौलत दोनों की ख़िदमत नहीं कर सकते।</char> <verse eid="MAT 6:24"/><verse number="25" style="v" sid="MAT 6:25"/><char style="wj">इसलिए मैं तुम से कहता हूँ; कि अपनी जान की फ़िक्र न करना कि हम क्या खाएँगे या क्या पीएँगे, और न अपने बदन की कि क्या पहनेंगे; क्या जान ख़ूराक से और बदन पोशाक से बढ़ कर नहीं।</char> <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/><char style="wj">हवा के परिन्दों को देखो कि न बोते हैं न काटते न कोठियाँ में जमा करते हैं; तोभी तुम्हारा आसमानी बाप उनको खिलाता है क्या तुम उस से ज़्यादा क़द्र नहीं रखते?</char> <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/><char style="wj">तुम में से ऐसा कौन है जो फ़िक्र करके अपनी उम्र एक घड़ी भी बढ़ा सके?</char><verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>
    <char style="wj">और पोशाक के लिए क्यूँ फ़िक्र करते हो; जंगली सोसन के दरख़्तों को ग़ौर से देखो कि वो किस तरह बढ़ते हैं; वो न मेहनत करते हैं न कातते हैं।</char> <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/><char style="wj">तोभी मैं तुम से कहता हूँ; कि सुलैमान भी बावजूद अपनी सारी शानो शौकत के उन में से किसी की तरह कपड़े पहने न था।</char> <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/><char style="wj">पस जब ख़ुदा मैदान की घास को जो आज है और कल तंदूर में झोंकी जाएगी; ऐसी पोशाक पहनाता है, तो ऐ कम ईमान वालो “तुम को क्यूँ न पहनाएगा?</char><verse eid="MAT 6:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31"/>
    <char style="wj">“इस लिए फ़िक्रमन्द होकर ये न कहो, हम क्या खाएँगे? या क्या पिएँगे? या क्या पहनेंगे?”</char> <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/><char style="wj">क्यूँकि इन सब चीज़ों की तलाश में ग़ैर क़ौमें रहती हैं; और तुम्हारा आसमानी बाप जानता है, कि तुम इन सब चीज़ों के मोहताज हो।</char> <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/><char style="wj">बल्कि तुम पहले उसकी बादशाही और उसकी रास्बाज़ी की तलाश करो तो ये सब चीज़ें भी तुम को मिल जाएँगी।</char> <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/><char style="wj">पस कल के लिए फ़िक्र न करो क्यूँकि कल का दिन अपने लिए आप फ़िक्र कर लेगा; आज के लिए आज ही का दु:ख काफ़ी है।</char><verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s">दुसरो पर ईल्ज़ाम मत लगाओ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>
    <char style="wj">बुराई न करो, कि तुम्हारी भी बुराई न की जाए।</char> <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/><char style="wj">क्यूँकि जिस तरह तुम बुराई करते हो उसी तरह तुम्हारी भी बुराई की जाएगी और जिस पैमाने से तुम नापते हो उसी से तुम्हारे लिए नापा जाएगा।</char><verse eid="MAT 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3"/>
    <char style="wj">तू क्यूँ अपने भाई की आँख के तिनके को देखता है और अपनी आँख के शहतीर पर ग़ौर नहीं करता?</char> <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/><char style="wj">और जब तेरी ही आँख में शहतीर है तो तू अपने भाई से क्यूँ कर कह सकता है, 'ला, तेरी आँख में से तिनका निकाल दूँ?</char> <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/><char style="wj">ऐ रियाकार, पहले अपनी आँख में से तो शहतीर निकाल, फिर अपने भाई की आँख में से तिनके को अच्छी तरह देख कर निकाल सकता है।</char><verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>
    <char style="wj">पाक चीज़ कुत्तों को ना दो, और अपने मोती सुअरों के आगे न डालो, ऐसा न हो कि वो उनको पाँव के तले रौंदें और पलट कर तुम को फाड़ें।</char><verse eid="MAT 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>
    <char style="wj">माँगो तो तुम को दिया जाएगा। ढूँडो तो पाओगे; दरवाज़ा खटखटाओ तो तुम्हारे लिए खोला जाएगा।</char> <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/><char style="wj">क्यूँकि जो कोई माँगता है उसे मिलता है; और जो ढूँडता है वो पाता है और जो खटखटाता है उसके लिए खोला जाएगा।</char><verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>
    <char style="wj">तुम में ऐसा कौन सा आदमी है, कि अगर उसका बेटा उससे रोटी माँगे तो वो उसे पत्थर दे?</char> <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/><char style="wj">या अगर मछली माँगे तो उसे साँप दे!</char> <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/><char style="wj">पस जबकि तुम बुरे होकर अपने बच्चों को अच्छी चीज़ें देना जानते हो, तो तुम्हारा बाप जो आसमान पर है; अपने माँगने वालों को अच्छी चीज़ें क्यूँ न देगा।</char> <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/><char style="wj">पस जो कुछ तुम चाहते हो कि लोग तुम्हारे साथ करें वही तुम भी उनके साथ करो; क्यूँकि तौरेत और नबियों की ता'लीम यही है।</char><verse eid="MAT 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>
    <char style="wj">तंग दरवाज़े से दाख़िल हो, क्यूँकि वो दरवाज़ा चौड़ा है, और वो रास्ता चौड़ा है जो हलाकत को पहुँचाता है; और उससे दाख़िल होने वाले बहुत हैं।</char> <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/><char style="wj">क्यूँकि वो दरवाज़ा तंग है और वो रास्ता सुकड़ा है जो ज़िन्दगी को पहुँचाता है और उस के पाने वाले थोड़े हैं।</char><verse eid="MAT 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>
    <char style="wj">झूठे नबियों से ख़बरदार रहो! जो तुम्हारे पास भेड़ों के भेस में आते हैं; मगर अन्दर से फाड़ने वाले भेड़िये की तरह हैं।</char> <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/><char style="wj">उनके फलों से तुम उनको पहचान लोगे; क्या झाड़ियों से अंगूर या ऊँट कटारों से अंजीर तोड़ते हैं?</char> <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/><char style="wj">इसी तरह हर एक अच्छा दरख़्त अच्छा फल लाता है और बुरा दरख़्त बुरा फल लाता है।</char> <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/><char style="wj">अच्छा दरख़्त बुरा फल नहीं ला सकता, न बुरा दरख़्त अच्छा फल ला सकता है।</char> <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/><char style="wj">जो दरख़्त अच्छा फल नहीं लाता वो काट कर आग में डाला जाता है।</char> <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/><char style="wj">पस उनके फलों से तुम उनको पहचान लोगे।</char><verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>
    <char style="wj">“जो मुझ से ऐ ख़ुदावन्द! ‘ऐ ख़ुदावन्द!’ कहते हैं उन में से हर एक आस्मान की बादशाही में दाख़िल न होगा। मगर वही जो मेरे आस्मानी बाप की मर्ज़ी पर चलता है।</char> <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/><char style="wj">उस दिन बहुत से मुझसे कहेंगे, ‘ऐ ख़ुदावन्द! ख़ुदावन्द! क्या हम ने तेरे नाम से नबुव्वत नहीं की, और तेरे नाम से बदरूहों को नहीं निकाला और तेरे नाम से बहुत से मोजिज़े नहीं दिखाए?’</char> <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/><char style="wj">उस दिन मैं उन से साफ़ कह दूँगा, मेरी तुम से कभी वाक़फ़ियत न थी, ऐ बदकारो! मेरे सामने से चले जाओ।”</char><verse eid="MAT 7:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>
    <char style="wj">“पस जो कोई मेरी यह बातें सुनता और उन पर अमल करता है वह उस अक़्लमन्द आदमी की तरह ठहरेगा जिस ने चट्टान पर अपना घर बनाया।</char> <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/><char style="wj">और मेंह बरसा और पानी चढ़ा और आन्धियाँ चलीं और उस घर पर टक्करें लगीं; लेकिन वो न गिरा क्यूँकि उस की बुनियाद चट्टान पर डाली गई थी।</char> <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/><char style="wj">और जो कोई मेरी यह बातें सुनता है और उन पर अमल नहीं करता वह उस बेवक़ूफ़ आदमी की तरह ठहरेगा जिस ने अपना घर रेत पर बनाया।</char> <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/><char style="wj">और मेंह बरसा और पानी चढ़ा और आन्धियाँ चलीं, और उस घर को सदमा पहुँचा और वो गिर गया, और बिल्कुल बरबाद हो गया।” </char><verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>जब ईसा ने यह बातें ख़त्म कीं तो ऐसा हुआ कि भीड़ उस की तालीम से हैरान हुई। <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>क्यूँकि वह उन के आलिमों की तरह नहीं बल्कि साहिब — ए — इख़्तियार की तरह उनको ता'लीम देता था।<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s">येसु का एक कोढ़ी को ठीक करना</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>जब वो उस पहाड़ से उतरा तो बहुत सी भीड़ उस के पीछे हो ली। <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>और देखो:एक कौढ़ी ने पास आकर उसे सज्दा किया और कहा, “ऐ ख़ुदावन्द! अगर तू चाहे तो मुझे पाक साफ़ कर सकता है।” <verse eid="MAT 8:2"/><verse number="3" style="v" sid="MAT 8:3"/>उसने हाथ बढ़ा कर उसे छुआ और कहा, <char style="wj">“मैं चाहता हूँ, तू पाक — साफ़ हो जा।”</char> वह फ़ौरन कौढ़ से पाक — साफ़ हो गया। <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>ईसा ने उस से कहा, <char style="wj">“ख़बरदार! किसी से न कहना बल्कि जाकर अपने आप को काहिन को दिखा; और जो नज़्र मूसा ने मुक़र्रर की है उसे गुज़रान; ताकि उन के लिए गवाही हो।”</char><verse eid="MAT 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>जब वो कफ़रनहूम में दाख़िल हुआ तो एक सूबेदार उसके पास आया; और उसकी मिन्नत करके कहा। <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>“ऐ ख़ुदावन्द, मेरा ख़ादिम फ़ालिज का मारा घर में पड़ा है; और बहुत ही तकलीफ़ में है।” <verse eid="MAT 8:6"/><verse number="7" style="v" sid="MAT 8:7"/>उस ने उस से कहा, <char style="wj">“मैं आ कर उसे शिफ़ा दूँगा।”</char> <verse eid="MAT 8:7"/><verse number="8" style="v" sid="MAT 8:8"/>सूबेदार ने जवाब में कहा “ऐ ख़ुदावन्द, मैं इस लायक़ नहीं कि तू मेरी छत के नीचे आए; बल्कि सिर्फ़ ज़बान से कह दे तो मेरा ख़ादिम शिफ़ा पाएगा। <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>क्यूँकि मैं भी दूसरे के इख़्तियार में हूँ; और सिपाही मेरे मातहत हैं; जब एक से कहता हूँ, जा! तो वह जाता है और दूसरे से ‘आ!’ तो वह आता है। और अपने नौकर से‘ ये कर’ तो वह करता है।”<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>ईसा ने ये सुनकर त'अज्जुब किया और पीछे आने वालों से कहा, <char style="wj">“मैं तुम से सच कहता हूँ, कि मैं ने इस्राईल में भी ऐसा ईमान नहीं पाया।</char> <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/><char style="wj">और मैं तुम से कहता हूँ कि बहुत सारे पूरब और पश्चिम से आ कर अब्रहाम, इज़्हाक़ और याक़ूब के साथ आसमान की बादशाही की ज़ियाफ़त में शरीक होंगे।</char> <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/><char style="wj">मगर बादशाही के बेटे बाहर अंधेरे में डाले जाँएगे; जहाँ रोना और दाँत पीसना होगा।”</char> <verse eid="MAT 8:12"/><verse number="13" style="v" sid="MAT 8:13"/>और ईसा ने सूबेदार से कहा, <char style="wj">“जा! जैसा तू ने यक़ीन किया तेरे लिए वैसा ही हो।”</char> और उसी घड़ी ख़ादिम ने शिफ़ा पाई।<verse eid="MAT 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>और ईसा ने पतरस के घर में आकर उसकी सास को बुख़ार में पड़ी देखा। <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>उस ने उसका हाथ छुआ और बुख़ार उस पर से उतर गया; और वो उठ खड़ी हुई और उसकी ख़िदमत करने लगी। <verse eid="MAT 8:15"/><verse number="16" style="v" sid="MAT 8:16"/>जब शाम हुई तो उसके पास बहुत से लोगों को लाए; जिन में बदरूहें थी उसने बदरूहों को ज़बान ही से कह कर निकाल दिया; और सब बीमारों को अच्छा कर दिया। <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>ताकि जो यसायाह नबी के ज़रिए कहा गया था, वो पूरा हो: “उसने आप हमारी कमज़ोरियाँ ले लीं और बीमारियाँ उठा लीं।”<verse eid="MAT 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>जब ईसा ने अपने चारों तरफ़ बहुत सी भीड़ देखी तो पार चलने का हुक्म दिया। <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>और एक आलिम ने पास आकर उस से कहा “ऐ उस्ताद, जहाँ कहीं भी तू जाएगा मैं तेरे पीछे चलूँगा।” <verse eid="MAT 8:19"/><verse number="20" style="v" sid="MAT 8:20"/>ईसा ने उस से कहा, <char style="wj">“लोमड़ियों के भठ होते हैं और हवा के परिन्दों के घोंसले, मगर इबने आदम के लिए सर रखने की भी जगह नहीं।”</char> <verse eid="MAT 8:20"/><verse number="21" style="v" sid="MAT 8:21"/>एक और शागिर्द ने उस से कहा, “ऐ ख़ुदावन्द, मुझे इजाज़त दे कि पहले जाकर अपने बाप को दफ़्न करूँ।” <verse eid="MAT 8:21"/><verse number="22" style="v" sid="MAT 8:22"/>ईसा ने उससे कहा, <char style="wj">“तू मेरे पीछे चल और मुर्दों को अपने मुर्दे दफ़्न करने दे।”</char><verse eid="MAT 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>जब वो नाव पर चढ़ा तो उस के शागिर्द उसके साथ हो लिए। <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>और देखो झील में ऐसा बड़ा तूफ़ान आया कि नाव लहरों से छिप गई, मगर वो सोता रहा। <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>उन्होंने पास आकर उसे जगाया और कहा “ऐ ख़ुदावन्द, हमें बचा, हम हलाक हुए जाते हैं”। <verse eid="MAT 8:25"/><verse number="26" style="v" sid="MAT 8:26"/>उसने उनसे कहा, <char style="wj">“ऐ कम ईमान वालो! डरते क्यूँ हो?”</char> तब उसने उठकर हवा और पानी को डाँटा और बड़ा अम्न हो गया। <verse eid="MAT 8:26"/><verse number="27" style="v" sid="MAT 8:27"/>और लोग ता'अज्जुब करके कहने लगे “ये किस तरह का आदमी है कि हवा और पानी सब इसका हुक्म मानते हैं।”<verse eid="MAT 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>जब वो उस पार गदरीनियों के मुल्क में पहुँचा तो दो आदमी जिन में बदरूहें थी; क़ब्रों से निकल कर उससे मिले: वो ऐसे तंग मिज़ाज थे कि कोई उस रास्ते से गुज़र नहीं सकता था। <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>और देखो उन्होंने चिल्लाकर कहा “ऐ ख़ुदा के बेटे हमें तुझ से क्या काम? क्या तू इसलिए यहाँ आया है कि वक़्त से पहले हमें ऐज़ाब में डाले?” <verse eid="MAT 8:29"/><verse number="30" style="v" sid="MAT 8:30"/>उनसे कुछ दूर बहुत से सूअरों का ग़ोल चर रहा था। <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>पस बदरूहों ने उसकी मिन्नत करके कहा “अगर तू हम को निकालता है तो हमें सूअरों के ग़ोल में भेज दे।” <verse eid="MAT 8:31"/><verse number="32" style="v" sid="MAT 8:32"/>उसने उनसे कहा <char style="wj">“जाओ।”</char> वो निकल कर सुअरों के अन्दर चली गईं; और देखो; सारा ग़ोल किनारे पर से झपट कर झील में जा पड़ा और पानी में डूब मरा। <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>और चराने वाले भागे और शहर में जाकर सब माजरा और उनके हालात जिन में बदरूहें थी बयान किया। <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>और देखो सारा शहर ईसा से मिलने को निकला और उसे देख कर मिन्नत की, कि हमारी सरहदों से बाहर चला जा।<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s">येसु का एक फ़ालिज के मरीज़ को ठीक करना</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>फिर वो नाव पर चढ़ कर पार गया; और अपने शहर में आया। <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>और देखो, लोग एक फ़ालिज के मारे हुए को जो चारपाई पर पड़ा हुआ था उसके पास लाए; ईसा ने उसका ईमान देखकर मफ़्लूज से कहा <char style="wj">“बेटा, इत्मीनान रख। तेरे गुनाह मुआफ़ हुए।”</char> <verse eid="MAT 9:2"/><verse number="3" style="v" sid="MAT 9:3"/>और देखो कुछ आलिमों ने अपने दिल में कहा, “ये कुफ़्र बकता है” <verse eid="MAT 9:3"/><verse number="4" style="v" sid="MAT 9:4"/>ईसा ने उनके ख़याल मा'लूम करके कहा, <char style="wj">“तुम क्यूँ अपने दिल में बुरे ख़याल लाते हो?</char> <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/><char style="wj">आसान क्या है? ये कहना तेरे गुनाह मु'आफ़ हुए; या ये कहना; उठ और चल फिर।</char> <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/><char style="wj">लेकिन इसलिए कि तुम जान लो कि इबने आदम को ज़मीन पर गुनाह मु'आफ़ करने का इख़्तियार है,”</char> उसने फ़ालिज का मारे हुए से कहा, <char style="wj">“उठ, अपनी चारपाई उठा और अपने घर चला जा।”</char> <verse eid="MAT 9:6"/><verse number="7" style="v" sid="MAT 9:7"/>वो उठ कर अपने घर चला गया। <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>लोग ये देख कर डर गए; और ख़ुदा की बड़ाई करने लगे; जिसने आदमियों को ऐसा इख़्तियार बख़्शा।<verse eid="MAT 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>ईसा ने वहाँ से आगे बढ़कर मत्ती नाम एक शख़्स को महसूल की चौकी पर बैठे देखा; और उस से कहा, <char style="wj">“मेरे पीछे हो ले।”</char> वो उठ कर उसके पीछे हो लिया। <verse eid="MAT 9:9"/><verse number="10" style="v" sid="MAT 9:10"/>जब वो घर में खाना खाने बैठा; तो ऐसा हुआ कि बहुत से महसूल लेने वाले और गुनहगार आकर ईसा और उसके शागिर्दों के साथ खाना खाने बैठे। <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>फ़रीसियों ने ये देख कर उसके शागिर्दों से कहा, “तुम्हारा उस्ताद महसूल लेने वालों और गुनहगारों के साथ क्यूँ खाता है?” <verse eid="MAT 9:11"/><verse number="12" style="v" sid="MAT 9:12"/>उसने ये सुनकर कहा, <char style="wj">“तन्दरुस्तों को हकीम की ज़रुरत नहीं बल्कि बीमारों को।</char> <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/><char style="wj">मगर तुम जाकर उसके मा'ने मा'लूम करो:मैं क़ुर्बानी नहीं बल्कि रहम पसन्द करता हूँ। क्यूँकि मैं रास्तबाज़ों को नहीं बल्कि गुनाहगारों को बुलाने आया हूँ।”</char><verse eid="MAT 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>उस वक़्त यूहन्ना के शागिर्दों ने उसके पास आकर कहा, “क्या वजह है कि हम और फ़रीसी तो अक्सर रोज़ा रखते हैं, और तेरे शागिर्द रोज़ा नहीं रखते?” <verse eid="MAT 9:14"/><verse number="15" style="v" sid="MAT 9:15"/>ईसा ने उस से कहा, <char style="wj">“क्या बाराती जब तक दुल्हा उनके साथ है, मातम कर सकते हैं? मगर वो दिन आएँगे; कि दुल्हा उनसे जुदा किया जाएगा; उस वक़्त वो रोज़ा रखेंगे।</char> <verse eid="MAT 9:15"/><verse number="16" style="v" sid="MAT 9:16"/><char style="wj">कोरे कपड़े का पैवन्द पुरानी पोशाक में कोई नहीं लगाता क्यूँकि वो पैवन्द पोशाक में से कुछ खींच लेता है और वो ज़्यादा फट जाती है।</char> <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/><char style="wj">और नई मय पुरानी मश्कों में नहीं भरते वर्ना मश्कें फट जाती हैं; और मय बह जाती है, और मश्कें बरबाद हो जाती हैं; बल्कि नई मय नई मश्कों में भरते हैं; और वो दोनों बची रहती हैं।”</char><verse eid="MAT 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>वो उन से ये बातें कह ही रहा था, कि देखो एक सरदार ने आकर उसे सज्दा किया और कहा, “मेरी बेटी अभी मरी है लेकिन तू चलकर अपना हाथ उस पर रख तो वो ज़िन्दा हो जाएगी।” <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>ईसा उठ कर अपने शागिर्दों समेत उस के पीछे हो लिया। <verse eid="MAT 9:19"/><verse number="20" style="v" sid="MAT 9:20"/>और देखो; एक 'औरत ने जिसके बारह बरस से ख़ून जारी था; उसके पीछे आकर उस की पोशाक का किनारा छुआ। <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>क्यूँकि वो अपने जी में कहती थी; अगर सिर्फ़ उसकी पोशाक ही छू लूँगी “तो अच्छी हो जाऊँगी।” <verse eid="MAT 9:21"/><verse number="22" style="v" sid="MAT 9:22"/>ईसा ने फिर कर उसे देखा और कहा, <char style="wj">“बेटी, इत्मीनान रख! तेरे ईमान ने तुझे अच्छा कर दिया।”</char> पस वो 'औरत उसी घड़ी अच्छी हो गई। <verse eid="MAT 9:22"/><verse number="23" style="v" sid="MAT 9:23"/>जब ईसा सरदार के घर में आया और बाँसुरी बजाने वालों को और भीड़ को शोर मचाते देखा। <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>तो कहा, <char style="wj">“हट जाओ! क्यूँकि लड़की मरी नहीं बल्कि सोती है।”</char> वो उस पर हँसने लगे। <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>मगर जब भीड़ निकाल दी गई तो उस ने अन्दर जाकर उसका हाथ पकड़ा और लड़की उठी। <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>और इस बात की शोहरत उस तमाम इलाक़े में फैल गई।<verse eid="MAT 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>जब ईसा वहाँ से आगे बढ़ा तो दो अन्धे उसके पीछे ये पुकारते हुए चले “ऐ इब्न — ए — दाऊद, हम पर रहम कर।” <verse eid="MAT 9:27"/><verse number="28" style="v" sid="MAT 9:28"/>जब वो घर में पहुँचा तो वो अन्धे उसके पास आए और 'ईसा ने उनसे कहा <char style="wj">“क्या तुम को यक़ीन है कि मैं ये कर सकता हूँ?”</char> उन्हों ने उस से कहा “हाँ ख़ुदावन्द।” <verse eid="MAT 9:28"/><verse number="29" style="v" sid="MAT 9:29"/>फिर उस ने उन की आँखें छू कर कहा, <char style="wj">“तुम्हारे यक़ीन के मुताबिक़ तुम्हारे लिए हो।”</char> <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>और उन की आँखें खुल गईं और ईसा ने उनको ताकीद करके कहा, <char style="wj">“ख़बरदार, कोई इस बात को न जाने!”</char> <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>मगर उन्होंने निकल कर उस तमाम इलाक़े में उसकी शोहरत फैला दी।<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>जब वो बाहर जा रहे थे, तो देखो लोग एक गूँगे को जिस में बदरूह थी उसके पास लाए। <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>और जब वो बदरूह निकाल दी गई तो गूँगा बोलने लगा; और लोगों ने ता'अज्जुब करके कहा, “इस्राईल में ऐसा कभी नहीं देखा गया।” <verse eid="MAT 9:33"/><verse number="34" style="v" sid="MAT 9:34"/>मगर फ़रीसियों ने कहा, “ये तो बदरूहों के सरदार की मदद से बदरूहों को निकालता है।”<verse eid="MAT 9:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>ईसा सब शहरों और गाँव में फिरता रहा, और उनके इबादतख़ानों में ता'लीम देता और बादशाही की ख़ुशख़बरी का एलान करता और — और हर तरह की बीमारी और हर तरह की कमज़ोरी दूर करता रहा। <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>और जब उसने भीड़ को देखा तो उस को लोगों पर तरस आया; क्यूँकि वो उन भेड़ों की तरह थे जिनका चरवाहा न हो बुरी हालत में पड़े थे। <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>उस ने अपने शागिर्दों से कहा, <char style="wj">“फ़सल बहुत है, लेकिन मज़दूर थोड़े हैं।</char> <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/><char style="wj">पस फ़सल के मालिक से मिन्नत करो कि वो अपनी फ़सल काटने के लिए मज़दूर भेज दे।”</char><verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s">येसु का बारा शागिर्दों को भेजना</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>फिर उस ने अपने बारह शागिर्दों को पास बुला कर उनको बदरूहों पर इख़्तियार बख़्शा कि उनको निकालें और हर तरह की बीमारी और हर तरह की कमज़ोरी को दूर करें। <verse eid="MAT 10:1"/><verse number="2" style="v" sid="MAT 10:2"/>और बारह रसूलों के नाम ये हैं; पहला शमौन, जो पतरस कहलाता है और उस का भाई अन्द्रियास ज़ब्दी का बेटा या'क़ूब और उसका भाई यूहन्ना। <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>फ़िलिप्पुस, बरतुल्माई, तोमा, और मत्ती महसूल लेने वाला। <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>हलफ़ी का बेटा या'क़ूब और तद्दी शमौन कनानी और यहूदाह इस्करियोती जिस ने उसे पकड़वा भी दिया।<verse eid="MAT 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>इन बारह को ईसा ने भेजा और उनको हुक्म देकर कहा, <char style="wj">“ग़ैर क़ौमों की तरफ़ न जाना और सामरियों के किसी शहर में भी दाख़िल न होना।</char> <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/><char style="wj">बल्कि इस्राईल के घराने की खोई हुई भेड़ों के पास जाना।</char> <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/><char style="wj">और चलते — चलते ये एलान करना आस्मान की बादशाही नज़दीक आ गई है।</char> <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/><char style="wj">बीमारों को अच्छा करना; मुर्दों को जिलाना कौढ़ियों को पाक साफ़ करना बदरूहों को निकालना; तुम ने मुफ़्त पाया मुफ़्त ही देना।</char> <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/><char style="wj">न सोना अपने कमरबन्द में रखना — न चाँदी और न पैसे।</char> <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/><char style="wj">रास्ते के लिए न झोली लेना न दो — दो कुरते न जूतियाँ न लाठी; क्यूँकि मज़दूर अपनी ख़ूराक का हक़दार है।”</char><verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>
    <char style="wj">“जिस शहर या गाँव में दाख़िल हो मालूम करना कि उस में कौन लायक़ है और जब तक वहाँ से रवाना न हो उसी के यहाँ रहना।</char> <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/><char style="wj">और घर में दाख़िल होते वक़्त उसे दु'आ — ए — ख़ैर देना।</char> <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/><char style="wj">अगर वो घर लायक़ हो तो तुम्हारा सलाम उसे पहुँचे; और अगर लायक़ न हो तो तुम्हारा सलाम तुम पर फिर आए।</char> <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/><char style="wj">और अगर कोई तुम को क़ुबूल न करे, और तुम्हारी बातें न सुने तो उस घर या शहर से बाहर निकलते वक़्त अपने पैरों की धूल झाड़ देना।</char> <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/><char style="wj">मैं तुम से सच कहता हूँ, कि 'अदालत के दिन उस शहर की निस्बत सदूम और अमूरा</char> <note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="fq" closed="false">सदूम और अमूरा </char><char style="ft" closed="false">ये दोनों ऐसे शहर हैं जो इब्राहीम के ज़माने में ख़ुदा ने आसमान से आग और गन्धक बरसा कर हलाक किया क्यूँकि ये दोनों शहर के लोग ख़ुदा की निगाह में गुनहगार थे — पैदाइश — बाब 19</char></note> <char style="wj">के इलाक़े का हाल ज़्यादा बर्दाश्त के लायक़ होगा।”</char><verse eid="MAT 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>
    <char style="wj">“देखो, मैं तुम को भेजता हूँ; गोया भेड़ों को भेड़ियों के बीच पस साँपों की तरह होशियार और कबूतरों की तरह सीधे बनो।</char> <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/><char style="wj">मगर आदमियों से ख़बरदार रहो, क्यूँकि वह तुम को अदालतों के हवाले करेंगे; और अपने इबादतख़ानों में तुम को कोड़े मारेंगे।</char> <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/><char style="wj">और तुम मेरी वजह से हाकिमों और बादशाहों के सामने हाज़िर किए जाओगे; ताकि उनके और ग़ैर क़ौमों के लिए गवाही हो।</char> <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/><char style="wj">लेकिन जब वो तुम को पकड़वाएँगे; तो फ़िक्र न करना कि हम किस तरह कहें या क्या कहें; क्यूँकि जो कुछ कहना होगा उसी वक़्त तुम को बताया जाएगा।</char> <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/><char style="wj">क्यूँकि बोलने वाले तुम नहीं बल्कि तुम्हारे आसमानी बाप का रूह है; जो तुम में बोलता है।”</char><verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>
    <char style="wj">“भाई को भाई क़त्ल के लिए हवाले करेगा और बेटे को बाप और बेटा अपने माँ बाप के बरख़िलाफ़ खड़े होकर उनको मरवा डालेंगे।</char> <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/><char style="wj">और मेरे नाम के ज़रिए से सब लोग तुम से अदावत रखेंगे; मगर जो आख़िर तक बर्दाश्त करेगा वही नजात पाएगा।</char> <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/><char style="wj">लेकिन जब तुम को एक शहर सताए तो दूसरे को भाग जाओ; क्यूँकि मैं तुम से सच कहता हूँ, कि तुम इस्राईल के सब शहरों में न फिर चुके होगे कि 'इब्न — ए — आदम आजाएगा।”</char><verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>
    <char style="wj">“शागिर्द अपने उस्ताद से बड़ा नहीं होता, न नौकर अपने मालिक से।</char> <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/><char style="wj">शागिर्द के लिए ये काफ़ी है कि अपने उस्ताद की तरह हो; और नौकर के लिए ये कि अपने मालिक की तरह जब उन्होंने घर के मालिक को बा'लज़बूल कहा; तो उसके घराने के लोगों को क्यूँ न कहेंगे।”</char><verse eid="MAT 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>
    <char style="wj">“पस उनसे न डरो; क्यूँकि कोई चीज़ ढकी नहीं जो खोली न जाएगी और न कोई चीज़ छिपी है जो जानी न जाएगी।</char> <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/><char style="wj">जो कुछ मैं तुम से अन्धेरे में कहता हूँ; उजाले में कहो और जो कुछ तुम कान में सुनते हो छतों पर उसका एलान करो।</char> <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/><char style="wj">जो बदन को क़त्ल करते हैं और रूह को क़त्ल नहीं कर सकते उन से न डरो बल्कि उसी से डरो जो रूह और बदन दोनों को जहन्नुम में हलाक कर सकता है।</char> <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/><char style="wj">क्या पैसे की दो चिड़ियाँ नहीं बिकतीं? और उन में से एक भी तुम्हारे बाप की मर्ज़ी के बग़ैर ज़मीन पर नहीं गिर सकती।</char> <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/><char style="wj">बल्कि तुम्हारे सर के बाल भी सब गिने हुए हैं।</char> <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/><char style="wj">पस डरो नहीं; तुम्हारी क़द्र तो बहुत सी चिड़ियों से ज़्यादा है।”</char><verse eid="MAT 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>
    <char style="wj">“पस जो कोई आदमियों के सामने मेरा इक़रार करेगा; मैं भी अपने बाप के सामने जो आसमान पर है उसका इक़रार करूँगा।</char> <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/><char style="wj">मगर जो कोई आदमियों के सामने मेरा इन्कार करेगा मैं भी अपने बाप के जो आस्मान पर है उसका इन्कार करूँगा।”</char><verse eid="MAT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>
    <char style="wj">“ये न समझो कि मैं ज़मीन पर सुलह करवाने आया हूँ; सुलह करवाने नहीं बल्कि तलवार चलवाने आया हूँ।</char> <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/><char style="wj">क्यूँकि मैं इसलिए आया हूँ, कि आदमी को उसके बाप से और बेटी को उस की माँ से और बहु को उसकी सास से जुदा कर दूँ।</char> <verse eid="MAT 10:35"/><verse number="36" style="v" sid="MAT 10:36"/><char style="wj">और आदमी के दुश्मन उसके घर के ही लोग होंगे।”</char><verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>
    <char style="wj">“जो कोई बाप या माँ को मुझ से ज़्यादा अज़ीज़ रखता है वो मेरे लायक़ नहीं; और जो कोई बेटे या बेटी को मुझ से ज़्यादा अज़ीज़ रखता है वो मेरे लायक़ नहीं।</char> <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/><char style="wj">जो कोई अपनी सलीब न उठाए और मेरे पीछे न चले वो मेरे लायक़ नहीं।</char> <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/><char style="wj">जो कोई अपनी जान बचाता है उसे खोएगा; और जो कोई मेरी ख़ातिर अपनी जान खोता है उसे बचाएगा।”</char><verse eid="MAT 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>
    <char style="wj">“जो तुम को क़ुबूल करता है वो मुझे क़ुबूल करता है और जो मुझे क़ुबूल करता है वो मेरे भेजने वाले को क़ुबूल करता है।</char> <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/><char style="wj">जो नबी के नाम से नबी को क़ुबूल करता है; वो नबी का अज्र पाएगा; और जो रास्तबाज़ के नाम से रास्तबाज़ को क़ुबूल करता है वो रास्तबाज़ का अज्र पाएगा।</char> <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/><char style="wj">और जो कोई शागिर्द के नाम से इन छोटों में से किसी को सिर्फ़ एक प्याला ठन्डा पानी ही पिलाएगा; मैं तुम से सच कहता हूँ वो अपना अज्र हरगिज़ न खोएगा।”</char><verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s">येसु और बपतिस्मा देने वाला</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>जब ईसा अपने बारह शागिर्दों को हुक्म दे चुका, तो ऐसा हुआ कि वहाँ से चला गया ताकि उनके शहरों में ता'लीम दे और एलान करे। <verse eid="MAT 11:1"/><verse number="2" style="v" sid="MAT 11:2"/>यूहन्ना बपतिस्मा देने वाले ने क़ैदख़ाने में मसीह के कामों का हाल सुनकर अपने शागिर्दों के ज़रिए उससे पुछवा भेजा। <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>“आने वाला तू ही है या हम दूसरे की राह देखें?” <verse eid="MAT 11:3"/><verse number="4" style="v" sid="MAT 11:4"/>ईसा ने जवाब में उनसे कहा, <char style="wj">“जो कुछ तुम सुनते हो और देखते हो जाकर यूहन्ना से बयान कर दो।</char> <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/><char style="wj">कि अन्धे देखते और लंगड़े चलते फिरते हैं; कौढ़ी पाक साफ़ किए जाते हैं और बहरे सुनते हैं और मुर्दे ज़िन्दा किए जाते हैं और ग़रीबों को ख़ुशख़बरी सुनाई जाती है।</char> <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/><char style="wj">और मुबारिक़ वो है जो मेरी वजह से ठोकर न खाए।”</char><verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>जब वो रवाना हो लिए तो ईसा ने यूहन्ना के बारे में लोगों से कहना शुरू किया कि <char style="wj">“तुम वीराने में क्या देखने गए थे? क्या हवा से हिलते हुए सरकंडे को?</char> <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/><char style="wj">तो फिर क्या देखने गए थे क्या महीन कपड़े पहने हुए शख़्स को? देखो जो महीन कपड़े पहनते हैं वो बादशाहों के घरों में होते हैं।</char> <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/><char style="wj">तो फिर क्यूँ गए थे? क्या एक नबी को देखने? हाँ मैं तुम से कहता हूँ बल्कि नबी से बड़े को।</char> <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/><char style="wj">ये वही है जिसके बारे में लिखा है कि देख मैं अपना पैग़म्बर तेरे आगे भेजता हूँ जो तेरा रास्ता तेरे आगे तैयार करेगा”</char><verse eid="MAT 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11"/>
    <char style="wj">“मैं तुम से सच कहता हूँ; जो औरतों से पैदा हुए हैं, उन में यूहन्ना बपतिस्मा देने वाले से बड़ा कोई नहीं हुआ, लेकिन जो आसमान की बादशाही में छोटा है वो उस से बड़ा है।</char> <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/><char style="wj">और यूहन्ना बपतिस्मा देने वाले के दिनों से अब तक आसमान की बादशाही पर ज़ोर होता रहा है; और ताक़तवर उसे छीन लेते हैं।</char> <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/><char style="wj">क्यूँकि सब नबियों और तौरेत ने यूहन्ना तक नबुव्वत की।</char> <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/><char style="wj">और चाहो तो मानो; एलियाह जो आनेवाला था; यही है।</char> <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/><char style="wj">जिसके सुनने के कान हों वो सुन ले!”</char><verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>
    <char style="wj">“पस इस ज़माने के लोगों को मैं किस की मिसाल दूँ? वो उन लड़कों की तरह हैं, जो बाज़ारों में बैठे हुए अपने साथियों को पुकार कर कहते हैं।</char> <verse eid="MAT 11:16"/><verse number="17" style="v" sid="MAT 11:17"/><char style="wj">हम ने तुम्हारे लिए बाँसुरी बजाई</char> <note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="fq" closed="false">बाँसुरी बजाई </char><char style="ft" closed="false">ये ख़ुशी के वक़्त बजाई जाती है </char></note> <char style="wj">और तुम न नाचे। हम ने मातम किया और तुम ने छाती न पीटी।</char> <verse eid="MAT 11:17"/><verse number="18" style="v" sid="MAT 11:18"/><char style="wj">क्यूँकि यूहन्ना न खाता आया न पीता और वो कहते हैं उस में बदरूह है।</char> <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/><char style="wj">इब्न — ए — आदम खाता पीता आया। और वो कहते हैं, देखो खाऊ और शराबी आदमी महसूल लेने वालों और गुनाहगारों का यार। मगर हिक्मत अपने कामों से रास्त साबित हुई है।”</char><verse eid="MAT 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>वो उस वक़्त उन शहरों को मलामत करने लगा जिनमें उसके अकसर मोजिज़े ज़ाहिर हुए थे; क्यूँकि उन्होंने तौबा न की थी। <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/><char style="wj">“ऐ ख़ुराज़ीन, तुझ पर अफ़्सोस! ऐ बैत — सैदा, तुझ पर अफ़्सोस! क्यूँकि जो मोजिज़े तुम में हुए अगर सूर और सैदा में होते तो वो टाट ओढ़ कर और ख़ाक में बैठ कर कब के तौबा कर लेते।</char> <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/><char style="wj">मैं तुम से सच कहता हूँ; कि 'अदालत के दिन सूर और सैदा का हाल तुम्हारे हाल से ज़्यादा बर्दाश्त के लायक़ होगा।</char> <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/><char style="wj">और ऐ कफ़रनहूम, क्या तू आस्मान तक बुलन्द किया जाएगा? तू तो आलम — ए अर्वाह में उतरेगा क्यूँकि जो मोजिज़े तुम में ज़ाहिर हुए अगर सदूम में होते तो आज तक क़ाईम रहता।</char> <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/><char style="wj">मगर मैं तुम से कहता हूँ कि 'अदालत के दिन सदूम के इलाक़े का हाल तेरे हाल से ज़्यादा बर्दाश्त के लायक़ होगा।”</char><verse eid="MAT 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>उस वक़्त ईसा ने कहा, <char style="wj">“ऐ बाप, आस्मान — ओ — ज़मीन के ख़ुदावन्द मैं तेरी हम्द करता हूँ कि तू ने यह बातें समझदारों और अक़लमन्दों से छिपाईं और बच्चों पर ज़ाहिर कीं।</char> <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/><char style="wj">हाँ ऐ बाप!, क्यूँकि ऐसा ही तुझे पसन्द आया।”</char><verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>
    <char style="wj">“मेरे बाप की तरफ़ से सब कुछ मुझे सौंपा गया और कोई बेटे को नहीं जानता सिवा बाप के और कोई बाप को नहीं जानता सिवा बेटे के और उसके जिस पर बेटा उसे ज़ाहिर करना चाहे।”</char><verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>
    <char style="wj">“ऐ मेहनत उठाने वालो और बोझ से दबे हुए लोगो, सब मेरे पास आओ! मैं तुम को आराम दूँगा।</char> <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/><char style="wj">मेरा जूआ अपने ऊपर उठा लो और मुझ से सीखो, क्यूँकि मैं हलीम हूँ और दिल का फ़िरोतन तो तुम्हारी जानें आराम पाएँगी,</char> <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/><char style="wj">क्यूँकि मेरा जूआ मुलायम है और मेरा बोझ हल्का।”</char><verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s">सबत के बारे में गुफ़्तगू करना</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>उस वक़्त ईसा सबत के दिन<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="fq" closed="false">सबत के दिन </char><char style="ft" closed="false">ये दिन ख़ुदा ने इबादत का दिन मुक़र्रर किया (सनीचर) </char></note> खेतों में हो कर गया, और उसके शागिर्दों को भूख लगी और वो बालियां तोड़ — तोड़ कर खाने लगे। <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>फ़रीसियों ने देख कर उससे कहा “देख तेरे शागिर्द वो काम करते हैं जो सबत के दिन करना जायज़ नहीं।” <verse eid="MAT 12:2"/><verse number="3" style="v" sid="MAT 12:3"/>उसने उनसे कहा <char style="wj">“क्या तुम ने ये नहीं पढ़ा कि जब दाऊद और उस के साथी भूखा थे; तो उसने क्या किया?</char> <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/><char style="wj">वो क्यूँकर ख़ुदा के घर में गया और नज़्र की रोटियाँ खाईं जिनको खाना उसको जायज़ न था; न उसके साथियों को मगर सिर्फ़ काहिनों को?</char> <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/><char style="wj">क्या तुम ने तौरेत में नहीं पढ़ा कि काहिन सबत के दिन हैकल में सबत की बेहुरमती करते हैं; और बेक़ुसूर रहते हैं?</char> <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/><char style="wj">लेकिन मैं तुम से कहता हूँ कि यहाँ वो है जो हैकल से भी बड़ा है।</char> <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/><char style="wj">लेकिन अगर तुम इसका मतलब जानते कि, मैं क़ुर्बानी नहीं बल्कि, रहम पसन्द करता हूँ। तो बेक़ुसूरों को क़ुसूरवार न ठहराते।</char> <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/><char style="wj">क्यूँकि इब्न — ए — आदम सबत का मालिक है।”</char><verse eid="MAT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>वो वहाँ से चलकर उन के इबादतख़ाने में गया। <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>और देखो; वहाँ एक आदमी था जिस का हाथ सूखा हुआ था उन्होंने उस पर इल्ज़ाम लगाने के 'इरादे से ये पुछा, “क्या सबत के दिन शिफ़ा देना जायज़ है।” <verse eid="MAT 12:10"/><verse number="11" style="v" sid="MAT 12:11"/>उसने उनसे कहा, <char style="wj">“तुम में ऐसा कौन है जिसकी एक भेड़ हो और वो सबत के दिन गड्ढे में गिर जाए तो वो उसे पकड़कर न निकाले?</char> <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/><char style="wj">पस आदमी की क़द्र तो भेड़ से बहुत ही ज़्यादा है; इसलिए सबत के दिन नेकी करना जायज़ है।”</char> <verse eid="MAT 12:12"/><verse number="13" style="v" sid="MAT 12:13"/>तब उसने उस आदमी से कहा <char style="wj">“अपना हाथ बढ़ा।”</char> उस ने बढ़ाया और वो दूसरे हाथ की तरह दुरुस्त हो गया। <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>इस पर फ़रीसियों ने बाहर जाकर उसके बरख़िलाफ़ मशवरा किया कि उसे किस तरह हलाक करें।<verse eid="MAT 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>ईसा ये मा'लूम करके वहाँ से रवाना हुआ; और बहुत से लोग उसके पीछे हो लिए और उसने सब को अच्छा कर दिया, <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>और उनको ताकीद की, कि मुझे ज़ाहिर न करना। <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>ताकि जो यसायाह नबी की मा'रिफ़त कहा गया था वो पूरा हो। <verse eid="MAT 12:17"/><verse number="18" style="v" sid="MAT 12:18"/>'देखो, ये मेरा ख़ादिम है जिसे मैं ने चुना मेरा प्यारा जिससे मेरा दिल ख़ुश है। मैं अपना रूह इस पर डालूँगा, और ये ग़ैर क़ौमों को इन्साफ़ की ख़बर देगा। <verse eid="MAT 12:18"/><verse number="19" style="v" sid="MAT 12:19"/>ये न झगड़ा करेगा न शोर, और न बाज़ारों में कोई इसकी आवाज़ सुनेगा। <verse eid="MAT 12:19"/><verse number="20" style="v" sid="MAT 12:20"/>ये कुचले हुए सरकंडे को न तोड़ेगा और धुवाँ उठते हुए सन को न बुझाएगा; जब तक कि इन्साफ़ की फ़तह न कराए। <verse eid="MAT 12:20"/><verse number="21" style="v" sid="MAT 12:21"/>और इसके नाम से ग़ैर क़ौमें उम्मीद रख्खेंगी।<verse eid="MAT 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>उस वक़्त लोग उसके पास एक अंधे गूँगे को लाए; उसने उसे अच्छा कर दिया चुनाँचे वो गूँगा बोलने और देखने लगा। <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>“सारी भीड़ हैरान होकर कहने लगी; क्या ये इब्न — ए — आदम है?” <verse eid="MAT 12:23"/><verse number="24" style="v" sid="MAT 12:24"/>फ़रीसियों ने सुन कर कहा, “ये बदरूहों के सरदार बा'लज़बूल की मदद के बग़ैर बदरूहों को नहीं निकालता।” <verse eid="MAT 12:24"/><verse number="25" style="v" sid="MAT 12:25"/>उसने उनके ख़यालों को जानकर उनसे कहा, <char style="wj">“जिस बादशाही में फ़ूट पड़ती है वो वीरान हो जाती है और जिस शहर या घर में फ़ूट पड़ेगी वो क़ाईम न रहेगा।</char> <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/><char style="wj">और अगर शैतान ही शैतान को निकाले तो वो आप ही अपना मुख़ालिफ़ हो गया; फिर उसकी बादशाही क्यूँकर क़ाईम रहेगी?</char> <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/><char style="wj">अगर मैं बा'लज़बूल की मदद से बदरूहों को निकालता हूँ तो तुम्हारे बेटे किस की मदद से निकालते हैं? पस वही तुम्हारे मुन्सिफ़ होंगे।</char> <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/><char style="wj">लेकिन अगर मैं ख़ुदा के रूह की मदद से बदरूहों को निकालता हूँ तो ख़ुदा की बादशाही तुम्हारे पास आ पहुँची।</char> <verse eid="MAT 12:28"/><verse number="29" style="v" sid="MAT 12:29"/><char style="wj">या क्यूँकर कोई आदमी किसी ताक़तवर के घर में घुस कर उसका माल लूट सकता है; जब तक कि पहले उस ताक़तवर को न बाँध ले? फिर वो उसका घर लूट लेगा।</char> <verse eid="MAT 12:29"/><verse number="30" style="v" sid="MAT 12:30"/><char style="wj">जो मेरे साथ नहीं वो मेरे ख़िलाफ़ है और जो मेरे साथ जमा नहीं करता वो बिखेरता है।</char> <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/><char style="wj">इसलिए मैं तुम से कहता हूँ कि आदमियों का हर गुनाह और कुफ़्र तो मुआफ़ किया जाएगा; मगर जो कुफ़्र रूह के हक़ में हो वो मु'आफ़ न किया जाएगा।”</char><verse eid="MAT 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 12:32"/>
    <char style="wj">“और जो कोई इब्न — ए — आदम के ख़िलाफ़ कोई बात कहेगा वो तो उसे मु'आफ़ की जाएगी; मगर जो कोई रूह — उल — क़ुद्दूस के ख़िलाफ़ कोई बात कहेगा; वो उसे मु'आफ़ न की जाएगी न इस आलम में न आने वाले में।”</char><verse eid="MAT 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>
    <char style="wj">“या तो दरख़्त को भी अच्छा कहो; और उसके फल को भी अच्छा, या दरख़्त को भी बुरा कहो और उसके फल को भी बुरा; क्यूँकि दरख़्त फल से पहचाना जाता है।</char> <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/><char style="wj">ऐ साँप के बच्चो! तुम बुरे होकर क्यूँकर अच्छी बातें कह सकते हो? क्यूँकि जो दिल में भरा है वही मुँह पर आता है।</char> <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/><char style="wj">अच्छा आदमी अच्छे ख़ज़ाने से अच्छी चीज़ें निकालता है; बुरा आदमी बुरे ख़ज़ाने से बुरी चीज़ें निकालता है।</char> <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/><char style="wj">मैं तुम से कहता हूँ; कि जो निकम्मी बात लोग कहेंगे; 'अदालत के दिन उसका हिसाब देंगे।</char> <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/><char style="wj">क्यूँकि तू अपनी बातों की वजह से रास्तबाज़ ठहराया जाएगा; और अपनी बातों की वजह से क़ुसूरवार ठहराया जाएगा।”</char><verse eid="MAT 12:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>इस पर कुछ आलिमों और फ़रीसियों ने जवाब में उससे कहा, “ऐ उस्ताद हम तुझ से एक निशान देखना चहते हैं।” <verse eid="MAT 12:38"/><verse number="39" style="v" sid="MAT 12:39"/>उस ने जवाब देकर उनसे कहा, <char style="wj">इस ज़माने के बुरे और बे'ईमान लोग निशान तलब करते हैं; मगर यहून्ना नबी के निशान के सिवा कोई और निशान उनको न दिया जाएगा।</char> <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/><char style="wj">क्यूँकि जैसे यहून्ना तीन रात तीन दिन मछली के पेट में रहा; वैसे ही इबने आदम तीन रात तीन दिन ज़मीन के अन्दर रहेगा।</char> <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/><char style="wj">निनवे शहर के लोग 'अदालत के दिन इस ज़माने के लोगों के साथ खड़े होकर इनको मुजरिम ठहराएँगे; क्यूँकि उन्होंने यहून्ना के एलान पर तौबा कर ली; और देखो, यह वो है जो यहून्ना से भी बड़ा है।</char> <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/><char style="wj">दक्खिन की मलिका 'अदालत के दिन इस ज़माने के लोगों के साथ उठकर इनको मुजरिम ठहराएगी; क्यूँकि वो दुनिया के किनारे से सुलैमान की हिक्मत सुनने को आई; और देखो यहाँ वो है जो सुलैमान से भी बड़ा है।</char><verse eid="MAT 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>
    <char style="wj">“जब बदरूह आदमी में से निकलती है तो सूखे मक़ामों में आराम ढूँडती फिरती है, और नहीं पाती।</char> <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/><char style="wj">तब कहती है, मैं अपने उस घर में फिर जाऊँगी जिससे निकली थी। और आकर उसे ख़ाली और झड़ा हुआ और आरास्ता पाती है।</char> <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/><char style="wj">फिर जा कर और सात रूहें अपने से बुरी अपने साथ ले आती है और वो दाख़िल होकर वहाँ बसती हैं; और उस आदमी का पिछला हाल पहले से बदतर हो जाता है, इस ज़माने के बुरे लोगों का हाल भी ऐसा ही होगा।”</char><verse eid="MAT 12:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>जब वो भीड़ से ये कह रहा था, उसकी माँ और भाई बाहर खड़े थे, और उससे बात करना चहते थे। <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>किसी ने उससे कहा, “देख तेरी माँ और भाई बाहर खड़े हैं और तुझ से बात करना चाहते हैं।” <verse eid="MAT 12:47"/><verse number="48" style="v" sid="MAT 12:48"/>उसने ख़बर देने वाले को जवाब में कहा <char style="wj">“कौन है मेरी माँ और कौन हैं मेरे भाई?”</char> <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>फिर अपने शागिर्दों की तरफ़ हाथ बढ़ा कर कहा, <char style="wj">“देखो, मेरी माँ और मेरे भाई ये हैं।</char> <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/><char style="wj">क्यूँकि जो कोई मेरे आस्मानी बाप की मर्ज़ी पर चले वही मेरा भाई, मेरी बहन और माँ है।”</char><verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s">बीज बोने वाले किसान की मिसाल</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>उसी रोज़ ईसा घर से निकलकर झील के किनारे जा बैठा। <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>उस के पास एसी बड़ी भीड़ जमा हो गई, कि वो नाव पर चढ़ बैठा, और सारी भीड़ किनारे पर खड़ी रही। <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>और उसने उनसे बहुत सी बातें मिसालों में कहीं <char style="wj">“देखो एक बोने वाला बीज बोने निकला।</char> <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/><char style="wj">और बोते वक़्त कुछ दाने राह के किनारे गिरे और परिन्दों ने आकर उन्हें चुग लिया।</char> <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/><char style="wj">और कुछ पथरीली ज़मीन पर गिरे जहाँ उनको बहुत मिट्टी न मिली और गहरी मिट्टी न मिलने की वजह से जल्द उग आए।</char> <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/><char style="wj">और जब सूरज निकला तो जल गए और जड़ न होने की वजह से सूख गए।</char> <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/><char style="wj">और कुछ झाड़ियों में गिरे और झाड़ियों ने बढ़ कर उनको दबा लिया।</char> <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/><char style="wj">और कुछ अच्छी ज़मीन पर गिरे और फल लाए; कुछ सौ गुना कुछ साठ गुना कुछ तीस गुना।</char> <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/><char style="wj">जो सुनना चाहता है वो सुन ले!”</char><verse eid="MAT 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>शागिर्दों ने पास आ कर उससे पूछा “तू उनसे मिसालों में क्या बातें करता है?” <verse eid="MAT 13:10"/><verse number="11" style="v" sid="MAT 13:11"/>उस ने जवाब में उनसे कहा <char style="wj">“इसलिए कि तुम को आस्मान की बादशाही के राज़ की समझ दी गई है, मगर उनको नहीं दी गई।</char> <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/><char style="wj">क्यूँकि जिस के पास है उसे दिया जाएगा और उसके पास ज़्यादा हो जाएगा; और जिसके पास नहीं है उस से वो भी ले लिया जाएगा; जो उसके पास है।</char> <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/><char style="wj">मैं उनसे मिसालों में इसलिए बातें कहता हूँ; कि वो देखते हुए नहीं देखते और सुनते हुए नहीं सुनते और नहीं समझते।</char> <verse eid="MAT 13:13"/><verse number="14" style="v" sid="MAT 13:14"/><char style="wj">उनके हक़ में यसायाह की ये नबुव्वत पूरी होती है कि तुम कानों से सुनोगे पर हरगिज़ न समझोगे, और आँखों से देखोगे और हरगिज़ मा'लूम न करोगे।”</char><verse eid="MAT 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 13:15"/>
    <char style="wj">“क्यूँकि इस उम्मत के दिल पर चर्बी छा गई है,</char></para>
  <para style="q" vid="MAT 13:15">
    <char style="wj">और वो कानों से ऊँचा सुनते हैं; और उन्होंने अपनी आँखें बन्द कर ली हैं;</char></para>
  <para style="q" vid="MAT 13:15">
    <char style="wj">ताकि ऐसा न हो कि आँखों से मा'लूम करें</char></para>
  <para style="q" vid="MAT 13:15">
    <char style="wj">और कानों से सुनें और दिल से समझें</char></para>
  <para style="q" vid="MAT 13:15">
    <char style="wj">और रुजू लाएँ और में उनको शिफ़ा बख़्शूँ।”</char><verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>
    <char style="wj">“लेकिन मुबारिक़ हैं तुम्हारी आँखें क्यूँकि वो देखती हैं और तुम्हारे कान इसलिए कि वो सुनते हैं।</char> <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/><char style="wj">क्यूँकि मैं तुम से सच कहता हूँ कि बहुत से नबियों और रास्तबाज़ों की आरज़ू थी कि जो कुछ तुम देखते हो देखें मगर न देखा और जो बातें तुम सुनते हो सुनें मगर न सुनीं।”</char><verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>
    <char style="wj">“पस बोनेवाले की मिसाल सुनो।</char> <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/><char style="wj">जब कोई बादशाही का कलाम सुनता है और समझता नहीं तो जो उसके दिल में बोया गया था उसे वो शैतान छीन ले जाता है ये वो है जो राह के किनारे बोया गया था।</char> <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/><char style="wj">और वो पथरीली ज़मीन में बोया गया; ये वो है जो कलाम को सुनता है, और उसे फ़ौरन ख़ुशी से क़ुबूल कर लेता है।</char> <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/><char style="wj">लेकिन अपने अन्दर जड़ नहीं रखता बल्कि चन्द रोज़ा है, और जब कलाम के वजह से मुसीबत या ज़ुल्म बर्पा होता है तो फ़ौरन ठोकर खाता है।</char> <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/><char style="wj">और जो झाड़ियों में बोया गया, ये वो है जो कलाम को सुनता है और दुनिया की फ़िक्र और दौलत का फ़रेब उस कलाम को दबा देता है; और वो बे फल रह जाता है।</char> <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/><char style="wj">और जो अच्छी ज़मीन में बोया गया, ये वो है जो कलाम को सुनता और समझता है और फल भी लाता है; कोई सौ गुना फलता है, कोई साठ गुना, और कोई तीस गुना।”</char><verse eid="MAT 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>उसने एक और मिसाल उनके सामने पेश करके कहा, <char style="wj">“आसमान की बादशाही उस आदमी की तरह है; जिसने अपने खेत में अच्छा बीज बोया।</char> <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/><char style="wj">मगर लोगों के सोते में उसका दुश्मन आया और गेहूँ में कड़वे दाने भी बो गया।</char> <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/><char style="wj">पस जब पत्तियाँ निकलीं और बालें आईं तो वो कड़वे दाने भी दिखाई दिए।</char> <verse eid="MAT 13:26"/><verse number="27" style="v" sid="MAT 13:27"/><char style="wj">नौकरों ने आकर घर के मालिक से कहा, ‘ऐ ख़ुदावन्द क्या तू ने अपने खेत में अच्छा बीज न बोया था? उस में कड़वे दाने कहाँ से आ गए?’</char> <verse eid="MAT 13:27"/><verse number="28" style="v" sid="MAT 13:28"/><char style="wj">उस ने उनसे कहा, ये किसी दुश्मन का काम है, नौकरों ने उससे कहा, ‘तो क्या तू चाहता है कि हम जाकर उनको जमा करें।’</char> <verse eid="MAT 13:28"/><verse number="29" style="v" sid="MAT 13:29"/><char style="wj">उस ने कहा, नहीं, ऐसा न हो कि कड़वे दाने जमा करने में तुम उनके साथ गेहूँ भी उखाड़ लो।</char> <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/><char style="wj">कटाई तक दोनों को इकट्ठा बढ़ने दो, और कटाई के वक़्त में काटने वालों से कह दूँगा कि पहले कड़वे दाने जमा कर लो और जलाने के लिए उनके गठ्ठे बाँध लो और गेहूँ मेरे खित्ते में जमा कर दो।”</char><verse eid="MAT 13:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>उसने एक और मिसाल उनके सामने पेश करके कहा, <char style="wj">“आसमान की बादशाही उस राई के दाने</char><note caller="+" style="f"><char style="fr" closed="false">13:31 </char><char style="fq" closed="false">राई के दाने </char><char style="ft" closed="false">फ़िलिस्तीन में राई एक पेड़ की तरह होता है जिसमें परिन्दे घोंसला लगा सकते है और बैठ सकते हैं </char></note> <char style="wj">की तरह है जिसे किसी आदमी ने लेकर अपने खेत में बो दिया।</char> <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/><char style="wj">वो सब बीजों से छोटा तो है मगर जब बढ़ता है तो सब तरकारियों से बड़ा और ऐसा दरख़्त हो जाता है, कि हवा के परिन्दे आकर उसकी डालियों पर बसेरा करते हैं।”</char><verse eid="MAT 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>उस ने एक और मिसाल उनको सुनाई। <char style="wj">“आस्मान की बादशाही उस ख़मीर की तरह है जिसे किसी 'औरत ने ले कर तीन पैमाने आटे में मिला दिया और वो होते — होते सब ख़मीर हो गया।”</char><verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>ये सब बातें ईसा ने भीड़ से मिसालों में कहीं और बग़ैर मिसालों के वो उनसे कुछ न कहता था। <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>ताकि जो नबी के ज़रिए कहा गया था वो पूरा हो “मैं मिसालों में अपना मुँह खोलूँगा; में उन बातों को ज़ाहिर करूँगा जो बिना — ए — आलम से छिपी रही हैं।”<verse eid="MAT 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>उस वक़्त वो भीड़ को छोड़ कर घर में गया और उस के शागिर्दों ने उस के पास आकर कहा, “खेत के कड़वे दाने की मिसाल हमें समझा दे।” <verse eid="MAT 13:36"/><verse number="37" style="v" sid="MAT 13:37"/>उस ने जवाब में उन से कहा, <char style="wj">“अच्छे बीज का बोने वाला इबने आदम है।</char> <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/><char style="wj">और खेत दुनिया है और अच्छा बीज बादशाही के फ़र्ज़न्द और कड़वे दाने उस शैतान के फ़र्ज़न्द हैं।</char> <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/><char style="wj">जिस दुश्मन ने उन को बोया वो इब्लीस है। और कटाई दुनिया का आख़िर है और काटने वाले फ़रिश्ते हैं।</char> <verse eid="MAT 13:39"/><verse number="40" style="v" sid="MAT 13:40"/><char style="wj">पस जैसे कड़वे दाने जमा किए जाते और आग में जलाए जाते हैं।</char> <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/><char style="wj">इब्न — ए — आदम अपने फ़रिश्तों को भेजेगा; और वो सब ठोकर खिलाने वाली चीज़ें और बदकारों को उस की बादशाही में से जमा करेंगे।</char> <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/><char style="wj">और उनको आग की भट्टी में डाल देंगे वहाँ रोना और दाँत पीसना होगा।</char> <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/><char style="wj">उस वक़्त रास्तबाज़ अपने बाप की बादशाही में सूरज की तरह चमकेंगे; जिसके कान हों वो सुन ले!”</char><verse eid="MAT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>
    <char style="wj">“आसमान की बादशाही खेत में छिपे ख़ज़ाने की तरह है जिसे किसी आदमी ने पाकर छिपा दिया और ख़ुशी के मारे जाकर जो कुछ उसका था; बेच डाला और उस खेत को ख़रीद लिया।”</char><verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>
    <char style="wj">“फिर आसमान की बादशाही उस सौदागर की तरह है, जो उम्दा मोतियों की तलाश में था।</char> <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/><char style="wj">जब उसे एक बेशक़ीमती मोती मिला तो उस ने जाकर जो कुछ उस का था बेच डाला और उसे ख़रीद लिया।”</char><verse eid="MAT 13:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>
    <char style="wj">“फिर आसमान की बादशाही उस बड़े जाल की तरह है; जो दरिया में डाला गया और उस ने हर क़िस्म की मछलियाँ समेट लीं।</char> <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/><char style="wj">और जब भर गया तो उसे किनारे पर खींच लाए; और बैठ कर अच्छी — अच्छी तो बरतनों में जमा कर लीं और जो ख़राब थी फेंक दीं।</char> <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/><char style="wj">दुनिया के आख़िर में ऐसा ही होगा; फ़रिश्ते निकलेंगे और शरीरों को रास्तबाज़ों से जुदा करेंगे; और उनको आग की भट्टी में डाल देंगे।</char> <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/><char style="wj">वहाँ रोना और दाँत पीसना होगा।”</char><verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>
    <char style="wj">“क्या तुम ये सब बातें समझ गए?”</char> उन्होंने उससे कहा, हाँ। <verse eid="MAT 13:51"/><verse number="52" style="v" sid="MAT 13:52"/>उसने उससे कहा, <char style="wj">“इसलिए हर आलिम जो आसमान की बादशाही का शागिर्द बना है उस घर के मालिक की तरह है जो अपने ख़ज़ाने में से नई और पुरानी चीज़ें निकालता है।”</char><verse eid="MAT 13:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>जब ईसा ये मिसाल ख़त्म कर चुका तो ऐसा हुआ कि वहाँ से रवाना हो गया। <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>और अपने वतन में आकर उनके इबादतख़ाने में उनको ऐसी ता'लीम देने लगा; कि वो हैरान होकर कहने लगे, इस में ये हिक्मत और मोजिज़े कहाँ से आए? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>क्या ये बढ़ई का बेटा नहीं? और इस की माँ का नाम मरियम और इस के भाई या'क़ूब और यूसुफ़ और शमौन और यहूदा नहीं? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>और क्या इस की सब बहनें हमारे यहाँ नहीं? फिर ये सब कुछ इस में कहाँ से आया?<verse eid="MAT 13:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 13:57"/>और उन्होंने उसकी वजह से ठोकर खाई मगर ईसा ने उन से कहा <char style="wj">“नबी अपने वतन और अपने घर के सिवा कहीं बेइज़्ज़त नहीं होता।”</char> <verse eid="MAT 13:57"/><verse number="58" style="v" sid="MAT 13:58"/>और उसने उनकी बेऐ'तिक़ादी की वजह से वहाँ बहुत से मोजिज़े न दिखाए।<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s">यूहन्ना बपतिस्मा देने वाले की मौत</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>उस वक़्त चौथाई मुल्क के हाकिम हेरोदेस ने ईसा की शोहरत सुनी। <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>और अपने ख़ादिमों से कहा “ये यूहन्ना बपतिस्मा देनेवाला है वो मुर्दों में से जी उठा है; इसलिए उससे ये मोजिज़े ज़ाहिर होते हैं।”<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>क्यूँकि हेरोदेस ने अपने भाई फ़िलिप्पुस की बीवी हेरोदियास की वजह से यूहन्ना को पकड़ कर बाँधा और क़ैद खाने में डाल दिया था। <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>क्यूँकि यूहन्ना ने उससे कहा था कि इसका रखना तुझे जायज़ नहीं। <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>और वो हर चन्द उसे क़त्ल करना चाहता था, मगर आम लोगों से डरता था क्यूँकि वो उसे नबी मानते थे। <verse eid="MAT 14:5"/><verse number="6" style="v" sid="MAT 14:6"/>लेकिन जब हेरोदेस की साल गिरह हुई तो हेरोदियास की बेटी ने महफ़िल में नाच कर हेरोदेस को ख़ुश किया। <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>इस पर उसने क़सम खाकर उससे वा'दा किया “जो कुछ तू माँगेगी तुझे दूँगा।” <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>उसने अपनी माँ के सिखाने से कहा, “मुझे यूहन्ना बपतिस्मा देने वाले का सिर थाल में यहीं मँगवा दे।” <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>बादशाह ग़मगीन हुआ; मगर अपनी क़समों और मेहमानों की वजह से उसने हुक्म दिया कि दे दिया जाए। <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>और आदमी भेज कर क़ैद खाने में यूहन्ना का सिर कटवा दिया। <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>और उस का सिर थाल में लाया गया और लड़की को दिया गया; और वो उसे अपनी माँ के पास ले गई। <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>और उसके शागिर्दों ने आकर लाश उठाई और उसे दफ़्न कर दिया, और जा कर ईसा को ख़बर दी।<verse eid="MAT 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>जब ईसा ने ये सुना तो वहाँ से नाव पर अलग किसी वीरान जगह को रवाना हुआ और लोग ये सुनकर शहर — शहर से पैदल उसके पीछे गए। <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>उसने उतर कर बड़ी भीड़ देखी और उसे उन पर तरस आया; और उसने उनके बीमारों को अच्छा कर दिया। <verse eid="MAT 14:14"/><verse number="15" style="v" sid="MAT 14:15"/>जब शाम हुई तो शागिर्द उसके पास आकर कहने लगे “जगह वीरान है और वक़्त गुज़र गया है लोगों को रुख़्सत कर दे ताकि गाँव में जाकर अपने लिए खाना ख़रीद लें।” <verse eid="MAT 14:15"/><verse number="16" style="v" sid="MAT 14:16"/>ईसा ने उनसे कहा, <char style="wj">“इन्हें जाने की ज़रूरत नहीं, तुम ही इनको खाने को दो।”</char> <verse eid="MAT 14:16"/><verse number="17" style="v" sid="MAT 14:17"/>उन्होंने उससे कहा “यहाँ हमारे पास पाँच रोटियाँ और दो मछलियों के सिवा और कुछ नहीं।” <verse eid="MAT 14:17"/><verse number="18" style="v" sid="MAT 14:18"/>उसने कहा <char style="wj">“वो यहाँ मेरे पास ले आओ,”</char> <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>और उसने लोगों को घास पर बैठने का हुक्म दिया। फिर उस ने वो पाँच रोटियों और दो मछलियाँ लीं और आसमान की तरफ़ देख कर बर्क़त दी और रोटियाँ तोड़ कर शागिर्दों को दीं और शागिर्दों ने लोगों को। <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>और सब खाकर सेर हो गए; और उन्होंने बिना इस्तेमाल बचे हुए खाने से भरी हुई बारह टोकरियाँ उठाईं। <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>और खानेवाले औरतों और बच्चों के सिवा पाँच हज़ार मर्द के क़रीब थे।<verse eid="MAT 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>और उसने फ़ौरन शागिर्दों को मजबूर किया कि नाव में सवार होकर उससे पहले पार चले जाएँ जब तक वो लोगों को रुख़्सत करे। <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>और लोगों को रुख़्सत करके तन्हा दुआ करने के लिए पहाड़ पर चढ़ गया; और जब शाम हुई तो वहाँ अकेला था। <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>मगर नाव उस वक़्त झील के बीच में थी और लहरों से डगमगा रही थी; क्यूँकि हवा मुख़ालिफ़ थी। <verse eid="MAT 14:24"/><verse number="25" style="v" sid="MAT 14:25"/>और वो रात के चौथे पहर झील पर चलता हुआ उनके पास आया। <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>शागिर्द उसे झील पर चलते हुए देखकर घबरा गए और कहने लगे “भूत है,” और डर कर चिल्ला उठे। <verse eid="MAT 14:26"/><verse number="27" style="v" sid="MAT 14:27"/>ईसा ने फ़ौरन उन से कहा <char style="wj">“इत्मीनान रख्खो! मैं हूँ। डरो मत।”</char> <verse eid="MAT 14:27"/><verse number="28" style="v" sid="MAT 14:28"/>पतरस ने उससे जवाब में कहा “ऐ ख़ुदावन्द, अगर तू है तो मुझे हुक्म दे कि पानी पर चलकर तेरे पास आऊँ।” <verse eid="MAT 14:28"/><verse number="29" style="v" sid="MAT 14:29"/>उस ने कहा, <char style="wj">“आ।”</char> पतरस नाव से उतर कर ईसा के पास जाने के लिए पानी पर चलने लगा। <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>मगर जब हवा देखी तो डर गया और जब डूबने लगा तो चिल्ला कर कहा “ऐ ख़ुदावन्द, मुझे बचा!” <verse eid="MAT 14:30"/><verse number="31" style="v" sid="MAT 14:31"/>ईसा ने फ़ौरन हाथ बढ़ा कर उसे पकड़ लिया। और उससे कहा, <char style="wj">“ऐ कम ईमान तूने क्यूँ शक किया?”</char> <verse eid="MAT 14:31"/><verse number="32" style="v" sid="MAT 14:32"/>जब वो नाव पर चढ़ आए तो हवा थम गई; <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>जो नाव पर थे, उन्होंने सज्दा करके कहा “यक़ीनन तू ख़ुदा का बेटा है!”<verse eid="MAT 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>वो नदी पार जाकर गनेसरत के इलाक़े में पहुँचे। <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>और वहाँ के लोगों ने उसे पहचान कर उस सारे इलाक़े में ख़बर भेजी; और सब बीमारों को उस के पास लाए। <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>और वो उसकी मिन्नत करने लगे कि उसकी पोशाक का किनारा ही छू लें और जितनों ने उसे छुआ वो अच्छे हो गए।<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s">येसु का अन्दरूनी पाकिज़्गी के बारे में ता'लीमम देना</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>उस वक़्त फ़रीसियों और आलिमों ने येरूशलेम से ईसा के पास आकर कहा। <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>“तेरे शागिर्द हमारे बुज़ुर्गों की रिवायत को क्यूँ टाल देते हैं; कि खाना खाते वक़्त हाथ नहीं धोते?” <verse eid="MAT 15:2"/><verse number="3" style="v" sid="MAT 15:3"/>उस ने जवाब में उनसे कहा <char style="wj">“तुम अपनी रिवायात से ख़ुदा का हुक्म क्यूँ टाल देते हो?</char> <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/><char style="wj">क्यूँकि ख़ुदा ने फ़रमाया है, तू अपने बाप की और अपनी माँ की 'इज़्ज़त करना, और ‘जो बाप या माँ को बुरा कहे वो ज़रूर जान से मारा जाए।’</char> <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/><char style="wj">मगर तुम कहते हो कि जो कोई बाप या माँ से कहे, 'जिस चीज़ का तुझे मुझ से फ़ाइदा पहुँच सकता था, वो ख़ुदा की नज़्र हो चुकी,</char> <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/><char style="wj">तो वो अपने बाप की इज्ज़त न करे; पस तुम ने अपनी रिवायत से ख़ुदा का कलाम बातिल कर दिया।</char> <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/><char style="wj">ऐ रियाकारो! यसायाह ने तुम्हारे हक़ में क्या ख़ूब नबुव्वत की है,</char> <verse eid="MAT 15:7"/><verse number="8" style="v" sid="MAT 15:8"/><char style="wj">ये उम्मत ज़बान से तो मेरी 'इज़्ज़त करती है मगर इन का दिल मुझ से दूर है।</char> <verse eid="MAT 15:8"/><verse number="9" style="v" sid="MAT 15:9"/><char style="wj">और ये बेफ़ाइदा मेरी इबादत करते हैं क्यूँकि इंसानी अहकाम की ता'लीम देते हैं।”</char><verse eid="MAT 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>फिर उस ने लोगों को पास बुला कर उनसे कहा, <char style="wj">“सुनो और समझो।</char> <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/><char style="wj">जो चीज़ मुँह में जाती है, वो आदमी को नापाक नहीं करती मगर जो मुँह से निकलती है वही आदमी को नापाक करती है।”</char> <verse eid="MAT 15:11"/><verse number="12" style="v" sid="MAT 15:12"/>इस पर शागिर्दों ने उसके पास आकर कहा, “क्या तू जानता है कि फ़रीसियों ने ये बात सुन कर ठोकर खाई?” <verse eid="MAT 15:12"/><verse number="13" style="v" sid="MAT 15:13"/>उसने जवाब में कहा, <char style="wj">जो पौदा मेरे आसमानी बाप ने नहीं लगाया, जड़ से उखाड़ा जाएगा।</char> <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/><char style="wj">“उन्हें छोड़ दो, वो अन्धे राह बताने वाले हैं; और अगर अन्धे को अन्धा राह बताएगा तो दोनों गड्ढे में गिरेंगे।”</char><verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>पतरस ने जवाब में उससे कहा “ये मिसाल हमें समझा दे।” <verse eid="MAT 15:15"/><verse number="16" style="v" sid="MAT 15:16"/>उस ने कहा, <char style="wj">“क्या तुम भी अब तक नासमझ हो?</char> <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/><char style="wj">क्या नहीं समझते कि जो कुछ मुँह में जाता है; वो पेट में पड़ता है और गंदगी में फेंका जाता है?</char> <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/><char style="wj">मगर जो बातें मुँह से निकलती हैं वो दिल से निकलती हैं और वही आदमी को नापाक करती हैं।</char> <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/><char style="wj">क्यूँकि बुरे ख़याल, ख़ून रेज़ियाँ, ज़िनाकारियाँ, हरामकारियाँ, चोरियाँ, झूठी, गवाहियाँ, बदगोइयाँ, दिल ही से निकलती हैं।”</char> <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/><char style="wj">“यही बातें हैं जो आदमी को नापाक करती हैं, मगर बग़ैर हाथ धोए खाना खाना आदमी को नापाक नहीं करता।”</char><verse eid="MAT 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>फिर ईसा वहाँ से निकल कर सूर और सैदा के इलाक़े को रवाना हुआ। <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>और देखो, एक कनानी 'औरत उन सरहदों से निकली और पुकार कर कहने लगी, “ऐ ख़ुदावन्द! इबने दाऊद मुझ पर रहम कर! एक बदरूह मेरी बेटी को बहुत सताती है।” <verse eid="MAT 15:22"/><verse number="23" style="v" sid="MAT 15:23"/>मगर उसने उसे कुछ जवाब न दिया “उसके शागिर्दों ने पास आकर उससे ये अर्ज़ किया कि; उसे रुख़्सत कर दे, क्यूँकि वो हमारे पीछे चिल्लाती है।” <verse eid="MAT 15:23"/><verse number="24" style="v" sid="MAT 15:24"/>उसने जवाब में कहा, <char style="wj">“में इस्राईल के घराने की खोई हुई भेड़ों के सिवा और किसी के पास नहीं भेजा गया।”</char> <verse eid="MAT 15:24"/><verse number="25" style="v" sid="MAT 15:25"/>मगर उसने आकर उसे सज्दा किया और कहा “ऐ ख़ुदावन्द, मेरी मदद कर!” <verse eid="MAT 15:25"/><verse number="26" style="v" sid="MAT 15:26"/>उस ने जवाब में कहा <char style="wj">“लड़कों की रोटी लेकर कुत्तों को डाल देना अच्छा नहीं।”</char> <verse eid="MAT 15:26"/><verse number="27" style="v" sid="MAT 15:27"/>उसने कहा “हाँ ख़ुदावन्द, क्यूँकि कुत्ते भी उन टुकड़ों में से खाते हैं जो उनके मालिकों की मेज़ से गिरते हैं।” <verse eid="MAT 15:27"/><verse number="28" style="v" sid="MAT 15:28"/>इस पर ईसा ने जवाब में कहा, <char style="wj">“ऐ 'औरत, तेरा ईमान बहुत बड़ा है। जैसा तू चाहती है तेरे लिए वैसा ही हो; और उस की बेटी ने उसी वक़्त शिफ़ा पाई।”</char><verse eid="MAT 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>फिर ईसा वहाँ से चल कर गलील की झील के नज़दीक आया और पहाड़ पर चढ़ कर वहीं बैठ गया। <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>और एक बड़ी भीड़ लंगड़ों, अन्धों, गूँगों, टुंडों और बहुत से और बीमारों को अपने साथ लेकर उसके पास आई और उनको उसके पाँव में डाल दिया; उसने उन्हें अच्छा कर दिया। <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>चुनाँचे जब लोगों ने देखा कि गूँगे बोलते, टुंडा तन्दरुस्त होते, लंगड़े चलते फिरते और अन्धे देखते हैं तो ता'ज्जुब किया; और इस्राईल के ख़ुदा की बड़ाई की।<verse eid="MAT 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>और ईसा ने अपने शागिर्दों को पास बुला कर कहा, <char style="wj">“मुझे इस भीड़ पर तरस आता है। क्यूँकि ये लोग तीन दिन से बराबर मेरे साथ हैं और इनके पास खाने को कुछ नहीं और मैं इनको भूखा रुख़्सत करना नहीं चाहता; कहीं ऐसा न हो कि रास्ते में थककर रह जाएँ।”</char> <verse eid="MAT 15:32"/><verse number="33" style="v" sid="MAT 15:33"/>शागिर्दों ने उससे कहा, “वीराने में हम इतनी रोटियाँ कहाँ से लाएँ; कि ऐसी बड़ी भीड़ को सेर करें?” <verse eid="MAT 15:33"/><verse number="34" style="v" sid="MAT 15:34"/>ईसा ने उनसे कहा, <char style="wj">“तुम्हारे पास कितनी रोटियाँ हैं?”</char> उन्होंने कहा, “सात और थोड़ी सी छोटी मछलियाँ हैं।” <verse eid="MAT 15:34"/><verse number="35" style="v" sid="MAT 15:35"/>उसने लोगों को हुक्म दिया कि ज़मीन पर बैठ जाएँ। <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>और उन सात रोटियों और मछलियों को लेकर शुक्र किया और उन्हें तोड़ कर शागिर्दों को देता गया और शागिर्द लोगों को। <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>और सब खाकर सेर हो गए; और बिना इस्तेमाल बचे हुए खाने से भरे हुए सात टोकरे उठाए। <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>और खाने वाले सिवा औरतों और बच्चों के चार हज़ार मर्द थे। <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>फिर वो भीड़ को रुख़्सत करके नाव पर सवार हुआ और मगदन की सरहदों में आ गया।<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s">हाकिम का निशानी की मांग करना</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>फिर फ़रीसियों और सदूक़ियों ने 'ईसा के पास आकर आज़माने के लिए उससे दरख़्वास्त की; कि हमें कोई आसमानी निशान दिखा। <verse eid="MAT 16:1"/><verse number="2" style="v" sid="MAT 16:2"/>उसने जवाब में उनसे कहा <char style="wj">“शाम को तुम कहते हो, खुला रहेगा, क्यूँकि आसमान लाल है</char> <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/><char style="wj">और सुबह को ये कि आज आन्धी चलेगी क्यूँकि आसमान लाल धुन्धला है तुम आसमान की सूरत में तो पहचान करना जानते हो मगर ज़मानो की अलामतों में पहचान नहीं कर सकते।</char> <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/><char style="wj">इस ज़माने के बुरे और बे'ईमान लोग निशान तलब करते हैं; मगर यहून्ना के निशान के सिवा कोई और निशान उनको न दिया जाएगा।”</char> और वो उनको छोड़ कर चला गया।<verse eid="MAT 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>शागिर्द पार जाते वक़्त रोटी साथ लेना भूल गए थे। <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>ईसा ने उन से कहा, <char style="wj">“ख़बरदार, फ़रीसियों और सदूक़ियों के ख़मीर से होशियार रहना।”</char> <verse eid="MAT 16:6"/><verse number="7" style="v" sid="MAT 16:7"/>वो आपस में चर्चा करने लगे, “हम रोटी नहीं लाए।” <verse eid="MAT 16:7"/><verse number="8" style="v" sid="MAT 16:8"/>ईसा ने ये मालूम करके कहा, <char style="wj">“ऐ कम — ऐ'तिक़ादों तुम आपस में क्यूँ चर्चा करते हो कि हमारे पास रोटी नहीं?</char> <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/><char style="wj">क्या अब तक नहीं समझते और उन पाँच हज़ार आदमियों की पाँच रोटियाँ तुम को याद नहीं? और न ये कि कितनी टोकरियाँ उठाईं?</char> <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/><char style="wj">और न उन चार हज़ार आदमियों की सात रोटियाँ? और न ये कि कितने टोकरे उठाए।</char> <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/><char style="wj">क्या वजह है कि तुम ये नहीं समझते कि मैंने तुम से रोटी के बारे में नहीं कहा फ़रीसियों और सदूक़ियों के ख़मीर से होशियार रहो।”</char> <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>जब उनकी समझ में न आया कि उसने रोटी के ख़मीर से नहीं; बल्कि फ़रीसियों और सदूक़ियों की ता'लीम से ख़बरदार रहने को कहा था।<verse eid="MAT 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>जब ईसा क़ैसरिया फ़िलप्पी के इलाक़े में आया तो उसने अपने शागिर्दों से ये पूछा, <char style="wj">“लोग इब्न — ए — आदम को क्या कहते हैं?”</char> <verse eid="MAT 16:13"/><verse number="14" style="v" sid="MAT 16:14"/>उन्होंने कहा, कुछ यूहन्ना बपतिस्मा देने वाला कहते हैं। “कुछ एलियाह और कुछ यरमियाह या नबियों में से कोई।” <verse eid="MAT 16:14"/><verse number="15" style="v" sid="MAT 16:15"/>उसने उनसे कहा, <char style="wj">“मगर तुम मुझे क्या कहते हो?”</char> <verse eid="MAT 16:15"/><verse number="16" style="v" sid="MAT 16:16"/>शमौन पतरस ने जवाब में कहा, “तू ज़िन्दा ख़ुदा का बेटा मसीह है।” <verse eid="MAT 16:16"/><verse number="17" style="v" sid="MAT 16:17"/>ईसा ने जवाब में उससे कहा, <char style="wj">“मुबारिक़ है तू शमौन बर — यहून्ना, क्यूँकि ये बात गोश्त और ख़ून ने नहीं, बल्कि मेरे बाप ने जो आसमान पर है; तुझ पर ज़ाहिर की है।</char> <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/><char style="wj">और मैं भी तुम से कहता हूँ; कि तू पतरस है; और मैं इस पत्थर पर अपनी कलीसिया बनाऊँगा। और आलम — ए — अरवाह के दरवाज़े उस पर ग़ालिब न आएँगे।</char> <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/><char style="wj">मैं आसमान की बादशाही की कुन्जियाँ तुझे दूँगा; और जो कुछ तू ज़मीन पर बाँधे गा वो आसमान पर बाँधेगा और जो कुछ तू ज़मीन पर खोले गा वो आसमान पर खुलेगा।”</char> <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>उस वक़्त उसने शागिर्दों को हुक्म दिया कि किसी को न बताना कि मैं मसीह हूँ।<verse eid="MAT 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>उस वक़्त से ईसा अपने शागिर्दों पर ज़ाहिर करने लगा “कि उसे ज़रूर है कि येरूशलेम को जाए और बुज़ुर्गों और सरदार काहिनों और आलिमों की तरफ़ से बहुत दु:ख उठाए; और क़त्ल किया जाए और तीसरे दिन जी उठे।” <verse eid="MAT 16:21"/><verse number="22" style="v" sid="MAT 16:22"/>इस पर पतरस उसको अलग ले जाकर मलामत करने लगा “ऐ ख़ुदावन्द, ख़ुदा न करे ये तुझ पर हरगिज़ नहीं आने का।” <verse eid="MAT 16:22"/><verse number="23" style="v" sid="MAT 16:23"/>उसने फिर कर पतरस से कहा, <char style="wj">“ऐ शैतान, मेरे सामने से दूर हो! तू मेरे लिए ठोकर का बा'इस है; क्यूँकि तू ख़ुदा की बातों का नहीं बल्कि आदमियों की बातों का ख़याल रखता है।”</char><verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>उस वक़्त ईसा ने अपने शागिर्दों से कहा, <char style="wj">“अगर कोई मेरे पीछे आना चाहे तो अपने आपका इन्कार करे; अपनी सलीब उठाए और मेरे पीछे हो ले।</char> <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/><char style="wj">क्यूँकि जो कोई अपनी जान बचाना चाहे उसे खोएगा; और जो कोई मेरी ख़ातिर अपनी जान खोएगा उसे पाएगा।</char> <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/><char style="wj">अगर आदमी सारी दुनिया हासिल करे और अपनी जान का नुक़्सान उठाए तो उसे क्या फ़ाइदा होगा?</char> <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/><char style="wj">क्यूँकि इब्न — ए — आदम अपने बाप के जलाल में अपने फ़रिश्तों के साथ आएगा; उस वक़्त हर एक को उसके कामों के मुताबिक़ बदला देगा।</char> <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/><char style="wj">मैं तुम से सच कहता हूँ कि जो यहाँ खड़े हैं उन में से कुछ ऐसे हैं कि जब तक इब्न — ए — आदम को उसकी बादशाही में आते हुए न देख लेंगे; मौत का मज़ा हरगिज़ न चखेंगे।”</char><verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s">तब्दिल-ए-हैयात</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>छः दिन के बाद ईसा ने पतरस, को और याक़ूब और उसके भाई यूहन्ना को साथ लिया और उन्हें एक ऊँचे पहाड़ पर ले गया। <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>और उनके सामने उसकी सूरत बदल गई; और उसका चेहरा सूरज की तरह चमका और उसकी पोशाक नूर की तरह सफ़ेद हो गई। <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>और देखो; मूसा और एलियाह उसके साथ बातें करते हुए उन्हें दिखाई दिए। <verse eid="MAT 17:3"/><verse number="4" style="v" sid="MAT 17:4"/>पतरस ने ईसा से कहा “ऐ ख़ुदावन्द, हमारा यहाँ रहना अच्छा है; मर्ज़ी हो तो मैं यहाँ तीन डेरे बनाऊँ। एक तेरे लिए; एक मूसा के लिए; और एक एलियाह के लिए।” <verse eid="MAT 17:4"/><verse number="5" style="v" sid="MAT 17:5"/>वो ये कह ही रहा था कि देखो; “एक नूरानी बादल ने उन पर साया कर लिया और उस बादल में से आवाज़ आई; ये मेरा प्यारा बेटा है जिससे मैं ख़ुश हूँ; उसकी सुनो।” <verse eid="MAT 17:5"/><verse number="6" style="v" sid="MAT 17:6"/>शागिर्द ये सुनकर मुँह के बल गिरे और बहुत डर गए। <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>ईसा ने पास आ कर उन्हें छुआ और कहा, <char style="wj">“उठो, डरो मत।”</char> <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>जब उन्होंने अपनी आँखें उठाईं तो ईसा के सिवा और किसी को न देखा। <verse eid="MAT 17:8"/><verse number="9" style="v" sid="MAT 17:9"/>जब वो पहाड़ से उतर रहे थे तो ईसा ने उन्हें ये हुक्म दिया <char style="wj">“जब तक इब्न — ए — आदम मुर्दों में से जी न उठे; जो कुछ तुम ने देखा है किसी से इसका ज़िक्र न करना।”</char> <verse eid="MAT 17:9"/><verse number="10" style="v" sid="MAT 17:10"/>शागिर्दों ने उस से पूछा, “फिर आलिम क्यूँ कहते हैं कि एलियाह का पहले आना ज़रूर है?” <verse eid="MAT 17:10"/><verse number="11" style="v" sid="MAT 17:11"/>उस ने जवाब में कहा, <char style="wj">“एलियाह अलबत्ता आएगा और सब कुछ बहाल करेगा।</char> <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/><char style="wj">लेकिन मैं तुम से कहता हूँ; कि एलियाह तो आ चुका और उन्हों ने उसे नहीं पहचाना बल्कि जो चाहा उसके साथ किया; इसी तरह इबने आदम भी उनके हाथ से दु:ख उठाएगा।”</char> <verse eid="MAT 17:12"/><verse number="13" style="v" sid="MAT 17:13"/>और शागिर्द समझ गए; कि उसने उनसे यूहन्ना बपतिस्मा देने वाले के बारे में कहा है।<verse eid="MAT 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>और जब वो भीड़ के पास पहुँचे तो एक आदमी उसके पास आया; और उसके आगे घुटने टेक कर कहने लगा। <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>“ऐ ख़ुदावन्द, मेरे बेटे पर रहम कर, क्यूँकि उसको मिर्गी आती है और वो बहुत दु:ख उठाता है; इसलिए कि अक्सर आग और पानी में गिर पड़ता है। <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>और मैं उसको तेरे शागिर्दों के पास लाया था; मगर वो उसे अच्छा न कर सके।” <verse eid="MAT 17:16"/><verse number="17" style="v" sid="MAT 17:17"/>ईसा ने जवाब में कहा, <char style="wj">“ऐ बे ऐ'तिक़ाद और टेढ़ी नस्ल मैं कब तक तुम्हारे साथ रहूँगा? कब तक तुम्हारी बर्दाश्त करूँगा? उसे यहाँ मेरे पास लाओ।”</char> <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>ईसा ने उसे झिड़का और बदरूह उससे निकल गई; वो लड़का उसी वक़्त अच्छा हो गया।<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>तब शागिर्दों ने ईसा के पास आकर तन्हाई में कहा “हम इस को क्यूँ न निकाल सके?” <verse eid="MAT 17:19"/><verse number="20" style="v" sid="MAT 17:20"/>उस ने उनसे कहा, <char style="wj">“अपने ईमान की कमी की वजह से ‘क्यूँकि मैं तुम से सच कहता हूँ, कि अगर तुम में राई के दाने के बराबर भी ईमान होगा’ तो इस पहाड़ से कह सकोगे; यहाँ से सरक कर वहाँ चला जा, और वो चला जाएगा; और कोई बात तुम्हारे लिए नामुमकिन न होगी।”</char> <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/><char style="wj">(लेकिन ये क़िस्म दुआ और रोज़े के सिवा और किसी तरह नहीं निकल सकती)</char><verse eid="MAT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>जब वो गलील में ठहरे हुए थे, ईसा ने उनसे कहा, <char style="wj">“इब्न — ए — आदम आदमियों के हवाले किया जाएगा।</char> <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/><char style="wj">और वो उसे क़त्ल करेंगे और तीसरे दिन ज़िन्दा किया जाएगा।”</char> इस पर वो बहुत ही ग़मगीन हुए।<verse eid="MAT 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>और जब कफ़रनहूम में आए तो नीम मिस्क़ाल लेनेवालों ने पतरस के पास आकर कहा, “क्या तुम्हारा उस्ताद नीम मिस्क़ाल नहीं देता?” <verse eid="MAT 17:24"/><verse number="25" style="v" sid="MAT 17:25"/>उसने कहा, “हाँ देता है।” और जब वो घर में आया तो ईसा ने उसके बोलने से पहले ही कहा, ऐ <char style="wj">“शमौन तू क्या समझता है? दुनिया के बादशाह किनसे महसूल या जिज़िया लेते हैं; अपने बेटों से या ग़ैरों से?”</char> <verse eid="MAT 17:25"/><verse number="26" style="v" sid="MAT 17:26"/>जब उसने कहा, “ग़ैरों से,” तो ईसा ने उनसे कहा, <char style="wj">“पस बेटे बरी हुए।</char> <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/><char style="wj">लेकिन मुबाद हम इनके लिए ठोकर का बा'इस हों तू झील पर जाकर बन्सी डाल और जो मछली पहले निकले उसे ले और जब तू उसका मुँह खोलेगा; तो एक चाँदी का सिक्का पाएगा; वो लेकर मेरे और अपने लिए उन्हें दे।”</char><verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s">पुरी बादशाहत में सबसे बड़ा</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>उस वक़्त शागिर्द ईसा के पास आ कर कहने लगे, “पस आस्मान की बादशाही में बड़ा कौन है?” <verse eid="MAT 18:1"/><verse number="2" style="v" sid="MAT 18:2"/>उसने एक बच्चे को पास बुलाकर उसे उनके बीच में खड़ा किया। <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>और कहा, <char style="wj">“मैं तुम से सच कहता हूँ कि अगर तुम तौबा न करो और बच्चों की तरह न बनो तो आस्मान की बादशाही में हरगिज़ दाख़िल न होगे।</char> <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/><char style="wj">पस जो कोई अपने आपको इस बच्चे की तरह छोटा बनाएगा; वही आसमान की बादशाही में बड़ा होगा।</char> <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/><char style="wj">और जो कोई ऐसे बच्चे को मेरे नाम पर क़ुबूल करता है; वो मुझे क़ुबूल करता है।”</char><verse eid="MAT 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>
    <char style="wj">“लेकिन जो कोई इन छोटों में से जो मुझ पर ईमान लाए हैं; किसी को ठोकर खिलाता है उसके लिए ये बेहतर है कि बड़ी चक्की का पाट उसके गले में लटकाया जाए और वो गहरे समुन्दर में डुबो दिया जाए।</char> <verse eid="MAT 18:6"/><verse number="7" style="v" sid="MAT 18:7"/><char style="wj">ठोकरों की वजह से दुनिया पर अफ़्सोस है; क्यूँकि ठोकरों का होना ज़रूर है; लेकिन उस आदमी पर अफ़्सोस है; जिसकी वजह से ठोकर लगे।”</char><verse eid="MAT 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8"/>
    <char style="wj">“पस अगर तेरा हाथ या तेरा पाँव तुझे ठोकर खिलाए तो उसे काट कर अपने पास से फेंक दे; टुंडा या लंगड़ा होकर ज़िन्दगी में दाख़िल होना तेरे लिए इससे बेहतर है; कि दो हाथ या दो पाँव रखता हुआ तू हमेशा की आग में डाला जाए।</char> <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/><char style="wj">और अगर तेरी आँख तुझे ठोकर खिलाए तो उसे निकाल कर अपने से फेंक दे; काना हो कर ज़िन्दगी में दाख़िल होना तेरे लिए इससे बेहतर है कि दो आँखें रखता हुआ तू जहन्नुम कि आग में डाला जाए।”</char><verse eid="MAT 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>
    <char style="wj">“ख़बरदार! इन छोटों में से किसी को नाचीज़ न जानना। क्यूँकि मैं तुम से कहता हूँ; कि आसमान पर उनके फ़रिश्ते मेरे आसमानी बाप का मुँह हर वक़्त देखते हैं।</char> <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/><char style="wj">क्यूँकि इब्न — ए — आदम खोए हुओं को ढूँडने और नजात देने आया है।”</char><verse eid="MAT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>
    <char style="wj">“तुम क्या समझते हो? अगर किसी आदमी की सौ भेड़ें हों और उन में से एक भटक जाए; तो क्या वो निनानवें को छोड़कर और पहाड़ों पर जाकर उस भटकी हुई को न ढूँडेगा?</char> <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/><char style="wj">और अगर ऐसा हो कि उसे पाए; तो मैं तुम से सच कहता हूँ; कि वो उन निनानवें से जो भटकी हुई नहीं इस भेड़ की ज़्यादा ख़ुशी करेगा।</char> <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/><char style="wj">इस तरह तुम्हारा आसमानी बाप ये नहीं चाहता कि इन छोटों में से एक भी हलाक हो।”</char><verse eid="MAT 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>
    <char style="wj">“अगर तेरा भाई तेरा गुनाह करे तो जा और अकेले में बात चीत करके उसे समझा; और अगर वो तेरी सुने तो तूने अपने भाई को पा लिया।</char> <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/><char style="wj">और अगर न सुने, तो एक दो आदमियों को अपने साथ ले जा, ताकि हर एक बात दो तीन गवाहों की ज़बान से साबित हो जाए।</char> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/><char style="wj">और अगर वो उनकी भी सुनने से इन्कार करे, तो कलीसिया से कह, और अगर कलीसिया की भी सुनने से इन्कार करे तो तू उसे ग़ैर क़ौम वाले और महसूल लेने वाले के बराबर जान।”</char><verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>
    <char style="wj">“मैं तुम से सच कहता हूँ; कि जो कुछ तुम ज़मीन पर बाँधोगे वो आसमान पर बँधेगा; और जो कुछ तुम ज़मीन पर खोलोगे; वो आसमान पर खुलेगा।</char> <verse eid="MAT 18:18"/><verse number="19" style="v" sid="MAT 18:19"/><char style="wj">फिर मैं तुम से कहता हूँ; कि अगर तुम में से दो शख़्स ज़मीन पर किसी बात के लिए जिसे वो चाहते हों इत्तफ़ाक़ करें तो वो मेरे बाप की तरफ़ से जो आसमान पर है, उनके लिए हो जाएगी।</char> <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/><char style="wj">क्यूँकि जहाँ दो या तीन मेरे नाम से इकट्ठे हैं, वहाँ मैं उनके बीच में हूँ।”</char><verse eid="MAT 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>उस वक़्त पतरस ने पास आकर उससे कहा “ऐ ख़ुदावन्द, अगर मेरा भाई मेरा गुनाह करता रहे, तो मैं कितनी मर्तबा उसे मु'आफ़ करूँ? क्या सात बार तक?” <verse eid="MAT 18:21"/><verse number="22" style="v" sid="MAT 18:22"/>ईसा ने उससे कहा, <char style="wj">“मैं तुझ से ये नहीं कहता कि सात बार, बल्कि सात दफ़ा के सत्तर बार तक।”</char><verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>
    <char style="wj">“पस आसमान की बादशाही उस बादशाह की तरह है जिसने अपने नौकरों से हिसाब लेना चाहा।</char> <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/><char style="wj">और जब हिसाब लेने लगा तो उसके सामने एक क़र्ज़दार हाज़िर किया गया; जिस पर उसके दस हज़ार चाँदी के सिक्के आते थे।</char> <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/><char style="wj">मगर चूँकि उसके पास अदा करने को कुछ न था; इसलिए उसके मालिक ने हुक्म दिया कि, ये और इसकी बीवी और बच्चे और जो कुछ इसका है सब बेचा जाए और क़र्ज़ वसूल कर लिया जाए।</char> <verse eid="MAT 18:25"/><verse number="26" style="v" sid="MAT 18:26"/><char style="wj">पस नौकर ने गिरकर उसे सज्दा किया और कहा, ‘ऐ ख़ुदावन्द मुझे मोहलत दे, मैं तेरा सारा क़र्ज़ा अदा करूँगा।’</char> <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/><char style="wj">उस नौकर के मालिक ने तरस खाकर उसे छोड़ दिया, और उसका क़र्ज़ बख़्श दिया।”</char><verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>
    <char style="wj">“जब वो नौकर बाहर निकला तो उसके हम ख़िदमतों में से एक उसको मिला जिस पर उसके सौ चाँदी के सिक्के आते थे। उसने उसको पकड़ कर उसका गला घोंटा और कहा, ‘जो मेरा आता है अदा कर दे!’</char> <verse eid="MAT 18:28"/><verse number="29" style="v" sid="MAT 18:29"/><char style="wj">पस उसके हमख़िदमत ने उसके सामने गिरकर मिन्नत की और कहा, मुझे मोहलत दे; मैं तुझे अदा कर दूँगा।</char> <verse eid="MAT 18:29"/><verse number="30" style="v" sid="MAT 18:30"/><char style="wj">उसने न माना; बल्कि जाकर उसे क़ैदख़ाने में डाल दिया; कि जब तक क़र्ज़ अदा न कर दे क़ैद रहे।</char> <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/><char style="wj">पस उसके हमख़िदमत ये हाल देखकर बहुत ग़मगीन हुए; और आकर अपने मालिक को सब कुछ जो हुआ था; सुना दिया।</char> <verse eid="MAT 18:31"/><verse number="32" style="v" sid="MAT 18:32"/><char style="wj">इस पर उसके मालिक ने उसको पास बुला कर उससे कहा, ‘ऐ शरीर नौकर; मैं ने वो सारा क़र्ज़ तुझे इसलिए मु'आफ़ कर दिया; कि तूने मेरी मिन्नत की थी।</char> <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/><char style="wj">क्या तुझे ज़रूरी न था, कि जैसे मैं ने तुझ पर रहम किया; तू भी अपने हमख़िदमत पर रहम करता?’</char> <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/><char style="wj">उसके मालिक ने ख़फ़ा होकर उसको जल्लादों के हवाले किया; कि जब तक तमाम क़र्ज़ अदा न कर दे क़ैद रहे।”</char><verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>
    <char style="wj">“मेरा आसमानी बाप भी तुम्हारे साथ इसी तरह करेगा; अगर तुम में से हर एक अपने भाई को दिल से मु'आफ़ न करे।”</char><verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s">तलाक और निकाह के बारे में गुफ़्तगू</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>जब ईसा ये बातें ख़त्म कर चुका तो ऐसा हुआ कि गलील को रवाना होकर यरदन के पार यहूदिया की सरहदों में आया। <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>और एक बड़ी भीड़ उसके पीछे हो ली; और उस ने उन्हें वहीं अच्छा किया। <verse eid="MAT 19:2"/><verse number="3" style="v" sid="MAT 19:3"/>और फ़रीसी उसे आज़माने को उसके पास आए और कहने लगे “क्या हर एक वजह से अपनी बीवी को छोड़ देना जायज़ है?” <verse eid="MAT 19:3"/><verse number="4" style="v" sid="MAT 19:4"/>उस ने जवाब में कहा, <char style="wj">“क्या तुम ने नहीं पढ़ा कि जिसने उन्हें बनाया उसने शुरू ही से उन्हें मर्द और 'औरत बना कर कहा?</char> <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/><char style="wj">‘कि इस वजह से मर्द बाप से और माँ से जुदा होकर अपनी बीवी के साथ रहेगा; और वो दोनों एक जिस्म होंगे।’</char> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/><char style="wj">पस वो दो नहीं, बल्कि एक जिस्म हैं; इसलिए जिसे ख़ुदा ने जोड़ा है उसे आदमी जुदा न करे।”</char> <verse eid="MAT 19:6"/><verse number="7" style="v" sid="MAT 19:7"/>उन्होंने उससे कहा, “फिर मूसा ने क्यूँ हुक्म दिया है; कि तलाक़ नामा देकर छोड़ दी जाए?” <verse eid="MAT 19:7"/><verse number="8" style="v" sid="MAT 19:8"/>उस ने उनसे कहा, <char style="wj">मूसा ने तुम्हारी सख़्त दिली की वजह से तुम को अपनी बीवियों को छोड़ देने की इजाज़त दी; मगर शुरू से ऐसा न था।</char> <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/><char style="wj">“और मैं तुम से कहता हूँ; कि जो कोई अपनी बीवी को हरामकारी के सिवा किसी और वजह से छोड़ दे; और दूसरी शादी करे, वो ज़िना करता है; और जो कोई छोड़ी हुई से शादी कर ले, वो भी ज़िना करता है।”</char><verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>शागिर्दों ने उससे कहा, “अगर मर्द का बीवी के साथ ऐसा ही हाल है, तो शादी करना ही अच्छा नहीं।”<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>उसने उनसे कहा, <char style="wj">सब इस बात को क़ुबूल नहीं कर सकते मगर वही जिनको ये क़ुदरत दी गई है।</char><verse eid="MAT 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 19:12"/>
    <char style="wj">क्यूँकि कुछ ख़ोजे ऐसे हैं 'जो माँ के पेट ही से ऐसे पैदा हुए, और कुछ ख़ोजे ऐसे हैं जिनको आदमियों ने ख़ोजा बनाया; और कुछ ख़ोजे ऐसे हैं, जिन्होंने आसमान की बादशाही के लिए अपने आप को ख़ोजा बनाया, जो क़ुबूल कर सकता है करे।</char><verse eid="MAT 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>उस वक़्त लोग बच्चों को उसके पास लाए, ताकि वो उन पर हाथ रख्खे और दुआ दे मगर शागिर्दों ने उन्हें झिड़का। <verse eid="MAT 19:13"/><verse number="14" style="v" sid="MAT 19:14"/>लेकिन ईसा ने उनसे कहा, <char style="wj">बच्चों को मेरे पास आने दो और उन्हें मनह न करो, क्यूँकि आसमान की बादशाही ऐसों ही की है।</char> <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>और वो उन पर हाथ रखकर वहीं से चला गया।<verse eid="MAT 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>और देखो; एक शख़्स ने पास आकर उससे कहा “मैं कौन सी नेकी करूँ, ताकि हमेशा की ज़िन्दगी पाऊँ?” <verse eid="MAT 19:16"/><verse number="17" style="v" sid="MAT 19:17"/>उसने उससे कहा, <char style="wj">“तू मुझ से नेकी की वजह क्यूँ पूछता है? नेक तो एक ही है लेकिन अगर तू ज़िन्दगी में दाख़िल होना चाहता है तो हुक्मों पर अमल कर।”</char> <verse eid="MAT 19:17"/><verse number="18" style="v" sid="MAT 19:18"/>उसने उससे कहा, “कौन से हुक्म पर?” ईसा ने कहा, <char style="wj">“ये कि ख़ून न कर ज़िना न कर चोरी न कर, झूठी गवाही न दे।</char> <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/><char style="wj">अपने बाप की और माँ की इज़्ज़त कर और अपने पड़ोसी से अपनी तरह मुहब्बत रख।”</char> <verse eid="MAT 19:19"/><verse number="20" style="v" sid="MAT 19:20"/>उस जवान ने उससे कहा कि “मैंने उन सब पर अमल किया है अब मुझ में किस बात की कमी है?” <verse eid="MAT 19:20"/><verse number="21" style="v" sid="MAT 19:21"/>ईसा ने उससे कहा, <char style="wj">“अगर तू कामिल होना चाहे तो जा अपना माल — ओ — अस्बाब बेच कर ग़रीबों को दे, तुझे आसमान पर ख़ज़ाना मिलेगा; और आकर मेरे पीछे होले।”</char> <verse eid="MAT 19:21"/><verse number="22" style="v" sid="MAT 19:22"/>मगर वो जवान ये बात सुनकर उदास होकर चला गया, क्यूँकि बड़ा मालदार था।<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>ईसा ने अपने शागिर्दों से कहा <char style="wj">“मैं तुम से सच कहता हूँ कि दौलतमन्द का आस्मान की बादशाही में दाख़िल होना मुश्किल है।</char> <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/><char style="wj">और फिर तुम से कहता हूँ, 'कि ऊँट का सूई के नाके में से निकल जाना इससे आसान है कि दौलतमन्द ख़ुदा की बादशाही में दाख़िल हो।”</char> <verse eid="MAT 19:24"/><verse number="25" style="v" sid="MAT 19:25"/>शागिर्द ये सुनकर बहुत ही हैरान हुए और कहने लगे “फिर कौन नजात पा सकता है?” <verse eid="MAT 19:25"/><verse number="26" style="v" sid="MAT 19:26"/>ईसा ने उनकी तरफ़ देखकर कहा <char style="wj">“ये आदमियों से तो नहीं हो सकता; लेकिन ख़ुदा से सब कुछ हो सकता है।”</char> <verse eid="MAT 19:26"/><verse number="27" style="v" sid="MAT 19:27"/>इस पर पतरस ने जवाब में उससे कहा “देख हम तो सब कुछ छोड़ कर तेरे पीछे हो लिए हैं; पस हम को क्या मिलेगा?” <verse eid="MAT 19:27"/><verse number="28" style="v" sid="MAT 19:28"/>ईसा ने उस से कहा, <char style="wj">“मैं तुम से सच कहता हूँ कि जब इबने आदम नई पैदाइश में अपने जलाल के तख़्त पर बैठेगा, तो तुम भी जो मेरे पीछे हो लिए हो बारह तख़्तों पर बैठ कर इस्राईल के बारह क़बीलों का इन्साफ़ करोगे।</char> <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/><char style="wj">और जिस किसी ने घरों, या भाइयों, या बहनों, या बाप, या माँ, या बच्चों, या खेतों को मेरे नाम की ख़ातिर छोड़ दिया है, उसको सौ गुना मिलेगा और हमेशा की ज़िन्दगी का वारिस होगा।</char> <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/><char style="wj">लेकिन बहुत से पहले आख़िर हो जाएँगे और आख़िर पहले।”</char><verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s">किसी बगीचे के मालियों के बारे में एक तमसील</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>
    <char style="wj">“क्यूँकि आस्मान की बादशाही उस घर के मालिक की तरह है, जो सवेरे निकला ताकि अपने बाग़ में मज़दूर लगाए।</char> <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/><char style="wj">उसने मज़दूरों से एक दीनार रोज़ तय करके उन्हें अपने बाग़ में भेज दिया।</char> <verse eid="MAT 20:2"/><verse number="3" style="v" sid="MAT 20:3"/><char style="wj">फिर पहर दिन चढ़ने के क़रीब निकल कर उसने औरों को बाज़ार में बेकार खड़े देखा,</char> <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/><char style="wj">और उन से कहा, 'तुम भी बाग़ में चले जाओ, जो वाजिब है तुम को दूँगा। पस वो चले गए।</char> <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/><char style="wj">फिर उसने दोपहर और तीसरे पहर के क़रीब निकल कर वैसा ही किया।</char> <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/><char style="wj">और कोई एक घंटा दिन रहे फिर निकल कर औरों को खड़े पाया, और उनसे कहा, 'तुम क्यूँ यहाँ तमाम दिन बेकार खड़े हो?'</char> <verse eid="MAT 20:6"/><verse number="7" style="v" sid="MAT 20:7"/><char style="wj">उन्होंने उससे कहा, 'इस लिए कि किसी ने हम को मज़दूरी पर नहीं लगाया। उस ने उनसे कहा, 'तुम भी बाग़ में चले जाओ।”</char><verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>
    <char style="wj">“जब शाम हुई तो बाग़ के मालिक ने अपने कारिन्दे से कहा, 'मज़दूरों को बुलाओ और पिछलों से लेकर पहलों तक उनकी मज़दूरी दे दो।</char> <verse eid="MAT 20:8"/><verse number="9" style="v" sid="MAT 20:9"/><char style="wj">जब वो आए जो घंटा भर दिन रहे लगाए गए थे, तो उनको एक — एक दीनार मिला।</char> <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/><char style="wj">जब पहले मज़दूर आए तो उन्होंने ये समझा कि हम को ज़्यादा मिलेगा; और उनको भी एक ही दीनार मिला।</char> <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/><char style="wj">जब मिला तो घर के मालिक से ये कह कर शिकायत करने लगे,</char> <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/><char style="wj">'इन पिछलों ने एक ही घंटा काम किया है और तूने इनको हमारे बराबर कर दिया जिन्होंने दिन भर बोझ उठाया और सख़्त धूप सही?'</char> <verse eid="MAT 20:12"/><verse number="13" style="v" sid="MAT 20:13"/><char style="wj">उसने जवाब देकर उन में से एक से कहा, 'मियाँ, मैं तेरे साथ बे इन्साफ़ी नहीं करता; क्या तेरा मुझ से एक दीनार नहीं ठहरा था?</char> <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/><char style="wj">जो तेरा है उठा ले और चला जा मेरी मर्ज़ी ये है कि जितना तुझे देता हूँ इस पिछले को भी उतना ही दूँ।</char> <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/><char style="wj">क्या मुझे ठीक नहीं कि अपने माल से जो चाहूँ सो करूँ? तू इसलिए कि मैं नेक हूँ बुरी नज़र से देखता है।</char> <verse eid="MAT 20:15"/><verse number="16" style="v" sid="MAT 20:16"/><char style="wj">इसी तरह आख़िर पहले हो जाएँगे और पहले आख़िर।”</char><verse eid="MAT 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>और येरूशलेम जाते हुए ईसा बारह शागिर्दों को अलग ले गया; और रास्ते में उनसे कहा। <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/><char style="wj">“देखो; हम येरूशलेम को जाते हैं; और इबने आदम सरदार काहिनों और फ़क़ीहों के हवाले किया जाएगा; और वो उसके क़त्ल का हुक्म देंगे।</char> <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/><char style="wj">और उसे ग़ैर क़ौमों के हवाले करेंगे ताकि वो उसे ठठ्ठों में उड़ाएँ, और कोड़े मारें और मस्लूब करें और वो तीसरे दिन ज़िन्दा किया जाएगा।”</char><verse eid="MAT 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>उस वक़्त ज़ब्दी की बीवी ने अपने बेटों के साथ उसके सामने आकर सिज्दा किया और उससे कुछ अर्ज़ करने लगी। <verse eid="MAT 20:20"/><verse number="21" style="v" sid="MAT 20:21"/>उसने उससे कहा, <char style="wj">“तू क्या चाहती है?”</char> उस ने उससे कहा, “फ़रमा कि ये मेरे दोनों बेटे तेरी बादशाही में तेरी दहनी और बाईं तरफ़ बैठें।” <verse eid="MAT 20:21"/><verse number="22" style="v" sid="MAT 20:22"/>ईसा ने जवाब में कहा, <char style="wj">“तुम नहीं जानते कि क्या माँगते हो? जो प्याला मैं पीने को हूँ क्या तुम पी सकते हो?”</char> उन्होंने उससे कहा, “पी सकते हैं।” <verse eid="MAT 20:22"/><verse number="23" style="v" sid="MAT 20:23"/>उसने उनसे कहा <char style="wj">“मेरा प्याला तो पियोगे, लेकिन अपने दहने बाएँ किसी को बिठाना मेरा काम नहीं; मगर जिनके लिए मेरे बाप की तरफ़ से तैयार किया गया उन्हीं के लिए है।”</char><verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>जब शागिर्दों ने ये सुना तो उन दोनों भाइयों से ख़फ़ा हुए। <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>मगर ईसा ने उन्हें पास बुलाकर कहा <char style="wj">“तुम जानते हो कि ग़ैर क़ौमों के सरदार उन पर हुक्म चलाते और अमीर उन पर इख़्तियार जताते हैं।</char> <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/><char style="wj">तुम में ऐसा न होगा; बल्कि जो तुम में बड़ा होना चाहे वो तुम्हारा ख़ादिम बने।</char> <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/><char style="wj">और जो तुम में अव्वल होना चाहे वो तुम्हारा ग़ुलाम बने।</char> <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/><char style="wj">चुनाँचे; इबने आदम इसलिए नहीं आया कि ख़िदमत ले; बल्कि इसलिए कि ख़िदमत करे और अपनी जान बहुतों के बदले फ़िदया में दें।”</char><verse eid="MAT 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>जब वो यरीहू से निकल रहे थे; एक बड़ी भीड़ उसके पीछे हो ली। <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>और देखो; दो अँधों ने जो रास्ते के किनारे बैठे थे ये सुनकर कि 'ईसा जा रहा है चिल्ला कर कहा, “ऐ ख़ुदावन्द इब्न — ए — दाऊद हम पर रहम कर।” <verse eid="MAT 20:30"/><verse number="31" style="v" sid="MAT 20:31"/>लोगों ने उन्हें डाँटा कि चुप रहें; लेकिन वो और भी चिल्ला कर कहने लगे, “ऐ ख़ुदावन्द इबने दाऊद हम पर रहम कर।” <verse eid="MAT 20:31"/><verse number="32" style="v" sid="MAT 20:32"/>ईसा ने खड़े होकर उन्हें बुलाया और कहा, <char style="wj">“तुम क्या चाहते हो कि मैं तुम्हारे लिए करूँ?”</char> <verse eid="MAT 20:32"/><verse number="33" style="v" sid="MAT 20:33"/>उन्होंने उससे कहा “ऐ ख़ुदावन्द हमारी आँखें खुल जाएँ।” <verse eid="MAT 20:33"/><verse number="34" style="v" sid="MAT 20:34"/>ईसा को तरस आया। और उसने उन की आँखों को छुआ और वो फ़ौरन देखने लगे और उसके पीछे हो लिए।<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s">येसु का शानदार इन्दराज</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>जब वो येरूशलेम के नज़दीक पहुँचे और ज़ैतून के पहाड़ पर बैतफ़िगे के पास आए; तो ईसा ने दो शागिर्दों को ये कह कर भेजा, <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/><char style="wj">“अपने सामने के गाँव में जाओ। वहाँ पहुँचते ही एक गधी बँधी हुई और उसके साथ बच्चा पाओगे। उन्हें खोल कर मेरे पास ले आओ।</char> <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/><char style="wj">और अगर कोई तुम से कुछ कहे तो कहना कि ख़ुदावन्द को इन की ज़रूरत है। वो फ़ौरन इन्हें भेज देगा।”</char> <verse eid="MAT 21:3"/><verse number="4" style="v" sid="MAT 21:4"/>ये इसलिए हुआ जो नबी की मा'रिफ़त कहा गया था वो पूरा हो:<verse eid="MAT 21:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 21:5"/>“सिय्यून की बेटी से कहो,</para>
  <para style="q" vid="MAT 21:5">देख, तेरा बादशाह तेरे पास आता है;</para>
  <para style="q" vid="MAT 21:5">वो हलीम है और गधे पर सवार है,</para>
  <para style="q" vid="MAT 21:5">बल्कि लादू के बच्चे पर।”<verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>पस शागिर्दों ने जाकर जैसा ईसा ने उनको हुक्म दिया था; वैसा ही किया। <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>गधी और बच्चे को लाकर अपने कपड़े उन पर डाले और वो उस पर बैठ गया। <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>और भीड़ में से अक्सर लोगों ने अपने कपड़े रास्ते में बिछाए; औरों ने दरख़्तों से डालियाँ काट कर राह में फैलाइं। <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>और भीड़ जो उसके आगे — आगे जाती और पीछे — पीछे चली आती थी पुकार — पुकार कर कहती थी “इबने दाऊद को हो शा'ना! मुबारिक़ है वो जो ख़ुदावन्द के नाम से आता है। आलम — ऐ बाला पर होशना।” <verse eid="MAT 21:9"/><verse number="10" style="v" sid="MAT 21:10"/>और वो जब येरूशलेम में दाख़िल हुआ तो सारे शहर में हलचल मच गई और लोग कहने लगे “ये कौन है?” <verse eid="MAT 21:10"/><verse number="11" style="v" sid="MAT 21:11"/>भीड़ के लोगों ने कहा “ये गलील के नासरत का नबी ईसा है।”<verse eid="MAT 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>और ईसा ने ख़ुदा की हैकल में दाख़िल होकर उन सब को निकाल दिया; जो हैकल में ख़रीद — ओ फ़रोख़्त कर रहे थे; और सरार्फ़ों के तख़्त और कबूतर फ़रोशों की चौकियां उलट दीं। <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>और उन से कहा, <char style="wj">“लिखा है मेरा घर दुआ का घर कहलाएगा। मगर तुम उसे डाकूओं की खो बनाते हो।”</char><verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>और अंधे और लंगड़े हैकल में उसके पास आए, और उसने उन्हें अच्छा किया। <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>लेकिन जब सरदार काहिनों और फ़क़ीहों ने उन अजीब कामों को जो उसने किए; और लड़कों को हैकल में इबने दाऊद को हो शा'ना पुकारते देखा तो ख़फ़ा होकर उससे कहने लगे, <verse eid="MAT 21:15"/><verse number="16" style="v" sid="MAT 21:16"/>“तू सुनता है कि ये क्या कहते हैं?” ईसा ने उन से कहा, <char style="wj">“हाँ; क्या तुम ने ये कभी नहीं पढ़ा: ‘बच्चों और शीरख़्वारों के मुँह से तुम ने हम्द को कामिल कराया?’”</char> <verse eid="MAT 21:16"/><verse number="17" style="v" sid="MAT 21:17"/>और वो उन्हें छोड़ कर शहर से बाहर बैत अन्नियाह में गया; और रात को वहीं रहा।<verse eid="MAT 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>और जब सुबह को फिर शहर को जा रहा था; तो उसे भूख लगी। <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>और रास्ते के किनारे अंजीर का एक दरख़्त देख कर उसके पास गया; और पत्तों के सिवा उस में कुछ न पाकर उससे कहा; <char style="wj">“आइन्दा कभी तुझ में फल न लगे!”</char> और अंजीर का दरख़्त उसी दम सूख गया। <verse eid="MAT 21:19"/><verse number="20" style="v" sid="MAT 21:20"/>शागिर्दों ने ये देख कर ताअ'ज्जुब किया और कहा “ये अंजीर का दरख़्त क्यूँकर एक दम में सूख गया?” <verse eid="MAT 21:20"/><verse number="21" style="v" sid="MAT 21:21"/>ईसा ने जवाब में उनसे कहा, तुम से सच कहता हूँ <char style="wj">“कि अगर ईमान रखो और शक न करो तो न सिर्फ़ वही करोगे जो अंजीर के दरख़्त के साथ हुआ; बल्कि अगर इस पहाड़ से कहो उखड़ जा और समुन्दर में जा पड़ तो यूँ ही हो जाएगा।</char> <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/><char style="wj">और जो कुछ दुआ में ईमान के साथ माँगोगे वो सब तुम को मिलेगा”</char><verse eid="MAT 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>जब वो हैकल में आकर ता'लीम दे रहा था; तो सरदार काहिनों और क़ौम के बुज़ुर्गों ने उसके पास आकर कहा, “तू इन कामों को किस इख़्तियार से करता है? और ये इख़्तियार तुझे किसने दिया है।” <verse eid="MAT 21:23"/><verse number="24" style="v" sid="MAT 21:24"/>ईसा ने जवाब में उनसे कहा, <char style="wj">“मैं भी तुम से एक बात पूछता हूँ; अगर वो मुझे बताओगे तो मैं भी तुम को बताऊँगा कि इन कामों को किस इख़्तियार से करता हूँ।</char> <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/><char style="wj">यूहन्ना का बपतिस्मा कहाँ से था? आसमान की तरफ़ से या इंसान की तरफ़ से?”</char> वो आपस में कहने लगे, “अगर हम कहें, आसमान की तरफ़ से, तो वो हम को कहेगा, ‘फिर तुम ने क्यूँ उसका यक़ीन न किया?’ <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>और अगर कहें इंसान की तरफ़ से तो हम अवाम से डरते हैं? क्यूँकि सब यूहन्ना को नबी जानते थे?” <verse eid="MAT 21:26"/><verse number="27" style="v" sid="MAT 21:27"/>पस उन्होंने जवाब में ईसा से कहा, “हम नहीं जानते।” उसने भी उनसे कहा, <char style="wj">“मैं भी तुम को नहीं बताता कि मैं इन कामों को किस इख़्तियार से करता हूँ।”</char><verse eid="MAT 21:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>
    <char style="wj">“तुम क्या समझते हो? एक आदमी के दो बेटे थे उसने पहले के पास जाकर कहा, ‘बेटा जा!, और बाग़ में जाकर काम कर।’</char> <verse eid="MAT 21:28"/><verse number="29" style="v" sid="MAT 21:29"/><char style="wj">उसने जवाब में कहा, 'मैं नहीं जाऊँगा,' मगर पीछे पछता कर गया।</char> <verse eid="MAT 21:29"/><verse number="30" style="v" sid="MAT 21:30"/><char style="wj">फिर दूसरे के पास जाकर उसने उसी तरह कहा, उसने जवाब दिया, 'अच्छा जनाब, मगर गया नहीं।</char> <verse eid="MAT 21:30"/><verse number="31" style="v" sid="MAT 21:31"/><char style="wj">इन दोनों में से कौन अपने बाप की मर्ज़ी बजा लाया?”</char> उन्होंने कहा, “पहला।” ईसा ने उन से कहा, <char style="wj">“मैं तुम से सच कहता हूँ कि महसूल लेने वाले और कस्बियाँ तुम से पहले ख़ुदा की बादशाही में दाख़िल होती हैं।</char> <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/><char style="wj">क्यूँकि यूहन्ना रास्तबाज़ी के तरीक़े पर तुम्हारे पास आया; और तुम ने उसका यक़ीन न किया; मगर महसूल लेने वाले और कस्बियों ने उसका यक़ीन किया; और तुम ये देख कर भी न पछताए; कि उसका यक़ीन कर लेते।”</char><verse eid="MAT 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>
    <char style="wj">“एक और मिसाल सुनो: एक घर का मालिक था; जिसने बाग़ लगाया और उसकी चारों तरफ़ अहाता और उस में हौज़ खोदा और बुर्ज बनाया और उसे बाग़बानों को ठेके पर देकर परदेस चला गया।</char> <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/><char style="wj">जब फल का मौसम क़रीब आया तो उसने अपने नौकरों को बाग़बानों के पास अपना फल लेने को भेजा।</char> <verse eid="MAT 21:34"/><verse number="35" style="v" sid="MAT 21:35"/><char style="wj">बाग़बानों ने उसके नौकरों को पकड़ कर किसी को पीटा किसी को क़त्ल किया और किसी को पथराव किया।</char> <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/><char style="wj">फिर उसने और नौकरों को भेजा, जो पहलों से ज़्यादा थे; उन्होंने उनके साथ भी वही सुलूक किया।</char> <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/><char style="wj">आख़िर उसने अपने बेटे को उनके पास ये कह कर भेजा कि ‘वो मेरे बेटे का तो लिहाज़ करेंगे।’</char> <verse eid="MAT 21:37"/><verse number="38" style="v" sid="MAT 21:38"/><char style="wj">जब बाग़बानों ने बेटे को देखा, तो आपस में कहा, ‘ये ही वारिस है! आओ इसे क़त्ल करके इसी की जायदाद पर क़ब्ज़ा कर लें।’</char> <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/><char style="wj">और उसे पकड़ कर बाग़ से बाहर निकाला और क़त्ल कर दिया।”</char><verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>
    <char style="wj">“पस जब बाग़ का मालिक आएगा, तो उन बाग़बानों के साथ क्या करेगा?”</char> <verse eid="MAT 21:40"/><verse number="41" style="v" sid="MAT 21:41"/>उन्होंने उससे कहा, “उन बदकारों को बूरी तरह हलाक करेगा; और बाग़ का ठेका दूसरे बाग़बानों को देगा, जो मौसम पर उसको फल दें।” <verse eid="MAT 21:41"/><verse number="42" style="v" sid="MAT 21:42"/>ईसा ने उन से कहा, <char style="wj" closed="false">“क्या तुम ने किताबे मुक़द्दस में कभी नहीं पढ़ा: ‘जिस पत्थर को में'मारों ने रद्द किया, वही कोने के सिरे का पत्थर हो गया; ये ख़ुदावन्द की तरफ़ से हुआ और हमारी नज़र में अजीब है’?”</char><verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>
    <char style="wj">“इसलिए मैं तुम से कहता हूँ कि ख़ुदा की बादशाही तुम से ले ली जाएगी और उस क़ौम को जो उसके फल लाए, दे दी जाए गी।</char> <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/><char style="wj">और जो इस पत्थर पर गिरेगा; टुकड़े — टुकड़े हो जाएगा; लेकिन जिस पर वो गिरेगा उसे पीस डालेगा।”</char> <verse eid="MAT 21:44"/><verse number="45" style="v" sid="MAT 21:45"/>जब सरदार काहिनों और फ़रीसियों ने उसकी मिसाल सुनी, तो समझ गए, कि हमारे हक़ में कहता है। <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>और वो उसे पकड़ने की कोशिश में थे, लेकिन लोगों से डरते थे; क्यूँकि वो उसे नबी जानते थे।<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s">एक बड़े जश्‍न की तमसील</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>और ईसा फिर उनसे मिसालों में कहने लगा, <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/><char style="wj">“आस्मान की बादशाही उस बादशाह की तरह है जिस ने अपने बेटे की शादी की।</char> <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/><char style="wj">और अपने नौकरों को भेजा कि बुलाए हुओं को शादी में बुला लाएँ, मगर उन्होंने आना न चाहा।</char> <verse eid="MAT 22:3"/><verse number="4" style="v" sid="MAT 22:4"/><char style="wj">फिर उस ने और नौकरों को ये कह कर भेजा, ‘बुलाए हुओं से कहो: देखो, मैंने ज़ियाफ़त तैयार कर ली है, मेरे बैल और मोटे मोटे जानवर ज़बह हो चुके हैं और सब कुछ तैयार है; शादी में आओ।’</char> <verse eid="MAT 22:4"/><verse number="5" style="v" sid="MAT 22:5"/><char style="wj">मगर वो बे परवाई करके चल दिए; कोई अपने खेत को, कोई अपनी सौदागरी को।</char> <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/><char style="wj">और बाक़ियों ने उसके नौकरों को पकड़ कर बे'इज़्ज़त किया और मार डाला।</char> <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/><char style="wj">बादशाह ग़ज़बनाक हुआ और उसने अपना लश्कर भेजकर उन ख़ूनियों को हलाक कर दिया, और उन का शहर जला दिया।</char> <verse eid="MAT 22:7"/><verse number="8" style="v" sid="MAT 22:8"/><char style="wj">तब उस ने अपने नौकरों से कहा, शादी का खाना तो तैयार है ‘मगर बुलाए हुए लायक़ न थे।</char> <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/><char style="wj">पस रास्तों के नाकों पर जाओ, और जितने तुम्हें मिलें शादी में बुला लाओ।’</char> <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/><char style="wj">और वो नौकर बाहर रास्तों पर जा कर, जो उन्हें मिले क्या बूरे क्या भले सब को जमा कर लाए और शादी की महफ़िल मेहमानों से भर गई।”</char><verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>
    <char style="wj">“जब बादशाह मेहमानों को देखने को अन्दर आया, तो उसने वहाँ एक आदमी को देखा, जो शादी के लिबास में न था।</char> <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/><char style="wj">उसने उससे कहा‘ मियाँ तू शादी की पोशाक पहने बग़ैर यहाँ क्यूँ कर आ गया?’ लेकिन उस का मुँह बन्द हो गया।</char> <verse eid="MAT 22:12"/><verse number="13" style="v" sid="MAT 22:13"/><char style="wj">इस पर बादशाह ने ख़ादिमों से कहा ‘उस के हाथ पाँव बाँध कर बाहर अंधेरे में डाल दो, वहाँ रोना और दाँत पीसना होगा।’</char> <verse eid="MAT 22:13"/><verse number="14" style="v" sid="MAT 22:14"/><char style="wj">क्यूँकि बुलाए हुए बहुत हैं, मगर चुने हुए थोड़े।”</char><verse eid="MAT 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>उस वक़्त फ़रीसियों ने जा कर मशवरा किया कि उसे क्यूँ कर बातों में फँसाएँ। <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>पस उन्होंने अपने शागिर्दों को हेरोदियों के साथ उस के पास भेजा, और उन्होंने कहा “ऐ उस्ताद हम जानते हैं कि तू सच्चा है और सच्चाई से ख़ुदा की राह की तालीम देता है। और किसी की परवाह नहीं करता क्यूँकि तू किसी आदमी का तरफ़दार नहीं। <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>पस हमें बता तू क्या समझता है? क़ैसर को जिज़िया देना जायज़ है या नहीं?” <verse eid="MAT 22:17"/><verse number="18" style="v" sid="MAT 22:18"/>ईसा ने उन की शरारत जान कर कहा, <char style="wj">“ऐ रियाकारो, मुझे क्यूँ आज़माते हो?</char> <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/><char style="wj">जिज़िए का सिक्का मुझे दिखाओ वो एक दीनार उस के पास लाए।”</char> <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>उसने उनसे कहा <char style="wj">“ये सूरत और नाम किसका है?”</char> <verse eid="MAT 22:20"/><verse number="21" style="v" sid="MAT 22:21"/>उन्होंने उससे कहा, “क़ैसर का।” उस ने उनसे कहा, <char style="wj">“पस जो क़ैसर का है क़ैसर को और जो ख़ुदा का है ख़ुदा को अदा करो।”</char> <verse eid="MAT 22:21"/><verse number="22" style="v" sid="MAT 22:22"/>उन्होंने ये सुनकर ता'अज्जुब किया, और उसे छोड़ कर चले गए।<verse eid="MAT 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>उसी दिन सदूक़ी जो कहते हैं कि क़यामत नहीं होगी उसके पास आए, और उससे ये सवाल किया। <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>“ऐ उस्ताद, मूसा ने कहा था, कि अगर कोई बे औलाद मर जाए, तो उसका भाई उसकी बीवी से शादी कर ले, और अपने भाई के लिए नस्ल पैदा करे। <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>अब हमारे दर्मियान सात भाई थे, और पहला शादी करके मर गया; और इस वजह से कि उसके औलाद न थी, अपनी बीवी अपने भाई के लिए छोड़ गया। <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>इसी तरह दूसरा और तीसरा भी सातवें तक। <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>सब के बाद वो 'औरत भी मर गई। <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>पस वो क़यामत में उन सातों में से किसकी बीवी होगी? क्यूँकि सब ने उससे शादी की थी।” <verse eid="MAT 22:28"/><verse number="29" style="v" sid="MAT 22:29"/>ईसा' ने जवाब में उनसे कहा, <char style="wj">“तुम गुमराह हो; इसलिए कि न किताबे मुक़द्दस को जानते हो न ख़ुदा की क़ुदरत को।</char> <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/><char style="wj">क्यूँकि क़यामत में शादी बारात न होगी; बल्कि लोग आसमान पर फ़रिश्तों की तरह होंगे।</char> <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/><char style="wj">मगर मुर्दों के जी उठने के बारे में ख़ुदा ने तुम्हें फ़रमाया था, क्या तुम ने वो नहीं पढ़ा?</char> <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/><char style="wj">मैं इब्राहीम का ख़ुदा, और इज़्हाक़ का ख़ुदा और याक़ूब का ख़ुदा हूँ? वो तो मुर्दों का ख़ुदा नहीं बल्कि ज़िन्दों का ख़ुदा है।”</char> <verse eid="MAT 22:32"/><verse number="33" style="v" sid="MAT 22:33"/>लोग ये सुन कर उसकी ता'लीम से हैरान हुए।<verse eid="MAT 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>जब फ़रीसियों ने सुना कि उसने सदूक़ियों का मुँह बन्द कर दिया, तो वो जमा हो गए। <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>और उन में से एक आलिम — ऐ शरा ने आज़माने के लिए उससे पूछा; <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>“ऐ उस्ताद, तौरेत में कौन सा हुक्म बड़ा है?” <verse eid="MAT 22:36"/><verse number="37" style="v" sid="MAT 22:37"/>उसने उस से कहा <char style="wj">“ख़ुदावन्द अपने ख़ुदा से अपने सारे दिल, और अपनी सारी जान और अपनी सारी अक़्ल से मुहब्बत रख।</char> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/><char style="wj">बड़ा और पहला हुक्म यही है।</char> <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/><char style="wj">और दूसरा इसकी तरह ये है कि ‘अपने पड़ोसी से अपने बराबर मुहब्बत रख।’</char> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/><char style="wj">इन्ही दो हुक्मों पर तमाम तौरेत और अम्बिया के सहीफ़ों का मदार है।”</char><verse eid="MAT 22:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>जब फ़रीसी जमा हुए तो ईसा ने उनसे ये पूछा; <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/><char style="wj">“तुम मसीह के हक़ में क्या समझते हो? वो किसका बेटा है”</char> उन्होंने उससे कहा “दाऊद का।” <verse eid="MAT 22:42"/><verse number="43" style="v" sid="MAT 22:43"/>उसने उनसे कहा, <char style="wj">“पस दाऊद रूह की हिदायत से क्यूँकर उसे ख़ुदावन्द कहता है,</char> <verse eid="MAT 22:43"/><verse number="44" style="v" sid="MAT 22:44"/><char style="wj">‘ख़ुदावन्द ने मेरे ख़ुदावन्द से कहा, मेरी दहनी तरफ़ बैठ, जब तक में तेरे दुश्मनों को तेरे पाँव के नीचे न कर दूँ’।</char> <verse eid="MAT 22:44"/><verse number="45" style="v" sid="MAT 22:45"/><char style="wj">पस जब दाऊद उसको ख़ुदावन्द कहता है तो वो उसका बेटा क्यूँकर ठहरा?”</char> <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>कोई उसके जवाब में एक हर्फ़ न कह सका, और न उस दिन से फिर किसी ने उससे सवाल करने की जुरअत की।<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s">येसु का मज़हवी रहनुमाओं पर तंज</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>उस वक़्त ईसा ने भीड़ से और अपने शागिर्दों से ये बातें कहीं, <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/><char style="wj">“फ़क़ीह और फ़रीसी</char> <note caller="+" style="f"><char style="fr" closed="false">23:2 </char><char style="fq" closed="false">फ़क़ीह और फ़रीसी </char><char style="ft" closed="false">फ़रीसी एक मज़हबी अगुवे थे और फ़क़ीह एक सियासी जमाअत थी </char></note> <char style="wj">मूसा के शरी'अत की गधी पर बैठे हैं।</char> <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/><char style="wj">पस जो कुछ वो तुम्हें बताएँ वो सब करो और मानो, लेकिन उनकी तरह काम न करो; क्यूँकि वो कहते हैं, और करते नहीं।</char> <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/><char style="wj">वो ऐसे भारी बोझ जिनको उठाना मुश्किल है, बाँध कर लोगों के कँधों पर रखते हैं, मगर ख़ुद उनको अपनी उंगली से भी हिलाना नहीं चाहते।</char> <verse eid="MAT 23:4"/><verse number="5" style="v" sid="MAT 23:5"/><char style="wj">वो अपने सब काम लोगों को दिखाने को करते हैं; क्यूँकि वो अपने ता'वीज़ बड़े बनाते और अपनी पोशाक के किनारे चौड़े रखते हैं।</char> <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/><char style="wj">ज़ियाफ़तों में सद्र नशीनी और इबादतख़ानों में आ'ला दर्जे की कुर्सियाँ।</char> <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/><char style="wj">और बाज़ारों में सलाम और आदमियों से रब्बी कहलाना पसन्द करते हैं।</char> <verse eid="MAT 23:7"/><verse number="8" style="v" sid="MAT 23:8"/><char style="wj">मगर तुम रब्बी न कहलाओ, क्यूँकि तुम्हारा उसताद एक ही है और तुम सब भाई हो</char> <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/><char style="wj">और ज़मीन पर किसी को अपना बाप न कहो, क्यूँकि तुम्हारा ‘बाप’ एक ही है जो आसमानी है।</char> <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/><char style="wj">और न तुम हादी कहलाओ, क्यूँकि तुम्हारा हादी एक ही है, या'नी मसीह।</char> <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/><char style="wj">लेकिन जो तुम में बड़ा है, वो तुम्हारा ख़ादिम बने।</char> <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/><char style="wj">जो कोई अपने आप को बड़ा बनाएगा, वो छोटा किया जाएगा; और जो अपने आप को छोटा बनाएगा, वो बड़ा किया जाएगा।”</char><verse eid="MAT 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>
    <char style="wj">“ऐ रियाकार; आलिमों और फ़रीसियो तुम पर अफ़सोस कि आसमान की बादशाही लोगों पर बन्द करते हो, क्यूँकि न तो आप दाख़िल होते हो, और न दाख़िल होने वालों को दाख़िल होने देते हो।</char> <verse eid="MAT 23:13"/><verse number="14" style="v" sid="MAT 23:14"/><char style="wj">ऐ रियाकार; आलिमों और फ़रीसियो तुम पर अफ़सोस, कि तुम बेवाओं के घरों को दबा बैठते हो, और दिखावे के लिए ईबादत को तुल देते हो; तुम्हें ज़्यादा सज़ा होगी।”</char><verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>
    <char style="wj">“ऐ रियाकार; फ़क़ीहो और फ़रीसियो तुम पर अफ़सोस, कि एक मुरीद करने के लिए तरी और ख़ुश्की का दौरा करते हो, और जब वो मुरीद हो चुकता है तो उसे अपने से दूगना जहन्नुम का फ़र्ज़न्द बना देते हो।”</char><verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>
    <char style="wj">“ऐ अंधे राह बताने वालो, तुम पर अफ़्सोस! जो कहते हो, अगर कोई मक़दिस की क़सम खाए तो कुछ बात नहीं; लेकिन अगर मक़दिस के सोने की क़सम खाए तो उसका पाबन्द होगा।</char> <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/><char style="wj">ऐ अहमक़ों! और अँधों सोना बड़ा है, या मक़्दिस जिसने सोने को मुक़द्दस किया।</char> <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/><char style="wj">फिर कहते हो ‘अगर कोई क़ुर्बानगाह की क़सम खाए तो कुछ बात नहीं; लेकिन जो नज़्र उस पर चढ़ी हो अगर उसकी क़सम खाए तो उसका पाबन्द होगा।’</char> <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/><char style="wj">ऐ अंधो! नज़्र बड़ी है या क़ुर्बानगाह जो नज़्र को मुक़द्दस करती है?</char> <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/><char style="wj">पस, जो क़ुर्बानगाह की क़सम खाता है, वो उसकी और उन सब चीज़ों की जो उस पर हैं क़सम खाता है।</char> <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/><char style="wj">और जो मक़दिस की क़सम खाता है वो उसकी और उसके रहनेवाले की क़सम खाता है।</char> <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/><char style="wj">और जो आस्मान की क़सम खाता है वह ख़ुदा के तख़्त की और उस पर बैठने वाले की क़सम भी खाता है।”</char><verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>
    <char style="wj">“ऐ रियाकार; आलिमों और फ़रीसियो तुम पर अफ़सोस कि पुदीना सौंफ़ और ज़ीरे पर तो दसवाँ हिस्सा देते हो, पर तुम ने शरी'अत की ज़्यादा भारी बातों या'नी इन्साफ़, और रहम, और ईमान को छोड़ दिया है; लाज़िम था ये भी करते और वो भी न छोड़ते।”</char><verse eid="MAT 23:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 23:24"/>
    <char style="wj">“ऐ अंधे राह बताने वालो; जो मच्छर को तो छानते हो, और ऊँट को निगल जाते हो।</char> <verse eid="MAT 23:24"/><verse number="25" style="v" sid="MAT 23:25"/><char style="wj">ऐ रियाकार; आलिमों और फ़रीसियो तुम पर अफ़सोस कि प्याले और रक़ाबी को ऊपर से साफ़ करते हो, मगर वो अन्दर लूट और ना'परहेज़गारी से भरे हैं।</char> <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/><char style="wj">ऐ अंधे फ़रीसी; पहले प्याले और रक़ाबी को अन्दर से साफ़ कर ताकि ऊपर से भी साफ़ हो जाए।”</char><verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>
    <char style="wj">“ऐ रियाकार; आलिमों और फ़रीसियो तुम पर अफ़सोस कि तुम सफ़ेदी फिरी हुई क़ब्रों की तरह हो, जो ऊपर से तो ख़ूबसूरत दिखाई देती हैं, मगर अन्दर मुर्दों की हड्डियों और हर तरह की नापाकी से भरी हैं।</char> <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/><char style="wj">इसी तरह तुम भी ज़ाहिर में तो लोगों को रास्तबाज़ दिखाई देते हो, मगर बातिन में रियाकारी और बेदीनी से भरे हो।”</char><verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>
    <char style="wj">“ऐ रियाकार; आलिमों और फ़रीसियो तुम पर अफ़सोस, कि नबियों की क़ब्रें बनाते और रास्तबाज़ों के मक़बरे आरास्ता करते हो।</char> <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/><char style="wj">और कहते हो, ‘अगर हम अपने बाप दादा के ज़माने में होते तो नबियों के ख़ून में उनके शरीक न होते।’</char> <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/><char style="wj">इस तरह तुम अपनी निस्बत गवाही देते हो, कि तुम नबियों के क़ातिलों के फ़र्ज़न्द हो।</char> <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/><char style="wj">ग़रज़ अपने बाप दादा का पैमाना भर दो।</char> <verse eid="MAT 23:32"/><verse number="33" style="v" sid="MAT 23:33"/><char style="wj">ऐ साँपों, ऐ अफ़'ई के बच्चो; तुम जहन्नुम की सज़ा से क्यूँकर बचोगे?</char> <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/><char style="wj">इसलिए देखो मैं नबियों, और दानाओं और आलिमों को तुम्हारे पास भेजता हूँ, उन में से तुम कुछ को क़त्ल और मस्लूब करोगे, और कुछ को अपने इबादतख़ानों में कोड़े मारोगे, और शहर ब शहर सताते फिरोगे।</char> <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/><char style="wj">ताकि सब रास्तबाज़ों का ख़ून जो ज़मीन पर बहाया गया तुम पर आए, रास्तबाज़ हाबिल के ख़ून से लेकर बरकियाह के बेटे ज़करियाह के ख़ून तक जिसे तुम ने मक़दिस और क़ुर्बानगाह के दर्मियान क़त्ल किया।</char> <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/><char style="wj">मैं तुम से सच कहता हूँ कि ये सब कुछ इसी ज़माने के लोगों पर आएगा।”</char><verse eid="MAT 23:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>
    <char style="wj">“ऐ यरूशलीम ऐ यरूशलीम तू जो नबियों को क़त्ल करता और जो तेरे पास भेजे गए, उनको संगसार करता है, कितनी बार मैंने चाहा कि जिस तरह मुर्ग़ी अपने बच्चों को परों तले जमा कर लेती है, इसी तरह मैं भी तेरे लड़कों को जमा कर लूँ; मगर तुम ने न चाहा।</char> <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/><char style="wj">देखो; तुम्हारा घर तुम्हारे लिए वीरान छोड़ा जाता है।</char> <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/><char style="wj">क्यूँकि मैं तुम से कहता हूँ, कि अब से मुझे फिर हरगिज़ न देखोगे; जब तक न कहोगे कि मुबारिक़ है वो जो दावन्द के नाम से आता है।”</char><verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s">येसु का आने वाले कल के बारे में बताना</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>और ईसा हैकल से निकल कर जा रहा था, कि उसके शागिर्द उसके पास आए, ताकि उसे हैकल की इमारतें दिखाएँ। <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>उसने जवाब में उनसे कहा, <char style="wj">“क्या तुम इन सब चीज़ों को नहीं देखते? मैं तुम से सच कहता हूँ, कि यहाँ किसी पत्थर पर पत्थर बाक़ी न रहेगा; जो गिराया न जाएगा।”</char><verse eid="MAT 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>जब वो ज़ैतून के पहाड़ पर बैठा था, उसके शागिर्दों ने अलग उसके पास आकर कहा, “हम को बता ये बातें कब होंगी? और तेरे आने और दुनिया के आख़िर होने का निशान क्या होगा?” <verse eid="MAT 24:3"/><verse number="4" style="v" sid="MAT 24:4"/>ईसा' ने जवाब में उनसे कहा, <char style="wj">“ख़बरदार! कोई तुम को गुमराह न कर दे,</char> <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/><char style="wj">क्यूँकि बहुत से मेरे नाम से आएँगे और कहेंगे, ‘मैं मसीह हूँ।’ और बहुत से लोगों को गुमराह करेंगे।</char> <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/><char style="wj">और तुम लड़ाइयाँ और लड़ाइयों की अफ़वाह सुनोगे, ख़बरदार, घबरा न जाना, क्यूँकि इन बातों का वाक़े होना ज़रूर है।</char> <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/><char style="wj">क्यूँकि क़ौम पर क़ौम और सल्तनत पर सल्तनत चढ़ाई करेगी, और जगह — जगह काल पड़ेंगे, और भुन्चाल आएँगे।</char> <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/><char style="wj">लेकिन ये सब बातें मुसीबतों का शुरू ही होंगी।</char> <verse eid="MAT 24:8"/><verse number="9" style="v" sid="MAT 24:9"/><char style="wj">उस वक़्त लोग तुम को तकलीफ़ देने के लिए पकड़वाएँगे, और तुम को क़त्ल करेंगे; और मेरे नाम की ख़ातिर सब क़ौमें तुम से दुश्मनी रख्खेंगी।</char> <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/><char style="wj">और उस वक़्त बहुत से ठोकर खाएँगे, और एक दूसरे को पकड़वाएँगे; और एक दूसरे से दुश्मनी रख्खेंगे।</char> <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/><char style="wj">और बहुत से झूठे नबी उठ खड़े होंगे, और बहुतों को गुमराह करेंगे।</char> <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/><char style="wj">और बेदीनी के बढ़ जाने से बहुतेरों की मुहब्बत ठन्डी पड़ जाएगी।</char> <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/><char style="wj">लेकिन जो आख़िर तक बर्दाश्त करेगा वो नजात पाएगा।</char> <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/><char style="wj">और बादशाही की इस ख़ुशख़बरी का एलान तमाम दुनिया में होगा, ताकि सब क़ौमों के लिए गवाही हो, तब ख़ातिमा होगा।”</char><verse eid="MAT 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>
    <char style="wj">“पस जब तुम उस उजाड़ने वाली मकरूह चीज़ जिसका ज़िक्र दानीएल नबी की ज़रिए हुआ, मुक़द्दस मुक़ामों में खड़ा हुआ देखो (पढ़ने वाले समझ लें)</char> <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/><char style="wj">तो जो यहूदिया में हों वो पहाड़ों पर भाग जाएँ।</char> <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/><char style="wj">जो छत पर हो वो अपने घर का माल लेने को नीचे न उतरे।</char> <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/><char style="wj">और जो खेत में हो वो अपना कपड़ा लेने को पीछे न लौटे।”</char><verse eid="MAT 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 24:19"/>
    <char style="wj">“मगर अफ़सोस उन पर जो उन दिनों में हामिला हों और जो दूध पिलाती हों।</char> <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/><char style="wj">पस, दुआ करो कि तुम को जाड़ों में या सबत के दिन भागना न पड़े।</char> <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/><char style="wj">क्यूँकि उस वक़्त ऐसी बड़ी मुसीबत होगी कि दुनिया के शुरू से न अब तक हुई न कभी होगी।</char> <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/><char style="wj">अगर वो दिन घटाए न जाते तो कोई बशर न बचता मगर चुने हुवों की ख़ातिर वो दिन घटाए जाएँगे।</char> <verse eid="MAT 24:22"/><verse number="23" style="v" sid="MAT 24:23"/><char style="wj">उस वक़्त अगर कोई तुम को कहे, देखो, मसीह ‘यहाँ है’ या ‘वह वहाँ है’ तो यक़ीन न करना।”</char><verse eid="MAT 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 24:24"/>
    <char style="wj">“क्यूँकि झूठे मसीह और झूठे नबी उठ खड़े होंगे और ऐसे बड़े निशान और अजीब काम दिखाएँगे कि अगर मुम्किन हो तो बरगुज़ीदों को भी गुमराह कर लें।</char> <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/><char style="wj">देखो, मैं ने पहले ही तुम को कह दिया है।</char> <verse eid="MAT 24:25"/><verse number="26" style="v" sid="MAT 24:26"/><char style="wj">पस अगर वो तुम से कहें, देखो, वो वीरानों में है तो बाहर न जाना। या देखो, कोठरियों में है तो यक़ीन न करना।”</char><verse eid="MAT 24:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 24:27"/>
    <char style="wj">“क्यूँकि जैसे बिजली पूरब से कौंध कर पच्छिम तक दिखाई देती है वैसे ही इबने आदम का आना होगा।</char> <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/><char style="wj">जहाँ मुर्दार है, वहाँ गिद्ध जमा हो जाएँगे।”</char><verse eid="MAT 24:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>
    <char style="wj">“फ़ौरन इन दिनों की मुसीबत के बाद सूरज तारीक हो जाएगा। और चाँद अपनी रौशनी न देगा, और सितारे आसमान से गिरेंगे और आस्मान की क़ुव्वतें हिलाई जाएँगी।</char> <verse eid="MAT 24:29"/><verse number="30" style="v" sid="MAT 24:30"/><char style="wj">और उस वक़्त इब्न — ए — आदम का निशान आस्मान पर दिखाई देगा। और उस वक़्त ज़मीन की सब क़ौमें छाती पीटेंगी; और इबने आदम को बड़ी क़ुदरत और जलाल के साथ आसमान के बादलों पर आते देखेंगी।</char> <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/><char style="wj">और वो नरसिंगे की बड़ी आवाज़ के साथ अपने फ़रिश्तों को भेजेगा और वो उसके चुने हुवों को चारों तरफ़ से आसमान के इस किनारे से उस किनारे तक जमा करेंगे।”</char><verse eid="MAT 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>
    <char style="wj">“अब अंजीर के दरख़्त से एक मिसाल सीखो, जैसे ही उसकी डाली नर्म होती और पत्ते निकलते हैं तुम जान लेते हो कि गर्मी नज़दीक है।</char> <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/><char style="wj">इसी तरह जब तुम इन सब बातों को देखो, तो जान लो कि वो नज़दीक बल्कि दरवाज़े पर है।</char> <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/><char style="wj">मैं तुम से सच कहता हूँ कि जब तक ये सब बातें न हो लें ये नस्ल हरगिज़ तमाम न होगी।</char> <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/><char style="wj">आसमान और ज़मीन टल जाएँगी लेकिन मेरी बातें हरगिज़ न टलेंगी।”</char><verse eid="MAT 24:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>
    <char style="wj">“लेकिन उस दिन और उस वक़्त के बारे में कोई नहीं जानता, न आसमान के फ़रिश्ते न बेटा मगर, सिर्फ़ बाप।</char> <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/><char style="wj">जैसा नूह के दिनों में हुआ वैसा ही इबने आदम के आने के वक़्त होगा।</char> <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/><char style="wj">क्यूँकि जिस तरह तूफ़ान से पहले के दिनों में लोग खाते पीते और ब्याह शादी करते थे, उस दिन तक कि नूह नाव में दाख़िल हुआ।</char> <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/><char style="wj">और जब तक तूफ़ान आकर उन सब को बहा न ले गया, उन को ख़बर न हुई, उसी तरह इबने आदम का आना होगा।</char> <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/><char style="wj">उस वक़्त दो आदमी खेत में होंगे, एक ले लिया जाएगा, और दूसरा छोड़ दिया जाएगा,</char> <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/><char style="wj">दो औरतें चक्की पीसती होंगी, एक ले ली जाएगी और दूसरी छोड़ दी जाएगी।</char> <verse eid="MAT 24:41"/><verse number="42" style="v" sid="MAT 24:42"/><char style="wj">पस जागते रहो, क्यूँकि तुम नहीं जानते कि तुम्हारा ख़ुदावन्द किस दिन आएगा</char> <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/><char style="wj">लेकिन ये जान रख्खो, कि अगर घर के मालिक को मा'लूम होता कि चोर रात के कौन से पहर आएगा, तो जागता रहता और अपने घर में नक़ब न लगाने देता।</char> <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/><char style="wj">इसलिए तुम भी तैयार रहो, क्यूँकि जिस घड़ी तुम को गुमान भी न होगा इबने आदम आ जाएगा।”</char><verse eid="MAT 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>
    <char style="wj">“पस वो ईमानदार और अक़्लमन्द नौकर कौन सा है, जिसे मालिक ने अपने नौकर चाकरों पर मुक़र्रर किया ताकि वक़्त पर उनको खाना दे।</char> <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/><char style="wj">मुबारिक़ है वो नौकर जिसे उस का मालिक आकर ऐसा ही करते पाए।</char> <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/><char style="wj">मैं तुम से सच कहता हूँ, कि वो उसे अपने सारे माल का मुख़्तार कर देगा।</char> <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/><char style="wj">लेकिन अगर वो ख़राब नौकर अपने दिल में ये कह कर कि मेरे मालिक के आने में देर है।</char> <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/><char style="wj">अपने हमख़िदमतों को मारना शुरू करे, और शराबियों के साथ खाए पिए।</char> <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/><char style="wj">तो उस नौकर का मालिक ऐसे दिन कि वो उसकी राह न देखता हो और ऐसी घड़ी कि वो न जानता हो आ मौजूद होगा।</char> <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/><char style="wj">और ख़ूब कोड़े लगा कर उसको रियाकारों में शामिल करेगा वहाँ रोना और दाँत पीसना होगा।”</char><verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s">दस कुँवारियों की तमसील</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>
    <char style="wj">“उस वक़्त आसमान की बादशाही उन दस कुँवारियों की तरह होगी जो अपनी मशा'लें लेकर दुल्हा के इस्तक़बाल को निकलीं।</char> <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/><char style="wj">उन में पाँच बेवक़ूफ़ और पाँच अक़्लमन्द थीं।</char> <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/><char style="wj">जो बेवक़ूफ़ थीं उन्होंने अपनी मशा'लें तो ले लीं मगर तेल अपने साथ न लिया।</char> <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/><char style="wj">मगर अक़्लमन्दों ने अपनी मशा'लों के साथ अपनी कुप्पियों में तेल भी ले लिया।</char> <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/><char style="wj">और जब दुल्हा ने देर लगाई तो सब ऊँघने लगीं और सो गई।”</char><verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>
    <char style="wj">“आधी रात को धूम मची, देखो! दुल्हा आ गया, उसके इस्तक़बाल को निकलो!</char> <verse eid="MAT 25:6"/><verse number="7" style="v" sid="MAT 25:7"/><char style="wj">उस वक़्त वो सब कुँवारियाँ उठकर अपनी — अपनी मशा'लों को दुरुस्त करने लगीं।</char> <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/><char style="wj">और बेवक़ूफ़ों ने अक़्लमन्दों से कहा, ‘अपने तेल में से कुछ हम को भी दे दो, क्यूँकि हमारी मशा'लें बुझी जाती हैं।’</char> <verse eid="MAT 25:8"/><verse number="9" style="v" sid="MAT 25:9"/><char style="wj">'अक़्लमन्दों ने जवाब दिया, शायद हमारे तुम्हारे दोनों के लिए काफ़ी न हो बेहतर; ये है कि बेचने वालों के पास जाकर, अपने लिए मोल ले लो।</char> <verse eid="MAT 25:9"/><verse number="10" style="v" sid="MAT 25:10"/><char style="wj">जब वो मोल लेने जा रही थी, तो दुल्हा आ पहुँचा और जो तैयार थीं, वो उस के साथ शादी के जश्न में अन्दर चली गईं, और दरवाज़ा बन्द हो गया।</char> <verse eid="MAT 25:10"/><verse number="11" style="v" sid="MAT 25:11"/><char style="wj">फिर वो बाक़ी कुँवारियाँ भी आईं और कहने लगीं ‘ऐ ख़ुदावन्द ऐ ख़ुदावन्द। हमारे लिए दरवाज़ा खोल दे।’</char> <verse eid="MAT 25:11"/><verse number="12" style="v" sid="MAT 25:12"/><char style="wj">उसने जवाब में कहा ‘मैं तुम से सच कहता हूँ कि मैं तुम को नहीं जानता।’</char> <verse eid="MAT 25:12"/><verse number="13" style="v" sid="MAT 25:13"/><char style="wj">पस जागते रहो, क्यूँकि तुम न उस दिन को जानते हो न उस वक़्त को।”</char><verse eid="MAT 25:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>
    <char style="wj">“क्यूँकि ये उस आदमी जैसा हाल है, जिसने परदेस जाते वक़्त अपने घर के नौकरों को बुला कर अपना माल उनके सुपुर्द किया।</char> <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/><char style="wj">एक को पाँच चाँदी के सिक्के दिए, दूसरे को दो, और तीसरे को एक या'नी हर एक को उसकी काबलियत के मुताबिक़ दिया और परदेस चला गया।</char> <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/><char style="wj">जिसको पाँच सिक्के मिले थे, उसने फ़ौरन जाकर उनसे लेन देन किया, और पाँच तोड़े और पैदा कर लिए।</char> <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/><char style="wj">इसी तरह जिसे दो मिले थे, उसने भी दो और कमाए।</char> <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/><char style="wj">मगर जिसको एक मिला था, उसने जाकर ज़मीन खोदी और अपने मालिक का रुपऐ छिपा दिया।”</char><verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>
    <char style="wj">“बड़ी मुद्दत के बाद उन नौकरों का मालिक आया और उनसे हिसाब लेने लगा।</char> <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/><char style="wj">जिसको पाँच तोड़े मिले थे, वो पाँच सिक्के और लेकर आया, और कहा, ‘ऐ ख़ुदावन्द! तूने पाँच सिक्के मुझे सुपुर्द किए थे; देख, मैंने पाँच सिक्के और कमाए।’</char> <verse eid="MAT 25:20"/><verse number="21" style="v" sid="MAT 25:21"/><char style="wj">उसके मालिक ने उससे कहा, ‘ऐ अच्छे और ईमानदार नौकर शाबाश; तू थोड़े में ईमानदार रहा मैं तुझे बहुत चीज़ों का मुख़्तार बनाऊँगा; अपने मालिक की ख़ुशी में शरीक हो।’”</char><verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>
    <char style="wj">“और जिस को दो सिक्के मिले थे, उस ने भी पास आकर कहा, ‘तूने दो सिक्के मुझे सुपुर्द किए थे, देख मैंने दो सिक्के और कमाए।’</char> <verse eid="MAT 25:22"/><verse number="23" style="v" sid="MAT 25:23"/><char style="wj">उसके मालिक ने उससे कहा, ‘ऐ अच्छे और दियानतदार नौकर शाबाश; तू थोड़े में ईमानदार रहा मैं तुझे बहुत चीज़ों का मुख़्तार बनाऊँगा; अपने मालिक की ख़ुशी में शरीक हो।’”</char><verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>
    <char style="wj">“और जिसको एक तोड़ा मिला था, वो भी पास आकर कहने लगा, ऐ ख़ुदावन्द! मैं तुझे जानता था, कि तू सख़्त आदमी है, और जहाँ नहीं बोया वहाँ से काटता है, और जहाँ नहीं बिखेरा वहाँ से जमा करता है।</char> <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/><char style="wj">पस मैं डरा और जाकर तेरा तोड़ा ज़मीन में छिपा दिया देख, ‘जो तेरा है वो मौजूद है।’</char> <verse eid="MAT 25:25"/><verse number="26" style="v" sid="MAT 25:26"/><char style="wj">उसके मालिक ने जवाब में उससे कहा, 'ऐ शरीर और सुस्त नौकर तू जानता था कि जहाँ मैंने नहीं बोया वहाँ से काटता हूँ, और जहाँ मैंने नहीं बिखेरा वहाँ से जमा करता हूँ;</char> <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/><char style="wj">पस तुझे लाज़िम था, कि मेरा रुपऐ साहूकारों को देता, तो मैं आकर अपना माल सूद समेत ले लेता।</char> <verse eid="MAT 25:27"/><verse number="28" style="v" sid="MAT 25:28"/><char style="wj">पस इससे वो सिक्का ले लो और जिस के पास दस सिक्के हैं‘ उसे दे दो।</char> <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/><char style="wj">क्यूँकि जिस के पास है उसे दिया जाएगा और उस के पास ज़्यादा हो जाएगा, मगर जिस के पास नहीं है उससे वो भी जो उसके पास है, ले लिया जाएगा।</char> <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/><char style="wj">और इस निकम्मे नौकर को बाहर अंधेरे में डाल दो, और वहाँ रोना और दाँत पीसना होगा।’”</char><verse eid="MAT 25:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>
    <char style="wj">“जब इबने आदम अपने जलाल में आएगा, और सब फ़रिश्ते उसके साथ आएँगे; तब वो अपने जलाल के तख़्त पर बैठेगा।</char> <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/><char style="wj">और सब क़ौमें उस के सामने जमा की जाएँगी। और वो एक को दूसरे से जुदा करेगा।</char> <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/><char style="wj">और भेड़ों को अपने दाहिने और बकरियों को बाएँ जमा करेगा।</char> <verse eid="MAT 25:33"/><verse number="34" style="v" sid="MAT 25:34"/><char style="wj">उस वक़्त बादशाह अपनी तरफ़ वालों से कहेगा ‘आओ, मेरे बाप के मुबारिक़ लोगो, जो बादशाही दुनिया बनाने से पहले से तुम्हारे लिए तैयार की गई है उसे मीरास में ले लो।</char> <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/><char style="wj">क्यूँकि मैं भूखा था, तुमने मुझे खाना खिलाया; मैं प्यासा था, तुमने मुझे पानी पिलाया; मैं परदेसी था तूने मुझे अपने घर में उतारा।</char> <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/><char style="wj">नंगा था तुमने मुझे कपड़ा पहनाया, बीमार था तुमने मेरी ख़बर ली, मैं क़ैद में था, तुम मेरे पास आए।’”</char><verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>
    <char style="wj">“तब रास्तबाज़ जवाब में उससे कहेंगे, ऐ ख़ुदावन्द, हम ने कब तुझे भूखा देख कर खाना खिलाया, या प्यासा देख कर पानी पिलाया?</char> <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/><char style="wj">हम ने कब तुझे मुसाफ़िर देख कर अपने घर में उतारा? या नंगा देख कर कपड़ा पहनाया।</char> <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/><char style="wj">हम कब तुझे बीमार या क़ैद में देख कर तेरे पास आए।</char> <verse eid="MAT 25:39"/><verse number="40" style="v" sid="MAT 25:40"/><char style="wj">बादशाह जवाब में उन से कहेगा, ‘मैं तुम से सच कहता हूँ कि तुम ने मेरे सब से छोटे भाइयों में से किसी के साथ ये सुलूक किया, तो मेरे ही साथ किया।’</char> <verse eid="MAT 25:40"/><verse number="41" style="v" sid="MAT 25:41"/><char style="wj">फिर वो बाएँ तरफ़ वालों से कहेगा, ‘मला'ऊनो मेरे सामने से उस हमेशा की आग में चले जाओ, जो इब्लीस और उसके फ़रिश्तों के लिए तैयार की गई है।</char> <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/><char style="wj">क्यूँकि, मैं भूखा था, तुमने मुझे खाना न खिलाया, प्यासा था, तुमने मुझे पानी न पिलाया।</char> <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/><char style="wj">मुसाफ़िर था, तुम ने मुझे घर में न उतारा नंगा था, तुम ने मुझे कपड़ा न पहनाया, बीमार और क़ैद में था, तुम ने मेरी ख़बर न ली।’”</char><verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>
    <char style="wj">“तब वो भी जवाब में कहेंगे, ऐ ख़ुदावन्द हम ने कब तुझे भूखा, या प्यासा, या मुसाफ़िर, या नंगा, या बीमार या क़ैद में देखकर तेरी ख़िदमत न की?</char> <verse eid="MAT 25:44"/><verse number="45" style="v" sid="MAT 25:45"/><char style="wj">उस वक़्त वो उनसे जवाब में कहेगा, ‘मैं तुम से सच कहता हूँ कि जब तुम ने इन सब से छोटों में से किसी के साथ ये सुलूक न किया, तो मेरे साथ न किया।’</char> <verse eid="MAT 25:45"/><verse number="46" style="v" sid="MAT 25:46"/><char style="wj">और ये हमेशा की सज़ा पाएँगे, मगर रास्तबाज़ हमेशा की ज़िन्दगी।”</char><verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s">येसु को मारने की चाल</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>जब ईसा ये सब बातें ख़त्म कर चुका, तो ऐसा हुआ कि उसने अपने शागिर्दों से कहा। <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/><char style="wj">“तुम जानते हो कि दो दिन के बाद ईद — ए — फ़सह</char><note caller="+" style="f"><char style="fr" closed="false">26:2 </char><char style="fq" closed="false">ईद — ए — फ़सह </char><char style="ft" closed="false">ख़ुदा ने इस्राईल ओ जिस दिन मिस्र की ग़ुलामी से निकाला उसी दिन को ख़ुदा ने फ़सह का ईद ठहराया (छुटकारे आ दिन) </char></note> <char style="wj">होगी। और इब्न — ए — आदम मस्लूब होने को पकड़वाया जाएगा।”</char> <verse eid="MAT 26:2"/><verse number="3" style="v" sid="MAT 26:3"/>उस वक़्त सरदार काहिन और क़ौम के बुज़ुर्ग काइफ़ा नाम सरदार काहिन के दिवान खाने में जमा हुए। <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>और मशवरा किया कि ईसा को धोखे से पकड़ कर क़त्ल करें। <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>मगर कहते थे, “ईद में नहीं, ऐसा न हो कि लोगों में बलवा हो जाए।”<verse eid="MAT 26:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>और जब ईसा बैत अन्नियाह में शमौन जो पहले कौढ़ी था के घर में था। <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>तो एक 'औरत संग — मरमर के इत्रदान में क़ीमती इत्र लेकर उसके पास आई, और जब वो खाना खाने बैठा तो उस के सिर पर डाला। <verse eid="MAT 26:7"/><verse number="8" style="v" sid="MAT 26:8"/>शागिर्द ये देख कर ख़फ़ा हुए और कहने लगे, “ये किस लिए बरबाद किया गया? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>ये तो बड़ी क़ीमत में बिक कर ग़रीबों को दिया जा सकता था।” <verse eid="MAT 26:9"/><verse number="10" style="v" sid="MAT 26:10"/>ईसा' ने ये जान कर उन से कहा, <char style="wj">“इस 'औरत को क्यूँ दुखी करते हो? इस ने तो मेरे साथ भलाई की है।</char> <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/><char style="wj">क्यूँकि ग़रीब ग़ुरबे तो हमेशा तुम्हारे पास हैं लेकिन मैं तुम्हारे पास हमेशा न रहूँगा।</char> <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/><char style="wj">और इस ने तो मेरे दफ़्न की तैयारी के लिए इत्र मेरे बदन पर डाला।</char> <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/><char style="wj">मैं तुम से सच कहता हूँ, कि तमाम दुनिया में जहाँ कहीं इस ख़ुशख़बरी का एलान किया जाएगा, ये भी जो इस ने किया; इस की यादगारी में कहा जाएगा।”</char><verse eid="MAT 26:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>उस वक़्त उन बारह में से एक ने जिसका नाम यहूदाह इस्करियोती था; सरदार काहिनों के पास जा कर कहा, <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>“अगर मैं उसे तुम्हारे हवाले कर दूँ तो मुझे क्या दोगे? उन्होंने उसे तीस रुपऐ तौल कर दे दिया।” <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>और वो उस वक़्त से उसके पकड़वाने का मौक़ा ढूँडने लगा।<verse eid="MAT 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>ईद — 'ए — फ़ितर के पहले दिन शागिर्दों ने ईसा के पास आकर कहा, “तू कहाँ चाहता है कि हम तेरे लिए फ़सह के खाने की तैयारी करें।” <verse eid="MAT 26:17"/><verse number="18" style="v" sid="MAT 26:18"/>उस ने कहा, <char style="wj">“शहर में फ़लाँ शख़्स के पास जा कर उससे कहना ‘उस्ताद फ़रमाता है’ कि मेरा वक़्त नज़दीक है मैं अपने शागिर्दों के साथ तेरे यहाँ ईद'ए फ़सह करूँगा।”</char> <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/>और जैसा ईसा ने शागिर्दों को हुक्म दिया था, उन्होंने वैसा ही किया और फ़सह तैयार किया।<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>जब शाम हुई तो वो बारह शागिर्दों के साथ खाना खाने बैठा था। <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>जब वो खा रहा था, तो उसने कहा, <char style="wj">“मैं तुम से सच कहता हूँ कि तुम में से एक मुझे पकड़वाएगा।”</char> <verse eid="MAT 26:21"/><verse number="22" style="v" sid="MAT 26:22"/>वो बहुत ही ग़मगीन हुए और हर एक उससे कहने लगे “ख़ुदावन्द, क्या मैं हूँ?” <verse eid="MAT 26:22"/><verse number="23" style="v" sid="MAT 26:23"/>उस ने जवाब में कहा, <char style="wj">“जिस ने मेरे साथ रक़ाबी में हाथ डाला है वही मुझे पकड़वाएगा।</char> <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/><char style="wj">इबने आदम तो जैसा उसके हक़ में लिखा है जाता ही है लेकिन उस आदमी पर अफ़सोस जिसके वसीले से इबने आदम पकड़वाया जाता है अगर वो आदमी पैदा न होता तो उसके लिए अच्छा होता।”</char> <verse eid="MAT 26:24"/><verse number="25" style="v" sid="MAT 26:25"/>उसके पकड़वाने वाले यहूदाह ने जवाब में कहा “ऐ रब्बी क्या मैं हूँ?” उसने उससे कहा <char style="wj">“तूने ख़ुद कह दिया।”</char><verse eid="MAT 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>जब वो खा रहे थे तो ईसा' ने रोटी ली और — और बर्क़त देकर तोड़ी और शागिर्दों को देकर कहा, <char style="wj">“लो, खाओ, ये मेरा बदन है।”</char> <verse eid="MAT 26:26"/><verse number="27" style="v" sid="MAT 26:27"/>फिर प्याला लेकर शुक्र किया और उनको देकर कहा <char style="wj">“तुम सब इस में से पियो।</char> <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/><char style="wj">क्यूँकि ये मेरा वो अहद का ख़ून है जो बहुतों के गुनाहों की मु'आफ़ी के लिए बहाया जाता है।</char> <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/><char style="wj">मैं तुम से कहता हूँ, कि अंगूर का ये शीरा फिर कभी न पियूँगा, उस दिन तक कि तुम्हारे साथ अपने बाप की बादशाही में नया न पियूँ।”</char> <verse eid="MAT 26:29"/><verse number="30" style="v" sid="MAT 26:30"/>फिर वो हम्द करके बाहर ज़ैतून के पहाड़ पर गए।<verse eid="MAT 26:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>उस वक़्त ईसा' ने उनसे कहा <char style="wj">“तुम सब इसी रात मेरी वजह से ठोकर खाओगे क्यूँकि लिखा है; मैं चरवाहे को मारूँगा और गल्ले की भेंड़े बिखर जाएँगी।</char> <verse eid="MAT 26:31"/><verse number="32" style="v" sid="MAT 26:32"/><char style="wj">लेकिन मैं अपने जी उठने के बाद तुम से पहले गलील को जाऊँगा।”</char> <verse eid="MAT 26:32"/><verse number="33" style="v" sid="MAT 26:33"/>पतरस ने जवाब में उससे कहा, “चाहे सब तेरी वजह से ठोकर खाएँ, लेकिन में कभी ठोकर न खाऊँगा।” <verse eid="MAT 26:33"/><verse number="34" style="v" sid="MAT 26:34"/>ईसा' ने उससे कहा, <char style="wj">“मैं तुझसे सच कहता हूँ, इसी रात मुर्ग़ के बाँग देने से पहले, तू तीन बार मेरा इन्कार करेगा।”</char> <verse eid="MAT 26:34"/><verse number="35" style="v" sid="MAT 26:35"/>पतरस ने उससे कहा, “अगर तेरे साथ मुझे मरना भी पड़े। तोभी तेरा इन्कार हरगिज़ न करूँगा।” और सब शागिर्दो ने भी इसी तरह कहा।<verse eid="MAT 26:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>उस वक़्त ईसा' उनके साथ गतसिमनी नाम एक जगह में आया और अपने शागिर्दों से कहा। <char style="wj">“यहीं बैठे रहना जब तक कि मैं वहाँ जाकर दुआ करूँ।”</char> <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>और पतरस और ज़ब्दी के दोनों बेटों को साथ लेकर ग़मगीन और बेक़रार होने लगा। <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>उस वक़्त उसने उनसे कहा, <char style="wj">“मेरी जान निहायत ग़मगीन है यहाँ तक कि मरने की नौबत पहुँच गई है, तुम यहाँ ठहरो, और मेरे साथ जागते रहो।”</char> <verse eid="MAT 26:38"/><verse number="39" style="v" sid="MAT 26:39"/>फिर ज़रा आगे बढ़ा और मुँह के बल गिर कर यूँ दुआ की, <char style="wj">“ऐ मेरे बाप, अगर हो सके तो ये दुःख का प्याला मुझ से टल जाए, तोभी न जैसा मैं चाहता हूँ; बल्कि जैसा तू चाहता है वैसा ही हो।”</char> <verse eid="MAT 26:39"/><verse number="40" style="v" sid="MAT 26:40"/>फिर शागिर्दों के पास आकर उनको सोते पाया और पतरस से कहा, <char style="wj">“क्या तुम मेरे साथ एक घड़ी भी न जाग सके?</char> <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/><char style="wj">जागते और दुआ करते रहो ताकि आज़्माइश में न पड़ो, रूह तो मुस्त'इद है मगर जिस्म कमज़ोर है।”</char> <verse eid="MAT 26:41"/><verse number="42" style="v" sid="MAT 26:42"/>फिर दोबारा उसने जाकर यूँ दुआ की <char style="wj">“ऐ मेरे बाप अगर ये मेरे पिए बग़ैर नहीं टल सकता तो तेरी मर्ज़ी पूरी हो।”</char> <verse eid="MAT 26:42"/><verse number="43" style="v" sid="MAT 26:43"/>और आकर उन्हें फिर सोते पाया, क्यूँकि उनकी आँखें नींद से भरी थीं। <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>और उनको छोड़ कर फिर चला गया, और फिर वही बात कह कर तीसरी बार दुआ की। <verse eid="MAT 26:44"/><verse number="45" style="v" sid="MAT 26:45"/>तब शागिर्दों के पास आकर उसने कहा <char style="wj">“अब सोते रहो, और आराम करो, देखो वक़्त आ पहुँचा है, और इबने आदम गुनाहगारों के हवाले किया जाता है।</char> <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/><char style="wj">उठो चलें, देखो, मेरा पकड़वाने वाला नज़दीक आ पहुँचा है।”</char><verse eid="MAT 26:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>वो ये कह ही रहा था, कि यहूदाह जो उन बारह में से एक था, आया, और उसके साथ एक बड़ी भीड़ तलवारें और लाठियाँ लिए सरदार काहिनों और क़ौम के बुज़ुर्गों की तरफ़ से आ पहुँची। <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>और उसके पकड़वाने वाले ने उनको ये निशान दिया था, जिसका मैं बोसा लूँ वही है उसे पकड़ लेना। <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/>और फ़ौरन उसने ईसा के पास आ कर कहा, “ऐ रब्बी सलाम!” और उसके बोसे लिए। <verse eid="MAT 26:49"/><verse number="50" style="v" sid="MAT 26:50"/>ईसा' ने उससे कहा, <char style="wj">“मियाँ! जिस काम को आया है वो कर ले”।</char> इस पर उन्होंने पास आकर ईसा' पर हाथ डाला और उसे पकड़ लिया। <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>और देखो, ईसा के साथियों में से एक ने हाथ बढ़ा कर अपनी तलवार खींची और सरदार काहिन के नौकर पर चला कर उसका कान उड़ा दिया। <verse eid="MAT 26:51"/><verse number="52" style="v" sid="MAT 26:52"/>ईसा' ने उससे कहा, <char style="wj">“अपनी तलवार को मियान में कर क्यूँकि जो तलवार खींचते हैं वो सब तलवार से हलाक किए जाएँगे।</char> <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/><char style="wj">क्या तू नहीं समझता कि मैं अपने बाप से मिन्नत कर सकता हूँ, और वो फ़रिश्तों के बारह पलटन से ज़्यादा मेरे पास अभी मौजूद कर देगा?</char> <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/><char style="wj">मगर वो लिखे हुए का यूँ ही होना ज़रूर है क्यूँ कर पूरे होंगे?”</char> <verse eid="MAT 26:54"/><verse number="55" style="v" sid="MAT 26:55"/>उसी वक़्त ईसा' ने भीड़ से कहा, <char style="wj">“क्या तुम तलवारें और लाठियाँ लेकर मुझे डाकू की तरह पकड़ने निकले हो? मैं हर रोज़ हैकल में बैठकर ता'लीम देता था, और तुमने मुझे नहीं पकड़ा।</char> <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/><char style="wj">मगर ये सब कुछ इसलिए हुआ कि नबियों की नबुव्वत पूरी हों।”</char> इस पर सब शागिर्द उसे छोड़ कर भाग गए।<verse eid="MAT 26:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>और ईसा के पकड़ने वाले उसको काइफ़ा नाम सरदार काहिन के पास ले गए, जहाँ आलिम और बुज़ुर्ग जमा हुए थे। <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>और पतरस दूर — दूर उसके पीछे — पीछे सरदार काहिन के दिवानख़ाने तक गया, और अन्दर जाकर प्यादों के साथ नतीजा देखने को बैठ गया। <verse eid="MAT 26:58"/><verse number="59" style="v" sid="MAT 26:59"/>सरदार काहिन और सब सद्रे — ए 'अदालत वाले ईसा को मार डालने के लिए उसके ख़िलाफ़ झूठी गवाही ढूँडने लगे। <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>मगर न पाई, गरचे बहुत से झूठे गवाह आए, लेकिन आख़िरकार दो गवाहों ने आकर कहा, <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>“इस ने कहा है, कि मैं ख़ुदा के मक़दिस को ढा सकता और तीन दिन में उसे बना सकता हूँ।”<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>और सरदार काहिन ने खड़े होकर उससे कहा, “तू जवाब नहीं देता? ये तेरे ख़िलाफ़ क्या गवाही देते हैं?” <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>मगर ईसा ख़ामोश ही रहा, सरदार काहिन ने उससे कहा, “मैं तुझे ज़िन्दा ख़ुदा की क़सम देता हूँ, कि अगर तू ख़ुदा का बेटा मसीह है तो हम से कह दे?” <verse eid="MAT 26:63"/><verse number="64" style="v" sid="MAT 26:64"/>ईसा' ने उससे कहा, <char style="wj">“तू ने ख़ुद कह दिया बल्कि मैं तुम से कहता हूँ, कि इसके बाद इबने आदम को क़ादिर — ए मुतल्लिक़ की दहनी तरफ़ बैठे और आसमान के बादलों पर आते देखोगे।”</char> <verse eid="MAT 26:64"/><verse number="65" style="v" sid="MAT 26:65"/>इस पर सरदार काहिन ने ये कह कर अपने कपड़े फाड़े “उसने कुफ़्र बका है अब हम को गवाहों की क्या ज़रूरत रही? देखो, तुम ने अभी ये कुफ़्र सुना है। <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>तुम्हारी क्या राय है? उन्होंने जवाब में कहा, वो क़त्ल के लायक़ है।” <verse eid="MAT 26:66"/><verse number="67" style="v" sid="MAT 26:67"/>इस पर उन्होंने उसके मुँह पर थूका और उसके मुक्के मारे और कुछ ने तमाचे मार कर कहा। <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>“ऐ मसीह, हमें नुबुव्वत से बता कि तुझे किस ने मारा।”<verse eid="MAT 26:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>पतरस बाहर सहन में बैठा था, कि एक लौंडी ने उसके पास आकर कहा, “तू भी ईसा गलीली के साथ था।” <verse eid="MAT 26:69"/><verse number="70" style="v" sid="MAT 26:70"/>उसने सबके सामने ये कह कर इन्कार किया “मैं नहीं जानता तू क्या कहती है।” <verse eid="MAT 26:70"/><verse number="71" style="v" sid="MAT 26:71"/>और जब वो डेवढ़ी में चला गया तो दूसरी ने उसे देखा, और जो वहाँ थे, उनसे कहा, “ये भी ईसा नासरी के साथ था।” <verse eid="MAT 26:71"/><verse number="72" style="v" sid="MAT 26:72"/>उसने क़सम खा कर फिर इन्कार किया “मैं इस आदमी को नहीं जानता।” <verse eid="MAT 26:72"/><verse number="73" style="v" sid="MAT 26:73"/>थोड़ी देर के बाद जो वहाँ खड़े थे, उन्होंने पतरस के पास आकर कहा, “बेशक तू भी उन में से है, क्यूँकि तेरी बोली से भी ज़ाहिर होता है।” <verse eid="MAT 26:73"/><verse number="74" style="v" sid="MAT 26:74"/>इस पर वो ला'नत करने और क़सम खाने लगा “मैं इस आदमी को नहीं जानता!” और फ़ौरन मुर्ग़ ने बाँग दी। <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>पतरस को ईसा' की वो बात याद आई जो उसने कही थी: <char style="wj">“मुर्ग़ के बाँग देने से पहले तू तीन बार मेरा इन्कार करेगा।”</char> और वो बाहर जाकर ज़ार ज़ार रोया।<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s">यहूदा का फाँसी लगाना</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>जब सुबह हुई तो सब सरदार काहिनों और क़ौम के बुज़ुर्गों ने ईसा के ख़िलाफ़ मशवरा किया कि उसे मार डालें। <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>और उसे बाँध कर ले गए, और पीलातुस हाकिम के हवाले किया।<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>जब उसके पकड़वाने वाले यहूदाह ने ये देखा, कि वो मुजरिम ठहराया गया, तो अफ़्सोस किया और वो तीस रुपऐ सरदार काहिन और बुज़ुर्गों के पास वापस लाकर कहा। <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>“मैंने गुनाह किया, कि बेक़ुसूर को क़त्ल के लिए पकड़वाया।” उन्हों ने कहा “हमें क्या! तू जान।” <verse eid="MAT 27:4"/><verse number="5" style="v" sid="MAT 27:5"/>वो रुपऐऊँ को मक़दिस में फेंक कर चला गया। और जाकर अपने आपको फाँसी दी।<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>सरदार काहिन ने रुपऐ लेकर कहा “इनको हैकल के ख़ज़ाने में डालना जायज़ नहीं; क्यूँकि ये ख़ून की क़ीमत है।” <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>पस उन्होंने मशवरा करके उन रुपऐऊँ से कुम्हार का खेत परदेसियों के दफ़्न करने के लिए ख़रीदा। <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>इस वजह से वो खेत आज तक ख़ून का खेत कहलाता है। <verse eid="MAT 27:8"/><verse number="9" style="v" sid="MAT 27:9"/>उस वक़्त वो पूरा हुआ जो यरमियाह नबी के ज़रिए कहा गया था कि जिसकी क़ीमत ठहराई गई थी, “उन्होंने उसकी क़ीमत के वो तीस रुपऐ ले लिए, (उसकी क़ीमत कुछ बनी इस्राईल ने ठहराई थी) <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>और उसको कुम्हार के खेत के लिए दिया, जैसा ख़ुदावन्द ने मुझे हुक्म दिया।”<verse eid="MAT 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>ईसा हाकिम के सामने खड़ा था, और हाकिम ने उससे पूछा, क्या तू यहूदियों का बादशाह है? ईसा ने उस से कहा, <char style="wj">“तू ख़ुद कहता है।”</char> <verse eid="MAT 27:11"/><verse number="12" style="v" sid="MAT 27:12"/>जब सरदार काहिन और बुज़ुर्ग उस पर इल्ज़ाम लगा रहे थे, उसने कुछ जवाब न दिया। <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>इस पर पीलातुस ने उस से कहा “क्या तू नहीं सुनता, ये तेरे ख़िलाफ़ कितनी गवाहियाँ देते हैं?” <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/>उसने एक बात का भी उसको जवाब न दिया, यहाँ तक कि हाकिम ने बहुत ता'ज्जुब किया।<verse eid="MAT 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>और हाकिम का दस्तूर था, कि ईद पर लोगों की ख़ातिर एक क़ैदी जिसे वो चाहते थे छोड़ देता था। <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>उस वक़्त बरअब्बा नाम उन का एक मशहूर क़ैदी था। <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>पस जब वो इकटठे हुए तो पीलातुस ने उस से कहा, “तुम किसे चाहते हो कि तुम्हारी ख़ातिर छोड़ दूँ? बरअब्बा को या ईसा को जो मसीह कहलाता है?” <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>क्यूँकि उसे मा'लूम था, कि उन्होंने उसको जलन से पकड़वाया है। <verse eid="MAT 27:18"/><verse number="19" style="v" sid="MAT 27:19"/>और जब वो तख़्त — ए आदालत पर बैठा था तो उस की बीवी ने उसे कहला भेजा “तू इस रास्तबाज़ से कुछ काम न रख क्यूँकि मैंने आज ख़्वाब में इस की वजह से बहुत दु:ख उठाया है।”<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>लेकिन सरदार काहिनों और बुज़ुर्गों ने लोगों को उभारा कि बरअब्बा को माँग लें, और ईसा को हलाक कराएँ। <verse eid="MAT 27:20"/><verse number="21" style="v" sid="MAT 27:21"/>हाकिम ने उनसे कहा इन दोनों में से किसको चाहते हो कि तुम्हारी ख़ातिर छोड़ दूँ? उन्होंने कहा “बरअब्बा को।” <verse eid="MAT 27:21"/><verse number="22" style="v" sid="MAT 27:22"/>पीलातुस ने उनसे कहा “फिर ईसा को जो मसीह कहलाता है क्या करूँ?” सब ने कहा “वो मस्लूब हो।” <verse eid="MAT 27:22"/><verse number="23" style="v" sid="MAT 27:23"/>उसने कहा “क्यूँ? उस ने क्या बुराई की है?” मगर वो और भी चिल्ला — चिल्ला कर कहने लगे “वो मस्लूब हो!” <verse eid="MAT 27:23"/><verse number="24" style="v" sid="MAT 27:24"/>जब पीलातुस ने देखा कि कुछ बन नहीं पड़ता बल्कि उल्टा बलवा होता जाता है तो पानी लेकर लोगों के रूबरू अपने हाथ धोए “और कहा, मैं इस रास्तबाज़ के ख़ून से बरी हूँ; तुम जानो।” <verse eid="MAT 27:24"/><verse number="25" style="v" sid="MAT 27:25"/>सब लोगों ने जवाब में कहा “इसका ख़ून हमारी और हमारी औलाद की गर्दन पर।”<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>इस पर उस ने बरअब्बा को उनकी ख़ातिर छोड़ दिया, और ईसा को कोड़े लगवा कर हवाले किया कि मस्लूब हो।<verse eid="MAT 27:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>इस पर हाकिम के सिपाहियों ने ईसा को क़िले में ले जाकर सारी पलटन उसके आस पास जमा की। <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>और उसके कपड़े उतार कर उसे क़िरमिज़ी चोग़ा पहनाया। <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>और काँटों का ताज बना कर उसके सिर पर रख्खा, और एक सरकंडा उस के दहने हाथ में दिया और उसके आगे घुटने टेक कर उसे ठठ्ठों में उड़ाने लगे; “ऐ यहूदियों के बादशाह, आदाब!” <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>और उस पर थूका, और वही सरकंडा लेकर उसके सिर पर मारने लगे। <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>और जब उसका ठठ्ठा कर चुके तो चोग़े को उस पर से उतार कर फिर उसी के कपड़े उसे पहनाए; और मस्लूब करने को ले गए।<verse eid="MAT 27:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>जब बाहर आए तो उन्होंने शमौन नाम एक कुरेनी आदमी को पाकर उसे बेग़ार में पकड़ा, कि उसकी सलीब उठाए। <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>और उस जगह जो गुल्गुता या'नी खोपड़ी की जगह कहलाती है पहुँचकर। <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>पित मिली हुई मय उसे पीने को दी, मगर उसने चख कर पीना न चाहा। <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>और उन्होंने उसे मस्लूब किया; और उसके कपड़े पर्ची डाल कर बाँट लिए। <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>और वहाँ बैठ कर उसकी निगहबानी करने लगे। <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>और उस का इल्ज़ाम लिख कर उसके सिर से ऊपर लगा दिया “कि ये यहूदियों का बादशाह ईसा है।” <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>उस वक़्त उसके साथ दो डाकू मस्लूब हुए, एक दहने और एक बाएँ। <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>और राह चलने वाले सिर हिला — हिला कर उसको ला'न ता'न करते और कहते थे। <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>“ऐ मक़दिस के ढानेवाले और तीन दिन में बनाने वाले अपने आप को बचा; अगर तू ख़ुदा का बेटा है तो सलीब पर से उतर आ।” <verse eid="MAT 27:40"/><verse number="41" style="v" sid="MAT 27:41"/>इसी तरह सरदार काहिन भी फ़क़ीहों और बुज़ुर्गों के साथ मिलकर ठठ्ठे से कहते थे, <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>“इसने औरों को बचाया, अपने आप को नहीं बचा सकता, ये तो इस्राईल का बादशाह है; अब सलीब पर से उतर आए, तो हम इस पर ईमान लाएँ। <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>इस ने ख़ुदा पर भरोसा किया है, अगरचे इसे चाहता है तो अब इस को छुड़ा ले, क्यूँकि इस ने कहा था, मैं ख़ुदा का बेटा हूँ।” <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>इसी तरह डाकू भी जो उसके साथ मस्लूब हुए थे, उस पर ला'न ता'न करते थे।<verse eid="MAT 27:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>और दोपहर से लेकर तीसरे पहर तक तमाम मुल्क में अन्धेरा छाया रहा। <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>और तीसरे पहर के क़रीब ईसा ने बड़ी आवाज़ से चिल्ला कर कहा <char style="wj">“एली, एली, लमा शबक़तनी ऐ मेरे ख़ुदा, ऐ मेरे ख़ुदा, तू ने मुझे क्यूँ छोड़ दिया?”</char> <verse eid="MAT 27:46"/><verse number="47" style="v" sid="MAT 27:47"/>जो वहाँ खड़े थे उन में से कुछ ने सुन कर कहा “ये एलियाह को पुकारता है।” <verse eid="MAT 27:47"/><verse number="48" style="v" sid="MAT 27:48"/>और फ़ौरन उनमें से एक शख़्स दौड़ा और सोख़ते को लेकर सिरके में डुबोया और सरकंडे पर रख कर उसे चुसाया। <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>मगर बाक़ियों ने कहा, “ठहर जाओ, देखें तो एलियाह उसे बचाने आता है या नहीं।” <verse eid="MAT 27:49"/><verse number="50" style="v" sid="MAT 27:50"/>ईसा ने फिर बड़ी आवाज़ से चिल्ला कर जान दे दी। <verse eid="MAT 27:50"/><verse number="51" style="v" sid="MAT 27:51"/>और मक़दिस का पर्दा ऊपर से नीचे तक फट कर दो टुकड़े हो गया, और ज़मीन लरज़ी और चट्टानें तड़क गईं। <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>और क़ब्रें खुल गईं। और बहुत से जिस्म उन मुक़द्दसों के जो सो गए थे, जी उठे। <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>और उसके जी उठने के बाद क़ब्रों से निकल कर मुक़द्दस शहर में गए, और बहुतों को दिखाई दिए। <verse eid="MAT 27:53"/><verse number="54" style="v" sid="MAT 27:54"/>पस सुबेदार और जो उस के साथ ईसा की निगहबानी करते थे, भुन्चाल और तमाम माजरा देख कर बहुत ही डर कर कहने लगे “बै — शक ये ख़ुदा का बेटा था।” <verse eid="MAT 27:54"/><verse number="55" style="v" sid="MAT 27:55"/>और वहाँ बहुत सी औरतें जो गलील से ईसा की ख़िदमत करती हुई उसके पीछे — पीछे आई थी, दूर से देख रही थीं। <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>उन में मरियम मग़दलिनी थी, और या'क़ूब और योसेस की माँ मरियम और ज़ब्दी के बेटों की माँ।<verse eid="MAT 27:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>जब शाम हुई तो यूसुफ़ नाम अरिमतियाह का एक दौलतमन्द आदमी आया जो ख़ुद भी ईसा का शागिर्द था। <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>उस ने पीलातुस के पास जा कर ईसा की लाश माँगी, इस पर पीलातुस ने दे देने का हुक्म दे दिया। <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>यूसुफ़ ने लाश को लेकर साफ़ महीन चादर में लपेटा। <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>और अपनी नई क़ब्र में जो उस ने चट्टान में खुदवाई थी रख्खा, फिर वो एक बड़ा पत्थर क़ब्र के मुँह पर लुढ़का कर चला गया। <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>और मरियम मग़दलिनी और दूसरी मरियम वहाँ क़ब्र के सामने बैठी थीं।<verse eid="MAT 27:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>दूसरे दिन जो तैयारी के बाद का दिन था, सरदार काहिन और फ़रीसियों ने पीलातुस के पास जमा होकर कहा। <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>ख़ुदावन्द हमें याद है “कि उस धोखेबाज़ ने जीते जी कहा था, मैं तीन दिन के बाद जी उठूँगा। <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>पस हुक्म दे कि तीसरे दिन तक क़ब्र की निगहबानी की जाए, कहीं ऐसा न हो कि उसके शागिर्द आकर उसे चुरा ले जाएँ, और लोगों से कह दें, वो मुर्दों में से जी उठा, और ये पिछला धोखा पहले से भी बुरा हो।” <verse eid="MAT 27:64"/><verse number="65" style="v" sid="MAT 27:65"/>पीलातुस ने उनसे कहा “तुम्हारे पास पहरे वाले हैं जाओ, जहाँ तक तुम से हो सके उसकी निगहबानी करो।” <verse eid="MAT 27:65"/><verse number="66" style="v" sid="MAT 27:66"/>पस वो पहरेदारों को साथ लेकर गए, और पत्थर पर मुहर करके क़ब्र की निगहबानी की।<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s">येसु का रास्त ख़ैज़</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>सबत के बाद हफ़्ते के पहले दिन धूप निकलते वक़्त मरियम मग़दलिनी और दूसरी मरियम क़ब्र को देखने आईं। <verse eid="MAT 28:1"/><verse number="2" style="v" sid="MAT 28:2"/>और देखो, एक बड़ा भुन्चाल आया क्यूँकि ख़ुदा का फ़रिश्ता आसमान से उतरा और पास आकर पत्थर को लुढ़का दिया; और उस पर बैठ गया। <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>उसकी सूरत बिजली की तरह थी, और उसकी पोशाक बर्फ़ की तरह सफ़ेद थी। <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>और उसके डर से निगहबान काँप उठे, और मुर्दा से हो गए। <verse eid="MAT 28:4"/><verse number="5" style="v" sid="MAT 28:5"/>फ़रिश्ते ने औरतों से कहा, “तुम न डरो। क्यूँकि मैं जानता हूँ कि तुम ईसा को ढूँड रही हो जो मस्लूब हुआ था। <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>वो यहाँ नहीं है, क्यूँकि अपने कहने के मुताबिक़ जी उठा है; आओ ये जगह देखो जहाँ ख़ुदावन्द पड़ा था। <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>और जल्दी जा कर उस के शागिर्दों से कहो वो मुर्दों में से जी उठा है, और देखो; वो तुम से पहले गलील को जाता है वहाँ तुम उसे देखोगे, देखो मैंने तुम से कह दिया है।” <verse eid="MAT 28:7"/><verse number="8" style="v" sid="MAT 28:8"/>और वो ख़ौफ़ और बड़ी ख़ुशी के साथ क़ब्र से जल्द रवाना होकर उसके शागिर्दों को ख़बर देने दौड़ीं।<verse eid="MAT 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9"/>और देखो ईसा उन से मिला, और उस ने कहा, <char style="wj">“सलाम।”</char> उन्होंने पास आकर उसके क़दम पकड़े और उसे सज्दा किया। <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>इस पर ईसा ने उन से कहा, <char style="wj">“डरो नहीं। जाओ, मेरे भाइयों से कहो कि गलील को चले जाएँ, वहाँ मुझे देखेंगे।”</char><verse eid="MAT 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>जब वो जा रही थीं, तो देखो; पहरेदारों में से कुछ ने शहर में आकर तमाम माजरा सरदार काहिनों से बयान किया। <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>और उन्होंने बुज़ुर्गों के साथ जमा होकर मशवरा किया और सिपाहियों को बहुत सा रुपऐ दे कर कहा, <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>“ये कह देना, कि रात को जब हम सो रहे थे उसके शागिर्द आकर उसे चुरा ले गए। <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>अगर ये बात हाकिम के कान तक पहुँची तो हम उसे समझाकर तुम को ख़तरे से बचा लेंगे” <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>पस उन्होंने रुपऐ लेकर जैसा सिखाया गया था, वैसा ही किया; और ये बात यहूदियों में मशहूर है।<verse eid="MAT 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>और ग्यारह शागिर्द गलील के उस पहाड़ पर गए, जो ईसा ने उनके लिए मुक़र्रर किया था। <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>उन्होंने उसे देख कर सज्दा किया, मगर कुछ ने शक किया। <verse eid="MAT 28:17"/><verse number="18" style="v" sid="MAT 28:18"/>ईसा ने पास आ कर उन से बातें की और कहा <char style="wj">“आस्मान और ज़मीन का कुल इख़्तियार मुझे दे दिया गया है।</char> <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/><char style="wj">पस तुम जा कर सब क़ौमों को शागिर्द बनाओ और उन को बाप और बेटे और रूह — उल — क़ुद्दूस के नाम से बपतिस्मा दो।</char> <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/><char style="wj">और उन को ये ता'लीम दो, कि उन सब बातों पर अमल करें जिनका मैंने तुम को हुक्म दिया; और देखो, मैं दुनिया के आख़िर तक हमेशा तुम्हारे साथ हूँ।”</char><verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
