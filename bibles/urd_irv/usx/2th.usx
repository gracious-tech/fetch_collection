<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TH" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">2 थिस्सलुनीकियों</para>
  <para style="toc1">2 थिस्सलुनीकियों</para>
  <para style="toc2">2 थिस्स</para>
  <para style="toc3">2 थिस्स</para>
  <para style="mt">थिस्सलुनीकियों के नाम पौलुस रसूल का दूसरा ख़त</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">1 थिसलुनीकों की तरह ही यह ख़त भी पौलूस, सीलास और तीमुथियुस की तरफ़ से है इस ख़त के लिखने वाले ने वही तरीक़ा इस्तेमाल किया जैसे 1 थिसलुनीकों के लिए और दीगर ख़ुतूत के लिए किया जिन्हें पौलूस ने लिखे थे। यह बताता है कि पौलूस ख़ास मुसन्निफ़ था। सीलास और तीमुथियुस को शुरूआती सलाम में शामिल किया गया है (2 थिसलुनीकियों 1:1) इस की कई एक आयतों में 'हम' और 'हमारे' का लफ़्ज़ इस्ते‘माल हुआ है जो यह बताता है कि वह तीनों उन बातों के लिए राज़ी थे। ख़ुशख़त पौलूस की नहीं थी जबकि उस ने सिर्फ़ आख़री सलाम और दुआ के अल्फ़ाज़ लिखे थे (2 थिसलुनीकियों 3:17) ऐसा लगता है कि पौलूस ने तीमुथियुस और सीलास को लिखने की हिदायत दी थी।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इस के लिखे जाने की तारीख़ तक़रीबन 51 - 52 ईस्वी के बीच था।</para>
  <para style="ip">2 थिसलुनीकियों के ख़त को पौलूस ने कुरिन्थ में लिखवाया था जब 1 थिसलुनीकियों लिखा जा रहा था।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">2 थिसलुनीकियों 1:1 का हवाला इस कलीसिया के लिए दूसरे ख़त के क़ारिईन बतौर पहचान करती है।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">इसे लिखने का मक़्सद था ख़ुदावन्द की दूसरी आमद की बाबत मसीही एतक़ादी उसलू की ग़लती को सुधारना। ईमान्दारों की ईमान की हिफ़ाज़त में उन की तौसीफ़ व ता‘रीफ़ करने और उनकी हौसला अफ़्ज़ाई करने और ख़ुदावन्द की दूसरी आमद की बाबत जो ग़लतफ़हमी थी उन्हें दूर करने के लिए पौलूस ने इस ख़त को लिखवाया।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">उम्मीद में जीना।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. सलाम — 1:1, 2</para>
  <para style="io1">2. मुसीबत में दिलासा — 1:3-12</para>
  <para style="io1">3. ख़ुदावन्द की दूसरी आमद की बाबत सही तसव्वुर पेश करना — 2:1-12</para>
  <para style="io1">4. उन के मुक़द्दर की बाबत याद दिहानी (याददाशत) 2:13-17</para>
  <para style="io1">5. अमली मुआमलों से मुता‘ल्लिक़ नसीहतें — 3:1-15</para>
  <para style="io1">6. आख़री सलाम — 3:16-18</para>
  <chapter number="1" style="c" sid="2TH 1"/>
  <para style="s">पौलुस का सलाम</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1"/>पौलुस, और सिलास और तीमुथियुस की तरफ़ से थिस्सलुनीकियों शहर की कलीसिया के नाम ख़त जो हमारे बाप ख़ुदा और ख़ुदावन्द 'ईसा मसीह में है।<verse eid="2TH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2"/>फ़ज़ल और इत्मीनान ख़ुदा' बाप और ख़ुदावन्द 'ईसा मसीह की तरफ़ से तुम्हें हासिल होता रहे।<verse eid="2TH 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3"/>ऐ भाइयों! तुम्हारे बारे में हर वक़्त ख़ुदा का शुक्र करना हम पर फ़र्ज़ है, और ये इसलिए मुनासिब है, कि तुम्हारा ईमान बहुत बढ़ता जाता है; और तुम सब की मुहब्बत आपस में ज़्यादा होती जाती है। <verse eid="2TH 1:3"/><verse number="4" style="v" sid="2TH 1:4"/>यहाँ तक कि हम आप ख़ुदा की कलीसियाओं में तुम पर फ़ख़्र करते हैं कि जितने ज़ुल्म और मुसीबतें तुम उठाते हो उन सब में तुम्हारा सब्र और ईमान ज़ाहिर होता है। <verse eid="2TH 1:4"/><verse number="5" style="v" sid="2TH 1:5"/>ये ख़ुदा की सच्ची अदालत का साफ़ निशान है; ताकि तुम ख़ुदा की बादशाही के लायक़ ठहरो जिस के लिए तुम तकलीफ़ भी उठाते हो।<verse eid="2TH 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 1:6"/>क्यूँकि ख़ुदा के नज़दीक ये इन्साफ़ है के बदले में तुम पर मुसीबत लाने वालों को मुसीबत। <verse eid="2TH 1:6"/><verse number="7" style="v" sid="2TH 1:7"/>और तुम मुसीबत उठाने वालों को हमारे साथ आराम दे; जब ख़ुदावन्द 'ईसा अपने मज़बूत फ़रिश्तों के साथ भड़कती हुई आग में आसमान से ज़ाहिर होगा। <verse eid="2TH 1:7"/><verse number="8" style="v" sid="2TH 1:8"/>और जो ख़ुदा को नहीं पहचानते और हमारे ख़ुदावन्द 'ईसा की ख़ुशख़बरी को नहीं मानते उन से बदला लेगा।<verse eid="2TH 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2TH 1:9"/>वह ख़ुदावन्द का चेहरा और उसकी क़ुदरत के जलाल से दूर हो कर हमेशा हलाकत की सज़ा पाएँगे <verse eid="2TH 1:9"/><verse number="10" style="v" sid="2TH 1:10"/>ये उस दिन होगा जबकि वो अपने मुक़द्दसों में जलाल पाने और सब ईमान लाने वालों की वजह से ता'अज्जुब का बाइस होने के लिए आएगा; क्यूँकि तुम हमारी गवाही पर ईमान लाए।<verse eid="2TH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11"/>इसी वास्ते हम तुम्हारे लिए हर वक़्त दुआ भी करते रहते हैं कि हमारा ख़ुदा तुम्हें इस बुलावे के लायक़ जाने और नेकी की हर एक ख़्वाहिश और ईमान के हर एक काम को क़ुदरत से पूरा करे। <verse eid="2TH 1:11"/><verse number="12" style="v" sid="2TH 1:12"/>ताकि हमारे ख़ुदा और ख़ुदावन्द 'ईसा मसीह के फ़ज़ल के मुवाफ़िक़ हमारे ख़ुदावन्द 'ईसा का नाम तुम में जलाल पाए और तुम उस में।<verse eid="2TH 1:12"/></para>
  <chapter eid="2TH 1"/>
  <chapter number="2" style="c" sid="2TH 2"/>
  <para style="s">खु़दावन्द के आने से पहले होने वाली बातें</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1"/>ऐ भाइयों! हम अपने ख़ुदा वन्द ईसा मसीह के आने और उस के पास जमा होने के बारे में तुम से दरख़्वास्त करते हैं। <verse eid="2TH 2:1"/><verse number="2" style="v" sid="2TH 2:2"/>कि किसी रूह या कलाम या ख़त से जो गोया हमारी तरफ़ से हो ये समझ कर कि ख़ुदावन्द के वापस आने का दिन आ पहुँचा है तुम्हारी अक़्ल अचानक परेशान न हो जाए और न तुम घबराओ।<verse eid="2TH 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 2:3"/>किसी तरह से किसी के धोखे में न आना क्यूँकि वो दिन नहीं आएगा जब तक कि पहले बरगश्तगी न हो और वो गुनाह का शख़्स या'नी हलाकत का फ़र्ज़न्द ज़ाहिर न हो। <verse eid="2TH 2:3"/><verse number="4" style="v" sid="2TH 2:4"/>जो मुख़ालिफ़त करता है और हर एक से जो ख़ुदा या मा'बूद कहलाता है अपने आप को बड़ा ठहराता है; यहाँ तक कि वो ख़ुदा के मक़्दिस में बैठ कर अपने आप को ख़ुदा ज़ाहिर करता है।<verse eid="2TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5"/>क्या तुम्हें याद नहीं कि जब मैं तुम्हारे पास था तो तुम से ये बातें कहा करता था? <verse eid="2TH 2:5"/><verse number="6" style="v" sid="2TH 2:6"/>अब जो चीज़ उसे रोक रही है ताकि वो अपने ख़ास वक़्त पर ज़ाहिर हो उस को तुम जानते हो। <verse eid="2TH 2:6"/><verse number="7" style="v" sid="2TH 2:7"/>क्यूँकी बेदीनी का राज़ तो अब भी तासीर करता जाता है मगर अब एक रोकने वाला है और जब तक कि वो दूर न किया जाए रोके रहेगा।<verse eid="2TH 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TH 2:8"/>उस वक़्त वो बेदीन ज़ाहिर होगा, जिसे ख़ुदावन्द येसू अपने मुँह की फूँक से हलाक और अपनी आमद के जलाल से मिटा देगा। <verse eid="2TH 2:8"/><verse number="9" style="v" sid="2TH 2:9"/>और जिसकी आमद शैतान की तासीर के मुवाफ़िक़ हर तरह की झूठी क़ुदरत और निशानों और अजीब कामों के साथ, <verse eid="2TH 2:9"/><verse number="10" style="v" sid="2TH 2:10"/>और हलाक होने वालों के लिए नारास्ती के हर तरह के धोखे के साथ होगी इस वास्ते कि उन्हों ने हक़ की मुहब्बत को इख़्तियार न किया जिससे उनकी नजात होती।<verse eid="2TH 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 2:11"/>इसी वजह से ख़ुदा उन के पास गुमराह करने वाली तासीर भेजेगा ताकि वो झूठ को सच जानें। <verse eid="2TH 2:11"/><verse number="12" style="v" sid="2TH 2:12"/>और जितने लोग हक़ का यक़ीन नहीं करते बल्कि नारास्ती को पसन्द करते हैं; वो सज़ा पाएँगे।<verse eid="2TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13"/>लेकिन तुम्हारे बारे में ऐ भाइयों! ख़ुदावन्द के प्यारों हर वक़्त ख़ुदा का शुक्र करना हम पर फ़र्ज़ है क्यूँकि ख़ुदा ने तुम्हें शुरू से ही इसलिए चुन लिया था कि रूह के ज़रिए से पाकीज़ा बन कर और हक़ पर ईमान लाकर नजात पाओ। <verse eid="2TH 2:13"/><verse number="14" style="v" sid="2TH 2:14"/>जिस के लिए उस ने तुम्हें हमारी ख़ुशख़बरी के वसीले से बुलाया ताकि तुम हमारे ख़ुदा वन्द 'ईसा मसीह का जलाल हासिल करो। <verse eid="2TH 2:14"/><verse number="15" style="v" sid="2TH 2:15"/>पस ऐ भाइयों! साबित क़दम रहो, और जिन रवायतों की तुम ने हमारी ज़बानी या ख़त के ज़रिए से ता'लीम पाई है उन पर क़ाईम रहो।<verse eid="2TH 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16"/>अब हमारा ख़ुदावन्द 'ईसा मसीह ख़ुद और हमारा बाप ख़ुदा जिसने हम से मुहब्बत रखी और फ़ज़ल से हमेशा तसल्ली और अच्छी उम्मीद बख़्शी <verse eid="2TH 2:16"/><verse number="17" style="v" sid="2TH 2:17"/>तुम्हारे दिलों को तसल्ली दे और हर एक नेक काम और कलाम में मज़बूत करे।<verse eid="2TH 2:17"/></para>
  <chapter eid="2TH 2"/>
  <chapter number="3" style="c" sid="2TH 3"/>
  <para style="s">पौलुस की दु'आ करने के लिये दरख़्वास्त</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1"/>ग़रज़ ऐ भाइयों और बहनों! हमारे हक़ में दुआ करो कि ख़ुदावन्द का कलाम जल्द ऐसा फैल जाए और जलाल पाए; जैसा तुम में। <verse eid="2TH 3:1"/><verse number="2" style="v" sid="2TH 3:2"/>और कजरौ और बुरे आदमियों से बचे रहें क्यूँकि सब में ईमान नहीं। <verse eid="2TH 3:2"/><verse number="3" style="v" sid="2TH 3:3"/>मगर ख़ुदावन्द सच्चा है वो तुम को मज़बूत करेगा; और उस शरीर से महफ़ूज़ रख्खेगा।<verse eid="2TH 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2TH 3:4"/>और ख़ुदावन्द में हमें तुम पर भरोसा है; कि जो हुक्म हम तुम्हें देते हैं उस पर अमल करते हो और करते भी रहोगे। <verse eid="2TH 3:4"/><verse number="5" style="v" sid="2TH 3:5"/>ख़ुदावन्द तुम्हारे दिलों को ख़ुदा की मुहब्बत और मसीह के सब्र की तरफ़ हिदायत करे।<verse eid="2TH 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6"/>ऐ भाइयों! हम अपने ख़ुदावन्द 'ईसा मसीह के नाम से तुम्हें हुक्म देते हैं कि हर एक ऐसे भाई से किनारा करो जो बे क़ाइदा चलता है और उस रिवायत पर अमल नहीं करता जो उस को हमारी तरफ़ से पहुँची। <verse eid="2TH 3:6"/><verse number="7" style="v" sid="2TH 3:7"/>क्यूँकि आप जानते हो कि हमारी तरह किस तरह बनना चाहिए इसलिए कि हम तुम में बे क़ाइदा न चलते थे। <verse eid="2TH 3:7"/><verse number="8" style="v" sid="2TH 3:8"/>और किसी की रोटी मुफ़्त न खाते थे, बल्कि मेहनत और मशक़्क़त से रात दिन काम करते थे ताकि तुम में से किसी पर बोझ न डालें। <verse eid="2TH 3:8"/><verse number="9" style="v" sid="2TH 3:9"/>इसलिए नहीं कि हम को इख़्तियार न था बल्कि इसलिए कि अपने आपको तुम्हारे वास्ते नमूना ठहराएँ ताकि तुम हमारी तरह बनो<verse eid="2TH 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2TH 3:10"/>और जब हम तुम्हारे पास थे उस वक़्त भी तुम को ये हुक्म देते थे; कि जिसे मेहनत करना मन्ज़ूर न हो वो खाने भी न पाए। <verse eid="2TH 3:10"/><verse number="11" style="v" sid="2TH 3:11"/>हम सुनते हैं कि तुम में कुछ बेक़ाइदा चलते हैं और कुछ काम नहीं करते; बल्कि औरों के काम में दख़ल अंदाज़ी करते हैं। <verse eid="2TH 3:11"/><verse number="12" style="v" sid="2TH 3:12"/>ऐसे शख़्सों को हम ख़ुदावन्द 'ईसा मसीह में हुक्म देते और सलाह देते हैं कि चुप चाप काम कर के अपनी ही रोटी खाएँ।<verse eid="2TH 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13"/>और तुम ऐ भाइयों! नेक काम करने में हिम्मत न हारो। <verse eid="2TH 3:13"/><verse number="14" style="v" sid="2TH 3:14"/>और अगर कोई हमारे इस ख़त की बात को न मानें तो उसे निगाह में रख्खो और उस से त'अल्लुक़ न रख्खो ताकि वो शर्मिन्दा हो। <verse eid="2TH 3:14"/><verse number="15" style="v" sid="2TH 3:15"/>लेकिन उसे दुश्मन न जानो बल्कि भाई समझ कर नसीहत करो।<verse eid="2TH 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16"/>अब ख़ुदावन्द जो इत्मीनान का चश्मा है आप ही तुम को हमेशा और हर तरह से इत्मीनान बख़्शे; ख़ुदावन्द तुम सब के साथ रहे। <verse eid="2TH 3:16"/><verse number="17" style="v" sid="2TH 3:17"/>मैं, पौलुस अपने हाथ से सलाम लिखता हूँ; हर ख़त में मेरा यही निशान है; मैं इसी तरह लिखता हूँ। <verse eid="2TH 3:17"/><verse number="18" style="v" sid="2TH 3:18"/>हमारे ख़ुदावन्द 'ईसा मसीह का फ़ज़ल तुम सब पर होता रहे।<verse eid="2TH 3:18"/></para>
  <chapter eid="2TH 3"/>
</usx>
