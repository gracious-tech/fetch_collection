<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAB" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">हबक़्क़ूक़</para>
  <para style="toc1">हबक़्क़ूक़</para>
  <para style="toc2">हबक़्</para>
  <para style="toc3">हबक़्</para>
  <para style="mt">हबक़्क़ूक़</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">1 हबक़्क़ूक़ 1:1 हबक़्क़ूक़ की किताब क्ज्ञै हबक़्क़ूक़ नबी की तरफ़ से एक इल्हाम — ए — रब्बानी का वसीला मानते हैं। उस के नाम के अलावा बुनियादी तौर से हम हबक़्क़ूक़ की बाबत कुछ नहीं जानते। हक़ीक़त यह है कि “हबक़्क़ूक़ नबी” कहलाया जाता है यह अलफ़ाज़ ही राये ज़नी पेश करता है कि वह इस से मुता‘लिक़ एक जाना पहचाना था इसे से ज़्यादा और पहचान की ज़रूरत नहीं है।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इस किताब की तस्नीफ़ की तारीख़ 612 - 605 क़ब्ल मसीह के बीच है।</para>
  <para style="ip">हबक़्क़ूक़ ने इस किताब को हो सकता है यहूदा के जुनूबी सलतनत के ज़वाल के कुछ ही अर्सों पहले लिखा हो।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">यहूदा के लोग (जुनूबी सल्तनत) और एक आम ख़त बतौर और ख़ुदा के लोगों के लिए जो हर जगह पाए जाते हैं।</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">हबक़्क़ूक़ इस बात से ता‘ज्जुब कर रहा था कि ख़ुदा अपने लोगों को मौजूदा मुसीबतों और तकलीफ़ों से गुज़रने देता है। ख़ुदा जवाब देता है और हबक़्क़ूक़ का ईमान बहाल होता है। किताब के लिखे जाने का मक़्सद है कि उसे यह मनादी करना है कि यहवे अपने लोगों का मुहाफ़िज़ है। और वह उन्हें सहारा देगा और संभाले रहेगा बशरतेके वह उस पर कामिल भरोसा करें। ख़ुदा जो यहूदा का एक आ‘ला जंगजू सिपाही होने के नाते वह एक दिन नारास्त बाबुल के लोगों का इंसाफ़ करेगा। हबक़्क़ूक़ की किताब एक घमण्डी लोगों के हलीम किए जाने की एक तस्वीर पेश करती है और वह यह भी कहता है कि रास्तबाज़ ईमान से ज़िन्दा रहेगा (हबक़्क़ूक़ 2:4)।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">क़ादिर — ए — मुतलक़ ख़ुदा पर भरोसा करना।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. हबक़्क़ूक़ की शिकायतें — 1:1-2:20</para>
  <para style="io1">2. हबक़्क़ूक़ की दुआ — 3:1-19</para>
  <chapter number="1" style="c" sid="HAB 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1"/>हबक़्क़ूक़क़ नबी के ख़्वाब की नबुव्वत के बारे में:<verse eid="HAB 1:1"/></para>
  <para style="s">हबक़्क़ूक़क़ की शिकायत</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 1:2"/>ऐ ख़ुदावन्द, मैं कब तक फ़रियाद करूँगा, और तू न सुनेगा? मैं तेरे सामने कब तक चिल्लाऊँगा “ज़ुल्म”, “ज़ुल्म” और तू न बचाएगा? <verse eid="HAB 1:2"/><verse number="3" style="v" sid="HAB 1:3"/>तू क्यूँ मुझे बद किरदारी और टेढ़ी रविश दिखाता है? क्यूँकि ज़ुल्म और सितम मेरे सामने हैं फ़ितना — ओ — फ़साद खड़े होते रहते हैं। <verse eid="HAB 1:3"/><verse number="4" style="v" sid="HAB 1:4"/>इसलिए शरी'अत कमज़ोर हो गई, और इन्साफ़ मुतलक़ जारी नहीं होता। क्यूँकि शरीर सादिक़ो को घेर लेते हैं; इसलिए इन्साफ़ का खू़न हो रहा है।<verse eid="HAB 1:4"/></para>
  <para style="s">ख़ुदा का जवाब</para>
  <para style="p">
    <verse number="5" style="v" sid="HAB 1:5"/>क़ौमों पर नज़र करो, और देखो; और हैरान हो; क्यूँकि मैं तुम्हारे दिनों में एक ऐसा काम करने को हूँ कि अगर कोई तुम से उसका बयान करे तो तुम हरगिज़ उम्मीद न करोगे। <verse eid="HAB 1:5"/><verse number="6" style="v" sid="HAB 1:6"/>क्यूँकि देखो, मैं कसदियों को चढ़ालाऊँगा:वह गु़स्सावर और कम'अक़्ल क़ौम हैं, जो चौड़ी ज़मीन से होकर गुज़रते हैं, ताकि उन बस्तियों पर जो उनकी नहीं हैं, क़ब्ज़ा कर लें। <verse eid="HAB 1:6"/><verse number="7" style="v" sid="HAB 1:7"/>वह डरावने और ख़ौफ़नाक हैं: वह खु़द ही अपनी 'अदालत और शान का मसदर हैं। <verse eid="HAB 1:7"/><verse number="8" style="v" sid="HAB 1:8"/>उनके घोड़े चीतों से भी तेज़ रफ़्तार, और शाम को निकलने वाले भेड़ियों से ज़्यादा खू़ँख़्वार हैं; और उनके सवार कूदते फाँदते आते हैं। हाँ, वह दूर से चले आते हैं, वह उक़ाब की तरह हैं, जो अपने शिकार पर झपटता है। <verse eid="HAB 1:8"/><verse number="9" style="v" sid="HAB 1:9"/>वह सब ग़ारतगरी को आते हैं, वह सीधे बढ़े चले आते हैं; और उनके गु़लाम रेत के ज़र्रों की तरह बेशुमार होते हैं। <verse eid="HAB 1:9"/><verse number="10" style="v" sid="HAB 1:10"/>वह बादशाहों को ठठ्ठों में उड़ाते, और 'उमरा को मसख़रा बनाते हैं। वह क़िलों' को हक़ीर जानते हैं, क्यूँकि वह मिट्टी से दमदमें बाँधकर उनको फ़तह कर लेते हैं। <verse eid="HAB 1:10"/><verse number="11" style="v" sid="HAB 1:11"/>तब वह हवा के झोंके की तरह गुज़रते और ख़ता करके गुनहगार होते हैं, क्यूँकि उनका ज़ोर ही उनका ख़ुदा है। <verse eid="HAB 1:11"/><verse number="12" style="v" sid="HAB 1:12"/>ऐ ख़ुदावन्द मेरे ख़ुदा, ऐ मेरे कु़द्दूस, क्या तू अज़ल से नहीं है? हम नहीं मरेंगे। ऐ ख़ुदावन्द, तूने उनको 'अदालत के लिए ठहराया है, और ऐ चट्टान, तू ने उनको तादीब के लिए मुक़र्रर किया है। <verse eid="HAB 1:12"/><verse number="13" style="v" sid="HAB 1:13"/>तेरी आँखें ऐसी पाक हैं कि तू गुनाह को देख नहीं सकता, और टेढ़ी रविश पर निगाह नहीं कर सकता। फिर तू दग़ाबाज़ों पर क्यूँ नज़र करता है, और जब शरीर अपने से ज़्यादा सादिक़ को निगल जाता है, तब तू क्यूँ ख़ामोश रहता है? <verse eid="HAB 1:13"/><verse number="14" style="v" sid="HAB 1:14"/>और बनी आदम को समन्दर की मछलियों, और कीड़े — मकौड़ों की तरह बनाता है जिन पर कोई हुकूमत करने वाला नहीं? <verse eid="HAB 1:14"/><verse number="15" style="v" sid="HAB 1:15"/>वह उन सब को शस्त से उठा लेते हैं, और अपने जाल में फँसाते हैं; और महाजाल में जमा' करते हैं, इसलिए वह शादमान और ख़ुश वक़्त हैं। <verse eid="HAB 1:15"/><verse number="16" style="v" sid="HAB 1:16"/>इसीलिए वह अपने जाल के आगे क़ुर्बानी अदा करते हैं और अपने बड़े जाल के आगे ख़ुश्बू जलाते हैं, क्यूँकि इनके वसीले से उनका हिस्सा लज़ीज़, और उनकी ग़िज़ा चिकनी है। <verse eid="HAB 1:16"/><verse number="17" style="v" sid="HAB 1:17"/>इसलिए क्या वह अपने जाल को ख़ाली करने और क़ौमों को बराबर क़त्ल करने से बाज़ न आएँगे?<verse eid="HAB 1:17"/></para>
  <chapter eid="HAB 1"/>
  <chapter number="2" style="c" sid="HAB 2"/>
  <para style="p">
    <verse number="1" style="v" sid="HAB 2:1"/>और मैं अपनी दीदगाह पर खड़ा रहूँगा और बुर्ज पर चढ़कर इन्तिज़ार करूँगा कि वह मुझ से क्या कहता है, और मैं अपनी फ़रियाद के बारे में क्या जवाब दूँ।<verse eid="HAB 2:1"/></para>
  <para style="s">ख़ुदा का दुसरा जवाब</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2"/>तब ख़ुदावन्द ने मुझे जवाब दिया और फ़रमाया कि “ख्व़ाब को तख़्तियों पर ऐसी सफ़ाई से लिख कि लोग दौड़ते हुए भी पढ़ सकें। <verse eid="HAB 2:2"/><verse number="3" style="v" sid="HAB 2:3"/>क्यूँकि ये ख़्वाब एक मुक़र्ररा वक़्त के लिए है; ये जल्द ज़हूर में आएगा और ख़ता न करेगा। अगरचे इसमें देर हो, तोभी इसके इन्तिज़ार में रह, क्यूँकि ये यक़ीनन नाज़िल होगा, देर न करेगा। <verse eid="HAB 2:3"/><verse number="4" style="v" sid="HAB 2:4"/>देख, घमण्डी आदमी का दिल रास्त नहीं है, लेकिन सच्चा अपने ईमान से ज़िन्दा रहेगा। <verse eid="HAB 2:4"/><verse number="5" style="v" sid="HAB 2:5"/>बेशक, घमण्डी आदमी शराब की तरह दग़ाबाज़ है, वह अपने घर में नहीं रहता। वह पाताल की तरह अपनी ख़्वाहिश बढ़ाता है; वह मौत की तरह है, कभी आसूदा नहीं होता; बल्कि सब क़ौमों को अपने पास जमा' करता है, और सब उम्मतों को अपने नज़दीक इकठ्ठा करता है।” <verse eid="HAB 2:5"/><verse number="6" style="v" sid="HAB 2:6"/>क्या ये सब उस पर मिसाल न लाएँगे, और तनज़न न कहेंगे कि “उस पर अफ़सोस, जो औरों के माल से मालदार होता है, लेकिन ये कब तक? और उस पर जो कसरत से गिरवी लेता है।” <verse eid="HAB 2:6"/><verse number="7" style="v" sid="HAB 2:7"/>क्या वह मुझे खा जाने को अचानक न उठेंगे, और तुझे परेशान करने को बेदार न होंगे, और उनके लिए लूट न होगा? <verse eid="HAB 2:7"/><verse number="8" style="v" sid="HAB 2:8"/>क्यूँकि तूने बहुत सी क़ौमों को लूट लिया, और मुल्क — ओ — शहर — ओ — बाशिंदों में खू़ँरेज़ी और सितमगरी की है, इसलिए बाक़ी माँदा लोग तुझे ग़ारत करेंगे। <verse eid="HAB 2:8"/><verse number="9" style="v" sid="HAB 2:9"/>“उस पर अफ़सोस जो अपने घराने के लिए नाजायज़ नफ़ा' उठाता है, ताकि अपना आशियाना बुलन्दी पर बनाये, और मुसीबत से महफ़ूज़ रहे। <verse eid="HAB 2:9"/><verse number="10" style="v" sid="HAB 2:10"/>तूने बहुत सी उम्मतों को बर्बाद करके अपने घराने के लिए रुसवाई हासिल की, और अपनी जान का गुनहगार हुआ। <verse eid="HAB 2:10"/><verse number="11" style="v" sid="HAB 2:11"/>क्यूँकि दीवार से पत्थर चिल्लायेंगे, और छत से शहतीर जवाब देंगे। <verse eid="HAB 2:11"/><verse number="12" style="v" sid="HAB 2:12"/>उस पर अफ़सोस, जो क़स्बे को खू़ँरेज़ी से और शहर को बादकिरदारी से ता'मीर करता है! <verse eid="HAB 2:12"/><verse number="13" style="v" sid="HAB 2:13"/>क्या यह रब्ब — उल — अफ़्वाज की तरफ़ से नहीं कि लोगों की मेहनत आग के लिए हो, और क़ौमों की मशक़्क़त बतालत के लिए हो? <verse eid="HAB 2:13"/><verse number="14" style="v" sid="HAB 2:14"/>क्यूँकि जिस तरह समन्दर पानी से भरा है, उसी तरह ज़मीन ख़ुदावन्द के जलाल के 'इल्म से मा'मूर है। <verse eid="HAB 2:14"/><verse number="15" style="v" sid="HAB 2:15"/>उस पर अफ़सोस जो अपने पड़ोसी को अपने क़हर का जाम पिलाकर मतवाला करता है, ताकि उसको बे पर्दा करे! <verse eid="HAB 2:15"/><verse number="16" style="v" sid="HAB 2:16"/>तू 'इज़्ज़त के 'इवज़ रुसवाई से भर गया है। तू भी पीकर अपनी नामख़्तूनी ज़ाहिर कर! ख़ुदावन्द के दहने हाथ का प्याला अपने दौर में तुझ तक पहुँचेगा, और रुसवाई तेरी शौकत को ढाँप लेगी। <verse eid="HAB 2:16"/><verse number="17" style="v" sid="HAB 2:17"/>चूँकि तूने मुल्क — ओ — शहर — ओ — बाशिन्दों में खूँरेज़ी और सितमगरी की है, इसलिए वह ज़ियादती जो लुबनान पर हुई और वह हलाकत जिसमें जानवर डर गए, तुझ पर आएगी। <verse eid="HAB 2:17"/><verse number="18" style="v" sid="HAB 2:18"/>खोदी हुई मूरत से क्या हासिल कि उसके बनाने वाले ने उसे खोदकर बनाया? ढली हुई मूरत और झूट सिखाने वाले से क्या फ़ायदा कि उसका बनाने वाला उस पर भरोसा रखता और गूँगे बुतों को बनाता है? <verse eid="HAB 2:18"/><verse number="19" style="v" sid="HAB 2:19"/>उस पर अफ़सोस जो लकड़ी से कहता है, जाग, और बे ज़बान पत्थर से कि उठ, क्या वह ता'लीम दे सकता है? देख वह तो सोने और चाँदी से मढ़ा है लेकिन उसमें कुछ भी ताक़त नहीं। <verse eid="HAB 2:19"/><verse number="20" style="v" sid="HAB 2:20"/>मगर ख़ुदावन्द अपनी मुक़द्दस हैकल में है; सारी ज़मीन उसके सामने ख़ामोश रहे।”<verse eid="HAB 2:20"/></para>
  <chapter eid="HAB 2"/>
  <chapter number="3" style="c" sid="HAB 3"/>
  <para style="s">हबक़्क़ूक़क़ की दुआ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1"/>शिगायूनोत के सुर पर हबक़्क़ूक़ नबी की दु'आ: <verse eid="HAB 3:1"/><verse number="2" style="v" sid="HAB 3:2"/>ऐ ख़ुदावन्द, मैंने तेरी शोहरत सुनी, और डर गया; ऐ ख़ुदावन्द, इसी ज़माने में अपने काम को पूरा कर। इसी ज़माने में उसको ज़ाहिर कर; ग़ज़ब के वक़्त रहम को याद फ़रमा। <verse eid="HAB 3:2"/><verse number="3" style="v" sid="HAB 3:3"/>ख़ुदा तेमान से आया, और कु़द्दूस फ़ारान के पहाड़ से। उसका जलाल आसमान पर छा गया, और ज़मीन उसकी ता'रीफ़ से मा'मूर हो गई। <verse eid="HAB 3:3"/><verse number="4" style="v" sid="HAB 3:4"/>उसकी जगमगाहट नूर की तरह थी, उसके हाथ से किरनें निकलती थीं, और इसमें उसकी क़ुदरत छिपी हुई थी, <verse eid="HAB 3:4"/><verse number="5" style="v" sid="HAB 3:5"/>बीमारी उसके आगे — आगे चलती थी, और आग के तीर उसके क़दमों से निकलते थे। <verse eid="HAB 3:5"/><verse number="6" style="v" sid="HAB 3:6"/>वह खड़ा हुआ और ज़मीन थर्रा गई, उसने निगाह की और क़ौमें तितर — बितर हो गईं। अज़ली पहाड़ टुकड़े — टुकड़े हो गए; पुराने टीले झुक गए, उसके रास्ते अज़ली हैं। <verse eid="HAB 3:6"/><verse number="7" style="v" sid="HAB 3:7"/>मैंने कूशन के खे़मों को मुसीबत में देखा: मुल्क — ए — मिदियान के पर्दे हिल गए। <verse eid="HAB 3:7"/><verse number="8" style="v" sid="HAB 3:8"/>ऐ ख़ुदावन्द, क्या तू नदियों से बेज़ार था? क्या तेरा ग़ज़ब दरियाओं पर था? क्या तेरा ग़ज़ब समन्दर पर था कि तू अपने घोड़ों और फ़तहयाब रथों पर सवार हुआ? <verse eid="HAB 3:8"/><verse number="9" style="v" sid="HAB 3:9"/>तेरी कमान ग़िलाफ़ से निकाली गई, तेरा 'अहद क़बाइल के साथ उस्तवार था। सिलाह, तूने ज़मीन को नदियों से चीर डाला। <verse eid="HAB 3:9"/><verse number="10" style="v" sid="HAB 3:10"/>पहाड़ तुझे देखकर काँप गए: सैलाब गुज़र गए; समन्दर से शोर उठा, और मौजें बुलन्द हुई। <verse eid="HAB 3:10"/><verse number="11" style="v" sid="HAB 3:11"/>तेरे उड़ने वाले तीरों की रोशनी से, तेरे चमकीले भाले की झलक से, चाँद — ओ — सूरज अपने बुर्जों में ठहर गए। <verse eid="HAB 3:11"/><verse number="12" style="v" sid="HAB 3:12"/>तू ग़ज़बनाक होकर मुल्क में से गुज़रा; तूने ग़ज़ब से क़ौमों को पस्त किया। <verse eid="HAB 3:12"/><verse number="13" style="v" sid="HAB 3:13"/>तू अपने लोगों की नजात की ख़ातिर निकला, हाँ, अपने मम्सूह की नजात की ख़ातिर तूने शरीर के घर की छत गिरा दी, और उसकी बुनियाद बिल्कुल खोद डाली। <verse eid="HAB 3:13"/><verse number="14" style="v" sid="HAB 3:14"/>तूने उसी की लाठी से उसके बहादुरों के सिर फोड़े; वह मुझे बिखेरने को हवा के झोके की तरह आए, वह ग़रीबों को तन्हाई में निगल जाने पर ख़ुश थे। <verse eid="HAB 3:14"/><verse number="15" style="v" sid="HAB 3:15"/>तू अपने घोड़ों पर सवार होकर समन्दर से, हाँ, बड़े सैलाब से पार हो गया। <verse eid="HAB 3:15"/><verse number="16" style="v" sid="HAB 3:16"/>मैंने सुना और मेरा दिल दहल गया, उस शोर की वजह से मेरे लब हिलने लगे; मेरी हड्डियाँ बोसीदा हो गईं, और मैं खड़े — खड़े काँपने लगा। लेकिन मैं सुकून से उनके बुरे दिन का मुन्तज़िर हूँ, जो इकट्ठा होकर हम पर हमला करते हैं। <verse eid="HAB 3:16"/><verse number="17" style="v" sid="HAB 3:17"/>अगरचे अंजीर का दरख़्त न फूले, और डाल में फल न लगें, और जै़तून का फल ज़ाय' हो जाए, और खेतों में कुछ पैदावार न हो, और भेड़ख़ाने से भेड़ें जाती रहें, और तवेलों में जानवर न हों, <verse eid="HAB 3:17"/><verse number="18" style="v" sid="HAB 3:18"/>तोभी मैं ख़ुदावन्द से ख़ुश रहूँगा, और अपनी नजात बख़्श ख़ुदा से खु़श वक़्त हूँगा। <verse eid="HAB 3:18"/><verse number="19" style="v" sid="HAB 3:19"/>ख़ुदावन्द ख़ुदा, मेरी ताक़त है; वह मेरे पैर हिरनी के से बना देता है, और मुझे मेरी ऊँची जगहों में चलाता है।<verse eid="HAB 3:19"/></para>
  <chapter eid="HAB 3"/>
</usx>
