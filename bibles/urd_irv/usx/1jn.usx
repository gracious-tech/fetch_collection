<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id"/>
  <para style="ide">UTF-8</para>
  <para style="h">1 यूहन्ना</para>
  <para style="toc1">1 यूहन्ना</para>
  <para style="toc2">1 यूह</para>
  <para style="toc3">1 यूह</para>
  <para style="mt">यूहन्ना का पहला 'आम ख़त</para>
  <para style="is">मुसन्निफ़ की पहचान</para>
  <para style="ip">यह ख़त मुसन्निफ़ की पहचान नहीं करती मगर एक मज़्बूत बा उसूल और कलीसिया की सब से पहली गवाही मन्सूब करते हैं कि इस का मुसन्निफ़ यूहन्ना रसूल और शागिर्द है। (लूक़ा 6:13, 14) हालांकि इन तीनों ख़तों में कहीं भी यूहन्ना के नाम का ज़िक्र नहीं है इस के बावजूद भी तीन मज्बूर करने वाले हुक़ूक़ सामने आते हैं जो उसके मुसन्निफ़ होने की तरफ़ इशारा करते हैं। पहला है इब्तिदाई दूसरी सदी के लिखने वाले जो यूहन्ना के मुसन्निफ़ होने का हवाला पेश करते हैं दूसरा है ख़ुतूत के फ़रहंग बिलकुल वैसी है जैसी कि यूहन्ना की इन्जील। तीसरा यह कि मुसन्निफ़ ने ख़ुद लिखा कि उसने येसू मसही को देख है और उस के जिस्म को छुआ है जो कि यक़ीन दिलाता है कि वह यूहन्ना रसूल ही है (1 यूहन्ना 1:1 — 4; 4:14)।</para>
  <para style="is">लिखे जाने की तारीख़ और जगह</para>
  <para style="ip">इस के लिखे जाने की तारीख़ तक़रीबन 85 - 95 के बीच है।</para>
  <para style="ip">इस ख़त को यूहन्ना ने इफ़सस में रहते हुए लिखा जहां वह अपनी बुढ़ापे की ज़िन्दगी गुज़ार रहा था।</para>
  <para style="is">क़बूल कुनिन्दा पाने वाले</para>
  <para style="ip">1 यूहन्ना के सामईन की बाबत ख़ास तौर से ख़त में कोई इशारा नहीं किया गया है। किसी तरह इस ख़त के मज़्मून इशारा करते हैं कि यूहन्ना ने यह ख़त मसीही ईमान्दारों को लिखा है (1 यूहन्ना 1:3 — 4; 2:12 — 14) यह मुमकिन है कि उसने कई एक इलाक़ों में रहने वाले ख़ुदा रसीदा लोगों को लिखा हो। आम तौर से तमाम मसीहियों के लिए जो हर जगह पाये जाते हैं, 2:1, “मेरे छोटे बच्चों।”</para>
  <para style="is">असल मक़सूद</para>
  <para style="ip">यूहन्ना ने यह ख़त रिफ़ाक़त को बढ़ाने और उस की तक़वियत के लिए लिखा ताकि हम ख़ुशी से भर जाएं, और हम गुनाहों से बाज़ रहें, हमें नजात का यक़ीन दिलाने के लिए और ईमान्दार को मसीह के साथ एक शख़्सी रिफ़ाक़त में लाने के लिए। यूहन्ना ख़ास तौर से झूटे उस्तादों का मुद्दा उठाता हैं जो कलीसिया से अलग हो चुके थे और लोगों को इन्जील की सच्चाई से गुमराह करने की कोशिश कर रहे थे।</para>
  <para style="is">मौज़’अ</para>
  <para style="ip">ख़ुदा के साथ रिफ़ाक़त।</para>
  <para style="iot">बैरूनी ख़ाका</para>
  <para style="io1">1. तजस्सुसम की हकीक़त — 1:1-4</para>
  <para style="io1">2. रिफ़ाक़त — 1:5-2:17</para>
  <para style="io1">3. फ़रेब की पहचान — 2:18-27</para>
  <para style="io1">4. पाकीज़ा ज़िन्दगी के लिए ज़माना — ए — हाल में तहरीक किया जाना — 2:28-3:10</para>
  <para style="io1">5. मुहब्बत यक़ीन के लिए बुनियाद बतौर — 3:11-24</para>
  <para style="io1">6. बुरी रूह की बसीरत — 4:1-6</para>
  <para style="io1">7. मख़्सूसियत के लिए ज़रूरी बातें — 4:7-5:21</para>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="s">तारूफ़</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>उस ज़िन्दगी के कलाम के बारे में जो शुरू से था, और जिसे हम ने सुना और अपनी आँखों से देखा बल्कि, ग़ौर से देखा और अपने हाथों से छुआ। <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/>[ये ज़िन्दगी ज़ाहिर हुई और हम ने देखा और उसकी गवाही देते हैं, और इस हमेशा की ज़िन्दगी की तुम्हें ख़बर देते हैं जो बाप के साथ थी और हम पर ज़ाहिर हुई है]।<verse eid="1JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 1:3"/>जो कुछ हम ने देखा और सुना है तुम्हें भी उसकी ख़बर देते है, ताकि तुम भी हमारे शरीक हो, और हमारा मेल मिलाप बाप के साथ और उसके बेटे ईसा मसीह के साथ है। <verse eid="1JN 1:3"/><verse number="4" style="v" sid="1JN 1:4"/>और ये बातें हम इसलिए लिखते है कि हमारी ख़ुशी पूरी हो जाए।<verse eid="1JN 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>उससे सुन कर जो पैग़ाम हम तुम्हें देते हैं, वो ये है कि ख़ुदा नूर है और उसमें ज़रा भी तारीकी नहीं। <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>अगर हम कहें कि हमारा उसके साथ मेल मिलाप है और फिर तारीकी में चलें, तो हम झूठे हैं और हक़ पर 'अमल नहीं करते। <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>लेकिन जब हम नूर में चलें जिस तरह कि वो नूर में हैं, तो हमारा आपस में मेल मिलाप है, और उसके बेटे ईसा का ख़ून हमें तमाम गुनाह से पाक करता है।<verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>अगर हम कहें कि हम बेगुनाह हैं तो अपने आपको धोखा देते हैं, और हम में सच्चाई नहीं। <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>अगर अपने गुनाहों का इक़रार करें, तो वो हमारे गुनाहों को मु'आफ़ करने और हमें सारी नारास्ती से पाक करने में सच्चा और 'आदिल है। <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>अगर कहें कि हम ने गुनाह नहीं किया, तो उसे झूठा ठहराते हैं और उसका कलाम हम में नहीं है।<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>ऐ मेरे बच्चों! ये बातें मैं तुम्हें इसलिए लिखता हूँ तुम गुनाह न करो; और अगर कोई गुनाह करे, तो बाप के पास हमारा एक मददगार मौजूद है, या'नी ईसा मसीह रास्तबाज़; <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>और वही हमारे गुनाहों का कफ़्फ़ारा है, और न सिर्फ़ हमारे ही गुनाहों का बल्कि तमाम दुनिया के गुनाहों का भी।<verse eid="1JN 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3"/>अगर हम उसके हुक्मों पर 'अमल करेंगे, तो इससे हमें माँ'लूम होगा कि हम उसे जान गए हैं।<verse eid="1JN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 2:4"/>जो कोई ये कहता है, मैं उसे जान गया हूँ “और उसके हुक्मों पर” अमल नहीं करता, वो झूठा है और उसमें सच्चाई नहीं। <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>हाँ, जो कोई उसके कलाम पर 'अमल करे, उसमें यक़ीनन ख़ुदा की मुहब्बत कामिल हो गई है। हमें इसी से मा'लूम होता है कि हम उसमें हैं: <verse eid="1JN 2:5"/><verse number="6" style="v" sid="1JN 2:6"/>जो कोई ये कहता है कि मैं उसमें क़ाईम हूँ, तो चाहिए कि ये भी उसी तरह चले जिस तरह वो चलता था।<verse eid="1JN 2:6"/></para>
  <para style="s">एक नया अहद</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7"/>ऐ 'अज़ीज़ो! मैं तुम्हें कोई नया हुक्म नहीं लिखता, बल्कि वही पुराना हुक्म जो शुरू से तुम्हें मिला है; ये पुराना हुक्म वही कलाम है जो तुम ने सुना है। <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>फिर तुम्हें एक नया हुक्म लिखता हूँ, ये बात उस पर और तुम पर सच्ची आती है; क्यूँकि तारीकी मिटती जाती है और हक़ीक़ी नूर चमकना शुरू हो गया है।<verse eid="1JN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9"/>जो कोई ये कहता है कि मैं नूर में हूँ और अपने भाई से 'दुश्मनी रखता है, वो अभी तक अंधेरे ही मैं है। <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/>जो कोई अपने भाई से मुहब्बत रखता है वो नूर में रहता है और ठोकर नहीं खाता। <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>लेकिन जो अपने भाई से 'दुश्मनी रखता है वो अंधेरे में है और अंधेरे ही में चलता है, और ये नहीं जानता कि कहाँ जाता है क्यूँकि अंधेरे ने उसकी आँखें अन्धी कर दी हैं।<verse eid="1JN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12"/>ऐ बच्चो! मैं तुम्हें इसलिए लिखता हूँ कि उसके नाम से तुम्हारे गुनाह मु'आफ़ हुए। <verse eid="1JN 2:12"/><verse number="13" style="v" sid="1JN 2:13"/>ऐ बुज़ुर्गो! मैं तुम्हें इसलिए लिखता हूँ कि जो इब्तिदा से है उसे तुम जान गए हो। ऐ जवानो! मैं तुम्हें इसलिए लिखता हूँ कि तुम उस शैतान पर ग़ालिब आ गए हो। ऐ लड़कों! मैंने तुम्हें इसलिए लिखा है कि तुम बाप को जान गए हो <verse eid="1JN 2:13"/><verse number="14" style="v" sid="1JN 2:14"/>ऐ बुज़ुर्गों! मैंने तुम्हें इसलिए लिखा है कि जो शुरू से है उसको तुम जान गए हो। ऐ जवानो! मैंने तुम्हें इसलिए लिखा है कि तुम मज़बूत हो, उसे ख़ुदा का कलाम तुम में क़ाईम रहता है, और तुम उस शैतान पर ग़ालिब आ गए हो।<verse eid="1JN 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>न दुनिया से मुहब्बत रख्खो, न उन चीज़ों से जो दुनियाँ में हैं। जो कोई दुनिया से मुहब्बत रखता है, उसमें बाप की मुहब्बत नहीं। <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>क्यूँकि जो कुछ दुनिया में है, या'नी जिस्म की ख़्वाहिश और आँखों की ख़्वाहिश और ज़िन्दगी की शेख़ी, वो बाप की तरफ़ से नहीं बल्कि दुनिया की तरफ़ से है। <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>दुनियाँ और उसकी ख़्वाहिश दोनों मिटती जाती है, लेकिन जो ख़ुदा की मर्ज़ी पर चलता है वो हमेशा तक क़ाईम रहेगा।<verse eid="1JN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>ऐ लड़कों! ये आख़िरी वक़्त है; जैसा तुम ने सुना है कि मुख़ालिफ़ — ए — मसीह आनेवाला है, उसके मुवाफ़िक़ अब भी बहुत से मुख़ालिफ़ — ए — मसीह पैदा हो गए है। इससे हम जानते हैं ये आख़िरी वक़्त है <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>वो निकले तो हम ही में से, मगर हम में से थे नहीं। इसलिए कि अगर हम में से होते तो हमारे साथ रहते, लेकिन निकल इस लिए गए कि ये ज़ाहिर हो कि वो सब हम में से नहीं हैं।<verse eid="1JN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20"/>और तुम को तो उस क़ुद्दूस की तरफ़ से मसह किया गया है, और तुम सब कुछ जानते हो। <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>मैंने तुम्हें इसलिए नहीं लिखा कि तुम सच्चाई को नहीं जानते, बल्कि इसलिए कि तुम उसे जानते हो, और इसलिए कि कोई झूठ सच्चाई की तरफ़ से नहीं है।<verse eid="1JN 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22"/>कौन झूठा है? सिवा उसके जो ईसा के मसीह होने का इन्कार करता है। मुख़ालिफ़ — ए — मसीह वही है जो बाप और बेटे का इन्कार करता है। <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>जो कोई बेटे का इन्कार करता है उसके पास बाप भी नहीं: जो बेटे का इक़रार करता है उसके पास बाप भी है।<verse eid="1JN 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24"/>जो तुम ने शुरू'से सुना है अगर वो तुम में क़ाईम रहे, तो तुम भी बेटे और बाप में क़ाईम रहोगे।<verse eid="1JN 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1JN 2:25"/>और जिसका उसने हम से वा'दा किया, वो हमेशा की ज़िन्दगी है। <verse eid="1JN 2:25"/><verse number="26" style="v" sid="1JN 2:26"/>मैंने ये बातें तुम्हें उनके बारे में लिखी हैं, जो तुम्हें धोखा देते हैं;<verse eid="1JN 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1JN 2:27"/>और तुम्हारा वो मसह जो उसकी तरफ़ से किया गया, तुम में क़ाईम रहता है; और तुम इसके मोहताज नहीं कि कोई तुम्हें सिखाए, बल्कि जिस तरह वो मसह जो उसकी तरफ़ से किया गया, तुम्हें सब बातें सिखाता है और सच्चा है और झूठा नहीं; और जिस तरह उसने तुम्हें सिखाया उसी तरह तुम उसमें क़ाईम रहते हो।<verse eid="1JN 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>ग़रज़ ऐ बच्चो! उसमें क़ाईम रहो, ताकि जब वो ज़ाहिर हो तो हमें दिलेरी हो और हम उसके आने पर उसके सामने शर्मिन्दा न हों। <verse eid="1JN 2:28"/><verse number="29" style="v" sid="1JN 2:29"/>अगर तुम जानते हो कि वो रास्तबाज़ है, तो ये भी जानते हो कि जो कोई रास्तबाज़ी के काम करता है वो उससे पैदा हुआ है।<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>देखो, बाप ने हम से कैसी मुहब्बत की है कि हम ख़ुदा के फ़र्ज़न्द कहलाए, और हम है भी। दुनिया हमें इसलिए नहीं जानती कि उसने उसे भी नहीं जाना। <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>'अज़ीज़ो! हम इस वक़्त ख़ुदा के फ़र्ज़न्द हैं, और अभी तक ये ज़ाहिर नहीं हुआ कि हम क्या कुछ होंगे! इतना जानते हैं कि जब वो ज़ाहिर होगा तो हम भी उसकी तरह होंगे, क्यूँकि उसको वैसा ही देखेंगे जैसा वो है। <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>और जो कोई उससे ये उम्मीद रखता है, अपने आपको वैसा ही पाक करता है जैसा वो पाक है।<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>जो कोई गुनाह करता है, वो शरी'अत की मुख़ालिफ़त करता है; और गुनाह शरी'अत' की मुख़ालिफ़त ही है। <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/>और तुम जानते हो कि वो इसलिए ज़ाहिर हुआ था कि गुनाहों को उठा ले जाए, और उसकी ज़ात में गुनाह नहीं। <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>जो कोई उसमें क़ाईम रहता है वो गुनाह नहीं करता; जो कोई गुनाह करता है, न उसने उसे देखा है और न जाना है।<verse eid="1JN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7"/>ऐ बच्चो! किसी के धोखे में न आना। जो रास्तबाज़ी के काम करता है, वही उसकी तरह रास्तबाज़ है। <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>जो शख़्स गुनाह करता है वो शैतान से है, क्यूँकि शैतान शुरू' ही से गुनाह करता रहा है। ख़ुदा का बेटा इसलिए ज़ाहिर हुआ था कि शैतान के कामों को मिटाए।<verse eid="1JN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9"/>जो कोई ख़ुदा से पैदा हुआ है वो गुनाह नहीं करता, क्यूँकि उसका बीज उसमें बना रहता है; बल्कि वो गुनाह कर ही नहीं सकता क्यूँकि ख़ुदा से पैदा हुआ है। <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>इसी से ख़ुदा के फ़र्ज़न्द और शैतान के फ़र्ज़न्द ज़ाहिर होते है। जो कोई रास्तबाज़ी के काम नहीं करता वो ख़ुदा से नहीं, और वो भी नहीं जो अपने भाई से मुहब्बत नहीं रखता।<verse eid="1JN 3:10"/></para>
  <para style="s">एक दुसरे से मुहब्बत रखो</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>क्यूँकि जो पैग़ाम तुम ने शुरू' से सुना वो ये है कि हम एक दूसरे से मुहब्बत रख्खें। <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>और क़ाइन की तरह न बनें जो उस शरीर से था, और जिसने अपने भाई को क़त्ल किया; और उसने किस वास्ते उसे क़त्ल किया? इस वास्ते कि उसके काम बुरे थे, और उसके भाई के काम रास्ती के थे।<verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>ऐ भाइयों! अगर दुनिया तुम से 'दुश्मनी रखती है तो ताअ'ज्जुब न करो। <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/>हम तो जानते हैं कि मौत से निकलकर ज़िन्दगी में दाख़िल हो गए, क्यूँकि हम भाइयों से मुहब्बत रखते हैं। जो मुहब्बत नहीं रखता वो मौत की हालत में रहता है। <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>जो कोई अपने भाई से 'दुश्मनी रखता है, वो ख़ूनी है और तुम जानते हो कि किसी ख़ूनी में हमेशा की ज़िन्दगी मौजूद नहीं रहती।<verse eid="1JN 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 3:16"/>हम ने मुहब्बत को इसी से जाना है कि उसने हमारे वास्ते अपनी जान दे दी, और हम पर भी भाइयों के वास्ते जान देना फ़र्ज़ है। <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>जिस किसी के पास दुनिया का माल हो और वो अपने भाई को मोहताज देखकर रहम करने में देर करे, तो उसमें ख़ुदा की मुहब्बत क्यूँकर क़ाईम रह सकती है? <verse eid="1JN 3:17"/><verse number="18" style="v" sid="1JN 3:18"/>ऐ बच्चो! हम कलाम और ज़बान ही से नहीं, बल्कि काम और सच्चाई के ज़रिए से भी मुहब्बत करें।<verse eid="1JN 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19"/>इससे हम जानेगे कि हक़ के हैं, और जिस बात में हमारा दिल हमें इल्ज़ाम देगा, उसके बारे में हम उसके हुज़ूर अपनी दिलजम'ई करेंगे; <verse eid="1JN 3:19"/><verse number="20" style="v" sid="1JN 3:20"/>क्यूँकि ख़ुदा हमारे दिल से बड़ा है और सब कुछ जानता है। <verse eid="1JN 3:20"/><verse number="21" style="v" sid="1JN 3:21"/>ऐ 'अज़ीज़ो! जब हमारा दिल हमें इल्ज़ाम नहीं देता, तो हमें ख़ुदा के सामने दिलेरी हो जाती है; <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>और जो कुछ हम माँगते हैं वो हमें उसकी तरफ़ से मिलता है, क्यूँकि हम उसके हुक्मों पर अमल करते हैं और जो कुछ वो पसन्द करता है उसे बजा लाते हैं।<verse eid="1JN 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1JN 3:23"/>और उसका हुक्म ये है कि हम उसके बेटे ईसा मसीह के नाम पर ईमान लाएँ, जैसा उसने हमें हुक्म दिया उसके मुवाफ़िक़ आपस में मुहब्बत रख्खें। <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>और जो उसके हुक्मों पर 'अमल करता है, वो इस में और ये उसमें क़ाईम रहता है; और इसी से या'नी उस पाक रूह से जो उसने हमें दिया है, हम जानते हैं कि वो हम में क़ाईम रहता है।<verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s">झुठे उस्तादों से होशियार</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>ऐ 'अज़ीज़ो! हर एक रूह का यक़ीन न करो, बल्कि रूहों को आज़माओ कि वो ख़ुदा की तरफ़ से हैं या नहीं; क्यूँकि बहुत से झूठे नबी दुनियाँ में निकल खड़े हुए हैं। <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>ख़ुदा के रूह को तुम इस तरह पहचान सकते हो कि जो कोई रूह इक़रार करे कि ईसा मसीह मुजस्सिम होकर आया है, वो ख़ुदा की तरफ़ से है; <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>और जो कोई रूह ईसा का इक़रार न करे, वो ख़ुदा की तरफ़ से नहीं और यही मुख़ालिफ़ — ऐ — मसीह की रूह है; जिसकी ख़बर तुम सुन चुके हो कि वो आनेवाली है, बल्कि अब भी दुनिया में मौजूद है।<verse eid="1JN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4"/>ऐ बच्चों! तुम ख़ुदा से हो और उन पर ग़ालिब आ गए हो, क्यूँकि जो तुम में है वो उससे बड़ा है जो दुनिया में है। <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>वो दुनिया से हैं इस वास्ते दुनियाँ की सी कहते हैं, और दुनियाँ उनकी सुनती है। <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>हम ख़ुदा से है। जो ख़ुदा को जानता है, वो हमारी सुनता है; जो ख़ुदा से नहीं, वो हमारी नहीं सुनता। इसी से हम हक़ की रूह और गुमराही की रूह को पहचान लेते हैं।<verse eid="1JN 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>ऐ अज़ीज़ों! हम इस वक़्त ख़ुदा के फ़र्ज़न्द है, और अभी तक ये ज़ाहिर नहीं हुआ कि हम क्या कुछ होंगे! इतना जानते हैं कि जब वो ज़ाहिर होगा तो हम भी उसकी तरह होंगे, क्यूँकि उसको वैसा ही देखेंगे जैसा वो है। <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>जो मुहब्बत नहीं रखता वो ख़ुदा को नहीं जानता, क्यूँकि ख़ुदा मुहब्बत है।<verse eid="1JN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 4:9"/>जो मुहब्बत ख़ुदा को हम से है, वो इससे ज़ाहिर हुई कि ख़ुदा ने अपने इकलौते बेटे को दुनिया में भेजा है ताकि हम उसके वसीले से ज़िन्दा रहें। <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>मुहब्बत इस में नहीं कि हम ने ख़ुदा से मुहब्बत की, बल्कि इस में है कि उसने हम से मुहब्बत की और हमारे गुनाहों के कफ़्फ़ारे के लिए अपने बेटे को भेजा।<verse eid="1JN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11"/>ऐ 'अज़ीज़ो! जब ख़ुदा ने हम से ऐसी मुहब्बत की, तो हम पर भी एक दूसरे से मुहब्बत रखना फ़र्ज़ है।<verse eid="1JN 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 4:12"/>ख़ुदा को कभी किसी ने नहीं देखा; अगर हम एक दूसरे से मुहब्बत रखते हैं, तो ख़ुदा हम में रहता है और उसकी मुहब्बत हमारे दिल में कामिल हो गई है। <verse eid="1JN 4:12"/><verse number="13" style="v" sid="1JN 4:13"/>चूँकि उसने अपने रूह में से हमें दिया है, इससे हम जानते हैं कि हम उसमें क़ाईम रहते हैं और वो हम में। <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>और हम ने देख लिया है और गवाही देते हैं कि बाप ने बेटे को दुनिया का मुन्जी करके भेजा है।<verse eid="1JN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 4:15"/>जो कोई इक़रार करता है कि ईसा ख़ुदा का बेटा है, ख़ुदा उसमें रहता है और वो ख़ुदा में। <verse eid="1JN 4:15"/><verse number="16" style="v" sid="1JN 4:16"/>जो मुहब्बत ख़ुदा को हम से है उसको हम जान गए और हमें उसका यक़ीन है। ख़ुदा मुहब्बत है, और जो मुहब्बत में क़ाईम रहता है वो ख़ुदा में क़ाईम रहता है, और ख़ुदा उसमें क़ाईम रहता है।<verse eid="1JN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1JN 4:17"/>इसी वजह से मुहब्बत हम में कामिल हो गई, ताकि हमें 'अदालत के दिन दिलेरी हो; क्यूँकि जैसा वो है वैसे ही दुनिया में हम भी है। <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>मुहब्बत में ख़ौफ़ नहीं होता, बल्कि कामिल मुहब्बत ख़ौफ़ को दूर कर देती है; क्यूँकि ख़ौफ़ से 'अज़ाब होता है और कोई ख़ौफ़ करनेवाला मुहब्बत में कामिल नहीं हुआ।<verse eid="1JN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19"/>हम इस लिए मुहब्बत रखते हैं कि पहले उसने हम से मुहब्बत रख्खी। <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>अगर कोई कहे, “मैं ख़ुदा से मुहब्बत रखता हूँ” और वो अपने भाई से 'दुश्मनी रख्खे तो झूठा है: क्यूँकि जो अपने भाई से जिसे उसने देखा है मुहब्बत नहीं रखता, वो ख़ुदा से भी जिसे उसने नहीं देखा मुहब्बत नहीं रख सकता। <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>और हम को उसकी तरफ़ से ये हुक्म मिला है कि जो ख़ुदा से मुहब्बत रखता है वो अपने भाई से भी मुहब्बत रख्खे।<verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s">ख़ुदा के बेटे में ईमान रखना</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>जिसका ये ईमान है कि ईसा ही मसीह है, वो ख़ुदा से पैदा हुआ है; और जो कोई बाप से मुहब्बत रखता है, वो उसकी औलाद से भी मुहब्बत रखता है। <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>जब हम ख़ुदा से मुहब्बत रखते और उसके हुक्मों पर 'अमल करते हैं, तो इससे मा'लूम हो जाता है कि ख़ुदा के फ़र्ज़न्दों से भी मुहब्बत रखते हैं। <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/>और ख़ुदा की मुहब्बत ये है कि हम उसके हुक्मों पर 'अमल करें, और उसके हुक्म सख़्त नहीं।<verse eid="1JN 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 5:4"/>जो कोई ख़ुदा से पैदा हुआ है, वो दुनिया पर ग़ालिब आता है; और वो ग़ल्बा जिससे दुनिया मग़लूब हुई है, हमारा ईमान है। <verse eid="1JN 5:4"/><verse number="5" style="v" sid="1JN 5:5"/>दुनिया को हराने वाला कौन है? सिवा उस शख़्स के जिसका ये ईमान है कि ईसा ख़ुदा का बेटा है।<verse eid="1JN 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6"/>यही है वो जो पानी और ख़ून के वसीले से आया था, या'नी ईसा मसीह: वो न फ़क़त पानी के वसीले से, बल्कि पानी और ख़ून दोनों के वसीले से आया था। <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>और जो गवाही देता है वो रूह है, क्यूँकि रूह सच्चाई है। <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>और गवाही देनेवाले तीन है: रूह पानी और ख़ून; ये तीन एक बात पर मुत्तफ़िक़ हैं।<verse eid="1JN 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 5:9"/>जब हम आदमियों की गवाही क़ुबूल कर लेते हैं, तो ख़ुदा की गवाही तो उससे बढ़कर है; और ख़ुदा की गवाही ये है कि उसने अपने बेटे के हक़ में गवाही दी है। <verse eid="1JN 5:9"/><verse number="10" style="v" sid="1JN 5:10"/>जो ख़ुदा के बेटे पर ईमान रखता है, वो अपने आप में गवाही रखता है। जिसने ख़ुदा का यक़ीन नहीं किया उसने उसे झूठा ठहराया, क्यूँकि वो उस गवाही पर जो ख़ुदा ने अपने बेटे के हक़ में दी है, ईमान नहीं लाया<verse eid="1JN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 5:11"/>और वो गवाही ये है, कि ख़ुदा ने हमे हमेशा की ज़िन्दगी बख़्शी, और ये ज़िन्दगी उसके बेटे में है। <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>जिसके पास बेटा है, उसके पास ज़िन्दगी है, और जिसके पास ख़ुदा का बेटा नहीं, उसके पास ज़िन्दगी भी नहीं।<verse eid="1JN 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13"/>मैंने तुम को जो ख़ुदा के बेटे के नाम पर ईमान लाए हो, ये बातें इसलिए लिखी कि तुम्हें मा'लूम हो कि हमेशा की ज़िन्दगी रखते हो।।<verse eid="1JN 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 5:14"/>और हमे जो उसके सामने दिलेरी है, उसकी वजह ये है कि अगर उसकी मर्ज़ी के मुवाफ़िक़ कुछ माँगते हैं, तो वो हमारी सुनता है। <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>और जब हम जानते हैं कि जो कुछ हम माँगते हैं, वो हमारी सुनता है, तो ये भी जानते हैं कि जो कुछ हम ने उससे माँगा है वो पाया है।<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>अगर कोई अपने भाई को ऐसा गुनाह करते देखे जिसका नतीजा मौत न हो तो दुआ करे ख़ुदा उसके वसीले से ज़िन्दगी बख़्शेगा। उन्हीं को जिन्होंने ऐसा गुनाह नहीं किया जिसका नतीजा मौत हो, गुनाह ऐसा भी है जिसका नतीजा मौत है; इसके बारे में दुआ करने को मैं नहीं कहता। <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>है तो हर तरह की नारास्ती गुनाह, मगर ऐसा गुनाह भी है जिसका नतीजा मौत नहीं।<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>हम जानते है कि जो कोई ख़ुदा से पैदा हुआ है, वो गुनाह नहीं करता; बल्कि उसकी हिफ़ाज़त वो करता है जो ख़ुदा से पैदा हुआ और शैतान उसे छूने नहीं पाता। <verse eid="1JN 5:18"/><verse number="19" style="v" sid="1JN 5:19"/>हम जानते हैं कि हम ख़ुदा से हैं, और सारी दुनिया उस शैतान के क़ब्ज़े में पड़ी हुई है।<verse eid="1JN 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20"/>और ये भी जानते है कि ख़ुदा का बेटा आ गया है, और उसने हमे समझ बख़्शी है ताकि उसको जो हक़ीक़ी है जानें और हम उसमें जो हक़ीक़ी है, या'नी उसके बेटे ईसा मसीह में हैं। हक़ीक़ी ख़ुदा और हमेशा की ज़िन्दगी यही है। <verse eid="1JN 5:20"/><verse number="21" style="v" sid="1JN 5:21"/>ऐ बच्चों! अपने आपको बुतों से बचाए रख्खो।<verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
