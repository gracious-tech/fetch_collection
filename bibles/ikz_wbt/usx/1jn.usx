<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id">‑ Ikizu 1 John</book>
  <para style="h">1 Yoohana</para>
  <para style="toc3">1 Yoohana</para>
  <para style="toc2">1 Yoohana</para>
  <para style="toc1">Ɨnyarʉbha ye embere ya Yoohana</para>
  <para style="mt2">Ɨnyarʉbha ye embere ya</para>
  <para style="mt1">Yoohana</para>
  <para style="imt">Ʉbhʉkangati</para>
  <para style="ip">Ɨnyarʉbha yɨnʉ ɨkaandɨkwa na Yoohana. Mʉzɨnyarʉbha isatʉ za Yoohana, hanʉ akubhuga “itwɨ,” ariigamba umwene hamwɨmwɨ na abhatumwa abhakɨndichazɨ. Hanʉ aandikirɨ zɨnyarʉbha zɨnʉ, aarɨ akukunguhirɨ.</para>
  <para style="ip">Mʉnyarʉbha yɨnʉ araandɨkɨra Abhakiriisitʉ, bhanʉ aarɨ asɨɨgirɨ bhʉkʉngʼu. Akabhabhɨrɨkɨra “abhaana bhaanɨ abhasɨɨgwa.”</para>
  <para style="ip">Yoohana araandɨkɨra Abhakiriisitʉ korereke abhahɨ ʉbhʉtʉngɨri igʉrʉ wu ubhwikari bhwi Ikikiriisitʉ. Kwikɨ arahurucha amaangirijʉ igʉrʉ wa amiija gʉ ʉrʉrɨmɨ. Kwarɨ na abhiija obhorebhe bhanʉ bhaarɨ bhatigirɨ amasengerero, bhakabha bhariiruguura mʉrʉbhɨri ruyo na kʉnyaraganʼya amiija gʉ ʉrʉrɨmɨ.</para>
  <para style="ip">Yoohana arakandikija kʉbha Yɨɨsu Kiriisitʉ ni ingʼana rya Mungu wʉnʉ aarɨ ʉmʉʉtʉ. Bhanʉ bhakubhuga Kiriisitʉ ataarɨ mʉʉtʉ, nɨ‑bhabhisa bha Kiriisitʉ, nɨ‑bhabhɨɨhi na ni‑bhiija bhʉ ʉrʉrɨmɨ. Mungu, nɨ‑bhʉsɨɨgi necho abhaatʉ bhaazɨ bhareenderwa kʉsɨɨgana, kʉ kʉbha ʉkʉsɨɨga Mungu nʉ ʉkʉsɨɨga ʉmʉkɨndichazʉ, ne‑kegero kɨmwɨ. Ʉbhʉhʉru bhwa kemerano bhʉrabhoneka ku kwisirirya Yɨɨsu Kiriisitʉ, ʉkʉtama kumwisirirya, ʉmʉʉtʉ atakʉtʉra kʉsʉngʼaana ʉbhʉhʉru bhwa kemerano.</para>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="s">Ɨngʼana yʉ ʉbhʉhʉru</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>Tʉrabharaganʼya ɨngʼana igʉrʉ wa wʉnʉ akubhirikirwa Ɨngʼana yʉ ʉbhʉhʉru, wʉnʉ aareho kurwa ʉbhʉtangɨ.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="xt" closed="false">Rora <ref loc="GEN 1:1">Ʉbhʉtangɨ 1:1</ref>; <ref loc="JHN 1:1-3">Yoohana 1:1‑3</ref>.</char></note> Itwɨ tʉkamwigwa na komorora na amɨɨsʉ gɨɨtʉ, tʉkamorora na kʉbhaabhaata na amabhoko gɨɨtʉ. <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/>Ʉbhʉhʉru bhuyo bhʉkarorekana, na niitwɨ tʉkabhorora. Nangʉ tʉrabhamenyeekererya na kʉbharaganʼya ɨngʼana igʉrʉ wa wʉnʉ nɨ‑bhʉhʉru bhwa kemerano. Ewe aarɨ kwa Bhaabha Mungu, akarorekana kwa niitwɨ.<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="xt" closed="false">Rora <ref loc="JHN 1:14">Yoohana 1:14</ref>.</char></note> <verse eid="1JN 1:2"/><verse number="3" style="v" sid="1JN 1:3"/>Tʉkamorora na kumwigwa, nangʉ tʉrabharaganʼya ɨngʼana igʉrʉ waazɨ, korereke mʉbhɨ ni ikigwatani na niitwɨ mubhwisirirya. Ikigwatani kɨnʉ tʉnachʉ nɨ‑hamwɨmwɨ na Bhaabha Mungu, nu Umwana waazɨ<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="fk" closed="false">Umwana waazɨ</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">Umwana wa Mungu</char> muKiniibhasa.</note> Yɨɨsu Kiriisitʉ. <verse eid="1JN 1:3"/><verse number="4" style="v" sid="1JN 1:4"/>Tʉrabhaandɨkɨra ganʉ, korereke obhozomerwa bhwɨtʉ bhuhikɨ.<verse eid="1JN 1:4"/></para>
  <para style="s">Ukwikara mubhwɨrʉ</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>Mmbe, amangʼana ganʉ twigwirɨ kurwa kwa Yɨɨsu Kiriisitʉ, nego tʉkʉbharwazɨra, Mungu ni‑bhwɨrʉ, ataana ikiirimya chʉchʉsi mʉʉsi waazɨ. <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>Arɨɨbhɨ tʉrabhuga tuni ikigwatani na Mungu, ɨnʉ tʉrakaja kwikara mukiirimya, tʉragamba ʉrʉrɨmɨ, na tʉtakokora eheene. <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>Nawe, arɨɨbhɨ turiikara mubhwɨrʉ, chɨmbu Mungu arɨ mubhwɨrʉ, tʉrabha ni ikigwatani itubheene kobheene. Na amasaahɨ gu Umwana waazɨ Yɨɨsu garabhɨngukya ʉbhʉbhɨ bhwɨtʉ bhwʉsi.<verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>Arɨɨbhɨ tʉrabhuga kʉbha itwɨ tʉtaana ʉbhʉbhɨ bhwʉbhwʉsi, turiikangirirya itubheene, ne eheene ɨtarɨ kwa niitwɨ. <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>Nawe, arɨɨbhɨ tʉraatigɨ ʉbhʉbhɨ bhwɨtʉ, Mungu aratobheerera ʉbhʉbhɨ bhwɨtʉ na kʉtʉbhɨngukya ʉbhʉbhɨ bhwʉsi, kʉ kʉbha ewe, ne‑moheene na we eheene. <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>Turiibhugɨ tʉkɨɨrɨ kokora ʉbhʉbhɨ, tʉrakora Mungu mʉbhɨɨhi, na twangirɨ ringʼana ryazɨ kɨmwɨ.<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="s">Yɨɨsu Kiriisitʉ newe akʉtʉsabhɨra</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>Abhaana bhaanɨ abhasɨɨgwa, nɨrabhaandɨkɨra amangʼana gayo, korereke mʉtasarya. Nawe arɨɨbhɨ ʉmʉʉtʉ wʉwʉʉsi araasaryɨ, tunawe wʉnʉ akutwibhagɨra kwa Bhaabha Mungu. Wuyo newe Yɨɨsu Kiriisitʉ we eheene. <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>Ewe newe ikimweso<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="fk" closed="false">Ikimweso</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> chu ukutugwatanʼya na Mungu ku kuruushaho ʉbhʉbhɨ bhwɨtʉ. Na ɨtarɨ ʉbhʉbhɨ bhwɨtʉ ubhwene, nawe nʉ ʉbhʉbhɨ bhwa abhaatʉ bhʉʉsi bha kʉʉsɨ.<verse eid="1JN 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3"/>Turiigwatɨ imigirʉ ja Mungu, neho tokomenya tumwɨzɨ. <verse eid="1JN 2:3"/><verse number="4" style="v" sid="1JN 2:4"/>Wʉwʉʉsi wʉnʉ akubhuga kʉbha amwɨzɨ Mungu ɨnʉ atakugwata imigirʉ jazɨ, nɨ‑mʉbhɨɨhi, atɨɨzɨ amaheene. <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>Nawe ʉmʉʉtʉ wʉnʉ akugwata ringʼana ryazɨ, maheene ʉbhʉsɨɨgi bhwa Mungu bhʉnagiibhwɨ heene heene. Kwa rɨnʉ tʉmɨnyirɨ kʉbha tunu ubhumwɨmwɨ na Mungu. <verse eid="1JN 2:5"/><verse number="6" style="v" sid="1JN 2:6"/>Ʉmʉʉtʉ wʉnʉ akubhuga anu ubhumwɨmwɨ na Mungu, areenderwa iikarɨ chɨmbu Yɨɨsu iikɨɨrɨ.<verse eid="1JN 2:6"/></para>
  <para style="s">Amaswaja ga Yɨɨsu igʉrʉ wʉ ʉkʉsɨɨgana</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7"/>Abhasɨɨgwa bhaanɨ, amaswaja ganʉ nɨkʉbhaandɨkɨra gatarɨ mahya, nawe nɨ‑maswaja gɨ ɨkarɨ garyagarya, ganʉ mwarɨ mwɨzɨ kwɨma hanʉ mwatangirɨ kwisirirya Kiriisitʉ.<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="xt" closed="false">Rora <ref loc="JHN 13:34">Yoohana 13:34</ref>.</char></note> Amaswaja gɨ ɨkarɨ gayo, ni‑ringʼana rɨnʉ mwigwirɨ igʉrʉ wʉ ʉkʉsɨɨgana. <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>Nʉʉrʉbhu, amaswaja ganʉ nɨkʉbhaandɨkɨra, nego amahya. Amaheene ga riswaja rɨnʉ rɨkarorekana mubhwikari bhwa Yɨɨsu Kiriisitʉ, na mubhwikari bhwanyu, kʉ kʉbha ikiirimya kɨrahɨta nu ubhwɨrʉ bhwe eheene bhʉmarirɨ kʉbhanza.<verse eid="1JN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9"/>Ʉmʉʉtʉ wʉwʉʉsi wʉnʉ akubhuga, ariikara mubhwɨrʉ ɨnʉ arabhiihirirwa abhahiiri bhaazɨ, akɨɨrɨ ariikara mukiirimya. <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/>Wʉwʉʉsi wʉnʉ asɨɨgirɨ umuhiiri waazɨ, ariikara mubhwɨrʉ. Kɨtareeho chʉchʉsi kɨnʉ kikugirya asaryɨ. <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>Nawe wʉnʉ akubhiihirirwa umuhiiri waazɨ, ari mukiirimya. Na aragenda mukiirimya, ɨnʉ atɨɨzɨ hanʉ akuja, kʉ kʉbha ikiirimya kikundikiiryɨ amɨɨsʉ gaazɨ.<verse eid="1JN 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="1JN 2:12"/>Nɨrabhaandɨkɨra abhaana bhaanɨ abhasɨɨgwa,</para>
  <para style="q" vid="1JN 2:12">kʉ kʉbha ʉbhʉbhɨ bhwanyu bhʉbhɨɨrɨɨrwɨ kʉ kʉhɨtɨra Yɨɨsu Kiriisitʉ.<verse eid="1JN 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="1JN 2:13"/>Nɨrabhaandɨkɨra bhabhaabha,</para>
  <para style="q" vid="1JN 2:13">kʉ kʉbha mwɨzɨ Yɨɨsu Kiriisitʉ,</para>
  <para style="q" vid="1JN 2:13">wʉnʉ aareho kwɨma ʉbhʉtangɨ.</para>
  <para style="q" vid="1JN 2:13">Nɨrabhaandɨkɨra abhamura,</para>
  <para style="q" vid="1JN 2:13">kʉ kʉbha muhizirɨ Shɨtaani.</para>
  <para style="q" vid="1JN 2:13">Nɨrabhaandɨkɨra abhaana,</para>
  <para style="q" vid="1JN 2:13">kʉ kʉbha mwɨzɨ Bhaabha Mungu.<verse eid="1JN 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="1JN 2:14"/>Nɨrabhaandɨkɨra bhabhaabha,</para>
  <para style="q" vid="1JN 2:14">kʉ kʉbha mwɨzɨ Yɨɨsu Kiriisitʉ,</para>
  <para style="q" vid="1JN 2:14">wʉnʉ aareho kwɨma ʉbhʉtangɨ.</para>
  <para style="q" vid="1JN 2:14">Nɨrabhaandɨkɨra abhamura,</para>
  <para style="q" vid="1JN 2:14">kʉ kʉbha mʉna amanaga,</para>
  <para style="q" vid="1JN 2:14">mʉrakaja kugwata ɨngʼana ya Mungu,</para>
  <para style="q" vid="1JN 2:14">na muhizirɨ Shɨtaani.<verse eid="1JN 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>Mʉtasɨɨga kokora ʉbhʉbhɨ bhwɨ ɨɨsɨ, na amangʼana ganʉ garɨ mʉʉsɨ. Ʉmʉʉtʉ wʉnʉ asɨɨgirɨ ɨɨsɨ, ʉbhʉsɨɨgi bhwa Bhaabha ataanabhwɨ. <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>Ʉbhʉbhɨ bhwa kʉʉsɨ nebhwe bhʉnʉ, umwʉyʉ ʉmʉbhɨ gwʉ ʉmʉbhɨrɨ, rihari ryʉ ʉkʉbha nachʉ chʉchʉsi kɨnʉ ʉmʉʉtʉ akɨrʉʉzɨ, nu ubhwiyungi kʉ kʉbha yu ubhuniibhi. Bhyʉsi bhiyo bhɨtakurwa kwa Bhaabha Mungu nawe bhɨrarwa mʉʉsɨ mʉnʉ. <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>Ɨɨsɨ hamwɨmwɨ nɨ ɨnamba yaku ɨmbɨ, bhɨrahɨta. Nawe wʉwʉʉsi wʉnʉ akokora chɨmbu Mungu akwenda, arabha nʉ ʉbhʉhʉru bhwa kemerano.<verse eid="1JN 2:17"/></para>
  <para style="s">Abhabhisa bha Kiriisitʉ</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>Abhaana bhaanɨ abhasɨɨgwa, zisikʉ zɨ ɨtɨnɨrʉ zihikirɨ! Mwigwirɨ umubhisa wa Kiriisitʉ<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="fk" closed="false">Umubhisa wa Kiriisitʉ</char><char style="ft" closed="false">, enzobhooro yaku nɨ‑wʉnʉ akwanga Kiriisitʉ.</char></note> araaza, na nangʉ abhabhisa bhaaru bha Kiriisitʉ bhamarirɨ kuuza. Ɨbhu nɨmbu tʉmɨnyirɨ turi muzisikʉ zɨ ɨtɨnɨrʉ. <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>Abhaatʉ bhayo bharuurɨ mʉmasengerero gɨɨtʉ, nawe bhataarɨ nu ubhumwɨmwɨ na niitwɨ. Bhangabhɨɨrɨ bhakɨndichɨtʉ bhaarɨ bharasaaga hamwɨmwɨ na niitwɨ. Nawe bhakarweho korereke emenyekanɨ kʉbha ɨtarɨ bhʉʉsi nɨ‑bhakɨndichɨtʉ.<verse eid="1JN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20"/>Nawe imwɨ, Ʉmʉrɨndu Yɨɨsu abhahɨɨrɨ Ekoro yaazɨ,<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="fk" closed="false">Abhahɨɨrɨ Ekoro yaazɨ </char><char style="ft" closed="false">kuKigiriki nɨ‑</char><char style="fqa" closed="false">mʉhakirwɨ amaguta. </char><char style="ft" closed="false">Ribhaga ryʉ Ʉbhʉragɨ bhwɨ Ɨkarɨ, Abhiiziraɨri bhaarɨ bharatʉʉra abhaatʉ momeremo ji ikikuhaani na jʉ ʉbhʉtɨmi. Bhakabhahaka amaguta kumitwɨ kwerecha kʉbha Mungu abhahɨɨrɨ emeremo obhorebhe hamwɨmwɨ nʉ ʉbhʉnaja bhwe Ekoro Ɨndɨndu. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">Ekoro Ɨndɨndu</char> muKiniibhasa. <char style="xt" closed="false">Rora <ref loc="1SA 16:13">1 Samwɨri 16:13</ref>; <ref loc="ISA 61:1">Isaaya 61:1</ref>.</char></note> nangʉ imwʉsi mwɨzɨ amaheene. <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>Nɨtabhaandikiirɨ ɨnyarʉbha yɨnʉ, kʉ kʉbha mʉtɨɨzɨ amaheene, nawe kʉ kʉbha mwɨzɨ, rʉtareeho ʉrʉrɨmɨ rwʉrwʉsi rʉnʉ rukurwa kʉmaheene. <verse eid="1JN 2:21"/><verse number="22" style="v" sid="1JN 2:22"/>Ʉmʉʉtʉ ʉmʉbhɨɨhi nɨ‑wɨɨwɨ? Ʉmʉʉtʉ ʉmʉbhɨɨhi nɨ‑wʉwʉʉsi wʉnʉ akwanga Yɨɨsu ni‑Kiriisitʉ.<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="fk" closed="false">Kiriisitʉ</char><char style="ft" closed="false">, enzobhooro yaku nɨ‑wʉnʉ arʉbhwɨrwɨ na Mungu kʉbhasabhʉra abhaatʉ na kʉbhakangata mʉbhʉtɨmi bhwazɨ. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> Wʉwʉʉsi wʉnʉ akwanga Bhaabha Mungu na Yɨɨsu Umwana waazɨ, newe umubhisa wa Kiriisitʉ. <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>Ʉmʉʉtʉ wʉnʉ akwanga Umwana, ataana bhʉmwɨ na Bhaabha Mungu. Nawe, wʉnʉ akwisirirya Umwana mʉbhʉtangɨ bhwa abhaatʉ, anʉ ʉbhʉmwɨmwɨ na Bhaabha Mungu.<verse eid="1JN 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24"/>Nangʉ, mʉkajɨ kʉgagwata mumyʉyʉ janyu amangʼana ganʉ mwijibhwɨ kwɨma ʉbhʉtangɨ. Arɨɨbhɨ mʉrakaja kugwata amiija gayo, mʉrabha nʉ ʉbhʉmwɨ nu Umwana na Bhaabha Mungu. <verse eid="1JN 2:24"/><verse number="25" style="v" sid="1JN 2:25"/>Na bhuyo, nebhwe ʉbhʉragɨ bhwʉ ʉbhʉhʉru bhwa kemerano bhʉnʉ atʉragɨɨnʼyɨ.<verse eid="1JN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26"/>Nɨbhaandikiirɨ amangʼana gayo, kʉbharecha igʉrʉ wa abhaatʉ bhanʉ bhakwenda kʉbharimirya. <verse eid="1JN 2:26"/><verse number="27" style="v" sid="1JN 2:27"/>Nawe imwɨ, Kiriisitʉ abhahɨɨrɨ Ekoro Ɨndɨndu, yɨnʉ ikwikara kwa niimwɨ. Wuyo newe akubhiija gʉʉsi, na amiija gaazɨ nɨ‑ga amaheene, gatarɨ gʉ ʉrʉrɨmɨ. Kwɨbhu, mʉtakwenderwa kwijibhwa na wʉndɨ.<note caller="+" style="f"><char style="fr" closed="false">2:27 </char><char style="xt" closed="false">Rora <ref loc="JHN 14:26">Yoohana 14:26</ref>.</char></note> Chɨmbu Ekoro ibhiijiryɨ, mʉkajɨ kʉbha nu ubhumwɨmwɨ na Kiriisitʉ.<verse eid="1JN 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>Nangʉ abhaana bhaanɨ abhasɨɨgwa, mʉkajɨ kʉbha nu ubhumwɨmwɨ na Kiriisitʉ, korereke ribhaga rɨnʉ arɨɨgarʉkɨ, tʉbhɨ nʉ ʉbhʉkararu, tʉtasʉʉka embere waazɨ.<verse eid="1JN 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1JN 2:29"/>Arɨɨbhɨ mwɨzɨ Kiriisitʉ, ne‑moheene, momenye wʉwʉʉsi wʉnʉ akokora ge eheene, ni‑mwana wa Mungu.<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="s">Ukwikara ncha abhaana bha Mungu</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>Morore chɨmbu Bhaabha Mungu atʉsɨɨgirɨ bhʉkʉngʼu, kʉbha itwɨ tubhirikirwɨ abhaana bhaazɨ! Maheene nɨmbu tʉrɨ. Nawe abhaatʉ bhanʉ bhatakwigwa Mungu, bhatakwobhoora kʉbha itwɨ, nɨ‑bhaana bha Mungu, kʉ kʉbha bhatamwɨzɨ ewe. <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>Abhasɨɨgwa bhaanɨ, tʉmɨnyirɨ kʉbha nangʉ itwɨ nɨ‑bhaana bha Mungu, nawe ɨkɨɨrɨ komenyekana bhwaheene chɨmbu tʉrɨɨbhɨ hanʉ Kiriisitʉ arɨɨgarʉkɨ naatu. Nawe tʉmɨnyirɨ, tʉratuubhana neewe, kʉ kʉbha tʉramorora chɨmbu arɨ. <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>Ʉmʉʉtʉ wʉwʉʉsi wʉnʉ akwisega kʉbha aratuubhana na Kiriisitʉ ahiibhɨngukya, korereke abhɨ mʉrɨndu ncha Kiriisitʉ.<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>Wʉwʉʉsi wʉnʉ akokora ʉbhʉbhɨ, arasarya imigirʉ ja Mungu, kʉ kʉbha okokora ʉbhʉbhɨ, nekwe ʉkʉsarya imigirʉ. <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/>Mwɨzɨ kʉbha Kiriisitʉ akaaza kʉʉsɨ, korereke aruushɨ ʉbhʉbhɨ bhwɨtʉ. Naatu ewe ataana ʉbhʉbhɨ bhwʉbhwʉsi. <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>Nangʉ ɨrɨ habhwɨrʉ, wʉwʉʉsi wʉnʉ akongʼeha kʉbha nu ubhumwɨmwɨ neewe, atakongʼeha kokora ʉbhʉbhɨ. Nawe wʉwʉʉsi wʉnʉ akongʼeha kokora ʉbhʉbhɨ, atɨɨzɨ Kiriisitʉ nɨ‑wɨɨwɨ, na atamʉmɨnyirɨ.<verse eid="1JN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7"/>Nangʉ, abhaana bhaanɨ abhasɨɨgwa, mutiisirirya ʉmʉʉtʉ wʉwʉʉsi abharimiryɨ. Wʉwʉʉsi wʉnʉ akokora amangʼana ge eheene, ane eheene chɨmbu ewe, ne‑we eheene. <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>Nawe wʉwʉʉsi wʉnʉ akongʼeha kokora ʉbhʉbhɨ, nɨ‑mʉʉtʉ wa Shɨtaani.<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="fk" closed="false">Shɨtaani</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> Tʉmɨnyirɨ, kʉ kʉbha Shɨtaani angʼɨhirɨ kokora ʉbhʉbhɨ kwɨma ʉbhʉtangɨ. Nawe Umwana wa Mungu akaaza kʉʉsɨ, korereke asaryɨ emeremo ja Shɨtaani.<verse eid="1JN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9"/>Wʉwʉʉsi wʉnʉ abhɨɨrɨ umwana wa Mungu, atakongʼeha kokora ʉbhʉbhɨ, kʉ kʉbha anʉ ʉbhʉhʉru bhwa Mungu. Atakʉtʉra kongʼeha kokora ʉbhʉbhɨ, kʉ kʉbha ni‑mwana wa Mungu. <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>Nawe ʉmʉʉtʉ wʉnʉ atakokora amangʼana ge eheene, hamwɨ wʉnʉ atasɨɨgirɨ umuhiiri waazɨ, wuyo atarɨ umwana wa Mungu. Ɨbhu nɨmbu tukwahʉkanʼya abhaana bha Mungu na abhaana bha Shɨtaani.<verse eid="1JN 3:10"/></para>
  <para style="s">Mʉsɨɨganɨ</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>Kwɨma hanʉ mwatangirɨ kwisirirya, mwigwirɨ amangʼana kʉbha toreenderwa kʉsɨɨgana itubheene kobheene. <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>Tʉtabha ncha Kaɨni, chɨmbu aakangatirwɨ na Shɨtaani, akiita umunyi waazɨ.<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="xt" closed="false">Rora <ref loc="GEN 4:1-8">Ʉbhʉtangɨ 4:1‑8</ref>.</char></note> Nɨ‑kwakɨ akamwita? Akamwita kʉ kʉbha amahocha gaazɨ gaarɨ mabhɨ, nawe gu umunyi waazɨ gaarɨ ge eheene.<verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>Nangʉ abhahiiri bhaanɨ, mʉtarʉgʉʉra arɨɨbhɨ abhaatʉ bhanʉ bhatakwigwa Mungu bharaabhabhiihirirwɨ. <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/>Itwɨ tʉmɨnyirɨ turuurɨ muzinguru zu uruku, na nangʉ tʉnʉ ʉbhʉhʉru bhwa kemerano. Tʉmɨnyirɨbhu, kʉ kʉbha tʉsɨɨgirɨ abhahiiri bhɨɨtʉ. Nawe ʉmʉʉtʉ wʉwʉʉsi wʉnʉ ataana ʉbhʉsɨɨgi, akɨɨrɨ muzinguru zu uruku.<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="xt" closed="false">Rora <ref loc="JHN 5:24">Yoohana 5:24</ref>.</char></note> <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>Wʉwʉʉsi wʉnʉ akubhiihirirwa umuhiiri waazɨ, ni‑mwiti. Mwɨzɨ kʉbha atareeho mwiti wʉnʉ anʉ ʉbhʉhʉru bhwa kemerano mʉmʉbhɨrɨ gwazɨ.<verse eid="1JN 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 3:16"/>Hanʉ Kiriisitʉ aaruushiryɨ ubhwikari bhwazɨ igʉrʉ wɨɨtʉ, akatwerekenʼya ʉbhʉsɨɨgi bhwa amaheene. Naatu na niitwɨ, toreenderwa kuruusha ubhwikari bhwɨtʉ igʉrʉ wa abhahiiri bhɨɨtʉ. <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>Ʉmʉʉtʉ wʉwʉʉsi we ebhegero bhyu ukwisa, areemorore umuhiiri waazɨ anu ubhwɨndi, nawe ataana umwʉyʉ gwɨ ɨbhɨgʉngi gwʉ ʉkʉmʉsakirya, nangʉ arabha nʉ ʉbhʉsɨɨgi bhwa Mungu?<verse eid="1JN 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 3:18"/>Abhaana bhaanɨ abhasɨɨgwa, tʉtasɨɨgana kwa amangʼanabhu, nawe tʉsɨɨganɨ heene ku kwikorera amazʉmu. <verse eid="1JN 3:18"/><verse number="19" style="v" sid="1JN 3:19"/>Tʉrɨsɨɨganɨbhu, neho tʉraamenye kʉbha itwɨ, nɨ‑bhaatʉ bhe eheene, naatu imyʉyʉ jɨtʉ gɨrahoreera mʉbhʉtangɨ bhwa Mungu. <verse eid="1JN 3:19"/><verse number="20" style="v" sid="1JN 3:20"/>Nʉʉrʉ arɨɨbhɨ turiitinirwɨ mozekoro zɨɨtʉ kʉbha tʉkʉrirɨ ʉbhʉbhɨ, tʉmɨnyirɨ Mungu newe ʉmʉkʉrʉ kʉkɨra zekoro zɨɨtʉ, ne ewe amɨnyirɨ gʉʉsi.<verse eid="1JN 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 3:21"/>Abhasɨɨgwa bhaanɨ, arɨɨbhɨ tʉtatiniirwɨ mozekoro zɨɨtʉ, tʉratʉra kʉbha nʉ ʉbhʉkararu bhu ukwisuka mʉbhʉtangɨ bhwa Mungu. <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>Naatu tʉrasʉngʼaana kurwa kwawe ryʉryʉsi rɨnʉ tʉkʉsabha, kʉ kʉbha turiigwa amaswaja gaazɨ na kokora ganʉ gakomozomera.<verse eid="1JN 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1JN 3:23"/>Amaswaja gaazɨ nego ganʉ, kʉbha turyisiriryɨ iriina ryu Umwana waazɨ, Yɨɨsu Kiriisitʉ, na kʉsɨɨgana chɨmbu atʉragɨɨnʼyɨ. <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>Ʉmʉʉtʉ wʉwʉʉsi wʉnʉ akugwata amaswaja ga Mungu, anu ubhumwɨmwɨ neewe. Mungu wʉʉsi anu ubhumwɨmwɨ neewe. Tʉmɨnyirɨ kʉbha Mungu ariikara mubhumwɨmwɨ na niitwɨ kʉ kʉbha tone Ekoro Ɨndɨndu yɨnʉ atʉhɨɨrɨ.<verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s">Okomenya ekoro ya amaheene na yʉ ʉrʉrɨmɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>Abhasɨɨgwa bhaanɨ, mutiisirirya ʉmʉʉtʉ wʉwʉʉsi wʉnʉ akubhuga ane Ekoro ya Mungu. Nawe morore bhwaheene arɨɨbhɨ ʉmʉʉtʉ arakangatwa ne Ekoro ya Mungu hamwɨ zɨyi. Mokorebhu kʉ kʉbha abharʉʉtɨrɨri bhaaru bhʉ ʉrʉrɨmɨ bhabhʉnɨkirɨ kʉʉsɨ. <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>Ɨnzɨra yo okomenya kʉbha ʉmʉʉtʉ arakangatwa ne Ekoro ya Mungu neyo yɨnʉ. Wʉwʉʉsi wʉnʉ akwisirirya Yɨɨsu Kiriisitʉ akaaza nchʉ ʉmʉʉtʉ, wuyo newe akʉkangatwa ne Ekoro ya Mungu. <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>Nawe wʉwʉʉsi wʉnʉ atakwisirirya Yɨɨsu aarɨ nʉ ʉmʉbhɨrɨ gwʉ ʉmʉʉtʉ, atakʉkangatwa ne Ekoro ya Mungu. Ʉmʉʉtʉ wuyo arakangatwa ne ekoro yu umubhisa wa Kiriisitʉ. Na niimwɨ, mwigwirɨ kʉbha umubhisa wuyo araaza, na nangʉ arɨ kʉʉsɨ.<verse eid="1JN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4"/>Nawe abhaana bhaanɨ abhasɨɨgwa, imwɨ nɨ‑bhaana bha Mungu, na niimwɨ muhizirɨ abharʉʉtɨrɨri bhʉ ʉrʉrɨmɨ bhayo. Mʉkatʉra kʉbhahiza kʉ kʉbha mone Ekoro ya Mungu. Eyo ɨnʉ ʉbhʉnaja kʉkɨra ekoro ya Shɨtaani wʉnʉ arɨ kʉʉsɨ. <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>Abharʉʉtɨrɨri bhʉ ʉrʉrɨmɨ bhayo, nɨ‑bha kʉʉsɨ, necho bharagamba amangʼana gɨ ɨɨsɨ. Na abhaatʉ bha kʉʉsɨ bhanʉ bhatakwisirirya Mungu, bharabhiitegeerera. <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>Itwɨ nɨ‑bhaana bha Mungu. Wʉwʉʉsi wʉnʉ yɨɨzɨ Mungu, aratwitegeerera. Nawe wʉnʉ atarɨ umwana wa Mungu, atakutwitegeerera. Ɨbhu nɨmbu tukwahʉkanʼya gatɨ wa abhaatʉ bhanʉ bhakʉkangatwa ne Ekoro ya amaheene, na bhanʉ bhakʉkangatwa ne ekoro yʉ ʉrʉrɨmɨ.<verse eid="1JN 4:6"/></para>
  <para style="s">Mungu nɨ‑bhʉsɨɨgi</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>Abhasɨɨgwa bhaanɨ, tʉsɨɨganɨ, kʉ kʉbha ʉbhʉsɨɨgi bhʉrarwa kwa Mungu. Ʉmʉʉtʉ wʉwʉʉsi wʉnʉ asɨɨgirɨ abhakɨndichazɨ, ni‑mwana wa Mungu, na newe yɨɨzɨ Mungu. <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>Nawe wʉwʉʉsi wʉnʉ atasɨɨgirɨ abhakɨndichazɨ, atɨɨzɨ Mungu, kʉ kʉbha Mungu, nɨ‑bhʉsɨɨgi.<verse eid="1JN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 4:9"/>Mungu akeerecha ʉbhʉsɨɨgi bhwazɨ kwa niitwɨ kʉnzɨra yʉ ʉkʉtʉma Umwana waazɨ umumwɨmwɨ kʉʉsɨ, korereke tobhone ʉbhʉhʉru bhwa kemerano kʉhɨtɨra kwawe. <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>Bhʉnʉ nebhwe ʉbhʉsɨɨgi, ɨtarɨ itwɨ tʉkasɨɨga Mungu, nawe ewe newe aatʉsɨɨgirɨ. Neyo enzobhooro akatʉma Umwana waazɨ, korereke abhɨ ikimweso chu ukutugwatanʼya na Mungu ku kuruushaho ʉbhʉbhɨ bhwɨtʉ. <verse eid="1JN 4:10"/><verse number="11" style="v" sid="1JN 4:11"/>Abhasɨɨgwa bhaanɨ, kʉ kʉbha Mungu aatʉsɨɨgirɨ itwɨ, itwʉsi toreenderwa tʉsɨɨganɨ. <verse eid="1JN 4:11"/><verse number="12" style="v" sid="1JN 4:12"/>Atareeho ʉmʉʉtʉ wʉwʉʉsi wʉnʉ amʉrʉʉzɨ Mungu ibhaga ryʉryʉsi. Nawe tʉrɨɨsɨɨganɨ, Mungu ariikara mubhumwɨmwɨ na niitwɨ, nʉ ʉbhʉsɨɨgi bhwazɨ bhʉnagirɨ kwa niitwɨ.<verse eid="1JN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13"/>Itwɨ tunu ubhumwɨmwɨ na Mungu, na Mungu anu ubhumwɨmwɨ na niitwɨ. Tʉmɨnyirɨ, kʉ kʉbha atʉhɨɨrɨ Ekoro yaazɨ. <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>Itwɨ tʉrʉʉzɨ na komenyeekererya abhandɨ kʉbha Bhaabha Mungu akatʉma Umwana waazɨ kʉʉsɨ, korereke abhɨ Ʉmʉsabhuri wa abhaatʉ bhʉʉsi. <verse eid="1JN 4:14"/><verse number="15" style="v" sid="1JN 4:15"/>Ʉmʉʉtʉ wʉwʉʉsi wʉnʉ akwisirirya Yɨɨsu ni‑Mwana wa Mungu, Mungu anu ubhumwɨmwɨ nawe, wʉʉsi anu ubhumwɨmwɨ na Mungu. <verse eid="1JN 4:15"/><verse number="16" style="v" sid="1JN 4:16"/>Nangʉ, itwɨ tʉmɨnyirɨ na kwisirirya kʉbha Mungu atʉsɨɨgirɨ. Mungu, nɨ‑bhʉsɨɨgi. Wʉwʉʉsi wʉnʉ akwikara kʉbhʉsɨɨgi, newe anu ubhumwɨmwɨ na Mungu, Mungu wʉʉsi anu ubhumwɨmwɨ neewe.<verse eid="1JN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1JN 4:17"/>Kʉnzɨra yiyo, ʉbhʉsɨɨgi bhʉnagirɨ kwa niitwɨ, korereke tʉbhɨ nʉ ʉbhʉkararu kurusikʉ rwu ukutinirwa, kʉ kʉbha ubhwikari bhwɨtʉ mʉʉsɨ mʉnʉ bhwangɨ bhwa Yɨɨsu Kiriisitʉ. <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>Hanʉ hanʉ ʉbhʉsɨɨgi hataana bhwʉbha, nawe ʉbhʉsɨɨgi bhwa amaheene bhʉhaaruusha ubhwʉbha, kʉ kʉbha ukutinirwa nekwe kukugirya abhaatʉ bhʉʉbhahɨ. Ʉmʉʉtʉ wʉwʉʉsi wʉnʉ anu ubhwʉbha, ʉbhʉsɨɨgi bhwa Mungu bhʉkɨɨrɨ kʉnaga kwawe.<verse eid="1JN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19"/>Itwɨ tʉnʉ ʉbhʉsɨɨgi, kʉ kʉbha Mungu newe aakangatirɨ kʉtʉsɨɨga. <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>Arɨɨbhɨ ʉmʉʉtʉ arabhuga asɨɨgirɨ Mungu, ɨnʉ arabhiihirirwa umuhiiri waazɨ, nɨ‑mʉbhɨɨhi. Tʉmɨnyirɨ nɨ‑mʉbhɨɨhi, kʉ kʉbha arɨɨbhɨ atasɨɨgirɨ umuhiiri waazɨ wʉnʉ akomorora, atakʉtʉra kʉmʉsɨɨga Mungu wʉnʉ akɨɨrɨ komorora. <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>Mmbe, Mungu atʉhɨɨrɨ riswaja rɨnʉ, wʉwʉʉsi wʉnʉ amʉsɨɨgirɨ Mungu, areenderwa asɨɨgɨ nu umuhiiri waazɨ.<note caller="+" style="f"><char style="fr" closed="false">4:21 </char><char style="xt" closed="false">Rora <ref loc="LEV 19:18">Abharaawi 19:18</ref>; <ref loc="DEU 6:4-5">Amahiityʉ gi Imigirʉ 6:4‑5</ref>; <ref loc="MRK 12:30-31">Maaroko 12:30‑31</ref>.</char></note><verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s">Ubhwisirirya bhʉrahiza ʉbhʉbhɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>Ʉmʉʉtʉ wʉwʉʉsi wʉnʉ akwisirirya Yɨɨsu ni‑Kiriisitʉ, wuyo newe umwana wa Mungu. Wʉwʉʉsi wʉnʉ asɨɨgirɨ bhaabha, asɨɨgirɨ na abhaana bha bhaabha wuyo. <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>Ɨbhu nɨmbu tʉmɨnyirɨ kʉbha tʉsɨɨgirɨ abhaana bha Mungu, kʉ kʉsɨɨga Mungu na kugwata amaswaja gaazɨ. <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/>Ʉkʉsɨɨga Mungu nekwe ukugwata amaswaja gaazɨ. Na kugwata amaswaja gaazɨ kʉtarɨ kʉkʉngʼu, <verse eid="1JN 5:3"/><verse number="4" style="v" sid="1JN 5:4"/>kʉ kʉbha abhaana bhʉʉsi bha Mungu bharahiza ʉbhʉbhɨ bhwɨ ɨɨsɨ. Ɨbhu nɨmbu tukuhiza ga kʉʉsɨ kʉnzɨra yu ubhwisirirya bhwɨtʉ. <verse eid="1JN 5:4"/><verse number="5" style="v" sid="1JN 5:5"/>Nɨ‑wɨɨwɨ wʉnʉ akʉtʉra kuhiza ʉbhʉbhɨ bhwɨ ɨɨsɨ? Nɨ‑wʉnʉ akwisirirya Yɨɨsu ni‑Mwana wa Mungu.<verse eid="1JN 5:5"/></para>
  <para style="s">Ʉbhʉmɨnyɨɨkɨrɨri igʉrʉ wa Yɨɨsu Kiriisitʉ</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6"/>Yɨɨsu Kiriisitʉ newe iizirɨ kwa amanzi na kʉmasaahɨ. Atiizirɨ kwa amanzi ageene, nawe kwa amanzi na kʉmasaahɨ. <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>Ne Ekoro Ɨndɨndu ɨramenyeekererya kʉbha gayo nɨ‑ga amaheene, kʉ kʉbha Ekoro Ɨndɨndu neyo amaheene. <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>Kʉna abhamɨnyɨɨkɨrɨri bhatatʉ bhanʉ bhakomenyeekererya ɨngʼana ya Yɨɨsu [mwisaarʉ: nɨ‑Bhaabha, Ringʼana ne Ekoro Ɨndɨndu, na abhaatʉ bhanʉ, ne kegero kɨmwɨ. <verse eid="1JN 5:8"/><verse number="9" style="v" sid="1JN 5:9"/>Na kʉna atatʉ ganʉ gareerekeererya kʉʉsɨ], Ekoro, amanzi na amasaahɨ, na atatʉ ganʉ gariisiriranʼya. Turiisirirya obhomenyeekererya bhwa abhaatʉ, no obhomenyeekererya bhwa Mungu nebhwe ʉbhʉkʉrʉ bhʉkʉngʼu, kʉ kʉbha bhuyo nebhwe obhomenyeekererya bhʉnʉ Mungu ahurukiryɨ igʉrʉ wu Umwana waazɨ.<verse eid="1JN 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1JN 5:10"/>Wʉwʉʉsi wʉnʉ akwisirirya Umwana wa Mungu, isiriiryɨ kʉbha obhomenyeekererya bhuyo, nɨ‑bhwa amaheene. Nawe wʉnʉ atakwisirirya Mungu, arabhuga Mungu nɨ‑mʉbhɨɨhi, kʉ kʉbha atabhwisiriiryɨ obhomenyeekererya bhʉnʉ Mungu ahurukiryɨ igʉrʉ wu Umwana waazɨ. <verse eid="1JN 5:10"/><verse number="11" style="v" sid="1JN 5:11"/>Obhomenyeekererya bhuyo nebhwe bhʉnʉ: Mungu atʉhɨɨrɨ ʉbhʉhʉru bhwa kemerano. Ʉbhʉhʉru bhuyo tʉrabhobhona kʉnzɨra yu ukwisirirya Umwana waazɨ. <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>Wʉwʉʉsi wʉnʉ anu ubhumwɨmwɨ nu Umwana wa Mungu, anʉ ʉbhʉhʉru bhuyo. Nawe wʉnʉ ataana ubhumwɨmwɨ nu Umwana wa Mungu, ataana ʉbhʉhʉru.<verse eid="1JN 5:12"/></para>
  <para style="s">Amangʼɨɨni gu ubhwikari bhwa kemerano</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13"/>Nɨrabhaandɨkɨra amangʼana gayo, bhanʉ mukwisirirya iriina ryu Umwana wa Mungu, korereke momenye mʉnʉ ʉbhʉhʉru bhwa kemerano. <verse eid="1JN 5:13"/><verse number="14" style="v" sid="1JN 5:14"/>Itwɨ tʉnʉ ʉbhʉkararu mʉbhʉtangɨ bhwa Mungu, kʉ kʉbha tʉmɨnyirɨ kʉbha aratwigwa tʉraamʉsabhɨ ryʉryʉsi kʉrɨngʼaana nʉ ʉbhʉsɨɨgi bhwazɨ. <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>Tʉmɨnyirɨ kʉbha aratwitegeerera hanʉ tʉkʉmʉsabha, neyo enzobhooro tono obhoheene kʉbha aratoha ganʉ tʉkʉmʉsabha.<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>Ʉmʉʉtʉ areerore umuhiiri waazɨ arakora ʉbhʉbhɨ bhʉnʉ bhʉtakʉmʉtʉʉra kore na Mungu kemerano, amʉsabhɨrɨ, na Mungu aramoha ʉbhʉhʉru. Riyo nɨ‑kʉbhanʉ bhakokora ʉbhʉbhɨ bhʉnʉ bhʉtakʉbhatʉʉra kore kemerano. Nawe kʉnʉ ʉbhʉbhɨ bhʉnʉ bhʉkʉtʉʉra ʉmʉʉtʉ kore na Mungu kemerano. Nɨtakubhuga amʉsabhɨrɨ igʉrʉ wʉ ʉbhʉbhɨ bhuyo. <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>Kokora ryʉryʉsi rɨnʉ rɨtakwenderwa mʉbhʉtangɨ bhwa Mungu, nɨ‑bhʉsarya. Nawe hamwɨmwɨ na gayo, bhoreho ʉbhʉbhɨ bhʉnʉ bhʉtakuhira ʉmʉʉtʉ muruku.<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>Tʉmɨnyirɨ abhaana bha Mungu bhatakongʼeha kokora ʉbhʉbhɨ,<note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="xt" closed="false">Rora <ref loc="1JN 3:9">1 Yoohana 3:9</ref>.</char></note> kʉ kʉbha Umwana wa Mungu arabhariibha, na Shɨtaani atakʉtʉra kʉbhakora ryʉryʉsi. <verse eid="1JN 5:18"/><verse number="19" style="v" sid="1JN 5:19"/>Tʉmɨnyirɨ itwɨ, nɨ‑bhaana bha Mungu, nɨ ɨɨsɨ yʉʉsi ɨkakangatwa na Shɨtaani. <verse eid="1JN 5:19"/><verse number="20" style="v" sid="1JN 5:20"/>Na tʉmɨnyirɨ kʉbha Umwana wa Mungu amarirɨ kuuza, atʉhɨɨrɨ amangʼɨɨni, korereke tomenye Mungu wa amaheene. Tunu ubhumwɨmwɨ na Mungu wa amaheene, kʉnzɨra yʉ ʉkʉbha nu ubhumwɨmwɨ nu Umwana waazɨ Yɨɨsu Kiriisitʉ. Wʉnʉ newe Mungu wa amaheene nʉ ʉbhʉhʉru bhwa kemerano.<verse eid="1JN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21"/>Abhaana bhaanɨ abhasɨɨgwa, mʉbhɨ mɨɨsʉ mʉtasengera amasambwa.<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="fk" closed="false">Mʉtasengera amasambwa</char><char style="ft" closed="false">, ʉbhʉgaruri ʉbhʉndɨ bhʉratʉra kʉbha, </char><char style="fqa" closed="false">mwiyangarɨrɨ na chʉchʉsi kɨnʉ kɨkʉtʉra kogega umweya gwa Mungu mokoro yaazʉ.</char></note><verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
