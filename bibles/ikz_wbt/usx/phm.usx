<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">‑ Ikizu Philemon</book>
  <para style="h">Firimʉʉni</para>
  <para style="toc3">Firimʉʉni</para>
  <para style="toc2">Firimʉʉni</para>
  <para style="toc1">Ɨnyarʉbha ya Paaurʉ kwa Firimʉʉni</para>
  <para style="mt2">Ɨnyarʉbha ya Paaurʉ kwa</para>
  <para style="mt1">Firimʉʉni</para>
  <para style="imt">Ʉbhʉkangati</para>
  <para style="ip">Ɨnyarʉbha yɨnʉ ɨkaandɨkwa nu umutumwa Paaurʉ kʉmʉʉtʉ wʉnʉ aarɨ arabhirikirwa Firimʉʉni. Ɨrarorekana Firimʉʉni aarɨ ariikara mʉrʉbhɨri rwa Korosaayi (Abhakorosaayi 4:9). Aarɨ muniibhi, naatu aarɨ na bhambʉʉsa. Firimʉʉni wuyo aarɨ Mukiriisitʉ, na munyumba yaazɨ nɨmu bhaarɨ bhariibhiringa Abhakiriisitʉ. Paaurʉ na Firimʉʉni bhakiimenya bhwaheene.</para>
  <para style="ip">Paaurʉ akaandɨka ɨnyarʉbha yɨnʉ hanʉ aarɨ mokebhoho mʉrʉbhɨri rwa Ruumi. Akaandɨka ɨnyarʉbha yɨnʉ igʉrʉ wa mbʉʉsa wʉmwɨ wa Firimʉʉni, wʉnʉ aarɨ arabhirikirwa Ʉnɨsimʉ. Ɨrarorekana kʉbha mbʉʉsa wuyo akangʼosa Firimʉʉni. Akʉmara akarumana na Paaurʉ. Neho, Paaurʉ akamomenyeekererya Ɨngʼana Ɨnzʉmu igʉrʉ wa Yɨɨsu. Akʉmara, Ʉnɨsimʉ akiisirirya, akasabhʉka.</para>
  <para style="ip">Kwibhaga riyo, mbʉʉsa wʉwʉʉsi araangʼose umuniibhi waazɨ, akʉmara akagwatwa, umuniibhi waazɨ aarɨ nʉ ʉbhʉnaja bhwu ukumwita. Nangʉ Paaurʉ aarɨ aratʉma Ʉnɨsimʉ kumuniibhi waazɨ Firimʉʉni. Neho Paaurʉ akaha Ʉnɨsimʉ ɨnyarʉbha yɨnʉ ahirɨrɨ Firimʉʉni. Mʉnyarʉbha yiyo Paaurʉ akasabha Firimʉʉni asʉngʼaanɨ Ʉnɨsimʉ nchʉ ʉmʉkɨndichazɨ, na ncha abhahiiri kwa Kiriisitʉ.</para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="s">Amakeerenʼya</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>Ɨnyarʉbha yɨnʉ nandikirɨ inyɨ Paaurʉ, omobhohwa igʉrʉ wu ukwerekeererya Ɨngʼana Ɨnzʉmu igʉrʉ wa Yɨɨsu Kiriisitʉ, hamwɨmwɨ na Timoseo umwisirirya ʉmʉkɨndichɨtʉ. Nɨrakwandɨkɨra awɨ Firimʉʉni, ʉmʉsɨɨgwa wɨɨtʉ, omohocha ʉmʉkɨndichɨtʉ. <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>Tʉrakeerya nu umusubhaati Afiya nu umwitani ʉmʉkɨndichɨtʉ Arikipʉ, hamwɨmwɨ na abhaatʉ bha risengerero bhanʉ bhari yɨɨka waazʉ.<verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>Ɨbhɨgʉngi no omorembe kurwa kwa Bhaabha Mungu, na kʉMʉkʉrʉ Yɨɨsu Kiriisitʉ, bhɨbhɨ na niimwɨ.<verse eid="PHM 1:3"/></para>
  <para style="s">Ʉbhʉsɨɨgi nu ubhwisirirya bhwa Firimʉʉni</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>Ribhaga ryʉsi hanʉ nɨkʉkʉsabhɨra, nɨramukumya Mungu, <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>kʉ kʉbha niriigwa ʉrakaja kwisirirya Ʉmʉkʉrʉ Yɨɨsu na kʉbhasɨɨga abharɨndu bhʉʉsi bha Mungu. <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>Nɨrasabha Mungu ubhwisirirya bhʉnʉ ukugwatana hamwɨmwɨ na niitwɨ, bhʉkʉnajɨ komenya bhwaheene ʉrʉbhangʉ rwʉsi rʉnʉ tʉnarwɨ ku kugwatana na Kiriisitʉ. <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>Umuhiiri waanɨ, ʉbhʉsɨɨgi bhwazʉ bhʉnzʉmɨɨrɨ na kʉʉnaja bhʉkʉngʼu, kʉ kʉbha ʉsambarukiryɨ zekoro za abharɨndu bha Mungu.<verse eid="PHM 1:7"/></para>
  <para style="s">Paaurʉ arasabha Firimʉʉni abheerere Ʉnɨsimʉ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>Nʉʉrʉbhu, nangʉ kurwa kʉ ʉbhʉnaja bhʉnʉ nɨhɨɨrwɨ na Kiriisitʉ, nangaturirɨ kukuswaja kokora kɨnʉ ukwenderwa kokora. <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>Nawe igʉrʉ wʉ ʉbhʉsɨɨgi nɨrakwisasaama, kʉ kʉbha niinyɨ Paaurʉ, ʉmʉkaruka no omobhohwa igʉrʉ wa Yɨɨsu Kiriisitʉ. <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>Nangʉ nɨrakʉsabha igʉrʉ wu umwana waanɨ Ʉnɨsimʉ,<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fk" closed="false">Ʉnɨsimʉ </char><char style="ft" closed="false">enzobhooro yaazɨ nɨ‑wʉnʉ akwenderwa kokora ingʼana irebhe.</char></note> wʉnʉ nasakiiryɨ komomenya Kiriisitʉ, nɨrɨ mokebhoho. <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>Inyuma hayo, ewe aarɨ atakwenderwa kwa naawɨ, nawe nangʉ areenderwa kwa niinyɨ na naawɨ waku.<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>Nangʉ nɨragarucha kwa naawɨ, Ʉnɨsimʉ wʉnʉ nɨsɨɨgirɨ kumwʉyʉ gwanɨ gwʉsi. <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>Naarɨ nɨrasɨɨga iikarɨ uwaanɨ, korereke abhone umweya gwʉ kʉnsakirya igʉrʉ waazʉ, hanʉ nɨkʉbha mokebhoho igʉrʉ wɨ Ɨngʼana Ɨnzʉmu. <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>Nawe nɨtɨɨndirɨ kokora ryʉryʉsi nɨtaana rʉgʉsa rwazʉ, korereke ʉbhʉzʉmu bhwazʉ bhʉtabha ncha bhwi ihatɨkɨ, nawe bhʉbhɨ bhwa kwenda awɨ aumwene.<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>Hamwɨ, Ʉnɨsimʉ akarwa kwa naawɨ kwibhagabhu, korereke ʉbhɨ nawe ribhaga ɨrɨndɨ kemerano. <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>Kʉtangɨra nangwɨnʉ, ewe atarɨ ncha mbʉʉsa kwa naawɨ, nawe ewe nɨ mʉzʉmu kʉkɨra mbʉʉsa, aangɨ umuhiiri ʉmʉsɨɨgwa. Inyɨ nɨmʉsɨɨgirɨ bhʉkʉngʼu, awɨ ʉmʉsɨɨgirɨ kʉnkɨra, ncha mbʉʉsa wɨ waazʉ, na kʉ kʉbha awɨ neewe mugwatɨɨnɨ nʉ Ʉmʉkʉrʉ Yɨɨsu.<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>Mmbe, nangʉ arɨɨbhɨ ʉramenya kʉbha inyɨ nɨrɨ hamwɨmwɨ na naawɨ, ʉsʉngʼaanɨ wuyo chɨmbu wangansʉngʼaanirɨ inyɨ. <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>Na arɨɨbhɨ Ʉnɨsimʉ aakʉsaririryɨ ingʼana ryʉryʉsi, hamwɨ ʉramutunʼya ekegero, untunʼyɨ inyɨ. <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>Inyɨ Paaurʉ, nɨraandɨka kokobhoko kwanɨ inyimwene, nɨrakʉrɨha. Nɨtakukuhiitya kʉbha nɨrakutunʼya, kʉ kʉbha ku kwerekeererya kwanɨ, awɨ ʉkasabhurwa. <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>Nangʉ, umuhiiri waanɨ, onkorere rɨnʉ igʉrʉ wʉ Ʉmʉkʉrʉ, sambaarucha umwʉyʉ gwanɨ nchu umuhiiri kwa Kiriisitʉ.<verse eid="PHM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21"/>Nɨrakwandɨkɨra ganʉ, kʉ kʉbha nɨɨzɨ ʉragiisirirya, na ʉrakora kʉkɨraho ganʉ nɨsabhirɨ.<verse eid="PHM 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22"/>Hamwɨmwɨ na gayo, onkonzere hu ukwikara, kʉ kʉbha niriisega kʉmasabhi gaanyu, Mungu aransakirya niizɨ kwa niimwɨ.<verse eid="PHM 1:22"/></para>
  <para style="s">Amangʼana gʉ ʉkʉraga</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>Ɨpafura, omobhohwa ʉmʉkɨndichanɨ igʉrʉ wa Yɨɨsu Kiriisitʉ, arakokeerya. <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>Na abhahocha abhakɨndichanɨ Maaroko, Arisitʉʉrikʉ, Deema na Ruuka, bhʉʉsi bharakokeerya. <verse eid="PHM 1:24"/><verse number="25" style="v" sid="PHM 1:25"/>Ɨbhɨgʉngi bhyʉ Ʉmʉkʉrʉ Yɨɨsu Kiriisitʉ bhɨbhɨ na niimwɨ bhʉʉsi.<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
