<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">‑ Ikizu James</book>
  <para style="h">Yaakobho</para>
  <para style="toc3">Yaakobho</para>
  <para style="toc2">Yaakobho</para>
  <para style="toc1">Ɨnyarʉbha ya Yaakobho</para>
  <para style="mt2">Ɨnyarʉbha ya</para>
  <para style="mt1">Yaakobho</para>
  <para style="imt">Ʉbhʉkangati</para>
  <para style="ip">Ɨnyarʉbha yɨnʉ yandikirwɨ na Yaakobho. Abhamɨnyi bhaaru bhariisirirya Yaakobho wʉnʉ aarɨ umuhiiri wa Yɨɨsu. Yaakobho aarɨ ʉmʉkangati wa risengerero rya Yɨrusarɨɨmu (<char style="xt"><ref loc="ACT 15:13">Amahocha ga Abhatumwa 15:13</ref>; <ref loc="GAL 2:9">Abhagaraatiya 2:9</ref></char>). Yaakobho akaandɨka ɨnyarʉbha yiyo kʉbhɨɨga bha Yɨɨsu bhɨ Ɨkɨyaahudi, hanʉ bhanyaragɨɨnɨ mubhyarʉ ɨbhɨndɨ.</para>
  <para style="ip">Yaakobho akaandɨka ɨnyarʉbha yaazɨ kwija Abhakiriisitʉ bhatunɨ amangʼɨɨni ga Mungu. Bhaangɨ heene heene amangʼɨɨni ganʉ gakurwa kwa Shɨtaani (3:13‑18). Akiija kʉbha ukwisirirya rɨtarɨ ingʼana rya amiisɨɨgibhu, nawe ereenderwa amahocha gabheho. Mʉnyarʉbha yɨnʉ Yaakobho akabhabhʉʉrɨra Abhakiriisitʉ, ubhwisirirya bhwabhʉ kwa Kiriisitʉ bhororekanɨ kʉmahocha ne emeremo jabhʉ. Akabheerekeererya igʉrʉ wɨ ɨnyaakʉ, ikisiraani, ɨnamba ni iryʉmana. Akagambɨra ganʉ gakwenderwa mubhwikari bhu Umukiriisitʉ: ʉbhʉrɨndu, ʉbhʉnyʉʉhu nu ubhwigumirirya.</para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="s">Amakeerenʼya</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>Ɨnyarʉbha yɨnʉ nandikirɨ inyɨ Yaakobho, omohocha wa Mungu na wʉ Ʉmʉkʉrʉ Yɨɨsu Kiriisitʉ, kʉbhɨgambʉ ikumi na bhɨbhɨrɨ, bhanʉ mʉnyaragɨɨnɨ mubhyarʉ ɨbhɨndɨ. Nɨrabhakeerya!<verse eid="JAS 1:1"/></para>
  <para style="s">Mʉbhɨ no obhozomerwa hanʉ mokogemwa</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>Abhahiiri bhaanɨ, mʉbhɨ no obhozomerwa hanʉ mokobhona ibhitiimotiimo bhyʉbhyʉsi, <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>kʉ kʉbha, mwɨzɨ okogemwa kubhwisirirya bhwanyu kʉrabhareetera ubhwigumirirya. <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>Mʉbhɨ ne eheene kʉbha muriigumirirya kuhika mʉtɨnɨrʉ, korereke mʉbhɨ bhanagu, mʉtaaza kusuuhirwa na kegero.<verse eid="JAS 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 1:5"/>Nawe wʉmwɨ waanyu araasuuhirwɨ ubhwʉbhʉʉri, ereenderwa asabhɨ Mungu, wʉʉsi arahaabhwa. Mungu ahaabhaha abhaatʉ bhʉʉsi kwa bhozomerwa, na ataana kiriiso. <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>Nawe hanʉ akʉsabha Mungu, ereenderwa asabhɨ kubhwisirirya, atigɨ ʉrʉhaho, kʉ kʉbha arɨɨbhɨ ʉmʉʉtʉ anʉ ʉrʉhaho, arabha ncha amakunda ga mʉnyanza ganʉ gakotemwa nʉ ʉmʉkama ɨnʉ ni iyo. <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>Ʉmʉʉtʉ we eteemwa yiyo, atakina arabhona ekegero chʉchʉsi kurwa kʉMʉkʉrʉ. <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>Ewe nɨ‑wa amiisɨɨgi abhɨrɨ, aratitiikana kʉzɨnzɨra zaazɨ zʉʉsi.<verse eid="JAS 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>Umukiriisitʉ ʉmʉhabhɨ, areenderwa azomerwe kʉ kʉbha aranungwa na Mungu. <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>Nawe umuniibhi, azomerwe kʉ kʉbha Mungu aramwicha, araaza kʉnyaara nchɨ ɨbhɨbharyʉ bhya mwitɨrɨgʉ.<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="xt" closed="false">Rora <ref loc="JER 9:23">Yɨrɨmiya 9:23</ref>.</char></note> <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>Iryʉbha rɨhaasomoka nʉ ʉmwɨ guhuumya ɨbhɨtʉʉtʉ, nɨ ɨbhɨbharyʉ bhɨhaatorobhoka nʉ ʉbhʉzʉmu bhwaku bhʉhaarika. Ɨbhu nɨmbu umuniibhi wʉʉsi, akukwa arɨ momeremo jazɨ.<verse eid="JAS 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>Hakɨrɨku ʉmʉʉtʉ wʉnʉ akwigumirirya kogemwa, kʉ kʉbha hanʉ ariihizɨ ebhegemo, Mungu aramoha ɨkɨrʉngʉ chʉ ʉbhʉhʉru bhwa kemerano, chɨmbu aaragɨɨnʼyɨ kʉbhaha bhʉʉsi bhanʉ bhamʉsɨɨgirɨ.<verse eid="JAS 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 1:13"/>Hanʉ ʉmʉʉtʉ araagemwe, atabhuga, “Nɨragemwa na Mungu,” kʉ kʉbha Mungu atahaagemwa na amabhɨ, neewe umwene atakogema ʉmʉʉtʉ wʉwʉʉsi. <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>Nawe ʉmʉʉtʉ ahaagemwa ku kurutwa na kʉkangiribhwa nɨ ɨnamba yo okokora amabhɨ. <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>Hanʉ ɨnamba ekokongʼa ɨhaareeta ʉbhʉbhɨ, na hanʉ ʉbhʉbhɨ bhʉhaakongʼa bhʉrareeta uruku.<verse eid="JAS 1:15"/></para>
  <para style="s">Mutiikangirirya igʉrʉ wʉ ʉbhʉzʉmu bhwa Mungu</para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>Kwɨbhu abhahiiri bhaanɨ abhasɨɨgwa, mʉtakangiribhwa. <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>Ebhegero bhyʉsi ɨbhɨzʉmu bhɨnʉ tʉkʉhaabhwa, bhɨhaarwa mwisaarʉ kwa Mungu, Umubhumbi wu ubhwɨrʉ. Na atakwichʉrachʉra nchi ikikiriiri kɨnʉ kɨkʉsaamasaama. <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>Chɨmbu umwene ɨɨndirɨ, akatokora tʉbhɨ abhaana bhaazɨ, kʉnzɨra ya ringʼana ryazɨ rya amaheene, korereke tʉbhɨ mʉbhʉtangɨ bhwa bhyʉsi bhɨnʉ aatɨɨmirɨ.<verse eid="JAS 1:18"/></para>
  <para style="s">Mwigwɨ ɨngʼana ya Mungu na kʉyɨsʉʉka</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>Abhahiiri bhaanɨ abhasɨɨgwa, munyiitegeerere bhwaheene! Abhaatʉ bhʉʉsi bhabhɨ bhangʉ bhu ukwitegeerera, nawe bhatabha bhangʉ bha kʉgamba hamwɨ kwigatana, <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>kʉ kʉbha, hanʉ ʉmʉʉtʉ ariigatanɨ, atakokora ge eheene ganʉ gakwenderwa na Mungu. <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>Kwɨbhu mʉtangʼeha kokora amahocha ganʉ gataana bhwera, hamwɨmwɨ na amabhɨ ganʉ gahɨtɨrɨɨnʼyɨ, na kugwata kwa bhʉnyʉʉhu ringʼana rɨnʉ Mungu atɨɨrɨ mozekoro zaanyu, kʉ kʉbha riyo neryo rɨkʉtʉra kʉbhasabhʉra.<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>Nangʉ mokore chɨmbu ɨngʼana ya Mungu ikubhuga. Mutiikangirirya imubheene kwa kwitegeerera ukwene. <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>Wʉwʉʉsi wʉnʉ akwitegeerera ringʼana ryazɨ, nawe atakokora chɨmbu rikubhuga, wuyo aangɨ nchʉ ʉmʉʉtʉ wʉnʉ akwirora ubhushʉ bhwazɨ kokerore bhwaheene, <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>arɨɨmarɨ kurwa kokerore, ahɨɨbha chɨmbu arɨ. <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>Nawe ʉmʉʉtʉ arore bhwaheene imigirʉ ɨmɨnagu gɨnʉ gekoha abhaatʉ ubhwiyagaaruri. Arɨɨbhɨ arangʼeha kutuna imigirʉ na kʉtama kwɨbha ganʉ iigwirɨ, wuyo newe akʉhaabhwa ʉrʉbhangʉ na Mungu kwa kɨnʉ akokora.<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>Arɨɨbhɨ ʉmʉʉtʉ ariirore arakora ganʉ gakozomera Mungu, nawe atakwirecha kʉgamba ganʉ gatakwɨndibhwa, ɨnʉ ariikangirirya kumutuna Mungu, bhʉtareeho bhwera kwewe. <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>Amahocha ganʉ gakozomera Bhaabha wɨɨtʉ Mungu na ganʉ akorora gataana bhʉbhɨ, nɨ‑kʉsakirya abhaana bhanʉ bhakwiriirwɨ abhiibhuri na abhakwirwa mʉzɨnyaakʉ zaabhʉ, na kwiriibha nʉ ʉbhʉsarya bhwɨ ɨɨsɨ yɨnʉ.<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s">Mʉtabha nɨ ɨkɨmbʉrʉʉri</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>Abhahiiri bhaanɨ, kʉ kʉbha mwisiriiryɨ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ wʉ ʉbhʉgʉngʉ, mʉtabha nɨ ɨkɨmbʉrʉʉri kʉbhaatʉ. <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>Tubhugɨ kʉbha ʉmʉʉtʉ wʉnʉ ibhʉhirɨ zengebho zɨnzʉmu ne epete yɨ ɨzahaabhu kuchara, asikiirɨ kukiikarʉ chanyu. Akʉmara, ʉmʉhabhɨ wʉʉsi akasikɨra, wʉnʉ ibhʉhirɨ ɨbhɨsagi. <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>Akʉmara, mʉkaginihya wʉnʉ ibhʉhirɨ bhwaheene na kʉmʉsʉʉka na kʉmʉbhʉʉrɨra, “Ikara hanʉ, neho ahazʉmu.” Na mʉkabhʉʉrɨra ʉmʉhabhɨ wurya, “Awɨ wiimɨɨrɨrɨ harya,” hamwɨ, “Wiikarɨ haasɨ hanʉ mʉmagʉrʉ gaanɨ.” <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>Kwa kokorabhu mʉkɨɨrɨ kwiyaahʉra? Na mʉtakorora mutiniirɨ kumiisɨɨgi gaanyu amabhɨ?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>Abhahiiri bhaanɨ abhasɨɨgwa, munyiitegeerere. Mungu arʉbhwɨrɨ abhahabhɨ bhɨ ɨɨsɨ yɨnʉ korereke bhabhɨ abhaniibhi bhu ubhwisirirya, na abhagabhi bhʉ ʉbhʉtɨmi bhʉnʉ aaragirɨ kʉbhanʉ bhamʉsɨɨgirɨ. <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>Nawe, imwɨ mʉrabhazeera abhahabhɨ bhʉkʉngʼu! Nangʉ abhaniibhi bhayo bhatarɨ nebho bhakʉbhakindagirya? Bhayo bhatakʉbhahira mʉbhʉtangɨ bhwa abhatiniri bhi imigirʉ? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>Na kʉtʉka iriina rizʉmu rya Yɨɨsu Kiriisitʉ wʉnʉ imwɨ, nɨ‑bhaatʉ bhaazɨ?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>KʉMaandɨkʉ Amarɨndu, umugirʉ gwʉ ʉbhʉtɨmi bhwa Mungu gʉrabhuga, “Ʉmʉsɨɨgɨ nyarʉbhɨri waazʉ chɨmbu wisɨɨgirɨ aumwene.”<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="xt" closed="false">Rora <ref loc="LEV 19:18">Abharaawi 19:18</ref>.</char></note> Arɨɨbhɨ mʉrakorabhu, mʉrakora bhwaheene. <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>Nawe, muryahʉrɨ abhaatʉ, mʉrakora ʉbhʉbhɨ, ni imigirʉ gɨrabhuga imwɨ nɨ‑bhasarya bha migirʉ.<verse eid="JAS 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 2:10"/>Ʉmʉʉtʉ araagwatɨ imigirʉ jʉsi, nawe asaryɨ ʉgʉmwɨ, arabharwa asariryɨ jʉsi. <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>Kʉ kʉbha, wʉnʉ atɨɨrɨ umugirʉ gʉnʉ gukubhuga, “Ʉtasebheeta,” newe atɨɨrɨ na gʉnʉ gukubhuga, “Utiita.”<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="xt" closed="false">Rora <ref loc="EXO 20:13-14">Kʉhʉrʉka 20:13‑14</ref>; <ref loc="DEU 5:17-18">Amahiityʉ gi Imigirʉ 5:17‑18</ref>.</char></note> Mmbe, nangabha ʉtasɨbhɨɨtirɨ, nawe ʉmarirɨ kwita, ʉrabharwa ʉsariryɨ imigirʉ.<verse eid="JAS 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 2:12"/>Mmbe, mʉgambɨ na kokora, ɨnʉ mʉrahiita kʉbha Mungu arabhatɨnɨra imigirʉ gɨnʉ gekoreeta kutigurukirwa. <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>Mungu atakʉbha nɨ ɨbhɨgʉngi hanʉ akʉtɨnɨra ʉmʉʉtʉ wʉnʉ ataana bhɨgʉngi. Nawe ɨbhɨgʉngi nebhyo bhɨhaahiza ɨtɨnɨrʉ yi imigirʉ!<verse eid="JAS 2:13"/></para>
  <para style="s">Ubhwisirirya na amahocha</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>Abhahiiri bhaanɨ, kʉna bhwerakɨ kʉmʉʉtʉ wʉnʉ akubhuga anu ubhwisirirya, nawe ataana amahocha amazʉmu? Ubhwisirirya bhuyo bhʉratʉra kʉmʉsabhʉra? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>Arɨɨbhɨ umuhiiri waazʉ wi ikisubhɨ hamwɨ wɨ ɨkɨkari ataana zengebho hamwɨ ibhyakurya, <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>nʉ ʉwʉmwɨ waanyu akamʉbhʉʉrɨra, “Nuujɨ no omorembe, woote omorero na kwigʉta,” nawe atamʉsakirya kwa kumwibhohya hamwɨ kumwigutya, ni‑bhwerakɨ bhʉnʉ amʉkʉrɨɨrɨ? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>Nɨmbu bhʉrɨ, ubhwisirirya bhʉnʉ bhʉtaana amahocha, ni‑bhwisirirya bhʉnʉ bhukuurɨ.<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>Nawe ʉmʉʉtʉ araabhugɨ, “Awɨ unu ubhwisirirya, inyɨ nɨna amahocha amazʉmu.”</para>
  <para style="p" vid="JAS 2:18">Mmbe, nyeerecha chɨmbu ʉraatʉrɨ kʉbha nu ubhwisirirya ɨnʉ ʉtaana amahocha. Inyɨ nɨrakwerecha ubhwisirirya bhwanɨ kʉmahocha gaanɨ amazʉmu. <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>Awɨ wiisiriiryɨ kʉbha areho Mungu wʉmwɨbhu? Nɨmbu! Ʉkʉrirɨ bhwaheene! Ndora amasambwa gʉʉsi, gariisirirya na kurigita kubhwʉbha!<verse eid="JAS 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 2:20"/>Awɨ, ne‑mogeege! Ʉkɨɨrɨ oreenda kwerechwa, ubhwisirirya bhʉnʉ bhʉtaana amahocha amazʉmu, bhʉtaana bhwera? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>Mungu akabhara sʉʉkʉrʉ wɨɨtʉ Abhurahaamu<note caller="+" style="f"><char style="fr" closed="false">2:21 </char><char style="fk" closed="false">Abhurahaamu</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> we eheene mʉbhʉtangɨ bhwazɨ, igʉrʉ wa amahocha amazʉmu ganʉ aakʉrirɨ, kuhurucha umwana waazɨ Iisaka, abhɨ ikimweso chu ukwitwa ahagero hu ukuhurukirya ikimweso.<figure style="fig" alt="Abhrahamu anatoa mwana wake kuwa dhabihu" file="co00664c.TIF" size="col" loc="JAS 2:21" copy="© 1996 David C Cook. Used by permission." ref="2:21">Abhuraamu arahurucha umwana waazɨ kʉbha ikimweso</figure> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>Ʉrarora chɨmbu ubhwisirirya bhwa Abhurahaamu bhwarɨ bhʉrahirana na amahocha gaazɨ, na kʉnagibhwa kʉnzɨra ya amahocha gaazɨ. <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>Kwɨbhu gakabha Amaandɨkʉ Amarɨndu ganʉ gakubhuga, “Abhurahaamu akiisirirya Mungu, na Mungu akamʉbhara we eheene.”<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="xt" closed="false">Rora <ref loc="GEN 15:6">Ʉbhʉtangɨ 15:6</ref>.</char></note> Abhurahaamu, newe aarɨ arabhirikirwa ʉmʉsaani wa Mungu.<verse eid="JAS 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JAS 2:24"/>Mmbe, mʉrarora kʉbha ɨtakʉtʉrɨkana ʉmʉʉtʉ kʉbharwa we eheene mʉbhʉtangɨ bhwa Mungu, kʉnzɨra yu ubhwisirirya ubhwene. Nawe areenderwa kʉbha nu ubhwisirirya no kokora amahocha amazʉmu.<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>Nɨmbu Rahaabhu umusimbɨ wurya, wʉʉsi akabharwa we eheene mʉbhʉtangɨ bhwa Mungu, igʉrʉ wa amahocha amazʉmu ganʉ aakʉrirɨ. Akaginihya abhabhuuririrya bharya, na kʉbhasakirya bhajɨ, kʉ kʉhɨtɨra ɨnzɨra ɨyɨndɨ.<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="xt" closed="false">Rora <ref loc="JOS 2:1-24">Yoosho 2:1‑24</ref>, <ref loc="JOS 6:22-25">6:22‑25</ref>.</char></note><verse eid="JAS 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26"/>Mmbe, arɨɨbhɨ ʉmʉʉtʉ anu ubhwisirirya nawe ataana amahocha amazʉmu, ubhwisirirya bhwazɨ bhuyo bhukuurɨ, nchʉ ʉmʉbhɨrɨ gʉnʉ gʉtaana ekoro, gwʉsi gukuurɨ.<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s">Mwiriibhɨ kʉmagamba</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>Abhahiiri bhaanɨ, mʉtabha na abhiija bhaaru gatɨ waanyu, chɨmbu mwɨzɨ itwɨ abhiija tʉratinirwa bhʉkʉngʼu kʉkɨra abhandɨ. <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>Kʉmaheene, abhaatʉ bhʉʉsi bhahaabha bharasarya kʉmangʼana maaru. Arɨɨbhɨ kʉnʉ ʉmʉʉtʉ wʉwʉʉsi atakʉhabha kʉmagamba, ewe nɨ‑mʉʉtʉ mʉnagu, na aratʉra kwiriibha umwene.<verse eid="JAS 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JAS 3:3"/>Rora, tʉhaabhoha zɨfaraasi ichʉma kuminywa korereke zitwigwɨ, kʉnzɨra yiyo tʉratʉra kʉzɨkangata hʉhʉʉsi hanʉ tukwenda.<figure style="fig" file="lb00035b.tif" size="col" loc="JAS 3:3" copy="Louise Bass © The British &amp; Foreign Bible Society, 1994" ref="3:3">Ʉmʉʉtʉ arakangata ɨfaraasi kwa kugwatɨrɨra urusiri rwi ichʉma</figure> <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>Rora ubhwatʉ bhwʉsi, nangabha nɨ‑bhʉkʉrʉ bhʉkʉngʼu, na bhʉrahumbutwa nʉ ʉmʉkama ʉmʉhaari, nawe bhʉrakangatwa nu urusukaani rwʉ ʉkʉkangata rusuuhu bhʉkʉngʼu, kuja hʉhʉʉsi hanʉ ʉmʉkangati areende bhujɨ. <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>Nɨmbu ɨrɨ, ʉrʉrɨmɨ rwʉsi ni‑kiimʉ kisuuhu kʉmʉbhɨrɨ, nawe runu ubhwiyungi bhʉkʉrʉ bhʉkʉngʼu. Rora chɨmbu ɨsasɨ yo omorero ɨhaaranda na kutumɨka ritɨrɨgʉ rikʉrʉ! <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>Nʉ ʉrʉrɨmɨ rwʉsi rwangɨ omorero, nerwe rwizwirɨ ʉbhʉbhɨ bhwʉsi, na ruri mubhiimʉ bhyɨtʉ bhyʉ ʉmʉbhɨrɨ. Rʉranyaraganʼya ʉbhʉbhɨ kʉmʉbhɨrɨ gwʉsi, rʉraricha ubhwikari bhwɨtʉ ncho omorero gʉnʉ gukurwa nyaari.<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="fk" closed="false">Nyaari</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note><verse eid="JAS 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7"/>Abhaatʉ bharatʉra kutuga ibhityɨnyi bhya teemwa zʉʉsi, ibhityɨnyi bhya mwitɨrɨgʉ, ibhinyunyi, bhɨnʉ bhekogendera zɨnda, ziiswɨ ni ibhityɨnyi bhyʉsi bhya mʉnyanza, na bhɨmarirɨ kutugwa na abhaatʉ. <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>Nawe atareeho ʉmʉʉtʉ wʉnʉ akʉtʉra kwangarɨra ʉrʉrɨmɨ, nɨ‑rʉbhɨ, rʉtakohoreera na rwizwirɨ ʉbhʉsʉngʉ bhu ukwita.<verse eid="JAS 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 3:9"/>Kʉrʉrɨmɨ tʉrakumya Bhaabha wɨɨtʉ Ʉmʉkʉrʉ na kʉrʉrɨmɨ ruyoruyo turiihiima abhaatʉ bhanʉ bhabhumbirwɨ na Mungu kokerenjo chazɨ. <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>Mumunywa gʉmwɨ guryagurya, nɨmu gahaarwa amangʼana gu ukukumya, na gu ukwihiima. Abhahiiri bhaanɨ, gayo gatakwenderwa gabhɨbhu. <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>Ɨtakʉtʉrɨkana ɨkɨsɨɨzɨ kɨmwɨ kihuruchɨ amanzi amasambaruku na amanzi amarʉrʉ! <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>Abhahiiri bhaanɨ, ɨratʉrɨkana ʉmʉtɨ gu umutiini gwibhʉrɨ imisumʉ jɨ ɨmɨzɨyituuni? Hamwɨ ʉmʉtɨ gʉ ʉmʉzabhiibhu gwibhʉrɨ imisumʉ ju umutiini? Nʉʉrʉ ɨkɨsɨɨzɨ cha amanzi gʉ ʉmʉʉnyʉ kɨtakʉtʉra kuhurucha amanzi amasambaruku.<verse eid="JAS 3:12"/></para>
  <para style="s">Wɨɨgɨ na kokora ubhwʉbhʉʉri bhwa Mungu</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>Nɨ‑wɨɨwɨ kʉbhaniimwɨ, wʉnʉ ana amangʼɨɨni nu ubhwʉbhʉʉri? Mmbe, erekenʼye okomenya kwazɨ nu ubhwʉbhʉʉri bhwazɨ ko okokora amahocha amazʉmu, kʉbhʉnyʉʉhu bhʉnʉ bhukurwa kubhwʉbhʉʉri.<verse eid="JAS 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 3:14"/>Nawe arɨɨbhɨ mʉna rihari, ʉbhʉrʉrʉ nɨ ɨkɨnyawɨɨtʉ mozekoro zaanyu, mutiikumya kʉbha munu ubhwʉbhʉʉri, na mʉtagamba rʉrɨmɨ kʉ ga amaheene. <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>Ubhwʉbhʉʉri bhwe eteemwa yiyo bhʉtakurwa mwisaarʉ, nawe nɨ‑bhʉbhɨ na bhʉrarwa kwa Shɨtaani.<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="fk" closed="false">Shɨtaani</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>Ahagero hʉʉsi hanʉ hana rihari nɨ ɨkɨnyawɨɨtʉ, hayo neho rirɨgɨ na amabhɨ agandɨ gʉʉsi garɨ.<verse eid="JAS 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 3:17"/>Nawe ubhwʉbhʉʉri bhu ukurwa mwisaarʉ, nɨ‑bhʉzʉmu, na nebhwe bhwo omorembe, na bhwʉ ʉbhʉnyʉʉhu, na nɨ‑bhwa kwitegeerera abhaatʉ. Bhwizwirɨ ɨbhɨgʉngi ni imisumʉ ɨmɨzʉmu, na bhʉtaana kɨmbʉrʉʉri nʉʉrʉ rʉrɨmɨ. <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>Abhaatʉ bho omorembe, bharahamba zendetere zo omorembe, neho bharaagese eheene.<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s">Mwitegeere Mungu</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>Riihɨ ni iryʉmana bhɨnʉ bhɨrɨ gatɨ waanyu, bhɨrarwahe? Ndora bhɨrareetwa ni imyʉyʉ gɨnʉ gɨkʉhakaana mʉʉsi waanyu. <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>Muriigomba ebhegero, nawe hanʉ mʉkʉtama kobhona, muriita. Na mʉrarora ikiriiso, nawe hanʉ mʉkʉtama kobhebhona, mʉrʉʉmana na kwitana. Mʉtakobhona kɨnʉ mukwenda, kʉ kʉbha mʉtakʉsabha kwa Mungu. <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>Hanʉ mʉkʉsabha mʉtakobhona, kʉ kʉbha mʉrasabha kʉnzɨra ɨmbɨ, korereke mobhone kɨnʉ mukwenda kumyʉyʉ janyu.<verse eid="JAS 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4"/>Imwɨ, nɨ‑bhaatʉ bhanʉ mʉtaana bhoronge ncha abhasɨbhɨɨti. Nangʉ mʉtɨɨzɨ ʉkʉbha ʉmʉsaani wɨ ɨɨsɨ, nɨ‑kʉbha umubhisa wa Mungu? Mmbe, wʉwʉʉsi wʉnʉ akwenda kʉbha ʉmʉsaani wɨ ɨɨsɨ, ahiikora kʉbha umubhisa wa Mungu. <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>Mutiiseega yandikirwɨ bhʉʉha mʉMaandɨkʉ Amarɨndu, ekoro yɨnʉ Mungu aatʉtɨɨrɨɨrɨ ɨrarora rihari bhʉkʉngʼu. <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>Nawe Mungu aratwongera ɨbhɨgʉngi, necho kigiriryɨ yandikirwɨ mʉMaandɨkʉ Amarɨndu,</para>
  <para style="q" vid="JAS 4:6">“Mungu ahaanga bhanʉ bhakwiyʉnga,</para>
  <para style="q" vid="JAS 4:6">nawe, ahaabharorera abhanyʉʉhu ɨbhɨgʉngi.”<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="xt" closed="false">Rora <ref loc="PRO 3:34">Mesaari 3:34</ref>.</char></note><verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>Mmbe, mwigwɨ Mungu na mwangɨ Shɨtaani, neho akʉbhangʼosa. <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>Mwisukɨku Mungu, neho wʉʉsi, akubhiisukaku. Imwɨ bhʉ ʉbhʉbhɨ na bha amiisɨɨgi abhɨrɨ, mutigɨ ʉbhʉbhɨ bhwanyu na kokora amazʉmu, naatu mumutunɨ kozekoro zaanyu zʉʉsi.<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="xt" closed="false">Rora <ref loc="PSA 24:3-4">Zabhuri 24:3‑4</ref>.</char></note> <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>Mwigwɨ ʉbhʉsʉngʉ, mʉrɨrɨ nu ukwarama. Ekeseko chanyu, kichurwɨ ɨkɨrɨrʉ, no obhozomerwa bhwanyu, bhʉbhɨ ʉbhʉsʉngʉ. <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>Mwiyichɨ mʉbhʉtangɨ bhwʉ Ʉmʉkʉrʉ, newe araabhagungyɨ.<verse eid="JAS 4:10"/></para>
  <para style="s">Mʉtabha muriigamba</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>Abhahiiri bhaanɨ, mʉtabha muriigobha, kʉ kʉbha wʉnʉ akogobha ʉmʉkɨndichazɨ, hamwɨ kʉmʉtɨnɨra, arabha agʉbhirɨ imigirʉ ja Mungu. Nawe ʉrɨɨtɨnɨrɨ imigirʉ, ʉtakʉbha mohocha wi imigirʉ, ʉrabha umutiniri wi imigirʉ. <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>Mungu umwene, newe akʉtʉʉra imigirʉ, na newe umutiniri wajʉ. Newe akʉtʉra kʉsabhʉra na kuricha. Nawe awɨ nɨ‑wɨɨwɨ, ʉratɨnɨra nyarʉbhɨri waazʉ?<verse eid="JAS 4:12"/></para>
  <para style="s">Mutiikumya kʉganʉ mʉkɨɨrɨ kʉbha nagʉ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>Nangʉ, munyiitegeerere bhwaheene, bhanʉ mukubhuga, “Reero hamwɨ tabhʉʉri, tʉraja ʉrʉbhɨri ororebhe. Na turiikara iyo umwaka mugima, tʉrakora ubhusuruja na kobhona esorobho.” <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>Nawe mʉtɨɨzɨ ganʉ gakʉhʉrʉka tabhʉʉri! Ubhwikari bhwazʉ nɨkɨ? Ndora bhwangɨ umwʉki, gʉrarorekana kwibhaga isuuhu, rogendo rʉmwɨ gʉrabhʉra! <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>Moreenderwa, mʉbhɨ mʉrabhuga, “Ʉmʉkʉrʉ araasɨɨgɨ, tʉbhɨ bhahʉru tʉrakora kɨnʉ hamwɨ kirya.” <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>Nawe nangʉ imwɨ, muriikumya kʉganʉ mukwiseega kokora. Nu ukwikumya kuyo, nɨ‑kʉbhɨ. <verse eid="JAS 4:16"/><verse number="17" style="v" sid="JAS 4:17"/>Mmbe, wʉnʉ amɨnyirɨ kokora amazʉmu nawe atakokora, wuyo arakora ʉbhʉbhɨ.<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s">Abhaniibhi abhasɨɨgʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>Imwɨ abhaniibhi, munyiitegeerere bhwaheene! Mʉrɨrɨ na kwarama kwiraka ikʉrʉ, igʉrʉ wɨ ɨnyaakʉ ɨkʉrʉ yɨnʉ ɨkʉbhaazaku. <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>Ubhuniibhi bhwanyu bhʉbhʉrirɨ, na amiibhoho gaanyu gariirwɨ nu umuswa. <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>Ɨzahaabhu yanyu na zimpirya, zɨrabha zɨkɨrɨbhirɨ, nʉ ʉbhʉkɨrɨbhi bhuyo bhʉrabhamenyeekererya, bhʉrarya ɨmɨbhɨrɨ janyu ncho omorero. Na mwitɨɨrɨɨrɨ ibhibhumbikʉ kuzisikʉ zɨ ɨtɨnɨrʉ ziyo.<verse eid="JAS 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 5:4"/>Mwitegeerere, abhahocha bhaanyu bhararɨrɨɨrɨra! Bhakabhakorera emeremo mʉmɨgʉndʉ janyu, nawe mʉtaabharihirɨ. Na bhayo bhakabhagesera ibhyakurya, bhʉʉsi bhakarɨrɨɨrɨra, nɨ ɨkɨrɨrʉ chabhʉ chigwirwɨ mʉmatwɨ gʉ Ʉmʉkʉrʉ wʉ Ʉbhʉnaja Bhwʉsi. <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>Mwikɨɨrɨ na kozomererwa ubhuniibhi bhwanyu kʉʉsɨ hanʉ, kwa kʉtama komenya kʉbha Mungu arabhatɨnɨra na kwinenehya nchu umutugʉ gʉnʉ gukuja kusinzwa. <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>Mutiniirɨ na kwita we eheene wʉnʉ atabhahakaniryɨ imwɨ.<verse eid="JAS 5:6"/></para>
  <para style="s">Mwigumiriryɨ ku kuuza kʉ Ʉmʉkʉrʉ Yɨɨsu</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>Mmbe abhahiiri bhaanɨ, mwigumiriryɨ kuhika ribhaga ryʉ ʉkʉgarʉka kʉ Ʉmʉkʉrʉ. Rora umurimi chɨmbu ahiigumirirya, kʉrɨnda ibhyakurya bhyazɨ bhebhone imbura ye embere na yɨ ɨtɨnɨrʉ, neho abhone ibhyakurya ɨbhɨzʉmu bhyu ubhwera.<verse eid="JAS 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 5:8"/>Kwɨbhu na niimwɨ mwigumiriryɨ, na mʉnajɨ zekoro zaanyu, kʉ kʉbha ʉkʉgarʉka kʉMʉkʉrʉ kʉrɨ haguhɨ. <verse eid="JAS 5:8"/><verse number="9" style="v" sid="JAS 5:9"/>Abhahiiri bhaanɨ, mutiibheerya imubheene kobheene mʉtaaza kutinirwa. Morore! Umutiniri arɨ haguhɨ kuuza.<verse eid="JAS 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 5:10"/>Abhahiiri bhaanɨ, mʉbhaangarɨrɨ abharʉʉtɨrɨri bhanʉ bhaarɨ bharagamba kuriina ryʉ Ʉmʉkʉrʉ, bhabhɨ ebherenjo bhyu ubhwigumirirya mʉmabhɨ. <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>Na bhanʉ bhiigumiriiryɨ, tʉrabharora bhanʉ ʉrʉbhangʉ. Mwigwirɨ amangʼana gu ubhwigumirirya bhwa Ayubhu, na mwɨzɨ chɨmbu Ʉmʉkʉrʉ aamʉkʉrɨɨrɨ amazʉmu mʉtɨnɨrʉ.<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="xt" closed="false">Rora <ref loc="JOB 42:10-13">Ayubhu 42:10‑13</ref>.</char></note> Gayo gʉʉsi nɨ‑kʉ kʉbha Ʉmʉkʉrʉ izwirɨ ɨbhɨgʉngi nʉ ʉrʉbhangʉ.<verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>Abhahiiri bhaanɨ, kʉkɨra gayo, mutiirahɨra risaarʉ, ɨɨsɨ ne ekegero chʉchʉsi kirya. Arɨɨbhɨ muriisirirya “Hee,” ɨbhɨ amaheeneheene, arɨɨbhɨ mʉraanga “Zɨyi,” ɨbhɨ maheene zɨyi, korereke mʉtatinirwa.<verse eid="JAS 5:12"/></para>
  <para style="s">Mʉsabhɨ Mungu kubhwisirirya</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>Kʉna mʉʉtʉ kʉbhaniimwɨ wʉnʉ akʉnyaaka? Areenderwa asabhɨ Mungu. Areho wʉwʉʉsi wʉnʉ ano obhozomerwa? Ereenderwa ɨmbɨ amɨɨmbʉ gu ukukumya.<verse eid="JAS 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 5:14"/>Kunu umurwɨrɨ gatɨ waanyu? Areenderwa abhabhɨrɨkɨrɨ abhiimiiririri bha risengerero, bhaazɨ kʉmʉsabhɨra ɨwaazɨ na kʉmʉhaka amaguta kuriina ryʉ Ʉmʉkʉrʉ. <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>Bharɨɨsabhɨ kubhwisirirya umurwɨrɨ arahora, Ʉmʉkʉrʉ aramogororocha. Angabha asariryɨ, arabheererwa. <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>Mmbe, mutigɨ ʉbhʉbhɨ bhwanyu imubheene kobheene na kwisabhɨra kwa Mungu, korereke mʉhʉribhwɨ amarwɨrɨ gaanyu. Amasabhi gʉ ʉmʉʉtʉ we eheene ganʉ ʉbhʉnaja na garakora emeremo.<verse eid="JAS 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 5:17"/>Ʉmʉrʉʉtɨrɨri Ɨɨriya, aarɨ ʉmʉʉtʉ wi isimʉka nchi iyɨɨtʉ, na akasabha kwa mucha imbura ɨtatweka kʉʉsɨ, ni imbura ɨtaatwɨkirɨ imyaka ɨtatʉ ni imyɨri ɨsaasabha. <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>Neho naatu, akasabha Mungu imbura itweke, yʉʉsi ɨkatweka kuhika hanʉ ɨɨsɨ yaamɨrirɨ ibhyakurya.<verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>Abhahiiri bhaanɨ, wʉmwɨ waanyu araahabhɨ na kʉbha kore na amaheene, nʉ ʉwʉndɨ amʉgaruchɨ naatu kʉnzɨra ya amaheene, <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>momenye wʉnʉ araagaruchɨ ʉmʉʉtʉ wuyo kurwa mʉbhʉbhɨ bhwazɨ, arabha amʉhʉriryɨ ekoro yaazɨ kurwa muruku, nʉ ʉbhʉbhɨ bhwazɨ bhwaru bhʉrabheererwa.<verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
