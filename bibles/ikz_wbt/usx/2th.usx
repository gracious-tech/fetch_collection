<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TH" style="id">‑ Ikizu 2 Thessalonians</book>
  <para style="h">2 Abhatɨsarʉʉnikɨ</para>
  <para style="toc3">2 Abhatɨsarʉʉnikɨ</para>
  <para style="toc2">2 Abhatɨsarʉʉnikɨ</para>
  <para style="toc1">Ɨnyarʉbha ya kabhɨrɨ ya Paaurʉ kwa Abhatɨsarʉʉnikɨ</para>
  <para style="mt2">Ɨnyarʉbha ya kabhɨrɨ ya Paaurʉ kwa</para>
  <para style="mt1">Abhatɨsarʉʉnikɨ</para>
  <para style="imt">Ʉbhʉkangati</para>
  <para style="ip">Ibhaga isuuhu kwɨma Paaurʉ atʉmɨ ɨnyarʉbha yaazɨ ye embere, akabhona amangʼana kʉbha, abhiisirirya bha Tɨsarʉʉnikɨ bhatʉʉbhʉʉrirɨ bhwaheene amiija gaazɨ agandɨ. Abhandɨ bhakakina Yɨɨsu aarɨ amarirɨ kʉgarʉka. Na abhandɨ bhaarɨ bhatigirɨ emeremo jabhʉ jʉsi, kʉ kʉbha bhakiisega Yɨɨsu angagarukirɨ ribhaga ryʉryʉsi. Abhandɨ bhatɨɨndirɨ kohocha emeremo kʉ kʉbha yu ukuniha. Paaurʉ akaandɨka ɨnyarʉbha ya kabhɨrɨ, korereke achʉrɨ amiisɨɨgi ncha gayo, ganʉ gataarɨ na amaheene. Mʉnyarʉbha ya kabhɨrɨ yɨnʉ akandikijiryɨ kʉbha, Yɨɨsu aarɨ akɨɨrɨ kʉgarʉka kʉʉsɨ na akabhakandikija kongʼeha kohocha emeremo kumucha.</para>
  <chapter number="1" style="c" sid="2TH 1"/>
  <para style="s">Amakeerenʼya</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1"/>Ɨnyarʉbha yɨnʉ nandikirɨ inyɨ Paaurʉ, hamwɨmwɨ na Sirwanʉ<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fk" closed="false">Sirwanʉ </char><char style="ft" closed="false">arabhirikirwa </char><char style="fqa" closed="false">Siira </char><char style="ft" closed="false">mʉkɨtabhʉ cha Amahocha ga Abhatumwa.</char></note> na Timoseo. Tʉrabhaandɨkɨra imwɨ abhiisirirya bhʉ ʉrʉbhɨri rwa Tɨsarʉʉnikɨ, mwiribhita rya abhaatʉ bhanʉ mwisiriiryɨ Bhaabha Mungu nʉ Ʉmʉkʉrʉ Yɨɨsu Kiriisitʉ.<verse eid="2TH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2"/>Ɨbhɨgʉngi no omorembe kurwa kwa Bhaabha Mungu na kʉMʉkʉrʉ Yɨɨsu Kiriisitʉ, bhɨbhɨ na niimwɨ.<verse eid="2TH 1:2"/></para>
  <para style="s">Abhiisirirya bharahaabhwa umwʉyʉ ribhaga ryi ɨnyaakʉ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3"/>Abhahiiri bhɨɨtʉ, toreenderwa kukumya Mungu ibhaga ryʉsi igʉrʉ waanyu, kʉ kʉbha ubhwisirirya bhwanyu bhʉrakʉra bhʉkʉngʼu, naatu ʉkʉsɨɨgana kwanyu kʉrangʼeha kwaruha. <verse eid="2TH 1:3"/><verse number="4" style="v" sid="2TH 1:4"/>Na niitwɨ turiiheema mʉmasengerero ga Mungu, kʉ kʉbha yu ubhwigumirirya nu ubhwisirirya bhʉnʉ mʉnabhwɨ, mʉnyaakʉ yʉʉsi yɨnʉ mʉnayo.<verse eid="2TH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5"/>Gayo gʉʉsi gareerekenʼya, ɨtɨnɨrʉ ya Mungu ne‑ye eheene. Kʉtɨnɨrʉ yiyo imwɨ mʉrabharwa na mʉrɨɨndibhwa kʉbha mʉbhʉtɨmi bhwazɨ,<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fk" closed="false">Ʉbhʉtɨmi bhwazɨ</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">ʉbhʉtɨmi bhwa Mungu</char> muKiniibhasa.</note> bhʉnʉ mʉkʉnyaakibhwa igʉrʉ wabhwɨ. <verse eid="2TH 1:5"/><verse number="6" style="v" sid="2TH 1:6"/>Mungu arakora ge eheene, arabhaha ɨnyaakʉ bhanʉ bhakʉbhanyaacha <verse eid="2TH 1:6"/><verse number="7" style="v" sid="2TH 1:7"/>na kʉbhaha umwoyeero bhanʉ mʉkʉnyaaka, hamwɨmwɨ na niitwɨ. Arakorabhu, hanʉ Ʉmʉkʉrʉ Yɨɨsu akuuza kurwa mwisaarʉ hamwɨmwɨ na bhamaraika<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="fk" closed="false">Bhamaraika</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">maraika</char> muKiniibhasa.</note> bhaazɨ bha amanaga, <verse eid="2TH 1:7"/><verse number="8" style="v" sid="2TH 1:8"/>nɨ ɨmɨrɨngɨɨri jo omorero. Yɨɨsu newe akʉbhatɨnɨra bhʉʉsi bhanʉ bhakwanga Mungu, na bhanʉ bhatakwisirirya Ɨngʼana Ɨnzʉmu yʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu. <verse eid="2TH 1:8"/><verse number="9" style="v" sid="2TH 1:9"/>Ɨnyaakʉ yaabhʉ ɨrabha ubhuriki bhwa kemerano na kutuurwa kore nʉ Ʉmʉkʉrʉ nʉ ʉbhʉkʉrʉ bhwʉ ʉbhʉnaja bhwazɨ. <verse eid="2TH 1:9"/><verse number="10" style="v" sid="2TH 1:10"/>Ɨnyaakʉ yiyo ɨrabha urusikʉ rʉnʉ Ʉmʉkʉrʉ akuuza kukumibhwa nʉ ʉkʉsʉngʼaana ubhusuuku kurwa kʉbharɨndu<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fk" closed="false">Abharɨndu</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> bhaazɨ bhanʉ bhamwisiriiryɨ. Na niimwɨ kwikɨ mʉrabha mʉbhayo, kʉ kʉbha mwisiriiryɨ amangʼana garya twabharɨɨtɨɨrɨ.<verse eid="2TH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11"/>Kʉgayo tʉrabhasabhɨra ibhaga ryʉsi, korereke Mungu wɨɨtʉ agiryɨ mwikarɨ kʉrɨngʼaana nu ubhubhirikirwa bhwanyu. Naatu tʉramʉsabha, amarɨ amangʼana amazʉmu gʉʉsi ganʉ mukwenda kokora kʉbhʉnaja bhwazɨ, na amarɨ emeremo janyu jʉsi ju ubhwisirirya. <verse eid="2TH 1:11"/><verse number="12" style="v" sid="2TH 1:12"/>Tʉrasabha, korereke iriina ryʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu rɨbhɨ rɨrakumibhwa igʉrʉ waanyu. Na niimwɨ mʉbhɨ mʉrakumibhwa igʉrʉ waazɨ, ɨbhɨgʉngi bhya Mungu wɨɨtʉ na bhyʉ Ʉmʉkʉrʉ Yɨɨsu Kiriisitʉ.<verse eid="2TH 1:12"/></para>
  <chapter eid="2TH 1"/>
  <chapter number="2" style="c" sid="2TH 2"/>
  <para style="s">Ʉmʉkʉrʉ Yɨɨsu araaza kuricha umwangi</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1"/>Nangʉ abhahiiri bhɨɨtʉ, tʉrabhasabha igʉrʉ wu ukuuza kʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ, na chɨmbu turiibhiringɨ kwewe.<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="xt" closed="false">Rora <ref loc="1TH 4:17">1 Abhatɨsarʉʉnikɨ 4:17</ref>.</char></note> Tʉrabhasabha, <verse eid="2TH 2:1"/><verse number="2" style="v" sid="2TH 2:2"/>mʉtakangwa na kʉbha nʉ ʉrʉhaho, urusikʉ rwu ukuuza Ʉmʉkʉrʉ ruhikirɨ. Hamwɨ mwigwirɨbhu kʉmangʼana obhorebhe gʉ ʉbhʉrʉʉti, hamwɨ gu ubhurwazi, hamwɨ gɨ ɨnyarʉbha yɨnʉ ikwiseegwa iruurɨ kwa niitwɨ. <verse eid="2TH 2:2"/><verse number="3" style="v" sid="2TH 2:3"/>Mutiisirirya ʉmʉʉtʉ wʉwʉʉsi kʉbhakangirirya kwa ryʉryʉsi, kʉ kʉbha urusikʉ ruyo rʉtakuhika, kuhika zisikʉ zirya abhaatʉ bhakwanga Mungu nu umwangi wurya<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="fk" closed="false">Umwangi wurya</char><char style="ft" closed="false">, enzobhooro yaku nu‑mwangi wa Kiriisitʉ wʉnʉ ahaanga Mungu na kʉkɨra imigirʉ jazɨ jʉsi. Umwangi wʉnʉ atangɨ Shɨtaani, nawe arahʉkɨribhwa na Shɨtaani kubhwɨndi bhwazɨ bhu ukwanga Mungu.</char></note> arorekanɨ. Wuyo newe akurichwa chwe. <verse eid="2TH 2:3"/><verse number="4" style="v" sid="2TH 2:4"/>Nawe hinga araanga ebhegero bhyʉsi bhɨnʉ abhaatʉ bhakorora kʉbha ni‑mungu hamwɨ kɨnʉ bhakosengera, na ariitʉʉra igʉrʉ wa bhyʉsi. Arasikɨra na kwikara mwihekaaru rya Mungu, na kwikurya kʉbha ewe newe Mungu.<verse eid="2TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5"/>Mʉtakuhiita hanʉ naarɨ hamwɨmwɨ na niimwɨ nɨkabhabhʉʉrɨra gayo gʉʉsi? <verse eid="2TH 2:5"/><verse number="6" style="v" sid="2TH 2:6"/>Na nangʉ mwɨzɨ kɨnʉ kekomorecha, korereke ɨrɨkɨnibhwɨ ribhaga rɨnʉ rikwɨndibhwa. <verse eid="2TH 2:6"/><verse number="7" style="v" sid="2TH 2:7"/>Nʉʉrʉ nangwɨnʉ umwangi wuyo arakora emeremo ɨnʉ iibhisirɨ. Nawe atakororekana kuhika wʉnʉ akomorecha hanʉ ariruushibhweho. <verse eid="2TH 2:7"/><verse number="8" style="v" sid="2TH 2:8"/>Hayo neho umwangi wuyo arɨɨrɨkɨnibhwɨ, Ʉmʉkʉrʉ Yɨɨsu aramwita nu umwika kurwa mumunywa gwazɨ, na aramuricha nu ubhwɨrʉ bhu ukuuza kwazɨ.<verse eid="2TH 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2TH 2:9"/>Ribhaga ryu ukuuza kwazɨ, umwangi wuyo araaza na amanaga gʉʉsi ga Shɨtaani<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="fk" closed="false">Shɨtaani</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> no okokora ibhyɨrɨkɨnʼyʉ na amateemo gʉ ʉrʉrɨmɨ. <verse eid="2TH 2:9"/><verse number="10" style="v" sid="2TH 2:10"/>Arabhakangirirya kwa nzɨra yʉyʉʉsi, bhanʉ bhʉʉsi bharɨ mʉnzɨra yʉ ʉkʉbhʉra, kʉ kʉbha bhatiisiriiryɨ kʉsɨɨga amaheene korereke bhatʉrɨ kʉsabhurwa. <verse eid="2TH 2:10"/><verse number="11" style="v" sid="2TH 2:11"/>Necho Mungu abhiisiririiryɨ bhakangatibhwɨ na amanaga ga amakangirirya, korereke bhangʼehe kwisirirya ʉrʉrɨmɨ. <verse eid="2TH 2:11"/><verse number="12" style="v" sid="2TH 2:12"/>Mmbe bhʉʉsi bhanʉ bhatakwisirirya amaheene na kozomererwa ʉbhʉbhɨ, bharatinirwa.<verse eid="2TH 2:12"/></para>
  <para style="s">Kwimɨɨrɨra bhwɨma</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13"/>Nawe itwɨ, toreenderwa kukumya Mungu ribhaga ryʉsi, igʉrʉ waanyu, imwɨ abhahiiri bhanʉ mʉsɨɨgirwɨ nʉ Ʉmʉkʉrʉ Yɨɨsu. Toreenderwa kokorabhu, kʉ kʉbha Mungu akabharobhora imwɨ kwɨma isimʉka yu ubhubhumbi korereke mobhone ubhutuurya. Ubhutuurya bhuyo mʉbhʉsʉngʼaanirɨ kwa kʉbhɨngukibhwa ne Ekoro Ɨndɨndu na kʉnzɨra yu ukwisirirya amaheene. <verse eid="2TH 2:13"/><verse number="14" style="v" sid="2TH 2:14"/>Mungu akabhabhɨrɨkɨra, korereke mobhone ubhutuurya bhuyo kʉnzɨra yɨ Ɨngʼana Ɨnzʉmu yɨnʉ twarwazirɨ kwa niimwɨ. Abhabhirikiirɨ korereke mobhone kugwatana mubhwɨrʉ bhwʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ. <verse eid="2TH 2:14"/><verse number="15" style="v" sid="2TH 2:15"/>Nangʉ abhahiiri bhɨɨtʉ, mwimɨɨrɨrɨ bhwɨma na kugwata amiija ganʉ mwasʉngʼaanirɨ, ɨbhɨ nɨ‑kwa amaragɨrɨra gɨɨtʉ hamwɨ kʉzɨnyarʉbha kurwa kwa niitwɨ.<verse eid="2TH 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16"/>Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ umwene na Bhaabha wɨɨtʉ Mungu wʉnʉ atʉsɨɨgirɨ, na kʉbhɨgʉngi bhyazɨ aratohonʼya kemerano na kotoha ubhwisɨgi ʉbhʉzʉmu. <verse eid="2TH 2:16"/><verse number="17" style="v" sid="2TH 2:17"/>Tʉrabhasabha bhabhahɨ umwʉyʉ na kʉbhakongʼya, korereke mʉtʉrɨ kʉgamba na kokora amazʉmu.<verse eid="2TH 2:17"/></para>
  <chapter eid="2TH 2"/>
  <chapter number="3" style="c" sid="2TH 3"/>
  <para style="s">Paaurʉ arasabha bhabhasabhɨrɨ kwa Mungu</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1"/>Nangʉ abhahiiri bhɨɨtʉ mʉtʉsabhɨrɨ, korereke amangʼana igʉrʉ wʉ Ʉmʉkʉrʉ Yɨɨsu gangʼehe kʉnyaragana bhwangʉ na gasuukwɨ, chɨmbu gaarɨ kwa niimwɨ. <verse eid="2TH 3:1"/><verse number="2" style="v" sid="2TH 3:2"/>Mʉtʉsabhɨrɨ korereke Mungu atʉsabhʉrɨ mʉbhaatʉ abhabhɨ, kʉ kʉbha bhatarɨ bhʉʉsi bhanʉ bhakwisirirya amangʼana gayo. <verse eid="2TH 3:2"/><verse number="3" style="v" sid="2TH 3:3"/>Nawe Ʉmʉkʉrʉ, ne‑moheene, ewe arabhakongʼya imwɨ na kʉbhariibha kurwa kwa Shɨtaani. <verse eid="2TH 3:3"/><verse number="4" style="v" sid="2TH 3:4"/>Naatu aratoha ubhwisɨgi bhʉkʉrʉ igʉrʉ waanyu, nangʉ mʉrakora garya twabharagɨɨnʼyɨ, na mʉrakaja kʉgakora. <verse eid="2TH 3:4"/><verse number="5" style="v" sid="2TH 3:5"/>Ʉmʉkʉrʉ akangatɨ zekoro zaanyu mʉbhʉsɨɨgi bhwa Mungu na mubhwigumirirya bhwa Kiriisitʉ.<verse eid="2TH 3:5"/></para>
  <para style="s">Amaangirijʉ igʉrʉ wʉ ʉbhʉtʉbhu</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6"/>Abhahiiri bhɨɨtʉ, tʉrabhaswaja kuriina ryʉ Ʉmʉkʉrʉ Yɨɨsu Kiriisitʉ, mʉtaanɨ na abhahiiri abhatʉbhu, bhanʉ bhatakutuna amiija ganʉ twabhahɨɨrɨ. <verse eid="2TH 3:6"/><verse number="7" style="v" sid="2TH 3:7"/>Tʉrabhugabhu, kʉ kʉbha imwɨ mwɨzɨ chɨmbu ikwenderwa kwɨga ekerenjo chɨtʉ. Hanʉ itwɨ twarɨ na niimwɨ, tʉtaarɨ bhatʉbhu, <verse eid="2TH 3:7"/><verse number="8" style="v" sid="2TH 3:8"/>na twarɨ tʉtakurya ibhyakurya kʉmʉʉtʉ wʉwʉʉsi bhʉʉha. Twarɨ tʉrahocha emeremo kwa mucha ubhutikʉ nu umwise, korereke tʉtanyaacha ʉmʉʉtʉ wʉwʉʉsi gatɨ waanyu. <verse eid="2TH 3:8"/><verse number="9" style="v" sid="2TH 3:9"/>Tʉkakorabhu, ɨtarɨ kʉ kʉbha tʉtɨɨndirwɨ kobhona kegero kurwa kwa niimwɨ, nawe tokeenda tʉbhɨ ekerenjo kwa niimwɨ korereke mutwɨgɨ. <verse eid="2TH 3:9"/><verse number="10" style="v" sid="2TH 3:10"/>Na hanʉ twarɨ hamwɨmwɨ na niimwɨ, tʉkabhaswaja, “Ʉmʉʉtʉ wʉnʉ atakwenda kohocha emeremo, atarya.”<verse eid="2TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11"/>Tubhugirɨ amangʼana gayo, kʉ kʉbha twigwirɨ bhareho abhandɨ gatɨ waanyu abhatʉbhu, bhatakokora ryʉryʉsi, nawe bhariisikirya mʉmangʼana ga abhandɨ. <verse eid="2TH 3:11"/><verse number="12" style="v" sid="2TH 3:12"/>Abhaatʉ bhayo tʉrabharaganʼya na kʉbharecha kʉbhʉnaja bhwʉ Ʉmʉkʉrʉ Yɨɨsu Kiriisitʉ, bhahoche emeremo kʉbhʉhʉrɨɨru, korereke bhabhɨ ni ibhyakurya bhyabhʉ abheene. <verse eid="2TH 3:12"/><verse number="13" style="v" sid="2TH 3:13"/>Nawe imwɨ abhahiiri bhɨɨtʉ, mʉtaniha kokora amazʉmu.<verse eid="2TH 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14"/>Arɨɨbhɨ ʉmʉʉtʉ atakwenda kugwata amaswaja gɨɨtʉ ganʉ garɨ mʉnyarʉbha yɨnʉ, mwiyangarɨrɨ bhʉkʉngʼu. Mʉtagwatana nawe, korereke asʉʉkɨ. <verse eid="2TH 3:14"/><verse number="15" style="v" sid="2TH 3:15"/>Nawe mʉtamorora nchu umubhisa, mʉbhɨ mʉramorecha nchʉ ʉmʉkɨndichanyu.<verse eid="2TH 3:15"/></para>
  <para style="s">Amangʼana gʉ ʉkʉraga</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16"/>Nangʉ, Ʉmʉkʉrʉ wo omorembe umwene, abhahɨ omorembe ibhaga ryʉsi kʉzɨnzɨra zʉʉsi. Ewe abhɨ hamwɨmwɨ na niimwɨ bhʉʉsi. <verse eid="2TH 3:16"/><verse number="17" style="v" sid="2TH 3:17"/>Niinyɨ Paaurʉ nɨrabhaandɨkɨra amakeerenʼya ganʉ kokobhoko kwanɨ inyimwene. Ruyo nerwe ʉrʉkaamʉ mʉzɨnyarʉbha zaanɨ zʉʉsi, na nɨmbu nɨhaandɨka.<verse eid="2TH 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18"/>Ɨbhɨgʉngi bhyʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ, bhɨbhɨ hamwɨmwɨ na niimwɨ.<verse eid="2TH 3:18"/></para>
  <chapter eid="2TH 3"/>
</usx>
