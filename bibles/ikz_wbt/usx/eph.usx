<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EPH" style="id">‑ Ikizu Ephesians</book>
  <para style="h">Abheefeeso</para>
  <para style="toc3">Abheefeeso</para>
  <para style="toc2">Abheefeeso</para>
  <para style="toc1">Ɨnyarʉbha ya Paaurʉ kwa Abheefeeso</para>
  <para style="mt2">Ɨnyarʉbha ya Paaurʉ kwa</para>
  <para style="mt1">Abheefeeso</para>
  <para style="imt">Ʉbhʉkangati</para>
  <para style="ip">Ɨnyarʉbha ya Paaurʉ kwa abhahɨmba bha Yɨɨsu bhʉ ʉrʉbhɨri rwa Efeeso, akaandɨka hanʉ aarɨ mokebhoho. Ʉrʉbhɨri rwa Efeeso rwarɨ nɨ‑rʉmwɨ ya zɨmbɨri zɨkʉrʉ zʉ ʉbhʉkangati bhwa Abharuumi. Efeeso yaarɨ neyo ɨtangɨ yu ubhusuruja nu ubhuniibhi, na kwarɨ na Abhayaahudi bhaaru. Paaurʉ akaja iyo ribhaga ryo orogendo rwazɨ rwa kabhɨrɨ na rwa katatʉ rwu ukuja kʉraganʼya Ɨngʼana Ɨnzʉmu igʉrʉ wa Yɨɨsu (<char style="xt"><ref loc="ACT 18:19-22">Amahocha ga Abhatumwa 18:19‑22</ref>, <ref loc="ACT 19:1-41">19:1‑41</ref></char>) na akiikara kwi ibhaga rya myaka ɨbhɨrɨ.</para>
  <para style="ip">Ɨnyarʉbha yɨnʉ ɨragambɨra ubhwɨndi bhwa Mungu bhwʉ ʉkʉsabhʉra abhaatʉ. Paaurʉ arabhahiitya kʉbha Yɨɨsu akakwa kʉmʉsarabha korereke atʉsabhʉrɨ, nawe Mungu akamuryʉra, na nangʉ ana Mungu ahagero ahazʉmu bhʉkʉngʼu, ɨnʉ akʉkangata nangwɨnʉ na kemerano.</para>
  <para style="ip">Mʉnyarʉbha yɨnʉ manga kabhɨrɨ Paaurʉ arasabhɨra abhiisirirya abhakɨndichazɨ Efeeso iyo. Arakumya Mungu igʉrʉ wu ubhwisirirya nʉ ʉbhʉsɨɨgi bhwabhʉ, wʉʉsi arasabha Mungu abhasakiryɨ bhamenye ʉbhʉnaja bhwa Mungu chɨmbu bhʉrɨ nʉ ʉbhʉsɨɨgi bhwa Yɨɨsu bhʉnʉ bhʉtaana kerengo.</para>
  <para style="ip">Ringʼana rya Abhakiriisitʉ bhʉʉsi kʉbha kegero kɨmwɨ na Yɨɨsu ni bhwera bhʉkʉngʼu mʉnyarʉbha, na rɨragambwa manga merongo ɨbhɨrɨ. Paaurʉ arabhʉʉrɨra Abheefeeso, abhaatʉ bhanʉ bhabhwɨnɨ ubhwikari ubhuhya bhareenderwa kokora amahocha amahya.</para>
  <para style="ip">Akʉmara, Paaurʉ ariija abhakari na abhasubhɨ bhaabhʉ, abhiibhuri na abhaana, na bhambʉʉsa na bhanʉ bhatarɨ bhambʉʉsa kokora bhwaheene chɨmbu abhiisirirya bha Yɨɨsu bhakwenderwa kwikara. Ɨtɨnɨrʉ, ariija igʉrʉ we ebheseme bhya riihɨ rye ekoro.</para>
  <chapter number="1" style="c" sid="EPH 1"/>
  <para style="s">Amakeerenʼya</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1"/>Ɨnyarʉbha yɨnʉ nandikirɨ inyɨ Paaurʉ, umutumwa<note caller="+" style="f"><char style="fr" closed="false">1:1a </char><char style="fk" closed="false">Umutumwa</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">abhatumwa</char> muKiniibhasa.</note> wa Yɨɨsu Kiriisitʉ kʉbhʉsɨɨgi bhwa Mungu. Nɨrabhaandɨkɨra imwɨ abharɨndu<note caller="+" style="f"><char style="fr" closed="false">1:1b </char><char style="fk" closed="false">Abharɨndu</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> bha Mungu bhanʉ mukwikara [Efeeso]. Imwɨ, nɨ‑bharonge ku kugwatana na Yɨɨsu Kiriisitʉ.<verse eid="EPH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2"/>Ɨbhɨgʉngi no omorembe kurwa kwa Bhaabha Mungu, na kʉMʉkʉrʉ Yɨɨsu Kiriisitʉ, bhɨbhɨ na niimwɨ.<verse eid="EPH 1:2"/></para>
  <para style="s">Ʉrʉbhangʉ rwe ekoro kwa abhiisirirya</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3"/>Akumibhwɨ Mungu, Bhaabha wʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ, kʉ kʉbha ku kutugwatanʼya na Kiriisitʉ, akatoha ʉrʉbhangʉ rwʉsi rwa mokoro, ko kotoha ʉrʉbhangʉ rʉnʉ ruri mwisaarʉ. <verse eid="EPH 1:3"/><verse number="4" style="v" sid="EPH 1:4"/>Hanʉ Mungu aarɨ akɨɨrɨ kʉbhʉmba ɨɨsɨ, akatorobhora tʉbhɨ bhaazɨ, kʉnzɨra yu ukutugwatanʼya na Kiriisitʉ. Akakorabhu, korereke tʉbhɨ abharɨndu bhanʉ tʉtaana isoro mʉbhʉtangɨ bhwazɨ. Kʉbhʉsɨɨgi bhwazɨ, <verse eid="EPH 1:4"/><verse number="5" style="v" sid="EPH 1:5"/>Mungu aarɨ ɨndirɨ kwɨma ɨkarɨ, kotokora kʉbha abhaana bhaazɨ kʉnzɨra ya Yɨɨsu Kiriisitʉ. Akeenda kokorabhu, kʉ kʉbha nɨmbu yamʉzʉmɨɨrɨ. <verse eid="EPH 1:5"/><verse number="6" style="v" sid="EPH 1:6"/>Mmbe akumibhwɨ Mungu kʉbhɨgʉngi bhyazɨ, bhɨnʉ atʉhɨɨrɨ bhʉʉha kʉnzɨra yu Umwana waazɨ<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fk" closed="false">Umwana waazɨ</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">Umwana wa Mungu</char> muKiniibhasa.</note> ʉmʉsɨɨgwa.<verse eid="EPH 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 1:7"/>Mungu atʉsabhwirɨ kʉnzɨra ya amasaahɨ ga Yɨɨsu Kiriisitʉ, atʉbhɨɨrɨɨrɨ ʉbhʉbhɨ bhwɨtʉ bhwʉsi, kʉrɨngʼaana nu ubhwaru bhwɨ ɨbhɨgʉngi bhyazɨ. <verse eid="EPH 1:7"/><verse number="8" style="v" sid="EPH 1:8"/>Ewe akatohererya ʉrʉbhangʉ rwazɨ, hamwɨmwɨ na kotoha amangʼɨɨni nu ubhwʉbhʉʉri bhwaru. <verse eid="EPH 1:8"/><verse number="9" style="v" sid="EPH 1:9"/>Atʉkʉrirɨ twobhoore ɨsɨɨmi yaazɨ yɨnʉ yaarɨ yiibhisirɨ, na akayihicha kʉhɨtɨra kwa Kiriisitʉ, chɨmbu ɨɨndirɨ. <verse eid="EPH 1:9"/><verse number="10" style="v" sid="EPH 1:10"/>Ɨsɨɨmi ya Mungu nɨ‑kʉbha, ribhaga rɨnʉ ɨɨndirɨ hanʉ rikuhika, arabhɨtʉʉra ebhegero bhyʉsi bhya mwisaarʉ na bhya kʉʉsɨ bhɨbhɨ iyaasɨ wʉ ʉbhʉkangati bhwa Kiriisitʉ.<verse eid="EPH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11"/>Ku ukugwatana na Kiriisitʉ, itwɨ Abhayaahudi tʉgabhiibhwɨ ʉbhʉsabhuri chɨmbu twarɨngɨɨrwɨ nu ubhwɨndi bhwa Mungu, ʉmʉkʉri wa amangʼana gʉʉsi kʉrɨngʼaana nu ubhwɨndi bhwazɨ. <verse eid="EPH 1:11"/><verse number="12" style="v" sid="EPH 1:12"/>Akakorabhu igʉrʉ wɨɨtʉ, bhanʉ twarɨ bhe embere kwisega Kiriisitʉ, korereke Mungu akumibhwɨ.<verse eid="EPH 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13"/>Imwʉsi abhaatʉ bhanʉ bhatarɨ Abhayaahudi, mukiigwa amangʼana ga amaheene, gɨ Ɨngʼana Ɨnzʉmu yʉ ʉbhʉsabhuri bhwanyu. Hanʉ mwisiriiryɨ Kiriisitʉ, Mungu wʉʉsi akabhakaama ʉrʉkaamʉ, kʉ ʉkʉbhaha Ekoro Ɨndɨndu<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="fk" closed="false">Ekoro Ɨndɨndu</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> yɨnʉ aabharagɨɨnʼyɨ. Ko kokorabhu, akeerekenʼya, imwɨ nɨ‑bhaazɨ. <verse eid="EPH 1:13"/><verse number="14" style="v" sid="EPH 1:14"/>Ekoro Ɨndɨndu yiyo yangɨ ichɨrɨkɨnʼyʉ cha Mungu kwa niitwɨ, Mungu aratoha bhyʉsi bhɨnʉ aaragɨɨnʼyɨ. Ekoro yiyo neyo Mungu atɨɨrɨ kuhika hanʉ arɨɨtʉsabhʉrɨ itwɨ abhaatʉ bhaazɨ. Tukumyɨ Mungu bhʉkʉngʼu!<verse eid="EPH 1:14"/></para>
  <para style="s">Paaurʉ arasabhɨra Abhakiriisitʉ bha Efeeso</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15"/>Nɨrakumya Mungu kʉ kʉbha amangʼana gayo gʉʉsi aatʉkʉrɨɨrɨ. Kwɨma hanʉ niigwirɨ chɨmbu mukwisirirya Ʉmʉkʉrʉ Yɨɨsu na kʉsɨɨga abharɨndu bhʉʉsi bha Mungu, <verse eid="EPH 1:15"/><verse number="16" style="v" sid="EPH 1:16"/>nɨkɨɨrɨ kutiga kukumya Mungu igʉrʉ waanyu. Nɨrabhahiita ribhaga ryʉsi mʉmasabhi gaanɨ. <verse eid="EPH 1:16"/><verse number="17" style="v" sid="EPH 1:17"/>Nɨrasabha Mungu wʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ, Bhaabha umugungwa, abhahɨ Ekoro yaazɨ yɨnʉ ɨkʉbhaha ubhwʉbhʉʉri nu ubhwɨrɨkibhwa, korereke mʉtʉrɨ komomenya bhʉkʉngʼu. <verse eid="EPH 1:17"/><verse number="18" style="v" sid="EPH 1:18"/>Nɨramʉsabha abhasakiryɨ korereke momenye bhwaheene kɨnʉ abhabhirikiriirɨ mʉsʉngʼaanɨ, neho mʉbhɨ nu ubhwisɨgi bhwe eheene. Mʉtʉrɨ kwobhoora ubhuniibhi bhwʉ ʉbhʉgabhi bhwazɨ ʉbhʉzʉmu bhʉnʉ aaragɨɨnʼyɨ abharɨndu bhaazɨ. <verse eid="EPH 1:18"/><verse number="19" style="v" sid="EPH 1:19"/>Kwikɨ mwobhoore ʉbhʉnaja bhwazɨ ʉbhʉkʉrʉ igʉrʉ wɨɨtʉ abhiisirirya. Ʉbhʉnaja bhuyo bhʉrakora emeremo, kʉrɨngʼaana na amanaga gaazɨ amakʉrʉ, <verse eid="EPH 1:19"/><verse number="20" style="v" sid="EPH 1:20"/>ganʉ aakʉrirɨ kwa Kiriisitʉ hanʉ aamuryukwirɨ mʉbhaku. Akʉmara akamwikarya ʉrʉbhaara rwazɨ rwu ubhuryʉ mwisaarʉ. <verse eid="EPH 1:20"/><verse number="21" style="v" sid="EPH 1:21"/>Ni igʉrʉ iyo, Kiriisitʉ arakangata igʉrʉ wa bhʉʉsi bhanʉ bharɨ kowereero yɨnʉ ɨtakororekana, abhakangati bhaabhʉ, bhʉ ʉbhʉnaja, bha amanaga na bhi imyeya jʉsi. Arakangata kwa bhʉʉsi, ɨtarɨ kʉʉsɨ yɨnʉ iyeene, nʉʉrʉ kʉʉsɨ yɨnʉ ikuuza. <verse eid="EPH 1:21"/><verse number="22" style="v" sid="EPH 1:22"/>Mungu atɨɨrɨ ebhegero bhyʉsi mʉmabhoko gaazɨ, na kʉmʉtʉʉra mwisengerero abhɨ Ʉmʉkʉrʉ we ebhegero bhyʉsi nchu umutwɨ kʉmʉbhɨrɨ. <verse eid="EPH 1:22"/><verse number="23" style="v" sid="EPH 1:23"/>Risengerero nɨ‑mʉbhɨrɨ gwa Kiriisitʉ, na ryizwirɨ ʉbhʉnagu bhwazɨ. Ewe newe akʉnaja ebhegero bhyʉsi hʉhʉʉsi.<verse eid="EPH 1:23"/></para>
  <chapter eid="EPH 1"/>
  <chapter number="2" style="c" sid="EPH 2"/>
  <para style="s">Mungu ahaasabhʉra kʉrʉbhangʉ rwazɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1"/>Imwɨ mwarɨ bhaku, kʉ kʉbha yʉ ʉbhʉsarya nʉ ʉbhʉbhɨ bhwanyu. <verse eid="EPH 2:1"/><verse number="2" style="v" sid="EPH 2:2"/>Ribhaga riyo, mwarɨ mʉrakora amangʼana amabhɨ gɨ ɨɨsɨ yɨnʉ. Mwarɨ muriitegeerera Shɨtaani,<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="fk" closed="false">Shɨtaani</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> ʉmʉtɨmi wa amasambwa ganʉ gatakororekana, na ahaakora emeremo kʉbhanʉ bhatakwigwa Mungu. <verse eid="EPH 2:2"/><verse number="3" style="v" sid="EPH 2:3"/>Itwʉsi, twarɨ nchebho, tukiikara kʉrɨngʼaana ne ebhoono yɨ ɨmɨbhɨrɨ jɨtʉ, ɨnʉ tʉrakora amangʼana ganʉ gaazʉmɨɨrɨ ɨmɨbhɨrɨ jɨtʉ nu ubhwɨndi bhwɨtʉ. Tukiibhurwa ni isimʉka yʉ ʉbhʉbhɨ ncha abhaatʉ abhandɨ, na twarɨ toreenderwa ukutinirwa kwa Mungu. <verse eid="EPH 2:3"/><verse number="4" style="v" sid="EPH 2:4"/>Nawe Mungu nɨ‑wɨ ɨbhɨgʉngi bhyaru, na kʉ kʉbha atʉsɨɨgirɨ kʉbhʉsɨɨgi bhwazɨ ʉbhʉkʉrʉ, <verse eid="EPH 2:4"/><verse number="5" style="v" sid="EPH 2:5"/>akatokora bhahʉru hamwɨmwɨ na Kiriisitʉ. Akakorabhu nʉʉrʉ twarɨ bhaku igʉrʉ wʉ ʉbhʉbhɨ bhwɨtʉ. Kʉbhɨgʉngi bhya Mungu imwɨ mʉsabhwirwɨ. <verse eid="EPH 2:5"/><verse number="6" style="v" sid="EPH 2:6"/>Ku ukutugwatanʼya na Yɨɨsu Kiriisitʉ, Mungu akaturyʉra kurwa mʉbhaku hamwɨmwɨ na Kiriisitʉ, akatwikarya hamwɨmwɨ nawe mwisaarʉ. <verse eid="EPH 2:6"/><verse number="7" style="v" sid="EPH 2:7"/>Akakorabhu, korereke erekenʼye kwa bhʉʉsi kwibhaga rɨnʉ rikuuza, ʉbhʉzʉmu bhwazɨ kwa niitwɨ kʉhɨtɨra Yɨɨsu Kiriisitʉ, kʉbhɨgʉngi bhyazɨ bhyaru bhɨnʉ bhɨtaana tɨnɨrʉ. <verse eid="EPH 2:7"/><verse number="8" style="v" sid="EPH 2:8"/>Mʉsabhwirwɨ kʉbhɨgʉngi bhyazɨ, kʉnzɨra yu ukwisirirya Yɨɨsu Kiriisitʉ. Ubhutuurya bhuyo, bhʉtakurwa kwa niimwɨ, nɨ‑mʉbhanʉ kurwa kwa Mungu. <verse eid="EPH 2:8"/><verse number="9" style="v" sid="EPH 2:9"/>Ataabhasabhwirɨ igʉrʉ wa amahocha gaanyu, mʉʉtʉ wʉwʉʉsi ataaza kwikumya. <verse eid="EPH 2:9"/><verse number="10" style="v" sid="EPH 2:10"/>Itwɨ tubhumbirwɨ bhuhya na Mungu. Akakorabhu ku ukutugwatanʼya na Yɨɨsu Kiriisitʉ, tokore amahocha amazʉmu ganʉ aakʉrirɨ kwɨma ɨkarɨ korereke tʉgakore.<verse eid="EPH 2:10"/></para>
  <para style="s">Ʉbhʉmwɨmwɨ kʉnzɨra ya Kiriisitʉ</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11"/>Mmbe, imwɨ bhanʉ isimʉka yanyu, nɨ‑bhaatʉ bhi ibhyarʉ ɨbhɨndɨ, mʉtaarɨ Abhayaahudi. Abhayaahudi bharabhabhɨrɨkɨra “abhariisha,” nawe ebho bhariibhɨrɨkɨra “abhasaarwa,”<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fk" closed="false">Abhasaarwa</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">ʉkʉsaara</char> muKiniibhasa.</note> kʉ kʉbha yɨ ɨsaarʉ yɨ ɨmɨbhɨrɨ jabhʉ, yɨnʉ ekokorwa na abhaatʉ. Imwɨ muhiitɨ chɨmbu mwarɨ ribhaga riyo, <verse eid="EPH 2:11"/><verse number="12" style="v" sid="EPH 2:12"/>mʉtaarɨ mwɨzɨ igʉrʉ wa Kiriisitʉ, mʉtaarɨ bhamwɨ na abhaatʉ bha Iziraɨri, mwarɨ bhagini bhanʉ mʉtaarɨ nʉ ʉbhʉragɨ<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="fk" closed="false">Ʉbhʉragɨ</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> bhʉnʉ Mungu aabharagɨɨnʼyɨ. Kwɨbhu mʉtaarɨ nu ubhwisɨgi na mukiikara ncha abhaatʉ bhanʉ bhatɨɨzɨ Mungu mʉʉsɨ yɨnʉ. <verse eid="EPH 2:12"/><verse number="13" style="v" sid="EPH 2:13"/>Nawe nangʉ, ku ukugwatana kwa niimwɨ na Yɨɨsu Kiriisitʉ, bhanʉ ɨkarɨ mwarɨ kore, mʉbhɨɨrɨ haguhɨ kʉnzɨra ya amasaahɨ ga Kiriisitʉ.<verse eid="EPH 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14"/>Kiriisitʉ umwene arɨɨtirɨ omorembe gatɨ wɨɨtʉ, Abhayaahudi na bhanʉ bhatarɨ Abhayaahudi. Itwɨ bhanʉ twarɨ tʉtaanirɨ, akatokora tʉbhɨ bhamwɨ. Akaasha inyiki yu ubhubhisa bhʉnʉ bhwatʉtaaniryɨ. <verse eid="EPH 2:14"/><verse number="15" style="v" sid="EPH 2:15"/>Hanʉ aahurukiryɨ ʉmʉbhɨrɨ gwazɨ, akaruushaho imigirʉ ja Mungu hamwɨmwɨ na amaswaja gaazɨ, korereke kurwa amaribhita abhɨrɨ gayo, akore riribhita rɨmwɨ riihya. Ɨbhu nɨmbu aarɨɨtirɨ omorembe gatɨ wɨɨtʉ. <verse eid="EPH 2:15"/><verse number="16" style="v" sid="EPH 2:16"/>Kiriisitʉ akaruushaho ubhubhisa bhwɨtʉ kʉnzɨra yu ukukwa kwazɨ kʉmʉsarabha. Ko kokorabhu akagwatanʼya amaribhita abhɨrɨ gayo kʉbha rɨmwɨ, na kutugwatanʼya kwa Mungu. <verse eid="EPH 2:16"/><verse number="17" style="v" sid="EPH 2:17"/>Mmbe, Kiriisitʉ akaaza, akarwaza Ɨngʼana Ɨnzʉmu igʉrʉ wo omorembe, kwa niimwɨ bhanʉ mwarɨ kore, na kwa Abhayaahudi bhanʉ bhiirʉʉzɨ bhamwɨzɨ. <verse eid="EPH 2:17"/><verse number="18" style="v" sid="EPH 2:18"/>Nangʉ kʉhɨtɨra kwawe, itwʉsi, Abhayaahudi na bhanʉ bhatarɨ Abhayaahudi, tubhwɨnɨ umweya gu ukwisukɨra Bhaabha kʉnzɨra yɨmwɨ, kʉ kʉhɨtɨra Ekoro Ɨndɨndu.<verse eid="EPH 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19"/>Mmbe nangʉ, imwɨ Abheefeeso bhanʉ mʉtarɨ Abhayaahudi, mʉtarɨ bhagini na bhahiti, nawe mʉbhɨɨrɨ abhiikari hamwɨmwɨ na abharɨndu, abhaatʉ bha munyumba ya Mungu. <verse eid="EPH 2:19"/><verse number="20" style="v" sid="EPH 2:20"/>Ni inyumba yiyo yʉmbakirwɨ kʉbhʉrʉsa, nʉ ʉbhʉrʉsa bhuyo, nɨ‑bhatumwa na abharʉʉtɨrɨri.<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="fk" closed="false">Ʉbhʉrʉsa bhuyo, nɨ‑bhatumwa na abharʉʉtɨrɨri</char><char style="ft" closed="false">, ʉbhʉgaruri ʉbhʉndɨ bhʉratʉra kʉbha, </char><char style="fqa" closed="false">ʉbhʉrʉsa bhuyo bhʉtɨɨrwɨ na abhatumwa na abharʉʉtɨrɨri.</char></note> Yɨɨsu Kiriisitʉ umwene, ni‑riibhwɨ rikʉrʉ ryʉ ʉbhʉrʉsa bhuyo. <verse eid="EPH 2:20"/><verse number="21" style="v" sid="EPH 2:21"/>Ewe newe akwʉmbaka rikindasi ryʉsi kuhika rɨragwatana bhwaheene, na korekora rɨbhɨ ɨkʉrʉ ncha rihekaaru rirɨndu ryʉ Ʉmʉkʉrʉ. <verse eid="EPH 2:21"/><verse number="22" style="v" sid="EPH 2:22"/>Ku ukugwatana nawe, imwʉsi mʉragwatanibhwa hamwɨmwɨ mʉbhɨ ubhwikari bhwa Mungu kʉnzɨra ye Ekoro yaazɨ.<verse eid="EPH 2:22"/></para>
  <chapter eid="EPH 2"/>
  <chapter number="3" style="c" sid="EPH 3"/>
  <para style="s">Amahocha ga Paaurʉ kʉbhaatʉ bhi ibhyarʉ ɨbhɨndɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1"/>Igʉrʉ wa gayo, niinyɨ Paaurʉ, nɨrabhasabhɨra kwa Mungu. Nɨbhʉhirwɨ igʉrʉ we emeremo gɨnʉ Yɨɨsu Kiriisitʉ aangʼɨɨrɨ ju ukurwaza Ɨngʼana Ɨnzʉmu, kʉbhaniimwɨ bhanʉ mʉtarɨ Abhayaahudi. <verse eid="EPH 3:1"/><verse number="2" style="v" sid="EPH 3:2"/>Maheene Mungu antɨɨrɨ kʉbha omohocha waazɨ wu ukurwaza Ɨngʼana Ɨnzʉmu yɨ ɨbhɨgʉngi bhyazɨ kwa niimwɨ. Nɨɨzɨ mwamarirɨ kwigwa giyo. <verse eid="EPH 3:2"/><verse number="3" style="v" sid="EPH 3:3"/>Na Mungu umwene akahumburɨra imbisi yaazɨ, chɨmbu nakangatirɨ kʉbhaandɨkɨra kwa mangʼana masuuhu. <verse eid="EPH 3:3"/><verse number="4" style="v" sid="EPH 3:4"/>Moreesome amangʼana gayo, mʉratʉra kwobhoora chɨmbu nɨɨzɨ ɨsɨɨmi ya Mungu igʉrʉ wa Kiriisitʉ. <verse eid="EPH 3:4"/><verse number="5" style="v" sid="EPH 3:5"/>Ɨkarɨ hayo, Mungu ataahumburiirɨ abhaatʉ ɨsɨɨmi yaazɨ yiyo. Nawe nangʉ akʉrɨɨrɨ Ekoro yaazɨ kʉbhahumburɨra abhatumwa na abharʉʉtɨrɨri bhaazɨ abharɨndu. <verse eid="EPH 3:5"/><verse number="6" style="v" sid="EPH 3:6"/>Ɨsɨɨmi yaazɨ nɨ‑kʉbha, kʉnzɨra yu ukwisirirya Ɨngʼana Ɨnzʉmu, abhaatʉ bhanʉ bhatarɨ Abhayaahudi na Abhayaahudi bharagabha hamwɨmwɨ ʉbhʉtɨmi bhwa Mungu. Bharabha hamwɨmwɨ nchi ibhiimʉ bhyʉ ʉmʉbhɨrɨ. Kʉhɨtɨra Yɨɨsu Kiriisitʉ bharasʉngʼaana hamwɨmwɨ ʉbhʉragɨ bhʉnʉ Mungu aaragɨɨnʼyɨ kʉbhahaka Abhayaahudi.<verse eid="EPH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7"/>Mungu akankora omohocha wʉ ʉkʉraganʼya Ɨngʼana Ɨnzʉmu yɨnʉ, kurwa kʉbhɨgʉngi bhyazɨ. Akangʼa ɨbhɨgʉngi bhiyo kʉbhʉnaja bhwazɨ mubhwikari bhwanɨ. <verse eid="EPH 3:7"/><verse number="8" style="v" sid="EPH 3:8"/>Inyɨ ni‑musuuhu kʉkɨra abharɨndu bhʉʉsi bha Mungu, nawe Mungu akangʼa ɨbhɨgʉngi bhɨnʉ kurwazɨra abhaatʉ bhanʉ bhatarɨ Abhayaahudi, ubhuniibhi bhwa Kiriisitʉ bhʉnʉ bhʉtaana kerengo, <verse eid="EPH 3:8"/><verse number="9" style="v" sid="EPH 3:9"/>na kʉbhabhʉʉrɨra bhʉʉsi, bhamenye chɨmbu akʉmara ɨsɨɨmi yaazɨ. Ɨsɨɨmi yiyo yaarɨ ibhisirwɨ ibhaga ryʉsi na Mungu, Umubhumbi we ebhegero bhyʉsi. <verse eid="EPH 3:9"/><verse number="10" style="v" sid="EPH 3:10"/>Ubhwɨndi bhwazɨ nɨ‑kʉbha, ubhwʉbhʉʉri bhwazɨ bhwa teemwa nzaru, bhomenyekanɨ abhatɨmi na abhakʉrʉ bhe ewereero yɨnʉ ɨtakororekana, kʉnzɨra ya risengerero. <verse eid="EPH 3:10"/><verse number="11" style="v" sid="EPH 3:11"/>Mungu akakorabhu kʉrɨngʼaana nɨ ɨsɨɨmi yaazɨ ya zisikʉ zʉʉsi, yɨnʉ aamarirɨ kʉnzɨra ya Yɨɨsu Kiriisitʉ, Ʉmʉkʉrʉ wɨɨtʉ. <verse eid="EPH 3:11"/><verse number="12" style="v" sid="EPH 3:12"/>Nangʉ, kʉ kʉbha turiisirirya Yɨɨsu Kiriisitʉ na tugwatɨɨnɨ nawe, tʉratʉra kuja kwa Mungu tʉtaana bhwʉbha. <verse eid="EPH 3:12"/><verse number="13" style="v" sid="EPH 3:13"/>Mmbe, nɨrabhasabha mʉtakwa umwʉyʉ kʉ kʉbha yɨ ɨnyaakʉ yɨnʉ nekobhona igʉrʉ waanyu, kʉ kʉbha ereerecha nɨrabhasʉʉka.<verse eid="EPH 3:13"/></para>
  <para style="s">Paaurʉ arasabhɨra Abhakiriisitʉ</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14"/>Mmbe, kʉ kʉbha ya amangʼana gayo gʉʉsi, nɨrahigamɨra Bhaabha Mungu. <verse eid="EPH 3:14"/><verse number="15" style="v" sid="EPH 3:15"/>Ewe newe isimʉka ye ebhegero bhyʉsi bhya mwisaarʉ na kʉʉsɨ. <verse eid="EPH 3:15"/><verse number="16" style="v" sid="EPH 3:16"/>Nɨrasabha Mungu, kʉrɨngʼaana nu ubhuniibhi bhʉ ʉbhʉgʉngʉ bhwazɨ, abhahɨ amanaga, kʉhɨtɨra Ekoro yaazɨ, mʉnagɨ mumyʉyʉ janyu, <verse eid="EPH 3:16"/><verse number="17" style="v" sid="EPH 3:17"/>na Kiriisitʉ iikarɨmu, kubhwisirirya bhʉnʉ mʉnabhwɨ. Na kʉ kʉbha muni imiri ɨmɨnagu nʉ ʉbhʉrʉsa kʉbhʉsɨɨgi bhwa Kiriisitʉ, <verse eid="EPH 3:17"/><verse number="18" style="v" sid="EPH 3:18"/>nɨrabhasabhɨra imwɨ hamwɨmwɨ na abharɨndu bhʉʉsi, momenye ʉbhʉgarɨ, ubhwina, ʉbhʉrɨɨhu ni ikihiko chʉ ʉbhʉsɨɨgi bhwazɨ. <verse eid="EPH 3:18"/><verse number="19" style="v" sid="EPH 3:19"/>Momenye chɨmbu ʉbhʉsɨɨgi bhwazɨ nɨ‑bhʉkʉrʉ kʉkɨra ubhwʉbhʉʉri bhwɨtʉ, korereke zeteemwa zaanyu zituubhanɨ na za Mungu.<verse eid="EPH 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20"/>Mmbe Mungu akumibhwɨ! Ewe aratʉra kokora amangʼana gɨ ɨkɨrʉgʉʉrʉ bhʉkʉngʼu, kʉkɨra ganʉ tʉkʉmʉsabha, hamwɨ ganʉ tukukina, aratʉra kokora. Ewe ahaagakora kʉrɨngʼaana na amanaga ganʉ gakokora emeremo mʉʉsi wɨɨtʉ. <verse eid="EPH 3:20"/><verse number="21" style="v" sid="EPH 3:21"/>Agungibhwɨ mwisengerero na kwa Yɨɨsu Kiriisitʉ, muzinyibhʉrʉ zʉʉsi, kemerano. Garamɨ.<verse eid="EPH 3:21"/></para>
  <chapter eid="EPH 3"/>
  <chapter number="4" style="c" sid="EPH 4"/>
  <para style="s">Abhiisirirya bha Yɨɨsu bhanu ubhumwɨmwɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1"/>Mmbe, inyɨ omobhohwa, kʉ kʉbha nɨrakorera Ʉmʉkʉrʉ Yɨɨsu emeremo, nɨrabhakandikija mwikarɨ ubhwikari ʉbhʉzʉmu bhʉnʉ bhokozomera Mungu wʉnʉ aabhabhirikiriirɨ. <verse eid="EPH 4:1"/><verse number="2" style="v" sid="EPH 4:2"/>Mʉbhɨ bhasuuku, bhanyʉʉhu, abhiigumirirya, na mʉbhɨ muriigega kʉbhʉsɨɨgi. <verse eid="EPH 4:2"/><verse number="3" style="v" sid="EPH 4:3"/>Mokore umucha kuriibha ubhumwɨmwɨ bhʉnʉ mwagwataniibhwɨ ne Ekoro Ɨndɨndu, ku kwikara hamwɨmwɨ komorembe. <verse eid="EPH 4:3"/><verse number="4" style="v" sid="EPH 4:4"/>Itubhʉʉsi tʉrɨ mʉbhɨrɨ gʉmwɨ, Ekoro Ɨndɨndu nɨ‑yɨmwɨ, na amazʉmu ganʉ Mungu atutuuriirɨ tugiisege, nɨ‑gamwɨ. <verse eid="EPH 4:4"/><verse number="5" style="v" sid="EPH 4:5"/>Ʉmʉkʉrʉ wɨɨtʉ, nɨ‑wʉmwɨ, ubhwisirirya bhwɨtʉ, nɨ‑bhʉmwɨ nʉ ʉbhʉbhatiizi bhwɨtʉ, nɨ‑bhʉmwɨ. <verse eid="EPH 4:5"/><verse number="6" style="v" sid="EPH 4:6"/>Itubhʉʉsi tʉrasengera Mungu wʉmwɨ, ewe newe Bhaabha wa bhʉʉsi, arakangata bhʉʉsi, arakora emeremo kwa bhʉʉsi na ariikara mʉʉsi wa bhʉʉsi.<verse eid="EPH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7"/>Nawe Kiriisitʉ akatoha itubhʉʉsi ɨbhɨgʉngi, kʉrɨngʼaana chɨmbu umwene ɨɨndirɨ. <verse eid="EPH 4:7"/><verse number="8" style="v" sid="EPH 4:8"/>Necho kigiriryɨ Amaandɨkʉ Amarɨndu garabhuga,</para>
  <para style="q" vid="EPH 4:8">“Hanʉ aatiirirɨ igʉrʉ mwisaarʉ,</para>
  <para style="q" vid="EPH 4:8">akaja na abhabhisa bhaazɨ bhanʉ aagwatirɨ,</para>
  <para style="q" vid="EPH 4:8">akabhaha abhaatʉ ʉbhʉnaja.”<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="xt" closed="false">Rora <ref loc="PSA 68:18">Zabhuri 68:18</ref>.</char></note><verse eid="EPH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 4:9"/>Mmbe, kubhuga, “Akabhururuka igʉrʉ mwisaarʉ,” enzobhooro yaku nɨkɨ? Enzobhooro yaku nɨ‑kʉbha, hanʉ aarɨ akɨɨrɨ kuja igʉrʉ, akiika haasɨ kuhika kʉʉsɨ. <verse eid="EPH 4:9"/><verse number="10" style="v" sid="EPH 4:10"/>Ewe wʉnʉ iikirɨ kuhika kʉʉsɨ hanʉ, newe aagiirɨ igʉrʉ wa amasaarʉ gʉʉsi, korereke atʉrɨ kʉbhaho hʉʉsi mwisaarʉ na mʉʉsɨ. <verse eid="EPH 4:10"/><verse number="11" style="v" sid="EPH 4:11"/>Ewe newe ahɨɨrɨ abhaatʉ ʉbhʉnaja. Arʉbhwɨrɨ abhandɨ kʉbha abhatumwa, abhandɨ abharʉʉtɨrɨri, abhandɨ abhiinjiriisiti, abhandɨ abhiimiiririri na abhiija. <verse eid="EPH 4:11"/><verse number="12" style="v" sid="EPH 4:12"/>Akakorabhu, korereke bhatʉrɨ kʉbhatʉʉra bhwaheene abharɨndu komokorera emeremo, nʉ ʉmʉbhɨrɨ gwa Kiriisitʉ gʉʉmbakwɨ. <verse eid="EPH 4:12"/><verse number="13" style="v" sid="EPH 4:13"/>Ringʼana riyo, rengʼehe kuhika itwɨ bhʉʉsi hanʉ tʉkʉbha bhamwɨ mubhwisirirya bhwɨtʉ, na komenya Umwana wa Mungu. Tʉrabha abhaatʉ bhanʉ tʉkʉngʼirɨ chɨmbu Kiriisitʉ.<verse eid="EPH 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 4:14"/>Mmbe, tʉtakʉbha ncha abhaana abhabhataarɨ, kʉnyaakibhwa ɨnʉ nɨ ɨnʉ mʉmʉkama gwa amiija ganʉ abhabhɨɨhi bhakoreeta. Abhaatʉ bhayo, bhaheenda bhabharimiryɨ kumiija gaabhʉ gʉ ʉbhʉngʼɨɨni nʉ ʉrʉrɨmɨ. <verse eid="EPH 4:14"/><verse number="15" style="v" sid="EPH 4:15"/>Nawe, tʉrɨɨbhɨ turiibhʉʉrɨra amaheene kumwʉyʉ gwʉ ʉbhʉsɨɨgi, tʉrakongʼera mʉmangʼana gʉʉsi, kuhikɨra hanʉ tʉraabhɨ ncha Kiriisitʉ. Ewe newe umutwɨ gwa abhiisirirya bhʉʉsi. <verse eid="EPH 4:15"/><verse number="16" style="v" sid="EPH 4:16"/>Ewe aragwatanʼya abhaatʉ bhaazɨ bhʉʉsi bharabha bhamwɨ, chɨmbu ibhiimʉ bhyʉ ʉmʉbhɨrɨ bhikugwatana, na kʉbha mʉbhɨrɨ gʉmwɨ. Arɨɨbhɨ ibhiimʉ bhyʉsi bhɨrakora emeremo chɨmbu ikwenderwa, ʉrakʉra. Mmbe arɨɨbhɨ itubhʉʉsibhu tʉrakora emeremo gɨnʉ Kiriisitʉ atʉhɨɨrɨ chɨmbu ikwenderwa, tʉrangʼeha kʉkʉra kwa kʉsɨɨgana.<verse eid="EPH 4:16"/></para>
  <para style="s">Ubhwikari bhwa nangwɨnʉ nu ubhwikari bhwɨ ɨkarɨ</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17"/>Mmbe nangʉ, mwitegeerere! Kʉbhʉnaja bhʉnʉ Ʉmʉkʉrʉ Yɨɨsu aangʼɨɨrɨ, nɨrabhamenyeekererya, mutiikara naatu ncha abhaatʉ bhanʉ bhatamwɨzɨ Mungu. Ebho amiisɨɨgi gaabhʉ, gataana bhwera. <verse eid="EPH 4:17"/><verse number="18" style="v" sid="EPH 4:18"/>Na amangʼɨɨni gaabhʉ igʉrʉ wa amaheene ga Mungu, garibhirwɨ. Bharɨ kore nu ubhwikari ʉbhʉzʉmu bhʉnʉ bhukurwa kwa Mungu, kʉ kʉbha yo obhogeege bhwabhʉ nʉ ʉbhʉkʉngʼu bhwi imyʉyʉ jabhʉ. <verse eid="EPH 4:18"/><verse number="19" style="v" sid="EPH 4:19"/>Bhatakorora zɨsʉni nʉʉrʉ suuhu, bhiisikiiryɨ mozeteemwa zʉʉsi zu ubhusimbɨ. Na bhanu umwʉyʉ gwo okongʼeha kokora ɨtaarʉ.<verse eid="EPH 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20"/>Nawe imwɨ, mutiigirɨbhu igʉrʉ wa Kiriisitʉ. <verse eid="EPH 4:20"/><verse number="21" style="v" sid="EPH 4:21"/>Nɨna amaheene kʉbha, mwigwirɨ bhwaheene ɨngʼana na amiija igʉrʉ waazɨ. Ewe newe ʉbhʉtangɨ bhwa amaheene gʉʉsi. <verse eid="EPH 4:21"/><verse number="22" style="v" sid="EPH 4:22"/>Mukiijibhwa kʉbha, mutigɨ zeteemwa zaanyu zɨ ɨkarɨ, zɨnʉ zɨkʉsaribhwa nu umwʉyʉ gʉ ʉbhʉkangirirya. <verse eid="EPH 4:22"/><verse number="23" style="v" sid="EPH 4:23"/>Na mokorwe bhahya mumiisɨɨgi ga zekoro zaanyu. <verse eid="EPH 4:23"/><verse number="24" style="v" sid="EPH 4:24"/>Na mʉbhɨ ne eteemwa iihya yɨnʉ yabhumbirwɨ na Mungu, mutuubhanɨ neewe, nɨ‑bhaheene mʉrɨ na abharɨndu.<verse eid="EPH 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25"/>Mmbe, mutigɨ ʉrʉrɨmɨ, abhaatʉ bhʉʉsi bhabhɨ bhariibhʉʉrɨra amaheene, kʉ kʉbha itwʉsi ni‑bhiimʉ bhyʉ ʉmʉbhɨrɨ gʉmwɨ. <verse eid="EPH 4:25"/><verse number="26" style="v" sid="EPH 4:26"/>Mʉbhɨ nu ubhwigatani, nawe mʉtakora ʉbhʉbhɨ, iryʉbha rɨtatʉbhɨra mʉkɨɨrɨ mwigatɨɨnɨ. <verse eid="EPH 4:26"/><verse number="27" style="v" sid="EPH 4:27"/>Mʉtamoha Shɨtaani umweya abhahizɨ. <verse eid="EPH 4:27"/><verse number="28" style="v" sid="EPH 4:28"/>Umwibhi, atiibha naatu, nawe akore emeremo ɨmɨzʉmu kʉmabhoko gaazɨ umwene, korereke atʉrɨ kʉbha ne ekegero cho okosondera wʉnʉ ataanachʉ. <verse eid="EPH 4:28"/><verse number="29" style="v" sid="EPH 4:29"/>Mʉtagamba amangʼana amabhɨ, mʉgambɨ amangʼana amazʉmu gʉ ʉkʉsakirya abhandɨ kubhwɨndi bhwabhʉ. Gayo, garatʉra kʉbha na bhwera kʉbhanʉ bhakugitegeerera. <verse eid="EPH 4:29"/><verse number="30" style="v" sid="EPH 4:30"/>Amahocha gaanyu, gatakora Ekoro Ɨndɨndu ya Mungu irumɨkɨ, kʉ kʉbha ewe nɨ‑rʉkaamʉ rwa Mungu kwa niimwɨ, rʉnʉ rukwerecha imwɨ nɨ‑bhaatʉ bhaazɨ, kuhika urusikʉ rʉnʉ Mungu akʉbhasabhʉra. <verse eid="EPH 4:30"/><verse number="31" style="v" sid="EPH 4:31"/>Mmbe, mutiganɨ nʉ ʉbhʉhaari, ubhwigatani, ʉbhʉrʉrʉ, rirɨgɨ, amatuki nʉ ʉbhʉbhɨ bhwa zeteemwa zʉʉsi. <verse eid="EPH 4:31"/><verse number="32" style="v" sid="EPH 4:32"/>Nawe mʉbhɨ muriikorera amazʉmu, mʉbhɨ bhɨ ɨbhɨgʉngi, na mʉbhɨ muriibheerera chɨmbu Mungu aabhabhɨɨrɨɨrɨ imwɨ kʉnzɨra ya Kiriisitʉ.<verse eid="EPH 4:32"/></para>
  <chapter eid="EPH 4"/>
  <chapter number="5" style="c" sid="EPH 5"/>
  <para style="s">Ukwikara chɨmbu Mungu akwenda</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1"/>Kwɨbhu mwɨgɨ Mungu, kʉ kʉbha imwɨ, nɨ‑bhaana bhaazɨ abhasɨɨgwa. <verse eid="EPH 5:1"/><verse number="2" style="v" sid="EPH 5:2"/>Mwikarɨ kʉbhʉsɨɨgi chɨmbu Kiriisitʉ aatʉsɨɨgirɨ, akiihurucha kukwa igʉrʉ wɨɨtʉ, akabha ikimweso<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="fk" closed="false">Ikimweso</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> kɨnʉ kekoreetya kwa Mungu.<verse eid="EPH 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3"/>Nawe mʉtabhirwaku igʉrʉ wɨ ɨtaarʉ, umwʉyʉ gwe ebhegero, nu ubhubhuruuru bhwʉbhwʉsi kʉ kʉbha amangʼana gayo gatakwenderwa kʉbharɨndu bha Mungu. <verse eid="EPH 5:3"/><verse number="4" style="v" sid="EPH 5:4"/>Mʉtagamba mangʼana ga sʉni ganʉ gataana bhwera, na kʉhakaana, gayo gatakwenderwa, nawe mʉgambɨ amangʼana gu ukukumya Mungu. <verse eid="EPH 5:4"/><verse number="5" style="v" sid="EPH 5:5"/>Momenye, kwigomba ebhegero kwangɨ okosengera amasambwa. Momenye na kʉkandikija kʉbha abhiimani, abhabhɨ na abhasɨɨgi bhɨ ɨtaarʉ bhatakʉgabha chʉchʉsi mʉbhʉtɨmi bhwa Kiriisitʉ na bhwa Mungu.<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="fk" closed="false">Ʉbhʉtɨmi bhwa Kiriisitʉ na bhwa Mungu</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">ʉbhʉtɨmi bhwa Mungu</char> muKiniibhasa.</note><verse eid="EPH 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6"/>Mutiisirirya kʉkangiribhwa na mʉʉtʉ kwa amangʼana ganʉ gataana bhwera, kʉ kʉbha amangʼana ncha gayo, garagirya Mungu abhatɨnɨrɨ bhanʉ bhatakumwigwa. <verse eid="EPH 5:6"/><verse number="7" style="v" sid="EPH 5:7"/>Mmbe mʉtagwatana na abhaatʉ ncha bhayo, <verse eid="EPH 5:7"/><verse number="8" style="v" sid="EPH 5:8"/>kʉ kʉbha ɨkarɨ imwʉsi mwarɨ ikiirimya, nawe nangwɨnʉ mʉbhɨɨrɨ ubhwɨrʉ kʉMʉkʉrʉ Yɨɨsu. Mwikarɨ ncha abhaana bhu ubhwɨrʉ. <verse eid="EPH 5:8"/><verse number="9" style="v" sid="EPH 5:9"/>Amangʼana ganʉ gakwerekenʼya muriikara mubhwɨrʉ ne‑kokora amazʉmu gʉʉsi, ganʉ Mungu akwenda, na ga amaheene. <verse eid="EPH 5:9"/><verse number="10" style="v" sid="EPH 5:10"/>Mokore umucha komenya nɨ‑kɨgʉrʉkɨ kekozomera Ʉmʉkʉrʉ. <verse eid="EPH 5:10"/><verse number="11" style="v" sid="EPH 5:11"/>Mʉtagwatana na amangʼana gaabhʉ amabhɨ, nawe mʉgatʉʉrɨ habhwɨrʉ, <verse eid="EPH 5:11"/><verse number="12" style="v" sid="EPH 5:12"/>kʉ kʉbha ganʉ gakokorwa kwebho kimbisi nɨ‑sʉni kʉgagamba. <verse eid="EPH 5:12"/><verse number="13" style="v" sid="EPH 5:13"/>Nawe chʉchʉsi kɨnʉ kikumurikwa nu ubhwɨrʉ kɨhaarorekana, na ganʉ gari mukiirimya gatakʉsaaga muryamurya, garabha ubhwɨrʉ. <verse eid="EPH 5:13"/><verse number="14" style="v" sid="EPH 5:14"/>Necho ɨrabhugwa,</para>
  <para style="q" vid="EPH 5:14">“Bhʉʉka awɨ wʉnʉ uhindiirɨ,</para>
  <para style="q" vid="EPH 5:14">uryʉkɨ kurwa mʉbhaku,</para>
  <para style="q" vid="EPH 5:14">na Kiriisitʉ arakʉmʉrɨka.”<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">Amangʼana ganʉ gatakurwa kʉBhʉragɨ bhwɨ Ɨkarɨ. Ɨrarorekana amangʼana ganʉ gakakorwa kuryɨmbʉ ryi Ikikiriisitʉ. Kuryɨmbʉ rɨnʉ bhakakora hagero haaru hi Ibhibhuriya, kokerenjo </char><char style="xt" closed="false"><ref loc="ISA 26:19">Isaaya 26:19</ref>, <ref loc="ISA 60:1">60:1</ref>. </char><char style="ft" closed="false">Rora kwikɨ </char><char style="xt" closed="false"><ref loc="ROM 13:11">Abharuumi 13:11</ref>.</char></note><verse eid="EPH 5:14"/></para>
  <para style="m">
    <verse number="15" style="v" sid="EPH 5:15"/>Nangʉ mwiyangarɨrɨ chɨmbu mukwikara, mutiikara ncha abhageege nawe mwikarɨ ncha bhu ubhwʉbhʉʉri. <verse eid="EPH 5:15"/><verse number="16" style="v" sid="EPH 5:16"/>Mʉtarimirya ribhaga, kʉ kʉbha ribhaga rɨnʉ ni‑rya amabhɨ. <verse eid="EPH 5:16"/><verse number="17" style="v" sid="EPH 5:17"/>Kwɨbhu mʉtabha bhageege, momenye ubhwɨndi bhwʉ Ʉmʉkʉrʉ nɨkɨ. <verse eid="EPH 5:17"/><verse number="18" style="v" sid="EPH 5:18"/>Naatu mʉtagwatwa amarwa, kʉ kʉbha ɨragirya kokora amangʼana ganʉ gatanzabhɨɨnɨ, nawe mwizuribhwɨ ne Ekoro Ɨndɨndu. <verse eid="EPH 5:18"/><verse number="19" style="v" sid="EPH 5:19"/>Kʉgayo, mʉbhɨ mʉragambana kwa zabhuri, amɨɨmbʉ na zɨtɨnzi za mokoro ɨnʉ mʉrɨɨmba na kuriiryatɨra Ʉmʉkʉrʉ mumyʉyʉ janyu. <verse eid="EPH 5:19"/><verse number="20" style="v" sid="EPH 5:20"/>Na mʉbhʉʉrɨrɨ Bhaabha Mungu azʉmiryɨ, sikʉ zʉʉsi kʉmangʼana gʉʉsi, kuriina ryʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ.<verse eid="EPH 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21"/>Mwisʉʉkɨ abheene kobheene kʉ kʉbha yu ubhusuuku bhʉnʉ mʉnabhwɨ kwa Kiriisitʉ.<verse eid="EPH 5:21"/></para>
  <para style="s">Abhasubhɨ na abhakari</para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22"/>Abhakari imwɨ, mʉsʉʉkɨ abhasubhɨ bhaanyu chɨmbu mʉkʉsʉʉka Ʉmʉkʉrʉ Yɨɨsu. <verse eid="EPH 5:22"/><verse number="23" style="v" sid="EPH 5:23"/>Moreenderwa kokorabhu kʉ kʉbha umusubhɨ ni‑mutwɨ gwa mʉkaazɨ, chɨmbu Kiriisitʉ wʉʉsi ni‑mutwɨ gwa risengerero. Neewe nɨ‑Mʉsabhuri wʉ ʉmʉbhɨrɨ gwazɨ. <verse eid="EPH 5:23"/><verse number="24" style="v" sid="EPH 5:24"/>Mmbe chɨmbu risengerero rɨkʉsʉʉka Kiriisitʉ, ɨbhuɨbhu na abhakari bhʉʉsi bhasʉʉkɨ abhasubhɨ bhaabhʉ kʉmangʼana gʉʉsi.<verse eid="EPH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25"/>Imwɨ abhasubhɨ, mʉsɨɨgɨ abhakari bhaanyu chɨmbu Kiriisitʉ wʉʉsi aasɨɨgirɨ risengerero, akiihurucha kukwa igʉrʉ waryʉ. <verse eid="EPH 5:25"/><verse number="26" style="v" sid="EPH 5:26"/>Akakorabhu korereke arekore rirɨndu kwa kuryoja kwa amanzi, kwingʼana ryazɨ. <verse eid="EPH 5:26"/><verse number="27" style="v" sid="EPH 5:27"/>Akeenda ibhonere risengerero rirɨndu, rɨnʉ rɨtaana isoro nʉʉrʉ kobhenga kwʉkwʉsi. <verse eid="EPH 5:27"/><verse number="28" style="v" sid="EPH 5:28"/>Ɨbhuɨbhu ɨrabheenda abhasubhɨ bhʉʉsi kʉsɨɨga abhakari bhaabhʉ chɨmbu ɨmɨbhɨrɨ jabhʉ abheene. Wʉnʉ akʉsɨɨga mʉkaazɨ ahiisɨɨga umwene. <verse eid="EPH 5:28"/><verse number="29" style="v" sid="EPH 5:29"/>Atareeho ʉmʉʉtʉ wʉnʉ ahaabhiihirirwa ʉmʉbhɨrɨ gwazɨ, nawe ahaagutuga na kugwangarɨra. Ɨbhu nɨmbu Kiriisitʉ wʉʉsi akwangarɨra risengerero, <verse eid="EPH 5:29"/><verse number="30" style="v" sid="EPH 5:30"/>kʉ kʉbha itwɨ ni‑bhiimʉ bhyʉ ʉmʉbhɨrɨ gwazɨ. <verse eid="EPH 5:30"/><verse number="31" style="v" sid="EPH 5:31"/>“Igʉrʉ wa gayo, umusubhɨ aratiga wiisɨ na unina, aragwatana na mʉkaazɨ, na bhabhɨrɨ bhayo bharabha mʉbhɨrɨ gʉmwɨ.”<note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="xt" closed="false">Rora <ref loc="GEN 2:24">Ʉbhʉtangɨ 2:24</ref>.</char></note> <verse eid="EPH 5:31"/><verse number="32" style="v" sid="EPH 5:32"/>Imbisi yiyo nɨ‑kʉrʉ, nawe inyɨ nɨragamba amangʼana ga Kiriisitʉ na risengerero.<verse eid="EPH 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EPH 5:33"/>Nawe na niimwɨ imwʉsi nɨrabhabhʉʉrɨra, abhasubhɨ bhʉʉsi mʉsɨɨgɨ abhakari bhaanyu chɨmbu mwisɨɨgirɨ imubheene, na abhakari bhʉʉsi bhareenderwa kʉsʉʉka abhasubhɨ bhaabhʉ.<verse eid="EPH 5:33"/></para>
  <chapter eid="EPH 5"/>
  <chapter number="6" style="c" sid="EPH 6"/>
  <para style="s">Abhaana na abhiibhuri</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1"/>Imwɨ abhaana, kʉ kʉbha mugwatɨɨnɨ nʉ Ʉmʉkʉrʉ, mʉsʉʉkɨ abhiibhuri bhaanyu, ko kokorabhu ni ingʼana izʉmu. <verse eid="EPH 6:1"/><verse number="2" style="v" sid="EPH 6:2"/>“Ʉsʉʉkɨ wuusʉ na onyoko,” rɨnʉ neryo riswaja ryʉ ʉbhʉtangɨ bhwʉ ʉbhʉragɨ, <verse eid="EPH 6:2"/><verse number="3" style="v" sid="EPH 6:3"/>“korereke obhone omorembe nu ubhwikari sikʉ nzaru kʉʉsɨ.”<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="xt" closed="false">Rora <ref loc="EXO 20:12">Kʉhʉrʉka 20:12</ref>; <ref loc="DEU 5:16">Amahiityʉ gi Imigirʉ 5:16</ref>.</char></note><verse eid="EPH 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4"/>Na niimwɨ bha bhaabha, moteendeerya abhaana bhaanyu, nawe mʉbharere bhwaheene na kʉbhaha amiija kurwa kʉMʉkʉrʉ Yɨɨsu.<verse eid="EPH 6:4"/></para>
  <para style="s">Bhambʉʉsa na abhakʉrʉ bhaabhʉ</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5"/>Imwɨ bhambʉʉsa, mʉsʉʉkɨ abhakʉrʉ bhaanyu mucharʉ hanʉ, kubhusuuku na kurigita kwa mwʉyʉ gʉmwɨ, chɨmbu mʉkʉsʉʉka Kiriisitʉ. <verse eid="EPH 6:5"/><verse number="6" style="v" sid="EPH 6:6"/>Mokorebhu, ɨtarɨ hanʉ bhakʉbharora korereke mwikombe kwabhʉ, nawe mokore chɨmbu Mungu akwenda kwa mwʉyʉ mwɨrʉ, kʉ kʉbha imwɨ, nɨ‑bhahocha bha Kiriisitʉ. <verse eid="EPH 6:6"/><verse number="7" style="v" sid="EPH 6:7"/>Mohoche kwa mwʉyʉ gʉmwɨ chɨmbu kohokerya Ʉmʉkʉrʉ, na ɨtarɨ mʉrahokerya abhaatʉ. <verse eid="EPH 6:7"/><verse number="8" style="v" sid="EPH 6:8"/>Mwikarɨ mwɨzɨ kʉbha, ringʼana rizʉmu ryʉryʉsi rɨnʉ ʉmʉʉtʉ akokora, arahaabhwa nʉ Ʉmʉkʉrʉ kʉrɨngʼaana na amahocha gaazɨ, abhɨ nɨ‑mbʉʉsa hamwɨ ni‑mwiyagaaruri.<verse eid="EPH 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9"/>Na niimwɨ abhakʉrʉ, mʉbhakorere abhahocha bhaanyu gayogayo, mʉtabhʉʉbhahya. Muhiitɨ kʉbha imwɨ na abhahocha Ʉmʉkʉrʉ waanyu nɨ‑wʉmwɨ arɨ kwisaarʉ, na ataana kɨmbʉrʉʉri.<verse eid="EPH 6:9"/></para>
  <para style="s">Ebheseme bhya Mungu</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10"/>Ɨtɨnɨrʉ mongʼehe kokongʼera kʉMʉkʉrʉ na kʉbhʉnaja bhwa zinguru zaazɨ. <verse eid="EPH 6:10"/><verse number="11" style="v" sid="EPH 6:11"/>Mwibhohe ebheseme bhya Mungu bhyʉsi korereke mʉtʉrɨ kwanga ɨsɨɨmi ɨmbɨ ya Shɨtaani. <verse eid="EPH 6:11"/><verse number="12" style="v" sid="EPH 6:12"/>Nɨrabhugabhu kʉ kʉbha, riihɨ ryɨtʉ rɨtarɨ igʉrʉ wa abhaatʉ abheene, ni igʉrʉ wa abhatɨmi, igʉrʉ wa abhakʉrʉ bhi ikiirimya kɨnʉ, igʉrʉ wa abhasirikarɨ bha amasambwa kowereero yɨnʉ ɨtakororekana. <verse eid="EPH 6:12"/><verse number="13" style="v" sid="EPH 6:13"/>Kwɨbhu mogege ebheseme bhyʉsi bhya Mungu, korereke urusikʉ rwʉ ʉbhʉbhɨ rʉraahikɨ mʉtʉrɨ kwitana na abhabhisa, na mʉraamarɨ kwitana kuhika ɨtɨnɨrʉ, mwimɨɨrɨrɨ bhwɨma.<figure style="fig" alt="Wanavaa silaha za Mungu kwa kuomba" file="cn02076c.TIF" size="col" loc="EPH 6:13" copy="© 1996 David C Cook. Used by permission." ref="6:11-13">Bhariibhoha ebheseme bhya Mungu kwa kʉsabha</figure><verse eid="EPH 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14"/>Mmbe mwimɨɨrɨrɨ, amaheene gabhɨ ncho omokena mubhwena, ne eheene ɨbhɨ ncha amiibhoho gu ukwiribha mukikubha, <verse eid="EPH 6:14"/><verse number="15" style="v" sid="EPH 6:15"/>nu ubhwɨndi bhwʉ ʉkʉraganʼya Ɨngʼana Ɨnzʉmu yo omorembe ɨbhɨ nchi ibhikwɨra kobherenge bhyanyu. <verse eid="EPH 6:15"/><verse number="16" style="v" sid="EPH 6:16"/>Kʉkɨra gayo gʉʉsi, ubhwisirirya bhʉbhɨ sikʉ zʉʉsi nchi ingubha mʉmabhoko gaanyu, bhʉbhasakiryɨ kurimya imibhyɨ jo omorero gwa Shɨtaani. <verse eid="EPH 6:16"/><verse number="17" style="v" sid="EPH 6:17"/>Mʉsʉngʼaanɨ ʉbhʉsabhuri nchɨ ɨngʉhiira yanyu yi ichʉma, nɨ ɨngʼana ya Mungu nchɨ ɨpanga yɨnʉ mʉkʉhaabhwa ne Ekoro Ɨndɨndu.<verse eid="EPH 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 6:18"/>Mʉsabhɨ Mungu sikʉ zʉʉsi, kwa teemwa zʉʉsi za amasabhi. Mʉsabhɨ ibhaga ryʉsi kwa zinguru ze Ekoro ya Mungu. Mʉbhɨ mʉratengeeza ɨnʉ mʉrasabha igʉrʉ wa abharɨndu bhʉʉsi bha Mungu. <verse eid="EPH 6:18"/><verse number="19" style="v" sid="EPH 6:19"/>Inyʉʉsi mʉnsabhɨrɨ korereke hanʉ nɨkʉgamba, Mungu abhɨ arangʼa chʉ ʉkʉgamba, nɨtʉrɨ kʉbharwazɨra abhaatʉ kwa bhʉkararu amaheene ganʉ Mungu ɨrɨkɨɨnʼyɨ kʉNgʼana Ɨnzʉmu. <verse eid="EPH 6:19"/><verse number="20" style="v" sid="EPH 6:20"/>Inyɨ nɨhɨɨrwɨ emeremo ju ukurwaza Ɨngʼana Ɨnzʉmu yiyo, na yiyo neyo igiriryɨ nɨrɨ mokebhoho, mʉnsabhɨrɨ korereke nebhone ʉbhʉkararu nɨraganʼyɨ chɨmbu nikwenderwa kʉraganʼya.<verse eid="EPH 6:20"/></para>
  <para style="s">Ʉrʉbhangʉ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21"/>Tikikʉ umwisirirya ʉmʉsɨɨgwa no omohocha ʉmʉkɨndichɨtʉ omoronge wʉ Ʉmʉkʉrʉ, arabhaha amangʼana gaanɨ gʉʉsi, momenye kɨnʉ nekokora. <verse eid="EPH 6:21"/><verse number="22" style="v" sid="EPH 6:22"/>Nimutumirɨ kwa niimwɨ korereke momenye amangʼana gɨɨtʉ na kʉbhaha umwʉyʉ.<verse eid="EPH 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23"/>Omorembe, ʉbhʉsɨɨgi, hamwɨmwɨ nu ubhwisirirya bhɨbhɨ kubhiisirirya, kurwa kwa Mungu nʉ Ʉmʉkʉrʉ Yɨɨsu Kiriisitʉ. <verse eid="EPH 6:23"/><verse number="24" style="v" sid="EPH 6:24"/>Ɨbhɨgʉngi bhɨbhɨ hamwɨmwɨ na bhʉʉsi bhanʉ bhamʉsɨɨgirɨ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ, ʉbhʉsɨɨgi bhwa sikʉ zʉʉsi.<verse eid="EPH 6:24"/></para>
  <chapter eid="EPH 6"/>
</usx>
