<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TH" style="id">‑ Ikizu 1 Thessalonians</book>
  <para style="h">1 Abhatɨsarʉʉnikɨ</para>
  <para style="toc3">1 Abhatɨsarʉʉnikɨ</para>
  <para style="toc2">1 Abhatɨsarʉʉnikɨ</para>
  <para style="toc1">Ɨnyarʉbha ye embere ya Paaurʉ kwa Abhatɨsarʉʉnikɨ</para>
  <para style="mt2">Ɨnyarʉbha ye embere ya Paaurʉ kwa</para>
  <para style="mt1">Abhatɨsarʉʉnikɨ</para>
  <para style="imt">Ʉbhʉkangati</para>
  <para style="ip">Ɨnyarʉbha yɨnʉ yandikirwɨ nu umutumwa Paaurʉ hamwɨmwɨ na Sirwanʉ na Timoseo. Paaurʉ aarɨ ahikiirɨ mʉrʉbhɨri ʉrʉkʉrʉ rwi icharʉ cha Makɨdʉniya, ribhaga ryo orogendo rwazɨ rwa kabhɨrɨ rwu ukurwaza Ɨngʼana Ɨnzʉmu igʉrʉ wa Yɨɨsu (<char style="xt"><ref loc="ACT 17:1-10">Amahocha ga Abhatumwa 17:1‑10</ref></char>). Mʉrʉbhɨri muyo abhaatʉ bha teemwa zʉʉsi bhakiisirirya ɨngʼana yaazɨ. Hanʉ Paaurʉ iimiiriiryɨ risengerero Tɨsarʉʉnikɨ hayo, ɨnyaakʉ haari ɨkatanga kʉbhabhona abhiisirirya. Ɨnyaakʉ yiyo yaarɨ ɨrakorwa na Abhayaahudi. Paaurʉ akatɨnɨra kʉbhʉʉka rogendo rʉmwɨ.</para>
  <para style="ip">Hanʉ aaruurɨ iyo, akamara ibhaga isuuhu, akatʉma Timoseo, ajɨ Tɨsarʉʉnikɨ kʉbhaha umwʉyʉ abhiisirirya bhi iyo. Paaurʉ umwene atagiirɨyʉ, akangʼeha kurwaza zɨmbaara ɨzɨndɨ. Timoseo akagarʉka kwa Paaurʉ, akamuhirɨra amangʼana igʉrʉ wu ubhwisirirya nu ubhwikari bhwa abhiisirirya bha Tɨsarʉʉnikɨ. Hanʉ Paaurʉ iigwirɨ amangʼana gayo, akazomerwa bhʉkʉngʼu, akabhaandɨkɨra ɨnyarʉbha yʉ ʉkʉbhakumya ku ubhwisirirya nʉ ʉbhʉsɨɨgi bhwabhʉ. Akabhabhʉʉrɨra ɨkɨ kɨrabhoneka kʉBhakiriisitʉ hanʉ bhakukwa na ribhaga rɨnʉ Yɨɨsu akʉgarʉka kʉʉsɨ. Akabhaha umwʉyʉ korereke bhangʼehe kwikara ubhwikari bhʉnʉ bhokozomera Mungu.</para>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="s">Amakeerenʼya</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1"/>Ɨnyarʉbha yɨnʉ nandikirɨ inyɨ Paaurʉ, hamwɨmwɨ na Sirwanʉ<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fk" closed="false">Sirwanʉ </char><char style="ft" closed="false">arabhirikirwa </char><char style="fqa" closed="false">Siira </char><char style="ft" closed="false">mʉkɨtabhʉ cha Amahocha ga Abhatumwa.</char></note> na Timoseo. Tʉrabhaandɨkɨra imwɨ abhiisirirya bhʉ ʉrʉbhɨri rwa Tɨsarʉʉnikɨ, mwiribhita rya abhaatʉ bhanʉ mwisiriiryɨ Bhaabha Mungu nʉ Ʉmʉkʉrʉ Yɨɨsu Kiriisitʉ.</para>
  <para style="p" vid="1TH 1:1">Ɨbhɨgʉngi no omorembe bhɨbhɨ na niimwɨ.<verse eid="1TH 1:1"/></para>
  <para style="s">Ubhwisirirya bhwa Abhatɨsarʉʉnikɨ</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>Tʉramukumya Mungu ribhaga ryʉsi igʉrʉ waanyu bhʉʉsi, na tʉrabhasabhɨra tʉtakuniha. <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>Hanʉ tʉkʉbhasabhɨra kwa Bhaabha wɨɨtʉ Mungu, tʉragihiita mʉbhʉtangɨ bhwazɨ emeremo gɨnʉ mokokora kubhwisirirya. Tʉraguhiita umucha gwanyu gʉnʉ gukurwɨra kʉbhʉsɨɨgi bhwanyu, na chɨmbu mwimiiriirɨ kurwa ku ubhwisɨgi bhwanyu kʉMʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ.<verse eid="1TH 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4"/>Abhahiiri bhɨɨtʉ imwɨ, bhanʉ Mungu asɨɨgirɨ, twɨzɨ Mungu abharʉbhwɨrɨ kʉbha abhaatʉ bhaazɨ. <verse eid="1TH 1:4"/><verse number="5" style="v" sid="1TH 1:5"/>Tʉmɨnyirɨbhu kʉ kʉbha hanʉ twarwazirɨ kwa niimwɨ Ɨngʼana Ɨnzʉmu, tʉtaarwazirɨ kwa amangʼana ageenebhu. Nawe tʉkarwaza kwa amanaga na kwe Ekoro Ɨndɨndu,<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fk" closed="false">Ekoro Ɨndɨndu</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> na tono obhoheene kʉbha ɨngʼana yiyo nɨ‑ya amaheene. Imwɨ mwɨzɨ bhwaheene chɨmbu twarɨ hamwɨmwɨ na niimwɨ, korereke tʉbhasakiryɨ. <verse eid="1TH 1:5"/><verse number="6" style="v" sid="1TH 1:6"/>Nangabha mʉkanyaakibhwa bhʉkʉngʼu kʉ kʉbha yu ubhwisirirya bhwanyu, mʉkasʉngʼaana ɨngʼana yiyo kobhozomerwa bhʉnʉ bhukurwa kwe Ekoro Ɨndɨndu. Chɨmbu mwakʉrirɨbhu, mʉkɨɨga ekerenjo chɨtʉ ne ekerenjo chʉ Ʉmʉkʉrʉ Yɨɨsu. <verse eid="1TH 1:6"/><verse number="7" style="v" sid="1TH 1:7"/>Kwɨbhu, mʉbhɨɨrɨ ekerenjo kɨzʉmu kubhiisirirya bhʉʉsi bhanʉ bharɨ mucharʉ cha Makɨdʉniya na cha Akaaya. <verse eid="1TH 1:7"/><verse number="8" style="v" sid="1TH 1:8"/>Abhaatʉ bhiigwirɨ kurwa kwa niimwɨ ɨngʼana yʉ Ʉmʉkʉrʉ. Ɨtarɨ kʉbhaatʉ bha Makɨdʉniya na bha Akaaya abheene, nawe ubhwisirirya bhwanyu kwa Mungu, bhʉmɨnyɨkɨɨnɨ hʉʉsi. Kʉgayo tʉtakwinyaacha kʉgamba chʉchʉsi igʉrʉ wu ubhwisirirya bhwanyu. <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>Hanʉ hʉʉsi tukuja, abhaatʉ bharagamba bhwaheene igʉrʉ we eteemwa yanyu, chɨmbu mwatʉsʉngʼaanirɨ hanʉ twizirɨ kwa niimwɨ. Bharamenyeekererya chɨmbu mwatigirɨ amasambwa gaanyu na kwichʉrɨra Mungu, korereke momohokerye ewe ʉmʉhʉru na wa amaheene, <verse eid="1TH 1:9"/><verse number="10" style="v" sid="1TH 1:10"/>na kʉrɨnda Umwana waazɨ<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fk" closed="false">Umwana waazɨ</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">Umwana wa Mungu</char> muKiniibhasa.</note> Yɨɨsu kurwa mwisaarʉ. Ewe newe Mungu akamuryʉra, na newe akʉtʉsabhʉra mʉtɨnɨrʉ ya Mungu yɨnʉ ikuuza.<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="s">Emeremo ja Paaurʉ na abhakɨndichazɨ Tɨsarʉʉnikɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>Abhahiiri bhɨɨtʉ imwɨ, imubheene mwɨzɨ ukuuza kwɨtʉ kwa niimwɨ kʉtaarɨ kwa bhʉʉha. <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/>Kwikɨ mwɨzɨ hanʉ twarɨ tʉkɨɨrɨ kuhika kwa niimwɨ, tʉkanyaakibhwa na kutukwa mʉrʉbhɨri rwa Firipi. Nangabha kwarɨ nʉ ʉbhʉkʉngʼu kwa niimwɨ, nawe Mungu akatoha ʉbhʉnaja bhu ukwerekeererya Ɨngʼana yaazɨ Ɨnzʉmu. <verse eid="1TH 2:2"/><verse number="3" style="v" sid="1TH 2:3"/>Amangʼana ganʉ tʉkʉkandikija kwa niimwɨ gatarɨ ga rʉrɨmɨ, hamwɨ kwa ngʼeera, nʉʉrʉ kʉbhakangirirya.<verse eid="1TH 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 2:4"/>Nawe toreerekeererya kʉ kʉbha Mungu akatwisirirya, akatoha emeremo ju ukwerekeererya Ɨngʼana Ɨnzʉmu. Tʉtakwiseega kozomera abhaatʉ, nawe toreenda kozomera Mungu, wʉnʉ ahaarora gʉʉsi ganʉ garɨ mozekoro za abhaatʉ. <verse eid="1TH 2:4"/><verse number="5" style="v" sid="1TH 2:5"/>Mwɨzɨ twarɨ tʉtakʉgamba amangʼana korereke mʉtʉsɨɨgɨ, na Mungu, nɨ‑mʉmɨnyɨɨkɨrɨri kʉbha tʉtakʉgamba amangʼana ganʉ gatarɨ ga amaheene, korereke tobhone ubhwera. <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>Na twarɨ tʉtakomohya bhukumuka kʉbhaatʉ, kurwa kwa niimwɨ, nʉʉrʉ kurwa kʉbhandɨ bhʉbhʉʉsi.</para>
  <para style="p" vid="1TH 2:6">Twarɨ tʉratʉra kwenda ebhegero obhorebhe kurwa kwa niimwɨ, kʉ kʉbha itwɨ, nɨ‑bhatumwa<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="fk" closed="false">Abhatumwa</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> bha Kiriisitʉ, nawe tʉtakʉrirɨbhu. <verse eid="1TH 2:6"/><verse number="7" style="v" sid="1TH 2:7"/>Twarɨ bhanyʉʉhu kwa niimwɨ nchʉ ʉmʉkari akorera abhaana bhaazɨ. <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>Tʉkabhasɨɨga imwɨ bhʉkʉngʼu necho kiyo tʉkazomerwa, ɨtarɨ kʉbhabhʉʉrɨra Ɨngʼana Ɨnzʉmu kurwa kwa Mungu iyeene, nawe nu ukwihurucha kwɨtʉ kokora gʉʉsi ganʉ gakwenderwa kʉbhasakirya. Tʉkakorabhu kʉ kʉbha imwɨ mʉbhɨɨrɨ bhasɨɨgwa bhɨɨtʉ.<verse eid="1TH 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9"/>Abhahiiri bhɨɨtʉ, mʉrahiita umucha gwɨtʉ nʉ ʉkʉnyaaka kwɨtʉ, twarɨ tʉrakora emeremo ubhutikʉ nu umwise. Twarɨ tʉrakorabhu, korereke hanʉ tukurwaza Ɨngʼana Ɨnzʉmu kurwa kwa Mungu, tʉtaaza kʉnyaacha ʉmʉʉtʉ wʉwʉʉsi kwa niimwɨ. <verse eid="1TH 2:9"/><verse number="10" style="v" sid="1TH 2:10"/>Imwɨ nɨ‑bhamɨnyɨɨkɨrɨri bhɨɨtʉ, na Mungu wʉʉsi, nɨ‑mʉmɨnyɨɨkɨrɨri, eteemwa yɨɨtʉ kwa niimwɨ abhiisirirya, yaarɨ nzʉmu na ya amaheene, ɨtaatɨmirwɨ isoro. <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>Na mwɨzɨ hanʉ twarɨ kwa niimwɨ twarɨ tʉrabhakorera bhʉʉsi chɨmbu bhaabha akʉbhakorera abhaana bhaazɨ. Twarɨ tʉrabhaha umwʉyʉ na kubhiibhisirirya na kubhiisasaama, <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>korereke mwikarɨ chɨmbu Mungu asɨɨgirɨ. Mungu newe abhabhirikiirɨ korereke musikɨrɨ mʉbhʉtɨmi na mʉbhʉgʉngʉ bhwazɨ.<verse eid="1TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>Naatu tʉna ringʼana ɨrɨndɨ ryu ukukumya Mungu tʉtaana kiniha, kʉ kʉbha hanʉ mwitɨgɨɨrɨɨrɨ ɨngʼana yaazɨ kurwa kwa niitwɨ, mʉtaayɨsʉngʼaanirɨ ncha ringʼana rya abhaatʉ. Nawe mʉkayɨsʉngʼaana nchɨ ɨngʼana kurwa kwa Mungu, na amaheene nɨmbu ɨrɨ. Ɨngʼana yiyo ɨrakora emeremo mumyʉyʉ janyu, imwɨ bhanʉ mumwisiriiryɨ. <verse eid="1TH 2:13"/><verse number="14" style="v" sid="1TH 2:14"/>Abhahiiri bhɨɨtʉ, ganʉ gaabhabhwɨnɨ abhaatʉ bhanʉ bhakwisirirya Yɨɨsu Kiriisitʉ mʉmasengerero ga Mungu ganʉ gari mucharʉ cha Yudeya, nego na niimwɨ gaabhabhwɨnɨ. Abhaatʉ bhaanyu bhakabhanyaacha, chɨmbu Abhayaahudi abhakɨndichabhʉ bhaabhanyaakiryɨ. <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/>Abhayaahudi bhayo, nebho bhiitirɨ Ʉmʉkʉrʉ Yɨɨsu na abharʉʉtɨrɨri bhɨ ɨkarɨ. Na nebho bhaatʉnyaakiryɨ itwɨ. Abhaatʉ bhayo, bhariigatanʼya Mungu na bhatakwigwana na abhaatʉ bhʉʉsi, <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>kʉ kʉbha bharatorecha kurwaza Ɨngʼana Ɨnzʉmu kʉbhaatʉ bhanʉ bhatarɨ Abhayaahudi. Bharaanga abhaatʉ bhatasabhurwa. Nɨmbu bhakʉkaja kuhicha ʉbhʉbhɨ bhwabhʉ bhʉnʉ bhakokora ibhaga ryʉsi. Nawe ʉbhʉrʉrʉ bhwa Mungu bhʉbhahikiirɨ!<verse eid="1TH 2:16"/></para>
  <para style="s">Paaurʉ na abhakɨndichazɨ bhariigomba kuhunana na Abhatɨsarʉʉniki</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>Abhahiiri bhɨɨtʉ, ʉkʉtaana kwɨtʉ na niimwɨ kwarɨ kwibhaga isuuhubhu, nʉ ʉkʉtaana kuyo kwarɨ kwa mʉbhɨrɨ, kʉtarɨ kwe ekoro. Na kwa ribhaga riyo ryʉsi, twarɨ turiigomba tuhunanɨ. <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>Neho tokeenda tuuzɨ kwa niimwɨ, kɨnda inyɨ Paaurʉ naarɨ nereenda kuuza manga kaaru, nawe Shɨtaani<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="fk" closed="false">Shɨtaani</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> akatorecha. <verse eid="1TH 2:18"/><verse number="19" style="v" sid="1TH 2:19"/>Ʉmʉkʉrʉ Yɨɨsu hanʉ akuuza, nɨ‑bha wɨɨwɨ bhanʉ bharaabhɨ ɨtangɨ yu ubhwisɨgi bhwɨtʉ? Na nɨ‑bha wɨɨwɨ bhanʉ bharaabhɨ ʉbhʉtangɨ bhwo obhozomerwa nɨ ɨkɨrʉngʉ chɨtʉ chu ubhuhizi? Mʉtarɨ imwɨ? <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>Maheene, imwɨ niimwɨ bhanʉ mʉraagiryɨ twiheeme no okozomerwa.<verse eid="1TH 2:20"/></para>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="s">Paaurʉ aratʉma Timoseo Tɨsarʉʉnikɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>Ɨtɨnɨrʉ tʉkatamwa kwigumirirya, kʉ kʉbha tʉtaamɨnyirɨ ganʉ gakokorwa iyo. Neho tʉkarora, itwɨ tʉsaagɨ itubheene mʉrʉbhɨri rwa Asɨnɨ, <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>tʉtʉmɨ Timoseo umuhiiri wɨɨtʉ, korereke aazɨ abhanajɨ na kʉbhaha umwʉyʉ mubhwisirirya bhwanyu. Ewe, ne‑mohocha mʉkɨndichɨtʉ wa Mungu, ku kwerekeererya Ɨngʼana Ɨnzʉmu igʉrʉ wa Kiriisitʉ. <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>Tʉkakorabhu korereke ʉmʉʉtʉ wʉwʉʉsi mʉbhaniimwɨ atakwa umwʉyʉ kʉ kʉbha yɨ ɨnyaakʉ yɨnʉ. Imwɨ mwɨzɨ, toreenderwa kʉhɨtɨra ɨnyaakʉ. <verse eid="1TH 3:3"/><verse number="4" style="v" sid="1TH 3:4"/>Mwɨzɨ gayo, kʉ kʉbha hanʉ twarɨ na niimwɨ, twarɨ tʉrabhuurirwa kʉbha tʉranyaakibhwa. Nangʉ nɨmbu gaabhɨɨrɨ.<verse eid="1TH 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1TH 3:5"/>Kiyo necho kigiriryɨ nɨkatamwa kwigumirirya, nɨkatʉma Timoseo kwa niimwɨ, korereke nemenye amangʼana gu ubhwisirirya bhwanyu. Nɨkakorabhu kwa kwiseega kʉbha hamwɨ Shɨtaani abhagɨmirɨ na kʉbharimirya, ne emeremo jʉsi gɨnʉ twakʉrirɨ kwa niimwɨ gɨbhɨ ja bhʉʉha.<verse eid="1TH 3:5"/></para>
  <para style="s">Amangʼana amazʉmu kurwa kʉBhatɨsarʉʉnikɨ</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6"/>Nangʉ Timoseo agarukirɨ kurwa kwa niimwɨ, atubhuuriirɨ amangʼana amazʉmu igʉrʉ wu ubhwisirirya nʉ ʉbhʉsɨɨgi bhwanyu. Atubhuuriirɨ mʉratuhiita bhwaheene kɨrakabhu, na mʉbhɨɨrɨ na amɨɨga gu ukurumana na niitwɨ, chɨmbu itwʉsi tʉbhɨɨrɨ nɨ ɨnamba kurumana na niimwɨ.<verse eid="1TH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 3:7"/>Abhahiiri bhɨɨtʉ, ɨngʼana igʉrʉ wu ubhwisirirya bhwanyu, ɨtʉkʉngʉʉrirɨ imyʉyʉ mʉnyaakʉ yɨɨtʉ yʉʉsi. <verse eid="1TH 3:7"/><verse number="8" style="v" sid="1TH 3:8"/>Nangʉ tʉrahezera, kʉ kʉbha imwɨ mwimiiriirɨ bhwɨma kʉMʉkʉrʉ Yɨɨsu. <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>Nangʉ tʉrarɨhakɨ Mungu igʉrʉ wu ubhwisirirya bhwanyu? Tʉratʉra kumukumyabhwɨ kobhozomerwa ʉbhʉkʉrʉ bhʉnʉ tʉnabhwɨ mʉbhʉtangɨ bhwazɨ igʉrʉ waanyu? <verse eid="1TH 3:9"/><verse number="10" style="v" sid="1TH 3:10"/>Tʉrasabha Mungu kumucha ubhutikʉ nu umwise, atʉsakiryɨ tujɨ kwikɨ kwa niimwɨ, korereke tʉbhasakiryɨ kɨnʉ musuuhiirwɨ kubhwisirirya bhwanyu.<verse eid="1TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>Tʉrasabha Bhaabha wɨɨtʉ Mungu umwene, nʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu, atokorere ɨnzɨra yu ukuuza kwa niimwɨ. <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>Ʉmʉkʉrʉ abhoongere ʉbhʉsɨɨgi bhwʉ ʉkʉsɨɨgana imubheene kobheene na kʉbhasɨɨga abhandɨ bhʉʉsi, chɨmbu itwɨ tʉbhasɨɨgirɨ imwɨ. <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>Na abhanajɨ imyʉyʉ janyu, korereke mʉbhɨ abhaatʉ abharɨndu, mʉtaana isoro mʉbhʉtangɨ bhwa Bhaabha Mungu, ribhaga rɨnʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu araazɨ hamwɨmwɨ na abharɨndu bhaazɨ bhʉʉsi.<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="fk" closed="false">Abharɨndu bhaazɨ bhʉʉsi</char><char style="ft" closed="false">, ʉbhʉgaruri ʉbhʉndɨ bhʉratʉra kʉbha, </char><char style="fqa" closed="false">bhamaraika bhaazɨ bhʉʉsi. </char><char style="ft" closed="false">Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">abharɨndu</char> muKiniibhasa.</note><verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="s">Eteemwa yɨnʉ Mungu asɨɨgirɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>Nangʉ abhahiiri bhɨɨtʉ, mwigirɨ kurwa kwa niitwɨ chɨmbu ikwenderwa kwikara, korereke komozomerya Mungu. Maheene nɨmbu mukwikara. Nangʉ, tʉrabhasabha na kubhiisasaama kʉbhʉnaja bhwʉ Ʉmʉkʉrʉ Yɨɨsu, mʉkajɨ kokorabhu na kʉkɨraho. <verse eid="1TH 4:1"/><verse number="2" style="v" sid="1TH 4:2"/>Mwɨzɨ bhwaheene ganʉ twabhaswajiryɨ kʉbhʉnaja bhwʉ Ʉmʉkʉrʉ Yɨɨsu.<verse eid="1TH 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3"/>Mungu areenda mʉbhɨ abhaatʉ abharɨndu, mutiisikirya kokora ɨtaarʉ. <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>Imubhʉʉsi muhizɨ ɨmɨbhɨrɨ janyu, mʉbhʉrɨndu na kwisʉʉka. <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>Mʉtabha nɨ ɨnamba mbɨ ncha abhaatʉ bhanʉ bhatɨɨzɨ Mungu. <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>Mʉgayo, ʉmʉʉtʉ wʉwʉʉsi atasariirya ʉmʉkɨndichazɨ, nʉʉrʉ kʉmʉkangirirya. Tʉmarirɨ kʉbhabhʉʉrɨra na kʉbharecha, bhʉʉsi bhanʉ bhakokora gayo, Ʉmʉkʉrʉ newe akʉrɨhanʼya isiirɨ ya gayo gʉʉsi. <verse eid="1TH 4:6"/><verse number="7" style="v" sid="1TH 4:7"/>Mungu ataatubhirikiirɨ kokora ɨtaarʉ, nawe akatʉbhɨrɨkɨra twikarɨ mʉbhʉrɨndu. <verse eid="1TH 4:7"/><verse number="8" style="v" sid="1TH 4:8"/>Mmbe, ʉmʉʉtʉ wʉwʉʉsi wʉnʉ akwanga amiija gayo, atakumwanga ʉmʉʉtʉ, nawe araanga Mungu, wʉnʉ akʉbhaha imwɨ Ekoro yaazɨ Ɨndɨndu.<verse eid="1TH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>Nangʉ, ɨtakwenderwa tʉbhaandɨkɨrɨ imwɨ igʉrʉ wʉ ʉkʉsɨɨgana, kʉ kʉbha imwɨ imubheene mwijibhwɨ na Mungu kʉsɨɨgana. <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>Maheene, mʉbhɨɨrɨ mʉrabhakorerabhu abhakɨndichanyu bhʉʉsi bhanʉ bhari mucharʉ cha Makɨdʉniya. Nangʉ tʉrabhasabha, abhahiiri bhɨɨtʉ, mʉkajɨ kʉsɨɨganabhu na kʉkɨraho.<verse eid="1TH 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 4:11"/>Mʉbhɨ nu umwʉyʉ gu ukwikara ubhwikari bhwo omorembe. Ʉmʉʉtʉ wʉwʉʉsi atiisikirya mʉmangʼana ga abhandɨ, nawe akore emeremo jazɨ umwene, chɨmbu twabhaswajiryɨ. <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>Hayo mʉrabha mwɨrɨkɨɨnʼyɨ eteemwa ɨnzʉmu kʉbhaatʉ bhanʉ bhatarɨ Abhakiriisitʉ. Naatu mʉtakʉbha abhaatʉ bhu ukwisega bhya abhandɨ.<verse eid="1TH 4:12"/></para>
  <para style="s">Ukuryʉka kwa abhaku urusikʉ rwʉ Ʉmʉkʉrʉ Yɨɨsu</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>Nawe abhahiiri bhɨɨtʉ, toreenda momenye amangʼana ga bhanʉ bhakuurɨ, korereke mutigɨ kurumɨka ncha abhaatʉ abhandɨ bhanʉ bhataana ubhwisɨgi bhwu ukuryʉka. <verse eid="1TH 4:13"/><verse number="14" style="v" sid="1TH 4:14"/>Itwɨ, tʉmɨnyirɨ Yɨɨsu akakwa nu ukuryʉka. Kuriyo, turiisega Mungu arabharyʉra na kʉbhareeta hamwɨmwɨ na Yɨɨsu bhʉʉsi bhanʉ bhaakuurɨ bhamwisiriiryɨ.<verse eid="1TH 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15"/>Mmbe, ganʉ tʉkʉbhabhʉʉrɨra ni‑miija gʉ Ʉmʉkʉrʉ Yɨɨsu, kʉbha itwɨ bhanʉ tʉkʉbha bhahʉru hanʉ ewe akʉgarʉka, tʉtakʉbhakangatɨra abhaku kuhunana neewe. <verse eid="1TH 4:15"/><verse number="16" style="v" sid="1TH 4:16"/>Ʉmʉkʉrʉ umwene ariika kurwa mwisaarʉ. Aragamba kwiraka ikʉrʉ, maraika ʉmʉkʉrʉ wʉʉsi arabhɨrɨkɨra kwiraka na rihembe rya Mungu rɨrabhɨrɨkɨra. Neho bhanʉ bhaakuurɨ bhiisiriiryɨ Kiriisitʉ, bharakangata kuryukuribhwa. <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>Akʉmara itwɨ abhahʉru, bhanʉ tʉsaagirɨ, tʉrasakurwa hamwɨmwɨ nabhʉ mʉmasaarʉ, korereke tʉmʉsʉngʼaanɨ Ʉmʉkʉrʉ mwisaarʉ. Neho tukwikara hamwɨmwɨ nawe kemerano. <verse eid="1TH 4:17"/><verse number="18" style="v" sid="1TH 4:18"/>Nangʉ mwihaanɨ umwʉyʉ kʉmangʼana gayo.<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="s">Twikonze urusikʉ rwʉ Ʉmʉkʉrʉ Yɨɨsu</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>Abhahiiri bhɨɨtʉ, ɨtakwenderwa tʉbhaandɨkɨrɨ igʉrʉ wa ribhaga na amabhaga gu ukuuza Ʉmʉkʉrʉ Yɨɨsu. <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/>Imwɨ mwɨzɨ urusikʉ ryu ukuuza kʉ Ʉmʉkʉrʉ, rʉrabha rwa kuhwarukija nchu umwibhi chɨmbu ahaaza ubhutikʉ. <verse eid="1TH 5:2"/><verse number="3" style="v" sid="1TH 5:3"/>Hanʉ abhaatʉ bhakubhuga, “Tono omorembe, na tʉrɨ bhwaheene,” hayo neho ʉbhʉsarya bhukubhiizɨra. Ʉbhʉsarya bhuyo bhʉrabhahwarukija nchʉ ʉbhʉsʉngʉ bhu ukwibhʉra, chɨmbu bhʉhaazaku ʉmʉkari wʉnʉ akwenda kwibhʉra. Mʉgayo bhatakʉsabhurwa nʉʉrʉ hasuuhu.<verse eid="1TH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4"/>Nawe imwɨ, abhahiiri bhɨɨtʉ, urusikʉ ruyo rʉtakʉbhahwarukija nchu umwibhi, kʉ kʉbha imwɨ mʉtarɨ mukiirimya ncha abhandɨ. <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>Imwɨ bhʉʉsi, nɨ‑bhaana bhu ubhwɨrʉ, na bhu umwise. Itwʉsi tʉtarɨ abhaatʉ bhu ubhutikʉ hamwɨ bha mukiirimya. <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>Nangʉ, tutigɨ kʉbha ncha abhandɨ bhanʉ bhakuhindɨra zendooro, toreenderwa totengeeze na kʉbha ne ekerengo. <verse eid="1TH 5:6"/><verse number="7" style="v" sid="1TH 5:7"/>Abhaatʉ bhanʉ bhakuhindɨra zendooro, bhahaahindɨra ubhutikʉ. Na abhanywi bha amarwa bhahaanywa ubhutikʉ.<verse eid="1TH 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1TH 5:8"/>Nawe kʉ kʉbha itwɨ, nɨ‑bhaatʉ bhu ubhwɨrʉ, tʉbhɨ ne ekerengo. Tʉbhɨ nu ubhwisirirya nʉ ʉbhʉsɨɨgi, ebhyo bhɨrabha nchi ingubha kukikubha. Kwikɨ twisege Mungu kʉtʉsabhʉra, neho tʉkʉbha kina twibhʉhirɨ ɨngʉhiira yi ichʉma kumutwɨ. <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>Mungu atatʉrʉbhwɨrɨ korereke aturichɨ kubhwigatani bhwazɨ, nawe akatorobhora korereke tobhone ubhutuuribhwa kʉnzɨra yʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ. <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>Wuyo newe akuurɨ igʉrʉ wɨɨtʉ, korereke twikarɨ hamwɨmwɨ nawe, tʉbhɨ tukuurɨ hamwɨ turiigwa. <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>Nangʉ, mwihaanɨ umwʉyʉ na kwikongʼya imyʉyʉ chɨmbu mʉraakore.<verse eid="1TH 5:11"/></para>
  <para style="s">Eteemwa yɨnʉ ikwenderwa kubhiisirirya</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>Nangʉ abhahiiri bhɨɨtʉ, tʉrabhasabha mʉbhasʉʉkɨ bhanʉ bhakohocha emeremo ja Mungu gatɨ waanyu, na kʉbhakangata kʉ ʉbhʉnaja bhwʉ Ʉmʉkʉrʉ Yɨɨsu na kubhiisasaama. <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>Mʉbhasʉʉkɨ bhʉkʉngʼu na kʉbhasɨɨga kʉrɨngʼaana ne emeremo jabhʉ. Na imubheene kobheene mʉbhɨ muriikara komorembe.<verse eid="1TH 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14"/>Abhahiiri bhɨɨtʉ, tʉrabhiisasaama, mʉbhɨ mʉrabhahama abhatʉbhu na kʉbhakongʼya bhanʉ bhakuurɨ imyʉyʉ. Na mʉbhahɨ abhanyʉʉhɨrɨru amanaga nu ukwigumirirya abhaatʉ bhʉʉsi. <verse eid="1TH 5:14"/><verse number="15" style="v" sid="1TH 5:15"/>Morore, ʉmʉʉtʉ wʉwʉʉsi atagarukirya ʉmʉkɨndichazɨ ʉbhʉbhɨ kʉbhʉbhɨ. Nawe ibhaga ryʉsi mʉbhɨ muriikorera amazʉmu imubheene na kʉbhakorera abhaatʉ bhʉʉsi. <verse eid="1TH 5:15"/><verse number="16" style="v" sid="1TH 5:16"/>Mʉbhɨ no obhozomerwa ibhaga ryʉsi, <verse eid="1TH 5:16"/><verse number="17" style="v" sid="1TH 5:17"/>na mʉtaniha kʉsabha. <verse eid="1TH 5:17"/><verse number="18" style="v" sid="1TH 5:18"/>Mʉbhɨ mʉrakumya Mungu kwa gʉʉsi, kʉ kʉbha gayo nego ewe akwenda mʉbhɨ mʉrakora chɨmbu Yɨɨsu Kiriisitʉ atwɨrɨkiryɨ.<verse eid="1TH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19"/>Mʉtaanga Ekoro Ɨndɨndu. <verse eid="1TH 5:19"/><verse number="20" style="v" sid="1TH 5:20"/>Na mʉtasiihya ʉbhʉrʉʉti, <verse eid="1TH 5:20"/><verse number="21" style="v" sid="1TH 5:21"/>nawe mʉgageme amangʼana gʉ ʉbhʉrʉʉti na kugwata amazʉmu. <verse eid="1TH 5:21"/><verse number="22" style="v" sid="1TH 5:22"/>Mwirigɨ kʉmabhɨ gʉʉsi.<verse eid="1TH 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>Mungu umwene wʉnʉ akotoha omorembe, abhabhɨngukyɨ imwɨ kwa gʉʉsi. Ewe ariibhɨ imyʉyʉ janyu, ʉbhʉhʉru bhwanyu, nɨ ɨmɨbhɨrɨ janyu, korereke mʉbhɨ mʉtaana kuririirirwa kuhikɨra hanʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ akuuza. <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>Mungu umwene wʉnʉ akʉbhabhɨrɨkɨra, arabhakorera gayo, kʉ kʉbha ewe ne‑moronge.<verse eid="1TH 5:24"/></para>
  <para style="s">Amangʼana gʉ ʉkʉraga</para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>Abhahiiri bhɨɨtʉ, itwʉsi mʉtʉsabhɨrɨ kwa Mungu. <verse eid="1TH 5:25"/><verse number="26" style="v" sid="1TH 5:26"/>Mʉbhakeerye abhiisirirya bhʉʉsi kʉbhʉsɨɨgi bhwa Kiriisitʉ. <verse eid="1TH 5:26"/><verse number="27" style="v" sid="1TH 5:27"/>Nɨrabhiirahirya kʉbhʉnaja bhwʉ Ʉmʉkʉrʉ Yɨɨsu kʉbha, abhiisirirya bhʉʉsi bhasomerwe ɨnyarʉbha yɨnʉ.<verse eid="1TH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>Ɨbhɨgʉngi bhyʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ, bhɨbhɨ hamwɨmwɨ na niimwɨ bhʉʉsi.<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
