<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id">‑ Ikizu 2 Timothy</book>
  <para style="h">2 Timoseo</para>
  <para style="toc3">2 Timoseo</para>
  <para style="toc2">2 Timoseo</para>
  <para style="toc1">Ɨnyarʉbha ya kabhɨrɨ ya Paaurʉ kwa Timoseo</para>
  <para style="mt2">Ɨnyarʉbha ya kabhɨrɨ ya Paaurʉ kwa</para>
  <para style="mt1">Timoseo</para>
  <para style="imt">Ʉbhʉkangati</para>
  <para style="ip">Ɨnyarʉbha yɨnʉ yandikirwɨ na Paaurʉ. Akamwandɨkɨra Timoseo, ʉmʉsakirya waazɨ wa haguhɨ. Hanʉ Paaurʉ aandikirɨ ɨnyarʉbha yɨnʉ aarɨ mokebhoho Ruumi na akamenya ariitwa ibhaga iguhɨ. Akeenda Timoseo ajɨ ɨwaazɨ naatu komorora.</para>
  <para style="ip">Kɨnʉ kigiriryɨ kwandɨka ɨnyarʉbha yɨnʉ, nɨ‑kʉnaja Timoseo, korereke abhɨ isiriiryɨ kʉraganʼya Ɨngʼana Ɨnzʉmu igʉrʉ wa Yɨɨsu, akajɨ kwigumirirya amakʉngʼu gʉʉsi. Kwikɨ, akabhʉʉrɨra Timoseo aangɨ kwa amanaga gʉʉsi amiija gʉ ʉrʉrɨmɨ, iijɨ ga amaheene. Ɨtɨnɨrʉ, Paaurʉ aarɨ ariigomba bhʉkʉngʼu korora Timoseo.</para>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="s">Amakeerenʼya</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1"/>Ɨnyarʉbha yɨnʉ nandikirɨ inyɨ Paaurʉ, umutumwa<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fk" closed="false">Umutumwa</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">abhatumwa</char> muKiniibhasa.</note> wa Yɨɨsu Kiriisitʉ kʉbhʉsɨɨgi bhwa Mungu. Nɨrʉbhwɨrwɨ kʉraganʼya ʉbhʉragɨ bhwʉ ʉbhʉhʉru. Ʉbhʉhʉru bhuyo bhʉrabhoneka ku ukwisirirya Yɨɨsu Kiriisitʉ. <verse eid="2TI 1:1"/><verse number="2" style="v" sid="2TI 1:2"/>Nɨrakwandɨkɨra mwana waanɨ Timoseo ʉmʉsɨɨgwa.</para>
  <para style="p" vid="2TI 1:2">Ɨbhɨgʉngi no omorembe kurwa kwa Bhaabha Mungu, na kwa Yɨɨsu Kiriisitʉ Ʉmʉkʉrʉ wɨɨtʉ, bhɨbhɨ na naawɨ.<verse eid="2TI 1:2"/></para>
  <para style="s">Paaurʉ arakumya Mungu na kʉnaja Timoseo</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>Nɨrakumya Mungu wʉnʉ nekohokerya kwa koro nzɨrʉ, chɨmbu bhaakʉrirɨ bhasʉʉkʉrʉ bhaanɨ. Ribhaga ryʉsi nɨrakuhiita mʉmasabhi gaanɨ ubhutikʉ nu umwise. <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>Nɨrahiita zingusuri zaazʉ hanʉ twaragɨɨnɨ. Niriigomba bhʉkʉngʼu kuhunana na naawɨ naatu, korereke nɨbhɨ no obhozomerwa bhʉkʉrʉ. <verse eid="2TI 1:4"/><verse number="5" style="v" sid="2TI 1:5"/>Naatu nɨrahiita ubhwisirirya bhwazʉ bhwa amaheene. Ubhwisirirya bhuyo, aarɨ nabhwɨ nyakʉkʉrʉ Rʉisi na yiiya waazʉ Ɨunikɨ. Nɨna amaheene kʉbha awʉʉsi ʉnabhwɨ. <verse eid="2TI 1:5"/><verse number="6" style="v" sid="2TI 1:6"/>Necho nɨrakuhiitya, okore umucha kokorera ʉbhʉnaja bhʉnʉ Mungu akʉhɨɨrɨ hanʉ nakʉtɨɨrɨɨrɨ amabhoko. <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>Korabhu, kʉ kʉbha ekoro yɨnʉ Mungu aatʉhɨɨrɨ ɨtarɨ yʉ ʉkʉtʉtʉʉra tʉbhɨ bhʉʉbha, nawe yo okotoha amanaga, ʉbhʉsɨɨgi nu umwʉyʉ gwe ekerengo.<verse eid="2TI 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8"/>Mmbe, ʉtarora zɨsʉni komenyeekererya amangʼana igʉrʉ wʉ Ʉmʉkʉrʉ wɨɨtʉ, hamwɨ korora zɨsʉni kʉ kʉbha nɨrɨ mokebhoho igʉrʉ waazɨ. Nawe wiigumiriryɨ mʉnyaakʉ hamwɨmwɨ na niinyɨ, igʉrʉ wɨ Ɨngʼana Ɨnzʉmu chɨmbu wahɨɨrwɨ amanaga na Mungu. <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>Ewe akatʉsabhʉra, akatorobhora tʉbhɨ abhaatʉ bhaazɨ. Atakʉrirɨbhu kʉ kʉbha ya amahocha gɨɨtʉ amazʉmu, nawe akakora kʉ kʉbha yʉ ʉbhʉsɨɨgi bhwazɨ nɨ ɨbhɨgʉngi bhyazɨ. Akatororera ɨbhɨgʉngi bhiyo igʉrʉ wa Yɨɨsu Kiriisitʉ, kwɨma ɨɨsɨ ɨkɨɨrɨ kubhumbwa. <verse eid="2TI 1:9"/><verse number="10" style="v" sid="2TI 1:10"/>Nawe nangʉ, Mungu ɨrɨkɨɨnʼyɨ amazʉmu gaazɨ kwa niitwɨ, ku kuuza kwa Yɨɨsu Kiriisitʉ Ʉmʉsabhuri wɨɨtʉ. Ewe ahizirɨ amanaga gu uruku, ɨrɨkɨɨnʼyɨ ʉbhʉhʉru bhwa kemerano kʉnzɨra yɨ Ɨngʼana Ɨnzʉmu.<verse eid="2TI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11"/>Igʉrʉ wɨ Ɨngʼana Ɨnzʉmu yiyo, nɨrʉbhwɨrwɨ kʉbha umurwazi, umutumwa, naatu umwija. <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>Inyɨ nɨranyaaka igʉrʉ wa riyo. Nawe nɨtakorora sʉni, kʉ kʉbha nimwɨzɨ wʉnʉ niisiriiryɨ. Na nɨɨzɨ ɨngʼana ye eheene yɨnʉ angʼɨɨrɨ, arayangarɨra bhwaheene kuhika urusikʉ rwʉ ʉkʉgarʉka kwawe.<verse eid="2TI 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13"/>Ugwatɨ bhwaheene amiija ga amaheene ganʉ nakwijiryɨ. Wiijɨ gayo na ʉsaagɨ nu ubhwisirirya nʉ ʉbhʉsɨɨgi bhɨnʉ bhekobhoneka kwa Yɨɨsu Kiriisitʉ. <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>Ɨngʼana ye eheene yɨnʉ wahɨɨrwɨ, ʉgaangarɨrɨ kwa amanaga ge Ekoro Ɨndɨndu yɨnʉ ɨrɨ mʉmɨbhɨrɨ jɨtʉ.<verse eid="2TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15"/>Awɨ ʉmɨnyirɨ abhaatʉ bhʉʉsi bhi icharʉ cha Asiya bhaantigirɨ. Gatɨ waabhʉ bharimu Figero na Hɨrimogene. <verse eid="2TI 1:15"/><verse number="16" style="v" sid="2TI 1:16"/>Nɨrasabha Ʉmʉkʉrʉ abharorere ɨbhɨgʉngi abhaatʉ bha Ʉnɨsifʉrʉ, kʉ kʉbha aarɨ arasambarucha umwʉyʉ gwanɨ manga kaaru, na atarʉʉzɨ sʉni kuuza kondora hanʉ naarɨ mokebhoho. <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>Na hanʉ iizirɨ mʉrʉbhɨri rwa Ruumi rʉnʉ, akangʼeha komohya kuhika akambona. <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>Na naawɨ ʉmɨnyirɨ bhwaheene, amaaru ganʉ ankʉrɨɨrɨ mʉrʉbhɨri rwa Efeeso iyo. Ʉmʉkʉrʉ Yɨɨsu amohe ɨbhɨgʉngi urusikʉ rwɨ ɨtɨnɨrʉ.<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="s">Kʉbha nu ubhwigumirirya momeremo ja Mungu</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>Nangʉ mwana waanɨ, ʉbhɨ na amanaga kʉnzɨra yɨ ɨbhɨgʉngi bhɨnʉ tubhwɨnɨ ku kwisirirya Yɨɨsu Kiriisitʉ. <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>Wiigwirɨ amiija ganʉ nakwijiryɨ mʉbhʉtangɨ bhwa abhamɨnyɨɨkɨrɨri bhaaru. Nangʉ ʉbhahɨ amiija gayo abhaatʉ abharonge, bhanʉ bhakʉtʉra kwija abhandɨ.<verse eid="2TI 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3"/>Wiigumiriryɨ mʉnyaakʉ hamwɨmwɨ na niinyɨ, nchu umusirikarɨ ʉmʉzʉmu wa Yɨɨsu Kiriisitʉ. <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>Atareeho musirikarɨ wʉnʉ akutiga kokora emeremo ji ikisirikarɨ, asikɨrɨ momeremo gɨnʉ gɨtarɨ ji ikisirikarɨ. Atakwisikirya mugiyo, kʉ kʉbha areenda komozomerya ʉmʉkʉrʉ waazɨ. <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>Nʉʉrʉ wʉnʉ akuhiza mwibharaana, atakʉtʉra kʉhaabhwa ʉmʉbhanʉ arɨɨtamɨ kwangarɨra imigirʉ ja ribharaana. <verse eid="2TI 2:5"/><verse number="6" style="v" sid="2TI 2:6"/>Umurimi wʉnʉ akohocha kumucha, wuyo areenderwa kʉbha we embere kobhona amagesa. <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>Timoseo, wiseege bhʉkʉngʼu igʉrʉ wa amangʼana ganʉ nɨkʉkʉbhʉʉrɨra. Ʉmʉkʉrʉ Mungu arakoha ʉbhʉnaja bhwu ukwobhoora gʉʉsi.<verse eid="2TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8"/>Uhiitɨ Yɨɨsu Kiriisitʉ wi ikishoko chʉ ʉmʉtɨmi Daudi,<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="fk" closed="false">Daudi</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa. </char><char style="xt" closed="false">Rora <ref loc="2SA 7:12-13">2 Samwɨri 7:12‑13</ref>.</char></note> Mungu akamuryʉra kurwa mʉbhaku. Yiyo neyo Ɨngʼana Ɨnzʉmu yɨnʉ nikurwaza. <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>Kʉ kʉbha yɨ ɨngʼana yiyo, inyɨ nɨranyaaka na kobhohwa ne emenyororo nchʉ ʉmʉbhɨ. Nawe ɨngʼana ya Mungu ɨtakʉtʉra kobhohwa. <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>Igʉrʉ wa riyo, niriigumirirya gʉʉsi igʉrʉ wa abhaatʉ bhanʉ bharʉbhwɨrwɨ na Mungu kʉbha kwawe, korereke bhʉʉsi bhasʉngʼaanɨ ubhutuurya kʉhɨtɨra Yɨɨsu Kiriisitʉ, na kugwatana nʉ ʉbhʉgʉngʉ bhwa kemerano.<verse eid="2TI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11"/>Ringʼana rɨnʉ ni‑rya amaheene:</para>
  <para style="q" vid="2TI 2:11">“Arɨɨbhɨ tukuurɨ hamwɨmwɨ na Kiriisitʉ,</para>
  <para style="q" vid="2TI 2:11">turiikara hamwɨmwɨ nawe.<verse eid="2TI 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="2TI 2:12"/>Arɨɨbhɨ turiigumirirya,</para>
  <para style="q" vid="2TI 2:12">tʉrakangata hamwɨmwɨ nawe.</para>
  <para style="q" vid="2TI 2:12">Arɨɨbhɨ tʉramwanga ewe,</para>
  <para style="q" vid="2TI 2:12">wʉʉsi aratwanga.<verse eid="2TI 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="2TI 2:13"/>Arɨɨbhɨ itwɨ tʉtarɨ bharonge kwewe,</para>
  <para style="q" vid="2TI 2:13">ewe arasaaga moronge,</para>
  <para style="q" vid="2TI 2:13">kʉ kʉbha ewe nɨ‑wa amaheene.”<verse eid="2TI 2:13"/></para>
  <para style="s">Amaswaja komohocha ʉmʉzʉmu wa Mungu</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>Ʉbhahiityɨ abhiisirirya amangʼana gayo, na kʉbharecha mʉbhʉtangɨ bhwa Mungu, bhatigɨ kʉhakaana igʉrʉ wa amangʼana amasuuhusuuhu. Zɨhaka ziyo zɨtaana bhwera, na zɨrabhasarya bhanʉ bhakwigwa. <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>Ikongʼeererya kwija ringʼana rya amaheene, chɨmbu ikwenderwa kwa Mungu. Hayo ʉrabha omohocha wʉnʉ ataana sʉni igʉrʉ we emeremo jazɨ. Kokorabhu nekwe Mungu akwisirirya.<verse eid="2TI 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 2:16"/>Utigɨ amangʼana ganʉ gataana bhwera bhwʉbhwʉsi, kʉ kʉbha gayo garatʉʉra abhaatʉ kore bhʉkʉngʼu na Mungu. <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>Amiija gaabhʉ gaangɨ rigaati rɨnʉ rɨkʉtamanyʉra ʉmʉbhɨrɨ. Gatɨ waabhʉ bharimu Himɨnayo na Fireto. <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>Bhayo bhabhurirɨ bhʉkʉngʼu, bhatigirɨ amaheene kʉ ʉkʉgamba kʉbha, ubhuryuku bhwa abhaku bhʉmarirɨ kʉhʉrʉka. Ku kwijabhu, bhararimirya ubhwisirirya bhwa abhaatʉ abhandɨ. <verse eid="2TI 2:18"/><verse number="19" style="v" sid="2TI 2:19"/>Nawe abhaatʉ bhanʉ bhiimiiriirɨ bhwɨma, bhaangɨ ʉbhʉrʉsa ʉbhʉnagu bhʉnʉ bhʉtɨɨrwɨ na Mungu. Ni igʉrʉ wʉ ʉbhʉrʉsa bhuyo gaandikirwɨ amangʼana ganʉ, “Ʉmʉkʉrʉ Mungu amɨnyirɨ abhaatʉ bhaazɨ,”<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="xt" closed="false">Rora <ref loc="NUM 16:5">Ʉkʉbhara 16:5</ref>.</char></note> nʉ, “Ʉmʉʉtʉ wʉwʉʉsi wʉnʉ akwibhɨrɨkɨra ewe nɨ‑wʉ Ʉmʉkʉrʉ Mungu, atigɨ ʉbhʉbhɨ.”<verse eid="2TI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20"/>Munyumba ɨkʉrʉ, bhirimu ebhegero bhyaru, bhirimu bhyɨ ɨzahaabhu na zimpirya, bhyo obhototo na bhyɨ ɨmɨtɨ. Ɨbhɨndɨ bhyu ubhwera, ɨbhɨndɨ bhɨtarɨ bhyu ubhwera. <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>Nangʉ, ʉmʉʉtʉ ariibhɨngukyɨ ku kutiga ʉbhʉbhɨ bhuyo bhwʉsi, arabha nche ekegero cha amahocha ga hagarɨ kɨnʉ kɨrʉbhwɨrwɨ, arabha isiririibhwɨ kʉMʉkʉrʉ waazɨ, arabha isiriiryɨ komeremo jʉsi ɨmɨzʉmu.<verse eid="2TI 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22"/>Utigɨ umwʉyʉ gu ubhumura, ʉbhɨ ne eheene, ubhwisirirya, ʉbhʉsɨɨgi no omorembe, hamwɨmwɨ na bhʉʉsi bhanʉ bhakʉsabha Ʉmʉkʉrʉ kumwʉyʉ umwɨrʉ. <verse eid="2TI 2:22"/><verse number="23" style="v" sid="2TI 2:23"/>Utigɨ kutuna zɨhaka ze ekegeege zɨnʉ zɨtaana bhwera, kʉ kʉbha ʉmɨnyirɨ ziyo zɨrareeta iryʉmana. <verse eid="2TI 2:23"/><verse number="24" style="v" sid="2TI 2:24"/>Naatu, ɨtakwenderwa omohocha wʉ Ʉmʉkʉrʉ kʉbha mwʉmani. Nawe abhɨ mwigumirirya, mʉnyʉʉhu kʉbhaatʉ bhʉʉsi, nʉ ʉmʉʉtʉ wʉnʉ akʉnaja kwija. <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>Areenderwa abhɨ arabhahama kwa bhʉnyʉʉhu abhaatʉ bhanʉ bhakʉhakaana nawe, korereke hamwɨ Mungu abhahɨ kutiga ʉbhʉbhɨ na komenya amaheene. <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>Neho, amangʼɨɨni gaabhʉ gabhagarʉkɨrɨ, bhasabhʉkɨ kurwa mwiheto rya Shɨtaani. Ewe abhagwatirɨ, korereke bhabhɨ bharakora ubhwɨndi bhwazɨ.<verse eid="2TI 2:26"/></para>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="s">Ʉbhʉbhɨ kuzisikʉ zɨ ɨtɨnɨrʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>Nawe omenye, zisikʉ zɨ ɨtɨnɨrʉ kʉrabha na ribhaga ikʉngʼu. <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>Ribhaga riyo, abhaatʉ bharabha bhariisɨɨga abheene, bharabha bhasɨɨgi bha mpirya, bharabha abhiirʉri, bharabha bhi ikitwɨ, bharabha bha amatuki, bhatakʉsʉʉka abhiibhuri bhaabhʉ, bhataana bhukumya, na bhatakosengera Mungu. <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>Naatu, bhataana bhʉsɨɨgi, bhatakwenda bhwigwani, abhagʉbhi bha abhaatʉ, bhatakwihama, bhahaari, bhatakʉsɨɨga amazʉmu, <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>bharabha bhiichuri, bharabha bhakokora kɨbhɨkɨbhɨ, na bharabha bhiiyungi. Bharabha bharasɨɨga amangʼana gɨ ɨɨsɨ kutiga gʉ ʉkʉsɨɨga Mungu. <verse eid="2TI 3:4"/><verse number="5" style="v" sid="2TI 3:5"/>Abhaatʉ bhayo bhararorekana nɨ‑bhaatʉ bhanʉ bhakwikara chɨmbu Mungu akwenda, nawe mozekoro zaabhʉ bharaanga amanaga ga Mungu. Ʉtaanɨ na abhaatʉ bhe eteemwa yiyo.<verse eid="2TI 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6"/>Gatɨ waabhʉ bharimu bhanʉ bhakusikɨra ku ubhwɨndi ʉbhʉbhɨ mʉzɨmbɨri za abhaatʉ, na kʉkangirirya abhakari abhageege. Abhakari bhayo bhahizirwɨ nʉ ʉbhʉbhɨ, bhararutwa nɨ ɨnamba yo okokora amabhɨ yʉyʉʉsi. <verse eid="2TI 3:6"/><verse number="7" style="v" sid="2TI 3:7"/>Abhakari bhayo bharɨɨga sikʉ zʉʉsi, nawe bharatamwa komenya amaheene. <verse eid="2TI 3:7"/><verse number="8" style="v" sid="2TI 3:8"/>Abhaatʉ bharya, bharabhagɨra amaheene, chɨmbu Yaanɨ na Yamburɨ,<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">Ɨrarorekana kʉbha </char><char style="fk">Yaanɨ</char> na <char style="fk" closed="false">Yamburɨ </char><char style="ft" closed="false">nebho bhanʉ bhaarɨ abhagabhʉ bhʉ ʉmʉtɨmi wi icharʉ cha Miisiri. </char><char style="xt" closed="false">Rora <ref loc="EXO 7:11-22">Kʉhʉrʉka 7:11‑22</ref>.</char></note> nɨ‑bhanʉ bhahakaanirɨ na Musa. Abhaatʉ bhayo bhasarikirɨ amangʼɨɨni, bhatigirɨ kwisirirya Mungu. <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>Nawe bhatakʉtʉra kuhika hʉhʉʉsi, kʉ kʉbha obhogeege bhwabhʉ bhʉramenyekana kʉbhaatʉ bhʉʉsi, chɨmbu yaarɨ kwa Yaanɨ na Yamburɨ.<verse eid="2TI 3:9"/></para>
  <para style="s">Amaswaja ga Paaurʉ kwa Timoseo</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>Nawe awɨ, utunirɨ amiija gaanɨ, eteemwa yaanɨ, ubhwɨndi bhwanɨ, ubhwisirirya bhwanɨ, ubhwigumirirya bhwanɨ, <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>ʉbhʉsɨɨgi bhwanɨ nu ubhurindi bhwanɨ. Ʉmɨnyirɨ chɨmbu nabhwɨnɨ ɨnyaakʉ, hanʉ naarɨ mʉzɨmbɨri za Antiyʉkiya, Ikʉʉniyʉ na Riisitira. Naatu, ʉmɨnyirɨ kʉbha nikiigumirirya amakʉngʼu gʉʉsi, nʉ Ʉmʉkʉrʉ akansabhʉra mʉgayo gʉʉsi. <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>Mmbe, bhʉʉsi bhanʉ bhariisirirya Yɨɨsu Kiriisitʉ na bhareenda kwikara ubhwikari bhu ukukumya Mungu, bharabha bharanyaakibhwa. <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>Nawe abhakʉri bhʉ ʉbhʉsarya na abhakangirirya bharangʼeha kʉkɨraho kʉbha bhasarya bhʉkʉngʼu, bharabha bharakangirirya na kʉkangiribhwa.<verse eid="2TI 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14"/>Nawe awɨ, ʉmɨnyirɨ amangʼana ganʉ wiijibhwɨ, nɨ‑ga amaheene. Nangʉ wiikarɨ mʉgayo, kʉ kʉbha ʉmɨnyirɨ ʉkɨɨga kurwa kwa bha wɨɨwɨ. <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>Kurwa mubhwana, ʉmɨnyirɨ Amaandɨkʉ Amarɨndu. Amaandɨkʉ gayo gakʉhɨɨrɨ ubhwʉbhʉʉri, kuhika kʉsʉngʼaana ubhutuurya kʉnzɨra yu ukwisirirya Yɨɨsu Kiriisitʉ. <verse eid="2TI 3:15"/><verse number="16" style="v" sid="2TI 3:16"/>Amaandɨkʉ Amarɨndu gʉʉsi gaandikirwɨ kʉbhʉkangati bhwa Mungu. Gayo gareenderwa kwija amaheene, kʉbharecha abhaatʉ, korereke bhatigɨ ʉbhʉbhɨ bhwabhʉ, kʉbhakangata hanʉ bhakubhurwa, na kobheerecha kɨnʉ chʉsi kikwenderwa mʉbhʉtangɨ bhwa Mungu. <verse eid="2TI 3:16"/><verse number="17" style="v" sid="2TI 3:17"/>Amaandɨkʉ gayo garakora ʉmʉʉtʉ wa Mungu abhɨ isiriiryɨ na kʉbhanurwa kokora emeremo jʉsi ɨmɨzʉmu.<verse eid="2TI 3:17"/></para>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>Nɨrakʉtʉma embere wa Mungu na mʉbhʉtangɨ bhwa Yɨɨsu Kiriisitʉ, wʉnʉ akʉtɨnɨra abhahʉru na abhaku, na newe araazɨ kʉkangata nchʉ ʉmʉtɨmi. <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>Nangʉ, rwaza ɨngʼana ya Mungu. Okorebhu ribhaga ryʉryʉsi, rizʉmu hamwɨ riibhɨ. Recha na yangirija, ʉbhahɨ umwʉyʉ na kubhiija kubhwigumirirya bhwʉsi.<verse eid="2TI 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 4:3"/>Rɨraaza ribhaga rɨnʉ abhaatʉ bhakʉbha bhatakwitegeerera amiija ga amaheene. Bharabha bhareenda kwitegeerera ganʉ gakʉbhazomerabhu, na korobhora abhiija bhaaru bhu ukubhiija ganʉ bhakʉsɨɨga kwigwa. <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>Bharatiga kwitegeerera amaheene, na bharatuna amaganʉ gɨ ɨkarɨ ganʉ gataana enzobhooro yʉyʉʉsi. <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>Nawe awɨ, ʉbhɨ mɨɨsʉ kwa gʉʉsi, wiigumiriryɨ ɨnyaakʉ, okore emeremo ju ukurwaza Ɨngʼana Ɨnzʉmu, okore bhwaheene mobhohocha bhwazʉ bhwʉsi.<verse eid="2TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6"/>Nɨrakʉbhʉʉrɨra gayo, kʉ kʉbha amasaahɨ gaanɨ garɨ haguhɨ kuhurukibhwa nchi ikimweso, ahagero hu ukuhurukirya ikimweso.<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="xt" closed="false">Rora <ref loc="EXO 29:38-41">Kʉhʉrʉka 29:38‑41</ref>.</char></note> Ribhaga ryanɨ ryu ukukwa rihikirɨ haguhɨ. <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>Nitɨɨnɨ riihɨ rizʉmu, nɨmarirɨ orogendo, na nigwatirɨ ubhwisirirya. <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>Nangʉ ɨsaagirɨ kʉhaabhwa ɨkɨrʉngʉ che eheene. Ʉmʉkʉrʉ Yɨɨsu, umutiniri we eheene, arangʼa urusikʉ rwʉ ʉkʉgarʉka kwazɨ. Ɨtarɨ inyɨ inyimwene, nawe na abhandɨ bhʉʉsi bhanʉ bhakwisega kʉgarʉka kwawe.<verse eid="2TI 4:8"/></para>
  <para style="s">Amasabhi ga Paaurʉ kwa Timoseo</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>Timoseo, ikongʼeererya kuuza bhwangʉ ɨwaanɨ, <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>kʉ kʉbha Deema antigirɨ. Ewe akasɨɨga amangʼana ga kʉʉsɨ, akatɨnɨra kuja kʉrʉbhɨri rwa Tɨsarʉʉnikɨ. Kirɨsikɨ agiirɨ icharʉ cha Garaatiya, na Tiitʉ agiirɨ icharʉ cha Darimatiya. <verse eid="2TI 4:10"/><verse number="11" style="v" sid="2TI 4:11"/>Ruuka umwene newe asaagirɨ hamwɨmwɨ na niinyɨ hanʉ. Nangʉ, uriizɨ ɨnʉ, uuzɨ na Maaroko, kʉ kʉbha aratʉra kʉnsakirya emeremo ja Mungu. <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>Nɨkatʉma Tikikʉ ʉrʉbhɨri rwa Efeeso. <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>Hanʉ ʉraazɨ, uuzɨ nɨ ɨkabhuuti yaanɨ yɨnʉ natigirɨ kwa Karipʉ, ʉrʉbhɨri rwa Turowa, nɨ ɨbhɨtabhʉ bhirya, kɨnda bhya riseero.<verse eid="2TI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14"/>Arɨkizanda umuturi wi ibhyʉma, ankʉrɨɨrɨ ʉbhʉbhɨ bhʉkʉngʼu. Ʉmʉkʉrʉ aramʉtɨnɨra kʉrɨngʼaana na amahocha gaazɨ. <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>Na naawɨ wiyangarɨrɨ nawe, kʉ kʉbha aarɨ araanga bhʉkʉngʼu amiija gɨɨtʉ.<verse eid="2TI 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16"/>Hanʉ niibhagiirɨ mʉtɨnɨrʉ korogendo rwe embere, ataarɨ areho nʉʉrʉ wʉmwɨ wʉnʉ imiiriirɨ ʉrʉbhaara rwanɨ, bhʉʉsi bhakantiga. Nɨrasabha Mungu atigɨ kʉbhabharɨra ʉbhʉsarya bhuyo. <verse eid="2TI 4:16"/><verse number="17" style="v" sid="2TI 4:17"/>Nawe Ʉmʉkʉrʉ aarɨ hamwɨmwɨ na niinyɨ, akangʼa amanaga kwerekeererya Ɨngʼana Ɨnzʉmu yʉʉsi, korereke abhaatʉ bhʉʉsi bhanʉ bhatarɨ Abhayaahudi bhiigwɨ. Akansabhʉra muruku, kʉ kʉbha naarɨ nkina mumunywa gwɨ ɨɨka. <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>Nɨɨzɨ arangʼeha kʉnsabhʉra mʉmabhɨ gʉʉsi, na kundiibha kuhika mʉbhʉtɨmi bhwazɨ bhwa mwisaarʉ.</para>
  <para style="p" vid="2TI 4:18">Ʉmʉkʉrʉ agungibhwɨ kemerano! Garamɨ.<verse eid="2TI 4:18"/></para>
  <para style="s">Amangʼana gʉ ʉkʉraga</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>Okeerye Akiira nʉ ʉmʉkari waazɨ Pirisiira, na bhanʉ bhari munyumba ya Ʉnɨsifʉrʉ. <verse eid="2TI 4:19"/><verse number="20" style="v" sid="2TI 4:20"/>Ɨraasitʉ akasaaga mʉrʉbhɨri rwa Kʉrintʉ. Tʉrʉfimʉ nɨkamutiga kʉrʉbhɨri rwa Mireeto, aarɨ murwɨrɨ. <verse eid="2TI 4:20"/><verse number="21" style="v" sid="2TI 4:21"/>Nangʉ, okore bhwangʉ kuuza ribhaga rye embeho rɨkɨɨrɨ kuhika. Ɨbhuurʉ, Pudɨ, Riinʉ, na Kiraudiya, hamwɨmwɨ na abhiisirirya bhʉʉsi, bharakokeerya.<verse eid="2TI 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22"/>Ʉmʉkʉrʉ abhɨ hamwɨmwɨ na naawɨ. Ɨbhɨgʉngi bhyazɨ bhɨbhɨ hamwɨmwɨ na niimwɨ.<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
