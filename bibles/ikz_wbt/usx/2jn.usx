<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">‑ Ikizu 2 John</book>
  <para style="h">2 Yoohana</para>
  <para style="toc3">2 Yoohana</para>
  <para style="toc2">2 Yoohana</para>
  <para style="toc1">Ɨnyarʉbha ya kabhɨrɨ ya Yoohana</para>
  <para style="mt2">Ɨnyarʉbha ya kabhɨrɨ ya</para>
  <para style="mt1">Yoohana</para>
  <para style="imt">Ʉbhʉkangati</para>
  <para style="ip">Yoohana akaandɨka ɨnyarʉbha yɨnʉ kʉmʉkari wʉnʉ arʉbhwɨrwɨ na abhaana bhaazɨ. Kʉhɨtɨra amangʼana gayo enzobhooro yaku yaarɨ risengerero. Akʉmara akabhuga, ɨnyarʉbha yiyo yaarɨ igʉrʉ wa abhiisirirya bhʉʉsi. Mʉnyarʉbha ya kabhɨrɨ, Yoohana arangʼeha koha umwʉyʉ abhiisirirya korereke bhiikarɨ ku kutuna amaheene nʉ ʉbhʉsɨɨgi. Kwikɨ arangʼeha kʉbharecha igʉrʉ wa abhiija bhʉ ʉrʉrɨmɨ. Arabhakandikija abhiisirirya bhabhɨ abhaangariri na bhiikarɨ mubhwisirirya bhwa amaheene.</para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="s">Amakeerenʼya</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>Inyɨ umwimiiririri wa risengerero, nɨrakwandɨkɨra awɨ umusubhaati wʉnʉ ʉrʉbhwɨrwɨ na Mungu, hamwɨmwɨ na abhaana bhaazʉ<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fk" closed="false">Umusubhaati wʉnʉ ʉrʉbhwɨrwɨ na Mungu, hamwɨmwɨ na abhaana bhaazʉ</char><char style="ft" closed="false">, enzobhooro yaku ni‑risengerero irebhe hamwɨmwɨ na abhiisirirya bhaazɨ.</char></note> bhanʉ nɨsɨɨgirɨ kʉmaheene. Ɨtarɨ inyimwene, nawe na abhandɨ bhʉʉsi bhanʉ bhɨɨzɨ amaheene. <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>Nɨbhasɨɨgirɨ kʉ kʉbha itwɨ na niimwɨ tʉmɨnyirɨ amaheene, na tʉrakaja komenya kwa kemerano.<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>Ɨbhɨgʉngi, rigʉngi no omorembe kurwa kwa Bhaabha Mungu, na kʉMʉkʉrʉ Yɨɨsu Kiriisitʉ, bhɨbhɨ na niitwɨ, bhanʉ tukutuna amaheene nʉ ʉbhʉsɨɨgi.<verse eid="2JN 1:3"/></para>
  <para style="s">Ʉkʉsɨɨgana nekwe ukwisirirya amaswaja ga Mungu</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>Nɨkazomerwa bhʉkʉngʼu korora abhaana bhaazʉ obhorebhe bharatuna ɨnzɨra ya amaheene, chɨmbu Bhaabha Mungu aatuswajiryɨ. <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>Nangʉ, umusubhaati ʉmʉsɨɨgwa, nɨrakʉsabha ugwatɨ amaswaja ganʉ gakubhuga tʉsɨɨganɨ. Amaswaja gayo gatarɨ mahya, nawe nɨ‑garyagarya twarɨ nagʉ kwɨma hanʉ mwatangirɨ kwisirirya.<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="xt" closed="false">Rora <ref loc="JHN 13:34">Yoohana 13:34</ref>.</char></note> <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>Ʉkʉsɨɨgana nekwe ukugwata amaswaja ga Mungu. Rɨnʉ neryo riswaja rɨnʉ mwigwirɨ kwɨma ʉbhʉtangɨ kʉbha mwikarɨ kwʉ ʉbhʉsɨɨgi.<verse eid="2JN 1:6"/></para>
  <para style="s">Amaangirijʉ igʉrʉ wa abhakangirirya</para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>Nɨragambabhu kʉ kʉbha abhakangirirya bhaaru bhabhʉnɨkirɨ kʉʉsɨ. Bhatakwisirirya Yɨɨsu Kiriisitʉ akiibhurwa ʉmʉʉtʉ.<note caller="+" style="f"><char style="fr" closed="false">1:7a </char><char style="xt" closed="false">Rora <ref loc="1JN 4:2-3">1 Yoohana 4:2‑3</ref>.</char></note> Ʉmʉʉtʉ wʉwʉʉsi wʉnʉ akubhugabhu, nɨ‑mʉkangirirya, na ni‑mubhisa wa Kiriisitʉ.<note caller="+" style="f"><char style="fr" closed="false">1:7b </char><char style="fk" closed="false">Umubhisa wa Kiriisitʉ</char><char style="ft" closed="false">, enzobhooro yaku nɨ‑wʉnʉ akwanga Kiriisitʉ.</char></note> <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>Mmbe, mwiyangarɨrɨ imubheene, korereke emeremo janyu gɨtaaza kʉbhʉra bhʉʉha, nawe mʉsʉngʼaanɨ kurwa kwa Mungu ririhi rinagu. <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>Wʉwʉʉsi wʉnʉ akuja hagarɨ na amiija ga Kiriisitʉ, wuyo ataana ubhumwɨmwɨ na Mungu. Nawe, wʉnʉ akongʼeha kugwata amiija ga Kiriisitʉ, wuyo anu ubhumwɨmwɨ na Bhaabha Mungu nu Umwana waazɨ wʉʉsi. <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>Arɨɨbhɨ wʉwʉʉsi araaza kwa niimwɨ wʉnʉ atakwija gayo, mʉtamuginihya mumijɨ janyu, na mʉtamokeerya nchu Umukiriisitʉ ʉmʉkɨndichanyu. <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>Ʉmʉʉtʉ wʉwʉʉsi wʉnʉ akomokeerya, arɨ hamwɨmwɨ nawe mʉmangʼana gaazɨ amabhɨ.<verse eid="2JN 1:11"/></para>
  <para style="s">Amakeerenʼya gʉ ʉkʉraga</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>Nɨna amangʼana maaru gʉ ʉkʉgamba, nawe nɨtakwenda kwandɨka kʉnzɨra yɨ ɨnyarʉbha. Kʉgayo, niriisega kuuza kwa niimwɨ kʉbhataarɨra na kwibhisirya hamwɨmwɨ, korereke obhozomerwa bhwɨtʉ bhuhikɨ.<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>Abhaana bhu umusubhaati waazʉ wʉnʉ arʉbhwɨrwɨ na Mungu,<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="fk" closed="false">Abhaana bhu umusubhaati waazʉ wʉnʉ arʉbhwɨrwɨ na Mungu</char><char style="ft" closed="false">, enzobhooro yaku ni‑bhiisirirya bha risengerero irebhe.</char></note> bharakokeerya.<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
