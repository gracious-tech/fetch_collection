<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">‑ Ikizu Galatians</book>
  <para style="h">Abhagaraatiya</para>
  <para style="toc3">Abhagaraatiya</para>
  <para style="toc2">Abhagaraatiya</para>
  <para style="toc1">Ɨnyarʉbha ya Paaurʉ kwa Abhagaraatiya</para>
  <para style="mt2">Ɨnyarʉbha ya Paaurʉ kwa</para>
  <para style="mt1">Abhagaraatiya</para>
  <para style="imt">Ʉbhʉkangati</para>
  <para style="ip">Garaatiya ni‑charʉ kɨnʉ charɨ gatɨgatɨ wi icharʉ kɨnʉ sikʉ zɨnʉ kikubhirikirwa Bhuturuki. Paaurʉ na Bharinaabha bhakarwaza Ɨngʼana Ɨnzʉmu igʉrʉ wa Yɨɨsu mʉzɨmbɨri obhorebhe zɨnʉ zaarɨ mʉrʉbhɨri rwa Garaatiya. Abhaatʉ bhaaru bhakiisirirya Ɨngʼana Ɨnzʉmu ya Yɨɨsu, bhakabha Abhakiriisitʉ. Nawe ribhaga rɨkahɨta, abhaatʉ obhorebhe bhakiija Abhakiriisitʉ bhabhɨ bharagwata imigirʉ na zisimʉka za Abhayaahudi, na bhabhɨ bharasaarwa.</para>
  <para style="ip">Kʉnyarʉbha yɨnʉ, Paaurʉ arahiitya Abhakiriisitʉ bha Garaatiya kʉbha, Mungu arasabhʉra abhaatʉ bhʉʉsi bhanʉ bhakwisirirya Kiriisitʉ, ɨtarɨ bhanʉ bhakugwata imigirʉ hamwɨ zisimʉka obhorebhe. Paaurʉ araragɨrɨra bhwaheene kʉbha, tʉtakʉtʉra kʉbha abhaatʉ bhe eheene mʉbhʉtangɨ bhwa Mungu ku kugwata imigirʉ jazɨ, nawe ni‑ku ubhwisirirya bhwɨtʉ. Paaurʉ arabhuga ubhwikari bhwɨtʉ Abhakiriisitʉ bhʉkangatwɨ ne Ekoro Ɨndɨndu, korereke twisiriryɨ ubhuswaja ʉbhʉkʉrʉ bhwa Mungu bhwʉ ʉkʉsɨɨga abhaatʉ abhandɨ.</para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="s">Amakeerenʼya</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>Ɨnyarʉbha yɨnʉ nandikirɨ inyɨ Paaurʉ. Inyɨ nɨtaatumirwɨ na abhaatʉ hamwɨ kuswajibhwa na mʉʉtʉ, nawe nitumirwɨ na Yɨɨsu Kiriisitʉ na Bhaabha Mungu wʉnʉ aaryurirɨ Yɨɨsu kurwa mʉbhaku. <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>Inyɨ na abhiisirirya abhakɨndichɨtʉ bhʉʉsi bhanʉ bharɨ hamwɨmwɨ na niinyɨ, tʉrabhaandɨkɨra imwɨ abhiisirirya bhʉ ʉrʉbhɨri rwa Garaatiya.<verse eid="GAL 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3"/>Ɨbhɨgʉngi no omorembe kurwa kwa Bhaabha Mungu, na kʉMʉkʉrʉ Yɨɨsu Kiriisitʉ, bhɨbhɨ na niimwɨ. <verse eid="GAL 1:3"/><verse number="4" style="v" sid="GAL 1:4"/>Kiriisitʉ akiihurucha igʉrʉ wʉ ʉbhʉbhɨ bhwɨtʉ, korereke atʉsabhʉrɨ kurwa mʉmabhɨ gʉʉsi gɨ ɨɨsɨ ya nangwɨnʉ. Akakorabhu kʉrɨngʼaana nu ubhwɨndi bhwa Bhaabha wɨɨtʉ Mungu.<verse eid="GAL 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GAL 1:5"/>Mungu agungibhwɨ kemerano! Garamɨ.<verse eid="GAL 1:5"/></para>
  <para style="s">Ɨtareeho Ɨngʼana Ɨnzʉmu ɨyɨndɨ ya amaheene</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>Nɨrarʉgʉʉra kʉ kʉbha ibhaga isuubhu mʉtangirɨ kutiga Mungu wʉnʉ aabhabhirikiirɨ kʉbhɨgʉngi bhya Kiriisitʉ, na kwichʉrɨra amiija agandɨ ganʉ abhandɨ bhakʉbhɨrɨkɨra Ɨngʼana Ɨnzʉmu. <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>Amaheene nɨ‑kʉbha ɨtareeho Ɨngʼana Ɨnzʉmu ɨyɨndɨ. Nawe bhareho abhaatʉ bhanʉ bhakʉbhanyaacha na bhareenda kurimirya Ɨngʼana Ɨnzʉmu igʉrʉ wa Kiriisitʉ. <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>Nawe nangabha wʉmwɨ wɨɨtʉ hamwɨ maraika<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="fk" closed="false">Maraika</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> kurwa kwisaarʉ, araabharwazɨrɨ ɨngʼana bhʉndɨ na yɨnʉ twabharwaziirɨ, ʉmʉʉtʉ wuyo ihiimwɨ! <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>Nɨragarʉkɨra kʉgamba, chɨmbu nagambirɨ ribhaga rirya kʉbha, ʉmʉʉtʉ wʉwʉʉsi araabharwazɨrɨ ɨngʼana bhʉndɨ na yɨnʉ twabharwaziirɨ, ʉmʉʉtʉ wuyo ihiimwɨ!<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>Nangʉ, muriiseega nɨramohya kwisiriribhwa na abhaatʉ? Zɨyi, inyɨ nɨramohya kwisiriribhwa na Mungu umwene. Hamwɨ muriiseega nɨramohya kozomera abhaatʉ? Arɨɨbhɨ nangamʉhiryɨ kozomera abhaatʉ, nɨtaarɨ nɨrabha omohocha wa Kiriisitʉ.<verse eid="GAL 1:10"/></para>
  <para style="s">Paaurʉ abhirikiirwɨ na Mungu</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>Abhahiiri bhaanɨ, nereenda momenye kʉbha, Ɨngʼana Ɨnzʉmu yɨnʉ inyɨ nabharwaziirɨ ɨtaruurɨ kʉbhaatʉ. <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>Na nɨtahɨɨrwɨ na mʉʉtʉ, naabha kwijibhwa na ʉmʉʉtʉ wʉwʉʉsi, nawe Yɨɨsu Kiriisitʉ umwene newe anhumburiirɨ.<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>Nɨ‑maheene mwigwirɨ chɨmbu naarɨ ribhaga rɨnʉ niitaniirɨ ɨnyangi yaanɨ yɨ Ɨkɨyaahudi. Mwɨzɨ chɨmbu nanyaakiryɨ bhʉkʉngʼu abhaatʉ bha mwisengerero rya Mungu, na kwenda kuriricha kɨmwɨ. <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>Nɨkahiza abhakɨndichanɨ bhaaru bhɨ ɨsɨɨga yaanɨ ku ukwitanɨra ɨnyangi yɨɨtʉ yɨ Ɨkɨyaahudi. Nɨkakora umucha bhʉkʉngʼu kugwata amanarʉ ga bhabhaabha. <verse eid="GAL 1:14"/><verse number="15" style="v" sid="GAL 1:15"/>Nawe Mungu akandobhora nɨkɨɨrɨ kwibhurwa, akambɨrɨkɨra kʉbhɨgʉngi bhyazɨ, akatɨnɨra <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>kuhumburɨra chɨmbu Umwana waazɨ<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="fk" closed="false">Umwana waazɨ</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">Umwana wa Mungu</char> muKiniibhasa.</note> arɨ. Akeenda kokorabhu, korereke nirwazɨ Ɨngʼana Ɨnzʉmu igʉrʉ wu Umwana waazɨ kʉbhaatʉ bhanʉ bhatarɨ Abhayaahudi. Nɨtamʉhiryɨ abhaatʉ bha kʉndagɨrɨra kɨnʉ nɨraakore. <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>Nɨtaabhugirɨ nijɨ Yɨrusarɨɨmu kʉbhanʉ bhaankangatiirɨ kʉbha abhatumwa.<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="fk" closed="false">Abhatumwa</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> Nawe kɨnʉ nakʉrirɨ ni‑kuja mucharʉ cha Arabhiya. Akʉmara, nɨkagarʉka naatu mʉrʉbhɨri rwa Damɨɨsikʉ.<verse eid="GAL 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18"/>Hanʉ jahitirɨ imyaka ɨtatʉ, nɨkaja Yɨrusarɨɨmu korereke nirumanɨ na Peetero.<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="fk" closed="false">Peetero</char><char style="ft" closed="false">, iriina ɨrɨndɨ arabhirikirwa </char><char style="fqa" closed="false">Keefa.</char></note> Nikiikara ɨwaazɨ sikʉ ikumi ni isaanʉ. <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>Nawe nɨtarʉʉzɨ abhatumwa abhandɨ, kuruushaku Yaakobho, umwabhʉ Ʉmʉkʉrʉ Yɨɨsu. <verse eid="GAL 1:19"/><verse number="20" style="v" sid="GAL 1:20"/>Mungu amɨnyirɨ amangʼana ganʉ nɨkʉbhaandɨkɨra gatarɨ ga rʉrɨmɨ!<verse eid="GAL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21"/>Mmbe, ribhaga ɨrɨndɨ nɨkaja mubhyarʉ bhya Siiriya na Kirikiya. <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>Ribhaga riyo, inyɨ nɨtaarɨ nɨmɨnyɨkɨɨnɨ kʉmasengerero ganʉ garɨ mucharʉ cha Yudeya. <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>Kɨnʉ bhaarɨ bhɨɨzɨ igʉrʉ waanɨ nɨ‑mangʼana ganʉ bhiigwirɨ, “Ʉmʉʉtʉ wʉnʉ aatʉnyaakiryɨ mʉbhʉtangɨ, sikʉ zɨnʉ ahaarwaza ubhwisirirya bhuryabhurya bhʉnʉ ɨɨndirɨ kubhuricha!” <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>Mmbe, bhakakumya Mungu igʉrʉ wa ganʉ aarɨ ankʉrɨɨrɨ.<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s">Paaurʉ ararumana na abhakangati abhandɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>Hanʉ jahitirɨ imyaka ikumi ne ene, nɨkatiira kwikɨ kuja Yɨrusarɨɨmu. Nɨkahirana na Bharinaabha, na nɨkagega Tiitʉ tʉkaja nawe. <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>Nɨkatiira kuja Yɨrusarɨɨmu, kʉ kʉbha Mungu aarɨ anhumburiirɨ nijɨ. Hanʉ nahikirɨ, tʉkarumana na abhakangati bha risengerero kwa rusizʉ. Nɨkaragɨrɨra abhakangati bhayo Ɨngʼana Ɨnzʉmu yɨnʉ naarɨ nɨrabharwazɨra abhaatʉ bhanʉ bhatarɨ Abhayaahudi. Nekeenda kokorabhu, korereke emeremo gɨnʉ naarɨ nɨrakora na gɨnʉ nekokora gɨtaaza kʉbha ja bhʉʉha. <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>Nʉʉrʉ Tiitʉ wʉnʉ aarɨ hamwɨhamwɨ na niinyɨ, atarɨ Ʉmʉyaahudi, nawe ataahatikirwɨ kʉsaarwa.<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="fk" closed="false">Kʉsaarwa</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">ʉkʉsaara</char> muKiniibhasa.</note> <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>Ringʼana ryɨ ɨsaarʉ rɨkabhuuribhwa na abhaatʉ bhanʉ bhaarɨ bhariikorya ni‑bhiisirirya abhakɨndichɨtʉ, nawe bhakiisikirya kʉbhʉngʼɨɨni komohya imyeya jɨtʉ gɨnʉ twahɨɨrwɨ na Yɨɨsu Kiriisitʉ. Ubhwɨndi bhwabhʉ bhwarɨ ne‑kotokora tʉbhɨ bhambʉʉsa bhi imigirʉ jɨ Ɨkɨyaahudi. <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>Itwɨ tutiisirirɨɨnʼyɨ nabhʉ nʉʉrʉ hasuuhu, korereke amaheene gɨ Ɨngʼana Ɨnzʉmu gasaagɨ kwa niimwɨ.<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>Nawe abhakangati bha risengerero bhanʉ bhakusuukwa bhʉkʉngʼu na abhaatʉ, bhataarɨ na rya kʉmbʉʉrɨra. Nɨ‑maheene bhakasuukwa bhʉkʉngʼu, nawe kwa niinyɨ ɨtaana nzobhooro, kʉ kʉbha Mungu atakʉdɨɨrɨɨra umweya gwʉ ʉmʉʉtʉ. <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>Abhakangati bhayo bhakoobhoora kʉbha, Mungu antumirɨ nirwazɨ Ɨngʼana Ɨnzʉmu kʉbhaatʉ bhanʉ bhatarɨ Abhayaahudi, chɨmbu aatumirɨ Peetero arwazɨ kʉBhayaahudi. <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>Mungu wʉnʉ aanagiryɨ Peetero kʉbha umutumwa wa Abhayaahudi, newe anagiryɨ kʉbha umutumwa kʉbhaatʉ bhanʉ bhatarɨ Abhayaahudi. <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>Hanʉ Yaakobho, Peetero na Yoohana, bhanʉ bhaarɨ abhakangati abhakʉrʉ, bhaarʉʉzɨ ɨbhɨgʉngi bhɨnʉ ahɨɨrwɨ na Mungu, bhakatugwata amabhoko inyɨ na Bharinaabha. Tukiisiriranʼya itwɨ tujɨ kokora emeremo kʉbhaatʉ bhanʉ bhatarɨ Abhayaahudi, ebho bhakore emeremo kʉBhayaahudi. <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>Nawe bhakatʉsabha kegero kɨmwɨ, tuhiitɨ abhahabhɨ.<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">Abhahabhɨ bhanʉ bhakʉgambwa hanʉ ni Abhakiriisitʉ bha Yɨrusarɨɨmu. </char><char style="xt" closed="false">Rora <ref loc="ACT 11:29-30">Amahocha ga Abhatumwa 11:29‑30</ref>.</char></note> Na niinyɨ naarɨ nu umucha bhʉkʉngʼu gwo okokora amangʼana gayo.<verse eid="GAL 2:10"/></para>
  <para style="s">Paaurʉ arahama Peetero</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>Nawe hanʉ Peetero aahikirɨ Antiyʉkiya, urusikʉ rʉmwɨ nɨkamʉhakaanʼya habhwɨrʉ, kʉ kʉbha aarɨ asariryɨ. <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>Peetero aarɨ ararya ibhyakurya hamwɨmwɨ na abhiisirirya bhanʉ bhatarɨ Abhayaahudi. Nawe hanʉ abhaatʉ obhorebhe kurwa kwa Yaakobho bhaahikirɨ, akatiga kurya, akiiyahʉra, ku kwʉbhaha abhaatʉ bhanʉ bhakʉkandikija ɨsaarʉ. <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>Na abhiisirirya abhandɨ bhɨ Ɨkɨyaahudi bhakatanga kokora chɨmbu Peetero aarɨ arakora, ɨnʉ bhɨɨzɨ kʉbha, ne‑ngʼeera. Bharinaabha wʉʉsi akasikɨra mongʼeera muyo.<verse eid="GAL 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14"/>Hanʉ narʉʉzɨ bhatakokora chɨmbu amaheene gɨ Ɨngʼana Ɨnzʉmu garɨ, nɨkabhʉʉrɨra Peetero mʉbhʉtangɨ bhwabhʉ, “Awɨ nɨ‑Mʉyaahudi, nawe ʉhaakora chɨmbu abhaatʉ bhanʉ bhatarɨ Abhayaahudi bhahaakora. Kwakɨ ʉhatɨkɨ abhaatʉ bhanʉ bhatarɨ Abhayaahudi kutuna isimʉka ya Abhayaahudi?”<verse eid="GAL 2:14"/></para>
  <para style="s">Abhaatʉ bhʉʉsi bharasabhurwa kukwisirirya Yɨɨsu Kiriisitʉ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>Nɨ‑maheene kʉbha itwɨ twibhwirwɨ Abhayaahudi, ɨtarɨ abhaatʉ bhanʉ bhatarɨ Abhayaahudi, bhanʉ tʉkʉbhɨrɨkɨra abhakʉri bhʉ ʉbhʉbhɨ. <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>Nawe tʉmɨnyirɨ, ʉmʉʉtʉ atakʉtʉra kʉbharwa ʉmʉʉtʉ we eheene mʉbhʉtangɨ bhwa Mungu ku ukugwata imigirʉ ja Musa, nawe ni‑ku kwisirirya Yɨɨsu Kiriisitʉ. Ɨbhu na niitwɨ kwikɨ, twisiriiryɨ Yɨɨsu Kiriisitʉ korereke tʉbharwɨ abhaatʉ bhe eheene mʉbhʉtangɨ bhwa Mungu ku ukwisirirya Kiriisitʉ, ɨtarɨ ku ukugwata imigirʉ ja Musa. Nɨ‑maheene kʉbha atareeho ʉmʉʉtʉ wʉnʉ akʉtʉra kʉbharwa kʉbha ʉmʉʉtʉ we eheene mʉbhʉtangɨ bhwa Mungu ku ukugwata imigirʉ ja Musa.<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="xt" closed="false">Rora <ref loc="PSA 143:2">Zabhuri 143:2</ref>; <ref loc="ROM 3:20">Abharuumi 3:20</ref>.</char></note><verse eid="GAL 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17"/>Nawe, arɨɨbhɨ tʉramohya kʉbharwa kʉbha abhaatʉ bhe eheene ku ukugwatana na Kiriisitʉ, abhandɨ bharabhuga tʉbhɨɨrɨ abhakʉri bhʉ ʉbhʉbhɨ, kʉ kʉbha tʉtakugwata imigirʉ ja Musa. Nɨ‑maheene Kiriisitʉ aratokora kʉbha abhakʉri bhʉ ʉbhʉbhɨ? Zɨyi! <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>Nawe nɨraagarʉkɨrɨ naatu kwisirirya imigirʉ gɨnʉ nangirɨ, hayo nereerekenʼya kʉbha, mʉsarya nɨrɨ. <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>Naarɨ nɨratuna imigirʉ ja Musa, nawe ʉbhʉhʉru bhwanɨ ribhaga ryi imigirʉ bhusirirɨ, korereke niikarɨ igʉrʉ wa Mungu. <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>Hanʉ Kiriisitʉ aakuurɨ kʉmʉsarabha, eteemwa yaanɨ yɨ ɨkarɨ ɨkakwa. Nangʉ mʉhʉru nɨrɨ, nawe ɨtarɨ chɨmbu naarɨ ɨkarɨ, kʉ kʉbha Kiriisitʉ ana niinyɨ. Ubhwikari bhʉnʉ nɨnabhwɨ ribhaga rɨnʉ, niriikara kubhwisirirya muMwana wa Mungu. Ewe akansɨɨga na akahurucha ubhwikari bhwazɨ kwa niinyɨ korereke antuuryɨ. <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>Nɨtakʉtʉra kwanga ɨbhɨgʉngi bhya Mungu. Arɨɨbhɨ ʉmʉʉtʉ aratʉra kʉbharwa we eheene mʉbhʉtangɨ bhwa Mungu ku ukugwata imigirʉ ja Musa, tubhugɨ nangʉ Kiriisitʉ akakwa ataana bhwera!<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s">Abhiisirirya bharasʉngʼaana Ekoro Ɨndɨndu kubhwisirirya</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>Imwɨ Abhagaraatiya, mʉbhɨɨrɨ bhageege heene! Mʉrʉgirwɨ na wɨɨwɨ? Nɨbhɨɨrɨkiryɨ habhwɨrʉ kɨnʉ chagiriryɨ Yɨɨsu Kiriisitʉ akakwa kʉmʉsarabha. <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>Nangʉ nɨrasabha komenya kegero kɨmwɨ. Mʉkasʉngʼaana Ekoro Ɨndɨndu<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fk" closed="false">Ekoro Ɨndɨndu</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> ku kugwata imigirʉ ja Musa, hamwɨ nɨ‑kʉ kʉbha mukiitegeerera na kwisirirya Ɨngʼana Ɨnzʉmu igʉrʉ wa Yɨɨsu? <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>Kwakɨ mʉbhɨɨrɨ bhageegebhu? Imwɨ mʉkatanga ubhwikari bhwanyu ubhuhya kʉmanaga ge Ekoro Ɨndɨndu, nawe moreenda kʉmara kʉmanaga gaanyu imubheene? <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>Nangʉ, ɨnyaakʉ yɨnʉ yaabhabhwɨnɨ, mʉrakina yaarɨ bhʉʉha? Ɨtaarɨ bhʉʉha! <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>Mʉmbʉʉrɨrɨ, Mungu abhahɨɨrɨ Ekoro Ɨndɨndu na kokora ɨbhɨsɨgʉ gatɨ waanyu kʉ kʉbha mʉkagwata imigirʉ ja Musa, kisha kʉ kʉbha mukiitegeerera na kwisirirya Ɨngʼana Ɨnzʉmu igʉrʉ wa Yɨɨsu?<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>Mwiseege ɨngʼana ya Abhurahaamu.<note caller="+" style="f"><char style="fr" closed="false">3:6a </char><char style="fk" closed="false">Abhurahaamu</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> Amaandɨkʉ Amarɨndu garabhuga, “Abhurahaamu akiisirirya Mungu, na Mungu akamʉbhara we eheene.”<note caller="+" style="f"><char style="fr" closed="false">3:6b </char><char style="xt" closed="false">Rora <ref loc="GEN 15:6">Ʉbhʉtangɨ 15:6</ref>.</char></note> <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>Mmbe nangʉ, momenye, abhaatʉ bhanʉ bhakwisirirya Mungu, nebho abhaana bha Abhurahaamu! <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>Amaandɨkʉ Amarɨndu gakarootorera kʉbha, Mungu arabhabharɨra abhaatʉ bhanʉ bhatarɨ Abhayaahudi kʉbha bhe eheene kʉnzɨra yu ubhwisirirya bhwabhʉ. Mungu aakangatirɨ kʉraganʼya Abhurahaamu Ɨngʼana Ɨnzʉmu yiyo kʉbha, “Kʉhɨtɨra kwa naawɨ, abhaatʉ bhi ibhyarʉ bhyʉsi bharahakwa.”<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="xt" closed="false">Rora <ref loc="GEN 12:3">Ʉbhʉtangɨ 12:3</ref>.</char></note> <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>Mmbe, bhanʉ bhakwisirirya Mungu, bharahaabhwa ʉrʉbhangʉ, chɨmbu Abhurahaamu aahakirwɨ kʉ kʉbha akiisirirya.<verse eid="GAL 3:9"/></para>
  <para style="s">Ʉbhʉhʉru bhʉrabhoneka kubhwisirirya</para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>Nawe bhʉʉsi bhanʉ bhakwisega kokora ganʉ gakwenderwa ni imigirʉ ja Musa, bhiihiimirwɨ, kʉ kʉbha Amaandɨkʉ Amarɨndu garabhuga, “Wʉwʉʉsi wʉnʉ atakugwata na kokora gʉʉsi ganʉ gaandikirwɨ mʉkɨtabhʉ chi imigirʉ, ihiimirwɨ.”<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="xt" closed="false">Rora <ref loc="DEU 27:26">Amahiityʉ gi Imigirʉ 27:26</ref>.</char></note> <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>Nɨ‑maheene kʉbha atareeho ʉmʉʉtʉ wʉnʉ akʉbharwa we eheene mʉbhʉtangɨ bhwa Mungu ku ukugwata imigirʉ, kʉ kʉbha Amaandɨkʉ Amarɨndu garabhuga, “We eheene, ariikara kubhwisirirya.”<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="xt" closed="false">Rora <ref loc="HAB 2:4">Habhakuuki 2:4</ref>.</char></note> <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>Imigirʉ gɨtakwisega ubhwisirirya, nawe Amaandɨkʉ Amarɨndu garabhuga, “Ʉmʉʉtʉ wʉnʉ akugwata gʉʉsi ganʉ gari mumigirʉ, ariikara ku kugwata imigirʉ giyo.”<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="xt" closed="false">Rora <ref loc="LEV 18:5">Abharaawi 18:5</ref>.</char></note><verse eid="GAL 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13"/>Kiriisitʉ akatʉsabhʉra kurwa mʉmaraga gi imigirʉ ko kogega amaraga gɨɨtʉ. Amaandɨkʉ Amarɨndu garabhuga, “Wʉwʉʉsi wʉnʉ abhambirwɨ kʉmʉsarabha, ihiimirwɨ.”<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="xt" closed="false">Rora <ref loc="DEU 21:23">Amahiityʉ gi Imigirʉ 21:23</ref>.</char></note> <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>Akatʉsabhʉra korereke ʉrʉbhangʉ rʉnʉ aahɨɨrwɨ Abhurahaamu, rʉbhahikɨrɨ abhaatʉ bhanʉ bhatarɨ Abhayaahudi kʉhɨtɨra Yɨɨsu Kiriisitʉ. Tʉratʉra kʉsʉngʼaana Ekoro Ɨndɨndu yɨnʉ Mungu aatʉragirɨ kʉnzɨra yu ukwisirirya Yɨɨsu Kiriisitʉ.<verse eid="GAL 3:14"/></para>
  <para style="s">Imigirʉ nʉ ʉbhʉragɨ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>Abhahiiri bhaanɨ, hinga nihuruchɨ ekerenjo kurwa mubhwikari bhwɨtʉ bhwa kɨrakabhu. Mwiseege igʉrʉ wa amiisiriranʼyʉ ga abhaatʉ bhabhɨrɨ. Amiisiriranʼyʉ garɨɨmarɨ kokorwa na kutuurwa ʉrʉkaamʉ, atareeho ʉmʉʉtʉ wa kwanga hamwɨ kwongera chʉchʉsi. <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>Mmbe, Mungu akahurucha ʉbhʉragɨ kwa Abhurahaamu, hamwɨmwɨ nu umwibhurwa waazɨ. Amaandɨkʉ Amarɨndu gatakubhuga, “Kubhiibhurwa bhaazɨ nkina bhaaru,” Nawe garabhuga, “Nu umwibhurwa waazɨ,”<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="xt" closed="false">Rora <ref loc="GEN 12:7">Ʉbhʉtangɨ 12:7</ref>.</char></note> enzobhooro yaku, nɨ‑wʉmwɨ, nawe ni‑Kiriisitʉ. <verse eid="GAL 3:16"/><verse number="17" style="v" sid="GAL 3:17"/>Rɨnʉ nikwenda kʉgamba nɨ‑rɨnʉ, Mungu akakora ʉbhʉragɨ<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="fk" closed="false">Ʉbhʉragɨ</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> bhwazɨ bhʉnʉ aamɨnyɨɨkɨrɨɨryɨ imyaka magana ane ne emerongo ɨtatʉ, hanʉ imigirʉ ja Musa jarɨ gɨkɨɨrɨ kʉbhaho. Imigirʉ giyo gɨtakʉtʉra kʉsarya ʉbhʉragɨ bhuyo nʉʉrʉ kuchʉra ʉbhʉragɨ bhuyo. <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>Nawe arɨɨbhɨ ʉbhʉgabhi bhwabhʉ kurwa kwa Mungu bhuriisega imigirʉ, mmbe ʉbhʉgabhi bhuyo bhʉtakʉtʉra naatu kwisega ʉbhʉragɨ bhwa Mungu. Nawe Mungu, kʉrʉbhangʉ rwazɨ, akaha Abhurahaamu ʉbhʉgabhi kʉnzɨra yʉ ʉbhʉragɨ bhwazɨ.<verse eid="GAL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>Nangʉ, imigirʉ gɨna meremokɨ? Imigirʉ gekoongerwa igʉrʉ wu ukwerecha ʉbhʉsarya bhwa abhaatʉ, kuhika hanʉ araazɨ umwibhurwa wa Abhurahaamu, wʉnʉ Mungu aaragɨɨnʼyɨ kʉbha araaza. Imigirʉ giyo, Mungu akamoha Musa<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="fk" closed="false">Musa</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> kʉhɨtɨra bhamaraika, Musa akabha umwigwanʼya wa abhaatʉ na Mungu. <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>Umwigwanʼya aheenderwa hanʉ zɨmbaara ibhɨrɨ zikurya iringʼa. Nawe Mungu nɨ‑wʉmwɨ, akarya iringʼa umwene na Abhurahaamu.<verse eid="GAL 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>Nangʉ, imigirʉ gɨrahakaana nʉ ʉbhʉragɨ bhwa Mungu? Zɨyi! Angabhɨɨrɨ gihurukibhwɨ imigirʉ gɨnʉ gɨkʉtʉra kʉbhaha abhaatʉ ʉbhʉhʉru, mmbe twarɨ tʉrabharwa bhe eheene mʉbhʉtangɨ bhwa Mungu ku ukugwata imigirʉ. <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>Nawe ɨtarɨbhu. Amaandɨkʉ Amarɨndu garabhuga, ɨɨsɨ yʉʉsi ɨgwatirwɨ mʉbhʉkangati bhwʉ ʉbhʉbhɨ, korereke bhanʉ bhiisiriiryɨ Yɨɨsu Kiriisitʉ bhahaanwɨ ʉbhʉragɨ bhʉnʉ Mungu aarɨ aragɨɨnʼyɨ.<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>Hanʉ ribhaga ryu ukwisirirya Yɨɨsu Kiriisitʉ ryarɨ rɨkɨɨrɨ kuhika, twarɨ turiimiiririrwa ni imigirʉ ja Musa, ncha abhabhohwa. Twarɨ tʉrarɨnda ribhaga rɨnʉ ubhwisirirya bhuyo bhuhumbwirwɨ. <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>Kwɨbhu imigirʉ jarɨ gɨratʉkangata, kuhika hanʉ Kiriisitʉ iizirɨ, korereke tʉbharirwɨ eheene mʉbhʉtangɨ bhwa Mungu kʉnzɨra yu ubhwisirirya. <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>Nawe nangʉ, kʉ kʉbha ubhwisirirya bhuhikirɨ, tʉtarɨ naatu iyaasɨ wi imigirʉ. <verse eid="GAL 3:25"/><verse number="26" style="v" sid="GAL 3:26"/>Nangʉ imwɨ bhʉʉsi, nɨ‑bhaana bha Mungu kubhwisirirya bhwanyu, kʉ kʉbha mugwatɨɨnɨ na Yɨɨsu Kiriisitʉ. <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>Imwɨ bhʉʉsi bhanʉ mʉbhatiizirwɨ, mugwatɨɨnɨ na Kiriisitʉ. <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>Nangʉ, kʉtareeho kwahʉkanʼya gatɨ wʉ Ʉmʉyaahudi na wʉnʉ atarɨ Ʉmʉyaahudi, mbʉʉsa nu umwiyagaaruri, umusubhɨ nʉ ʉmʉkari. Bhʉʉsi mʉrɨngʼɨɨnɨ, kʉ kʉbha mugwatɨɨnɨ na Yɨɨsu Kiriisitʉ. <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>Imwɨ, nɨ‑bha Kiriisitʉ, na kʉnzɨra yiyo mʉbhɨɨrɨ urwibhʉrʉ rwa Abhurahaamu, na mʉrasʉngʼaana ʉbhʉgabhi bhʉnʉ Mungu aaragɨɨnʼyɨ.<verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>Mmbe, ringʼana rɨnʉ nikwenda kʉbhabhʉʉrɨra nɨ‑kʉbha, wʉwʉʉsi wʉnʉ akʉgabha ebhegero bhya wiisɨ akɨɨrɨ mwana, atakɨrɨɨnɨ na mbʉʉsa, nangabha ebhegero bhyʉsi ibhyazɨ. <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>Ribhaga ryʉsi, ʉmʉgabhi ahaabha ari iyaasɨ wa abharɨri na abhaatʉ bhanʉ bhakwimɨɨrɨrɨra ebhegero bhyazɨ, kuhika ribhaga rɨnʉ wiisɨ ɨɨndirɨ. <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>Na niitwɨ ɨbhuɨbhu, ribhaga rɨnʉ Kiriisitʉ aarɨ akɨɨrɨ kuuza, twarɨ ncha abhaana, twarɨ bhambʉʉsa bhi isimʉka yɨnʉ ɨkʉkangata ɨɨsɨ.<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="fk" closed="false">Isimʉka yɨnʉ ɨkʉkangata ɨɨsɨ</char><char style="ft" closed="false">, ʉbhʉgaruri ʉbhʉndɨ bhʉratʉra kʉbha, </char><char style="fqa" closed="false">amasambwa ganʉ gakʉkangata ɨɨsɨ. </char><char style="ft" closed="false">Nɨmbu ɨrɨ nʉ ʉrʉkɨrɨrɨ </char><char style="xt"><ref loc="GAL 4:9">4:9</ref></char>.</note> <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>Nawe hanʉ ryahikirɨ ribhaga rɨnʉ ryatɨɨrwɨ, Mungu akatʉma Umwana waazɨ kʉʉsɨ, akiibhurwa nʉ ʉmʉkari, mumigirʉ ja Musa. <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>Akatumwa asabhʉrɨ bhanʉ twarɨ bhambʉʉsa bhi imigirʉ ja Musa, korereke itwʉsi tʉbhɨ abhaana bha Mungu.<verse eid="GAL 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6"/>Mungu akatʉma Ekoro yu Umwana waazɨ mumyʉyʉ jɨtʉ, kʉ kʉbha nɨ‑bhaana bhaazɨ tʉrɨ. Ekoro yiyo neyo ikugirya tʉbhɨrɨkɨrɨ Mungu, “Bhaabha.” <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>Nangʉ imwɨ mʉtarɨ bhambʉʉsa naatu, nawe nɨ‑bhaana bha Mungu. Na kʉ kʉbha nɨ‑bhaana, Mungu arabhagabhya.<verse eid="GAL 4:7"/></para>
  <para style="s">Paaurʉ arabhahama Abhagaraatiya</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>Ɨkarɨ hanʉ mwarɨ mʉtɨɨzɨ Mungu, mwarɨ bhambʉʉsa bha amasambwa ganʉ gatarɨ Mungu. <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>Nawe nangʉ, mumwɨzɨ Mungu, wʉʉsi abhɨɨzɨ bhʉkʉngʼu. Kwakɨ moreenda kʉgarʉka kosengera isimʉka yɨnʉ ɨkʉkangata ɨɨsɨ, yɨnʉ ɨtaana ʉbhʉnaja nu ubhwera bhwʉbhwʉsi? Moreenda kʉbha bhambʉʉsa bhaabhʉ? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>Mʉkɨɨrɨ mʉragwata zisigukuru zɨ Ɨkɨyaahudi? Mʉragwata zisikʉ zi imyɨri na zu umwaka, kʉbha ni‑zisigukuru zʉ ʉkʉsʉʉka Mungu? <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>Nɨrʉʉbhaha hamwɨ emeremo gɨnʉ nakʉrirɨ igʉrʉ waanyu, girimiirɨ bhʉʉha. <verse eid="GAL 4:11"/><verse number="12" style="v" sid="GAL 4:12"/>Abhahiiri bhaanɨ, nɨrabhasabha mʉbhɨ bhu ubhwiyagaaruri ncha niinyɨ, kʉ kʉbha na niinyɨ ɨkarɨ naarɨ nangi imwɨ.</para>
  <para style="p" vid="GAL 4:12">Hanʉ naarɨ hamwɨmwɨ na niimwɨ, mʉtankʉrɨɨrɨ ʉbhʉbhɨ bhwʉbhwʉsi. <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>Mwɨzɨ kʉbha, ubhurwɨrɨ bhʉnʉ naarɨ nabhwɨ, nebhwe bhwagiriryɨ nɨkabhona umweya gu ukubharwazɨra Ɨngʼana Ɨnzʉmu. <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>Nangabha nɨkarorekanabhu, mʉtaandɨgirɨ naabha kʉnyanga. Nawe kɨnʉ mwakʉrirɨ ni‑kunyiisirirya chɨmbu mwangiisiriiryɨ maraika wa Mungu, hamwɨ kwisirirya Yɨɨsu Kiriisitʉ. <verse eid="GAL 4:14"/><verse number="15" style="v" sid="GAL 4:15"/>Ribhaga rirya mwarɨ no obhozomerwa, nangʉ kɨbhʉnɨkirɨkɨ? Nɨragamba amaheene kʉbha, ribhaga rirya mwangaturirɨ kwiha amɨɨsʉ gaanyu na kongʼa. <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>Awɨɨ nangʉ, nɨbhɨɨrɨ umubhisa waanyu kʉ kʉbhabhʉʉrɨra amaheene?<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>Abhaatʉ abhandɨ bhayo bharakaja kʉbhanyaakɨra, nawe kɨnʉ bhakʉbhamoherya kɨtarɨ kɨzʉmu. Bhareenda kʉbhataanʼya na niinyɨ, korereke mʉbhanyaakɨrɨ ebho. <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>Maheene ni‑ngʼana izʉmu kʉbhanyaakɨra abhandɨ sikʉ zʉʉsi kʉmangʼana amazʉmu. Mokorebhu nʉʉrʉ hanʉ nɨkʉbha nɨtarɨ hamwɨmwɨ na niimwɨ. <verse eid="GAL 4:18"/><verse number="19" style="v" sid="GAL 4:19"/>Abhaana bhaanɨ, nirumirwɨ naatu ʉbhʉsʉngʉ igʉrʉ waanyu, chɨmbu ʉmʉkari wɨ ɨnda ahaarumwa ʉbhʉsʉngʉ. Niriiyigwa ɨbhuɨbhu, kuhika hanʉ eteemwa ya Kiriisitʉ ɨraarorekanɨ mozeteemwa zaanyu. <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>Nangabhɨɨrɨ hamwɨmwɨ na niimwɨ nangwɨnʉ, hamwɨ naarɨ nɨragamba na niimwɨ kwa bhʉnyʉʉhu. Nɨna makɨbhwɨ igʉrʉ waanyu!<verse eid="GAL 4:20"/></para>
  <para style="s">Ekerenjo cha Hajira na Saara</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>Mʉmbʉʉrɨrɨ bhanʉ mukwenda kwikara iyaasɨ wi imigirʉ ja Musa, mʉtɨɨzɨ chɨmbu imigirʉ gikubhuga? <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>Yandikirwɨ mʉMaandɨkʉ Amarɨndu kʉbha, Abhurahaamu aarɨ na abhaana bhabhɨrɨ. Ʉwʉmwɨ akiibhʉra na mbʉʉsa waazɨ Hajira, nʉ ʉwʉndɨ akiibhʉra na Saara mʉkaazɨ we ebhegero. <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>Umwana wa mbʉʉsa akiibhurwa kʉsɨɨmi ya abhaatʉ. Nawe umwana wa mʉkaazɨ we ebhegero, ewe akiibhurwa kʉbhʉragɨ bhwa Mungu.<verse eid="GAL 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24"/>Abhakari bhayo bharatʉra kogegwa nche ebherenjo bhyʉ ʉbhʉragɨ. Hajira, ne‑kerenjo chʉ ʉbhʉragɨ bhwe embere rɨnʉ ryakʉrirwɨ kʉkɨgʉrʉ cha Sinayi. Abhaana bhaazɨ bhakiibhurwa ncha bhambʉʉsa iyaasɨ wi imigirʉ ja Musa. <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>Abhaatʉ bha Yɨrusarɨɨmu bha nangwɨnʉ, nɨ‑bhambʉʉsa iyaasɨ wi imigirʉ ja Musa. Bhayo nɨ‑bhambʉʉsa ncha abhaana bha Hajira wʉnʉ akutuubhanibhwa nʉ ʉbhʉragɨ bhʉnʉ Mungu aakʉrirɨ kʉkɨgʉrʉ cha Sinayi mucharʉ cha Arabhiya. <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>Nawe Saara ariimɨɨrɨra kʉbha ʉrʉbhɨri rwa Yɨrusarɨɨmu mwisaarʉ, nɨ‑rʉbhɨri rʉnʉ runu ubhwiyagaaruri, na ruyo nerwe yiiya wɨɨtʉ itwɨ. <verse eid="GAL 4:26"/><verse number="27" style="v" sid="GAL 4:27"/>Yandikirwɨ MʉMaandɨkʉ Amarɨndu igʉrʉ waazɨ,</para>
  <para style="q" vid="GAL 4:27">“Zomerwa, awɨ ʉmʉgʉmba wʉnʉ ʉtakʉtʉra kwibhʉra,</para>
  <para style="q" vid="GAL 4:27">tiirya riraka wʉnʉ ʉkɨɨrɨ kwigwa ʉbhʉsʉngʉ bhu ukwitʉʉranʼya umwana,</para>
  <para style="q" vid="GAL 4:27">kʉ kʉbha abhaana bha wʉnʉ aarɨ atigirwɨ umwene nɨ‑bhaaru,</para>
  <para style="q" vid="GAL 4:27">kʉkɨra wʉnʉ aarɨ nu umusubhɨ waazɨ.”<note caller="+" style="f"><char style="fr" closed="false">4:27 </char><char style="xt" closed="false">Rora <ref loc="ISA 54:1">Isaaya 54:1</ref>.</char></note><verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>Mmbe, nangʉ abhahiiri bhaanɨ, imwɨ nɨ‑bhaana kurwa kʉ ʉbhʉragɨ bhwa Mungu, chɨmbu Iisaka aarɨ. <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>Nawe zisikʉ zirya, umwana wʉnʉ iibhwirwɨ kʉsɨɨmi ya abhaatʉ, akanyaacha umwana wʉnʉ iibhwirwɨ kʉbhʉnaja bhwe Ekoro Ɨndɨndu. Na sikʉ zɨnʉ hʉʉsi nɨmbu ɨrɨ. <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>Nawe Amaandɨkʉ Amarɨndu garabhugabhwɨ? Garabhuga, “Heebha ʉmʉkari mbʉʉsa hamwɨmwɨ nu umwana waazɨ, kʉ kʉbha umwana wa mbʉʉsa, atakʉtʉra kʉgabha hamwɨmwɨ nu umwana wʉ ʉmʉkari we ebhegero.”<note caller="+" style="f"><char style="fr" closed="false">4:30 </char><char style="xt" closed="false">Rora <ref loc="GEN 21:10">Ʉbhʉtangɨ 21:10</ref>.</char></note> <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>Abhahiiri bhaanɨ, itwɨ tʉtarɨ abhaana bha mbʉʉsa, nawe nɨ‑bhaana bhʉ ʉmʉkari we ebhegero.<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s">Ubhwiyagaaruri bhu Umukiriisitʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>Kiriisitʉ atʉhɨɨrɨ ubhwiyagaaruri korereke twikarɨ mubhwiyagaaruri. Nangʉ mwimɨɨrɨrɨ bhwɨma, mutiisirirya kʉgarʉka naatu mʉbhʉmbʉʉsa bhwi imigirʉ. <verse eid="GAL 5:1"/><verse number="2" style="v" sid="GAL 5:2"/>Mwitegeerere kɨnʉ inyɨ Paaurʉ nɨkʉbhabhʉʉrɨra! Arɨɨbhɨ muriisirirya kʉsaarwa igʉrʉ wu ukugwata imigirʉ ja Musa, Kiriisitʉ atakʉbha na bhwera bhwʉbhwʉsi kwa niimwɨ. <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>Nɨrabhabhʉʉrɨra naatu, umusubhɨ wʉwʉʉsi wʉnʉ akwisirirya kʉsaarwa, areenderwa kugwata imigirʉ jʉsi ja Musa. <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>Arɨɨbhɨ muriisega kʉbharwa kʉbha abhaatʉ bhe eheene mʉbhʉtangɨ bhwa Mungu ku ukugwata imigirʉ, momenye kʉbha mwiyahwirɨ kwa Kiriisitʉ, na mutigirɨ ɨbhɨgʉngi bhya Mungu. <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>Nawe Ekoro Ɨndɨndu ɨratʉnaja itwɨ kwisega tʉrabharirwa eheene kʉnzɨra yu ubhwisirirya. <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>Mmbe arɨɨbhɨ tugwatɨɨnɨ na Yɨɨsu Kiriisitʉ, kʉsaarwa hamwɨ kʉtama kʉsaarwa kʉtaana bhwera bhwʉbhwʉsi. Ekegero chu ubhwera nu‑bhwisirirya bhʉnʉ bhokokora emeremo kʉbhʉsɨɨgi.<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>Imwɨ mwarɨ mʉraja bhwaheene! Nangʉ nɨ‑wɨɨwɨ abharɨchiryɨ mʉtagwata amaheene? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>Ʉbhʉkʉrʉkʉmbi bhuyo bhʉtaruurɨ kwa Mungu wʉnʉ abhabhirikiirɨ. <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>Nawe momenye, “Ubhutunduuru bhusuuhubhu bhʉratunduurya riigiri ryʉsi!”<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">Enzobhooro yaku nɨ‑kʉbha amiija gʉ ʉrʉrɨmɨ ga abhaatʉ bhasuuhu, garakangirirya abhaatʉ bhaaru.</char></note> <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>Nɨna amaheene kʉbha imwɨ mʉragwatana nʉ Ʉmʉkʉrʉ Yɨɨsu, kwɨbhu mʉtakwisirirya kʉkangiribhwa. Nawe ʉmʉʉtʉ wʉwʉʉsi wʉnʉ araabhanyaachɨ, aratinirwa.<verse eid="GAL 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11"/>Abhahiiri bhaanɨ, arɨɨbhɨ nɨkɨɨrɨ nɨrarwaza kʉbha ereenderwa kʉsaarwa, kwakɨ nangʉ Abhayaahudi bharaanyaacha? Angabhɨɨrɨ nɨmbu, ubhurwazi bhwanɨ igʉrʉ wʉ ʉmʉsarabha gwa Kiriisitʉ bhʉtaarɨ bhʉragirya bhanyiigatanɨrɨ. <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>Niriigomba bhanʉ bhakʉbhanyaacha kʉmangʼana gɨ ɨsaarʉ, bhangiitinirɨ abheene!<verse eid="GAL 5:12"/></para>
  <para style="s">Ukwikara kʉbhʉnaja bhwe Ekoro Ɨndɨndu</para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>Abhahiiri bhaanɨ, mubhirikiirwɨ korereke mʉbhɨ bhu ubhwiyagaaruri. Nawe ubhwiyagaaruri bhwanyu bhʉtagirya mutunɨ isimʉka yʉ ʉbhʉbhɨ, nawe mwisakiryɨ kʉbhʉsɨɨgi. <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>Imigirʉ jʉsi ja Musa giri mwiswaja rɨmwɨ rɨnʉ, “Ʉmʉsɨɨgɨ nyarʉbhɨri waazʉ chɨmbu wisɨɨgirɨ.”<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="xt" closed="false">Rora <ref loc="LEV 19:18">Abharaawi 19:18</ref>.</char></note> <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>Nawe arɨɨbhɨ muriirya amatimba, mwangarɨrɨ mʉtaaza kwiricha imubheene ko bheene.<verse eid="GAL 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>Mmbe, nɨrabhabhʉʉrɨra, mʉbhɨ mʉrakangatwa ne Ekoro Ɨndɨndu. Moreekorebhu, mʉtakutuna naatu isimʉka yʉ ʉbhʉbhɨ. <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>Nɨrabhabhʉʉrɨra, ku riyo bhyʉsi bhɨnʉ ʉmʉbhɨrɨ gukwigomba, bhɨtarɨ chɨmbu Ekoro Ɨndɨndu ikwenda, na chɨmbu Ekoro Ɨndɨndu ikwenda, bhɨtarɨ chɨmbu ʉmʉbhɨrɨ gukwigomba. Ekoro Ɨndɨndu nʉ ʉmʉbhɨrɨ bhɨrahakaana, ku riyo mʉtakwenderwa kokora chʉchʉsi kɨnʉ mukwenda mokore. <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>Arɨɨbhɨ mʉrakangatwa ne Ekoro Ɨndɨndu, mʉtarɨ iyaasɨ wi imigirʉ.<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>Mmbe, amangʼana ganʉ gakokorwa igʉrʉ wi isimʉka yʉ ʉbhʉbhɨ nɨ‑ganʉ: ikisimbɨ, ɨtaarʉ, kokora amangʼana ga zɨsʉni, <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>kosengera amasambwa, ʉbhʉrʉgi, ubhubhisa, iryʉmana, rihari, ʉbhʉrʉrʉ, ɨkɨnyawɨɨtʉ, ʉbhʉtaamanʼya, ɨkɨmbʉrʉʉri, <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>engʼeera, ubhunywi, ʉmʉsʉʉhʉ na amangʼana agandɨ gʉʉsi ganʉ gatuubhɨɨnɨ na gayo. Nɨrabhabhʉʉrɨra chɨmbu namarirɨ kʉbhabhʉʉrɨra kʉbha, abhaatʉ bhanʉ bhakokora amangʼana gayo, bhatakʉgabha chʉchʉsi mʉbhʉtɨmi bhwa Mungu.<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="fk" closed="false">Ʉbhʉtɨmi bhwa Mungu</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note><verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>Nawe arɨɨbhɨ tʉrakangatwa ne Ekoro Ɨndɨndu, tʉrabha nu umusumʉ gwe Ekoro Ɨndɨndu. Umusumʉ guyo nɨ‑bhʉsɨɨgi, obhozomerwa, omorembe, ubhwigumirirya, ʉbhʉzʉmu, bhwerya koro, obhoronge, <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>ʉbhʉnyʉʉhu ne ekerengo. Gʉtareeho umugirʉ gʉnʉ gukwanga amangʼana ncha gayo. <verse eid="GAL 5:23"/><verse number="24" style="v" sid="GAL 5:24"/>Abhaatʉ bhanʉ bhagwatɨɨnɨ na Yɨɨsu Kiriisitʉ, bhatakuhirwa kɨbhɨ ni isimʉka yʉ ʉbhʉbhɨ, hamwɨmwɨ na amiisɨɨgi gaabhʉ amabhɨ, kʉ kʉbha bhagabhambirɨ kʉmʉsarabha gwa Yɨɨsu. <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>Turiikarɨ kubhwisɨgi bhwe Ekoro Ɨndɨndu, tutunɨ ʉbhʉkangati bhwazɨ. <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>Tutiikumya bhʉʉha, tutiimohyaku mangʼana na kwirorera rihari.<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s">Ukwiyangʉra na kokora amazʉmu</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>Abhahiiri bhaanɨ, mʉrangʼurɨ ʉmʉkɨndichanyu asariryɨ, imwɨ bhanʉ mʉkʉkangatwa ne Ekoro Ɨndɨndu, momoreche na mʉmʉgaruchɨ kwa bhʉnyʉʉhu. Nawe mwiyangarɨrɨ, mʉtaaza imwʉsi kogemwa. <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>Mwiyangʉrɨ imirigʉ, hayo neho mukuhicha imigirʉ ja Kiriisitʉ. <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>Mmbe, ʉmʉʉtʉ wʉwʉʉsi wʉnʉ akwirora ane enzobhooro kʉkɨra abhakɨndichazɨ, wuyo ataana nzobhooro yʉyʉʉsi, ariikangirirya umwene. <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>Itwʉsi torore zeteemwa zɨɨtʉ itubheene. Arɨɨbhɨ ʉmʉʉtʉ arakora amazʉmu, hayo aratʉra kwikumirya amangʼana amazʉmu ganʉ akʉrirɨ. Nawe atiirɨngʼaanʼya na amangʼana ganʉ ʉmʉʉtʉ ʉwʉndɨ akʉrirɨ, <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>kʉ kʉbha itwʉsi tʉragega imirigʉ jɨtʉ itubheene.<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>Ʉmʉʉtʉ wʉnʉ akwigibhwa ɨngʼana ya Mungu, amosondere umwija waazɨ ebhegero ɨbhɨzʉmu bhɨnʉ abhwɨnɨ. <verse eid="GAL 6:6"/><verse number="7" style="v" sid="GAL 6:7"/>Mutiikangirirya, Mungu atahaaregwa. Kɨnʉ ʉmʉʉtʉ akʉhamba, necho araagese. <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>Wʉnʉ akutuna isimʉka yʉ ʉbhʉbhɨ, aragesa ukurichwa kurwa kusimʉka yʉ ʉbhʉbhɨ. Nawe wʉnʉ akutuna Ekoro Ɨndɨndu, aragesa ʉbhʉhʉru bhwa kemerano kurwa kwe Ekoro Ɨndɨndu. <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>Na tʉtaniha kokora amazʉmu, kʉ kʉbha turiigumiriryɨ kokora amazʉmu, ribhaga rɨraahikɨ tʉragesa bhwaheene. <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>Mmbe, hanʉ toreebhone umweya, tokorere abhaatʉ bhʉʉsi amazʉmu, kɨnda abhiisirirya abhakɨndichɨtʉ.<verse eid="GAL 6:10"/></para>
  <para style="s">Ameerekenʼyʉ gʉ ʉkʉmariirya</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>Morore chɨmbu nandikirɨ amaandɨkʉ amakʉrʉ, kʉhɨtɨra okobhoko kwanɨ inyimwene. <verse eid="GAL 6:11"/><verse number="12" style="v" sid="GAL 6:12"/>Abhaatʉ bhayo bhakʉbhahatɨka imwɨ mʉsaarwɨ, korereke bhasuukwɨ na Abhayaahudi. Nebho bhakwenda bhatanyaakibhwa igʉrʉ wu ukurwaza ɨngʼana yu uruku rwa Kiriisitʉ kʉmʉsarabha. <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>Na bhanʉ bhasaarirwɨ abheene, bhatakugwata imigirʉ jʉsi. Kɨnʉ bhakwenda nɨ‑kʉbha imwɨ mʉsaarwɨ, korereke bhiikumiryɨ ɨsaarʉ yɨ ɨmɨbhɨrɨ janyu.<verse eid="GAL 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 6:14"/>Nawe inyɨ nɨtakwenda kwikumirya ingʼana ryʉryʉsi, kuruushaku uruku rwʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ kʉmʉsarabha. Kʉhɨtɨra uruku rwazɨ, amangʼana gʉʉsi gɨ ɨɨsɨ gataana nzobhooro kwa niinyɨ. Akuurɨ nu ubhwikari bhwanɨ bhwɨ ɨkarɨ kʉmʉsarabha. <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>Kʉsaarwa hamwɨ kʉtama kʉsaarwa, ɨtaana nzobhooro yʉyʉʉsi. Ekegero ɨkɨkʉrʉ ni kubhumbwa bhuhya na Mungu. <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>Omorembe nɨ ɨbhɨgʉngi bhɨbhɨ na abhaatʉ bhʉʉsi bhanʉ bhakokora amaheene gayo, bhayo nebho abharɨndu bha Mungu.<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="fk" closed="false">Bhayo nebho abharɨndu bha Mungu</char><char style="ft" closed="false">, ʉbhʉgaruri ʉbhʉndɨ bhʉratʉra kʉbha, </char><char style="fqa" closed="false">na Iziraɨri, abharɨndu bha Mungu.</char></note><verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>Mmbe kwɨma nangwɨnʉ ʉmʉʉtʉ wʉwʉʉsi atanyaacha, kʉ kʉbha inyɨ nɨna zɨkaamʉ kʉmʉbhɨrɨ gwanɨ igʉrʉ wo okohokerya Yɨɨsu. <verse eid="GAL 6:17"/><verse number="18" style="v" sid="GAL 6:18"/>Abhahiiri bhaanɨ, ɨbhɨgʉngi bhyʉ Ʉmʉkʉrʉ wɨɨtʉ Yɨɨsu Kiriisitʉ bhɨbhɨ hamwɨmwɨ na niimwɨ. Garamɨ.<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
