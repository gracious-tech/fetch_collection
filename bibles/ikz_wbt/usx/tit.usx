<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="TIT" style="id">‑ Ikizu Titus</book>
  <para style="h">Tiitʉ</para>
  <para style="toc3">Tiitʉ</para>
  <para style="toc2">Tiitʉ</para>
  <para style="toc1">Ɨnyarʉbha ya Paaurʉ kwa Tiitʉ</para>
  <para style="mt2">Ɨnyarʉbha ya Paaurʉ kwa</para>
  <para style="mt1">Tiitʉ</para>
  <para style="imt">Ʉbhʉkangati</para>
  <para style="ip">Ɨnyarʉbha yɨnʉ yandikirwɨ nu umutumwa Paaurʉ. Hanʉ aarɨ akɨɨrɨ kwandɨka ɨnyarʉbha yɨnʉ, Paaurʉ aarɨ arahocha emeremo ja Mungu hamwɨmwɨ na Tiitʉ mwiginga rya Kireete. Akʉmara akarwɨyʉ, akamara sikʉ suuhu, akamwandɨkɨra Tiitʉ ɨnyarʉbha yɨnʉ kʉmaswaja gʉʉsi igʉrʉ wu ukwimɨɨrɨrɨra abhiisirirya Kireete iyo.</para>
  <para style="ip">Mʉnyarʉbha yɨnʉ, Paaurʉ akaha Tiitʉ emeremo jo okorobhora abhiimiiririri bha risengerero. Kwikɨ akamwisasaama kʉbhakongʼya abhiisirirya bha Kireete, kʉ kʉbha bhaareho abhiija bhʉ ʉrʉrɨmɨ. Paaurʉ areerekeererya Tiitʉ igʉrʉ wʉ ʉkʉkangata amaribhita mwisengerero, abhakaruka, abhakari, abhamura na bhambʉʉsa. Mʉtɨnɨrʉ, arahiitya Tiitʉ kʉbha, Abhakiriisitʉ bhʉʉsi bhiikarɨ kwa morembe na koro nzɨrʉ na bhatabha bhaatʉ bha kwʉmana na kwiyaahʉra amaribhita.</para>
  <chapter number="1" style="c" sid="TIT 1"/>
  <para style="s">Amakeerenʼya</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1"/>Ɨnyarʉbha yɨnʉ nandikirɨ inyɨ Paaurʉ, omohocha wa Mungu, nu umutumwa<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fk" closed="false">Umutumwa</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora ringʼana </char><char style="it">abhatumwa</char> muKiniibhasa.</note> wa Yɨɨsu Kiriisitʉ. Nitumirwɨ igʉrʉ wu ukwerekeererya abhaatʉ bhanʉ bharʉbhwɨrwɨ na Mungu, korereke bhabhone ukumwisirirya nu ukwobhoora amaheene. Amaheene gayo garabhakangata ku ukwikara chɨmbu Mungu akwenda, <verse eid="TIT 1:1"/><verse number="2" style="v" sid="TIT 1:2"/>na amaheene garabhaha ubhwisɨgi bhwʉ ʉbhʉhʉru bhwa kemerano. Mungu akaraganʼya ʉbhʉhʉru bhuyo icharʉ kɨkɨɨrɨ koteemwa, neewe atakʉtʉra kʉgamba rʉrɨmɨ. <verse eid="TIT 1:2"/><verse number="3" style="v" sid="TIT 1:3"/>Nangʉ, ni‑ribhaga rɨnʉ Mungu ɨndirɨ kwerecha habhwɨrʉ Ɨngʼana yaazɨ Ɨnzʉmu. Nɨ‑kwa riswaja rya Mungu Ʉmʉsabhuri wɨɨtʉ kʉbha, nɨhɨɨrwɨ emeremo jʉ ʉkʉraganʼya ɨngʼana yiyo.<verse eid="TIT 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4"/>Nɨrakwandɨkɨra awɨ Tiitʉ, umwana waanɨ wa amaheene mubhwisirirya bhʉnʉ tukugwatana hamwɨmwɨ.</para>
  <para style="p" vid="TIT 1:4">Ɨbhɨgʉngi no omorembe kurwa kwa Bhaabha Mungu, na kwa Yɨɨsu Kiriisitʉ Ʉmʉsabhuri wɨɨtʉ, bhɨbhɨ na naawɨ.<verse eid="TIT 1:4"/></para>
  <para style="s">Emeremo ja Tiitʉ mwiginga rya Kireete</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5"/>Hanʉ naruurɨ Kireete iyo, nɨkakutiga awɨ korereke ʉtʉʉrɨ bhwaheene amangʼana agandɨ ganʉ gasaagirɨ, hamwɨmwɨ na korobhora abhiimiiririri bha risengerero mʉzɨmbɨri zʉʉsi, chɨmbu nakwɨrɨkɨrɨɨryɨ.<verse eid="TIT 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 1:6"/>Umwimiiririri wa risengerero, areenderwa kʉbha ʉmʉʉtʉ wʉnʉ ataana isoro. Abhɨ nʉ ʉmʉkari wʉmwɨ, abhaana bhaazɨ bhabhɨ abhiisirirya, bhatabha bhasɨɨgʉ hamwɨ bhanʉ bhatakwigwa. <verse eid="TIT 1:6"/><verse number="7" style="v" sid="TIT 1:7"/>Umwimiiririri wa risengerero, ni‑mwangariri, areenderwa kʉbha ʉmʉʉtʉ wʉnʉ ataana isoro, kʉ kʉbha agwatiibhwɨ emeremo ja Mungu. Atabha ʉmʉʉtʉ wi ikitwɨ, atabha mwangʉ wa kwigatana, atabha munywi, atabha mwʉmani na atabha mʉsɨɨgi wa mpirya. <verse eid="TIT 1:7"/><verse number="8" style="v" sid="TIT 1:8"/>Nawe abhɨ mwerya wa koro, mʉsɨɨgi wa amazʉmu, we ekerengo, we eheene, ʉmʉrɨndu, wu kwiyiimɨɨrɨrɨra. <verse eid="TIT 1:8"/><verse number="9" style="v" sid="TIT 1:9"/>Abhɨ aragwata bhwaheene ɨngʼana ya amaheene, chɨmbu iigiibhwɨ. Hayo neho akʉtʉra kʉnaja abhaatʉ kumiija ga amaheene, na kʉbharecha bhanʉ bhakwanga amiija gayo.<verse eid="TIT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10"/>Nɨrakʉbhʉʉrɨrabhu kʉ kʉbha Kireete bhareho abhaatʉ bhaaru bhatamakwigwa, bharagamba amangʼana gataana bhwera, na nɨ‑bhakangirirya, kɨnda bhanʉ bharuriirɨ mʉnyangi ya Abhayaahudi. Abhaatʉ bhayo bharɨkibhwɨ kwija, <verse eid="TIT 1:10"/><verse number="11" style="v" sid="TIT 1:11"/>na bhararimirya abhaatʉ mumijɨ myaru. Bhariija amangʼana ganʉ gatakwenderwa, korereke bhabhone zimpirya kubhwɨndi bhʉbhɨ. <verse eid="TIT 1:11"/><verse number="12" style="v" sid="TIT 1:12"/>Ɨkarɨ kwarɨ nʉ ʉmʉrʉʉtɨrɨri wʉmwɨ, Mukireete wɨ ɨwaabhʉ, wʉnʉ aagambirɨ, “Abhakireete, nɨ‑bhabhɨɨhi sikʉ zʉʉsi, bhaangɨ ibhityɨnyi ɨbhɨbhɨ, bhanamba, bhatʉbhu.” <verse eid="TIT 1:12"/><verse number="13" style="v" sid="TIT 1:13"/>Ʉbhʉmɨnyɨɨkɨrɨri bhuyo nɨ‑maheene. Igʉrʉ wa riyo, ʉbhɨ ʉrabharecha kwa bhʉhaari abhaatʉ bhayo, korereke bhagwatɨ amiija ga amaheene. <verse eid="TIT 1:13"/><verse number="14" style="v" sid="TIT 1:14"/>Bhatigɨ kwitegeerera amaganʉ gɨ Ɨkɨyaahudi ganʉ gataana bhwera, na amaswaja ga abhaatʉ bhanʉ bhatigirɨ amaheene.<verse eid="TIT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 1:15"/>Kʉbhaatʉ bhu umwʉyʉ umwɨrʉ mʉbhʉtangɨ bhwa Mungu, ebhegero bhyʉsi bhɨbhɨngukiibhwɨ. Nawe, kʉbhaatʉ abhabhuruuru na abhatiisirirya, ebhegero bhyʉsi ni‑bhubhuruuru, kʉ kʉbha amiisɨɨgi gaabhʉ ne ekoro yaabhʉ, bhyizwirɨ ubhubhuruuru. <verse eid="TIT 1:15"/><verse number="16" style="v" sid="TIT 1:16"/>Bharabhuga abheene kʉbha bhamwɨzɨ Mungu, nawe amahocha gaabhʉ gareerekenʼya kʉbha bharamwanga. Bhayo nebho bhakubhiihirirwa, abhaangi, bhatakwenderwa kwingʼana ryʉryʉsi izʉmu.<verse eid="TIT 1:16"/></para>
  <chapter eid="TIT 1"/>
  <chapter number="2" style="c" sid="TIT 2"/>
  <para style="s">Amiija ga amaheene</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1"/>Nangʉ Tiitʉ awɨ, ʉbhɨ uriija abhaatʉ kʉrɨngʼaana na amiija ga amaheene. <verse eid="TIT 2:1"/><verse number="2" style="v" sid="TIT 2:2"/>Bhabhʉʉrɨrɨ abhakaruka, bhareenderwa kʉbha bhe ekerengo, bhasuuku na bha teemwa nzʉmu. Naatu bhabhɨ bhaheene bhu ubhwisirirya, kʉbhʉsɨɨgi na kubhwigumirirya.<verse eid="TIT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 2:3"/>Muyomuyo ʉbhabhʉʉrɨrɨ abhakɨkʉrʉ kʉbha, bhabhɨ ne eteemwa yɨnʉ ikumukumya Mungu. Bhatabha bhagʉbhi bha abhaatʉ, bhatabha bhanywi, nawe bhareenderwa kwija ubhwikari ʉbhʉzʉmu, <verse eid="TIT 2:3"/><verse number="4" style="v" sid="TIT 2:4"/>korereke bhabhɨ bhariija abhaacha kʉbhasɨɨga abhasubhɨ bhaabhʉ na abhaana bhaabhʉ. <verse eid="TIT 2:4"/><verse number="5" style="v" sid="TIT 2:5"/>Naatu abhaacha, bhabhɨ ne ekerengo, bhabhɨ bharonge, bhakore bhwaheene emeremo mumijɨ jabhʉ, bhabhɨ abhaatʉ abhazʉmu na bhʉ ʉkʉsʉʉka abhasubhɨ bhaabhʉ. Ʉbhabhʉʉrɨrɨ bhakorebhu, korereke ɨngʼana ya Mungu ɨtaregwa.<verse eid="TIT 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6"/>Na abhamura, ʉbhareche bhabhɨ bhe ekerengo. <verse eid="TIT 2:6"/><verse number="7" style="v" sid="TIT 2:7"/>Na naawɨ, mʉmangʼana gʉʉsi, ʉbhɨ ekerenjo chu ukwɨgwa kwabhʉ, ko kokora amazʉmu. Mumiija gaazʉ, werekenʼye amaheene nʉ ʉbhʉnagu. <verse eid="TIT 2:7"/><verse number="8" style="v" sid="TIT 2:8"/>Wiijɨ amiija ga amaheene korereke amiija gataririirirwa na abhaatʉ. Nʉʉrʉ ʉmʉʉtʉ areenda kʉgaanga, asʉʉkɨ, kʉ kʉbha atakʉbha ni ingʼana rya kʉtʉgamba kɨbhɨ.<verse eid="TIT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9"/>Ʉbhabhʉʉrɨrɨ bhambʉʉsa, kʉbha bhasʉʉkɨ abhakʉrʉ bhaabhʉ, bhabhazomere kwa gʉʉsi, bhatahakaana nabhʉ. <verse eid="TIT 2:9"/><verse number="10" style="v" sid="TIT 2:10"/>Naatu bhatiibha, nawe bhabhɨ bhaheene, korereke amahocha gaabhʉ gʉʉsi gakore abhandɨ bharutwɨ na amiija ga Mungu Ʉmʉsabhuri wɨɨtʉ.<verse eid="TIT 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11"/>Ʉbhɨ uriija amangʼana gayo, kʉ kʉbha Mungu ɨrɨkɨɨnʼyɨ ɨbhɨgʉngi bhyazɨ, ko koreeta ubhutuurya kʉbhaatʉ bhʉʉsi. <verse eid="TIT 2:11"/><verse number="12" style="v" sid="TIT 2:12"/>Ʉrʉbhangʉ ruyo, rʉratwija kwanga ʉbhʉbhɨ nu umwʉyʉ gwa kʉʉsɨ. Kwɨbhu hanʉ tʉkʉbha tʉkɨɨrɨ kʉʉsɨ yɨnʉ, tʉbhɨ bhe ekerengo, bhe eheene, na abhaatʉ bhanʉ bhakwikara ubhwikari bhu ukumukumya Mungu. <verse eid="TIT 2:12"/><verse number="13" style="v" sid="TIT 2:13"/>Twikarɨbhu, ɨnʉ turiisega urusikʉ rurya ʉrʉzʉmu rwʉ ʉkʉgarʉka kwa Yɨɨsu Kiriisitʉ. Urusikʉ ruyo ararorekana mʉbhʉkʉrʉ bhwazɨ. Ewe newe Mungu Ʉmʉkʉrʉ na nɨ‑Mʉsabhuri wɨɨtʉ. <verse eid="TIT 2:13"/><verse number="14" style="v" sid="TIT 2:14"/>Akiihurucha igʉrʉ wɨɨtʉ, korereke atʉsabhʉrɨ kurwa mʉbhʉbhɨ bhwʉsi. Akeenda kutwerya, korereke tʉbhɨ abhaatʉ bhaazɨ, bhanʉ bhanu umucha kokora amazʉmu.<verse eid="TIT 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15"/>Mmbe nangʉ, ʉbhɨ uriija amangʼana gayo gʉʉsi. Ʉhɨɨrwɨ ʉbhʉnaja bhwʉsi bhwʉ ʉkʉhaara no okorecha abhaatʉ. Ʉtaregwa na mʉʉtʉ wʉwʉʉsi wurya.<verse eid="TIT 2:15"/></para>
  <chapter eid="TIT 2"/>
  <chapter number="3" style="c" sid="TIT 3"/>
  <para style="s">Okokora amazʉmu</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1"/>Ʉbhɨ ʉrahiitya abhaatʉ kʉbha, bhasʉʉkɨ na kwigwa abhakangati na bhʉ ʉbhʉnaja. Bhiisiriryɨ kokora amangʼana amazʉmu gʉʉsi. <verse eid="TIT 3:1"/><verse number="2" style="v" sid="TIT 3:2"/>Ʉbhabhʉʉrɨrɨ bhatatʉka mʉʉtʉ wʉwʉʉsi, bhatabha bhʉʉmani, bhabhɨ bhanyʉʉhu na bhasuuku kʉbhaatʉ bhʉʉsi.<verse eid="TIT 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="TIT 3:3"/>Nʉʉrʉ itwɨ itubheene, ɨkarɨ hanʉ twarɨ tʉkɨɨrɨ kumwisirirya Yɨɨsu, twarɨ bhageege, bhaangi na tʉkakangiribhwa. Twarɨ bhambʉʉsa bhɨ ɨnamba yo okokora amabhɨ na zeteemwa zʉzʉʉsi za kʉʉsɨ. Ubhwikari bhwɨtʉ bhwarɨ bhwʉ ʉbhʉbhɨ na rihari. Abhaatʉ bhakatwigatanɨra itwʉsi tʉkabhabhiihirirwa. <verse eid="TIT 3:3"/><verse number="4" style="v" sid="TIT 3:4"/>Nawe Mungu, Ʉmʉsabhuri wɨɨtʉ, akatwerecha ʉbhʉzʉmu nʉ ʉbhʉsɨɨgi bhwazɨ, akatʉsabhʉra. <verse eid="TIT 3:4"/><verse number="5" style="v" sid="TIT 3:5"/>Ataatusabhwirɨ kʉ kʉbha ya amahocha gɨɨtʉ amazʉmu, nawe kʉ kʉbha yɨ ɨbhɨgʉngi bhyazɨ. Atʉbhɨngukiryɨ ʉbhʉbhɨ bhwɨtʉ, kukwibhurwa bhuhya nʉ ʉkʉbha nu ubhwikari ubhuhya kʉnzɨra ye Ekoro Ɨndɨndu.<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="fk" closed="false">Ekoro Ɨndɨndu</char><char style="ft" closed="false">. Kʉmaragɨrɨra bhʉkʉngʼu, rora Ikiniibhasa.</char></note> <verse eid="TIT 3:5"/><verse number="6" style="v" sid="TIT 3:6"/>Mungu akatwitɨrɨra ekoro yaazɨ kwa bhwaru, kʉhɨtɨra Yɨɨsu Kiriisitʉ, Ʉmʉsabhuri wɨɨtʉ. <verse eid="TIT 3:6"/><verse number="7" style="v" sid="TIT 3:7"/>Akakorabhu, na kʉtʉbharɨra kʉbha bhe eheene kʉnzɨra yɨ ɨbhɨgʉngi bhyazɨ, korereke tobhone kʉgabha ʉbhʉhʉru bhwa kemerano, chɨmbu ubhwisɨgi bhwɨtʉ bhʉrɨ.<verse eid="TIT 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="TIT 3:8"/>Amangʼana gayo, nɨ‑ga amaheene. Nereenda awɨ ʉgakandikijɨ, korereke bhʉʉsi bhanʉ bhamwisiriryɨ Mungu, bhagagwatɨ na kwikongʼeererya kokora amazʉmu. Amangʼana gayo nɨ‑mazʉmu, na ganu ubhwera kʉbhaatʉ bhʉʉsi. <verse eid="TIT 3:8"/><verse number="9" style="v" sid="TIT 3:9"/>Hamwɨmwɨ na gayo, ʉtaanɨ na zɨhaka ze ekegeege, zɨkɨrɨrɨ za amariina ga bhasʉʉkʉrʉ, iryʉmana na zɨhaka igʉrʉ wi imigirʉ ja Musa. Gayo gʉʉsi gataana bhwera bhwʉbhwʉsi. <verse eid="TIT 3:9"/><verse number="10" style="v" sid="TIT 3:10"/>Ʉmʉʉtʉ wʉnʉ akusiigirirya abhaatʉ, omoreche rwe embere na rwa kabhɨrɨ. Arɨɨbhɨ atakwigwa, umwangɨ. <verse eid="TIT 3:10"/><verse number="11" style="v" sid="TIT 3:11"/>Ʉramenya kʉbha ʉmʉʉtʉ ncha wuyo atigirɨ amaheene, ahaakora ʉbhʉbhɨ, itiniirɨ umwene.<verse eid="TIT 3:11"/></para>
  <para style="s">Amangʼana gʉ ʉkʉraga</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12"/>Nɨɨndirɨ nijɨ kwikara mʉrʉbhɨri rwa Nikʉpʉʉri, ribhaga rye embeho. Nawe nɨramʉtʉma Aritɨma hamwɨ Tikikʉ ɨwaazʉ. Ariihikɨ ɨwaazʉ, awɨ wangʉhɨ kuuza Nikʉpʉʉri turumanɨ. <verse eid="TIT 3:12"/><verse number="13" style="v" sid="TIT 3:13"/>Ikongʼeererya kʉsakirya Zeena, ʉmʉkaari wurya wi imigirʉ, na Apooro. Ʉbhahɨ bhyʉsi bhyʉ ʉkʉbhasakirya mʉnzɨra, bhatasuuhirwa kegero. <verse eid="TIT 3:13"/><verse number="14" style="v" sid="TIT 3:14"/>Abhiisirirya abhakɨndichɨtʉ bhʉʉsi, bhɨɨgɨ kwikongʼeererya kokora amazʉmu, korereke bhasakiryɨ bhu ubhwɨndi bhwa amaheene. Bhareekorebhu, ubhwikari bhwabhʉ bhʉtakʉbha bhʉʉha.<verse eid="TIT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15"/>Abhaatʉ bhʉʉsi bhanʉ bharɨ hamwɨmwɨ na niinyɨ hanʉ, bharakokeerya. Nangʉ awʉʉsi, ʉbhakeerye abhiisirirya abhasɨɨgwa bhʉʉsi.</para>
  <para style="p" vid="TIT 3:15">Ɨbhɨgʉngi bhya Mungu bhɨbhɨ hamwɨmwɨ na niimwɨ.<verse eid="TIT 3:15"/></para>
  <chapter eid="TIT 3"/>
</usx>
