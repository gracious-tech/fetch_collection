<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Open Basic Turkish New Testament</book>
  <para style="h">Matta</para>
  <para style="toc1">Mattaʼnın Müjdesi</para>
  <para style="toc2">Matta</para>
  <para style="toc3">Mat</para>
  <para style="mt1">Mattaʼnın Müjdesi</para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">İsa Mesihʼin soyu</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luka 3:23‑38</ref>)</para>
  <para style="lh">
    <verse number="1" style="v" sid="MAT 1:1"/>İbrahimʼin ve Davudʼun soyundan gelen İsa Mesihʼin<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fk" closed="false">İsa Mesihʼin </char><char style="ft" closed="false">Mesih Allahʼın Tevratʼta İsrail halkına söz verdiği kurtarıcıdır. Göreve atanmak için meshedilen yani üzerine zeytinyağı sürülen kişi demektir.</char></note> soy kaydı şöyledir:<verse eid="MAT 1:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2"/>İbrahim, İshakʼın babasıydı.</para>
  <para style="li1" vid="MAT 1:2">İshak, Yakubʼun babasıydı.</para>
  <para style="li1" vid="MAT 1:2">Yakub, Yahuda ve kardeşlerinin babasıydı.<verse eid="MAT 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 1:3"/>Yahuda, Tamarʼdan doğan Peres ve Zerahʼın babasıydı.</para>
  <para style="li1" vid="MAT 1:3">Peres, Hesronʼun babasıydı.</para>
  <para style="li1" vid="MAT 1:3">Hesron, Ramʼın babasıydı.<verse eid="MAT 1:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4"/>Ram, Amminadavʼın babasıydı.</para>
  <para style="li1" vid="MAT 1:4">Amminadav, Nahşonʼun babasıydı.</para>
  <para style="li1" vid="MAT 1:4">Nahşon, Salmonʼun babasıydı.<verse eid="MAT 1:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5"/>Salmon, Rahav tarafından Boazʼın babasıydı.</para>
  <para style="li1" vid="MAT 1:5">Boaz, Rut tarafından Ovedʼin babasıydı.</para>
  <para style="li1" vid="MAT 1:5">Oved, İşayʼın babasıydı.<verse eid="MAT 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6"/>İşay, Kral Davudʼun babasıydı.</para>
  <para style="b" vid="MAT 1:6"/>
  <para style="li1" vid="MAT 1:6">Davud, Uriyaʼnın karısından doğan Süleymanʼın babasıydı.<verse eid="MAT 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7"/>Süleyman, Rehavamʼın babasıydı.</para>
  <para style="li1" vid="MAT 1:7">Rehavam, Aviyaʼnın babasıydı.</para>
  <para style="li1" vid="MAT 1:7">Aviya, Asaʼnın babasıydı.<verse eid="MAT 1:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8"/>Asa, Yehoşafatʼın babasıydı.</para>
  <para style="li1" vid="MAT 1:8">Yehoşafat, Yehoramʼın babasıydı.</para>
  <para style="li1" vid="MAT 1:8">Yehoram, Uzziyaʼnın babasıydı.<verse eid="MAT 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9"/>Uzziya, Yotamʼın babasıydı.</para>
  <para style="li1" vid="MAT 1:9">Yotam, Ahazʼın babasıydı.</para>
  <para style="li1" vid="MAT 1:9">Ahaz, Hizkiyaʼnın babasıydı.<verse eid="MAT 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10"/>Hizkiya, Manaşeʼnin babasıydı.</para>
  <para style="li1" vid="MAT 1:10">Manaşe, Amonʼun babasıydı.</para>
  <para style="li1" vid="MAT 1:10">Amon, Yoşiyaʼnın babasıydı.<verse eid="MAT 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11"/>Yoşiya, Yekonya<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fk" closed="false">Yekonya </char><char style="ft" closed="false">Yehoyakin adının başka bir şeklidir.</char></note> ve kardeşlerinin babasıydı.</para>
  <para style="li1" vid="MAT 1:11">Bunlar, İsrail halkının Babilʼe sürüldüğü zaman doğdular.<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fk" closed="false">İsrail halkının Babilʼe sürüldüğü zaman </char><char style="ft" closed="false">Babil kralı Nebukadnezar İ.Ö. 586ʼda Yeruşalimʼi yani Kudüsʼü yerle bir etti ve Yahudi halkını Babilʼe sürdü.</char></note><verse eid="MAT 1:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="MAT 1:12"/>Yekonya, halk Babilʼe sürüldükten sonra doğan Şealtiyelʼin babasıydı.</para>
  <para style="li1" vid="MAT 1:12">Şealtiyel, Zerubbabilʼin babasıydı.<verse eid="MAT 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13"/>Zerubbabil, Avihudʼun babasıydı.</para>
  <para style="li1" vid="MAT 1:13">Avihud, Elyakimʼin babasıydı.</para>
  <para style="li1" vid="MAT 1:13">Elyakim, Azorʼun babasıydı.<verse eid="MAT 1:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14"/>Azor, Sadokʼun babasıydı.</para>
  <para style="li1" vid="MAT 1:14">Sadok, Ahimʼin babasıydı.</para>
  <para style="li1" vid="MAT 1:14">Ahim, Elihudʼun babasıydı.<verse eid="MAT 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15"/>Elihud, Elazarʼın babasıydı.</para>
  <para style="li1" vid="MAT 1:15">Elazar, Mattanʼın babasıydı.</para>
  <para style="li1" vid="MAT 1:15">Mattan, Yakubʼun babasıydı.<verse eid="MAT 1:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 1:16"/>Yakub, Meryemʼin kocası olan Yusufʼun babasıydı. Meryemʼden Mesih diye bilinen İsa doğdu.<verse eid="MAT 1:16"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="17" style="v" sid="MAT 1:17"/>Böylece İbrahimʼden Davudʼa kadar on dört kuşak, Davudʼdan İsrail halkının Babilʼe sürüldüğü zamana kadar da on dört kuşak vardır. Halkın Babilʼe sürüldüğü zamandan Mesihʼe kadar yine on dört kuşak vardır.<verse eid="MAT 1:17"/></para>
  <para style="s1">İsaʼnın doğumu</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luka 2:1‑7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>İsa Mesihʼin doğması şöyle oldu: Oʼnun annesi Meryem, Yusufʼla nişanlıydı.<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="fk" closed="false">Meryem, Yusufʼla nişanlıydı </char><char style="ft" closed="false">O zamanın adetlerine göre nişan eşlerini birbirine bağlardı. Nişanı bozmak ancak boşanmayla mümkündü.</char></note> Onlar birleşmeden önce Meryemʼin <char style="w" lemma="Kutsal Ruh">Kutsal Ruhʼtan</char> gebe olduğu anlaşıldı. <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>Meryemʼin nişanlısı Yusuf iyi bir adamdı. Meryemʼi halkın gözünde rezil etmek istemedi. Bunun için nişanı sessizce bozmak niyetindeydi.<verse eid="MAT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20"/>Yusuf tam bunu düşünürken, Rabbin bir meleği ona rüyada göründü. Ona, “Ey Davud oğlu Yusuf” dedi. “Meryemʼi karın olarak yanına almaktan korkma. Çünkü ondaki bebek Kutsal Ruhʼtandır. <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>O bir oğul doğuracak. Adını İsa<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="fk" closed="false">İsa </char><char style="ft" closed="false">“Rab kurtarır” anlamına gelen İbranice Yehoşua adının kısaltmasıdır.</char></note> koyacaksın. Çünkü halkını günahlarından O kurtaracak.”<verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>Bütün bunlar, Rabbin peygamber aracılığıyla söylediği şu söz yerine gelsin diye oldu:<verse eid="MAT 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23"/>“İşte bakire kız gebe kalacak, bir oğul doğuracak.</para>
  <para style="q2" vid="MAT 1:23">Oʼnun <char style="w" lemma="ad">adını</char> İmmanuel koyacaksınız.”<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 7:14">Yeşaya 7:14</ref></char></char></note></para>
  <para style="m" vid="MAT 1:23">İmmanuel, “Allah bizimle” demektir.<verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>Yusuf uykudan kalkınca, Rabbin meleğinin ona buyurduğu gibi yaptı. Meryemʼi karısı olarak yanına aldı. <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>Ama Meryem oğlunu doğurana kadar Yusuf onunla birleşmedi. Çocuğun <char style="w" lemma="ad">adını</char> İsa koydu.<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">Yıldızbilimcilerin gelişi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>İsa, Kral <char style="w" lemma="Hirodes">Hirodesʼin</char> zamanında, Yahudiyeʼdeki Beytlehem kasabasında doğdu. Bundan sonra yıldızbilimciler doğudan <char style="w">Yeruşalim</char> şehrine geldiler. <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>Şunu sordular: “Yahudilerin Kralı olarak doğan çocuk nerede? Çünkü onun yıldızının yükseldiğini gördük ve yere kapanarak ona saygı göstermeye geldik.”<verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>Bunu işitince, Kral <char style="w">Hirodes</char> ve onunla birlikte bütün Yeruşalim halkı telaşa düştü. <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>Kral bütün <char style="w" lemma="başrahipler">başrahipleri</char> ve halkın Tevrat uzmanlarını bir araya topladı. Onlardan Mesihʼin nerede doğacağını öğrenmek istedi. <verse eid="MAT 2:4"/><verse number="5" style="v" sid="MAT 2:5"/>Krala şunu söylediler: “Yahudiyeʼdeki Beytlehem kasabasında. Çünkü peygamber aracılığıyla şöyle yazılmıştır:<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>‘Sen, Yahuda topraklarında bulunan Beytlehem,</para>
  <para style="q2" vid="MAT 2:6">Yahuda liderleri arasında en önemsiz kasaba değilsin.</para>
  <para style="q1" vid="MAT 2:6">Çünkü halkım İsrailoğullarını güdecek lider senden çıkacak.’ ”<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="MIC 5:2">Mika 5:2</ref></char></char></note><verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>Ondan sonra <char style="w">Hirodes</char> gizlice yıldızbilimcileri çağırdı. Yıldızın onlara tam olarak ne zaman göründüğünü sordu. <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>Sonra onları Beytlehemʼe gönderirken şunları söyledi: “Oraya varınca çocuğu dikkatle arayın. Bulduktan sonra bana haber yollayın. Ben de gelip yere kapanarak ona saygı göstereyim.”<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9"/>Yıldızbilimcileri kralı dinledikten sonra yola çıktılar. Yükselişini gördükleri aynı yıldız onların önünden gitti. En sonunda çocuğun bulunduğu evin üstünde durdu. <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>Yıldızı görünce olağanüstü büyük bir sevinç duydular. <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>Eve girip çocuğu ve annesi Meryemʼi gördüler. Yere kapanıp çocuğa saygı gösterdiler. Sandıklarını açıp Oʼna hediyeler verdiler. Bunlar altın ve günnük<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fk" closed="false">Günnük </char><char style="ft" closed="false">Tütsü için kullanılan bir çeşit ağaç sakızı.</char></note> ile mür<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fk" closed="false">Mür </char><char style="ft" closed="false">Cesetleri gömülmeye hazırlamak için kullanılan bir hoş koku.</char></note> denen değerli kokulardı. <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>Allah onları bir rüyada <char style="w" lemma="Hirodes">Hirodesʼin</char> yanına dönmemeleri için uyardı. Bu sebeple memleketlerine başka yoldan döndüler.<verse eid="MAT 2:12"/></para>
  <para style="s1">Mısırʼa kaçış</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>Yıldızbilimciler gittikten sonra, Rabbin bir meleği rüyada Yusufʼa göründü ve ona şöyle dedi: “Kalk, çocuğu ve annesini al. Mısırʼa kaç. Ben sana haber verene kadar orada kal. Çünkü <char style="w">Hirodes</char> bu çocuğu öldürmek istiyor. Yakın zamanda onu aramak için adamlar gönderecek.”<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14"/>Yusuf geceleyin kalkıp çocuğu ve annesini aldı ve Mısırʼa gitmek için yola çıktı. <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/><char style="w">Hirodes</char> ölünceye kadar orada kaldı. Böylece Rabbin, peygamberin ağzıyla söylediği şu söz yerine geldi: “<char style="w" lemma="Oğul">Oğlumu</char> Mısırʼdan geri çağırdım.”<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 11:1">Hoşeya 11:1</ref></char></char></note><verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>
    <char style="w">Hirodes</char> yıldızbilimcilerin onu aldattığını anlayınca, öfkeden kudurdu. Kral çocuğun doğduğu zamanı yıldızbilimcilerden öğrenmişti. Bu yüzden hemen askerler gönderip Beytlehem ve çevresindeki köylerde iki yaşından küçük bütün erkek çocukları öldürttü. <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>Böylece Allahʼın Yeremya Peygamberʼin ağzıyla söylediği şu söz yerine gelmiş oldu:<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>“Ramaʼda bir ses işitildi,</para>
  <para style="q2" vid="MAT 2:18">ağlama ve acı bir feryat sesi.</para>
  <para style="q1" vid="MAT 2:18">Rahel, çocukları için ağlıyor.</para>
  <para style="q2" vid="MAT 2:18">Avutulmak istemiyor,</para>
  <para style="q2" vid="MAT 2:18">çünkü onlar yok oldular.”<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:15">Yeremya 31:15</ref></char></char></note><verse eid="MAT 2:18"/></para>
  <para style="s1">Nasıraʼya dönüş</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>
    <char style="w">Hirodes</char> öldükten sonra Rabbin bir meleği Yusufʼa rüyada göründü. Yusuf daha Mısırʼdaydı. <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>Melek ona şöyle dedi: “Kalk, çocuğu ve annesini al ve İsrail topraklarına dön. Çünkü çocuğun canını almak isteyenler öldü.”<verse eid="MAT 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21"/>Yusuf kalktı, çocuğu ve annesini aldı ve İsrail topraklarına döndü. <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>Ama <char style="w" lemma="Hirodes">Hirodesʼin</char> yerine oğlu Arhelasʼın Yahudiye kralı olduğunu işitti. O zaman Yusuf oraya dönmeye korktu. Allah tarafından bir rüyada uyarılınca, Celile topraklarına çekildi. <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>Gidip Nasıra denilen bir kasabaya yerleşti. Böylece peygamberlerin aracılığıyla söylenen “Oʼna Nasıralı diyecekler” sözü yerine geldi.<verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">Yahya yolu hazırlıyor</para>
  <para style="r">(<ref loc="MRK 1:2-8">Markos 1:2‑8</ref>; <ref loc="LUK 3:1-18">Luka 3:1‑18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>Bir süre sonra Vaftizci Yahya Yahudiyeʼnin ıssız yerlerine gidip vaaz etmeye başladı. <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>Şöyle diyordu: “Tövbe edin, çünkü Göklerin Krallığı<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fk" closed="false">Göklerin Krallığı </char><char style="ft" closed="false">Allahʼın Krallığı anlamındadır.</char></note> yaklaştı.” <verse eid="MAT 3:2"/><verse number="3" style="v" sid="MAT 3:3"/>Allahʼın Peygamber Yeşaya aracılığıyla haber verdiği kişi Yahyaʼdır. Yeşaya şöyle demişti:</para>
  <para style="q1" vid="MAT 3:3">“Issız yerlerde sesini yükselten biri,</para>
  <para style="q1" vid="MAT 3:3">‘Rabbin yolunu hazırlayın,</para>
  <para style="q2" vid="MAT 3:3">geçeceği yerleri düz yapın!’ diyor.”<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3">Yeşaya 40:3</ref></char></char></note><verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>Yahya deve tüyünden elbise giyerdi ve belinde deriden bir kayış vardı. Yemek olarak çekirge ve yaban balı yerdi. <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>O vakit <char style="w" lemma="Yeruşalim">Yeruşalimʼden</char> bütün Yahudiyeʼden ve Şeria<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="fk" closed="false">Şeria </char><char style="ft" closed="false">Celile Gölüʼne akıp oradan da Lut Gölüʼne dökülen nehir. Ürdün ve Yordan olarak da tanınır.</char></note> ırmağının çevresinden halk ona akın etti. <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>Onlar günahlarını açıkça söyleyip Yahyaʼnın eliyle <char style="w">Şeria</char> ırmağında <char style="w">vaftiz</char> oldular.<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>
    <char style="w" lemma="Ferisiler">Ferisilerden</char> ve <char style="w" lemma="Sadukiler">Sadukilerden</char> de bir sürü kişi <char style="w">vaftiz</char> olmak için Yahyaʼya geldi. Yahya bunu görünce onlara şöyle dedi: “Ey yılan soyu!<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="fk" closed="false">Ey yılan soyu! </char><char style="ft" closed="false">Onların yılan gibi akıllı ve zararlı olduğuna işaret eder.</char></note> Allahʼın vereceği cezadan kaçabileceğinizi kim söyledi? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>Bunun için tövbenize layık meyve verin. <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>Kendi kendinize, ‘Atamız İbrahimʼdir’ demeye kalkmayın. Ben size diyorum ki, Allah şu taşlardan bile İbrahimʼe çocuklar yaratabilecek güçtedir. <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>Balta artık ağaçların köküne dayandı. İyi meyve vermeyen her ağaç kesilip ateşe atılacak. <verse eid="MAT 3:10"/><verse number="11" style="v" sid="MAT 3:11"/>Tövbe edesiniz diye ben sizi suyla <char style="w">vaftiz</char> ediyorum. Ama benden sonra gelen benden daha güçlü. Ben Oʼnun ayaklarından sandaletlerini çıkarmaya layık değilim. O sizi <char style="w" lemma="Kutsal Ruh">Kutsal Ruhʼla</char> ve ateşle vaftiz edecek. <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>Küreği elindedir. O kürekle harman yerini temizleyip buğdayını ambara toplayacak.<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="fk" closed="false">Harman yerini temizleyip buğdayını ambara toplayacak. </char><char style="ft" closed="false">Harman yerinde buğdayı samandan ayıklayan biri gibi Mesih iyileri kötülerden ayıracak.</char></note> Ama samanı hiç sönmeyen ateşle yakacak.”<verse eid="MAT 3:12"/></para>
  <para style="s1">İsaʼnın vaftizi</para>
  <para style="r">(<ref loc="MRK 1:9-11">Markos 1:9‑11</ref>; <ref loc="LUK 3:21">Luka 3:21</ref>,<ref loc="LUK 3:22">22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>O sırada İsa Celile bölgesinden Şeria ırmağına, Yahyaʼnın yanına, onun eliyle <char style="w">vaftiz</char> olmak için geldi. <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>Ama Yahya Oʼna şu sözlerle engel olmak istedi: “Benim senin tarafından <char style="w">vaftiz</char> edilmem lazım. Yine de sen bana geliyorsun!”<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>Ama İsa ona şöyle cevap verdi: “Şimdilik buna razı ol! Çünkü <char style="w">doğru</char> olan her şeyi bu şekilde yerine getirmemiz lazım.” Bunun üzerine Yahya İsaʼnın dileğine razı oldu.<verse eid="MAT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16"/>Vaftiz olur olmaz İsa sudan çıktı. O anda gökler açıldı ve İsa, Allahʼın Ruhuʼnun bir güvercin gibi inip kendi üzerinde durduğunu gördü. <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>Gökten bir ses şöyle dedi: “Bu benim sevgili <char style="w" lemma="Oğul">Oğlumʼdur</char>. Oʼndan memnunum.”<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">İsaʼnın denenmesi</para>
  <para style="r">(<ref loc="MRK 1:12">Markos 1:12</ref>,<ref loc="MRK 1:13">13</ref>; <ref loc="LUK 4:1-13">Luka 4:1‑13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>Ondan sonra Kutsal Ruh, İsaʼyı ıssız yerlere götürdü. Orada <char style="w">İblis</char> Oʼnu günaha düşürmeye çalışacaktı. <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>İsa kırk gün kırk gece oruç tuttuktan sonra acıktı. <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>Oʼnu deneyen İblis gelip dedi ki: “Eğer <char style="w" lemma="Allahʼın Oğlu">Allahʼın Oğluʼysan</char>, emret, şu taşlar ekmek olsun.”<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>İsa ona şöyle cevap verdi: “ ‘İnsan sadece ekmekle yaşamaz, Allahʼın ağzından çıkan her bir sözle yaşar’ diye Tevratʼta yazılmıştır.”<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 8:3">Yasanın Tekrarı 8:3</ref></char></char></note><verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>Bunun üzerine İblis İsaʼyı kutsal şehir <char style="w" lemma="Yeruşalim">Yeruşalimʼe</char> götürdü. Oʼnu tapınağın en yüksek yerine çıkardı <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>ve Oʼna şöyle dedi: “Eğer Allahʼın Oğluʼysan, kendini aşağı at. Çünkü şöyle yazılmıştır:</para>
  <para style="q1" vid="MAT 4:6">‘Seni korumaları için meleklerine buyruk verecek.</para>
  <para style="q2" vid="MAT 4:6">Ayağın taşa çarpmasın diye</para>
  <para style="q2" vid="MAT 4:6">seni elleri üzerinde taşıyacaklar.’ ”<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 91:11">Mezmur 91:11</ref>,<ref loc="PSA 91:12">12</ref></char></char></note><verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>İsa ona şu cevabı verdi: “ ‘Allahınız Rabbi denemeyin’ diye de yazılmıştır.”<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:16">Yasanın Tekrarı 6:16</ref></char></char></note><verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>İblis bu sefer İsaʼyı çok yüksek bir dağa götürdü. Oʼna dünyanın bütün ülkelerini ve onların görkemini gösterdi. <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>Oʼna şöyle dedi: “Eğer yere kapanıp bana taparsan, bütün bunları sana vereceğim.”<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>Bunun üzerine İsa ona şöyle dedi: “Çekil önümden Şeytan! Çünkü şöyle yazılmıştır: ‘Allahınız Rabbe tapının, yalnız Oʼna hizmet edin.’ ”<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:13">Yasanın Tekrarı 6:13</ref></char></char></note><verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>Bundan sonra İblis İsaʼdan ayrıldı. Melekler de gelip İsaʼya hizmet ettiler.<verse eid="MAT 4:11"/></para>
  <para style="s1">İsa vaaz vermeye başlıyor</para>
  <para style="r">(<ref loc="MRK 1:14">Markos 1:14</ref>,<ref loc="MRK 1:15">15</ref>; <ref loc="LUK 4:14">Luka 4:14</ref>,<ref loc="LUK 4:15">15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>İsa Yahyaʼnın tutuklandığını öğrenince, Celile bölgesine çekildi. <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>Nasıra kasabasından ayrılıp Kefernahumʼa yerleşti. Kefernahum göl kenarında, Zevulun ve Naftali topraklarının arasındaki sınırda bulunuyordu. <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>Böylece Allahʼın Peygamber Yeşayaʼnın aracılığıyla söyledikleri yerine geldi:<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>“Zevulun ve Naftali toprakları,</para>
  <para style="q2" vid="MAT 4:15">denize inen yol,</para>
  <para style="q2" vid="MAT 4:15">
    <char style="w">Şeria</char> Irmağıʼnın ötesi,</para>
  <para style="q2" vid="MAT 4:15">diğer milletlerin yaşadığı Celile!<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>Karanlıkta yaşayan halk,</para>
  <para style="q2" vid="MAT 4:16">büyük bir ışık gördü.</para>
  <para style="q1" vid="MAT 4:16">Ölümün gölgesinde olan bölgede oturanların üzerine</para>
  <para style="q2" vid="MAT 4:16">şafak doğdu.”<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 9:1">Yeşaya 9:1</ref>,<ref loc="ISA 9:2">2</ref></char></char></note><verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>O zaman İsa vaazında halka şunları duyurmaya başladı: “Tövbe edin! Çünkü <char style="w">Göklerin Krallığı</char> yaklaştı!”<verse eid="MAT 4:17"/></para>
  <para style="s1">İsaʼnın ilk öğrencileri</para>
  <para style="r">(<ref loc="MRK 1:16-20">Markos 1:16‑20</ref>; <ref loc="LUK 5:1-11">Luka 5:1‑11</ref>; <ref loc="JHN 1:35-42">Yuhanna 1:35‑42</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>İsa Celile Gölüʼnün kenarında gezinirken iki kardeş gördü. Biri Petrus takma adıyla tanınan Simun, öbürü de onun kardeşi Andreasʼtı. Göle ağ atıyorlardı, çünkü balıkçıydılar. <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>İsa onlara şöyle dedi: “Peşimden gelin! Sizi bana insan kazanan balıkçılar yapacağım” <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>Anında ağlarını bırakıp İsaʼnın peşinden gittiler.<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>İsa oradan ilerleyince, başka iki kardeş gördü. Onlar Zebediʼnin oğlu Yakub ve onun kardeşi Yuhannaʼydı. Babaları Zebedi ile birlikte teknedeydiler, ağlarını tamir ediyorlardı. İsa onları da çağırdı. <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>Onlar da hemen tekneyi ve babalarını bırakıp İsaʼnın peşinden gittiler.<verse eid="MAT 4:22"/></para>
  <para style="s1">İsa hastaları iyileştiriyor</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>İsa, Celile bölgesinin her tarafını dolaştı. Halkın <char style="w" lemma="toplantı yeri">toplantı yerlerinde</char> vaaz edip göksel krallık hakkındaki <char style="w" lemma="Müjde">Müjdeʼyi</char><note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="fk" closed="false">Müjde </char><char style="ft" closed="false">Allahʼın insanları günahtan kurtarması hakkındaki iyi haber.</char></note> duyurdu. Halkın arasında her türlü hastalığı ve sakatlığı iyileştirdi. <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>Oʼnun <char style="w" lemma="ad">adı</char> bütün Suriyeʼye yayıldı. Çeşitli hastalıklara tutulanları, acı içinde kıvrananları, cinlileri, saralıları<note caller="+" style="f"><char style="fr" closed="false">4:24 </char><char style="fk" closed="false">Saralıları </char><char style="ft" closed="false">Sara: zaman zaman kendini kaybederek olduğu yere düşme, vücutta şiddetli çırpınmalar ve ağız köpürmesi ile ortaya çıkan bir sinir hastalığı.</char></note> ve felçlileri Oʼna getirdiler. İsa da onları iyileştirdi. <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>Celile ve Dekapolis bölgelerinden, <char style="w" lemma="Yeruşalim">Yeruşalimʼle</char> Yahudiyeʼden ve <char style="w">Şeria</char> ırmağının ötesinden gelen büyük kalabalıklar Oʼnun arkasından gidiyordu.<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">Asıl mutluluk</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luka 6:20‑23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>İsa kalabalıkları görünce bir tepeye çıktı. Oturduktan sonra, öğrencileri<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fk" closed="false">Öğrencileri </char><char style="ft" closed="false">Öğrenci, başkasından öğrenen anlamına gelir. Ancak İsaʼnın öğrencileri, Oʼnun yalnızca öğrettiklerini öğrenmeye değil, hayatını paylaşmaya çağırdığı kişilerdir.</char></note> Oʼnun yanına geldiler. <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>İsa da onlara şöyle vaaz etmeye başladı:<verse eid="MAT 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>“Ne mutlu ruhsal fakirlere!<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="fk" closed="false">Ruhsal fakirlere </char><char style="ft" closed="false">Böyle insanlar günahlı oldukları için, Allahʼı memnun edecek hiçbir şeye sahip olmadıklarını anlayan kişilerdir. Allahʼtan merhamet dilemekten başka çareleri yok.</char></note></para>
  <para style="q2" vid="MAT 5:3">Çünkü Göklerin Krallığı onlarındır.<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>Ne mutlu yas tutanlara!</para>
  <para style="q2" vid="MAT 5:4">Çünkü onlar teselli bulacaklar.<verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>Ne mutlu yumuşak huylu olanlara!</para>
  <para style="q2" vid="MAT 5:5">Çünkü onlar yeryüzünü miras alacaklar.<verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>Ne mutlu <char style="w" lemma="doğruluk">doğruluğa</char> acıkmış ve susamış insanlara!</para>
  <para style="q2" vid="MAT 5:6">Çünkü onlar doyacaklar.<verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>Ne mutlu merhametli olanlara!</para>
  <para style="q2" vid="MAT 5:7">Çünkü onlara da merhamet edilecek.<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>Ne mutlu yüreği temiz olanlara!</para>
  <para style="q2" vid="MAT 5:8">Çünkü onlar Allahʼı görecekler.<verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>Ne mutlu barış getirenlere!</para>
  <para style="q2" vid="MAT 5:9">Çünkü onlara Allah evlatları denecek.<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>Ne mutlu <char style="w">doğru</char> olanı yaptıkları için eziyet görenlere!</para>
  <para style="q2" vid="MAT 5:10">Çünkü Göklerin Krallığı onlarındır.<verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>Benim yüzümden insanlar size hakaret ve eziyet ettikleri zaman ne mutlu size! Hakkınızda yalan yere her türlü kötü söz söylediklerinde size ne mutlu! <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>Sevinin, şen olun, çünkü gökte ödülünüz büyük olacak. Zaten sizden önceki peygamberlere de aynı şekilde eziyet ettiler.<verse eid="MAT 5:12"/></para>
  <para style="s1">Tuz ve ışık</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>Dünyanın tuzu sizsiniz. Ama tuz tadını kaybederse, tekrar ona nasıl tuz tadı verilebilir? O artık dışarı atılmak ve insanların ayakları altında çiğnenmekten başka bir işe yaramaz.<verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>Dünyanın ışığı sizsiniz. Tepe üzerine kurulan şehir saklı kalamaz. <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>Kimse de bir lamba yakıp onu bir kabın altına koymaz. Hayır, onu lambalığa koyar ve evdeki herkese aydınlık verir. <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>Aynı bunun gibi, sizin ışığınız da insanların gözü önünde parlasın. Öyle ki, yaptığınız iyilikleri görüp gökteki <char style="w" lemma="Baba">Babanızʼı</char> yüceltsinler.<verse eid="MAT 5:16"/></para>
  <para style="s1">Tevrat değiştirilemez</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>Sakın Tevratʼı ya da peygamberlerin yazdıklarını ortadan kaldırmaya geldiğimi sanmayın. Ben onları ortadan kaldırmaya değil, tamamlamaya geldim. <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>Size doğrusunu söylüyorum: Yer ve gök ortadan kalkmadan, her şey yerine gelmeden, Tevratʼtan tek bir ufak harf ya da çizgi bile asla yok olmayacak. <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>Bu sebeple, her kim bu buyrukların en ufağını bozup insanlara da aynısını yapmayı öğretirse, o kişi Göklerin Krallığıʼnda önemsiz sayılacak. Ama onları kim yerine getirip başkalarına öyle yapmayı öğretirse, o kişiye Göklerin Krallığıʼnda önemli denilecek. <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>Çünkü size şunu söylüyorum: <char style="w" lemma="doğruluk">Doğruluğunuz</char> Tevrat uzmanlarının ve <char style="w" lemma="Ferisiler">Ferisilerin</char> doğruluğundan daha üstün olmazsa, Göklerin Krallığıʼna asla giremezsiniz.<verse eid="MAT 5:20"/></para>
  <para style="s1">Katillik</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>Atalarımıza ‘Adam öldürmeyin!’ ve ‘Kim adam öldürürse, yargılanacak’<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:13">Çıkış 20:13</ref></char></char></note> denildiğini işittiniz. <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>Ancak ben size şunu diyorum: Kardeşine öfkelenen herkes yargılanmayı hak edecek. Kardeşine boş kafalı diyen, <char style="w" lemma="Meclis">Meclisʼin</char> önünde hesap verecek. Birine aptal diyen kişi, cehennem ateşini hak edecek.<verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>Sen kurban yerinde Allahʼa bir adak getirirken, kardeşinin sana karşı bir şikâyeti olduğunu hatırlarsan, <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>o vakit adağını kurban yerinin önünde bırak ve git. Önce kardeşinle barış, sonra dön ve adağını sun!<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>Senden davacı olan kişiyle bir an önce, henüz yoldayken anlaş. Öyle ki, o seni yargıca vermesin. Yargıç da seni gardiyana teslim etmesin, o da seni hapishaneye atmasın. <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>Sana doğrusunu söylüyorum: borcunu son kuruşuna<note caller="+" style="f"><char style="fr" closed="false">5:26 </char><char style="fk" closed="false">Kuruş </char><char style="ft" closed="false">Assarion, işçinin günde kazandığı denariusun on altıda biri değerindedir.</char></note> kadar ödemeden oradan çıkamazsın.<verse eid="MAT 5:26"/></para>
  <para style="s1">Zina</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>‘Zina etmeyin!’<note caller="+" style="f"><char style="fr" closed="false">5:27 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:14">Çıkış 20:14</ref></char></char></note> denildiğini işittiniz. <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>Ama ben size diyorum: her kim bir kadına bakarsa ve onda gözü kalırsa, o kişi zaten yüreğinde zina etmiştir. <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>Sağ gözün seni iman yolundan saptırırsa, onu çıkar at! Bütün bedenin cehenneme atılacağına bedeninin bir parçasının yok olması senin için daha iyidir. <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>Sağ elin seni iman yolundan saptırırsa, onu kes at! Bütün bedenin cehenneme atılacağına bedeninin bir parçasının yok olması senin için daha iyidir.<verse eid="MAT 5:30"/></para>
  <para style="s1">Nikâhı bozmak</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>Şöyle de denildi: ‘Karısını boşayan adam ona bir boşanma kâğıdı versin.’<note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 24:1">Yasanın Tekrarı 24:1</ref></char></char></note> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>Ama ben size diyorum ki, her kim karısını evlilik dışı seksüel ilişkiden başka bir sebeple boşarsa, o kadının zina işlemesine sebep olur. Hem de, kim boşanmış kadınla evlenirse, zina işlemiş olur.<verse eid="MAT 5:32"/></para>
  <para style="s1">Yemin etmek</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>Atalarımıza, ‘Yalan yere yemin etmeyin, Rabbin huzurunda ettiğiniz yeminleri yerine getirin’ denildiğini de işittiniz. <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>Ama ben size diyorum ki: hiç yemin etmeyin! Gök üzerine yemin etmeyin, çünkü gök Allahʼın tahtıdır. <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>Yeryüzü üzerine de yemin etmeyin, çünkü yeryüzü Allahʼın ayaklarının basamağıdır. <char style="w">Yeruşalim</char> üzerine yemin etmeyin, çünkü Yeruşalim Büyük Kralʼın<note caller="+" style="f"><char style="fr" closed="false">5:35 </char><char style="fk" closed="false">Büyük Kralʼın </char><char style="ft" closed="false">Büyük Kral: Allah.</char></note> şehridir. <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>Kendi başınızın üzerine de yemin etmeyin, çünkü saçınızın tek bir telini bile ak, ya da kara yapamazsınız. <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>Söylemek istediğiniz söz evet ise, ‘evet’ deyin, hayır ise ‘hayır’ deyin. Ondan ötesi Şeytanʼdandır.<verse eid="MAT 5:37"/></para>
  <para style="s1">Göze göz değil</para>
  <para style="r">(<ref loc="LUK 6:29">Luka 6:29</ref>,<ref loc="LUK 6:30">30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>‘Göze göz, dişe diş’<note caller="+" style="f"><char style="fr" closed="false">5:38 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 21:24">Çıkış 21:24</ref>; <ref loc="LEV 24:20">Levililer 24:20</ref>; <ref loc="DEU 19:21">Yasanın Tekrarı 19:21</ref></char></char></note> denildiğini işittiniz. <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>Ama ben size diyorum ki: size kötülük yapana karşı direnmeyin. Hayır, kim sağ yanağınıza bir tokat atarsa, ona öbür yanağınızı da çevirin. <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>Size karşı dava açıp gömleğinizi almak isteyene paltonuzu da verin. <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>Sizi bin adım gitmeye zorlayan adamla iki bin adım gidin.<note caller="+" style="f"><char style="fr" closed="false">5:41 </char><char style="ft" closed="false">Romalı askerlerin İsrail halkından herhangi bir kişiye yük taşıtmaya veya benzer işleri yaptırmaya hakları vardı. Örneğin: Kireneli Simunʼa İsaʼnın çarmıhını taşıttılar.</char></note> <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>Sizden dileyene verin. Ödünç isteyeni geri çevirmeyin.<verse eid="MAT 5:42"/></para>
  <para style="s1">Düşmanları sevmek</para>
  <para style="r">(<ref loc="LUK 6:27">Luka 6:27</ref>,<ref loc="LUK 6:28">28</ref>,<ref loc="LUK 6:32-36">32‑36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>‘Komşunuzu sevin, ama düşmanınızdan nefret edin!’<note caller="+" style="f"><char style="fr" closed="false">5:43 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">Levililer 19:18</ref></char></char></note> denildiğini işittiniz. <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>Ama ben size diyorum: düşmanlarınızı sevin, size eziyet edenler için dua edin. <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>Öyle ki, gökteki <char style="w" lemma="Baba">Babanızʼın</char> evlatları olasınız. Çünkü O güneşini hem kötülerin, hem de iyilerin üzerine parlatır. Hem <char style="w">doğru</char> olanlara, hem de doğru olmayanlara yağmur yağdırır. <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>Çünkü sadece sizi sevenleri severseniz, ne ödülünüz olur? Vergi memurları bile aynısını yapmazlar mı? <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>Sadece kardeşlerinize selam verirseniz, diğer insanlardan fazla ne yapmış olursunuz? Diğer milletler bile aynısını yapmazlar mı? <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>Bunun için, gökteki Babanız nasıl kusursuzsa siz de öyle kusursuz olun!”<verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">Sadakalar</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>“Sakın gösteriş için insanların gözü önünde iyilik yapmayın. Yoksa gökteki <char style="w" lemma="Baba">Babanızʼdan</char> ödülünüz olmaz. <verse eid="MAT 6:1"/><verse number="2" style="v" sid="MAT 6:2"/>Bu sebeple, fakirlere yardım ettiğiniz zaman, bunu davul zurnayla duyurmayın. İkiyüzlüler <char style="w" lemma="toplantı yeri">toplantı yerlerinde</char> ve sokaklarda öyle yaparlar. Yeter ki, insanlar onlara saygı göstersinler. Size doğrusunu söylüyorum: onlar ödüllerini zaten aldılar. <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>Hayır! Siz fakir birine yardım ettiğiniz zaman, sol eliniz sağ elinizin ne yaptığını bilmesin.<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="fk" closed="false">Sol eliniz sağ elinizin ne yaptığını bilmesin. </char><char style="ft" closed="false">Bu deyim, “ne yaptığınızı en yakınınıza bile duyurmayın” anlamına gelir.</char></note> <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>Öyle ki, ettiğiniz yardım gizli kalsın. Gizli olanı gören Göksel Babanız size karşılık verecek.<verse eid="MAT 6:4"/></para>
  <para style="s1">Dua</para>
  <para style="r">(<ref loc="LUK 11:1-4">Luka 11:1‑4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>Dua ettiğiniz zaman ikiyüzlüler gibi yapmayın. Onlar <char style="w" lemma="toplantı yeri">toplantı yerlerinde</char> ve sokaklarda dikilip dua etmeye bayılırlar. Yeter ki, insanlar onları görsün. Size doğrusunu söylüyorum: onlar ödüllerini zaten aldılar. <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>Ama siz dua ettiğiniz zaman odanıza girin, kapıyı kapatın, gözle görülmeyen göksel <char style="w" lemma="Baba">Babanızʼa</char> dua edin. Gizlice yaptığınızı gören Babanız size karşılık verecek.<verse eid="MAT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7"/>Dua ettiğiniz zaman, aynı boş lafları tekrarlayıp durmayın. Diğer milletler öyle yapıyorlar. Çünkü çok laf ettikleri için Allahʼın onları işiteceğini sanıyorlar. <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>Onlar gibi olmayın. Göksel Babanız ihtiyacınızın ne olduğunu siz daha dilemeden bilir.<verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>Onun için siz şöyle dua edin:</para>
  <para style="q1" vid="MAT 6:9">‘Gökteki Babamız!</para>
  <para style="q1" vid="MAT 6:9">Senin adın kutsal olsun.<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>Senin krallığın gelsin.</para>
  <para style="q1" vid="MAT 6:10">Gökte olduğu gibi, yeryüzünde de senin istediğin olsun.<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>Bugün bize gündelik ekmeğimizi ver.<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>Bize karşı suç işleyenleri nasıl bağışladıysak,</para>
  <para style="q2" vid="MAT 6:12">sen de bizim suçlarımızı bağışla.<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>Bizi <char style="w">doğru</char> yoldan saptıracak bir duruma düşürme,</para>
  <para style="q2" vid="MAT 6:13">ama kötü olandan kurtar.</para>
  <para style="q1" vid="MAT 6:13">Çünkü krallık, güç ve yücelik,</para>
  <para style="q1" vid="MAT 6:13">sonsuzlara kadar senindir. Amin.’<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">“Çünkü krallık, güç ve yücelik, sonsuzlara kadar senindir. Amin” sözleri en eski Grekçe el yazmalarında yoktur. Duaya uygun bir son olarak eklendi.</char></note><verse eid="MAT 6:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14"/>Çünkü siz insanların suçlarını bağışlarsanız, gökteki Babanız da sizi bağışlayacak. <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>Ama insanları bağışlamazsanız, Babanız da sizin suçlarınızı bağışlamayacak.<verse eid="MAT 6:15"/></para>
  <para style="s1">Oruç</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>Oruç tuttuğunuz zaman, ikiyüzlüler gibi surat asmayın. Onlar, insanlar oruçlu olduklarını fark etsinler diye kara kara bakınırlar. Size doğrusunu söylüyorum: onlar ödüllerini zaten aldılar. <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/>Fakat siz oruç tuttuğunuz zaman, başınıza koku sürün ve yüzünüzü yıkayın. <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>Öyle ki, insanlar değil, gözden uzak olan <char style="w" lemma="Baba">Babanız</char> oruç tuttuğunuzu görsün. Gizlice yaptığınızı gören Babanız size karşılık verecek.<verse eid="MAT 6:18"/></para>
  <para style="s1">Gökteki zenginlikler</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>Yeryüzünde kendinize servet biriktirmeyin. Burada böcek<note caller="+" style="f"><char style="fr" closed="false">6:19 </char><char style="fk" closed="false">Böcek </char><char style="ft" closed="false">Aslında güve. Güve kelebeğe benzer çift kanatlı uçan bir böcektir. Bazı türlerin tırtılları kumaş kemirir.</char></note> ve küf onları yiyip bitirir. Hırsızlar da evi basıp serveti çalarlar. <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>Hayır! Kendinize gökte bir servet biriktirin. Orada ne <char style="w">böcek</char> ne de küf onları yiyip bitirmez. Hırsızlar da evi basıp onları çalamazlar. <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>Çünkü servetiniz neredeyse, yüreğiniz de orada olacak.<verse eid="MAT 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>Bedenin ışığı gözdür. Öyleyse gözünüz sağlam olursa, bütün bedeniniz aydınlık olur. <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>Ama gözünüz kötü olursa, bütün bedeniniz karanlık olur. Sizdeki aydınlık karanlık olursa, o karanlık ne kadar korkunçtur!<verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>Kimse iki efendiye kölelik edemez. Ya birinden nefret edip, öbürünü sevecek, ya da birine bağlanıp, öbürünü hor görecek. Siz hem Allahʼa, hem de paraya kölelik edemezsiniz.<verse eid="MAT 6:24"/></para>
  <para style="s1">Kaygılanmayın</para>
  <para style="r">(<ref loc="LUK 12:22-31">Luka 12:22‑31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>Bunun için size şunu söylüyorum: Ne yiyip ne içeceğiz diye canınızı sıkmayın. Ne giyeceğiz diye de bedeniniz için kaygılanmayın. Can yiyecekten, beden de giyecekten daha önemlidir, öyle değil mi? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>Gökteki kuşlara bakın: ne ekerler ne biçerler, ne de ambarlarda yiyecek biriktirirler. Fakat gökteki <char style="w" lemma="Baba">Babanız</char> onları besler. Siz onlardan daha değerli değil misiniz? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>Hangi biriniz kaygılanarak ömrünü bir saat bile uzatabilir?<verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>Elbise için neden kaygılanıyorsunuz? Tarladaki çiçeklere bakın nasıl büyürler! Ne iş yaparlar, ne de dikiş dikerler. <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>Yine de size şunu söylüyorum: Kral Süleyman gösterişli hayat yaşadı. Ama o bile, bu çiçeklerden biri kadar güzel giyinmemişti. <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>Otlar bir gün çayırda büyür, ertesi gün fırına atılır. Ey siz imanı az olanlar! Allah otları bile öyle giydiriyorsa, mutlaka sizi de giydirecek, öyle değil mi?<verse eid="MAT 6:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31"/>Onun için yiyeceğimizi ve içeceğimizi nasıl sağlayacağız, örtünmek için nasıl elbise bulacağız diye kaygılanmayın. <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>Çünkü diğer milletler hep böyle şeylerin peşindeler. Oysa gökteki Babanız bütün bunlara muhtaç olduğunuzu biliyor. <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>Siz <char style="w" lemma="Allahʼın Krallığı">Allahʼın Krallığıʼna</char> ve <char style="w">doğru</char> yoluna öncelik verin. O zaman size bütün bu şeyler de verilecek. <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>O halde yarın için kaygılanmayın. Yarının derdi yarına kalsın. Her günün derdi kendine yeter.”<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">Davalamak</para>
  <para style="r">(<ref loc="LUK 6:37-42">Luka 6:37‑42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>“Başkasını yargılamayın ki, siz de yargılanmayasınız. <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>Çünkü nasıl suçlarsanız öyle suçlanacaksınız. Bir de hangi ölçüyle yargılarsanız, siz de aynı ölçüyle yargılanacaksınız.<verse eid="MAT 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3"/>Neden başkasının gözündeki çöpü görüyorsun da, kendi gözündeki kütüğü görmüyorsun? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>Kendi gözünde kütük varken, nasıl kardeşine, ‘İzin ver, gözündeki çöpü çıkarayım’ dersin? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>Seni ikiyüzlü seni! Önce kendi gözündeki kütüğü çıkar. O zaman kardeşinin gözündeki çöpü çıkarmak için daha iyi görürsün.<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>Kutsal olanı köpeklere vermeyin, ve incilerinizi domuzların önüne atmayın. Yoksa onları ayaklarının altında çiğnerler. Sonra da dönüp sizi paramparça ederler.<verse eid="MAT 7:6"/></para>
  <para style="s1">Dileyin, arayın, kapıyı çalın</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luka 11:9‑13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>Dileyin, size verilecek. Arayın, bulacaksınız. Kapıyı çalın, size açılacak. <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>Çünkü her dileyen alır, arayan bulur ve kapıyı çalana kapı açılır.<verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>Aranızda hangi adam oğlu ondan ekmek isteyince, ona taş verir? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>Ya da ondan balık isteyince ona yılan verir? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>Kötü olan sizler bile çocuklarınıza iyi hediyeler vermeyi biliyorsunuz. Öyleyse, gökteki <char style="w" lemma="Baba">Babanızın</char> da ondan isteyenlere iyi olanı vereceği daha kesin değil mi? <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>Öyleyse, insanların size nasıl davranmasını istiyorsanız, siz de onlara öyle davranın. Tevratʼın ve peygamberlerin söyledikleri budur.<verse eid="MAT 7:12"/></para>
  <para style="s1">Dar kapı, geniş kapı</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>Dar kapıdan girin. Çünkü geniş kapı ve rahat yol yıkıma götürür. Oradan girenler çoktur. <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>Hayata götüren kapı ise dardır ve yolu zahmetlidir. Onu bulanlar da azdır.<verse eid="MAT 7:14"/></para>
  <para style="s1">Ağaç ve meyvesi</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luka 6:43‑45</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>Sahte peygamberlerden sakının! Aranıza koyun kılığında girerler, fakat aslında yırtıcı kurtlardır. <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>Onları meyvelerinden tanıyacaksınız.<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="fk" closed="false">Meyvelerinden tanıyacaksınız. </char><char style="ft" closed="false">Yaptıklarından tanıyacaksınız. İnsanın yaptıkları onun nasıl bir insan olduğunu açıklar. Onu davranışlarının getirdiği neticelerden tanımak lazım.</char></note> Üzümler çalılardan toplanmaz, incirler de dikenlerden toplanmaz, öyle değil mi? <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>Demek ki, her iyi ağaç iyi meyve verir, ama kötü ağaç kötü meyve verir. <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>İyi ağaç kötü meyve veremez, kötü ağaç da iyi meyve veremez. <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>İyi meyve vermeyen her ağaç kesilip ateşe atılır. <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>Evet, onları meyvelerinden tanıyacaksınız.<note caller="+" style="f"><char style="fr" closed="false">7:20 </char><char style="ft" closed="false">Bakınız <char style="xt"><ref loc="MAT 7:16">7:16</ref></char> ayetindeki dipnota.</char></note><verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>Bana ‘Efendimiz, Efendimiz!’ diyen herkes <char style="w" lemma="Göklerin Krallığı">Göklerin Krallığıʼna</char> girmeyecek. Ama kim gökte olan <char style="w" lemma="Baba">Babamʼın</char> isteğini yerine getirirse, o girecek. <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>O gün çok kişi bana şöyle diyecek: ‘Efendimiz, Efendimiz! Biz senin adınla peygamberlik etmedik mi? Senin adınla cinleri kovmadık mı? Senin adınla birçok mucize yapmadık mı?’ <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>O zaman ben onlara açıkça diyeceğim ki: ‘Sizi hiç tanımadım. Defolun, sizi kötülük yapanlar.’<verse eid="MAT 7:23"/></para>
  <para style="s1">İki inşaatçıdan ders</para>
  <para style="r">(<ref loc="LUK 6:46-49">Luka 6:46‑49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>Bunun için, her kim benim bu sözlerimi işitirse, ve ona göre yaşarsa, akıllı bir adama benzer. Böyle bir adam evini kaya üzerine kurar. <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>Sonra yağmur yağar, seller yükselir, rüzgar eser ve o eve çarpar. Fakat ev yıkılmaz, çünkü kaya üzerine kurulmuştur. <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>Oysa her kim benim bu sözlerimi işitirse ama ona göre yaşamazsa, akılsız bir adama benzer. Böyle bir adam evini kum üzerine kurar. <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>Sonra yağmur yağar, seller yükselir, rüzgar eser ve o eve çarpar. Ev de yıkılır, korkunç bir şekilde mahvolur.”<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>İsa bu konuşmayı bitirince, halk Oʼnun öğrettiklerine şaşırıp kaldı. <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>Çünkü onlara Tevrat uzmanları gibi değil, yetkiye sahip biri olarak vaaz ediyordu.<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">Cüzzam hastası adam</para>
  <para style="r">(<ref loc="MRK 1:40-45">Markos 1:40‑45</ref>; <ref loc="LUK 5:12-16">Luka 5:12‑16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>İsa tepeden indi. Büyük bir kalabalık Oʼnun arkasından yürüdü. <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>Bu sırada cüzzam<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="fk" closed="false">Cüzzam </char><char style="ft" closed="false">Ayrıca lepra adıyla bilinen cüzzam, deride başlayan ve bedeni yavaş yavaş çürüten öldürücü ve bulaşıcı hastalık. Tevrat kanunlarına göre hasta insan temiz olmayan insan ilan edilmeli. Normal hayata dönebilmesi için rahip tarafından temiz ilan edilmesi lazımdı.</char></note> hastası bir adam yaklaştı. İsaʼnın ayaklarına kapanarak şöyle dedi: “Ey Efendim! İstersen, beni hastalığımdan temizleyebilirsin!”<verse eid="MAT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3"/>İsa elini uzatıp adama dokundu ve, “İsterim” dedi. “Temiz ol!” Anında adam <char style="w">cüzzam</char> hastalığından temizlendi. <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>İsa adama şöyle dedi: “Bunu kimseye anlatma. Ancak git, <char style="w" lemma="rahip">rahibe</char> görün. Sonra Musaʼnın buyurduğu kurbanı sun. Bu herkese şahitlik olacak.”<verse eid="MAT 8:4"/></para>
  <para style="s1">Yüzbaşının imanı</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luka 7:1‑10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>İsa Kefernahumʼa geldikten sonra, Romalı bir yüzbaşı Oʼna yaklaştı ve şöyle yalvardı: <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>“Efendimiz, evde genç bir hizmetkârım var, eli ayağı tutmaz oldu, büyük acılar içinde yatıyor.”<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>İsa adama, “Gelip onu iyileştireceğim” dedi.<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>Ama yüzbaşı şöyle cevap verdi: “Efendimiz, evime kadar gelmene layık değilim. Sadece bir söz söyle, o zaman hizmetkârım iyileşecek. <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>Çünkü ben de buyruk altında bir adamım. Benim de buyruğumda askerlerim var. Birisine ‘Git’ derim, gider. Başkasına ‘Gel’ derim, gelir. Köleme de ‘Şunu yap’ derim, yapar.”<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>İsa bunu duyunca hayret etti ve Oʼnu izleyenlere şöyle dedi: “Size doğrusunu söylüyorum: İsrail halkında hiç kimsede bu kadar büyük imana rastlamadım. <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>Size derim ki, Doğudan ve batıdan çok kişi gelecek ve <char style="w" lemma="Göklerin Krallığı">Göklerin Krallığıʼnda</char> İbrahim, İshak ve Yakubʼla birlikte sofraya oturacaklar. <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>Ama bu krallığın asıl vatandaşları dışarıya atılıp karanlıkta kalacaklar. Orada ağlayıp dişlerini gıcırdatacaklar.”<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="fk" closed="false">Dişlerini gıcırdatacaklar </char><char style="ft" closed="false">Öfke, acı ve pişmanlık gibi duyguları gösteren bir hareket.</char></note><verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>Sonra İsa yüzbaşıya dedi: “Git, sen nasıl iman ettiysen, öyle olsun.” O anda genç hizmetkâr iyileşti.<verse eid="MAT 8:13"/></para>
  <para style="s1">İsa birçok kişiyi iyileştiriyor</para>
  <para style="r">(<ref loc="MRK 1:29-34">Markos 1:29‑34</ref>; <ref loc="LUK 4:38-41">Luka 4:38‑41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>İsa Petrusʼun evine geldi. Petrusʼun kaynanasının ateşler içinde hasta yattığını gördü. <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>İsa onun eline dokununca kadının ateşi düştü. Sonra kadın kalkıp İsaʼya hizmet etmeye başladı.<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>Akşam olunca, İsaʼya cinli birçok kişiyi getirdiler. İsa emir vererek cinleri kovdu ve bütün hastaları iyileştirdi. <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>Böylece Allahʼın Peygamber Yeşayaʼnın aracılığıyla söylediği şu söz yerine geldi:</para>
  <para style="q1" vid="MAT 8:17">“Zayıflıklarımızı O üstlendi.</para>
  <para style="q2" vid="MAT 8:17">Hastalıklarımızı O yüklendi.”<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:4">Yeşaya 53:4</ref></char> (Septuaginta adlı Eski Antlaşmaʼnın Grekçe tercümesinden.)</char></note><verse eid="MAT 8:17"/></para>
  <para style="s1">İsaʼnın öğrencisi olmak</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luka 9:57‑62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>İsaʼnın etrafına kalabalıklar toplandı. İsa bunu görünce <char style="w" lemma="öğrenci">öğrencilerine</char> gölün öbür tarafına geçmelerini söyledi. <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>Bir Tevrat uzmanı gelip İsaʼya şöyle dedi: “Öğretmenim,<note caller="+" style="f"><char style="fr" closed="false">8:19 </char><char style="fk" closed="false">Öğretmenim </char><char style="ft" closed="false">Öğretmen: onları bir inanç yolunda yetiştirmek için etrafına öğrenci toplayan kişi.</char></note> sen nereye gidersen peşinden geleceğim”.<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>İsa ona şöyle cevap verdi: “Tilkilerin yatacak yerleri var. Gökteki kuşların da yuvaları var. Ama <char style="w" lemma="İnsan Oğlu">İnsan Oğluʼnun</char> başını koyacak yeri yok.”<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>Başka bir <char style="w">öğrenci</char> İsaʼya “Efendim, izin ver de, önce gidip babamı gömeyim” dedi.<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>İsa ona şöyle karşılık verdi: “Sen benim peşimden gel. Bırak, ölüler kendi ölülerini gömsünler.”<verse eid="MAT 8:22"/></para>
  <para style="s1">İsa fırtınayı dindiriyor</para>
  <para style="r">(<ref loc="MRK 4:35-41">Markos 4:35‑41</ref>; <ref loc="LUK 8:22-25">Luka 8:22‑25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>İsa tekneye bindi. <char style="w" lemma="öğrenci">Öğrencileri</char> de Oʼnunla beraber gittiler. <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>Aniden gölde büyük bir fırtına koptu. Öyle ki, dalgalar tekneyi yutacak gibiydi. Fakat İsa uykuya dalmıştı. <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>Öğrencileri gelip Oʼnu uyandırdılar. “Efendimiz!” dediler. “Kurtar bizi, boğuluyoruz!”<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>İsa onlara şöyle dedi: “Neden korkuyorsunuz, sizi imanı az olanlar?” Sonra kalktı, rüzgarı ve gölü azarladı. Ortalık tamamen sakinleşti.<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>Adamlar hayret ettiler. “Bu nasıl bir adam ki, rüzgar ve göl bile Oʼnun buyruğuna uyuyor?” dediler.<verse eid="MAT 8:27"/></para>
  <para style="s1">İsa iki adamdan cin çıkarıyor</para>
  <para style="r">(<ref loc="MRK 5:1-20">Markos 5:1‑20</ref>; <ref loc="LUK 8:26-39">Luka 8:26‑39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>Gölün öbür tarafına, Gadara kasabasının yakınındaki topraklara geldiler. Cinli iki adam İsaʼyı karşıladı. Bu adamlar mezarlık olarak kullanılan mağaralarda yaşıyorlardı. Onlar o kadar belalıydı ki, kimse o yoldan geçemezdi. <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>Bu iki adam İsaʼya bağırıp şöyle dediler: “Ey <char style="w">Allahʼın Oğlu</char>, bizden ne istiyorsun? Vaktinden önce bize işkence etmeye mi geldin?”<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>Onlardan biraz uzakta büyük bir domuz sürüsü otluyordu. <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>Cinler İsaʼya şöyle yalvarmaya başladılar: “Madem bizi kovacaksın, o zaman domuz sürüsüne yolla.”<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>İsa onlara “Gidin!” dedi. Onlar da adamlardan çıkıp domuzların içine girdiler. Bütün sürü dik yamaçtan aşağı göle atladı. Domuzlar boğularak öldüler. <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>Domuzları otlatanlar oradan kaçıp kasabaya gittiler. Orada cinli adamlara olanlar dahil, her şeyi anlattılar. <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>Bunun üzerine kasabadaki herkes İsaʼyı karşılamaya çıktı. Oʼnu görünce o bölgeden ayrılması için Oʼna yalvardılar.<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">İsa felçli adamı iyileştiriyor</para>
  <para style="r">(<ref loc="MRK 2:1-12">Markos 2:1‑12</ref>; <ref loc="LUK 5:17-26">Luka 5:17‑26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>İsa tekneye binip gölün karşı tarafına geçti ve kendi kasabasına geldi. <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>Oʼna döşek üzerinde yatan felçli bir adam getirdiler. İsa onların imanını görünce felçli adama, “Evladım” dedi. “Gözün aydın! Günahların bağışlandı.”<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>Bunun üzerine Tevrat uzmanlarından bazıları aralarında, “Bu adam Allahʼa hakaret ediyor!”<note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="fk" closed="false">Bu adam Allahʼa hakaret ediyor </char><char style="ft" closed="false">Demek istedikleri: Bu adam kendini Allahʼla bir sayıyor. Çünkü günahları bağışlamak Allahʼa aittir.</char></note> diye homurdandılar.<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>Ama İsa onların düşüncelerini anlayıp şunu sordu: “Aklınızda neden kötülüğe yer veriyorsunuz? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>Hangisi daha kolay? ‘Günahların bağışlandı’ demek mi, yoksa ‘Kalk, yürü’ demek mi? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>Ama <char style="w" lemma="İnsan Oğlu">İnsan Oğluʼnun</char> yeryüzünde günahları bağışlama yetkisine sahip olduğunu bilesiniz diye…” Sonra felçli adama, “Kalk, yatağını al ve evine git” dedi. <verse eid="MAT 9:6"/><verse number="7" style="v" sid="MAT 9:7"/>Adam da kalkıp evine gitti. <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>Halk bunu görünce hayran kaldı. İnsanlara bu yetkiyi veren Allahʼı övdüler.<verse eid="MAT 9:8"/></para>
  <para style="s1">Matta İsaʼnın öğrencisi oluyor</para>
  <para style="r">(<ref loc="MRK 2:13-17">Markos 2:13‑17</ref>; <ref loc="LUK 5:27-32">Luka 5:27‑32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>İsa oradan yoluna devam etti. Vergi toplanma yerinde oturan Matta adındaki adamı gördü. Ona “Peşimden gel!” dedi. O da kalkıp İsaʼnın peşinden gitti.<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>Sonra İsa Mattaʼnın evinde sofra başındayken, vergi memurları dahil birçok günahkâr<note caller="+" style="f"><char style="fr" closed="false">9:10 </char><char style="fk" closed="false">Vergi memurları dahil birçok günahkâr </char><char style="ft" closed="false">Ferisiler Tevrat buyruklarına uymak için atadan kalma adetlere önem verirlerdi. Bunlara önem vermeyen sıradan halkı günahkâr sayarlardı. İsrail halkından Romalılar için vergi topladıkları için vergi memurları vatan haini azgın günahkâr sayılırdı.</char></note> geldi. Onlar İsaʼyla ve Oʼnun <char style="w" lemma="öğrenci">öğrencileriyle</char> birlikte yemek yiyorlardı. <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/><char style="w">Ferisiler</char> bunu görünce İsaʼnın öğrencilerine şöyle dediler: “<char style="w" lemma="öğretmen">Öğretmeniniz</char> niçin vergi memurları ve günahkârlarla yemek yiyor?”<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>Ama İsa bunu işitince, “Sağlıklı insanların değil, hasta olanların doktora ihtiyacı var” diye cevap verdi. <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>“Gidin şu ayetin anlamını öğrenin: ‘Kurban değil merhamet istiyorum.’<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 6:6">Hoşeya 6:6</ref></char></char></note> Ben <char style="w">doğru</char> kişileri değil, günahkârları tövbeye çağırmaya geldim.”<verse eid="MAT 9:13"/></para>
  <para style="s1">Oruç meselesi</para>
  <para style="r">(<ref loc="MRK 2:18-22">Markos 2:18‑22</ref>; <ref loc="LUK 5:33-39">Luka 5:33‑39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>Sonra Yahyaʼnın <char style="w" lemma="öğrenci">öğrencileri</char> İsaʼya gelip sordular: “Biz oruç tutuyoruz, Ferisiler de oruç tutuyorlar. Neden senin öğrencilerin oruç tutmuyor?”<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>İsa onlara şöyle cevap verdi: “Damat onların arasındayken, damadın arkadaşları yas tutar mı? Ama gün gelecek, damat aralarından alınacak. İşte, o zaman oruç tutacaklar.<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>Hiç kimse yepyeni bir kumaş parçasını alıp onu eski bir elbiseye yama yapmaz. Yoksa yama elbiseden sökülür ve yırtık daha büyür. <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>Hiç kimse de yeni şarabı eski <char style="w" lemma="tulum">tulumlara</char> doldurmaz. Yoksa tulumlar patlar. Şarap dökülür ve tulumlar paramparça olur. Hayır, yeni şarap yeni tulumlara doldururlar. Böylece ikisi de korunur.”<verse eid="MAT 9:17"/></para>
  <para style="s1">Kadının şifa bulması, kızın dirilmesi</para>
  <para style="r">(<ref loc="MRK 5:21-43">Markos 5:21‑43</ref>; <ref loc="LUK 8:40-56">Luka 8:40‑56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>İsa daha bu şeyleri onlara anlatırken, bir halk lideri gelip Oʼnun önünde yere kapandı ve şöyle dedi: “Kızım az önce öldü. Ama gelip elinle ona dokunursan, o yaşayacak”. <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>İsa kalkıp <char style="w" lemma="öğrenci">öğrencileriyle</char> birlikte adamın ardından gitti.<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>Bu sırada bir kadın İsaʼnın arkasından yaklaştı. Kadının on iki yıldan beri kanaması vardı. Hemen gelip İsaʼnın elbisesinin kenarına dokundu. <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>Çünkü kadın kendi kendine şöyle demişti: “Elbisesine bir dokunursam, iyileşirim.”<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>İsa dönüp kadını görünce ona, “Kızım, gözün aydın! İmanın seni kurtardı” dedi. Kadın o anda iyileşti.<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>İsa halk liderinin evine geldi. Avluda cenaze müziği çalanları ve gürültülü kalabalığı gördü. <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>“Dışarı çıkın!” dedi. “Kız ölmedi, sadece uyuyor.”<note caller="+" style="f"><char style="fr" closed="false">9:24 </char><char style="fk" closed="false">Sadece uyuyor </char><char style="ft" closed="false">Kız gerçekten ölmüştü. Fakat İsa için onu ölümden diriltmek, uykudan uyandırmak kadar kolaydır.</char></note> İsaʼyla alay ettiler. <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>Kalabalık dışarıya çıkarıldıktan sonra, İsa kızın bulunduğu odaya girdi. Kızın elini tuttu ve kız ayağa kalktı. <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>Bu haber bütün bölgeye yayıldı.<verse eid="MAT 9:26"/></para>
  <para style="s1">İki kör ve bir dilsiz adamın iyileştirilmesi</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>İsa oradan yoluna devam ederken, iki kör adam Oʼnu izledi. Onlar İsaʼya yüksek sesle, “Davud Oğlu, bize acı!” dediler.<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>İsa eve girdikten sonra, kör adamlar Oʼna yaklaştılar. İsa da onlara şunu sordu: “Gözlerinizi açabileceğime inanıyor musunuz?”</para>
  <para style="p" vid="MAT 9:28">Oʼna, “Evet Efendimiz, inanıyoruz” dediler.<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>O zaman İsa onların gözlerine dokunup “İmanınıza göre olsun” dedi. <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>Onların gözleri açıldı ve İsa onları çok sıkı uyardı. “Bakın, bu işten kimsenin haberi olmasın!” dedi. <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>Fakat onlar dışarı çıkıp İsa hakkındaki haberi bütün bölgeye yaydılar.<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>Onlar dışarı çıkınca, İsaʼya konuşamayan cinli bir adam getirildi. <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>Cin kovulduktan sonra adam konuşmaya başladı. Halk da şaşırıp kaldı. “İsrailʼde şimdiye kadar hiç böyle bir şey görülmedi” dediler.<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>Ama <char style="w">Ferisiler</char>, “Cinleri cinlerin lideri Şeytanʼın gücüyle kovuyor” dediler.<verse eid="MAT 9:34"/></para>
  <para style="s1">İşçiler az</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>İsa o bölgedeki bütün köyleri ve kasabaları dolaştı. Halkın <char style="w" lemma="toplantı yeri">toplantı yerlerinde</char> vaaz edip göksel krallık hakkındaki <char style="w" lemma="Müjde">Müjdeʼyi</char> duyurdu. Her türlü hastalığı ve sakatlığı iyileştirdi. <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>Kalabalıkları görünce onlara acıdı, çünkü onlar üzgün ve endişeliydiler. Çobansız koyunlar gibiydiler. <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>O zaman <char style="w" lemma="öğrenci">öğrencilerine</char> şunu söyledi: “Toplanacak ekin<note caller="+" style="f"><char style="fr" closed="false">9:37 </char><char style="fk" closed="false">Toplanacak ekin </char><char style="ft" closed="false">İsaʼya inanacak insanlar.</char></note> bol, ama işçi az. <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>Onun için, ekin Sahibiʼne yalvarın ki, ekinleri biçmeye işçi göndersin.”<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">İsa, on iki öğrencisini yolluyor</para>
  <para style="r">(<ref loc="MRK 6:7-13">Markos 6:7‑13</ref>; <ref loc="LUK 9:1-6">Luka 9:1‑6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>İsa on iki <char style="w" lemma="öğrenci">öğrencisini</char> yanına çağırdı. Onlara şeytani ruhların<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="fk" closed="false">Şeytani ruhların </char><char style="ft" closed="false">Aslı “pis ruhların.” Cin için kullanılan bir ad. Cine tutulan insanın dince pak sayılmadığı için ibadete katılması yasak olduğunu açıklar. Ayrıca cinlerin insana yaptırdıkları pis işleri anlatır.</char></note> üzerine yetki verdi. Böylece şeytani ruhları kovacak, her tür hastalığı ve sakatlığı iyileştireceklerdi.<verse eid="MAT 10:1"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="2" style="v" sid="MAT 10:2"/>On iki <char style="w" lemma="elçi">elçinin</char> adları şunlardır:</para>
  <para style="b" vid="MAT 10:2"/>
  <para style="li1" vid="MAT 10:2">Birincisi, Petrus<note caller="+" style="f"><char style="fr" closed="false">10:2 </char><char style="fk" closed="false">Petrus </char><char style="ft" closed="false">Kaya demektir.</char></note> lakabıyla tanınan Simun ve onun kardeşi Andreas,</para>
  <para style="li1" vid="MAT 10:2">Zebediʼnin oğlu Yakub ve onun kardeşi Yuhanna,<verse eid="MAT 10:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 10:3"/>Filipus ve Bartalmay,</para>
  <para style="li1" vid="MAT 10:3">Tomas ve vergi memuru Matta,</para>
  <para style="li1" vid="MAT 10:3">Alpay oğlu Yakub ve Taday,<verse eid="MAT 10:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 10:4"/>Yurtsever Simun ve İsaʼya ihanet eden Yahuda İskariyot.<verse eid="MAT 10:4"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>İsa bu on iki adamı hizmete gönderdi. Göndermeden önce onlara şu emirleri verdi: “Diğer milletlere gitmeyin, Samiriyelilerin<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="fk" closed="false">Samiriyeliler </char><char style="ft" closed="false">Başka halklarla karışmış Yahudilerden oluşan melez bir halk.</char></note> hiçbir kasabasına girmeyin. <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>Onun yerine kaybolmuş koyunlara benzeyen İsrail halkına gidin. <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>Gittiğiniz her yerde ‘<char style="w" lemma="Göklerin Krallığı">Göklerin Krallığı</char> yaklaştı’ haberini bildirin. <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>Hastaları iyileştirin, ölüleri diriltin, <char style="w">cüzzam</char> hastalarını temiz kılın, cinleri kovun. Bu gücü karşılıksız aldınız, karşılıksız kullanın.<verse eid="MAT 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9"/>Keselerinize altın, gümüş, ya da bakır almayın. <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>Yolculuk için yiyecek torbası, yedek gömlek, sandalet ya da değnek almayın. Çünkü işçi yiyeceğini hak eder. <verse eid="MAT 10:10"/><verse number="11" style="v" sid="MAT 10:11"/>Hangi kasabaya, hangi köye girerseniz, orada saygıdeğer biri var mı diye araştırın. Ayrılana kadar o kişinin evinde kalın. <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>O eve girerken ona esenlik dileyin. <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>Evdekiler buna layıksa, dilediğiniz esenlik onların üzerine kalsın. Ama layık değillerse, esenlik dileğiniz size geri dönsün. <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>Eğer bir ev ya da kasaba halkı sizi iyi karşılamaz ve söylediklerinizi dinlemezse, o yerden ayrılın. Ayrılırken de ayaklarınızın tozunu silkin.<note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="fk" closed="false">Ayaklarınızın tozunu silkin. </char><char style="ft" closed="false">Bu davranış kasaba halkını artık imansız putperestler olarak saydıklarını gösterir.</char></note> <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>Size doğrusunu söylüyorum: Dünyanın yargılanacağı günde Sodom ve Gomora<note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="fk" closed="false">Sodom ve Gomora </char><char style="ft" closed="false">Aşırı kötülükleri yüzünden Allah tarafından cezalandırılan iki şehir.</char></note> o kasabadan daha hafif bir ceza alacaklar.<verse eid="MAT 10:15"/></para>
  <para style="s1">Gelecek sıkıntılar</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>Bakın, ben sizi koyunlar gibi kurtların arasına yolluyorum. Bunun için yılan gibi akıllı ve güvercin gibi zararsız olun. <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>İnsanlardan sakının! Çünkü sizi dava yerlerine teslim edecekler ve <char style="w" lemma="toplantı yeri">toplantı yerlerinde</char> kamçılayacaklar. <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>Benim yüzümden sizi valilerin ve kralların önüne getirecekler. Bu sizin için onlara ve diğer milletlere şahitlik etme fırsatı olacak. <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>Onlar sizi dava yerlerine teslim edince, neyi nasıl söyleyeceğiz diye, hiç kaygılanmayın. Çünkü o anda söyleyeceğiniz sözler size verilecek. <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>Zaten konuşan siz olmayacaksınız, sizin içinizde konuşan Göksel <char style="w" lemma="Baba">Babanızʼın</char> Ruhu olacak.<verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>Kardeş kardeşi, baba da evladını ölüme teslim edecek. Çocuklar da anne babalarına karşı ayaklanıp onları öldürtecekler. <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>Benim adım yüzünden herkes sizden nefret edecek. Ama kim sonuna kadar dayanırsa, o kurtulacak. <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>Size bir kasabada eziyet ederlerse, başka kasabaya kaçın. Size doğrusunu söylüyorum: <char style="w">İnsan Oğlu</char> gelene kadar siz İsrailʼdeki kasabaları dolaşmayı bitiremezsiniz.<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>
    <char style="w" lemma="öğrenci">Öğrenci</char> <char style="w" lemma="öğretmen">öğretmeninden</char>, köle de efendisinden üstün değildir. <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>Yeter ki, öğrenci öğretmeniyle, köle de efendisiyle aynı durumda olsun. Evin efendisine Şeytan<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="fk" closed="false">Şeytan </char><char style="ft" closed="false">Sineklerin efendisi anlamına gelen Baalzevuv adının tercümesidir. İsrail halkının Baalzevul (Yüksek yerin tanrısı) adlı bir Filist tanrısına taktığı alaylı bir isimdir.</char></note> derlerse, ev halkına neler demezler!<verse eid="MAT 10:25"/></para>
  <para style="s1">Kimden korkmamız lazım</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>Bunun için onlardan korkmayın. Çünkü açığa çıkarılmayacak üstü kapalı bir şey yoktur. Bilinmeyecek gizli bir şey de yoktur. <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>Size karanlıkta ne söylediysem, onu aydınlıkta söyleyin. Kulağınıza fısıldanan sözleri evin çatısından duyurun. <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>Bedeni öldüren ama ruhu öldürmeye gücü olmayanlardan korkmayın. Yalnız Allahʼtan korkun. Oʼnun hem ruhu hem de bedeni cehennemde yok etmeye gücü vardır. <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>İki serçe kuşu bir bakır paraya<note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="fk" closed="false">Bakır paraya </char><char style="ft" closed="false">Assarion, işçinin günde kazandığı denariusun on altıda biri değerindedir. Kuruş.</char></note> satılmıyor mu? Fakat Babanızʼın haberi olmadan onlardan bir tanesi bile yere düşmez. <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>Saçınızın her teli bile sayılmıştır. <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>Onun için korkmayın. Siz birçok serçeden daha değerlisiniz.<verse eid="MAT 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>Her kim bana ait olduğunu insanların önünde duyurursa, ben de onun bana ait olduğunu gökte olan Babamʼın önünde duyuracağım. <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>Ama her kim beni insanların önünde reddederse, ben de onu gökte olan Babamʼın önünde reddedeceğim.<verse eid="MAT 10:33"/></para>
  <para style="s1">İsaʼya layık olmak</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>Yeryüzüne barış getirmeye geldiğimi sanmayın. Barış değil, kılıç getirmeye geldim. <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>Çünkü ben bir adamın babasıyla arasını açmaya geldim. Kızın annesiyle ve gelinin kaynanasıyla arasını açmaya geldim. <verse eid="MAT 10:35"/><verse number="36" style="v" sid="MAT 10:36"/>İnsanın düşmanı kendi ev halkı olacak.<note caller="+" style="f"><char style="fr" closed="false">10:36 </char><char style="ft" closed="false"><char style="xt"><ref loc="MIC 7:6">Mika 7:6</ref></char></char></note><verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>Kim annesini ve babasını benden daha çok severse, o bana layık değildir. Kim oğlunu ya da kızını benden daha çok severse, o da bana layık değildir. <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>Çarmıhını yüklenip peşimden gelmeyen kişi bana layık değildir.<note caller="+" style="f"><char style="fr" closed="false">10:38 </char><char style="fk" closed="false">Çarmıhını yüklenip </char><char style="ft" closed="false">Acıyı, zorlukları, hatta ölümü göze almak anlamında.</char></note> <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>Kim canını kurtarmak isterse onu kaybedecek. Ama kim canını benim uğruma kaybederse onu bulacak.<verse eid="MAT 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>Kim sizi kabul ederse, o beni de kabul etmiş olur. Kim beni kabul ederse, beni göndereni de kabul etmiş olur. <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>Kim bir peygamberi, peygamber olduğu için kabul ederse, o peygamberle aynı ödülü alacak. Kim <char style="w">doğru</char> bir kişiyi doğru olduğu için kabul ederse, o doğru kişiyle aynı ödülü alacak. <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>Her kim, bu basit kişilerden birine <char style="w" lemma="öğrenci">öğrencim</char> olduğu için sadece bir bardak soğuk su verirse, size doğrusunu söylüyorum: ödülsüz kalmayacak.”<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">İsa ve Yahya</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luka 7:18‑35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>İsa, on iki <char style="w" lemma="öğrenci">öğrencisine</char> bu buyrukları verdikten sonra oradan ayrıldı. Halka vaaz vermek ve Allahʼın sözünü duyurmak için etraftaki kasabaları dolaştı.<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>Yahya hapisteyken Mesihʼin yaptıklarını işitmişti. Kendi öğrencilerinden bazılarını İsaʼya gönderdi. <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>Onların aracılığıyla Oʼna şunu sordu: “Gelecek olan Mesih sen misin, yoksa başkasını mı bekleyelim?”<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>İsa Yahyaʼnın <char style="w" lemma="öğrenci">öğrencilerine</char> şöyle cevap verdi: “Gidin, işittiğinizi, gördüğünüzü Yahyaʼya anlatın. <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>Körlerin gözleri açılıyor, sakatlar yürüyor, <char style="w">cüzzam</char> hastaları temiz kılınıyor, sağırlar işitiyor, ölüler diriliyor ve fakirlere <char style="w">Müjde</char> duyuruluyor. <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>Benim hakkımda şüpheye düşmeyene ne mutlu!”<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>Yahyaʼnın <char style="w" lemma="öğrenci">öğrencileri</char> oradan ayrılırken İsa halka Yahyaʼdan söz etmeye başladı: “Issız yerlere ne görmeye gittiniz? Rüzgarda sallanan bir kamış mı? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>Söyleyin, ne görmeye gittiniz? Lüks elbiseler giyen bir adam mı? Bakın, lüks elbiseler giyenler kral sarayında oturanlardır. <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>Öyleyse ne görmeye gittiniz? Bir peygamber mi? Evet! Ama ben size diyorum ki, Yahya peygamberden de üstündür. <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>Yahya hakkında şu sözler yazılmıştır:</para>
  <para style="q1" vid="MAT 11:10">‘Bak, ben habercimi senin önünden gönderiyorum.</para>
  <para style="q2" vid="MAT 11:10">O önden gidip senin yolunu hazırlayacak.’<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAL 3:1">Malaki 3:1</ref></char></char></note><verse eid="MAT 11:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11"/>Size doğrusunu söylüyorum: kadından doğanların arasında Vaftizci Yahyaʼdan daha üstün bir kişi ortaya çıkmadı. Ama <char style="w" lemma="Göklerin Krallığı">Göklerin Krallığıʼnda</char> en önemsiz kişi Yahyaʼdan üstündür. <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>Vaftizci Yahyaʼnın zamanından bugüne kadar <char style="w">Göklerin Krallığı</char> saldırılara uğruyor ve saldırganlar onu zorla ele geçirmeye çalışıyorlar.<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="fk" closed="false">Göklerin Krallığı saldırılara uğruyor ve saldırganlar onu zorla ele geçirmeye çalışıyorlar. </char><char style="ft" closed="false">Grekçe metin de şöyle tercüme edilebilir: Göklerin Krallığı güçlü bir şekilde ilerliyor ve saldırgan insanlar onu zorla ele geçirmeye çalışıyorlar.</char></note> <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>Çünkü Yahyaʼya kadar bütün peygamberler de, Tevrat da olacakları önceden bildirdiler. <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>Dediklerini kabul ederseniz, beklediğiniz İlyas Peygamber<note caller="+" style="f"><char style="fr" closed="false">11:14 </char><char style="fk" closed="false">Beklediğiniz İlyas Peygamber </char><char style="ft" closed="false">Yahudiler, İlyas Peygamberʼin, Mesihʼten önce dünyaya tekrar geleceğine inanıyorlardı.</char></note> aslında Yahyaʼdır. <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>Kulağı olan işitsin.<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>Ama bu kuşağın insanlarını neye benzeteyim? Bu kuşak çarşıda oturan çocuklara benziyor. Seslerini yükseltip arkadaşlarına şöyle derler:<verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>‘Size kaval çaldık, oynamadınız.</para>
  <para style="q1" vid="MAT 11:17">Cenaze ezgileri söyledik, ağlamadınız.’<verse eid="MAT 11:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18"/>Yahya geldiği zaman oruç tutup içkiden kaçındı. ‘Adamda cin var’ diyorlar. <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/><char style="w">İnsan Oğlu</char> geldiğinde yiyip içti. Bu sefer, ‘Bakın, ne biçim adam bu!’ diyorlar. ‘Boğazına düşkün ve içkici, vergi memurlarının ve günahkârların arkadaşı.’ Oysa <char style="w">hikmet</char> getirdiği sonuçlarla haklı çıkarılır.”<verse eid="MAT 11:19"/></para>
  <para style="s1">Tövbe etmeyen kasabalar</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luka 10:13‑15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>O zaman İsa mucizelerinin çoğunun yapıldığı kasabaları azarlamaya başladı. Çünkü bu kasabalar tövbe etmemişlerdi. <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>İsa şöyle dedi: “Vay senin haline ey Horazin! Vay senin haline ey Beytsayda! Çünkü sizde yapılan mucizeler Sur ve Sayda şehirlerinde yapılmış olsaydı, onlar çoktan çuval bezine sarınıp kül içinde tövbe ederlerdi. <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>Ben size diyorum ki, dünyanın yargılanacağı günde Sur ve Sayda sizden daha hafif bir ceza alacaklar. <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>Ya sen, ey Kefernahum! Göğe kadar mı yükseleceksin? Hayır, ölüler dünyasına batacaksın. Çünkü sende yapılan mucizeler Sodom şehrinde yapılmış olsaydı, Sodom bugüne kadar ayakta kalırdı. <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>Ama ben size diyorum ki, dünyanın yargılanacağı günde Sodom senden daha hafif bir ceza alacak.”<verse eid="MAT 11:24"/></para>
  <para style="s1">Yorgunlara rahatlık</para>
  <para style="r">(<ref loc="LUK 10:21">Luka 10:21</ref>,<ref loc="LUK 10:22">22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>O sırada İsa konuşmasına şöyle devam etti: “Sana şükrediyorum, ey <char style="w">Baba</char>, göğün ve yerin Efendisi, çünkü bu konuları bilgili ve akıllı kişilerden gizledin ve basit insanlara açıkladın. <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>Evet Baba, çünkü seni memnun eden budur.<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>Babam her şeyi bana emanet etti. Babaʼdan başka kimse <char style="w" lemma="Oğul">Oğulʼu</char> tanımaz. Babaʼyı da sadece Oğul ve Oğulʼun Oʼnu tanıtmak istediği kişiler tanır.<verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>Ey bütün yorgunlar, yükleri ağır olanlar! Bana gelin, ben sizi rahata kavuşturacağım. <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>Benim boyunduruğumu<note caller="+" style="f"><char style="fr" closed="false">11:29 </char><char style="fk" closed="false">Benim boyunduruğumu </char><char style="ft" closed="false">Araba veya saban çeken hayvanların boynuna geçirilen tahta bir alet. Çekilen araç iplerle bu alete bağlanır. Yahudiler bunu Tevrat buyruklarını yerine getirmenin ağırlığını anlatmak için kullanırlardı.</char></note> üstlenin ve benden ders alın. Çünkü ben yumuşak huylu ve alçak gönüllüyüm. O zaman gönül rahatlığı bulursunuz. <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>Çünkü benim boyunduruğum<note caller="+" style="f"><char style="fr" closed="false">11:30 </char><char style="fk" closed="false">Boyunduruğum kolay taşınır </char><char style="ft" closed="false">İsaʼnın buyruklarını yerine getirmek ağır bir yük çekmeye benzemez. İsa peşinden gelenlerin yanında olup onlara bu yükü çekmeye yardımcı olacak. İsa burada iki hayvana yan yana geçirilen boyunduruğa değinir. Kendisi bir yanda imanlı öbür yanda birlikte yükü çekerler.</char></note> kolay taşınır, vereceğim yük de hafiftir.”<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">Şabat gününün efendisi</para>
  <para style="r">(<ref loc="MRK 2:23-3:6">Markos 2:23–3:6</ref>; <ref loc="LUK 6:1-11">Luka 6:1‑11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>İsa bir Şabat<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="fk" closed="false">Şabat </char><char style="ft" closed="false">Yahudilerin dinlenme ve tapınma günüdür. O gün iş yapmak yasaktı. Haftanın yedinci günü, Cuma günü güneş batmasıyla başlar, Cumartesi günü güneş batınca sona erer.</char></note> günü ekin tarlalarından geçiyordu. Oʼnun <char style="w" lemma="öğrenci">öğrencileri</char> acıkmıştı ve ekin başaklarını koparıp yemeye başladılar. <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/><char style="w">Ferisiler</char> bunu görünce İsaʼya şöyle dediler: “Bak, senin öğrencilerin <char style="w">Şabat</char> gününde Tevratʼta yasaklananı yapıyorlar.”<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>İsa onlara şöyle dedi: “Davud ve adamları acıkınca Davudʼun ne yaptığını okumadınız mı? <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>Allahʼın evine girdi, hem kendisi hem de adamları adak ekmeklerinden<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="fk" closed="false">Adak ekmeklerinden </char><char style="ft" closed="false">Çadırın ve sonra tapınağın kutsal yerinde bulunan altın masaya her hafta konulan 12 mayasız pide. İbranicede huzur ekmekleri denilir. Haftanın sonunda yenileri konulunca rahipler belirli şartlar altında eskilerini yiyebilirdi. <char style="xt"><ref loc="EXO 25:30">Çıkış 25:30</ref>; <ref loc="1SA 21:1-6">1. Samuel 21:1‑6</ref></char></char></note> yediler. Oysa o ekmekten yemeye sadece <char style="w" lemma="rahip">rahiplerin</char> izni vardı. <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>Ya da Tevratʼta hiç okumadınız mı, rahipler tapınakta hizmet ederken Şabat günü emrini çiğnerler ve bu onlara günah sayılmaz? <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>Size şunu söylüyorum: burada tapınaktan daha önemli bir şey var. <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>‘Kurban değil, merhamet istiyorum’<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 6:6">Hoşeya 6:6</ref></char></char></note> diyen ayetin anlamını bilseydiniz, suçsuz kişileri suçlu çıkarmazdınız. <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>Çünkü <char style="w">İnsan Oğlu</char> olarak ben Şabat gününün efendisiyim.”<verse eid="MAT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>İsa oradan ayrılınca, Yahudilerin <char style="w" lemma="toplantı yeri">toplantı yerine</char> girdi. <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>Orada eli sakat bir adam vardı. Bazıları İsaʼya, “Şabat günü şifa vermek Tevratʼa uygun mudur?” diye sordular. İsaʼyı suçlayacak bir sebep arıyorlardı.<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>İsa onlara şöyle cevap verdi: “Hangi biriniz Şabat günü çukura düşen koyununu oradan çekip çıkarmaz? <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>İnsan bir koyundan çok daha değerlidir! Bu nedenle Şabat günü iyilik yapmak Tevratʼa uygundur.”<verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>İsa adama, “Elini uzat” dedi. Adam da elini uzattı ve eli öbür eli gibi sapasağlam oldu. <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>Ferisiler ise oradan uzaklaşınca İsaʼyı nasıl yok edecekleri konusunda plan kurmaya başladılar.<verse eid="MAT 12:14"/></para>
  <para style="s1">Allahʼın seçtiği Hizmetkâr</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>Ama İsa bunun farkındaydı ve oradan ayrıldı. Birçok kişi Oʼnun arkasından gitti; İsa da hepsini iyileştirdi. <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>Fakat İsa kim olduğunu açıklamasınlar diye onları sıkı sıkıya uyardı. <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>Öyle ki, peygamber Yeşayaʼnın ağzından söylenen şu söz yerine gelsin:<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>“İşte Hizmetkârım, Oʼnu ben seçtim.</para>
  <para style="q2" vid="MAT 12:18">Gönlümün hoşnut olduğu sevgili Hizmetkârım Oʼdur.</para>
  <para style="q1" vid="MAT 12:18">Ruhumʼu Oʼnun üzerine koyacağım.</para>
  <para style="q2" vid="MAT 12:18">O da adaleti milletlere bildirecek.<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>O, kavga etmeyecek, bağırıp çağırmayacak.</para>
  <para style="q2" vid="MAT 12:19">Sokakta kimse Oʼnun sesini duymayacak.<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>Adaletin üstün gelmesini sağlayacak.</para>
  <para style="q2" vid="MAT 12:20">O zamana kadar ezilmiş bir kamışı kırmayacak,</para>
  <para style="q2" vid="MAT 12:20">tüten bir fitili de söndürmeyecek.<verse eid="MAT 12:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21"/>Diğer milletler Oʼnun adına umut bağlayacak.”<note caller="+" style="f"><char style="fr" closed="false">12:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 42:1-4">Yeşaya 42:1‑4</ref></char></char></note><verse eid="MAT 12:21"/></para>
  <para style="s1">İsaʼnın gücü Allahʼtandır</para>
  <para style="r">(<ref loc="MRK 3:20-30">Markos 3:20‑30</ref>; <ref loc="LUK 11:14-23">Luka 11:14‑23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>Ondan sonra İsaʼya cinli bir adam getirdiler. Adam hem kör, hem de dilsizdi. İsa onu iyileştirdi, öyle ki, kör ve dilsiz adam hem görmeye, hem de konuşmaya başladı. <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>Halk da şaşırıp kaldı. “Bu, Davudʼun oğlu<note caller="+" style="f"><char style="fr" closed="false">12:23 </char><char style="fk" closed="false">Davudʼun oğlu </char><char style="ft" closed="false">Mesih. Bakınız <char style="xt"><ref loc="MAT 2:4-6">Matta 2:4‑6</ref></char> ayetlerine.</char></note> olabilir mi?” diye sordular.<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>Ama <char style="w">Ferisiler</char> bunu işitince şöyle dediler: “Bu adam cinleri sadece cinlerin lideri <char style="w" lemma="Baalzevul">Baalzevulʼun</char> gücüyle kovuyor.”<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>İsa onların düşüncelerini bildiği için şöyle dedi: “İçinden bölünmüş olan her krallık yıkılır. İçinden bölünmüş şehir veya hane ayakta durmaz. <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>Şeytan Şeytanʼı kovarsa, kendi içinden bölünmüş demektir. O zaman onun krallığı nasıl ayakta durur? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>Peki, ben cinleri <char style="w" lemma="Baalzevul">Baalzevulʼun</char> gücüyle kovuyorsam, o zaman sizin adamlarınız onları kimin gücüyle kovuyorlar? Bu durumda kendi adamlarınız sizi yargılayacak. <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>Ama eğer ben cinleri Allahʼın Ruhuʼyla kovuyorsam, o zaman <char style="w">Allahʼın Krallığı</char> aranıza gelmiş demektir.<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>Bir kişi nasıl güçlü bir adamın evine girip mallarını çalabilir? Ancak adamın elini kolunu bağladıktan sonra evini soyabilir.<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>Benimle birlikte olmayan bana karşıdır. Benimle birlikte toplamayan, dağıtıyor demektir. <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>Bunun için size diyorum: insanların işlediği her günah ve ettiği her hakaret bağışlanacak. Ama <char style="w" lemma="Kutsal Ruh">Kutsal Ruhʼa</char> edilen hakaret bağışlanmayacak. <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>Kim <char style="w" lemma="İnsan Oğlu">İnsan Oğluʼnu</char> kötülerse, o kişi bağışlanacak. Ama kim Kutsal Ruhʼu kötülerse o, ne bu dünyada, ne de gelecek dünyada asla bağışlanmayacak.<verse eid="MAT 12:32"/></para>
  <para style="s1">Ağaç ve meyvesi</para>
  <para style="r">(<ref loc="LUK 11:29-32">Luka 11:29‑32</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>Ağaca iyi bakarsanız iyi meyve verir, kötü bakarsanız kötü meyve verir. Ağaç meyvesinden tanınır. <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>Sizi yılan soyu sizi! Kötüyken nasıl iyi şeyler söyleyebilirsiniz? İnsanın kalbinde ne varsa ağzından o çıkar. <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>İyi insan iyilik dolu kalbinden iyi şeyler çıkarır. Kötü insan ise kötülük dolu kalbinden kötü şeyler çıkarır. <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>Size şunu da söylüyorum: Dünyanın yargılandığı gün insanlar söyledikleri her boş laf için hesap verecekler. <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>Çünkü sizi suçlu çıkaran da, haklı çıkaran da sözlerinizdir.”<verse eid="MAT 12:37"/></para>
  <para style="s1">Yunusʼun mucizesi</para>
  <para style="r">(<ref loc="LUK 11:29-32">Luka 11:29‑32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>Ondan sonra Tevrat uzmanları ve <char style="w" lemma="Ferisiler">Ferisilerden</char> bazıları İsaʼya şöyle dediler: “<char style="w" lemma="öğretmen">Öğretmenimiz</char>, senden mucizevi bir işaret görmek istiyoruz.”<verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>İsa onlara şöyle cevap verdi: “Kötü ve sadakatsiz kuşak mucizevi bir işaret istiyor. Ama bu kuşağa Peygamber Yunusʼun işaretinden başka bir işaret gösterilmeyecek. <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>Yunus üç gün, üç gece deniz canavarının karnında kaldı. Aynı bunun gibi, <char style="w">İnsan Oğlu</char> da üç gün üç gece yerin bağrında kalacak.<verse eid="MAT 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 12:41"/>Ninova halkı, dünyanın yargılanacağı günde bu kuşağın insanlarıyla birlikte ayağa kalkacak ve onları suçlu çıkaracak. Çünkü onlar Yunusʼun vaaz etmesi üzerine tövbe ettiler. Ama bakın, burada Yunusʼtan daha üstün olan bulunuyor.<verse eid="MAT 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 12:42"/>Güney Kraliçesi<note caller="+" style="f"><char style="fr" closed="false">12:42 </char><char style="fk" closed="false">Güney Kraliçesi </char><char style="ft" closed="false">İsrail Kralı Süleymanʼı ziyaret eden Saba Kraliçesi. <char style="xt"><ref loc="1KI 10:1-13">1. Krallar 10:1‑13</ref>; <ref loc="2CH 9:1-12">2. Tarihler 9:1‑12</ref></char></char></note> dünyanın yargılanacağı günde bu kuşakla birlikte kalkacak ve onu suçlu çıkaracak. Çünkü kraliçe, Süleymanʼın hikmetli sözlerini işitmek için dünyanın öbür ucundan geldi. Ama bakın, burada Süleymanʼdan daha üstün olan bulunuyor.<verse eid="MAT 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>
    <char style="w">Şeytani ruh</char> insandan çıkınca susuz yerleri gezip rahat edeceği bir yer arar. <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>Onu bulmayınca şöyle der: ‘Çıktığım eve geri döneceğim.’ Dönünce de evi boş, süpürülmüş ve toplanmış bulur. <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>O vakit gidip yanına kendisinden daha kötü olan yedi cin alır. Sonra eve geri dönüp onlarla oraya yerleşir. Böylece adamın son hali önceki halinden beter olur. Bu kötü kuşağın hali de böyle olacak.”<verse eid="MAT 12:45"/></para>
  <para style="s1">İsaʼnın annesi ve kardeşleri</para>
  <para style="r">(<ref loc="MRK 3:31-35">Markos 3:31‑35</ref>; <ref loc="LUK 8:19-21">Luka 8:19‑21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>İsa daha halkla konuşurken Oʼnun annesiyle kardeşleri gelip dışarda durdular ve Oʼnunla konuşmak istediler. <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>Biri İsaʼya, “Bak, annen ve kardeşlerin dışarda, seninle konuşmak istiyorlar” dedi.<verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>Ama İsa bunu söyleyen adama şöyle cevap verdi: “Kim benim annem? Kim benim kardeşlerim?” <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>Sonra eliyle <char style="w" lemma="öğrenci">öğrencilerini</char> göstererek şöyle dedi: “İşte annem, işte kardeşlerim! <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>Evet, gökte olan <char style="w" lemma="Baba">Babamʼın</char> isteğini yerine getiren herkes kardeşim, kız kardeşim ve annemdir.”<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">Dört çeşit toprak benzetmesi</para>
  <para style="r">(<ref loc="MRK 4:1-20">Markos 4:1‑20</ref>; <ref loc="LUK 8:1-15">Luka 8:1‑15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>O gün İsa evden çıkmış, gölün kenarında oturuyordu. <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>Etrafına büyük bir kalabalık toplandı. Bu yüzden İsa bir tekneye binip oturdu. Kalabalık ise kıyıda duruyordu. <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>Onlara benzetmelerle birçok şey anlattı. Şöyle dedi: “İşte, bir çiftçi ekin ekmeye gitmiş. <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>Ekerken bazı tohumlar yol kenarına düşmüş. Kuşlar gelip onları yemiş. <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>Bazı tohumlar az topraklı, taşlı yerlere düşmüş. Toprak derin olmadığı için hemen filizlenmeye başlamış. <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>Ama güneş çıkınca, kavrulmuş. Yeteri kadar kök salamadıkları için kuruyup gitmiş. <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>Bazıları da dikenlerin arasına düşmüş. Dikenler büyüyünce, ekinleri boğmuş. <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>Bazı tohumlar ise iyi toprağa düşmüş, kimisi yüz kat, kimisi altmış kat, kimisi de otuz kat ürün vermiş. <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>Kulağı olan işitsin!”<verse eid="MAT 13:9"/></para>
  <para style="s1">Benzetme kullanmanın sebebi</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>İsaʼnın <char style="w" lemma="öğrenci">öğrencileri</char> Oʼna gelip sordular: “Niçin halka benzetmelerle vaaz ediyorsun?”<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>Onlara şöyle cevap verdi: “Sizlere <char style="w" lemma="Göklerin Krallığı">Göklerin Krallığıʼnın</char> <char style="w" lemma="sır">sırlarını</char> anlama gücü verildi. Ama onlara verilmedi. <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>Çünkü kim sahip olduğu şeyleri kullanırsa, ona daha çok verilecek, bolluğa kavuşacak. Ama kim kullanmazsa, elindeki de alınacak. <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>Bunun için halka benzetmelerle vaaz ediyorum. Çünkü bakıp görmüyorlar; dinleyip işitmiyorlar, hem de anlamıyorlar. <verse eid="MAT 13:13"/><verse number="14" style="v" sid="MAT 13:14"/>Onlar için Yeşaya Peygamberʼin şu sözü yerine geliyor:</para>
  <para style="q1" vid="MAT 13:14">‘Hep işiteceksiniz, ama hiç anlamayacaksınız.</para>
  <para style="q1" vid="MAT 13:14">Hep bakacaksınız, ama hiç görmeyeceksiniz.<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>Çünkü bu halkın yüreği duygusuz oldu.</para>
  <para style="q2" vid="MAT 13:15">Kulakları zor işitiyor.</para>
  <para style="q2" vid="MAT 13:15">Gözlerini kapadılar.</para>
  <para style="q1" vid="MAT 13:15">Öyle olmasaydı, onların gözleri görür,</para>
  <para style="q2" vid="MAT 13:15">kulakları işitir, yürekleri anlardı.</para>
  <para style="q1" vid="MAT 13:15">Bana dönerlerdi, ben de onlara şifa verirdim.’<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 6:9">Yeşaya 6:9</ref>,<ref loc="ISA 6:10">10</ref></char></char></note><verse eid="MAT 13:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16"/>Fakat ne mutlu size! Çünkü gözleriniz görüyor, kulaklarınız işitiyor. <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>Size doğrusunu söylüyorum: birçok peygamber ve iyi insan, sizin gördüklerinizi görmek istedi, ama görmedi. Duyduklarınızı duymak istedi, ama duymadı.<verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>Şimdi ekin eken çiftçi benzetmesinin anlamını dinleyin: <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/><char style="w">Allahʼın Krallığı</char> hakkındaki haberi işiten ama anlamayan bir kişi varsa, kötü olan<note caller="+" style="f"><char style="fr" closed="false">13:19 </char><char style="fk" closed="false">Kötü olan </char><char style="ft" closed="false">Şeytan.</char></note> gelip o adamın yüreğine ekilmiş olanı çalar. Yol kenarına ekilen tohum işte budur. <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>Taşlı toprağa ekilen tohum da şudur: kişi, sözü işittiği zaman onu hemen sevinçle kabul eder. <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>Ama kök salamadığı için sadece kısa bir zaman dayanır. Böyle biri Allahʼın sözü için eziyet ya da baskı görünce hemen iman yolundan döner. <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>Dikenler arasına ekilen tohum da şudur: kişi sözü işitir, ama dünyanın kaygıları ve zenginliğin göz boyaması sözü boğar, ve söz ürün vermez. <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>Bereketli toprağa ekilen tohum ise şudur: kişi sözü işitir ve anlar. O kişi gerçekten ürün verir: kimisi yüz kat, kimisi altmış kat, kimisi de otuz kat.”<verse eid="MAT 13:23"/></para>
  <para style="s1">Yabani ot benzetmesi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>İsa onlara başka bir benzetme anlattı: “<char style="w">Göklerin Krallığı</char>, tarlasına iyi tohum eken adama benzer. <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>Ama insanlar uyurken, adamın düşmanı gelip ekinin arasına yabani ot ekip gitmiş. <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>Fakat ekin filizlenip başaklar serpilince, yabani otlar da ortaya çıkmış.<verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>Toprak sahibinin köleleri ona gelip şunu sormuşlar: ‘Efendimiz, sen tarlana iyi tohum ekmedin mi? Nasıl oluyor da, onda şimdi yabani ot var?’<verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>Adam onlara, ‘Bunu bir düşman yaptı’ demiş. Köleler de ona şunu sormuşlar: ‘O zaman gidip yabani otları sökmemizi ister misin?’<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>Ama adam şöyle demiş: ‘Hayır, yabani otları toplarken, belki ekini de onlarla birlikte sökersiniz. <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>Bırakın, biçme vaktine kadar ikisi yan yana büyüsün. Biçme vakti gelince orakçılara, “Önce yabani otları toplayın, ve yakmak için onları demet yapın. Ekinleri ise, ambarıma toplayın” diyeceğim.’ ”<verse eid="MAT 13:30"/></para>
  <para style="s1">Hardal tanesi ve maya</para>
  <para style="r">(<ref loc="MRK 4:30-34">Markos 4:30‑34</ref>; <ref loc="LUK 13:18-21">Luka 13:18‑21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>İsa onlara bir benzetme daha anlattı: “<char style="w" lemma="Göklerin Krallığı">Göklerin Krallığı</char> bir hardal tohumuna benzer. Bir adam onu alıp tarlasına eker. <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>Hardal tohumu bütün öbür tohumlardan daha küçüktür. Ama büyüdükten sonra, bahçedeki bütün bitkilerden büyük olur. Ağaç kadar olunca kuşlar gelip onun dallarında yuva kurar.”<verse eid="MAT 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>İsa onlara bir benzetme daha anlattı: “<char style="w" lemma="Göklerin Krallığı">Göklerin Krallığı</char> mayaya benzer. Kadın onu alıp üç büyük kap una karıştırır. En sonunda bütün hamur mayalanır.”<verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>İsa bütün bu şeyleri kalabalıklara benzetmelerle anlattı. Benzetmeler kullanmadan onlara hiçbir şey anlatmazdı. <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>Böylece Allahʼın peygamberin ağzından söylediği şu söz yerine geldi:</para>
  <para style="q1" vid="MAT 13:35">“Konuştuğum zaman benzetmeler kullanacağım.</para>
  <para style="q2" vid="MAT 13:35">Dünyanın kurulmasından bu yana gizli kalmış şeyleri anlatacağım.”<note caller="+" style="f"><char style="fr" closed="false">13:35 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 78:2">Mezmur 78:2</ref></char></char></note><verse eid="MAT 13:35"/></para>
  <para style="s1">İsa yabani ot benzetmesini açıklıyor</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>İsa kalabalıklardan uzaklaşıp bir eve girdi. <char style="w" lemma="öğrenci">Öğrencileri</char> de Oʼna gelip “Bize o tarladaki yabani ot benzetmesini açıkla” dediler.<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>İsa onlara şöyle cevap verdi: “İyi tohum eken adam <char style="w" lemma="İnsan Oğlu">İnsan Oğluʼdur</char>. <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>Tarla dünyadır. İyi tohum, Krallığın evlatlarıdır, yabani otlar ise Şeytanʼın evlatlarıdır. <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>Onları eken düşman <char style="w" lemma="İblis">İblisʼtir</char>. Biçme zamanı dünyanın sonudur. Orakçılar da meleklerdir.<verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>Nasıl yabani otları toplayıp ateşte yaktılarsa, dünyanın sonunda da aynı öyle olacak. <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>İnsan Oğlu meleklerini gönderecek. Melekler, insanları yoldan saptıran her şeyi ve günah işleyen insanları Oʼnun Krallığıʼndan sökecekler. <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>Onları ateşli fırına atacaklar. Orada ağlayıp dişlerini gıcırdatacaklar. <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>O vakit <char style="w">doğru</char> kişiler <char style="w" lemma="Baba">göksel Babalarıʼnın</char> Krallığıʼnda güneş gibi parlayacaklar. Kulağı olan işitsin!<verse eid="MAT 13:43"/></para>
  <para style="s1">Saklı hazine ve saklı inci benzetmeleri</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>
    <char style="w">Göklerin Krallığı</char> tarlada gömülmüş bir hazineye benzer. Adamın biri onu bulunca saklamış. O kadar sevinmiş ki, gidip varını yoğunu satmış ve o tarlayı satın almış.<verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>Yine <char style="w">Göklerin Krallığı</char> güzel inciler arayan bir tüccara benzer. <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>Çok değerli bir inci bulunca, adam gidip varını yoğunu satmış ve o inciyi satın almış.<verse eid="MAT 13:46"/></para>
  <para style="s1">Ağ benzetmesi</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>Yine <char style="w">Göklerin Krallığı</char> denize atıldığında her çeşit balık yakalayan balıkçı ağına benzer. <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>Ağ dolunca, onu kıyıya çekerler. Sonra oturup iyi balıkları kaplara koyarlar, ama işe yaramayanları atarlar. <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>Dünyanın sonunda da böyle olacak: melekler çıkıp kötüleri iyilerden ayıracaklar. <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>Kötüleri ateşli fırına atacaklar. Orada ağlayıp dişlerini gıcırdatacaklar.<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>Bütün bunları anladınız mı?”</para>
  <para style="p" vid="MAT 13:51">İsaʼya, “Evet” dediler.<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>İsa onlara şöyle dedi: “Bunun için, <char style="w" lemma="Göklerin Krallığı">Göklerin Krallığıʼnın</char> <char style="w" lemma="öğrenci">öğrencisi</char> olan her Tevrat uzmanı, ambarından hem yeni, hem de eski şeyler çıkaran ev sahibine benzer.”<verse eid="MAT 13:52"/></para>
  <para style="s1">İsa kendi memleketinde saygı görmüyor</para>
  <para style="r">(<ref loc="MRK 6:1-6">Markos 6:1‑6</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>İsa bu benzetmeleri bitirince oradan ayrıldı. <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>Kendi memleketine geldi ve Yahudilerin <char style="w" lemma="toplantı yeri">toplantı yerinde</char> vaaz etmeye başladı. Dua evindekiler hayret içinde şöyle dediler: “Bu adam bu <char style="w" lemma="hikmet">hikmeti</char> ve mucize yapma gücünü nereden aldı? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>Bu, marangozun oğlu değil mi? Annesinin adı Meryem değil mi? Kardeşleri Yakub, Yusuf, Simun ve Yahuda değil mi? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>Kız kardeşleri aramızda değil mi? Madem öyle, bu adam bütün bu şeyleri nereden alıyor?” <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>Böylece gücenip İsaʼyı reddettiler.</para>
  <para style="p" vid="MAT 13:57">Ama İsa onlara şöyle dedi: “Bir peygamberin saygı görmediği tek yer kendi memleketi ve ailesidir.”<verse eid="MAT 13:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58"/>Onların imansızlığı yüzünden orada fazla mucize yapmadı.<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">Yahyaʼnın ölümü</para>
  <para style="r">(<ref loc="MRK 6:14-29">Markos 6:14‑29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>O arada bölge Kralı <char style="w">Hirodes</char> İsa hakkındaki haberi duydu. <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>Adamlarına şöyle dedi: “Bu Vaftizci Yahyaʼdır! Ölümden dirildi! İşte o yüzden bu mucizeleri yapma gücüne sahip.”<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>Hirodes, kardeşi Filipusʼun karısı Hirodiya yüzünden Yahyaʼyı yakalatıp bağlamış ve hapishaneye atmıştı. <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>Çünkü Yahya ona şöyle derdi: “Kardeşinin karısıyla birleşmen Tevratʼa aykırıdır.” <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>Aslında Hirodes Yahyaʼyı öldürtmek istiyordu, ama halkın tepkisinden korkuyordu. Çünkü onlar Yahyaʼyı peygamber sayıyorlardı.<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>
    <char style="w" lemma="Hirodes">Hirodesʼin</char> doğum günü gelince, Hirodiyaʼnın kızı ortaya çıkıp göbek attı. Bu da Hirodesʼin hoşuna gitti. <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>Yemin ederek her ne dilerse ona vereceğine söz verdi. <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>Kız annesinin kışkırtmasıyla şöyle dedi: “Bana bir tepsi üzerinde Vaftizci Yahyaʼnın kafasını getir.” <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>Kral buna üzüldü. Ama sofra başındaki misafirlerin önünde yemin etmişti. Bu yüzden dileğin yerine getirilmesini buyurdu. <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>Haber yollayıp hapishanede Yahyaʼnın kafasını kestirdi. <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>Kafayı tepsi üzerinde getirip kıza verdiler, kız da onu annesine götürdü. <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>Yahyaʼnın <char style="w" lemma="öğrenci">öğrencileri</char> geldiler ve Yahyaʼnın cesedini alıp gömdüler. Sonra gidip İsaʼya haber verdiler.<verse eid="MAT 14:12"/></para>
  <para style="s1">İsa, beş bin kişiyi doyuruyor</para>
  <para style="r">(<ref loc="MRK 6:30-44">Markos 6:30‑44</ref>; <ref loc="LUK 9:10-17">Luka 9:10‑17</ref>; <ref loc="JHN 6:1-15">Yuhanna 6:1‑15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>İsa bunu işitince oradan çekildi. <char style="w" lemma="öğrenci">Öğrencileriyle</char> baş başa kalmak için tekneyle ıssız bir yere gitti. Halk bunu öğrenince kasabalardan çıkıp karadan yürüyerek İsaʼnın ardından gitti. <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>İsa tekneden inince büyük bir kalabalık gördü. Onlara acıdı ve onların hastalarını iyileştirdi.<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>Akşam olunca öğrencileri Oʼnun yanına gelip şöyle dediler: “Burası ıssız bir yer, hem de vakit çok ilerledi. Halkı gönder de, etraftaki köylere gitsinler, kendilerine yiyecek alsınlar.”<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>Ama İsa onlara, “Gitmeleri lazım değil. Onlara siz yiyecek verin!” dedi.<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>İsaʼya, “Burada yalnız beş ekmekle iki balığımız var” dediler.<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>İsa, “Onları bana buraya getirin” dedi. <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>Halka çayırlığa oturmalarını emretti. Sonra beş ekmekle iki balığı aldı, gözlerini göğe kaldırarak şükretti. Ekmekleri bölüp <char style="w" lemma="öğrenci">öğrencilerine</char> verdi. Öğrencileri de ekmekleri halka dağıttılar. <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>Herkes yiyip doydu. Artakalan parçaları topladılar ve onlarla on iki sepet doldurdular. <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>Kadın ve çocukların dışında yemek yiyen aşağı yukarı beş bin kişi vardı.<verse eid="MAT 14:21"/></para>
  <para style="s1">İsa, su üstünde yürüyor</para>
  <para style="r">(<ref loc="MRK 6:45-56">Markos 6:45‑56</ref>; <ref loc="JHN 6:16-24">Yuhanna 6:16‑24</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>İsa hemen <char style="w" lemma="öğrenci">öğrencilerine</char> tekneye bindirdi. Onları kendisinden önce gölün öbür tarafına gönderdi. O arada halkı evlerine gönderecekti. <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>Halkı yolcu ettikten sonra, dua etmek için tek başına bir tepeye çıktı. Akşam olunca orada yalnız kaldı. <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>Tekne ise, karadan epey uzakta, dalgalarla boğuşuyordu. Çünkü rüzgar karşı yönden esiyordu.<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>Sabaha doğru İsa gölün üstünde yürüyüp onlara yaklaştı. <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>Öğrenciler Oʼnun gölün üstünde yürüdüğünü görünce dehşete kapıldılar. “Bu bir hayalettir!” diye korkudan bağırmaya başladılar.<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>İsa ise hemen onlara, “Rahat olun! Benim! Korkmayın!” dedi.<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>Petrus Oʼna şöyle cevap verdi: “Efendimiz eğer sensen, bana buyruk ver de, su üstünde yürüyerek sana geleyim.”<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>İsa, “Gel” dedi.</para>
  <para style="p" vid="MAT 14:29">Petrus tekneden inip suyun üzerinde yürüdü ve İsaʼya doğru ilerledi. <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>Ama güçlü rüzgarı fark edince, korktu ve batmaya başladı. “Efendimiz, kurtar beni!” diye bağırdı.<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>İsa hemen elini uzatıp onu tuttu ve, “Ey kıt imanlı adam! Niçin şüphe ettin?” dedi.<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>Tekneye bindiler ve rüzgar dindi. <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>Teknedekiler İsaʼya tapındılar. “Sen gerçekten <char style="w" lemma="Allahʼın Oğlu">Allahʼın Oğluʼsun</char>!” dediler.<verse eid="MAT 14:33"/></para>
  <para style="s1">İsa Ginnesarʼda</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>Gölü geçip, Ginnesar taraflarında karaya vardılar. <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>Oranın halkı İsaʼyı tanıdı. Hemen etraftaki bölgelere haber yolladılar. İsaʼya hasta olan herkesi getirdiler. <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>Hastalar İsaʼnın sadece elbisesinin eteğine dokunabilmek için yalvardılar. Oʼna dokunan herkes şifa buldu.<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">Allahʼın buyruğu mu, insanların adetleri mi?</para>
  <para style="r">(<ref loc="MRK 7:1-23">Markos 7:1‑23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>Daha sonra <char style="w" lemma="Yeruşalim">Yeruşalimʼden</char> bazı <char style="w">Ferisiler</char> ve Tevrat uzmanları İsaʼya geldiler ve şöyle dediler: <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>“<char style="w" lemma="öğrenci">Öğrencilerin</char> neden atalarımızın adetlerini bozuyorlar? Yemekten önce ellerini din adetine göre yıkamıyorlar.”<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>Ama İsa onlara şöyle cevap verdi: “Ya siz? Siz kendi adetleriniz uğruna niçin Allahʼın buyruğunu çiğniyorsunuz? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>Çünkü Allah şöyle buyurdu: ‘Annenize babanıza saygı gösterin’<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12">Çıkış 20:12</ref>; <ref loc="DEU 5:16">Yasanın Tekrarı 5:16</ref></char></char></note> ve ‘Kim annesini ve babasını aşağılarsa, ölüm cezasını hak eder.’<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 21:17">Çıkış 21:17</ref>; <ref loc="LEV 20:9">Levililer 20:9</ref></char></char></note> <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>Sizler ise şöyle diyorsunuz: ‘Kim annesine ya da babasına “Sana yardım etmek için vereceğim şeyleri Allahʼa adadım” derse, <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>o kişi annesine ve babasına saygı göstermeye mecbur değildir.’ Böylece kendi adetleriniz yüzünden Allahʼın sözünü geçersiz kılıyorsunuz. <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>Sizi ikiyüzlüler sizi! Peygamber Yeşaya hakkınızda ne kadar doğru konuştu:<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>Allah diyor ki, ‘Bu halk beni dudaklarıyla sayıyor,</para>
  <para style="q2" vid="MAT 15:8">ama yürekleri benden uzaktır.<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>Boşuna bana tapıyorlar.</para>
  <para style="q2" vid="MAT 15:9">Vaaz ettikleri, insan buyruklarıdır.’ ”<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 29:13">Yeşaya 29:13</ref></char></char></note><verse eid="MAT 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>İsa kalabalığı yanına çağırıp onlara şöyle dedi: “İşitin ve anlayın! <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>Ağza giren hiçbir şey insanı kirletmez. İnsanı kirleten şey ağızdan çıkandır.”<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>O zaman <char style="w" lemma="öğrenci">öğrencileri</char> İsaʼya gelip şöyle dediler: “Biliyor musun, Ferisiler bu sözü işitince darıldılar?”<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>İsa onlara şöyle cevap verdi: “Gökteki <char style="w" lemma="Baba">Babamʼın</char> dikmediği her fidan kökünden sökülecek. <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>Bırakın gitsinler. Onlar kör insanların kör rehberleridir. Kör adam başka bir kör adama yol gösterirse, ikisi de çukura düşer.”<verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>Petrus İsaʼya, “Bu benzetmeyi bize açıklar mısın?” dedi.<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>İsa şöyle konuştu: “Siz de mi hâlâ anlamıyorsunuz? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>Aklınız ermiyor mu? Ağza giren her şey mideye iner, oradan da dışarı atılır? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>Ama ağızdan çıkan şeyler yürekten gelir. İşte, insanı kirleten onlardır. <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>Çünkü kötü düşünceler insanın yüreğinden çıkar. Bunlar, adam öldürme, zina, evlilik dışı seksüel ilişkiler, hırsızlık, yalancı şahitlik ve iftiralara yol açar. <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>İnsanı kirleten şeyler bunlardır. Ama ellerini din adetine göre yıkamadan yemek yemek insanı kirletmez.”<verse eid="MAT 15:20"/></para>
  <para style="s1">Yabancı kadının imanı</para>
  <para style="r">(<ref loc="MRK 7:24-30">Markos 7:24‑30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>İsa oradan çekilip Sur ve Sayda taraflarına gitti. <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>Oralardan Kenanlı bir kadın gelip İsaʼya yüksek sesle yalvardı: “Efendimiz, ey Davud Oğlu, bana merhamet et! Kızım cine tutuldu, çok acı çekiyor.”<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>Fakat İsa ona hiç cevap vermedi. <char style="w" lemma="öğrenci">Öğrencileri</char> de İsaʼya gelip şöyle rica ettiler: “Kadını sal gitsin, çünkü arkamızdan bağırıp duruyor.”<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>Ama İsa şöyle dedi: “Ben sadece İsrail halkına gönderildim. Onlar kaybolmuş koyunlar gibidir.”<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>Kadın ise gelip İsaʼnın önünde yere kapandı ve “Efendimiz, bana yardım et!” dedi.<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>İsa ona şöyle cevap verdi: “Çocukların ekmeğini alıp köpeklerin önüne atmak doğru değil.”<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>Kadın da, “Evet, Efendimiz, öyle. Ama köpekler bile, efendilerinin masasından düşen ekmek kırıntılarını yer” dedi.<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>O zaman İsa ona şöyle cevap verdi: “İmanı büyük bir kadınsın! İstediğin gibi olsun.” O anda kadının kızı iyileşti.<verse eid="MAT 15:28"/></para>
  <para style="s1">İsa, dört bin kişi doyuruyor</para>
  <para style="r">(<ref loc="MRK 8:1-10">Markos 8:1‑10</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>İsa oradan ayrılıp Celile Gölüʼnün kenarına gitti. Sonra bir tepeye çıkıp oturdu. <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>Büyük kalabalıklar Oʼna geldi. Topal, sakat, kör, dilsiz olanları ve daha bir sürü hastayı getirdiler. Onları İsaʼnın ayaklarının dibine yatırdılar. İsa da onları iyileştirdi. <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>Dilsizler konuşmaya başladı, sakatlar iyileşti, topallar yürüdü ve körler gördü. İnsanlar bunu görünce, şaşırıp kaldılar ve İsrail halkının tapındığı Allahʼı övdüler.<verse eid="MAT 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>İsa <char style="w" lemma="öğrenci">öğrencilerini</char> yanına çağırıp şöyle dedi: “Halka acıyorum. Üç gündür, yanımdalar ve yiyecek bir şeyleri yok. Yolda bayılmasınlar diye onları aç karnına göndermek istemiyorum.”<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>
    <char style="w" lemma="öğrenci">Öğrencileri</char> Oʼna, “Böyle ıssız bir yerde bu kalabalığı doyuracak ekmeği nereden bulalım?” diye sordular.<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>İsa onlara, “Kaç ekmeğiniz var?” dedi.</para>
  <para style="p" vid="MAT 15:34">“Yedi ekmekle birkaç küçük balık” dediler.<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>İsa kalabalığa yere oturmalarını emretti. <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>Yedi ekmeği ve balıkları alıp şükretti. Bunları bölüp <char style="w" lemma="öğrenci">öğrencilerine</char> verdi. Öğrencileri de onları kalabalığa dağıttılar. <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>Herkes yiyip doydu. Yemek artıklarından yedi sepet dolusu toplandı. <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>Kadınlar ve çocuklar sayılmazsa yemek yiyenler aşağı yukarı dört bin kişiydi. <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>İsa halkı gönderdikten sonra bir tekneye binip Magadan topraklarına geçti.<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">İsaʼnın gücü deneniyor</para>
  <para style="r">(<ref loc="MRK 8:11-13">Markos 8:11‑13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>
    <char style="w">Ferisiler</char> ve <char style="w">Sadukiler</char> İsaʼya geldiler. Oʼnu denemek için kendilerine gökten mucizevi bir işaret göstermesini istediler.<verse eid="MAT 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2"/>İsa onlara şöyle cevap verdi: “Akşam olunca, ‘Gökyüzü kırmızı, demek ki hava güzel olacak’ diyorsunuz. <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>Sabah olunca, ‘Gökyüzü kırmızı ve bulutlu, demek ki bugün fırtına çıkacak’ diyorsunuz. Gökyüzünün görünüşünden bir anlam çıkarabiliyorsunuz da, yaşadığınız bu zamanın işaretlerinden bir anlam çıkaramıyor musunuz? <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>Kötü ve sadakatsiz kuşak mucizevi bir işaret istiyor. Ama bu kuşağa Peygamber Yunusʼun işaretinden başka bir işaret gösterilmeyecek.” Sonra İsa onları bırakıp gitti.<verse eid="MAT 16:4"/></para>
  <para style="s1">Ferisilerle Sadukilerin öğrettiklerinden sakının</para>
  <para style="r">(<ref loc="MRK 8:14-21">Markos 8:14‑21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>İsaʼnın <char style="w" lemma="öğrenci">öğrencileri</char> gölün öbür tarafına geçtiler. Fakat yanlarına ekmek almayı unutmuşlardı. <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>İsa onlara şöyle dedi: “Dikkat edin, <char style="w" lemma="Ferisiler">Ferisilerin</char> ve <char style="w" lemma="Sadukiler">Sadukilerin</char> mayasından sakının!”<verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>
    <char style="w" lemma="öğrenci">Öğrenciler</char> aralarında tartışmaya başladılar. “Ekmek almadık diye öyle konuşuyor” dediler.<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>İsa bunu fark edince onlara şöyle dedi: “Ey imanı kıt olanlar! Neden ekmeğimiz yok diye tartışıp duruyorsunuz? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>Daha anlamıyor musunuz? Beş ekmekle beş bin kişinin doyduğunu hatırlamıyor musunuz? Kaç sepet topladınız? <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>Yedi ekmekle dört bin kişinin doyduğunu da mı hatırlamıyorsunuz? O zaman kaç sepet topladınız? <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>Ekmek hakkında konuşmadım. Nasıl olur da bunu anlamıyorsunuz? Hayır, Ferisilerin ve Sadukilerin mayasından sakının!” <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>O vakit anladılar ki, İsa ekmek mayasından değil de, Ferisilerin ve Sadukilerin öğrettikleri şeylerden sakınmalarını söylüyordu.<verse eid="MAT 16:12"/></para>
  <para style="s1">Petrus, İsaʼya “Mesih” diyor</para>
  <para style="r">(<ref loc="MRK 8:27-30">Markos 8:27‑30</ref>; <ref loc="LUK 9:18-21">Luka 9:18‑21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>İsa, Filipus Sezariyesi topraklarına gitti. Orada <char style="w" lemma="öğrenci">öğrencilerine</char> şunu sordu: “İnsanlar <char style="w" lemma="İnsan Oğlu">İnsan Oğluʼnun</char> kim olduğunu söylüyorlar?”<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>Oʼna şöyle cevap verdiler: “Kimisi ‘Vaftizci Yahya’ diyor. Kimisi de ‘İlyas’ diyorlar. Diğerleri de ‘Yeremya,’ ya da ‘eski peygamberlerden biri’ diyorlar.”<verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>İsa onlara sordu: “Ya siz? Sizce ben kimim?”<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>Simun Petrus da şöyle cevap verdi: “Sen Mesihʼsin. Diri olan <char style="w" lemma="Allahʼın Oğlu">Allahʼın Oğluʼsun</char>.”<verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>İsa ona cevap olarak şöyle dedi: “Ne mutlu sana, ey Yunus oğlu Simun! Çünkü bunu sana açıklayan insan değil, göklerde olan <char style="w" lemma="Baba">Babamʼdır</char>. <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>Sana şunu söylüyorum: sen Petrusʼsun<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="fk" closed="false">Petrus </char><char style="ft" closed="false">Bu ad Grekçede “Petros”, kaya parçası anlamına geliyor.</char></note>. Bu kayanın<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="fk" closed="false">Kayanın </char><char style="ft" closed="false">Grekçede “petra” büyük kaya demektir.</char></note> üzerine topluluğumu kuracağım ve ölüler dünyasının kapıları bile ona karşı direnemeyecek. <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/><char style="w" lemma="Göklerin Krallığı">Göklerin Krallığıʼnın</char> anahtarlarını sana vereceğim. Yeryüzünde bağladığın her şey<note caller="+" style="f"><char style="fr" closed="false">16:19 </char><char style="fk" closed="false">Yeryüzünde bağladığın her şey </char><char style="ft" closed="false">Neyin bağlanacağı, neyin çözüleceği: yani, hangi davranışlara izin verileceğini, hangi davranışların yasaklanacağını kararlaştırmak ona düşecekti.</char></note> gökte de bağlanmış olacak. Yeryüzünde çözdüğün her şey gökte de çözülmüş olacak.” <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>Sonra İsa, kendisinin Mesih olduğunu kimseye söylemesinler diye <char style="w" lemma="öğrenci">öğrencilerini</char> uyardı.<verse eid="MAT 16:20"/></para>
  <para style="s1">İsa ölüp dirileceğini bildiriyor</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Markos 8:31–9:1</ref>; <ref loc="LUK 9:22-27">Luka 9:22‑27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>Bundan sonra İsa öğrencilerine <char style="w" lemma="Yeruşalim">Yeruşalimʼe</char> gitmesi gerektiğini açıklamaya başladı. Orada liderler, <char style="w">başrahipler</char> ve Tevrat uzmanlarının elinden çok acı çekmesi, öldürülmesi ve üçüncü gün ölümden dirilmesi gerektiğini söyledi.<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>Petrus İsaʼyı bir kenara çekip azarlamaya başladı: “Efendimiz, Allah korusun! Öyle bir şey asla başına gelmeyecek!”<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>Ama İsa dönüp Petrusʼa şöyle dedi: “Çekil önümden, Şeytan!<note caller="+" style="f"><char style="fr" closed="false">16:23 </char><char style="fk" closed="false">Çekil önümden, Şeytan! </char><char style="ft" closed="false">Şeytan İsaʼyı yolundan döndürmek için Petrusʼun söylediklerini kullanıyordu.</char></note> Sen bana kösteksin. Çünkü düşüncelerin Allahʼtan değil, insandandır.”<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>Sonra İsa öğrencilerine şöyle dedi: “Bir kişi peşimden gelmek isterse, kendini gözden çıkarsın, çarmıhını yüklensin ve yolumu tutsun. <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>Çünkü kim canını kurtarmak isterse onu kaybedecek. Ama kim canını benim uğruma kaybederse, onu bulacak. <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>Bir kişi bütün dünyayı kazanır, ama canını kaybederse, bunun kendisine ne faydası olur? İnsan kendi canına karşılık olarak ne verebilir? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>Ben <char style="w">İnsan Oğlu</char> olarak <char style="w" lemma="Baba">Babamʼın</char> yüceliği içinde meleklerimle geleceğim ve her bir insana yaptıklarına göre karşılık vereceğim. <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>Size doğrusunu söylüyorum: burada duran bazı kişiler İnsan Oğluʼnun kendi krallığıyla geldiğini görmeden ölümü tatmayacaklar.”<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">İsaʼnın görkemli görünüşü</para>
  <para style="r">(<ref loc="MRK 9:2-13">Markos 9:2‑13</ref>; <ref loc="LUK 9:28-36">Luka 9:28‑36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>Altı gün sonra İsa, Petrusʼu, Yakubʼu ve Yakubʼun kardeşi Yuhannaʼyı yanına aldı. Onları yüksek bir dağın tepesine çıkardı. Orada yalnızdılar. <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>Önlerinde İsaʼnın görünüşü tamamen değişti. Yüzü güneş gibi parlamaya başladı. Elbiseleri de ışık gibi bembeyaz oldu. <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>O anda Musaʼyla İlyas <char style="w" lemma="öğrenci">öğrencilere</char> göründü. İsaʼyla konuşuyorlardı.<verse eid="MAT 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4"/>Bunun üzerine Petrus İsaʼya şöyle dedi: “Efendimiz, iyi ki buradayız. İstersen, burada üç çardak<note caller="+" style="f"><char style="fr" closed="false">17:4 </char><char style="fk" closed="false">Çardak </char><char style="ft" closed="false">Ağaç dallarından örülmüş küçük ev.</char></note> kurayım: biri senin için, biri Musa için, biri de İlyas için.”<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>O daha konuşurken, işte, parlak bir bulut onların üstüne gölge yaptı. Bulutun içinden bir ses şöyle dedi: “Sevgili <char style="w" lemma="Oğul">Oğlum</char> budur, Oʼndan memnunum. Oʼnu dinleyin!”<verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>
    <char style="w" lemma="öğrenci">Öğrenciler</char> bunu işitince çok korktular ve yere kapandılar. <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>İsa gelip onlara dokundu ve “Kalkın, korkmayın!” dedi. <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>Başlarını kaldırıp bakınca İsaʼdan başka kimseyi görmediler.<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>Dağdan inerlerken İsa onlara şöyle emretti: “<char style="w" lemma="İnsan Oğlu">İnsan Oğlu</char> ölümden dirilene kadar, gördüklerinizi kimseye anlatmayın.”<verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>
    <char style="w" lemma="öğrenci">Öğrencileri</char> İsaʼya şunu sordular: “Peki Tevrat uzmanları neden, ‘Önce İlyas gelmeli’ diyorlar?”<verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>O da onlara şöyle cevap verdi: “Evet, İlyas gelecek ve her şeyi yeniden düzene koyacak. <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>Ama ben size diyorum: İlyas zaten geldi. Onu tanımadılar. Ona istedikleri gibi yaptılar. İnsan Oğlu da bunun gibi onların elinden acı çekecek.” <verse eid="MAT 17:12"/><verse number="13" style="v" sid="MAT 17:13"/>O vakit <char style="w" lemma="öğrenci">öğrenciler</char> İsaʼnın Vaftizci Yahya hakkında konuştuğunu anladılar.<verse eid="MAT 17:13"/></para>
  <para style="s1">İsa bir çocuğu cinden kurtarıyor</para>
  <para style="r">(<ref loc="MRK 9:14-32">Markos 9:14‑32</ref>; <ref loc="LUK 9:37-45">Luka 9:37‑45</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>İsaʼyla üç <char style="w" lemma="öğrenci">öğrencisi</char> halkın yanına dönünce adamın biri İsaʼya gelip önünde diz çöktü ve şöyle dedi: <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>“Efendimiz, çocuğuma merhamet et. O saralıdır<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="fk" closed="false">Saralıdır. </char><char style="ft" closed="false">Sara: zaman zaman kendini kaybederek olduğu yere düşme, vücutta şiddetli çırpınmalar ve ağız köpürmesi ile ortaya çıkan bir sinir hastalığı, epilepsi.</char></note> ve çok acı çekiyor. Sık sık ateşe ya da suya düşüyor. <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>Oğlumu senin öğrencilerine getirdim, ama onu iyileştiremediler.”<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>İsa cevap olarak şöyle dedi: “Ey imansız ve yoldan sapmış kuşak! Ne zamana kadar sizinle beraber olacağım? Ne zamana kadar size katlanacağım? Çocuğu buraya, bana getirin.” <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>İsa cini azarladı, o da çocuktan çıktı. Çocuk da aynı anda iyileşti.<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>Sonra İsa yalnızken <char style="w" lemma="öğrenci">öğrencileri</char> Oʼna gelip, “Biz cini neden kovamadık?” diye sordular.<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20-21" style="v" sid="MAT 17:20-21"/>İsaʼnın onlara cevabı şuydu: “İmanınız yetersiz de, ondan. Size doğrusunu söylüyorum: hardal tohumu kadar imanınız olsa, şu dağa ‘Buradan kalk, oraya git’ dersiniz, o da gider. Sizin için hiçbir şey imkansız olmayacak.”<note caller="+" style="f"><char style="fr" closed="false">17:20‑21 </char><char style="ft" closed="false">Bazı Grekçe el yazmalarında, “Ama bu tür cinler ancak dua ve oruçla kovulabilir” sözleri de bulunur.</char></note><verse eid="MAT 17:20-21"/></para>
  <para style="s1">İsa ölüp dirileceğini tekrar bildiriyor</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>Celile bölgesinde bir araya geldiklerinde İsa <char style="w" lemma="öğrenci">öğrencilerine</char> şöyle dedi: “<char style="w" lemma="İnsan Oğlu">İnsan Oğlu</char> yakın bir zamanda insanların eline teslim edilecek. <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>Oʼnu öldürecekler, ama O üçüncü gün ölümden dirilecek.” Öğrenciler bu söze çok üzüldüler.<verse eid="MAT 17:23"/></para>
  <para style="s1">Tapınak vergisi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>İsaʼyla <char style="w" lemma="öğrenci">öğrencileri</char> Kefernahumʼa geldiler. Orada iki dirhemlik tapınak vergisini toplayan memurlar Petrusʼa gelip şunu sordular: “<char style="w" lemma="öğretmen">Öğretmeniniz</char> iki dirhemi ödemiyor mu?”<verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>Petrus, “Ödüyor” dedi.</para>
  <para style="p" vid="MAT 17:25">Petrus eve gelince, İsa hemen onunla konuşmaya başladı: “Simun, ne diyorsun? Sence dünyadaki krallar kimden gümrük ya da vergi alıyorlar, kendi evlatlarından mı, yoksa yabancılardan mı?”<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>Petrus, “Yabancılardan” diye cevap verdi.</para>
  <para style="p" vid="MAT 17:26">Bunun üzerine İsa ona, “Demek, evlatlar vergiden serbesttir” dedi. <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>“Fakat vergi toplayanları gücendirmeyelim. Göle git, oltayı at ve tuttuğun ilk balığın ağzını aç. Orada dört dirhemlik bir para bulacaksın. Bu parayı al, hem kendin hem de benim için onlara ver.”<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">Göklerin Krallığıʼnda en büyük kimdir?</para>
  <para style="r">(<ref loc="MRK 9:33-37">Markos 9:33‑37</ref>,<ref loc="MRK 9:42-46">42‑46</ref>; <ref loc="LUK 9:46-48">Luka 9:46‑48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>O sırada <char style="w" lemma="öğrenci">öğrencileri</char> İsaʼya gelip şunu sordular: “Acaba <char style="w" lemma="Göklerin Krallığı">Göklerin Krallığıʼnda</char> en önemli kimdir?”<verse eid="MAT 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2"/>İsa bir çocuğu çağırıp onu aralarına aldı. <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>Sonra şöyle dedi: “Size doğrusunu söylüyorum: Siz bu fikrinizden dönüp çocuklar gibi olmazsanız, <char style="w" lemma="Göklerin Krallığı">Göklerin Krallığıʼna</char> asla girmeyeceksiniz. <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>Bunun için, her kim bu çocuk gibi alçakgönüllü davranırsa, <char style="w" lemma="Göklerin Krallığı">Göklerin Krallığıʼnda</char> en büyük odur. <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/>Her kim böyle bir çocuğu benim adıma kabul ederse, o beni kabul etmiş olur.<verse eid="MAT 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>Ama bana iman eden bu küçüklerden birini yoldan saptıran kişinin vay haline! Boynuna büyük bir değirmen taşı bağlanması ve denizin dibine atılıp boğulması kendisi için daha iyi olur. <verse eid="MAT 18:6"/><verse number="7" style="v" sid="MAT 18:7"/>İnsanları yoldan saptıran tuzaklar yüzünden vay dünyanın haline! Bu tuzakların ortaya çıkması kaçınılmazdır. Ama bu tuzaklara sebep olan kişinin vay haline! <verse eid="MAT 18:7"/><verse number="8" style="v" sid="MAT 18:8"/>Elin ya da ayağın seni iman yolundan saptırırsa, onu kes at! İki elinle veya iki ayağınla hiç sönmeyen ateşe atılmaktansa, tek el ya da tek ayakla sonsuz yaşama kavuşmak senin için daha iyidir! <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>Gözün seni iman yolundan saptırırsa onu çıkar at! Senin için tek gözle sonsuz yaşama kavuşmak iki gözle cehennem ateşine atılmaktan daha iyidir.<verse eid="MAT 18:9"/></para>
  <para style="s1">Kaybolan koyun benzetmesi</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luka 15:3‑7</ref>)</para>
  <para style="p">
    <verse number="10-11" style="v" sid="MAT 18:10-11"/>Bu küçüklerden birini bile sakın hor görmeyin. Çünkü size söylüyorum, onların gökteki melekleri devamlı göksel <char style="w" lemma="Baba">Babamʼın</char> yüzünü görürler.<note caller="+" style="f"><char style="fr" closed="false">18:10‑11 </char><char style="ft" closed="false">Bazı Grekçe el yazmalarında, “Çünkü <char style="w">İnsan Oğlu</char> kaybolanı kurtarmaya geldi” sözleri de bulunur.</char></note><verse eid="MAT 18:10-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>Ne dersiniz? Bir adamın yüz koyunu varsa ve onlardan bir tanesi yolunu şaşırırsa, adam doksan dokuzu tepede bırakıp yolunu şaşıran koyunu aramaya gitmez mi? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>Size doğrusunu söylüyorum, eğer onu bulursa, o koyun için, yolunu şaşırmamış doksan dokuz koyundan daha fazla sevinecek. <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>Aynı bunun gibi, gökteki Babanız bu küçüklerden birinin yok olmasını istemez.<verse eid="MAT 18:14"/></para>
  <para style="s1">Bir imanlı günah işlerse</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>İmanlı kardeşin sana karşı günah işlerse, gidip ona suçunu göster. Mesele ikinizin arasında kalsın. Seni dinlerse, kardeşini kazanmış olursun. <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>Ama seni dinlemezse, yanına bir ya da iki kişi daha al. Öyle ki, ‘Her suçlama iki ya da üç kişinin şahitliğiyle desteklensin.’<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 19:15">Yasanın Tekrarı 19:15</ref></char></char></note> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>Kardeş onları dinlemek istemezse, meseleyi imanlılar topluluğuna bildir. Topluluğu bile dinlemek istemezse, onu putperest ya da vergi memuru gibi say.<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>Size doğrusunu söylüyorum ki, yeryüzünde bağladığınız her şey, gökte de bağlanmış olacak. Yeryüzünde çözdüğünüz her şey gökte de çözülmüş olacak.<note caller="+" style="f"><char style="fr" closed="false">18:18 </char><char style="fk" closed="false">Bağladığınız her şey </char><char style="ft" closed="false">Hangi davranışlara izin verileceğini, hangi davranışların yasaklanacağını kararlaştırma görevi elçilere düşecekti.</char></note><verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>Size şunu da söylüyorum: yeryüzünde sizden iki kişi bir şey dilerse ve o konuda aynı fikirde olurlarsa, gökteki <char style="w" lemma="Baba">Babam</char> onların dilediğini yapacak. <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>Çünkü iki ya da üç kişi nerede benim adımı anarak bir araya gelirlerse, ben oradayım, onların arasındayım.”<verse eid="MAT 18:20"/></para>
  <para style="s1">Acımasız köle benzetmesi</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>Sonra Petrus İsaʼya gelip şöyle dedi: “Efendimiz, imanlı kardeşim bana karşı kaç defa günah işlerse onu bağışlamalıyım? Yedi kereye kadar mı?”<verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>İsa ona şöyle dedi: “Ben sana diyorum ki, yedi kere değil, yetmiş kere yediye kadar. <verse eid="MAT 18:22"/><verse number="23" style="v" sid="MAT 18:23"/>Bu konuda bir örnek vereyim: <char style="w">Göklerin Krallığı</char>, görevlileriyle hesap görmek isteyen bir kral gibidir. <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>Hesapları görürken krala dünya kadar<note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="fk" closed="false">Dünya kadar </char><char style="ft" closed="false">On bin talant: bir talant bir işçinin 15 yılda kazanabileceği paraydı.</char></note> borcu olan bir köle getirmişler. <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>Adamın borcunu ödeyecek bir şeyi yokmuş. Efendisi ise borcun ödenmesi için adamın karısı, çocukları ve bütün mallarıyla birlikte satılmasını emretmiş.<verse eid="MAT 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26"/>Bunun üzerine köle, kralın önünde yere kapanıp yalvarmaya başlamış: ‘Ne olur, azıcık daha dayan, sana bütün borcumu öderim.’ <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>Kölenin efendisi ona acımış. Onu serbest bırakıp bütün borcunu silmiş.<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>Fakat köle çıkıp hizmet arkadaşlarından birini bulmuş. Arkadaşının ona yüz gümüş para<note caller="+" style="f"><char style="fr" closed="false">18:28 </char><char style="fk" closed="false">Yüz gümüş para </char><char style="ft" closed="false">Yüz dinar: bir işçinin yaklaşık üç aylığı kadardı.</char></note> borcu varmış. Köle arkadaşını yakasından tutup boğmaya başlamış. ‘Borcunu öde!’ demiş.<verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>Bunun üzerine arkadaşı yere kapanıp köleye yalvarmaya başlamış: ‘Ne olur, azıcık daha dayan. Sana borcumu ödeyeceğim.’<verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>Fakat köle razı gelmemiş. Gidip hizmet arkadaşını borcunu ödeyene kadar hapishaneye attırmış. <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>Kölenin diğer arkadaşları olanları görünce çok üzülmüşler ve gidip efendilerine olup biten her şeyi ayrıntılı olarak anlatmışlar.<verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>Efendisi köleyi çağırtmış ve ona şöyle demiş: ‘Seni namussuz köle seni! Bana yalvardın diye, senin bütün borcunu sildim. <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>Benim sana merhamet ettiğim gibi, senin de hizmet arkadaşına merhamet etmen lazımdı, değil mi?’ <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>Efendisi çok öfkelenmiş. Bütün borcunu ödeyene kadar köleyi işkencecilere teslim etmiş.<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>Her biriniz kardeşini yürekten bağışlamazsa, gökteki <char style="w" lemma="Baba">Babam</char> da aynısını size yapacak.”<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">Boşanma hakkında</para>
  <para style="r">(<ref loc="MRK 10:1-12">Markos 10:1‑12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>İsa bu konuşmayı bitirdikten sonra Celileʼden ayrıldı ve <char style="w">Şeria</char> Irmağıʼnın öte tarafındaki Yahudiye topraklarına gitti. <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>Büyük kalabalıklar Oʼnun arkasından gidiyordu. İsa orada onların hastalarını iyileştirdi.<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>Bazı <char style="w">Ferisiler</char> gelip İsaʼyı denemek için şunu sordular: “Acaba erkeğin karısını herhangi bir sebep için boşaması Tevratʼa uygun mudur?”<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>İsa da onlara şöyle cevap verdi: “Yaradan başlangıçta insanları erkek ve kadın olarak yarattı.<note caller="+" style="f"><char style="fr" closed="false">19:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 1:27">Yaratılış 1:27</ref></char></char></note> Bunu Tevratʼta okumadınız mı? <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>Allah şöyle dedi: ‘Bunun için adam annesini ve babasını bırakacak, karısına bağlanacak ve ikisi bir beden olacak.’<note caller="+" style="f"><char style="fr" closed="false">19:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">Yaratılış 2:24</ref></char></char></note> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>Şöyle ki, onlar artık iki değil, bir bedendirler. Bu sebeple, Allahʼın birleştirdiğini insan ayırmasın.”<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>Ferisiler İsaʼya, “Madem öyle” dediler, “Musa neden erkek boşanma kâğıdı vererek karısını boşayabilir diye buyurdu?”<verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>İsa onlara şöyle dedi: “Musa inatçılığınız yüzünden karılarınızı boşamanıza izin verdi. Ama en başta bu böyle değildi. <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>Ben size diyorum ki, her kim karısını evlilik dışı seksüel ilişkiden başka bir sebeple boşayıp başka kadınla evlenirse, o kişi zina işlemiş olur.”<verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>
    <char style="w" lemma="öğrenci">Öğrencileri</char> İsaʼya, “Madem erkekle karısının durumu böyledir, hiç evlenmemek daha iyi” dediler.<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>İsa da onlara şöyle dedi: “Herkes bu dediklerimi kabul edemez. Sadece bunları anlama yeteneği verilenler kabul edebilir. <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>Evlenemeyen erkeklerin bazıları kusurlu doğup evlenemezler. Bazıları insan tarafından evlenemez hale getirilirler.<note caller="+" style="f"><char style="fr" closed="false">19:12 </char><char style="fk" closed="false">Bazıları insan tarafından evlenemez hale getirilirler </char><char style="ft" closed="false">Hadım yani çocuk yapamayan, erkekliği alınmış erkek. Eski çağda saraylarda kadınların hizmetinde olan erkeklerin erkekliği alınırdı.</char></note> Bazıları da <char style="w">Göklerin Krallığı</char> için bekâr kalmaya karar verirler. Bunu kabul edebilen, kabul etsin.”<verse eid="MAT 19:12"/></para>
  <para style="s1">İsa çocuklara bereket diliyor</para>
  <para style="r">(<ref loc="MRK 10:13-16">Markos 10:13‑16</ref>; <ref loc="LUK 18:15-17">Luka 18:15‑17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>Oradakiler çocuklarını İsaʼya getirdiler. İsaʼdan onlara dokunup dua etmesini istediler. İsaʼnın <char style="w" lemma="öğrenci">öğrencileri</char> çocukları getirenleri azarladılar. <verse eid="MAT 19:13"/><verse number="14" style="v" sid="MAT 19:14"/>Fakat İsa şöyle dedi: “Bırakın, çocuklar bana gelsin. Onlara engel olmayın! Çünkü <char style="w">Göklerin Krallığı</char> çocuklar gibi olanlarındır.” <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>Elleriyle dokunup çocuklara bereket diledikten sonra oradan ayrıldı.<verse eid="MAT 19:15"/></para>
  <para style="s1">Zengin kişiler ve Allahʼın Krallığı</para>
  <para style="r">(<ref loc="MRK 10:17-31">Markos 10:17‑31</ref>; <ref loc="LUK 18:18-30">Luka 18:18‑30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>İşte, birisi İsaʼya gelip şunu sordu: “<char style="w" lemma="öğretmen">Öğretmenim</char>, sonsuz yaşama sahip olmak için nasıl bir iyilik yapmalıyım?”<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>İsa ona şöyle dedi: “İyilik hakkında neden bana soruyorsun? İyi olan yalnız biri var. Sonsuz yaşama kavuşmak istiyorsan, Allahʼın buyruklarını yerine getir.”<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>Adam İsaʼya, “Hangilerini?” diye sordu.</para>
  <para style="p" vid="MAT 19:18">İsa ona şöyle cevap verdi: “Adam öldürmeyin, zina etmeyin, çalmayın, yalan yere şahitlik etmeyin. <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>Annenize babanıza saygı gösterin<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12-16">Çıkış 20:12‑16</ref>; <ref loc="DEU 5:16-20">Yasanın Tekrarı 5:16‑20</ref></char></char></note> ve komşunuzu kendinizi sevdiğiniz gibi sevin.”<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">Levililer 19:18</ref></char></char></note><verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>Genç adam İsaʼya, “Bütün bunları hep yerine getirdim. Daha ne eksiğim var?” dedi.<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>İsa ona şöyle cevap verdi: “Eğer eksiksiz olmak istersen, git mallarını sat ve parasını fakirlere ver. O zaman gökte hazinen olacak. Sonra gel, benim peşime düş.”<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>Genç adam bu sözü işitince üzüntü içinde ayrıldı, çünkü malı mülkü çoktu.<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>İsa <char style="w" lemma="öğrenci">öğrencilerine</char> şöyle dedi: “Size doğrusunu söylüyorum: zengin bir kişinin <char style="w" lemma="Göklerin Krallığı">Göklerin Krallığıʼna</char> girmesi zordur! <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>Size tekrar söylüyorum: Bir devenin iğne deliğinden geçmesi, zengin bir insanın <char style="w" lemma="Allahʼın Krallığı">Allahʼın Krallığıʼna</char> girmesinden daha kolaydır.”<verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>
    <char style="w" lemma="öğrenci">Öğrenciler</char> bunu duyunca çok hayret ettiler. “Öyleyse, kim kurtulabilir?” diye sordular.<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>İsa onlara dikkatle bakıp şöyle dedi: “İnsan için bu imkansız, fakat Allah için her şey mümkündür.”<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>Sonra Petrus söz alıp İsaʼya şöyle dedi: “Bak, biz her şeyi bıraktık, senin peşine düştük. Peki, karşılığımız ne olacak?”<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>İsa onlara şöyle dedi: “Size doğrusunu söylüyorum: her şey yenilendiği zaman <char style="w">İnsan Oğlu</char> görkemli tahtına oturacak. O vakit benim peşimden gelen sizler de on iki tahta oturup İsrail halkının on iki <char style="w" lemma="oymak">oymağını</char> yargılayacaksınız. <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>Benim uğruma evlerini, kardeşlerini, kız kardeşlerini, babasını, annesini, çocuklarını ya da tarlalarını bırakmış olan herkes, onları yüz kat geri alacak ve sonsuz yaşamı da miras alacak. <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>Fakat şimdi birinci olan birçokları sonuncu, sonuncu olan birçokları da birinci olacaklar.”<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">Cömert bağ sahibi benzetmesi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>“<char style="w" lemma="Göklerin Krallığı">Göklerin Krallığı</char> bir bağ sahibine benzer. Adam sabah erkenden üzüm bağına işçi tutmaya gitmiş. <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>İşçilerle günlüğü bir <char style="w" lemma="gümüş para">gümüş paraya</char> anlaşmış, sonra onları üzüm bağına yollamış.<verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>Saat dokuzda tekrar dışarı çıkmış. Çarşıda boş duran başka adamlar görmüş. <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>Onlara şöyle demiş: ‘Siz de gidin üzüm bağına. Hakkınız ne kadarsa, size ödeyeceğim.’ <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>Böylece onlar bağa gitmişler.</para>
  <para style="p" vid="MAT 20:5">Sonra öğle vakti saat on ikide, ve tekrar saat üçte bir daha çıkmış ve yine aynısını yapmış. <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>Saat akşamüstü beşte çıkıp yine başkalarını boş dururken bulmuş. Onlara şöyle demiş: ‘Neden bütün gün burada boş duruyorsunuz?’<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>‘Kimse bizi tutmadı da ondan’ diye cevap vermişler.</para>
  <para style="p" vid="MAT 20:7">Üzüm bağının sahibi, ‘Siz de üzüm bağına gidin’ demiş.<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>Akşam olunca, bağ sahibi ustabaşına şöyle demiş: ‘İşçileri çağır, onlara gündeliklerini öde. Son tuttuğum kişilerle başla, ilk tuttuklarıma kadar devam et.’<verse eid="MAT 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9"/>Saat beşte tutulanlar gelince, herkes birer gümüş para almış. <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>Sıra ilk tutulanlara gelince, daha fazla para alacaklarını sanmışlar. Ama onlar da birer gümüş para almışlar. <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>Paralarını alınca bağın sahibine karşı şöyle homurdanmaya başlamışlar: <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>‘Bu son gelenler sadece bir saat çalıştılar. Ama sen onları bizimle bir tutuyorsun. Fakat yakıcı güneşin altında bütün günün işini biz yüklendik.’<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>Bağ sahibi onlardan birine şöyle demiş: ‘Arkadaş, ben sana haksızlık etmiyorum. Seninle bir gümüş paraya anlaşmadık mı? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>Hakkını al ve evine git. Bu son tuttuğum adama sana verdiğimin aynısını vermek istiyorum. <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>Kendi malımı istediğim gibi harcarım. Bu benim hakkım değil mi? Yoksa benim elim açık olduğu için, gözün onda mı kalıyor?’<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>Bunun gibi, sonuncular birinci, birinciler de sonuncu olacak.”<verse eid="MAT 20:16"/></para>
  <para style="s1">İsa ölüp dirileceğini üçüncü defa bildiriyor</para>
  <para style="r">(<ref loc="MRK 10:32-34">Markos 10:32‑34</ref>; <ref loc="LUK 18:31-34">Luka 18:31‑34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>İsa <char style="w" lemma="Yeruşalim">Yeruşalimʼe</char> gidiyordu. Yoldayken on iki <char style="w" lemma="elçi">elçisini</char> bir kenara çekti ve onlara şöyle dedi: <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>“Bakın, Yeruşalimʼe gidiyoruz. <char style="w">İnsan Oğlu</char> <char style="w" lemma="başrahipler">başrahiplere</char> ve Tevrat uzmanlarına teslim edilecek. Oʼnu ölüm cezasına çarptıracaklar <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>ve yabancıların eline teslim edecekler. Onlar da Oʼnunla alay edecek, Oʼnu kamçılayacak ve çarmıha gerecekler. Ama üçüncü gün O ölümden dirilecek.”<verse eid="MAT 20:19"/></para>
  <para style="s1">Bir annenin isteği</para>
  <para style="r">(<ref loc="MRK 10:35-45">Markos 10:35‑45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>Sonra Zebedi oğullarının annesi oğullarıyla birlikte İsaʼya geldi. Oʼnun önünde yere kapanıp Oʼndan bir şey rica etti.<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>İsa kadına, “İstediğin ne?” diye sordu.</para>
  <para style="p" vid="MAT 20:21">Kadın Oʼna şöyle dedi: “Buyur et, senin Krallığınʼda bu benim iki oğlumdan biri senin sağında ve öbürü solunda otursun.”<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>İsa şöyle cevap verdi: “Siz ne istediğinizi anlamıyorsunuz. Benim yakında içeceğim acı dolu bardaktan içebilir misiniz?”<note caller="+" style="f"><char style="fr" closed="false">20:22 </char><char style="fk" closed="false">Yakında içeceğim acı dolu bardaktan içebilir misiniz? </char><char style="ft" closed="false">Yani “Benim çekmek zorunda olduğum acılara siz katlanabilir misiniz?”</char></note></para>
  <para style="p" vid="MAT 20:22">“İçebiliriz” dediler.<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>Onlara şöyle dedi: “Evet, bardağımdan içeceksiniz. Ama sağımda ve solumda oturmak için izin vermek bana düşmez. Göksel <char style="w" lemma="Baba">Babam</char> bunu kimler için hazırlamışsa, onlara verilecek.”<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>Öbür on <char style="w">öğrenci</char> bunu duyunca, o iki kardeşe kızmaya başladılar. <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>Ama İsa hepsini yanına çağırıp şöyle dedi: “Bildiğiniz gibi, diğer milletlerin liderleri halklarına baskı yaparlar, ve büyük adamları onları ezerler. <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>Sizin aranızda böyle olmasın. Aranızda büyük olmak isteyen, diğerlerine hizmetkâr olsun. <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>Aranızda birinci olmak isteyen, diğerlerine kul köle olsun. <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>Tıpkı <char style="w">İnsan Oğlu</char> gibi davransın. İnsan Oğlu Oʼna hizmet edilsin diye gelmedi. Hayır, O hizmet etmeye ve kendi canını feda ederek birçok kişiyi günaha esirlikten kurtarmaya geldi.”<verse eid="MAT 20:28"/></para>
  <para style="s1">İsa iki körün gözlerini açıyor</para>
  <para style="r">(<ref loc="MRK 10:46-52">Markos 10:46‑52</ref>; <ref loc="LUK 18:35-43">Luka 18:35‑43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>İsaʼyla <char style="w" lemma="öğrenci">öğrencileri</char> Eriha kasabasından çıkarken, büyük bir kalabalık Oʼnunla birlikte gitti. <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>İki kör adam yol kenarında oturuyordu. İsaʼnın yanlarından geçtiğini duyunca şöyle bağırmaya başladılar: “Efendimiz, Davud Oğlu, bize acı!”<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>Kalabalık sussunlar diye onlara sert çıkıştı. Fakat onlar daha da fazla bağırdılar: “Efendimiz, Davud Oğlu, bize acı!”<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>İsa durdu ve onları yanına çağırdı. “Sizin için ne yapmamı istiyorsunuz?” diye sordu.<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>Oʼna şöyle dediler: “Efendimiz, gözlerimizin açılmasını istiyoruz.”<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>İsa onlara acıdı. Onların gözlerine dokundu. Anında yeniden görmeye başladılar ve İsaʼnın peşinden gittiler.<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">İsaʼnın Yeruşalimʼe girişi</para>
  <para style="r">(<ref loc="MRK 11:1-11">Markos 11:1‑11</ref>; <ref loc="LUK 19:28-40">Luka 19:28‑40</ref>; <ref loc="JHN 12:12-19">Yuhanna 12:12‑19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>İsaʼyla <char style="w" lemma="öğrenci">öğrencileri</char> <char style="w" lemma="Yeruşalim">Yeruşalimʼe</char> yaklaşırken Zeytin Dağıʼnda bulunan Beytfaci Köyüʼne geldiler. O zaman İsa iki öğrencisini önden gönderdi. <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>Onlara şöyle dedi: “Karşınızdaki köye gidin. Varır varmaz, bağlı duran bir dişi eşek ve yanında sıpasını bulacaksınız. Onları çözün ve bana getirin. <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>Biri size bir şey söylerse, ona şöyle deyin: ‘Bunlar Efendimizʼe lazımdır. Onları hemen geri gönderecek.’ ”<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>Bu olayla peygamberin ağzından söylenen şu söz yerine gelmiş oldu:<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>“<char style="w">Siyon</char> kızına<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="fk" closed="false">Siyon kızına </char><char style="ft" closed="false">Şiir dilinde Yeruşalim (Kudüs) halkı demektir.</char></note> şöyle deyin:</para>
  <para style="q1" vid="MAT 21:5">Bak, Kralın sana geliyor, alçakgönüllü ve bir eşeğe binmiş,</para>
  <para style="q2" vid="MAT 21:5">bir sıpaya, bir yük hayvanının yavrusuna binmiş geliyor!”<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 9:9">Zekeriya 9:9</ref></char></char></note><verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>
    <char style="w" lemma="öğrenci">Öğrencileri</char> de gidip, İsaʼnın buyurduğunu yaptılar. <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>Eşeği ve sıpayı getirdiler ve paltolarını onların üzerine koydular. İsa üstüne bindi. <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>Kalabalığın çoğu paltolarını yolun üzerine serdi. Başkaları da ağaçlardan dallar kesip yolun üzerine yaydılar. <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>İsaʼnın önünde ve arkasında birer kalabalık vardı. Şöyle bağırdılar:</para>
  <para style="q1" vid="MAT 21:9">“Davud Oğluʼna, hozana!<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="fk" closed="false">Hozana! </char><char style="ft" closed="false">Aramice “Şimdi kurtar” anlamına gelen “hoşana” kelimesi, Kutsal Kitapʼta krallardan ve özellikle Mesihʼten yardım dilemek ve onları selamlamak için kullanılıyor.</char></note></para>
  <para style="b" vid="MAT 21:9"/>
  <para style="q1" vid="MAT 21:9">Rabbin <char style="w" lemma="ad">adıyla</char> gelene övgüler olsun!<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:25">Mezmur 118:25</ref>,<ref loc="PSA 118:26">26</ref></char></char></note></para>
  <para style="b" vid="MAT 21:9"/>
  <para style="q1" vid="MAT 21:9">En yücelerde hozana!”<verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>İsa <char style="w" lemma="Yeruşalim">Yeruşalimʼe</char> girdikten sonra, bütün şehir heyecanlandı. “Kim bu?” diye sordular.<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>Kalabalık şöyle dedi: “Bu, Celileʼnin Nasıra kasabasından gelen peygamber İsaʼdır.”<verse eid="MAT 21:11"/></para>
  <para style="s1">İsa tapınak avlusunda</para>
  <para style="r">(<ref loc="MRK 11:15-19">Markos 11:15‑19</ref>; <ref loc="LUK 19:45-48">Luka 19:45‑48</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>İsa tapınak avlusuna girdi. Avluda mal satan ve alışveriş yapan herkesi kovdu. Yabancı para değiştirenlerin masalarını ve güvercin satanların iskemlelerini devirdi. <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>İsa onlara şöyle dedi: “Kitapʼta ‘Benim evime ibadet evi denilecek’<note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 56:7">Yeşaya 56:7</ref></char></char></note> diye yazılmıştır. Ama siz onu ‘haydut yatağına’<note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 7:11">Yeremya 7:11</ref></char></char></note> çevirdiniz.”<verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>İsa tapınak avlusundayken kör ve topal kişiler Oʼnun yanına geldiler, İsa da onları iyileştirdi. <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/><char style="w">Başrahipler</char> ve Tevrat uzmanları ise İsaʼnın yaptığı harika mucizeleri ve tapınak avlusunda “Davud Oğluʼna hozana!”<note caller="+" style="f"><char style="fr" closed="false">21:15 </char><char style="ft" closed="false">Bakınız <char style="xt">ayet <ref loc="MAT 9">9</ref></char>ʼdaki dipnota.</char></note> diye bağıran çocukları görünce öfkelendiler.<verse eid="MAT 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16"/>İsaʼya, “Bunların ne bağırdıklarını duyuyor musun?” diye sordular.</para>
  <para style="p" vid="MAT 21:16">İsa onlara şöyle cevap verdi: “Evet, duyuyorum. Siz şu ayeti hiç okumadınız mı?</para>
  <para style="q1" vid="MAT 21:16">‘Çocukların ve sütten kesilmemiş bebeklerin ağzından</para>
  <para style="q2" vid="MAT 21:16">kendine övgüler döktürdün.’ ”<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 8:2">Mezmur 8:2</ref></char> (Septuaginta adlı Eski Antlaşmaʼnın Grekçe tercümesinden.)</char></note><verse eid="MAT 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17"/>Sonra İsa onları bırakıp şehirden ayrıldı. Beytanya köyüne gitti ve orada geceledi.<verse eid="MAT 21:17"/></para>
  <para style="s1">İncir ağacı kuruyor</para>
  <para style="r">(<ref loc="MRK 11:20-25">Markos 11:20‑25</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>Sabah erkenden şehre dönerken, İsa acıktı. <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>Yol kenarında bir incir ağacı gördü. Fakat yanına gidince yapraktan başka bir şey bulmadı. O zaman ağaca şöyle dedi: “Artık bir daha senden meyve çıkmasın!” Ağaç hemen kurudu.<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>
    <char style="w" lemma="öğrenci">Öğrenciler</char> bunu görünce şaştılar. “İncir ağacı nasıl hemen kurudu?” diye sordular.<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>İsa onlara şöyle cevap verdi: “Size doğrusunu söylüyorum: Eğer imanınız olursa ve hiç şüphe etmezseniz, bu incir ağacına yapılanı yapmakla kalmazsınız. Şu tepeye bile, ‘Yerinden kalk, denize atıl!’ dersiniz ve dediğiniz olur. <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>İman ederek dua ederseniz, dilediğiniz her şeyi alacaksınız.”<verse eid="MAT 21:22"/></para>
  <para style="s1">İsa, kimden yetki aldı?</para>
  <para style="r">(<ref loc="MRK 11:27-33">Markos 11:27‑33</ref>; <ref loc="LUK 20:1-8">Luka 20:1‑8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>İsa, tapınak avlusuna gidip vaaz etmeye başladı. O zaman <char style="w">başrahipler</char> ve halkın liderleri İsaʼya gelip şöyle dediler: “Bu şeyleri ne yetkiyle yapıyorsun? Sana bu yetkiyi veren kim?”<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>İsa onlara şöyle cevap verdi: “Ben de size tek bir soru soracağım. Eğer bana cevap verirseniz, size bu şeyleri ne yetkiyle yaptığımı söyleyeceğim. <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>Yahyaʼnın <char style="w">vaftiz</char> etme yetkisi nereden geldi? Allahʼtan<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="fk" closed="false">Allahʼtan </char><char style="ft" closed="false">Harfi harfine “gökten.” Yahudiler Allahʼın adını boş yere söylememek için Allah yerine “gök” derlerdi.</char></note> mi, yoksa insandan mıydı?”</para>
  <para style="p" vid="MAT 21:25">Bu soruyu aralarında şöyle tartışmaya başladılar: “ ‘Allahʼtan’ dersek, ‘O zaman ona neden inanmadınız?’ diyecek. <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>Ama ‘İnsandan’ dersek, biz halkın tepkisinden korkuyoruz, çünkü hepsi Yahyaʼyı peygamber olarak kabul ediyor.”<verse eid="MAT 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27"/>İsaʼya “Bilmiyoruz” diye cevap verdiler.</para>
  <para style="p" vid="MAT 21:27">O da onlara şöyle dedi: “Ben de bu şeyleri ne yetkiyle yaptığımı size söylemeyeceğim.”<verse eid="MAT 21:27"/></para>
  <para style="s1">İki oğul benzetmesi</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>“Şuna ne dersiniz? Bir adamın iki oğlu varmış. Birincisine gidip şöyle demiş: ‘Evladım, git bugün üzüm bağında çalış.’<verse eid="MAT 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29"/>Oğlu da ‘Gitmek istemiyorum!’ demiş. Ama sonra pişman olup gitmiş.<verse eid="MAT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30"/>Babası sonra öbür çocuğuna gitmiş ve ona aynısını söylemiş. O da ‘Olur, efendim’ demiş, ama gitmemiş.<verse eid="MAT 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31"/>O ikisinden hangisi babasının isteğini yerine getirdi?”</para>
  <para style="p" vid="MAT 21:31">“Birincisi” dediler.</para>
  <para style="p" vid="MAT 21:31">İsa onlara dedi: “Size doğrusunu söylüyorum: vergi memurları ve fahişeler <char style="w" lemma="Allahʼın Krallığı">Allahʼın Krallığıʼna</char> sizden önce girecekler. <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>Yahya size <char style="w">doğruluk</char> yolunu göstermek için geldi, ona inanmadınız. Fakat vergi memurları ve fahişeler ona inandılar. Siz ise bunları gördüğünüz halde pişmanlık duyup Yahyaʼya inanmadınız.<verse eid="MAT 21:32"/></para>
  <para style="s1">Hain bağcılar benzetmesi</para>
  <para style="r">(<ref loc="MRK 12:1-12">Markos 12:1‑12</ref>; <ref loc="LUK 20:9-19">Luka 20:9‑19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>Diğer bir benzetmeye kulak verin: Bir toprak sahibi varmış. Adam üzüm bağı dikmiş, etrafına duvar çekmiş, üzüm çiğneme çukurunu kazmış, bir de gözetleme kulesi yapmış. Sonra bağını bağcılara kiraya vermiş ve yolculuğa çıkmış. <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>Üzüm toplama zamanı yaklaşınca, bağ sahibi bağın ürününden payına düşeni almaları için kölelerini bağcıların yanına göndermiş.<verse eid="MAT 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35"/>Bağcılar da adamın kölelerini alıp birini dövmüşler, diğerini öldürmüşler, üçüncüsünü de taşlamışlar. <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>Adam sonra öncekinden daha fazla köle göndermiş. Bağcılar onlara da aynısını yapmışlar. <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>En sonunda adam, ‘Oğluma saygı gösterirler’ diyerek onlara oğlunu yollamış.<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>Ama bağcılar adamın oğlunu görünce aralarında şöyle konuşmuşlar: ‘Mirasçı budur. Haydi, onu öldürelim de, mirası ele geçirelim.’ <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>Böylece onu alıp bağdan dışarı atmışlar ve öldürmüşler.<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>O zaman bağ sahibi gelince o bağcılara ne yapacak?”<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>İsaʼya şöyle dediler: “O kötü adamları korkunç bir şekilde öldürecek. Bağı da kendisine ürünü vaktinde getirecek başka bağcılara kiraya verecek.”<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>İsa onlara şunu sordu: “Siz Kutsal Yazılarʼda şu sözleri hiç okumadınız mı?</para>
  <para style="q1" vid="MAT 21:42">‘İnşaatçıların reddettiği taş,</para>
  <para style="q2" vid="MAT 21:42">binanın köşe taşı<note caller="+" style="f"><char style="fr" closed="false">21:42 </char><char style="fk" closed="false">Binanın köşe taşı </char><char style="ft" closed="false">Köşede iki duvarı birleştiren ve dolayısıyla bütün binayı bir arada tutan binanın en önemli taşı. Bazı uzmanlara göre kemeri bir arada tutmak için yerleştirilen son taş. Bu benzetmeye göre Mesih liderler tarafından reddedilecek ve sonra kurtarıcı ve kral olacaktı.</char></note> oldu.</para>
  <para style="q1" vid="MAT 21:42">Bu iş Rabʼdendir,</para>
  <para style="q2" vid="MAT 21:42">gözümüzde harika bir şeydir.’<note caller="+" style="f"><char style="fr" closed="false">21:42 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:22">Mezmur 118:22</ref>,<ref loc="PSA 118:23">23</ref></char></char></note><verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>Bunun için size diyorum ki, <char style="w">Allahʼın Krallığı</char> sizden alınacak ve o krallığa layık ürün getiren bir millete verilecek. <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>Kim o taşın üzerine düşerse, paramparça olacak. O taş da kimin üzerine düşerse, onu ezip toz duman edecek.”<verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>
    <char style="w">Başrahipler</char> ve <char style="w">Ferisiler</char> bu benzetmeleri işitince, İsaʼnın kendileri hakkında konuştuğunu anladılar. <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>Onu yakalamak istediler ama halkın tepkisinden korktular. Çünkü halk İsaʼyı peygamber olarak kabul ediyordu.<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">Düğün benzetmesi</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luka 14:15‑24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>İsa tekrar halka benzetmeler anlatmaya başladı. Şöyle dedi: <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>“<char style="w" lemma="Göklerin Krallığı">Göklerin Krallığı</char> oğluna düğün yapan bir krala benzer. <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>Kral kölelerini gönderip düğüne davetli olanları çağırtmış. Ama gelmek istememişler.<verse eid="MAT 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4"/>Kral yine başka köleler gönderip onlara şöyle demiş: ‘Davetli olanlara şunu deyin: “İşte, ziyafetimi hazırladım, öküzlerimi ve besili danalarımı kestirdim. Artık her şey hazır, düğüne gelin.” ’<verse eid="MAT 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5"/>Ama davetliler hiç kulak asmamışlar. Herkes kendi yoluna gitmiş. Birisi tarlasına, öbürü ticaretine dönmüş. <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>Geri kalanlar da kralın kölelerini yakalamış, aşağılamış ve öldürmüşler. <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/>Kral öfkelenmiş. Ordularını gönderip o katilleri yok etmiş, şehirlerini de ateşe vermiş.<verse eid="MAT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8"/>Sonra kölelerine şöyle demiş: ‘Düğün hazır, ama davetliler buna layık değil. <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>Bunun için şehrin ana yollarına çıkın. Orada kimi bulursanız onu düğüne çağırın.’ <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>Köleler yollara düşmüşler ve iyi kötü kimi buldularsa hepsini toplamışlar. Böylece düğün salonu misafirlerle dolmuş.<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>Kral misafirlerle görüşmek için içeri girdiğinde orada düğün elbisesi giymemiş olan birini görmüş. <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>Ona şöyle demiş: ‘Arkadaş, nasıl oldu da, düğün elbisesi giymeden buraya girdin?’ Adamın dili tutulmuş.<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>O zaman kral, kölelerine şöyle demiş: ‘Onun ellerini, ayaklarını bağlayın ve onu dışarıya atın, karanlıkta kalsın.’ Orada insanlar ağlayacak ve dişlerini gıcırdatacaklar.<note caller="+" style="f"><char style="fr" closed="false">22:13 </char><char style="fk" closed="false">Dişlerini gıcırdatacaklar </char><char style="ft" closed="false">Öfke, acı ve pişmanlık gibi duyguları gösteren bir hareket.</char></note> <verse eid="MAT 22:13"/><verse number="14" style="v" sid="MAT 22:14"/>Çünkü davetliler çok, ama seçilenler az.”<verse eid="MAT 22:14"/></para>
  <para style="s1">Sezarʼa vergi ödemek</para>
  <para style="r">(<ref loc="MRK 12:13-17">Markos 12:13‑17</ref>; <ref loc="LUK 20:20-26">Luka 20:20‑26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>Sonra <char style="w">Ferisiler</char> gidip İsaʼyı kendi sözleriyle tuzağa düşürmek için plan kurdular. <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>Kendi <char style="w" lemma="öğrenci">öğrencilerini</char> <char style="w" lemma="Hirodesçiler">Hirodesçilerle</char> birlikte İsaʼya yolladılar. Bu kişiler şöyle dediler: “<char style="w" lemma="öğretmen">Öğretmenimiz</char>! Biliyoruz ki, sen dürüst bir adamsın ve Allahʼın yolunu doğru öğretiyorsun. Hiç taraf tutmuyorsun. İnsanlar arasında ayrım yapmıyorsun. <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>Peki, söyle bize, sen ne düşünüyorsun: Sezarʼa vergi ödemek Tevratʼa uygun mu, değil mi?”<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>Ama İsa onların kötü niyetini fark edip şöyle dedi: “Sizi ikiyüzlüler sizi! Neden beni tuzağa düşürmeye çalışıyorsunuz? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>Vergi öderken kullandığınız parayı bana bir gösterin!” Oʼna bir <char style="w">gümüş para</char> getirdiler. <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>İsa onlara, “Burada kimin resmi var, kimin adı yazılı?” diye sordu.<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>Oʼna, “Sezarʼın” dediler.</para>
  <para style="p" vid="MAT 22:21">Bunun üzerine İsa onlara şöyle dedi: “Öyleyse, Sezarʼın hakkını Sezarʼa verin, Allahʼın hakkını Allahʼa verin.”<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>Bunu duyunca hayret ettiler ve İsaʼyı bırakıp gittiler.<verse eid="MAT 22:22"/></para>
  <para style="s1">Diriliş hakkında soru</para>
  <para style="r">(<ref loc="MRK 12:18-27">Markos 12:18‑27</ref>; <ref loc="LUK 20:27-40">Luka 20:27‑40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>Aynı gün <char style="w">Sadukiler</char> İsaʼya geldi. Sadukiler “Ölümden diriliş diye bir şey yoktur” derler. İsaʼya şunu sordular: <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>“<char style="w" lemma="öğretmen">Öğretmenimiz</char>! Musa bize şöyle buyurdu: ‘Bir adamın kardeşi ölürse ve karısını çocuğu olmadan dul bırakırsa, o adam ölen kardeşinin karısıyla evlensin ve kardeşine soy yetiştirsin.’ <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>Aramızda yedi kardeş vardı. Birincisi evlendi fakat çocuğu olmadan öldü. Karısını kardeşine bıraktı. <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>İkincisine de, üçüncüsüne de öyle oldu. Ta yedincisine kadar hep aynı şey oldu. <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>Son olarak kadın da öldü. <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>Öyleyse, ölüler dirildiği zaman kadın bu yedi kardeşten hangisinin karısı olacak? Çünkü hepsi onunla evlenmişti.”<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>Ama İsa onlara şöyle cevap verdi: “Siz Kutsal Yazılarʼı ve Allahʼın gücünü bilmediğiniz için yanılıyorsunuz. <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>Çünkü ölüler dirildiği zaman ne karı alırlar, ne de kocaya giderler. Gökteki melekler gibi olurlar. <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>Ölülerin dirilişi hakkında Allahʼın ne söylediğini okumadınız mı? O şöyle der: <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>‘Ben İbrahimʼin Allahı, İshakʼın Allahı ve Yakubʼun Allahıʼyım.’<note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:6">Çıkış 3:6</ref></char></char></note> O, ölülerin Allahı değil, yaşayanların Allahıʼdır.”<verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>Halk bunu işitince, Oʼnun öğrettiklerine şaşırıp kaldı.<verse eid="MAT 22:33"/></para>
  <para style="s1">Tevratʼın en büyük buyruğu</para>
  <para style="r">(<ref loc="MRK 12:28-34">Markos 12:28‑34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>
    <char style="w">Ferisiler</char> İsaʼnın <char style="w" lemma="Sadukiler">Sadukileri</char> susturduğunu işitince, İsaʼnın yanına toplandılar. <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>Aralarında bir Tevrat uzmanı vardı. O, İsaʼyı tuzağa düşürmek için kendisine şu soruyu sordu: <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>“<char style="w" lemma="öğretmen">Öğretmenimiz</char>! Tevratʼta en önemli buyruk hangisidir?”<verse eid="MAT 22:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37"/>İsa ona şöyle dedi: “ ‘Allahınız Rabbi bütün yüreğinizle, bütün canınınızla ve bütün aklınızla sevin.’<note caller="+" style="f"><char style="fr" closed="false">22:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:5">Yasanın Tekrarı 6:5</ref></char></char></note> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>Birinci ve en önemli buyruk budur. <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>Ona benzeyen ikinci buyruk da şudur: ‘Komşunuzu kendinizi sevdiğiniz gibi sevin.’<note caller="+" style="f"><char style="fr" closed="false">22:39 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">Levililer 19:18</ref></char></char></note> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>Bütün Tevrat ve peygamberlerin yazdıkları bu iki buyruğa dayanır.”<verse eid="MAT 22:40"/></para>
  <para style="s1">Mesih, kimin oğlu?</para>
  <para style="r">(<ref loc="MRK 12:35-37">Markos 12:35‑37</ref>; <ref loc="LUK 20:41-44">Luka 20:41‑44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>Ferisiler toplanmışken, İsa onlara şunu sordu: <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>“Mesih hakkında ne düşünüyorsunuz? Sizce o kimin oğlu?”</para>
  <para style="p" vid="MAT 22:42">Oʼna, “Davud Oğlu” dediler.<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>İsa onlara şöyle dedi: “Peki, öyleyse, Davud Kutsal Ruh aracılığıyla ona nasıl ‘Efendim’ diyebilir? Çünkü şöyle der:<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>‘Rab Efendimʼe dedi ki:</para>
  <para style="q1" vid="MAT 22:44">“Senin düşmanlarını ayaklarının altına sereceğim.</para>
  <para style="q1" vid="MAT 22:44">O zamana kadar sağımda otur.” ’<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:1">Mezmur 110:1</ref></char></char></note><verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>Davud Mesihʼe ‘Efendim’ dediğine göre, Mesih nasıl Davudʼun oğlu olabilir?” <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>Hiç kimse İsaʼya tek bir söz bile söyleyemedi. O günden sonra kimse Oʼna soru sormaya cesaret etmedi.<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">İsa din adamlarını azarlıyor</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>Ondan sonra İsa kalabalığa ve <char style="w" lemma="öğrenci">öğrencilerine</char> şunları söyledi: <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>“Tevrat uzmanları ve <char style="w">Ferisiler</char> Musaʼnın koltuğuna oturdular.<note caller="+" style="f"><char style="fr" closed="false">23:2 </char><char style="fk" closed="false">Musaʼnın koltuğuna oturdular </char><char style="ft" closed="false">Yani, kendilerini Tevrat hakkında ders vermeye ve metnini açıklamaya yetkili saydılar.</char></note> <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>Bunun için, size söyledikleri her şeye itaat edip onu yerine getirin. Ama onlar gibi davranmayın. Çünkü onlar söyledikleri şeyleri yapmazlar. <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>Taşınması zor ağır yükleri<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="fk" closed="false">Taşınması zor ağır yükleri </char><char style="ft" closed="false">İnsanlara kabul ettirdikleri dini adetler birer ağır yüke benzer.</char></note> bağlayıp insanların omuzlarına yüklerler. Kendileriyse bu yükleri kaldırmak için parmaklarını bile kıpırdatmak istemezler.<verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>Yaptıkları bütün iyilikleri gösteriş için yaparlar. Örneğin, ayet kutularını<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="fk" closed="false">Ayet kutularını </char><char style="ft" closed="false">Allahʼın buyruklarını akılda tutmak için Tevrat ayetleri bir parça kâğıda yazılıp küçük kutulara koyulur, bu kutular da kişinin alnına ya da sol koluna bağlanırdı.</char></note> büyük ve elbiselerinin püsküllerini<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="fk" closed="false">Elbiselerinin püskülleri </char><char style="ft" closed="false">Bu püsküller Allahʼın buyruklarını yerine getirmeleri gerektiğini hatırlatan bir işaret olarak kullanılırdı.</char></note> uzun yaparlar. <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>Ziyafetlerde ve <char style="w" lemma="toplantı yeri">toplantı yerlerinde</char> en saygın yerlerde oturmayı severler. <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>Çarşılarda insanların onları selamlayıp ‘<char style="w" lemma="öğretmen">Öğretmenim</char>’ demesine bayılırlar.<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>Fakat insanlar size ‘<char style="w" lemma="öğretmen">Öğretmenim</char>’ demesinler, çünkü tek bir <char style="w" lemma="öğretmen">Öğretmeniniz</char> var, ve hepiniz kardeşsiniz. <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>Yeryüzünde kimseye ‘Baba’ unvanını vermeyin. Çünkü tek bir <char style="w" lemma="Baba">Babanız</char> var, O da göktedir. <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>Size ‘Rehber’ demesinler. Çünkü tek bir Rehberiniz var, o da Mesihʼtir. <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>Ama sizin aranızda en önemli olan, diğerlerinin hizmetkârı olsun. <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>Kendini yücelten alçaltılacak, kendini alçaltan ise yüceltilecek.<verse eid="MAT 23:12"/></para>
  <para style="p">
    <verse number="13-14" style="v" sid="MAT 23:13-14"/>Vay halinize Tevrat uzmanları ve Ferisiler, ikiyüzlüler sizi! Çünkü <char style="w" lemma="Göklerin Krallığı">Göklerin Krallığıʼnın</char> kapısını insanların yüzüne kapıyorsunuz. Hem kendiniz girmiyorsunuz, hem de girmeye hazır olanlara izin vermiyorsunuz.<note caller="+" style="f"><char style="fr" closed="false">23:13‑14 </char><char style="ft" closed="false">Bazı Grekçe el yazmalarında, “Vay halinize Tevrat uzmanları ve Ferisiler, ikiyüzlüler sizi! Bir yandan gösteriş için uzun uzun dua edersiniz, öte yandan dul kadınların malını mülkünü çalarsınız. Bundan ötürü cezanız daha ağır olacak” sözleri de bulunur.</char></note><verse eid="MAT 23:13-14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>Vay halinize ikiyüzlü Tevrat uzmanları ve Ferisiler! Çünkü tek bir kişiyi dininize çevirmek için deniz toprak aşarsınız. Adam dininize dönünce onu kendinizden iki kat daha fazla cehennemlik yaparsınız.<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>Vay halinize, halka yol gösteren körler! Diyorsunuz ki, ‘İnsan tapınak üzerine yemin ederse bu onu bağlamaz. Ama kim tapınaktaki altın üzerine yemin ederse, o artık yemini yerine getirmeye mecburdur.’ <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>Akılsızlar! Körler! Hangisi daha önemli: altın mı, yoksa altını kutsal kılan tapınak mı? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>Hem de diyorsunuz ki, ‘İnsan kurban yerinin üzerine yemin ederse, bu onu bağlamaz. Ama kim kurban yerindeki adağın üzerine yemin ederse o artık yemini yerine getirmeye mecburdur.’ <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>Sizi körler! Hangisi daha önemli: adak mı, yoksa adağı kutsal kılan kurban yeri mi? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>Bunun için, kim kurban yerinin üzerine yemin ederse, hem kurban yerinin üzerine, hem de onun üstünde olan her şeyin üzerine yemin etmiş olur. <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>Kim tapınak üzerine yemin ederse, hem tapınağın kendisi üzerine, hem de orada yaşayan Allahʼın üzerine yemin etmiş olur. <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>Kim gök üzerine yemin ederse, hem Allahʼın tahtı üzerine, hem de orada oturan Allahʼın üzerine yemin etmiş olur.<verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>Vay halinize Tevrat uzmanları ve Ferisiler, ikiyüzlüler sizi! Çünkü nanenin, dereotunun ve kimyonun ondalığını veriyorsunuz. Ama Tevratʼın adalet, merhamet ve sadakat hakkındaki buyrukları gibi daha önemli şeyleri terk ettiniz. Asıl bunları yerine getirmeli, öbür işleri de bırakmamalıydınız. <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>Kör liderler sizi! Sineği süzüp deveyi yutuyorsunuz.<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>Vay halinize ikiyüzlü Tevrat uzmanları ve Ferisiler! Çünkü bardağın ve çanağın dış tarafını temizliyorsunuz, ama bunların içi hırsızlık ve açgözlülükle dolu.<note caller="+" style="f"><char style="fr" closed="false">23:25 </char><char style="fk" closed="false">Bunların içi hırsızlık ve açgözlülükle dolu </char><char style="ft" closed="false">“Çanaktan yediklerinizi ve bardaktan içtiklerinizi hırsızlık yaparak elde ettiniz” anlamına gelebilir.</char></note> <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>Sizi kör Ferisiler! Önce bardağın ve çanağın içini temizleyin ki onun dış tarafı da temiz olsun.<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>Vay halinize ikiyüzlü Tevrat uzmanları ve <char style="w">Ferisiler</char>! Kireçli türbelere benziyorsunuz. Bu türbeler dışardan güzel görünüyor, ama içleri ölü kemikler ve her türlü pislikle doludur. <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>Aynı bunun gibi, siz de insanlara dıştan doğru dürüst görünüyorsunuz, ama içiniz ikiyüzlülük ve kanunsuzlukla dolu.<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>Vay halinize ikiyüzlü Tevrat uzmanları ve Ferisiler! Çünkü peygamberlerin türbelerini yaparsınız ve iyi insanların anıtlarını süslersiniz. <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>Hem de dersiniz ki, ‘Biz atalarımızın zamanında yaşasaydık, peygamberlerin kanını dökenlere yardım etmezdik.’ <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>Bunu söylerken peygamberleri öldürenlerin torunları olduğunuza kendiniz şahitsiniz. <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>O halde durmayın, atalarınızın başlattığı işi bitirin.<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>Hey, sizi yılanlar, sizi zehirli yılan soyu! Cehennemin cezasından nasıl kaçıp kurtulacaksınız? <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>Bu yüzden, bakın, ben size peygamberler, hikmetli adamlar ve Tevrat uzmanları göndereceğim. Onların bazılarını öldüreceksiniz, çarmıha gereceksiniz. Bazılarını da <char style="w" lemma="toplantı yeri">toplantı yerlerinizde</char> kamçılayıp kasabadan kasabaya kovacaksınız. <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>Öyle ki, suçsuz Habilʼin kanından, Berekya oğlu Zekeriyaʼnın kanına kadar yeryüzünde ne kadar suçsuz kan dökülmüşse, siz hepsinden sorumlu tutulacaksınız. Zekeriyaʼyı siz tapınakla kurban yerinin arasında öldürdünüz. <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>Size doğrusunu söylüyorum: bütün bunların hesabını bu kuşak ödeyecek.<verse eid="MAT 23:36"/></para>
  <para style="s1">İsa Yeruşalim halkını uyarıyor</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>Ey <char style="w">Yeruşalim</char>, Yeruşalim! Peygamberleri öldüren ve sana gönderilen elçileri taşlayan şehir! Tavuk civcivlerini kanatlarının altına nasıl toplarsa, ben de senin evlatlarını kaç defa öyle toplamak istedim. Ama siz istemediniz. <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>Bakın, tapınağınız size terk edilmiş durumda bırakılacak.<note caller="+" style="f"><char style="fr" closed="false">23:38 </char><char style="fk" closed="false">Tapınağınız size terk edilmiş durumda bırakılacak </char><char style="ft" closed="false">Allah tapınağı terk edecek, düşmanlar tarafından yıkılmasına izin verecek.</char></note> <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>Size şunu diyorum, ‘Rabbin <char style="w" lemma="ad">adıyla</char> gelene övgüler olsun!’<note caller="+" style="f"><char style="fr" closed="false">23:39 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:26">Mezmur 118:26</ref></char></char></note> diyene kadar beni bir daha görmeyeceksiniz.”<verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">Tapınağın yıkılışı ve dünyanın sonu</para>
  <para style="r">(<ref loc="MRK 13:1-31">Markos 13:1‑31</ref>; <ref loc="LUK 21:5-37">Luka 21:5‑37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>İsa, tapınak avlusundan çıkmış yoluna devam ediyordu. <char style="w" lemma="öğrenci">Öğrencileri</char> Oʼna tapınak binalarını göstermek için yaklaştılar. <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>Ama İsa onlara şöyle karşılık verdi: “Bütün bunları görüyor musunuz? Size doğrusunu söylüyorum: burada taş üstünde taş bırakılmayacak, hepsi yıkılacak.”<verse eid="MAT 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>İsa Zeytin Dağıʼnda tek başına otururken öğrencileri yanına gelip şöyle dediler: “Bize söyle, bu şeyler ne zaman olacak? Senin görkemli gelişini ve dünyanın sonunu gösteren işaret nedir?”<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>İsa onlara şöyle cevap verdi: “Bakın kimse sizi aldatmasın. <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>Birçok kişi benim adımı kullanarak gelecek. ‘Mesih benim’ diyecek ve birçok kişiyi aldatacak. <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>Savaş gürültüleri ve savaş haberleri duyacaksınız. Sakın korkmayın! Bunların olması lazım, ama dünyanın sonu hemen gelmeyecek. <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>Millet millete, devlet devlete saldıracak. Kimi yerlerde kıtlıklar ve depremler olacak. <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>Bütün bu olaylar doğum yapan kadının ilk sancıları gibi, sıkıntıların başlangıcıdır.<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>O zaman sizi tutuklayıp eziyet edecekler, sizi öldürecekler. Benim adım yüzünden bütün milletler sizden nefret edecek. <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>O zaman birçokları imandan dönecek, birbirlerine ihanet edecek ve birbirlerinden nefret edecekler. <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>Bir sürü sahte peygamber kalkıp birçok insanı yoldan saptıracak. <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>Kanunsuzluk çoğalacak ve bunun için birçoklarının sevgisi soğuyacak. <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>Ama kim sonuna kadar dayanırsa, o kurtulacak. <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>Bütün milletlere şahitlik olsun diye <char style="w">Göklerin Krallığı</char> hakkındaki bu <char style="w">Müjde</char> tüm dünyada duyurulacak. İşte, o zaman son gelecek.<verse eid="MAT 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>Peygamber Daniel tapınakta dikilen, oranın ‘kutsallığını bozan rezalet’<note caller="+" style="f"><char style="fr" closed="false">24:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="DAN 9:27">Daniel 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char></char></note> hakkında konuşmuştu. (Okuyan anlasın!) <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>Bunu görünce Yahudiye bölgesinde olanlar dağlara kaçsınlar. <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>Evin damında olan kişi aşağı insin ama evinden bir şey almasın. <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>Tarlada olan kişi paltosunu almak için geri dönmesin. <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>Vay o günlerde hamile olanların ve bebek emzirenlerin haline! <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>Dua edin ki, kaçışınız kışa ya da <char style="w">Şabat</char> gününe rast gelmesin. <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>Çünkü o günler büyük bir eziyet zamanı olacak. Dünyanın başlangıcından beri böyle bir eziyet olmadı, bir daha da olmayacak. <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>O günler kısaltılmasaydı, hiçbir insan kurtulmazdı. Fakat Allah seçtiği kişilerin hatırı için o günleri kısaltacak.<verse eid="MAT 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23"/>O zaman size birisi, ‘Bak, Mesih burada!’ ya da, ‘Bak, orada!’ derse, inanmayın. <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>Çünkü ‘Ben Mesihʼim’ ve ‘Ben peygamberim’ diyen yalancılar ortaya çıkacaklar. Ellerinden gelse Allahʼın seçtiği insanları bile saptırmak için büyük mucizeler ve harikalar yapacaklar. <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>İşte, size önceden söylüyorum. <verse eid="MAT 24:25"/><verse number="26" style="v" sid="MAT 24:26"/>Yani ‘Bakın, Mesih ıssız yerdedir’ derlerse, oraya çıkmayın. ‘Bakın, iç odadadır’ derlerse, inanmayın. <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>Çünkü nasıl şimşek doğudan çakıp batıya kadar her tarafı aydınlatırsa <char style="w" lemma="İnsan Oğlu">İnsan Oğluʼnun</char> görkemli gelişi de aynı öyle olacak. <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/>Leş neredeyse, <char style="w" lemma="akbaba">akbabalar</char> da oraya toplanır.<verse eid="MAT 24:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>Ama o günlerin eziyetinden hemen sonra,</para>
  <para style="q1" vid="MAT 24:29">‘güneş kararacak,</para>
  <para style="q2" vid="MAT 24:29">ay da ışığını vermeyecek.</para>
  <para style="q1" vid="MAT 24:29">Yıldızlar gökten düşecek</para>
  <para style="q2" vid="MAT 24:29">ve gökteki güçler sarsılacak.’<note caller="+" style="f"><char style="fr" closed="false">24:29 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 13:10">Yeşaya 13:10</ref>; <ref loc="ISA 34:4">34:4</ref></char></char></note><verse eid="MAT 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30"/>O zaman İnsan Oğluʼnun işareti gökte görünecek. O vakit dünyanın bütün halkları ağlayıp dövünecekler. İnsan Oğluʼnun gökteki bulutların üzerinde kudret ve büyük görkemle geldiğini görecekler. <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>İnsan Oğlu güçlü bir borazan sesiyle meleklerini gönderecek. Onlar da Oʼnun seçtiği kişileri dünyanın dört bucağından, göğün bir ucundan öbür ucuna kadar toplayacaklar.<verse eid="MAT 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>Şimdi de, incir ağacından bir ders alın: dalları filizlenip yaprak çıkarınca, yaz mevsiminin yaklaştığını bilirsiniz. <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>Bunun gibi, bütün bu şeyleri gördüğünüz zaman bileceksiniz ki, <char style="w">Allahʼın Krallığı</char> yakındır,<note caller="+" style="f"><char style="fr" closed="false">24:33 </char><char style="fk" closed="false">Allahʼın Krallığı yakındır </char><char style="ft" closed="false">Asıl metinde: “O yakındır.” <char style="xt"><ref loc="LUK 21:31">Luka 21:31</ref></char> ayetine bakarak bilinmeyen konunun Allahʼın Krallığı olduğu anlaşılır.</char></note> kapıdadır. <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>Size doğrusunu söylüyorum: bütün bu şeyler yerine gelmeden bu kuşak yok olmayacak. <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>Gök ve yer ortadan kalkacak, ama benim sözlerim asla ortadan kalkmayacak.<verse eid="MAT 24:35"/></para>
  <para style="s1">Kimse günü ve saati bilmiyor</para>
  <para style="r">(<ref loc="MRK 13:32-37">Markos 13:32‑37</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>Yalnız, o günü ve o saati hiç kimse bilmiyor: ne gökteki melekler, ne de <char style="w">Oğul</char>, sadece <char style="w">Baba</char> biliyor. <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>Çünkü Nuhʼun günlerinde nasıl olmuşsa, <char style="w" lemma="İnsan Oğlu">İnsan Oğluʼnun</char> gelişinde de öyle olacak. <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>Tufandan önceki o günlerde yiyip içerlerdi, karı alıp kocaya giderlerdi. Bunlar Nuhʼun gemiye bindiği güne kadar devam etti. <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>Tufan gelip onların hepsini götürene kadar bir şey anlamadılar. İnsan Oğluʼnun görkemli gelişi de aynı öyle olacak. <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>O vakit tarlada bulunan iki adamdan birisi alınacak, öbürü bırakılacak. <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>Bir değirmende buğday öğüten iki kadından birisi alınacak, öbürü bırakılacak.<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>Bunun için tetikte durun. Çünkü Efendinizʼin hangi günde geleceğini bilmiyorsunuz. <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>Şunu da bilin: Eğer ev sahibi hırsızın gecenin hangi saatinde geleceğini bilseydi, tetikte durur, evinin soyulmasına izin vermezdi. <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>Bunun için, siz de hazır olun. Çünkü İnsan Oğlu beklemediğiniz saatte gelecek.<verse eid="MAT 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>Sadık ve akıllı köle kimdir ki efendisi onu diğer kölelerin başına koyar ve onlara zamanında yiyecek vermesini buyurur? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>Efendisinin eve döndüğünde işinin başında bulacağı o köleye ne mutlu! <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>Size doğrusunu söylüyorum: efendisi bu köleyi sahip olduğu bütün malın ve mülkün başına koyacak. <verse eid="MAT 24:47"/><verse number="48-49" style="v" sid="MAT 24:48-49"/>Ama o köle kötü niyetliyse ve kendi içinden ‘Efendimin gelmesine daha çok vakit var’ derse, arkadaşlarını dövmeye ve içkicilerle birlikte yiyip içmeye başlar. <verse eid="MAT 24:48-49"/><verse number="50" style="v" sid="MAT 24:50"/>O zaman efendisi kölenin hiç beklemediği bir gün, hiç bilmediği bir saatte gelecek. <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>Onu şiddetle cezalandıracak ve ikiyüzlülerin yanında ona yer verecek. Orada ağlayacak ve dişlerini gıcırdatacaklar.”<note caller="+" style="f"><char style="fr" closed="false">24:51 </char><char style="fk" closed="false">Dişlerini gıcırdatacaklar </char><char style="ft" closed="false">Öfke, acı ve pişmanlık gibi duyguları gösteren bir hareket.</char></note><verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">On kız benzetmesi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>“O zaman <char style="w">Göklerin Krallığı</char> lambalarını alıp damadı karşılamaya çıkan on genç kıza benzeyecek. <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>Bunların beşi akılsız, beşi ise akıllıymış. <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>Akılsız kızlar lambalarını almış, ama yanlarına yedek yağ almamışlar. <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>Akıllı kızlar ise yanlarına hem lambalarını hem de yağ kaplarını almışlar. <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>Ama damat gecikince hepsini uyku basmış ve uyumuşlar.<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>Gece yarısı biri şöyle bağırmış: ‘Bakın, damat geliyor! Onu karşılamaya çıkın!’<verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>O vakit bütün kızlar kalkıp lambalarını hazırlamışlar. <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>Akılsız kızlar, akıllı olanlara şöyle demişler: ‘Bize yağınızdan azıcık verin, lambalarımız sönüyor.’<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>Ama akıllı kızlar şöyle karşılık vermiş: ‘Hayır olmaz! Yağ hem bize, hem size yetmeyecek. Bunun yerine satıcılara gidin, kendinize yağ alın.’<verse eid="MAT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10"/>Onlar yağ almaya giderken, damat gelmiş ve hazırlıklı kızlar onunla birlikte içeri girip düğüne katılmışlar. Ardından kapı kilitlenmiş.<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>Sonra da öbür kızlar gelip, ‘Efendimiz, Efendimiz, kapıyı aç bize!’ demişler.<verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>Ama damat şöyle cevap vermiş: ‘Size doğrusunu söylüyorum: sizi tanımıyorum.’<verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>Bunun için, tetikte durun, çünkü geleceğim günü ve saati bilemezsiniz.<verse eid="MAT 25:13"/></para>
  <para style="s1">Emanet para benzetmesi</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>Göklerin Krallığı şuna benzer: adamın biri yolculuğa çıkmış, gitmeden önce kölelerini çağırmış ve mallarını onlara emanet etmiş. <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>Birine beş çuval, birine iki, birine de bir çuval altın<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="fk" closed="false">Çuval altın </char><char style="ft" closed="false">Grekçe, talant. İşçinin 15 yılda kazanacağı para.</char></note> vermiş. Herkese kendi yeteneğine göre vermiş. Sonra yolculuğa çıkmış. <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>Beş çuvalı alan hemen gitmiş, onlarla ticaret etmeye başlamış ve beş çuval altın daha kazanmış. <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>Aynı bunun gibi, iki çuvalı alan da, iki çuval altın daha kazanmış. <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>Ama bir çuval altın alan, gidip toprağı kazmış, efendisinin parasını oraya saklamış.<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>Uzun zaman sonra, o kölelerin efendisi gelmiş ve onların hesabını görmeye başlamış. <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>Beş çuval altın almış olan gelip beş çuval daha getirmiş ve şöyle demiş: ‘Efendimiz! Sen bana beş çuval altın emanet ettin, bak, beş çuval daha kazandım.’<verse eid="MAT 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21"/>Efendisi ona şöyle demiş: ‘Aferin! Sen iyi ve güvene layık bir kölesin. Küçük işlerde güvene layık çıktın, ben de seni büyük işlerin başına geçireceğim. Efendinin sevincine katıl.’<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>Sonra iki çuval altın almış olan gelip iki çuval daha getirmiş ve şöyle demiş: ‘Efendimiz! Sen bana iki çuval altın emanet ettin, bak, iki çuval daha kazandım.’<verse eid="MAT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23"/>Efendisi ona şöyle demiş: ‘Aferin! Sen iyi ve güvene layık bir kölesin. Küçük işlerde güvene layık çıktın, ben de seni büyük işlerin başına geçireceğim. Efendinin sevincine katıl.’<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>Sonra bir çuval altın almış olan gelip şöyle demiş: ‘Efendimiz, senin sert bir adam olduğunu biliyordum. Ekmediğin yerden biçersin ve harman savurmadığın yerden toplarsın. <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>Bu sebeple korktum ve gidip senin çuvalını toprağa sakladım. İşte al malını!’<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>Efendisi ona şöyle cevap vermiş: ‘Seni kötü ve tembel köle seni! Benim ekmediğim yerden biçtiğimi ve harman savurmadığım yerden topladığımı bilirdin. <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>Öyleyse paramı bankaya koymalıydın. O zaman döndüğümde paramı faiziyle birlikte geri alırdım.’<verse eid="MAT 25:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28"/>Sonra diğer kölelere şöyle emretmiş: ‘Onun çuvalını alın ve kendisinde on çuval altın olan köleye verin. <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>Çünkü kim sahip olduğu şeyleri kullanırsa, ona daha çok verilecek, bolluğa kavuşacak. Ama kim kullanmazsa, elindeki de alınacak. <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>Şu yaramaz köleyi dışarıya atın, karanlıkta kalsın. Orada insanlar ağlayacak ve dişlerini gıcırdatacaklar.’<note caller="+" style="f" category="dup"><char style="fr" closed="false">25:30 </char><char style="fk" closed="false">Dişlerini gıcırdatacaklar </char><char style="ft" closed="false">Öfke, acı ve pişmanlık gibi duyguları gösteren bir hareket.</char></note><verse eid="MAT 25:30"/></para>
  <para style="s1">Milletlerin yargılancağı gün</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>
    <char style="w">İnsan Oğlu</char> bütün meleklerle birlikte kendi görkemiyle gelecek. O zaman görkemli tahtında oturacak. <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>Bütün milletler Oʼnun önünde toplanacaklar. O da çobanın koyunları keçilerden ayırdığı gibi, insanları birbirlerinden ayıracak. <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>Koyunları sağ tarafına, keçileri de sol tarafına alacak.<verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>O zaman Kral sağ tarafındaki insanlara şöyle diyecek: ‘Ey <char style="w" lemma="Baba">Babamʼın</char> övgüsünü alanlar, gelin! Dünyanın yaratılışından beri sizin için hazırlanan Krallığı miras alın. <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>Çünkü açtım, bana yiyecek verdiniz. Susamıştım, bana su verdiniz. Yabancıydım, bana kapı açtınız. <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>Çıplaktım, beni giydirdiniz. Hastaydım, bana baktınız. Hapisteydim, ziyaretime geldiniz.’<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>O zaman <char style="w">doğru</char> kişiler Oʼna şöyle cevap verecekler: ‘Efendimiz, ne zaman seni aç gördük de, doyurduk? Ne zaman seni susuz gördük de, su verdik? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>Ne zaman seni yabancı gördük de sana kapımızı açtık, çıplak gördük de seni giydirdik? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>Ne zaman seni hasta ya da hapiste gördük de, ziyaret ettik?’<verse eid="MAT 25:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40"/>Kral onlara şöyle cevap verecek: ‘Size doğrusunu söylüyorum: Bu en önemsiz kardeşlerimden birine ne yaptınızsa onu bana yapmış olursunuz.’<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>Sonra Kral, sol tarafındakilere şöyle diyecek: ‘Yıkılın karşımdan, lanetli insanlar! <char style="w">İblis</char> ve onun melekleri için hazırlanan, hiç sönmeyen ateşe gidin! <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>Çünkü açtım, bana yiyecek vermediniz. Susamıştım, bana su vermediniz. <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>Yabancıydım, bana kapı açmadınız. Çıplaktım, beni giydirmediniz. Hasta ve hapisteydim, beni ziyaret etmediniz.’<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>O zaman o kişiler şöyle cevap verecekler: ‘Efendimiz, seni ne vakit aç, susuz, yabancı, çıplak, hasta ya da hapiste gördük de sana yardım etmedik?’<verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>Kral onlara şöyle karşılık verecek: ‘Size doğrusunu söylüyorum: Bu en önemsiz kişilerden birine yapmadığınız şeyi bana da yapmamış oldunuz.’<verse eid="MAT 25:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46"/>Bunlar sonsuz cezaya uğrayacaklar. Ama <char style="w">doğru</char> olanlar sonsuz yaşama kavuşacaklar.”<verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">İsaʼyı öldürme planı</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>İsa bütün bunları söyledikten sonra <char style="w" lemma="öğrenci">öğrencilerine</char> şöyle dedi: <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>“Biliyorsunuz, iki gün sonra <char style="w">Özgürlük Bayramı</char> olacak. O zaman <char style="w">İnsan Oğlu</char> Oʼnu çarmıha gerecek olanlara teslim edilecek.”<verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>O arada <char style="w">başrahipler</char> ve halkın liderleri, Kayafa adındaki başrahibin evinde toplandılar. <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>İsaʼyı hileyle yakalayıp öldürmek için anlaştılar. <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>“Aman!” dediler. “Bayramda olmasın. Yoksa halkın arasında ayaklanma olabilir.”<verse eid="MAT 26:5"/></para>
  <para style="s1">İsa Beytanya köyünde</para>
  <para style="r">(<ref loc="MRK 14:3-9">Markos 14:3‑9</ref>; <ref loc="JHN 12:1-8">Yuhanna 12:1‑8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>İsa Beytanya köyünde, Simun adında bir adamın evindeydi. Simun daha önce <char style="w">cüzzam</char> hastasıydı. <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>O zaman bir kadın kaymaktaşı bir kapla İsaʼya yaklaştı. Kabın içinde çok pahalı, güzel kokulu yağ vardı. İsa sofrada otururken, kadın yağı yavaşça Oʼnun başına döktü.<verse eid="MAT 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8"/>İsaʼnın <char style="w" lemma="öğrenci">öğrencileri</char> bunu görünce kızdılar. “Nedir bu ziyan?” dediler. <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>“Bu yağ çok yüksek fiyata satılıp parası fakirlere dağıtılabilirdi.”<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>İsa bunu fark edince onlara şöyle dedi: “Niçin kadını üzüyorsunuz? O bana güzel bir şey yaptı. <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>Fakirler her zaman sizinle olacak. Ama ben her zaman sizinle olmayacağım. <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>Kadın bu yağı bedenime sürerek beni gömülmeye hazırladı. <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>Size doğrusunu söylüyorum: <char style="w">Müjde</char> dünyanın neresinde duyurulursa, bu kadının yaptığı da anılacak.”<verse eid="MAT 26:13"/></para>
  <para style="s1">Yahudaʼnın ihaneti</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>Ondan sonra, İsaʼnın on iki <char style="w" lemma="elçi">elçisinden</char> biri olan Yahuda İskariyot <char style="w" lemma="başrahipler">başrahiplere</char> gitti. <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>Onlara şöyle dedi: “İsaʼyı size teslim edersem bana ne verirsiniz?” Ona otuz gümüş para saydılar. <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>Yahuda o zamandan sonra İsaʼyı onların eline vermek için uygun bir fırsat aradı.<verse eid="MAT 26:16"/></para>
  <para style="s1">Bayram yemeği</para>
  <para style="r">(<ref loc="MRK 14:12-26">Markos 14:12‑26</ref>; <ref loc="LUK 22:7-23">Luka 22:7‑23</ref>; <ref loc="JHN 13:18-30">Yuhanna 13:18‑30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>
    <char style="w" lemma="Mayasız Ekmek Bayramı">Mayasız Ekmek Bayramıʼnın</char> birinci gününde, İsaʼnın <char style="w" lemma="öğrenci">öğrencileri</char> Oʼna geldiler, “<char style="w" lemma="Özgürlük Bayramı">Özgürlük Bayram</char> yemeğini sana nerede hazırlayalım?” diye sordular.<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>İsa dedi: “Şehre gidin, tanıdığım bir adamın yanına varıp şöyle deyin: ‘<char style="w" lemma="öğretmen">Öğretmenimiz</char> diyor ki, Artık vaktim geldi, Özgürlük Bayramıʼnı öğrencilerimle birlikte senin evinde kutlayacağım.’ ” <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/><char style="w" lemma="öğrenci">Öğrenciler</char> İsaʼnın dediğini yerine getirdiler. Böylece <char style="w" lemma="Özgürlük Bayramı">Özgürlük Bayram</char> hazırlıklarını yaptılar.<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>Akşam olunca, İsa on iki <char style="w" lemma="elçi">elçisiyle</char> birlikte sofraya oturdu. <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>Yemek yerlerken İsa şöyle dedi: “Size doğrusunu söylüyorum: sizden biri bana ihanet edecek.”<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>Buna çok üzüldüler. Teker teker İsaʼya sormaya başladılar: “Efendimiz, beni demek istemedin ya?”<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>İsa şöyle cevap verdi: “Benimle birlikte eliyle ekmeğini çanağa bandıran adam bana ihanet edecek. <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>Gerçi, <char style="w">İnsan Oğlu</char> tıpkı kendisi hakkında yazıldığı gibi ölüme gidiyor. Ama İnsan Oğluʼna ihanet eden adamın vay haline! O adam hiç doğmasaydı, onun için daha iyi olurdu.”<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>İsaʼya ihanet edecek olan Yahuda, “<char style="w" lemma="öğretmen">Öğretmenim</char>, herhalde bu ben değilim?” diye sordu.</para>
  <para style="p" vid="MAT 26:25">İsa ona, “Sen kendin söyledin” dedi.<verse eid="MAT 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>Onlar yemek yerken, İsa eline ekmek aldı, şükredip onu böldü. Ekmeği <char style="w" lemma="öğrenci">öğrencilerine</char> verirken şöyle dedi: “Alın, yiyin! Bu benim bedenimdir.”<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>Sonra eline bir bardak şarap aldı, şükretti ve onlara verip şöyle dedi: “Hepiniz bundan için. <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>Çünkü bu benim kanımdır, antlaşma kanıdır. Birçok insanın günahlarının bağışlanması için akıtılıyor. <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>Size söylüyorum, göksel <char style="w" lemma="Baba">Babamʼın</char> Krallığıʼnda sizinle birlikte yenisini içeceğim güne kadar asmanın bu ürününden bir daha içmeyeceğim.”<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>İlahi söyledikten sonra, İsa ve <char style="w" lemma="öğrenci">öğrencileri</char> çıkıp Zeytin Dağıʼna doğru gittiler.<verse eid="MAT 26:30"/></para>
  <para style="s1">İsa Petrusʼun inkârını önceden bildiriyor</para>
  <para style="r">(<ref loc="MRK 14:27-31">Markos 14:27‑31</ref>; <ref loc="LUK 22:31-34">Luka 22:31‑34</ref>; <ref loc="JHN 13:36-38">Yuhanna 13:36‑38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>Sonra İsa onlara şöyle dedi: “Bu gece başıma gelenler yüzünden hepinizin inancı sarsılacak. Çünkü şöyle yazılmıştır: Allah diyor ki,</para>
  <para style="q1" vid="MAT 26:31">‘Çobanı vuracağım,</para>
  <para style="q2" vid="MAT 26:31">sürüdeki koyunlar da darmadağın olacak.’<note caller="+" style="f"><char style="fr" closed="false">26:31 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 13:7">Zekeriya 13:7</ref></char></char></note><verse eid="MAT 26:31"/></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32"/>Ama ben ölüp dirildikten sonra önünüzden Celileʼye gideceğim.”<verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>Petrus İsaʼya şöyle cevap verdi: “Senin başına gelenler yüzünden herkesin inancı sarsılsa da, benimki asla sarsılmaz.”<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>İsa ona şöyle dedi: “Sana doğrusunu söylüyorum: bu gece, horoz ötmeden, sen beni üç defa inkâr edeceksin.”<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>Petrus şöyle karşılık verdi: “Seninle birlikte ölmem lazımsa bile, seni asla inkâr etmem.” Bütün <char style="w" lemma="öğrenci">öğrenciler</char> de aynısını söylediler.<verse eid="MAT 26:35"/></para>
  <para style="s1">Getsemani bahçesinde</para>
  <para style="r">(<ref loc="MRK 14:32-42">Markos 14:32‑42</ref>; <ref loc="LUK 22:39-46">Luka 22:39‑46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>Bunun üzerine İsa onlarla birlikte Getsemani denilen bahçeye gitti. İsa <char style="w" lemma="öğrenci">öğrencilerine</char> şöyle dedi: “Ben şuraya kadar gidip dua edeceğim. Siz burada oturun.” <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>Yanına Petrusʼu ve Zebediʼnin iki oğlunu aldı. Üzüntü ve derin bir sıkıntı hissetmeye başladı. <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>Bunun üzerine onlara şunu söyledi: “Ben ölüm derecesinde üzüntülüyüm. Burada kalın ve benimle birlikte uyanık durun.”<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>İsa biraz ileri gitti, yüzüstü yere kapandı ve şöyle dua etmeye başladı: “<char style="w">Baba</char>, mümkünse, bu bardak<note caller="+" style="f"><char style="fr" closed="false">26:39 </char><char style="fk" closed="false">Bardak </char><char style="ft" closed="false">Allahʼın insanları cezalandırması bardaktan boşaltılan sersemletici içkiye benzetilir. Buradaki “bardak” sözü, İsaʼnın çarmıhta insanların yerine günahlarının cezasını çekmesini anlatır.</char></note> benden geçsin. Yine de, benim istediğim değil, senin istediğin olsun.”<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>İsa <char style="w" lemma="öğrenci">öğrencilerine</char> döndü, onları uykuda buldu. Petrusʼa şöyle dedi: “Demek ki, bir saat bile, benimle birlikte uyanık duramadınız. <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>Uyanık durun. Denendiğinizde günaha düşmemek için dua edin. Ruh istekli, ama beden zayıftır.”<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>İsa ikinci defa gidip şöyle dua etti: “Baba, eğer ben içmeden bu bardağın<note caller="+" style="f"><char style="fr" closed="false">26:42 </char><char style="fk" closed="false">Bu bardağın </char><char style="ft" closed="false">Bakınız <char style="xt" link-href="MAT 26:39">ayet <ref loc="MAT 26:39">39</ref></char>ʼdaki dipnota.</char></note> benden alınması mümkün değilse, o vakit senin istediğin olsun.”<verse eid="MAT 26:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43"/>Bir daha geldiğinde onları uykuda buldu, çünkü gözlerini açık tutamıyorlardı. <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>Bu sefer onları bırakıp döndü ve üçüncü defa aynı sözlerle dua etti.<verse eid="MAT 26:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45"/>Bunun üzerine <char style="w" lemma="öğrenci">öğrencilere</char> gelip şöyle dedi: “Hâlâ uyuyor ve dinleniyorsunuz! Bakın, <char style="w" lemma="İnsan Oğlu">İnsan Oğluʼnun</char> günahkârların eline teslim edileceği saat geldi. <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>Kalkın, gidelim. Bakın, bana ihanet eden adam yaklaşıyor!”<verse eid="MAT 26:46"/></para>
  <para style="s1">İsa tutuklanıyor</para>
  <para style="r">(<ref loc="MRK 14:43-50">Markos 14:43‑50</ref>; <ref loc="LUK 22:47-53">Luka 22:47‑53</ref>; <ref loc="JHN 18:1-11">Yuhanna 18:1‑11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>İsa daha konuşurken, işte, on iki <char style="w" lemma="elçi">elçisinden</char> biri olan Yahuda geldi. Yanında büyük bir kalabalık vardı. Kılıçlar ve sopalar taşıyorlardı. <char style="w">Başrahipler</char> ve halkın liderleri onları yollamıştı. <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>İsaʼya ihanet eden Yahuda onlara şöyle bir işaret vermişti: “Ben kimi öpersem, İsa Oʼdur. Oʼnu yakalayın.” <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/>Dosdoğru İsaʼya yaklaşıp, “Selam, <char style="w" lemma="öğretmen">Öğretmenim</char>!” dedi ve Oʼnu öptü.<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>İsa ona, “Arkadaş!” dedi. “Yapmaya geldiğin işi yap!”</para>
  <para style="p" vid="MAT 26:50">Sonra adamlar gelip İsaʼyı yakalayıp tutukladılar. <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>İsaʼyla birlikte olanlardan biri ani bir hareketle kılıcını çekip başrahibin kölesinin kulağını kesti.<verse eid="MAT 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52"/>O vakit İsa o kişiye, “Kılıcını yerine koy!” dedi. “Çünkü her kim kılıç çekerse, kendisi kılıçla ölür. <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>Yoksa göksel <char style="w" lemma="Baba">Babamʼdan</char> yardım rica edemez miyim sanıyorsun? O zaman O hemen emrime on iki ordudan fazla melek koyar. <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>Ama o vakit her şeyin böyle olması gerektiğini söyleyen Kutsal Yazılar nasıl yerine gelecek?”<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>Sonra İsa kalabalığa dönerek, “Haydut muyum ki beni kılıçlarla, sopalarla yakalamaya çıktınız?” dedi. “Her gün tapınak avlusunda oturup vaaz ederdim ve beni tutuklamadınız. <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>Ama bütün bunlar peygamberlerin yazdıkları yerine gelsin diye oldu.” Bunun üzerine bütün <char style="w" lemma="öğrenci">öğrencileri</char> İsaʼyı bırakıp kaçtılar.<verse eid="MAT 26:56"/></para>
  <para style="s1">İsa Yüksek Meclisʼin önünde</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>İsaʼyı yakalayanlar Oʼnu <char style="w">Başrahip</char> Kayafaʼnın önüne götürdüler. Tevrat uzmanları ve liderler orada toplanmıştı. <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>Petrus ise İsaʼyı uzaktan izledi. Sonunda başrahibin avlusuna yetişti. İçeri girip görevlilerle birlikte oturdu. Bu işin sonu ne olacak diye merak ediyordu.<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>
    <char style="w">Başrahipler</char> ve <char style="w" lemma="Meclis">Meclisʼin</char> öbür üyeleri İsaʼyı ölüm cezasına çarptırabilmek için Oʼna karşı şahitlik yapacak birilerini bulmaya çalışıyorlardı.<verse eid="MAT 26:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MAT 26:60"/>Bir sürü yalancı şahit öne çıktıysa da, aradıklarını bulamadılar. En sonunda iki kişi öne çıkıp şöyle dedi: <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>“Bu adam, ‘Allahʼın tapınağını yıkabilirim ve üç gün sonra onu yeniden kurabilirim’ dedi.”<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>
    <char style="w">Başrahip</char> ayağa kalkıp İsaʼya şunu sordu: “Bu adamların sana karşı yaptıkları şahitliklere cevabın yok mu?” <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>Ama İsa hep sustu.</para>
  <para style="p" vid="MAT 26:63">Başrahip Oʼna şöyle dedi: “Diri olan Allahʼın adına sana yemin ettiriyorum, söyle bize, <char style="w">Allahʼın Oğlu</char> Mesih sen misin?”<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>İsaʼnın cevabı şuydu: “Sen kendin söyledin. Yine de size söylüyorum: Bundan sonra <char style="w" lemma="İnsan Oğlu">İnsan Oğluʼnun</char> kudret Sahibiʼnin sağında oturduğunu,<note caller="+" style="f"><char style="fr" closed="false">26:64 </char><char style="fk" closed="false">kudret Sahibiʼnin sağında oturduğunu </char><char style="ft" closed="false">İsa kendisinin Allahʼın yanında en önemli ve en yetkili yere layık olduğunu söylüyordu.</char></note> ve gökteki bulutların üzerinde geldiğini göreceksiniz.”<verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>Bunun üzerine <char style="w">başrahip</char> elbiselerini yırttı<note caller="+" style="f"><char style="fr" closed="false">26:65 </char><char style="fk" closed="false">Başrahip elbiselerini yırttı </char><char style="ft" closed="false">Allahʼa hakaret etme suçunun ne kadar ağır bir suç olduğunu gösteren törensel davranış.</char></note> ve şöyle dedi: “Allahʼa hakaret etti. Artık şahitlere ne ihtiyacımız var? Kendini Allahʼla bir saydığını siz kendiniz işittiniz. <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>Kararınız ne?”</para>
  <para style="p" vid="MAT 26:66">Meclisʼtekiler şöyle cevap verdiler: “Ölümü hak etti!”<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>Ondan sonra İsaʼnın yüzüne tükürdüler. Oʼnu yumruklayarak dövdüler. Bazıları Oʼnu tokatladılar. <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>“Ey Mesih! Haydi peygamberliğini göster! Sana vuran kim?” dediler.<verse eid="MAT 26:68"/></para>
  <para style="s1">Petrus İsaʼyı inkâr ediyor</para>
  <para style="r">(<ref loc="MRK 14:66-72">Markos 14:66‑72</ref>; <ref loc="LUK 22:54-62">Luka 22:54‑62</ref>; <ref loc="JHN 18:15-18">Yuhanna 18:15‑18</ref>,<ref loc="JHN 18:25-27">25‑27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>Bu arada Petrus dışarda avluda oturuyordu. Bir hizmetçi kız gelip ona şöyle dedi: “Sen de Celileli İsaʼyla birlikteydin.”<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>Ama Petrus bunu herkesin önünde inkâr edip, “Ne söylediğini anlamıyorum!” dedi.<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>Sonra avlunun kapısının önüne çıktı. O vakit başka bir hizmetçi kız Petrusʼu gördü ve orada duranlara, “Bu adam Nasıralı İsaʼyla birlikteydi” dedi.<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>Petrus ise yemin ederek “Ben o adamı tanımıyorum!” diye yine inkâr etti.<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>Az sonra orada duranlar yaklaşıp Petrusʼa şöyle dediler: “Elbette sen de onlardansın. Konuşman seni ele veriyor.”<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>Bunun üzerine Petrus lanet okuyarak yemin etti: “O adamı tanımıyorum!”</para>
  <para style="p" vid="MAT 26:74">O anda horoz öttü. <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>O vakit Petrus, İsaʼnın ona söylediği sözleri hatırladı: “Horoz ötmeden sen beni üç defa inkâr edeceksin.” Dışarı çıkıp acı acı ağladı.<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">Yahuda kendini asıyor</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>Sabah olunca, <char style="w">başrahipler</char> ve halkın liderleri, İsaʼyı ölüm cezasına çarptırmak için anlaştılar. <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>Oʼnu bağlayıp götürdüler ve Vali Pilatusʼa teslim ettiler.<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>İsaʼya ihanet eden Yahuda İsaʼnın ölüm cezasına çarptırıldığını görünce yaptığına pişman oldu. Otuz gümüş parayı alıp başrahiplere ve halkın liderlerine geri götürdü. <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>“Günah işledim” dedi. “Suçsuz bir adama ihanet ettim!”</para>
  <para style="p" vid="MAT 27:4">Onlarsa şöyle karşılık verdiler: “Bundan bize ne? Onu sen düşün.”<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>Yahuda parayı tapınağın içine fırlattı ve oradan ayrıldı. Sonra gidip kendini astı.<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>Başrahipler parayı alıp şöyle dediler: “Bu para kan parasıdır. Onu tapınak hazinesine koymak Tevratʼa uygun değildir.” <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>Sonra aralarında anlaşarak o parayla Çömlekçi Tarlasıʼnı satın aldılar. Orada yabancılar için bir mezarlık yapacaklardı. <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>Bunun için o tarlanın adı bugüne kadar Kan Tarlası diye kaldı. <verse eid="MAT 27:8"/><verse number="9" style="v" sid="MAT 27:9"/>O vakit Allahʼın peygamber Yeremya aracılığıyla söylediği şu söz yerine geldi: “İsrailoğulları otuz gümüşü aldılar, bir insana biçtikleri değer buydu. <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>Rabbin bana buyurduğu gibi, bu parayla çömlekçinin tarlasını satın aldılar.”<note caller="+" style="f"><char style="fr" closed="false">27:10 </char><char style="ft" closed="false">Bakınız <char style="xt"><ref loc="ZEC 11:12">Zekeriya 11:12</ref>,<ref loc="ZEC 11:13">13</ref>; <ref loc="JER 19:1-13">Yeremya 19:1‑13</ref>; <ref loc="JER 32:6-9">32:6‑9</ref></char> ayetlerine.</char></note><verse eid="MAT 27:10"/></para>
  <para style="s1">İsa Vali Pilatusʼun önünde</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>İsa, valinin önüne götürüldü. O da İsaʼyı sorguya çekti: “Sen Yahudilerin Kralı mısın?”</para>
  <para style="p" vid="MAT 27:11">İsa da, “Bunu sen söylüyorsun” dedi.<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>
    <char style="w">Başrahipler</char> ve halkın liderleri Oʼnu suçladılar. Ama İsa hiç karşılık vermedi.<verse eid="MAT 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13"/>Sonra Pilatus Oʼna şöyle dedi: “Sana karşı yapılan bunca şahitliği duymuyor musun?”<verse eid="MAT 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14"/>Ama İsa tek bir suçlamaya bile cevap vermedi. Vali buna çok şaştı.<verse eid="MAT 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>Valinin bir adeti vardı: her yıl <char style="w" lemma="Özgürlük Bayramı">Özgürlük Bayramıʼnda</char> halkın istediği bir tutukluyu serbest bırakırdı. <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>O günlerde Barabba<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="fk" closed="false">Barabba </char><char style="ft" closed="false">Bazı Grekçe el yazmalarında adamın adı “İsa Barabba” diye geçer. Barabba babanın oğlu demektir.</char></note> adında çok tanınmış bir tutuklu vardı. <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>Halk bir araya geldikten sonra, Pilatus onlara sordu: “Kimi serbest bırakmamı istersiniz: Barabbaʼyı mı, yoksa Mesih denilen İsaʼyı mı?” <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>Pilatus, başrahipler ve halkın liderlerinin İsaʼyı kıskandıkları için Oʼnu kendisine teslim ettiklerini biliyordu.<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>Pilatus yargı yerinde otururken, karısı ona şu haberi yolladı: “O adam suçsuzdur. Sakın bu işe karışma. Dün gece Oʼnun hakkında bir rüya gördüm. Bu rüya yüzünden çok acı çektim.”<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>Başrahipler ve halkın liderleri, Barabbaʼnın serbest bırakılması ve İsaʼnın öldürülmesini istesinler diye kalabalığı kandırdılar.<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>Ama Pilatus kalabalığa şunu sordu: “Ne istersiniz? Bu iki adamdan hangisini serbest bırakayım?”</para>
  <para style="p" vid="MAT 27:21">Onlar da “Barabbaʼyı” dediler.<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>Pilatus, “Öyleyse, Mesih denilen İsaʼyla ne yapayım?” diye sordu.</para>
  <para style="p" vid="MAT 27:22">Hepsi, “Çarmıha gerilsin!” dediler.<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>Pilatus sordu: “Adam ne kötülük yaptı ki?”</para>
  <para style="p" vid="MAT 27:23">Ama seslerini daha da fazla yükselterek, “Çarmıha gerilsin!” diye bağırdılar.<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>Pilatus durumu değiştiremeyeceğini anladı. Tam tersine halk ayaklanmaya başlıyordu. Pilatus su alıp halkın önünde ellerini yıkadı ve şöyle dedi: “Bu adamın kanından ben sorumlu değilim. Gerisi size kalmış.”<verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>Halk da şöyle cevap verdi: “Oʼnun kanı bizim ve evlatlarımızın üzerinde olsun!”<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>Sonra Pilatus Barabbaʼyı serbest bıraktı. İsaʼyı ise, kamçılattı ve çarmıha gerilsin diye askerlere teslim etti.<verse eid="MAT 27:26"/></para>
  <para style="s1">Askerler İsaʼyı aşağılıyor</para>
  <para style="r">(<ref loc="MRK 15:16-20">Markos 15:16‑20</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>Valinin askerleri İsaʼyı alıp Pretoriyum denen vali sarayına götürdüler. Bütün asker bölüğünü İsaʼnın etrafına topladılar. <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>Oʼnun elbiselerini çıkarıp üstüne kırmızı bir <char style="w">kaftan</char> attılar. <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>Dikenlerden bir taç örüp başına koydular. Sağ eline bir sopa verdiler. Oʼnunla alay etmek için, önünde diz çöküp, “Yaşasın Yahudilerin kralı!” dediler. <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>Üzerine tükürdüler, sopayı alıp başına vurdular. <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>İsaʼyla alay ettikten sonra üzerinden <char style="w" lemma="kaftan">kaftanı</char> çıkarıp kendi elbiselerini giydirdiler. Sonra Oʼnu çarmıha germeye götürdüler.<verse eid="MAT 27:31"/></para>
  <para style="s1">İsa çarmıha geriliyor</para>
  <para style="r">(<ref loc="MRK 15:21-32">Markos 15:21‑32</ref>; <ref loc="LUK 23:26-43">Luka 23:26‑43</ref>; <ref loc="JHN 19:16-27">Yuhanna 19:16‑27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>Onlar şehirden çıkarken, Simun adında Kireneli bir adam buldular. Onu İsaʼnın çarmıhını taşımaya zorladılar. <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>Golgota denilen yere geldiler. Bu ad kafatası yeri anlamına gelir. <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>İsaʼya öd denilen acı ilaçla karıştırılmış şarap verdiler. Ama İsa şarabı tadınca içmek istemedi. <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>İsaʼyı çarmıha gerdiler. Kura çekerek elbiselerini aralarında paylaştılar. <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>Sonra oraya oturup İsaʼnın yanında nöbet tuttular. <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>Başının üzerine Oʼnu suçlayan bir yazı astılar: “Bu, Yahudilerin Kralı İsaʼdır.”<verse eid="MAT 27:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38"/>İki haydut İsaʼyla aynı zamanda çarmıha gerildi. Biri sağındaki, öbürü solundaki çarmıhtaydı. <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>Oradan geçenler başlarını sallayıp İsaʼya hakaret ettiler. <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>Şöyle dediler: “Hani tapınağı yıkıp üç günde yeniden kuracaktın! Kendini kurtar bakalım. Eğer <char style="w" lemma="Allahʼın Oğlu">Allahʼın Oğluʼysan</char> çarmıhtan in!”<verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>Bunun gibi, <char style="w">başrahipler</char>, Tevrat uzmanları ve halkın liderleri İsaʼyla alay ettiler: <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>“Başkalarını kurtardı ama kendini kurtaramıyor! O İsrailʼin Kralı imiş! Şimdi çarmıhtan insin de, Oʼna iman edelim. <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>Allahʼa güveniyormuş. ‘Allahʼın Oğlu benim’ derdi. Eğer Allah Oʼnu seviyorsa, şimdi kurtarsın bakalım!” <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>İsaʼyla birlikte çarmıha gerilmiş haydutlar da Oʼnu aşağıladılar.<verse eid="MAT 27:44"/></para>
  <para style="s1">İsaʼnın ölümü</para>
  <para style="r">(<ref loc="MRK 15:33-41">Markos 15:33‑41</ref>; <ref loc="LUK 23:44-49">Luka 23:44‑49</ref>; <ref loc="JHN 19:28-30">Yuhanna 19:28‑30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>Öğleyin saat on ikiden saat üçe kadar bütün ülkenin üzerine karanlık çöktü. <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>Saat üçe doğru İsa yüksek sesle şöyle bağırdı: “Eli, Eli, lema şevaktani?” Bu söz, “Allahım, Allahım, beni niçin terk ettin?”<note caller="+" style="f"><char style="fr" closed="false">27:46 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:1">Mezmur 22:1</ref></char></char></note> demektir.<verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>Orada duranların bazıları bunu işitince “Bu adam İlyasʼı<note caller="+" style="f"><char style="fr" closed="false">27:47 </char><char style="fk" closed="false">İlyas </char><char style="ft" closed="false">İbranicede Eli (Allahım) ile Eliyahu (İlyas) adlarının söyleyişi birbirine yakındır.</char></note> çağırıyor” dediler.<verse eid="MAT 27:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48"/>Onlardan biri hemen koşup bir sünger aldı, onu ekşi şaraba<note caller="+" style="f"><char style="fr" closed="false">27:48 </char><char style="fk" closed="false">Ekşi şaraba </char><char style="ft" closed="false">Sulandırılan bu ekşi şarap işçilerin ve askerlerin susuzluğunu gidermek için kullanılırdı.</char></note> batırdı, süngeri bir kamışın ucuna taktı ve içmesi için İsaʼya uzattı. <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>Ama öbürleri, “Dur bakalım, İlyas gelip Oʼnu kurtaracak mı?” dediler.<verse eid="MAT 27:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50"/>İsa ise tekrar yüksek sesle bağırıp ruhunu teslim etti.<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>O anda tapınaktaki perde yukarıdan aşağıya kadar yırtılıp ikiye ayrıldı. Yer sarsıldı ve kayalar yarıldı. <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/><char style="w" lemma="mezar">Mezarlar</char> açıldı ve Allahʼın kutsal halkından ölmüş olan birçok kişinin cesetleri dirildi. <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>Onlar İsaʼnın dirilişinden sonra <char style="w" lemma="mezar">mezarlarından</char> çıkıp kutsal şehre<note caller="+" style="f"><char style="fr" closed="false">27:53 </char><char style="fk" closed="false">Kutsal şehre </char><char style="ft" closed="false">Yeruşalimʼe (Kudüs).</char></note> girdiler ve birçok kişiye göründüler.<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>İsaʼya bekçilik yapan yüzbaşı ve onun yanındaki adamlar deprem ve diğer olup bitenleri gördüler. Bu yüzden çok korktular ve şöyle dediler: “Bu adam gerçekten de <char style="w" lemma="Allahʼın Oğlu">Allahʼın Oğluʼydu</char>!”<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>Olaylara uzaktan bakan birçok kadın da oradaydı. Bunlar, Celileʼden İsaʼnın peşinden gelip Oʼna hizmet etmişlerdi. <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>Kadınların arasında Mecdelli Meryem, Yakubʼun ve Yusufʼun annesi Meryem ve Zebedi oğullarının annesi vardı.<verse eid="MAT 27:56"/></para>
  <para style="s1">İsaʼnın mezara konulması</para>
  <para style="r">(<ref loc="MRK 15:42-47">Markos 15:42‑47</ref>; <ref loc="LUK 23:50-56">Luka 23:50‑56</ref>; <ref loc="JHN 19:38-42">Yuhanna 19:38‑42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>Akşam olunca, Aramatyalı Yusuf adında zengin bir adam geldi. Kendisi de İsaʼnın <char style="w" lemma="öğrenci">öğrencisiydi</char>. <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>Bu adam Pilatusʼa gidip İsaʼnın ölüsünü istedi. Pilatus cesedin ona verilmesi için buyruk verdi. <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>Yusuf İsaʼnın cesedini alıp temiz bir keten beze sardı. <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>Yusuf kendisi için kayanın içine yeni bir <char style="w">mezar</char> oydurmuştu. İsaʼnın cesedini oraya koydu. Mezarın kapısının önüne kocaman bir taş yuvarladı ve oradan ayrıldı. <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>Bu arada Mecdelli Meryem ve öteki Meryem oradaydı, mezarın karşısında oturuyorlardı.<verse eid="MAT 27:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>Ertesi gün, yani <char style="w" lemma="Hazırlık Günü">Hazırlık Günüʼnden</char> sonraki gün,<note caller="+" style="f"><char style="fr" closed="false">27:62 </char><char style="fk" closed="false">Hazırlık Günüʼnden sonraki gün </char><char style="ft" closed="false">Yani, cumartesi günü.</char></note> <char style="w">başrahipler</char> ve <char style="w">Ferisiler</char> toplanıp hep birlikte Pilatusʼa gittiler. <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>Şöyle dediler: “Efendimiz, şu yalancının daha hayattayken, ‘Üç gün sonra dirileceğim’ dediğini hatırlıyoruz. <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>Bu sebeple, buyruk ver ki, <char style="w">mezar</char> üçüncü güne kadar koruma altına alınsın. <char style="w" lemma="öğrenci">Öğrencileri</char> gelip ölüyü çalmasınlar, sonra da halka, ‘O, ölümden dirildi’ demesinler. Yoksa, son yalan ilkinden beter olacak.”<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>Pilatus onlara şöyle dedi: “Buyurun, bir grup kollayıcı asker sizin olsun. Gidin, elinizden geldiği kadar <char style="w" lemma="mezar">mezarı</char> koruma altına alın.” <verse eid="MAT 27:65"/><verse number="66" style="v" sid="MAT 27:66"/>Gidip taşı mühürlediler, başına askerler diktiler. Böylece mezarı koruma altına aldılar.<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">İsaʼnın ölümden dirilişi</para>
  <para style="r">(<ref loc="MRK 16:1-8">Markos 16:1‑8</ref>; <ref loc="LUK 24:1-12">Luka 24:1‑12</ref>; <ref loc="JHN 20:1-9">Yuhanna 20:1‑9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>
    <char style="w">Şabat</char> gününden sonra, yani pazar günü güneşin doğmasından az önce, Mecdelli Meryem ve öteki Meryem <char style="w" lemma="mezar">mezarı</char> görmeye gittiler.<verse eid="MAT 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2"/>Aniden büyük bir deprem oldu. Rabbin bir meleği gökten indi. <char style="w" lemma="mezar">Mezara</char> yaklaşarak taşı kenara yuvarladı ve o taşın üstüne oturdu. <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>Onun görünüşü şimşek gibi parlak, elbiseleri de kar gibi beyazdı. <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>Kollayıcı askerler korkudan titreyip ölü gibi yere yıkıldılar.<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>Melek kadınlara şöyle dedi: “Korkmayın! Biliyorum, siz çarmıha gerilmiş İsaʼyı arıyorsunuz. <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>O burada yok, söylediği gibi dirildi. Gelin, Oʼnun yattığı yeri görün. <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>Hemen gidin ve Oʼnun <char style="w" lemma="öğrenci">öğrencilerine</char> şöyle deyin: ‘İsa ölümden dirildi. O sizden önce Celileʼye gidiyor. Oʼnu orada göreceksiniz.’ İşte, size haber verdim.”<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>Kadınlar çabucak <char style="w" lemma="mezar">mezardan</char> ayrıldılar. Hem korku, hem de büyük sevinç içindeydiler. İsaʼnın <char style="w" lemma="öğrenci">öğrencilerine</char> haber vermeye koştular. <verse eid="MAT 28:8"/><verse number="9" style="v" sid="MAT 28:9"/>Tam o sırada İsa onlarla karşılaştı ve selam verdi. Onlar da yaklaşıp İsaʼnın ayaklarına sarıldılar ve Oʼna tapındılar. <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>O zaman İsa onlara şöyle dedi: “Korkmayın! Gidin, imanlı kardeşlerime haber verin, Celileʼye doğru yola çıksınlar. Orada beni görecekler.”<verse eid="MAT 28:10"/></para>
  <para style="s1">Kollayıcı askerler haber getiriyor</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>Kadınlar daha yoldayken, kollayıcı askerlerden bazıları şehre gittiler ve olup biten her şeyi <char style="w" lemma="başrahipler">başrahiplere</char> bildirdiler. <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>Onlar da halk liderleriyle toplanıp birbirlerine danıştılar. Sonra askerlere çok para verdiler. <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>Onlara şöyle dediler: “Şunu söyleyin: ‘İsaʼnın <char style="w" lemma="öğrenci">öğrencileri</char> gece gelip biz uyurken cesedini çaldılar.’ <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>Bu haber valinin kulağına giderse, biz onu kandırıp sizi beladan uzak tutacağız.” <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>Askerler de parayı alıp, kendilerine söyleneni yaptılar. Bu söz Yahudilerin arasında çok yayıldı, ve hâlâ yaygındır.<verse eid="MAT 28:15"/></para>
  <para style="s1">İsaʼnın son emirleri</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>On bir <char style="w">öğrenci</char> de Celile bölgesine, İsaʼnın onlara buyurduğu dağa gitti. <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>İsaʼyı görünce, Oʼna tapınmaya başladılar. Bazıları ise, şüphe içindeydi. <verse eid="MAT 28:17"/><verse number="18" style="v" sid="MAT 28:18"/>İsa onlara yaklaşıp şöyle dedi: “Gökte ve yeryüzünde bütün yetki bana verildi. <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>Bunun için gidin, bütün milletleri <char style="w" lemma="öğrenci">öğrencilerim</char> olarak yetiştirin. Onları <char style="w">Baba</char>, <char style="w">Oğul</char> ve <char style="w">Kutsal Ruh</char> <char style="w" lemma="ad">adıyla</char> <char style="w">vaftiz</char> edin. <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>Size emrettiğim her şeyi yerine getirmeyi onlara öğretin. Bakın, ben dünyanın sonuna kadar her zaman sizinle birlikteyim.”<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
