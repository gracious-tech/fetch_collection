<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Yoel</para>
  <para style="toc2">Yoel</para>
  <para style="toc1">Yoel</para>
  <para style="mt1">Yoel</para>
  <chapter number="1" style="c" pubnumber="א" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />dos vort fun Hashem vos iz geven tsu Yoel dem zun fun Petueln:<verse eid="JOL 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="JOL 1:2" />hert dos tsu, ir zkeinim,</para>
  <para style="q" vid="JOL 1:2">un farnemt ale bavoiner fun land:</para>
  <para style="q" vid="JOL 1:2">iz azoi vos geshen in aiere teg,</para>
  <para style="q" vid="JOL 1:2">tsi in di teg fun aiere eltern?<verse eid="JOL 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 1:3" />dertseilt vegen dem aiere kinder,</para>
  <para style="q" vid="JOL 1:3">un aiere kinder tsu zeyere kinder,</para>
  <para style="q" vid="JOL 1:3">un zeyere kinder tsu dem ander dor.<verse eid="JOL 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="JOL 1:4" />vos iz geblibn fun dem vorem</para>
  <para style="q" vid="JOL 1:4">hot oifgegesn der heisherik,</para>
  <para style="q" vid="JOL 1:4">un vos iz geblibn fun dem heisherik</para>
  <para style="q" vid="JOL 1:4">hot oifgegesn der grozfreser,</para>
  <para style="q" vid="JOL 1:4">un vos iz geblibn fun dem grozfreser</para>
  <para style="q" vid="JOL 1:4">hot oifgegesn der gril.<verse eid="JOL 1:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="JOL 1:5" />chapt zich oif, shikurim, un veint,</para>
  <para style="q" vid="JOL 1:5">un yomert, ale trinker fun vain,</para>
  <para style="q" vid="JOL 1:5">oif der troibnzaft vos zi iz farshnitn gevorn</para>
  <para style="q" vid="JOL 1:5">fun aier moil.<verse eid="JOL 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 1:6" />vorem a folk iz aroifgekumen oif main land,</para>
  <para style="q" vid="JOL 1:6">machtik un on a tsol;</para>
  <para style="q" vid="JOL 1:6">zaine tsein zainen tsein fun a leib,</para>
  <para style="q" vid="JOL 1:6">un baktseiner fun a leibnte hot er.<verse eid="JOL 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 1:7" />er hot gemacht main vainshtok tsu vist,</para>
  <para style="q" vid="JOL 1:7">un tsu shpendlech main faignboim;</para>
  <para style="q" vid="JOL 1:7">opgehoilt hoil hot er im un anidergevorfen,</para>
  <para style="q" vid="JOL 1:7">zaine tsvaign zainen vais gevorn.<verse eid="JOL 1:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="JOL 1:8" />klog vi a yungfroi ongegurt mit zak</para>
  <para style="q" vid="JOL 1:8">noch dem man fun ir yugnt.<verse eid="JOL 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 1:9" />farshnitn gevorn iz a shpaizopfer un a gisopfer</para>
  <para style="q" vid="JOL 1:9">fun dem hoiz fun Hashem;</para>
  <para style="q" vid="JOL 1:9">es troiern di koyanim,</para>
  <para style="q" vid="JOL 1:9">di badiner fun Hashem.<verse eid="JOL 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 1:10" />farvist gevorn iz dos feld,</para>
  <para style="q" vid="JOL 1:10">es troiert di erd,</para>
  <para style="q" vid="JOL 1:10">vorem farvist gevorn iz di tvue,</para>
  <para style="q" vid="JOL 1:10">oisgetriknt hot der vain,</para>
  <para style="q" vid="JOL 1:10">aingegangen iz dos eil.<verse eid="JOL 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 1:11" />tsu shand zainen di akerlait,</para>
  <para style="q" vid="JOL 1:11">es yomern di vaingertnirer,</para>
  <para style="q" vid="JOL 1:11">oifn veits un oifn gershtn;</para>
  <para style="q" vid="JOL 1:11">vorem der shnit fun feld iz farlorn.<verse eid="JOL 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 1:12" />der vainshtok iz fartriknt,</para>
  <para style="q" vid="JOL 1:12">un der faignboim iz farvelkt;</para>
  <para style="q" vid="JOL 1:12">der milgroim, oich der teitlboim un der eplboim,</para>
  <para style="q" vid="JOL 1:12">ale beimer fun feld, zainen fartriknt;</para>
  <para style="q" vid="JOL 1:12">yo, oisgetriknt hot di freid fun di mentshnkinder.<verse eid="JOL 1:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="JOL 1:13" />gurt aich on un klogt, ir koyanim,</para>
  <para style="q" vid="JOL 1:13">iomert, ir badiner fun mizbeyech;</para>
  <para style="q" vid="JOL 1:13">kumt nechtikt in zakkleider, badiner fun main G-t,</para>
  <para style="q" vid="JOL 1:13">vorem farmitn iz fun dem hoiz fun Elokeichem</para>
  <para style="q" vid="JOL 1:13">a shpaizopfer un a gisopfer.<verse eid="JOL 1:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="JOL 1:14" />heilikt a fasttog, ruft an ainzamlung,</para>
  <para style="q" vid="JOL 1:14">klaibt tsunoif di eltste, ale bavoiner fun land,</para>
  <para style="q" vid="JOL 1:14">in hoiz fun Hashem Elokeichem,</para>
  <para style="q" vid="JOL 1:14">un tut shraien tsu Hashem.<verse eid="JOL 1:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="JOL 1:15" />vei oif dem tog!</para>
  <para style="q" vid="JOL 1:15">vorem nont iz der tog fun Hashem,</para>
  <para style="q" vid="JOL 1:15">un vi a broch fun Shaddai kumt er.<verse eid="JOL 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 1:16" />far vor, far undzere oign</para>
  <para style="q" vid="JOL 1:16">iz farshnitn di shpaiz;</para>
  <para style="q" vid="JOL 1:16">fun undzer G-ts hoiz, di freid un di lustikeit.<verse eid="JOL 1:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="JOL 1:17" />aingedart zainen di zomen unter zeyere grudes,</para>
  <para style="q" vid="JOL 1:17">vist gevorn zainen di shpaichlers,</para>
  <para style="q" vid="JOL 1:17">aingefaln zainen di shaiern</para>
  <para style="q" vid="JOL 1:17">vorem oisgetriknt iz di tvue.<verse eid="JOL 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 1:18" />vi krechtst di beheime!</para>
  <para style="q" vid="JOL 1:18">tsetumlt zainen di stades rinder,</para>
  <para style="q" vid="JOL 1:18">vorem nishto far zei kein fiterung;</para>
  <para style="q" vid="JOL 1:18">afile di stades shof zainen farvist.<verse eid="JOL 1:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="JOL 1:19" />tsu dir, Hashem, tu ich rufn,</para>
  <para style="q" vid="JOL 1:19">vorem a faier hot fartsert</para>
  <para style="q" vid="JOL 1:19">di fiterpletser fun midber,</para>
  <para style="q" vid="JOL 1:19">un a flam hot tseflakert</para>
  <para style="q" vid="JOL 1:19">ale beimer fun feld.<verse eid="JOL 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 1:20" />afile di beheimes fun feld shraien tsu dir,</para>
  <para style="q" vid="JOL 1:20">vorem oisgetriknt zainen di grobns vaser,</para>
  <para style="q" vid="JOL 1:20">un a faier hot fartsert di fiterpletser fun midber.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="JOL 2" />
  <para style="q">
    <verse number="1" style="v" sid="JOL 2:1" />blozt a shoifer in Tsiyon,</para>
  <para style="q" vid="JOL 2:1">un shalt oif main heilikn barg,</para>
  <para style="q" vid="JOL 2:1">zoln tsiteren ale bavoiner fun land,</para>
  <para style="q" vid="JOL 2:1">vorem der tog fun Hashem kumt on,</para>
  <para style="q" vid="JOL 2:1">vorem er iz nont;<verse eid="JOL 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 2:2" />a tog fun choishech un fintsternish,</para>
  <para style="q" vid="JOL 2:2">a tog fun volken un nebl,</para>
  <para style="q" vid="JOL 2:2">vi a shvartskeit oisgeshpreit oif di berg;</para>
  <para style="q" vid="JOL 2:2">a grois folk un a machtiks,</para>
  <para style="q" vid="JOL 2:2">aza vi er iz nisht geven fun eibik on</para>
  <para style="q" vid="JOL 2:2">un vet noch im mer nisht zain</para>
  <para style="q" vid="JOL 2:2">biz di yorn fun dor-doires.<verse eid="JOL 2:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="JOL 2:3" />im farois fartsert a faier,</para>
  <para style="q" vid="JOL 2:3">un hinter im flakert a flam;</para>
  <para style="q" vid="JOL 2:3">vi der gortn fun Eden iz dos land far im,</para>
  <para style="q" vid="JOL 2:3">un hinter im a midber a vister,</para>
  <para style="q" vid="JOL 2:3">un tsu mol kein antrinung iz nishto fun im.<verse eid="JOL 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 2:4" />vi dos oiszen fun ferd iz zain oiszen,</para>
  <para style="q" vid="JOL 2:4">un vi raiter azoi loifn zei.<verse eid="JOL 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 2:5" />vi dos geroish fun raitvegn,</para>
  <para style="q" vid="JOL 2:5">iz zeyer shpringen oif di shpitsn berg;</para>
  <para style="q" vid="JOL 2:5">vi der knal fun a flamfaier vos fartsert shtroi;</para>
  <para style="q" vid="JOL 2:5">vi a folk a machtiks gegreit tsu milchome.<verse eid="JOL 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="JOL 2:6" />far im tsiteren felker,</para>
  <para style="q" vid="JOL 2:6">ale penemer hobn ongenumen a fintsternish.<verse eid="JOL 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 2:7" />vi giborim loifn zei,</para>
  <para style="q" vid="JOL 2:7">vi milchome-lait kletern zei oif der moier,</para>
  <para style="q" vid="JOL 2:7">un itlecher in zaine vegen geyen zei,</para>
  <para style="q" vid="JOL 2:7">un zei plontern nisht zeyere shtegn.<verse eid="JOL 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 2:8" />un einer dem andern shtoisn zei nisht,</para>
  <para style="q" vid="JOL 2:8">itlecher in zain shliach geyen zei,</para>
  <para style="q" vid="JOL 2:8">un durch vofn vorfn zei zich,</para>
  <para style="q" vid="JOL 2:8">un vern nisht geshedikt.<verse eid="JOL 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 2:9" />zei shpringen oif der shtot,</para>
  <para style="q" vid="JOL 2:9">zei loifn oif der moier,</para>
  <para style="q" vid="JOL 2:9">zei geyen aroif in di haizer,</para>
  <para style="q" vid="JOL 2:9">zei kumen durch di fentster vi a ganev.<verse eid="JOL 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JOL 2:10" />far im tsitert di erd,</para>
  <para style="q" vid="JOL 2:10">shturemen di himlen;</para>
  <para style="q" vid="JOL 2:10">di zun un di levone vern shvarts,</para>
  <para style="q" vid="JOL 2:10">un di shtern nemen arain zeyer shain.<verse eid="JOL 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 2:11" />un Hashem lozt arois zain kol farois far zain cheil;</para>
  <para style="q" vid="JOL 2:11">vorem zeyer grois iz zain machne,</para>
  <para style="q" vid="JOL 2:11">vorem machtik iz der vos tut zain bafel;</para>
  <para style="q" vid="JOL 2:11">vorem grois iz der tog fun Hashem un moiredik zeyer,</para>
  <para style="q" vid="JOL 2:11">un ver ken im oishaltn?<verse eid="JOL 2:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="JOL 2:12" />ober noch itst, zogt Hashem,</para>
  <para style="q" vid="JOL 2:12">kert aich um tsu mir mit aier gantsn hartsn,</para>
  <para style="q" vid="JOL 2:12">un mit fasten un mit gevein un mit klog;<verse eid="JOL 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 2:13" />un tseraist aier harts un nisht aiere kleider,</para>
  <para style="q" vid="JOL 2:13">un kert aich um tsu Hashem Elokeichem,</para>
  <para style="q" vid="JOL 2:13">vorem er iz laitzelik un derbaremdik,</para>
  <para style="q" vid="JOL 2:13">aingehaltn in tsorn, un raich in genod,</para>
  <para style="q" vid="JOL 2:13">un er hot charote oif dem beiz.<verse eid="JOL 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 2:14" />ver veis, efsher vider vet er charote hobn,</para>
  <para style="q" vid="JOL 2:14">un lozn a broche hinter zich –</para>
  <para style="q" vid="JOL 2:14">a shpaizopfer un a gisopfer</para>
  <para style="q" vid="JOL 2:14">far Hashem Elokeichem.<verse eid="JOL 2:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="JOL 2:15" />blozt a shoifer in Tsiyon,</para>
  <para style="q" vid="JOL 2:15">heilikt a fasttog, ruft an ainzamlung;<verse eid="JOL 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 2:16" />zamlt ain dos folk,</para>
  <para style="q" vid="JOL 2:16">farruft di eide,</para>
  <para style="q" vid="JOL 2:16">klaibt tsunoif di zkeinim,</para>
  <para style="q" vid="JOL 2:16">zamlt ain di kleine kinder,</para>
  <para style="q" vid="JOL 2:16">un di vos zeign di brust;</para>
  <para style="q" vid="JOL 2:16">zol der chosen aroisgein fun zain kamer,</para>
  <para style="q" vid="JOL 2:16">un di kale fun ir getselt.<verse eid="JOL 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 2:17" />tsvishn dem polish un dem mizbeyech</para>
  <para style="q" vid="JOL 2:17">zoln veinen di koyanim, di diner fun Hashem,</para>
  <para style="q" vid="JOL 2:17">un zoln zei zogn:</para>
  <para style="q" vid="JOL 2:17">derbarim zich Hashem oif dain folk,</para>
  <para style="q" vid="JOL 2:17">un zolst nisht gebn dain arav tsu shand,</para>
  <para style="q" vid="JOL 2:17">az felker zoln zich vertlen iber zei;</para>
  <para style="q" vid="JOL 2:17">noch vos zol men zogn tsvishn di umes:</para>
  <para style="q" vid="JOL 2:17">vu iz zeyer G-t?<verse eid="JOL 2:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="JOL 2:18" />un Hashem hot zich eifer far zain land,</para>
  <para style="q" vid="JOL 2:18">un hot zich derbaremt oif zain folk.<verse eid="JOL 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 2:19" />un Hashem hot geentfert un gezogt tsu zain folk:</para>
  <para style="q" vid="JOL 2:19">zet, ich shik aich tvue un vain un eil,</para>
  <para style="q" vid="JOL 2:19">un ir vet zei hobn tsu zat;</para>
  <para style="q" vid="JOL 2:19">un ich vel aich mer nisht gebn tsu shand bai di felker.<verse eid="JOL 2:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="JOL 2:20" />un dem tsfundikn vel ich dervaitern fun aich,</para>
  <para style="q" vid="JOL 2:20">un vel im farshtoisen in a land fun trikenish un vistenish,</para>
  <para style="q" vid="JOL 2:20">mit zain ponem tsum federshtn yam,</para>
  <para style="q" vid="JOL 2:20">un zain ek tsum hintershtn yam;</para>
  <para style="q" vid="JOL 2:20">un zain foilgeruch vet oifgein,</para>
  <para style="q" vid="JOL 2:20">un zain geshtank vet oifgein,</para>
  <para style="q" vid="JOL 2:20">vail er hot grois zich farnumen.<verse eid="JOL 2:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JOL 2:21" />zolst nisht moire hobn, erd,</para>
  <para style="q" vid="JOL 2:21">frei zich un zei lustik,</para>
  <para style="q" vid="JOL 2:21">vorem grois geton hot Hashem.<verse eid="JOL 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOL 2:22" />ir zolt nisht moire hobn, beheimes fun feld,</para>
  <para style="q" vid="JOL 2:22">vorem di fiterpletser fun midber zainen bagrozt,</para>
  <para style="q" vid="JOL 2:22">vorem der boim trogt zain frucht,</para>
  <para style="q" vid="JOL 2:22">der faignboim un der vainshtok gibn zeyer krift.<verse eid="JOL 2:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="JOL 2:23" />un ir kinder fun Tsiyon,</para>
  <para style="q" vid="JOL 2:23">zait lustik un freit zich mit Hashem Elokeichem,</para>
  <para style="q" vid="JOL 2:23">vorem er git aich dem friregn richtik;</para>
  <para style="q" vid="JOL 2:23">yo, er macht nidern far aich regn,</para>
  <para style="q" vid="JOL 2:23">friregn un shpetregn in ershtn choidesh.<verse eid="JOL 2:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="JOL 2:24" />un di dreshn veln ful zain mit tvue,</para>
  <para style="q" vid="JOL 2:24">un di keltern veln iberloifn mit vain un eil.<verse eid="JOL 2:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOL 2:25" />un ich vel aich optsolen di yorn</para>
  <para style="q" vid="JOL 2:25">vos der heisherik hot oifgegesn,</para>
  <para style="q" vid="JOL 2:25">der grozfreser, un der gril, un der vorem,</para>
  <para style="q" vid="JOL 2:25">main grois cheil vos ich hob ongeshikt oif aich.<verse eid="JOL 2:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="JOL 2:26" />un esen vet ir esen un zat zain,</para>
  <para style="q" vid="JOL 2:26">un ir vet loibn dem nomen fun Hashem Elokeichem,</para>
  <para style="q" vid="JOL 2:26">vos hot geton mit aich vunderlech;</para>
  <para style="q" vid="JOL 2:26">un main folk vet oif eibik nisht farshemt vern.<verse eid="JOL 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOL 2:27" />un ir vet visen az ich bin tsvishn Yisroel,</para>
  <para style="q" vid="JOL 2:27">un ich bin Hashem Elokeichem, un mer iz nishto;</para>
  <para style="q" vid="JOL 2:27">un main folk vet oif eibik nisht farshemt vern.<verse eid="JOL 2:27" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="JOL 3" />
  <para style="q">
    <verse number="1" style="v" pubnumber="2.28" sid="JOL 3:1" /> un es vet zain noch dem,</para>
  <para style="q" vid="JOL 3:1">vel ich oisgisen main gaist oif yetveder laib,</para>
  <para style="q" vid="JOL 3:1">un aiere zin un aiere techter veln nevies zogn,</para>
  <para style="q" vid="JOL 3:1">aiere zkeinim veln chaloimes cholemen,</para>
  <para style="q" vid="JOL 3:1">aiere bochurim veln zeungen zen.<verse eid="JOL 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" pubnumber="2.29" sid="JOL 3:2" /> un oich oif di knecht un oif di dinstn</para>
  <para style="q" vid="JOL 3:2">vel ich oisgisen main gaist in yene teg.<verse eid="JOL 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" pubnumber="2.30" sid="JOL 3:3" /> un ich vel vaizn vunder in himel un oif der erd,</para>
  <para style="q" vid="JOL 3:3">blut un faier un zailn roich.<verse eid="JOL 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" pubnumber="2.31" sid="JOL 3:4" /> di zun vet farkert vern in fintsternish, un di levone in blut, eider es kumt der tog fun Hashem, der groiser un der mordiker. <verse eid="JOL 3:4" /><verse number="5" style="v" pubnumber="2.32" sid="JOL 3:5" /> un es vet zain, itlecher vos vet rufn dem nomen fun HaAdon, vet geratevet vern; vorem oif barg Tsiyon un in Yerushalayim vet zain an antrinung, azoi vi Hashem hot gezogt; un di geblibene veln zain di vos Hashem tut rufn.<verse eid="JOL 3:5" /></para>
  <chapter eid="JOL 3" />
  <chapter number="4" style="c" altnumber="3" pubnumber="ד" sid="JOL 4" />
  <para style="p">
    <verse number="1" style="v" pubnumber="3.1" sid="JOL 4:1" /> vorem ze, in yene teg un in yener tsait, az ich vel umkeren di gefangenshaft fun Yehudah un Yerushalayim, <verse eid="JOL 4:1" /><verse number="2" style="v" pubnumber="3.2" sid="JOL 4:2" /> vel ich ainzamlen ale felker, un ich vel zei machn nidern in tal fun Yehoshafat, un ich vel zich dortn mishpetn mit zei far main folk un main arav Yisroel, vos zei hobn zei tseshpreit tsvishn di felker, un tseteilt main land. <verse eid="JOL 4:2" /><verse number="3" style="v" pubnumber="3.3" sid="JOL 4:3" /> un oif main folk hobn zei goirl gevorfn, un gegebn a yingel far a zoine, un a meidl farkoift far vain, un getrunken.<verse eid="JOL 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="3.4" sid="JOL 4:4" /> un vos zait ir mir gor, Tsor un Tsidon un ale gegentn fun Peleshet? tsi fargeltung tsolt ir dos op fun mainetvegn? iz, oib ir fargelt dos fun mainetvegn, vel ich ailik gich umkeren aier fargeltung oif aier kop; <verse eid="JOL 4:4" /><verse number="5" style="v" pubnumber="3.5" sid="JOL 4:5" /> vos main zilber un main gold hot ir tsugenumen, un maine beste glustikeitn gebracht in aiere palatsn <verse eid="JOL 4:5" /><verse number="6" style="v" pubnumber="3.6" sid="JOL 4:6" /> un di kinder fun Yehudah un di kinder fun Yerushalayim hot ir farkoift tsu di kinder fun di Yavanim, kedei zei tsu dervaitern fun zeyer gemark. <verse eid="JOL 4:6" /><verse number="7" style="v" pubnumber="3.7" sid="JOL 4:7" /> zet, ich dervek zei fun dem ort vos ir hot zei farkoift dortn, un ich vel umkeren aier tuung oif aier kop. <verse eid="JOL 4:7" /><verse number="8" style="v" pubnumber="3.8" sid="JOL 4:8" /> un ich vel farkoifen aiere zin un aiere techter in der hant fun di kinder fun Yehudah, un zei veln zei farkoifen tsu di Shevaim, tsu a vaitn folk, vorem Hashem hot geredt.<verse eid="JOL 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" pubnumber="3.9" sid="JOL 4:9" /> ruft dos ois tsvishn di felker,</para>
  <para style="q" vid="JOL 4:9">breit on a milchome,</para>
  <para style="q" vid="JOL 4:9">vekt oif di giborim;</para>
  <para style="q" vid="JOL 4:9">zoln genenen, zoln aroifgein ale mener fun milchome.<verse eid="JOL 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" pubnumber="3.10" sid="JOL 4:10" /> shmidt aiere akeraizns oif shverdn,</para>
  <para style="q" vid="JOL 4:10">un aiere tsvaigmesers oif shpizn;</para>
  <para style="q" vid="JOL 4:10">der shlafer zol zogn: a gibor bin ich.<verse eid="JOL 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" pubnumber="3.11" sid="JOL 4:11" /> ailt un kumt ale felker fun rund arum,</para>
  <para style="q" vid="JOL 4:11">un lamen zich ainzamlen;</para>
  <para style="q" vid="JOL 4:11">ahin mach nidern, Hashem, daine giborim!<verse eid="JOL 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" pubnumber="3.12" sid="JOL 4:12" /> zoln zich dervekn di felker un aroifgein tsum tal fun Yehoshafat,</para>
  <para style="q" vid="JOL 4:12">vorem dortn vel ich zitsn tsu mishpetn</para>
  <para style="q" vid="JOL 4:12">ale felker fun rund arum.<verse eid="JOL 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" pubnumber="3.13" sid="JOL 4:13" /> leigt tsu dem shnaidmeser, vorem tsaitik iz der shnit;</para>
  <para style="q" vid="JOL 4:13">kumt tret, vorem ful iz der kelter,</para>
  <para style="q" vid="JOL 4:13">di kublen loifn iber, vorem grois iz zeyer beiz.<verse eid="JOL 4:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" pubnumber="3.14" sid="JOL 4:14" /> machnus, machnus in tal fun gzar!</para>
  <para style="q" vid="JOL 4:14">vorem nont iz der tog fun Hashem in tal fun gzar.<verse eid="JOL 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" pubnumber="3.15" sid="JOL 4:15" /> di zun un di levone vern shvarts,</para>
  <para style="q" vid="JOL 4:15">un di shtern nemen arain zeyer shain.<verse eid="JOL 4:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" pubnumber="3.16" sid="JOL 4:16" /> un Hashem vet briln fun Tsiyon,</para>
  <para style="q" vid="JOL 4:16">un fun Yerushalayim vet er aroislozn zain kol,</para>
  <para style="q" vid="JOL 4:16">un shturemen veln himel un erd;</para>
  <para style="q" vid="JOL 4:16">ober Hashem vet zain a bashitsung far zain folk,</para>
  <para style="q" vid="JOL 4:16">un a festung far di kinder fun Yisroel.<verse eid="JOL 4:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" pubnumber="3.17" sid="JOL 4:17" /> un ir vet visen az ich, Hashem Elokeichem,</para>
  <para style="q" vid="JOL 4:17">ru oif Tsiyon, main heilikn barg;</para>
  <para style="q" vid="JOL 4:17">un Yerushalayim vet zain heilik,</para>
  <para style="q" vid="JOL 4:17">un fremde veln mer nisht durchgein in ir.<verse eid="JOL 4:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" pubnumber="3.18" sid="JOL 4:18" /> un es vet zain in yenem tog,</para>
  <para style="q" vid="JOL 4:18">veln di berg trifn zaft,</para>
  <para style="q" vid="JOL 4:18">un di heichn veln ibergein mit milch,</para>
  <para style="q" vid="JOL 4:18">un ale grobns fun Yehudah veln ibergein mit vaser.</para>
  <para style="q" vid="JOL 4:18">un a kval vet aroisgein fun Hashems hoiz,</para>
  <para style="q" vid="JOL 4:18">un vet ontrinken dem tal Shitim.<verse eid="JOL 4:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" pubnumber="3.19" sid="JOL 4:19" /> Mitsrayim vet a vistenish vern,</para>
  <para style="q" vid="JOL 4:19">un Edom vet a vister midber vern,</para>
  <para style="q" vid="JOL 4:19">far dem umrecht tsu di kinder fun Yehudah,</para>
  <para style="q" vid="JOL 4:19">vos zei hobn fargosen umshuldik blut in zeyer land.<verse eid="JOL 4:19" /></para>
  <para style="q">
    <verse number="20" style="v" pubnumber="3.20" sid="JOL 4:20" /> ober Yehudah vet zain eibik bazetst,</para>
  <para style="q" vid="JOL 4:20">un Yerushalayim oif dor-doires.<verse eid="JOL 4:20" /></para>
  <para style="q">
    <verse number="21" style="v" pubnumber="3.21" sid="JOL 4:21" /> vorem ich vel reinik zeyer blut,</para>
  <para style="q2" vid="JOL 4:21">vos ich hob noch nisht gereinikn,</para>
  <para style="q1" vid="JOL 4:21">un Hashem vet voinen in Tsiyon.<verse eid="JOL 4:21" /></para>
  <chapter eid="JOL 4" />
</usx>