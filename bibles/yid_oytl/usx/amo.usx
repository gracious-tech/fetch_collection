<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Amos</para>
  <para style="toc2">Amos</para>
  <para style="toc1">Amos</para>
  <para style="mt1">Amos</para>
  <chapter number="1" style="c" pubnumber="א" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />di verter fun Amosn, vos iz geven fun di shoflait fun Tekoa; vos er hot gezen oif Yisroel in di teg fun Uziyah dem melech fun Yehudah, un in di teg fun Yarovam dem zun fun Yoashn, dem melech fun Yisroel, tsvei yor far der erdtsiternish.<verse eid="AMO 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 1:2" />un er hot gezogt:</para>
  <para style="b" vid="AMO 1:2" />
  <para style="q" vid="AMO 1:2">Hashem vet briln fun Tsiyon,</para>
  <para style="q" vid="AMO 1:2">un fun Yerushalayim vet er aroislozn zain kol,</para>
  <para style="q" vid="AMO 1:2">un di fiterpletser fun di pastucher veln troiern,</para>
  <para style="q" vid="AMO 1:2">un der shpits Karmel vet fartriknt vern.<verse eid="AMO 1:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="AMO 1:3" />azoi hot Hashem gezogt:</para>
  <para style="b" vid="AMO 1:3" />
  <para style="q" vid="AMO 1:3">far drai farbrechn fun Damesek,</para>
  <para style="q" vid="AMO 1:3">yo, far fir, vel ich es nisht ophaltn:</para>
  <para style="q" vid="AMO 1:3">far zeyer dreshn Gilad mit aizerne dreshshlitns.<verse eid="AMO 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 1:4" />un ich vel shikn a faier oif dem hoiz fun Chazael,</para>
  <para style="q" vid="AMO 1:4">un es vet fartseren di palatsn fun Ben-Hadad.<verse eid="AMO 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 1:5" />un ich vel tsebrechn dem rigl fun Damesek,</para>
  <para style="q" vid="AMO 1:5">un vel farshnaidn a bavoiner fun Bikat-Aven,</para>
  <para style="q" vid="AMO 1:5">un dem vos halt a tsepter fun Beis-Eden;</para>
  <para style="q" vid="AMO 1:5">un dos folk fun Aram vet in goles gein kein Kir, zogt Hashem.<verse eid="AMO 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="AMO 1:6" />azoi hot Hashem gezogt:</para>
  <para style="b" vid="AMO 1:6" />
  <para style="q" vid="AMO 1:6">far drai farbrechn fun Azah,</para>
  <para style="q" vid="AMO 1:6">yo, far fir, vel ich es nisht ophaltn:</para>
  <para style="q" vid="AMO 1:6">far zeyer fartraiben a gantse gefangenshaft,</para>
  <para style="q" vid="AMO 1:6">kedei ibertsuentfern tsu Edom.<verse eid="AMO 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 1:7" />un ich vel shikn a faier oif der moier fun Azah,</para>
  <para style="q" vid="AMO 1:7">un es vet fartseren ire festungen.<verse eid="AMO 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 1:8" />un ich vel farshnaidn a bavoiner fun Ashdod,</para>
  <para style="q" vid="AMO 1:8">un dem vos halt a tsepter fun Ashkelon;</para>
  <para style="q" vid="AMO 1:8">un ich vel kern main hant oif Ekron,</para>
  <para style="q" vid="AMO 1:8">un der iberblaib fun di Pelishtim vet untergein,</para>
  <para style="q" vid="AMO 1:8">zogt Adonoi Hashem.<verse eid="AMO 1:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 1:9" />azoi hot Hashem gezogt:</para>
  <para style="b" vid="AMO 1:9" />
  <para style="q" vid="AMO 1:9">far drai farbrechn fun Tsor,</para>
  <para style="q" vid="AMO 1:9">yo, far fir, vel ich es nisht ophaltn:</para>
  <para style="q" vid="AMO 1:9">far vos zei hobn ibergeentfert a gantse gefangenshaft tsu Edom,</para>
  <para style="q" vid="AMO 1:9">un nisht gedacht on dem bris fun brider.<verse eid="AMO 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 1:10" />un ich vel shikn a faier oif der moier fun Tsor,</para>
  <para style="q" vid="AMO 1:10">un es vet fartseren ire palatsn.<verse eid="AMO 1:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 1:11" />azoi hot Hashem gezogt:</para>
  <para style="b" vid="AMO 1:11" />
  <para style="q" vid="AMO 1:11">far drai farbrechn fun Edom,</para>
  <para style="q" vid="AMO 1:11">yo, far fir, vel ich es nisht ophaltn:</para>
  <para style="q" vid="AMO 1:11">far vos er hot nochgeyogt zain bruder mitn shverd,</para>
  <para style="q" vid="AMO 1:11">un dershtikt zain rachmones,</para>
  <para style="q" vid="AMO 1:11">un zain kaas hot shtendik fartsukt,</para>
  <para style="q" vid="AMO 1:11">un er hot eibik gehaltn zain grimtsorn.<verse eid="AMO 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 1:12" />un ich vel shikn a faier oif Teman,</para>
  <para style="q" vid="AMO 1:12">un es vet fartseren di palatsn fun Botsrah.<verse eid="AMO 1:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="AMO 1:13" />azoi hot Hashem gezogt:</para>
  <para style="b" vid="AMO 1:13" />
  <para style="q" vid="AMO 1:13">far drai farbrechn fun di kinder fun Amon,</para>
  <para style="q" vid="AMO 1:13">yo, far fir, vel ich es nisht ophaltn:</para>
  <para style="q" vid="AMO 1:13">far zeyer oifshpaltn di trogedike fun Gilad,</para>
  <para style="q" vid="AMO 1:13">kedei tsu derbreitern zeyer gemark.<verse eid="AMO 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 1:14" />un ich vel ontsindn a faier oif der moier fun Rabbah,</para>
  <para style="q" vid="AMO 1:14">un es vet fartseren ire palatsn,</para>
  <para style="q" vid="AMO 1:14">mit shalung in tog fun milchome,</para>
  <para style="q" vid="AMO 1:14">mit shturem in tog fun geviter.<verse eid="AMO 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 1:15" />un zeyer melech vet gein in goles,</para>
  <para style="q" vid="AMO 1:15">er un zaine harn in einem,</para>
  <para style="q" vid="AMO 1:15">zogt Hashem.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="AMO 2" />
  <para style="q">
    <verse number="1" style="v" sid="AMO 2:1" />azoi hot Hashem gezogt:</para>
  <para style="b" vid="AMO 2:1" />
  <para style="q" vid="AMO 2:1">far drai farbrechn fun Moav,</para>
  <para style="q" vid="AMO 2:1">yo, far fir, vel ich es nisht ophaltn:</para>
  <para style="q" vid="AMO 2:1">far zain farbrenen di beiner</para>
  <para style="q" vid="AMO 2:1">fun dem melech fun Edom oif kalch.<verse eid="AMO 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 2:2" />un ich vel shikn a faier oif Moav,</para>
  <para style="q" vid="AMO 2:2">un es vet fartseren di palatsn fun Keriyot,</para>
  <para style="q" vid="AMO 2:2">un shtarbn mit getuml vet Moav,</para>
  <para style="q" vid="AMO 2:2">mit shalung un a kol fun shoifer.<verse eid="AMO 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 2:3" />un ich vel farshnaidn a richter fun ir mit,</para>
  <para style="q" vid="AMO 2:3">un ale ire harn vel ich hargen mit im,</para>
  <para style="q" vid="AMO 2:3">zogt Hashem.<verse eid="AMO 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="AMO 2:4" />azoi hot Hashem gezogt:</para>
  <para style="b" vid="AMO 2:4" />
  <para style="q" vid="AMO 2:4">far drai farbrechn fun Yehudah,</para>
  <para style="q" vid="AMO 2:4">yo, far fir, vel ich es nisht ophaltn:</para>
  <para style="q" vid="AMO 2:4">far vos zei hobn faracht di toyre fun Hashem,</para>
  <para style="q" vid="AMO 2:4">un zaine gezetsn nisht gehit;</para>
  <para style="q" vid="AMO 2:4">un zeyere ligns hobn zei farfirt,</para>
  <para style="q" vid="AMO 2:4">di vos zeyere eltern zainen nochgegangen noch zei.<verse eid="AMO 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 2:5" />un ich vel shikn a faier oif Yehudah,</para>
  <para style="q" vid="AMO 2:5">un es vet fartseren di palatsn fun Yerushalayim.<verse eid="AMO 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="AMO 2:6" />azoi hot Hashem gezogt:</para>
  <para style="b" vid="AMO 2:6" />
  <para style="q" vid="AMO 2:6">far drai farbrechn fun Yisroel,</para>
  <para style="q" vid="AMO 2:6">yo, far fir, vel ich es nisht ophaltn:</para>
  <para style="q" vid="AMO 2:6">far zeyer farkoifen far gelt dem gerechtn,</para>
  <para style="q" vid="AMO 2:6">un dem evyon far a por shich.<verse eid="AMO 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 2:7" />zei, vos viln tsetretn oif dem shtoib erd</para>
  <para style="q" vid="AMO 2:7">oifn kop fun di orime,</para>
  <para style="q" vid="AMO 2:7">un dem veg fun di gedrikte fardreyen zei;</para>
  <para style="q" vid="AMO 2:7">un a man un zain foter geyen tsu ein meidl,</para>
  <para style="q" vid="AMO 2:7">kedei tsu farshvechn main heilikn nomen.<verse eid="AMO 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 2:8" />un oif farmshkunte kleider</para>
  <para style="q" vid="AMO 2:8">tsien zei zich ois lebn itlechn mizbeyech,</para>
  <para style="q" vid="AMO 2:8">un vain fun bashtrofte</para>
  <para style="q" vid="AMO 2:8">trinken zei in hoiz fun zeyer G-t.<verse eid="AMO 2:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 2:9" />un ich hob fartilikt far zei dem Emori,</para>
  <para style="q" vid="AMO 2:9">vos vi di heich fun tsedern iz geven zain heich,</para>
  <para style="q" vid="AMO 2:9">un shtark iz er geven vi eichnbeimer;</para>
  <para style="q" vid="AMO 2:9">un ich hob fartilikt zain frucht fun oiben,</para>
  <para style="q" vid="AMO 2:9">un zaine vortselen fun unten.<verse eid="AMO 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 2:10" />un ich hob aich oifgebracht fun land Mitsrayim,</para>
  <para style="q" vid="AMO 2:10">un aich gefirt in der midber fertsik yor,</para>
  <para style="q" vid="AMO 2:10">tsu arben dos land fun Emori.<verse eid="AMO 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 2:11" />un ich hob oifgeshtelt fun aiere zin far neviim,</para>
  <para style="q" vid="AMO 2:11">un fun aiere yungelait far Nezirim;</para>
  <para style="q" vid="AMO 2:11">tsi iz dos nisht azoi, kinder fun Yisroel?</para>
  <para style="q" vid="AMO 2:11">zogt Hashem.<verse eid="AMO 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 2:12" />ober ir hot gemacht trinken di Nezirim vain,</para>
  <para style="q" vid="AMO 2:12">un di neviim hot ir bafoiln azoi tsu zogn:</para>
  <para style="q" vid="AMO 2:12">ir zolt nisht nevies zogn.<verse eid="AMO 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 2:13" />zet, ich drik aich arunter</para>
  <para style="q" vid="AMO 2:13">vi es drikt der vogn ful mit garbn.<verse eid="AMO 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 2:14" />un antrinung vet farlorn zain fun dem flinkn,</para>
  <para style="q" vid="AMO 2:14">un der shtarker vet nisht onhaltn zain koiech,</para>
  <para style="q" vid="AMO 2:14">un der gibor vet nisht rateven zain nefesh.<verse eid="AMO 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 2:15" />un der boignhalter vet nisht bashtein,</para>
  <para style="q" vid="AMO 2:15">un der flinker oif zaine fis vet zich nisht rateven,</para>
  <para style="q" vid="AMO 2:15">un der raiter oif a ferd vet nisht rateven zain nefesh.<verse eid="AMO 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="AMO 2:16" />un der shtarkhartsiker tsvishn di giborim</para>
  <para style="q" vid="AMO 2:16">vet a naketer antloifn in yenem tog,</para>
  <para style="q" vid="AMO 2:16">zogt Hashem.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />hert dos dozike vort vos Hashem hot geredt oif aich, kinder fun Yisroel – oif der gantser mishpoche vos ich hob oifgebracht fun land Mitsrayim, azoi tsu zogn:<verse eid="AMO 3:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="AMO 3:2" />nor aich hob ich derkent fun ale mishpoches fun der erd,</para>
  <para style="q" vid="AMO 3:2">derum vel ich zich rechenen mit aich far ale aiere zind.<verse eid="AMO 3:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="AMO 3:3" />geyen tsvei banander,</para>
  <para style="q" vid="AMO 3:3">achuts az zei hobn opgeredt?<verse eid="AMO 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 3:4" />brilt a leib in vald, vu er hot nisht kein roib?</para>
  <para style="q" vid="AMO 3:4">lozt a yungleib arois zain kol fun zain nore,</para>
  <para style="q" vid="AMO 3:4">achuts az er hot epes gechapt?<verse eid="AMO 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 3:5" />falt a foigel in pastke oif der erd,</para>
  <para style="q" vid="AMO 3:5">vu zi hot nisht kein shtroichlung?</para>
  <para style="q" vid="AMO 3:5">shpringt-oif a pastke fun der erd,</para>
  <para style="q" vid="AMO 3:5">vu chapn zol zi nisht hobn gechapt?<verse eid="AMO 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 3:6" />tsi vert a shoifer geblozn in shtot,</para>
  <para style="q" vid="AMO 3:6">un dos folk zol nisht tsiteren?</para>
  <para style="q" vid="AMO 3:6">tsi geshet an umglik in shtot,</para>
  <para style="q" vid="AMO 3:6">vu Hashem hot dos nisht geton?<verse eid="AMO 3:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="AMO 3:7" />far vor, Adonoi Hashem tut nisht kein zach,</para>
  <para style="q" vid="AMO 3:7">saidn er hot antplekt zain sod</para>
  <para style="q" vid="AMO 3:7">tsu zaine knecht di neviim.<verse eid="AMO 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 3:8" />a leib hot gebrilt,</para>
  <para style="q" vid="AMO 3:8">ver zol nisht moire hobn?</para>
  <para style="q" vid="AMO 3:8">Adonoi Hashem hot geredt,</para>
  <para style="q" vid="AMO 3:8">ver ken nisht nevies zogn?<verse eid="AMO 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 3:9" />macht hern oif di palatsn in Ashdod,</para>
  <para style="q" vid="AMO 3:9">un oif di palatsn in land Mitsrayim,</para>
  <para style="q" vid="AMO 3:9">un zogt: zamlt aich ain oif di berg fun Shomron,</para>
  <para style="q" vid="AMO 3:9">un zet di groise mehumes derin,</para>
  <para style="q" vid="AMO 3:9">un di drikungen in ir mit.<verse eid="AMO 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 3:10" />vorem zei veisn nisht tsu ton recht, zogt Hashem,</para>
  <para style="q" vid="AMO 3:10">zei vos zamlen gzeile un roib in zeyere palatsn.<verse eid="AMO 3:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 3:11" />derum hot Adonoi Hashem azoi gezogt:</para>
  <para style="q" vid="AMO 3:11">a faint, un rund arum land!</para>
  <para style="q" vid="AMO 3:11">un er vet nidern fun dir dain shtarkeit,</para>
  <para style="q" vid="AMO 3:11">un daine palatsn veln tseroibt vern.<verse eid="AMO 3:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />azoi hot Hashem gezogt: azoi vi a pastuch iz matsl fun dem leibs moil a por kni, oder a lepl fun an oier, azoi veln di kinder fun Yisroel, vos zitsn in Shomron, zich matsl zain mit a vinkel fun a shlofbank, un mit a fus fun a bet.<verse eid="AMO 3:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="AMO 3:13" />hert un vornt dem hoiz fun Yaakov,</para>
  <para style="q" vid="AMO 3:13">zog Adonoi Hashem, Elokei Tseva'ot.<verse eid="AMO 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 3:14" />vorem in dem tog vos ich rechn zich</para>
  <para style="q" vid="AMO 3:14">far di farbrechn fun Yisroel mit im,</para>
  <para style="q" vid="AMO 3:14">vel ich zich rechenen far di mizbeyches fun Beis-El,</para>
  <para style="q" vid="AMO 3:14">un di herner fun mizbeyech veln opgehakt vern,</para>
  <para style="q" vid="AMO 3:14">un veln aniderfaln tsu der erd.<verse eid="AMO 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 3:15" />un ich vel shlogn dos vinterhoiz mit dem zumerhoiz,</para>
  <para style="q" vid="AMO 3:15">un di haizer fun elfnbein veln untergein,</para>
  <para style="q" vid="AMO 3:15">un di groise haizer veln farlendt vern,</para>
  <para style="q" vid="AMO 3:15">zogt Hashem.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="AMO 4" />
  <para style="q">
    <verse number="1" style="v" sid="AMO 4:1" />hert dos dozike vort, ir Bashan-ki</para>
  <para style="q" vid="AMO 4:1">vos oifn barg Shomron, di vos baroibn di orime,</para>
  <para style="q" vid="AMO 4:1">vos drikn di evyonim, vos zogn tsu zeyere harn:</para>
  <para style="q" vid="AMO 4:1">breng mir zoln trinken.<verse eid="AMO 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 4:2" />Adonoi Hashem hot geshvorn bai zain heilikeit, az,</para>
  <para style="q" vid="AMO 4:2">ze, teg kumen oif aich,</para>
  <para style="q" vid="AMO 4:2">un me vet aich aveknemen mit hokn,</para>
  <para style="q" vid="AMO 4:2">un aier iberblaib mit fishershtangen.<verse eid="AMO 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 4:3" />un durch moierbrochn vet ir aroisgein,</para>
  <para style="q" vid="AMO 4:3">itleche akegn zich,</para>
  <para style="q" vid="AMO 4:3">un ir vet farvorfen gevorn oif di berg Chermon,</para>
  <para style="q" vid="AMO 4:3">zogt Hashem.<verse eid="AMO 4:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="AMO 4:4" />kumt kein Beis-El un farbrecht,</para>
  <para style="q" vid="AMO 4:4">kein Gilgal, un mert farbrechn,</para>
  <para style="q" vid="AMO 4:4">un brengt tsum frimorgn aiere shlachtopfer,</para>
  <para style="q" vid="AMO 4:4">oifn dritn tog aiere maisres;<verse eid="AMO 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 4:5" />un ir zent makrev a dankopfer mit chomets,</para>
  <para style="q" vid="AMO 4:5">un ruft ois fraivilike gobn, macht hern,</para>
  <para style="q" vid="AMO 4:5">vorem azoi hot ir lib, ir kinder fun Yisroel,</para>
  <para style="q" vid="AMO 4:5">zogt Adonoi Hashem.<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="AMO 4:6" />un ich oich hob aich gegebn</para>
  <para style="q" vid="AMO 4:6">leidike tsein in ale aiere shtet,</para>
  <para style="q" vid="AMO 4:6">un ir hot zich nisht umgekert tsu mir,</para>
  <para style="q" vid="AMO 4:6">zogt Hashem.<verse eid="AMO 4:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="AMO 4:7" />un ich hob oich farmitn fun aich dem regn,</para>
  <para style="q" vid="AMO 4:7">ven noch drai chodeshim tsum shnit,</para>
  <para style="q" vid="AMO 4:7">un ich hob gelozt regenen oif ein shtot,</para>
  <para style="q" vid="AMO 4:7">un oif ein shtot fleg ich nisht lozn regenen;</para>
  <para style="q" vid="AMO 4:7">ein shtik flegt baregnt vern,</para>
  <para style="q" vid="AMO 4:7">un dos shtik vos deroif flegt nisht regenen, flegt fartriknt vern.<verse eid="AMO 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 4:8" />un tsvei drai shtet hobn gevandert tsu ein shtot,</para>
  <para style="q" vid="AMO 4:8">tsu trinken vaser, un flegn nisht krign tsu zat,</para>
  <para style="q" vid="AMO 4:8">un ir hot zich nisht umgekert tsu mir,</para>
  <para style="q" vid="AMO 4:8">zogt Hashem.<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 4:9" />ich hob aich geplogt mit kornbrand un mit velkenish;</para>
  <para style="q" vid="AMO 4:9">di merste fun aiere gertner un aiere vaingertner</para>
  <para style="q" vid="AMO 4:9">un aiere faignbeimer un aiere eilbertbeimer</para>
  <para style="q" vid="AMO 4:9">est der heisherik oif,</para>
  <para style="q" vid="AMO 4:9">un ir hot zich nisht umgekert tsu mir,</para>
  <para style="q" vid="AMO 4:9">zogt Hashem.<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="AMO 4:10" />ich hob ongeshikt oif aich a pest, oifn shteiger fun Mitsrayim,</para>
  <para style="q" vid="AMO 4:10">ich hob geharget mitn shverd aiere yungelait,</para>
  <para style="q" vid="AMO 4:10">dertsu gefangenshaft fun aiere ferd.</para>
  <para style="q" vid="AMO 4:10">un ich hob gelozt oifgein dem geshtank</para>
  <para style="q" vid="AMO 4:10">fun aiere machnus in aier noz,</para>
  <para style="q" vid="AMO 4:10">un ir hot zich nisht umgekert tsu mir,</para>
  <para style="q" vid="AMO 4:10">zogt Hashem.<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 4:11" />ich hob ibergekert tsvishn aich,</para>
  <para style="q" vid="AMO 4:11">azoi vi G-ts iberkerenish fun Sodom un Amora,</para>
  <para style="q" vid="AMO 4:11">un ir zait geblibn vi a shait aroisgerisn fun a sreife,</para>
  <para style="q" vid="AMO 4:11">un ir hot zich nisht umgekert tsu mir,</para>
  <para style="q" vid="AMO 4:11">zogt Hashem.<verse eid="AMO 4:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="AMO 4:12" />derum vel ich azoi ton tsu dir, Yisroel: –</para>
  <para style="q" vid="AMO 4:12">vail ich vel dos dozike ton tsu dir,</para>
  <para style="q" vid="AMO 4:12">breit zich on antkegen dain G-t, Yisroel.<verse eid="AMO 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 4:13" />vorem ze, er furemt di berg, un bashaft dem vint,</para>
  <para style="q" vid="AMO 4:13">un er zogt dem mentshn vos zain trachtung iz;</para>
  <para style="q" vid="AMO 4:13">er macht fun frimorgn fintsternish,</para>
  <para style="q" vid="AMO 4:13">un er tret oif di heichn fun der erd;</para>
  <para style="q" vid="AMO 4:13">Hashem Elokei Tseva'ot iz zain nomen.<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="AMO 5" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />hert dos dozike vort vos ich heib oif far a kloglid oif aich, ir hoiz fun Yisroel:<verse eid="AMO 5:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="AMO 5:2" />gefaln nisht mer oiftsushtein</para>
  <para style="q" vid="AMO 5:2">iz di yungfroi Yisroel.</para>
  <para style="q" vid="AMO 5:2">zi ligt anidergevorfen oif ir erd,</para>
  <para style="q" vid="AMO 5:2">nishto ver zol zi oifshteln.<verse eid="AMO 5:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="AMO 5:3" />vorem azoi hot gezogt Adonoi Hashem:</para>
  <para style="q" vid="AMO 5:3">di shtot vos flegt arois mit toiznt,</para>
  <para style="q" vid="AMO 5:3">vet blaibn bai hundert,</para>
  <para style="q" vid="AMO 5:3">un di vos flegt arois mit hundert,</para>
  <para style="q" vid="AMO 5:3">vet blaibn bai tsen, fun dem hoiz fun Yisroel.<verse eid="AMO 5:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="AMO 5:4" />vorem azoi hot Hashem gezogt tsum hoiz fun Yisroel:</para>
  <para style="q" vid="AMO 5:4">zucht mich, un lebt;<verse eid="AMO 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 5:5" />un ir zolt nisht zuchn Beis-El,</para>
  <para style="q" vid="AMO 5:5">un kein Gilgal zolt ir nisht kumen,</para>
  <para style="q" vid="AMO 5:5">un kein Beer-Sheva zolt ir nisht aribergein;</para>
  <para style="q" vid="AMO 5:5">vorem Gilgal vet in goles gein,</para>
  <para style="q" vid="AMO 5:5">un Beis-El vet tsu nisht vern.<verse eid="AMO 5:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="AMO 5:6" />zucht Hashem, un lebt;</para>
  <para style="q" vid="AMO 5:6">kedei er zol nisht oisbrechn vi a faier in hoiz fun Yosef,</para>
  <para style="q" vid="AMO 5:6">un es vet fartseren, az kein lesher vet nisht zain far Beis-El;<verse eid="AMO 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 5:7" />di vos farkern gerechtikeit in vermut,</para>
  <para style="q" vid="AMO 5:7">un rechtfartikeit leign zei tsu der erd.<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="AMO 5:8" />dem vos macht dem zibnshtern un dem orionshtern,</para>
  <para style="q" vid="AMO 5:8">un farkert toitshotn in frimorgn,</para>
  <para style="q" vid="AMO 5:8">un farfintstert tog in nacht;</para>
  <para style="q" vid="AMO 5:8">dem vos ruft di vasern fun yam,</para>
  <para style="q" vid="AMO 5:8">un gist zei ois oifn gezicht fun der erd,</para>
  <para style="q" vid="AMO 5:8">Hashem iz zain nomen;<verse eid="AMO 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 5:9" />dem vos blitst arois a broch oifn shtarkn,</para>
  <para style="q" vid="AMO 5:9">un a broch kumt oif der festung.<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="AMO 5:10" />zei hobn faint dem vos musert in toier,</para>
  <para style="q" vid="AMO 5:10">un dem vos redt erlech farumverdikn zei.<verse eid="AMO 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 5:11" />derum, vail ir tret oifn oreman,</para>
  <para style="q" vid="AMO 5:11">un opgob fun tvue nemt ir fun im,</para>
  <para style="q" vid="AMO 5:11">hot ir haizer fun gehakte shteiner geboit,</para>
  <para style="q" vid="AMO 5:11">un vet in zei nisht voinen;</para>
  <para style="q" vid="AMO 5:11">hot ir glustike vaingertner geflantst,</para>
  <para style="q" vid="AMO 5:11">un vet nisht trinken zeyer vain.<verse eid="AMO 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 5:12" />vorem ich veis, aiere farbrechn zainen fil,</para>
  <para style="q" vid="AMO 5:12">un shtark aiere zind,</para>
  <para style="q" vid="AMO 5:12">ir, vos drikt dem gerechtn, vos nemt shochad,</para>
  <para style="q" vid="AMO 5:12">un krivdet di evyonim in toier.<verse eid="AMO 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 5:13" />derum shvaigt der farshtandiker in aza tsait,</para>
  <para style="q" vid="AMO 5:13">vorem a beize tsait iz dos.<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="AMO 5:14" />zucht guts un nisht shlechts,</para>
  <para style="q" vid="AMO 5:14">kedei ir zolt lebn,</para>
  <para style="q" vid="AMO 5:14">un Hashem, Elokei Tseva'ot, vet zain mit aich,</para>
  <para style="q" vid="AMO 5:14">azoi vi ir farlangt.<verse eid="AMO 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 5:15" />hot faint shlechts, un hot lib guts,</para>
  <para style="q" vid="AMO 5:15">un shtelt oif in toier gerechtikeit,</para>
  <para style="q" vid="AMO 5:15">efsher vet Hashem, Elokei Tseva'ot,</para>
  <para style="q" vid="AMO 5:15">laitzelikn dem iberblaib fun Yosef.<verse eid="AMO 5:15" /></para>
  <para style="b" />
  <para style="m">
    <verse number="16" style="v" sid="AMO 5:16" />far vor, azoi hot gezogt Hashem, Elokei Tseva'ot, Adonoi:</para>
  <para style="b" vid="AMO 5:16" />
  <para style="q" vid="AMO 5:16">in ale merk vet zain a klog,</para>
  <para style="q" vid="AMO 5:16">un in ale gasn vet men zogn: oi! oi!</para>
  <para style="q" vid="AMO 5:16">un me vet rufn dem akerman tsu troier,</para>
  <para style="q" vid="AMO 5:16">un tsu klog di genite in yomern.<verse eid="AMO 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="AMO 5:17" />un in ale vaingertner vet zain a klog,</para>
  <para style="q" vid="AMO 5:17">az ich vel durchgein tsvishn dir, zogt Hashem.<verse eid="AMO 5:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="AMO 5:18" />vei, di vos bageren dem tog fun Hashem!</para>
  <para style="q" vid="AMO 5:18">tsu vos toig aich den der tog fun Hashem?</para>
  <para style="q" vid="AMO 5:18">er iz fintster un nisht lichtik.<verse eid="AMO 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="AMO 5:19" />azoi vi ven a mentsh antloift fun a leib,</para>
  <para style="q" vid="AMO 5:19">un im bagegent a Beor,</para>
  <para style="q" vid="AMO 5:19">un er kumt in hoiz,</para>
  <para style="q" vid="AMO 5:19">un lent zain hant on der vant,</para>
  <para style="q" vid="AMO 5:19">un a shlang baist im ain.<verse eid="AMO 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="AMO 5:20" />far vor, choishech iz der tog fun Hashem, un nisht lichtik,</para>
  <para style="q" vid="AMO 5:20">un fintster un on a shimer in im.<verse eid="AMO 5:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="AMO 5:21" />ich hob faint, ich faracht aiere yom-tuvim,</para>
  <para style="q" vid="AMO 5:21">un ich ken nisht shmekn aiere ainzamlungen.<verse eid="AMO 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="AMO 5:22" />afile az ir brengt mir oif brandopfer</para>
  <para style="q" vid="AMO 5:22">un aiere shpaizopfer, bavilik ich nisht,</para>
  <para style="q" vid="AMO 5:22">un aiere geshtopte fridopfer kuk ich nisht on.<verse eid="AMO 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="AMO 5:23" />tu op fun mir di brumung fun daine gezangen,</para>
  <para style="q" vid="AMO 5:23">un dos shpil fun daine gitarn lomich nisht hern.<verse eid="AMO 5:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="AMO 5:24" />nor loz kveln vi vaser gerechtikeit,</para>
  <para style="q" vid="AMO 5:24">un rechtfartikeit vi a shtrom a shtarker.<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />hot ir mir shlachtopfer un shpaizopfer gebracht in der midber, far di fertsik yor, ir hoiz fun Yisroel? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />derum vet ir trogn Sikut aier kinig, un Kiyon, aiere getsnbilder, aier shterng‑t vos ir hot aich gemacht. <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />un ich vel aich fartraiben fun yener zait Damesek, zogt Hashem – Elokei Tseva'ot iz zain nomen.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="AMO 6" />
  <para style="q">
    <verse number="1" style="v" sid="AMO 6:1" />vei, di ruike in Tsiyon,</para>
  <para style="q" vid="AMO 6:1">un di zichere oifn barg Shomron,</para>
  <para style="q" vid="AMO 6:1">di barufene Peor fun di felker,</para>
  <para style="q" vid="AMO 6:1">vos tsu zei kumt dos hoiz fun Yisroel!<verse eid="AMO 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 6:2" />geit ariber kein Calneh, un zet,</para>
  <para style="q" vid="AMO 6:2">un geit fun dort kein grois Chammat,</para>
  <para style="q" vid="AMO 6:2">un nidert in Gat fun di Pelishtim;</para>
  <para style="q" vid="AMO 6:2">iz zei beser fun di dozike kinigraichn?</para>
  <para style="q" vid="AMO 6:2">tsi iz zeyer gemark greser fun aier gemark?<verse eid="AMO 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 6:3" />ir vos shtoist op dem beizn tog,</para>
  <para style="q" vid="AMO 6:3">un rukt tsu dem tron fun roib!<verse eid="AMO 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 6:4" />di vos lign oif betn fun elfnbein,</para>
  <para style="q" vid="AMO 6:4">un oisgetsoign oif zeyere gelegers,</para>
  <para style="q" vid="AMO 6:4">un esen lemer fun di shof,</para>
  <para style="q" vid="AMO 6:4">un kelber fun shtal;<verse eid="AMO 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 6:5" />di vos tsimblen oif der gitar –</para>
  <para style="q" vid="AMO 6:5">azoi vi Dovid hobn zei zich oisgetracht klei-zemer;<verse eid="AMO 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 6:6" />di vos trinken in shprengbekns vain,</para>
  <para style="q" vid="AMO 6:6">un mit di beste ailn zalbn zei zich,</para>
  <para style="q" vid="AMO 6:6">un kimern zich nisht um dem broch fun Yosef.<verse eid="AMO 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 6:7" />derum veln zei atsund fartriben vern</para>
  <para style="q" vid="AMO 6:7">farois fun ale fartribene,</para>
  <para style="q" vid="AMO 6:7">un opgeton vet vern der liarem fun di oisgetsoigene.<verse eid="AMO 6:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="AMO 6:8" />Adonoi Hashem hot geshvorn bai zich alein, zogt Hashem Elokei Tseva'ot:</para>
  <para style="b" vid="AMO 6:8" />
  <para style="q" vid="AMO 6:8">ich farumverdik dem shtolts fun Yaakov,</para>
  <para style="q" vid="AMO 6:8">un zaine palatsn hob ich faint gekrogn.</para>
  <para style="q" vid="AMO 6:8">un ich vel iberentfern di shtot mit ir fulkeit!<verse eid="AMO 6:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />un es vet zain, oib es veln iberblaiben tsen mentshn in ein hoiz, veln zei shtarbn. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />un az emitsns feter, un der vos darf im farbrenen, vet im oifheibn kedei aroistsutrogn dos gebein fun hoiz, vet er zogn tsu dem vos in vinkel fun hoiz: iz noch ver do mit dir? un az yener vet zogn: nain, nishto; un er vet zogn: sha! vorem me tor nisht dachtn, baim nomen fun Hashem.<verse eid="AMO 6:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 6:11" />vorem ze, Hashem bafelt,</para>
  <para style="q" vid="AMO 6:11">un me vet tsehakn dos groise hoiz in shtiker,</para>
  <para style="q" vid="AMO 6:11">un dos kleine hoiz oif shpendlech.<verse eid="AMO 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 6:12" />loifn den ferd iber a feldz!</para>
  <para style="q" vid="AMO 6:12">tsi akert men im mit rinder?</para>
  <para style="q" vid="AMO 6:12">vos ir hot farkert gerechtikeit in biterkroit,</para>
  <para style="q" vid="AMO 6:12">un frucht fun rechtfarikeit in vermut;<verse eid="AMO 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 6:13" />ir vos freit zich um gornisht,</para>
  <para style="q" vid="AMO 6:13">vos zogt: far vor, mit undzer shtarkeit</para>
  <para style="q" vid="AMO 6:13">hobn mir zich genumen karanaim.<verse eid="AMO 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 6:14" />far vor, ze, ich shtel on oif aich a folk,</para>
  <para style="q" vid="AMO 6:14">ir hoiz fun Yisroel, zogt Hashem, Elokei Tseva'ot,</para>
  <para style="q" vid="AMO 6:14">un zei veln aich drikn fun vu me kumt kein Chammat</para>
  <para style="q" vid="AMO 6:14">biz dem taich fun dem ploin.<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="AMO 7" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />azoi hot mir Adonoi Hashem gevizn: ersht er hot bashafn a heisherik in onheib oifgein fun der shpet-tvue, un ze, dos iz geven di shpet-tvue noch dem melechs shnit. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />un es iz geven, az er hot geendikt oifesn dos groz fun land, hob ich gezogt:</para>
  <para style="b" vid="AMO 7:2" />
  <para style="q" vid="AMO 7:2">vi, Hashem du Adonoi, fargib, ich bet dich;</para>
  <para style="q" vid="AMO 7:2">vi ken bashtein Yaakov, az er iz azoi klein?<verse eid="AMO 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 7:3" />hot Hashem charote gehat deroif:</para>
  <para style="q" vid="AMO 7:3">dos vet nisht geshen, hot Hashem gezogt.<verse eid="AMO 7:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />azoi hot mir Adonoi Hashem gevizn: ersht Adonoi Hashem hot oisgerufn a krig durch faier, un es hot fartsert dem groisn tehom, un volt fartsert dos land. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />hob ich gezogt:</para>
  <para style="b" vid="AMO 7:5" />
  <para style="q" vid="AMO 7:5">Hashem du Adonoi, her oif, ich bet dich;</para>
  <para style="q" vid="AMO 7:5">vi ken bashtein Yaakov, az er iz azoi klein?<verse eid="AMO 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 7:6" />hot Hashem charote gehat deroif:</para>
  <para style="q" vid="AMO 7:6">dos oich vet nisht geshen, hot Adonoi Hashem gezogt.<verse eid="AMO 7:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />azoi hot er mir gevizn: ersht Adonoi shteit oif a shnurglaicher moier, un in zain hant iz a vogshnur. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />un Hashem hot tsu mir gezogt: vos zestu, Amos? hob ich gezogt: a vogshnur. hot Adonoi gezogt:</para>
  <para style="b" vid="AMO 7:8" />
  <para style="q" vid="AMO 7:8">ze, ich tsi a vogshnur</para>
  <para style="q" vid="AMO 7:8">tsvishn main folk Yisroel,</para>
  <para style="q" vid="AMO 7:8">ich vel im mer vider nisht fargebn.<verse eid="AMO 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 7:9" />un di bamot fun ytschk veln farvist vern,</para>
  <para style="q" vid="AMO 7:9">un di heiliktumen fun Yisroel veln chorev vern,</para>
  <para style="q" vid="AMO 7:9">un ich vel oifshtein oifn hoiz fun Yarovam mitn shverd.<verse eid="AMO 7:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />un Amatsyah der koyen fun Beis-El hot geshikt tsu Yarovam dem melech fun Yisroel, azoi tsu zogn: Amos hot gemacht a bunt oif dir tsvishn di kinder fun Yisroel; dos land ken nisht oishaltn ale zaine reid. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />vorem Amos hot azoi gezogt:</para>
  <para style="q" vid="AMO 7:11">durchn shverd vet shtarbn Yarovam,</para>
  <para style="q" vid="AMO 7:11">un Yisroel vet in goles</para>
  <para style="q" vid="AMO 7:11">avek fun zain erd.<verse eid="AMO 7:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />un Amatsyah hot gezogt tsu Amosn: zeer, gei antloif dir kein land Yehudah, un es dortn broit, un dortn zolstu nevies zogn. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />ober in Beis-El zolstu mer vider nevies nisht zogn vorem es iz a melechs heiliktum, un es iz a hoiz fun meluche.<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />hot geentfert Amos un hot gezogt tsu Amatsyahn: nisht kein novi bin ich, un nisht kein zun fun a novi bin ich, naiert a pastuch fun rinder bin ich, un a tsurichter fun vilde faign. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />un Hashem hot mich genumen fun hinter di shof, un Hashem hot tsu mir gezogt: gei zog nevies tsu main folk Yisroel. <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />un atsund her dos vort fun Hashem:</para>
  <para style="p" vid="AMO 7:16">du zogst: zolst nisht nevies zogn oif Yisroel, un nisht darshen oif dem hoiz fun ytschk.<verse eid="AMO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17" />derum hot Hashem azoi gezogt:</para>
  <para style="b" vid="AMO 7:17" />
  <para style="q" vid="AMO 7:17">dain vaib vet in shtot a zoine zain,</para>
  <para style="q" vid="AMO 7:17">un daine zin un daine techter veln faln durchn shverd,</para>
  <para style="q" vid="AMO 7:17">un dain erd vet mit a shnur tseteilt vern,</para>
  <para style="q" vid="AMO 7:17">un du vest shtarbn oif umreiner erd,</para>
  <para style="q" vid="AMO 7:17">un Yisroel vet in goles avek fun zain erd.<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="AMO 8" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />azoi hot mir Adonoi Hashem gevizn: ersht a korb zumeroibs. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />un er hot tsu mir gezogt: vos zestu, Amos? hob ich gezogt: a korb zumeroibs. hot Hashem tsu mir gezogt:</para>
  <para style="b" vid="AMO 8:2" />
  <para style="q" vid="AMO 8:2">gekumen iz der sof oif main folk Yisroel,</para>
  <para style="q" vid="AMO 8:2">ich vel im mer vider nisht fargebn.<verse eid="AMO 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 8:3" />un yomern veln di gezangen fun palats in yenem tog,</para>
  <para style="q" vid="AMO 8:3">zogt Adonoi Hashem;</para>
  <para style="q" vid="AMO 8:3">pgorim veln zain fil,</para>
  <para style="q" vid="AMO 8:3">in yetveder ort vet zain ongevorfn a shtilkeit.<verse eid="AMO 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 8:4" />hert dos tsu, ir vos vilt ainshlingen dem evyon,</para>
  <para style="q" vid="AMO 8:4">un fartiliken di orime fun land,<verse eid="AMO 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 8:5" />azoi tsu zogn: ven vet ariber rosh-choidesh,</para>
  <para style="q" vid="AMO 8:5">az mir zoln farkoifen tvue,</para>
  <para style="q" vid="AMO 8:5">un Shabbos, az mir zoln efenen korn,</para>
  <para style="q" vid="AMO 8:5">tsu farklenern di eife, un tsu fargresern dem shekl,</para>
  <para style="q" vid="AMO 8:5">un tsu fardreyen mit falshe vogsholn;<verse eid="AMO 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 8:6" />kedei tsu koifn far gelt di orime,</para>
  <para style="q" vid="AMO 8:6">un dem evyon far a por shich,</para>
  <para style="q" vid="AMO 8:6">un dem opfal fun korn zoln mir farkoifen.<verse eid="AMO 8:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="AMO 8:7" />Hashem hot geshvorn bai dem shtolts fun Yaakov:</para>
  <para style="q" vid="AMO 8:7">oib ich vel eibik fargesen ale zeyere meisim!<verse eid="AMO 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 8:8" />zol iber dem nisht tsiteren di erd,</para>
  <para style="q" vid="AMO 8:8">un troiern itlecher vos voint oif ir?</para>
  <para style="q" vid="AMO 8:8">yo, zi vet zich oifheibn in gantsn vi der taich,</para>
  <para style="q" vid="AMO 8:8">un tserudert vern un zich aropzetsn</para>
  <para style="q" vid="AMO 8:8">vi der taich fun Mitsrayim.<verse eid="AMO 8:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 8:9" />un es vet zain in yenem tog,</para>
  <para style="q" vid="AMO 8:9">zogt Adonoi Hashem,</para>
  <para style="q" vid="AMO 8:9">vel ich machn untergein di zun in mitn tog,</para>
  <para style="q" vid="AMO 8:9">un fintster machn di erd in heln tog.<verse eid="AMO 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 8:10" />un ich vel farkern aiere yom-tuvim in troier,</para>
  <para style="q" vid="AMO 8:10">un ale aiere gezangen in a klog,</para>
  <para style="q" vid="AMO 8:10">un ich vel aroifbrengen oif ale lendn zak,</para>
  <para style="q" vid="AMO 8:10">un oif itlechn kop a plich,</para>
  <para style="q" vid="AMO 8:10">un ich vel es machn vi der troier noch an eineintsikn,</para>
  <para style="q" vid="AMO 8:10">un ir sof, vi a bitern tog.<verse eid="AMO 8:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 8:11" />ze, teg kumen, zogt Adonoi Hashem,</para>
  <para style="q" vid="AMO 8:11">un ich vel shikn a hunger in land,</para>
  <para style="q" vid="AMO 8:11">nisht a hunger noch broit, un nisht a dorsht noch vaser,</para>
  <para style="q" vid="AMO 8:11">naiert tsu hern di verter fun G-t.<verse eid="AMO 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 8:12" />un zei veln voglen fun yam tsu yam,</para>
  <para style="q" vid="AMO 8:12">un fun TSafon biz mizrech;</para>
  <para style="q" vid="AMO 8:12">zei veln umvandern tsu zuchn Hashems vort,</para>
  <para style="q" vid="AMO 8:12">un zei veln nisht gefinen.<verse eid="AMO 8:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="AMO 8:13" />in yenem tog veln chaleshn di sheine yungfroin</para>
  <para style="q" vid="AMO 8:13">un di bochurim fun dorsht.<verse eid="AMO 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 8:14" />di vos shvern bai der zind fun Shomron,</para>
  <para style="q" vid="AMO 8:14">un zogn: azoi vi es lebt dain G-t, Dan!</para>
  <para style="q" vid="AMO 8:14">un: azoi vi es lebt der veg Beer-Sheva!</para>
  <para style="q" vid="AMO 8:14">un zei veln faln, un veln mer nisht oifshtein.<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="AMO 9" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />ich hob gezen Adonoi shtein oifn mizbeyech, un er hot gezogt:</para>
  <para style="b" vid="AMO 9:1" />
  <para style="q" vid="AMO 9:1">shlog di zailnkep, az di baishtidlech zoln tsiteren,</para>
  <para style="q" vid="AMO 9:1">un tsebrech zei iber zeyere alemens kep;</para>
  <para style="q" vid="AMO 9:1">un zeyer iberblaib vel ich hargen mitn shverd;</para>
  <para style="q" vid="AMO 9:1">nisht antloifn vet fun zei an antlofener,</para>
  <para style="q" vid="AMO 9:1">un nisht rateven vet zich fun zei an antrunener.<verse eid="AMO 9:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="AMO 9:2" />az zei veln zich fargrobn in Sheol,</para>
  <para style="q" vid="AMO 9:2">vet zei fun dortn aroisnemen main hant,</para>
  <para style="q" vid="AMO 9:2">un az zei veln aroifgein in himel,</para>
  <para style="q" vid="AMO 9:2">vel ich zei fun dortn aropnideren.<verse eid="AMO 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 9:3" />un az zei veln zich bahaltn oifn shpits Karmel,</para>
  <para style="q" vid="AMO 9:3">vel ich fun dortn oifzuchn un zei tsunemen,</para>
  <para style="q" vid="AMO 9:3">un az zei veln zich farborgen</para>
  <para style="q" vid="AMO 9:3">fun far maine oign oifn grunt fun yam,</para>
  <para style="q" vid="AMO 9:3">vel ich dortn bafeln der shlang,</para>
  <para style="q" vid="AMO 9:3">un zi vet zei ainbaisn.<verse eid="AMO 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 9:4" />un az zei veln gein in gefangenshaft far zeyere faint,</para>
  <para style="q" vid="AMO 9:4">vel ich dortn bafeln der shverd, un zi vet zei hargen,</para>
  <para style="q" vid="AMO 9:4">un ich vel ton oif zei main oig</para>
  <para style="q" vid="AMO 9:4">tsum beizn un nisht tsum gutn.<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="AMO 9:5" />vorem Adonoi Hashem fun Tseva'ot</para>
  <para style="q" vid="AMO 9:5">iz der vos rirt on di erd un zi vaklt zich,</para>
  <para style="q" vid="AMO 9:5">un ale voiner oif ir troiern;</para>
  <para style="q" vid="AMO 9:5">un zi heibt zich oif in gantsn vi der taich,</para>
  <para style="q" vid="AMO 9:5">un zetst zich arop vi der taich fun Mitsrayim.<verse eid="AMO 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 9:6" />der vos boit in himel zaine eiberkamern,</para>
  <para style="q" vid="AMO 9:6">un gruntfest zain gevelb oif der erd;</para>
  <para style="q" vid="AMO 9:6">vos ruft di vasern fun yam,</para>
  <para style="q" vid="AMO 9:6">un gist zei ois oifn gezicht fun der erd;</para>
  <para style="q" vid="AMO 9:6">Hashem iz zain nomen.<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="AMO 9:7" />far vor, azoi vi di kinder fun Kushim zait ir mir,</para>
  <para style="q" vid="AMO 9:7">kinder fun Yisroel, zogt Hashem.</para>
  <para style="q" vid="AMO 9:7">far vor, ich hob oifgebracht Yisroel fun land Mitsrayim,</para>
  <para style="q" vid="AMO 9:7">un di Pelishtim fun Kaftor,</para>
  <para style="q" vid="AMO 9:7">un Aram fun Kir.<verse eid="AMO 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 9:8" />ze, di oign fun Adonoi Hashem</para>
  <para style="q" vid="AMO 9:8">zainen oif dem zindikn kinigraich,</para>
  <para style="q" vid="AMO 9:8">un ich fartilik es fun gezicht fun der erd,</para>
  <para style="q" vid="AMO 9:8">ober fartiliken vel ich nisht fartiliken dos hoiz fun Yaakov,</para>
  <para style="q" vid="AMO 9:8">zogt Hashem.<verse eid="AMO 9:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 9:9" />vorem ze, ich bafel un vel lozn shoklen</para>
  <para style="q" vid="AMO 9:9">dos hoiz fun Yisroel tsvishn ale felker,</para>
  <para style="q" vid="AMO 9:9">azoi vi es vert geshoklt in a zip;</para>
  <para style="q" vid="AMO 9:9">ober nisht a kerendel vet faln tsu der erd.<verse eid="AMO 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 9:10" />durchn shverd veln shtarbn ale zindike fun main folk,</para>
  <para style="q" vid="AMO 9:10">vos zogn: nisht genenen un zich federn oif undz vet dos beiz.<verse eid="AMO 9:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 9:11" />in yenem tog vel ich oifshteln</para>
  <para style="q" vid="AMO 9:11">dos aingefalene baidl fun Dovid,</para>
  <para style="q" vid="AMO 9:11">un ich vel farmoiern ire brochn,</para>
  <para style="q" vid="AMO 9:11">un zaine churves vel ich oifshteln,</para>
  <para style="q" vid="AMO 9:11">un vel es oifboien vi in amolike teg;<verse eid="AMO 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 9:12" />kedei es zoln arben dem iberblaib fun Edom un ale felker</para>
  <para style="q" vid="AMO 9:12">di vos main nomen vert gerufn oif zei,</para>
  <para style="q" vid="AMO 9:12">zogt Hashem, der vos tut dos dozike.<verse eid="AMO 9:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="AMO 9:13" />ze, teg kumen, zogt Hashem,</para>
  <para style="q" vid="AMO 9:13">un der akerer vet zich onshtoisn on dem shniter,</para>
  <para style="q" vid="AMO 9:13">un der troibntreter on dem zerie-varfer;</para>
  <para style="q" vid="AMO 9:13">un di berg veln trifn zaft,</para>
  <para style="q" vid="AMO 9:13">un ale heichn veln tsegein.<verse eid="AMO 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 9:14" />un ich vel umkeren di gefangenshaft fun main folk Yisroel,</para>
  <para style="q" vid="AMO 9:14">un zei veln opboien farviste shtet un zich bazetsn,</para>
  <para style="q" vid="AMO 9:14">un flantsn vaingertner un trinken zeyer vain,</para>
  <para style="q" vid="AMO 9:14">un machn gertner un esen zeyer frucht.<verse eid="AMO 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 9:15" />un ich vel zei ainflantsn oif zeyer erd,</para>
  <para style="q" vid="AMO 9:15">un zei veln mer nisht oisgerisn vern</para>
  <para style="q" vid="AMO 9:15">fun der erd vos ich hob zei gegebn,</para>
  <para style="q" vid="AMO 9:15">zogt Hashem dain G-t.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>