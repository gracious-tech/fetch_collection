<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Orthodox Yiddish TaNaCH 2023 mt2</book>
  <para style="h">Shir Hashirim</para>
  <para style="toc2">Shir Hashirim</para>
  <para style="toc1">Shir Hashirim</para>
  <para style="mt1">Shir Hashirim</para>
  <chapter number="1" style="c" pubnumber="א" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />dos gezang fun gezangen, vos fun Shlomoen.<verse eid="SNG 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="SNG 1:2" />kushn zol er mich mit di kushn fun zain moil;</para>
  <para style="q" vid="SNG 1:2">vorem beser fun vain iz dain libshaft.<verse eid="SNG 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 1:3" />voil tsum geruch zainen daine eiln,</para>
  <para style="q" vid="SNG 1:3">geklerte boimel iz dain nomen,</para>
  <para style="q" vid="SNG 1:3">derum hobn yungfroin dich lib.<verse eid="SNG 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 1:4" />tsi mich noch dir, lomir loifn! –</para>
  <para style="q" vid="SNG 1:4">zol der melech mich brengen in zaine kamern.</para>
  <para style="b" vid="SNG 1:4" />
  <para style="q" vid="SNG 1:4">mir veln zain lustik un freilech mit dir,</para>
  <para style="q" vid="SNG 1:4">mir veln loibn dain libshaft merer fun vain.</para>
  <para style="q" vid="SNG 1:4">emes lib hot men dich.<verse eid="SNG 1:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="SNG 1:5" />shvarts bin ich, ober shein,</para>
  <para style="q" vid="SNG 1:5">techter fun Yerushalayim,</para>
  <para style="q" vid="SNG 1:5">vi di getseltn fun Kedar,</para>
  <para style="q" vid="SNG 1:5">vi di forhangen Shlomos.<verse eid="SNG 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 1:6" />nisht kukt mich on vos ich bin shvartslech,</para>
  <para style="q" vid="SNG 1:6">vorem di zun hot mich opgebrent.</para>
  <para style="q" vid="SNG 1:6">di zin fun main muter hobn getsernt oif mir,</para>
  <para style="q" vid="SNG 1:6">zei hobn mich gemacht a hiterin fun di vaingertner;</para>
  <para style="q" vid="SNG 1:6">main eigenem vaingorten hob ich nisht opgehit.<verse eid="SNG 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 1:7" />zog mir du vemen main zel hot lib,</para>
  <para style="q" vid="SNG 1:7">vu fiterstu, vu machstu hoiern in mitn tog?</para>
  <para style="q" vid="SNG 1:7">vorem noch vos zol ich zain vi an arumtraiberin</para>
  <para style="q" vid="SNG 1:7">bai di stades fun daine chaverim?<verse eid="SNG 1:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="SNG 1:8" />oib du veist es dir nisht, du shenste fun froien,</para>
  <para style="q" vid="SNG 1:8">gei dir arois in di trit fun di shof,</para>
  <para style="q" vid="SNG 1:8">un fiter daine tsikelech</para>
  <para style="q" vid="SNG 1:8">bai di pastuchgetseltn.<verse eid="SNG 1:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="SNG 1:9" />tsu a ferdin in Pharaohs raitvogn</para>
  <para style="q" vid="SNG 1:9">hob ich dich geglichn, gelibte main.<verse eid="SNG 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 1:10" />shein zainen daine bakn in di keitlech,</para>
  <para style="q" vid="SNG 1:10">dain haldz in di shnurn.<verse eid="SNG 1:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="SNG 1:11" />gilderne keitlech dir veln mir machn,</para>
  <para style="q" vid="SNG 1:11">mit pintlech fun zilber.<verse eid="SNG 1:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="SNG 1:12" />beeis der melech iz geven oif zain hesb-bet,</para>
  <para style="q" vid="SNG 1:12">hot main nard gegebn zain reyech.<verse eid="SNG 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 1:13" />a bintel mire vos rut tsvishn maine brist,</para>
  <para style="q" vid="SNG 1:13">iz main gelibter mir.<verse eid="SNG 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 1:14" />a hengl tsiperblumen in eein-gedis vaingertner</para>
  <para style="q" vid="SNG 1:14">iz main gelibter mir.<verse eid="SNG 1:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="SNG 1:15" />bist shein, gelibte main, bist shein,</para>
  <para style="q" vid="SNG 1:15">daine oign zainen toibn.<verse eid="SNG 1:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="SNG 1:16" />bist shein gelibter main, un liblech,</para>
  <para style="q" vid="SNG 1:16">grin oich iz undzer geleger;<verse eid="SNG 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 1:17" />undzere hoizbalkns tsedern,</para>
  <para style="q" vid="SNG 1:17">undzere vantbreter tsipresn.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="SNG 2" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 2:1" />ich bin a roiz fun Sharon,</para>
  <para style="q" vid="SNG 2:1">a lilie fun di toln.<verse eid="SNG 2:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="SNG 2:2" />vi a lilie tsvishn di derner,</para>
  <para style="q" vid="SNG 2:2">azoi iz main gelibte tsvishn di techter.<verse eid="SNG 2:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="SNG 2:3" />vi an eplboim tsvishn di valdbeimer,</para>
  <para style="q" vid="SNG 2:3">azoi iz main gelibter tsvishn di zin.</para>
  <para style="q" vid="SNG 2:3">in zain shotn gelust ich tsu zitsn,</para>
  <para style="q" vid="SNG 2:3">un zis iz zain frucht tsu main gumen.<verse eid="SNG 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 2:4" />er hot mich gebracht in der vainkamer,</para>
  <para style="q" vid="SNG 2:4">un zain fon iber mir iz libshaft geven.<verse eid="SNG 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 2:5" />lobt mich mit troibkuchns,</para>
  <para style="q" vid="SNG 2:5">kvikt mich mit Ofel,</para>
  <para style="q" vid="SNG 2:5">vorem krank fun libshaft bin ich.<verse eid="SNG 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 2:6" />zain linke hant unter main kop,</para>
  <para style="q" vid="SNG 2:6">un zain rechte zol mich arumnemen.<verse eid="SNG 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 2:7" />ich bashver aich, techter fun Yerushalayim,</para>
  <para style="q" vid="SNG 2:7">bai di hirshn oder bai di hindn fun feld,</para>
  <para style="q" vid="SNG 2:7">oib ir vet veken un oib ir vet oifvekn di libshaft,</para>
  <para style="q" vid="SNG 2:7">biz zi vet bageren.<verse eid="SNG 2:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="SNG 2:8" />horch! main gelibter!</para>
  <para style="q" vid="SNG 2:8">ot-o kumt er; er shpringt iber di berg,</para>
  <para style="q" vid="SNG 2:8">er hupt iber di heichn.<verse eid="SNG 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 2:9" />main gelibter iz geglichn tsu a hirsh,</para>
  <para style="q" vid="SNG 2:9">oder tsu a hind a yungn;</para>
  <para style="q" vid="SNG 2:9">ot-o shteit er hinter undzer vant,</para>
  <para style="q" vid="SNG 2:9">er kukt durch di fentster,</para>
  <para style="q" vid="SNG 2:9">er blikt durch di gratkes.<verse eid="SNG 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 2:10" />hot zich opgerufn main gelibter,</para>
  <para style="q" vid="SNG 2:10">un gezogt tsu mir:</para>
  <para style="q" vid="SNG 2:10">shtei dir oif main gelibte, main sheine,</para>
  <para style="q" vid="SNG 2:10">un kum dir.<verse eid="SNG 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 2:11" />vorem ze, der vinter iz ariber,</para>
  <para style="q" vid="SNG 2:11">der regn iz fargangen, avek.<verse eid="SNG 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 2:12" />di blumen hobn zich bavizn in land,</para>
  <para style="q" vid="SNG 2:12">di tsait fun gezang iz gekumen,</para>
  <para style="q" vid="SNG 2:12">un der kol fun der turtltoib lozt zich hern in undzer land.<verse eid="SNG 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 2:13" />der faignboim tsaitikt zaine frifaign,</para>
  <para style="q" vid="SNG 2:13">un di vainshtokn in bliung gibn a reyech.</para>
  <para style="q" vid="SNG 2:13">shtei dir oif, main gelibte, main sheine,</para>
  <para style="q" vid="SNG 2:13">un kum dir.<verse eid="SNG 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 2:14" />main toib in di shpaltn fun feldz,</para>
  <para style="q" vid="SNG 2:14">in der farborgenish funem bargtrep,</para>
  <para style="q" vid="SNG 2:14">loz mich onzen dain ponem,</para>
  <para style="q" vid="SNG 2:14">loz mich hern dain kol,</para>
  <para style="q" vid="SNG 2:14">vorem dain kol iz zis,</para>
  <para style="q" vid="SNG 2:14">un dain ponem iz shein.<verse eid="SNG 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 2:15" />chapt undz di fiks,</para>
  <para style="q" vid="SNG 2:15">kleine fiks vos fardorben di vaingertner,</para>
  <para style="q" vid="SNG 2:15">vorem undzere vaingertner</para>
  <para style="q" vid="SNG 2:15">zainen in bliung.<verse eid="SNG 2:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="SNG 2:16" />main gelibter gehert mir,</para>
  <para style="q" vid="SNG 2:16">un ich geher im,</para>
  <para style="q" vid="SNG 2:16">dem vos vandert tsvishn di lilien.<verse eid="SNG 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 2:17" />biz farveyen vet der tog,</para>
  <para style="q" vid="SNG 2:17">un antrinen veln di shotns,</para>
  <para style="q" vid="SNG 2:17">drai zich um, main gelibter,</para>
  <para style="q" vid="SNG 2:17">un zai geglichn tsu a hirsh,</para>
  <para style="q" vid="SNG 2:17">oder tsu a hind a yungen,</para>
  <para style="q" vid="SNG 2:17">oif di tseshpoltene berg.<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="SNG 3" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 3:1" />oif main geleger bai nacht</para>
  <para style="q" vid="SNG 3:1">hob ich gezucht dem vos main zel hot lib;</para>
  <para style="q" vid="SNG 3:1">ich hob im gezucht, un hob im nisht gefunen.<verse eid="SNG 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 3:2" />lomich oifshtein un arumgein in shtot,</para>
  <para style="q" vid="SNG 3:2">in di merk un in di gasn,</para>
  <para style="q" vid="SNG 3:2">lomich zuchn dem vos main zel hot lib.</para>
  <para style="q" vid="SNG 3:2">ich hob im gezucht, un hob im nisht gefunen.<verse eid="SNG 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 3:3" />hobn mir getrofn di vechter vos geyen arum in der shtot:</para>
  <para style="q" vid="SNG 3:3">dem vos main zel hot lib tsi hot ir gezen?<verse eid="SNG 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 3:4" />koim bin ich avek fun zei,</para>
  <para style="q" vid="SNG 3:4">bald hob ich gefunen, dem vos main zel hot lib;</para>
  <para style="q" vid="SNG 3:4">hob ich im ongenumen un hob im nisht opgelozt,</para>
  <para style="q" vid="SNG 3:4">biz ich hob im gebracht in hoiz fun main muter,</para>
  <para style="q" vid="SNG 3:4">un in kamer fun main gevinerin.<verse eid="SNG 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 3:5" />ich bashver aich, techter fun Yerushalayim,</para>
  <para style="q" vid="SNG 3:5">bai di hirshn oder bai di hindn fun feld,</para>
  <para style="q" vid="SNG 3:5">oib ir vet veken un oib ir vet oifvekn di libshaft,</para>
  <para style="q" vid="SNG 3:5">biz zi vet bageren.<verse eid="SNG 3:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="SNG 3:6" />ver iz di vos geit oif funem midber,</para>
  <para style="q" vid="SNG 3:6">azoi vi zailn fun roich,</para>
  <para style="q" vid="SNG 3:6">bareichert mit mire un vairech,</para>
  <para style="q" vid="SNG 3:6">mit alerlei virtsshtoib fun kremer?<verse eid="SNG 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 3:7" />ot iz dos aprion fun Shlomoen,</para>
  <para style="q" vid="SNG 3:7">zechtsik giborim arum ir,</para>
  <para style="q" vid="SNG 3:7">fun di giborim fun Yisroel;<verse eid="SNG 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 3:8" />ale bagurt mit a shverd,</para>
  <para style="q" vid="SNG 3:8">genit in milchome;</para>
  <para style="q" vid="SNG 3:8">itlech zain shverd oif zain dich,</para>
  <para style="q" vid="SNG 3:8">fun vegen der angst in di necht.<verse eid="SNG 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 3:9" />an aprion hot zich melech Shlomo gemacht</para>
  <para style="q" vid="SNG 3:9">fun holtsn fun Levanon;<verse eid="SNG 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 3:10" />ire zailn hot er fun zilber gemacht,</para>
  <para style="q" vid="SNG 3:10">ir onlen fun gold,</para>
  <para style="q" vid="SNG 3:10">ir oisbet fun purpl;</para>
  <para style="q" vid="SNG 3:10">ineveinik geflastert mit libshaft</para>
  <para style="q" vid="SNG 3:10">fun di techter fun Yerushalayim.<verse eid="SNG 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 3:11" />geit arois, techter fun Tsiyon,</para>
  <para style="q" vid="SNG 3:11">un kukt on melech Shlomo,</para>
  <para style="q" vid="SNG 3:11">in der kroin vos zain muter hot im bakreint,</para>
  <para style="q" vid="SNG 3:11">in tog fun zain chasuna,</para>
  <para style="q" vid="SNG 3:11">un in tog fun zain hartsnfreid.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="SNG 4" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 4:1" />bist shein, gelibte main, bist shein,</para>
  <para style="q" vid="SNG 4:1">daine oign zainen toibn fun dain shleyer durch;</para>
  <para style="q" vid="SNG 4:1">daine hor vi a stade tsign vos lozn zich arop fun barg Gilad.<verse eid="SNG 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 4:2" />daine tsein vi a stade shof getokte,</para>
  <para style="q" vid="SNG 4:2">vos kumen aroif fun gevesh,</para>
  <para style="q" vid="SNG 4:2">vos tsvilingen zich ale,</para>
  <para style="q" vid="SNG 4:2">un nishto kein farvarferin tsvishn zei.<verse eid="SNG 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 4:3" />vi a roit fodem zainen daine lipn,</para>
  <para style="q" vid="SNG 4:3">un dain moil iz bachent;</para>
  <para style="q" vid="SNG 4:3">vi an oifshnit milgroim iz dain shleif</para>
  <para style="q" vid="SNG 4:3">fun dain shleyer durch.<verse eid="SNG 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 4:4" />dain haldz vi der turem fun Dovid</para>
  <para style="q" vid="SNG 4:4">oif ontsukukn geboit –</para>
  <para style="q" vid="SNG 4:4">toiznt pansters hengen oif im,</para>
  <para style="q" vid="SNG 4:4">ale shildn fun di giborim.<verse eid="SNG 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 4:5" />daine tsvei brist vi tsvei hirshlech,</para>
  <para style="q" vid="SNG 4:5">tsvilings fun a hirshin, vos fitern zich tsvishn di lilien.<verse eid="SNG 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 4:6" />biz farveyen vet der tog un antrinen veln di shotns,</para>
  <para style="q" vid="SNG 4:6">vel ich mir gein tsum barg fun mire,</para>
  <para style="q" vid="SNG 4:6">un tsum bergel fun vairech.<verse eid="SNG 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 4:7" />bist in gantsn shein, gelibte main,</para>
  <para style="q" vid="SNG 4:7">un kein feler iz in dir nishto.<verse eid="SNG 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 4:8" />mit mir fun Levanon,</para>
  <para style="q" vid="SNG 4:8">main kale, mit mir fun Levanon zolstu kumen;</para>
  <para style="q" vid="SNG 4:8">vest aropkukn fun shpits fun Amanah,</para>
  <para style="q" vid="SNG 4:8">fun shpits fun Senir un Chermon,</para>
  <para style="q" vid="SNG 4:8">fun di voinungen fun di leibn,</para>
  <para style="q" vid="SNG 4:8">fun di berg fun di lempertn.<verse eid="SNG 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="SNG 4:9" />du host mich gefangen, shvester main kale,</para>
  <para style="q" vid="SNG 4:9">du host mich gefangen mit einem fun daine blikn,</para>
  <para style="q" vid="SNG 4:9">mit ein shnur fun daine haldzbender.<verse eid="SNG 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 4:10" />vi shein iz dain libshaft, shvester main kale,</para>
  <para style="q" vid="SNG 4:10">vi beser dain libshaft fun vain,</para>
  <para style="q" vid="SNG 4:10">un der reyech fun daine eiln, fun alerlei b'somaim!<verse eid="SNG 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 4:11" />honikzaft trifn daine lipn, main kale,</para>
  <para style="q" vid="SNG 4:11">honik un milch iz unter dain tsung,</para>
  <para style="q" vid="SNG 4:11">un der reyech fun daine kleider vi der reyech fun Levanon.<verse eid="SNG 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 4:12" />a farshlosener gortn iz main shvester main kale,</para>
  <para style="q" vid="SNG 4:12">a farshlosener brunem, a farchtmeter kval.<verse eid="SNG 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 4:13" />daine tsvaign – a sod milgroimen mit taiere frucht,</para>
  <para style="q" vid="SNG 4:13">tsiperblumen mit nardn;<verse eid="SNG 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 4:14" />nard un zafran, gevirtsror un tsimering</para>
  <para style="q" vid="SNG 4:14">mit alerlei vairoichbeimer,</para>
  <para style="q" vid="SNG 4:14">mire un lahen mit alerlei geklibene b'somaim.<verse eid="SNG 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 4:15" />a gortnkval, a brunem lebedike vaser,</para>
  <para style="q" vid="SNG 4:15">un flusn fun Levanon.<verse eid="SNG 4:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="SNG 4:16" />dervek dich, tsofn-vint,</para>
  <para style="q" vid="SNG 4:16">un kum, du dorem-vint;</para>
  <para style="q" vid="SNG 4:16">bloz oif main gortn,</para>
  <para style="q" vid="SNG 4:16">zaine b'somaim zoln flisn,</para>
  <para style="q" vid="SNG 4:16">zol kumen main gelibter in zain gortn,</para>
  <para style="q" vid="SNG 4:16">un esen zain taiere frucht.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="SNG 5" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 5:1" />ich bin gekumen in main gortn, shvester main kale,</para>
  <para style="q" vid="SNG 5:1">geklibn main mire mit maine b'somaim;</para>
  <para style="q" vid="SNG 5:1">gegesn main sot mit main honik,</para>
  <para style="q" vid="SNG 5:1">getrunken main vain mit main milch.</para>
  <para style="b" vid="SNG 5:1" />
  <para style="q" vid="SNG 5:1">est, chaverim, trinkt un baroisht aich mit libshaft.<verse eid="SNG 5:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="SNG 5:2" />ich shlof un main harts iz oif;</para>
  <para style="q" vid="SNG 5:2">horch! main gelibter klapt;</para>
  <para style="q" vid="SNG 5:2">efen mir, main shvester, main gelibte,</para>
  <para style="q" vid="SNG 5:2">main toib, main umshuldike,</para>
  <para style="q" vid="SNG 5:2">vorem main kop iz ful mit toi,</para>
  <para style="q" vid="SNG 5:2">maine loken mit tropns fun nacht.<verse eid="SNG 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 5:3" />ich hob oisgeton main mantl,</para>
  <para style="q" vid="SNG 5:3">vi ken ich es onton?</para>
  <para style="q" vid="SNG 5:3">ich hob gevashn maine fis,</para>
  <para style="q" vid="SNG 5:3">vi ken ich zei ainrichtn?<verse eid="SNG 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 5:4" />hot main gelibter oisgeshtrekt zain hant durchn tirloch,</para>
  <para style="q" vid="SNG 5:4">un maine ingeveid hobn gebrumt tsu im.<verse eid="SNG 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 5:5" />bin ich oifgeshtanen efenen main gelibtn,</para>
  <para style="q" vid="SNG 5:5">un maine hent hobn mire getrift,</para>
  <para style="q" vid="SNG 5:5">un maine finger flisike mire</para>
  <para style="q" vid="SNG 5:5">oif di hentlech fun rigl.<verse eid="SNG 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 5:6" />ich hob geefent main gelibtn,</para>
  <para style="q" vid="SNG 5:6">ober main gelibter iz farshvundn,</para>
  <para style="q" vid="SNG 5:6">avek – main zel iz oisgegangen – ven er hot geredt tsu mir –</para>
  <para style="q" vid="SNG 5:6">ich hob im gezucht, un hob im nisht gefunen,</para>
  <para style="q" vid="SNG 5:6">ich hob im gerufn, un er hot mir nisht geentfert.<verse eid="SNG 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 5:7" />hobn mich getrofn di vechter vos geyen arum in der shtot,</para>
  <para style="q" vid="SNG 5:7">hobn zei mich geshlogn, hobn zei mich farvundt;</para>
  <para style="q" vid="SNG 5:7">aropgenumen main mantl fun mir hobn di vechter fun di moiern.<verse eid="SNG 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 5:8" />ich bashver aich, techter fun Yerushalayim,</para>
  <para style="q" vid="SNG 5:8">az ir vet gefinen main gelibtn,</para>
  <para style="q" vid="SNG 5:8">vos ir zolt im zogn:</para>
  <para style="q" vid="SNG 5:8">az krank fun libshaft bin ich.<verse eid="SNG 5:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="SNG 5:9" />vos iz dain gelibter far a gelibter,</para>
  <para style="q" vid="SNG 5:9">du shenste fun froien?</para>
  <para style="q" vid="SNG 5:9">vos iz dain gelibter far a gelibter,</para>
  <para style="q" vid="SNG 5:9">vos du host azoi undz bashvorn?<verse eid="SNG 5:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="SNG 5:10" />main gelibter iz klor un geroitlt,</para>
  <para style="q" vid="SNG 5:10">di fon fun tsen toiznt.<verse eid="SNG 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 5:11" />zain kop iz fain gingold,</para>
  <para style="q" vid="SNG 5:11">zaine loken gekraizlt, shvarts vi der rob.<verse eid="SNG 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 5:12" />zaine oign vi toibn bai bechn fun vaser;</para>
  <para style="q" vid="SNG 5:12">gebodn in milch, aingezetst in fuln.<verse eid="SNG 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 5:13" />zaine bakn vi a beit b'somaim,</para>
  <para style="q" vid="SNG 5:13">vi turemlech gevirtsn;</para>
  <para style="q" vid="SNG 5:13">zaine lipn lilien</para>
  <para style="q" vid="SNG 5:13">vos trifn flisike mire.<verse eid="SNG 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 5:14" />di hent zaine gilderne valtsn mit goldshtein bazetst;</para>
  <para style="q" vid="SNG 5:14">zain laib a shtik elfnbein mit sapirn badekt.<verse eid="SNG 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 5:15" />zaine shenklen mirmlzailn gegruntfest</para>
  <para style="q" vid="SNG 5:15">oif shveln fun gingold;</para>
  <para style="q" vid="SNG 5:15">zain onblik vi der Levanon,</para>
  <para style="q" vid="SNG 5:15">oisderveilt vi di tsedern.<verse eid="SNG 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 5:16" />zain gumen iz ziskeit,</para>
  <para style="q" vid="SNG 5:16">un er in gantsn a glustikeit.</para>
  <para style="q" vid="SNG 5:16">dos iz main gelibter, un dos iz main chever,</para>
  <para style="q" vid="SNG 5:16">techter fun Yerushalayim.<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="SNG 6" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 6:1" />vuhin iz gegangen dain gelibter,</para>
  <para style="q" vid="SNG 6:1">du shenste fun froien?</para>
  <para style="q" vid="SNG 6:1">vuhin hot zich gekert dain gelibter,</para>
  <para style="q" vid="SNG 6:1">az mir zoln im zuchn mit dir?<verse eid="SNG 6:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="SNG 6:2" />main gelibter hot genidert tsu zain gortn</para>
  <para style="q" vid="SNG 6:2">tsu di beitn fun b'somaim,</para>
  <para style="q" vid="SNG 6:2">tsu vandern in di gertner</para>
  <para style="q" vid="SNG 6:2">un oifklaibn lilien.<verse eid="SNG 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 6:3" />ich bin main gelibtns,</para>
  <para style="q" vid="SNG 6:3">– un main gelibter iz main –</para>
  <para style="q" vid="SNG 6:3">der vos vandert tsvishn di lilien.<verse eid="SNG 6:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="SNG 6:4" />bist shein, main gelibte, vi Tirtsah,</para>
  <para style="q" vid="SNG 6:4">liblech vi Yerushalayim,</para>
  <para style="q" vid="SNG 6:4">forchtik vi machnus bafonte.<verse eid="SNG 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 6:5" />ker avek daine oign fun mir,</para>
  <para style="q" vid="SNG 6:5">vorem zei hobn mich baveltikt.</para>
  <para style="q" vid="SNG 6:5">daine hor iz vi a stade tsign</para>
  <para style="q" vid="SNG 6:5">vos lozn zich fun Gilad arop.<verse eid="SNG 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 6:6" />daine tsein vi a stade shof</para>
  <para style="q" vid="SNG 6:6">vos kumen aroif fun gevesh,</para>
  <para style="q" vid="SNG 6:6">vos tsvilingen zich ale,</para>
  <para style="q" vid="SNG 6:6">un nishto kein farvarferin tsvishn zei.<verse eid="SNG 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 6:7" />vi an oifshnit milgroim iz dain shleif,</para>
  <para style="q" vid="SNG 6:7">fun dain shleyer durch.<verse eid="SNG 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 6:8" />zechtsik di mlkut,</para>
  <para style="q" vid="SNG 6:8">un achtsik di kepsvaiber,</para>
  <para style="q" vid="SNG 6:8">un yungfroin on tsol.<verse eid="SNG 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 6:9" />eine main toib, main umshuldike;</para>
  <para style="q" vid="SNG 6:9">eine iz zi bai ir muter,</para>
  <para style="q" vid="SNG 6:9">oisderveilt iz zi bai ir vos hot ir geborn.</para>
  <para style="q" vid="SNG 6:9">techter hobn zi gezen un zi geloibt,</para>
  <para style="q" vid="SNG 6:9">mlkut un kepsvaiber – un zi gerimt:<verse eid="SNG 6:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="SNG 6:10" />ver iz di vos kukt arois vi der frimorgn,</para>
  <para style="q" vid="SNG 6:10">shein vi di Livnah, loiter vi di zun,</para>
  <para style="q" vid="SNG 6:10">forchtik vi machnus bafonte?<verse eid="SNG 6:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="SNG 6:11" />tsu dem nusgortn hob ich genidert,</para>
  <para style="q" vid="SNG 6:11">tsu bakukn di shprotsn fun tal,</para>
  <para style="q" vid="SNG 6:11">tsu zen oib geblit hot der vainshtok,</para>
  <para style="q" vid="SNG 6:11">oib getsvit hobn di milgroimen.<verse eid="SNG 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 6:12" />nisht visendik hot main zel mich gebracht</para>
  <para style="q" vid="SNG 6:12">tsu di raitvegn fun main firshtlechn folk.<verse eid="SNG 6:12" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="SNG 7" />
  <para style="q">
    <verse number="1" style="v" pubnumber="6:13" sid="SNG 7:1" /> ker tsurik, ker tsurik, Shulamite,</para>
  <para style="q" vid="SNG 7:1">ker tsurik, ker tsurik, mir zoln dich onkukn.</para>
  <para style="b" vid="SNG 7:1" />
  <para style="q" vid="SNG 7:1">vos vet ir zen in Shulamite?</para>
  <para style="q" vid="SNG 7:1">azoi vi a tants in tsvei reyen.<verse eid="SNG 7:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" pubnumber="7.1" sid="SNG 7:2" /> vi shein daine trit in sandaln,</para>
  <para style="q" vid="SNG 7:2">du firshtleche tochter!</para>
  <para style="q" vid="SNG 7:2">daine runde dichn vi tsirung gemacht</para>
  <para style="q" vid="SNG 7:2">fun di hent fun a kintsler.<verse eid="SNG 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" pubnumber="7.2" sid="SNG 7:3" /> dain nopl a becher a runder;</para>
  <para style="q" vid="SNG 7:3">es felt nisht der mishvain.</para>
  <para style="q" vid="SNG 7:3">dain boich a hoifn veits</para>
  <para style="q" vid="SNG 7:3">mit lilien bazoimt.<verse eid="SNG 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" pubnumber="7:3" sid="SNG 7:4" /> daine tsvei brist vi tsvei hirshlech,</para>
  <para style="q" vid="SNG 7:4">tsvilings fun a hirshin.<verse eid="SNG 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" pubnumber="7:4" sid="SNG 7:5" /> dain haldz vi a turem fun elfnbein;</para>
  <para style="q" vid="SNG 7:5">– daine oign – di taichn in Cheshbon</para>
  <para style="q" vid="SNG 7:5">baim toier fun bt-rabem;</para>
  <para style="q" vid="SNG 7:5">dain noz vi der turem fun Levanon</para>
  <para style="q" vid="SNG 7:5">vos kukt tsu Damesek.<verse eid="SNG 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" pubnumber="7:5" sid="SNG 7:6" /> dain kop oif dir vi der Karmel,</para>
  <para style="q" vid="SNG 7:6">un di loken fun dain kop azoi vi purpl;</para>
  <para style="q" vid="SNG 7:6">a melech iz in di flechtn farknipt.<verse eid="SNG 7:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" pubnumber="7:6" sid="SNG 7:7" /> vi shein bistu un vi zis bistu,</para>
  <para style="q" vid="SNG 7:7">gelibte, in tenugim!<verse eid="SNG 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" pubnumber="7:7" sid="SNG 7:8" /> der doziker vuks dainer iz geglichn tsu a teitlboim,</para>
  <para style="q" vid="SNG 7:8">un di brist daine tsu henglech troibn.<verse eid="SNG 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" pubnumber="7:8" sid="SNG 7:9" /> ich hob gezogt: ich vel aroifgein tsum teitlboim,</para>
  <para style="q" vid="SNG 7:9">un vel onnemen zaine tsvaign;</para>
  <para style="q" vid="SNG 7:9">un daine brist zoln zain azoi vi henglech fun vainshtok,</para>
  <para style="q" vid="SNG 7:9">un der reyech fun dain ponem vi Ofel;<verse eid="SNG 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" pubnumber="7:9" sid="SNG 7:10" /> un dain gumen vi vain guter</para>
  <para style="q" vid="SNG 7:10">vos geit glatik arop main gelibtn,</para>
  <para style="q" vid="SNG 7:10">vos macht redn di lipn fun shlofike.<verse eid="SNG 7:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" pubnumber="7:10" sid="SNG 7:11" /> ich bin main gelibtns,</para>
  <para style="q" vid="SNG 7:11">un tsu mir iz zain gelust.<verse eid="SNG 7:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" pubnumber="7:11" sid="SNG 7:12" /> kum, gelibter main,</para>
  <para style="q" vid="SNG 7:12">lomir aroisgein in feld,</para>
  <para style="q" vid="SNG 7:12">lomir nechtikn tsvishn di tsiperblumen.<verse eid="SNG 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" pubnumber="7:12" sid="SNG 7:13" />lomir zich federn tsu di vaingertner,</para>
  <para style="q" vid="SNG 7:13">lomir zen oib geblit hot der vainshtok,</para>
  <para style="q" vid="SNG 7:13">oib geefent hobn zich di kveitn,</para>
  <para style="q" vid="SNG 7:13">oib getsvit hobn di milgroimen;</para>
  <para style="q" vid="SNG 7:13">dortn vel ich gebn main libshaft tsu dir.<verse eid="SNG 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" pubnumber="7:13" sid="SNG 7:14" /> di libepelech gibn arois a reyech,</para>
  <para style="q" vid="SNG 7:14">un far undzere tirn zainen alerlei taiere frucht,</para>
  <para style="q" vid="SNG 7:14">naie un alte,</para>
  <para style="q" vid="SNG 7:14">vos ich hob bahaltn far dir, main gelibter.<verse eid="SNG 7:14" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="SNG 8" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 8:1" />halevay bistu vi a bruder mainer</para>
  <para style="q" vid="SNG 8:1">vos hot di brist fun main muter gezoign!</para>
  <para style="q" vid="SNG 8:1">ich volt dich getrofn in gas, dich gekusht,</para>
  <para style="q" vid="SNG 8:1">un me volt mich nisht faracht.<verse eid="SNG 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 8:2" />ich volt dich gefirt,</para>
  <para style="q" vid="SNG 8:2">dich gebracht in hoiz fun main muter vos lernt mich;</para>
  <para style="q" vid="SNG 8:2">dir trinken gegebn fun vain gekochtn,</para>
  <para style="q" vid="SNG 8:2">fun zaft fun main milgroim.<verse eid="SNG 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 8:3" />zain linke hant unter main kop,</para>
  <para style="q" vid="SNG 8:3">un zain rechte zol mich arumnemen.<verse eid="SNG 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 8:4" />ich bashver aich, techter fun Yerushalayim,</para>
  <para style="q" vid="SNG 8:4">ir zolt nisht veken un nisht oifvekn di libshaft,</para>
  <para style="q" vid="SNG 8:4">biz zi vet bageren.<verse eid="SNG 8:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="SNG 8:5" />ver iz di vos geit oif funem midber,</para>
  <para style="q" vid="SNG 8:5">zich tuliendik tsu ir gelibtn?</para>
  <para style="b" vid="SNG 8:5" />
  <para style="q" vid="SNG 8:5">untern eplboim hob ich dich oifgevekt;</para>
  <para style="q" vid="SNG 8:5">dortn hot dain muter geveitokt mit dir,</para>
  <para style="q" vid="SNG 8:5">dort hot geveitokt di vos hot dich geborn.<verse eid="SNG 8:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="SNG 8:6" />tu mich aroif vi a zigl oif dain hartsn,</para>
  <para style="q" vid="SNG 8:6">vi a zigl oif dain orem,</para>
  <para style="q" vid="SNG 8:6">vorem shtark vi der toit iz di libshaft,</para>
  <para style="q" vid="SNG 8:6">hart vi der Sheol di eiferzucht;</para>
  <para style="q" vid="SNG 8:6">ire flamen zainen flamen faier,</para>
  <para style="q" vid="SNG 8:6">a flaker fun G-t.<verse eid="SNG 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 8:7" />groise vasern kenen nisht farleshn di libshaft,</para>
  <para style="q" vid="SNG 8:7">un taichn veln zi nisht avekfleitsn.</para>
  <para style="q" vid="SNG 8:7">az a mentsh zol gebn far libshaft</para>
  <para style="q" vid="SNG 8:7">dem gantsn farmeg fun zain hoiz,</para>
  <para style="q" vid="SNG 8:7">farachten im volt men faracht.<verse eid="SNG 8:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="SNG 8:8" />a kleine shvester hobn mir,</para>
  <para style="q" vid="SNG 8:8">un zi hot noch kein brist nisht;</para>
  <para style="q" vid="SNG 8:8">vos zoln mir ton mit undzer shvester</para>
  <para style="q" vid="SNG 8:8">in dem tog vos me vet ir redn?<verse eid="SNG 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 8:9" />oib zi iz a moier,</para>
  <para style="q" vid="SNG 8:9">veln mir boien oif ir a zilberne moierkroin;</para>
  <para style="q" vid="SNG 8:9">un oib zi iz a tir,</para>
  <para style="q" vid="SNG 8:9">veln mir zi farshparn mit tsederbreter.<verse eid="SNG 8:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="SNG 8:10" />ich bin a moier, un maine brist vi di turems;</para>
  <para style="q" vid="SNG 8:10">dentsmol bin ich geven in zaine oign</para>
  <para style="q" vid="SNG 8:10">azoi vi a kval fun glik.<verse eid="SNG 8:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="SNG 8:11" />a vaingorten hot Shlomo gehat in Baal-Hamon,</para>
  <para style="q" vid="SNG 8:11">hot er gegebn dem vaingorten tsu hiter;</para>
  <para style="q" vid="SNG 8:11">itlecher flegt brengen far zain frucht toiznt zilbershtik.<verse eid="SNG 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 8:12" />main eigener vaingorten iz bai mir.</para>
  <para style="q" vid="SNG 8:12">di toiznt zainen far dir, Shlomo,</para>
  <para style="q" vid="SNG 8:12">ober tsvei hundert far di vos hitn zain frucht.<verse eid="SNG 8:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="SNG 8:13" />du vos zitsst in di gertner,</para>
  <para style="q" vid="SNG 8:13">di chaverim horchn oif dain kol,</para>
  <para style="q" vid="SNG 8:13">loz mich im hern.<verse eid="SNG 8:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="SNG 8:14" />antloif, gelibter main,</para>
  <para style="q" vid="SNG 8:14">un zai geglichn tsu a hirsh,</para>
  <para style="q" vid="SNG 8:14">oder tsu a hind a yungn, oif di b'somaim-geberg.<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>