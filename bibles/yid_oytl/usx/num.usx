<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">Bamidbar</para>
  <para style="toc3">Bamidbar</para>
  <para style="toc2">Bamidbar</para>
  <para style="toc1">Bamidbar</para>
  <para style="mt1">Bamidbar</para>
  <chapter number="1" style="c" pubnumber="א" sid="NUM 1" />
  <para style="s1">Bamidbar</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1" />un Hashem hot geredt tsu Mosheen in midber Sinai, in ohel-moed, in ershtn tog fun tsveitn choidesh, in tsveitn yor noch zeyer aroisgein fun land Mitsrayim, azoi tsu zogn:<verse eid="NUM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 1:2" />nemt oif dem misper fun der gantser eide fun di kinder fun Yisroel loit zeyere mishpoches, loit zeyere foterhaizer, noch der tsol fun nemen, yetveder mansparshoin, loit zeyere kep. <verse eid="NUM 1:2" /><verse number="3" style="v" sid="NUM 1:3" />fun tsvantsik yor alt un hecher, itlechn in Yisroel vos geit arois in cheil, zolt ir zei tseiln loit zeyere machnus, du un Aharon.<verse eid="NUM 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 1:4" />un mit aich zoln zain tsu man, tsu man fun a sheyvet, a man vos iz der hoipt fun zain foterhoiz. <verse eid="NUM 1:4" /><verse number="5" style="v" sid="NUM 1:5" />un dos zainen di nemen fun di mener vos zoln shtein mit aich: fun Reuven, Elitsur der zun fun Shedeurn. <verse eid="NUM 1:5" /><verse number="6" style="v" sid="NUM 1:6" />fun Shimeon, Shelumiel der zun fun Tsurishaddaien. <verse eid="NUM 1:6" /><verse number="7" style="v" sid="NUM 1:7" />fun Yehudah, Nachshon der zun fun Amminadavn. <verse eid="NUM 1:7" /><verse number="8" style="v" sid="NUM 1:8" />fun Yissachar, Netanel der zun fun Tsuarn.<verse eid="NUM 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 1:9" />fun Zevulun, Eliav der zun fun Chelonen. <verse eid="NUM 1:9" /><verse number="10" style="v" sid="NUM 1:10" />fun di kinder fun Yosef: fun Efrayim, Elishama der zun fun Ammihudn; fun Menasheh, Gamliel der zun fun Pedahtsurn. <verse eid="NUM 1:10" /><verse number="11" style="v" sid="NUM 1:11" />fun Binyamin, Avidan der zun fun Gideonin. <verse eid="NUM 1:11" /><verse number="12" style="v" sid="NUM 1:12" />fun Dan, Achiezer der zun fun Ammishaddain. <verse eid="NUM 1:12" /><verse number="13" style="v" sid="NUM 1:13" />fun Asher, Pagiel der zun fun Ochranen. <verse eid="NUM 1:13" /><verse number="14" style="v" sid="NUM 1:14" />fun Gad, ElyaSaf der zun fun Deueln. <verse eid="NUM 1:14" /><verse number="15" style="v" sid="NUM 1:15" />fun Naftali, Achira der zun fun Enanen.<verse eid="NUM 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 1:16" />di dozike zainen geven gerufene fun der eide, firshtn fun zeyere fotershtamen; di hoiptlait fun di toizntn fun Yisroel zainen zei geven. <verse eid="NUM 1:16" /><verse number="17" style="v" sid="NUM 1:17" />un Moshe un Aharon hobn genumen di dozike mener vos zainen ongerufn mit di nemen, <verse eid="NUM 1:17" /><verse number="18" style="v" sid="NUM 1:18" />un zei hobn aingezamlt di gantse eide in ershtn tog fun tsveitn choidesh; un zei hobn ongegebn zeyer geburt loit zeyere mishpoches, loit zeyere foterhaizer, noch der tsol fun nemen, fun tsvantsik yor alt un hecher, loit zeyere kep. <verse eid="NUM 1:18" /><verse number="19" style="v" sid="NUM 1:19" />azoi vi Hashem hot bafoiln Mosheen, hot er zei getseilt in midber Sinai.<verse eid="NUM 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 1:20" />un di kinder fun Reuven, Yisroels bechor, zeyere geburtn loit zeyere mishpoches, loit zeyere foterhaizer, noch der tsol fun nemen, loit zeyere kep, yetveder mansparshoin fun tsvantsik yor alt un hecher, itlecher vos geit arois in cheil – <verse eid="NUM 1:20" /><verse number="21" style="v" sid="NUM 1:21" />zeyere getseilte, fun sheyvet Reuven, zainen geven zeks un fertsik toiznt un finf hundert.<verse eid="NUM 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 1:22" />fun di kinder fun Shimeon, zeyere geburtn loit zeyere mishpoches, loit zeyere foterhaizer, zaine getseilte noch der tsol fun nemen, loit zeyere kep, yetveder mansparshoin fun tsvantsik yor alt un hecher, itlecher vos geit arois in cheil – <verse eid="NUM 1:22" /><verse number="23" style="v" sid="NUM 1:23" />zeyere getseilte, fun sheyvet Shimeon, nain un fuftsik toiznt un drai hundert.<verse eid="NUM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 1:24" />fun di kinder fun Gad, zeyere geburtn loit zeyere mishpoches, loit zeyere foterhaizer, noch der tsol fun nemen, fun tsvantsik yor alt un hecher, itlecher vos geit arois in cheil – <verse eid="NUM 1:24" /><verse number="25" style="v" sid="NUM 1:25" />zeyere getseilte, fun sheyvet Gad, finf un fertsik toiznt un zeks hundert un fuftsik.<verse eid="NUM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 1:26" />fun di kinder fun Yehudah, zeyere geburtn loit zeyere mishpoches, loit zeyere foterhaizer, noch der tsol fun nemen, fun tsvantsik yor alt un hecher, itlecher vos geit arois in cheil – <verse eid="NUM 1:26" /><verse number="27" style="v" sid="NUM 1:27" />zeyere getseilte, fun sheyvet Yehudah, fir un zibetsik toiznt un zeks hundert.<verse eid="NUM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 1:28" />fun di kinder fun Yissachar, zeyere geburtn loit zeyere mishpoches, loit zeyere foterhaizer, noch der tsol fun nemen, fun tsvantsik yor alt un hecher, itlecher vos geit arois in cheil – <verse eid="NUM 1:28" /><verse number="29" style="v" sid="NUM 1:29" />zeyere getseilte, fun sheyvet Yissachar, fir un fuftsik toiznt un fir hundert.<verse eid="NUM 1:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 1:30" />fun di kinder fun Zevulun, zeyere geburtn loit zeyere mishpoches, loit zeyere foterhaizer, noch der tsol fun nemen, fun tsvantsik yor alt un hecher, itlecher vos geit arois in cheil – <verse eid="NUM 1:30" /><verse number="31" style="v" sid="NUM 1:31" />zeyere getseilte, fun sheyvet Zevulun, zibn un fuftsik toiznt un fir hundert.<verse eid="NUM 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 1:32" />fun di kinder fun Yosef: fun di kinder fun Efrayim, zeyere geburtn loit zeyere mishpoches, loit zeyere foterhaizer, noch der tsol fun nemen, fun tsvantsik yor alt un hecher, itlecher vos geit arois in cheil – <verse eid="NUM 1:32" /><verse number="33" style="v" sid="NUM 1:33" />zeyere getseilte, fun sheyvet Efrayim, fertsik toiznt un finf hundert.<verse eid="NUM 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 1:34" />fun di kinder fun Menasheh, zeyere geburtn loit zeyere mishpoches, loit zeyere foterhaizer, noch der tsol fun nemen, fun tsvantsik yor alt un hecher, itlecher vos geit arois in cheil – <verse eid="NUM 1:34" /><verse number="35" style="v" sid="NUM 1:35" />zeyere getseilte, fun sheyvet Menasheh, tsvei un draisik toiznt un tsvei hundert.<verse eid="NUM 1:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 1:36" />fun di kinder fun Binyamin, zeyere geburtn loit zeyere mishpoches, loit zeyere foterhaizer, noch der tsol fun nemen, fun tsvantsik yor alt un hecher, itlecher vos geit arois in cheil – <verse eid="NUM 1:36" /><verse number="37" style="v" sid="NUM 1:37" />zeyere getseilte, fun sheyvet Binyamin, finf un draisik toiznt un fir hundert.<verse eid="NUM 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 1:38" />fun di kinder fun Dan, zeyere geburtn loit zeyere mishpoches, loit zeyere foterhaizer, noch der tsol fun nemen, fun tsvantsik yor alt un hecher, itlecher vos geit arois in cheil – <verse eid="NUM 1:38" /><verse number="39" style="v" sid="NUM 1:39" />zeyere getseilte, fun sheyvet Dan, tsvei un zechtsik toiznt un zibn hundert.<verse eid="NUM 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 1:40" />fun di kinder fun Asher, zeyere geburtn loit zeyere mishpoches, loit zeyere foterhaizer, noch der tsol fun nemen, fun tsvantsik yor alt un hecher, itlecher vos geit arois in cheil – <verse eid="NUM 1:40" /><verse number="41" style="v" sid="NUM 1:41" />zeyere getseilte, fun sheyvet Asher, ein un fertsik toiznt un finf hundert.<verse eid="NUM 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 1:42" />di kinder fun Naftali, zeyere geburtn loit zeyere mishpoches, loit zeyere foterhaizer, noch der tsol fun nemen, fun tsvantsik yor alt un hecher, itlecher vos geit arois in cheil – <verse eid="NUM 1:42" /><verse number="43" style="v" sid="NUM 1:43" />zeyere getseilte, fun sheyvet Naftali, drai un fuftsik toiznt un fir hundert.<verse eid="NUM 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 1:44" />dos zainen di getseilte vos Moshe un Aharon hobn getseilt, un di firshtn fun Yisroel; tsvelf man, tsu ein man fun zain foterhoiz zainen zei geven. <verse eid="NUM 1:44" /><verse number="45" style="v" sid="NUM 1:45" />un ale getseilte fun di kinder fun Yisroel loit zeyere foterhaizer, fun tsvantsik yor alt un hecher, itlecher vos geit arois in cheil – in Yisroel, zainen geven <verse eid="NUM 1:45" /><verse number="46" style="v" sid="NUM 1:46" />ale getseilte zainen geven zeks mol hundert toiznt un drai toiznt un finf hundert un fuftsik. <verse eid="NUM 1:46" /><verse number="47" style="v" sid="NUM 1:47" />ober di Leviim loit zeyer fotershtam zainen nisht getseilt gevorn tsvishn zei.<verse eid="NUM 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 1:48" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 1:48" /><verse number="49" style="v" sid="NUM 1:49" />dem sheyvet Levi ober zolstu nisht tseiln, un zeyer tsol zolstu nisht oifnemen tsvishn di kinder fun Yisroel. <verse eid="NUM 1:49" /><verse number="50" style="v" sid="NUM 1:50" />nor du shtel di Leviim iber dem mishkn fun tseignim, un iber ale zaine keilim, un iber alts vos gehert tsu im; zei zoln trogn dem mishkn, un ale zaine keilim, un zei zoln im badinen; un rund arum dem mishkn zoln zei lagern. <verse eid="NUM 1:50" /><verse number="51" style="v" sid="NUM 1:51" />un baim tsien fun mishkn zoln im di Leviim aropnemen, un baim ruen fun mishkn zoln im di Leviim oifshteln, un der fremder vos genent zol geteit vern. <verse eid="NUM 1:51" /><verse number="52" style="v" sid="NUM 1:52" />un di kinder fun Yisroel zoln lagern itlecher in zain lager, un itlecher bai zain fon, loit zeyere machnus. <verse eid="NUM 1:52" /><verse number="53" style="v" sid="NUM 1:53" />un di Leviim zoln lagern rund arum dem mishkn fun tseignim, kedei es zol nisht zain a tsorn oif der eide fun di kinder fun Yisroel. un di Leviim zoln hitn di hitung fun dem mishkn fun eides.<verse eid="NUM 1:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54" />un di kinder fun Yisroel hobn azoi geton; azoi vi alts vos Hashem hot bafoiln Mosheen, azoi hobn zei geton.<verse eid="NUM 1:54" /></para>
  <chapter eid="NUM 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="NUM 2" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1" />un Hashem hot geredt tsu Mosheen un tsu Aharonen, azoi tsu zogn:<verse eid="NUM 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 2:2" />itlecher bai zain fon, loit di tseichns fun zeyere foterhaizer, zoln lagern di kinder fun Yisroel; akegniber rund arum dem ohel-moed zoln zei lagern. <verse eid="NUM 2:2" /><verse number="3" style="v" sid="NUM 2:3" />un di vos lagern in mizrech tsu zunoifgang zoln zain: di fon fun dem lager fun Yehudah loit zeyere machnus, mit dem firsht fun di kinder fun Yehudah, Nachshon dem zun fun Amminadavn, <verse eid="NUM 2:3" /><verse number="4" style="v" sid="NUM 2:4" />un zain cheil – zeyere getseilte, fir un zibetsik toiznt un zeks hundert. <verse eid="NUM 2:4" /><verse number="5" style="v" sid="NUM 2:5" />un di vos lagern lebn im: sheyvet Yissachar, mit dem firsht fun di kinder fun Yissachar, Netanel dem zun fun Tsuarn, <verse eid="NUM 2:5" /><verse number="6" style="v" sid="NUM 2:6" />un zain cheil – zaine getseilte, fir un fuftsik toiznt un fir hundert; <verse eid="NUM 2:6" /><verse number="7" style="v" sid="NUM 2:7" />sheyvet Zevulun, mit dem firsht fun di kinder fun Zevulun, Eliav dem zun fun Chelonen, <verse eid="NUM 2:7" /><verse number="8" style="v" sid="NUM 2:8" />un zain cheil – zaine getseilte, zibn un fuftsik toiznt un fir hundert. <verse eid="NUM 2:8" /><verse number="9" style="v" sid="NUM 2:9" />ale getseilte fun dem lager fun Yehudah: hundert un achtsik toiznt un zeks toiznt un fir hundert, loit zeyere machnus. zei zoln tsien tsuersht.<verse eid="NUM 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 2:10" />di fon fun dem lager fun Reuven zol zain tsu dorem, loit zeyere machnus, mit dem firsht fun di kinder fun Reuven, Elitsur dem zun fun Shedeurn, <verse eid="NUM 2:10" /><verse number="11" style="v" sid="NUM 2:11" />un zain cheil – zaine getseilte, zeks un fertsik toiznt un finf hundert. <verse eid="NUM 2:11" /><verse number="12" style="v" sid="NUM 2:12" />un di vos lagern lebn im: sheyvet Shimeon, mit dem firsht fun di kinder fun Shimeon, Shelumiel dem zun fun Tsurishaddaien, <verse eid="NUM 2:12" /><verse number="13" style="v" sid="NUM 2:13" />un zain cheil – zeyere getseilte, nain un fuftsik toiznt un drai hundert; <verse eid="NUM 2:13" /><verse number="14" style="v" sid="NUM 2:14" />un sheyvet Gad, mit dem firsht fun di kinder fun Gad, ElyaSaf dem zun fun Reueln, <verse eid="NUM 2:14" /><verse number="15" style="v" sid="NUM 2:15" />un zain cheil – zeyere getseilte, finf un fertsik toiznt un zeks hundert un fuftsik.<verse eid="NUM 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 2:16" />ale getseilte fun dem lager fun Reuven, hundert toiznt un ein un fuftsik toiznt un fir hundert un fuftsik, loit zeyere machnus. un zei zoln tsien di tsveite.<verse eid="NUM 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 2:17" />un der ohel-moed, der lager fun di Leviim, zol tsien in mitn fun di lagern; azoi vi zei ruen, azoi zoln zei tsien; itlecher oif zain ort loit zeyere fones.<verse eid="NUM 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 2:18" />di fon fun dem lager fun Efrayim loit zeyer machnus zol zain tsu mayrev, mit dem firsht fun di kinder fun Efrayim, Elishama dem zun fun Ammihudn, <verse eid="NUM 2:18" /><verse number="19" style="v" sid="NUM 2:19" />un zain cheil – zeyere getseilte, fertsik toiznt un finf hundert. <verse eid="NUM 2:19" /><verse number="20" style="v" sid="NUM 2:20" />un lebn im sheyvet Menasheh, mit dem firsht fun di kinder fun Menasheh, Gamliel dem zun fun Pedahtsurn, <verse eid="NUM 2:20" /><verse number="21" style="v" sid="NUM 2:21" />un zain cheil – zeyere getseilte, tsvei un draisik toiznt un tsvei hundert; <verse eid="NUM 2:21" /><verse number="22" style="v" sid="NUM 2:22" />un sheyvet Binyamin, mit dem firsht fun di kinder fun Binyamin, Avidan dem zun fun Gideonin, <verse eid="NUM 2:22" /><verse number="23" style="v" sid="NUM 2:23" />un zain cheil – zeyere getseilte, finf un draisik toiznt un fir hundert. <verse eid="NUM 2:23" /><verse number="24" style="v" sid="NUM 2:24" />ale getseilte fun dem lager fun Efrayim, hundert toiznt un acht toiznt un hundert, loit zeyere machnus. un zei zoln tsien di drite.<verse eid="NUM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 2:25" />di fon fun dem lager fun Dan zol zain tsu tsofn, loit zeyere machnus, mit dem firsht fun di kinder fun Dan, Achiezer dem zun fun Ammishaddain, <verse eid="NUM 2:25" /><verse number="26" style="v" sid="NUM 2:26" />un zain cheil – zeyere getseilte, tsvei un zechtsik toiznt un zibn hundert. <verse eid="NUM 2:26" /><verse number="27" style="v" sid="NUM 2:27" />un di vos lagern lebn im: sheyvet Asher, mit dem firsht fun di kinder fun Asher, Pagiel dem zun fun Ochranen, <verse eid="NUM 2:27" /><verse number="28" style="v" sid="NUM 2:28" />un zain cheil – zeyere getseilte, ein un fertsik toiznt un finf hundert; <verse eid="NUM 2:28" /><verse number="29" style="v" sid="NUM 2:29" />un sheyvet Naftali, mit dem firsht fun di kinder fun Naftali, Achira dem zun fun Enanen, <verse eid="NUM 2:29" /><verse number="30" style="v" sid="NUM 2:30" />un zain cheil – zeyere getseilte, drai un fuftsik toiznt un fir hundert. <verse eid="NUM 2:30" /><verse number="31" style="v" sid="NUM 2:31" />ale getseilte fun dem lager fun Dan, hundert toiznt un zibn un fuftsik toiznt un zeks hundert. zei zoln tsien tsuletst loit zeyere fones.<verse eid="NUM 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 2:32" />dos zainen di getseilte fun di kinder fun Yisroel, loit zeyere foterhaizer; ale getseilte fun di lagern, loit zeyere machnus, zainen geven zeks mol hundert toiznt un drai toiznt un finf hundert un fuftsik. <verse eid="NUM 2:32" /><verse number="33" style="v" sid="NUM 2:33" />ober di Leviim zainen nisht getseilt gevorn tsvishn di kinder fun Yisroel; azoi vi Hashem hot bafoiln Mosheen.<verse eid="NUM 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 2:34" />un di kinder fun Yisroel hobn geton azoi vi alts vos Hashem hot bafoiln Mosheen; azoi hobn zei gerut loit zeyere fones, un azoi hobn zei getsoign, itlecher loit zaine mishpoches, bai zain foterhoiz.<verse eid="NUM 2:34" /></para>
  <chapter eid="NUM 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="NUM 3" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1" />un dos zainen di geburtn fun Aharonen un fun Mosheen, ven Hashem hot geredt mit Mosheen oifn barg Sinai. <verse eid="NUM 3:1" /><verse number="2" style="v" sid="NUM 3:2" />un dos zainen di nemen fun Aharons zin: der bechor Nadav, un Avihu, Elazar, un Itamar. <verse eid="NUM 3:2" /><verse number="3" style="v" sid="NUM 3:3" />dos zainen di nemen fun Aharons zin, di gezalbte koyanim vos me hot derfilt zeyer hant tsu ton di kehune. <verse eid="NUM 3:3" /><verse number="4" style="v" sid="NUM 3:4" />un Nadav un Avihu zainen geshtorbn far Hashem ven zei hobn gebracht fremd faier far Hashem, in midber Sinai, un kein kinder hobn zei nisht gehat; un Elazar un Itamar zainen gevorn koyanim lebn zeyer foter Aharonen.<verse eid="NUM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 3:5" /><verse number="6" style="v" sid="NUM 3:6" />mach genenen dem sheyvet Levi, un zolst im shteln far Aharon dem koyen, un zei zoln im badinen. <verse eid="NUM 3:6" /><verse number="7" style="v" sid="NUM 3:7" />un zei zoln hitn zain hitung un di hitung fun der gantser eide faran ohel-moed, tsu dinen dem dinst fun mishkn.<verse eid="NUM 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 3:8" />un zei zoln hitn ale keilim fun ohel-moed, un di hitung fun di kinder fun Yisroel, tsu dinen dem dinst fun mishkn. <verse eid="NUM 3:8" /><verse number="9" style="v" sid="NUM 3:9" />zolst gebn di Leviim tsu Aharonen un tsu zaine zin; opgegebn zainen zei opgegebn tsu im fun di kinder fun Yisroel. <verse eid="NUM 3:9" /><verse number="10" style="v" sid="NUM 3:10" />un Aharonen un zaine zin zolstu bafeln, zei zoln hitn zeyer kehune, un der fremder vos genent zol geteit vern.<verse eid="NUM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 3:11" /><verse number="12" style="v" sid="NUM 3:12" />un ich, ze, hob genumen di Leviim fun tsvishn di kinder fun Yisroel anshtot itlechn bechor vos efent dem tracht tsvishn di kinder fun Yisroel; un di Leviim zoln gehern tsu mir. <verse eid="NUM 3:12" /><verse number="13" style="v" sid="NUM 3:13" />vorem tsu mir gehert itlecher bechor; in dem tog vos ich hob dershlogn itlechn bechor in land Mitsrayim hob ich geheilikt tsu mir itlechn bechor in Yisroel, fun a mentshn biz a beheime. tsu mir zoln zei gehern: ich bin Hashem.<verse eid="NUM 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14" />un Hashem hot geredt tsu Mosheen in midber Sinai, azoi tsu zogn:<verse eid="NUM 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 3:15" />tseil di kinder fun Levi loit zeyere foterhaizer, loit zeyere mishpoches; itlechn mansparshoin fun a choidesh alt un hecher zolstu zei tseiln.<verse eid="NUM 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 3:16" />un Moshe hot zei getseilt loit dem moil fun Hashem, azoi vi er iz bafoiln gevorn. <verse eid="NUM 3:16" /><verse number="17" style="v" sid="NUM 3:17" />un dos zainen geven di zin fun Levin mit zeyere nemen: Gershon, un Kohat, un Merari. <verse eid="NUM 3:17" /><verse number="18" style="v" sid="NUM 3:18" />un dos zainen di nemen fun di zin fun Gershonen loit zeyere mishpoches: Livni, un Shimei.<verse eid="NUM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 3:19" />un di zin fun Kohatn loit zeyere mishpoches: Amram, un Yitshar, Chevron, un Uziel. <verse eid="NUM 3:19" /><verse number="20" style="v" sid="NUM 3:20" />un di zin fun Merarien loit zeyere mishpoches: Machli, un Mushi. dos zainen di mishpoches fun Levi loit zeyere foterhaizer.<verse eid="NUM 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 3:21" />fun Gershonen di mishpoche fun di Livnim, un di mishpoche fun di Shamaim; dos zainen di mishpoches fun di Gershonim. <verse eid="NUM 3:21" /><verse number="22" style="v" sid="NUM 3:22" />zeyere getseilte loit der tsol fun ale mansparshoinen fun a choidesh alt un hecher – zeyere getseilte zainen geven zibn toiznt un finf hundert. <verse eid="NUM 3:22" /><verse number="23" style="v" sid="NUM 3:23" />di mishpoches fun di Gershonim hobn gelagert hinter dem mishkn tsu mayrev. <verse eid="NUM 3:23" /><verse number="24" style="v" sid="NUM 3:24" />un der firsht fun dem foterhoiz fun di Gershonim iz geven ElyaSaf der zun fun Laeln. <verse eid="NUM 3:24" /><verse number="25" style="v" sid="NUM 3:25" />un di hitung fun di kinder fun Gershon baim ohel-moed iz geven der mishkn, un dos getselt, zain tsudek, un der tirforhang fun ohel-moed, <verse eid="NUM 3:25" /><verse number="26" style="v" sid="NUM 3:26" />un di arumhangen fun dem hoif, un der tirforhang fun dem hoif vos rund arum dem mishkn un dem mizbeyech, un zaine shtrik, mit ale zaine dinst.<verse eid="NUM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 3:27" />un fun Kohatn di mishpoche fun di Amramim, un di mishpoche fun di Yitsharim, un di mishpoche fun di Chevronim, un di mishpoche fun di Uzielim; dos zainen di mishpoches fun di Kehatim: <verse eid="NUM 3:27" /><verse number="28" style="v" sid="NUM 3:28" />loit der tsol fun ale mansparshoinen fun a choidesh alt un hecher, acht toiznt un zeks hundert vos hitn di hitung fun mikdash. <verse eid="NUM 3:28" /><verse number="29" style="v" sid="NUM 3:29" />di mishpoches fun di kinder fun Kohat hobn gelagert bain zait fun mishkn, tsu dorem. <verse eid="NUM 3:29" /><verse number="30" style="v" sid="NUM 3:30" />un der firsht fun dem foterhoiz fun di mishpoches fun di Kehatim iz geven ElitSafan der zun fun Uzieln.<verse eid="NUM 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 3:31" />un zeyer hitung iz geven der orn, un der tish, un di menoyre, un di mizbeyches, un di heilike keilim vos me dint mit zei, un der forhang, un ale zaine dinst.<verse eid="NUM 3:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 3:32" />un der firsht iber di firshtn fun di Leviim iz geven Elazar der zun fun Aharon dem koyen, der oifzeer iber di vos hitn di hitung fun dem heiliktum.<verse eid="NUM 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 3:33" />fun Merarien di mishpoche fun di Machlim, un di mishpoche fun di Mushim; dos zainen di mishpoches fun Merari. <verse eid="NUM 3:33" /><verse number="34" style="v" sid="NUM 3:34" />un zeyere getseilte loit der tsol fun ale mansparshoinen fun a choidesh alt un hecher zainen geven zeks toiznt un tsvei hundert. <verse eid="NUM 3:34" /><verse number="35" style="v" sid="NUM 3:35" />un der firsht fun dem foterhoiz fun di mishpoches fun Merari iz geven Tsuriel der zun fun Avihayiln. zei hobn gelagert bein zait fun mishkn tsu tsofn. <verse eid="NUM 3:35" /><verse number="36" style="v" sid="NUM 3:36" />un di geshtelte hitung fun di kinder fun Merari iz geven: di breter fun mishkn, un zaine riglen, un zaine zailn, un zaine shveln, un ale zaine keilim, un ale zaine dinst; <verse eid="NUM 3:36" /><verse number="37" style="v" sid="NUM 3:37" />un di zailn fun hoif rund arum, un zeyere shveln, un zeyere fleklech, un zeyere shtrik.<verse eid="NUM 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 3:38" />un di vos hobn gelagert far dem mishkn tsu mizrech, far dem ohel-moed tsu zunoifgang, zainen geven Moshe, un Aharon un zaine zin, vos hobn gehit di hitung fun mikdash, far der hitung fun di kinder fun Yisroel; un der fremder vos genent, hot gezolt geteit vern.<verse eid="NUM 3:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 3:39" />ale getseilte fun di Leviim, vos Moshe un Aharon hobn getseilt loit dem moil fun Hashem, noch zeyere mishpoches, ale mansparshoinen fun a choidesh alt un hecher, tsvei un tsvantsik toiznt.<verse eid="NUM 3:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40" />un Hashem hot gezogt tsu Mosheen: tseil ale ershtgeborene mansparshoinen fun di kinder fun Yisroel fun a choidesh alt un hecher, un nem oif di tsol fun zeyere nemen. <verse eid="NUM 3:40" /><verse number="41" style="v" sid="NUM 3:41" />un zolst nemen far mir, Hashem, di Leviim anshtot ale bechorim tsvishn di kinder fun Yisroel, un di beheimes fun di Leviim anshtot ale bechorim tsvishn di beheimes fun di kinder fun Yisroel.<verse eid="NUM 3:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 3:42" />un Moshe hot ibergetseilt, azoi vi Hashem hot im bafoiln, ale bechorim tsvishn di kinder fun Yisroel. <verse eid="NUM 3:42" /><verse number="43" style="v" sid="NUM 3:43" />un ale ershtgeborene mansparshoinen, loit der tsol fun nemen, fun a choidesh alt un hecher, noch zeyere getseilte, zainen geven tsvei un tsvantsik toiznt un tsvei hundert un drai un zibetsik.<verse eid="NUM 3:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 3:44" /><verse number="45" style="v" sid="NUM 3:45" />nem di Leviim anshtot ale bechorim tsvishn di kinder fun Yisroel, un di beheimes fun di Leviim anshtot zeyere beheimes, un di Leviim zoln gehern tsu mir. ich bin Hashem. <verse eid="NUM 3:45" /><verse number="46" style="v" sid="NUM 3:46" />un tsum oisleiz far di tsvei hundert un drai un zibetsik fun di bechorim fun di kinder fun Yisroel vos kumen ois mer fun di Leviim, <verse eid="NUM 3:46" /><verse number="47" style="v" sid="NUM 3:47" />zolstu nemen tsu finf, tsu finf shekl fun a kop; oifn heilikn shekl zolstu es nemen, tsvantsik gerah der shekl. <verse eid="NUM 3:47" /><verse number="48" style="v" sid="NUM 3:48" />un zolst gebn dos gelt tsu Aharonen un tsu zaine zin: dem oisleiz far di vos kumen ois mer tsvishn zei.<verse eid="NUM 3:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49" />hot Moshe genumen dos oisleizgelt fun di vos zainen oisgekumen mer vi di vos zainen oisgeleizt gevorn durch di Leviim; <verse eid="NUM 3:49" /><verse number="50" style="v" sid="NUM 3:50" />fun di bechorim fun di kinder fun Yisroel hot er genumen dos gelt: toiznt un drai hundert un finf un zechtsik, oifn heilikn shekl. <verse eid="NUM 3:50" /><verse number="51" style="v" sid="NUM 3:51" />un Moshe hot gegebn dos oisleizgelt tsu Aharonen un tsu zaine zin, loit dem moil fun Hashem, azoi vi Hashem hot Mosheen bafoiln.<verse eid="NUM 3:51" /></para>
  <chapter eid="NUM 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="NUM 4" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1" />un Hashem hot geredt tsu Mosheen un tsu Aharonen, azoi tsu zogn:<verse eid="NUM 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 4:2" />nem oif di tsol fun di kinder fun Kohat fun tsvishn di kinder fun Levi, loit zeyere mishpoches, loit zeyere foterhaizer, <verse eid="NUM 4:2" /><verse number="3" style="v" sid="NUM 4:3" />fun draisik yor alt un hecher, un biz fuftsik yor alt, itlechn vos geit arain in dinst, tsu ton arbet in ohel-moed. <verse eid="NUM 4:3" /><verse number="4" style="v" sid="NUM 4:4" />dos iz der dinst fun di kinder fun Kohat in ohel-moed arum di heilikste heilikeitn: <verse eid="NUM 4:4" /><verse number="5" style="v" sid="NUM 4:5" />Aharon un zaine zin zoln kumen baim tsien fun lager, un zei zoln aropnemen dem Parochet fun tsvishnsheid, un tsudekn dermit dem orn fun tseignim. <verse eid="NUM 4:5" /><verse number="6" style="v" sid="NUM 4:6" />un zei zoln aroifton deroif a tsudek fun tchsh-fel, un aribershpreitn fun oiben a tuch fun loiter bloer vol, un arainton zaine shtangen.<verse eid="NUM 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7" />un oif dem tish fun ongezicht zoln zei farshpreitn a tuch fun bloer vol, un aroifton deroif di shislen, un di sholn, un di kanen, un di bechers far gisung gisopfer; un dos shtendike broit zol blaibn deroif. <verse eid="NUM 4:7" /><verse number="8" style="v" sid="NUM 4:8" />un zei zoln farshpreitn oif zei a tuch fun vermilroit, un dos ariberdekn mit a tsudek fun tchsh-fel, un arainton zaine shtangen. <verse eid="NUM 4:8" /><verse number="9" style="v" sid="NUM 4:9" />un zei zoln nemen a tuch fun bloer vol, un ariberdekn di menoyre far laichtung, un ire rerlech, un ire tsvenglech, un ire ashfendlech, un ale ire eilgefesn vos me badint zi mit zei. <verse eid="NUM 4:9" /><verse number="10" style="v" sid="NUM 4:10" />un zei zoln arainton zi un ale ire keilim in a tsudek fun tchsh-fel, un aroifton oif a shtang. <verse eid="NUM 4:10" /><verse number="11" style="v" sid="NUM 4:11" />un oif dem gildernem mizbeyech zoln zei farshpreitn a tuch fun bloer vol, un im ariberdekn mit a tsudek fun tchsh-fel, un arainton zaine shtangen. <verse eid="NUM 4:11" /><verse number="12" style="v" sid="NUM 4:12" />un zei zoln nemen ale keilim fun dinst vos me dint mit zei in heiliktum, un zei arainton in a tuch fun bloer vol, un zei ariberdekn mit a tsudek fun tchsh-fel, un aroifton oif a shtang. <verse eid="NUM 4:12" /><verse number="13" style="v" sid="NUM 4:13" />un zei zoln opreinikn di ash fun mizbeyech, un farshpreitn oif im a tuch fun purpl. <verse eid="NUM 4:13" /><verse number="14" style="v" sid="NUM 4:14" />un zei zoln aroifton oif im ale zaine keilim vos me dint mit zei oif im, di faierfanen, di goplen, un di shuflen, un di shprengbekns – ale keilim fun mizbeyech; un zei zoln aribershpreitn oif im a tsudek fun tchsh-fel, un arainton zaine shtangen. <verse eid="NUM 4:14" /><verse number="15" style="v" sid="NUM 4:15" />un az Aharon un zaine zin hobn geendikt tsudekn dos heilike, un ale heilike keilim, baim tsien fun lager, zoln dernoch kumen di kinder fun Kohat, zei tsu trogn; ober zei zoln zich nisht onrirn on dem heilikn, vorem zei veln shtarbn. dos iz vos di kinder fun Kohat darfn trogn fun ohel-moed. <verse eid="NUM 4:15" /><verse number="16" style="v" sid="NUM 4:16" />un di oifzeung fun Elazar dem zun fun Aharon dem koyen zol zain iber dem eil far laichtung, un dem vairech fun shmekedike gevirtsn, un dem shtendikn shpaizopfer, un dem eil fun zalbung; di oifzeung iber dem gantsn mishkn mit alts vos in im, sai dos heiliktum, un sai zaine keilim.<verse eid="NUM 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17" />un Hashem hot geredt tsu Mosheen un tsu Aharonen, azoi tsu zogn: <verse eid="NUM 4:17" /><verse number="18" style="v" sid="NUM 4:18" />ir zolt nisht lozn farshnitn vern dem sheyvet fun di mishpoches fun di Kehatim, fun tsvishn di Leviim; <verse eid="NUM 4:18" /><verse number="19" style="v" sid="NUM 4:19" />naiert azoi tut mit zei, kedei zei zoln lebn un nisht shtarbn, ven zei genenen tsu di heilikste heilikeitn: Aharon un zaine zin zoln araingein, un zei shteln yetveder einem oif zain dinst, un bai zain mase. <verse eid="NUM 4:19" /><verse number="20" style="v" sid="NUM 4:20" />un zei zoln nisht araingein zen vi me tsenemt dos heiliktum, un shtarbn.<verse eid="NUM 4:20" /></para>
  <para style="s1">Naso</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 4:21" /><verse number="22" style="v" sid="NUM 4:22" />nem oif di tsol oich fun di kinder fun Gershon loit zeyere foterhaizer, loit zeyere mishpoches. <verse eid="NUM 4:22" /><verse number="23" style="v" sid="NUM 4:23" />fun draisik yor alt un hecher, biz fuftsik yor alt, zolstu zei tseiln, itlechn vos kumt dinen in dinst, tsu ton arbet in ohel-moed. <verse eid="NUM 4:23" /><verse number="24" style="v" sid="NUM 4:24" />dos iz der dinst fun di mishpoches fun di Gershonim baim arbeten un baim trogn: <verse eid="NUM 4:24" /><verse number="25" style="v" sid="NUM 4:25" />zei zoln trogn di forhangen fun mishkn, un dem ohel-moed, zain tsudek, un dem tsudek fun tchsh-fel vos oiben iber im, un dem tirforhang fun ohel-moed: <verse eid="NUM 4:25" /><verse number="26" style="v" sid="NUM 4:26" />un di arumhangen fun hoif, un dem tirforhang fun toier fun dem hoif vos rund arum dem mishkn un dem mizbeyech, un zeyere shtrik, un ale zeyere arbetgetsaig; un alts vos darf dermit geton vern zoln zei ton. <verse eid="NUM 4:26" /><verse number="27" style="v" sid="NUM 4:27" />loit dem moil fun Aharonen un zaine zin zol geshen der gantser dinst fun di kinder fun di Gershonim, in al zeyer trogn, un in al zeyer dinst; un ir zolt ibergebn in zeyer hitung alts vos zei darfn trogn. <verse eid="NUM 4:27" /><verse number="28" style="v" sid="NUM 4:28" />dos iz der dinst fun di mishpoches fun di kinder fun di Gershonim in ohel-moed; un zeyer hitung zol zain unter der hant fun Itamar dem zun fun Aharon dem koyen.<verse eid="NUM 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29" />di kinder fun Merari, zei oich zolstu tseiln loit zeyere mishpoches, loit zeyere foterhaizer. <verse eid="NUM 4:29" /><verse number="30" style="v" sid="NUM 4:30" />fun draisik yor alt un hecher, un biz fuftsik yor alt, zolstu zei tseiln, itlechn vos geit arain in dinst tsu ton di arbet fun ohel-moed. <verse eid="NUM 4:30" /><verse number="31" style="v" sid="NUM 4:31" />un dos iz vos zei darfn ophiten tsu trogn, loit zeyer gantsn dinst in ohel-moed: di breter fun mishkn, un zaine riglen, un zaine zailn, un zaine shveln; <verse eid="NUM 4:31" /><verse number="32" style="v" sid="NUM 4:32" />un di zailn fun hoif rund arum, un zeyere shveln, un zeyere fleklech, un zeyere shtrik – ale zeyere zachn, un ale zeyere tsubaher. un mit di nemen zolt ir oistseiln di zachn vos zei darfn ophiten tsu trogn. <verse eid="NUM 4:32" /><verse number="33" style="v" sid="NUM 4:33" />dos iz der dinst fun di mishpoches fun di kinder fun Merari, loit al zeyer dinst in ohel-moed, unter der hant fun Itamar dem zun fun Aharon dem koyen.<verse eid="NUM 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34" />un Moshe un Aharon un di firshtn fun der eide hobn getseilt di kinder fun di Kehatim loit zeyere mishpoches, un loit zeyere foterhaizer, <verse eid="NUM 4:34" /><verse number="35" style="v" sid="NUM 4:35" />fun draisik yor alt un hecher, un biz fuftsik yor alt, itlechn vos iz arain in dinst tsu der arbet in ohel-moed. <verse eid="NUM 4:35" /><verse number="36" style="v" sid="NUM 4:36" />un zeyere getseilte loit zeyere mishpoches, zainen geven tsvei toiznt zibn hundert un fuftsik. <verse eid="NUM 4:36" /><verse number="37" style="v" sid="NUM 4:37" />dos zainen di getseilte fun di mishpoches fun di Kehatim, ale vos hobn gedint in ohel-moed, di vos Moshe un Aharon hobn getseilt loit dem moil fun Hashem durch Mosheen.<verse eid="NUM 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38" />un di getseilte fun di kinder fun Gershon loit zeyere mishpoches, un loit zeyere foterhaizer, <verse eid="NUM 4:38" /><verse number="39" style="v" sid="NUM 4:39" />fun draisik yor alt un hecher, un biz fuftsik yor alt, itlecher vos iz arain in dinst tsu der arbet in ohel-moed. <verse eid="NUM 4:39" /><verse number="40" style="v" sid="NUM 4:40" />zeyere getseilte loit zeyere mishpoches, loit zeyere foterhaizer, zainen geven tsvei toiznt un zeks hundert un draisik. <verse eid="NUM 4:40" /><verse number="41" style="v" sid="NUM 4:41" />dos zainen di getseilte fun di mishpoches fun di kinder fun Gershon, ale vos hobn gedint in ohel-moed, di vos Moshe un Aharon hobn getseilt loit dem moil fun Hashem.<verse eid="NUM 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 4:42" />un di getseilte fun di mishpoches fun di kinder fun Merari loit zeyere mishpoches, loit zeyere foterhaizer, <verse eid="NUM 4:42" /><verse number="43" style="v" sid="NUM 4:43" />fun draisik yor alt un hecher, un biz fuftsik yor alt, itlecher vos iz arain in dinst tsu der arbet in ohel-moed <verse eid="NUM 4:43" /><verse number="44" style="v" sid="NUM 4:44" />zeyere getseilte loit zeyere mishpoches, zainen geven drai toiznt un tsvei hundert. <verse eid="NUM 4:44" /><verse number="45" style="v" sid="NUM 4:45" />dos zainen di getseilte fun di mishpoches fun di kinder fun Merari, vos Moshe un Aharon hobn getseilt loit dem moil fun Hashem durch Mosheen.<verse eid="NUM 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 4:46" />ale getseilte vos Moshe un Aharon un di firshtn fun Yisroel hobn getseilt fun di Leviim loit zeyere mishpoches, un loit zeyere foterhaizer, <verse eid="NUM 4:46" /><verse number="47" style="v" sid="NUM 4:47" />fun draisik yor alt un hecher, un biz fuftsik yor alt, itlecher vos iz gekumen dinen dem dinst fun arbet, un dem disnt fun trogn, in ohel-moed. <verse eid="NUM 4:47" /><verse number="48" style="v" sid="NUM 4:48" />zeyere getseilte zainen geven acht toiznt un finf hundert un achtsik.<verse eid="NUM 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 4:49" />loit dem moil fun Hashem durch Mosheen hot men zei geshtelt yetveder man oif zain dinst un oif zain mase. azoi iz geven zeyer tseilung vos Hashem hot bafoiln Mosheen.<verse eid="NUM 4:49" /></para>
  <chapter eid="NUM 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="NUM 5" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 5:1" /><verse number="2" style="v" sid="NUM 5:2" />bafel di kinder fun Yisroel, zei zoln aroisshikn fun lager itlechn metsoire, un itlechn flusikn, un itlechn vos iz umrein fun a toitn laib. <verse eid="NUM 5:2" /><verse number="3" style="v" sid="NUM 5:3" />sai a zocher sai a nekeyve zolt ir aroisshikn, oisn lager zolt ir zei aroisshikn, kedei zei zoln nisht farumreinikn zeyere lagern vos ich ru tsvishn zei.<verse eid="NUM 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 5:4" />hobn di kinder fun Yisroel azoi geton, un zei hobn zei aroisgeshikt oisn lager; azoi vi Hashem hot geredt tsu Mosheen, azoi hobn di kinder fun Yisroel geton.<verse eid="NUM 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 5:5" /><verse number="6" style="v" sid="NUM 5:6" />red tsu di kinder fun Yisroel: a man oder a froi, az zei veln bagein epes a mentshleche zind, tsu felshn a felshung on Hashem, un yene zel vet zich farshuldikn, <verse eid="NUM 5:6" /><verse number="7" style="v" sid="NUM 5:7" />zoln zei zich misvade zain oif zeyere zind vos zei hobn bagangen; un er zol umkeren dem keren fun zain farshuldikung, un tsoleign dertsu a finftl derfun, un opgebn tsu dem kegen vemen er hot zich farshuldikt. <verse eid="NUM 5:7" /><verse number="8" style="v" sid="NUM 5:8" />un az der man hot nisht kein korev, vemen umtsukeren dos farshuldikte, zol dos farshuldikte vos darf umgekert vern, gehern tsu Hashem, tsum koyen; achuts dem vider fun fargebung, vos dermit zol men mechaper zain oif im.<verse eid="NUM 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 5:9" />un yetveder opsheidung, fun ale geheilikte zachn fun di kinder fun Yisroel, vos zei veln brengen tsum koyen, zol gehern tsu im. <verse eid="NUM 5:9" /><verse number="10" style="v" sid="NUM 5:10" />un di geheilikte zachn fun itlechn zoln gehern tsu im: vos emitser vet gebn tsum koyen, zol gehern tsu im.<verse eid="NUM 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 5:11" /><verse number="12" style="v" sid="NUM 5:12" />red tsu di kinder fun Yisroel, un zolstu zogn tsu zei: az emitsn einems vaib vet arop fun veg, un vet felshn a felshung on im, <verse eid="NUM 5:12" /><verse number="13" style="v" sid="NUM 5:13" />un a man vet lign mit ir a baishlof fun zomen, un es vet zain farhoiln fun di oign fun ir man, vail zi iz farumreinikt gevorn farborgenerheit, un kein eides akegn ir iz nishto, un zi iz nisht gechapt gevorn; <verse eid="NUM 5:13" /><verse number="14" style="v" sid="NUM 5:14" />un a gaist fun eiferzucht vet kumen oif im, un er vet vern eiferzichtik oif zain vaib, ven zi iz farumreinikt gevorn; oder a gaist fun eiferzucht vet kumen oif im, un er vet vern eiferzichtik oif zain vaib, un zi iz nisht farumreinikt gevorn; <verse eid="NUM 5:14" /><verse number="15" style="v" sid="NUM 5:15" />zol der man brengen zain vaib tsum koyen, un brengen ir korben mit ir, a tsentl eife gershtene mel; er zol nisht aroifgisn deroif eil, un nisht aroifton deroif vairech, vorem a shpaizopfer fun eiferzucht iz dos, a shpaizopfer fun dermonung, vos dermont a zind. <verse eid="NUM 5:15" /><verse number="16" style="v" sid="NUM 5:16" />un der koyen zol zi machn genenen, un zi avekshtelen far Hashem. <verse eid="NUM 5:16" /><verse number="17" style="v" sid="NUM 5:17" />un der koyen zol nemen heilike vaser in a leimener keile, un fun dem shtoib vos iz oifn bodem fun mishkn zol der koyen nemen, un arainton in dem vaser. <verse eid="NUM 5:17" /><verse number="18" style="v" sid="NUM 5:18" />un der koyen zol shteln di froi far Hashem, un tseshoibern dem kop fun der froi, un gebn oif ire hantflechn dos shpaizopfer fun dermonung, dos iz dos shpaizopfer fun eiferzucht; un in dem koyens hant zol zain dos dozike vaser fun biternish vos macht farsholten . <verse eid="NUM 5:18" /><verse number="19" style="v" sid="NUM 5:19" />un der koyen zol zi bashvern, un zogn tsu der froi: oib kein man iz nisht gelegn mit dir, un oib du bist nisht arop fun veg in umreinkeit hinter dain man, blaib umgeshat fun dem dozikn vaser fun biternish vos macht farsholten . <verse eid="NUM 5:19" /><verse number="20" style="v" sid="NUM 5:20" />oib ober du bist arop fun veg hinter dain man, un oib du bist farumreinikt gevorn, un a man iz gelegn mit dir achuts dain man – <verse eid="NUM 5:20" /><verse number="21" style="v" sid="NUM 5:21" />un der koyen zol bashvern di froi mit a shvue fun a klole, un der koyen zol zogn tsu der froi – zol dich Hashem machn far a klole un far a shvue tsvishn dain folk, az Hashem vet machn avekfaln dain dich, un geshveln dain boich; <verse eid="NUM 5:21" /><verse number="22" style="v" sid="NUM 5:22" />un dos dozike vaser vos macht farsholten zol arain in daine ingeveid, tsu machn geshveln dem boich, un machn avekfaln dem dich; un di froi zol zogn: Omein! Omein! <verse eid="NUM 5:22" /><verse number="23" style="v" sid="NUM 5:23" />un der koyen zol oifshraibn di dozike kloles oif a megile, un opmekn in dem vaser fun biternish. <verse eid="NUM 5:23" /><verse number="24" style="v" sid="NUM 5:24" />un er zol gebn trinken der froi dos vaser fun biternish vos macht farsholten , un dos vaser vos macht farsholten vet arain in ir far a biternish. <verse eid="NUM 5:24" /><verse number="25" style="v" sid="NUM 5:25" />un der koyen zol nemen fun der frois hant dos shpaizopfer fun eiferzucht, un oifheibn dos shpaizopfer far Hashem, un es genenen tsum mizbeyech. <verse eid="NUM 5:25" /><verse number="26" style="v" sid="NUM 5:26" />un der koyen zol onnemen a hoifn fun dem shpaizopfer – zain dermonung, un demfn oifn mizbeyech; un dernoch zol er gebn trinken der froi dos vaser. <verse eid="NUM 5:26" /><verse number="27" style="v" sid="NUM 5:27" />un az er vet ir gebn trinken dos vaser, iz, oib zi iz farumreinikt gevorn, un hot gefelsht a felshung on ir man, vet dos vaser vos macht farsholten , arain in ir far a biternish, un ir boich vet geshvoln vern, un ir dich vet avekfaln; un di froi vet vern far a klole tsvishn ir folk. <verse eid="NUM 5:27" /><verse number="28" style="v" sid="NUM 5:28" />oib ober di froi iz nisht farumreinikt gevorn, un zi iz rein, vet zi blaibn umgeshat, un vet antfangen zomen.<verse eid="NUM 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29" />dos iz der torat kine: az a vaib vet aropgein fun veg hinter ir man, un vet farumreinikt vern, <verse eid="NUM 5:29" /><verse number="30" style="v" sid="NUM 5:30" />oder az a gaist fun eiferzucht vet kumen oif a man, un er vet vern eiferzichtik oif zain vaib, zol er shteln di vaib far Hashem, un der koyen zol ton tsu ir dem dozikn din. <verse eid="NUM 5:30" /><verse number="31" style="v" sid="NUM 5:31" />un der man vet zain rein fun zind, un yene froi vet trogn ir zind.<verse eid="NUM 5:31" /></para>
  <chapter eid="NUM 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="NUM 6" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 6:1" /><verse number="2" style="v" sid="NUM 6:2" />red tsu di kinder fun Yisroel, un zolst zogn tsu zei: az a man oder a froi vet klor a neyder ton dem neyder fun a Nezir, zich optsusheiden tsu Hashem, <verse eid="NUM 6:2" /><verse number="3" style="v" sid="NUM 6:3" />zol er fun vain un shtarkn getrank zich ophaltn; esik fun vain un esik fun shtarkn getrank zol er nisht trinken, un kein zaft fun troibn zol er nisht trinken; un troibn frishe oder getriknte zol er nisht esen. <verse eid="NUM 6:3" /><verse number="4" style="v" sid="NUM 6:4" />ale teg fun zain Nezir opzundern zol er fun alts vos vert gemacht fun vainshtok, fun kerndlech biz a sholechts nisht esen. <verse eid="NUM 6:4" /><verse number="5" style="v" sid="NUM 6:5" />ale teg fun zain neyder fun Nezir opzundern zol a golmeser nisht aribergein iber zain kop; biz es vern ful di teg vos er vet zich opsheiden tsu Hashem, zol er zain heilik: lozn vaksn vild di hor fun zain kop. <verse eid="NUM 6:5" /><verse number="6" style="v" sid="NUM 6:6" />ale teg vos er sheidt zich op tsu Hashem, zol er tsu dem laib fun a toitn nisht tsugein. <verse eid="NUM 6:6" /><verse number="7" style="v" sid="NUM 6:7" />on zain foter un on zain muter, on zain bruder un on zain shvester, afile on zei zol er zich nisht farumreinikn, az zei shtarbn, vorem di Nezir opzundern fun zain G-t iz oif zain kop. <verse eid="NUM 6:7" /><verse number="8" style="v" sid="NUM 6:8" />ale teg fun zain Nezir opzundern iz er heilik tsu Hashem. <verse eid="NUM 6:8" /><verse number="9" style="v" sid="NUM 6:9" />un az emitser vet shtarbn lebn im plutsling umgericht, un vet farumreinikn zain Nezir-kop, zol er opgolen zain kop in dem tog vos er vert rein: oifn zibetn tog zol er im opgolen. <verse eid="NUM 6:9" /><verse number="10" style="v" sid="NUM 6:10" />un oifn achten tog zol er brengen tsvei turtltoibn, oder tsvei yunge toibn, tsum koyen, tsum aingang fun ohel-moed. <verse eid="NUM 6:10" /><verse number="11" style="v" sid="NUM 6:11" />un der koyen zol machn eine far a zindopfer, un eine far a brandopfer, un mechaper zain oif im far vos er hot gezindikt on dem toitn; un er zol heilikn zain kop in yenem tog. <verse eid="NUM 6:11" /><verse number="12" style="v" sid="NUM 6:12" />un er zol zich opsheiden tsu Hashem di teg fun zain Nezir opzundern, un brengen a yorikn sheps far a shuldopfer, un di frierdike teg zoln opfaln, vorem zain Nezir opzundern iz farumreinikt gevorn.<verse eid="NUM 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13" />un dos iz der din fun a Nezir: in dem tog vos di teg fun zain Nezir opzundern vern ful, zol men im brengen tsum aingang fun ohel-moed; <verse eid="NUM 6:13" /><verse number="14" style="v" sid="NUM 6:14" />un er zol genenen zain korben tsu Hashem, ein sheps a yorikn on a feler far a brandopfer, un ein shof a yorike on a feler far a zindopfer, un ein vider on a feler far a fridopfer, <verse eid="NUM 6:14" /><verse number="15" style="v" sid="NUM 6:15" />un a korb umgezaiertn broit, chalus fun zemelmel farmisht mit eil, un umgezaierte kuchns bashmirt mit eil, un zeyer shpaizopfer un zeyere gisopfer. <verse eid="NUM 6:15" /><verse number="16" style="v" sid="NUM 6:16" />un der koyen zol es genenen far Hashem, un machn zain zindopfer un zain brandopfer. <verse eid="NUM 6:16" /><verse number="17" style="v" sid="NUM 6:17" />un dem vider zol er machn a fridopfer tsu Hashem, mit dem korb umgezaiertn broit; un der koyen zol machn zain shpaizopfer un zain gisopfer. <verse eid="NUM 6:17" /><verse number="18" style="v" sid="NUM 6:18" />un der Nezir zol opgolen baim aingang fun ohel-moed zain Nezir-kop, un nemen di hor fun zain Nezir-kop, un aroifton oif dem faier vos untern fridopfer. <verse eid="NUM 6:18" /><verse number="19" style="v" sid="NUM 6:19" />un der koyen zol nemen di shulter, a gekochte, fun dem vider, un ein umgezaierte chale fun dem korb, un ein umgezaiertn kuchn, un aroifton oif dem Nezirs hent, noch dem vi er hot zich opgegolt zaine Nezir-hor. <verse eid="NUM 6:19" /><verse number="20" style="v" sid="NUM 6:20" />un der koyen zol zei oifheibn an oifheibung far Hashem; dos iz heilik tsum koyen, mit der brust fun oifheibung, un mit dem shenkl fun opsheidung. un dernoch meg der Nezir trinken vain.<verse eid="NUM 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21" />dos iz der din fun dem Nezir vos tut a neyder, vegen zain korben tsu Hashem far zain Nezir opzundern, achuts vos zain hant farmogt noch tsutsugebn; azoi vi zain neyder vos er vet a neyder ton, azoi muz er ton, loit dem din fun zain Nezir opzundern.<verse eid="NUM 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 6:22" /><verse number="23" style="v" sid="NUM 6:23" />red tsu Aharonen un tsu zaine zin, azoi tsu zogn: azoi zolt ir bentshn di kinder fun Yisroel; zogt tsu zei:<verse eid="NUM 6:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="NUM 6:24" />Hashem zol dich bentshn, un dich hitn!<verse eid="NUM 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="NUM 6:25" />Hashem zol derlaichtn zain ponem tsu dir, un dich laitzelikn!<verse eid="NUM 6:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="NUM 6:26" />Hashem zol oifheibn zain ponem tsu dir, un dir bashern sholem!<verse eid="NUM 6:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27" />un zei zoln aroifton main nomen oif di kinder fun Yisroel, un ich vel zei bentshn.<verse eid="NUM 6:27" /></para>
  <chapter eid="NUM 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="NUM 7" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1" />un es iz geven, in dem tog vos Moshe hot geendikt oifshteln dem mishkn, un hot im gezalbt, un im geheilikt mit ale zaine keilim, un dem mizbeyech mit ale zaine keilim – az er hot zei gezalbt un zei geheilikt, <verse eid="NUM 7:1" /><verse number="2" style="v" sid="NUM 7:2" />hobn genent di firshtn fun Yisroel, di hoipt fun zeyere foterhaizer – zei, di firshtn fun di shvotim, zei vos zainen geshtanen bai der tseilung; <verse eid="NUM 7:2" /><verse number="3" style="v" sid="NUM 7:3" />un zei hobn gebracht zeyer korben far Hashem, zeks tsugedekte vegen, un tsvelf rinder: a vogn far tsvei firshtn, un an oks far itlechn; un zei hobn zei genent tsum mishkn. <verse eid="NUM 7:3" /><verse number="4" style="v" sid="NUM 7:4" />hot Hashem gezogt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 7:4" /><verse number="5" style="v" sid="NUM 7:5" />nem tsu fun zei, un es zol zain oif tsu dinen dem dinst fun ohel-moed; un zolst es gebn tsu di Leviim, itlechn loit zain dinst. <verse eid="NUM 7:5" /><verse number="6" style="v" sid="NUM 7:6" />hot Moshe genumen di vegen un di rinder, un hot zei gegebn tsu di Leviim. <verse eid="NUM 7:6" /><verse number="7" style="v" sid="NUM 7:7" />tsvei vegen un fir rinder hot er gegebn tsu di kinder fun Gershon, loit zeyer dinst.<verse eid="NUM 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 7:8" />un fir vegen un acht rinder hot er gegebn tsu di kinder fun Merari, loit zeyer dinst unter der hant fun Itamar dem zun fun Aharon dem koyen. <verse eid="NUM 7:8" /><verse number="9" style="v" sid="NUM 7:9" />ober tsu di kinder fun Kohat hot er gornisht gegebn, vorem der dinst fun di heilike zachn iz geven oif zei; oifn aksl hobn zei gedarft trogn.<verse eid="NUM 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10" />un di firshtn hobn gebracht di banaiung fun mizbeyech in dem tog vos er iz gezalbt gevorn – di firshtn hobn gebracht zeyer korben far dem mizbeyech. <verse eid="NUM 7:10" /><verse number="11" style="v" sid="NUM 7:11" />un Hashem hot gezogt tsu Mosheen: tsu ein firsht a tog, tsu ein firsht a tog, zoln zei brengen zeyer korben far der banaiung fun mizbeyech.<verse eid="NUM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 7:12" />un der vos hot gebracht zain korben dem ershtn tog iz geven Nachshon der zun fun Amminadavn, fun sheyvet Yehudah. <verse eid="NUM 7:12" /><verse number="13" style="v" sid="NUM 7:13" />un zain korben iz geven: ein zilberne shisel vos ir vog iz geven hundert un draisik shekl, ein zilberner shprengbekn fun zibetsik shekl, oifn heilikn shekl; beide ful mit zemelmel farmisht mit eil, far a shpaizopfer; <verse eid="NUM 7:13" /><verse number="14" style="v" sid="NUM 7:14" />ein gilderne shol fun tsen shekl, ful mit vairech; <verse eid="NUM 7:14" /><verse number="15" style="v" sid="NUM 7:15" />ein yunger oks, ein vider, ein sheps a yoriker, far a brandopfer; <verse eid="NUM 7:15" /><verse number="16" style="v" sid="NUM 7:16" />ein tsignbok far a zindopfer; <verse eid="NUM 7:16" /><verse number="17" style="v" sid="NUM 7:17" />un far a fridopfer, tsvei rinder, finf viders, finf bek, finf shepsn yorike. dos iz der korben fun Nachshon dem zun fun Amminadavn.<verse eid="NUM 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 7:18" />oifn tsveitn tog hot gebracht Netanel der zun fun Tsuarn, der firsht fun Yissachar. <verse eid="NUM 7:18" /><verse number="19" style="v" sid="NUM 7:19" />er hot gebracht far zain korben ein zilberne shisel vos ir vog iz geven hundert un draisik shekl, ein zilbernem shprengbekn fun zibetsik shekl, oifn heilikn shekl; beide ful mit zemelmel farmisht mit eil, far a shpaizopfer; <verse eid="NUM 7:19" /><verse number="20" style="v" sid="NUM 7:20" />ein gilderne shol fun tsen shekl, ful mit vairech;<verse eid="NUM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 7:21" />ein yungn oks, ein vider, ein sheps a yorikn, far a brandopfer; <verse eid="NUM 7:21" /><verse number="22" style="v" sid="NUM 7:22" />ein tsignbok far a zindopfer; <verse eid="NUM 7:22" /><verse number="23" style="v" sid="NUM 7:23" />un far a fridopfer, tsvei rinder, finf viders, finf bek, finf shepsn yorike. dos iz der korben fun Netanel dem zun fun Tsuarn.<verse eid="NUM 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 7:24" />oifn dritn tog, der firsht fun di kinder fun Zevulun, Eliav der zun fun Chelonen. <verse eid="NUM 7:24" /><verse number="25" style="v" sid="NUM 7:25" />zain korben iz geven: ein zilberne shisel vos ir vog iz geven hundert un draisik shekl, ein zilberner shprengbekn fun zibetsik shekl, oifn heilikn shekl; beide ful mit zemelmel farmisht mit eil, far a shpaizopfer;<verse eid="NUM 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 7:26" />ein gilderne shol fun tsen shekl, ful mit vairech; <verse eid="NUM 7:26" /><verse number="27" style="v" sid="NUM 7:27" />ein yunger oks, ein vider, ein sheps a yoriker, far a brandopfer; <verse eid="NUM 7:27" /><verse number="28" style="v" sid="NUM 7:28" />ein tsignbok far a zindopfer; <verse eid="NUM 7:28" /><verse number="29" style="v" sid="NUM 7:29" />un far a fridopfer, tsvei rinder, finf viders, finf bek, finf shepsn yorike. dos iz der korben fun Eliav dem zun fun Chelonen.<verse eid="NUM 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 7:30" />oifn firtn tog, der firsht fun di kinder fun Reuven, Elitsur der zun fun Shedeurn. <verse eid="NUM 7:30" /><verse number="31" style="v" sid="NUM 7:31" />zain korben iz geven: ein zilberne shisel vos ir vog iz geven hundert un draisik shekl, ein zilberner shprengbekn fun zibetsik shekl, oifn heilikn shekl; beide ful mit zemelmel farmisht mit eil, far a shpaizopfer;<verse eid="NUM 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 7:32" />ein gilderne shol fun tsen shekl, ful mit vairech; <verse eid="NUM 7:32" /><verse number="33" style="v" sid="NUM 7:33" />ein yunger oks, ein vider, ein sheps a yoriker, far a brandopfer; <verse eid="NUM 7:33" /><verse number="34" style="v" sid="NUM 7:34" />ein tsignbok far a zindopfer; <verse eid="NUM 7:34" /><verse number="35" style="v" sid="NUM 7:35" />un far a fridopfer, tsvei rinder, finf viders, finf bek, finf shepsn yorike. dos iz der korben fun Elitsur dem zun fun Shedeurn.<verse eid="NUM 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 7:36" />oifn finftn tog, der firsht fun di kinder fun Shimeon, Shelumiel der zun fun Tsurishaddaien. <verse eid="NUM 7:36" /><verse number="37" style="v" sid="NUM 7:37" />zain korben iz geven: ein zilberne shisel vos ir vog iz geven hundert un draisik shekl, ein zilberner shprengbekn fun zibetsik shekl, oifn heilikn shekl; beide ful mit zemelmel farmisht mit eil, far a shpaizopfer: <verse eid="NUM 7:37" /><verse number="38" style="v" sid="NUM 7:38" />ein gilderne shol fun tsen shekl, ful mit vairech;<verse eid="NUM 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 7:39" />ein yunger oks, ein vider, ein sheps a yorikerer far a brandopfer; <verse eid="NUM 7:39" /><verse number="40" style="v" sid="NUM 7:40" />ein tsignbok far a zindopfer; <verse eid="NUM 7:40" /><verse number="41" style="v" sid="NUM 7:41" />un far a fridopfer, tsvei rinder, finf viders, finf bek, finf shepsn yorike. dos iz der korben fun Shelumiel dem zun fun Tsurishaddaien.<verse eid="NUM 7:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 7:42" />oifn zekstn tog, der firsht fun di kinder fun Gad, ElyaSaf der zun fun Deueln. <verse eid="NUM 7:42" /><verse number="43" style="v" sid="NUM 7:43" />zain korben iz geven: ein zilberne shisel vos ir vog iz geven hundert un draisik shekl, ein zilberner shprengbekn fun zibetsik shekl, oifn heilikn shekl; beide ful mit zemelmel farmisht mit eil, far a shpaizopfer;<verse eid="NUM 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 7:44" />ein gilderne shol fun tsen shekl, ful mit vairech; <verse eid="NUM 7:44" /><verse number="45" style="v" sid="NUM 7:45" />ein yunger oks, ein vider, ein sheps a yoriker, far a brandopfer; <verse eid="NUM 7:45" /><verse number="46" style="v" sid="NUM 7:46" />ein tsignbok far a zindopfer; <verse eid="NUM 7:46" /><verse number="47" style="v" sid="NUM 7:47" />un far a fridopfer, tsvei rinder, finf viders, finf bek, finf shepsn yorike. dos iz der korben fun ElyaSaf dem zun fun Deueln.<verse eid="NUM 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 7:48" />oifn zibetn tog, der firsht fun di kinder fun Efrayim, Elishama der zun fun Ammihudn. <verse eid="NUM 7:48" /><verse number="49" style="v" sid="NUM 7:49" />zain korben iz geven: ein zilberne shisel vos ir vog iz geven hundert un draisik shekl, ein zilberner shprengbekn fun zibetsik shekl, oifn heilikn shekl; beide ful mit zemelmel farmisht mit eil, far a shpaizopfer; <verse eid="NUM 7:49" /><verse number="50" style="v" sid="NUM 7:50" />ein gilderne shol fun tsen shekl, ful mit vairech;<verse eid="NUM 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 7:51" />ein yunger oks, ein vider, ein sheps a yoriker, far a brandopfer; <verse eid="NUM 7:51" /><verse number="52" style="v" sid="NUM 7:52" />ein tsignbok far a zindopfer; <verse eid="NUM 7:52" /><verse number="53" style="v" sid="NUM 7:53" />un far a fridopfer, tsvei rinder, finf viders, finf bek, finf shepsn yorike. dos iz der korben fun Elishama dem zun fun Ammihudn.<verse eid="NUM 7:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 7:54" />oifn achten tog, der firsht fun di kinder fun Menasheh, Gamliel der zun fun Pedahtsurn. <verse eid="NUM 7:54" /><verse number="55" style="v" sid="NUM 7:55" />zain korben iz geven: ein zilberne shisel vos ir vog iz geven hundert un draisik shekl, ein zilberner shprengbekn fun zibetsik shekl, oifn heilikn shekl; beide ful mit zemelmel farmisht mit eil, far a shpaizopfer;<verse eid="NUM 7:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="NUM 7:56" />ein gilderne shol fun tsen shekl, ful mit vairech; <verse eid="NUM 7:56" /><verse number="57" style="v" sid="NUM 7:57" />ein yunger oks, ein vider, ein sheps a yoriker, far a brandopfer; <verse eid="NUM 7:57" /><verse number="58" style="v" sid="NUM 7:58" />ein tsignbok far a zindopfer; <verse eid="NUM 7:58" /><verse number="59" style="v" sid="NUM 7:59" />un far a fridopfer, tsvei rinder, finf viders, finf bek, finf shepsn yorike. dos iz der korben fun Gamliel dem zun fun Pedahtsurn.<verse eid="NUM 7:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="NUM 7:60" />oifn naintn tog, der firsht fun di kinder fun Binyamin, Avidan der zun fun Gideonin. <verse eid="NUM 7:60" /><verse number="61" style="v" sid="NUM 7:61" />zain korben iz geven: ein zilberne shisel vos ir vog iz geven hundert un draisik shekl, ein zilberner shprengbekn fun zibetsik shekl, oifn heilikn shekl; beide ful mit zemelmel farmisht mit eil, far a shpaizopfer;<verse eid="NUM 7:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="NUM 7:62" />ein gilderne shol fun tsen shekl, ful mit vairech; <verse eid="NUM 7:62" /><verse number="63" style="v" sid="NUM 7:63" />ein yunger oks, ein vider, ein sheps a yoriker, far a brandopfer; <verse eid="NUM 7:63" /><verse number="64" style="v" sid="NUM 7:64" />ein tsignbok far a zindopfer; <verse eid="NUM 7:64" /><verse number="65" style="v" sid="NUM 7:65" />un far a fridopfer, tsvei rinder, finf viders, finf bek, finf shepsn yorike. dos iz der korben fun Avidan dem zun fun Gideonin.<verse eid="NUM 7:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="NUM 7:66" />oifn tsentn tog, der firsht fun di kinder fun Dan, Achiezer der zun fun Ammishaddain. <verse eid="NUM 7:66" /><verse number="67" style="v" sid="NUM 7:67" />zain korben iz geven: ein zilberne shisel vos ir vog iz geven hundert un draisik shekl, ein zilberner shprengbekn fun zibetsik shekl, oifn heilikn shekl; beide ful mit zemelmel farmisht mit eil, far a shpaizopfer; <verse eid="NUM 7:67" /><verse number="68" style="v" sid="NUM 7:68" />ein gilderne shol fun tsen shekl, ful mit vairech; <verse eid="NUM 7:68" /><verse number="69" style="v" sid="NUM 7:69" />ein yunger oks, ein vider, ein sheps a yoriker, far a brandopfer; <verse eid="NUM 7:69" /><verse number="70" style="v" sid="NUM 7:70" />ein tsignbok far a zindopfer; <verse eid="NUM 7:70" /><verse number="71" style="v" sid="NUM 7:71" />un far a fridopfer, tsvei rinder, finf viders, finf bek, finf shepsn yorike. dos iz der korben fun Achiezer dem zun fun Ammishaddain.<verse eid="NUM 7:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="NUM 7:72" />oifn elftn tog, der firsht fun di kinder fun Asher, Pagiel der zun fun Ochranen. <verse eid="NUM 7:72" /><verse number="73" style="v" sid="NUM 7:73" />zain korben iz geven: ein zilberne shisel vos ir vog iz geven hundert un draisik shekl, ein zilberner shprengbekn fun zibetsik shekl, oifn heilikn shekl; beide ful mit zemelmel farmisht mit eil, far a shpaizopfer; <verse eid="NUM 7:73" /><verse number="74" style="v" sid="NUM 7:74" />ein gilderne shol fun tsen shekl, ful mit vairech; <verse eid="NUM 7:74" /><verse number="75" style="v" sid="NUM 7:75" />ein yunger oks, ein vider, ein sheps a yoriker, far a brandopfer; <verse eid="NUM 7:75" /><verse number="76" style="v" sid="NUM 7:76" />ein tsignbok far a zindopfer; <verse eid="NUM 7:76" /><verse number="77" style="v" sid="NUM 7:77" />un far a fridopfer, tsvei rinder, finf viders, finf bek, finf shepsn yorike. dos iz der korben fun Pagiel dem zun fun Ochranen.<verse eid="NUM 7:77" /></para>
  <para style="p">
    <verse number="78" style="v" sid="NUM 7:78" />oifn tsvelftn tog, der firsht fun di kinder fun Naftali, Achira der zun fun Enanen. <verse eid="NUM 7:78" /><verse number="79" style="v" sid="NUM 7:79" />zain korben iz geven: ein zilberne shisel vos ir vog iz geven hundert un draisik shekl, ein zilberner shprengbekn fun zibetsik shekl, oifn heilikn shekl; beide ful mit zemelmel farmisht mit eil, far a shpaizopfer; <verse eid="NUM 7:79" /><verse number="80" style="v" sid="NUM 7:80" />ein gilderne shol fun tsen shekl, ful mit vairech; <verse eid="NUM 7:80" /><verse number="81" style="v" sid="NUM 7:81" />ein yunger oks, ein vider, ein sheps a yoriker, far a brandopfer; <verse eid="NUM 7:81" /><verse number="82" style="v" sid="NUM 7:82" />ein tsignbok far a zindopfer; <verse eid="NUM 7:82" /><verse number="83" style="v" sid="NUM 7:83" />un far a fridopfer, tsvei rinder, finf viders, finf bek, finf shepsn yorike. dos iz der korben fun Achira dem zun fun Enanen.<verse eid="NUM 7:83" /></para>
  <para style="p">
    <verse number="84" style="v" sid="NUM 7:84" />dos iz geven di banaiung fun dem mizbeyech, in dem tog vos er iz gezalbt gevorn, fun di firshtn fun Yisroel: tsvelf zilberne shislen, tsvelf zilberne shprengbekns, tsvelf gilderne sholn; <verse eid="NUM 7:84" /><verse number="85" style="v" sid="NUM 7:85" />itleche shisel hundert un draisik shekl zilber, un itlecher shprengbekn zibetsik; dos gantse zilber fun di keilim, tsvei toiznt un fir hundert, oifn heilikn shekl. <verse eid="NUM 7:85" /><verse number="86" style="v" sid="NUM 7:86" />tsvelf gilderne sholn ful mit vairech, tsu tsen, tsu tsen shekl a shol, oifn heilikn shekl; dos gantse gold fun di sholn, hundert un tsvantsik. <verse eid="NUM 7:86" /><verse number="87" style="v" sid="NUM 7:87" />ale rinder far brandopfer: tsvelf oksen; viders tsvelf; shepsn yorike tsvelf, mit zeyer shpaizopfer, un tsignbek tsvelf, far zindopfer. <verse eid="NUM 7:87" /><verse number="88" style="v" sid="NUM 7:88" />un ale rinder far fridopfer: fir un tsvantsik oksen; viders zechtsik, bek zechtsik, shepsn yorike zechtsik. dos iz geven di banaiung fun dem mizbeyech noch dem vi er iz gezalbt gevorn.<verse eid="NUM 7:88" /></para>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89" />un az Moshe iz gekumen in ohel-moed kedei G-t zol redn mit im, hot er gehert dem kol redn tsu im fun iber dem dek vos oifn orn fun tseignim, fun tsvishn di tsvei kruvim; azoi hot er geredt tsu im.<verse eid="NUM 7:89" /></para>
  <chapter eid="NUM 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="NUM 8" />
  <para style="s1">Bahaalotecha</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 8:1" /><verse number="2" style="v" sid="NUM 8:2" />red tsu Aharonen un zolst zogn tsu im: az du tsindst on di licht zoln di zibn rerlech laichtn forent tsu fun der menoyre. <verse eid="NUM 8:2" /><verse number="3" style="v" sid="NUM 8:3" />un Aharon hot azoi geton: er hot ongetsundn di rerlech forent tsu fun der menoyre, azoi vi Hashem hot bafoiln Mosheen.<verse eid="NUM 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 8:4" />un azoi iz geven di arbet fun der menoyre: gehamert fun gold; biz oif ir fusgeshtel, biz oif ire blumen, iz zi geven gehamert; azoi vi di zeung vos Hashem hot bavizn Mosheen, azoi hot er gemacht di menoyre.<verse eid="NUM 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 8:5" /><verse number="6" style="v" sid="NUM 8:6" />nem di Leviim fun tsvishn di kinder fun Yisroel, un zolst zei reiniken. <verse eid="NUM 8:6" /><verse number="7" style="v" sid="NUM 8:7" />un azoi zolstu ton tsu zei, zei tsu reiniken: shprits oif zei vaser fun reinikung, un zei zoln ariberfirn a golmeser iber zeyer gantsn laib, un vashn zeyere kleider, un zich reiniken. <verse eid="NUM 8:7" /><verse number="8" style="v" sid="NUM 8:8" />un zei zoln nemen a yungen oks, un dos shpaizopfer dertsu fun zemelmel farmisht mit eil; un a tsveitn yungn oks zolstu nemen far a zindopfer. <verse eid="NUM 8:8" /><verse number="9" style="v" sid="NUM 8:9" />un zolst machn genenen di Leviim faran ohel-moed; un zolst ainzamlen di gantse eide fun di kinder fun Yisroel. <verse eid="NUM 8:9" /><verse number="10" style="v" sid="NUM 8:10" />un zolst machn genenen di Leviim far Hashem, un di kinder fun Yisroel zoln onlenen zeyere hent oif di Leviim. <verse eid="NUM 8:10" /><verse number="11" style="v" sid="NUM 8:11" />un Aharon zol oifheibn di Leviim an oifheibung far Hashem fun di kinder fun Yisroel, kedei zei zoln zain oif tsu dinen dem dinst fun Hashem. <verse eid="NUM 8:11" /><verse number="12" style="v" sid="NUM 8:12" />un di Leviim zoln onlenen zeyere hent oifn kop fun di oksen; un mach einem a zindopfer un einem a brandopfer tsu Hashem, mechaper tsu zain oif di Leviim. <verse eid="NUM 8:12" /><verse number="13" style="v" sid="NUM 8:13" />un zolst shteln di Leviim far Aharonen un far zaine zin, un zei oifheibn an oifheibung tsu Hashem.<verse eid="NUM 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 8:14" />un zolst opsheiden di Leviim fun tsvishn di kinder fun Yisroel, un di Leviim zoln gehern tsu mir. <verse eid="NUM 8:14" /><verse number="15" style="v" sid="NUM 8:15" />un dernoch zoln kumen di Leviim tsu badinen dem ohel-moed; un zolst zei reiniken, un zei oifheibn an oifheibung. <verse eid="NUM 8:15" /><verse number="16" style="v" sid="NUM 8:16" />vorem opgegebn zainen zei opgegebn tsu mir fun tsvishn di kinder fun Yisroel; anshtot itlechn vos efent dem tracht, itlechn bechor fun di kinder fun Yisroel, hob ich zei genumen far mir. <verse eid="NUM 8:16" /><verse number="17" style="v" sid="NUM 8:17" />vorem tsu mir gehert itlecher bechor tsvishn di kinder fun Yisroel, fun a mentshn oder fun a beheime; in dem tog vos ich hob dershlogn ale bechorim in land Mitsrayim, hob ich zei geheilikt tsu mir. <verse eid="NUM 8:17" /><verse number="18" style="v" sid="NUM 8:18" />un ich hob genumen di Leviim anshtot ale bechorim tsvishn di kinder fun Yisroel. <verse eid="NUM 8:18" /><verse number="19" style="v" sid="NUM 8:19" />un ich hob gegebn di Leviim opgegebene tsu Aharonen un tsu zaine kinder fun tsvishn di kinder fun Yisroel, tsu dinen dem dinst fun di kinder fun Yisroel in ohel-moed, un mechaper tsu zain oif di kinder fun Yisroel, kedei es zol nisht zain tsvishn di kinder fun Yisroel a plog, az di kinder fun Yisroel veln genenen tsum heiliktum.<verse eid="NUM 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20" />un Moshe un Aharon un di gantse eide fun di kinder fun Yisroel hobn azoi geton tsu di Leviim; azoi vi alts vos Hashem hot bafoiln Mosheen vegen di Leviim, azoi hobn di kinder fun Yisroel tsu zei geton.<verse eid="NUM 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 8:21" />un di Leviim hobn zich gereinikt, un hobn gevashn zeyere kleider; un Aharon hot zei oifgehoibn an oifheibung far Hashem, un Aharon hot mechaper geven oif zei, kedei zei tsu reiniken. <verse eid="NUM 8:21" /><verse number="22" style="v" sid="NUM 8:22" />un dernoch zainen gekumen di Leviim tsu dinen zeyer dinst in ohel-moed, unter Aharonen un unter zaine zin; azoi vi Hashem hot bafoiln Mosheen vegen di Leviim, azoi hobn zei tsu zei geton.<verse eid="NUM 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 8:23" /><verse number="24" style="v" sid="NUM 8:24" />dos iz vegen di Leviim: fun finf un tsvantsik yor alt un hecher zol er kumen tsu dinen dem dinst bai der arbet fun ohel-moed. <verse eid="NUM 8:24" /><verse number="25" style="v" sid="NUM 8:25" />un noch fuftsik yor alt zol er zich umkeren fun dem arbetdinst, un mer nisht dinen. <verse eid="NUM 8:25" /><verse number="26" style="v" sid="NUM 8:26" />nor er zol unterhelfn zaine brider in ohel-moed tsu hitn di hitung, ober kein dinst zol er mer nisht dinen. azoi zolstu ton mit di Leviim in zeyere hitungen.<verse eid="NUM 8:26" /></para>
  <chapter eid="NUM 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="NUM 9" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1" />un Hashem hot geredt tsu Mosheen in midber Sinai, in tsveitn yor noch zeyer aroisgein fun land Mitsrayim, in ershtn choidesh, azoi tsu zogn: <verse eid="NUM 9:1" /><verse number="2" style="v" sid="NUM 9:2" />di kinder fun Yisroel zoln machn dem korben-Pesach in zain geshtelter tsait. <verse eid="NUM 9:2" /><verse number="3" style="v" sid="NUM 9:3" />in fertsntn tog fun dem dozikn choidesh kegen ovnt, in zain geshtelter tsait zolt ir im machn; loit ale zaine dinim un loit ale zaine gezetsn zolt ir im machn.<verse eid="NUM 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 9:4" />hot Moshe geredt tsu di kinder fun Yisroel, tsu machn dem korben-Pesach. <verse eid="NUM 9:4" /><verse number="5" style="v" sid="NUM 9:5" />un zei hobn gemacht dem korben-Pesach in ershtn choidesh, in fertsntn tog fun choidesh kegen ovnt, in midber Sinai; azoi vi al vos Hashem hot bafoiln Mosheen, azoi hobn di kinder fun Yisroel geton.<verse eid="NUM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6" />ober es zainen geven mener vos zainen geven umrein fun dem toitn laib fun a mentshn, un zei hobn nisht gekent machn dem korben-Pesach in yenem tog; hobn zei genent far Mosheen un far Aharonen in yenem tog. <verse eid="NUM 9:6" /><verse number="7" style="v" sid="NUM 9:7" />un yene mener hobn tsu im gezogt: mir zainen umrein fun dem toitn laib fun a mentshn; far vos zoln mir geminert vern, nisht makrev tsu zain dem korben fun Hashem in zain geshtelter tsait tsvishn di kinder fun Yisroel? <verse eid="NUM 9:7" /><verse number="8" style="v" sid="NUM 9:8" />hot Moshe gezogt tsu zei: hart, un ich vel hern vos Hashem vet bafeln vegen aich.<verse eid="NUM 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 9:9" /><verse number="10" style="v" sid="NUM 9:10" />red tsu di kinder fun Yisroel, azoi tsu zogn: az emitser einer fun aich, oder fun aiere kumedike doires vet zain umrein fun a toitn laib, oder zain in a vaitn veg, zol er fun destvegn machn a korben-Pesach tsu Hashem. <verse eid="NUM 9:10" /><verse number="11" style="v" sid="NUM 9:11" />in tsveitn choidesh, in fertsntn tog, kegen ovnt zoln zei im machn; mit matsus un bitere kraitecher zoln zei im esen. <verse eid="NUM 9:11" /><verse number="12" style="v" sid="NUM 9:12" />zei zoln nisht iberlozen fun im biz in der peire, un a bein zoln zei nisht tsebrechn in im; loit dem gantsn din fun korben-Pesach zoln zei im machn. <verse eid="NUM 9:12" /><verse number="13" style="v" sid="NUM 9:13" />ober der man vos iz rein, un in veg iz er nisht, un er farmaidt zich tsu machn dem korben-Pesach, yene zel zol farshnitn vern fun ir folk; vail er hot dem korben fun Hashem nisht makrev geven in zain geshtelter tsait, zol yener man trogn zain zind.<verse eid="NUM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14" />un az bai aich vet zich oifhaltn a fremder, un er vet machn a korben-Pesach tsu Hashem, iz, azoi vi der din fun korben-Pesach un azoi vi zain gezets, azoi zol er ton; ein din zol zain bai aich i far dem fremdn, i far dem aingeborenem fun land.<verse eid="NUM 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15" />un in dem tog vos me hot oifgeshtelt dem mishkn, hot der volken tsugedekt dem mishkn, dos getselt fun tseignim; un in ovnt flegt zain ibern mishkn azoi vi dos oiszen fun faier, biz in der peire. <verse eid="NUM 9:15" /><verse number="16" style="v" sid="NUM 9:16" />azoi flegt zain tamid: der volken flegt im tsudekn, un dos oiszen fun faier bai nacht. <verse eid="NUM 9:16" /><verse number="17" style="v" sid="NUM 9:17" />un vedlik der volken flegt zich oifheibn fun ibern getselt, azoi flegn dernoch tsien di kinder fun Yisroel; un in dem ort vos der volken flegt dortn ruen, dortn flegn lagern di kinder fun Yisroel. <verse eid="NUM 9:17" /><verse number="18" style="v" sid="NUM 9:18" />loit dem moil fun Hashem flegn tsien di kinder fun Yisroel, un loit dem moil fun Hashem flegn zei lagern; kol-zman der volken flegt ruen oifn mishkn, flegn zei lagern. <verse eid="NUM 9:18" /><verse number="19" style="v" sid="NUM 9:19" />un az der volken hot zich farlengert oifn mishkn fil teg, hobn di kinder fun Yisroel gehit di hitung fun Hashem, un flegn nisht tsien. <verse eid="NUM 9:19" /><verse number="20" style="v" sid="NUM 9:20" />un a mol flegt der volken zain getseilte teg oifn mishkn; loit dem moil fun Hashem flegn zei lagern, un loit dem moil fun Hashem flegn zei tsien. <verse eid="NUM 9:20" /><verse number="21" style="v" sid="NUM 9:21" />un a mol flegt zain der volken fun ovnt biz in der peire, un vi der volken hot zich oifgehoibn in der peire, azoi hobn zei getsoign; oder a tog mit a nacht, un vi der volken hot zich oifgehoibn, azoi hobn zei getsoign. <verse eid="NUM 9:21" /><verse number="22" style="v" sid="NUM 9:22" />tsi tsvei teg, tsi a choidesh, tsi a yor – az der volken hot zich farlengert oifn mishkn tsu ruen oif im, flegn di kinder fun Yisroel lagern un nisht tsien, un vi er hot zich oifgehoibn, flegn zei tsien. <verse eid="NUM 9:22" /><verse number="23" style="v" sid="NUM 9:23" />loit dem moil fun Hashem flegn zei lagern, un loit dem moil fun Hashem flegn zei tsien; zei hobn gehit di hitung fun Hashem, loit dem moil fun Hashem durch Mosheen.<verse eid="NUM 9:23" /></para>
  <chapter eid="NUM 9" />
  <chapter number="10" style="c" pubnumber="י" sid="NUM 10" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 10:1" /><verse number="2" style="v" sid="NUM 10:2" />mach dir tsvei zilberne trumeitn; gehamert zolstu zei machn; un zei zoln dir zain far tsunoifrufn di eide, un far machn tsien di lagern. <verse eid="NUM 10:2" /><verse number="3" style="v" sid="NUM 10:3" />un az me vet blozn in zei, zol zich tsunoifkumen tsu dir di gantse eide tsum aingang fun ohel-moed. <verse eid="NUM 10:3" /><verse number="4" style="v" sid="NUM 10:4" />un oib me vet blozn in einem, zoln zich tsunoifkumen tsu dir di firshtn, di hoiptlait fun di toizntn fun Yisroel. <verse eid="NUM 10:4" /><verse number="5" style="v" sid="NUM 10:5" />un az ir vet blozn a shalruf, zoln tsien di lagern vos lagern tsu mizrech. <verse eid="NUM 10:5" /><verse number="6" style="v" sid="NUM 10:6" />un az ir vet blozn a tsveitn shalruf, zoln tsien di lagern vos lagern tsu dorem; a shalruf zol men blozn far zeyere tsiungen. <verse eid="NUM 10:6" /><verse number="7" style="v" sid="NUM 10:7" />ober baim ainzamlen di ainzamlung zolt ir blozn, ober nisht aroislozn a shalruf. <verse eid="NUM 10:7" /><verse number="8" style="v" sid="NUM 10:8" />un Aharons zin, di koyanim, zoln blozn in di trumeitn; un dos zol aich zain far an eibikn gezets oif aiere dor-doires. <verse eid="NUM 10:8" /><verse number="9" style="v" sid="NUM 10:9" />un az ir vet gein oif milchome in aier land akegn dem soine vos drikt aich, zolt ir shaln in di trumeitn, un ir vet dermont vern far Hashem Elokeichem, un vet geholfn vern fun aiere faint. <verse eid="NUM 10:9" /><verse number="10" style="v" sid="NUM 10:10" />un in aier tog fun simche, un in aiere yom-tuvim, un in aiere rosh-choideshn, zolt ir blozn in di trumeitn oif aiere brandopfer un oif aiere fridopfer; un zei veln aich zain tsu a dermonung far Elokeichem; ich bin Hashem Elokeichem.<verse eid="NUM 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11" />un es iz geven in tsveitn yor, in tsveitn choidesh, in tsvantsikstn tog fun choidesh, hot zich oifgehoibn der volken fun ibern mishkn fun tseignim. <verse eid="NUM 10:11" /><verse number="12" style="v" sid="NUM 10:12" />un di kinder fun Yisroel hobn getsoign oif zeyere tsiungen fun midber Sinai; un der volken hot gerut in midber Paran. <verse eid="NUM 10:12" /><verse number="13" style="v" sid="NUM 10:13" />azoi hobn zei getsoign tsum ershtn mol loit dem moil fun Hashem durch Mosheen. <verse eid="NUM 10:13" /><verse number="14" style="v" sid="NUM 10:14" />un tsuersht hot getsoign di fon fun dem lager fun di kinder fun Yehudah, loit zeyere machnus; un iber zain machne iz geven Nachshon der zun fun Amminadavn. <verse eid="NUM 10:14" /><verse number="15" style="v" sid="NUM 10:15" />un iber der machne fun dem sheyvet fun di kinder fun Yissachar, Netanel der zun fun Tsuarn. <verse eid="NUM 10:15" /><verse number="16" style="v" sid="NUM 10:16" />un iber der machne fun dem sheyvet fun di kinder fun Zevulun, Eliav der zun fun Chelonen. <verse eid="NUM 10:16" /><verse number="17" style="v" sid="NUM 10:17" />un az der mishkn iz funandergenumen gevorn, hobn getsoign di kinder fun Gershon, un di kinder fun Merari, di treger fun dem mishkn. <verse eid="NUM 10:17" /><verse number="18" style="v" sid="NUM 10:18" />un es hot getsoign di fon fun dem lager fun Reuven, loit zeyere machnus; un iber zain machne iz geven Elitsur der zun fun Shedeurn, <verse eid="NUM 10:18" /><verse number="19" style="v" sid="NUM 10:19" />un iber der machne fun dem sheyvet fun di kinder fun Shimeon, Shelumiel der zun fun Tsurishaddaien. <verse eid="NUM 10:19" /><verse number="20" style="v" sid="NUM 10:20" />un iber der machne fun dem sheyvet fun di kinder fun Gad, ElyaSaf der zun fun Deueln. <verse eid="NUM 10:20" /><verse number="21" style="v" sid="NUM 10:21" />un es hobn getsoign di Kehatim, di treger fun di heilike zachn; un me hot oifgeshtelt dem mishkn eider zei zainen gekumen. <verse eid="NUM 10:21" /><verse number="22" style="v" sid="NUM 10:22" />un es hot getsoign di fon fun dem lager fun di kinder fun Efrayim, loit zeyere machnus; un iber zain machne iz geven Elishama der zun fun Ammihudn. <verse eid="NUM 10:22" /><verse number="23" style="v" sid="NUM 10:23" />un iber der machne fun dem sheyvet fun di kinder fun Menasheh, Gamliel der zun fun Pedahtsurn. <verse eid="NUM 10:23" /><verse number="24" style="v" sid="NUM 10:24" />un iber der machne fun dem sheyvet fun di kinder fun Binyamin, Avidan der zun fun Gideonin. <verse eid="NUM 10:24" /><verse number="25" style="v" sid="NUM 10:25" />un es hot getsoign di fon fun dem lager fun di kinder fun Dan, di hintervach fun ale lagern loit zeyere machnus; un iber zain lager iz geven Achiezer der zun fun Ammishaddain. <verse eid="NUM 10:25" /><verse number="26" style="v" sid="NUM 10:26" />un iber der machne fun dem sheyvet fun di kinder fun Asher, Pagiel der zun fun Ochranen. <verse eid="NUM 10:26" /><verse number="27" style="v" sid="NUM 10:27" />un iber der machne fun dem sheyvet fun di kinder fun Naftali, Achira der zun fun Enanen. <verse eid="NUM 10:27" /><verse number="28" style="v" sid="NUM 10:28" />dos zainen di tsiungen fun di kinder fun Yisroel loit zeyere machnus; azoi hobn zei getsoign.<verse eid="NUM 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29" />un Moshe hot gezogt tsu Chovav dem zun fun Reuel dem Midyani, Moshes shver: mir tsien tsu dem ort vos Hashem hot gezogt: ich vel im gebn tsu aich; kum mit undz, un mir veln dich bagitikn, vorem Hashem hot tsugezogt guts far Yisroel. <verse eid="NUM 10:29" /><verse number="30" style="v" sid="NUM 10:30" />hot er tsu im gezogt: ich vel nisht gein; naiert tsu main land un tsu main opshtam vel ich gein. <verse eid="NUM 10:30" /><verse number="31" style="v" sid="NUM 10:31" />hot er gezogt: zolst undz nisht farlozen, ich bet dich; derfar vail du veist vu mir kenen lagern in midber, un vest undz zain far oign. <verse eid="NUM 10:31" /><verse number="32" style="v" sid="NUM 10:32" />un es vet zain, az du vest gein mit undz, iz, fun dem guts vos Hashem vet undz bagitikn, veln mir dich bagitikn.<verse eid="NUM 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33" />un zei hobn getsoign fun dem barg fun Hashem drai teg vegs, un der orn fun G-ts bris hot getsoign zei farois drai teg vegs, oistsuzuchn far zei a ruort. <verse eid="NUM 10:33" /><verse number="34" style="v" sid="NUM 10:34" />un der volken fun Hashem iz geven iber zei bai tog, ven zei hobn getsoign fun lager. <verse eid="NUM 10:34" /><verse number="35" style="v" sid="NUM 10:35" />un es iz geven, az der orn hot getsoign, hot Moshe gezogt: shtei oif, Hashem, un zoln tseshpreit vern daine faint, un zoln antloifn daine sonem far dir!<verse eid="NUM 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 10:36" />un az er hot gerut, hot er gezogt: ker ain, Hashem, tsu di tsentoizntn fun di mishpoches fun Yisroel!<verse eid="NUM 10:36" /></para>
  <chapter eid="NUM 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="NUM 11" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1" />un dos folk hot zich baklogt oif shlechts in di oiern fun Hashem, un Hashem hot gehert, un zain tsorn hot gegrimt, un a faier fun Hashem hot gebrent tsvishn zei, un hot fartsert baim ek lager. <verse eid="NUM 11:1" /><verse number="2" style="v" sid="NUM 11:2" />hot dos folk geshrien tsu Mosheen, un Moshe hot mispalel geven tsu Hashem, un dos faier hot zich gezetst. <verse eid="NUM 11:2" /><verse number="3" style="v" sid="NUM 11:3" />un me hot gerufn dem nomen fun yenem ort Taverah, vail a faier fun Hashem hot gebrent tsvishn zei.<verse eid="NUM 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4" />un di tsunoifgelofene vos tsvishn zei hobn geglust a glustung; un oich di kinder fun Yisroel hobn vider geveint, un zei hobn gezogt: ven me zol undz gebn esen fleish! <verse eid="NUM 11:4" /><verse number="5" style="v" sid="NUM 11:5" />mir gedenken di fish vos mir flegn esen in Mitsrayim umzist, di plutsern, un di kirbes, un dos grins, un di tsibeles, un di knobl. <verse eid="NUM 11:5" /><verse number="6" style="v" sid="NUM 11:6" />un atsund iz undzer zel fartriknt; nishto kein zach; bloiz oifn man zainen undzere oign.<verse eid="NUM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7" />un der man iz geven azoi vi korianderzomen, un zain onblik azoi vi der onblik fun bedolach. <verse eid="NUM 11:7" /><verse number="8" style="v" sid="NUM 11:8" />dos folk hot zich farshpreit, un hot es oifgeklibn, un gemoln in a hantmil, oder geshtoisn in a shteisl, un gekocht in a top, oder gemacht derfun kuchns un der tem derfun iz geven vi der tem fun an eilkichl. <verse eid="NUM 11:8" /><verse number="9" style="v" sid="NUM 11:9" />un vi der toi hot aropgenidert oifn lager bai nacht, flegt aropnideren deroif der man.<verse eid="NUM 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10" />un Moshe hot gehert dos folk veinen mishpoches-vaiz, itlecher far dem aingang fun zain getselt, un der tsorn fun Hashem hot zeyer gegrimt, un es iz geven shlecht in di oign fun Mosheen. <verse eid="NUM 11:10" /><verse number="11" style="v" sid="NUM 11:11" />un Moshe hot gezogt tsu Hashem: far vos tustu shlechts dain knecht, un far vos hob ich gefunen umchen in daine oign, aroiftsuleign oif mir di last fun dem dozikn gantsn folk? <verse eid="NUM 11:11" /><verse number="12" style="v" sid="NUM 11:12" />hob ich den getrogn dos dozike gantse folk, tsi ich hob es geborn, vos du zogst tsu mir: trog es in dain buzem, azoi vi a dertsier trogt a zoigedikn, tsu dem land vos du host tsugeshvorn zeyere eltern? <verse eid="NUM 11:12" /><verse number="13" style="v" sid="NUM 11:13" />fun vanen hob ich fleish, tsu gebn dem dozikn gantsn folk, vos zei veinen oif mir, azoi tsu zogn: gib undz fleish, mir zoln esen? <verse eid="NUM 11:13" /><verse number="14" style="v" sid="NUM 11:14" />ich alein ken nisht trogn dos dozike gantse folk, vorem es iz tsu shver far mir. <verse eid="NUM 11:14" /><verse number="15" style="v" sid="NUM 11:15" />un oib du tust azoi tsu mir, hargen herge mich, ich bet dich, oib ich hob gefunen chein in daine oign, un lomich nisht zen main umglik.<verse eid="NUM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16" />hot Hashem gezogt tsu Mosheen: zaml mir ain zibetsik man fun di eltste fun Yisroel, di vos du veist az zei zainen di eltste fun folk, un zaine oifzeers, un zolst zei nemen tsum ohel-moed, un zei zoln zich dortn shteln mit dir. <verse eid="NUM 11:16" /><verse number="17" style="v" sid="NUM 11:17" />un ich vel aropnideren, un vel dortn redn mit dir, un vel opsheiden fun dem ruach vos oif dir, un aroifton oif zei, un zei veln mittrogn mit dir di last fun folk, un vest nisht darfn trogn du alein. <verse eid="NUM 11:17" /><verse number="18" style="v" sid="NUM 11:18" />un tsum folk zolstu zogn: breit aich on oif morgn, un ir vet esen fleish; vail ir hot geveint in di oiern fun Hashem, azoi tsu zogn: ven me zol undz gebn esen fleish! vorem undz iz geven voil in Mitsrayim; derum vet aich Hashem gebn fleish, un ir vet esen. <verse eid="NUM 11:18" /><verse number="19" style="v" sid="NUM 11:19" />nisht ein tog vet ir esen, un nisht tsvei teg, un nisht finf teg, un nisht tsen teg, un nisht tsvantsik teg; <verse eid="NUM 11:19" /><verse number="20" style="v" sid="NUM 11:20" />biz a choidesh tsait, biz vanen es vet aich kern fun der noz, un vet aich zain tsum ekl; derfar vos ir hot faracht Hashem vos iz tsvishn aich, un hot geveint far im, azoi tsu zogn: noch vos gor zainen mir aroisgegangen fun Mitsrayim? <verse eid="NUM 11:20" /><verse number="21" style="v" sid="NUM 11:21" />hot Moshe gezogt: zeks hundert toiznt fusgeyer iz dos folk vos ich bin tsvishn im, un du zogst: ich vel zei gebn fleish, un zei veln esen a choidesh tsait. <verse eid="NUM 11:21" /><verse number="22" style="v" sid="NUM 11:22" />ven shof un rinder zoln geshochtn vern far zei, vet zei den klekn? az ale fishn fun yam zoln aingezamlt vern far zei, vet zei den klekn? <verse eid="NUM 11:22" /><verse number="23" style="v" sid="NUM 11:23" />hot Hashem gezogt tsu Mosheen: iz di hant fun Hashem kurts? atsund vestu zen, oib main vort vet dir geshen oder nisht.<verse eid="NUM 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24" />iz Moshe aroisgegangen, un hot geredt tsum folk di verter fun Hashem; un er hot aingezamlt zibetsik man fun di eltste fun folk, un zei geshtelt rund arum getselt. <verse eid="NUM 11:24" /><verse number="25" style="v" sid="NUM 11:25" />un Hashem hot aropgenidert in dem volken, un hot geredt tsu im, un hot genumen fun dem ruach vos oif im, un gegebn oif di zibetsik man, di eltste. un es iz geven, vi der ruach hot oif zei gerut, azoi hobn zei nevies gezogt; ober nisht mer.<verse eid="NUM 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26" />un tsvei mener zainen ibergebliben in lager, der nomen fun einem Eldad, un der nomen fun tsveitn Medad; hot oif zei oich gerut der ruach – un zei zainen geven tsvishn di farshribene, ober zei zainen nisht aroisgegangen tsum getselt – un zei hobn nevies gezogt in lager. <verse eid="NUM 11:26" /><verse number="27" style="v" sid="NUM 11:27" />iz gelofn der yung, un hot dertseilt Mosheen, un gezogt: Eldad un Medad zogn nevies in lager. <verse eid="NUM 11:27" /><verse number="28" style="v" sid="NUM 11:28" />hot zich opgerufn Yehoshua der zun fun Nun, Moshes badiner fun zain yugnt on, un hot gezogt: main har Moshe, halt zei tsurik. <verse eid="NUM 11:28" /><verse number="29" style="v" sid="NUM 11:29" />hot Moshe tsu im gezogt: nemstu zich on far mir? halevay zol dos gantse folk fun Hashem zain neviim, az Hashem zol gebn zain ruach oif zei! <verse eid="NUM 11:29" /><verse number="30" style="v" sid="NUM 11:30" />un Moshe iz tsurik arain in lager, er un di eltste fun Yisroel.<verse eid="NUM 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31" />un a vint hot aroisgetsoign fun Hashem, un hot gebracht tsuflien vachtlfoiglen fun yam, un hot zei tsevorfen lebn lager arum a tog vegs fun ein zait, un arum a tog vegs fun der ander zait, rund arum lager, un arum tsvei eiln ibern gezicht fun der erd. <verse eid="NUM 11:31" /><verse number="32" style="v" sid="NUM 11:32" />un dos folk iz oifgeshtanen yenem gantsn tog, un di gantse nacht, un dem gantsn morgedikn tog, un zei hobn oifgeklibn di vachtlfoiglen; der vos hot tsumindst geklibn hot oifgeklibn tsen hoifns; un zei hobn zei zich oisgeshpreit rund arum lager.<verse eid="NUM 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 11:33" />dos fleish iz noch geven tsvishn zeyere tseiner, eider es iz tsekait gevorn, azoi hot der tsorn fun Hashem gegrimt oifn folk, un Hashem hot geshlogn tsvishn dem folk zeyer a groisn shlak. <verse eid="NUM 11:33" /><verse number="34" style="v" sid="NUM 11:34" />un me hot gerufn dem nomen fun yenem ort Kivrot-Hataavah, vail dortn hot men bagrobn dos folk vos hot geglust.<verse eid="NUM 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 11:35" />fun Kivrot-Hataavah hot dos folk getsoign kein Chatserot; un zei zainen geblibn in Chatserot.<verse eid="NUM 11:35" /></para>
  <chapter eid="NUM 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="NUM 12" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1" />un Miryam un Aharon hobn geredt oif Mosheen fun vegen der Kushisher vaib vos er hot genumen; vorem er hot genumen a kushishe vaib. <verse eid="NUM 12:1" /><verse number="2" style="v" sid="NUM 12:2" />un zei hobn gezogt: tsi bloiz nor mit Mosheen hot Hashem geredt? hot er nisht oich mit undz geredt? un Hashem hot gehert.<verse eid="NUM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 12:3" />un der man Moshe iz geven zeyer an onev, mer fun ale mentshn vos oifn gezicht fun der erd.<verse eid="NUM 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 12:4" />hot Hashem plutsling gezogt tsu Mosheen un tsu Aharonen un tsu Miryamen: geit ir drai arois tsum ohel-moed. zainen zei drai aroisgegangen. <verse eid="NUM 12:4" /><verse number="5" style="v" sid="NUM 12:5" />un Hashem hot aropgenidert in a volknzail, un hot zich geshtelt baim aingang fun ohel-moed, un hot gerufn Aharonen un Miryamen. zainen zei beide aroisgegangen. <verse eid="NUM 12:5" /><verse number="6" style="v" sid="NUM 12:6" />un er hot gezogt: hert akorsht tsu maine verter: az a novi iz do bai aich, tu ich, Hashem, in a zeung zich derkenen tsu im; in a cholem red ich mit im. <verse eid="NUM 12:6" /><verse number="7" style="v" sid="NUM 12:7" />nisht azoi iz main knecht Moshe; in main gantsn hoiz iz er bagloibt. <verse eid="NUM 12:7" /><verse number="8" style="v" sid="NUM 12:8" />moil tsu moil red ich mit im, un bashaimperlech un nisht mit retenishn, un di geshtalt fun Hashem kukt er on. un vi azoi hot ir nisht moire gehat tsu redn oif main knecht, oif Mosheen? <verse eid="NUM 12:8" /><verse number="9" style="v" sid="NUM 12:9" />un der tsorn fun Hashem hot gegrimt oif zei; un er iz avekgegangen. <verse eid="NUM 12:9" /><verse number="10" style="v" sid="NUM 12:10" />un vi der volken hot zich opgeton fun ibern getselt, ersht Miryam iz Metsora vais vi shnei. un Aharon hot zich umgekert tsu Miryamen, ersht zi iz Metsora. <verse eid="NUM 12:10" /><verse number="11" style="v" sid="NUM 12:11" />hot Aharon gezogt tsu Mosheen: ich bet dich, main har, zolst nisht aroifton oif undz a zind, vos mir hobn zich banarisht un vos mir hobn gezindikt. <verse eid="NUM 12:11" /><verse number="12" style="v" sid="NUM 12:12" />zol zi, ich bet dich, nisht zain azoi vi a toitgeborener vos zain fleish iz halb gegesn ven er geit arois fun zain muters tracht. <verse eid="NUM 12:12" /><verse number="13" style="v" sid="NUM 12:13" />un Moshe hot geshrien tsu Hashem, azoi tsu zogn: G-t, ich bet dich, heil zi, ich bet dich. <verse eid="NUM 12:13" /><verse number="14" style="v" sid="NUM 12:14" />hot Hashem gezogt tsu Mosheen: az ir foter volt ir in ponem geshpign, volt zi zich nisht geshemt zibn teg? zol zi zain aingeshlosn zibn teg oisn lager, un dernoch zol zi araingenumen vern.<verse eid="NUM 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 12:15" />iz Miryam geven aingeshlosn oisn lager zibn teg; un dos folk hot nisht getsoign biz Miryam iz araingenumen gevorn. <verse eid="NUM 12:15" /><verse number="16" style="v" sid="NUM 12:16" />un dernoch hot dos folk getsoign fun Chatserot, un zei hobn gerut in midber Paran.<verse eid="NUM 12:16" /></para>
  <chapter eid="NUM 12" />
  <chapter number="13" style="c" pubnumber="יג" sid="NUM 13" />
  <para style="s1">Shlach</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 13:1" /><verse number="2" style="v" sid="NUM 13:2" />shik dir mentshn, zei zoln oiskukn dos land Kenaan, vos ich gib tsu di kinder fun Yisroel; tsu ein man, tsu ein man far zain fotershtam zolt ir shikn; itlecher a firsht tsvishn zei.<verse eid="NUM 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 13:3" />un Moshe hot zei geshikt fun midber Paran loit dem moil fun Hashem; zei ale zainen geven mentshn hoiptlait fun di kinder fun Yisroel. <verse eid="NUM 13:3" /><verse number="4" style="v" sid="NUM 13:4" />un dos zainen zeyere nemen: far sheyvet Reuven, Shammua der zun fun Zakurn. <verse eid="NUM 13:4" /><verse number="5" style="v" sid="NUM 13:5" />far sheyvet Shimeon, Shafat der zun fun Churai. <verse eid="NUM 13:5" /><verse number="6" style="v" sid="NUM 13:6" />far sheyvet Yehudah, Kalev der zun fun Yefunehn. <verse eid="NUM 13:6" /><verse number="7" style="v" sid="NUM 13:7" />far sheyvet Yissachar, Yigal der zun fun Yosefn. <verse eid="NUM 13:7" /><verse number="8" style="v" sid="NUM 13:8" />far sheyvet Efrayim, Hoshea der zun fun Nun. <verse eid="NUM 13:8" /><verse number="9" style="v" sid="NUM 13:9" />far sheyvet Binyamin, Palti der zun fun Rafuen. <verse eid="NUM 13:9" /><verse number="10" style="v" sid="NUM 13:10" />far sheyvet Zevulun, Gaddiel der zun fun Sodien. <verse eid="NUM 13:10" /><verse number="11" style="v" sid="NUM 13:11" />far sheyvet Yosef: far sheyvet Menasheh, Gadi der zun fun Susien. <verse eid="NUM 13:11" /><verse number="12" style="v" sid="NUM 13:12" />far sheyvet Dan, Ammiel der zun fun Gemalien. <verse eid="NUM 13:12" /><verse number="13" style="v" sid="NUM 13:13" />far sheyvet Asher, Setur der zun fun Michaeln. <verse eid="NUM 13:13" /><verse number="14" style="v" sid="NUM 13:14" />far sheyvet Naftali, Nachbi der zun fun Vofsien. <verse eid="NUM 13:14" /><verse number="15" style="v" sid="NUM 13:15" />far sheyvet Gad, Geuel der zun fun Machien. <verse eid="NUM 13:15" /><verse number="16" style="v" sid="NUM 13:16" />dos zainen di nemen fun di mentshn vos Moshe hot geshikt oiskukn dos land. un Moshe hot gerufn Hoshea dem zun fun Nun, Yehoshua. <verse eid="NUM 13:16" /><verse number="17" style="v" sid="NUM 13:17" />un Moshe hot zei geshikt oiskukn dos land Kenaan, un hot tsu zei gezogt: geit aroif ahin kein dorem, un geit aroif in dem geberg. <verse eid="NUM 13:17" /><verse number="18" style="v" sid="NUM 13:18" />un ir zolt onkukn dos land, vos dos iz, un dos folk vos zitst deroif, oib er iz shtark oder shvach, oib er iz vintsik oder fil; <verse eid="NUM 13:18" /><verse number="19" style="v" sid="NUM 13:19" />un vi iz dos land vos er zitst drinen, oib es iz gut oder shlecht, un vi zainen di shtet vos er zitst in zei, in lagern oder in festungen; <verse eid="NUM 13:19" /><verse number="20" style="v" sid="NUM 13:20" />un vi iz di erd, iz zi fet oder moger, iz do oif ir gehilts oder nisht. un ir zolt aich shtarkn, un brengen fun der frucht fun land. – un di teg zainen geven di teg fun ershte vaintroiben.<verse eid="NUM 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21" />zainen zei aroisgegangen, un hobn oisgekukt dos land fun midber Tsin biz Rechov, vi me kumt kein Chammat. <verse eid="NUM 13:21" /><verse number="22" style="v" sid="NUM 13:22" />un zei zainen aroifgegangen kein dorem, un zainen gekumen biz Chevron; un dortn zainen geven Achiman, Sheshai, un Talmai, kinder fun Anakim. – un Chevron iz geboit gevorn zibn yor far Tsoan in Mitsrayim. – <verse eid="NUM 13:22" /><verse number="23" style="v" sid="NUM 13:23" />un zei zainen gekumen bizn tal Eshcol, un hobn opgeshnitn fun dortn a tsvaig mit ein hengl vaintroiben, un hobn es getrogn oif a shtang zalbetsveit; oich fun di milgroimen un fun di faign hobn zei genumen. – <verse eid="NUM 13:23" /><verse number="24" style="v" sid="NUM 13:24" />yenem ort hot men gerufn der tal Eshcol fun vegen dem hengl vos di kinder fun Yisroel hobn opgeshnitn fun dortn. – <verse eid="NUM 13:24" /><verse number="25" style="v" sid="NUM 13:25" />un zei hobn zich umgekert fun oiskukn dos land tsum sof fun fertsik teg. <verse eid="NUM 13:25" /><verse number="26" style="v" sid="NUM 13:26" />un zei zainen gegangen un gekumen tsu Mosheen un tsu Aharonen, un tsu der gantser eide fun di kinder fun Yisroel, in midber Paran kein Kadesh; un zei hobn gebracht an entfer tsu zei un tsu der gantser eide, un hobn zei gevizn di frucht fun land. <verse eid="NUM 13:26" /><verse number="27" style="v" sid="NUM 13:27" />un zei hobn im dertseilt, un gezogt: mir zainen gekumen in dem land vuhin du host undz geshikt, un es flist oich mit milch un honik; un dos iz ir frucht. <verse eid="NUM 13:27" /><verse number="28" style="v" sid="NUM 13:28" />ober shtark iz dos folk vos zitst in land, un di shtet zainen bafestikte, groise biz gor, un oich di kinder fun Anakim hobn mir dortn gezen. <verse eid="NUM 13:28" /><verse number="29" style="v" sid="NUM 13:29" />Amalek zitst in dorem-land, un der Chitti, un der Yevusi, un der Emori, zitsn in dem geberg, un der Kenaani zitst baim yam un baim breg Yarden. <verse eid="NUM 13:29" /><verse number="30" style="v" sid="NUM 13:30" />hot Kalev aingeshtilt dos folk akegn Mosheen, un er hot gezogt: aroifgein veln mir aroifgein, un mir veln es arben, vorem baikumen veln mir es baikumen. <verse eid="NUM 13:30" /><verse number="31" style="v" sid="NUM 13:31" />ober di mentshn vos zainen aroifgegangen mit im, hobn gezogt: mir kenen nisht aroifgein kegen dem folk, vorem er iz shtarker fun undz. <verse eid="NUM 13:31" /><verse number="32" style="v" sid="NUM 13:32" />un zei hobn aroisgelozt a shlechtn klang oif dem land vos zei hobn es oisgekukt, bai di kinder fun Yisroel, azoi tsu zogn: dos land vos mir zainen durchgegangen durch dem, kedei es oistsukukn, dos iz a land vos est oif ire bavoiner, un dos gantse folk, vos mir hobn gezen drinen, zainen mentshn fun groisn vuks. <verse eid="NUM 13:32" /><verse number="33" style="v" sid="NUM 13:33" />un dortn hobn mir gezen di nefilim, di zin fun Anakim vos fun di nefilim; un mir zainen geven vi heisherikn in undzere oign, un azoi zainen mir geven in zeyere oign.<verse eid="NUM 13:33" /></para>
  <chapter eid="NUM 13" />
  <chapter number="14" style="c" pubnumber="יד" sid="NUM 14" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1" />hot di gantse eide oifgehoibn un aroisgelozt zeyer kol; un dos folk hot geveint in yener nacht. <verse eid="NUM 14:1" /><verse number="2" style="v" sid="NUM 14:2" />un ale kinder fun Yisroel hobn gemurmlt oif Mosheen un oif Aharonen, un di gantse eide hot tsu zei gezogt: halevay voltn mir geshtorbn in land Mitsrayim, oder halevay voltn mir geshtorbn in dem dozikn midber! <verse eid="NUM 14:2" /><verse number="3" style="v" sid="NUM 14:3" />un noch vos brengt undz Hashem in dem dozikn land, tsu faln durchn shverd, undzere vaiber un undzere kleine kinder zoln vern tsu roib? iz nisht beser far undz zich umtsukeren kein Mitsrayim? <verse eid="NUM 14:3" /><verse number="4" style="v" sid="NUM 14:4" />un zei hobn gezogt einer tsum andern: lomir machn a hoiptman, un zich umkeren kein Mitsrayim. <verse eid="NUM 14:4" /><verse number="5" style="v" sid="NUM 14:5" />zainen Moshe un Aharon gefaln oif zeyer ponem far der gantser ainzamlung fun der eide fun di kinder fun Yisroel. <verse eid="NUM 14:5" /><verse number="6" style="v" sid="NUM 14:6" />un Yehoshua der zun fun Nun, un Kalev der zun fun Yefunehn, fun di vos hobn oisgekukt dos land, hobn tserisn zeyere kleider, <verse eid="NUM 14:6" /><verse number="7" style="v" sid="NUM 14:7" />un hobn gezogt tsu der gantser eide fun di kinder fun Yisroel, azoi tsu zogn: dos land, vos mir zainen durchgegangen durch dem, kedei es oistsukukn, dos land iz zeyer zeyer gut. <verse eid="NUM 14:7" /><verse number="8" style="v" sid="NUM 14:8" />oib Hashem bagert undz, vet er undz brengen in dem dozikn land, un vet es undz gebn – a land vos zi flist mit milch un honik.<verse eid="NUM 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 14:9" />ir zolt nor nisht vidershpenikn on Hashem, un nisht moire hobn far dem folk fun land, vorem undzer broit zainen zei; zeyer shotn hot zich opgeton fun zei, un G-t iz mit undz; ir zolt nisht moire hobn far zei. <verse eid="NUM 14:9" /><verse number="10" style="v" sid="NUM 14:10" />hot di gantse eide gezogt, me zol zei farvorfen mit shteiner; ober di pracht fun Hashem hot zich bavizn in ohel-moed tsu ale kinder fun Yisroel.<verse eid="NUM 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 14:11" />un Hashem hot gezogt tsu Mosheen: biz vanen vet dos dozike folk mich lestern? un biz vanen veln zei nisht gloibn in mir, bai al di tseichns vos ich hob gemacht tsvishn im? <verse eid="NUM 14:11" /><verse number="12" style="v" sid="NUM 14:12" />ich vel im shlogn mit pest, un vel im oisrotn, un vel dich machn far a folk greser un machtiker fun im. <verse eid="NUM 14:12" /><verse number="13" style="v" sid="NUM 14:13" />hot Moshe gezogt tsu Hashem: az di Mitsrayim veln hern – vorem du host doch oifgebracht mit dain shtarkeit dos dozike folk fun tsvishn zei – <verse eid="NUM 14:13" /><verse number="14" style="v" sid="NUM 14:14" />veln zei zogn tsu di bavoiner fun dem dozikn land, vos hobn gehert az du, Hashem, bist tsvishn dem dozikn folk; vorem oig in oig bist du, Hashem, gezen gevorn, un dain volken shteit iber zei, un in a volknzail geistu zei farois bai tog, un in a faierzail bai nacht – <verse eid="NUM 14:14" /><verse number="15" style="v" sid="NUM 14:15" />iz, az du vest teitn dos dozike folk azoi vi ein man, azoi veln zogn di umes vos hobn gehert dain herung, azoi tsu zogn: <verse eid="NUM 14:15" /><verse number="16" style="v" sid="NUM 14:16" />vail Hashem iz nisht bichoiles tsu brengen dos dozike folk in dem land vos er hot zei tsugeshvorn, hot er zei oisgeshochtn in midber. <verse eid="NUM 14:16" /><verse number="17" style="v" sid="NUM 14:17" />derum zol atsund grois zain, ich bet dich, der koiech fun Adonoi loit vi du host geredt, azoi tsu zogn: <verse eid="NUM 14:17" /><verse number="18" style="v" sid="NUM 14:18" />Hashem iz aingehaltn in tsorn un raich in genod, er fartrogt zind un farbrechn, nor shenken shenkt er nisht; er rechnt zich far di zind fun di foters mit di kinder, mitn dritn un mitn firtn dor. <verse eid="NUM 14:18" /><verse number="19" style="v" sid="NUM 14:19" />fargib, ich bet dich, di zind fun dem dozikn folk, loit der groiskeit fun dain chesed, un azoi vi du host fargebn dem dozikn folk fun Mitsrayim un biz aher.<verse eid="NUM 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20" />hot Hashem gezogt: ich hob fargebn azoi vi dain vort. <verse eid="NUM 14:20" /><verse number="21" style="v" sid="NUM 14:21" />ober azoi vi ich leb, un di pracht fun Hashem iz ful di gantse erd, <verse eid="NUM 14:21" /><verse number="22" style="v" sid="NUM 14:22" />az di ale mentshn vos hobn gezen main pracht un maine tseichns, vos ich hob bavizn in Mitsrayim un in midber, un fun destvegn hobn zei mich gepruvet shoin tsen mol, un nisht tsugehert tsu main kol, <verse eid="NUM 14:22" /><verse number="23" style="v" sid="NUM 14:23" />oib zei veln zen dos land, vos ich hob tsugeshvorn zeyere eltern! yo, ale vos hobn mich gelestert, veln es nisht onzen. <verse eid="NUM 14:23" /><verse number="24" style="v" sid="NUM 14:24" />nor main knecht Kalev, vail in im iz geven an ander gaist, un er iz gegangen getrai noch mir, im vel ich brengen in dem land, vos er iz ahin gegangen, un tsu zain zomen vet er es lozn beyerushe. <verse eid="NUM 14:24" /><verse number="25" style="v" sid="NUM 14:25" />der Amaleki un der Kenaani zitsn in tal; morgn kert aich um, un tsit aich tsum midber oifn veg tsum Yam-Suf.<verse eid="NUM 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26" />un Hashem hot geredt tsu Mosheen un tsu Aharonen, azoi tsu zogn: <verse eid="NUM 14:26" /><verse number="27" style="v" sid="NUM 14:27" />biz vanen noch lozn di dozike beize eide vos murmlen akegn mir? ich hob gehert di murmleraien fun di kinder fun Yisroel, vos zei murmlen akegn mir. <verse eid="NUM 14:27" /><verse number="28" style="v" sid="NUM 14:28" />zog tsu zei: azoi vi ich leb, zogt Hashem, oib nisht vi ir hot geredt in maine oiern, azoi vel ich ton tsu aich! <verse eid="NUM 14:28" /><verse number="29" style="v" sid="NUM 14:29" />in dem dozikn midber veln faln aiere pegorim, un ale aiere getseilte, loit aier gantser tsol, fun tsvantsik yor alt un hecher, vail ir hot gemurmlt akegn mir. <verse eid="NUM 14:29" /><verse number="30" style="v" sid="NUM 14:30" />ir vet nisht kumen in dem land vos ich hob oifgehoibn main hant aich tsu machn ruen drinen, achuts Kalev der zun fun Yefunehn, un Yehoshua der zun fun Nun. <verse eid="NUM 14:30" /><verse number="31" style="v" sid="NUM 14:31" />un aiere kleine kinder vos ir hot gezogt, zei veln zain tsu roib, zei vel ich brengen ahin, un zei veln derkenen dos land, vos ir hot faracht. <verse eid="NUM 14:31" /><verse number="32" style="v" sid="NUM 14:32" />ober ir – aiere pegorim veln faln in dem dozikn midber. <verse eid="NUM 14:32" /><verse number="33" style="v" sid="NUM 14:33" />un aiere kinder veln umvandern in midber fertsik yor, un veln laidn far aiere opkerungen, biz aiere pegorim veln farlendt vern in midber. <verse eid="NUM 14:33" /><verse number="34" style="v" sid="NUM 14:34" />loit der tsol fun di teg vos ir hot oisgekukt dos land – fertsik teg, far a tog a yor, far a tog a yor, vet ir trogn aiere zind, fertsik yor; un ir vet dershpirn main umgenod. <verse eid="NUM 14:34" /><verse number="35" style="v" sid="NUM 14:35" />ich, Hashem, hob geredt; oib ich vel dos nisht ton tsu der doziker gantser beizer eide, vos hot zich aingezamlt akegn mir! in dem dozikn midber veln zei farlendt vern, un do veln zei shtarbn.<verse eid="NUM 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36" />un di mentshn vos Moshe hot geshikt oiskukn dos land, un zei zainen tsurikgekumen un hobn gemacht murmlen akegn im di gantse eide, mit aroislozn a shlechtn klang oifn land – <verse eid="NUM 14:36" /><verse number="37" style="v" sid="NUM 14:37" />di mentshn vos hobn aroisgelozt dem shlechtn klang oifn land, zainen geshtorbn in a mageyfe far Hashem. <verse eid="NUM 14:37" /><verse number="38" style="v" sid="NUM 14:38" />nor Yehoshua der zun fun Nun, un Kalev der zun fun Yefunehn, zainen geblibn lebn fun yene mentshn, vos zainen gegangen oiskukn dos land.<verse eid="NUM 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39" />un Moshe hot geredt di dozike verter tsu ale kinder fun Yisroel, un dos folk hot zeyer getroiert. <verse eid="NUM 14:39" /><verse number="40" style="v" sid="NUM 14:40" />un zei hobn zich gefedert in der peire, un zainen aroifgegangen oifn shpits barg, azoi tsu zogn: ot zainen mir, un mir veln aroifgein tsu dem ort vos Hashem hot gezogt; vorem mir hobn gezindikt. <verse eid="NUM 14:40" /><verse number="41" style="v" sid="NUM 14:41" />hot Moshe gezogt: noch vos den tret ir iber dem bafel fun Hashem, az dos vet nisht baglikn? <verse eid="NUM 14:41" /><verse number="42" style="v" sid="NUM 14:42" />ir zolt nisht aroifgein, az Hashem iz nisht tsvishn aich, kedei ir zolt nisht geshlogn vern far aiere faint. <verse eid="NUM 14:42" /><verse number="43" style="v" sid="NUM 14:43" />vorem der Amaleki un der Kenaani zainen dortn far aich, un ir vet faln durchn shverd; vorem azoi vi ir hot aich opgekert fun hinter Hashem, vet G-t nisht zain mit aich.<verse eid="NUM 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44" />ober zei hobn zich dervegt aroiftsugein oifn shpits barg; nor der orn fun Hashems bris un Moshe hobn zich nisht gerirt fun lager.<verse eid="NUM 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="NUM 14:45" />un der Amaleki un der Kenaani, vos zainen gezesn oif yenem barg, hobn aropgenidert, un hobn zei geshlogn un zei tseklapt biz Chormah.<verse eid="NUM 14:45" /></para>
  <chapter eid="NUM 14" />
  <chapter number="15" style="c" pubnumber="טו" sid="NUM 15" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 15:1" /><verse number="2" style="v" sid="NUM 15:2" />red tsu di kinder fun Yisroel, un zolst zogn tsu zei: az ir vet kumen in dem land fun aier bazetsung vos ich gib aich, <verse eid="NUM 15:2" /><verse number="3" style="v" sid="NUM 15:3" />un ir vet machn a faieropfer tsu Hashem, a brandopfer oder a shlachtopfer, loit a klor aroisgeredtn neyder, oder vi a fraivilike nedoves, oder in aiere yom-tuvim, kedei tsu machn a geshmakn reyech tsu Hashem, fun rinder oder fun shof, <verse eid="NUM 15:3" /><verse number="4" style="v" sid="NUM 15:4" />zol der vos brengt zain korben tsu Hashem, brengen a shpaizopfer fun a tsentl eife zemelmel farmisht mit a fertl hin eil; <verse eid="NUM 15:4" /><verse number="5" style="v" sid="NUM 15:5" />un vain far a gisopfer, a fertl hin, zolstu machn mitn brandopfer oder tsum shlachtopfer, far itlechn sheps. <verse eid="NUM 15:5" /><verse number="6" style="v" sid="NUM 15:6" />oib tsu a vider, zolstu machn a shpaizopfer fun tsvei tsentl zemelmel farmisht mit eil a dritel hin; <verse eid="NUM 15:6" /><verse number="7" style="v" sid="NUM 15:7" />un vain far a gisopfer, a dritel hin, zolstu brengen far a geshmakn reyech tsu Hashem. <verse eid="NUM 15:7" /><verse number="8" style="v" sid="NUM 15:8" />un az du vest machn a yung rind far a brandopfer oder a shlachtopfer, loit a klor aroisgeredtn neyder, oder far a fridopfer tsu Hashem, <verse eid="NUM 15:8" /><verse number="9" style="v" sid="NUM 15:9" />zol men brengen mitn yungn rind a shpaizopfer fun drai tsentl zemelmel farmisht mit eil a halbn hin; <verse eid="NUM 15:9" /><verse number="10" style="v" sid="NUM 15:10" />un vain zolstu brengen far a gisopfer a halbn hin, a faieropfer far a geshmakn reyech tsu Hashem. <verse eid="NUM 15:10" /><verse number="11" style="v" sid="NUM 15:11" />azoi zol geton vern tsu itlechn oks, oder tsu itlechn vider, oder tsu a lam fun shepsn oder fun tsign. <verse eid="NUM 15:11" /><verse number="12" style="v" sid="NUM 15:12" />vi noch der tsol vos ir vet machn; azoi zolt ir ton tsu itlechn, loit zeyer tsol. <verse eid="NUM 15:12" /><verse number="13" style="v" sid="NUM 15:13" />yetveder aingeborener zol azoi machn di dozike, baim brengen a faieropfer far a geshmakn reyech tsu Hashem. <verse eid="NUM 15:13" /><verse number="14" style="v" sid="NUM 15:14" />un az bai aich vet zich oifhaltn a fremder, oder ver nor es vet zain tsvishn aich, in aiere dor-doires, un er vet machn a faieropfer far a geshmakn reyech tsu Hashem, zol er ton azoi vi ir tut. <verse eid="NUM 15:14" /><verse number="15" style="v" sid="NUM 15:15" />kahal! ein gezets zol zain far aich un far dem fremdn vos halt zich oif, an eibik gezets oif aiere dor-doires; vi ir, azoi zol zain der fremder far Hashem. <verse eid="NUM 15:15" /><verse number="16" style="v" sid="NUM 15:16" />ein toyre un ein din zol zain far aich un far dem fremdn vos halt zich oif bai aich.<verse eid="NUM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 15:17" /><verse number="18" style="v" sid="NUM 15:18" />red tsu di kinder fun Yisroel, un zolst zogn tsu zei: az ir kumt in dem land vos ich breng aich ahin, <verse eid="NUM 15:18" /><verse number="19" style="v" sid="NUM 15:19" />iz, az ir est fun dem broit fun land, zolt ir opsheiden an opsheidung tsu Hashem. <verse eid="NUM 15:19" /><verse number="20" style="v" sid="NUM 15:20" />dos ershte fun aiere teigmulters zolt ir opsheiden a chale far an opsheidung; vi di opsheidung fun dresh-shaier, azoi zolt ir es opsheiden. <verse eid="NUM 15:20" /><verse number="21" style="v" sid="NUM 15:21" />fun dem ershtn fun aiere teigmulters zolt ir gebn an opsheidung tsu Hashem oif aiere dor-doires.<verse eid="NUM 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22" />un az ir vet farzen, un ir vet nisht ton ale di dozike gebot vos Hashem hot ongezogt Mosheen, <verse eid="NUM 15:22" /><verse number="23" style="v" sid="NUM 15:23" />alts vos Hashem hot aich bafoiln durch Mosheen, fun dem tog vos Hashem hot es bafoiln un vaiter, oif aiere dor-doires, <verse eid="NUM 15:23" /><verse number="24" style="v" sid="NUM 15:24" />iz, oib es iz, farhoiln fun di oign fun der eide, geton gevorn durch a farze, zol di gantse eide machn ein yungn oks far a brandopfer, far a geshmakn reyech tsu Hashem, mit zain shpaizopfer un zain gisopfer, azoi vi der din; un ein tsignbok far a zindopfer. <verse eid="NUM 15:24" /><verse number="25" style="v" sid="NUM 15:25" />un der koyen zol mechaper zain oif der gantser eide fun di kinder fun Yisroel, un zei zol fargebn vern, vail a farze iz dos, un zei hobn gebracht zeyer korben, a faieropfer tsu Hashem, un zeyer zindopfer far Hashem, far zeyer farze. <verse eid="NUM 15:25" /><verse number="26" style="v" sid="NUM 15:26" />un der gantser eide fun di kinder fun Yisroel, un dem fremdn vos halt zich oif tsvishn zei, vet fargebn vern, vorem bai dem gantsn folk iz dos geven durch a farze.<verse eid="NUM 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27" />oib ober an eintslner mentsh vet zindikn durch a farze, zol er brengen a yorike tsig far a zindopfer. <verse eid="NUM 15:27" /><verse number="28" style="v" sid="NUM 15:28" />un der koyen zol mechaper zain oif dem mentshn vos farzet, ven er zindikt durch a farze far Hashem; kedei mechaper tsu zain oif im, az im zol fargebn vern. <verse eid="NUM 15:28" /><verse number="29" style="v" sid="NUM 15:29" />far dem aingeborenem tsvishn di kinder fun Yisroel, un far dem fremdn vos halt zich oif tsvishn zei – ein gezets zol zain bai aich far dem vos tut epes durch a farze.<verse eid="NUM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30" />ober der mentsh vos tut mit a hoicher hant, fun di aingeborene, oder fun di fremde, lestert er Hashem, un yene zel zol farshnitn vern fun tsvishn ir folk. <verse eid="NUM 15:30" /><verse number="31" style="v" sid="NUM 15:31" />vorem dos vort fun Hashem hot er faracht, un zain gebot hot er farshtert; farshnitn muz farshnitn vern yene zel, ir zind iz oif ir.<verse eid="NUM 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32" />un ven di kinder fun Yisroel zainen geven in der midber, hobn zei gefunen a man klaibndik holts um Shabbos. <verse eid="NUM 15:32" /><verse number="33" style="v" sid="NUM 15:33" />hobn di vos hobn im gefunen klaibndik holts, im gebracht tsu Mosheen un tsu Aharonen un tsu der gantser eide. <verse eid="NUM 15:33" /><verse number="34" style="v" sid="NUM 15:34" />un me hot im araingezetst in vach, vorem es iz nisht basheidt gevorn vos im zol geton vern. <verse eid="NUM 15:34" /><verse number="35" style="v" sid="NUM 15:35" />hot Hashem gezogt tsu Mosheen: teitn zol geteit vern der man; di gantse eide zol im farvorfen mit shteiner oisn lager. <verse eid="NUM 15:35" /><verse number="36" style="v" sid="NUM 15:36" />un di gantse eide hot im aroisgefirt oisn lager, un zei hobn im farvorfen mit shteiner, un er iz geshtorbn; azoi vi Hashem hot bafoiln Mosheen.<verse eid="NUM 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37" />un Hashem hot gezogt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 15:37" /><verse number="38" style="v" sid="NUM 15:38" />red tsu di kinder fun Yisroel, un zolst zogn tsu zei, zei zoln zich machn tsitsit oif di ekn fun zeyere kleider, oif zeyere dor-doires; un zei zoln arainton in di tsitsit fun ek kleid a bloen fodem. <verse eid="NUM 15:38" /><verse number="39" style="v" sid="NUM 15:39" />un dos zol aich zain far tsitsiyot, az ir zolt es zen, un gedenken ale gebot fun Hashem, un zei ton, un ir zolt nisht nochgein noch aier hartsn un noch aiere oign, vos ir zait farfirt noch zei; <verse eid="NUM 15:39" /><verse number="40" style="v" sid="NUM 15:40" />kedei ir zolt gedenken un ton ale maine gebot, un zain heilik tsu Elokeichem. <verse eid="NUM 15:40" /><verse number="41" style="v" sid="NUM 15:41" />ich bin Hashem Elokeichem vos hot aich aroisgetsoign fun dem land Mitsrayim, aich tsu zain tsum Elokim: ich bin Hashem Elokeichem.<verse eid="NUM 15:41" /></para>
  <chapter eid="NUM 15" />
  <chapter number="16" style="c" pubnumber="טז" sid="NUM 16" />
  <para style="s1">Korach</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1" />un Korach der zun fun Yitshar, dem zun fun Kohat, dem zun fun Levin, un Dotan un Aviram, di zin fun Eliavn, un On der zun fun Peletn, kinder fun Reuven, hobn genumen, <verse eid="NUM 16:1" /><verse number="2" style="v" sid="NUM 16:2" />un zich geshtelt far Mosheen mit tsvei hundert un fuftsik man fun di kinder fun Yisroel, firshtn fun der eide, gerufene fun der ainzamlung, mentshn mit a nomen. <verse eid="NUM 16:2" /><verse number="3" style="v" sid="NUM 16:3" />un zei hobn zich aingezamlt akegn Mosheen un akegn Aharonen, un hobn tsu zei gezogt: genug aich! vorem di gantse eide zainen ale heilik, un Hashem iz tsvishn zei, un far vos nemt ir zich iber akegn dem kahal fun Hashem? <verse eid="NUM 16:3" /><verse number="4" style="v" sid="NUM 16:4" />un vi Moshe hot es gehert, azoi iz er gefaln oif zain ponem. <verse eid="NUM 16:4" /><verse number="5" style="v" sid="NUM 16:5" />un er hot geredt tsu Korachn un tsu zain gantsn gezeml, azoi tsu zogn: in der peire vet Hashem lozn visen, ver es iz zainer, un dem vos iz heilik, vet er machn genenen tsu zich; yo, dem vemen er vet oisderveilen, vet er machn genenen tsu zich. <verse eid="NUM 16:5" /><verse number="6" style="v" sid="NUM 16:6" />dos tut: nemt aich faierfanen, Korach mit zain gantsn gezeml, <verse eid="NUM 16:6" /><verse number="7" style="v" sid="NUM 16:7" />un leigt arain in zei faier, un tut oif zei aroif vairech far Hashem, morgn; un es vet zain, der man vos Hashem vet oisderveilen, er iz der heiliker. genug aich, kinder fun Levi!<verse eid="NUM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8" />un Moshe hot gezogt tsu Korachn: hert akorsht, kinder fun Levi.<verse eid="NUM 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 16:9" />vintsik aich vos der Elokei Yisroel hot aich opgesheidt fun tsvishn der eide fun di kinder fun Yisroel, aich tsu machn genenen tsu zich, tsu dinen dem dinst fun mishkn fun Hashem, un tsu shtein far der eide, zei tsu badinen – <verse eid="NUM 16:9" /><verse number="10" style="v" sid="NUM 16:10" />vos er hot gemacht genenen dich un ale daine brider, di kinder fun Levi, mit dir, az ir farlangt oich di kehune? <verse eid="NUM 16:10" /><verse number="11" style="v" sid="NUM 16:11" />far vor, du mit dain gantsn gezeml, dos zait ir aingezamlt akegn Hashem; vorem vos iz Aharon, az ir zolt murmlen akegn im?<verse eid="NUM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12" />un Moshe hot geshikt rufn Dotan un Aviram, di zin fun Eliavn; ober zei hobn gezogt: mir veln nisht aroifkumen. <verse eid="NUM 16:12" /><verse number="13" style="v" sid="NUM 16:13" />vintsik vos du host undz oifgebracht fun a land vos flist mit milch un honik, undz tsu teitn in der midber, az hersheven vilstu noch hersheven iber undz? <verse eid="NUM 16:13" /><verse number="14" style="v" sid="NUM 16:14" />yo, host undz nisht gebracht in a land vos flist mit milch un honik, oder undz gegebn a nachle fun feld un vaingorten. vilstu di dozike mentshn di oign oisshtechn? mir veln nisht aroifkumen. <verse eid="NUM 16:14" /><verse number="15" style="v" sid="NUM 16:15" />hot Mosheen zeyer geergert, un er hot gezogt tsu Hashem: zolst zich nisht kern tsu zeyer minche; nisht an eintsikn eizl hob ich genumen fun zei, un nisht ich hob shlechts geton an eintsikn fun zei.<verse eid="NUM 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16" />un Moshe hot gezogt tsu Korachn: du mit dain gantsn gezeml zait far Hashem morgn, du un zei, un Aharon. <verse eid="NUM 16:16" /><verse number="17" style="v" sid="NUM 16:17" />un nemt itlecher zain faierfan, un ir zolt aroifleigen deroif vairech, un brengen far Hashem itlecher zain faierfan, tsvei hundert un fuftsik faierfanen; oich du un Aharon, itlecher zain faierfan.<verse eid="NUM 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 16:18" />hobn zei genumen itlecher zain faierfan, un zei hobn aroifgeleigt oif zei faier, un aroifgeton oif zei vairech, un zei hobn zich geshtelt baim aingang fun ohel-moed mit Mosheen un Aharonen. <verse eid="NUM 16:18" /><verse number="19" style="v" sid="NUM 16:19" />un Korach hot aingezamlt akegn zei di gantse eide tsum aingang fun ohel-moed; un di pracht fun Hashem hot zich bavizn tsu der gantser eide.<verse eid="NUM 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 16:20" />un Hashem hot geredt tsu Mosheen un tsu Aharonen, azoi tsu zogn: <verse eid="NUM 16:20" /><verse number="21" style="v" sid="NUM 16:21" />sheidt aich op fun tsvishn der doziker eide, un ich vel zei farlendn in a rege. <verse eid="NUM 16:21" /><verse number="22" style="v" sid="NUM 16:22" />zainen zei gefaln oif zeyer ponem, un hobn gezogt: o El, der G-t fun di gaister fun ale fleish, zol ein mentsh zindikn, un oif der gantser eide zolstu tserenen?<verse eid="NUM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23" />hot Hashem geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 16:23" /><verse number="24" style="v" sid="NUM 16:24" />red tsu der eide, azoi tsu zogn: tsit op fun arum der voinung fun Korachn, Dotanen, un Aviramen. <verse eid="NUM 16:24" /><verse number="25" style="v" sid="NUM 16:25" />iz Moshe oifgeshtanen un iz gegangen tsu Dotanen un Aviramen, un noch im zainen gegangen di eltste fun Yisroel.<verse eid="NUM 16:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 16:26" />un er hot geredt tsu der eide, azoi tsu zogn: tret op, ich bet aich, fun lebn di getseltn fun di dozike shlechte mentshn, un ir zolt zich nisht onrirn on alts vos iz zeyers, kedei ir zolt nisht umgebracht vern durch ale zeyere zind. <verse eid="NUM 16:26" /><verse number="27" style="v" sid="NUM 16:27" />hobn zei opgetsoign fun der voinung fun Korachn, Dotanen, un Aviramen, fun rund arum; un Dotan un Aviram zainen aroisgegangen, zich shtelendik in aingang fun zeyere getseltn, mit zeyere vaiber un zeyere zin un zeyere kleine kinder. <verse eid="NUM 16:27" /><verse number="28" style="v" sid="NUM 16:28" />hot Moshe gezogt: durch dem vet ir visen, az Hashem hot mich geshikt tsu ton ale di dozike tuungen, az dos iz nisht fun main hartsn. <verse eid="NUM 16:28" /><verse number="29" style="v" sid="NUM 16:29" />oib azoi vi ale mentshn shtarbn, veln di dozike shtarbn, un di basherung fun ale mentshn vet zei bashert zain, hot mich Hashem nisht geshikt. <verse eid="NUM 16:29" /><verse number="30" style="v" sid="NUM 16:30" />oib ober a bashafung vet bashafn Hashem, un di erd vet oifmachn ir moil, un vet ainshlingen zei un alts vos iz zeyers, un zei veln aropnideren lebedikerheit in Sheol, vet ir visen, az di dozike mentshn hobn gelestert Hashem.<verse eid="NUM 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31" />un es iz geven vi er hot geendikt redn ale di dozike verter, azoi hot zich oifgeshpoltn di erd vos unter zei. <verse eid="NUM 16:31" /><verse number="32" style="v" sid="NUM 16:32" />un di erd hot geefent ir moil, un hot aingeshlungen zei, un zeyere haizer, un ale mentshn vos hobn gehert tsu Korachn, un dem gantsn farmeg. <verse eid="NUM 16:32" /><verse number="33" style="v" sid="NUM 16:33" />un zei un alts vos iz zeyers hobn aropgenidert lebedikerheit in Sheol, un di erd hot zei tsugedekt, un zei zainen untergegangen fun tsvishn der eide.<verse eid="NUM 16:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 16:34" />un gants Yisroel vos rund arum zei zainen antlofn fun zeyere koiles, vorem zei hobn gezogt: di erd vet undz noch ainshlingen. <verse eid="NUM 16:34" /><verse number="35" style="v" sid="NUM 16:35" />un a faier iz aroisgegangen fun Hashem, un hot fartsert di tsvei hundert un fuftsik man, vos hobn oifgebracht dem vairech.<verse eid="NUM 16:35" /></para>
  <chapter eid="NUM 16" />
  <chapter number="17" style="c" pubnumber="יז" sid="NUM 17" />
  <para style="p">
    <verse number="1" style="v" pubnumber="16.36" sid="NUM 17:1" /> un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 17:1" /><verse number="2" style="v" pubnumber="16.37" sid="NUM 17:2" /> zog tsu Elazar dem zun fun Aharon dem koyen, er zol oifheibn di faierfanen fun tsvishn der farbrenung, un dos faier vorf avek; vorem zei zainen gevorn heilik. <verse eid="NUM 17:2" /><verse number="3" style="v" pubnumber="16.38" sid="NUM 17:3" /> di faierfanen fun di dozike, vos hobn farzindikt zeyere nefoshes, fun zei zol men machn oisgeshlogene blechn, an ibertsug tsum mizbeyech, vorem me hot zei gebracht far Hashem, un zei zainen gevorn heilik; un zei zoln zain far a tseichn tsu di kinder fun Yisroel. <verse eid="NUM 17:3" /><verse number="4" style="v" pubnumber="16.39" sid="NUM 17:4" /> hot Elazar der koyen genumen di kuperne faierfanen, vos di farbrente hobn gebracht, un me hot zei oisgeshlogn far an ibertsug tsum mizbeyech, <verse eid="NUM 17:4" /><verse number="5" style="v" pubnumber="16.40" sid="NUM 17:5" /> a dermonung tsi di kinder fun Yisroel, kedei a fremder mentsh, vos iz nisht fun dem zomen fun Aharon, zol nisht genenen tsu reichern vairech far Hashem, az er zol nisht vern azoi vi Korach un azoi vi zain gezeml; azoi vi Hashem hot geredt tsu im durch Mosheen.<verse eid="NUM 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="16.41" sid="NUM 17:6" /> un di gantse eide fun di kinder fun Yisroel hot oif morgn gemurmlt akegn Mosheen un akegn Aharonen, azoi tsu zogn: ir hot geteit dos folk fun Hashem. <verse eid="NUM 17:6" /><verse number="7" style="v" pubnumber="16.42" sid="NUM 17:7" /> un es iz geven, az di eide hot zich aingezamlt akegn Mosheen un akegn Aharonen, azoi hobn zei zich umgekert tsum ohel-moed, ersht a volken hot im tsugedekt, un di pracht fun Hashem hot zich bavizn. <verse eid="NUM 17:7" /><verse number="8" style="v" pubnumber="16.43" sid="NUM 17:8" /> un Moshe un Aharon zainen tsugegangen faran ohel-moed, <verse eid="NUM 17:8" /><verse number="9" style="v" pubnumber="16.44" sid="NUM 17:9" /> un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 17:9" /><verse number="10" style="v" pubnumber="16.45" sid="NUM 17:10" /> sheidt aich op fun tsvishn der doziker eide, un ich vel zei farlendn in a rege. zainen zei gefaln oif zeyer ponem. <verse eid="NUM 17:10" /><verse number="11" style="v" pubnumber="16.46" sid="NUM 17:11" /> un Moshe hot gezogt tsu Aharonen: nem di faierfan, un leig oif ir aroif faier fun mizbeyech, un tu aroif vairech, un trog oif gich tsu der eide, un zai mechaper oif zei, vorem a tsorn iz aroisgegangen fun far Hashem; di mageyfe hot zich ongehoibn. <verse eid="NUM 17:11" /><verse number="12" style="v" pubnumber="16.47" sid="NUM 17:12" /> hot Aharon genumen, azoi vi Moshe hot geheisn, un er iz araingelofn in mitn fun der eide; ersht di mageyfe hot zich ongehoibn in folk. hot er aroifgeleigt vairech, un mechaper geven oifn folk. <verse eid="NUM 17:12" /><verse number="13" style="v" pubnumber="16.48" sid="NUM 17:13" /> un er iz geshtanen tsvishn di toite un tsvishn di lebedike; un di mageyfe iz farhaltn gevorn. <verse eid="NUM 17:13" /><verse number="14" style="v" pubnumber="16.49" sid="NUM 17:14" /> un di vos zainen geshtorbn in der mageyfe, zainen geven fertsn toiznt un zibn hundert, achuts di vos zainen geshtorbn vegen der meise mit Korachn. <verse eid="NUM 17:14" /><verse number="15" style="v" pubnumber="16.50" sid="NUM 17:15" /> un Aharon hot zich umgekert tsu Mosheen, tsum aingang fun ohel-moed, ven di mageyfe iz farhaltn gevorn.<verse eid="NUM 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="17:1" sid="NUM 17:16" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 17:16" /><verse number="17" style="v" altnumber="2" sid="NUM 17:17" />red tsu di kinder fun Yisroel, un nem fun zei tsu shtekn, tsu shtekn fun a foterhoiz, fun ale zeyere firshtn loit zeyere foterhaizer, tsvelf shtekens; itlechns nomen zolstu oifshraibn oif zain shtekn. <verse eid="NUM 17:17" /><verse number="18" style="v" altnumber="3" sid="NUM 17:18" />un Aharons nomen zolstu oifshraibn oif dem shtekn fun Levi, vorem ein shtekn zol zain far dem hoipt fun zeyere foterhaizer. <verse eid="NUM 17:18" /><verse number="19" style="v" altnumber="4" sid="NUM 17:19" />un zolst zei avekleigen in ohel-moed, faran tseignim, vos ich antplek zich tsu aich dortn. <verse eid="NUM 17:19" /><verse number="20" style="v" altnumber="5" sid="NUM 17:20" />un es vet zain, der man vos ich vel im oisderveilen, vet zain shtekn oifshprotsn; un ich vel ainshtiln fun arum mir di murmleraien fun di kinder fun Yisroel, vos zei murmlen akegn aich.<verse eid="NUM 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" altnumber="6" sid="NUM 17:21" /> hot Moshe geredt tsu di kinder fun Yisroel, un ale zeyere firshtn hobn im gegebn tsu shtekn fun itlechn firsht, tsu shtekn fun itlechn firsht, loit zeyere foterhaizer, tsvelf shtekens; un der shtekn fun Aharonen iz geven tsvishn zeyere shtekens. <verse eid="NUM 17:21" /><verse number="22" style="v" altnumber="7" sid="NUM 17:22" />un Moshe hot avekgeleigt di shtekens far Hashem, in dem getselt fun tseignim. <verse eid="NUM 17:22" /><verse number="23" style="v" altnumber="8" sid="NUM 17:23" />un es iz geven oif morgn, az Moshe iz gekumen in dem getselt fun tseignim, ersht der shtekn fun Aharonen far Levis hoiz hot oifgeshprotst, un aroisgelozt shprotsung, un geblit bliechts, un getsaitikt mandlen. <verse eid="NUM 17:23" /><verse number="24" style="v" altnumber="9" sid="NUM 17:24" />hot Moshe aroisgetrogn ale shtekens fun far Hashem tsu ale kinder fun Yisroel, un zei hobn ibergekukt, un genumen itlecher zain shtekn.<verse eid="NUM 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" altnumber="10" sid="NUM 17:25" />un Hashem hot gezogt tsu Mosheen: ker um Aharons shtekn faran tseignim, far a hitung, far a tseichn tsu di vidershpenike kinder, kedei zolst machn an end tsu zeyere murmleraien arum mir, un zei zoln nisht shtarbn. <verse eid="NUM 17:25" /><verse number="26" style="v" altnumber="11" sid="NUM 17:26" />hot Moshe dos geton; azoi vi Hashem hot im bafoiln, azoi hot er geton.<verse eid="NUM 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" altnumber="12" sid="NUM 17:27" />hobn di kinder fun Yisroel gezogt tsu Mosheen, azoi tsu zogn: ze, mir kumen um, mir geyen unter, ale geyen mir unter. <verse eid="NUM 17:27" /><verse number="28" style="v" altnumber="13" sid="NUM 17:28" />itlecher vos genent – vos genent tsum mishkn fun Hashem, shtarbt; tsi veln mir in gantsn umkumen?<verse eid="NUM 17:28" /></para>
  <chapter eid="NUM 17" />
  <chapter number="18" style="c" pubnumber="יח" sid="NUM 18" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1" />un Hashem hot gezogt tsu Aharonen: du un daine zin un dos hoiz fun dain foter mit dir, zolt trogn di zind fun dem heiliktum, un du un daine zin mit dir zolt trogn di zind fun aier kehune. <verse eid="NUM 18:1" /><verse number="2" style="v" sid="NUM 18:2" />un oich daine brider, dem shtam Levi, dem sheyvet fun dain foter, mach genenen mit dir, un zei zoln zain baheft tsu dir, un dich badinen; un du un daine zin mit dir zolt zain far dem getselt fun tseignim. <verse eid="NUM 18:2" /><verse number="3" style="v" sid="NUM 18:3" />un zei zoln hitn dain hitung, un di hitung fun gantsn getselt, ober tsu di heilike keilim un tsum mizbeyech zoln zei nisht genenen, kedei zei zoln nisht shtarbn, i zei i ir. <verse eid="NUM 18:3" /><verse number="4" style="v" sid="NUM 18:4" />un zei zoln zain baheft tsu dir, un hitn di hitung fun ohel-moed bai itlechn dinst fun getselt; un a fremder zol nisht genenen tsu aich. <verse eid="NUM 18:4" /><verse number="5" style="v" sid="NUM 18:5" />un ir zolt hitn di hitung fun heiliktum, un di hitung fun mizbeyech, kedei es zol mer nisht zain a tsorn oif di kinder fun Yisroel. <verse eid="NUM 18:5" /><verse number="6" style="v" sid="NUM 18:6" />un ich, ze, hob genumen aiere brider di Leviim fun tsvishn di kinder fun Yisroel; aich a matone zainen zei gegebn far Hashem, tsu dinen dem dinst fun ohel-moed. <verse eid="NUM 18:6" /><verse number="7" style="v" sid="NUM 18:7" />un du un daine zin mit dir zolt ophiten aier kehune bai itlecher zach fun mizbeyech un ineveinik fun Parochet, un ton dem dinst; a dinst far a matone gib ich aich di kehune, un der fremder, vos genent, zol geteit vern.<verse eid="NUM 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8" />un Hashem hot geredt tsu Aharonen: un ich, ze, hob dir gegebn di hitung fun maine opsheidungen; fun ale geheilikte zachn fun di kinder fun Yisroel hob ich zei gegebn far a chelek tsu dir un tsu daine kinder far an eibikn recht. <verse eid="NUM 18:8" /><verse number="9" style="v" sid="NUM 18:9" />dos zol gehern tsu dir fun di heilikste heilikeitn, fun di faieropfer: ale zeyere korbones, fun ale zeyere shpaizopfer, un fun ale zeyere zindopfer, un fun ale zeyere shuldopfer, vos zei tsoln op tsu mir; a heilikste heilikeit iz dos, far dir un far daine kinder. <verse eid="NUM 18:9" /><verse number="10" style="v" sid="NUM 18:10" />azoi a heilikstn zolstu es esen; itlecher mansparshoin meg es esen; heilik zol es zain far dir. <verse eid="NUM 18:10" /><verse number="11" style="v" sid="NUM 18:11" />un dos gehert tsu dir: di opsheidung fun zeyer gob bai ale oifheibungen fun di kinder fun Yisroel; tsu dir hob ich zei gegebn, un tsu daine zin un tsu daine techter mit dir, far an eibikn recht; itlecher vos iz rein in dain hoiz meg es esen. <verse eid="NUM 18:11" /><verse number="12" style="v" sid="NUM 18:12" />al dos beste fun eil, un al dos beste fun vain un tvue, dos ershte derfun vos zei gibn tsu Hashem, dos hob ich gegebn tsu dir. <verse eid="NUM 18:12" /><verse number="13" style="v" sid="NUM 18:13" />di ershttsaitike fun alts vos in zeyer land, vos zei brengen tsu Hashem, zoln gehern tsu dir; itlecher vos iz rein in dain hoiz meg es esen. <verse eid="NUM 18:13" /><verse number="14" style="v" sid="NUM 18:14" />itleche cheirem-zach in Yisroel zol gehern tsu dir. <verse eid="NUM 18:14" /><verse number="15" style="v" sid="NUM 18:15" />itlecher vos efent dem tracht, fun yetveder bashefenish vos me brengt tsu Hashem, fun a mentshn un fun a beheime, zol gehern tsu dir; ober oisleizen zolstu lozn oisleizen dem bechor fun a mentshn; oich dem bechor fun an umreiner beheime zolstu lozn oisleizen. <verse eid="NUM 18:15" /><verse number="16" style="v" sid="NUM 18:16" />un zeyer oisleiz – fun a choidesh alt zolstu lozn oisleizen – zol zain loit dain shatsung, finf shekl zilber, oifn heilikn shekl, dos iz tsvantsik gerah. <verse eid="NUM 18:16" /><verse number="17" style="v" sid="NUM 18:17" />ober a bechor fun a rind, oder a bechor fun a sheps, oder a bechor fun a tsig, torstu nisht lozn oisleizen; zei zainen heilik. zeyer blut zolstu shprengen oifn mizbeyech, un zeyer fets zolstu demfn far a faieropfer, far a geshmakn reyech tsu Hashem. <verse eid="NUM 18:17" /><verse number="18" style="v" sid="NUM 18:18" />un zeyer fleish zol gehern tsu dir; azoi vi di brust fun oifheibung, un azoi vi der rechter shenkl, zol es gehern tsu dir. <verse eid="NUM 18:18" /><verse number="19" style="v" sid="NUM 18:19" />ale opsheidungen fun di heilike zachn vos di kinder fun Yisroel sheidn op tsu Hashem, hob ich gegebn tsu dir un tsu daine zin un tsu daine techter mit dir, far an eibikn recht; an eibiker bris fun zalts iz dos far Hashem, dir un dain zomen mit dir.<verse eid="NUM 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20" />un Hashem hot gezogt tsu Aharonen: in zeyer land zolstu nisht arben, un kein chelek zolstu nisht hobn tsvishn zei; ich bin dain chelek un dain nachle tsvishn di kinder fun Yisroel. <verse eid="NUM 18:20" /><verse number="21" style="v" sid="NUM 18:21" />un tsu di kinder fun Levi, ze, hob ich gegebn yetveder maiser in Yisroel far an arav, far zeyer dinst vos zei dinen, dem dinst fun ohel-moed. <verse eid="NUM 18:21" /><verse number="22" style="v" sid="NUM 18:22" />un di kinder fun Yisroel zoln mer nisht genenen tsum ohel-moed, tsu trogn a chet un shtarbn. <verse eid="NUM 18:22" /><verse number="23" style="v" sid="NUM 18:23" />naiert der Levi, er zol dinen dem dinst fun ohel-moed; un zei zoln trogn zeyer zind; an eibik gezets oif zeyere dor-doires. un tsvishn di kinder fun Yisroel zoln zei nisht arben kein arbung. <verse eid="NUM 18:23" /><verse number="24" style="v" sid="NUM 18:24" />vorem dem maiser fun di kinder fun Yisroel, vos zei sheidn op far an opsheidung tsu Hashem, hob ich gegebn tsu di Leviim far an arbung; derum hob ich vegen zei gezogt: tsvishn di kinder fun Yisroel zoln zei nisht arben kein arbung.<verse eid="NUM 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 18:25" /><verse number="26" style="v" sid="NUM 18:26" />un tsu di Leviim zolstu redn, un zogn tsu zei: az ir vet nemen fun di kinder fun Yisroel dem maiser vos ich hob aich gegebn fun zei far aier arbung, zolt ir opsheiden derfun an opsheidungn tsu Hashem, maiser fun dem maiser. <verse eid="NUM 18:26" /><verse number="27" style="v" sid="NUM 18:27" />un aier opsheidung vet aich gerechnt vern azoi vi di tvue oisn dresh-shaier, un vi di shefe oisn kelter. <verse eid="NUM 18:27" /><verse number="28" style="v" sid="NUM 18:28" />azoi zolt ir oich opsheiden di opsheidung fun Hashem fun ale aiere maisres, vos ir vet nemen fun di kinder fun Yisroel, un ir zolt gebn derfun di opsheidung fun Hashem tsu Aharon dem koyen. <verse eid="NUM 18:28" /><verse number="29" style="v" sid="NUM 18:29" />fun alts vos vert aich gegebn zolt ir opsheiden di gantse opsheidung fun Hashem, fun alem bestn derfun, dos heilike fun dem. <verse eid="NUM 18:29" /><verse number="30" style="v" sid="NUM 18:30" />un zolst zogn tsu zei: az ir sheidt op fun dem dos beste derfun, zol es gerechnt vern di Leviim azoi vi der aintrog fun dresh-shaier, un azoi vi der aintrog fun kelter.<verse eid="NUM 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 18:31" />un ir megt es esen in yetveder ort, ir un aier hoizgezint, vorem dos iz aich a loin far aier dinst in ohel-moed. <verse eid="NUM 18:31" /><verse number="32" style="v" sid="NUM 18:32" />un ir vet nisht trogn vegen dem a zind, ven ir sheidt op fun dem dos beste derfun. un ir zolt nisht farshvechn di heilikeitn fun di kinder fun Yisroel, kedei ir zolt nisht shtarbn.<verse eid="NUM 18:32" /></para>
  <chapter eid="NUM 18" />
  <chapter number="19" style="c" pubnumber="יט" sid="NUM 19" />
  <para style="s1">Chukat</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1" />un Hashem hot geredt tsu Mosheen un tsu Aharonen, azoi tsu zogn:<verse eid="NUM 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 19:2" />dos iz dos gezets fun der toyre, vos Hashem hot bafoiln, azoi tsu zogn: red tsu di kinder fun Yisroel, zei zoln dir brengen a roite ku, a gantse, vos in ir iz nishto kein mum, vos oif ir iz nisht aroif kein yoch. <verse eid="NUM 19:2" /><verse number="3" style="v" sid="NUM 19:3" />un ir zolt zi gebn tsu Elazar dem koyen, un me zol zi aroisfirn oisn lager, un zi shechtn far im. <verse eid="NUM 19:3" /><verse number="4" style="v" sid="NUM 19:4" />un Elazar der koyen zol nemen fun ir blut mit zain finger, un shpritsn fun ir blut akegn der foderzait fun ohel-moed zibn mol. <verse eid="NUM 19:4" /><verse number="5" style="v" sid="NUM 19:5" />un me zol farbrenen di ku far zaine oign; ir fel un ir fleish un ir blut mit ir mist zol men farbrenen. <verse eid="NUM 19:5" /><verse number="6" style="v" sid="NUM 19:6" />un der koyen zol nemen tsederholts, un ezov-groz, un vermilroit, un arainvarfen in der farbrenung fun der ku. <verse eid="NUM 19:6" /><verse number="7" style="v" sid="NUM 19:7" />un der koyen zol vashn zaine kleider, un bodn zain laib in vaser, un dernoch meg er arainkumen in lager; un der koyen zol zain umrein bizn ovnt. <verse eid="NUM 19:7" /><verse number="8" style="v" sid="NUM 19:8" />oich der vos farbrent zi, zol vashn zaine kleider in vaser, un bodn zain laib in vaser, un zain umrein bizn ovnt. <verse eid="NUM 19:8" /><verse number="9" style="v" sid="NUM 19:9" />un a reiner man zol oifzamlen di ash fun der ku, un avekleigen oisn lager in a reinem ort; un es zol gehaltn vern far der eide fun di kinder fun Yisroel far shprengvaser; a reinikopfer iz dos. <verse eid="NUM 19:9" /><verse number="10" style="v" sid="NUM 19:10" />un der vos zamlt oif di ash fun der ku, zol vashn zaine kleider, un zain umrein bizn ovnt. un es zol zain far di kinder fun Yisroel, un far dem fremdn vos halt zich oif tsvishn zei, far an eibikn gezets.<verse eid="NUM 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11" />der vos rirt zich on on a mes, on voser es iz toitn laib fun a mentshn, zol zain umrein zibn teg. <verse eid="NUM 19:11" /><verse number="12" style="v" sid="NUM 19:12" />er zol zich reiniken dermit oifn dritn tog un oifn zibetn tog, un vern rein; un oib er vet zich nisht reiniken oifn dritn tog un oifn zibetn tog, zol er nisht vern rein. <verse eid="NUM 19:12" /><verse number="13" style="v" sid="NUM 19:13" />itlecher vos rirt zich on on a mes, on dem laib fun a mentshn vos iz geshtrobn, un er vet zich nisht reiniken, hot er di mishkn fun Hashem farumreinikt, un yene zel zol farshnitn vern fun Yisroel; az shprengvaser iz oif im nisht geshprengt gevorn, zol er zain umrein; zain umreinkeit iz noch oif im.<verse eid="NUM 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14" />dos iz der din: az a mentsh vet shtarbn in a getselt, zol itlecher vos kumt in getselt, un alts vos in getselt, zain umrein zibn teg. <verse eid="NUM 19:14" /><verse number="15" style="v" sid="NUM 19:15" />un yetveder ofene keile, vos oif ir iz nishto an arumgeshnirt dekl, iz umrein. <verse eid="NUM 19:15" /><verse number="16" style="v" sid="NUM 19:16" />un itlecher vos vet zich onrirn oifn fraien feld on a dershlogenem fun a shverd, oder on a geshtorbenem, oder an a bein fun a mentshn, oder on a keyver, zol zain umrein zibn teg.<verse eid="NUM 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17" />un me zol nemen far dem umreinem fun der ash fun dem farbrentn zindopfer, un aroifgisn deroif lebedike vaser in a keile. <verse eid="NUM 19:17" /><verse number="18" style="v" sid="NUM 19:18" />un a reiner man zol nemen ezov-groz, un aintunken in dem vaser, un shpritsn oifn getselt, un oif ale keilim, un oif di nefoshes vos zainen dortn geven, un oif dem vos hot zich ongerirt on dem bein, oder on dem dershlogenem, oder on dem geshtorbenem, oder on dem keyver.<verse eid="NUM 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 19:19" />un der vos iz rein zol shpritsn oif dem umreinem oifn dritn tog un oifn zibetn tog; un er zol im reiniken oifn zibetn tog; un er zol vashn zaine kleider, un zich bodn in vaser, un vern rein in ovnt. <verse eid="NUM 19:19" /><verse number="20" style="v" sid="NUM 19:20" />un az a mentsh vet zain umrein, un vet zich nisht reiniken, zol yene zel farshnitn vern fun tsvishn der eide, vorem dos mikdash fun Hashem hot er farumreinikt; shprengvaser iz oif im nisht geshprengt gevorn, iz er umrein. <verse eid="NUM 19:20" /><verse number="21" style="v" sid="NUM 19:21" />un es zol zei zain far an eibikn gezets. un der vos shpritst dos shprengvaser, zol vashn zaine kleider; un der vos rirt zich on on dem shprengvaser, zol zain umrein bizn ovnt. <verse eid="NUM 19:21" /><verse number="22" style="v" sid="NUM 19:22" />un alts vos der umreiner vet zich onrirn on dem, zol zain umrein; un der mentsh vos rirt zich on im on, zol zain umrein bizn ovnt.<verse eid="NUM 19:22" /></para>
  <chapter eid="NUM 19" />
  <chapter number="20" style="c" pubnumber="כ" sid="NUM 20" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1" />un di kinder fun Yisroel, di gantse eide, zainen gekumen in midber Tsin, in ershtn choidesh; un dos folk iz gezesn in Kadesh; un Miryam iz dortn geshtorbn, un iz dortn bagrobn gevorn.<verse eid="NUM 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2" />un di eide hot nisht gehat kein vaser, un zei hobn zich aingezamlt akegn Mosheen un akegn Aharonen. <verse eid="NUM 20:2" /><verse number="3" style="v" sid="NUM 20:3" />un dos folk hot zich gekrigt mit Mosheen, un zei hobn gezogt, azoi tsu zogn: halevay voltn mir umgekumen, ven undzere brider zainen umgekumen far Hashem! <verse eid="NUM 20:3" /><verse number="4" style="v" sid="NUM 20:4" />un noch vos hot ir gebracht di eide fun Hashem in dem dozikn midber, az mir un undzer fich zoln do oisshtarbn? <verse eid="NUM 20:4" /><verse number="5" style="v" sid="NUM 20:5" />un noch vos hot ir undz oifgebracht fun Mitsrayim, undz tsu brengen in dem dozikn shlechtn ort, vos iz nisht an ort fun zomen, oder faign, oder vainshtokn, oder milgroimen, un vu vaser tsum trinken iz nishto?<verse eid="NUM 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6" />zainen Moshe un Aharon avekgegangen fun far der eide tsum aingang fun ohel-moed, un zei zainen gefaln oif zeyer ponem; un di pracht fun Hashem hot zich bavizn tsu zei. <verse eid="NUM 20:6" /><verse number="7" style="v" sid="NUM 20:7" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 20:7" /><verse number="8" style="v" sid="NUM 20:8" />nem dem shtekn, un zaml ain di eide, du un Aharon dain bruder, un ir zolt redn tsum feldz far zeyere oign, az er zol aroisgebn fun zich vaser; un vest zei aroistsien vaser fun feldz, un vest ontrinken di eide un zeyer fich. <verse eid="NUM 20:8" /><verse number="9" style="v" sid="NUM 20:9" />hot Moshe genumen dem shtekn fun far Hashem, azoi vi er hot im bafoiln. <verse eid="NUM 20:9" /><verse number="10" style="v" sid="NUM 20:10" />un Moshe un Aharon hobn aingezamlt di eide far dem feldz, un er hot tsu zei gezogt: hert akorsht, ir vidershpeniker, zoln mir fun dem dozikn feldz aich aroistsien vaser? <verse eid="NUM 20:10" /><verse number="11" style="v" sid="NUM 20:11" />un Moshe hot oifgehoibn zain hant, un hot geshlogn dem feldz mit zain shtekn tsvei mol, un es iz arois a sach vaser, un di eide un zeyer fich hobn getrunken. <verse eid="NUM 20:11" /><verse number="12" style="v" sid="NUM 20:12" />hot Hashem gezogt tsu Mosheen un tsu Aharonen: vail ir hot nisht gegloibt in mir, mich tsu heilikn far di oign fun di kinder fun Yisroel, derum vet ir nisht brengen di dozike eide in dem land vos ich hob zei gegebn. <verse eid="NUM 20:12" /><verse number="13" style="v" sid="NUM 20:13" />dos iz dos vaser fun Merivah vu di kinder fun Yisroel hobn gekrigt akegn Hashem, un er iz geheilikt gevorn tsvishn zei.<verse eid="NUM 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14" />un Moshe hot geshikt shluchim fun Kadesh tsu dem melech fun Edom: azoi zogt dain bruder Yisroel: du veist al di maternish vos undz hot getrofn; <verse eid="NUM 20:14" /><verse number="15" style="v" sid="NUM 20:15" />vi undzere eltern hobn genidert kein Mitsrayim, un mir zainen gezesn in Mitsrayim fil teg, un di Mitsrayim hobn shlechts geton undz un undzere eltern; <verse eid="NUM 20:15" /><verse number="16" style="v" sid="NUM 20:16" />un mir hobn geshrien tsu Hashem, un er hot gehert undzer kol, un hot geshikt a malach, un undz aroisgetsoign fun Mitsrayim; un ot zainen mir in Kadesh, a shtot baim ek fun dain gemark. <verse eid="NUM 20:16" /><verse number="17" style="v" sid="NUM 20:17" />loz undz, ich bet dich, durchgein durch dain land; mir veln nisht durchgein durch a feld oder durch a vaingorten, un mir veln nisht trinken vaser fun a brunem; oif dem melechs veg veln mir geyen; mir veln zich nisht opnaign rechts oder links, biz vanen mir veln durchgein dain gemark. <verse eid="NUM 20:17" /><verse number="18" style="v" sid="NUM 20:18" />hot Edom tsu im gezogt: zolst nisht durchgein durch mir, vorem mitn shverd vel ich aroisgein akegn dir. <verse eid="NUM 20:18" /><verse number="19" style="v" sid="NUM 20:19" />hobn di kinder fun Yisroel tsu im gezogt: oifn veg veln mir gein, un az mir veln trinken dain vaser, ich un maine fich, vel ich gebn getsolt derfar; es iz doch gornisht; lomich bloiz durchgein oif maine fis. <verse eid="NUM 20:19" /><verse number="20" style="v" sid="NUM 20:20" />hot er gezogt: du kenst nisht durchgein. un Edom iz aroisgegangen akegn im mit fil folk, un mit a shtarker hant. <verse eid="NUM 20:20" /><verse number="21" style="v" sid="NUM 20:21" />un Edom hot nisht gevolt lozn Yisroel durchgein durch zain gemark, un Yisroel hot zich opgeneigt fun im.<verse eid="NUM 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22" />un zei hobn avekgetsoign fun Kadesh; un di kinder fun Yisroel, di gantse eide, zainen ongekumen tsum barg Hor. <verse eid="NUM 20:22" /><verse number="23" style="v" sid="NUM 20:23" />un Hashem hot gezogt tsu Mosheen un tsu Aharonen oifn barg Hor, baim gemark fun land Edom, azoi tsu zogn: <verse eid="NUM 20:23" /><verse number="24" style="v" sid="NUM 20:24" />zol Aharon aingezamlt vern tsu zain folk; vorem er vet nisht kumen in dem land vos ich hob gegebn tsu di kinder fun Yisroel, derfar vos ir hot vidershpenikt main moil baim vaser fun Merivah. <verse eid="NUM 20:24" /><verse number="25" style="v" sid="NUM 20:25" />nem Aharonen un zain zun Elazarn, un breng zei aroif oifn barg Hor; <verse eid="NUM 20:25" /><verse number="26" style="v" sid="NUM 20:26" />un tu ois Aharonen zaine kleider, un tu zei on zain zun Elazarn; un Aharon zol aingezamlt vern un shtarbn dortn. <verse eid="NUM 20:26" /><verse number="27" style="v" sid="NUM 20:27" />hot Moshe geton azoi vi Hashem hot bafoiln; un zei zainen aroifgegangen oifn barg Hor, far di oign fun der gantser eide. <verse eid="NUM 20:27" /><verse number="28" style="v" sid="NUM 20:28" />un Moshe hot oisgeton Aharonen zaine kleider, un hot zei ongeton zain zun Elazarn. un Aharon iz dortn geshtorbn oifn shpits barg. un Moshe un Elazar hobn aropgenidert fun barg. <verse eid="NUM 20:28" /><verse number="29" style="v" sid="NUM 20:29" />un di gantse eide hot gezen az Aharon iz fargangen; un dos gantse hoiz fun Yisroel hot baveint Aharonen draisik teg.<verse eid="NUM 20:29" /></para>
  <chapter eid="NUM 20" />
  <chapter number="21" style="c" pubnumber="כא" sid="NUM 21" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1" />un der Kenaani, der melech fun Arad, der bavoiner fun dorem, hot gehert az Yisroel iz ongekumen oif dem veg fun Atarim, un er hot milchome gehaltn mit Yisroel, un gefangen fun zei gefangene. <verse eid="NUM 21:1" /><verse number="2" style="v" sid="NUM 21:2" />hot Yisroel a neyder geton tsu Hashem, un hot gezogt: oib gebn vestu gebn dos dozike folk in main hant, vel ich machn zeyere shtet cheirem. <verse eid="NUM 21:2" /><verse number="3" style="v" sid="NUM 21:3" />un Hashem hot tsugehert tsu dem kol fun Yisroel, un er hot ibergegebn dem Kenaani, un zei hobn gemacht zei un zeyere shtet cheirem. un me hot gerufn dem nomen fun dem ort, Chormah.<verse eid="NUM 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4" />un zei hobn getsoign fun barg Hor oifn veg fun Yam-Suf, kedei tsu gein arum dem land Edom, un di zel fun dem folk iz gevorn umgeduldik fun veg. <verse eid="NUM 21:4" /><verse number="5" style="v" sid="NUM 21:5" />un dos folk hot geredt akegn Elokim un akegn Mosheen: noch vos hot ir undz oifgebracht fun Mitsrayim tsu shtarbn in der midber? vorem kein broit iz nishto, un kein vaser iz nishto, un undzer zel eklt zich mit der nishtiker shpaiz. <verse eid="NUM 21:5" /><verse number="6" style="v" sid="NUM 21:6" />hot Hashem ongeshikt oifn folk faierdike shlangen, un zei hobn gebisn dos folk, un es iz geshtorbn a sach folk fun Yisroel. <verse eid="NUM 21:6" /><verse number="7" style="v" sid="NUM 21:7" />iz dos folk gekumen tsu Mosheen, un zei hobn gezogt: mir hobn gezindikt vos mir hobn geredt akegn Hashem un akegn dir; zai mispalel tsu Hashem, er zol opton fun undz di shlangen. hot Moshe mispalel geven faran folk. <verse eid="NUM 21:7" /><verse number="8" style="v" sid="NUM 21:8" />un Hashem hot gezogt tsu Mosheen: mach dir a faierdike shlang, un tu zi aroif oif a shtang; un es vet zain, itlecher vos vert gebisn, vet zi zen, un vet blaibn lebn. <verse eid="NUM 21:8" /><verse number="9" style="v" sid="NUM 21:9" />hot Moshe gemacht a kuperne shlang, un hot zi aroifgeton oif a shtang; un es iz geven, az a shlang hot emitsn gebisn, azoi hot er a kuk geton oif der kuperner shlang, un iz geblibn lebn.<verse eid="NUM 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10" />un di kinder fun Yisroel hobn avekgetsoign, un gerut in Ovot. <verse eid="NUM 21:10" /><verse number="11" style="v" sid="NUM 21:11" />un zei hobn getsoign fun Ovot, un gerut in Iyei-Avarim, in dem midber vos far Moav, akegn zunoifgang. <verse eid="NUM 21:11" /><verse number="12" style="v" sid="NUM 21:12" />fun dortn hobn zei getsoign, un gerut in tal Zered. <verse eid="NUM 21:12" /><verse number="13" style="v" sid="NUM 21:13" />fun dortn hobn zei getsoign, un gerut oif yener zait Arnon vos in midber, vos geit arois fun dem gemark fun Emori; vorem Arnon iz der gemark fun Moav, tsvishn Moav un tsvishn dem Emori. <verse eid="NUM 21:13" /><verse number="14" style="v" sid="NUM 21:14" />derum vert gezogt in dem buch fun di milchomes fun Hashem:</para>
  <para style="b" vid="NUM 21:14" />
  <para style="q" vid="NUM 21:14">Vahev in Sufah,</para>
  <para style="q" vid="NUM 21:14">un di toln fun Arnon,<verse eid="NUM 21:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="NUM 21:15" />un dem aropgang fun di toln,</para>
  <para style="q" vid="NUM 21:15">vos neigt zich tsu der voinung fun Ar,</para>
  <para style="q" vid="NUM 21:15">un lent zich on gemark fun Moav.<verse eid="NUM 21:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="NUM 21:16" />un fun dortn kein Beer. dos iz der brunem, vu Hashem hot gezogt tsu Mosheen: zaml ain dos folk, un ich vel zei gebn vaser.<verse eid="NUM 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17" />dentsmol hot Yisroel gezungen dos dozike gezang:</para>
  <para style="b" vid="NUM 21:17" />
  <para style="q" vid="NUM 21:17">kvel aroif, brunem – zingt tsu im –<verse eid="NUM 21:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="NUM 21:18" />der brunem vos gegrobn hobn im harn,</para>
  <para style="q" vid="NUM 21:18">im oisgehakt hobn firshtn fun folk,</para>
  <para style="q" vid="NUM 21:18">durch dem Mechokeik mit zeyere shtekens.</para>
  <para style="b" vid="NUM 21:18" />
  <para style="m" vid="NUM 21:18">un fun midber kein Mattanah; <verse eid="NUM 21:18" /><verse number="19" style="v" sid="NUM 21:19" />un fun Mattanah kein Nachaliel, un fun Nachaliel kein Bamot; <verse eid="NUM 21:19" /><verse number="20" style="v" sid="NUM 21:20" />un fun Bamot tsu dem tal vos in feld fun Moav, baim shpits fun Pisgah, vos kukt arop oif der viste.<verse eid="NUM 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21" />un Yisroel hot geshikt shluchim tsu Sichon dem melech fun Emori, azoi tsu zogn: <verse eid="NUM 21:21" /><verse number="22" style="v" sid="NUM 21:22" />lomich durchgein durch dain land; mir veln zich nisht opnaign in a feld oder in a vaingorten; mir veln nisht trinken vaser fun a brunem; oif dem melechs veg veln mir gein, biz vanen mir veln durchgein dain gemark. <verse eid="NUM 21:22" /><verse number="23" style="v" sid="NUM 21:23" />ober Sichon hot nisht gelozt Yisroel durchgein durch zain gemark, un Sichon hot aingezamlt zain gants folk, un iz aroisgegangen akegn Yisroel tsum midber, un er iz gekumen kein Yahats, un hot milchome gehaltn mit Yisroel. <verse eid="NUM 21:23" /><verse number="24" style="v" sid="NUM 21:24" />un Yisroel hot im geshlogn mitn sharf fun shverd, un aingenumen zain land fun Arnon biz Yabbok, biz di kinder fun Amon; vorem der gemark fun di kinder fun Amon iz geven shtark. <verse eid="NUM 21:24" /><verse number="25" style="v" sid="NUM 21:25" />un Yisroel hot tsugenumen ale di dozike shtet, un Yisroel hot zich bazetst in ale shtet fun Emori, in Cheshbon, un in ale ire techtershtet. <verse eid="NUM 21:25" /><verse number="26" style="v" sid="NUM 21:26" />vorem Cheshbon iz geven di shtot fun Sichon dem melech fun Emori, vos hot milchome gehaltn mit dem frierdikn melech fun Moav, un hot avekgenumen zain gants land fun zain hant, biz Arnon. <verse eid="NUM 21:26" /><verse number="27" style="v" sid="NUM 21:27" />derum zogn di shpruchzoger:</para>
  <para style="b" vid="NUM 21:27" />
  <para style="q" vid="NUM 21:27">kumt kein Cheshbon!</para>
  <para style="q" vid="NUM 21:27">geboit un oifgeshtelt</para>
  <para style="q" vid="NUM 21:27">zol vern di shtot fun Sichon!<verse eid="NUM 21:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="NUM 21:28" />vorem a faier iz arois fun Cheshbon,</para>
  <para style="q" vid="NUM 21:28">a flam fun der shtot fun Sichon;</para>
  <para style="q" vid="NUM 21:28">zi hot fartsert Ar fun Moav,</para>
  <para style="q" vid="NUM 21:28">di harn fun di heichn fun Arnon.<verse eid="NUM 21:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="NUM 21:29" />vei tsu dir, Moav!</para>
  <para style="q" vid="NUM 21:29">farlorn bistu, folk fun Kemosh!</para>
  <para style="q" vid="NUM 21:29">er hot gelozt vern zaine zin antrunene,</para>
  <para style="q" vid="NUM 21:29">un zaine techter in gefangenshaft</para>
  <para style="q" vid="NUM 21:29">tsu Sichon dem melech fun Emori.<verse eid="NUM 21:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="NUM 21:30" />un mir hobn zei tseshosn;</para>
  <para style="q" vid="NUM 21:30">farlorn iz Cheshbon biz Divon;</para>
  <para style="q" vid="NUM 21:30">un mir hobn farvist</para>
  <para style="q" vid="NUM 21:30">biz Nofach vos biz Medeva.<verse eid="NUM 21:30" /></para>
  <para style="b" />
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31" />un Yisroel hot zich bazetst in land fun dem Emori. <verse eid="NUM 21:31" /><verse number="32" style="v" sid="NUM 21:32" />un Moshe hot geshikt oiskukn Yazer, un zei hobn batsvungen ire techtershtet, un fartriben dem Emori vos iz dortn geven.<verse eid="NUM 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 21:33" />un zei hobn zich farkert, un zainen aroifgegangen oifn veg fun Bashan; iz aroisgegangen Og der melech fun Bashan akegn zei, er mit zain gantsn folk, oif milchome kein Edrei. <verse eid="NUM 21:33" /><verse number="34" style="v" sid="NUM 21:34" />hot Hashem gezogt tsu Mosheen: zolst nisht moire hobn far im, vorem in dain hant hob ich gegebn im mit zain gantsn folk un zain land, un vest ton tsu im, azoi vi du host geton tsu Sichon dem melech fun Emori, vos iz gezesn in Cheshbon. <verse eid="NUM 21:34" /><verse number="35" style="v" sid="NUM 21:35" />un zei hobn geshlogn im mit zaine zin un zain gantsn folk, biz im nisht tsu lozn an iberblaib; un zei hobn gearbt zain land.<verse eid="NUM 21:35" /></para>
  <chapter eid="NUM 21" />
  <chapter number="22" style="c" pubnumber="כב" sid="NUM 22" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1" />un di kinder fun Yisroel hobn avekgetsoign, un hobn gerut in di ploinen fun Moav, oif yener zait Yarden bai Yericho.<verse eid="NUM 22:1" /></para>
  <para style="s1">Balak</para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 22:2" />un Balak der zun fun Tsiporn hot gezen alts vos Yisroel hot geton tsum Emori. <verse eid="NUM 22:2" /><verse number="3" style="v" sid="NUM 22:3" />un Moav hot zich zeyer dershrokn far dem folk, vail zei zainen geven fil, un Moav iz geven in angst far di kinder fun Yisroel. <verse eid="NUM 22:3" /><verse number="4" style="v" sid="NUM 22:4" />hot Moav gezogt tsu di eltste fun Midyan: atsund vet dos gezeml opesen alts vos arum undz, azoi vi an oks est op dos groz fun feld. un Balak der zun fun Tsiporn iz geven der melech fun Moav in yener tsait. <verse eid="NUM 22:4" /><verse number="5" style="v" sid="NUM 22:5" />hot er geshikt shluchim tsu Bilaam der zun fun Beoren, kein Petor vos baim taich, in dem land fun di kinder fun zain folk, im tsu rufn, azoi tsu zogn: ot iz a folk aroisgegangen fun Mitsrayim; ze, er hot fardekt dem onblik fun der erd, un er zitst mir antkegen. <verse eid="NUM 22:5" /><verse number="6" style="v" sid="NUM 22:6" />un atsund kum, ich bet dich, shilt mir dos dozike folk, vorem er iz shtarker fun mir. efsher vel ich oisfirn mir zoln im shlogn, un ich vel im fartraiben fun land; vorem ich veis, az vemen du bentshst, der iz gebentsht, un vemen du shiltst, der iz farsholten .<verse eid="NUM 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7" />zainen di eltste fun Moav un di eltste fun Midyan gegangen mit tsoiberloin in zeyer hant, un zei zainen gekumen tsu Bilaamen, un hobn geredt tsu im di verter fun Balakn. <verse eid="NUM 22:7" /><verse number="8" style="v" sid="NUM 22:8" />hot er tsu zei gezogt: nechtikt do di nacht, un ich vel aich gebn an entfer, azoi vi Hashem vet redn tsu mir. un di harn fun Moav zainen geblibn bai Bilaamen. <verse eid="NUM 22:8" /><verse number="9" style="v" sid="NUM 22:9" />iz Elokim gekumen tsu Bilaamen, un hot gezogt: ver zainen di dozike mentshn bai dir? <verse eid="NUM 22:9" /><verse number="10" style="v" sid="NUM 22:10" />hot Bilaam gezogt tsu HaElokim: Balak der zun fun Tsiporn, der melech fun Moav, hot geshikt tsu mir: <verse eid="NUM 22:10" /><verse number="11" style="v" sid="NUM 22:11" />ot iz dos folk vos iz aroisgegangen fun Mitsrayim, un er hot fardekt dem onblik fun der erd. atsund, kum shilt mir im; efsher vel ich kenen milchome haltn oif im, un vel im fartraiben. <verse eid="NUM 22:11" /><verse number="12" style="v" sid="NUM 22:12" />hot Elokim gezogt tsu Bilaamen: zolst nisht gein mit zei; zolst nisht shiltn dos folk, vorem er iz gebentsht. <verse eid="NUM 22:12" /><verse number="13" style="v" sid="NUM 22:13" />iz Bilaam oifgeshtanen in der peire, un hot gezogt tsu di harn fun Balakn: geit in aier land, vorem Hashem vil nisht mich lozn gein mit aich. <verse eid="NUM 22:13" /><verse number="14" style="v" sid="NUM 22:14" />zainen oifgeshtanen di harn fun Moav, un zainen avekgegangen tsu Balakn, un hobn gezogt: Bilaam hot nisht gevolt gein mit undz.<verse eid="NUM 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15" />hot Balak vider a mol geshikt harn, mer un ongezeenere fun yene. <verse eid="NUM 22:15" /><verse number="16" style="v" sid="NUM 22:16" />un zei zainen gekumen tsu Bilaamen, un hobn tsu im gezogt: azoi hot gezogt Balak der zun fun Tsiporn: zolst zich nisht farmaidn, ich bet dich, fun kumen tsu mir. <verse eid="NUM 22:16" /><verse number="17" style="v" sid="NUM 22:17" />vorem zeyer grois koved vel ich dir onton, un alts vos du vest zogn tsu mir, vel ich ton; nor kum, ich bet dich, shilt mir dos dozike folk. <verse eid="NUM 22:17" /><verse number="18" style="v" sid="NUM 22:18" />hot geentfert Bilaam un gezogt tsu di knecht fun Balakn: ven Balak zol mir gebn zain hoiz ful mit zilber un gold, ken ich nisht ibertretn dem bafel fun Hashem main G-t, tsu ton kleins oder grois. <verse eid="NUM 22:18" /><verse number="19" style="v" sid="NUM 22:19" />un atsund, ich bet aich, blaibt ir oich do di nacht, un ich vel gevor vern vos Hashem vet vider redn mit mir. <verse eid="NUM 22:19" /><verse number="20" style="v" sid="NUM 22:20" />un Elokim iz gekumen tsu Bilaamen bai nacht, un hot tsu im gezogt: oib dich tsu rufn zainen di mentshn gekumen, shtei oif, gei mit zei, ober nor di zach vos ich vel redn tsu dir, dos zolstu ton. <verse eid="NUM 22:20" /><verse number="21" style="v" sid="NUM 22:21" />iz Bilaam oifgeshtanen in der peire, un er hot ongezotlt zain eizelin, un iz gegangen mit di harn fun Moav.<verse eid="NUM 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 22:22" />un der tsorn fun Elokim hot gegrimt vos er geit, un a malach fun Hashem hot zich im geshtelt far a shter in veg. – un er iz geritn oif zain eizelin, un zaine tsvei yungen zainen geven mit im. – <verse eid="NUM 22:22" /><verse number="23" style="v" sid="NUM 22:23" />hot di eizelin derzen dem malach fun Hashem shtein oifn veg, mit zain shverd aroisgetsoign in zain hant, un di eizelin hot zich opgeneigt fun veg, un iz gegangen oifn feld; un Bilaam hot geshlogn di eizelin kedei zi tsu farkireven oifn veg. <verse eid="NUM 22:23" /><verse number="24" style="v" sid="NUM 22:24" />hot der malach fun Hashem zich geshtelt oif a shteg fun di vaingertner, mit a tsam fun der zait un a tsam fun der ander zait. <verse eid="NUM 22:24" /><verse number="25" style="v" sid="NUM 22:25" />un di eizelin hot gezen dem malach fun Hashem, un hot zich tsugedrikt tsu der vant, un tsugedrikt Bilaams fus tsu der vant; un er hot zi vider geshlogn. <verse eid="NUM 22:25" /><verse number="26" style="v" sid="NUM 22:26" />iz der malach fun Hashem vider avek farois, un hot zich geshtelt in an engn ort, vu es iz nisht geven kein veg zich optsuneigen rechts oder links. <verse eid="NUM 22:26" /><verse number="27" style="v" sid="NUM 22:27" />un di eizelin hot gezen dem malach fun Hashem, un hot zich anidergeleigt unter Bilaamen; un der tsorn fun Bilaamen hot gegrimt, un er hot geshlogn di eizelin mitn shtekn. <verse eid="NUM 22:27" /><verse number="28" style="v" sid="NUM 22:28" />hot Hashem geefent dos moil fun der eizelin, un zi hot gezogt tsu Bilaamen: vos hob ich dir geton, vos du host mir shoin drai mol geshlogn? <verse eid="NUM 22:28" /><verse number="29" style="v" sid="NUM 22:29" />hot Bilaam gezogt tsu der eizelin: vail du host geshpet fun mir; ven ich hob a shverd in der hant, volt ich dich atsund geharget. <verse eid="NUM 22:29" /><verse number="30" style="v" sid="NUM 22:30" />hot di eizelin gezogt tsu Bilaamen: bin ich nisht dain eizelin, vos du host geritn oif mir dain gants lebn biz haintikn tog? bin ich gevointlech gevoint geven dir azoi tsu ton? hot er gezogt: nein. <verse eid="NUM 22:30" /><verse number="31" style="v" sid="NUM 22:31" />un Hashem hot antplekt di oign fun Bilaamen, un er hot derzen dem malach fun Hashem shtein in veg, mit zain shverd aroisgetsoign in zain hant. hot er zich geneigt, un zich gebukt oif zain ponem. <verse eid="NUM 22:31" /><verse number="32" style="v" sid="NUM 22:32" />un der malach fun Hashem hot tsu im gezogt: far vos hostu geshlogn dain eizelin shoin drai mol? ze, ich bin aroisgegangen far a shter, vorem der veg geit mir derkegn. <verse eid="NUM 22:32" /><verse number="33" style="v" sid="NUM 22:33" />un di eizelin hot mich gezen, un hot zich opgeneigt far mir di drai mol; ven zi volt zich nisht opgeneigt fun mir, volt ich atsund dich zicher geharget, un zi volt ich gelozt lebn. <verse eid="NUM 22:33" /><verse number="34" style="v" sid="NUM 22:34" />hot Bilaam gezogt tsu dem malach fun Hashem: ich hob gezindikt, vorem ich hob nisht gevust, az du shteist mir antkegen oifn veg; un atsund oib es iz shlecht in daine oign, vel ich mich umkeren.<verse eid="NUM 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35" />hot der malach fun Hashem gezogt tsu Bilaamen: gei mit di mentshn, ober nor dos vort vos ich vel redn tsu dir, dos zolstu redn. iz Bilaam gegangen mit di harn fun Balakn.<verse eid="NUM 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36" />un Balak hot gehert az Bilaam kumt, un er iz im aroisgegangen antkegen kein Ir-Moav vos baim gemark fun Arnon, vos baim ek gemark. <verse eid="NUM 22:36" /><verse number="37" style="v" sid="NUM 22:37" />un Balak hot gezogt tsu Bilaamen: hob ich nisht shikn geshikt tsu dir, dich tsu rufn? far vos bistu nisht gekumen tsu mir? bin ich in der emes nisht imshtand dir koved ontsuton? <verse eid="NUM 22:37" /><verse number="38" style="v" sid="NUM 22:38" />hot Bilaam gezogt tsu Balakn: ze, ich bin gekumen tsu dir; atsund, tsi ken ich gor epes redn? dos vort vos Elokim vet arainton in main moil, dos vel ich redn. <verse eid="NUM 22:38" /><verse number="39" style="v" sid="NUM 22:39" />un Bilaam iz gegangen mit Balakn, un zei zainen gekumen kein Kiryat-Chutsot. <verse eid="NUM 22:39" /><verse number="40" style="v" sid="NUM 22:40" />un Balak hot geshlacht rinder un shof, un hot geshikt tsu Bilaamen, un tsu di harn vos mit im. <verse eid="NUM 22:40" /><verse number="41" style="v" sid="NUM 22:41" />un es iz geven in der peire, hot Balak genumen Bilaamen, un hot im aroifgefirt kein Bamot-Baal, un er hot fun dortn gezen a teil fun dem folk.<verse eid="NUM 22:41" /></para>
  <chapter eid="NUM 22" />
  <chapter number="23" style="c" pubnumber="כג" sid="NUM 23" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1" />hot Bilaam gezogt tsu Balakn: boi mir do zibn mizbeyches, un greit mir do tsu zibn oksen un zibn viders. <verse eid="NUM 23:1" /><verse number="2" style="v" sid="NUM 23:2" />hot Balak geton azoi vi Bilaam hot geredt, un Balak un Bilaam hobn oifgebracht an oks un a vider oif a mizbeyech. <verse eid="NUM 23:2" /><verse number="3" style="v" sid="NUM 23:3" />un Bilaam hot gezogt tsu Balakn: shtel zich bai dain brandopfer, un ich vel gein; efsher vet zich mir Hashem trefn antkegen, un vos far a zach er vet mir vaizn, vel ich dir dertseiln. un er iz aroifgegangen oif a hoichn ort. <verse eid="NUM 23:3" /><verse number="4" style="v" sid="NUM 23:4" />un Elokim hot zich getrofn far Bilaamen; un er hot tsu im gezogt: di zibn mizbeyches hob ich tsugegreit, un hob oifgebracht an oks un a vider oif a mizbeyech. <verse eid="NUM 23:4" /><verse number="5" style="v" sid="NUM 23:5" />hot Hashem araingeton a vort in Bilaams moil, un hot gezogt: ker zich um tsu Balakn, un azoi zolstu redn. <verse eid="NUM 23:5" /><verse number="6" style="v" sid="NUM 23:6" />hot er zich umgekert tsu im, ersht er shteit bai zain brandopfer, er un ale harn fun Moav. <verse eid="NUM 23:6" /><verse number="7" style="v" sid="NUM 23:7" />hot er oifgehoibn zain shpruch, un hot gezogt:</para>
  <para style="b" vid="NUM 23:7" />
  <para style="q" vid="NUM 23:7">fun Aram tut mich firn Balak,</para>
  <para style="q" vid="NUM 23:7">fun di mizrech-berg der melech fun Moav:</para>
  <para style="q" vid="NUM 23:7">kum shilt mir Yaakovn,</para>
  <para style="q" vid="NUM 23:7">un kum fluch Yisroeln.<verse eid="NUM 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NUM 23:8" />vi zol ich shiltn</para>
  <para style="q" vid="NUM 23:8">vemen El shilt nisht?</para>
  <para style="q" vid="NUM 23:8">un vi zol ich fluchn</para>
  <para style="q" vid="NUM 23:8">vemen Hashem flucht nisht?<verse eid="NUM 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NUM 23:9" />vorem fun shpits fun di feldzn ze ich im,</para>
  <para style="q" vid="NUM 23:9">un fun di heichn kuk ich im on.</para>
  <para style="q" vid="NUM 23:9">ze, a folk vos rut bazunder,</para>
  <para style="q" vid="NUM 23:9">un rechnt zich nisht tsvishn di umes.<verse eid="NUM 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NUM 23:10" />ver hot getseilt dem shtoib fun Yaakov,</para>
  <para style="q" vid="NUM 23:10">un barechnt dem zomen fun Yisroel?</para>
  <para style="q" vid="NUM 23:10">zol shtarbn main zel dem toit fun di rechtfartikn,</para>
  <para style="q" vid="NUM 23:10">un zol main sof zain vi zainer!<verse eid="NUM 23:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11" />hot Balak gezogt tsu Bilaamen: vos hostu mir geton? tsu shiltn maine sonem hob ich dich genumen, ersht gor bentshn hostu gebentsht. <verse eid="NUM 23:11" /><verse number="12" style="v" sid="NUM 23:12" />hot er geentfert un hot gezogt: far vor, dos vos Hashem tut arain in main moil, dos muz ich hitn tsu redn. <verse eid="NUM 23:12" /><verse number="13" style="v" sid="NUM 23:13" />hot Balak gezogt tsu im: kum mit mir, ich bet dich, tsu an ander ort, vos du vest im zen fun dortn; bloiz a teil fun im vestu zen, ober in gantsn vestu im nisht zen; un shilt mir im fun dortn. <verse eid="NUM 23:13" /><verse number="14" style="v" sid="NUM 23:14" />un er hot im genumen tsu dem feld Tsefoim oifn shpits Pisgah, un er hot geboit zibn mizbeyches, un oifgebracht an oks un a vider oif a mizbeyech. <verse eid="NUM 23:14" /><verse number="15" style="v" sid="NUM 23:15" />un er hot gezogt tsu Balakn: shtel zich do bai dain brandopfer, un ich vel gein zich trefn dortn. <verse eid="NUM 23:15" /><verse number="16" style="v" sid="NUM 23:16" />hot Hashem zich getrofn far Bilaamen, un er hot araingeton a vort in zain moil, un hot gezogt: ker zich um tsu Balakn, un azoi zolstu redn. <verse eid="NUM 23:16" /><verse number="17" style="v" sid="NUM 23:17" />iz er gekumen tsu im, ersht er shteit bai zain brandopfer, un di harn fun Moav mit im; un Balak hot tsu im gezogt: vos hot Hashem geredt?<verse eid="NUM 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18" />hot er oifgehoibn zain shpruch, un hot gezogt:</para>
  <para style="b" vid="NUM 23:18" />
  <para style="q" vid="NUM 23:18">shtei oif, Balak, un her,</para>
  <para style="q" vid="NUM 23:18">farnem tsu mir, zun fun Tsippor:<verse eid="NUM 23:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NUM 23:19" />nisht a man iz El, er zol lign zogn,</para>
  <para style="q" vid="NUM 23:19">nisht a mentshnkind, er zol charote hobn.</para>
  <para style="q" vid="NUM 23:19">az er zogt, vet er den nisht ton?</para>
  <para style="q" vid="NUM 23:19">un az er redt, vet er es nisht mekayem zain?<verse eid="NUM 23:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="NUM 23:20" />ze, bentsh! hob ich farnumen,</para>
  <para style="q" vid="NUM 23:20">un bentsht er, ken ich es nisht ophaltn.<verse eid="NUM 23:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="NUM 23:21" />me zet nisht kein umrecht in Yaakov,</para>
  <para style="q" vid="NUM 23:21">un me merkt nisht kein avle in Yisroel.</para>
  <para style="q" vid="NUM 23:21">Hashem zain G-t iz mit im,</para>
  <para style="q" vid="NUM 23:21">un di chein fun melech iz oif im.<verse eid="NUM 23:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="NUM 23:22" />El tsit zei arois fun Mitsrayim,</para>
  <para style="q" vid="NUM 23:22">vi herner fun a vizltir iz er im.<verse eid="NUM 23:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="NUM 23:23" />vorem nishto kein kishef in Yaakov,</para>
  <para style="q" vid="NUM 23:23">un kein vorzogenish in Yisroel.</para>
  <para style="q" vid="NUM 23:23">atsund vert fun Yaakov un Yisroel gezogt:</para>
  <para style="q" vid="NUM 23:23">vos El hot oifgeton!<verse eid="NUM 23:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="NUM 23:24" />ze, a folk vos shteit oif vi a leibinte,</para>
  <para style="q" vid="NUM 23:24">un heibt zich oif vi a leib;</para>
  <para style="q" vid="NUM 23:24">er leigt zich nisht biz er est roib,</para>
  <para style="q" vid="NUM 23:24">un blut fun dershlogene trinkt er.<verse eid="NUM 23:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25" />hot Balak gezogt tsu Bilaamen: nisht shiltn zolstu im shiltn, un nisht bentshn zolstu im bentshn. <verse eid="NUM 23:25" /><verse number="26" style="v" sid="NUM 23:26" />hot Bilaam geentfert un hot gezogt tsu Balakn: hob ich nisht geredt tsu dir, azoi tsu zogn: alts vos Hashem vet redn, dos vel ich ton? <verse eid="NUM 23:26" /><verse number="27" style="v" sid="NUM 23:27" />hot Balak gezogt tsu Bilaamen: kum ich bet dich, ich vel dich nemen tsu an ander ort; efsher vet voilgefeln in di oign fun HaElokim, un vest mir im shiltn fun dortn. <verse eid="NUM 23:27" /><verse number="28" style="v" sid="NUM 23:28" />un Balak hot genumen Bilaamen tsum shpits Peor, vos kukt arop oif der viste. <verse eid="NUM 23:28" /><verse number="29" style="v" sid="NUM 23:29" />hot Bilaam gezogt tsu Balakn: boi mir do zibn mizbeyches, un greit mir do tsu zibn oksen un zibn viders. <verse eid="NUM 23:29" /><verse number="30" style="v" sid="NUM 23:30" />un Balak hot geton azoi vi Bilaam hot gezogt, un er hot oifgebracht an oks un a vider oif a mizbeyech.<verse eid="NUM 23:30" /></para>
  <chapter eid="NUM 23" />
  <chapter number="24" style="c" pubnumber="כד" sid="NUM 24" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1" />un Bilaam hot gezen az es iz voilgefeln in di oign fun Hashem tsu bentshn Yisroel, un er iz nisht gegangen azoi vi di frierdike mol, antkegen kishef-tseichns, nor er hot gekert zain ponem tsum midber. <verse eid="NUM 24:1" /><verse number="2" style="v" sid="NUM 24:2" />un Bilaam hot oifgehoibn zaine oign, un hot gezen Yisroel ruen loit zaine shvotim, un der gaist fun Elokim iz gekumen oif im. <verse eid="NUM 24:2" /><verse number="3" style="v" sid="NUM 24:3" />un er hot oifgehoibn zain shpruch, un hot gezogt:</para>
  <para style="b" vid="NUM 24:3" />
  <para style="q" vid="NUM 24:3">azoi redt Bilaam der zun fun Beor,</para>
  <para style="q" vid="NUM 24:3">un azoi redt der man mitn ofenem oig;<verse eid="NUM 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NUM 24:4" />azoi redt der vos hert G-ts verter,</para>
  <para style="q" vid="NUM 24:4">vos di zeung fun Shaddai tut er zen,</para>
  <para style="q" vid="NUM 24:4">gefaln, mit oign antplekte:<verse eid="NUM 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NUM 24:5" />vi shein zainen daine getseltn, Yaakov,</para>
  <para style="q" vid="NUM 24:5">daine voinungen, Yisroel!<verse eid="NUM 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NUM 24:6" />vi taichlech zainen zei oisgeshtrekt,</para>
  <para style="q" vid="NUM 24:6">vi gertner baim taich,</para>
  <para style="q" vid="NUM 24:6">vi lahen vos Hashem hot geflantst,</para>
  <para style="q" vid="NUM 24:6">vi tsedern baim vaser.<verse eid="NUM 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NUM 24:7" />vaser vet rinen fun zain tsvaig,</para>
  <para style="q" vid="NUM 24:7">un zain zomen vet zain bai fil vaser;</para>
  <para style="q" vid="NUM 24:7">un hecher fun Agagn vet zain zain melech,</para>
  <para style="q" vid="NUM 24:7">un derhoibn vet zain zain meluche.<verse eid="NUM 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NUM 24:8" />El tsit im arois fun Mitsrayim,</para>
  <para style="q" vid="NUM 24:8">vi herner fun a vizltir iz er im;</para>
  <para style="q" vid="NUM 24:8">er vet fartseren di felker, zaine faint,</para>
  <para style="q" vid="NUM 24:8">un zeyere beiner tseknakn;</para>
  <para style="q" vid="NUM 24:8">un zaine failn veln durchlechern.<verse eid="NUM 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NUM 24:9" />er knit, er leigt zich vi a leib,</para>
  <para style="q" vid="NUM 24:9">un vi a leibinte – ver ken im oifreitsn?</para>
  <para style="q" vid="NUM 24:9">gebentsht di vos bentshn dich,</para>
  <para style="q" vid="NUM 24:9">un farsholten di vos shiltn dich!<verse eid="NUM 24:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10" />hot der tsorn fun Balakn gegrimt oif Bilaamen, un er hot a patsh geton mit zaine hent; un Balak hot gezogt tsu Bilaamen: tsu shiltn maine sonem hob ich dich gerufn, ersht gor bentshn hostu gebentsht shoin drai mol. <verse eid="NUM 24:10" /><verse number="11" style="v" sid="NUM 24:11" />un atsund antloif dir in dain heim; ich hob geklert, grois koved vel ich dir onton, ersht Hashem hot dich farmitn fun koved. <verse eid="NUM 24:11" /><verse number="12" style="v" sid="NUM 24:12" />hot Bilaam gezogt tsu Balakn: hob ich nisht geredt noch tsu daine shluchim, vos du host geshikt tsu mir, azoi tsu zogn: <verse eid="NUM 24:12" /><verse number="13" style="v" sid="NUM 24:13" />ven Balak zol mir gebn zain hoiz ful mit zilber un gold, ken ich nisht ibertretn dem bafel fun Hashem, tsu ton guts oder shlechts fun main eigenem hartsn; vos Hashem vet redn, vos vel ich redn? <verse eid="NUM 24:13" /><verse number="14" style="v" sid="NUM 24:14" />un atsund ze, ich gei tsu main folk; kum, lomich dir basheidn vos dos dozike folk vet ton tsu dain folk in sof fun di teg. <verse eid="NUM 24:14" /><verse number="15" style="v" sid="NUM 24:15" />un er hot oifgehoibn zain shpruch, un hot gezogt:</para>
  <para style="b" vid="NUM 24:15" />
  <para style="q" vid="NUM 24:15">azoi redt Bilaam der zun fun Beor,</para>
  <para style="q" vid="NUM 24:15">un azoi redt der man mitn ofenem oig;<verse eid="NUM 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="NUM 24:16" />azoi redt der vos hert G-ts verter,</para>
  <para style="q" vid="NUM 24:16">un veis dem visen fun dem Elyon –</para>
  <para style="q" vid="NUM 24:16">di zeung fun Shaddai tut er zen,</para>
  <para style="q" vid="NUM 24:16">gefaln, mit oign antplekte:<verse eid="NUM 24:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="NUM 24:17" />ich ze im, ober nisht atsund,</para>
  <para style="q" vid="NUM 24:17">ich kuk im on, ober nisht nont;</para>
  <para style="q" vid="NUM 24:17">a shtern tret arois fun Yaakov,</para>
  <para style="q" vid="NUM 24:17">un a skepter vet oifshtein fun Yisroel,</para>
  <para style="q" vid="NUM 24:17">un vet tsehakn di vinklen fun Moav,</para>
  <para style="q" vid="NUM 24:17">un tsebrechn ale kinder fun Shet.<verse eid="NUM 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="NUM 24:18" />un Edom vet vern an arav,</para>
  <para style="q" vid="NUM 24:18">un an arav vet vern Seir, zain faint;</para>
  <para style="q" vid="NUM 24:18">un Yisroel vet oifton gevuros.<verse eid="NUM 24:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NUM 24:19" />un fun Yaakov vet einer geveltikn,</para>
  <para style="q" vid="NUM 24:19">un unterbrengen an iberblaib fun shtot.<verse eid="NUM 24:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20" />un er hot gezen Amalek, un hot oifgehoibn zain shpruch, un hot gezogt:</para>
  <para style="b" vid="NUM 24:20" />
  <para style="q" vid="NUM 24:20">der onheib fun felker iz Amalek,</para>
  <para style="q" vid="NUM 24:20">un zain sof iz tsum untergang.<verse eid="NUM 24:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21" />un er hot gezen dem Keni, un hot oifgehoibn zain shpruch, un hot gezogt:</para>
  <para style="b" vid="NUM 24:21" />
  <para style="q" vid="NUM 24:21">fest iz dain voinung,</para>
  <para style="q" vid="NUM 24:21">un gemacht in feldz iz dain nest;<verse eid="NUM 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="NUM 24:22" />ober tsum fartiliken vet zain Kayin;</para>
  <para style="q" vid="NUM 24:22">eider vos vet Ashur dich fangen.<verse eid="NUM 24:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23" />un er hot oifgehoibn zain Mashal, un hot gezogt:</para>
  <para style="b" vid="NUM 24:23" />
  <para style="q" vid="NUM 24:23">vei, ver ken lebn ven El vet dos dozike ton?<verse eid="NUM 24:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="NUM 24:24" />ober shifn veln kumen fun dem breg fun di Kittim,</para>
  <para style="q" vid="NUM 24:24">un zei veln painiken Ashur, un painiken Ever;</para>
  <para style="q" vid="NUM 24:24">un er oich iz tsum untergang.<verse eid="NUM 24:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25" />un Bilaam iz oifgeshtanen un iz avekgegangen, un hot zich umgekert tsu zain heim, un oich Balak iz gegangen oif zain veg.<verse eid="NUM 24:25" /></para>
  <chapter eid="NUM 24" />
  <chapter number="25" style="c" pubnumber="כה" sid="NUM 25" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1" />un Yisroel iz gezesn in Shitim, un dos folk hot genumen mizane zain mit di techter fun Moav. <verse eid="NUM 25:1" /><verse number="2" style="v" sid="NUM 25:2" />un zei hobn gerufn dos folk tsu di shlachtopfer fun zeyere g‑ter, un dos folk hot gegesn, un hot zich gebukt tsu zeyere g‑ter. <verse eid="NUM 25:2" /><verse number="3" style="v" sid="NUM 25:3" />un Yisroel hot zich baheft on dem Baal fun Peor, un der tsorn fun Hashem hot gegrimt oif Yisroel. <verse eid="NUM 25:3" /><verse number="4" style="v" sid="NUM 25:4" />hot Hashem gezogt tsu Mosheen: nem ale hoiptlait fun dem folk, un heng zei oif far Hashem akegn der zun, un der grimtsorn fun Hashem vet zich opkeren fun Yisroel. <verse eid="NUM 25:4" /><verse number="5" style="v" sid="NUM 25:5" />un Moshe hot gezogt tsu di richter fun Yisroel: harget itlecher zaine mentshn vos hobn zich baheft on dem Baal fun Peor.<verse eid="NUM 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6" />ersht a man fun di kinder fun Yisroel iz gekumen, un hot gebracht tsu zaine brider a midionit far di oign fun Mosheen, un far di oign fun der gantser eide fun di kinder fun Yisroel, beeis zei hobn geveint baim aingang fun ohel-moed. <verse eid="NUM 25:6" /><verse number="7" style="v" sid="NUM 25:7" />hot derzen Pinchas der zun fun Elazar, dem zun fun Aharon dem koyen, un er iz oifgeshtanen fun tsvishn der eide, un hot genumen a shpiz in zain hant; <verse eid="NUM 25:7" /><verse number="8" style="v" sid="NUM 25:8" />un er iz araingegangen noch dem man fun Yisroel in der kamer, un hot zei beidn durchgeshtochn, dem man fun Yisroel, un di froi durch ir boich. un di mageyfe iz farhaltn gevorn fun di kinder fun Yisroel. <verse eid="NUM 25:8" /><verse number="9" style="v" sid="NUM 25:9" />un di vos zainen geshtorbn in der mageyfe, zainen geven fir un tsvantsik toiznt.<verse eid="NUM 25:9" /></para>
  <para style="s1">Pinchas</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 25:10" /><verse number="11" style="v" sid="NUM 25:11" />Pinchas der zun fun Elazar, dem zun fun Aharon dem koyen, hot opgekert main grimtsorn fun di kinder fun Yisroel mit vos er hot zich ongenumen fun mainetvegn tsvishn zei, un ich hob nisht farlendt di kinder fun Yisroel in main kine. <verse eid="NUM 25:11" /><verse number="12" style="v" sid="NUM 25:12" />derum zog: ze, ich gib im main bris fun sholem. <verse eid="NUM 25:12" /><verse number="13" style="v" sid="NUM 25:13" />un es zol zain im un zain zomen noch im a bris fun eibiker kehune, derfar vos er hot zich ongenumen fun zain G-ts vegen, un hot mechaper geven oif di kinder fun Yisroel.<verse eid="NUM 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14" />un der nomen fun dem dershlogenem man fun Yisroel, vos iz dershlogn gevorn mit der midionit, iz geven Zimri der zun fun Saluen, a firsht fun a foterhoiz bai di Shimeonim. <verse eid="NUM 25:14" /><verse number="15" style="v" sid="NUM 25:15" />un der nomen fun der dershlogener midionisher froi iz geven Kozbi di tochter fun Tsurn, vos iz geven a folkhoiptman fun a foterhoiz in Midyan.<verse eid="NUM 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 25:16" /><verse number="17" style="v" sid="NUM 25:17" />ir zolt faintn di Midyanim, un zei shlogn, <verse eid="NUM 25:17" /><verse number="18" style="v" sid="NUM 25:18" />vorem zei hobn aich gefaint mit zeyere tachbulos vos zei hobn oisgeklert akegn aich in der meise fun Peor, un in der meise mit Kozbi der tochter fun dem firsht fun Midyan, zeyer shvester vos iz dershlogn gevorn in tog fun der mageyfe, in der meise fun Peor.<verse eid="NUM 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="26.1" sid="NUM 25:19" /> un es iz geven noch der mageyfe,<verse eid="NUM 25:19" /></para>
  <chapter eid="NUM 25" />
  <chapter number="26" style="c" pubnumber="כו" sid="NUM 26" />
  <para style="nb">
    <verse number="1" style="v" sid="NUM 26:1" />hot Hashem gezogt tsu Mosheen un tsu Elazar dem zun fun Aharon dem koyen, azoi tsu zogn: <verse eid="NUM 26:1" /><verse number="2" style="v" sid="NUM 26:2" />nemt oif di tsol fun der gantser eide fun di kinder fun Yisroel, fun tsvantsik yor alt un hecher, loit zeyere foterhaizer, itlechn vos geit arois in cheil in Yisroel.<verse eid="NUM 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 26:3" />un Moshe un Elazar der koyen hobn geredt mit zei in di ploinen fun Moav baim Yarden lebn Yericho, azoi tsu zogn: <verse eid="NUM 26:3" /><verse number="4" style="v" sid="NUM 26:4" />me zol oifnemen fun tsvantsik yor alt un hecher, azoi vi Hashem hot bafoiln Mosheen, un di kinder fun Yisroel vos zainen aroisgegangen fun land Mitsrayim.<verse eid="NUM 26:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 26:5" />Reuven, der bechor fun Yisroeln: di kinder fun Reuven: Chanoch – di mishpoche fun di Chanochim; fun Palluen di mishpoche fun di Palluim; <verse eid="NUM 26:5" /><verse number="6" style="v" sid="NUM 26:6" />fun Chetsronen di mishpoche fun di Chetsronim; fun Karmien di mishpoche fun di Karmim. <verse eid="NUM 26:6" /><verse number="7" style="v" sid="NUM 26:7" />dos zainen di mishpoches fun di Reuvenim; un zeyere getseilte zainen geven drai un fertsik toiznt un zibn hundert un draisik. <verse eid="NUM 26:7" /><verse number="8" style="v" sid="NUM 26:8" />un di zin fun Palluen: Eliav.<verse eid="NUM 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 26:9" />un di zin fun Eliavn: Nemuel, un Dotan, un Aviram. dos zainen Dotan un Aviram, di gerufene fun der eide, vos hobn gekrigt akegn Mosheen un akegn Aharonen in Korachs gezeml, ven zei hobn gekrigt akegn Hashem; <verse eid="NUM 26:9" /><verse number="10" style="v" sid="NUM 26:10" />un di erd hot geefent ir moil, un hot aingeshlungen zei un Korachn, ven dos gezeml iz umgekumen; ven a faier hot fartsert di tsvei hundert un fuftsik man, un zei zainen gevorn far a tseichn. <verse eid="NUM 26:10" /><verse number="11" style="v" sid="NUM 26:11" />ober Korachs zin zainen nisht umgekumen.<verse eid="NUM 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 26:12" />di kinder fun Shimeon loit zeyere mishpoches: fun Nemueln di mishpoche fun di Nemuelim; fun Yaminen di mishpoche fun di Yaminim; fun Yachinen di mishpoche fun di Yachinim; <verse eid="NUM 26:12" /><verse number="13" style="v" sid="NUM 26:13" />fun Zerachn di mishpoche fun di Zerachim; fun Shauln di mishpoche fun di Shaulim. <verse eid="NUM 26:13" /><verse number="14" style="v" sid="NUM 26:14" />dos zainen di mishpoches fun di Shimeonim, tsvei un tsvantsik toiznt un tsvei hundert.<verse eid="NUM 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 26:15" />di kinder fun Gad loit zeyere mishpoches: fun TSafonen di mishpoche fun di TSafonim; fun Chagien di mishpoche fun di Chagim; fun Shunien di mishpoche fun di Shunim; <verse eid="NUM 26:15" /><verse number="16" style="v" sid="NUM 26:16" />fun Oznien di mishpoche fun di Oznim; fun Erien di mishpoche fun di Erim; <verse eid="NUM 26:16" /><verse number="17" style="v" sid="NUM 26:17" />fun Arodn di mishpoche fun di Arodim; fun Arelien di mishpoche fun di Arelim. <verse eid="NUM 26:17" /><verse number="18" style="v" sid="NUM 26:18" />dos zainen di mishpoches fun di kinder fun Gad loit zeyere getseilte, fertsik toiznt un finf hundert.<verse eid="NUM 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 26:19" />di zin fun Yehudahn: Er un Onan. un Er un Onan zainen geshtorbn in land Kenaan. <verse eid="NUM 26:19" /><verse number="20" style="v" sid="NUM 26:20" />un di kinder fun Yehudah loit zeyere mishpoches zainen geven: fun Shelahn di mishpoche fun di Shelanim; fun Peretsn di mishpoche fun Peretsim; fun Zerachn di mishpoche fun di Zerachim. <verse eid="NUM 26:20" /><verse number="21" style="v" sid="NUM 26:21" />un di kinder fun Perets zainen geven: fun Chetsronen di mishpoche fun di Chetsronim; fun Chamuln di mishpoche fun di Chamulim. <verse eid="NUM 26:21" /><verse number="22" style="v" sid="NUM 26:22" />dos zainen di mishpoches fun Yehudah loit zeyere getseilte, zeks un zibetsik toiznt un finf hundert.<verse eid="NUM 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 26:23" />di kinder fun Yissachar loit zeyere mishpoches: Tola – di mishpoche fun di Tolaim; fun Puvahn di mishpoche fun di Punim; <verse eid="NUM 26:23" /><verse number="24" style="v" sid="NUM 26:24" />fun Yashuvn di mishpoche fun di Yashuvim; fun Shimronen di mishpoche fun di Shimronim. <verse eid="NUM 26:24" /><verse number="25" style="v" sid="NUM 26:25" />dos zainen di mishpoches fun Yissachar loit zeyere getseilte, fir un zechtsik toiznt un drai hundert.<verse eid="NUM 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 26:26" />di kinder fun Zevulun loit zeyere mishpoches: fun Seredn di mishpoche fun di Seredim; fun Elonen di mishpoche fun di Elonim; fun Yachleiln di mishpoche fun di Yachleilim. <verse eid="NUM 26:26" /><verse number="27" style="v" sid="NUM 26:27" />dos zainen di mishpoches fun di Zevulunim loit zeyere getseilte, zechtsik toiznt un finf hundert.<verse eid="NUM 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 26:28" />di kinder fun Yosef loit zeyere mishpoches: Menasheh un Efrayim. <verse eid="NUM 26:28" /><verse number="29" style="v" sid="NUM 26:29" />di kinder fun Menasheh: fun Machiren di mishpoche fun di Machirim; un Machir hot geborn Giladn; fun Giladn di mishpoche fun di Giladim. <verse eid="NUM 26:29" /><verse number="30" style="v" sid="NUM 26:30" />dos zainen di kinder fun Gilad: Iezer – di mishpoche fun di Iezerim; fun Chelekn di mishpoche fun di Chelekim; <verse eid="NUM 26:30" /><verse number="31" style="v" sid="NUM 26:31" />un Asriel – di mishpoche fun di Asrielim; un Shechem – di mishpoche fun di Shichmim; <verse eid="NUM 26:31" /><verse number="32" style="v" sid="NUM 26:32" />un Shemida – di mishpoche fun di Shemidaim; un Chefer – di mishpoche fun di Cheferim.<verse eid="NUM 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 26:33" />un Tselofechad der zun fun Cheferen, er hot nisht gehat kein zin, nor bloiz techter; un di nemen fun Tselofechads techter zainen geven: Machlah, un Noah, Choglah, Milcah, un Tirtsah. <verse eid="NUM 26:33" /><verse number="34" style="v" sid="NUM 26:34" />dos zainen di mishpoches fun Menasheh; un zeyere getseilte zainen geven tsvei un fuftsik toiznt un zibn hundert.<verse eid="NUM 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 26:35" />dos zainen di kinder fun Efrayim loit zeyere mishpoches: fun Shutelachn di mishpoche fun di Shutelachim; fun Becheren di mishpoche fun di Becherim; fun Tachanen di mishpoche fun di Tachanim. <verse eid="NUM 26:35" /><verse number="36" style="v" sid="NUM 26:36" />un dos zainen di kinder fun Shutelach: fun Eranen di mishpoche fun di Eranim. <verse eid="NUM 26:36" /><verse number="37" style="v" sid="NUM 26:37" />dos zainen di mishpoches fun di kinder fun Efrayim loit zeyere getseilte, tsvei un draisik toiznt un finf hundert. dos zainen di kinder fun Yosef loit zeyere mishpoches.<verse eid="NUM 26:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 26:38" />di kinder fun Binyaminen loit zeyere mishpoches: fun Belen di mishpoche fun di Belaim; fun Ashbeln di mishpoche fun di Ashbelim; fun Achiramen di mishpoche fun di Achiramim; <verse eid="NUM 26:38" /><verse number="39" style="v" sid="NUM 26:39" />fun Shefufamen di mishpoche fun di Shufamim; fun Chufamen di mishpoche fun di Chufamim. <verse eid="NUM 26:39" /><verse number="40" style="v" sid="NUM 26:40" />un di zin fun Belen zainen geven Ard un Naaman. fun Ardon di mishpoche fun di Ardim; fun Naamanen di mishpoche fun di Naamanim. <verse eid="NUM 26:40" /><verse number="41" style="v" sid="NUM 26:41" />dos zainen di kinder fun Binyamin loit zeyere mishpoches; un zeyere getseilte zainen geven finf un fertsik toiznt un zeks hundert.<verse eid="NUM 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 26:42" />dos zainen di kinder fun Dan loit zeyere mishpoches: fun Shuchamen di mishpoche fun di Shuchamim. dos zainen di mishpoches fun Dan loit zeyere mishpoches. <verse eid="NUM 26:42" /><verse number="43" style="v" sid="NUM 26:43" />ale mishpoches fun di Shuchamim loit zeyere getseilte zainen geven fir un zechtsik toiznt un fir hundert.<verse eid="NUM 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 26:44" />di kinder fun Asher loit zeyere mishpoches: fun Yimnahn di mishpoche fun Yimnah; fun Yishvien di mishpoche fun di Yishvim; fun Beriahn di mishpoche fun di Beriim. <verse eid="NUM 26:44" /><verse number="45" style="v" sid="NUM 26:45" />fun di zin fun Beriahn: fun Chever di mishpoche fun di Cheverim; fun Malkieln di mishpoche fun di Malkielim. <verse eid="NUM 26:45" /><verse number="46" style="v" sid="NUM 26:46" />un der nomen fun Ashers tochter iz geven Serach. <verse eid="NUM 26:46" /><verse number="47" style="v" sid="NUM 26:47" />dos zainen di mishpoches fun di kinder fun Asher loit zeyere getseilte, drai un fuftsik toiznt un fir hundert.<verse eid="NUM 26:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 26:48" />di kinder fun Naftali loit zeyere mishpoches: fun Yachtseiln di mishpoche fun di Yachtseilim; fun Gunin di mishpoche fun di Gunim; <verse eid="NUM 26:48" /><verse number="49" style="v" sid="NUM 26:49" />fun Yetsern di mishpoche fun di Yitsrim; fun Shilemen di mishpoche fun di Shilemim.<verse eid="NUM 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 26:50" />dos zainen di mishpoches fun Naftali loit zeyere mishpoches; un zeyere getseilte zainen geven finf un fertsik toiznt un fir hundert.<verse eid="NUM 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 26:51" />dos zainen di getseilte fun di kinder fun Yisroel, zeks hundert toiznt un toiznt zibn hundert un draisik.<verse eid="NUM 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 26:52" /><verse number="53" style="v" sid="NUM 26:53" />tsu di dozike zol aingeteilt vern dos land far a nachle loit der tsol fun nemen. <verse eid="NUM 26:53" /><verse number="54" style="v" sid="NUM 26:54" />dem merern zolstu gebn mer nachle, un dem vintsikern zolstu gebn vintsiker nachle; <verse eid="NUM 26:54" /><verse number="55" style="v" sid="NUM 26:55" />itlechn loit zaine getseilte zol gegebn vern zain nachle. ober durch goirl zol tseteilt vern dos land; loit di nemen fun zeyere fotershtamen zoln zei arben. <verse eid="NUM 26:55" /><verse number="56" style="v" sid="NUM 26:56" />loitn goirl zol zeyer nachle vern, sai dem merern sai dem vintsikern.<verse eid="NUM 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="NUM 26:57" />un dos zainen di getseilte fun di Leviim loit zeyere mishpoches: fun Gershonen di mishpoche fun di Gershonim; fun Kohatn di mishpoche fun di Kehatim; fun Merarien di mishpoche fun di Merarim. <verse eid="NUM 26:57" /><verse number="58" style="v" sid="NUM 26:58" />dos zainen di mishpoches fun Levi: di mishpoche fun di Livnim, di mishpoche fun di Chevronim, di mishpoche fun di Machlim, di mishpoche fun di Mushim, di mishpoche fun di Korachim. un Kohat hot geborn Amramen. <verse eid="NUM 26:58" /><verse number="59" style="v" sid="NUM 26:59" />un der nomen fun Amrams vaib iz geven Yocheved, Levis tochter vos iz geborn gevorn bai Levin in Mitsrayim; un zi hot fun Amramen geborn Aharonen un Mosheen, un zeyer shvester Miryam. <verse eid="NUM 26:59" /><verse number="60" style="v" sid="NUM 26:60" />un bai Aharonen zainen geborn gevorn Nadav, un Avihu, Elazar, un Itamar. <verse eid="NUM 26:60" /><verse number="61" style="v" sid="NUM 26:61" />un Nadav un Avihu zainen geshtorbn ven zei hobn gebracht fremd faier far Hashem.<verse eid="NUM 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="NUM 26:62" />un zeyere getseilte zainen geven drai un tsvantsik toiznt, ale mansparshoinen fun a choidesh alt un hecher; vorem zei zainen nisht getseilt gevorn tsvishn di kinder fun Yisroel, vail zei iz nisht gegebn gevorn kein nachle tsvishn di kinder fun Yisroel.<verse eid="NUM 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63" />dos zainen di vos zainen getseilt gevorn fun Mosheen un Elazar dem koyen, vos hobn getseilt di kinder fun Yisroel in di ploinen fun Moav baim Yarden lebn Yericho. <verse eid="NUM 26:63" /><verse number="64" style="v" sid="NUM 26:64" />un tsvishn di dozike iz nisht geven keiner fun di vos zainen getseilt gevorn fun Mosheen un Aharon dem koyen, vos hobn getseilt di kinder fun Yisroel in midber Sinai. <verse eid="NUM 26:64" /><verse number="65" style="v" sid="NUM 26:65" />vorem Hashem hot vegen zei gezogt: shtarbn in midber veln zei shtarbn; un keiner fun zei iz nisht geblibn achuts Kalev der zun fun Yefunehn, un Yehoshua der zun fun Nun.<verse eid="NUM 26:65" /></para>
  <chapter eid="NUM 26" />
  <chapter number="27" style="c" pubnumber="כז" sid="NUM 27" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1" />hobn genent di techter fun Tselofechad dem zun fun Chefer, dem zun fun Gilad, dem zun fun Machir, dem zun fun Menashehn, fun di mishpoches fun Menasheh, Yosefs zun – un dos zainen geven di nemen fun zaine techter: Machlah, Noah, un Choglah, un Milcah, un Tirtsah –<verse eid="NUM 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 27:2" />un zei hobn zich geshtelt far Mosheen un far Elazar dem koyen, un far di firshtn un der gantser eide, baim aingang fun ohel-moed, azoi tsu zogn: <verse eid="NUM 27:2" /><verse number="3" style="v" sid="NUM 27:3" />undzer foter iz geshtorbn in der midber, un er iz nisht geven tsvishn dem gezeml vos hot zich aingezamlt akegn Hashem in Korachs gezeml, naiert in zain eigener zind iz er geshtorbn; un kein zin hot er nisht gehat.<verse eid="NUM 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 27:4" />far vos zol geminert vern der nomen fun undzer foter fun tsvishn zain mishpoche, vail er hot nisht kein zun? gib undz an eigentum tsvishn di brider fun undzer foter.<verse eid="NUM 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5" />hot Moshe gebracht zeyer mishpot far Hashem. <verse eid="NUM 27:5" /><verse number="6" style="v" sid="NUM 27:6" />un Hashem hot gezogt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 27:6" /><verse number="7" style="v" sid="NUM 27:7" />gerecht tenhn di techter fun Tselofechadn: gebn zolstu zei gebn an eigentum fun a nachle tsvishn di brider fun zeyer foter, un zolst machn ibergein di nachle fun zeyer foter tsu zei. <verse eid="NUM 27:7" /><verse number="8" style="v" sid="NUM 27:8" />un tsu di kinder fun Yisroel zolstu redn, azoi tsu zogn: az a man vet shtarbn, un er hot nisht kein zun, zolt ir machn ibergein zain nachle tsu zain tochter. <verse eid="NUM 27:8" /><verse number="9" style="v" sid="NUM 27:9" />un oib er hot nisht kein tochter, zolt ir gebn zain nachle tsu zaine brider.<verse eid="NUM 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 27:10" />un oib er hot nisht kein brider, zolt ir gebn zain nachle tsu di brider fun zain foter. <verse eid="NUM 27:10" /><verse number="11" style="v" sid="NUM 27:11" />un oib zain foter hot nisht kein brider, zolt ir gebn zain nachle tsu zain nentstn korev fun zain mishpoche, un er zol zi yarshen. un dos zol zain di kinder fun Yisroel far a recht-gezets, azoi vi Hashem hot bafoiln Mosheen.<verse eid="NUM 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12" />un Hashem hot gezogt tsu Mosheen: gei aroif oif dem dozikn barg Avarim, un kuk on dos land, vos ich hob gegebn tsu di kinder fun Yisroel. <verse eid="NUM 27:12" /><verse number="13" style="v" sid="NUM 27:13" />un az du vest es hobn ongekukt, vest du oich aingezamlt vern tsu dain folk, azoi vi dain bruder Aharon iz aingezamlt gevorn. <verse eid="NUM 27:13" /><verse number="14" style="v" sid="NUM 27:14" />azoi vi ir hot vidershpenikt main bafel, in midber Tsin bai dem krig fun der eide, mich tsu heilikn baim vaser far zeyere oign. dos iz dos vaser fun Merivat-Kadesh in midber Tsin.<verse eid="NUM 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15" />hot Moshe geredt tsu Hashem, azoi tsu zogn: <verse eid="NUM 27:15" /><verse number="16" style="v" sid="NUM 27:16" />zol Hashem der G-t fun di gaister fun ale mentshn oifzetsn a man iber der eide, <verse eid="NUM 27:16" /><verse number="17" style="v" sid="NUM 27:17" />vos zol aroisgein zei farois, un vos zol arainkumen zei farois, un vos zol zei aroisfirn, un vos zol zei arainbrengen, kedei di eide fun Hashem zol nisht zain azoi vi shof vos hobn nisht kein pastuch.<verse eid="NUM 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18" />hot Hashem gezogt tsu Mosheen: nem dir Yehoshua dem zun fun Nun, a man vos in im iz der ruach, un zolst onlenen dain hant oif im. <verse eid="NUM 27:18" /><verse number="19" style="v" sid="NUM 27:19" />un zolst im shteln far Elazar dem koyen, un far der gantser eide, un zolst im ibergebn dain tsevaeh far zeyere oign. <verse eid="NUM 27:19" /><verse number="20" style="v" sid="NUM 27:20" />un zolst aroifton fun dain glants oif im, kedei di gantse eide fun di kinder fun Yisroel zoln gehorchn. <verse eid="NUM 27:20" /><verse number="21" style="v" sid="NUM 27:21" />un er zol shtein far Elazar dem koyen, un er vet fregn far im dem basheid fun di Urim far Hashem. loit zain moil zoln zei aroisgein, un loit zain moil zoln zei arainkumen, er un gants Yisroel mit im – di gantse eide.<verse eid="NUM 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22" />hot Moshe geton azoi vi Hashem hot im bafoiln, un er hot genumen Yehoshuaen, un hot im geshtelt far Elazar dem koyen, un far der gantser eide. <verse eid="NUM 27:22" /><verse number="23" style="v" sid="NUM 27:23" />un er hot ongelent zaine hent oif im, un hot im ibergegebn zain tsevaeh, azoi vi Hashem hot geredt durch Mosheen.<verse eid="NUM 27:23" /></para>
  <chapter eid="NUM 27" />
  <chapter number="28" style="c" pubnumber="כח" sid="NUM 28" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 28:1" /><verse number="2" style="v" sid="NUM 28:2" />bafel di kinder fun Yisroel, un zolst zogn tsu zei: main korben, main shpaiz fun maine faieropfer, far a geshmakn reyech tsu mir, zolt ir hitn makrev tsu zain tsu mir in zain geshtelter tsait. <verse eid="NUM 28:2" /><verse number="3" style="v" sid="NUM 28:3" />un zolst zogn tsu zei: dos iz dos faieropfer vos ir zolt makrev zain tsu Hashem: tsvei shepsn yorike, on a feler, a tog, a shtendik brandopfer. <verse eid="NUM 28:3" /><verse number="4" style="v" sid="NUM 28:4" />ein sheps zolstu machn in der peire, un dem tsveitn zolstu machn kegen ovnt. <verse eid="NUM 28:4" /><verse number="5" style="v" sid="NUM 28:5" />un a tsentl eife zemelmel far a shpaizopfer, farmisht mit geshlogenem eil, a fertl hin. <verse eid="NUM 28:5" /><verse number="6" style="v" sid="NUM 28:6" />a shtendik brandopfer, azoi vi es iz gemacht gevorn baim barg Sinai, far a geshmakn reyech, a faieropfer tsu Hashem. <verse eid="NUM 28:6" /><verse number="7" style="v" sid="NUM 28:7" />un zain gisopfer: a fertl hin tsu dem ein sheps; in heiliktum zolstu gisn dos gisopfer fun shtarkn getrank tsu Hashem. <verse eid="NUM 28:7" /><verse number="8" style="v" sid="NUM 28:8" />un dem tsveitn sheps zolstu machn kegen ovnt; azoi vi dos shpaizopfer fun in der peire, un azoi vi zain gisopfer, zolstu machn, a faieropfer far a geshmakn reyech tsu Hashem.<verse eid="NUM 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9" />un in tog fun Shabbos: tsvei shepsn yorike on a feler, un tsvei tsentl zemelmel, a shpaizopfer, farmisht mit eil, mit zain gisopfer; <verse eid="NUM 28:9" /><verse number="10" style="v" sid="NUM 28:10" />a brandopfer fun Shabbos in Shabbos, achuts dem shtendikn brandopfer un zain gisopfer.<verse eid="NUM 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11" />un in aiere rosh-choideshn zolt ir makrev zain a brandopfer tsu Hashem: tsvei yunge oksen, un ein vider; zibn shepsn yorike, on a feler. <verse eid="NUM 28:11" /><verse number="12" style="v" sid="NUM 28:12" />un drai tsentl zemelmel, a shpaizopfer, farmisht mit eil, tsu itlechn oks, un tsvei tsentl zemelmel, a shpaizopfer, farmisht mit eil, tsu dem ein vider; <verse eid="NUM 28:12" /><verse number="13" style="v" sid="NUM 28:13" />un tsu tsentl, tsu tsentl zemelmel, a shpaizopfer, farmisht mit eil, tsu itlechn sheps. a brandopfer far a geshmakn reyech, a faieropfer tsu Hashem. <verse eid="NUM 28:13" /><verse number="14" style="v" sid="NUM 28:14" />un zeyere gisopfer: a halber hin vain zol zain tsu an oks, un a dritel hin tsu a vider, un a fertl hin tsu a sheps. dos iz dos brandopfer fun rosh-choidesh in rosh-choidesh far di chodeshim fun yor. <verse eid="NUM 28:14" /><verse number="15" style="v" sid="NUM 28:15" />un ein tsignbok far a zindopfer tsu Hashem, achuts dem shtendikn brandopfer, zol gemacht vern, mit zain gisopfer.<verse eid="NUM 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16" />un in ershtn choidesh, in fertsntn tog fun choidesh, zol zain a korben-Pesach tsu Hashem. <verse eid="NUM 28:16" /><verse number="17" style="v" sid="NUM 28:17" />un in fuftsntn tog fun dem dozikn choidesh, zol zain a yom-tov. zibn teg zol gegesn vern matsus. <verse eid="NUM 28:17" /><verse number="18" style="v" sid="NUM 28:18" />in ershtn tog zol zain a heilike farzamlunge; kein dinstarbet zolt ir nisht ton. <verse eid="NUM 28:18" /><verse number="19" style="v" sid="NUM 28:19" />un ir zolt makrev zain a faieropfer, a brandopfer tsu Hashem: tsvei yunge oksen, un ein vider, un zibn shepsn yorike; on a feler zoln zei bai aich zain. <verse eid="NUM 28:19" /><verse number="20" style="v" sid="NUM 28:20" />un zeyer shpaizopfer: zemelmel farmisht mit eil; drai tsentl tsu an oks, un tsvei tsentl tsu a vider, zolt ir machn. <verse eid="NUM 28:20" /><verse number="21" style="v" sid="NUM 28:21" />tsu tsentl, tsu tsentl zolstu machn far itlechn sheps fun di zibn shepsn. <verse eid="NUM 28:21" /><verse number="22" style="v" sid="NUM 28:22" />un ein bok a zindopfer, mechaper tsu zain oif aich. <verse eid="NUM 28:22" /><verse number="23" style="v" sid="NUM 28:23" />achuts dem brandopfer fun in der peire, vos faran shtendikn brandopfer, zolt ir machn di dozike. <verse eid="NUM 28:23" /><verse number="24" style="v" sid="NUM 28:24" />azoi vi di dozike zolt ir machn teglech zibn teg, a shpaiz fun faieropfer far a geshmakn reyech tsu Hashem. achuts dem shtendikn brandopfer zol es gemacht vern, mit zain gisopfer. <verse eid="NUM 28:24" /><verse number="25" style="v" sid="NUM 28:25" />un oifn zibetn tog zol zain a heilike farzamlunge bai aich; kein dinstarbet zolt ir nisht ton.<verse eid="NUM 28:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26" />un in tog fun di ershttsaitike, ven ir brengt a shpaizopfer fun naier tvue tsu Hashem, in aier shvues, zol zain a heilike farzamlunge bai aich; kein dinstarbet zolt ir nisht ton. <verse eid="NUM 28:26" /><verse number="27" style="v" sid="NUM 28:27" />un ir zolt makrev zain a brandopfer far a geshmakn reyech tsu Hashem: tsvei yunge oksen, ein vider, zibn shepsn yorike. <verse eid="NUM 28:27" /><verse number="28" style="v" sid="NUM 28:28" />un zeyer shpaizopfer: zemelmel farmisht mit eil, drai tsentl tsu itlechn oks, tsvei tsentl tsu dem ein vider; <verse eid="NUM 28:28" /><verse number="29" style="v" sid="NUM 28:29" />tsu tsentl, tsu tsentl far itlechn sheps fun di zibn shepsn. <verse eid="NUM 28:29" /><verse number="30" style="v" sid="NUM 28:30" />ein tsignbok, mechaper tsu zain oif aich. <verse eid="NUM 28:30" /><verse number="31" style="v" sid="NUM 28:31" />achuts dem shtendikn brandopfer un zain shpaizopfer zolt ir zei machn – on a feler zoln zei bai aich zain – mit zeyere gisopfer.<verse eid="NUM 28:31" /></para>
  <chapter eid="NUM 28" />
  <chapter number="29" style="c" pubnumber="כט" sid="NUM 29" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1" />un in zibetn choidesh, in ershtn tog fun choidesh, zol zain a heilike farzamlunge bai aich, kein dinstarbet zolt ir nisht ton; a tog fun shalung zol es aich zain. <verse eid="NUM 29:1" /><verse number="2" style="v" sid="NUM 29:2" />un ir zolt machn a brandopfer far a geshmakn reyech tsu Hashem: ein yungn oks, ein vider, zibn shepsn yorike, on a feler. <verse eid="NUM 29:2" /><verse number="3" style="v" sid="NUM 29:3" />un zeyer shpaizopfer: zemelmel farmisht mit eil, drai tsentl tsu dem oks, tsvei tsentl tsu dem vider, <verse eid="NUM 29:3" /><verse number="4" style="v" sid="NUM 29:4" />un ein tsentl tsu itlechn sheps fun di zibn shepsn. <verse eid="NUM 29:4" /><verse number="5" style="v" sid="NUM 29:5" />un ein tsignbok a zindopfer, mechaper tsu zain oif aich. <verse eid="NUM 29:5" /><verse number="6" style="v" sid="NUM 29:6" />achuts dem brandopfer fun rosh-choidesh un zain shpaizopfer, un dem shtendikn brandopfer un zain shpaizopfer, un zeyere gisopfer, loit zeyer din, far a geshmakn reyech, a faieropfer tsu Hashem.<verse eid="NUM 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7" />un in tsentn tog fun dem dozikn zibetn choidesh zol zain a heilike farzamlunge bai aich; un ir zolt painiken aier zel; kein arbet zolt ir nisht ton. <verse eid="NUM 29:7" /><verse number="8" style="v" sid="NUM 29:8" />un ir zolt makrev zain a brandopfer tsu Hashem far a geshmakn reyech: ein yungn oks, ein vider, zibn shepsn yorike; on a feler zoln zei bai aich zain. <verse eid="NUM 29:8" /><verse number="9" style="v" sid="NUM 29:9" />un zeyer shpaizopfer: zemelmel farmisht mit eil, drai tsentl tsu dem oks, tsvei tsentl tsu dem ein vider; <verse eid="NUM 29:9" /><verse number="10" style="v" sid="NUM 29:10" />tsu tsentl, tsu tsentl far itlechn sheps fun di zibn shepsn. <verse eid="NUM 29:10" /><verse number="11" style="v" sid="NUM 29:11" />ein tsignbok a zindopfer. achuts dem zindopfer fun fargebung, un dem shtendikn brandopfer un zain shpaizopfer, un zeyere gisopfer.<verse eid="NUM 29:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12" />un in fuftsntn tog fun zibetn choidesh zol zain a heilike farzamlunge bai aich; kein dinstarbet zolt ir nisht ton. un ir zolt faiern a faiertog tsu Hashem zibn teg. <verse eid="NUM 29:12" /><verse number="13" style="v" sid="NUM 29:13" />un ir zolt makrev zain a korben brandopfer, a faieropfer, far a geshmakn reyech tsu Hashem: draitsn yunge oksen, tsvei viders, fertsn shepsn yorike; on a feler zoln zei zain. <verse eid="NUM 29:13" /><verse number="14" style="v" sid="NUM 29:14" />un zeyer shpaizopfer: zemelmel farmisht mit eil, drai tsentl tsu itlechn oks fun di draitsn oksen, tsvei tsentl tsu itlechn vider fun di tsvei viders, <verse eid="NUM 29:14" /><verse number="15" style="v" sid="NUM 29:15" />un tsu tsentl, tsu tsentl far itlechn sheps fun di fertsn shepsn. <verse eid="NUM 29:15" /><verse number="16" style="v" sid="NUM 29:16" />un ein tsignbok a zindopfer; achuts dem shtendikn brandopfer, zain shpaizopfer un zain gisopfer.<verse eid="NUM 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17" />un oifn tsveitn tog: tsvelf yunge oksen, tsvei viders, fertsn shepsn yorike, on a feler. <verse eid="NUM 29:17" /><verse number="18" style="v" sid="NUM 29:18" />un zeyer shpaizopfer un zeyere gisopfer, tsu di oksen, tsu di viders, un tsu di shepsn, loit zeyer tsol, azoi vi der din. <verse eid="NUM 29:18" /><verse number="19" style="v" sid="NUM 29:19" />un ein tsignbok a zindopfer. achuts dem shtendikn brandopfer un zain shpaizopfer, un zeyere gisopfer.<verse eid="NUM 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20" />un oifn dritn tog: elf yunge oksen, tsvei viders, fertsn shepsn yorike, on a feler. <verse eid="NUM 29:20" /><verse number="21" style="v" sid="NUM 29:21" />un zeyer shpaizopfer un zeyere gisopfer, tsu di oksen, tsu di viders, un tsu di shepsn, loit zeyer tsol azoi vi der din. <verse eid="NUM 29:21" /><verse number="22" style="v" sid="NUM 29:22" />un ein bok a zindopfer. achuts dem shtendikn brandopfer un zain shpaizopfer un zain gisopfer.<verse eid="NUM 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23" />un oifn firtn tog: tsen oksen, tsvei viders, fertsn shepsn yorike, on a feler. <verse eid="NUM 29:23" /><verse number="24" style="v" sid="NUM 29:24" />un zeyer shpaizopfer un zeyere gisopfer, tsu di oksen, tsu di viders, un tsu di shepsn, loit zeyer tsol azoi vi der din. <verse eid="NUM 29:24" /><verse number="25" style="v" sid="NUM 29:25" />un ein tsignbok a zindopfer. achuts dem shtendikn brandopfer, zain shpaizopfer, un zain gisopfer.<verse eid="NUM 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26" />un oifn finftn tog: nain oksen, tsvei viders, fertsn shepsn yorike, on a feler. <verse eid="NUM 29:26" /><verse number="27" style="v" sid="NUM 29:27" />un zeyer shpaizopfer un zeyere gisopfer, tsu di oksen, tsu di viders, un tsu di shepsn, loit zeyer tsol azoi vi der din. <verse eid="NUM 29:27" /><verse number="28" style="v" sid="NUM 29:28" />un ein bok a zindopfer. achuts dem shtendikn brandopfer un zain shpaizopfer, un zain gisopfer.<verse eid="NUM 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29" />un oifn zekstn tog: acht oksen, tsvei viders, fertsn shepsn yorike, on a feler. <verse eid="NUM 29:29" /><verse number="30" style="v" sid="NUM 29:30" />un zeyer shpaizopfer un zeyere gisopfer, tsu di oksen, tsu di viders, un tsu di shepsn, loit zeyer tsol azoi vi der din. <verse eid="NUM 29:30" /><verse number="31" style="v" sid="NUM 29:31" />un ein bok a zindopfer. achuts dem shtendikn brandopfer, zain shpaizopfer, un zaine gisopfer.<verse eid="NUM 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32" />un oifn zibetn tog: zibn oksen, tsvei viders, fertsn shepsn yorike, on a feler. <verse eid="NUM 29:32" /><verse number="33" style="v" sid="NUM 29:33" />un zeyer shpaizopfer un zeyere gisopfer, tsu di oksen, tsu di viders, un tsu di shepsn, loit zeyer tsol azoi vi zeyer din. <verse eid="NUM 29:33" /><verse number="34" style="v" sid="NUM 29:34" />un ein bok a zindopfer. achuts dem shtendikn brandopfer, zain shpaizopfer, un zain gisopfer.<verse eid="NUM 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35" />oifn achten tog zol zain a heilike ainzamlung bai aich; kein dinstarbet zolt ir nisht ton. <verse eid="NUM 29:35" /><verse number="36" style="v" sid="NUM 29:36" />un ir zolt makrev zain a brandopfer, a faieropfer far a geshmakn reyech tsu Hashem: ein oks, ein vider, zibn shepsn yorike, on a feler. <verse eid="NUM 29:36" /><verse number="37" style="v" sid="NUM 29:37" />zeyer shpaizopfer un zeyere gisopfer, tsu dem oks, tsu dem vider, un tsu di shepsn, loit zeyer tsol azoi vi der din. <verse eid="NUM 29:37" /><verse number="38" style="v" sid="NUM 29:38" />un ein bok a zindopfer. achuts dem shtendikn brandopfer, un zain shpaizopfer, un zain gisopfer.<verse eid="NUM 29:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39" />di dozike zolt ir machn tsu Hashem in aiere yom-tuvim, achuts aiere nedrim, un aiere fraivilike nedoves, fun aiere brandopfer, un fun aiere shpaizopfer un fun aiere gisopfer, un fun aiere fridopfer.<verse eid="NUM 29:39" /></para>
  <chapter eid="NUM 29" />
  <chapter number="30" style="c" pubnumber="ל" sid="NUM 30" />
  <para style="p">
    <verse number="1" style="v" pubnumber="29.40" sid="NUM 30:1" /> un Moshe hot ongezogt di kinder fun Yisroel, azoi vi alts vos Hashem hot Mosheen bafoiln.<verse eid="NUM 30:1" /></para>
  <para style="s1">Matot</para>
  <para style="p">
    <verse number="2" style="v" pubnumber="30.1" sid="NUM 30:2" /> un Moshe hot geredt tsu di hoiptlait fun di shvotim fun di kinder fun Yisroel, azoi tsu zogn: dos iz di zach vos Hashem hot bafoiln:<verse eid="NUM 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" altnumber="2" sid="NUM 30:3" /> az a man vet ton a neyder tsu Hashem, oder shvern a shvue, tsu aseren oif zich an isur, zol er nisht farshvechn zain vort; azoi vi alts vos geit arois fun zain moil, zol er ton.<verse eid="NUM 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" altnumber="3" sid="NUM 30:4" /> un az a vaibsparshoin vet ton a neyder tsu Hashem, un vet aseren oif zich an isur, in ir foters hoiz, in ir yugnt, <verse eid="NUM 30:4" /><verse number="5" style="v" altnumber="4" sid="NUM 30:5" /> un ir foter vet hern ir neyder, oder ir isur vos zi hot geasrt oif zich, un ir foter vet ir tsushvaign, zoln ale ire nedrim bashtein, un itlecher isur vos zi hot geasrt oif zich, zol bashtein. <verse eid="NUM 30:5" /><verse number="6" style="v" altnumber="5" sid="NUM 30:6" />oib ober ir foter hot ir gevert in dem tog vos er hot gehert, zoln ale ire nedrim, un ire isurim vos zi hot geasrt oif zich, nisht bashtein; un Hashem vet ir fargebn, vail ir foter hot ir gevert. <verse eid="NUM 30:6" /><verse number="7" style="v" altnumber="6" sid="NUM 30:7" /> un oib zi vet nemen a man, ven ire nedrim zainen oif ir, oder der aroisred fun ire lipn, vos zi hot geasrt oif zich, <verse eid="NUM 30:7" /><verse number="8" style="v" altnumber="7" sid="NUM 30:8" /> un ir man vet hern – in voser tog er vet hern – un er vet ir tsushvaign, zoln bashtein ire nedrim, un ire isurim vos zi hot geasrt oif zich, zoln bashtein. <verse eid="NUM 30:8" /><verse number="9" style="v" altnumber="8" sid="NUM 30:9" /> oib ober ir man vet ir vern in dem tog vos er hert, zol er farshtern ir neyder vos oif ir, un dem aroisred fun ire lipn, vos zi hot geasrt oif zich, un Hashem vet ir fargebn. <verse eid="NUM 30:9" /><verse number="10" style="v" altnumber="9" sid="NUM 30:10" /> ober der neyder fun an almone un a grushe, alts vos zi hot geasrt oif zich, zol bashtein far ir. <verse eid="NUM 30:10" /><verse number="11" style="v" altnumber="10" sid="NUM 30:11" />un oib a froi hot a neyder geton in hoiz fun ir man, oder zi hot geasrt oif zich an isur durch a shvue, <verse eid="NUM 30:11" /><verse number="12" style="v" altnumber="11" sid="NUM 30:12" /> un ir man hot gehert, un hot ir tsugeshvign, un ir nisht gevert, zoln ale ire nedrim bashtein, un itlecher isur vos zi hot geasrt oif zich, zol bashtein. <verse eid="NUM 30:12" /><verse number="13" style="v" altnumber="12" sid="NUM 30:13" /> oib ober farshtern vet zei farshtern ir man in dem tog vos er hert, zol kein aroisloz fun ire lipn, fun ire nedrim, oder fun an isur oif zich, nisht bashtein; ir man hot zei farshtert, un Hashem vet ir fargebn.<verse eid="NUM 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" altnumber="13" sid="NUM 30:14" /> itlecher neyder, un itlecher geshvorener isur, oif tsu painiken di zel, ken ir man es lozn bashtein, un ir man ken es farshtern. <verse eid="NUM 30:14" /><verse number="15" style="v" altnumber="14" sid="NUM 30:15" /> oib ober tsushvaign vet ir tsushvaign ir man a met-let, hot er gemacht bashtein ale ire nedrim, oder ale ire isurim vos oif ir; er hot zei gemacht bashtein vail er hot ir tsugeshvign in dem tog vos er hot gehert. <verse eid="NUM 30:15" /><verse number="16" style="v" altnumber="15" sid="NUM 30:16" /> un oib farshtern vet er zei farshtern lang noch dem vi er hot gehert, vet er trogn ir zind.<verse eid="NUM 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" altnumber="16" sid="NUM 30:17" /> dos zainen di gezetsn vos Hashem hot bafoiln Mosheen, tsvishn a man un zain vaib, tsvishn a foter un zain tochter, in ir yugnt, in ir foters hoiz.<verse eid="NUM 30:17" /></para>
  <chapter eid="NUM 30" />
  <chapter number="31" style="c" pubnumber="לא" sid="NUM 31" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 31:1" /><verse number="2" style="v" sid="NUM 31:2" />zai zich noikem di nekome fun di kinder fun Yisroel on di Midyanim; dernoch vestu aingezamlt vern tsu dain folk.<verse eid="NUM 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3" />hot Moshe geredt tsum folk, azoi tsu zogn: bavofnt fun aich mener tsum cheil, un zoln zei gein oif Midyan oistsufirn di nekome fun Hashem oif Midyan. <verse eid="NUM 31:3" /><verse number="4" style="v" sid="NUM 31:4" />tsu toiznt fun a sheyvet, tsu toiznt fun a sheyvet, fun ale shvotim fun Yisroel, zolt ir shikn in cheil.<verse eid="NUM 31:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 31:5" />zainen tsugeshtelt gevorn fun di toizntn fun Yisroel tsu toiznt fun a sheyvet, tsvelf toiznt bavofnte cheil. <verse eid="NUM 31:5" /><verse number="6" style="v" sid="NUM 31:6" />un Moshe hot zei geshikt in cheil tsu toiznt fun a sheyvet, zei mit Pinchas dem zun fun Elazar dem koyen, in cheil, mit di heilike keilim un di shaltrumeitn in zain hant. <verse eid="NUM 31:6" /><verse number="7" style="v" sid="NUM 31:7" />un zei hobn milchome gehaltn oif Midyan, azoi vi Hashem hot bafoiln Mosheen, un zei hobn oisgeharget yetveder mansparshoin. <verse eid="NUM 31:7" /><verse number="8" style="v" sid="NUM 31:8" />oich di mlochim fun Midyan hobn zei geharget tsvishn zeyere dershlogene: Evi, un Rekem, un Tsur, un Chur, un Reva, di finf mlochim fun Midyan; oich Bilaam dem zun fun Beoren hobn zei geharget mitn shverd. <verse eid="NUM 31:8" /><verse number="9" style="v" sid="NUM 31:9" />un di kinder fun Yisroel hobn gefangen di vaiber fun Midyan, un zeyere kleine kinder; un ale zeyere beheimes, un ale zeyere fich, un zeyer gantsn farmeg, hobn zei avekgeroibt. <verse eid="NUM 31:9" /><verse number="10" style="v" sid="NUM 31:10" />un ale zeyere shtet in zeyere voinerter, un ale zeyere lagerderfer, hobn zei farbrent in faier. <verse eid="NUM 31:10" /><verse number="11" style="v" sid="NUM 31:11" />un zei hobn genumen dem gantsn zakroib, un dem gantsn traibroib, fun mentshn un fun beheimes, <verse eid="NUM 31:11" /><verse number="12" style="v" sid="NUM 31:12" />un hobn gebracht di gefangene un dem traibroib un dem zakroib tsu Mosheen un tsu Elazar dem koyen, un tsu der eide fun di kinder fun Yisroel, in lager, oif di ploinen fun Moav vos baim Yarden lebn Yericho.<verse eid="NUM 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13" />zainen Moshe, un Elazar der koyen, un ale firshtn fun der eide, aroisgegangen zei antkegen oisn lager. <verse eid="NUM 31:13" /><verse number="14" style="v" sid="NUM 31:14" />un Moshe hot getsernt oif di oifgezetste ibern cheil, di eltste fun toiznt, un di eltste fun hundert, vos zainen gekumen fun milchome-dinst. <verse eid="NUM 31:14" /><verse number="15" style="v" sid="NUM 31:15" />un Moshe hot tsu zei gezogt: hot ir gelozt lebn ale vaibsparshoinen? <verse eid="NUM 31:15" /><verse number="16" style="v" sid="NUM 31:16" />dos hobn zei doch, oif dem onred fun Bilaamen, gebracht di kinder fun Yisroel tsu bagein a felshung on Hashem, in der meise fun Peor, un di mageyfe iz geven oif der eide fun Hashem. <verse eid="NUM 31:16" /><verse number="17" style="v" sid="NUM 31:17" />un atsund harget yetveder mansparshoin tsvishn di kleine kinder, un harget yetveder vaibsparshoin vos veis fun a man durch lign mit a mansparshoin.<verse eid="NUM 31:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 31:18" />un ale kinder tsvishn di vaibsparshoinen vos veisn nisht fun lign mit a mansparshoin, zolt ir lozn lebn far aich. <verse eid="NUM 31:18" /><verse number="19" style="v" sid="NUM 31:19" />un ir, lagert oisn lager zibn teg; itlecher vos hot geharget a nefesh, un itlecher vos hot zich ongerirt on a dershlogenem, reinikt aich oifn dritn tog un oifn zibetn tog, ir un aiere gefangene. <verse eid="NUM 31:19" /><verse number="20" style="v" sid="NUM 31:20" />un yetveder beged, un yetveder zach fun fel, un alts vos iz gemacht fun tsignhor, un yetveder hiltserne keile, zolt ir aich reiniken.<verse eid="NUM 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21" />un Elazar der koyen hot gezogt tsu di chils-lait vos zainen gegangen in milchome: dos iz dos gezets fun der toyre vos Hashem hot bafoiln Mosheen: <verse eid="NUM 31:21" /><verse number="22" style="v" sid="NUM 31:22" />ober dos gold, un dos zilber, dos kuper, dos aizn, dos Tsin, un dos blai, <verse eid="NUM 31:22" /><verse number="23" style="v" sid="NUM 31:23" />alts vos ken kumen in faier, zolt ir machn durchgein durch faier, un es vet vern rein; nor es muz gereinikt vern mit shprengvaser. un alts vos ken nisht kumen in faier, zolt ir machn durchgein durch vaser. <verse eid="NUM 31:23" /><verse number="24" style="v" sid="NUM 31:24" />un ir zolt vashn aiere kleider oifn zibetn tog, un ir vet vern rein, un dernoch megt ir arainkumen in lager.<verse eid="NUM 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25" />un Hashem hot gezogt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 31:25" /><verse number="26" style="v" sid="NUM 31:26" />nem oif di tsol fun dem gefangenem traibroib, fun mentshn un fun beheimes, du un Elazar der koyen, un di hoiptlait fun di foterhaizer fun der eide. <verse eid="NUM 31:26" /><verse number="27" style="v" sid="NUM 31:27" />un zolst tseteiln dem traibroib in helft, tsvishn di milchome-halters vos zainen aroisgegangen in cheil, un tsvishn der gantser eide. <verse eid="NUM 31:27" /><verse number="28" style="v" sid="NUM 31:28" />un zolst opsheiden an opgob tsu Hashem fun di milchome-lait vos zainen aroisgegangen in cheil; ein shtik fun finf hundert, fun di mentshn, un fun di rinder, un fun di eizlen, un fun di shof. <verse eid="NUM 31:28" /><verse number="29" style="v" sid="NUM 31:29" />fun zeyer helft zolt ir es nemen; un zolst es gebn tsu Elazar dem koyen, an opsheidung tsu Hashem. <verse eid="NUM 31:29" /><verse number="30" style="v" sid="NUM 31:30" />un fun der helft fun di kinder fun Yisroel zolstu nemen eins aroisgenumen fun fuftsik, fun di mentshn, fun di rinder, fun di eizlen, un fun di shof – fun ale beheimes; un zolst zei gebn tsu di Leviim, vos hitn di hitung fun dem mishkn fun Hashem.<verse eid="NUM 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 31:31" />un Moshe un Elazar der koyen hobn geton azoi vi Hashem hot bafoiln Mosheen. <verse eid="NUM 31:31" /><verse number="32" style="v" sid="NUM 31:32" />un der traibroib vos iz geblibn noch dem roib vos dos cheil-folk hot geroibt, iz geven: shof, zeks hundert toiznt un zibetsik toiznt un finf toiznt; <verse eid="NUM 31:32" /><verse number="33" style="v" sid="NUM 31:33" />un rinder, tsvei un zibetsik toiznt; <verse eid="NUM 31:33" /><verse number="34" style="v" sid="NUM 31:34" />un eizlen, ein un zechtsik toiznt; <verse eid="NUM 31:34" /><verse number="35" style="v" sid="NUM 31:35" />un nefoshes fun mentshn, fun vaibsparshoinen vos hobn nisht gevust fun lign mit a mansparshoin – ale nefoshes, tsvei un draisik toiznt. <verse eid="NUM 31:35" /><verse number="36" style="v" sid="NUM 31:36" />un a helft, der chelek fun di vos zainen aroisgegangen in cheil – di tsol fun di shof, iz geven drai hundert toiznt un draisik toiznt un zibn toiznt un finf hundert. <verse eid="NUM 31:36" /><verse number="37" style="v" sid="NUM 31:37" />un di opgob tsu Hashem fun di shof iz geven zeks hundert un finf un zibetsik. <verse eid="NUM 31:37" /><verse number="38" style="v" sid="NUM 31:38" />un di rinder, zeks un draisik toiznt, un di opgob fun zei tsu Hashem, tsvei un zibetsik. <verse eid="NUM 31:38" /><verse number="39" style="v" sid="NUM 31:39" />un eizlen, draisik toiznt un finf hundert; un di opgob fun zei tsu Hashem, ein un zechtsik. <verse eid="NUM 31:39" /><verse number="40" style="v" sid="NUM 31:40" />un nefoshes fun mentshn, zechtsn toiznt; un di opgob fun zei tsu Hashem, tsvei un draisik nefoshes. <verse eid="NUM 31:40" /><verse number="41" style="v" sid="NUM 31:41" />un Moshe hot ibergegebn di opgob fun G-ts opsheidung tsu Elazar dem koyen, azoi vi Hashem hot Mosheen bafoiln. <verse eid="NUM 31:41" /><verse number="42" style="v" sid="NUM 31:42" />un fun der helft fun di kinder fun Yisroel, vos Moshe hot aropgenumen bai di mener vos zainen geven in cheil – <verse eid="NUM 31:42" /><verse number="43" style="v" sid="NUM 31:43" />un di helft fun der eide iz geven: fun di shof, drai hundert toiznt un draisik toiznt un zibn toiznt un finf hundert; <verse eid="NUM 31:43" /><verse number="44" style="v" sid="NUM 31:44" />un rinder, zeks un draisik toiznt; <verse eid="NUM 31:44" /><verse number="45" style="v" sid="NUM 31:45" />un eizlen, draisik toiznt un finf hundert;<verse eid="NUM 31:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 31:46" />un nefoshes fun mentshn, zechtsn toiznt – <verse eid="NUM 31:46" /><verse number="47" style="v" sid="NUM 31:47" />fun der helft fun di kinder fun Yisroel hot Moshe genumen eins aroisgenumen fun fuftsik, fun di mentshn, un fun di beheimes, un er hot zei gegebn tsu di Leviim, vos hitn di hitung fun dem mishkn fun Hashem, azoi vi Hashem hot Mosheen bafoiln.<verse eid="NUM 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48" />un di oifgezetste vos iber di toizntn fun cheil, di eltste fun toiznt, un di eltste fun hundert, hobn genent tsu Mosheen; <verse eid="NUM 31:48" /><verse number="49" style="v" sid="NUM 31:49" />un zei hobn gezogt tsu Mosheen: daine knecht hobn oifgenumen di tsol fun di milchome-lait vos unter undzer hant, un keiner fun undz iz nisht geminert gevorn. <verse eid="NUM 31:49" /><verse number="50" style="v" sid="NUM 31:50" />hobn mir gebracht a korben tsu Hashem, itlecher vos er hot gefunen, gilderne zachn, orembender, un hantkeitlech, fingerlech, oiringen, un haldzbender, mechaper tsu zain oif undzer zel far Hashem.<verse eid="NUM 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 31:51" />hobn Moshe un Elazar der koyen tsugenumen fun zei dos gold, alerlei oisgearbete zachn. <verse eid="NUM 31:51" /><verse number="52" style="v" sid="NUM 31:52" />un dos gantse gold fun der opsheidung vos zei hobn opgesheidt tsu Hashem, iz geven zechtsn toiznt zibn hundert un fuftsik shekl, fun di eltste fun toiznt, un fun di eltste fun hundert. – <verse eid="NUM 31:52" /><verse number="53" style="v" sid="NUM 31:53" />di chils-lait hobn geroibt itlecher far zich. – <verse eid="NUM 31:53" /><verse number="54" style="v" sid="NUM 31:54" />un Moshe un Elazar der koyen hobn tsugenumen dos gold fun di eltste fun toiznt un fun hundert, un hobn es gebracht in ohel-moed, a dermonung on di kinder fun Yisroel far Hashem.<verse eid="NUM 31:54" /></para>
  <chapter eid="NUM 31" />
  <chapter number="32" style="c" pubnumber="לב" sid="NUM 32" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1" />un di kinder fun Reuven un di kinder fun Gad hobn gehat fil fich, zeyer a sach, un zei hobn gezen dos land Yazer un dos land Gilad, ersht der ort iz an ort far fich. <verse eid="NUM 32:1" /><verse number="2" style="v" sid="NUM 32:2" />zainen di kinder fun Gad un di kinder fun Reuven gekumen, un zei hobn gezogt tsu Mosheen, un tsu Elazar dem koyen, un tsu di firshtn fun der eide, azoi tsu zogn: <verse eid="NUM 32:2" /><verse number="3" style="v" sid="NUM 32:3" />Atarot, un Divon, un Yazer, un Nimrah, un Cheshbon, un Elealeh, un Sevam, un Nevo, un Beon, <verse eid="NUM 32:3" /><verse number="4" style="v" sid="NUM 32:4" />dos land vos Hashem hot geshlogn far der eide fun Yisroel, iz a land far fich, un daine knecht hobn fich. <verse eid="NUM 32:4" /><verse number="5" style="v" sid="NUM 32:5" />un zei hobn gezogt: oib mir hobn gefunen chein in daine oign, zol dos dozike land gegebn vern daine knecht tsum eigentum; zolst undz nisht ariberfirn dem Yarden.<verse eid="NUM 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6" />hot Moshe gezogt tsu di kinder fun Gad un tsu di kinder fun Reuven: aiere brider zoln gein in milchome, un ir zolt zitsn do? <verse eid="NUM 32:6" /><verse number="7" style="v" sid="NUM 32:7" />un far vos zolt ir opkeren dos harts fun di kinder fun Yisroel fun aribertsugein in dem land vos Hashem hot zei gegebn? <verse eid="NUM 32:7" /><verse number="8" style="v" sid="NUM 32:8" />azoi hobn geton aiere eltern, ven ich hob zei geshikt fun Kadesh-Barnea ontsukukn dos land. <verse eid="NUM 32:8" /><verse number="9" style="v" sid="NUM 32:9" />vorem zei zainen aroifgegangen bizn tal Eshcol, un hobn ongekukt dos land, un zei hobn opgekert dos harts fun di kinder fun Yisroel, nisht tsu gein in dem land, vos Hashem hot zei gegebn. <verse eid="NUM 32:9" /><verse number="10" style="v" sid="NUM 32:10" />un der tsorn fun Hashem hot gegrimt in yenem tog, un er hot geshvorn, azoi tsu zogn: <verse eid="NUM 32:10" /><verse number="11" style="v" sid="NUM 32:11" />oib di mentshn vos zainen aroifgegangen fun Mitsrayim, fun tsvantsik yor alt un hecher, veln onzen di erd, vos ich hob tsugeshvorn tsu Avrahamen, tsu Yitschakn, un tsu Yaakovn! vail zei zainen nisht gegangen getrai noch mir. <verse eid="NUM 32:11" /><verse number="12" style="v" sid="NUM 32:12" />achuts Kalev der zun fun Yefunehn, der Kenizi, un Yehoshua der zun fun Nun, vail zei zainen gegangen getrai noch Hashem. <verse eid="NUM 32:12" /><verse number="13" style="v" sid="NUM 32:13" />un der tsorn fun Hashem hot gegrimt oif Yisroel, un er hot zei gemacht voglen in der midber fertsik yor, biz der gantser dor vos hot geton dos shlechts in di oign fun Hashem, iz farlendt gevorn. <verse eid="NUM 32:13" /><verse number="14" style="v" sid="NUM 32:14" />un ot zait ir oifgeshtanen oif dem ort fun aiere eltern, a gezindl fun zindike mentshn, noch tsutsuleigen tsu dem grimtsorn fun Hashem oif Yisroel. <verse eid="NUM 32:14" /><verse number="15" style="v" sid="NUM 32:15" />vorem az ir kert zich op fun hinter im, vet er zei vider lozn in der midber, un ir vet umbrengen dos dozike gantse folk.<verse eid="NUM 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16" />hobn zei genent tsu im, un hobn gezogt: shofgeheftn far undzer fich veln mir do boien, un shtet far undzere kleine kinder. <verse eid="NUM 32:16" /><verse number="17" style="v" sid="NUM 32:17" />ober mir alein veln zain greit bavofnt farois far di kinder fun Yisroel, biz vanen mir hobn zei gebracht oif zeyer ort; un undzere kleine kinder veln zitsn in di bafestikte shtet fun vegen di bavoiner fun land. <verse eid="NUM 32:17" /><verse number="18" style="v" sid="NUM 32:18" />mir veln zich nisht umkeren in undzere haizer, biz di kinder fun Yisroel arben itlecher zain arbung. <verse eid="NUM 32:18" /><verse number="19" style="v" sid="NUM 32:19" />vorem mir veln nisht arben mit zei oif yener zait Yarden un vaiter, vail undz iz ongekumen undzer arbung oif der zait Yarden, tsu mizrech.<verse eid="NUM 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20" />hot Moshe tsu zei gezogt: oib ir vet ton di dozike zach, oib ir vet aich bavofenen far Hashems ongezicht oif milchome, <verse eid="NUM 32:20" /><verse number="21" style="v" sid="NUM 32:21" />un ale bavofnte fun aich veln aribergein dem Yarden far Hashems ongezicht, biz er fartraibt zaine faint fun far im, <verse eid="NUM 32:21" /><verse number="22" style="v" sid="NUM 32:22" />un dos land vet batsvungen vern far G-ts ongezicht, un ir vet zich dernoch umkeren, vet ir zain rein far Hashem un far Yisroel, un dos dozike land vet aich zain tsum eigentum far Hashem. <verse eid="NUM 32:22" /><verse number="23" style="v" sid="NUM 32:23" />oib ober ir vet azoi nisht ton, azoi hot ir gezindikt far Hashem, un zait visen aiere shtrof vos vet aich trefn. <verse eid="NUM 32:23" /><verse number="24" style="v" sid="NUM 32:24" />boit aich shtet far aiere kleine kinder, un geheftn far aiere shof, ober vos iz arois fun aier moil zolt ir ton.<verse eid="NUM 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25" />hobn di kinder fun Gad un di kinder fun Reuven gezogt tsu Mosheen, azoi tsu zogn: daine knecht veln ton azoi vi main har bafelt. <verse eid="NUM 32:25" /><verse number="26" style="v" sid="NUM 32:26" />undzere kleine kinder, undzere vaiber, undzer fich, un ale undzere beheimes, veln zain dortn in di shtet fun Gilad; <verse eid="NUM 32:26" /><verse number="27" style="v" sid="NUM 32:27" />ober daine knecht, itlecher bavofnter tsum cheil, veln aribergein far Hashems ongezicht oif milchome, azoi vi main har redt.<verse eid="NUM 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28" />un Moshe hot bafoiln vegen zei Elazar dem koyen, un Yehoshua dem zun fun Nun, un di hoiptlait fun di foterhaizer fun di shvotim fun di kinder fun Yisroel, <verse eid="NUM 32:28" /><verse number="29" style="v" sid="NUM 32:29" />un Moshe hot tsu zei gezogt: oib di kinder fun Gad un di kinder fun Reuven, itlecher bavofnter oif milchome, veln aribergein mit aich dem Yarden far Hashems ongezicht, un dos land vet batsvungen vern far aier ongezicht, zolt ir zei gebn dos land Gilad tsum eigentum.<verse eid="NUM 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 32:30" />oib ober zei veln nisht aribergein bavofnt mit aich, zoln zei krign eigentum tsvishn aich in land Kenaan.<verse eid="NUM 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31" />hobn zich opgerufn di kinder fun Gad un di kinder fun Reuven, azoi tsu zogn: vos Hashem hot geredt tsu daine knecht, azoi veln mir ton. <verse eid="NUM 32:31" /><verse number="32" style="v" sid="NUM 32:32" />mir veln aribergein bavofnte far Hashems gezicht, in land Kenaan, un dos eigentum fun undzer nachle fun der zait Yarden zol blaibn bai undz.<verse eid="NUM 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33" />un Moshe hot zei, di kinder fun Gad un di kinder fun Reuven un dem halbn sheyvet fun Menasheh dem zun fun Yosefn, gegebn dos kinigraich fun Sichon dem melech fun Emori, un dos kinigraich fun Og dem melech fun Bashan, dos land loit ire shtet mit di gemarkn, di shtet fun dem land rund arum. <verse eid="NUM 32:33" /><verse number="34" style="v" sid="NUM 32:34" />un di kinder fun Gad hobn opgeboit Divon, un Atarot, un Aroer, <verse eid="NUM 32:34" /><verse number="35" style="v" sid="NUM 32:35" />un Atrot-Shofan, un Yazer, un Yogbehah, <verse eid="NUM 32:35" /><verse number="36" style="v" sid="NUM 32:36" />un Beis-Nimrah, un Beis-Haran; bafestikte shtet mit geheftn far shof.<verse eid="NUM 32:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 32:37" />un di kinder fun Reuven hobn opgeboit Cheshbon, un Eleale, un Kiryatayim, <verse eid="NUM 32:37" /><verse number="38" style="v" sid="NUM 32:38" />un Nevo, un Baal-Meon – mit umgebitene nemen – un Sivmah; un zei hobn ongerufn mit nemen di shtet vos zei hobn opgeboit. <verse eid="NUM 32:38" /><verse number="39" style="v" sid="NUM 32:39" />un di kinder fun Machir dem zun fun Menashehn zainen gegangen kein Gilad, un zei hobn es batsvungen, un hobn fartriben dem Emori vos drinen. <verse eid="NUM 32:39" /><verse number="40" style="v" sid="NUM 32:40" />un Moshe hot gegebn Gilad tsu Machir dem zun fun Menashehn, un er hot zich bazetst drinen. <verse eid="NUM 32:40" /><verse number="41" style="v" sid="NUM 32:41" />un Yair der zun fun Menashehn iz gegangen un hot batsvungen zeyere derfer, un er hot zei gerufn Chavot-Yair. <verse eid="NUM 32:41" /><verse number="42" style="v" sid="NUM 32:42" />un Novach iz gegangen un hot batsvungen Kenat mit ire techtershtet; un er hot zi gerufn Novach oif zain nomen.<verse eid="NUM 32:42" /></para>
  <chapter eid="NUM 32" />
  <chapter number="33" style="c" pubnumber="לג" sid="NUM 33" />
  <para style="s1">Masei</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1" />dos zainen di tsiungen fun di kinder fun Yisroel, vos zainen aroisgegangen fun land Mitsrayim loit zeyere machnus unter der hant fun Mosheen un Aharonen. <verse eid="NUM 33:1" /><verse number="2" style="v" sid="NUM 33:2" />un Moshe hot farshribn zeyere aroisgangen oif zeyere tsiungen loit dem moil fun Hashem; un dos zainen zeyere tsiungen in zeyere aroisgangen:<verse eid="NUM 33:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 33:3" />zei hobn getsoign fun Rameses in ershtn choidesh, in fuftsntn tog fun ershtn choidesh; oif morgn nochn korben-Pesach zainen di kinder fun Yisroel aroisgegangen mit a hoicher hant far di oign fun gants Mitsrayim, <verse eid="NUM 33:3" /><verse number="4" style="v" sid="NUM 33:4" />beeis di Mitsrayim hobn gehaltn in bagrobn di vos Hashem hot dershlogn tsvishn zei – itlechn bechor; un oich oif zeyere g‑ter hot Hashem geton a mishpot. <verse eid="NUM 33:4" /><verse number="5" style="v" sid="NUM 33:5" />un di kinder fun Yisroel hobn getsoign fun Rameses, un gerut in Sukkot. <verse eid="NUM 33:5" /><verse number="6" style="v" sid="NUM 33:6" />un zei hobn getsoign fun Sukkot, un gerut in Etam vos baim ek midber. <verse eid="NUM 33:6" /><verse number="7" style="v" sid="NUM 33:7" />un zei hobn getsoign fun Etam, un zich umgekert tsu Pi-HaChirot vos far Baal-TSafon, un gerut far Migdol. <verse eid="NUM 33:7" /><verse number="8" style="v" sid="NUM 33:8" />un zei hobn getsoign fun Penei-Hachirot, un zainen aribergegangen durchn yam tsum midber; un zei zainen gegangen drai teg vegs in midber Etam, un hobn gerut in Marah.<verse eid="NUM 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 33:9" />un zei hobn getsoign fun Marah, un zainen gekumen kein Elim; un in Elim zainen geven tsvelf kvaln vaser un zibetsik teitlbeimer; un zei hobn dortn gerut. <verse eid="NUM 33:9" /><verse number="10" style="v" sid="NUM 33:10" />un zei hobn getsoign fun Elim, un gerut baim Yam-Suf. <verse eid="NUM 33:10" /><verse number="11" style="v" sid="NUM 33:11" />un zei hobn getsoign fun Yam-Suf, un gerut in midber Sin. <verse eid="NUM 33:11" /><verse number="12" style="v" sid="NUM 33:12" />un zei hobn getsoign fun midber Sin un gerut in Dofkah. <verse eid="NUM 33:12" /><verse number="13" style="v" sid="NUM 33:13" />un zei hobn getsoign fun Dofkah, un gerut in Alush. <verse eid="NUM 33:13" /><verse number="14" style="v" sid="NUM 33:14" />un zei hobn getsoign fun Alush, un gerut in Refidim; un dortn iz nisht geven kein vaser faran folk tsum trinken. <verse eid="NUM 33:14" /><verse number="15" style="v" sid="NUM 33:15" />un zei hobn getsoign fun Refidim, un gerut in midber Sinai. <verse eid="NUM 33:15" /><verse number="16" style="v" sid="NUM 33:16" />un zei hobn getsoign fun midber Sinai, un gerut in Kivrot-Hataavah. <verse eid="NUM 33:16" /><verse number="17" style="v" sid="NUM 33:17" />un zei hobn getsoign fun Kivrot-Hataavah, un gerut in Chatserot. <verse eid="NUM 33:17" /><verse number="18" style="v" sid="NUM 33:18" />un zei hobn getsoign fun Chatserot, un gerut in Ritmah.<verse eid="NUM 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 33:19" />un zei hobn getsoign fun Ritmah, un gerut in Rimmon-Perets. <verse eid="NUM 33:19" /><verse number="20" style="v" sid="NUM 33:20" />un zei hobn getsoign fun Rimmon-Perets, un gerut in Livnah. <verse eid="NUM 33:20" /><verse number="21" style="v" sid="NUM 33:21" />un zei hobn getsoign fun Livnah, un gerut in Rissah. <verse eid="NUM 33:21" /><verse number="22" style="v" sid="NUM 33:22" />un zei hobn getsoign fun Rissah, un gerut in Kehelatah. <verse eid="NUM 33:22" /><verse number="23" style="v" sid="NUM 33:23" />un zei hobn getsoign fun Kehelatah, un gerut baim barg Shefer. <verse eid="NUM 33:23" /><verse number="24" style="v" sid="NUM 33:24" />un zei hobn getsoign fun barg Shefer, un gerut in Charadah. <verse eid="NUM 33:24" /><verse number="25" style="v" sid="NUM 33:25" />un zei hobn getsoign fun Charadah, un gerut in Machelot. <verse eid="NUM 33:25" /><verse number="26" style="v" sid="NUM 33:26" />un zei hobn getsoign fun Machelot, un gerut in Tachat.<verse eid="NUM 33:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 33:27" />un zei hobn getsoign fun Tachat, un gerut in Terach. <verse eid="NUM 33:27" /><verse number="28" style="v" sid="NUM 33:28" />un zei hobn getsoign fun Terach, un gerut in Mitkah. <verse eid="NUM 33:28" /><verse number="29" style="v" sid="NUM 33:29" />un zei hobn getsoign fun Mitkah, un gerut in Chashmonah. <verse eid="NUM 33:29" /><verse number="30" style="v" sid="NUM 33:30" />un zei hobn getsoign fun Chashmonah, un gerut in Moserot. <verse eid="NUM 33:30" /><verse number="31" style="v" sid="NUM 33:31" />un zei hobn getsoign fun Moserot, un gerut in Bnei-Yaakan. <verse eid="NUM 33:31" /><verse number="32" style="v" sid="NUM 33:32" />un zei hobn getsoign fun Bnei-Yaakan, un gerut in Chor-Hagidgad. <verse eid="NUM 33:32" /><verse number="33" style="v" sid="NUM 33:33" />un zei hobn getsoign fun Chor-Hagidgad, un gerut in Yotbah. <verse eid="NUM 33:33" /><verse number="34" style="v" sid="NUM 33:34" />un zei hobn getsoign fun Yotbah, un gerut in Avronah. <verse eid="NUM 33:34" /><verse number="35" style="v" sid="NUM 33:35" />un zei hobn getsoign fun Avronah, un gerut in Etsyon-Gever. <verse eid="NUM 33:35" /><verse number="36" style="v" sid="NUM 33:36" />un zei hobn getsoign fun Etsyon-Gever, un gerut in midber Tsin, dos iz Kadesh. <verse eid="NUM 33:36" /><verse number="37" style="v" sid="NUM 33:37" />un zei hobn getsoign fun Kadesh, un gerut baim barg Hor, in ek fun land Edom.<verse eid="NUM 33:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 33:38" />un Aharon der koyen iz aroifgegangen oifn barg Hor, loit dem moil fun Hashem, un er iz dortn geshtorbn, in dem fertsikstn yor noch dem vi di kinder fun Yisroel zainen aroisgegangen fun land Mitsrayim, in finftn choidesh, in ershtn tog fun choidesh. <verse eid="NUM 33:38" /><verse number="39" style="v" sid="NUM 33:39" />un Aharon iz geven hundert un drai un tsvantsik yor alt, ven er iz geshtorbn oifn barg Hor. <verse eid="NUM 33:39" /><verse number="40" style="v" sid="NUM 33:40" />un der Kenaani, der melech fun Arad, vos iz gezesn in dorem, in land Kenaan, hot gehert vegen dem kumen fun di kinder fun Yisroel.<verse eid="NUM 33:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 33:41" />un zei hobn getsoign fun barg Hor, un gerut in Tsalmonah. <verse eid="NUM 33:41" /><verse number="42" style="v" sid="NUM 33:42" />un zei hobn getsoign fun Tsalmonah, un gerut in Punon. <verse eid="NUM 33:42" /><verse number="43" style="v" sid="NUM 33:43" />un zei hobn getsoign fun Punon, un gerut in Ovot. <verse eid="NUM 33:43" /><verse number="44" style="v" sid="NUM 33:44" />un zei hobn getsoign fun Ovot, un gerut in Iyei-Avarim, baim gemark fun Moav. <verse eid="NUM 33:44" /><verse number="45" style="v" sid="NUM 33:45" />un zei hobn getsoign fun Iyim, un gerut in Divon-Gad. <verse eid="NUM 33:45" /><verse number="46" style="v" sid="NUM 33:46" />un zei hobn getsoign fun Divon-Gad, un gerut in Almon-Divlatayim. <verse eid="NUM 33:46" /><verse number="47" style="v" sid="NUM 33:47" />un zei hobn getsoign fun Almon-Divlatayim, un gerut in di berg fun Avarim, far Nevo. <verse eid="NUM 33:47" /><verse number="48" style="v" sid="NUM 33:48" />un zei hobn getsoign fun di berg fun Avarim, un gerut in di ploinen fun Moav baim Yarden lebn Yericho. <verse eid="NUM 33:48" /><verse number="49" style="v" sid="NUM 33:49" />un zei hobn gerut baim Yarden, fun Beis-Yeshimot biz Avel-Shitim in di ploinen fun Moav.<verse eid="NUM 33:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50" />un Hashem hot geredt tsu Mosheen in di ploinen fun Moav baim Yarden lebn Yericho, azoi tsu zogn: <verse eid="NUM 33:50" /><verse number="51" style="v" sid="NUM 33:51" />red tsu di kinder fun Yisroel, un zolst zogn tsu zei: az ir geit ariber dem Yarden kein land Kenaan, <verse eid="NUM 33:51" /><verse number="52" style="v" sid="NUM 33:52" />zolt ir fartraiben ale bavoiner fun land fun far aich, un ir zolt unterbrengen ale zeyere bilder, un ale zeyere gegosene getsn zolt ir unterbrengen, un ale zeyere bamot zolt ir fartiliken. <verse eid="NUM 33:52" /><verse number="53" style="v" sid="NUM 33:53" />un ir zolt farnemen dos land, un zich bazetsn drinen, vorem aich hob ich gegebn dos land, es tsu arben. <verse eid="NUM 33:53" /><verse number="54" style="v" sid="NUM 33:54" />un ir zolt arben dos land durch goirl, loit aiere mishpoches; dem merern zolt ir gebn mer nachle, un dem vintsikern zolstu gebn vintsiker nachle. dortn vu zain goirl vet oisfaln, zol gehern tsu im; loit aiere fotershtamen zolt ir aich arben.<verse eid="NUM 33:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="NUM 33:55" />un oib ir vet nisht fartraiben fun far aich di bavoiner fun land, veln di vos ir vet iberlozen fun zei, zain far derner in aiere oign, un far shtechers in aiere zaitn, un zei veln aich drikn in dem land vos ir zitst drinen. <verse eid="NUM 33:55" /><verse number="56" style="v" sid="NUM 33:56" />un es vet zain, azoi vi ich hob gedacht tsu ton tsu zei, vel ich ton tsu aich.<verse eid="NUM 33:56" /></para>
  <chapter eid="NUM 33" />
  <chapter number="34" style="c" pubnumber="לד" sid="NUM 34" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 34:1" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 34:1" /><verse number="2" style="v" sid="NUM 34:2" />bafel di kinder fun Yisroel, un zolst zogn tsu zei: az ir kumt kein land Kenaan, zol dos zain dos land vos vet aich faln far a nachle – dos land Kenaan loit ire gemarkn: <verse eid="NUM 34:2" /><verse number="3" style="v" sid="NUM 34:3" />di dorem-zait zol aich zain fun midber Tsin lebn Edom, un der gemark fun dorem zol aich zain fun ek Yam-HaMelach, tsu mizrech. <verse eid="NUM 34:3" /><verse number="4" style="v" sid="NUM 34:4" />un der gemark zol zich oisdreyen bai aich tsu dorem fun dem oifgang fun Akrabim, un aribergein kein Tsin; un zain oisloz zol zain in dorem fun Kadesh-Barnea; un er zol aroisgein tsu Chatsar-Adar, un aribergein biz Atsmon. <verse eid="NUM 34:4" /><verse number="5" style="v" sid="NUM 34:5" />un der gemark zol zich oisdreyen fun Atsmon tsum taich fun Mitsrayim; un zain oisloz zol zain baim yam. <verse eid="NUM 34:5" /><verse number="6" style="v" sid="NUM 34:6" />un der gemark fun mayrev zol aich zain der Yam-Hagodl mitn breg; dos zol aich zain der gemark fun mayrev. <verse eid="NUM 34:6" /><verse number="7" style="v" sid="NUM 34:7" />un dos zol aich zain der gemark fun tsofn: fun Yam-Hagodl zolt ir aich tseichenen biz dem barg Hor. <verse eid="NUM 34:7" /><verse number="8" style="v" sid="NUM 34:8" />fun barg Hor zolt ir tseichenen biz me kumt kein Chammat; un der oisloz fun dem gemark zol zain bai Tsedad. <verse eid="NUM 34:8" /><verse number="9" style="v" sid="NUM 34:9" />un der gemark zol aroisgein bai Zifron, un zain oisloz zol zain Chatsar-Einan. dos zol aich zain der gemark fun tsofn. <verse eid="NUM 34:9" /><verse number="10" style="v" sid="NUM 34:10" />un ir zolt aich tseichenen faran gemark fun mizrech fun Chatsar-Einan biz Shafam.<verse eid="NUM 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 34:11" />un der gemark zol aropnideren fun Shafam biz Rivlah, in mizrech fun Ayin; un der gemark zol aropnideren un zich onshtoisn on dem bargrukn fun yam Kinneret, tsu mizrech. <verse eid="NUM 34:11" /><verse number="12" style="v" sid="NUM 34:12" />un der gemark zol aropnideren tsum Yarden, un zain oisloz zol zain der Yam-HaMelach. dos zol aich zain dos land loit ire gemarkn rund arum.<verse eid="NUM 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13" />un Moshe hot bafoiln di kinder fun Yisroel, azoi tsu zogn: dos iz dos land vos ir zolt es zich arben loit goirl, vos Hashem hot bafoiln tsu gebn tsu di nain shvotim un dem halbn sheyvet. <verse eid="NUM 34:13" /><verse number="14" style="v" sid="NUM 34:14" />vorem der sheyvet fun di kinder fun Reuven loit zeyere foterhaizer, un der sheyvet fun di kinder fun Gad loit zeyere foterhaizer, hobn gekrign, un halb sheyvet Menasheh hobn gekrign, zeyer nachle. <verse eid="NUM 34:14" /><verse number="15" style="v" sid="NUM 34:15" />di tsvei shvotim un der halber sheyvet hobn gekrign zeyer nachle fun der zait Yarden lebn Yericho, tsu mizrech, tsu zunoifgang.<verse eid="NUM 34:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 34:16" /><verse number="17" style="v" sid="NUM 34:17" />dos zainen di nemen fun di mener vos zoln arben far aich dos land: Elazar der koyen, un Yehoshua der zun fun Nun. <verse eid="NUM 34:17" /><verse number="18" style="v" sid="NUM 34:18" />un ir zolt nemen tsu ein firsht, tsu ein firsht fun a sheyvet, tsu arben dos land. <verse eid="NUM 34:18" /><verse number="19" style="v" sid="NUM 34:19" />un dos zainen di nemen fun di mener: far sheyvet Yehudah, Kalev der zun fun Yefunehn. <verse eid="NUM 34:19" /><verse number="20" style="v" sid="NUM 34:20" />un far dem sheyvet fun di kinder fun Shimeon, Shmuel der zun fun Ammihudn. <verse eid="NUM 34:20" /><verse number="21" style="v" sid="NUM 34:21" />far sheyvet Binyamin, Elidad der zun fun chislonen. <verse eid="NUM 34:21" /><verse number="22" style="v" sid="NUM 34:22" />un far dem sheyvet fun di kinder fun Dan, der firsht Buki der zun fun Yoglien. <verse eid="NUM 34:22" /><verse number="23" style="v" sid="NUM 34:23" />far di kinder fun Yosef: far dem sheyvet fun di kinder fun Menasheh, der firsht Channiel der zun fun Efodn; <verse eid="NUM 34:23" /><verse number="24" style="v" sid="NUM 34:24" />un far dem sheyvet fun di kinder fun Efrayim, der firsht Kemuel der zun fun Shiftanen. <verse eid="NUM 34:24" /><verse number="25" style="v" sid="NUM 34:25" />un far dem sheyvet fun di kinder fun Zevulun, der firsht ElitSafan der zun fun Parnachn. <verse eid="NUM 34:25" /><verse number="26" style="v" sid="NUM 34:26" />un far dem sheyvet fun di kinder fun Yissachar, der firsht Paltiel der zun fun Azzanen. <verse eid="NUM 34:26" /><verse number="27" style="v" sid="NUM 34:27" />un far dem sheyvet fun di kinder fun Asher, der firsht Achihud der zun fun Shelomien, <verse eid="NUM 34:27" /><verse number="28" style="v" sid="NUM 34:28" />un far dem sheyvet fun di kinder fun Naftali, der firsht Pedahel der zun fun Ammihudn. <verse eid="NUM 34:28" /><verse number="29" style="v" sid="NUM 34:29" />dos zainen di vemen Hashem hot bafoiln tsu machn arben di kinder fun Yisroel in land Kenaan.<verse eid="NUM 34:29" /></para>
  <chapter eid="NUM 34" />
  <chapter number="35" style="c" pubnumber="לה" sid="NUM 35" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1" />un Hashem hot geredt tsu Mosheen in di ploinen fun Moav baim Yarden lebn Yericho, azoi tsu zogn: <verse eid="NUM 35:1" /><verse number="2" style="v" sid="NUM 35:2" />bafel di kinder fun Yisroel, zei zoln gebn di Leviim fun der nachle fun zeyer eigentum shtet tsum voinen; un a fraien plats tsu di shtet rund arum zei zolt ir gebn di Leviim. <verse eid="NUM 35:2" /><verse number="3" style="v" sid="NUM 35:3" />un di shtet veln zain far zei tsum voinen, un zeyere fraie peletser veln zain far zeyer fich, un far zeyer farmeg, un far ale zeyere beheimes. <verse eid="NUM 35:3" /><verse number="4" style="v" sid="NUM 35:4" />un di fraie peletser fun di shtet, vos ir vet gebn di Leviim droisn fun der shtot moier, zoln zain toiznt eiln rund arum. <verse eid="NUM 35:4" /><verse number="5" style="v" sid="NUM 35:5" />un ir zolt opmestn oisn shtot, mizrech-zait tsvei toiznt eiln, un dorem-zait tsvei toiznt eiln, un mayrev-zait tsvei toiznt eiln, un tsofn-zait tsvei toiznt eiln, mit der shtot in mitn. dos zoln bai zei zain di fraie peletser fun di shtet. <verse eid="NUM 35:5" /><verse number="6" style="v" sid="NUM 35:6" />un di shtet vos ir vet gebn di Leviim, zoln zain di zeks shtet fun antrinung vos ir vet gebn far dem toitshleger tsu antloifn ahin; un tsu zei zolt ir tsugebn tsvei un fertsik shtet. <verse eid="NUM 35:6" /><verse number="7" style="v" sid="NUM 35:7" />ale shtet vos ir vet gebn di Leviim, zoln zain acht un fertsik shtet; zei mit zeyere fraie peletser. <verse eid="NUM 35:7" /><verse number="8" style="v" sid="NUM 35:8" />un di shtet vos ir vet gebn fun dem eigentum fun di kinder fun Yisroel, zolt ir fun dem merern nemen mer, un fun dem vintsikern nemen vintsiker; itlecher loit zain arbung vos er arbt, zol gebn fun zaine shtet tsu di Leviim.<verse eid="NUM 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9" />un Hashem hot geredt tsu Mosheen, azoi tsu zogn: <verse eid="NUM 35:9" /><verse number="10" style="v" sid="NUM 35:10" />red tsu di kinder fun Yisroel, un zolst zogn tsu zei: az ir geit ariber dem Yarden kein land Kenaan, <verse eid="NUM 35:10" /><verse number="11" style="v" sid="NUM 35:11" />zolt ir aich bashtimen shtet vos zoln aich zain shtet fun antrinung, un ahin zol antloifn der toitshleger vos dershlogt a nefesh durch a farze. <verse eid="NUM 35:11" /><verse number="12" style="v" sid="NUM 35:12" />un di shtet zoln aich zain far antrinung fun dem blut derleizer, un der toitshleger zol nisht shtarbn eider er shtelt zich far der eide tsum mishpot. <verse eid="NUM 35:12" /><verse number="13" style="v" sid="NUM 35:13" />un di shtet vos ir zolt gebn: zeks shtet fun antrinung zoln bai aich zain. <verse eid="NUM 35:13" /><verse number="14" style="v" sid="NUM 35:14" />drai shtet zolt ir gebn fun der zait Yarden, un drai shtet zolt ir gebn in land Kenaan; shtet fun antrinung zoln zei zain. <verse eid="NUM 35:14" /><verse number="15" style="v" sid="NUM 35:15" />far di kinder fun Yisroel, un faran fremdn, un faran aingevandertn tsvishn zei, zoln zain di dozike zeks shtet fun antrinung, oif tsu antloifn ahin far itlechn vos dershlogt a nefesh durch a farze. <verse eid="NUM 35:15" /><verse number="16" style="v" sid="NUM 35:16" />oib ober er hot im dershlogn mit an aizerner zach, un er iz geshtorbn, iz er a merder; teitn zol geteit vern der merder. <verse eid="NUM 35:16" /><verse number="17" style="v" sid="NUM 35:17" />un oib er hot im geshlogn mit a shtein in hant, vos me ken derfun shtarbn, un er iz geshtorbn, iz er a merder; teitn zol geteit vern der merder. <verse eid="NUM 35:17" /><verse number="18" style="v" sid="NUM 35:18" />oder az er hot im geshlogn mit a hiltserner zach in hant, vos me ken derfun shtarbn, un er iz geshtorbn, iz er a merder; teitn zol geteit vern der merder. <verse eid="NUM 35:18" /><verse number="19" style="v" sid="NUM 35:19" />der blut derleizer, er zol teitn dem merder; ven er treft im, zol er im teitn. <verse eid="NUM 35:19" /><verse number="20" style="v" sid="NUM 35:20" />un oib er hot im mit sine a shtois geton, oder er hot geshlaidert oif im epes mit a kivn, un er iz geshtorbn, <verse eid="NUM 35:20" /><verse number="21" style="v" sid="NUM 35:21" />oder er hot im mit faintshaft geshlogn mit zain hant, un er iz geshtorbn, zol teitn geteit vern der shleger; a merder iz er; der blut derleizer zol teitn dem merder, ven er treft im. <verse eid="NUM 35:21" /><verse number="22" style="v" sid="NUM 35:22" />oib ober er hot im umgericht, on faintshaft, a shtois geton, oder er hot geshlaidert oif im epes a zach on a kivn, <verse eid="NUM 35:22" /><verse number="23" style="v" sid="NUM 35:23" />oder mit epes a shtein vos me ken derfun shtarbn, hot er gevorfn oif im umgezen, un er iz geshtorbn, un er iz im nisht geven a soine, un nisht oisn geven zain beiz, <verse eid="NUM 35:23" /><verse number="24" style="v" sid="NUM 35:24" />zol di eide mishpetn tsvishn dem shleger un tsvishn dem blut derleizer loit di dozike gezetsn.<verse eid="NUM 35:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 35:25" />un di eide zol matsl zain dem toitshleger fun dem blut derleizers hant, un di eide zol im umkeren tsu zain shtot fun antrinung, vos er iz ahin antlofn, un er zol zitsn in ir biz dem toit fun koyen-gadol vos me hot im gezalbt mitn heilikn eil. <verse eid="NUM 35:25" /><verse number="26" style="v" sid="NUM 35:26" />oib ober aroisgein vet aroisgein der toitshleger fun dem gemark fun zain shtot fun antrinung, vos er iz ahin antlofn, <verse eid="NUM 35:26" /><verse number="27" style="v" sid="NUM 35:27" />un der blut derleizer vet im gefinen oiser dem gemark fun zain shtot fun antrinung, un der blut derleizer vet teitn dem toitshleger, hot er oif zich nisht kein blut. <verse eid="NUM 35:27" /><verse number="28" style="v" sid="NUM 35:28" />vorem in zain shtot fun antrinung muz er zitsn biz dem toit fun koyen-gadol, un ersht noch dem toit fun koyen-gadol meg der toitshleger zich umkeren tsu dem land fun zain eigentum. <verse eid="NUM 35:28" /><verse number="29" style="v" sid="NUM 35:29" />dos zol aich zain far a recht gezets oif aiere dor-doires in ale aiere voinerter.<verse eid="NUM 35:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30" />ver nor es dershlogt a nefesh, zol men hargen dem merder loit dem moil fun eides; un ein eides ken nisht eides zogn oif a mentshn, er zol shtarbn. <verse eid="NUM 35:30" /><verse number="31" style="v" sid="NUM 35:31" />un ir zolt nisht onnemen an oisleiz far dem nefesh fun a merder vos iz farshuldikt tsum toit; naiert teitn muz er geteit vern. <verse eid="NUM 35:31" /><verse number="32" style="v" sid="NUM 35:32" />un ir zolt nisht onnemen an oisleiz fun dem vos iz antlofn in zain shtot fun antrinung, az er zol megn zich umkeren voinen in land far dem koyens toit. <verse eid="NUM 35:32" /><verse number="33" style="v" sid="NUM 35:33" />un ir zolt nisht zindik machn dos land vos ir zitst drinen, vorem blut dos macht zindik dos land, un dem land vert nisht fargebn far dem blut vos iz drinen fargosen gevorn, saidn mit dem blut fun dem vos hot es fargosen. <verse eid="NUM 35:33" /><verse number="34" style="v" sid="NUM 35:34" />un zolst nisht farumreinikn dos land vos ir zitst drinen, vos ich ru in dem; vorem ich, Hashem, ru tsvishn di kinder fun Yisroel.<verse eid="NUM 35:34" /></para>
  <chapter eid="NUM 35" />
  <chapter number="36" style="c" pubnumber="לו" sid="NUM 36" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1" />un di hoiptlait fun di foterhaizer fun der mishpoche fun di kinder fun Gilad, dem zun fun Machir, dem zun fun Menashehn, fun di mishpoches fun di kinder fun Yosef, hobn genent, un hobn geredt far Mosheen, un far di firshtn, di hoiptlait fun di foterhaizer fun di kinder fun Yisroel, <verse eid="NUM 36:1" /><verse number="2" style="v" sid="NUM 36:2" />un zei hobn gezogt: Hashem hot bafoiln main har tsu gebn dos land in nachle loit goirl tsu di kinder fun Yisroel, un main har iz bafoiln gevorn fun Hashem tsu gebn di nachle fun undzer bruder Tselofechadn tsu zaine techter. <verse eid="NUM 36:2" /><verse number="3" style="v" sid="NUM 36:3" />un az zei veln vern far vaiber tsu einem fun di zin fun di shvotim fun di kinder fun Yisroel, vet zeyer nachle geminert vern fun der nachle fun undzere foters, un vet tsugeleigt vern tsu der nachle fun dem sheyvet vos zei veln tsu im gehern; azoi vet geminert vern fun dem goirl fun undzer nachle. <verse eid="NUM 36:3" /><verse number="4" style="v" sid="NUM 36:4" />afile az Yuval vet zain bai di kinder fun Yisroel, vet zeyer nachle blaibn tsugeleigt tsu der nachle fun dem sheyvet vos zei veln tsu im gehern, un zeyer nachle vet geminert vern fun der nachle fun undzere foters.<verse eid="NUM 36:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5" />hot Moshe bafoiln di kinder fun Yisroel loit dem moil fun Hashem, azoi tsu zogn: gerecht tainet der sheyvet fun di kinder fun Yosef. <verse eid="NUM 36:5" /><verse number="6" style="v" sid="NUM 36:6" />dos iz di zach vos Hashem hot bafoiln vegen di techter fun Tselofechadn, azoi tsu zogn: zei megn vern far vaiber tsu dem vos vet voilgefeln in zeyere oign, ober in der mishpoche fun dem sheyvet fun zeyer foter zoln zei vern far vaiber. <verse eid="NUM 36:6" /><verse number="7" style="v" sid="NUM 36:7" />kedei a nachle fun di kinder fun Yisroel zol nisht ibergein fun sheyvet tsu sheyvet; naiert di kinder fun Yisroel zoln zain baheft itlecher on der nachle fun dem sheyvet fun zaine foters. <verse eid="NUM 36:7" /><verse number="8" style="v" sid="NUM 36:8" />un yetveder tochter fun di shvotim fun di kinder fun Yisroel, vos yershet a nachle, muz vern far a vaib tsu einem fun der mishpoche fun ir foters sheyvet; kedei di kinder fun Yisroel zoln yarshen itlecher di nachle fun zaine foters. <verse eid="NUM 36:8" /><verse number="9" style="v" sid="NUM 36:9" />un a nachle zol nisht ibergein fun ein sheyvet tsu an ander sheyvet; naiert di shvotim fun di kinder fun Yisroel zoln zain baheft itlecher on zain nachle.<verse eid="NUM 36:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10" />azoi vi Hashem hot bafoiln Mosheen, azoi hobn di techter fun Tselofechadn geton. <verse eid="NUM 36:10" /><verse number="11" style="v" sid="NUM 36:11" />un Machlah, Tirtsah, un Choglah, un Milcah, un Noah, di techter fun Tselofechadn, zainen gevorn far vaiber tsu di zin fun zeyere feters. <verse eid="NUM 36:11" /><verse number="12" style="v" sid="NUM 36:12" />in di mishpoches fun di kinder fun Menasheh dem zun fun Yosefn zainen zei gevorn far vaiber, un zeyer nachle iz geblibn in dem sheyvet fun zeyer foters mishpoche.<verse eid="NUM 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13" />dos zainen di gebot un di gezetsn vos Hashem hot gebotn di kinder fun Yisroel durch Mosheen in di ploinen fun Moav baim Yarden lebn Yericho.<verse eid="NUM 36:13" /></para>
  <chapter eid="NUM 36" />
</usx>