<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Rufumbira New Testament</book>
  <para style="h">2 PEETERO</para>
  <para style="toc3">2Pet</para>
  <para style="toc2">2 PEETERO</para>
  <para style="toc1">Urwandiko rwa kabiri rwanditswe na Intumwa PEETERO</para>
  <para style="mt2">Urwandiko rwa kabiri rwanditswe n'Intumwa</para>
  <para style="mt1">PEETERO</para>
  <para style="imt">INYANZURO</para>
  <para style="im">
    <char style="bk">Urwandiko rwa kabiri rwanditswe n'Intumwa Peetero </char> rwandikiwe abakristo boose ba mbere muri rusange. Ikigendererwa ca rwo gikuru ni ukurwanya abiigiisha b'ibinyoma hamwe n'ingeso mbi zituruka mu nyigiisho zaabo. Igisubizo c'ibi bibazo ni ukwibanda kukumenya ubwenge bw'Imaana nyaabwo na Yesu Kristo. Ubu bwenge bwamamajwe n'abantu biiboneye Yesu Kristo ubwabo, bakiyumvira n'inyigiisho ze. Umwanditsi yiitaaye na caane ku nyigiisho z'abo bavuga ko Kristo atazaagaruka hano ku isi. Avuga yuuko uko gutinda kugaruka ku isi kwa Kristo ari ku mpamvu yuuko Imaana <char style="it">idashaaka ko hagira urimbuka, ahuubwo ishaaka ko boose bahinduka bakava mu byaha byabo. </char> 3:9</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro <char style="ior"><ref loc="2PE 1:1-2">1:1-2</ref></char></para>
  <para style="io1">Guhamagarwa kw'abakristo <char style="ior"><ref loc="2PE 1:3-21">1:3-21</ref></char></para>
  <para style="io1">Abiigiisha b'ibinyoma <char style="ior"><ref loc="2PE 2:1-22">2:1-22</ref></char></para>
  <para style="io1">Kugaruka kwa Kristo <char style="ior"><ref loc="2PE 3:1-18">3:1-18</ref></char></para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="s">Indamutso</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />Njeewe Simooni Peetero, umugaragu kandi intumwa ya Yesu Kristo,</para>
  <para style="p" vid="2PE 1:1">ndabandikiye mwebwe abaamaze kwakira kwizeera kw'agiciiro nk'uko naatwe twakiiriye binyuriye mu butungaane bw'Imaana yaacu n'Umukiza waacu Yesu Kristo.<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />Ubuntu n'amahoro muheeshwa no kumenya Imaana n'Umwami waacu Yesu bigwire muri mwe.<verse eid="2PE 1:2" /></para>
  <para style="s">Guhamagarwa no Gutooranywa n'Imaana</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />Imbaraga za kamere y'Imaana zaaduhaaye ibyifuzwa byose mu bugingo bwacu no kuubaha Imaana, tubiheeshejwe no kumenya uwaduhamagaye ku bw'ikuzo rye n'ubugwaneeza. <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />Bityo iduha amaseezerano y'agaciiro akomeye, kugira ngo muri yo, muzaabone uko muhunga ubugira naabi bwo mu isi buuzanwa n'irari, nuuko mubone uko musangira ibiikorwa bya kamere y'Imaana. <verse eid="2PE 1:4" /><verse number="5" style="v" sid="2PE 1:5" />Ku bw'iyo mpamvu, mukwiriye gukora ibishoboka, mu kongera ubugwaneeza ku kwizeera, ubugwaneeza mukongeraho ubumenyi, <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />ubumenyi mwongereho ukwifata, ukwifata mwongereho ukwihangaana, ukwihangaana mwongereho kuubaha Imaana, <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />kuubaha Imaana mwongereho kubaana kwa kivandimwe, nuuko kubaana kwa kivandimwe mwongereho urukundo. <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />Kuko ibi byose ni biba muri mwe kandi bikabagwiramo, muzaagira umwete no gukora neeza mu kumenya Umwami waacu Yesu Kristo. <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />Kuko umuntu weese udafite ibyo ntaareeba kure kandi ameze nk'impumyi, akiibagirwa yuuko yeejejwe agakuurwaho ibyaha bye bya keera.<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />Nuuko reero bavandimwe, mushiishikarire guhamya, gutooranywa no guhamagarwa kwanyu, kuko nimubigenza mutyo, ntimuziigera musiitaara na hato. <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />Bityo reero, bizaabaheesha uburenganzira bwuzuye bwo kwinjira mu Bwami bw'iteeka bw'Umwami waacu kandi Umukiza Yesu Kristo.<verse eid="2PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />Ni co gituma mfite umwete wo guhora mbibutsa ibyo byose, n'ubwo musanzwe mubiizi kandi mugashinga imizi mu kuri mwakiiriye. <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />Nteekereza ko bikwiriye kugira ngo igihe coose nkiri muri iyi si nkwiriye guhora mbibibutsa <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />ubwo nzi neeza yuuko ngiye kuva muri iyi si bidatinze, kandi koko ni nk'uko Umwami waacu Yesu Kristo yabiinyeruriye. <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />Kandi nzaakora ibishoboka byose kugira ngo niimara kuva muri iyi si, muzaashobore kubyibuka igihe coose.<verse eid="2PE 1:15" /></para>
  <para style="s">Ubuhamya bw'Abiiboneye Ikuzo rya Yesu Kristo</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />Kuko ntaabwo twakurikije imigani y'imihimbano ubwo twabamenyeeshaga iby'imbaraga no kuuza k'Umwami waacu Yesu Kristo, ariko turi abahamya babyo kuko twiboneye n'amaaso yaacu ikuzo rye. <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" /><note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAT 17:1-5">Mat 17:1-5</ref>; <ref loc="MRK 9:2-7">Mar 9:2-7</ref>; <ref loc="LUK 9:28-35">Luk 9:28-35</ref>.</char></note>Kuko yahaawe icuubahiro n'ikuzo kuva ku Maana Daata ubwo ijwi ry'ikuzo rihebuuje ryamuujeho, rivuga riti, “Uyu ni Umwana wanje nkunda, unyizihiza.” <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />Twe ubwacu twumviise iri jwi riva mu ijuru, ubwo twari hamwe na Yesu Kristo ku musozi weera.<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />Noone turushaho gushira iciizeere mu butumwa bwahanuuwe. Kandi namwe muzaaba mugize neeza nimubwitaho kuko ni nk'itaara ryaka, rikamurika ahari umwijima. Ubwo butumwa mukwiriye kubushiraho umwete bukarinda buca nuuko inyenyeeri yo mu gitondo<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">Yesu Kristo ni we </char><char style="it">Nyenyeri yo mu gitondo ivugwaho </char> </note> ikarasira mu mitima yaanyu. <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />Mbere ya byose mukwiriye gusobaanukirwa ko ubuhanuuzi bwose mu byanditswe byera atari insobaanura y'umuntu ku bwe, <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />kuko ari nta buhanuuzi bwahanuuwe ku bw'ubushaake bw'umuntu, ahuubwo ko ari abagabo n'abagore baayobowe n'Umwuka Weera kuvuga ijambo rivuuye ku Maana.<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">Abahanuuzi b'Ibinyoma</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />Nk'uko abahanuuzi b'ibinyoma babaayeho mu bantu ba Isirayeli, ni ko no muri mwe hazaadukamo abiigiisha b'ibinyoma. Bazaabaazamo rwihishwa bazanye inyigiisho ziyobya abantu, zikabaroha mu nzira yo kurimbuka. Ndetse biihakane na Yesu Kristo wabacunguye, maze ibyo bibageze ku kurimbuka kwa vuba vuba. <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />Ukuuyeho ibyo, benshi bazaakurikiza ingeso zaabo mbi zikojeje isoni, kandi ku bw'inyigiisho zaabo benshi bazaasebya inzira y'ukuri. <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />Kandi ubusambo bwabo buzaabateera kubabwira amagambo biihimbiye ngo bababonemo inyungu. Nyamara urubanza rwabo rwaraciiwe kuva keera, kandi ubarimbura ari maaso.<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />Imaana ntiyababariye abaamalayika ubwo baayicumuyeho, ahuubwo yabajugunye mu muriro w'iteeka, nuuko ibaboheesha injegeri mu mwijima w'ikuzimu aho bazaaba kugeza ku munsi wo guciirwa urubanza. <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />Kandi Imaana ntiyababariye abo ku isi mu gihe ca keera, ahuubwo yatsembeesheje umwuzure abaayiiyobagije, naho Nowa wabwirizaga ubutumwa bw'ubutungaane hamwe n'abandi bantu barindwi gusa, bararokoka. <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />Ikindi gihe, Imaana yaciiriye urubanza amatawuni makuru ya Sodomu na Gomora, iyatsembeesha umuriro ahinduka igitaazi maze iyagira akabarore keerekana uko bizaabeera abo batayuubaha. <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />Imaana yarokoye Looti, umugabo w'intungaane wari warashavujwe n'imibeereho n'ingeso mbi z'abanyabyaha. <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />Uyu mugabo w'intungaane yari abatuuyemo, ariko buri munsi yashengurwaga umutima ubwo yabonaga kandi akumva ubukozi bw'ibibi bwabo. <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />Nuuko reero Uhoraho azi uburyo bwo kuvaana abamwubaha mu bigeragezo, hamwe no guteguura no guhana abakiraanirwa bategereje umunsi wo guciirwa urubanza <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />na caane abo bakurikiza irari baterwa na kamere y'umubiri, n'abo bahinyura gutegeka kw'Imaana.</para>
  <para style="p" vid="2PE 2:10">Abo biigiisha b'ibinyoma biigiisha bashize amanga kandi biitanze, ntibatiinya gutuka no gusebya abaahaawe ikuzo bo mu ijuru. <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />Nyamara n'ubwo abaamalayika barusha abiigiisha b'ibinyoma imbaraga n'ububaasha, ntibashinja abaahaawe ikuzo babatuka imbere ya Nyagasani. <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />Ariko aba biigiisha b'ibinyoma bameze nk'inyamaaswa zidateekereza kandi zitagira ubwenge, zikaba zibeereyeho gutegwa no kwicwa. Bavuga naabi ibyo badasobaanukiwe, kandi bazaarimburwa nk'izo nyamaaswa, <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />bazaababazwa baryora gukora ibibi. Baneezeezwa no gukora kwineezeeza irari ry'imibiri yaabo kumanywa izuuba riva, ariko igihe basangira namwe mu minsi mikuru bakoza isoni kandi bagateesha agaciiro, kuko bashiimiishwa n'uburimanganya bwabo. <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />Amaaso yaabo yuuzuye ubusambanyi kandi ntibasiiba gukora ibyaha. Baguusha abafite intege nke mu mutego. Imitima yaabo yatoojwe kurarikira ubusambo, bityo bakaba ibivume. <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />Baataaye inzira igororotse, bayoba bakurikiye inzira ya Balaamu mwene Bewori wakunze isente zo yaboonye mu buryo budakwiriye, <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />ariko akaba yaraamagiriwe ku bw'icaaha ce. Indogobe ye itavuga, yavugiye mu ijwi ry'abantu yamagirira uwo muhanuuzi ibikorwa bye by'ubasazi.<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />Abo biigiisha b'ibinyoma ni nk'imigezi itagira amaazi kandi bameze nk'igiho gihuuhwa n'umuyaga. Imaana yabageneye umwanya w'umwijima w'icuraburindi. <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />Bavuga amagambo y'ubwibone atagira shinge na rugero, kandi bagakoreesha irari ribi ry'umubiri waabo kuresha abantu bamaze kwitandukanya n'icaaha, bakabayobya. <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />Babaseezeranya umudendeezo, ariko bo ubwabo ari imbaata z'ingeso mbi kandi zizaabarimbura. Kuko umuntu weese aba imbaata y'ikintu coose caamutsinze. <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />Kuko niiba baariitandukanyije n'ubwandu bw'isi ubwo baaje kumenya Umwami waacu kandi Umukiza Yesu Kristo, nuuko reero bakongera kubwizingiramo bakaneeshwa, abantu nk'abo imibeereho yaabo ya nyuma izaba mibi kurusha iya mbere. <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />Kuko byakabaaye byiza iyo baba bataarayobotse inzira y'ubutungaane, kuruta uko baaba bamaze kuyiyoboka, bagasubira inyuma, bagasuuzugura amategeko yeera baahaawe. <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />Ibiba bibabaayeho bihamya uko iyi migani iciibwa, iti,</para>
  <para style="q1" vid="2PE 2:22">“Imbwa isubira inyuma ikarya ibyo yarutse,”</para>
  <para style="m" vid="2PE 2:22">cangwa ngo,</para>
  <para style="q1" vid="2PE 2:22">“Ingurube yuuhagiwe isubira kuja kwigaragura mu byondo.”<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">Iseezerano ryo Kugaruka kwa Yesu Kristo</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />Bakundwa, uru ni urwandiko rwa kabiri mbandikira. Mu nzandiko zombi, ngerageza gukangura imitima yaanyu itagira ibiteekerezo bibi mbiibutsa <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />ko mukwiriye kwibuka amagambo yavuzwe n'abahanuuzi beera mu gihe caashize hamwe n'amategeko y'Umwami kandi Umukiza yavuze akoreesheje intumwa zaanyu. <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" /><note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="JUD 1:18">Yuda 1:18</ref>.</char></note>Ic'ibanze, mukwiriye kumenya ko mu minsi ya nyuma hazaaza ababannyega, babashinyagurira, bagakurikiza irari ryabo <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />kandi bavuga bati, “Mbese ntiyaseezeranye ko azaagaruka? Noone ari he? Dore uheereye igihe ba sogokuruza baapfiiriye, ibintu byose bikomeza kuba nk'uko byari bimeze kuva isi ikiremwa!” <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />Ubwo bakiirengagiza nkana yuuko mu ntagiriro Imaana yakoreesheje ijambo ryayo kurema ijuru n'isi. Isi yaremwe ikuuwe mu maazi kandi ikazengurukwa na yo. <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />Byongeye kandi, amaazi y'umwuzuure ni yo yarengeye isi mu gihe ca keera, ikarimbuka. <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />Ariko Imaana ikoreesheje iryo jambo yategetse ijuru n'isi biriho ubu kugumaho kugeza igihe izaaciira urubanza. Nibwo Imaana izaabitwika n'umuriro, nuuko abatayuubaha barimburwe.<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />Ariko bakundwa ntimwirengagize uku kuri, ko kuri Nyagasani umunsi umwe uhwanye n'imyaka igihumbi kandi imyaka igihumbi ikaba nk'umunsi umwe. <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />Nyagasani ntaatinda gukora ibyo yaseezeranyije nk'uko bamwe bibwira ko atinze, ariko arabiihangaanira, yuuko adashaaka kugira ngo hagire urimbuka ahuubwo ko boose baakwihana ibyaha byabo.<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:43">Mat 24:43</ref>; <ref loc="LUK 12:39">Luk 12:39</ref>; <ref loc="1TH 5:2">1Tes 5:2</ref>; <ref loc="REV 16:15">Ibya 16:15</ref>.</char>
    </note>Kandi umunsi w'Uhoraho uzaaza nk'uko umujuura aza, nuuko ijuru rizimirane n'urusaku rwinshi, hamwe n'ibiririmo byose biyongere mu muriro, naho isi n'ibiyikorerwamo byose bishiriire. <verse eid="2PE 3:10" /><verse number="11" style="v" sid="2PE 3:11" />Ubwo reero ibyo byose bizaarimburwa muri ubwo buryo, imyifatire yaanyu ikwiriye kuba ite? Mukwiriye kuba abaziranenge kandi buubaha Imaana, <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />mutegereje umunsi wo kugaruka k'Uhoraho mukawutebuutsa. Kuri uwo munsi ijuru rizaagurumira riyonge kandi n'ibirimo byose bizaayongera mu muriro. <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" /><note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="REV 21:1">Ibya 21:1</ref>.</char></note>Ariko nk'uko yaduseezeranyije, dutegereje ijuru risha n'isi nsha, ahatuura ubukiraanutsi.<verse eid="2PE 3:13" /></para>
  <para style="s">Uko Twakwifata Dutegereje Nyagasani</para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />Nuuko reero bakundwa, mugitegereje ibyo, mukwiriye kugira umwete ngo uwo munsi muzaasangwe mu mahoro, mutagira umugayo cangwa inenge. <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />Kandi mumenye ko kwihangaana k'Umwami waacu ari ko gakiza. Mwene Daata Pawulo na we yabandikiye akoreesheje ubuhanga yahaawe. <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />Pawulo yanditse avuga kuri ibi mu nzandiko ze zoose. Mu izo nzandiko, harimo bimwe biruhije gusobaanukirwa, ibyo injiji n'abadafite kwizeere guhamye basobanya, nk'uko bagenza n'ibindi ibyanditswe byera, bikabaazanira kurimbuka.<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />Noone reero bakundwa, ubwo mubimenye mbere y'igihe, mwirinde kuyobeeshwa n'ububeeshi bw'abanyabyaha nuuko mukava ku ishingiro ryanyu. <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />Ariko mukurire mu buntu no kumenya Umwami waacu kandi Umucunguzi Yesu Kristo. Naahaabwe ikuzo ubu n'iteeka ryose. Amiina.<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>