<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Rufumbira New Testament</book>
  <para style="h">IBYAKOZWE N'INTUMWA</para>
  <para style="toc3">Iby</para>
  <para style="toc2">IBYAKOZWE N'INTUMWA</para>
  <para style="toc1">IBYAKOZWE N'INTUMWA</para>
  <para style="mt1">IBYAKOZWE N'INTUMWA</para>
  <para style="imt">INYANZURO</para>
  <para style="im">
    <char style="bk">Ibyakozwe n'Intumwa</char> ni amagambo akomezamo y'ubutumwa bwa <char style="bk">Luka</char>. Ikigendererwa gikuru ni ukuvuga ukuntu abiigiishwa ba Yesu baayobowe n'Umwuka Weera, kwamamaza Inkuru nziza ya Yesu muri Yerusaalemu, i Yudeeya n'i Samariya ukageza ku mpera y'isi 1:8. Ibi bivuga ibyabayeho uko ubukristo bwatangiye mu Bayuuda bukaba ukwemera ku isi yoose. Umwanditsi yari ashiishikariye guhamiriza abasomyi ko Abakristo batari agatsiko k'abaheekera b'ubutegetsi bwa Rooma, kandi ko kwizeera kwa gikristo ari ukuuzuriza iby'idiini y'Abayuuda.</para>
  <para style="ip">
    <char style="bk">Ibyakozwe n'Intumwa</char> birimo ibice bitatu bikuru, byerekana gusaakaara ku Butumwa bwa Yesu Kristo bwamamajwe n'uko Itoorero ryatangiye: (1) Intangiriro y'ubukristo i Yerusaalemu haanyuma yo kuzaamuuka kwa Yesu, (2) Kwiyongera mu bindi bice bya Palesitina, (3) Kongera kwaguka mu bice byitoorooye inyanja ya Meditereniyani ukageza i Rooma.</para>
  <para style="ip">Ikintu gikuru kigaragara mu <char style="bk">Byakozwe n'Intumwa</char> n'umurimo mukuru wakozwe n'Umwuka Weera, yaje n'imbaraga akaja ku biizeera baari i Yerusaalemu ku munsi wa Pentekooti kandi ugakomeza kuyobora no gushimangira Itoorero n'abayobozi baryo mu byabaayeho byerekanywe muri iki gitabo. Ubutumwa bwa gikristo mu itoorero rya mbere bwerekanwa mu nshamake inyigiisho n'ibyabayeho byanditswe mu <char style="bk">Byakozwe n'Intumwa</char> byerekana imbaraga z'ubu butumwa zaagaragaye mu mibeereho y'abiizeera no guteeranira hamwe kw'itoorero.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Kwiteguurira guhamya<char style="ior"><ref loc="ACT 1:1-26">1:1-26</ref></char></para>
  <para style="io1">(a). Ibyo Yesu yategetse nyuma n'ibyo yaseezeranyije<char style="ior"><ref loc="ACT 1:1-14">1:1-14</ref></char></para>
  <para style="io1">(b). Uwazunguuye Yuda<char style="ior"><ref loc="ACT 1:15-26">1:15-26</ref></char></para>
  <para style="io1">Ubuhamya muri Yerusaalemu<char style="ior"><ref loc="ACT 2:1-8:3">2:1—8:3</ref></char></para>
  <para style="io1">Ubuhamya muri Yudeeya n'i Samariya<char style="ior"><ref loc="ACT 8:4-12:25">8:4—12:25</ref></char></para>
  <para style="io1">Ubuheereza bwa Pawulo <char style="ior"><ref loc="ACT 13:1-28:31">13:1—28:31</ref></char></para>
  <para style="io1">(a). Urugendo rwa mbere rwa Pawulo rw'ivugabutumwa<char style="ior"><ref loc="ACT 1:1-14:28">1:1—14:28</ref></char></para>
  <para style="io1">(b). Igiteerane co muri Yerusaalemu<char style="ior"><ref loc="ACT 15:1-35">15:1-35</ref></char></para>
  <para style="io1">(c). Urugendo rwa kabiri rw'ivugabutumwa<char style="ior"><ref loc="ACT 15:36-18:22">15:36—18:22</ref></char></para>
  <para style="io1">(d). Urugendo rwa gatatu rw'ivugabutumwa<char style="ior"><ref loc="ACT 18:23-21:16">18:23—21:16</ref></char></para>
  <para style="io1">(e). Pawulo asibiwe i Yerusaalemu, Kayisaariya n'i Rooma <char style="ior"><ref loc="ACT 21:17-28:31">21:17—28:31</ref></char></para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s1">Iseezerano ry'Umwuka Weera</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:1-4">Luk 1:1-4</ref>.</char>
    </note>Kuri Tewofilo, mu gitabo ca mbere nanditse ibintu byose Yesu yakoze kandi yiigiishije kuva agitangira umurimo we <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />kugeza ku munsi yazaamuukiye mu ijuru, amaze gutegeka intumwa ze yitooranyirije ayobowe n'Umwuka Weera. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />Haanyuma yo kubabazwa, abonekera intumwa ze ari muzima atanga ibimenyeetso byinshi aguma kubabonekera mu minsi mirongo ine ababwira iby'Ubwami bw'Imaana. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" /><note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="LUK 24:49">Luk 24:49</ref>.</char></note>Ubwo yari kumwe na bo<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">Mu bindi byanditswe harimo</char><char style="fqa" closed="false">Bafungura </char></note> abategeka kutava i Yerusaalemu, ahuubwo ko bategereza ibyo Imaana Daata yaseezeranye. Arababwira ati, “Ibi n'ibyo mwumviise mvuga, <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" /><note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="MAT 3:11">Mat 3:11</ref>; <ref loc="MRK 1:8">Mar 1:8</ref>; <ref loc="LUK 3:16">Luk 3:16</ref>; <ref loc="JHN 1:33">Yoh 1:33</ref>.</char></note>kuko Yohaana yabatiriishije amaazi, naho mwebwe mu gihe gito muzaabatiriishwa Umwuka Weera.”<verse eid="ACT 1:5" /></para>
  <para style="s1">Yesu Azaamuurwa mu Ijuru</para>
  <para style="r">(<ref loc="MRK 16:19-20">Mar 16:19-20</ref>; <ref loc="LUK 24:50-53">Luk 24:50-53</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Nuuko intumwa zimaze guteeranira hamwe zibaza Yesu ziti, “Nyagasani, iki ni co gihe ugiiye kugaruriramo ubwami mu Biisirayeli?”<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />Yesu arabasubiza ati, “Iby'ibihe n'iminsi si mwe mukwiriye kubimenya, Daata wenyine ni we ubifiteho ububaasha. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" /><note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MAT 28:19">Mat 28:19</ref>; <ref loc="MRK 16:15">Mar 16:15</ref>; <ref loc="LUK 24:47">Luk 24:47</ref>,<ref loc="LUK 24:48">48</ref>.</char></note>Icakora muzahaabwa imbaraga Umwuka Weera naabaazamo kandi muzambeera abahamya i Yerusaalemu, muri Yudeeya n'i Samariya, no mu mpera z'isi.” <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" /><note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">Mar 16:19</ref>; <ref loc="LUK 24:50">Luk 24:50</ref>,<ref loc="LUK 24:51">51</ref>.</char></note>Arangije kuvuga ibyo, azaamuurwa mu ijuru bamureeba, maze igicu kiramubakingiriza ntibongera kumubona.<verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />Ubwo yazaamuukaga, intumwa zigihanze amaaso heejuru, haboneka abagabo babiri bambaye imyenda yeera, bahagarara iruhande rwazo. <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />Babwira intumwa bati, “Yemwe bantu b'i Galileeya, ni iki gitumye muhagaze hano mureeba mu ijuri? Uyu Yesu ubakuuwemo akazaamuurwa mu ijuru, azaagaruka nk'uko mumuboonye aja mu ijuru.”<verse eid="ACT 1:11" /></para>
  <para style="s1">Matiyasi Atoranwa Gusimbuura Yuda</para>
  <para style="r">(<ref loc="MAT 27:3-10">Mat 27:3-10</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Nuuko intumwa zisubira i Yerusaalemu zivuuye ku musozi wa Elayoni uri haafi ya Yerusaalemu hakaba urugendo rungana na kilomita imwe. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" /><note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">Mat 10:2-4</ref>; <ref loc="MRK 3:16-19">Mar 3:16-19</ref>; <ref loc="LUK 6:14-16">Luk 6:14-16</ref>.</char></note>Bageze mu Tawuni nkuru, baja mu gisenge co heejuru aho baari bacumbitse. Abaariho ni aba; Peetero, Yohaana, Yaakobo, Andereya, Filipo, Tomasi, Batulumaayo, Matayo, Yaakobo mwene Alufaayo, Simooni umurwanashaka, na Yuda mwene<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">Mu bindi byanditswe harimo </char><char style="fqa" closed="false">Mwene nyina </char></note> Yaakobo. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Izo ntumwa n'abagore baarimo Mariya nyina wa Yesu na beene nyina ba Yesu, abo boose bakomeza gusengera hamwe bahuuje umutima.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />Muri iyo minsi haabayeho inaama y'abiizeera, boose hamwe baari nk'ijana na makumyabiri, nuuko Peetero arahaguruka abwira abaari muri iyo naama ati, <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />“Bavandimwe, ibyanditswe byagombaga gusohora nk'uko Umwuka Weera yahishuuriye Dawudi ibyerekeye Yuda wayoboye abaafashe Yesu. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Kuko Yuda yari umwe muri twe, kandi agahaabwa umugabane w'uyu murimo waacu.”<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:3-8">Mat 27:3-8</ref>.</char>
    </note>[Kandi uyu mugabo amaze kugura umurima ukomootse ku bihembo by'ubugambanyi bwe, yitimbura haasi, inda ye iraturika, maze amara yoose arasohoka. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Ibi byamenyeekanye mu bantu boose batuuye i Yerusaalemu, ni co caatumye uwo murima bawita Hakerudama mu rurimi rwabo, bisobaanura Umurima w'amaraso.]<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />“Kuko byanditswe mu gitabo ca Zaaburi ngo,</para>
  <para style="q1" vid="ACT 1:20">‘Urugo rwe rurakaba amatongo,</para>
  <para style="q2" vid="ACT 1:20">ntihazaagire urutuuramo ukundi.’</para>
  <para style="m" vid="ACT 1:20">Kandi ngo,</para>
  <para style="q1" vid="ACT 1:20">‘Reka umurimo we w'ubuheereza uhaabwe undi.’<verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:21 a </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:16">Mat 3:16</ref>; <ref loc="MRK 1:9">Mar 1:9</ref>; <ref loc="LUK 3:21">Luk 3:21</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="MRK 16:19">Mar 16:19</ref>; <ref loc="LUK 24:51">Luk 24:51</ref>.</char>
    </note>Nuuko reero umwe mu bo twagendanaga buri gihe, ubwo Umwami Yesu yari akiri naatwe, <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />kuva mu gihe Yohaana yabatizaga, ukageza umunsi Yesu yazaamuuwe aja mu ijuru. Umwe muri bo agomba gutoorwa, akatwiyungaho, akabaana naatwe mu guhamya kuzuuka kwa Yesu.”<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />Nuuko baazana amazina abiri, Yozefu wiitwaga Barisaba wo benshi baari baazi nka Yusito, hamwe na Matiyasi. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />Maze basenga bavuga bati, “Nyagasani, wowe umenya imitima y'abantu boose, twereke uwo utooranyije muri aba bombi <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />kugira ngo abe intumwa mu cimbo ca Yuda kandi afate umurimo w'ubuheereza Yuda yataaye akaja ahamukwiriye.” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Nuuko bakora ubufindo bwo gutooranya umwe muri bo, bufata Matiyasi yongerwa ku ntumwa cumi n'imwe.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s1">Umwuka Weera Amanukira Intumwa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Umunsi wa Pentekooti ugeze, abiizeera boose baari mu mwanya umwe. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Ako kaanya, umuriri ubatungura uvuuye mu ijuru umeze nk'umuyaga mwinshi maze wuuzura inzu baari biicayemo. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Nuuko haboneka indimi ziigabanyije zisa n'iz'umuriro, zija ku mutwe wa buri weese. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Abiizeera boose buuzura Umwuka Weera batangira kuvuga izindi ndimi, nk'uko Umwuka Weera yabahaaye ubushobozi.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />I Yerusaalemu haabaga Abayuuda buubaha Imaana baari baturutse mu mahanga yoose y'isi. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Abantu benshi bamaze kumva urwo rusaku bateranira hamwe batangazwa n'uko bumvaga buri umwe avuga mu rurimi rw'iwaabo. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Baratangaara kandi baruumirwa maze barabaza bati, “Mbese aba bantu boose bavuga si Abanyagalileeya? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Bishoboka bite ko twumva bavuga indimi za kavukire z'iwaacu ? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Twe turi Abapariti, Abameedi, Abeelamu, n'abatuuye i Mesopotamiya, i Yudeeya, na Kapadokiya, Ponti no muri Asiya, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />Fulujiya, Pamfiliya, Igiputi no mu bice bya Libiya byegeranye n'i Kureni, abashitsi baturutse i Rooma, Abayuuda ba kavuukire n'abatari Abayuuda ariko bayobotse idiini yaabo, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />kandi n'Abakireete n'Abaharabu, turabumva bavuga mu ndimi z'iwaacu ibitangaaza Imaana ikora.” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />Abo bantu boose baratangaara, baruumirwa, maze barabaazanya bati, “Mbese ibi bimenyeesha iki?”<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />Abandi barabaseka bavuga bati, “Baasinze inzoga y'ihiira.”<verse eid="ACT 2:13" /></para>
  <para style="s1">Peetero Asobaanurira Abantu Benshi Ibibaaye</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Ariko Peetero ahagarara n'izindi ntumwa cumi n'imwe, abwira abantu benshi n'ijwi rirenga ati, “Beene waacu b'i Yudeeya namwe mwese abatuuye i Yerusaalemu, reka ibi byose bimenyekane kandi mwumve ibyo mvuga. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Aba bantu ntaabwo baasinze, nk'uko muteekereza. Dore ubu ni saaha itatu z'igitondo. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Ahuubwo ibi mureeba byavuzwe n'umuhanuuzi Yoweri ati,<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />‘Imaana iravuga iti, Mu minsi y'imperuuka,</para>
  <para style="q2" vid="ACT 2:17">Nzasuka Umwuka wanje ku bantu boose, kandi</para>
  <para style="q1" vid="ACT 2:17">abahungu n'abakoobwa baanyu bazaahanuura, kandi</para>
  <para style="q2" vid="ACT 2:17">n'abasore baanyu bazeerekwa,</para>
  <para style="q2" vid="ACT 2:17">n'abasaaza baanyu bazaroota inzozi.<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />Muri iyo minsi abagaragu n'abaja banje, nzaabasukaho Umwuka wanje maze bahanuure.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />Nzakora ibitangaaza mu ijuru heejuru n'ibimenyeetso haasi ku isi.</para>
  <para style="q2" vid="ACT 2:19">Hazaagaragara amaraso, umuriro, n'igiho gicumba umwotsi.<verse eid="ACT 2:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="ACT 2:20" />Izuuba rizaahinduka umwijima,</para>
  <para style="q2" vid="ACT 2:20">n'ukwezi guhinduke umutuku nk'amaraso</para>
  <para style="q2" vid="ACT 2:20">mbere yuuko umunsi mukuru w'Uhoraho ugera.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />Kandi umuntu weese uzambaza izina ry'Uhoraho azaakizwa.’ ”<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />Peetero akomezamo ati, “Yemwe Biisirayeli<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">Murugiriki </char><char style="fqa" closed="false">Bagabo ba Isirayeli </char></note> nimutege amatwi mwumve ibyo ngiye kubabwira. Yesu w'i Nazaareeti wa muntu Imaana yemeje muri mwe n'ibikorwa by'imbaraga, ibitangaaza n'ibimenyeetso by'Imaana yabakoreye muri we, nk'uko namwe mu biizi. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" /><note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MAT 27:35">Mat 27:35</ref>; <ref loc="MRK 15:24">Mar 15:24</ref>; <ref loc="LUK 23:33">Luk 23:33</ref>; <ref loc="JHN 19:18">Yoh 19:18</ref>.</char></note>Uyu muntu yarabagabijwe nk'uko Imaana yari yarabiteguuye ikabimenya bitari byaba, mwaramubambye mumwicisha amaboko y'abagome. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" /><note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 28:5">Mat 28:5</ref>,<ref loc="MAT 28:6">6</ref>; <ref loc="MRK 16:6">Mar 16:6</ref>; <ref loc="LUK 24:5">Luk 24:5</ref>.</char></note>Ariko Imaana yamuzuuye mu bapfu, imubohoora ingoyi z'urupfu, kuko bitashobotse ko aheranwa n'imbaraga za rwo. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Kuko Dawudi yavuze ibimufasheho ati,</para>
  <para style="q1" vid="ACT 2:25">‘Naboonye Nyagasani ari imbere yanje buri gihe,</para>
  <para style="q2" vid="ACT 2:25">kuko ari iburyo bwanje sinzanyeganyezwa.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />Ni co gituma umutima wanje wiishimye,</para>
  <para style="q2" vid="ACT 2:26">nkagira umuneezeero mu kuvuga kwanje,</para>
  <para style="q1" vid="ACT 2:26">kandi umubiri wanje</para>
  <para style="q2" vid="ACT 2:26">uzaaruhuuka ufite ibyiringiro.<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />Kuko utazaateererana ubugingo bwanje ikuzimu mu bapfu,</para>
  <para style="q2" vid="ACT 2:27">cangwa ngo wemere ko Intungaane yaawe iborera mu gituuro.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />Wamenyeesheje inzira zigana mu bugingo,</para>
  <para style="q2" vid="ACT 2:28">Kubaana na we bituma nuuzura umunezeero.’ ”<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />Peetero akomezamo ati, “Bavandimwe, ntakimbuza kubabwira neeruye ko sogokuruza Dawudi yapfuuye kandi agahambwa, igituuro ce kikaba kikiri iwaacu kugeza ubu. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />Kuko yari umuhanuuzi, yari azi neeza ko Imaana yamurahiye indahiro yuuko Iziicaza umwe mu bamukomookaho ku ntebe y'ubwami. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />Yeeretswe mbere y'igihe uko bizaamera nuuko avuga uko Kristo azaazuuka agira ati,</para>
  <para style="q1" vid="ACT 2:31">‘Ntaabwo yateereranywe ikuzimu,</para>
  <para style="q2" vid="ACT 2:31">cangwa ngo umubiri we ubore.’<verse eid="ACT 2:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="ACT 2:32" />Uwo Yesu Imaana yazuuye, naatwe twese turi abahamya b'ibyo. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Yesu amaze gushirwa heejuru yiicazwa iburyo bw'ukuboko kw'Imaana, no guhaabwa na Se iseezerano ry'Umwuka Weera, ni wo asutse mureeba kandi mwumva. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />N'ubwo Dawudi ataazaamuutse mu ijuru nyamara yaravuze ati,</para>
  <para style="q1" vid="ACT 2:34">‘Uhoraho yabwiye Umwami Yesu ati.</para>
  <para style="q2" vid="ACT 2:34">Icara iburyo bwanje,<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />kugeza aho nzaahindurira abanzi baawe akabaaho ukandagizaho ibirenge byawe.’ ”<verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />“Nuuko reero, abo mu muryango wa Isirayeli boose niibamenye badashidikanya ko uwo Yesu mwabambye, Imaana yamugize Umutegetsi na Kristo.”<verse eid="ACT 2:36" /></para>
  <para style="s1">Abayoboke ba Mbere</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Abantu bumviise ayo magambo ya Peetero bagira ubwoba bamubaza n'izindi ntumwa bati, “Bavandimwe, noone dukore iki?”<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />Peetero arabasubiza ati, “Buri muntu weese yiihane kandi abatizwe, mu izina rya Yesu Kristo kugira ngo mubabarirwe ibyaha byanyu kandi muhaabwe impaano y'Umwuka Weera. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Kuko iseezerano ari iryanyu n'abaana baanyu, n'abarikure boose n'abandi benshi nk'uko Nyagasani Imaana yaacu iziihamagarira.”<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />Peetero akomeza kwigiisha abiihanangiriza kandi ababwira n'andi magambo menshi abahuguura ati, “Mukizwe kugira ngo muhunge igihano kiiziye inkozi z'ibibi zo muri iki gihe.” <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />Nuuko abeemeye ubwo butumwa barabatizwa, uwo munsi abantu nk'ibihumbi bitatu biyongeye ku mubare w'abiizeera. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />Baahoraga bashiishikarira inyigiisho z'intumwa no guteeranira hamwe, gusangira amafunguro hamwe no gusenga.<verse eid="ACT 2:42" /></para>
  <para style="s1">Uko Abakristo ba Mbere Baagenzaga</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />Abantu boose bagira ubwoba ku bw'ibitangaaza n'ibimenyeetso byinshi byo intumwa zaakoraga. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" /><note caller="-" style="x"><char style="xo" closed="false">2:44 </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">Iby 4:32-35</ref>.</char></note>Abiizeera boose baabaga hamwe, n'ibyo bafite byose bakabigira rusange. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />Baaguriishaga ibintu n'imitungo yaabo, bakagabana ibiguzi bavanye mo bakurikije ico buri umwe akeneye. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />Iminsi yoose baajaga guteeranira hamwe mu Nzu y'Imaana, bagasangira amafunguro mu mago yaabo<note caller="+" style="f"><char style="fr" closed="false">2:46 </char><char style="ft" closed="false">Cangwa </char><char style="fqa" closed="false">Inzu ku yindi </char></note> baneezerewe kandi bafite ubupfura mu mitima yaabo, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />bahimbaaza Imaana kandi bagashimwa n'abantu boose. Buri munsi Nyagasani Imaana yabongeereraga ku mubare w'abakizwa.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s1">Uwavuutse Aremaye Akira</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Umunsi umwe Peetero na Yohaana barazaamuuka baja mu Nzu y'Imaana mu gihe co gusenga ku saaha cenda z'amanywa. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Haari umuntu wavuutse aremaye, baamuheekaga buri munsi bakamushira ku irembo ry'Inzu y'Imaana ryitwa Irembo Ryiza kugira ngo asabirize imfashanyo abari kwinjira mu Nzu y'Imaana. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />Uwo murema aboonye Peetero na Yohaana bagiiye kwinjira mu Nzu y'Imaana, abasaba imfashanyo. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />Peetero na Yohaana bamureeba amaaso ku maaso baramubwira bati, “Tureebe.” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Uwo muntu uremaye abahanga amaaso, ategereje ko baagira ico baamuha. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Nuuko Peetero aramubwira ati, “Nta mashilingi mfite, ariko ico mfite reka nkiguhe, ku bw'ubushobozi nahaawe na Yesu Kristo w'i Nazaareeti, haguruka ugende.” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />Nuuko amufata ukuboko kw'iburyo aramuhagurutsa. Ako kaanya ibirenge by'uwo mugabo n'ubugombampuri bwe birakomera. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />Maze uwo muntu arahaguruka, arasimbuka, aratambuka yinjirana na bo mu Nzu y'Imaana, agenda asimbagurika, ahimbaaza Imaana. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />Abantu boose baamubona atambuka ahimbaaza Imaana, <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />baramumenya ko ari we wasabirizaga yiicaye ku irembo ry'Inzu y'Imaana ryitwa Irembo Ryiza. Boose birabatangaaza, buuzura umuneezeero ku bw'ibimubaayeho.<verse eid="ACT 3:10" /></para>
  <para style="s1">Peetero Yigiishiriza ku Ibaraza Ryitwa irya Solomooni</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Uwo mugabo wari umaze gukira yanga kurekura Peetero na Yohaana, abantu boose biirukankira aho bari, bateeranira ku ibaraza ryitwa irya Solomooni batangaaye caane. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Peetero abiboonye atangira kubiigiisha avuga ati, “Beene waacu ba Biisirayeli kuki mutangaazwa n'ibi, cangwa se n'iki gitumye mudutumbiira, nk'aho ibi bibaaye ku bw'imbaraga zaacu, cangwa kuubaha Imaana kwacu byatumye uyu muntu ashobora gutambuuka? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Imaana ya Aburahamu, Imaana ya Isaaka, Imaana ya Yaakobo, Imaana ya basogokuruza yahaaye umugaragu<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Cangwa </char><char style="fqa" closed="false">Umwana </char></note> waayo Yesu icuubahiro wo mwatanze muka mwihakanira, imbere ya Pilaato kandi we yari yiyemeje kumurekura. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" /><note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">Mat 27:15-23</ref>; <ref loc="MRK 15:6-14">Mar 15:6-14</ref>; <ref loc="LUK 23:13-23">Luk 23:13-23</ref>; <ref loc="JHN 19:12-15">Yoh 19:12-15</ref>.</char></note>Mwihakanye Uweera kandi ari Intungaane maze musaba ko babarekurira umwicanyi. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />Mwishe Umutangabugingo, ariko Imaana imuzuura mu baapfuuye. Turi abahamya baabyo. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />Ku bwo kwizeera izina rya Yesu, iryo zina ubwaryo ryatumye uyu muntu wari umurema mureeba kandi muuzi agira imbaraga, kandi ku bwo kwizeera Yesu bitumye akira nk'uko bigaragaye imbere yaanyu mwese.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />Nuuko reero bavandimwe nzi yuuko mwe n'abayobozi baanyu mwari mutaazi ico mwakoraga. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Nyamara Imaana yuujuje ibyavuzwe n'abahanuuzi keera, yuuko Mesiya azaababazwa. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Nuuko reero mwihane kandi mugarukire Imaana kugira ngo ibyaha byanyu bihanagurwe, <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />bityo reero hazaabaho ibihe by'ububyuke mu mitima yaanyu mubihaawe na Nyagasani. Kandi igihe kimwe azaabooherereza Mesiya ari we Yesu. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />Uwo akwiriye kuguma mu ijuru kugeza igihe Imaana izaagarura busha ibintu byose, ibyo Yavuze Inyuze mu bahanuuzi baayo beera bo mu bihe bya keera. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Kuko Moose yavuze ati, ‘Nyagasani Imaana yaanyu izaabatumamo umuhanuuzi uturutse muri beene waanyu<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">Cangwa </char><char style="fqa" closed="false">Beene daata </char></note> umeze nkanje. Muzamwumvire mu byo azaababwira gukora byose. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />Kandi umuntu weese utazumvira uwo muhanuuzi azaarimburwa, aciibwe mu muryango w'Imaana.’ <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />Kandi n'abahanuuzi boose uheereye kuri Samweli ukageza kubaamukurikiye, na bo baahanuuye ibiri kubaho muri iyi minsi. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Namwe mukomooka ku bahanuuzi kandi muri abaragwa b'ibyo Imaana yaseezeranyije ba seekuruza baanyu, ibwira Aburahamu iti, ‘Mu rubyaro rwawe ni mwo imiryango yoose yo mu isi izaaheerwa umugisha.’ <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Igihe Imaana yoohereje Umugaragu waayo ni mwe yamwoherejeho bwa mbere kugira ngo abahe umugisha abahindure muve mu byaha byanyu.”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s1">Peetero na Yohaana Baregwa mu Rukiiko</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Peetero na Yohaana bakivugana n'abantu, abaheerezabitambo, n'umutegeka w'abarinzi b'Inzu y'Imaana, n'Abasadukaayo baaza aho bari. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />Abo bantu baari buuzuye uburakari bababajwe n'uko Peetero na Yohaana biigiishaga abantu ko Yesu yazuutse bihamya ko abaapfuuye na bo bazaazuuka. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Nuuko barabafata babashira mu gihome, ariko kuko bwari bugoroobye baraaramo kugeza mu gitondo. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Ariko abantu benshi mu bumviise ijambo ry'Imaana bariizeera. Umubare w'abiizeera uragwira ugera nko ku bantu ibihumbi bitaanu.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />Bukeeye bwaho, abategeetsi b'Abayuuda, bakuru b'imiryango n'Abiigiishamategeko bateeranira i Yerusaalemu. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />Haariho Anaasi Umuheerezabitambo mukuru, Kayafa, Yohaana<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Ibindi byanditswe bya kare bivuga </char><char style="fqa" closed="false">Yonataani </char></note> n'Alekizanda, n'abo mu muryango w'Umuheerezabitambo mukuru boose. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Bamaze guhagarika Peetero na Yohaana hagati yaabo barababaza bati, “Mwakoresheje mbaraga ki, cangwa iriihe zina ubwo mwakiizaga uyu mugabo?”<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />Maze Peetero yuuzuye Umwuka Weera arabasubiza ati, “Bategetsi b'Abayuuda namwe bakuru b'imiryango, <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />niiba uyu munsi turikubazwa ibyiza twagiriye umurema n'uburyo yakize, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />reka mwese mubimenye, n'ab'umuryango w'Isirayeli ko uyu mugabo uhagaze imbere yaanyu ari mutaraga, ku bw'imbaraga ziri mu izina rya Yesu Kristo w'i Nazaareeti uwo mwabambye, Imaana ikamuzuura mu bapfuuye. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />Uyu Yesu ni we</para>
  <para style="q1" vid="ACT 4:11">‘buye ryanzwe namwe abuubatsi</para>
  <para style="q2" vid="ACT 4:11">ni ryo ryahindutse iry'urufatiro.’<verse eid="ACT 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12" />Nta wundi twaboneramo agakiza ukuyeho we, kuko nta rindi zina ryahaawe abantu muusi y'ijuru dukwiriye gukirizwamo.”<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />Abagize urukiiko baboonye ukuntu Peetero na Yohaana bavuga bashize amanga, kandi biibuka ko ari abantu batiize, ahuubwo ko ari abatuurage basanzwe, barumirwa. Bageze aho biibuka ko baabaanaga na Yesu. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Kandi baboonye uwo muntu wari umurema wakize ahagararanye na bo, babura ico babasubiza babahakanya. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Nuuko abagize urukiiko bategeka Peetero na Yohaana kuva mu rukiiko kugira ngo basigare baja inaama bonyine. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />Batangira kubazanya bati, “Aba bantu tubagenze dute? Baakoze igitangaaza kandi caamenyekanye hoose mu batuuye i Yerusaalemu kandi naatwe nti twabihakana. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Ariko kugira ngo bidakomeza kwamamara, tubiiyame, batazongera kuvugana n'umuntu weese baakoresheje iryo zina.”<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />Nuuko barabahamagara, babategeka kutazongera kuvuga cangwa kwigiisha mu izina rya Yesu. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Ariko Peetero na Yohaana barabasubiza bati, “Namwe ubwanyu ni muhitemo icaaba ciiza imbere y'Imaana, kubumvira cangwa kumvira Imaana. <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Kuko tutaashobora guceceka ngo twekuvuga ibyo twiboneye kandi tukabyiyumvira.” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />Bamaze kongera kubatiinyatinyiisha barabarekura, basanze ko nta buryo baabahana kuko abantu boose bahimbaarizaga Imaana ibyabaaye. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />Uwo mugabo wakorewe igitangaaza co gukira yari afite imyaka irenze mirongo ine avuutse.<verse eid="ACT 4:22" /></para>
  <para style="s1">Abiizeera Basaba Imaana Gushira amanga</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Bamaze kubarekura basanga abiizeera bagenzi baabo, babateekerereza ibyo abatware b'abaheerezabitambo, n'abakuru b'imiryango baababwiye. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Abiizeera babyumvise, bavugira hamwe mu ijwi rirenga bahuuje umutima, basenga Imaana bati, “Nyagasani Maana, ni wowe waremye ijuru n'isi, inyanja n'ibiyirimo byose, <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />ni wowe kandi ku bw'Umwuka Weera wavugiye mu kanwa ka sogokuruza Dawudi, umugaragu waawe uti,</para>
  <para style="q1" vid="ACT 4:25">‘Ni iki gitumye abanyamahanga bagira uburaakari bwinshi,</para>
  <para style="q2" vid="ACT 4:25">n'abantu bakagira imigambi itagira umumaro?<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />Abaami bo mu isi bariiteguura</para>
  <para style="q2" vid="ACT 4:26">n'abatware barakorana, kugira ngo</para>
  <para style="q2" vid="ACT 4:26">barwanye Imaana na Kristo we.’<verse eid="ACT 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:27 a </char>
      <char style="xt" closed="false">
        <ref loc="LUK 23:7-11">Luk 23:7-11</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:1">Mat 27:1</ref>,<ref loc="MAT 27:2">2</ref>; <ref loc="MRK 15:1">Mar 15:1</ref>; <ref loc="LUK 23:1">Luk 23:1</ref>; <ref loc="JHN 18:28">Yoh 18:28</ref>,<ref loc="JHN 18:29">29</ref>.</char>
    </note>Kuko, Herodi na Pontiyo Pilaato, n'Abanyamahanga, n'imiryango yoose ya Isirayeli bateeraniye mur'iyi tawuni nkuru, kugira ngo barwanye Yesu umugaragu waawe Weera, wo wasiize amavuta, <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />kugira ngo basohoze ibyo ukuboko kwawe n'ubwenge bwawe byategetse mbere byose bitari byaba. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Noone ubu Nyagasani, reeba uko badutinyatinyisha, maze uduhereze twe abagaragu bawe, tuvuge ijambo ryawe dushize amanga. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Garagaza imbaraga zaawe maze abantu bakire indwara, reka ibitangaaza n'ibimenyeetso bikorwe mu izina rya Yesu umugaragu waawe Weera.”<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />Nuuko barangije gusenga, umwanya baari bateeraniyemo uhinda umushitsi, boose buuzura Umwuka Weera, maze abashoboza kuvuga ijambo ry'Imaana bashize amanga.<verse eid="ACT 4:31" /></para>
  <para style="s1">Abiizeera Basangira Ibyo Batunze</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:32 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 2:44">Iby 2:44</ref>,<ref loc="ACT 2:45">45</ref>.</char>
    </note>Agatsiko koose k'abiizeera bahuuzaga umutima n'inaama. Nta n'umwe wagiraga ikintu ce bwiite kuko baasangiraga ibyo bafite byose. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Intumwa zaagiraga imbaraga nyinshi zo guhamya kuzuuka k'Umwami Yesu, kandi ubuntu bw'Imaana bwakomezaga kuba kuri bo. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Nta mukene wababagamo, kuko abaari bafite imirima cangwa amazu boose baarabigurishaga ibiguzi bivuuyemo bakabiizana. <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />Baabishikirizaga intumwa, na zo zikabigabanya abantu, buri muntu weese agahaabwa ico akeneye.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />Haari umugabo w'Umuleevi wiitwaga Yozefu, umuvukano w'i Kupuro uwo intumwa ziise Barinaba rimenyeesha <char style="it">Ukomeza abandi.</char> <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />Yaguriishije umurima we maze ibiguzi bivuuyemo abiizanira intumwa.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">Ibya Ananiya na Safira</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Ariko umugabo wiitwaga Ananiya, amaze kumviikana n'umugore we Safira, aguriisha umurima. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />Yemeranyije n'umugore we, asigarana bimwe ku kiguzi yahaawe, ikindi gice akijaanira intumwa. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />Peetero aramubaza ati, “Ananiya, ni iki gitumye Sataani agushuka ukabeesha Umwuka Weera, ugasigaza igice c'ikiguzi waguriishije umurima? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Utari wawuguriisha nti wari uwaawe? Umaze no kuwuguriisha, ibyavuuyemo ntaabwo wari ubifiteho ububaasha? Ni iki caatumye wiigiira inaama yo gukora utyo? Ntaabwo ubeeshe abantu, ahuubwo ubeeshe Imaana!” <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />Ananiya akimara kumva ayo magambo yiituura haasi arapfa. Abaabyumviise boose bagira ubwoba bwinshi. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Nuuko abasore baraaza, bazinga umubiri we mu mwenda maze baja kumuhamba.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Hashize nk'amasaaha atatu umugore we yinjira, ataazi ibyabaayeho. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Peetero aramubaza ati, “Mbwira niiba wowe n'umugabo waawe ikiguzi mwaguriishije umurima ari co mwazanye.” Aramusubiza ati, “Yeego, ni co.”<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />Nuuko Peetero aramubwira ati, “Ni kuki mwemeranyije kugerageza Umwuka wa Nyagasani? Dore, abavuuye guhamba umugabo waawe bageze ku muryango, naawe barakujaana.” <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />Ako kaanya agwa imbere ye arapfa. Abasore basohoye basanga amaze gupfa, nuuko bamujaana hanze bamuhamba iruhande rw'umugabo we. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Nuuko itoorero ryose hamwe n'abaabyumviise boose bibateera ubwoba.<verse eid="ACT 5:11" /></para>
  <para style="s">Intumwa Zikiza Benshi</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Ibimenyeetso n'ibitangaza byinshi byakorwaga n'intumwa mu bantu. Boose baateraniraga ku baraza rya Solomooni. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Ariko n'ubwo abantu benshi babahimbazaga caane, nta n'umwe mu batizeera watiinyuukaga kwifatanya na bo. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Nyamara, abantu benshi caane abagabo n'abagore baguma kwiyongera ku basanzwe biizeera Nyagasani. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />Kubeera ko intumwa zaakoraga ibitangaaza byinshi, abantu baazanaga abarwayi mu nzira, bakabaryamiisha ku bitanda no ku birago kugira ngo Peetero naanyuraho niibura igicuucu ce kigere kuri bamwe. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Abantu nyamwinshi baakungaanaga bavuuye mu ma tawuni yizengurutse i Yerusaalemu, baazanye abarwayi n'abateewe n'abadayimooni, kandi boose bagakira.<verse eid="ACT 5:16" /></para>
  <para style="s">Intumwa Zitootezwa</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />Nuuko Umuheerezabitambo mukuru naabo yari kumwe na bo boose ari bo igice c'Abasadukaayo, buuzura ishari, <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />maze bafata intumwa bazishira mu gihome rusange. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Ariko nijoro malayika wa Nyagasani akiingura inzuugi z'igihome, abakuuramo arababwira ati, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“Ni mugende, muhagarare mu Nzu y'Imaana mubwire abantu ubutumwa bw'ubu bugingo busha”. <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />Intumwa zimaze kubyumva, zinjira mu Nzu y'Imaana mu gitondo kare kare zikomeza kwigiisha. Umuheerezabitambo mukuru naabo yari kumwe na bo bahageze, bakungaanya urukiiko, hamwe n'abakuru b'imiryango ya Isirayeli, ni ko gutuma ngo bavaane intumwa mu gihome bazibaazanire. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Ariko abarinzi b'Inzu y'Imaana bagiiyeyo, ntibaabasanga mu gihome nuuko baragaruka babwira abaabatumye bati, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />“Twasanze igihome gikinzwe neeza ndetse n'abarinzi bahagaze ku miryango, ariko dukinguuye ntitwagira uwo dusangamo.” <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Umutegeka w'abarinzi b'Inzu y'Imaana n'umutware w'abaheerezabitambo bumviise ayo magambo, baruumirwa, biibaza icaabaayeho. <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />Nuuko haaza umuntu arababwira ati, “Dore, ba bagabo mwashize mu gihome bahagaze mu Nzu y'Imaana bari kwigiisha abantu!” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />Umutegeka w'abarinzi ajaana n'umurinzi w'Inzu y'Imaana baazana intumwa, ariko ku neeza, kuko baatiinyaga abantu ngo baabateera amabuye.<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />Bamaze kubaazana babahagarika imbere y'urukiiko. Umuheerezabitambo mukuru arababaza ati, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" /><note caller="-" style="x"><char style="xo" closed="false">5:28 </char><char style="xt" closed="false"><ref loc="MAT 27:25">Mat 27:25</ref>.</char></note>“Twabategetse kutiigiisha muri iri zina rya Yesu, noone mukwije i Yerusaalemu inyigiisho zaanyu mumaramaje ko tubarwaho amaraso y'uyu muntu.”<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />Peetero n'izindi ntumwa barasubiza bati, “Tugomba kumvira Imaana kuruta kumvira abantu. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Imaana ya baasogokuruza yazuuye Yesu, uwo mwari mwariishe mumubambye ku giti. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Imaana yaramuzaamuuye imushira iburyo bwayo ngo abe Umuyobozi n'Umukiza kugira ngo aheeshe Abiisirayeli kwihana no kubabarirwa ibyaha. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Turi abahamya b'ibyo, hamwe n'Umwuka Weera uwo Imaana yahaaye abamwumvira.”<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />Babyumvise, bagira umujinya mwinshi bashaaka kubiica. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Ariko mu rukiiko, umufarisaayo wiitwaga Gamaliyeli, umwiigiishamategeko, wubahwaga n'abantu boose, arahaguruka ategeka ko abo bagabo booherezwa hanze kumara akaanya gato. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Nuuko arababwira ati, “Beene waacu b'Abiisirayeli, mwitonde mumenye ibyo mugiiye gukorera bariiya bantu. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Mu minsi yashize Tewudaasi yarahagurutse, yiiyita umuntu ukomeye, abantu bangana nka magana ane baramuyoboka. Ariko yariishwe kandi abaamuyobotse boose barataataana barabura. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Nyuma ye, mu minsi y'ibaruura, haaduka Umunyagalileeya wiitwaga Yuda maze abantu benshi baramukurikira, ariko na we yariishwe, abayoboke be barataataana. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />Noone, muri ibi biriho, inaama naabagiira ni uko mutagira ico mukora aba bagabo, mubiihorere. Niiba imigambi yaabo cangwa ibikorwa byabo bikomooka ku bantu ntaabwo bizaashoboka. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />Ariko niiba bikomooka ku Maana, ntaabwo muzashobora kubatsinda. Mushobora kwisanga muri kurwanya Imaana!” Abagize Urukiiko beemera ibyo ababwiye.<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />Bahamagara intumwa barazikubita, bazitegeka kutongera kwigiisha mu izina rya Yesu maze barazireka ziragenda. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />Intumwa ziva mu rukiiko zineejeejwe n'uko zaagize amahiirwe yo kugirirwa naabi zihoorwa izina rya Yesu.<verse eid="ACT 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 5:42" />Kandi ntizaasiiba kwigiisha no kuvuga ubutumwa ko Yesu ari Kristo iminsi yoose mu Nzu y'Imaana no mu mago.<note caller="+" style="f"><char style="fr" closed="false">5:42 </char><char style="ft" closed="false">Inzu ku yindi</char></note><verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">Abafasha b'Intumwa Barindwi Batooranywa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Muri ico gihe ubwo umubare w'abiigiishwa wakomeje kwiyongera, Abayuuda bavuga Urugiriki batangira kwitootombera Abaheburaayo kuko batiitaga ku bapfakazi baabo mu gihe baagabaga ibyo kwifashisha bya buri munsi. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Nuuko ba cumi na babiri bakungaanya umutwe w'abiigiishwa barababwira bati, “Ntibikwiriye ko tureka kwigiisha ijambo ry'Imaana ngo duhugire mu gukemura ibibazo byo kugaba ibintu. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Noone reero bavandimwe, nimwishaakemo abagabo barindwi b'inyangamugayo, buzuuye Umwuka Weera kandi b'abanyabwenge, tubashinge uwo murimo. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />Naho twebwe dukomeze kwibanda ku gusenga no kuvuga ijambo ry'Imaana.”<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />Ico giteekerezo kineezeeza abantu boose, nuuko batooranya Sitefaano, umugabo wuuzuye Umwuka Weera no kwizeera, kandi hamwe na Filipo, Purokooro, Nikanoora, Parumena, Timoona, na Nikolayoni umunyamahanga wo muri Antiyokiya wagiiye mu diini y'Abayuuda. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Bahagarika abo bagabo imbere y'intumwa, maze zibarambikaho ibiganza zirabasengera.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />Nuuko ijambo ry'Imaana rikomeza kwamamara. Umubare w'abiigiishwa ukomeza kwiyongera caane i Yerusaalemu, kandi n'abaheerezabitambo benshi bayoboka uko kwizeera.<verse eid="ACT 6:7" /></para>
  <para style="s">Sitefaano Afatwa</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Sitefaano, umugabo wuuzuye ubuntu n'imbaraga, yakoraga ibitangaaza n'ibimenyeetso bikomeye mu bantu. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Ariko abantu bamwe bo mu Sinagoogi yitwaga Ababohoowe, Abanyakureene, Abanyalekizanduriya, hamwe n'abandi bava Silisiya na Asiya barahaguruka baja impaka na Sitefaano. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Ariko ntibaashobora guhangana n'ubwenge bwe n'uko Umwuka Weera wamushobozaga kuvuga. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />Baguririra abantu rwihishwa kuvuga bati, “Twumviise avuga amagambo yo gutuka Moose n'Imaana.” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />Bateera agasasamaro mu bantu, hamwe no muri bakuru b'imiryango hamwe n'Abiigiishamategeko maze bamugwa gituumo, baramufata bamujaana mu rukiiko. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Bashiraho abagabo bo kumushinja ibinyoma barahamya bati, “Uyu mugabo ntaahwema gutuka Inzu y'Imaana Yeera n'amategeko ya Moose, <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />kuko twamwumviise avuga ko, Yesu w'i Nazaareeti azaasenya iyi Nzu y'Imaana kandi agahindura imigenzo twahaawe na Moose.” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />Nuuko boose baari biicaye mu rukiiko batumbiira Sitefaano, babona mu maaso he hasa n'aha malayika.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">Sitefaano Yireguura</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Maze umuhereezabitambo mukuru abaza Sitefaano ati, “Ibyo bakuvugaho ni ukuri?”<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />Sitefaano aramusubiza ati, “Beene daata kandi babyeyi, ni munyumve, Imaana Nyir'icuubahiro yabonekeye sogokuruza Aburahamu ari i Mesopotamiya, ataraatuura i Haraani, <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />Iramubwira iti, ‘Va mu gihugu caawe, usige abavandimwe baawe uje mu gihugu nzaakwereka.’ <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />Nuuko Aburahamu ava mu gihugu c'Abakalidayo aja gutuura i Haraani. Nyuma se amaze gupfa, Imaana imuvaanayo imuuzana mur'iki gihugu mutuuyemo ubu. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />Imaana ntaabwo yiigeze imuhaho umugabane, haabe n'akangana ubusa, ahuubwo yamuseezeranyije kumuha iki gihugu ngo abe nyiraco n'abamukomookaho, nuubwo yari adafite umwana. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Imaana ivuga muri aya magambo ngo abazaamukomookaho bazaaba abasuhuuke mu gihugu c'abandi, bazaabahindura abareetwa babagirire naabi kumara imyaka magana ane. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Imaana iravuga iti, ‘Ariko nzaahana igihugu bazaakoreramo ubureetwa, haanyuma bazaakivamo maze bansengere aha hantu.’ <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Maze imuha iseezerano ryo gukebwa. Nuuko Aburahamu abyara Isaaka amukeba ku munsi wa munaane, Isaaka abyara Yaakobo, na Yaakobo abyara basogokuruza bakuru cumi na babiri.<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />Ba sogokuruza bagirira Yozefu ishari nuuko bamugurisha mu Igiputi, ariko Imaana ibaana na we, <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />Imaana imukiza amakuba yoose, Imuha gukundwa hamwe n'ubwenge imbere ya Faraawo umwami wa Igiputi, maze Faraawo amugira umutegetsi wa Igiputi n'uw'urugo rwe rwose. <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />Haanyuma inzara iteera mu Igiputi n'i Kanaani hoose, haba umubabaro mwinshi, nuuko ba sogokuruza babura ibyokurya. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Ariko Yaakobo yumviise ko hari ibyokurya mu Igiputi, yooherezayo baasogokuruza inshuro ya mbere. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Bagiiyeyo ubwa kabiri, Yozefu yiyanzurira beene se kandi n'umuryango wa Yozefu umenywa na Faraawo. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Nuuko Yozefu atumaho se Yaakobo n'umuryango we woose, boose hamwe baari abantu mirongo irindwi na bataanu. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Yaakobo aragenda aja mu Igiputi, maze we na ba sogokuruza bapfiirayo. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />Imibiri yaabo bayigarura i Shekemu ihambwa mu mva Aburahamu yari yaraguze ku giciiro c'ifeeza na beene Hamori w'i Shekemu.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />Igihe ceegereje kugira ngo iseezerano Imaana yakoreye Aburahamu risohore, umuryango waacu uriyongeera maze ugwira muri Igiputi <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />kugeza aho undi mwami wari utaazi Yozefu yimye ingoma. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />Uwo mwami agira uburiganya bwo kurimbura agirira naabi ubwoko bwacu ahata ba sogokuruza guta abaana baabo b'impinja kugira ngo bapfe. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />Muri ico gihe Moose aravuuka, yari mwiza caane imbere y'Imaana. Arererwa mu rugo rwa se ameezi atatu, <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />amaze gutaabwa, umukoobwa wa Faraawo aramuraruuza maze amurera nk'umwana we bwiite. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />Moose yigiishwa mu buhanga bwose bw'Abiigiputi, aba umuntu ukomeye mu byo avuga no mu byo akora.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />Moose amaze imyaka mirongo ine y'ubukuru ahitamo kuja gusuura abavandimwe be ari bo Biisirayeli<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">Beene se cangwa abahungu aba Isirayeli </char></note>. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Aboonye umwe muri bo agirirwa naabi n'Umwigiputi, aramurengera, aramuhoorera, yiica uwo mwigiputi. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />Moose yiibwiraga ko beene waabo bamenyeraho ko ari we Imaana yatumye kubakiza, ariko bo ntibaabisobaanukirwa. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />Umunsi ukurikiraho asanga Abiisirayeli babiri bari kurwana, agerageza kubakiraanura ababwira ati, ‘Yemwe bagabo, ko muri abavandimwe, kuki mugirirana naabi?’ <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />Ariko uwarenganyaga mugenzi we asunika Moose iruhande aramubwiira ati, ‘Ni nde wakugize umutegetsi cangwa umucaamanza waacu ? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />Mbese ushaaka kunyica nk'uko ejo wishe wa Mwigiputi?’ <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Moose yumviise ayo magambo, arahunga aja gutuura mu gihugu c'Abamidiyaani nk'umusuhuuke. Ahabyarira abahungu babiri.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />Imyaka mirongo ine ishize, malayika amubonekera mu gihuru<note caller="+" style="f"><char style="fr" closed="false">7:30 </char><char style="ft" closed="false">Igihuru n'ahantu hari igishamba </char></note> caaka umuriro mu butaayu bwo ku musozi wa Sinaayi. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Moose aboonye uwo muriro biramutangaaza, araheegeera ngo yiitegereze nuuko yumva ijwi rya Nyagasani rivuga riti, <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />‘Ndi Imaana ya ba sogokuruza, Imaana ya Aburahamu, ya Isaaka, na Yaakobo.’ Moose ahinda umushitsi ntiyatinyuuka kuhareeba. <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />Nuuko Uhoraho aramubwira ati, ‘Kuuramo ingato kuko aho uhagaze ari aheera. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />Naboonye gutootezwa kw'abantu banje bari mu Igiputi, kandi numvise gutaka kwabo, namanuwe no kubatabaara. Nuuko reero ngwino ngutume mu Igiputi.’<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />Uwo ni we Moose wa wundi banze kumvira bati, ‘Ni nde wakugize umutegetsi cangwa umucaamanza waacu ?’ Kandi ni we Imaana yatumye kuba umutegetsi n'umutabaazi inyuze muri malayika wamubonekeye mu gihuru. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />Moose ni we wabakuuye mu Igiputi amaze gukora ibitangaaza n'ibimenyeetso muri ico gihugu, ku Nyanja Itukura, kandi no mu butaayu kumara imyaka mirongo ine. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />Uwo ni we Moose wabwiye Abiisirayeli ati, ‘Imaana izaabahagurukiriza umuhanuuzi ukomooka muri beene waanyu umeze nkanje.’ <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Moose uwo ni we wari uri mu iteeraniro mu butaayu hamwe na malayika wavuganiye na we ku musozi wa Sinaayi, hamwe na ba sogokuruza, kandi akaakiira amagambo y'ubugingo yo kuduha.<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />Ariko ba sogokuruza banze kumwumvira, ahuubwo baramuhigika ndetse biifuuza kwisubirira mu Igiputi, <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />babwira Arooni bati, ‘Turemere imaana zo kutuyobora, kuko Moose wa dukuuye mu Igiputi ntituuzi icaamubaayeho.’ <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />Nuuko ico gihe barema igishushanyo c'ikimasa, bagitambira igitambo, maze biishiimira imirimo y'intoki zaabo. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Nuuko Imaana irabazibukiira irabareka ngo basenge inyenyeeri zo mu kireere nk'uko byanditswe mu gitabo c'abahanuuzi ngo,</para>
  <para style="q1" vid="ACT 7:42">‘Yeewe muryango w'Isirayeli,</para>
  <para style="q2" vid="ACT 7:42">mbese mwigeze ku ntuura ibitambo n'amatungo abaazwe</para>
  <para style="q2" vid="ACT 7:42">imyaka mirongo ine mwamaze mu butaayu?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />Oya! Mwagendanye ihema ry'ikigirwamaana Moleki,</para>
  <para style="q2" vid="ACT 7:43">n'inyenyeeri y'ikigirwamaana Refani,</para>
  <para style="q2" vid="ACT 7:43">ibishushaanyo mwaremeye gusenga.</para>
  <para style="q1" vid="ACT 7:43">Nooneho nanje nzaabiimurira hiirya ya Babuloni.’<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />Ba sogokuruza baari bafite ihema rigaragaza ko Imaana iri na bo mu butaayu, nk'uko yategetse ubwo yavuganye na Moose. Imutegeka kurishinga akurikije uburyo Imaana yari yamweretse. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Haanyuma ba sogokuruza baheerereekanya iryo hema kugeza igihe ca Yosuwa aba ari we ubayobora baaza gufata iki gihugu Imaana imaze kuciirukanamo abanyamahanga. Iryo hema riguma aho kugeza mu gihe ca Dawudi, <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />wari utonnye imbere y'Imaana maze agasaba kuubaka Inzu y'Imaana ya Yaakobo. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Ariko Solomooni ni we wuubatse Inzu y'Imaana. <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />Nyamara Isumbabyose ntiiba mu mazu yuubatswe n'amaboko y'abantu nk'uko umuhanuuzi yavuze ati,<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />‘Ijuru n'intebe yanje y'ubwami,</para>
  <para style="q2" vid="ACT 7:49">kandi isi ni akabaaho nkandagizaho ibirenge byanje.</para>
  <para style="q1" vid="ACT 7:49">Muzanyubakira nzu ki, ni ko Uhoraho avuga,</para>
  <para style="q2" vid="ACT 7:49">cangwa se aho nzaaruhuukira, hazaaba hameze hate?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />Intoki zanje si zo zaaremye ibyo byose?’<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />Yemwe bantu b'ibyigenge kandi biinangiye mu mitima bakagira n'amatwi atumva, iteeka muhakanya Umwuka Weera, uko ba sookuruza baakoraga. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Ni nde mu bahanuuzi ba sookuruza baanyu bataarenganyije? Biishe abaavuze ibyo kuuza kw'iyo Ntungane bitaraaba, noone namwe mubaaye abo kumugambaanira no ku mwica. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />Kandi mwahaawe amategeko y'Imaana n'abaamalayika ariko ntimwayumvira.”<verse eid="ACT 7:53" /></para>
  <para style="s">Sitefaano bamwiciisha amabuye</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Abaari aho bumviise ibyo Sitefaano avuze, buuzura uburakari, bamuhekenyera ameenyo. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />Naho Sitefaano yuuzuye Umwuka Weera, atuumbiira mu ijuru abona ubwiza bw'Imaana na Yesu ahagaze i buryo bwayo. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />Aravuga ati, “Dore, mboonye ijuru rikinguutse, n'Umwana w'Umuntu ahagaze iburyo bw'Imaana!”<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />Ariko bapfuka amatwi yaabo maze barasakuza caane, biirukira aho ari bamugwira icaarimwe. <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />Nuuko baramukurubana bamuvaana mu tawuni batangira kumuteera amabuye. Abaamushinjaga basigira imyiteero yaabo umusore wiitwaga Sawuli. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />Bakimuteera amabuye, Sitefaano arasenga ati, “Mwami Yesu, akiira umwuka wanje.” <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />Nuuko arapfukama avuga n'ijwi rirenga ati, “Nyagasani, ntuubabareho iki caaha.” Akimara kuvuga atyo arapfa. <note caller="+" style="f"><char style="fr" closed="false">7:60 </char><char style="ft" closed="false">Arasinziira</char></note><verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Sawuli na we ashigikira kwicwa kwa Siteefaano</para>
  <para style="s" vid="ACT 8:1">Sawuli Atooteza Itoorero</para>
  <para style="p" vid="ACT 8:1">Uwo munsi Itoorero ry'i Yerusaalemu ritangira gutootezwa bikomeye, maze abiizeera Kristo boose, ukuuyeho intumwa, bataataanira mu bice by'i Yudeeya n'i Samariya.<verse eid="ACT 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 8:2" />Abantu buubahaga Imaana bahamba Siteefaano kandi baramuririra caane.<verse eid="ACT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:3 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 22:4">Iby 22:4</ref>,<ref loc="ACT 22:5">5</ref>; <ref loc="ACT 26:9-11">26:9-11</ref>.</char>
    </note>Naho Sawuli we aguma gutooteeza Itoorero ava mu rugo aja mu rundi, agakurubana abagore n'abagabo akabashira mu gihome.<verse eid="ACT 8:3" /></para>
  <para style="s">Filipo Abwiriza i Samariya</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Abiizeera baari baataataanye bava mu mwanya baja mu wundi baamamaza ijambo ry'Imaana. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Filipo aramanuka aja mu tawuni nkuru y'i Samariya maze yigiisha abaaho ibya Kristo. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Abantu nyamwinshi bumvirizaga ibyo Filipo avuga bahuuje umutima, bumva kandi bareeba ibitangaaza yakoraga. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Imyuka mibi yavaga mu bantu benshi isakuza caane, kandi abaari bamugaye n'abaari baremaye barakira. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Nuuko abantu bo mu tawuni y'i Samariya bagira umuneezeero mwinshi.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Haariho umugabo wiitwaga Simooni wahoze ari umupfumu muri iyo tawuni. Yatangaazaga abantu bo muri Samariya, avuga ko ari umuntu ukomeye caane. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />Abantu boose, kuva kubooroheje kugera ku bakomeye baaramwumvaga bakavuga bati, “Uyu muntu arimo ububaasha bw'Imaana bwitwa Ubuhangaage.” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />Baakomeje kugira umwete wo kwita ku bye kuko uheereye keera baatangaazwaga n'ubwo bupfumu bwe. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Ariko abagabo n'abagore bamaze kwizeera Ubutumwa Bwiza bw'Ubwami bw'Imaana n'izina rya Yesu Kristo babwirizwaga na Filipo, barabatizwa. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Na Simooni ubwe areemera. Amaze kubatizwa, aguma kubaana na Filipo atangazwa n'ibimenyeetso n'ibitangaaza bikomeye yakoraga.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />Intumwa zaari i Yerusaalemu zumviise ko ab'i Samariya baakiriye ijambo ry'Imaana, zibooheerereza Peetero na Yohaana. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />Abo babiri bagezeyo basengera abiizeera kugira ngo bahaabwe Umwuka Weera. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />[Kuko ari nta n'umwe muri bo wo Umwuka Weera yari yakamanukiyeho, ahuubwo baari babatijwe mu izina ry'Umwami Yesu gusa]. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Nuuko Peetero na Yohaana babarambikaho ibiganza maze bahaabwa Umwuka Weera.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />Simooni aboonye yuuko abo intumwa zirambitseho ibiganza bahaawe Umwuka Weera, aziizanira ishilingi, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />arazibwira ati, “Nanje mumpe izo mbaraga kugira ngo uwo nzaarambikaho ibiganza ahaabwe Umwuka Weera.”<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />Peetero aramubwira ati, “Urakarimbuka n'ishilingi zaawe, kuko uteekereza yuuko waagura impaano y'Imaana ukoresheje ishilingi! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Ntaamugabane, ntaan'umurage ufite muri ibi, kuko umutima waawe udatungaaniye Imaana. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Wihane ubwo bugome bwawe, usabe Nyagasani kugira ngo niiba bishoboka, akubabarire uwo mugambi uri mu mutima waawe. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Kuko ndikureeba wuzuuye ishari ry'ikirenga kandi uhambiiriwe n'ibyaha.”<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />Simooni aramusubiza ati, “Munsabire kuri Nyagasani kugira ngo hatagira ikimbaho mu byo mumaze kuvuga.”<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />Nuuko Peetero na Yohaana bamaze guhamya no kubwiriza abantu ijambo rya Nyagasani, basubira i Yerusaalemu, babwiriza Ubutumwa Bwiza mu bice byinshi by'i Samariya.<verse eid="ACT 8:25" /></para>
  <para style="s">Filipo hamwe n'Inkone ya Etiyopiya</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />Nuuko Malayika wa Nyagasani abwira Filipo ati, “Haguruka ugende weerekeze mu majeepfo, ufate inzira imanuka iva i Yerusaalemu ija i Gaaza.” [Iyi n'inzira yo mu butaayu.] <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Nuuko arahaguruka, aragenda. Haariho umunyetiyopiya w'inkone wari umutware mu bwami bwa Kandake, umwamikazi wa Etiyopiya, kandi akaba ari na we wareebereraga umutungo w'umwamikazi. Yari yaaje i Yerusaalemu kuramya Imaana. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />Kandi yari ari gusubira mu rugo, yiicaye mu gaare rye ari gusoma igitabo c'umuhanuuzi Yesaaya. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />Nuuko Umwuka abwira Filipo ati, “Genda weegeere ririiya gaare maze ujaane na ryo.” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />Filipo ariiruka maze yumva wa mugabo ari gusoma igitabo c'umuhanuuzi Yesaaya. Aramubaza ati, “Mbese ibyo usoma uri kubisobaanukirwa?”<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />Uwo mutware aramusubiza ati, “Naabisobaanukirwa nte ntaboonye unsobaanurira?” Nuuko asaba Filipo ngo yinjire maze biicarane. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />Ibyo yasomaga mu byanditswe byera byari ibi;</para>
  <para style="q1" vid="ACT 8:32">“Yajanywe nk'intaama igiiye kubaagwa,</para>
  <para style="q2" vid="ACT 8:32">kandi nk'uko umwana w'intaama ucecekera imbere y'uwukemura ubwoya</para>
  <para style="q2" vid="ACT 8:32">Na we ntiyaruhije abumbuura akanwa.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />Yarashinyaguriwe aciirwa urubanza rw'akarengane.</para>
  <para style="q2" vid="ACT 8:33">Ni nde uzaasobaanura abamukomookaho?</para>
  <para style="q2" vid="ACT 8:33">Kuko ubugingo bwe bukuuwe mu isi.”<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />Iyo nkone ibaza Filipo iti, “Mbwira, ayo magambo umuhanuuzi yayavuze kuri nde? Yayiivuzeho cangwa yayavuze ku wundi muntu?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Filipo atangira kuvuga aheereye kuri ibyo byanditswe, amubwiriza Ubutumwa Bwiza bwa Yesu.<figure style="fig" alt="Philip entered the Chariot and started preaching to the eunuch" file="LB00331B.TIF" size="col" copy="HK-NEW" ref="8:35">Filipo yinjira mu kigaare atangira kubwiriza inkone</figure> <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />Bakigenda, bagera ku maazi, nuuko iyo nkone iravuga iti, “Dore hano hari amaazi! Ikimbuza kubatizwa ni iki?”<verse eid="ACT 8:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 8:37" />Filipo aravuga ati, “Niiba wiizeeye n'umutima waawe woose birashoboka.” Na ya nkone iti, “Niizeeye yuuko Yesu Kristo ari Umwana w'Imaana<note caller="+" style="f"><char style="fr" closed="false">8:37 </char><char style="ft" closed="false">Bimwe mu byanditswe byera nti bifite uyu murongo</char></note>”<verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />Iyo nkone itegeka ko igaare rihagarikwa, maze yo na Filipo baramanuka baja mu maazi, nuuko Filipo arayibatiza. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Bavuuye mu maazi, Umwuka wa Nyagasani ajaana Filipo, iyo nkone ntiyongera kumubona, maze ikomeza urugendo ineezeerewe. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Ariko Filipo yisanga ahiitwa Azoto, agenda abwira abantu Ubutumwa Bwiza muri ico gice coose kugeza aho yagereye i Kayisaariya.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">Yesu Abonekera Sawuli</para>
  <para style="r">(<ref loc="ACT 22:6-16">Iby 22:6-16</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Sawuli we, akomeza gukangiisha n'imbaraga kwica abiizeera ba Nyagasani. Nuuko asanga Umuheerezabitambo mukuru <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />maze amusaba inzandiko zo kumwanzura ku bakuru b'amasinagoogi b'i Damasiko, kugira ngo niharamuka hari umuntu aboonye ukurikira inzira ya Nyagasani, yaaba umugabo cangwa umugore, amubohe amuuzane i Yerusaalemu.<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />Akigenda ari haafi kugera i Damasiko, mu kamwanya, umuco uvuuye mu ijuru uramugota. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />Agwa haasi maze yumva ijwi rivuga riti, “Sawuli, Sawuli, kuki untooteza?”<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />Sawuli aramubaza ati, “Uri nde, Nyagasani?” Iryo jwi riramusubiza riti, “Ndi Yesu, uwo utooteza. <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />Ariko haguruka uje mu tawuni nkuru, urabwirwa ico ukwiriye gukora.”<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />Abagabo baari bafatanyije na we urugendo bahagarara badakoma, kuko bumvaga ijwi ariko ntibabone umuntu. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Sawuli arahaguruka, ariko n'ubwo yarambuuraga amaaso, nta co yashoboraga kureeba, nuuko baramurandata bamugeza i Damasiko. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Yamaze iminsi itatu atareeba, atarya kandi atanywa.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />I Damasiko haari umwigiisha wiitwaga Ananiya. Umwami Yesu amubonekera mu nzozi aramuhamagara ati, “Ananiya.” Na we arasubiza ati, “Karame, Mwami.”<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />Umwami Yesu aramubwira ati, “Haguruka uje mu muhare wiitwa ‘Ugororotse’, maze ushaakire mu nzu ya Yuda umuntu wiitwa Sawuli w'i Tarisiya. Ubu ari gusenga, <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />kandi amaze kubonekerwa areeba umuntu wiitwa Ananiya yinjira iwe, akamurambikaho ibiganza kugira ngo yongere kureeba.”<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />Ariko Ananiya aramusubiza ati, “Mwami, numvise benshi bavuga iby'uwo muntu, nuuko yagiriye naabi abantu baawe bari i Yerusaalemu. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />Kandi n'ino yaje afite ububaasha yahaawe n'abatware b'abaheerezabitambo, kugira ngo abohe abo boose basenga mu izina ryawe.”<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />Ariko Umwami Yesu abwira Ananiya ati, “Genda, kuko namutooranyije kwamamaza izina ryanje mu banyamahanga n'abaami no mu Biisirayeli. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />Nje ubwanje nzamwereka uko azaababazwa, ahoorwa izina ryanje.”<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />Ananiya aragenda maze yinjira muri ya nzu. Arambuura ibiganza bye kuri Sawuli nuuko aravuga ati, “Muvandimwe Sawuli, Umwami Yesu, wakubonekeye mu nzira uri kuuza ino, arantumye kugira ngo uhumuuke kandi wuuzure Umwuka Weera.” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Ako kaanya ibintu bisa nk'ibishishwa by'isamaaki bimuva mu maaso, aheera ko arareeba, arahaguruka maze arabatizwa. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Amaze kurya, yongera kugira imbaraga.</para>
  <para style="s" vid="ACT 9:19">Sawuli Avuga Ubutumwa i Damasiko</para>
  <para style="p" vid="ACT 9:19">Sawuli amarana n'abiizeera iminsi myinshi i Damasiko, <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />maze atangiriraho kwamamaza Yesu mu masinagoogi, avuga ati, “Ni Umwana w'Imaana.”<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />Abamwumvaga boose baaratangaaraga maze bakabazanya bati, “Uyu si we watootezaga abantu baahimbaazaga izina rya Yesu i Yerusaalemu? Kandi ntiyaaje ino kugira ngo ababohe maze abajaanire abatware b'abaheerezabitambo?”<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />Sawuli arushaho kugira imbaraga mu kuvuga ubutumwa kandi agatsinda impaka yajaga n'Abayuuda baari batuuye i Damasiko yeerekana ubuhamya ko Yesu ari Kristo.<verse eid="ACT 9:22" /></para>
  <para style="s">Sawuli Atoroka Abayuuda</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:23 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 11:32">2 Kor 11:32</ref>,<ref loc="2CO 11:33">33</ref>.</char>
    </note>Hashize igihe, Abayuuda baja imigambi yo kwica Sawuli, <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />ariko Sawuli aza kumenya ubugambanyi bwabo. Baarindaga amarembo y'itawuni amanywa na n'ijoro kugira ngo bamwice, <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />ariko abayoboke be bamujaana n'ijoro bamunyuza mu gipfumure c'uruzitiro rw'amabuye, bamwururukiriza mu giteebo. <figure style="fig" alt="Paul in a basket" file="CN01937b.TIF" size="col" loc="David Cook NT" copy="The British and Foreign Bible Societies" ref="9:25">Pawulo bamushira mu giteebo bamurenza mu dirisa.</figure><verse eid="ACT 9:25" /></para>
  <para style="s">Sawuli i Yerusaalemu</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Ageze i Yerusaalemu, agerageza kwifatanya n'abiigiishwa, ariko boose baramutinya. Ntaabwo beemeye neeza ko na we yabaaye umwigiishwa. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Nuuko Barinaba ajaana Sawuli, amugeza ku ntumwa, maze azisobaanurira uko yabonekewe na Nyagasani mu nzira akavugana na we. Ababwira n'uko Sawuli yiigiishije mu izina rya Kristo i Damasiko ashize amanga. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Nuuko Sawuli abaana na bo i Yerusaalemu agendagenda hoose, kandi yiigiisha mu izina ry'Umwami Yesu ashize amanga. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />Yabwirizaga kandi akaja impaka n'Abayuuda baavugaga urugiriki, ariko bo baja imigambi yo kumwica. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Abeemera<note caller="+" style="f"><char style="fr" closed="false">9:30 </char><char style="ft" closed="false">Abavandimwe</char></note> babimenye, bamujaana i Kayisaariya maze bamwohereza i Tarisiya.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />Nuuko itoorero muri Yudeeya yoose, muri Galileeya, no muri Samariya rigira amahoro kandi rirakomera. Rigumya kuubaha Nyagasani rifashijwe n'Umwuka Weera, maze riragwira.<verse eid="ACT 9:31" /></para>
  <para style="s">Peetero ari i Lida n'i Yopa</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Ubwo Peetero yagendagendaga mu biizeera boose, aza no kugera ku bantu b'Imaana batuuye i Lida. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Ahasanga umugabo wiitwaga Ayineya, akaba yari amaze imyaka umunaane atava aho ari kuko yari afite ubumuga. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Peetero aramubwira ati, “Ayineya, Yesu Kristo aragukijije, haguruka uzinge uburiri bwawe!” Ako kaanya arahaguruka. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Abatuurage benshi b'i Lida na Sharoni baramubona maze bayoboka Imaana.<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />I Yopa haari umwigiishwakazi wiitwaga Tabita, mu rugiriki ni Dorokaasi.<note caller="+" style="f"><char style="fr" closed="false">9:36 </char><char style="ft" closed="false">Izina Tabita riri mu rurimi rw'Ururamayika, kandi izina Dorokaasi mu Rugiriki rimenyeesha impongo </char></note> Yahoraga agira neeza kandi afasha abatiishoboye. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />Muri iyo minsi aza kurwara maze arapfa. Bamaze kuuhagira umurambo we, bawurambika mu gisenge co heejuru. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Kuko Lida na Yopa byari byegeeranye, kandi bamaze kumenya ko Peetero ariyo, bamutumaho abagabo babiri baramusaba bati, “Nyaabuna, ngwino iwaacu kandi ntutinde.” <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />Peetero arahaguruka, maze ajaana na bo. Ahageze, bamujaana mu gisenge co heejuru. Abapfaakazi boose baari bahagaze iruhande rwa Peetero barira, bamwereka ibiteeteeyi n'indi myenda Tabita yari yarabakoreye akiri kumwe na bo. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />Peetero aboohereza hanze boose, maze arapfukama arasenga. Niko guhindukira umurambo maze aravuga ati, “Tabita, haguruka.” Tabita arambuura amaaso, nuuko aboonye Peetero, areeguuka maze ariicara. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Peetero amufata ukuboko aramuhagurutsa. Niiko guhamagara abiizeera, barimo n'abapfaakazi, abeereka Tabita ari muzima. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />Ibi bimenyekana muri Yopa hoose, nuuko abantu benshi biizeera Nyagasani. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Peetero amara iminsi myinshi i Yopa, acumbitse kwa Simooni, umuhazi w'impu.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">Koruneliyo Atuma kuri Peetero</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />I Kayisaariya haari umugabo wiitwaga Koruneliyo, akaba yari umutware w'abasirikare ijana wiitwaga Italiyana. <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />Yari umugabo wuubaha kandi utinya Imaana, hamwe n'ab'urugo rwe boose. Yafashaga abantu kandi agahora asenga Imaana. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Umunsi umwe nko ku gihe c'isaaha icenda z'amanywa aza kubonekerwa. Abona malayika w'Imaana yinjira iwe, aramubwira ati, “Koruneliyo!”<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />Atumbiira uwo malayika n'ubwoba bwinshi maze aravuga ati, “Ni iki, Nyagasani?”</para>
  <para style="p" vid="ACT 10:4">Malayika aramusubiza ati, “Amasengeesho yaawe n'ubuntu ugira byageze ku Maana noone yakwibutse. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Noone reero ohereza abantu i Yopa utume kuri Simooni wiitwa Peetero. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />Acumbitse kwa Simooni w'umuhazi, urugo rwe ruri iruhande rw'inyanja.” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />Malayika wavuganaga na we amaze kugenda, ahamagara abagaragu be b'inkoramutima babiri hamwe n'umusirikare wuubaha Imaana wo mu baamukoreraga, <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />nuuko amaze kubabwira ibyo yeretswe byose, aboohereza i Yopa.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />Bakigenda bari haafi kugera muri iyo tawuni nk'igihe c'isaaha itandatu, Peetero aja heejuru y'inzu gusenga. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />Arasonza yumva ashaaka kurya, mu gihe bakimuteguurira ibyokurya, aratwarwa. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />Abona ijuru rikinguutse, maze ikintu gisa nk'umwenda munini kiramanuka, gifashwe ku nshonda zaaco enye, cuururuka kigana ku isi. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />Muri uwo mwenda haarimo inyamaaswa z'amooko yoose, izigendeesha amaguru ane, ibikururuka haasi n'inyoni zo mu kireere. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />Nuuko yumva ijwi rivuga riti, “Peetero, haguruka wice maze urye.”<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />Ariko Peetero arasubiza ati, “Oya Nyagasani, kuko ntaabwo nari naaryaho ikizira cangwa igihumaanya.”<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />Iryo jwi rirongera rimubwira ubwa kabiri riti, “Ico Imaana yeemeye ko kiriibwa, ntukaciite ikizira.” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Ibyo biba gatatu, maze ca kintu gisubizwa mu ijuru.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Peetero aciibaza ico ibyo yeeretswe bimenyeesha, ako kaanya ba bagabo booherejwe na Koluneriyo babe barahageze. Baayobozaga kwa Simooni kandi bahagaze ku irembo. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />Barahamagara kugira ngo bamenye ko Simooni, wiitwa Peetero, acumbitse muri urwo rugo.<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />Peetero agiteekereza ku byo yabonekewe, Umwuka aramubwira ati, “Dore abantu batatu<note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false">Bimwe mu byanditswe bandika, </char><char style="fqa">Babiri </char> kandi mu bindi, iri jambo ntaabwo ririmo. </note> baragushaaka. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Noone haguruka umanuke, ujaane na bo udashidiikanya, kuko ari nje ubatumye.” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />Peetero aramanuka asanga abo bagabo maze arababaza ati, “Ni nje mushaaka, muzanywe n'iki?”<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />Baramusubiza bati, “Koruneliyo, umutware w'abasirikare ijana, kandi umukiraanutsi wuubaha Imaana, ndetse akavugwa neeza mu Bayuuda boose, yabonekewe na malayika weera ngo agutumeho uze iwe mu rugo maze yumve ibyo umubwira.” <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Peetero abinjiza mu nzu arabacumbikira.</para>
  <para style="p" vid="ACT 10:23">Bukeeye, Peetero arahaguruka ajaana na bo, kandi bamwe mu biigiishwa, b'i Yopa baramuherekeza. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />Umunsi wakurikiyeho, bagera i Kayisaariya. Koruneliyo yari abategereje kandi yakoranyije beene waabo hamwe n'inshuti ze magara. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Peetero ahageze, Koruneliyo aramusanganira, yiikubita imbere ye, aramuramya. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Ariko Peetero aramuhagurutsa, aramubwira ati, “Haguruka, nanje ndi umuntu nkaawe.” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />Akivugana na Koruneliyo, arinjira asanga abantu benshi bahateeraniye, <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />arababwira ati, “Mwe ubwanyu muuzi neeza yuuko amategeko ateemera ko Umuyuuda yiifatanya cangwa ngo azindukire umunyamahanga, ariko nje Imaana yanyeretse ko ntaamuntu nkwiriye kwita ikizira cangwa igihumaanya. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Ni co caatumye muntumaho, nkaaza ntashidiikanya. Noone ndashaaka kubaza, mwantumiyeho iki?”<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />Koruneliyo aramusubiza ati, “Iminsi enye ishize nk'aya masaaha, isaaha cenda z'amanywa, nari ndi mu nzu yanje nsenga nuuko mu kamwanya imbere yanje habe hagaragaye umuntu wambaye imyenda irabagirana. <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />Aravuga ati, ‘Koruneliyo, amasengeesho yaawe yakiiriwe kandi n'ubuntu bwawe bwibutswe imbere y'Imaana. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Noone reero, ohereza abantu i Yopa maze utumeho Simooni, wiitwa Peetero, acumbitse kwa Simooni umuhazi, iruhande rw'inyanja.’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Mpeerako ngutumaho, kandi naawe ugize neeza kuba uje. Ubu twese duteeraniye hano imbere y'Imaana, kugira ngo twumve ibyo Nyagasani yagutegetse kuvuga.”<verse eid="ACT 10:33" /></para>
  <para style="s">Peetero Avuga Icaamuuzanye</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />Nuuko Peetero atangira kubabwira ati, “Ni ukuri menye yuuko Imaana itarobaanura, <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />ahuubwo mu mahanga yoose yeemera umuntu weese uyuubaha agakora ibiyitungaaniye. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Yoohereje ubutumwa ku bantu ba Isirayeli, kwamamaza Inkuru Nziiza y'amahoro baazaniwe na Yesu Kristo, ari we Mwami w'abantu boose. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />Ubwo butumwa bwamamaye muri Yudeeya, buheereye i Galileeya nyuma y'umubatizo Yohaana yabwirizaga. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />Imaana yasutse Umwuka Weera n'imbaraga kuri Yesu w'i Nazaareeti, akagenda akora ibyiza, agakiza boose baakandamijwe na Sataani kuko Imaana yari kumwe na we. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />Turi abahamya b'ibyo yakoze byose muri Yudeeya no muri Yerusaalemu. Bamwishe bamumanitse ku giti. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />Ariko Imaana imuzuura ku munsi wa gatatu kandi imwemerera kwigaragaza, <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />atari ku bantu boose, ahuubwo kuri twe baatooranyijwe n'Imaana kuba abahamya, kandi twasangiye na we ibyokurya n'ibyokunywa amaze kuzuuka mu baapfuuye. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Yadutegetse kwamamaza mu bantu no guhamya yuuko ari we Imaana yatooranyije kuba umucaamanza w'abazima n'abaapfuuye. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Abahanuuzi boose bahamya ko umwizeera weese ababarirwa ibyaha mu izina rye.”<verse eid="ACT 10:43" /></para>
  <para style="s1">Abanyamahanga Bahaabwa Umwuka Weera</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Peetero akivuga, Umwuka Weera amanukira kuri abo boose baari barikumva. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />Abiizeera bo mu baakebwe baari bajanye na Peetero batangaazwa n'uko Umwuka Weera yamanukiye no ku banyamahanga, <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />kuko baabumviise bavuga mu ndimi bahimbaaza Imaana. Maze Peetero aravuga ati, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“Hari ubaasha kwima aba bantu amaazi yo kubabatiza kandi baahaawe Umwuka Weera nkaatwe?” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Nuuko abategeka kubatizwa mu izina rya Yesu Kristo. Maze abanyamahanga basaba Peetero kugumana na bo kumara iminsi mike.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">Peetero Asobaanurira abo mu Toorero ry'i Yerusaalemu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Intumwa n'abiizeera baari i Yudeeya bumviise yuuko abanyamahanga na bo beemeye ijambo ry'Imaana. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Nuuko Peetero ageze i Yerusaalemu, abiizeera baakebwe baja na we impaka, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />bavuga bati, “Kuki wagiiye mu badakebwe kandi ukanasangira na bo?” <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />Peetero atangira kubasobaanurira uko bikurikirana ati,<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />“Nari mu tawuni y'i Yopa nsenga, ndatwarwa maze ndeerekwa. Mbona ikintu gisa n'umwenda munini gifashwe ku nshonda enye kimanurwa mu ijuru, maze kiranyegeera. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Nshitegereje neeza mbona inyamaaswa z'amaguru ane, inyamaaswa z'inkazi, n'ibikururuka haasi, hamwe n'inyoni zo mu kireere. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Maze numva n'ijwi rimbwira riti, ‘Peetero, haguruka wice, urye.’ <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />Ariko nje ndamusubiza nti, ‘Oya Nyagasani, nta kintu kitariibwa cangwa gihumanye nari naakoza mu kanwa kanje.’ <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />Inshuro ya kabiri iryo jwi rivugira mu ijuru riti, ‘Ico Imaana yahumaanuye, ntukacite igihumanye.’ <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Ibyo byabaaye gatatu, haanyuma ibyo bintu byose bisubizwa mu ijuru. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />Ako kaanya, abagabo batatu bantumweho kuva i Kayisaariya baba bageze ku rugo rwo twari turimo. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Umwuka ambwira kujaana na bo kandi no kutiitandukanya na bo.<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="ft" closed="false">Cangwa, </char><char style="fqa" closed="false">Ntashidiikanya </char></note> Aba beene daata na bo uko ari batandatu baramperekeza, maze twinjira mu nzu ya Koloneliyo. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Aduteekerereza uko yaboonye malayika ahagaze mu nzu ye akamubwira ati ‘Ohereza umuntu i Yopa, maze azane Simooni wiitwa Peetero. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />Azaaguha ubutumwa buzaagukiza, wowe n'ab'urugo rwawe rwose.’ <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />Igihe ntangiye kuvuga, Umwuka Weera abamanukiraho nk'uko naatwe yatumanukiyeho ubwa mbere. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" /><note caller="-" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="ACT 1:5">Iby 1:5</ref>.</char></note>Nuuko niibuka rya jambo ry'Umwami Yesu, ubwo yavugaga ati, ‘Yohaana yabatiriishaga amaazi, ariko mwebwe muzaabatiriishwa n'Umwuka Weera.’ <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Noone se niiba Imaana yarahaaye abanyamahanga impaano nk'iyo twahaawe ubwo twemeraga Umwami Yesu Kristo, nje ndi nde wo kuvuguruza Imaana?”<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />Bumviise ibyo baratuuza, maze basingiza Imaana bavuga bati, “Nooneho Imaana yahaaye n'Abanyamahanga kwihana kugira ngo na bo bahaabwe ubugingo.”<verse eid="ACT 11:18" /></para>
  <para style="s">Itoorero Muri Antiyokiya</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:1-4">Iby 8:1-4</ref>.</char>
    </note>Nuuko abo baari baarataatanye ku bw'akarengane kaabaayeho biteewe n'ibya Sitefaano baragenda bagera Foyinike, Kupuro n'i Antiyokiya, maze ntibaagira uwo babwiriza ijambo ry'Imaana keretse Abayuuda bonyine. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Ariko bamwe muri bo haarimo abantu b'i Kupuro n'ab'i Kureni. Bageze Antiyokiya, bavugana n'Abagiriki baamamaza ubutumwa bw'Umwami Yesu. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Ububaasha bw'Uhoraho buba muri bo, maze abantu benshi bariizeera bahindukira Nyagasani.<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />Iyo nkuru iza kugera ku toorero ry'i Yerusaalemu, maze boohereza Barinaba muri Antiyokiya. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Ubwo Barinaba yagezeyo akabona uko Imaana yagiriye abantu baayo ubuntu araneezeerwa, maze abiihanangiriza boose kuguma mu Mwami Yesu bamaramaje. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Koko reero uwo Barinaba yari umuntu mwiza, wuuzuye Umwuka Weera n'ukwemera. Kandi abantu benshi caane biyongera kuri abo bizeera Nyagasani.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />Nuuko Barinaba aja i Taruso gushaaka Sawuli. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Amaze kumubona, amujaana muri Antiyokiya. Baamaze umwaka woose bateerana n'abiitoorero, kandi biigiisha abantu benshi. Muri Antiyokiya ni ho abiigiishwa baatangiriye kwitwa “Abakristo.”<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />Ico gihe abahanuuzi bava i Yerusaalemu baja muri Antiyokiya. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" /><note caller="-" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="ACT 21:10">Iby 21:10</ref>.</char></note>Umwe muri bo wiitwaga Agabo arahagarara ayobowe n'Umwuka Weera, ahanuura yuuko hagiiye guteera inzara nyinshi ku isi yoose. Iyo nzara yaaje kubaho ku ngoma ya Kilawudiyo. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Abiigiishwa biiyemeza kureeba ngo buri umwe yoohereje imfashanyo ku bavandimwe baabo batuuye i Yudeeya, bakurikije ubutunzi bwa buri weese. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />Ibi baarabikoze, babyoherereza bakuru b'itoorero babinyujije muri Barinaba na Sawuli.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">Kwicwa kwa Yaakobo no Gufungwa kwa Peetero</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />Ico gihe, umwami Herodi atangira gutooteza bamwe bo mu itoorero. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Ategeka ko Yaakobo mwene se wa Yohaana, yiciishwa inkoota. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Aboonye ko ibyo bineejeeje Abayuuda, yongera no gufata Peetero. [Ibi byabaaye mu minsi mikuru yo gusangira Imigaati Idasembuwe.] <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />Herodi amaze gufata Peetero, amushira mu gihome, maze amurindiisha ubutsiko bune bw'abasirikare bane buri kamwe. Yashaakaga kumushikiriza abantu nyuma yo Kunyurwaho. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Peetero arindiwe mu gihome, ab'itoorero baamusabiraga ku Maana babishizeho umwete.<verse eid="ACT 12:5" /></para>
  <para style="s">Peetero Akuurwa mu Gihome</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />Ijoro Herodi yari bumutange ngo yiicwe, Peetero yari mu gihome asinziiririye hagati y'abasirikare babiri kandi aboheeshejwe injegeri ebyiri. Abarinzi na bo baari imbere y'umuryango w'igihome, baharinze. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Mu kamwanya, haboneka malayika wa Nyagasani, maze umuco umurika mu gihome. Malayika akora Peetero mu mbavu maze amubyutsa amubwira ati, “Haguruka vuba.” Nuuko injegeri zimuva ku maboko ziragwa. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Malayika aramubwira ati, “Kenyera ukomeze, wambare ingato zaawe.” Peetero arabikora nuuko malayika yongera kumubwira ati, “Ifubike umwiteero waawe, unkurikire.” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />Peetero arasohoka aramukurikira, ariko ntiyashobora kwiyumvisha ko ibyo byakorwaga na malayika ari byo. Yateekerezaga ko yari ari kwerekwa. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Bamaze kunyura ku barinzi ba mbere n'aba kabiri, bagera ku ruugi rw'icuuma rwerekeje mu tawuni nkuru. Urwo ruugi ruriikinguura, maze Peetero na malayika barasohoka banyura inzira imwe, mu kamwanya malayika amusiga aho.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />Nuuko Peetero agarura umutima maze aravuga ati, “Nooneho menye by'ukuri yuuko Nyagasani yatumye malayika we kunkuura mu maboko ya Herodi n'ibyo Abayuuda baari bategereje kunkorera byose.”<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />Amaze kubibona atyo, aja kwa Mariya nyina wa Yohaana wiitwaga Mariko, aho abantu benshi baari bateeraniye basenga. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Peetero akomanze ku ruugi rw'irembo, umuja wiitwaga Rooda aja kureeba. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Amenye ijwi rya Peetero, ibineezaneeza biramusaaga maze mu mwanya wo gukinguura irembo, asubira mu nzu yiiruka, avuga ko Peetero ahagaze ku irembo. <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />Baramubwira bati, “Waasaze!” Ariko we akomeza kubahamiriza ko ari byo. Baravuga bati, “Ni malayika we.”<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />Ariko Peetero akomeza gukomanga. Bakinguuye irembo, baramubona maze baratangaara. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Arabamama ngo bahore, nuuko abasobaanurira uburyo Nyagasani yamukuuye mu gihome. Yongera kubabwira ati, “Ibi, mubimenyeeshe Yaakobo n'abandi biizeera.” Nuuko Peetero aragenda aja ahandi hantu.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />Bukeeye, haba impagarara nyinshi mu basirikare, biibaza ibyabaaye kuri Peetero. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Herodi na we amushaatse aramubura, abaza abarinzi uko byabaaye maze ategeka ko biicwa. Birangiye, Herodi ava muri Yudeeya aja i Kayisaariya maze ahamara igihe.<verse eid="ACT 12:19" /></para>
  <para style="s">Urupfu rwa Herodi</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Herodi yari araakariye abantu b'i Tiiro n'i Sidoni. Nuuko biishirahamwe baramusanga, bamaze kubona inkunga ya Bulasito, umutware w'abakora mu nzu y'umwami, basaba umwami kwiyuzuza na bo kuko igihugu caabo caahaahiraga mu gihugu ce.<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />Ku munsi wateguuwe, Herodi yambara imyambaro y'ubwami, yicara ku ntebe ya caami ahiirengeereye, agaaniirira rubanda. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />Abantu bakomeza guteera heejuru bati, “Ntaabwo ari umuntu uvuga, ahuubwo ni ijwi ry'ikigirwamaana!” <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Ako kaanya, malayika wa Nyagasani aramukumbanya agwa haasi, maze ariibwa n'inyo arapfa, kuko ataari yahaaye Imaana icuubahiro.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />Ariko ijambo ry'Imaana rikomeza gukura no kwamamara.<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />Nuuko Barinaba na Sawuli bamaze kurangiza umurimo waabo, bava i Yerusaalemu baazana na Yohaana, wiitwaga Mariko.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">Barinaba na Sawuli Batumwa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Mu itoorero rya Antiyokiya haari abahanuuzi hamwe n'abiigiisha, ari bo Barinaba, Simiyooni wiitwaga Umwirabura, Lusiyasi w'i Kureeni, Manaheni wareranywe na Herodi umutegetsi, hamwe na Sawuli. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Ubwo baaramyaga Nyagasani no kwiyiriza ubusa, Umwuka Weera yarababwiye ati, “Nimunshirire Barinaba na Sawuli ukwabo, maze baje gukora umurimo nabahamagariye.”<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />Nuuko bamaze kwiyiriza ubusa no gusenga, barambika ibiganza kuri Barinaba na Sawuli maze baraboohereza.<verse eid="ACT 13:3" /></para>
  <para style="s">Barinaba na Sawuli Baja i Kupuro</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Barinaba na Sawuli batumwe n'Umwuka Weera, bamanukira i Serewukiya, maze bahafatira ubwato bagana mu kirwa c'i Kupuro. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Bageze i Salamina, baamamaza ijambo ry'Imaana mu masinagoogi y'Abayuuda. Baari kumwe na Yohaana, abafasha.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />Bamaze kwitooroora ikirwa coose bagera i Paafo, basangayo umupfumu w'Umuyuuda wari umuhanuuzi w'ibinyoma wiitwaga Baari Yesu. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />Yari kumwe n'umutware wategekaga ico kirwa, wiitwa Serugiyo Pawulo wari umunyabwenge. Uwo mutegetsi ahamagaza Barinaba na Sawuli, ashaaka kumva ijambo ry'Imaana. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Ariko wa mupfumu Elumasi kuko ni ko izina rye risobaanura, arabahakanya agerageza kuyobya wa mutegetsi ngo atiizeera. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />Ariko Sawuli ari we Pawulo, yuuzuye Umwuka Weera, atumbiira wa mupfumu, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />aramubwira ati, “Wa mwana wa Sataani we, wa mwanzi w'ubutungane bwose we, wowe wuuzuye uburimanganya n'ubugome, uzaageza he kugoreka ukuri kwa Nyagasani? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Noone reero umva, ukuboko kwa Nyagasani kuraguhannye, ugiiye kuba impumyi, umare iminsi utareeba izuuba.”</para>
  <para style="p" vid="ACT 13:11">Ako kaanya igiho c'umwijima kimutwikiira amaaso maze arindagira akabakaba ashaaka abo kumurandata. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Wa mutegetsi aboonye ibibaaye, ariizeera, atangaazwa n'inyigiisho zifashe kuri Nyagasani.<verse eid="ACT 13:12" /></para>
  <para style="s">Pawulo na Barinaba bari Antiyokiya yo muri Pisidiya</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Pawulo na bagenzi be bafatira ubwato i Paafo, maze bagera i Periga yo muri Pamfiliya. Yohaana we abasiga aho, asubira i Yerusaalemu. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />Ariko Pawulo na bagenzi be bava i Periga bagera Antiyokiya yo muri Pisidiya. Ku munsi w'Isaabato, baja mu isinagoogi bariicara. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Nyuma yo gusomerwa mu gitabo c'amategeko n'abahanuuzi, abayobozi b'isinagoogi babooherereza ubutumwa bati, “Bavandimwe, niiba hari ijambo ryo gukomeza abantu mufite, ngaaho nimuritange.” <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />Pawulo arahaguruka, abacecekeesha ikiganza maze atangira kuvuga ati,</para>
  <para style="p" vid="ACT 13:16">“Mwa Biisirayeli mwe, n'abandi baramya Imaana, nimunyumve. <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Imaana y'aba bantu ba Isirayeli yatooranyije ba sogokuruza ibaha koororokana ubwo baari abasuhuuke mu gihugu ca Igiputi, maze ku bw'imbaraga zaayo, ikabakuurayo. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Yabiitaayeho kumara imyaka mirongo ine ubwo baari mu butaayu. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Imaana imaze gutuma amahanga arindwi yo mu gihugu c'i Kanaani arimbuka, yahaaye Abiisirayeli igihugu caabo nk'umurage <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />kandi ibyo byose byajaanye imyaka nka magana ane na mirongo itaanu.</para>
  <para style="p" vid="ACT 13:20">Haanyuma Imaana ibaha abacamanza kugeza igihe c'umuhanuuzi Samweri. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />Bageze aho basaba umwami wo kubayobora, nuuko Imaana ibaha Sawuli mwene Kishi, wo mu bwoko bwa Benjamiini, amara imyaka mirongo ine ku ngoma. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Imaana imaze kumukuuraho, ishiraho Dawudi nk'umwami waabo. Imutangaho ubuhamya iti, ‘Mboonye Dawudi mwene Yese, kuba inkoramutima yanje, uzaakora ibyo nshaaka byose.’ <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />Mu rubyaro rwe ni mwo umukiza w'Abisirayeli, Yesu, akomooka nk'uko Imaana yari yarabimuseezeranyije. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" /><note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="MRK 1:4">Mar 1:4</ref>; <ref loc="LUK 3:3">Luk 3:3</ref>.</char></note>Mbere yuuko Yesu aza, Yohaana yamamazaga mu Biisirayeli boose umubatizo wo kwihana. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" /><note caller="-" style="x"><char style="xo" closed="false">13:25 a </char><char style="xt" closed="false"><ref loc="JHN 1:20">Yoh 1:20</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="MAT 3:11">Mat 3:11</ref>; <ref loc="MRK 1:7">Mar 1:7</ref>; <ref loc="LUK 3:16">Luk 3:16</ref>; <ref loc="JHN 1:27">Yoh 1:27</ref>.</char></note>Nuuko Yohaana ari kurangiza umurimo we, aravuga ati, ‘Muteekereza ko ndi nde? Ntaabwo ndi uwo mukeeka. Oya, ahuubwo hari ugiiye kuuza ankurikiye, kandi sinkwiriye no guhambuura udushumi tw'ingato ze.’<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />Bavandimwe, rubyaro rwa Aburahamu, n'abandi baramya Imaana, ubu butumwa bw'agakiza ni twe<note caller="+" style="f"><char style="fr" closed="false">13:26 </char><char style="ft" closed="false">Ni mwe</char></note> bwohererejwe. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Kuko abatuuye i Yerusaalemu n'abayobozi baabo bataamenye Yesu cangwa ngo basobaanukirwe amagambo y'abahanuuzi asomwa buri Saabato, buuzuririza ayo magambo ubwo baamuciira urwo gupfa. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" /><note caller="-" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 27:22">Mat 27:22</ref>,<ref loc="MAT 27:23">23</ref>; <ref loc="MRK 15:13">Mar 15:13</ref>,<ref loc="MRK 15:14">14</ref>; <ref loc="LUK 23:21-23">Luk 23:21-23</ref>; <ref loc="JHN 19:15">Yoh 19:15</ref>.</char></note>Nuubwo bataaboonye impamvu yo kumuciira urwo gupfa, baasabye Pilaato kumwica. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" /><note caller="-" style="x"><char style="xo" closed="false">13:29 </char><char style="xt" closed="false"><ref loc="MAT 27:57-61">Mat 27:57-61</ref>; <ref loc="MRK 15:42-47">Mar 15:42-47</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoh 19:38-42</ref>.</char></note>Bamaze gukora nk'uko ibyanditswe kuri Yesu byose bivuga, abayoboke be bamumanura ku musaraba, bamushira mu mva. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Ariko Imaana imuzuura mu baapfuuye, <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" /><note caller="-" style="x"><char style="xo" closed="false">13:31 </char><char style="xt" closed="false"><ref loc="ACT 1:3">Iby 1:3</ref>.</char></note>amara iminsi myinshi abonekera abaari baaraazanye na we kuva i Galileeya kugera i Yerusaalemu, noone ubu ni bo bahamya baabyo mu bantu. <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />Noone ubu tubaazaniye Inkuru Nziiza yuuko iseezerano Imaana yagiriye ba sogokuruza <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />ari twebwe, abaana baabo, ryujuririjwemo, ubwo yazuuye Yesu, nk'uko byanditswe muri Zaaburi ya kabiri ngo,</para>
  <para style="q1" vid="ACT 13:33">‘Uri Umwana wanje,</para>
  <para style="q2" vid="ACT 13:33">uyu munsi ndakwibyariye.’<verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />Ibyo kumuzuura mu baapfuuye, no kudasubira kubora, Imaana ibivuga muri aya magambo, iti, ‘Nzaabaha ibyiza naseezeranyije Dawudi</para>
  <para style="q1" vid="ACT 13:34">Nzaabaha ibyiza bitagira inenge</para>
  <para style="q2" vid="ACT 13:34">naseezeranyije Dawudi.’<verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />Ni co gituma yarongeye kuvuga mu yindi Zaaburi ati,</para>
  <para style="q1" vid="ACT 13:35">‘Ntaabwo uzeemera ko Uweera waawe abora.’<verse eid="ACT 13:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 13:36" />Dawudi we yakoze ibyo Imaana ishaaka mu gihe ce, arapfa,<note caller="+" style="f"><char style="fr" closed="false">13:36 </char><char style="ft" closed="false">Arasinziira </char></note> ahambwa aho ba seekuruza baahambwe, maze arabora, <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />ariko uwo Imaana yazuuye ntaabwo yiigeze kubora. <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />Nooneho reero bavandimwe, mumenye yuuko ari ku bwa Yesu mwagejejweho ibabarirwa ry'ibyaha, <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />kandi ni ku bwe buri weese umwemera ababarirwa ibyaha byose ndetse n'ibyo bitaakababariwe n'amategeko ya Moose. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />Nimwirinde reero, kugira ngo ibyo abahanuuzi baavuze bitababaho.<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />‘Nimureebe, mwa banyagasuuzuguro mwe!</para>
  <para style="q1" vid="ACT 13:41">Nimutangaare maze murimbuke,</para>
  <para style="q2" vid="ACT 13:41">kuko muri iki gihe caanyu, ngiiye gukora igikorwa,</para>
  <para style="q2" vid="ACT 13:41">igikorwa co mutaziigera mwemera, nuubwo haagira ukibabwira.’ ”<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Pawulo na Barinaba basohotse, abantu babasaba kuzongera kuvuga kuri aya magambo ku Isaabato ikurikiraho. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Inaama yo mu sinagoogi irangiye, Abayuuda benshi hamwe n'abo beemeye idiini y'Abayuuda bakurikira Pawulo na Barinaba. Pawulo na Barinaba bavugana na bo kandi babashiishikariza kuguma mu buntu bw'Imaana.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Ku Isaabato yakurikiyeho, haafi abo mu tawuni boose baari baakoraniye mu isinagoogi kumva ijambo rya Nyagasani. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Ariko Abayuuda baboonye ko abantu ari benshi, bagira ishari ryinshi, maze bavuga amagambo asebya, bahinyura ibyo Pawulo yavugaga. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />Nuuko Pawulo na Barinaba bavuga bashize amanga bati, “Byari bikwiriye ko ari mwe mubanza kubwirwa ijambo ry'Imaana. Ariko ubwo muryanze mukabona ko mudakwiriye ubugingo buhoraho, ubu tugiiye kubareka dusange abanyamahanga. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Kuko ni ko Nyagasani yadutegetse ati,</para>
  <para style="q1" vid="ACT 13:47">‘Ngushiriyeho kuba urumuri rw'Abanyamahanga,</para>
  <para style="q2" vid="ACT 13:47">kugira ngo ujaane agakiza ku mpera y'isi.’ ”<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />Abanyamahanga babyumviise bariishiima, maze basingiza ijambo rya Nyagasani, na benshi bari baaragenewe ubugingo buhoraho bahinduka abiizeera.<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />Nuuko ijambo rya Nyagasani rikwira mu gihugu coose. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Ariko Abayuuda boosha abagore b'icuubahiro buubaha Imaana, hamwe n'abagabo b'icuubahiro b'iyo tawuni nkuru, maze babateeza Pawulo na Barinaba ngo babatooteze, kandi babiirukane mu gihugu caabo. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" /><note caller="-" style="x"><char style="xo" closed="false">13:51 </char><char style="xt" closed="false"><ref loc="MAT 10:14">Mat 10:14</ref>; <ref loc="MRK 6:11">Mar 6:11</ref>; <ref loc="LUK 9:5">Luk 9:5</ref>; <ref loc="LUK 10:11">10:11</ref>.</char></note>Ariko Pawulo na Barinaba bakunkumura umucuucu wo ku birenge byabo nk'ikimenyeetso co kubavuma, maze baja Ikoniyo. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Abiigiishwa buuzura ibyishiimo n'Umwuka Weera.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">Pawulo na Barinaba bari Ikoniyo</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Pawulo na Barinaba bageze Ikoniyo, baahasanze nk'ibyo bahuuriye na byo Antiyokiya. Binjiye mu isinagoogi y'Abayuuda, bavuga amagambo yatumye Abayuuda n'Abagiriki benshi biizeera. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Abayuuda batiizeeye boosha abanyamahanga kandi babateeramo umutima mubi wo kugirira naabi abavandimwe. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Nuuko Pawulo na Barinaba bahamara igihe kireekire, biigiisha bashize amanga ku bwa Nyagasani wahamyaga ijambo ry'ubuntu bwe, abaha gukora ibimenyeetso n'ibitangaaza. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Ariko abantu bo muri iyo tawuni nkuru biicamo ibice, bamwe baja ku ruhande rw'Abayuuda, abandi ku rw'intumwa.<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />Ubwo abanyamahanga, Abayuuda n'abatware baabo baajaga inaama yo kugirira naabi intumwa no kuziteera amabuye, <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />zirabimenya maze zihungira i Lisitura n'i Derube, amatawuni ya Lukawoniyo, no mu gihugu kihakiikije. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />Aho na ho bakomeza kuhaamamariza Inkuru Nziiza.<verse eid="ACT 14:7" /></para>
  <para style="s">Pawulo na Barinaba bari i Lisitura n'i Derube</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />I Lisitura haari umugabo utaarashoboraga kugenda kuko yari yaravuutse aremaye ibirenge. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />Yiicaye aho atega amatwi Pawulo avuga. Pawulo amwitegereje, abona ko afite kwizeera guhaagije kugira ngo akire, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />maze avuga mu ijwi riranguruye ati, “Haguruka maze uhagarare wemye.” Uwo mugabo arahaguruka, atangira kugenda. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />Iyo mbaga y'abantu iboonye ibyo Pawulo akoze, iteera heejuru mu rurimi rw'Urunyalukayoniyoni iti, “Uyu munsi imaana zifite ishusho y'abantu zaatumanukiye!” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Barinaba bamwita Zewusi, naho Pawulo bamwita Herume, kuko ari we wajaga abandi imbere mu kuvuga. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Umuheerezabitambo wa Zewusi, wari ufite ingoro yaayo hirya ya tawuni nkuru gato, azana ibimasa bitaatswe ku irembo, kuko we n'abantu benshi baashaakaga gutuura izo ntumwa igitambo.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />Ariko intumwa Pawulo na Barinaba babyumvise, bashishimura imyambaro yaabo nk'ikimenyeetso co guhakanya ico gikorwa maze biirukira muri ba bantu benshi, bateera heejuru bati, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />“Nshuti zaacu, kuki mukora ibi? Turi abantu nka mwe, kandi tubaazaniye Ubutumwa Bwiza, ngo mureke ibyo bitabafitiye akamaro nuuko muhindukire Imaana nzima yaremye ijuru n'isi n'inyanja n'ibirimo byose. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />Mu bihe byashize Imaana yeemereraga amahanga yoose gukora uko yiishaakiye, <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />ariko ntiyareka gutanga ibimenyeetso bihamya kugira neeza kwayo, nko kubaha imvura yo mu ijuru no kubaha umusaaruuro mu gihe gikwiriye, ikabaha ibyokurya bihaagije no kuuzuza imitima yaanyu umuneezeero.” <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Nuubwo izo ntumwa zaavuze aya magambo, ibyo ntibyabujije abantu benshi kubatuura ibitambo.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Ariko haaza Abayuuda bavuuye muri Antiyokiya no muri Ikoniyo maze biigarurira ba bantu benshi caane. Bateera Pawulo amabuye, maze bamukururira inyuma y'itawuni nkuru, biibwira ko yapfuuye. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Ariko abiigiishwa bamukiikije, arahaguruka asubira mu tawuni nkuru. Bukeeye avayo ajaana na Barinaba i Derube.<verse eid="ACT 14:20" /></para>
  <para style="s">Pawulo na Barinaba Basubira Antiyokiya yo mu Gihugu ca Siriya</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />Pawulo na Barinaba bamaze kubwiriza Ubutumwa Bwiza muri iyo tawuni nkuru ya Derube no kuhabona abiigiishwa benshi, basubira i Lisitura no muri Ikoniyo na Antiyokiya. <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />Bakomeza imitima y'abiigiishwa kandi babateera umwete wo gukomeza kwizeera bababwira bati, “Ni ngombwa ko tunyura mu gutootezwa, mbere yuuko twinjira mu bwami bw'Imaana.” <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Bamaze kubatooranyamo abakuru mu buri toorero, basenga biyiriza ubusa, maze babaragiza Umwami Yesu uwo baari biizeeye.<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />Banyura i Pisidiya bagera i Pamfiliya. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Bamaze kuvuga ijambo ry'Imaana i Periga, baramanuka baja muri Ataliya. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />Bavayo bafata ubwato bagaruka Antiyokiya, aho abiizeera baari baarabaragije ubuntu bw'Imaana ku bw'umurimo baari barangije.<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />Bagezeyo, bakoranya itoorero maze babateekerereza ibyo Imaana yabashoboje gukora byose, n'uko yuugururiye abanyamahanga irembo ryo kwizeera. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Nuuko bamarayo iminsi myinshi n'abizeera.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">Urukiiko Rwabeereye i Yerusaalemu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Nuuko abantu bamwe bava i Yudeeya baaza biigiisha abavandimwe bo muri Antiyokiya bati, “Niiba mudakebwe nk'uko umugenzo wa Moose ubitegeka, ntimubaasha gukizwa.” <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Nyuma yaaho, Pawulo na Barinaba baja na bo impaka zitooroshe. Nuuko Pawulo na Barinaba hamwe n'abandi muri bo batooranywa kuja i Yerusaalemu kugira ngo bagiishe inaama intumwa n'abakuru b'imiryango kubihereereye ico kibazo co gukebwa.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />Nuuko booherezwa n'itoorero, banyura i Foyinike n'i Samariya, bateekerereza abavandimwe ibyo guhinduka kw'Abanyamahanga, maze ibyo bineezeeza abiizeera boose. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Bageze i Yerusaalemu, baakiirwa n'itoorero, n'intumwa, n'abakuru b'imiryango. Nuuko babateekerereza ibyo Imaana yabakoreesheje. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />Ariko bamwe mu biizeera bo mu kibiina c'Abafarisaayo barahaguruka baravuga bati, “Ningombwa ko abo banyamahanga bakebwa, kandi bagategekwa kuubahiriza amategeko ya Moose.”<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />Intumwa n'abakuru b'imiryango bateeranira hamwe kugira ngo basuuzume iyo ngoraane. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" /><note caller="-" style="x"><char style="xo" closed="false">15:7 </char><char style="xt" closed="false"><ref loc="ACT 10:1-43">Iby 10:1-43</ref>.</char></note>Bamaze kuja impaka nyinshi, Peetero arahaguruka arababwira ati, “Bavandimwe, muuzi neeza yuuko keera Imaana yantooranyije muri mwe, gutangaaza Ubutumwa Bwiza mu banyamahanga, kugira ngo babwumve kandi beemere. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" /><note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 10:44">Iby 10:44</ref>; <ref loc="ACT 2:4">2:4</ref>.</char></note>Kandi Imaana izi imitima y'abantu yarabeemeje, igihe yabahaaye Umwuka Weera, nk'uko naatwe yamuduhaaye. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />Ntaabwo yatandukanyije abanyamahanga naatwe, kuko yababariye ibyaha byabo ku bwo biizeeye. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Noone, kuki mugerageza Imaana, mukorera abo biigiishwa umutwaro wo twebwe na ba sogokuruza tutaashoboye kwikorera? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Byongeye kandi, twemera yuuko twakijijwe ku bw'ubuntu bw'Umwami Yesu, nka bo.”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />Nuuko ikoraniro ryose riraceceka, maze bumviriza Barinaba na Pawulo babateekerereza ibimenyeetso n'ibitangaaza byose Imaana yabakoreesheje mu banyamahanga. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />Barangije kuvuga, Yaakobo aravuga ati, “Bavandimwe, nimunyumve. <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Simooni abateekerereje uko Imaana yazindukiye abanyamahanga, ikabatooranyamo umuryango waayo. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Ibyo bikaba bihuuye n'ibyavuzwe n'abahanuuzi, nk'uko byanditswe ngo,<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />‘Haanyuma y'ibyo nzaagaruka,</para>
  <para style="q2" vid="ACT 15:16">nuubake busha inzu ya Dawudi yasenyutse.</para>
  <para style="q1" vid="ACT 15:16">Ahaasenyutse nzaahuubaka bundi busha,</para>
  <para style="q2" vid="ACT 15:16">maze nyihagarike,<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />kugira ngo abandi bantu boose bashaakashaake Nyagasani,</para>
  <para style="q2" vid="ACT 15:17">ndetse n'Abanyamahanga biitirirwe izina ryanje. Uwo ni Nyagasani ubivuze, uwahoze atuma ibi bintu<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />bimenyekana uheereye keera.’<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />Ni co gituma mpitamo ko tudakwiriye kurusha abo banyamahanga bari kugarukira Imaana, <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />ahuubwo tubandikire ngo biirinde kurya ibyatuuwe ibigirwamaana n'ubusambanyi, no kurya inyamaaswa zaanizwe, cangwa amaraso. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Erega kuva keera koose, no mu ma tawuni yoose, Moose yari afite abaamamaza ibye, kuko buri Saabato babisomeraga mu masinagoogi.”<verse eid="ACT 15:21" /></para>
  <para style="s">Urwandiko Rwandikiwe Abanyamahanga Beemeye Kristo</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Itoorero ryose rimaze kwemeranya, intumwa na bakuru b'umuryango biyemeza kwitooranyamo bamwe ngo babatume Antiyokiya hamwe na Pawulo na Barinaba. Abooherejwe ni Yuda wiitwaga Barisaba, na Silaasi, abagabo babiri buubahwa caane mu bavandimwe. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />Urwandiko baajanye rwari ruvuga ruti,</para>
  <para style="p" vid="ACT 15:23">“Twebwe abavandimwe baanyu, intumwa hamwe n'abakuru b'imiryango, turabaramutsa mwebwe abiizeera bo mu banyamahanga bari Antiyokiya n'i Siriya n'i Silisiya. <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />Twumviise ko bamwe muri twe, nuubwo tutaari tubatumye, baababwiye amagambo abaca urutege kandi ko byatumye muhagarika imitima,<note caller="+" style="f"><char style="fr" closed="false">15:24 </char><char style="ft" closed="false">Bimwe mu byanditswe byera bivuga ngo, </char><char style="fqa" closed="false">Ko mugomba gukebwa kandi mugakurikiza amategeko </char></note> <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />twemeranyije ko dutooranya abo kuduhagararira tukababatumaho, hamwe n'abo dukunda Barinaba na Pawulo, <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />baahaze amagara yaabo ku bw'Umwami Yesu Kristo. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Nuuko reero tubatumyeho Yuda na Silaasi, baribuuze kubiibwirira babasobaanurira ibyo tubandikiye. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />Umwuka Weera hamwe naatwe, twashimye yuuko tudakwiriye kubiikoreza umutwaro urenze ibi by'ingenzi mukwiriye gukurikiza; <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />kwirinda kurya inyama zaatuuwe ibigirwamaana n'amaraso, kutarya inyama z'inyamaaswa zaanizwe, hamwe no kwirinda ubusambanyi. Ibyo nimubyirinda, muzaaba mukoze neeza. Nimugire amahoro.”<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Nuuko abaari baatumwe baragenda bamanukira Antiyokiya. Bamaze gukoranya iteeraniro ry'abiizeera, babaha urwandiko. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Bamaze kurusoma, baneezeezwa n'ubwo butumwa bwo kubakomeza. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />Yuda na Silaasi na bo ubwabo baari abahanuuzi, babwira abiizeera byinshi byo kubahuguura no kubakomeza. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Baahamaze iminsi, abiizeera babaseezerera amahoro basubira ku baabatumye. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />Ariko Silaasi we ahitamo kugumayo.<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">Bimwe mu byanditswe bya keera ntaabwo bifite uyu murongo.</char></note><verse eid="ACT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35" />Pawulo na Barinaba baguma muri Antiyokiya, bafatanyije n'abandi benshi, biigiisha kandi baamamaza ijambo rya Nyagasani.<verse eid="ACT 15:35" /></para>
  <para style="s">Pawulo na Barinaba Batandukana</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Hashize iminsi, Pawulo abwira Barinaba ati, “Reka dusubire gusuura abiizeera bo mu ma tawuni twamamajemo ijambo rya Nyagasani, tureebe uko bahagaze mu kwizeera.” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Barinaba ashaaka kujaana na Yohaana wiitwaga Mariko. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" /><note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="ACT 13:13">Iby 13:13</ref>.</char></note>Pawulo we ntiyashiima kujaana n'uwari warabateereranye bari i Pamfiliya, ntabafashe umurimo. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Impaka zibaaye nyinshi hagati yaabo, bituma batandukana. Barinaba ajaana na Mariko bafata ubwato beerekeza i Kupuro. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />Pawulo we ahitamo Silaasi barajaana. Abiizeera basabira Pawulo kandi bamuragiza ubuntu bwa Nyagasani. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Anyura muri Siriya n'i Silisiya, akomeza amatoorero.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">Timoteeyo Yiyunga Kuri Pawulo na Silaasi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Nuuko Pawulo agera i Derube n'i Lisitura. Haariyo umwizeera wiitwaga Timoteeyo, akaba umwana w'Umuyuudakazi wizeera, ariko se yari Umugiriki. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Yavugwagaho neeza n'abiizeera bo muri i Lisitura hamwe n'Ikoniyo. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Pawulo yashaakaga ko Timoteeyo amuherekeza, maze aramujaana baramukeba kuko Abayuuda baari batuuye muri iyo myanya, baari baazi ko se yari Umugiriki. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Ubwo baavaga mu tawuni baja mu yindi, Pawulo na Silaasi baagezaga kubiizeera ibyemezo byafashwe n'intumwa hamwe n'abakuru b'i Yerusaalemu kandi bakabasaba kubikurikiza. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Bityo reero, amatoorero akomerera mu kwizeera kandi yiiyongera buri munsi.<verse eid="ACT 16:5" /></para>
  <para style="s">Pawulo Yerekwa Umugabo w'i Makedooniya</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Pawulo na bagenzi be banyura i Furigiya n'i Galatiya, kuko Umwuka Weera yari yaababujije kuvugira ubutumwa muri Asiya. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Bageze ahateeganye na Misiya, bagerageza kuja Bitiniya, ariko Umwuka wa Yesu ntiwabeemerera. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Nuuko banyura i Misiya, baramanuka baja i Torowadi. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />Muri iryo joro, Pawulo arabonekerwa, abona umugabo w'i Makedooniya amuhagaze imbere amwinginga avuga ati, “Ambuka uze i Makedooniya udufashe.” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Pawulo akimara kubonekerwa, dutangira gushaaka uko twakwambuka tukaja i Makedooniya, kuko twari tumaze kumenya neeza yuuko Imaana iduhamagarira kwamamaza Inkuru Nziiza mu bantu b'aho.<verse eid="ACT 16:10" /></para>
  <para style="s">Lidiya w'i Filipi Yeemera Kristo</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Dufatira ubwato i Torowadi, tugana Samatirasi, bukeeye tuja Neyapoli, <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />tuvuuyeyo tuja i Filipi, ari yo tawuni nkuru mu disiturikiti ya mbere ya Makedooniya ahaategekwaga n'Abarooma. Twamaze iminsi muri iyi tawuni nkuru. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />Ku munsi w'Isaabato, tuva mu tawuni tugana iruhande rw'uruuzi, ahantu ho twateekerezaga ko bahasengera. Nuuko turiicara maze dutangira kugaaniira n'abagore baari bahateeraniye. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Umugore wiitwaga Lidiya, wari usanzwe asenga Imaana, aratwumva. Yari akomooka mu tawuni nkuru ya Tiyatira kandi yari umucuruuzi w'imyenda y'imihengeri. Nyagasani amuha umutima wo gutega amatwi ibyo Pawulo yavugaga. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Amaze kubatizanywa n'abo mu rugo rwe, atwinginga avuga ati, “Niiba mubona koko ko neemera Nyagasani, nimuuze mucumbike iwanje.” Nuuko atwemeza kuja iwe.<verse eid="ACT 16:15" /></para>
  <para style="s">Pawulo na Silaasi mu Gihome i Filipi</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Umunsi umwe, ubwo twajaga ahantu basengera, duhuura n'umukoobwa wari umuja utuuwemo na dayimooni yatumaga aragura. Uko kuragura kwe kwatumaga baasheebuja babona inyungu nyinshi caane. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Yakurikiraga Pawulo na twe, maze agateera heejuru avuga ati, “Aba bantu ni abagaragu b'Imaana Isumbabyose, kandi bamamaza inzira y'agakiza.” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />Yagumaga abikora atyo kumara iminsi myinshi. Ariko Pawulo biramuraakaza, ni ko guhinduka maze abwira ya dayimooni ati, “Mu izina rya Yesu Kristo, ndagutegetse, muvemo.” Ako kaanya dayimooni imuvamo. <verse eid="ACT 16:18" /><verse number="19" style="v" sid="ACT 16:19" />Baasheebuja baboonye ko ibyiringiro byo gukora inyungu bitagishobotse, bafata Pawulo na Silaasi barabakurura, babajaana mu mwanya mugari imbere y'abacaamanza. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Babagejeje imbere y'abacaamanza, baravuga bati, “Aba bantu ni Abayuuda, barateera umuteekaano muke mu tawuni yaacu. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />Baraamamaza imigenzo inyuranyije n'amategeko kandi twe nk'Abarooma tukaba tutayeemera cangwa ngo tuyikurikize.” <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />Rubanda na bo batangira gukubita Pawulo na Silaasi.</para>
  <para style="p" vid="ACT 16:22">Abacaamanza babatanyagurizaho imyenda kandi bategeka ko babakubita inkoni. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Bamaze kubakubita birenze urugero, babashira mu gihome kandi bategeka umurinzi kubarinda abyitayeho. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />Umurinzi na we mugukurikiza amategeko ahaawe, abashira mu gisenge co hagati maze amaguru yaabo ayabohera ku biti.<figure style="fig" alt="Paul and Salis's feet were fastened in the stocks" file="LB00337B.TIF" size="col" copy="HK-NEW" ref="16:24">Ibirenge bya Pawulo n'ibya Silaasi bihambiiriwe ku biti</figure><verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />Nko mu gicuku, Pawulo na Silaasi bari gusenga no kuririmbira Imaana, abandi basibe bo baarabumvirizaga. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />Mu kamwanya hahinda umushitsi mwinshi, isi iratigita maze imfatiro z'igihome ziranyeganyega. Imiryango y'igihome yoose irakinguuka kandi n'injegeri zaari ziboshe abasibe zoose zirashumuruka. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Umurinzi ko yakangutse akabona imiryango y'igihome yuguruwe, akuurayo inkoota kugira ngo yiyice, kuko yiibwiraga ko abasibe baatorotse. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Ariko Pawulo ateera heejuru caane, aramubwira ati, “Uramenye ntiwigirire naabi, kuko twese turi hano.”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />Nuuko wa murinzi asaba itaara, yiirukira mu nzu vuba, yiikubita imbere ya Pawulo na Barinaba ahinda umushitsi. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />Abajaana hanze maze arababaza ati, “Batware, nkwiriye gukora iki kugira ngo nkizwe?”<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />Baramusubiza bati, “Emera Umwami Yesu, maze wowe n'abo mu rugo rwawe mukizwe.” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Bamubwira ijambo rya Nyagasani n'abandi boose baari mu nzu ye. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Muri ico gicuku, ajaana Pawulo na Silaasi maze abooza inguma. Bidatinze, wa murinzi n'umuryango we woose barabatizwa. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Ajaana Pawulo na Silaasi iwe, arabagaburira, maze yiishiimana n'ab'urugo rwe boose kuko yeemeye Imaana.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Bumaze guca, abacaamanza batuma abapoolisi bababwira bati, “Murekure abo bagabo bagende.”<verse eid="ACT 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36" />Umurinzi w'igihome amenyeesha Pawulo ati, “Abacaamanza boohereje ubutumwa ngo murekurwe, ngaho reero ni musohoke maze mugende amahoro.”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />Ariko Pawulo aramusubiza ati, “Badukubitiye imbere y'abantu nta rubanza rwadutsinze, badushira no mu gihome kandi turi Abarooma, noone barashaaka kuturekura rwihishwa? Oya ntibishoboka! Nibiiyizire ubwabo abe aribo baturekura.”<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />Abapoolisi na bo babwira abacaamanza ibyo Pawulo avuze, nuuko baratiinya bamaze kumva yuuko ari Abarooma, <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />baraaza babasaba imbabazi. Barabasohora maze babasaba kuva muri iyo tawuni. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Bamaze kuva mu gihome baja kwa Lidiya, babonanirayo n'abavandimwe barabakomeza, maze baragenda.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">Agasasamaro i Teesalonike</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Pawulo na Silaasi bamaze kunyura Amfipoli na Apoloniya, bagera i Teesalonike, ahaari isinagoogi y'Abayuuda. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Pawulo yinjira mu sinagoogi nk'uko yari abimenyereye, nuuko amara amasaabato atatu aja na bo impaka, akurikije ibyanditswe. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />Yasobaanuraga ibyanditswe kandi akeerekana ko Kristo yari akwiriye kubabazwa no kuzuuka mu baapfuuye ati, “Uyu Yesu naamamaza, ni we Kristo.” <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Bamwe muri bo barabyemera maze biifatanya na Pawulo na Silaasi. Abagiriki buubaha Imaana n'abagore b'icuubahiro benshi na bo babiiyungaho.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />Ariko Abayuuda bagira ishari, bafatanya n'imihiri bavanye mu mayira biikoramo igiteero maze batangira guteera agasasamaro mu tawuni nkuru. Ubwo baahiigaga Pawulo na Barinaba ngo babajaane imbere y'abantu, bateera inzu ya Yasooni ngo babakuuremo. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Babuze Pawulo na Silaasi, bakurubana Yasooni n'abiizeera bamwe babajaanira abategetsi b'i tawuni nkuru bateera induuru, bavuga bati, “Aba bantu buubitse igihugu coose baaje na hano, <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />kandi Yasooni yabaakiiriye iwe nk'abashitsi. Aba boose baagomeye amategeko ya Kayisaari, bavuga yuuko hariho undi mwami wiitwa Yesu.” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />Abatware b'itawuni nkuru hamwe na rubanda babyumvise bibateesha umutwe. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Yasooni hamwe n'abandi bamaze kubiishingira, barabarekura barataaha.<verse eid="ACT 17:9" /></para>
  <para style="s">Pawulo na Silaasi Baakiirwa i Beroya</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Iryo joro, abiizeera boohereza Pawulo na Silaasi i Beroya. Bagezeyo baja mu isinagoogi y'Abayuuda. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Aba Bayuuda bo baabaakiiranye ineeza kuruta ab'i Teesalonike, kuko bo baakiiriye ubutumwa n'umutima mwiza kandi buri munsi bagasoma ibyanditswe kugira ngo bareebe niiba ari ko bimeze. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Nuuko benshi bareemera, kandi muri bo haarimo Abagirikikazi b'abanyacuubahiro hamwe n'abagabo b'Abagiriki benshi. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />Ariko Abayuuda b'i Teesalonike bumviise ko Pawulo yaamamaje ijambo ry'Imaana n'i Beroya, naho bajayo ngo bateere agasasamaro muri rubanda. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Abiizeera baheerako boohereza Pawulo ku nyanja, naho Silaasi na Timoteeyo baguma aho ngaaho. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Abaari baherekeje Pawulo bamugeza Atenaayi. Amaze kubategeka kujaanira Silaasi na Timoteeyo ubutumwa bubasaba kumwiyungaho bidatinze, bamusiga aho.<verse eid="ACT 17:15" /></para>
  <para style="s">Pawulo muri Atenaayi</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Igihe Pawulo yari Atenaayi ategereje Silaasi na Timoteeyo, ababazwa no kureeba itawuni nkuru yuuzuye ibigirwamaana. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Ku bw'iyo mpamvu, buri munsi yajaga mu sinagoogi akaja impaka n'Abayuuda n'Abanyamahanga baramya Imaana, akaja no mu iguriro akaja impaka n'abantu baahanyuraga. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Kandi bamwe mu banyabwenge biitwaga Abeepikureyo n'abandi biitwaga Abasitoyiki na bo batangira kuja impaka na we. Bamwe bakavuga bati, “Iyi ndondogozi irashaaka kuvuga iki?”</para>
  <para style="p" vid="ACT 17:18">Abandi bakavuga bati, “Ashobora kuba ari umwigiisha w'imaana z'inyamahanga.” Baabiteekerezaga batyo kuko yaamamazaga inkuru nziiza ya Yesu n'izuuka rye. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />Nuuko bamujaana mu rukiiko rwabo rwitwa Areyopago, maze baramubaza bati, “Dushobora kumenya iby'iyi nyigiisho nsha waamamaza? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Ibyo utubwira turabona bidasanzwe, noone turashaaka ngo ubidusobaanurire tubimenye.” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />Koko reero, Abanyatenaayi n'Abanyamahanga bahatuuye, ntaakindi baakoraga keretse kuvuga cangwa kumva ibisha.<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />Nuuko Pawulo ahagarara imbere y'urukiiko rwa Areyopago maze arababwira ati, “Bantu ba Atenaayi, ndabona ko muri abanyadiini birenze urugero. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Kuko ubwo nanyuraga mu tawuni, nagiiye niitegereza amashusho yo muramya, nuuko muri yo mbonamo igicaaniro canditsweho ngo, ‘Ku maana itaazwi.’ Iki kimenyeesha ko muramya imaana mutaazi, noone reero iyo Maana musenga mutayizi ni yo naaje kubamenyeesha. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" /><note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="ACT 7:48">Iby 7:48</ref>.</char></note>N'Imaana yaremye isi n'ibiyirimo byose, ni yo mugenga w'ijuru n'isi, kandi ntaabwo iba mu ngoro zuubatswe n'abantu, <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />cangwa ngo ifashwe n'amaboko y'abantu nk'aho hari ico ikennye, kuko ni yo iha ibiremwa byose ubugingo no guhuumeeka n'ibindi byose. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Yaremye amahanga yoose akomooka ku muntu umwe, Iyakwiza ku isi. Ni na yo yashizeho ibihe byo kubaho ndetse n'imbibi z'aho abantu bakwiriye gutuura. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />Imaana yakoze ibyo kugira ngo bayishaakashaake bafite ibyiringiro byo kuyibona, nuubwo Itari kure ya buri umwe muri twe, <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />nk'uko, byanditswe ngo,</para>
  <para style="q1" vid="ACT 17:28">‘Ni yo dukeesha ubugingo bwacu, kwidagadura no kuba ico turi co.’</para>
  <para style="m" vid="ACT 17:28">Ni na ko bamwe mu basizi baanyu baavuze bati,</para>
  <para style="q1" vid="ACT 17:28">‘Natwe turi abaana baayo.’<verse eid="ACT 17:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ACT 17:29" />Ubwo reero dukomooka ku Maana, ntidukwiriye guteekereza yuuko kamere y'Imaana imeze nk'ibishushaanyo bikozwe mu izaahabu, cangwa ifeeza, cangwa amabuye, cangwa mu kindi gikomooka mu bukorikori n'ubuhanga bw'abantu. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Nuubwo Imaana yiirengagije ibyo bihe by'ubujiji bw'abantu, ubu nooneho reero irategeka abantu boose iyo bava bakagera ngo biihane, <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />kuko yashizeho umunsi izaaciira isi urubanza rutabeera ikoreesheje umuntu yatooranyije, kandi yabyemeje ubwo yamuzuuye mu baapfuuye.”<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Bumviise ibyo kuzuuka kw'abaapfuuye, bamwe bamuha urw'ameenyo, ariko abandi baravuga bati, “Tuzongera kumva ibifashe kuri ibi ikindi gihe.” <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />Nuuko Pawulo abavamo. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Ariko bamwe muri bo biifatanya na we bariizeera, baarimo Diyoniziyo wo mu ba Areyopago n'umugore wiitwaga Damari, n'abandi.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">Pawulo ari i Korinto</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Nyuma y'ibyo, Pawulo ava Atenaayi aja i Korinto. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Ahasanga Umuyuuda wiitwaga Akwila, ukomooka i Ponto, wari umaze igihe gito avuye Italiyani n'umugore we Purisikila, kuko Kilawudiyo yari amaze gutegeka ko Abayuuda boose bava i Rooma. Nuuko Pawulo aja kubasuura, <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />kuko boose baari abubatsi b'amahema, Pawulo abaana na bo bakora hamwe. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Buri Isaabato, yajaga mu isinagoogi akaja impaka agerageza kwemeza Abayuuda hamwe n'Abagiriki.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />Ubwo Silaasi na Timoteeyo bahageze bavuuye i Makedooniya, Pawulo agira umwete wo kuvuga ubutumwa ahamiriza Abayuuda ko Kristo ari Yesu.<verse eid="ACT 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 18:6" />Igihe baamuhankanyaga no kumusebya, we yabakunkumuriragaho umucucu wo mu myambaro<note caller="+" style="f"><char style="fr" closed="false">18:6 </char><char style="ft" closed="false">Ibindi byanditswe byera bivuga </char><char style="fqa" closed="false">Umucuucu wo haasi y'ingato ze</char></note> ye akababwira ati, “Amaraso yaanyu azaababarweho! Nje ndi umwere. Uheereye ubu, mfashe inzira ngiye mu banyamahanga.” <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />Nuuko Pawulo ava kuri iyo sinagoogi aja kuba n'umugabo wiitwa Titiyo<note caller="+" style="f"><char style="fr" closed="false">18:7 </char><char style="ft" closed="false">Mu byanditse byera bya keera bandika </char><char style="fqa" closed="false">Tito </char></note> Yusitusi, wuubahaga Imaana, inzu ye yari ituuranye n'isinagoogi y'Abayuuda. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Kurisipasi wari umuyobozi w'isinagoogi n'abiiwe boose baba abayoboke biizeera Nyagasani, kandi n'abandi Banyakorinto benshi bumvaga ibyo Pawulo yiigiishaga baariizeeraga bakabatizwa.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />Ijoro rimwe, Nyagasani abonekera Pawulo mu nzozi, ati, “wiitiinya, ahuubwo uvuge weguceceka, <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />kuko ndi kumwe na we, ntaawe uzaguhangaara ngo akugirire naabi, kuko abantu benshi muri iyi tawuni ni abanje.” <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Pawulo abayo kumara umwaka n'igice ari kubiigiisha ijambo ry'Imaana.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Ariko mu gihe Galiyo yari umutware muri Akaya, Abayuuda baarifatanyije bafata Pawulo bamujaana imbere y'ubucaamanza. <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />Baramurega bati, “Uyu mugabo yoosha abantu kuramya Imaana mu buryo bunyuranye n'amategeko.”<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />Pawulo agiiye kugira ico avuga, Galiyo abwira Abayuuda ati, “Iyo kija kuba igikorwa kinyuranye n'amategeko gikomeye cangwa ubugome, mba naakwemera nkumva ibyo mumurega, <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />ariko ubwo ari ibibazo byerekeye amagambo n'amazina hamwe n'amategeko yaanyu, nimubyimarire. Sinshaaka guca urubanza rw'ibyo.” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Nuuko abiirukana mu rukiiko. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />Haanyuma boose bafata Sositeni, umuyobozi w'isinagoogi bamukubitira imbere y'urukiiko. Galiyo we ntihagira ico abyitaho.<verse eid="ACT 18:17" /></para>
  <para style="s">Pawulo Asubira Antiyokiya</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Pawulo amaze igihe ari na bo, aseezera ku bavandimwe afata ubwato aja muri Siliya. Purisikila na Akwila baramuherekeza. Ageze Kenkireya abanza kwiyogoshesha, kuko yari yararahiye indahiro<note caller="+" style="f"><char style="fr" closed="false">18:18 </char><char style="ft" closed="false">Wari umugenzo w'Abayuuda wo kwerekana ko yubahirije indahiro.</char></note>. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Bageze muri Efeeso, Pawulo asiga bagenzi be aho, abanza kuja mu sinagoogi agirirayo ibiganiiro n'Abayuuda. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Baamusabye kuhamara igihe kireekire na bo, arabangira, <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />ahuubwo abaseezeraho ababwira ati, “<note caller="+" style="f"><char style="fr" closed="false">18:21 </char><char style="ft" closed="false">Mu bindi byanditswe byera bya kare havuga hati, </char><char style="fqa" closed="false">Uko biri koose ibihe by'ibirori bigomba kunsanga i Yerusaalemu, ariko.</char></note>Nzaagaruka Imaana niibishaaka.” Afata ubwato ava Efeeso.<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />Ageze i Kayisaariya, arazaamuka aja i Yerusaalemu kuramutsa ab'Itoorero, haanyuma aja Antiyokiya. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />Amazeyo igihe kireekire, avayo anyura mu myanya itari imwe n'imwe mu gice c'i Galatiya na Furugiya abwira abiizeera amagambo yo kubakomeza.<verse eid="ACT 18:23" /></para>
  <para style="s">Ubuheereza bw'Apolo</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Umuyuuda ukomooka Alekizanduriya wiitwa Apolo agera Efeeso. Yari umugabo uzi kuvuga kandi azi neeza ibyanditswe byera. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Yari yariigiishijwe Inzira ya Nyagasani, afite umwete kandi akiigiisha neeza ibyerekeye Yesu uko biri, n'ubwo we yari azi umubatizo wa Yohaana wonyine. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Atangira kuvugira mu masinagoogi ashize amanga, maze Purisikila na Akwila bamwumvise bamujaana iruhande bamusobaanurira neeza Inzira y'Imaana nyaayo. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />Haanyuma Apolo ashaatse kwambuka ngo aje Akaya, abavandimwe bamubwira amagambo amukomeza nuuko bandikira abiizeera babasaba kumwakiira neeza. Agezeyo, afasha caane abaari baarabaaye abiizeera ku bw'ubuntu bw'Imaana. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Kuko yahakanyaga Abayuuda n'imbaraga muruhame, abahamiriza mu byanditswe byera ko Yesu ari we Kristo.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">Pawulo Ari mu Efeeso</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Igihe Apolo yari i Korinto, Pawulo yanyuze mu bihugu byo hagati agera Efeeso, aho yasanze bamwe mu biigiishwa. <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />Arababaza ati, “Mbese mwakiiriye Umwuka Weera igihe mwizeeraga?” Baramusubiza bati, “Oya, habe no kumenya ko hariho Umwuka Weera!”<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />Pawulo ni ko kubabaza ati, “Mwabatijwe mubatizo ki?” Baramusubiza bati, “Twabatijwe umubatizo Yohaana yiigiishaga.”<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:4 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:11">Mat 3:11</ref>; <ref loc="MRK 1:4">Mar 1:4</ref>,<ref loc="MRK 1:7">7</ref>,<ref loc="MRK 1:8">8</ref>; <ref loc="LUK 3:4">Luk 3:4</ref>,<ref loc="LUK 3:16">16</ref>; <ref loc="JHN 1:26">Yoh 1:26</ref>,<ref loc="JHN 1:27">27</ref>.</char>
    </note>Pawulo ati, “Yohaana yabatizaga umubatizo wo kwihana, agasaba abantu kwemera uwari ugiiye kuuza nyuma ye, ari we Yesu.”<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />Bamaze kumva ibyo, babatizwa mu izina ry'Umwami Yesu. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Pawulo amaze kubarambikaho ibiganza, Umwuka Weera abaazaho, bavuga mu ndimi zitandukanye kandi barahanuura. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Boose hamwe baari nk'abantu cumi na babiri.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Pawulo yinjira mu isinagoogi y'Abayuuda, kandi akomeza kujayo kumara ameezi atatu, avuga ashize amanga, aja impaka n'abantu abeemeza ibyerekeye Ubwami bw'Imaana. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Ubwo bamwe muri bo biinangiye umutima bakanga kwizeera, bakavuga naabi Inzira ya Nyagasani imbere y'abantu, abavamo. Ahitamo kujaana n'abiizeera akaja abiigiishiriza buri munsi mu gisenge kinini co Tirano yiigiishirizagamo. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Ibi byakomejemo kumara imyaka ebyiri ari kwigiisha, maze ijambo rya Nyagasani rimenywa mu Bayuuda no mu Bagiriki batuuye muri Asiya.<verse eid="ACT 19:10" /></para>
  <para style="s">Abahungu ba Sikewa</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />Imaana ikora ibitangaaza bikomeye, inyuze muri Pawulo, <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />ku buryo ubutambaaro n'itaburiya byabaga bikoze ku mubiri we, byakozwaga ku barwayi, bagakira, kandi n'abadayimooni bakabavamo. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />Nuuko Abayuuda bamwe baazereeraga mu bihugu bagerageza kwirukana imyuka mibi mu izina rya Yesu muri abo bateewe na yo, bakavuga bati, “Ndabiirukanye mu izina rya Yesu uwo Pawulo yaamamaza.” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />Abahungu barindwi ba Sikewa, wari Umuheerezabitambo mukuru ni bo baabikoraga.<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />Maze wa mwuka mubi<note caller="+" style="f"><char style="fr" closed="false">19:15 </char><char style="ft" closed="false">Dayimooni</char></note> urabasubiza uti, “Yesu ndamuuzi, na Pawulo ndamuuzi, noone mwe muri ba nde?”<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />Bityo uwo muntu uteewe na dayimooni arabasimbukira boose, abarusha imbaraga arabaneesha abagirira naabi kugeza ubwo bavuuye mu nzu biiruka bahungira hanze bambaye ubusa kandi bafite ibikomere. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />Ibyo bimenyekanye mubatuuye Efeeso boose, hari Abayuuda n'Abagiriki bagira ubwoba, nuuko izina ry'Umwami Yesu rirasingizwa. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Abenshi mu baari bamaze kwemera, baatura kumugaragaro ibyaha byabo n'imigenzo baakoraga. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Abenshi baakoraga iby'ubukonikoni bakungaanya ibitabo byabo babitwikira mu ruhame. Babaze ibiciiro byabyo basanga bingana ibiceri by'ifeeza ibihumbi mirongo itaanu. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Nuuko ijambo ry'Imaana rikomeza gushinga imizi ihamye no kwamamara.<verse eid="ACT 19:20" /></para>
  <para style="s">Abacuzi bo muri Efeeso Bananiza Pawulo</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Nyuma y'ibyo, Pawulo yiigiira inaamayo kunyura i Makedooniya no muri Akaya akaja i Yerusaalemu. Aravuga ati, “Niimara kujayo, nkwiriye no kugera i Rooma.” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Atuma muri Makedooniya babiri mu bafasha be, ari bo Timoteeyo na Erasito, ubwo we asigara muri Asiya amarayo umwanya.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />Ico gihe, habaho imidugararo myinshi mu Efeeso ishingiye ku Nzira ya Nyagasani. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Umugabo wiitwa Demetiriyo wacuraga udushushanyo tw'ifeeza tw'ingoro y'ikigirwamaanakazi Aritemi, we n'abakozi be bungukiraga byinshi muri uwo mwuga. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />Abo abakungaanyiriza hamwe n'abandi baakoraga uwo mwuga, arababwira ati, “Mwa bagabo mwe, muzi yuuko inyungu zaacu ziva muri ubu bucuruuzi. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Mumaze no kumenya ko atari mu Efeeso honyine, ahuubwo no muri Asiya hoose, uwo Pawulo amaze koosha rubanda rwose, ababwira ko imaana zaaremwe n'abantu atari imaana nyakuri. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Akaaga si uko ubucuruuzi bwacu bwagwa byonyine, ahuubwo n'uko ingoro y'imaanakazi yaacu ikomeye Aritemi yaasuuzugurika. Kandi n'imaanakazi yaacu igata agaciiro kandi ari yo isengwa n'abanya Asiya ndetse n'abantu b'isi yoose.”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />Babyumvise, bagira umujinya mwinshi, batangira guteera heejuru bati, “Aritemi y'Abanyefeeso irakomeye!” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Itawuni yoose yuuzuramo akajagaari, abantu batangira kwirukira mu nzu beerekaniramo imikino, bakururamo Gaayo na Arisitariko Abanyamasedoniya baagendanaga na Pawulo. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Pawulo na we yashaakaga kuja kwiroha muri abo bantu, ariko abiizeera ntibaamukundira. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Ndetse bamwe mu bategetsi bo muri Asiya baari inshuti ze bamwoherereza ubutumwa bamusaba kudahinguka muri uwo mwanya abantu baari bateeraniyemo. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />Bamwe baasakuzaga bavuga ikintu kimwe abandi bakavuga ikindi, kuko iryo teeraniro ryose ryari mu rujijo. Abenshi muri bo nti baari baazi igitumye bateerana. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Bamwe muri rubanda bakeeka ko Alekizanda uwo Abayuuda baari basunikiye imbere y'iteeraniro ariwe nyirabayaazana. Nuuko Alekizanda ashira heejuru ukuboko kugira ngo baceceke, agerageza gusobaanurira abantu. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Ariko abantu bamaze kumenya ko ari Umuyuuda, bamara amasaaha abiri bateera heejuru bayombera icaarimwe bati, “Aritemi y'Abanyefeeso irakomeye!”<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />Umutegetsi w'itawuni acecekeesha abantu, arababwira ati, “Yemwe bantu bo muri Efeeso, n'inde muri mwe utaazi ko itawuni y'Abefeeso ari yo murinzi w'ingoro ya Aritemi ukomeye kandi ko igishushanyo ce caamanutse mu ijuru? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Ubwo reero ari nta waahakana ibi, mugomba gutuuza mukareka guhubuka. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Muzanye aha aba bantu batari abajuura bo mu ngoro cangwa abasebya imaana yaacu<note caller="+" style="f"><char style="fr" closed="false">19:37 </char><char style="ft" closed="false">Bimwe mu byanditswe bya kare havuga hati, Imaana yaanyu </char></note>. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Noone reero niiba Demetiriyo n'abacuzi bafite uwo barega, inkiiko zirahari kandi n'abacaamanza nti babuze, ni babigaragaze baburane. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Niiba hari ikindi mushaaka kumenya, kizaatunganyirizwa mu rukiiko rusanzwe. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Ubu turi mu kaaga ko kuregwa ku bw'iyi myigaragambyo, kuko ari nta mpamvu twagaragaza yatumye dukora ibi.” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Amaze kuvuga atyo, aseezera rubanda.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">Pawulo aja i Makedooniya n'i Bugiriki</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Imidugararo irangiye, Pawulo atumaho abiizeerwa, amaze kubabwira amagambo yo kubakomeza no kubaseezeraho, aja i Makedooniya. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />Amaze kunyura muri ibyo bice no kubwira abiizeera amagambo yo kubakomeza, aja i Bugiriki <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />aho yamaze ameezi atatu. Igihe yashaatse gufata ubwato ngo aje muri Siriya, ni bwo yamenye ko Abayuuda bafite imigambi yo kumwica, nuuko ahitamo gusubirayo anyuze i Makedooniya. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />Muri urwo rugendo, yari aherekejwe na Sopatero mwene Puro uva i Beroya, Arisitariko, Sekundo uva i Teesalonike, Gaayo uva i Derubi, Timoteeyo hamwe na Tukiko na Turofimo uva muri Asiya. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Baatubanjirije imbere, badutegerereza i Tiirowa. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />Ariko twe dufata ubwato tuva i Filipi nyuma y'iminsi mikuru y'Imigaati Idasembuwe kandi mu minsi itaanu tubasanga i Tiirowa aho twacumbitse kumara iminsi irindwi.<verse eid="ACT 20:6" /></para>
  <para style="s">Pawulo Azuura Umusore Wagize Impanuka</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Ku munsi wa mbere w'icumweru, ubwo twateeraniye hamwe ngo dusangire umugaati, Pawulo yari akigaaniira n'abiizeera kugeza mu gicuku kuko yari bugende bukeeye. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Mu gisenge co heejuru aho twari duteeraniye haari amataara menshi. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Umusore wiitwa Ewutiko yari yiicaye mu dirisa maze afatwa n'ibitotsi. Pawulo akomeza kugaanira. Ewutiko aganzwa n'ibitotsi maze amanuka ku gorofa ya gatatu yituura haasi, basanga amaze gupfa nuuko baramuterura. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />Pawulo aramanuka, amwubarara heejuru, amufata amaboko maze aravuga ati, “Nti mugire ubwoba, ni muzima.” <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Birangiye, Pawulo asubira mu gisenge co heejuru. Amanyura umugaati ararya nuuko akomeza kubagaaniirira kugeza mu gitondo, aragenda. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Nuuko uwo musore bamujaana mu rugo ari muzima bibasubizamo imbaraga caane.<verse eid="ACT 20:12" /></para>
  <para style="s">Pawulo ava i Torowa aja i Mileto</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />Twebwe dufata ubwato tugenda mbere twerekeza ahiitwa Aso, aho twari dukwiriye guhuurira na Pawulo. We yari yagennye kujayo anyuze inzira y'ubutaka. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Adusanze Aso, tumushira mu bwato, tuja i Mituleene. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Bukeeye, tuja mu bwato tugera ahateeganye n'i Kiyo. Umunsi ukurikiraho turambuka tugera i Samo, maze bukeeye bwaho tugera i Mileto. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Pawulo yari yagennye gukomezamo n'ubwato atanyuze Efeeso kugira ngo adatinda muri Asiya. Yari afite ubwira bwo kugera i Yerusaalemu, bishobotse ku munsi wa Pentekooti.<verse eid="ACT 20:16" /></para>
  <para style="s">Pawulo Aseezera Abakuru bo muri Efeeso</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Ari i Mileto, Pawulo yoohereza ubutumwa muri Efeeso asaba kugira urukiiko n'abakuru itooreero. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Baaje, arababwira ati,</para>
  <para style="p" vid="ACT 20:18">“Mwe ubwanyu muuzi uko nabanye namwe igihe coose kuva naagera muri Asiya, <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />nkorera Uhoraho niiciishije bugufi, ndira, niihangaanira ibigeragezo biteewe n'imigambi mibi y'Abayuuda. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />Ntaaco niigeze nsiga inyuma mu byo nari nkwiriye kubabwira byabagirira akamaro, mu kubwiriza ubutumwa no kubiigiisha rwatu, mva ku nzu nja ku yindi, <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />ntanga ubuhamya mu Bayuuda no mu Bagiriki bwo kwihanira Imaana no kwizeera Umwami waacu Yesu. <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />Noone ubu ngiiye i Yerusaalemu mbibwirijwe n'Umwuka<note caller="+" style="f"><char style="fr" closed="false">20:22 </char><char style="ft" closed="false">Cangwa ngo, </char><char style="fqa" closed="false">Booshwe mu by'Umwuka</char></note>, sinzi ibizambaho ngezeyo, <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />uretse ko Umwuka Weera agenda anyemeza muri buri tawuni yuuko gufungwa no gutootezwa bintegereje. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" /><note caller="-" style="x"><char style="xo" closed="false">20:24 </char><char style="xt" closed="false"><ref loc="2TI 4:7">2 Tim 4:7</ref>.</char></note>Ariko ku bwanje, siniita ku bugingo ngo niibwire ko ari ubw'agaciiro kuri nje. Ica ngombwa ni ukurangiza urugendo rwanje n'ubuheereza nahaawe na Yesu Kristo, bwo guhamya Ubutumwa Bwiza bw'ubuntu bw'Imaana.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />Kandi ubu nzi neeza ko muri mwese abo nanyuzemo naamamaza Ubutumwa bw'ubwami bw'Imaana mutazongera kumbona ukundi.<verse eid="ACT 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 20:26" />Ni co gituma mbahamiriza uyu munsi ko amaraso yaanyu mwese atazambarwaho, <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />kuko ntiigeze mbahisha imigambi yoose y'Imaana. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />Mwirinde ubwanyu, kandi murinde n'umukumbi woose mwaragijwe n'Umwuka Weera kandi muragire itoreero ry'Imaana yacunguje amaraso y'Umwana waayo. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Nzi yuuko niimara kugenda, imisega ifite ubukana izaabaazamo, ntiibabarire umukumbi w'Imaana. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Kandi bamwe bo muri mwe bazaagoreka ukuri kugira ngo baryosharyoshe abiizeera ngo babakurikire. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Mube maaso reero, mwibuke ko imyaka itatu namaze ntiigeze gutuuza kwigiisha buri umwe ijoro n'amanywa kandi ndira.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />Ubu reero mbaragije Imaana n'ijambo ry'ubuntu bwayo, ari ryo rishobora kubuubaka no kubaha umurage w'imigisha n'abo beejejwe boose. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />Ntaakintu c'umuntu weese niigeze ndarikira, ari ifeeza cangwa izaahabu cangwa imyambaro. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Murabiizi namwe ubwanyu ko nakoreeshaga amaboko yanje gushaakiisha uko naabaho na bagenzi banje. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />Muri byose nababeereye intangarugero, mbeereka ko mu mirimo nk'iyo twafasha abatiishoboye, twibuka amagambo y'Umwami Yesu yavuze ati, ‘Gutanga biheesha umugisha, kuruta kwakiira.’ ”<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Arangije kuvuga ibyo, apfukama na bo boose, arasenga. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Boose bararira caane, baramuhoobera kandi baramusoma, <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />na caane baagize agahinda ku bwo ibyo yari amaze kuvuga ko batazongera kumubona. Nuuko baramuherekeza bamugeza ku bwato.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">Pawulo Aja i Yerusaalemu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Tumaze gutandukana na bo tuja mu bwato. Dukomerezamo kimwe tuja i Kosi. Umunsi ukurikiyeho, tuja i Roode, tuvuuyeyo tuja i Patara. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Tuhasanze ubwato bwendaga kuja i Fenikiya, tubujamo buratujaana. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Tubona i Kupuro, tuhasiga ibumoso bwacu tugana i Siriya duhagarara i Tiiro, kuko ari ho bagombaga gupakururira imitwaro yari mu bwato. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Twashaatse abiizeera turababona maze tuhamara na bo iminsi indwi. Abo biigiishwa bayobowe n'Umwuka Weera babuza Pawulo gukomezamo urugendo rwo kuja i Yerusaalemu. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Iyo minsi yo kubaana na bo ishize, turahava dukomezamo urugendo. Nuuko boose n'abagore baabo hamwe n'abaana baraduherekeza batugeza haakurya y'i tawuni nkuru. Dupfukama aho ku nkengeero y'inyanja turasenga, <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />haanyuma duseezeranaho. Duheerako twinjira mu bwato naho bo basubira iwaabo.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />Turangije urugendo rwo kuva i Tiiro, tugera i Putolemayi turamukanya n'abiizeera twahasanze maze ducumbikayo kumara umunsi umwe. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" /><note caller="-" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="ACT 6:5">Iby 6:5</ref>; <ref loc="ACT 8:5">8:5</ref>.</char></note>Bukeeye tuvayo tugera i Kayisaariya, maze tuja mu rugo rwa Filipo umwe mu bavugabutumwa barindwi, nuuko ducumbikayo. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Yari afite abakobwa bane ba baari, baari bafite impaano yo guhanuura. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" /><note caller="-" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="ACT 11:28">Iby 11:28</ref>.</char></note>Tuhamaze iminsi, haaza umuhanuuzi wiitwaga Agabo avuuye i Yudeeya. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Ageze aho turi afata umukenyezo wa Pawulo, awibohesha ibirenge n'amaboko, maze aravuga ati, “Umwuka Weera aravuga ati, ‘Uku ni ko Abayuuda bazaaboha nyir'uyu mukenyezo nuuko bamushikirize abanyamahanga.’ ”<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />Tubyumvise, twe hamwe n'abantu baari aho tubuza Pawulo kuja i Yerusaalemu. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />Maze Pawulo arasubiza ati, “Ikibateera kurira no kunshengura umutima n'iki? Kuko siniiteeguye kubohwa gusa, ahuubwo no gupfiira i Yerusaalemu nzira izina ry'Umwami Yesu.”<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />Tuboonye ko Pawulo amaramaje kugenda kandi ko tutagishoboye kumuhendahenda, turamwihorera tugira tuti, “Bibe uko Nyagasani ashaaka.”<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Nyuma y'iyo minsi duteguura ibyacu, dutangira urugendo tugana i Yerusaalemu. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Bamwe mu biizeera bava i Kayisaariya na bo baazana naatwe batujaana kwa Munasoni w'i Kupuro wari umwizeera kuva kare, aho twagombaga gucumbika.<verse eid="ACT 21:16" /></para>
  <para style="s">Pawulo Aja Gusuura Yaboko i Yerusaalemu</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Tugeze i Yerusaalemu, abavandimwe batwakiira n'urugwiro. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Bukeeye tujaana na Pawulo gusuura Yaakobo, kandi bakuru b'imiryango boose baari bahari. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Pawulo arabaramutsa, arangije atangira kubateekerereza byose Imaana yamushoboje gukorera mu banyamahanga mu buheereza bwe ari nta co asiga inyuma. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />Babyumviise, bahimbaaza Imaana. Baramubwira bati, “Muvandimwe, urabona ko Abayuuda benshi bamaze kuba abiizeera, kandi koboose bafite umwete wo kuzirikana amategeko. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />Baamaze kumva ibigufasheho, ko wiigiisha Abayuuda batuuye mu banyamahanga kureka gukurikiza amategeko ya Moose, ngo begukeba abaana baabo, no kudakurikiza n'indi migenzo yoose y'Abayuuda. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Noone tugire dute? Ko byaja kubageraho ko waaje. <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />Ubu reero ugiiye gukurikiza ibyo turibukubwire. Dore dufite abagabo bane baahize umuhigo. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Biiyungeho, unyure mu muhango wo kwezwa hamwe na bo, kandi wiishurire koogosha imisatsi yaabo. Nuuko boose bamenye ko ibyo baakumviiseho bidafite ishingiro kandi ko naawe ubwawe wuubahiriza kandi ugakurikiza amategeko. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" /><note caller="-" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ACT 15:29">Iby 15:29</ref>.</char></note>Ariko ku banyamahanga baamaze kuba abiizeera, twohereje urwandiko rwerekana iceemezo caacu, ko bakwiriye kwirinda kurya ibituuwe ibigirwamaana, kurya amaraso no kurya inyamaaswa zinizwe, hamwe no kwirinda ubusambanyi.”<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />Nuuko Pawulo ajaana abo bagabo, umunsi ukurikiyeho amaze kwiyeza, yinjirana na bo mu Nzu y'Imaana kumenyeesha igihe iminsi yo kwezwa izaashirira, ari bwo igitambo ca buri weese kizatambirwaho.<verse eid="ACT 21:26" /></para>
  <para style="s">Pawulo Afatirwa mu Nzu y'Imaana</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Iminsi indwi iri bugufi kurangira, Abayuuda baturuka Asiya baari baaboonye Pawulo mu Nzu y'Imaana babyutsa agasasamaro muri rubanda. Baramufata, <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />bateera heejuru bavuga bati, “Yemwe b'Isirayeli mwe, ni mudutabaare! Uyu ni wa mugabo ugenda yiigiisha hoose abantu boose arwanya abantu baacu, amategeko yaacu n'uyu mwanya. Uretse n'ibyo, dore yazanye n'Abagiriki mu Nzu y'Imaana, guhumaanya aha hantu heera.” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" /><note caller="-" style="x"><char style="xo" closed="false">21:29 </char><char style="xt" closed="false"><ref loc="ACT 20:4">Iby 20:4</ref>.</char></note>Ibi baabivuze kuko baari baaboonye Tiirofimo Umunyefeeso ari hamwe na Pawulo mu tawuni nkuru nuuko biibwira ko yamuzanye mu Nzu y'Imaana.<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />Haba agasasamaro mu tawuni nkuru hoose, maze abantu biirukankira gukoranira hamwe. Bafata Pawulo bamukurubana bamuvaana mu Nzu y'Imaana, ako kaanya inzuugi barazikinga. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Bakigerageza kumwica, inkuru igera ku mutware w'ingabo z'abasirikare yuuko hari imidugararo i Yerusaalemu hoose. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />Ako kaanya ajaana abasirikare n'abatware baabo bariiruka bagana aho ico giteero c'abantu kiri. Abo bantu baboonye Abasirikare n'abatware baabo, barekeraho gukubita Pawulo. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />Umutware w'abasirikare araaza afata Pawulo, maze ategeka ko bamuboheesha injegeri ebyiri. Arangije abaza abantu uwo ari we n'ico bamuryoza. <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Bamwe muri rubanda bateera heejuru bamusubiza kimwe abandi ikindi nuuko ntihaagira ico yumva ku bw'urusaku rw'abantu, ni ko gutegeka ko bajaana Pawulo mu kigo c'abasirikare. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Pawulo ageze ku madaara, abantu baari buuzuye uburaakari bituma abasirikare bamuterura. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Rubanda baari babakurikiye bateeraga heejuru bavuga bati, “Ni mumwice!”<verse eid="ACT 21:36" /></para>
  <para style="s">Pawulo Yireguura</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Bari haafi kugeza Pawulo mu kigo c'abasirikare, abwira umutware waabo ati, “Mbese ngire ico nkubwira?” Umutware w'abasirikare aramubaza ati, “Uzi Urugiriki?<verse eid="ACT 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 21:38" />Noone ntaabwo uri wa Munya Igiputi uheruutse kuyobora agatsiko k'abicanyi ibihumbi bine kuja mu butaayu?”<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />Pawulo aramusubiza ati, “Ndi Umuyuuda, uva i Taruso y'i Silisiya, umutuurage w'itawuni nkuru ikomeye, ndakwinginze, mpa ijambo hagire ico mbwira aba bantu.”<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />Amwemereye kuvuga, Pawulo ahagarara ku madaara areeba abantu, arambuura ukuboko ngo baceceke. Bamaze guceceka, avugana na bo mu Ruheburayo.<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />Pawulo atangira avuga ati, “Bavandimwe kandi babyeyi, nimwumve uko niireguura imbere yaanyu.”<verse eid="ACT 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2" />Bumviise avugana na bo mu Ruheburayo<note caller="+" style="f"><char style="fr" closed="false">22:2 </char><char style="ft" closed="false">Cangwa Arameyiki</char></note>, bacecekera kimwe. Nuuko akomeza kuvuga ati,<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:3 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 5:34-39">Iby 5:34-39</ref>.</char>
    </note>“Ndi Umuyuuda, ukomooka i Taruso y'i Silisiya, ariko nakuriye muri iyi tawuni niigiishwa na Gamaliyeli, ntoozwa gukurikiza amategeko ya ba sogokuruza yoose, mfite umwete wo gukorera Imaana, nk'uko namwe mumeze uyu munsi. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" /><note caller="-" style="x"><char style="xo" closed="false">22:4 </char><char style="xt" closed="false"><ref loc="ACT 8:3">Iby 8:3</ref>; <ref loc="ACT 26:9-11">26:9-11</ref>.</char></note>Narenganyije abiizeera Kristo kugeza ku gupfa kandi mboha abagore n'abagabo, mbashira no mu gihome. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />Abaheerezabitambo bakuru n'abakuru b'urukiiko boose baabibahamiriza kuko ari bo bampaaye inzandiko zandikiwe abavandimwe b'i Damasiko, nuuko njayo kugira ngo mbohe abo baariyo mbaazane i Yerusaalemu bahanwe.<verse eid="ACT 22:5" /></para>
  <para style="s">Ubuhamya bwo Guhindurwa kwa Pawulo</para>
  <para style="r">(<ref loc="ACT 9:1-19">Iby 9:1-19</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />Igihe nari nkiri mu nzira ndi haafi kugera i Damasiko, kumanywa nka saaha itandatu haaza umuco w'imbaraga uturutse mu ijuru urangota. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Niikubita haasi maze numva ijwi rimbwira riti, ‘Sawuli, Sawuli, ni kuki untooteza?’ <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />Ndasubiza nti, ‘Uri nde, Nyagasani?’ Aransubiza ati, ‘Ndi Yesu w'i Nazaareeti uwo utooteza.’ <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Abaari hamwe nanje babona uwo muco ariko ntibumva ijwi ry'uwavuganaga nanje. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />Ndamubaza nti, ‘Nkore iki Nyagasani?’ Aransubiza ati, ‘Haguruka uje i Damasiko, ni ho uzaabwirwa ibyo ugenewe gukora.’ <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />Kuko uwo muco mwinshi wari wampumishije amaaso, abaari hamwe nanje barandandata bangeza i Damasiko.<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />Umugabo wiitwaga Ananiya, wuubahaga Imaana nk'uko amategeko abisaba kandi agashimwa n'Abayuuda boose baari bahatuuye, <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />aza aho ndi, ampagarara iruhande, maze aravuga ati, ‘Mwene daata Sawuli, ongera ureebe!’ Ako kaanya ndahumuuka maze ndamureeba. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />Nuuko arambwira ati, ‘Imaana ya ba sogokuruza yagutooranyije kugira ngo umenye ubushaake bwayo, no kubona Intungaane yaayo kandi ngo wiiyumvire ijwi ryayo, <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />kuko uzaayibeera umuhamya mu isi yoose w'ibyo wumviise n'ibyo waboonye. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Noone se kandi utegereje iki? Haguruka, wambaze izina rya Nyagasani, ubatizwe, kandi uhanagurweho ibyaha byawe.’<verse eid="ACT 22:16" /></para>
  <para style="s">Pawulo Yooherezwa mu Banyamahanga</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />Maze gusubira i Yerusaalemu, ndi mu Nzu y'Imaana nsenga, mera nk'uroota <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />nuuko mbona Yesu, ambwira ati, ‘Tebuuka uve i Yerusaalemu vuba, kuko batazeemera ubuhamya untangaho.’ <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />Nanje ndavuga nti, ‘Nyagasani, bo ubwabo baazi ko najaga mu masinagoogi yoose mpfunga kandi nkubita abakwizeera. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" /><note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="ACT 7:58">Iby 7:58</ref>.</char></note>Ndetse n'igihe amaraso y'umuhamya waawe Sitefaano amenwa, nari mpahagaze, nshigikira ico gikorwa, ndetse ndinda imyambaro y'abamwishe.’ <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />Nyagasani aransubiza ati, ‘Genda, kuko nzaagutuma kure mu banyamahanga.’ ”<verse eid="ACT 22:21" /></para>
  <para style="s">Pawulo Akira Gukubitwa</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Kugeza ubu abantu baari baakomeje gutega amatwi Pawulo, nuuko bateera induuru bati, “Uwo ni akurwe ku isi! Umuntu nk'uwo ntaabwo akwiriye kubaho.” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />Mu guteera induuru, baateereraga imyambaro yaabo heejuru, bagatuumuurira umucuucu mu kireere. <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />Umutware w'abasirikare ategeka ko bamujaana mu kigo c'abasirikare nuuko abategeka kumutata bamukubita, kugira ngo bamenye impamvu nyaayo iteera rubanda kumuteerera induuru. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Ariko bamaze kumuboheesha imigozi, Pawulo abwira umutware utegeka abasirikare ijana wari uhagaze aho ati, “Mbese byemewe n'amategeko gukubita umuturage w'i Rooma ataraatsindwa n'urubanza?”<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />Umutware utegeka abasirikare ijana yumviise ibyo, aja kubwira mukuru w'abasirikare ati, “Ibyo ugiiye gukora ni ibiki? Uyu mugabo n'Umurooma.”<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />Wa mukuru w'abasirikare yeegeera Pawulo aramubaza ati, “Mbwira, mbese uri Umurooma?”</para>
  <para style="p" vid="ACT 22:27">Pawulo aramusubiza ati, “Ndi we.”<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />Mukuru w'abasirikare aramusubiza ati, “Byanjanye amashilingi menshi kugira ngo mbone ubwenegihugu bw'i Rooma.”</para>
  <para style="p" vid="ACT 22:28">Pawulo aramusubiza ati, “Njeewe, navukanye ubwenegihugu bw'i Rooma.”<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />Ako kaanya abaari bashaaka kumutata baramureka, mukuru w'abasirikare na we agira ubwoba kuko yari amaze kumenya ko Pawulo ari Umurooma akaba yaamuboshe.<verse eid="ACT 22:29" /></para>
  <para style="s">Pawulo Imbere y'Urukiiko</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Kuko umutware w'abasirikare yashaakaga kumenya ico Abayuuda baaryozaga Pawulo, bukeeye amukuuraho injegeri, ategeka abatware b'abaheerezabitambo n'abagize urukiiko rwose guhuura. Azana Pawulo amuhagarika imbere yaabo.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Pawulo atumbiira abagize urukiiko, maze arababwira ati, “Beene daata, kugeza n'uyu munsi, nta co umutima wanje unshinja imbere y'Imaana mu buzima bwanje bwose.” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />Nuuko Ananiya Umuheerezabitambo mukuru abyumviise, ategeka abaari bahagaze iruhande rwa Pawulo kumukubita urushi ku munwa. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" /><note caller="-" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="MAT 23:27">Mat 23:27</ref>,<ref loc="MAT 23:28">28</ref>.</char></note>Pawulo ni ko kumusubiza ati, “Imaana izaagukubita urushi wa ndyarya we! Mbese wiicaye aho kunshiira urubanza ukurikije amategeko, kandi ukayiica utegeka ko bankubita urushi?”<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />Abaari bahahagaze baramubaza bati, “Uri gutuka Umuheerezabitambo mukuru w'Imaana?”<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />Pawulo arasubiza ati, “Bavandimwe, sinamenye ko ari Umuheerezabitambo mukuru, kuko byanditse ngo, ‘Ntukavuge naabi umutware w'ubwoko bwawe.’ ”<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:6 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 26:5">Iby 26:5</ref>; <ref loc="PHP 3:5">Fil 3:5</ref>.</char>
    </note>Pawulo amenye ko mu baari aho haarimo Abasadukaayo kandi abandi ari Abafarisaayo, avugira imbere y'urukiiko aranguruye ati, “Bavandimwe, ndi Umufarisaayo, umwana w'Abafarisaayo. Ndi hano mu rubanza mpoorwa kwiringira yuuko hari izuuka ry'abaapfuuye.”<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />Amaze kuvuga ibi, habaho kutumviikana hagati y'Abafarisaayo n'Abasadukaayo maze iteeraniro ryigabamo ibice. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" /><note caller="-" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="MAT 22:23">Mat 22:23</ref>; <ref loc="MRK 12:18">Mar 12:18</ref>; <ref loc="LUK 20:27">Luk 20:27</ref>.</char></note>Abasadukaayo bavuga ko ari nta zuuka ry'abaapfuuye ribaho, nta n'abaamalayika cangwa umwuka ubaho, ariko Abafarisaayo bo biizeera ko ibyo bitatu bibaho. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />Hakomeza kubaho kuyomba caane, nuuko bamwe mu biigiishamategeko b'Abafarisaayo barahaguruka barabyemeza bati, “Nta kibi tuboonye kuri uyu muntu. Noone se niiba umwuka cangwa malayika yavuganye na we?”<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />Izo mparana ko zaakomeje gukomera, mukuru w'abasirikare atiinya ko abantu bashobora gutanyaguza Pawulo nuuko ategeka abasirikare kumanuka bakamuvaana muri abo bantu ku gahato bakamujaana mu kigo c'abasirikare.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />Muri iryo joro, Nyagasani ahagarara iruhande rwa Pawulo aramubwira ati, “Komera ushikame! Uko umaze guhamya ibyanje i Yerusaalemu ni ko ugomba kubikora n'i Rooma.”<verse eid="ACT 23:11" /></para>
  <para style="s">Abayuuda Baja Umugambi wo Kwica Pawulo</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Bukeeye, Abayuuda bamwe bahuuza umugambi, barahira ko batazaagira ico barya cangwa ico banywa batabanje kwica Pawulo. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Abantu basaaga mirongo ine ni bo baari bagamije kutiica uyu mugambi. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />Baja ku batware b'abaheerezabitambo n'abakuru b'imiryango barababwira bati, “Twarahiye twiyemeza kutagira ico dukoza mu kanwa tutabanje kwica Pawulo. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Noone reero, mwebwe hamwe n'abagize urukiiko mugomba kumenyeesha mukuru w'abasirikare kubazanira Pawulo, nk'aho hari ibindi mushaaka kumucondoozaho. Naatwe turaba twiteguye kumwica mbere yuuko abageraho.”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />Mwishwa wa Pawulo yumviise uwo mugambi wo gutega Pawulo bakamwica, ni ko kuja mu kigo c'abasirikare abwira Pawulo ibyo yumviise. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />Pawulo na we ahamagara umwe mu batware bategeka abasirikare ijana aramubwira ati, “Uyu musore mujaanire mukuru w'abasirikare, kuko hari ico ashaaka kumumenyeesha.” <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />Aramujaana, amugejejeyo abwira mukuru w'abasirikare ati, “Umusibe wiitwa Pawulo yampamagaye ansaba kukuuzanira uyu musore kuko afite ico ashaaka kukumenyeesha.”<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />Mukuru w'abasirikare afata uwo musore ukuboko, aramwihereerana, nuuko aramubaza ati, “Ni iki ushaaka kuumenyeesha?”<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />Uwo musore asubiza mukuru w'abasirikare ati, “Abayuuda baamaze kwemeranya ngo bagusabe kuuzana Pawulo mu rukiiko ejo, nk'aho bagiiye kumukoraho ubucondozi nyaabwo ngo bamenye ibye. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Ariko ibyo bidatuma bakwemeza, kuko abagabo basaaga mirongo ine bagamije kumutegera mu nzira bakamwica. Baarahiye ko bataziigera kugira ico barya cangwa ico banywa batari biica Pawulo. Ubu bariteeguuye kandi bategereje ko ubemerera.”<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />Mukuru w'abasirikare aseezerera uwo musore, amutegeka ati, “Nti hagire uwo ubwira ibyo umenyesheje.”<verse eid="ACT 23:22" /></para>
  <para style="s">Mukuru w'Abasirikare Atorotsa Pawulo</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />Mukuru w'abasirikare ahamagara abatware babiri bategeka baabasirikare ijana arababwira ati, “Mwiteguure kuva aha saaha itatu z'ijoro muje i Kayisaariya. Mugendane abasirikare magana abibiri, abanyamafarashi mirongo irindwi, hamwe n'ingabo magana abiri ziitwaje amacumu. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />Kandi muteguure amafarashi yo guheeka Pawulo, mumujaane, maze mumushikirize umutegetsi Felekisi amahoro.” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />Mukuru w'abasirikare yandika urwandiko avuga ati,<verse eid="ACT 23:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="ACT 23:26" />“Njeewe Kilawudiyasi Lusiya, ndakwandikira Nyakubahwa Felekisi, ndabaramutsa. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />Uyu mugabo nkoherereje yafashwe n'Abayuuda bashaaka kumwica, ariko menye ko afite ubwenegihugu bw'i Rooma, nzana n'abasirikare banje turamukiza. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Nshaatse kumenya ico bamuryoza, mujaana mu rukiiko rwabo. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />Nsanga bamurega impaka z'ibyerekeye amategeko yaabo, ariko nta kindi kintu na kimwe yakoze caatuma aciirwa urwo gupfa cangwa gusibwa. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Nyuma nza kubwirwa ko Abayuuda bafite umugambi wo kumwica, ni ko kumukooherereza. Ntegetse abamurega na bo kukugezaho ibirego byabo. [Nuuko murabeho<note caller="+" style="f"><char style="fr" closed="false">23:30 </char><char style="ft" closed="false">Bimwe mu byanditswe byera bya keera nti bongeraho uyu musoozo w'urwandiko.</char></note>.]”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />Bityo reero abasirikare babikora uko baategetswe, bajaana Pawulo muri iryo joro, bamugeza Antipatirida. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Umunsi wakurikiyeho basubira mu kigo c'abasirikare nuuko abatwaye amafarashi bo bakomezamo na Pawulo. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />Bageze i Kayisaariya, baha Umutegetsi Felekisi urwandiko, bamushikiriza na Pawulo. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Amaze gusoma urwandiko, Felekisi abaza Pawulo igice akomookamo, amenye ko ava i Silisiya, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />aravuga ati, “Ndumva ibyawe abakurega ni bamara kugera hano.” Ategeka ko arindirwa mu ngoro ya Herodi.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">Pawulo Aregwa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Hashize iminsi itaanu, Umuheerezabitambo mukuru wiitwa Ananiya agera i Kayisaariya, ari kumwe na bamwe mu bakuru b'imiryango, hamwe n'uwo kubaburanira wiitwaga Teritulo, babwira umutegetsi ibyo barega Pawulo. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Pawulo bamuzanye, Teritulo atangira kumurega avuga ati,</para>
  <para style="p" vid="ACT 24:2">“Nyakubahwa Felekisi, ni wowe dukeesha aya mahoro tumaze igihe kinini dufite, kandi n'ibyavuguruwe muri iki gihugu ni ku bw'umwete waawe wo kureeba ibiri imbere. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />Ibi tubyakiiza yombi aho turi hoose iminsi yoose kandi turabigushiimira caane. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Ariko ntakurambiye, ndakwinginze ngo utwihangaanire wumve ibyo tukubwira muri make nk'uko ubisanganywe. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />Uyu muntu twasanze ari icaago, kandi ari n'umunyarugomo mu Bayuuda boose ku isi yoose kandi ni we uyoboye agatsiko k'inyaduka z'aba Nazaareeti. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />Ndetse yagerageje guhumaanya Inzu y'Imaana nuuko turamufata. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />[<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="ft" closed="false">Bimwe mu byanditse byera bya keera nti bishiraho uyu murongo </char></note> Kandi twari dukwiriye kuba twaramuciriye urubanza twebwe ubwacu dukurikije amategeko, ariko umusirikare mukuru wiitwa Lusiya aza n'imbaraga aramutwaka. Ategeka abaamuregaga kwitaba imbere yaawe.] <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />Nuumara kumucondoza, ushobora kumenya neeza ibyo tumurega byose.” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />Abayuuda bafatanya na we mukurega Pawulo bahamya ko ibi byose ari ukuri.<verse eid="ACT 24:9" /></para>
  <para style="s">Pawulo Yiireguura Imbere ya Felekisi</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Umutegetsi Felekisi amaze kumureebura ngo agire ico avuga, Pawulo aravuga ati,</para>
  <para style="p" vid="ACT 24:10">“Biineejeeje kwireguura imbere yaawe kuko nzi neeza ko umaze imyaka myinshi uciira ab'iki gihugu imanza. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />Nk'uko ubwawe ushobora kumenya, nti haari haashira iminsi cumi n'ebyiri ngiiye kuramiriza i Yerusaalemu. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />Ntibiigeze basanga hari uwo tuja impaka mu Nzu y'Imaana cangwa ngo basange hari agasasamaro nteeza mu bantu bo mu masinagoogi cangwa mu tawuni nkuru yoose. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Kandi ntibashobora kuguhamiriza ibyo bandega aka kaanya. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />Nyamara ico neemera imbere yaawe, ni uko nkorera Imaana ya ba sogokuruza nkurikije Inzira aba biita agatsiko k'abaayobye, kandi nkaba niizeera ibyanditswe mu mategeko byose n'ibyanditswe n'abahanuuzi. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />Mfite ibyiringiro mu Maana, ibyiringiro byo na bo biizeera ko hazaabaho izuuka ry'abakiraanutsi n'abakiraanirwa. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Ni co gituma igihe coose mparanira kugira umutimanaama imbere y'Imaana n'imbere y'abantu.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:17 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 21:17-28">Iby 21:17-28</ref>.</char>
    </note>Nyuma yo kumara imyaka myinshi, nagarutse i Yerusaalemu nzaniye umuryango waacu imfashanyo z'abakene no gutamba ibitambo. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Igihe nari ngikora ibyo, bansanga mu Nzu y'Imaana maze kwihumaanura kandi ari ntaabantu benshi turi kumwe ntaan'agasasamaro kahari. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Ariko Abayuuda bamwe bava mu gice c'Asiya baariho mu Nzu y'Imaana, nibo baagombaga kuba bari hano imbere yaawe bakandega, niiba hari ico banshinja. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />Cangwa se aba bagabo bari aha ni bavuge icaaha bansanganye igihe mpagarara imbere y'urukiiko, <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" /><note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="ACT 23:6">Iby 23:6</ref>.</char></note>keretse niiba ari iri jambo navugiye imbere yaabo nti, ‘Ukuzuuka kw'abaapfuuye ni ko kunzanye imbere yaawe uyu umunsi.’ ”<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Nuuko Felekisi wari uzi neeza iby'iyo Nzira, asuubika urubanza avuga ati, “Lusiya mukuru w'abasirikare naaza, niho nzarangiza ibyanyu.” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />Ategeka umutware utegeka abasirikare ijana kuba ashize Pawulo mu gihome, ariko akamuha umudendeezo no kutabuza inshuti ze kuuza kumureebereera.<verse eid="ACT 24:23" /></para>
  <para style="s">Pawulo Imbere ya Felekisi na Durusira</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Hashize iminsi, Felekisi azana n'umugore we Durusira wari Umuyuudakazi, atumaho Pawulo maze yumviriza ibyo avuga bifashe ku kwizeera Kristo Yesu. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Kandi igihe yamugaaniriraga ibyerekeye ubutabeera, kwifata, hamwe n'ibyo guciirwa urubanza dutegereje, Felekisi agira ubwoba maze aramubwira ati, “Ba ugiiye, ninongera guteguuka, ndagutumaho.” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Icakora muri ibi byose, Felekisi yiringiraga ko ahaari Pawulo yamutugira, ni co caatumaga amutumishaho kenshi akaganiira na we.<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />Hashize imyaka ebyiri, umutegetsi Felekisi asimburwa na Porukiyo Fesito, kandi kuko Felekisi yashaakaga kuneezeeza Abayuuda, asiga Pawulo mu gihome.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">Pawulo Asaba Kujurira ku Mwami w'i Rooma</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Hashize iminsi itatu Fesito amaze kugera muri ico gice, ava i Kayisaariya aja i Yerusaalemu <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />aho abatware b'abaheerezabitambo hamwe n'abayobozi b'Abayuuda bamwanzuriye ibyo barega Pawulo. Binginga Fesito <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />bamusaba kubashiimiisha agategeka ko baazana Pawulo i Yerusaalemu. Baari bafite imigambi yo kumutegera mu nzira bakamwica. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />Fesito abasubiza ko Pawulo afungiwe i Kayisaariya, kandi ko we ubwe afite umugambi wo kujayo vuba. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />Yongera kubabwira ati, “Nooneho reero, reka abo muri mwe bafite ububaasha baaze tujaane, nuuko niiba hari urubanza afite, mumurege.”<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />Amaze kubaana na bo kumara iminsi umunane cangwa icumi, amanuka yeerekeza i Kayisaariya. Umunsi ukurikiraho, yiicara mu ntebe y'urukiiko ruca imanza ategeka ko bamuuzanira Pawulo. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Pawulo ahageze, Abayuuda baavuuye i Yerusaalemu baramwitooroora, bamurega ibirego byinshi bikomeye ariko ntabuhamya babifitiye. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />Pawulo arireguura ati, “Sinigeze nkora ibinyuranye n'amategeko y'Abayuuda cangwa ngo nshobereze Inzu y'Imaana cangwa habe no gushobereza Umwami w'i Rooma.”<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />Ariko Fesito we ashaatse gushiimiisha Abayuuda, abaza Pawulo ati, “Mbese ushaaka kuja i Yerusaalemu ngo abe ari yo nshiira urubanza rw'ibi bakurega?”<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />Pawulo aravuga ati, “Mpagaze kujurira imbere y'ubucaamanza bw'Umwami w'i Rooma kandi ni ho nkwiriye guciirwa urubanza. Ntaakibi nakoreye Abayuuda nk'uko na we ubwawe ubiizi. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Noone niiba ndi mu nshobe, hakaba hari ico nakoze caatuma niicwa, gupfa simbyanze, ariko niiba mu byo abo bayuuda bandega ari nta rubanza rumpfata, nta muntu ushobora kubangabiza. Nsaba ko njurira imbere y'ubucaamanza bw'Umwami w'i Rooma.”<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />Fesito amaze kuja inaama n'abandi bagize urukiiko, aramusubiza ati, “Ubwo usabye kujurira ku mwami w'i Rooma, ni yo uri buje.”<verse eid="ACT 25:12" /></para>
  <para style="s">Uruzinduko rw'Umwami Agiripa</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Hashize iminsi, umwami Agiripa na Berinike bagera i Kayisaariya kwakiira Fesito muri uwo mwanya. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Kuko baari abo kumarayo iminsi myinshi, Fesito ateekerereza umwami ibya Pawulo, avuga ati, “Aha hari umugabo wo Felekisi yasize mu gihome. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />Igihe nari i Yerusaalemu, abatware b'abaheerezabitambo hamwe n'abakuru b'imiryango b'Abayuuda baamenyesheje ibye bansaba ko muciira urubanza mushinja. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />Nabasubije yuuko atari umugenzo w'Abarooma kugabiza umuntu ngo yicwe atabanje guhangana n'abamurega amaaso ku yandi kandi agahaabwa n'umugisha wo kwireguura ibyo bamurega. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />Ubwo baahuriye aha, sinatindiganyije, umunsi ukurikiraho niicara ku ntebe yanje y'ubucaamanza ntegeka ko banzanira uwo mugabo. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />Abaamuregaga bahagurutse, ntihaagira ikirego gikomeye na kimwe bahingutsa mu byo nakeekaga. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Ahuubwo baari bafite ibyo bapfa byerekeye kutumviikana na we, ku by'idiini yaabo hamwe n'umuntu wiitwa Yesu wapfuuye, uwo Pawulo avuga ko ari muzima. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Mboonye ko nanje binyobeye, ntafite uko nashobora gucondooza ibyo bibazo, mubaza niiba ashaaka kuja i Yerusaalemu akaba ari ho aciirirwa urubanza rw'ibyo. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Ariko Pawulo asabye ko ashaaka kujurira ibwami, ntegeka ko aba afunzwe kugeza ubwo nzamwohereza ku Mwami w'i Rooma.”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />Agiripa abwira Fesito ati, “Nanje ubwanje nshaaka kwiyumvira uwo mugabo.” Fesito na we ati, “Ejo, uzamwiyumvira.”<verse eid="ACT 25:22" /></para>
  <para style="s">Umwami Agiripa Yumva ibya Pawulo</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Bukeeye, Agiripa na Berinike binjira mu rukiiko mu cuubahiro, bakiikijwe n'abasirikare bakuru, hamwe n'ibindi bikomangoma byo muri iyo tawuni nkuru. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Nuuko Fesito aravuga ati, “Mwami Agiripa, namwe mwese abari hano uyu munsi, murabona uyu mugabo wo umuryango woose w'Abayuuda bandegeye ndi i Yerusaalemu hamwe na hano, bayomba caane bavuga ko adakwiriye kubaho. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Ariko nkaba narasanze ko ari nta kintu kibi yakoze caatuma aciirwa urwo gupfa. Ansabye ko ashaaka kujurira imbere ya Nyakubahwa umwami w'i Rooma, mpitamo kumwoherezayo. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />Icakora nta kirego na kimwe gifatika nakwandikira Umwami w'i Rooma kimushinja. Noone ni ko kumubaazanira mwese, na caane imbere yaawe mwami Agiripa, kugira ngo nitumara kumusuuzuma, mbone ico kwandika. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Kuko naboonye bidakwiriye koohereza umusibe ku mwami w'i Rooma nteerekanye ico aregwa.”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">Pawulo Yiireguura Imbere ya Agiripa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Agiripa abwira Pawulo ati, “Uhaawe urusa rwo kugira ico wiivugaho.” Nuuko Pawulo arambuura ukuboko atangira kwireguura ati,<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />“Nyakubahwa Agiripa, mfite amahiirwe yo kwireguura imbere yaawe ibirego byose Abayuuda bandega, <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />kuko usanzwe uzi imico y'Abayuuda n'ibyo bajaho impaka. Ni co gituma ngusaba ngo wiihangaane unyumve.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />Abayuuda boose baazi imibeereho yanje kuva mu buto bwanje, uko nabayeho mu bantu bacu hamwe n'i Yerusaalemu. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" /><note caller="-" style="x"><char style="xo" closed="false">26:5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">Iby 23:6</ref>; <ref loc="PHP 3:5">Fil 3:5</ref>.</char></note>Baranzi kuva keera, babishaatse bashobora guhamya ko nabaaye umuyoboke w'ishaka ryarushaga ayandi gukuriza amategeko y'idiini yaacu, kandi ngakurikiza umuco w'Abafarisaayo. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Noone ubu mpagaritswe aha ngo nshiirwe urubanza ku bw'ibyiringiro mfite mu seezerano Imaana yakoreye ba sogokuruza, <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />iseezerano ry'imiryango yaacu cumi n'ebyiri yiizeera ko izaahabwa, ikaba idahwema kuyiramya amanywa na n'ijoro. N'ibi byiringiro Nyakubahwa, byo ndegwa n'Abayuuda! <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Mbese kuki muteemera ko Imaana ishobora kuzuura abaapfuuye?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:9 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:3">Iby 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>,<ref loc="ACT 22:5">5</ref>.</char>
    </note>Ni koko ubwanje nari niiyemeje ko nkwiriye gukora ibishoboka byose kureeba ngo izina rya Yesu Kristo w'i Nazaareeti ntiryamamaye. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />Kandi koko ni byo nakoreraga i Yerusaalemu mpaawe ububaasha n'abatware b'abaheerezabitambo. Ntaabwo nafatiishije abeera benshi bashirwa mu gihome byonyine, ahuubwo no mu gihe baaciirwaga urwo gupfa, narabishigikiraga. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Akenshi mu masinagoogi yoose narabahanaga nkabahata no gusebya Imaana. Ku bw'uburaakari bukabije nari mbafitiye, nabakurikiranaga no mu matawuni akomeye yo mu yandi mahanga kubatooteza.<verse eid="ACT 26:11" /></para>
  <para style="s">Pawulo Avuga uko Yeemeye Kristo</para>
  <para style="r">(<ref loc="ACT 9:1-19">Iby 9:1-19</ref>; <ref loc="ACT 22:6-16">22:6-16</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />Ni co caatumye nja i Damasiko mpaawe uburenganzira n'abatware b'abaheerezabitambo. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />Nuuko reero Nyakubahwa, zigeze isaaha itandatu z'amanywa ndi mu nzira, mbona umuco uva mu ijuru, umurika caane kuruta izuuba, urangota hamwe n'abo twari kumwe. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Tumaze kwikubita haasi, numva ijwi rimbwira mu Ruheburayo riti, ‘Sawuli, Sawuli, urantootereza iki? Uriibabariza ubusa, umeze nk'ikimasa giteera imigere umuhunda<note caller="+" style="f"><char style="fr" closed="false">26:14 </char><char style="bdit">Umuhunda</char> N'inkoni ndende ifite icuuma gisongoye haasi. Abashumba baayikoreeshaga baragira.</note>.’ <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />Nanje ndabaza nti, ‘Uri nde, Nyagasani?’ Aransubiza ati, ‘Ndi Yesu, uwo utooteza. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />Ariko, haguruka uhagarare, kuko nkubonekeye ngo nguhe umurimo wo guheereza no guhamiriza abandi ibyo uboonye kuri nje kandi n'ibyo uzaabonekerwa haanyuma. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />Nzaagutabaara ngukize ubwoko bwanyu n'Abanyamahanga, bo ngiiye kukooherezamo <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />kugira ngo ubahumuure amaaso, bave mu mwijima baje mu muco kandi bave mu mbaraga za Sataani, bayoboke Imaana, bityo bababarirwe ibyaha kandi bahaabwe ku mugabane w'abo beejejwe no kunyizeera.’<verse eid="ACT 26:18" /></para>
  <para style="s">Pawulo Avuga ku Murimo Yahamagariwe</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />Nyuma yaaho Nyakubahwa Agiripa, nta caari kumbuza kumvira ibyo neeretswe biturutse mu ijuru. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" /><note caller="-" style="x"><char style="xo" closed="false">26:20 </char><char style="xt" closed="false"><ref loc="ACT 9:20">Iby 9:20</ref>,<ref loc="ACT 9:28">28</ref>,<ref loc="ACT 9:29">29</ref>.</char></note>Mpeera mu bantu b'i Damasiko, nkurikizaho ab'i Yerusaalemu no mu byaro byose byo muri Yudeeya, hamwe no mu banyamahanga kugira ngo biihane ibyaha bahindukire Imaana, maze bakore imirimo ikwiriye abiihannye. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Ni co caatumye Abayuuda bamfatira mu Nzu y'Imaana, bagerageza kunyica. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />No kugeza uyu munsi Imaana iracantabaara, noone nkaba mpagaze aha guhamiriza abakomeye n'aboroheje, nta bindi mvuga uretse ibyo abahanuuzi na Moose baavuze ko bizaaba. <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" /><note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="1CO 15:20">1 Kor 15:20</ref>.</char></note>Ko Kristo yagombaga kubabazwa agapfa, maze akaba ubanjirije abandi kuzuuka, akava mubaapfuuye ngo yamamaze ko ari we rumuri rumurikira Abayuuda n'Abanyamahanga.”<verse eid="ACT 26:23" /></para>
  <para style="s">Pawulo Yiifuuriza Agiripa Kuyoboka Yesu</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Pawulo aciireguura, Fesito ariiyamiira ati, “Pawulo we, wataaye umutwe! Kwiga byinshi byatumye usara!”<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />Ariko Pawulo aramusubiza ati, “Nyakubahwa Fesito, ntaabwo ndi umusazi, ahuubwo ndi muzima kandi aya magambo mvuga ni ay'ukuri. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Kandi koko umwami Agiripa ibi byose arabiizi, ni co kinteera kuvugana na we n'umudendeezo. Ndahamya yuuko nta na kimwe muri byo ataazi kuko bitaakorewe mu bwihisho. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Mbese mwami Agiripa, weemera iby'abahanuuzi? Nzi ko ubyemera.”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />Umwami Agiripa abwira Pawulo ati, “Mbese uragira ngo muri aka kaanya gato wanyemeza kuba Umukristo?”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />Pawulo aramusubiza ati, “Haba mu kaanya gato cangwa igihe kinini, ndasaba Imaana ngo uretse wowe gusa, ahuubwo n'abaanyumva uyu munsi boose bamere nkanje, ukuuyeho kuba muri izi njegeri.”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Umwami ahagurukana n'umutegetsi mukuru hamwe na Berinike n'abo yari yiicaranye na bo. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />Bakiva aho baravugana bati, “Uyu mugabo nta caaha yakoze caatuma aciirwa urwo gupfa cangwa gusibwa.” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />Umwami Agiripa abwira Fesito ati, “Uyu mugabo kiba arekuwe iyo aba ataarajuriye ku Mwami w'i Rooma.”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">Pawulo Ajanwa i Rooma</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Bamaze kwemeza ko dufata ubwato tukaja muri Itale, Pawulo n'abandi basibe bariimurwa bajanwa ku mutware utegeka abasirikare ijana wiitwa Juliyasi waduumiraga umutwe w'abasirikare wiitwaga Agusito. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Tuja mu bwato buvuuye Adaramatiyo, bwendaga kuja mu ma tawuni ari ku nkengeero y'inyanja ya Asiya. Nuuko tuja mu nyanja duherekejwe na Arisitarikasi, Umunyamakedooniya ukomooka i Teesalonike. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />Bukeeye, tugera i Sidoni. Juliyasi agirira neeza Pawulo, amwemerera kuja mu nshuti ze, ngo zimureeberere. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Tuhavuuye, tugana kuruhande rw'ikirwa ca Kupuro, ahataari umuyaga mwinshi kuko uwo muyaga waduturukaga imbere. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Tuhavuuye, twambuka inyanja tugera ku nkengeero mu birwa bya Silisiya na Pamfiliya, maze tugera i Muura mu gice ca Lusiya. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Tukiri i Muura, umutware utegeka abasirikare ijana abona ubwato buturutse Alekizanduriya buja Itale maze abudushiramo.<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />Tumara iminsi tugenda buhoro buhoro, tugera haafi na Kinido ariko bibanje kutugoora. Kuko umuyaga waduteganyaga, tunyura iruhande rw'ikirwa ca Kureete ahateeganye na Solomooni. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Kuhakiikira nti byari byoroshe, maze tugera ahantu hiitwa i Myaro myiza, haafi y'itawuni nkuru ya Lasaya.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Twari tumaze gutaakaza igihe kinini tugenda kandi gukomeza urugenda mu bwato byari kudushira mu kaaga kuko n'iminsi yo kwiyiriza ubusa yari yaashize kandi igihe c'imivumba myinshi caari ceegeereje, nuuko Pawulo abagiira inaama, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />avuga ati, “Batware, ndabona uru rugendo rugiiye kubamo ibyago no gupfiirwa byinshi, ari imitwaro n'ubwato ndetse n'ubuzima bwacu.” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />Ariko umutware utegeka abasirikare ijana yiiringira umusaare na nyir'ubwato aho kwita ku naama Pawulo yabagiiriye. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Kandi kuko ico cambu caari kitaboneye kukimaramo ayo meezi y'imbeho n'umuyaga, ni co caatumye abenshi bahuuza inaama yo kuvayo, ngo ahaari baashobora kugera i Foyinike ngo abe ari ho bamara ayo meezi y'imbeho n'umuyaga. Caari icambu co mu kirwa c'i Kureete, aheerekeye i burengerazuuba bw'amajeepfo hamwe n'iburengerazuuba bw'amajaaruguru.<verse eid="ACT 27:12" /></para>
  <para style="s">Impanuka y'Ubwato</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />Ubwo umuyaga uringaniye uva mu majeepfo watangiye guhuuha, biibwira ko bari bushikirize umugambi waabo. Niko kuzitura ubwato bagenda bakiikiye ikirwa ca Kureete, aheegeereye inkengeero. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Ariko bidantize, bateerwa n'umuyaga ukabije wiitwa Majaaruguru y'iburasirazuuba uturuka i Kureete. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />Uyu muyaga ukubita ubwato bunanirwa kuwurwanya, maze turabureka bujanwa uko umuyaga ushaaka. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />Nuuko tunyura iruhande rw'ikirwa ciitwa Kawuda ahaari hakingiwe umuyaga. Aha ni ho twashoboye kureeba ngo akaato gato kaari kaziritswe inyuma y'ubunini karinzwe neeza, ariko ntibyari byoroshe ku bw'imbaraga z'umuyaga. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />Abasaare barabwuriza babushira mu bunini, nuuko ubunini babuzengurutsa imigozi ikomeye. Abasaare baatiinyaga ko bashobora gutaabwa ku nkengeero ya Suriti, nuuko barekurira mu maazi ibifatabwato kugira ngo ubwato bugende gahoro maze ubwato butwerwa n'umuyaga. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />Dukomeza guteerwa n'inkubi y'umuyaga, bituma batangira guteerera imitwaro imwe mu nyanja. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />Ku munsi wa gatatu, abasaare ubwabo bafata ibikoreesho by'ubwato, na byo babijungunya mu nyanja. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Hashize iminsi myinshi izuuba n'inyenyeeri bitaboneka, kandi n'umuyaga ukomeje kuba mwinshi, bituma twiheba ko tutari buuze kurokoka.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />Bamaze igihe kinini ari nta co bakoza ku munwa, maze Pawulo ahagarara hagati yaabo aravuga ati, “Bagabo, iyo munyumvira ntimuvuge ubwato kuva i Kureete, ntimwari koonoona no guhomba ibyanyu. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Ariko nooneho ndabiihanangiriza nti, ni mukomere kuko ari ntaamuntu n'umwe uragira ico aba keretse ubwato bwonyine. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Kuko mu joro ryakeeye malayika w'Imaana ndamya kandi nkorera yanjeho, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />maze arambwira ati, ‘wiitiinya Pawulo, kuko ukwiriye guhagarara imbere y'Umwami w'i Rooma, kandi ko Imaana irakurinda hamwe naabo boose mugendana mu bwato.’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Nuuko reero, nimukomere mwa bagabo mwe, kuko mfite kwizeera mu Maana ngo biraba nk'uko nabwiwe. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Icakora, hari ikirwa ubwato bugomba kuzadusukaho.”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Mu ijoro rya cumi na kane tugitwarwa n'imbaraga z'umuyaga mu nyanja ya Adiriya, nka saaha itandatu z'ijoro, abasaare bakeeka ko bari bugufi kugera ku butaka. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Bajugunya mu maazi umugozi uhambiriweho icuuma, basanga uburebure bw'amaazi bureesha na mita mirongo ine. Biigiye imbere gato, babona ubureebure bureesha na mita mirongo itatu. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Batiinya ko ubwato bushobora gukubita ku rutare, maze bajugunya mu maazi ibifatabwato bine inyuma ngo ahaari bwahagarara, basaba ko bwaca vuba. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Abasaare bashaaka gutoroka mu bwato, basubiza ka kaato mu maazi, biitwaje ko bagiiye kurekurira mu maazi ibindi byo guhagarika ubwato. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Pawulo ni ko kubwira umutware utegeka abasirikare ijana ati, “Aba basaare niibataguma mu bwato, namwe ntaabwo murarokoka.” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Abasirikare baca imigozi iziritse bwa bwato buto, baraburekura buragenda.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Bugiiye guca, Pawulo arabinginga kugira ngo hagire ico bafungura ababwira ati, “Dore uyu ni umunsi wa cumi na kane muhagaritse imitima, nta co mukojeje ku munwa. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Ndabibasabye, nimugire ico murya, maze mushobore kubaho. Erega ntaan'umwe muri mwe uzaagira ico aba, habe no gupfuuka agasatsi ko ku mutwe na kamwe.” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />Amaze kuvuga atyo, afata umugaati, awushiimira Imaana imbere yaabo boose, arawumanyura atangira kurya. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />Boose bibateera ihuumure na bo batangira kurya. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />[Twese hamwe twari abantu magana abiri na mirongo irindwi na batandatu mu bwato.] <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Bamaze guhaaga, baroha ingano mu nyanja kugira ngo bagabanye uburemeezi bw'ubwato.<verse eid="ACT 27:38" /></para>
  <para style="s">Ubwato Burohama</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />Mu gitondo, ntibamenya ahantu bageze ahaariho, ariko babona icambu cinjiye mu nyanja, bateekereza ko bishobotse ari ho bakwerekeza ubwato. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Bazitura bya bifatabwato babirekurira mu nyanja, bahambuura n'imigozi iyobora ubwato bw'inyuma, haanyuma bamaze kuzaamuura umwenda w'imbere w'umuyaga uja mo, ugatwara ubwato, bagana ku nkengeero. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Ariko ubwato bugeze ku ihuuriro ry'amaazi, bukubita ku museenyi, igihande c'imbere ciishingamo ubutanyeganyega, naho ic'inyuma gitangira gusandaazwa n'imbaraga z'imivumba.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />Abasirikare bo baari bafite umugambi wo kwica abasibe boose kugira ngo hatagira uwoga mu nyanja agatoroka. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Ariko kuko umutware utegeka abasirikare ijana yari ashaaka gukiza Pawulo, ababuza gukomeza umugambi waabo. Ategeka abo baazi kooga gusimbukira mu nyanja bakababanziriza kugera ku nkengeero <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />nuuko abandi bakabakurikira. Bamwe bakagendera ku mbaho abandi kubimene by'ubwato. Uko ni ko boose baashoboye kugera ku nkengeero y'inyanja ari bazima.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">Imaana Ikoreesha Pawulo Ibitangaaza ku Kirwa ca Melita</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Tumaze kugera imusozi amahoro, tumenya ko ikirwa tugezeho ciitwa Melita. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Abatuurage baaho batwakiirana urugwiro rudasanzwe. Baducaanira umuriro ngo twote kuko imvura yari itangiye kugwa kandi n'imbeho yari nyinshi. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />Pawulo akungaanya umuganda w'inkwi nuuko ari kuzishira mu muriro, inzoka y'inciira isosookamo ku bw'ubushuuhe maze imwiziringa ku kiganza. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Abatuuye aho baboonye iyo nzoka imunagana ku kiganza, baravugana bati, “Uyu muntu agombe kuba ari umwicanyi. N'ubwo yakize urw'inyanja, ica urutabeera ntiimukundiye kubaho!” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Ariko Pawulo akunkumirira ya nzoka mu muriro, kandi we ntihaagira ico aba. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Bategereza kureeba ko yabyimba cangwa ko yiikubita haasi agapfa, ariko hashize umwanya mureemure babona ari ntakimuhindutseho, maze bahindura imiteekerereze yaabo batangira kuvuga ko ari imaana.<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />Haafi y'aho haari imirima y'umuyobozi w'ico kirwa wiitwaga Pubiliyo. Yatwakiiriye neeza aratuzimaanira kumara iminsi itatu. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Ubwo se wa Pubiliyo yari ku gasambi arwaye amacinya kandi ahinda umuriro. Pawulo aja kumusuura nuuko amaze kumusengera no kumurambikaho ibiganza, aramukiza. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Ibyo bimaze kuba, abandi barwayi boose baari kuri ico kirwa na bo baaza basanga Pawulo, abakiza indwara. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />Abantu b'aho baheerako baduha icuubahiro cinshi, kandi ubwo twari tugiiye kuja mu bwato, baduha ibyo twari dukeneye ku rugendo byose.<verse eid="ACT 28:10" /></para>
  <para style="s">Pawulo Agera i Rooma</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Hashize ameezi atatu dufata ubwato bwari bwikinze kuri ico kirwa buhamaze ameezi y'imbeho n'umuyaga. Bwavaga Alekizanduriya kandi bwitiriwe ikigirwamaana ciitwa Bavandimwe b'amahasa. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Tugera i Sirakusa maze tuhamara iminsi itatu. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Tuhavuuye tugera ahiitwa Regiyo. Hashize umunsi umwe umuyaga uturutse mu majeepfo utangira guhuuha, maze ku munsi wa kabiri tugera i Peteyoli. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />Aho tuhasanga abiizeera badusaba kubaana na bo kumara iminsi indwi. Nyuma tuhavuuye tugera i Rooma. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />Abiizeera b'i Rooma bumviise ko tuuje, baaza kudusanganira bavuuye kure caane nko ku gatare ka Apiyo n'ahiitwa Macumbi Atatu. Pawulo ababoonye, ashiima Imaana kandi yongera gukomera.<verse eid="ACT 28:15" /></para>
  <para style="s">Pawulo n'Abayobozi b'Abayuuda i Rooma</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />Tugeze i Rooma, beemerera Pawulo gucumbika ukwe, ariko bamuha umusirikare wo kumurinda.<verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Hashize iminsi itatu, Pawulo akoranya abayobozi b'Abayuuda. Bamaze gukungaana, arababwira ati, “Bavandimwe, n'ubwo ari nta kibi nakoreye beene waacu cangwa ngo nkore ibinyuranye n'imigenzo ya ba sogokuruza, ariko bamfatiye i Yerusaalemu banshikiriza Abarooma. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />Bamaze kunsuuzuma, Abarooma baashaakaga kundekura kuko baasanze nta co nakoze caatuma nshiirwa urwo gupfa. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" /><note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 25:11">Iby 25:11</ref>.</char></note>Ariko Abayuuda babyanze, mpitamo gusaba ngo njurire imbere y'Umwami w'i Rooma, nuubwo ari nta co ndega beene waacu. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Ni yo mpamvu yatumye mbatumaho kugira ngo mvugane namwe, kuko nashizwe muri izi njegeri mpoorwa uwo Abiisirayeli bafitemo ibyiringiro.”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />Baramusubiza bati, “Nta rwandiko twigeze tubona ruvuuye i Yudeeya rukuvugaho. Kandi nta muvandimwe n'umwe waaje aha ngo abitumenyeshe cangwa ngo hagire ukuvuga naabi. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Icakora dushaaka kumva ico uteekereza, kuko tuuzi yuuko benshi barwanya inyigiisho z'iyo diini.”<verse eid="ACT 28:22" /></para>
  <para style="s">Pawulo Abwiriza i Rooma</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Bamaze guteguura umunsi wo guhuura na we, haaza benshi bamusanga aho yari acumbitse. Kuva mu gitondo kugera ku mugoroba abibasobaanurira, ahamya iby'ubwami bw'Imaana, agerageza no kubeemeza ibya Yesu ashingiye ku mategeko ya Moose no ku bahanuuzi. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Bamwe bemejwe n'ibyo avuga, naho abandi banga kubyemera. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Ntibaashobora kumvikana, nuuko bari gutaaha, Pawulo yongera kuvuga ati, “Ibyo Umwuka Weera yabwiye ba sogokuruza baanyu anyuriye mu muhanuuzi Yesaaya byari bishitse, ati,<verse eid="ACT 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />‘Genda ubwire abo bantu uti,</para>
  <para style="q1" vid="ACT 28:26">Kumva muzumva, ariko ntimuzaasobaanukirwa,</para>
  <para style="q2" vid="ACT 28:26">kandi no kureeba muzaareeba, ariko ntimuzaabona.<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Kuko aba bantu binangiye imitima yaabo,</para>
  <para style="q2" vid="ACT 28:27">kandi bakazibya amatwi yaabo,</para>
  <para style="q2" vid="ACT 28:27">bahumya amaaso yaabo,</para>
  <para style="q3" vid="ACT 28:27">Kugira ngo batareeba.</para>
  <para style="q1" vid="ACT 28:27">Naaho, amaaso yaabo yakareebye</para>
  <para style="q2" vid="ACT 28:27">amatwi yaabo akumva,</para>
  <para style="q2" vid="ACT 28:27">n'imitima yaabo ikagira ico isobaanukirwa nuuko bakampindukira</para>
  <para style="q2" vid="ACT 28:27">maze nkabakiza.’<verse eid="ACT 28:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ACT 28:28" />Nuuko reero mumenye ko aka gakiza k'Imaana kooherejwe mu banyamahanga, kandi bo bazaakaakiira.”<verse eid="ACT 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 28:29" />[Pawulo amaze kubabwira ibyo, Abayuuda baragenda, bataaha bagiishanya impaka caane.] <verse eid="ACT 28:29" /><verse number="30" style="v" sid="ACT 28:30" />Pawulo atuurayo kumara imyaka ebyiri yiibeshaho<note caller="+" style="f"><char style="fr" closed="false">28:30 </char><char style="ft" closed="false">Mu bindi byanditswe byera havuga ngo </char><char style="fqa" closed="false">Yipangishirije </char></note> akaja yaakiira abo boose baazaga bamusanga, <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />yaamamaza iby'ubwami bw'Imaana kandi akiigiisha iby'Umwami Yesu Kristo ashize amanga kandi ari ntakimutanga.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>