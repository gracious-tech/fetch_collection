<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">Rufumbira New Testament</book>
  <para style="h">LUKA</para>
  <para style="toc3">Luk</para>
  <para style="toc2">LUKA</para>
  <para style="toc1">Ubutumwa bwiza uko bwanditswe na LUKA</para>
  <para style="mt2">Ubutumwa Bwiza uko Bwanditswe na</para>
  <para style="mt1">LUKA</para>
  <para style="imt">INYANZURO</para>
  <para style="im">
    <char style="bk">Ubutumwa Bwiza Bwanditswe na Luka </char> bwerekana Yesu nk'Umukiza w'Imaana yari yaraseezeranyije Abiisirayeli kandi nk'Umukiza w'abantu b'ubwoko bwose. <char style="it">Luka</char> yandika yeerekana ko Yesu yahamagawe n'Umwuka w'Uhoraho “kuuzanira abakene inkuru nziiza” 4:18, kandi ubu Butumwa Bwiza bwuzuyemo ibyerekeye kwita ku bantu bafite ibyifuuzo by'uburyo bwose. Ibifashe ku muneezeero na byo biranzwe ni iki gitabo ca <char style="bk">Luka</char> na caane mu bice bibanza bitangaaza kuuza kwa Yesu hamwe no ku musoozo aho Yesu ari gusubira mu ijuru. Inkuru ifashe ku gukura no kwiyongeera mu kwizeera kw'Abakristo nyuma yuuko Yesu asubira mu ijuru ivugwa n'umwanditsi w'iki gitabo, mu gitabo c' <char style="bk">Ibyakozwe n'Intumwa.</char></para>
  <para style="ip">Igice ca mbere kugeza ku ca kabiri hamwe n'ica cenda kugeza ku ca cumi n'icenda by'iki gitabo bifite ibintu byinshi bisangwa muri ubu Butumwa Bwiza gusa, nk'inkuru ifashe ku ndirimbo y'abaamalayika n'abashumba igihe baagiiye kureeba Yesu yavuutse, Yesu mu rusengero akiri umwana, umugani w'Umusamariya Mwiza hamwe n'Umwana w'Ikirara. Muri ubu Butumwa Bwiza, ic'ingenzi caane ni ugusenga, Umwuka Weera, umurimo w'abagore mu buhereza bwa Yesu hamwe n'Imaana ibabarira ibyaha.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro<char style="ior"><ref loc="LUK 1:1-4">1:1-4</ref></char></para>
  <para style="io1">Ivuuka n'imikurire ya Yohaana Umubatiza hamwe na Yesu <char style="ior"><ref loc="LUK 1:5-2:52">1:5—2:52</ref></char></para>
  <para style="io1">Ubuheereza bwa Yohaana Umubatiza <char style="ior"><ref loc="LUK 3:1-20">3:1-20</ref></char></para>
  <para style="io1">Kubatizwa no kugeragezwa kwa Yesu <char style="ior"><ref loc="LUK 3:21-4:13">3:21—4:13</ref></char></para>
  <para style="io1">Ubuheereza bwa Yesu muri rubanda i Galileeya <char style="ior"><ref loc="LUK 4:14-9:50">4:14—9:50</ref></char></para>
  <para style="io1">Kuva i Galileeya uja i Yerusaalemu <char style="ior"><ref loc="LUK 9:51-19:27">9:51—19:27</ref></char></para>
  <para style="io1">Ic'umweru ca nyuma i Yerusaalemu n'iruhande rwaho <char style="ior"><ref loc="LUK 19:28-23:56">19:28—23:56</ref></char></para>
  <para style="io1">Izuuka, kuboneka no kuja mu ijuru by'Umwami Yesu <char style="ior"><ref loc="LUK 24:1-53">24:1-53</ref></char></para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s1">Luka Yandikira Tewofilo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Nyakuubahwa Tewofilo<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="it">Tewofilo</char> rimenyeesha Umukunzi w'Imaana </note>,</para>
  <para style="p" vid="LUK 1:1">Abantu benshi baagerageje kwandika ibyabaaye muri twe. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />Banditse nk'uko twabibwiwe n'abaabyireebeye n'amaaso yaabo bigitangira kandi bakabyamamaza. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />Nuuko reero nanje ubwanje maze kubibaririza neeza uko byagiiye, bimbeera byiza kubikwandikira uko byagiiye bikurikirana, <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />kugira ngo bigufashe kumenya neeza ukuri kw'ibyo wiigiishijwe byose.<verse eid="LUK 1:4" /></para>
  <para style="s1">Malayika Atangaaza Ivuuka rya Yohaana Umubatiza</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Ku ngoma ya Herodi umwami w'i Buyuda, haariho Umuheerezabitambo witwaga Zaakariya. Yari akomooka mu muryango w'abaheerezabitambo wa Abiya. Umugore we yitwaga Elizaabeeti, akaba yari akomooka mu muryango wa Arooni, Umuheerezabitambo Mukuru. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Zaakariya na Elizaabeeti baari intungaane imbere y'Imaana kandi baakurikizaga amategeko n'amabwiriza y'Imaana. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Ntamwana baari bafite kuko Elizaabeeti yari ingumba kandi bombi baari bageze mu zaabukuru.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Umunsi umwe, umuryango w'abaheerezabitambo wa Zaakariya ni wo wari ugenewe gukora mu Nzu y'Imaana kandi Zaakariya ni we wari uramukiwe. <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />Ukurikije umugenzo w'abaheerezabitambo, ubufindo bufata Zaakariya maze atooranywa kuja mu Nzu y'Imaana kootsa ibihuumura neeza. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Mu gihe yabyotsaga, abantu benshi baari hanze basenga.<verse eid="LUK 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11" />Nuuko malayika w'Uhoraho aramubonekera, ahagarara iburyo bw'igicaaniro c'ibihuumura neeza. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Zaakariya amuboonye ariikanga agira ubwoba, <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />ariko malayika aramubwira ati, “wiitiinya Zaakariya, kuko Imaana yumviise gusenga kwawe. Umugore waawe Elizaabeeti azaakubyarira umuhungu nuuko uzamwite Yohaana. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />Azaakubeera umuneezeero n'ibyishiimo, ndetse benshi baziishiimira kuvuka kwe. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />Azaaba umuntu ukomeye imbere y'Imaana. Ntaazanywa divaayi cangwa igisindiisha coose, kandi azuuzuzwa Umwuka Weera uheereye akiri mu nda ya nyina. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Azaayobora Abiisirayeli kugira ngo biihane ibyaha byabo bagarukire Imaana, <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />kandi azaagendera imbere y'Imaana mu Mwuka n'ububaasha nka Eliya. Azaahuuza imitima y'abaana n'ababyeyi, hamwe n'abatumvira Imaana, azaabayobora mu bwenge bwo kuyumvira, kugira ngo ateguure abantu maze batungaanire Imaana.”<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Zaakariya abaza malayika ati, “Ibyo naabyemera nte ko ndi umusaaza kandi n'umugore wanje akaba ari umukeecuru?”<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />Malayika aramusubiza ati, “Ninje malayika Gaburyeri uhora imbere y'Imaana, kandi natumwe kuvugana naawe ngo nkubwire ubwo butumwa bwiza. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Uheereye noone, ntuuribwongere kuvuga ku bwo gushidiikanya kwawe, kugeza umunsi ibyo nkubwiye bizaakubaho kuko amagambo yanje azaasohora mu gihe caayo.”<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Abantu baari bategereje Zaakariya, batangaazwa n'uko atinze mu Nzu y'Imaana. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Asohotse, ntiyashobora kuvugana na bo. Nuuko abantu bareebera ku bimenyeetso yakoreeshaga no guceceka kwe maze bateekereza ko agomba kuba yaboonye iyerekwa akiri mu Nzu y'Imaana.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />Iminsi ya Zaakariya yo guheereza ibitambo ishize, asubira iwe. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />Hashize igihe, umugore we Elizaabeeti asama inda, nuuko amara ameezi ataanu ataja ahagaragara. Aravuga ati, <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />“Mbeega ibyo Imaana yankoreye muri iyi minsi! Yarantabaaye, inkiza ibyankozaga isoni<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="ft" closed="false">Mu Bayuuda, kutabyara byari biteeye isoni, ndetse baabibonaga nk'igihano kiva ku Maana. </char></note> mu bantu.”<verse eid="LUK 1:25" /></para>
  <para style="s1">Malayika Atangaariza Mariya ko Azaabyara Yesu</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Igihe Elizaabeeti yari afite inda y'ameezi atandatu, Imaana ituma malayika Gaburyeri mu tawuni y'i Galileeya yitwa Nazaareeti. <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" /><note caller="-" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 1:18">Mat 1:18</ref>.</char></note>Imutuma ku mwari w'isugi wiitwa Mariya wari usabwe n'umugabo witwaga Yozefu wo mu muryango wa Dawudi. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Malayika abonekera Mariya aramubwira ati, “Ni amahoro uhiiriwe! Uhoraho ari kumwe naawe.”<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />Mariya ariikanga, ahagarika umutima ku bw'iyo ndamutso ateekereza ico imenyeesha. <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Malayika aramubwira ati, “Ntuugire ubwoba Mariya, kuko uhiiriwe ku Maana. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" /><note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="MAT 1:21">Mat 1:21</ref>.</char></note>Dore uzaasama inda, ubyare umuhungu, uzamwite Yesu. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />Azaaba ukomeye, kandi aziitwa Umwana w'Isumbabyose. Imaana izaamugira Umwami nka seekuruza Dawudi. <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />Azaaba Umwami mu nzu ya Isirayeli iteeka ryose, ndetse Ubwami bwe ntibuzaashira.”<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />Mariya abaza uwo malayika ati, “Ibyo bizaabaho bite ko ntaamugabo mfite?”<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />Malayika aramusubiza ati, “Umwuka Weera azaakuuzaho, n'ububaasha bw'Isumbabyose bukubundikire mu gicuucu ce, ni co gituma umwana uzaavuuka azaaba Uweera, akiitwa Umwana w'Imaana. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Dore mwene waanyu Elizaabeeti na we afite inda y'umuhungu yo mu bukeecuru. Uwitwaga ingumba, ubu ni ukwezi kwe kwa gatandatu atwite, <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />kuko ari ntaajambo Imaana ivuga ngo rihere.”<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />Mariya aramubwira ati, “Dore ndi umuja w'Imaana, byose bimbeho uko uvuze.” Nuuko malayika amusiga aho aragenda.<verse eid="LUK 1:38" /></para>
  <para style="s1">Mariya Aja Kubaramira Elizaabeeti</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Muri ico gihe, Mariya arahaguruka agenda yihuuta, aja mu tawuni yo mu gihugu c'imisozi y'i Yudeeya. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />Mariya yinjira mu nzu ya Zaakariya, aramukanya na Elizaabeeti. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Mariya akimuramutsa, umwana wa Elizaabeeti yisimbiza mu nda. Maze Elizaabeeti yuzura Umwuka Weera, <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />avuga mu ijwi rirenga ati, “Mariya, mu bagore boose urahiirwa, n'umwana uzaabyara arahiirwa. <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Mbese ni nje nde kubona nyina w'Umwami wanje ambaramiye? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Numviise indamutso yaawe, ako kaanya umwana asimbizwa mu nda yanje ku bw'umuneezeero mwinshi. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Kandi urahiirwa kuko wizeeye ibyo wabwiwe n'Uhoraho ko bizaabaho.”<verse eid="LUK 1:45" /></para>
  <para style="s1">Mariya Ashiima Imaana</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Maze Mariya aravuga ati,</para>
  <para style="q1" vid="LUK 1:46">“Umutima wanje uhimbaaze Uhoraho,<verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />kandi wishiimire Imaana Umukiza wanje,<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />kuko yitaaye ku kwiciisha bugufi ku muja we.</para>
  <para style="q1" vid="LUK 1:48">Kuva ubu, ab'ibihe byose bazanyita uhiiriwe,<verse eid="LUK 1:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="LUK 1:49" />kuko Ushoborabyose yankoreye ibikomeye,</para>
  <para style="q2" vid="LUK 1:49">izina rye ni iryera.<verse eid="LUK 1:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50" />Imbabazi z'Uhoraho zihora ku bamwubaha,</para>
  <para style="q2" vid="LUK 1:50">b'ibihe byose.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />Imaana yakoreesheje ukuboko kwayo gukomeye,</para>
  <para style="q2" vid="LUK 1:51">gutaatanya abiibone n'imigambi yaabo.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />Yimuye abaami ku ngoma,</para>
  <para style="q2" vid="LUK 1:52">ishira heejuru abiiciisha bugufi.<verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />Imaana yahaagije ibyiza abafite inzara,</para>
  <para style="q2" vid="LUK 1:53">ariko abakire yabaseezereye amaara masa.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />Yatabaaye Isirayeli umugaragu waayo,</para>
  <para style="q2" vid="LUK 1:54">kandi yibutse kugirira imbabazi<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />Aburahamu n'urubyaro rwe iteeka ryose,</para>
  <para style="q2" vid="LUK 1:55">nk'uko yabwiye ba sogokuruza.”<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Nuuko Mariya aguma kwa Elizaabeeti kumara ameezi atatu, abona gutaaha.<verse eid="LUK 1:56" /></para>
  <para style="s1">Ivuuka rya Yohaana Umubatiza</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Igihe ca Elizaabeeti co kubyara kigeze, abyara umwana w'umuhungu. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Abatuuranyi be na beene waabo bumva ko Nyagasani Imaana yamugiriye imbabazi nyinshi, abantu boose biishiimana na we.<verse eid="LUK 1:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 1:59" />Umwana amaze iminsi munaane avuutse, bamujaana gukebwa. Bashaaka kumwitirira izina rya se Zaakariya, <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />ariko nyina arababwira ati, “Oya, akwiriye kwitwa Yohaana.”<verse eid="LUK 1:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61" />Baramubwira bati, “Ko ari ntaawe wo mu muryango waanyu wiitwa iryo zina!”<verse eid="LUK 1:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 1:62" />Baciira se amarenga kugira ngo bamenye izina ryo ashaaka kumwita. <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />Asaba ico kwandikaho, arandika ati, “Izina rye ni Yohaana.” Boose baratangaara. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Muri ako kaanya Zaakariya atangira kuvuga ashiima Imaana. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Abatuuranyi be bateerwa n'ubwoba, ibyo byose byamamara mu misozi yoose y'i Yudeeya. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Abaabyumviise barabizirikana, bariibaza bati, “Mbese uyu mwana azaaba iki?” Nuuko Imaana ikomeza kubaana n'uwo mwana.<verse eid="LUK 1:66" /></para>
  <para style="s">Zaakariya Ahanuura</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Zaakariya se wa Yohaana, ayoborwa n'Umwuka Weera, arahanuura ati,<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />“Nyagasani ahimbaazwe, Imaana y'Abiisirayeli,</para>
  <para style="q2" vid="LUK 1:68">kuko igendereye abantu baayo, kubacungura.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />Kandi itwoherereje Umukiza ukomeye,</para>
  <para style="q2" vid="LUK 1:69">kuva mu rubyaro rw'umugaragu waayo Dawudi.<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />Nk'uko Imaana yakoreesheje abahanuuzi baayo kuva keera, yaseezeranyije<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />yuuko izaadukiza abanzi n'amaboko y'abatwanga boose.<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />Yagiriye ba sogokuruza imbabazi,</para>
  <para style="q2" vid="LUK 1:72">yibuka iseezerano ryayo ryera,<verse eid="LUK 1:72" /></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73" />n'indahiro yarahiye sogokuruza Aburahamu<verse eid="LUK 1:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="LUK 1:74" />yuuko nitumara gukizwa amaboko y'abanzi baacu,</para>
  <para style="q2" vid="LUK 1:74">tuzaayikorera tudatiinya,<verse eid="LUK 1:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />turi abeera, dukiraanuka imbere yayo iminsi yoose yo kubaho kwacu.<verse eid="LUK 1:75" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />Kandi naawe mwana wanje, uziitwa umuhanuuzi w'Imaana Isumbabyose.</para>
  <para style="q2" vid="LUK 1:76">Uzaabanziriza Umukiza kugira ngo utungaanye inzira ze.<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />Uzaamenyeesha abantu yuuko inzira y'agakiza,</para>
  <para style="q2" vid="LUK 1:77">ari ukubabarirwa ibyaha byabo.<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />Urukundo rw'Imaana n'imbabazi zaayo, bizaatuuzaho</para>
  <para style="q2" vid="LUK 1:78">nk'uko izuuba ritumurikira umuseke utambitse,<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />ukamurikira abiicaye mu mwijima no mu gicuucu c'urupfu,</para>
  <para style="q2" vid="LUK 1:79">no kuyobora ibirenge byacu mu nzira y'amahoro.”<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Uwo mwana arakura, agwiza ubutwari, aguma mu butaayu kugeza igihe yigaragarije mu Biisirayeli.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s1">Ivuuka rya Yesu</para>
  <para style="r">(<ref loc="MAT 1:18-25">Mat 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Muri ico gihe Umwami mukuru w'ubutegetsi bw' i Rooma witwaga Agusito, yatanze itegeko ryo kubara abantu boose bo mu butegetsi bwe bwose. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Iri ni ryo baruura ryabanje kubaho muri ubwo butegetsi bw'umwami Kureniyo yategekaga i Siriya. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Nuuko buri muntu aja kwiyandikiisha mu tawuni y'akomookamo.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />Yozefu na we kuko yari akomooka mu muryango wa Dawudi, ava mu tawuni y'i Nazaareeti muri Galileeya, aja kwandikirwa i Beetelehemu muri Yudeeya itawuni ya Dawudi. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />Ajaana na Mariya wo yari aseezeranyije baja kwiyandikiisha, kandi ico gihe Mariya yari atwite yegeereje igihe co kubyara. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Bakiri i Beetelehemu, igihe ce co kubyara kiragera. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Abyara umuhungu we w'imfura amufubika mu twenda, amuryamiisha mu muvure w'inka kuko ari ntamwanya bari baaboonye mu icumbi.<verse eid="LUK 2:7" /></para>
  <para style="s1">Malayika Abwira Abashumba ko Yesu Yavuutse</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />Iryo joro muri ako gace haarimo abashumba baaraariiraga amatungo yaabo bayarinda. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Malayika w'Imaana arababonekera, maze ubwiza bw'Imaana burabamurikira, burabagota, baheerako bagira ubwoba. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Malayika arababwira ati, “Nimuhuumure kuko mbaazaniye inkuru nziiza izaabeera abantu boose umuneezeero mwinshi. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Uyu munsi mu tawuni ya Dawudi, Umukiza yabavuukiye, ni we Kristo Umwami. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Iki ni co kiri bubabeere ikimenyeetso, murasanga umwana w'uruhinja afubitswe mu twenda, aryamiishijwe mu muvure w'inka.”<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />Ako kaanya haboneka abaamalayika benshi bavuuye mu ijuru biifatanya na wa malayika, baririmba basingiza Imaana bati,<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />“Icuubahiro kibe ic'Imaana nyir'ijuru</para>
  <para style="q2" vid="LUK 2:14">kandi amahoro mu isi abe mu bo yishiimira.”<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Nuuko abo baamalayika bamaze gusubira mu ijuru, abashumba baravugana bati, “Nimuuze tuje i Beetelehemu tureebe ibibaayeyo iby' Imaana itumenyesheje.”<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />Bagenda biihuuta, bageze i Beetelehemu basangayo Mariya na Yozefu, n'umwana w'uruhinja aryamiishijwe mu muvure. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Bamuboonye batangira kwamamaza ibyabaaye hamwe n'ibyo malayika yari yaavuze kuri uwo mwana. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Abaabyumviise boose batangaazwa n'ibyo baabwiwe n'abo bashumba. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Ariko ayo magambo Mariya ayagira ibanga aja ayazirikana. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Abo bashumba basubira mu matungo yaabo, baririmba kandi bahimbaaza Imaana ku bw'ibyo baari bumviise kandi baaboonye byose, nk'uko baari baabibwiwe na malayika.<verse eid="LUK 2:20" /></para>
  <para style="s1">Umuhango wo Kwita Yesu Izina</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Ku munsi wa munaane ari co gihe co gukebwa, bamwita Yesu. Iryo ni ryo zina ryari ryaravuzwe na malayika, nyina wa Yesu ataraasama inda.<verse eid="LUK 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />Nuuko iminsi yo kwezwa ishize, nk'uko umuhango wari uri ukurikije amategeko ya Moose, Yozefu na Mariya bajaana Yesu i Yerusaalemu kumumurikira Imaana. <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />Nk'uko byanditswe mu mategeko y'Uhoraho ngo, “Umuhungu weese w'imfura akwiriye kumurikirwa Imaana.” <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />Nuuko baja no gutuura igitambo nk'uko byavuzwe mu mategeko ya Nyagasani ngo, “Inuma ebyiri cangwa inyoni ebyiri zisa n'inuma.”<verse eid="LUK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 2:25" />Muri ico gihe, haariho umugabo witwaga Simiyooni. Uwo yari atuuye i Yerusaalemu kandi yari intungaane, yitonda, atiinya Imaana. Yahoraga ategereje uzaazanira Abiisirayeli agakiza, kandi Umwuka Weera yari muri we. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Yari yarahishuuriwe n'Umwuka Weera ko atazaapfa ataraabona Kristo w'Imaana. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Uwo munsi, ayoborwa n'Umwuka Weera aja mu Nzu y'Imaana i Yerusaalemu. Maze Mariya na Yozefu baaje kumurikira Imaana uwo mwana, nk'uko umuhango w'amategeko wari uri, <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />basangayo Simiyooni. Simiyooni aboonye uwo mwana aramukiikira, maze ashiima Imaana ati,<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />“Mwami Maana, nooneho umugaragu waawe</para>
  <para style="q2" vid="LUK 2:29">yigendere amahoro nk'uko wabivuze.<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />Kuko amaaso yanje aboonye agakiza kaawe,<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />ako wateguuriye abantu boose kuba<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />umuco uzaahishuurira Imaana abanyamahanga.</para>
  <para style="q2" vid="LUK 2:32">Kandi ari ko gakiza kazaazana icuubahiro ku bwoko bwawe Isirayeli.”<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Maze ababyeyi be batangaazwa n'amagambo Simiyooni avuze kuri uwo mwana. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Nuuko Simiyooni abasabira umugisha kandi abwira Mariya ati, “Uyu mwana yaratooranyijwe kugira ngo bamwe mu Biisirayeli bagwe, abandi babyuke kandi azaaba ikimenyeetso kivuuye ku Maana co benshi bazaagiraho impaka. <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />Maze ibyo abantu bateekereza mu mitima yaabo bizaahishuurwa kandi naawe uzaagira agahinda kenshi, kagukuure umutima.”<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />Haariho n'umuhanuuzikazi witwaga Anna umukoobwa wa Fanuweli wo mu muryango wa Asheeli. Yamaranye n'umugabo we imyaka irindwi gusa arapfaakara <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />kugeza ku myaka mirongo inaane n'enye. Yahoraga mu Nzu y'Imaana, asenga ku manywa na nijoro yiyiriza ubusa. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Muri ako kaanya arabeegeera maze ashiima Imaana avuga ku by'uwo mwana amwamamaza mu bantu boose baari bategereje gucungurwa kw'i Yerusaalemu kuvuuye ku Maana.<verse eid="LUK 2:38" /></para>
  <para style="s1">Gusubira i Nazaareeti</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />Nuuko Yozefu na Mariya bamaze kurangiza byose nk'uko itegeko ry'Uhoraho ryari riri, basubira i Galileeya mu tawuni y'iwaabo yitwa Nazaareeti. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Maze uwo mwana akurirayo, agwiza imbaraga n'ubwenge kandi ubuntu bw'Imaana bwari kuri we.<verse eid="LUK 2:40" /></para>
  <para style="s1">Umwana Yesu mu Nzu y'Imaana</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Buri mwaka ababyeyi ba Yesu baajaga kwizihiza iminsi mikuru yo Kunyurwaho i Yerusaalemu. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Nuuko Yesu amaze imyaka cumi n'ibiri y'ubukuru, bazaamuukana na we baja kwizihiza iyo minsi mikuru nk'uko umugenzo waabo wari uri. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Iyo minsi irangiye, ababyeyi be basubira iwaabo. Maze Yesu we asigara i Yerusaalemu ababyeyi be batabiizi. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Baateekereje ko yaaba yaajaanye n'abandi bantu, nuuko bakomeza kugenda urugendo rw'umunsi woose. Bamushaakira mu bavandimwe no mu nshuti. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />Bamubuze, basubira i Yerusaalemu kumushaakirayo. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />Hashize iminsi itatu, bamubona mu Nzu y'Imaana yicaranye n'abiigiishamategeko abateze amatwi kandi ababaza ibibazo. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Abamwumvaga boose baatangaariraga ubwenge bwe no gusubiza kwe. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Se na nyina bamuboonye baratangaara, maze nyina aramubaza ati, “Mwana wanje, ni iki caatumye utugenza utya? Nje na so twagushaatse duhagaritse umutima turakubura.”<verse eid="LUK 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49" />Yesu arabasubiza ati, “Mwanshaakiraga iki? Ntimwari muuzi ko nkwiriye kuba mu nzu ya Daata?” <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Ariko ntibaasobaanukirwa ico Yesu yamenyeeshaga.<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />Nuuko Yesu amanukana na bo aja i Nazaareeti, agahora abumvira. Ariko ibyo byose nyina abigira ibanga kandi agahora abiteekerezaho. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Yesu akomeza kugwiza ubwenge, akura ashimwa n'Imaana n'abantu.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s1">Yohaana Umubatiza Abwira Abantu Kwiteguurira Kristo</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>; <ref loc="MRK 1:1-8">Mar 1:1-8</ref>; <ref loc="JHN 1:19-28">Yoh 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Mu mwaka wa cumi n'itaanu ubwo Tibeeriyo yari umwami mukuru wategekaga Rooma, Imaana yahaaye Yohaana mwene Zaakariya ubutumwa ari mu butaayu. Ico gihe Pontiyo Pilaato yari umutegetsi w'i Yudeeya, naho Herodi ari umutegetsi w'i Galileeya. Mwene se Filipo yari umutegetsi wa Itureya n'i Turakonite, Lusaniya yari umutegetsi w'Abileeni, <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />naho Anaasi na Kayafa baari Abaheerezabitambo bakuru. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Nuuko Yohaana agenda ava mu mwanya aja mu wundi ku mpande zoose z'uruuzi rwa Yorodaani, abwiriza abantu ko bakwiriye kwihana, bakabatizwa kugira ngo bababarirwe ibyaha byabo. <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Nk'uko byanditswe mu gitabo c'umuhanuuzi Yesaaya ati,</para>
  <para style="q1" vid="LUK 3:4">“Nimwumve uwo urangururira mu butaayu ati,</para>
  <para style="q1" vid="LUK 3:4">‘Nimutungaanye inzira y'Uhoraho,</para>
  <para style="q2" vid="LUK 3:4">mugorore aho azanyura.<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />Imibande yoose izuuzuzwa,</para>
  <para style="q2" vid="LUK 3:5">ibirunga n'imisozi bizaaringanizwa.</para>
  <para style="q1" vid="LUK 3:5">Ibigoramye bizaagororoka,</para>
  <para style="q2" vid="LUK 3:5">inzira zidaharuwe zizaaharurwa.<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />Kandi abantu boose bazaabona agakiza k'Imaana.’ ”<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:34">Mat 12:34</ref>; <ref loc="MAT 23:33">23:33</ref>.</char>
    </note>Abantu benshi baaza kuri Yohaana kugira ngo ababatize, maze arababwira ati, “Mwa rubyaro rw'inzoka mwe! Ni nde wabagiiriye inaama yo guhunga uburaakari bw'Imaana bwegeereje? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" /><note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="JHN 8:33">Yoh 8:33</ref>.</char></note>Kwihana kwanyu kwerekanirwe mu byo muteekereza no mu byo mukora nk'uko Imaana ibishaaka. Mureke gukomeza kwibwira ko ubwo mukomooka kuri Aburahamu, ngo ahaari Imaana ntiyabahanira ibyaha byanyu. Ndababwira yuuko Imaana ibaasha guhindura aya mabuye abaana ba Aburahamu. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" /><note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MAT 7:19">Mat 7:19</ref>.</char></note>Kandi n'ubu intoorezo igezwe ku biti. Nk'uko bayimanikiira gutema igiti, ni ko igiiye kumanukira abanyabyaha. Bityo reero, igiti coose kiteera imbuto nziiza gikwiriye gutemwa kikajugunywa mu muriro.”<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Abantu baramubaza bati, “Noone se tugire dute?”<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />Yohaana arabasubiza ati, “Ufite imyenda ebyiri, umwe awuhe utawufite, n'ufite ibyokurya, na we akore atyo.”<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:12 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:29">Luk 7:29</ref>.</char>
    </note>Abasoreesha na bo baaje ngo babatizwe, baramubaza bati, “Mwigiisha, tugire dute?”<verse eid="LUK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13" />Arabasubiza ati, “Ntimugasoreeshe abantu ibiruta ibyo mwategetswe.”<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />Abasirikare na bo baramubaza bati, “Twebwe tugire dute?”</para>
  <para style="p" vid="LUK 3:14">Arabasubiza ati, “Ntimukagire umuntu uwo mutugiisha cangwa ngo mumurege ibinyoma, ahuubwo ibihembo byanyu bibanyure.”<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Nuuko abo bantu bagira ibyiringiro, biibwira ko ahaari Yohaana yaba ari we Kristo. <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Maze Yohaana arababwira ati, “Ni koko njeewe ndabatiriisha amaazi, ariko hazaaza undusha ububaasha, ndetse ntibinkwiriye ko naapfunduura udushumi tw'ingato ze.<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Gupfunduura udushumi tw'ingato Yohaana yamenyeeshaga yuuko adakwiriye kuba imbaata ya Kristo kandi ko Kristo amurusha icuubahiro caane. Mu muco w'Abayuuda umurimo wo gupfunduura udushumi tw'ingato wari umurimo w'imbaata.</char></note> Uwo ni we uzaababatiriisha Umwuka Weera n'umuriro. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Intaara ye iri mu kuboko kwe, kandi azaazambuura imbuga ye caane, amasaka ayahunike mu kigega, naho umurama azaawucaaniisha umuriro utazima.” <verse eid="LUK 3:17" /><verse number="18" style="v" sid="LUK 3:18" />Yohaana akomeza kubwiriza abantu Ubutumwa Bwiza, kandi abashiishikariza guhindura imibeereho yaabo.<verse eid="LUK 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:19 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:3">Mat 14:3</ref>,<ref loc="MAT 14:4">4</ref>; <ref loc="MRK 6:17">Mar 6:17</ref>,<ref loc="MRK 6:18">18</ref>.</char>
    </note>Muri ico gihe, Yohaana acaaha umwami Herodi ku bwo gucuura Herodiyaasi muka mwene se, no ku bw'ibindi byaha yari yarakoze. <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />Maze Herodi akora ikindi caaha, afata Yohaana amushira mu gihome.<verse eid="LUK 3:20" /></para>
  <para style="s">Yesu Abatizwa</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mat 3:13-17</ref>; <ref loc="MRK 1:9-11">Mar 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Yohaana ataraashirwa mu nzu y'imbohe, yabatije Yesu n'abandi bantu benshi. Yesu amaze kubatizwa, arasenga, agisenga, ijuru rirakinguuka, <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" /><note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 9:35">Luk 9:35</ref>.</char></note>maze Umwuka Weera ava mu ijuru aramumanukira ari mu ishusho isa n'inuma. Maze ijwi ry'Imaana rivugira mu ijuru riti, “Ni wowe Mwana wanje nkunda nkakwishiimira.”<verse eid="LUK 3:22" /></para>
  <para style="s1">Amazina ya ba Seekuruza ba Yesu</para>
  <para style="r">(<ref loc="MAT 1:1-17">Mat 1:1-17</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Ubwo Yesu yatangiraga kwigiisha, yari amaze imyaka nka mirongo itatu avuutse. Nk'uko abantu biibwiraga ko ari we mwene Yozefu, mwene Heeli, <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />mwene Matati,</para>
  <para style="q1" vid="LUK 3:24">mwene Leevi, mwene Meluki,</para>
  <para style="q1" vid="LUK 3:24">mwene Yonaayi, mwene Yozefu,<verse eid="LUK 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 3:25" />mwene Matatiya, mwene Amosi,</para>
  <para style="q1" vid="LUK 3:25">mwene Nahumu, mwene Esili,</para>
  <para style="q1" vid="LUK 3:25">mwene Nagayi, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />mwene Mati,</para>
  <para style="q1" vid="LUK 3:26">mwene Matatiya, mwene Semeyini,</para>
  <para style="q1" vid="LUK 3:26">mwene Yoseki, mwene Yoda,<verse eid="LUK 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LUK 3:27" />mwene Yonani, mwene Resa,</para>
  <para style="q1" vid="LUK 3:27">mwene Zerubabeeli, mwene Shayalutiyeeli,</para>
  <para style="q1" vid="LUK 3:27">mwene Neeri, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />mwene Meluki,</para>
  <para style="q1" vid="LUK 3:28">mwene Adi, mwene Kosamu,</para>
  <para style="q1" vid="LUK 3:28">mwene Elumadamu, mwene Eri,<verse eid="LUK 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 3:29" />mwene Yosuwa, mwene Eliyezeeri,</para>
  <para style="q1" vid="LUK 3:29">mwene Yorimu, mwene Matati,</para>
  <para style="q1" vid="LUK 3:29">mwene Leevi, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />mwene Simiyooni,</para>
  <para style="q1" vid="LUK 3:30">mwene Yuda, mwene Yozefu,</para>
  <para style="q1" vid="LUK 3:30">mwene Yonamu, mwene Eliyakimu,<verse eid="LUK 3:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 3:31" />mwene Meleya, mwene Mena,</para>
  <para style="q1" vid="LUK 3:31">mwene Matata, mwene Natani,</para>
  <para style="q1" vid="LUK 3:31">mwene Dawudi, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />mwene Yese,</para>
  <para style="q1" vid="LUK 3:32">mwene Obedi, mwene Bowazi,</para>
  <para style="q1" vid="LUK 3:32">mwene Solomooni, mwene Nahashoni,<verse eid="LUK 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LUK 3:33" />mwene Amiinadabu, mwene Aruni,</para>
  <para style="q1" vid="LUK 3:33">mwene Hesirooni, mwene Peresi,</para>
  <para style="q1" vid="LUK 3:33">mwene Yuda, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />mwene Yaakobo,</para>
  <para style="q1" vid="LUK 3:34">mwene Isaaka, mwene Aburahamu,</para>
  <para style="q1" vid="LUK 3:34">mwene Tera, mwene Nahori,<verse eid="LUK 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LUK 3:35" />mwene Serugi, mwene Rewu,</para>
  <para style="q1" vid="LUK 3:35">mwene Pelegi, mwene Heberi,</para>
  <para style="q1" vid="LUK 3:35">mwene Shela, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />mwene Kenani,</para>
  <para style="q1" vid="LUK 3:36">mwene Alupakisadi, mwene Shemu,</para>
  <para style="q1" vid="LUK 3:36">mwene Nowa, mwene Lameki,<verse eid="LUK 3:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="LUK 3:37" />mwene Metuseera, mwene Henoki,</para>
  <para style="q1" vid="LUK 3:37">mwene Yeredi, mwene Mahalaleeli,</para>
  <para style="q1" vid="LUK 3:37">mwene Kenani, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />mwene Enoshi,</para>
  <para style="q1" vid="LUK 3:38">mwene Seeti, mwene Adamu, ukomooka ku Maana.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s1">Yesu Ageragezwa</para>
  <para style="r">(<ref loc="MAT 4:1-11">Mat 4:1-11</ref>; <ref loc="MRK 1:12-13">Mar 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Yesu amaze kubatizwa, yuzura Umwuka Weera. Nuuko ava ku ruuzi rwitwa Yorodaani, Umwuka amujaana mu butaayu, <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />amarayo iminsi mirongo ine ageragezwa na Sataani. Iyo minsi yayimaze atarya, nuuko ishize arasonza caane.<verse eid="LUK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3" />Nuuko umwanzi Sataani aramubwira ati, “Niiba koko uri Umwana w'Imaana tegeka iri buye umutsima.”<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />Yesu aramusubiza ati, “Ibyanditswe bivuga ngo, ‘Umuntu ntaabeeshwaho n'umutsima gusa.’ ”<verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />Nyuma y'aho umwanzi amujaana ku musozi mureemure caane, mu kaanya gato, amwereka ubwami bwose bw'iyi si. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />Aramubwira ati, “Ubu butware bwose n'icuubahiro byose ndabiguha, kuko nabihaawe kandi mbiha uwo niishaakiye. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Nuuko nuupfukama ukandamya, byose biraba ibyawe.”<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />Yesu aramusubiza ati, “Ibyanditswe biravuga ngo, ‘Uramye Uhoraho Imaana yaawe abe ari yo ukorera yoonyine.’ ”<verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />Umwanzi arongera amujaana i Yerusaalemu, amuhagarika ku munaara w'Inzu y'Imaana aramubwira ati, “Niiba koko uri umwana w'Imaana, simbukira haasi, <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />kuko byanditswe ngo:</para>
  <para style="q1" vid="LUK 4:10">‘Imaana izaagutegekera abaamalayika baayo bakurinde,<verse eid="LUK 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11" />kandi bazaagutegera amaboko ngo udakubita ikirenge caawe ku ibuye.’ ”<verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />Maze Yesu aramubwira ati, “Kandi byanditswe ngo, ‘Ntuukagerageze Uhoraho Imaana yaawe.’ ” <verse eid="LUK 4:12" /><verse number="13" style="v" sid="LUK 4:13" />Nuuko Sataani arangije kumugerageza muri byose, aramureka ngo azaamutege ikindi gihe.<verse eid="LUK 4:13" /></para>
  <para style="s1">Abantu b' i Nazaareeti Banga Yesu</para>
  <para style="r">(<ref loc="MAT 4:12-17">Mat 4:12-17</ref>; <ref loc="MRK 1:14-15">Mar 1:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Nyuma y'aho Yesu asubira i Galileeya aho yakuriye, ayobowe n'Umwuka w'Imaana. Nuuko amenyekana muri ibyo bice byose, <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />kandi akomeza kugenda yigiisha mu masinagoogi yaabo yoose. Abamwumviise boose baramuhimbaaza kandi baramushiima.<verse eid="LUK 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Nuuko Yesu aja i Nazaareeti aho yakuriye. Nk'uko yari amenyereye, ku munsi w'i Saabato aja mu isinagoogi. Arahaguruka ngo asome ijambo ry'Imaana. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />Bamuhereza umuzingo w'ibyanditswe n'umuhanuuzi Yesaaya, arambuura ahanditswe ngo,<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />“Umwuka w'Imaana ari kuri nje</para>
  <para style="q2" vid="LUK 4:18">kuko yantooranyirije kwamamaza Inkuru Nziiza mu bakene.</para>
  <para style="q1" vid="LUK 4:18">Yantumye kumenyeesha imbohe ko zibohoorwa,</para>
  <para style="q2" vid="LUK 4:18">n'impumyi ko zihumuuka,</para>
  <para style="q1" vid="LUK 4:18">kandi no kubohooza abarengana.<verse eid="LUK 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="LUK 4:19" />No kumenyeesha abantu igihe Imaana igiriyemo imbabazi.”<verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Arangije, azinga igitabo maze arakibasubiza, ariicara. Abantu boose mu isinagoogi bamuhanga amaaso. <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />Nuuko atangira kwigiisha ababwira ati, “Uyu munsi ibi byanditswe mbasomeye birasohoye kandi murabyiyumviye.”<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Abaari aho boose batangaazwa kandi bashimiishwa n'amagambo meeza y'ubuntu avuuye mu kanwa ke. Barabazanya bati, “Ariko uyu si mwene Yozefu?”<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />Na we arababwira ati, “Nzi neeza ko mwanshiraho uyu mugani muti, ‘Muvuuzi banza wivuure,’ Ibitangaaza twumviise ko wakoreye i Kaperenawumu ngaaho bikorere na hano iwaanyu.”<verse eid="LUK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 4:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:24 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 4:44">Yoh 4:44</ref>.</char>
    </note>Yesu arongera arababwira ati, “Ndababwira ukuri yuuko ari ntaamuhanuuzi ugira icuubahiro iwaabo. <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />Nimunyumve, mu gihe c'umuhanuuzi Eliya haariho abapfaakazi benshi mu gihugu ca Isirayeli, nuuko ijuru rirakingwa, imvura imara imyaka itatu n'ameezi atandatu itagwa, bituma haba inzara nyinshi mu gihugu. <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />Ariko Imaana ntiyohereje umuhanuuzi Eliya kuja kuri umwe mu bapfaakazi bo muri Isirayeli, uretse yamubwiye kuja ku mupfaakazi w'i Zarefaati haafi y'itawuni y'i Sidoni. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />Kandi mu gihugu c'Isirayeli haarimo ababembe benshi, mu gihe c'umuhanuuzi Elisa. Ariko Imaana ntiyakijije n'umwe muri bo uretse umubembe umwe gusa ari we Namani umunyamahanga w'i Siriya.”<verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />Abantu boose mu isinagoogi bamaze kumva ayo magambo, bagira uburaakari bwinshi. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Bahagurutswa no guhata Yesu ngo bamwirukane mu tawuni yaabo. Baramukurubana ngo bamutembagaze ku manga y'umusozi aho itawuni yaabo yari iri. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Ariko Yesu abacamo, arigendera.<verse eid="LUK 4:30" /></para>
  <para style="s1">Yesu Yirukana Dayimooni</para>
  <para style="r">(<ref loc="MRK 1:21-28">Mar 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Nuuko Yesu aramanuka aja i Kaperenawumu, indi tawuni y'i Galileeya. Ku Isaabato atangira kwigiisha abantu ijambo ry'Imaana. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" /><note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="MAT 7:28">Mat 7:28</ref>,<ref loc="MAT 7:29">29</ref>.</char></note>Maze abantu batangaarira kwigiisha kwe, kuko yavuganye ubutware n'ububaasha.<verse eid="LUK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33" />Mu isinagoogi haarimo umugabo wari uteewe na dayimooni, ateera heejuru ati, <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />“Ayii wee! Yesu w'i Nazaareeti, udushaakaho iki? Uzanywe no kuturimbura? Nzi ko uri Uweera w'Imaana.”<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />Maze Yesu ategeka dayimooni ati, “Ceceka! Muvemo!” Nuuko dayimooni imukubita haasi imbere ya boose, ariko ntiyashobora kumukomeretsa.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />Abantu boose birabatangaaza barabazanya bati, “Ni bushobozi ki, n'ubutware biri mu magambo ye, bituma ategeka abadayimooni bakava mu bantu bakamwumvira?” <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Maze iyo nkuru yamamazwa hoose mu matawuni hamwe n'impande z'ako gace.<verse eid="LUK 4:37" /></para>
  <para style="s1">Yesu Akiza Abantu Benshi</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat 8:14-17</ref>; <ref loc="MRK 1:29-34">Mar 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Yesu amaze kuva mu isinagoogi aja kwa Simooni. Agezeyo asanga nyirabukwe wa Simooni arwaye, afite umushwiza mwinshi. Maze abantu bamusaba kumukiza. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Yesu aramusanga, aramwegeera, ategeka umushwiza kumuvamo. Ako kaanya umuvamo, arakira. Na we arahaguruka maze arabafungurira.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Kuri uwo mugorooba izuuba rirenze, abantu boose bafite abarwayi barwaye indwara z'uburyo bwinshi babaazanira Yesu, abarambikaho ibiganza, umwe umwe arabakiza. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Nuuko abantu benshi baari bateewe n'abadayimooni, babavamo bateera heejuru bati, “Uri Umwana w'Imaana!” Ariko Yesu arabakabukira, ababuza kuvuga kuko baari baazi ko ari we Kristo.<verse eid="LUK 4:41" /></para>
  <para style="s1">Yesu Abwiriza mu Masinagoogi</para>
  <para style="r">(<ref loc="MRK 1:35-39">Mar 1:35-39</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Bukeeye mu gitondo, Yesu aja ahantu kwihereera, nuuko abantu benshi baaza kumushaaka. Bamuboonye, bagerageza kumubuza ngo ye kubasigaho. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />Ariko Yesu arababwira ati, “Nkwiriye kubwiriza Ubutumwa Bwiza bw'Ubwami bw'Imaana no mu zindi tawuni kuko ico ari co canzanye.” <verse eid="LUK 4:43" /><verse number="44" style="v" sid="LUK 4:44" />Nuuko Yesu akomeza kugenda hoose, avuga ubutumwa mu masinagoogi yoose y'i Yudeeya.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s1">Yesu Ahamagara Abiigiishwa ba Mbere</para>
  <para style="r">(<ref loc="MAT 4:18-22">Mat 4:18-22</ref>; <ref loc="MRK 1:16-20">Mar 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:1">Mat 13:1</ref>,<ref loc="MAT 13:2">2</ref>; <ref loc="MRK 3:9">Mar 3:9</ref>,<ref loc="MRK 3:10">10</ref>; <ref loc="MRK 4:1">4:1</ref>.</char>
    </note>Umunsi umwe, Yesu yigiishirizaga iruhande rw'ingezi yitwa Genezareeti.<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Mu ibindi byanditswe bayita </char><char style="fqa" closed="false">Ingezi ya Galileeya.</char></note> Abantu benshi bamubyiganiraho bashaaka kumva ijambo ry'Imaana. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Maze Yesu abona amaato abiri yo abarobyi baari baaziritse ku nkengeero y'ingezi, kuko boozaga ubutimba bwabo. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Yesu yinjira mu bwato bumwe muri ayo, bwari ubwa Simooni. Amusaba kubusunika ngo bwigire imbere mu maazi. Abwicaramo, maze yigiisha abantu.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />Arangije kuvuga, abwira Simooni ati, “Igiza ubwato imbere mu maazi mareemare maze ujugunye ubutimba ufate isamaaki.”<verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:5 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 21:3">Yoh 21:3</ref>.</char>
    </note>Simooni aramusubiza ati, “Daatabuja twakeesheje ijoro ryose dusoha nyamara ntaaco twafashe. Ariko kuko ubivuze ndasubira kubuteereramo.”<verse eid="LUK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:6 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 21:6">Yoh 21:6</ref>.</char>
    </note>Babikoze, bafata isamaaki nyinshi caane ubutimba buruuzura butangira guciika. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />Batabaaza bagenzi baabo baari mu bundi bwato, maze amaato yombi yuzura isamaaki yenda kurengerwa.<verse eid="LUK 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8" />Nuuko Simooni Peetero aboonye ibibaaye, apfukama imbere ya Yesu aravuga ati, “Nyagasani, va aho ndi, kuko ndi umunyabyaha, sinkwiriye kukwegeera.” <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />Ibi yabivuze kuko yari atangaajwe n'ubwinshi bw'isamaaki, zo we na bagenzi be baari baafashe. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />Bagenzi be ari bo Yaakobo na Yohaana beene Zebedaayo na bo birabatangaaza.</para>
  <para style="p" vid="LUK 5:10">Yesu abwira Simooni ati, “wiitiinya, uheereye noone, uzaaja uroba abantu.” <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />Bamaze kugeza amaato yaabo ku nkengeero, basiga byose bakurikira Yesu.<verse eid="LUK 5:11" /></para>
  <para style="s1">Yesu Akiza Umubembe</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat 8:1-4</ref>; <ref loc="MRK 1:40-45">Mar 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Igihe kimwe, Yesu ari mu tawuni, haaza umugabo wari urembejwe n'ibibembe. Aboonye Yesu, apfukama imbere ye aramwinginga ngo amukize. Aramubwira ati “Nyagasani, ubishaatse wanyeza ngakira.”<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />Yesu aramwegeera maze amukoraho, aravuga ati, “Ndabishaaka kira.” Muri ako kaanya bya bibembe birakira.<verse eid="LUK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14" />Yesu amutegeka kutagira uwo abibwira. Arongera aramubwira ati, “Genda, wiyereke umuheerezabitambo kugira ngo agusuuzume maze utange n'igitambo nk'uko biri mu mategeko ya Moose ku bahumaanutse, bibabeere ubuhamya yuuko wakize.” <note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">Moose asobaanuura ayo mategeko mu Baleewi 14:1-32</char></note><verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />Nyamara inkuru ya Yesu irushaho kwamamara hoose, maze abantu benshi baazanwa no kumwumva hamwe no gukizwa indwara zaabo. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Ariko Yesu we, yabavagamo akaja kwihereera mu butaayu gusenga.<verse eid="LUK 5:16" /></para>
  <para style="s1">Yesu Akiza Umurema</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat 9:1-8</ref>; <ref loc="MRK 2:1-12">Mar 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Umunsi umwe Yesu ari kwigiisha, Abafarisaayo n'abiigiishamategeko baturutse impande zoose z'i Galileeya, i Yudeeya hamwe n'i Yerusaalemu biicara muri rubanda nyamwinshi bumviriza. Kandi ububaasha bw'Imaana bwo gukiza bwari kuri we. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />Nuuko haaza abagabo baheetse umurema mu ngobyi, bashaaka uburyo baamushikiriza Yesu, <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />ariko ntibabishobora kuko abantu baari benshi caane. Nuuko babuze uburyo bamwinjiza, buurira inzu<note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="ft" closed="false">Muri ico gihe, abantu bo mu Isirayeri buubakaga amazu y'impara kandi afite amadaara hanze yo kuuririraho baja heejuru y'inzu.</char></note> basambuuraho amatebura make, bamwururutsa mu ngobyi bamushira hagati y'abantu imbere ya Yesu.<verse eid="LUK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20" />Aboonye kwizeera kwabo kwinshi, abwira uwo murema ati, “Nshuti yanje ibyaha byawe urabibabariwe.”<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />Abafarisaayo n'abiigiishamategeko batangira kubazanya bati, “Uyu ni nde wigereranya n'Imaana? Imaana yoonyine si yo ishobora kubabarira ibyaha?”<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Yesu amenye ibiteekerezo byabo arababaza ati, “Kuki muteekereza mutyo? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Mbese icooroshe ni ikiihe? Ni ukuvuga ngo ibyaha byawe urabibabariwe, cangwa ngo haguruka ugende? <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Ariko ndababwira yuuko Umwana w'Umuntu afite ububaasha bwo kubabarira ibyaha kuri iyi si.” Yesu abwira uwo murema ati, “Haguruka, wikorere ingobyi yaawe ugende.” <verse eid="LUK 5:24" /><verse number="25" style="v" sid="LUK 5:25" />Ako kaanya uwo mugabo arabaduka afata ingobyi ye boose babireeba, asubira iwe ahimbaaza Imaana. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />Boose baratangaara, bahimbaaza Imaana kandi bagira ubwoba baravuga bati, “Uyu munsi tuboonye ibitangaaje!”<verse eid="LUK 5:26" /></para>
  <para style="s1">Yesu Ahamagara Leevi Umusoreesha</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat 9:9-13</ref>; <ref loc="MRK 2:13-17">Mar 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Nyuma y'ibyo, Yesu abona umusoreesha witwaga Leevi yiicaye aho yakoreraga. Yesu aramubwira ati, “Nkurikira.” <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Leevi arahaguruka asiga ibye byose aramukurikira.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />Nuuko Leevi atumira Yesu amujaana iwe, habayo ibirori. Bamwe mu bashitsi baasangiraga na we baari abasoreesha n'abandi bantu. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" /><note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="LUK 15:1">Luk 15:1</ref>,<ref loc="LUK 15:2">2</ref>.</char></note>Ariko Abafarisaayo n'abiigiishamategeko baabo, bagiisha impaka abiigiishwa ba Yesu bati, “Ni kuki musangira n'abasoreesha hamwe n'abanyabyaha?”<verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />Yesu arabasubiza ati, “Abazima si bo biifuuza umuvuuzi ahuubwo abarwayi ni bo bamukeneye. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />Sinaaje mu isi guhamagara intungaane, ahuubwo naaziye abanyabyaha ngo biihane.”<verse eid="LUK 5:32" /></para>
  <para style="s1">Yesu Yiigiisha Ibyerekeye Kwiyiriza Ubusa</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat 9:14-17</ref>; <ref loc="MRK 2:18-22">Mar 2:18-22</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Abantu baramubwira bati, “Abiigiishwa ba Yohaana Umubatiza biiyiriza ubusa, bagasenga kandi n'abiigiishwa b'Abafarisaayo na bo ni uko. Ni kuki abiigiishwa baawe bo, bakomeza kwiriira no kwinywera?”<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />Yesu arabasubiza ati, “Mbese abashitsi baakwiyiriza ubusa bakiri kumwe n'umukwe biishiima? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Ariko igihe umukwe azaabakuurwaho, ni bwo baziiyiriza ubusa.”<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />Maze Yesu abaciira umugani ati, “Ntaamuntu ushobora gutandura ikiremu ku mwenda musha ngo agiteere ku mwenda ushaaje. Uwakora atyo, yaba yangirije umwenda musha, kandi umwenda ushaaje na wo yatuma uciika naabi bikabije. Nuuko reero ikiremu gisha nticaahwana n'umwenda ushaaje. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Kandi ntaawe ushobora gusuka divaayi nsha mu mifuka y'impu ishaaje. Uwakora atyo, divaayi nsha yaaturitsa iyo mifuka y'impu maze divaayi igasandaara haasi, n'iyo mifuka y'impu ikonoonekara. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Ahuubwo divaayi nsha isukwa mu mifuka y'impu misha. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Kandi ntaawakwifuuza kunywa divaayi nsha amaze kunywa divaayi ikuze, ahuubwo yavuga ati, ‘Ikuze ni yo nziiza caane.’ ”<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s1">Yesu Yiigiisha Ibyerekeye Isaabato</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat 12:1-8</ref>; <ref loc="MRK 2:23-28">Mar 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Igihe kimwe, Yesu n'abiigiishwa be banyura mu mirima irimo imyaka y'impeke ku munsi w'i Isaabato. Abiigiishwa be baca amahundo bayavungira mu ntoki barayakenya. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Abafarisaayo baari aho barababaza bati, “Kuki mukora ico amategeko yaacu ateemera ku munsi w'Isaabato?”<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />Yesu arabasubiza ati, “Mbese ntimwari mwasoma ibyo Dawudi n'abantu baari kumwe na we baakoze ubwo baari bashonje? <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />Yagiiye mu Nzu y'Imaana, ashikiira umugaati wejejwe, arawurya, ahaho n'abaari kumwe na we, kandi wari ugenewe abaheerezabitambo.” <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />Yesu arongera arababwira ati, “Umwana w'Umuntu, n'Umwami w'Isaabato.”<verse eid="LUK 6:5" /></para>
  <para style="s1">Yesu Akiza Umuntu Unyuunyuutse Ukuboko</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat 12:9-14</ref>; <ref loc="MRK 3:1-6">Mar 3:1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Nuuko ku yindi Saabato, Yesu aja mu isinagoogi ariigiisha. Muri iryo teeraniro haarimo umugabo unyunyutse ukuboko kw'iburyo. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Abiigiishamategeko n'Abafarisaayo bakomeza kureebuuza Yesu ngo bareebe niiba ari bumukize ku munsi w'Isaabato maze babone uburyo bamurega. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Ariko Yesu amenya ibiteekerezo byabo, abwira uwari unyunyutse ukuboko ati, “Haguruka, uhagarare aho boose bakureeba.” Uwari unyunyutse ukuboko arahaguruka abigenza atyo.<verse eid="LUK 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9" />Nuuko Yesu abwira Abafarisaayo n'abiigiishamategeko ati, “Reka mbabaze, mbese amategeko atwemerera gukora iki ku Saabato? Neeza, cangwa naabi, kwica cangwa gukiza?”<verse eid="LUK 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10" />Yesu arabareeba maze abwira uwari urwaye ati, “Rambuura ukuboko kwawe.” Nuuko arakurambuura kurakira. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />Babiboonye buuzura uburaakari bwinshi, batangira kuja imigambi y'uko bazaamugenza.<verse eid="LUK 6:11" /></para>
  <para style="s1">Yesu Atooranya Intumwa Cumi n'Ebyiri</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat 10:1-4</ref>; <ref loc="MRK 3:13-19">Mar 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Haanyuma y'ibyo, Yesu aja ku musozi gusenga, akeesha ijoro ryose asenga Imaana. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Bukeeye, ahamagara abiigiishwa be atooranyamo cumi na babiri, abagira intumwa. <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Amazina yaabo, ni Simooni wo yiise Peetero, na Andereya mwenenyina, na Yaakobo, na Yohaana, na Filipo, na Batulumaayo, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />na Matayo na Tomasi na Yaakobo mwene Alufaayo, na Simooni witwaga Umurwanashaka, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />na Yuda mwene Yaakobo, na Yuda Isikariyoti wamugambaaniye.<verse eid="LUK 6:16" /></para>
  <para style="s1">Yesu Yiigiisha Abantu kandi Akiza Abarwayi</para>
  <para style="r">(<ref loc="MAT 4:23-25">Mat 4:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Nuuko Yesu n'abiigiishwa be bamanuka umusozi, ahagarara aharinganiye ari kumwe n'abayoboke be n'abandi bantu benshi baari baturutse i Yudeeya n'i Yerusaalemu hoose, no mu bice by'i tawuni y'i Tiiro n'i Sidoni bihereeranye n'inyanja nini. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />Abo bantu benshi baari baaje kumwumva no gukizwa indwara. Abaari bateewe n'imyuka mibi, na bo barakira. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Abantu boose baashaakaga kumukoraho kuko imbaraga zaamuvagamo zikabakiza. Yari afite ububaasha bwo gukiza buri weese.<verse eid="LUK 6:19" /></para>
  <para style="s1">Umuneezeero hamwe n'Agahinda</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Nuuko Yesu arakebuka areeba abiigiishwa be arababwira ati,</para>
  <para style="q1" vid="LUK 6:20">“Murahiirwa mwebwe abakene,</para>
  <para style="q2" vid="LUK 6:20">kuko Ubwami bw'Imaana ari ubwanyu.<verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />Murahiirwa mwebwe abashonje ubu</para>
  <para style="q2" vid="LUK 6:21">kuko muzaahaazwa.</para>
  <para style="q1" vid="LUK 6:21">Murahiirwa mwebwe abarira ubu</para>
  <para style="q2" vid="LUK 6:21">kuko muzaaseka.<verse eid="LUK 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 6:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:22 </char>
      <char style="xt" closed="false">
        <ref loc="1PE 4:14">1Pet 4:14</ref>.</char>
    </note>Murahiirwa abantu niibabanga, bakabahinyura, bakabatuka, bakabavuga naabi babahoora kuba abayoboke b'Umwana w'Umuntu. <verse eid="LUK 6:22" /><verse number="23" style="v" sid="LUK 6:23" /><note caller="-" style="x"><char style="xo" closed="false">6:23 </char><char style="xt" closed="false"><ref loc="ACT 7:52">Iby 7:52</ref>.</char></note>Bazaabakorera naabi nk'uko baaseekuruza baabo baagenjeje abahanuuzi. Ico gihe muziishiime kandi muneezeerwe kuko ingororano zaanyu ari nyinshi mu ijuru.<verse eid="LUK 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />Muzaabona ishano mwebwe abakire,</para>
  <para style="q2" vid="LUK 6:24">kuko mumaze kudamarara.<verse eid="LUK 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25" />Muzaabona ishano mwebwe abahaaze ubu,</para>
  <para style="q2" vid="LUK 6:25">kuko muzaasonza.</para>
  <para style="q1" vid="LUK 6:25">Muzaabona ishano mwebwe abaseka ubu</para>
  <para style="q2" vid="LUK 6:25">kuko muzaaganya muborooga.<verse eid="LUK 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26" />Muzaabona ishano ubwo abantu bazaabavuga neeza,</para>
  <para style="q2" vid="LUK 6:26">uko ni ko baaseekuruza baabo baavuze ibyiza ku bahanuuzi b'ibinyoma.”<verse eid="LUK 6:26" /></para>
  <para style="s1">Gukunda Ababanga</para>
  <para style="r">(<ref loc="MAT 5:38-48">Mat 5:38-48</ref>; <ref loc="MAT 7:12a">7:12a</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />“Ndababwira mwese abaanyumva, mukunde abanzi baanyu, mugirire neeza ababanga, <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />musabire umugisha ababavuma, musengere ababarenganya. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Nihagira ugukubita ku musaya, umuhindurire n'undi. Nihagira ukwambura ikooti, ntuuzamwime n'isaati yaawe. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Ugusabye weese umuhe, ukwambuye ibyawe ubimurekere. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" /><note caller="-" style="x"><char style="xo" closed="false">6:31 </char><char style="xt" closed="false"><ref loc="MAT 7:12">Mat 7:12</ref>.</char></note>Kandi uko mushaaka ko abantu babagirira, abe ari ko namwe mubagirira.<verse eid="LUK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32" />Ntimuuzi yuuko abanyabyaha na bo bakunda ababakunda, noone se muzaashiimirwa iki nimukunda ababakunda gusa? <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Nimwituura ineeza abayibagirira gusa muzaashiimirwa iki? Abanyabyaha bo ntibagirira ineeza abayibagirira? <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Nimuguza abo muteekereza ko bazaabiishura muzaashiimirwa iki? Abanyabyaha bo ntibaguza abandi biizeeye ko bazaabiishura? <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />Ahuubwo mukunde abanzi baanyu, mubagirire neeza, muguze abantu mudateekereza ko bazaabiishura, ni ho ingororano zaanyu zizaaba nyinshi. Muziitwa abaana b'Imaana, kuko igirira neeza ababi n'abeeza.”<verse eid="LUK 6:35" /></para>
  <para style="s1">Ibyerekeye Guciira Abandi Urubanza</para>
  <para style="r">(<ref loc="MAT 7:1-5">Mat 7:1-5</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 6:36" />“Mugirire abandi impuhwe nk'uko So na we ari umunyampuhwe. <verse eid="LUK 6:36" /><verse number="37" style="v" sid="LUK 6:37" />Ntimugaciire abandi imanza kugira ngo namwe Imaana itazaabaciira urubanza. Ntimugashinje abandi, kugira ngo namwe itazaabashinja. Mubabarire bagenzi baanyu, namwe Imaana izaabababarira. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Mutange namwe muzaahaabwa. Urugero rwiza rutsindagiye, rucugushije kandi ruseesekaye ni rwo muzaagererwamo namwe. Urugero mugeramo ni rwo namwe muzaagererwamo.”<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 15:14">Mat 15:14</ref>.</char>
    </note>Yesu abaciira umugani ati, “Mbese impumyi yabaasha kurandata indi mpumyi? Bombi ntibaagwa mu rwobo? <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" /><note caller="-" style="x"><char style="xo" closed="false">6:40 </char><char style="xt" closed="false"><ref loc="MAT 10:24">Mat 10:24</ref>,<ref loc="MAT 10:25">25</ref>; <ref loc="JHN 13:16">Yoh 13:16</ref>; <ref loc="JHN 15:20">15:20</ref>.</char></note>Umwigiishwa ntaaruta umwigiisha, ahuubwo umwigiishwa weese wiigiishijwe neeza, azaamera nk'umwigiisha we.<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />Ni iki gituma ureeba agatotsi kari mu ijiisho rya mugenzi waawe ariko ukiirengagiza umugogo uri mu ijiisho ryawe? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Wabaasha ute kubwira mugenzi waawe uti, ‘Mwene daata, reka ngutokoore agatotsi kari mu ijiisho ryawe?’ Kandi naawe ubwawe utaareeba umugogo uri mu ryawe? Wa ndyarya we, banza witokoore umugogo uri mu ijiisho ryawe ubone uko utokoora agatotsi kari mu ijiisho rya mugenzi waawe.”<verse eid="LUK 6:42" /></para>
  <para style="s1">Igiti n'Imbuto Zaaco</para>
  <para style="r">(<ref loc="MAT 7:16-20">Mat 7:16-20</ref>; <ref loc="MAT 12:33-35">12:33-35</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />Yesu akomezamo ati, “Igiti ciiza nticeera imbuto mbi, n'igiti kibi nticeera imbuto nziiza. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" /><note caller="-" style="x"><char style="xo" closed="false">6:44 </char><char style="xt" closed="false"><ref loc="MAT 12:33">Mat 12:33</ref>.</char></note>Igiti coose kirangwa n'imbuto zaaco. Erega, ntaamuntu wasoroma imbuto z'igiti c'umutiini ku giti c'amahwa, cangwa ngo asorome imbuto z'imizaabibu ku mifatangwe. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" /><note caller="-" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Mat 12:34</ref>.</char></note>Umuntu mwiza, avaana mu mutima we ibyiza bibitswemo, naho umuntu mubi, akawuvaanamo ibibi. Ibyuzuye umutima ni byo akanwa kavuga.”<verse eid="LUK 6:45" /></para>
  <para style="s1">Abuubatsi Babiri</para>
  <para style="r">(<ref loc="MAT 7:24-27">Mat 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />Yesu arababaza ati, “Ni kuki mumpamagara muti, ‘Nyagasani, Nyagasani, ariko ntimukore ibyo mbabwira?’ <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Umuntu weese unkurikira, akumva amagambo yanje, akayakurikiza, ameze atya: <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />Ni nk'umuntu wubatse inzu, agacukura haasi caane, akuubaka urufatiro ku rutare. Umwuzure utembera kuri iyo nzu, ariko ntiwabaasha kuyinyeganyeza, kuko yubatswe ku rutare. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Naho umuntu wumva ibyo mvuga ntaabikurikize ameze nk'uwuubatse inzu ku butaka, ntiyuubake urufatiro. Umwuzure uje, uteera iyo nzu, iheerako iragwa kandi ihinduka ubushingwe.”<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Umutware w'Abasirikare Yizeera Yesu</para>
  <para style="r">(<ref loc="MAT 8:5-13">Mat 8:5-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Yesu amaze kubwira abantu ibyo byose, aja mu tawuni yitwa Kaperenawumu. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />Iyo haariyo mukuru w'abasirikare wari ufite umugaragu wo yakundaga caane kandi uwo mugaragu yari arwaye ari haafi gupfa. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Uwo mutware yumviise inkuru ya Yesu, atuma abakuru b'Abayuuda ngo binginge Yesu, aze akize uwo mugaragu. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Bageze aho Yesu ari, baramwinginga bati, “Uyu mutware akwiriye ubufasha bwawe, <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />kuko akunda ubwoko bwacu bw'Abayuuda ndetse yaritanze atwubakira isinagoogi.”<verse eid="LUK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6" />Nuuko Yesu ajaana na bo. Bari haafi kugera iwe, uwo musirikare atuma bamwe mu nshuti ze ngo bamubwire bati, “Nyagasani, ntiwiirushe kuko ntibinkwiriye ko wakwinjira mu nzu yanje. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Ndetse nanje ubwanje nteekereza ko bitankwiriye kuuza aho uri. Ahuubwo tegeka nuuko umugaragu wanje arakira. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Dore nanje ndi umuntu utwarwa n'abandi nkabumvira, kandi mfite abasirikare ntegeka bakanyumvira. Iyo mbwiye umwe nti, ‘Genda’ aragenda. Naabwira undi nti, ‘Ngwino’ akaaza.”<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Yesu abyumviise, biramuneezeeza caane, atangaazwa n'amagambo y'uwo mutware. Maze arakebuka abona abantu benshi bamukurikiye arababwira ati, “Sindaabona ukwizeera kungana gutya haaba no mu Isirayeli.” <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />Abo baari baatumwe basubirayo, bageze mu nzu, basanga wa mugaragu yakize.<verse eid="LUK 7:10" /></para>
  <para style="s1">Yesu Azuura Umwana w'Umupfaakazi</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Haanyuma y'ibyo, Yesu aja mu tawuni yitwa Nayini. Abiigiishwa be n'abantu benshi bajaana na we. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Ageze haafi y'irembo<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="ft" closed="false">Keera buri tawuni yagiraga uruzitiro ruyizengurutse kandi hakabaho irembo.</char></note> ahuura n'abantu benshi baheetse umurambo bagiiye guhamba. Uwari wapfuuye yari umwana w'umuhungu w'ikinege, kandi nyina yari umupfaakazi. Abantu benshi bo muri iyo tawuni baari kumwe na we. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Yesu aboonye uwo mupfaakazi amugirira impuhwe nyinshi, aramubwira ati, “Wirira.”<verse eid="LUK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14" />Maze yeegeera ingobyi yari irimo umupfu, ayikoraho nuuko abari baheetse barahagarara. Aravuga ati, “Musore, ndagutegetse haguruka.” <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Uwari wapfuuye areeguuka, ariicara atangira kuvuga. Maze Yesu amusubiza nyina.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />Abantu boose babiboonye bigira ubwoba, bahimbaaza Imaana bavuga bati, “Umuhanuuzi ukomeye yatugezemo.” Naho abandi bati, “Imaana igendereye ubwoko bwayo uyu munsi.” <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />Nuuko inkuru y'ibyo Yesu yakoze yamamara mu gihugu c'i Yudeeya, no mu bindi bice byose bihahereereye.<verse eid="LUK 7:17" /></para>
  <para style="s1">Yohaana Umubatiza Atuma Abiigiishwa Be kuri Yesu</para>
  <para style="r">(<ref loc="MAT 11:2-19">Mat 11:2-19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Abiigiishwa ba Yohaana Umubatiza bamuteekerereza ibyo Yesu yakoraga byose. <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />Maze Yohaana atuma babiri mu biigiishwa be kuri Yesu ngo bamubaze bati, “Mbese ni wowe Kristo cangwa dutegereze undi?”<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />Abo biigiishwa baragenda, bageze aho Yesu ari, baramubaza bati, “Yohaana Umubatiza aradutumye ngo tukubaze niiba ari wowe Kristo, cangwa niiba tugomba gutegereza undi”<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />Ako kaanya Yesu akiza abantu benshi baari barwaye indwara zitari zimwe. Abohoora abateewe n'abadayimooni, n'ibyago, ndetse ahumuura n'impumyi. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Yesu arababwira ati, “Musubireyo maze mubwire Yohaana ibyo muboonye hamwe n'ibyo mwumviise. Mumubwire yuuko impumyi zihumuuka, abacumbagira bakagenda neeza, ababembe bagakira, abapfaamatwi barumva, abaapfuuye barazuurwa kandi abakene barabwirizwa Ubutumwa Bwiza. Kandi muti, <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />‘Hahiirwa umuntu weese udashidiikanya ibyanje.’ ”<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Abiigiishwa ba Yohaana bamaze gusubirayo, Yesu atangira kubwira abantu ibya Yohaana Umubatiza ati, “Mwajanywe mu butaayu no kureeba iki? Mwagiiye mu butaayu kureeba urubingo ruhungabanywa n'umuyaga? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Noone se mwajanywe no kureeba iki? Ni umuntu wambaye imyenda myiza y'abarimbyi yoroheereye? Oya, kuko abambara imyenda nk'iyo n'abarimbyi bagaburirwa neeza baba ibwami. <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Ngaaho nimumbwire, mwagiiye mu butaayu kureeba iki? Umuhanuuzi? Ni koko ni umuhanuuzi, ndetse aruta abandi bahanuuzi.” <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />Yohaana ni we wavuzweho mu byanditswe ngo,</para>
  <para style="q1" vid="LUK 7:27">“Dore ngiiye gutuma intumwa yanje mbere yaawe,</para>
  <para style="q2" vid="LUK 7:27">integuuza izaakubanziriza kugira ngo itunganye inzira yaawe.”<verse eid="LUK 7:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="LUK 7:28" />Yesu arongera aravuga ati, “Ndababwira yuuko mu baabyawe n'umugore, ntaan'umwe uruta Yohaana. Ariko umuntu wiciisha bugufi kandi woroheje mu Bwami bw'Imaana ni we umuruta.”<verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:29 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:32">Mat 21:32</ref>; <ref loc="LUK 3:12">Luk 3:12</ref>.</char>
    </note>Abasoreesha n'abandi bantu boose bumviise ayo magambo, beemera ko Imaana idaca urwa kibeera kuko baari baarabatijwe na Yohaana. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Ariko Abafarisaayo hamwe n'abiigiishamategeko bakuru ntaabwo beemeye imigambi y'Imaana kuko banze umubatizo wa Yohaana.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />Yesu akomeza kubabwira ati, “Mbese abantu b'iki gihe naabagereranya n'iki? Kandi bahwanye n'iki? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Bameze nk'abaana bato biicaye mu iguriro bakina, bahamagarana, bavuga bati,</para>
  <para style="q1" vid="LUK 7:32">‘Twabavugirije inanga,</para>
  <para style="q2" vid="LUK 7:32">ntimwabyina,</para>
  <para style="q1" vid="LUK 7:32">twaririmbye indirimbo z'umubabaro,</para>
  <para style="q2" vid="LUK 7:32">ariko ntimwarira.’ ”<verse eid="LUK 7:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="LUK 7:33" />Yesu arababwira ati, “ ‘Dore Yohaana Umubatiza yaaje atarya umutsima ndetse atanywa na divaayi, muravuga ngo afite dayimooni.’ <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Umwana w'Umuntu aje arya, ndetse anywa, muravuga ngo, ‘Nimureebe iki gisambo, umusinzi kandi inshuti y'abasoreesha n'abanyabyaha!’ <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Nyamara ubwenge bw'Imaana bugaragazwa n'ababwemera boose ko ari ubw'ukuri.”<verse eid="LUK 7:35" /></para>
  <para style="s1">Umugore Asiiga Yesu Amavuta</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Umwe mu Bafarisaayo witwaga Simooni, araarika Yesu ngo basangire. Nuuko Yesu yinjira mu nzu ye ariicara ngo arye. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" /><note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="MAT 26:7">Mat 26:7</ref>; <ref loc="MRK 14:3">Mar 14:3</ref>; <ref loc="JHN 12:3">Yoh 12:3</ref>.</char></note>Maze umugore wari umunyabyaha wo muri iyo tawuni amenye inkuru ko Yesu ari buriire muri iyo nzu y'Umufarisaayo, azana agacupa k'amavuta ahuumura neeza. <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />Maze ahagarara nk'inyuma iruhande rw'ibirenge bya Yesu, arira atonyanza amarira ku birenge bya Yesu kandi abihanaguza umusatsi we. Akomeza no kumusoma ibirenge, abisiiga ya mavuta ahuumura neeza.<verse eid="LUK 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39" />Nuuko Umufarisaayo wari waraaritse Yesu abiboonye arashoberwa, ariibaza ati, “Iyo uyu muntu aba ari umuhanuuzi, aba amenye yuuko uyu mugore umukozeho ari umunyabyaha.”<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Yesu aramusubiza ati, “Simooni hari ico niifuuza kukubwira.”</para>
  <para style="p" vid="LUK 7:40">Maze Simooni aramusubiza ati, “Yeego mwigiisha mbwira.”<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />Yesu aramubwira ati, “Haari umuntu wagujije abantu babiri amashilingi. Umwe amuha amashilingi angana imibyizi magana ataanu. Naho undi amuguza amashilingi angana imibyizi mirongo itaanu gusa. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Ariko abo bantu bombi ntaan'umwe washoboye kwishura. Maze uwabagujije arabababarira. Noone Simooni ndakubaza, muri abo babiri, ni nde warushije mugenzi we gukunda nyakubaguza?”<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />Simooni aramusubiza ati, “Nteekereza ko ari uwo yababariye umwenda munini.”</para>
  <para style="p" vid="LUK 7:43">Yesu aramubwira ati, “Uvuze ukuri.”<verse eid="LUK 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 7:44" />Yesu arakebuka areeba wa mugore, nuuko abwira Simooni ati, “Urareeba uyu mugore? Ninjiye mu nzu yaawe, ntiwampa amaazi yo gukaraba ibirenge. Ariko we, yabikarabishije amarira kandi abisiimuuza umusatsi we.” <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Ntaabwo wigeze kumpoobera unyakiira, ariko aho uyu mugore yagereye hano, ntaabwo yigeze ahwema kunsoma ibirenge antabaarutsa. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />Ntaabwo wigeze unsiiga amavuta mu mutwe, ariko uyu mugore we ansiize amavuta ahuumura neeza ku birenge. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Ndababwira yuuko uyu mugore ababariwe ibyaha bye byinshi. Ni co gitumye anyeretse urukundo rwinshi amfitiye. Ariko umuntu weese ubabariwe bike, agira urukundo ruke.<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />Yesu abwira uwo mugore ati, “Ibyaha byawe urabibabariwe.”<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Nuuko abantu baasangiraga na Yesu, batangira kwibaza bati, “Uyu ni nde uhangaara kubabarira abantu ibyaha?”<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />Yesu abwira uwo mugore ati, “Kwizeera kwawe kuragukijije genda amahoro.”<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s1">Abagore Baajaanaga na Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Nyuma y'ibyo, Yesu aja mu matawuni no mu byaro yaamamaza Ubutumwa Bwiza bw'Ubwami bw'Imaana kandi yari kumwe n'abiigiishwa be cumi na babiri <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" /><note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 27:55">Mat 27:55</ref>,<ref loc="MAT 27:56">56</ref>; <ref loc="MRK 15:40">Mar 15:40</ref>,<ref loc="MRK 15:41">41</ref>; <ref loc="LUK 23:49">Luk 23:49</ref>.</char></note>hamwe n'abagore bamwe bo yari yarakijije indwara n'abadayimooni. Abo bagore baarimo, Mariya wiitwaga Magadaleena wo Yesu yakijije abadayimooni barindwi, <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />na Yowana umugore wa Ekuza wari umukozi mukuru wa Herodi, na Suzaana, hamwe n'abandi bagore benshi. Boose hamwe, baakoraga ku byabo bagafasha Yesu n'abiigiishwa be.<verse eid="LUK 8:3" /></para>
  <para style="s1">Umugani w'Umubibyi</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat 13:1-9</ref>; <ref loc="MRK 4:1-9">Mar 4:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Nuuko abantu benshi baari baturutse mu matawuni atari amwe baaza aho Yesu ari barakungaana. Nuuko Yesu abaciira umugani ati, <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />“Umubibyi yasohoye imbuto aja kubiba. Akibiba, zimwe zigwa mu nzira abantu barazikandagira n'inyoni zo mu kireere zirazitooragura. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Izindi zigwa ku rutare ziramera. Zimaze kumera, ziruuma kuko zaabuze amaazi. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Izindi mbuto zigwa mu mahwa, zikurana na yo, bituma zinyunyuka. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Izindi zigwa mu butaka bwiza, zeera imbuto nyinshi, buri imwe ikubiishamo inshuro ijana.”</para>
  <para style="p" vid="LUK 8:8">Yesu amaze kuvuga ibyo, abwira abantu ati, “Ufite amatwi yumva niyumve.”<verse eid="LUK 8:8" /></para>
  <para style="s1">Ikigendererwa c'Imigani</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat 13:10-17</ref>; <ref loc="MRK 4:10-12">Mar 4:10-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Nuuko abiigiishwa bamusaba kubasobaanurira ico uwo mugani umenyeesha. <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />Yesu arababwira ati, “Mwebweho mwahaawe kumenya amabanga y'Ubwami bw'Imaana, ariko abandi bo babibwirwa mu marenga kugira ngo</para>
  <para style="q1" vid="LUK 8:10">‘kureeba bareebe, ariko beekubibona.</para>
  <para style="q2" vid="LUK 8:10">Kandi no kumva bumve, ariko beegusobaanukirwa.’ ”<verse eid="LUK 8:10" /></para>
  <para style="s1">Yesu Asobaanura Umugani w'Umubibyi</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat 13:18-23</ref>; <ref loc="MRK 4:13-20">Mar 4:13-20</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />Nuuko Yesu akomeza kubabwira ati, “Uku ni ko uwo mugani usobaanurwa: Imbuto ni ijambo ry'Imaana. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Imbuto zaaguuye mu nzira, ni abumva ijambo ry'Imaana maze Sataani akaaza akarikuura mu mitima yaabo kugira ngo batizeera bagakizwa. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Izaaguuye ku rutare, ni abo baakiira ubutumwa n'umuneezeero, ariko ntibakomerere muri bwo. Abo bantu biizeera umwanya muto haanyuma baagera mu bigeragezo bakava mu kwizeera. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Imbuto zaaguuye mu muhwa, ni abo bumva ubutumwa ariko bagikomezamo bagasubizwa inyuma n'amaganya, n'ubutunzi, hamwe n'ibineezeeza byo muri ubu bugingo bikababuza kwera imbuto. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />Naho imbuto zaaguuye ku butaka bwiza, ni abo bumva ijambo ry'Imaana bakarifata neeza, n'umutima wubaha kandi unyuzwe, ku bwo kwihangaana bakeera imbuto.”<verse eid="LUK 8:15" /></para>
  <para style="s1">Itaara Ryubitsweho Intonga</para>
  <para style="r">(<ref loc="MRK 4:21-25">Mar 4:21-25</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">Mat 5:15</ref>; <ref loc="LUK 11:33">Luk 11:33</ref>.</char>
    </note>Nuuko Yesu arababwira ati, “Ntaawe ukongeeza itaara, ngo aryubikeho intonga cangwa ngo arishire muusi y'uburiri kuko ntiryamurikira abantu. Ahuubwo rishirwa ahagaragara kugira ngo abantu boose baaza mu nzu ribamurikire. <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" /><note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="MAT 10:26">Mat 10:26</ref>; <ref loc="LUK 12:2">Luk 12:2</ref>.</char></note>Ndababwira ukuri yuuko ntaabyahishwe bitazaahishuurwa, cangwa icaakorewe mu ibanga kitazaamenyekana. <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" /><note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="MAT 25:29">Mat 25:29</ref>; <ref loc="LUK 19:26">Luk 19:26</ref>.</char></note>Nuuko reero mwirinde uko mwumva aya magambo. Abo bafite bazongeererwa, ariko abadafite, bazaakwa n'ako bateekereza ko bafite.”<verse eid="LUK 8:18" /></para>
  <para style="s1">Nyina wa Yesu n'Abavandimwe Be.</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat 12:46-50</ref>; <ref loc="MRK 3:31-35">Mar 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Nuuko nyina n'abavandimwe ba Yesu baaza kumureeba, ariko ntibaashobora kumugeraho ku bw'abantu benshi. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Umuntu araaza abwira Yesu ati, “Nyoko na beene so bahagaze hanze bashaaka kuvugana naawe.”<verse eid="LUK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21" />Aramusubiza ati, “Maama na beene daata ni abo bumva ijambo ry'Imaana bakarikurikiza.”<verse eid="LUK 8:21" /></para>
  <para style="s">Yesu Ategeka Umuyaga n'Imivumba Gutuuza</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat 8:23-27</ref>; <ref loc="MRK 4:35-41">Mar 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Umunsi umwe, Yesu n'abiigiishwa be baja mu bwato, arababwira ati, “Reka twambuke tuje haakurya y'ingezi.” Nuuko bazitura ubwato batangira urugendo. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />Bacambuka, Yesu arasinziira. Maze umuyaga mwinshi uteera mu ngezi, imivumba yisuka mu bwato bwenda kurengerwa n'amaazi, biisanga mu kaaga.<verse eid="LUK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24" />Biihuutira kumukangura, bati, “Daatabuja, Daatabuja! Tugiiye gupfa!”</para>
  <para style="p" vid="LUK 8:24">Nuuko akangutse, acaaha umuyaga n'imivumba birahoosha, habaho ituuze. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Yesu arababaza ati, “Kwizeera kwanyu kuri he?”</para>
  <para style="p" vid="LUK 8:25">Baratiinya kandi baruumirwa, baravugana bati, “Mbese uyu ni muntu ki, utegeka umuyaga no gucura kw'ingezi bikamwumvira!”<verse eid="LUK 8:25" /></para>
  <para style="s">Yesu Akiza Umugabo wari Uteewe n'Abadayimooni</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat 8:28-34</ref>; <ref loc="MRK 5:1-20">Mar 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Nuuko Yesu n'abiigiishwa be barambuka bafata haakurya, bagera mu gice c'Abagadereeni<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">Ibyanditswe bimwe bivuga ko ari </char><char style="fqa" closed="false">Geresa </char></note> hateeganye n'i Galileeya. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Yesu avuuye mu bwato, asanganirwa n'umugabo wabaga muri iyo tawuni wari uteewe n'abadayimooni. Uwo mugabo yari amaze igihe kireekire yambara ubusa, kandi ntiyaraaraga mu nzu ahuubwo yaraaraga mu irimbi. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Aboonye Yesu arataka caane, apfukama imbere ye ateera heejuru ati, “Unshaakaho iki Yesu Mwana w'Imaana Isumbabyose? Nyaabuna ndakwinginze, ntunyice urupfu rw'agashinyaguro.” <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Yavuze atyo, kuko Yesu yari ategetse abadayimooni kumuvamo. Uwo mugabo baari baaramuhambije injegeri mu maboko no mu maguru, kandi baahoraga bamurinze kuko kenshi abadayimooni baajaga bamuteera. Ariko ibyo baamuhambizaga byose yarabicagaguraga maze dayimooni zikamujaana mu butaayu.<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />Yesu abaza uwo mugabo ati, “Witwa nde?”</para>
  <para style="p" vid="LUK 8:30">Aramusubiza ati, “ ‘Igiteero’ ni ryo zina ryanje.” Yavuze atyo kuko abadayimooni baari bamurimo baari benshi. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Abo badayimooni binginga Yesu bati, “Nyaabuna turakwinginze ntudusuke ikuzimu.”<note caller="+" style="f"><char style="fr" closed="false">8:31 </char><char style="ft" closed="false">Mu Bayuuda </char><char style="it">Ikuzimu</char> wari umwanya wo abaapfuuye baajanwagamo. Baatekerezaga kandi yuuko ari icoobo kitagira ubugarukiro. Wari umwanya wo imyuka mibi yabiikwagamo itegereje guciirwa urubanza.</note><verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />Haafi aho, haari ingurube nyinshi zaariishirizaga ku musozi. Nuuko abo badayimooni binginga Yesu caane ngo abeemerere baje muri izo ngurube. Nuuko arabeemerera. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Maze abo badayimooni bava muri uwo mugabo, binjira muri izo ngurube. Izo ngurube zoose ziiruka zirindimuka agacuri maze ziisuka mu ngezi, zirarohama.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />Abashumba baaragiraga izo ngurube, baboonye ibibaaye barahunga maze baamamaza iyo nkuru mu tawuni no mu bindi bice biyegeereye. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Maze abantu barahaguruka baja kureeba ibyabaaye. Baaza aho Yesu ari, babona uwo mugabo wabagamo abadayimooni yiicaye haasi imbere ya Yesu yambaye kandi afite ubwenge nk'abandi. Babiboonye baratiinya caane. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Abaaboonye ibyabaaye byose, babibwira abandi, ndetse n'uko uwari warateewe n'abadayimooni yakize. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Maze abatuurage boose bo muri ico gice c'Abagadereeni basaba Yesu ngo ave mu gihugu caabo kuko ibyari byabaaye byabateeye ubwoba bwinshi. Nuuko aja mu bwato avayo.<verse eid="LUK 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38" />Ariko ataraavayo, uwo mugabo wari wavanywemo abadayimooni aramwinginga ngo bajaane. Ariko Yesu aramuseezerera ati, <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />“Subira iwaawe mu rugo maze ubateekerereze ibitangaaza Imaana yagukoreye.” Nuuko uwo mugabo agenda yamamaza mu tawuni yoose ibyo Yesu yamukoreye.<verse eid="LUK 8:39" /></para>
  <para style="s1">Yesu Akiza Umugore hamwe n'Umukoobwa wa Yayiro</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat 9:18-26</ref>; <ref loc="MRK 5:21-43">Mar 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Yesu asubiye haakurya y'ingezi, abantu benshi bamwakiira n'umuneezeero kuko boose baari biiriwe bamutegereje. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Nuuko haaza umuntu witwaga Yayiro wari umutware w'isinagoogi y'Abayuuda. Apfukama imbere ya Yesu aravuga ati, “Ndakwinginze ngwino tujaane iwanje.” <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />Yavuze atyo kuko yari afite umukoobwa w'ikinege wari amaze imyaka cumi n'ebyiri y'ubukuru kandi yari arwaye arembye ari haafi gupfa. Nuuko Yesu aramwemerera barajaana.</para>
  <para style="p" vid="LUK 8:42">Bakigenda, abantu benshi baramubyiga. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />Muri abo, haarimo umugore wari amaze imyaka cumi n'ebyiri arwaye indwara y'abagore yo kuva. Yari yaramariye ibye mu bavuuzi ariko ntaawashoboye kumukiza. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />Nuuko uwo mugore yegeera Yesu amuturutse inyuma akora ku mukugiro w'umwenda we, ako kaanya amaraso aratsina.<verse eid="LUK 8:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45" />Yesu arabaza ati, “Ni inde unkozeho?”</para>
  <para style="p" vid="LUK 8:45">Abantu boose barahakana. Peetero aramubwira ati, “Daatabuja, abantu benshi baragukurikiye kandi barakubyiga ndetse bakanagufataho.”<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />Ariko Yesu aravuga ati, “Hari umuntu unkozeho abigendereye kuko numviise imbaraga zimvamo.”<verse eid="LUK 8:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47" />Nuuko uwo mugore amenye ko Yesu adahishwa, aza afite ubwoba bwinshi, apfukama imbere ye. Abwira rubanda impamvu yatumye amukoraho, ababwira n'ukuntu indwara yo kuva yashootse ikize.<verse eid="LUK 8:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 8:48" />Yesu aramubwira ati, “Mwana wanje, kwizeera kwawe kuragukijije, genda amahoro.”<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />Yesu akivuga ibyo, haaza umuntu uvuuye mu rugo rwa Yayiro, maze abwira uwo mutware w'isinagoogi ati, “Umukoobwa waawe amaze gupfa. Reka kurusha umwigiisha.”<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />Yesu yumviise ibibaaye abwira Yayiro ati, “wiitiinya, izeere gusa umukoobwa waawe arakira.”<verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />Nuuko Yesu ageze mu muryango w'inzu ya Yayiro, ntiyakundira umuntu weese kwinjirana na we uretse Peetero, Yohaana, Yaakobo hamwe na Yayiro na nyina w'uwo mukoobwa. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Bageze mu nzu, basanga abantu boose baririra uwo mukoobwa, bateera heejuru. Maze Yesu arababwira ati, “Murekeraho kurira kuko umukoobwa ntiyapfuuye ahuubwo arasinziiriye.”<verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />Baramuseka kuko baari baazi neeza yuuko uwo mukoobwa yapfuuye. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Yesu abwira abantu baari mu nzu ngo baje hanze, maze amufata ukuboko avuga mu ijwi rirenga ati, “Mukoobwa kanguka.” <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Uwo mukoobwa atangira guhuumeeka neeza ako kaanya arahaguruka. Yesu ategeka ko bamuha icokurya. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Ababyeyi b'uwo mukoobwa baratangaara caane. Ariko Yesu abategeka kutagira umuntu wo babibwira.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">Yesu Atuma Abiigiishwa be Cumi na Babiri</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mat 10:5-15</ref>; <ref loc="MRK 6:7-13">Mar 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Yesu ahamagara abiigiishwa be cumi na babiri, abaha ubushobozi n'ubutware bwo kwirukana abadayimooni boose, no gukiza indwara. <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />Abatuma kubwiriza ubutumwa bw'Ubwami bw'Imaana no gukiza abarwayi. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Arababwira ati, “Ntimugire ico mujaana mu rugendo, yaaba inkoni, uruhago, ibyokurya, amashilingi cangwa undi mwambaro. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />Urugo muzaacumbikamo, abe ari rwo mugumamo kugeza igihe muzaaviira muri iyo tawuni. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" /><note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Iby 13:51</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luk 10:4-11</ref>.</char></note>Abantu bo muri iyo tawuni niibatabaakiira, muzaayivemo maze mukunkumure umucuucu wo ku birenge byanyu, kugira ngo bibe ubuhamya bwo kubeemeza ko Imaana izaabahana ibahooye kwanga ubutumwa bwayo.” <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />Nuuko abiigiishwa baragenda, banyura mu byaro byose baamamaza Ubutumwa bwiza kandi bakiza abantu indwara aho baajaga hoose.<verse eid="LUK 9:6" /></para>
  <para style="s">Herodi Yibaza Yesu Uwo Ari We</para>
  <para style="r">(<ref loc="MAT 6:1-12">Mat 6:1-12</ref>; <ref loc="MRK 6:14-29">Mar 6:14-29</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:14">Mat 16:14</ref>; <ref loc="MRK 8:28">Mar 8:28</ref>; <ref loc="LUK 9:19">Luk 9:19</ref>.</char>
    </note>Herodi umutegetsi w'i Galileeya yumviise ibyo Yesu yakoraga, biramuyobera kuko abantu baavugaga ko ari Yohaana wazuutse. <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />Abandi baavugaga ko ari Eliya wagarutse mu isi, ndetse abandi biibwiraga ko ari umwe mu bahanuuzi baakeera wazuutse. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Ariko Herodi aravuga ati, “Ko ari nje wategetse yuuko Yohaana aciibwa igihanga, noone kandi uyu bavuga yaaba ari nde?” Maze Herodi atangira gushaaka ukuntu yazaabona Yesu.<verse eid="LUK 9:9" /></para>
  <para style="s1">Yesu Ahaaza Abantu Basaaga Ibihumbi Bitaanu</para>
  <para style="r">(<ref loc="MAT 12:13-21">Mat 12:13-21</ref>; <ref loc="MRK 6:30-44">Mar 6:30-44</ref>; <ref loc="JHN 6:1-14">Yoh 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Intumwa za Yesu zigarutse zimuteekerereza ibyo zaari zaakoze byose. Nuuko Yesu azijaana ahiihereereye haafi y'itawuni yitwa Beetsayida. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Ariko abantu benshi babimenye, bamusangayo. Maze Yesu arabaakiira, ababwira iby'Ubwami bw'Imaana kandi abaari barwaye boose arabakiza.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />Nuuko bugiiye kwira, abiigiishwa be cumi na babiri baramwegeera, baramubwira bati, “Mwigiisha, seezerera abantu babone uko baja hakurya gushaaka ibyokurya n'aho kuraara kuko aha turi ntihatuuye abantu.”<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />Ariko Yesu arabasubiza ati, “Ahuubwo mube ari mwe mubagaburira.”</para>
  <para style="p" vid="LUK 9:13">Abiigiishwa baramusubiza bati, “Dore dufite imigaati itaanu n'isamaaki ebyiri gusa, keretse niiba twaja kugura ibyahaaza aba bantu boose.” <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />Haariho abagabo nk'ibihumbi bitaanu.</para>
  <para style="p" vid="LUK 9:14">Nuuko Yesu abwira abiigiishwa be ati, “Mubabwire biicare, buri gatsiko kabemo abantu mirongo itaanu.” <verse eid="LUK 9:14" /><verse number="15" style="v" sid="LUK 9:15" />Abiigiishwa bagenza nk'uko ababwiye, maze abantu boose bariicara. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Nuuko Yesu yakiira iyo migaati itaanu n'isamaaki ebyiri, areeba heejuru. Maze ashiima Imaana, arabimanyagura aheereza abiigiishwa na bo baheereza abantu. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Boose bararya barahaaga, maze abiigiishwa buuzuza intonga cumi n'ebyiri z'imigaati n'isamaaki byo abantu baari baasigaje.<verse eid="LUK 9:17" /></para>
  <para style="s1">Peetero Yatura ko Yesu Ari Kristo</para>
  <para style="r">(<ref loc="MAT 16:13-19">Mat 16:13-19</ref>; <ref loc="MRK 8:27-29">Mar 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Umunsi umwe Yesu yari ahiihereereye asenga, kandi abiigiishwa be baari kumwe na we. Amaze gusenga arababaza ati, “Abantu bavuga ko ndi nde?”<verse eid="LUK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:19 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:1">Mat 14:1</ref>,<ref loc="MAT 14:2">2</ref>; <ref loc="MRK 6:14">Mar 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">Luk 9:7</ref>,<ref loc="LUK 9:8">8</ref>.</char>
    </note>Abiigiishwa baramusubiza bati, “Bamwe bavuga ko uri Yohaana Umubatiza, abandi bakavuga ko uri Eliya umuhanuuzi, ndetse abandi bavuga ko uri umwe mu bahanuuzi ba keera wazuutse.”<verse eid="LUK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:20 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:68">Yoh 6:68</ref>,<ref loc="JHN 6:69">69</ref>.</char>
    </note>Arababaza ati, “Ariko se mwe muvuga ko ndi nde?”</para>
  <para style="p" vid="LUK 9:20">Peetero aramusubiza ati, “Uri Kristo wavuuye ku Maana.”<verse eid="LUK 9:20" /></para>
  <para style="s1">Yesu Avuga ku Rupfu n'Izuuka Bye</para>
  <para style="r">(<ref loc="MAT 16:20-28">Mat 16:20-28</ref>; <ref loc="MRK 8:30-9:1">Mar 8:30—9:1</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />Yesu abiihanangiriza abategeka ngo hatagira undi babibwira. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />Arabasobaanurira ati, “Ni ngombwa ko Umwana w'Umuntu ababazwa bikomeye, ndetse akangwa n'abakuru b'Abayuuda, n'abatware b'abaheerezabitambo, hamwe n'abiigiishamategeko. Kandi ko agomba kwicwa akazuurwa ku munsi wa gatatu.”<verse eid="LUK 9:22" /></para>
  <para style="s1">Gukurikira Yesu</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:23 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">Mat 10:38</ref>; <ref loc="LUK 14:27">Luk 14:27</ref>.</char>
    </note>Yesu abwira abantu boose ati, “Umuntu weese nashaaka kuba umwigiishwa wanje, akwiriye kwiyanga, akiikorera umusaraba we buri munsi, maze akankurikira. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" /><note caller="-" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat 10:39</ref>; <ref loc="LUK 17:33">Luk 17:33</ref>; <ref loc="JHN 12:25">Yoh 12:25</ref>.</char></note>Ndababwira yuuko ushaaka kurengera ubugingo bwe azaabubura, ariko utiita ku bugingo bwe ku bwo kunkurikira, azaabukiza. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Mbese umuntu byamumarira iki kunguka ibyo mu si byose, ariko agapfiirwa ubugingo buhoraho? <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Umuntu weese ugira isoni zo kunyemera no kwemera ibyo niigiisha, Umwana w'Umuntu na we azaagira isoni zo kumwemera, igihe azaaba aziye mu ikuzo rye, irya Se hamwe ni ry'abaamalayika beera. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Ndababwira ukuri yuuko, bamwe muri mwe bari aha, batazaapfa batari bareeba Ubwami bw'Imaana.”<verse eid="LUK 9:27" /></para>
  <para style="s1">Yesu Ahindurwa Ukundi</para>
  <para style="r">(<ref loc="MAT 17:1-8">Mat 17:1-8</ref>; <ref loc="MRK 9:2-8">Mar 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Hashize iminsi nk'umunaane avuze ibyo, Yesu ajaana na Peetero, na Yohaana na Yaakobo bazaamuukana umusozi gusenga. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Yesu agisenga, mu maaso he hahinduka ukundi maze hararabagirana caane. Imyenda ye na yo ihinduka umweru dede irarabagirana. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />Ako kaanya haboneka abagabo babiri, Moose na Eliya bavugana na we. <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />Baboneka bafite ubwiza bw'ijuru burabagirana, bavugana na Yesu iby'urupfu rwe, urwo yari agiiye kuzaapfiira i Yerusaalemu. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Ibyo byabaaye, Peetero na bagenzi be babiri basinziiriye. Muri ako kaanya barakanguka babona ikuzo rya Yesu n'abagabo babiri bamuhagaze iruhande. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Nuuko Moose na Eliya bari haafi gutandukana na we, Peetero aravuga ati, “Mwigiisha ni byiza ko turi hano! Mbona ko twakubaka amahema atatu, rimwe ribe iryawe, irindi ribe irya Moose, naho irindi ribe irya Eliya.” Yavuze atyo kuko ntiyari azi ibyo avuga.<verse eid="LUK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34" />Peetero akivuga, igicu kirabatwikiira maze kirabazenguruka, abiigiishwa baratiinya. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" /><note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 3:22">Luk 3:22</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="2PE 1:17">2Pet 1:17</ref>,<ref loc="2PE 1:18">18</ref>.</char></note>Ijwi ry'Imaana rivugira muri ico gicu riti, “Uyu ni Umwana wanje natooranyije, mumwumvire.” <verse eid="LUK 9:35" /><verse number="36" style="v" sid="LUK 9:36" />Iryo jwi rimaze kumviikana, abiigiishwa babona Yesu ari wenyine. Maze abo biigiishwa batatu babigira ibanga, ntibaagira uwo babibwira.<verse eid="LUK 9:36" /></para>
  <para style="s1">Yesu Akiza Umwana wari Uteewe na Dayimooni</para>
  <para style="r">(<ref loc="MAT 17:14-18">Mat 17:14-18</ref>; <ref loc="MRK 9:14-27">Mar 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Bukeeye, Yesu amanuka umusozi ari kumwe n'abiigiishwa be batatu, abantu benshi baaza kumusanganira. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Ako kaanya umugabo ateera heejuru, asakuza ari mu bantu avuga ati, “Mwigiisha ndakwinginze girira umwana wanje imbabazi kuko ari we mwana mfite wenyine. <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />Buri gihe dayimooni imufata imutunguye ikamuteera kuborooga. Iyo imufashe, iramutigita akaazana ifuro mu kanwa. Ntaabwo imuvaho vuba, ahuubwo iramubabaza ikamuvaho biruhije. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Ninginze abiigiishwa baawe ngo bamukize ariko ntibaabishoboye.”<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />Yesu aravuga ati, “Yemwe bantu b'iki gihe mudafite kwizeera, kandi mwibwira ibibi gusa. Nzaageza ryari kubaana na mwe no kubiihangaanira?” Nuuko Yesu aramubwira ati, “Ngaaho nzanira uwo mwana waawe.”<verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />Uwo mwana bakimuuzana aho Yesu ari, dayimooni imukubita haasi, iramutigita. Nuuko Yesu acaaha dayimooni ako kaanya imuvamo. Amaze gukiza uwo mwana, amusubiza se. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Nuuko abantu boose batangaazwa n'ububaasha bw'Imaana buhebuuje.</para>
  <para style="s1" vid="LUK 9:43">Yesu Yongera Kuvuga Ibyerekeye Urupfu rwe</para>
  <para style="r" vid="LUK 9:43">(<ref loc="MAT 17:22-23">Mat 17:22-23</ref>; <ref loc="MRK 9:30-32">Mar 9:30-32</ref>)</para>
  <para style="p" vid="LUK 9:43">Bagitangaaye, Yesu abwira abiigiishwa be ati, <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />“Nimwumve ibyo mbabwira, Umwana w'Umuntu agiiye kugambaanirwa maze ashirwe mu maboko y'abantu.” <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Ariko abiigiishwa ntibaamenya iryo jambo kuko baari baarihishwe ngo batarisobaanukirwa, ndetse Batiinya no kumubaza ngo abasobaanurire.<verse eid="LUK 9:45" /></para>
  <para style="s1">Umukuru mu Bwami bw'Imaana</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat 18:1-5</ref>; <ref loc="MRK 9:33-37">Mar 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:46 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">Luk 22:24</ref>.</char>
    </note>Abiigiishwa batangira kuja impaka bashaaka kumenya umukuru ubaruta muri bo uwo ari we. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Ariko Yesu amenya ibyari biri mu mitima yaabo, azana umwana muto amuhagarika iruhande rwe. <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" /><note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mat 10:40</ref>; <ref loc="LUK 10:16">Luk 10:16</ref>; <ref loc="JHN 13:20">Yoh 13:20</ref>.</char></note>Yesu arababwira ati, “Umuntu weese uzaakiira umwana muto nk'uyu mu izina ryanje, azaaba ari nje yakiriye. Kandi unyakiira azaaba yakiiriye uwantumye. Ndababwira yuuko uwo Imaana ireeba ko ari mukuru muri mwe, ni uwiiciisha bugufi.”<verse eid="LUK 9:48" /></para>
  <para style="s1">Utabarwanya aba ari Uwanyu</para>
  <para style="r">(<ref loc="MRK 9:38-40">Mar 9:38-40</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Nuuko Yohaana aramubwira ati, “Mwigiisha twaboonye umuntu yiirukana abadayimooni mu izina ryawe maze turamubuza kuko atari umwe muri twe.”<verse eid="LUK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50" />Maze Yesu aramusubiza ati, “Ntimukabuze beene uwo, ndababwira yuuko utabarwanya aba ari ku ruhande rwanyu.”<verse eid="LUK 9:50" /></para>
  <para style="s1">Abanyasamariya Banga Kwakiira Yesu</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Maze igihe ceegereje ngo Yesu asubire mu ijuru, amaramaza kuja i Yerusaalemu. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Nuuko atuma abantu ngo bamubanzirize imbere. Baragenda, banyura i Samariya kumuteguuriza. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />Ariko abantu b'aho banga kumwakiira kuko yakomezagamo aja i Yerusaalemu. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Abiigiishwa be Yaakobo na Yohaana, baboonye ko Abanyasamariya banze kwakiira Yesu baramubwira bati, “Nyagasani, urashaaka ko dutegeka umuriro kuva mu ijuru ugakongoora aba bantu?” <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />Maze Yesu arahindukira, arabacaaha.<note caller="+" style="f"><char style="fr" closed="false">9:55 </char><char style="ft" closed="false">Ibyanditswe bimwe byongeraho ngo, </char><char style="fqa" closed="false">Yesu arababwira ati, “Ntimuuzi umwuka ubarimo uwo ari wo kuko Umwana w'Umuntu ataaje kurimbura abantu, ahuubwo yaje kubakiza.” </char></note> <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />Nuuko we n'abiigiishwa be baja mu kindi caaro.<verse eid="LUK 9:56" /></para>
  <para style="s1">Ntibyoroshe Gukurikira Yesu</para>
  <para style="r">(<ref loc="MAT 8:19-22">Mat 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Nuuko Yesu n'abiigiishwa be bakigenda, umuntu aramubwira ati, “Ndagukurikira aho uja hoose.”<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />Yesu aramusubiza ati, “Ingunzu zifite imyobo yo kuraaramo, n'inyoni zo mu kireere zifite ibyari byo kubamo, ariko Umwana w'Umuntu ntaafite aho kurambika umusaya.”<verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />Nuuko Yesu abwira undi muntu ati, “Nkurikira.”</para>
  <para style="p" vid="LUK 9:59">Ariko uwo muntu aramusubiza ati, “Nyagasani, nyemerera manze nsubire mu rugo nteguure ibyo guhamba daata.”<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />Yesu aramubwira ati, “Reka abapfu bahambe abapfu baabo. Ariko wowe genda wamamaze iby'Ubwami bw'Imaana.”<verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />Undi muntu na we aramubwira ati, “Nyagasani, ndagukurikira, ariko nyemerera mbanze nje guseezera ku bo mu rugo.”<verse eid="LUK 9:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62" />Yesu aramusubiza ati, “Ntaamuntu ufashe isuka ihinga, ureeba inyuma uba ukwiriye Ubwami bw'Imaana.”<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s1">Yesu Atuma Abiigiishwa Mirongo Irindwi na Babiri</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Haanyuma Umwami Yesu, atooranya abandi biigiishwa mirongo irindwi na babiri,<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="ft" closed="false">Ibyanditswe bimwe bivuga mirongo irindwi.</char></note> atuma babiri, babiri ngo bamubanzirize aho yari agambiriye kuja hoose. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" /><note caller="-" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="MAT 9:37">Mat 9:37</ref>,<ref loc="MAT 9:38">38</ref>.</char></note>Arababwira ati, “Ibisaaruurwa ni byinshi, ariko abasaaruuzi ni bake. Nuuko musabe Imaana nyiribisaaruurwa, yohereze abasaaruuzi mu murima waayo.<note caller="+" style="f"><char style="fr" closed="false">10:2 </char><char style="bdit">Ni byinshi </char> bisobaanurwa ko abantu bashaaka kumva ijambo ry'Imaana ari benshi. Kandi abasaaruuzi, yamenyeeshaga ko ari abantu bo kuvuga ijambo ry'Imaana.</note> <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" /><note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="MAT 10:16">Mat 10:16</ref>.</char></note>Nimugende! Dore mbatumye muri nk'abaana b'intaama, hagati y'amasega aryana. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Ntihagire ishilingi mwitwaza mu mufuka, cangwa agakapu, cangwa ingato, kandi ntimumare igihe muramukanya n'abantu mu nzira mukigenda.<verse eid="LUK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 10:5" />Buri nzu yoose mwinjiramo, mubanze muvuge muti, ‘Amahoro y'Imaana abe muri iyi nzu.’ <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Niiba muri iyo nzu harimo umuntu ukunda amahoro, azaayahaabwa, ariko niiba ntaawe, ayo mahoro azaabagarukira. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" /><note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 Kor 9:14</ref>; <ref loc="1TI 5:18">1 Tim 5:18</ref>.</char></note>Mugume muri iyo nzu, murye kandi munywe ibyo babahaaye, ibyo birakwiriye kuko umukozi akwiriye guhembwa.<verse eid="LUK 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 10:8" />Itawuni yoose mugeramo bakabaakiira, murye ibyo babazimaaniye, <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />mukize abarwayi bo muri yo, mubabwire muti, ‘Ubwami bw'Imaana burabeegeereye.’ <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" /><note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Iby 13:51</ref>.</char></note>Ariko nimugera mu tawuni, abantu b'aho ntibabaakiire, muzaaje mu nzira zaaho mubabwire muti, <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" /><note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">Mat 10:7-14</ref>; <ref loc="MRK 6:8-11">Mar 6:8-11</ref>; <ref loc="LUK 9:3-5">Luk 9:3-5</ref>.</char></note>‘Umucuucu wo mu tawuni yaanyu wari ufashe ku birenge byacu tuwikunkumuyeho byerekana ko Imaana izaabahanira ibicumuro byabo, ariko mumenye ko Ubwami bw'Imaana bubeegereeye.’ <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" /><note caller="-" style="x"><char style="xo" closed="false">10:12 a </char><char style="xt" closed="false"><ref loc="MAT 11:24">Mat 11:24</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="MAT 10:15">Mat 10:15</ref>.</char></note>Ndababwira yuuko, ku munsi w'urubanza, Imaana izaagirira Sodomu imbabazi nyinshi ziruta iz'abo muri iyo tawuni.”<verse eid="LUK 10:12" /></para>
  <para style="s1">Ishano Rizaagwira Amatawuni Yanze Kwihana</para>
  <para style="r">(<ref loc="MAT 11:20-24">Mat 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />Yesu akomeza kubwira abiigiishwa ati, “Mbeega ishano rizaagwira abantu b'i Koraziini! Mbeega ishano rizaagwira abantu b'i Beetsayida! Iyaaba abanyabyaha b'i Tiiro n'i Sidoni baraboonye ibitangaaza byakorewe muri Koraziini, n'i Beetsayida, baba baariihannye barira kandi baborooga. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Ni co gituma ku munsi Imaana izaaca imanza ab'i Tiiro n'i Sidoni bazaahanwa igihano cooroshe kuruta icaanyu. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Namwe ab'i Kaperenawumu, mbese muzaashirwa heejuru, ngo mugere ku ijuru? Oya, ahuubwo muzaaja i kuzimu!”<verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:40">Mat 10:40</ref>; <ref loc="MRK 9:37">Mar 9:37</ref>; <ref loc="LUK 9:48">Luk 9:48</ref>; <ref loc="JHN 13:20">Yoh 13:20</ref>.</char>
    </note>Maze Yesu abwira abiigiishwa be ati, “Umuntu weese wemera ibyo muvuga, aba yemeye ibyo mvuga. Ubanga, ni nje aba yanze kandi unyanga aba yanze Imaana yantumye.”<verse eid="LUK 10:16" /></para>
  <para style="s1">Ico Abiigiishwa ba Yesu Bakwiriye Kwishiimira</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Abo mirongo irindwi na babiri bagaruka baneezeerewe caane maze babwira Yesu bati, “Nyagasani, abadayimooni na bo baatwumviye ku bw'ububaasha bw'izina ryawe.”<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />Arabasubiza ati, “Naboonye Sataani agwa avuuye mu ijuru nk'umurabyo. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />Dore mbahaaye ubutware bwo gukandagira inzoka n'ibindi binyabusabwe byose, hamwe no gutsinda umwanzi Sataani n'ubutware bwe bwose. Ntaakintu na kimwe kizaagira ico kibatwara. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Ariko ntimwishimire yuuko imyuka mibi ibumvira, ahuubwo mwishimire ko amazina yaanyu yanditswe mu ijuru.”<verse eid="LUK 10:20" /></para>
  <para style="s1">Yesu Aneezeerwa</para>
  <para style="r">(<ref loc="MAT 11:25-27">Mat 11:25-27</ref>; <ref loc="MAT 13:16-17">13:16-17</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />Ako kaanya Yesu yuzura umuneezeero mu Mwuka Weera, maze aravuga ati, “Ndagushiima, Daata, wowe utegeka ijuru n'isi, kuko ibyo wabihishe abanyabwenge ukabihishuurira abiiciishije bugufi. Ni koko Daata, ni ko wabikunze.<verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:22 a </char>
      <char style="xt" closed="false">
        <ref loc="JHN 3:35">Yoh 3:35</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="JHN 10:15">Yoh 10:15</ref>.</char>
    </note>Imaana Daata yampaaye ububaasha n'ubwenge bwose. Imaana Daata yoonyine ni yo izi Umwana uwo ari we. Kandi Umwana ni we uzi Se uwo ari we, n'umuntu weese wo Umwana ashaatse kugira ngo amenye Imaana.”<verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />Maze Yesu ahindukira abiigiishwa be, ababwira biihereereye ati, “Hahiirwa abareeba ibyo mureeba. <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Ndababwira ukuri yuuko abahanuuzi n'abaami benshi biifuuje kureeba ibyo mwiboneye, nyamara ntibaabiboonye. Ndetse biifuuje no kumva ibyo mwumviise ariko ntibaabyumviise.”<verse eid="LUK 10:24" /></para>
  <para style="s">Yesu Yiigiisha ku Rukundo</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:25 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:35-40">Mat 22:35-40</ref>; <ref loc="MRK 12:28-34">Mar 12:28-34</ref>.</char>
    </note>Umwe mu biigiishamategeko ya Moose, ahagurutswa no kugerageza Yesu aramubaza ati, “Mwigiisha, naakora iki kugira ngo ndagwe ubugingo buhoraho?”<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />Yesu aramusubiza ati, “Amategeko ya Moose avuga iki? Uyasobaanukirwa ute?”<verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />Na we aramusubiza ati, “Ukundiishe Uhoraho Imaana yaawe umutima waawe woose, n'ubugingo bwawe bwose, n'imbaraga zaawe zoose, n'ubwenge bwawe bwose, kandi ukunde mugenzi waawe nk'uko wikunda.”<verse eid="LUK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28" />Yesu aramubwira ati, “Uvuze neeza. Nuugenza utyo uzaabona ubugingo.”<verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />Uwo mwigiisha w'amategeko, ashaatse kwishigikira, abaza Yesu ati, “Harya mugenzi wanje ni nde?”<verse eid="LUK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />Yesu amusubiza amuciira umugani ati, “Umunsi umwe Umuyuuda yavuuye i Yerusaalemu amanuka aja i Yeriko. Akigenda agwa mu bambuzi, baramusuumiira, baramukubita, bamwaka ibyo yari afite byose. Ndetse bamwambura n'imyenda ye. Nyuma bariiruka bamusiga ari indembe. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Akiri aho haaza umuheerezabitambo, amuboonye, arakiikira anyuraho ariigendera. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />Nyuma y'aho haaza umuleevi na we amuboonye abigenza atyo, ntiyamwitaho, ariigendera. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />Nuuko haaza Umusamariya wari mu rugendo na we amugeraho, we amuboonye, amugirira impuhwe. <figure style="fig" alt="Bandaging injured man (Good Samaritan)" file="WA03863b.tif" size="span" loc="10:33" copy="Graham Wade" ref="10:33">Umusamariya amugirira imbabazi amwitaho.</figure> <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />Amwoza ibikomere na divaayi, amwomoza amavuta ya elayo,<note caller="+" style="f"><char style="fr" closed="false">10:34 </char><char style="ft" closed="false">Amavuta ya elayo ni amavuta ava mu giti ciitwa elayo.</char></note> kandi amupfuka inguma. Amushira ku ndogobe ye, amujaana ahantu ho gucumbika, aramurwaza. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Bukeeye aha nyir'icumbi idenariyo ebyiri aramubwira ati, ‘Umurwaze kandi ibyo uzaatanga birenze ibyo ngusigiye nzaabikwishura ngarutse.’ ”<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />Yesu ni ko kubaza wa mwigiisha w'amategeko ati, “Uteekereza ute? Muri abo batatu ni nde wamugiriye neeza? Ni nde wabaaye mugenzi we?”<verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />Na we aramusubiza ati, “Ni uwamugiriye imbabazi.”</para>
  <para style="p" vid="LUK 10:37">Yesu aramubwira ati, “Genda naawe ukore utyo.”<verse eid="LUK 10:37" /></para>
  <para style="s1">Yesu Azindukira Marita na Mariya</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:38 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 11:1">Yoh 11:1</ref>.</char>
    </note>Yesu n'abiigiishwa be bakomeza kugenda bagera iwaabo w'umugore witwaga Marita, arabaakiira. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Mwenenyina witwaga Mariya, yiicara yeegeereye Yesu, yumva ibyo yiigiishaga. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Ariko Marita we yari yahagaritswe umutima no gukora imirimo ashaaka ibyo kuzimaana. Nuuko asanga Yesu aramubaza ati, “Nyagasani, ntuubyitaayeho ko mwenemaama yanteereranye mu mirimo, akiiyicarira? Mubwire aze ampfashe.”<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41" />Yesu aramusubiza ati, “Nyaabuna Marita urarushwa n'ubusa muri byinshi. <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />Nyamara ica ngombwa ni kimwe gusa, Mariya ni co yahisemo kandi ntaazigera acaakwa.”<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s1">Yesu Yiigiisha Abiigiishwa Be Gusenga</para>
  <para style="r">(<ref loc="MAT 6:9-13">Mat 6:9-13</ref>; <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Yesu yari ahantu asenga. Arangije gusenga, umwe mu biigiishwa be aramubwira ati, “Nyagasani, twigiishe gusenga nk'uko Yohaana Umubatiza yiigiishije abiigiishwa be.”<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />Yesu arababwira ati, “Nimusenga muje muvuga muti,</para>
  <para style="q1" vid="LUK 11:2">‘Daata, izina ryawe ryubahwe,</para>
  <para style="q1" vid="LUK 11:2">Ubwami bwawe buuze.<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />Uduhe ifunguro ryo kudutunga buri munsi.<verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />Utubabarire ibyaha byacu,</para>
  <para style="q2" vid="LUK 11:4">nk'uko naatwe tubabarira abaducumuraho.</para>
  <para style="q1" vid="LUK 11:4">Ntuuduteererane ngo tugwe mu bitugerageza.’ ”<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Yesu akomeza kubabwira ati, “Nk'ubu mwe muri mwe agiiye kwa mugenzi we nijoro akamubwira ati, ‘Mugenzi wanje nguza imigaati itatu, <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />kuko inshuti yanje ingezeho kandi simfite ico kumuzimaanira.’<verse eid="LUK 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 11:7" />Maze mugenzi we akamusubiza ari mu nzu ati, ‘Reka kundusha, namaze gukinga kandi n'abaana banje baaryamye. Sinshobora guhaguruka ngo ngire ico nguha.’ <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Ndababwira yuuko naaho uwo muntu ataahagurutswa n'ubushuti bafitanye, amaheerezo yahagurutswa n'uko yamutiitirije bigatuma amuha ibyo asabye.<verse eid="LUK 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9" />Ni co gituma mbabwira nti, musabe muzaahaabwa, mushaake muzaabona, mukomange ku rugi, muzaakinguurirwa. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Ni koko usabye weese arahaabwa, ushaatse weese arabona, kandi n'ukomanga weese arakinguurirwa.<verse eid="LUK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11" />Babyeyi, ni nde muri mwe w'umwana we yasaba isamaaki akamuha inzoka? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />Cangwa yamusaba igi akamuha indyaniishamiriizo? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />Noone ko muri babi mukaba muuzi guha abaana baanyu ibyiza, So wo mu ijuru we ntiyarushaho guha Umwuka Weera abamumusabye!”<verse eid="LUK 11:13" /></para>
  <para style="s1">Yesu na Bbelizebuulu</para>
  <para style="r">(<ref loc="MAT 12:22-30">Mat 12:22-30</ref>; <ref loc="MRK 3:20-27">Mar 3:20-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Umunsi umwe, Yesu yirukanye dayimooni iteera uburagi mu muntu. Iyo dayimooni imaze kumuvamo, uwari umuragi atangira kuvuga, maze abantu benshi baari aho, baratangaara. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" /><note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat 9:34</ref>; <ref loc="MAT 10:25">10:25</ref>.</char></note>Ariko bamwe muri bo baravuga bati, “Umutware w'abadayimooni wiitwa Bbelizebuulu ni we umuha ububaasha bwo kwirukana abadayimooni.” <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" /><note caller="-" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="MAT 12:38">Mat 12:38</ref>; <ref loc="MAT 16:1">16:1</ref>; <ref loc="MRK 8:11">Mar 8:11</ref>.</char></note>Abandi bantu baramugerageza ngo abeereke ikimenyeetso kigaragaza ko kiva ku Maana.<verse eid="LUK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17" />Yesu amenya ibyo bateekereza, arababwira ati, “Iyo ubwami bwigabyemo ibice, burarimbuka. Ndetse n'urugo rudafatanya, rurasenyuka. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Muvuga yuuko Sataani ari we umpa ububaasha bwo kwirukana abadayimooni. Noone se niiba ubwami bwa Sataani bwigabamo ibice bukiirwanya, bwakomera bute? <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Niiba Bbelizebuulu ari we umpa ububaasha bwo kwirukana abadayimooni, ni nde uha abayoboke baanyu ubushobozi bwo kwirukana abadayimooni? Ni co gituma abo ari bo bazaabaciira urubanza ku bw'ibyo mumaze kuvuga. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Nuuko reero niiba imbaraga z'Imaana ari zo zinshoboza kwirukana abadayimooni, Ubwami bw'Imaana bubagezemo.<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />Umuntu ufite imbaraga n'intwaro, akarinda urugo rwe, ibintu bye ntaawabikoraho. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />Ariko iyo ateewe n'umurusha imbaraga, aramutsinda, akamunyaga intwaro zoose yari yiringiye, n'ibintu bye akabigabira abandi.<verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:23 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:40">Mar 9:40</ref>.</char>
    </note>Umuntu weese tudafatanya, aba ari umwanzi wanje. Ndetse udakoranyiriza hamwe nanje aba ataatanya.”<verse eid="LUK 11:23" /></para>
  <para style="s1">Kugaruka k'Umwuka Mubi</para>
  <para style="r">(<ref loc="MAT 12:43-45">Mat 12:43-45</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />Yesu akomezamo ati, “Iyo dayimooni ivuuye mu muntu, izeereera mu butaayu ishaaka uburuhuukiro, yabubura, ikavuga iti, ‘Reka niisubirire mu nzu navuuyemo.’ <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />Iyo igezeyo, igasanga aho yabaga haakondoowe kandi hateguuwe neeza, <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />iragenda, ikaazana abandi badayimooni barindwi bayirusha kuba babi. Boose bakinjira mu muntu bakamubamo, nooneho uwo muntu akaba mubi birenze uko yari ari.”<verse eid="LUK 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Yesu akivuga ayo magambo, umugore avuga mu ijwi rirenga ati, “Hahiirwa uwakubyaye n'amabeere yakonkeje.”<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />Yesu aramusubiza ati, “Ahuubwo hahiirwa abo bumva ijambo ry'Imaana, bakarikurikiza.”<verse eid="LUK 11:28" /></para>
  <para style="s1">Yesu Avuga ku kimenyeetso ca Yonah</para>
  <para style="r">(<ref loc="MAT 12:38-42">Mat 12:38-42</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:29 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:4">Mat 16:4</ref>; <ref loc="MRK 8:12">Mar 8:12</ref>.</char>
    </note>Abantu bakomeza kugwira, bamubyiganiraho. Yesu arababwira ati, “Abantu b'iki gihe ni babi bashaaka ko mbeereka igitangaaza kiva ku Maana. Ariko nta co bazaabona keretse ic'umuhanuuzi Yona. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Nk'uko Imaana yoheereje Yona kuba ikimenyeetso c'abantu bo mu tawuni y'i Ninevi, ni ko n'Umwana w'Umuntu woherejwe n'Imaana, azaaba ikimenyeetso ku bantu b'iki gihe. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />Umwamikazi w'i Sheba<note caller="+" style="f"><char style="fr" closed="false">11:31 </char><char style="bdit">Sheba</char> caari igihugu co mu majeepfo ya Isirayeli. </note> yaturutse mu gihugu ca kure, azanywe no kumva ubwenge bw'umwami Solomooni. Noone dore uruta Solomooni ari hano ariko ntimushaaka kumwumvira. Ni co gituma azaahagurukira ab'iki gihe, akabaciiraho iteeka ku munsi w'imperuuka. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />Abantu b'i Ninevi bumviise inyigiisho za Yona, bariihana. Kandi dore urusha Yona ubuhanga ari hano. Ni co gituma ku munsi w'urubanza, abantu b'i Ninevi bazaatuma ab'iki gihe batsindwa.<verse eid="LUK 11:32" /></para>
  <para style="s1">Yesu Yiigiisha ku Muco hamwe n'Ukuri</para>
  <para style="r">(<ref loc="MAT 5:15">Mat 5:15</ref>; <ref loc="MAT 6:22-23">6:22-23</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">Mat 5:15</ref>; <ref loc="MRK 4:21">Mar 4:21</ref>; <ref loc="LUK 8:16">Luk 8:16</ref>.</char>
    </note>Ntaamuntu ucaana itaara ngo arihishe cangwa ngo aryubikeho intonga. Ahuubwo arishira ku gitereko caryo kugira ngo abinjira mu nzu babone umuco. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Ijiisho ryawe ni itaara rimurikira umubiri waawe. Iyo amaaso yaawe areeba neeza, umubiri woose ugira umuco, ariko areebye naabi, umubiri woose wuuzura umwijima. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Nuuko reero mwirinde kugira ngo umuco waanyu utaba umwijima. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Iyo umaze kumenya ukuri, kandi ntaanenge ikurimo, uba weese umurikiwe n'umuco nk'umuntu umurikiweho n'itaara ryaka caane.”<verse eid="LUK 11:36" /></para>
  <para style="s1">Yesu Anenga Abafarisaayo n'Abiigiishamategeko</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23:1-36</ref>; <ref loc="MRK 12:38-40">Mar 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Yesu amaze kuvuga ayo magambo, umwe mu Bafarisaayo aramuraarika ngo aje gufungura iwe mu rugo. Yinjira mu nzu, ariicara, ngo afungure. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Umufarisaayo atangaazwa no kubona Yesu atabanje gukaraba intoki nk'uko umugenzo waabo wari uri.<verse eid="LUK 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39" />Umwami Yesu aramubwira ati, “Mwa Bafarisaayo mwe, muboneza igikopu n'isahaani inyuma ariko munda mwuzuyemo ubusambo n'ubugome. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Mwa bapfaapfa mwe! Iyaremye inyuma si yo yaremye no munda? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Ahuubwo mugire ubuntu bwo guha abakene ni bwo muzaabonera hoose.<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />Mwa Bafarisaayo mwe, muzaabona ishano kuko muha Imaana kimwe ca cumi c'agace ka buri kintu kiva mu mboga ziri mu mirima yaanyu, mukirengagiza gukora ibikwiriye no gukunda Imaana. Ibyo byose mukwiriye kubikora ntihagire ibyo mureka by'ingirakamaro.<verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />Muzaabona ishano mwa Bafarisaayo mwe kuko mushaaka kwicazwa mu ntebe z'ibyubahiro zisangwa mu masinagoogi mugashaaka kuramutswa mu byubahiro mu mateeraniro y'abantu no mu maguriro.<verse eid="LUK 11:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 11:44" />Muzaabona ishano, kuko mumeze nk'ibituuro bitareebeka maze abantu bakabigenda heejuru kuko bitagaragara.”<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Nuuko umuhanga mu biigiishamategeko aramusubiza ati, “Mwigiisha mu byo uvuze uradututse.”<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />Yesu aramubwira ati, “Namwe biigiishamategeko muzaabona ishano kuko mwikoreza abantu imitwaro iremeereye, badashoboye kwikorera kandi namwe ubwanyu ntimuyikozeho n'urutoki ngo mubaakiire.<verse eid="LUK 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47" />Muzaabona ishano kuko mwubaka ibituuro by'abahanuuzi biishwe na ba sogokuruza baanyu. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Ibyo mukora, bigaragaza ko mushiima ibyo ba sogokuruza baanyu baakoze, kuko biishe abahanuuzi naho mwebwe mukabuubakira ibituuro. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Ni yo mpamvu Imaana mu bwenge bwayo yaravuze iti, ‘Nzaabatumaho intumwa n'abahanuuzi. Bamwe muri bo baziicwa, naho abandi babarenganye’ <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />kugira ngo abantu b'iki gihe babarweho amaraso y'abahanuuzi boose biishwe uheereye ku kuremwa kw'isi. <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />Uheereye ku kwicwa kwa Abeeli<note caller="+" style="f"><char style="fr" closed="false">11:51 </char><char style="ft" closed="false">Mu seezerano rya keera </char><char style="bdit">Abeeli</char> ni we muntu wa mbere wishwe. Intangiriro 4:8 hakurikiraho Zaakariya ari we uheruuka. 2 Ngoma 24:20-22. Mu Bibiliya y'Uruheeburaayo, 2 Ngoma ni co gitabo giheruuka. </note>, ukageza ku kwa Zaakariya wo biiciye hagati y'aheera h'Inzu y'Imaana ku gicaaniro. Ni ukuri ndababwira yuuko ayo maraso yoose azaabazwa ab'iki gihe.<verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />Muzaabona ishano mwebwe abiigiishamategeko kuko mwakinze inzira ituma abantu bamenya Imaana. Mwebwe ubwanyu ntimwinjira, n'abaashaaka kwinjira murababuza.”<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Nuuko Yesu asohotse, Abafarisaayo n'abiigiishamategeko batangira kumuhakanya bafite ubukana bwinshi, <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />kuko bari bashaaka kumutegeesha amagambo ngo babone uko bamushinja.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">Kwamagirira Uburyarya</para>
  <para style="r">(<ref loc="MAT 10:26-27">Mat 10:26-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:6">Mat 16:6</ref>; <ref loc="MRK 8:15">Mar 8:15</ref>.</char>
    </note>Nuuko abantu ibihumbi n'ibihumbi bateeranira aho Yesu ari, bagera n'aho bakandagirana. Abwira abiigiishwa be ati, “Mwirinde umusemburo w'Abafarisaayo ari wo buryarya. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" /><note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="MRK 4:22">Mar 4:22</ref>; <ref loc="LUK 8:17">Luk 8:17</ref>.</char></note>Ndababwira ukuri yuuko ari ntaacahishwe kitazaahishuurwa, kandi ko ari ntaabanga ritazaamenyekana. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Nuuko reero ibyo mwavugiye mu rwihereero byose, bizumvikanira ku mugaragaro. Ndetse n'ibyo mwongoreraniye ahiihereereye bizaarangururirwa ku mugaragaro.”<verse eid="LUK 12:3" /></para>
  <para style="s1">Gutinyuka Abantu</para>
  <para style="r">(<ref loc="MAT 10:28-31">Mat 10:28-31</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />Yesu akomezamo ati, “Nshuti zanje, ntimugatinye abantu bashobora kubiica ariko ntaakindi baashobora kubatwara. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Ahuubwo ndababwira yuuko mutinya Imaana ifite ububaasha bwo kwica umuntu ikanamujugunya mu muriro utazima. Koko ndabibabwiye, uwo abe ari we mutinya. <verse eid="LUK 12:5" /><verse number="6" style="v" sid="LUK 12:6" />Mbese, ibishwi bitaanu ntibigura ibiceri bibiri gusa? Imaana ntiyakwibagirwa na kimwe muri byo. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Ndetse n'umusatsi wo ku mitwe yaanyu woose warabazwe. Nuuko ntimugatinye kuko murusha agaciiro ibishwi byinshi.”<verse eid="LUK 12:7" /></para>
  <para style="s1">Kwaturira Yesu mu Ruhame</para>
  <para style="r">(<ref loc="MAT 10:32-33">Mat 10:32-33</ref>; <ref loc="MAT 12:32">12:32</ref>; <ref loc="MAT 10:19-20">10:19-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />Nuuko Yesu arababwira ati, “Ndababwira ukuri yuuko umuntu weese uzampamiriza imbere y'abantu, Umwana w'Umuntu na we azaamuhamiriza imbere y'abaamalayika b'Imaana. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />Ariko unyihakanira imbere y'abantu, Umwana w'umuntu azamwihakanira imbere y'abaamalayika b'Imaana. <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" /><note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="MAT 12:32">Mat 12:32</ref>; <ref loc="MRK 3:29">Mar 3:29</ref>.</char></note>Umuntu weese uvuga naabi Umwana w'Umuntu azaababarirwa, ariko utuka Umwuka Weera, ntaazaababarirwa na hato.<verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:19">Mat 10:19</ref>,<ref loc="MAT 10:20">20</ref>; <ref loc="MRK 13:11">Mar 13:11</ref>; <ref loc="LUK 21:14">Luk 21:14</ref>,<ref loc="LUK 21:15">15</ref>.</char>
    </note>Nibabashira imbere mu masinagoogi, no mu batware hamwe no mu bacaamanza, ntimuzaahagarike umutima w'ibyo muziireguuza cangwa w'ibyo muzaavuga. <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />Ico gihe Umwuka Weera azaabamenyeesha ico mukwiriye kuvuga.”<verse eid="LUK 12:12" /></para>
  <para style="s">Umugani w'Umukire w'Umupfaapfa</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Maze umwe muri abo bantu abwira Yesu ati, “Mwigiisha bwira mukuru wanje<note caller="+" style="f"><char style="fr" closed="false">12:13 </char><char style="ft" closed="false">Mu Bayuuda, umwana w'umuhungu mukuru ni we wari ushinzwe kugabira beenenyina umurage waabo.</char></note> tugabane umurage twasigiwe na daata.”<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />Yesu aramusubiza ati, “Nshuti yanje, ni nde wangize umucaamanza cangwa uwo kubagabira ibintu byanyu.” <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Arongera arababwira ati, “Mwitonde kandi mube maaso ku bintu byo kurarikira, kuko ubugingo bw'umuntu butava mu bukire bw'ibyo afite.”<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />Maze Yesu abaciira uyu mugani ati, “Haabaayeho umugabo w'umukire wari ufite itaka ryeraga caane. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />Yiigiira inaama ati, ‘Nzaakora nte, ko ntafite umwanya uhaagije wo guhunikamo imyaka yanje?’<verse eid="LUK 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 12:18" />Maze aravuga ati, ‘Nzaakora ntya: Ndasenya ibigega mpunikamo, maze nuubake binini birutaho umwo nzaaja mpunika imyaka yanje yoose hamwe n'ibindi bintu byanje ntunze. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />Nooneho niibwire nti: Ubu ufite ibyiza byinshi wibiikiye bizaagutunga igihe kireekire wiriire kandi winywere maze udamarare.’<verse eid="LUK 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20" />Ariko Imaana iramubwira iti, ‘Wa mupfaapfa we! Iri joro urakuurwaho ubugingo bwawe. Noone se ibyo washaatse bizaaba ibya nde?’<verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />Uku ni ko bizaaba ku muntu weese wirundaanyiriza ubukire bwo mu isi adafitanye ubumwe n'Imaana.”<verse eid="LUK 12:21" /></para>
  <para style="s1">Kwiringira Imaana</para>
  <para style="r">(<ref loc="MAT 6:25-34">Mat 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Nuuko Yesu abwira abiigiishwa be ati, “Ni co gituma mbabwira nti, ‘Ntimukiiganyire ku bw'ubugingo bwanyu ngo muhagarike umutima muti, tuzaarya iki, cangwa muteekereze ibyerekeye umubiri ngo tuzambara iki?’ <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Ubugingo buruta caane ibyokurya n'imyambaro. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Mureebere ku nyoni zo mu kireere, ntaabwo zihinga cangwa ngo zisaaruure. Ntizifite n'amazu zihunikamo cangwa ibigega, nyamara Imaana irazigaburira. Ntimuuzi se ko muziruta inshuro nyinshi? <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Ni nde muri mwe wakwiyongeraho n'isaaha imwe yoonyine ku bugingo bwe ku bwo guhagarika umutima? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Noone se niiba mutashobora gukora ikintu gito nk'iki, ni iki kibahagarikiisha umutima ku bindi bintu.<verse eid="LUK 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 12:27" />Nimureebe kandi uko ibimori byo mu gasozi bikura. Ntibigira umurimo bikora cangwa ngo bigire imyambaro bidoda ariko ndababwira yuuko na Solomooni mu bukire bwe, atiigeze yambara neeza nka byo. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Imaana iha ubwiza ibimera byose byo mu gasozi, bibaho uyu munsi, ariko ejo bigataabwa mu muriro. Noone se ntizaabakorera ibirutaho mwa bafite kwizeera guke mwe? <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />Nuuko ntimugahagarike umutima w'ibyokurya cangwa ibyokunywa ngo abe ari byo muhozaho umutima. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Ibi byose abatiizeera Imaana bo mu isi na bo barabishaakiisha. Naho mwe So wo mu ijuru azi ko mubyifuuza. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Ahuubwo mbere ya byose, mushaake Ubwami bw'Imaana, niho ibyo muzaabyongererwa.<verse eid="LUK 12:31" /></para>
  <para style="s1">Ubutunzi Bwo mu Ijuru</para>
  <para style="r">(<ref loc="MAT 6:19-21">Mat 6:19-21</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />Mwa biigiishwa banje mwe, nuubwo muri bake, ntimugaatinye kuko So aneezeezwa no kubaha Ubwami bwe. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />Muguriishe ubutunzi bwanyu maze amashilingi muyafashishe abakene. Mwishaakire ubutunzi buhoraho ari bwo bukire bwo mu ijuru butagira iherezo kandi aho abajuura bataabwiba cangwa inyenzi ngo ziburye. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Ndababwira ko aho ubukire bw'umuntu buri, ari ho n'umutima we uzaaba.<verse eid="LUK 12:34" /></para>
  <para style="s1">Mube Maaso kandi Muhore Mwiteguuye</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:35 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 25:1-13">Mat 25:1-13</ref>.</char>
    </note>Nuuko muhore mwiteguuye kandi amataara yaanyu yake. <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" /><note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="MRK 13:34-36">Mar 13:34-36</ref>.</char></note>Mumere nk'abagaragu bategereza sheebuja ngo ave mu bukwe kugira ngo naagaruka agakomanga, baheereko bamukinguurire. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Abagaragu bo sheebuja azaasanga biiteguuye, ni bo bazaagororerwa. Ndababwira ukuri yuuko azaakenyera, akabiicaza, akabagaburira. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Abagaragu bo sheebuja azaasanga bari maaso aho azaazira hoose, haba nijoro cangwa mu gitondo kare, bazaagororerwa. <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" /><note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 24:43">Mat 24:43</ref>,<ref loc="MAT 24:44">44</ref>.</char></note>Mwibuke ko iyo nyirirugo aza kumenya isaaha umujuura aribuuzire mu nzu ye, ntiyakwemeye ko inzu ye icukurwa. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Namwe reero mukwiriye kwiteeguura, kuko Umwana w'Umuntu azaaza mu gihe mudateekereza.”<verse eid="LUK 12:40" /></para>
  <para style="s1">Umugaragu w'Intahemuka cangwa w'Umuhemu</para>
  <para style="r">(<ref loc="MAT 24:45-51">Mat 24:45-51</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Nuuko Peetero aravuga ati, “Nyagasani, uyu mugani ni twe uwuciiriye twenyine cangwa ni abantu boose?”<verse eid="LUK 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42" />Yesu aramusubiza ati, “Ni nde mugaragu w'ubwenge kandi udahemuka wo sheebuja azaasigira umurimo wo kugaburira abandi bagaragu mu gihe gikwiriye? <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />Uwo mugaragu wo sheebuja azaaza agasanga yarakoze ibikwiriye azaagororerwa. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Ndababwira ukuri yuuko sheebuja azaamuha gutegeka ibye byose. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />Ariko uwo umugaragu natangira kwibwira ko sheebuja atari bugaruke vuba, agatangira gukubita bagenzi be, akiiriira, akinywera ndetse agasinda, <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />sheebuja azaaza umunsi uwo mugaragu atamwiteguuye n'igihe ataazi. Azaamuhana bikabije hamwe n'abantu batiizeera.<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />Umugaragu weese uzi ico sheebuja ashaaka ntaaciteho, ngo agikore nk'uko yategetswe, azaakubitwa inkoni nyinshi. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Ariko umugaragu utaazi byinshi byo sheebuja ashaaka, agakora ibidakwiriye, azaakubitwa inkoni nke. Uwahaawe byinshi azaabazwa byinshi kandi n'uwahaawe byinshi birutaho, aziishuzwa byinshi kurutaho.<verse eid="LUK 12:48" /></para>
  <para style="s1">Gukurikira Yesu Biraruhije</para>
  <para style="r">(<ref loc="MAT 10:34-36">Mat 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />Nazanywe no gukongeza umuriro<note caller="+" style="f"><char style="fr" closed="false">12:49 </char><char style="ft" closed="false">Rimwe na rimwe muri Bibiliya, umuriro umenyeesha guciirwaho iteeka ku bw'ibyaha. </char></note> ku isi, icampa uwo muriro ukaba umaze gufata! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" /><note caller="-" style="x"><char style="xo" closed="false">12:50 </char><char style="xt" closed="false"><ref loc="MRK 10:38">Mar 10:38</ref>.</char></note>Mfite umubatizo w'umubabaro uteeye ubwoba nzaabatizwa, bimpagaritse umutima kugeza igihe bizaarangirira.<note caller="+" style="f"><char style="fr" closed="false">12:50 </char><char style="ft" closed="false">Yesu yamenyeeshaga urupfu azaapfa ku musaraba</char></note> <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Mbese mwibwira ko naaje kuuzana amahoro mu isi? Oya rwose! Ahuubwo naaje gutandukanya abantu. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />Kuva ubu, abantu bataanu bo mu muryango umwe, ntibazaahuuza. Batatu bazaarwanya babiri, n'abandi babiri barwanye batatu. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />Umuhungu ntaazaahuuza na se, na se ntaazaahuuza n'umuhungu we. Umukoobwa ntazaahuuza na nyina, kandi nyina yeguhuuza n'umukoobwa we, ndetse n'umukazaana na nyirabukwe, ntibazaahuuza.”<verse eid="LUK 12:53" /></para>
  <para style="s1">Yesu Abwira Abantu Kwiteguurira Ibizaaba</para>
  <para style="r">(<ref loc="MAT 16:2-3">Mat 16:2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Arongera abwira abantu ati, “Iyo muboonye igicu giturutse iburengerazuuba, muravuga muti, ‘Imvura igiiye kugwa’ kandi koko ikagwa. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Kandi iyo umuyaga uhuuha uturutse mu majeepfo, muravuga muti, ‘Haraba ubushuhe bwinshi’ kandi ni ko biba. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Mwa ndyarya mwe! Mbese ko muuzi gusobaanura impindahinduka y'umunsi n'ikireere, ni kuki mutamenya gusobaanura iby'iki gihe?<verse eid="LUK 12:56" /></para>
  <para style="s1">Kwikiraanura n'Ukurega</para>
  <para style="r">(<ref loc="MAT 5:25-26">Mat 5:25-26</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />Mwebwe se ni kuki mutamenya guhitamo igikwiriye? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Nuujaana n'umuntu ukurega ku mucaamanza, ugerageze wiyuzuze na we mutaraagera imbere y'umucaamanza, bigatuma umucaamanza agushikiriza umusirikare, maze na we akagushira mu gihome. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />Ndababwira ukuri yuuko utazaavamo utari wishura umwenda woose hadasigayeyo n'ishilingi n'imwe.”<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s1">Nimutiihana Muzaarimbuka</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Muri ico gihe, haari abantu baabwiye Yesu ibyabaaye ku Banyagalileeya. Bamuteekerereza uko Pilaato yiciishije bamwe mu gihe baatambaga ibitambo. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Yesu arababaza ati, “Mbese muteekereza ko abo Banyagalileeya baababajwe batyo, baari abanyabyaha kuruta abandi Banyagalileeya boose? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Oya, si byo rwose! Ahuubwo namwe nimutiihana muzaarimbuka mutyo mwese. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Cangwa se ba bantu cumi n'umunaane bo umunaara w'i Silowamu wagwiriye ukabiica, muteekereza ko baari abanyabyaha kuruta abandi bantu boose b'i Yerusaalemu? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Oya, si byo rwose. Ahuubwo namwe nimutiihana muzaarimbuka mutyo mwese.”<verse eid="LUK 13:5" /></para>
  <para style="s1">Umugani w'Igiti ciitwa Umutiini Kiteera Imbuto</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Yesu abaciira uyu mugani ati, “Umuntu yari afite igiti ciitwa umutiini yateeye mu murima we w'imizaabibu. Yahoraga agishaakaho imbuto, ariko ntaazibone. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Nuuko nyir'umurima abwira umuhinzi w'imizaabibu ye ati, ‘Dore hashize imyaka itatu nza gushaaka imbuto kuri uyu mutiini sinzibone, uwurandure kuko ari nta mpamvu ituma ukomeza kunyuunyusa ubutaka.’<verse eid="LUK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 13:8" />Umuhinzi aramusubiza ati, ‘Daatabuja, wureke umare undi mwaka umwe gusa. Ngiiye kuwuhingira, ngufumbire, <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />ahaari wazaageraho ukeera imbuto umwaka utaaha. Ariko nuuteera imbuto, uzaawurandure.’ ”<verse eid="LUK 13:9" /></para>
  <para style="s1">Yesu Akiza Umugore ku munsi w'Isaabato</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Igihe kimwe ku munsi w'Isaabato, Yesu yigiishirizaga abantu mu isinagoogi. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />Mu bo yigiishaga, haarimo umugore ufite dayimooni iteera ubumuga. Uwo mugore yari amaze imyaka cumi n'umunaane ahetamye umugongo adashobora kuunama na hato. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Yesu amuboonye aramuhamagara ngo aze aho ari, aramubwira ati, “Mugore ubohoowe ubumuga bwawe.” <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Amurambikaho ibiganza, ako kaanya uwo mugore arakira, ahagarara yemye, ahimbaza Imaana.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />Ariko umutware mukuru w'isinagoogi biramuraakaza caane kuko Yesu akijije umuntu ku Isaabato. Abwira abantu ati, “Mu cumweru harimo iminsi itandatu gusa yo gukorerwamo imirimo. Iyo minsi, abe ari yo muja muuziramo gukizwa indwara, ariko umunsi w'Isaabato ni uwo kuruhuukiraho.”<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />Yesu aramusubiza ati, “Mwa ndyarya mwe! Mbese ni nde utaazitura inka cangwa indogobe ye ku Isaabato mu kiraaro ngo ayijaane kuyuhira cangwa kuyiragira? <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Noone uyu mugore, dore imyaka ibaaye cumi n'umunaane aboshwe na Sataani kandi ari umukoobwa w'Aburahamu. Mbese ntibyari ngombwa ko abohoorwa ku munsi w'Isaabato?”<verse eid="LUK 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17" />Yesu amaze kuvuga ibyo, abaamuhakanyaga boose bakorwa n'isoni. Naho abandi boose baari bateeraniye aho, biishiimira imirimo myiza akoze.<verse eid="LUK 13:17" /></para>
  <para style="s1">Umugani w'Akabuto Gato Caane</para>
  <para style="r">(<ref loc="MAT 13:31-32">Mat 13:31-32</ref>; <ref loc="MRK 4:30-32">Mar 4:30-32</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Maze Yesu arababaza ati, “Mbese Ubwami bw'Imaana bumeze bute cangwa nabugereranya n'iki? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />Bwagereranywa n'akabuto gato kitwa sinaapi, ko umuntu yajaanye mu murima we akakabiba. Haanyuma karakura, kavamo igiti. Inyoni zo mu kireere zaarika ibyari mu mashami yaaco.”<verse eid="LUK 13:19" /></para>
  <para style="s1">Umugani w'Igituubuura</para>
  <para style="r">(<ref loc="MAT 13:33">Mat 13:33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Yongera kubaza abantu ati, “Ubwami bw'Imaana naabugereranya n'iki? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />Bwagereranywa n'umusemburo wo umugore yavanze mu ndengo itatu z'ifu kugeza aho byose byatutumbiye.”<verse eid="LUK 13:21" /></para>
  <para style="s1">Umuryango Ufunganye</para>
  <para style="r">(<ref loc="MAT 7:13-14">Mat 7:13-14</ref>,<ref loc="MAT 7:21-23">21-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Nuuko Yesu aja i Yerusaalemu, anyura mu matawuni menshi no mu byaro, agenda yigiisha abantu. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Umuntu aramubaza ati, “Nyagasani, mbese abazaakizwa si bake?”</para>
  <para style="p" vid="LUK 13:23">Yesu aramusubiza ati, <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />“Mugire umwete wo kunyura mu muryango ufunganye. Ndababwira ukuri yuuko benshi bazaashaaka kuwunyuramo, ariko ntibabishobore. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />Nyir'urugo naamara gukinga uruugi rw'inzu, mwebwe abari hanze mugakomanga mumwinginga muti, ‘Daatabuja, dukinguurire,’ na we azaabasubiza ati, ‘Simbaazi ndetse sinzi n'aho muturuka.’<verse eid="LUK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 13:26" />Nyuma muzaavuga muti, ‘Twasangiye naawe ibyokurya n'ibyokunywa, kandi wigiishirizaga mu nzira z'iwaacu.’<verse eid="LUK 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27" />Ariko azaababwira ati, ‘Simbaazi, sinzi n'aho muturuka, nimumve imbere mwese mwa nkozi z'ibibi mwe!’<verse eid="LUK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 13:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:28 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:13">Mat 22:13</ref>; <ref loc="MAT 25:30">25:30</ref>.</char>
    </note>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:28 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 8:11">Mat 8:11</ref>,<ref loc="MAT 8:12">12</ref>.</char>
    </note>Hazaabaho kurira no guhekenya ameenyo ubwo muzaabona Aburahamu, Isaaka na Yaakobo n'abandi bahanuuzi boose bari mu Bwami bw'Imaana naho mwe mukajugunywa hanze. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Abandi bantu bazaaza baturutse i burasirazuuba n'iburengerazuuba, abandi baturuke amajeepfo n'amajaaruguru basangire mu Bwami bw'Imaana. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" /><note caller="-" style="x"><char style="xo" closed="false">13:30 </char><char style="xt" closed="false"><ref loc="MAT 19:30">Mat 19:30</ref>; <ref loc="MAT 20:16">20:16</ref>; <ref loc="MRK 10:31">Mar 10:31</ref>.</char></note>Nuuko reero hariho ab'inyuma bazaaba ab'imbere, n'ab'imbere bazaaba ab'inyuma.”<verse eid="LUK 13:30" /></para>
  <para style="s1">Yesu Aririra ab'i Yerusaalemu</para>
  <para style="r">(<ref loc="MAT 23:37-39">Mat 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Uwo munsi, Abafarisaayo bamwe baaza aho Yesu ari, baramubwira bati, “Va hano uhunge kuko Herodi ashaaka kukwica.”<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />Yesu arabasubiza ati, “Nimugende mumbwirire iyo ngunzu yiyoberanya muti, ‘Dore ndakomeza kwirukana abadayimooni no gukiza abarwayi uyu munsi n'ejo, nuuko ku munsi wa gatatu nzaaba ndangije gukora ibyanzanye.’ <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Uko byaba koose, nkwiriye gukomeza urugendo rwanje uyu munsi, ejo ndetse n'ejobundi, kuko bidashoboka ko umuhanuuzi yicirwa ahandi, hatari i Yerusaalemu.<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />Bantu b'i Yerusaalemu, bantu b'i Yerusaalemu! Mwica abahanuuzi kandi mukiiciisha amabuye ababatumweho! Ni kangaahe nashaatse kurundarunda abaana baanyu nk'uko inkoko ibundikira ubushwi mu mababa yaayo, ariko ntimunkundire? <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Nooneho reero nimwumve, inzu yaanyu ibasigiwe ari umusaka. Ndababwira yuuko mutazambona kugeza ubwo muzaavuga muti, ‘Hahiirwa uje mu izina ry'Imaana.’ ”<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">Yesu Akiza Umugabo ku munsi w'Isaabato</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Ku munsi w'Isaabato, Yesu aja mu rugo rw'Umufarisaayo mukuru ngo basangire. Nuuko Abafarisaayo hamwe n'abiigiishamategeko baari aho, baramugenzuura. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />Imbere ye haari umugabo ubyimbye amaguru n'amaboko. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Yesu abaza Abafarisaayo n'abiigiishamategeko ati, “Mbese amategeko yemerera gukiza umuntu ku munsi w'Isaabato?” <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />Ariko ntibaagira ico bamusubiza. Nuuko Yesu amufataho, aramukiza, aramuseezerera.<verse eid="LUK 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 14:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:5 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:11">Mat 12:11</ref>.</char>
    </note>Maze Yesu arababaza ati, “Umwana waawe aramutse aguuye mu kidiba ntiwamuvaanamo ako kaanya nuubwo haaba ku munsi w'Isaabato? Cangwa se ikimasa caawe kiguuye mu kidiba ku munsi w'Isaabato ntiwagikuuramo?” <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />Ntibaagira ico bamusubiza.<verse eid="LUK 14:6" /></para>
  <para style="s1">Kwiciisha Bugufi</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Yesu yitegereje uko bamwe mu baaraaritswe bashaaka kwicara mu myanya y'ibyubahiro, abaciira umugani ati, <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />“Umuntu naagutumira mu bushitsi ntukiihitiremo kwicara mu ntebe y'icuubahiro, kuko haaba hari undi muntu waraaritswe ukurusha icuubahiro, <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />maze uwabatumiye akakubwira ati, ‘Imukira uyu yicare’. Ibyo reero byagukoza isoni baguhagurukije ukaja mu mwanya w'inyuma. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Ahuubwo nuutumirwa uziicare inyuma y'abandi boose, maze uwagutumiye naaza aho uri, akubwire ati, ‘Nshuti yanje ngwino wicare mu mwanya mwiza.’ Nuuko naawe uzaabona icuubahiro boose babireeba. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" /><note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="MAT 23:12">Mat 23:12</ref>; <ref loc="LUK 18:14">Luk 18:14</ref>.</char></note>Ndababwira yuuko uwishira heejuru weese, azaaciishwa bugufi. Ariko umuntu wiciisha bugufi, azaashirwa heejuru.”<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Yesu abwira uwamuraaritse ati, “Nuutumira abantu ngo musangire ku manywa cangwa nijoro, ntugatumire inshuti zaawe, cangwa beene so, cangwa abavandimwe baawe, cangwa abatuuranyi b'abakire, kuko bazaakuraarika naawe bakwituura ineeza wabagiriye. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Ahuubwo nuutumira, uzaatumire abakene, n'abafite uburema, n'abacumbagira hamwe n'impumyi. <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />Nugenza utyo, Imaana izaaguha umugisha, kuko abo uzaaba watumiye ntaaco bazaakwituura, ahuubwo uziishurwa intungaane zizuutse.”<verse eid="LUK 14:14" /></para>
  <para style="s1">Umugani w'Abatumwirwa Banze Gutaha Ubukwe</para>
  <para style="r">(<ref loc="MAT 22:1-10">Mat 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Maze umwe mu baari baatumiwe, yumviise ibyo Yesu avuze, aramubwira ati, “Hahiirwa umuntu weese uzeemererwa gufungurira mu Bwami bw'Imaana.” <verse eid="LUK 14:15" /><verse number="16" style="v" sid="LUK 14:16" />Yesu aramusubiza ati, “Hari umuntu wateguuye ibirori bihebuuje, maze atumira abantu benshi. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />Igihe c'ubukwe kigeze, atuma umugaragu kubwira abaaraaritswe ati, ‘Nimuuze byose byateguuwe.’<verse eid="LUK 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 14:18" />Ariko boose batangira gutanga impamvu z'urwitwazo. Uwa mbere aravuga ati, ‘Naguze umurima kandi ngomba kuja kuwureeba, nyaabuna mbabarira.’<verse eid="LUK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 14:19" />Undi na we ati, ‘Naguze ibimasa cumi byo guhingiisha, noone ubu ngiiye kubigerageza nyaabuna umbabarire.’<verse eid="LUK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 14:20" />Undi na we aravuga ati, ‘Naarongoye, sinshobora kuuza.’<verse eid="LUK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21" />Nuuko umugaragu wari watumwe asubiyeyo, abiteekerereza sheebuja. Maze sheebuja araraakara caane aramutegeka ati, ‘Genda wihuuta uje mu nzira ngari no mu nzira zipfundanye mu tawuni, maze uraarike abakene, abarema, abacumbagira hamwe n'impumyi.’<verse eid="LUK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22" />Uwo mugaragu agarutse aravuga ati, ‘Daatabuja ibyo wantegetse byose naabikoze ariko reero ibyicaro biracaariho.’<verse eid="LUK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23" />Sheebuja aramusubiza ati, ‘Ja mu nzira zoose no mu mirombero maze ubahate baaze, kugira ngo inzu yanje yuzure abantu.’ <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Ndababwira ukuri yuuko ntan'umwe mu baatumiwe mbere, uzaarya ku byo nateguuye.”<verse eid="LUK 14:24" /></para>
  <para style="s1">Ikiguzi co Gukurikira Yesu</para>
  <para style="r">(<ref loc="MAT 10:37-38">Mat 10:37-38</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Abantu benshi bakurikira Yesu aja i Yerusaalemu. Arahindukira abwira abamukurikiye ati, <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" /><note caller="-" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="MAT 10:37">Mat 10:37</ref>.</char></note>“Umuntu weese uza aho ndi, ntankunde kurusha uko akunda se na nyina, n'umugore we, n'abaana be, na beene se, na bashiki be, ndetse n'ubugingo bwe, ntaashobora kuba umwigiishwa wanje. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" /><note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mat 10:38</ref>; <ref loc="MAT 16:24">16:24</ref>; <ref loc="MRK 8:34">Mar 8:34</ref>; <ref loc="LUK 9:23">Luk 9:23</ref>.</char></note>Kandi umuntu uteemera kwikorera umusaraba we ngo ankurikire, ntaakwiriye kuba umwigiishwa wanje.<verse eid="LUK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28" />Mbese muri mwe ni nde waba ashaaka kuubaka umunaara mureemure, ntaabanze kwicara ngo abare igiciiro caawo, akamenya niiba afite ibyo kuwurangiza? <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />Bitabaaye bityo, yakuubaka urufatiro gusa, ntaashobore kurangiza ahasigaye, maze ababiboonye boose bakamuseka. <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />Nyuma bakavuga bati, ‘Uyu muntu yatangiye kuubaka umunaara ariko ntiyawuzuza.’<verse eid="LUK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31" />Cangwa se, umwami ufite abasirikare ibihumbi cumi, yakora iki ngo arwanye undi mwami ugiiye kumuteera afite abasirikare ibihumbi makumyabiri? Ataraaja ku rugamba ntaakwiriye kubanza yicara akareeba niiba yatsinda iyo ntambara? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Iyo amenye ko atazaayitsinda, yoohereza intumwa kuri uwo mwami akiri kure akamusaba ko babaana mu mahoro. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Nuuko reero umuntu weese muri mwe udahara ibyo atunze byose, ntaashobora kuba umwigiishwa wanje.”<verse eid="LUK 14:33" /></para>
  <para style="s1">Umunyu Wakayutse</para>
  <para style="r">(<ref loc="MAT 5:13">Mat 5:13</ref>; <ref loc="MRK 9:50">Mar 9:50</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />Yesu akomeza kubabwira ati, “Umunyu ni mwiza, ariko se iyo umaze gukayuka wakongera kuryoha ute? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Ntaakamaro uba ugifite, habe no kurumbuura umurima cangwa kuboza ifumbire, ahuubwo ujugunywa hanze.</para>
  <para style="p" vid="LUK 14:35">Ufite amatwi yumva, niyumve.”<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s1">Umugani w'Intaama ya Zimiye</para>
  <para style="r">(<ref loc="MAT 18:12-14">Mat 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:29">Luk 5:29</ref>,<ref loc="LUK 5:30">30</ref>.</char>
    </note>Umunsi umwe, abasoreesha boose hamwe n'abanyabyaha, beegeera Yesu ngo bumve ibyo avuga. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />Nuuko Abafarisaayo n'abiigiishamategeko bariitotomba bati, “Uyu muntu ni inshuti y'abanyabyaha, ndetse asangira na bo.”<verse eid="LUK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3" />Yesu yumviise kwitootomba kwabo, abaciira umugani ati, <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />“Mbese ni nde muri mwe waba afite intaama ijana akazimiza imwe muri zo, ntaasige mirongo cenda n'icenda ngo aje gushaaka intaama imwe yazimiye kugeza aho aribuyibonere? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Iyo amaze kuyibona, araneezeerwa caane, akayiterura akayishira ku bitugu <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />akayijana iwe. Nuuko reero agatumira inshuti n'abatuuranyi be akababwira ati, ‘Twishiimane kuko naboonye intaama yanje yari yazimiye.’ <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Ndababwira yuuko ari ko no mu ijuru biishiimira umunyabyaha umwe wihannye kuruta intungaane mirongo cenda n'icenda zidakeneye kwihana.”<verse eid="LUK 15:7" /></para>
  <para style="s1">Umugani w'Igiceri Caazimiye</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />Yesu akomeza kuvuga ati, “cangwa se ni nde mugore waba afite ibiceri by'ifeeza cumi yasanga kimwe muri byo caazimiye, ntaacaane itaara, ngo akondoore inzu yoose, agashaaka yitonze kugeza ubwo aribukibonere? <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Iyo amaze kukibona, atumira inshuti n'abavandimwe kuuza iwe, akababwira ati, ‘Nimuuze twishiimane kuko naboonye igiceri nari naabuze.’ <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Ndababwira yuuko abaamalayika b'Imaana biishiimira umunyabyaha umwe wihannye.”<verse eid="LUK 15:10" /></para>
  <para style="s1">Umugani w'Umwana w'Ikirara</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Yesu abaciira undi mugani ati, “Haariho umugabo wari ufite abahungu babiri. <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />Umuhungu muto abwira se ati, ‘Daata mpa umugabane w'ibintu nkwiriye kugabana.’ Nuuko se abagabanya ibintu bye.<verse eid="LUK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 15:13" />Hashize iminsi mike, umuhungu muto afata umugabane we ava mu rugo aja mu gihugu ca kure. Agezeyo, aseesagura ibyo yagabanye, abikoreesha uko yishaakiye. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />Ibintu bye bishize, inzara ikomeye iteera muri ico gihugu, maze arakena. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Nuuko aragenda yinginga umuntu wo muri co gihugu amuhakwaho maze amuha umurimo wo kuragira ingurube. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Uwo muhungu yabuze uwamuha ico kurya agera n'aho kwifuuza ibyokurya by'ingurube.<figure style="fig" file="DD-15A.tif" size="col" copy="Darwin" ref="15:16">Uwo muhungu agera n'aho kwifuuza ibyokurya by'ingurube</figure><verse eid="LUK 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 15:17" />Atangira kwibwira ati, ‘Abakozi ba daata ni benshi, kandi bafite ibyokurya bihaagije ndetse bararya bakabisigaza, naho nje inzara igiiye kunyicira hano! <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Reka mpaguruke nje kwa daata mubwire nti, daata, nacumuye ku Maana no kuri wowe, <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />ntibinkwiriye kwitwa umwana waawe, ndakwinginze ndeka mbe nk'umwe mu bakozi baawe.’ <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />Nuuko arahaguruka asubira kwa se.</para>
  <para style="p" vid="LUK 15:20">Akiri kure, se aramubona, maze amugirira impuhwe. Arirukanka, aramuhoobera, maze aramusoma.<verse eid="LUK 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 15:21" />Nuuko uwo mwana abwira se ati, ‘Daata, nacumuye ku Maana no kuri wowe. Ntibinkwiriye kwitwa umwana waawe.’<verse eid="LUK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22" />Ariko se ahamagara abagaragu be arababwira ati, ‘Mumuuzanire imyambaro myiza, muyimwambike. Mumwambike impeta mu rutoki, n'ingato mu birenge. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />Muuzane n'ikimasa c'umushishe, mukibaage maze turye, twishiime, <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />kuko uyu mwana wanje yari yarapfuuye, noone yazuutse. Yari yarazimiye, noone dore arabonetse.’ Nuuko batangira kwishiima.<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />Mu gihe biishiimaga, mukuru we abe araaje avuuye mu murima gukora, yumva baririmba, babyina. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />Ahamagara umwe mu bagaragu, amubaza ibyabaaye. <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />Uwo mugaragu aramusubiza ati, ‘Murumuna waawe yagarutse mu rugo, noone so yategetse ko bamubagira ikimasa c'umushishe kuko yagarutse ari muzima.’<verse eid="LUK 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28" />Mukuru we aheerako araakara, yanga kwinjira mu nzu. Se arasohoka, aja kumuhendahenda ngo yinjire. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />Ariko uwo muhungu asubiza se ati, ‘Dore, maze imyaka myinshi ngukorera nk'umugaragu, nta tegeko ryawe na rimwe niigeze ngomera. Ntaaco wigeze umpa nuubwo kaaba agahene ngo niishiimane n'inshuti zanje. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />Noone uyu mwana waawe wagarutse amaze guseesagura ibyawe mu ndaaya ni we wabaagiye ikimasa c'umushishe?’<verse eid="LUK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31" />Se aramusubiza ati, ‘Mwana wanje ibihe byose turabaana kandi ibyanje byose ni ibyawe. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Ariko byari bikwiriye rwose ko tugira umunsi wo kuneezeerwa kuko uyu murumuna waawe yari yarapfuuye noone yazuutse. Yari yarazimiye noone dore arabonetse.’”<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s1">Yesu Yiigiisha Abiigiishwa be kuba Abiiringirwa</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Yesu aciira abiigiishwa be uyu mugani ati, “Haariho umukire wari ufite umutegeka wo yashinze ibintu bye byose. Igihe kimwe uwo mutegeka bamurega kuri sheebuja ko aseesagura umutungo we. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Nuuko sheebuja amutumaho aramubwira ati, ‘Ibyo nkumvaho ni ibiki? Nyanzurira ibyanje byose kuko utakiri umutegeka w'ibintu byanje.’<verse eid="LUK 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3" />Uwo mutegeka ariibaza ati, ‘Ndakora iki ko daatabuja agiiye kunyirukana ku murimo? Dore sinashobora guhinga, kandi no gusabiriza byankoza isoni. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Ubu mboonye uko nzaabigenza kugira ngo niimara kubura umurimo, nzaabone abanyakiira mu mago yaabo.’<verse eid="LUK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5" />Nuuko ahamagara buri muntu wari urimo umwenda wa sheebuja. Abaza uwa mbere ati, ‘Urimo umwenda wa daatabuja ungana iki?’<verse eid="LUK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6" />Aramusubiza ati, ‘Ibibindi ijana by'amavuta ya elayo.’</para>
  <para style="p" vid="LUK 16:6">Uwo mutegeka aramubwira ati, ‘Fata urwandiko rw'inyishu rwawe, wicare vuba, wandike mirongo itaanu.’<verse eid="LUK 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7" />Arongera abaza undi ati, ‘Kandi se wowe urimo umwenda ungana iki?’</para>
  <para style="p" vid="LUK 16:7">Aramusubiza ati, ‘Ni indengo ijana z'ingano.’</para>
  <para style="p" vid="LUK 16:7">Nuuko uwo mutegeka aramubwira ati, ‘Fata urwandiko rw'inyishu rwawe, maze wandike mirongo inaane.’<verse eid="LUK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 16:8" />Sheebuja ashiimagiza uwo mutegeka w'umuhemu kuko yagize ubwenge bwo kwiteguurira igihe kizaaza.” Nuuko Yesu akomeza kubasobaanurira ati, “Ni ukuri, abantu b'iyi si ni abanyabwenge mu mibaanire, no mu butunzi bwabo kuruta abaana b'umuco. <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" />Nuuko reero mukoreeshe ubutunzi bw'isi mubushaakiishe inshuti kugira ngo nibushira muzaakiirwe aho muziibeera iteeka.<verse eid="LUK 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 16:10" />Buri muntu wiringirwa mu bike, yiringirwa no mu byinshi. Kandi uhemuka mu bike, ahemuka no mu byinshi. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />Noone se niiba muhemuka mubiikijwe ubutunzi bw'iyi si, ni nde uzaababiitsa ubutunzi nyakuri? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />Kandi niiba mutaarabaaye abiiringirwa mubiikijwe ubutunzi bw'abandi, ni nde uzaabaha ubutunzi bwo mwigengaho?<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:13 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 6:24">Mat 6:24</ref>.</char>
    </note>Nta mugaragu ushobora gukorera abaami babiri ngo bombi abaneezeeze. Ahuubwo yakunda umwe akanga undi. Cangwa yakuubaha umwe agasuuzugura undi. Ntimushobora gukorera Imaana n'ubutunzi.”<verse eid="LUK 16:13" /></para>
  <para style="s1">Ibyerekeye Amategeko hamwe n'Ubwami bw'Imaana</para>
  <para style="r">(<ref loc="MAT 11:12-13">Mat 11:12-13</ref>; <ref loc="MAT 5:31-32">5:31-32</ref>; <ref loc="MRK 10:11-12">Mar 10:11-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Abafarisaayo bumviise ibyo, baramukwena kuko baakundaga amashilingi. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Yesu arababwira ati, “Mwebwe mukunda kwigira intungaane imbere y'abantu, ariko Imaana izi ibiri mu mitima yaanyu. Ico abantu baha agaciiro, kiba kigayitse imbere y'Imaana.<verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:16 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 11:12">Mat 11:12</ref>,<ref loc="MAT 11:13">13</ref>.</char>
    </note>Mwayoborwaga n'amategeko ya Moose n'abahanuuzi kugeza igihe ca Yohaana Umubatiza. Uheereye ico gihe, ubutumwa bw'Ubwami bw'Imaana butangira kwamamazwa kandi abantu benshi bashiishiikarira kubwinjiramo. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" /><note caller="-" style="x"><char style="xo" closed="false">16:17 </char><char style="xt" closed="false"><ref loc="MAT 5:18">Mat 5:18</ref>.</char></note>Birooroshe ko ijuru n'isi bishira, kuruta ko agace gato k'inyugute imwe yo mu mategeko kaavaho.<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:32">Mat 5:32</ref>; <ref loc="1CO 7:10">1 Kor 7:10</ref>,<ref loc="1CO 7:11">11</ref>.</char>
    </note>Umugabo wirukana umugore we, agashaaka undi aba akoze icaaha c'ubusambanyi. Kandi n'umugabo ushohoje umugore wirukanywe n'umugabo we, aba asambanye.”<verse eid="LUK 16:18" /></para>
  <para style="s1">Umugani w'umukire na Laazaaro</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />Yesu arababwira ati, “Haabaayeho umuntu w'umukire, yahoraga yambaye imyambaro myiza y'igiciiro, agahora adamaraye iminsi yoose. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />Haariho n'umugabo witwaga Laazaaro w'umukene kandi yahoraga aryamye ku muryango w'inzu y'uwo mukire. Umubiri we wari wuzuye ibisebe. <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />Yifuuzaga kurya ubuvungunyukira bw'ibyokurya bwagwaga haasi y'imeeza y'uwo mukire akabubura. Imbwa zaajaga zirigata ibisebe bye.<verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />Igihe kigeze, wa mukene arapfa, nuuko abaamalayika bamujaana kubaana na Aburahamu. Umukire na we arapfa arahambwa. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />Ageze ikuzimu, ubugingo bwe burababazwa caane. Yubuura amaaso areeba heejuru, abona Aburahamu ari kure, ari kumwe na Laazaaro iruhande rwe. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Nuuko ahamagara Aburahamu ataka caane ati, ‘Sogokuru Aburahamu! Nyaabuna mbabarira wohereze Laazaaro akoze agatoki mu maazi, abobeeze ururimi rwanje, kuko mbabazwa n'uyu muriro.’<verse eid="LUK 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25" />Aburahamu aramusubiza ati, ‘Mwana wanje, wibuke ko wahaawe ibyo wari ushaaka byose ukiri ku isi, naho Laazaaro we, akagira imibeereho mibi. Ariko ubu aguuwe neeza naho wowe urababaye caane.’ <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Uretse n'ibyo, hari umworera hagati yaacu naawe. Ntaamuntu n'umwe ushobora kuwambuka ngo ave aho turi maze ngo aze aho uri. Cangwa ngo ave aho uri aze hano, ntibyashoboka.<verse eid="LUK 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27" />Nuuko uwo mukire arongera abwira Aburahamu ati, ‘Sogokuru mbabarira, ndakwinginze ohereza Laazaaro aje i waacu mu rugo, <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />kuko mfite beene daata bataanu, maze abiihanangirize kugira ngo na bo batazaaza aha hantu ho kubabazwa.’<verse eid="LUK 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29" />Aburahamu aramubwira ati, ‘Beene so bafite Moose n'abahanuuzi bakwiriye kubumvira.’<verse eid="LUK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30" />Maze umukire aramusubiza ati, ‘Oya sogokuru Aburahamu ibyo ntibihaagije! Ahuubwo nihagira umuntu uzuuka akabasanga, baziihana ibyaha byabo, bagarukire Imaana.’<verse eid="LUK 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31" />Aburahamu aramubwira ati, ‘Niibanga kumvira Moose n'abahanuuzi, ntibaakwemera naaho umuntu yazuuka.’ ”<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s1">Kubabarira no Kwizeera</para>
  <para style="r">(<ref loc="MAT 18:6-7">Mat 18:6-7</ref>,<ref loc="MAT 18:21-22">21-22</ref>; <ref loc="MRK 9:42">Mar 9:42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Yesu abwira abiigiishwa be ati, “Ibituma abantu bacumura, ntibyabura kubaho. Ariko umuntu utuma abandi bacumura, azaabona ishano. <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />Icaaruta ni uko yahambiirwa urusyo mu ijosi, maze akarohwa mu nyanja ariko ntaacumuze umwe muri aba baana bato. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" /><note caller="-" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="MAT 18:15">Mat 18:15</ref>.</char></note>Nuuko reero mwirinde mu byo mukora byose.</para>
  <para style="p" vid="LUK 17:3">Mwene so naakora icaaha, umucaahe, niyihana umubabarire. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />Nuubwo yagucumuraho karindwi mu munsi umwe, akagusaba imbabazi karindwi, ugomba kumubabarira.”<verse eid="LUK 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Intumwa za Yesu ziramubwira ziti, “Daatabuja twongerere kwizeera.” <verse eid="LUK 17:5" /><verse number="6" style="v" sid="LUK 17:6" />Arazisubiza ati, “Mugize kwizeera kungana n'akabuto gato kitwa sinaapi, mwabwira igiti kinini c'umuvumu muti, ‘Randuka n'imizi yoose, maze witeerere mu nyanja,’ nuuko kikabumvira.”<verse eid="LUK 17:6" /></para>
  <para style="s1">Inshingano y'Umugaragu</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />Yesu arababaza ati, “Noone se ni nde muri mwe waba afite umugaragu akamwohereza guhinga cangwa kuragira intaama, yavayo sheebuja akamubwira ati, ‘Ngwino wicare, uruhuuke maze dusangire.’ <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Ahuubwo ntiyavuga ati, ‘Ngaaho reero nteguurira ico kurya maze wambare neeza ungaburire, nimara kurya, naawe ubone gufungura?’ <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Mbese sheebuja yashiima umugaragu ku bwo kumukorera ico yamutegetse? Oya, ntiyamushiima na hato.<verse eid="LUK 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 17:10" />Nuuko reero namwe ni uko, nimwumvira, mugakora ibyo Imaana ibategetse byose, mukwiriye kuvuga muti, ‘Ntaabwo turi abagaragu bakwiriye gushimwa, kuko twakoze ibyo dushinzwe.’ ”<verse eid="LUK 17:10" /></para>
  <para style="s">Yesu Akiza Ababembe Cumi</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Yesu n'abiigishwa be bakomeza urugendo baja i Yerusaalemu, banyura ku mupaka wo hagati ya Samariya na Galileeya. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Bageze mu caaro kimwe, bahuura n'ababembe cumi. Abo babembe bahagarara ahitaaruuye, <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />bateera heejuru bati, “Yesu, Daatabuja tubabarire, udukize!”<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />Yesu ababoonye arababwira ati, “Nimugende mwiyereke Abaheerezabitambo.” Bakigenda, barakira.<verse eid="LUK 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15" />Haanyuma umwe muri abo aboonye ko akize, agaruka ahimbaaza Imaana mu ijwi rirenga. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />Apfukama imbere ya Yesu yiciishije bugufi, aramushiima caane, kandi yari Umusamariya.<verse eid="LUK 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17" />Yesu arabaza ati, “Mbese sinakijije ababembe cumi? Abandi icenda bari he? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Ni kuki ari ntaawundi wagarutse gushiima Imaana uretse uyu munyamahanga?” <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Maze Yesu aramubwira ati, “Haguruka ugende, kwizeera kwawe kuragukijije.”<verse eid="LUK 17:19" /></para>
  <para style="s1">Kuuza k'Ubwami bw'Imaana</para>
  <para style="r">(<ref loc="MAT 24:23-28">Mat 24:23-28</ref>,<ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Umunsi umwe, Abafarisaayo baramubaza bati, “Ubwami bw'Imaana buzaaza ryari?” Yesu arabasubiza ati, “Ubwami bw'Imaana ntibuzaaza kumugaragaro ngo mubureebe n'amaaso yaanyu. <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />Kandi ntibazaavuga bati, ‘Dore nguubu hano’ cangwa ngo, ‘Nguubwo hariiya.’ Ahuubwo Ubwami bw'Imaana buri hagati muri mwe.”<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Nuuko Yesu abwira abiigiishwa be ati, “Igihe kizaagera co muzifuuza kubona umunsi umwe w'Umwana w'Umuntu, ariko ntimuzaawubona. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Abantu bazaababwira bati, ‘Dore Umwana w'Umuntu nguuriiya cangwa ngo nguuyu hano.’ Ariko ntimuzaajeyo ngo mubakurikire. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Igihe Umwana w'Umuntu azaaziraho, kizaamera nk'uko umurabyo, urabiriza mu ruhande rumwe rw'ikireere, ukarabagiranira mu rundi. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Ariko Umwana w'Umuntu akwiriye kubanza kubabazwa mu buryo bwinshi, ndetse no kwangwa n'abantu b'iki gihe. <verse eid="LUK 17:25" /><verse number="26" style="v" sid="LUK 17:26" />Nk'uko byari bimeze mu gihe ca Nowa, ni ko bizaamera no mu gihe co kugaruka k'Umwana w'Umuntu. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Muri ico gihe, abantu baariineezeezaga, baararyaga, baaranywaga, ndetse baarashingiranwaga, kugeza umunsi Nowa yinjiriye mu nkuge<note caller="+" style="f"><char style="fr" closed="false">17:27 </char><char style="ft" closed="false">Ubwato busakawe na caane ubwo mu gihe ca Nowa.</char></note>. Nuuko umwuzure uraaza urabarimbura boose. <verse eid="LUK 17:27" /><verse number="28" style="v" sid="LUK 17:28" />Uko ni ko byabaaye no mu gihe ca Looti. Abantu baararyaga, baranywaga, baaraguraga, bakaguriisha, bagahinga, ndetse bakuubaka, <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />kugeza igihe Looti yavuuye i Sodomu. Maze umuriro n'ibirimi byawo, biva mu ijuru, biragwa, birimbura abantu boose. <verse eid="LUK 17:29" /><verse number="30" style="v" sid="LUK 17:30" />Uko ni ko bizaamera ku munsi Umwana w'Umuntu azeerekanwa. <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" /><note caller="-" style="x"><char style="xo" closed="false">17:31 </char><char style="xt" closed="false"><ref loc="MAT 24:17">Mat 24:17</ref>,<ref loc="MAT 24:18">18</ref>; <ref loc="MRK 13:15">Mar 13:15</ref>,<ref loc="MRK 13:16">16</ref>.</char></note>Kuri uwo munsi, umuntu uzaaba ari heejuru y'inzu, ntaakazaamanuke ngo asubire mu nzu gushikiira ibintu birimo. Kandi n'uzaaba ari mu murima, ntaazaasubire mu rugo. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Mwibuke ibyabaaye ku mugore wa Looti. <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" /><note caller="-" style="x"><char style="xo" closed="false">17:33 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat 10:39</ref>; <ref loc="MAT 16:25">16:25</ref>; <ref loc="MRK 8:35">Mar 8:35</ref>; <ref loc="LUK 9:24">Luk 9:24</ref>; <ref loc="JHN 12:25">Yoh 12:25</ref>.</char></note>Umuntu weese urengera ubugingo bwe azaabubura, ariko uhara ubugingo bwe azaaburokora. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Ndababwira yuuko muri iryo joro abantu babiri bazaaba baryamye ku buriri bumwe, umwe azaajanwa undi asigare. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Abagore babiri bazaaba bari hamwe basya, umwe azaajanwa, undi asigare.” <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />(Abagabo babiri bazaaba bari mu murima, umwe azaajanwa naho undi asigare.)<verse eid="LUK 17:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />Abiigiishwa be baramubaza bati, “Nyagasani ibyo bizaabeera he?”</para>
  <para style="p" vid="LUK 17:37">Yesu arabasubiza ati, “Aho intumbi iri, ni ho inkongoro ziteeranira.”<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s1">Gusenga Ubutarambirwa</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Yesu aciira abiigiishwa be umugani ubiigiisha ko bakwiriye gusenga batarambirwa no kudaciika intege. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Arababwira ati, “Mu tawuni imwe, haari umucaamanza utaaruubahaga Imaana, ntiyite no ku bantu. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />Kandi muri iyo tawuni, haari hatuuyemo umupfaakazi, wahoraga aza kuri uwo mucaamanza amwinginga ati, ‘Nyaabuna nkiraanura nuuwo tubuurana.’ <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" />Ariko uwo mucaamanza amara igihe kireekire atabyitaho. Haanyuma ariibwira ati, ‘Nuubwo ntubaha Imaana, kandi siniite ku bantu, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />ariko kuko uyu mupfaakazi anduhije caane, ndamurengera kugira ngo adahora aza kundusha.’ ”<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />Nuuko Yesu arongera aravuga ati, “Ntimwumva iby'umucaamanza udatunganye yavuze? <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />Noone se, Imaana yo ntizaatabaara intoore zaayo ziyitakira ku manywa na nijoro? Mbese izaatinda kuziitaho? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Ndababwira yuuko Imaana izaazitabaara bidatinze. Ariko se Umwana w'Umuntu naagaruka azaasanga abantu bafite ukwizeera hano ku isi?”<verse eid="LUK 18:8" /></para>
  <para style="s1">Umugani w'Umufarisaayo n'Umusoreesha</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Yesu arongera aciira umugani bamwe mu bantu biibwiraga ko ari intungaane, kandi bagahinyura abandi boose. <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />Aravuga ati, “Abantu babiri baagiiye mu Nzu y'Imaana gusenga. Umwe yari Umufarisaayo, undi ari umusoreesha. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />Umufarisaayo ahagarara yemye arasenga ati, ‘Ndagushiima Maana kuko ntameze nk'abandi bantu. Si ndi umunyabyaha, si ndi umujuura ndetse sinsambana, simeze nk'uriya musoreesha. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Niiyiriza ubusa kabiri mu minsi irindwi kandi ntanga kimwe ca cumi mu byo nungutse byose.’<verse eid="LUK 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13" />Ariko umusoreesha ahagarara hiirya ahiitaaruuye ntiyahangaara no kuubuura amaaso ngo areebe heejuru. Ahuubwo yikubita mu gituuza yeerekana umubabaro avuga ati, ‘Nyaabuna Maana mbabarira, ndi umunyabyaha.’ ”<verse eid="LUK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 18:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:12">Mat 23:12</ref>; <ref loc="LUK 14:11">Luk 14:11</ref>.</char>
    </note>Maze Yesu aravuga ati, “Ndababwira yuuko uyu musoreesha, yasubiye iwe ababariwe ibyaha bye byose kuruta Umufarisaayo. Umuntu weese wishira heejuru, azaaciishwa bugufi, naho uwiiciisha bugufi, azaashirwa heejuru.”<verse eid="LUK 18:14" /></para>
  <para style="s1">Yesu Aha Abaana Bato Umugisha</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat 19:13-15</ref>; <ref loc="MRK 10:13-16">Mar 10:13-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Nuuko baazanira Yesu abaana bato ngo abafateho. Abiigiishwa be babiboonye barabacaaha, <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />ariko Yesu ahamagara abo baana ngo bamusange. Abwira abiigiishwa be ati, “Nimureke abaana bato baaze aho ndi, ntimubabuze kuko Ubwami bw'Imaana ni ubw'abameze nka bo. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Ndababwira yuuko umuntu weese utaakiira Ubwami bw'Imaana nk'umwana muto, ntiyabwinjiramo.”<verse eid="LUK 18:17" /></para>
  <para style="s1">Kuzigamira Ubwami bw'Imaana</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat 19:16-30</ref>; <ref loc="MRK 10:17-31">Mar 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Maze umwe mu bakuru b'Abayuuda abaza Yesu ati, “Mwigiisha mwiza, ngomba gukora iki ngo nzaahaabwe ubugingo buhoraho?”<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />Yesu aramusubiza ati, “Kuki unyita mwiza? Ntamwiza uriho keretse Imaana yoonyine. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />Uzi amategeko ngo, ‘Ntuugasambane, ntuukiice, ntuukiibe, ntuukabeeshere abandi, wubahe so na nyoko.’ ”<verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />Na we aramusubiza ati, “Uheereye mu buto bwanje, ayo yoose narayakurikije.”<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />Yesu yumviise ibyo aramubwira ati, “Hari ico usigaje gukora. Guriisha ubutunzi bwawe bwose, maze ibivuuyemo ubigabire abakene, nuurangiza ubone kunkurikira. Ubwo ni bwo uzunguka ibihembo mu ijuru.”<verse eid="LUK 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 18:23" />Ariko uwo mugabo yumviise ibyo biramubabaza caane kuko yari umukire uhebuuje. <verse eid="LUK 18:23" /><verse number="24" style="v" sid="LUK 18:24" />Yesu abiboonye abwira abantu ati, “Mbeega ukuntu biruhije ko abakire baakwinjira mu Bwami bw'Imaana! <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Birooroshe caane ko ingamiya inyura mu gapfumure k'urusindaani kuruta ko umukire yakwinjira mu Bwami bw'Imaana.”<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />Abantu bumviise Yesu avuze ibyo, baravuga bati, “Noone se ubwo bimeze bityo, ni nde ubaasha gukizwa?”<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />Yesu arababwira ati, “Ibidashobokera abantu, ku Maana birashoboka.”<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />Peetero abwira Yesu ati, “Dore twebwe twasize ibyacu byose turagukurikira.”<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />Yesu arababwira ati, “Ndababwira yuuko umuntu weese usiga urugo rwe, cangwa umugore we, cangwa beene nyina, cangwa ababyeyi be, cangwa abaana be ku bw'Ubwami bw'Imaana, <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />azaahaabwa ibirutaho inshuro nyinshi muri iki gihe, kandi no mu gihe kizaaza, azaahaabwa ubugingo buhoraho.”<verse eid="LUK 18:30" /></para>
  <para style="s1">Yesu Avuga iby'Urupfu Rwe Ubwa Gatatu</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat 20:17-19</ref>; <ref loc="MRK 10:32-34">Mar 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Yesu yihereerana abiigiishwa be cumi na babiri arababwira ati, “Dore turazaamuuka i Yerusaalemu, maze ibyanditswe ku Mwana w'Umuntu byose bizuuzuzwa. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />Azaagabizwa Abanyamahanga, azaashinyagurirwa, kandi bazaamuciiraho amacandwe. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />Kandi nibamara kumukubita inkoni, bazamwica. Ariko ku munsi wa gatatu azaazuuka.”<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />Abiigiishwa be ntibaabisobaanukirwa, kuko ayo magambo baari bayahishwe, ntibaamenya ico yamenyeeshaga.<verse eid="LUK 18:34" /></para>
  <para style="s1">Yesu Ahumuura Impumyi</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat 20:29-34</ref>; <ref loc="MRK 10:46-52">Mar 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Igihe Yesu yari haafi kugera i Yeriko, haari umuntu uhumye wicaye iruhande rw'inzira asabiriza. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Yumviise abantu banyuraho basakuza, ababaza ibyo ari byo. <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />Baramusubiza bati, “Ni Yesu w'i Nazaareeti unyuraho.”<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />Nuuko ateera heejuru avuga ati, “Yesu Mwana wa Dawudi, ngirira imbabazi!”<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />Abantu baari imbere ya Yesu baramucaaha ngo aceceke, ariko we arushaho gusakuza ati, “Mwene Dawudi, ngirira imbabazi!”<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />Yesu arahagarara, ategeka ko bamumuzanira. Bamugejeje aho ari, aramubaza ati, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />“Urashaaka ko ngukorera iki?”</para>
  <para style="p" vid="LUK 18:41">Aramusubiza ati, “Nyagasani, ndashaaka kongera kureeba.”<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />Nuuko Yesu aramubwira ati, “Reeba! Kwizeera kwawe kuragukijije.” <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />Muri ako kaanya arahumuuka, akurikira Yesu asingiza Imaana. Abantu boose baboonye ibibaaye, na bo basingiza Imaana.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s1">Zaakaayo Abona Agakiza</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Yesu yinjira i Yeriko maze ayinyuramo. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Haariho umugabo witwaga Zaakaayo, wari mukuru w'abasoreesha kandi ari umukire. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />Yagerageje kureeba Yesu ngo amumenye, ariko ntiyabishobora kuko yari mugufi kandi abantu baari benshi. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Nuuko ariiruka aja imbere, yurira igiti kugira ngo areebe Yesu, kuko yari azi ko agiiye kunyuraho.<verse eid="LUK 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5" />Yesu ageze kuri ico giti, areeba heejuru abona Zaakaayo maze aramubwira ati, “Zaakaayo, manuka vuba muri ico giti, kuko uyu munsi ndaraara mu nzu yaawe.” <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />Ako kaanya Zaakaayo yururuka vuba yakiira Yesu aneezeerewe. <figure style="fig" alt="Zacchaeus in tree" file="WA03891b.tif" size="span" loc="19:4-6" copy="Graham Wade" ref="19:5">Zaakaayo yurira igiti kugira ngo abone Yesu kuko yari mugufi.</figure><verse eid="LUK 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7" />Abaabiboonye boose, batangira kwitootomba bavuga bati, “Agiiye kubaramira umunyabyaha.”<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />Haanyuma Zaakaayo arahaguruka abwira Yesu ati, “Nyagasani, kimwe ca kabiri c'ibintu mfite, ndagiha abakene. Kandi uwo nambuye weese nsoreesha, ndamuriha inshuro enye.”<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />Yesu aravuga ati, “Uyu munsi agakiza kaaje muri iyi nzu, kuko uyu mugabo na we ari umwana wa Aburahamu. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" /><note caller="-" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="MAT 18:11">Mat 18:11</ref>.</char></note>Ndababwira ukuri yuuko Umwana w'Umuntu yaaje gushaaka no gukiza abaazimiye.”<verse eid="LUK 19:10" /></para>
  <para style="s1">Umugani w'Abagaragu Batatu</para>
  <para style="r">(<ref loc="MAT 25:14-30">Mat 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Yesu n'abantu baari bamukurikiye bagera bugufi bw'i Yerusaalemu. Abantu, baari kumwe na we baatekerezaga ko Ubwami bw'Imaana buribugaragare bagezeyo. Bacumva ibyo yababwiraga, abaciira uyu mugani ati, <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />“Haabaayeho umuntu w'igikomangoma, azindukira mu gihugu ca kure kugira ngo yimikirweyo, byarangira akagaruka mu gihugu ce. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Ataraagenda, ahamagara icumi mu bagaragu be, abaheereza ibiceri icumi by'ifeeza.<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="ft" closed="false">Ibiceri icumi by'ifeeza byari bifite agaciiro kanini caane kaagereranywa n'ishilingi umukozi wa reejareja yaakorera kumara ameezi atatu.</char></note> Arababwira ati, ‘Mubikoreeshe neeza mu bucuruuzi, kugeza igihe nzaagarukira.’<verse eid="LUK 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14" />Ariko abatuurage be baaramwangaga. Amaze kugenda, boohereza intumwa zo kumukurikira zivuga ziti, ‘Ntidushaaka ko uyu mugabo atubeera umwami.’<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />Amaze kwimikwa aragaruka, ategeka ko bamuuzanira abagaragu yasigiye ibiceri cumi by'ifeeza kugira ngo amenye ico buri muntu yungutse.<verse eid="LUK 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16" />Umugaragu wa mbere araaza aravuga ati, ‘Mwami, ifeeza wampaaye yungutse izindi cumi.’<verse eid="LUK 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17" />Umwami aramusubiza ati, ‘Warakoze mugaragu mwiza. Kuko wabaaye umwiringirwa mu bintu bike, nguhaaye kuba umutware w'amatawuni makuru cumi.’<verse eid="LUK 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18" />Umugaragu wa kabiri na we araaza aramubwira ati, ‘Mwami, ifeeza wampaaye yungutse izindi itaanu.’<verse eid="LUK 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19" />Umwami aramusubiza ati, ‘Ube umutware w'itawuni itaanu.’<verse eid="LUK 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20" />Undi mugaragu na we araaza aramubwira ati, ‘Mwami, dore ifeeza yaawe ngiiyi, nayipfunyitse neeza mu gitambaaro. <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />Naragutinye kuko uri umugabo w'umunyamwaga. Ujaana ibitari ibyawe, ugasaaruura ibyo utaabibye.’ <verse eid="LUK 19:21" /><verse number="22" style="v" sid="LUK 19:22" />Umwami aramusubiza ati, ‘Ndaguciira urubanza nkurikije ibiturutse mu kanwa kaawe wa mugaragu mubi we. Uvuga yuuko ndi umunyamwaga, kandi ko njaana ibyo ntaabiitse, ngasaaruura ibyo ntaabibye! <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />Kuki utaahaaye iyo feeza abacuruuzi ngo bayikoreeshe ivemo indamu?’<verse eid="LUK 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24" />Nuuko umwami abwira abaari bahagaze aho ati, ‘Nimuyimwake, muyiheereze umugaragu ufite ifeeza icumi.’ <verse eid="LUK 19:24" /><verse number="25" style="v" sid="LUK 19:25" />Ariko baramubwira bati, ‘Daatabuja, dore asanzwe afite ifeeza cumi!’ <verse eid="LUK 19:25" /><verse number="26" style="v" sid="LUK 19:26" /><note caller="-" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat 13:12</ref>; <ref loc="MRK 4:25">Mar 4:25</ref>; <ref loc="LUK 8:18">Luk 8:18</ref>.</char></note>Umwami arabasubiza ati, ‘Ndababwira ukuri yuuko ufite weese, azongererwaho, naho udafite, na gake afite azaagakuurwaho. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" /><note caller="-" style="x"><char style="xo" closed="false">19:27 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">Mat 25:14-30</ref>.</char></note>Naho abanzi banje bataashaakaga ko mbabeera umwami, nimubaazane hano biicirwe imbere yanje.’ ”<verse eid="LUK 19:27" /></para>
  <para style="s1">Yesu Aja i Yerusaalemu nk'Umwami</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21:1-11</ref>; <ref loc="MRK 11:1-11">Mar 11:1-11</ref>; <ref loc="JHN 12:12-19">Yoh 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Yesu arangije kuvuga ibyo, akomeza urugendo yeerekeje i Yerusaalemu. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Ageze bugufi bw'i Betifaage n'i Beetaniya ku musozi wiitwa Elayoni, yoohereza abiigiishwa be babiri, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />arababwira ati, “Nimugende mu caaro kiri imbere yaanyu, nimuhagera, murahasanga icaana c'indogobe kiziritse kitari caaheeka umuntu. Mukiziture maze mukinzanire. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Nihagira ubabaza ati, ‘Kuki mukizitura?’ Mumubwire muti, ‘Daatabuja ni we ugishaaka.’”<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />Baragenda, babona ico caana c'indogobe nk'uko Yesu yari yababwiye. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Bakizitura ico caana c'indogobe, ba nyiraco baraaza barababaza bati, “Murakiziturira iki?”<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />Barabasubiza bati, “Daatabuja ni we ugishaaka.”<verse eid="LUK 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35" />Nuuko abo biigiishwa baazaanira Yesu ico caana c'indogobe. Bakirambikaho imyenda yaabo maze aciicaraho. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Yagendaga basasa imyenda yaabo mu nzira.<verse eid="LUK 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37" />Ageze bugufi n'inzira imanuka ku musozi wa Elayoni, iteeraniro rinini ry'abiigiishwa be batangira guhimbaaza Imaana n'ijwi rirenga ku bw'ibitangaaza baboonye byose bati,<verse eid="LUK 19:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LUK 19:38" />“Hahiirwa Umwami uje mu izina rya Nyagasani!</para>
  <para style="q2" vid="LUK 19:38">Amahoro abe mu ijuru, n'icuubahiro kibe ic'Imaana mu ijuru.”<verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />Ariko Abafarisaayo baari muri iryo teeraniro babwira Yesu bati, “Mwigiisha, bwira abiigiishwa baawe baceceke.”<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />Yesu arabasubiza ati, “Ndababwira ukuri yuuko aba bacecetse, amabuye yarangurura.”<verse eid="LUK 19:40" /></para>
  <para style="s1">Yesu Aririra Yerusaalemu</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Yesu yegeereje itawuni y'i Yerusaalemu, arayiitegereza maze arayiririra kuko yagiriye impuhwe abantu bayituuyemo ndetse na yo ubwayo. <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />Aravuga ati, “Iyo umenya uyu munsi ibyaguheesha amahoro! Ariko reero dore bihishwe amaaso yaawe. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Igihe kiregeereje ubwo abanzi baawe bazaakuzitirira, bakakugota baguteeye impande zoose. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />Bazaakurimbura, n'abaana baawe bagutuuyemo, nta buye rizaasigara rigeretse ku rindi, kuko utaamenye igihe Imaana yaziye kugutabaara.”<verse eid="LUK 19:44" /></para>
  <para style="s1">Yesu Yirukana Abaacuruurizaga mu Nzu y'Imaana</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat 21:12-17</ref>; <ref loc="MRK 11:15-19">Mar 11:15-19</ref>; <ref loc="JHN 2:13-22">Yoh 2:13-22</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Haanyuma y'ibyo, Yesu yinjira mu Nzu y'Imaana atangira kwirukana abantu baacururizagamo. <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />Arababwira ati, “Handitswe ngo, ‘Inzu yanje izaaba inzu yo gusengeramo,’ ariko mwebwe mwayihinduye iteeraniro ry'abajuura.”<verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:47 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 21:37">Luk 21:37</ref>.</char>
    </note>Buri munsi Yesu yigiishirizaga mu Nzu y'Imaana. Abaheerezabitambo bakuru n'abiigiishamategeko n'abakuru b'imiryango y'Abayuuda, baashaakaga kumwica, <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />ariko babura aho bamuturuka kuko abantu benshi baazaga kumutega amatwi biitaaye ku magambo ye.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s1">Abakuru Babaza Yesu aho Ububaasha bwe Buturuka</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat 21:23-27</ref>; <ref loc="MRK 11:27-33">Mar 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Umunsi umwe, Yesu yigiishaga abantu avuga Ubutumwa Bwiza mu Nzu y'Imaana. Aciigiisha, abakuru b'abaheerezabitambo n'abiigiishamategeko hamwe n'abakuru b'Abayuuda baja aho ari <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />baramubaza bati, “Tubwire, ni bubaasha ki butuma ushobora gukora ibi bintu? Ni nde waguhaaye ubwo bubaasha?”<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />Yesu arabasubiza ati, “Reka nanje mbabaze. <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />Mbese ububaasha Yohaana yari afite bwo kubatiza bwaturutse ku Maana cangwa ni ku bantu?”<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />Batangira kubwirana bati, “Nituvuga ko bwaturutse ku Maana, aratubaza icaatumye tutamwemera, <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />kandi nituvuga ngo bwaturutse mu bantu, abantu baraduteera amabuye, kuko beemera ko Yohaana yari umuhanuuzi woherejwe n'Imaana.”<verse eid="LUK 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7" />Bagezaho baramusubiza bati, “Ntituuzi aho bwaturutse.”<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />Yesu arababwira ati, “Nuuko reero nanje simbabwira ububaasha bunteera gukora ibi.”<verse eid="LUK 20:8" /></para>
  <para style="s1">Umugani w'Abahinzi b'Abagome</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat 21:33-46</ref>; <ref loc="MRK 12:1-12">Mar 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Haanyuma Yesu aciira abantu umugani ati, “Umugabo yateeye imizaabibu mu murima we, awatira abahinzi maze ariigendera, aja mu kindi gihugu amarayo igihe kireekire. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Igihe c'isaaruura kigeze, nyir'umurima atuma umwe mu bagaragu be kuri abo baatiishwa ngo bamumuheere ubwatamurima bw'imbuto zo mu murima we. Ariko abo baatiisha baramukubita, baramwirukana, asubirayo ubusa. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Nyir'umurima arongera atuma undi mugaragu ariko uwo mugaragu baramutuka, baramukubita, baramuhemura agenda ubusa. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Yoohereza intumwa ya gatatu nuuko na yo barayikomeretsa barayiirukana.<verse eid="LUK 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13" />Haanyuma nyir'umurima ariibaza ati, ‘Nzaakora iki? Nzaatuma umwana wanje nkunda ahaari we bazaamwumvira.’<verse eid="LUK 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14" />Ariko abo bahinzi baboonye uwo mwana baja inaama bati, ‘Dore umuragwa araaje, reka tumwice maze uyu murima w'imizaabibu uzaabe uwaacu.’ <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Nuuko bamujugunya inyuma y'uwo murima w'imizaabibu, baramwica.”</para>
  <para style="p" vid="LUK 20:15">Yesu abaza abamwumvaga ati, “Mbese nyir'umurima azaagenza ate abo batiishwaga umurima we? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Ndababwira ukuri yuuko azaaza akabarimbura maze umurima we akawatira abandi.”</para>
  <para style="p" vid="LUK 20:16">Abantu babyumviise baravuga bati, “Ibyo ntibikabeho!”<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />Yesu arabiitegereza arababaza ati, “Mbese ibi byanditswe bivuga iki?</para>
  <para style="q1" vid="LUK 20:17">‘Ibuye abuubatsi banze</para>
  <para style="q2" vid="LUK 20:17">ni ryo ryabaaye inkomezamfuruka.’<verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />Uzaagwira iryo buye weese, azaashenjagurika ahinduke ubushingwe kandi uwo rizaagwira, azaahinduka ivu.”<verse eid="LUK 20:18" /></para>
  <para style="s1">Ibyerekeye Gutanga Umusoro</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat 22:15-22</ref>; <ref loc="MRK 12:13-17">Mar 12:13-17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Maze ako kaanya abiigiishamategeko hamwe n'abakuru b'abaheerezabitambo bashaaka kumufata kuko baamenye ko ari bo yavugaga muri uwo mugani w'abahinzi b'abagome, ariko Batiinya abantu.<verse eid="LUK 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20" />Batuma abantu kumutata, bamugenzuuza biiyoberanya nk'aho batunganye. Bashaakaga uko baamubonaho impamvu mu byo yavugaga kugira ngo babone uko bamugabiza abategetsi hamwe n'umutware mukuru w'igihugu. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Baramubaza bati, “Mwigiisha tuuzi ko uvuga ukuri kandi ukiigiisha ibitunganye. Ntuurobaanura k'ubutoni ahuubwo wiigiisha inzira y'Imaana mu kuri. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Mbese amategeko yemera ko duha Umwami mukuru w'ubutegetsi bwa Rooma umusoro, cangwa ntabyemera?”<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />Yesu amenya uburyarya bwabo arababwira ati, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />“Nimunyereke igiceri. Iri shusho hamwe n'izina byanditsweho ni ibyande?”</para>
  <para style="p" vid="LUK 20:24">Baramusubiza bati, “Ni irya Kayisaari.”<verse eid="LUK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25" />Yesu arababwira ati, “Nuuko reero muhe Umwami ibye, n'Imaana muyihe ibyayo.”<verse eid="LUK 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26" />Babura uko bamufatira mu magambo yavugiye ku mugaragaro, ahuubwo batangaazwa n'igisubizo ce maze baraceceka.<verse eid="LUK 20:26" /></para>
  <para style="s1">Abasadukaayo Bagerageza Yesu ku by'Izuuka ry'Abaapfuuye</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat 22:23-33</ref>; <ref loc="MRK 12:18-27">Mar 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:27 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">Iby 23:8</ref>.</char>
    </note>Nuuko Abasadukaayo bamwe bateemeraga ko abaapfuuye bazaazuuka, baaza aho Yesu ari baramubaza bati, <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />“Mwigiisha, Moose yatwandikiye iri tegeko ngo, ‘Umuntu apfuuye agasiga umugore batabyaranye, mwenenyina agomba gucuura uwo mupfaakazi kugira ngo babyarane abaana bitirirwe nyakwigendera.’ <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Haabaayeho abagabo barindwi bava inda imwe, umukuru ashaaka umugore ariko apfa batabyaranye. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />Nuuko uwo mupfaakazi acuurwa na muramu we, ariko na we apfa bataraabyarana. <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />N'undi muramu we wa gatatu amucuuye, biba bityo. Nuuko boose uko ari barindwi bariihetuura, bapfa ari nta n'umwe umubyayemo umwana. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Haanyuma n'uwo mugore arapfa. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Noone tubwire, mbese mu gihe co kuzuuka, uwo mugore azaaba muka nde ko yatunzwe n'abagabo barindwi?”<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />Yesu arabasubiza ati, “Abantu b'iki gihe ni bo bagira abagabo cangwa abagore. <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />Ariko abo Imaana izaasanga bakwiriye kuba muri iyo si nsha, no kuzuuka mu bapfu, ntibazaagira abagore cangwa abagabo. <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />Kandi muri iyo si, ntibazaapfa nk'uko biriho ubu, kuko bazaamera nk'abaamalayika badapfa. Bazaaba abaana b'Imaana kuko ari bo izaaba yarazuuye mu bapfu, kugira ngo babone ubugingo buhoraho. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Ariko niiba abaapfuuye bazaazuuka, Moose na we yarabigaragaje ubwo yanditse ibyerekeye gusha kw'igishamba. Ico gihe, Aburahamu, Isaaka na Yaakobo baari baarapfuuye. Haanyuma Moose yeerekana ko Uwiteeka, ari Imaana ya Aburahamu, na Isaaka, na Yaakobo. <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />Nuuko reero ni Imaana y'abazima ntaabwo ari iy'abaapfuuye, kuko ku bwayo, abo boose bavuzweho ni bazima.”<verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />Bamwe mu biigiishamategeko baari aho, baravuga bati, “Mwigiisha uvuze neeza.” <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Maze ntihaagira undi weese utiinyuka kugira ikindi amubaza.<verse eid="LUK 20:40" /></para>
  <para style="s1">Ibyerekeye Kristo Ukomooka kuri Dawudi</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat 22:41-46</ref>; <ref loc="MRK 12:35-37">Mar 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Maze Yesu arababaza ati, “Ni iki gituma abantu bavuga ngo Kristo ni mwene Dawudi? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />Mu gitabo ca Zaaburi, Dawudi ubwe ahamya yeruye ati,</para>
  <para style="q1" vid="LUK 20:42">‘Imaana yabwiye Kristo Umwami wanje iti, Icara iburyo bwanje<verse eid="LUK 20:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="LUK 20:43" />kugeza igihe nzaashirira abanzi baawe muusi y'ibirenge byawe.’<verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />Mbese ko Dawudi yita Kristo Umwami we, byashoboka bite ko Kristo aba umwuzukuruza we?”<verse eid="LUK 20:44" /></para>
  <para style="s1">Yesu Ahinyura Abiigiishamategeko</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23:1-36</ref>; <ref loc="MRK 12:38-40">Mar 12:38-40</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Nuuko abantu benshi bumva Yesu abwira abiigiishwa be ati, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />“Mwirinde Abiigiishamategeko. Bakunda kugenda bambaye amakanzu mareemare no kuramutswa mu maguriro, ndetse no kwicara mu ntebe z'ibyubahiro mu masinagoogi no mu myanya y'ibyubahiro mu mashitsi. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />Barya ingo z'abapfaakazi bakiiha kuvuga amasengeesho y'urudaca biiyererutsa. Abo bazaahanwa bikabije.”<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s1">Ituuro ry'Umupfaakazi w'Umukene</para>
  <para style="r">(<ref loc="MRK 12:41-44">Mar 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Mu gihe Yesu yari mu Nzu y'Imaana, abona abakire batuura amatuuro yaabo mu bubiiko bwayo. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />Abona n'umupfaakazi w'umukene atuura ibiceri bibiri. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Yesu arababwira ati, “Ndababwira ukuri yuuko uyu mupfaakazi w'umukene atuuye kuruta abandi boose, <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />kuko abandi boose batanze amatuuro y'ibisaagutse. Ariko uyu mupfaakazi mu bukene bwe, atanze ibyo yari atezeho amakiriro.”<verse eid="LUK 21:4" /></para>
  <para style="s1">Yesu Yeerekana Ibizaaba mu Gihe Kizaaza</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mat 24:1-2</ref>; <ref loc="MRK 13:1-2">Mar 13:1-2</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Maze bamwe mu biigiishwa be batangira kuvuga ku Nzu y'Imaana, ukuntu itaatswe n'amabuye meeza, ndetse n'amatuuro atuurwa Imaana. Yesu aravuga ati, <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />“Ibi byose mureeba, igihe kizaagera ubwo hatazaagira ibuye na rimwe rizaasigara rigeretse ku rindi ritajugunywe haasi.”<verse eid="LUK 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />Bamwe mu bantu baramubaza bati, “Mwigiisha, ibi bizaaba ryari? Kandi se n'ikimenyeetso ki ceerekana gusohora kwabyo?”<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />Yesu arabasubiza ati, “Muramenye ntihakagire ubayobya kuko benshi bazaaza biitwaje izina ryanje bavuga bati, ‘Ni nje Kristo,’ kandi bati, ‘Igihe kirageze’ ariko ntimuzaabyemere. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Ubwo muzumva intambara hamwe n'umwiryane, ntimuzaahagarike imitima kuko ibi bizaabanza kubaho. Ariko imperuuka izaaba itaraagera.”<verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />Arongera arababwira ati, “Ubwoko buzaateera ubundi, ndetse n'ubwami buteere ubundi. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Hazaabaho imishitsi iteeye ubwoba, kandi hazaaba inzara n'indwara z'ibyorezo. Hazaabaho ibintu biteeye ubwoba hamwe n'ibimenyeetso bikomeye biturutse mu kireere.<verse eid="LUK 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 21:12" />Ariko mbere y'ibi byose, bazaabafata, bazaabarenganya, kandi muzaaregwa mu masinagoogi, ndetse muzaashirwa no mu bihome. Bazaabaazana imbere y'abaami n'imbere y'abategetsi muzira izina ryanje. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />Iki kizaaba ari co gihe caanyu co kuba abahamya banje. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" /><note caller="-" style="x"><char style="xo" closed="false">21:14 </char><char style="xt" closed="false"><ref loc="LUK 12:11">Luk 12:11</ref>,<ref loc="LUK 12:12">12</ref>.</char></note>Ntimuhagarike imitima y'ibyo muzaasubiza. <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />Kuko nzaabaha amagambo n'ubwenge, byo ababarwanya boose batazaashobora gutsinda cangwa ngo bavuguruze. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Muzaagambaanirwa n'ababyeyi, na beene so, n'abavandimwe, n'inshuti kandi baziiciisha bamwe muri mwe. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Muzangwa na boose muzira izina ryanje. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Ariko ntihazaagira agasatsi na kamwe ko ku mitwe yaanyu kazaagira ico kaba. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Nimwihangaana, muzaakiza ubugingo bwanyu.<verse eid="LUK 21:19" /></para>
  <para style="s1">Kurimbuka kwa Yerusaalemu</para>
  <para style="r">(<ref loc="MAT 24:15-21">Mat 24:15-21</ref>; <ref loc="MRK 13:14-19">Mar 13:14-19</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />Ariko ubwo muzaabona Yerusaalemu igoswe n'ingabo, muzaamenye ko kurimbuka kwayo kwegeereje. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Muri ico gihe, abazaaba bari i Yudeeya bazaahungire mu misozi, n'abazaaba bari mu tawuni<note caller="+" style="f"><char style="fr" closed="false">21:21 </char><char style="ft" closed="false">Tawuni Yesu yamenyeeshaga ni Yerusaalemu.</char></note> hagati, bazaayivemo. Abazaaba bari mu caaro ntibazinjire mu tawuni. <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />Kuko iyo izaaba ari iminsi yo guhoora kw'Imaana kugira ngo ibyanditswe bisohore. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Muri iyo minsi abazaaba batwite, n'abonsa muri iyo minsi bazaabona ishano. Kuko hazaabaho ububabare mu isi, n'umujinya ku bantu. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />Baziicwa n'inkota cangwa bajanwe ari imbohe mu mahanga yoose. I Yerusaalemu hazanyukwanyukwa n'abanyamahanga kugeza ubwo igihe caabo kizaagera ku iherezo.<verse eid="LUK 21:24" /></para>
  <para style="s1">Ukuuza k'Umwana w'Umuntu</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat 24:29-31</ref>; <ref loc="MRK 13:24-27">Mar 13:24-27</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:25 </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:12">Ibya 6:12</ref>,<ref loc="REV 6:13">13</ref>.</char>
    </note>Hazaaba ibimenyeetso ku izuuba, no ku kwezi no ku nyenyeeri. Amahanga yo mu isi azaababara, akuurwe umutima no guhoorera kw'inyanja n'imivumba. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />Abantu bazaagwa gihuubara biteewe n'ubwoba, bahagarike imitima biteewe n'amakuba azaaba yadutse. Hazaabaho gushaakashaaka ibigiiye kuba ku isi, kuko ijuru ryose rizatigiswa n'imbaraga z'Imaana. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" /><note caller="-" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="REV 1:7">Ibya 1:7</ref>.</char></note>Nuuko Umwana w'Umuntu aheereko agaragare mu bicu, afite ububaasha, n'ikuzo ryinshi. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Ibi nibitangira kubaho, muzaahaguruke mureebe heejuru, kuko gucungurwa kwanyu kuzaaba kuri bugufi.”<verse eid="LUK 21:28" /></para>
  <para style="s1">Iciitegererezo c'Igiti c'Umutiini</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mat 24:32-35</ref>; <ref loc="MRK 13:28-31">Mar 13:28-31</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Nuuko Yesu abaciira umugani ati, “Mwitegereze igiti c'umutiini cangwa ibindi biti byose, <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />iyo amababi yabyo ashibutse, mumenya ko igihe c'urugaryi ceegereje. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Nuuko reero, nimubona ibi bibaaye, muzaamenye yuuko Ubwami bw'Imaana buri haafi.<verse eid="LUK 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32" />Ndababwira ukuri yuuko abantu b'iki gihe batazaashiraho ibi byose bitaraaba <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Ijuru n'isi bizaashira, ariko amagambo yanje ntaazaashira.<verse eid="LUK 21:33" /></para>
  <para style="s1">Mube Maaso</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />Mwirinde imitima yaanyu itazaatwarwa n'ingeso mbi, gusinda hamwe no kwiganyira ko muri ubu bugingo. Nimukora mutyo, uwo munsi ntuzaabatungura <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />nk'uko umutego ubashuka. Kuko uzaazira abantu boose batuuye ku isi. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Nuuko reero mube maaso buri gihe, kandi musenge kugira ngo mubone uko murokoka ibizaabaho byose, ndetse mushobore guhagarara imbere y'Umwana w'Umuntu.”<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:37 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:47">Luk 19:47</ref>.</char>
    </note>Buri munsi, Yesu yajaga mu Nzu y'Imaana kwigiisha, ariko nimugorooba akaja kuraara ku musozi wiitwa Elayoni. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />Abantu boose baahagurukaga kare mu gitondo baaza mu Nzu y'Imaana kumva ibyo yigiishaga.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s1">Yuda Ashaaka Uburyo bwo Kugambaanira Yesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26:1-5</ref>; <ref loc="MRK 14:1-2">Mar 14:1-2</ref>; <ref loc="JHN 11:45-53">Yoh 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Nuuko igihe c'ubushitsi bwo kurya Imigaati Idasembuwe ceegereje, <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />abakuru b'abaheerezabitambo n'abiigiishamategeko baakomeje gushaakiisha ukuntu baakwiciisha Yesu, kuko baatiinyaga rubanda.<verse eid="LUK 22:2" /></para>
  <para style="s1">Yuda Yemera Kugambaanira Yesu</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mat 26:14-16</ref>; <ref loc="MRK 14:10-11">Mar 14:10-11</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />Nuuko Sataani yinjira mu mutima wa Yuda Isikariyoti wari umwe mu biigiishwa cumi na babiri. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Maze Yuda asanga abakuru b'abaheerezabitambo, n'abakuru b'abasirikare hamwe n'abarinzi b'Inzu y'Imaana, aja inaama na bo ukuntu azaabagenzereza Yesu ngo bamufate. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Bituma baneezeerwa caane, kandi bamuseezeranya ikiguzi bazaamuha. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Yuda arabibeemerera, atangira gushaakashaaka uko yabafasha kumufata rubanda rutariho.<verse eid="LUK 22:6" /></para>
  <para style="s1">Kwiteguurira Ifunguro ryo Kunyurwaho</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat 26:17-25</ref>; <ref loc="MRK 14:12-21">Mar 14:12-21</ref>; <ref loc="JHN 13:21-30">Yoh 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Umunsi wo kwiteguurira ibirori by'Imigaati Idasembuwe uragera. Kuri uwo munsi buri muryango watambaga umwana w'intaama w'ibirori byo Kunyurwaho. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Maze Yesu atuma Peetero na Yohaana, arababwira ati, “Muje mu tawuni muduteguurire uko turibusangire ifunguro ryo Kunyurwaho.”<verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />Baramubaza bati, “Tubiteguurire he?”<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />Yesu arabasubiza ati, “Nimugera mu tawuni muribuhuure n'umugabo wiikoreye ikibindi cuuzuye amaazi, mujaane na we mu nzu aribwinjiremo <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />nuuko mubwire nyir'inzu muti, ‘Umwigiisha adutumye kukubaza ngo, mbese umwanya ndibusangiriremo ifunguro ryo Kunyurwaho n'abiigiishwa banje uri he?’ <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />Uwo mugabo aribubeereke igisenge kinini co mu nzu yo heejuru. Ibyo mwifuuza byose murabisangamo, abe ari ho mutunganya.”<verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />Na bo baja mu tawuni basanga ibyo yababwiye byose biri nk'uko yabivuze. Nuuko bateguura ifunguro ryo Kunyurwaho.<verse eid="LUK 22:13" /></para>
  <para style="s1">Yesu Asangira n'Abiigiishwa be Ifunguro rya Nyuma</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mat 26:26-30</ref>; <ref loc="MRK 14:22-26">Mar 14:22-26</ref>; <ref loc="1CO 11:23-25">1 Kor 11:23-25</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Igihe kigeze, Yesu n'abiigiishwa be bariicara ngo barye. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Maze Yesu arababwira ati, “Niifuuje caane gusangira namwe ibi birori byo Kunyurwaho ntaraagera igihe co kubabazwa. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />Ibyo mbibabwiye nkomeje ko ntazongera kurya irindi funguro ryo Kunyurwaho, kugeza igihe bizuuzurizwa mu Bwami bw'Imaana.”<verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />Nuuko afata igikopu ca divaayi ashiima Imaana, abwira abiigiishwa be ati, “Nimwakiire iki gikopu ca divaayi maze musangire. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />Ndababwira ukuri yuuko ntazongera kunywa ku mbuto z'imizaabibu kugeza ubwo Ubwami bw'Imaana buzaazira.”<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />Yesu afata umugaati, ashiima Imaana, arawumanyagura maze aheereza abiigiishwa be avuga ati, “Uyu mugaati ni umubiri wanje utanzwe ku bwanyu. Muje muhora mugenza mutya kugira ngo munyibuke.”<verse eid="LUK 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20" />Bamaze kurya, Yesu afata igikopu ca divaayi nk'uko yari yafashe umugaati aravuga ati, “Iki gikopu ni iseezerano risha Imaana iseezerana n'abantu ku bw'amaraso yanje azaamenwa ku bwanyu. <verse eid="LUK 22:20" /><verse number="21" style="v" sid="LUK 22:21" />Ariko, dore uwo ugiiye kungambaanira ni uwo dusangira kuri iyi meeza. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Koko Umwana w'Umuntu azaapfa nk'uko byateguuwe n'Imaana, ariko kandi uwo umugambaanira azaagira iheerezo ribi.”<verse eid="LUK 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23" />Abiigiishwa batangira kubazanya ubwabo, uzaamugambaanira uwo ari we muri bo.<verse eid="LUK 22:23" /></para>
  <para style="s1">Yesu Asobaanura Uruta Abandi uwo ari we</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Nuuko abiigiishwa baja impaka bashaaka kumenya ukwiriye kuba mukuru uwo ari we. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Yesu arababwira ati, “Abaami b'iyi si bategekeesha abantu agahato, kandi abo batware bafite ububaasha kuri abo bantu, bagashaaka kwiyita abagiraneeza. <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />Ariko mwebweho ntimukagenze mutyo. Ahuubwo umukuru muri mwe akwiriye kuba nk'umwana muto. Uyobora abandi akwiriye kuba nk'umugaragu. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Noone se umukuru ni uwuhe, uwiicaye agaburirwa cangwa ugabura? Mbese ntaabwo ari uwo ugaburirwa? Dore mbaana na mwe nsa nk'ubaheereza. <verse eid="LUK 22:27" /><verse number="28" style="v" sid="LUK 22:28" />Nimwe mwagumanye nanje muri byose no mu ngoorane zanje zoose. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />Nk'uko nanje Daata yampaaye ubushobozi bwo kuba Umwami, nanje mbahaaye ubutware bwo gutegeka abaami. <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />Ibyo nzaabibakorera kugira ngo musangire nanje mu bihe byose uko nzaaba ntegeka ndi Umwami. Muziicara nk'abaami muciira imanza imiryango cumi n'ibiri y'abantu ba Isirayeli.”<verse eid="LUK 22:30" /></para>
  <para style="s1">Yesu Avuga ko Simooni Peetero Aribumwihakane</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>; <ref loc="MRK 14:27-31">Mar 14:27-31</ref>; <ref loc="JHN 13:36-38">Yoh 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />Nuuko Yesu abwira Peetero ati, “Simooni, Simooni, Umva! Sataani yasabye Imaana ngo abagosoore nk'uko umuhinzi agosoora amasaka. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />Ariko wowe Simooni naagusabiye ku Maana ngo kwizeera kwawe kudacoogora buheriheri. Kandi nuumara gukomera ufashe bagenzi baawe na bo bakomere mu kwizeera.”<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Simooni aramusubiza ati, “Nyagasani, niiyemeje kujaana na we mu nzu y'imbohe ndetse no mu rupfu.”<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />Ariko Yesu aramubwira ati, “Peetero, reka nkwerurire yuuko iri joro isaaki itaraabika, uribube unyihakanye gatatu.”<verse eid="LUK 22:34" /></para>
  <para style="s1">Umufuka w'Amashilingi, Igikapu hamwe n'Inkoota</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Nuuko Yesu abaza abiigiishwa be ati, “Ubwo nabatumaga kuvuga Inkuru Nziza mutagira amashilingi mu mifuka, igikapu cangwa ingato, muri ibyo hari na kimwe mwakeneye?”</para>
  <para style="p" vid="LUK 22:35">Baramusubiza bati, “Ntaaco.”<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />Nuuko Yesu arababwira ati, “Ariko ubu si ko bimeze. Ufite amashilingi ayitwaze, ndetse n'ufite igikapu ntakagisige. Kandi niiba muri mwe hari utagira inkoota, kandi akaba nta mashilingi yo kuyigura, naguriishe umwiteero we kugira ngo agire inkoota. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />Ndababwira yuuko ibyanyanditsweho bigomba kumbaho. Mu byanditswe havuga ngo, ‘Kandi yabaranywe n'abanyabyaha.’ Kandi ndababwira yuuko ayo magambo asohorezwa muri nje. Kuko ibyanditswe kuri nje bigiiye kuba.”<verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />Baramubwira bati, “Nyagasani, dore inkoota ibiri ngiizi.”</para>
  <para style="p" vid="LUK 22:38">Arabasubiza ati, “Izo zirahaagije.”<verse eid="LUK 22:38" /></para>
  <para style="s1">Yesu Asenga Afite Ishavu</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat 26:36-46</ref>; <ref loc="MRK 14:32-42">Mar 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Yesu arasohoka aja ku musozi wa Elayoni nkuko yari yaramenyereye, maze abiigiishwa be baramukurikira. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Agezeyo arababwira ati, “Musenge kugira ngo mutagwa mu moosha.” <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />Yigira imbere ho gato, arapfukama arasenga ati, <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />“Daata niiba ari ubushaake bwawe unkize uyu mubabaro. Ariko bye kuba uko mbishaaka ahuubwo bibe nk'uko wowe ubishaaka.” <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />[Agisenga, malayika ava mu ijuru aramubonekera aramukomeza. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Yesu arushaho gusenga afite ishavu ryinshi n'agahinda kenshi. Atangira kubira ibyuya byinshi caane bigwa haasi bisa n'ibitonyanga by'amaraso.]<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="ft" closed="false">Mu byanditswe bimwe ntiharimo iyi imirongo ebyiri uwa 43 n'uwa 44 </char></note><verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Amaze gusenga asubira aho yari yasize abiigiishwa be, asanga basinziiriye ku bw'agahinda. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />Yesu arababaza ati, “Ni iki gitumye musinziira? Nimubyuke, musenge mutagwa mu moosha.”<verse eid="LUK 22:46" /></para>
  <para style="s1">Bafata Yesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26:47-56</ref>; <ref loc="MRK 14:43-50">Mar 14:43-50</ref>; <ref loc="JHN 18:3-11">Yoh 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Yesu akivugana n'abiigiishwa be, haaza igiteero c'abantu kiyobowe na Yuda Isikariyoti, maze yegeera Yesu ngo amuramutse amusome. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Yesu aramubaza ati, “Yuda, uragambaanira Umwana w'Umuntu umusoma?”<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />Ba biigiishwa baari na Yesu, baboonye ibigiiye kubaho babaza Yesu bati, “Nyagasani, tubakubite inkoota?” <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Umwe muri bo ayikubita umugaragu w'Umuheerezabitambo Mukuru, amuca ugutwi kw'iburyo.<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />Yesu arababwira ati, “Mureke kurwana.” Maze afata kwa gutwi agusubizaho aramukiza.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />Nuuko Yesu abaza Bakuru b'Abaheerezabitambo, n'abarinzi b'Inzu y'Imaana n'abandi bantu bakuru baari baaje kumufata ati, “Mwari mugomba kunteera nk'abateeye umwambuzi? Dore muuje kumfata mufite inkoota n'ubuhiri. <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />Igihe nabaaniye na mwe mu Nzu y'Imaana ntiimwigeze munkozaho urutoki cangwa ngo murambuure amaboko mumfate. Ariko nooneho igihe caanyu c'ubutegetsi bw'umwijima kirageze.”<verse eid="LUK 22:53" /></para>
  <para style="s1">Peetero Yihakana Yesu</para>
  <para style="r">(<ref loc="MAT 26:57-58">Mat 26:57-58</ref>,<ref loc="MAT 26:69-75">69-75</ref>; <ref loc="MRK 14:53-54">Mar 14:53-54</ref>,<ref loc="MRK 14:66-72">66-72</ref>; <ref loc="JHN 18:12-18">Yoh 18:12-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Nuuko bafata Yesu, baramujaana bamushira mu nzu y'Umuheerezabitambo Mukuru. Maze Peetero amukurikira arenga ahinguka. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Abantu bacaana umuriro batangira koota. Peetero na we yicara muri bo. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Maze umwe wari umuja aramwitegereza aravuga ati, “Uyu mugabo na we yari kumwe na Yesu.”<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />Ariko Peetero arahakana aravuga ati, “Mugore, uwo uvuga siimuuzi.”<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />Hashize umwanya muto undi muntu ashinja Peetero abikomeje caane ati, “Naawe uri umwe mu biigiishwa be.”</para>
  <para style="p" vid="LUK 22:58">Peetero ati, “Wa muntu we si ndi umwe muri bo.”<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />Nyuma y'umwanya muto, undi muntu aramushinja ati, “N'uyu baari kumwe kuko na we ari Umunyaagalileeya.”<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />Peetero aramusubiza ati, wa muntu we, ibyo simbiizi. Akibivuga muri ako kaanya yumva isaaki irabitse. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />Umwami Yesu arakebuka areeba Peetero, bombi bakubitana amaaso. Nuuko Peetero yibuka amagambo Yesu yari yamubwiye mbere, ati, “Uyu munsi, isaaki itaraabika, uraba umaze kunyihakana gatatu.” <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Nuuko Peetero aja hanze ararira caane.<verse eid="LUK 22:62" /></para>
  <para style="s1">Yesu Bamushinyagurira kandi Bamukubita</para>
  <para style="r">(<ref loc="MAT 26:67-68">Mat 26:67-68</ref>; <ref loc="MRK 14:65">Mar 14:65</ref>)</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Abagabo baari baafashe Yesu batangira kumushinyagurira no kumukubita. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Bamupfuka ku maaso, baramubaza bati, “Niiba uri umuhanuuzi tubwire ugukubise uwo ari we?” <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Bakomeza kumutuka, bamubwira n'ibindi byinshi bibabaje.<verse eid="LUK 22:65" /></para>
  <para style="s1">Yesu Ajanwa Imbere y'Urukiiko</para>
  <para style="r">(<ref loc="MAT 26:59">Mat 26:59</ref>; <ref loc="MRK 14:55-64">Mar 14:55-64</ref>; <ref loc="JHN 18:19-24">Yoh 18:19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Bukeeye abakuru babanyarukiko, abakuru b'abaheerezabitambo n'abiigiishamategeko, barateerana, bajaana Yesu mu rukiiko. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />Baramubwira bati, “Niiba uri Kristo, bitubwire!”</para>
  <para style="p" vid="LUK 22:67">Yesu arabasubiza ati, “Nuubwo naababwira, ntimwabyemera. <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />Naaho naababaza ntaaco mwansubiza. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Ariko uheereye noone, Umwana w'Umuntu azaaba yiicaye iburyo bw'Uhoraho Imaana Isumbabyose.”<verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />Boose bamubariza icaarimwe bati, “Erega nooneho wowe uri Umwana w'Imaana?”</para>
  <para style="p" vid="LUK 22:70">Arabasubiza ati, “Murabwivugiye ko ndi we!”<verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />Nuuko baravuga bati, “Mbese, hari ubundi buhamya twifuuza? Ko twumviise abyivugiye ubwe.”<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s1">Yesu Aregwa kwa Pilaato</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Mar 15:1-5</ref>; <ref loc="JHN 18:28-38">Yoh 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Nuuko iryo koraniro ry'abantu rijaana Yesu kwa Pilaato. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Bamurega bavuga bati, “Uyu mugabo agomeesha abantu ababuza gutanga umusoro w'Umwami. Yiyita Kristo, umwami.”<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />Pilaato abaza Yesu ati, “Uri umwami w'Abayuuda?”</para>
  <para style="p" vid="LUK 23:3">Yesu aramusubiza ati, “Urabyivugiye.”<verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />Maze Pilaato abwira abakuru b'abaheerezabitambo n'abo bantu boose ati, “Nta caaha muboonyeho.”<verse eid="LUK 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 23:5" />Bakomeza kumurega bavuga bati, “Yagomeesheje abantu n'inyigiisho ze atangiriye i Galileeya n'i Yudeeya hoose noone dore ageze n'ino i Yerusaalemu.”<verse eid="LUK 23:5" /></para>
  <para style="s1">Pilaato Yoohereza Yesu kwa Herodi</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />Pilaato abyumviise atyo, ababaza neeza niiba Yesu ari Umunyegalileeya. <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Amenye ko ari Umunyegalileeya, amwoherereza kwa Herodi kuko ari we wari umutegetsi w'aho kandi ico gihe akaba yari i Yerusaalemu.<verse eid="LUK 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8" />Herodi aboonye Yesu, biramuneezeeza kuko yahoraga yifuuza kumubona ku bw'ibitangaaza yamwumvagaho. Kandi yifuuzaga kubona Yesu akora igitangaaza. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Nuuko Herodi amubaza ibibazo byinshi ariko Yesu ntiyagira ico amusubiza. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Abakuru b'abaheerezabitambo n'abiigiishamategeko baari aho, bakomeza kumurega bamushinja caane. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Nyuma y'aho Herodi hamwe n'abasirikare be, bamushinyagurira bamuseka, kandi bamwambika igishuura ciiza bamwoherereza Pilaato. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Kuva uwo munsi, Herodi na Pilaato baruuzura baba inshuti, kandi mbere baari basanzwe batumviikana.<verse eid="LUK 23:12" /></para>
  <para style="s1">Yesu Aciirwa Urubanza rwo Gupfa</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat 27:15-26</ref>; <ref loc="MRK 15:6-15">Mar 15:6-15</ref>; <ref loc="JHN 18:39-19:16">Yoh 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Maze Pilaato ahamagaza abakuru b'abaheerezabitambo n'abategetsi, hamwe n'abo bantu boose <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />arababwira ati, “Mwanzaniye uyu mugabo muvuga ko agomeesha abantu ariko noone mboonye ko ari ntaaco yakoze mu byo mumurega <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />ndetse na Herodi na we ntaaco yamuboonyeho, ni co gitumye yongeye kumutwoherereza. Noone nta caaha yakoze gikwiriye kumwiciisha, <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />ahuubwo ndategeka ko akubitwa ibibooko maze murekure.” <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />(Ibi yabivuze kuko byari ngombwa ko ababohoorera imbohe imwe mu minsi mikuru.)<note caller="+" style="f"><char style="fr" closed="false">23:17 </char><char style="ft" closed="false">Mu byanditswe bimwe ntiharimo uyu murongo</char></note><verse eid="LUK 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />Boose basakuriza icaarimwe bati, “Uwo mwice, uturekurire Baraba.” <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Uwo Baraba yari yarashizwe mu gihome kubeera ubwicanyi no guteeza urugomo mu tawuni y'i Yerusaalemu.<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />Pilaato ashaatse kurekura Yesu, yongera kubasubiriramo ayo magambo. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />Ariko boose barushaho gusakuza bati, “Naabambwe! Naabambwe!”<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />Pilaato ababaza ubwa gatatu ati, “Kuki? Yakoze caaha ki? Nta mpamvu muboonyeho yo kumwiciisha. Noone ndategeka ko bamukubita ibibooko murekure.”<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />Ariko barushaho kuvugana ubukana basakuza, bamuhata kubamba Yesu maze Pilaato urwo rusaku ruramuganza. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Nuuko Pilaato aramubaha baja kumubamba nk'uko baabishaakaga. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Maze arekura Baraba wari mu gihome kubeera urugomo n'ubwicanyi nk'uko baari baabishaatse, abaha Yesu ngo bamugenze uko bashaaka.<verse eid="LUK 23:25" /></para>
  <para style="s1">Babamba Yesu</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat 27:32-44</ref>; <ref loc="MRK 15:21-32">Mar 15:21-32</ref>; <ref loc="JHN 19:17-27">Yoh 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Maze Yesu baramujaana, bakigenda bafata umugabo w'Umunyakureeni witwaga Simooni wavaga mu caaro, bamwikoreza umusaraba wa Yesu. Bamuhata kuwikorera ngo akurikire Yesu. <verse eid="LUK 23:26" /><verse number="27" style="v" sid="LUK 23:27" />Abantu benshi baakurikira Yesu baarimo n'abagore baamuririraga baborooga. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Maze arakebuka arababwira ati, “Bagore b'i Yerusaalemu, mwindirira ahuubwo mwiririre n'abaana baanyu <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />kuko igihe kizaaza bazaavuga bati, ‘Hahiirwa ingumba n'inda zitaabyaye n'amabeere ataaronkeje!’ <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" /><note caller="-" style="x"><char style="xo" closed="false">23:30 </char><char style="xt" closed="false"><ref loc="REV 6:16">Ibya 6:16</ref>.</char></note>Ubwo ni bwo bazaabwira ibirunga bati, ‘Nimuturidukire’ bakabwira n'imisozi bati, ‘Nimudutwikiire!’<verse eid="LUK 23:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="LUK 23:31" />Niiba bagenza batya igiti kibisi, igiti cumye co bazaakigenza bate?”<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Nuuko bamujaana n'inkozi z'ibibi ebyiri ngo baziicane na we. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Bageze ahiitwa Nyabihanga, baramubamba na za nkozi z'ibibi barazibamba. Imwe ibumoso bwe, indi iburyo. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />Maze Yesu aravuga ati, “Daata bababarire kuko bataazi ico bakora.” Abasirikare bagabana imyenda ya Yesu bakoreesheje ubufindo.<verse eid="LUK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35" />Abantu barashungeera, maze abatware baramushinyagurira bati, “Yakijije abandi, ngaaho niyiikize ubwe niiba ari we Kristo intoore y'Imaana.”<verse eid="LUK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36" />Abasirikare na bo baramukwena, maze bamuuzanira divaayi ishaariira <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />baravuga bati, “Niiba uri umwami w'Abayuuda ikize.”<verse eid="LUK 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38" />Nuuko heejuru ku musaraba wa Yesu, bashiraho icaapa canditsweho ngo: “Uyu ni Umwami w'Abayuuda.”<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />Umwe mu nkozi z'ibibi zaari zibambanywe na we, iramutuka iti, “Mbese si uri Kristo? Ngaaho ikize naatwe udukize.”<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />Ariko indi nkozi y'ibibi irayicaaha iti, “Wowe ntiwaatiinya Imaana! Ntuubona ko twahaawe igihano gisa? <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Dore twebwe turaryora ibibi twakoze, ariko uyu we ntaakibi yakoze.”<verse eid="LUK 23:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42" />Irongera iravuga iti, “Yesu, uraanyibuke ugeze mu Bwami bwawe.”<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />Yesu arayisubiza ati, “Ndakubwira ukuri, yuuko uyu munsi turi bubaane muri Paradizo.”<verse eid="LUK 23:43" /></para>
  <para style="s1">Urupfu rwa Yesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27:45-56</ref>; <ref loc="MRK 15:33-41">Mar 15:33-41</ref>; <ref loc="JHN 19:28-30">Yoh 19:28-30</ref>)</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />Nko ku saaha itandatu z'amanywa, umwijima ukwira igihugu coose ugeza ku saaha ya cenda. <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />Umuco w'izuuba uvaho, maze umwenda wari ukingirije aheera ho mu Nzu y'Imaana utandukamo kabiri. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />Nuuko Yesu aravuga ati, “Daata nshize ubugingo bwanje mu maboko yaawe.” Amaze kuvuga atyo, umwuka urahera.<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />Nuuko umutware w'abasirikare w'Umunyerooma aboonye ibibaaye, asingiza Imaana. Aravuga ati, “Koko uyu yari umuziranenge.” <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />Abantu baari bashungeereye na bo baboonye ibibaaye, buuzura umubabaro maze baragenda. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" /><note caller="-" style="x"><char style="xo" closed="false">23:49 </char><char style="xt" closed="false"><ref loc="LUK 8:2">Luk 8:2</ref>,<ref loc="LUK 8:3">3</ref>.</char></note>Ariko abaari bamuuzi boose hamwe n'abagore baari bamukurikiye kuva i Galileeya bo bahagarara ahiitaaruuye bareeba ibyo byose.<verse eid="LUK 23:49" /></para>
  <para style="s1">Yesu Ahambwa</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27:57-61</ref>; <ref loc="MRK 15:42-47">Mar 15:42-47</ref>; <ref loc="JHN 19:38-42">Yoh 19:38-42</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />Haariho umugabo witwaga Yozefu wo mu gihugu c'i Yudeeya mu tawuni yitwa Arimateya. Yari umunyangeso nziiza kandi intungaane. Yari umwe muri bakuru b'urukiiko rw'Abayuuda. <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />Yari ategereje kuuza k'Ubwami bw'Imaana. Ariko we ntaabwo yari yareemeranyije n'abandi bakuru b'urukiiko mu migambi n'ibikorwa byabo. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />Maze aja kwa Pilaato kumusaba umurambo wa Yesu. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Nuuko awukuura ku musaraba, bawuzinga mu mwenda mwiza w'igiciiro. Awujaana kuwuhamba mu mva nsha itaraahambwamo yari yaracukuwe mu rutare. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Ibi byabaaye bugoroobye kandi ari co gihe co kwiteguurira i Isaabato kuko yari haafi gutangira.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />Nuuko abagore baari bavanye na Yesu i Galileeya, bakurikira Yozefu babona imva amuhambyemo n'uburyo ahambwemo. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />Basubira mu rugo guteeguura imibavu n'ibindi bihuumura neeza. Nuuko ku Saabato, bararuhuuka nk'uko itegeko ribisaba.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s1">Izuuka rya Yesu</para>
  <para style="r">(<ref loc="MAT 28:1-10">Mat 28:1-10</ref>; <ref loc="MRK 16:1-8">Mar 16:1-8</ref>; <ref loc="JHN 20:1-10">Yoh 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Ku cumweru karekare mu gitondo ari wo munsi ukurikira Isaabato, ba bagore baja ku mva bajaanye bya bihuumura neeza baari baateguuye. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Babona ibuye rihirikiwe iruhande rw'umwinjiriro w'imva, <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />binjiramo ariko ntibaasangamo umurambo wa Yesu. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Bagihagaze aho buumiwe, ako kaanya haboneka abagabo babiri bambaye imyenda irabagirana. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />Abo bagore baratiinya maze buunika imitwe. Abo bagabo barababaza bati, “Ni iki gitumye mushaakira umuzima mu baapfuuye? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" /><note caller="-" style="x"><char style="xo" closed="false">24:6 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat 16:21</ref>; <ref loc="MAT 17:22">17:22</ref>,<ref loc="MAT 17:23">23</ref>; <ref loc="MAT 20:18">20:18</ref>,<ref loc="MAT 20:19">19</ref>; <ref loc="MRK 8:31">Mar 8:31</ref>; <ref loc="MRK 9:31">9:31</ref>; <ref loc="MRK 10:33">10:33</ref>,<ref loc="MRK 10:34">34</ref>; <ref loc="LUK 9:22">Luk 9:22</ref>; <ref loc="LUK 18:31-33">18:31-33</ref>.</char></note>Ntaawe uri hano ahuubwo yazuutse. Mwibuke ibyo yavuganye na mwe akiri i Galileeya ati, <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />‘Umwana w'Umuntu akwiriye kugabizwa mu maboko y'abanyabyaha, akabambwa kandi ku munsi wa gatatu akazuuka’.” <verse eid="LUK 24:7" /><verse number="8" style="v" sid="LUK 24:8" />Nuuko na bo biibuka amagambo ye.<verse eid="LUK 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9" />Bava ku mva basubirayo. Ibyo byose babiteekerereza i ntumwa cumi n'imwe n'abandi biigiishwa boose. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Abo bagore ni Mariya Magadaleena na Yowana, na Mariya nyina wa Yaakobo, n'abandi bagore baari hamwe na bo, babwira intumwa ibyo baaboonye. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Ariko ayo magambo ababeera nk'impuuha ntibaabyemera. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Maze Peetero arabaduka yiruka aja ku mva. Agezeho, aruunama arungurukamo, abona imyenda y'umweru iri yoonyine. Asubirayo atangaazwa n'ibyabaaye.<verse eid="LUK 24:12" /></para>
  <para style="s1">Yesu Abonekera Abagabo Babiri Baajaga Emawuusi</para>
  <para style="r">(<ref loc="MRK 16:12-13">Mar 16:12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Nuuko uwo munsi babiri mu bayoboke ba Yesu baajaga ahiitwa Emawuusi. Kuva i Yerusaalemu kugerayo haari nka kilomita icumi. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />Baagaaniiraga ku byari byabaaye byose. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Bakigaaniira kandi bakibazanya, Yesu arabeegeera ajaana na bo, <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />ariko ntibaamenya uwo ari we.<verse eid="LUK 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17" />Arababaza ati, “Muragenda mubazanya ibiki?”</para>
  <para style="p" vid="LUK 24:17">Maze bahagarara bagaragaje ishavu. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Umwe witwaga Kilewopaasi aramusubiza ati, “Ni wowe mushitsi wenyine muri Yerusaalemu utaazi ibyahabaaye muri iyi minsi?”<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />Arababaza ati, “Ni ibiki?”</para>
  <para style="p" vid="LUK 24:19">Baramusubiza bati, “Ni ibyerekeye Yesu w'i Nazaareeti, wari umuhanuuzi ukomeye mu byo yavugaga n'ibyo yakoraga imbere y'Imaana n'imbere y'abantu boose. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />Ariko noone abakuru b'abaheerezabitambo n'abatware baacu, baaramutanze ngo aciirwe urubanza rwo gupfa maze baramubamba. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Kandi ni we twiringiraga ko azaacungura Abiisirayeli. Uretse ibyo, dore uyu munsi ni uwa gatatu uheereye aho ibyo bibeereye. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Ariko abagore baadutangaaje, kuko baazindutse kare baja ku mva <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />ntibaasangamo umurambo we nuuko batubwira ko baabonekewe n'abaamalayika, bakababwira ko ari muzima. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Kandi bamwe mu baari kumwe naatwe baagiiye ku mva, basanga ari nk'uko abo bagore baari baatubwiye, ariko we ntibaamubona.”<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />Arababwira ati, “Mwa bapfaapfa mwe, mutinda kwemera ibyo abahanuuzi baavuze byose. <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Noone se Kristo ntiyari akwiriye kubabazwa atyo akabona kwinjira mu ikuzo rye?” <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Atangirira kuri Moose no ku bahanuuzi boose, abasobaanurira ibyanditswe byose kuri we.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Bageze bugufi y'umwanya baajagamo wiitwa Emawuusi, asa nk'ushaaka gukomeza urugendo. <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />Baramwinginga bati, “Reka twibaanire kuko bugiiye kwira kandi igihe kiragiiye.” Nuuko arinjira aguma na bo.<verse eid="LUK 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 24:30" />Amaze kwicara, afata umugaati ashiima Imaana, arawumanyagura arawubaha. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Amaaso yaabo arahumuuka, baramumenya, maze ako kaanya arabura ntibongera kumubona. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Baravugana bati, “Yeewe, ntiwiibuka ukuntu imitima yaacu yari ineezeerewe, ubwo yavuganaga naatwe turi mu nzira adusobaanurira ibyanditswe!”<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />Uwo mwanya barahaguruka basubira i Yerusaalemu, basanga abo cumi n'umwe bateeranye hamwe n'abandi. <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />Bumva bavuga bati, “Ni ukuri Umwami Yesu yazuutse, ndetse yabonekeye Simooni.” <verse eid="LUK 24:34" /><verse number="35" style="v" sid="LUK 24:35" />Nuuko ba bandi babiri na bo babateekerereza ibyabeereye mu nzira, n'ukuntu baamumenyeshejwe n'uko yamanyaguye umugaati.<verse eid="LUK 24:35" /></para>
  <para style="s1">Yesu Abonekera Abiigiishwa be</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28:16-20</ref>; <ref loc="MRK 16:14-18">Mar 16:14-18</ref>; <ref loc="JHN 20:19-23">Yoh 20:19-23</ref>; <ref loc="ACT 1:6-8">Iby 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Bakivuga ibyo, Yesu ahagarara hagati muri bo arababwira ati, “Amahoro abe muri mwe.”<verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />Maze bariikanga, bagira ubwoba bwinshi ngo ahaari ni umuzimu baboonye. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Arababwira ati, “Ikibahagaritse imitima ni iki, kandi ni iki gitumye mushidiikanya? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Nimureebe ibiganza byanje n'ibirenge byanje, mumenye ko ari nje ubwanje. Ndetse nimunkoreho mureebe, kuko umuzimu utagira umubiri n'amagufa nk'ibyo mundeebana.”<verse eid="LUK 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40" />Amaze kuvuga ibyo, abeereka ibiganza bye n'ibirenge bye. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />Nuuko ibineezaneeza bikibabujije kubyemera kandi bagitangaara, arababaza ati, “Hari ico kurya mufite hano?” <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Bamuha igice c'isamaaki yookeje, <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />arayaakiira ayiriira imbere yaabo.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />Maze arababwira ati, “Aya ni yo magambo nababwiraga nkiri kumwe namwe, yuuko ibyanditswe kuri nje byose mu mategeko ya Moose, no mu byahanuuwe no muri Zaaburi bikwiriye gusohora.”<verse eid="LUK 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45" />Maze abaha ubushobozi bwo gusobaanukirwa ibyanditswe, <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />ati, “Ni ko byanditswe ko Kristo akwiriye kubabazwa no kuzuuka ku munsi wa gatatu, <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />kandi ko kwihana no kubabarirwa ibyaha bikwiriye kubwirwa amahanga yoose mu izina rye, uheereye i Yerusaalemu. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Ni mwe bahamya b'ibyo. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" /><note caller="-" style="x"><char style="xo" closed="false">24:49 </char><char style="xt" closed="false"><ref loc="ACT 1:4">Iby 1:4</ref>.</char></note>Kandi dore ngiiye kubooherereza uwo Daata yaseezeranyije, ariko mugume i Yerusaalemu kugeza ubwo muzaahabwa imbaraga zivuuye mu ijuru.”<verse eid="LUK 24:49" /></para>
  <para style="s1">Yesu Ajanwa mu Ijuru</para>
  <para style="r">(<ref loc="MRK 16:19-20">Mar 16:19-20</ref>; <ref loc="ACT 1:9-11">Iby 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:50 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:9-11">Iby 1:9-11</ref>.</char>
    </note>Abavaana i Yerusaalemu, abageza i Beetaniya arambuurira amaboko heejuru abaha umugisha. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Akibaha umugisha atandukanywa na bo, ajanwa mu ijuru. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Na bo baramuramya, basubira i Yerusaalemu buuzuye umuneezeero mwinshi, <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />baguma mu Nzu y'Imaana iteeka bashiima Imaana.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>