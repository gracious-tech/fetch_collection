<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Rufumbira New Testament</book>
  <para style="h">IBYAHISHUUWE</para>
  <para style="toc3">Ibya</para>
  <para style="toc2">IBYAHISHUUWE</para>
  <para style="toc1">IBYAHISHUURIWE Yohaana</para>
  <para style="mt1">IBYAHISHUURIWE</para>
  <para style="mt2">YOHAANA</para>
  <para style="imt">INYANZURO</para>
  <para style="im">
    <char style="bk">Ibyahishuuriwe Yohaana</char> byanditswe mu gihe Abakristo baatootezwaga bazira ukwemera Yesu Kristo nk'Umwami. Ikigendererwa gikuru c'umwanditsi w'iki gitabo ni ukugira ngo abagisoma bagire ibyiringiro n'umuhimbo, kandi no kubakangurira kuguma ari abiiringirwa mu bihe by'umubabaro no gutootezwa.</para>
  <para style="ip">Igice kinini c'iki gitabo kigizwe n'urutonde rw'ibyahishuuwe no kwerekwa bigaragarira mu rurimi rw'amarenga rwo Abakristo b'ico gihe baagombaga gusobaanukirwa, ariko bikaguma ari urujijo ku bandi boose. Ku byerekeye imitwe y'uruheererekane, imitwe y'iki gitabo iguma gusubirwamo mu buryo butandukanye mu nzozi zikurikiranye. Nuubwo hariho ibiteekerezo bitandukanye bihereereye insobaanura y'iki gitabo, umutwe mukuru uragaragara kandi ni uyu: muri Nyagasani Yesu, Imaana izaatsinda abanzi baayo burundu, ubariyemo na Sataani kandi igororere abantu baayo bayiringira imigisha y'ijuru risha n'iy'isi nsha, igihe uru rugamba ruzaaba rurangiye.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro <char style="ior"><ref loc="REV 1:1-8">1:1-8</ref> </char></para>
  <para style="io1">Kubonekerwa kw'ibanze n'inzandiko zandikiwe amatoorero arindwi <char style="ior"><ref loc="REV 1:9-3:22">1:9—3:22</ref></char></para>
  <para style="io1">Umuzingo ufite ibimenyeetso birindwi <char style="ior"><ref loc="REV 4:1-8:1">4:1—8:1</ref></char></para>
  <para style="io1">Impanda ndwi <char style="ior"><ref loc="REV 8:2-11:19">8:2—11:19</ref> </char></para>
  <para style="io1">Ikiyoka n'inyamaaswa ebyiri <char style="ior"><ref loc="REV 12:1-13:18">12:1—13:18</ref></char></para>
  <para style="io1">Kubonekerwa gutandukanye <char style="ior"><ref loc="REV 14:1-15:8">14:1—15:8</ref> </char></para>
  <para style="io1">Amabakure arindwi, n'uburaakari bw'Imaana <char style="ior"><ref loc="REV 16:1-21">16:1-21</ref></char></para>
  <para style="io1">Kurimburwa kwa Babilooni no gutsindwa kw'ikinyamaaswa, abahanuuzi b'ibinyoma hamwe na Sataani. <char style="ior"><ref loc="REV 17:1-20:10">17:1—20:10</ref></char></para>
  <para style="io1">Urubanza rw'imperuuka <char style="ior"><ref loc="REV 20:11-15">20:11-15</ref></char></para>
  <para style="io1">Ijuru risha, Isi nsha, Yerusaalemu nsha <char style="ior"><ref loc="REV 21:1-22:5">21:1—22:5</ref></char></para>
  <para style="io1">Umusoozo <char style="ior"><ref loc="REV 22:6-21">22:6-21</ref></char></para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="s1">Inyanzuro</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />Iki gitabo ni ibyahishuuwe na Yesu Kristo, byo Imaana yamuhaaye kugira ngo yeereke abagaragu baayo ibigomba kubaho vuba. Ibi Yesu yabimenyeesheje umugaragu we Yohaana amutumyeho malayika we, <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />kandi Yohaana ahamya ko ibyo yaboonye byose ari ijambo ry'Imaana n'ubuhamya bwa Yesu Kristo. <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />Hahiirwa umuntu usomera amagambo y'ubu buhanuuzi mu ruhame rw'abeemera, kandi hahiirwa n'abumva bagakurikiza ibyanditswemo, kuko igihe ceegeereje.<verse eid="REV 1:3" /></para>
  <para style="s1">Indamutso ku Matoorero Arindwi</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:4 </char>
      <char style="xt" closed="false">
        <ref loc="REV 4:5">Ibya 4:5</ref>.</char>
    </note>Njeewe Yohaana, ndabandikiye mwebwe abo mu matoorero arindwi yo muri Asiya.</para>
  <para style="p" vid="REV 1:4">Nimugire ubuntu n'amahoro bituruka ku Maana iriho, Imaana yahozeho, Imaana izaahoraho, kandi bituruka ku myuka irindwi iri imbere y'intebe ye y'Ubwami, <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />no kuri Yesu Kristo, umuhamya wiringirwa, wabanjirije abandi kuzuuka, kandi akaba umutware w'abaami bo ku isi.</para>
  <para style="p" vid="REV 1:5">Koko Kristo aradukunda kandi yadukijije ibyaha byacu igihe amena amaraso ye. <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" /><note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="REV 5:10">Ibya 5:10</ref>.</char></note>Yaduhaaye gutegeka nk'abaami kandi aduha guheereza Imaana Se nk'abaheerezabitambo. Icuubahiro n'ubutware bibe ibye iteeka ryose, Amiina.<verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:7 a </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:30">Mat 24:30</ref>; <ref loc="MRK 13:26">Mar 13:26</ref>; <ref loc="LUK 21:27">Luk 21:27</ref>; <ref loc="1TH 4:17">1Tes 4:17</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:34">Yoh 19:34</ref>,<ref loc="JHN 19:37">37</ref>; </char>
      <char style="xo" closed="false">c </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:30">Mat 24:30</ref>.</char>
    </note>Dore aziye mu bicu! Buri muntu azaamubona, ndetse n'abaamuteeye icumu agapfa bazaamubona. Abantu boose bo ku isi bazaacura umuboroogo ku bwe. Koko ni ko bizaaba. Amiina!<verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:8 </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:13">Ibya 22:13</ref>.</char>
    </note>Nyagasani Imaana Ishoborabyose, iriho, iyahozeho kandi izaahoraho, iravuga iti, “Ni nje ntangiriro nkaba n'iheerezo.”<verse eid="REV 1:8" /></para>
  <para style="s1">Yesu Abonekera Yohaana</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />Njeewe Yohaana, mwene so musangiye gutootezwa n'ubwami no kwihangaana muri Yesu, nashizwe mu kirwa ciitwa Patimo kubwo kwamamaza ijambo ry'Imaana n'ubuhamya bwa Yesu. <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />Ku munsi wa Nyagasani ntwarwa n'Umwuka, maze numva ijwi rirenga nk'impanda inyuma yanje <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />rivuga riti, “Ibyo ubona ubyandike mu gitabo maze ucooherereze amatoorero yo muri aya ma tawuni makuru: Efeeso, Simuruna, Perigamo, Tuwatira, Saridi, Filadelifiya, na Lawodikeya.”<verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />Maze ndahindukira ngo ndeebe uwamvugiishaga, nuuko mbona ibitereko by'amataara birindwi by'izaahabu, <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />kandi hagati y'ibyo bitereko by'amataara mpabona usa n'Umwana w'Umuntu, yambaye ikanzu ndende, umushumi wa zaahabu uzengurutse igituuza ce. <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />Umusatsi we n'umutwe we weereranaga nk'ubwoya bw'umweru, cangwa nk'urubura, amaaso ye yari nk'ibirimi by'umuriro, <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />ibirenge bye byarabagiranaga nk'icuuma gikozwe mu muringa utungaanyirijwe mu ruganda, naho ijwi rye ryari rimeze nk'iry'amaazi menshi asuuma. <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />Mu kuboko kwe kw'iburyo yari afashe inyenyeeri ndwi, naho mu kanwa ke hagasohoka inkoota ityaye impande zombi. Mu maaso he haasaga nk'izuuba ryo kumanywa y'ihangu. <verse eid="REV 1:16" /><verse number="17" style="v" sid="REV 1:17" /><note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="REV 2:8">Ibya 2:8</ref>; <ref loc="REV 22:13">22:13</ref>.</char></note>Ko namuboonye, niikubita imbere ye nk'upfuuye. Ariko andambikaho ukuboko kwe kw'iburyo, avuga ati, “Wiitiinya! Ninje ntangiriro nkaba n'iheerezo, <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />kandi ndi muzima. Nari narapfuuye, noone dore ndi muzima kugeza iteeka ryose. Mfite ububaasha bwo kuzuura abaapfuuye bakongera kubaho kandi mfite n'ibishumuruzo by'ikuzimu. <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />Nuuko reero, andika ibyo uboonye, ibiriho ubu, n'ibigiiye kubaho haanyuma. <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />Naho ibyerekeye amayobera y'inyenyeeri ndwi zo waboonye mu kiganza canje c'iburyo, hamwe n'ibitereko by'amataara birindwi by'izaahabu, dore ico bisobaanura: inyenyeeri ndwi ni abaamalayika b'amatoorero arindwi, kandi ibitereko by'amataara birindwi ni amatoorero arindwi.”<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s1">Ubutumwa Bwandikiwe Itoorero rya Efeeso</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />Arambwira ati, “Andikira malayika w'itoorero rya Efeeso uti,</para>
  <para style="p" vid="REV 2:1">‘Ubu ni bwo butumwa buvuuye kuri uwo ufashe inyenyeeri ndwi mu kiganza ce c'iburyo, akagendera hagati y'ibitereko by'amataara birindwi by'izaahabu. <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />Nzi imirimo yaawe, nzi n'ukuntu uvunika n'uko wiihangaana. Nzi kandi ko udashobora kwihangaanira inkozi z'ibibi. Wagenzuuye abo biiyita intumwa kandi batari zo, maze usanga ko babeesha. <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />Nzi kandi ko wiihangaanye, ukababazwa ku bw'izina ryanje, kandi ntiwaciika intege. <verse eid="REV 2:3" /><verse number="4" style="v" sid="REV 2:4" />Ariko mfite ico nkunenga: ni uko waretse urukundo wagiraga mbere ukiinyemera. <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />Nuuko reero, ibuka aho wakuurije kugwa maze wiihane, kandi wongere gukora ibikorwa nk'ibya mbere. Bitabaaye bityo ngo wiihane, ngiiye kuuza aho uri maze nkuure igitereko c'itaara ryawe mu mwanya waaco. <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />Nyamara hari n'ico ngushiimira: ni uko wanga ibikorwa by'Abanikolayiti, nk'uko nanje mbyanga.<verse eid="REV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:7 </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:2">Ibya 22:2</ref>.</char>
    </note>Ufite amatwi niyumve ibyo Umwuka abwira amatoorero.</para>
  <para style="p" vid="REV 2:7">Uzaatsinda weese, nzamwemerera kurya ku mbuto z'igiti c'ubugingo kiri muri paradizo y'Imaana’ ”<verse eid="REV 2:7" /></para>
  <para style="s1">Ubutumwa Bwandikiwe Itoorero rya Simuruna</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:8 </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:17">Ibya 1:17</ref>; <ref loc="REV 22:13">22:13</ref>.</char>
    </note>Andikira malayika w'itoorero rya Simuruna uti,</para>
  <para style="p" vid="REV 2:8">“Ubu ni bwo butumwa buvuuye kuri wa wundi w'intangiriro akaba n'iherezo, uwari warapfuuye noone akaba ari muzima. <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />Nzi ingoorane zaawe n'ubukene bwawe, nuubwo uri umukungu mu mutima. Nzi n'ukuntu uvugwa naabi n'abiiyita Abayuuda kandi batari bo, ahuubwo ikoraniro ryabo ryategekwaga na Sataani. <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />Ntuutiinye ibyo ugiiye kubabazwa. Dore Sataani agiiye kujugunya bamwe muri mwe mu gihome kugira ngo mugeragezwe, kandi muzaababazwa kumara iminsi cumi. Uzaabe umwiringirwa kugeza ku gupfa, maze nanje nzaaguha ikamba ry'ubugingo.<verse eid="REV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:11 </char>
      <char style="xt" closed="false">
        <ref loc="REV 20:14">Ibya 20:14</ref>; <ref loc="REV 21:8">21:8</ref>.</char>
    </note>Ufite amatwi weese niyumve ibyo Umwuka abwira amatoorero.</para>
  <para style="p" vid="REV 2:11">Uzaatsinda weese ntaaziigera ababazwa n'urupfu rwa kabiri.”<verse eid="REV 2:11" /></para>
  <para style="s1">Ubutumwa Bwandikiwe Itoorero rya Perigamo</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />Andikira malayika w'itoorero rya Perigamo uti,</para>
  <para style="p" vid="REV 2:12">“Ubu ni bwo butumwa buvuuye kuri wa wundi ufashe inkoota ityaye impande zombi. <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />Aho utuuye ndahaazi, ni aho intebe y'ubwami bwa Sataani iri. Ariko kandi wakomeje izina ryanje, maze ntiwiihakana ko unyizeera, ndetse no mu gihe ca Antipasi umuhamya wanje udahemuka wiiciwe iwaanyu, aho Sataani atuuye. <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" />Ariko reero mfite bike nkunenga: hari abantu bamwe muri mwe bakurikiza inyigiisho ya Balaamu, wa wundi wiigiishije Balaki kuyobya Abiisirayeli bakagwa mu caaha, barya inyama zaaterekeewe ibigirwamaana no kwishira mu bikorwa by'ubusambanyi. <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />Naawe ufite abantu bakurikiza inyigiisho z'Abanikolayiti. <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />Noone reero wiihane kuko bitabaaye bityo, ngiiye kuuza vuba maze mbarwanye n'inkoota iva mu kanwa kanje.<verse eid="REV 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:17 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:48-50">Yoh 6:48-50</ref>.</char>
    </note>Niiba reero ufite amatwi, umva ico Umwuka abwira amatoorero!</para>
  <para style="p" vid="REV 2:17">Uzaatsinda weese, nzaamuha ku manu yahishwe, kandi muhe n'ibuye ryera, ryanditsweho izina risha ritaazwi n'umuntu weese keretse uwo uzaaba arihaawe.”<verse eid="REV 2:17" /></para>
  <para style="s1">Ubutumwa Bwandikiwe Itoorero rya Tuwatira</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />Andikira malayika w'itoorero rya Tuwatira uti,</para>
  <para style="p" vid="REV 2:18">“Ubu ni bwo butumwa bw'Umwana w'Imaana, ufite amaaso ameze nk'ibirimi by'umuriro, kandi ufite ibirenge bisa nk'icuuma gikozwe mu muringa urabirana nyuma yo gutunganyirizwa mu ruganda. <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />Nzi ibikorwa byawe. Nzi urukundo rwawe, ukwizeera kwawe, ubuheereza bwawe, n'ukwihangaana kwawe. Nzi yuuko imirimo ukora ubu isumba iyo wakoze mbere. <verse eid="REV 2:19" /><verse number="20" style="v" sid="REV 2:20" />Ariko ibi ni byo nkunenga: worohera uriiya mugore Yezebeeli wiiyita umuhanuuzikazi w'Imaana maze inyigiisho ze zikayobya abagaragu banje zibashoora mu bikorwa by'ubusambanyi no kurya ibyokurya byatuuwe ibigirwamaana. <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />Namuhaaye igihe co kwihana, ariko ntaashaaka kwihana ngo areke ubusambanyi bwe. <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />Dore ngiiye kumujugunya kugitanda c'uburibwe, kandi n'abamusambanya nzaabateera amagoorwa akaze, baramutse batiihannye ibibi baakoranye na we. <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />Kandi abayoboke be nzaabiica, maze amatoorero yoose amenye ko ari nje umenya ibiteekerezo hamwe n'ibyifuuzo bya buri muntu. Nziituura buri umwe muri mwe nkurikije ibyo yakoze.<verse eid="REV 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24" />Ariko abandi mwese b'i Tuwatira, mutiigeze kuyoboka izi nyigiisho mbi, kandi ntimwige ibyo abo bandi biita ‘amabanga ya Sataani’, sinzaabagerekaho undi mutwaro. <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />Mukomeze ico mufite kugeza aho nzaazira. <verse eid="REV 2:25" /><verse number="26" style="v" sid="REV 2:26" />Uzaatsinda weese agakomeza gukora imirimo yanje kugeza ku ndunduro, nzaamuha ububaasha bwo gutwara amahanga. <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" />Ayo mahanga azaayategekeesha agahato, nk'ujanjagura ibibindi by'ibumba. <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />Bazaabona ububaasha nk'ubwo nahaawe na Daata, kandi uzaatsinda, nzaamuha inyenyeeri yaaka mu gitondo.<verse eid="REV 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29" />Ufite amatwi weese niyumve ibyo Umwuka abwira amatoorero.”<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s1">Ubutumwa Bwandikiwe Itoorero rya Saridi</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />“Andikira malayika w'itoorero rya Saridi uti,</para>
  <para style="p" vid="REV 3:1">‘Ubu nibwo butumwa buvuuye kuri uwo ufite imyuka ndwi y'Imaana n'inyenyeeri ndwi. Nzi imirimo ukora. Wiitwa ko uri muzima ariko warapfuuye. <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />Kanguka ukomeze ibyo ugifite bitaraapfa, kuko nasanze ibikorwa byawe imbere y'Imaana bidatungaanye. <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" /><note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="MAT 24:43">Mat 24:43</ref>,<ref loc="MAT 24:44">44</ref>; <ref loc="LUK 12:39">Luk 12:39</ref>,<ref loc="LUK 12:40">40</ref>; <ref loc="REV 16:15">Ibya 16:15</ref>.</char></note>Nuuko reero wiibuke ibyo wiigiishijwe n'ibyo wumviise, maze ubikurikize kandi wiihane. Naho niiba utabaaye maaso, nzaaza nk'umujuura, kandi ntuuzaamenya igihe nzaakugereraho. <verse eid="REV 3:3" /><verse number="4" style="v" sid="REV 3:4" />Icakora, uracaafite abantu bake i Saridi batanduje imyambaro yaabo. Bazaagendana nanje bambaye ibyera, kuko babikwiriye. <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" /><note caller="-" style="x"><char style="xo" closed="false">3:5 a </char><char style="xt" closed="false"><ref loc="REV 20:12">Ibya 20:12</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="MAT 10:32">Mat 10:32</ref>; <ref loc="LUK 12:8">Luk 12:8</ref>.</char></note>Abazaatsinda urugamba ni bo bazambikwa imyambaro yeera, kandi sinzaasangura amazina yaabo mu gitabo c'ubugingo. Nzaatangaaza amazina yaabo kumugaragaro imbere ya Daata hamwe n'imbere y'abaamalayika ko baari abayoboke banje.<verse eid="REV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6" />Ufite amatwi niyumve ico Umwuka abwira amatoorero.’ ”<verse eid="REV 3:6" /></para>
  <para style="s1">Ubutumwa bwandikiwe Itoorero rya Filadelifiya</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />“Andikira malayika w'itoorero rya Filadelifiya uti, ‘Aya ni yo magambo y'uweera kandi w'ukuri, ufite igishumuruzo c'inzu ya Dawudi, ukinguura ntihagire n'umwe ukinga, kandi ukinga ntihagire n'umwe ukinguura. <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />Nzi imirimo ukora. Dore nshize imbere yaawe umuryango ukinguuye, uwo hataagira n'umwe waashobora kuwukinga. Nzi neeza yuuko ufite imbaraga nke, ariko ukaba wararinze ijambo ryanje, kandi ntiwiihakane izina ryanje. <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />Dore nzaakwegurira abo bantu b'ikoraniro rya Sataani biiyita abaatooranyijwe n'Imaana kandi atari bo, ahuubwo ari ababeeshi. Dore ngiiye kubakuuzanira bapfukame imbere yaawe maze bamenye yuuko ngukunda. <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />Kuko wakurikije amabwiriza yanje yo kwihangaana, nanje nzaakurinda igihe co kugeragezwa kigiiye kuuza ku isi yoose, kugerageza abayituuye. <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" />Dore ngiiye kuuza bidatinze, ukomeze ico ufite kugira ngo hatagira ukwaka ikamba ryawe. <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" /><note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="REV 21:2">Ibya 21:2</ref>.</char></note>Abazaatsinda, nzaabagira inkingi mu Nzu y'Imaana yanje, kandi ntibaziigera bayivamo. Nzaabandikaho izina ry'Imaana yanje, n'izina ry'Ururembo rw'Imaana yanje, ari rwo Yerusaalemu nsha yamanutse mu ijuru iva ku Maana yanje, ndetse mbandikeho n'izina ryanje risha.<verse eid="REV 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13" />Ufite amatwi, niyumve ico Umwuka abwira amatoorero.’ ”<verse eid="REV 3:13" /></para>
  <para style="s1">Ubutumwa Bwandikiwe Itoorero rya Lawodikeya</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />“Andikira malayika w'itoorero rya Lawodikeya uti,</para>
  <para style="p" vid="REV 3:14">‘Aya ni amagambo ya Amiina, umudahemuka kandi umuhamya w'ukuri, akaba n'inkomooko y'ibyaremwe n'Imaana byose. <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />Nzi imirimo ukora, ntuukonje kandi ntuushuushe. Iyaaba niibura wari ukonje cangwa ushuushe! <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />Noone reero ubwo uri akazuyaazi, ukaba udakonje cangwa ngo ushuuhe, ngiiye kukuruka uve mu kanwa kanje. <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />Uravuga uti: Ndi umukire, nateeye imbere kandi ntaaco niifuuza. Ariko ntuumenye yuuko uri imbabare yo kubabarirwa, umukene, impumyi kandi ko wambaye ubusa. <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />Noone reero nkugiiriye inaama yo kunguraho izaahabu yayungurujwe n'umuriro kugira ngo ube umukire. Ungureho n'imyambaro yeera kugira ngo wambare maze uhishe ubwambure bwawe kugira ngo butareebeka. Kandi ugure n'umuti wo gusiiga ku maaso yaawe kugira ngo ureebe. <verse eid="REV 3:18" /><verse number="19" style="v" sid="REV 3:19" /><note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="HEB 12:6">Heb 12:6</ref>.</char></note>Njeewe abo nkunda ndabacaaha kandi nkabagiira inaama. Nuuko reero, nimugire umwete kandi mwihane. <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />Dore mpagaze ku muryango ndakomanga. Nihagira uwumva ijwi ryanje agakinguura uruugi, nzinjira maze dusangire. <verse eid="REV 3:20" /><verse number="21" style="v" sid="REV 3:21" />Kuri abo bazaatsinda, nzaabaha umwanya biicarane nanje ku ntebe yanje y'ubwami, nk'uko nanje natsinze nkaba niicaranye na Daata ku ntebe ye y'ubwami.<verse eid="REV 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22" />Ufite amatwi niyumve ico Umwuka abwira amatoorero.’ ”<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s1">Kuramya mu Ijuru</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />Nyuma yo kubona ibyo, nongera kubonekerwa maze mbona umuryango w'ijuru ukinguuye. Numva rya jwi nabanje kumva rivugana nanje rimeze nk'iry'impanda, rivuga riti, “Zaamuuka uze hano, maze nkwereke ibigomba kubaho haanyuma y'ibi.” <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />Muri ako kaanya ntwarwa n'umwuka, maze mbona intebe y'ubwami iteretswe mu ijuru, hari uyiicayeho. <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />Uwari uyiicayeho yasaga n'amabuye abangerana ya yasipi na sarudoni, kandi umukororombya usa n'ibuye ry'agaciiro rya simaragido wari wiitoorooye iyo ntebe. <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />Iyo ntebe yari yiitooroowe n'izindi ntebe makumyabiri n'enye, kandi zaari ziicaweho n'abakuru makumyabiri na bane, bambaye amakanzu yeera kandi ku mitwe yaabo bambaye amakamba y'izaahabu. <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" /><note caller="-" style="x"><char style="xo" closed="false">4:5 a </char><char style="xt" closed="false"><ref loc="REV 8:5">Ibya 8:5</ref>; <ref loc="REV 11:19">11:19</ref>; <ref loc="REV 16:18">16:18</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="REV 1:4">Ibya 1:4</ref>.</char></note>Kuri iyo ntebe y'ubwami haaturukagaho imirabyo, amajwi hamwe n'umuhindo w'inkuba, kandi imbere y'iyo ntebe y'ubwami haakaga amataara arindwi, ari yo myuka ndwi y'Imaana. <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />Imbere y'iyo ntebe y'ubwami hakaba ikintu gisa n'inyanja y'ikirahuri kibonerana.</para>
  <para style="p" vid="REV 4:6">Iyo ntebe yari yiitooroowe kandi ikiikijwe ku mpande zombi n'ibinyabuzima bine, byuzuyeho amaaso imbere n'inyuma. <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />Ikinyabuzima ca mbere caasaga nk'intare, ica kabiri gisa nk'ikimasa, ikinyabuzima ca gatatu caari gifite mu maaso hasa nk'ah'abantu, naho ica kane caareebekaga nk'igisiiga kiguruka. <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />Buri kinyabuzima muri ibyo uko ari bine, caari gifite amababa atandatu, kandi byuzuye amaaso impande zoose hamwe no munda. Kumanywa na nijoro, ntibyaruhuukaga kuririmba biti,</para>
  <para style="q1" vid="REV 4:8">“Uweera, uweera, uweera, ni Nyagasani Imaana Ishoborabyose,</para>
  <para style="q2" vid="REV 4:8">uwahozeho, uriho kandi uzaahoraho.”<verse eid="REV 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9" />Kandi buri uko ibyo binyabuzima byahaga ikuzo n'icuubahiro n'ishimwe uwari wiicaye ku ntebe y'ubwami, Uhoraho iteeka ryose, <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />ba bakuru makumyabiri na bane baapfukamaga imbere y'uwo wiicaye ku ntebe y'ubwami maze bakaramya Uhoraho iteeka ryose, bakajugunya haasi amakamba yaabo imbere ya ya ntebe, baririmba bati,<verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />“Nyagasani Maana yaacu,</para>
  <para style="q2" vid="REV 4:11">ukwiriye guhaabwa icuubahiro n'ikuzo n'ububaasha,</para>
  <para style="q1" vid="REV 4:11">kuko ni wowe waremye byose,</para>
  <para style="q2" vid="REV 4:11">kandi ku bw'ubushaake bwawe biraremwa maze bibaho.”<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s1">Umuzingo w'Igitabo n'Umwana w'Intaama</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />Nuuko mu kiganza c'uwiicaye ku ntebe y'ubwami, mbona umuzingo w'igitabo wanditswemo munda n'inyuma, ufungiishijwe ibimenyeetso<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Keera imizingo y'igitabo n'inzandiko yazingishwaga ibumba bakariteeraho isitampu iriho ikimenyeetso kugira ngo hatagira uwuzinguura atabigenewe.</char></note> birindwi. <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />Mbona malayika w'igihangage abaza mu ijwi rirenga ati, “Ni nde ukwiriye guca ibimenyeetso maze akabumbura uwo muzingo w'igitabo?” <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />Ariko ntihaagira n'umwe, yaaba uwo mu ijuru cangwa uwo ku isi cangwa uw'ikuzimu washoboye kubumbuura uwo muzingo cangwa ngo awureebemo. <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />Maze ndarira caane kuko hataabonetse ukwiriye kubumbuura uwo muzingo w'igitabo cangwa ngo awureebemo. <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />Nuuko umwe mu bakuru arambwira ati, “Reka kurira. Dore, Intare yo mu muryango wa Yuda, ukomooka kuri Dawudi atsinze urugamba, kugira ngo abumbuure uwo muzingo w'igitabo hamwe n'ibimenyeetso byawo birindwi.”<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />Nuuko mbona hagati ya ya ntebe y'ubwami n'ibinyabuzima bine no muri ba bakuru Umwana w'Intama ahagaze asa nk'uwabaazwe. Yari afite amahembe arindwi n'amaaso arindwi, ari yo myuka ndwi yo Imaana yoohereje mu isi yoose. <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />Nuuko Umwana w'Intaama araaza maze yaakiira wa muzingo w'igitabo caari mu kiganza c'iburyo c'uwari wiicaye ku ntebe y'ubwami. <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />Amaze kwakiira wa muzingo w'igitabo, bya binyabuzima bine na ba bakuru makumyabiri na bane bapfukama imbere y'Umwana w'Intaama, buri umwe afashe inanga n'amabakure ya zaahabu yuuzuyemo imibavu, ari yo masengeesho y'abeera. <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />Baririmba indirimbo nsha, bavuga bati,</para>
  <para style="q1" vid="REV 5:9">“Ni wowe ukwiriye kwakiira uwo muzingo w'igitabo</para>
  <para style="q2" vid="REV 5:9">kandi ukwiriye no kuvaanaho ibimenyeetso biwufunze,</para>
  <para style="q1" vid="REV 5:9">kuko waratambwe maze ku bw'amaraso yaawe ucungura abantu</para>
  <para style="q2" vid="REV 5:9">ubagarurira Imaana bavuuye muri buri muryango, buri rurimi, buri gihugu, no mu mahanga yoose, kandi<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:10 </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:6">Ibya 1:6</ref>.</char>
    </note>wabagize abantu b'ubwami bw'Imaana, ubagira abaheerezabitambo bo guheereza Imaana,</para>
  <para style="q2" vid="REV 5:10">kandi baziima ingoma maze bategeke isi.”<verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />Nuuko ndareeba maze numva ijwi ry'abaamalayika benshi biitoorooye ya ntebe hamwe na bya binyabuzima na ba bakuru, umubare waabo wari ibihumbi n'ubuhumbagiza. <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />Baaririmbaga mu majwi aranguruye bati,</para>
  <para style="q1" vid="REV 5:12">“Umwana w'Intaama watambwe ni we ukwiriye</para>
  <para style="q2" vid="REV 5:12">guhaabwa ububaasha, ubukire n'ubuhanga n'imbaraga</para>
  <para style="q2" vid="REV 5:12">n'icuubahiro n'ikuzo n'ibisingizo!”<verse eid="REV 5:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="REV 5:13" />Maze numva buri kiremwa coose co mu ijuru no mu isi, n'ikuzimu no mu nyanja n'ibiyirimo byose biririmba biti,</para>
  <para style="q1" vid="REV 5:13">“Ishimwe n'icuubahiro n'ikuzo n'ubutware</para>
  <para style="q2" vid="REV 5:13">bibe iby'uwiicaye ku ntebe y'ubwami n'Umwana w'Intaama</para>
  <para style="q2" vid="REV 5:13">iteeka ryose!”<verse eid="REV 5:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="REV 5:14" />Maze bya binyabuzima bine birasubiza biti, “Amiina!” Ba bakuru na bo buubarara haasi maze baramya Imaana n'Umwana w'Intaama.<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s1">Ibimenyeetso Birindwi</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />Nuuko mbona Umwana w'Intaama amena kimwe muri bya bimenyeetso birindwi, maze numva kimwe muri bya binyabuzima bine gihamagara caane mu ijwi nk'iry'inkuba kiti, “Ngwino!” <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />Ndareeba, maze mbona ifaraashi y'umweru! Uwari uyiicayeho yari afite umuheto, maze ahaabwa ikamba, nuuko aza ari umutsinzi, kandi agamije guhora atsinda.<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />Umwana w'Intaama amennye ikimenyeetso ca kabiri, numva ikinyabuzima ca kabiri gihamagara kiti, “Ngwino!” <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />Maze hasohoka indi faraashi itukura caane. Uwari uyiicayeho yahaawe ububaasha bwo kuvaana amahoro ku isi, kugira ngo abantu batsembane, nuuko ahaabwa inkoota nini.<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />Umwana w'Intaama amennye ikimenyeetso ca gatatu, numva ikinyabuzima ca gatatu gihamagara kiti, “Ngwino!” Ndareeba, maze mbona ifaraashi y'umukara! Uwari uyiicayeho yari afite umunzaani mu ntoki ze. <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />Maze numva ikimeze nk'ijwi hagati y'ibyo binyabuzima bine kivuga kiti, “Ikiro kimwe c'ingano zisanzwe kigurwe uruhembo rw'umubyizi, naho ibiro bitatu by'izindi ngano bigurwe uruhembo rw'umubyizi, ariko amavuta ya elayo na divaayi ntimubikoreho!”<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />Umwana w'Intaama amennye ikimenyeetso ca kane, numva ijwi ry'ikinyabuzima ca kane rivuga riti, “Ngwino!” <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />Maze ndeebye, mbona ifaraashi y'igitare igaajuutse! Uwari uyiicayeho yari yiitwa Rupfu, kandi Kuzimu yari amukurikiye. Nuuko bahaabwa ububaasha kuri kimwe ca kane c'abatuuye ku isi, ngo babiiciishe inkoota, inzara, indwara z'icoorezo, hamwe n'inyamaaswa z'inkazi zo ku isi.<verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />Nuuko Umwana w'Intaama amennye ikimenyeetso ca gataanu, mbona munsi y'igicaaniro imyuka y'abiishwe bahoowe ijambo ry'Imaana n'ubuhamya bwo baari baaratanze. <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />Bataka mu ijwi rirenga bati, “Nyagasani Ushoborabyose, uweera w'ukuri! Uzaageza ryari kudaciira urubanza abantu batuuye isi no guhoorera amaraso yaacu baamennye?” <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />Nuuko buri umwe ahaabwa ikanzu y'umweru babwirwa kuruhuuka ikindi gihe gito, kugeza aho umubare w'abagaragu bagenzi baabo n'abavandimwe baabo bagiiye kwicwa nka bo uzuuzurira.<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:12 a </char>
      <char style="xt" closed="false">
        <ref loc="REV 11:13">Ibya 11:13</ref>; <ref loc="REV 16:18">16:18</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:29">Mat 24:29</ref>; <ref loc="MRK 13:24">Mar 13:24</ref>,<ref loc="MRK 13:25">25</ref>; <ref loc="LUK 21:25">Luk 21:25</ref>.</char>
    </note>Ndareeba maze mbona Umwana w'Intaama amena ikimenyeetso ca gatandatu. Habaho umushitsi mwinshi caane, maze izuuba rihinduka umukara nk'umwambaro bambara mu cuunamo, naho ukwezi koose guhinduka nk'amaraso. <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />Inyenyeeri zo mu kireere zigwa ku isi, nk'uko imbuto z'umutiini zikiri mbisi zigwa iyo zihuushwe n'umuyaga mwinshi. <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" /><note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="REV 16:20">Ibya 16:20</ref>.</char></note>Ikireere gikuurwaho nk'uko umuzingo w'igitabo wiizinga, nuuko imisozi n'ibirwa bikuurwa mu myanya ya byo. <verse eid="REV 6:14" /><verse number="15" style="v" sid="REV 6:15" />Maze abaami b'isi, abatware n'abakuru b'ingabo n'abakire n'abanyembaraga, imbaata n'abiigenga, boose biihisha mu buvumo no mu bitare byo mu misozi. <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" /><note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="LUK 23:30">Luk 23:30</ref>.</char></note>Baahamagaraga imisozi n'ibitare babibwira bati, “Nimutugweho maze muduhishe amaaso y'Uwiicaye ku ntebe y'ubwami hamwe n'umujinya w'Umwana w'Intaama, <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />kuko umunsi ukomeye w'umujinya waabo ugeze, kandi ni nde waashobora kuwurokoka?”<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s1">Abiisirayeli Ibihumbi Ijana na Mirongo Ine na Bine</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />Haanyuma mbona abaamalayika bane bahagaze mu nshonda enye z'isi, bakumiiriye imiyaga enye yo ku isi kugira ngo hatagira umuyaga n'umwe muri yo uhuuha ku isi cangwa mu nyanja cangwa no ku giti na kimwe. <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />Maze mbona undi malayika azaamuuka ava iburasirazuuba, afite akabonero k'Imaana nzima, maze ahamagara mu ijwi rirenga ba baamalayika bane baari baahaawe ububaasha bwo kwangiiza isi n'inyanja, <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />maze arababwira ati, “Ntimwangiize isi cangwa inyanja cangwa ibiti mbere yuuko tumara gushira akabonero ku ruhanga rwa buri mugaragu w'Imaana yaacu.” <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />Maze numva ko umubare w'abaashizweho ikimenyeetso c'Imaana ku ruhanga ari ibihumbi ijana na mirongo ine na bine kandi baari bavuuye mu miryango cumi n'ebyiri ya Isirayeli. <verse eid="REV 7:4" /><verse number="5" style="v" sid="REV 7:5" />Abantu bo mu muryango wa Yuda baashizweho ikimenyeetso baari ibihumbi cumi na bibiri, abo mu muryango wa Rawubeeni baari ibihumbi cumi na bibiri, abo mu muryango wa Gadi baari ibihumbi cumi na bibiri, <verse eid="REV 7:5" /><verse number="6" style="v" sid="REV 7:6" />abo mu muryango wa Asha baari ibihumbi cumi na bibiri, abo mu muryango wa Nafutaali baari ibihumbi cumi na bibiri, abo mu muryango wa Manase baari ibihumbi cumi na bibiri, <verse eid="REV 7:6" /><verse number="7" style="v" sid="REV 7:7" />abo mu muryango wa Simiyooni baari ibihumbi cumi na bibiri, abo mu muryango wa Leevi baari ibihumbi cumi na bibiri, abo mu muryango wa Isakari baari ibihumbi cumi na bibiri, <verse eid="REV 7:7" /><verse number="8" style="v" sid="REV 7:8" />abo mu muryango wa Zabulooni baari ibihumbi cumi na bibiri, abo mu muryango wa Yozefu baari ibihumbi cumi na bibiri, abo mu muryango wa Benjamiini baari ibihumbi cumi na bibiri.<verse eid="REV 7:8" /></para>
  <para style="s1">Imbaga y'Abantu kuva muri Buri Shanga</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />Haanyuma y'ibyo ndareeba maze mbona abantu benshi caane batabarika, bo mu mahanga yoose no mu miryango yoose, no mu mooko yoose, no mu ndimi zoose, bahagaze imbere y'intebe y'Ubwami n'imbere y'Umwana w'Intaama, bambaye amakanzu y'umweru kandi bafashe amashami y'amatanda mu ntoki zaabo. <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />Bateera heejuru mu ijwi rirenga bati, “Agakiza kava ku Maana yaacu yiicaye ku ntebe y'Ubwami, no ku Mwana w'Intaama!” <verse eid="REV 7:10" /><verse number="11" style="v" sid="REV 7:11" />Nuuko abaamalayika boose bahagarara biitoorooye ya ntebe y'Ubwami na ba bakuru hamwe na bya binyabuzima bine, maze biikubita haasi buubarara imbere ya ya ntebe y'Ubwami, maze baramya Imaana, <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />baririmba bati, “Amiina! Ibisingizo n'ikuzo n'ubuhanga n'ishimwe n'icuubahiro, imbaraga n'ububaasha bibe iby'Imaana yaacu iteeka ryose! Amiina.”<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />Maze umwe mu bakuru arambaza ati, “Mbese aba bambaye amakanzu y'umweru ni bande kandi baturutse he?”<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:21">Mat 24:21</ref>; <ref loc="MRK 13:19">Mar 13:19</ref>.</char>
    </note>Nanje ndamusubiza nti, “Daatabuja, ni wowe ubiizi.”</para>
  <para style="p" vid="REV 7:14">Na we arambwira ati, “Aba n'abaanyuze muri kwa gutootezwa gukaze. Baameshe amakanzu yaabo bayeeza mu maraso y'Umwana w'Intaama. <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />Ku bw'iyo mpamvu, bari imbere y'intebe y'ubwami y'Imaana, kandi bamuramya amanywa na nijoro mu nzu yaayo, maze uwiicaye ku ntebe y'Ubwami akazaabarindiisha ihema rye. <verse eid="REV 7:15" /><verse number="16" style="v" sid="REV 7:16" />Ntibazongera gusonza no kugira imyota ukundi, kandi ntibaziicwa n'izuuba cangwa icookeere coose, <verse eid="REV 7:16" /><verse number="17" style="v" sid="REV 7:17" />kuko Umwana w'Intaama wiicaye hagati y'intebe y'Ubwami azaababeera umushumba, kandi azaabayobora ku migezi y'amaazi y'ubugingo, kandi Imaana izaahanagura amarira yoose ku maaso yaabo.”<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s1">Ikimenyeetso ca Karindwi</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />Ubwo Umwana w'Intaama yavanyeho ikimenyeetso ca karindwi, habaho guceceka mu ijuru kumara nk'igice c'isaaha. <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />Nuuko mbona ba baamalayika barindwi bahora bahagaze imbere y'Imaana, bahaabwa impanda ndwi.<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />Undi malayika wari ufite icotero gikozwe mu zaahabu ahagarara iruhande rw'igicaaniro. Ahaabwa imibavu myinshi kugira ngo yongerwe ku masengeesho y'abeera boose maze ayituura ku tambiro ry'izaahabu riri imbere ya ya ntebe y'ubwami. <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />Maze umwotsi w'imibavu urazaamuuka, hamwe n'amasengeesho y'abeera, biva mu biganza bya malayika wari uhagaze imbere y'Imaana. <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" /><note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="REV 11:19">Ibya 11:19</ref>; <ref loc="REV 16:18">16:18</ref>.</char></note>Nuuko wa malayika afata ca cotero, acuuzuzamo umuriro arahuye ku tambiro, maze akijugunya ku isi. Inkuba zirahinda, habaho urusaku, imirabyo irarabya, n'isi ihinda umushitsi.<verse eid="REV 8:5" /></para>
  <para style="s1">Impanda Ndwi</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />Maze ba baamalayika barindwi baari bafite za mpanda ndwi biiteguura kuzivuza.<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />Malayika wa mbere avuza impanda ye, maze haaza urubura n'umuriro bivanze n'amaraso, bijugunywa ku isi. Kimwe ca gatatu c'isi kirasha, na kimwe ca gatatu c'ibiti kirasha, n'ibyatsi bibisi byose birasha.<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />Malayika wa kabiri avuza impanda ye, maze ikintu kimeze nk'umusozi munini waaka umuriro kijugunywa mu nyanja. <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />Kimwe ca gatatu c'inyanja gihinduka amaraso, kimwe ca gatatu c'ibinyabuzima bituura mu nyanja kirapfa, kandi kimwe ca gatatu c'amaato kirarimburwa.<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />Malayika wa gatatu avuza impanda ye, maze inyenyeeri nini yaaka nk'itooki, imanuka mu ijuru maze igwa kuri kimwe ca gatatu c'inzuuzi no ku migezi y'amaazi. <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />Iyo nyenyeeri yiitwaga “Rushaariira”. Kimwe ca gatatu c'amaazi kirashaariira, maze abantu benshi biicwa n'ayo maazi kuko yashaariiraga.<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />Nuuko malayika wa kane avuza impanda ye, maze kimwe ca gatatu c'izuuba na kimwe ca gatatu c'ukwezi, na kimwe ca gatatu c'inyenyeeri birakubitwa, maze kimwe ca gatatu c'iceererezi ca byo kiriijima, ku buryo kimwe ca gatatu c'umunsi n'ic'ijoro byacuze umwijima.<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />Nuuko ndareeba, maze numva impungu yagurukiraga heejuru mu kireere ivuga mu ijwi rirenga iti, “Mbeega ishano! Mbeega ishano! Mbeega ishano abatuuye isi bazaabona, ubwo ijwi rizaava mu mpanda zizaavuzwa n'abaamalayika batatu basigaye!”<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />Nuuko malayika wa gataanu avuza impanda ye. Mbona inyenyeeri yari yamanutse mu ijuru ikagwa ku isi, maze ihaabwa igishumuruzo co kuugurura ikuzimu. <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />Iyo nyenyeeri ko yuuguruye umuhonga<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="ft" closed="false">Umuhonga n'icoobo kireekire caane kitagira iheerezo </char></note>, hacucumukamo umwotsi mwinshi, nk'umwotsi uva mu tanuura nini, maze izuuba n'ikireere bizimiishwa n'uwo mwotsi w'ikuzimu. <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />Nuuko muri uwo mwotsi havamo inzige zija ku isi, maze zihaabwa ububaasha nk'ubw'indyaniishamiriizo yo ku isi. <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />Zaabwiwe kutoonoona ibyatsi, ibimera bibisi, cangwa ibiti byo ku isi, keretse abo bantu batagira ikimenyeetso c'Imaana ku ruhanga rwabo boonyine.<verse eid="REV 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 9:5" />Izo nzige zaahaawe ububaasha bwo kubababaza kumara ameezi ataanu, ariko ntizeemererwa kubiica, kandi uko kubababaza kwari nk'uko indyaniishamiriizo ibabaza umuntu iyo imurumye. <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />Muri iyo minsi, abantu bazaashaaka urupfu ariko ntibazaarubona, baziifuuza gupfa, ariko urupfu ruzaabahunga.<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />Izo nzige zaari zimeze nk'ifaraashi zambariye urugamba. Ku mitwe yaazo haari igisa nk'ikamba ya zaahabu, naho mu maaso haazo haasaga nk'ah'abantu. <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />Ubwoya bwazo bwasaga nk'umusatsi w'abagore, naho ameenyo yaazo akamera nk'ay'intare. <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />Ibituuza byazo byari bikingirijwe n'igisa nk'icuuma, naho urusaku rw'amababa yaazo rwari rumeze nk'urusaku rw'amagaare y'amafaraashi menshi agiiye ku rugamba. <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />Zaari zifite imiriizo isa nk'iy'indyaniishamiriizo n'imbuuri mu miriizo yaazo, kandi muri iyo miriizo hakabamo ububaasha bwo kugirira naabi abantu kumara ameezi ataanu. <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />Zifite umwami uzitegeka, ari we malayika ukuriye umuhonga, mu Ruheburaayo yiitwa Abadoni<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Rimenyeesha “kurimbura”</char></note> naho mu Rugiriki akiitwa Apoliyoni.<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Rimenyeesha “Umurimbuzi”</char></note><verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />Icaago ca mbere kirarangiye. Dore hagiiye gukurikiraho ibindi byago bibiri.<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />Nuuko malayika wa gatandatu avuza impanda ye, maze numva ijwi riturutse mu mahembe ane y'itambiro rya zaahabu riri imbere y'Imaana. <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />Iryo jwi ribwira malayika wa gatandatu riti, “Rekura abaamalayika bane babohewe ku ruuzi runini rwa Efurate.” <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />Nuuko ba baamalayika bane bararekurwa, kuko kuri iyo saaha, uwo munsi, uko kwezi, n'uwo mwaka, baari abo kwica kimwe ca gatatu c'abantu. <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />Nabwiwe yuuko umubare w'abasirikare barwanira ku mafaraashi baari miliyoni magana abiri. <verse eid="REV 9:16" /><verse number="17" style="v" sid="REV 9:17" />Dore uku ni ko neeretswe mu nzozi, ayo mafaraashi n'abayagenderagaho. Abaayagenderagaho baari bambaye ibyuma bikingira igituuza bisa n'umuriro, n'ubururu nka safiro n'umuhondo nk'amazuuku. Imitwe y'ayo mafaraashi yari imeze nk'imitwe y'intare, kandi mu kanwa kaayo haavagamo umuriro, umwotsi, n'amazuuku. <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />Kimwe ca gatatu c'abantu ciicwa n'ibyo byorezo bitatu, ari byo umuriro, umwotsi n'amazuuku bivuuye mu kanwa k'ayo mafaraashi. <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />Kuko imbaraga z'ayo mafaraashi zaaturukaga mu minwa no mu miriizo yaayo, imiriizo yaayo yasaga n'inzoka ifite imitwe yo yakoreeshaga kugirira abantu naabi.<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />Abantu baari basigaye batiishwe n'ibyo byorezo, ntibaaretse kuramya ibyo biikoreye n'intoki zaabo cangwa ngo bareke kuramya abadayimooni n'ibishushaanyo bikozwe mu izaahabu no mu ifeeza, no mu miringa no mu mabuye no mu biti, bitabaasha kureeba cangwa kumva cangwa kugenda. <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />Maze banga no kwihana ibyaha byabo by'ubwicanyi no kuroga, hamwe n'ubusambanyi n'ubujuura.<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s1">Malayika wari ufite Akazingo k'Igitabo</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />Nuuko mbona undi malayika ukomeye amanuka ava mu ijuru yizingiranyije mu gicu, kandi umukororombya wari ku mutwe we. Mu maaso he haari hasa n'izuuba, kandi ibirenge bye byasaga nk'inkingi z'umuriro. <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />Yari afite akazingo k'igitabo mu ntoki ze kabumbuuye. Ashira ikirenge ce c'iburyo ku nyanja, ic'ibumoso agishira ku butaka, <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />maze ateera heejuru mu ijwi riranguruye, nk'iry'intare itontoma. Amaze guteera heejuru, inkuba ndwi nazo zirahinda. <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />Izo nkuba ndwi zimaze guhinda, nari ndi haafi kwandika, ariko numva ijwi rivugira mu ijuru riti, “Ibyo izo nkuba ndwi zivuze ubigire ibanga, ntubyandike!”<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />Maze mbona wa malayika wari uhagaze ku nyanja no ku butaka amanika ukuboko kwe kw'iburyo, akwerekeza ku ijuru <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />maze arahira mu izina ry'Uhoraho iteeka ryose, uwaremye ijuru n'ibiririmo, n'isi n'ibiyirimo, n'inyanja n'ibiyirimo, avuga ati, “Ntakindi gihe gisigaye, <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />ahuubwo igihe co malayika wa karindwi azaavugiriza impanda ye, iyobera ry' Imaana ni ho rizuuzurizwa, nk'uko yabibwiye abagaragu be hamwe n'abahanuuzi.”<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />Nuuko rya jwi nari numviise rituruka mu ijuru ryongera kumbwira riti, “Genda ufate umuzingo w'igitabo ubumbuuwe uri mu ntoki za malayika uhagaze ku nyanja no ku butaka.”<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />Nuuko nsanga wa malayika musaba kumpa ako kazingo k'igitabo, maze nawe aransubiza ati, “Gashikiire maze ukarye. Kazaagushaariirira mu nda yaawe, ariko karyoherere nk'ubuuki mu kanwa kaawe.”<verse eid="REV 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10" />Nuuko mfata ako kazingo k'igitabo ngakuuye mu kiganza ca malayika maze ndakarya. Mu kanwa kanje karyohereraga nk'ubuuki, ariko maze kukarya, mu nda yanje harashaariirirwa. <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />Maze barambwira bati, “Ugomba kongera guhanuura iby'amahanga n'amooko n'indimi n'abaami.”<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s1">Abahamya Babiri</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />Nuuko mpaabwa inkoni imeze nk'igiti co gupimiisha, maze barambwira bati, “Ngwino upime Inzu y'Imaana n'itambiro kandi ubare n'abasengeramo, <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" /><note caller="-" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="LUK 21:24">Luk 21:24</ref>.</char></note>ariko igikaari kiri hanze y'Inzu y'Imaana ukireke wekugipima kuko caahaawe abanyamahanga, kandi azaacundagura itawuni nkuru yeera kumara ameezi mirongo ine n'abiri. <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />Nzaaha abahamya banje babiri ububaasha bwo guhanuura kumara iminsi igihumbi kimwe na magana abiri na mirongo itandatu, bambaye imyambaro nk'iy'icuunamo.”<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />Abo bahamya ni bo biti bibiri by'umutiini n'ibitereko by'amataara bibiri, bihagaze imbere y'Umwami w'isi. <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />Kandi hagize umuntu ushaaka kugirira naabi abo</para>
  <para style="p" vid="REV 11:5">bahamya, umuriro uzaabava mu kanwa maze utsembe abanzi baabo. Umuntu weese ushaaka kubagirira naabi, uko ni ko agomba kuziicwa. <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />Bafite ububaasha bwo guhagarika ikireere, kugira ngo imvura itagwa mu minsi yo bazaaba bahanuura, kandi bafite ububaasha bwo guhindura amaazi amaraso, n'ubwo guteeza isi ibyorezo by'uburyo bwinshi, uko babishaaka.<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:7 </char>
      <char style="xt" closed="false">
        <ref loc="REV 13:5-7">Ibya 13:5-7</ref>; <ref loc="REV 17:8">17:8</ref>.</char>
    </note>Igihe bazaaba barangije gutanga ubuhamya, ikinyamaaswa kizaamuutse kivuuye ikuzimu kizaabarwanya, kibatsinde kandi kibiice. <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />Imirambo y'abo bahamya babiri izaarambarara mu nzira y'itawuni nkuru y'icaamamare, yiitwa Sodomu na Igiputi mu mvugo y'amarenga, ari naho Umwami waabo yabambiwe. <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />Abantu bo mu bihugu byose, n'amooko yoose, n'indimi zoose, n'amahanga yoose, bazaamara iminsi itatu n'igice, batumbiira iyo mirambo kandi beekwemera ko ishirwa mu mva. <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />Abari mu isi baziishiimira urupfu rw'abo bahamya bombi, baneezeerwe, bahaane impaano, kuko abo bahamya bombi baari baarababaje abatuuye ku isi. <verse eid="REV 11:10" /><verse number="11" style="v" sid="REV 11:11" />Ariko nyuma y'iminsi itatu n'igice, umwuka w'ubuzima uturuka ku Maana winjira muri abo bahamya babiri. Barahaguruka maze abaababoonye boose bateerwa n'ubwoba bwinshi caane. <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />Nuuko bumva ijwi riranguruye riturutse mu ijuri rivuga riti, “Nimuuze hano!” Nuuko abo bahamya bazaamuuka mu bicu baja mu ijuru, abanzi baabo babareeba. <verse eid="REV 11:12" /><verse number="13" style="v" sid="REV 11:13" /><note caller="-" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="REV 6:12">Ibya 6:12</ref>; <ref loc="REV 16:18">16:18</ref>.</char></note>Ako kaanya habaho umushitsi w'ikirenga, maze kimwe ca cumi c'iyo tawuni nkuru kirariduka. Abantu ibihumbi birindwi biicwa na wa mushitsi, maze abasigaye bateerwa n'ubwoba basingiza Imaana yo mu ijuru.<verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />Icaago ca kabiri kirarangiye. Dore icaago ca gatatu kirenda kuuza vuba.<verse eid="REV 11:14" /></para>
  <para style="s1">Impanda ya Karindwi</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />Malayika wa karindwi avuza impanda, nuuko mu ijuru humviikana ijwi rirenga, rivuga riti, “Ubwami bw'isi bubaaye Ubwami bw'Umwami waacu n'ubwa Kristo, kandi aziima ingoma iteeka ryose.” <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />Nuuko ba bakuru makumyabiri na bane biicara ku ntebe zaabo imbere y'Imaana, buubama haasi maze baramya Imaana, <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />bavuga bati,</para>
  <para style="q1" vid="REV 11:17">“Turagushiima, Nyagasani Maana Ishoborabyose,</para>
  <para style="q1" vid="REV 11:17">wowe uriho kandi wahozeho,</para>
  <para style="q2" vid="REV 11:17">kuko wakoreesheje ububaasha bwawe bukomeye</para>
  <para style="q1" vid="REV 11:17">maze wima ingoma yaawe. <verse eid="REV 11:17" /><verse number="18" style="v" sid="REV 11:18" />Amahanga yuuzuye ikiraakari,</para>
  <para style="q2" vid="REV 11:18">ariko uburaakari bwawe buragaragara,</para>
  <para style="q1" vid="REV 11:18">kandi igihe ni ico guciira imanza abaapfuuye,</para>
  <para style="q2" vid="REV 11:18">no guhemba abagaragu baawe, b'abahanuuzi</para>
  <para style="q2" vid="REV 11:18">n'abantu baawe n'abo boose batiinya izina ryawe,</para>
  <para style="q1" vid="REV 11:18">abooroheje n'abakomeye, n'igihe co kurimburiramo abarimbura isi.”<verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:19 a </char>
      <char style="xt" closed="false">
        <ref loc="REV 8:5">Ibya 8:5</ref>; <ref loc="REV 16:18">16:18</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="REV 16:21">Ibya 16:21</ref>.</char>
    </note>Nuuko Inzu y'Imaana iri mu ijuru irakinguurwa, maze isanduku y'iseezerano iboneka muri iyo Nzu y'Imaana. Ubwo habaho imirabyo, guhinda kw'inkuba, umushitsi, n'urubura rwinshi.<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s1">Ikimenyeetso c'Umugore n'Ikiyoka</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />Nuuko ikimenyeetso gikomeye kigaragara mu ijuru. Mbona umugore wambaye izuuba, ukwezi kuri munsi y'ibirenge bye, kandi ku mutwe yari yambaye ikamba ry'inyenyeeri cumi n'ebyiri. <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />Yari atwite kandi atakiishwa n'ibise byo kubyara.<verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />Nuuko mu ijuru hagaragara ikindi kimenyeetso. Caari ikiyoka kinini kandi gitukura, gifite imitwe irindwi n'amahembe cumi, n'ikamba kuri buri mutwe. <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />Umuriizo waaco ukondoorera haasi kimwe ca gatatu c'inyenyeeri zo mu ijuru kizijugunya ku isi. Nuuko ico kiyoka gihagarara imbere y'uwo mugore wari weegeereje kubyara, kugira ngo kirye umwana akimara kuvuuka. <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />Nuuko abyara umwana w'umuhungu, uzaategekeesha amahanga yoose inkoni y'icuuma. Ico kiyoka nticaariiye uwo mwana, ahuubwo yarasahuwe ajanwa mu ijuru ku Maana no ku ntebe yaayo y'ubwami. <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />Uwo mugore ahungira mu butaayu, mu mwanya wo Imaana yari yaramuteguuriye, ngo abe ariho areebeererwa kumara iminsi igihumbi magana abiri mirongo itandatu.<verse eid="REV 12:6" /></para>
  <para style="s1">Mikayeli Atsinda Ikiyoka</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:7 </char>
      <char style="xt" closed="false">
        <ref loc="JUD 1:9">Yuda 1:9</ref>.</char>
    </note>Nuuko habaho intambara mu ijuru. Mikayeli n'abaamalayika be barwanya ca kiyoka. Ikiyoka na co ciifatanya n'abaamalayika baaco kubarwanya, <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />ariko biratsindwa, kandi ntibyongera kugira umwanya mu ijuru. <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" /><note caller="-" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="LUK 10:18">Luk 10:18</ref>.</char></note>Ca kiyoka kinini kijugunywa haasi, hamwe n'abaamalayika baaco, ari co ya nzoka ya keera yiitwa Umwanzi cangwa Sataani, wa wundi uyobya abo ku isi yoose. Yajugunywe ku isi hamwe n'abaamalayika be boose.<verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />Haanyuma numva ijwi rirenga riturutse mu ijuru, rivuga riti, “Nooneho igihe c'agakiza kirasohoye. Gisohoranye n'ububaasha n'Ubwami bw'Imaana yaacu hamwe n'ubutware bwa Kristo waayo, kuko umurega wahoraga arega abavandimwe baacu ku Maana yaacu buri gihe ajugunywe haasi. <verse eid="REV 12:10" /><verse number="11" style="v" sid="REV 12:11" />Abavandimwe baacu baamutsindiishije amaraso y'Umwana w'Intaama hamwe n'ijambo ry'ubutumwa bwabo. Ntibaakunze amagara yaabo, kuko baari biiteguuye gutanga ubuzima bwabo ngo biicwe. <verse eid="REV 12:11" /><verse number="12" style="v" sid="REV 12:12" />Nuuko reero, ishiime wa juru we, namwe mwese abarituuyemo! Naho mwebwe mutuuye ku isi n'inyanja, muguushije ishano, kuko Sataani yabamanukiye afite umujinya mwinshi, kuko azi yuuko ashigaje igihe gito!”<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />Ca kiyoka kiboonye ko kijugunywe ku isi, gitangira guhiiga wa mugore wabyaye umwana w'umuhungu. <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />Ariko uwo mugore ahaabwa amababa abiri y'igisiiga kinini, kugira ngo aguruke aje mu butaayu, aho azaarindirwa kumara imyaka itatu n'igice, kugira ngo ico kiyoka kitagira ico kimutwara. <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />Nuuko ca kiyoka giciira amaazi ameze nk'uruuzi inyuma ya wa mugore, kugira ngo umwuzure umutembane. <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />Ariko isi iramutabaara, ubutaka buraasama maze bumira rwa ruuzi rwari rwaciiwe kuva mu kanwa ka ca kiyoka. <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />Nuuko ikiyoka kiraakarira wa mugore, maze kiragenda ngo kirwanye abasigaye b'urubyaro rwe, buubahiriza amategeko y'Imaana kandi bagakomerera ku buhamya bwa Yesu. <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />Haanyuma ca kiyoka gihagarara ku museenyi wo ku nkengeero y'inyanja.<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s1">Ibinyamaaswa Bibiri</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:1 </char>
      <char style="xt" closed="false">
        <ref loc="REV 17:3">Ibya 17:3</ref>,<ref loc="REV 17:7-12">7-12</ref>.</char>
    </note>Nuuko mbona ikinyamaaswa kizaamuuka mu nyanja. Caari gifite amahembe cumi n'imitwe irindwi. Buri hembe ryaco ryari rifite igitaako, kandi buri mutwe waaco wariho izina rituka Imaana. <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />Ico kinyamaaswa naboonye caari gisa n'ingwe, amajanja yaaco asa n'ay'idubu, naho urwasaya rwaco ari nk'urw'intare. Nuuko ca kiyoka giha ico kinyamaaswa ububaasha bwaco, intebe yaaco y'ubwami n'ubutegetsi bukomeye. <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />Umwe muri ya mitwe yaaco wareebekaga nk'uwakomeretse caane, ariko ico gisebe caari caarakize. Nuuko ab'isi boose baratangaara maze bayoboka ca kinyamaaswa. <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />Boose baramya ico kiyoka, kuko caahaaye ico kinyamaaswa ububaasha, nuuko baramya n'ico kinyamaaswa bavuga bati, “Ntaamuntu ufite imbaraga nk'iz'iki kinyamaaswa. Ntaan'uwakirwanya ngo agishobore.”<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />Nuuko ico kinyamaaswa ceemererwa kwiraata no kuvuga amagambo yo gutuka Imaana, kandi gihaabwa ubwo bubaasha kumara ameezi mirongo ine n'abiri. <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />Gitangira gutuka Imaana, gituka izina ryayo n'aho ituuye, n'abo boose batuuye mu ijuru. <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />Ceemerewe kurwanya abantu b'Imaana no kubatsinda, gihaabwa n'ububaasha ku mooko yoose n'abantu boose n'indimi zoose n'amahanga yoose. <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />Abari mu isi boose bazaakiramya, keretse abo amazina yaabo yanditswe mu gitabo c'ubugingo isi itaraaremwa, anari co gitabo c'Umwana w'Intaama wiishwe. <verse eid="REV 13:8" /><verse number="9" style="v" sid="REV 13:9" />“Nimwumve reero, niiba mufite amatwi! <verse eid="REV 13:9" /><verse number="10" style="v" sid="REV 13:10" />Niiba Imaana yarageneye umuntu kujanwa mu bunyage, azaajanwa mu bunyage. Kandi uwagenewe kwiciishwa inkoota aziiciishwa inkoota. Abantu b'Imaana reero, barasabwa kwihangaana no kwizeera.”<verse eid="REV 13:10" /></para>
  <para style="s1">Ikinyamaaswa ca Kabiri</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />Nuuko mbona ikindi kinyamaaswa gituruka mu butaka. Caari gifite amahembe abiri ameze nk'ay'umwana w'intaama kandi kikavuga nk'ikiyoka. <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />Gikoreesha ububaasha bwose bw'ikinyamaaswa ca mbere na co kibireeba, maze gihata abantu bo mu isi boose kuramya ca kinyamaaswa ca mbere, caari caarakize igisebe. <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />Ikinyamaaswa ca kabiri gikora ibitangaaza, kugeza n'aho kimanura umuriro kuva mu ijuru ukagwa ku isi, abantu boose babireeba. <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />Bityo reero kiyobya abantu batuuye ku isi ku bwo kwemererwa gukora ibitangaaza ikinyamaaswa ca mbere kibireeba. Nuuko kibabwira gukora igishushaanyo c'ikinyamaaswa caari caarakomerekejwe n'inkoota, kikarenga kikabaho. <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />Nuuko ikinyamaaswa ca kabiri ceemererwa guhuumeekera muri ico gishushaanyo c'ikinyamaaswa, kugira ngo gishobore kuvuga kandi ciice abadashobora kukiramya. <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />Ico kinyamaaswa gihata abantu boose, abooroheje n'abakomeye, abakire n'abakene, abiigenga n'imbaata, gushirwaho ikimenyeetso ku kiganza c'iburyo cangwa ku ruhanga, <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />kugira ngo hatagira uweemererwa kugura cangwa kuguriisha adafite ico kimenyeetso, ari co zina ry'ico kinyamaaswa cangwa umubare uhagarariye iryo zina.<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />Aha hiifuuzwa ubwenge bwinshi. Umunyabwenge reero n'abare umubare w'ico kinyamaaswa kuko ari umubare uhagarariye izina ry'umuntu. Umubare waaco ni magana atandatu mirongo itandatu n'itandatu.<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">Umwana w'Intaama n'Abantu be</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:1 </char>
      <char style="xt" closed="false">
        <ref loc="REV 7:3">Ibya 7:3</ref>.</char>
    </note>Nuuko mbona Umwana w'Intaama ahagaze ku musozi wa Siyoni. Yari ari n'abantu ibihumbi ijana na mirongo ine na bine, baari bafite izina rye ndetse n'irya Se byanditswe ku buhanga bwabo. <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />Haanyuma numva ijwi riturutse mu ijuru rimeze nk'iry'amaazi menshi kandi rimeze nk'inkuba ihinda caane. Iryo jwi numviise ryari rimeze nk'iry'abacuranzi bacuranga inanga zaabo. <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />Abo bantu ibihumbi ijana na mirongo ine na bine baririmba indirimbo nsha imbere y'intebe y'ubwami n'imbere y'ibinyabuzima bine n'imbere y'abakuru. Ntaamuntu washoboye kwiga iyo ndirimbo keretse ba bantu ibihumbi ijana na mirongo ine na bine, abo Imaana yacunguye mu isi. <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />Abo bagabo ntaabwo biyanduje no gusambana n'abagore kuko baari isugi. Bakurikira Umwana w'Intaama aho agiiye hoose. Ni abantu baacunguwe mu bandi nk'umuganura w'Imaana n'Umwana w'Intaama. <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />Ntibiigeze kuvuga ibinyoma, ni abaziranenge.<verse eid="REV 14:5" /></para>
  <para style="s1">Ubutumwa bw'Abaamalayika Batatu</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />Nuuko mbona undi malayika agurukira hagati mu kireere, afite Ubutumwa Bwiza bwo kubwira abantu bo ku isi, abo mu mahanga yoose, ab'amooko yoose, ab'indimi zoose n'ibihugu byose. <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />Avuga mu ijwi rirenga ati, “Nimwubahe Imaana kandi muyihe icuubahiro, kuko igihe caayo co guca imanza kirageze. Nimuramye iyaremye ijuru n'isi hamwe n'inyanja n'imigezi y'amaazi.”<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:8 </char>
      <char style="xt" closed="false">
        <ref loc="REV 18:2">Ibya 18:2</ref>.</char>
    </note>Nuuko malayika wa kabiri akurikira malayika wa mbere, avuga ati, “Iraguuye, iraguuye Babilooni, itawuni nkuru y'icaamamare! Yanywesheje abantu baayo divaayi ikarishe y'irari ry'ubusambanyi, ari yo divaayi izana uburaakari bw'Imaana.”<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />Nuuko undi malayika wa gatatu akurikira abaamalayika ba mbere babiri, maze avuga mu ijwi rirenga ati, “Abaramya ikinyamaaswa hamwe n'igishushaanyo caaco bagashirwaho ikimenyeetso ku gahanga cangwa ku kiganza caabo, <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />bazanywa ku divaayi y'uburaakari bw'Imaana, yasutswe mu gikopu c'uburaakari bwayo itavanze. Bazaababazwa n'umuriro ugurumana imbere y'abaamalayika beera hamwe n'imbere y'Umwana w'Intaama. <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />Umwotsi w'umuriro bazaababarizwamo uzaahora ucumba iteeka ryose. Abaramya ikinyamaaswa n'ishusho yaaco n'abazaashirwaho ikimenyeetso c'izina ryaco, ntibaruhuuka kubabazwa amanywa na n'ijoro.”<verse eid="REV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12" />Ibi byose bimenyeesha ko abantu buubaha amategeko y'Imaana, bagakomeza gukurikiza ibya Yesu, bakwiriye kwihangaana.<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />Nuuko numva ijwi riturutse mu ijuru rimbwira riti, “Andika uti, ‘Uheereye ubu, hahiirwa abapfa bapfiira muri Nyagasani Yesu!’ ”</para>
  <para style="p" vid="REV 14:13">Umwuka w'Imaana na we aravuga ati, “Ni koko, bazaaruhuuka imibabaro yaabo, kuko imirimo yaabo ibaherekeza.”<verse eid="REV 14:13" /></para>
  <para style="s1">Umusaaruuro w'Isi</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />Nuuko ndareeba maze mbona igicu ceererana. Uwari kuri ico gicu yasaga nk'Umwana w'Umuntu, yambaye ikamba ry'izaahabu ku mutwe we kandi yari afite umuhoro utyaye mu kiganza ce. <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />Undi malayika ava mu Nzu y'Imaana, ahamagara uwari wiicaye ku gicu n'ijwi rirenga amubwira ati, “Koreesha umuhoro waawe maze usaaruure, kuko igihe co gusaaruura kigeze, kandi imyaka yo ku isi yo gusaaruurwa ireeze.” <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />Nuuko uwari wiicaye heejuru y'igicu atemeesha umuhoro we, maze imyaka yo ku isi irasaaruurwa.<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />Haanyuma undi malayika ava mu Nzu y'Imaana yo mu ijuru, kandi na we yari afite umuhoro utyaye.<verse eid="REV 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18" />Nuuko undi malayika wari ufite ububaasha ku muriro aturuka mu tambiro, maze ahamagara uwari afite umuhoro utyaye mu ijwi rirenga ati, “Koreesha umuhoro waawe utyaye maze ugese ibirundo by'imizaabibu y'isi, kuko imbuto zaayo zihiiriranye!” <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />Nuuko uwo malayika atemeesha umuhoro we utyaye maze asaaruura imbuto z'imizaabibu y'isi, azijugunya mu rwengero rw'uburaakari bw'Imaana. <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" /><note caller="-" style="x"><char style="xo" closed="false">14:20 </char><char style="xt" closed="false"><ref loc="REV 19:15">Ibya 19:15</ref>.</char></note>Iyo mizaabibu ikamirwa hanze y'itawuni nkuru, maze mu rwengero havamo ikidendeezi c'amaraso kingana na kilomita magana atatu ubureebure hamwe na mita ebyiri kuja haasi.<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s1">Abaamalayika Bafite Ibyago Birindwi bya Nyuma</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />Nuuko mbona mu ijuru ikindi kimenyeetso gikomeye kandi gitangaaje. Caari abaamalayika barindwi bafite ibyago birindwi ari byo byanyuma, kuko muri byo uburaakari bw'Imaana ni mwo buzaashirira.<verse eid="REV 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2" />Maze mbona ikimeze nk'inyanja y'ikirahuri kivanze n'umuriro. Nongera kubona abaatsinze ca kinyamaaswa n'ishusho yaaco hamwe n'umubare w'izina ryaco, bahagaze iruhande rw'iyo nyanja y'ikirahuri, bafite inanga z'Imaana mu ntoki zaabo, <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />maze baririmba indirimbo ya Moose, umugaragu w'Imaana hamwe n'indirimbo y'Umwana w'Intaama bati,</para>
  <para style="q1" vid="REV 15:3">“Nyagasani Maana Ishoborabyose,</para>
  <para style="q2" vid="REV 15:3">ibikorwa byawe birakomeye kandi biratangaaje!</para>
  <para style="q1" vid="REV 15:3">Mwami w'amahanga yoose,</para>
  <para style="q2" vid="REV 15:3">inzira zaawe ziratungaanye kandi ni iz'ukuri!<verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />Nyagasani, ni nde utazaatiinya kandi ntaahimbaaze izina ryawe?</para>
  <para style="q2" vid="REV 15:4">Kuko ni wowe weenyine weera.</para>
  <para style="q2" vid="REV 15:4">Amahanga yoose azaaza maze akuramye,</para>
  <para style="q1" vid="REV 15:4">kuko ibikorwa byawe bitungaanye bigaragajwe.”<verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />Haanyuma mbona mu ijuru Inzu y'Imaana yarimo ihema ry'ubuhamya ikinguuka, <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />maze muri ya Nzu y'Imaana havamo ba baamalayika barindwi bafite bya byago birindwi, bambaye imyenda y'umweru itanduye kandi irabagirana. Ibituuza byabo byari bikingirijwe n'imishumi y'izaahabu. <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />Nuuko kimwe muri bya binyabuzima bine giha abo baamalayika barindwi amabakure arindwi yuuzuye uburaakari bw'Imaana ihoraho iteeka ryose. <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />Ya Nzu y'Imaana yuuzura umwotsi w'ikuzo n'imbaraga by'Imaana, ntihaagira n'umwe ushobora kwinjira mu Nzu y'Imaana kugeza aho ibyago birindwi by'abaamalayika barindwi byarangiriye.<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s1">Amabakure Yuuzuye Uburaakari Bw'Imaana</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />Nuuko numva ijwi riranguruye rituruka mu Nzu y'Imaana ribwira ba baamalayika barindwi riti, “Nimugende maze musuke ku isi ayo mabakure arindwi y'uburaakari bw'Imaana.”<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />Malayika wa mbere aragenda maze asuka ku isi ibyari biri mu bakure ye nuuko abantu baari bafite ikimenyeetso c'ikinyamaaswa kandi bakaramya n'igishushaanyo caayo, bafatwa n'ibisebe by'imifunzo bibabaza caane.<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />Malayika wa kabiri asuka mu nyanja ibyari biri mu bakure ye, maze inyanja yoose ihinduka nk'amaraso y'umuntu wapfuuye, nuuko ikinyabuzima coose caari kiri mu nyanja kirapfa.<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />Malayika wa gatatu asuka mu nzuuzi n'imigezi y'amaazi ibyari biri mu bakure ye, maze bihinduka amaraso. <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />Nuuko numva malayika ushinzwe amaazi abwira Imaana ati, “Uri umutabeera wa Weera we, wowe uriho kandi wahozeho, kuko waciiye urubanza utabeera. <verse eid="REV 16:5" /><verse number="6" style="v" sid="REV 16:6" />Baamennye amaraso y'abantu b'Imaana n'ay'abahanuuzi, noone ubahaaye amaraso ngo bayanywe. Bahaawe icaari kibakwiriye.” <verse eid="REV 16:6" /><verse number="7" style="v" sid="REV 16:7" />Nuuko numva ijwi riturutse ku tambiro rivuga riti, “Yeego Nyagasani Maana Ishoborabyose, uca imanza z'ukuri n'ubutabeera!”<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />Malayika wa kane asuka ibyari biri mu bakure ye ku zuuba, maze Imaana yeemerera izuuba kookeesha abantu umuriro wa ryo. <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />Abantu bookejwe n'ubushuuhe bwinshi, maze batuka izina ry'Imaana yari ifite ububaasha bwo guteeza ibi byago, kandi ntibiihana no guha Imaana icuubahiro.<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />Malayika wa gataanu asuka ibyari biri mu bakure ye ku ntebe y'ubwami bwa ca kinyamaaswa, ubwami bwaco buhinduka umwijima, maze abantu bahekenya indimi zaabo kubeera ububabare, <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />nuuko batuka Imaana yo mu ijuru, babiteewe n'ububabare n'ibisebe, kandi ntibiihana ibikorwa byabo bibi.<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />Malayika wa gatandatu asuka ibyari biri mu bakure ye mu ruuzi runini rwa Efurate, maze amaazi yarwo arakama kugira ngo hateguurwe inzira y'abaami baturuka iburasirazuuba. <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />Nuuko mbona imyuka mibi itatu imeze nk'imitubu iva mu kanwa ka ca kiyoka, mu kanwa ka ca kinyamaaswa no mu kanwa ka wa muhanuuzi w'ibinyoma. <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />Iyo ni ya myuka y'abadayimooni ikora ibitangaaza, igasanga abaami bo mu isi yoose, kugira ngo ibakoranyirize kuzaaja mu ntambara kuri wa munsi ukomeye w'Imaana Ishoborabyose.<verse eid="REV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:15 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:43">Mat 24:43</ref>,<ref loc="MAT 24:44">44</ref>; <ref loc="LUK 12:39">Luk 12:39</ref>,<ref loc="LUK 12:40">40</ref>; <ref loc="REV 3:3">Ibya 3:3</ref>.</char>
    </note>(Nyagasani aravuze ati, “Dore! Ndaaje nk'umujuura! Hahiirwa uba maaso agahora yambaye, kugira ngo atagenda yambaye ubusa, maze abantu bakabona ubwambure bwe akamwara.”)<verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />Nuuko ya myuka ikoranyiriza hamwe ba baami, mu mwanya wiitwa Harimagedoni mu rurimi rw'Uruheburaayo.<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />Malayika wa karindwi asuka ibyari biri mu bakure ye mu kireere, maze ijwi riranguruye rituruka ku ntebe y'ubwami mu Nzu y'Imaana, riravuga riti, “Birarangiye!” <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" /><note caller="-" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="REV 8:5">Ibya 8:5</ref>; <ref loc="REV 11:13">11:13</ref>,<ref loc="REV 11:19">19</ref>.</char></note>Nuuko haaza imirabyo, urusaku no guhinda kw'inkuba, n'imishitsi. Ntihiigeze kubaho umushitsi nk'uyu kuva abantu baaba ku isi. Uyu ni wo mushitsi ukomeye wabaayeho kuruta iyindi yoose. <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />Itawuni nkuru y'icaamamare isadukamo gatatu, nuuko amatawuni makuru y'amahanga yoose araseenyuka. Imaana ntaabwo yiibagiwe Babilooni y'icaamamare, nuuko iyiha kunywera ku gikopu cuuzuye divaayi y'uburaakari bwayo. <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" /><note caller="-" style="x"><char style="xo" closed="false">16:20 </char><char style="xt" closed="false"><ref loc="REV 6:14">Ibya 6:14</ref>.</char></note>Nuuko ibirwa byose birahunga, n'imisozi yoose irabura. <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" /><note caller="-" style="x"><char style="xo" closed="false">16:21 </char><char style="xt" closed="false"><ref loc="REV 11:19">Ibya 11:19</ref>.</char></note>Urubura ruremeereye, rungana n'ibilo mirongo itaanu buri rumwe, rumanukira abantu ruvuuye mu ijuru, kugeza ubwo batuka Imaana ku bw'ico caago c'urubura caari gitinyiishije caane.<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s1">Indaaya Kaabuhariwe</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />Nuuko umwe muri ba baamalayika barindwi baari bafite amabakure arindwi araaza maze arambwira ati, “Ngwino nkwereke igihano Imaana igiiye guha ya ndaaya kaabuhariwe, ari yo tawuni y'icaamamare yuubatswe ku nkengeero y'amaazi magari. <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />Abaami bo ku isi baasambanye na yo, kandi abantu bo ku isi basindiishwa no kunywa divaayi y'ubusambanyi bwayo.”<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:3 </char>
      <char style="xt" closed="false">
        <ref loc="REV 13:1">Ibya 13:1</ref>.</char>
    </note>Nuuko ntwarwa mu mwuka, maze wa malayika anjaana mu butaayu. Mbona umugore yiicaye ku kinyamaaswa gitukura, cuuzuyeho amazina atuka Imaana, kandi gifite imitwe irindwi n'amahembe cumi. <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />Uwo mugore yari yambaye umwenda w'umuhengeri n'umutuku, kandi arimbiishijwe n'izaahabu, amabuye y'agaciiro n'amasimbi. Mu kiganza ce yari afite igikopu ca zaahabu cuuzuyemo amahano n'imyanda y'ubusambanyi bwe. <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />Mu ruhanga rwe haari handitswe izina ry'amayoberane ngo: “Babilooni ikomeye, nyina w'indaaya n'ibizira byo ku isi.” <verse eid="REV 17:5" /><verse number="6" style="v" sid="REV 17:6" />Nuuko mbona ko wa mugore yasinze amaraso y'abeera n'amaraso y'abaahoowe Yesu.</para>
  <para style="p" vid="REV 17:6">Ko namuboonye, ndatangaara caane. <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />Ariko malayika arambaza ati, “Utangaajwe n'iki? Ndakumenera ibanga ry'uriiya mugore n'iry'ikinyamaaswa kimuheetse, gifite imitwe irindwi n'amahembe cumi. <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" /><note caller="-" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="REV 11:7">Ibya 11:7</ref>.</char></note>Ikinyamaaswa waboonye ciigeze kubaho ariko ubu ntikikiriho. Ubu kigiiye kuva imuhonga kugira ngo kirimburwe. Abatuuye ku isi bo amazina yaabo atanditswe mu gitabo c'ubugingo kuva isi itaraaremwa, bazaatangaara nibabona ico kinyamaaswa, kuko ciigeze kubaho, noone kikaba kitakiriho, ariko kikazongera kubaho.<verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />Aha ni ho hakwiriye ubwenge n'ubuhanga: Iyo mitwe irindwi ni yo misozi irindwi uwo mugore yiicayeho, kandi ikaba n'abaami barindwi. <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />Bataanu muri abo baami ntibakiriho, umwe ari ku ngoma ubu, naho undi ntaaraaza, kandi naaza agomba kuzaaba umwami akaanya gato. <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />Kandi ico kinyamaaswa caabaayeho ariko kikaba kitakiriho, ni umwami wa munaane, ni umwe muri ba bandi barindwi kandi agiiye kurimburwa.<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />Ya mahembe cumi waboonye ni abaami cumi batari baatangira gutegeka, ariko bakazaahaabwa ububaasha bwo gutegeka nk'abaami hamwe n'ikinyamaaswa kumara akaanya gato. <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />Boose uko ari icumi baahuuje umugambi wo kwegurira ikinyamaaswa ububaasha n'ubushobozi bwabo. <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />Bazaarwanya Umwana w'Intaama, ariko we hamwe n'abo yahamagaye, abo yatooranyije n'abayoboke be b'indahemuka bazaabatsinda, kuko ari Umwami w'abaami n'Umutegetsi w'abategetsi.”<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />Malayika yongera kumbwira ati, “Amaazi waboonye ya ndaaya yiicayeho, ni amahanga, abantu, amooko n'indimi z'abo ku isi yoose. <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />Amahembe cumi waboonye, hamwe n'ikinyamaaswa, bizanga iyo ndaaya. Bizaayambura ibyo ifite yambare ubusa. Bizaarya inyama zaayo maze ibisigarizwa bitwikwe mu muriro. <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />Kuko Imaana yashize mu mitima yabyo umugambi wo gufatanyiriza hamwe maze bigaha ikinyamaaswa ububaasha bwo gutegeka, kugeza igihe amagambo y'Imaana azaasohorera.<verse eid="REV 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18" />Uwo mugore waboonye ni itawuni nkuru y'icaamamare itegeka abaami bo ku isi.”<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s1">Guseenyuka kwa Babilooni</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />Haanyuma yo kureeba wa mugore wari wiicaye ku kinyamaaswa gitukura, mbona undi malayika amanuka mu ijuru. Yari afite ububaasha bukomeye, maze isi imurikirwa n'ububengerane bw'ikuzo rye. <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" /><note caller="-" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="REV 14:8">Ibya 14:8</ref>.</char></note>Nuuko arangurura ijwi rirenga ati, “Babilooni iraseenyutse, iraseenyutse Babilooni itawuni nkuru y'icaamamare! Yahindutse ubutaaho bw'abadayimooni n'imyuka mibi yoose, kandi inyoni n'inyamaaswa zoose zihumaanya ni ho zicumbika. <verse eid="REV 18:2" /><verse number="3" style="v" sid="REV 18:3" />Amahanga yoose yanyooye divaayi ikaze y'uburaakari bw'ubusambanyi bwayo. Abaami bo ku isi baasambanye na yo, kandi n'abacuruuzi bo ku isi baakungahajwe n'ubukire butagira urugero.”<verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />Nuuko numva irindi jwi rivugira mu ijuru riti,</para>
  <para style="q1" vid="REV 18:4">“Bantu banje, nimusohoke muri Babilooni!</para>
  <para style="q2" vid="REV 18:4">Kugira ngo mutiivanga mu byaha byayo,</para>
  <para style="q2" vid="REV 18:4">maze mugasangira na yo ibihano biyigenewe!<verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />Kuko ibyaha byayo byirundanyije bikagera ku ijuru,</para>
  <para style="q2" vid="REV 18:5">kandi Imaana yiibutse ibikorwa byayo bibi.<verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />Nimuyikorere ibihwanye n'ibyo yakoze,</para>
  <para style="q2" vid="REV 18:6">kandi muyituure ibyo yabakoreye inshuro ebyiri.</para>
  <para style="q1" vid="REV 18:6">Muyuuzuririze mu gikopu ico kunywa gikaze inshuro ebyiri</para>
  <para style="q2" vid="REV 18:6">kuruta ico yuuzuririzaga abandi.<verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />Aho Babilooni yagejeje yiiha ikuzo no kudamarara,</para>
  <para style="q2" vid="REV 18:7">abe ari ho mugeza kuyiteeza umubabaro n'agahinda.</para>
  <para style="q1" vid="REV 18:7">Kuko ikomeza kwibwira iti,</para>
  <para style="q1" vid="REV 18:7">‘Dore niicaye ku ngoma yanje nk'umwamikazi!</para>
  <para style="q2" vid="REV 18:7">Si ndi umupfaakazi,</para>
  <para style="q2" vid="REV 18:7">kandi sinteze kuzaagira agahinda!’<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />Kuko Babilooni yiikujije ityo, igiiye kugwirwa n'ibyago vuba,</para>
  <para style="q2" vid="REV 18:8">ari byo, urupfu, icuunamo n'inzara.</para>
  <para style="q1" vid="REV 18:8">Kandi izaatwikwa n'umuriro,</para>
  <para style="q2" vid="REV 18:8">kuko Nyagasani Imaana, uyiciira urubanza ari umunyambaraga.”<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />Maze abaami bo ku isi baari baarasambanye n'iyo ndaaya bakadamarara na yo, bazaayiririra baborooge ubwo bazaaabona umwotsi w'umuriro uyitwika. <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />Bazaahagarara kure, kubwo gutiinya kubabazwa hamwe na yo, maze bavuge bati, “Mbeega ishano! Mbeega ishano! Babilooni, itawuni nkuru y'icaamamare kandi y'igihangaage kubona igihano caawe kiiziye mu saaha imwe yoonyine! ”<verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />Abacuruuzi bo ku isi na bo bazaayiririra baje mu cuunamo, kuko ntaawe uzaaba akigura ibicuruuzwa byabo, <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />by'izaahabu, ifeeza, n'amasaro meeza, amasimbi, imyambaro y'umweru n'itukura ikozwe mu bitambaro bihenze, amooko y'ibiti byose bihuumura neeza, ibikozwe mu meenyo y'inzovu no mu biti bihenze, umuringa, ubutare n'ibuye ryiza ryitwa mabo, <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />ibyatsi bihuumura, ibirungo, imibavu n'ububaane, divaayi n'amavuta ya elayo, ifu nziiza n'ingano, inka n'intaama, amafaraashi n'amagaare, ndetse n'abacakara n'ubuzima bw'abantu. <verse eid="REV 18:13" /><verse number="14" style="v" sid="REV 18:14" />Abacuruuzi bazaabwira iyo ndaaya bati, “Ibyo umutima waawe wiifuuzaga byagukuuweho, n'ubutunzi n'ibishiimiisha amaaso yaawe byose bigushizeho, kandi ntuuzongera kubibona!” <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />Abacuruuzi b'ibyo bintu baari baarakijijwe no gucuruuriza muri iyo tawuni nkuru, bazaahagarara hirya, batiinya kubabazwa hamwe na yo. Bazaarira kandi baborooge, <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />maze bavuge bati, “Mbeega ishano! Mbeega ishano! Itawuni nkuru y'icaamamare yari yambaye imyenda y'agaciiro, y'umweru n'umutuku, kandi igataakwa n'izaahabu, n'amabuye y'agaciiro, hamwe n'amasimbi! <verse eid="REV 18:16" /><verse number="17" style="v" sid="REV 18:17" />Noone mu saaha imwe yoonyine, ubwo bukungu bwayo bwose bukaba burimbutse!”</para>
  <para style="p" vid="REV 18:17">Bakuru b'amaato n'abayagenderamo boose, abasaare n'abacuruuriza ku nyanja, bahagarara hiirya <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />maze baboonye umwotsi wo gutwikwa kwayo bateera hejuru bavuga bati, “Nta tawuni nkuru yiigeze kuba icaamamare nk'iyi!” <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />Nuuko biisiiga umucuucu ku mitwe yaabo, bateera heejuru barira kandi baborooga bati, “Mbeega ishano! Mbeega ishano uboonye wa tawuni we nkuru y'icaamamare! Ubukungu bwawe bwari bwarakijije abafite amaato ku nyanja boose! Ariko noone dore mu saaha imwe yoonyine byose birarimbutse!<verse eid="REV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20" />Ishiime wa juru we, kuko iyi tawuni nkuru yaseenyutse! Nimwishiime namwe beera b'Imaana hamwe n'intumwa n'abahanuuzi! Kuko Imaana yahannye Babilooni iyiryoza ibyo yabakoreye.”<verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />Nuuko malayika w'igihangaage afata ibuye ringana n'urusyo runini maze arijugunya mu nyanja avuga ati, “Uku ni ko itawuni nkuru y'igihangange Babilooni izaahananturirwa haasi maze ntiizongere kuboneka ukundi. <verse eid="REV 18:21" /><verse number="22" style="v" sid="REV 18:22" />Muri wowe, ntihazongera kumviikana amajwi y'abacuranzi b'inanga n'abaririmbyi, n'abavuzi b'imyirenge n'impanda! Ntaamuhanga mu bucuruuzi ubwo ari bwo bwose uzongera kuboneka iwaawe, kandi ijwi ry'urusyo ntirizongera kumviikana ku bwo kubura ico gusya. <verse eid="REV 18:22" /><verse number="23" style="v" sid="REV 18:23" />Urumuri rw'itaara ntiruzongera kumurika iwaawe ukundi, kandi amajwi y'umukwe n'umugeni ntaazongera kumviikana. Abacuruuzi ni bo baari bakomeye mu si yoose, kuko amahanga yoose yari yarayobejwe n'ubupfumu bwawe!”<verse eid="REV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24" />Babilooni yarahanwe kuko yamennye amaraso y'abahanuuzi n'ay'abeera b'Imaana hamwe n'abo boose biiciwe mu isi.<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="s1">Kuneezeerwa mu Ijuru</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />Haanyuma yo kuvuga kwa malayika w'igihangange, numva ikimeze nk'amajwi arenga y'inteeko y'abantu mu ijuru, bavuga bati, “Nihasingizwe Imaana! Agakiza, icuubahiro, n'ububaasha ni iby'Imaana yaacu. <verse eid="REV 19:1" /><verse number="2" style="v" sid="REV 19:2" />Ubucaamanza bwayo ni ubw'ukuri n'ubutabeera. Yaciiriye urubanza ya ndaaya y'icaamamare yahumanyije abo mu isi n'ubusambanyi bwayo. Imaana yayihannye kuko yiishe abagaragu baayo.” <verse eid="REV 19:2" /><verse number="3" style="v" sid="REV 19:3" />Barongera bati, “Ni hasingizwe Imaana! Umwotsi uva muri iyi tawuni y'icaamamare uzaacumbeeka iteeka ryose!” <verse eid="REV 19:3" /><verse number="4" style="v" sid="REV 19:4" />Nuuko ba bakuru makumyabiri na bane na bya binyabuzima bine barapfukama maze baramya Imaana yiicaye ku ntebe y'ubwami, bavuga bati, “Amiina. Nihasingizwe Imaana!”<verse eid="REV 19:4" /></para>
  <para style="s1">Ubukwe bw'Umwana w'Intaama</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />Nuuko ijwi rirenga rituruka kuri ya ntebe y'ubwami rivuga riti, “Nimusingize Imaana yaacu, mwa bagaragu baayo mwese mwe, namwe abayuubaha, abooroheje n'abakomeye!” <verse eid="REV 19:5" /><verse number="6" style="v" sid="REV 19:6" />Nuuko numva ikimeze nk'ijwi ry'inteeko y'abantu benshi, n'irimeze nk'iry'amaazi menshi n'irimeze nk'inkuba ihinda caane, rivuga riti, “Nihasingizwe Imaana! Kuko Nyagasani Imaana yaacu, Ishoborabyose iri ku ngoma. <verse eid="REV 19:6" /><verse number="7" style="v" sid="REV 19:7" />Nitwishiime tuneezeerwe kandi tumuhimbaaze, kuko ubukwe bw'Umwana w'Intaama busohoye, kandi n'umugeni we akaba yiiteguuye. <verse eid="REV 19:7" /><verse number="8" style="v" sid="REV 19:8" />Yahaawe kwambara umwenda mwiza w'agaciiro urabagirana kandi utanduye.” (Koko reero uwo mwenda mwiza w'agaciiro ni ibikorwa byiza by'abantu b'Imaana.)<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:2">Mat 22:2</ref>,<ref loc="MAT 22:3">3</ref>.</char>
    </note>Nuuko malayika arambwira ati, “Andika uti, ‘Hahiirwa abatumiwe mu bukwe bw'Umwana w'Intaama.’ ” Maze yongera kumbwira ati, “Aya ni amagambo y'ukuri y'Imaana.”<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />Nuuko mfukama imbere ye ngo muramye, ariko arambwira ati, “Reka, ntuubikore! Ndi umugaragu mugenzi waawe hamwe n'abo bavandimwe bamamaza ukuri ko Yesu yagaragaje. Ahuubwo Imaana abe ari yo uramya!</para>
  <para style="p" vid="REV 19:10">Koko reero, ubuhamya bwa Yesu ni umwuka w'ubuuhanuuzi.”<verse eid="REV 19:10" /></para>
  <para style="s1">Uwiicaye ku Faraashi y'Umweru</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />Haanyuma mbona ijuru rikinguuye, maze mbona ifaraashi y'umweru! Uwari uyiicayeho yiitwa Mudahemuka na Munyakuri, kandi agaca imanza no kurwana intambara akurikije ubutabeera. <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />Amaaso ye yari nk'ibirimi by'umuriro, kandi yari yambaye amakamba menshi ku mutwe we. Yari afite izina rimwanditsweho, ariko ntaawundi wari uriizi keretse we ubwe. <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />Yari yambaye ikanzu yiinitswe mu maraso, kandi izina rye yiitwaga Jambo w'Imaana. <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />Ingabo zo mu ijuru ziramukurikira, ziicaye ku mafaraashi y'umweru kandi zambaye imyenda myiza y'agaciiro y'umweru isukuuwe. <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" /><note caller="-" style="x"><char style="xo" closed="false">19:15 </char><char style="xt" closed="false"><ref loc="REV 14:20">Ibya 14:20</ref>.</char></note>Mu kanwa ke havamo inkoota ityaye, yo kuzaarimbuza amahanga. Azaabategekeesha inkoni y'icuma, kandi azaacundagura imbuto z'imizaabibu mu rwengero havemo divaayi y'uburaakari bukaze bw'Imaana Ishoborabyose. <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />Ku gishuura ce no kukibero ce haari handitsweho iri zina: “Umwami w'abaami n'Umutegetsi w'abategetsi.”<verse eid="REV 19:16" /></para>
  <para style="s1">Ikinyamaaswa n'Ingabo zaaco Bitsindwa</para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />Nuuko mbona malayika ahagaze mu zuuba, maze ahamagara ibinyoni bigurukira heejuru mu kireere mu ijwi rirenga ati, “Nimuuze maze mukoranire gusangira ifunguro ry'Imaana rihebuuje, <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />murye inyama z'abaami, inyama z'abasirikare bakuru, inyama z'ibihangaage, inyama z'amafaraashi n'iz'abayagenderaho, n'inyama z'abantu boose, baaba abiigenga cangwa imbaata, abooroheje n'abakomeye.”<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />Nuuko mbona ca kinyamaaswa n'abaami bo ku isi hamwe n'ingabo zaabo bakoraniye kurwanya uwiicaye ku faraashi n'ingabo ze. <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" /><note caller="-" style="x"><char style="xo" closed="false">19:20 </char><char style="xt" closed="false"><ref loc="REV 13:1-18">Ibya 13:1-18</ref>.</char></note>Maze ico kinyamaaswa kirafatwa, hamwe n'umuhanuuzi w'ibinyoma wari warakoreye imbere yaaco ibimenyeetso byo yayobeesheje abaashizweho ikimenyeetso c'ico kinyamaaswa n'abaaramyaga igishushaanyo caaco. Ico kinyamaaswa hamwe n'umuhanuuzi w'ibinyoma bajugunywa mu nyenga y'umuriro ugurumana ari bazima. <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />Abandi biiciishwa inkoota ivuuye mu kanwa k'uwiicaye ku faraashi, maze ibisiiga byose bihaaga inyama zaabo.<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s1">Imyaka Igihumbi</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />Nuuko mbona malayika amanuka ava mu ijuru afite mu ntoki ze igishumuruzo c'ikuzimu, hamwe n'urujegeri runini. <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />Afata ca kiyoka, ari co ya nzoka ya keera yiitwaga Umwanzi cangwa Sataani, maze arakiboha ngo kimare imyaka igihumbi, <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />nuuko akijugunya ikuzimu, arahafunga maze ashiraho ico kuhafatanya, kugira ngo kitazongera kuyobya amahanga kugeza aho imyaka igihumbi izaashirira. Nyuma y'imyaka igihumbi, malayika azaarekura ico kiyoka kumara igihe gito.<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />Nuuko mbona intebe z'ubwami, maze abaziicayeho bahaabwa ububaasha bwo guca imanza. Haanyuma mbona imyuka y'abantu baaciiwe imitwe bazize kuba abahamya ba Yesu n'ijambo ry'Imaana. Ntibiigeze kuramya ico kiyoka cangwa ishusho yaaco kandi ntibiigeze bashirwaho ikimenyeetso caaco mu ruhanga cangwa mu biganza. Nuuko barazuuka maze bategeka na Kristo kumara imyaka igihumbi. <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />[Abandi baapfuuye bo ntibaazuutse imyaka igihumbi itaraashira.] Iryo ni ryo zuuka rya mbere. <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />Hahiirwa abo Imaana izaazuura muri iryo zuuka rya mbere, kuko ari abaayo bwiite. Urupfu rwa kabiri ntaabubaasha rubafiteho, ahuubwo bazaaba abaheerezabitambo b'Imaana na Kristo, kandi bazaategeka hamwe na we imyaka igihumbi.<verse eid="REV 20:6" /></para>
  <para style="s1">Sataani Atsindwa</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />Imyaka igihumbi n'ishira, Sataani azaarekurwa ave mu gihome, <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />maze aje kuyobya amahanga yo mu mpande zoose z'isi ari zo ziiswe Gogi na Magogi, kugira ngo ayakoranyirize hamwe ngo baje mu ntambara. Umubare waabo ni nk'umuseenyi wo ku nyanja. <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />Nuuko baraaza bakwira isi yoose maze bagota inkambi y'intoore z'Imaana hamwe n'itawuni nkuru ikundwa. Ariko umuriro umanuka mu ijuru urabatwika. <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />Sataani wari warabayobeje ajugunywa mu nyanja y'umuriro ugurumana, iyo ya nyamaaswa n'umuhanuuzi w'ibinyoma byari byarajugunywe. Uwo muriro uzaabababaza amanywa n'ijoro iteeka ryose.<verse eid="REV 20:10" /></para>
  <para style="s1">Urubanza rw'Imperuuka</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />Nuuko mbona intebe nini y'ubwami yeera de hamwe n'uyiicayeho. Isi n'ijuru biramuhunga ntibyongera kuboneka. <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />Nuuko mbona abaapfuuye, abakomeye n'abooroheje bahagaze imbere ya ya ntebe y'ubwami, maze ibitabo birarambuurwa. Ikindi gitabo, ari co gitabo c'ubuzima na co kirarambuurwa. Abapfuuye baciirwa imanza hakurikijwe ibikorwa byabo, nk'uko byanditswe muri ibyo bitabo. <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />Inyanja irekura abaapfuuye baari bayirimo, Urupfu n'ikuzimu na byo birekura abaapfuuye baari babirimo maze boose baciirwa imanza hakurikijwe ibyo baakoze. <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />Nuuko Urupfu n'Ikuzimu bijugunywa mu nyanja y'umuriro. Iyo nyanja y'umuriro ni rwo rupfu rwa kabiri, <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />kandi umuntu weese wo izina rye ryari ritanditswe muri ico gitabo c'ubugingo yajugunywe muri iyo nyanja y'umuriro.<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s1">Ijuru Risha n'Isi Nsha</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:1 </char>
      <char style="xt" closed="false">
        <ref loc="2PE 3:13">2Pet 3:13</ref>.</char>
    </note>Maze mbona ijuru risha n'isi nsha, kuko ijuru rya mbere n'isi ya mbere byari byavuuyeho, kandi n'inyanja yari itakiriho. <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" /><note caller="-" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="REV 3:12">Ibya 3:12</ref>.</char></note>Mbona i tawuni nkuru yeera, Yerusaalemu nsha, iva mu ijuru ku Maana, iteguuwe nk'uko umugeni arimbiishwa agiiye gusanganira umugabo we. <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />Nuuko numva ijwi rirenga riturutse ku ntebe y'ubwami rivuga riti, “Dore ubu, urugo rw'Imaana ruri mu bantu kandi Imaana igiiye gutuura na bo kandi babe abaayo. Imaana ubwayo izaabaana na bo kandi ibe Imaana yaabo. <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />Izaahanagura amarira yoose ku maaso yaabo. Ntihazongera kubaho urupfu, kandi agahinda no kurira no kubabara na byo ntibizongera kubaho, kuko ibyambere byose bizaaba birangiye.”<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />Nuuko uwari wiicaye ku ntebe y'ubwami aravuga ati, “Dore byose mbihinduye bisha.” Yongera kumbwira ati, “Andika ibyo nkubwira kuko ari iby'ukuri no kwizeerwa.” <verse eid="REV 21:5" /><verse number="6" style="v" sid="REV 21:6" />Nuuko arambwira ati, “Birarangiye! Ni nje Alufa na Omega, intangiriro n'iheerezo. Abafite imyota nzaabaha kunywa ku maazi y'ubugingo ntaaco batanze. <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />Abazaatsinda intambara, ibi nzaabibaha nk'umurage, kandi nzaababeera Imaana, na bo bambeere abaana. <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />Ariko abanyabwoba, abatiizeera, abandujwe n'ibizira, abiicanyi, abasambanyi, abarozi, abaramya ibishushaanyo, n'abanyabinyoma boose, umugabane waabo uzaaba mu nyanja y'umuriro ugurumana, ari rwo rupfu rwa kabiri.”<verse eid="REV 21:8" /></para>
  <para style="s1">Yerusaalemu Nsha</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />Nuuko umwe muri ba baamalayika barindwi baari bafite amabakure arindwi yuuzuyemo ibyorezo bya nyuma birindwi, araaza maze aravuga ati, “Ngwino nkwereke umugeni uzaaba umugore w'Umwana w'Intaama.” <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />Nuuko Umwuka w'Imaana anzaho, maze wa malayika anjaana ku musozi munini kandi mureemure, anyereka itawuni nkuru yeera ari yo Yerusaalemu imanuka iva mu ijuru ku Maana. <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />Yarabagiranaga n'ikuzo ry'Imaana, ikabengerana nk'ibuye ry'agaciiro kenshi, nk'ibuye rya yasipi ribonerana nk'ikirahuri c'umucaaca n'umutuku. <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />Yari izengurutswe n'igisiika gikomeye kandi kireekire caane, hamwe n'amarembo cumi n'abiri. Kuri buri rembo haari malayika urinda kandi handitsweho izina rimwe ryo mu miryango ya Isirayeli. <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />Iburasirazuuba haariho amarembo atatu, mu majaaruguru amarembo atatu, mu majeepfo amarembo atatu, n'iburengerazuuba amarembo atatu. <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />Igisiika c'iyo tawuni caari cuubatswe ku mfatiro cumi n'ebyiri, kandi buri rufatiro rwari rwanditsweho rimwe mu mazina y'intumwa cumi n'ebyiri z'Umwana w'Intaama. <verse eid="REV 21:14" /><verse number="15" style="v" sid="REV 21:15" />Uwo malayika twavuganaga yari afite igipimiisho c'urukoba rw'izaahabu rwo gupimiisha iyo tawuni nkuru hamwe n'amarembo yaayo n'ibisiika. <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />Iyo tawuni yari ifite impande enye zingana, kandi umurambararo n'ubugari byari bingana. Iyo tawuni ayipimiisha urukoba rwe maze umurambararo waayo ungana na kilomita ibihumbi bibiri na magana ane kandi uwo murambararo wanganaga n'ubugari hamwe n'ubuhagarike. <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />Malayika apima n'igisiika caayo maze asanga gifite ubuhagarike bwa mita mirongo itandatu, akoreesheje urugero abantu baari basanzwe bakoreesha. <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />Igisiika caari cuubakiishijwe amabuye ya yasipi naho itawuni yuubakiishijwe izaahabu iyunguruye kandi ibonerana nk'ikirahuri. <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />Amabuye y'imfatiro y'igisiika c'iyo tawuni yari atoneesheje amabuye y'agaciiro y'ubwoko bwose. Urufatiro rwa mbere rwari rurimbiishijwe amabuye ya yasipi, urwa kabiri aya safiro, urwa gatatu aya agata, urwa kane aya emerodi, <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />urwa gataanu aya onisi, urwa gatandatu aya kaneeliya, urwa karindwi aya kirisolite, urwa munaane aya beriri, urwa cenda aya topaazi, urwa cumi aya kirisoparase, urwa cumi na rumwe aya yasinta, urwa cumi na kabiri aya ametusito. <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />Amarembo uko ari cumi n'abiri yari amasimbi cumi n'abiri, buri rembo ryari ryubakiishijwe isimbi rimwe. Umuhanda wo muri iyo tawuni nkuru ukozwe n'izaahabu iyunguruwe, kandi ireeberana nk'ikirahuri.<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />Nta Nzu y'Imaana naboonye muri iyo tawuni nkuru, kuko Nyagasani Imaana Ishoborabyose, hamwe n'Umwana w'Intaama ari bo Rusengero rwaho. <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />Iyo tawuni nkuru ntaabwo yari yiifuuza izuuba cangwa ukwezi byo kuyimurikira, kuko ikuzo ry'Imaana ari ryo riyimurikira, kandi Umwana w'Intaama akayibeera itaara. <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />Amahanga azaagendera mu rumuri rwayo, kandi abaami bo mu isi bazaazanamo ibyubahiro byabo. <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />Amarembo yaayo ntaaziigera akingwa ku manywa, kandi nta joro rizaabaho. <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />Abantu bazaayizanamo ikuzo n'icuubahiro by'amahanga. <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />Ariko ntihazinjiramo ikintu gihumaanye cangwa umuntu weese ukora ikizira cangwa akabeesha. Abo bonyiine bo amazina yaabo yanditswe mu gitabo c'Umwana w'Intaama ni bo bazinjira muri iyo tawuni.<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="s1">Uruuzi rw'Ubugingo</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />Haanyuma malayika anyereka uruuzi rw'amaazi y'ubugingo, rubonerana nk'ikirahuri. Urwo ruuzi rwavaga ku ntebe y'ubwami y'Imaana n'Umwana w'Intaama, <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />rugatemba hagati y'umuhanda mugari w'iyo tawuni nkuru. Ku mpande zombi z'urwo ruuzi, haari igiti c'ubugingo gifite amooko cumi n'abiri y'imbuto, ceeraga imbuto inshuro cumi n'ebyiri mu mwaka, rimwe buri kwezi. Amababi y'ico giti akaba ayo gukiza indwara z'amahanga. <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />Ntaakintu caavumwe kizongera kuba muri iyo tawuni nkuru.</para>
  <para style="p" vid="REV 22:3">Intebe y'ubwami y'Imaana n'Umwana w'Intaama izaaba muri iyo tawuni nkuru, maze abagaragu baayo bazaayiramya. <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />Bazaabona mu maaso h'Imaana, maze izina ryayo ryandikwe ku mpanga zaabo. <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />Ntihazongera kubaho ijoro ukundi, kandi ntibazaamurikirwa n'itaara cangwa izuuba, kuko Nyagasani Imaana izaababeera urumuri, maze biime ingoma iteeka ryose.<verse eid="REV 22:5" /></para>
  <para style="s1">Ukuuza kwa Yesu Kristo</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />Haanyuma malayika arambwira ati, “Aya magambo ni ayo kwizeerwa kandi ni ay'ukuri. Nyagasani Imaana yo ibwira abahanuuzi ibyo kuvuga, yatumye malayika waayo kwereka abagaragu baayo ibyenda kubaho vuba.”<verse eid="REV 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />Yesu aravuga ati, “Dore ngiiye kuuza vuba! Hahiirwa abakurikiza amagambo y'ubuhanuuzi buri muri iki gitabo!”<verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />Njeewe Yohaana, ibyo narabyiyumviye kandi ndabyibonera. Maze kubyumva no kubibona, niikubita haasi imbere y'ibirenge bya malayika wabiinyeretse, kugira ngo muramye. <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />Ariko arambwira ati, “Ntuubikore! Ndi umugaragu mugenzi waawe hamwe n'abavandimwe baawe b'abahanuuzi, hamwe n'abuubahiriza ubutumwa buri muri iki gitabo. Imaana abe ari yo uramya!” <verse eid="REV 22:9" /><verse number="10" style="v" sid="REV 22:10" />Maze arambwira ati, “Amagambo ari muri iki gitabo c'ubuhanuuzi ntuuyagire ibanga, kuko igihe ceegereje. <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />Reka inkozi z'ibibi zikomeze gukora ibibi, n'uwanduye umutima agume yanduye, naho intungaane ikomeze gukora ibitungaanye, kandi umuziranenge akomeze kuba umuziranenge.”<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />Yesu yongera kuvuga ati, “Dore ngiiye kuuza vuba, nzanye ibihembo kugira ngo ngororere umuntu weese nkurikije ibyo yakoze. <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" /><note caller="-" style="x"><char style="xo" closed="false">22:13 a </char><char style="xt" closed="false"><ref loc="REV 1:8">Ibya 1:8</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="REV 1:17">Ibya 1:17</ref>; <ref loc="REV 2:8">2:8</ref>.</char></note>Ni nje Alufa<note caller="+" style="f"><char style="fr" closed="false">22:13 </char><char style="ft" closed="false">Alufa kimenyeesha intangiriro</char></note> na Omega<note caller="+" style="f"><char style="fr" closed="false">22:13 </char><char style="ft" closed="false">Omega kimenyeesha iherezo</char></note>, ndi uwa mbere n'uwa nyuma, ndi intangiriro n'iheerezo.”<verse eid="REV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14" />Hahiirwa abamesa amakanzu yaabo, kugira ngo beemererwe kurya ku mbuto z'igiti c'ubugingo no kwinjira mu tawuni nkuru banyuze mu marembo yaayo. <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />Muri iyo tawuni nkuru ntihazeemererwayo abanduye n'abarozi n'abasambanyi, n'abiicanyi n'abasenga ibigirwamaana, n'umuntu weese ukunda ibinyoma kandi akanabikoreesha.<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />“Ni nje Yesu, wabooherereje malayika wanje kugira ngo abahamirize ibyo bigenewe amatoorero. Nkomooka mu muryango wa Dawudi, kandi ndi ya nyenyeeri yaaka izuuba rigiiye kurasa.”<verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />Umwuka n'umugeni barahamagara bati, “Ngwino!”</para>
  <para style="p" vid="REV 22:17">Kandi ubyumviise weese na we ahamagare ati, “Ngwino!”</para>
  <para style="p" vid="REV 22:17">Ufite imyota weese naaze, maze ahaabwe amaazi y'ubugingo ku buntu.<verse eid="REV 22:17" /></para>
  <para style="s1">Umusoozo</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />Njeewe Yohaana, ndaamagirira umuntu weese wumva amagambo y'ubuhanuuzi buri muri iki gitabo. Nihagira ugira ico yongeraho, Imaana izongera ku gihano ce ibyago bivugwa muri iki gitabo. <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />Kandi nihagira ugira ico agabanya ku magambo y'ubuhanuuzi ari muri iki gitabo, Imaana izaagabanya ku mugabane w'uwo muntu yari kuzaabona ku giti c'ubugingo no mu tawuni nkuru yeera, nk'uko bivugwa muri iki gitabo.<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />Uhamya ubu butumwa aravuga ati, “Koko ngiiye kuuza vuba.”</para>
  <para style="p" vid="REV 22:20">Amiina. Ngwino, Nyagasani Yesu!<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />Ubuntu bwa Nyagasani Yesu bubaane namwe mwese. Amiina.<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>