<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Rufumbira New Testament</book>
  <para style="h">ABAROOMA</para>
  <para style="toc3">Rom</para>
  <para style="toc2">Abarooma</para>
  <para style="toc1">Urwandiko Intumwa Pawulo yandikiye ABAROOMA</para>
  <para style="mt2">URWANDIKO INTUMWA PAWULO YANDIKIYE ABAROOMA</para>
  <para style="mt1">ABAROOMA</para>
  <para style="imt">INYANZURO</para>
  <para style="im">
    <char style="bk">Urwandiko Intumwa Pawulo yandikiye Abarooma</char> rwari integuuza y'uruzinduko rwe rw'itoorero ry'i Rooma. Ikigendererwa ce caari ico guheereza mu bakristo b'i Rooma kumara igihe gito maze haanyuma na bo bakamufasha kuja mu gihugu ca Sipeyini. Yanditse kugira ngo yeerekane uko yasobaanukiwe kwizeera kwa Gikristo hamwe n'ingaruka zifatika mu buzima bw'abakristo. Iki gitabo kirimo amagambo yuuzuye y'ubutumwa bwa Pawulo.</para>
  <para style="ip">Amaze kuramutsa abantu b'itoorero ry'i Rooma no kubabwira uko akomeje kubasengera, Pawulo yeerekana umutwe w'urwo rwandiko ari wo: “Ubutumwa buhishuura uko Imaana yagize abantu baayo intungaane binyuriye mu kwizeera uheereye ku ntangiriro ukagera ku iheerezo.” 1–17.</para>
  <para style="ip">Pawulo akomeza kwagura uyu mutwe avuga ko ikiremwamuntu coose, haaba Abayuuda cangwa Abanyamahanga, boose bagomba gutungaanira Imaana kuko imbaraga z'icaaha zibuugarije. Yeerekana ko abantu batungaanira Imaana mu kwemera Yesu Kristo. Pawulo akomeza gusobaanura ubugingo busha muri Kristo yuuko buturuka mu mibaanire myiza n'Imaana. Uweemera weese agira amahoro n'Imaana kandi Umwuka w'Imaana akamubohoora mu mbaraga z'icaaha n'urupfu. Mu gice ca gataanu kugera ku ca munaane, Pawulo akomeza gusobaanura ikigendererwa c'amategeko y'Imaana hamwe n'imbaraga z'Umwuka w'Imaana mu buzima bw'abiizeera. Pawulo agerageza gusobaanura ko Abayuuda hamwe n'abanyamahanga, boose bari mu migambi Imaana yateguuriye ikiremwa muntu. Arangiza avuga ko imigambi y'Abayuuda, yo kwanga Yesu ari kimwe mu nteguura y'Imaana yo kuuzana abantu boose haafi y'ubuntu bwa Yesu Kristo, kandi yeemera yuuko Abayuuda batazaakomeza kwanga Yesu. Pawulo arangiza yandika uko ubuzima bw'umukristo bugomba kuba, na caane ku byerekeye uburyo bw'urukundo n'imibaanire n'abandi. Ashiraho imitwe mikuru nko guheereza Imaana, imirimo yo umukristo agomba gukorera igihugu no gufashanya, hamwe n'ikibazo gifashe ku mutimanaama. Arangiza urwandiko n'ubutumwa bwe ku giti ce, hamwe n'amagambo yo guhimbaaza Imaana.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro hamwe n'umutwe w'amagambo <char style="ior"><ref loc="ROM 1:1-17">1:1-17</ref></char></para>
  <para style="io1">Iciifuuzo co gukizwa <char style="ior"><ref loc="ROM 1:18-3:20">1:18—3:20</ref> </char></para>
  <para style="io1">Uburyo bwo Imaana irokora <char style="ior"><ref loc="ROM 1:21-4:25">1:21—4:25</ref> </char></para>
  <para style="io1">Ubuzima busha muri Kristo<char style="ior"><ref loc="ROM 5:1-8:39">5:1—8:39</ref> </char></para>
  <para style="io1">Isirayeli mu mugambi w'Imaana <char style="ior"><ref loc="ROM 9:1-11:36">9:1—11:36</ref> </char></para>
  <para style="io1">Imyifatire ya Gikristo <char style="ior"><ref loc="ROM 12:1-15:13">12:1—15:13</ref> </char></para>
  <para style="io1">Umusoozo n'indamutso z'umwihariko <char style="ior"><ref loc="ROM 15:14-16:27">15:14—16:27</ref> </char></para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="s1">Indamutso</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Njeewe Pawulo, umugaragu wa Yesu Kristo, wahamagariwe kuba intumwa kandi watooranyirijwe kwamamaza Ubutumwa Bwiza, ndabaramukije.<verse eid="ROM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 1:2" />Ubwo Butumwa Bwiza Imaana yabuduseezeranyije keera inyuriye mu bahanuuzi baayo mu Byanditswe Byera. <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />Buvuga ibyerekeye Umwana waayo ukomooka mu muryango wa Dawudi mu buryo bw'umubiri <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />kandi akaba yareerekanywe n'ubushobozi ko ari Umwana w'Imaana mu buryo bw'Umwuka Weera bikagaragazwa n'izuuka rye mu baapfuuye, ni we Yesu Kristo Umwami waacu. <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />Binyuze muri we, Imaana yangiriye ubuntu bwo kuba intumwa, kugira ngo nyobore abantu bo mu mahanga yoose bizeere kandi bumvire Imaana ku bw'izina rye. <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />Namwe Abarooma muri abo baahamagawe n'Imaana kuba aba Yesu Kristo.<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />Noone reero, ndabandikiye mwebwe bakundwa b'Imaana batuuye i Rooma kandi baahamagariwe kuba abantu baayo.</para>
  <para style="p" vid="ROM 1:7">Ubuntu n'amahoro biva ku Maana Daata hamwe n'Umwami Yesu Kristo, bibe muri mwe.<verse eid="ROM 1:7" /></para>
  <para style="s1">Isengeesho ryo Gushiima</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />Mbere ya byose, ndashiima Imaana yanje muri Yesu Kristo ku bwanyu mwese, kuko ukwizeera kwanyu kwamamaye ku isi hoose. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Imaana nkorera n'umutima wanje woose mu kwamamaza Ubutumwa bw'Umwana waayo, ni yo ntanze nk'umujurizi yuuko mpora mbiibuka mu masengeesho yanje, <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />nyisaba kugira ngo impe uburyo bwo gushobora kugera iwaanyu. <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />Koko nkumbuye kubonana namwe kugira ngo dusangire impaano y'Umwuka w'Imaana no kubakomeza. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />Ico menyeesha ni ukugira ngo nje namwe duteerane inkunga, mukomezwe no kwizeera kwanje, nanje nkomezwe no kwizeera kwanyu.<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:13 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:21">Iby 19:21</ref>.</char>
    </note>Bavandimwe, ndashaaka ko mumenya neeza yuuko nahoze mfite iciifuuzo co kuuza iwaanyu, ariko hakagira ibikomeza kuunaniza. Nashaakaga ko ibikorwa byanje byakwera imbuto muri mwe hakaboneka abayoboke nk'uko mbikora no mu bandi banyamahanga. <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />Mfite inshingano yo kugeza Ubutumwa Bwiza ku bantu boose, baaba Abagiriki cangwa abatari Abagiriki, baaba abanyabwenge cangwa injiji. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Noone reero, nshiishikajwe no kwamamaza Ubutumwa Bwiza namwe abari i Rooma.<verse eid="ROM 1:15" /></para>
  <para style="s1">Imbaraga z'Ubutumwa Bwiza</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:16 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 8:38">Mar 8:38</ref>.</char>
    </note>Erega Ubutumwa Bwiza ntibunkoza isoni kuko ari imbaraga y'Imaana yo gukiza abo boose biizeera bagakizwa, uheereye ku Muyuuda ukageza no ku Mugiriki. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />Kuko muri bwo, ni mwo ubutungaane buva ku Maana buhishuurirwa, buheeshwa no kwizeera bugakomezwa na ko, nk'uko byanditswe ngo, “Umukiraanutsi azaabeeshwaho no kwizeera.”<verse eid="ROM 1:17" /></para>
  <para style="s1">Icaaha ca Kiremwamuntu</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Kuko uburaakari bw'Imaana buhishuurwa buva mu ijuru burwanya abagomeramaana boose, n'abagizi ba naabi boose barwanya ukuri kugira ngo kutamenyekana. <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />Kuko bigaragara ko baazi ibifashe ku Maana, kandi ubwayo ni yo yabahishuuriye ubwo bwenge. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Kuva igihe Imaana yaremye isi, ububaasha bwayo buhoraho, n'ubumaana bwayo butagaragara, bugaragarizwa mu byo yaremye kugira ngo batagira ico biireguuza, <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" /><note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="EPH 4:17">Efe 4:17</ref>,<ref loc="EPH 4:18">18</ref>.</char></note>kuko bamenya Imaana, ariko ntibayihe icuubahiro kiyikwiriye, cangwa ngo bayishiimire, ahuubwo baabaaye abapfaapfa mu biteekerezo byabo, maze imitima yaabo itagira ubwenge icura umwijima. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />Biibwira ko ari abanyabwenge, ariko baahindutse abapfaapfa. <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />Ubwiza bw'Imaana idapfa baabuguranye ishusho isa n'umuntu uzaapfa, isa n'ibiguruka, n'inyamaaswa zigenza amaguru ane cangwa ibikururuka haasi.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Ni co caatumye ibateererana ngo bakore ibyo imitima yaabo irarikira, bagakora ibiteeye isoni maze bigahumaanya imibiri yaabo. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />Baaguranye ukuri kw'Imaana ibinyoma, baramya kandi bakorera ibyaremwe babirutiisha Imaana Rurema ubwayo, ari yo ikwiriye guhimbaazwa iteeka ryose, Amiina.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Ni yo mpamvu Imaana ibagabiza ibiteeye isoni bararikira, ndetse n'abagore na bo bagakoreesha imibiri yaabo mu guhuuza ibitsina mu buryo bunyuranye n'ubwo baaremewe. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />Ni co kimwe abagabo na bo bareka guhuuza ibitsina n'abagore ahuubwo bakararikirana ubwabo. Abagabo batingana n'abagabo bagenzi baabo. Bityo reero Imaana ikabaha igihano kibakwiriye ku bw'ubukozi bw'ibibi bwabo.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />Kandi ubwo banze kumenya ukuri kw'Imaana, Imaana yarabaretse ngo bagume mu biteekerezo byabo bipfuuye, kugira ngo bakore ibidakwiriye gukorwa. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />Buuzuye gukiraanirwa koose, ubugome, kwifuuza kubi, urwango, ishari, ubwicanyi, intonganya, kubeesherana, kuriganya, gusebanya, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />bateera urubwa, banga Imaana, ni abanyagasuuzuguro, bariiraata, bariiraariira, bahimbahimba ibibi, ntibumvira ababyeyi baabo, <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />ni abapfaapfa, abahemu, ni abadakunda abaabo, ni intababarira. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />Baazi itegeko ry'Imaana yuuko abakora ibisa bityo bakwiriye gupfa. Ntibakomeza gukora ibyo bibi gusa, bongeraho no gushiima abandi babikora.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s1">Urubanza rw'Imaana Rutabeera</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:1">Mat 7:1</ref>; <ref loc="LUK 6:37">Luk 6:37</ref>.</char>
    </note>Nuuko reero ntaaco ufite co kwireguuza, wowe muntu uciira abandi imanza. Kuko iyo uciiriye undi urubanza uba witsindiisha ubwawe, kuko wowe uciira abandi urubanza ukora ibisa n'ibyo bakora. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Kandi ubu tuuzi neeza yuuko Imaana izaaciira urubanza abakora ibisa bityo ikurikije ukuri kwayo. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Noone se wowe muntu uciira abandi imanza bakora ibisa bityo, naawe ubikora, wiibwira ko wowe ubwawe uzaakira urubanza rw'Imaana? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />Cangwa se waaba usuuzugura kugira neeza kwayo kutabarika, n'imbabazi zaayo no kwihangaana kwayo? Ntureeba ko kugira neeza kw'Imaana kukuuzanira kwihana? <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />Ariko kuko winangiye umutima, ukanga kwihana, uri kwibiikira igihano gikomeye ku munsi w'umujinya w'Imaana ubwo guca imanza kwayo kutabeera kuzaagaragara. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />Kuko iziituura buri weese ikurikije ibyo yakoze. <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />Imaana izaaha ubugingo buhoraho abo baakoze neeza, bagashaaka ubwiza n'icuubahiro n'ubugingo budashira. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />Ariko abo bantu biikunda, batumvira ukuri ahuubwo bakumvira gukiraanirwa, Imaana izaabiituura umujinya n'uburaakari. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Amakuba n'ibyago ni byo izaateeza buri muntu weese ukora ikibi, uheereye ku Muyuuda ukageza ku Mugiriki. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />Ariko ubwiza, icuubahiro n'amahoro ni byo iziituura buri weese ukora ibyiza, uheereye ku Muyuuda ukageza ku Mugiriki. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />Kuko Imaana itarobaanura ku butoni.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />Abo boose bazaaba baaracumuye bataazi amategeko bazaarimbuka badahoowe amategeko, kandi abo baakoze ibyaha boose baazi amategeko bazaaciirwa urubanza hakurikijwe amategeko. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Kuko kumva amategeko byonyine ntibyatuma utungaanira Imaana, ahuubwo abumvira amategeko ni bo bazaatsindiishirizwa na yo. <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />Abanyamahanga badafite amategeko, iyo ku bwa kamere, bakoze ibyo amategeko asaba kandi batagira amategeko, ku bwabo baba bihindukiye amategeko. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />Bagaragaza ko ico amategeko agamije canditswe mu mitima yaabo. N'umutimanaama waabo na wo ukababeera umuhamya ko ari ukuri, kandi n'ibiteekerezo bikabarwaniramo, bimwe bibashinja ibindi bibarengera. <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />Kandi ni na ko bizaaba ku munsi Imaana izaaciira abantu urubanza rw'ibihishwe mu mitima ikoreesheje Yesu Kristo, kandi ni na ko Ubutumwa Bwiza nahaawe bubyemeza.<verse eid="ROM 2:16" /></para>
  <para style="s1">Abayuuda hamwe n'Amategeko</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />Ubwo wiiyita Umuyuuda kandi ukiishingikiriza ku mategeko kandi ukiiraatana ubumwe ufitanye n'Imaana <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />ukamenya ibyo ishaaka, uzi guhitamo iciiza kiruta ibindi byose kuko wiigiishijwe iby'amategeko, <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />wiiyemera ko ari wowe waayobora impumyi, waamurikira abari mu mwijima, <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />waahuguura abapfaapfa, ukaba n'umwiigiisha w'injiji, kuko uzi neeza yuuko muri ayo mategeko ufite ubumenyi bwuzuye n'ukuri. <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />Mbese ko wiigiisha abandi ntiwiyigiishe ubwawe? Kuki ubwiriza kutiiba, kandi ukiiba? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />Kuki wiigiisha abantu kwirinda ubusambanyi kandi wowe usambana, kuki wanga abaramya ibigirwamaana ariko ukambura insengero zaabyo? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />Wiiraata ko uzi amategeko ariko ugasuuzugura Imaana urenga ku mategeko? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />Nk'uko ibyanditswe bivuga biti, “Izina ry'Imaana ritukwa n'abanyamahanga ku bwanyu.”<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />Ni koko gukebwa kugira ico kumara, ukurikije amategeko, ariko niiba wica amategeko, gukebwa kwawe kuba guhindutse kudakebwa. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Mbese niiba umuntu utaarakebwe akurikiza ibyategetswe n'amategeko, kudakebwa kwe ntikuzaaba kumuhwaniye no gukebwa? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />Uwo udakebwe umubiri ariko akitondera amategeko azaaguciira urubanza wowe urenga kuri ayo mategeko nuubwo uyafite mu nyandiko kandi warakebwe ariko ntuyumvire. <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />Koko reero, ibigaragara si byo biranga Umuyuuda nyakuri, kandi gukebwa ko ku mubiri si ko gukebwa nyakuri. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />Ahuubwo Umuyuuda nyakuri ni uwo ufite umutima ukiraanukira Imaana. Kandi gukebwa nyakuri si ukuubahiriza amategeko yanditswe ahuubwo ni uguhindurwa umutima n'Imaana. Umeze atyo, ntaashimwa n'abantu ahuubwo ashimwa n'Imaana.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Mbese Abayuuda barusha iki abanyamahanga? Cangwa se gukebwa bimaze iki? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />Ni koko barabaruta mu buryo bwose. Mbere na mbere Abayuuda ni bo baabiikijwe amagambo yavuzwe n'Imaana. <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />Mbese niiba bamwe muri bo bataariizeeye, kutiizeera kwabo kwahindura ubusa gukiraanuka kw'Imaana? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />Oya ntibikabeho! Ahuubwo Imaana iboneka ko ari inyakuri, nuubwo umuntu weese yaaba umunyabinyoma, nk'uko byanditswe ngo,</para>
  <para style="q1" vid="ROM 3:4">“Mu byo uvuga uzaagaragaze ko uri intungaane,</para>
  <para style="q2" vid="ROM 3:4">kugira ngo uzaatsinde nuuciirwa urubanza.”<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />Ariko niiba gukiraanirwa kwacu guhamya gukiraanuka kw'Imaana tuvuge iki? Mbese tuvuge ko Imaana ikiraanirwa iyo ituraakariye ikaduhana? Ibi mbivuze nk'umuntu. <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />Ntibishoboka! Niiba Imaana idakiraanuka, yaazaaciira abari mu isi urubanza ite?<verse eid="ROM 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7" />Niiba ibinyoma byanje bituma ukuri kw'Imaana kurushaho kugaragara, maze Imaana igahaabwa icuubahiro, ni iki gituma nshiirwa urubanza nk'umunyabyaha? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />Kandi kuki tutavuga tuti, “Reka twikorere ibibi kugira ngo ibyiza bibeho,” nk'uko abantu bamwe batubeeshera. Abavuga batyo bazaaciirwa urubanza rubakwiriye.<verse eid="ROM 3:8" /></para>
  <para style="s1">Ntaamuntu n'umwe w'Intungaane</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />Noone se tuvuge iki? Mbese hari ico twebwe Abayuuda turusha Abagiriki? Ntaakiriho! Kuko tumaze kwitegereza ko baaba Abayuuda cangwa Abagiriki, boose bategekwa n'icaaha. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />Nk'uko ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="ROM 3:10">“Ntaamukiraanutsi waabona, habe n'umwe.<verse eid="ROM 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11" />Ntaamunyabwenge waabona.</para>
  <para style="q2" vid="ROM 3:11">Ntaan'umwe ushaaka Imaana.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />Boose baarayobye,</para>
  <para style="q2" vid="ROM 3:12">boose baahindutse imburamumaro;</para>
  <para style="q2" vid="ROM 3:12">ntaan'umwe ukora iciiza habe n'umwe.<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />Amagambo aturuka mu kanwa kaabo ariica,</para>
  <para style="q2" vid="ROM 3:13">bariganyisha indimi zaabo.</para>
  <para style="q2" vid="ROM 3:13">Ubusabwe bw'inshiira buri mu minwa yaabo.<verse eid="ROM 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14" />Akanwa kaabo kuuzuyemo amagambo yo kuvuma, ashaariira.<verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />Biihuutira kubabaza abantu no kubiica,<verse eid="ROM 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16" />kurimbuka n'umubabaro bisigara aho banyuze hoose.<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />Inzira y'amahoro ntibayiizi,<verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />kuubaha Imaana ntikubarimo.”<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Nyamara tuuzi ko ibyo amategeko avuga byose, bibwirwa abategekwa n'amategeko kugira ngo hatagira ugira urwitwazo, maze abari mu isi boose baciirwe urubanza n'Imaana. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" /><note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="GAL 2:16">Gal 2:16</ref>.</char></note>Kuko ari ntaan'umwe uzaatsindiishirizwa imbere y'Imaana n'imirimo itegetswe n'amategeko. Amategeko ni yo atugaragariza ko twacumuye.<verse eid="ROM 3:20" /></para>
  <para style="s1">Ubutungaane Buheeshwa no Kwizeera</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Ariko nooneho hariho uburyo bwo gutungaanira Imaana buhishuuwe budatangwa n'amategeko. Uko gutungaanira Imaana ntaaho guhuuriye no kumvira amategeko, nuubwo amategeko ya Moose n'abahanuuzi yabitanzeho ubuhamya. <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" /><note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="GAL 2:16">Gal 2:16</ref>.</char></note>Gutungaanira Imaana, guheeshwa no kwizeera Yesu Kristo. Imaana ibikorera abo boose beemera ntaavanguura, <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />kuko boose baakoze ibyaha bigatuma badashikira ubwiza bw'Imaana, <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />ariko bagatsindiishirizwa n'ubuntu bwayo ku bwo gucungurwa kubonerwa muri Yesu Kristo. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />Kuko Imaana yatanze Yesu ngo abe impongano yo kubabarirwa ibyaha kubamwizeera. Yabikoze kugira ngo yeerekane ubutungaane bwayo bwatumye yiirengagiza ibyaha byakozwe mbere. <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />Imaana yabikoze kugira ngo yeereke ab'iki gihe gutungaana kwayo no gutsindiishiriza uwo weese wiizeera Yesu.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />Noone se twakwiraatiisha iki? Ntaaco. Kuko gutungaanira Imaana kwacu ntiguheeshwa no kumvira amategeko ahuubwo kugengwa no kwizeera. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />Koko reero tuuzi yuuko umuntu atsindiishirizwa no kwizeera atari ugukora ico amategeko asaba. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />Mbese Imaana yaba iy'Abayuuda bonyine? Ntaabwo se ari n'iy'abanyamahanga? Yeego, ni iy'abanyamahanga na bo, <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" /><note caller="-" style="x"><char style="xo" closed="false">3:30 </char><char style="xt" closed="false"><ref loc="GAL 3:20">Gal 3:20</ref>.</char></note>kuko Imaana ari imwe rukumbi, izaaha Umuyuuda gutsindiishirizwa ku bwo kwizeera kandi n'abanyamahanga na bo bazaatsindiishirizwa ku bwo kwizeera kwabo. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />Mbese amategeko tuyahindure ubusa ku bwo kwizeera? Ntibikabe! Ahuubwo turayakomeza.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s1">Iciitegererezo co Kwizeera kwa Aburahamu</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Mbese noone twavuga iki kuri Aburahamu sogokuruza ku mubiri? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Niiba Aburahamu yaratsindiishirijwe abikeesheje ibikorwa, afite ibyo yiiraata, ariko ntiyabyiraata imbere y'Imaana. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" /><note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="GAL 3:6">Gal 3:6</ref>.</char></note>Kuko ibyanditswe bivuga ngo, “Aburahamu yiizeeye Imaana, haanyuma kwizeera kwe gutuma Imaana imwemera nk'intungaane.” <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />Abakozi bahembwa ibihembo ku bw'imirimo bakora, ntibibahwanira no guheerwa ubuntu kuko baba baabikoreye. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Ariko reero umuntu ntiyaaba intungaane abikeesheje imirimo, ahuubwo ni ku bwo kwizeera Imaana ibabarira abanyabyaha. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />Dawudi na we yavuze yeeruye ibyerekeye imigisha y'umuntu, uwo Imaana yeemera nk'intungaane atabikeesheje imirimo ye, ati,<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />“Hahiirwa abababarirwa ibicumuro byabo,</para>
  <para style="q2" vid="ROM 4:7">kandi ibyaha byabo bigakuurwaho.<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />Hahiirwa umuntu Nyagasani atazaabaraho icaaha.”<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />Mbese ayo mahiirwe yaseezeranyijwe Abayuuda bonyine? Cangwa n'abanyamahanga na bo? Tuvuga ko, “Kwizeera kwa Aburahamu kwatumye yeemerwa nk'intungaane.” <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Ibi byabaaye Aburahamu ataraakebwa, ntibyabaaye haanyuma yo gukebwa kwe ahuubwo yari ataraakebwa. <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />Imaana imaze kumwemera nk'intungaane yahaawe ikimenyeetso co gukebwa kigaragaza gukiraanuka kuvuuye ku kwizeera yari afite ataraakebwa kugira ngo abe seekuruza w'abizeera Imaana boose, n'ubwo baaba bataarakebwe ngo bahaabwe kuba intungaane. <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />Aburahamu ni seekuruza w'abaakebwe, atari ugukebwa gusa ahuubwo bakurikiza iciitegererezo co kwizeera yari afite mbere ataraakebwa.<verse eid="ROM 4:12" /></para>
  <para style="s1">Ibyo Imaana yaseezeranyije dukeesha Kuyizeera</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:13 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 3:29">Gal 3:29</ref>.</char>
    </note>Ubwo Imaana yaseezeranyije Aburahamu n'urubyaro rwe kuzaaragwa isi, Imaana yarabikoze atari uko Aburahamu yumviye amategeko ahuubwo iseezerano yariheeshejwe no gukiraanuka kuva mu kwizeera. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" /><note caller="-" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="GAL 3:18">Gal 3:18</ref>.</char></note>Kuko niiba abumvira amategeko ari bo bazaahaabwa ibyaseezeranyijwe, kwizeera kwaba ari ntaamumaro gufite n'ibyaseezeranyijwe na byo bikaba ari impfaabusa. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />Kuko amategeko azana uburaakari, ariko aho amategeko atari, ntaamuntu waacumura.<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:16 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 3:7">Gal 3:7</ref>.</char>
    </note>Ni yo mpamvu iseezeerano Imaana yahaaye Aburahamu ryari rishingiye ku kwizeera kugira ngo ribe impaano y'ubuntu ku rubyaro rwe rwose. Nyamara si abumvira amategeko bonyine ahuubwo n'abafite kwizeera nk'ukwa Aburahamu. Kuko Aburahamu ni we sogokuruza wa twese mu kwizeera, <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />nk'uko byanditswe ngo, “Nakugize seekuru w'amahanga menshi.” Ibi byabaayeho kuko Aburahamu yiizeeye Imaana izuura abaapfuuye kandi igaha ibitariho kubaho. <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />Aburahamu uwo, yeemeraga kandi akiiringira ibitaakwiringirwa, kugira ngo abe seekuruza w'amahanga menshi nk'uko byanditswe ngo, “Urubyaro rwawe ruzaaba rwinshi nk'inyenyeeri zo mu kireere.” <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />Kandi nuubwo yari ari nk'umaze imyaka ijana y'ubukuru kandi ateekereza ko umubiri we usa n'uwapfuuye, ndetse akabona na Saara yararenze igihe co kubyara, ntiyacoogoye mu kwizeera Imaana. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />Ntiyiigeze ashidiikanya iseezerano ry'Imaana, ahuubwo yakomeje gukomera mu kwizeera aheereza Imaana icuubahiro. <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />Yari yeemejwe neeza adashidiikanya yuuko Imaana ifite ububaasha bwo gukora ico yaseezeranye. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />Ni co caatumye Aburahamu, ku bwo kwizeera, Imaana yaramwemeye nk'intungaane. <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />Nyamara kwemerwa nk'intungaane si we byandikiwe wenyine, <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />ahuubwo naatwe bidufasheho, twebwe abazeemerwa n'Imaana nk'intungaane kuko twizeeye iyazuuye Yesu Umwami waacu mu baapfuuye. <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />Yesu uwo, yatangiwe gupfiira ibyaha byacu, maze arazuurwa kugira ngo tube intungaane.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s1">Gutungaanira Imaana</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Ubwo reero twatsindiishirijwe no kwizeera, dufite amahoro ku Maana muri Yesu Kristo Umwami waacu. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />Kubwo kwizeera Kristo twashikiiriye ubuntu dushikamyemo, noone twishiimira ibyiringiro byo kuzaasangira ikuzo ry'Imaana. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Kandi si ibyo byonyine, ndetse dushiimiishwa no kubabazwa ducamo, kuko tuuzi yuuko kubabazwa kuduteera kwihangaana, <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />kandi kwihangaana kugateera ingeso nziiza, ingeso nziiza zikatugeza ku byiringiro, <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />kandi ibyiringiro ntibihemura, kuko urukundo rw'Imaana rwaseesekajwe mu mitima yaacu ku bw'Umwuka Weera twahaawe.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />Ubwo twari tukiri abanyantege nke, Kristo yapfiiriye abanyabyaha, apfa mu gihe Imaana yatooranyije. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Birakomeye ko umuntu apfiira intungaane. Icakora ahari uwakwiyemeza gupfiira umunyangeso nziiza. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Ariko Imaana yo, yatweretse ukuntu idukunda ubwo Kristo yadupfiiraga kandi tukiri abanyabyaha. <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />Kuko dutsindiishirizwa ku bw'amaraso ya Kristo, ni co kimwe azaadukiza n'umujinya w'Imaana ugiiye kuuza. <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />Nyamara twari abanzi b'Imaana, ariko noone twiyunze n'Imaana ku bw'urupfu rw'Umwana waayo. Kandi reero ubwo twiyunze n'Imaana, tuzaakizwa n'ubugingo bwe. <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Ariko si n'ibyo gusa, ahuubwo twishiimira Imaana muri Yesu Kristo Umwami waacu waduheesheje kuuzura na yo.<verse eid="ROM 5:11" /></para>
  <para style="s1">Adamu na Kristo</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Nk'uko icaaha caaje mu isi kizanywe n'umuntu umwe, kandi n'urupfu rukaaza mu isi ruzanywe n'icaaha, ni na ko urupfu rugera ku bantu boose kuko boose baakoze ibyaha. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Amategeko ya Moose ataraatangwa, icaaha caariho mu isi, ariko ntaawe kibarwaho amategeko atariho. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Nyamara urupfu rwari rufite ubushobozi ku bantu uheereye mu gihe ca Adamu ukageza no mu gihe ca Moose, ndetse urupfu rwategekaga n'abo bataakoze icaaha kingaana n'ica Adamu ubwo yasuzuguye itegeko ry'Imaana.</para>
  <para style="p" vid="ROM 5:14">Adamu ni ishusho ihagarariye uwajaga kuuza. <verse eid="ROM 5:14" /><verse number="15" style="v" sid="ROM 5:15" />Ariko abo bombi ntibasa, kuko impaano y'ubuntu bw'Imaana itandukanye n'ico gicumuro, uko igicumuro c'umwe caazaniye abantu benshi urupfu ni na ko ubuntu bw'Imaana n'impaano y'ubuntu bw'umuntu umwe ari we Yesu Kristo yaseesekaye kuri benshi mu bwuzuye. <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Kandi ingaruka y'ubuntu bw'Imaana itandukanye n'ingaruka y'icaaha c'umuntu umwe. Kuko icaaha ca Adamu caazanye guciirwa urubanza rw'iteeka naho ubuntu bw'Imaana butuuzanira gutsindiishirizwa n'ubwo twari twarakoze ibyaha byinshi. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Koko reero, igicumuro c'umuntu umwe ari we Adamu caatumye urupfu rutegeka benshi. Ariko abo baahaawe ubuntu bw'Imaana butarondooreka n'impaano ye y'ubutungaane bazaakomeza gutsinda icaaha n'urupfu babikeesha umuntu umwe ari we Yesu Kristo.<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />Nuuko reero, nk'uko igicumuro c'umuntu umwe ari we Adamu caatumye abantu boose baciirwaho iteeka ni na ko igikorwa c'ubukiraanutsi bw'umuntu umwe ari we Kristo gituma abantu boose batsindiishirizwa bikabaheesha ubugingo busha. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Kandi nk'uko abantu boose baahindutse abanyabyaha ku bwo kutumvira Imaana ku muntu umwe, ni na ko benshi bazaahinduka abakiraanutsi ku bwo kumvira Imaana ku muntu umwe.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />Nyamara ubwo amategeko yaaje, ibyaha byaragwiriye, ariko aho ibyaha byagwiriye, ni ho n'ubuntu bw'Imaana bwarushijeho kwiyongera kuri boose. <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />Nuuko reero nk'uko icaaha caategetse abantu kikabaazanira urupfu, ni na ko ubuntu bw'Imaana butegeka bukaazanira abantu gutungaana, bukabaheesha ubugingo buhoraho muri Yesu Kristo Umwami waacu.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s1">Kurekeraho Gukora icaaha no Kuzuukana na Kristo</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />Mbese noone tuvuge iki? Tugume gukora ibyaha kugira ngo ubuntu bw'Imaana bugwire? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />Ntibikabeho! Mbese niiba twaratandukanye n'imbaraga z'icaaha, twakomeza dute gukora icaaha? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />Ntimuuzi yuuko twese abaabatirijwe kuba umwe na Kristo Yesu, twabatirijwe kuba umwe na we mu rupfu rwe? <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" /><note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="COL 2:12">Kol 2:12</ref>.</char></note>Mu kubatizwa, twahambanywe na we mu rupfu rwe, kugira ngo nk'uko Daata yazuuye Kristo mu baapfuuye ku bw'imbaraga ze, abe ari ko naatwe tugendera mu bugingo busha.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />Ubwo reero twabaaye umwe na we mu gusangira urupfu nk'urwe, ni na ko tuzaaba umwe na we mu kuzuuka nk'uko yazuutse. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />Kandi tumenye neeza ko umutima ukunda gukora icaaha wa keera wabambanywe na Kristo, kugira ngo umubiri w'ibyaha ukuurweho, tureke kuba imbaata z'ibyaha, <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />kuko uwapfuuye aba atagitegekwa n'icaaha. <verse eid="ROM 6:7" /><verse number="8" style="v" sid="ROM 6:8" />Ariko niiba twarapfanye na Kristo, twizeere yuuko tuzaabaanaho na we. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />Tuuzi ko Kristo yazuutse mu baapfuuye akaba atazongera gupfa ukundi, urupfu ntirukimufiteho ububaasha. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Urupfu yapfuuye, yarupfuuye rimwe rizima gutsinda imbaraga z'icaaha, naho ubwo ariho, ariho ku bwo gushiimiisha Imaana. <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />Ni co kimwe, namwe mwiyumvemo ko mwatsinze icaaha, mukaba mubeereyeho gushiimiisha Imaana muri Kristo Yesu.<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />Nuuko reero, icaaha nticongere gutegeka imibiri yaanyu izaapfa, ngo gitume mwumvira ibyo irarikira. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />Kandi ibice by'imibiri yaanyu ntimukabyegurire icaaha ngo bibe intwaro zo gukora ibyaha, ahuubwo mwihe Imaana nk'abazima bavuuye mu rupfu, ibice by'imibiri yaanyu mubyegurire Imaana kugira ngo mubikoreeshe ibyo gukiraanuka. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />Koko reero icaaha ntikikabategeke, kuko mutakigengwa n'amategeko, ahuubwo mugengwa n'ubuntu bw'Imaana.<verse eid="ROM 6:14" /></para>
  <para style="s1">Imbaata zo Gukiraanuka</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />Noone tugire dute? Dukomeze gukora ibyaha kuko tutagengwa n'amategeko, ahuubwo tugengwa n'ubuntu bw'Imaana? Oya ntibikabeho! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />Mbese ntimuuzi yuuko uwo mwiyeguriye mukamubeera imbaata zimwumvira, muri imbaata z'uwo mwumvira uwo? Kuba imbaata z'icaaha biizana urupfu, kandi kumvira Imaana bigaheesha gukiraanuka. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Ariko Imaana ishimwe kuko mwahoze muri imbaata z'icaaha ariko noone mukaba mwarakurikije inyigiisho mwigiishijwe mubikuuye ku mutima. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Mwavuuye ku ngoyi y'ububaata bw'icaaha muhinduka imbaata zo gukiraanuka. <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />Ndavuga nk'umuntu mbiteewe n'intege nke zaanyu za kamere muntu. Ubwo mwari mwareeguriye imibiri yaanyu gukora ibiteeye isoni n'ubugome, abe ari ko mwegurira imibiri yaanyu kuba imbaata zo gukiraanuka kugira ngo mwezwe.<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />Igihe mwari imbaata z'icaaha, ntimwagengwaga no gukiraanuka. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />Mbese byabunguye iki? Ibyo mwakoraga ico gihe ubu bibateera isoni kuko amaheerezo yabyo ari urupfu. <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Ariko ubwo mwabohoowe mu caaha, mukaba mutegekwa n'Imaana, inyungu zaanyu n'ukwezwa mukazaabona ubugingo buhoraho. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Kuko ibihembo by'ibyaha ari urupfu, ariko impaano y'Imaana ni ubugingo buhoraho bubonerwa muri Kristo Yesu Umwami waacu.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s1">Urugero rw'Abaashaakanye</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />Mbese bavandimwe, ntimuuzi yuuko amategeko agenga umuntu igihe coose akiriho gusa? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />Noone reero umugore washingiwe, itegeko rimuhambiira ku mugabo we igihe akiriho, ariko iyo umugabo amaze gupfa, itegeko ryo gushingiranwa ntiriba rikimufiteho ububaasha. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Nuuko reero, iyo umugabo we akiriho akamureka, akaja kwibaanira n'undi mugabo yitwa umusambanyi, ariko iyo umugabo we apfuuye aba abohoowe ku tegeko, ni co gituma ataba umusambanyi iyo acuuwe n'undi mugabo. <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />Namwe reero bavandimwe ico menyeesha ni iki, ntimukigengwa n'amategeko ubwo Kristo yabapfiiriye, kugira ngo mube ab'undi ari we wazuutse mu bapfuuye maze tukazeera imbuto mu guheereza Imaana. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />Ubwo twari tukiri mu caaha, irari ry'ibibi ribyutswa n'amategeko ryaduteeraga kwera imbuto z'urupfu. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />Ariko noone twabohoowe ku mategeko, kuko twapfuuye ku byerekeye itegeko ryari rituboshe. Ni co gituma dukorera Imaana tutagengwa n'inyandiko y' amategeko ishaaje ahuubwo dukorera mu bugingo busha dushobozwa n'Umwuka.<verse eid="ROM 7:6" /></para>
  <para style="s1">Itegeko hamwe n'Icaaha</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />Mbese noone tuvuge iki? Ngo amategeko ni icaaha? Oya ntibikabeho! Ariko sinari kumenya icaaha iyo ntakimenyeeshwa n'amategeko. Iyo itegeko ritavuga riti, “Ntuukifuuze ibintu by'abandi,” sinari kumenya yuuko kwifuuza ari icaaha. <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Ariko icaaha kinyuze mu mategeko, caabyukije muri nje kwifuuza koose, kuko aho amategeko atari icaaha nticaabaho. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />Keera, nanje nari muzima amategeko ataraabaho, aho itegeko ryaziye icaaha kirahembuuka, <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />maze ndapfa. Itegeko ryagenewe kuuzana ubugingo, rinzanira gupfa mu buryo bw'umwuka. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />Koko icaaha ciitwaje itegeko, kiranyosha kiranyiciisha.<verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />Bityo reero, amategeko ni ayeera, ndetse n'itegeko ryose ni iryera, riratunganye kandi ni ryiza. <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />Mbese nooneho ico ciiza kibe caaranzaniye urupfu? Oya ntibikabeho! Ahuubwo icaaha caakoreesheje ikiri iciiza kugira ngo kinzanire guciirwa urubanza rw'urupfu. Mbega ukuntu icaaha ari kibi! Ceerekana ububi bwaco bwose bukabije ciitwaje itegeko.<verse eid="ROM 7:13" /></para>
  <para style="s1">Intambara yo mu Mitima Yaacu</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />Tuuzi neeza yuuko amategeko akomooka ku Maana, ariko ikibazo canje n'uko nkurikiza kamere muntu, nkaba imbaata y'icaaha. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" /><note caller="-" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GAL 5:17">Gal 5:17</ref>.</char></note>Koko reero sinzi ico nkora kuko ico nshaaka gukora si co nkora, ahuubwo ico nanga akaba ari co nkora. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Ubwo reero nkora ico ntashaaka, ndemera yuuko amategeko ari meeza. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Bityo reero si nje ubikora, ahuubwo ni icaaha gituura muri nje. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />Nzi neeza yuuko mu mutima wanje ntaaciiza kindimo ku bwa kamere yanje, kuko mpora nifuuza gukora iciiza ariko kugikora bikaananira. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Kuko iciiza nifuuza si co nkora, ahuubwo ikibi ntashaaka akaba ari co nkora. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Niiba reero ibyo ntifuuza gukora ari byo nkora, si nje ubikora ahuubwo ni icaaha gituuye muri nje.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />Ibyo maze kubona mu buzima ni ibi: Iyo nshaatse gukora iciiza, nsanga nahisemo gukora ikibi. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />Nkunda amategeko y'Imaana n'umutima wanje woose. <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />Ariko mbona irindi tegeko ryo mu ngingo z'umubiri wanje rirwanya itegeko ry'umutima wanje, ku buryo rituma mba imbohe y'itegeko ry'icaaha kiba mu ngingo z'umubiri wanje. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />Yemwe ko mboonye ishano! Ni nde wankiza uyu mubiri unjaana mu rupfu? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />Imaana ishimwe kuko ni yo yankiza muri Yesu Kristo Umwami waacu.</para>
  <para style="p" vid="ROM 7:25">Naho ubundi, nje mu mutima wanje ndi imbaata y'amategeko y'Imaana, ariko muri kamere ndi imbaata y'amategeko y'ibyaha.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s1">Ubuzima Busha mu Mwuka.</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Nuuko reero abari muri Kristo Yesu ntibaciirwaho iteeka. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Kuko itegeko ry'Umwuka w'ubugingo bwo muri Kristo Yesu ryadukuuye mu bubaata bw'itegeko ry'ibyaha n'urupfu. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Ibyo amategeko yananiwe gukora ku bw'intege z'umubiri, Imaana yarabikoze ubwo yohereje Umwana waayo afite ishusho ya kamere y'ibyaha, ngo abe igitambo c'ibyaha byo abandi baakoze maze aciiraho iteeka ibyaha bya kamere. <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />Imaana yakoze ibi, kugira ngo gukiraanuka kuuzanwa n'amategeko gusohozwe muri twe abatagengwa na kamere y'umubiri, ahuubwo bagengwa n'Umwuka. <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />Kuko abo bagengwa na kamere y'umubiri biita ku by'umubiri naho abagengwa n'Umwuka, bo biita ku by'Umwuka. <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Kugengwa na kamere y'umubiri biteera urupfu, ariko kugengwa n'Umwuka biizana ubugingo n'amahoro. <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />Kuko iyo ibiteekerezo by'umuntu bigengwa na kamere y'umubiri, aba ari umwanzi w'Imaana, kuko atumvira amategeko y'Imaana kandi ntanazaabikore. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Kandi burya, abo bagengwa na kamere y'umubiri ntibashobora kuneezeeza Imaana.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />Ariko mwebwe ntimugengwa na kamere muntu, ahuubwo mugengwa n'Umwuka ubwo Umwuka w'Imaana aba muri mwe. Umuntu udafite Umwuka wa Kristo ntaaba ari uwe. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />Ariko niiba Kristo ari muri mwe, nuubwo umubiri uzaapfa ku mpamvu y'icaaha, Umwuka uzaatuma mubaho ku bwo gukiraanuka. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" /><note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 Kor 3:16</ref>.</char></note>Niiba kandi Umwuka w'uwazuuye Yesu mu bapfuuye uba muri mwe, Uwazuuye Kristo Yesu azaazuura n'imibiri yaanyu igenewe gupfa ku bw'Umwuka waayo utuuye muri mwe.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />Nuuko reero bavandimwe, dufite inshingano, ariko atari iyo kubaho nk'uko kamere muntu yaacu ishaaka ngo tubeho. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Kuko nimubaho mugengwa na kamere muntu muzaapfa, ariko niiba Umwuka ubafasha kureka ibikorwa bya kamere muntu muzaabaho. <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />Abo boose bayoborwa n'Umwuka w'Imaana, ni bo baana b'Imaana. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" /><note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="GAL 4:5-7">Gal 4:5-7</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="MRK 14:36">Mar 14:36</ref>; <ref loc="GAL 4:6">Gal 4:6</ref>.</char></note>Kuko mutaahaawe Umwuka w'ububaata ubasubiza mu bwoba, ahuubwo mwakiiriye Umwuka ubahindura abaana b'Imaana bituma mubwira Imaana muti, “Daata, Daata!” <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Umwuka w'Imaana ubwe wemeranya n'umwuka waacu guhamya yuuko turi abaana b'Imaana, <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />kandi ubwo turi abaana baayo, turi n'abaragwa, ndetse turi abaragwa b'ibyo Imaana yaseezeranyije bityo reero turi n'abasangira umurage na Kristo niiba tubaana na we ngo tuzaahabwe ikuzo na we.<verse eid="ROM 8:17" /></para>
  <para style="s1">Ikuzo Dutegereje</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Ndeeba ko kubabazwa ducamo muri iki gihe kudakwiriye kugereranywa n'ikuzo tuzaahishuurirwa. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Ndetse n'ibyaremwe byose bitegerezanya amatsiko ngo bireebe guhishuurwa kw'abaana b'Imaana. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Koko reero ibyaremwe byose biriho nta byiringiro, atari ku bushaake bwabyo, ahuubwo ari ku bushaake bw'uwabikoze. Ariko hariho ibyiringiro <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />yuuko ibyaremwe ubwabyo, umunsi umwe bizaavanwa mu bubaata bw'imbaraga z'urupfu bigasangira umudendeezo w'ikuzo w'abaana b'Imaana. <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />Tuuzi neeza yuuko ibyaremwe byose binihira hamwe, bikanababazwa nk'ibise by'umugore wenda kubyara kugeza na n'ubu. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" /><note caller="-" style="x"><char style="xo" closed="false">8:23 </char><char style="xt" closed="false"><ref loc="2CO 5:2-4">2 Kor 5:2-4</ref>.</char></note>Nyamara si ibyo biremwa byonyine ahuubwo naatwe abaahaawe umuganura w' Umwuka, tunihira mu mitima yaacu dutegereje guhindurwa abaana b'Imaana ari ko gucungurwa kw'imibiri yaacu. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />Twarakijijwe ku bw'ibyiringiro, ariko iyo umaze kureeba ibyo wizeeraga ntibiba bikiri ibyiringiro. Ntaamuntu wakwiringira ico amaze kubona. <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Ariko niiba twiringira kuzaabona ico tutareeba ubu, tugitegereze twihanganye.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Ni co kimwe, n'Umwuka Weera adufasha mu ntege nke zaacu. Kuko tutaazi ibyo twasaba mu gusenga, ariko Umwuka ubwe akadutakambira aniha iminiho irenze imivugire. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Kandi Imaana izi ibiri mu mitima yaacu, izi n'ibyo Umwuka yifuuza, kuko Umwuka asabira abeejejwe nk'uko Imaana ishaaka.<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />Kandi tuuzi ko Imaana ikorera muri byose kuuzanira ibyiza abayikunda, abo yahamagaye nk'uko yabigambiiriye. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Abo Imaana yamenye kuva keera, yanabatooranyirije kumera nk'Umwana waayo, kugira ngo uwo Mwana abe ari we uba imfura muri beene se benshi. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Abo Imaana yatooranyije keera yarabahamagaye, kandi abo yahamagaye yarabatsindiishirije, n'abo yatsindiishirije yabahaaye ikuzo.<verse eid="ROM 8:30" /></para>
  <para style="s1">Urukundo rw'Imaana muri Kristo Yesu</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Mbese ibyo twabivugaho iki? Ubwo Imaana iri kumwe naatwe, ni nde waturwanya? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Ubwo itaatwimye Umwana waayo, ahuubwo ikamudutangira twese, izaabura ite kutugabira ibindi byose hamwe na we? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Ni nde uzaarega abo Imaana yatooranyije? Ntaawe kuko Imaana ari yo ibaha kuba intungaane. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Mbese ni nde wabaciiraho iteeka? Ntaan'umwe kuko ni Yesu Kristo ari we wapfuuye ndetse akazuuka ubu akaba ari iburyo bw'Imaana adutakambira. <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />Ni nde wadutandukanya n'urukundo rwa Kristo? Mbese ni amakuba, cangwa agahinda, cangwa gutootezwa, cangwa inzara, cangwa kwambara ubusa, cangwa kuba mu kaaga, cangwa urupfu? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />Nk'uko ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="ROM 8:36">“Turiicwa umunsi ukiira baduhoora wowe,</para>
  <para style="q2" vid="ROM 8:36">batugirira nk'intaama zaagenewe kubaagwa.”<verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />Ariko muri byose tukarushaho gutsinda, tubikeesha uwadukunze. <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />Koko reero nzi neeza ntashidiikanya yuuko n'ubwo haaba urupfu cangwa ubuzima, cangwa abaamalayika cangwa abategeka, cangwa ibiriho ubu cangwa ibizaaza, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />cangwa ibyo heejuru cangwa iby'ikuzimu, cangwa icaaremwe ico ari co coose, nta na kimwe kizaabaasha kudutandukanya n'urukundo rw'Imaana rubonerwa muri Kristo Yesu Umwami waacu.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s1">Imaana n'Abantu Baayo</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Ndavuga ukuri, ndi uwa Kristo, simbeesha. Umutimanaama wanje urabihamya uyobowe n'Umwuka Weera. <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />Mfite agahinda kenshi n'intimba idatuuza mu mutima wanje. <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />Koko reero nakwifuuje kuba ari nje uvumwa n'Imaana ubwanje, ngatandukana na Kristo mbiiguraana abavandimwe banje duhuuje ubwoko. <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />Ni bo muryango wa Isirayeli Imaana yagize abaana baayo, bagahaabwa ikuzo, n'amaseezerano n'amategeko, no kuyisenga uko ishaaka kandi no kubaha ibyiza yabaseezeranyije. <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />Ba seekuruza ni bo na Kristo akomookaho, ukurikije igiseekuruza c'abantu. Imaana itegeka byose ni ihimbaazwe iteeka ryose, Amiina.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Nyamara si ukuvuga ko Imaana yananiwe gusohoza ibyo yaseezeranye, kuko abakomooka kuri Isirayeli atari ko boose ari Abiisirayeli nyakuri. <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />Kandi abakomooka kuri Aburahamu ku mubiri si ko boose biitwa abaana b'Imaana, keretse abaavuutse ku buryo bw' amaseezerano. Kuko Imaana yabwiye Aburahamu iti, “Kuri Isaaka ni ho urubyaro rwawe ruziitwa abaawe.” <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Ibyo ni ukuvuga yuuko abaana baakomootse kuri Aburahamu ku buryo busanzwe atari bo biitwa abaana b'Imaana ahuubwo abaavuutse ku buryo bw'amaseezerano y'Imaana ni bo beemerwa nk'urubyaro rwe. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Kuko iri ni ryo seezerano Imaana yahaaye Aburahamu iti, “Mu mwaka utaaha, mu gihe nk'iki, nzaagaruka kandi Saara azaaba yarabyaye umwana w'umuhungu.”<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />Si n'ibyo gusa, hari na Rebeka wabyaye abaana babiri, bombi bakaba bafite se umwe ari we Isaaka sogokuruza. <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />Ariko igihe abaana bataraavuuka, bataraanakora iciiza cangwa ikibi, <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />kandi bidaturutse ku bikorwa ahuubwo biturutse kuri yo, Imaana yabwiye Rebeka iti, “Umukuru azaaba umugaragu w'umuto” <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />Nk'uko ibyanditswe bivuga ngo, “Yaakobo naramukunze naho Esawu naramwanze”<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />Noone se twabivugaho iki? Mbese Imaana ntiibeera? Oya ntibikabeho. <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Kuko yabwiye Moose iti, “Nzaagirira imbabazi n'impuhwe uwo nshaatse.” <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />Nuuko reero ibyo ntibiteerwa n'ubushaake bw'umuntu cangwa ku mwete afite, ahuubwo biva ku mbabazi z'Imaana. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Kuko mu byanditswe Imaana yabwiye Faraawo iti, “Dore icaatumye ngushiraho kwari ukugira ngo nzeerekanire muri wowe imbaraga zanje kandi bitume izina ryanje ryamamazwa ku isi hoose.” <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Bityo reero, Imaana ibabarira uwo ishaaka kandi inangira umutima w'uwo ishaaka.<verse eid="ROM 9:18" /></para>
  <para style="s1">Uburaakari bw'Imaana n'Impuhwe Zaayo</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />Mbese noone tuvuge iki, “Ni iki gituma Imaana igaya abantu? Mbese ni nde warwanya ubushaake bw'Imaana?” <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Ariko wowe muntu uri nde kugira ngo ugiishe Imaana impaka? Mbese ikibumba caabaza uwakibumbye ngo, “Kuki wambumbye utya?” <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />Mbese umubumbyi si we ufite ubushobozi bwo gukora mu ibumba rimwe igikoreesho c'agaciiro n'igikoreesho gisanzwe?<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />Ni na ko Imaana ibishaatse yaagaragaza uburaakari bwayo no kwerekana ububaasha bwayo. Nyamara Imaana yihangaaniye abantu baayiteeraga uburaakari ndetse baagenewe kurimbuka. <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />Ibyo yabikoreye kugira ngo igaragaze ukuntu ikuzo ryayo rihebuuje ku bo ishaaka kugirira imbabazi, abo yateguuriye ikuzo uheereye keera. <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />Abo kandi ni twebwe bo Imaana yahamagaye, itadutooranyije mu Bayuuda gusa ahuubwo no mu banyamahanga. <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />Nk'uko Imaana yabivuze mu gitabo ca Hoseya iti,</para>
  <para style="q1" vid="ROM 9:25">“Abaahoze batari ubwoko bwanje</para>
  <para style="q2" vid="ROM 9:25">nzaabiita ‘ubwoko bwanje’,</para>
  <para style="q1" vid="ROM 9:25">utari inkundwakazi</para>
  <para style="q2" vid="ROM 9:25">nzamwita ‘inkundwakazi’.<verse eid="ROM 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26" />Kandi ahantu baabwiriwe ngo ‘ntimuri ubwoko bwanje,’</para>
  <para style="q2" vid="ROM 9:26">ni ho baziitirirwa abaana b'Imaana nzima.”<verse eid="ROM 9:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27" />Yesaaya na we yavuze aranguruye ibifashe kuri Isirayeli ati, “Nuubwo Abiisirayeli bangana n'umuseenyi wo ku nyanja, igice gito kizaaba gisigaye ni co kizaarokoka, <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />kuko Nyagasani atazaatinda guciira urubanza abo ku isi mu buryo bukwiriye.” <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />Kandi nk'uko Yesaaya yahanuuye keera ati, “Iyo Nyagasani Nyiringabo atadusigira urubyaro ruke, tuba twararimbutse nk' i Sodomu, tuba twarabaaye nk' i Gomora.”<verse eid="ROM 9:29" /></para>
  <para style="s1">Isengeesho Pawulo Asabira Abiisirayeli</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />Mbese ibyo twabivugaho iki? Abanyamahanga bataagerageje gushaaka ibyo gukiraanuka baaragushikiiriye, ari ko gukiraanuka guheeshwa no Kwizeera, <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />naho Abiisirayeli baageragezaga gukurikiza amategeko yatuma bakiraanukira Imaana, nyamara ntaabwo baageze ku nteego amategeko yari agamije. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Ni ku mpamvu ki reero? Ni ku mpamvu yuuko uko gukiraanuka bataagukuuraga ku kwizeera Kristo, ahuubwo biiringiraga ko baguheeshwa no gukurikiza ibyo amategeko asaba. Bityo bituma basiitaara kuri rya buye risiitaaza <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />nk'uko byanditswe ngo,</para>
  <para style="q1" vid="ROM 9:33">“Dore nshize muri Siyoni ibuye</para>
  <para style="q2" vid="ROM 9:33">rizaasiitaaza abantu,</para>
  <para style="q2" vid="ROM 9:33">urutare ruzaabaguusha.</para>
  <para style="q1" vid="ROM 9:33">Nyamara uzamwemera weese ntaazaakorwa n'isoni.”<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />Bavandimwe ibyo niifuuriza Abiisirayeli mbikuuye ku mutima kandi mbasabira ku Maana, ni uko baakizwa. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Ndabahamiriza yuuko bafite ishaka ryo gukorera Imaana, ariko ridashingiye ku kuyimenya. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />Kuko ntibaasobaanukiwe ubutungaane buturuka ku Maana, ahuubwo baashaatse gushiraho uburyo bwabo bwo kuba intungaane bityo reero ntibakurikize ubutungaane buva ku Maana. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Kuko kuuza kwa Kristo kwatumye amategeko atagira agaciiro kugira ngo umwizeera weese Imaana imugire intungaane.<verse eid="ROM 10:4" /></para>
  <para style="s1">Agakiza ni aka Boose</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />Moose ubwe yanditse ibyerekeye gutungaanira Imaana bituruka ku mategeko agira ati, “Uzumvira amategeko azaabeeshwaho na yo.” <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Nyamara ico ibyanditswe bivuga ku byerekeye ubutungaane buvuuye ku kwizeera ni iki, “Ntuukiibaze mu mutima waawe uti, ‘Ni nde washobora kuzaamuuka mu ijuru?’ ” Bimenyeesha kumanura Kristo akaaza ku isi. <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />“Cangwa ngo wiibaze uti, ‘Ni nde washobora kumanuka ikuzimu?’ ” Bimenyeesha kuvaana Kristo mu baapfuuye. <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />Ico bivuga ni iki, “Ijambo ry'Imaana rirakwegeereye, riri mu kanwa kaawe no mu mutima waawe.” Ni ryo jambo ryo kwizeera tubwiriza. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />Kuko niwaatura n'akanwa kaawe ko Yesu ari Umwami kandi ukeemera mu mutima waawe ko Imaana yamuzuuye mu baapfuuye uzaakizwa. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Kuko umutima ari wo umuntu yizeeza bigatuma Imaana imugira intungaane naho kubyatura mu kanwa bigatuma akizwa. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />Kuko ibyanditswe bivuga ngo, “Uwizeera Kristo weese ntaazaakorwa n'isoni.” <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />Ibi bifashe kuri buri weese, kuko ntaatandukaniro ry'Umuyuuda n'Umugiriki, boose bafite Umwami umwe kandi ni na we ugirira ubuntu abamwambaza boose. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />Kuko ibyanditswe biravuga ngo, “Umuntu weese uzambaza izina rya Nyagasani azaakizwa”<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />Ariko se bamwambaza bate batabanje kumwemera? Kandi bamwemera bate bataariigeze ku mwumva? Mbese bamwumva bate hatabonetse umuntu wo kumwamamaza? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Ikindi kandi, abantu bamwamamaza bate ntaawe ubatumye? Ni co gituma ibyanditswe bigira biti, “Mbeega ukuntu ari byiza kureeba ibirenge by'abaazanye Inkuru Nziiza!” <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" />Nyamara si boose bumviye Inkuru Nziiza. Nk'uko Yesaaya yavuze ati, “Nyagasani, ni nde wumviye ubutumwa bwacu ?” <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />Bityo reero, ugira kwizeera umaze kumva ubutumwa, kandi ubwo butumwa ni ukubwirwa ijambo rya Kristo.<verse eid="ROM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18" />Ariko noone ndabaza nti, “Mbese abantu ntibumviise ubwo butumwa? Yee, ni koko baarabwumviise.” Kuko ibyanditswe biravuga ngo,</para>
  <para style="q1" vid="ROM 10:18">“Ijwi ryabo ryakwiye ku isi yoose,</para>
  <para style="q2" vid="ROM 10:18">ubutumwa bwageze ku mpera z'isi.”<verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />Reka nongere mbaze nti, mbese Abiisirayeli ntibaabisobaanukiwe? Moose ni we wabanje kuvuga ati,</para>
  <para style="q1" vid="ROM 10:19">“Nzaabaharika abanyamahanga,</para>
  <para style="q2" vid="ROM 10:19">batume mugira ishari.</para>
  <para style="q1" vid="ROM 10:19">Nzaakoreesha ubwoko bw'abanyabwenge buke,</para>
  <para style="q2" vid="ROM 10:19">bitume abantu banje baraakara.”<verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />Kandi na Yesaaya yabivuze yeruye ati,</para>
  <para style="q1" vid="ROM 10:20">“Abataaranshaakaga baramboonye,</para>
  <para style="q2" vid="ROM 10:20">niigaragarije abataariigeze bambaririza.”<verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />Ariko ku byerekeye Abiisirayeli Yesaaya arababwira ati, “Niirije umunsi woose nteze amaboko ngo naakiire ubwoko butumvira kandi bwigometse.”<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s1">Imbabazi z'Imaana ku b'Isirayeli</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="PHP 3:5">Fil 3:5</ref>.</char>
    </note>Nooneho reka mbaze, mbese Imaana yaaba yaranze abantu baayo? Oya! Ntibishoboka! Kuko nanje ubwanje ndi Umwisirayeli ukomooka mu rubyaro rwa Aburahamu, wo mu muryango wa Benjamiini. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />Imaana ntiyanze abantu baayo yiitooranyirije kuva keera. Mbese ntimuuzi ico ibyanditswe bivuga uburyo Eliya yiitotombye ubwo yaregaga Abiisirayeli ku Maana? Yaravuze ati, <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />“Nyagasani, biishe abahanuuzi baawe nuuko basenya intambiro zaawe, ni nje njenyine usigaye kandi dore nanje barampiiga ngo banyice.” <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />Mbese Imaana yamushubije iki? Yaramushubije iti, “Niisigarije abantu ibihumbi birindwi bataraapfukama ngo baramye ikigirwamaana Baali.” <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />No muri iki gihe hari agace gato k'abantu basigaye abo Imaana yitooranyirije ku bw'ubuntu bwayo. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Imaana yabahisemo ku bw'ubuntu yabagiriye itabiteewe n'ibikorwa byabo. Kuko bitabaaye bityo ubuntu igira bwaba butakiri ubuntu nyakuri.<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />Noone tuvuge iki? Ico Abiisirayeli baashaakaaga ntaabwo baakiboonye, ahuubwo abaakiboonye ni agatsiko gato ko Imaana yiitooranyirije naho abandi boose Imaana yanangiye imitima yaabo. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />Nk'uko byanditswe ngo, “Imaana yatumye imitima yaabo n'ibiteekerezo byabo bibura ubwenge, n'amaaso yaabo atabona n'amatwi atumva kugeza n'aya magingo.” <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />Na Dawudi aravuga ati,</para>
  <para style="q1" vid="ROM 11:9">“Reka amafunguro yaabo ababeere nk'umutego,</para>
  <para style="q2" vid="ROM 11:9">bibabeere nk'ibuye ryo kubasiitaaza n'igihano kibakwiriye.<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />Reka amaaso yaabo ahume beekureeba,</para>
  <para style="q2" vid="ROM 11:10">uteeze imigongo yaabo guhora ihetamye iteeka ryose.”<verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Nuuko reero ndabaza nti, mbese ubwo Abiisirayeli baasiitaaraga kwari ukugwa buheriheri? Oya! Ntibikabeho! Kuko gucumura kwabo kwatumye agakiza kagera ku banyamahanga, kugira ngo biteere Abiisirayeli ishari. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Niiba kugwa kw'Abisirayeli kwaratumye abari mu isi baheeshwa umugisha, gucoogora kwabo kukaazanira abanyamahanga ubutunzi, mbese noone ntibizaarushaho Abayuuda boose nibiizeera bagakizwa?<verse eid="ROM 11:12" /></para>
  <para style="s1">Agakiza Kagera ku Banyamahanga</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />Ariko ndababwira mwebwe abanyamahanga. Ni nje ntumwa Kristo yatumye ku banyamahanga, kandi niiraatiisha umurimo nahaawe <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />kugira ngo nteeze ishari beene waacu b'Abiisirayeli kandi mbone uko ndokora bamwe muri bo. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Koko reero niiba kwangwa kw'Abiisirayeli kwaraheesheje abari mu isi kwiyunga n'Imaana, mbese kwemerwa kwabo kuzaazana iki? Kuzaazanira ubuzima abaapfuuye.<verse eid="ROM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16" />Niiba igisate c'umugaati bagituura Imaana nk'umuganura, byerekana yuuko uwo mugaati woose na wo ari uwaayo. Kandi niiba imizi y'igiti yeejejwe, n'amashami yaaco aba yeejejwe. <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />Mwebwe abanyamahanga mumeze nk'amashami y'igiti ca elayo co mu ishamba yagemetswe ku giti ca Elayo giteewe. Mwagiiye mu mwanya w'ayo mashami yagikonzweho. No ku bw'iyo mpamvu, musangiye iyo migisha iva mu kuba igice c'igiti caateewe. <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />Nuuko reero ntuukiishire heejuru wiiraata kuri ya mashami. Wiibuke ko atari wowe ushigikiye imizi, ahuubwo imizi ni yo igushigikiye.<verse eid="ROM 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19" />Ahaari wavuga uti, “Amashami yarakonzwe kugira ngo mbone uko nteerwa ku giti.” <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />Yee ni ukuri. Ico ayo mashami yazize ni ukuteemera. Naho wowe ikiguhagaritse ni ukwizeera Kristo kwawe. Nuuko reero ntukiraate, ahuubwo utinye Imaana. <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />Kuko ubwo Imaana itaababariye abaagereranyijwe n'amashami ya kavuukire, naawe ntiizaakubabarira. <verse eid="ROM 11:21" /><verse number="22" style="v" sid="ROM 11:22" />Hano tureeba kugira neeza kw'Imaana kandi n'uburaakari bwayo, abanze kuyumvira yarabaraakariye naho wowe wayumviye ikugirira neeza kandi izaakomeza kukugirira neeza nuuguma mu buntu bwayo. Ariko nuuteeshuka, naawe uzaakondwa nka ya mashami. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Naho Abayuuda nibareka kuteemera kwabo, bazaaba nk'amashami yakonzwe akagemekwa aho yahoze mbere. Kuko Imaana ifite ububaasha bwo kongera kubagemeka aho baahoze. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />Mwebwe abanyamahanga mumeze nk'ishami kamere ryavuuye ku giti ca elayo co mu ishamba ryahaguwe haanyuma ku buryo bunyuranye n'imihingire idasanzwe y'ibiti, uteerwa ku giti ca elayo caateewe mu buryo bwiza. Mbese Abayuuda ko ari bo mashami ya kamere y'ico giti ca elayo caateewe mu buryo bwiza hari icaababuza guteerwa ku giti caabo ca elayo?<verse eid="ROM 11:24" /></para>
  <para style="s">Imbabazi z'Imaana ku Bantu Boose</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />Bavandimwe, sinshaaka ko mutamenya iri banga hato mukitwara nk'aho muri abanyabwenge. Ico menyeesha ni uko bamwe mu Bisirayeli biinangiiye imitima. Ibyo bizaakomeza kugeza igihe umubare w' abanyamahanga bizeera Kristo ushitse. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />Ni bwo umuryango woose wa Isirayeli uzaakizwa, nk'uko ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="ROM 11:26">“Umukiza azaaturuka i Siyoni</para>
  <para style="q2" vid="ROM 11:26">akuureho kugomera Imaana koose mu bakomooka kuri Yaakobo.<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />Iri ni ryo seezerano nzaagirana na bo,</para>
  <para style="q2" vid="ROM 11:27">ubwo nzaabakuuraho ibyaha byabo.”<verse eid="ROM 11:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ROM 11:28" />Ku byerekeye Ubutumwa Bwiza, Abayuuda baabaaye abanzi b'Imaana ku bwanyu mwe banyamahanga. Ariko ku byerekeye gutooranya kw'Imaana, ni abatoni baayo ku bwa ba seekuruza. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />Kuko Imaana ntiyiisubiza ibyo yatanze, cangwa ngo yiivuguruze iyo yatooranyije. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />Nk'uko mwebwe abanyamahanga keera mwagomeraga Imaana, noone ubu yabagiriye imbabazi biteewe n'uko Abayuuda banze kumvira. <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />Bityo nabo ubu banze kumvira Imaana kugira ngo, imbabazi mwagiriwe, na bo zibaheeshe kubabarirwa. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Imaana yeemereye abantu boose kuba imbohe zo kutayumvira, kugira ngo ibabarire boose.<verse eid="ROM 11:32" /></para>
  <para style="s1">Gushiima Imaana</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />Mbeega uburyo ubutunzi n'ubwenge n'ubumenyi bw'Imaana burenze urugero! Imigambi yaayo ni amayobera kandi imigenzereze yaayo ntaawayimenya. <verse eid="ROM 11:33" /><verse number="34" style="v" sid="ROM 11:34" />Ibyanditswe biravuga biti,</para>
  <para style="q1" vid="ROM 11:34">“Ni nde wamenya ibyo Nyagasani ateekereza?</para>
  <para style="q2" vid="ROM 11:34">Ni nde wamubeereye umujaanaama?<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />Ni nde wiigeze abanza kugira ico amuha,</para>
  <para style="q2" vid="ROM 11:35">kugira ngo na we azaabimwituure?”<verse eid="ROM 11:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ROM 11:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:36 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 8:6">1 Kor 8:6</ref>.</char>
    </note>Kuko byose bikomooka ku Maana, ni yo ibeeshaho ibyo yaremye byose kandi byose byagenewe kuba ibyayo. Icuubahiro kibe ic'Imaana iteeka ryose! Amiina.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s1">Ubugingo Busha Buteera Gukorera Imaana</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Noone reero bavandimwe, ndabiihanangiriza ku bw' imbabazi z'Imaana yatugiriye, ngo mwitange maze mube ibitambo bizima byeguriwe Imaana kandi biyishiimiisha. Ubu ni bwo buryo bukwiriye bwo kuramyamo Imaana. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />Ntimukiigaane imyifatire y'ab'iki gihe turimo, ahuubwo muhinduke by'ukuri, Imaana ivugurure ibiteekerezo byanyu. Ni bwo muzaashobora kumenya ibyo Imaana ishaaka ari byo byiza biyishiimishije kandi bitunganye rwose.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Ku bw'ubuntu Imaana yangiriye, ndabwira buri umwe muri mwe kutiiteekerezaho birenze urugero muriho. Ahuubwo mukoreeshe ukuri mu gihe mwiteekerezaho mukurikije urugero Imaana yabahaaye rwo Kwizeera. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" /><note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="1CO 12:12">1 Kor 12:12</ref>.</char></note>Kuko dufite ingingo nyinshi mu mubiri umwe kandi izo ngingo ntizigira umurimo umwe. <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />Ni co kimwe, nuubwo turi benshi, turi umubiri umwe muri Kristo, twese duhuurijwe hamwe, buri muntu akaba urugingo rwa mugenzi we. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" /><note caller="-" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="1CO 12:4-11">1 Kor 12:4-11</ref>.</char></note>Dufite impaano zitandukanye hakurikijwe ubuntu Imaana yatugiriye. Niiba twarahaawe impaano yo guhanuura, tuje duhanuura dukurikije ukwizeera dufite. <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />Niiba twarahaawe impaano yo guheereza abandi ngaaho ni tubikore, niiba twarahaawe impaano yo kwigiisha, nitwigiishe, <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />niiba twarahaawe impaano yo gukomeza abandi, tubakomeze, utanga, naatange ntaakindi akurikiye, uyobora abandi naabikorane umwete kandi ugira imbabazi naazigire yishiimye.<verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Muje mukundana mutaryarya, mwange ibibi urunuuka, mwibande ku byiza. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />Mukundane urukundo rwa kivandimwe, mwubahane, buri umwe ashire imbere mugenzi we. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />Mwekuba abanebwe, ahuubwo mukorere Nyagasani mufite ishaka ryinshi. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />Mwishiimire ibyo mwiringiye, mwihangaane mu makuba kandi musenge igihe coose. <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />Bagenzi baanyu b'abakristo bakennye, mubafashiishe ku byo mufite, abantu baaje muri mwe ari basha mubacumbikire.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:44">Mat 5:44</ref>; <ref loc="LUK 6:28">Luk 6:28</ref>.</char>
    </note>Musabire umugisha ababatooteza, koko mubasabire umugisha atari umuvumo. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />Mwishiimane n'abiishiima, murirane n'abarira. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />Muje mubaana amahoro n'abantu boose, ntimukiishire heejuru uko bidakwiriye ahuubwo mwemere gufatanya n'abaciiye bugufi. Ntimukiigire abanyabwenge.<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />Ntimukiituure umuntu inaabi yabagiriye. Muharanire gukora ibigaragarira abantu boose ko ari byiza. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />Uko bishoboka koose, ku rwanyu ruhande, mubaane amahoro n'abantu boose. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />Nshuti zanje, ntimukiihoorere ahuubwo muje mureka Imaana ibikore mu buraakari bwayo. Kuko ibyanditswe bivuga ngo, “Guhoora no kwituura ni ibyanje, ni ko Uhoraho avuga.” <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />Ahandi mu byanditswe haravuga ngo, “Umwanzi waawe naasonza umuhe ico kurya, naagira imyota umuhe ico kunywa, kuko nuukora utyo bizaatuma akorwa n'isoni.” <verse eid="ROM 12:20" /><verse number="21" style="v" sid="ROM 12:21" />Ntuukeemere ko ikibi kigutsinda, ahuubwo utsinde ikibi ukoreesheje iciiza.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s1">Inshingano yo Kumvira Abategetsi</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Umuntu weese akwiriye kumvira abategetsi, kuko ntaabutegetsi bubaho budaturutse ku Maana, n'abategetsi bariho baashizweho n'Imaana. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />Ni co gituma ugomeye abategetsi aba agomeye ico Imaana yategetse kandi abakora batyo bazaaciirwa urubanza. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />Abategetsi si abo gutinywa n'abakora neeza, ahuubwo ni abakora naabi babatiinya. Mbese ushaaka kudatiinya umutegetsi? Uje ukora neeza ni bwo bazaagushiima. <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />Kuko abategetsi ni abagaragu b'Imaana baashiriweho kugira ngo ugere ku ciiza. Ariko nuukora naabi ugomba kumutiinya kuko ububaasha afite bwo guhana ntiyabuheerewe ubusa. Ni abagaragu b'Imaana baashiriweho guhana inkozi z'ibibi bagaragaza uburaakari bw'Imaana. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Ni yo mpamvu ukwiriye kumvira abategetsi, bidateewe no gutiinya guhanwa n'Imaana, ahuubwo ubyemejwe n'umutimanaama.<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:6 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:21">Mat 22:21</ref>; <ref loc="MRK 12:17">Mar 12:17</ref>; <ref loc="LUK 20:25">Luk 20:25</ref>.</char>
    </note>Ni co gituma mukwiriye gutanga imisoro, kuko abasoreesha ari abakozi Imaana yashizeho biitangiye gukora uwo murimo. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Muje muha buri muntu ikimugenewe. Usoreesha mumusorere, abasaba ubusuura mububahe, abakwiriye kubahwa mubuubahe.<verse eid="ROM 13:7" /></para>
  <para style="s1">Ibyo Dukwiriye Gukorerana</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Ntihakagire umuntu weese mubamo umwenda keretse uwo gukundana, kuko ukunda mugenzi we aba yumviye amategeko. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />Kuko amategeko avuga ngo, “Ntuugasambane, ntuukiice, ntuukiibe, ntuukiifuuze ibintu by'abandi batunze”. Hamwe n'ayandi mategeko yoose, akubiye muri iri jambo ngo, “Ukunde mugenzi waawe nk'uko wikunda.” <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Niiba ukunda mugenzi waawe ntiwamugirira naabi, nuuko reero gukunda ni ko kumvira amategeko mu bwuzuye.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />Muje mukora mutyo reero kuko muzi igihe turimo, turi mu gihe co gukanguka mu bitotsi. Dore agakiza kaacu karatwegeereye kuruta igihe twatangiraga kwizeera Kristo. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />Ijoro rirakuze, bugiiye guca. Nuuko reero tureke ibikorwa by'umwijima, twambare intwaro z'umuco. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />Twifate neeza, nk'abagendera mu muco, tutarangwaho kuraara inkeera no gusinda, ubusambanyi, ubwomanzi, intonganya n'ishari. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />Ahuubwo mwambare Nyagasani Yesu Kristo ababe haafi nk'umwambaro, kandi ntimukiishinge kamere y'imibiri yaanyu ngo ibakoreeshe ibyo irarikira.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s1">Ntuugaciire Mugenzi Waawe Urubanza</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:1 </char>
      <char style="xt" closed="false">
        <ref loc="COL 2:16">Kol 2:16</ref>.</char>
    </note>Muje mwakiira umunyantege nke mu kwizeera, mwekumugiisha impaka ku byo yiibwira bitandukanye n'ibyanyu. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Bamwe beemera yuuko bakwiriye kurya ibyokurya byose naho abafite intege nke bakiiriira imboga gusa. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />Urya byose yeegusuuzugura urobaanura, kandi urobaanura yeeguciira urubanza urya byose kuko na we Imaana yaramwakiiriye. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />Uri nde wowe uciira umugaragu w'undi urubanza? Ni sheebuja waahitamo niiba akora neeza cangwa naabi. Kandi azaakora neeza kuko sheebuja, ari we Nyagasani, afite ububaasha bwo kumushigikira agakora neeza.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />Abantu bamwe buubaha umunsi umwe bakawurutiisha indi, naho abandi bagasanga iminsi yoose ari kimwe. Umuntu weese agomba gukurikiza ico umutima we umubwira. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Umuntu wuubahiriza umunsi umwe akawurutiisha indi, abikorerera kuubahiisha Nyagasani. N'urya byose abikorera kuubahiisha Nyagasani kuko abishiimira Imaana. Umuntu urobaanura ibyo arya na we aba abikorera kubahiisha Nyagasani kandi agashiimira Imaana. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />Koko reero ntaamuntu n'umwe muri twe ubaho ku bwe, cangwa ngo apfe ku bwe. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />Niiba turiho, turiho ku bwa Nyagasani, kandi niiba dupfa, dupfa ku bwa Nyagasani. Bityo reero twabaho cangwa dupfuuye, turi aba Nyagasani. <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />Ni co caatumye Kristo apfa akazuuka kugira ngo abe Umwami w'abazima n'abaapfuuye. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" /><note caller="-" style="x"><char style="xo" closed="false">14:10 </char><char style="xt" closed="false"><ref loc="2CO 5:10">2 Kor 5:10</ref>.</char></note>Mbese ni iki gituma uciira umuvandimwe waawe urubanza? Kandi ni iki gituma usuuzugura umuvandimwe waawe? Tumenye ko twese tuziitaba imbere y'intebe y'Imaana iduciira urubanza. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />Kuko ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="ROM 14:11">“Uhoraho aravuga ati, ‘Ndarahiye,</para>
  <para style="q2" vid="ROM 14:11">buri muntu azamfukamira,</para>
  <para style="q2" vid="ROM 14:11">kandi indimi zoose zizaatura zihimbaaza ko ari nje Maana.’ ”<verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />Nuuko reero buri muntu weese azaamurikira Imaana ibyo yakoze.<verse eid="ROM 14:12" /></para>
  <para style="s1">Kudasiitaaza Mugenzi Wawe</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Nuuko reero ntitukongere guciirirana imanza, ahuubwo duhitemo kudakora icaasiitaaza mugenzi waawe cangwa ngo kimuguushe mu caaha. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />Ico nzi neeza kandi ntashidiikanya muri Nyagasani Yesu, ni uko ari ntaakintu kiriho caahumaanya umuntu ubwaco. Ariko uwaateekereza ko ikintu gihumaanya koko kiba kimuhumaanyije. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Niiba umuvandimwe waawe ateerwa agahinda n'ibyo uriiye, ntuuba ukigengwa n'urukundo. Wiirinde udatuma ibyo urya bibeera umuvandimwe waawe ibyo kumurimbura, kandi Kristo yaramupfiiriye. <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Ikibabeereye ciiza ntikikavugwe n'abandi bantu nk'ikibi. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Kuko Ubwami bw'Imaana atari ukurya no kunywa, ahuubwo n'imikorere irangwa no gukiraanuka, amahoro, n'ibyishiimo duheeshwa n'Umwuka Weera. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Ukorera Kristo atyo, ashiimiisha Imaana kandi akeemerwa n'abantu.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />Nuuko reero duharanire gukora ibiheesha amahoro n'ibyo gukomeza bagenzi baacu. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />Ntuugasenye umurimo w'Imaana ubiteewe n'ibyokurya. Ntaabyokurya bihumaanya, ariko ikibi ni uko umuntu yarya icaatuma undi agwa mu caaha. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />Ni byiza kutarya inyama cangwa kutanywa divaayi, cangwa kudakora ikindi kintu coose caasiitaaza umuvandimwe waawe. <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />Imyemerere yaawe kuri ibyo ibe hagati yaawe n'Imaana. Hahiirwa umuntu utiiciira urubanza ku byo yeemeye gukora. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />Ariko umuntu weese urya ashidiikanya aba yiiciiriye urubanza, kuko aba ariiye ibinyuranye n'ibyo umutima we umwemeza. Kandi igikorwa coose kinyuranye n'ico umutima ukwemeza kiba ari icaaha.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s1">Kuneezeeza Abandi Atari Ukwineezeeza</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />Twebwe abakomeye mu kwizeera tugomba kwihangaanira abafite intege nke mu kwizeera, ntitwineezeeze ubwacu. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />Buri muntu muri twe aneezeeze mugenzi we, ashaake ibyiza bimugirira akamaro bikamwubaka mu kwizeera. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Kuko na Kristo ubwe ntiyiishaakiye ibimuneezeeza, ahuubwo byamubeereye nk'uko ibyanditswe bivuga biti, “Ibitutsi baagututse ni nje byahamye.” <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />Ibyanditswe mbere byose byandikiwe kutwigiisha kugira ngo kwihangaana no guhuumurizwa dukuura muri byo biduheeshe kwiringira ibizaaba. <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />Nuuko Imaana ari yo sooko yo kwihangaana no guhuumuriza, ibahe guhuuza imitima mukurikije urugero rwa Kristo Yesu, <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />kugira ngo mwese hamwe no mu ijwi rimwe muheeshe ikuzo Imaana Se w'Umwami waacu Yesu Kristo.<verse eid="ROM 15:6" /></para>
  <para style="s1">Inkuru Nziiza ku Bantu Boose</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Nuuko reero buri muntu aje yaakiira mugenzi we nk'uko na Kristo ubwe yabaakiiriye kugira ngo biheeshe Imaana icuubahiro. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Ndababwira yuuko Kristo yabaaye umuheereza w'Abayuuda, kugira ngo yeerekane ubudahemuka bw'Imaana, mu gusohoza amaseezerano yagiriye ba seekuruza. <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />Kwari ukugira ngo abanyamahanga baheeshe Imaana icuubahiro ku bw'imbabazi yabagiriye. Nk'uko ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="ROM 15:9">“Nzaagusingiza mu banyamahanga,</para>
  <para style="q2" vid="ROM 15:9">kandi nzaakuririmbira indirimbo z'ishimwe.”<verse eid="ROM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />Kandi ngo,</para>
  <para style="q1" vid="ROM 15:10">“Mwa banyamahanga mwese mwe, nimwishiimane n'abantu baayo.”<verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />Kandi ngo,</para>
  <para style="q1" vid="ROM 15:11">“Mwa banyamahanga mwese mwe, nimusingize Nyagasani,</para>
  <para style="q2" vid="ROM 15:11">abantu b'amooko yoose nibamusingize!”<verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />Yesaaya na we yarabisongeye ati,</para>
  <para style="q1" vid="ROM 15:12">“Umuntu ukomooka mu muryango wa Yese azaaza,</para>
  <para style="q2" vid="ROM 15:12">azaaza gutegeka abanyamahanga,</para>
  <para style="q2" vid="ROM 15:12">ni we abanyamahanga baziiringira.”<verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Imaana nyir'ibyiringiro ibuuzuzemo ibyishiimo n'amahoro muheeshwa no kwemera, kugira ngo mubone kwiringira ku bw'imbaraga z'Umwuka Weera.<verse eid="ROM 15:13" /></para>
  <para style="s1">Impamvu Pawulo Yanditse Ashize Amanga</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />Bavandimwe, njeewe ubwanje ndeemezwa ko mwebwe ubwanyu mwuzuye kugira neeza, mwuzuye ubumenyi bwose kandi ko mushobora no kwigiishanya. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Icakora hamwe na hamwe muri uru rwandiko nanditse nshize amanga mbiibutsa ku bw'ubuntu bw'Imaana nahaawe, <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />bwo kuba umukozi wa Yesu Kristo mu banyamahanga nk'umuheerezabitambo watumwe kubwiriza Ubutumwa Bwiza bw'Imaana, kugira ngo abo banyamahanga babone uko baaba ituuro ryemerwa n'Imaana kandi ryejejwe n'Umwuka Weera. <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />Ni yo mpamvu reero niiraata mu murimo nkorera Imaana mbishobojwe no kuba muri Yesu Kristo. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Ni ukuri sinaatinyuka kugira ico mvuga uretse ibyo Kristo yankoreesheje ngo abanyamahanga bumvire Imaana. Yabikoze mu magambo yanje ndetse no mu bikorwa byanje, <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />mu mbaraga z'ibimenyeetso n'ibitangaaza kandi no mu mbaraga z'Umwuka w'Imaana. Bityo reero kuva i Yerusaalemu ukiitooroora ukagera muri Iluriko, nahaamamaje Ubutumwa Bwiza bwa Kristo. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />Inteego naharaniye kwari ukwamamaza Ubutumwa Bwiza mu bice byo izina rya Kristo ritaari ryakamenyekanyemo, kugira ngo ntuubaka ku rufatiro rwashizweho n'undi. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />Nk'uko ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="ROM 15:21">“Abataariigeze babwirwa ibye bazaabimenya,</para>
  <para style="q2" vid="ROM 15:21">abataariigeze bamwumva bazaamusobaanukirwa.”<verse eid="ROM 15:21" /></para>
  <para style="s1">Imigambi ya Pawulo yo Kuja i Rooma</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:22 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 1:13">Rom 1:13</ref>.</char>
    </note>Ku bw'umurimo wo ku bwiriza muri ibyo bice, ni yo mpamvu yambujije kenshi kuuza iwaanyu. <verse eid="ROM 15:22" /><verse number="23" style="v" sid="ROM 15:23" />Ariko noone ubwo ndangije umurimo nari mfite mu bice by'ino, nkaba kandi nariifuuje igihe kireekire kuuza iwaanyu, <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />nooneho, ubwo nzaaba nja muri Sipaniya, niiringira ko nzaabanyuraho nkabasuura, kandi namwe mukampa impamba mu rugendo maze kuneezeezwa no kubazindukira akaanya gato. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" /><note caller="-" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="1CO 16:1-4">1 Kor 16:1-4</ref>.</char></note>Icakora, ubu ngiiye i Yerusaalemu njaaniye abeemera baaho ubufasha. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Kuko amatoorero y'i Makedooniya na Akaya biiyemeje gusorooza imfashanyo zo gufashiisha abakene bo mu beemera b'i Yerusaalemu. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" /><note caller="-" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="1CO 9:11">1 Kor 9:11</ref>.</char></note>Biishiimiye kubikora, kandi koko baari bafite umwenda wo kubikora. Byari bikwiriye, kuko ubwo Abayuuda basangiye n'abanyamahanga imigisha iva ku Mwuka w'Imaana, na bo bafite umwenda wo gusangira na bo ibyiza imibiri yaabo ikeneye. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />Ubwo nzaaba maze kubashikiriza ibyo baashorooje byose, nzaavayo nyure iwaanyu nje i Sipaniya. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />Kandi nzi yuuko ninza kubasuura nzaabaazanira umugisha ugwiriye wa Kristo.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />Bavandimwe, ndabiihanangiririza ku bwa Nyagasani Yesu Kristo n'urukundo ruva ku Mwuka w'Imaana ngo mumfashe mu masengeesho munsabira ku Maana. <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />Munsengere, Imaana indinde abo muri Yudeeya batiizeera kandi n'imfashanyo njaanye i Yerusaalemu yakiirwe neeza n'abantu b'Imaana. <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />Bityo reero nzaashobore kuuza iwaanyu mfite umuneezeero maze Imaana niibishaaka mbone kuruhuuka turi kumwe. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Imaana ari yo sooko y'amahoro, ibaane namwe mwese! Amiina.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s1">Intaasho</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Mbashiimiye Foyibe mushiki waacu ari we Mudiyakonikazi w'itoorero ry'i Kenkireya, <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />kugira ngo mumwakiire muri Nyagasani nk'uko bikwiriye abeera kandi mumufashe mu byo azaaba akeneye byose. Erega na we yafashije abantu benshi nanje mbarimo.<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:3 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">Iby 18:2</ref>.</char>
    </note>Muntaahirize Purisikila n'umugabo we Akwila, abakozi bagenzi banje twakoranye umurimo wa Kristo Yesu. <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />Abo biiyemeje no gupfa kugira ngo bakize ubuzima bwanje. Si nje njenyine ubashiima ahuubwo n'amatoorero yoose yo mu banyamahanga. <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />Mutaashe n'itoorero rya Kristo riteeranira mu rugo rwabo.</para>
  <para style="p" vid="ROM 16:5">Muntaahirize n'inshuti yanje nkunda Epayineto ari we wabanjirije abo muri Asiya boose kwemera Kristo. <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />Mutaashe Mariya wabakoreye caane abavunikira. <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />Muntaahirize na Andironiko na Yuniya abavandimwe dusangiye ubwoko twari dusibwe hamwe mu gihome, intumwa zirabaazi neeza kandi beemeye Kristo mbere yanje.<verse eid="ROM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8" />Muntaahirize Ampuliyato inshuti yanje nkunda mu Mwami. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />Muntaahirize na Urubano umukozi mugenzi waacu dufatanyije umurimo dukorera Kristo, hamwe na Sitaku inshuti yanje nkunda. <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />Mutaashe na Apele, wemewe muri Kristo. Muntaahirize abo mu muryango wa Arisitobulo. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />Muntaahirize Herodiyoni umuvandimwe duhuuje ubwoko. Muntaahirize abeemera Kristo bo mu muryango wa Nakisu.<verse eid="ROM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12" />Muntaahirize Tirufayina na Tirufoosa abakora imirimo mu Mwami waacu. Muntaahirize Perusi ukundwa, wakoreye Nyagasani abishizeho umwete. <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" /><note caller="-" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="MRK 15:21">Mar 15:21</ref>.</char></note>Muntaahirize Rufosi umukozi uhebuuje watooranyijwe gukora umurimo w'Umwami, na nyina wambeereye umubyeyi. <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />Muntaahirize na Asunkurito na Fulegooni na Herumaasi, na Patirooba n'abavandimwe bari kumwe na bo. <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />Muntaahirize na Filoloogo na Yuliya, na Nereyi na mushiki we, na Olumpa n'abeera boose bari hamwe na bo.<verse eid="ROM 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 16:16" />Muramukanye kandi muhooberane mu buryo bwera. Amatoorero ya Kristo yoose arabataasha.<verse eid="ROM 16:16" /></para>
  <para style="s1">Amabwiriza Aheruuka</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />Bavandimwe, ndabiihanangirije ngo mwirinde abaazana amacaakubiri kandi baguusha abantu bakava mu kwemera, bakanyuranya inyigiisho mwahaawe. Abameze batyo mubiirinde! <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />Abantu nk'abo ntibakorera Kristo Umwami waacu, ahuubwo bakorera inda zaabo. Bakoreesha amagambo yo kuryosharyosha kandi y'uburyarya bakayobya abafite imitima yooroshe. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />Ukumvira Imaana kwanyu kwamamaye mu bantu boose biraaneezeeza. Ariko ico mbifuuriza ni uko muba abahanga mu gukora ibyiza kandi mukiirinda gukora ikibi. <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />Imaana ari yo sooko y'amahoro izaajanjagurira Sataani munsi y'ibirenge byanyu.</para>
  <para style="p" vid="ROM 16:20">Ubuntu bw'Umwami waacu Yesu Kristo bubaane namwe.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:21 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:1">Iby 16:1</ref>.</char>
    </note>Timoteeyo dukorana umurimo w'Imaana arabataasha, na beene waacu duhuuje ubwoko ari bo, Lukiyosi, Yasoni na Sosipateri na bo barabataasha.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />Nanje Terutiyo wanditse uru rwandiko ndabataasha muri Nyagasani.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:23 a </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">Iby 19:29</ref>; <ref loc="1CO 1:14">1 Kor 1:14</ref>; </char>
      <char style="xo" closed="false">b </char>
      <char style="xt" closed="false">
        <ref loc="2TI 4:20">2 Tim 4:20</ref>.</char>
    </note>Gaayo unshumbikiye hamwe n'abeemera bari mu itoorero riteeranira mu rugo rwe barabataasha. <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />Erasito umubiitsi w'isente w'itawuni nkuru n'umuvandimwe waacu Kwaruto barabataasha.<verse eid="ROM 16:24" /></para>
  <para style="s1">Indunduro n'Isengeesho ryo Gusingiza Imaana</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />Nuuko Imaana niihaabwe ikuzo, yo ibaasha kubakomeza mu kwizeera ku bw'Ubutumwa Bwiza n'ibyo nababwirije kuri Yesu Kristo, nkurikije uguhishuurwa kw'iyobera ryahoze ari ibanga kuva keera koose. <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />Ariko ubu iryo banga rikaba ryarashizwe ahagaragara n'ibyanditswe n'abahanuuzi nk'uko Imaana ihoraho yabitegetse kugira ngo bimenyeshwe abantu bo mu mahanga yoose maze bumvire kandi biizeere.<verse eid="ROM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27" />Imaana yoonyine Nyir'ubuhanga n'ihaabwe ikuzo muri Yesu Kristo iteeka ryose! Amiina.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>