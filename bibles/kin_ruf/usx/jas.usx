<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Rufumbira New Testament</book>
  <para style="h">YAAKOBO</para>
  <para style="toc3">Yaak</para>
  <para style="toc2">YAAKOBO</para>
  <para style="toc1">Urwandiko rwanditswe na YAAKOBO</para>
  <para style="mt2">Urwandiko Rwanditswe na</para>
  <para style="mt1">YAAKOBO</para>
  <para style="imt">INYANZURO</para>
  <para style="im">
    <char style="bk">Urwandiko rwanditswe na Yaakobo</char> n'amabwiriza ahuuriye hamwe afatika, yandikiwe “abantu b'Imaana boose bataataaniye mu isi yoose”. Umwanditsi akoreesha amagambo y'amarenga menshi agaragara mu gutanga amabwiriza yeerekeye ubuhanga no guhuguurwa mu myifatire ya gikristo. Mu myumvire ya gikristo Yaakobo akurikirana ingingo zitandukanye nk'ubukire n'ubukene, ibigeragezo, ingeso nziiza, urwango rudafite ishingiro, kwizeera n'ibikorwa, gukoreesha ururimi, ubuhanga, intonganya, ubwibone no guca bugufi, guca imanza, kwiraata, kwihangaana no gusenga.</para>
  <para style="ip">Uru rwandiko rushimangira akamaro k'ibikorwa bikwiranye no kwizeera mu kuyoboka idiini ya gikristo.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Indamutso 1:1</para>
  <para style="io1">Ukwizeera hamwe n'ubuhanga <char style="ior"><ref loc="JAS 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">Ubukene hamwe n'ubutunzi <char style="ior"><ref loc="JAS 1:9-11">1:9-11</ref> </char></para>
  <para style="io1">Ibigeragezo hamwe n'Ibishuko <char style="ior"><ref loc="JAS 1:12-18">1:12-18</ref></char></para>
  <para style="io1">Kumva no gukora <char style="ior"><ref loc="JAS 1:19-27">1:19-27</ref></char></para>
  <para style="io1">Kwamagana ivanguura <char style="ior"><ref loc="JAS 2:1-13">2:1-13</ref> </char></para>
  <para style="io1">Ukwizeera n'ibikorwa <char style="ior"><ref loc="JAS 2:14-26">2:14-26</ref> </char></para>
  <para style="io1">Kurinda ururimi <char style="ior"><ref loc="JAS 3:1-18">3:1-18</ref></char></para>
  <para style="io1">Umukristo n'isi <char style="ior"><ref loc="JAS 4:1-5:6">4:1—5:6</ref> </char></para>
  <para style="io1">Amabwiriza ataari amwe <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref></char></para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s">Indamutso</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:55">Mat 13:55</ref>; <ref loc="MRK 6:3">Mar 6:3</ref>; <ref loc="ACT 15:13">Iby 15:13</ref>; <ref loc="GAL 1:19">Gal 1:19</ref>.</char>
    </note>Njeewe Yaakobo, umugaragu w'Imaana n'Umwami Yesu Kristo,</para>
  <para style="p" vid="JAS 1:1">ndabaramutsa mwebwe abantu b'Imaana bo mu bwoko cumi na bubiri bwa Isirayeli bataataaniye mu isi yoose.<verse eid="JAS 1:1" /></para>
  <para style="s1">Ukwizeera n'Ubuhanga</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />Bavandimwe, nimuhuura n'ibibagerageza bitandukanye, muje muneezeerwa, <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />kuko muuzi neeza yuuko kugeragezwa ko kwizeera kwanyu guteera kwihangaana. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />Kandi mureebe ngo kwihangaana kwanyu gukomejemo ubudacoogora, kugira ngo mukure mu by'umwuka mu bwuzuye mutabuzeho na gato. <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />Niiba muri mwe hari ukeneye ubuhanga, abusabe Imaana izaabumuha, kuko Imaana iha abantu boose ku buntu. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />Ariko ni usenga, uje wiizeera udashidiikanya na gato kuko ushidiikanya ameze nk'umuvumba wo mu nyanja ujanwa n'umuyaga aho wiishaakiye. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />Umuntu weese umeze atyo yeekwibwira ko hari ico Nyagasani azaamuha, <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />kuko umuntu weese ushidiikanya ntawamwiringira.<verse eid="JAS 1:8" /></para>
  <para style="s">Ubukene n'Ubutunzi</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />Uwiizeera Kristo weese w'umukene yiishiime igihe Imaana imushize heejuru, <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />kandi n'abatunzi biizeera Kristo biishiime igihe Imaana ibaciishije bugufi. Kuko ubutunzi bw'umukire buzaashira nk'uko ibimori byo mu murima bihunguka bigashiraho. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />Iyo izuuba rirashe rifite ubushuhe bwinshi ryotsa ikimera, ubumori bwaco bugahunguka maze ubwiza bw'ico kimera bukabura. Uko ni ko umutunzi na we azaarinda apfa agishaakashaaka ubutunzi mu byo akora byose.<verse eid="JAS 1:11" /></para>
  <para style="s">Ibigeragezo n'Ibishuko</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />Hahiirwa umuntu wiihangaanira ibimugerageza, kuko naamara gutsinda ibyo bigeragezo azaahaabwa igihembo c'ubugingo buhoraho bwo Imaana yaseezeranyije abayikunda. <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />Umuntu niyooshwa agakora icaaha, ntaakavuge ati, “Imaana ni yo inyoheje,” kuko Imaana idashobora kooshwa n'ikibi cangwa ngo igire uwo ishuka. <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />Ahuubwo umuntu ashukwa n'ibyo ararikira bikamukurura maze bikamuteera ibyifuuzo bibi, <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />maze iryo rari ryamara kuba ikirenga, rigateera umuntu gukora icaaha, nuuko ico caaha kikamuuzanira urupfu.<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />Bavandimwe nkunda, ntimukabeeshwe. <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />Ubupfura bwose hamwe n'impaano itungaanye bikomooka mu ijuru ku Maana yaremye umuco wo mu ijuru. Ni yo idahinduka cangwa ngo iteere umwijima biteewe n'impindahinduka. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />Ku bw'ubushaake bwayo, yatubyaye ubwa kabiri ikoreesheje ijambo ryayo ry'ukuri, kugira ngo tubone umwanya wa mbere mu byaremwe byose.<verse eid="JAS 1:18" /></para>
  <para style="s">Kumva no Gukora</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />Bavandimwe nkunda muzirikane ibi, umuntu weese aje yiihuutira kumva, ariko atinde kuvuga kandi atinde kuraakara. <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />Kuko umuntu uraakaye adakora ibitungaaniye Imaana. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />Nuuko reero murekeraho gukora ikibi coose n'ubugome bwose. Muganduukire Imaana kandi mwemere ijambo ryabibwe mu mitima yaanyu kuko rifite imbaraga zo gukiza ubugingo bwanyu.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />Ntimwibeeshe ngo mwumve iryo jambo gusa, ahuubwo murishire mu bikorwa. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />Kuko uwumva ijambo ry'Imaana gusa ntaarishire mu bikorwa, ameze nk'umuntu wiireebera mu ndorerwamo. <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />Iyo amaze kwireeba, aragenda, uwo mwanya akiibagirwa uko asa. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />Ariko umuntu weese uzirikana itegeko ritungaanye ari ryo ritanga umudendeezo, kandi akarikomeza, atari ukuryumva gusa akaryibagirwa, ahuubwo akarikurikiza, ni we uzaabona umugisha mu byo akora byose.<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />Niiba hari uwiibwira ko ari umunyeediini ariko ntaashobore kurinda ururimi rwe, aba yiibeesha kandi idiini rye rikaba ari ntaaco rimaze. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />Idiini ritungaaniye Imaana kandi ritagira inenge ni ugufasha imfubyi n'abapfaakazi kandi no kwirinda kutanduzwa n'iby'isi.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">Kwamagana Ivanguura</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />Bavandimwe, nk'abantu biizeera Umwami Yesu Kristo ari we Nyirikuzo, ntimukwiriye kuvanguura murobaanura ku butoni. <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />Mbese umuntu wambaye imyambaro y'agaciiro kanini n'impeta y'izaahabu mu rutoki aje mu iteeraniro ryanyu, maze hakaaza n'umukene wambaye imyambaro y'ibishwangi, <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />nuuko reero amaaso mu kayahanga uwambaye imyambaro y'agaciiro kanini akaba ari we mwakiira muvuga muti, “Mwicare aha heeza,” naho wa mukene wambaye imyambaro y'ibishwangi mukamubwira muti, “Weeho hagarara hariiya cangwa wiicare haasi.” <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />Mukoze mutyo muba mwizanyemo amacaakubiri kandi mukaba abacaamanza bateekereza ibidakwiriye.<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />Nimwumve bavandimwe nkunda, Imaana yatooranyije abakene bo muri iyi si kugira ngo babe abatunzi mu kwizeera kandi babe abaragwa b'Ubwami Imaana yaseezeranyije abayikunda. <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />Ariko dore mwebwe musuuzugura abakene. Abakire si bo babakandamiza, bakabajaana imbere y'umucamanza? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />Abakire si bo basebya izina ryiza rya Kristo mwitiriwe?<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />Nyamara niiba mukurikiza itegeko nk'uko byanditswe ngo, “Ukunde mugenzi waawe nk'uko wiikunda”, muba mukoze neeza. <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />Ariko niiba murobaanura abantu ku butoni, muba mukoze icaaha kandi mugashinjwa n'itegeko ko mwaryishe. <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />Umuntu weese wuubahiriza amategeko yoose agateeshuka kuri rimwe aba ayiishe yoose. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />Kuko uwavuze ati, “Ntuugasambane” ni we wavuze ati, “Ntuukiice.” Niiba reero udasambana ariko ukiica na bwo uba wiishe amategeko yoose. <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />Muje muvuga kandi mukore nk'abantu baazi neeza ko Imaana izaabaciira urubanza ikurikije amategeko azanira abantu umudendeezo. <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />Kuko Imaana itazaagirira imbabazi umuntu weese utagirira abandi imbabazi. Ariko umuntu weese ugira imbabazi na we Imaana izaamugirira imbabazi ku munsi w'urubanza.<verse eid="JAS 2:13" /></para>
  <para style="s">Ukwizeera Kutagira Ibikorwa kuba Gupfuuye</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />Bavandimwe, byamarira iki umuntu uvuga ko afite kwizeera kandi kutarangwa n'ibikorwa? Mbese uko kwizeera kwashobora kumukiza? <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />Niiba hari umuvandimwe udafite ico kwambara cangwa ico kurya gihaagije, <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />maze hakagira umwe muri mwe umubwira ati, “Genda amahoro, wambare ushuuhe, urye kandi uhaage.” Ayo magambo aba amaze iki utamuhaaye ibyo akeneye? <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />Bityo reero, ukwizeera koonyine kudafite ibikorwa kuba gupfuuye.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />Ariko umuntu ashobora kuvuga ati, “Wowe ufite ukwizeera naho njeewe mfite ibikorwa.” Nyereka kwizeera kwawe kutagira ibikorwa, nanje nkwereke ibikorwa bigaragaza ukwizeera kwanje. <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />Mbese wemera ko hariho Imaana imwe rukumbi? Ni byiza rwose! Ariko n'abadayimooni barabyemera ndetse bagahinda umushitsi. <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />Wa mupfaapfa we, ntureeba ko kwizeera kutagira ibikorwa ari ntaaco kumaze? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />Mbese sogokuruza Aburahamu ntiyatsindishirijwe n'ibikorwa ubwo yagiiye gutamba umwana we Isaaka ku gicaaniro? <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />Ntuureeba ko kwizeera kwe kwagendanaga n'ibikorwa bye, kandi kwizeera kwe kujuririjwe n'ibikorwa bye? <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />Kandi ibyanditswe byarasohoye ngo, “Aburahamu yiizeeye Imaana kandi ku bwo kwizeera kwe Imaana imwemera nk'intungaane,” bityo reero, Aburahamu yitwa inshuti y'Imaana. <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />Murabona reero ko umuntu adatsindishirizwa no kwizeera byonyine ahuubwo ko atsindishirizwa n'ibikorwa bye.<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />Ni na ko byagendeye Rahabu wari indaya, yatsindishirijwe n'ibikorwa bye, ubwo yacumbikiye abagabo b'Abiisirayeli baari baaje gutata, akabafasha gutoroka, abanyujije mu yindi nzira.<verse eid="JAS 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26" />Nuuko reero nk'uko umubiri udafite umwuka uba upfuuye, ni na ko kwizeera kutagira ibikorwa kuba gupfuuye.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">Kurinda Ururimi</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />Bavandimwe, si ngombwa ko benshi muri mwe baaba abiigiisha. Muuzi neeza yuuko twebwe abiigiisha tuzaaciirwa urubanza rukomeye ruruta urw'abandi. <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />Kuko twese dukora inshobe nyinshi. Ariko niiba hari umuntu udashobya mu byo avuga, uwo aba ari intungaane kandi yaashobora no kugenga umubiri we woose. <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />Iyo dushize icuuma co kuyobora ifaraashi mu kanwa kaayo kugira ngo itwumvire tuyijaane iyo dushaaka, dushobora no kuyobora umubiri waayo woose. <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />Dore n'ubwato bwo mu nyanja, n'ubwo ari bunini, butwarwa n'umuyaga uhuuha caane. Ingashi ntooya caane ni yo ibwerekeza aho umusare ashaaka ngo buje. <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />Ururimi na rwo ni ko ruri, ni agace gato k'umubiri ariko rukiiraatana ibikorwa bikomeye.</para>
  <para style="p" vid="JAS 3:5">Reeba ukuntu ishamba rinini ribamo ibiti byinshi ariko rigatwikwa n'akarimi gato k'umuriro. <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />Kandi koko ururimi rw'umuntu na rwo ni nk'umuriro, kandi n'isooko y'ibibi. Rwanduza umubiri woose n'ububi bwarwo. Rutwikiisha imibeereho yaacu yoose n'umuriro rurahura ikuzimu. <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />Abantu bashobora gutooza inyamaaswa n'ibiguruka, n'ibikururuka n'ibyo mu nyanja byose, <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />ariko ururimi rwo ntaamuntu washobora kurutegeka. Rwuzuye ububi budahwema n'uburozi bwica! <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />Ururimi ni rwo dukoreesha duhimbaaza Imaana Daata, kandi ni rwo tuvumiisha abantu baaremwe mu ishusho y'Imaana. <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />Amagambo yo guheesha umugisha n'amagambo yo kuvuma aturuka mu kanwa kamwe. Bavandimwe, ntibikwiriye kumera bityo. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />Mbese amaazi meeza hamwe n'amaazi akereeta yaava mu mugezi umwe? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />Bavandimwe, mbese igiti c'umutiini caakwera imbuto za elayo, cangwa umuzaabibu wakwera imbuto z'umutiini? Ni co kimwe isooko irimo umuunyu idashobora kuvamo amaazi meeza.<verse eid="JAS 3:12" /></para>
  <para style="s">Ubwenge Buva mu Ijuru</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />Mbese ni nde muri mwe w'umunyabwenge kandi w'umuhanga? Nabigaragaze mu byo akora mu kwiciisha bugufi, mu bugwaneeza kandi n'ubuhanga. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />Ariko niiba mu mitima yaanyu huzuyemo ishari rikabije, no kwikunda, ntimukiiraate ngo mufite ubwenge kuko muba mwibeesha. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />Ubwenge nk'ubwo ntibuva mu ijuru, ahuubwo ni ubw'isi, na kamere y'umuntu, ndetse na Sataani. <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />Iyo abantu bafite ishari no kwikunda, habaho imidugararo n'ibikorwa bibi by'uburyo bwose. <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />Ariko ubwenge buva mu ijuru ni ubuziranenge, ni ubw'amahoro, ni ubw'ineeza, bwemera kugirwa inaama, bwuzuye imbabazi, bwera imbuto z'ibikorwa byiza, ntibugira aho bubogamiye kandi ntibugira uburyarya. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />Kandi iyo umunyamahoro aheesheje abandi amahoro, havamo umusaaruro wo gukiraanuka.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">Kuganduukira Imaana</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />Mbese ibiteera intonganya n'intambara muri mwe ni ibiki? Aho ntibiterwa n'ibyifuuzo byo kwineezeeza bibarimo? <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />Murararikira, ariko ntimugire ico mubona bigatuma mwica. Mukararikira ibyo mudashobora kugeraho, bikabaazanira gutongana no kurwana. Ntibona ico mushaaka kuko mutagisaba Imaana. <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />Kandi n'iyo musabye ntaaco mubona kuko musaba mugamije ibyifuuzo bibi, mushaaka ibyo kuneezeeza irari ryanyu. <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />Yemwe bantu batiringirwa mwe, ntimuuzi yuuko gukunda iby'isi bituma uba umwanzi w'Imaana? Umuntu weese uhitamo gukunda ibineezeeza by'isi aba abaaye umwanzi w'Imaana. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />Mbese muteekereza ko ibyanditswe bivuga ngo, “Imaana yashizemo umwuka wuzuye kurarikiira,” byandikiwe ubusa? <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />Ariko nuubwo bimeze bityo, Imaana irushaho kutugirira imbabazi. Ibyanditswe biravuga biti, “Imaana irwanya abiibone, ariko ikagirira ubuntu abiiciisha bugufi.”<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />Nuuko reero, muganduukire Imaana, murwanye Sataani, na we azaabahunga. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />Nimwegeere Imaana na yo izabeegeera. Nimusukuure ibiganza byanyu mwabanyabyaha mwe, mweze imitima yaanyu mwaryarya mwe. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />Nimuganye, mushavure kandi murire. Amaseka yaanyu ahinduke amarira kandi n'umuneezeero waanyu uhinduke agahinda. <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />Nimwiciishe bugufi imbere ya Nyagasani ni bwo izaabashira heejuru.<verse eid="JAS 4:10" /></para>
  <para style="s">Kudasebya Abavandimwe</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />Bavandimwe, ntimugasebanye. Umuntu weese usebya undi cangwa akamuciira urubanza aba asebya amategeko kandi aciiriye amategeko urubanza. Ariko nuuciira amategeko urubanza ntaabwo uba uyakurikije, ahuubwo uba wiigize umucaamanza. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />Imaana yoonyine ni yo itanga amategeko kandi igaca n'imanza. Ni yo yoonyine ishobora gukiza kandi ikarimbura. Wowe wiibwira ko uri nde waaciira mugenzi waawe urubanza?<verse eid="JAS 4:12" /></para>
  <para style="s">Kwirinda Ubwiraasi</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />Nimwumve yemwe bantu bavuga muti, “Uyu munsi cangwa ejo, tuzaaja mu tawuni ruunaaka tumareyo umwaka, ducuruuze kandi tubone inyungu,” <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />nyamara mudateekereje uko ubuzima bwanyu buzaabaho ejo. Mumeze nk'igiho kigaragara umwanya muto kigaheerako kikaamuuka. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />Ahuubwo mwari mukwiriye kuvuga muti, “Nyagasani naabikunda tuzaabaho dukore ibi na biriiya.” <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />Ariko mwishira heejuru mwiraata. Nyamara ubwo bwiraasi ni bubi.<verse eid="JAS 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17" />Nuuko reero umuntu uzi ico gukora gikwiriye maze ntaagikore, aba acumuye.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">Kwamagirira Abakire</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />Nimwumve mwa bakire mwe, nimurire kandi muborooge kuko mugiiye kugira ibyago. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" /><note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 6:19">Mat 6:19</ref>.</char></note>Ubutunzi bwanyu bwaraboze n'imyambaro yaanyu iriiwe n'ibiseesamuzinga. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />Izaahabu hamwe n'ifeeza zaanyu ziriiwe n'ingese. Kandi gukereba kwazo ni ko kuzaabashinja, kurye imibiri yaanyu nk'umuriro. Mwabiikiye ubutunzi bwanyu iminsi y'imperuka. <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />Nimwumve! Ibihembo by'abakozi baasaaruuye imirima yaanyu mwarabibimye. Dore barataka caane, kandi Imaana Nyiringabo yumviise gutaka kwabo. <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />Mwatuuye muri iyi si mudamaraye, muriishiima, maze mukora ibyo mushaaka byose. Aho bigeze mumeze nk'ibimasa bibyibushe bitegereje kubaagwa. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />Mwaciiriye intungaane urwo gupfa, ntizaabarwanya, muraziica.<verse eid="JAS 5:6" /></para>
  <para style="s">Kwihangaana hamwe no Gusenga</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />Nuuko bavandimwe nkunda, mwihangaane kugeza aho Umwami Yesu azaazira. Nimureebe ukuntu umuhinzi yiihangaana ategereza imyaka yabibye mu butaka kugira ngo yeere. Ayitegereza yiihangaanye kugeza igihe izaabonera imvura y'urugaryi n'iy'itumba. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />Namwe reero nimutegereze mwihangaanye, mukomeze kugira ibyiringiro kuko kuuza k'Umwami Yesu kwegeereje.<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />Bavandimwe, ntihagire uwiitotombera undi kugira ngo mudaciirwa urubanza. Dore umucaamanza ari bugufi. <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />Bakundwa, kubyerekeye kubabazwa no kwihangaana, reka abahanuuzi b'Imaana batubeere urugero kuri byo. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />Abo twita abanyamahiirwe ni abo biihangaanye. Mwumviise ibyo kwihangaana kwa Yobu, kandi muuzi ibyo Nyagasani yamukoreye haanyuma. Kuko Uhoraho ni umunyambabazi kandi afite impuhwe nyinshi.<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:34-37">Mat 5:34-37</ref>.</char>
    </note>Ariko bavandimwe, ikiruta byose ni iki; ntimukarahire ijuru cangwa isi, cangwa n'indi ndahiro yoose, ahuubwo muje muvuga muti, “Yeego” niiba ari “Yeego” cangwa se, “Oya” niiba ari “Oya” kugira ngo mudaciirwaho iteeka.<verse eid="JAS 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />Mbese hari ubabaye muri mwe? Ni asenge Imaana. Hariho uneezeerewe? Ni aririmbe indirimbo zo guhimbaza Imaana. <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" /><note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="MRK 6:13">Mar 6:13</ref>.</char></note>Muri mwe harimo urwaye? Ni ahamagaze abakuru b'itoorero bamusengere kandi bamusiige amavuta bakoreesheje ububaasha baahaawe na Nyagasani. <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />Kandi nibasengera umurwayi biizeeye, Nyagasani azaamukiza amuzaahuure. Nuubwo yaaba yarakoze ibyaha, Imaana izaabimubabarira. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />Mwaturirane ibyaha byanyu kandi musabirane kugira ngo mukire. Isengeesho ry'umuntu w'intungaane rigira ububaasha, kandi Imaana irikoreesha umurimo waayo. <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />Dore Eliya yari umuntu nka twe, asenga n'umwete kugira ngo imvura itagwa, haanyuma koko imvura imara imyaka itatu n'ameezi atandatu itagwa. <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />Arongera asenga Imaana koohereza imvura, nuuko ijuru riguusha imvura ubutaka bwera imbuto zaabwo.<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />Bavandimwe, niiba hari umuntu muri mwe wayobye akava mu nzira y'ukuri, nuuko undi muntu akamuyobora akagaruka, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" /><note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="1PE 4:8">1Pet 4:8</ref>.</char></note>mukwiriye kumenya yuuko ugaruye umunyabyaha, akamukuura mu nzira yari yarayobeyemo, azaaba akijije ubugingo bw'uwo munyabyaha urupfu kandi atume ababarirwa ibyaha bye byose.<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>