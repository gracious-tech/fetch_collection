<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Rufumbira New Testament</book>
  <para style="h">1 TIMOTEEYO</para>
  <para style="toc3">1 Tim</para>
  <para style="toc2">1 TIMOTEEYO</para>
  <para style="toc1">Urwandiko rwa mbere Intumwa Pawulo yandikiye TIMOTEEYO</para>
  <para style="mt2">Urwandiko rwa mbere Intumwa Pawulo yandikiye</para>
  <para style="mt1">TIMOTEEYO</para>
  <para style="imt">INYANZURO</para>
  <para style="im">Timoteeyo, yari umukristo w'umusore ukomooka muri Asiya ntooya. Nyina yari Umuyuudakazi naho se yari Umugiriki. Yabaaye inshuti ya Pawulo kandi aba n'umufasha we mu mirimo ye y'ubutumwa. <char style="bk">Urwandiko rwa mbere Intumwa Pawulo yandikiye Timoteeyo</char> rugizwe n'ibintu bitatu by'ingenzi.</para>
  <para style="ip">Mbere ya byose, uru rwandiko ni urwo kwamagana inyigiisho z'ibinyoma mu matoorero. Izo nyigiisho z'ikivange c'ibiteekerezo by'Abayuuda n'abatari Abayuuda, zaari zishingiye ku myemerere ngo, iyi si dutuuyemo nimbi, kandi ngo, umuntu yashobora kurokoka binyuze mu ibanga ry'ubumenyi ridasanzwe no mu bikorwa nko kureeka ibyokurya bimwe no kutarongora. Uru rwandiko rurimo n'amabwiriza yeerekana uko amatoorero akwiriye kuyoborwa n'uko amasengeesho agomba gutwazwa hamwe n'insobaanura y'uko abayobozi b'itoorero n'abafasha baabo bakwiriye kwifata. Haanyuma, Timoteeyo agiirwa inaama yo kuba umugaragu mwiza wa Yesu Kristo hamwe no kumenya imirimo itandukanye akwiriye gukorera amateeraniro atandukanye y'abiizeera.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro <char style="ior"><ref loc="1TI 1:1-2">1:1-2</ref></char></para>
  <para style="io1">Amabwiriza afashe ku toorero n'abayobozi ba ryo <char style="ior"><ref loc="1TI 1:3-3:16">1:3—3:16</ref></char></para>
  <para style="io1">Amabwiriza yahaawe Timoteeyo ku murimo we <char style="ior"><ref loc="1TI 4:1-6:21">4:1—6:21</ref></char></para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Njeewe Pawulo, intumwa ya Kristo Yesu ku bw'itegeko ry'Imaana Umukiza waacu na Kristo Yesu ari we byiringiro byacu,<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:2 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:1">Iby 16:1</ref>.</char>
    </note>Ndakwandikiye Timoteeyo, umwana wanje nyakuri mu kwizeera.</para>
  <para style="p" vid="1TI 1:2">Ubuntu, imbabazi n'amahoro biva ku Maana Daata na Kristo Yesu Umwami waacu, bibaane naawe.<verse eid="1TI 1:2" /></para>
  <para style="s">Kwamagana Abiigiisha b'Ibinyoma</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />Ndagusaba kuguma muri Efeeso nk'uko nabikubwiye ubwo najaga i Makedooniya, kugira ngo ubuze abantu bamwe kwigiisha inyigiisho zidashitse. <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />Ubabwire bareke ibiteekerezo bitagira ishingiro no gukurikirana intonde z'ibiseekuruza zitagira iherezo. Ibyo biizana impaka z'urudaca, aho gushigikira umugambi w'Imaana ushingiye ku kwizeera. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />Ikigendererwa c'aya mabwiriza ni ukwenegeza urukundo rukomooka ku mutima usukuuye, umutimanaama ukeeye, no kwizeera kutaryarya. <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />Bamwe biitandukanyije n'izo nyigiisho z'ukuri maze biishira mu magambo atagira ico amaze. <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />Bashaaka kuba abiigiishamategeko y'Imaana, kandi bataazi ibyo bavuga n'ibyo beemeza.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />Tuuzi neeza yuuko amategeko ari meeza igihe akoreeshejwe mu buryo bukwiriye. <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />Twibuke yuuko amategeko ataashiriweho intungaane, ahuubwo ko yashiriweho abatayuubaha n'ibyigomeke, n'abateemera Imaana n'abanyabyaha, n'abatari intungaane naabo batuubaha Imaana, n'abiica ba se na ba nyina, n'abatemu, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />abasambanyi n'ibitingwa<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">Ibitingwa ni abagabo basambana n'abandi bagabo.</char></note>, abacuruuza abantu, ababeeshi, abatanga ubujurizi bw'ibinyoma, n'abandi boose bakora ibinyuranye n'inyigiisho nzima. <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />Izo nyigiisho zihuuje mu butumwa bwiza nashinzwe kwamamaza, ari yo Nkuru Nziiza ikomooka ku Maana nyiri ikuzo n'ihiirwe.<verse eid="1TI 1:11" /></para>
  <para style="s">Pawulo Ashiimira Imaana Imbabazi Yamugiriye</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Ndashiima Kristo Yesu Umwami waacu wampaaye imbaraga, kuko yanyizeeye maze akantoorera gukora umurimo we, <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" /><note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">Iby 8:3</ref>; <ref loc="ACT 9:4">9:4</ref>,<ref loc="ACT 9:5">5</ref>.</char></note>nuubwo mbere nari umuntu utuka Imaana, ngatooteza abayoboke baayo, ndetse nkaba umunyarugomo. Ariko nahaawe imbabazi kuko ibyo byose nabikoraga mbiteewe n'ubujiji kandi ntagira kwizeera. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />Maze ubuntu bw'Umwami waacu bunsendeeramo hamwe no kwizeera n'urukundo rubonekera muri Kristo Yesu. <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />Iri jambo rivuga ko Kristo Yesu yazanywe mu isi no gukiza abanyabyaha, kandi muri bo nkaba ndi uwa mbere, ni iry'ukuri kandi rikwiriye kwemerwa na boose. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />Ariko ku bw'iyo mpamvu narababariwe, kugira ngo Yesu Kristo yeerekanire muri nje umunyabyaha wa mbere, ukwihangaana kwe kuuzuye, bityo reero mbeere urugero abagomba kuzamwemera boose bagahaabwa ubugingo buhoraho. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />Umwami w'ibihe byose udapfa, kandi utagaragara, ari we Maana imwe rukumbi, ihaabwe icuubahiro kandi ihimbaazwe iteeka ryose, Amiina.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />Mwana wanje Timoteeyo, dore nguhaaye iyi nyigiisho nkurikije ubuhanuuzi bwa keera bwahanuuye ibyawe, kugira ngo nubukurikiza, bugushoboze kurwana intambara nziiza, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />ufite ukwizeera n'umutimanaama utungaanye. Abantu bamwe ntaabwo baakurikije uwo mutimanaama waabo, maze bibaviiramo kutongera kwizeera. <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />Muri bo ni nka Himeneyo na Alekizanda, abo neeguriye Sataani kugira ngo biigireho kutazongera gutuka Imaana.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">Amabwiriza yeerekeye Amasengeesho</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Mbere ya byose ndabiihanangiriza mwese ko mugomba kwambaza Imaana, mukayisenga, mukayitakambira kandi mukayishiimira ku bw'abantu boose. <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />Muje musabira abaami n'abandi bayobozi b'inzeego zo heejuru, kugira ngo tugire amahoro n'ituuze twubaha Imaana kandi turi inyangamugayo. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />Ibyo birakwiriye kandi biratungaanye imbere y'Imaana Umukiza waacu, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />yo ishaaka ko abantu boose baakizwa kandi bakamenya ukuri. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Kuko</para>
  <para style="q1" vid="1TI 2:5">hariho Imaana imwe,</para>
  <para style="q2" vid="1TI 2:5">ni na ko hariho umuhuuza w'abantu n'Imaana umwe,</para>
  <para style="q1" vid="1TI 2:5">ni Kristo Yesu, ari we muntu<verse eid="1TI 2:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="1TI 2:6" />wiitanzeho igitambo kuba inshungu y'abantu boose.</para>
  <para style="m" vid="1TI 2:6">Ubwo bwari ubuhamya mu gihe gikwiriye yuuko Imaana ishaaka ko buri muntu weese akizwa. <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" /><note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="2TI 1:11">2 Tim 1:11</ref>.</char></note>Ico ni co natoorewe nk'umubwiriza n'intumwa kandi ndavuga ukuri, simbeesha. Kandi nk'umwigiisha w'abanyamahanga mu byerekeye ukwizeera n'ukuri.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Noone reero, ndashaaka ko buri hoose abagabo batungaaniye Imaana basenga beerekeje amaboko yaabo heejuru, kandi badafite uburaakari cangwa impaka. <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" /><note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="1PE 3:3">1Pet 3:3</ref>.</char></note>Kandi ndashaaka ko abagore na bo baakwambara neeza imyambaro ikwiriye, atari ukuboha imisatsi no kwambara imitaako ya zaahabu, amasimbi, cangwa imyambaro y'igiciiro kinini, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />ahuubwo bakiirimbiisha ibikorwa byiza, nk'uko bikwiriye abagore biiyemeza ko buubaha Imaana. <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />Umugore agomba kwiga acecetse kandi agaciisha make rwose. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Sineemerera umugore kwigiisha cangwa gutegeka umugabo, agomba guceceka, <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />kuko Adamu ni we waremwe mbere ya Eva, <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />kandi Adamu si we wohejwe, ahuubwo umugore ni we wohejwe maze acumura ku Maana. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />Nyamara umugore azaakirizwa mu rubyaro rwe, aramutse akomeje kwizeera, akagira urukundo, gutungaanira Imaana no kwifata neeza.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">Uko Abepisikopi Bagomba Gutwaza</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Iri jambo rikurikira ni iry'ukuri ngo: Niiba umuntu ashaaka kuba umwepisikopi, aba yiifuuje umurimo mwiza caane. <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" /><note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="TIT 1:6-9">Tito 1:6-9</ref>.</char></note>Umwepisikopi agomba kuba ari inyangamugayo, afite umugore umwe, atararikira ibirenze, agomba kwifata, kandi akiyubaha, agomba kugira ubupfura, kandi akamenya kwigiisha neeza, <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />agomba kuba atari umusinzi, atari umurwanyi, ntaabe umunyamahaane, kandi adakunda isente. <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />Agomba kuba azi kureeberera ab'urugo rwe neeza, no gutooza abaana be kumvira no kuubaha mu buryo bwose. <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />Noone se niiba umuntu ataashobora kuyobora urugo rwe, yayobora ate itoorero ry'Imaana? <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />Ntaabwo akwiriye kuba ari umuntu uhindukiye Kristo vuba, kugira ngo ataaza kwishira heejuru maze Imaana ikamuciira urubanza nk'uko yaruciiriye Sataani. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />Kandi akwiriye kuba ari umugabo wubahwa n'abo hanze y'itoorero, kugira ngo adahinyuka akagwa mu mutego wa Sataani.<verse eid="1TI 3:7" /></para>
  <para style="s">Uko Abadiyakooni Bagomba Gutwaza</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Abadiyakooni na bo bagomba kuba ari abantu b'inyangamugayo, batari indyarya, batanywa inzoga nyinshi, cangwa ngo bararikire isente. <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />Bagomba gukomera ku iyobera ryo kwizeera bafite umutima ukeeye. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Bakwiriye kubanza baasuuzumwa, maze baasangwa batagira umugayo, bakeemererwa gukora nk'abadiyakooni. <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />Abagore baabo na bo bakwiriye kuba inyangamugayo, ntibabe abanyamazimwe, ahuubwo bakaba abatararikira ibirenze kandi bakaba abiiringirwa muri byose. <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />Umudiyakooni akwiriye kuba umugabo ufite umugore umwe gusa, kandi akamenya gutegeka neeza abaana be n'abo mu rugo rwe boose, <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />kuko abakora umurimo w'ubudiyakooni neeza, bibaheesha umwanya w'icuubahiro kandi bigatuma bashira amanga mu kwizeera Kristo Yesu.<verse eid="1TI 3:13" /></para>
  <para style="s">Ibanga Rikomeye</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Mfite ibyiringiro byo kuuza iyo vuba, ariko igituma nkwandikiye ibyo ni ukugira ngo, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />nindamuka ntinze, ube uzi uko umuntu akwiriye kwifata mu muryango w'Imaana, ari wo toorero ry'Imaana nzima, kandi inkingi ishigikiye ukuri kwayo. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />Ntawabishidiikanya, ibanga ry'ubukristo bwacu rirakomeye:</para>
  <para style="q1" vid="1TI 3:16">Kristo yagaragaye mu ishusho ry'umuntu,</para>
  <para style="q2" vid="1TI 3:16">Umwuka Weera umwerekana nk'intungaane,</para>
  <para style="q2" vid="1TI 3:16">kandi abonwa n'abaamalayika,</para>
  <para style="q1" vid="1TI 3:16">yaamamazwa mu mahanga,</para>
  <para style="q2" vid="1TI 3:16">yiizeerwa mu isi yoose,</para>
  <para style="q2" vid="1TI 3:16">kandi azaamuurwa mu ikuzo.<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">Abiigiisha b'Ibinyoma</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />Ariko Umwuka Weera avuga yeruye ko mu bihe bizaaza bamwe baziihakana ukwizeera maze bakayoboka imyuka iyobya n'inyigiisho z'abadayimooni. <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />Inyigiisho nk'izo zisaakaazwa n'abanyabinyoma, ab'imitima yaabo yapfuuye ikaba itagishobora gutandukanya ikibi n'iciiza, nk'aho yokejwe n'icuuma kigurumana. <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />Babuza abantu kurongorana no kutarya ibyokurya bimwe, kandi Imaana yarabiremeye kwakiiranwa ishimwe n'abo biizeera kandi bakamenya ukuri. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Koko reero, ikintu coose caaremwe n'Imaana ni ciiza, kandi nta na kimwe kigomba kuba umuziro, iyo caakiiranywe ishimwe, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />kuko kiba ceejejwe n'ijambo ry'Imaana hamwe no gusenga.<verse eid="1TI 4:5" /></para>
  <para style="s">Umugaragu Mwiza wa Yesu Kristo</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Ibi byose nubisobaanurira abiizeera, uzaaba ubaaye umugaragu mwiza wa Yesu Kristo, utunzwe n'amagambo yo kwizeera n'inyigiisho nziiza wakurikije. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Uje wiirinda imigani itari iy'Imaana ifite ibiteekerezo bibi bitagira ishingiro bikomooka kuri baasookuruza, ahuubwo wiitooze kuubaha Imaana. <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />Imyitoozo ngororamubiri ifite akamaro kuri bike, ariko kwitooza kuubaha Imaana byo bigira umumaro muri byose, kuko ari byo birimo iseezerano ry'ubugingo turimo n'ubw'igihe kizaaza. <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Iri jambo ni iry'ukuri kandi rikwiriye kwemerwa rwose. <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />Koko reero, igituma twemera kugooka tukiihaahaata, ni uko dufite ibyiringiro ku Maana nzima, ari yo Mukiza w'abantu boose, caane caane abo biizeera.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />Ibi ni byo ugomba kwibandaho kandi ukiigiisha. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />Ntihakagire usuuzugura ubusore bwawe, ahuubwo ubeere abiizeera ico kureeberaho mu magambo, mu myifatire, mu rukundo, mu kwizeera, n'umutima utungaanye. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Kugeza aho nzaazira, uje ugira umwete wo gusomera abantu ibyanditswe byera, kubwiriza no kwigiisha. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Ntukiirengagize impaano y'Umwuka ikurimo, iyaguheerewe mu buhanuuzi ubwo abakuru baakurambikagaho ibiganza. <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />Ibyo uje ubishira mu bikorwa, kandi ubyiteho, kugira ngo boose bareebe iteerambere ryawe. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />Wite ku myifatire yaawe no kubyo wiigiisha. Ukomeze kugenza utyo, kuko n'ubikora, uziikiza ubwawe, kandi ukize n'abandi bagutega amatwi.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">Ibyo Umuyobozi w'Itoorero Ashinzwe Gukorera Abiizeera</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Ntukabwire naabi umusaaza, ahuubwo uje uvugana na we nk'umubyeyi, naho abasore uje ubatwara nka beene so, <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />abakeecuru uje uvugana na bo nka ba nyoko, naho inkumi nka bashiki baawe, kandi byose ubikorane umutima usukuuye.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />Uzaaje wubaha abapfaakazi b'imburabure. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />Ariko umupfaakazi aramutse afite abaana cangwa abuuzukuru, bagomba kubanza biigiishwa kwita ku muryango waabo, maze bakiituura ababyeyi baabo ineeza baabagiriye, kuko ibyo ari byo bishiimiisha Imaana. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />Umupfakazi w'imburabure wiirwanaho, yiiringira Imaana. Agahora ayiiyambaza no kuyisenga amanywa na ni joro. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />Naho umupfaakazi wiibeera mu kudamarara, aba apfuuye ahagaze. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />Ibyo na byo uje ubibategeka, kugira ngo babe inyangamugayo. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Kandi umuntu aramutse atareebereye ab'umuryango we, na caane ab'urugo rwe, uwo aba asubiye inyuma mu byo kwizeera Kristo ndetse akaba arutwa n'utiizeera.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />Umugore ugomba gushirwa ku rutonde rw'abapfaakazi, ni uwo utari haasi y'imyaka mirongo itandatu kandi akaba yari yarashingiwe ku mugabo umwe gusa. <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />Agomba kuba azwiho imirimo myiza, nko kurera abaana be neeza, kwakiira abashitsi mu rugo rwe, akaba yaraheereje abantu b'Imaana aciiye bugufi, agafasha imbabare, kandi agashiishikarira gukora ibikorwa byiza mu buryo bwose.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />Abapfaakazi bakiri bato ntimuzaabashire ku rutonde, kuko iyo irari ryabo ribateeye kureka Kristo, bumva bashaaka kongera gushingirwa, <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />maze bagashirwaho urubanza rwo kwica amaseezerano yaabo ya mbere. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />Byongeye kandi, biiga kuba imburamukoro, bakazereera imihana. Uretse kuba imburamukoro, baba abanyamazimwe no kwiteerera mu bitabafasheho, bakavuga ibidakwiriye. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Ni co gituma nshaaka ko abapfaakazi bato baashingirwa, bakabyara abaana, bakareeberera amago yaabo, kugira ngo badaha abanzi baacu urwitwazo rwo kudusebya. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Koko reero hari bamwe mu bapfaakazi bato baamaze guteeshuka bagakurikira Sataani. <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />Niiba hari umugore wizeera ufite umuvandimwe w'umupfaakazi, agomba kumufasha, kugira ngo yorohereze itoorero na ryo ribone uko ryafasha abo bapfaakazi b'imburabure.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />Abakuru b'itoorero bayobora neeza, na caane abo baamamaza ijambo ry'Imaana no kwigiisha bakwiriye guhaabwa icuubahiro gikwiriye, <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />kuko ibyanditswe bivuga ngo, “Ntuugahambiire umunwa w'ikimasa mu gihe kivunga ingano.” kandi ngo “Umukozi akwiriye uruhembo.”<figure style="fig" alt="When an ox is at work, it should be feed as well" file="LB00018B.TIF" size="col" loc="HK - NEW" copy="The British and Foreign Bible Societies" ref="5:18">Iyo ikimasa gikora, gikwiriwe guhaabwa ibyokurya.</figure> <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />Ntuugapfe kwemera ibyo barega umukuru w'umuryango, keretse abaaye ashinjwa n'abantu babiri cangwa batatu. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Kuri abo bakomeje gukora ibyaha, uje ubahanira imbere y'abandi boose, kugira ngo na bo batiinye.<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />Ndakwihanangiriza imbere y'Imaana na Kristo Yesu n'abaamalayika baatooranyijwe, kugira ngo ukurikize aya mabwiriza utagira aho ubogamiye, cangwa ngo ugire uwo ubeera mu byo ukora. <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />Ntukiihuutire kwimika umuntu kuba umukozi w'Imaana, kandi ntukiivange mu byaha by'abandi, ahuubwo wowe ukomeze kwibeera intungaane.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />Utazongera kunywa amaazi yoonyine, ahuubwo uje unywa na ka divaayi gake kubeera igifu caawe no guhora urwaragurika.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />Ibyaha by'abantu bamwe biragaragara maze bikababanziriza imbere bataraaciirwa urubanza, naho ibyaha by'abandi bigaragara nyuma. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Na ni ko n'imirimo myiza igaragara, kandi iramutse itagaragaye, ntishobora kuguma ihishwe.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Abo boose bari ku ngoyi y'ububaata bagomba kwemera ko ba sheebuja bakwiriye icuubahiro coose, kugira ngo hatagira uvuga naabi Imaana n'inyigiisho zaacu. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />Abo bafite ba sheebuja biizeera Kristo ntibakabasuuzugure biitwaje ko ari abavandimwe baabo muri Kristo, ahuubwo bagomba kurushaho kubaheereza, kuko abungukira muri iyo mirimo ari abiizeera nk'abo n'abakundwa.</para>
  <para style="s" vid="1TI 6:2">Inyigiisho z'Ibinyoma hamwe n'Ubutunzi bw'Ukuri</para>
  <para style="p" vid="1TI 6:2">Dore ibyo ugomba kwigiisha kandi ukaamamaza. <verse eid="1TI 6:2" /><verse number="3" style="v" sid="1TI 6:3" />Uziigiisha ibitandukanye kandi ntiyemere amagambo ashitse y'Umwami waacu Yesu Kristo n'inyigiisho zuubahiisha Imaana, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />uwo aba ari umwiraasi, kandi utagira ico azi, agakunda impaka z'urudaca n'uruyombo. Ibyo ni byo bivamo ishari, intonganya, gutukana, gukeekanaho ibibi, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />n'impaka z'urudaca ziteerwa n'abantu boonoonekaye ubwenge, batakimenya ukuri, bagateekereza yuuko kuba umukristo byabaviiramo inyungu.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />Ni koko reero, kuba umukristo birimo inyungu nyinshi, na caane iyo umuntu anyuzwe n'ibyo afite. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />Erega ntaaco twazanye mu isi, kandi nta co tuzaayivaanamo. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />Noone reero, igihe dufite ibyokurya n'ibyo kwambara, tugomba kunyurwa na byo. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Ariko abo bashaaka kuba abatunzi, bagwa mu mutego maze bagashukwa n'irari, rigatuma barimbuka. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Kuko gukunda isente ni yo nkomooko y'ibibi byose. Abantu bamwe baararikiye ubutunzi, barayoba, ntibongera kwizeera Imaana maze bibaviiramo umubabaro mwinshi.<verse eid="1TI 6:10" /></para>
  <para style="s">Intambara Nziiza yo Kwizeera</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Ariko wowe muntu w'Imaana, ibyo uje ubyirinda. Uje uharanira ubutungaane, kuubaha Imaana, kwizeera, urukundo, kwihangaana, n'ubwitonzi. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Uje urwana intambara nziiza yo kwizeera, maze wironkere ubugingo buhoraho, ubwo wahamagariwe nk'uko wabyiyemeje igihe wahamyaga ukwemera kwawe mu ruhame rwa benshi. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" /><note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JHN 18:37">Yoh 18:37</ref>.</char></note>Imbere y'Imaana iha byose ubugingo n'imbere ya Kristo Yesu wahamije ku mugaragaro ukwemera kwe imbere ya Pontiyo Pilato, ngutegetse <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />kuubahiriza itegeko utagira amakemwa n'umugayo kugeza aho Umwami waacu Yesu Kristo azaazira. <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />Igihe gikwiriye nikigera, Yesu Kristo azaagaragazwa n'Imaana ari yo ikwiriye ishimwe ikaba n'umutegeka weenyine kandi anari we Mwami w'abaami n'Umutware w'abatware. <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />Ni yo yoonyine idapfa, ikaba mu muco udahangarwa. Ntaamuntu wiigeze kuyibona kandi ntaawe waashobora kuyibona. Icuubahiro n'ubutware budashira bibe ibyayo. Amiina.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Utegeke abatunzi bo muri iki gihe kutiiraata, cangwa ngo bashire ibyiringiro byabo ku butunzi bushira vuba, ahuubwo biringire Imaana iduha ibintu byose mu bwinshi kugira ngo imitima yaacu yizihirwe. <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />Bagomba gukora neeza, bagakungahara mu bikorwa byiza, babe abanyabuntu, kandi biiteguuye gutanga ku byabo batiitangiiriye itama. <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />Bityo reero, bazaaba biizigamiye ubutunzi bw'urufatiro rwiza mu gihe kizaaza, kugira ngo babone uko baronka ubugingo nyakuri.<verse eid="1TI 6:19" /></para>
  <para style="s">Guseezera</para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Timoteeyo, uje urinda ico waragijwe. Uje wiirinda amagambo adakwiriye kandi atagira umumaro n'impaka zo bamwe biibeesha bakiita ubumenyi, <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />kuko hari bamwe biivuga ko bafite ubwo bumenyi, bikaba byarabateeye kwitandukanya n'inzira yo kwizeera.</para>
  <para style="p" vid="1TI 6:21">Ubuntu bw'Imaana bubaane namwe.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>