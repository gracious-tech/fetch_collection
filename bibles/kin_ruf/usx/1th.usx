<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">1TES - Rufumbira New Testament</book>
  <para style="h">1 ABATEESALONIKE</para>
  <para style="toc3">1Tes</para>
  <para style="toc2">1 ABATEESALONIKE</para>
  <para style="toc1">Urwandiko rwa mbere Intumwa Pawulo yandikiye ABATEESALONIKE</para>
  <para style="mt2">Urwandiko rwa mbere Intumwa Pawulo yandikiye</para>
  <para style="mt1">ABATEESALONIKE</para>
  <para style="imt">INYANZURO</para>
  <para style="im">Teesalonike yari i tawuni nkuru y'igice ca Rooma y'i Makedooniya. Pawulo yatangiye itoorero muri uwo mwanya avuuye i Filipi. Mu gihe gito Pawulo yatangiye guhakanywa n'Abayuuda bamugiriye ishari ku bw'insinzi yagize mu kubwiriza ubutumwa bwa Gikristo mu banyamahanga baari bashiishikariye kuyoboka idiini y'Abayuuda. Pawulo yahaswe kuva i Teesalonike akaja i Bereya. Haanyuma, amaze kugera i Korinto, Pawulo yaboonye inyanzuro ivuuye kuri mugenzi we kandi umukozi bafatanyije umurimo w'Imaana ari we Timoteeyo. Iyo nyanzuro yari ifashe ku byari mu itoorero ry'i Teesalonike.</para>
  <para style="ip">
    <char style="bk">Urwandiko rwa mbere Intumwa Pawulo yandikiye Abateesalonike</char> rwanditswe kugira ngo rukomeze kandi ruhamirize Abakristo b'aho. Pawulo abashiima ku bw'inkuru yo kwizeera n'urukundo bafite, abiibutsa ibyo yabaayemo ubwo yari na bo, kandi asubiza ibibazo byabonetse muri iryo toorero byerekeye ku kugaruka kwa Kristo. Biibazaga niiba umwizeera wa pfuuye mbere yo kugaruka kwa Yesu na we azaabona ubugingo buhoraho buzaabaho Yesu agarutse. Ikindi baabazaga bati: “Kristo azaagaruka ryari?” Pawulo yajaanye uyu mugisha kubabwira ko bakomeza gukora biitonze bategereje n'ibyiringiro byo kugaruka kwa Kristo.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro <char style="ior"><ref loc="1TH 1:1">1:1</ref> </char></para>
  <para style="io1">Gushiima no guhimbaaza <char style="ior"><ref loc="1TH 1:2-3:13">1:2—3:13</ref></char></para>
  <para style="io1">Guhuguura ku myifatire ya Gikristo <char style="ior"><ref loc="1TH 4:1-12">4:1-12</ref></char></para>
  <para style="io1">Iby'amabwiriza yo kugaruka kwa Kristo <char style="ior"><ref loc="1TH 4:13-5:11">4:13—5:11</ref></char></para>
  <para style="io1">Guhuguura kwa nyuma <char style="ior"><ref loc="1TH 5:12-22">5:12-22</ref></char></para>
  <para style="io1">Umusoozo <char style="ior"><ref loc="1TH 5:23-28">5:23-28</ref></char></para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="s">Indamutso</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:1">Iby 17:1</ref>.</char>
    </note>Njeewe Pawulo na Silaasi, na Timoteeyo,</para>
  <para style="p" vid="1TH 1:1">turabandikiye mwebwe abo mu itoorero rya Teesalonike, biizeera Imaana Daata n'Umwami Yesu Kristo.</para>
  <para style="p" vid="1TH 1:1">Ubuntu n'amahoro bibe muri mwe.<verse eid="1TH 1:1" /></para>
  <para style="s1">Ubuzima no Kwizeera kw'Abateesalonike</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />Duhora dushiima Imaana ibihe byose kandi tubasabira uko dusenga. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />Imbere y' Imaana Daata, twibuka imirimo yaanyu yo kwizeera, n'uko urukundo rubateera umuhaati wo gukora, n'uko ibyiringiro byanyu mu Mwami Yesu Kristo birushaho gushinga imizi. <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />Bavandimwe tuuzi neeza yuuko Imaana ibakunda kandi ikaba yarabatooranyije kuba abaayo. <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />Kuko Ubutumwa Bwiza tutaabubagejejeho mu magambo gusa ahuubwo twabwamamaje dukoreesheje imbaraga z'Umwuka Weera twerekana uko twemera yuuko Inkuru Nziza ari ukuri koko. Muuzi neeza ukuntu twifataga ubwo twari kumwe, yuuko kwari ukugira ngo tubafashe. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" /><note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="ACT 17:5-9">Iby 17:5-9</ref>.</char></note>Namwe mwaratwigaanye, mwigaana na Nyagasani n'ubwo mwatootejwe caane, mwakiiranye ijambo ry'Imaana ibyishimo biva ku Mwuka Weera. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />Ni co caatumye muba ico kureeberaho c'abeemera boose bari i Makedooniya no muri Akaya. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />Muri mwe ni mwo ijambo ry'Imaana ryumviikaniye. Ntiryageze i Makedooniya no muri Akaya hoonyine, ahuubwo mu myanya yoose ukwizeera Imaana kwaraamamaye ku buryo bitari ngombwa kubivugaho. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />Abantu boose bavuga uko mwatwakiiriye, n'ukuntu mwagarukiye Imaana, mukareka ibigirwamaana, kugira ngo mukorere Imaana nzima kandi y'ukuri, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />kandi no gutegereza Umwana waayo uzaava mu ijuru, uwo yazuuye mu baapfuuye ari we Yesu udukiza uburakari bw'Imaana bugiiye kuuza.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s1">Ubuheereza bwa Pawulo i Teesalonike</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />Bavandimwe, ubwanyu muuzi yuuko kuuza kubasuura kwacu kutaabaaye imfaabusa. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" /><note caller="-" style="x"><char style="xo" closed="false">2:2 a </char><char style="xt" closed="false"><ref loc="ACT 16:19-24">Iby 16:19-24</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="ACT 17:1-9">Iby 17:1-9</ref>.</char></note>Nuubwo twamaze kubabazwa no guhemurirwa i Filipi nk'uko mubiizi, Imaana yaduhaaye ubutwari bwo kubabwira Ubutumwa Bwiza bwayo nuubwo abantu benshi baaduhakanyaga. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />Inyigiisho zaacu muri mwe ntaabwo zishingiye ku buyobe cangwa imigambi mibi, cangwa ngo tugire uwo tubeesha. <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />Ahuubwo yaboonye ko tubikwiriye, iduha umurimo wo kuvuga Ubutumwa Bwiza, ntitubuvugira gushiimiisha abantu, ahuubwo ni ugushiimiisha Imaana yo ireeba ibiri mu mitima yaacu. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />Nk'uko mubiizi ntitwigeze kubabwira amagambo yo kuryosha inkuru kandi Imaana izi yuuko tutaabiihishemo ngo tugirire ibyanyu umururu. <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />Nta na rimwe twigeze dushaaka gushimwa n'abantu, haaba muri mwe cangwa mu bandi, <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />nuubwo twe nk'intumwa za Kristo twagombaga kugira ibyo tubasaba. Ariko twiciishije bugufi muri mwe nk'uko umubyeyi areeberera abaana be. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />Ku bw'urukundo rwinshi tubafitiye, twagize umuhaati wo kutabagezaho Ubutumwa Bwiza gusa, ahuubwo no gutanga ubugingo bwacu ku bwanyu kuko mwatubeereye inkoramutima. <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />Bavandimwe, muriibuka uko twakoze turuha ijoro n'amanywa kugira ngo hatagira uwo turusha ubwo twababwirizaga ubutumwa.<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />Muri abahamya kandi n'Imaana irabiizi ko imyifatire yaacu kuri mwe abiizeera, yari ikiraanuka, ikwiriye kandi itagira umugayo. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />Nk'uko mubiizi, twafashe buri muntu muri mwe nk'uko umubyeyi afata abaana be. <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />Twarabakomeje, turabahuumuriza kandi tubingingira gutunganira Imaana, ari na yo ibahamagarira kubona umwanya mu Bwami bwayo n'ikuzo ryayo.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />Ni co gituma duhora dushiima Imaana ubudahwema, kuko mwakiiriye ijambo ry'Imaana twabaazaniye. Ntimwaryakiiriye nk'ijambo ry'abantu, ahuubwo mwaryakiiriye nk'ijambo ry'Imaana kandi rikorera muri mwe abiizeera. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" /><note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="ACT 17:5">Iby 17:5</ref>.</char></note>Bavandimwe, ibi byababaayeho ni byo byabaaye no ku matoorero y'Imaana yo muri Yudeeya, byabaye ku bantu baariyo biizeeraga Kristo Yesu. Mwababajwe n'abantu baanyu nk'uko na bo baababajwe n'Abayuuda. <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" /><note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="ACT 9:23">Iby 9:23</ref>,<ref loc="ACT 9:29">29</ref>; <ref loc="ACT 13:45">13:45</ref>,<ref loc="ACT 13:50">50</ref>; <ref loc="ACT 14:2">14:2</ref>,<ref loc="ACT 14:5">5</ref>,<ref loc="ACT 14:19">19</ref>; <ref loc="ACT 17:5">17:5</ref>,<ref loc="ACT 17:13">13</ref>; <ref loc="ACT 18:12">18:12</ref>.</char></note>Biishe Umwami Yesu hamwe n'abahanuuzi kandi naatwe baradutooteza. Ntaabwo bashiimiisha Imaana kandi bahakanya buri muntu weese. <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />Batubuza kubwiriza abanyamahanga ngo bakizwe, bakaguma kugwiza ibyaha byabo, ariko noone, uburaakari bw'Imaana bwabagezeho.<verse eid="1TH 2:16" /></para>
  <para style="s1">Iciifuuzo ca Pawulo co gusubira i Teesalonike</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />Ariko twebwe bavandimwe, ubwo twatandukanyijwe namwe igihe gito mu buryo bw'umubiri, nyamara tubahoza ku mutima, kandi twiyongeye kubakumbura caane bituma twifuuza ko twongera kubonana namwe imbona nkubone. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />Twashaatse kongera kugaruka iwaanyu. Ndetse njeewe Pawulo nagerageje kugaruka inshuro nyinshi ariko Sataani ntiyabitwemerera. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />Mwaduteeye ibyiringiro n'umuneezeero kandi nimwe kamba ryo tuziiraatana imbere y'Umwami Yesu ubwo azaaba agarutse. <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />Koko ni mwe cuubahiro caacu n'ibyishiimo byacu.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:15">Iby 17:15</ref>.</char>
    </note>Haanyuma, tuboonye ko tutaashobora kubyihangaanira, duhitamo gusigara twenyine muri Atenaayi. <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />Nuuko dutuma Timoteeyo umuvandimwe kandi umukozi w'Imaana mugenzi waacu mu kwamamaza ubutumwa bwa Kristo. Twamuboherereje ngo abe ari we ubakomeza no kubateera umwete wo gushikama mu kwizeera kwanyu, <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />kugira ngo hatagira usubira inyuma akava mu kwizeera abiteewe n'aya makuba turimo. Ni ukuri mwe ubwanyu muuzi neeza ko twagenewe kuzaayacamo <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />Ubwo twari tukiri kumwe namwe, twababwiye mbere y'igihe yuuko tugiiye gutootezwa kandi nk'uko mubiizi neeza ni ko byabaaye. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />Ni co gitumye aho naniriwe kwihangaana mboherereje Timoteeyo kugira ngo azaamenyeeshe uko muhagaze mu kwizeera. Nateekereje ko umushukanyi yaaba yarabashutse, ibyo twakoze bikaba imfaabusa.<verse eid="1TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:6 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:5">Iby 18:5</ref>.</char>
    </note>Noone ubu Timoteeyo atugezeho avuuye iwaanyu, kandi atuuzaniye inkuru nziiza y'ibyo kwizeera n'urukundo rwanyu. Yatubwiye yuuko muhora mutwibuka, mukanadukumbura mushaaka kutureeba nk'uko naatwe tubyifuuza. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />Ku bw'iyo mpamvu bavandimwe, kwizeera kwanyu kwaraduhumurije mu mibabaro no mugutootezwa kwacu. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />Ubu turumva turi bazima nimukomeza gushikama muri Nyagasani. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />Mbese Imaana twayishiima dute ku bwanyu ku bw'umuneezeero muduteera imbere yaayo? <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />Dusenga ijoro n'amanywa kugira ngo Imaana iduhe kwongera kubonana namwe maze tubongerere kubikibuze mu kwizeera kwanyu.<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />Turasaba ngo Imaana Daata ubwayo n'Umwami Yesu baduteguurire inzira yo kugera iwaanyu. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />Namwe Nyagasani abongerere kandi abaseesekazeho urukundo mufitanye, n'urwo mufitiye abantu boose nk'uko naatwe tubakunda. <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />Nyagasani akomeze imitima yaanyu mu butungaane kandi mwekugira umugayo imbere y'Imaana Daata, kugeza igihe Umwami waacu Yesu azaazana n'abeera be boose.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s1">Ubuzima Buneezeeza Imaana</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />Nuuko bavandimwe, ibisigaye turabinginga tubahuguura mu izina ry'Umwami waacu Yesu kugira ngo nk'uko twabiigiishije mwifate mu buryo bushiimiisha Imaana, nk'uko musanzwe mubikora, ariko ubu reero mukwiriye kurushaho. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />Muuzi neeza ibyo twabiigiishije ku bw'ububaasha twahaawe n'Umwami Yesu. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />Ico Imaana ibashaakaho ni ukwezwa kwanyu, mukiirinda ubusambanyi, <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />buri muntu akamenya kurinda umubiri we mu buryo butungaanye kandi bwiyubashe, <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />mudatwarwa n'irari nk'uko abantu bataazi Imaana babigenza. <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />Kandi ntihakagire umuntu weese ugirira naabi umukristo mugenzi we cangwa ngo amurimanganye. Ibi twabibabwiye mbere kandi tubaamagirira twihanikiiriye, ko Nyagasani azaahana abakora ibyo. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />Kuko Imaana itaaduhamagariye ubukozi bw'ibibi, ahuubwo yaduhamagariye ubutungaane. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />Ni co gituma umuntu weese usuzugura ibyo twiigiisha, ataba asuzuguye ububaasha bw'umuntu, ahuubwo aba asuuzuguye Imaana ibaha Umwuka waayo Weera.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />Ibyerekeye urukundo rwa kivandimwe, ntimugomba kubyandikirwa, kuko mwe ubwanyu Imaana ni yo yabiigiishije gukundana. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />Kandi ni koko mukunda abiizeera boose bari muri Makedooniya, turabahuuguura kugira ngo mukomeze gukora mutyo ndetse murusheho. <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />Mugire umwete wo kuja mutuuza, mukore ibibareeba, kandi mukoreeshe amaboko yaanyu, nk'uko twababwiye. <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />Bityo reero muziiheesha agaciiro mu batiizeera, kandi mudafite ico mukennye.<verse eid="1TH 4:12" /></para>
  <para style="s1">Kugaruka kwa Kristo</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />Bavandimwe, dushaaka ko mumenya ibyerekeye abaasinziiriye kugira ngo mutababara nk'abandi badafite ibyiringiro. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />Ubwo twemera ko Yesu yapfuuye kandi yazuutse, abe ari ko twemera ko Imaana izaazana abaapfuuye beemera Yesu.<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:15 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 15:51">1 Kor 15:51</ref>,<ref loc="1CO 15:52">52</ref>.</char>
    </note>Ico tubabwira ubu n'ijambo rya Nyagasani yuuko twebwe abiizeera bakiriho, baasigaye kugeza ubwo Umwami azaazira, tutazabanziriza na hato abaasinziriye. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />Kuko Nyagasani ubwe, azaategeka n'ijwi riranguruye hamwe n'ijwi rya malayika mukuru, niry'impanda y'Imaana, nuuko abaapfuuye biizeeye Kristo abe ari bo babanza kuzuuka. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />Haanyuma, naatwe abazaaba bakiriho muri ico gihe, tujaananwe na bo mu bicu gusanganira Umwami mu kireere. Bityo tuzaabaane na Nyagasani iteeka ryose. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />Nuuko reero muje muhumurizanya muri ayo magambo.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s1">Kwiteguurira kugaruka k'Umwami</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />Bavandimwe, ibyerekeye ibihe n'iminsi ntimukeneye ko mbibandikira. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" /><note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 24:43">Mat 24:43</ref>; <ref loc="LUK 12:39">Luk 12:39</ref>; <ref loc="2PE 3:10">2Pet 3:10</ref>.</char></note>Kuko mwe ubwanyu muzi neeza ko umunsi w'Umwami uzaaza nk'uko umujuura aza nijoro. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />Ubwo abantu bazaaba bavuga bati, “Dufite amahoro n'umuteekaano,” niho kurimbuka kuzaabaazaho nk'uko ibise bitungura umugore wenda kubyara, kandi ntibazaabona ubuhungiro. <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />Ariko mwebwe bavandimwe, ntimukiri mu mwijima ku buryo uwo munsi wabatungura nk'umujuura. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />Kuko mwese muri abaana b'umuco n'abaana b'amanywa, ntituri ab'ijoro cangwa ab'umwijima. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />Noone reero reka twegusinzira nk'abandi, ahuubwo tube maaso, kandi tugire ibiteekerezo bizima. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />Kuko abasinziira basinziira nijoro, n'abasinda basinda nijoro. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" /><note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="EPH 6:13-17">Efe 6:13-17</ref>.</char></note>Ariko twebwe abiizeera ubwo turi ab'amanywa, tuje tugira ibiteekerezo bizima, twambaye kwizeera n'urukundo nk'icuuma gikingira igituuza, kandi dufite ibyiringiro byo kuzaabona agakiza nk'ingufiiri y'icuma. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />Kuko Imaana itatugeneye kurimburwa n'uburaakari bwayo, ahuubwo yadutooranyirije kubona agakiza kabonerwa m'Umwami waacu Yesu Kristo, <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />wadupfiiriye kugira ngo ni tuba tukiriho cangwa dusinziiriye tuzaabaane na we. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />Nuuko reero, muhuumurizanye kandi muteerane inkunga nk'uko musanzwe mubikora.<verse eid="1TH 5:11" /></para>
  <para style="s1">Guhuguurwa, Indamutso, n'Isengeesho ry'Umugisha</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />Turabinginga bavandimwe kugira ngo muje mushiima imirimo y'abo babashinzwe kandi babayobora mu buzima bwa gikristo, <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />mubuubahe mu rukundo ku bw'umurimo babakorera. Kandi namwe ubwanyu muje mubaana mu mahoro.<verse eid="1TH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14" />Kandi turabahuguura bavandimwe, muje mucaaha inkorabusa, mukomeze abaciika intege, mufashe abatiishoboye, mwihangaanire boose. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />Ntihakagire uwiituura undi inaabi yamugiriye, ahuubwo muharanire kugirirana ineeza, ndetse muyigirire boose.<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />Muje mwishiima iteeka, <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />musenge ubudasiiba. <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />Mu bibaho byose mushiime Imaana, kuko ari byo Imaana ibashaakaho muri Kristo Yesu.<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />Ntimugahagarike Umwuka Weera <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />kandi ntimugahinyure amagambo y'ubuhanuuzi, <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />ahuubwo mugenzuure byose, mugundiire ibyiza, <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />mwange ikibi coose.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />Turasaba Imaana ubwayo itanga amahoro ngo ibeeze mu buryo bwose, irinde umwuka waanyu, n'ubugingo n'umubiri, kugira ngo bitazaabaho umugayo kugeza ku kugaruka k'Umwami waacu Yesu Kristo. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />Imaana yabahamagaye ntiihemuka, ibyo yavuze izaabikora.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />Bavandimwe, mudusabire.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />Muramukanye n'abavandimwe boose muguhooberana kutaryaya.<verse eid="1TH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />Ndabihanangiririza nkomeje, ku bw'ububaasha nahaawe na Yesu Kristo muzaasomere uru rwandiko abavandimwe boose.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />Ubuntu bw'Umwami Yesu bubaane namwe.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>