<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">FILI- Rufumbira New Testament</book>
  <para style="h">FILIMOONI</para>
  <para style="toc3">Fili</para>
  <para style="toc2">FILIMOONI</para>
  <para style="toc1">Urwandiko Intumwa Pawulo yandikiye FILIMOONI</para>
  <para style="mt2">Urwandiko Intumwa Pawulo yandikiye</para>
  <para style="mt1">FILIMOONI</para>
  <para style="imt">INYANZURO</para>
  <para style="im">Filimooni yari umukristo w'ikirangirire kandi bishoboka ko yari mu itoorero ry'i Kolosiya kandi yari yaraguze Onesimaasi nk'imbaata ye. Onesimaasi yari yaratorotse kuri sheebuja. Muri uko gutoroka aza guhuura na Pawulo wari mu gihome ico gihe. Nuuko Pawulo abwiriza Onesimaasi maze aba umukristo. <char style="bk">Urwandiko Intumwa Pawulo yandikiye Filimooni</char> yarwanditse amusaba kwiyuzuza n'umugaragu we Onesimaasi uwo Pawulo yari agiiye kumwoherereza. Icaatumye amwandikira amwinginga ni uko muri ico gihe, umugaragu watorokaga sheebuja akagaruka, yiicwaga. Noone Pawulo yandikira Filimooni amwinginga kugira ngo yaakiire Onesimaasi. Pawulo ntiyasabaga Filimooni kwakiira Onesimaasi nk'umugaragu we wiihannye byonyine, ahuubwo yamusabaga ko amwakiira nk'umuvandimwe we muri Kristo.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Indamutso <char style="ior"><ref loc="PHM 1:1-3">1-3</ref></char></para>
  <para style="io1">Gushiimagiza Filimooni <char style="ior"><ref loc="PHM 1:4-7">4-7</ref></char></para>
  <para style="io1">Pawulo Yingingira Onesimaasi <char style="ior"><ref loc="PHM 1:8-22">8-22</ref></char></para>
  <para style="io1">Umusoozo <char style="ior"><ref loc="PHM 1:23-25">23-25</ref></char></para>
  <para style="is1">Indamutso</para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />Njeewe Pawulo, washizwe mu gihome mpoorwa Yesu Kristo, na mwene Daata Timoteeyo,</para>
  <para style="p" vid="PHM 1:1">Turakwandikiye wowe Filimooni inshuti yaacu dukunda kandi uwo dufatanyije gukora umurimo wa Kristo, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" /><note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="COL 4:17">Kol 4:17</ref>.</char></note>na mushiki waacu Afiya, na Arukipo uwo dufatanyije urugamba, hamwe n'itoorero riteeranira mu rugo rwawe.<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />Tubiifuuriza ubuntu n'amahoro biva ku Maana Daata n'Umwami waacu Yesu Kristo.<verse eid="PHM 1:3" /></para>
  <para style="s">Urukundo no Kwizeera kwa Filimooni</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />Mwene Daata Filimooni, igihe coose nkwibuka mu masengeesho, mpora nshiima Imaana yanje <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />kuko numva bavuga urukundo ufitiye abantu b'Imaana boose n'ukuntu wiizeera Umwami Yesu. <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />Nkaba ngusengera ngo uko gusangira kwizeera kwawe kukubeere ukw'ingirakamaro kandi gutume urushaho kumenya iciiza coose kiri muri twe co duheeshwa no kuba muri Kristo. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />Ni koko mwene Daata, naneejeejwe caane kandi nkomezwa n'urukundo rwawe, yuuko wahuumurije abantu b'Imaana.<verse eid="PHM 1:7" /></para>
  <para style="s">Pawulo Asabira Onesimaasi Imbabazi</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />Ku bw'ibyo reero, nakagutegetse nshize amanga nka mwene daata muri Kristo gushikiriza inshingano zaawe, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />ariko ku bw'urukundo ngufitiye, mpisemo kugusaba nkwinginga. Njeewe Pawulo ibi mbikoze nk'umugabo mukuru kandi ubu nkaba ndi mu gihome nzira Kristo. <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" /><note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="COL 4:9">Kol 4:9</ref>.</char></note>Ndakwingingira umwana wanje muri Kristo, Onesimaasi, uwo nabyaye mu mwuka ndi umusibe. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />Mbere, nta kamaro yari agufitiye, ariko ubu adufitiye akamaro twembi.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />Ndamukooherereje reero, umwakiire nk'inkoramutima yanje. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />Nashaakaga kugumana nawe hano ngo ankorere mu mwanya waawe ndi mu gihome mpoorwa Ubutumwa Bwiza, <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />ariko nahisemo kutagira ico nkora utabinyemereye, kugira ngo ineeza wagira uyigire ku gushaaka kwawe atari ku gahato.<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />Ahaari, icaatumye agutorokaho igihe gito ni ukugira ngo akugarukire muzaabane burundu, <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />atakiri imbaata ahuubwo aruta imbaata, ari umuvandimwe muri Kristo ukundwa. Njeeweho, ni ko amereye, naawe ni ko azaakumerera ndetse arusheho, ari ku by'umubiri cangwa kuri Nyagasani.<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />Nuuko reero niiba weemera ko dufatanyije umurimo, umwakiire nk'uko waakaanyakiriye. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />Niiba hari uko yagushobereje, cangwa akaba hari ico yakunyaze, ube ari nje ubibaraho. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />Njeewe Pawulo, mbyiyandikiye n'ukuboko kwanje: nzaabyishura. Sinarinkwiriye kukwibutsa yuuko wowe ubwawe uri umwenda wanje. <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />Nuuko reero mwene Daata, ndakwinginze weemere gusaba kwanje ku bwa Nyagasani, maze nka mwene Daata muri Kristo uhuumurize umutima.<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />Nkwandikiye niringiye yuuko uzanyumvira, nzi neeza yuuko uzaakora n'ibiruta ibyo mvuze. <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />Ikindi kandi, unteguurire igisenge c'abashitsi, mfite ibyiringiro ko amasengeesho yaanyu azaasubizwa bakandekura nkabagarukamo.<verse eid="PHM 1:22" /></para>
  <para style="s">Pawulo Aseezera Filimooni</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:23 </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">Kol 1:7</ref>; <ref loc="COL 4:12">4:12</ref>.</char>
    </note>Epafura, uwo dusibwe hamwe turyora Yesu Kristo aragutaasha, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" /><note caller="-" style="x"><char style="xo" closed="false">1:24 a </char><char style="xt" closed="false"><ref loc="ACT 12:12">Iby 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">Kol 4:10</ref>; </char><char style="xo" closed="false">b </char><char style="xt" closed="false"><ref loc="ACT 19:29">Iby 19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="COL 4:10">Kol 4:10</ref>; </char><char style="xo" closed="false">c </char><char style="xt" closed="false"><ref loc="COL 4:14">Kol 4:14</ref>; <ref loc="2TI 4:10">2 Tim 4:10</ref>; </char><char style="xo" closed="false">d </char><char style="xt" closed="false"><ref loc="COL 4:14">Kol 4:14</ref>; <ref loc="2TI 4:11">2 Tim 4:11</ref>.</char></note>na Mariko, Arisitariko, Dema hamwe na Luka dusangiye umurimo, na bo baragutaasha.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />Ubuntu bw'Umwami Yesu Kristo bube muri mwe. Amiina.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>