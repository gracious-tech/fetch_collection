<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Rufumbira New Testament</book>
  <para style="h">3 YOHAANA</para>
  <para style="toc1">Urwandiko rwa gatatu rwanditswe na YOHAANA</para>
  <para style="toc2">3YOHAANA</para>
  <para style="toc3">3 Yoh</para>
  <para style="mt2">URWANDIKO RWA GATATU RWANDITSWE NA</para>
  <para style="mt1">YOHAANA</para>
  <para style="imt">INYANZURO</para>
  <para style="im">
    <char style="bk">Urwandiko rwa gatatu rwanditswe na Yohaana</char> Umukuru w'itoorero, arwandikira umuyobozi wiitwaga Gaayo. Umwanditsi ashiimagiza Gaayo ku bw'ubufasha akomeza guheereza abandi bakristo no kumwihanangiriza kwirinda umugabo wiitwa Diyotirefesi.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro <char style="ior"><ref loc="3JN 1:1-4">1:1-4</ref></char></para>
  <para style="io1">Gaayo ashiimagizwa <char style="ior"><ref loc="3JN 1:5-8">1:5-8</ref></char></para>
  <para style="io1">Diyotirefesi avunanwa <char style="ior"><ref loc="3JN 1:9-10">1:9-10</ref></char></para>
  <para style="io1">Demetiriyo ashimwa <char style="ior"><ref loc="3JN 1:11-12">1:11-12</ref></char></para>
  <para style="io1">Umusoozo <char style="ior"><ref loc="3JN 1:13-15">1:13-15</ref> </char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s1">Indamutso</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">Iby 19:29</ref>; <ref loc="ROM 16:23">Rom 16:23</ref>; <ref loc="1CO 1:14">1 Kor 1:14</ref>.</char>
    </note>Njeewe Mukuru w'itoorero ndakwandikiye Gaayo nshuti yanje nkunda by'ukuri.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Nshuti yanje nkunda, nkwifuriza imibeereho myiza n'ubuzima bwiza nk'uko umutima waawe umeze neeza. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Nariishimye caane ubwo abavandimwe bamwe bangezeho bakambwira uko ushikamye mu kuri nk'uko wahoze ubigenza. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Ntaakinshiimiisha nko kumva abaana banje bagendera mu kuri.<verse eid="3JN 1:4" /></para>
  <para style="s1">Gaayo Ashiimagizwa</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Nshuti yanje nkunda uri umwiringirwa mu mirimo ukorera abavandimwe baawe, nuubwo baaba ari abanyamahanga. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />Baatanze ubuhamya imbere y'itoorero iby'urukundo wabagiriye. Nyaabuna ubafashe uko bishoboka kugira ngo bakomeze urugendo rwabo mu buryo bwo gushiimiisha Imaana. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Kuko baatangiye urugendo rwabo kubwa Kristo, bataakiira ubufasha kuva mu bateemera Kristo. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Noone reero twebwe abeemera Kristo dukwiriye kubashigikira kugira ngo na bo bafatanye naatwe gukorera ukuri.<verse eid="3JN 1:8" /></para>
  <para style="s1">Diyotirefesi na Demetiriyo</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Hari ico nandikiye itoorero, ariko Diyotirefesi ukunda kwishira heejuru nk'umuyoboyozi ntaabwo aha agaciiro ibyo mvuga. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Noone reero nindamuka nje, nzaashira kumugaragaro ibyo akora mu buryo bwo kudusebya. Kandi ibyo birego ntibihaagije, ahuubwo yanga no kwakiira abiizeera kandi akabuza n'ababishaaka, akabiirukana mu itoorero.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Bakundwa, ntimwigaane ikibi ahuubwo mwigaane iciiza. Umuntu weese ukora iciiza aba aturuka ku Maana ariko uwo weese ukora ikibi aba ataraabona Imaana.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />Naho Demetiriyo, abantu boose bahamya ibyiza bye kandi ukuri na ko kurabihamya. Naatwe ubwacu turabihamya kandi muuzi neeza yuuko ubuhamya bwacu ari ubw'ukuri.<verse eid="3JN 1:12" /></para>
  <para style="s1">Guseezera</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Mfite byinshi byo ku kwandikira ariko sinshaaka ko mbikwandikira nkoreesheje ikaraamu n'urupapuro, <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />ahuubwo niiringiye ko nzaakubona vuba, ni bwo tuzaavugana amaaso ku yandi.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Amahoro abe kuri wowe. Inshuti zikooherereje indamutso. Uramutse inshuti ubaana na zo buri umwe mu izina rye.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>