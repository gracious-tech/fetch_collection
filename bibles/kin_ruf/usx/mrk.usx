<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Rufumbira New Testament</book>
  <para style="h">MARIKO</para>
  <para style="toc3">Mar</para>
  <para style="toc2">MARIKO</para>
  <para style="toc1">Ubutumwa bwiza uko bwanditswe na MARIKO</para>
  <para style="mt2">Ubutumwa bwiza uko bwanditswe na</para>
  <para style="mt1">MARIKO</para>
  <para style="imt">INYANZURO</para>
  <para style="im">
    <char style="bk">Ubutumwa bwiza uko bwanditswe na Mariko</char> butangiranya n'amagambo avuga ngo, “Ubutumwa bwiza bwa Yesu Kristo, Umwana w'Imaana.” Yesu yeerekanwa nk'umuntu w'ibikorwa n'ubushobozi. Ubushobozi bwe bugaragarira mu nyigiisho ze, ububaasha bwo kwirukana abadayimooni no kubabarira abantu ibyaha. Yesu yiivugaho nk'umwana w'umuntu, waaje gutanga ubugingo bwe kugira ngo abantu bababarirwe ibyaha.</para>
  <para style="ip">
    <char style="bk">Mariko</char> yeerekana n'imbaraga ibyerekeye Yesu ntaaco ahisha, kandi ashimangira ibyo Yesu yakoze atari mu magambo n'inyigiisho ze gusa. Nyuma y'ibivugwa kuri Yohaana Umubatiza, kubatizwa no kugeragezwa kwa Yesu, umwanditsi yavuze k'ubuheereza bwa Yesu bwo gukiza no kwigiisha. Nyuma y'igihe abiigiishwa be baarushijeho kumusobaanukirwa, naho abaamuhakanyaga barushaho kumurwanya. Ibice bya nyuma by'ubu butumwa byerekana iminsi ya nyuma ya Yesu yo ku isi, caane caane kubambwa no kuzuuka kwe.</para>
  <para style="ip">Ubuce bubiri bwa nyuma bw'ubu butumwa buri mu kagote, bujanwa nk'ubwanditswe n'undi muntu utari <char style="bk">Mariko</char></para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Intangiro y'Ubutumwa <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref> </char></para>
  <para style="io1">Ubuheereza bwa Yesu muri Galileeya <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref> </char></para>
  <para style="io1">Kuva i Galileeya kugera i Yerusaalemu <char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref> </char></para>
  <para style="io1">Icumweru ca nyuma i Yerusaalemu no haafi yaayo <char style="ior"><ref loc="MRK 11:1-15:47">11:1—15:47</ref></char></para>
  <para style="io1">Kuzuuka kwa Yesu <char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref> </char></para>
  <para style="io1">Kwiyeerekana no kuzaamuuka k'Umwami wazuutse <char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref> </char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s1">Inyigiisho ya Yohaana Umubatiza</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>; <ref loc="LUK 3:1-18">Luk 3:1-18</ref>; <ref loc="JHN 1:19-28">Yoh 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Ubu ni Ubutumwa bwiza bwa Yesu Kristo Umwana w'Imaana<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera ntaabwo bifite </char><char style="fq" closed="false">Umwana w'Imaana </char></note>. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Bwatangiye nk'uko umuhanuuzi Yesaaya<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe bivuga, </char><char style="fqa" closed="false">Mu bahanuuzi</char></note> yanditse ati,</para>
  <para style="q1" vid="MRK 1:2">“ ‘Nzaatuma integuuza yanje mbere yaawe,</para>
  <para style="q2" vid="MRK 1:2">Izaaguteguurira inzira yaawe.’<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />Ijwi ry'uvugira mu butaayu aranguruye ati,</para>
  <para style="q2" vid="MRK 1:3">‘Nimutungaanye inzira y'Uhoraho,</para>
  <para style="q2" vid="MRK 1:3">mugorore inzira ze!’ ”<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Yohaana Umubatiza yaje mu butaayu abwiriza abantu iby'umubatizo wo kwihana kugira ngo bababarirwe ibyaha. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Abantu batuuye mu gice c'i Yudeeya n'ab'i Yerusaalemu boose baja aho ari, ababatiriza mu ruuzi rwa Yorodaani, baatura ibyaha byabo. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />Yohaana yambaraga imyambaro ikozwe mu bwoya bw'ingamiya, agakenyeza umushumi w'uruhu. Ibyokurya bye byari inzige n'ubuuki bw'ubuhura. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Yabwirizaga avuga ati, “Undusha ububaasha azaaza haanyuma yanje, sinkwiriye no kuunama ngo mfunduure udushumi tw'ingato ze. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Njeewe ndababatiriisha amaazi, ariko we azaababatiriisha Umwuka Weera.”<verse eid="MRK 1:8" /></para>
  <para style="s1">Kubatizwa kwa Yesu</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">Mat 3:13—4:11</ref>; <ref loc="LUK 3:21">Luk 3:21</ref>,<ref loc="LUK 3:22">22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Muri iyo minsi, Yesu ava i Nazaareeti muri Galileeya aza ngo Yohaana amubatirize muri Yorodaani. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Akiva mu maazi abona ikireere gitandukanye, Umwuka Weera amumanukiraho asa n'inuma.<figure style="fig" alt="The Holy Spirit, in form of a dove descended upon Jesus" file="DD-04B.TIF" size="col" loc="Darwni" copy="The British and Foreign Bible Society" ref="1:10">Umwuka Weera, ari mu ishusho ry'inuma amanukira kuri Yesu.</figure> <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" /><note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 9:7">Mar 9:7</ref>; <ref loc="LUK 3:22">Luk 3:22</ref>.</char></note>Nuuko ijwi rituruka mu ijuru riti, “Uri Umwana wanje nkunda nkakwishiimira.”<verse eid="MRK 1:11" /></para>
  <para style="s1">Kugeragezwa kwa Yesu</para>
  <para style="r">(<ref loc="MAT 4:12-22">Mat 4:12-22</ref>; <ref loc="LUK 4:14-15">Luk 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Ako kaanya, Umwuka amujaana mu butaayu. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Yamaze mu butaayu iminsi mirongo ine, ageragezwa na Sataani. Yabaanaga n'inyamaaswa zo mu ishamba, abaamalayika bamuheereza.<verse eid="MRK 1:13" /></para>
  <para style="s1">Intangiriro y'Ubuheereza bwa Yesu muri Galileeya</para>
  <para style="r">(<ref loc="MAT 4:12-22">Mat 4:12-22</ref>; <ref loc="LUK 4:14-15">Luk 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Haanyuma yo gusibwa kwa Yohaana, Yesu aja i Galileeya yaamamaza Ubutumwa Bwiza bw'Imaana, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" /><note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat 3:2</ref>.</char></note>avuga ati, “Dore igihe kirasohoye, Ubwami bw'Imaana buri haafi. Mwihane, mwizeere Ubutumwa Bwiza.”<verse eid="MRK 1:15" /></para>
  <para style="s1">Yesu Ahamagara Abiigiishwa ba mbere</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Yesu anyura iruhande rw'ingezi y'i Galileeya, abona Simooni na mwene se Andereya barobeesha ubutimba mu ngezi, kuko baari abarobyi. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yesu arababwira ati, “Nimunkurikire, nzaabagira abarobyi b'abantu.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Ako kaanya basiga ubutimba baarobeshaga baramukurikira. <verse eid="MRK 1:18" /><verse number="19" style="v" sid="MRK 1:19" />Yigiye imbere gato abona Yaakobo mwene Zebedaayo na Yohaana mwene se, na bo bari aho batunganya ubutimba bwabo mu bwato. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Arabahamagara, maze ako kaanya basiga se Zebedaayo mu bwato n'abakozi be, baramukurikira.<verse eid="MRK 1:20" /></para>
  <para style="s1">Umuntu Uteewe na Dayimooni</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luk 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Yesu n'abiigiishwa be baja i Kaperenawumu, ku Isaabato yakurikiyeho, yinjira mu isinagoogi, ariigiisha.<verse eid="MRK 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 1:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:28">Mat 7:28</ref>,<ref loc="MAT 7:29">29</ref>.</char>
    </note>Abantu batangaarira inyigiisho ze kuko yiigiishaga nk'ufite ububaasha, atameze nk'Abiigiishamategeko. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />Ako kaanya mu isinagoogi haarimo umuntu urimo umwuka mubi. <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />Arataka caane ati, “Uradushaakaho iki Yesu w'i Nazaareeti? Uje kuturimbura? Nzi uwo uri we, uri Uweera w'Imaana.” <verse eid="MRK 1:24" /><verse number="25" style="v" sid="MRK 1:25" />Yesu ategeka uwo mwuka mubi ati, “Ceceka, kandi muvemo.” <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />Nuuko uwo mwuka mubi uramutigita, uteera heejuru n'ijwi rirenga maze umuvamo. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Boose baratangaara, maze bariibaza bati, “Ibi ni ibiki? Ko ari imyigiishirize idasanzwe! Ategeka n'imyuka mibi ikamwumvira.” <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Nuuko iyo nkuru yaamamara hoose muri Galileeya.<verse eid="MRK 1:28" /></para>
  <para style="s1">Yesu Akiriza Abantu Benshi mu Nzu ya Simooni</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat 8:14-17</ref>; <ref loc="LUK 4:38-41">Luk 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Bamaze gusohoka mu isinagoogi, binjira mu nzu ya Simooni na Andereya, bari kumwe na Yaakobo na Yohaana. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Nyirabukwe wa Simooni yari aryamye afite umuriro mwinshi, haanyuma bamubwira ibimufasheho. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Yesu aramwegeera, amufata ukuboko, aramuhagurutsa, umuriro umuvamo, atangira kubazimaanira. <verse eid="MRK 1:31" /><verse number="32" style="v" sid="MRK 1:32" />Kuri uwo mugorooba, izuuba rirenze bamuuzanira abarwayi boose n'abateewe n'abadayimooni. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Abo muri iyo tawuni boose bateeranira imbere y'iyo nzu. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Maze akiza benshi baari barwaye indwara zitandukanye, yiirukana abadayimooni benshi, kandi ntiyabeemerera ko bavuga, kuko baari baazi uwo ari we.<verse eid="MRK 1:34" /></para>
  <para style="s1">Yesu Abwiriza i Galileeya</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luk 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Mu gitondo kare kare, hataraabona, Yesu arahaguruka, arasohoka, aja kwihereera mu mwanya utarimo abantu, nuuko arasenga. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Simooni n'abandi baari kumwe baja kumushaaka. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Bamuboonye, baramubwira bati, “Buri muntu ari kugushaaka.”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Yesu arabasubiza ati, “Nimureke tuje mu ma tawuni mato atwegeereye, kugira ngo na bo mbabwirize, kuko ari co canzanye.”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:23">Mat 4:23</ref>; <ref loc="MAT 9:35">9:35</ref>.</char>
    </note>Yitooroora igice c'i Galileeya coose, abwiriza mu masinagoogi kandi yiirukana abadayimooni.<verse eid="MRK 1:39" /></para>
  <para style="s1">Yesu Akiza Umubembe</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat 8:1-4</ref>; <ref loc="LUK 5:12-16">Luk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Umuntu wari urwaye ibibembe<note caller="+" style="f"><char style="fr" closed="false">1:40 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera bivuga ngo, Uwari ufite indwara nyinshi.</char></note> aza aho ari, apfukama imbere ye, aramwinginga amubwira ati, “Ubishaatse wankiza.”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Yesu amugirira imbabazi, arambuura ukuboko, amukoraho aravuga ati, “Ni co nshaaka, kira!” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Ako kaanya ibibembe birakira, arahumaanuka. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Mukumuseezerera Yesu aramwihanangiriza caane, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />aramubwira ati, “Uramenye, utagira uwo ubibwira, ariko ugende, wiiyereke Umuheerezabitambo, kandi utuure n'ituuro ryo kwihumaanura nk'uko Moose yategetse, kugira ngo bibabeere ubuhamya ko wakize.”<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Ariko uwo muntu akigenda, atangira kwamamaza iyo nkuru, ayikwiza hoose mu tawuni. Ibyo byatumye Yesu aguma mu myanya idatuuwe n'abantu, abaamushaakaga kuva mu mpande zoose akaba ari yo bamusanga.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s1">Yesu Akiza Umuntu Umugaye</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat 9:1-8</ref>; <ref loc="LUK 5:17-26">Luk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Hashize iminsi mike, Yesu asubira i Kaperenawumu, abantu boose bamenya ko ari mu rugo. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Benshi bateeranira hamwe, ntihaagira akaanya na gato gasigara ko kwinjiriramo. Nuuko Yesu ababwiriza ubutumwa. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Bidatinze, haaza abantu bane baheetse umuntu umugaye. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Kubw'ubwinshi bw'abantu bari buuzuye aho, baabuze aho kumunyuza, maze bapfumura heejuru y'inzu aharinganiye n'aho Yesu yari ari, buururutsa ingobyi baari baheetsemo uwo wari umugaye.<figure style="fig" alt="When they failed to get where to pass, they made a hole on the roof and lowered the sick person through it." file="DD-19A.TIF" size="col" loc="Darwin" copy="The British and Foreign Bible Societies" ref="2:4">Babuze aho kunyura, bapfumura heejuru y'inzu banyuzamo umurwayi.</figure> <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Yesu aboonye uko kwizeera kwabo, abwira uwo wari umugaye ati, “Mwana wanje, ibyaha byawe urabibabariwe.”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Bamwe mu biigiishamategeko baari biicaye aho batangira kwibaza mu mitima yaabo bati, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“Ni iki giteeye uyu kuvuga atyo? Asebya Imaana! Ni nde waabaasha kubabarira ibyaha atari Imaana yoonyine?”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Muri ako kaanya Yesu amenya ibyo baateekerezaga nuuko arababwira ati, “Ni iki kibateera guteekereza mutyo? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Mbese ikibooroheye ni iki? Ni uko nabwira uyu muntu umugaye nti, ‘ubabariwe ibyaha,’ cangwa kumubwira ngo, ‘Haguruka, wikorere ingobyi yaawe, ugende’? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Ndabahamiriza yuuko, Umwana w'Umuntu afite ububaasha hano ku isi bwo kubabarira ibyaha.” Abwira wa mugabo umugaye ati, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“Ndagutegetse, haguruka, wiikorere ingobyi yaawe, ugende!”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Ako kaanya, uwo mugabo arahaguruka, yiikorera ingobyi yari aheetswemo agenda vuba vuba boose babireeba. Abantu baratangaara caane, basingiza Imaana bati, “Nta na rimwe twigeze tubona ibintu nk'ibi!”<verse eid="MRK 2:12" /></para>
  <para style="s1">Yesu Ahamagara Leevi Umusoreesha</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat 9:9-13</ref>; <ref loc="LUK 5:27-32">Luk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Yesu yongera kuja iruhande rw'inyanja, abantu benshi baramwitooroora, maze arabiigiisha. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Nuuko akigenda, abona Leevi mwene Alufaayo yiicaye aho yasoreesherezaga, aramubwira ati, “Nkurikira.” Leevi aheerako, arahaguruka aramukurikira.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Ubwo Yesu yari kwa Leevi barya ifunguro rya nimugoroba, abasoreesha benshi n'abanyabyaha na bo baari biicaranye na Yesu n'abiigiishwa be kuko haari benshi baamukurikiye. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Bamwe mu biigiishamategeko b'Abafarisaayo baboonye Yesu ari gusangira n'abanyabyaha hamwe n'abasoreesha,<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera bongeraho. </char><char style="fqa" closed="false">N'abasinzi</char></note> babaza abiigiishwa be bati, “Ni iki gituma asangira n'abantu bameze batyo?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Yesu abyumviise arabasubiza ati, “Abazima si bo bakeneye umuvuuzi, ahuubwo abarwayi ni bo bamukenera. Sinazanywe no guhamagara intungaane ahuubwo naaziye abanyabyaha.”<verse eid="MRK 2:17" /></para>
  <para style="s1">Yesu Bamubaza ku byo Kwiyiriza Ubusa</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat 9:14-17</ref>; <ref loc="LUK 5:33-39">Luk 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Igihe kimwe abiigiishwa ba Yohaana hamwe n'Abafarisaayo baari biyirije ubusa. Abantu baaza kubaza Yesu bati, “Ni mpamvu ki abiigiishwa ba Yohaana n'Ababafarisayo baja biiyiriza ubusa, ariko wowe abawe ntibabikore?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Yesu arabasubiza ati, “Mbese muteekereza ko abashitsi baaraaritswe mu bukwe baabwirirwa bakiri n'umukwe?<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera ntibongeraho </char><char style="fqa" closed="false">Bakiri n'umukwe.</char></note> Ntibishoboka! Bakiri n'umukwe ntibaakwiyiriza ubusa. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Ariko igihe kizaagera ubwo umukwe azaabavanwamo nuuko baheereko biiyirize ubusa. <verse eid="MRK 2:20" /><verse number="21" style="v" sid="MRK 2:21" />Dore ntaawe uteera ikiremu gisha ku mwambaro ushaaje, uwabikora atyo, ikiremu gisha caawukurura ukarushaho gushishimuka. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Kandi ntawaasuka divaayi nsha mu mifuka y'impu ishaaje kuko uwaabikora atyo, iyo divaayi yaaturitsa imifuka y'impu kandi na yo ikameneka byombi akabipfiirwa. Ahuubwo, divaayi nsha bayisuka mu mifuka y'impu misha.”<verse eid="MRK 2:22" /></para>
  <para style="s1">Yesu Yiigiisha Ibifashe ku Isaabato</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat 12:1-8</ref>; <ref loc="LUK 6:1-5">Luk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Igihe kimwe Yesu yari ari kunyura mu mirima y'ingano hari ku Isaabato. Bakigenda, abiigiishwa be batangira guca amahundo. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Abafarisaayo babwira Yesu bati, “Ni kuki abiigiishwa baawe bakora ibiteemerewe ku munsi w'i Isaabato?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Yesu nawe arabasubiza ati, “Mbese ntimuraasoma uko Dawudi yabigenje ubwo yashaakaga icokurya kandi n'abo yari kumwe n'abo bashonje? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Yinjiye mu nzu y'Imaana ubwo Abiyatari yari Umuheerezabitambo mukuru, arya imigaati yari igenewe ituuro ry'Imaana, kandi ntaawemererwaga kuyirya keretse abaheerezabitambo. Ariko Dawudi we yarayiriiye, ahaho abaari kumwe na we.”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Yesu arababwira ati, “Isaabato yakorewe umuntu, ntaabwo ari umuntu wakorewe Isaabato. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Nuuko reero Umwana w'Umuntu n'umugenga w'Isaabato.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s1">Yesu Akiza Umugabo Unyuunyuutse Ukuboko</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat 12:9-14</ref>; <ref loc="LUK 6:6-11">Luk 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Nuuko Yesu yinjira mu sinagoogi, ahaari umugabo ufite ukuboko kunyuunyuukaye. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Baaramureebuuje kugira ngo bareebe niiba aramukiza ku Isaabato, maze babone uko bamurega. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Yesu abwira wa mugabo ufite ukuboko kunyuunyuukaye ati, “Ngwino hano.” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Nuuko abaza abantu ati, “Amategeko atwemerera gukora iki ku Isaabato? Gukora neeza cangwa kwangiriza, gukiza cangwa kwica?”</para>
  <para style="p" vid="MRK 3:4">Ariko ntibaagira ico bavuga. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Yesu abareebana uburaakari, ababazwa nuuko imitima yaabo yiinangiye ni ko kubwira wa muntu ati, “Rambuura ukuboko kwawe.” Arakurambuura kurakira. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Abafarisaayo barasohoka batangira kuja imigambi hamwe n'aba Herodi ngo babone uburyo bwo kwica Yesu.<verse eid="MRK 3:6" /></para>
  <para style="s1">Abantu Benshi ku Nkengeero y'Inyanja.</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yesu n'abiigiishwa be baja ku nyanja y'i Galileeya abantu benshi baramukurikira. Baari baturutse i Galileeya n'i Yudeeya, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />bumviise ibyo ari gukora, bamuuzaho mu bwinshi bavuuye i Yudeeya, i Yerusaalemu, Idumeya, no hiirya ya Yorodaani no mu gace k'i Tiiro n'i Sidoni. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" /><note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MRK 4:1">Mar 4:1</ref>; <ref loc="LUK 5:1-3">Luk 5:1-3</ref>.</char></note>Abantu baari benshi caane ku buryo Yesu yabwiye abiigiishwa be kumuteguurira ubwato, agira ngo abantu batamubyiga. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Yari akijije n'abantu benshi, naho abo baari bakirwaye baguma babyigana kugira ngo bamukoreho. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Buri uko imyuka mibi yamubonaga, yatumaga abo baari bateewe na yo, bikubita imbere ye, bagateera heejuru bavuga bati, “Uri Umwana w'Imaana!”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />Yesu yategekaga imyuka mibi kutagira uwo ibwira uwo ari we.<verse eid="MRK 3:12" /></para>
  <para style="s1">Yesu Atooranya Intumwa Cumi n'Ebyiri</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat 10:1-4</ref>; <ref loc="LUK 6:12-16">Luk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Haanyuma Yesu azaamuuka umusozi ahamagara abo ashaaka, baramusanga. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Atooranyamo cumi na babiri, abo yiise intumwa kugira ngo babaane na we nuuko abatume kuvuga ubutumwa, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />kandi abaha ububaasha bwo kwirukana abadayimooni.<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />Aba ni bo ntumwa cumi n'ebyiri; Simooni uwo yiise Peetero, <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Yaakobo mwene Zebedaayo na Yohaana mwene se wa Yaakobo uwahaawe izina Bowanerige, risobanurwa ngo Abaana b'inkuba, <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Andereya, Filipo, Baritimaayo, Matayo, Tomasi, Yaakobo mwene Alufaayo, Tadewo, Simooni umurwanashaka, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />na Yuda Isikariyoti, uwagambaaniye Yesu.<verse eid="MRK 3:19" /></para>
  <para style="s1">Yesu na Bbelizebuulu</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mat 12:22-32</ref>; <ref loc="LUK 11:14-23">Luk 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Nuuko Yesu aja mu rugo rwo yataahagamo. Abantu benshi bongera guteerana, Yesu n'Intumwa ze babura umwanya wo kugira ico bafungura. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Beene waabo babyumviise, biihuutira kuhamuvaana, kuko abantu baavugaga bati, “Yaasaze!”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:34">Mat 9:34</ref>; <ref loc="MAT 10:25">10:25</ref>.</char>
    </note>Bamwe mu biigiishamategeko bavuuye i Yerusaalemu baravuga bati, “Yahanzweho na Bbelizebuulu! Ni umutware w'abadayimooni umuha ububaasha bwo kwirukana abadayimooni.”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Nuuko Yesu arabakoranya avugana na bo mu migani ati, “Sataani yaashobora ate kwirukana Sataani? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Iyo igihugu ciigabyemo ibice gihora gishaamiranye, ico gihugu kirasenyuka. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />N'umuryango wigabanyijemo ibice, nawo uba waaseenyutse. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Niiba reero ubwami bwa Sataani bwigabamo ibice, ntibwaramba, buraseenyuka bugashiraho.<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />Nta muntu ushobora kwinjira mu nzu y'umunyambaraga ngo asahure ibye keretse abanje kumuboha, haanyuma akabona uko asahura ibyo mu nzu ye.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />Ndababwira ukuri yuuko abantu baababarirwa ibyaha byabo byose, ndetse n'ibitutsi baaba baaratutse Imaana. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" /><note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luk 12:10</ref>.</char></note>Ariko umuntu weese utuka Umwuka Weera, ntaabwo azaababarirwa bibaho, kuko aba akoze icaaha c'iteeka ryose.” <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Yesu yavuze ibi abiteewe nuuko abantu bamwe baavugaga bati, “Yahanzweho n'umwuka mubi.”<verse eid="MRK 3:30" /></para>
  <para style="s1">Nyina wa Yesu n'Abavandimwe Be</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat 12:46-50</ref>; <ref loc="LUK 8:19-21">Luk 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Nyina wa Yesu n'abavandimwe be baraaza, bageze hanze, bamutumaho ngo aze babonane. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Abantu benshi baari bamukiikije nuuko baramubwira bati, “Nyoko na beene nyoko na bashiki baawe barihanze baragushaaka.”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Yesu arabasubiza ati, “Maama ni nde na beene maama ni bande?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Areeba abaari biicaye bamwitoorooye, aravuga ati, “Dore Maama na beene maama! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Umuntu weese ukora ibyo Imaana ishaaka, ni we mwene maama, ni we mushiki wanje, kandi ni we maama.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s1">Umugani w'Umubibyi</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat 13:1-9</ref>; <ref loc="LUK 8:4-8">Luk 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:1-3">Luk 5:1-3</ref>.</char>
    </note>Arongera atangira kwigiishiriza iruhande rw'inyanja. Abantu benshi caane barateerana, yinjira mu bwato bwari mu nyanja, abwicaramo, abandi bantu boose baguma imusozi, iruhande rw'inyanja. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Yesu abiigiisha byinshi mu migani ababwira ati, <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />“Nimutege amatwi! Umubibyi yasohoye imbuto aja kubiba. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Ubwo yabibaga, imbuto zimwe zigwa mu nzira, inyoni ziraaza zirazirya. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Izindi mbuto zigwa ku rutare rudafite itaka ryinshi, zimera vuba, kuko ubutaka bwari buke. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Izuuba rivuuye ziraraba, kuko zitaari zifite imizi ziruuma. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Izindi mbuto zigwa mu mahwa, zikurana nayo, amahwa arazipfukiranya, ntizeera imbuto. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Naho izindi zigwa mu butaka bwiza, zeera imbuto, zimwe mirongo itatu, izindi mirongo itandatu, izindi ijana.”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Yesu amaze kubaciira uwo mugani, arababwira ati, “Ufite amatwi yumva, niyumve!”<verse eid="MRK 4:9" /></para>
  <para style="s1">Yesu Asobaanura Umugani w'Umubibyi</para>
  <para style="r">(<ref loc="MAT 13:10-23">Mat 13:10-23</ref>; <ref loc="LUK 8:9-15">Luk 8:9-15</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Ubwo yari asigaye wenyine, abaari bamwegeereye na ba cumi na babiri bamusaba kubasobaanurira iby'iyo migani. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Nuuko arababwira ati, “Mwe mwahaawe kumenya amabanga y'Ubwami bw'Imaana, ariko abandi bo hanze, babyumva mu migani, <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />ku buryo,</para>
  <para style="q1" vid="MRK 4:12">‘Bareeba, ariko</para>
  <para style="q2" vid="MRK 4:12">ntibiitegereze,</para>
  <para style="q1" vid="MRK 4:12">bashobora kumva,</para>
  <para style="q2" vid="MRK 4:12">ariko ntibasobaanukirwe,</para>
  <para style="q1" vid="MRK 4:12">kugira ngo badahinduka</para>
  <para style="q2" vid="MRK 4:12">maze bakababarirwa.’ ”<verse eid="MRK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Yesu arababaza ati, “Mbese uwo mugani ntimuwusobaanukirwa? Noone se indi migani yoose muzaayisobaanukirwa mute? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Umubibyi ni ubiba ijambo ry'Imaana. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Imbuto zaaguuye mu nzira zigereeranywa n'abantu bumva iryo jambo, bamara kuryumva uwo mwanya Sataani akaaza akarikuura muri bo. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Kandi izaabibwe ku rutare, ni abaakiira ijambo ry'Imaana n'umuneezeero. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Ariko ntibashoore imizi muri ryo, biihangaana akaanya gato. Iyo bageze mu bikomeye cangwa kugeragezwa bahoorwa iryo jambo, uwo mwanya bava mu kwizeera. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Abandi bagereranywa n'izibibwa mu mahwa, ni abo bumva ubutumwa, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />ariko bakaguushwa n'iby'isi, nk'ubutunzi, irari ryo kwifuuza ibindi, reero iyo bibaaye byinshi mu mitima, bipfukiranya iryo jambo ntiryere imbuto. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Kandi izaabibwe ku butaka bwiza, ni abumva ijambo ry'Imaana, bakaryakiira, bakeera imbuto, umwe mirongo itatu, undi mirongo itandatu, undi ijana.”<verse eid="MRK 4:20" /></para>
  <para style="s1">Itaara Ryubitsweho Intonga</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luk 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">Mat 5:15</ref>; <ref loc="LUK 11:33">Luk 11:33</ref>.</char>
    </note>Yesu arababwira ati, “Mbese hari uwaakongeeza itaara maze akaryubikaho intonga cangwa akarishira munsi y'uburiri? Ahuubwo rishirwa ahagaragara kugira ngo rimurikire abari mu nzu. <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" /><note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">Mat 10:26</ref>; <ref loc="LUK 12:2">Luk 12:2</ref>.</char></note>Nuuko reero, nta caahishwe kitazaahishuurwa, cangwa icaakorewe mu ibanga kitazaamenyekana. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Ufite amatwi yumva, niyumve!”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:2">Mat 7:2</ref>; <ref loc="LUK 6:38">Luk 6:38</ref>.</char>
    </note>Arongera arababwira ati, “Mushire umutima ku byo mwumva. Indengo mugeramo ni yo namwe muzaagererwamo, ndetse muzaarushirizwaho. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" /><note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">Luk 19:26</ref>.</char></note>Abafite bazongeererwaho, ariko abadafite, bazaakwa n'ico baari bafite.”<verse eid="MRK 4:25" /></para>
  <para style="s1">Umugani Weerekana Uko Imbuto Zikura</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Yesu arongera arababwira ati, “Ubwami bw'Imaana bwagereranywa n'umuntu wabibye imbuto mu butaka, <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />iyo asinziriye akongera akabyuka n'ijoro no ku manywa, izo mbuto zikomeza gukura ku bwazo we ataazi uko zikura. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Ubutaka ubwabwo ni bwo bwera imyaka, habanza ingemwe zigakura, haanyuma hakaaza urusagi, hagaheruuka amahundo arimo impeke. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Imyaka iyo yeeze, nyirayo ayisaaruuriisha indiga kuko igihe c'isaaruura kiba kigeze.”<verse eid="MRK 4:29" /></para>
  <para style="s1">Ikigereranyo c'Ubwami bw'Imaana</para>
  <para style="r">(<ref loc="MAT 13:31-32">Mat 13:31-32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18-19">Luk 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Arongera arababwira ati, “Mbese ubwami bw'Imaana bwagereranywa n'iki? Cangwa se twabusobaanuza mugani ki? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Bwagereranywa n'akabuto ka Sinaapi, ni akabuto karusha izindi mbuto kuba gato ku isi. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Iyo kabibwe mu murima, karakura kakaba igiti kinini, kakagira amashami manini, inyoni zo mu kireere zikaarika ibyari byazo muri ayo mashami.”<verse eid="MRK 4:32" /></para>
  <para style="s1">Umumaro w'Imigani</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat 8:23-27</ref>; <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Uko ni ko Yesu yabwirizaga ubutumwa akoreesha imigani nk'iyo, na bo bagashobora kubisobaanukirwa, <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />ntiyigiishaga atabaciiriye imigani, ariko haanyuma agasobaanurira abiigiishwa be byose biihereereye.<verse eid="MRK 4:34" /></para>
  <para style="s1">Yesu Ategeka Umuyaga Gutuuza</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat 8:23-27</ref>; <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Uwo munsi bugoroobye, Yesu arababwira ati, “Reka twambuke tuje haakurya y'inyanja.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Abandi bantu benshi basigara aho, we n'abiigiishwa be baja mu bwato bwo yahozemo, andi maato aramukurikira. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Bacambuka haaza umuyaga mwinshi, imivumba itangira kwisuka mu bwato, maze bwenda kurengerwa. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yesu we, yari inyuma mu bwato, aryamye asinziiriye yiiseguye umusego, baramukangura baramubwira bati, “Mwigiisha, ntuubyitaayeho ko tugiiye gupfa?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Arakanguka maze ategeka umuyaga, abwira inyanja ati, “Ceceka! Tuuza!” Nuuko umuyaga urahoosha, habaho ituuze. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Yesu arababaza ati, “Ni iki kibateeye ubwoba? Nta kwizeera mufite?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Abiigiishwa baratiinya caane, barabazanya bati, “Mbese uyu ni muntu ki, wumvirwa n'umuyaga n'inyanja?”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s1">Yesu Akiza Umuntu Uteewe n'Abadayimooni</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat 8:28-34</ref>; <ref loc="LUK 8:26-39">Luk 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Yesu n'abiigiishwa be bagera haakurya y'inyanja y'i Galileeya, mu gihugu ca Geraseni<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fq" closed="false">Mu gihugu ca Geraseni </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera bivuga </char><char style="fqa">Mu gihugu c'Abagadareeni </char> cangwa <char style="fqa" closed="false">Gerasa </char></note>. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Akiva mu bwato, asanganirwa n'umuntu uvuye mu irimbi. Uwo muntu yari ateewe n'abadayimooni. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Yari atuuye mu bituuro. Nta muntu washoboraga kumuboha, nuubwo haaba gukoreesha injegeri. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Akenshi, baamuboheeshaga injegeri mu maboko, bakamwambika imihama mu maguru, ariko buri uko baamubohaga, injegeri zo mu maboko n'imihama yarabicaagaguraga. Nta muntu wari ufite imbaraga zo kumushobora. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Igihe coose, ku manywa na n'ijoro yazereeraga mu irimbi no ku busozi, ari kuvuza induuru kandi yiikebaguriisha amabuye.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Abona Yesu ahinguka haakurya, yiruka amusanga, amugezeho, aramupfukamira. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Amutakambira mu ijwi rirenga ati, “Yesu, Mwana w'Imaana isumba byose, uranshaakaho iki? Ndakwinginze, ntuunyice urupfu rw'agashinyaguro!” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Kuko yari yamubwiye ati, “Dayimooni, va muri uwo muntu!”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Yesu aramubaza ati, “Witwa nde?”</para>
  <para style="p" vid="MRK 5:9">Aramusubiza ati, “Nitwa Giteeronyamwinshi, kuko turi benshi!” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Nuuko yinginga Yesu caane kutabiirukana muri ico gihugu.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Haafi aho kuri uwo musozi, haari umugana w'ingurube ziri kuriisha. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Abo badayimooni binginga Yesu bati, “Niibura, twohereze twinjire muri ziriiya ngurube.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Arabeemerera, nuuko abo badayimooni bava muri wa muntu binjira muri izo ngurube, maze uwo mugana woose urindimukira kuri ako gacuri wisuuka mu nyanja urarohama. Izo ngurube zoose hamwe zaari nk'ibihumbi bibiri.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Abashumba baari baziragiye babiboonye, bariiruka, iyo nkuru bayikwiza hoose mu ma tawuni no mu byaro. Abantu baaza kureeba ibyabaaye iby'ari byo. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Bageze aho Yesu ari, basanga uwari uteewe n'abadayimooni benshi yiicaye kandi atuuje. Yari yambaye kandi afite ubwenge, bibateera ubwoba. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Abari baabyiboneye n'amaaso babiteekerereza abandi uko byagendeye uwo muntu wari uteewe n'abadayimooni n'ibyabaye kuri za ngurube.<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />Baheerako binginga Yesu kugira ngo abaviire mu caaro.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Yinjira mu bwato, wa muntu wo yari amaze gukiza abadayimooni aramwinginga ati, “Reka tugendane!”<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />Yesu ntiyabimwemerera, ahuubwo aramubwira ati, “Subira mu rugo muri beene waanyu ubabwire ibyiza Nyagasani agukoreye n'uko akugiriye impuhwe.”<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />Uwo muntu aheerako aragenda anyura mu ma tawuni cumi yaamamaza ibyo Yesu yamukoreye. Abaabyumviise boose baratangaara.<verse eid="MRK 5:20" /></para>
  <para style="s1">Yesu Akiiza Umugore no Kuzuura Umukoobwa wa Yayiro</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat 9:18-26</ref>; <ref loc="LUK 8:40-56">Luk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Ubwo Yesu yari amaze kwambukira mu bwato aja haakurya y'inyanja, abantu benshi barahateeranira, kandi yari iruhande rw'inyanja. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Umwe mu batware b'i Sinagoogi witwaga Yayiro araaza, amuboonye yikubita imbere y'ibirenge bye <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />aramwinginga caane ati, “Agakoobwa kanje kararembye, kagiiye gupfa. Nyaabuna ngwino ukarambikeho ibiganza, gakire, kabeho.”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />Yesu agendana na we. Abantu benshi bakurikira Yesu bamubyiga.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Muri bo, haari umugore wari urwaye indwara yo kuva, ayimaranye imyaka cumi n'ebyiri, <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />yari amaze igihe yiihangaanira ububabare bwinshi, kandi yari yaramariye ibye mu bavuuzi ariko ntihagire ico bamumarira ahuubwo akarushaho kuremba. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Yari yarumviise ibifashe kuri Yesu, nuuko aca mu imbaga y'abantu amuturuka inyuma akora ku mwenda we, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />kuko yibwiraga mu mutima ati, “Naaho naafata ku mwambaro we byonyine, ndakira.”<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />Ako kaanya aratsina, abyiyumvamo ko akize iyo ndwara. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Yesu ahita amenye ko imbaraga zimuvuuyemo, ahindukira abantu arababaza ati, “Ni nde ufashe ku mwambaro wanje?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Abiigiishwa be baramusubiza bati, “Urabona ukuntu abantu bari kukubyiganiraho, naawe ukabaza ngo ‘Ni nde ufashe ku mwambaro wanje?’ ”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Ariko Yesu akomeza kureeba impande zoose kugira ngo abone uwamufasheho. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Uwo mugore agira ubwoba bwinshi ahinda umushitsi, maze amwikubita imbere amubwiza ukuri kuko yari azi ibimaze kumubaho. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Yesu aramubwira ati, “Mwana wanje, kwizeera kwawe kuragukijije, genda amahoro maze ukire indwara yaawe.”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Yesu akivuga ibyo, hagira intumwa zivuuye kwa Yayiro zimubwira ziti, “Umukoobwa waawe amaze gupfa. Uracaaruhiriza iki Umwigiisha?”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Yesu ntiyiita ku byo baavugaga, maze abwira wa mutware w'i Sinagoogi ati, “wiitiinya, ahuubwo izeere.” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Ntihaagira uwo yeemerera kumukurikira keretse Peetero, Yaakobo na Yohaana mwene nyina wa Yaakobo. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Bageze kwa Yayiro, Yesu abona ko hari urusaku rw'abarira bacura imiboroogo. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Yinjira mu nzu arababwira ati, “Ni iki kibateera umudugararo no kuborooga? Umwana ntaabwo yapfuuye ahuubwo arasinziiriye!”<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />Baramuseka caane, abategeka ko baja hanze maze asigarana na se w'umwana na nyina hamwe n'abiigiishwa batatu yari yazanye na bo nuuko baja mu gisenge aho umwana ari.<verse eid="MRK 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 5:41" />Amufata ukuboko aramubwira ati, <char style="it">“Talisa, kumi,”</char> gisobaanurwa ngo, “Gakoobwa, byuka!”<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Ako kaanya ako gakoobwa karahaguruka gatangira kwitoorora aho ngaho. Kaari kamaze imyaka cumi n'ebyiri y'ubukuru. Birabatangaaza caane. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Yesu arabiihanangiriza ngo hatagira uwo babibwira, nuuko abategeka kugaburira uwo mwana.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s1">Ab'i Nazaareeti Bahinyura Yesu</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat 13:53-58</ref>; <ref loc="LUK 4:16-30">Luk 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Yesu avayo aja mu tawuni y'iwaabo, abiigiishwa be baramukurikira. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Ku munsi w'i Isaabato, atangira kwigiisha mu Sinagoogi, abenshi bamwumviise baratangaara, baravuga bati, “Uyu mugabo ibyo avuga abikuura he? Ubu ni buhanga ki yahaawe? Biriiya bitangaaza akora bikomooka he? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Uriiya si wa mubaaji tuuzi, umuhungu wa Mariya, akaba na mwene nyina wa Yaakobo na Yozesi, na Yuda na Simooni, kandi bashiki be ntidutuuranye?” Baheerako ntibamwemera.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:4 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 4:44">Yoh 4:44</ref>.</char>
    </note>Yesu arababwira ati, “Nta handi abahanuuzi basuuzugurirwa keretse mu gihugu c'iwaabo, muri beene waabo, ndetse no mu mago yaabo.”<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />Nuuko ntiyahakorera igitangaaza na kimwe, keretse abarwayi bake abo yarambikagaho ibiganza bagakira. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Yatangaajwe no kuteemera kwabo.</para>
  <para style="s1" vid="MRK 6:6">Yesu Atuma Abiigiishwa Cumi na Babiri</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">Mat 10:5-15</ref>; <ref loc="LUK 9:1-6">Luk 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Nuuko aja mu byaro yiigiisha abantu. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />Ahamagara ba bandi cumi na babiri, aboohereza babiri babiri, kandi abaha ububaasha bwo gutegeka abadayimooni. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Abategeka kutagira ico biitwaza ku rugendo, keretse inkoni yoonyine, nta mugaati, nta gikapu, nta mashilingi mu mifuka yaabo, <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />ariko bambare ingato z'urugendo kandi bekwitwaza undi mwambaro. <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Arababwira ati, “Inzu muzinjiramo yoose, muzaayigumemo kugeza igihe muzaaviira muri uwo mwanya. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" /><note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Iby 13:51</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luk 10:4-11</ref>.</char></note>Aho muzaagera ntibabaakiire bakanga no kubumva, mukihava, muzakunkumure umucuucu wo mu birenge byanyu, bibabeere ikimenyeetso co kubashinja.”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Nuuko baragenda babwira boose ko bakwiriye kwihana. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" /><note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">Yaak 5:14</ref>.</char></note>Biirukana abadayimooni benshi, kandi basiiga amavuta abarwayi benshi barakira.<verse eid="MRK 6:13" /></para>
  <para style="s1">Urupfu rwa Yohaana Umubatiza</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat 14:1-12</ref>; <ref loc="LUK 9:7-9">Luk 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:14">Mat 16:14</ref>; <ref loc="MRK 8:28">Mar 8:28</ref>; <ref loc="LUK 9:19">Luk 9:19</ref>.</char>
    </note>Umwami Herodi arabyumva, kuko izina rya Yesu ryari ryamamaye hoose. Bamwe baaravugaga bati, “Yohaana Umubatiza yazuutse mu bapfuuye ni co gituma afite ububaasha bwinshi bumukoreramo.”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Ariko abandi bakavuga bati, “Ni Eliya.”</para>
  <para style="p" vid="MRK 6:15">Naho abandi bati, “Ni umuhanuuzi nk'umwe mu bakeera.”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Ariko Herodi abyumvise, aravuga ati, “Yohaana wo naciiye igihanga, yaazuutse!” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" /><note caller="-" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="LUK 3:19">Luk 3:19</ref>,<ref loc="LUK 3:20">20</ref>.</char></note>Herodi ubwe yari yaroohereje abantu ngo bafate Yohaana, bamubohe bamushire mu gihome bamuryoje Herodiyaasi, muka mwene nyina Filipo, kuko Herodi yari amutunze. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Yohaana yari yarabwiye Herodi ati, “Binyuranye n'amategeko kugira ngo utunge muka mwene nyoko.”<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Ku bw'iyo mpamvu, Herodiyaasi amugirira inziika ashaaka no kumwica ariko ntiyabishobora. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Herodi yatiinyaga Yohaana, kuko yari azi ko ari intungaane kandi umuziranenge, bigatuma amurengera. Yakundaga kumva ibyo yamubwiraga n'ubwo byamubuzaga amahoro.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Nuuko Herodiyaasi abona umugisha ubwo Herodi yiizihizaga umunsi yavuukiyeho. Herodi yatumiye abatware, bakuru b'ingabo n'abandi banyacuubahiro b'i Galileeya. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Umukoobwa wa Herodiyaasi araaza arabyina, ashiimiisha Herodi n'abo yari yaatumiye, nuuko umwami abwira uwo mukoobwa ati, “Nsaba ico ushaaka coose, ndakiguha.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Aramurahira ati, “Ico uri bunsabe coose ndakiguha n'ubwo caaba kimwe ca kabiri c'igihugu canje.”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Umukoobwa arasohoka abaza nyina ati, “Nsabe iki?”</para>
  <para style="p" vid="MRK 6:24">Aramusubiza ati, “Saba igihanga ca Yohaana Umubatiza.”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Ako kaanya agaruka aho umwami ari yiihuuta, aramusaba ati, “Nshaaka ngo umpe noone aha igihanga ca Yohaana Umubatiza ku mbeehe.”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Umwami arababara caane, ariko ku bw'indahiro yari yarahiriye imbere y'abashitsi, atiinya guhemuka. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Ako kaanya umwami yoohereza umusirikare, amutegeka ko azana igihanga ca Yohaana. Aragenda amusanga mu gihome amuca umutwe, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />awuuzana ku mbeehe, maze awuha uwo mukoobwa, na we awuheereza nyina. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Abiigiishwa ba Yohaana babyumviise, baraaza bajaana umurambo we, barawuhamba.<verse eid="MRK 6:29" /></para>
  <para style="s1">Yesu Ahaaza Ibihumbi Bitaanu</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14:13-21</ref>; <ref loc="LUK 9:10-17">Luk 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoh 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Intumwa ziitooroora Yesu, zimubwira byose byo zaakoze n'ibyo ziigiishije. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Arazibwira ati, “Nimuuze mwenyine mu mwanya udatuuwe, maze muruhuukeho.” Kuko benshi baaraazaga bakagenda, bigatuma batabona umwanya wo kuruhuuka ndetse no kurya. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Maze binjira mu bwato boonyine baja ahadatuuwe.<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />Benshi bababoonye bagenda barabamenya, bagenda biihuuta n'amaguru bavuuye mu ma tawuni menshi babatangayo. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" /><note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="MAT 9:36">Mat 9:36</ref>.</char></note>Yesu amaze kwambuka abona abantu benshi, abagirira impuhwe, kuko baari bameze nk'intama zitagira umushumba, maze atangira kubiigiisha byinshi. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Umunsi ukuze, abiigiishwa be baramwegeera baramubwira bati, “Dore aha turi ntihatuuwe, kandi buriije, <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />baseezerere kugira ngo baje mu mpande zoose z'ibyaro bashobore kwigurira ibyokurya.”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Ariko we arababwira ati, “Nimubahe ibyokurya.”</para>
  <para style="p" vid="MRK 6:37">Baramubwira bati, “Uragira ngo tuje kugura imigaati iguze idinaari magana abiri, maze tubahe barye?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Arababaza ati, “Mufite imigaati ingahe? Nimuje kureeba.”</para>
  <para style="p" vid="MRK 6:38">Babiboonye, baramubwira bati, “Dufite imigaati itaanu, n'isamaaki ebyiri.”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Nuuko ategeka ko biicaza abantu ku gacaaca, mu dutsiko. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Maze biicara mu dutsiko tw'abantu ijana ijana, na mirongo itaanu mirongo itaanu. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Afata ya migaati itaanu n'isamaaki ebyiri, areeba ku ijuru, ashiimira Imaana, amaanyura ya migaati, ayiha abiigiishwa be ngo na bo bayihe abantu, nuuko na za samaaki ebyiri arazibagaburira. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Boose bararya barahaaga, <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />kandi hasigara intonga cumi n'ebyiri z'ubuvungunyukira bw'imigaati hamwe n'ubw'isamaaki. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Abo baariiye banganaga abagabo ibihumbi bitaanu.<verse eid="MRK 6:44" /></para>
  <para style="s1">Yesu Agendera ku Maazi</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat 14:22-33</ref>; <ref loc="JHN 6:15-21">Yoh 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Ako kaanya abwira abiigiishwa be kuja mu bwato kugira ngo bamubanzirize haakurya, i Beetsayida, we asigara aseezerera abantu. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Amaze kubaseezerera, azaamuuka umusozi aja gusenga. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Bugoroobye, ubwato bwari bugeze mu nyanja hagati, naho we yari akiri imusozi wenyine. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Aboonye ko barwana n'ingashi ku bw'umuyaga mwinshi, aza abasanga butari bwaca, agendera ku maazi. Yashaakaga kubanyuraho. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Ariko baboonye agendera heejuru y'inyanja, bateekereza ko ari umuzimu maze bateera induuru. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />Boose bamuboonye bakuuka umutima.</para>
  <para style="p" vid="MRK 6:50">Ariko ako kaanya avugana na bo arababwira ati, “Muhuumure, ni njeewe, mureke gutiinya.” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Abasanga mu bwato, maze umuyaga uratuuza. Barushaho gutangaara, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />kuko baari bataraasobaanukirwa iby'imigaati kandi n'imitima yaabo yari ikinangiye.<verse eid="MRK 6:52" /></para>
  <para style="s1">Yesu Akiza Abarwayi muri Genezareeti</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mat 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Bamaze kwambuka, bagera i Genezareeti, bazirika ubwato. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Bakiva mu bwato, ako kaanya abantu baramumenya. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Nuuko birukanka muri ako gace koose, batangira kuuzana abarwayi mu ngobyi babamusangiisha aho bumvaga ageze hoose. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Aho yajaga hoose, haaba mu byaro, mu ma tawuni, mu mirima, cangwa mu maguriro, baazanaga abarwayi maze bakamwinginga kugira ngo bishobotse abeemerere bakore ku nshonda y'umwenda we kandi abaawukoragaho boose baarakiraga.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s1">Ibihumaanya Abantu</para>
  <para style="r">(<ref loc="MAT 15:1-20">Mat 15:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Bamwe mu Bafarisaayo n'Abiigiishamategeko baari bavuuye i Yerusaalemu bateeranira aho Yesu ari. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />Babona bamwe mu biigiishwa be bariisha intoki zihumaanye, kimenyeesha ngo badakarabye intoki.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />Abayuuda boose na caane Abafarisaayo ntibaaryaga batabanje gukaraba intoki mu maazi ngo zibe zihumaanuwe, nk'uko baaseekuruza baabigenzaga. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Ubwo baabaga bavuuye mu maguriro, ntibakozaga ikintu ku munwa badakarabye. Hari n'indi migenzo baakuuye kuri baaseekuruza nko; kooza ibikopu, ibibindi n'amabbinika y'ibyuma.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Abafarisaayo n'Abiigiishamategeko babaza Yesu bati, “Ni iki gituma abiigiishwa baawe badakurikiza imigenzo karande y'abaatubanjirije, ahuubwo bakariisha intoki zihumaanye?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Yesu arabasubiza ati, “Yesaaya yabahanuuyeho neeza mwa ndyarya mwe, nk'uko byanditswe ngo,</para>
  <para style="q1" vid="MRK 7:6">‘Uyu muryango unyubahiisha akanwa</para>
  <para style="q2" vid="MRK 7:6">ariko imitima yaabo iri kure yanje.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Bansengera ubusa</para>
  <para style="q2" vid="MRK 7:7">kuko inyigiisho biigiisha ari amategeko y'abantu.’<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />Mwaretse itegeko ry'Imaana mukurikiza imigenzo y'abantu.”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Arababwira ati, “Mushaakashaakiisha uburyo bwo kwirengagiza itegeko ry'Imaana kugira ngo mukomeze imigenzo yaanyu. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Kuko Moose yavuze ati, ‘Wuubahe ababyeyi baawe’ kandi, ‘Uzaatuka se cangwa nyina akwiriye gupfa.’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Na ho mwebwe mukavuga muti, umuntu naabwira se cangwa nyina ati, ‘Ubufasha naakaguhaaye, nabugize Ituuro ry'Imaana.’ <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />Bibaaye bityo yemerewe kutagira ico afashiisha se cangwa nyina, <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />nuuko reero ijambo ry'Imaana mukariha agaciiro gake kugira ngo mukurikize imigenzo yaanyu yababaayemo akarande. Kandi mukora n'ibindi byinshi bisa bityo.”<verse eid="MRK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Yongera guhamagara abantu benshi arababwira ati, “Muntege amatwi mwese, musobaanukirwe. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Nta kintu kija mu nda y'umuntu kivuuye hanze caamuhumaanya, ukuuyeho icaamuhumaanya, n'ikiva mu mutima we.” <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Ufite amatwi yumva ni yumve. <verse eid="MRK 7:16" /><verse number="17" style="v" sid="MRK 7:17" />Amaze kuva muri abo bantu, yinjira mu nzu, nuuko abiigiishwa be bamusaba ko yabasobaanurira ico uwo mugani umenyeesha. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Yesu arababaza ati, “Koko namwe nta co muuzi? Ntimureeba ko nta kija mu nda kivuuye inyuma caabaasha guhumaanya umuntu, <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />kuko kitaja mu mutima we ahuubwo kija munda, kikongera kigasohoka kikaja mu coorooni?” Bityo reero yemeza ko nta byokurya bihumaanya.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Nuuko arababwira ati, “Ikiva mu muntu ni co kimuhumaanya, <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Kuko mu mitima y'abantu haturukamo ibiteekerezo bibi, uburaaya, ubujuura, ubwicanyi, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />ubusambanyi, umururu, ubugome, ububeeshi, gukora ibibi, ishari, amafuti, ubwiraasi n'ubupfu. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Ibi bibi byose bituruka mu mutima, kandi ni byo bihumaanya umuntu.”<verse eid="MRK 7:23" /></para>
  <para style="s1">Umugore Wagize Kwizeera</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mat 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Yesu ava muri uwo mwanya aja mu gace k'i Tiiro<note caller="+" style="f"><char style="fr" closed="false">7:24 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera byongeraho </char><char style="fqa" closed="false">N'i Sidoni. </char></note>. Yinjira mu nzu, ntiyashaaka ko hagira umenya ko arimo. Ariko banararenga barabimenya. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Umugore wari ufite umwana muto w'umukoobwa wateerwaga n'imyuka mibi, amenye ko Yesu ahari, araaza, yiikubita imbere ye. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Uwo mugore yari umunyamahanga w'Umusirofoyinike. Amwinginga kwirukana dayimooni mu mukoobwa we. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Yesu aramusubiza ati, “Ashwi daa! Reka abaana babanze bagaburirwe, kuko bidakwiriye gufata ibyokurya by'abaana ukabijugunyira imbwa.” <verse eid="MRK 7:27" /><verse number="28" style="v" sid="MRK 7:28" />Uwo mugore asubiza Yesu ati, “Nyagasani,<note caller="+" style="f"><char style="fr" closed="false">7:28 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera bivuga </char><char style="fqa" closed="false">Yeego </char></note> n'ibibwana birya ubuvungunyukira abaana bataaye munsi y'imeeza” <verse eid="MRK 7:28" /><verse number="29" style="v" sid="MRK 7:29" />Nuuko aramubwira ati, “Ku bw'iryo jambo, igendere, dayimooni ivuuye mu mukoobwa waawe.” <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />Uwo mugore asubira i we, asanga umwana aryamye ku buriri dayimooni yamuvuuyemo.<verse eid="MRK 7:30" /></para>
  <para style="s1">Yesu Akiza Umuragi</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Yesu ava mu gace k'i Tiiro, yambuka i Sidoni agera ku ngezi y'i Galileeya mu gace gafite ama tawuni cumi. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Abantu bamuuzanira umuntu wapfuuye amatwi kandi avuga imitepfu, baramwinginga ngo amurambureho ikiganza. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Yesu amujaana ahiitaaruuye amuvaana mu bantu, ashira intoki ze mu matwi y'uwo muntu, aciira amacandwe, amufata ku rurimi. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Yesu areeba heejuru, asuhuuza umutima, abwira uwo muntu ati, <char style="it">Efafata,</char> bisobaanurwa ngo <char style="it">Zibuuka.</char> <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Ako kaanya amatwi ye atangira kumva, n'ururimi rwe rurabohooka atangira kuvuga neeza. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Yesu abategeka ko batagira uwo babibwira, ariko uko yarushaga kubabuza, ni ko baarushagaho kubyamamaza. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Baratangaara caane baravuga bati, “Byose abikoze neeza, atuma abapfaamatwi bumva kandi akavugiisha n'abaragi!”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s1">Yesu Agaburira Abantu Ibihumbi Bine</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mat 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Muri iyo minsi ubwo abantu benshi baari badafite ico kurya, ahamagara abiigiishwa be arababwira ati, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Aba bantu banteeye imbabazi kuko tumaranye iminsi itatu kandi bakaba badafite ico kurya. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Nimbaseezerera ngo basubire iwaabo hatagize ico barya, baragwira isari mu nzira kuko bamwe muri bo baturuka kure.”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Abiigiishwa be baramusubiza bati, “Mbese muri ubu butaayu, umuntu yakuura he ibyokurya byahaaza aba bantu boose?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Yesu arababaza ati, “Mbese mufite imigaati ingana iki?”</para>
  <para style="p" vid="MRK 8:5">Na bo baramusubiza bati, “Dufite imigaati indwi.”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Ategeka abantu kwicara haasi. Nuuko afata iyo migaati indwi, ayishiimira Imaana, arayimaanyagura, nuuko ayiha abiigiishwa be ngo bayigaburire abantu. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Baari bafite n'udusamaaki duke, na two Yesu adushiimira Imaana, ategeka abiigiishwa be kutugabura. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Boose bararya barahaaga, bakungaanya ubuvungunyukira busigaye, buuzuza intonga indwi. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Boose hamwe baari nk'abantu ibihumbi bine, arabaseezera. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Uwo mwanya aheerako aja mu bwato n'abiigiishwa be, baja mu disiturikiti ya Dalumanuta.<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera bivuga, </char><char style="fqa" closed="false">Agace ka magadala </char></note><verse eid="MRK 8:10" /></para>
  <para style="s1">Abafarisaayo Basaba Igitangaaza</para>
  <para style="r">(<ref loc="MAT 12:38-42">Mat 12:38-42</ref>; <ref loc="MAT 16:1-4">16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">Mat 12:38</ref>; <ref loc="LUK 11:16">Luk 11:16</ref>.</char>
    </note>Abafarisaayo baraaza batangira kumugiisha impaka, bamushaakaho ikimenyeetso kivuuye mu ijuru, bamugerageza. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" /><note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mat 12:39</ref>; <ref loc="LUK 11:29">Luk 11:29</ref>.</char></note>Asuhuza umutima, aravuga ati, “Ni iki giteera ab'iki gihe gushaaka ikimenyeetso? Ndabahamiriza yuuko nta kimenyeetso bazaahaabwa.”<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />Abasiga aho, aja mu bwato asubira haakurya y'inyanja.<verse eid="MRK 8:13" /></para>
  <para style="s1">Umusemburo w'Abafarisaayo n'uwa Herodi</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mat 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Abiigiishwa ba Yesu bari biibagiwe kwihemba imigaati, baari bafite umugaati umwe gusa mu bwato. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" /><note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luk 12:1</ref>.</char></note>Nuuko Yesu arabiihanangiriza ati, “Muje mwirinda umusemburo w'Abafarisaayo n'uwa Herodi.”<note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera bakoresha </char><char style="fqa">Herodiya</char> cangwa <char style="fqa" closed="false">Herodiyani</char></note> <verse eid="MRK 8:15" /><verse number="16" style="v" sid="MRK 8:16" />Batangira kubazanya bati, “Ahaari ni uko tudafite imigaati?”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Amaze kumenya ibyo biibwira, Yesu arababaza ati, “Ni iki kibateera kwitonganya ibyerekeye kutagira imigaati? Mbese na n'ubu ntaabwo mwari mwajijuuka ngo musobaanukirwe? Mbese imitima yaanyu iraciinangiye? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" /><note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="MRK 4:12">Mar 4:12</ref>.</char></note>Ko mufite amaaso, ntaabwo mubona? Ko mufite amatwi, ntaabwo mwumva? Ntaabwo mwakwibuka? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Ubwo namaanyaguye imigaati itaanu nkagaburira abantu ibihumbi bitaanu, haasaagutse intonga zingahe?”</para>
  <para style="p" vid="MRK 8:19">Bati, “zaari cumi n'ebyiri.”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />Yongera kubabaza ati, “Kandi ubwo namaanyaguraga imigaati indwi nkagaburira abantu ibihumbi bine, ico gihe haasaagutse intonga zingahe?”</para>
  <para style="p" vid="MRK 8:20">Baramusubiza bati, “Ni indwi.”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Ni ko kongera kubabaza ati, “No kugeza ubu ntaabwo mwari mwasobaanukirwa?”<verse eid="MRK 8:21" /></para>
  <para style="s1">Yesu Ahumuura Impumyi i Beetsayida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Bageze i Beetsayida, hagira abaazanira Yesu umuntu uhumye baramwinginga bashaaka ko yaamufataho. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Yesu amufata ukuboko amuvaana muri ico caaro. Amaze gusiiga amacandwe ku maaso ye no kumurambikaho ibiganza, aramubaza ati, “Mbese hari ico ureeba?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Nuuko uwo muntu areeba heejuru, aravuga ati, “Yeego, ndikureeba abantu, ariko basa n'ibiti bigenda.”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Yesu yongera kurambika ibiganza ku maaso ye, nooneho amaaso ararambuuka, ahumuukira kimwe areeba ibintu byose neeza. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Amwohereza iwaabo, aramubwira ati, “Ntiwiirirwe usubira mu caaro<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera bivuga ngo </char><char style="fqa" closed="false">Wekugira uwo ubwira mu caaro caanyu.</char></note>.”<verse eid="MRK 8:26" /></para>
  <para style="s1">Peetero Yaatura ko Yesu ari Kristo</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mat 16:13-20</ref>; <ref loc="LUK 9:18-21">Luk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Yesu n'abiigiishwa be barakomeza baja mu caaro ciitwa Kayisaariya yo muri Filipo. Bakigenda, abaza abiigiishwa be ati, “Mbese abantu biibwira ko ndi nde?” <verse eid="MRK 8:27" /><verse number="28" style="v" sid="MRK 8:28" /><note caller="-" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MRK 6:14">Mar 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">Luk 9:7</ref>,<ref loc="LUK 9:8">8</ref>.</char></note>Baramusubiza bati, “Bamwe bavuga ko uri Yohaana Umubatiza, abandi bati uri Eliya, kandi hari n'abagira ngo uri umwe mu bahanuuzi.” <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" /><note caller="-" style="x"><char style="xo" closed="false">8:29 </char><char style="xt" closed="false"><ref loc="JHN 6:68">Yoh 6:68</ref>,<ref loc="JHN 6:69">69</ref>.</char></note>Akomeza kubabaza ati, “Mwebwe, muvuga ko ndi nde?” Peetero aramusubiza ati, “Uri Kristo.<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">Uri Kristo kimenyeesha Uri Mesiya </char></note>” <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />Arabiihanangiriza ngo hatagira uwo babibwira.<verse eid="MRK 8:30" /></para>
  <para style="s1">Yesu Avuga ku by'Urupfu no kuzuuka kwe</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mat 16:21-28</ref>; <ref loc="LUK 9:22-27">Luk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Yesu aheerako atangira kwigiisha abiigiishwa be ati, “Ni ngombwa ko Umwana w'Umuntu ababazwa caane, akangwa n'abakuru b'imiryango, abatware b'abaheerezabitambo hamwe n'Abiigiishamategeko maze bakamwica, ariko nyuma y'iminsi itatu akazuuka.” <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Ibi yabivugaga rwatu. Peetero aramwihereerana atangira kumucaaha. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Ariko Yesu arahinduka areeba abiigiishwa be, akabukana Peetero ati, “Mva iruhande Sataani, kuko ibyo wiibwira bitavuuye ku Maana ahuubwo ari iby'abantu!”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:34 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">Mat 10:38</ref>; <ref loc="LUK 14:27">Luk 14:27</ref>.</char>
    </note>Nuuko Yesu ahamagara rubanda n'abiigiishwa be, arababwira ati, “Niiba hari ushaaka kunkurikira, yiyange, yikorere umusaraba we ankurikire. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" /><note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat 10:39</ref>; <ref loc="LUK 17:33">Luk 17:33</ref>; <ref loc="JHN 12:25">Yoh 12:25</ref>.</char></note>Abashaaka gukiza ubugingo bwabo bazaabubura, kandi ababura ubugingo bwabo ku bwanje no ku bw'Ubutumwa bwiza, bazaabukiza. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Mbese byamarira iki umuntu kwigarurira ibintu byose byo ku isi, ariko agataakaza ubugingo bwe? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Mbese ubugingo bw'umuntu yabuguraana iki? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Umuntu weese ugira isoni ku bwanje no kwemera ijambo ryanje muri iki gihe co gutinyuuka Imaana n'uburiganya, Umwana w'Umuntu na we azaamugirira isoni igihe azaagaruka n'icuubahiro ca se ari n'abaamalayika beera.”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Nuuko arababwira ati, “Ndababwira ukuri, yuuko bamwe muri mwe batazaapfa bataboonye Ubwami bw'Imaana buuza bufite ububaasha.”<verse eid="MRK 9:1" /></para>
  <para style="s1">Ishusho ya Yesu Ihinduka Ukundi</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mat 17:1-13</ref>; <ref loc="LUK 9:28-36">Luk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:2 </char>
      <char style="xt" closed="false">
        <ref loc="2PE 1:17">2Pet 1:17</ref>,<ref loc="2PE 1:18">18</ref>.</char>
    </note>Iminsi itandatu ishize, Yesu ajaana na Peetero na Yaakobo na Yohaana, maze abajaana mu mpinga y'umusozi mureemure bonyine. Ahindukira ukundi imbere yaabo, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />imyambaro ye irarabagirana, yeera de, ku buryo ko ari ntamumeshi wo mu isi wakabashije kuyeeza atyo. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Maze Eliya na Moose barababonekera bagaanira na Yesu. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Haanyuma Peetero abwira Yesu ati, “Mwigiisha, byakabaaye byiza kwibeera hano, reka twubake amahema atatu, rimwe ryawe, irindi rya Moose, n'irindi rya Eliya.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Ntaabwo yari azi ico kuvuga, kuko baari baagize ubwoba bwinshi caane.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 3:22">Luk 3:22</ref>.</char>
    </note>Maze igicu kirababundikira, nuuko giturukamo ijwi rivuga riti, “Uyu ni Umwana wanje nkunda caane, mumwumvire!” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Bareebye hiirya no hiino, ntihaagira undi muntu babona, uretse Yesu wenyine.<verse eid="MRK 9:8" /></para>
  <para style="s1">Kuuza kwa Eliya</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Ubwo baamanukaga umusozi, abategeka kutagira uwo babwira ibyo baaboonye, kugeza ubwo Umwana w'Umuntu azaaba amaze kuzuuka.<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />Bakomeza kuzirikana iryo jambo, ariko biibaza ico iryo zuuka mu baapfuuye rimenyeesha. <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" /><note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAT 11:14">Mat 11:14</ref>.</char></note>Nuuko babaza Yesu bati, “Kuki abanditsi bavuga ko Eliya akwiriye kubanza yaaza?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Arababwira ati, “Ni byo koko, Eliya agiiye kuuza asubizeho byose bundi busha. Ntibyanditswe ko Umwana w'Umuntu azaababazwa, kandi agashinyagurirwa? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Ariko ndababwira yuuko Eliya yamaze kuuza, kandi ko bamukoreye ibyo bashaaka, nk'uko byamwanditsweho.”<verse eid="MRK 9:13" /></para>
  <para style="s1">Yesu Akiza Umuhungu Uteewe n'Abadayimooni</para>
  <para style="r">(<ref loc="MAT 17:14-20">Mat 17:14-20</ref>; <ref loc="LUK 9:37-43a">Luk 9:37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Bageze ku bandi biigiishwa, babona abantu benshi babiitoorooye, kandi baja impaka n'Abiigiishamategeko. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Abantu benshi baboonye Yesu, baratangaara caane, bamusanga birukanka baja kumuramutsa. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Arababaza ati, “Ico mujaho impaka na bo ni iki?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Umwe mu baari aho aramusubiza ati, “Mwigiisha, nkuuzaniye umwana wanje, yateewe na dayimooni ituma atavuga. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Iyo imufashe, imutuura haasi, akaazana urufuzi, agahekenya ameenyo kandi akagambarara. Nasabye abiigiishwa baawe ngo bayirukane, ariko ntibaabishobora.”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Arabasubiza ati, “Yemwe bantu b'iki gihe, kuki mutiizeera? Nzaabaana namwe kugeza ryari? Nimuumunzanire.” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Umwana baramuuzana. Dayimooni iboonye Yesu, itigisa wa mwana caane, maze yiikubita haasi ariigaragura, azana urufuzi mu kanwa. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Yesu abaza se ati, “Hashize igihe kingana iki ibi bimubaho?” Na we aramusubiza ati, “Byamufashe kuva mu bwana. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Ihora imusuka mu muriro no mu maazi ishaaka ku mwica, ariko niiba hari ico waashobora gukora, tugirire imbabazi maze udufashe.”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Yesu aramubwira ati, “Kuki uvuze ngo, ‘Niiba waabishobora?’ Byose bishobokera uweemera.”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Ako kaanya se w'uwo mwana ateera heejuru avuga ati, “Ndeemera, nyongeerera ukwemera!”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Yesu aboonye abantu benshi baazira hamwe biirukanka, acaaha dayimooni, avuga ati, “Wowe dayimooni utuma uyu mwana atavuga kandi ntiyumve, ndagutegetse, muvemo, kandi ntukazaamugarukemo ukundi!”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Nyuma yo kuvuza induuru no kumutigisa caane, imuvamo maze umwana amera nk'upfuuye, bituma benshi bavuga bati, “Yapfuuye.” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Ariko Yesu amufata ukuboko maze aramuhagurutsa, ashobora guhagarara.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Yinjiye mu nzu, abiigiishwa be baramwihereerana maze baramubaza bati, “Kuki twebwe tutaashoboye kuyiirukana?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Arababwira ati, “Beene ubwo bwoko ntibupfa kwirukanwa uretse amasengeesho no kwiyiriza ubusa.”<note caller="+" style="f"><char style="fr" closed="false">9:29 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera, ntaabwo hongerwaho </char><char style="fqa" closed="false">Kwiyiriza ubusa.</char></note><verse eid="MRK 9:29" /></para>
  <para style="s1">Yesu Yongera Kuvuga iby'Urupfu rwe</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mat 17:22-23</ref>; <ref loc="LUK 9:43b-45">Luk 9:43b-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Bavayo, banyura i Galileeya. Ntiyashaakaga ko hagira ubimenya, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />kuko yiigiishaga abiigiishwa be ababwira ati, “Umwana w'Umuntu agiiye kugambaanirwa ashirwe mu maboko y'abantu, maze bamwice, ariko nyuma y'iminsi itatu, azuuke.”<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />Ariko ntibaasobaanukirwa ico yababwiraga kandi batiinyaga no kumubaza.<verse eid="MRK 9:32" /></para>
  <para style="s1">Ni inde Uruta Abandi?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat 18:1-5</ref>; <ref loc="LUK 9:46-48">Luk 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Bagera i Kaperenawumu, Yesu ari mu nzu arababaza ati, “Ni iki mwajagaho impaka muri mu nzira?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:34 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">Luk 22:24</ref>.</char>
    </note>Ariko bariihorera, kuko bari mu nzira baari baagiiye impaka zo kumenya umukuru muri bo uwo ari we. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" /><note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26">Mat 20:26</ref>,<ref loc="MAT 20:27">27</ref>; <ref loc="MAT 23:11">23:11</ref>; <ref loc="MRK 10:43">Mar 10:43</ref>,<ref loc="MRK 10:44">44</ref>; <ref loc="LUK 22:26">Luk 22:26</ref>.</char></note>Ariicara, yakura abo cumi na babiri, maze arababwira ati, “Ushaaka kuba uwa mbere agomba kuba uwa nyuma kandi akaba n'umugaragu wa boose.” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Azana umwana muto, amuhagarika hagati yaabo, aramukiikira, maze arababwira ati, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" /><note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mat 10:40</ref>; <ref loc="LUK 10:16">Luk 10:16</ref>; <ref loc="JHN 13:20">Yoh 13:20</ref>.</char></note>“Uwaakiira umwana nk'uyu mu izina ryanje ni nje aba yaakiiriye, kandi unyakiira aba atari nje yaakiiriye ahuubwo aba yakiiriye uwantumye.”<verse eid="MRK 9:37" /></para>
  <para style="s1">Undi Muntu Wiirukana Abadayimooni</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luk 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Yohaana abwira Yesu ati, “Mwigiisha, twaboonye umuntu wiirukana abadayimooni mu izina ryawe turamubuza, kuko atari umwe muri twe.”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Ariko Yesu aravuga ati, “Ntimumubuze, kuko nta muntu ukora igitangaaza mu izina ryanje, wansebya. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" /><note caller="-" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">Mat 12:30</ref>; <ref loc="LUK 11:23">Luk 11:23</ref>.</char></note>Utari umwanzi waacu aba ari uwaacu. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" /><note caller="-" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">Mat 10:42</ref>.</char></note>Ndababwira ukuri yuuko, uzaabaha igikopu c'amaazi yo kunywa ku bw'izina rya Kristo, ntaabwo azaabura ingororano.<verse eid="MRK 9:41" /></para>
  <para style="s1">Kuguusha Abandi mu Caaha</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mat 18:6-9</ref>; <ref loc="LUK 17:1-2">Luk 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />Umuntu weese muri mwe uzaabeera igisiitaaza umwe muri aba bato baanyemera, ibyiza ni uko yaahambiirwa urusyo mu ijosi, akajugunywa mu nyanja. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" /><note caller="-" style="x"><char style="xo" closed="false">9:43 </char><char style="xt" closed="false"><ref loc="MAT 5:30">Mat 5:30</ref>.</char></note>Ukuboko kwawe ni gutuma ucumura, uguceho, ni byiza ko waakwinjira mu bugingo buhoraho umugaye, kuruta kuja mu muriro utazima n'amaboko yombi. [ <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />Aho hantu, inyo z'abapfu ntizishira kandi umuriro ubatwika ntuuzima.] <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Kandi ikirenge caawe ni kigucumuza, ugiceho, ni byiza kwinjira ubuzima buhoraho uremaye kuruta kujugunywa i gehenoomu ufite ibirenge byombi. [ <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Aho hantu, inyo z'abapfu ntizishira kandi umuriro ubatwika ntuuzima.] <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" /><note caller="-" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mat 5:29</ref>.</char></note>Kandi ijiisho ryawe nirigucumuza, urinogooremo, ibyiza ni uko waakwinjira mu bwami bw'Imaana n'ijiisho rimwe, aho kugira amaaso abiri ukajugunywa mu muriro, <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />aho inyo zaabo zidapfa, kandi umuriro ubatwika ntuuzime.<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />Kuko buri weese azaasukuurwa n'umuunyu n'umuriro.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:50 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:13">Mat 5:13</ref>; <ref loc="LUK 14:34">Luk 14:34</ref>,<ref loc="LUK 14:35">35</ref>.</char>
    </note>Umunyu ni mwiza, ariko iyo ukayutse, mwakongera mute kuwusubizamo uburyohe? Namwe ni ko mukwiriye kugirira Imaana akamaro nk'ako umuunyu ugira mu byokurya kandi mubaane amahoro.”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s1">Ibyo Kwirukana Abagore</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mat 19:1-12</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Yesu ava muri uwo mwanya aja i Yudeeya, no haakurya ya Yorodaani. Haaza abantu benshi atangira kubiigiisha nk'uko yabigenzaga.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Abafarisaayo bamwe bamuuzaho bagerageza kumutega baramubaza bati, “Tubwire, itegeko ryemerera umugabo kwirukana umugore we?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Arabasubiza ati, “Moose yabategetse iki?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:4 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:31">Mat 5:31</ref>.</char>
    </note>Baravuga bati, “Moose yeemereye umugabo kwandikira umugore urwandiko rumwirukana nuuko akamwirukana.”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Yesu arababwira ati, “Moose yabemereye iryo tegeko kuko mwari mufite imitima yiinangiye. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Ariko mbere na mbere, ubwo Imaana yaremaga umuntu, ‘yabaremye umugabo n'umugore.’ <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />‘Ni co gituma umugabo azaasiga se na nyina akabaana n'umugore we, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />bombi bakaba umubiri umwe.’ Baba batakiri babiri ahuubwo bakaba umubiri umwe. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Nuuko reero abo Imaana yateeranyije, ntihakagire ubatandukanya.”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Basubiye mu nzu, abiigiishwa bongera kubaza Yesu ku byo yavuze. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" /><note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mat 5:32</ref>; <ref loc="1CO 7:10">1 Kor 7:10</ref>,<ref loc="1CO 7:11">11</ref>.</char></note>Arababwira ati, “Umugabo weese wiirukana umugore we agasohoza undi, aba asambanye kandi ahemukiye umugore wa mbere. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Kandi n'umugore utandukana n'umugabo we agashingirwa ku wundi mugabo aba asambanye”.<verse eid="MRK 10:12" /></para>
  <para style="s1">Yesu Aheereza Abaana Bato Umugisha</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat 19:13-15</ref>; <ref loc="LUK 18:15-17">Luk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Bamuuzanira abaana bato ngo abarambikeho ibiganza, ariko abiigiishwa be barabacaaha. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Yesu abiboonye biramuraakaza abwira abiigiishwa be ati, “Mureke abaana bato baaze aho ndi, ntimubabuze, kuko Ubwami bw'Imaana ari ubwabo. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" /><note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">Mat 18:3</ref>.</char></note>Ndabahamiriza yuuko utaakiira ubwami bw'Imaana nk'Umwana muto atazaabwinjiramo na hato.” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Nuuko akiikira abo baana, abarambikaho ibiganza, abaha umugisha.<verse eid="MRK 10:16" /></para>
  <para style="s1">Umugabo w'Umukire</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat 19:16-30</ref>; <ref loc="LUK 18:18-30">Luk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Yesu agitangira urugendo, haaza umugabo yiirukanka, aramupfukamira, aramubaza ati, “Mwigiisha mwiza, nakora iki kugira ngo mpaabwe ubugingo buhoraho?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Yesu aramubaza ati, “Kuki unyita mwiza? Nta mwiza uriho uretse Imaana yoonyine. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Uzi amategeko, ‘ntuukiice, ntuugasambane, ntuukiibe, ntuukabeeshere abandi, ntuukarenganye, wubahe so na nyoko.’ ” <verse eid="MRK 10:19" /><verse number="20" style="v" sid="MRK 10:20" />Uwo mugabo asubiza Yesu ati, “Mwigiisha, ibyo byose narabikurikije kuva mu buto bwanje.” <verse eid="MRK 10:20" /><verse number="21" style="v" sid="MRK 10:21" />Yesu aramureeba, aramukunda, aramubwira ati, “Ubuzeho ikintu kimwe gusa, genda uguriishe ubutunzi bwawe bwose, nuuko amashilingi avuuyemo uyahe abakene, uzaagira ubutunzi mu ijuru, maze uheereko unkurikire.” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Uwo mugabo yumviise ibyo, aratangaara agenda ababaye, kuko yari afite ubutunzi bwinshi.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Yesu areeba abiigiishwa be arababwira ati, “Mbeega ukuntu bikomereye abatunzi kwinjira mu bwami bw'Imaana!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Abiigiishwa be batangaazwa n'ayo magambo. Ariko Yesu arongera arababwira ati, “Baana banje, mbeega ukuntu bikomeye kwinjira mu bwami bw'Imaana! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Icooroshe ni uko ingamiya yaanyura mu gapfumure gato nk'ak'urusindani kuruta uko umukire ya kwinjira mu bwami bw'Imaana.” <verse eid="MRK 10:25" /><verse number="26" style="v" sid="MRK 10:26" />Barushaho gutangaara babazanya bati, “Noone ni nde ushobora gukizwa?” <verse eid="MRK 10:26" /><verse number="27" style="v" sid="MRK 10:27" />Yesu arabareeba aravuga ati, “Ku muntu n'ibidashoboka, ariko siko biri ku Maana, ku Maana byose birashoboka.”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Peetero atangira kuvuga ati, “Reeba! Twebwe twasize byose turagukurikira.”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Yesu aravuga ati, “Ndababwira ukuri yuuko ntawasize urugo rwe, abavandimwe, nyina, ise, abaana, cangwa imirima kubwa nje n'ubutumwa bwiza, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />utazaahaabwa ibirutaho inshuro ijana mur'iki gihe ca noone, ari amazu, abavandimwe, abaana n'imirima. Icakora bizaaza hamwe no kurenganywa, maze mu gihe kizaaza azaahaabwa ubugingo buhoraho. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" /><note caller="-" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">Mat 20:16</ref>; <ref loc="LUK 13:30">Luk 13:30</ref>.</char></note>Ariko benshi baari aba mbere bazaaba abaanyuma, kandi abaanyuma bazaaba aba mbere”.<verse eid="MRK 10:31" /></para>
  <para style="s1">Yesu Avuga ku Gupfa no Kuzuuka kwe Inshuro ya Gatatu</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Ubwo baari mu nzira bagana i Yerusaalemu, Yesu yari imbere yaabo. Abiigiishwa baratangaara, kandi abaari babakurikiye baratiinya. Ajaana abiigiishwa cumi na babiri iruhande atangira kubabwira ibigiiye kumubaho <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />ati, “Dore tugiiye i Yerusaalemu, Umwana w'Umuntu agashikirizwa abaheerezabitambo bakuru n'Abiigiishamategeko, bamuciire urubanza rwo gupfa, nuuko bamushikirize abanyamahanga. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Bazaamushinyagurira, bamuciireho, bamukubite inkoni, bamwice, maze haanyuma y'iminsi itatu azuuke.”<verse eid="MRK 10:34" /></para>
  <para style="s1">Yaakobo na Yohaana Biisabira Ubutoni</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mat 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Yaakobo na Yohaana, beene Zebedaayo, baramwegeera baramubwira bati, “Mwigiisha, dushaaka ko udukorera ibyo tugusaba byose.”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Arababaza ati, “Murashaaka ko mbakorera iki?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Baramubwira bati, “Uduhe kwicara naawe, umwe iburyo undi ibumoso, mu ikuzo ryawe.”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:38 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:50">Luk 12:50</ref>.</char>
    </note>Ariko Yesu arababwira ati, “Ntaabwo muuzi ico musaba. Mbese mwashobora kunywera ku gikopu c'umubabaro nzanyweraho, cangwa kubatizwa umubatizo nzaabatizwa?”.<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Baramusubiza bati, “Twabishobora.” Nuuko Yesu arababwira ati, “Ni koko igikopu nzanyweraho muzaakinyweraho, kandi n'umubatizo nzaabatizwa ni wo namwe muzaabatizwa. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Naho kwicara iburyo cangwa ibumoso bwanje si nje ubigaba ahuubwo bifite abo byateguuriwe.” <verse eid="MRK 10:40" /><verse number="41" style="v" sid="MRK 10:41" />Bagenzi baabo cumi babyumviise batangira kurakarira Yaakobo na Yohaana. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" /><note caller="-" style="x"><char style="xo" closed="false">10:42 </char><char style="xt" closed="false"><ref loc="LUK 22:25">Luk 22:25</ref>,<ref loc="LUK 22:26">26</ref>.</char></note>Yesu arabahamagara arababwira ati, “Muuzi yuuko abaahaawe gutegeka amahanga bayatwaza igitugu, kandi n'abakomeye bo muri bo bakayabuza amahoro. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" /><note caller="-" style="x"><char style="xo" closed="false">10:43 </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mat 23:11</ref>; <ref loc="MRK 9:35">Mar 9:35</ref>; <ref loc="LUK 22:26">Luk 22:26</ref>.</char></note>Ariko muri mwe si ko bimeze, kuko ushaaka kuba mukuru muri mwe, akwiriye kuba umugaragu waanyu mwese, <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />kandi ushaaka kuba uwa mbere muri mwe akwiriye kuba imbaata ya boose. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Kuko Umwana w'Umuntu ataazanywe no gukorerwa, ahuubwo yazanywe no gukorera abandi, no gutanga ubugingo bwe nk'inshungu ya benshi.”<verse eid="MRK 10:45" /></para>
  <para style="s1">Yesu Ahumuura Baritimaayo</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Bagera i Yeriko, Yesu n'abiigiishwa be bahavaana n'abantu benshi. Baritimaayo mwene Timayasi, impumyi yasabirizaga yari yiicaye iruhande rw'inzira. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Yumviise ko Yesu w'i Nazaareeti aje, arataka caane ati, “Yesu, mwene Dawudi, ngirira imbabazi!” <verse eid="MRK 10:47" /><verse number="48" style="v" sid="MRK 10:48" />Benshi baramucaaha ngo aceceke, ahuubwo we arushaho gutaka caane ati, “Yesu mwene Dawudi, ngirira imbabazi!”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Yesu arahagarara aravuga ati, “Nimumuhamagare.”</para>
  <para style="p" vid="MRK 10:49">Bahamagara Baritimaayo, baramubwira bati, “Ihangane, haguruka, araguhamagara.”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />Ajugunya umwiteero we, arabaduka asanga Yesu.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Yesu aramubaza ati, “Ushaaka ko ngukorera iki?” Aramusubiza ati, “Mwigiisha, mpumuura.”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Yesu aramubwira ati, “Genda, kwizeera kwawe kuragukijije.” Ako kaanya, arahumuuka, amukurikira mu nzira.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s1">Yesu Yinjira n'Icuubahiro i Yerusaalemu</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoh 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Bari haafi kugera i Yerusaalemu, bari i Betifage n'i Beetaniya, haafi y'umusozi wa Elayoni, yoohereza babiri mu biigiishwa be <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />arababwira ati, “Mugende mu caaro kiri imbere yaanyu, mukimara kwinjira mo, murahasanga icaana c'indogobe kiziritse kandi kitiigeze giheekaho umuntu, mukiziture mukiizane. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Nihagira ubabaza ati, ‘Kuki mukora ibyo?’ Mumubwire muti, ‘Umwami Yesu aragishaaka kandi arakigarura vuba.’ ” <verse eid="MRK 11:3" /><verse number="4" style="v" sid="MRK 11:4" />Baragenda basanga icaana c'indogobe kiziritswe haafi y'irembo, hanze ku nzira. Bakikizitura, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />abaari bahagaze aho barababaza bati, “Muri gukora iki, kuzitura icaana c'indogobe?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />Abiigiishwa bababwira ibyo Yesu yari yaavuze maze abo bantu beemera ko bakijaana. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Bakiizanira Yesu bakirambuuraho imyenda yaabo nuuko aciicaraho. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Abantu benshi basasa imyenda yaabo mu nzira, abandi basasa amashami y'ibiti baaciiye mu mirima.<figure style="fig" alt="They layed down their clothes so that Jesus walks on them" file="DD-37A.TIF" size="col" loc="Darwin" copy="The British and Foreign Bible Societies." ref="11:8">Basasa haasi imyenda yaabo kugira ngo Yesu anyureho</figure> <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Abaamugendaga imbere n'abaari bamukurikiye bagenda barangurura amajwi yaabo bati,</para>
  <para style="q1" vid="MRK 11:9">“Hozaana!</para>
  <para style="q2" vid="MRK 11:9">Hahiirwa uje mu izina rya Nyagasani!<verse eid="MRK 11:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="MRK 11:10" />Hahiirwa n'ubwami bwa sogokuruza Dawudi buuje!</para>
  <para style="q1" vid="MRK 11:10">Mu ijuru ni basingize Imaana bati, Hozaana!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Nuuko Yesu ageze i Yerusaalemu, yinjira mu Nzu y'Imaana, amaze kwitegereza buri kimwe coose, kandi aboonye ko bumaze kwira, aja i Beetaniya na ba cumi na babiri.<verse eid="MRK 11:11" /></para>
  <para style="s1">Yesu Avuma Igiti Ciitwa Umutiini</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mat 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Bukeeye bwaho, bavuuye i Beetaniya, Yesu yari ashonje. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Akiri kure areeba igiti gishishe ciitwa umutiini, araceegeera kureeba ko haagira ico yaabonamo. Akigezeho, asanga ari amababi yoonyine, kuko kitaari igihe caaco co kwera imbuto. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Yesu avuma ico giti avuga ati, “Nta muntu uziigera kukuryaho imbuto ukundi!” Abiigiishwa be bumva abivuga.<verse eid="MRK 11:14" /></para>
  <para style="s1">Yesu Yiirukana Abacuruuzi mu Nzu y'Imaana</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat 21:12-17</ref>; <ref loc="LUK 19:45-48">Luk 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoh 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Bageze i Yerusaalemu, Yesu aja mu Nzu y'Imaana atangira kwirukana abaaguriishirizagamo no kuguriramo ibintu. Yuubika imeeza z'abaavunjaga amashilingi n'intebe z'abaaguriishaga inuma, <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />kandi ntiyeemerera umuntu weese kugira ico anyuza muri uwo mwanya w'Inzu y'Imaana. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Yiigiishaga abantu avuga ati, “Nti byanditswe ngo,</para>
  <para style="q1" vid="MRK 11:17">‘Inzu yanje iziitwa Inzu y'Imaana y'amahanga yoose?’</para>
  <para style="q2" vid="MRK 11:17">Ariko mwe mwayihinduye ubwihisho bw'abajuura!”<verse eid="MRK 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MRK 11:18" />Abatware b'abaheerezabitambo n'Abiigiishamategeko babyumviise, batangira gushaaka uburyo bwo kwica Yesu. Baaramutiinye kuko abantu benshi baatangaazwaga n'inyigiisho ze.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Bugoroobye, Yesu n'abiigiishwa be bava mur'iyo tawuni.<verse eid="MRK 11:19" /></para>
  <para style="s1">Isomo Rifashe ku Giti Yesu Yavumye</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mat 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Mu gitondo kare ubwo baanyuragaho, babona ca giti c'umutiini cumye kugeza mu mizi. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Peetero yiibuka ibyabaayeho, maze abwira Yesu ati, “Mwigiisha, dore ca giti c'umutiini wavumye cumye!”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Yesu arababwira ati, “Mugire kwizeera Imaana. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" /><note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mat 17:20</ref>; <ref loc="1CO 13:2">1 Kor 13:2</ref>.</char></note>Ndabahamiriza yuuko uzaabwira uyu musozi ati, ‘Shiguka utaabwe mu nyanja,’ adashidiikanya mu mutima we, ahuubwo akizeera, ibyo avuze bizaaba. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Ni co gituma mbabwira nti, nimusenga musaba ikintu, mwizeere ko mukiboonye, kandi kizaaba icaanyu. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" /><note caller="-" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="MAT 6:14">Mat 6:14</ref>,<ref loc="MAT 6:15">15</ref>.</char></note>N'igihe muhagaze gusenga, muje mubabarira abo mwaba mufite ico mupfa, kugira ngo namwe So wo mu ijuru abababarire ibyaha byanyu.” <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" /><note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera ntaabwo hongerwaho uyu murongo</char></note> Ariko nimutababarira abandi, So wo mu ijuru nawe ntaazaabababarira ibyaha byanyu.<verse eid="MRK 11:26" /></para>
  <para style="s1">Ububaasha bwa Yesu Babwibazaho</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat 21:23-27</ref>; <ref loc="LUK 20:1-8">Luk 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Bongera kuja i Yerusaalemu. Ubwo Yesu yagendagendaga mu Inzu y'Imaana, abatware b'abaheerezabitambo, Abiigiishamategeko, na bakuru b'imiryango baaza aho ari <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />baramubaza bati, “Uvaana he ububaasha bwo gukora ibyo? Ninde waguhaaye ubwo bubaasha ukoreesha?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Yesu arabasubiza ati, “Ndababaza ikibazo kimwe, nimunsubiza, nanje ndababwira iyo mvaana ubwo bubaasha. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Umubatizo wa Yohaana ukomooka mu ijuru, cangwa ukomooka ku bantu? Nimunsubize.”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Batangira kuja inaama bati, “Nituvuga tuti, ‘Wavuuye mu ijuru,’ aravuga ati, ‘Kuki mutamwemeye?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Ariko se tuvuge ngo, ‘Yawukuuye mu bantu’?” Batiinya rubanda, kuko boose baajaanaga Yohaana nk'umuhanuuzi w'ukuri. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Nuuko basubiza Yesu bati, “Ntaabwo tubiizi.” Yesu arababwira ati, “Nanje sindibubabwire aho nkuura ububaasha bwo gukora ibi.”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s1">Umugani w'Abahinzi b'Abagome</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat 21:33-46</ref>; <ref loc="LUK 20:9-19">Luk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Yesu atangira kubiigiishiriza mu migani ati, “Umugabo yahinze umurima w'imizaabibu, arawuzitira, acukuramo urwina, kandi yuubakamo umunaara w'abarinzi. Nuuko nyir'umurima awatira abahinzi aja mu kindi gihugu. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Igihe co gusaaruura kigeze, yoohereza umugaragu we ku bahinzi ngo yaakiire umugabane we w'imbuto z'imizaabibu. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Agezeyo, baramufata, baramukubita, asubirayo amaara masa. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Nyir'umurima yongera kohereza undi mugaragu, nawe baramukubita, bamurema uruguma mu mutwe kandi baramuhemura. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Yongera kohereza undi mugaragu, maze uyu we baramwica. Uku ni ko byagendeye n'abandi benshi, bamwe baarakubiswe abandi bariicwa. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />Uwo yari asigaranye wo kohereza yari umwe gusa, umwana we yakundaga. Bigeze aho na we aramwohereza yiibwira mu mutima ati, ‘Umwana wanje baramwubaha.’ <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Ariko abo bahinzi bo baravugana bati, ‘Dore uwarazwe ibintu araaje, nimuuze tumwice maze tuzaazungure ibye.’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Baramufata, baramwica maze bamujugunya hanze y'uruzitiro rw'uwo murima.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />Noone nyir'umurima azaakora iki? Azaaza yiice abo bahinzi nuuko umurima awuheereze abandi. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Mbese ntimwasomye ibyanditswe ngo,</para>
  <para style="q1" vid="MRK 12:10">‘Ibuye abuubatsi banze</para>
  <para style="q2" vid="MRK 12:10">ni ryo ryahindutse urufatiro rw'inzu.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Ibyo ni Nyagasani wabikoze, noone bitubeereye igitangaaza’!”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Bamaze kumenya ko umugani yaciiye ubashinja, bashaaka kumufata ariko Batiinya rubanda. Bageze aho baramureka maze baragenda.<verse eid="MRK 12:12" /></para>
  <para style="s1">Ikibazo Ceerekeye Imisoro</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat 22:15-22</ref>; <ref loc="LUK 20:20-26">Luk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Abayobozi b'Abayuuda boohereza Abafarisaayo na bamwe mu Baherodiya kuri Yesu kugira ngo bamutegere mu byo avuga. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Baraaza baramubaza bati, “Mwigiisha, tuuzi ko uri inyangamugayo kandi ko utarobaanura abantu ku butoni, kandi ukiigiisha ubuyoboka Maana ushingiye ku kuri. Amategeko yeemera ko dutanga umusoro w'umwami cangwa ntaabyemera? <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Mbese tuwutange cangwa tuwureke?” Ariko kuko yari azi uburyarya bwabo, arababaza ati, “Kuki mungerageza? Ni munzanire igiceri <note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera bivuga </char><char style="fqa" closed="false">Idinaari </char></note> ndeebe.” <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />Bakimuuzaniye arababaza ati, “Iri shusho n'izina n'ibyande?” Baramusubiza bati, “N'iby'umwami.”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Yesu arababwira ati, “Iby'umwami mubihe umwami, kandi n'iby'Imaana mubihe Imaana”. Nuuko baramutangaarira caane.<verse eid="MRK 12:17" /></para>
  <para style="s1">Yesu Asubiza Ibyerekeye Izuuka ry'Abaapfuuye</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat 22:23-33</ref>; <ref loc="LUK 20:27-40">Luk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:18 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">Iby 23:8</ref>.</char>
    </note>Bamwe mu Basadukaayo, bavuga ko kuzuuka kutabaho baraaza babaza Yesu bati, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“Mwigiisha, Moose yanditse atya ati, ‘Umugabo naapfa agasiga umugore batabyaranye, mwene nyina agomba gucura uwo mugore kugira ngo aciikuure mwene nyina.’ <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Haabaayeho ibyenenyina birindwi, umukuru asohoza umugore ariko apfa bataraabyarana. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Umukurikira acuura uwo mugore, nawe apfa bataraabyarana. N'uwagatatu biba bityo. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Nta numwe muri abo barindwi wasize umwana. Amaheerezo uwo mugore nawe arapfa. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Mbese igihe c'izuuka uwo mugore azaaba uwande? Ko boose barindwi baamurongoye?”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Yesu arababwira ati, “Mwarayobye! Muuzi impamvu? Ni uko mutaazi ibyanditswe hamwe n'imbaraga z'Imaana. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Mu izuuka, ntaawe usohoza cangwa ngo ashingirwe. Ahuubwo bamera nk'abaamalayika bo mu ijuru. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Ku byerekeye kuzuuka kw'abaapfuuye, nti mwasomye mu gitabo ca Moose igihe yari ku gihuru caaka umuriro, ko Imaana yamubwiye iti, ‘Ndi Imaana ya Aburahamu, Imaana ya Isaaka, n'Imaana ya Yaakobo.’ <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Ntaabwo ari Imaana yabapfu, ahuubwo ni Imaana y'abazima, Mwarayobye caane!”<verse eid="MRK 12:27" /></para>
  <para style="s1">Itegeko Riruta Andi Gukomera.</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mat 22:34-40</ref>; <ref loc="LUK 10:25-28">Luk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Umwe mu biigiishamategeko arabeegeera yumva baja impaka. Aboonye ko Yesu yashubije b'Abasadukaayo neeza, aramubaza ati, “Itegeko riruta ayandi ni irihe?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Yesu aramusubiza ati, “Irya mbere ni, ‘Umva, Isirayeli! Uhoraho Imaana yaacu ni yo Maana yoonyine. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Ukunde Uhoraho Imaana yaawe n'umutima waawe woose, n'ubugingo bwawe bwose, n'ubwenge bwawe bwose, n'imbaraga zaawe zoose.’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Irya kabiri ni iri, ‘Ukunde mugenzi waawe nk'uko wikunda.’ Nta rindi tegeko riruta ayo gukomera.” <verse eid="MRK 12:31" /><verse number="32" style="v" sid="MRK 12:32" />Umwigiishamategeko abwira Yesu ati, “Urashitsa Mwigiisha, uvuze ukuri uti, ‘Imaana ni imwe, kandi nta yindi Maana keretse yo yoonyine’. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Kandi ‘gukunda Imaana n'umutima waawe woose, n'ubugingo bwawe bwose, n'imbaraga zaawe zoose,’ no ‘gukunda mugenzi waawe nk'uko wikunda.’ Ibi biruta ibitambo byose byokejwe n'ibitookejwe.” <verse eid="MRK 12:33" /><verse number="34" style="v" sid="MRK 12:34" /><note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luk 10:25-28</ref>.</char></note>Yesu aboonye ko ashubije neeza aramubwira ati, “Ntaabwo uri kure y'Ubwami bw'Imaana.” Nyuma yaho ntaawundi wahangaaye kongera kumubaza.<verse eid="MRK 12:34" /></para>
  <para style="s">Ikibazo Ceerekeye Kristo</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat 22:41-46</ref>; <ref loc="LUK 20:41-44">Luk 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Ubwo Yesu yiigiishirizaga mu Nzu y'Imaana aravuga ati, “Ni iki gituma Abiigiishamategeko bavuga bati Kristo <note caller="+" style="f"><char style="fr" closed="false">12:35 </char><char style="ft" closed="false">Cangwa Mesiya</char></note> ni umwana wa Dawudi? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Dawudi ubwe, ayobowe n'Umwuka Weera yaravuze ati,</para>
  <para style="q1" vid="MRK 12:36">‘Uhoraho yabwiye Umwami wanje ati,</para>
  <para style="q2" vid="MRK 12:36">Icara iburyo bwanje,</para>
  <para style="q2" vid="MRK 12:36">kugeza aho nzaashirira abanzi baawe munsi y'ibirenge byawe.’<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Dawudi ubwe yiitaga Yesu Umwami, noone ashobora ate kuba Umwana we?” Abantu benshi bumvirizaga Yesu n'umuneezeero.<verse eid="MRK 12:37" /></para>
  <para style="s1">Yesu Agaragaza Ibyaha by'Abiigiishamategeko</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23:1-36</ref>; <ref loc="LUK 20:45-47">Luk 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Ubwo yiigiishaga, arababwira ati, “Mwirinde Abiigiishamategeko bakunda kugenda bambaye amakanzu no kuramutswa mu cuubahiro mu maguriro, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />no guhaabwa ibyicaro byiza mu masinagoogi n'imyanya y'ibyubahiro mu birori. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Baryarya amago y'abapfaakazi, bakiiha kuvuga amasengeesho y'urudaca. Abo bazaaciirwa urubanza rukomeye kurusha abandi.”<verse eid="MRK 12:40" /></para>
  <para style="s1">Ituuro ry'Umupfaakazi</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luk 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Yesu yiicara ahateeganye n'ibiikiro ry'amatuuro, nuuko yiitegereza uko abantu bari gutuura. Abakire benshi baashiragamo amashilingi menshi. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Umupfaakazi w'umukene na we ashiramo uduceri tubiri tw'umuringa. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Ahamagara abiigiishwa be arababwira ati, “Ndababwira ukuri yuuko uyu mupfaakazi w'umukene arushije abandi boose gutuura. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Abandi batuuye ibisaaze ku butunzi bwabo, ariko we mu bukene bwe, atuuye ibyo yari afite byose, ibyari bimubeeshejeho.”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s1">Yesu Avuga ku Gusenywa kw'Inzu y'Imaana</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mat 24:1-2</ref>; <ref loc="LUK 21:5-6">Luk 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Yesu agisohoka mu Nzu y'Imaana, umwe mu biigiishwa be aramubwira ati, “Mwigiisha, ireebere naawe! Mbeega inzu nini yuubakiishijwe amabuye manini meeza! Mbeega imyubakire y'igitangaaza!”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Yesu aramusubiza ati, “Nti ureeba iki cuubakwa gitangaaje? Nta buye na rimwe rizaasigara rigeretswe ku rindi, byose bizaasenywa.”<verse eid="MRK 13:2" /></para>
  <para style="s1">Amakuba no Kubabazwa mu Minsi ya Nyuma</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mat 24:3-14</ref>; <ref loc="LUK 21:7-19">Luk 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Yesu yiicaye ku musozi wa Elayoni, ahateebanye n'Inzu y'Imaana, Peetero, Yaakobo, Yohaana na Andereya baramwihereerana, baramubaza bati, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Tubwire, ibi byose bizaaba ryari kandi ni kimenyeetso ki kizaagaragaza ko bisohoye?” <verse eid="MRK 13:4" /><verse number="5" style="v" sid="MRK 13:5" />Yesu atangira kubabwira ati, “Muramenye, ntihazaagire ubayobya. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Kuko benshi bazaaza mu izina ryanje bavuga bati, ‘Ni nje Kristo!’ Kandi bazaashuka benshi. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Ntimugahagarike imitima yaanyu ni mwumva intambara n'impuuha z'intambara. Ibi bigomba kuzaabaho, ariko imperuuka izaaba itaraagera. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Igihugu kizarwana n'ikindi gihugu, ubwami buteere ubundi bwami, hirya no hiino hazaahinda imishitsi hateere n'inzara, ibyo bizaaba bimeze nk'imigendo ibanziriza ibise by'umubyeyi umwana ataraavuuka.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:17-20">Mat 10:17-20</ref>; <ref loc="LUK 12:11">Luk 12:11</ref>,<ref loc="LUK 12:12">12</ref>.</char>
    </note>Ariko mwebweho, mube maaso kuko bazaabajaana mu nkiiko no mu masinagoogi babakubitiremo, muzaahagarikwa imbere y'abaami n'abandi bategetsi babampoora, ngo mumbeere abahamya. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Icakora, Ubutumwa Bwiza bukwiriye kubanza bwabwirizwa mu mahanga yoose. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Ni babafata bakabajaana mu bucaamanza, ntimuzaahagarike imitima yaanyu ngo mwibaze uko muziireguura. Ahuubwo ico gihe ni kigera, muzaahabwa ico mukwiriye kuvuga, kuko atari mwe muzaaba muvuga ahuubwo n'Umwuka Weera. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />Umuvandimwe azaagambaanira mwene nyina amwiciishe, umubyeyi azaagambaanira umwana we, abaana baziihindukana ababyeyi baabo babiiciishe. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" /><note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mat 10:22</ref>.</char></note>Muzangwa na boose ku bw'izina ryanje, ariko uziihangaana kugeza ku mperuuka azaakizwa.”<verse eid="MRK 13:13" /></para>
  <para style="s1">Ikizira Kirimbura</para>
  <para style="r">(<ref loc="MAT 24:15-28">Mat 24:15-28</ref>; <ref loc="LUK 21:20-24">Luk 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“Nimuzaabona ‘ikizira kirimbura’ gihagaze aho kitagomba kuba, (usoma ibi asobaanukirwe neeza), abazaaba bari i Yudeeya bazaahungire ku misozi, <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" /><note caller="-" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luk 17:31</ref>.</char></note>uzaaba ari heejuru y'inzu aramenye yekuzaamanuka ngo yinjire mu nzu kugira ngo agire ico avaanamo. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Uzaaba ari mu murima, yekuzaasubira mu rugo gushaaka umwiteero. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Abagore batwite n'abo bazaaba bari konsa bazaaguusha ishano ico gihe! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Nuuko musenge caane kugira ngo ibyo bitazaabaho mu gihe c'imbeho. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" /><note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="REV 7:14">Ibya 7:14</ref>.</char></note>Kuko muri iyo minsi hazaabaho amakuba akabije ataariigeze abaho uheereye mu intangiriro ubwo Imaana yaremaga ukageza noone, kandi ntaazongera kubaho ukundi. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Iyo Uhoraho atagabanya iyo minsi, nta wari kuzaarokoka. Ariko ku bw'abo yiitooranyirije, iyo minsi yarayigabanyije.<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />Ico gihe, nihazaagira ubabwira ati, ‘Dore, Kristo nguuyu’ cangwa ati, ‘Nguuriiya’, ntimuzaabyemere. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Hazaaza abiyita Kristo n'abahanuuzi b'ibinyoma beerekana ibimenyeetso, bakora n'ibitangaaza kugira ngo bayobye abantu, kandi byashoboka bakayobya na ba bandi Imaana yiitooranyirije. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Murabe maaso reero! Ibi byose mbaaye mbibabwiye igihe kitaraagera.<verse eid="MRK 13:23" /></para>
  <para style="s1">Kugaruka kw'Umwana w'Umuntu</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat 24:29-31</ref>; <ref loc="LUK 21:25-28">Luk 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:24 </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:12">Ibya 6:12</ref>.</char>
    </note>Ariko muri iyo minsi, haanyuma y'iyo mibabaro,</para>
  <para style="q1" vid="MRK 13:24">izuuba riziijima kandi</para>
  <para style="q2" vid="MRK 13:24">n'ukwezi nti kuzaava ngo kumurike,<verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:25 </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:13">Ibya 6:13</ref>.</char>
    </note>n'inyenyeeri zizaahanantuka ziva mu kireere,</para>
  <para style="q2" vid="MRK 13:25">kandi imbaraga zo mu ijuru nazo, zizanyeganyezwa.<verse eid="MRK 13:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MRK 13:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:26 </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:7">Ibya 1:7</ref>.</char>
    </note>Ubwo nibwo bazaabona Umwana w'Umuntu aturutse mu bicu, afite imbaraga nyinshi n'ikuzo. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Nuuko azoohereza abaamalayika be mu nshonda enye z'isi gukungaanya abo yiitooranyirije uheereye ku mpera y'isi ukageza ku mpera y'ijuru.”<verse eid="MRK 13:27" /></para>
  <para style="s1">Ico Twiga ku Giti Ciitwa Umutiini</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mat 24:32-35</ref>; <ref loc="LUK 21:19-33">Luk 21:19-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“Reka igiti ciitwa umutiini kibabeere urugero. Iyo mubona amashami yaaco yoroheereye akameraho amababi, mumenya yuuko igihe kiba kirenda guhinduka. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Noone reero, nimuzaabona ibyo nababwiye bibaaye, muzaamenye ko Umwana w'Umuntu ari haafi kuuza, ndetse ko azaaba ageze ku irembo. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Ni ukuri ndabahamiriza yuuko ab'iki gihe batazaashira, ibi bitaraasohora. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Ijuru n'isi bizaashiraho, ariko amagambo yanje ntaabwo azaashira.<verse eid="MRK 13:31" /></para>
  <para style="s1">Mube Maaso</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mat 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:32 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:36">Mat 24:36</ref>.</char>
    </note>Icakora, kubyerekeye umunsi cangwa igihe bizaabeeraho, nta we ubiizi, haaba abaamalayika bo mu ijuru cangwa Umwana w'Imaana, biizwi na Daata weenyine. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Nuuko reero mwirinde, mube maaso kandi musenge<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera ntaabwo hongerwaho</char><char style="fqa" closed="false">Musenge.</char></note>, kuko mutaazi igihe co ibyo bizaasohorera. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" /><note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">Luk 12:36-38</ref>.</char></note>Byagereranywa n'uko umuntu yaaja ku rugendo, agasigira abagaragu urugo rwe, buri umwe akamusigira ico gukora. Agategeka umurinzi wo ku irembo guhora ari maaso. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />Ni mube maaso reero kuko ntaawe uzi igihe shoobuja, ariwe nyir'urugo azaazira. Niiba ari kumugorooba, mu gicuku cangwa mu rukeereera. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Muramenye atazaabatungura akabasanga musinziiriye. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Kandi ibyo mbabwira, ndabibwira boose, mube maaso.”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s1">Baja Inaama yo Kugambaanira Yesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26:1-5</ref>; <ref loc="LUK 22:1-2">Luk 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoh 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Haari hasigaye iminsi ebyiri hakabaho iminsi mikuru yo kwizihiza iminsi y'ibirori byo Kunyurwaho, hamwe n'ubushitsi bwo kurya Imigaati Idasembuwe. Abakuru b'abaheerezabitambo hamwe n'Abiigiishamategeko baashaakaga ukuntu bafata Yesu rwihishwa, bakamwica. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Icakora baribwira bati, “Ntibyashoboka ko tumufata muri iki gihe c'iminsi y'ibirori kuko byateera agasasamaro muri rubanda.”<verse eid="MRK 14:2" /></para>
  <para style="s1">Yesu Asiigwa Amavuta Ahuumura Neeza i Beetaniya</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26:6-13</ref>; <ref loc="JHN 12:1-8">Yoh 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:3 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:37">Luk 7:37</ref>,<ref loc="LUK 7:38">38</ref>.</char>
    </note>Igihe Yesu yari i Beetaniya kwa Simooni wari umubembe yiicaye afungura, umugore azana icupa ryuzuye amavuta ahuumura neeza yiitwa Naridi. Ayo mavuta yari amininnye kandi ahenze caane. Apfunduura iryo cupa maze asuka ya mavuta ku mutwe wa Yesu. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Bamwe mu baari aho bararaakara bariitotomba bati, “Aya mavuta apfuuye iki? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Mbese ntiyari kuguriishwa idinaari zirenga magana atatu, maze ayo mashilingi akagabirwa abakene?” Babivuga batonganya uwo mugore caane. <verse eid="MRK 14:5" /><verse number="6" style="v" sid="MRK 14:6" />Yesu arababwira ati, “Ni mumureke, muramuhoora iki? Ico ankoreye ni ciiza caane. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Abakene, muhorana na bo kandi mwabagirira neeza igihe coose mushaakiye, ariko njeeweho ntituzaahorana iteeka. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Akoze ico ashoboye, ansiize aya mavuta ku mutwe ngo antunganye umubiri mbere y'igihe, anteguurira guhambwa. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Na noone ndababwiza ukuri yuuko, mu isi yoose aho Ubutumwa Bwiza buzaabwirizwa, ibyo akoze bizaavugwa kugira ngo yiibukwe.”<verse eid="MRK 14:9" /></para>
  <para style="s1">Yuda Agambaanira Yesu</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mat 26:14-16</ref>; <ref loc="LUK 22:3-6">Luk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Umwe mu biigiishwa cumi na babiri wiitwaga Yuda Isikariyoti aja kuvugana n'abatware b'abaheerezabitambo kugira ngo areebe uburyo yagambaanira Yesu. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Babyumvise batyo, baraneezeerwa, bamuseezeranya kumuha amashilingi. Aheerako atangira gushaakiisha igihe gikwiriye co kumugambaanira.<verse eid="MRK 14:11" /></para>
  <para style="s1">Yesu Asangira n'Abiigiishwa be Ifunguro ry'Ibirori byo Kunyurwaho</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat 26:17-25</ref>; <ref loc="LUK 22:7-14">Luk 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yoh 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Ku munsi wa mbere wo mu minsi y'ibirori by'Imigaati Idasembuwe, kandi anari wo munsi baatambiragaho umwana w'intaama wo Kunyurwaho, abiigiishwa baramubaza bati, “Mbese ni he ushaaka ko tugutungaanyiriza iby'ibirori byo Kunyurwaho?” <verse eid="MRK 14:12" /><verse number="13" style="v" sid="MRK 14:13" />Atuma babiri mu biigiishwa be arabategeka ati, “Ni mugende mu tawuni, muri buhuure n'umugabo wiikoreye ikibindi c'amaazi, mumukurikire <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />mu nzu yo aribwinjiremo, mubwire nyirayo muti, ‘Umwigiisha aradutumye ngo utwereke igisenge c'abashitsi wateguuye aho ari busangirire ifunguro ry'ibirori byo Kunyurwaho n'abiigiishwa be.’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Na we aribubeereke igisenge kigari mu karinaabiri heejuru kirimo aho kwicara kandi giteguuwe neeza. Aho abe ariho mudutungaanyiriza.” <verse eid="MRK 14:15" /><verse number="16" style="v" sid="MRK 14:16" />Abo biigiishwa baragenda, binjira mu tawuni, basanga byose bimeze nk'uko yababwiye. Batangira kwiteguurira ifunguro ry'ibirori byo Kunyurwaho. <verse eid="MRK 14:16" /><verse number="17" style="v" sid="MRK 14:17" />Bugoroobye, azana n'abiigiishwa be cumi na babiri. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Bamaze kwicara bari kurya, Yesu aravuga ati, “Ndababwira ukuri yuuko umwe muri mwe, uwo dusangira aribungambaanire.” <verse eid="MRK 14:18" /><verse number="19" style="v" sid="MRK 14:19" />Batangira kugira ishavu, maze baramubaza umwe umwe bati, “Ahaari yaaba ari njeewe?” <verse eid="MRK 14:19" /><verse number="20" style="v" sid="MRK 14:20" />Yesu arabasubiza ati, “Ni umwe muri mwe cumi na babiri, uwo turi buhuurize intoki mu sahaane. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Umwana w'Umuntu azaapfa nk'uko ibyanditswe bimuvugaho. Nyamara umugambaanira azaabona ishano! Icaakabaaye ciiza ni uko uwo muntu aba ataaravuutse.”<verse eid="MRK 14:21" /></para>
  <para style="s1">Yesu Asangira n'Abiigiishwa be Ifunguro rya Nyuma</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mat 26:26-30</ref>; <ref loc="LUK 22:14-20">Luk 22:14-20</ref>; <ref loc="1CO 11:23-25">1 Kor 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Bakirya, Yesu afata umugaati, amaze kuwushiimira Imaana, arawumanyagura, awuha abiigiishwa be avuga ati, “Ni mwakiire murye, uyu ni umubiri wanje.”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Afata n'igikopu, arangije kugishiimira Imaana arakibaha, banywaho boose. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Arababwira ati, “Aya ni amaraso yanje y'iseezerano risha, amenwe ku bwa benshi. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Ndababwira ukuri yuuko ntazongera kunywa kuri iyi divaayi, kugeza ubwo nzanywera divaayi nsha mu bwami bw'Imaana.”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Nuuko baririmba indirimbo zo guhimbaaza Imaana, baja ku musozi wa Elayoni<note caller="+" style="f"><char style="fr" closed="false">14:26</char><char style="fq" closed="false">Ku musozi wa Elayoni </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera bavuga </char><char style="fqa" closed="false">Ku musozi w'imizeeti </char></note>.<verse eid="MRK 14:26" /></para>
  <para style="s1">Yesu Avuga ko Peetero Azamwihakana</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoh 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Yesu arababwira ati, “Mwese muzansiga njenyine, nk'uko byanditswe ngo,</para>
  <para style="q1" vid="MRK 14:27">‘Nzaakubita umushumba,</para>
  <para style="q2" vid="MRK 14:27">intaama zitaataane.’<verse eid="MRK 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:28 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 28:16">Mat 28:16</ref>.</char>
    </note>Ariko niimara kuzuuka, nzaababanziriza i Galileeya.”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Peetero aramubwira ati, “Naaho abandi baaguhunga, njeewe sinzaagusiga.”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Yesu aramusubiza ati, “Ndakubwiza ukuri yuuko muri iri joro, isaaki itaraabika kabiri, uri bube wanyiihakanye gatatu.”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Ariko Peetero arushaho guhamya ati, “Naaho nagomba gupfaana naawe, ntaabwo nzaakwihakana na hato!”</para>
  <para style="p" vid="MRK 14:31">Nuuko n'abandi boose bavuga batyo.<verse eid="MRK 14:31" /></para>
  <para style="s1">Yesu Asengera i Getsemaani</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat 26:36-46</ref>; <ref loc="LUK 22:39-46">Luk 22:39-46</ref>; <ref loc="LUK 22:39-46">Luk 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Haanyuma baja ahantu hiitwa i Getsemaani. Bahageze abwira abiigiishwa be ati, “Ni mube mwicaye hano, ngiye gusenga.” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Ajaana Peetero, na Yaakobo na Yohaana, atangira guhagarika umutima no gushavura. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Nuuko arababwira ati, “Umutima wanje ufite agahinda gasaaze, kenda kunyica. Ni mugume hano mube maaso.”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Yiigira hirya gato, yuubama haasi, arasenga ngo niiba bishoboka, ico gihe c'umubabaro kimurenge. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Aravuga ati, “Daata, kuri wowe byose birashoboka, ntabaara unkize uyu mubabaro. Ariko bye kuba nk'uko mbishaaka, ahuubwo bibe uko ushaaka.” <verse eid="MRK 14:36" /><verse number="37" style="v" sid="MRK 14:37" />Agarutse asanga basinziiriye, abaza Peetero ati, “Simooni, urasinziiriye? Ntaabwo washobora kuba maaso niibura isaaha imwe?” <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Nuuko arababwira ati, “Ni mube maaso kandi musenge kugira ngo mutagwa mu bishuko. Umutima urashaaka ariko umubiri ufite intege nke.”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Yongera gusubirayo arasenga, asubira muri ya magambo. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Agarutse nabwo asanga abiigiishwa basinziiriye. Ibitotsi byari byabaganjije, maze babura ico kumusubiza.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Agarutse ubwa gatatu, arababwira ati, “Mbese muracasinziiriye, muraruhuutse? Birahaagije! Igihe kirageze, Umwana w'Umuntu agabijwe mu maboko y'abanyabyaha. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Ni muhaguruke tugende, dore ungambaanira arasohoye.”<verse eid="MRK 14:42" /></para>
  <para style="s1">Yesu Afatwa</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26:47-56</ref>; <ref loc="LUK 22:47-53">Luk 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoh 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Yesu akivuga, umwe mu biigiishwa be wiitwaga Yuda abe araaje. Yari kumwe n'igiteero c'abantu biitwaje inkoota n'ubuhiri booherejwe n'umutware w'abaheerezabitambo, n'Abiigiishamategeko hamwe n'abakuru b'imiryango. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Umugambanyi yari yarababwiye akamenyeetso azaakoreesha ati, “Ni mubona uwo ndaramutsa nkamusoma araba ari we uwo, mumufate mumujaane ntaabacike.”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Muri ako kaanya Yuda ahageze, aja aho Yesu ari aramuramutsa ati, “Mwigiisha!” Maze aramusoma. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Baramusingiira, baramufata. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Ariko umwe mu baari bahagaze aho akuurayo inkoota ayikubita umugaragu w'umutware w'abaheerezabitambo amuca ugutwi. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Yesu arabasubiza ati, “Harya mwagombaga kuuza kumfata mwitwaje inkoota n'ubuhiri nk'aho nd'igisambo? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" /><note caller="-" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luk 19:47</ref>; <ref loc="LUK 21:37">21:37</ref>.</char></note>Buri munsi ko nahoraga ndi namwe mu nzu y'Imaana ndi kwigiisha, ntihagire ico muntwara? Ariko nyamara, reka ibyanditswe bisohore.”<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />Nuuko abiigiishwa be boose baramuteererana, barahunga. <verse eid="MRK 14:50" /><verse number="51" style="v" sid="MRK 14:51" />Haari umusore wambaye umwenda w'umweru akurikira Yesu, bagerageza kumufata, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />ata wa mwenda yiiruka yambaye ubusa.<verse eid="MRK 14:52" /></para>
  <para style="s1">Yesu Bamuciira Urubanza</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mat 26:57-68</ref>; <ref loc="LUK 22:54-55">Luk 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yoh 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Bajaana Yesu imbere y'Umuheerezabitambo mukuru, aho abatware b'abaheerezabitambo, abakuru b'imiryango hamwe n'Abiigiishamategeko baari bateeraniye. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Peetero yari yaamukurikiye, bakarenga ahinguka, kugera mu gikaari c'Umuheerezabitambo mukuru, yiicara n'abarinzi baaho, boota umuriro. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Umutware w'abaheerezabitambo n'abandi boose baari mu rukiiko bashaakiisha ubujurizi bwahamya kugira ngo biice Yesu, ariko barabubura. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Haabonetse benshi bamushinja ibinyoma, ariko bakanyuranya.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Bamwe bahaguruka bamushinja ibinyoma bati, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" /><note caller="-" style="x"><char style="xo" closed="false">14:58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">Yoh 2:19</ref>.</char></note>“Twamwumviise avuga ati, ‘Nzaaseenya iyi nzu y'Imaana yubatswe n'amaboko y'abantu, maze mu minsi itatu nuubake iyindi ituubatswe n'amaboko.’ ” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Ariko na bo ibirego byabo byari binyuranye.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Umuheerezabitambo mukuru ahagarara imbere yaabo abaza Yesu ati, “Koko nta co wiireguura? Nti wumvise ibyo bakurega?”<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />Ariko Yesu araceceka ntihaagira ico asubiza. Yongera kumubaza ati, “Harya ni wowe Kristo Umwana w'Imaana idahinyuka?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Yesu aramusubiza ati, “Ndi we,</para>
  <para style="q1" vid="MRK 14:62">kandi muzaabona Umwana w'Umuntu</para>
  <para style="q1" vid="MRK 14:62">yiicaye iburyo bwa Nyir'ububaasha,</para>
  <para style="q1" vid="MRK 14:62">muzaamubona aje mu bicu byo mu ijuru.”<verse eid="MRK 14:62" /></para>
  <para style="m">
    <verse number="63" style="v" sid="MRK 14:63" />Umuheerezabitambo mukuru abyumviise, atandura imyambaro ye aravuga ati, “Turacashaakira iki abo kumushinja? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Mwiyumviye neeza ko asebya Imaana! Noone murabiteekerezaho iki?”</para>
  <para style="p" vid="MRK 14:64">Boose bamushinja urubanza ko, akwiriye kwicwa.<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />Bamwe batangira kumuciiraho, bamupfuka ku maaso bakamukubita bamubwira bati, “Ngaho hanuura utubwire ugukubise!” Abarinzi baaho na bo baramujaana bamukubita inshi.<verse eid="MRK 14:65" /></para>
  <para style="s1">Peetero Yiihakana Yesu</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mat 26:69-75</ref>; <ref loc="LUK 22:56-62">Luk 22:56-62</ref>; <ref loc="JHN 18:15-18">Yoh 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Peetero yari yiicaye mu gikaari, haaza umuja w'Umuheerezabitambo mukuru. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Uwo muja aboonye Peetero yoota umuriro aramwitegereza aravuga ati, “Naawe wari hamwe na Yesu w'i Nazaareeti!”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Peetero aramuhakanira ati, “Ntaabwo nitegereza ibyo uvuga,” arasohoka arigendera, ageze ku irembo isaaki irabika.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Wa muja yongera kumubona atangira kubwira abaari bahagaze aho bashungeera ati, “Uyu ni umwe muri bo!” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Peetero yongera guhakanira kure.</para>
  <para style="p" vid="MRK 14:70">Haciiyeho akaanya gato, abaari bahagaze aho bakomeza gushinja Peetero bati, “Reka kwihakana ko utari umwe muri bo kuko naawe uturuka i Galileeya.”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Nuuko Peetero acurikiranya indahiro ati, “Ni ukuri uwo muntu muvuga siimuuzi!”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Muri ako kaanya, isaaki ibika ubwa kabiri. Peetero yiibuka ibyo Yesu yari yaamubwiye ati, “Isaaki itaraabika kabiri, uraba waanyihakanye gatatu.” Ateerwa n'agahinda gasaaze ararira.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s1">Yesu Bamuuzanira Pilaato</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luk 23:1-5</ref>; <ref loc="JHN 18:28-38">Yoh 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Kare mugitondo, abatware b'abaheerezabitambo baja inaama hamwe na bakuru b'imiryango n'Abiigiishamategeko, ndetse n'abagize inaama nkuru boose. Baboha Yesu, maze baramujaana bamushikiriza Pilaato. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Pilaato aramubaza ati, “Mbese uri umwami w'Abayuuda?”</para>
  <para style="p" vid="MRK 15:2">Yesu aramusubiza ati, “Urabyivugiye.”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Abatware b'abaheerezabitambo bamurega byinshi. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Pilaato yongera kumubaza ati, “Ntaaco wasubiza? Ntiwumva ibyo bakurega byose?” <figure style="fig" alt="Jesus brought before Pilate." file="DD-39A.TIF" size="col" loc="Darwin" copy="The British and Foreign Bible Societies." ref="15:4">Yesu azanwa imbere ya Pilaato.</figure><verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Ariko Yesu ntiyagira ico yongera gusubiza, maze Pilaato biramutangaaza.<verse eid="MRK 15:5" /></para>
  <para style="s1">Pilaato Atanga Yesu ngo Abambwe</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat 27:15-26</ref>; <ref loc="LUK 23:13-25">Luk 23:13-25</ref>; <ref loc="JHN 8:39">Yoh 8:39</ref>; <ref loc="JHN 19:16">19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Mu minsi mikuru y'ibirori byo Kunyurwaho, Pilaato yabarekuriraga umusibe uwo baabaga bamusabye. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Ico gihe haariho umugabo wiitwa Baraba wari warafunganywe n'abagambanyi b'igihugu bari baarakoze icaaha co kwica mu gihe c'impagarara. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Abantu benshi baraaza batangira gusaba Pilaato ngo abagenzereze nk'uko yabamenyeereje. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Nuuko arababaza ati, “Murashaaka ko mbarekurira umwami w'Abayuuda?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Kuko yari azi neeza ko abatware b'abaheerezabitambo baamutanze ku bw'ishari.<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />Ariko abatware b'abaheerezabitambo boosha rubanda ngo ahuubwo basabe ko abarekurira Baraba. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Pilaato arongera arababaza ati, “Noone se murashaaka ko ngenza nte uyu mugabo wo mwise umwami w'Abayuuda?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Bateera heejuru bavuga bati, “Mubambe!”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Pilaato arababaza ati, “Kuki, ikibi yakoze ni ikihe?” Maze barushaho guteera heejuru bati, “Mubambe!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Nuuko Pilaato, ahitamo gushiimiisha abantu, maze abarekurira Baraba. Bamaze gukubita Yesu, aramutanga ngo baje kumubamba.<verse eid="MRK 15:15" /></para>
  <para style="s1">Abasirikare Bashinyagurira Yesu</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mat 27:27-31</ref>; <ref loc="JHN 19:2-3">Yoh 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Nuuko abasirikare bamujaana mu gikaari c'ingoro y'umwami, maze bakoranya umutwe w'ingabo zoose zirateerana. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Bamwambika umwenda w'umuhengeri, bamaze kuboha ikamba ry'amahwa, barimwambika ku mutwe. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Batangira kumuramutsa bamunnyega bati, “Turakuramutsa mwami w'Abayuuda!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Bamukubita urubingo mu mutwe, bamuciiraho, barapfukama baramuramya. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Bamaze kumushinyagurira, bamwambura wa mwenda w'umuhengeri maze bamwambika imyenda ye, bamujaana ku mubamba.<verse eid="MRK 15:20" /></para>
  <para style="s1">Yesu Abambwa k'Umusaraba</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat 27:32-44</ref>; <ref loc="LUK 23:26-43">Luk 23:26-43</ref>; <ref loc="JHN 19:17-27">Yoh 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:21 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 16:13">Rom 16:13</ref>.</char>
    </note>Abasirikare bakigenda bahuura na Simooni w'umunyakureeni watambuukaga avuuye mu caaro, bamuhata kwikorera umusaraba wa Yesu. Simooni yari se wa Alekizanda na Rufusi. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Nuuko bajaana Yesu ahantu hiitwa Gologota bisobaanura ku k'ibihanga. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Bamuha divaayi ivanze n'umuti wiitwa maya<note caller="+" style="f"><char style="fr" closed="false">15:23 </char><char style="ft" closed="false">Maya n'umuti ugabanya uburiibwe ushaarira</char></note>, ariko ntiyayinywa. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Nuuko baramubamba, maze bagabana imyenda ye, bakoreesheje ubufindo ngo bamenye ico buri umwe aribujaane. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Baamubambye isaaha itatu zo mugitondo. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Inyandiko y'ikirego yandikwa heejuru ye, ngo, “Umwami w'Abayuuda.” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Maze bamubambana n'abambuzi babiri, umwe iburyo, undi ibumoso. [ <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Nuuko biba nk'uko ibyanditswe bivuga ngo “Yabazwe mu bagome.”] <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" /><note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="MRK 14:58">Mar 14:58</ref>; <ref loc="JHN 2:19">Yoh 2:19</ref>.</char></note>Abaanyuraga aho bakamutuka, bakazunguza imitwe bavuga bati, “Ahaa! Wowe waashobora guseenya Inzu y'Imaana maze ukayubaka mu minsi itatu, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />ikize ubwawe, maze umanuke k'umusaraba!”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Abatware b'abaheerezabitambo, hamwe n'abanditsi na bo bakamushinyagurira bavuga bati, “Yakijije abandi, ariko yananiwe kwikiza. <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Kristo, Umwami wa Isirayeli, manuka k'umusaraba noone aha, kugira ngo tureebe maze twemere.”</para>
  <para style="p" vid="MRK 15:32">Ndetse n'abaari babambanywe na we na bo baramutuka.<verse eid="MRK 15:32" /></para>
  <para style="s1">Urupfu rwa Yesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27:45-56</ref>; <ref loc="LUK 23:44-49">Luk 23:44-49</ref>; <ref loc="JHN 19:28-30">Yoh 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Zibaaye saaha itandatu, isi yoose icura umwijima kugeza saaha icenda. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Isaaha icenda zigeze, Yesu ataka mu ijwi rirenga ati, “Eloyi, Eloyi, lama sabakitani?” Bisobaanura ngo, “Maana yanje, Maana yanje, n'iki gitumye unteererana?”<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Bamwe mu baari bahagaze aho babyumviise, baravuga bati, “Murumva! Aratabaaza Eliya.” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Nuuko umwe ariiruka, afata icangwe acuuzuza divaayi ishaariira, agihambiira ku rubingo, aramuheereza ngo anywe, avuga ati, “Reka tureebe ko Eliya yaza kumumanura ku musaraba.”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Yesu ataka caane maze ahuumeeka uwanyuma.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Umwenda ukingiriza aheera ho mu nzu y'Imaana utandukamo kabiri, uheereye heejuru ukageza haasi. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Umutware w'abasirikare wari uhagaze imbere ye, aboonye uko apfuuye, aravuga ati, “Koko uyu mugabo yari Umwana w'Imaana.”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:40 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:2">Luk 8:2</ref>,<ref loc="LUK 8:3">3</ref>.</char>
    </note>Haari abagore baareeberaga kure, baarimo Mariya Magadaleena, na Mariya nyina wa Yaakobo muto, Yozesi na Salome. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Aba bagore baakurikiraga Yesu bakanamufasha akiri i Galileeya, kandi baari kumwe n'abandi bagore benshi bamuherekeje aja i Yerusaalemu.<verse eid="MRK 15:41" /></para>
  <para style="s1">Guhambwa kwa Yesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27:57-61</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoh 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Bugoroobye, ku munsi ubanziriza i Saabato anariwo munsi wo kwiteguura, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Yozefu w'i Arimatiya, umujaanaama w'icuubahiro w'urukiiko rw'Abayuuda, na we wari utegereje Ubwami bw'Imaana, aja kwa Pilaato ashirutse ubwoba asaba umurambo wa Yesu. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Maze Pilaato atangaazwa n'uko Yesu yaaba yaapfuuye, ahamagaza umutware w'abasirikare, amubaza niiba Yesu yapfuuye koko. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Amaze kubyemezwa, yeemerera Yozefu kujaana umurambo. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Nuuko Yozefu agura umwenda w'umweru, amaze kumanura umurambo, awupfunyika muri wa mwenda, awushira mu mva yari yaracukuwe mu rutare. Haanyuma ahirikira ibuye rinini ku muryango w'imva. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Mariya Magadaleena na Mariya nyina wa Yozesi babona aho umurambo uhambwe.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s1">Kuzuuka kwa Yesu</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat 28:1-8</ref>; <ref loc="LUK 24:1-12">Luk 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoh 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Isaabato irangiye, Mariya Magadaleena, Mariya nyina wa Yaakobo na Salome, bagura amavuta ahuumura neeza, ngo baje gusiiga umubiri wa Yesu. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Mu gitondo kare kare ku cumweru, baja ku mva bagerayo izuuba rirashe. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Baravuganaga bati, “Ni inde uribuduhirikire rya buye riri ku muryango w'imva?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Biitegereje, babona rya buye ryari rinini caane ryahirikiwe iruhande. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Binjiye mu mva, babona umusore wiicaye iburyo, yambaye ikanzu yeera, maze bagira ubwoba.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />Arababwira ati, “Mwigira ubwoba, murashaaka Yesu w'i Nazaareeti, wabambwe ku musaraba? Yaazuutse, ntaabwo ari hano. Ntimureeba aho baari bamushize! <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" /><note caller="-" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mat 26:32</ref>; <ref loc="MRK 14:28">Mar 14:28</ref>.</char></note>Nimugende mubwire abiigiishwa be, na Peetero ko ari bubatange i Galileeya. Muzaamubona nk'uko yabibabwiye.”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Bava mu mva bahunga, kuko ubwoba bwari bwabataashe, kandi ntihaagira uwo babibwira ku bwo gutiinya<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">Bimwe mu bindi bwanditswe byera, ubutumwa bwa Mariko burangirana n'umurongo wa munane. Ahandi, burangira n'umusoozo mugufi; naho abandi bongera ho kuva kumurongo wa cenda kugeza ku wa makumyabiri.</char></note>.</para>
  <para style="s1" vid="MRK 16:8">Umusoozo Mugufi w'Ubutumwa Bwiza bwa MARIKO</para>
  <para style="p" vid="MRK 16:8">[Kandi ibyo baategetswe babibwira abaari begeereye Peetero muri make. Nyuma yaaho, Yesu ubwe yaboohereje kwamamaza ibyera by'agakiza gahoraho iteeka uheereye iburasirazuuba ukageza iburengerazuuba.<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera hongerwaho </char><char style="it">Amiina</char> </note>]</para>
  <para style="ms" vid="MRK 16:8">Umusoozo Mureemure w'Ubutumwa Bwiza bwa MARIKO</para>
  <para style="mr" vid="MRK 16:8">(<ref loc="MRK 16:9-20">16:9-20</ref>)</para>
  <para style="s1" vid="MRK 16:8">Yesu Abonekera Mariya Magadaleena</para>
  <para style="r" vid="MRK 16:8">(<ref loc="MAT 28:9-10">Mat 28:9-10</ref>; <ref loc="JHN 20:11-18">Yoh 20:11-18</ref>)</para>
  <para style="p" vid="MRK 16:8">[<verse eid="MRK 16:8" /><verse number="9" style="v" sid="MRK 16:9" />Ku cumweru mu gitondo, Yesu amaze kuzuuka, abanza kubonekera Mariya Magadaleena, wo yari yariirukanyemo abadayimooni barindwi. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Aja kubimenyeesha abaabaanaga na Yesu, bakiri mumaganya n'amarira. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Bamaze kumva ko ari muzima kandi ko yamuboonye, ntibaabyemera.<verse eid="MRK 16:11" /></para>
  <para style="s1">Yesu Abonekera Abiigiishwa Babiri</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luk 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Haanyuma y'ibyo, abonekera abiigiishwa babiri afite irindi shusho, ubwo baagendaga baja mu caaro. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Maze basubirayo babibwira abandi, ariko ntibaabeemera.<verse eid="MRK 16:13" /></para>
  <para style="s1">Yesu Yiiyereka Abiigiishwa Cumi n'Umwe</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28:16-20</ref>; <ref loc="LUK 24:36-49">Luk 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoh 20:19-23</ref>; <ref loc="ACT 1:6-8">Iby 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Haanyuma yiiyereka ba cumi n'umwe ubwo baari ku meeza bafungura, maze abagayira kuteemera kwabo no kwinangira umutima, kuko baari banze kwemera abari baamuboonye amaze kuzuuka. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" /><note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">Iby 1:8</ref>.</char></note>Arababwira ati, “Nimuje mu bihugu byose, mwamamaze Ubutumwa Bwiza ku bantu boose. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Uzeemera akabatizwa azaakira, naho utazeemera azaaciirwaho iteeka. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Kandi ibi bimenyeetso ni byo bizaaranga abiizeera; kwirukana abadayimooni mu izina ryanje, bazaavuga indimi nsha, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />bazaafata inzoka mu ntoki zaabo, kandi nibagira ico banywa ciica, ntaaco bazaaba, bazaarambuura ibiganza ku barwayi, maze bakire.”<verse eid="MRK 16:18" /></para>
  <para style="s1">Yesu Ajanwa mu Ijuru</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luk 24:50-53</ref>; <ref loc="ACT 1:9-11">Iby 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:9-11">Iby 1:9-11</ref>.</char>
    </note>Umwami Yesu amaze kuvugana na bo, ajanwa mu ijuru, nuuko yiicara iburyo bw'Imaana. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Abiigiishwa baja hoose baamamaza Ubutumwa Bwiza, naho Nyagasani aguma kubafasha no gutanga ibimenyeetso bigaragaza ibikorwa byabo<note caller="+" style="f"><char style="fr" closed="false">16:20 </char><char style="ft" closed="false">Bimwe mu bindi byanditswe byera bya kare, bongeraho ijambo </char><char style="it">Amiina.</char></note>.]<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>