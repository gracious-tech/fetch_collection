<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Rufumbira New Testament</book>
  <para style="h">ABAHEBURAAYO</para>
  <para style="toc1">Urwandiko Intumwa Pawulo yandikiye ABAHEBURAAYO</para>
  <para style="toc2">ABAHEBURAAYO</para>
  <para style="toc3">Heb</para>
  <para style="mt1">ABAHEBURAAYO</para>
  <para style="imt">INYANZURO</para>
  <para style="ip">
    <char style="bk">Urwandiko rwandikiwe Abaheburaayo </char> rwandikiwe agatsiko k'Abakristo baahuuraga no guhakanywa bikabije bikabashira mu kaaga ko kuba baava mu kwizeera kwa gikristo. Umwanditsi akomeza abakristo mu kwizeera kwabo na caane abeereka ko Yesu Kristo ari we kuri no guhishuurwa kwa nyuma kw'Imaana. Mu gukora ibi, umwanditsi ashimangira ukuri mu buryo butatu: Ica mbere, Yesu ni Umwana w'Imaana w'iteeka ryose watoojwe ukuri ko kuubaha Se abiheeshwa no kubabazwa uko yiihangaaniye. Nk'Umwana w'Imaana, Yesu asumba abahanuuzi b'iseezerano rya keera, abaamalayika kandi na Moose ubwe. Ica kabiri, Yesu yahamijwe n'Imaana kuba umuheerezabitambo w'iteeka ryose uruta abaheerezabitambo bo mu iseezerano rya keera. Ica gatatu, muri Yesu ni mwo uwiizeera abonera gukizwa icaaha, n'ubwoba hamwe n'urupfu kandi Yesu nk'Umuheerezabitambo Mukuru atanga agakiza nyakuri ari ko konyine kari kaarateeberejwe n'imigenzo kandi n'ibitambo by'inyamaaswa byo mu idini y'Abaheburaayo.</para>
  <para style="ip">Umwanditsi yeerekana iciitegererezo co kwizeera kwa bamwe mu bantu baazwi mu byabaayeho byo mu Isirayeli - igice ca cumi na kimwe, umwanditsi asaba abasoma kuguma mu kwizeera, kandi mu gice ca cumi na kabiri, akomeza gushiramo umwete abasomyi be kuguma mu kwizeera kugeza ku iheerezo, amaaso yaabo bayahanze Yesu kandi biihangaanira kubabazwa no gutootezwa gushobora kubaazaho. Igitabo gisoozwa n'amagambo yo gutanga inaama no kwamagirira.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro: Kristo ni we guhishuurwa kwuzuye kw'Imaana <char style="ior"><ref loc="HEB 1:1-3">1:1-3</ref></char></para>
  <para style="io1">Ubukuru bwa Kristo buruta ubw'abaamalayika <char style="ior"><ref loc="HEB 1:4-2:18">1:4—2:18</ref></char></para>
  <para style="io1">Ubukuru bwa Kristo buruta ubwa Moose na Yosuwa <char style="ior"><ref loc="HEB 3:1-4:13">3:1—4:13</ref></char></para>
  <para style="io1">Ubukuru bwa Kristo nk'Umuheerezabitambo <char style="ior"><ref loc="HEB 4:14-7:28">4:14—7:28</ref></char></para>
  <para style="io1">Ubukuru bw'iseezerano rya Kristo <char style="ior"><ref loc="HEB 8:1-9:22">8:1—9:22</ref></char></para>
  <para style="io1">Ubukuru bw'Igitambo ca Kristo <char style="ior"><ref loc="HEB 9:23-10:39">9:23—10:39</ref> </char></para>
  <para style="io1">Ibanze ryo kwizeera <char style="ior"><ref loc="HEB 11:1-12:29">11:1—12:29</ref></char></para>
  <para style="io1">Gushiimiisha Imaana <char style="ior"><ref loc="HEB 13:1-19">13:1-19</ref></char></para>
  <para style="io1">Isengeesho ryo gusooza <char style="ior"><ref loc="HEB 13:20-21">13:20-21</ref></char></para>
  <para style="io1">Amagambo ya nyuma <char style="ior"><ref loc="HEB 13:22-25">13:22-25</ref></char></para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s1">Ijambo ry'Imaana Rinyuriye mu Mwana Waayo</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Keera Imaana yavuganye na ba sogokuruza kenshi kandi mu buryo bwinshi inyuriye mu bahanuuzi, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />ariko muri iki gihe ca nyuma, yavuganye naatwe ibinyujije mu Mwana waayo wo yatooranyije kuba umuragwa w'ibintu byose kandi Imaana yaremye isi inyuriye muri we. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Ni we werekana kurabagirana kw'ikuzo ry'Imaana kandi akaba ari we shusho rigaragaza kubaho kw'Imaana ndetse no gukomereesha byose imbaraga z'ijambo rye. Amaze kurangiza inteego yo kubabarira ibyaha, yiicara mu ijuru iburyo bw'Imaana Ikomeye.<verse eid="HEB 1:3" /></para>
  <para style="s1">Umwana w'Imaana Asumba Abaamalayika</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />Umwana yashizwe heejuru kuruta abaamalayika nk'uko izina Imaana yamuhaaye riruta iryabo. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Kuko ntaan'umwe mu baamalayika Imaana yabwiye iti,</para>
  <para style="q1" vid="HEB 1:5">“Uri Umwana wanje, uyu munsi mbaaye So.” Cangwa iti,</para>
  <para style="q1" vid="HEB 1:5">“Nzaamubeera Se,</para>
  <para style="q2" vid="HEB 1:5">kandi na we ambeere Umwana.”<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Ariko igihe Imaana yari igiiye koohereza Umwana waayo w'imfura mu isi, yaravuze iti,</para>
  <para style="q1" vid="HEB 1:6">“Abaamalayika b'Imaana boose bakwiriye kumuramya.”<verse eid="HEB 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />Ku byerekeye abaamalayika, Imaana yaravuze iti,</para>
  <para style="q1" vid="HEB 1:7">“Igira abaamalayika baayo imiyaga,</para>
  <para style="q2" vid="HEB 1:7">kandi abagaragu baayo ikabagira ibirimi by'umuriro.”<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Naho ibyerekeye ku Mwana, ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="HEB 1:8">“Ubwami bwawe Maana, buzaahoraho iteeka ryose.</para>
  <para style="q2" vid="HEB 1:8">Uzaategekeesha abantu baawe ubutabeera.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Ukunda ibitungaanye ukanga ubugome.</para>
  <para style="q1" vid="HEB 1:9">Ni yo mpamvu Imaana, ari yo Maana yaawe, yagutooranyije</para>
  <para style="q2" vid="HEB 1:9">ikagusiiga amavuta y'umuneezeero w'icuubahiro co heejuru</para>
  <para style="q2" vid="HEB 1:9">kiruta ico yahaaye bagenzi baawe.”<verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Ibyanditswe birongera bikavuga ngo,</para>
  <para style="q1" vid="HEB 1:10">“Nyagasani, mbere na mbere waremye isi</para>
  <para style="q2" vid="HEB 1:10">kandi ukoreesha ibiganza byawe kurema ijuru.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Ibyo bizaashiraho ariko wowe uzaahoraho,</para>
  <para style="q2" vid="HEB 1:11">byose bizaasaaza nk'imyambaro.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Uzaabizinga nk'umwiteero,</para>
  <para style="q2" vid="HEB 1:12">kandi bizaahindurwa nk'imyambaro.</para>
  <para style="q1" vid="HEB 1:12">Ariko wowe ntuuhinduka,</para>
  <para style="q2" vid="HEB 1:12">kandi imyaka y'ubugingo bwawe ntiigira iherezo”.<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Ariko se ni nde mu baamalayika wo Imaana yabwiye iti,</para>
  <para style="q1" vid="HEB 1:13">“Icara iburyo bwanje</para>
  <para style="q2" vid="HEB 1:13">kugeza ubwo nzagira abanzi baawe</para>
  <para style="q2" vid="HEB 1:13">nk'akabaaho ukandagizaho ibirenge”?<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />Mbese abaamalayika boose si imyuka ikora umurimo w'Imaana ikaba yaratumwe gufasha abagenewe guhaabwa agakiza?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s1">Agakiza Gahebuuje</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Ni co gituma dukwiriye kurushaho kugira umwete wo kwita ku byo twumviise kugira ngo tutaaza kuyoba. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Kuko niiba ubutumwa bwamamajwe n'abaamalayika bwari ubw'ukuri kandi abo boose banze kubukurikiza bagahaabwa igihano gikwiriye, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />noone se tuzaarokoka dute nitwirengagiza ako gakiza gahebuuje? Umwami Yesu ubwe ni we wabanje kwamamaza ako gakiza kandi abamwuviise baahamije yuuko ari ukuri. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Naho Imaana yo yongereye ubuhamya bwayo ku bwabo ikoreesheje ibimenyeetso n'ibitangaaza n'ibindi bikorwa bitangaaje bitari bimwe na bimwe hamwe n'impaano z'Umwuka Weera, izo itanga nk'uko ibishaatse.<verse eid="HEB 2:4" /></para>
  <para style="s1">Utuyobora ku Gakiza</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Imaana ntiyahaaye abaamalayika kuba abategetsi b'isi izaaza, ari yo si tuvuga. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Ahuubwo mu byanditswe hari ahavuga ngo,</para>
  <para style="q1" vid="HEB 2:6">“Maana mbese ni iki caatuma uzirikana ikiremwamuntu?</para>
  <para style="q2" vid="HEB 2:6">Ikiremwamuntu gusa, mbese byatuma uciitaho?”<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Waramuremye umushira haasi y'abaamalayika akaanya gato;</para>
  <para style="q2" vid="HEB 2:7">wamwambitse ikamba ry'ikuzo n'icuubahiro,<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />kandi umugira umutegetsi w'ibintu byose.</para>
  <para style="m" vid="HEB 2:8">Bivuga ko Imaana yahaye ikiremwamuntu gutegeka ibintu byose, kimenyeesha ngo ntaanakimwe yasize. Ariko muri ibi bihe ntibiraagaragara ko byose bitegekwa na we. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Nyamara tubona Yesu, waciishijwe bugufi akaba haasi y'abaamalayika kumara igihe gito, ko ari we wambitswe ikuzo n'icuubahiro ku bw'umubabaro w'urupfu yanyuzemo kugira ngo ku bw'ubuntu bw'Imaana asogongerere abantu boose urupfu. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Byari bikwiriye ko Imaana ari yo dukeesha kurema ibintu byose kandi ikabibeeshaho, itungaanya Yesu imunyujije mu mubabaro kugira ngo igarure abaana baayo basangire ku ikuzo ryayo. Kuko Yesu ni we ugeza abantu ku gakiza.<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />Koko reero uweeza n'abeezwa boose basangiye Se. Ni co gituma Yesu adakorwa n'isoni kubiita beene Se <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />avuga ati,</para>
  <para style="q1" vid="HEB 2:12">“Nzaamamaza izina ryawe kuri beene daata,</para>
  <para style="q2" vid="HEB 2:12">nzagusingiriza hagati y'iteeraniro ryabo.”<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Kandi arongera ati, “Imaana ni yo nziringira.” Kandi ati, “Dore ndi hano hamwe n'abaana Imaana yampaaye.”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Ubwo reero abaana bahuuje umubiri n'amaraso, Yesu na we yahuuje byose na bo kugira ngo ku bw'urupfu ashobore kurimbura umwanzi Sataani ari we ufite ubutware bw'urupfu, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />kandi muri ubwo buryo abohoore abo boose baahoze mu bubaata ubuzima bwabo bwose babiteewe no gutiinya urupfu. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Kuko bisobaanutse neeza ko Yesu ataaje gufasha abaamalayika, ahuubwo ko yaaje gufasha urubyaro rwa Aburahamu. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Ku bw'iyo mpamvu, yagombaga guhinduka akamera nka beene Se mu buryo bwose kugira ngo abe Umuheerezabitambo Mukuru w'imbabazi kandi indahemuka ku murimo w'Imaana ngo abe impongano y'ibyaha by'abantu. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Ubwo na we ubwe yabanje kugeragezwa no kubabazwa, ashobora gutabaara abo boose bageragezwa.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s1">Yesu aruta Moose</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Nuuko reero bavandimwe, intungaane dufatanyije umuhamagaro uva ku Maana, muzirikane ko Yesu, Intumwa kandi Umuheerezabitambo Mukuru w'ibyo twizeera, <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />yari umwiringirwa ku Maana yamutooranyije nk'uko na Moose yari umwiringirwa mu nzu y'Imaana. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Nyamara Yesu akwiriye guhaabwa ikuzo kuruta Moose nk'uko umwubatsi abona icuubahiro kiruta ic'inzu ubwayo. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Kuko inzu yoose igira uwayubatse, ariko umwubatsi w'ibintu byose ni Imaana. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Moose yari umwiringirwa nk'umugaragu mu nzu y'Imaana yoose kugira ngo agaragaze ibyo Imaana yari kuzaavuga nyuma y'igihe. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Ariko Kristo we ni umwiringirwa nk'Umwana ushinzwe gutegeka inzu y' Imaana. Iyo nzu y'Imaana ni twe turamutse tugize ubutwari kandi tugakomerera mu byo twiringiye.<verse eid="HEB 3:6" /></para>
  <para style="s1">Uburuhuukiro bw'Abantu b'Imaana</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Nuuko reero nk'uko Umwuka Weera avuga,</para>
  <para style="q1" vid="HEB 3:7">“Nimwumva ijwi ry'Imaana uyu munsi,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />ntimwinangire imitima nk'uko baasogokuruza babigenjeje, bakangomera</para>
  <para style="q2" vid="HEB 3:8">ubwo bangeragezaga bari mu butaayu.<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />Baasogokuruza baarangerageje, ni ko Imaana ivuga,</para>
  <para style="q2" vid="HEB 3:9">nuubwo bari baaraboonye ibikorwa byanje kumara imyaka mirongo ine.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />Ni co caatumye ngirira uburaakari ab'ico gihe nkavuga nti,</para>
  <para style="q2" vid="HEB 3:10">‘Imitima yaabo ihora iyoba,</para>
  <para style="q2" vid="HEB 3:10">kandi ntibaraamenya imigenzereze yanje.’<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Nuuko mu buraakari bwanje ndiirahira nti,</para>
  <para style="q2" vid="HEB 3:11">‘Ntibazinjira mu buruhuukiro bwanje.’ ”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Nuuko reero bavandimwe, mwirinde kugira ngo hatagira umuntu n'umwe muri mwe ugira umutima mubi utiizeera, ukamuteera kwitandukanya n'Imaana nzima. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Ahuubwo mukomezanye buri munsi, igihe coose hakiri “uyu munsi” kugira ngo hatagira umuntu n'umwe muri mwe winangira umutima abiteewe n'uburiganya bw'icaaha. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Kuko twabaaye umwe na Kristo, niiba koko dukomerera mu byiringiro byacu bya mbere kugeza ku mperuuka.<verse eid="HEB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15" />Nk'uko ibyanditswe bivuga ngo:</para>
  <para style="q1" vid="HEB 3:15">“Nimwumva ijwi ry'Imaana uyu munsi,</para>
  <para style="q2" vid="HEB 3:15">ntimwinangire imitima nk'uko baasogokuruza baari bameze</para>
  <para style="q2" vid="HEB 3:15">igihe baagomeye Imaana.”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Noone se ubu ni ba nde bumviise ijwi ry'Imaana kandi bakarenga bakayigomera? Si abo boose baavuuye muri Igiputi bayobowe na Moose? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Ariko se ni ba nde Imaana yaraakariye kumara imyaka mirongo ine? Si abo baakoze ibyaha, imirambo yaabo igahera mu butaayu? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Kandi se ni ba nde Imaana yiirahiye ko batazinjira mu buruhuukiro bwayo, niiba atari abanze kuyumvira? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Noone reero tubona ko bataashoboye kwinjira muri bwo biteewe no kuteemera kwabo.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="s1">Uburuhuukiro Imaana Yaseezeranyije</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Nuuko reero, ubwo iseezerano ryo kwinjira mu buruhuukiro bw'Imaana rikiriho, tube maaso kugira ngo hatagira umuntu n'umwe muri mwe usangwa adashobora kurigeraho. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Koko naatwe Ubutumwa Bwiza bwatugezeho nk'uko na baasogokuruza baabwumviise, ariko nyamara ubutumwa bumviise ntaaco bwabamariye kuko bataabwakiiranye umutima wiizeeye hamwe n'abaabwumviise. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Noone reero twebwe abiizeeye Kristo tuzinjira muri ubwo buruhuukiro bwo Imaana yaduseezeranyije, nk'uko yavuze iti,</para>
  <para style="q1" vid="HEB 4:3">“Ndahiranye uburaakari nti,</para>
  <para style="q2" vid="HEB 4:3">‘Ntibazinjira mu buruhuukiro nari kuzaabaha,’ ”</para>
  <para style="m" vid="HEB 4:3">Ibyo Imaana yarabivuze nuubwo umurimo waayo wari wararangiye ikirema isi. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Kuko hari ibyanditswe byerekeye uwo munsi wa karindwi bivuga biti, “Imaana yaruhuutse imirimo yaayo yoose ku munsi wa karindwi.” <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Kandi nabwo ibyanditswe birongera biti, “Ntibazinjira mu buruhuukiro nari kuzaabaha.” <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />Nooneho reero ubwo uburuhuukiro busigaye bukinguuriwe bamwe kugira ngo babwinjiremo, kandi abaakeera bumviise Ubutumwa Bwiza bakaba bataarabwinjiyemo ku bwo kutumvira, <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Imaana yongera gushiraho undi munsi, ari wo “uyu munsi”, ivugira mu kanwa ka Dawudi hashize igihe kireekire, muri aya magambo iti,</para>
  <para style="q1" vid="HEB 4:7">“Uyu munsi, nimwumva ijwi ry'Imaana,</para>
  <para style="q2" vid="HEB 4:7">ntimwinangire imitima.”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Kuko iyo Yosuwa aba yarabaashije kubageza mu buruhuukiro, Imaana ntiyajaga kuvuga iby'undi munsi w'uburuhuukiro haanyuma. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Nuuko reero, Isaabato ari bwo buruhuukiro, iracaabiikiwe abantu b'Imaana. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Kuko abo binjira mu buruhuukiro bw'Imaana, ni abo baba baaruhuutse imirimo yaabo nk'uko Imaana yaruhuutse iyaayo. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Nuuko reero ni tugire umwete wo kwinjira muri ubwo buruhuukiro, kugira ngo hatagira umuntu ugwa akurikije iciitegererezo ca ba bandi co kutumvira.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Ni koko Ijambo ry'Imaana ni rizima kandi rifite imbaraga, rityaye kurusha inkoota ifite impande ebyiri. Rihinguranya mu muntu rikagera mu mahuuriro y'ubuzima n'umwuka, no ku y'ingingo n'umushokoora. Rishoboye kugenzuura ibyo umutima wiibwira n'ibyo ugambiiriye. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Kandi ntaacaaremwe gihishwe imbere y'Imaana, ahuubwo byose biratwikuruwe nk'ibyambaye ubusa imbere y'uwo tuzaatangaho umwanzuro w'ibyo twakoze.<verse eid="HEB 4:13" /></para>
  <para style="s1">Yesu Niwe Muheerezabitambo Mukuru Ukomeye</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Nuuko reero ubwo dufite Umuheerezabitambo Mukuru ukomeye wagiiye mu ijuru, ari we Yesu Umwana w'Imaana, dukomeze ibyo twizeera kandi twatura. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Kuko dufite Umuheerezabitambo Mukuru utananirwa kubabarana naatwe mu ntege nke zaacu, ndetse yageragejwe mu buryo bwose nkaatwe kandi we ari ntaacaaha yakoze. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Nuuko reero twegeere intebe y'ubuntu dushize amanga kugira ngo dushobore kwakiira imbabazi kandi tubone ubuntu bwo kudufasha mu gihe gikwiriye.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Umuheerezabitambo Mukuru weese atooranywa mu bantu, kandi agashirwaho guhagararira abantu imbere y'Imaana, umurimo we ukaba gutuura amatuuro no gutamba ibitambo by'ibyaha byabo. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Ubwo na we ari umunyantegenke muri byinshi, ashobora kwihangaanira abakora ibyaha ku bwo kudasobaanukirwa hamwe n'abaayobye. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Kandi ku bw'iyo mpamvu, na we agomba gutamba ibitambo by'ibyaha bye hamwe n'iby'abandi. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Ntaamuntu washobora kwiha ico cuubahiro co kuba Umuheerezabitambo Mukuru ahuubwo agihaabwa n'Imaana ari yo imuhamagaye nk'uko byagenze kuri Arooni.<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />Ni ko na Kristo atiihaaye ico cuubahiro co kuba Umuheerezabitambo Mukuru, ahuubwo yatooranyijwe n'Imaana yamubwiye iti,</para>
  <para style="q1" vid="HEB 5:5">“Uri Umwana wanje,</para>
  <para style="q2" vid="HEB 5:5">uyu munsi mbaaye So.”<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Kandi nk'uko yavuze n'ahandi iti,</para>
  <para style="q1" vid="HEB 5:6">“Uri Umuheerezabitambo Mukuru iteeka ryose</para>
  <para style="q2" vid="HEB 5:6">nka Melikisedeki.”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:36-46">Mat 26:36-46</ref>; <ref loc="MRK 14:32-42">Mar 14:32-42</ref>; <ref loc="LUK 22:39-46">Luk 22:39-46</ref>.</char>
    </note>Iminsi yoose Yesu yamaze ku isi yasengaga yinginga kandi afite ishavu n'amarira menshi, atakambira Imaana, yo ifite ubushobozi bwo kumukiza urupfu, maze iramwumva kuko yayiiyeguriye. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Nuubwo yari Umwana w'Imaana, imibabaro yanyuzemo yamwigiishije kumvira. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Kandi amaze gutunganywa rwose, yabaaye isooko y'agakiza k'iteeka ryose kagenewe abo boose bamwumvira, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />nuuko Imaana ni ko kumugira Umuheerezabitambo Mukuru wo mu buryo bwa Melikisedeki.<verse eid="HEB 5:10" /></para>
  <para style="s1">Kwirinda Gucoogora mu Kwizeera Kristo</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Kubyerekeye iby'Umuheerezabitambo Mukuru, dufite byinshi byo kuvuga bikomeye gusobaanura kubeera yuuko mutinda gusobaanukirwa. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" /><note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="1CO 3:2">1 Kor 3:2</ref>.</char></note>Kandi nuubwo mwari mukwiriye kuba muri abiigiisha, mukeneye umuntu wo kongera kubiigiisha ibyerekeye ingingo z'ibanze z'ubutumwa bw'Imaana. Mwifuuza amata atari ibyokurya bikomeye, <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />kuko umuntu weese ubeeshejweho n'amata aba akiri uruhinja, aba ataraasobaanukirwa gutandukanya ikibi n'iciiza. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Naho ibyokurya bikomeye ni iby'abantu bakuze, baamaze gutoozwa bakamenya gutandukanya ikibi n'iciiza.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Nuuko reero, mureke dukomeze guteera imbere mu nyigiisho zikwiriye abakuze kandi tureke guhora ku nyigiisho za mbere zeerekeye Kristo, ntidukwiriye kwirirwa twongera gusubiramo inyigiisho zeerekeye kwihana ibikorwa bibi no kwizeera Imaana, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />inyigiisho zeerekeye umubatizo no kurambikwaho ibiganza, kuzuuka kw'abaapfuuye n'urubanza rw'iteeka. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Kandi ni ko tugiiye kubigenza Imaana ibaaye ibitwemereye.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Kuko bidashoboka yuuko twakongera kugarura abo bantu ngo biihane, abaari baaramaze kumurikirwa n'umuco, bagasogongera ku mpaano iva mu ijuru kandi bagahaabwa n'Umwuka Weera, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />ndetse bakanasogongera no ku bwiza bw'ijambo ry'Imaana hamwe n'imbaraga z'igihe kizaaza, <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />haanyuma bagasubira inyuma. Bo ubwabo baba bongera gusubiza Umwana w'Imaana ku musaraba bakamukoza isoni kumugaragaro.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />Iyo ubutaka bunyoye amaazi haanyuma bukabyarira ababuhinga imbuto z'ingirakamaro, Imaana iba ibuhaaye umugisha. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Naho iyo bumezemo amahwa n'amatovu, ntaaco buba bukimaze. Buba bushigaje kuvumwa kandi amaheerezo yaabwo ni ugutwikwa.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Nyamara nshuti dukunda, nuubwo tuvuga dutyo, dufite ibyiringiro tudashidiikanya yuuko ibyanyu bimeze neeza kurusha ibi kuko mukora ibikwiranye n'agakiza. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Kuko Imaana ntiirenganya, ntiyiibagirwa imirimo yaanyu n'urukundo mwerekanye ku bwayo, mufasha abantu baayo na n'ubu mukaba mukibafasha. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Ico twifuuza ni ukugira ngo buri muntu weese akomeze kugira uwo mwete kugeza ku mperuuka kugira ngo ibyo mwiringiye bibaashe gusohora, <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />kugira ngo mutaba abanebwe, ahuubwo mube nk'uko abiizeera Imaana biihangaana nyuma bikabaheesha umurage w'ibyo Imaana yabaseezeranyije.<verse eid="HEB 6:12" /></para>
  <para style="s1">Impamo y'Iseezerano ry'Imaana</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Igihe Imaana yaseezeranyije Aburahamu iseezerano, yariirahiye ubwayo kuko itaari ifite uwundi uyisumba uwo yari kurahira, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />irahira iti, “Ni ukuri nzaaguha umugisha kandi nzaagwiza abazaagukomookaho.” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Kandi na ni ko byabaaye, Aburahamu yashikirijwe iseezerano ku bwo kwihangaana. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Ubusanzwe abantu barahira umuntu ubarusha gukomera kandi iyo ndahiro ikababeera icemezo co gukemura impaka ziri hagati yaabo. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Bityo reero, Imaana na yo yashaatse kurushaho kugaragariza abaragwa b'iseezerano ko imigambi yaayo ari impamo, ni co caatumye ahamya iseezerano akoreesheje indahiro, <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />kugira ngo mu bintu bibiri bidahinduka, byo Imaana idashobora kubeesha ngo yivuguruze, bidukomeze caane twebwe abamaze kubona ubuhungiro muri yo ngo tugere ku byiringiro tuzaahaabwa. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Ibyo byiringiro turabifite, ni byo nkingi y'ubugingo bwacu, ibyiringiro bihinguranya umwenda ukingiriza bikagera aheera caane <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />aho Yesu watubanjirije yinjiye amaze kuba Umuheerezabitambo Mukuru w'iteeka ryose mu buryo bwa Melikisedeki.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s1">Ubutambyi bwa Melikisedeki</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Melikisedeki uwo yari umwami w'i Salemu akaba n'umuheerezabitambo w'Imaana Isumbabyose. Ni we wahuuye na Aburahamu ubwo yatabaarukaga avuuye ku rugamba atsinze abaami bane n'ingabo zaabo nuuko amuha umugisha. <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />Kandi Aburahamu amuha kimwe ca cumi c'iminyago yatsindiye mu ntambara. Ica mbere izina Melikisedeki risobaanurwa ngo “Umwami Nyir'ubutungaane”, kandi ko yari umwami w' i Salemu, izina rye ryamenyeeshaga “Umwami uzana amahoro.” <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Nta byanditswe bivuga kuri se cangwa nyina wa Melikisedeki, habe no ku giseekuruza, cangwa no ku kuvuuka kwe cangwa iheerezo ry'ubugingo bwe. Agereranywa n'Umwana w'Imaana, ahora ari umuheerezabitambo iteeka ryose.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Nuuko namwe nimwitegereze uburyo uwo muntu akomeye. Na sogokuruza Aburahamu yamuhaaye kimwe ca cumi c'ibyo yari yaanyaze mu ntambara. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Kandi abaakomootse kuri Leevi ari bo baahaawe umurimo w'ubuheerezabitambo, bafite itegeko ryo gusorooza kimwe ca cumi kuva mu bantu, ni ukuvuga beene waabo nuubwo na bo boose baakomootse kuri Aburahamu. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Ariko Melikisedeki utaarakomootse ku rubyaro rwa Leevi, yasorooje kimwe ca cumi kuva kuri Aburahamu, amuha n'umugisha kandi ari we wari warahaawe amaseezerano. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Ntaawe ushidiikanya ko uworoheje ahaabwa umugisha n'ukomeye. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Byongeye kandi, abaheerezabitambo basorooza kimwe ca cumi ni abantu bapfa, ariko Melikisedeki we arabasumba kuko ibyanditswe bihamya ko ahoraho. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Kandi ni ukuvuga ngo igihe Aburahamu yatanze kimwe ca cumi, Leevi, wo urabyaro ruhaabwa kimwe ca cumi rukomookaho, na we ubwe yaragitanze, <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />kuko Leevi yari ataraavuuka akiri mu mubiri wa seekuruza Aburahamu igihe yahuuye na Melikisedeki.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Niiba gutunganywa kwaraazanywe n'ubuheerezabitambo bw'Abaleevi ari yo nkomooko y'amategeko yahaawe Abiisirayeli, ntaakundi kwifuuza ko haboneka undi muheerezabitambo wo mu murongo wa Melikisedeki atari uwo mu murongo wa Arooni. <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Kuko iyo habaayeho ihinduka mu buheerezabitambo, amategeko na yo aba akwiriye guhinduka. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Kandi Umwami waacu ari we uvugwaho ibi byose akomooka mu wundi muryango. Ntaawe muri uwo muryango wiigeze gukora umurimo w'ubuheerezabitambo. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Biraazwi neeza yuuko Umwami waacu yakomootse mu muryango wa Yuda kandi Moose ntiyiigeze avuga uyu muryango igihe yavugaga ku baheerezabitambo.<verse eid="HEB 7:14" /></para>
  <para style="s1">Undi Muheerezabitambo nka Melikisedeki</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />Ndetse birushaho kugaragara ubwo haabonetse undi Muheerezabitambo umeze nka Melikisedeki. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />Yagizwe umuheerezabitambo atari ku bw'amategeko n'amabwiriza y'abantu, ahuubwo ni ku bw'imbaraga z'ubugingo butagira iheerezo. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Kuko ibyanditswe bibihamya ngo, “Uri umuheerezabitambo iteeka ryose, mu murongo wa Melikisedeki.” <verse eid="HEB 7:17" /><verse number="18" style="v" sid="HEB 7:18" />Nuuko reero, itegeko rya mbere ryakuuweho ku bw'imbaraga nke zaaryo, nta n'umumaro ryari rifite, <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />kuko amategeko ataagize ico atungaanya ahuubwo twahaawe ibindi byiringiro byiza ari byo biduheesha kwegeera Imaana.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Ibi byahamijwe n'indahiro, kuko abandi baagizwe abaheerezabitambo baahaawe uwo murimo nta ndahiro bakoze, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />ariko Yesu we yabaaye umuheerezabitambo ku bw'indahiro ubwo Imaana yamubwiye ati,</para>
  <para style="q1" vid="HEB 7:21">“Uhoraho ararahiye</para>
  <para style="q2" vid="HEB 7:21">kandi ntaaziigera yiivuguruza,</para>
  <para style="q1" vid="HEB 7:21">‘Uri umuheerezabitambo iteeka ryose’.”<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />Kandi Yesu ni we uhamya neeza yuuko iryo seezerano ari ryiza.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Byongeye kandi, umubare w'abaheerezabitambo ba mbere wari mwinshi kuko baabujijwe n'urupfu gukomezamo imirimo yaabo, <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />ariko Yesu, ari we ufite ubuheerezabitambo budashira, azaakomezamo umurimo we iteeka ryose. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Ni co gituma igihe coose afite ubushobozi bwo gukiza abeegeera Imaana banyuze muri we kuko ahora abeereyeho kubavuganira ku Maana.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Kuko byari bikwiriye ko tugira umuheerezabitambo mukuru umeze atyo, weera, utagira inenge, udahumanyijwe, witandukanyije n'abanyabyaha kandi yahaawe icuubahiro gihebuuje mu ijuru. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Ntaabwo agomba kubanza yatamba ibitambo byo guhongerera ibyaha bye buri munsi nk'uko abandi baheerezabitambo babigenza ngo abone no guhongerera ibyaha by'abandi bantu. Ibi yabikoze rimwe kandi biba iby'igihe coose igihe yiitanzeho igitambo ubwe. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Kuko itegeko rya Moose ryatooranyaga abanyantege nke kuba ari bo baba abaheerezabitambo bakuru naho iseezerano ry'Imaana ryakozwe n'indahiro ari ryo ryaje nyuma y'amategeko, ryatooranyije Umwana w'Imaana washiriweho kuba intungaane iteeka ryose.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s1">Yesu Umuheerezabitambo Waacu Mukuru</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Ingingo nkuru mu byo tuvuga ni iyi, dufite Umuheerezabitambo Mukuru, wiicaye iburyo bw'Intebe y'Ubwami ikomeye yo mu ijuru. <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />N'Umuheereza Mukuru ukorera aheera caane kandi no mu ihema nyakuri iryo Nyagasani yashizeho atari undi muntu weese urishizeho.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Kuko Umuheerezabitambo Mukuru weese atooranyirizwa guheereza amatuuro n'ibitambo. Ni yo mpamvu, bikwiriye ko uyu Muheerezabitambo Mukuru na we agira ico yaatuura. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Iyo aza kuba ari ku isi, ntaabwo yari kuba Umuheerezabitambo na hato, kuko hari abaheerezabitambo bagenewe gutuura amatuuro bakurikije amategeko. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Imirimo bakora ni ikigereranyo kigaragaza ibyo mu ijuru. Igihe Moose yari agiiye kurema ihema Imaana yaramubwiye iti, “Mu byo uri bukore byose, ureebe ngo ukurikije iciitegererezo weeretswe ku musozi.” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Ariko Yesu ubu amaze guhaabwa ubuheereza buruta ubw'abandi baheerezabitambo, kuko ni we uduhuuza n'Imaana mu seezerano rihebuuje ryayo rishingiye ku maseezerano ahebuuje aruta aya keera.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Kuko iyo iseezerano rya mbere ritaaza kugira inenge, ntibyakabaaye ngombwa ko hashaakwa irindi rya kabiri. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Ariko Imaana igaya abantu baayo ibabwira iti,</para>
  <para style="q1" vid="HEB 8:8">“Dore iminsi igiiye kuuza, ni ko Uhoraho avuga,</para>
  <para style="q2" vid="HEB 8:8">ubwo nzaashiraho iseezerano risha n'inzu ya Isirayeli hamwe n'inzu ya Yuda.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />Ntirizaaba nk'iryo naseezeranye na ba seekuruza</para>
  <para style="q2" vid="HEB 8:9">umunsi nabafashe ukuboko nkabakuura mu gihugu ca Igiputi,</para>
  <para style="q1" vid="HEB 8:9">kuko ntibaagumye mu iseezerano ryanje</para>
  <para style="q2" vid="HEB 8:9">nuuko bigatuma ntabiitaho. Ni ko Uhoraho avuga.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Iri ni ryo seezerano nzaaseezerana n'inzu ya Isirayeli</para>
  <para style="q2" vid="HEB 8:10">nyuma y'iyo minsi, ni ko Uhoraho avuga.</para>
  <para style="q1" vid="HEB 8:10">Nzaashira amategeko yanje mu biteekerezo byabo,</para>
  <para style="q2" vid="HEB 8:10">kandi nyandike ku mitima yaabo,</para>
  <para style="q1" vid="HEB 8:10">kandi nzaaba Imaana yaabo</para>
  <para style="q2" vid="HEB 8:10">na bo bazaaba abantu banje.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Kandi ntibaziigiishanya</para>
  <para style="q2" vid="HEB 8:11">cangwa ngo babwirane bati,</para>
  <para style="q2" vid="HEB 8:11">‘Menya Uhoraho’</para>
  <para style="q1" vid="HEB 8:11">kuko boose bazaamenya,</para>
  <para style="q2" vid="HEB 8:11">uheereye ku woroheje muri bo ukageza ku ukomeye.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Nzaabababarira ibicumuro byabo,</para>
  <para style="q2" vid="HEB 8:12">ibyaha byabo sinzaabyibuka ukundi.”<verse eid="HEB 8:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 8:13" />Ubwo Uhoraho yavuze iseezerano risha, ni ukuvuga ngo, iryambere ntirigikoreeshwa. Kandi ikitagikoreeshwa kiba gishaaje, kikaba ari ico kuvaho burundu.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s1">Kuramya Imaana ku Isi no mu Ijuru</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Iseezerano rya mbere na ryo ryari rifite amabwiriza yo kuramya kandi n'aheera ho baasengera hano ku isi. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Kuko ihema ryaruubatswe, iryo hanze ryari ryitwa Aheera. Ni mwo haari igitereko c'itaara, imeeza hamwe n'imigaati yatuuwe Imaana. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Inyuma y'umwenda ukingiriza, haari ihema ryitwa Aheera caane. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />Muri ryo haabagamo urutambiro rw'izaahabu rwo gucaaniraho imibavu hamwe n'isanduku y'iseezerano isiizwe izaahabu impande zoose. Iyo sanduku yabagamo inkongooro irimo manu, inkoni ya Arooni yari yarashibutseho amababi kandi n'ibisate by'amabuye bibiri byanditsweho amategeko y'iseezerano. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Heejuru y'iyo sanduku haariho amashusho y'abakerubi b'icuubahiro. Amababa yaabo yatwikiiraga intebe y'imbabazi. Icakora iki si co gihe co kuvuga ibi byose mu magambo arambuuye.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Ibyo iyo bimaze guteguurwa, abaheerezabitambo buri gihe baja mu ihema rya mbere gukora imihango yaabo, <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />ariko Umuheerezabitambo Mukuru wenyine ni we uja mu ihema rya kabiri kandi na we ajayo rimwe gusa mu mwaka. Kandi ntiyinjiragamo atajaanye amaraso yo kwitambira igitambo c'ibyaha bye hamwe no gutambira ibyaha by'abantu baakoze batabigennye. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Nooneho reero, Umwuka Weera atugaragariza neeza ko inzira ija Aheera h'Imaana itaraakingurwa igihe ihema ryo hanze rigihagaze. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Iki ni igishushaanyo kigaragaza ibihe turimo ubu. Ceerekana ko amatuuro n'ibitambo by'inyamaaswa bidashobora gutungaanya umutima w'umuntu uramya Imaana, <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />kuko bishingiye ku byokurya, n'ibyo kunywa kandi hamwe no ku mihango y'uburyo bwinshi yo guhumaanura. Ibi byose ni amategeko yo ku mubiri yashizweho kugeza igihe Imaana izaashiriraho uburyo busha.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Ariko Kristo amaze kuuza nk'Umuheerezabitambo Mukuru w'ibyiza bimaze kuuza, ihema ryo akoreramo riratangaaje kandi ntaanenge rifite. Ni ihema ritaakozwe n'intoki z'abantu, ni ukuvuga ngo si iryo muri ibi byaremwe byo mu isi. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Ubwo Kristo yinjiye mu ihema kandi akinjira Aheera caane rimwe rizima, ntiyajaanye amaraso y'ihene n'ibimasa ngo ayatambe mo nk'ibitambo, ahuubwo yajaanye amaraso ye bwite ngo abone kuducungura iteeka ryose. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Niiba amaraso y'ihene nay'ibimasa hamwe no kuminjagirwaho igitaazi c'inyana byashobora kweza umuntu wahumanyijwe kugira ngo umubiri we uhumaanuke, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />mbese amaraso ya Kristo yo azaatweza bingana bite? Ku bw'Umwuka w'iteeka wiitanze nk'igitambo kitagira inenge ku Maana, akeeza imitimanaama yaacu kuva mu byaha kugira ngo dukorere Imaana nzima!<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />No ku bw'iyo mpamvu, Kristo ni we muhuuza w'iseezerano risha, kugira ngo abo baahamagawe babone guhaabwa umurage w'iteeka ryose waseezeranyijwe kuko haabaayeho urupfu rucungura abaacumuye mu gihe c'iseezerano rya mbere.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />Iyo habaayeho kuraga, hakwiriye kugaragazwa ko uwaraze uwo murage yapfuuye, <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />kuko umurage ntaaco uba uvuze igihe nyakuwuraga akiri muzima. Ugira amakuru iyo nyakuraga amaze gupfa. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Ni co caatumye n'iseezerano rya mbere rigira amakuru kuko haari hamaze kumenwa amaraso. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Igihe Moose yari amaze kubwira Abiisirayeli amategeko yoose nk'uko ari, yafashe amaraso y'ibimasa n'ay'ihene ayavanganya n'amaazi nuuko ayaminjagira ku gitabo c'amategeko hamwe no ku bantu boose akoreesheje ubwoya bw'intaama butukura hamwe n'urubingo. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Aravuga ati, “Aya ni yo maraso y'iseezerano ayo Imaana yabategetse kuubahiriza.” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Ni co kimwe, Moose yarongeye aminjagira amaraso kuri rya Hema Ryera hamwe no ku bintu byose bikoreeshwa mu kuramya. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Ni koko ukurikije amategeko, haafi ibintu byose byezwa n'amaraso kandi ibyaha bibabarirwa ari uko amaraso abanje kumenwa.<verse eid="HEB 9:22" /></para>
  <para style="s1">Kristo ni we Gitambo Gikuuraho Ibyaha</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Ibyo bintu bivuzweho kandi ari byo bishushaanya ibyo mu ijuru nyaabyo, byari bikwiriye kwezwa muri ubwo buryo. Naho ibintu byo mu ijuru ubwabyo bikwiriye kwezwa n'ibitambo biruta ibyo. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Kuko Kristo atinjiye Aheera haakozwe n'amaboko y'abantu, ari ho hagaragazaga Aheera nyaaho ho mu ijuru. Ahuubwo yinjiye mu ijuru ubwaryo aho ubu aduhagarariye imbere y'Imaana. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Kandi ntiyinjiyemo ngo yiituure nk'igitambo inshuro nyinshi nk'uko umuheerezabitambo Mukuru yinjiraga Aheera Caane buri mwaka ajanye amaraso atari aye. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Kuko iyo biiza kuba bityo, aba yari akwiriye kubabazwa inshuro nyinshi uheereye ku kuremwa kw'isi. Ahuubwo ubu yabonetse rimwe rizima kumperuuka y'ibihe kugira ngo akuureho icaaha mu buryo bwo kwitamba. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Kandi nk'uko biri ko umuntu yagenewe gupfa rimwe haanyuma agaciirwa urubanza, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />ni na ko Kristo, amaze gutambwa rimwe ngo akuureho ibyaha bya benshi azaaboneka ubwa kabiri, ataazanywe no gukuuraho ibyaha ahuubwo azanywe no gukiza abo bamutegereje n'ubwuzu.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Ubwo amategeko ari igishushaanyo gusa kigaragaza ibyiza bigiiye kuuza akaba ateerekana ukuri kw'ibintu nyaabyo, ni na ko atabaasha gutungaanya umuntu weegeera Imaana amutungaanyisha ibitambo bya buri gihe bitambwa buri mwaka. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Kuko mu by'ukuri iyo abantu baramya Imaana baba baaratungaanyijwe bakava mu byaha, ntibaakabaaye bumva bashinjwa n'icaaha ukundi, kandi ntaakundi gutamba ibitambo kwakongeye kubaho. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Ariko ibi bitambo bya buri mwaka biba ari ibyo kwibutsa abantu ibyaha byabo. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Kuko ntibishoboka yuuko amaraso y'ibimasa n'ay'ihene yaakuuraho ibyaha.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Ni yo mpamvu igihe Kristo yari agiiye kuuza mu isi yabwiye Imaana ati,</para>
  <para style="q1" vid="HEB 10:5">“Ntiwanyuzwe n'ibitambo hamwe n'amatuuro,</para>
  <para style="q2" vid="HEB 10:5">ariko wanteguuriye umubiri wo gutamba.<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Ntuushiimiishwa n'inyamaaswa zootswa kugicaaniro</para>
  <para style="q2" vid="HEB 10:6">cangwa ibitambo bikuuraho ibyaha.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Nuuko Kristo aravuga ati, ‘Dore ndaaje Maana,</para>
  <para style="q2" vid="HEB 10:7">nzanywe no gukora ugushaaka kwawe,</para>
  <para style="q2" vid="HEB 10:7">nk'uko byanyanditsweho mu gitabo c'amategeko.’ ”<verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />Igihe Kristo yavuze ati, “Ntiwanyuzwe cangwa ngo wishiimire ibitambo n'amatuuro, ibitambo byokejwe n'ibitambo byo gukuuraho ibyaha” ibi bitambwa nk'uko amategeko abitegeka, <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />yarongeye aravuga ati, “Dore ndaaje Maana, nzanywe no gukora ugushaaka kwawe.” Ni ko Imaana yakuuyeho ibitambo bya keera ibisimbuuza igitambo ca Kristo. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Kuko ari ubushaake bw'Imaana kuba twareejejwe tubiheeshejwe n'uko umubiri wa Yesu Kristo watambwe rimwe kandi bikaba iby'iteeka ryose.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Buri muheerezabitambo ahora umunsi ku wundi akora uwo muhango wo gutamba ibitambo bidahinduka inshuro nyinshi ariko bitabaasha gukuuraho ibyaha. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Ariko igihe Kristo yari amaze gutamba igitambo kimwe c'iteeka ryose co gukuuraho ibyaha, yiicara iburyo bw'Imaana, <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />kandi kuva ico gihe aracaategereje kugeza ubwo Imaana izaashira abanzi be munsi y'ibirenge bye. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Kandi ku bw'igitambo kimwe, Kristo yeejeje abo baatunganyijwe kuva mu byaha iteeka ryose.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />Kandi koko Umwuka Weera ni ko aduhamiriza, abanza kuvuga ati,<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“Iri ni ryo seezerano nzaagirana na bo</para>
  <para style="q2" vid="HEB 10:16">nyuma y'iyo minsi, ni ko Uhoraho avuga.</para>
  <para style="q1" vid="HEB 10:16">Nzaashira amategeko yanje mu mitima yaabo,</para>
  <para style="q2" vid="HEB 10:16">kandi nzaayandika mu biteekerezo byabo,”<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Arongera aravuga ati, “Sinzongera kwibuka ibyaha byabo kandi n'ibikorwa byabo bibi sinzaabyibuka ukundi.” <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />Bityo reero ahari ukubabarirwa ibyaha ntihaba hakiriho kongera gutamba ibitambo by'ibyaha.<verse eid="HEB 10:18" /></para>
  <para style="s1">Guhamagarirwa Kwihangaana</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Nuuko reero beene daata ubu dufite umudendeezo wo kwinjira Aheera caane ku bw'amaraso ya Yesu. <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />Yatwugururiye inzira nsha kandi y'ubugingo inyura mu mwenda ukingirije Aheera, ari wo mubiri we, <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />kandi dufite Umuheerezabitambo ukomeye ushinzwe Inzu y'Imaana. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />Nuuko reero mureke twegeere Imaana dufite umutima w'ukuri no kwizeera guhamye, n'imitima yaacu isukuuwe itagira ico idushinja kandi n'imibiri yaacu na yo yuhagiwe n'amaazi asukuuwe. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Dukomeze kwatura ibyo twiringiye tutanyeganyega kuko uwaduseezeranyije ari umwizeerwa. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Kandi tuzirikane bagenzi baacu, duteerane umwete wo gukundana no kugira ibikorwa byiza. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Twe kwirengagiza guteeranira hamwe nk'uko bamwe baabigize akamenyeero ahuubwo turusheho gukomezanya nkuuko mubona umunsi w'Umwami wegeereje.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Kuko niiba dukomeza gukora ibyaha kandi twaramaze kumenya ukuri, ntaagitambo co gukuuraho ibyaha kiba gisigaye, <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />ahuubwo ikiba gisigaye n'ugutegerezanya ubwoba urubanza rugiiye kuuza hamwe n'umuriro ukaze uzaatsemba abahakanya Imaana. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Umuntu weese wiicaga itegeko rya Moose baaramwicaga ntakumugirira imbabazi igihe yabaga ashinjwe n'abahamya babiri cangwa batatu. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Noone se niiba byari bimeze bityo, bizaagendekera bite abo baasuuzuguye Umwana w'Imaana, bagateesha agaciiro amaraso y'iseezerano ry'Imaana yabatunganyije kuva mu byaha kandi bagatuka Umwuka utanga ubuntu! Mbese muteekereza ko igihano bazaahaabwa kitazaaba gikabije kuruta iby'abandi? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Kuko tuuzi uwavuze ati, “Guhoora ni ukwanje, ni nje uziituura.” Kandi arongera aravuga ati, “Uhoraho ni we uzaaciira urubanza abantu be.” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Biteeye ubwoba kugwa mu maboko y'Imaana nzima.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Mwibuke uko byari bibamereye mu gihe caashize. Muri iyo minsi ubwo umuco w'Imaana wari umaze kubaviira, mwarababajwe ariko murihangaana ntimwemera gutsindwa n'urwo rugamba. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Rimwe na rimwe mwaratukwaga kumugaragaro kandi mugatootezwa, ubundi mwahoraga mwiteguuye kwiyunga kuri abo baatootezwaga. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Mwasangiraga umubabaro n'imbohe kandi n'igihe ibyo mwari mufite byose byanyazwe, mwihangaaniye igihombo ndetse murabyishiimira kuko mwari muuzi yuuko mufite ubundi butunzi buruta ubwo kandi buzaahoraho iteeka ryose. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Nuuko reero ntimugacoogore kuvuga mushize amanga kuko ari byo bizaabaheesha ingororano ikomeye. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Mukwiriye kwihangaana kugira ngo nimumara gukora ubushaake bw'Imaana, muzaahaabwe ibyo mwaseezeranyijwe. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Kuko ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="HEB 10:37">“Hasigaye akaanya gato,</para>
  <para style="q2" vid="HEB 10:37">uwo ugiiye kuuza agasohora</para>
  <para style="q2" vid="HEB 10:37">kandi ntaabwo azaatinda.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />Umukiraanutsi azaabeeshwaho no kwizeera,</para>
  <para style="q2" vid="HEB 10:38">ariko naasubira inyuma,</para>
  <para style="q2" vid="HEB 10:38">ntaabwo nzamwishiimira.”<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Twe ntituri mu basubira inyuma bikabateera kurimbuka, ahuubwo turi muri abo bafite kwizeera kandi baakijijwe.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s1">Kwizeera</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Kwizeera ni ukumenya neeza tudashidiikanya ko tuzaabona ibyo twiringiye kandi ni uguhamirizwa ko ibyo tutari twabona ari iby'ukuri. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Ni koko, kwizeera ni ko kwatumye, baasogokuruza bashimwa n'Imaana.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:3 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:3">Yoh 1:3</ref>.</char>
    </note>Ni ukwizeera gutuma dusobaanukirwa yuuko isi yaremwe n'ijambo ry'Imaana, bityo reero ibigaragara bikaba byarakozwe mu bintu bitagaragara.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Kwizeera ni ko kwatumye Abeeli atambira Imaana igitambo gishimiishije kuruta ica Kayini. Ku bw'uko kwizeera, Imaana yamwemeye nk'intungaane na yo ubwayo ishiima amatuuro ye. Abeeli n'ubwo yapfuuye ariko ku bwo kwizeera kwe, na n'ubu aracumviikana.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Kwizeera ni ko kwatumye Henoki ajanwa mu ijuru atanyuze mu rupfu kandi ntaamuntu wongeye kumubona kuko Imaana yari yamuzaamuuye. Ibyanditswe bivuga ko mbere yo kuzaamuurwa kwa Henoki, yari yaneejeeje Imaana. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Kandi ntaawaneezeeza Imaana adafite kwizeera, kuko umuntu weese weegeera Imaana akwiriye kwemera ko iriho kandi ko ihemba abayishaaka.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Kwizeera ni ko kwatumye Nowa yiita ku mabwiriza y'Imaana ku byerekeye ibyari bigiiye kuba nuubwo we yari ataraabibona. Nowa yuubahirije Imaana nuuko yuubaka inkuge yo we hamwe n'umuryango we baarokokeyemo. Ku bw'ibyo, isi yaciiriweho urubanza maze Nowa ahaabwa umurage wo kuba intungaane abiheeshejwe no kwizeera.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Kwizeera ni ko kwatumye Aburahamu yuubaha igihe Imaana yamuhamagaye kuja mu mwanya wo yari yaraseezeranyije kuzaamuha nk'umugabane. Nuuko Aburahamu aragenda ataazi iyo aja. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Ku bwo kwizeera, yatuuye mu gihugu Imaana yari yaramuseezeranyije nk'umusuhuuke. Yatuuye mu mahema nk'uko Isaaka na Yaakobo na bo baabigenjeje, ari na bo basangiye uwo mugabane w'iseezerano. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Kuko Aburahamu yari ategereje kuzaatuura mu tawuni nkuru yo Imaana yashushaanyije kandi yiiyubakiye, itawuni nkuru ifite imfatiro zikomeye.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Kwizeera ni ko kwatumye Aburahamu yitwa umubyeyi n'ubwo yari ashaaje kandi na Saara n'ubwo yari ingumba, yararenze igihe co kubyara. Yiizeeye Imaana, isohoza iseezerano ryayo. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />N'ubwo Aburahamu yasaga nk'umukambwe wenda gupfa, muri we haakomootse urubyaro rwinshi rungana n'inyenyeeri zo mu kireere kandi rutabarika nk'umuseenyi wo ku nkengeero y'inyanja.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />Abo boose baapfuuye bagifite kwizeera ntibaari baagahaawe ibyo Imaana yari yarabaseezeranyije ariko baabireebeye kure kandi barabyakiira ndetse bahamya ko ari abanyamahanga kandi abagenzi kuri iyi si. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Abavuga batyo, baba bagaragaza neeza ko bashaaka igihugu caabo bwite. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Ntibiigeze baguma guteekereza igihugu baari baaravuuyemo. Iyo baguma kugiteekereza, baba baraboonye uburyo bwo gusubirayo. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Ahuubwo biifuuzaga igihugu ciiza kiruta ico baari bavuuyemo ari co mu ijuru. No ku bw'ico, ntaabwo Imaana ikorwa n'isoni zo kwitwa Imaana yaabo kuko ni yo yabateguuriye itawuni bazaatuuramo.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Igihe Aburahamu yashizwe ku kigeragezo, kwizeera yari afite byatumye yeemera gutamba Isaaka. Nuubwo yari yarahaawe iseezerano, yari yiiteguuye gutamba umwana we w'ikinege <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />uwo Imaana yari yaramubwiye iti, “Kuri Isaaka ni ho urubyaro rwawe ruzaakwitirirwa.” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Aburahamu yiizeeraga ko Imaana ishobora kuzuura uwapfuuye ikamugira muzima. Kandi koko ubigereranyije, Isaaka yagarurijwe Aburahamu nk'uzuutse.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Kwizeera ni ko kwatumye Isaaka aha Yaakobo na Esaawu umugisha w'ibihe bizaaza.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Kwizeera ni ko kwatumye Yaakobo ataraapfa aha buri muhungu wa Yozefu umugisha. Yabikoze yishingikirije ku nkoni ye kandi aramya Imaana.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Kwizeera ni ko kwatumye Yozefu avuga ibyo kuva muri Igiputi kw'Abisirayeli igihe yari agiiye gupfa kandi atanga n'amabwiriza yeerekeye uko bazaagenza umubiri we.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Kwizeera ni ko kwatumye ababyeyi ba Moose bamuhisha kumara ameezi atatu amaze kuvuuka. Baboonye ko umwana ari mwiza ntibatiinya kurenga ku tegeko ry'umwami.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Kwizeera ni ko kwatumye Moose yanga kwitwa umuhungu w'umukoobwa wa Faraawo igihe yari amaze gukura. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Yashimye kubabazwa hamwe n'abantu b'Imaana kuruta kuneezeerwa mu gukora icaaha by'igihe gito. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Yiiyumviishije ko kubabazwa by'agashinyaguro kubwa Kristo byari bifite agaciiro kuruta ubutunzi bwose bw'Abiigiputi kuko we yatumbiiraga ibihembo by'ibihe bizaaza.<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />Kwizeera ni ko kwatumye Moose ava muri Igiputi adatiinya uburaakari bw'umwami. Kuko yiihangaanye nk'aho areeba Imaana itagaragara bituma adasubira inyuma. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Kwizeera ni ko kwatumye Moose ashiraho kwizihiza Kunyurwaho kandi agategeka yuuko habaho kuminjagira amaraso ku nzuugi kugira ngo malayika ushinzwe kurimbura ataaza kwica abaana b'imfura bo mu b'Isirayeli.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />Kwizeera ni ko kwatumye Abiisirayeli bashobora kwambuka Inyanja Itukura nk'abanyura ku butaka bwumuutse naho Abiigiputi bagerageje kuhanyura, bararohama.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />Kwizeera ni ko kwatumye ibisiika by'i Yeriko biriduka ubwo Abiisirayeli babizengurutse kumara iminsi irindwi. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Kwizeera ni ko kwatumye Rahabu wari malaaya adapfiira mu bantu batuubahaga Imaana kuko yaakiiriye neeza intasi zo muri Isirayeli.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />Mbese ikindi co naavuga ni iki? Ntaagihe gihaagije naabona co kuvuga ibya Gideyoni, Baraki, Samusoni, Yefuta, Dawudi, Samweli hamwe n'iby'abahanuuzi. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Ku bwo kwizeera, baarwanye intambara z'ibihugu kandi baratsinda. Baakoze ibitungaanye, baazanira abantu ubutabeera kandi bahaabwa ibyo Imaana yari yarabaseezeranyije. Baazibiranyije iminwa y'intare, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />bazimya imiriro iteeye ubwoba, ntibiicwa n'inkoota. Baari bafite intege nke ariko babona imbaraga, baba intwari mu ntambara kandi batsinda ingabo z'abanyamahanga. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Ku bwo kwizeera, hari abagore baakiriye beene waabo baari baarapfuuye bakazuurwa bakongera guhaabwa ubugingo.</para>
  <para style="p" vid="HEB 11:35">Abandi banze kuba ab'umudendeezo baapfuuye batootezwa kugira ngo bazuurirwe kubona ubugingo burushaho kuba bwiza. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Bamwe barashinyagurirwa kandi barakubitwa naho abandi baaraboshwe bajanwa mu nzu y'imbohe. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Bamwe baateewe amabuye kugeza ku gupfa, baciibwamo kabiri, biiciishijwe inkoota. Bajanwa bambitswe impu z'intaama n'ihene, ntaaco bafite, bababazwa kandi batootezwa. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Ntibyari bikwiye ko baba mu isi! Baazereeraga nk'impunzi mu butayu no mu misozi bagatuura mu buvumo no mu myobo iri mu butaka.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Nuubwo aba boose Imaana yashimye kwizeera kwabo, baapfuuye bataraabona ibyo yabaseezeranyije, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />kuko Imaana yari yaragambiiriye integuura iruta iyo twibwira. Umugambi waayo kwari ukugira ngo tuzaatungaanyirizwe hamwe na bo.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s1">Imaana Daata</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Naatwe reero, ubwo twitooroowe n'igicu c'abahamya bakomeye, mureke dushire iruhande ikituremeerereye coose hamwe n'icaaha coose gihora kitwiziringaho, kandi nimureke dusiganwe mu marushanwa twateganyirijwe dufite kwihangaana. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />Dukomeze guhanga amaaso yaacu kuri Yesu uwo kwizeera kwacu gushingiyeho uheereye kuntangiro ukageza ku iheerezo. Yiihangaaniye umusaraba ku bw'umuneezeero yari abiikiwe, ntiyiita ku isoni byari kumuteera igihe yabambwaga ku musaraba, noone ubu yiicaye iburyo bw'Intebe y'Ubwami y'Imaana.<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />Muteekereze ibyo yanyuzemo, uko yababajwe, yangwa n'abanyabyaha kugira ngo mudaciika intege kandi mukananirwa. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />Igihe murwanya icaaha, nti muba muraagera aho kwicwa. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Mbese mwibagiwe amagambo yo gukomeza ayo Imaana ibabwira nk'abaana baayo iti,</para>
  <para style="q1" vid="HEB 12:5">“Mwana wanje, wumvirize igihe Uhoraho agucaaha,</para>
  <para style="q2" vid="HEB 12:5">kandi ntuuciike intege igihe Uhoraho aguhana.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Kuko Uhoraho acaaha umuntu weese akunda,</para>
  <para style="q2" vid="HEB 12:6">kandi agahana umuntu weese wo yeemera nk'umwana we.”<verse eid="HEB 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 12:7" />Mwihangaanire kubabazwa ko mucamo kuko ari igihano kiva kuri Daata. Iyo mubabazwa, byerekana yuuko Imaana irikubafata nk'abaana baayo. Mbese hari umwana wiigeze kubaho ntaahanwe na se? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Iyo udahanwa n'Imaana nk'uko abandi baana bagenzwa, kimenyeesha yuuko uba utari umwana waayo nyakuri, ahuubwo uba uri ikibyarirano. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Ikindi kandi, niiba ba daata baatubyaye mu buryo bw'umubiri, baduhana kandi tukabuubaha, ntibikwiriye yuuko turushaho kuganduukira Imaana yatubyaye mu mwuka tukabaho? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Kuko ba daata baatubyaye mu mubiri baaduhannye kumara akaanya gato babona yuuko ari byo bikwiriye kuri bo, ariko Imaana iduhana ku bw'ubwiza bwacu kugira ngo dusangire ku kwera kwayo. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Igihe duhanwe, muri ako kaanya bigaragara ko tubabaye mumwanya wo kwishiima, ariko haanyuma abatoojwe muri ubwo buryo, bikabaviiramo umusaaruuro w'amahoro n'ubutungaane.<verse eid="HEB 12:11" /></para>
  <para style="s1">Amabwiriza hamwe no Kwamagirira</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Nuuko reero nimushire heejuru amaboko yaanyu atentebutse kandi mwongere imbaraga amavi yaanyu aciitse intege. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Nimukomeze ku gendera mu nzira igororotse kugira ngo ibirenge byanyu byaremaye bitongera gucumbagira ahuubwo bikire.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Mugerageze kubaana n'abantu boose amahoro kandi no kwezwa kuko ntaamuntu uteejejwe uziigera areeba Uhoraho. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Mwirinde kugira ngo hatagira usubira inyuma akava mu buntu bw'Imaana. Ntihakagire umuntu uhinduka nk'igiti gikura kikeera imbuto zishaariira, kigateera akaaga ku bw'ubusabwe bwaco. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Ntihagire umuntu n'umwe uba umusambanyi cangwa ngo yange kuubaha Imaana nka Esawu waguraanye uburenganzira bwe bwo kuba umwana w'imfura isahaane imwe gusa y'ibyokurya. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Murabiizi ko haanyuma, igihe yashaatse kwakiira umugisha kuva kuri se, ntiyeemerewe kuko ntiyari agishoboye guhindura ibyakozwe nuubwo yawushaatse arira.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Mwe reero ntimuri nk'Abiisirayeli ba keera ngo mube mwegeereye wa musozi ubaasha gukorwaho n'intoki. Aho ni ho baabonaga umuriro ugurumana n'umwijima w'icuraburindi kandi bakumva n'umuyaga w'ishuheeri, <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />n'impanda zivuga hamwe n'ijwi ry'amagambo ateera abaaryumviise gusaba kutongera kumva irindi jambo, <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />kuko ntibaagashoboye kwihangaanira amategeko avuga ati, “Nihagira ufata kuri uyu musozi weese aziciishwa amabuye, naaho yaaba inyamaaswa, muzayigenze mutyo.” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Uwo mwanya wari uteeye ubwoba ku buryo na Moose yavuze ati, “Ndigutitira kandi mfite ubwoba!”<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Ahuubwo muuje ku Musozi wa Siyoni, itawuni nkuru y'Imaana nzima ari yo Yerusaalemu yo mu ijuru, hamwe n'iteeraniro ry'abaamalayika batabarika bari mu birori. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />Muuje mu iteeraniro ry'umuneezeero ry'abaana b'imfura b'Imaana, abo amazina yaabo yanditswe mu ijuru. Muuje ku Maana, umucaamanza w'abantu boose kandi n'imyuka y'abakiraanutsi batungaanyijwe rwose. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Muuje kuri Yesu, umuhuuza w'Imaana n'abaagengwa b'iseezerano risha, mwegeereye amaraso yaminjagiwe aduseezeranya ibintu byiza byinshi kuruta amaraso ya Abeeli.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Nuuko reero mube maaso kandi ntimwicire amatwi uvuga. Kuko niiba abo banze kumva uwatanze ubutumwa bw'Imaana ku isi bataaraciikanyije, twebweho tuzaarokoka dute nitwanga kumvira uvugira mu ijuru. <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Ico gihe ijwi ryayo ryatitije isi, ariko ubu yaseezeranyije ngo, “Ngiiye kongera kunyeganyeza isi, ariko si yo yoonyine gusa ahuubwo nzaanyeganyeza n'ijuru.” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Ayo magambo ngo “Ngiiye kongera,” yeerekana yuuko ibyaremwe bigiiye gutitizwa bigakuurwaho kugira ngo ibyo bitabaasha kunyeganyezwa bishobore kugumaho.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />Noone reero, ubwo turi kwakiira Ubwami butabaasha kunyeganyezwa, mureke duheereze Imaana ishimwe. Tuyituure ineeza kandi tuyiramye uko ibikwiriye, tuyuubaha kandi tuyitiinya, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />kuko Imaana yaacu ni nk'umuriro utwika.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s1">Ubuheereza Bushiimiisha Imaana</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Mukomeze gukundana urukundo rwa kivandimwe nk'abakristo. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Ntimwirengagize gucumbikira abashitsi, kuko mu gukora mutyo bamwe baakiira abaamalayika batabiizi. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Mwibuke abari mu bihome nk'aho namwe mwakabaaye muri na bo. Mwibuke n'abari gutootezwa nk'aho namwe mwakabaaye muri gutootezwa.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Abantu boose buubahe ugushingiranwa kandi uburiri bw'abashaakanye bwe kwanduzwa kuko Imaana izaaciira urubanza abasambanyi n'abaheeheesi.<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />Murinde ubuzima bwanyu mwe gukunda amashilingi kandi munyurwe n'ibyo mufite kuko Imaana yavuze iti, “Sinzaabasiga kandi sinzabateererana” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />Ni co gituma tuvuga dushizamanga tuti,</para>
  <para style="q1" vid="HEB 13:6">“Uhoraho ni we mufasha wanje,</para>
  <para style="q2" vid="HEB 13:6">Sinzaatiinya.</para>
  <para style="q1" vid="HEB 13:6">Mbese ni nde wagira ico antwara?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Mwibuke abayobozi baanyu ba keera baababwirije ijambo ry'Imaana. Muzirikane uko babaayeho nuuko mukurikize urugero rwo kwizeera kwabo. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Yesu Kristo uko yari ari ejo n'uyu munsi ni ko ari kandi ni ko azaahora iteeka ryose. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Ntimugateeshwe inzira n'inyigiisho z'inzaaduka z'uburyo bwinshi ngo zibateeshe kuyoboka inzira nziiza. Kuko ni byiza ko umutima usubizwamo intege n'ubuntu bw'Imaana kuruta kuubahiriza amategeko yeerekeye ibyokurya kuko n'abo bayuubahiriza ntaaco yiigeze abafasha.<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />Dufite itambiro ryo abashinzwe kureeberera ihema badafite uburenganzira bwo kurya ku bitambirwa ho. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Kuko imibiri y'izo nyamaswa zo amaraso yaazo yazanwaga aheera azanywe n'Umuheerezabitambo Mukuru nk'ibitambo by'ibyaha, bitwikirwa hanze y'inkambi. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />No ku bw'iyo mpamvu, na Yesu yapfiiriye hanze y'irembo ry'itawuni nkuru kugira ngo ashobore kweza ibyaha by'abantu akoreesheje amaraso ye bwite. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Nuuko reero dusohoke tuje hanze y'inkambi dusangire na we agashinyaguro. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Kuko nta tawuni nkuru yo dufite izaabaho igihe coose hano ku isi ariko dutegereje itawuni nkuru iteguuwe kuzaaza. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />Nooneho reero dukomeze gutambira Imaana igitambo c'ishimwe muri Kristo, ari co mbuto z'iminwa yatura ko Kristo ari Umwami. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Ntimwirengagize gukora ibyiza kandi no gusangira ibyo mufite kuko ibitambo nk'ibyo bishiimiisha Imaana.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Mwubahe abayobozi baanyu kandi mubumvire kuko barinda imitima yaanyu ubudasinziira kandi bazaatanga umwanzuro w'uwo murimo bashinzwe. Nimubuubaha, bazaakora umurimo waabo baneezeerewe ariko nimutabikora, uwo murimo bazaawukora bababaye kandi bitume hatagira ico bibamarira.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Mukomeze kudusengera. Twizeera tudashidiikanya yuuko dufite umutimanaama waacu utaduciira urubanza kuko twifuuza guhora dukora ibikwiriye igihe coose. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Kandi ndabiihanangiriza ngo murusheho kunsengera kugira ngo Imaana ingarure iwaanyu vuba.<verse eid="HEB 13:19" /></para>
  <para style="s1">Isengeesho ryo Gusooza</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Nuuko Imaana y'amahoro yo yazuuye Umwami waacu Yesu, umushumba w'intaama ukomeye, ikamuvaana mu baapfuuye ku bw'amaraso y'iseezerano ry'iteeka ryose, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />ibagwizemo ibyiza byose kugira ngo mushobore gukora ugushaaka kw'Imaana kandi igume gukorera muri twe ibiyishiimiisha inyuriye muri Yesu Kristo. Icuubahiro kibe ica Kristo iteeka ryose. Amiina.<verse eid="HEB 13:21" /></para>
  <para style="s1">Amagambo ya Nyuma</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Bavandimwe ndabinginga kugira ngo mwihangaanire ijambo ryanje ryo kubahuguura kuko mbandikiye muri make. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Ndashaaka yuuko mumenya ko mwene daata Timoteeyo yafunguuwe kandi nangeraho vuba, tuzaazana kubasuura.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Muramutse abayobozi boose hamwe n'abeera boose. Abo mu Italiya bari kubaramutsa.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Ubuntu bw'Imaana bubaane namwe mwese.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>