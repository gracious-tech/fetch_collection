<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">2TES - Rufumbira New Testament</book>
  <para style="h">2ABATEESALONIKE</para>
  <para style="toc3">2Tes</para>
  <para style="toc2">2 ABATEESALONIKE</para>
  <para style="toc1">Urwandiko rwa kabiri Intumwa Pawulo yandikiye ABATEESALONIKE</para>
  <para style="mt2">Urwandiko rwa kabiri Intumwa Pawulo yandikiye</para>
  <para style="mt1">ABATEESALONIKE</para>
  <para style="imt">INYANZURO</para>
  <para style="im">Abakristo b'itoorero ry'i Teesalonike bakomeje kuba mu rujijo biteewe no gutegereza kugaruka kwa Kristo. <char style="bk">Urwandiko rwa kabiri Intumwa Pawulo yandikiye Abateesalonike</char> rufashe ku kwemera ko umunsi wo kugaruka k'Umwami waacu wageze. Pawulo yasobaanuye kuri ico giteekerezo yeerekana ko Kristo atazaagaruka ububi n'ubugome bitaraarenga urugero buyobowe n'iyobera ryiswe <char style="it">Umugomeramaana</char> 2:3, ari we uzaahakanya Kristo.</para>
  <para style="ip">Intumwa Pawulo yihanangiririza abasoma ibye kuguma mu kwizeera bashikamye nuubwo baaba bari mu kaaga cangwa mu kubabazwa, bakwiriye gukomeza gukora imirimo yo kubabeeshaho nk'uko Pawulo n'abakozi bagenzi be baagenzaga kandi no kwihangaanira mu gukora ibyiza.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro <char style="ior"><ref loc="2TH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">Gusingiza no Gushiima <char style="ior"><ref loc="2TH 1:3-12">1:3-12</ref></char></para>
  <para style="io1">Amabwiriza afashe ku kugaruka kwa Kristo <char style="ior"><ref loc="2TH 2:1-17">2:1-17</ref></char></para>
  <para style="io1">Inyigiisho ifashe ku myifatire ya Gikristo <char style="ior"><ref loc="2TH 3:1-15">3:1-15</ref></char></para>
  <para style="io1">Umusoozo <char style="ior"><ref loc="2TH 3:16-18">3:16-18</ref> </char></para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:1">Iby 17:1</ref>.</char>
    </note>Njeewe Pawulo, na Silaasi na Timoteeyo, turabandikiye mwebwe ab'itoorero ry'i Teesalonike biizeera Imaana Daata n'Umwami Yesu Kristo.<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />Turabiifuuriza ubuntu n'amahoro biva ku Maana Daata no ku Mwami Yesu Kristo.<verse eid="2TH 1:2" /></para>
  <para style="s1">Gushiima</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />Bavandimwe, birakwiriye ko dushiima Imaana ibihe byose ku bwanyu, ku bwo kwizeera kwanyu kwiyongeera, n'urukundo mufitanye rukarushaho kugwira. <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />Ni yo mpamvu twe ubwacu tubiiraatana mwe abiizeera bari mu matoorero y'Imaana kubeera ubudacoogora no kwizeera kwanyu n'ubwo mutootezwa mugahuura no kubabazwa k'uburyo bwose ariko mukabyihangaanira.<verse eid="2TH 1:4" /></para>
  <para style="s1">Urubanza Ruzaaba Igihe Kristo azaaza</para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />Ibi byose byerekana ko Imaana iciira abantu urubanza rutabeera, kandi gutootezwa kwanyu kwagenewe kwerekana ko mukwiriye Ubwami bw'Imaana kandi ari na bwo mubabarizwa. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />Ni koko birakwiriye yuuko Imaana yituura amakuba ababababaza, <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />kandi mwebwe abababazwa, Imaana izaabaha kuruhuukana naatwe ubwo Umwami Yesu azaagaragazwa ava mu ijuru azanye n'abaamalayika be bakomeye <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />n'umuriro ugurumana, ahane abanze kwemera Imaana kandi ntibumvire Ubutumwa Bwiza bw'Umwami waacu Yesu. <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />Abo bazaahaabwa igihano co kurimbuka iteeka ryose. Baziirukanwa imbere y'Imaana no mu bwiza bw'imbaraga ze, <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />igihe Yesu azaaza guhaabwa ikuzo n'abantu be kuri uwo munsi, kandi ashiimagizwe mu bazaaba baaramwemeye boose. Namwe muzaaba muri abo kuko mwemeye ubuhamya bwacu.<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />Ni co gituma tubasengera iteeka kugira ngo Imaana yaacu ibahe kuba mu buzima bukwiriye guhamagarwa kwayo, kandi ku bw'ububaasha bwayo ibahe gukora ibyiza byose mwiyemeje gukora, n'imirimo yaanyu yoose iva mu kwizeera, <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />kugira ngo muhimbaaze izina ry'Umwami Yesu, kandi namwe muhimbaazwe nawe, mubikeesha ubuntu bw'Imaana yaacu n'ubw'Umwami Yesu Kristo.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s1">Ibyerekeye Umugomeramaana</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="1TH 4:15-17">1Tes 4:15-17</ref>.</char>
    </note>Bavandimwe, ibyerekeye kugaruka k'Umwami waacu Yesu Kristo, n'uko tuzaateerana nawe, turabasaba <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />kugira ngo mutajijwa cangwa ngo mugire ubwoba mubiteewe na bamwe bavuga ko umunsi wo kugaruka kwa Kristo wageze, bakurikije ko baba baarabihishuuriwe n'Umwuka, inyigiisho, ubuhanuuzi cangwa inzandiko bateekereza ko ari twe twazaanditse. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />Ntihakagire umuntu weese ubabeesha mu buryo bwose, kuko uwo munsi utazaagera abantu batari baagomera Imaana bikabije n'umugomeramaana akagaragara ari we wagenewe kurimbuka. <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />Uwo azaarwanya kandi yiishire heejuru y'iciitwa imaana coose cangwa igisengwa, kugira ngo yiicare mu Nzu y'Imaana maze yiigaragaze ko ari we Maana.<verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />Mbese ntimwibuka ko ibi nabibabwiye nkiri kumwe namwe? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />Kandi dore muuzi ikimuzitiye ubu, kuko atazaahishuurwa igihe ce kitaraagera. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />Kuko amayobera y'ubugome yatangiye gukora, ariko ntaazaahishuurwa keretse uyabuza ubu akuuweho, <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />ni bwo wa Mugomeramaana azaagaragazwa. Nuuko Umwami Yesu amurimbuze umwuka uva mukanwa ke, no kuboneka kw'ikuzo rye. <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" /><note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="MAT 24:24">Mat 24:24</ref>.</char></note>Kuuza k'umugomeramaana kuzaarangwa n'imirimo ya Sataani, igaragarira mu bubaasha bwose, n'ibimenyeetso n'ibitangaaza by'ibinyoma, <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />kandi azaabeesha mu buryo bwose abo baagenewe kurimbuka, kuko banze kwakiira ubutumwa bw'ukuri bwo kubarokora. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />No ku bw'iyo mpamvu Imaana mu mbaraga zaayo izaabateera ubuyobe bukomeye nuuko beemere ibinyoma, <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />kugira ngo abo boose banze kwemera ukuri, bakiishiimira gukiraanirwa, baciirwe urubanza.<verse eid="2TH 2:12" /></para>
  <para style="s1">Guhamagarirwa Agakiza</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />Bavandimwe kandi bakundwa b'Umwami waacu, dukwiriye guhora dushiima Imaana ku bwanyu, kuko Imaana yabatooranyije uheereye mbere na mbere kugira ngo muzaabone agakiza gaheeshwa no kwezwa kuva ku Mwuka no kwizeera ukuri. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />Ni co gituma yarabahamagaye ikoreesheje Ubutumwa Bwiza twamamaza kugira ngo muzaasangire ikuzo n'Umwami Yesu Kristo. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />Nuuko reero bavandimwe, muhagarare mushikamye mu byo mwizeera kandi mukomeze inyigiisho z'uruheererekane twabiigiishije, ari mu magambo cangwa mu rwandiko twabandikiye.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />Umwami waacu Yesu Kristo ubwe, hamwe n'Imaana Daata wa twese, wadukunze maze ku bw'ubuntu atugirira akaduha guhuumurizwa kuzaahoraho n'ibyiringiro byiza, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />babahe ihuumure kandi no gukomera mu mirimo myiza yoose mukora n'amagambo muvuga.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s1">Mudusengere</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />Ibisigaye bavandimwe mudusabire kugira ngo ijambo rya Nyagasani ryamamare hoose vuba kandi ryakiirwe nk'uko riri muri mwe. <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />Musenge kugira ngo Imaana idukize abantu b'abagome n'abagiranaabi kuko ntaabwo ariko buri muntu weese afite kwizeera.<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />Ariko Nyagasani ntaahemuka, azaakomeza abarinde umubi. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />Kandi dufite ibyiringiro muri Nyagasani tudashidiikanya yuuko ibyo tubategeka mubikora kandi ko muzaanabikomeza.<verse eid="2TH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5" />Nyagasani ayobore imitima yaanyu kumenya urukundo rw'Imaana no kwihangaana gutangwa na Kristo.<verse eid="2TH 3:5" /></para>
  <para style="s1">Inshingano yo Gukora</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />Bavandimwe, turabategeka mu izina ry'Umwami Yesu Kristo kwirinda umwizeera weese wanga gukora kandi udakurikiza inyigiisho twabahaaye. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />Muuzi neeza ubwanyu ukuntu mukwiriye kutwigaana, kuko tutiigeze tuba inkorabusa ubwo twari namwe. <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />Ntitwigeze kurya ibyokurya by'umuntu tutabyishuriye, twakoze buri gihe kugira ngo hatagira n'umwe muri mwe turusha. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />Si ukuvuga ko tutaari tubifitiye uburenganzira, ahuubwo kwari ukugira ngo tubabeere urugero kugira ngo mudukurikize. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />Ubwo twari tukiri kumwe namwe twarabategetse tuti, “Umuntu weese udashaaka gukora ntaakarye.”<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />Twumviise yuuko muri mwe harimo abanebwe batagira ico bakora ahuubwo bakiivanga mubitabafasheho. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />Abameze batyo tubategetse kandi tubasabye mu izina ry'Umwami Yesu Kristo ngo baje bakorana ituuze, batungwe n'ibyo baaruhiye ubwabo.<verse eid="2TH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13" />Namwe bavandimwe ntimugacoogore gukora neeza. <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />Kandi nihagira umuntu utumvira ibyo tuvuze muri uru rwandiko, mu mwirinde ntimugafatanye na we, kugira ngo amware. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />Icakora ntimukamufate nk'umwanzi waanyu, ahuubwo mumugiire inaama nk'umwizeera mugenzi waanyu.<verse eid="2TH 3:15" /></para>
  <para style="s1">Guseezera</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />Nuuko reero Umwami w'amahoro ubwe aje abaha amahoro igihe coose, muri byose. Nyagasani abaane namwe mwese.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />Njeewe Pawulo iyi ni yo ndamutso yanje kandi nanditse n'ukuboko kwanje, ni co kimenyeetso mu nzandiko zanje zoose, uku ni ko nandika.<verse eid="2TH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18" />Ubuntu bw'Umwami Yesu Kristo bubaane namwe mwese.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>