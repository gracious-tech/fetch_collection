<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Rufumbira New Testament</book>
  <para style="h">1 PEETERO</para>
  <para style="toc3">1Pet</para>
  <para style="toc2">PEETERO</para>
  <para style="toc1">Urwandiko rwa mbere rwanditswe na Intumwa PEETERO</para>
  <para style="mt2">Urwandiko rwa mbere rwanditswe n'Intumwa</para>
  <para style="mt1">1 PEETERO</para>
  <para style="imt">INYANZURO</para>
  <para style="im">
    <char style="bk">Urwandiko rwa mbere rwanditswe n'Intumwa Peetero </char> rwandikiwe abakristo kandi muri uru rwandiko biiswe <char style="it">Abantu Imaana yatooranyije,</char> baari baarataataaniye mu bice byose by'amajaaruguru ya Asiya ntooya. Ikigendererwa gikuru muri uru rwandiko kwari ugukomeza abasomyi barwo baatootezwaga kandi bakababazwa ku bwo kwizeera kwabo. Umwanditsi yandikira abasomyi aya magambo abakomeza, abiibutsa Inkuru Nziiza ya Kristo Yesu, uwo gupfa kwe, kuzuuka kwe hamwe n'iseezerano ryo kugaruka kwe ari byo byiringiro byabo. Muri ibyo reero, bagomba kwemera no kwihangaanira kubabazwa, baazi neeza yuuko ari ukugeregezwa ko kwizeera kwabo gushitse kandi ko bazaabihemberwa ku <char style="it">munsi wo Yesu azaagaragara.</char> 1:7.</para>
  <para style="ip">Byongeye ku magambo ye yo gukomeza abakristo mu gihe baari mu kaaga, umwanditsi ashiishikariza abasomyi b'uru rwandiko kugira imibeereho ikwiriye abakristo.</para>
  <para style="iot">Ibirimo</para>
  <para style="io1">Inyanzuro <char style="ior"><ref loc="1PE 1:1-2">1:1-2</ref></char></para>
  <para style="io1">Kwiyibutsa iby'Agakiza k'Imaana <char style="ior"><ref loc="1PE 1:3-12">1:3-12</ref></char></para>
  <para style="io1">Gushiishikariza abantu kuba abeera mu mibeereho yaabo <char style="ior"><ref loc="1PE 1:13">1:13</ref>; <ref loc="1PE 2:10">2:10</ref></char></para>
  <para style="io1">Inshingano z'umukristo mu gihe co kubabazwa <char style="ior"><ref loc="1PE 2:11-4:19">2:11—4:19</ref></char></para>
  <para style="io1">Kwiciisha bugufi n'ubuheereza bw'umukristo <char style="ior"><ref loc="1PE 5:1-11">5:1-11</ref></char></para>
  <para style="io1">Umusoozo <char style="ior"><ref loc="1PE 5:12-14">5:12-14</ref></char></para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="s1">Indamutso</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />Njeewe Peetero, intumwa ya Yesu Kristo,</para>
  <para style="p" vid="1PE 1:1">ndabandikiye mwebwe abo Imaana yatooranyije, bari mu buhungiro baataataaniye mu bice bya Ponto, Galatiya, Kapadokiya, Asiya hamwe na Bituniya. <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />Imaana Daata yabatooranyije nk'uko yari yarabiteguuye kandi mwezwa n'Umwuka Weera kugira ngo mwumvire Yesu Kristo kandi mwezwe n'amaraso ye.</para>
  <para style="p" vid="1PE 1:2">Ubuntu n'amahoro bigwire muri mwe.<verse eid="1PE 1:2" /></para>
  <para style="s1">Ibyiringiro Bizima</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />Nihasingizwe Imaana, ari we Se w'Umwami waacu Yesu Kristo! Ku bw'imbabazi zaayo nyinshi, yaduhaaye ubugingo busha ubwo yazuuye Kristo Yesu mu baapfuuye. Ubu nibwo butwuzuzamo ibyiringiro bizima, <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />kugira ngo tuzaabone imigisha idashobora kwangirika, kwandura cangwa gucucuka, iyo mwabiikiwe mu ijuru. <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />Kwizeera Imaana kwanyu gutuma murindwa n'ububaasha bwayo kugeza ubwo muzaabona agakiza kaateguuwe kuzaahishuurwa mu gihe c'imperuuka.<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />Nimwishiime ku bw'ibyo reero, n'ubwo byaba ngombwa ko ubu mubabazwa n'ibibagerageza umwanya muto. <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />Ibyo bigeragezo bigamije guhamya ko kwizeera kwanyu ari uk'ukuri. Ni izaahabu yangirika ikebereeshwa umuriro, ni na ko kwizeera kwanyu gusumbya izaahabu agaciiro kugomba kugeragezwa kugira ngo kurame. Nuuko muzaahaabwa ishimwe n'ikuzo, n'icuubahiro igihe Yesu Kristo azaagaragazwa. <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />Kristo we muramukunda n'ubwo mutaraamubona, kandi n'ubwo mutaamubona ubu, muramwizeera kandi mufite ibyishiimo bitarondooreka, <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />kuko muba mwakiira ibihembo byo kwizeera kwanyu, ari ko gakiza k'ubugingo bwanyu.<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />Ibyerekeye ako gakiza, ni byo abahanuuzi baagerageje gukurikirana no gucondooza maze bahanuura ibyerekeye ubuntu Imaana yari kuzaabagirira. <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />Baagerageje gucondooza ngo bamenye igihe bizaabeera n'uko bizaaba bimeze<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">Bimwe mu byanditswe byera bivuga ngo, baagerageje gucondooza ngo bamenye uwo muntu uwariwe cangwa igihe azaazira.</char></note> igihe Umwuka wa Kristo uri muri bo yabeeretse abahamiriza mbere y'igihe ababwira ibyo kubabazwa kwa Kristo n'ikuzo rye rihebuuje azaahaabwa nyuma yaho. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />Imaana yahishuuriye abo bahanuuzi yuuko batiikorera ubwabo ahuubwo ko ari mwe bakorera. Ibyo ni byo mumaze kubwirwa n'abaababwirije Inkuru nziiza bayobowe n'Umwuka Weera uva mu ijuru. Ibi ni byo abaamalayika na bo biifuuza kumenya.<verse eid="1PE 1:12" /></para>
  <para style="s1">Guhamagarirwa kuba Intungaane mu Mibeereho</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />Nuuko reero ni mwiteguure, kandi mwirinde, mushire ibyiringiro byanyu ku migisha Yesu Kristo azaabaha igihe azaagaragazwa. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />Nimube nk'abaana bumvira, kandi mureke gukurikiza irari mwari mufite keera mukiri mu bujiji. <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />Ahuubwo nk'uko uwabahamagaye ari uweera, namwe ubwanyu mube abeera mu migenzereze yaanyu yoose. <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />Kuko ibyanditswe bivuga biti, “Nimube abeera, kuko ndi uweera.”<verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />Ubwo mwiyambaza Imaana muyita So, ari we uciira abantu boose urubanza atarobaanura ahuubwo agendera kumikorere yaabo, muje mumutiinya mu minsi musigaranye hano ku isi. <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />Muuzi yuuko ibyo mwacungujwe ngo muve mu ngeso mbi zaanyu mwarazwe na ba sogokuruza baanyu atari ibintu bita agaciiro nk'ifeeza cangwa izaahabu, <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />ahuubwo mwacungujwe amaraso ya Kristo y'igiciiro cinshi, nk'ay'umwana w'intaama utagira inenge cangwa ubwandu. <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />Imaana yari yaratooranyije Kristo isi itaraaremwa, ariko iza kumugaragaza muri ibi bihe bya nyuma ku bwanyu. <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />Kristo ni we utuma mwemera Imaana yamuzuuye mu baapfuuye kandi imuha ikuzo kugira ngo kwizeera kwanyu n'ibyiringiro byanyu bishingire ku Maana.<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />Noone reero ubwo mwejejwe mu mitima yaanyu ku bwo kumvira ukuri kugira ngo mugire urukundo nyaarwo rwa kivandimwe, nimukundane caane mubikuuye ku mutima. <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />Kuko mu ijambo ry'Imaana rizima kandi rihoraho iteeka, mwavuutse bundi busha mutaabyawe n'imbuto ibora, ahuubwo mubyawe n'imbuto ihoraho iteeka. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />Kandi byanditswe ngo,</para>
  <para style="q1" vid="1PE 1:24">“Abari mu mubiri boose bameze nk'ibyatsi</para>
  <para style="q2" vid="1PE 1:24">kandi ikuzo ryabo rikaba nk'iry'ibimori by'ibyatsi.</para>
  <para style="q1" vid="1PE 1:24">Ibyatsi biraraba,</para>
  <para style="q2" vid="1PE 1:24">n'ibimori bigahunguka,<verse eid="1PE 1:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25" />ariko ijambo ry'Uhoraho rizaahoraho iteeka.”</para>
  <para style="p" vid="1PE 1:25">Iri jambo reero ni ryo Nkuru Nziiza mwamenyeeshejwe.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s1">Ibuye Rizima n'Abantu Imaana Yatooranyije</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />Nuuko reero nimwikuureho ikibi coose, mwekongera kubeesha cangwa ngo mugire uburyarya cangwa ishari no gutukana. <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />Mumere nk'abaana bakimara kuvuuka, muje muhora mwifuuza amata meeza y'Umwuka ari ryo jambo ry'Imaana, kugira ngo atume mukurira mu gakiza <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />niiba koko mwarasogongeyeho mukumva ubwo bwiza bwa Nyagasani.<verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />Nimumuuzeho, ni we buye rizima ryanzwe n'abantu ariko rigatooranywa n'Imaana nk'irifite agaciiro gakomeye mu maaso yaayo. <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />Nimuuze nk'amabuye mazima maze mukoreeshwe mu kuubaka inzu y'Umwuka, kugira ngo mube ubwoko bw'abatambyi beera, batamba ibitambo Imaana ishiima muri Kristo Yesu bayobowe n'Umwuka. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />Nk'uko ibyanditswe bivuga biti,</para>
  <para style="q1" vid="1PE 2:6">“Dore nshize muri Siyoni ibuye<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">Iryo buye ni Yesu Kristo</char></note> natooranyije,</para>
  <para style="q2" vid="1PE 2:6">ngo ribabeere iryo gukomeza imfuruka, ry'agaciiro kenshi,</para>
  <para style="q2" vid="1PE 2:6">Kandi umwizeera weese ntaabwo azaakozwa isoni.”<verse eid="1PE 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1PE 2:7" />Mwebwe abeemeye Kristo, muzi yuuko ari uw'agaciiro kenshi, naho abo bateemere bizaababeera nk'uko byanditswe ngo,</para>
  <para style="q1" vid="1PE 2:7">“Ibuye abuubatsi banze</para>
  <para style="q2" vid="1PE 2:7">ni ryo ryabaaye iry'akamaro gakomeye,”<verse eid="1PE 2:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8" />kandi ngo,</para>
  <para style="q1" vid="1PE 2:8">“Iryo ni ryo buye rizaasiitaaza abantu,</para>
  <para style="q2" vid="1PE 2:8">n'urutare ruzaabaguusha.”</para>
  <para style="m" vid="1PE 2:8">Basiitaazwa n'uko banze kumva ijambo rye nk'uko baari baarabigenewe.<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:9 </char>
      <char style="xt" closed="false">
        <ref loc="TIT 2:14">Tito 2:14</ref>.</char>
    </note>Ariko mwebweho muri ubwoko bwatooranyijwe. Muri abatambyi b'Umwami, kandi ishanga ryera, kugira ngo mwamamaze ibikorwa bitangaaje by'uwabahamagaye kuva mu mwijima mukagera mu muco w'agatangaza.<verse eid="1PE 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1PE 2:10" />Mbere ntimwari ubwoko bw'Imaana,</para>
  <para style="q2" vid="1PE 2:10">ariko ubu muri ubwoko bwayo,</para>
  <para style="q1" vid="1PE 2:10">Mbere ntimwari mwakagiriwe impuhwe,</para>
  <para style="q2" vid="1PE 2:10">ariko ubu mwarazigiriwe.<verse eid="1PE 2:10" /></para>
  <para style="s1">Imyifatire Ikwiriye Abagaragu b'Imaana</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />Bakundwa, ndabihanangiriza, nk'abanyamahanga kandi abagenzi kuri iyi si, kugira ngo mwirinde irari muteerwa n'umubiri rigahora rirwanya ubugingo. <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />Mugire imyifatire myiza mu banyamahanga, kugira ngo n'ubwo babasebya nk'aho muri inkozi z'ibibi, babone imirimo yaanyu myiza nuuko bahe Imaana ikuzo igihe izaazira guca urubanza.<verse eid="1PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />Kubwo kuubaha Nyagasani, muje mwumvira ubutegetsi bwose bwashizweho n'abantu, yaba umwami nyir'igihugu, <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />cangwa abatware bategeka na we, bo atuma guhana abakora ibidashitse no guhemba abakora ibishitse. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />Kuko ni bwo bushaake bw'Imaana kugira ngo mu gukora ibyiza mucecekeeshe ubujiji bw'abapfaapfa. <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />Mwe nk'abagaragu b'Imaana, nimubeho nk'abantu bafite umudendeezo, ariko ntimuhindure uwo mudendeezo waanyu urwitwazo rwo gukora ibibi. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />Nimwubahe abantu boose, mukunde umuryango w'abizeera, mwubahe Imaana kandi muhe umwami icuubahiro.<verse eid="1PE 2:17" /></para>
  <para style="s1">Gukurikiza Urugero rwa Kristo mu Mibabaro</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />Bagaragu, nimwumvire ba shoobuja kandi mubuubahe mubikuuye ku mutima, kandi atari abeeza n'ababagirira ineeza gusa ahuubwo n'abo babafata naabi. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />Imaana izaabibashiimira nimwihangaanira imibabaro no kubabazwa ku bwayo. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />Niiba mwihangaanira gukubitwa babaryoza gukora ibibi, muzaabibonamo nyungu ki? Ariko nimwihangaanira kubabazwa mukora ibishitse muzaashimwa n'Imaana. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />Kandi ni co mwahamagariwe, kuko Kristo yababajwe ku bwanyu, abasigira urugero kugira ngo mugere ibirenge byanyu mu bye. <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />Ntaacaaha yakoze, kandi ntiyiigeze avuga ibinyoma. <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />Ubwo yatukwaga, ntaawe yiigeze asubiza naabi, kandi ubwo yababazwaga, ntaawe yiigeze akangiisha, ahuubwo yiiragije Imaana, ari yo mucaamanza utabeera. <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />We ubwe yiikoreye ibyaha byacu mu mubiri we abibambanwa ku musaraba kugira ngo tuve mu byaha tubeho mu butungaane. Ibikomere bye ni byo byabakijije. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />Kuko mwari mwarazimiye nk'intaama, ariko ubu mugarukiye umushumba kandi umurinzi w'ubugingo bwanyu.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s1">Imibaanire y'Abaashaakanye</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:1 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:22">Efe 5:22</ref>; <ref loc="COL 3:18">Kol 3:18</ref>.</char>
    </note>Nuuko reero ni co kimwe namwe bagore, muje mwumvira abagabo baanyu, kugira ngo n'ubwo bamwe muri bo baaba batiizeera ijambo ry'Imaana, babaashe guhindurwa ari nta co babwiwe, ahuubwo babiteewe n'imigenzereze myiza y'abagore baabo, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />baboonye imyifatire yaanyu itungaanye hamwe n'uko mwiyubaha. <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" /><note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="1TI 2:9">1 Tim 2:9</ref>.</char></note>Umurimbo waanyu weekuba uw'inyuma ngo musibe imisatsi yaanyu, no kwambara imitaako y'izaahabu cangwa imyenda y'akarusho. <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />Ahuubwo umurimbo waanyu ube uwo mu mutima, ari wo murimbo ugaragaza ubwiza buhoraho, ubugwaneeza n'ubucureera ufite agaciiro kenshi imbere y'Imaana. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />Uku ni ko byahoze na keera. Abagore b'intungaane biiringiraga Imaana, bakiirimbiisha kumvira abagabo baabo. <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />Na Saara yuubahaga Aburahamu akamwita umutware we. Namwe muba mubaaye abakoobwa be igihe mukora neeza mudatiinya ikibakanga icaari co coose.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:25">Efe 5:25</ref>; <ref loc="COL 3:19">Kol 3:19</ref>.</char>
    </note>Ni co kimwe namwe bagabo, mwite ku bagore baanyu mu gihe muri kumwe mu buzima bwanyu, mubuubaha kuko ari igitsina gifite intege nke, kandi na bo ni abaragwa b'impaano nziiza y'ubugingo buhoraho. Mukore ibyo kugira ngo hatagira igitangiira amasengeesho yaanyu.<verse eid="1PE 3:7" /></para>
  <para style="s1">Kubabazwa ku bwo Gukora Ibyiza</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />Ahasigaye, ni muhuuze imitima, mugirirane impuhwe, mukundane, mugire umutima wiiyoroheje kandi mwiciishe bugufi mu biteekerezo. <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />Ntimukiituure inaabi mwagiriwe cangwa ngo musubize ababatuka, ahuubwo mwifuurize imigisha ababagenza batyo. Kuko iki ni co mwahamagariwe, kugira ngo muragwe umugisha. <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />Nk'uko ibyanditswe bivuga biti,</para>
  <para style="q1" vid="1PE 3:10">“Ushaaka ubugingo bwiza</para>
  <para style="q2" vid="1PE 3:10">no kubona igihe ciiza,</para>
  <para style="q1" vid="1PE 3:10">ni arinde ururimi rwe rutavuga ikibi</para>
  <para style="q2" vid="1PE 3:10">kandi arinde n'iminwa ye kugira ngo itavuga ibinyoma.<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />Ni ahinduke ave mu byaha akore ibyiza.</para>
  <para style="q2" vid="1PE 3:11">Ni ashaakiishe amahoro kandi ayaharanire.<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />Kuko Uhoraho ahoza ijiisho rye kubakiraanutsi,</para>
  <para style="q2" vid="1PE 3:12">kandi yumva amasengeesho yaabo.</para>
  <para style="q1" vid="1PE 3:12">Ariko areeba igitsuuri inkozi z'ibibi.”<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />Mbese ubu ni nde uzaabagirira naabi nimuba mufite umwete wo gukora ibyiza? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" /><note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 5:10">Mat 5:10</ref>.</char></note>Ariko nuubwo mwababazwa ku bwo gukora ibishitse, mwabona umugisha. Ntimugatiinye ibyo babakangiisha, kandi ntimugahagarike imitima. <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />Nimwubahe Kristo mu mitima yaanyu ababeere Umwami. Muhore mwiteguuye gusubiza umuntu weese usaba ibisobaanuro by'ibyiringiro mufite, <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />kandi mubikorane kwiciisha bugufi no kuubaha. Mugire umutima ukeeye, kugira ngo nibabasebya, abo babatuka babaryoza imyifatire yaanyu myiza muri Kristo bazaakorwe n'isoni. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />Kuko icaaruta n'ukubabazwa ku bwo gukora ibyiza, niiba uko kubabazwa ari ubushaake bw'Imaana, kuruta kubabazwa ku bwo gukora ibibi. <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />Kuko Kristo na we yababajwe<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">Bimwe mu byanditswe bya keera bikoresha </char><char style="it">Kristo yapfuuye</char> </note> rimwe ku bw'ibyaha bya boose, we yari intungaane apfiira abanyabyaha, kugira ngo abahuuze n'Imaana. Yiishwe mu buryo bw'umubiri, ariko ahindurwa muzima mu mwuka, <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />nuuko aja kubwiriza imyuka yari imbohe. <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />Iyi yari ya myuka y'abo batumviye Imaana ubwo yayiihangaaniraga mu minsi yo Nowa yuubakaga ubwato bunini. Abantu bake bagera ku munaane nibo baarokowe n'amaazi. <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />Kandi ayo maazi ni ikimenyeetso c'umubatizo weerekana ko mukijijwe. Si ugukurwaho umwanda ku mubiri, ahuubwo n'iseezeerano uba ukoreye Imaana n'umutima ukeeye. Uwo mubatizo ni wo ubakiza ku bw'izuuka rya Kristo Yesu, <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />wazaamuutse akaja mu ijuru kandi akaba yiicaye iburyo bw'Imaana. Ni we urigutegeka abaamalayika n'abafite ubushobozi n'imbaraga mu ijuru.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s1">Ubuzima Busha</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />Nooneho reero ubwo Kristo yababajwe mu mubiri, namwe mugomba kwikomereza kuri ico giteekerezo kuko umuntu weese ubabazwa mu mubiri aba atandukanye n'icaaha. <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />Uheereye ubu reero mugomba kumara iminsi mushigaje muri ubu buzima mudategekwa n'irari ry'umubiri ahuubwo mukurikiza ibyo Imaana ishaaka. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />Mumaze igihe gihaagije mukora ibyo abataazi Imaana bakunda gukora, no kugira ingeso mbi zoose, n'irari, ubusinzi, kwineezeeza mubyo kunywa n'ubuheeheesi, hamwe n'imihango igayitse yo gusenga ibigirwamaana. <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />Noone ubu abo mwabikoranaga batangazwa no kubona mutagifatanya na bo mu ngeso mbi zikabije, bigatuma babasebya. <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />Nyamara bazaatanga umwanzuro imbere y'Imaana, yo yiiteguuye guciira urubanza abazima n'abaapfuuye. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />Ni yo mpamvu abaapfuuye na bo baabwirijwe ubwo Butumwa Bwiza, kugira ngo n'ubwo baaciiriwe urubanza bakiri mu mubiri nka buri umwe, ni babaho mu buryo bw'Umwuka, babeho nk'Imaana.<verse eid="1PE 4:6" /></para>
  <para style="s1">Gukoreesha Neeza Impaano Imaana Itanga</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />Iheerezo rya byose riri haafi. Nuuko reero mwifate kandi mube maaso kugira ngo mushobore gusenga neeza. <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />Ikiruta byose, mukundane urukundo rudashira, kuko urukundo rutwikiira ibyaha byinshi. <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />Muje mugirirana ubupfura mutiinuubwa. <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />Buri umwe abe umureeberezi mwiza wo kurinda impaano zitandukanye Imaana yabahaaye, muzikoreeshe kugira ngo zungukire buri umwe nk'uko n'Imaana yazibahaaye. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />Umuntu weese uvuga, agomba kuvuga nk'uvuga amagambo y'Imaana nyaayo, kandi uheereza agomba kubikora n'imbaraga Imaana itanga kugira ngo Imaana ihaabwe ikuzo mu bintu byose muri Kristo Yesu. N'ihaabwe ikuzo n'ububaasha uko ibihe bisimbuurana iteeka. Amiina.<verse eid="1PE 4:11" /></para>
  <para style="s1">Kubabazwa k'Umukristo</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />Bakundwa, ntimugatangaazwe n'ibigeragezo bibabaza mucamo muri iki gihe, nk'aho ari ibidasanzwe bibagwiriye. <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />Ahuubwo muneezeezwe n'uko mufatanyije imibabaro ya Kristo, kugira ngo namwe muzaaneezeerwe bihebuuje igihe ikuzo rye rizaagaragazwa. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />Nimutukwa muhoorwa izina rya Kristo, murahiirwa kuko Umwuka w'ikuzo ari wo Mwuka w'Imaana uba ubariho. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />Ariko nihagira umuntu muri mwe ubabazwa, ntakababazwe kubeera ko ari umwicanyi, umujuura, umugiranaabi, cangwa ngo azire kwivanga mu by'abandi. <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />Ariko nihagira uwo muri mwe ubabazwa kuko ari umukristo, ntibikamukoze isoni, ahuubwo aheeshe Imaana ikuzo kuko ari umukristo.<verse eid="1PE 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17" />Kuko igihe co guca urubanza kirageze kandi rubanjirije ab'umuryango w'Imaana. Noone se ubwo rubanjirije muri twe, iheerezo ry'abatumvira Ubutumwa Bwiza bw'Imaana rizaamera rite? <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />Kandi nk'uko ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="1PE 4:18">“Niiba bikomereye intungaane gukizwa,</para>
  <para style="q2" vid="1PE 4:18">bizaagendera bite abatuubaha Imaana n'abanyabyaha?”<verse eid="1PE 4:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="1PE 4:19" />Noone reero, reka abo bababazwa bahoorwa gukora ibyo Imaana ishaaka, biiragize Umuremyi udahemuka, kandi bakomeza gukora ibyiza.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s1">Umukumbi w'Imaana</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />Njeewe umwe mu bakuru b'itooreero kandi umuhamya w'ibyo kubabazwa kwa Kristo, nkaba nzaagabana ku mugabane w'ikuzo tuzaagaragarizwa, ndihanangiriza abakuru b'itooreero bari muri mwe <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" /><note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="JHN 21:15-17">Yoh 21:15-17</ref>.</char></note>kuragira umukumbi mwaragijwe n'Imaana kandi muwiteho mutiinuubwa ahuubwo n'umutima ukunze nk'uko Imaana ishaaka ngo mubikore. Mukore umurimo waanyu mutiishaakira inyungu ahuubwo mubyitangiye. <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />Ntimutegekeeshe igitugu abo mushinzwe kuyobora, ahuubwo mubeere uwo mukumbi icokureeberaho. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />Nuuko igihe mukuru w'abashumba aziigaragaza, muzaahaabwa ikamba ry'ikuzo ritangirika.<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />Namwe abakiri bato, mukwiriye kumvira abakuru, kandi mwese mukwiriye guca bugufi muri byose mukora hamwe, nk'uko ibyanditswe bivuga ngo,</para>
  <para style="q1" vid="1PE 5:5">“Imaana irwanya abiibone,</para>
  <para style="q2" vid="1PE 5:5">ariko igaha umugisha abaca bugufi.”<verse eid="1PE 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 5:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:6 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:12">Mat 23:12</ref>; <ref loc="LUK 14:11">Luk 14:11</ref>; <ref loc="LUK 18:14">18:14</ref>.</char>
    </note>Nuuko reero mwiciishe bugufi imbere y'Imaana nyir'ububaasha kugira ngo igihe ni kigera izaabashire heejuru. <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />Muyeegurire ibibahagaritsa imitima byose, kuko ibiitaho.<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />Mwirinde kandi mube maaso, kuko umwanzi waanyu Sataani ahora azereera nk'intare itontoma ishaaka uwo ya conshomera. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />Mumurwanye kandi mushikame mu kwizeera kuko muuzi yuuko abavandimwe baanyu ku isi yoose bari kunyura mu mubabaro nk'uwo. <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />Kandi nimumara kubabazwa akaanya gato, Imaana nyir'ubuntu bwose, yabahamagariye kuba mu ikuzo rihoraho muri Kristo, izaabasubiza imbaraga ibashigikire, ibakomeze kandi ibahe urufatiro rukomeye. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />Ubutware bube ubwayo iteeka ryose, Amiina.<verse eid="1PE 5:11" /></para>
  <para style="s1">Guseezera</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:12 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 15:22">Iby 15:22</ref>,<ref loc="ACT 15:40">40</ref>.</char>
    </note>Mbandikiye aya magambo make mfashijwe na Silaasi, wo njaana nk'umuvandimwe muri Kristo w'intahemuka. Nanditse nshaaka kubakomeza no kubeemeza ko ubu ari ubuntu bw'Imaana nyaabwo. Nimububemo mushikamye.<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:13 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 12:12">Iby 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">Kol 4:10</ref>; <ref loc="PHM 1:24">Fili 1:24</ref>.</char>
    </note>Ab'itoorero ry'i Babilooni, baatooranyijwe nkamwe kandi na Mariko umwana wanje barabataasha. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />Nimuhaane indamutso y'urukundo.</para>
  <para style="p" vid="1PE 5:14">Amahoro abe muri mwe mwese abari muri Kristo.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>